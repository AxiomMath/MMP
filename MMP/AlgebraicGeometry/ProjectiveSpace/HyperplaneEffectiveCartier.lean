module

public import MMP.AlgebraicGeometry.ProjectiveSpace.Hyperplane
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal

/-!
# The hyperplane of a nonzero linear form is an effective Cartier divisor

Let `l` be a nonzero linear form on `ℙⁿ_K = Proj K[T₀, …, Tₙ]`. On the standard chart `{Tᵢ ≠ 0}`
the ideal of the hyperplane `Stacks.ProjectiveSpace.hyperplane l` is generated by the function
`l / Tᵢ`, which is nonzero in the domain `Γ({Tᵢ ≠ 0})`. Hence the hyperplane is an effective
Cartier divisor in the sense of Stacks (its ideal sheaf is invertible).

## Main results

* `MMP.ProjectiveSpace.ideal_hyperplane_basicOpen_X`: the ideal of `{l = 0}` on `{Tᵢ ≠ 0}`.
* `MMP.ProjectiveSpace.isEffectiveCartierDivisor_hyperplane`: `{l = 0}` is an effective Cartier
  divisor when `l ≠ 0`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousLocalization
open Stacks.AlgebraicGeometry.ProjPolyChart

universe u

namespace MMP.ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable {K : Type u} [Field K] {n : ℕ}

/-- The standard chart `{Tᵢ ≠ 0}` of `ℙⁿ`, as an affine open. -/
def chartX (i : Fin (n + 1)) : (AlgebraicGeometry.Proj (polyGrading K n)).affineOpens :=
  ⟨Proj.basicOpen _ (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K),
    Proj.isAffineOpen_basicOpen _ _ (X_mem_one K n i) Nat.one_pos⟩

/-- **The local equation of a hyperplane.** On the chart `{Tᵢ ≠ 0}` the ideal of the hyperplane
`{l = 0}` is generated by `l / Tᵢ`. -/
theorem ideal_hyperplane_basicOpen_X (l : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1)
    (i : Fin (n + 1)) :
    (Stacks.ProjectiveSpace.hyperplane l).ideal (chartX i) =
      Ideal.span {(Stacks.ProjectiveSpace.degreeOneChartFraction
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (X_mem_one K n i) l.2)} :=
  ProjectiveSpectrum.Proj.zeroScheme_degreeSection_ideal_basicOpen_of_degree_eq _
    (X_mem_one K n i) Nat.one_pos 1 (by simp) l (by simp [l.2])

/-- For a nonzero linear form `l`, the function `l / Tᵢ` on `{Tᵢ ≠ 0}` is a non-zero-divisor. -/
theorem degreeOneChartFraction_mem_nonZeroDivisors
    {l : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1}
    (hl : (l : MvPolynomial (Fin (n + 1)) K) ≠ 0) (i : Fin (n + 1)) :
    Stacks.ProjectiveSpace.degreeOneChartFraction
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (X_mem_one K n i) l.2 ∈
      nonZeroDivisors Γ(AlgebraicGeometry.Proj (polyGrading K n), (chartX i).1) := by
  have hξ : genericPoint K n ∈ (chartX (K := K) i).1 := genericPoint_mem_basicOpen_X K n i
  have : IsIntegral (AlgebraicGeometry.Proj (polyGrading K n)) := isIntegral_proj K n
  have : Nonempty (chartX (K := K) (n := n) i).1 := ⟨⟨_, hξ⟩⟩
  have : IsDomain Γ(AlgebraicGeometry.Proj (polyGrading K n), (chartX i).1) :=
    IsIntegral.component_integral _
  refine mem_nonZeroDivisors_of_ne_zero
    (M₀ := Γ(AlgebraicGeometry.Proj (polyGrading K n), (chartX i).1)) fun h0 => ?_
  have hb := basicOpen_degreeOneChartFraction (K := K) (n := n)
    ⟨MvPolynomial.X i, X_mem_one K n i⟩ l
  have hξl : genericPoint K n ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule _ K)
      (l : MvPolynomial (Fin (n + 1)) K) := by
    rw [Proj.mem_basicOpen]
    intro hmem
    exact hl (eq_zero_of_mem_bot K n hmem)
  have hmem : genericPoint K n ∈ (AlgebraicGeometry.Proj (polyGrading K n)).basicOpen
      (Stacks.ProjectiveSpace.degreeOneChartFraction
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (X_mem_one K n i) l.2) := by
    rw [hb]
    exact ⟨hξ, hξl⟩
  rw [h0] at hmem
  exact (Scheme.basicOpen_zero _ _ ▸ hmem :
    genericPoint K n ∈ (⊥ : (AlgebraicGeometry.Proj (polyGrading K n)).Opens))

/-- **The hyperplane of a nonzero linear form is an effective Cartier divisor**: its ideal sheaf
is generated on each standard chart `{Tᵢ ≠ 0}` by the non-zero-divisor `l / Tᵢ`. -/
theorem isEffectiveCartierDivisor_hyperplane
    {l : MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1}
    (hl : (l : MvPolynomial (Fin (n + 1)) K) ≠ 0) :
    Stacks.Divisors.IsEffectiveCartierDivisor (Stacks.ProjectiveSpace.hyperplane l) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x => ?_
  obtain ⟨i, hi⟩ := exists_X_notMem x
  refine ⟨(chartX i).1, (chartX i).2, by rw [chartX, Proj.mem_basicOpen]; exact hi, _,
    isRegular_iff_mem_nonZeroDivisors.mpr (degreeOneChartFraction_mem_nonZeroDivisors hl i),
    ideal_hyperplane_basicOpen_X l i⟩

end MMP.ProjectiveSpace
