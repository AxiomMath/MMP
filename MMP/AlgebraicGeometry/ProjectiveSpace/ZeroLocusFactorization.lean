module

public import MMP.Attr
public import StacksFrontier.AlgebraicGeometry.ClosedSubschemeProjectiveSpace.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpaceChartRatio.PolynomialModel
public import StacksFrontier.AlgebraicGeometry.Limits.ProjGradedSurjection01N0

/-!
# Maps to projective space factoring through `Proj (k[T]/J)`, chart by chart

Let `k` be a field and `J` a homogeneous ideal of `k[T₀, …, Tₙ]`. For a scheme `Y` over `k`, an
invertible module `L` on `Y` and a generating tuple `s = (s₀, …, sₙ)` of global sections of `L`,
the morphism `φ_s : Y → ℙⁿ_k` of Stacks Tag 01ND restricts, on the open `Y_{sᵢ}`, to
`Proj.fromOfGlobalSections` of the evaluation `Tⱼ ↦ sⱼ / sᵢ`. This file proves that `φ_s` factors
through the closed subscheme `Proj (k[T]/J) ⊆ ℙⁿ_k` if and only if each of these evaluations kills
`J`, and deduces the same statement for an arbitrary closed subscheme `Z` of `ℙⁿ_k` (with `J` its
homogeneous ideal, Stacks Tag 03GL) and for an ideal given by generators.

## Main definitions

* `MMP.Fourfold.projQuotientMap`: the closed immersion `Proj (k[T]/J) ⟶ Proj k[T]`.
* `MMP.Fourfold.chartEval`: the evaluation `Tⱼ ↦ sⱼ / sᵢ` on the chart `Y_{sᵢ}`.

## Main results

* `MMP.Fourfold.exists_lift_projQuotientMap_iff`: `φ_s` factors through `Proj (k[T]/J)` iff every
  chart evaluation kills `J`.
* `MMP.Fourfold.exists_lift_projQuotientMap_iff_of_span`: the same for `J` generated by a family.
* `MMP.Fourfold.exists_lift_closedImmersion_iff`: the same for a closed subscheme `Z → ℙⁿ_k`,
  `J` being the homogeneous ideal of `Z`.

## Implementation notes

The factorization is built chart by chart, from the universal property of
`AlgebraicGeometry.Proj.fromOfGlobalSections` and the glueing of the lifts along the open cover by
the nonvanishing opens; the converse reads the chart ring map of a morphism through
`Proj (k[T]/J)` off `AlgebraicGeometry.Proj.awayToSection_comp_appLE`.

## References

* [Stacks Project, Tag 01ND](https://stacks.math.columbia.edu/tag/01ND)
* [Stacks Project, Tag 03GL](https://stacks.math.columbia.edu/tag/03GL)
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry Stacks.AlgebraicGeometry.ProjPolyChart
  Stacks.RingTheory.HomogeneousQuotient Stacks.ProjectiveSpaceChartRatio
  Stacks.ProjectiveFromSections

universe u

namespace MMP.Fourfold

attribute [local instance] MvPolynomial.gradedAlgebra

section Quotient

variable {k : Type u} [Field k] {n : ℕ} (J : HomogeneousIdeal (polyGrading k n))

/-- The quotient map `k[T] → k[T]/J` is surjective. -/
theorem quotientMk_surjective : Function.Surjective (quotientMk (polyGrading k n) J) :=
  Ideal.Quotient.mk_surjective

/-- The closed immersion `Proj (k[T]/J) ⟶ Proj k[T]`. -/
abbrev projQuotientMap : AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J) ⟶
    AlgebraicGeometry.Proj (polyGrading k n) :=
  Proj.map (quotientMk (polyGrading k n) J)
    (AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _ (quotientMk_surjective J))

/-- The image of the irrelevant ideal of `k[T]` in `k[T]/J` is contained in the irrelevant ideal
of `k[T]/J`. -/
theorem map_irrelevant_quotientMk_le :
    (HomogeneousIdeal.irrelevant (polyGrading k n)).toIdeal.map (quotientMk (polyGrading k n) J) ≤
      (HomogeneousIdeal.irrelevant (quotientGrading (polyGrading k n) J)).toIdeal := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  rw [Ideal.mem_comap]
  have hx' : x ∈ HomogeneousIdeal.irrelevant (polyGrading k n) := hx
  change _ ∈ HomogeneousIdeal.irrelevant (quotientGrading (polyGrading k n) J)
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at hx' ⊢
  rw [quotientMk_apply, coe_decompose_quotientGrading_mk, hx', map_zero]

end Quotient

section Lift

variable {k : Type u} [Field k] {n : ℕ} (J : HomogeneousIdeal (polyGrading k n))
  {Y : Scheme.{u}} {L : Y.Modules} [Stacks.Ample.IsInvertibleModule Y L]
  (s : Fin (n + 1) → Γ(L, ⊤)) (π : Y ⟶ Spec (CommRingCat.of k))

/-- The evaluation `T_j ↦ s_j / s_i` on the chart `Y_{s_i}`, with the base field acting through
the structure morphism. -/
def chartEval (i : Fin (n + 1)) :
    MvPolynomial (Fin (n + 1)) k →+* Γ((nvCover s i).toScheme, ⊤) :=
  MvPolynomial.eval₂Hom (baseRingHom ((nvCover s i).ι ≫ π)) (chartRatio s i)

/-- The chart evaluation sends `T_j` to the ratio `s_j / s_i`. -/
@[simp]
theorem chartEval_X (i j : Fin (n + 1)) :
    chartEval s π i (MvPolynomial.X j) = chartRatio s i j :=
  MvPolynomial.eval₂Hom_X' _ _ _

/-- The chart evaluation sends a constant to its image under the structure morphism. -/
@[simp]
theorem chartEval_C (i : Fin (n + 1)) (c : k) :
    chartEval s π i (MvPolynomial.C c) = baseRingHom ((nvCover s i).ι ≫ π) c :=
  MvPolynomial.eval₂Hom_C _ _ _

variable {s π J}

/-- The chart morphism `Y_{s_i} ⟶ Proj (k[T]/J)`, when the evaluation kills `J`. -/
def chartLift (i : Fin (n + 1)) (h : ∀ F ∈ J.toIdeal, chartEval s π i F = 0)
    (hs : GeneratesStalks s) :
    (nvCover s i).toScheme ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J) :=
  AlgebraicGeometry.Proj.fromOfGlobalSections (quotientGrading (polyGrading k n) J)
    (Ideal.Quotient.lift J.toIdeal (chartEval s π i) h)
    (by
      rw [eq_top_iff]
      calc (⊤ : Ideal _) = Ideal.map (chartEval s π i)
            (HomogeneousIdeal.irrelevant (polyGrading k n)).toIdeal :=
            (map_irrelevant_eval₂Hom_eq_top _ _ (span_range_chartRatio s i)).symm
        _ = Ideal.map (Ideal.Quotient.lift J.toIdeal (chartEval s π i) h)
            (Ideal.map (quotientMk (polyGrading k n) J)
              (HomogeneousIdeal.irrelevant (polyGrading k n)).toIdeal) := by
            have := Ideal.map_map (f := Ideal.Quotient.mk J.toIdeal)
              (g := Ideal.Quotient.lift J.toIdeal (chartEval s π i) h)
              (I := (HomogeneousIdeal.irrelevant (polyGrading k n)).toIdeal)
            rw [Ideal.Quotient.lift_comp_mk] at this
            exact this.symm
        _ ≤ _ := Ideal.map_mono (map_irrelevant_quotientMk_le J))

/-- `Proj.fromOfGlobalSections` takes equal ring maps to equal morphisms, whatever the proofs
that the irrelevant ideal generates the unit ideal. -/
theorem fromOfGlobalSections_congr {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    {𝒜 : ℕ → σ} [GradedRing 𝒜] {X : Scheme.{u}} {f g : A →+* Γ(X, ⊤)} (e : f = g)
    (hf : Ideal.map f (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
    (hg : Ideal.map g (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤) :
    AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 f hf =
      AlgebraicGeometry.Proj.fromOfGlobalSections 𝒜 g hg := by
  subst e
  rfl

/-- The chart morphism `chartLift` followed by `projQuotientMap J` is the restriction of the
morphism `toPolynomialModel s hs π` to the chart `Y_{s_i}`. -/
@[reassoc]
theorem chartLift_comp_projQuotientMap (i : Fin (n + 1))
    (h : ∀ F ∈ J.toIdeal, chartEval s π i F = 0) (hs : GeneratesStalks s) :
    chartLift i h hs ≫ projQuotientMap J = (nvCover s i).ι ≫ toPolynomialModel s hs π := by
  unfold chartLift projQuotientMap
  rw [AlgebraicGeometry.Proj.fromOfGlobalSections_comp_map _ _ _ _ ?_, ι_toPolynomialModel]
  · exact fromOfGlobalSections_congr (Ideal.Quotient.lift_comp_mk _ _ _) _ _
  · rw [eq_top_iff]
    have e : (Ideal.Quotient.lift J.toIdeal (chartEval s π i) h).comp
        (Ideal.Quotient.mk J.toIdeal) = chartEval s π i := Ideal.Quotient.lift_comp_mk _ _ _
    change ⊤ ≤ Ideal.map ((Ideal.Quotient.lift J.toIdeal (chartEval s π i) h).comp
        (Ideal.Quotient.mk J.toIdeal)) _
    rw [e]
    exact (map_irrelevant_eval₂Hom_eq_top (n := n)
      (baseRingHom ((nvCover s i).ι ≫ π)) (chartRatio s i) (span_range_chartRatio s i)).ge

/-- The morphism `projQuotientMap J : Proj (k[T]/J) ⟶ Proj k[T]` is a closed immersion. -/
instance isClosedImmersion_projQuotientMap : IsClosedImmersion (projQuotientMap J) := by
  have hdom := Stacks.AlgebraicGeometry.RelativeProjChain.mapDomain_eq_top_of_eventually_surjective
    (polyGrading k n) (quotientGrading (polyGrading k n) J) (quotientMk (polyGrading k n) J)
    (Filter.Eventually.of_forall fun d => surjective_gradedAddHom_quotientMk _ J d)
  have := Stacks.AlgebraicGeometry.SegreClosedImmersion.isClosedImmersion_mapHomOfTop
    (polyGrading k n) (quotientGrading (polyGrading k n) J) (quotientMk (polyGrading k n) J) hdom
    (Filter.Eventually.of_forall fun d => surjective_gradedAddHom_quotientMk _ J d)
  rwa [Stacks.AlgebraicGeometry.RelativeProj.mapHomOfTop_eq_map _ _ _
    (AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _ (quotientMk_surjective J)) hdom]
    at this

/-- The chart morphisms `chartLift` on `Y_{s_x}` and `Y_{s_y}` agree on the overlap. -/
theorem chartLift_compat (x y : Fin (n + 1)) (hx : ∀ F ∈ J.toIdeal, chartEval s π x F = 0)
    (hy : ∀ F ∈ J.toIdeal, chartEval s π y F = 0) (hs : GeneratesStalks s) :
    pullback.fst (nvCover s x).ι (nvCover s y).ι ≫ chartLift x hx hs =
      pullback.snd (nvCover s x).ι (nvCover s y).ι ≫ chartLift y hy hs := by
  rw [← cancel_mono (projQuotientMap J), Category.assoc, Category.assoc,
    chartLift_comp_projQuotientMap x hx hs, chartLift_comp_projQuotientMap y hy hs,
    ← Category.assoc, ← Category.assoc, pullback.condition]

/-- **Factorization through `Proj (k[T]/J)`.** A morphism `Y → ℙⁿ_k` given by a generating tuple of
sections `s` factors through the closed subscheme `Proj (k[T]/J)` as soon as the chart evaluations
`T_j ↦ s_j / s_i` kill `J`. -/
theorem exists_lift_projQuotientMap (hs : GeneratesStalks s)
    (h : ∀ i, ∀ F ∈ J.toIdeal, chartEval s π i F = 0) :
    ∃ g : Y ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J),
      g ≫ projQuotientMap J = toPolynomialModel s hs π := by
  let 𝒰 := Y.openCoverOfIsOpenCover (nvCover s) (isOpenCover_nvCover_of_generatesStalks s hs)
  have hf : ∀ x y : 𝒰.I₀, pullback.fst (𝒰.f x) (𝒰.f y) ≫ chartLift (x : Fin (n + 1)) (h x) hs =
      pullback.snd (𝒰.f x) (𝒰.f y) ≫ chartLift (y : Fin (n + 1)) (h y) hs :=
    fun x y => chartLift_compat x y (h x) (h y) hs
  refine ⟨𝒰.glueMorphisms (fun i => chartLift (i : Fin (n + 1)) (h i) hs) hf, ?_⟩
  refine 𝒰.hom_ext _ _ fun i => ?_
  have e : 𝒰.f i ≫ 𝒰.glueMorphisms (fun i => chartLift (i : Fin (n + 1)) (h i) hs) hf =
      chartLift (i : Fin (n + 1)) (h i) hs := Scheme.Cover.ι_glueMorphisms _ _ _ i
  exact (congrArg (· ≫ projQuotientMap J) e).trans (chartLift_comp_projQuotientMap i (h i) hs)

/-- The fraction `a / t ^ m` in the degree-zero localization at `t` vanishes when `a = 0`. -/
theorem away_mk_eq_zero_of_eq_zero {A σ : Type u} [CommRing A] [SetLike σ A]
    [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] {t : A} {d : ℕ} (hd : t ∈ 𝒜 d) (m : ℕ)
    (a : A) (ha : a ∈ 𝒜 (m • d)) (h : a = 0) :
    HomogeneousLocalization.Away.mk 𝒜 hd m a ha = 0 := by
  subst h
  exact Stacks.ProjGlobalSectionsAppTop.away_mk_zero 𝒜 hd m

open Stacks.ProjGlobalSectionsAppTop HomogeneousLocalization in
/-- On global sections of `D₊(T_i)` and `D₊(T̄_i)`, identified with the degree-zero localizations
at `T_i` and `T̄_i`, the restriction of `projQuotientMap J` is the induced map `Away.map`. -/
theorem basicOpenIsoAway_hom_comp_resLE_projQuotientMap_appTop (i : Fin (n + 1))
    (ht : (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k) ∈ polyGrading k n 1) :
    (AlgebraicGeometry.Proj.basicOpenIsoAway (polyGrading k n) (MvPolynomial.X i) ht
        Nat.one_pos).hom ≫
      (AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)).topIso.inv ≫
        (Scheme.Hom.resLE (projQuotientMap J)
          (AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))
          (AlgebraicGeometry.Proj.basicOpen (quotientGrading (polyGrading k n) J)
            (quotientMk (polyGrading k n) J (MvPolynomial.X i))) le_rfl).appTop =
      CommRingCat.ofHom (Away.map (quotientMk (polyGrading k n) J) (MvPolynomial.X i)) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoAway (quotientGrading (polyGrading k n) J)
          (quotientMk (polyGrading k n) J (MvPolynomial.X i))
          ((quotientMk (polyGrading k n) J).map_mem ht) Nat.one_pos).hom ≫
        (AlgebraicGeometry.Proj.basicOpen (quotientGrading (polyGrading k n) J)
          (quotientMk (polyGrading k n) J (MvPolynomial.X i))).topIso.inv := by
  have e1 := topIso_inv_resLE_appTop (projQuotientMap J)
    (U := AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))
    (V := AlgebraicGeometry.Proj.basicOpen (quotientGrading (polyGrading k n) J)
      (quotientMk (polyGrading k n) J (MvPolynomial.X i))) le_rfl
  have e2 := AlgebraicGeometry.Proj.awayToSection_comp_appLE
      (quotientMk (polyGrading k n) J)
      (AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _ (quotientMk_surjective J)) ht
  have e3 := congrArg (fun m => (AlgebraicGeometry.Proj.awayToSection (polyGrading k n)
    (MvPolynomial.X i)) ≫ m) e1
  simp only [← Category.assoc, e2] at e3
  simp only [Category.assoc] at e3 ⊢
  exact e3

open Stacks.ProjGlobalSectionsAppTop HomogeneousLocalization in
/-- **The chart ring map of a morphism through `Proj (k[T]/J)` kills the kernel of
`Away.map`.** If `Proj.fromOfGlobalSections ψ` factors as `c ≫ projQuotientMap J`, then
`projAwayHom ψ` vanishes on the kernel of the induced map of degree-zero localizations at
`T_i`. -/
theorem projAwayHom_eq_zero_of_map_eq_zero {W : Scheme.{u}}
    (ψ : MvPolynomial (Fin (n + 1)) k →+* Γ(W, ⊤))
    (hf : Ideal.map ψ (HomogeneousIdeal.irrelevant (polyGrading k n)).toIdeal = ⊤)
    (c : W ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J))
    (hc : c ≫ projQuotientMap J =
      AlgebraicGeometry.Proj.fromOfGlobalSections (polyGrading k n) ψ hf)
    (i : Fin (n + 1)) (z : Away (polyGrading k n) (MvPolynomial.X i))
    (hz : Away.map (quotientMk (polyGrading k n) J) (MvPolynomial.X i) z = 0) :
    projAwayHom (polyGrading k n) ψ z = 0 := by
  have ht := X_mem_one k n i
  set Θ := AlgebraicGeometry.Proj.fromOfGlobalSections (polyGrading k n) ψ hf
  set V := W.basicOpen (ψ (MvPolynomial.X i))
  have hpre : Θ ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i) = V :=
    AlgebraicGeometry.Proj.fromOfGlobalSections_preimage_basicOpen _ _ _ Nat.one_pos ht
  have e2 : V ≤ c ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen (quotientGrading (polyGrading k n) J)
      (quotientMk (polyGrading k n) J (MvPolynomial.X i)) := by
    rw [← hpre, ← hc]
    exact le_rfl
  have key : ∀ (Θ' : W ⟶ AlgebraicGeometry.Proj (polyGrading k n))
      (h' : c ≫ projQuotientMap J = Θ') (e : V ≤ Θ' ⁻¹ᵁ
        AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i)),
      Θ'.resLE _ V e = c.resLE _ V e2 ≫ (projQuotientMap J).resLE
        (AlgebraicGeometry.Proj.basicOpen (polyGrading k n) (MvPolynomial.X i))
        (AlgebraicGeometry.Proj.basicOpen (quotientGrading (polyGrading k n) J)
          (quotientMk (polyGrading k n) J (MvPolynomial.X i))) le_rfl := by
    rintro _ rfl e
    exact (Scheme.Hom.resLE_comp_resLE _ _ _ _).symm
  have hchart := AlgebraicGeometry.Proj.fromOfGlobalSections_resLE (polyGrading k n) ψ hf
    Nat.one_pos ht
  rw [key Θ hc _] at hchart
  have h1 := toBasicOpenOfGlobalSections_appTop (polyGrading k n) ψ Nat.one_pos ht
  rw [← hchart, Scheme.Hom.comp_appTop,
    reassoc_of% (basicOpenIsoAway_hom_comp_resLE_projQuotientMap_appTop (J := J) i ht)] at h1
  have h2 := CategoryTheory.ConcreteCategory.congr_hom h1 z
  simp only [CategoryTheory.ConcreteCategory.comp_apply, CommRingCat.hom_ofHom, hz, map_zero] at h2
  rw [← Iso.inv_hom_id_apply V.topIso (projAwayHom (polyGrading k n) ψ z), ← h2, map_zero]

/-- A global section of `W` whose restriction to the open `V = ⊤` vanishes is zero. -/
theorem eq_zero_of_resTop_eq_zero {W : Scheme.{u}} {V : W.Opens} (hV : V = ⊤) {a : Γ(W, ⊤)}
    (h : Stacks.ProjGlobalSectionsAppTop.resTop V a = 0) : a = 0 := by
  subst hV
  simpa [Stacks.ProjGlobalSectionsAppTop.resTop] using h

open Stacks.ProjGlobalSectionsAppTop HomogeneousLocalization in
/-- **Converse of factorization (homogeneous elements).** If the morphism of `s` factors through
`Proj (k[T]/J)`, every homogeneous element of `J` is killed by each chart evaluation. -/
theorem chartEval_eq_zero_of_comp_eq_of_homogeneous (hs : GeneratesStalks s) (i : Fin (n + 1))
    (g : Y ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J))
    (hg : g ≫ projQuotientMap J = toPolynomialModel s hs π) {d : ℕ}
    {F : MvPolynomial (Fin (n + 1)) k} (hF : F ∈ polyGrading k n d) (hFJ : F ∈ J.toIdeal) :
    chartEval s π i F = 0 := by
  have ht : (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) k) ∈ polyGrading k n 1 :=
    X_mem_one k n i
  have hψt : chartEval s π i (MvPolynomial.X i) = 1 := by
    simp [chartRatio_self]
  have hf := map_irrelevant_eval₂Hom_eq_top (n := n) (baseRingHom ((nvCover s i).ι ≫ π))
    (chartRatio s i) (span_range_chartRatio s i)
  have hc : ((nvCover s i).ι ≫ g) ≫ projQuotientMap J =
      AlgebraicGeometry.Proj.fromOfGlobalSections (polyGrading k n) (chartEval s π i) hf := by
    rw [Category.assoc, hg]
    exact ι_toPolynomialModel s hs π i
  have hF' : F ∈ polyGrading k n (d • 1) := by simpa using hF
  have hmap0 : Away.map (quotientMk (polyGrading k n) J) (MvPolynomial.X i)
      (Away.mk (polyGrading k n) ht d F hF') = 0 := by
    rw [Away.map_mk]
    exact away_mk_eq_zero_of_eq_zero _ _ _ _ _ (Ideal.Quotient.eq_zero_iff_mem.mpr hFJ)
  have h0 := projAwayHom_eq_zero_of_map_eq_zero (J := J) (chartEval s π i) hf _ hc i _ hmap0
  rw [projAwayHom_apply_mk] at h0
  have hu : IsUnit (resTopBasicOpenInv (chartEval s π i (MvPolynomial.X i))) :=
    (isUnit_resTop_basicOpen (chartEval s π i (MvPolynomial.X i))).unit⁻¹.isUnit
  refine eq_zero_of_resTop_eq_zero ?_ ((hu.pow d).mul_left_eq_zero.1 h0)
  rw [hψt, Scheme.basicOpen_one]

/-- **Converse of factorization.** If the morphism of `s` factors through `Proj (k[T]/J)`, every
element of `J` is killed by each chart evaluation. -/
theorem chartEval_eq_zero_of_comp_eq (hs : GeneratesStalks s) (i : Fin (n + 1))
    (g : Y ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J))
    (hg : g ≫ projQuotientMap J = toPolynomialModel s hs π)
    {F : MvPolynomial (Fin (n + 1)) k} (hFJ : F ∈ J.toIdeal) : chartEval s π i F = 0 := by
  classical
  rw [← DirectSum.sum_support_decompose (polyGrading k n) F, map_sum]
  exact Finset.sum_eq_zero fun d _ =>
    chartEval_eq_zero_of_comp_eq_of_homogeneous hs i g hg (SetLike.coe_mem _) (J.2 d hFJ)

/-- **Factorization through `Proj (k[T]/J)` is the vanishing of the chart evaluations on `J`.** -/
theorem exists_lift_projQuotientMap_iff (hs : GeneratesStalks s) :
    (∃ g : Y ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J),
        g ≫ projQuotientMap J = toPolynomialModel s hs π) ↔
      ∀ i, ∀ F ∈ J.toIdeal, chartEval s π i F = 0 :=
  ⟨fun ⟨g, hg⟩ i _ hF => chartEval_eq_zero_of_comp_eq hs i g hg hF,
    exists_lift_projQuotientMap hs⟩

/-- **Factorization through `Proj (k[T]/J)`, for `J` given by generators.** If `J` is spanned by
the family `F`, the morphism of `s` factors through `Proj (k[T]/J)` iff every chart evaluation kills
every `F a`. -/
theorem exists_lift_projQuotientMap_iff_of_span {ι : Type*} (hs : GeneratesStalks s)
    (F : ι → MvPolynomial (Fin (n + 1)) k) (hJ : J.toIdeal = Ideal.span (Set.range F)) :
    (∃ g : Y ⟶ AlgebraicGeometry.Proj (quotientGrading (polyGrading k n) J),
        g ≫ projQuotientMap J = toPolynomialModel s hs π) ↔
      ∀ i a, chartEval s π i (F a) = 0 := by
  rw [exists_lift_projQuotientMap_iff hs]
  refine ⟨fun h i a => h i _ (hJ ▸ Ideal.subset_span ⟨a, rfl⟩), fun h i x hx => ?_⟩
  rw [hJ] at hx
  refine (Ideal.span_le (I := RingHom.ker (chartEval s π i))).2 ?_ hx
  rintro _ ⟨a, rfl⟩
  exact h i a

end Lift

section ClosedImmersion

open Stacks.ClosedSubschemeProjQuotient Stacks.ClosedSubschemeProjectiveSpace

variable {k : Type u} [Field k] {n : ℕ}
  {Y : Scheme.{u}} {L : Y.Modules} [Stacks.Ample.IsInvertibleModule Y L]
  (s : Fin (n + 1) → Γ(L, ⊤)) (π : Y ⟶ Spec (CommRingCat.of k))
  {Z : Scheme.{u}} (i : Z ⟶ AlgebraicGeometry.projectiveSpaceOverRing n (CommRingCat.of k))
  [IsClosedImmersion i]

/-- **The homogeneous ideal of a closed subscheme of `ℙⁿ_k`.** -/
abbrev closedSubschemeIdeal : HomogeneousIdeal (polyGrading k n) :=
  homogeneousIdealOfClosedSubscheme (polyGrading k n) (i ≫ (comparisonIso k n).hom)

/-- The ambient morphism `Proj (k[T]/I(Z)) ⟶ Proj k[T]` attached to `Z` is
`projQuotientMap (closedSubschemeIdeal i)`. -/
theorem ambientHom_eq_projQuotientMap :
    ambientHom (polyGrading k n) (i ≫ (comparisonIso k n).hom) =
      projQuotientMap (closedSubschemeIdeal i) :=
  Stacks.AlgebraicGeometry.RelativeProj.mapHomOfTop_eq_map _ _ _
    (AlgebraicGeometry.Proj.irrelevant_le_map_of_surjective _
      (quotientMk_surjective (closedSubschemeIdeal i))) _

/-- **A map to `ℙⁿ_k` given by a generating tuple of sections factors through a closed subscheme
`Z` exactly when the chart evaluations kill the homogeneous ideal of `Z`.** -/
theorem exists_lift_closedImmersion_iff (hs : GeneratesStalks s) :
    (∃ g : Y ⟶ Z, g ≫ i = toProjectiveSpaceOver s hs π) ↔
      ∀ j, ∀ F ∈ (closedSubschemeIdeal i).toIdeal, chartEval s π j F = 0 := by
  obtain ⟨e, he⟩ := closedSubscheme_iso_projQuotient i
  rw [ambientHom_eq_projQuotientMap] at he
  rw [← exists_lift_projQuotientMap_iff hs]
  have hΦ : toPolynomialModel s hs π = toProjectiveSpaceOver s hs π ≫ (comparisonIso k n).hom :=
    rfl
  have he' : e.hom ≫ projQuotientMap (closedSubschemeIdeal i) = i ≫ (comparisonIso k n).hom := by
    simpa using congrArg (· ≫ (comparisonIso k n).hom) he
  have hi : e.inv ≫ i = projQuotientMap (closedSubschemeIdeal i) ≫ (comparisonIso k n).inv := by
    simpa using (congrArg (e.inv ≫ ·) he).symm
  refine ⟨fun ⟨g, hg⟩ => ⟨g ≫ e.hom, ?_⟩, fun ⟨g, hg⟩ => ⟨g ≫ e.inv, ?_⟩⟩
  · rw [hΦ, ← hg, Category.assoc, he', Category.assoc]
  · rw [Category.assoc, hi, ← Category.assoc, hg, hΦ, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]

end ClosedImmersion

end MMP.Fourfold

