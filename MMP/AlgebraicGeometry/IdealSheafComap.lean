module

public import StacksFrontier.AlgebraicGeometry.Blowup.StrictTransformChartBlowUp
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic

/-!
# Inverse images of locally principal ideal sheaves

If the ideal of a closed subscheme `Z ⊆ Y` is generated over an affine open `W` by a section
`s`, then near every point of `f⁻¹(W)` the ideal of `f⁻¹(Z)` is generated by `f^♯ s`: on affine
opens (Stacks' `Stacks.IdealSheaf.ideal_comap_eq_span`) and on stalks
(`MMP.stalk_comap_eq_span`). If moreover `f^♯ s` does not vanish at the generic point of an
integral `X`, the generator is a non-zero-divisor (`MMP.exists_localEquation_comap`).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace MMP

variable {X Y : Scheme.{u}}

/-- Every point of an open `U` lies in an affine open contained in `U`. -/
theorem exists_affineOpens_le {x : X} {U : X.Opens} (hx : x ∈ U) :
    ∃ W : X.affineOpens, x ∈ W.1 ∧ W.1 ≤ U := by
  obtain ⟨W, hW, hxW, hWU⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hx
  exact ⟨⟨W, hW⟩, hxW, hWU⟩

/-- The germ of `f.appLE W U e s` at a point of `U` is the germ of `f.app W s`. -/
theorem germ_appLE (f : X ⟶ Y) {W : Y.Opens} {U : X.Opens} (e : U ≤ f ⁻¹ᵁ W) (s : Γ(Y, W))
    {z : X} (hz : z ∈ U) :
    X.presheaf.germ U z hz (f.appLE W U e s) = X.presheaf.germ (f ⁻¹ᵁ W) z (e hz) (f.app W s) := by
  rw [Scheme.Hom.appLE]
  exact X.presheaf.germ_res_apply (homOfLE e) z hz _

/-- If the ideal of `Z` over the affine open `W` is generated by `s`, the stalk of the ideal of
`f⁻¹(Z)` at a point of `f⁻¹(W)` is generated by the germ of `f^♯ s`. -/
theorem stalk_comap_eq_span (I : Y.IdealSheafData) (f : X ⟶ Y) (W : Y.affineOpens)
    {s : Γ(Y, W.1)} (hs : I.ideal W = Ideal.span {s}) {z : X} (hz : z ∈ f ⁻¹ᵁ W.1) :
    IdealSheafData.stalk (I.comap f) z =
      Ideal.span {X.presheaf.germ (f ⁻¹ᵁ W.1) z hz (f.app W.1 s)} := by
  obtain ⟨U, hzU, hUW⟩ := exists_affineOpens_le hz
  rw [IdealSheafData.stalk_eq_map_germ _ z U hzU,
    Stacks.IdealSheaf.ideal_comap_eq_span I f W U hUW hs, Ideal.map_span, Set.image_singleton]
  exact congrArg (fun a ↦ Ideal.span {a}) (germ_appLE f hUW s hzU)

/-- If the ideal of `Z` over the affine open `W` is generated by `s` and `f^♯ s` does not vanish
at the generic point of the integral scheme `X`, then near every point of `f⁻¹(W)` the ideal of
`f⁻¹(Z)` is generated by one non-zero-divisor. -/
theorem exists_localEquation_comap [IsIntegral X] (I : Y.IdealSheafData) (f : X ⟶ Y)
    (W : Y.affineOpens) {s : Γ(Y, W.1)} (hs : I.ideal W = Ideal.span {s})
    (hξ : genericPoint X ∈ f ⁻¹ᵁ W.1)
    (hs0 : X.presheaf.germ _ (genericPoint X) hξ (f.app W.1 s) ≠ 0) {x : X} (hx : x ∈ f ⁻¹ᵁ W.1) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧
      ∃ g ∈ nonZeroDivisors Γ(X, U), (I.comap f).ideal U = Ideal.span {g} := by
  obtain ⟨U, hxU, hUW⟩ := exists_affineOpens_le hx
  refine ⟨U, hxU, f.appLE W.1 U.1 hUW s, ?_, Stacks.IdealSheaf.ideal_comap_eq_span I f W U hUW hs⟩
  have : Nonempty U.1 := ⟨⟨x, hxU⟩⟩
  refine mem_nonZeroDivisors_of_ne_zero fun h ↦ hs0 ?_
  have hξU : genericPoint X ∈ U.1 :=
    ((genericPoint_spec X).mem_open_set_iff U.1.isOpen).mpr ⟨x, trivial, hxU⟩
  rw [← germ_appLE f hUW s hξU, h, map_zero]

end MMP
