module

public import StacksFrontier.AlgebraicGeometry.RegularImmersion.CodimLocal
public import StacksFrontier.AlgebraicGeometry.CartierAffineLocalConverse.Basic

/-!
# A regular closed immersion of codimension one is an effective Cartier divisor

A closed immersion `j : Y ⟶ X` whose ideal is locally generated by a regular sequence of length
one (`IsRegularClosedImmersionOfCodim j 1`) has as kernel an effective Cartier divisor: near every
point of the support of `ker j` the ideal is generated on an affine open by a single
nonzerodivisor (Stacks 01WS, 063D). The converse is, in the namespace `Stacks.AlgebraicGeometry`,
`RegularIdealSheaf.isRegularClosedImmersionOfCodim_one_of_isEffectiveCartierDivisor`.

## Main results

* `MMP.isEffectiveCartierDivisor_ker_of_isRegularClosedImmersionOfCodim_one`

## References

* [Stacks Project, Tag 01WS](https://stacks.math.columbia.edu/tag/01WS)
* [Stacks Project, Tag 063D](https://stacks.math.columbia.edu/tag/063D)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace MMP

/-- **A regular closed immersion of codimension one is an effective Cartier divisor** (Stacks
01WS, 063D): its kernel is locally generated on affine opens by one nonzerodivisor. -/
theorem isEffectiveCartierDivisor_ker_of_isRegularClosedImmersionOfCodim_one {Y X : Scheme.{u}}
    (j : Y ⟶ X) [IsClosedImmersion j] (hj : IsRegularClosedImmersionOfCodim j 1) :
    Stacks.Divisors.IsEffectiveCartierDivisor j.ker := by
  rw [isRegularClosedImmersionOfCodim_iff_kerGeneratedBy] at hj
  refine (Stacks.CartierAffineLocalConverse.isEffectiveCartierDivisor_iff_isRegular _).2
    fun x hx => ?_
  have hx' : x ∈ closure (Set.range j.base) := by
    rw [← Scheme.Hom.support_ker]
    exact hx
  obtain ⟨U, hxU, r, f, hker, rfl, hwr⟩ := hj x hx'
  refine ⟨U, hxU, f 0, ?_, ?_⟩
  · have h : IsSMulRegular Γ(X, U.1) (f 0) :=
      (RingTheory.Sequence.isWeaklyRegular_singleton_iff _ _).mp hwr
    exact isLeftRegular_iff_isRegular.1 h
  · rw [Scheme.Hom.ker_apply, hker, Set.range_unique]
    rfl

end MMP
