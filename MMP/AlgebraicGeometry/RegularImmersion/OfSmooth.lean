/-!
# A closed immersion of smooth schemes is a regular closed immersion

Let `S` be a locally Noetherian scheme and `i : X ⟶ Y` a closed immersion of `S`-schemes, with
`X` smooth of relative dimension `n` and `Y` smooth of relative dimension `n + m` over `S`. Then
`i` is a regular closed immersion of codimension `m`: near every point of `X` its ideal is cut out
by a regular sequence of `m` functions (Stacks 067U, EGA IV 17.12.1).

By Stacks 067U `i` is a regular immersion, so near `i x` its ideal is generated by a regular
sequence of some length `r` on an affine open, and `r` is the fibre rank of the conormal sheaf at
`x` (Stacks 063N). The stalk dimension formula along a regular immersion gives
`dim 𝒪_{Y, i x} = dim 𝒪_{X, x} + r`. On the other hand, flatness over `S` and the dimension of
the fibres give `dim 𝒪_{Y, i x} = dim 𝒪_{S, s} + (n + m) - t` and
`dim 𝒪_{X, x} = dim 𝒪_{S, s} + n - t`, with `t` the transcendence degree of `κ(x) = κ(i x)`
over `κ(s)`. Hence `r = m`.

## Main results

* `MMP.isRegularClosedImmersionOfCodim_of_smoothOfRelativeDimension`

## References

* [Stacks Project, Tag 067U](https://stacks.math.columbia.edu/tag/067U)
* [Stacks Project, Tag 063N](https://stacks.math.columbia.edu/tag/063N)
* [A. Grothendieck, *EGA IV*, 17.12.1]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry
open Stacks.AlgebraicGeometry Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace MMP

/-- The Krull dimension of a ring of finite Krull dimension is a natural number. -/
theorem exists_natCast_eq_ringKrullDim (R : Type*) [CommRing R] [FiniteRingKrullDim R] :
    ∃ k : ℕ, ringKrullDim R = k := by
  obtain ⟨a, ha⟩ := WithBot.ne_bot_iff_exists.mp (ringKrullDim_ne_bot (R := R))
  have hne : a ≠ ⊤ := by
    rintro rfl
    exact ringKrullDim_ne_top (R := R) ha.symm
  obtain ⟨k, rfl⟩ := ENat.ne_top_iff_exists.mp hne
  exact ⟨k, ha.symm⟩

/-- The arithmetic behind the codimension count: if `dY = D + a`, `dX = D + b`, `n + m = a + t`,
`n = b + t` and `dY = dX + r`, with `D` and `dX` finite, then `r = m`. -/
theorem eq_of_dim_relations {D a b dX dY : WithBot ℕ∞} {t : ℕ∞} {n m r : ℕ} {k l : ℕ}
    (hD : D = k) (hdX : dX = l) (hY : dY = D + a) (hX : dX = D + b)
    (tY : ((n + m : ℕ) : WithBot ℕ∞) = a + t) (tX : (n : WithBot ℕ∞) = b + t)
    (h : dY = dX + r) : r = m := by
  subst hD hdX
  induction b using WithBot.recBotCoe with
  | bot => simp at tX
  | coe b =>
  induction t using ENat.recTopCoe with
  | top =>
    rw [← WithBot.coe_natCast, ← WithBot.coe_add, WithBot.coe_inj] at tX
    simp at tX
  | coe t =>
  induction b using ENat.recTopCoe with
  | top =>
    rw [← WithBot.coe_natCast, ← WithBot.coe_add, WithBot.coe_inj] at tX
    simp at tX
  | coe b =>
  induction a using WithBot.recBotCoe with
  | bot => simp at tY
  | coe a =>
  induction a using ENat.recTopCoe with
  | top =>
    rw [← WithBot.coe_natCast, ← WithBot.coe_add, WithBot.coe_inj] at tY
    simp at tY
  | coe a =>
  subst hY
  have tX' : n = b + t := by exact_mod_cast tX
  have tY' : n + m = a + t := by exact_mod_cast tY
  have hX' : l = k + b := by exact_mod_cast hX
  have h' : k + a = l + r := by exact_mod_cast h
  omega

/-- **A closed immersion of smooth schemes is a regular closed immersion** (Stacks 067U,
EGA IV 17.12.1). Let `S` be locally Noetherian and `i : X ⟶ Y` a closed immersion, `g : Y ⟶ S`,
with `i ≫ g` smooth of relative dimension `n` and `g` smooth of relative dimension `n + m`. Then
`i` is a regular closed immersion of codimension `m`. -/
theorem isRegularClosedImmersionOfCodim_of_smoothOfRelativeDimension {X Y S : Scheme.{u}}
    [IsLocallyNoetherian S] (i : X ⟶ Y) [IsClosedImmersion i] (g : Y ⟶ S) {n m : ℕ}
    [SmoothOfRelativeDimension n (i ≫ g)] [SmoothOfRelativeDimension (n + m) g] :
    IsRegularClosedImmersionOfCodim i m := by
  have : Smooth g := SmoothOfRelativeDimension.smooth (n + m) g
  have : Smooth (i ≫ g) := SmoothOfRelativeDimension.smooth n (i ≫ g)
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian g
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian (i ≫ g)
  have hreg : IsRegularImmersion i := isRegularImmersion_of_smooth_of_smooth i g
  have hJ : IsRegularIdealSheaf Y.toRingedSpace (definingIdealOfHom i) := by
    have e := i.liftCoborder_ι
    have : IsClosedImmersion (i.liftCoborder ≫ i.coborderRange.ι) := by
      rw [e]
      infer_instance
    have := (isRegularIdealSheaf_comp_open_iff i.liftCoborder i.coborderRange.ι).mpr hreg
    rwa [e] at this
  rw [isRegularClosedImmersionOfCodim_iff_kerGeneratedBy]
  intro y hy
  rw [i.isClosedEmbedding.isClosed_range.closure_eq] at hy
  obtain ⟨x, rfl⟩ := hy
  obtain ⟨W, hyW, r, f, hgen, hwr⟩ :=
    (isRegularIdealSheaf_iff_exists_affine_generators Y _).mp hJ (i x)
      ((mem_idealQuotientSupport_definingIdealOfHom_iff i (i x)).mpr (subset_closure ⟨x, rfl⟩))
  have hker := ker_app_eq_span_range i W.2 f hgen
  refine ⟨W, hyW, r, f, hker, ?_, hwr⟩
  have hrank := Stacks.Conormal.fiberRank_conormalSheaf_eq_of_isQuasiRegular i W.2
    (by rw [Stacks.Conormal.coborderRange_eq_top i]; exact le_top) f
    (isQuasiRegular_of_isWeaklyRegular _ hwr) hker (z := x) hyW
  have hdimi := ringKrullDim_stalk_eq_add_fiberRank_conormalModule i hreg x
  rw [show Scheme.Modules.fiberRank (Stacks.Chow.conormalModule i) x = r from hrank] at hdimi
  have hY := ringKrullDim_stalk_eq_add_ringKrullDim_stalk_fiber_of_flat g (i x)
  have hX := ringKrullDim_stalk_eq_add_ringKrullDim_stalk_fiber_of_flat (i ≫ g) x
  have tY := topologicalKrullDimAt_fiber_eq_krullDimOfRing_stalk_add_trdeg g (i x)
  have tX := topologicalKrullDimAt_fiber_eq_krullDimOfRing_stalk_add_trdeg (i ≫ g) x
  rw [fiberDimensionAt_eq_of_smoothOfRelativeDimension g (n + m) (i x)] at tY
  rw [fiberDimensionAt_eq_of_smoothOfRelativeDimension (i ≫ g) n x] at tX
  have htr : (letI := (g.residueFieldMap (i x)).hom.toAlgebra
      Algebra.trdeg (S.residueField (g (i x))) (Y.residueField (i x))) =
      (letI := ((i ≫ g).residueFieldMap x).hom.toAlgebra
      Algebra.trdeg (S.residueField ((i ≫ g) x)) (X.residueField x)) := by
    let := (g.residueFieldMap (i x)).hom.toAlgebra
    let : Algebra (S.residueField (g (i x))) (X.residueField x) :=
      ((i ≫ g).residueFieldMap x).hom.toAlgebra
    have hbij : Function.Bijective (i.residueFieldMap x).hom := by
      refine ⟨(i.residueFieldMap x).hom.injective, fun a => ?_⟩
      obtain ⟨a, rfl⟩ := X.residue_surjective x a
      obtain ⟨b, rfl⟩ := i.stalkMap_surjective x a
      refine ⟨Y.residue _ b, ?_⟩
      rw [← CommRingCat.comp_apply, Scheme.residue_residueFieldMap, CommRingCat.comp_apply]
    let e : Y.residueField (i x) ≃ₐ[S.residueField (g (i x))] X.residueField x :=
      { RingEquiv.ofBijective (i.residueFieldMap x).hom hbij with
        commutes' := fun c => by
          change (i.residueFieldMap x).hom ((g.residueFieldMap (i x)).hom c) =
            ((i ≫ g).residueFieldMap x).hom c
          rw [Scheme.residueFieldMap_comp]
          rfl }
    exact e.trdeg_eq
  rw [htr] at tY
  obtain ⟨k, hk⟩ := exists_natCast_eq_ringKrullDim (S.presheaf.stalk ((i ≫ g) x))
  obtain ⟨l, hl⟩ := exists_natCast_eq_ringKrullDim (X.presheaf.stalk x)
  exact eq_of_dim_relations hk hl hY hX (by exact_mod_cast tY) (by exact_mod_cast tX) hdimi

end MMP
