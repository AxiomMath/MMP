/-!
# Descent of line bundles on the generic fibre to the henselization

Let `(Y, Θ, T, π)` be a local setting (`MMP.Fourfold.IsLocalSetting`), `A = 𝒪_{Y,η_T}` the
local ring of `Y` at the generic point of `T`, with maximal ideal `𝔪`, `Z = Ỹ ×_Y Spec A`
(`MMP.Fourfold.pointSettingLocalization`) and `F_0 = Z ×_A A/𝔪`
(`MMP.Fourfold.pointSettingThickening`). Let `Aʰ` be a henselization of `A`. Every line bundle
`L` on `F_0` is the restriction of a line bundle `Lʰ` on the base change `Z_{Aʰ} = Z ×_A Aʰ`,
along the closed immersion `F_0 ⟶ Z_{Aʰ}` induced by the residue map `Aʰ ⟶ A/𝔪`.

## Main results

* `MMP.Fourfold.IsLocalSetting.exists_isInvertible_pullback_henselization_iso`

## Implementation notes

* A henselization is any local `A`-algebra `Aʰ` with `IsLocalRing.IsHenselization A κ Aʰ`,
  `κ` the residue field of `A`.
* The map `F_0 ⟶ Z_{Aʰ}` is the identity on `Z` and, on the second factor, the spectrum of an
  `A`-algebra map `ρ : Aʰ ⟶ A/𝔪`. Such a map exists and is unique, since `Aʰ/𝔪Aʰ = A/𝔪`; the
  statement holds for every such `ρ`.
* The source states the result for finitely many line bundles `L_1, …, L_b` at once; that form is
  the present statement applied to each `L_i`, with the same `Aʰ` and `ρ`.
* A line bundle is an invertible module (`SheafOfModules.IsInvertible`), and "is the restriction
  of" is an isomorphism of modules on `F_0`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Limits MMP.Mori MMP.Fourfold

namespace MMP.Fourfold.HenselianDescent

section Henselization

variable {A : Type*} [CommRing A] [IsLocalRing A] {Ah : Type*} [CommRing Ah] [IsLocalRing Ah]
  [Algebra A Ah]

/-- The kernel of an `A`-algebra map from a local `A`-algebra to the residue field `A/𝔪` is the
maximal ideal. -/
private theorem ker_algHom_residue (ρ : Ah →ₐ[A] A ⧸ IsLocalRing.maximalIdeal A) :
    RingHom.ker ρ = IsLocalRing.maximalIdeal Ah := by
  letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
  exact IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ fun y => by
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨algebraMap A Ah a, ρ.commutes a⟩)

/-- An `A`-algebra map `Aʰ → A/𝔪` sends an element congruent to `a ∈ A` modulo `𝔪_{Aʰ}` to the
class of `a`. -/
private theorem algHom_residue_apply_of_sub_mem (ρ : Ah →ₐ[A] A ⧸ IsLocalRing.maximalIdeal A)
    {x : Ah} {a : A} (h : x - algebraMap A Ah a ∈ IsLocalRing.maximalIdeal Ah) :
    ρ x = algebraMap A _ a := by
  rwa [← ker_algHom_residue ρ, RingHom.mem_ker, map_sub, sub_eq_zero, AlgHom.commutes] at h

/-- Two `A`-algebra maps from a local `A`-algebra `Aʰ` with residue field generated by `A` to the
residue field `A/𝔪` coincide. -/
private theorem algHom_residue_ext
    (hsurj : ∀ x : Ah, ∃ a : A, x - algebraMap A Ah a ∈ IsLocalRing.maximalIdeal Ah)
    {I : Ideal A} (hI : I = IsLocalRing.maximalIdeal A) (ρ₁ ρ₂ : Ah →ₐ[A] A ⧸ I) :
    ρ₁ = ρ₂ := by
  subst hI
  refine AlgHom.ext fun x => ?_
  obtain ⟨a, ha⟩ := hsurj x
  rw [algHom_residue_apply_of_sub_mem ρ₁ ha, algHom_residue_apply_of_sub_mem ρ₂ ha]

/-- In a henselization `Aʰ` of `A`, every element is congruent modulo the maximal ideal to an
element of `A`. -/
private theorem exists_sub_algebraMap_mem_maximalIdeal
    [IsLocalRing.IsHenselization A (IsLocalRing.ResidueField A) Ah] (x : Ah) :
    ∃ a : A, x - algebraMap A Ah a ∈ IsLocalRing.maximalIdeal Ah := by
  have : IsLocalHom (algebraMap A Ah) :=
    IsLocalRing.IsHenselization.isLocalHom (L := IsLocalRing.ResidueField A)
  obtain ⟨r, hr⟩ := (IsLocalRing.IsHenselization.residueField_map_bijective (R := A)
    (Rh := Ah)).2 (IsLocalRing.residue Ah x)
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
  rw [IsLocalRing.ResidueField.map_residue] at hr
  exact ⟨a, Ideal.Quotient.eq.mp hr.symm⟩

/-- An approximation `ψ : R → Aʰ` of `φ : R → Â` modulo `𝔪` has the same reduction modulo `𝔪`
as `φ`, for every `A`-algebra map `ρ : Aʰ → A/𝔪`. -/
private theorem algHom_comp_eq_evalₐ_comp_of_approx [IsNoetherianRing A]
    [IsLocalRing.IsHenselization A (IsLocalRing.ResidueField A) Ah]
    {R : Type*} [CommRing R] [Algebra A R]
    (ρ : Ah →ₐ[A] A ⧸ IsLocalRing.maximalIdeal A ^ (0 + 1))
    (φ : R →ₐ[A] AdicCompletion (IsLocalRing.maximalIdeal A) A) (ψ : R →ₐ[A] Ah)
    (hψ : ∀ x, φ x - IsLocalRing.henselizationToAdicCompletion A Ah (ψ x) ∈
      (IsLocalRing.maximalIdeal A ^ 1).map
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) :
    ρ.comp ψ = (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) (0 + 1)).comp φ := by
  rw [algHom_residue_ext exists_sub_algebraMap_mem_maximalIdeal (by rw [zero_add, pow_one]) ρ
    ((AdicCompletion.evalₐ _ (0 + 1)).comp (IsLocalRing.henselizationToAdicCompletion A Ah))]
  refine AlgHom.ext fun x => (sub_eq_zero.mp ?_).symm
  rw [AlgHom.comp_apply, AlgHom.comp_apply, AlgHom.comp_apply, ← map_sub, ← RingHom.mem_ker]
  refine (Ideal.map_le_iff_le_comap.mpr fun a ha => ?_) (hψ x)
  rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (by simpa using ha)

end Henselization

section Colimit

variable (A : CommRingCat.{0}) (B : Type) [CommRing B] [Algebra A B]

/-- The finitely generated `A`-subalgebras `A[i] ⊆ B`, `i` a finite subset of `B`, as a diagram of
`A`-algebras. -/
private noncomputable def adjoinFinsetUnderDiagram : Finset B ⥤ Under A where
  obj i := Under.mk (CommRingCat.ofHom (algebraMap A (Algebra.adjoin A (i : Set B))))
  map {i j} h := Under.homMk ((Algebra.adjoinFinsetDiagram A B).map h) (by ext; rfl)
  map_id i := by ext; rfl
  map_comp f g := by ext; rfl

/-- `B` as the cocone of its finitely generated `A`-subalgebras. -/
private noncomputable def adjoinFinsetUnderCocone : Cocone (adjoinFinsetUnderDiagram A B) where
  pt := Under.mk (CommRingCat.ofHom (algebraMap A B))
  ι :=
    { app i := Under.homMk ((Algebra.adjoinFinsetCocone A B).ι.app i) (by ext; rfl)
      naturality := by intro i j h; ext; rfl }

attribute [local instance] IsFiltered.isConnected in
/-- An `A`-algebra is the filtered colimit of its finitely generated `A`-subalgebras, in the
category of `A`-algebras. -/
private noncomputable def isColimitAdjoinFinsetUnderCocone :
    IsColimit (adjoinFinsetUnderCocone A B) :=
  isColimitOfReflects (Under.forget A) (Algebra.isColimitAdjoinFinsetCocone A B)

end Colimit

end MMP.Fourfold.HenselianDescent

open MMP.Fourfold.HenselianDescent

namespace MMP.Fourfold.IsLocalSetting

/-- **Descent to the henselization.** In a local setting `(Y, Θ, T, π)`, with `A = 𝒪_{Y,η_T}`,
`Z = Ỹ ×_Y Spec A` and `F_0 = Z ×_A A/𝔪`, let `Aʰ` be a henselization of `A` and
`ρ : Aʰ → A/𝔪` an `A`-algebra map. Every line bundle `L` on `F_0` is the restriction of a line
bundle `Lʰ` on `Z ×_A Aʰ` along the map `F_0 ⟶ Z ×_A Aʰ` induced by `ρ`. -/
@[mmp "lem_oai4_c2_henselian_descent"]
public theorem exists_isInvertible_pullback_henselization_iso
    {Y Yt : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sY : Y ⟶ Spec (.of ℂ)} {Θ : QDivisor Y} {T : IrreducibleCloseds Y} {π : Yt ⟶ Y}
    (h : IsLocalSetting sY Θ T π)
    (Ah : Type) [CommRing Ah] [IsLocalRing Ah]
    [Algebra (Y.presheaf.stalk (localSettingGenericPoint T)) Ah]
    [IsLocalRing.IsHenselization (Y.presheaf.stalk (localSettingGenericPoint T))
      (IsLocalRing.ResidueField (Y.presheaf.stalk (localSettingGenericPoint T))) Ah]
    (ρ : Ah →ₐ[Y.presheaf.stalk (localSettingGenericPoint T)]
      Y.presheaf.stalk (localSettingGenericPoint T) ⧸
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (localSettingGenericPoint T)) ^ (0 + 1))
    (L : (pointSettingThickening π (localSettingGenericPoint T) 0).Modules)
    [SheafOfModules.IsInvertible (pointSettingThickening π (localSettingGenericPoint T) 0).presheaf
      (pointSettingThickening π (localSettingGenericPoint T) 0).ringCatSheaf.2 L] :
    let A := Y.presheaf.stalk (localSettingGenericPoint T)
    let ZAh : Scheme.{0} := pullback (pullback.snd π (Y.fromSpecStalk (localSettingGenericPoint T)))
      (Spec.map (CommRingCat.ofHom (algebraMap A Ah)))
    let ι : pointSettingThickening π (localSettingGenericPoint T) 0 ⟶ ZAh :=
      pullback.map _ _ _ _ (𝟙 _) (Spec.map (CommRingCat.ofHom ρ.toRingHom)) (𝟙 _)
        (by simp) (by
          rw [Category.comp_id]
          exact (congrArg Spec.map (CommRingCat.hom_ext (RingHom.ext fun x ↦
            (ρ.commutes x).symm))).trans (Spec.map_comp _ _))
    ∃ (Lh : ZAh.Modules) (_ : SheafOfModules.IsInvertible ZAh.presheaf ZAh.ringCatSheaf.2 Lh),
      Nonempty ((Scheme.Modules.pullback ι).obj Lh ≅ L) := by
  intro A ZAh ι
  let g := pullback.snd π (Y.fromSpecStalk (localSettingGenericPoint T))
  haveI : IsProper π := isProper_of_isProjectiveMorphism _ h.isResolution.2.2.2.1
  haveI : LocallyOfFiniteType sY := ((MMP.Mori.isProjectiveVariety_iff (k := ℂ) (f := sY)).mp
    h.isProjectiveVariety).1.toLocallyOfFiniteType
  letI : Algebra ℂ A := ((sY.stalkMap (localSettingGenericPoint T)).hom.comp
    ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ (Spec (.of ℂ)).presheaf.germ ⊤
      (sY.base (localSettingGenericPoint T)) (by simp)).hom).toAlgebra
  haveI : Algebra.EssFiniteType ℂ A :=
    essFiniteType_stalkStructureMap sY (localSettingGenericPoint T)
  haveI : IsNoetherianRing A := Algebra.EssFiniteType.isNoetherianRing ℂ A
  obtain ⟨Lhat, hLhat, ⟨eL⟩⟩ := IsLocalSetting.exists_isInvertible_pullback_iso h L
  let 𝔪 := IsLocalRing.maximalIdeal A
  let Ahat := AdicCompletion 𝔪 A
  obtain ⟨j, Lj, hLj, ⟨ej⟩⟩ :=
    (MMP.exists_isInvertible_pullback_iso_of_isColimit_under g
      (adjoinFinsetUnderDiagram A Ahat) (adjoinFinsetUnderCocone A Ahat)
      (isColimitAdjoinFinsetUnderCocone A Ahat)).1 Lhat hLhat
  let B := Algebra.adjoin A (j : Set Ahat)
  haveI : Algebra.FinitePresentation A B := Algebra.FinitePresentation.of_finiteType.mp
    ((Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _))
  obtain ⟨ψ, hψ⟩ := MMP.Resolution.Bridges.exists_algHom_henselization_approx (k := ℂ) Ah B.val 1
  have hψA : ((adjoinFinsetUnderDiagram A Ahat).obj j).hom ≫ CommRingCat.ofHom ψ.toRingHom =
      CommRingCat.ofHom (algebraMap A Ah) := by
    ext a; exact ψ.commutes a
  let p : ZAh ⟶ pullback g (Spec.map ((adjoinFinsetUnderDiagram A Ahat).obj j).hom) :=
    pullback.map _ _ _ _ (𝟙 _) (Spec.map (CommRingCat.ofHom ψ.toRingHom)) (𝟙 _)
      ((Category.comp_id _).trans (Category.id_comp _).symm)
      ((Category.comp_id _).trans ((congrArg Spec.map hψA).symm.trans (Spec.map_comp _ _)))
  refine ⟨(Scheme.Modules.pullback p).obj Lj,
    Stacks.InvertiblePullback.isInvertible_pullback_ringCatSheaf p Lj (h := hLj), ⟨?_⟩⟩
  refine pullbackCompIso (c := _) ?_ Lj ≪≫ (pullbackCompIso rfl Lj).symm ≪≫
    (Scheme.Modules.pullback _).mapIso ej.symm ≪≫ eL
  rw [pullback.map_comp]
  erw [pullback.map_comp]
  congr 1
  have e : (CommRingCat.ofHom ψ.toRingHom ≫ CommRingCat.ofHom ρ.toRingHom :
      CommRingCat.of B ⟶ _) = CommRingCat.ofHom B.val.toRingHom ≫
        CommRingCat.ofHom (AdicCompletion.evalₐ 𝔪 (0 + 1)).toRingHom :=
    congrArg (fun f : B →ₐ[A] _ => CommRingCat.ofHom f.toRingHom)
      (algHom_comp_eq_evalₐ_comp_of_approx ρ B.val ψ hψ)
  exact (Spec.map_comp _ _).symm.trans ((congrArg Spec.map e).trans (Spec.map_comp _ _))

end MMP.Fourfold.IsLocalSetting
