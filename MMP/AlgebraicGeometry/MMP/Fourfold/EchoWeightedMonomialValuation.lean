universe u

namespace MMP.Fourfold

/-! ## Echoes are monomial valuations -/

section Echo

open TopologicalSpace MMP.Resolution
open scoped WithZero

/-! ### The ideal identity -/

/-- `∑_{a ≥ 0} x^a (x, t)^{max(n - ja, 0)}` is the ideal generated by the monomials `t^b x^a`
with `b + ja ≥ n`, for `j ≥ 1`. -/
private theorem echoIdeal_span_pair_eq {R : Type*} [CommRing R] (x t : R) {j : ℕ} (hj : 1 ≤ j)
    (n : ℕ) : echoIdeal x (Ideal.span {x, t}) j n = monomialIdeal t x j n := by
  refine le_antisymm (iSup_le fun a => ?_) ?_
  · rw [← monomialIdeal_one_eq_pow, monomialIdeal, Ideal.span_mul_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨_, rfl, _, ⟨c, d, hcd, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨d, a + c, ?_, by ring⟩
    have : c ≤ j * c := Nat.le_mul_of_pos_left c hj
    rw [mul_add]
    omega
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨b, a, hab, rfl⟩
    refine (le_iSup (fun a => Ideal.span {x ^ a} * Ideal.span {x, t} ^ (n - j * a)) a) ?_
    rw [mul_comm (t ^ b)]
    refine Ideal.mul_mem_mul (Ideal.subset_span rfl) ?_
    refine Ideal.pow_le_pow_right (show n - j * a ≤ b by omega) ?_
    exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) b

/-- For two indices `i₀ ≠ i₁` exhausting `ι` and weights `j`, `1`, the weighted monomial ideal is
the ideal generated by the `z_{i₁}^b z_{i₀}^a` with `b + ja ≥ m`. -/
private theorem weightedMonomialIdeal_eq_monomialIdeal {R : Type*} [CommRing R] {ι : Type*}
    [Fintype ι] [DecidableEq ι] {i₀ i₁ : ι} (h01 : i₀ ≠ i₁) (hι : ∀ i, i = i₀ ∨ i = i₁)
    (z : ι → R) {α : ι → ℕ} {j : ℕ} (h₀ : α i₀ = j) (h₁ : α i₁ = 1) (m : ℕ) :
    weightedMonomialIdeal z α m = monomialIdeal (z i₁) (z i₀) j m := by
  have huniv : (Finset.univ : Finset ι) = {i₀, i₁} := by
    ext i
    simpa using hι i
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨β, hβ, rfl⟩
    rw [huniv, Finset.sum_pair h01, h₀, h₁] at hβ
    rw [huniv, Finset.prod_pair h01]
    exact Ideal.subset_span ⟨β i₁, β i₀, by omega, by ring⟩
  · rintro _ ⟨b, a, hab, rfl⟩
    refine Ideal.subset_span ⟨fun i => if i = i₀ then a else b, ?_, ?_⟩
    · rw [huniv, Finset.sum_pair h01, h₀, h₁]
      simp [h01.symm]
      omega
    · rw [huniv, Finset.prod_pair h01]
      simp [h01.symm]
      ring

/-- Echo ideals are transported by isomorphisms of local rings. -/
private theorem echoIdeal_map_ringEquiv {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A]
    [IsLocalRing B] (φ : A ≃+* B) (x : A) (j n : ℕ) :
    echoIdeal (φ x) (IsLocalRing.maximalIdeal B) j n =
      Ideal.map φ (echoIdeal x (IsLocalRing.maximalIdeal A) j n) := by
  simp only [echoIdeal, Ideal.map_iSup, Ideal.map_mul, Ideal.map_pow, Ideal.map_span,
    Set.image_singleton, map_pow]
  congr!
  exact (IsLocalRing.map_ringEquiv_maximalIdeal φ).symm

private theorem apply_mem_echoIdeal_iff {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (φ : A ≃+* B) (x : A) (j n : ℕ) (f : A) :
    φ f ∈ echoIdeal (φ x) (IsLocalRing.maximalIdeal B) j n ↔
      f ∈ echoIdeal x (IsLocalRing.maximalIdeal A) j n := by
  rw [echoIdeal_map_ringEquiv]
  exact Ideal.apply_mem_of_equiv_iff

/-- A ring isomorphism carries `I` to the principal ideal on `φ x` exactly when `I = (x)`. -/
private theorem map_ringEquiv_eq_span_singleton_iff {A B : Type*} [CommRing A] [CommRing B]
    (φ : A ≃+* B) (I : Ideal A) (x : A) :
    Ideal.map φ I = Ideal.span {φ x} ↔ I = Ideal.span {x} := by
  rw [← Set.image_singleton, ← Ideal.map_span]
  exact (Ideal.relIsoOfBijective φ φ.bijective).symm.injective.eq_iff

/-! ### Passing between `Y` and the open subscheme `U` -/

section Geometry

variable {k : Type u} [Field k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]

omit [IsIntegral Y] in
/-- The generic point of `Z = U ∩ V` is the generic point of `V`. -/
private theorem ι_base_genericPoint {U : Y.Opens} {V : IrreducibleCloseds Y}
    {Z : IrreducibleCloseds U} (hηU : V.isIrreducible.genericPoint ∈ U)
    (hZV : (Z : Set U) = U.ι.base ⁻¹' V) :
    U.ι.base Z.isIrreducible.genericPoint = V.isIrreducible.genericPoint := by
  have hV := V.isIrreducible.isGenericPoint_genericPoint V.isClosed
  have hZ := (Z.isIrreducible.isGenericPoint_genericPoint Z.isClosed).image
    U.ι.base.hom.continuous
  have hcl : closure (U.ι.base '' (Z : Set U)) = (V : Set Y) := by
    rw [hZV, Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι]
    refine subset_antisymm (closure_minimal Set.inter_subset_left V.isClosed) ?_
    calc (V : Set Y) = closure {V.isIrreducible.genericPoint} := hV.def.symm
      _ ⊆ closure ((V : Set Y) ∩ U) :=
        closure_mono (Set.singleton_subset_iff.mpr ⟨hV.mem, hηU⟩)
  rw [hcl] at hZ
  exact hZ.eq hV

/-- An open immersion `U ⟶ Y` identifies the local rings `𝒪_{Y,y}` and `𝒪_{U,z}` at `y = z`,
compatibly with the function fields and with ideal sheaves and their restrictions. -/
private theorem exists_stalk_ringEquiv_of_eq {U : Y.Opens} [Nonempty U] (z : U.toScheme) (y : Y)
    (h : U.ι.base z = y) (I : Y.IdealSheafData) :
    ∃ φ : Y.presheaf.stalk y ≃+* U.toScheme.presheaf.stalk z,
      (∀ g, haveI := isDominant_ι_of_nonempty U
        functionFieldMap U.ι (algebraMap _ Y.functionField g) =
          algebraMap _ U.toScheme.functionField (φ g)) ∧
      Ideal.map φ (IdealSheafData.stalk I y) = IdealSheafData.stalk (I.comap U.ι) z := by
  subst h
  have := isDominant_ι_of_nonempty U
  refine ⟨(asIso (U.ι.stalkMap z)).commRingCatIsoToRingEquiv, fun g => ?_, ?_⟩
  · exact MMP.Mori.functionFieldMap_algebraMap_stalk U.ι z g
  · rw [AlgebraicGeometry.stalk_comap]
    rfl

omit [IsIntegral Y] in
/-- A prime divisor of an open subscheme `U` with support `U ∩ S` is the restriction of `S`. -/
private theorem idealSheaf_eq_comap {U : Y.Opens} {S : MMP.Mori.PrimeDivisor Y}
    {SU : MMP.Mori.PrimeDivisor U} (hSU : SU.support = U.ι.base ⁻¹' S.support) :
    SU.idealSheaf = S.idealSheaf.comap U.ι := by
  have : IsReduced (S.idealSheaf.comap U.ι).subscheme := by
    have := S.integral
    have : IsReduced (Limits.pullback U.ι S.idealSheaf.subschemeι) :=
      isReduced_of_isOpenImmersion (Limits.pullback.snd U.ι S.idealSheaf.subschemeι)
    exact isReduced_of_isOpenImmersion (S.idealSheaf.comapIso U.ι).hom
  rw [Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme (S.idealSheaf.comap U.ι)
    SU.idealSheaf.support ?_, MMP.Intersection.vanishingIdeal_support_idealSheaf SU]
  ext1
  simp [Scheme.IdealSheafData.support_comap, hSU]

/-- An open subscheme of a variety is a variety. -/
private theorem isVariety_ι (hY : MMP.Mori.IsNormalVariety k sY) (U : Y.Opens) [Nonempty U] :
    MMP.Mori.IsVariety k (U.ι ≫ sY) := by
  have := hY.1
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  exact ⟨⟩

/-- The extension of function fields of a composite is the composite of the extensions. -/
private theorem functionFieldMap_comp_apply {X Y Z : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] (a : X ⟶ Y) (b : Y ⟶ Z) [IsDominant a] [IsDominant b] (c : Z.functionField) :
    functionFieldMap (a ≫ b) c = functionFieldMap a (functionFieldMap b c) := by
  obtain ⟨s, rfl⟩ := MMP.Positivity.DivisorOver.algebraMap_stalk_surjective_of_eq_genericPoint
    ((a ≫ b) (genericPoint X)) (map_genericPoint_of_isDominant (a ≫ b)) c
  rw [MMP.Mori.functionFieldMap_algebraMap_stalk (a ≫ b) (genericPoint X) s]
  erw [MMP.Mori.functionFieldMap_algebraMap_stalk b (a (genericPoint X)) s,
    MMP.Mori.functionFieldMap_algebraMap_stalk a (genericPoint X)]
  rw [Scheme.Hom.stalkMap_comp]
  rfl

private theorem functionFieldMap_congr {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    {a b : X ⟶ Y} (h : a = b) [IsDominant a] [IsDominant b] (c : Y.functionField) :
    functionFieldMap a c = functionFieldMap b c := by
  subst h
  rfl

omit [IsIntegral Y] in
/-- The valuation of a prime divisor `E` is the valuation of its restriction to an open
subscheme `W` meeting it, read through `k(X) ≅ k(W)`. -/
private theorem divisorialValuation_functionFieldMap_ι {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (W : X.Opens) [Nonempty W] (E : MMP.Mori.PrimeDivisor X)
    (EW : MMP.Mori.PrimeDivisor W) (h : W.ι EW.genericPoint = E.genericPoint)
    (c : X.functionField) :
    haveI := isDominant_ι_of_nonempty W
    EW.divisorialValuation (functionFieldMap W.ι c) = E.divisorialValuation c := by
  have := isDominant_ι_of_nonempty W
  haveI := E.isDiscreteValuationRing_localRing
  haveI := EW.isDiscreteValuationRing_localRing
  have hle : ∀ (x : X) (_ : x = W.ι EW.genericPoint) (r : X.presheaf.stalk x),
      EW.divisorialValuation (functionFieldMap W.ι (algebraMap _ X.functionField r)) ≤ 1 := by
    rintro _ rfl r
    rw [MMP.Mori.functionFieldMap_algebraMap_stalk,
      MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
    exact ⟨_, rfl⟩
  have hlt : ∀ (x : X) (_ : x = W.ι EW.genericPoint) (r : X.presheaf.stalk x),
      r ∈ IsLocalRing.maximalIdeal _ →
      EW.divisorialValuation (functionFieldMap W.ι (algebraMap _ X.functionField r)) < 1 := by
    rintro _ rfl r hr
    rw [MMP.Mori.functionFieldMap_algebraMap_stalk,
      MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff]
    exact (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
      (IsLocalRing.mem_maximalIdeal _).1 hr (isUnit_of_map_unit _ _ hu)
  have hbij := MMP.Mori.functionFieldMap_bijective_of_isOpenImmersion W.ι ⊤
    (by simpa using (Set.univ_nonempty : (Set.univ : Set W).Nonempty))
  have hw := MMP.Positivity.DivisorOver.valuation_eq_of_isDiscreteValuationRing
    (R := E.localRing) (w := EW.divisorialValuation.comap (functionFieldMap W.ι))
    (w' := E.divisorialValuation)
    (fun r => hle _ h.symm r) (fun r hr => hlt _ h.symm r hr) ?_
    (fun r => (MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff E _).2 ⟨r, rfl⟩)
    (fun r hr => (E.divisorialValuation_algebraMap_lt_one_iff r).2 hr) ?_
  · exact congrArg (fun v : Valuation X.functionField ℤᵐ⁰ => v c) hw
  · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible EW.localRing
    obtain ⟨g, hg⟩ := hbij.2 (algebraMap EW.localRing W.toScheme.functionField ϖ)
    exact ⟨g, by rw [Valuation.comap_apply, hg,
      EW.divisorialValuation_algebraMap_of_irreducible hϖ]⟩
  · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
    exact ⟨_, E.divisorialValuation_algebraMap_of_irreducible hϖ⟩

/-- The identity is birational. -/
private theorem isBirational_id (X : Scheme.{u}) : AlgebraicGeometry.IsBirational (𝟙 X) :=
  ⟨by simpa using Set.bijOn_id (genericPoints X), fun x _ => by
    rw [Scheme.Hom.stalkMap_id]
    exact IsIso.id _⟩

/-- A divisor `(W, f, E)` over `Y` whose centre meets an open `U` restricts to a divisor
`(f⁻¹ U, f|_U, E ∩ f⁻¹ U)` over `U`, with the same valuation and centre `c ∩ U`. -/
private theorem exists_divisorOver_restrict (hY : MMP.Mori.IsNormalVariety k sY)
    (D : MMP.Mori.DivisorOver k sY) (U : Y.Opens) [Nonempty U]
    (hU : D.f D.E.genericPoint ∈ U) [IsProper D.f] :
    ∃ DU : MMP.Mori.DivisorOver k (U.ι ≫ sY), IsProper DU.f ∧
      (haveI := isDominant_ι_of_nonempty U;
        DU.valuation.comap (functionFieldMap U.ι) = D.valuation) ∧
      U.ι (DU.f DU.E.genericPoint) = D.f D.E.genericPoint := by
  haveI := D.isIntegral
  haveI := D.isNormal
  haveI := D.isLocallyNoetherian
  haveI := D.isDominant
  have := hY.1
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  haveI : IsNormal Y := hY.2
  set W : D.Y.Opens := D.f ⁻¹ᵁ U
  let e : W.toScheme := ⟨D.E.genericPoint, hU⟩
  haveI : Nonempty W := ⟨e⟩
  have he : Order.coheight e = 1 := by
    rw [← coheight_eq_of_isOpenImmersion W.ι]
    exact D.E.coheight_genericPoint
  let EW : MMP.Mori.PrimeDivisor W := PrimeDivisor.ofCoheightOne e he
  have hEW : W.ι EW.genericPoint = D.E.genericPoint := by
    change W.ι (PrimeDivisor.ofCoheightOne e he).genericPoint = _
    rw [PrimeDivisor.genericPoint_ofCoheightOne]
    rfl
  have hcomp : (D.f ∣_ U) ≫ U.ι = W.ι ≫ D.f := morphismRestrict_ι D.f U
  have hnv : MMP.Mori.IsNormalVariety k ((D.f ∣_ U) ≫ U.ι ≫ sY) := by
    rw [← Category.assoc, hcomp, Category.assoc]
    exact ⟨isVariety_ι (D.f ≫ sY) D.isNormalVariety W, inferInstance⟩
  have hbir : MMP.Mori.IsBirationalMorphism (D.f ∣_ U) := by
    have hb := (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
      D.isBirationalMorphism).restrict U
    have := hnv.1
    have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian
      ((D.f ∣_ U) ≫ U.ι ≫ sY)
    have hUv := isVariety_ι sY hY U
    have : IsLocallyNoetherian U := LocallyOfFiniteType.isLocallyNoetherian (U.ι ≫ sY)
    have i1 : IsIntegral W := hnv.1.toIsIntegral
    have i2 : IsIntegral U := hUv.toIsIntegral
    have i3 : IsNormal W := inferInstance
    have i4 : IsNormal U := inferInstance
    have i5 : IsProper (D.f ∣_ U) := inferInstance
    have i6 : IsProper (𝟙 W.toScheme) := inferInstance
    have h := @MMP.Mori.isBirationalMorphism_comp_of_isBirational U W W i2 i1 i1 i4 i3
      inferInstance inferInstance (D.f ∣_ U) (𝟙 W.toScheme) i5 i6 hb (isBirational_id W.toScheme)
    rwa [Category.id_comp] at h
  refine ⟨⟨W, D.f ∣_ U, hnv, hbir, EW⟩, inferInstance, ?_, ?_⟩
  · have := isDominant_ι_of_nonempty U
    have := isDominant_ι_of_nonempty W
    have : IsDominant (D.f ∣_ U) := hbir.isDominant
    ext c
    change EW.divisorialValuation (functionFieldMap (D.f ∣_ U) (functionFieldMap U.ι c)) =
      D.E.divisorialValuation (functionFieldMap D.f c)
    rw [← functionFieldMap_comp_apply, functionFieldMap_congr hcomp, functionFieldMap_comp_apply,
      divisorialValuation_functionFieldMap_ι W D.E EW hEW]
  · change ((D.f ∣_ U) ≫ U.ι) EW.genericPoint = _
    rw [hcomp, Scheme.Hom.comp_apply, hEW]

/-- A divisorial valuation of `k(Y)` with a centre on `Y` has centre `V` exactly when, as a
valuation of `k(U)`, it has centre `V ∩ U` on `U`. -/
private theorem isCentre_iff (hY : MMP.Mori.IsNormalVariety k sY) {U : Y.Opens} [Nonempty U]
    {V : IrreducibleCloseds Y}
    {Z : IrreducibleCloseds U} (hηU : V.isIrreducible.genericPoint ∈ U)
    (hZV : (Z : Set U) = U.ι.base ⁻¹' V)
    {ξ : Valuation Y.functionField ℤᵐ⁰} {ξU : Valuation U.toScheme.functionField ℤᵐ⁰}
    (hξU : haveI := isDominant_ι_of_nonempty U
      ξ = ξU.comap (functionFieldMap U.ι))
    (hξ : ∃ Z' : IrreducibleCloseds Y, MMP.Intersection.IsCentre k sY ξ Z') :
    MMP.Intersection.IsCentre k sY ξ V ↔ MMP.Intersection.IsCentre k (U.ι ≫ sY) ξU Z := by
  have := isDominant_ι_of_nonempty U
  have hV := V.isIrreducible.isGenericPoint_genericPoint V.isClosed
  have hZg := Z.isIrreducible.isGenericPoint_genericPoint Z.isClosed
  have hι := ι_base_genericPoint hηU hZV
  constructor
  · rintro ⟨D, hDp, hDv, hVD⟩
    have hV' : IsGenericPoint V.isIrreducible.genericPoint (D.center : Set Y) := by
      change closure _ = _
      rw [hV.def, hVD]
    have hy := D.isGenericPoint_center.eq hV'
    obtain ⟨DU, hDUp, hDUv, hpt⟩ := exists_divisorOver_restrict sY hY D U (hy ▸ hηU)
    refine ⟨DU, hDUp, ?_, ?_⟩
    · have hbij := MMP.Mori.functionFieldMap_bijective_of_isOpenImmersion U.ι ⊤
        (by simpa using (Set.univ_nonempty : (Set.univ : Set U).Nonempty))
      ext g
      obtain ⟨c, rfl⟩ := hbij.2 g
      simpa using congrArg (fun v : Valuation Y.functionField ℤᵐ⁰ => v c)
        (hξU.symm.trans (hDv.trans hDUv.symm))
    · have hz : DU.f DU.E.genericPoint = Z.isIrreducible.genericPoint :=
        U.ι.isOpenEmbedding.injective (by rw [hpt, hy, hι])
      ext1
      rw [MMP.Mori.DivisorOver.center_eq_closure_genericPoint, hz, hZg.def]
  · rintro ⟨DU, -, hDUv, hZD⟩
    obtain ⟨-, D, hDp, hDv, -⟩ := hξ
    refine ⟨D, hDp, hDv, ?_⟩
    have hZ' : IsGenericPoint Z.isIrreducible.genericPoint (DU.center : Set U) := by
      change closure _ = _
      rw [hZg.def, hZD]
    have hz := DU.isGenericPoint_center.eq hZ'
    obtain ⟨φ, hφf, -⟩ := exists_stalk_ringEquiv_of_eq Z.isIrreducible.genericPoint
      V.isIrreducible.genericPoint hι ⊥
    have := hY.1.toIsSeparated
    have h1 : ∀ a : Y.presheaf.stalk V.isIrreducible.genericPoint,
        D.valuation (algebraMap _ Y.functionField a) =
          DU.valuation (algebraMap _ U.toScheme.functionField (φ a)) := fun a => by
      rw [← hDv, hξU, Valuation.comap_apply, hφf, hDUv]
    have hyeq : D.f D.E.genericPoint = V.isIrreducible.genericPoint :=
      MMP.Positivity.DivisorOver.eq_of_dominates sY D.valuation
        (MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D _ rfl)
        (MMP.Positivity.DivisorOver.valuation_algebraMap_lt_one D _ rfl)
        (fun a => by
          rw [h1]
          exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one DU _ hz.symm _)
        (fun a ha => by
          rw [h1]
          refine MMP.Positivity.DivisorOver.valuation_algebraMap_lt_one DU _ hz.symm _ ?_
          exact (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
            (IsLocalRing.mem_maximalIdeal _).1 ha (by simpa using hu.map φ.symm))
    ext1
    rw [MMP.Mori.DivisorOver.center_eq_closure_genericPoint, hyeq, hV.def]

variable {W : Scheme.{u}}

/-- On an snc divisor, the components through a point have local equations there. -/
private theorem exists_localEquation (sW : W ⟶ Spec (.of k))
    {E : MMP.Mori.PrimeDivisor W} {D : MMP.Mori.Divisor W} (hD : D.IsSNC sW)
    (hE : E ∈ D.support) {w : W} (hw : w ∈ E.support) :
    ∃ x : W.presheaf.stalk w, IdealSheafData.stalk E.idealSheaf w = Ideal.span {x} := by
  obtain ⟨n, z, j, -, -, hI⟩ := hD.2 w
  exact ⟨z (j ⟨E, hE, hw⟩), hI ⟨E, hE, hw⟩⟩

/-- Two distinct members of a regular system of parameters generate a prime ideal: the
quotient by them is again a regular local ring. -/
private theorem isPrime_span_pair {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    {n : ℕ} {z : Fin n → A} (hz : MMP.Mori.IsRegularSystemOfParameters z) {i i' : Fin n}
    (h : i ≠ i') :
    (Ideal.span {z i, z i'}).IsPrime := by
  have hreg := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  have hn : 2 ≤ n := by
    rcases i with ⟨a, ha⟩
    rcases i' with ⟨b, hb⟩
    have : a ≠ b := fun e => h (Fin.ext e)
    omega
  let o : Fin n := ⟨0, by omega⟩
  let l : Fin n := ⟨1, by omega⟩
  let τ := Equiv.swap o i
  have hi'' : τ i' ≠ o := by
    intro e
    have : i' = τ o := by rw [← e, Equiv.swap_apply_self]
    rw [Equiv.swap_apply_left] at this
    exact h this.symm
  let σ := τ * Equiv.swap l (τ i')
  have hσ0 : σ o = i := by
    simp only [σ, Equiv.Perm.coe_mul, Function.comp_apply]
    rw [Equiv.swap_apply_of_ne_of_ne (by simp [o, l, Fin.ext_iff]) hi''.symm]
    exact Equiv.swap_apply_left o i
  have hσ1 : σ l = i' := by
    simp only [σ, Equiv.Perm.coe_mul, Function.comp_apply, Equiv.swap_apply_left]
    exact Equiv.swap_apply_self _ _ _
  set xs := List.ofFn (z ∘ σ)
  have hgen : Ideal.ofList xs = IsLocalRing.maximalIdeal A := by
    rw [← hz.1]
    simp only [xs, Ideal.ofList, List.mem_ofFn]
    congr 1
    ext a
    simp only [Set.mem_ofPred_eq, Set.mem_range, Function.comp_apply]
    exact ⟨fun ⟨b, hb⟩ => ⟨σ b, hb⟩, fun ⟨b, hb⟩ => ⟨σ.symm b, by simpa using hb⟩⟩
  have hlen : xs.length = (IsLocalRing.maximalIdeal A).spanFinrank := by
    have h2 := hz.2
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal] at h2
    simp only [xs, List.length_ofFn]
    exact_mod_cast h2.symm
  obtain ⟨hmain, -⟩ :=
    IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay A
  have hq := ((hmain xs hgen hlen).2 2 (by simp [xs]; omega)).1
  have htake : xs.take 2 = [z i, z i'] := by
    rw [← hσ0, ← hσ1]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
    simp only [xs, List.ofFn_succ, List.take_succ_cons, List.take_zero, Function.comp_apply]
    rfl
  rw [htake] at hq
  have := IsRegularLocalRing.isDomain (A ⧸ Ideal.ofList [z i, z i'])
  have hp := (Ideal.Quotient.isDomain_iff_prime _).mp this
  have he : Ideal.ofList [z i, z i'] = Ideal.span {z i, z i'} := by
    simp only [Ideal.ofList, List.mem_cons, List.not_mem_nil, or_false]
    rfl
  rwa [he] at hp

/-- At the generic point `w` of an irreducible component `Z` of `E₁ ∩ E₂`, a prime ideal of
`𝒪_{W,w}` containing the ideals of `E₁` and `E₂` is the maximal ideal: it is a point of
`E₁ ∩ E₂` generizing `w`, whose closure is then `Z`. -/
private theorem eq_maximalIdeal_of_stalk_le {E₁ E₂ : MMP.Mori.PrimeDivisor W}
    {Z : IrreducibleCloseds W}
    (hZ : Maximal (fun T : Set W => IsIrreducible T ∧ T ⊆ E₁.support ∩ E₂.support) (Z : Set W))
    {w : W} (hgw : IsGenericPoint w (Z : Set W))
    (P : Ideal (W.presheaf.stalk w)) [hP : P.IsPrime]
    (h₁ : IdealSheafData.stalk E₁.idealSheaf w ≤ P)
    (h₂ : IdealSheafData.stalk E₂.idealSheaf w ≤ P) :
    P = IsLocalRing.maximalIdeal _ := by
  have hw : w ∈ E₁.support ∩ E₂.support := hZ.1.2 hgw.mem
  let q : PrimeSpectrum (W.presheaf.stalk w) := ⟨P, hP⟩
  set p := W.fromSpecStalk w q
  have hpw : p ⤳ w := by
    have := (IsLocalRing.specializes_closedPoint q).map (W.fromSpecStalk w).continuous
    rwa [Scheme.fromSpecStalk_closedPoint] at this
  have hmem : ∀ E : MMP.Mori.PrimeDivisor W, w ∈ E.support →
      IdealSheafData.stalk E.idealSheaf w ≤ P → p ∈ E.support := by
    intro E hwE hle
    obtain ⟨q₁, hq₁, hI, -⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support E hwE
    have hsp : q₁ ⤳ q :=
      (PrimeSpectrum.le_iff_specializes q₁ q).mp (show q₁.asIdeal ≤ P by rw [← hI]; exact hle)
    have := hsp.map (W.fromSpecStalk w).continuous
    rw [hq₁] at this
    rw [E.support_eq_closure]
    exact this.mem_closure
  have hcl : closure {p} ⊆ E₁.support ∩ E₂.support := by
    refine closure_minimal
      (Set.singleton_subset_iff.mpr ⟨hmem E₁ hw.1 h₁, hmem E₂ hw.2 h₂⟩) ?_
    rw [E₁.support_eq_closure, E₂.support_eq_closure]
    exact isClosed_closure.inter isClosed_closure
  have hZp : (Z : Set W) ⊆ closure {p} := by
    rw [← hgw.def]
    exact closure_minimal (Set.singleton_subset_iff.mpr hpw.mem_closure) isClosed_closure
  have := hZ.2 ⟨isIrreducible_singleton.closure, hcl⟩ hZp
  have hwp : w ⤳ p := by
    rw [specializes_iff_mem_closure, hgw.def]
    exact this (subset_closure rfl)
  have heq : p = W.fromSpecStalk w (IsLocalRing.closedPoint _) := by
    rw [Scheme.fromSpecStalk_closedPoint]
    exact (hpw.antisymm hwp).eq
  exact congrArg PrimeSpectrum.asIdeal ((W.fromSpecStalk w).isEmbedding.injective heq)

/-- At the generic point of an irreducible component `Z` of the intersection of two components
`E₁ ≠ E₂` of an snc divisor, local equations of `E₁` and `E₂` generate the maximal ideal. -/
private theorem maximalIdeal_eq_span_pair [IsLocallyNoetherian W] (sW : W ⟶ Spec (.of k))
    {E₁ E₂ : MMP.Mori.PrimeDivisor W} (h12 : E₁ ≠ E₂)
    (hT : MMP.Mori.DivisorWithCoeffs.IsSNC sW
      (Finsupp.single E₁ 1 + Finsupp.single E₂ 1 : MMP.Mori.Divisor W))
    {Z : IrreducibleCloseds W}
    (hZ : Maximal (fun T : Set W => IsIrreducible T ∧ T ⊆ E₁.support ∩ E₂.support) (Z : Set W))
    {x t : W.presheaf.stalk Z.isIrreducible.genericPoint}
    (hx : IdealSheafData.stalk E₁.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {x})
    (ht : IdealSheafData.stalk E₂.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {t}) :
    IsLocalRing.maximalIdeal (W.presheaf.stalk Z.isIrreducible.genericPoint) =
      Ideal.span {x, t} := by
  have hgw := Z.isIrreducible.isGenericPoint_genericPoint Z.isClosed
  have hw := hZ.1.2 hgw.mem
  obtain ⟨n, z, ι, hz, hι, hI⟩ := hT.2 Z.isIrreducible.genericPoint
  have hE₁ : E₁ ∈ (Finsupp.single E₁ 1 + Finsupp.single E₂ 1 : MMP.Mori.Divisor W).support := by
    simp [Finsupp.mem_support_iff, h12]
  have hE₂ : E₂ ∈ (Finsupp.single E₁ 1 + Finsupp.single E₂ 1 : MMP.Mori.Divisor W).support := by
    simp [Finsupp.mem_support_iff, Ne.symm h12]
  have hab : ι ⟨E₁, hE₁, hw.1⟩ ≠ ι ⟨E₂, hE₂, hw.2⟩ := fun h =>
    h12 (congrArg Subtype.val (hι h))
  have h₁ := hI ⟨E₁, hE₁, hw.1⟩
  have h₂ := hI ⟨E₂, hE₂, hw.2⟩
  have hspan : Ideal.span {x, t} =
      Ideal.span {z (ι ⟨E₁, hE₁, hw.1⟩), z (ι ⟨E₂, hE₂, hw.2⟩)} := by
    rw [Ideal.span_insert, Ideal.span_insert, ← hx, ← ht, h₁, h₂]
  have := isPrime_span_pair hz hab
  rw [hspan]
  refine (eq_maximalIdeal_of_stalk_le hZ hgw _ ?_ ?_).symm
  · rw [h₁]
    exact Ideal.span_mono (by simp)
  · rw [h₂]
    exact Ideal.span_mono (by simp)

end Geometry

open Classical in
/-- **Echoes are monomial valuations.** Let `Y` be a normal fourfold over `k` with labels `L`, let
`S ∈ L`, let `V ⊆ S` be an irreducible closed surface whose generic point lies in the one-label
smooth locus `Y°`, and `j ≥ 1`. Let `U ⊆ Y°` be a smooth open subscheme of `Y` containing the
generic point of `V` and meeting no label other than `S`, `S_U` the prime divisor `S ∩ U` of `U`,
`L'` a second prime divisor of `U` with `S_U + L'` snc, and `Z = V ∩ U` an irreducible component
of `S_U ∩ L'`. Then a normalized divisorial valuation `ξ` of `k(Y)`, corresponding to the
valuation `ξ_U` of `k(U)`, is an echo of order `j` of `S` at `V` (`MMP.Fourfold.IsSurfaceEcho`)
if and only if `ξ_U` is monomial of weight `(j, 1)` (weight `j` on `S_U`, `1` on `L'`) at `Z`
for `S_U + L'` (`MMP.Fourfold.IsMonomialValuationOfWeight`). -/
@[mmp "lem_oai4_c1_echo_is_monomial"]
public theorem isSurfaceEcho_iff_isMonomialValuationOfWeight
    {k : Type u} [Field k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]
    {L : Finset (MMP.Mori.PrimeDivisor Y)} {S : MMP.Mori.PrimeDivisor Y}
    {V : IrreducibleCloseds Y} {j : ℕ}
    (hY : MMP.Mori.IsNormalVariety k sY) (hdim : topologicalKrullDim Y = 4) (hS : S ∈ L)
    (hVS : (V : Set Y) ⊆ S.support) (hV : topologicalKrullDim (V : Set Y) = 2)
    (hη : V.isIrreducible.genericPoint ∈ oneLabelSmoothLocus L) (hj : 1 ≤ j)
    {U : Y.Opens} [Nonempty U] (hηU : V.isIrreducible.genericPoint ∈ U)
    (hUY : (U : Set Y) ⊆ oneLabelSmoothLocus L)
    (hUL : ∀ S' ∈ L, S' ≠ S → Disjoint (U : Set Y) S'.support)
    (hU : MMP.Mori.IsSmoothScheme (U.ι ≫ sY))
    {SU LU : MMP.Mori.PrimeDivisor U} (hSU : SU.support = U.ι.base ⁻¹' S.support)
    (hSL : SU ≠ LU)
    (hT : MMP.Mori.DivisorWithCoeffs.IsSNC (U.ι ≫ sY)
      (Finsupp.single SU 1 + Finsupp.single LU 1 : MMP.Mori.Divisor U))
    {Z : IrreducibleCloseds U} (hZV : (Z : Set U) = U.ι.base ⁻¹' V)
    (hZ : Maximal (fun T : Set U => IsIrreducible T ∧ T ⊆ SU.support ∩ LU.support) (Z : Set U))
    {ξ : Valuation Y.functionField ℤᵐ⁰} {ξU : Valuation U.toScheme.functionField ℤᵐ⁰}
    (hξU : haveI := isDominant_ι_of_nonempty U
      ξ = ξU.comap (functionFieldMap U.ι))
    (hξ : ∃ Z' : IrreducibleCloseds Y, MMP.Intersection.IsCentre k sY ξ Z') :
    IsSurfaceEcho sY L S V j ξ ↔
      ∃ z, IsMonomialValuationOfWeight (U.ι ≫ sY)
        (Finsupp.single SU 1 + Finsupp.single LU 1) {SU, LU} Z z
        (fun E => if E.1 = SU then j else 1) ξU := by
  have := isDominant_ι_of_nonempty U
  obtain ⟨φ, hφf, hφS⟩ :=
    exists_stalk_ringEquiv_of_eq _ _ (ι_base_genericPoint hηU hZV) S.idealSheaf
  rw [← idealSheaf_eq_comap hSU] at hφS
  have hcen := isCentre_iff sY hY hηU hZV hξU hξ
  -- `ξ` on the local ring of `Y` is `ξ_U` on the local ring of `U`
  have hval : ∀ g, ξ (algebraMap _ Y.functionField g) =
      ξU (algebraMap _ U.toScheme.functionField (φ g)) := fun g => by
    rw [hξU, Valuation.comap_apply, hφf]
  have hSU0 : SU ∈ ({SU, LU} : Finset _) := by simp
  have hLU0 : LU ∈ ({SU, LU} : Finset _) := by simp
  let i₀ : ({SU, LU} : Finset (MMP.Mori.PrimeDivisor U)) := ⟨SU, hSU0⟩
  let i₁ : ({SU, LU} : Finset (MMP.Mori.PrimeDivisor U)) := ⟨LU, hLU0⟩
  have h01 : i₀ ≠ i₁ := fun h => hSL (congrArg Subtype.val h)
  have hι : ∀ i, i = i₀ ∨ i = i₁ := by
    rintro ⟨E, hE⟩
    rcases Finset.mem_insert.mp hE with rfl | hE
    · exact Or.inl rfl
    · exact Or.inr (Subtype.ext (Finset.mem_singleton.mp hE))
  have hα₀ : (fun E : ({SU, LU} : Finset _) => if E.1 = SU then j else 1) i₀ = j := by simp [i₀]
  have hα₁ : (fun E : ({SU, LU} : Finset _) => if E.1 = SU then j else 1) i₁ = 1 := by
    simp [i₁, hSL.symm]
  -- the weighted monomial ideals are the echo ideals
  have hideal : ∀ (z : ({SU, LU} : Finset (MMP.Mori.PrimeDivisor U)) →
      U.toScheme.presheaf.stalk Z.isIrreducible.genericPoint),
      IdealSheafData.stalk SU.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {z i₀} →
      IdealSheafData.stalk LU.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {z i₁} →
      ∀ m, weightedMonomialIdeal z (fun E => if E.1 = SU then j else 1) m =
        echoIdeal (z i₀) (IsLocalRing.maximalIdeal _) j m := fun z h₀ h₁ m => by
    have := (isVariety_ι sY hY U).toLocallyOfFiniteType
    have : IsLocallyNoetherian U.toScheme := LocallyOfFiniteType.isLocallyNoetherian (U.ι ≫ sY)
    rw [weightedMonomialIdeal_eq_monomialIdeal h01 hι z hα₀ hα₁,
      maximalIdeal_eq_span_pair (U.ι ≫ sY) hSL hT hZ h₀ h₁, echoIdeal_span_pair_eq _ _ hj]
  have hφS' : ∀ x, IdealSheafData.stalk S.idealSheaf V.isIrreducible.genericPoint =
      Ideal.span {x} ↔
      IdealSheafData.stalk SU.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {φ x} := by
    intro x
    rw [← hφS, map_ringEquiv_eq_span_singleton_iff]
  constructor
  · rintro ⟨-, -, -, -, -, -, -, hc, x, hx, hecho⟩
    have hx' := (hφS' x).mp hx
    obtain ⟨t, ht⟩ := exists_localEquation (U.ι ≫ sY) hT
      (by simp [Finsupp.mem_support_iff, hSL])
      (hZ.1.2 (Z.isIrreducible.isGenericPoint_genericPoint Z.isClosed).mem).2
    let z : ({SU, LU} : Finset (MMP.Mori.PrimeDivisor U)) →
        U.toScheme.presheaf.stalk Z.isIrreducible.genericPoint :=
      fun E => if E.1 = SU then φ x else t
    have hz₀ : z i₀ = φ x := by simp [z, i₀]
    have hz₁ : z i₁ = t := by simp [z, i₁, hSL.symm]
    refine ⟨z, isVariety_ι sY hY U, hU, ?_, hT, ⟨i₀.1, hSU0⟩, ?_, ?_, ?_, ?_, hcen.mp hc, ?_⟩
    · intro P
      simp only [MMP.Mori.DivisorWithCoeffs.coeff, Finsupp.add_apply, Finsupp.single_apply]
      by_cases h1 : SU = P <;> by_cases h2 : LU = P <;> simp_all
    · intro E hE
      rcases Finset.mem_insert.mp hE with rfl | hE
      · simp [Finsupp.mem_support_iff, hSL.symm]
      · rw [Finset.mem_singleton.mp hE]
        simp [Finsupp.mem_support_iff, hSL]
    · simpa [Finset.set_biInter_insert] using hZ
    · intro E
      rcases hι E with rfl | rfl
      · rwa [hz₀]
      · rwa [hz₁]
    · intro E
      by_cases h : E.1 = SU <;> simp [h]
      omega
    · intro f hf
      obtain ⟨M, hM, hv⟩ := hecho (φ.symm f) (by simpa using hf)
      refine ⟨M, ?_, ?_⟩
      · convert hM using 2
        funext n
        rw [hideal z (hz₀ ▸ hx') (hz₁ ▸ ht), hz₀,
          ← apply_mem_echoIdeal_iff φ, RingEquiv.apply_symm_apply]
      · rw [← hv, hval, RingEquiv.apply_symm_apply]
  · rintro ⟨z, -, -, -, -, -, -, -, hz, -, hc, hmon⟩
    refine ⟨hY, hdim, hS, hVS, hV, hη, hj, hcen.mpr hc, φ.symm (z i₀),
      (hφS' _).mpr (by rw [RingEquiv.apply_symm_apply]; exact hz i₀), ?_⟩
    intro g hg
    obtain ⟨M, hM, hv⟩ := hmon (φ g) (by simpa using hg)
    refine ⟨M, ?_, ?_⟩
    · convert hM using 2
      funext n
      rw [hideal z (hz i₀) (hz i₁),
        ← apply_mem_echoIdeal_iff φ, RingEquiv.apply_symm_apply]
    · rw [hval, hv]

end Echo

/-! ## Small projective models over the smooth locus -/

section SmallModel

open MMP.Mori

/-- In a factorial domain, a prime ideal containing two relatively prime elements, one of them
nonzero, has height at least two: it strictly contains the height-one prime `(π)` generated by
any prime element `π` it contains. -/
private theorem two_le_height_of_isRelPrime {B : Type*} [CommRing B] [IsDomain B]
    [UniqueFactorizationMonoid B] {q : Ideal B} [q.IsPrime] {a b : B} (hab : IsRelPrime a b)
    (ha : a ∈ q) (hb : b ∈ q) (hb0 : b ≠ 0) : 2 ≤ q.height := by
  have hq : q ≠ ⊥ := fun h => hb0 (by simpa [h] using hb)
  obtain ⟨π, hπq, hπ⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹_› hq
  have hP : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ.ne_zero).mpr hπ
  have h1 : (⊥ : Ideal B) < Ideal.span {π} := by
    rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
    exact hπ.ne_zero
  have h2 : Ideal.span {π} < q := by
    refine lt_of_le_of_ne ((Ideal.span_singleton_le_iff_mem _).mpr hπq) fun h => ?_
    have hpa : π ∣ a := Ideal.mem_span_singleton.mp (h ▸ ha)
    have hpb : π ∣ b := Ideal.mem_span_singleton.mp (h ▸ hb)
    exact hπ.not_unit (hab hpa hpb)
  have e1 := Ideal.height_add_one_le_of_lt_of_isPrime h1
  have e2 := Ideal.height_add_one_le_of_lt_of_isPrime h2
  rw [Ideal.height_bot, zero_add] at e1
  calc (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ (Ideal.span {π}).height + 1 := by gcongr
    _ ≤ q.height := e2

/-- Let `φ : B →+* A` be an injective local homomorphism from a factorial domain to a noetherian
domain, and `f ∈ A` a fraction `φ a / φ b` of elements of `B` which is not in the image of `φ`.
Then some prime of `A` of height at most one contracts to a prime of height at least two: write
`f = φ a' / φ b'` with `a', b'` relatively prime, so `φ b'` is not a unit, and take a minimal
prime over `φ b'` (Krull's principal ideal theorem); it contains `φ a' = f φ b'`. -/
private theorem exists_height_le_one_and_two_le_height_comap {B A : Type*} [CommRing B]
    [CommRing A] [IsDomain B] [UniqueFactorizationMonoid B] [IsDomain A] [IsNoetherianRing A]
    (φ : B →+* A) [IsLocalHom φ] (hφ : Function.Injective φ) {f : A} {a b : B} (hb : b ≠ 0)
    (hf : φ a = f * φ b) (hfr : f ∉ φ.range) :
    ∃ p : Ideal A, p.IsPrime ∧ p.height ≤ 1 ∧ 2 ≤ (p.comap φ).height := by
  obtain ⟨a', b', c, hab, rfl, rfl⟩ := UniqueFactorizationMonoid.exists_reduced_factors' a b hb
  have hc : φ c ≠ 0 := fun h => hb (by rw [(map_eq_zero_iff φ hφ).mp h, zero_mul])
  have hf' : φ a' = f * φ b' := by
    apply mul_left_cancel₀ hc
    rw [← map_mul, hf, map_mul]
    ring
  have hnu : ¬ IsUnit (φ b') := by
    intro hu
    have hu' : IsUnit b' := (isUnit_map_iff φ b').mp hu
    apply hfr
    refine ⟨a' * ↑hu'.unit⁻¹, ?_⟩
    rw [map_mul, hf', mul_assoc, ← map_mul, IsUnit.mul_val_inv, map_one, mul_one]
  have hne : Ideal.span {φ b'} ≠ ⊤ := by
    rwa [Ne, Ideal.span_singleton_eq_top]
  obtain ⟨m, hm, hlm⟩ := Ideal.exists_le_maximal _ hne
  obtain ⟨p, hp, -⟩ := Ideal.exists_minimalPrimes_le hlm
  have hpp : p.IsPrime := hp.1.1
  have hbp : φ b' ∈ p := hp.1.2 (Ideal.subset_span rfl)
  refine ⟨p, hpp, Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ p hp, ?_⟩
  exact two_le_height_of_isRelPrime hab (by simpa [hf'] using p.mul_mem_left f hbp) hbp
    (right_ne_zero_of_mul hb)

/-- The coheight of a generization `y ⤳ x` is the height of its prime in `𝒪_{X,x}`. -/
private theorem coheight_eq_height_primeOfSpecializes {X : Scheme.{u}} {y x : X} (h : y ⤳ x) :
    (Order.coheight y : WithBot ℕ∞) = (MMP.Intersection.primeOfSpecializes h).height := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := MMP.Intersection.isLocalization_stalkSpecializes h
  have e := IsLocalization.AtPrime.ringKrullDim_eq_height
    (MMP.Intersection.primeOfSpecializes h) (X.presheaf.stalk y)
  rwa [ringKrullDim_stalk_eq_coheight] at e

/-- Every prime of `𝒪_{X,x}` is the prime of a generization of `x`. -/
private theorem exists_primeOfSpecializes_eq {X : Scheme.{u}} (x : X)
    (p : Ideal (X.presheaf.stalk x)) [p.IsPrime] :
    ∃ (y : X) (h : y ⤳ x), MMP.Intersection.primeOfSpecializes h = p := by
  have hy : X.fromSpecStalk x ⟨p, ‹_›⟩ ∈ {y | y ⤳ x} := by
    rw [← Scheme.range_fromSpecStalk]
    exact ⟨_, rfl⟩
  exact ⟨_, hy, congrArg PrimeSpectrum.asIdeal ((X.fromSpecStalk x).injective
    (MMP.Intersection.fromSpecStalk_primeOfSpecializes hy))⟩

/-- For a small morphism `g`, no prime of height at most one of `𝒪_{Y',x}` contracts to a prime of
height at least two of `𝒪_{Y, g x}`: its generization `x'` of `x` has codimension at most one,
while `g x'` has codimension at least two, so `x'` lies in `Ex(g)`. -/
private theorem not_two_le_height_comap_stalkMap {k : Type u} [Field k]
    {Y' Y : Scheme.{u}} {sY' : Y' ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} {g : Y' ⟶ Y}
    (hg : IsSmallMorphism sY' sY g) (x : Y') (p : Ideal (Y'.presheaf.stalk x)) [p.IsPrime]
    (hp : p.height ≤ 1) : ¬ 2 ≤ (p.comap (g.stalkMap x).hom).height := by
  intro hq
  obtain ⟨x', h, rfl⟩ := exists_primeOfSpecializes_eq x p
  have h' : g.base x' ⤳ g.base x := h.map g.base.hom.continuous
  have hpy : MMP.Intersection.primeOfSpecializes h' =
      (MMP.Intersection.primeOfSpecializes h).comap (g.stalkMap x).hom := by
    let pt : Spec (Y'.presheaf.stalk x) := ⟨MMP.Intersection.primeOfSpecializes h, inferInstance⟩
    have e : Y.fromSpecStalk (g.base x) ((Spec.map (g.stalkMap x)).base pt) =
        g.base (Y'.fromSpecStalk x pt) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkMap_fromSpecStalk]
    have e2 : (Spec.map (g.stalkMap x)).base pt =
        ⟨(MMP.Intersection.primeOfSpecializes h).comap (g.stalkMap x).hom, inferInstance⟩ := rfl
    rw [e2, MMP.Intersection.fromSpecStalk_primeOfSpecializes h,
      ← MMP.Intersection.fromSpecStalk_primeOfSpecializes h'] at e
    exact (congrArg PrimeSpectrum.asIdeal ((Y.fromSpecStalk _).injective e)).symm
  have hc := coheight_eq_height_primeOfSpecializes h
  have hc' := coheight_eq_height_primeOfSpecializes h'
  rw [hpy] at hc'
  have hex : x' ∈ (exceptionalSet g : Set Y') := by
    intro hmem
    have hiso : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
    have hst : IsIso (g.stalkMap x') :=
      ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff
        (morphismRestrictStalkMap g (biregularLocus g) ⟨x', hmem⟩)).mp
        (((isIso_iff_isIso_stalkMap _).mp hiso).2 _)
    have e := ringKrullDim_eq_of_ringEquiv (asIso (g.stalkMap x')).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight, hc, hc'] at e
    have e' : (MMP.Intersection.primeOfSpecializes h).height =
        ((MMP.Intersection.primeOfSpecializes h).comap (g.stalkMap x).hom).height := by
      exact_mod_cast e.symm
    rw [← e'] at hq
    exact absurd (hq.trans hp) (by decide)
  have h2 := (MMP.Flips.le_closedsCodimension_iff_le_coheight.mp hg.two_le_codimension) x' hex
  rw [WithBot.coe_injective hc] at h2
  exact absurd (h2.trans hp) (by decide)

/-- Purity at a smooth point: for a small morphism `g` and a point `x` of the source lying over a
smooth point of the target, the stalk map `𝒪_{Y, g x} ⟶ 𝒪_{Y', x}` is surjective. The local ring
`𝒪_{Y, g x}` is factorial (`MMP.Intersection.uniqueFactorizationMonoid_stalk_of_isSmoothScheme`
on a smooth open); an element `a / b` of `𝒪_{Y', x}` with `a, b` coprime and `b` a non-unit
would give, by Krull's principal ideal theorem, a codimension-one point of `Y'` over a point of
codimension at least two of `Y`, which lies in `Ex(g)` against smallness. -/
private theorem stalkMap_surjective_of_mem_smoothLocus {k : Type u} [Field k]
    {Y' Y : Scheme.{u}} {sY' : Y' ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} {g : Y' ⟶ Y}
    (hg : IsSmallMorphism sY' sY g) (x : Y') (hx : g.base x ∈ smoothLocus sY) :
    Function.Surjective (g.stalkMap x).hom := by
  have := hg.isNormalVariety_source.1.toIsIntegral
  have := hg.isNormalVariety_target.1.toIsIntegral
  have : LocallyOfFiniteType sY' := hg.isNormalVariety_source.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y' := LocallyOfFiniteType.isLocallyNoetherian sY'
  have hUFD : UniqueFactorizationMonoid (Y.presheaf.stalk (g.base x)) := by
    obtain ⟨V, hxV, hV⟩ := mem_smoothLocus_iff.1 hx
    haveI : Smooth (V.ι ≫ sY) := hV
    haveI := isRegularLocalRing_stalk_of_smooth_over_field (V.ι ≫ sY) ⟨g.base x, hxV⟩
    haveI := IsRegularLocalRing.uniqueFactorizationMonoid (V.toScheme.presheaf.stalk ⟨_, hxV⟩)
    exact MulEquiv.uniqueFactorizationMonoid
      (V.stalkIso ⟨_, hxV⟩).commRingCatIsoToRingEquiv.toMulEquiv inferInstance
  have hb := MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hg.isBirationalMorphism
  have hηx : genericPoint Y' ⤳ x := (genericPoint_spec Y').specializes trivial
  have hη : genericPoint Y' ∈ genericPoints Y' := by rw [genericPoints_eq_singleton]; rfl
  haveI hψ : IsIso (g.stalkMap (genericPoint Y')) := hb.2 _ hη
  have hψb := (ConcreteCategory.isIso_iff_bijective _).mp hψ
  have hy := g.base.hom.map_specializes hηx
  have hιx := MMP.Intersection.stalkSpecializes_injective hηx
  have hιy := MMP.Intersection.stalkSpecializes_injective hy
  have hcomm : ∀ b, g.stalkMap (genericPoint Y') (Y.presheaf.stalkSpecializes hy b) =
      Y'.presheaf.stalkSpecializes hηx (g.stalkMap x b) := fun b =>
    Scheme.Hom.stalkSpecializes_stalkMap_apply g _ x hηx b
  have hφ : Function.Injective (g.stalkMap x).hom := by
    intro b₁ b₂ e
    apply hιy
    apply hψb.1
    change g.stalkMap _ (Y.presheaf.stalkSpecializes hy b₁) =
      g.stalkMap _ (Y.presheaf.stalkSpecializes hy b₂)
    rw [hcomm, hcomm]
    exact congrArg _ e
  intro f
  by_contra hfr
  let := (Y.presheaf.stalkSpecializes hy).hom.toAlgebra
  have := MMP.Intersection.isLocalization_stalkSpecializes hy
  obtain ⟨z, hz⟩ := hψb.2 (Y'.presheaf.stalkSpecializes hηx f)
  obtain ⟨⟨a, s, hs⟩, e⟩ := IsLocalization.surj
    ((IsLocalRing.maximalIdeal (Y.presheaf.stalk (g.base (genericPoint Y')))).comap
      (Y.presheaf.stalkSpecializes hy).hom).primeCompl z
  have hs0 : s ≠ 0 := by rintro rfl; exact hs (zero_mem _)
  have key : (g.stalkMap x).hom a = f * (g.stalkMap x).hom s := by
    apply hιx
    have e' := congrArg (g.stalkMap (genericPoint Y')).hom e
    simp only [map_mul] at e'
    change _ * g.stalkMap _ (Y.presheaf.stalkSpecializes hy s) =
      g.stalkMap _ (Y.presheaf.stalkSpecializes hy a) at e'
    rw [hcomm, hcomm] at e'
    change (g.stalkMap _).hom z * _ = _ at e'
    rw [map_mul, ← e']
    exact congrArg (· * _) hz
  obtain ⟨p, hp, hp1, hp2⟩ := exists_height_le_one_and_two_le_height_comap (g.stalkMap x).hom hφ
    hs0 key (fun ⟨a, ha⟩ => hfr ⟨a, ha⟩)
  exact not_two_le_height_comap_stalkMap hg x p hp1 hp2

/-- A quasi-compact morphism locally of finite type which is surjective on stalks at every point
over `y` has a finite fibre over `y`: a surjective stalk map is finite, so every point of the
fibre is isolated in it, and the fibre is quasi-compact. -/
private theorem finite_preimage_singleton_of_stalkMap_surjective {X Y : Scheme.{u}}
    (f : X ⟶ Y) [QuasiCompact f] [LocallyOfFiniteType f] (y : Y)
    (hs : ∀ x, f.base x = y → Function.Surjective (f.stalkMap x).hom) :
    (f.base ⁻¹' {y}).Finite := by
  refine (f.isCompact_preimage_singleton y).finite ⟨discreteTopology_iff_isOpen_singleton.mpr ?_⟩
  rintro ⟨x, rfl : f.base x = y⟩
  have h1 := (Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber).mp
    (RingHom.QuasiFinite.of_finite (RingHom.Finite.of_surjective _ (hs x rfl)))
  rw [← (f.fiberHomeo (f.base x)).isOpen_image, Set.image_singleton] at h1
  convert h1
  simp [Scheme.Hom.asFiber]

/-- Finiteness of fibres over the smooth locus: a small morphism has finite fibres over every
smooth point of its target. -/
private theorem finite_preimage_singleton_of_mem_smoothLocus {k : Type u} [Field k]
    {Y' Y : Scheme.{u}} {sY' : Y' ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} {g : Y' ⟶ Y}
    (hg : IsSmallMorphism sY' sY g) (y : Y) (hy : y ∈ smoothLocus sY) :
    (g.base ⁻¹' {y}).Finite := by
  have := hg.isNormalVariety_source.1.toIsIntegral
  have := hg.isNormalVariety_target.1.toIsIntegral
  have := hg.isProper
  have : LocallyOfFiniteType sY' := hg.isNormalVariety_source.1.toLocallyOfFiniteType
  rw [← hg.comp_eq] at this
  have : LocallyOfFiniteType g := locallyOfFiniteType_of_comp g sY
  refine finite_preimage_singleton_of_stalkMap_surjective g y ?_
  rintro x rfl
  exact stalkMap_surjective_of_mem_smoothLocus hg x hy

/-- Purity over the smooth locus: a small morphism is biregular at every smooth point
of its target. -/
private theorem smoothLocus_le_biregularLocus {k : Type u} [Field k]
    {Y' Y : Scheme.{u}} {sY' : Y' ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} {g : Y' ⟶ Y}
    (hg : IsSmallMorphism sY' sY g) : smoothLocus sY ≤ biregularLocus g := by
  have hV' := hg.isNormalVariety_source.1
  have hV := hg.isNormalVariety_target.1
  have := hg.isNormalVariety_target.2
  have := hV'.toIsIntegral
  have := hV.toIsIntegral
  have := hg.isProper
  obtain ⟨⟨hO, hiso⟩, -, -⟩ := MMP.Resolution.Bridges.isIso_finiteFibreLocus_and_exceptionalSet_eq
    k hV' hV g hg.comp_eq
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hg.isBirationalMorphism)
  exact le_trans (fun y hy => finite_preimage_singleton_of_mem_smoothLocus hg y hy)
    (le_biregularLocus (V := ⟨_, hO⟩) hiso)

/-- A projective small birational morphism `g : Y' ⟶ Y` of normal varieties over a field is an
isomorphism over the smooth locus of `Y`. -/
@[mmp "lem_oai4_c2_small_model_iso_smooth"]
public theorem isBiregular_smoothLocus_of_isSmallMorphism {k : Type u} [Field k]
    {Y' Y : Scheme.{u}} (sY' : Y' ⟶ Spec (.of k)) (sY : Y ⟶ Spec (.of k)) (g : Y' ⟶ Y)
    (hg : IsSmallMorphism sY' sY g) (hgp : IsProjectiveMorphism g) :
    IsBiregular g (smoothLocus sY) :=
  isBiregular_iff_le_biregularLocus.mpr (smoothLocus_le_biregularLocus hg)

