/-! ### Linear algebra -/

/-- Conjugating by an isomorphism on the source and an injection on the target does not change
the dimension of the kernel. -/
private theorem finrank_ker_eq_of_comp_eq {M N M' N' : Type*} [AddCommGroup M] [Module ℚ M]
    [AddCommGroup N] [Module ℚ N] [AddCommGroup M'] [Module ℚ M'] [AddCommGroup N']
    [Module ℚ N'] (p : M →ₗ[ℚ] N) (q : M' →ₗ[ℚ] N') (eM : M ≃ₗ[ℚ] M') (eN : N →ₗ[ℚ] N')
    (hN : Function.Injective eN) (h : ∀ x, q (eM x) = eN (p x)) :
    Module.finrank ℚ (LinearMap.ker q) = Module.finrank ℚ (LinearMap.ker p) := by
  have : LinearMap.ker q = (LinearMap.ker p).map eM.toLinearMap := by
    ext x
    simp only [LinearMap.mem_ker, Submodule.mem_map_equiv]
    rw [← eM.apply_symm_apply x, h, eM.apply_symm_apply]
    exact ⟨fun hx => hN (by rw [hx, map_zero]), fun hx => by rw [hx, map_zero]⟩
  rw [this, LinearEquiv.finrank_map_eq]

open Classical in
/-- A linear map `ℚ^α → ℚ^β` sending each basis vector `[a]` to a nonzero multiple of a basis
vector `[π a]` has kernel of dimension `∑_b (#π⁻¹(b) - 1)`. -/
private theorem finrank_ker_eq_sum {α β : Type*} [Fintype α] [Fintype β]
    (p : (α →₀ ℚ) →ₗ[ℚ] (β →₀ ℚ)) (π : α → β) (d : α → ℚ) (hd : ∀ a, d a ≠ 0)
    (hp : ∀ a, p (Finsupp.single a 1) = Finsupp.single (π a) (d a)) :
    Module.finrank ℚ (LinearMap.ker p) = ∑ b, (Fintype.card {a // π a = b} - 1) := by
  have hrange : LinearMap.range p = Finsupp.supported ℚ ℚ (Set.range π) := by
    apply le_antisymm
    · rintro _ ⟨x, rfl⟩
      induction x using Finsupp.induction_linear with
      | zero => simp
      | add x y hx hy =>
        rw [map_add]
        exact Submodule.add_mem _ hx hy
      | single a c =>
        rw [← mul_one c, ← smul_eq_mul, ← Finsupp.smul_single, map_smul, hp]
        exact Submodule.smul_mem _ _ (Finsupp.single_mem_supported ℚ _ ⟨a, rfl⟩)
    · rw [Finsupp.supported_eq_span_single, Submodule.span_le]
      rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
      refine ⟨(d a)⁻¹ • Finsupp.single a 1, ?_⟩
      rw [map_smul, hp, Finsupp.smul_single, smul_eq_mul, inv_mul_cancel₀ (hd a)]
  have hrn := LinearMap.finrank_range_add_finrank_ker p
  have hsupp : Module.finrank ℚ (Finsupp.supported ℚ ℚ (Set.range π)) =
      Fintype.card (Set.range π) := by
    rw [(Finsupp.supportedEquivFinsupp (M := ℚ) (R := ℚ) (Set.range π)).finrank_eq]
    simp
  rw [hrange, hsupp, Module.finrank_finsupp_self] at hrn
  have hcard : Fintype.card α = ∑ b, Fintype.card {a // π a = b} := by
    rw [← Fintype.card_sigma]
    exact Fintype.card_congr (Equiv.sigmaFiberEquiv π).symm
  have hrc : Fintype.card (Set.range π) =
      ∑ b, if 0 < Fintype.card {a // π a = b} then 1 else 0 := by
    rw [Finset.sum_boole, ← Fintype.card_subtype]
    refine Fintype.card_congr (Equiv.subtypeEquivRight fun b => ?_)
    simp [Fintype.card_pos_iff, Set.mem_range]
  have hsum : ∀ b, (Fintype.card {a // π a = b} - 1) +
      (if 0 < Fintype.card {a // π a = b} then 1 else 0) = Fintype.card {a // π a = b} :=
    fun b => by split_ifs <;> omega
  have hs := (Finset.sum_add_distrib (s := Finset.univ)
    (f := fun b => Fintype.card {a // π a = b} - 1)
    (g := fun b => if 0 < Fintype.card {a // π a = b} then 1 else 0)).symm
  simp only [hsum] at hs
  omega

open Classical in
/-- A linear map sending each vector `b a` of a finite basis to a nonzero multiple of a vector
`b' (π a)` of a finite basis has kernel of dimension `∑_c (#π⁻¹(c) - 1)`. -/
private theorem finrank_ker_eq_sum_of_basis {α β M N : Type*} [Fintype α] [Fintype β]
    [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N] (b : Module.Basis α ℚ M)
    (b' : Module.Basis β ℚ N) (p : M →ₗ[ℚ] N) (π : α → β) (d : α → ℚ) (hd : ∀ a, d a ≠ 0)
    (hp : ∀ a, p (b a) = d a • b' (π a)) :
    Module.finrank ℚ (LinearMap.ker p) = ∑ c, (Fintype.card {a // π a = c} - 1) := by
  let q : (α →₀ ℚ) →ₗ[ℚ] (β →₀ ℚ) :=
    b'.repr.toLinearMap ∘ₗ p ∘ₗ b.repr.symm.toLinearMap
  rw [← finrank_ker_eq_of_comp_eq p q b.repr b'.repr.toLinearMap b'.repr.injective
    fun x => by simp [q]]
  refine finrank_ker_eq_sum q π d hd fun a => ?_
  simp only [q, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
    Module.Basis.repr_symm_single, one_smul, hp, map_smul, Module.Basis.repr_self,
    Finsupp.smul_single, smul_eq_mul, mul_one]

/-! ### Heights of points -/

/-- **Incomparability.** Over an integral ring map, two comparable primes with the same
contraction are equal. -/
private theorem eq_of_le_of_comap_eq_of_isIntegral {R S : Type*} [CommRing R]
    [CommRing S] (φ : R →+* S) (hφ : φ.IsIntegral) {P Q : Ideal S} [P.IsPrime] (hPQ : P ≤ Q)
    (h : P.comap φ = Q.comap φ) : P = Q := by
  letI := φ.toAlgebra
  haveI : Algebra.IsIntegral R S := ⟨hφ⟩
  by_contra hne
  exact (Ideal.IsIntegral.comap_lt_comap (R := R) (lt_of_le_of_ne hPQ hne)).ne h

/-- Incomparability on spectra: for an integral ring map `φ`, two points of `Spec S` related by
specialization and with the same image under `Spec φ` are equal. -/
private theorem eq_of_specializes_of_isIntegral_specMap {R S : CommRingCat} (φ : R ⟶ S)
    (hφ : φ.hom.IsIntegral) (p q : PrimeSpectrum S) (hpq : p ⤳ q)
    (hc : Spec.map φ p = Spec.map φ q) : p = q := by
  rw [← PrimeSpectrum.le_iff_specializes] at hpq
  exact PrimeSpectrum.ext (eq_of_le_of_comap_eq_of_isIntegral _ hφ hpq
    (congrArg PrimeSpectrum.asIdeal hc))

/-- Incomparability for an integral morphism of affine schemes. -/
private theorem eq_of_specializes_of_isIntegralHom_of_isAffine {X Z : Scheme} [IsAffine X]
    [IsAffine Z] (f : X ⟶ Z) [IsIntegralHom f] {t t' : X} (h : t ⤳ t') (he : f t = f t') :
    t = t' := by
  have hg : (f.appTop).hom.IsIntegral := f.isIntegral_app ⊤ (isAffineOpen_top Z)
  have hc : (Spec.map f.appTop) (X.isoSpec.hom t) = (Spec.map f.appTop) (X.isoSpec.hom t') := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Scheme.isoSpec_hom_naturality,
      Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, he]
  have heq := congrArg X.isoSpec.inv (eq_of_specializes_of_isIntegral_specMap _ hg _ _
    (h.map X.isoSpec.hom.continuous) hc)
  rwa [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Iso.hom_inv_id] at heq

/-- **Incomparability.** The fibres of an integral morphism carry no nontrivial
specializations. -/
private theorem eq_of_specializes_of_isIntegralHom {X Z : Scheme} (f : X ⟶ Z) [IsIntegralHom f]
    {t t' : X} (h : t ⤳ t') (he : f t = f t') : t = t' := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hmem, -⟩ := Z.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ (f t')) isOpen_univ
  have ht' : t' ∈ f ⁻¹ᵁ U := hmem
  have ht : t ∈ f ⁻¹ᵁ U := h.mem_open (f ⁻¹ᵁ U).isOpen ht'
  haveI : IsAffine U := hU
  haveI : IsAffine (f ⁻¹ᵁ U) := hU.preimage f
  let a : (f ⁻¹ᵁ U).toScheme := ⟨t, ht⟩
  let b : (f ⁻¹ᵁ U).toScheme := ⟨t', ht'⟩
  have hab : a ⤳ b := subtype_specializes_iff _ _ |>.2 h
  have hfab : (f ∣_ U) a = (f ∣_ U) b := Subtype.ext
    ((morphismRestrict_base_coe f U a).trans (he.trans (morphismRestrict_base_coe f U b).symm))
  exact congrArg Subtype.val (eq_of_specializes_of_isIntegralHom_of_isAffine (f ∣_ U) hab hfab)

/-- An integral morphism is strictly monotone in the specialization order (incomparability). -/
private theorem strictMono_of_isIntegralHom {X Z : Scheme} (f : X ⟶ Z) [IsIntegralHom f] :
    StrictMono f := by
  intro a b hab
  rw [lt_iff_le_not_ge, Scheme.le_iff_specializes, Scheme.le_iff_specializes] at hab ⊢
  refine ⟨hab.1.map f.continuous, fun h => hab.2 ?_⟩
  rw [eq_of_specializes_of_isIntegralHom f hab.1 ((hab.1.map f.continuous).antisymm h).eq]

/-- An integral morphism preserves heights in the specialization order. -/
private theorem height_apply_eq_of_isIntegralHom {X Z : Scheme} (f : X ⟶ Z) [IsIntegralHom f]
    (x : X) : Order.height (f x) = Order.height x := by
  refine (Order.height_eq_of_strictMono f (strictMono_of_isIntegralHom f) (fun a b hb => ?_) x).symm
  obtain ⟨a', ha', rfl⟩ := f.isClosedMap.specializingMap (Scheme.le_iff_specializes.mp hb.le)
  refine ⟨a', lt_of_le_not_ge (Scheme.le_iff_specializes.mpr ha') fun h => hb.ne ?_, rfl⟩
  rw [(Specializes.antisymm ha' (Scheme.le_iff_specializes.mp h)).eq]

/-- The dimension of a scheme is the supremum of the heights of its points. -/
private theorem topologicalKrullDim_eq_iSup_height (X : Scheme) :
    topologicalKrullDim X = ⨆ x : X, (Order.height x : WithBot ℕ∞) := by
  have hpre : (specializationOrder X).toPreorder = (inferInstance : Preorder X) :=
    Preorder.ext fun a b => (Scheme.le_iff_specializes (a := a) (b := b)).symm
  change Order.krullDim (IrreducibleCloseds X) = _
  rw [@Order.krullDim_eq_of_orderIso _ _ _ (specializationOrder X).toPreorder
    irreducibleSetEquivPoints, hpre, Order.krullDim_eq_iSup_height]

/-- An integral morphism does not raise dimension. -/
theorem dimension_le_of_isIntegralHom {X Z : Scheme} (f : X ⟶ Z) [IsIntegralHom f] {n : ℕ}
    (h : dimension Z ≤ n) : dimension X ≤ n := by
  rw [dimension, topologicalKrullDim_eq_iSup_height]
  refine iSup_le fun x => ?_
  rw [← height_apply_eq_of_isIntegralHom f x]
  exact (le_iSup (fun y => (Order.height y : WithBot ℕ∞)) (f x)).trans
    ((topologicalKrullDim_eq_iSup_height _).symm.le.trans h)

/-- The reduced closed subscheme on a closed subset has the dimension of that subset. -/
theorem dimension_subscheme_vanishingIdeal {Z : Scheme} (A : Closeds Z) :
    dimension (Scheme.IdealSheafData.vanishingIdeal A).subscheme =
      topologicalKrullDim (SetLike.coe A) := by
  rw [dimension, (MMP.Intersection.Scheme.IdealSheafData.subschemeHomeomorphSupport
      _).isHomeomorph.topologicalKrullDim_eq,
    show (Scheme.IdealSheafData.vanishingIdeal A).support = A from
      Closeds.ext (Scheme.IdealSheafData.coe_support_vanishingIdeal A)]
  rfl

/-- The closure of the image of a point under two integral morphisms has the height of the point
as its dimension. -/
theorem topologicalKrullDim_closure_image_eq_height {X Z W : Scheme} (f : X ⟶ Z) (g : Z ⟶ W)
    [IsIntegralHom f] [IsIntegralHom g] (x : X) :
    topologicalKrullDim (closure {g (f x)} : Set W) = Order.height x := by
  rw [AlgebraicGeometry.topologicalKrullDim_closure_singleton_eq_height,
    height_apply_eq_of_isIntegralHom, height_apply_eq_of_isIntegralHom]

/-! ### The normalization of a union of prime divisors -/

/-- Isomorphic schemes have isomorphic normalizations, compatibly with the normalization
morphisms. -/
private theorem exists_iso_normalizationScheme_of_iso {W W' : Scheme}
    (hW : ∀ U : W.Opens, IsCompact (U : Set W) → (irreducibleComponents U).Finite)
    (hW' : ∀ U : W'.Opens, IsCompact (U : Set W') → (irreducibleComponents U).Finite)
    (e : W ≅ W') :
    ∃ E : W.normalizationScheme hW ≅ W'.normalizationScheme hW',
      E.hom ≫ W'.normalization hW' = W.normalization hW ≫ e.hom := by
  have hgen : ∀ {V V' : Scheme} (hV : ∀ U : V.Opens, IsCompact (U : Set V) →
      (irreducibleComponents U).Finite) (e : V ≅ V') (η : genericPoints (V.normalizationScheme hV)),
      (V.normalization hV ≫ e.hom) η.1 ∈ genericPoints V' := fun hV e η =>
    genericPoints_image_of_generalizingMap _ (Scheme.homeoOfIso e).isOpenEmbedding.generalizingMap
      (Scheme.normalization_mem_genericPoints _ hV η.2)
  have := W.isNormal_normalizationScheme hW
  have := W'.isNormal_normalizationScheme hW'
  obtain ⟨a, ha, -⟩ := Scheme.existsUnique_lift_normalization hW' _ (hgen hW e)
  obtain ⟨b, hb, -⟩ := Scheme.existsUnique_lift_normalization hW _ (hgen hW' e.symm)
  obtain ⟨g, -, hu⟩ := Scheme.existsUnique_lift_normalization hW (W.normalization hW)
    (fun η => Scheme.normalization_mem_genericPoints _ hW η.2)
  obtain ⟨g', -, hu'⟩ := Scheme.existsUnique_lift_normalization hW' (W'.normalization hW')
    (fun η => Scheme.normalization_mem_genericPoints _ hW' η.2)
  refine ⟨⟨a, b, ?_, ?_⟩, ha⟩
  · rw [hu (a ≫ b) (by dsimp only; rw [Category.assoc, hb, ← Category.assoc, ha]; simp),
      hu (𝟙 _) (by dsimp only; simp)]
  · rw [hu' (b ≫ a) (by dsimp only; rw [Category.assoc, ha, ← Category.assoc, hb]; simp),
      hu' (𝟙 _) (by dsimp only; simp)]

/-- An irreducible component `Z` of a closed subscheme of `Y`, with its reduced structure, is
isomorphic over `Y` to a prime divisor `S` of `Y` with the same support. -/
private theorem exists_iso_reducedComponent {Y : Scheme} (I : Y.IdealSheafData)
    (Z : irreducibleComponents I.subscheme) (S : AlgebraicGeometry.PrimeDivisor Y)
    (hZS : I.subschemeι '' (Z : Set I.subscheme) = S.support) :
    ∃ e : I.subscheme.reducedComponent Z ≅ S.idealSheaf.subscheme,
      e.hom ≫ S.idealSheaf.subschemeι = I.subscheme.reducedComponentι Z ≫ I.subschemeι := by
  have := S.integral
  have hker : S.idealSheaf.subschemeι.ker =
      (I.subscheme.reducedComponentι Z ≫ I.subschemeι).ker := by
    rw [Scheme.Hom.ker_comp, Scheme.IdealSheafData.ker_subschemeι,
      Scheme.IdealSheafData.ker_subschemeι, Scheme.IdealSheafData.map_vanishingIdeal,
      Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme S.idealSheaf _ rfl]
    congr 1
    ext1
    simp only [Closeds.coe_closure]
    rw [show ((I.subscheme.componentCloseds Z : Set I.subscheme)) = (Z : Set I.subscheme) from rfl,
      hZS, (S.idealSheaf.support.isClosed).closure_eq]
  have := IsClosedImmersion.isIso_lift _ _ hker
  exact ⟨asIso (IsClosedImmersion.lift _ _ hker.le), IsClosedImmersion.lift_fac _ _ _⟩

/-- A prime divisor whose support lies in that of another is that prime divisor. -/
private theorem primeDivisor_eq_of_support_subset {Y : Scheme}
    {S T : AlgebraicGeometry.PrimeDivisor Y} (h : S.support ⊆ T.support) : S = T := by
  have hS : S.genericPoint ∈ T.support := h (by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure] at hS
  have hle : S.genericPoint ≤ T.genericPoint := Scheme.le_iff_specializes.mpr hS
  refine AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_
  by_contra hne
  have := Order.coheight_add_one_le (lt_of_le_not_ge hle fun h' =>
    hne ((Scheme.le_iff_specializes.mp h').antisymm hS).eq)
  rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint,
    AlgebraicGeometry.PrimeDivisor.coheight_genericPoint] at this
  norm_num at this

/-- The irreducible components of a closed subscheme of `Y` supported on the union of a finite
set `Q` of prime divisors are the supports of the members of `Q`. -/
private theorem exists_equiv_irreducibleComponents {Y : Scheme}
    (Q : Finset (AlgebraicGeometry.PrimeDivisor Y)) (I : Y.IdealSheafData)
    (hI : (I.support : Set Y) = ⋃ S ∈ Q, S.support) :
    ∃ c : irreducibleComponents I.subscheme ≃ Q, ∀ Z : irreducibleComponents I.subscheme,
      I.subschemeι '' (Z : Set I.subscheme) = (c Z : AlgebraicGeometry.PrimeDivisor Y).support := by
  classical
  have hemb := I.subschemeι.isClosedEmbedding
  have hpre : ∀ S ∈ Q, ∃ x : I.subscheme, I.subschemeι x = S.genericPoint := by
    intro S hS
    change S.genericPoint ∈ Set.range I.subschemeι
    rw [Scheme.IdealSheafData.range_subschemeι, hI]
    refine Set.mem_biUnion hS ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have himg : ∀ (x : I.subscheme), I.subschemeι '' closure {x} = closure {I.subschemeι x} :=
    fun x => by rw [← hemb.closure_image_eq, Set.image_singleton]
  have hcomp : ∀ Z : irreducibleComponents I.subscheme, ∃ S : Q,
      I.subschemeι '' (Z : Set I.subscheme) = (S : AlgebraicGeometry.PrimeDivisor Y).support := by
    intro Z
    have hirr : IsIrreducible (I.subschemeι '' (Z : Set I.subscheme)) :=
      Z.2.1.image _ I.subschemeι.continuous.continuousOn
    obtain ⟨z, hz, hsub⟩ := (isIrreducible_iff_sUnion_isClosed.mp hirr) (Q.image fun S => S.support)
      (by
        intro z hz
        obtain ⟨S, -, rfl⟩ := Finset.mem_image.mp hz
        exact S.idealSheaf.support.isClosed)
      (by
        rintro _ ⟨x, -, rfl⟩
        have : I.subschemeι x ∈ (I.support : Set Y) :=
          Scheme.IdealSheafData.range_subschemeι I ▸ Set.mem_range_self _
        rw [hI] at this
        obtain ⟨S, hS, hx⟩ := Set.mem_iUnion₂.mp this
        exact Set.mem_sUnion.mpr ⟨_, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hS), hx⟩)
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨x, hx⟩ := hpre S hS
    have hZx : (Z : Set I.subscheme) ⊆ closure {x} := by
      intro w hw
      rw [hemb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton, hx,
        ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hsub ⟨w, hw, rfl⟩
    have hZeq : closure {x} = (Z : Set I.subscheme) :=
      le_antisymm (Z.2.2 isIrreducible_singleton.closure hZx) hZx
    refine ⟨⟨S, hS⟩, ?_⟩
    rw [← hZeq, himg, hx, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  choose c hc using hcomp
  refine ⟨Equiv.ofBijective c ⟨fun Z Z' h => ?_, fun S => ?_⟩, hc⟩
  · have := (hc Z).trans ((congrArg (fun S : Q => (S : AlgebraicGeometry.PrimeDivisor Y).support)
      h).trans (hc Z').symm)
    exact Subtype.ext (Set.image_injective.mpr hemb.injective this)
  · obtain ⟨x, hx⟩ := hpre S.1 S.2
    obtain ⟨Z, hZ, hxZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := x)).closure
    refine ⟨⟨Z, hZ⟩, Subtype.ext (primeDivisor_eq_of_support_subset ?_).symm⟩
    rw [← hc ⟨Z, hZ⟩, AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← hx, ← himg]
    exact Set.image_mono hxZ

/-- **The normalization of a union of prime divisors** (Stacks, Tag 0CDV): the points of the
normalization `N_Q` of a reduced union `Q = ⋃_{S ∈ Q} S` are those of `∐_{S ∈ Q} S^ν`,
compatibly with the maps to `Y`. -/
private theorem exists_equiv_conductorNormalization {Y : Scheme.{0}}
    (Q : Finset (AlgebraicGeometry.PrimeDivisor Y)) (I : Y.IdealSheafData)
    [IsLocallyNoetherian I.subscheme] (hI : (I.support : Set Y) = ⋃ S ∈ Q, S.support) :
    ∃ Ω : (Σ S : Q, primeDivisorNormalizationScheme (S : AlgebraicGeometry.PrimeDivisor Y)) ≃
        Stacks.AlgebraicGeometry.Normalization.normalizationScheme I.subscheme
          (finite_irreducibleComponents_of_isCompact _),
      ∀ p, I.subschemeι (conductorNormalization I.subscheme (Ω p)) =
        primeDivisorNormalization p.1.1 p.2 := by
  set X := I.subscheme
  obtain ⟨e, he⟩ := Scheme.exists_iso_normalizationScheme_sigma_reducedComponent X
    (finite_irreducibleComponents_of_isCompact X)
  obtain ⟨c, hc⟩ := exists_equiv_irreducibleComponents Q I hI
  choose eZ heZ using fun Z => exists_iso_reducedComponent I Z (c Z) (hc Z)
  have hE : ∀ Z : irreducibleComponents X, ∃ E : (X.reducedComponent Z).normalizationScheme
      (X.finite_irreducibleComponents_reducedComponent Z) ≅
        primeDivisorNormalizationScheme (c Z : AlgebraicGeometry.PrimeDivisor Y),
      E.hom ≫ (haveI := (c Z).1.integral
        Stacks.AlgebraicGeometry.Normalization.normalization (c Z).1.idealSheaf.subscheme
          (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)) =
        (X.reducedComponent Z).normalization
          (X.finite_irreducibleComponents_reducedComponent Z) ≫ (eZ Z).hom := by
    intro Z
    haveI := (c Z).1.integral
    exact exists_iso_normalizationScheme_of_iso _
      (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U) (eZ Z)
  choose EZ hEZ using hE
  let σ := Equiv.sigmaCongr
    (β₂ := fun S : Q => ↥(primeDivisorNormalizationScheme (S : AlgebraicGeometry.PrimeDivisor Y)))
    c (fun Z => (Scheme.homeoOfIso (EZ Z)).toEquiv)
  refine ⟨σ.symm.trans ((sigmaMk _).toEquiv.trans (Scheme.homeoOfIso e).toEquiv), fun p => ?_⟩
  obtain ⟨q, rfl⟩ := σ.surjective p
  simp only [Equiv.trans_apply, Equiv.symm_apply_apply]
  obtain ⟨Z, w⟩ := q
  have h1 : conductorNormalization I.subscheme ((Scheme.homeoOfIso e) (sigmaMk _ ⟨Z, w⟩)) =
      X.reducedComponentι Z ((X.reducedComponent Z).normalization _ w) := by
    rw [sigmaMk_mk]
    change (Limits.Sigma.ι _ Z ≫ e.hom ≫ X.normalization _) w = _
    rw [he, Limits.Sigma.ι_desc]
    rfl
  have h2 : (EZ Z).hom ≫ (haveI := (c Z).1.integral
        Stacks.AlgebraicGeometry.Normalization.normalization (c Z).1.idealSheaf.subscheme
          (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)) ≫
        (c Z).1.idealSheaf.subschemeι =
      (X.reducedComponent Z).normalization _ ≫ X.reducedComponentι Z ≫ I.subschemeι := by
    rw [← Category.assoc, hEZ, Category.assoc, heZ]
  change I.subschemeι (conductorNormalization I.subscheme
    ((Scheme.homeoOfIso e) (sigmaMk _ ⟨Z, w⟩))) = (primeDivisorNormalization (c Z).1) ((EZ Z).hom w)
  rw [h1]
  have h3 := congrArg (fun f => f w) h2
  simp only [Scheme.Hom.comp_apply] at h3
  exact h3.symm

/-! ### Prime divisors of the normalization of a prime divisor -/

/-- Cancelling a known summand in `WithBot ℕ∞`. -/
private theorem withBot_enat_eq_of_add_eq {a b : ℕ∞} {m n : ℕ} (hb : b = m)
    (h : (a : WithBot ℕ∞) + b = n) : a = (n - m : ℕ) := by
  have h' : a + b = n := by exact_mod_cast h
  subst hb
  induction a using ENat.recTopCoe with
  | top => simp at h'
  | coe a =>
    have : a + m = n := by exact_mod_cast h'
    norm_cast
    omega

/-- The normalization `S^ν ⟶ S ⊆ Y` of a prime divisor is an integral morphism. -/
private theorem isIntegralHom_primeDivisorNormalization {Y : Scheme}
    (S : AlgebraicGeometry.PrimeDivisor Y) : IsIntegralHom (primeDivisorNormalization S) := by
  haveI := S.integral
  haveI := Scheme.isIntegralHom_normalization S.idealSheaf.subscheme
    (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)
  exact inferInstanceAs (IsIntegralHom (_ ≫ S.idealSheaf.subschemeι))

/-- The normalization of a prime divisor maps the generic point to the generic point. -/
private theorem primeDivisorNormalization_genericPoint {Y : Scheme}
    (S : AlgebraicGeometry.PrimeDivisor Y) :
    letI := S.integral
    letI : IsIntegral (primeDivisorNormalizationScheme S) :=
      AlgebraicGeometry.Scheme.isIntegral_normalizationScheme S.idealSheaf.subscheme
      (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)
    primeDivisorNormalization S (genericPoint (primeDivisorNormalizationScheme S)) =
      S.genericPoint := by
  letI := S.integral
  letI : IsIntegral (primeDivisorNormalizationScheme S) :=
    AlgebraicGeometry.Scheme.isIntegral_normalizationScheme S.idealSheaf.subscheme
      (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)
  have hz : genericPoint (primeDivisorNormalizationScheme S) ∈
      genericPoints (primeDivisorNormalizationScheme S) := by
    rw [genericPoints_eq_singleton]; rfl
  have h := Scheme.normalization_mem_genericPoints S.idealSheaf.subscheme
    (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U) hz
  rw [genericPoints_eq_singleton] at h
  change S.idealSheaf.subschemeι _ = S.idealSheaf.subschemeι _
  congr 1

/-- A strictly monotone map whose image lies strictly below a single element `b` raises
coheight by at least one. -/
private theorem coheight_le_of_strictMono_of_lt {α β : Type*} [Preorder α] [Preorder β]
    {f : α → β} (hf : StrictMono f) {b : β} (hb : ∀ a, f a < b) (x : α) (n : ℕ)
    (hn : Order.coheight (f x) ≤ n + 1) : Order.coheight x ≤ n := by
  rw [Order.coheight_le_iff']
  intro p hp
  have hlast : (p.map f hf).last < b := hb _
  have hq := (Order.length_le_coheight_head (p := (p.map f hf).snoc b hlast)).trans
    (by simpa [hp] using hn)
  simp only [RelSeries.snoc_length, LTSeries.map_length, Nat.cast_add, Nat.cast_one] at hq
  exact Nat.cast_le.2 (Nat.le_of_succ_le_succ (by exact_mod_cast hq))

/-- On an integral scheme locally of finite type over a field, the height and the coheight of
a point add up to the dimension. -/
private theorem height_add_coheight_eq_topologicalKrullDim {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY] (y : Y) :
    (Order.height y : WithBot ℕ∞) + Order.coheight y = topologicalKrullDim Y := by
  let _ : Y.Over (Spec (.of k)) := ⟨sY⟩
  have : LocallyOfFiniteType (Y ↘ Spec (.of k)) := inferInstanceAs (LocallyOfFiniteType sY)
  have h := MMP.Intersection.Scheme.Subvariety.dim_add_codim k
    (MMP.Intersection.Scheme.Subvariety.ofPoint y)
  rwa [MMP.Intersection.Scheme.Subvariety.dim_eq_height_genericPoint,
    MMP.Intersection.Scheme.Subvariety.codim_eq_coheight_genericPoint,
    MMP.Intersection.Scheme.Subvariety.genericPoint_ofPoint] at h

/-- On the normalization `S^ν` of a prime divisor `S` of an integral fourfold of finite type
over a field, a point of height two has coheight one. -/
private theorem coheight_eq_one_of_height_eq_two {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY]
    (hdim : topologicalKrullDim Y = 4) (S : AlgebraicGeometry.PrimeDivisor Y)
    (w : primeDivisorNormalizationScheme S) (hw : Order.height w = 2) :
    Order.coheight w = 1 := by
  haveI := isIntegralHom_primeDivisorNormalization S
  letI := S.integral
  letI : IsIntegral (primeDivisorNormalizationScheme S) :=
    AlgebraicGeometry.Scheme.isIntegral_normalizationScheme S.idealSheaf.subscheme
      (fun U _ => finite_irreducibleComponents_opens_of_irreducibleSpace U)
  set ν := primeDivisorNormalization S
  have hcoS : Order.coheight S.genericPoint = 1 := S.coheight_genericPoint
  have hhS : Order.height S.genericPoint = 3 := by
    have h := height_add_coheight_eq_topologicalKrullDim sY S.genericPoint
    rw [hdim] at h
    simpa using withBot_enat_eq_of_add_eq (m := 1) (n := 4) hcoS (by rw [h]; rfl)
  -- every point of `S^ν` maps strictly below the generic point of `Y`
  have hlt : ∀ a, ν a < genericPoint Y := by
    intro a
    have hle : ν a ≤ genericPoint Y :=
      Scheme.le_iff_specializes.mpr ((genericPoint_spec Y).specializes (Set.mem_univ _))
    refine lt_of_le_not_ge hle fun hge => ?_
    have h1 : genericPoint Y ∈ S.support :=
      (Scheme.le_iff_specializes.mp hge).mem_closed S.idealSheaf.support.isClosed
        (range_primeDivisorNormalization_subset S ⟨a, rfl⟩)
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure] at h1
    have heq : S.genericPoint = genericPoint Y :=
      (((genericPoint_spec Y).specializes (Set.mem_univ _)).antisymm h1).eq.symm
    have : Order.coheight (genericPoint Y) = 0 := Order.coheight_eq_zero.mpr fun b _ =>
      Scheme.le_iff_specializes.mpr ((genericPoint_spec Y).specializes (Set.mem_univ _))
    rw [← heq, hcoS] at this
    exact one_ne_zero this
  have hνw : Order.height (ν w) = 2 := (height_apply_eq_of_isIntegralHom ν w).trans hw
  have hcoνw : Order.coheight (ν w) = 2 := by
    have h := height_add_coheight_eq_topologicalKrullDim sY (ν w)
    rw [hdim, add_comm] at h
    simpa using withBot_enat_eq_of_add_eq (m := 2) (n := 4) hνw (by rw [h]; rfl)
  refine le_antisymm (coheight_le_of_strictMono_of_lt (strictMono_of_isIntegralHom ν) hlt w 1
    (by rw [hcoνw]; rfl)) ?_
  -- `w` is not the generic point of `S^ν`
  have hne : w ≠ genericPoint (primeDivisorNormalizationScheme S) := by
    rintro rfl
    rw [primeDivisorNormalization_genericPoint, hhS] at hνw
    norm_num at hνw
  have hsp : genericPoint (primeDivisorNormalizationScheme S) ⤳ w :=
    (genericPoint_spec _).specializes (Set.mem_univ _)
  have hlt' : w < genericPoint (primeDivisorNormalizationScheme S) :=
    lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hsp) fun h =>
      hne ((Scheme.le_iff_specializes.mp h).antisymm hsp).eq
  exact le_trans (by simp) (Order.coheight_add_one_le hlt')

/-- The image of a prime divisor of `S^ν` in `Y` is the closure of the image of its generic
point. -/
private theorem image_support_primeDivisorNormalization {Y : Scheme}
    (S : AlgebraicGeometry.PrimeDivisor Y)
    (P : AlgebraicGeometry.PrimeDivisor (primeDivisorNormalizationScheme S)) :
    primeDivisorNormalization S '' P.support =
      closure {primeDivisorNormalization S P.genericPoint} := by
  haveI := isIntegralHom_primeDivisorNormalization S
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
    ← IsClosedMap.closure_image_eq_of_continuous
    (primeDivisorNormalization S).isClosedMap (primeDivisorNormalization S).continuous,
    Set.image_singleton]

/-- A morphism which is an isomorphism over an open `U` is injective over `U`. -/
private theorem eq_of_map_eq_of_isBiregular {X Z : Scheme} {f : X ⟶ Z} {U : Z.Opens}
    (h : IsBiregular f U) {x x' : X} (hx : f x ∈ U) (hx' : f x' ∈ U) (he : f x = f x') :
    x = x' := by
  have hinj := (Scheme.homeoOfIso (@asIso _ _ _ _ (f ∣_ U) h)).injective
  have : (f ∣_ U) ⟨x, hx⟩ = (f ∣_ U) ⟨x', hx'⟩ := Subtype.ext
    ((morphismRestrict_base_coe f U ⟨x, hx⟩).trans
      (he.trans (morphismRestrict_base_coe f U ⟨x', hx'⟩).symm))
  exact congrArg Subtype.val (hinj this)

/-! ### Top-degree homology and Stacks cycles -/

section TopDegree

open Stacks.Chow TensorProduct UnderlyingSpace

variable {X : Scheme.{0}} [X.Over (Spec (.of ℂ))] [IsComplexScheme X]

/-- On a complex scheme, a point has delta-dimension `k` exactly when it has height `k`: both are
the dimension of its closure. -/
private theorem relativeDimension_eq_iff_height_eq (x : X) (k : ℕ) :
    relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = k ↔
      Order.height x = k := by
  have h := topologicalKrullDim_closure_singleton_eq ℂ (X ↘ Spec (.of ℂ)) x
  rw [AlgebraicGeometry.topologicalKrullDim_closure_singleton_eq_height] at h
  have h0 := relativeDimension_fieldChowSituation_nonneg ℂ (X ↘ Spec (.of ℂ)) x
  have h' : Order.height x =
      ((relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x).toNat :
        ℕ∞) := by
    exact_mod_cast h
  rw [h', Nat.cast_inj]
  omega

/-- On a complex scheme of dimension at most `k`, the closure of a point of delta-dimension `k`
is an irreducible component. -/
private theorem closure_mem_irreducibleComponents_of_relativeDimension_eq {k : ℕ}
    (hX : dimension X ≤ k) {x : X}
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = k) :
    closure ({x} : Set X) ∈ irreducibleComponents X := by
  obtain ⟨Z, hZ, hxZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
    (isIrreducible_singleton (x := x)).closure
  have hZc := Chow.closure_componentGenericPoint ⟨Z, hZ⟩
  by_cases hxξ : x = Chow.componentGenericPoint ⟨Z, hZ⟩
  · rwa [hxξ, hZc]
  · exfalso
    have hsp : Chow.componentGenericPoint ⟨Z, hZ⟩ ⤳ x :=
      specializes_iff_mem_closure.mpr (hZc ▸ hxZ (subset_closure rfl))
    have hlt := relativeDimension_lt_of_specializes (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) hsp
      (Ne.symm hxξ)
    have hle : topologicalKrullDim (closure ({Chow.componentGenericPoint ⟨Z, hZ⟩} : Set X)) ≤ k :=
      (topologicalKrullDim_subspace_le X _).trans hX
    rw [topologicalKrullDim_closure_singleton_eq ℂ (X ↘ Spec (.of ℂ))] at hle
    have hle' : (relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ))
        (Chow.componentGenericPoint ⟨Z, hZ⟩)).toNat ≤ k := by exact_mod_cast hle
    have h0 := relativeDimension_fieldChowSituation_nonneg ℂ (X ↘ Spec (.of ℂ))
      (Chow.componentGenericPoint ⟨Z, hZ⟩)
    omega

/-- The irreducible component `closure {x}` of a point `x` of delta-dimension `k` on a complex
scheme of dimension at most `k`. -/
private def pointComponent {k : ℕ} (hX : dimension X ≤ k)
    (x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k}) : irreducibleComponents X :=
  ⟨closure {x.1}, closure_mem_irreducibleComponents_of_relativeDimension_eq hX x.2⟩

/-- A complex scheme of dimension at most `k` has finitely many points of delta-dimension `k`. -/
private theorem finite_relativeDimension_eq {k : ℕ} (hX : dimension X ≤ k) :
    Finite {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k} := by
  have := (finite_irreducibleComponents_of_isAlgebraicScheme ℂ X).to_subtype
  refine Finite.of_injective (pointComponent hX) fun x y h => Subtype.ext ?_
  exact (inseparable_iff_closure_eq.mpr (congrArg Subtype.val h)).eq

/-- The rational prime cycles `[x]` of the points of delta-dimension `k` are linearly
independent. -/
private theorem linearIndependent_rationalPointCycle (k : ℕ) :
    LinearIndependent ℚ fun x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
        (X ↘ Spec (.of ℂ)) x = k} =>
      Chow.rationalPointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1 x.2 := by
  classical
  rw [linearIndependent_iff']
  intro s g hg i hi
  have h := congrArg (Chow.rationalCoeff (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k i.1) hg
  rw [map_sum, map_zero, Finset.sum_eq_single i (fun j _ hji => by
      rw [map_smul, Chow.rationalCoeff_rationalPointCycle,
        if_neg fun h => hji (Subtype.ext h).symm, smul_zero])
      (fun h => absurd hi h), map_smul, Chow.rationalCoeff_rationalPointCycle, if_pos rfl,
    smul_eq_mul, mul_one] at h
  exact h

/-- The rational prime cycles `[x]` of the points of delta-dimension `k` span the rational
`k`-cycles. -/
private theorem span_rationalPointCycle (k : ℕ) :
    ⊤ ≤ Submodule.span ℚ (Set.range fun x : {x : X //
        relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = k} =>
      Chow.rationalPointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1 x.2) := by
  rintro α -
  induction α using TensorProduct.induction_on with
  | zero => exact zero_mem _
  | tmul q c =>
    rw [Chow.eq_sum_pointCycleOrZero c, TensorProduct.tmul_sum]
    refine Submodule.sum_mem _ fun x hx => ?_
    have hxk : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x =
        k :=
      (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation ℂ) _ k c.1).mp c.2 x
        ((Chow.finite_support_cycle c).mem_toFinset.mp hx)
    rw [TensorProduct.tmul_smul, Chow.pointCycleOrZero, dif_pos hxk]
    refine zsmul_mem ?_ _
    have he : q ⊗ₜ[ℤ] pointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x hxk =
        q • Chow.rationalPointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x hxk := by
      rw [Chow.rationalPointCycle, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [he]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨⟨x, hxk⟩, rfl⟩)
  | add a b ha hb => exact add_mem ha hb

variable (X) in
/-- The basis of the rational `k`-cycles given by the prime cycles `[x]` of the points of
delta-dimension `k`. -/
private def rationalPointBasis (k : ℕ) :
    Module.Basis {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
        (X ↘ Spec (.of ℂ)) x = k} ℚ
      (Chow.RationalCycleGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k) :=
  Module.Basis.mk (linearIndependent_rationalPointCycle k) (span_rationalPointCycle k)

private theorem rationalPointBasis_apply (k : ℕ)
    (x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k}) :
    rationalPointBasis X k x =
      Chow.rationalPointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1 x.2 :=
  Module.Basis.mk_apply _ _ _

/-- The coordinate of a rational cycle at the basis vector `[x]` is its coefficient at `x`. -/
private theorem rationalCoeff_eq_coord (k : ℕ)
    (x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k}) :
    Chow.rationalCoeff (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1 =
      (rationalPointBasis X k).coord x := by
  classical
  refine (rationalPointBasis X k).ext fun y => ?_
  rw [Module.Basis.coord_apply, Module.Basis.repr_self, rationalPointBasis_apply,
    Chow.rationalCoeff_rationalPointCycle, Finsupp.single_apply]
  by_cases h : y = x
  · subst h
    simp
  · rw [if_neg h, if_neg fun h' => h (Subtype.ext h').symm]

/-- The restriction of the class of a rational cycle to the open set `Uⱼ(ℂ)` of the component
`closure {x}` is its coefficient at `x` times the restriction of `cl(x)`. -/
private theorem restrict_rationalCycleClass_eq_smul {k : ℕ} (hX : dimension X ≤ k)
    (x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k})
    (α : Chow.RationalCycleGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k) :
    borelMooreHomology.restrict ℚ (ModuleCat.of ℚ ℚ) (Y := TopCat.of (UnderlyingSpace ℂ X))
        (singularStratumComplementPointsOpens X (pointComponent hX x)) (2 * k : ℕ)
        (Chow.rationalCycleClass X k α) =
      Chow.rationalCoeff (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1 α •
        borelMooreHomology.restrict ℚ (ModuleCat.of ℚ ℚ) (Y := TopCat.of (UnderlyingSpace ℂ X))
          (singularStratumComplementPointsOpens X (pointComponent hX x)) (2 * k : ℕ)
          (Chow.pointCycleClass ℚ x.1 x.2) := by
  have hW : ∀ x', relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x' = k → x' ≠ x.1 →
      Disjoint ((singularStratumComplementPointsOpens X (pointComponent hX x) : Opens _) :
        Set (UnderlyingSpace ℂ X))
        (Set.range (UnderlyingSpace.mapFun (K := ℂ) (integralComponentAt x').subschemeι)) := by
    intro x' hx' hne
    rw [range_mapFun_of_isClosedImmersion, Set.disjoint_left]
    intro p hp hp'
    have hp'' : p.toHom (IsLocalRing.closedPoint ℂ) ∈ closure ({x'} : Set X) := by
      simp only [Set.mem_setOf_eq] at hp'
      rwa [Scheme.IdealSheafData.range_subschemeι, coe_support_integralComponentAt] at hp'
    refine hp (Or.inr (Set.mem_iUnion₂.mpr ⟨pointComponent hX ⟨x', hx'⟩, fun h => hne ?_, hp''⟩))
    exact (inseparable_iff_closure_eq.mpr (congrArg Subtype.val h)).eq
  induction α using TensorProduct.induction_on with
  | zero => simp
  | tmul q c =>
    rw [Chow.rationalCycleClass_tmul, map_smul, Chow.restrict_cycleClass_eq_smul ℚ x.1 x.2 _ hW c,
      Chow.rationalCoeff_tmul, mul_smul, Int.cast_smul_eq_zsmul]
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, add_smul]

/-- The restriction of `cl(x)` to `Uⱼ(ℂ)`, for the component `closure {x}`, freely generates
`H_{2k}(Uⱼ(ℂ))`. -/
private theorem bijective_smul_restrict_pointCycleClass {k : ℕ} (hX : dimension X ≤ k)
    (x : {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = k}) :
    Function.Bijective fun r : ℚ => r • borelMooreHomology.restrict ℚ (ModuleCat.of ℚ ℚ)
      (Y := TopCat.of (UnderlyingSpace ℂ X))
      (singularStratumComplementPointsOpens X (pointComponent hX x)) (2 * k : ℕ)
      (Chow.pointCycleClass ℚ x.1 x.2) := by
  set j := pointComponent hX x
  have hI : integralComponentAt x.1 =
      Scheme.IdealSheafData.vanishingIdeal ⟨j.1, isClosed_of_mem_irreducibleComponents _ j.2⟩ :=
    rfl
  have key : ∀ I : X.IdealSheafData,
      I = Scheme.IdealSheafData.vanishingIdeal ⟨j.1, isClosed_of_mem_irreducibleComponents _ j.2⟩ →
      letI : I.subscheme.Over (Spec (.of ℂ)) := ⟨I.subschemeι ≫ X ↘ Spec (.of ℂ)⟩
      haveI : I.subschemeι.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
      ((singularStratumComplementPointsOpens X j : Set (UnderlyingSpace ℂ X)) ⊆
          UnderlyingSpace.mapFun (K := ℂ) I.subschemeι '' regularPart ℂ I.subscheme) ∧
        IsConnected (UnderlyingSpace.mapFun (K := ℂ) I.subschemeι ⁻¹'
          (singularStratumComplementPointsOpens X j : Set (UnderlyingSpace ℂ X))) := by
    rintro _ rfl
    exact ⟨singularStratumComplementPointsOpens_subset j,
      isConnected_preimage_singularStratumComplementPointsOpens j⟩
  obtain ⟨hW, hconn⟩ := key _ hI
  exact bijective_smul_restrict_pushforward ℚ (integralComponentAt x.1).subschemeι
    (existsUnique_isVarietyFundamentalClass ℚ
      (Chow.natCast_eq_dimension_integralComponentAt x.1 x.2)).choose_spec.1 _ hW hconn

/-- **Top-degree homology** (Fulton, Lemma 19.1.1): on a complex scheme of dimension at most
`k`, the class map `Z_k(X)_ℚ → H_{2k}(X, ℚ)` on Stacks' rational `k`-cycles is an
isomorphism. -/
theorem bijective_rationalCycleClass {k : ℕ} (hX : dimension X ≤ k) :
    Function.Bijective (Chow.rationalCycleClass X k) := by
  classical
  have := finite_relativeDimension_eq (X := X) hX
  letI := Fintype.ofFinite {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
    (X ↘ Spec (.of ℂ)) x = k}
  set b := rationalPointBasis X k
  refine ⟨(injective_iff_map_eq_zero _).2 fun α hα => ?_, fun d => ?_⟩
  · refine b.ext_elem fun x => ?_
    rw [map_zero, Finsupp.zero_apply, ← Module.Basis.coord_apply, ← rationalCoeff_eq_coord]
    have h := restrict_rationalCycleClass_eq_smul hX x α
    rw [hα, map_zero] at h
    exact (bijective_smul_restrict_pointCycleClass hX x).1 (h.symm.trans (zero_smul ℚ _).symm)
  · choose r hr using fun x => (bijective_smul_restrict_pointCycleClass hX x).2
      (borelMooreHomology.restrict ℚ (ModuleCat.of ℚ ℚ) (Y := TopCat.of (UnderlyingSpace ℂ X))
        (singularStratumComplementPointsOpens X (pointComponent hX x)) (2 * k : ℕ) d)
    refine ⟨∑ x, r x • b x, ?_⟩
    have hcoeff : ∀ x, Chow.rationalCoeff (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x.1
        (∑ y, r y • b y) = r x := fun x => by
      rw [rationalCoeff_eq_coord, Module.Basis.coord_apply, Module.Basis.repr_sum_self]
    have hρ : ∀ x, borelMooreHomology.restrict ℚ (ModuleCat.of ℚ ℚ)
        (Y := TopCat.of (UnderlyingSpace ℂ X))
        (singularStratumComplementPointsOpens X (pointComponent hX x)) (2 * k : ℕ)
        (d - Chow.rationalCycleClass X k (∑ y, r y • b y)) = 0 := fun x => by
      rw [map_sub, restrict_rationalCycleClass_eq_smul hX x, hcoeff]
      exact sub_eq_zero.mpr (hr x).symm
    refine (sub_eq_zero.mp (eq_zero_of_forall_restrict_singularStratumComplementPointsOpens ℚ hX _
      fun Z hZ => ?_)).symm
    have hIZ : integralComponentAt (Chow.componentGenericPoint Z) =
        Scheme.IdealSheafData.vanishingIdeal
          ⟨Z.1, isClosed_of_mem_irreducibleComponents _ Z.2⟩ := by
      unfold integralComponentAt
      congr 1
      exact SetLike.coe_injective (Chow.closure_componentGenericPoint Z)
    have hdim := Chow.dimension_integralComponentAt (Chow.componentGenericPoint Z)
    rw [hIZ] at hdim
    have hk : ((relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ))
        (Chow.componentGenericPoint Z)).toNat : WithBot ℕ∞) = k := hdim.symm.trans hZ.symm
    have hk' : (relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ))
        (Chow.componentGenericPoint Z)).toNat = k := by exact_mod_cast hk
    have h0 := relativeDimension_fieldChowSituation_nonneg ℂ (X ↘ Spec (.of ℂ))
      (Chow.componentGenericPoint Z)
    have hξ : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ))
        (Chow.componentGenericPoint Z) = k := by omega
    have hZeq : pointComponent hX ⟨_, hξ⟩ = Z := Subtype.ext (Chow.closure_componentGenericPoint Z)
    have := hρ ⟨_, hξ⟩
    rwa [hZeq] at this

variable {Z : Scheme.{0}} [Z.Over (Spec (.of ℂ))] [IsComplexScheme Z]

/-- An integral morphism of complex schemes preserves the delta-dimension of points. -/
private theorem relativeDimension_apply_eq_of_isIntegralHom (f : X ⟶ Z) [IsIntegralHom f]
    {x : X} {k : ℕ}
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = k) :
    relativeDimension (fieldChowSituation ℂ).dimensionFunction (Z ↘ Spec (.of ℂ)) (f x) = k := by
  rw [relativeDimension_eq_iff_height_eq] at hx ⊢
  rwa [height_apply_eq_of_isIntegralHom]

omit [IsComplexScheme X] in
/-- A morphism of complex schemes over `ℂ` preserving the delta-dimension of a point has nonzero
residue degree there. -/
private theorem cast_residueDegree_ne_zero_of_relativeDimension_eq (f : X ⟶ Z)
    [f.IsOver (Spec (.of ℂ))] [LocallyOfFiniteType f] {x : X}
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x =
      relativeDimension (fieldChowSituation ℂ).dimensionFunction (Z ↘ Spec (.of ℂ)) (f x)) :
    (f.residueDegree x : ℚ) ≠ 0 := by
  have htr := Stacks.Chow.residueTrdeg_eq_zero_of_relativeDimension_eq
    (fieldChowSituation ℂ).dimensionFunction (Z ↘ Spec (.of ℂ)) (comp_over f _) hx
  let := (f.residueFieldMap x).hom.toAlgebra
  have : Algebra.IsAlgebraic (Z.residueField (f x)) (X.residueField x) :=
    trdeg_eq_zero_iff.mp htr
  have : Algebra.EssFiniteType (Z.residueField (f x)) (X.residueField x) :=
    RingHom.EssFiniteType.residueFieldMap (LocallyOfFiniteType.stalkMap f x)
  have : Module.Finite (Z.residueField (f x)) (X.residueField x) :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  have hpos : 0 < f.residueDegree x := Module.finrank_pos
  exact_mod_cast hpos.ne'

/-- For a proper integral morphism `f : X ⟶ Z` of complex schemes over `ℂ` with `dim Z ≤ k`, the
kernel of `f_* : H_{2k}(X, ℚ) → H_{2k}(Z, ℚ)` has dimension `∑_W (#{x : f(x) = W} - 1)`, the sum
over the points `W` of delta-dimension `k` of `Z` and the count over those of `X`. -/
private theorem finrank_ker_pushforward_eq_sum {k : ℕ} (hZ : dimension Z ≤ k) (f : X ⟶ Z)
    [f.IsOver (Spec (.of ℂ))] [IsProper f] [IsIntegralHom f]
    [Fintype {y : Z // relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (Z ↘ Spec (.of ℂ)) y = k}] :
    Module.finrank ℚ (LinearMap.ker (borelMooreHomology.pushforward ℚ (ModuleCat.of ℚ ℚ)
        (TopCat.ofHom (UnderlyingSpace.map (K := ℂ) f))
        (UnderlyingSpace.isProperMap_map (K := ℂ) f) (2 * k : ℕ)).hom) =
      ∑ W : {y : Z // relativeDimension (fieldChowSituation ℂ).dimensionFunction
          (Z ↘ Spec (.of ℂ)) y = k},
        (Nat.card {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
          (X ↘ Spec (.of ℂ)) x = k ∧ f x = W.1} - 1) := by
  have hX := dimension_le_of_isIntegralHom f hZ
  rw [finrank_ker_eq_of_comp_eq
    (Chow.rationalProperPushforward (fieldChowSituation ℂ) _ _ (k : ℤ) f (comp_over f _)) _
    (LinearEquiv.ofBijective _ (bijective_rationalCycleClass hX))
    (Chow.rationalCycleClass _ k) (bijective_rationalCycleClass hZ).1
    (fun x => (Chow.rationalCycleClass_rationalProperPushforward f k x).symm)]
  have := finite_relativeDimension_eq hX
  let := Fintype.ofFinite {x : X // relativeDimension (fieldChowSituation ℂ).dimensionFunction
    (X ↘ Spec (.of ℂ)) x = k}
  rw [finrank_ker_eq_sum_of_basis (rationalPointBasis _ k) (rationalPointBasis _ k) _
    (fun x => ⟨f x.1, relativeDimension_apply_eq_of_isIntegralHom f x.2⟩) _
    (fun x => cast_residueDegree_ne_zero_of_relativeDimension_eq f
      (x.2.trans (relativeDimension_apply_eq_of_isIntegralHom f x.2).symm))
    (fun x => by
      rw [rationalPointBasis_apply, rationalPointBasis_apply, Chow.rationalPointCycle,
        Chow.rationalProperPushforward_tmul, Chow.properPushforward_pointCycle_eq,
        dif_pos (relativeDimension_apply_eq_of_isIntegralHom f x.2), TensorProduct.tmul_smul,
        ← Int.cast_smul_eq_zsmul ℚ, Int.cast_natCast]
      rfl)]
  refine Finset.sum_congr rfl fun W _ => ?_
  rw [Fintype.card_eq_nat_card]
  exact congrArg (· - 1) (Nat.card_congr
    { toFun := fun a => ⟨a.1.1, a.1.2, congrArg Subtype.val a.2⟩
      invFun := fun e => ⟨⟨e.1, e.2.1⟩, Subtype.ext e.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl })

end TopDegree

/-! ### Branches over the surfaces of `A_Q` -/

/-- A family of prime divisors is determined by the family of their generic points. -/
private theorem sigma_genericPoint_injective {ι : Type*} {X : ι → Scheme} :
    Function.Injective fun P : Σ i, AlgebraicGeometry.PrimeDivisor (X i) =>
      (⟨P.1, P.2.genericPoint⟩ : Σ i, X i) := by
  rintro ⟨i, P⟩ ⟨i', P'⟩ h
  simp only [Sigma.mk.injEq] at h
  obtain ⟨rfl, h⟩ := h
  rw [AlgebraicGeometry.PrimeDivisor.genericPoint_injective (eq_of_heq h)]

/-- A sum `∑ᶠ V, (r V - 1)` in which only the values on the image of an injection `κ` can exceed
one is the finite sum over the source of `κ`. -/
private theorem finsum_tsub_one_eq_sum {β γ : Type*} [Fintype β] {κ : β → γ}
    (hκ : Function.Injective κ) (r : γ → ℕ) (hr : ∀ V, 1 < r V → V ∈ Set.range κ) :
    ∑ᶠ V, (r V - 1) = ∑ b, (r (κ b) - 1) := by
  classical
  rw [finsum_eq_sum_of_support_subset _ (s := Finset.univ.map ⟨κ, hκ⟩) fun V hV => by
    simpa using hr V (by simp at hV; omega), Finset.sum_map]
  rfl

/-- **A surface with two branches lies in `A_Q`.** Since the normalization of `Q` is injective
over the complement of `A_Q`, a surface `V ⊆ Y` with `r_V > 1` is the closure of the image of a
point of height two of `A_Q`. -/
private theorem exists_height_eq_two_of_one_lt_boundaryBranchCount {Y : Scheme.{0}}
    [IsLocallyNoetherian Y] {Q : Finset (AlgebraicGeometry.PrimeDivisor Y)}
    {I : Y.IdealSheafData} (hI : (I.support : Set Y) = ⋃ S ∈ Q, S.support)
    {A : Closeds I.subscheme} (hν : IsBiregular (conductorNormalization I.subscheme) A.compl)
    {V : Set Y} (hV : topologicalKrullDim V = 2) (h : 1 < boundaryBranchCount Q V) :
    ∃ z : (Scheme.IdealSheafData.vanishingIdeal A).subscheme, Order.height z = 2 ∧
      closure {I.subschemeι ((Scheme.IdealSheafData.vanishingIdeal A).subschemeι z)} = V := by
  obtain ⟨Ω, hΩ⟩ := exists_equiv_conductorNormalization Q I hI
  by_contra hne
  refine h.not_ge ?_
  have hs : Set.Subsingleton {P : (S : Q) × AlgebraicGeometry.PrimeDivisor
      (primeDivisorNormalizationScheme (S : AlgebraicGeometry.PrimeDivisor Y)) |
        primeDivisorNormalization (P.1 : AlgebraicGeometry.PrimeDivisor Y) '' P.2.support = V} := by
    intro P hP P' hP'
    rw [Set.mem_setOf_eq, image_support_primeDivisorNormalization] at hP hP'
    have he : I.subschemeι (conductorNormalization I.subscheme (Ω ⟨P.1, P.2.genericPoint⟩)) =
        I.subschemeι (conductorNormalization I.subscheme (Ω ⟨P'.1, P'.2.genericPoint⟩)) := by
      rw [hΩ, hΩ, (inseparable_iff_closure_eq.mpr (hP.trans hP'.symm)).eq]
    replace he := I.subschemeι.isClosedEmbedding.injective he
    by_cases hA : conductorNormalization I.subscheme (Ω ⟨P.1, P.2.genericPoint⟩) ∈ A
    · obtain ⟨z, hz⟩ : _ ∈ Set.range (Scheme.IdealSheafData.vanishingIdeal A).subschemeι := by
        rwa [Scheme.IdealSheafData.range_subschemeι,
          Scheme.IdealSheafData.coe_support_vanishingIdeal]
      refine (hne ⟨z, ?_, by rw [hz, hΩ, hP]⟩).elim
      rw [← hP, AlgebraicGeometry.topologicalKrullDim_closure_singleton_eq_height] at hV
      rw [← height_apply_eq_of_isIntegralHom (Scheme.IdealSheafData.vanishingIdeal A).subschemeι,
        ← height_apply_eq_of_isIntegralHom I.subschemeι, hz, hΩ]
      exact WithBot.coe_inj.mp (by rw [hV]; rfl)
    · exact sigma_genericPoint_injective
        (Ω.injective (eq_of_map_eq_of_isBiregular hν hA (he ▸ hA) he))
  unfold boundaryBranchCount
  rcases hs.eq_empty_or_singleton with h | ⟨a, h⟩ <;> rw [h] <;> simp

/-- **The branches over a surface of `A_Q`.** For a point `w` of height two of `A_Q` (the generic
point of a surface `W ⊆ A_Q`), the prime divisors of the normalizations `S^ν` (`S ∈ Q`) mapping
onto `W` are the points of height two of `F_Q` (the generic points of its surfaces) over `w`. -/
private theorem boundaryBranchCount_closure_eq_card {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY] [IsLocallyNoetherian Y]
    (hdim : topologicalKrullDim Y = 4) {Q : Finset (AlgebraicGeometry.PrimeDivisor Y)}
    {I : Y.IdealSheafData} (hI : (I.support : Set Y) = ⋃ S ∈ Q, S.support)
    {A : Closeds I.subscheme}
    (ι : conductorPreimageScheme A ⟶ (Scheme.IdealSheafData.vanishingIdeal A).subscheme)
    [IsIntegralHom ι]
    (hι : ι ≫ (Scheme.IdealSheafData.vanishingIdeal A).subschemeι =
      (Scheme.IdealSheafData.vanishingIdeal (conductorPreimage A)).subschemeι ≫
        conductorNormalization _)
    (w : (Scheme.IdealSheafData.vanishingIdeal A).subscheme) (hw : Order.height w = 2) :
    boundaryBranchCount Q
        (closure {I.subschemeι ((Scheme.IdealSheafData.vanishingIdeal A).subschemeι w)}) =
      Nat.card {e : conductorPreimageScheme A // Order.height e = 2 ∧ ι e = w} := by
  haveI : IsIntegralHom (conductorNormalization I.subscheme) :=
    Scheme.isIntegralHom_normalization _ (finite_irreducibleComponents_of_isCompact _)
  obtain ⟨Ω, hΩ⟩ := exists_equiv_conductorNormalization Q I hI
  set jF := (Scheme.IdealSheafData.vanishingIdeal (conductorPreimage A)).subschemeι
  set jA := (Scheme.IdealSheafData.vanishingIdeal A).subschemeι
  have hνF (x) : conductorNormalization I.subscheme (jF x) = jA (ι x) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hι]
  have hco (E : {e : conductorPreimageScheme A // Order.height e = 2 ∧ ι e = w}) :
      Order.coheight (Ω.symm (jF E.1)).2 = 1 := by
    refine coheight_eq_one_of_height_eq_two sY hdim _ _ ?_
    haveI := isIntegralHom_primeDivisorNormalization (Ω.symm (jF E.1)).1.1
    rw [← height_apply_eq_of_isIntegralHom (primeDivisorNormalization _), ← hΩ,
      Equiv.apply_symm_apply, height_apply_eq_of_isIntegralHom,
      height_apply_eq_of_isIntegralHom, height_apply_eq_of_isIntegralHom, E.2.1]
  let f (E : {e : conductorPreimageScheme A // Order.height e = 2 ∧ ι e = w}) :
      (Σ S : Q, AlgebraicGeometry.PrimeDivisor
        (primeDivisorNormalizationScheme (S : AlgebraicGeometry.PrimeDivisor Y))) :=
    ⟨_, AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ (hco E)⟩
  have hgf (E) : (⟨(f E).1, (f E).2.genericPoint⟩ : Σ S : Q, primeDivisorNormalizationScheme S.1) =
      Ω.symm (jF E.1) := by
    simp only [f, AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]
  have hfinj : Function.Injective f := fun E E' h => Subtype.ext
    (jF.isClosedEmbedding.injective (Ω.symm.injective (by rw [← hgf, ← hgf, h])))
  unfold boundaryBranchCount
  rw [← Set.ncard_range_of_injective hfinj]
  congr 1
  symm
  ext P
  rw [Set.mem_setOf_eq, image_support_primeDivisorNormalization]
  constructor
  · rintro ⟨E, rfl⟩
    rw [AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne, ← hΩ, Equiv.apply_symm_apply,
      hνF, E.2.2]
  · intro hP
    have h2 : conductorNormalization I.subscheme (Ω ⟨P.1, P.2.genericPoint⟩) = jA w :=
      I.subschemeι.isClosedEmbedding.injective (by rw [hΩ, (inseparable_iff_closure_eq.mpr hP).eq])
    obtain ⟨x, hx⟩ : Ω ⟨P.1, P.2.genericPoint⟩ ∈ Set.range jF := by
      rw [Scheme.IdealSheafData.range_subschemeι,
        Scheme.IdealSheafData.coe_support_vanishingIdeal, coe_conductorPreimage]
      change conductorNormalization I.subscheme _ ∈ A
      have : jA w ∈ Set.range jA := ⟨_, rfl⟩
      rwa [Scheme.IdealSheafData.range_subschemeι,
        Scheme.IdealSheafData.coe_support_vanishingIdeal, ← h2] at this
    have hxh : Order.height x = 2 := by
      rw [← height_apply_eq_of_isIntegralHom jF x, hx,
        ← height_apply_eq_of_isIntegralHom (conductorNormalization I.subscheme), h2,
        height_apply_eq_of_isIntegralHom, hw]
    have hW : ι x = w := jA.isClosedEmbedding.injective (by rw [← hνF, hx, h2])
    refine ⟨⟨x, hxh, hW⟩, sigma_genericPoint_injective ((hgf _).trans ?_)⟩
    change Ω.symm (jF x) = _
    rw [hx, Equiv.symm_apply_apply]

/-- **Kernel of the conductor map.** Let `Y` be a projective complex fourfold, `Q` a finite
set of prime divisors of `Y` and `Q_red = I.subscheme` the reduced closed subscheme on their union,
with normalization `ν : N_Q ⟶ Q_red`. Let `A ⊆ Q_red` be closed of dimension at most two such that
`ν` is an isomorphism over `Q_red ∖ A`, and `ι : F_Q ⟶ A_red` the restriction of `ν` to the
conductor preimage `F_Q = (ν⁻¹ A)_red`. Then the kernel of `ι_* : H_4(F_Q, ℚ) → H_4(A_red, ℚ)` has
dimension `∑ᶠ V, (r_V - 1)` over the irreducible surfaces `V ⊆ ⋃_{S ∈ Q} S`, where
`r_V = MMP.Fourfold.boundaryBranchCount Q V`. -/
@[mmp "lem_oai4_c2_conductor_kernel_dimension"]
theorem finrank_ker_conductorPreimage_pushforward {Y : Scheme.{0}} [Y.Over (Spec (.of ℂ))]
    [AlgebraicGeometry.IsProjectiveVariety ℂ (Y ↘ Spec (.of ℂ))] [IsLocallyNoetherian Y]
    (hdim : topologicalKrullDim Y = 4) (Q : Finset (MMP.Mori.PrimeDivisor Y))
    (I : Y.IdealSheafData) [IsReduced I.subscheme]
    (hI : (I.support : Set Y) = ⋃ S ∈ Q, (S.support : Set Y))
    (A : Closeds I.subscheme) (hA : topologicalKrullDim (SetLike.coe A) ≤ 2)
    (hν : IsBiregular (conductorNormalization I.subscheme) A.compl) :
    letI : (Stacks.AlgebraicGeometry.Normalization.normalizationScheme I.subscheme
        (finite_irreducibleComponents_of_isCompact _)).Over (Spec (.of ℂ)) :=
      ⟨conductorNormalization I.subscheme ≫ (I.subscheme ↘ Spec (.of ℂ))⟩
    haveI : LocallyOfFiniteType ((Scheme.IdealSheafData.vanishingIdeal A).subscheme ↘
        Spec (.of ℂ)) :=
      inferInstanceAs (LocallyOfFiniteType ((Scheme.IdealSheafData.vanishingIdeal A).subschemeι ≫
        (I.subschemeι ≫ (Y ↘ Spec (.of ℂ)))))
    ∀ (ι : conductorPreimageScheme A ⟶ (Scheme.IdealSheafData.vanishingIdeal A).subscheme)
      [ι.IsOver (Spec (.of ℂ))] [IsProper ι],
      ι ≫ (Scheme.IdealSheafData.vanishingIdeal A).subschemeι =
          (Scheme.IdealSheafData.vanishingIdeal (conductorPreimage A)).subschemeι ≫
            conductorNormalization _ →
        Module.finrank ℚ (LinearMap.ker (borelMooreHomology.pushforward ℚ (ModuleCat.of ℚ ℚ)
            (TopCat.ofHom (UnderlyingSpace.map (K := ℂ) ι))
            (UnderlyingSpace.isProperMap_map (K := ℂ) ι) 4).hom) =
          ∑ᶠ V : {V : IrreducibleCloseds Y // topologicalKrullDim (V : Set Y) = 2 ∧
              (V : Set Y) ⊆ ⋃ S ∈ Q, (S.support : Set Y)},
            (boundaryBranchCount Q (V.1 : Set Y) - 1) := by
  letI : (Stacks.AlgebraicGeometry.Normalization.normalizationScheme I.subscheme
      (finite_irreducibleComponents_of_isCompact _)).Over (Spec (.of ℂ)) :=
    ⟨conductorNormalization I.subscheme ≫ (I.subscheme ↘ Spec (.of ℂ))⟩
  intro ι _ _ hι
  haveI : IsIntegral Y := IsVariety.toIsIntegral (k := ℂ) (f := Y ↘ Spec (.of ℂ))
  haveI : IsComplexScheme Y := isComplexScheme_of_isProjectiveVariety Y ‹_›
  haveI : IsIntegralHom (conductorNormalization I.subscheme) :=
    Scheme.isIntegralHom_normalization _ (finite_irreducibleComponents_of_isCompact _)
  have : IsIntegralHom (ι ≫ (Scheme.IdealSheafData.vanishingIdeal A).subschemeι) :=
    hι ▸ inferInstance
  have : IsIntegralHom ι :=
    IsIntegralHom.of_comp ι (Scheme.IdealSheafData.vanishingIdeal A).subschemeι
  haveI : IsComplexScheme (conductorPreimageScheme A) := IsComplexScheme.of_isAffineHom ι
  have hdimA : dimension (Scheme.IdealSheafData.vanishingIdeal A).subscheme ≤ (2 : ℕ) :=
    (dimension_subscheme_vanishingIdeal A).trans_le hA
  have := finite_relativeDimension_eq hdimA
  letI := Fintype.ofFinite {y : (Scheme.IdealSheafData.vanishingIdeal A).subscheme //
    Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation ℂ).dimensionFunction
      ((Scheme.IdealSheafData.vanishingIdeal A).subscheme ↘ Spec (.of ℂ)) y = (2 : ℕ)}
  rw [show (4 : ℤ) = ((2 * 2 : ℕ) : ℤ) from rfl, finrank_ker_pushforward_eq_sum hdimA ι]
  -- the surfaces of `A_Q`, as surfaces of `Y`
  let κ (W : {y : (Scheme.IdealSheafData.vanishingIdeal A).subscheme //
      Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation ℂ).dimensionFunction
        ((Scheme.IdealSheafData.vanishingIdeal A).subscheme ↘ Spec (.of ℂ)) y = (2 : ℕ)}) :
      {V : IrreducibleCloseds Y // topologicalKrullDim (V : Set Y) = 2 ∧
        (V : Set Y) ⊆ ⋃ S ∈ Q, (S.support : Set Y)} :=
    ⟨⟨closure {I.subschemeι ((Scheme.IdealSheafData.vanishingIdeal A).subschemeι W.1)},
        isIrreducible_singleton.closure, isClosed_closure⟩,
      (topologicalKrullDim_closure_image_eq_height _ I.subschemeι W.1).trans
        (congrArg ((↑) : ℕ∞ → WithBot ℕ∞) ((relativeDimension_eq_iff_height_eq W.1 2).1 W.2)),
      hI ▸ closure_minimal (Set.singleton_subset_iff.mpr
        (Scheme.IdealSheafData.range_subschemeι I ▸ Set.mem_range_self _)) I.support.isClosed⟩
  have hκ : Function.Injective κ := fun W W' h => Subtype.ext
    ((Scheme.IdealSheafData.vanishingIdeal A).subschemeι.isClosedEmbedding.injective
      (I.subschemeι.isClosedEmbedding.injective (inseparable_iff_closure_eq.mpr
        (congrArg (fun V => ((V.1 : IrreducibleCloseds Y) : Set Y)) h)).eq))
  rw [finsum_tsub_one_eq_sum hκ (fun V => boundaryBranchCount Q (V.1 : Set Y)) fun V hV => by
    obtain ⟨z, hz, hzV⟩ := exists_height_eq_two_of_one_lt_boundaryBranchCount hI hν V.2.1 hV
    exact ⟨⟨z, (relativeDimension_eq_iff_height_eq z 2).2 hz⟩,
      Subtype.ext (IrreducibleCloseds.ext hzV)⟩]
  refine Finset.sum_congr rfl fun W _ => ?_
  change _ = boundaryBranchCount Q (closure {_}) - 1
  rw [boundaryBranchCount_closure_eq_card (Y ↘ Spec (.of ℂ)) hdim hI ι hι W.1
    ((relativeDimension_eq_iff_height_eq W.1 2).1 W.2)]
  exact congrArg (· - 1) (Nat.card_congr
    { toFun := fun a => ⟨a.1, (relativeDimension_eq_iff_height_eq _ 2).1 a.2.1, a.2.2⟩
      invFun := fun e => ⟨e.1, (relativeDimension_eq_iff_height_eq _ 2).2 e.2.1, e.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl })

end MMP.Fourfold
