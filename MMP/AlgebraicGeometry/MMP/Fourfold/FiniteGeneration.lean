module

public import MMP.AlgebraicGeometry.MMP.Fourfold.StableBase
public import MMP.AlgebraicGeometry.MMP.Fourfold.Singularities
public import MMP.AlgebraicGeometry.MMP.Fourfold.Program
public import MMP.AlgebraicGeometry.Divisor.LinearSystem

/-!
# The birational finite-generation property `F(d)`

For `d ≥ 1`, the property `F(d)` collects three assertions about a normal `ℚ`-factorial complex
`d`-fold `S`, projective and birational over a normal affine variety `T` by `f : S ⟶ T`, and an
effective real klt boundary `Θ` on `S`, all base conditions being relative to `T`:

* if `Θ` is rational, the algebra of global sections `⊕_{m ≥ 0} H⁰(S, ⌊m(K_S + Θ)⌋)` of the
  relative floor-section algebra of `K_S + Θ` is a finitely generated `Γ(T, 𝒪_T)`-algebra;
* in the real vector space spanned by the prime components of `Θ`, the divisorial stable base
  primes of `K_S + Θ` persist for all nearby effective klt boundaries;
* in the smallest rational affine hull `W` of `Θ` there are a neighbourhood of `Θ` and an integer
  `r > 0` such that for every effective klt `Φ` in it and every `k > 0` with `k(K_S + Φ)/r`
  integral Cartier, `|k(K_S + Φ)|` is nonempty and every component of its fixed divisor is a
  stable base prime of `K_S + Θ`.

## Main definitions

* `MMP.Fourfold.IsRealKltPair`: klt pairs with a real boundary.
* `MMP.Fourfold.IsInSmallestRationalAffineHull`: the smallest affine subspace defined over `ℚ`,
  of the real span of the prime components of `Θ`, containing `Θ`.
* `MMP.Fourfold.relativeConstantsMap`: `Γ(T, 𝒪_T) → K(S)[t]`, the structure map of the section
  algebra over `T`.
* `MMP.Fourfold.BirationalFiniteGenerationProperty`: the property `F(d)`.

## Implementation notes

Since `T` is affine, the global sections over `T` of the relative floor-section algebra
`⊕_m f_* 𝒪_S(⌊m(K_S + Θ)⌋)` are `⊕_m H⁰(S, ⌊m(K_S + Θ)⌋)`; for rational `Θ` and an integral
canonical divisor `K_S` this is the canonical ring `R(S, K_S + Θ)` of
`MMP.Mori.Divisor.canonicalRing`, a subset of `K(S)[t]`. Finite generation over `Γ(T, 𝒪_T)` is
stated as the equality of this subset with the subring generated by the image of `Γ(T, 𝒪_T)` and
finitely many elements.

Neighbourhoods in the finite-dimensional coefficient spaces are taken for the maximum norm of the
coefficients, which defines the Euclidean topology.

The smallest rational affine hull of `Θ` is described by its equations: the real divisors `Φ`
supported on the support of `Θ` satisfying every rational affine equation `∑ c_P x_P = q`
(`c_P, q ∈ ℚ`) that `Θ` satisfies. An intersection of affine subspaces defined over `ℚ` is
defined over `ℚ`, so this is the smallest one containing `Θ`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], 2.34
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

universe u

namespace MMP.Fourfold

open MMP.Mori

/-! ### Real klt pairs -/

section RealKlt

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- A pair `(X, B)` with a real boundary `B` is *klt*: `X` is a normal variety, `K_X + B` is
`ℝ`-Cartier for a canonical divisor `K_X`, every coefficient of `B` is less than one, and
`a(E, X, B) > 0` for every divisor `E` over `X`. -/
def IsRealKltPair (B : RDivisor X) : Prop :=
  IsNormalVariety k sX ∧ (∀ P, B.coeff P < 1) ∧
    (∃ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n ∧
      RDivisor.IsRCartier (Finsupp.mapRange (Int.cast : ℤ → ℝ) Int.cast_zero K + B)) ∧
    ∀ (n : ℕ) (E : DivisorOver k sX) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n B E a → 0 < a

end RealKlt

/-! ### The smallest rational affine hull -/

section Hull

variable {X : Scheme.{u}}

/-- `Φ` lies in the *smallest rational affine hull* of `Θ`: `Φ` lies in the real span of the
prime components of `Θ` and satisfies every rational affine equation `∑_P c_P x_P = q`
(`c_P, q ∈ ℚ`) satisfied by `Θ`. -/
def IsInSmallestRationalAffineHull (Θ Φ : RDivisor X) : Prop :=
  Φ.support ⊆ Θ.support ∧
    ∀ (c : MMP.Mori.PrimeDivisor X →₀ ℚ) (q : ℚ),
      (c.sum fun P cP => (cP : ℝ) * Θ.coeff P) = q →
        (c.sum fun P cP => (cP : ℝ) * Φ.coeff P) = q

end Hull

/-! ### The property `F(d)` -/

/-- The ring map `Γ(T, 𝒪_T) → Γ(S, 𝒪_S) → K(S) → K(S)[t]` by which the section algebras of
divisors on `S` are algebras over `Γ(T, 𝒪_T)`, for `f : S ⟶ T`. -/
def relativeConstantsMap {S T : Scheme.{u}} (f : S ⟶ T) :
    Γ(T, ⊤) →+* Polynomial ((rationalFunctionsPresheaf S).obj (op ⊤)) :=
  Polynomial.C.comp (((toRationalFunctionsPresheaf S).app (op ⊤)).hom.comp f.appTop.hom)

/-- **The birational finite-generation property `F(d)`.** For every normal `ℚ`-factorial complex
variety `S` of dimension `d`, every projective birational morphism `f : S ⟶ T` (over `ℂ`) to a
normal affine variety `T`, every effective real klt boundary `Θ` on `S` and every canonical
divisor `K` of `S`:

1. if `Θ` is rational, the algebra `⊕_{m ≥ 0} H⁰(S, ⌊m(K + Θ)⌋) tᵐ` is generated, as an algebra
   over `Γ(T, 𝒪_T)`, by finitely many elements;
2. there is `ε > 0` such that for every effective real klt boundary `Θ'` supported on the support
   of `Θ` with all coefficients within `ε` of those of `Θ`, every divisorial stable base prime of
   `K + Θ` over `T` is a divisorial stable base prime of `K + Θ'` over `T`;
3. there are `ε > 0` and an integer `r > 0` such that for every effective real klt boundary `Φ`
   in the smallest rational affine hull of `Θ` with all coefficients within `ε` of those of `Θ`,
   every `k > 0` and every Cartier divisor `D` with `k(K + Φ)/r = D`, the system `|rD|` is
   nonempty and every prime divisor of positive relative fixed multiplicity in `|rD|` over `T`
   is a divisorial stable base prime of `K + Θ` over `T`. -/
@[mmp "def_fourfold_birational_property_f"]
def BirationalFiniteGenerationProperty (d : ℕ) : Prop :=
  1 ≤ d ∧
  ∀ (S : Scheme.{0}) [IsIntegral S] [CompactSpace S] [IsLocallyNoetherian S] [IsNormal S]
    (sS : S ⟶ Spec (.of ℂ)) (T : Scheme.{0}) (sT : T ⟶ Spec (.of ℂ)) (f : S ⟶ T),
    IsQFactorial sS → topologicalKrullDim S = d →
    IsNormalVariety ℂ sT → IsAffine T → f ≫ sT = sS →
    IsProjectiveMorphism f → IsBirationalMorphism f →
    ∀ Θ : RDivisor S, (∀ P, 0 ≤ Θ.coeff P) → IsRealKltPair sS Θ →
    ∀ (K : Divisor S) (hK : K.IsCanonicalDivisor sS d),
    let KR : RDivisor S := Finsupp.mapRange (Int.cast : ℤ → ℝ) Int.cast_zero K
    -- finite generation of the floor-section algebra for rational `Θ`
    (∀ Θq : QDivisor S, QDivisor.toRDivisor Θq = Θ →
      ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf S).obj (op ⊤))),
        (K.canonicalRing sS hK Θq : Set (Polynomial ((rationalFunctionsPresheaf S).obj (op ⊤)))) =
          Subring.closure (Set.range (relativeConstantsMap f) ∪ ↑G)) ∧
    -- persistence of the divisorial stable base primes near `Θ`
    (∃ ε : ℝ, 0 < ε ∧ ∀ Θ' : RDivisor S, Θ'.support ⊆ Θ.support →
      (∀ P, 0 ≤ Θ'.coeff P) → IsRealKltPair sS Θ' →
      (∀ P, |Θ'.coeff P - Θ.coeff P| < ε) →
      ∀ G : MMP.Mori.PrimeDivisor S, IsInRelativeDivisorialStableBase f (KR + Θ) G →
        IsInRelativeDivisorialStableBase f (KR + Θ') G) ∧
    -- the fixed parts along the smallest rational affine hull
    (∃ ε : ℝ, 0 < ε ∧ ∃ r : ℕ, 0 < r ∧ ∀ Φ : RDivisor S, IsInSmallestRationalAffineHull Θ Φ →
      (∀ P, 0 ≤ Φ.coeff P) → IsRealKltPair sS Φ →
      (∀ P, |Φ.coeff P - Θ.coeff P| < ε) →
      ∀ k : ℕ, 0 < k → ∀ D : Divisor S, D.IsCartier →
        (∀ P, (k : ℝ) / r * (KR.coeff P + Φ.coeff P) = D.coeff P) →
        (∃ φ ∈ ((r : ℤ) • D).divisorialSubmodule ⊤, φ ≠ 0) ∧
          ∀ G : MMP.Mori.PrimeDivisor S, 0 < relativeFixedMultiplicity f ((r : ℤ) • D) G →
            IsInRelativeDivisorialStableBase f (KR + Θ) G)

end MMP.Fourfold
