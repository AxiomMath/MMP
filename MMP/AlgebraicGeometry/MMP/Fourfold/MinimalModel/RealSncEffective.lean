    (W := W') (p := r₁ ≫ p) (q := r₂) (h := e'.symm.toRationalMap) hW'np.1
    (by rw [Category.assoc, hR.comp_eq_left]; exact hr₁sm)
    (by rw [hsq', Category.assoc, hR.comp_eq_left])
    (hr₁p.comp hR.isProjectiveMorphism_left) hr₂p hp'b hr₂b hH rfl hpq' hltV'
  exact ⟨V', inferInstance, inferInstance, inferInstance, inferInstance, _, _, KY', BV', _, hLMM⟩

/-- **Closedness.** If `(X/Z, B + t C)` has log minimal models for parameters `t > τ`
arbitrarily close to `τ`, then `(X/Z, B + τ C)` has one. -/
private theorem hasModel_of_frequently_hasModel {B C N : RDivisor X} {α : ℝ}
    (hD : IsFloorDatum sX sZ π KX A B C N α) {τ : ℝ} (hτ0 : 0 ≤ τ) (hτ1 : τ < 1)
    (h : ∀ ε > 0, ∃ t, τ < t ∧ t < τ + ε ∧ t ≤ 1 ∧ HasModel sX sZ π KX (B + t • C)) :
    HasModel sX sZ π KX (B + τ • C) := by
  refine hasModel_of_hasNefModel hD.hX hD.hXsm hD.hdim hD.hZ hD.hπ hD.hKX (fun P => ?_)
    (fun P => ?_) (hD.hsnc.of_support_subset fun P hP => ?_) hD.hA hD.hA0 (fun P => ?_)
    (fun P hP => ?_) (hasNefModel_of_frequently_hasModel hD hτ0 hτ1 h)
  · have := hD.hB P; have := hD.hC P
    change 0 ≤ B.coeff P + τ * C.coeff P
    positivity
  · have h1 := hD.hBC1 P; have := hD.hC P; have := hD.hB P
    change B.coeff P + C.coeff P ≤ 1 at h1
    change B.coeff P + τ * C.coeff P ≤ 1
    nlinarith
  · rw [Finsupp.mem_support_iff] at hP ⊢
    intro h0
    have hB0 := hD.hB P; have hC0 := hD.hC P
    change B.coeff P + C.coeff P = 0 at h0
    apply hP
    change B.coeff P + τ * C.coeff P = 0
    have hb : B.coeff P = 0 := by linarith
    have hc : C.coeff P = 0 := by linarith
    rw [hb, hc]; ring
  · have := hD.hAB P; have := hD.hC P
    change _ ≤ B.coeff P + τ * C.coeff P
    nlinarith
  · have h1 := hD.hAfl P hP; have := hD.hC P
    change B.coeff P + C.coeff P < 1 at h1
    change B.coeff P + τ * C.coeff P < 1
    nlinarith

/-- The descent along `[0, 1]`: if `α (K_X + B) ≡_Z C + N` is a floor identity and `(X/Z, B + C)`
has a log minimal model, then so has `(X/Z, B)`. -/
private theorem hasModel_of_hasModel_add {B C N : RDivisor X} {α : ℝ}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P) (hBC1 : ∀ P, (B + C).coeff P ≤ 1)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N))
    (hmodel : HasModel sX sZ π KX (B + C)) :
    HasModel sX sZ π KX B := by
  have hD : IsFloorDatum sX sZ π KX A B C N α :=
    ⟨hX, hXsm, hdim, hZ, hπ, hKX, hB, hC, hBC1, hlc, hsnc, hCB, hA, hA0, hAB, hAfl, hα, hN, hNB,
      hfloor⟩
  -- the set `T` of parameters with a log minimal model, and its infimum `τ`
  set T : Set ℝ := {t | 0 ≤ t ∧ t ≤ 1 ∧ HasModel sX sZ π KX (B + t • C)} with hTdef
  have h1T : (1 : ℝ) ∈ T := ⟨zero_le_one, le_rfl, by rwa [one_smul]⟩
  have hTne : T.Nonempty := ⟨1, h1T⟩
  have hTbdd : BddBelow T := ⟨0, fun t ht => ht.1⟩
  set τ := sInf T with hτdef
  have hτ0 : 0 ≤ τ := le_csInf hTne fun t ht => ht.1
  have hτ1 : τ ≤ 1 := csInf_le hTbdd h1T
  -- `τ ∈ T`
  have hτT : HasModel sX sZ π KX (B + τ • C) := by
    rcases hτ1.lt_or_eq with hlt | heq
    · by_contra hnot
      refine hnot (hasModel_of_frequently_hasModel hD hτ0 hlt fun ε hε => ?_)
      obtain ⟨t, htT, htlt⟩ := Real.lt_sInf_add_pos hTne hε
      refine ⟨t, lt_of_le_of_ne (csInf_le hTbdd htT) fun h => ?_, htlt, htT.2.1, htT.2.2⟩
      exact hnot (h ▸ htT.2.2)
    · rw [heq]; simpa using h1T.2.2
  -- `τ = 0`, by left openness
  have hτz : τ = 0 := by
    by_contra hne
    have hτpos : 0 < τ := lt_of_le_of_ne hτ0 (Ne.symm hne)
    obtain ⟨ε, hε, hu⟩ := exists_pos_hasModel_of_hasModel hD hτpos hτ1 hτT
    set u := max (τ - ε / 2) (τ / 2) with hudef
    have hu1 : τ - ε < u := lt_of_lt_of_le (by linarith) (le_max_left _ _)
    have hu2 : u < τ := max_lt (by linarith) (by linarith)
    have huT : u ∈ T := ⟨le_trans (by linarith) (le_max_right _ _), by linarith,
      hu u hu1 hu2⟩
    exact absurd (csInf_le hTbdd huT) (not_le.mpr hu2)
  rw [hτz, zero_smul, add_zero] at hτT
  exact hτT

/-- The inductive step `θ > 0`. -/
private theorem hasModel_of_theta_pos {B M : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M))
    (hKBM : IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B) M)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hAM : ∀ P, A.coeff P ≠ 0 → M.coeff P = 0)
    (hθ : 0 < theta B M)
    (IH : ∀ B' M' : RDivisor X, theta B' M' < theta B M →
      (∀ P, 0 ≤ B'.coeff P) → (∀ P, B'.coeff P ≤ 1) → (∀ P, 0 ≤ M'.coeff P) →
      DivisorWithCoeffs.IsSNC sX (B' + M') →
      IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B') M' →
      (∀ P, (QDivisor.toRDivisor A).coeff P ≤ B'.coeff P) →
      (∀ P, A.coeff P ≠ 0 → B'.coeff P < 1) →
      (∀ P, A.coeff P ≠ 0 → M'.coeff P = 0) → HasModel sX sZ π KX B') :
    HasModel sX sZ π KX B := by
  classical
  -- the components of `M` outside `⌊B⌋` and the first level `α` at which one reaches one
  set S := M.support.filter fun P => B.coeff P < 1 with hSdef
  have hS : S.Nonempty := Finset.card_pos.mp hθ
  have hMpos : ∀ P ∈ S, 0 < M.coeff P := fun P hP =>
    lt_of_le_of_ne (hM P) (Ne.symm (Finsupp.mem_support_iff.mp (Finset.mem_filter.mp hP).1))
  have hBlt : ∀ P ∈ S, B.coeff P < 1 := fun P hP => (Finset.mem_filter.mp hP).2
  set α := S.inf' hS fun P => (1 - B.coeff P) / M.coeff P with hαdef
  obtain ⟨P₀, hP₀S, hP₀⟩ := Finset.exists_mem_eq_inf' hS fun P => (1 - B.coeff P) / M.coeff P
  have hα : 0 < α := by
    rw [hαdef, Finset.lt_inf'_iff]
    exact fun P hP => div_pos (by linarith [hBlt P hP]) (hMpos P hP)
  have hαle : ∀ P ∈ S, α * M.coeff P ≤ 1 - B.coeff P := fun P hP =>
    (le_div_iff₀ (hMpos P hP)).mp (Finset.inf'_le _ hP)
  have hαP₀ : α * M.coeff P₀ = 1 - B.coeff P₀ := by
    rw [← hαdef] at hP₀
    rw [hP₀, div_mul_cancel₀ _ (hMpos P₀ hP₀S).ne']
  -- `C = α M` outside `⌊B⌋` and `N = α M` on it
  set C : RDivisor X := Finsupp.filter (fun P => B.coeff P < 1) (α • M) with hCdef
  set N : RDivisor X := Finsupp.filter (fun P => ¬ B.coeff P < 1) (α • M) with hNdef
  have hCc : ∀ P, C.coeff P = if B.coeff P < 1 then α * M.coeff P else 0 := fun P => by
    change (Finsupp.filter (fun P => B.coeff P < 1) (α • M)) P = _
    rw [Finsupp.filter_apply]
    split_ifs <;> simp [DivisorWithCoeffs.coeff_apply]
  have hNc : ∀ P, N.coeff P = if B.coeff P < 1 then 0 else α * M.coeff P := fun P => by
    change (Finsupp.filter (fun P => ¬ B.coeff P < 1) (α • M)) P = _
    rw [Finsupp.filter_apply]
    split_ifs <;> simp [DivisorWithCoeffs.coeff_apply]
  have hCN : C + N = α • M := Finsupp.filter_pos_add_filter_neg _ _
  have hC : ∀ P, 0 ≤ C.coeff P := fun P => by
    rw [hCc]; split_ifs
    · exact mul_nonneg hα.le (hM P)
    · exact le_rfl
  have hN : ∀ P, 0 ≤ N.coeff P := fun P => by
    rw [hNc]; split_ifs
    · exact le_rfl
    · exact mul_nonneg hα.le (hM P)
  have hBC1 : ∀ P, (B + C).coeff P ≤ 1 := fun P => by
    change B.coeff P + C.coeff P ≤ 1
    rw [hCc]; split_ifs with h
    · by_cases hMP : M.coeff P = 0
      · rw [hMP, mul_zero, add_zero]; exact h.le
      · have hPS : P ∈ S := Finset.mem_filter.mpr ⟨Finsupp.mem_support_iff.mpr hMP, h⟩
        linarith [hαle P hPS]
    · rw [add_zero]; exact hB1 P
  have hCM : ∀ P, M.coeff P = 0 → C.coeff P = 0 := fun P h => by
    rw [hCc, h, mul_zero, ite_self]
  have hsupp : (B + C).support ⊆ (B + M).support := by
    intro P hP
    rw [Finsupp.mem_support_iff] at hP ⊢
    change B.coeff P + M.coeff P ≠ 0
    change B.coeff P + C.coeff P ≠ 0 at hP
    intro h0
    have hB0 : B.coeff P = 0 := by linarith [hB P, hM P]
    have hM0 : M.coeff P = 0 := by linarith [hB P, hM P]
    exact hP (by rw [hB0, hCM P hM0, add_zero])
  have hsncBC : DivisorWithCoeffs.IsSNC sX (B + C) := hsnc.of_support_subset hsupp
  have hAfl' : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1 := fun P hP => by
    change B.coeff P + C.coeff P < 1
    rw [hCM P (hAM P hP), add_zero]; exact hAfl P hP
  -- the induction hypothesis for `(B + C, M + C)`
  have hmodel : HasModel sX sZ π KX (B + C) := by
    refine IH (B + C) (M + C) ?_ (fun P => add_nonneg (hB P) (hC P)) hBC1
      (fun P => add_nonneg (hM P) (hC P)) ?_ ?_ (fun P => (hAB P).trans ?_) hAfl' ?_
    · -- `θ` drops: the component `P₀` reaches coefficient one
      refine Finset.card_lt_card ⟨fun P hP => ?_, fun hsub => ?_⟩
      · rw [Finset.mem_filter, Finsupp.mem_support_iff] at hP ⊢
        obtain ⟨hP1, hP2⟩ := hP
        change B.coeff P + C.coeff P < 1 at hP2
        have hBP : B.coeff P < 1 := by linarith [hC P]
        refine ⟨fun hMP => hP1 ?_, hBP⟩
        have hMP' : M.coeff P = 0 := hMP
        change M.coeff P + C.coeff P = 0
        rw [hMP', hCM P hMP', add_zero]
      · have := (Finset.mem_filter.mp (hsub hP₀S)).2
        change B.coeff P₀ + C.coeff P₀ < 1 at this
        rw [hCc, if_pos (hBlt P₀ hP₀S), hαP₀] at this
        linarith
    · refine hsnc.of_support_subset fun P hP => ?_
      rw [Finsupp.mem_support_iff] at hP ⊢
      change B.coeff P + M.coeff P ≠ 0
      change B.coeff P + C.coeff P + (M.coeff P + C.coeff P) ≠ 0 at hP
      intro h0
      have hB0 : B.coeff P = 0 := by linarith [hB P, hM P]
      have hM0 : M.coeff P = 0 := by linarith [hB P, hM P]
      exact hP (by rw [hB0, hCM P hM0, hM0]; ring)
    · have h := numEq_add_right hKBM (isCartierCombination_of_isSmoothScheme hXsm C)
      simpa only [logCanonicalDivisor, add_assoc] using h
    · change B.coeff P ≤ B.coeff P + C.coeff P
      linarith [hC P]
    · intro P hP
      change M.coeff P + C.coeff P = 0
      rw [hAM P hP, hCM P (hAM P hP), add_zero]
  -- the descent along the segment
  refine hasModel_of_hasModel_add hX hXsm hdim hZ hπ hKX hB hC hBC1
    (isRealLcPair_of_isSNC hX hXsm hdim hKX (fun P => add_nonneg (hB P) (hC P)) hBC1 hsncBC)
    hsncBC (fun P hP => ?_) hA hA0 hAB hAfl' hα hN (fun P hP => ?_) ?_ hmodel
  · rw [hCc, if_neg (not_lt.mpr hP)]
  · rw [hNc] at hP
    split_ifs at hP with h
    · exact absurd rfl hP
    · exact not_lt.mp h
  · rw [hCN]
    exact numEq_smul hKBM α

private theorem hasModel {B M : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M))
    (hKBM : IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B) M)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hAM : ∀ P, A.coeff P ≠ 0 → M.coeff P = 0) :
    HasModel sX sZ π KX B := by
  induction h : theta B M using Nat.strong_induction_on generalizing B M with
  | _ n ih =>
    subst h
    rcases Nat.eq_zero_or_pos (theta B M) with h0 | hpos
    · refine hasModel_of_theta_eq_zero hX hXsm hdim hZ hπ hKX hB hB1 hM hsnc hKBM hA hA0 hAB
        hAfl hAM fun P hP => ?_
      have hP' : P ∉ M.support.filter fun P => B.coeff P < 1 := by
        rw [theta, Finset.card_eq_zero] at h0; rw [h0]; exact Finset.notMem_empty P
      rw [Finset.mem_filter, not_and, not_lt] at hP'
      exact le_antisymm (hB1 P) (hP' (Finsupp.mem_support_iff.mpr hP))
    · exact hasModel_of_theta_pos hX hXsm hdim hZ hπ hKX hB hB1 hM hsnc hKBM hA hA0 hAB hAfl
        hAM hpos fun B' M' hlt hB' hB1' hM' hsnc' hKBM' hAB' hAfl' hAM' =>
          ih _ hlt hB' hB1' hM' hsnc' hKBM' hAB' hAfl' hAM' rfl

end Skeleton

private theorem solution :
    ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} {B M : RDivisor X} {A : QDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M))
    (hKBM : IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B) M)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hAM : ∀ P, A.coeff P ≠ 0 → M.coeff P = 0),
    ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : CompactSpace Y) (_ : IsLocallyNoetherian Y)
      (_ : IsNormal Y) (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY : RDivisor Y)
      (φ : X.RationalMap Y),
      IsRealLogMinimalModel sX sY sZ π πY KX B KY BY φ := by
  intro X Z _ _ _ _ sX _ sZ π KX B M A hX hXsm hdim hZ hπ hKX hB hB1 hM hsnc hKBM hA hA0 hAB hAfl hAM
  exact hasModel hX hXsm hdim hZ hπ hKX hB hB1 hM hsnc hKBM hA hA0 hAB hAfl hAM

end Proof_thm_fourfold_real_effective_snc_log_minimal_model

end

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **Effective real snc fourfold adjoints have log minimal models.** Let `π : X ⟶ Z` be a
morphism of projective complex varieties with `X` smooth of dimension four and `K_X` a canonical
divisor. Let `B` be a real boundary and `M ≥ 0` real, with `B + M` snc and `K_X + B ≡_Z M`, and
let `A ≤ B` be an effective ample `ℚ`-divisor with no component in `⌊B⌋` or `Supp M`. Then
`(X/Z, B)` has a log minimal model `(Y/Z, B_Y)` with a birational map `φ : X ⤏ Y` over `Z`. -/
@[mmp "thm_fourfold_real_effective_snc_log_minimal_model"]
public theorem exists_isRealLogMinimalModel_of_isSNC
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} {B M : RDivisor X} {A : QDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M))
    (hKBM : IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B) M)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hAM : ∀ P, A.coeff P ≠ 0 → M.coeff P = 0) :
    ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : CompactSpace Y) (_ : IsLocallyNoetherian Y)
      (_ : IsNormal Y) (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY : RDivisor Y)
      (φ : X.RationalMap Y),
      IsRealLogMinimalModel sX sY sZ π πY KX B KY BY φ :=
        by revert X Z sX sZ π KX B M A hX hXsm hdim hZ hπ hKX hB hB1 hM hsnc hKBM hA hA0 hAB hAfl hAM; first | exact Proof_thm_fourfold_real_effective_snc_log_minimal_model.solution | exact Proof_thm_fourfold_real_effective_snc_log_minimal_model.solution _ | exact Proof_thm_fourfold_real_effective_snc_log_minimal_model.solution _ _ | exact Proof_thm_fourfold_real_effective_snc_log_minimal_model.solution _ _ _ | exact Proof_thm_fourfold_real_effective_snc_log_minimal_model.solution _ _ _ _

end MMP.Fourfold

