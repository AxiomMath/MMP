section CartierCombination

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]

private theorem isCartierCombination_add {D E : RDivisor X} (hD : IsCartierCombination D)
    (hE : IsCartierCombination E) : IsCartierCombination (D + E) := by
  obtain ⟨m, r, L, hL, rfl⟩ := hD
  obtain ⟨m', r', L', hL', rfl⟩ := hE
  refine ⟨m + m', Fin.append r r', Fin.append L L', fun j => ?_, ?_⟩
  · refine Fin.addCases (motive := fun j => (Fin.append L L' j).IsCartier)
      (fun i => ?_) (fun i => ?_) j
    · simpa using hL i
    · simpa using hL' i
  · simp [Fin.sum_univ_add]

private theorem isCartierCombination_smul {D : RDivisor X} (hD : IsCartierCombination D)
    (c : ℝ) : IsCartierCombination (c • D) := by
  obtain ⟨m, r, L, hL, rfl⟩ := hD
  exact ⟨m, c • r, L, hL, by simp [Finset.smul_sum, smul_smul]⟩

private theorem isCartierCombination_zero' : IsCartierCombination (0 : RDivisor X) :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => Fin.elim0 j, by simp⟩

/-- On a scheme all of whose prime divisors are Cartier, every `ℝ`-divisor is a real
combination of Cartier divisors. -/
private theorem isCartierCombination_of_forall_isCartier
    (h : ∀ P : MMP.Mori.PrimeDivisor X, Divisor.IsCartier (Finsupp.single P (1 : ℤ)))
    (D : RDivisor X) : IsCartierCombination D := by
  induction D using Finsupp.induction_linear with
  | zero => exact isCartierCombination_zero'
  | add D E hD hE => exact isCartierCombination_add hD hE
  | single P r =>
    refine ⟨1, ![r], ![Finsupp.single P 1], fun j => by fin_cases j; exact h P, ?_⟩
    ext Q
    simp [DivisorWithCoeffs.mapCoeffs]

private theorem isCartierCombination_of_isSmoothScheme {k : Type} [Field k] [IsIntegral X]
    {sX : X ⟶ Spec (.of k)} (hsm : IsSmoothScheme sX) (D : RDivisor X) :
    IsCartierCombination D :=
  isCartierCombination_of_forall_isCartier
    (fun _ => MMP.Fourfold.isCartier_of_isSmoothScheme hsm _) D

/-- Every `ℝ`-divisor on a `ℚ`-factorial variety is a real combination of Cartier divisors. -/
private theorem isCartierCombination_of_isQFactorial {k : Type} [Field k] [IsIntegral X]
    {sX : X ⟶ Spec (.of k)} (hQ : IsQFactorial sX) (D : RDivisor X) : IsCartierCombination D := by
  induction D using Finsupp.induction_linear with
  | zero => exact isCartierCombination_zero'
  | add D E hD hE => exact isCartierCombination_add hD hE
  | single P r =>
    obtain ⟨m, hm, hc⟩ := hQ.2 (Finsupp.single P 1)
    refine ⟨1, ![r / m], ![(m : ℤ) • Finsupp.single P 1], fun j => by fin_cases j; exact hc, ?_⟩
    have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
    ext Q
    by_cases hPQ : P = Q
    · subst hPQ
      simp [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.mapCoeffs]
      field_simp
    · simp [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.mapCoeffs,
        Finsupp.single_apply, hPQ]

end CartierCombination

section Numerical

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X]

private theorem exists_isRIntersectionNumber {D : RDivisor X} (hD : IsCartierCombination D)
    (C : ProperCurve sX) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber k sX D r L C x := by
  obtain ⟨m, r, L, hL, rfl⟩ := hD
  exact ⟨m, r, L, _, MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C r L hL⟩

/-- Numerical equivalence over a base is compatible with real linear combinations. -/
private theorem numEq_add_smul {f : X ⟶ Y} {D₁ D₂ E₁ E₂ : RDivisor X}
    (hD : IsNumericallyEquivalentOver k sX f D₁ D₂) (hE : IsNumericallyEquivalentOver k sX f E₁ E₂)
    (a b : ℝ) :
    IsNumericallyEquivalentOver k sX f (a • D₁ + b • E₁) (a • D₂ + b • E₂) := by
  refine ⟨isCartierCombination_add (isCartierCombination_smul hD.1 a)
      (isCartierCombination_smul hE.1 b),
    isCartierCombination_add (isCartierCombination_smul hD.2.1 a)
      (isCartierCombination_smul hE.2.1 b), ?_⟩
  intro C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h₁ h₂
  obtain ⟨_, rD₁, LD₁, y₁, hy₁⟩ := exists_isRIntersectionNumber (k := k) hD.1 C
  obtain ⟨_, rD₂, LD₂, y₂, hy₂⟩ := exists_isRIntersectionNumber (k := k) hD.2.1 C
  obtain ⟨_, rE₁, LE₁, z₁, hz₁⟩ := exists_isRIntersectionNumber (k := k) hE.1 C
  obtain ⟨_, rE₂, LE₂, z₂, hz₂⟩ := exists_isRIntersectionNumber (k := k) hE.2.1 C
  have hl := (IsRIntersectionNumber.eq_and_linear k sX C)
  have e₁ := hl.1 _ _ _ _ _ _ _ h₁ (hl.2 _ _ _ _ _ _ _ _ a b hy₁ hz₁)
  have e₂ := hl.1 _ _ _ _ _ _ _ h₂ (hl.2 _ _ _ _ _ _ _ _ a b hy₂ hz₂)
  rw [e₁, e₂, hD.2.2 C hC _ _ _ _ _ _ _ _ hy₁ hy₂, hE.2.2 C hC _ _ _ _ _ _ _ _ hz₁ hz₂]

private theorem numEq_refl {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsCartierCombination D) : IsNumericallyEquivalentOver k sX f D D :=
  ⟨hD, hD, fun C _ _ _ _ _ _ _ _ _ h₁ h₂ =>
    (IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ h₁ h₂⟩

private theorem numEq_smul {f : X ⟶ Y} {D₁ D₂ : RDivisor X}
    (hD : IsNumericallyEquivalentOver k sX f D₁ D₂) (a : ℝ) :
    IsNumericallyEquivalentOver k sX f (a • D₁) (a • D₂) := by
  simpa using numEq_add_smul hD hD a 0

private theorem numEq_add_right {f : X ⟶ Y} {D₁ D₂ E : RDivisor X}
    (hD : IsNumericallyEquivalentOver k sX f D₁ D₂) (hE : IsCartierCombination E) :
    IsNumericallyEquivalentOver k sX f (D₁ + E) (D₂ + E) := by
  simpa using numEq_add_smul hD (numEq_refl (k := k) (f := f) hE) 1 1

/-- Numerically equivalent divisors differ by a numerically trivial one. -/
private theorem isNumericallyTrivialOver_sub_of_numEq {f : X ⟶ Y} {D E : RDivisor X}
    (h : IsNumericallyEquivalentOver k sX f D E) :
    IsNumericallyTrivialOver k sX f (D - E) := by
  have := numEq_add_smul h (numEq_refl (k := k) (f := f) h.2.1) 1 (-1)
  show IsNumericallyEquivalentOver k sX f (D - E) 0
  simpa [sub_eq_add_neg] using this

/-- A divisor differing from `E` by a numerically trivial one is numerically equivalent to `E`. -/
private theorem numEq_of_isNumericallyTrivialOver_sub {f : X ⟶ Y} {D E : RDivisor X}
    (h : IsNumericallyTrivialOver k sX f (D - E)) (hE : IsCartierCombination E) :
    IsNumericallyEquivalentOver k sX f D E := by
  have h' : IsNumericallyEquivalentOver k sX f (D - E) 0 := h
  simpa using numEq_add_right h' hE

/-- A relatively ample `ℝ`-divisor has positive intersection with every curve contracted by the
morphism. -/
private theorem pos_of_isRelativelyAmple {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {f : X ⟶ Y} {A : RDivisor X} (hA : IsRelativelyAmple f A)
    (C : ProperCurve sX) (hC : C.IsContractedBy f) {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {x : ℝ} (hx : IsRIntersectionNumber k sX A r L C x) : 0 < x := by
  obtain ⟨m', r', L', hm', hr', hL', rfl⟩ := hA
  have hLc : ∀ j, (L' j).IsCartier := fun j => (hL' j).1
  have h0 := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C r' L' hLc
  rw [(IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h0]
  have hpos : ∀ j, 0 < ((L' j).degreeOn k sX C.ι C.dim_le (hLc j) : ℝ) := fun j => by
    have := (hLc j).isInvertibleModule_divisorialSheaf
    have h := MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _
      ((MMP.Flips.IsRelativelyAmpleCartier.isRelativelyAmple (hL' j))) C hC
    exact_mod_cast h
  exact Finset.sum_pos (fun j _ => mul_pos (hr' j) (hpos j)) ⟨⟨0, hm'⟩, Finset.mem_univ _⟩

/-- A relatively ample `ℝ`-divisor is relatively nef. -/
private theorem isRelativelyNef_of_isRelativelyAmple' {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {f : X ⟶ Y} {A : RDivisor X} (hA : IsRelativelyAmple f A) :
    IsRelativelyNef k sX f A := by
  obtain ⟨m, r, L, hm, hr, hL, hAeq⟩ := id hA
  exact ⟨m, r, L, fun j => (hL j).1, hAeq, fun C hC x hx => (pos_of_isRelativelyAmple hA C hC hx).le⟩

end Numerical

section NefCombination

/-! ### Relative nefness of combinations -/

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X]

private theorem isCartierCombination_of_isRelativelyNef' {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsRelativelyNef k sX f D) : IsCartierCombination D := by
  obtain ⟨m, r, L, hL, h, -⟩ := hD
  exact ⟨m, r, L, hL, h⟩

/-- A relatively nef divisor has nonnegative degree on every contracted curve, whatever the
presentation used to compute it. -/
private theorem nonneg_of_isRelativelyNef' {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsRelativelyNef k sX f D) (C : ProperCurve sX) (hC : C.IsContractedBy f) {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber k sX D r L C x) : 0 ≤ x := by
  obtain ⟨m', r', L', hL', hD', hnn⟩ := hD
  have h0 := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C r' L' hL'
  rw [← hD'] at h0
  rw [(IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h0]
  exact hnn C hC _ h0

private theorem isRelativelyNef_of_nonneg {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsCartierCombination D)
    (h : ∀ C : ProperCurve sX, C.IsContractedBy f → ∀ (m : ℕ) (r : Fin m → ℝ)
      (L : Fin m → Divisor X) (x : ℝ), IsRIntersectionNumber k sX D r L C x → 0 ≤ x) :
    IsRelativelyNef k sX f D := by
  obtain ⟨m, r, L, hL, hDe⟩ := hD
  exact ⟨m, r, L, hL, hDe, fun C hC x hx => h C hC m r L x hx⟩

/-- Nonnegative combinations of relatively nef divisors are relatively nef. -/
private theorem isRelativelyNef_add_smul' {f : X ⟶ Y} {D E : RDivisor X}
    (hD : IsRelativelyNef k sX f D) (hE : IsRelativelyNef k sX f E) {a b : ℝ} (ha : 0 ≤ a)
    (hb : 0 ≤ b) : IsRelativelyNef k sX f (a • D + b • E) := by
  have hDc := isCartierCombination_of_isRelativelyNef' hD
  have hEc := isCartierCombination_of_isRelativelyNef' hE
  refine isRelativelyNef_of_nonneg (isCartierCombination_add (isCartierCombination_smul hDc a)
    (isCartierCombination_smul hEc b)) fun C hC m r L x hx => ?_
  obtain ⟨_, rD, LD, y, hy⟩ := exists_isRIntersectionNumber (k := k) hDc C
  obtain ⟨_, rE, LE, z, hz⟩ := exists_isRIntersectionNumber (k := k) hEc C
  have hl := IsRIntersectionNumber.eq_and_linear k sX C
  rw [hl.1 _ _ _ _ _ _ _ hx (hl.2 _ _ _ _ _ _ _ _ a b hy hz)]
  exact add_nonneg (mul_nonneg ha (nonneg_of_isRelativelyNef' hD C hC hy))
    (mul_nonneg hb (nonneg_of_isRelativelyNef' hE C hC hz))

/-- Relative nefness over a base passes to relative nefness over a factorization of the
structure morphism. -/
private theorem isRelativelyNef_of_comp' {Y' : Scheme.{0}} {f : X ⟶ Y} {g : Y ⟶ Y'}
    {D : RDivisor X} (hD : IsRelativelyNef k sX (f ≫ g) D) : IsRelativelyNef k sX f D := by
  obtain ⟨m, r, L, hL, h, hnn⟩ := hD
  refine ⟨m, r, L, hL, h, fun C hC x hx => hnn C (fun y hy => ?_) x hx⟩
  change g (f y) = g (f C.point)
  rw [hC y hy]

/-- Numerical triviality over a base passes to numerical triviality over a factorization of the
structure morphism. -/
private theorem isNumericallyTrivialOver_of_comp' {Y' : Scheme.{0}} {f : X ⟶ Y} {g : Y ⟶ Y'}
    {D : RDivisor X} (hD : IsNumericallyTrivialOver k sX (f ≫ g) D) :
    IsNumericallyTrivialOver k sX f D :=
  ⟨hD.1, hD.2.1, fun C hC => hD.2.2 C fun y hy => by
    change g (f y) = g (f C.point)
    rw [hC y hy]⟩

/-- A numerically trivial divisor is relatively nef. -/
private theorem isRelativelyNef_of_isNumericallyTrivialOver {f : X ⟶ Y} {D : RDivisor X}
    (h : IsNumericallyTrivialOver k sX f D) : IsRelativelyNef k sX f D := by
  refine isRelativelyNef_of_nonneg h.1 fun C hC m r L x hx => ?_
  obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := k) h.2.1 C
  have hxy := h.2.2 C hC _ _ _ _ _ _ _ _ hx hy
  have hl := IsRIntersectionNumber.eq_and_linear k sX C
  have h00 := hl.2 _ _ _ _ _ _ _ _ 0 0 hy hy
  simp only [zero_smul, add_zero] at h00
  have := hl.1 _ _ _ _ _ _ _ hy h00
  rw [hxy, this]
  simp

end NefCombination

section ChangeOfBase

/-! ### Changing the base of a relative notion by an isomorphism -/

variable {k : Type} [Field k] {X Y Y' : Scheme.{0}} {sX : X ⟶ Spec (.of k)}

/-- A morphism injective on points contracts no proper curve. -/
private theorem not_isContractedBy_of_injective (C : ProperCurve sX) {g : X ⟶ Y}
    (hg : Function.Injective g.base) : ¬ C.IsContractedBy g := fun hC => by
  have hsub : Subsingleton C.scheme := ⟨fun a b => (curveSubschemeAtι C.point).isEmbedding.injective
    (by
      have h : ∀ c, (curveSubschemeAtι C.point) c = C.point := fun c =>
        hg (hC _ (MMP.Mori.range_curveSubschemeAtι C.point ▸ ⟨c, rfl⟩))
      exact (h a).trans (h b).symm)⟩
  have h0 := topologicalKrullDim_zero_of_discreteTopology C.scheme
  rw [C.isProperCurve.dim_eq] at h0
  exact absurd h0 (by decide)

/-- Every `ℝ`-Cartier divisor is nef relative to a morphism injective on points. -/
private theorem isRelativelyNef_of_injective [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {g : X ⟶ Y} (hg : Function.Injective g.base) {D : RDivisor X}
    (hD : IsCartierCombination D) : IsRelativelyNef k sX g D := by
  obtain ⟨m, r, L, hL, hDL⟩ := hD
  exact ⟨m, r, L, hL, hDL, fun C hC => (not_isContractedBy_of_injective C hg hC).elim⟩

/-- Relative nefness is unchanged by composing with a morphism injective on points. -/
private theorem isRelativelyNef_comp_of_injective [QuasiCompact sX] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {f : X ⟶ Y} {e : Y ⟶ Y'} (he : Function.Injective e.base) {D : RDivisor X}
    (hD : IsRelativelyNef k sX f D) : IsRelativelyNef k sX (f ≫ e) D := by
  obtain ⟨m, r, L, hL, h, hnn⟩ := hD
  refine ⟨m, r, L, hL, h, fun C hC x hx => hnn C (fun y hy => he ?_) x hx⟩
  exact hC y hy

/-- Relative ampleness of a Cartier divisor is preserved by composing with an affine morphism. -/
private theorem isRelativelyAmpleCartier_comp [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {f : X ⟶ Y}
    {e : Y ⟶ Y'} [IsAffineHom e] {L : Divisor X} (hL : MMP.Flips.IsRelativelyAmpleCartier f L) :
    MMP.Flips.IsRelativelyAmpleCartier (f ≫ e) L := by
  obtain ⟨hLc, h⟩ := hL
  exact ⟨hLc, fun U hU => h (e ⁻¹ᵁ U) (hU.preimage e)⟩

/-- Relative ampleness is preserved by composing with an affine morphism. -/
private theorem isRelativelyAmple_comp [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {f : X ⟶ Y}
    {e : Y ⟶ Y'} [IsAffineHom e] {A : RDivisor X} (hA : MMP.Flips.IsRelativelyAmple f A) :
    MMP.Flips.IsRelativelyAmple (f ≫ e) A := by
  obtain ⟨m, r, L, hm, hr, hL, hA⟩ := hA
  exact ⟨m, r, L, hm, hr, fun j => isRelativelyAmpleCartier_comp (hL j), hA⟩

/-- The exceptional set (where the morphism is not locally an open immersion) is unchanged by
composing with an isomorphism. -/
private theorem exceptionalSet_comp_iso {f : X ⟶ Y} (e : Y ⟶ Y') [IsIso e] :
    MMP.Flips.exceptionalSet (f ≫ e) = MMP.Flips.exceptionalSet f := by
  ext x
  simp only [MMP.Flips.exceptionalSet, Set.mem_setOf_eq]
  refine not_congr ⟨fun ⟨V, hx, hV⟩ => ⟨V, hx, ?_⟩, fun ⟨V, hx, hV⟩ => ⟨V, hx, ?_⟩⟩
  · have : IsOpenImmersion ((V.ι ≫ f ≫ e) ≫ inv e) := inferInstance
    simpa using this
  · rw [← Category.assoc]; infer_instance

end ChangeOfBase

section ExceptionalSet

/-- For a proper birational morphism onto a normal scheme whose exceptional locus (the complement
of the preimage of the biregular locus) is a prime divisor `E`, the set of points near which the
morphism is not an open immersion is also `E`. -/
private theorem exceptionalSet_eq_of_mori_exceptionalSet_eq {Y T : Scheme.{0}} [IsIntegral Y]
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] {f : Y ⟶ T} [IsProper f]
    (hf : IsBirationalMorphism f) {E : MMP.Mori.PrimeDivisor Y}
    (hE : (MMP.Mori.exceptionalSet f : Set Y) = E.support) :
    MMP.Flips.exceptionalSet f = E.support := by
  apply Set.Subset.antisymm
  · intro y hy
    rw [← hE]
    by_contra hyM
    apply hy
    have : IsIso (f ∣_ MMP.Mori.biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
    refine ⟨f ⁻¹ᵁ MMP.Mori.biregularLocus f, ?_, ?_⟩
    · by_contra h
      exact hyM (MMP.Mori.mem_exceptionalSet.mpr h)
    · rw [← morphismRestrict_ι]
      infer_instance
  · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    refine closure_minimal ?_ (MMP.Flips.isClosed_exceptionalSet f)
    rintro _ rfl
    by_contra hη
    have hc := MMP.Flips.coheight_map_of_notMem_exceptionalSet hη
    have hmem := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hf
      (y := f E.genericPoint) (by rw [hc, E.coheight_genericPoint])
    have hηE : E.genericPoint ∈ (MMP.Mori.exceptionalSet f : Set Y) := by
      rw [hE, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
      exact subset_closure rfl
    exact (MMP.Mori.mem_exceptionalSet.mp hηE) hmem

end ExceptionalSet

section Tracking

/-! ### Prime divisors across a step -/

open MMP.Mori

/-- A morphism is injective over its biregular locus. -/
private theorem eq_of_map_eq_of_mem_biregularLocus {A T : Scheme.{0}} (g : A ⟶ T) {a a' : A}
    (h : g a = g a') (ha : g a ∈ biregularLocus g) : a = a' := by
  set V := biregularLocus g
  haveI : IsIso (g ∣_ V) := isBiregular_biregularLocus g
  have ha' : g a' ∈ V := h ▸ ha
  let x : (g ⁻¹ᵁ V).toScheme := ⟨a, ha⟩
  let x' : (g ⁻¹ᵁ V).toScheme := ⟨a', ha'⟩
  have h1 : (g ∣_ V) x = (g ∣_ V) x' := by
    apply Subtype.ext
    rw [morphismRestrict_base_coe, morphismRestrict_base_coe]
    exact h
  have h2 : x = x' := (g ∣_ V).isOpenEmbedding.injective h1
  exact congrArg Subtype.val h2

/-- Over a point of coheight one of the biregular locus lies exactly one point, the generic point
of a prime divisor. -/
private theorem exists_primeDivisor_map_eq_of_mem_biregularLocus {A T : Scheme.{0}} (g : A ⟶ T)
    {w : T} (hw : w ∈ biregularLocus g) (hw1 : Order.coheight w = 1) :
    ∃ F : MMP.Mori.PrimeDivisor A, g F.genericPoint = w ∧ ∀ a, g a = w → a = F.genericPoint := by
  set V := biregularLocus g
  haveI : IsIso (g ∣_ V) := isBiregular_biregularLocus g
  let w' : V.toScheme := ⟨w, hw⟩
  obtain ⟨x, hx⟩ := (g ∣_ V).surjective w'
  have hgx : g x.1 = w := by
    have := congrArg Subtype.val hx
    rwa [morphismRestrict_base_coe] at this
  set y : A := x.1 with hydef
  have hc : Order.coheight y = 1 := by
    rw [← MMP.Positivity.coheight_map_of_mem_biregularLocus g (hgx ▸ hw), hgx, hw1]
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne y hc, ?_, fun a ha => ?_⟩
  · have e := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne y hc
    change g (AlgebraicGeometry.PrimeDivisor.ofCoheightOne y hc).genericPoint = w
    rw [e]; exact hgx
  · have e := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne y hc
    change a = (AlgebraicGeometry.PrimeDivisor.ofCoheightOne y hc).genericPoint
    rw [e]
    exact eq_of_map_eq_of_mem_biregularLocus g (ha.trans hgx.symm) (ha ▸ hw)

/-- A rational map which is a morphism in codimension one is defined at the generic point of
every prime divisor. -/
private theorem definedAt_genericPoint_of_isMorphismInCodimOne {Y Y' : Scheme.{0}}
    {ψ : Y.RationalMap Y'} (hψ : MMP.Flips.RationalMap.IsMorphismInCodimOne ψ)
    (F : MMP.Mori.PrimeDivisor Y) : RationalMap.DefinedAt ψ F.genericPoint := by
  by_contra h
  have := (MMP.Flips.le_closedsCodimension_iff_le_coheight.mp hψ) F.genericPoint h
  rw [F.coheight_genericPoint] at this
  exact absurd this (by decide)

/-- **A birational map over `T` sends a prime divisor to the prime divisor over the same point.**
If `ψ : Y ⤏ Y'` lies over `T` (for `f : Y ⟶ T`, `f⁺ : Y' ⟶ T`), is defined at `η_F`, and
`f(η_F) = f⁺(η_{F'})` lies in the biregular locus of `f⁺`, then `ψ_* F = F'`. -/
private theorem transformPrimeDivisor_eq_some_of_isOver {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [IsSeparated (Y' ↘ ⊤_ Scheme)] [IsSeparated (T ↘ ⊤_ Scheme)] {f : Y ⟶ T} {fp : Y' ⟶ T} {ψ : Y.RationalMap Y'}
    (hψ : MMP.Flips.RationalMap.IsOver f fp ψ) {F : MMP.Mori.PrimeDivisor Y} {F' : MMP.Mori.PrimeDivisor Y'}
    (hdef : RationalMap.DefinedAt ψ F.genericPoint)
    (hFF : f F.genericPoint = fp F'.genericPoint)
    (hbir : fp F'.genericPoint ∈ biregularLocus fp) :
    RationalMap.transformPrimeDivisor ψ F = some F' := by
  obtain ⟨g, hgF, hg⟩ := RationalMap.definedAt_iff.mp hdef
  letI : Y.Over T := ⟨f⟩
  letI : Y'.Over T := ⟨fp⟩
  haveI : T.IsSeparated := ⟨by
    rw [show Limits.terminal.from T = (T ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  have h2 : g.toRationalMap.IsOver T := by
    rw [Scheme.RationalMap.isOver_iff]
    change g.toRationalMap.compHom fp = f.toRationalMap
    rw [hg]; exact hψ
  have h3 : g.hom ≫ fp = g.domain.ι ≫ f :=
    (Scheme.PartialMap.isOver_toRationalMap_iff_of_isSeparated.mp h2).1
  refine MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq g hg hgF ?_
  let w : (g.domain : Scheme) := ⟨F.genericPoint, hgF⟩
  have hc : fp (g.hom w) = f F.genericPoint := by
    rw [← Scheme.Hom.comp_apply, h3, Scheme.Hom.comp_apply]; rfl
  change F'.genericPoint = g.hom w
  exact eq_of_map_eq_of_mem_biregularLocus fp (hFF.symm.trans hc.symm) hbir

/-- **Prime divisors across a modification over `T`.** Let `ψ : Y ⤏ Y'` lie over `T`, and let
`F` be a prime divisor of `Y` at whose generic point `ψ` is defined, with `w = f(η_F)` in the
biregular loci of both `f` and `f⁺`. Then `ψ_* F` is the unique prime divisor `F'` of `Y'` over
`w`, `F` is the only prime divisor sent to `F'`, and `(ψ_* Γ)_{F'} = Γ_F`. -/
private theorem exists_transformPrimeDivisor_eq_of_isOver {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [IsSeparated (Y' ↘ ⊤_ Scheme)] [IsSeparated (T ↘ ⊤_ Scheme)] {f : Y ⟶ T} {fp : Y' ⟶ T} {ψ : Y.RationalMap Y'}
    (hψ : MMP.Flips.RationalMap.IsOver f fp ψ) (hdef : ∀ G : MMP.Mori.PrimeDivisor Y,
      RationalMap.DefinedAt ψ G.genericPoint) (F : MMP.Mori.PrimeDivisor Y)
    (hf : f F.genericPoint ∈ biregularLocus f) (hfp : f F.genericPoint ∈ biregularLocus fp) :
    ∃ F' : MMP.Mori.PrimeDivisor Y', fp F'.genericPoint = f F.genericPoint ∧
      (∀ y, fp y = f F.genericPoint → y = F'.genericPoint) ∧
      RationalMap.transformPrimeDivisor ψ F = some F' ∧
      (∀ G, RationalMap.transformPrimeDivisor ψ G = some F' → G = F) ∧
      ∀ {R : Type} [AddCommMonoid R] (Γ : DivisorWithCoeffs R Y),
        (RationalMap.transformDivisor ψ Γ).coeff F' = Γ.coeff F := by
  classical
  have hc : Order.coheight (f F.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hf, F.coheight_genericPoint]
  obtain ⟨F', hF', huniq⟩ := exists_primeDivisor_map_eq_of_mem_biregularLocus fp hfp hc
  have htr : RationalMap.transformPrimeDivisor ψ F = some F' :=
    transformPrimeDivisor_eq_some_of_isOver hψ (hdef F) hF'.symm (hF' ▸ hfp)
  have hinj : ∀ G, RationalMap.transformPrimeDivisor ψ G = some F' → G = F := by
    intro G hG
    obtain ⟨g, hgG, hg⟩ := RationalMap.definedAt_iff.mp (hdef G)
    have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hG g hg hgG
    letI : Y.Over T := ⟨f⟩
    letI : Y'.Over T := ⟨fp⟩
    haveI : T.IsSeparated := ⟨by
      rw [show Limits.terminal.from T = (T ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
      infer_instance⟩
    have h2 : g.toRationalMap.IsOver T := by
      rw [Scheme.RationalMap.isOver_iff]
      change g.toRationalMap.compHom fp = f.toRationalMap
      rw [hg]; exact hψ
    have h3 : g.hom ≫ fp = g.domain.ι ≫ f :=
      (Scheme.PartialMap.isOver_toRationalMap_iff_of_isSeparated.mp h2).1
    let w : (g.domain : Scheme) := ⟨G.genericPoint, hgG⟩
    have hη' : F'.genericPoint = g.hom w := hη
    have hc' : f G.genericPoint = fp F'.genericPoint := by
      rw [hη', ← Scheme.Hom.comp_apply, h3, Scheme.Hom.comp_apply]; rfl
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (eq_of_map_eq_of_mem_biregularLocus f (hc'.trans hF') (hc'.trans hF' ▸ hf))
  exact ⟨F', hF', huniq, htr, hinj, fun Γ =>
    MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq htr hinj Γ⟩

/-- The birational transform commutes with regarding a divisor as an `ℝ`-divisor. -/
private theorem transformDivisor_toRDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (K : Divisor X) :
    RationalMap.transformDivisor φ (Divisor.toRDivisor K) =
      Divisor.toRDivisor (RationalMap.transformDivisor φ K) := by
  have hs : ∀ {Z : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor Z) (m : ℤ),
      Divisor.toRDivisor (Finsupp.single Q m) = Finsupp.single Q (m : ℝ) := fun Q m => by
    simp [Divisor.toRDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom,
      DivisorWithCoeffs.mapCoeffs]
  induction K using Finsupp.induction_linear with
  | zero => simp
  | add D E hD hE => simp only [map_add, hD, hE]
  | single P n =>
    rw [hs P n]
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (Finsupp.single P (n : ℝ)) =
      Divisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (Finsupp.single P n))
    rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single,
      MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single]
    cases RationalMap.transformPrimeDivisor φ P with
    | none => simp
    | some Q => exact (hs Q n).symm

/-- A prime divisor whose support contains the generic point of a prime divisor `F` is `F`. -/
private theorem eq_of_genericPoint_mem_support {Y : Scheme.{0}} {F P : MMP.Mori.PrimeDivisor Y}
    (h : F.genericPoint ∈ P.support) : P = F := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
  have hs : P.genericPoint ⤳ F.genericPoint := specializes_iff_mem_closure.mpr h
  by_contra hne
  have hne' : F.genericPoint ≠ P.genericPoint := fun e =>
    hne (AlgebraicGeometry.PrimeDivisor.genericPoint_injective e.symm)
  have hlt : F.genericPoint < P.genericPoint :=
    lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hs) fun h' =>
      hne' (hs.antisymm (Scheme.le_iff_specializes.mp h')).eq.symm
  have h2 := Order.coheight_add_one_le hlt
  rw [F.coheight_genericPoint, P.coheight_genericPoint] at h2
  norm_num at h2

end Tracking

section RealSNC

open MMP.Mori

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

open Classical in
/-- Sums over the prime divisors of a finite set, written through `Fin`. -/
private theorem sum_equivFin_mul_single (S : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (Γ : MMP.Mori.PrimeDivisor X) :
    ∑ i : Fin S.card, c (S.equivFin.symm i) *
        (((Finsupp.single (S.equivFin.symm i : MMP.Mori.PrimeDivisor X) (1 : ℤ)) Γ : ℤ) : ℝ) =
      if Γ ∈ S then c Γ else 0 := by
  rw [Equiv.sum_comp S.equivFin.symm (fun x : S => c x *
    (((Finsupp.single (x : MMP.Mori.PrimeDivisor X) (1 : ℤ)) Γ : ℤ) : ℝ))]
  rw [Finset.sum_coe_sort S (fun x => c x * (((Finsupp.single x (1 : ℤ)) Γ : ℤ) : ℝ))]
  simp only [Finsupp.single_apply]
  split_ifs with h
  · rw [Finset.sum_eq_single Γ]
    · simp
    · intro b _ hb; simp [hb]
    · intro h'; exact absurd h h'
  · refine Finset.sum_eq_zero fun b hb => ?_
    have : b ≠ Γ := fun h' => h (h' ▸ hb)
    simp [this]

/-- The minimum in the snc discrepancy formula is `≥ -1` when every coefficient is `≤ 1`. -/
private theorem neg_one_le_inf_snc_bound' {ι : Type*} (S : Finset ι) (c : ι → ℚ)
    (hc : ∀ i ∈ S, c i ≤ 1) (P Q : ι → ι → Prop) :
    (-1 : EReal) ≤ (⨅ (i ∈ S) (j ∈ S) (_ : P i j) (_ : Q i j),
        (((1 - c i - c j : ℚ) : ℝ) : EReal)) ⊓ (⨅ i ∈ S, (((1 - c i : ℚ) : ℝ) : EReal)) ⊓ 1 := by
  have hL : ∀ q : ℚ, -1 ≤ q → (-1 : EReal) ≤ ((q : ℝ) : EReal) := fun q hq => by
    simpa using EReal.coe_le_coe_iff.mpr (by exact_mod_cast hq : (-1 : ℝ) ≤ q)
  refine le_inf (le_inf ?_ ?_) ?_
  · refine le_iInf₂ fun i hi => le_iInf₂ fun j hj => le_iInf₂ fun _ _ => hL _ ?_
    linarith [hc i hi, hc j hj]
  · exact le_iInf₂ fun i hi => hL _ (by linarith [hc i hi])
  · simpa using hL 1 (by norm_num)

/-- A log discrepancy of the reduced snc boundary `∑_{E ∈ S} E` is nonnegative. -/
private theorem nonneg_of_isLogDiscrepancy_reduced (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : 2 ≤ n) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (S : Finset (MMP.Mori.PrimeDivisor X))
    (hsnc : DivisorWithCoeffs.IsSNC sX (∑ E ∈ S, Finsupp.single E (1 : ℤ))) {n' : ℕ}
    {D : DivisorOver k sX} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n'
      (QDivisor.toRDivisor (∑ E ∈ S, Finsupp.single E (1 : ℚ))) D a) : 0 ≤ a := by
  classical
  set Δ : QDivisor X := ∑ E ∈ S, Finsupp.single E (1 : ℚ) with hΔdef
  have hΔ : ∀ Γ, Δ.coeff Γ = if Γ ∈ S then 1 else 0 := fun Γ => by
    simp only [hΔdef, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply,
      Finsupp.single_apply]
    rw [Finset.sum_ite_eq']
  have hΔ1 : ∀ Γ, Δ.coeff Γ ≤ 1 := fun Γ => by rw [hΔ]; split_ifs <;> norm_num
  have hP : MMP.Mori.IsPair sX Δ :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain rfl : n' = n := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  by_cases hE : D.IsExceptional
  · obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
    rw [MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc ha]
    have hsupp : Δ.support ⊆ S := fun E hE => by
      by_contra h
      exact (Finsupp.mem_support_iff.mp hE) (by rw [← DivisorWithCoeffs.coeff_apply, hΔ, if_neg h])
    have hsncS : DivisorWithCoeffs.IsSNC sX (∑ E ∈ S, Finsupp.single E (1 : ℤ)) := hsnc
    have h := discrep_le hE hc
    rw [discrep_eq_of_isSNC sX hX hsm hn hK S hsupp hsncS (fun E _ => hΔ1 E)] at h
    have : ((-1 : ℝ) : EReal) ≤ ((c : ℝ) : EReal) := by
      simpa using (neg_one_le_inf_snc_bound' _ _ (fun E _ => hΔ1 E) _ _).trans h
    have h2 : (-1 : ℝ) ≤ c := by exact_mod_cast EReal.coe_le_coe_iff.mp this
    linarith
  · obtain ⟨P, hv⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX D hE
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
      (DivisorOver.ofPrimeDivisor k hX P)
    have hb := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 X) from inferInstance)
    rw [MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hb hv,
      IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc]
    have h1 : Δ.coeff P ≤ 1 := hΔ1 P
    have : (0 : ℚ) ≤ 1 + -Δ.coeff P := by linarith
    exact_mod_cast this

/-- **Real snc boundaries are lc.** On a smooth variety of dimension `n ≥ 2` over an
algebraically closed field of characteristic zero, an effective `ℝ`-divisor `Δ` whose support
lies in a finite set `S` of prime divisors with `∑_{E ∈ S} E` snc, and whose coefficients are at
most one, is an lc boundary: its log discrepancies dominate those of `∑_{E ∈ S} E`. -/
private theorem isRealLcPair_of_isSNC' (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {n : ℕ} (hn : 2 ≤ n) {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {Δ : RDivisor X}
    (S : Finset (MMP.Mori.PrimeDivisor X)) (hS : Δ.support ⊆ S)
    (hsnc : DivisorWithCoeffs.IsSNC sX (∑ E ∈ S, Finsupp.single E (1 : ℤ)))
    (h0 : ∀ P, 0 ≤ Δ.coeff P) (h1 : ∀ P, Δ.coeff P ≤ 1) : IsRealLcPair sX Δ := by
  classical
  have hΔS : ∀ Γ, Γ ∉ S → Δ.coeff Γ = 0 := fun Γ hΓ => by
    by_contra h
    exact hΓ (hS (Finsupp.mem_support_iff.mpr h))
  -- the presentation `K + ∑_{E ∈ S} c_E E` by Cartier divisors
  let e : Fin S.card → MMP.Mori.PrimeDivisor X := fun i => S.equivFin.symm i
  let C : Fin (S.card + 1) → Divisor X :=
    Fin.cons K (fun i => (Finsupp.single (e i) (1 : ℤ) : Divisor X))
  have hC : ∀ i, (C i).IsCartier := fun i => MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  let r : (MMP.Mori.PrimeDivisor X → ℝ) → Fin (S.card + 1) → ℝ :=
    fun c => Fin.cons 1 (fun i => c (e i))
  have hpres : ∀ (c : MMP.Mori.PrimeDivisor X → ℝ) (Γ : MMP.Mori.PrimeDivisor X),
      ∑ i, r c i * ((C i).coeff Γ : ℝ) = K.coeff Γ + if Γ ∈ S then c Γ else 0 := by
    intro c Γ
    rw [Fin.sum_univ_succ]
    simp only [r, C, Fin.cons_zero, Fin.cons_succ, one_mul, DivisorWithCoeffs.coeff_apply]
    rw [sum_equivFin_mul_single S c Γ]
  refine ⟨hX, h0, ⟨n, K, hK, S.card + 1, r Δ.coeff, C, hC, fun Γ => ?_⟩, ?_⟩
  · rw [hpres]
    change ((K.coeff Γ : ℤ) : ℝ) + Δ.coeff Γ = _
    split_ifs with h
    · rfl
    · rw [hΔS Γ h]
  intro n' D a ha
  obtain rfl : n' = n := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have : CompactSpace D.Y := by
    have := D.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (D.f ≫ sX)
  have hf : IsProper D.f := ha.2.1
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  choose C' hC' using fun i => MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f (hC i)
  -- the log discrepancy of a boundary supported in `S`, through this presentation
  have hb : ∀ B : RDivisor X, (∀ Γ, Γ ∉ S → B.coeff Γ = 0) →
      MMP.Intersection.IsLogDiscrepancy sX n' B D
        (1 + (D.ordPullback ω : ℝ) - ∑ i, r B.coeff i * ((C' i).coeff D.E : ℝ)) := by
    intro B hB
    refine ⟨hX, hf, ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, S.card + 1, r B.coeff, C, C', hC,
      fun Γ => ?_, fun i => ⟨_, hC' i⟩, rfl⟩
    rw [hpres, hω Γ]
    split_ifs with h
    · rfl
    · rw [hB Γ h]
  have haΔ := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha (hb Δ hΔS)
  -- the reduced boundary `∑_{E ∈ S} E`
  let Δq : QDivisor X := ∑ E ∈ S, Finsupp.single E (1 : ℚ)
  have hΔq : ∀ Γ, Δq.coeff Γ = if Γ ∈ S then (1 : ℚ) else 0 := fun Γ => by
    simp only [Δq, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.single_apply]
    rw [Finset.sum_ite_eq']
  have hΔqR : ∀ Γ, Γ ∉ S → (QDivisor.toRDivisor Δq).coeff Γ = 0 := fun Γ hΓ => by
    rw [QDivisor.coeff_toRDivisor, hΔq, if_neg hΓ, Rat.cast_zero]
  have hposq := nonneg_of_isLogDiscrepancy_reduced hX hsm hn hK S hsnc (hb _ hΔqR)
  -- comparison of the two log discrepancies
  rw [haΔ]
  refine le_trans hposq ?_
  rw [sub_le_sub_iff_left, Fin.sum_univ_succ, Fin.sum_univ_succ]
  simp only [r, Fin.cons_zero, Fin.cons_succ]
  refine add_le_add_right (Finset.sum_le_sum fun i _ => ?_) _
  have hc0 : (0 : ℝ) ≤ ((C' i.succ).coeff D.E : ℝ) := by
    have hnn := MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (hC i.succ)
      (V := ⊤) (fun P _ => ?_) (hC' i.succ) D.E ((D.E.genericPoint_mem_iff _).mp trivial)
    · exact_mod_cast hnn
    · simp only [C, Fin.cons_succ, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
      split_ifs <;> norm_num
  have hle : Δ.coeff (e i) ≤ ((QDivisor.toRDivisor Δq).coeff (e i)) := by
    rw [QDivisor.coeff_toRDivisor, hΔq, if_pos (S.equivFin.symm i).2]
    exact_mod_cast h1 _
  exact mul_le_mul_of_nonneg_right hle hc0

end RealSNC

section Identity

open MMP.Mori

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The transform of a prime divisor under the identity is itself. -/
private theorem transformPrimeDivisor_id [IsSeparated (X ↘ ⊤_ Scheme)]
    (P : MMP.Mori.PrimeDivisor X) :
    RationalMap.transformPrimeDivisor (X := X) (Scheme.Hom.toRationalMap (𝟙 X)) P = some P :=
  (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff (𝟙 X) P P).mpr rfl

/-- The transform of a divisor under the identity is itself. -/
private theorem transformDivisor_id [IsSeparated (X ↘ ⊤_ Scheme)] {R : Type*}
    [AddCommMonoid R] (D : DivisorWithCoeffs R X) :
    RationalMap.transformDivisor (X := X) (Scheme.Hom.toRationalMap (𝟙 X)) D = D := by
  induction D using Finsupp.induction_linear with
  | zero => exact map_zero _
  | add D E hD hE => rw [map_add, hD, hE]
  | single P r => exact RationalMap.transformDivisor_single_of_eq_some (transformPrimeDivisor_id P) r

/-- A prime divisor with a prime divisor as transform is not contracted. -/
private theorem not_isExceptional_of_transformPrimeDivisor_eq_some {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {φ : X.RationalMap Y}
    {P : MMP.Mori.PrimeDivisor X} {E : MMP.Mori.PrimeDivisor Y}
    (h : RationalMap.transformPrimeDivisor φ P = some E) :
    ¬ RationalMap.IsExceptional φ P := by
  intro hP
  have hdef := (RationalMap.transformPrimeDivisor_eq_some_iff.mp h).1
  have h2 := (RationalMap.isExceptional_iff.mp hP) hdef
  have hsupp := RationalMap.support_transformPrimeDivisor h
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h2
  have hmem : E.genericPoint ∈ (RationalMap.transform φ P.idealSheaf.support : Set Y) := by
    rw [← hsupp, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have := h2 _ hmem
  rw [E.coheight_genericPoint] at this
  exact absurd this (by decide)

/-- An snc divisor restricts to an snc divisor on an open subscheme. -/
private theorem isSNC_inverseTransformDivisor_ι {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] {R : Type*} [AddCommMonoid R] {D : DivisorWithCoeffs R X}
    (hD : DivisorWithCoeffs.IsSNC sX D) (U : X.Opens) :
    DivisorWithCoeffs.IsSNC (U.ι ≫ sX) (inverseTransformDivisor U.ι D) := by
  rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen]
  exact hD.restrictOpen U

/-- A log canonical pair with an snc boundary of coefficients at most one on a smooth variety
is dlt. -/
private theorem isRealDltPair_of_isSNC {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] {D : RDivisor X} (hlc : IsRealLcPair sX D)
    (hD1 : ∀ P, D.coeff P ≤ 1) (hXsm : IsSmoothScheme sX) (hsnc : DivisorWithCoeffs.IsSNC sX D) :
    IsRealDltPair sX D :=
  ⟨hlc, hD1, ⊥, MMP.Threefold.Resolution.isSmoothScheme_ι (k := k) hXsm _,
    isSNC_inverseTransformDivisor_ι hsnc _, fun _ E hE _ _ => by
      obtain ⟨x, hx⟩ := E.center.isIrreducible.nonempty
      exact absurd (hE hx) (by simp)⟩

end Identity

section Comparison

open MMP.Mori

variable {k : Type} [Field k] {X W : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
  [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]

/-- The pull-back of an `ℝ`-Cartier divisor has, along a prime divisor at whose generic point the
morphism is a local isomorphism onto the generic point of `P`, the coefficient of `P`. -/
private theorem coeff_eq_of_isRCartierPullback {p : W ⟶ X} {D : RDivisor X} {G : RDivisor W}
    (hG : IsRCartierPullback p D G) (E : MMP.Mori.PrimeDivisor W) (P : MMP.Mori.PrimeDivisor X)
    (heq : p E.genericPoint = P.genericPoint) [IsIso (p.stalkMap E.genericPoint)] :
    G.coeff E = D.coeff P := by
  obtain ⟨m, r, L, L', hL, rfl, hpb, rfl⟩ := hG
  rw [MMP.Flips.coeff_sum_smul_toRDivisor, MMP.Flips.coeff_sum_smul_toRDivisor]
  refine Finset.sum_congr rfl fun j _ => ?_
  obtain ⟨hB, hj⟩ := hpb j
  rw [MMP.Positivity.coeff_eq_of_isPullback E P heq (hL j) hj]

/-- **Log discrepancies on a model.** Let `p : W ⟶ X` be a proper birational morphism of normal
varieties, `ω` a nonzero rational top form, and `G = p^*(div ω + Δ)` an `ℝ`-Cartier pull-back.
Then the log discrepancy of a prime divisor `E` of `W` with respect to `(X, Δ)` is
`1 + ord_E(p^*ω) - mult_E G`. -/
private theorem isLogDiscrepancy_of_isRCartierPullback {p : W ⟶ X}
    (hX : IsNormalVariety k sX) (hW : IsNormalVariety k (p ≫ sX)) (hp : IsBirationalMorphism p)
    [IsProper p] {n : ℕ} {ω : RationalPluriForms sX n 1} (hω0 : ω ≠ 0)
    (hK : (divisorOfForm ω).IsCanonicalDivisor sX n) {Δ : RDivisor X} {G : RDivisor W}
    (hG : IsRCartierPullback p (logCanonicalDivisor (divisorOfForm ω) Δ) G)
    (E : MMP.Mori.PrimeDivisor W) :
    MMP.Intersection.IsLogDiscrepancy sX n Δ (⟨W, p, hW, hp, E⟩ : DivisorOver k sX)
      (1 + ((⟨W, p, hW, hp, E⟩ : DivisorOver k sX).ordPullback ω : ℝ) - G.coeff E) := by
  obtain ⟨m, r, L, L', hL, hD, hpb, rfl⟩ := hG
  refine ⟨hX, ‹IsProper p›, ω, hω0, ⟨divisorOfForm ω, hK, fun Γ => coeff_divisorOfForm ω Γ⟩, m, r,
    L, L', hL, fun Γ => ?_, hpb, ?_⟩
  · have := congrArg (fun D : RDivisor X => D.coeff Γ) hD
    simpa only [logCanonicalDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor,
      coeff_divisorOfForm, MMP.Flips.coeff_sum_smul_toRDivisor] using this
  · rw [MMP.Flips.coeff_sum_smul_toRDivisor]

end Comparison

section StrictTransforms

open MMP.Mori

variable {X W : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W]

/-- A dominant morphism inducing an isomorphism of function fields induces an isomorphism of
local rings at every point lying over the generic point of a prime divisor. -/
private theorem isIso_stalkMap_of_map_eq_genericPoint (p : W ⟶ X) [IsDominant p]
    (hp : Function.Bijective (functionFieldMap p)) {w : W} {P : MMP.Mori.PrimeDivisor X}
    (hw : p w = P.genericPoint) : IsIso (p.stalkMap w) := by
  haveI : ValuationRing (X.presheaf.stalk P.genericPoint) := by
    haveI := P.isDiscreteValuationRing_localRing
    exact inferInstanceAs (ValuationRing P.localRing)
  haveI : ValuationRing (X.presheaf.stalk (p w)) := by rw [hw]; infer_instance
  exact MMP.Positivity.isIso_stalkMap_of_valuationRing p hp w

/-- For a separated dominant morphism inducing an isomorphism of function fields, at most one
point lies over the generic point of a prime divisor. -/
private theorem eq_of_map_eq_genericPoint (p : W ⟶ X) [IsSeparated p] [IsDominant p]
    (hp : Function.Bijective (functionFieldMap p)) {w w' : W} {P : MMP.Mori.PrimeDivisor X}
    (hw : p w = P.genericPoint) (hw' : p w' = P.genericPoint) : w = w' := by
  haveI := isIso_stalkMap_of_map_eq_genericPoint p hp hw
  haveI := isIso_stalkMap_of_map_eq_genericPoint p hp hw'
  haveI : ValuationRing (X.presheaf.stalk P.genericPoint) := by
    haveI := P.isDiscreteValuationRing_localRing
    exact inferInstanceAs (ValuationRing P.localRing)
  haveI : ValuationRing (X.presheaf.stalk (p w)) := by rw [hw]; infer_instance
  exact MMP.Positivity.eq_of_isIso_stalkMap p hp (hw'.trans hw.symm)

variable [IsSeparated (X ↘ ⊤_ Scheme)]

/-- An inverse `h` of a birational morphism `p`, evaluated at the generic point and followed by
`p`, is the canonical map `Spec k(X) ⟶ X`. -/
private theorem fromFunctionField_comp_of_isInverse [IsReduced W] {p : W ⟶ X}
    {h : X.RationalMap W} (hinv : RationalMap.IsInverse p.toRationalMap h) :
    h.fromFunctionField ≫ p = X.fromSpecStalk (genericPoint X) := by
  obtain ⟨ep, hep, rfl⟩ := hinv
  have hp1 : ep.source.ι ≫ p = ep.iso.hom ≫ ep.target.ι :=
    ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp hep)).symm
  have hηt : genericPoint X ∈ ep.target :=
    (genericPoint_specializes _).mem_open ep.target.2 ep.dense_target.nonempty.choose_spec
  change (ep.target.fromSpecStalkOfMem (genericPoint X) hηt ≫ ep.iso.inv ≫ ep.source.ι) ≫ p = _
  rw [Category.assoc, Category.assoc, hp1, Iso.inv_hom_id_assoc,
    Scheme.Opens.fromSpecStalkOfMem_ι]

/-- An inverse `h` of a birational morphism `p` satisfies `p ∘ h = id`. -/
private theorem compHom_eq_of_isInverse [IsReduced W] {p : W ⟶ X} {h : X.RationalMap W}
    (hinv : RationalMap.IsInverse p.toRationalMap h) :
    h.compHom p = Scheme.Hom.toRationalMap (𝟙 X) := by
  refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
  rw [MMP.Flips.RationalMap.fromFunctionField_compHom, fromFunctionField_comp_of_isInverse hinv,
    MMP.Flips.RationalMap.fromFunctionField_hom, Category.comp_id]

/-- Every representative `g` of an inverse of a birational morphism `p` satisfies
`g ≫ p = ι`. -/
private theorem hom_comp_eq_of_isInverse [IsReduced W] {p : W ⟶ X} {h : X.RationalMap W}
    (hinv : RationalMap.IsInverse p.toRationalMap h) (g : X.PartialMap W)
    (hg : g.toRationalMap = h) : g.hom ≫ p = g.domain.ι := by
  have h1 : (g.compHom p).toRationalMap = (Scheme.Hom.toPartialMap (𝟙 X)).toRationalMap := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg]
    exact compHom_eq_of_isInverse hinv
  have h2 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
    (Scheme.PartialMap.toRationalMap_eq_iff.mp h1)
  exact h2.trans (Category.comp_id _)

/-- **The strict transform under the inverse of a resolution.** If `p : W ⟶ X` is a proper
birational morphism with inverse `h`, and the prime divisor `P_W` of `W` lies over the prime
divisor `P` of `X`, then `h` sends `P` to `P_W`. -/
private theorem transformPrimeDivisor_eq_some_of_isInverse [IsNormal W] [IsLocallyNoetherian W]
    [IsSeparated (W ↘ ⊤_ Scheme)]
    {p : W ⟶ X} [IsProper p] [IsDominant p] (hp : Function.Bijective (functionFieldMap p))
    {h : X.RationalMap W} (hinv : RationalMap.IsInverse p.toRationalMap h)
    {P : MMP.Mori.PrimeDivisor X} {PW : MMP.Mori.PrimeDivisor W}
    (hPW : p PW.genericPoint = P.genericPoint) :
    RationalMap.transformPrimeDivisor h P = some PW := by
  have := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  have hdom : P.genericPoint ∈ h.domain :=
    MMP.Flips.RationalMap.mem_domain_of_coheight_le_one (𝟙 X) p h
      (compHom_eq_of_isInverse hinv) P.coheight_genericPoint.le
  obtain ⟨g, hgP, hg⟩ := RationalMap.definedAt_iff.mp hdom
  have hgp := hom_comp_eq_of_isInverse hinv g hg
  have hw : p (g.hom ⟨P.genericPoint, hgP⟩) = P.genericPoint := by
    change (g.hom ≫ p) ⟨P.genericPoint, hgP⟩ = _
    rw [hgp]; rfl
  exact MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq g hg hgP
    (eq_of_map_eq_genericPoint p hp hPW hw)

/-- If the inverse `h` of a birational morphism `p` sends `P` to `P'`, then `p` sends the
generic point of `P'` to that of `P`. -/
private theorem map_genericPoint_of_transformPrimeDivisor_eq_some [IsReduced W]
    [IsSeparated (W ↘ ⊤_ Scheme)] {p : W ⟶ X} {h : X.RationalMap W}
    (hinv : RationalMap.IsInverse p.toRationalMap h) {P : MMP.Mori.PrimeDivisor X}
    {P' : MMP.Mori.PrimeDivisor W} (hP : RationalMap.transformPrimeDivisor h P = some P') :
    p P'.genericPoint = P.genericPoint := by
  obtain ⟨hdef, -⟩ := RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
  obtain ⟨g, hgP, hg⟩ := RationalMap.definedAt_iff.mp hdef
  rw [MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g hg hgP]
  change (g.hom ≫ p) ⟨P.genericPoint, hgP⟩ = _
  rw [hom_comp_eq_of_isInverse hinv g hg]; rfl

/-- If `h : X ⤏ W` sends the prime divisor `P` to `P'`, then `q ∘ h` sends `P` where the
morphism `q` sends `P'`. -/
private theorem transformPrimeDivisor_compHom {Y : Scheme.{0}} [IsReduced W]
    [IsSeparated (W ↘ ⊤_ Scheme)] [IsSeparated (Y ↘ ⊤_ Scheme)] {h : X.RationalMap W}
    {P : MMP.Mori.PrimeDivisor X} {P' : MMP.Mori.PrimeDivisor W}
    (hP : RationalMap.transformPrimeDivisor h P = some P') (q : W ⟶ Y) :
    RationalMap.transformPrimeDivisor (h.compHom q) P =
      RationalMap.transformPrimeDivisor (X := W) q.toRationalMap P' := by
  obtain ⟨hdef, -⟩ := RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
  obtain ⟨g', hg'P, hg'⟩ := RationalMap.definedAt_iff.mp hdef
  have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g' hg' hg'P
  have hrep : (g'.compHom q).toRationalMap = h.compHom q := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg']
  refine Option.ext fun F => ?_
  rw [MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
  constructor
  · intro h1
    have h2 := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h1 (g'.compHom q) hrep
      hg'P
    rw [h2, hη]
    rfl
  · intro h1
    refine MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq (g'.compHom q) hrep hg'P ?_
    rw [← h1, hη]
    rfl

/-- If `h : X ⤏ W` sends the prime divisor `P` to `P'`, then `P` is exceptional for `q ∘ h`
exactly when `P'` is exceptional for the morphism `q`. -/
private theorem isExceptional_compHom_iff {Y : Scheme.{0}} [IsReduced W]
    [IsSeparated (W ↘ ⊤_ Scheme)] [IsSeparated (Y ↘ ⊤_ Scheme)] {h : X.RationalMap W}
    {P : MMP.Mori.PrimeDivisor X} {P' : MMP.Mori.PrimeDivisor W}
    (hP : RationalMap.transformPrimeDivisor h P = some P') (q : W ⟶ Y) :
    RationalMap.IsExceptional (h.compHom q) P ↔
      RationalMap.IsExceptional (X := W) q.toRationalMap P' := by
  obtain ⟨hdef, -⟩ := RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
  obtain ⟨g', hg'P, hg'⟩ := RationalMap.definedAt_iff.mp hdef
  have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g' hg' hg'P
  have hrep : (g'.compHom q).toRationalMap = h.compHom q := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg']
  have hdef1 : RationalMap.DefinedAt (h.compHom q) P.genericPoint :=
    RationalMap.definedAt_iff.mpr ⟨g'.compHom q, hg'P, hrep⟩
  have hdef2 : RationalMap.DefinedAt (X := W) q.toRationalMap P'.genericPoint := by
    rw [RationalMap.DefinedAt, RationalMap.dom_toRationalMap_hom]
    trivial
  have htr : RationalMap.transform (h.compHom q) P.idealSheaf.support =
      RationalMap.transform (X := W) q.toRationalMap P'.idealSheaf.support := by
    apply SetLike.coe_injective
    rw [MMP.Flips.coe_transform_eq_closure_singleton (g'.compHom q) hrep P hg'P,
      MMP.Flips.coe_transform_eq_closure_singleton q.toPartialMap rfl P' trivial]
    congr 2
    change q (g'.hom ⟨P.genericPoint, hg'P⟩) = q P'.genericPoint
    rw [hη]
  rw [RationalMap.isExceptional_iff, RationalMap.isExceptional_iff, htr]
  exact ⟨fun h1 _ => h1 hdef1, fun h1 _ => h1 hdef2⟩

/-- The coefficient of `f⁻¹_* D` along a prime divisor `P` lying over the prime divisor `Q` is
the coefficient of `D` along `Q`. -/
private theorem coeff_birationalInverseTransform [IsNormal W] [IsLocallyNoetherian W]
    [IsSeparated (W ↘ ⊤_ Scheme)] {p : W ⟶ X} [IsProper p] [IsDominant p]
    (hp : MMP.Mori.IsBirationalMorphism p) (D : RDivisor X) {P : MMP.Mori.PrimeDivisor W}
    {Q : MMP.Mori.PrimeDivisor X} (hPQ : p P.genericPoint = Q.genericPoint) :
    (MMP.Flips.birationalInverseTransform p hp D).coeff P = D.coeff Q := by
  have hinv := MMP.Mori.RationalMap.IsBirational.isInverse_inverse hp
  have hpbij := hp.functionFieldMap_bijective
  have := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  have h1 := transformPrimeDivisor_eq_some_of_isInverse hpbij hinv hPQ
  refine MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq h1 (fun Q' hQ' => ?_) D
  have h2 := map_genericPoint_of_transformPrimeDivisor_eq_some hinv hQ'
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (h2.symm.trans hPQ)

/-- The coefficient of `f_* D` along `Q` is that of `D` along a prime divisor `P` over `Q`, for a
separated birational morphism. -/
private theorem coeff_transformDivisor_hom [IsNormal W] [IsLocallyNoetherian W]
    [IsSeparated (X ↘ ⊤_ Scheme)] {p : W ⟶ X} [IsSeparated p] [IsDominant p]
    (hp : Function.Bijective (functionFieldMap p)) (D : RDivisor W)
    {P : MMP.Mori.PrimeDivisor W} {Q : MMP.Mori.PrimeDivisor X}
    (hPQ : p P.genericPoint = Q.genericPoint) :
    (MMP.Mori.RationalMap.transformDivisor (X := W) p.toRationalMap D).coeff Q = D.coeff P := by
  refine MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq
    ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff p P Q).mpr hPQ)
    (fun P' hP' => ?_) D
  have h := (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff p P' Q).mp hP'
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_genericPoint p hp h hPQ)

end StrictTransforms

section LogDiscrepancyValues

/-! ### Log discrepancies of prime divisors on a model -/

open MMP.Mori

variable {Y V : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
  {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] [IsIntegral V] [IsLocallyNoetherian V]
  [IsNormal V] [CompactSpace V]

/-- A canonical divisor of a normal complex variety is the divisor of a nonzero top form. -/
private theorem exists_divisorOfForm_eq_of_isCanonicalDivisor (hY : IsNormalVariety ℂ sY)
    {n : ℕ} {K : Divisor Y} (hK : K.IsCanonicalDivisor sY n) :
    ∃ ω : RationalPluriForms sY n 1, ω ≠ 0 ∧ divisorOfForm ω = K := by
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hY hK
  exact ⟨ω, hω0, DivisorWithCoeffs.ext' hωK⟩

/-- Every prime divisor of a model has a log discrepancy once `K_Y + Γ` is `ℝ`-Cartier. -/
private theorem exists_isLogDiscrepancy_primeDivisor (hY : IsNormalVariety ℂ sY) {r : V ⟶ Y}
    [IsProper r] (hV : IsNormalVariety ℂ (r ≫ sY)) (hr : IsBirationalMorphism r) {K : Divisor Y}
    {n : ℕ} (hK : K.IsCanonicalDivisor sY n) {Γ : RDivisor Y}
    (hKΓ : IsCartierCombination (logCanonicalDivisor K Γ)) (Q : MMP.Mori.PrimeDivisor V) :
    ∃ a, MMP.Intersection.IsLogDiscrepancy sY n Γ ⟨V, r, hV, hr, Q⟩ a := by
  haveI : IsDominant r := hr.isDominant
  obtain ⟨ω, hω0, hωK⟩ := exists_divisorOfForm_eq_of_isCanonicalDivisor hY hK
  subst hωK
  obtain ⟨G, hG, -⟩ := MMP.Flips.existsUnique_isRCartierPullback r hKΓ
  exact ⟨_, isLogDiscrepancy_of_isRCartierPullback hY hV hr hω0 hK hG Q⟩

/-- A prime divisor of a model lying over a prime divisor `F` of `Y` has log discrepancy
`1 - Γ_F`. -/
private theorem isLogDiscrepancy_of_map_eq_genericPoint (hY : IsNormalVariety ℂ sY) {r : V ⟶ Y}
    [IsProper r] (hV : IsNormalVariety ℂ (r ≫ sY)) (hr : IsBirationalMorphism r) {K : Divisor Y}
    {n : ℕ} (hK : K.IsCanonicalDivisor sY n) {Γ : RDivisor Y}
    (hKΓ : IsCartierCombination (logCanonicalDivisor K Γ)) (Q : MMP.Mori.PrimeDivisor V)
    (F : MMP.Mori.PrimeDivisor Y) (hQ : r Q.genericPoint = F.genericPoint) :
    MMP.Intersection.IsLogDiscrepancy sY n Γ ⟨V, r, hV, hr, Q⟩ (1 - Γ.coeff F) := by
  haveI : IsDominant r := hr.isDominant
  haveI : MMP.Mori.IsVariety ℂ sY := hY.1
  obtain ⟨ω, hω0, hωK⟩ := exists_divisorOfForm_eq_of_isCanonicalDivisor hY hK
  subst hωK
  obtain ⟨G, hG, -⟩ := MMP.Flips.existsUnique_isRCartierPullback r hKΓ
  have h := isLogDiscrepancy_of_isRCartierPullback hY hV hr hω0 hK hG Q
  haveI := isIso_stalkMap_of_map_eq_genericPoint r hr.functionFieldMap_bijective hQ
  have hGQ := coeff_eq_of_isRCartierPullback hG Q F hQ
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY)
    hK.topologicalKrullDim_eq
  have hord : Q.ordForm (pullbackRationalPluriForms sY r ω) = F.ordForm ω :=
    MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso r hr.functionFieldMap_bijective hd
      Q F hQ ω
  convert h using 1
  rw [hGQ, DivisorOver.ordPullback]
  change _ = 1 + ((Q.ordForm (pullbackRationalPluriForms sY r ω) : ℤ) : ℝ) - _
  rw [hord, logCanonicalDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor,
    coeff_divisorOfForm]
  ring

end LogDiscrepancyValues

section Exceptional

open MMP.Mori

/-- A prime divisor `E` is exceptional for a morphism `q` exactly when `q(η_E)` has coheight at
least two. -/
private theorem isExceptional_toRationalMap_iff_two_le_coheight {W Y : Scheme.{0}}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsSeparated (Y ↘ ⊤_ Scheme)] (q : W ⟶ Y) (E : MMP.Mori.PrimeDivisor W) :
    RationalMap.IsExceptional (X := W) q.toRationalMap E ↔ 2 ≤ Order.coheight (q E.genericPoint) := by
  rw [MMP.Positivity.isExceptional_toRationalMap_iff, MMP.Flips.le_closedsCodimension_iff_le_coheight]
  have hcl : (TopologicalSpace.Closeds.closure (q '' (E.idealSheaf.support : Set W)) : Set Y) =
      closure {q E.genericPoint} := by
    rw [TopologicalSpace.Closeds.coe_closure]
    have hs : (E.idealSheaf.support : Set W) = closure {E.genericPoint} :=
      AlgebraicGeometry.PrimeDivisor.support_eq_closure E
    rw [hs]
    refine le_antisymm ?_ ?_
    · refine closure_minimal ?_ isClosed_closure
      refine (image_closure_subset_closure_image q.continuous).trans ?_
      rw [Set.image_singleton]
    · refine closure_mono ?_
      rw [Set.singleton_subset_iff]
      exact ⟨E.genericPoint, subset_closure rfl, rfl⟩
  rw [hcl]
  refine ⟨fun h => h _ (subset_closure rfl), fun h x hx => ?_⟩
  have hsp : q E.genericPoint ⤳ x := specializes_iff_mem_closure.mpr hx
  exact h.trans (Order.coheight_anti (show x ≤ q E.genericPoint from hsp))

/-- The image of the generic point of an exceptional divisor over `Y` has coheight at least
two. -/
private theorem two_le_coheight_of_isExceptional {k : Type} [Field k] {Y : Scheme.{0}}
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [LocallyOfFiniteType sY] [QuasiCompact sY]
    (D : ProperDivisorOver k sY) (hD : D.IsExceptional) {m : ℕ}
    (hdim : topologicalKrullDim Y = m) :
    2 ≤ Order.coheight (D.f D.E.genericPoint) := by
  unfold ProperDivisorOver.IsExceptional at hD
  rw [D.center_eq_toDivisorOver_center, D.toDivisorOver.center_eq_closure_genericPoint,
    hdim] at hD
  set y := D.f D.E.genericPoint
  have hsum := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sY y
  rw [hdim] at hsum
  obtain ⟨d, hd⟩ : ∃ d : ℕ∞, topologicalKrullDim (closure {y} : Set Y) = d := by
    refine WithBot.ne_bot_iff_exists.mp (fun h => ?_) |>.imp fun d hd => hd.symm
    rw [h, WithBot.bot_add] at hsum
    exact WithBot.bot_ne_coe hsum
  rw [hd] at hsum hD
  have hsum' : d + Order.coheight y = (m : ℕ∞) := by exact_mod_cast hsum
  have hD' : d + 2 ≤ (m : ℕ∞) := by
    exact_mod_cast (show ((d + 2 : ℕ∞) : WithBot ℕ∞) ≤ ((m : ℕ∞) : WithBot ℕ∞) by
      push_cast; exact hD)
  have hdtop : d ≠ ⊤ := fun h => by
    rw [h, top_add] at hsum'
    exact ENat.top_ne_coe _ hsum'
  rw [← hsum'] at hD'
  exact (ENat.add_le_add_iff_left hdtop).mp hD'

end Exceptional

section NefTransfer

open MMP.Mori

variable {k : Type} [Field k] {Y Z : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
  [IsNormal Y] [CompactSpace Y] {sY : Y ⟶ Spec (.of k)} [QuasiCompact sY]

/-- Relative nefness of an adjoint does not depend on the canonical divisor in its linear
equivalence class. -/
private theorem isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent {πY : Y ⟶ Z}
    {K K' : Divisor Y} {Δ : RDivisor Y} (hKK : K'.LinearlyEquivalent K)
    (h : IsRelativelyNef k sY πY (logCanonicalDivisor K Δ)) :
    IsRelativelyNef k sY πY (logCanonicalDivisor K' Δ) := by
  obtain ⟨φ, hφ⟩ := hKK
  obtain ⟨m, r, L, hL, hD, hnn⟩ := h
  have hP : (principalDivisor φ).IsCartier := Divisor.isCartier_principalDivisor φ
  refine ⟨m + 1, Fin.snoc (α := fun _ => ℝ) r 1,
    Fin.snoc (α := fun _ => Divisor Y) L (principalDivisor φ), fun j => ?_, ?_, ?_⟩
  · refine Fin.lastCases (motive := fun j =>
      (Fin.snoc (α := fun _ => Divisor Y) L (principalDivisor φ) j).IsCartier)
      ?_ (fun i => ?_) j
    · simpa using hP
    · simpa using hL i
  · rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, one_smul]
    rw [← hD, ← hφ, logCanonicalDivisor, logCanonicalDivisor, map_sub]
    abel
  · intro C hC x hx
    obtain ⟨hL', d, hD', hd, rfl⟩ := hx
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, one_mul]
    have hlast : d (Fin.last m) = 0 := by
      obtain ⟨C', ν, hν, hdim, hdeg⟩ := hd (Fin.last m)
      have := hν.isFinite
      haveI : IsProper ((ν ≫ C.ι) ≫ sY) := by rw [Category.assoc]; infer_instance
      have hP' : Fin.snoc (α := fun _ => Divisor Y) L (principalDivisor φ) (Fin.last m) =
          principalDivisor φ := by simp
      rw [hdeg]
      exact MMP.Flips.Divisor.degreeOn_eq_zero_of_linearlyEquivalent _ _ _ _
        ⟨φ, by rw [hP', sub_zero]⟩
    rw [hlast, Int.cast_zero, add_zero]
    refine hnn C hC _ ⟨hL, fun j => d j.castSucc, hD, fun j => ?_, rfl⟩
    have := hd j.castSucc
    simp only [Fin.snoc_castSucc] at this
    exact this

end NefTransfer

section Composite

/-! ### Composites of partial isomorphisms -/

private theorem restrictSource_hom_ι {X Y : Scheme} (f : X.PartialIso Y) (U : X.Opens)
    (hU : Dense (U : Set X)) (hU' : U ≤ f.source) :
    (f.restrictSource U hU hU').iso.hom ≫ (f.restrictSource U hU hU').target.ι =
      X.homOfLE hU' ≫ f.iso.hom ≫ f.target.ι := by
  have h : (Scheme.Opens.isoOfLE hU').inv ≫ (f.source.ι ⁻¹ᵁ U).ι = X.homOfLE hU' := by
    rw [← cancel_mono f.source.ι]; simp [Scheme.Opens.isoOfLE_inv_ι]
  simp [Scheme.PartialIso.restrictSource, ← reassoc_of% h]

private theorem trans_hom_ι {X Y Z : Scheme} (f : X.PartialIso Y) (g : Y.PartialIso Z) :
    ∃ (h : (f.trans g).source ≤ f.source) (l : ((f.trans g).source : Scheme) ⟶ g.source),
      l ≫ g.source.ι = X.homOfLE h ≫ f.iso.hom ≫ f.target.ι ∧
      (f.trans g).iso.hom ≫ (f.trans g).target.ι = l ≫ g.iso.hom ≫ g.target.ι := by
  have hV : Dense ((f.target ⊓ g.source : Y.Opens) : Set Y) :=
    f.dense_target.inter_of_isOpen_right g.dense_source g.source.2
  have h1 := restrictSource_hom_ι f.symm (f.target ⊓ g.source) hV inf_le_left
  have h2 := restrictSource_hom_ι g (f.target ⊓ g.source) hV inf_le_right
  set rs := f.symm.restrictSource (f.target ⊓ g.source) hV inf_le_left
  have hle : rs.target ≤ f.source := Scheme.Opens.ι_image_le _ _
  have key : rs.iso.inv ≫ Y.homOfLE (inf_le_left : f.target ⊓ g.source ≤ f.target) =
      X.homOfLE hle ≫ f.iso.hom := by
    rw [← cancel_mono (f.iso.inv ≫ f.source.ι)]
    have : rs.iso.inv ≫ rs.iso.hom ≫ rs.target.ι = rs.target.ι := Iso.inv_hom_id_assoc _ _
    rw [h1] at this
    simp only [Category.assoc] at this ⊢
    erw [this]
    rw [Iso.hom_inv_id_assoc, Scheme.homOfLE_ι]
  refine ⟨hle, rs.iso.inv ≫ Y.homOfLE (inf_le_right : f.target ⊓ g.source ≤ g.source), ?_, ?_⟩
  · have e1 : Y.homOfLE (inf_le_right : f.target ⊓ g.source ≤ g.source) ≫ g.source.ι =
        Y.homOfLE (inf_le_left : f.target ⊓ g.source ≤ f.target) ≫ f.target.ι := by simp
    erw [Category.assoc, e1, ← Category.assoc, key, Category.assoc]
  · change (rs.iso.inv ≫ (Y.isoOfEq rfl).hom ≫
      (g.restrictSource (f.target ⊓ g.source) hV inf_le_right).iso.hom) ≫
      (g.restrictSource (f.target ⊓ g.source) hV inf_le_right).target.ι = _
    simp only [Category.assoc, Scheme.isoOfEq_rfl, Iso.refl_hom, Category.id_comp]
    erw [h2]
    rfl

private theorem comp_hom_spec {X Y Z : Scheme} [IsIntegral X] [IsIntegral Y] (f : X.PartialMap Y)
    [IsDominant f.hom] (g : Y.PartialMap Z) :
    ∃ (hle : (f.comp g).domain ≤ f.domain) (m : ((f.comp g).domain : Scheme) ⟶ g.domain),
      m ≫ g.domain.ι = X.homOfLE hle ≫ f.hom ∧ (f.comp g).hom = m ≫ g.hom := by
  set D : X.Opens := f.domain.ι ''ᵁ f.hom ⁻¹ᵁ g.domain with hD
  have hle : D ≤ f.domain := Scheme.Opens.ι_image_le _ _
  have h3 : (Scheme.Hom.isoImage f.domain.ι (f.hom ⁻¹ᵁ g.domain)).inv ≫
      (f.hom ⁻¹ᵁ g.domain).ι = X.homOfLE hle := by
    rw [← cancel_mono f.domain.ι, Category.assoc, Scheme.Hom.isoImage_inv_ι, Scheme.homOfLE_ι]
  have hm : ((Scheme.Hom.isoImage f.domain.ι (f.hom ⁻¹ᵁ g.domain)).inv ≫ (f.hom ∣_ g.domain)) ≫
      g.domain.ι = X.homOfLE hle ≫ f.hom := by
    rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, h3]
  exact ⟨hle, _, hm, rfl⟩

private theorem trans_toRationalMap {X Y Z : Scheme} [IsIntegral X] [IsIntegral Y] (f : X.PartialIso Y)
    (g : Y.PartialIso Z) [IsDominant f.toPartialMap.hom] :
    (f.trans g).toRationalMap = (f.toPartialMap.comp g.toPartialMap).toRationalMap := by
  obtain ⟨hle, l, hl, htr⟩ := trans_hom_ι f g
  obtain ⟨hle', m, hm, hcomp⟩ := comp_hom_spec f.toPartialMap g.toPartialMap
  let m' : ((f.toPartialMap.comp g.toPartialMap).domain : Scheme) ⟶ (g.source : Scheme) := m
  have hle'' : (f.toPartialMap.comp g.toPartialMap).domain ≤ f.source := hle'
  have hm' : m' ≫ g.source.ι = X.homOfLE hle'' ≫ f.iso.hom ≫ f.target.ι := hm
  have hcomp' : (f.toPartialMap.comp g.toPartialMap).hom = m' ≫ g.iso.hom ≫ g.target.ι := hcomp
  have hW : (f.trans g).source ≤ (f.toPartialMap.comp g.toPartialMap).domain := by
    intro x hx
    refine ⟨⟨x, hle hx⟩, ?_, rfl⟩
    let w : ((f.trans g).source : Scheme) := ⟨x, hx⟩
    have h2 : (l ≫ g.source.ι) w ∈ g.source := by
      rw [Scheme.Hom.comp_apply]; exact (l w).2
    rw [hl, Scheme.Hom.comp_apply,
      show X.homOfLE hle w = (⟨x, hle hx⟩ : (f.source : Scheme)) from
        Subtype.ext (Scheme.homOfLE_apply hle w)] at h2
    exact h2
  have hlm : l = X.homOfLE hW ≫ m' := by
    apply (cancel_mono g.source.ι).mp
    rw [hl, Category.assoc, hm', ← Category.assoc (X.homOfLE hW), Scheme.homOfLE_homOfLE]
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨(f.trans g).source, (f.trans g).dense_source, le_rfl, hW, ?_⟩
  change X.homOfLE le_rfl ≫ ((f.trans g).iso.hom ≫ (f.trans g).target.ι) =
    X.homOfLE hW ≫ (f.toPartialMap.comp g.toPartialMap).hom
  rw [Scheme.homOfLE_rfl, Category.id_comp, htr, hcomp', hlm, Category.assoc]

/-- **Transforms under a composite.** If `φ` sends `P` to `P₁` and `ψ` sends `P₁` to `P₂`, then
`ψ ∘ φ` sends `P` to `P₂`. -/
private theorem transformPrimeDivisor_comp_of_eq_some {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsSeparated (Y ↘ ⊤_ Scheme)] [IsSeparated (Z ↘ ⊤_ Scheme)]
    {φ : X.RationalMap Y} [φ.IsDominant] {ψ : Y.RationalMap Z} {P : MMP.Mori.PrimeDivisor X}
    {P₁ : MMP.Mori.PrimeDivisor Y} {P₂ : MMP.Mori.PrimeDivisor Z}
    (h₁ : MMP.Mori.RationalMap.transformPrimeDivisor φ P = some P₁)
    (h₂ : MMP.Mori.RationalMap.transformPrimeDivisor ψ P₁ = some P₂) :
    MMP.Mori.RationalMap.transformPrimeDivisor (φ.comp ψ) P = some P₂ := by
  obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h₁
  obtain ⟨g, hgP, hg⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
  have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h₁ g hg hgP
  obtain ⟨hdef', -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h₂
  obtain ⟨g', hg'P, hg'⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef'
  have hη' := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h₂ g' hg' hg'P
  haveI : IsDominant g.hom := by
    rw [← g.isDominant_toRationalMap_iff, hg]; infer_instance
  have hrep : (g.comp g').toRationalMap = φ.comp ψ := by
    subst hg hg'
    exact (Scheme.RationalMap.toRationalMap_comp g g').symm
  obtain ⟨hle, m, hm, hcomp⟩ := comp_hom_spec g g'
  have hPd : P.genericPoint ∈ (g.comp g').domain := by
    refine ⟨⟨P.genericPoint, hgP⟩, ?_, rfl⟩
    show g.hom ⟨P.genericPoint, hgP⟩ ∈ g'.domain
    rw [← hη]; exact hg'P
  refine MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq (g.comp g') hrep hPd ?_
  let w : ((g.comp g').domain : Scheme) := ⟨P.genericPoint, hPd⟩
  have hw : m w = ⟨P₁.genericPoint, hg'P⟩ := by
    apply Subtype.ext
    have h3 : (m ≫ g'.domain.ι) w = (X.homOfLE hle ≫ g.hom) w := by rw [hm]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      show X.homOfLE hle w = (⟨P.genericPoint, hgP⟩ : (g.domain : Scheme)) from
        Subtype.ext (Scheme.homOfLE_apply hle w)] at h3
    rw [← hη] at h3
    exact h3
  change P₂.genericPoint = (g.comp g').hom w
  rw [hcomp, Scheme.Hom.comp_apply, hw]
  exact hη'

end Composite

section Chain

/-! ### Chains of partial isomorphisms -/

variable {V : ℕ → Scheme.{0}} (e : ∀ n, (V n).PartialIso (V (n + 1)))

/-- The composite `V 0 ⤏ V n` of a chain of partial isomorphisms. -/
private noncomputable def chainIso : ∀ n, (V 0).PartialIso (V n)
  | 0 => Scheme.PartialIso.refl (V 0)
  | n + 1 => (chainIso n).trans (e n)

private theorem chainIso_succ (n : ℕ) : chainIso e (n + 1) = (chainIso e n).trans (e n) := rfl

private theorem isDominant_partialIso_hom {X Y : Scheme.{0}} (f : X.PartialIso Y) :
    IsDominant f.toPartialMap.hom := by
  haveI := AlgebraicGeometry.Opens.isDominant_ι f.dense_target
  change IsDominant (f.iso.hom ≫ f.target.ι)
  infer_instance

private theorem isDominant_toRationalMap_partialIso {X Y : Scheme.{0}} (f : X.PartialIso Y) :
    f.toRationalMap.IsDominant := by
  haveI := isDominant_partialIso_hom f
  infer_instance

/-- The composite of a chain, as a rational map, is the iterated composite of the steps. -/
private theorem chainIso_succ_toRationalMap [∀ n, IsIntegral (V n)] (n : ℕ) :
    haveI := isDominant_toRationalMap_partialIso (chainIso e n)
    (chainIso e (n + 1)).toRationalMap =
      (chainIso e n).toRationalMap.comp (e n).toRationalMap := by
  haveI := isDominant_partialIso_hom (chainIso e n)
  rw [chainIso_succ, trans_toRationalMap]
  exact (Scheme.RationalMap.toRationalMap_comp _ _).symm

/-- A chain of partial isomorphisms over a separated base lies over the base. -/
private theorem isOver_chainIso {S : Scheme.{0}} (π : ∀ n, V n ⟶ S)
    (he : ∀ n, (e n).IsOver (π n) (π (n + 1))) :
    ∀ n, (chainIso e n).IsOver (π 0) (π n)
  | 0 => by
    simp only [chainIso, Scheme.PartialIso.IsOver, Scheme.PartialIso.refl_iso, Iso.refl_hom]
    rfl
  | n + 1 => (isOver_chainIso π he n).trans (he n)

/-- Transforms along a chain: if the first `n` steps send `P` to `Q` and the next step sends `Q`
to `Q'`, the first `n + 1` steps send `P` to `Q'`. -/
private theorem transformPrimeDivisor_chainIso_succ [∀ n, IsIntegral (V n)]
    [∀ n, IsSeparated (V n ↘ ⊤_ Scheme)] {n : ℕ} {P : MMP.Mori.PrimeDivisor (V 0)}
    {Q : MMP.Mori.PrimeDivisor (V n)} {Q' : MMP.Mori.PrimeDivisor (V (n + 1))}
    (hP : MMP.Mori.RationalMap.transformPrimeDivisor (chainIso e n).toRationalMap P = some Q)
    (hQ : MMP.Mori.RationalMap.transformPrimeDivisor (e n).toRationalMap Q = some Q') :
    MMP.Mori.RationalMap.transformPrimeDivisor (chainIso e (n + 1)).toRationalMap P = some Q' := by
  haveI := isDominant_toRationalMap_partialIso (chainIso e n)
  rw [chainIso_succ_toRationalMap]
  exact transformPrimeDivisor_comp_of_eq_some hP hQ

end Chain

section StepComparison

/-! ### Comparison of log discrepancies across a step over a base -/

open MMP.Mori

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- The valuation of a divisor over `X` with proper model has nonempty center. -/
private theorem hasNonemptyCenter_valuation' (E : ProperDivisorOver k sX) :
    HasNonemptyCenter k sX E.valuation := by
  haveI := E.isIntegral
  haveI := E.isNormal
  haveI := E.isLocallyNoetherian
  haveI := E.isDominant
  exact ⟨⟨E.Y, E.f ≫ sX, E.isNormalVariety, E.E,
    MMP.Mori.functionFieldAlgEquiv sX E.f E.isBirationalMorphism.functionFieldMap_bijective,
    rfl⟩, E, rfl⟩

/-- Every divisor with proper model has a discrepancy, once `K + D` is `ℝ`-Cartier for
`K = div ω`. -/
private theorem exists_isDiscrepancy_of_properDivisorOver [CompactSpace X]
    [LocallyOfFiniteType sX] (hX : IsNormalVariety k sX) {n : ℕ}
    {ω : RationalPluriForms sX n 1} (hω : ω ≠ 0) (hK : (divisorOfForm ω).IsCanonicalDivisor sX n)
    {D : RDivisor X} (hKD : IsCartierCombination (Divisor.toRDivisor (divisorOfForm ω) + D))
    (E : ProperDivisorOver k sX) : ∃ b, IsDiscrepancy sX n (divisorOfForm ω) D E.valuation b := by
  obtain ⟨m, r, L, hLc, hsum⟩ := hKD
  have hsum' : Divisor.toRDivisor (divisorOfForm ω) + D = ∑ j, r j • Divisor.toRDivisor (L j) :=
    hsum
  haveI := E.isIntegral
  haveI := E.isNormal
  haveI := E.isLocallyNoetherian
  haveI := E.isDominant
  haveI := E.isProper
  haveI : CompactSpace E.Y := QuasiCompact.compactSpace_of_compactSpace E.f
  choose L' hL' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant E.f (hLc j)
  exact ⟨_, hK, ⟨m, r, L, hLc, hsum⟩, hasNonemptyCenter_valuation' E, E, ω, m, r, L, rfl, rfl,
    hX, hK.topologicalKrullDim_eq, hω, hLc, hsum', L', fun j => ⟨_, hL' j⟩, rfl⟩

/-- **Log discrepancies do not decrease across a step over a base.** Let `f : V ⟶ T` and
`g : V' ⟶ T` be proper birational morphisms of normal varieties, `K_V = div f^*ω`,
`K_{V'} = div g^*ω` for a rational top form `ω` on `T`, and `Γ`, `Γ'` boundaries with the same
push-forward to `T`, such that `-(K_V + Γ)` is `f`-nef and `K_{V'} + Γ'` is `g`-nef. Then
`a(E; V, Γ) ≤ a(E'; V', Γ')` for divisors `E` over `V` and `E'` over `V'` with the same
valuation of `k(T)`. -/
private theorem isLogDiscrepancy_le_of_isRelativelyNef' {V V' T : Scheme.{0}} [IsIntegral V]
    [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V] [IsIntegral V']
    [IsLocallyNoetherian V'] [IsNormal V'] [CompactSpace V'] [IsIntegral T]
    [IsLocallyNoetherian T] [IsNormal T] {sT : T ⟶ Spec (.of ℂ)} [QuasiCompact sT]
    [LocallyOfFiniteType sT] (hT : IsNormalVariety ℂ sT) {f : V ⟶ T} {g : V' ⟶ T}
    [IsProper f] [IsProper g] (hV : IsNormalVariety ℂ (f ≫ sT))
    (hV' : IsNormalVariety ℂ (g ≫ sT)) (hf : IsBirationalMorphism f)
    (hg : IsBirationalMorphism g) {n : ℕ} {ω : RationalPluriForms sT n 1}
    (hωf : haveI := hf.isDominant; pullbackRationalPluriForms sT f ω ≠ 0)
    (hωg : haveI := hg.isDominant; pullbackRationalPluriForms sT g ω ≠ 0)
    (hKf : haveI := hf.isDominant
      (divisorOfForm (pullbackRationalPluriForms sT f ω)).IsCanonicalDivisor (f ≫ sT) n)
    (hKg : haveI := hg.isDominant
      (divisorOfForm (pullbackRationalPluriForms sT g ω)).IsCanonicalDivisor (g ≫ sT) n)
    {Γ : RDivisor V} {Γ' : RDivisor V'}
    (hcomp : RationalMap.transformDivisor (X := V) f.toRationalMap Γ =
      RationalMap.transformDivisor (X := V') g.toRationalMap Γ')
    (hKΓ : haveI := hf.isDominant; IsCartierCombination
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sT f ω)) + Γ))
    (hKΓ' : haveI := hg.isDominant; IsCartierCombination
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sT g ω)) + Γ'))
    (hanti : haveI := hf.isDominant; IsRelativelyNef ℂ (f ≫ sT) f
      (-logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sT f ω)) Γ))
    (hnef : haveI := hg.isDominant; IsRelativelyNef ℂ (g ≫ sT) g
      (logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sT g ω)) Γ'))
    (E : ProperDivisorOver ℂ (f ≫ sT)) (E' : ProperDivisorOver ℂ (g ≫ sT))
    (hvT : haveI := hg.isDominant
      HasNonemptyCenter ℂ sT (E'.valuation.comap (functionFieldMap g)))
    (hv : haveI := hf.isDominant; haveI := hg.isDominant
      E.valuation.comap (functionFieldMap f) = E'.valuation.comap (functionFieldMap g))
    {a a' : ℝ} (ha : MMP.Intersection.IsLogDiscrepancy (f ≫ sT) n Γ E.toDivisorOver a)
    (ha' : MMP.Intersection.IsLogDiscrepancy (g ≫ sT) n Γ' E'.toDivisorOver a') : a ≤ a' := by
  classical
  haveI : IsDominant f := hf.isDominant
  haveI : IsDominant g := hg.isDominant
  have := hT.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hT
  haveI : IsSeparated f := IsSeparated.of_comp f (T ↘ ⊤_ Scheme)
  haveI : IsSeparated g := IsSeparated.of_comp g (T ↘ ⊤_ Scheme)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV'
  set D : RDivisor T := RationalMap.transformDivisor (X := V) f.toRationalMap Γ with hD
  -- the exceptional parts
  have hexc : ∀ {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
      [IsSeparated (W ↘ ⊤_ Scheme)] (q : W ⟶ T) [IsProper q] [IsDominant q] [IsSeparated q]
      (hW : IsNormalVariety ℂ (q ≫ sT)) (hq : IsBirationalMorphism q) (Δ : RDivisor W),
      RationalMap.transformDivisor (X := W) q.toRationalMap Δ = D →
      ∀ P : MMP.Mori.PrimeDivisor W, ¬ MMP.Flips.IsExceptionalPrimeDivisor sT q P →
        (Δ - MMP.Flips.birationalInverseTransform q hq D).coeff P = 0 := by
    intro W _ _ _ _ q _ _ _ hW hq Δ hΔ P hP
    have hnE : ¬ (MMP.Flips.ProperDivisorOver.mk ⟨W, q, hW, hq, P⟩ inferInstance :
        ProperDivisorOver ℂ sT).IsExceptional := fun h => hP ⟨hW, hq, inferInstance, h⟩
    obtain ⟨Q, -, hQ, -⟩ :=
      MMP.Flips.ProperDivisorOver.exists_primeDivisor_of_not_isExceptional hT _ hnE
    change Δ.coeff P - (MMP.Flips.birationalInverseTransform q hq D).coeff P = 0
    rw [coeff_birationalInverseTransform hq D hQ, ← hΔ,
      coeff_transformDivisor_hom hq.functionFieldMap_bijective Δ hQ, sub_self]
  have hEX := hexc f hV hf Γ rfl
  have hEY := hexc g hV' hg Γ' hcomp.symm
  have hΓ : MMP.Flips.birationalInverseTransform f hf D +
      (Γ - MMP.Flips.birationalInverseTransform f hf D) = Γ := add_sub_cancel _ _
  have hΓ' : MMP.Flips.birationalInverseTransform g hg D +
      (Γ' - MMP.Flips.birationalInverseTransform g hg D) = Γ' := add_sub_cancel _ _
  obtain ⟨-, -, hcmp⟩ := MMP.Flips.isDiscrepancy_le_of_isRelativelyNef hT hV hV' hf hg rfl rfl
    hEX hEY (by rw [hΓ]; exact hanti) (by rw [hΓ']; exact hnef) hvT hv rfl
  obtain ⟨b, hb⟩ := exists_isDiscrepancy_of_properDivisorOver hV hωf hKf hKΓ E
  obtain ⟨b', hb'⟩ := exists_isDiscrepancy_of_properDivisorOver hV' hωg hKg hKΓ' E'
  have hle := hcmp b b' (by rw [hΓ]; exact hb) (by rw [hΓ']; exact hb')
  have h1 := MMP.Fourfold.isLogDiscrepancy_of_isDiscrepancy hb E.toDivisorOver E.isProper rfl
  have h2 := MMP.Fourfold.isLogDiscrepancy_of_isDiscrepancy hb' E'.toDivisorOver E'.isProper rfl
  rw [MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1,
    MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha' h2]
  linarith

/-- Relative nefness of the negative of an adjoint does not depend on the canonical divisor in its
linear equivalence class. -/
private theorem isRelativelyNef_neg_logCanonicalDivisor_of_linearlyEquivalent {k : Type}
    [Field k] {Y Z : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] {sY : Y ⟶ Spec (.of k)} [QuasiCompact sY] {πY : Y ⟶ Z}
    {K K' : Divisor Y} {Δ : RDivisor Y} (hKK : K'.LinearlyEquivalent K)
    (h : IsRelativelyNef k sY πY (-logCanonicalDivisor K Δ)) :
    IsRelativelyNef k sY πY (-logCanonicalDivisor K' Δ) := by
  obtain ⟨φ, hφ⟩ := hKK
  have hKK' : (-K').LinearlyEquivalent (-K) := ⟨φ⁻¹, by
    rw [MMP.Mori.principalDivisor_inv, ← hφ]; abel⟩
  have h' : IsRelativelyNef k sY πY (logCanonicalDivisor (-K) (-Δ)) := by
    convert h using 1
    simp only [logCanonicalDivisor, map_neg]; abel
  have := isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hKK' h'
  convert this using 1
  simp only [logCanonicalDivisor, map_neg]; abel

/-- **Log discrepancies do not decrease across a step, on a common model.** Let
`f : Y ⟶ T`, `g : Y' ⟶ T` be proper birational morphisms of normal varieties, `Γ`, `Γ'` boundaries
with the same push-forward to `T`, `-(K_Y + Γ)` `f`-nef and `K_{Y'} + Γ'` `g`-nef. For proper
birational `r : V ⟶ Y`, `r' : V ⟶ Y'` with `r ≫ f = r' ≫ g`, every prime divisor `Q` of `V`
satisfies `a(Q; Y, Γ) ≤ a(Q; Y', Γ')`. -/
private theorem isLogDiscrepancy_le_of_step {V Y Y' T : Scheme.{0}}
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y'] [CompactSpace Y']
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    {sT : T ⟶ Spec (.of ℂ)} [QuasiCompact sT] [LocallyOfFiniteType sT]
    (hT : IsNormalVariety ℂ sT) {f : Y ⟶ T} {g : Y' ⟶ T} [IsProper f] [IsProper g]
    {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)} (hfs : f ≫ sT = sY) (hgs : g ≫ sT = sY')
    (hY : IsNormalVariety ℂ sY) (hY' : IsNormalVariety ℂ sY')
    (hf : IsBirationalMorphism f) (hg : IsBirationalMorphism g)
    {K : Divisor Y} {K' : Divisor Y'} {m m' : ℕ} (hK : K.IsCanonicalDivisor sY m)
    (hK' : K'.IsCanonicalDivisor sY' m') {Γ : RDivisor Y} {Γ' : RDivisor Y'}
    (hcomp : RationalMap.transformDivisor (X := Y) f.toRationalMap Γ =
      RationalMap.transformDivisor (X := Y') g.toRationalMap Γ')
    (hKΓ : IsCartierCombination (logCanonicalDivisor K Γ))
    (hKΓ' : IsCartierCombination (logCanonicalDivisor K' Γ'))
    (hanti : IsRelativelyNef ℂ sY f (-logCanonicalDivisor K Γ))
    (hnef : IsRelativelyNef ℂ sY' g (logCanonicalDivisor K' Γ'))
    {r : V ⟶ Y} {r' : V ⟶ Y'} [IsProper r] [IsProper r'] (hrr : r ≫ f = r' ≫ g)
    (hV : IsNormalVariety ℂ (r ≫ sY)) (hV' : IsNormalVariety ℂ (r' ≫ sY'))
    (hr : IsBirationalMorphism r) (hr' : IsBirationalMorphism r') (Q : MMP.Mori.PrimeDivisor V)
    {n n' : ℕ} {a a' : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sY n Γ ⟨V, r, hV, hr, Q⟩ a)
    (ha' : MMP.Intersection.IsLogDiscrepancy sY' n' Γ' ⟨V, r', hV', hr', Q⟩ a') :
    a ≤ a' := by
  classical
  subst hfs hgs
  haveI : IsDominant f := hf.isDominant
  haveI : IsDominant g := hg.isDominant
  haveI : IsDominant r := hr.isDominant
  haveI : IsDominant r' := hr'.isDominant
  have := hT.1
  haveI : MMP.Mori.IsVariety ℂ (f ≫ sT) := hY.1
  haveI : MMP.Mori.IsVariety ℂ (g ≫ sT) := hY'.1
  -- a canonical divisor and a top form on `T`
  have hdimT : topologicalKrullDim T = m := by
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sT (f ≫ sT) hf]
    exact hK.topologicalKrullDim_eq
  have hmm : m' = m := by
    have h1 := hK'.topologicalKrullDim_eq
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sT (g ≫ sT) hg,
      hdimT] at h1
    exact_mod_cast h1.symm
  subst hmm
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace sT
  haveI : LocallyOfFiniteType (f ≫ sT) := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (g ≫ sT) := hY'.1.toLocallyOfFiniteType
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isNormalVariety sT hT hdimT
  have hKT : Divisor.IsCanonicalDivisor sT m'
      (RationalMap.transformDivisor (X := Y) f.toRationalMap K) :=
    MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hT hY hf hK₀ hK
  obtain ⟨ω, hω0, hωT, hωY⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hT hY hf hKT hK rfl
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sT) hdimT
  have hω'0 : pullbackRationalPluriForms sT g ω ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' g
      hg.functionFieldMap_bijective hd hω0
  have hωf0 : pullbackRationalPluriForms sT f ω ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' f
      hf.functionFieldMap_bijective hd hω0
  have hK'' : (divisorOfForm (pullbackRationalPluriForms sT g ω)).LinearlyEquivalent K' := by
    have := MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hY' hK' hω'0
    simpa using this
  have hK''c : (divisorOfForm (pullbackRationalPluriForms sT g ω)).IsCanonicalDivisor
      (g ≫ sT) m' := hK'.of_linearlyEquivalent hK''
  -- the divisors over `Y`, `Y'` and `T`
  let E : ProperDivisorOver ℂ (f ≫ sT) :=
    { toDivisorOver := ⟨V, r, hV, hr, Q⟩, isProper := inferInstance }
  let E' : ProperDivisorOver ℂ (g ≫ sT) :=
    { toDivisorOver := ⟨V, r', hV', hr', Q⟩, isProper := inferInstance }
  have hval : E'.valuation.comap (functionFieldMap g) =
      Q.divisorialValuation.comap (functionFieldMap (r' ≫ g)) := by
    refine Valuation.ext fun t => ?_
    change Q.divisorialValuation (functionFieldMap r' (functionFieldMap g t)) = _
    rw [MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply r' g rfl]
    try rfl
  have hval' : E.valuation.comap (functionFieldMap f) =
      Q.divisorialValuation.comap (functionFieldMap (r ≫ f)) := by
    refine Valuation.ext fun t => ?_
    change Q.divisorialValuation (functionFieldMap r (functionFieldMap f t)) = _
    rw [MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply r f rfl]
    try rfl
  have hrgb : IsBirationalMorphism (r' ≫ g) := MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hr' hg
  let ET : ProperDivisorOver ℂ sT :=
    { toDivisorOver := ⟨V, r' ≫ g, by rwa [Category.assoc], hrgb, Q⟩,
      isProper := inferInstance }
  have hvT : HasNonemptyCenter ℂ sT (E'.valuation.comap (functionFieldMap g)) := by
    rw [hval]
    exact hasNonemptyCenter_valuation' ET
  have hv : E.valuation.comap (functionFieldMap f) = E'.valuation.comap (functionFieldMap g) := by
    refine Valuation.ext fun t => ?_
    change Q.divisorialValuation (functionFieldMap r (functionFieldMap f t)) =
      Q.divisorialValuation (functionFieldMap r' (functionFieldMap g t))
    rw [MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply r f hrr,
      MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply r' g rfl]
  -- the adjoints with the compatible canonical divisors
  have hKΓf : IsCartierCombination
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sT f ω)) + Γ) := by
    rw [hωY]; exact hKΓ
  have hKΓg : IsCartierCombination
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sT g ω)) + Γ') := by
    obtain ⟨φ, hφ⟩ := hK''
    have hP : IsCartierCombination (Divisor.toRDivisor (principalDivisor φ)) :=
      ⟨1, ![1], ![principalDivisor φ], fun j => by
        fin_cases j; exact Divisor.isCartier_principalDivisor φ, by simp; rfl⟩
    have := isCartierCombination_add hKΓ' hP
    convert this using 1
    rw [logCanonicalDivisor, ← hφ, map_sub]
    abel
  have hanti' : IsRelativelyNef ℂ (f ≫ sT) f
      (-logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sT f ω)) Γ) := by
    rw [hωY]; exact hanti
  have hnef' : IsRelativelyNef ℂ (g ≫ sT) g
      (logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sT g ω)) Γ') :=
    isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hK'' hnef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  have hn' := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha'
  obtain rfl : n = m' := by exact_mod_cast hn.symm.trans hK.topologicalKrullDim_eq
  obtain rfl : n' = n := by exact_mod_cast hn'.symm.trans hK'.topologicalKrullDim_eq
  exact isLogDiscrepancy_le_of_isRelativelyNef' hT hY hY' hf hg hωf0 hω'0
    (by rw [hωY]; exact hK) hK''c hcomp hKΓf hKΓg hanti' hnef' E E' hvT hv ha ha'

/-- **Log discrepancies increase strictly over the exceptional divisor of a divisorial
contraction, on a common model.** Let `f : Y ⟶ Y'` be a birational contraction of normal varieties
whose exceptional set is a prime divisor `E`, with `-(K_Y + Γ)` `f`-ample and `Γ' = f_* Γ`. For
proper birational `r : V ⟶ Y`, `r' = r ≫ f` and a prime divisor `Q` of `V` lying over the generic
point of `E`, `a(Q; Y, Γ) < a(Q; Y', Γ')`. -/
private theorem isLogDiscrepancy_lt_of_isBirationalContraction {V Y Y' : Scheme.{0}}
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y'] [CompactSpace Y']
    {sY' : Y' ⟶ Spec (.of ℂ)} [QuasiCompact sY'] [LocallyOfFiniteType sY']
    (hY' : IsNormalVariety ℂ sY') {f : Y ⟶ Y'} [IsProper f] {sY : Y ⟶ Spec (.of ℂ)}
    (hfs : f ≫ sY' = sY)
    (hY : IsNormalVariety ℂ sY) (hf : IsBirationalContraction ℂ sY' sY f)
    {E : MMP.Mori.PrimeDivisor Y} (hE : MMP.Flips.exceptionalSet f = E.support)
    {K : Divisor Y} {K' : Divisor Y'} {m m' : ℕ} (hK : K.IsCanonicalDivisor sY m)
    (hK' : K'.IsCanonicalDivisor sY' m') {Γ : RDivisor Y} {Γ' : RDivisor Y'}
    (hcomp : RationalMap.transformDivisor (X := Y) f.toRationalMap Γ = Γ')
    (hKΓ : IsCartierCombination (logCanonicalDivisor K Γ))
    (hKΓ' : IsCartierCombination (logCanonicalDivisor K' Γ'))
    (hanti : IsRelativelyAntiAmple f (logCanonicalDivisor K Γ))
    {r : V ⟶ Y} {r' : V ⟶ Y'} [IsProper r] [IsProper r'] (hrr : r ≫ f = r')
    (hV : IsNormalVariety ℂ (r ≫ sY)) (hV' : IsNormalVariety ℂ (r' ≫ sY'))
    (hr : IsBirationalMorphism r) (hr' : IsBirationalMorphism r') (Q : MMP.Mori.PrimeDivisor V)
    (hQ : r Q.genericPoint = E.genericPoint) {n n' : ℕ} {a a' : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sY n Γ ⟨V, r, hV, hr, Q⟩ a)
    (ha' : MMP.Intersection.IsLogDiscrepancy sY' n' Γ' ⟨V, r', hV', hr', Q⟩ a') : a < a' := by
  classical
  subst hfs
  have hfb : IsBirationalMorphism f := hf.surjective_and_isBirational.2
  haveI : IsDominant f := hfb.isDominant
  haveI : IsDominant r := hr.isDominant
  haveI : IsDominant r' := hr'.isDominant
  haveI : MMP.Mori.IsVariety ℂ sY' := hY'.1
  haveI : MMP.Mori.IsVariety ℂ (f ≫ sY') := hY.1
  haveI : LocallyOfFiniteType (f ≫ sY') := hY.1.toLocallyOfFiniteType
  have hdim : topologicalKrullDim Y' = m := by
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY' (f ≫ sY') hfb]
    exact hK.topologicalKrullDim_eq
  have hmm : m' = m := by exact_mod_cast (hK'.topologicalKrullDim_eq.symm.trans hdim)
  subst hmm
  have hKT : Divisor.IsCanonicalDivisor sY' m'
      (RationalMap.transformDivisor (X := Y) f.toRationalMap K) :=
    MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hY' hY hfb hK' hK
  obtain ⟨ω, hω0, hωT, hωY⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hY' hY hfb hKT hK rfl
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY') hdim
  have hωf0 : pullbackRationalPluriForms sY' f ω ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' f
      hfb.functionFieldMap_bijective hd hω0
  -- `K_{Y'} + Γ'`, with the canonical divisor compatible with `K`, is `ℝ`-Cartier
  have hKK : Divisor.LinearlyEquivalent
      (RationalMap.transformDivisor (X := Y) f.toRationalMap K) K' :=
    MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sY' hY' hKT hK'
  have hKDY : IsCartierCombination (logCanonicalDivisor (divisorOfForm ω) Γ') := by
    rw [hωT]
    obtain ⟨φ, hφ⟩ := hKK
    have hP : IsCartierCombination (Divisor.toRDivisor (MMP.Mori.principalDivisor φ)) :=
      ⟨1, ![1], ![MMP.Mori.principalDivisor φ], fun j => by
        fin_cases j; exact Divisor.isCartier_principalDivisor φ, by simp; rfl⟩
    have := isCartierCombination_add hKΓ' hP
    convert this using 1
    rw [logCanonicalDivisor, logCanonicalDivisor, ← hφ, map_sub]
    abel
  -- the divisors over `Y` and `Y'`
  let Bv : ProperDivisorOver ℂ (f ≫ sY') :=
    { toDivisorOver := ⟨V, r, hV, hr, Q⟩, isProper := inferInstance }
  let E' : ProperDivisorOver ℂ sY' :=
    { toDivisorOver := ⟨V, r', hV', hr', Q⟩, isProper := inferInstance }
  have hv : Bv.valuation.comap (functionFieldMap f) = E'.valuation := by
    refine Valuation.ext fun t => ?_
    change Q.divisorialValuation (functionFieldMap r (functionFieldMap f t)) =
      Q.divisorialValuation (functionFieldMap r' t)
    rw [MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply r f hrr]
  have hvY := hasNonemptyCenter_valuation' E'
  obtain ⟨b, hb⟩ := exists_isDiscrepancy_of_properDivisorOver hY hωf0 (by rw [hωY]; exact hK)
    (by rw [hωY]; exact hKΓ) Bv
  obtain ⟨b', hb'⟩ := exists_isDiscrepancy_of_properDivisorOver hY' hω0 (by rw [hωT]; exact hKT)
    hKDY E'
  rw [hωY] at hb
  have hcenter : (Bv.center : Set Y) ⊆ E.support := by
    rw [ProperDivisorOver.coe_center]
    rintro _ ⟨x, hx, rfl⟩
    change x ∈ (Q.support : Set V) at hx
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hx
    have hQ' : AlgebraicGeometry.PrimeDivisor.genericPoint E =
        r (AlgebraicGeometry.PrimeDivisor.genericPoint Q) := hQ.symm
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, hQ']
    exact specializes_iff_mem_closure.mp ((specializes_iff_mem_closure.mpr hx).map r.continuous)
  have hlt := (MMP.Flips.IsBirationalContraction.isDiscrepancy_lt_iff_center_subset hY' hY hf hE
    rfl hωY hKΓ hanti hcomp hKDY hvY hv (Bv := Bv) rfl hb hb').mpr hcenter
  have h1 := MMP.Fourfold.isLogDiscrepancy_of_isDiscrepancy hb Bv.toDivisorOver Bv.isProper rfl
  have h2 := MMP.Fourfold.isLogDiscrepancy_of_isDiscrepancy hb' E'.toDivisorOver E'.isProper rfl
  rw [MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1,
    MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha' h2]
  linarith

end StepComparison

section Criterion

open MMP.Mori

variable {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
  {sY : Y ⟶ Spec (.of ℂ)} {πY : Y ⟶ Z}

/-- A birational map over a separated base `Z` is represented by a partial isomorphism over
`Z`. -/
private theorem PartialIso.isOver_base {ψ : X.RationalMap Y} (hψZ : RationalMap.IsOver π πY ψ)
    [IsSeparated (Z ↘ ⊤_ Scheme)] (e : X.PartialIso Y) (he : e.toRationalMap = ψ) :
    e.IsOver π πY := by
  letI : X.Over Z := ⟨π⟩
  letI : Y.Over Z := ⟨πY⟩
  haveI : Z.IsSeparated := ⟨by
    rw [show Limits.terminal.from Z = (Z ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  have h2 : e.toPartialMap.toRationalMap.IsOver Z := by
    rw [Scheme.RationalMap.isOver_iff]
    change e.toRationalMap.compHom πY = π.toRationalMap
    rw [he]; exact hψZ
  have h3 := Scheme.PartialMap.isOver_toRationalMap_iff_of_isSeparated.mp h2
  exact h3.1

/-- A birational map over `Z` between varieties over `ℂ` is represented by a partial isomorphism
over `ℂ`. -/
private theorem PartialIso.isOver_of_isOver {ψ : X.RationalMap Y} (hψZ : RationalMap.IsOver π πY ψ)
    (hπ : π ≫ sZ = sX) (hπY : πY ≫ sZ = sY) (e : X.PartialIso Y) (he : e.toRationalMap = ψ) :
    e.IsOver sX sY := by
  letI : X.Over (Spec (.of ℂ)) := ⟨sX⟩
  letI : Y.Over (Spec (.of ℂ)) := ⟨sY⟩
  have h1 : ψ.compHom sY = sX.toRationalMap := by
    refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
    rw [MMP.Flips.RationalMap.fromFunctionField_compHom, ← hπY, ← Category.assoc,
      ← MMP.Flips.RationalMap.fromFunctionField_compHom, hψZ, ← hπ, MMP.Flips.RationalMap.fromFunctionField_hom,
      MMP.Flips.RationalMap.fromFunctionField_hom, Category.assoc]
  have h2 : e.toPartialMap.toRationalMap.IsOver (Spec (.of ℂ)) := by
    rw [Scheme.RationalMap.isOver_iff]
    change e.toRationalMap.compHom sY = sX.toRationalMap
    rw [he]; exact h1
  have h3 := Scheme.PartialMap.isOver_toRationalMap_iff_of_isSeparated.mp h2
  exact h3.1

/-- The empty open subscheme has a single closed subset. -/
private theorem closeds_bot_eq {T : Scheme.{0}}
    (a b : TopologicalSpace.Closeds (Scheme.Opens.toScheme (⊥ : T.Opens))) : a = b := by
  haveI : IsEmpty (Scheme.Opens.toScheme (⊥ : T.Opens)) := ⟨fun x => x.2⟩
  exact TopologicalSpace.Closeds.ext (Subsingleton.elim _ _)

/-- A partial isomorphism over a base, composed with a structure morphism of the base, is over
the composites. -/
private theorem PartialIso.IsOver.comp_right {A B S S' : Scheme.{0}} {e : A.PartialIso B}
    {sA : A ⟶ S} {sB : B ⟶ S} (he : e.IsOver sA sB) (t : S ⟶ S') :
    e.IsOver (sA ≫ t) (sB ≫ t) := by
  change e.iso.hom ≫ e.target.ι ≫ sB ≫ t = e.source.ι ≫ sA ≫ t
  rw [← Category.assoc e.target.ι, ← Category.assoc e.iso.hom, he, Category.assoc]

/-- A birational morphism is represented by a partial isomorphism over any separated base. -/
private theorem exists_partialIso_isOver_of_isBirationalMorphism {A B S : Scheme.{0}}
    [IsReduced A] [IsSeparated (S ↘ ⊤_ Scheme)] {r : A ⟶ B} (hr : IsBirationalMorphism r)
    (t : B ⟶ S) :
    ∃ e : A.PartialIso B, e.toRationalMap = r.toRationalMap ∧ e.IsOver (r ≫ t) t := by
  obtain ⟨e, he⟩ := hr
  exact ⟨e, he, MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq e r t he⟩

/-- **A common resolution of a birational map.** A birational map `e : X ⤏ Y` over `ℂ` between
normal projective varieties is resolved by a smooth projective variety `W` with projective
birational morphisms `p : W ⟶ X`, `q : W ⟶ Y` such that `q ∘ p⁻¹ = e`. -/
private theorem exists_commonResolution (hXn : IsNormalVariety ℂ sX) (hYn : IsNormalVariety ℂ sY)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) (hYp : MMP.Mori.IsProjectiveVariety ℂ sY)
    (e : X.PartialIso Y) (he : e.IsOver sX sY) :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (p : W ⟶ X) (q : W ⟶ Y) (h : X.RationalMap W),
      MMP.Mori.IsVariety ℂ (p ≫ sX) ∧ IsSmoothScheme (p ≫ sX) ∧ q ≫ sY = p ≫ sX ∧
      IsProjectiveMorphism p ∧ IsProjectiveMorphism q ∧ IsBirationalMorphism p ∧
      IsBirationalMorphism q ∧ RationalMap.IsInverse p.toRationalMap h ∧
      h.compHom q = e.toRationalMap ∧
      (p ⁻¹ᵁ e.source).ι ≫ q = (p ∣_ e.source) ≫ e.iso.hom ≫ e.target.ι := by
  classical
  have := hXn.1
  have := hYn.1
  have hX0 : MMP.Flips.IsBoundary (QDivisor.toRDivisor (0 : QDivisor X)) := fun E => by simp
  have hY0 : MMP.Flips.IsBoundary (QDivisor.toRDivisor (0 : QDivisor Y)) := fun E => by simp
  obtain ⟨W, p, q, hpres, hpproj, hqres, hqproj, hcomm, -, -⟩ :=
    MMP.Flips.exists_isLogResolution_isIso_restrict_of_partialIso sX sY hXn hYn hXp.isProjective
      hYp.isProjective 0 0 hX0 hY0 e he ⊥ ⊥ bot_le bot_le (by ext x; simp)
      (by rw [IsSmoothScheme, eq_top_iff]; intro x _; exact absurd x.2 (by simp)) (Or.inl (closeds_bot_eq _ _)) (Or.inl (closeds_bot_eq _ _)) (Or.inl (closeds_bot_eq _ _))
  obtain ⟨-, hWv, hWsm, hpP, hpb, -⟩ := hpres
  obtain ⟨-, -, -, hqP, hqb, -⟩ := hqres
  haveI : IsIntegral W := hWv.toIsIntegral
  haveI : LocallyOfFiniteType (p ≫ sX) := hWv.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (p ≫ sX)
  haveI : IsNormal W :=
    isNormal_of_isRegular W (MMP.Threefold.Resolution.isRegular_of_isSmoothScheme hWsm)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hpd : IsDominant p := hpb.isDominant
  have hηs : genericPoint X ∈ e.source :=
    (genericPoint_specializes _).mem_open e.source.2 e.dense_source.nonempty.choose_spec
  have hU : Dense ((p ⁻¹ᵁ e.source : W.Opens) : Set W) := by
    refine (p ⁻¹ᵁ e.source).isOpen.dense ⟨genericPoint W, ?_⟩
    change p (genericPoint W) ∈ e.source
    rw [map_genericPoint_of_isDominant]
    exact hηs
  haveI := AlgebraicGeometry.Opens.isDominant_ι hU
  -- the two structure morphisms of `W` agree
  have hsq : q ≫ sY = p ≫ sX := by
    refine ext_of_isDominant (ι := (p ⁻¹ᵁ e.source).ι) ?_
    rw [← Category.assoc, hcomm, Category.assoc, Category.assoc, he, ← Category.assoc,
      morphismRestrict_ι, Category.assoc]
  -- the inverse of `p`
  obtain ⟨ep, hep⟩ := hpb
  have hp1 : ep.source.ι ≫ p = ep.iso.hom ≫ ep.target.ι :=
    ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp hep)).symm
  refine ⟨W, inferInstance, inferInstance, inferInstance, p, q, ep.symm.toRationalMap, hWv, hWsm,
    hsq, hpproj, hqproj, ⟨ep, hep⟩, hqb, ⟨ep, hep, rfl⟩, ?_, hcomm⟩
  -- `q ∘ p⁻¹ = e`, checked at the generic point
  have hηt : genericPoint X ∈ ep.target :=
    (genericPoint_specializes _).mem_open ep.target.2 ep.dense_target.nonempty.choose_spec
  set ξ : Spec X.functionField ⟶ W :=
    ep.target.fromSpecStalkOfMem (genericPoint X) hηt ≫ ep.iso.inv ≫ ep.source.ι with hξ
  have hξp : ξ ≫ p = X.fromSpecStalk (genericPoint X) := by
    rw [hξ, Category.assoc, Category.assoc, hp1, Iso.inv_hom_id_assoc,
      Scheme.Opens.fromSpecStalkOfMem_ι]
  have hrange : Set.range ξ.base ⊆ Set.range (p ⁻¹ᵁ e.source).ι.base := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    change p (ξ.base z) ∈ e.source
    have h1 : p (ξ.base z) = (X.fromSpecStalk (genericPoint X)).base z := by
      rw [← hξp]; rfl
    have h2 : (X.fromSpecStalk (genericPoint X)).base z ⤳ genericPoint X := by
      have : (X.fromSpecStalk (genericPoint X)).base z ∈
          Set.range (X.fromSpecStalk (genericPoint X)).base := ⟨z, rfl⟩
      rwa [Scheme.range_fromSpecStalk] at this
    have h3 := h2.antisymm (genericPoint_specializes _)
    rw [h1, h3.eq]
    exact hηs
  set l := IsOpenImmersion.lift (p ⁻¹ᵁ e.source).ι ξ hrange with hl
  have hlξ : l ≫ (p ⁻¹ᵁ e.source).ι = ξ := IsOpenImmersion.lift_fac _ _ _
  have hlp : l ≫ (p ∣_ e.source) = e.source.fromSpecStalkOfMem (genericPoint X) hηs := by
    rw [← cancel_mono e.source.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hlξ, hξp,
      Scheme.Opens.fromSpecStalkOfMem_ι]
  refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
  rw [MMP.Flips.RationalMap.fromFunctionField_compHom]
  change ξ ≫ q = e.source.fromSpecStalkOfMem (genericPoint X) hηs ≫ e.iso.hom ≫ e.target.ι
  rw [← hlξ, Category.assoc, hcomm, ← Category.assoc, hlp]

open Classical in
/-- **A nef dlt model not worsening any contracted prime is a nef log birational model**, on a
given common resolution. Let `(X, Δ)` be an lc pair with `X` projective and `ℚ`-factorial over
`Z`, `ψ : X ⤏ Y` a birational map over `Z` to a normal projective `ℚ`-factorial variety `Y` with a
dlt boundary `Δ_Y = ψ_* Δ + ∑ F` (`F` exceptional over `X`) such that `K_Y + Δ_Y` is nef over
`Z`, and `p : W ⟶ X`, `q : W ⟶ Y` a smooth projective common resolution with `q ∘ p⁻¹ = ψ`. If
`1 - mult_P Δ ≤ a(P_W; Y, Δ_Y)` for the strict transform `P_W` of every prime divisor `P` of `X`
contracted by `ψ`, then `ψ` is a nef log birational model of `(X/Z, Δ)`, compared on `W`, and the
comparison along `P_W` is `a(P_W; Y, Δ_Y) - (1 - mult_P Δ)`. -/
private theorem exists_isNefLogBirationalModel_of_resolution
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    {KX : Divisor X} (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m) {Δ : RDivisor X}
    (hlc : IsRealLcPair sX Δ)
    (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (hYQ : IsQFactorial sY) (hπY : πY ≫ sZ = sY)
    {KY : Divisor Y} (hKY : ∃ m : ℕ, KY.IsCanonicalDivisor sY m) {ΔY : RDivisor Y}
    (hdlt : IsRealDltPair sY ΔY)
    (hnef : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY ΔY))
    {ψ : X.RationalMap Y} (hψ : RationalMap.IsBirational ψ) (hψZ : RationalMap.IsOver π πY ψ)
    (hΔY : ∀ F, ΔY.coeff F = (RationalMap.transformDivisor ψ Δ).coeff F +
      if RationalMap.IsInverseExceptional ψ F then 1 else 0)
    {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] {p : W ⟶ X}
    {q : W ⟶ Y} {h : X.RationalMap W} (hWv : MMP.Mori.IsVariety ℂ (p ≫ sX))
    (hWsm : IsSmoothScheme (p ≫ sX)) (hsq : q ≫ sY = p ≫ sX) (hpproj : IsProjectiveMorphism p)
    (hqproj : IsProjectiveMorphism q) (hpb : IsBirationalMorphism p)
    (hqb : IsBirationalMorphism q) (hinv : RationalMap.IsInverse p.toRationalMap h)
    (hcomp : h.compHom q = ψ) (hpq : p ≫ π = q ≫ πY)
    (hle : ∀ P, RationalMap.IsExceptional ψ P → ∀ PW : MMP.Mori.PrimeDivisor W,
      p PW.genericPoint = P.genericPoint → ∀ (hWnq : IsNormalVariety ℂ (q ≫ sY)) (n : ℕ) (a' : ℝ),
        MMP.Intersection.IsLogDiscrepancy sY n ΔY ⟨W, q, hWnq, hqb, PW⟩ a' → 1 - Δ.coeff P ≤ a') :
    ∃ (KY' : Divisor Y) (GX GY : RDivisor W),
      IsLogComparisonResolution sX sY (p ≫ sX) ψ KX Δ KY' ΔY p q h GX GY ∧
      IsNefLogBirationalModel sX sY sZ π πY KX Δ KY' ΔY ψ ∧
      ∀ P, RationalMap.IsExceptional ψ P → ∀ PW : MMP.Mori.PrimeDivisor W,
        p PW.genericPoint = P.genericPoint → ∃ (hWnq : IsNormalVariety ℂ (q ≫ sY)) (n : ℕ) (a' : ℝ),
          MMP.Intersection.IsLogDiscrepancy sY n ΔY ⟨W, q, hWnq, hqb, PW⟩ a' ∧
            (GX - GY).coeff PW = a' - (1 - Δ.coeff P) := by
  classical
  have hXn : IsNormalVariety ℂ sX := hlc.1
  have hYn : IsNormalVariety ℂ sY := hYQ.1
  have := hXn.1
  have := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  haveI : X.IsSeparated := ⟨by
    rw [show Limits.terminal.from X = (X ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  haveI := isProper_of_isProjectiveMorphism p hpproj
  haveI := isProper_of_isProjectiveMorphism q hqproj
  haveI : IsDominant p := hpb.isDominant
  haveI : IsDominant q := hqb.isDominant
  have hWnp : IsNormalVariety ℂ (p ≫ sX) := ⟨hWv, inferInstance⟩
  have hWnq : IsNormalVariety ℂ (q ≫ sY) := hsq ▸ hWnp
  haveI : LocallyOfFiniteType (p ≫ sX) := hWv.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q ≫ sY) := hsq ▸ hWv.toLocallyOfFiniteType
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hWnp
  haveI : IsSeparated p := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  haveI : IsSeparated q := IsSeparated.of_comp q (Y ↘ ⊤_ Scheme)
  have hpbij := hpb.functionFieldMap_bijective
  have hqbij := hqb.functionFieldMap_bijective
  -- compatible canonical divisors `K_W`, `K_Y' = q_* K_W` and forms
  obtain ⟨m, hm⟩ := hKX
  have hdimW : topologicalKrullDim W = m := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hpb]
    exact hm.topologicalKrullDim_eq
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isNormalVariety (p ≫ sX) hWnp hdimW
  obtain ⟨KW, hKW, hKWX⟩ :=
    MMP.Fourfold.Oai4C1.Main.exists_isCanonicalDivisor_transformDivisor_eq hXn hWnp hpb hm hK₀
  have hKWq : KW.IsCanonicalDivisor (q ≫ sY) m := hsq ▸ hKW
  haveI : MMP.Mori.IsVariety ℂ (q ≫ sY) := hWnq.1
  have hdimY : topologicalKrullDim Y = m := by
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q ≫ sY) hqb,
      hdimW]
  obtain ⟨mY, hmY⟩ := hKY
  have hmYm : m = mY := by
    exact_mod_cast (hmY.topologicalKrullDim_eq.symm.trans hdimY).symm
  subst hmYm
  set KY' : Divisor Y := RationalMap.transformDivisor (X := W) q.toRationalMap KW with hKY'
  haveI : MMP.Mori.IsVariety ℂ (q ≫ sY) := hWnq.1
  have hKY'c : KY'.IsCanonicalDivisor sY m :=
    MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hYn hWnq hqb hmY hKWq
  obtain ⟨ω, hω0, hωX, hωW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hXn hWnp hpb hm hKW hKWX
  obtain ⟨ωY, hωY0, hωYY, hωYW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hWnq hqb hKY'c hKWq rfl
  -- the pull-backs of the adjoints
  obtain ⟨GX, hGX, -⟩ := MMP.Flips.existsUnique_isRCartierPullback p
    (isCartierCombination_of_isQFactorial hXQ (logCanonicalDivisor KX Δ))
  obtain ⟨GY, hGY, -⟩ := MMP.Flips.existsUnique_isRCartierPullback q
    (isCartierCombination_of_isQFactorial hYQ (logCanonicalDivisor KY' ΔY))
  -- log discrepancies along the prime divisors of `W`
  have haX : ∀ E : MMP.Mori.PrimeDivisor W, MMP.Intersection.IsLogDiscrepancy sX m Δ
      (⟨W, p, hWnp, hpb, E⟩ : DivisorOver ℂ sX) (1 + (KW.coeff E : ℝ) - GX.coeff E) := by
    intro E
    have := isLogDiscrepancy_of_isRCartierPullback (k := ℂ) hXn hWnp hpb hω0
      (by rw [hωX]; exact hm) (Δ := Δ) (G := GX) (by rw [hωX]; exact hGX) E
    rwa [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωW] at this
  have haY : ∀ E : MMP.Mori.PrimeDivisor W, MMP.Intersection.IsLogDiscrepancy sY m ΔY
      (⟨W, q, hWnq, hqb, E⟩ : DivisorOver ℂ sY) (1 + (KW.coeff E : ℝ) - GY.coeff E) := by
    intro E
    have := isLogDiscrepancy_of_isRCartierPullback (k := ℂ) hYn hWnq hqb hωY0
      (by rw [hωYY]; exact hKY'c) (Δ := ΔY) (G := GY) (by rw [hωYY]; exact hGY) E
    rwa [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωYW] at this
  have hdiff : ∀ E : MMP.Mori.PrimeDivisor W,
      (GX - GY).coeff E = (1 + (KW.coeff E : ℝ) - GY.coeff E) -
        (1 + (KW.coeff E : ℝ) - GX.coeff E) := fun E => by
    change GX.coeff E - GY.coeff E = _
    ring
  -- strict transforms of prime divisors of `X` and their images on `Y`
  have hPW : ∀ P : MMP.Mori.PrimeDivisor X, ∃ PW : MMP.Mori.PrimeDivisor W,
      p PW.genericPoint = P.genericPoint ∧ (KW.coeff PW : ℝ) = KX.coeff P ∧
        GX.coeff PW = KX.coeff P + Δ.coeff P := by
    intro P
    obtain ⟨PW, hη, hiso, htr⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hXn hWnp hpb P
    refine ⟨PW, hη, ?_, ?_⟩
    · have := htr KW
      rw [hKWX] at this
      exact_mod_cast this.symm
    · rw [coeff_eq_of_isRCartierPullback hGX PW P hη]
      simp [logCanonicalDivisor]
  have hψP : ∀ (P : MMP.Mori.PrimeDivisor X) (PW : MMP.Mori.PrimeDivisor W),
      p PW.genericPoint = P.genericPoint →
        RationalMap.transformPrimeDivisor h P = some PW ∧
        RationalMap.transformPrimeDivisor ψ P =
          RationalMap.transformPrimeDivisor (X := W) q.toRationalMap PW ∧
        (RationalMap.IsExceptional ψ P ↔ RationalMap.IsExceptional (X := W) q.toRationalMap PW) :=
    fun P PW hη => by
      have h1 := transformPrimeDivisor_eq_some_of_isInverse hpbij hinv hη
      exact ⟨h1, hcomp ▸ transformPrimeDivisor_compHom h1 q, hcomp ▸ isExceptional_compHom_iff h1 q⟩
  have hqF : ∀ (Q : MMP.Mori.PrimeDivisor W) (F : MMP.Mori.PrimeDivisor Y),
      q Q.genericPoint = F.genericPoint →
        (KY'.coeff F : ℝ) = KW.coeff Q ∧ GY.coeff Q = KY'.coeff F + ΔY.coeff F := by
    intro Q F hη
    haveI := isIso_stalkMap_of_map_eq_genericPoint q hqbij hη
    obtain ⟨FW, hFη, -, htrF⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hYn hWnq hqb F
    have hFQ : FW = Q :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective (eq_of_map_eq_genericPoint q hqbij hFη hη)
    subst hFQ
    refine ⟨?_, ?_⟩
    · have := htrF KW
      exact_mod_cast this
    · rw [coeff_eq_of_isRCartierPullback hGY FW F hη]
      simp [logCanonicalDivisor]
  -- the comparison vanishes along the strict transforms of non-contracted primes
  have hzero : ∀ (P : MMP.Mori.PrimeDivisor X) (PW : MMP.Mori.PrimeDivisor W)
      (F : MMP.Mori.PrimeDivisor Y), p PW.genericPoint = P.genericPoint →
        q PW.genericPoint = F.genericPoint → (GX - GY).coeff PW = 0 := by
    intro P PW F hη hηF
    obtain ⟨PW', hη', hKP, hGP⟩ := hPW P
    obtain rfl : PW = PW' :=
      (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (eq_of_map_eq_genericPoint p hpbij hη' hη)).symm
    obtain ⟨hKF, hGF⟩ := hqF PW F hηF
    obtain ⟨-, htrψ, -⟩ := hψP P PW hη
    have hψPF : RationalMap.transformPrimeDivisor ψ P = some F := by
      rw [htrψ]
      exact (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff q PW F).mpr hηF
    have huniq : ∀ P', RationalMap.transformPrimeDivisor ψ P' = some F → P' = P := by
      intro P' hP'
      obtain ⟨P'W, hη'', -, -⟩ := hPW P'
      obtain ⟨-, htr', -⟩ := hψP P' P'W hη''
      rw [htr'] at hP'
      have h1 := (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff q P'W F).mp hP'
      obtain rfl : P'W = PW :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective (eq_of_map_eq_genericPoint q hqbij h1 hηF)
      exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hη''.symm.trans hη)
    have hΔF : ΔY.coeff F = Δ.coeff P := by
      rw [hΔY F, if_neg (fun hF => hF P hψPF), add_zero]
      exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hψPF huniq Δ
    change GX.coeff PW - GY.coeff PW = 0
    rw [hGP, hGF, hΔF, hKF, hKP]
    ring
  -- the comparison along the strict transforms of contracted primes
  have hform : ∀ (P : MMP.Mori.PrimeDivisor X), RationalMap.IsExceptional ψ P →
      ∀ PW : MMP.Mori.PrimeDivisor W, p PW.genericPoint = P.genericPoint →
        (GX - GY).coeff PW = (1 + (KW.coeff PW : ℝ) - GY.coeff PW) - (1 - Δ.coeff P) := by
    intro P hP PW hη
    obtain ⟨PW', hη', hKP, hGP⟩ := hPW P
    obtain rfl : PW = PW' :=
      (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (eq_of_map_eq_genericPoint p hpbij hη' hη)).symm
    rw [hdiff PW, hKP, hGP]
    ring
  have hpos : ∀ (P : MMP.Mori.PrimeDivisor X), RationalMap.IsExceptional ψ P →
      ∀ PW : MMP.Mori.PrimeDivisor W, p PW.genericPoint = P.genericPoint →
        0 ≤ (GX - GY).coeff PW := by
    intro P hP PW hη
    have hle' := hle P hP PW hη hWnq m _ (haY PW)
    rw [hform P hP PW hη]
    linarith
  -- `W ⟶ Z` through `X` and through `Y`
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : Z.IsSeparated := ⟨by
    rw [show Limits.terminal.from Z = (Z ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  -- the comparison is effective
  have hKK : KY'.LinearlyEquivalent KY :=
    MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sY hYn hKY'c hmY
  have hnef' : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY' ΔY) :=
    isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hKK hnef
  have heff : ∀ Q, 0 ≤ (GX - GY).coeff Q := by
    have hWp : MMP.Mori.IsProjectiveVariety ℂ (p ≫ sX) :=
      (AlgebraicGeometry.isProjectiveVariety_iff ℂ (p ≫ sX)).mpr
        ⟨hWv, hpproj.comp hX.isProjective⟩
    have hpush : 0 ≤ RationalMap.transformDivisor (X := W) p.toRationalMap (GX - GY) := by
      refine Finsupp.le_def.mpr fun P => ?_
      obtain ⟨PW, hη, -, htr⟩ :=
        MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hXn hWnp hpb P
      rw [Finsupp.coe_zero, Pi.zero_apply, htr]
      by_cases hexc : RationalMap.IsExceptional ψ P
      · exact hpos P hexc PW hη
      · obtain ⟨-, -, hexcq⟩ := hψP P PW hη
        have hnq : ¬ RationalMap.IsExceptional (X := W) q.toRationalMap PW :=
          fun h' => hexc (hexcq.mpr h')
        rw [isExceptional_toRationalMap_iff_two_le_coheight] at hnq
        let EY : ProperDivisorOver ℂ sY :=
          { toDivisorOver := ⟨W, q, hWnq, hqb, PW⟩, isProper := inferInstance }
        have hEY : ¬ EY.IsExceptional := fun h' =>
          hnq (two_le_coheight_of_isExceptional EY h' hdimY)
        obtain ⟨F, -, hF, -⟩ :=
          MMP.Flips.ProperDivisorOver.exists_primeDivisor_of_not_isExceptional hYn EY hEY
        exact (hzero P PW F hη hF).ge
    have h := MMP.Fourfold.nonneg_sub_of_nonneg_transformDivisor_sub (p ≫ sX) sX sY hWnp hWp hXn hX
      hYn hY π πY p q rfl hsq hpq hpproj hpb hqproj hqb
      (isCartierCombination_of_isQFactorial hXQ (logCanonicalDivisor KX Δ)) hnef' hGX hGY hpush
    exact fun Q => Finsupp.le_def.mp h Q
  -- the comparison is exceptional over `Y`
  have hexcQ : ∀ Q, (GX - GY).coeff Q ≠ 0 → MMP.Flips.IsExceptionalPrimeDivisor sY q Q := by
    intro Q hQ
    by_contra hne
    let EQ : ProperDivisorOver ℂ sY :=
      { toDivisorOver := ⟨W, q, hWnq, hqb, Q⟩, isProper := inferInstance }
    have hEQ : ¬ EQ.IsExceptional := fun h' => hne ⟨hWnq, hqb, inferInstance, h'⟩
    obtain ⟨F, -, hF, -⟩ :=
      MMP.Flips.ProperDivisorOver.exists_primeDivisor_of_not_isExceptional hYn EQ hEQ
    by_cases hnew : MMP.Flips.RationalMap.IsInverseExceptional ψ F
    · obtain ⟨hKF, hGF⟩ := hqF Q F hF
      have hΔF : ΔY.coeff F = 1 := by
        rw [hΔY F, if_pos hnew]
        have : (RationalMap.transformDivisor ψ Δ).coeff F = 0 :=
          MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne hnew Δ
        rw [this, zero_add]
      have ha := hlc.2.2.2 m _ _ (haX Q)
      have hle : (GX - GY).coeff Q ≤ 0 := by
        rw [hdiff Q, hGF, hΔF, hKF]
        linarith
      exact hQ (le_antisymm hle (heff Q))
    · obtain ⟨P, hP⟩ : ∃ P, RationalMap.transformPrimeDivisor ψ P = some F := by
        by_contra hc
        push Not at hc
        exact hnew hc
      obtain ⟨PW, hη, -, -⟩ := hPW P
      obtain ⟨-, htr, -⟩ := hψP P PW hη
      rw [htr] at hP
      have h1 := (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff q PW F).mp hP
      obtain rfl : PW = Q :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective (eq_of_map_eq_genericPoint q hqbij h1 hF)
      exact hQ (hzero P PW F hη h1)
  -- assembling the log minimal model
  have hres : IsLogComparisonResolution sX sY (p ≫ sX) ψ KX Δ KY' ΔY p q h GX GY :=
    { isVariety := hWv
      isSmoothScheme := hWsm
      comp_eq_left := rfl
      comp_eq_right := hsq
      isProjectiveMorphism_left := hpproj
      isProjectiveMorphism_right := hqproj
      isBirationalMorphism_left := hpb
      isBirationalMorphism_right := hqb
      isInverse := hinv
      compHom_eq := hcomp
      exists_canonicalDivisor := ⟨m, KW, hKW, hKWX, rfl⟩
      isRCartierPullback_left := hGX
      isRCartierPullback_right := hGY
      effective := heff
      isExceptional := hexcQ }
  refine ⟨KY', GX, GY, hres,
    { isRealLcPair := hlc
      isCanonicalDivisor := ⟨m, hm⟩
      comp_eq := hπ
      isNormalVariety_model := hYn
      isCanonicalDivisor_model := ⟨m, hKY'c⟩
      isProjectiveVariety_model := hY
      comp_eq_model := hπY
      isQFactorial := hYQ
      isRealDltPair := hdlt
      isBirational := hψ
      isOver := hψZ
      coeff_boundary := hΔY
      isRelativelyNef := hnef'
      exists_resolution := ⟨W, inferInstance, inferInstance, inferInstance, p ≫ sX, p, q, h, GX,
        GY, hres⟩ },
    fun P hP PW hη => ⟨hWnq, m, _, haY PW, hform P hP PW hη⟩⟩

open Classical in
/-- **A nef dlt model improving every contracted prime is a log minimal model**, on a given common
resolution. Let `(X, Δ)` be an lc pair with `X` projective and `ℚ`-factorial over `Z`, `ψ : X ⤏ Y`
a birational map over `Z` to a normal projective `ℚ`-factorial variety `Y` with a dlt boundary
`Δ_Y = ψ_* Δ + ∑ F` (`F` exceptional over `X`) such that `K_Y + Δ_Y` is nef over `Z`, and
`p : W ⟶ X`, `q : W ⟶ Y` a smooth projective common resolution with `q ∘ p⁻¹ = ψ`. If
`1 - mult_P Δ < a(P_W; Y, Δ_Y)` for the strict transform `P_W` of every prime divisor `P` of `X`
contracted by `ψ`, then `ψ` is a log minimal model of `(X/Z, Δ)`. -/
private theorem exists_isRealLogMinimalModel_of_resolution
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    {KX : Divisor X} (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m) {Δ : RDivisor X}
    (hlc : IsRealLcPair sX Δ)
    (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (hYQ : IsQFactorial sY) (hπY : πY ≫ sZ = sY)
    {KY : Divisor Y} (hKY : ∃ m : ℕ, KY.IsCanonicalDivisor sY m) {ΔY : RDivisor Y}
    (hdlt : IsRealDltPair sY ΔY)
    (hnef : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY ΔY))
    {ψ : X.RationalMap Y} (hψ : RationalMap.IsBirational ψ) (hψZ : RationalMap.IsOver π πY ψ)
    (hΔY : ∀ F, ΔY.coeff F = (RationalMap.transformDivisor ψ Δ).coeff F +
      if RationalMap.IsInverseExceptional ψ F then 1 else 0)
    {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] {p : W ⟶ X}
    {q : W ⟶ Y} {h : X.RationalMap W} (hWv : MMP.Mori.IsVariety ℂ (p ≫ sX))
    (hWsm : IsSmoothScheme (p ≫ sX)) (hsq : q ≫ sY = p ≫ sX) (hpproj : IsProjectiveMorphism p)
    (hqproj : IsProjectiveMorphism q) (hpb : IsBirationalMorphism p)
    (hqb : IsBirationalMorphism q) (hinv : RationalMap.IsInverse p.toRationalMap h)
    (hcomp : h.compHom q = ψ) (hpq : p ≫ π = q ≫ πY)
    (hlt : ∀ P, RationalMap.IsExceptional ψ P → ∀ PW : MMP.Mori.PrimeDivisor W,
      p PW.genericPoint = P.genericPoint → ∀ (hWnq : IsNormalVariety ℂ (q ≫ sY)) (n : ℕ) (a' : ℝ),
        MMP.Intersection.IsLogDiscrepancy sY n ΔY ⟨W, q, hWnq, hqb, PW⟩ a' → 1 - Δ.coeff P < a') :
    ∃ KY' : Divisor Y, IsRealLogMinimalModel sX sY sZ π πY KX Δ KY' ΔY ψ := by
  classical
  obtain ⟨KY', GX, GY, hres, hN, hform⟩ := exists_isNefLogBirationalModel_of_resolution hX hXQ hZ
    hπ hKX hlc hY hYQ hπY hKY hdlt hnef hψ hψZ hΔY hWv hWsm hsq hpproj hqproj hpb hqb hinv hcomp
    hpq fun P hP PW hη hWnq n a' ha => (hlt P hP PW hη hWnq n a' ha).le
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hlc.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety
    (⟨hWv, inferInstance⟩ : IsNormalVariety ℂ (p ≫ sX))
  refine ⟨KY', { hN with
    exists_resolution_pos := ⟨W, inferInstance, inferInstance, inferInstance, p ≫ sX, p, q, h,
      GX, GY, hres, fun P hP P' hP' => ?_⟩ }⟩
  have hη := map_genericPoint_of_transformPrimeDivisor_eq_some hinv hP'
  obtain ⟨hWnq, n, a', ha, he⟩ := hform P hP P' hη
  rw [he]
  linarith [hlt P hP P' hη hWnq n a' ha]

open Classical in
/-- **A nef dlt model improving every contracted prime is a log minimal model.** Let `(X, Δ)` be
an lc pair with `X` projective and `ℚ`-factorial over `Z`, and `ψ : X ⤏ Y` a birational map over
`Z` to a normal projective `ℚ`-factorial variety `Y` with a dlt boundary `Δ_Y = ψ_* Δ + ∑ F`
(`F` exceptional over `X`) such that `K_Y + Δ_Y` is nef over `Z`. If `a(P; X, Δ) < a(P; Y, Δ_Y)`
(that is, `1 - mult_P Δ < a(P; Y, Δ_Y)`) for every prime divisor `P` of `X` contracted by `ψ`,
then `ψ` is a log minimal model of
`(X/Z, Δ)`, for a canonical divisor of `Y` compatible with `K_X`. -/
private theorem exists_isRealLogMinimalModel_of_lt
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    {KX : Divisor X} (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m) {Δ : RDivisor X}
    (hlc : IsRealLcPair sX Δ)
    (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (hYQ : IsQFactorial sY) (hπY : πY ≫ sZ = sY)
    {KY : Divisor Y} (hKY : ∃ m : ℕ, KY.IsCanonicalDivisor sY m) {ΔY : RDivisor Y}
    (hdlt : IsRealDltPair sY ΔY)
    (hnef : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY ΔY))
    {ψ : X.RationalMap Y} (hψ : RationalMap.IsBirational ψ) (hψZ : RationalMap.IsOver π πY ψ)
    (hΔY : ∀ F, ΔY.coeff F = (RationalMap.transformDivisor ψ Δ).coeff F +
      if RationalMap.IsInverseExceptional ψ F then 1 else 0)
    (hlt : ∀ P, RationalMap.IsExceptional ψ P → ∀ ψ' : Y.RationalMap X,
      RationalMap.IsInverse ψ ψ' → ∀ EY : ProperDivisorOver ℂ sY, IsRealizedOver sY ψ' P EY →
      ∀ (n : ℕ) (a' : ℝ),
        MMP.Intersection.IsLogDiscrepancy sY n ΔY EY.toDivisorOver a' → 1 - Δ.coeff P < a') :
    ∃ KY' : Divisor Y, IsRealLogMinimalModel sX sY sZ π πY KX Δ KY' ΔY ψ := by
  classical
  have hXn : IsNormalVariety ℂ sX := hlc.1
  have hYn : IsNormalVariety ℂ sY := hYQ.1
  have := hXn.1
  have := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  haveI : X.IsSeparated := ⟨by
    rw [show Limits.terminal.from X = (X ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  obtain ⟨e, he⟩ := id hψ
  have hover := PartialIso.isOver_of_isOver hψZ hπ hπY e he
  obtain ⟨W, _, _, _, p, q, h, hWv, hWsm, hsq, hpproj, hqproj, hpb, hqb, hinv, hcomp, hcomm⟩ :=
    exists_commonResolution hXn hYn hX hY e hover
  rw [he] at hcomp
  haveI := isProper_of_isProjectiveMorphism p hpproj
  haveI := isProper_of_isProjectiveMorphism q hqproj
  haveI : IsDominant p := hpb.isDominant
  haveI : IsDominant q := hqb.isDominant
  have hWnp : IsNormalVariety ℂ (p ≫ sX) := ⟨hWv, inferInstance⟩
  have hWnq : IsNormalVariety ℂ (q ≫ sY) := hsq ▸ hWnp
  haveI : LocallyOfFiniteType (p ≫ sX) := hWv.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q ≫ sY) := hsq ▸ hWv.toLocallyOfFiniteType
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hWnp
  haveI : IsSeparated p := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  haveI : IsSeparated q := IsSeparated.of_comp q (Y ↘ ⊤_ Scheme)
  have hpbij := hpb.functionFieldMap_bijective
  have hqbij := hqb.functionFieldMap_bijective
  -- the realization of a prime divisor of `X` on `W` as a divisor over `Y`
  have hηW : ∀ (P : MMP.Mori.PrimeDivisor X) (PW : MMP.Mori.PrimeDivisor W),
      p PW.genericPoint = P.genericPoint →
        IsRealizedOver sY e.symm.toRationalMap P
          ({ toDivisorOver := ⟨W, q, hWnq, hqb, PW⟩, isProper := inferInstance } :
            ProperDivisorOver ℂ sY) := by
    intro P PW hη
    haveI := isIso_stalkMap_of_map_eq_genericPoint p hpbij hη
    have hsqr : (q ⁻¹ᵁ e.target).ι ≫ p = (q ∣_ e.target) ≫ e.iso.inv ≫ e.source.ι := by
      set V := q ⁻¹ᵁ e.target
      set U := p ⁻¹ᵁ e.source
      have hηV : genericPoint W ∈ V := by
        change q (genericPoint W) ∈ e.target
        rw [map_genericPoint_of_isDominant]
        exact (genericPoint_specializes _).mem_open e.target.2 e.dense_target.nonempty.choose_spec
      have hηU : genericPoint W ∈ U := by
        change p (genericPoint W) ∈ e.source
        rw [map_genericPoint_of_isDominant]
        exact (genericPoint_specializes _).mem_open e.source.2 e.dense_source.nonempty.choose_spec
      have hdense : Dense ((V ⊓ U : W.Opens) : Set W) := (V ⊓ U).isOpen.dense ⟨_, hηV, hηU⟩
      haveI := AlgebraicGeometry.Opens.isDominant_homOfLE hdense (inf_le_left : V ⊓ U ≤ V)
      refine ext_of_isDominant (ι := W.homOfLE (inf_le_left : V ⊓ U ≤ V)) ?_
      have hk : W.homOfLE (inf_le_left : V ⊓ U ≤ V) ≫ V.ι =
          W.homOfLE (inf_le_right : V ⊓ U ≤ U) ≫ U.ι := by simp
      have hj : W.homOfLE (inf_le_left : V ⊓ U ≤ V) ≫ (q ∣_ e.target) =
          W.homOfLE (inf_le_right : V ⊓ U ≤ U) ≫ (p ∣_ e.source) ≫ e.iso.hom := by
        rw [← cancel_mono e.target.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hk,
          Category.assoc, hcomm, Category.assoc, Category.assoc]
      rw [← Category.assoc, hk, Category.assoc, ← morphismRestrict_ι, ← Category.assoc
        (W.homOfLE (inf_le_left : V ⊓ U ≤ V)), hj, Category.assoc, Category.assoc,
        Iso.hom_inv_id_assoc]
    refine ⟨e.symm.toPartialMap, p, hpb, rfl, hsqr, ?_⟩
    refine Valuation.ext fun t => ?_
    rw [Valuation.comap_apply]
    by_cases ht : t = 0
    · rw [ht, map_zero, map_zero, map_zero]
    rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
      MMP.Positivity.ord_functionFieldMap_of_isIso p PW P hη t]
  -- `W ⟶ Z` through `X` and through `Y`
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : Z.IsSeparated := ⟨by
    rw [show Limits.terminal.from Z = (Z ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  have heZ := PartialIso.isOver_base hψZ e he
  have hpq : p ≫ π = q ≫ πY := by
    have hU : Dense ((p ⁻¹ᵁ e.source : W.Opens) : Set W) := by
      refine (p ⁻¹ᵁ e.source).isOpen.dense ⟨genericPoint W, ?_⟩
      change p (genericPoint W) ∈ e.source
      rw [map_genericPoint_of_isDominant]
      exact (genericPoint_specializes _).mem_open e.source.2 e.dense_source.nonempty.choose_spec
    haveI := AlgebraicGeometry.Opens.isDominant_ι hU
    refine ext_of_isDominant (ι := (p ⁻¹ᵁ e.source).ι) ?_
    have h1 : (p ⁻¹ᵁ e.source).ι ≫ q ≫ πY = (p ∣_ e.source) ≫ e.source.ι ≫ π := by
      rw [← Category.assoc, hcomm, Category.assoc, Category.assoc, heZ]
    refine Eq.trans ?_ h1.symm
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  exact exists_isRealLogMinimalModel_of_resolution hX hXQ hZ hπ hKX hlc hY hYQ hπY hKY hdlt hnef
    hψ hψZ hΔY hWv hWsm hsq hpproj hqproj hpb hqb hinv hcomp hpq
    fun P hP PW hη hWnq' n a' ha' => hlt P hP e.symm.toRationalMap ⟨e, he, rfl⟩ _ (hηW P PW hη) n a' ha'

end Criterion

section Tower

/-! ### A common resolution of a finite sequence of steps -/

open MMP.Mori

/-- **One floor of a tower of resolutions.** Let `V` be a smooth projective variety with a
birational morphism `r : V ⟶ Y`, and let `ψ : Y ⤏ Y'` be a birational map over `T`, for
`f : Y ⟶ T` and `f⁺ : Y' ⟶ T`. Then there is a smooth projective `V'` with projective birational
morphisms `c : V' ⟶ V` and `d : V' ⟶ Y'` such that `c ≫ r ≫ f = d ≫ f⁺`. -/
private theorem exists_tower_step {V Y Y' T : Scheme.{0}} [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral Y'] [CompactSpace Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    {sV : V ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)}
    {sT : T ⟶ Spec (.of ℂ)} (hV : MMP.Mori.IsProjectiveVariety ℂ sV)
    (hVn : IsNormalVariety ℂ sV) (hYn : IsNormalVariety ℂ sY) (hY'n : IsNormalVariety ℂ sY')
    (hY'p : MMP.Mori.IsProjectiveVariety ℂ sY') [IsSeparated (T ↘ ⊤_ Scheme)]
    {r : V ⟶ Y} (hrb : IsBirationalMorphism r) (hrs : r ≫ sY = sV)
    {f : Y ⟶ T} {fp : Y' ⟶ T} (hfs : f ≫ sT = sY) (hfps : fp ≫ sT = sY')
    {ψ : Y.RationalMap Y'} (hψ : RationalMap.IsBirational ψ)
    (hψT : MMP.Flips.RationalMap.IsOver f fp ψ) :
    ∃ (V' : Scheme.{0}) (_ : IsIntegral V') (_ : IsLocallyNoetherian V') (_ : IsNormal V')
      (c : V' ⟶ V) (d : V' ⟶ Y'),
      MMP.Mori.IsVariety ℂ (c ≫ sV) ∧ IsSmoothScheme (c ≫ sV) ∧ d ≫ sY' = c ≫ sV ∧
      IsProjectiveMorphism c ∧ IsProjectiveMorphism d ∧ IsBirationalMorphism c ∧
      IsBirationalMorphism d ∧ c ≫ r ≫ f = d ≫ fp := by
  have := hVn.1
  have := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hY'n
  obtain ⟨er, her⟩ := id hrb
  obtain ⟨eψ, heψ⟩ := id hψ
  have hr1 : er.source.ι ≫ r = er.iso.hom ≫ er.target.ι :=
    ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp her)).symm
  have hoverr : er.IsOver sV sY := by
    have := MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq er r sY her
    rwa [hrs] at this
  have hoverψT : eψ.IsOver f fp := PartialIso.isOver_base hψT eψ heψ
  have hoverψ : eψ.IsOver sY sY' := by
    have := PartialIso.IsOver.comp_right hoverψT sT
    rwa [hfs, hfps] at this
  set e' := er.trans eψ with he'
  have hover' : e'.IsOver sV sY' := hoverr.trans hoverψ
  obtain ⟨V', _, _, _, c, d, h', hcv, hcsm, hsq, hcproj, hdproj, hcb, hdb, -, -, hcomm⟩ :=
    exists_commonResolution hVn hY'n hV hY'p e' hover'
  refine ⟨V', inferInstance, inferInstance, inferInstance, c, d, hcv, hcsm, hsq, hcproj, hdproj,
    hcb, hdb, ?_⟩
  haveI : IsDominant c := hcb.isDominant
  have hU : Dense ((c ⁻¹ᵁ e'.source : V'.Opens) : Set V') := by
    refine (c ⁻¹ᵁ e'.source).isOpen.dense ⟨genericPoint V', ?_⟩
    change c (genericPoint V') ∈ e'.source
    rw [map_genericPoint_of_isDominant]
    exact (genericPoint_specializes _).mem_open e'.source.2 e'.dense_source.nonempty.choose_spec
  haveI := AlgebraicGeometry.Opens.isDominant_ι hU
  haveI : T.IsSeparated := ⟨by
    rw [show Limits.terminal.from T = (T ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  refine ext_of_isDominant (ι := (c ⁻¹ᵁ e'.source).ι) ?_
  obtain ⟨hle, l, hl, htr⟩ := trans_hom_ι er eψ
  have hψ1 : eψ.iso.hom ≫ eψ.target.ι ≫ fp = eψ.source.ι ≫ f := hoverψT
  have key : e'.iso.hom ≫ e'.target.ι ≫ fp = e'.source.ι ≫ r ≫ f := by
    rw [← Category.assoc, htr, Category.assoc, Category.assoc, hψ1, ← Category.assoc l, hl]
    simp only [Category.assoc]
    rw [← Category.assoc er.iso.hom, ← hr1]
    simp only [← Category.assoc, Scheme.homOfLE_ι]
    rfl
  rw [← Category.assoc (c ⁻¹ᵁ e'.source).ι d fp, hcomm, Category.assoc, Category.assoc, key,
    ← Category.assoc (c ∣_ e'.source) e'.source.ι (r ≫ f), morphismRestrict_ι, Category.assoc]

/-- **A tower of resolutions of a finite sequence of steps.** Let `Y_0, …, Y_j` be normal
projective varieties with birational maps `ψ_i : Y_i ⤏ Y_{i+1}` over `T_i`, for
`f_i : Y_i ⟶ T_i` and `f⁺_i : Y_{i+1} ⟶ T_i`, and let `r₀ : V₀ ⟶ Y_0` be a projective birational
morphism from a smooth projective variety. Then there are a smooth projective variety `V`, a
projective birational `b : V ⟶ V₀` and projective birational `r_k : V ⟶ Y_k`, `k ≤ j`, with
`r_0 = b ≫ r₀` and `r_k ≫ f_k = r_{k+1} ≫ f⁺_k`. -/
private theorem exists_tower {Y : ℕ → Scheme.{0}} [∀ i, IsIntegral (Y i)]
    [∀ i, CompactSpace (Y i)] [∀ i, IsLocallyNoetherian (Y i)] [∀ i, IsNormal (Y i)]
    {sY : ∀ i, Y i ⟶ Spec (.of ℂ)} {T : ℕ → Scheme.{0}} {sT : ∀ i, T i ⟶ Spec (.of ℂ)} (j : ℕ)
    (hYn : ∀ i ≤ j, IsNormalVariety ℂ (sY i))
    (hYp : ∀ i ≤ j, MMP.Mori.IsProjectiveVariety ℂ (sY i))
    (hT : ∀ i < j, IsSeparated (T i ↘ ⊤_ Scheme))
    (f : ∀ i, Y i ⟶ T i) (fp : ∀ i, Y (i + 1) ⟶ T i) (ψ : ∀ i, (Y i).RationalMap (Y (i + 1)))
    (hfs : ∀ i < j, f i ≫ sT i = sY i) (hfps : ∀ i < j, fp i ≫ sT i = sY (i + 1))
    (hψ : ∀ i < j, RationalMap.IsBirational (ψ i))
    (hψT : ∀ i < j, MMP.Flips.RationalMap.IsOver (f i) (fp i) (ψ i))
    {V₀ : Scheme.{0}} [IsIntegral V₀] [IsLocallyNoetherian V₀] [IsNormal V₀]
    {sV₀ : V₀ ⟶ Spec (.of ℂ)} (hV₀ : MMP.Mori.IsProjectiveVariety ℂ sV₀)
    (hV₀sm : IsSmoothScheme sV₀) {r₀ : V₀ ⟶ Y 0} (hr₀ : IsProjectiveMorphism r₀)
    (hr₀b : IsBirationalMorphism r₀) (hr₀s : r₀ ≫ sY 0 = sV₀) :
    ∀ i ≤ j, ∃ (V : Scheme.{0}) (_ : IsIntegral V) (_ : IsLocallyNoetherian V) (_ : IsNormal V)
      (b : V ⟶ V₀) (r : (k : Fin (i + 1)) → (V ⟶ Y k)),
      MMP.Mori.IsVariety ℂ (b ≫ sV₀) ∧ IsSmoothScheme (b ≫ sV₀) ∧ IsProjectiveMorphism b ∧
      IsBirationalMorphism b ∧
      (∀ k, IsProjectiveMorphism (r k) ∧ IsBirationalMorphism (r k) ∧ r k ≫ sY k = b ≫ sV₀) ∧
      r ⟨0, Nat.succ_pos i⟩ = b ≫ r₀ ∧
      ∀ k : Fin i, r k.castSucc ≫ f k = r k.succ ≫ fp k := by
  intro i
  induction i with
  | zero =>
    intro _
    refine ⟨V₀, inferInstance, inferInstance, inferInstance, 𝟙 V₀,
      Fin.lastCases (motive := fun k : Fin 1 => V₀ ⟶ Y k) r₀ (fun k => k.elim0),
      by rw [Category.id_comp]; exact hV₀.toIsVariety, by rwa [Category.id_comp],
      MMP.isProjectiveMorphism_of_isClosedImmersion _,
      MMP.Mori.isBirationalMorphism_of_isIso _, fun k => ?_, ?_, fun k => k.elim0⟩
    · refine Fin.lastCases ?_ (fun k => k.elim0) k
      rw [Fin.lastCases_last, Category.id_comp]
      exact ⟨hr₀, hr₀b, hr₀s⟩
    · change Fin.lastCases (motive := fun k : Fin 1 => V₀ ⟶ Y k) r₀ (fun k => k.elim0)
        (Fin.last 0) = _
      rw [Fin.lastCases_last, Category.id_comp]
  | succ i ih =>
    intro hi
    obtain ⟨V, _, _, _, b, r, hbv, hbsm, hbp, hbb, hr, hr0, hcomm⟩ := ih (Nat.le_of_succ_le hi)
    haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace (b ≫ sV₀)
    have hVp : MMP.Mori.IsProjectiveVariety ℂ (b ≫ sV₀) :=
      (AlgebraicGeometry.isProjectiveVariety_iff ℂ (b ≫ sV₀)).mpr
        ⟨hbv, hbp.comp hV₀.isProjective⟩
    obtain ⟨hrp, hrb, hrs⟩ := hr (Fin.last i)
    haveI := hT i hi
    obtain ⟨V', _, _, _, c, d, hcv, hcsm, hsq, hcproj, hdproj, hcb, hdb, hcd⟩ :=
      exists_tower_step hVp ⟨hbv, inferInstance⟩ (hYn i (by omega)) (hYn (i + 1) hi)
        (hYp (i + 1) hi) hrb hrs (hfs i hi) (hfps i hi) (hψ i hi) (hψT i hi)
    have hcb' : IsProjectiveMorphism (c ≫ b) := hcproj.comp hbp
    refine ⟨V', inferInstance, inferInstance, inferInstance, c ≫ b,
      Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k),
      by rwa [Category.assoc], by rwa [Category.assoc], hcb',
      MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hcb hbb, fun k => ?_, ?_, fun k => ?_⟩
    · refine Fin.lastCases ?_ (fun k => ?_) k
      · rw [Fin.lastCases_last]
        exact ⟨hdproj, hdb, by
          show d ≫ sY (i + 1) = (c ≫ b) ≫ sV₀
          rw [hsq, Category.assoc]⟩
      · rw [Fin.lastCases_castSucc]
        obtain ⟨h1, h2, h3⟩ := hr k
        exact ⟨hcproj.comp h1, MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hcb h2, by
          show (c ≫ r k) ≫ sY k = (c ≫ b) ≫ sV₀
          rw [Category.assoc, h3, Category.assoc]⟩
    · change Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k)
        (Fin.castSucc ⟨0, Nat.succ_pos i⟩) = _
      rw [Fin.lastCases_castSucc, hr0, Category.assoc]
    · refine Fin.lastCases ?_ (fun k => ?_) k
      · change Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k)
            (Fin.castSucc (Fin.last i)) ≫ f i =
          Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k)
            (Fin.last (i + 1)) ≫ fp i
        rw [Fin.lastCases_castSucc, Fin.lastCases_last, Category.assoc, hcd]
      · change Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k)
            (Fin.castSucc k.castSucc) ≫ f k =
          Fin.lastCases (motive := fun k : Fin (i + 2) => V' ⟶ Y k) d (fun k => c ≫ r k)
            (Fin.castSucc k.succ) ≫ fp k
        rw [Fin.lastCases_castSucc, Fin.lastCases_castSucc, Category.assoc, hcomm k,
          Category.assoc]

end Tower

section Program

/-- A morphism out of a scheme separated over the terminal scheme is separated. -/
private theorem isSeparated_of_isSeparated_toTerminal {A B : Scheme.{0}} (f : A ⟶ B)
    [IsSeparated (A ↘ ⊤_ Scheme)] : IsSeparated f := by
  have h : f ≫ (B ↘ ⊤_ Scheme) = (A ↘ ⊤_ Scheme) := Limits.terminal.hom_ext _ _
  haveI : IsSeparated (f ≫ (B ↘ ⊤_ Scheme)) := by rw [h]; infer_instance
  exact IsSeparated.of_comp f (B ↘ ⊤_ Scheme)

/-! ### A negative program from a strictly improving model -/

open MMP.Mori

/-- A prime divisor which is not exceptional for a proper birational morphism onto a normal
scheme maps to the generic point of a prime divisor. -/
private theorem exists_primeDivisor_of_not_isExceptional_toRationalMap {W Y : Scheme.{0}}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsSeparated (Y ↘ ⊤_ Scheme)] (q : W ⟶ Y) [IsProper q]
    (hq : IsBirationalMorphism q) (E : MMP.Mori.PrimeDivisor W)
    (hE : ¬ RationalMap.IsExceptional (X := W) q.toRationalMap E) :
    ∃ F : MMP.Mori.PrimeDivisor Y, q E.genericPoint = F.genericPoint := by
  rw [isExceptional_toRationalMap_iff_two_le_coheight, not_le] at hE
  have h1 : Order.coheight (q E.genericPoint) ≤ 1 := Order.le_of_lt_succ hE
  have hbir := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal q hq h1
  have hc : Order.coheight (q E.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus q hbir, E.coheight_genericPoint]
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hc,
    (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hc).symm⟩

/-- A birational map `h ∘ q` through a common model is birational. -/
private theorem isBirational_compHom_of_isBirationalMorphism {V X Y : Scheme.{0}} [IsIntegral V]
    [IsIntegral X] {q : V ⟶ Y} (ep : X.PartialIso V)
    (hq : IsBirationalMorphism q) :
    RationalMap.IsBirational (ep.toRationalMap.compHom q) := by
  obtain ⟨eq, heq⟩ := id hq
  refine ⟨ep.trans eq, ?_⟩
  haveI := isDominant_partialIso_hom ep
  haveI := isDominant_toRationalMap_partialIso ep
  rw [trans_toRationalMap, ← Scheme.RationalMap.toRationalMap_comp]
  change ep.toRationalMap.comp eq.toRationalMap = _
  rw [heq, Scheme.RationalMap.comp_toRationalMap]

/-- A small contraction maps generic points of prime divisors to points of coheight one. -/
private theorem coheight_map_le_one_of_isSmall {k : Type} [Field k] {Y T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} [IsNormal T] {f : Y ⟶ T}
    (hf : IsSmall k sT sY f) (F : MMP.Mori.PrimeDivisor Y) :
    Order.coheight (f F.genericPoint) ≤ 1 := by
  have h2 := (MMP.Flips.isSmall_iff_two_le_closedsCodimension_exceptionalSet
    hf.toIsBirationalContraction).mp hf
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h2
  have hη : F.genericPoint ∉ MMP.Flips.exceptionalSet f := fun h => by
    have := h2 _ h
    rw [F.coheight_genericPoint] at this
    exact absurd this (by decide)
  rw [MMP.Flips.coheight_map_of_notMem_exceptionalSet hη, F.coheight_genericPoint]

/-- The generic point of a prime divisor `F` does not lie on another prime divisor `E`. -/
private theorem genericPoint_notMem_support_of_ne {Y : Scheme.{0}} {F E : MMP.Mori.PrimeDivisor Y}
    (h : F ≠ E) : F.genericPoint ∉ (E.support : Set Y) := by
  intro hmem
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hmem
  have hle : F.genericPoint ≤ E.genericPoint := specializes_iff_mem_closure.mpr hmem
  by_cases h2 : E.genericPoint ≤ F.genericPoint
  · exact h (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (Specializes.antisymm h2 hle).eq)
  · have hlt : F.genericPoint < E.genericPoint := lt_of_le_not_ge hle h2
    have := Order.coheight_strictAnti hlt (by rw [E.coheight_genericPoint]; decide)
    rw [F.coheight_genericPoint, E.coheight_genericPoint] at this
    exact lt_irrefl _ this

open Classical in
/-- **A negative program from a strictly improving model ends in a log minimal model.** Let
`(X, Δ)` be an lc pair on a `ℚ`-factorial projective variety over `Z`, and `(Y_0, Γ_0)` a model
given on a smooth projective common resolution `p₀ : W₀ ⟶ X`, `q₀ : W₀ ⟶ Y_0`, with
`Γ_0 = φ_* Δ + ∑ F` (`F` exceptional over `X`, `φ = q₀ ∘ p₀⁻¹`) and `1 - mult_P Δ < a(P; Y_0, Γ_0)`
for every prime `P` of `X` contracted by `φ`. Let `Y_0 ⤏ ⋯ ⤏ Y_j` be divisorial contractions
and flips over `Z` of `(K_i + Γ_i)`-negative extremal contractions, with `Γ_{i+1}` the strict
transform of `Γ_i`, between normal projective `ℚ`-factorial varieties, ending with
`(Y_j, Γ_j)` dlt and `K_{Y_j} + Γ_j` nef over `Z`. Then `Y_j` is a log minimal model of
`(X/Z, Δ)`. -/
private theorem exists_isRealLogMinimalModel_of_program
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    {KX : Divisor X} (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m) {Δ : RDivisor X}
    (hlc : IsRealLcPair sX Δ)
    {Ys : ℕ → Scheme.{0}} [∀ i, IsIntegral (Ys i)] [∀ i, CompactSpace (Ys i)]
    [∀ i, IsLocallyNoetherian (Ys i)] [∀ i, IsNormal (Ys i)] {sYs : ∀ i, Ys i ⟶ Spec (.of ℂ)}
    {πYs : ∀ i, Ys i ⟶ Z} {Ks : ∀ i, Divisor (Ys i)} {Γs : ∀ i, RDivisor (Ys i)} (j : ℕ)
    (hmod : ∀ i ≤ j, MMP.Mori.IsProjectiveVariety ℂ (sYs i) ∧ IsQFactorial (sYs i) ∧
      (∃ m : ℕ, (Ks i).IsCanonicalDivisor (sYs i) m) ∧ πYs i ≫ sZ = sYs i)
    {W : ℕ → Scheme.{0}} {sW : ∀ i, W i ⟶ Spec (.of ℂ)} {f : ∀ i, Ys i ⟶ W i}
    {g : ∀ i, W i ⟶ Z} {fp : ∀ i, Ys (i + 1) ⟶ W i}
    {ψ : ∀ i, (Ys i).RationalMap (Ys (i + 1))}
    (hW : ∀ i < j, IsNormalVariety ℂ (sW i))
    (hfs : ∀ i < j, f i ≫ sW i = sYs i) (hfps : ∀ i < j, fp i ≫ sW i = sYs (i + 1))
    (hfg : ∀ i < j, f i ≫ g i = πYs i) (hfpg : ∀ i < j, fp i ≫ g i = πYs (i + 1))
    (hfP : ∀ i < j, IsProper (f i)) (hfpP : ∀ i < j, IsProper (fp i))
    (hfb : ∀ i < j, IsBirationalMorphism (f i)) (hfpb : ∀ i < j, IsBirationalMorphism (fp i))
    (hmodif : ∀ i < j, IsModificationOf (f i) (fp i) (ψ i))
    (hΓ : ∀ i < j, Γs (i + 1) = RationalMap.transformDivisor (ψ i) (Γs i))
    (hneg : ∀ i < j, IsRelativelyNef ℂ (sYs i) (f i) (-logCanonicalDivisor (Ks i) (Γs i)))
    (hkind : ∀ i < j,
      (IsContraction ℂ (sW i) (sYs i) (f i) ∧
        (∃ E : MMP.Mori.PrimeDivisor (Ys i),
          (MMP.Mori.exceptionalSet (f i) : Set (Ys i)) = E.support) ∧ IsIso (fp i) ∧
        IsRelativelyAntiAmple (f i) (logCanonicalDivisor (Ks i) (Γs i))) ∨
      (IsSmall ℂ (sW i) (sYs i) (f i) ∧ IsSmall ℂ (sW i) (sYs (i + 1)) (fp i) ∧
        MMP.Flips.RationalMap.IsMorphismInCodimOne (ψ i) ∧
        IsRelativelyNef ℂ (sYs (i + 1)) (fp i) (logCanonicalDivisor (Ks (i + 1)) (Γs (i + 1)))))
    {W₀ : Scheme.{0}} [IsIntegral W₀] [IsLocallyNoetherian W₀] [IsNormal W₀] {p₀ : W₀ ⟶ X}
    {q₀ : W₀ ⟶ Ys 0} {h₀ : X.RationalMap W₀} (hW₀ : MMP.Mori.IsVariety ℂ (p₀ ≫ sX))
    (hW₀sm : IsSmoothScheme (p₀ ≫ sX)) (hq₀s : q₀ ≫ sYs 0 = p₀ ≫ sX)
    (hp₀ : IsProjectiveMorphism p₀) (hq₀ : IsProjectiveMorphism q₀)
    (hp₀b : IsBirationalMorphism p₀) (hq₀b : IsBirationalMorphism q₀)
    (hinv₀ : RationalMap.IsInverse p₀.toRationalMap h₀) (hpq₀ : p₀ ≫ π = q₀ ≫ πYs 0)
    (hΓ₀ : ∀ F, (Γs 0).coeff F = (RationalMap.transformDivisor (h₀.compHom q₀) Δ).coeff F +
      if MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F then 1 else 0)
    (hlt₀ : ∀ P, RationalMap.IsExceptional (h₀.compHom q₀) P →
      ∀ PW : MMP.Mori.PrimeDivisor W₀, p₀ PW.genericPoint = P.genericPoint →
      ∀ (hn : IsNormalVariety ℂ (q₀ ≫ sYs 0)) (n : ℕ) (a : ℝ),
        MMP.Intersection.IsLogDiscrepancy (sYs 0) n (Γs 0) ⟨W₀, q₀, hn, hq₀b, PW⟩ a →
          1 - Δ.coeff P < a)
    (hdlt : IsRealDltPair (sYs j) (Γs j))
    (hnef : IsRelativelyNef ℂ (sYs j) (πYs j) (logCanonicalDivisor (Ks j) (Γs j))) :
    ∃ (χ : X.RationalMap (Ys j)) (KY : Divisor (Ys j)),
      IsRealLogMinimalModel sX (sYs j) sZ π (πYs j) KX Δ KY (Γs j) χ := by
  classical
  have hXn : IsNormalVariety ℂ sX := hlc.1
  haveI := hXn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  haveI : X.IsSeparated := ⟨by
    rw [show Limits.terminal.from X = (X ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
