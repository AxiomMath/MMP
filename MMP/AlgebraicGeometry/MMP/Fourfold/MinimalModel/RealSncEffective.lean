        exact (coeff_boundary_of_eq_some hTj (fun P' hP' => huniq _ _ hTj hP') B).symm
      · -- the other primes keep the coefficients of `B_Y`
        obtain ⟨G, hG, hBVQ⟩ := hBVc Q hQe
        rw [hBVQ, hY.coeff_boundary G]
        obtain ⟨GW, hGW, -, -⟩ :=
          MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hYn hWnq hqb G
        have hφiff : ∀ P, RationalMap.transformPrimeDivisor φ P = some G ↔
            p GW.genericPoint = P.genericPoint := fun P => by
          rw [← hR.compHom_eq]
          exact transformPrimeDivisor_compHom_eq_some_iff hpbij hR.isInverse hqbij hGW
            (fun P => ⟨PWf P, (hPWf P).1⟩) P
        have hr₁T : r₁ TW.genericPoint = GW.genericPoint := by
          refine eq_of_map_eq_genericPoint q hqbij ?_ hGW
          rw [← hcomp r₁ q, hrq, hcomp r₂ c, hTW, hcx, hQ, hG]
        have hkey : ∀ P, RationalMap.transformPrimeDivisor (e'.symm.toRationalMap.compHom r₂) P =
            some T ↔ RationalMap.transformPrimeDivisor φ P = some G := fun P => by
          rw [hiff P, hφiff P]
          change p (r₁ TW.genericPoint) = _ ↔ _
