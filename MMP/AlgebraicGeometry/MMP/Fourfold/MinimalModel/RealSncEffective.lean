    simpa only [hcs] using this
  -- the strict transforms of prime divisors of `V'` on `W'`
  have hψiff : ∀ (T : MMP.Mori.PrimeDivisor V') (TW : MMP.Mori.PrimeDivisor W'),
      r₂ TW.genericPoint = T.genericPoint → ∀ P,
        RationalMap.transformPrimeDivisor (e'.symm.toRationalMap.compHom r₂) P = some T ↔
          (r₁ ≫ p) TW.genericPoint = P.genericPoint := fun T TW hTW P =>
    transformPrimeDivisor_compHom_eq_some_iff hp'bij hH hr₂bij hTW hexX P
  -- the boundary of `V'` has the required form
  have hΔV' : ∀ T, BV'.coeff T =
      (RationalMap.transformDivisor (e'.symm.toRationalMap.compHom r₂) B).coeff T +
        if RationalMap.IsInverseExceptional (e'.symm.toRationalMap.compHom r₂) T then 1 else 0 := by
    intro T
    obtain ⟨TW, hTW, -, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hV'n hW'n₂ hr₂b T
    have hiff := hψiff T TW hTW
    have huniq : ∀ P P', RationalMap.transformPrimeDivisor (e'.symm.toRationalMap.compHom r₂) P =
        some T → RationalMap.transformPrimeDivisor (e'.symm.toRationalMap.compHom r₂) P' =
          some T → P' = P := fun P P' h1 h2 =>
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (((hiff P').mp h2).symm.trans ((hiff P).mp h1))
    by_cases hTe : RationalMap.IsExceptional (X := V') pV'.toRationalMap T
    · -- a prime divisor extracted by the dlt modification is new over `X`
      rw [hexc1 T hTe]
      refine (coeff_boundary_of_forall_ne (fun P hP => ?_) B).symm
      have hη : p (r₁ TW.genericPoint) = P.genericPoint := (hiff P).mp hP
      have hr₁η : r₁ TW.genericPoint = (PWf P).genericPoint :=
        eq_of_map_eq_genericPoint p hpbij hη (hPWf P).1
      have hvT : T.valuationOver c = (PWf P).valuationOver q :=
        (valuationOver_eq_of_comp_eq (g := c) hr₂bij.2 rfl hTW).symm.trans
