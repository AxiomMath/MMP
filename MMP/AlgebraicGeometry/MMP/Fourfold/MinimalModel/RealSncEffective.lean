  have hXQ : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
  have hπV' : (c ≫ πY) ≫ sZ = pV' ≫ pV ≫ sY := by
    rw [Category.assoc, hY.comp_eq_model, hcs]
  obtain ⟨KY', hLMM⟩ := exists_isRealLogMinimalModel_of_resolution (sY := pV' ≫ pV ≫ sY)
