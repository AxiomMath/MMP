      have hCN : ∀ k < j, divisorSeq CY CM (k + 1) + Ns (k + 1) =
          RationalMap.transformDivisor (ψ k) (divisorSeq CY CM k + Ns k) := fun k hk => by
        rw [map_add, ← hCj k hk, ← hNs k hk]
        rfl
      have hfl := isNumericallyEquivalentOver_of_program hD.hZ j hmodj hWj hfsj hfpsj hfgj hfpgj
        hfPj hfpPj hfbj hfpbj hmodifj hkindj hD.hα.ne'
        (Ds := fun k => divisorSeq CY CM k + Ns k) hBj hCN hnumY i hij.le
