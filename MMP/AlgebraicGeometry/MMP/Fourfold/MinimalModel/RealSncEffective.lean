        by_cases hex : ∃ P, RationalMap.transformPrimeDivisor φ P = some G
        · obtain ⟨P, hP⟩ := hex
          have hPψ := (hkey P).mpr hP
          rw [coeff_boundary_of_eq_some hP (fun P' hP' => huniq _ _ hPψ ((hkey P').mpr hP')) B,
            coeff_boundary_of_eq_some hPψ (fun P' hP' => huniq _ _ hPψ hP') B]
        · push_neg at hex
          rw [coeff_boundary_of_forall_ne hex B,
            coeff_boundary_of_forall_ne (fun P hP => hex P ((hkey P).mp hP)) B]
  -- every contracted prime divisor has larger log discrepancy on `V'`
  have hltV' : ∀ P, RationalMap.IsExceptional (e'.symm.toRationalMap.compHom r₂) P →
      ∀ PW : MMP.Mori.PrimeDivisor W', (r₁ ≫ p) PW.genericPoint = P.genericPoint →
      ∀ (hWnq' : IsNormalVariety ℂ (r₂ ≫ pV' ≫ pV ≫ sY)) (n : ℕ) (a' : ℝ),
        MMP.Intersection.IsLogDiscrepancy (pV' ≫ pV ≫ sY) n BV' ⟨W', r₂, hWnq', hr₂b, PW⟩ a' →
          1 - B.coeff P < a' := by
    intro P hP PW hPW hWnq' n a' ha'
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha'
    obtain rfl : n = 4 := by
      rw [hdimV'] at hn
      exact_mod_cast hn.symm
    obtain ⟨ω₂, hω₂0, hω₂V, hω₂V'⟩ :=
      MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hVn hV'n hpV'b hKV₀ hKV' hpV'K
    obtain ⟨_, _, h1⟩ := isLogDiscrepancy_comp_of_isRCartierPullback hVn hV'n hpV'b hω₂0
      (hω₂V ▸ hKV₀) (by rw [hω₂V']; exact hKV') (by rw [hω₂V, hω₂V']; exact hpullV') _ ha'
    obtain ⟨_, _, h2⟩ := isLogDiscrepancy_comp_of_isRCartierPullback hYn hVn hpVb hωV0
      hKYω' hKV₀ω hBVpb _ h1
    have hr₁PW : r₁ PW.genericPoint = (PWf P).genericPoint :=
      eq_of_map_eq_genericPoint p hpbij (show p (r₁ PW.genericPoint) = P.genericPoint from hPW)
        (hPWf P).1
    have heqa := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq h2
      (hlogY BY GY hR.isRCartierPullback_right P)
      ((divisorOver_valuation_mk _ _ _).trans ((valuationOver_eq_of_comp_eq (g := q)
        (c := (r₂ ≫ pV') ≫ pV) hr₁bij.2 (by rw [hrq, hcdef, Category.assoc]) hr₁PW).trans (divisorOver_valuation_mk _ _ _).symm))
    have hGX := hGXc B GX hR.isRCartierPullback_left P
    have hK := hKWP P
    rcases (hR.effective (PWf P)).lt_or_eq with hpos | heq0
    · rw [DivisorWithCoeffs.coeff_sub] at hpos
      linarith
    exfalso
    have hPWtr' := transformPrimeDivisor_eq_some_of_isInverse hp'bij hH hPW
    have hPWexc := (isExceptional_compHom_iff hPWtr' r₂).mp hP
    by_cases hφP : RationalMap.IsExceptional φ P
    · -- an equality prime is extracted on `V'`
      have hPEq : P ∈ Eq := (hEqmem P).mpr ⟨hφP, heq0.symm⟩
      obtain ⟨Fj, hFj, -, -⟩ := MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0}
        hVn hV'n hpV'b (F ⟨P, hPEq⟩)
      obtain ⟨T', hT', -, -⟩ :=
        MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hV'n hW'n₂ hr₂b Fj
      have hv1 : T'.valuationOver (r₂ ≫ c) = (PWf P).valuationOver q :=
        (valuationOver_eq_of_comp_eq (g := c) hr₂bij.2 rfl hT').trans
          ((valuationOver_eq_of_comp_eq (g := pV) hpV'bij.2 hcdef.symm hFj).trans
            (hFval' ⟨P, hPEq⟩))
      have hv2 : PW.valuationOver (r₂ ≫ c) = (PWf P).valuationOver q :=
        valuationOver_eq_of_comp_eq (g := q) hr₁bij.2 hrq hr₁PW
      have hPT : PW = T' := eq_of_valuationOver_eq hW'n hr₂cbij.2 (hv2.trans hv1.symm)
      rw [hPT] at hPWexc
      exact not_isExceptional_of_transformPrimeDivisor_eq_some
        ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff r₂ T' Fj).mpr hT') hPWexc
    · -- a prime with a divisorial image on `Y` has a divisorial image on `V'`
      rw [← hR.compHom_eq, isExceptional_compHom_iff (hPWtr P) q] at hφP
      obtain ⟨G, hG⟩ := exists_primeDivisor_of_not_isExceptional_toRationalMap q hqb (PWf P) hφP
      obtain ⟨GV', hGV', -, -⟩ :=
        MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hYn hV'nc hcb G
      have h3 : c (r₂ PW.genericPoint) = G.genericPoint := by
        rw [← hcomp r₂ c, ← hrq, hcomp r₁ q, hr₁PW, hG]
      exact not_isExceptional_of_transformPrimeDivisor_eq_some
        ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff r₂ PW GV').mpr
