      intro k hk
      induction hk using Nat.decreasingInduction with
      | self => exact ⟨F, hFVη, rfl⟩
      | of_succ k hk ih =>
        obtain ⟨Fk1, h1, h2⟩ := ih
        obtain ⟨Fk, h3, h4⟩ := htrackb k hk Fk1 FV.genericPoint h1
        exact ⟨Fk, h3, h4.symm.trans h2⟩
    obtain ⟨F₀, hF₀η, hF₀Γ⟩ := hback 0 (Nat.zero_le j)
    rw [← hF₀Γ, hΓ₀ F₀]
    set w := b FV.genericPoint with hwdef
    have hqw : q₀ w = F₀.genericPoint := by
      rw [hwdef, ← Scheme.Hom.comp_apply, ← hrk0]; exact hF₀η
    have hφP : ∀ P, RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀ →
        p₀ w = P.genericPoint := by
      intro P hP
      obtain ⟨PW, hPW, h2⟩ := hstrictW P
      rw [transformPrimeDivisor_compHom h2,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff] at hP
      rw [← eq_of_map_eq_genericPoint q₀ hq₀b.functionFieldMap_bijective hP hqw]; exact hPW
    have hiff : ∀ P : MMP.Mori.PrimeDivisor X,
        RationalMap.transformPrimeDivisor χ P = some F ↔
          RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀ := by
      intro P
      obtain ⟨PV, hPV, h1⟩ := hstrictV P
      obtain ⟨PW, hPW, h2⟩ := hstrictW P
      rw [hχdef, transformPrimeDivisor_compHom h1, transformPrimeDivisor_compHom h2,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
      constructor
      · intro hq
        have hPVFV : PV.genericPoint = FV.genericPoint :=
          eq_of_map_eq_genericPoint q hqb.functionFieldMap_bijective hq hFVη
        have hpw : p₀ w = P.genericPoint := by
          rw [hwdef, ← Scheme.Hom.comp_apply, ← hPVFV]; exact hPV
        rw [← eq_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective hpw hPW]; exact hqw
      · intro hq
        have hwPW : PW.genericPoint = w :=
          eq_of_map_eq_genericPoint q₀ hq₀b.functionFieldMap_bijective hq hqw
        have hpFV : p FV.genericPoint = P.genericPoint := by
          rw [hpdef, Scheme.Hom.comp_apply, ← hwdef, ← hwPW]; exact hPW
        rw [← eq_of_map_eq_genericPoint p hpb.functionFieldMap_bijective hpFV hPV]; exact hFVη
    have hinvexc : MMP.Flips.RationalMap.IsInverseExceptional χ F ↔
        MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F₀ :=
      forall_congr' fun P => not_congr (hiff P)
    have hcoef : (RationalMap.transformDivisor χ Δ).coeff F =
        (RationalMap.transformDivisor (h₀.compHom q₀) Δ).coeff F₀ := by
      by_cases hex : ∃ P, RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀
      · obtain ⟨P, hP⟩ := hex
        have huniq : ∀ P', RationalMap.transformPrimeDivisor (h₀.compHom q₀) P' = some F₀ →
            P' = P := fun P' hP' => AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          ((hφP P' hP').symm.trans (hφP P hP))
        exact (MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq ((hiff P).mpr hP)
          (fun P' h' => huniq P' ((hiff P').mp h')) Δ).trans
          (MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hP huniq Δ).symm
      · push_neg at hex
        exact (MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne
          (fun P h' => hex P ((hiff P).mp h')) Δ).trans
          (MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne hex Δ).symm
    rw [hcoef]
    by_cases hie : MMP.Flips.RationalMap.IsInverseExceptional χ F
    · rw [if_pos hie, if_pos (hinvexc.mp hie)]
    · rw [if_neg hie, if_neg (fun h' => hie (hinvexc.mpr h'))]
  -- the comparison of log discrepancies along the steps
  have hcompW : ∀ k (hk : k < j),
      RationalMap.transformDivisor (X := Ys k) (f k).toRationalMap (Γs k) =
        RationalMap.transformDivisor (X := Ys (k + 1)) (fp k).toRationalMap (Γs (k + 1)) := by
    intro k hk
    obtain ⟨h1, h2, h3⟩ := hWinst k hk
    haveI := h1; haveI := h2; haveI := h3; haveI := hfP k hk; haveI := hfpP k hk
    haveI := hWsep k hk
    haveI := hYsep (k + 1) hk
    haveI : IsDominant (f k) := (hfb k hk).isDominant
    haveI : IsDominant (fp k) := (hfpb k hk).isDominant
    refine DivisorWithCoeffs.ext' fun T => ?_
    obtain ⟨hb1, hb2⟩ := hbirW k hk _ T.coheight_genericPoint.le
    obtain ⟨F, hF, -⟩ :=
      exists_primeDivisor_map_eq_of_mem_biregularLocus (f k) hb1 T.coheight_genericPoint
    obtain ⟨F', hF', -⟩ :=
      exists_primeDivisor_map_eq_of_mem_biregularLocus (fp k) hb2 T.coheight_genericPoint
    obtain ⟨F'', -, huniq, -, -, hcoef⟩ :=
      exists_transformPrimeDivisor_eq_of_isOver (hψover k hk) (hdef k hk) F (hF ▸ hb1) (hF ▸ hb2)
    have hFF : F'' = F' := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (huniq _ (hF'.trans hF.symm)).symm
    subst hFF
    rw [coeff_transformDivisor_hom (hfb k hk).functionFieldMap_bijective (Γs k) hF,
      coeff_transformDivisor_hom (hfpb k hk).functionFieldMap_bijective (Γs (k + 1)) hF',
      hΓ k hk, hcoef]
  have hKs : ∀ k (hk : k ≤ j), (Ks k).IsCanonicalDivisor (sYs k) (hmod k hk).2.2.1.choose :=
    fun k hk => (hmod k hk).2.2.1.choose_spec
  -- the log discrepancies of a prime divisor of `V` along the program
  have hlt : ∀ P, RationalMap.IsExceptional χ P → ∀ PV : MMP.Mori.PrimeDivisor V,
      p PV.genericPoint = P.genericPoint → ∀ (hVq : IsNormalVariety ℂ (q ≫ sYs j)) (n : ℕ)
      (a' : ℝ), MMP.Intersection.IsLogDiscrepancy (sYs j) n (Γs j) ⟨V, q, hVq, hqb, PV⟩ a' →
        1 - Δ.coeff P < a' := by
    intro P hP PV hPV hVq n a' ha'
    have hA : ∀ k (hk : k ≤ j), ∃ a, MMP.Intersection.IsLogDiscrepancy (sYs k)
        (hmod k hk).2.2.1.choose (Γs k) ⟨V, rk k hk, hrkn k hk, (hrk k hk).2.1, PV⟩ a :=
      fun k hk => by
        haveI := hrkP k hk
        haveI : LocallyOfFiniteType (sYs k) := (hYn k hk).1.toLocallyOfFiniteType
        exact exists_isLogDiscrepancy_primeDivisor (hYn k hk) (hrkn k hk) (hrk k hk).2.1
          (hKs k hk) (hKΓ k hk) PV
    choose A hAk using hA
    have hmono : ∀ k (hk : k < j), A k hk.le ≤ A (k + 1) hk := by
      intro k hk
      obtain ⟨h1, h2, h3⟩ := hWinst k hk
      haveI := h1; haveI := h2; haveI := h3; haveI := hfP k hk; haveI := hfpP k hk
      haveI := hrkP k hk.le; haveI := hrkP (k + 1) hk
      haveI : LocallyOfFiniteType (sW k) := (hW k hk).1.toLocallyOfFiniteType
      haveI : QuasiCompact (sW k) := (hW k hk).1.toQuasiCompact
      haveI : QuasiCompact (sYs k) := (hYn k hk.le).1.toQuasiCompact
      haveI : QuasiCompact (sYs (k + 1)) := (hYn (k + 1) hk).1.toQuasiCompact
      have hnef' : IsRelativelyNef ℂ (sYs (k + 1)) (fp k)
          (logCanonicalDivisor (Ks (k + 1)) (Γs (k + 1))) := by
        rcases hkind k hk with ⟨-, -, hiso, -⟩ | ⟨-, -, -, hn⟩
        · haveI := hiso
          exact isRelativelyNef_of_injective (fp k).isOpenEmbedding.injective (hKΓ (k + 1) hk)
        · exact hn
      exact isLogDiscrepancy_le_of_step (hW k hk) (hfs k hk) (hfps k hk) (hYn k hk.le)
        (hYn (k + 1) hk) (hfb k hk) (hfpb k hk) (hKs k hk.le) (hKs (k + 1) hk) (hcompW k hk)
        (hKΓ k hk.le) (hKΓ (k + 1) hk) (hneg k hk) hnef'
        (hrkc k hk) (hrkn k hk.le) (hrkn (k + 1) hk) (hrk k hk.le).2.1 (hrk (k + 1) hk).2.1 PV
        (hAk k hk.le) (hAk (k + 1) hk)
    have hstrict : ∀ k (hk : k < j), IsContraction ℂ (sW k) (sYs k) (f k) →
        ∀ E : MMP.Mori.PrimeDivisor (Ys k),
        (MMP.Mori.exceptionalSet (f k) : Set (Ys k)) = E.support → IsIso (fp k) →
        IsRelativelyAntiAmple (f k) (logCanonicalDivisor (Ks k) (Γs k)) →
        rk k hk.le PV.genericPoint = E.genericPoint → A k hk.le < A (k + 1) hk := by
      intro k hk hcon E hE hiso hanti hPVE
      obtain ⟨h1, h2, h3⟩ := hWinst k hk
      haveI := h1; haveI := h2; haveI := h3; haveI := hfP k hk; haveI := hfpP k hk
      haveI := hWsep k hk
      haveI := hYsep (k + 1) hk
      haveI := hiso
      haveI := hrkP k hk.le; haveI := hrkP (k + 1) hk
      haveI : MMP.Mori.IsVariety ℂ (sYs (k + 1)) := (hYn (k + 1) hk).1
      haveI : QuasiCompact (sYs (k + 1)) := (hYn (k + 1) hk).1.toQuasiCompact
      haveI : LocallyOfFiniteType (sYs (k + 1)) := (hYn (k + 1) hk).1.toLocallyOfFiniteType
      haveI : IsDominant (f k) := (hfb k hk).isDominant
      set f' : Ys k ⟶ Ys (k + 1) := f k ≫ inv (fp k) with hf'def
      have hf's : f' ≫ sYs (k + 1) = sYs k := by
        rw [hf'def, ← hfps k hk, Category.assoc, IsIso.inv_hom_id_assoc, hfs k hk]
      have hf'b : IsBirationalMorphism f' :=
        MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp (hfb k hk)
          (MMP.Mori.isBirationalMorphism_of_isIso _)
      haveI : IsDominant f' := hf'b.isDominant
      have hf'c : IsBirationalContraction ℂ (sYs (k + 1)) (sYs k) f' :=
        { isVariety_target := (hYn (k + 1) hk).1
          isVariety_source := (hYn k hk.le).1
          comp_eq := hf's
          isProper := inferInstance
          isIso_app := fun U => by
            rw [hf'def, Scheme.Hom.comp_app]
            exact @IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance
              (hcon.isIso_app ((inv (fp k)) ⁻¹ᵁ U))
          dim_eq := by
            haveI : MMP.Mori.IsVariety ℂ (f' ≫ sYs (k + 1)) := by
              rw [hf's]; exact (hYn k hk.le).1
            exact (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (sYs (k + 1))
              (f' ≫ sYs (k + 1)) hf'b).symm }
      have hE' : MMP.Flips.exceptionalSet f' = E.support := by
        rw [hf'def, exceptionalSet_comp_iso, exceptionalSet_eq_of_mori_exceptionalSet_eq (hfb k hk) hE]
      have hcomp' : RationalMap.transformDivisor (X := Ys k) f'.toRationalMap (Γs k) =
          Γs (k + 1) := by
        refine DivisorWithCoeffs.ext' fun F' => ?_
        obtain ⟨hb1, hb2⟩ := hbirW k hk _ (hbwd k hk F')
        have hc1 : Order.coheight (fp k F'.genericPoint) = 1 := by
          rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb2, F'.coheight_genericPoint]
        obtain ⟨F, hF, -⟩ := exists_primeDivisor_map_eq_of_mem_biregularLocus (f k) hb1 hc1
        obtain ⟨F'', -, huniq, -, -, hcoef⟩ :=
          exists_transformPrimeDivisor_eq_of_isOver (hψover k hk) (hdef k hk) F (hF ▸ hb1)
            (hF ▸ hb2)
        have hFF : F'' = F' := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (huniq _ hF.symm).symm
        subst hFF
        have hf'F : f' F.genericPoint = F''.genericPoint := by
          rw [hf'def, Scheme.Hom.comp_apply, hF, ← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
          rfl
        rw [coeff_transformDivisor_hom hf'b.functionFieldMap_bijective (Γs k) hf'F, hΓ k hk,
          hcoef]
      have hanti' : IsRelativelyAntiAmple f' (logCanonicalDivisor (Ks k) (Γs k)) :=
        isRelativelyAmple_comp hanti
      have hrr' : rk k hk.le ≫ f' = rk (k + 1) hk := by
        rw [hf'def, ← Category.assoc, hrkc k hk, Category.assoc, IsIso.hom_inv_id,
          Category.comp_id]
      exact isLogDiscrepancy_lt_of_isBirationalContraction (hYn (k + 1) hk) hf's (hYn k hk.le)
        hf'c hE' (hKs k hk.le) (hKs (k + 1) hk) hcomp' (hKΓ k hk.le) (hKΓ (k + 1) hk) hanti'
        hrr' (hrkn k hk.le) (hrkn (k + 1) hk) (hrk k hk.le).2.1 (hrk (k + 1) hk).2.1 PV hPVE
        (hAk k hk.le) (hAk (k + 1) hk)
    have hchain : ∀ k (hk : k ≤ j), A k hk ≤ A j le_rfl := by
      intro k hk
      induction hk using Nat.decreasingInduction with
      | self => exact le_rfl
      | of_succ k hk ih => exact (hmono k hk).trans ih
    have ha'eq : a' = A j le_rfl := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha' (hAk j le_rfl)
    rw [ha'eq]
    obtain ⟨PW, hPW, h2⟩ := hstrictW P
    have hbPV : b PV.genericPoint = PW.genericPoint :=
      eq_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective
        (by rw [← Scheme.Hom.comp_apply]; exact hPV) hPW
    by_cases hφexc : RationalMap.IsExceptional (h₀.compHom q₀) P
    · have hW₀q : IsNormalVariety ℂ (q₀ ≫ sYs 0) := by rw [hq₀s]; exact hW₀n
      haveI : LocallyOfFiniteType (sYs 0) := (hYn 0 (Nat.zero_le j)).1.toLocallyOfFiniteType
      haveI : CompactSpace W₀ := QuasiCompact.compactSpace_of_compactSpace (p₀ ≫ sX)
      obtain ⟨a₀, ha₀⟩ := exists_isLogDiscrepancy_primeDivisor (hYn 0 (Nat.zero_le j)) hW₀q hq₀b
        (hKs 0 (Nat.zero_le j)) (hKΓ 0 (Nat.zero_le j)) PW
      have hlt0 := hlt₀ P hφexc PW hPW hW₀q _ a₀ ha₀
      have hval : (⟨V, rk 0 (Nat.zero_le j), hrkn 0 (Nat.zero_le j),
          (hrk 0 (Nat.zero_le j)).2.1, PV⟩ : DivisorOver ℂ (sYs 0)).valuation =
          (⟨W₀, q₀, hW₀q, hq₀b, PW⟩ : DivisorOver ℂ (sYs 0)).valuation := by
        haveI := isIso_stalkMap_of_map_eq_genericPoint b hbb.functionFieldMap_bijective hbPV
        haveI : IsDominant (rk 0 (Nat.zero_le j)) := (hrk 0 (Nat.zero_le j)).2.1.isDominant
        refine Valuation.ext fun t => ?_
        change PV.divisorialValuation (functionFieldMap (rk 0 (Nat.zero_le j)) t) =
          PW.divisorialValuation (functionFieldMap q₀ t)
        rw [← MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply b q₀ hrk0.symm t]
        by_cases ht : functionFieldMap q₀ t = 0
        · rw [ht, map_zero, map_zero, map_zero]
        rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
          MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
          MMP.Positivity.ord_functionFieldMap_of_isIso b PV PW hbPV _]
      have h0eq := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq
        (hAk 0 (Nat.zero_le j)) ha₀ hval
      linarith [hchain 0 (Nat.zero_le j)]
    · have hnq : ¬ RationalMap.IsExceptional (X := W₀) q₀.toRationalMap PW := fun h' =>
        hφexc ((isExceptional_compHom_iff h2 q₀).mpr h')
      obtain ⟨F₀, hF₀⟩ := exists_primeDivisor_of_not_isExceptional_toRationalMap q₀ hq₀b PW hnq
      have htr0 : RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀ := by
        rw [transformPrimeDivisor_compHom h2,
          MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
        exact hF₀
      have huniq0 : ∀ P', RationalMap.transformPrimeDivisor (h₀.compHom q₀) P' = some F₀ →
          P' = P := by
        intro P' hP'
        obtain ⟨PW', hPW', h2'⟩ := hstrictW P'
        rw [transformPrimeDivisor_compHom h2',
          MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff] at hP'
        have := eq_of_map_eq_genericPoint q₀ hq₀b.functionFieldMap_bijective hP' hF₀
        exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (hPW'.symm.trans ((congrArg p₀ this).trans hPW))
      have hG0 : ∃ F : MMP.Mori.PrimeDivisor (Ys 0),
          rk 0 (Nat.zero_le j) PV.genericPoint = F.genericPoint ∧
            (Γs 0).coeff F = Δ.coeff P := by
        refine ⟨F₀, by rw [hrk0, Scheme.Hom.comp_apply, hbPV]; exact hF₀, ?_⟩
        rw [hΓ₀ F₀, if_neg (fun h' => h' P htr0), add_zero]
        exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq htr0 huniq0 Δ
      have hnotGj : ¬ ∃ F : MMP.Mori.PrimeDivisor (Ys j),
          rk j le_rfl PV.genericPoint = F.genericPoint := by
        rintro ⟨F, hF⟩
        obtain ⟨PV', hPV', h1⟩ := hstrictV P
        have hPVeq : PV' = PV := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (eq_of_map_eq_genericPoint p hpb.functionFieldMap_bijective hPV' hPV)
        subst hPVeq
        have h3 := (isExceptional_compHom_iff h1 q).mp hP
        rw [isExceptional_toRationalMap_iff_two_le_coheight] at h3
        rw [show q PV'.genericPoint = F.genericPoint from hF, F.coheight_genericPoint] at h3
        exact absurd h3 (by decide)
      have hfind : ∃ k, ∃ hk : k < j, ∃ F : MMP.Mori.PrimeDivisor (Ys k),
          rk k hk.le PV.genericPoint = F.genericPoint ∧ (Γs k).coeff F = Δ.coeff P ∧
            ¬ ∃ F' : MMP.Mori.PrimeDivisor (Ys (k + 1)),
              rk (k + 1) hk PV.genericPoint = F'.genericPoint := by
        by_contra hno
        push_neg at hno
        apply hnotGj
        have hall : ∀ k (hk : k ≤ j), ∃ F : MMP.Mori.PrimeDivisor (Ys k),
            rk k hk PV.genericPoint = F.genericPoint ∧ (Γs k).coeff F = Δ.coeff P := by
          intro k
          induction k with
          | zero => intro _; exact hG0
          | succ k ih =>
            intro hk
            obtain ⟨F, hF, hFc⟩ := ih (by omega)
            obtain ⟨F', hF'⟩ := hno k hk F hF hFc
            obtain ⟨F'', hF'', hc⟩ := htrackb k hk F' PV.genericPoint hF'
            have hFF : F'' = F := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
              (hF''.symm.trans hF)
            subst hFF
            exact ⟨F', hF', hc.trans hFc⟩
        obtain ⟨F, hF, -⟩ := hall j le_rfl
        exact ⟨F, hF⟩
      obtain ⟨k, hk, F, hF, hFc, hnot⟩ := hfind
      have hcoh : (∀ E : MMP.Mori.PrimeDivisor (Ys k),
          (MMP.Mori.exceptionalSet (f k) : Set (Ys k)) = E.support → IsIso (fp k) → F ≠ E) →
          Order.coheight (f k F.genericPoint) ≤ 1 := by
        intro hne
        obtain ⟨-, h2W, -⟩ := hWinst k hk
        haveI := h2W
        rcases hkind k hk with ⟨-, ⟨E, hE⟩, hiso, -⟩ | ⟨hsm, -, -, -⟩
        · have hb : f k F.genericPoint ∈ biregularLocus (f k) := by
            by_contra hb'
            have h1 : F.genericPoint ∈ (MMP.Mori.exceptionalSet (f k) : Set (Ys k)) :=
              MMP.Mori.mem_exceptionalSet.mpr hb'
            rw [hE] at h1
            exact genericPoint_notMem_support_of_ne (hne E hE hiso) h1
          rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb, F.coheight_genericPoint]
        · exact coheight_map_le_one_of_isSmall hsm F
      by_cases hdiv : ∃ E : MMP.Mori.PrimeDivisor (Ys k),
          (MMP.Mori.exceptionalSet (f k) : Set (Ys k)) = E.support ∧ IsIso (fp k) ∧ F = E
      · obtain ⟨E, hE, hiso, rfl⟩ := hdiv
        have hcon : IsContraction ℂ (sW k) (sYs k) (f k) ∧
            IsRelativelyAntiAmple (f k) (logCanonicalDivisor (Ks k) (Γs k)) := by
          rcases hkind k hk with ⟨hc, -, -, ha⟩ | ⟨hsm, -, -, -⟩
          · exact ⟨hc, ha⟩
          · exfalso
            obtain ⟨hW1, hW2, hW3⟩ := hWinst k hk
            haveI := hW1; haveI := hW2; haveI := hW3
            have h2 := (MMP.Flips.isSmall_iff_two_le_closedsCodimension_exceptionalSet
              hsm.toIsBirationalContraction).mp hsm
            rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h2
            haveI := hfP k hk
            have hFexc : F.genericPoint ∈ MMP.Flips.exceptionalSet (f k) := by
              rw [exceptionalSet_eq_of_mori_exceptionalSet_eq (hfb k hk) hE]
              rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
              exact subset_closure rfl
            have := h2 _ hFexc
            rw [F.coheight_genericPoint] at this
            exact absurd this (by decide)
        have hlt' := hstrict k hk hcon.1 F hE hiso hcon.2 hF
        haveI := hrkP k hk.le
        haveI : LocallyOfFiniteType (sYs k) := (hYn k hk.le).1.toLocallyOfFiniteType
        have hAk' := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hAk k hk.le)
          (isLogDiscrepancy_of_map_eq_genericPoint (hYn k hk.le) (hrkn k hk.le)
            (hrk k hk.le).2.1 (hKs k hk.le) (hKΓ k hk.le) PV F hF)
        linarith [hchain (k + 1) hk]
      · push_neg at hdiv
        obtain ⟨F', hF', -⟩ := htrack k hk F (hcoh fun E hE hiso => hdiv E hE hiso) PV.genericPoint hF
        exact absurd ⟨F', hF'⟩ hnot
  -- the end model is a log minimal model
  obtain ⟨KY, hKY⟩ := exists_isRealLogMinimalModel_of_resolution hX hXQ hZ hπ hKX hlc
    (hmod j le_rfl).1 (hmod j le_rfl).2.1 (hmod j le_rfl).2.2.2 (hmod j le_rfl).2.2.1 hdlt hnef
    hχb hχZ hΔ (W := V) (p := p) (q := q) (h := h) hVnp.1
    (by rw [hpdef, Category.assoc]; exact hbsm) (hrk j le_rfl).2.2 hpproj (hrk j le_rfl).1 hpb
    hqb hinv rfl hpq hlt
  exact ⟨χ, KY, hKY⟩

/-- **A step of a program extracts no divisor.** For a divisorial contraction (`f⁺` an
isomorphism) or a flip (`f`, `f⁺` small, `ψ` a morphism in codimension one) `ψ : Y ⤏ Y⁺` over a
normal variety `W`, every prime divisor of `Y⁺` is the transform of a prime divisor of `Y`. -/
private theorem not_isInverseExceptional_of_step {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    [IsSeparated (Y' ↘ ⊤_ Scheme)] [IsSeparated (T ↘ ⊤_ Scheme)]
    {sT : T ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)}
    (hT : IsNormalVariety ℂ sT) {f : Y ⟶ T} {fp : Y' ⟶ T} {ψ : Y.RationalMap Y'}
    [IsProper f] [IsProper fp] (hfb : IsBirationalMorphism f) (hfpb : IsBirationalMorphism fp)
    (hmodif : IsModificationOf f fp ψ)
    (hkind : IsIso fp ∨ (IsSmall ℂ sT sY f ∧ IsSmall ℂ sT sY' fp ∧
      MMP.Flips.RationalMap.IsMorphismInCodimOne ψ))
    (F' : MMP.Mori.PrimeDivisor Y') : ¬ MMP.Flips.RationalMap.IsInverseExceptional ψ F' := by
  haveI : IsIntegral T := hT.1.toIsIntegral
  haveI : IsNormal T := hT.2
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian sT
  have hψover : ψ.compHom fp = f.toRationalMap := hmodif.2
  have hdef : ∀ G : MMP.Mori.PrimeDivisor Y, RationalMap.DefinedAt ψ G.genericPoint := by
    intro G
    rcases hkind with hiso | ⟨-, -, hcod⟩
    · haveI := hiso
      have hψeq : ψ = (f ≫ inv fp).toRationalMap := by
        refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
        rw [MMP.Flips.RationalMap.fromFunctionField_hom, ← cancel_mono fp]
        have h1 := congrArg Scheme.RationalMap.fromFunctionField hψover
        rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
          MMP.Flips.RationalMap.fromFunctionField_hom] at h1
        rw [h1, Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
      rw [hψeq]
      exact RationalMap.definedAt_iff.mpr ⟨(f ≫ inv fp).toPartialMap, trivial, rfl⟩
    · exact definedAt_genericPoint_of_isMorphismInCodimOne hcod G
  have hco : Order.coheight (fp F'.genericPoint) ≤ 1 := by
    rcases hkind with hiso | ⟨-, hsm, -⟩
    · haveI := hiso
      have hb : fp F'.genericPoint ∈ biregularLocus fp :=
        MMP.Mori.le_biregularLocus ((MMP.Mori.isBiregular_top_iff fp).mpr inferInstance) trivial
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb, F'.coheight_genericPoint]
    · exact coheight_map_le_one_of_isSmall hsm F'
  have hb1 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hfb hco
  have hb2 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal fp hfpb hco
  have hc1 : Order.coheight (fp F'.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb2, F'.coheight_genericPoint]
  obtain ⟨F, hF, -⟩ := exists_primeDivisor_map_eq_of_mem_biregularLocus f hb1 hc1
  obtain ⟨F'', -, huniq, htr, -, -⟩ :=
    exists_transformPrimeDivisor_eq_of_isOver hψover hdef F (hF ▸ hb1) (hF ▸ hb2)
  have hFF : F'' = F' :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective (huniq _ hF.symm).symm
  exact fun h => h F (hFF ▸ htr)

/-- **A numerical identity survives a program.** If `α (K_0 + B_0) ≡_Z D_0` on the first model of
a sequence `Y_0 ⤏ ⋯ ⤏ Y_j` of divisorial contractions and flips over `Z` between
`ℚ`-factorial projective varieties, then `α (K_i + B_i) ≡_Z D_i` on every model, for the strict
transforms `B_i` and `D_i` and any canonical divisors `K_i`. -/
private theorem isNumericallyEquivalentOver_of_program
    {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of ℂ)} (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    {Ys : ℕ → Scheme.{0}} [∀ i, IsIntegral (Ys i)] [∀ i, CompactSpace (Ys i)]
    [∀ i, IsLocallyNoetherian (Ys i)] [∀ i, IsNormal (Ys i)] {sYs : ∀ i, Ys i ⟶ Spec (.of ℂ)}
    {πYs : ∀ i, Ys i ⟶ Z} {Ks : ∀ i, Divisor (Ys i)} (j : ℕ)
    (hmod : ∀ i ≤ j, MMP.Mori.IsProjectiveVariety ℂ (sYs i) ∧ IsQFactorial (sYs i) ∧
      (∃ m : ℕ, (Ks i).IsCanonicalDivisor (sYs i) m) ∧ πYs i ≫ sZ = sYs i)
    {W : ℕ → Scheme.{0}} {sW : ∀ i, W i ⟶ Spec (.of ℂ)} {f : ∀ i, Ys i ⟶ W i}
    {g : ∀ i, W i ⟶ Z} {fp : ∀ i, Ys (i + 1) ⟶ W i}
    {ψ : ∀ i, (Ys i).RationalMap (Ys (i + 1))}
    (hW : ∀ i < j, IsNormalVariety ℂ (sW i))
    (hfs : ∀ i < j, f i ≫ sW i = sYs i) (hfps : ∀ i < j, fp i ≫ sW i = sYs (i + 1))
    (hfg : ∀ i < j, f i ≫ g i = πYs i) (hfpg : ∀ i < j, fp i ≫ g i = πYs (i + 1))
    (hfP : ∀ i < j, IsProper (f i)) (hfpP : ∀ i < j, IsProper (fp i))
    (hfb : ∀ i < j, IsBirationalMorphism (f i)) (hfpb : ∀ i < j, IsBirationalMorphism (fp i))
    (hmodif : ∀ i < j, IsModificationOf (f i) (fp i) (ψ i))
    (hkind : ∀ i < j, IsIso (fp i) ∨ (IsSmall ℂ (sW i) (sYs i) (f i) ∧
      IsSmall ℂ (sW i) (sYs (i + 1)) (fp i) ∧ MMP.Flips.RationalMap.IsMorphismInCodimOne (ψ i)))
    {α : ℝ} (hα : α ≠ 0) {Bs Ds : ∀ i, RDivisor (Ys i)}
    (hBs : ∀ i < j, Bs (i + 1) = RationalMap.transformDivisor (ψ i) (Bs i))
    (hDs : ∀ i < j, Ds (i + 1) = RationalMap.transformDivisor (ψ i) (Ds i))
    (h0 : IsNumericallyEquivalentOver ℂ (sYs 0) (πYs 0)
      (α • logCanonicalDivisor (Ks 0) (Bs 0)) (Ds 0)) :
    ∀ i ≤ j, IsNumericallyEquivalentOver ℂ (sYs i) (πYs i)
      (α • logCanonicalDivisor (Ks i) (Bs i)) (Ds i) := by
  intro i hi
  induction i with
  | zero => exact h0
  | succ i ih =>
    have hij : i < j := hi
    obtain ⟨hYp, hYq, ⟨m, hK⟩, hπ⟩ := hmod i hij.le
    obtain ⟨hYp', hYq', ⟨m', hK'⟩, hπ'⟩ := hmod (i + 1) hi
    have hYn := hYq.1
    have hYn' := hYq'.1
    haveI : QuasiCompact (sYs i) := hYn.1.toQuasiCompact
    haveI : QuasiCompact (sYs (i + 1)) := hYn'.1.toQuasiCompact
    haveI : LocallyOfFiniteType (sYs i) := hYn.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (sYs (i + 1)) := hYn'.1.toLocallyOfFiniteType
    have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn'
    have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety (hW i hij)
    haveI := hfP i hij
    haveI := hfpP i hij
    have hfb' := hfb i hij
    have hfpb' := hfpb i hij
    haveI : IsDominant (f i) := hfb'.isDominant
    haveI : IsDominant (fp i) := hfpb'.isDominant
    haveI : MMP.Mori.IsVariety ℂ (sW i) := (hW i hij).1
    haveI : IsIntegral (W i) := (hW i hij).1.toIsIntegral
    haveI : IsNormal (W i) := (hW i hij).2
    have hmm : m' = m := by
      haveI : MMP.Mori.IsVariety ℂ (f i ≫ sW i) := by rw [hfs i hij]; exact hYn.1
      haveI : MMP.Mori.IsVariety ℂ (fp i ≫ sW i) := by rw [hfps i hij]; exact hYn'.1
      have hd : topologicalKrullDim (Ys i) = topologicalKrullDim (Ys (i + 1)) := by
        rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (sW i)
          (f i ≫ sW i) hfb']
        exact MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (sW i)
          (fp i ≫ sW i) hfpb'
      have h1 := hK.topologicalKrullDim_eq
      have h2 := hK'.topologicalKrullDim_eq
      rw [hd, h2] at h1
      exact_mod_cast h1
    subst hmm
    -- the step lies over `Z` and extracts no divisor
    have hψb : RationalMap.IsBirational (ψ i) := (hmodif i hij).1
    have hψZ : MMP.Flips.RationalMap.IsOver (πYs i) (πYs (i + 1)) (ψ i) := by
      change (ψ i).compHom (πYs (i + 1)) = (πYs i).toRationalMap
      rw [← hfpg i hij, ← MMP.Fourfold.Oai4C1.Main.compHom_compHom, (hmodif i hij).2,
        Scheme.Hom.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
        Scheme.Hom.toPartialMap_compHom, hfg i hij]
    have hψE := not_isInverseExceptional_of_step (hW i hij) hfb' hfpb' (hmodif i hij)
      (hkind i hij)
    -- the transform of the numerically trivial difference
    have hT := isNumericallyTrivialOver_sub_of_numEq (ih hij.le)
    obtain ⟨hT', -⟩ := MMP.Fourfold.isNumericallyTrivialOver_transformDivisor_and_pullback_eq
      (sYs i) (sYs (i + 1)) sZ hYq hYp hYq' hYp' hZ (πYs i) (πYs (i + 1)) hπ hπ' hψb hψZ hψE hT
    -- the transform of `K_i` is a canonical divisor
    haveI : LocallyOfFiniteType (f i ≫ sW i) := by rw [hfs i hij]; infer_instance
    haveI : LocallyOfFiniteType (fp i ≫ sW i) := by rw [hfps i hij]; infer_instance
    have hKψ : Divisor.IsCanonicalDivisor (sYs (i + 1)) m'
        (RationalMap.transformDivisor (ψ i) (Ks i)) := by
      rcases hkind i hij with hiso | ⟨hsm, hsm', -⟩
      · haveI := hiso
        have hψeq : ψ i = (f i ≫ inv (fp i)).toRationalMap := by
          refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
          rw [MMP.Flips.RationalMap.fromFunctionField_hom, ← cancel_mono (fp i)]
          have h1 := congrArg Scheme.RationalMap.fromFunctionField (hmodif i hij).2
          rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
            MMP.Flips.RationalMap.fromFunctionField_hom] at h1
          rw [h1, Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
        have hgs : (f i ≫ inv (fp i)) ≫ sYs (i + 1) = sYs i := by
          rw [← hfps i hij, Category.assoc, IsIso.inv_hom_id_assoc, hfs i hij]
        haveI : LocallyOfFiniteType ((f i ≫ inv (fp i)) ≫ sYs (i + 1)) := by
          rw [hgs]; infer_instance
        haveI : IsDominant (f i ≫ inv (fp i)) := inferInstance
        rw [hψeq]
        exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hYn'
          (by rw [hgs]; exact hYn)
          (MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hfb'
            (MMP.Mori.isBirationalMorphism_of_isIso _)) hK' (by rw [hgs]; exact hK)
      · have := MMP.Flips.IsSmall.isCanonicalDivisor_transformDivisor
          (by rw [hfs i hij]; exact hsm) (by rw [hfps i hij]; exact hsm') (hW i hij)
          (by rw [hfs i hij]; exact hYn) (by rw [hfps i hij]; exact hYn') (hmodif i hij)
          (by rw [hfs i hij]; exact hK)
        rwa [hfps i hij] at this
    have hL0 : Divisor.LinearlyEquivalent
        (RationalMap.transformDivisor (ψ i) (Ks i) - Ks (i + 1)) 0 := by
      obtain ⟨φ, hφ⟩ := MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor (sYs (i + 1))
        hYn' hKψ hK'
      exact ⟨φ, by rw [sub_zero]; exact hφ⟩
    have h1 : IsNumericallyTrivialOver ℂ (sYs (i + 1)) (πYs (i + 1))
        (α⁻¹ • RationalMap.transformDivisor (ψ i)
          (α • logCanonicalDivisor (Ks i) (Bs i) - Ds i)) := by
      have := numEq_smul hT' α⁻¹
      rw [smul_zero] at this
      exact this
    have h2 := numEq_smul (h1.sub_of_linearlyEquivalent_zero hL0) α
    rw [smul_zero] at h2
    refine numEq_of_isNumericallyTrivialOver_sub ?_ (isCartierCombination_of_isQFactorial hYq' _)
    have hsm : RationalMap.transformDivisor (ψ i) (α • logCanonicalDivisor (Ks i) (Bs i)) =
        α • RationalMap.transformDivisor (ψ i) (logCanonicalDivisor (Ks i) (Bs i)) :=
      DivisorWithCoeffs.mapPrimeDivisors_smul _ α _
    have heq : α • logCanonicalDivisor (Ks (i + 1)) (Bs (i + 1)) - Ds (i + 1) =
        α • (α⁻¹ • RationalMap.transformDivisor (ψ i)
          (α • logCanonicalDivisor (Ks i) (Bs i) - Ds i) -
          Divisor.toRDivisor (RationalMap.transformDivisor (ψ i) (Ks i) - Ks (i + 1))) := by
      rw [map_sub, hsm, smul_sub, smul_smul, mul_inv_cancel₀ hα, one_smul, hBs i hij,
        hDs i hij, logCanonicalDivisor, logCanonicalDivisor, map_add, transformDivisor_toRDivisor,
        map_sub]
      module
    rw [heq]
    exact h2

open Classical in
/-- **Log discrepancies do not decrease along a negative program.** For a program
`Y_0 ⤏ ⋯ ⤏ Y_j` of divisorial contractions and flips over `Z` with `-(K_i + Γ_i)` nef over each
contraction, a smooth projective tower `V` dominating `X` and every `Y_i` exists on which, for
every prime divisor of `V`, the log discrepancy with respect to `(Y_0, Γ_0)` is at most that with
respect to `(Y_j, Γ_j)`; the boundary `Γ_j` keeps the form `χ_* Δ + ∑ F`. -/
private theorem exists_comparison_of_program
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    {KX : Divisor X} (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m) {Δ : RDivisor X}
    (hlc : IsRealLcPair sX Δ)
    {Ys : ℕ → Scheme.{0}} [∀ i, IsIntegral (Ys i)] [∀ i, CompactSpace (Ys i)]
    [∀ i, IsLocallyNoetherian (Ys i)] [∀ i, IsNormal (Ys i)] {sYs : ∀ i, Ys i ⟶ Spec (.of ℂ)}
    {πYs : ∀ i, Ys i ⟶ Z} {Ks : ∀ i, Divisor (Ys i)} {Γs : ∀ i, RDivisor (Ys i)} (j : ℕ)
    (hmod : ∀ i ≤ j, MMP.Mori.IsProjectiveVariety ℂ (sYs i) ∧ IsQFactorial (sYs i) ∧
      (∃ m : ℕ, (Ks i).IsCanonicalDivisor (sYs i) m) ∧ πYs i ≫ sZ = sYs i)
    {W : ℕ → Scheme.{0}} {sW : ∀ i, W i ⟶ Spec (.of ℂ)} {f : ∀ i, Ys i ⟶ W i}
    {g : ∀ i, W i ⟶ Z} {fp : ∀ i, Ys (i + 1) ⟶ W i}
    {ψ : ∀ i, (Ys i).RationalMap (Ys (i + 1))}
    (hW : ∀ i < j, IsNormalVariety ℂ (sW i))
    (hfs : ∀ i < j, f i ≫ sW i = sYs i) (hfps : ∀ i < j, fp i ≫ sW i = sYs (i + 1))
    (hfg : ∀ i < j, f i ≫ g i = πYs i) (hfpg : ∀ i < j, fp i ≫ g i = πYs (i + 1))
    (hfP : ∀ i < j, IsProper (f i)) (hfpP : ∀ i < j, IsProper (fp i))
    (hfb : ∀ i < j, IsBirationalMorphism (f i)) (hfpb : ∀ i < j, IsBirationalMorphism (fp i))
    (hmodif : ∀ i < j, IsModificationOf (f i) (fp i) (ψ i))
    (hΓ : ∀ i < j, Γs (i + 1) = RationalMap.transformDivisor (ψ i) (Γs i))
    (hneg : ∀ i < j, IsRelativelyNef ℂ (sYs i) (f i) (-logCanonicalDivisor (Ks i) (Γs i)))
    (hkind : ∀ i < j,
      (IsContraction ℂ (sW i) (sYs i) (f i) ∧
        (∃ E : MMP.Mori.PrimeDivisor (Ys i),
          (MMP.Mori.exceptionalSet (f i) : Set (Ys i)) = E.support) ∧ IsIso (fp i)) ∨
      (IsSmall ℂ (sW i) (sYs i) (f i) ∧ IsSmall ℂ (sW i) (sYs (i + 1)) (fp i) ∧
        MMP.Flips.RationalMap.IsMorphismInCodimOne (ψ i) ∧
        IsRelativelyNef ℂ (sYs (i + 1)) (fp i) (logCanonicalDivisor (Ks (i + 1)) (Γs (i + 1)))))
    {W₀ : Scheme.{0}} [IsIntegral W₀] [IsLocallyNoetherian W₀] [IsNormal W₀] {p₀ : W₀ ⟶ X}
    {q₀ : W₀ ⟶ Ys 0} {h₀ : X.RationalMap W₀} (hW₀ : MMP.Mori.IsVariety ℂ (p₀ ≫ sX))
    (hW₀sm : IsSmoothScheme (p₀ ≫ sX)) (hq₀s : q₀ ≫ sYs 0 = p₀ ≫ sX)
    (hp₀ : IsProjectiveMorphism p₀) (hq₀ : IsProjectiveMorphism q₀)
    (hp₀b : IsBirationalMorphism p₀) (hq₀b : IsBirationalMorphism q₀)
    (hinv₀ : RationalMap.IsInverse p₀.toRationalMap h₀) (hpq₀ : p₀ ≫ π = q₀ ≫ πYs 0)
    (hΓ₀ : ∀ F, (Γs 0).coeff F = (RationalMap.transformDivisor (h₀.compHom q₀) Δ).coeff F +
      if MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F then 1 else 0)
    :
    ∃ (V : Scheme.{0}) (_ : IsIntegral V) (_ : IsLocallyNoetherian V) (_ : IsNormal V)
      (b : V ⟶ W₀) (q : V ⟶ Ys j) (h : X.RationalMap V),
      MMP.Mori.IsVariety ℂ (b ≫ p₀ ≫ sX) ∧ IsSmoothScheme (b ≫ p₀ ≫ sX) ∧
      IsProjectiveMorphism b ∧ IsBirationalMorphism b ∧
      IsProjectiveMorphism q ∧ IsBirationalMorphism q ∧ q ≫ sYs j = b ≫ p₀ ≫ sX ∧
      b ≫ p₀ ≫ π = q ≫ πYs j ∧ RationalMap.IsInverse (b ≫ p₀).toRationalMap h ∧
      (∀ F, (Γs j).coeff F = (RationalMap.transformDivisor (h.compHom q) Δ).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional (h.compHom q) F then 1 else 0) ∧
      (∀ (PV : MMP.Mori.PrimeDivisor V) (h0 : IsNormalVariety ℂ ((b ≫ q₀) ≫ sYs 0))
        (hb0 : IsBirationalMorphism (b ≫ q₀)) (hj : IsNormalVariety ℂ (q ≫ sYs j))
        (hbj : IsBirationalMorphism q) (n₀ n : ℕ) (a₀ a : ℝ),
        MMP.Intersection.IsLogDiscrepancy (sYs 0) n₀ (Γs 0) ⟨V, b ≫ q₀, h0, hb0, PV⟩ a₀ →
        MMP.Intersection.IsLogDiscrepancy (sYs j) n (Γs j) ⟨V, q, hj, hbj, PV⟩ a → a₀ ≤ a) ∧
      ∀ (PV : MMP.Mori.PrimeDivisor V) (F₀ : MMP.Mori.PrimeDivisor (Ys 0)),
        (b ≫ q₀) PV.genericPoint = F₀.genericPoint →
        (∀ F : MMP.Mori.PrimeDivisor (Ys j), q PV.genericPoint ≠ F.genericPoint) →
        ∃ i < j, ∃ E : MMP.Mori.PrimeDivisor (Ys i),
          (MMP.Mori.exceptionalSet (f i) : Set (Ys i)) = E.support ∧
          ∀ D : ∀ k, RDivisor (Ys k),
            (∀ k < j, D (k + 1) = RationalMap.transformDivisor (ψ k) (D k)) →
              (D i).coeff E = (D 0).coeff F₀ := by
  classical
  have hXn : IsNormalVariety ℂ sX := hlc.1
  haveI := hXn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  haveI : X.IsSeparated := ⟨by
    rw [show Limits.terminal.from X = (X ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance⟩
  have hYn : ∀ i ≤ j, IsNormalVariety ℂ (sYs i) := fun i hi => (hmod i hi).2.1.1
  have hYsep : ∀ i ≤ j, IsSeparated (Ys i ↘ ⊤_ Scheme) := fun i hi =>
    MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety (hYn i hi)
  have hWsep : ∀ i < j, IsSeparated (W i ↘ ⊤_ Scheme) := fun i hi =>
    MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety (hW i hi)
  have hKΓ : ∀ i ≤ j, IsCartierCombination (logCanonicalDivisor (Ks i) (Γs i)) := fun i hi =>
    isCartierCombination_of_isQFactorial (hmod i hi).2.1 _
  -- the tower of resolutions
  have hV₀ : MMP.Mori.IsProjectiveVariety ℂ (p₀ ≫ sX) :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ (p₀ ≫ sX)).mpr ⟨hW₀, hp₀.comp hX.isProjective⟩
  obtain ⟨V, _, _, _, b, r, hbv, hbsm, hbp, hbb, hr, hr0, hcomm⟩ :=
    exists_tower (Y := Ys) j hYn (fun i hi => (hmod i hi).1) hWsep f fp ψ hfs hfps
      (fun i hi => (hmodif i hi).1) (fun i hi => (hmodif i hi).2) hV₀ hW₀sm hq₀ hq₀b hq₀s j
      le_rfl
  set p : V ⟶ X := b ≫ p₀ with hpdef
  set q : V ⟶ Ys j := r (Fin.last j) with hqdef
  have hpb : IsBirationalMorphism p := MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hbb hp₀b
  have hpproj : IsProjectiveMorphism p := hbp.comp hp₀
  haveI : IsProper p := isProper_of_isProjectiveMorphism p hpproj
  haveI : IsDominant p := hpb.isDominant
  haveI : IsProper b := isProper_of_isProjectiveMorphism b hbp
  haveI : IsDominant b := hbb.isDominant
  haveI : IsProper p₀ := isProper_of_isProjectiveMorphism p₀ hp₀
  haveI : IsDominant p₀ := hp₀b.isDominant
  haveI : IsProper q₀ := isProper_of_isProjectiveMorphism q₀ hq₀
  haveI : IsDominant q₀ := hq₀b.isDominant
  have hVnp : IsNormalVariety ℂ (p ≫ sX) := ⟨by rw [hpdef, Category.assoc]; exact hbv,
    inferInstance⟩
  haveI : LocallyOfFiniteType (p ≫ sX) := hVnp.1.toLocallyOfFiniteType
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hVnp
  have hW₀n : IsNormalVariety ℂ (p₀ ≫ sX) := ⟨hW₀, inferInstance⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hW₀n
  haveI : IsSeparated p := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  haveI : IsSeparated p₀ := IsSeparated.of_comp p₀ (X ↘ ⊤_ Scheme)
  -- the morphisms `r_k : V ⟶ Y_k`
  set rk : ∀ k, k ≤ j → (V ⟶ Ys k) := fun k hk => r ⟨k, Nat.lt_succ_of_le hk⟩ with hrkdef
  have hrk : ∀ k (hk : k ≤ j), IsProjectiveMorphism (rk k hk) ∧ IsBirationalMorphism (rk k hk) ∧
      rk k hk ≫ sYs k = p ≫ sX := fun k hk => by
    obtain ⟨h1, h2, h3⟩ := hr ⟨k, Nat.lt_succ_of_le hk⟩
    exact ⟨h1, h2, by rw [hpdef, Category.assoc]; exact h3⟩
  have hrkn : ∀ k (hk : k ≤ j), IsNormalVariety ℂ (rk k hk ≫ sYs k) := fun k hk => by
    rw [(hrk k hk).2.2]; exact hVnp
  have hrkc : ∀ k (hk : k < j), rk k hk.le ≫ f k = rk (k + 1) hk ≫ fp k := fun k hk =>
    hcomm ⟨k, hk⟩
  have hrk0 : rk 0 (Nat.zero_le j) = b ≫ q₀ := hr0
  have hqrk : q = rk j le_rfl := rfl
  have hrkP : ∀ k (hk : k ≤ j), IsProper (rk k hk) := fun k hk =>
    isProper_of_isProjectiveMorphism _ (hrk k hk).1
  -- the tower lies over `Z`
  have hZtower : ∀ k (hk : k ≤ j), rk k hk ≫ πYs k = p ≫ π := by
    intro k
    induction k with
    | zero => intro hk; rw [hrk0, Category.assoc, ← hpq₀, hpdef, Category.assoc]
    | succ k ih =>
      intro hk
      rw [← hfpg k hk, ← Category.assoc, ← hrkc k hk, Category.assoc, hfg k hk]
      exact ih (Nat.le_of_succ_le hk)
  have hpq : p ≫ π = q ≫ πYs j := (hZtower j le_rfl).symm
  -- the composite birational map `χ = q ∘ p⁻¹`
  obtain ⟨ep, hep⟩ := id hpb
  set h : X.RationalMap V := ep.symm.toRationalMap with hhdef
  have hinv : RationalMap.IsInverse p.toRationalMap h := ⟨ep, hep, rfl⟩
  have hqb : IsBirationalMorphism q := (hrk j le_rfl).2.1
  set χ : X.RationalMap (Ys j) := h.compHom q with hχdef
  have hχb : RationalMap.IsBirational χ := isBirational_compHom_of_isBirationalMorphism ep.symm hqb
  have hχZ : MMP.Flips.RationalMap.IsOver π (πYs j) χ := by
    change χ.compHom (πYs j) = π.toRationalMap
    refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
    rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
      MMP.Flips.RationalMap.fromFunctionField_compHom, MMP.Flips.RationalMap.fromFunctionField_hom,
      Category.assoc, ← hpq, ← Category.assoc, fromFunctionField_comp_of_isInverse hinv]
  -- facts about the steps
  have hψover : ∀ i (hi : i < j), (ψ i).compHom (fp i) = (f i).toRationalMap :=
    fun i hi => (hmodif i hi).2
  have hWinst : ∀ i < j, IsIntegral (W i) ∧ IsNormal (W i) ∧ IsLocallyNoetherian (W i) :=
    fun i hi => ⟨(hW i hi).1.toIsIntegral, (hW i hi).2, by
      haveI : LocallyOfFiniteType (sW i) := (hW i hi).1.toLocallyOfFiniteType
      exact LocallyOfFiniteType.isLocallyNoetherian (sW i)⟩
  have hdef : ∀ i (hi : i < j) (G : MMP.Mori.PrimeDivisor (Ys i)),
      RationalMap.DefinedAt (ψ i) G.genericPoint := by
    intro i hi G
    rcases hkind i hi with ⟨-, -, hiso⟩ | ⟨-, -, hcod, -⟩
    · haveI := hYsep (i + 1) hi
      have hψeq : ψ i = (f i ≫ inv (fp i)).toRationalMap := by
        refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
        rw [MMP.Flips.RationalMap.fromFunctionField_hom, ← cancel_mono (fp i)]
        have h1 := congrArg Scheme.RationalMap.fromFunctionField (hψover i hi)
        rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
          MMP.Flips.RationalMap.fromFunctionField_hom] at h1
        rw [h1, Category.assoc, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
      rw [hψeq]
      exact RationalMap.definedAt_iff.mpr ⟨(f i ≫ inv (fp i)).toPartialMap, trivial, rfl⟩
    · exact definedAt_genericPoint_of_isMorphismInCodimOne hcod G
  have hbirW : ∀ i (hi : i < j) (w : W i), Order.coheight w ≤ 1 →
      w ∈ biregularLocus (f i) ∧ w ∈ biregularLocus (fp i) := by
    intro i hi w hw
    obtain ⟨h1, h2, h3⟩ := hWinst i hi
    haveI := h1; haveI := h2; haveI := h3; haveI := hfP i hi; haveI := hfpP i hi
    exact ⟨MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal _ (hfb i hi) hw,
      MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal _ (hfpb i hi) hw⟩
  have hbwd : ∀ i (hi : i < j) (F' : MMP.Mori.PrimeDivisor (Ys (i + 1))),
      Order.coheight (fp i F'.genericPoint) ≤ 1 := by
    intro i hi F'
    obtain ⟨-, h2, -⟩ := hWinst i hi
    haveI := h2
    rcases hkind i hi with ⟨-, -, hiso⟩ | ⟨-, hsm, -, -⟩
    · haveI := hiso
      have hb : fp i F'.genericPoint ∈ biregularLocus (fp i) :=
        MMP.Mori.le_biregularLocus ((MMP.Mori.isBiregular_top_iff (fp i)).mpr inferInstance)
          trivial
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb, F'.coheight_genericPoint]
    · exact coheight_map_le_one_of_isSmall hsm F'
  -- tracking prime divisors along the steps
  have htrack : ∀ i (hi : i < j) (F : MMP.Mori.PrimeDivisor (Ys i)),
      Order.coheight (f i F.genericPoint) ≤ 1 → ∀ v : V, rk i hi.le v = F.genericPoint →
      ∃ F' : MMP.Mori.PrimeDivisor (Ys (i + 1)), rk (i + 1) hi v = F'.genericPoint ∧
        (Γs (i + 1)).coeff F' = (Γs i).coeff F := by
    intro i hi F hF v hv
    haveI := hWsep i hi
    haveI := hYsep (i + 1) hi
    obtain ⟨hb1, hb2⟩ := hbirW i hi _ hF
    obtain ⟨F', hF', huniq, -, -, hcoef⟩ :=
      exists_transformPrimeDivisor_eq_of_isOver (hψover i hi) (hdef i hi) F hb1 hb2
    refine ⟨F', huniq _ ?_, by rw [hΓ i hi, hcoef]⟩
    rw [← Scheme.Hom.comp_apply, ← hrkc i hi, Scheme.Hom.comp_apply, hv]
  have htrackb : ∀ i (hi : i < j) (F' : MMP.Mori.PrimeDivisor (Ys (i + 1))) (v : V),
      rk (i + 1) hi v = F'.genericPoint →
      ∃ F : MMP.Mori.PrimeDivisor (Ys i), rk i hi.le v = F.genericPoint ∧
        (Γs (i + 1)).coeff F' = (Γs i).coeff F := by
    intro i hi F' v hv
    haveI := hWsep i hi
    haveI := hYsep (i + 1) hi
    obtain ⟨hb1, hb2⟩ := hbirW i hi _ (hbwd i hi F')
    have hc1 : Order.coheight (fp i F'.genericPoint) = 1 := by
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb2, F'.coheight_genericPoint]
    obtain ⟨F, hF, huniqF⟩ := exists_primeDivisor_map_eq_of_mem_biregularLocus (f i) hb1 hc1
    obtain ⟨F'', -, huniq, -, -, hcoef⟩ :=
      exists_transformPrimeDivisor_eq_of_isOver (hψover i hi) (hdef i hi) F (hF ▸ hb1)
        (hF ▸ hb2)
    have hFF : F'' = F' := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (huniq _ hF.symm).symm
    refine ⟨F, huniqF _ ?_, by rw [← hFF, hΓ i hi, hcoef]⟩
    rw [← Scheme.Hom.comp_apply, hrkc i hi, Scheme.Hom.comp_apply, hv]
  -- the boundary of the end model
  haveI : IsSeparated q := isSeparated_of_isSeparated_toTerminal q
  have := hYsep 0 (Nat.zero_le j)
  have := hYsep j le_rfl
  haveI : IsSeparated q₀ := isSeparated_of_isSeparated_toTerminal q₀
  haveI : IsSeparated b := isSeparated_of_isSeparated_toTerminal b
  haveI : IsProper q := isProper_of_isProjectiveMorphism q (hrk j le_rfl).1
  haveI : IsDominant q := hqb.isDominant
  have hstrictW : ∀ P : MMP.Mori.PrimeDivisor X, ∃ PW : MMP.Mori.PrimeDivisor W₀,
      p₀ PW.genericPoint = P.genericPoint ∧
        RationalMap.transformPrimeDivisor h₀ P = some PW := fun P => by
    obtain ⟨PW, hPW, -, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hW₀n hp₀b P
    exact ⟨PW, hPW,
      transformPrimeDivisor_eq_some_of_isInverse hp₀b.functionFieldMap_bijective hinv₀ hPW⟩
  have hstrictV : ∀ P : MMP.Mori.PrimeDivisor X, ∃ PV : MMP.Mori.PrimeDivisor V,
      p PV.genericPoint = P.genericPoint ∧
        RationalMap.transformPrimeDivisor h P = some PV := fun P => by
    obtain ⟨PV, hPV, -, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hVnp hpb P
    exact ⟨PV, hPV,
      transformPrimeDivisor_eq_some_of_isInverse hpb.functionFieldMap_bijective hinv hPV⟩
  have hΔ : ∀ F, (Γs j).coeff F = (RationalMap.transformDivisor χ Δ).coeff F +
      if MMP.Flips.RationalMap.IsInverseExceptional χ F then 1 else 0 := by
    intro F
    haveI := hrkP j le_rfl
    obtain ⟨FV, hFVη, -, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0}
      (hYn j le_rfl) (hrkn j le_rfl) hqb F
    have hback : ∀ k (hk : k ≤ j), ∃ Fk : MMP.Mori.PrimeDivisor (Ys k),
        rk k hk FV.genericPoint = Fk.genericPoint ∧ (Γs k).coeff Fk = (Γs j).coeff F := by
      intro k hk
      induction hk using Nat.decreasingInduction with
      | self => exact ⟨F, hFVη, rfl⟩
      | of_succ k hk ih =>
        obtain ⟨Fk1, h1, h2⟩ := ih
        obtain ⟨Fk, h3, h4⟩ := htrackb k hk Fk1 FV.genericPoint h1
        exact ⟨Fk, h3, h4.symm.trans h2⟩
    obtain ⟨F₀, hF₀η, hF₀Γ⟩ := hback 0 (Nat.zero_le j)
    rw [← hF₀Γ, hΓ₀ F₀]
    set w := b FV.genericPoint with hwdef
    have hqw : q₀ w = F₀.genericPoint := by
      rw [hwdef, ← Scheme.Hom.comp_apply, ← hrk0]; exact hF₀η
    have hφP : ∀ P, RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀ →
        p₀ w = P.genericPoint := by
      intro P hP
      obtain ⟨PW, hPW, h2⟩ := hstrictW P
      rw [transformPrimeDivisor_compHom h2,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff] at hP
      rw [← eq_of_map_eq_genericPoint q₀ hq₀b.functionFieldMap_bijective hP hqw]; exact hPW
    have hiff : ∀ P : MMP.Mori.PrimeDivisor X,
        RationalMap.transformPrimeDivisor χ P = some F ↔
          RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀ := by
      intro P
      obtain ⟨PV, hPV, h1⟩ := hstrictV P
      obtain ⟨PW, hPW, h2⟩ := hstrictW P
      rw [hχdef, transformPrimeDivisor_compHom h1, transformPrimeDivisor_compHom h2,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff,
        MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
      constructor
      · intro hq
        have hPVFV : PV.genericPoint = FV.genericPoint :=
          eq_of_map_eq_genericPoint q hqb.functionFieldMap_bijective hq hFVη
        have hpw : p₀ w = P.genericPoint := by
          rw [hwdef, ← Scheme.Hom.comp_apply, ← hPVFV]; exact hPV
        rw [← eq_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective hpw hPW]; exact hqw
      · intro hq
        have hwPW : PW.genericPoint = w :=
          eq_of_map_eq_genericPoint q₀ hq₀b.functionFieldMap_bijective hq hqw
        have hpFV : p FV.genericPoint = P.genericPoint := by
          rw [hpdef, Scheme.Hom.comp_apply, ← hwdef, ← hwPW]; exact hPW
        rw [← eq_of_map_eq_genericPoint p hpb.functionFieldMap_bijective hpFV hPV]; exact hFVη
    have hinvexc : MMP.Flips.RationalMap.IsInverseExceptional χ F ↔
        MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F₀ :=
      forall_congr' fun P => not_congr (hiff P)
    have hcoef : (RationalMap.transformDivisor χ Δ).coeff F =
        (RationalMap.transformDivisor (h₀.compHom q₀) Δ).coeff F₀ := by
      by_cases hex : ∃ P, RationalMap.transformPrimeDivisor (h₀.compHom q₀) P = some F₀
      · obtain ⟨P, hP⟩ := hex
        have huniq : ∀ P', RationalMap.transformPrimeDivisor (h₀.compHom q₀) P' = some F₀ →
            P' = P := fun P' hP' => AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          ((hφP P' hP').symm.trans (hφP P hP))
        exact (MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq ((hiff P).mpr hP)
          (fun P' h' => huniq P' ((hiff P').mp h')) Δ).trans
          (MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hP huniq Δ).symm
      · push_neg at hex
        exact (MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne
          (fun P h' => hex P ((hiff P).mp h')) Δ).trans
          (MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne hex Δ).symm
    rw [hcoef]
    by_cases hie : MMP.Flips.RationalMap.IsInverseExceptional χ F
    · rw [if_pos hie, if_pos (hinvexc.mp hie)]
    · rw [if_neg hie, if_neg (fun h' => hie (hinvexc.mpr h'))]
  -- the comparison of log discrepancies along the steps
  have hcompW : ∀ k (hk : k < j),
      RationalMap.transformDivisor (X := Ys k) (f k).toRationalMap (Γs k) =
        RationalMap.transformDivisor (X := Ys (k + 1)) (fp k).toRationalMap (Γs (k + 1)) := by
    intro k hk
    obtain ⟨h1, h2, h3⟩ := hWinst k hk
    haveI := h1; haveI := h2; haveI := h3; haveI := hfP k hk; haveI := hfpP k hk
    haveI := hWsep k hk
    haveI := hYsep (k + 1) hk
    haveI : IsDominant (f k) := (hfb k hk).isDominant
    haveI : IsDominant (fp k) := (hfpb k hk).isDominant
    refine DivisorWithCoeffs.ext' fun T => ?_
    obtain ⟨hb1, hb2⟩ := hbirW k hk _ T.coheight_genericPoint.le
    obtain ⟨F, hF, -⟩ :=
      exists_primeDivisor_map_eq_of_mem_biregularLocus (f k) hb1 T.coheight_genericPoint
    obtain ⟨F', hF', -⟩ :=
      exists_primeDivisor_map_eq_of_mem_biregularLocus (fp k) hb2 T.coheight_genericPoint
    obtain ⟨F'', -, huniq, -, -, hcoef⟩ :=
      exists_transformPrimeDivisor_eq_of_isOver (hψover k hk) (hdef k hk) F (hF ▸ hb1) (hF ▸ hb2)
    have hFF : F'' = F' := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (huniq _ (hF'.trans hF.symm)).symm
    subst hFF
    rw [coeff_transformDivisor_hom (hfb k hk).functionFieldMap_bijective (Γs k) hF,
      coeff_transformDivisor_hom (hfpb k hk).functionFieldMap_bijective (Γs (k + 1)) hF',
      hΓ k hk, hcoef]
  have hKs : ∀ k (hk : k ≤ j), (Ks k).IsCanonicalDivisor (sYs k) (hmod k hk).2.2.1.choose :=
    fun k hk => (hmod k hk).2.2.1.choose_spec
  -- a prime divisor of `Y_0` contracted on `Y_j` is the exceptional divisor of some step
  have hcontr : ∀ (PV : MMP.Mori.PrimeDivisor V) (F₀ : MMP.Mori.PrimeDivisor (Ys 0)),
      (b ≫ q₀) PV.genericPoint = F₀.genericPoint →
      (∀ F : MMP.Mori.PrimeDivisor (Ys j), q PV.genericPoint ≠ F.genericPoint) →
      ∃ i < j, ∃ E : MMP.Mori.PrimeDivisor (Ys i),
        (MMP.Mori.exceptionalSet (f i) : Set (Ys i)) = E.support ∧
        ∀ D : ∀ k, RDivisor (Ys k),
          (∀ k < j, D (k + 1) = RationalMap.transformDivisor (ψ k) (D k)) →
            (D i).coeff E = (D 0).coeff F₀ := by
    intro PV F₀ hF₀ hq
    by_contra hne
    push Not at hne
    have hall : ∀ k (hk : k ≤ j), ∃ Fk : MMP.Mori.PrimeDivisor (Ys k),
        rk k hk PV.genericPoint = Fk.genericPoint ∧
        ∀ D : ∀ k, RDivisor (Ys k),
          (∀ k < j, D (k + 1) = RationalMap.transformDivisor (ψ k) (D k)) →
            (D k).coeff Fk = (D 0).coeff F₀ := by
      intro k hk
      induction k with
      | zero => exact ⟨F₀, by rw [hrk0]; exact hF₀, fun D _ => rfl⟩
      | succ k ih =>
        obtain ⟨Fk, hFk, hcoefk⟩ := ih (Nat.le_of_succ_le hk)
        have hkj : k < j := hk
        haveI := hWsep k hkj
        haveI := hYsep (k + 1) hkj
        obtain ⟨hWi1, hWi2, hWi3⟩ := hWinst k hkj
        haveI := hWi1; haveI := hWi2; haveI := hWi3
        have hco : Order.coheight (f k Fk.genericPoint) ≤ 1 := by
          by_contra hco
          have hexc : Fk.genericPoint ∈ (MMP.Mori.exceptionalSet (f k) : Set (Ys k)) :=
            MMP.Mori.mem_exceptionalSet.mpr fun hb => hco (le_of_eq (by
              rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb,
                Fk.coheight_genericPoint]))
          rcases hkind k hkj with ⟨-, ⟨E, hE⟩, -⟩ | ⟨hsm, -, -, -⟩
          · have hFE : E = Fk := eq_of_genericPoint_mem_support (hE ▸ hexc)
            subst hFE
            obtain ⟨D, hD, hDne⟩ := hne k hkj E hE
            exact hDne (hcoefk D hD)
          · exact hco (coheight_map_le_one_of_isSmall hsm Fk)
        obtain ⟨hb1, hb2⟩ := hbirW k hkj _ hco
        obtain ⟨F', hF', huniq, -, -, hcoef⟩ :=
          exists_transformPrimeDivisor_eq_of_isOver (hψover k hkj) (hdef k hkj) Fk hb1 hb2
        refine ⟨F', huniq _ ?_, fun D hD => ?_⟩
        · rw [← Scheme.Hom.comp_apply, ← hrkc k hkj, Scheme.Hom.comp_apply, hFk]
        · rw [hD k hkj, hcoef, hcoefk D hD]
    obtain ⟨Fj, hFj, -⟩ := hall j le_rfl
    exact hq Fj (by rw [hqrk]; exact hFj)
  refine ⟨V, inferInstance, inferInstance, inferInstance, b, q, h, hbv, hbsm, hbp, hbb,
    (hrk j le_rfl).1, hqb, (hr (Fin.last j)).2.2,
    by rw [← Category.assoc]; exact hpq, hinv, hΔ, ?_, hcontr⟩
  intro PV h0 hb0 hj hbj n₀ n a₀ a ha₀ ha
  have hA : ∀ k (hk : k ≤ j), ∃ a, MMP.Intersection.IsLogDiscrepancy (sYs k)
      (hmod k hk).2.2.1.choose (Γs k) ⟨V, rk k hk, hrkn k hk, (hrk k hk).2.1, PV⟩ a :=
    fun k hk => by
      haveI := hrkP k hk
      haveI : LocallyOfFiniteType (sYs k) := (hYn k hk).1.toLocallyOfFiniteType
      exact exists_isLogDiscrepancy_primeDivisor (hYn k hk) (hrkn k hk) (hrk k hk).2.1
        (hKs k hk) (hKΓ k hk) PV
  choose A hAk using hA
  have hmono : ∀ k (hk : k < j), A k hk.le ≤ A (k + 1) hk := by
    intro k hk
    obtain ⟨h1, h2, h3⟩ := hWinst k hk
    haveI := h1; haveI := h2; haveI := h3; haveI := hfP k hk; haveI := hfpP k hk
    haveI := hrkP k hk.le; haveI := hrkP (k + 1) hk
    haveI : LocallyOfFiniteType (sW k) := (hW k hk).1.toLocallyOfFiniteType
    haveI : QuasiCompact (sW k) := (hW k hk).1.toQuasiCompact
    haveI : QuasiCompact (sYs k) := (hYn k hk.le).1.toQuasiCompact
    haveI : QuasiCompact (sYs (k + 1)) := (hYn (k + 1) hk).1.toQuasiCompact
    have hnef' : IsRelativelyNef ℂ (sYs (k + 1)) (fp k)
        (logCanonicalDivisor (Ks (k + 1)) (Γs (k + 1))) := by
      rcases hkind k hk with ⟨-, -, hiso⟩ | ⟨-, -, -, hn⟩
      · haveI := hiso
        exact isRelativelyNef_of_injective (fp k).isOpenEmbedding.injective (hKΓ (k + 1) hk)
      · exact hn
    exact isLogDiscrepancy_le_of_step (hW k hk) (hfs k hk) (hfps k hk) (hYn k hk.le)
      (hYn (k + 1) hk) (hfb k hk) (hfpb k hk) (hKs k hk.le) (hKs (k + 1) hk) (hcompW k hk)
      (hKΓ k hk.le) (hKΓ (k + 1) hk) (hneg k hk) hnef'
      (hrkc k hk) (hrkn k hk.le) (hrkn (k + 1) hk) (hrk k hk.le).2.1 (hrk (k + 1) hk).2.1 PV
      (hAk k hk.le) (hAk (k + 1) hk)
  have hchain : ∀ k (hk : k ≤ j), A k hk ≤ A j le_rfl := by
    intro k hk
    induction hk using Nat.decreasingInduction with
    | self => exact le_rfl
    | of_succ k hk ih => exact (hmono k hk).trans ih
  have haeq : a = A j le_rfl := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha (hAk j le_rfl)
  have hval : (⟨V, rk 0 (Nat.zero_le j), hrkn 0 (Nat.zero_le j),
      (hrk 0 (Nat.zero_le j)).2.1, PV⟩ : DivisorOver ℂ (sYs 0)).valuation =
      (⟨V, b ≫ q₀, h0, hb0, PV⟩ : DivisorOver ℂ (sYs 0)).valuation := by
    haveI : IsDominant (rk 0 (Nat.zero_le j)) := (hrk 0 (Nat.zero_le j)).2.1.isDominant
    haveI : IsDominant (b ≫ q₀) := hb0.isDominant
    refine Valuation.ext fun t => ?_
    change PV.divisorialValuation (functionFieldMap (rk 0 (Nat.zero_le j)) t) =
      PV.divisorialValuation (functionFieldMap (b ≫ q₀) t)
    exact congrArg _ ((MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply b q₀ hrk0.symm t).symm.trans
      (MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply b q₀ rfl t))
  have h0eq := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq
    (hAk 0 (Nat.zero_le j)) ha₀ hval
  rw [haeq, ← h0eq]
  exact hchain 0 (Nat.zero_le j)

end Program

section Thresholds

/-! ### Negativity of the steps of a program with scaling at a lower level -/

open MMP.Mori

/-- A positive real function on a finite set has a positive lower bound there. -/
private theorem exists_pos_forall_le_of_finite {α : Type*} {S : Set α} (hS : S.Finite)
    (g : α → ℝ) (hg : ∀ a ∈ S, 0 < g a) : ∃ ε > 0, ∀ a ∈ S, ε ≤ g a := by
  classical
  obtain ⟨T, rfl⟩ := hS.exists_finset_coe
  refine ⟨(insert 1 (T.image g)).min' (Finset.insert_nonempty _ _), ?_, fun a ha =>
    Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem g ha))⟩
  show 0 < _
  rw [Finset.lt_min'_iff]
  intro y hy
  rcases Finset.mem_insert.mp hy with rfl | hy
  · exact one_pos
  · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
    exact hg a ha

/-- A proper birational morphism onto a normal scheme whose exceptional locus is a prime divisor
contracts a proper curve. -/
private theorem exists_properCurve_isContractedBy_of_exceptionalSet_eq {Y T : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] {sY : Y ⟶ Spec (.of ℂ)} [IsProper sY]
    [IsIntegral T] [IsNormal T] {f : Y ⟶ T} [IsProper f] (hf : IsBirationalMorphism f)
    {E : MMP.Mori.PrimeDivisor Y} (hE : (MMP.Mori.exceptionalSet f : Set Y) = E.support) :
    ∃ C : ProperCurve sY, C.IsContractedBy f := by
  by_contra hno
  haveI : LocallyQuasiFinite f := by
    by_contra h
    exact hno (MMP.Fourfold.exists_properCurve_isContractedBy_of_not_locallyQuasiFinite h)
  haveI : IsFinite f := IsFinite.of_isProper_of_locallyQuasiFinite f
  haveI : IsIso f := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso f
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hf)).2 inferInstance
  have hb : f E.genericPoint ∈ biregularLocus f :=
    MMP.Mori.le_biregularLocus ((MMP.Mori.isBiregular_top_iff f).mpr inferInstance) trivial
  have hη : E.genericPoint ∈ (MMP.Mori.exceptionalSet f : Set Y) := by
    rw [hE, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  exact (MMP.Mori.mem_exceptionalSet.mp hη) hb

variable {k : Type} [Field k] {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [QuasiCompact sY]
  [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]

/-- **Negativity at a level forces the level below the threshold.** Let `f : Y ⟶ T` contract a
proper curve, with `-(K + B)` `f`-ample and `K + B + λ C ≡_f 0`. If `K + B + u C` is `f`-anti-ample
or `f`-numerically trivial, then `u ≤ λ`, and `u = λ` in the numerically trivial case. -/
private theorem le_of_isRelativelyAntiAmple_or_isNumericallyTrivialOver {f : Y ⟶ T}
    (hC : ∃ Γ : ProperCurve sY, Γ.IsContractedBy f) {D C : RDivisor Y}
    (hD : IsRelativelyAntiAmple f D) (hCc : IsCartierCombination C) {lam u : ℝ}
    (hlam : 0 ≤ lam) (htriv : IsNumericallyTrivialOver k sY f (D + lam • C))
    (hu : IsRelativelyAntiAmple f (D + u • C) ∨ IsNumericallyTrivialOver k sY f (D + u • C)) :
    u ≤ lam ∧ (IsNumericallyTrivialOver k sY f (D + u • C) → u = lam) := by
  obtain ⟨Γ, hΓ⟩ := hC
  have hDc : IsCartierCombination D := by
    obtain ⟨m, r, L, -, -, hL, hD'⟩ := hD
    refine ⟨m, -r, L, fun j => (hL j).1, ?_⟩
    rw [← neg_neg D, hD']
    simp [neg_smul, Finset.sum_neg_distrib, MMP.Flips.toRDivisor_eq_mapCoeffs]
  obtain ⟨_, rD, LD, x, hx⟩ := exists_isRIntersectionNumber (k := k) hDc Γ
  obtain ⟨_, rC, LC, c, hc⟩ := exists_isRIntersectionNumber (k := k) hCc Γ
  have hl := IsRIntersectionNumber.eq_and_linear k sY Γ
  have hlin : ∀ a b : ℝ, ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor Y),
      IsRIntersectionNumber k sY (a • D + b • C) r L Γ (a * x + b * c) :=
    fun a b => ⟨_, _, _, hl.2 _ _ _ _ _ _ _ _ a b hx hc⟩
  -- the degree of an anti-ample divisor is negative
  have hnegdeg : ∀ s : ℝ, IsRelativelyAntiAmple f (D + s • C) → x + s * c < 0 := by
    intro s hs
    obtain ⟨_, r, L, h⟩ := hlin (-1) (-s)
    have he : (-1 : ℝ) • D + (-s) • C = -(D + s • C) := by
      rw [neg_add, neg_one_smul, neg_smul]
    rw [he] at h
    have := pos_of_isRelativelyAmple hs Γ hΓ h
    linarith
  -- the degree of a numerically trivial divisor vanishes
  have hzerodeg : ∀ s : ℝ, IsNumericallyTrivialOver k sY f (D + s • C) → x + s * c = 0 := by
    intro s hs
    obtain ⟨_, r, L, h⟩ := hlin 1 s
    rw [one_smul, one_mul] at h
    obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := k) hs.2.1 Γ
    have h00 := hl.2 _ _ _ _ _ _ _ _ 0 0 hy hy
    simp only [zero_smul, add_zero] at h00
    have hy0 := hl.1 _ _ _ _ _ _ _ hy h00
    rw [hs.2.2 Γ hΓ _ _ _ _ _ _ _ _ h hy, hy0]
    ring
  have hxneg : x < 0 := by
    have := hnegdeg 0 (by rwa [zero_smul, add_zero])
    linarith
  have hzero := hzerodeg lam htriv
  have hlampos : 0 < lam := by
    rcases hlam.lt_or_eq with h | h
    · exact h
    · rw [← h] at hzero; linarith
  have hcpos : 0 < c := by nlinarith
  have hule : x + u * c ≤ 0 := by
    rcases hu with hamp | htr
    · exact (hnegdeg u hamp).le
    · exact (hzerodeg u htr).le
  refine ⟨?_, fun htr => ?_⟩
  · by_contra h
    push_neg at h
    nlinarith
  · have h1 := hzerodeg u htr
    have h2 : (u - lam) * c = 0 := by linarith
    rcases mul_eq_zero.mp h2 with h | h
    · linarith
    · linarith

/-- **The scaling threshold is the least nef level.** Let `f : Y ⟶ T` be a morphism over `S`
contracting a proper curve, with `-D` `f`-ample, `D + λ C ≡_f 0` for some `λ > 0`, and `D + λ C`
nef over `S`. Then `λ` is the least `t ≥ 0` with `D + t C` nef over `S`. -/
private theorem isLeast_of_isNumericallyTrivialOver {S : Scheme.{0}} {f : Y ⟶ T} {h : T ⟶ S}
    {π : Y ⟶ S} (hfh : f ≫ h = π) (hC : ∃ Γ : ProperCurve sY, Γ.IsContractedBy f)
    {D C : RDivisor Y} (hD : IsRelativelyAntiAmple f D) (hCc : IsCartierCombination C) {lam : ℝ}
    (hlam : 0 < lam) (htriv : IsNumericallyTrivialOver k sY f (D + lam • C))
    (hnef : IsRelativelyNef k sY π (D + lam • C)) :
    IsLeast {t : ℝ | 0 ≤ t ∧ IsRelativelyNef k sY π (D + t • C)} lam := by
  refine ⟨⟨hlam.le, hnef⟩, fun t ⟨ht0, htnef⟩ => ?_⟩
  obtain ⟨Γ, hΓ⟩ := hC
  have hΓπ : Γ.IsContractedBy π := fun y hy => by
    rw [← hfh]
    change h (f y) = h (f Γ.point)
    rw [hΓ y hy]
  have hDc : IsCartierCombination D := by
    obtain ⟨m, r, L, -, -, hL, hD'⟩ := hD
    refine ⟨m, -r, L, fun j => (hL j).1, ?_⟩
    rw [← neg_neg D, hD']
    simp [neg_smul, Finset.sum_neg_distrib, MMP.Flips.toRDivisor_eq_mapCoeffs]
  obtain ⟨_, rD, LD, x, hx⟩ := exists_isRIntersectionNumber (k := k) hDc Γ
  obtain ⟨_, rC, LC, c, hc⟩ := exists_isRIntersectionNumber (k := k) hCc Γ
  have hl := IsRIntersectionNumber.eq_and_linear k sY Γ
  have hxneg : x < 0 := by
    have h := hl.2 _ _ _ _ _ _ _ _ (-1) 0 hx hc
    have he : (-1 : ℝ) • D + (0 : ℝ) • C = -D := by rw [zero_smul, add_zero, neg_one_smul]
    rw [he] at h
    have := pos_of_isRelativelyAmple hD Γ hΓ h
    linarith
  have hzero : x + lam * c = 0 := by
    have h := hl.2 _ _ _ _ _ _ _ _ 1 lam hx hc
    rw [one_smul, one_mul] at h
    obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := k) htriv.2.1 Γ
    have h00 := hl.2 _ _ _ _ _ _ _ _ 0 0 hy hy
    simp only [zero_smul, add_zero] at h00
    have hy0 := hl.1 _ _ _ _ _ _ _ hy h00
    rw [htriv.2.2 Γ hΓ _ _ _ _ _ _ _ _ h hy, hy0]
    ring
  have hcpos : 0 < c := by nlinarith
  have hnn : 0 ≤ x + t * c := by
    have h := hl.2 _ _ _ _ _ _ _ _ 1 t hx hc
    rw [one_smul, one_mul] at h
    exact nonneg_of_isRelativelyNef' htnef Γ hΓπ h
  by_contra hlt
  push_neg at hlt
  nlinarith

/-- A negative extremal contraction contracts a proper curve: `ρ(Y/T) = 1` forces `N¹(Y/T)` to
be nonzero. -/
private theorem exists_properCurve_isContractedBy_of_isNegativeExtremalContraction
    {k : Type} [Field k] {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} {sT : T ⟶ Spec (.of k)}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [QuasiCompact sY] {E : RDivisor Y}
    {f : Y ⟶ T} (hf : IsNegativeExtremalContraction k sY sT E f) :
    ∃ C : ProperCurve sY, C.IsContractedBy f :=
  MMP.Flips.exists_properCurve_isContractedBy_of_relativePicardNumber_eq_one f
    hf.relativePicardNumber_eq_one

end Thresholds

section FlipNef

/-! ### Nefness across a flip below the threshold -/

open MMP.Mori

/-- Every prime divisor of the target of a flip is the transform of a prime divisor of its
source. -/
private theorem exists_transformPrimeDivisor_eq_of_isFlip {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [CompactSpace Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)}
    {sT : T ⟶ Spec (.of ℂ)} {f : Y ⟶ T} {fp : Y' ⟶ T} {ψ : Y.RationalMap Y'} {E : RDivisor Y}
    (hflip : IsFlip ℂ sY sT sY' E f fp ψ) (F' : MMP.Mori.PrimeDivisor Y') :
    ∃ F : MMP.Mori.PrimeDivisor Y, RationalMap.transformPrimeDivisor ψ F = some F' := by
  have hT := hflip.isNormalVariety_target
  haveI : IsIntegral T := hT.1.toIsIntegral
  haveI : IsNormal T := hT.2
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian sT
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hT
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hflip.isNormalVariety_flip
  haveI : IsProper f := hflip.isSmall_source.isProper
  haveI : IsProper fp := hflip.isProper
  have hfb : IsBirationalMorphism f := hflip.isSmall_source.surjective_and_isBirational.2
  have hfpb : IsBirationalMorphism fp := hflip.isSmall.surjective_and_isBirational.2
  have hc := coheight_map_le_one_of_isSmall hflip.isSmall F'
  have hb1 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hfb hc
  have hb2 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal fp hfpb hc
  have hc1 : Order.coheight (fp F'.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb2, F'.coheight_genericPoint]
  obtain ⟨F, hF, -⟩ := exists_primeDivisor_map_eq_of_mem_biregularLocus f hb1 hc1
  obtain ⟨F'', -, huniq, htr, -, -⟩ :=
    exists_transformPrimeDivisor_eq_of_isOver hflip.isModificationOf.2
      (definedAt_genericPoint_of_isMorphismInCodimOne hflip.isMorphismInCodimOne) F
      (hF ▸ hb1) (hF ▸ hb2)
  have hFF : F'' = F' := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (huniq _ hF.symm).symm
  exact ⟨F, hFF ▸ htr⟩

/-- **Nefness across a flip below the threshold.** Let `f⁺ : Y' ⟶ T` be a `(K + B)`-flip of
`f : Y ⟶ T` between `ℚ`-factorial varieties, with `K + B + λ C ≡_f 0`. For `0 ≤ u ≤ λ` the
adjoint `K' + ψ_* B + u ψ_* C` is `f⁺`-nef, for any canonical divisor `K'` of `Y'`. -/
private theorem isRelativelyNef_of_isFlip_of_le {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [CompactSpace Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)}
    {sT : T ⟶ Spec (.of ℂ)} {f : Y ⟶ T} {fp : Y' ⟶ T} {ψ : Y.RationalMap Y'} {K : Divisor Y}
    {B C : RDivisor Y} {K' : Divisor Y'}
    (hflip : IsFlip ℂ sY sT sY' (logCanonicalDivisor K B) f fp ψ)
    (hYQ : IsQFactorial sY) (hY'Q : IsQFactorial sY') {m m' : ℕ}
    (hK : K.IsCanonicalDivisor sY m) (hK' : K'.IsCanonicalDivisor sY' m') {lam u : ℝ}
    (hu0 : 0 ≤ u) (hul : u ≤ lam)
    (htriv : IsNumericallyTrivialOver ℂ sY f (logCanonicalDivisor K (B + lam • C))) :
    IsRelativelyNef ℂ sY' fp (logCanonicalDivisor K'
      (RationalMap.transformDivisor ψ B + u • RationalMap.transformDivisor ψ C)) := by
  classical
  have hT := hflip.isNormalVariety_target
  haveI : IsIntegral T := hT.1.toIsIntegral
  haveI : IsNormal T := hT.2
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian sT
  have hYn : IsNormalVariety ℂ sY := hYQ.1
  have hY'n : IsNormalVariety ℂ sY' := hY'Q.1
  haveI : QuasiCompact sY := hYn.1.toQuasiCompact
  haveI : QuasiCompact sY' := hY'n.1.toQuasiCompact
  have hfs : f ≫ sT = sY := hflip.isSmall_source.comp_eq
  have hfps : fp ≫ sT = sY' := hflip.isSmall.comp_eq
  haveI : IsProper f := hflip.isSmall_source.isProper
  haveI : IsProper fp := hflip.isProper
  have hfb : IsBirationalMorphism f := hflip.isSmall_source.surjective_and_isBirational.2
  have hfpb : IsBirationalMorphism fp := hflip.isSmall.surjective_and_isBirational.2
  haveI : IsDominant f := hfb.isDominant
  haveI : IsDominant fp := hfpb.isDominant
  haveI : LocallyOfFiniteType (f ≫ sT) := by rw [hfs]; exact hYn.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (fp ≫ sT) := by rw [hfps]; exact hY'n.1.toLocallyOfFiniteType
  -- the transform of `K` is canonical, hence linearly equivalent to `K'`
  have hKψ : Divisor.IsCanonicalDivisor sY' m (RationalMap.transformDivisor ψ K) := by
    have := MMP.Flips.IsSmall.isCanonicalDivisor_transformDivisor
      (by rw [hfs]; exact hflip.isSmall_source) (by rw [hfps]; exact hflip.isSmall) hT
      (by rw [hfs]; exact hYn) (by rw [hfps]; exact hY'n) hflip.isModificationOf
      (by rw [hfs]; exact hK)
    rwa [hfps] at this
  have hKK : K'.LinearlyEquivalent (RationalMap.transformDivisor ψ K) :=
    MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sY' hY'n hK' hKψ
  -- the transformed adjoint is `f⁺`-ample
  set A := RationalMap.transformDivisor ψ (logCanonicalDivisor K B) with hAdef
  have hA : A = logCanonicalDivisor (RationalMap.transformDivisor ψ K)
      (RationalMap.transformDivisor ψ B) := by
    rw [hAdef, logCanonicalDivisor, map_add, transformDivisor_toRDivisor]; rfl
  have hAnef : IsRelativelyNef ℂ sY' fp A :=
    isRelativelyNef_of_isRelativelyAmple' hflip.isRelativelyAmple_transform
  -- the transform of the numerically trivial adjoint
  obtain ⟨-, hNtriv⟩ := MMP.Flips.IsNumericallyTrivialOver.transformDivisor_of_isOver sT hYn
    hY'Q hfs hfps hfb hfpb hflip.isModificationOf.2
    (exists_transformPrimeDivisor_eq_of_isFlip hflip)
    (isCartierCombination_of_isQFactorial hYQ _) htriv
  have hsm : ∀ (c : ℝ) (D : RDivisor Y), RationalMap.transformDivisor ψ (c • D) =
      c • RationalMap.transformDivisor ψ D := fun c D =>
    DivisorWithCoeffs.mapPrimeDivisors_smul _ c D
  have hN : RationalMap.transformDivisor ψ (logCanonicalDivisor K (B + lam • C)) =
      A + lam • RationalMap.transformDivisor ψ C := by
    rw [hAdef, logCanonicalDivisor, logCanonicalDivisor, map_add, map_add, map_add, hsm,
      add_assoc]
  rw [hN] at hNtriv
  have hNnef := isRelativelyNef_of_isNumericallyTrivialOver hNtriv
  rcases eq_or_lt_of_le (hu0.trans hul) with hlam0 | hlampos
  · have hu : u = 0 := le_antisymm (hlam0 ▸ hul) hu0
    subst hu
    rw [zero_smul, add_zero]
    exact isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hKK (hA ▸ hAnef)
  · set s := u / lam with hsdef
    have hs0 : 0 ≤ s := div_nonneg hu0 hlampos.le
    have hs1 : s ≤ 1 := (div_le_one hlampos).mpr hul
    have hsl : s * lam = u := by rw [hsdef]; field_simp
    have hnef := isRelativelyNef_add_smul' hAnef hNnef (sub_nonneg.mpr hs1) hs0
    have hcomb : (1 - s) • A + s • (A + lam • RationalMap.transformDivisor ψ C) =
        logCanonicalDivisor (RationalMap.transformDivisor ψ K)
          (RationalMap.transformDivisor ψ B + u • RationalMap.transformDivisor ψ C) := by
      rw [hA, smul_add, ← add_assoc, ← add_smul, sub_add_cancel, one_smul, smul_smul, hsl,
        logCanonicalDivisor, logCanonicalDivisor, add_assoc]
    rw [hcomb] at hnef
    exact isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hKK hnef

end FlipNef

section SmallModification

/-! ### The birational map of two small contractions -/

open MMP.Mori

/-- **The birational map of two small contractions.** Two small contractions `f : Y ⟶ T` and
`f⁺ : Y' ⟶ T` to a normal variety are isomorphisms over a common open `V` containing the images of
all points of codimension at most one; `ψ = (f⁺)⁻¹ ∘ f` over `V` is a birational map over `T`, a
morphism in codimension one, and transforms divisors as `(f⁺)⁻¹_* f_*`. -/
private theorem exists_rationalMap_of_isSmall {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    [IsSeparated (Y' ↘ ⊤_ Scheme)] {sT : T ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)}
    {sY' : Y' ⟶ Spec (.of ℂ)} (hT : IsNormalVariety ℂ sT) {f : Y ⟶ T} {fp : Y' ⟶ T}
    (hf : IsSmall ℂ sT sY f) (hfp : IsSmall ℂ sT sY' fp) :
    ∃ ψ : Y.RationalMap Y', MMP.Flips.RationalMap.IsOver f fp ψ ∧ RationalMap.IsBirational ψ ∧
      MMP.Flips.RationalMap.IsMorphismInCodimOne ψ ∧
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R Y),
        RationalMap.transformDivisor ψ D = flipTransform f fp D := by
  obtain ⟨V, hfV, hfpV, hYV, hY'V⟩ := MMP.Mori.exists_opens_isIso_of_isSmall hf hfp
  haveI := hfV
  haveI := hfpV
  have hmax : ∀ {A : Scheme.{0}} [IrreducibleSpace A], Order.coheight (genericPoint A) ≤ 1 :=
    fun {A} _ => ((Order.coheight_eq_zero.mpr fun z _ => genericPoint_specializes z).trans_le
      zero_le_one)
  have hdense : ∀ {A : Scheme.{0}} [IrreducibleSpace A] (U : A.Opens), genericPoint A ∈ U →
      Dense (U : Set A) := fun U hU => U.isOpen.dense ⟨_, hU⟩
  let e : Y.PartialIso Y' :=
    { source := f ⁻¹ᵁ V
      dense_source := hdense _ (hYV _ hmax)
      target := fp ⁻¹ᵁ V
      dense_target := hdense _ (hY'V _ hmax)
      iso := asIso (f ∣_ V) ≪≫ (asIso (fp ∣_ V)).symm }
  have hkey : e.iso.hom ≫ e.target.ι ≫ fp = e.source.ι ≫ f := by
    change ((f ∣_ V) ≫ inv (fp ∣_ V)) ≫ (fp ⁻¹ᵁ V).ι ≫ fp = (f ⁻¹ᵁ V).ι ≫ f
    rw [← morphismRestrict_ι fp V, ← morphismRestrict_ι f V, Category.assoc,
      IsIso.inv_hom_id_assoc]
  have hover : MMP.Flips.RationalMap.IsOver f fp e.toRationalMap := by
    change e.toPartialMap.toRationalMap.compHom fp = f.toRationalMap
    rw [← Scheme.RationalMap.compHom_toRationalMap, Scheme.Hom.toRationalMap,
      Scheme.PartialMap.toRationalMap_eq_iff]
    refine ⟨f ⁻¹ᵁ V, e.dense_source, le_rfl, le_top, ?_⟩
    change Y.homOfLE le_rfl ≫ (e.iso.hom ≫ e.target.ι) ≫ fp = Y.homOfLE _ ≫ f.toPartialMap.hom
    rw [Scheme.homOfLE_rfl, Category.id_comp, Category.assoc, hkey]
    simp [Scheme.Hom.toPartialMap]
  have hTn := hT
  have hYn : IsNormalVariety ℂ (f ≫ sT) := by rw [hf.comp_eq]; exact ⟨hf.isVariety_source, inferInstance⟩
  haveI : IsProper f := hf.isProper
  refine ⟨e.toRationalMap, hover, ⟨e, rfl⟩, ?_, fun D => ?_⟩
  · refine MMP.Flips.le_closedsCodimension_iff_le_coheight.mpr fun x hx => ?_
    by_contra hlt
    push_neg at hlt
    apply hx
    have hx1 : Order.coheight x ≤ 1 := Order.le_of_lt_succ hlt
    exact RationalMap.le_dom e.toPartialMap (hYV x hx1)
  · exact MMP.Mori.transformDivisor_eq_flipTransform_of_isIso_restrict hT hYn
      hf.surjective_and_isBirational.2 V hYV hY'V hover D

end SmallModification

section ScalingDivisor

/-! ### A general ample scaling divisor -/

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)}

/-- An ample `ℚ`-divisor is nef over any quasi-compact base. -/
private theorem isRelativelyNef_toRDivisor_of_isAmple [QuasiCompact sX] {Y : Scheme.{0}}
    {g : X ⟶ Y} [QuasiCompact g] {A : QDivisor X} (hA : A.IsAmple) :
    IsRelativelyNef ℂ sX g (QDivisor.toRDivisor A) := by
  obtain ⟨m, hm, D, hD, hDc, hamp⟩ := hA
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hcoef : ∀ P, ((A.coeff P : ℚ) : ℝ) = (m : ℝ)⁻¹ * (D.coeff P : ℝ) := fun P => by
    have h1 := congrArg (fun G : QDivisor X => G.coeff P) hD
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h1
    have h2 : ((D.coeff P : ℚ) : ℝ) = (((m : ℚ) * A.coeff P : ℚ) : ℝ) := by rw [h1]
    push_cast at h2
    rw [h2]
    field_simp
  have hpres : QDivisor.toRDivisor A = ∑ _j : Fin 1, (m : ℝ)⁻¹ • Divisor.toRDivisor D := by
    refine Finsupp.ext fun P => ?_
    change (QDivisor.toRDivisor A).coeff P = (∑ _j : Fin 1, (m : ℝ)⁻¹ • Divisor.toRDivisor D).coeff P
    rw [QDivisor.coeff_toRDivisor, Fin.sum_univ_one, DivisorWithCoeffs.coeff_smul,
      Divisor.coeff_toRDivisor, smul_eq_mul, hcoef]
  refine ⟨1, fun _ => (m : ℝ)⁻¹, fun _ => D, fun _ => hDc, hpres, fun C hC x hx => ?_⟩
  rw [MMP.Flips.eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C (fun _ => (m : ℝ)⁻¹)
    (fun _ => D) (fun _ => hDc) hpres hx]
  haveI := hDc.isInvertibleModule_divisorialSheaf
  have hrel := MMP.Threefold.Resolution.isRelativelyAmple_of_isAmple g D.divisorialSheaf hamp
  have hpos := MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy g _
    hrel C hC
  have hpos' : (0 : ℝ) < (D.degreeOn ℂ sX C.ι C.dim_le hDc : ℝ) := by exact_mod_cast hpos
  simp only [Fin.sum_univ_one]
  positivity

/-- The zero divisor is nef. -/
private theorem isRelativelyNef_zero [QuasiCompact sX] {Y : Scheme.{0}} {g : X ⟶ Y} :
    IsRelativelyNef ℂ sX g 0 :=
  isRelativelyNef_of_isNumericallyTrivialOver (numEq_refl (k := ℂ) isCartierCombination_zero')

/-- Nonnegative combinations of nef divisors are nef. -/
private theorem isRelativelyNef_sum_smul [QuasiCompact sX] {Y : Scheme.{0}} {g : X ⟶ Y}
    {ι : Type*} (s : Finset ι) {a : ι → ℝ} {D : ι → RDivisor X} (ha : ∀ i, 0 ≤ a i)
    (hD : ∀ i, IsRelativelyNef ℂ sX g (D i)) :
    IsRelativelyNef ℂ sX g (∑ i ∈ s, a i • D i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using isRelativelyNef_zero
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    have := isRelativelyNef_add_smul' (hD i) ih (ha i) zero_le_one
    rwa [one_smul] at this

/-- **Large multiples of an ample divisor dominate.** On a projective `ℚ`-factorial variety, for
an ample `ℚ`-divisor `A` and an effective `B`, `K + B + c A` is nef for some `c ≥ 0`: by ample
perturbation each `A + t K` and `A + t P` (`P` a component of `B`, `t > 0` small rational) is
ample, and `K + B + c A` is a nonnegative combination of them. -/
private theorem exists_isRelativelyNef_add_smul_of_isAmple [QuasiCompact sX] {Y : Scheme.{0}}
    {g : X ⟶ Y} [QuasiCompact g] (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hQ : IsQFactorial sX) (K : Divisor X) {B : RDivisor X} (hB : ∀ P, 0 ≤ B.coeff P)
    {A : QDivisor X} (hA : A.IsAmple) :
    ∃ c : ℝ, 0 ≤ c ∧
      IsRelativelyNef ℂ sX g (logCanonicalDivisor K B + c • QDivisor.toRDivisor A) := by
  classical
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  let E : Option B.support → QDivisor X := fun j =>
    Option.elim j (Divisor.toQDivisor K) fun P => Finsupp.single (P : MMP.Mori.PrimeDivisor X) 1
  let β : Option B.support → ℝ := fun j => Option.elim j 1 fun P => B.coeff P
  have hβ : ∀ j, 0 ≤ β j := fun j => by
    rcases j with _ | P
    · exact zero_le_one
    · exact hB P
  obtain ⟨η, hη, hamp⟩ := MMP.Mori.QDivisor.exists_pos_forall_isAmple_add_sum_smul sX E hA
    (fun j => MMP.Fourfold.isQCartier_of_isQFactorial sX hQ _)
  obtain ⟨t, ht0, htη⟩ := exists_rat_btwn hη
  have ht0' : (0 : ℚ) < t := by exact_mod_cast ht0
  have hampj : ∀ j, (A + t • E j).IsAmple := fun j => by
    have := hamp (Pi.single j t) fun i => by
      by_cases hij : i = j
      · subst hij; simpa [abs_of_pos ht0] using htη
      · simpa [Pi.single_apply, hij] using hη
    simpa [Pi.single_apply, ite_smul, Finset.sum_ite_eq'] using this
  have hnefj : ∀ j, IsRelativelyNef ℂ sX g (QDivisor.toRDivisor (A + t • E j)) := fun j =>
    isRelativelyNef_toRDivisor_of_isAmple (hampj j)
  refine ⟨∑ j, β j / t, Finset.sum_nonneg fun j _ => div_nonneg (hβ j) ht0.le, ?_⟩
  have ht : (t : ℝ) ≠ 0 := ht0.ne'
  have hlin : ∀ j, QDivisor.toRDivisor (A + t • E j) =
      QDivisor.toRDivisor A + (t : ℝ) • QDivisor.toRDivisor (E j) := fun j => by
    rw [map_add]
    congr 1
    refine Finsupp.ext fun P => ?_
    change (QDivisor.toRDivisor (t • E j)).coeff P = ((t : ℝ) • QDivisor.toRDivisor (E j)).coeff P
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul,
      QDivisor.coeff_toRDivisor, smul_eq_mul, smul_eq_mul, Rat.cast_mul]
  have hK : QDivisor.toRDivisor (Divisor.toQDivisor K) = Divisor.toRDivisor K := by
    refine Finsupp.ext fun P => ?_
    change (QDivisor.toRDivisor (Divisor.toQDivisor K)).coeff P = (Divisor.toRDivisor K).coeff P
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor, Divisor.coeff_toRDivisor,
      Rat.cast_intCast]
  have hterm : ∀ Q : MMP.Mori.PrimeDivisor X, B.coeff Q •
      QDivisor.toRDivisor (Finsupp.single Q (1 : ℚ) : QDivisor X) = Finsupp.single Q (B Q) := by
    intro Q
    refine Finsupp.ext fun P => ?_
    change (B.coeff Q • QDivisor.toRDivisor (Finsupp.single Q (1 : ℚ) : QDivisor X)).coeff P =
      DivisorWithCoeffs.coeff (Finsupp.single Q (B Q) : RDivisor X) P
    rw [DivisorWithCoeffs.coeff_smul, QDivisor.coeff_toRDivisor, smul_eq_mul]
    by_cases hQ : Q = P
    · subst hQ; simp [DivisorWithCoeffs.coeff_apply]
    · simp [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, hQ]
  have hBsum : ∑ Q : B.support, B.coeff Q • QDivisor.toRDivisor
      (Finsupp.single (Q : MMP.Mori.PrimeDivisor X) (1 : ℚ) : QDivisor X) = B := by
    rw [Finset.sum_coe_sort B.support (fun Q => B.coeff Q •
      QDivisor.toRDivisor (Finsupp.single Q (1 : ℚ) : QDivisor X))]
    simp_rw [hterm]
    exact Finsupp.sum_single B
  have hEsum : ∑ j, β j • QDivisor.toRDivisor (E j) = logCanonicalDivisor K B := by
    rw [Fintype.sum_option]
    simp only [β, E, Option.elim, one_smul]
    rw [hK, hBsum]
    rfl
  have heq : logCanonicalDivisor K B + (∑ j, β j / t) • QDivisor.toRDivisor A =
      ∑ j, (β j / t) • QDivisor.toRDivisor (A + t • E j) := by
    simp_rw [hlin, smul_add, smul_smul, div_mul_cancel₀ _ ht]
    rw [Finset.sum_add_distrib, ← Finset.sum_smul, hEsum, add_comm]
  rw [heq]
  exact isRelativelyNef_sum_smul _ (fun j => div_nonneg (hβ j) ht0.le) hnefj

/-- Adding a real multiple of a principal divisor preserves nefness: principal divisors have
degree zero on every curve. -/
private theorem isRelativelyNef_add_smul_principalDivisor [QuasiCompact sX] {Y : Scheme.{0}}
    {g : X ⟶ Y} {D : RDivisor X} (hD : IsRelativelyNef ℂ sX g D) (r : ℝ)
    (φ : (RationalFunctions X)ˣ) :
    IsRelativelyNef ℂ sX g (D + r • Divisor.toRDivisor (principalDivisor φ)) := by
  obtain ⟨m, rr, L, hL, hDeq, hnn⟩ := hD
  have hP : (principalDivisor φ).IsCartier := Divisor.isCartier_principalDivisor φ
  refine ⟨m + 1, Fin.snoc (α := fun _ => ℝ) rr r,
    Fin.snoc (α := fun _ => Divisor X) L (principalDivisor φ), fun j => ?_, ?_, ?_⟩
  · refine Fin.lastCases (motive := fun j =>
      (Fin.snoc (α := fun _ => Divisor X) L (principalDivisor φ) j).IsCartier)
      ?_ (fun i => ?_) j
    · simpa using hP
    · simpa using hL i
  · rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    rw [← hDeq]
  · intro C hC x hx
    obtain ⟨hL', d, hD', hd, rfl⟩ := hx
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    have hlast : d (Fin.last m) = 0 := by
      obtain ⟨C', ν, hν, hdim, hdeg⟩ := hd (Fin.last m)
      have := hν.isFinite
      haveI : IsProper ((ν ≫ C.ι) ≫ sX) := by rw [Category.assoc]; infer_instance
      have hP' : Fin.snoc (α := fun _ => Divisor X) L (principalDivisor φ) (Fin.last m) =
          principalDivisor φ := by simp
      rw [hdeg]
      exact MMP.Flips.Divisor.degreeOn_eq_zero_of_linearlyEquivalent _ _ _ _
        ⟨φ, by rw [hP', sub_zero]⟩
    rw [hlast, Int.cast_zero, mul_zero, add_zero]
    refine hnn C hC _ ⟨hL, fun j => d j.castSucc, hDeq, fun j => ?_, rfl⟩
    have := hd j.castSucc
    simp only [Fin.snoc_castSucc] at this
    exact this

/-- Adding a real combination of principal divisors preserves nefness. -/
private theorem isRelativelyNef_add_sum_smul_principalDivisor [QuasiCompact sX] {Y : Scheme.{0}}
    {g : X ⟶ Y} {D : RDivisor X} (hD : IsRelativelyNef ℂ sX g D) {n : ℕ} (r : Fin n → ℝ)
    (φ : Fin n → (RationalFunctions X)ˣ) :
    IsRelativelyNef ℂ sX g (D + ∑ j, r j • Divisor.toRDivisor (principalDivisor (φ j))) := by
  induction n with
  | zero => simpa using hD
  | succ n ih =>
    rw [Fin.sum_univ_castSucc, ← add_assoc]
    exact isRelativelyNef_add_smul_principalDivisor
      (ih (fun j => r j.castSucc) (fun j => φ j.castSucc)) _ _

open Classical in
/-- The coefficients of a sum of prime divisors with coefficient one. -/
private theorem coeff_sum_single_one (S : Finset (MMP.Mori.PrimeDivisor X))
    (P : MMP.Mori.PrimeDivisor X) :
    (∑ E ∈ S, Finsupp.single E (1 : ℤ) : Divisor X).coeff P = if P ∈ S then 1 else 0 := by
  classical
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
  simp only [Finsupp.single_apply]
  rw [Finset.sum_ite_eq']

/-- **The identity is a log resolution of an snc divisor** on a smooth variety. -/
private theorem isLogResolution_id_of_isSNC (hXsm : IsSmoothScheme sX) {R : RDivisor X}
    (hR : DivisorWithCoeffs.IsSNC sX R) : MMP.Mori.IsLogResolution sX R (𝟙 X) := by
  classical
  have hexc : MMP.Mori.exceptionalSet (𝟙 X) = ⊥ := by
    refine TopologicalSpace.Closeds.ext (Set.eq_empty_iff_forall_notMem.mpr fun x hx => ?_)
    have hx' := MMP.Mori.mem_exceptionalSet.mp hx
    apply hx'
    have : MMP.Mori.IsBiregular (𝟙 X) ⊤ := by
      unfold MMP.Mori.IsBiregular
      infer_instance
    exact MMP.Mori.le_biregularLocus this trivial
  refine ⟨⟨inferInstance, MMP.Mori.isBirationalMorphism_of_isIso _, by
    rw [Category.id_comp]; exact hXsm⟩, ?_, ?_⟩
  · rw [hexc]
    intro W hW
    obtain ⟨x, hx⟩ := W.isIrreducible.nonempty
    exact absurd (hW.1 hx) (by simp)
  · rw [hexc, bot_sup_eq]
    refine Or.inr ⟨R.support, ?_, hR.of_support_subset fun P hP => ?_⟩
    · ext x
      simp only [Set.mem_iUnion, exists_prop, TopologicalSpace.Closeds.coe_preimage,
        Set.mem_preimage]
      rw [show (𝟙 X : X ⟶ X) x = x from rfl, SetLike.mem_coe, DivisorWithCoeffs.mem_supp_iff]
      simp only [Finsupp.mem_support_iff, DivisorWithCoeffs.coeff_apply]
    · rw [Finsupp.mem_support_iff] at hP ⊢
      have := coeff_sum_single_one R.support P
      rw [DivisorWithCoeffs.coeff_apply] at this
      rw [this] at hP
      split_ifs at hP with h
      · exact Finsupp.mem_support_iff.mp h
      · exact absurd rfl hP

/-- **An snc divisor from a log resolution by the identity.** If the identity is a log resolution
of `D`, then `D` is snc (for `X` carrying some snc divisor `R`, e.g. `0`). -/
private theorem isSNC_of_isLogResolution_id {R D : RDivisor X}
    (hR : DivisorWithCoeffs.IsSNC sX R) (h : MMP.Mori.IsLogResolution sX D (𝟙 X)) :
    DivisorWithCoeffs.IsSNC sX D := by
  classical
  obtain ⟨-, -, hsnc⟩ := h
  have hgen : ∀ P, D.coeff P ≠ 0 → P.genericPoint ∈
      ((MMP.Mori.exceptionalSet (𝟙 X) ⊔ D.supp.preimage (Scheme.Hom.continuous (𝟙 X)) :
        TopologicalSpace.Closeds X) : Set X) := fun P hP => by
    rw [TopologicalSpace.Closeds.coe_sup]
    refine Or.inr ?_
    change P.genericPoint ∈ D.supp
    exact DivisorWithCoeffs.mem_supp_iff.mpr ⟨P, hP,
      MMP.Flips.primeDivisor_genericPoint_mem_support P⟩
  rcases hsnc with h0 | ⟨s, hs, hsnc⟩
  · refine hR.of_support_subset fun P hP => ?_
    have := hgen P (Finsupp.mem_support_iff.mp hP)
    rw [h0] at this
    exact absurd this (by simp)
  · refine hsnc.of_support_subset fun P hP => ?_
    have hmem := hgen P (Finsupp.mem_support_iff.mp hP)
    rw [← hs] at hmem
    obtain ⟨E, hE, hPE⟩ := Set.mem_iUnion₂.mp hmem
    obtain rfl := MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support hPE
    rw [Finsupp.mem_support_iff]
    have := coeff_sum_single_one s P
    rw [DivisorWithCoeffs.coeff_apply] at this
    rw [this, if_pos hE]
    exact one_ne_zero

/-- **Iterated Bertini.** Over a log resolution by the identity of an effective `R`, there are
`k` general members of `|A|` (as `ℚ`-divisors), jointly snc with `R` and without common or
`R`-components; their sum `S` has coefficients in `[0, 1]` and differs from `k A` by a real
combination of principal divisors. -/
private theorem exists_sum_isLogResolution_id (hXv : AlgebraicGeometry.IsVariety ℂ sX)
    {R : RDivisor X} (hR : ∀ P, 0 ≤ R.coeff P) (hRl : MMP.Mori.IsLogResolution sX R (𝟙 X))
    {A : QDivisor X} (hA : A.IsAmple) (k : ℕ) :
    ∃ S : RDivisor X, (∀ P, 0 ≤ S.coeff P ∧ S.coeff P ≤ 1) ∧
      (∀ P, S.coeff P ≠ 0 → R.coeff P = 0) ∧ MMP.Mori.IsLogResolution sX (R + S) (𝟙 X) ∧
      ∃ (n : ℕ) (r : Fin n → ℝ) (φ : Fin n → (RationalFunctions X)ˣ),
        S = (k : ℝ) • QDivisor.toRDivisor A +
          ∑ j, r j • Divisor.toRDivisor (principalDivisor (φ j)) := by
  induction k with
  | zero =>
    refine ⟨0, fun P => ?_, fun P h => absurd rfl h, by simpa using hRl, 0, Fin.elim0,
      Fin.elim0, by simp⟩
    simp [DivisorWithCoeffs.coeff_apply]
  | succ k ih =>
    obtain ⟨S, hS01, hSR, hSl, n, r, φ, hSeq⟩ := ih
    obtain ⟨H', -, -, hH'lin, hH'R, hl', N, Zd, hN, hZ0, hZ1, hH'eq⟩ :=
      hSl.exists_isAmple_qLinearlyEquivalent_add hXv hA
    obtain ⟨m, hm, ψ, hψ⟩ := hH'lin
    have hH'c : ∀ P, ((H'.coeff P : ℚ) : ℝ) = (N : ℝ)⁻¹ * (Zd.coeff P : ℝ) := fun P => by
      rw [hH'eq, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, smul_eq_mul]
      push_cast; rfl
    have hH'01 : ∀ P, 0 ≤ ((H'.coeff P : ℚ) : ℝ) ∧ ((H'.coeff P : ℚ) : ℝ) ≤ 1 := fun P => by
      rw [hH'c]
      have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast hN
      have h0 : (0 : ℝ) ≤ Zd.coeff P := by exact_mod_cast hZ0 P
      have h1 : (Zd.coeff P : ℝ) ≤ 1 := by exact_mod_cast hZ1 P
      refine ⟨by positivity, ?_⟩
      calc (N : ℝ)⁻¹ * (Zd.coeff P : ℝ) ≤ 1 * 1 :=
            mul_le_mul (inv_le_one_of_one_le₀ hN1) h1 h0 zero_le_one
        _ = 1 := one_mul 1
    have hcS : ∀ P, (S + QDivisor.toRDivisor H').coeff P =
        S.coeff P + ((H'.coeff P : ℚ) : ℝ) := fun P => by
      rw [DivisorWithCoeffs.coeff_add, QDivisor.coeff_toRDivisor]
    have hdisj : ∀ P, H'.coeff P ≠ 0 → R.coeff P = 0 ∧ S.coeff P = 0 := fun P hP => by
      have h := hH'R P hP
      rw [DivisorWithCoeffs.coeff_add] at h
      have := hR P
      have := (hS01 P).1
      constructor <;> linarith
    refine ⟨S + QDivisor.toRDivisor H', fun P => ?_, fun P hP => ?_, by
      rw [← add_assoc]; exact hl', n + 1, Fin.snoc (α := fun _ => ℝ) r ((m : ℝ)⁻¹),
      Fin.snoc (α := fun _ => (RationalFunctions X)ˣ) φ ψ, ?_⟩
    · rw [hcS]
      by_cases hP : H'.coeff P = 0
      · rw [hP, Rat.cast_zero, add_zero]; exact hS01 P
      · rw [(hdisj P hP).2, zero_add]; exact hH'01 P
    · rw [hcS] at hP
      by_cases hP' : H'.coeff P = 0
      · rw [hP', Rat.cast_zero, add_zero] at hP; exact hSR P hP
      · exact (hdisj P hP').1
    · have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
      have hH'R : QDivisor.toRDivisor H' = QDivisor.toRDivisor A +
          (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor ψ) := by
        refine Finsupp.ext fun P => ?_
        change (QDivisor.toRDivisor H').coeff P = (QDivisor.toRDivisor A +
          (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor ψ)).coeff P
        have h1 := congrArg (fun G : QDivisor X => G.coeff P) hψ
        simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub,
          Divisor.coeff_toQDivisor, zsmul_eq_mul] at h1
        rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, QDivisor.coeff_toRDivisor,
          DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
        have h2 := congrArg (fun q : ℚ => (q : ℝ)) h1
        push_cast at h2
        field_simp
        linarith
      rw [hSeq, hH'R, Fin.sum_univ_castSucc]
      simp only [Fin.snoc_castSucc, Fin.snoc_last]
      push_cast
      module

end ScalingDivisor

section ScalingHelpers

/-! ### Curves, faces and supports -/

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)}

/-- The degree of an `ℝ`-Cartier divisor on a curve contracted over a base is its degree on the
relative class of the curve. -/
private theorem eq_sum_degree_of_isRIntersectionNumber [QuasiCompact sX] {S : Scheme.{0}}
    {g : X ⟶ S} (C : ProperCurve sX) (hC : C.IsContractedBy g) {D : RDivisor X} {n : ℕ}
    {c : Fin n → ℝ} {M : Fin n → Divisor X} (hM : ∀ i, (M i).IsCartier)
    (hD : D = ∑ i, c i • Divisor.toRDivisor (M i)) {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {x : ℝ} (hx : IsRIntersectionNumber ℂ sX D r L C x) :
    x = ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
      RelativeNumericalCurveClasses.degree sX g (M i).divisorialSheaf (C.relativeClass g hC)) := by
  rw [MMP.Flips.eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C c M hM hD hx]
  refine Finset.sum_congr rfl fun j _ => ?_
  congr 1
  have := (hM j).isInvertibleModule_divisorialSheaf
  exact (OneCycle.degree_cycle ℝ _ C).symm

/-- **Null on a face, trivial over its contraction.** An `ℝ`-Cartier divisor of degree zero on an
extremal face `R` of `NE̅(X/S)` is numerically trivial over the contraction of `R`. -/
private theorem isNumericallyTrivialOver_of_isRelativeContractionOfFace [QuasiCompact sX]
    {S W : Scheme.{0}} {g : X ⟶ S} {R : Set (RelativeNumericalCurveClasses sX g)} {f : X ⟶ W}
    {h : W ⟶ S} (hf : IsRelativeContractionOfFace g R f h) {D : RDivisor X}
    (hD : IsCartierCombination D)
    (h0 : ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
      D = ∑ i, c i • Divisor.toRDivisor (M i) →
      ∀ u ∈ R, ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
        RelativeNumericalCurveClasses.degree sX g (M i).divisorialSheaf u) = 0) :
    IsNumericallyTrivialOver ℂ sX f D := by
  refine ⟨hD, isCartierCombination_zero', fun Γ hΓ m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have hl := IsRIntersectionNumber.eq_and_linear ℂ sX Γ
  obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := ℂ) hD Γ
  have h00 := hl.2 _ _ _ _ _ _ _ _ 0 0 hy hy
  simp only [zero_smul, add_zero] at h00
  rw [hl.1 _ _ _ _ _ _ _ hx₂ h00]
  simp only [zero_mul, add_zero]
  obtain ⟨n, c, M, hM, hDeq⟩ := hD
  have hΓg : Γ.IsContractedBy g := fun x hx => by
    rw [← hf.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ x hx]
  rw [eq_sum_degree_of_isRIntersectionNumber Γ hΓg hM hDeq hx₁]
  exact h0 n c M hM hDeq _ ((hf.isContractedBy_iff Γ hΓg).mp hΓ)

/-- **A curve of negative degree lies in a component.** On a normal `ℚ`-factorial variety, an
effective `ℝ`-divisor `E` of negative degree on a proper curve `C` has a component containing
`C`. -/
private theorem exists_coeff_ne_zero_of_isRIntersectionNumber_neg [QuasiCompact sX]
    (hQ : IsQFactorial sX) {E : RDivisor X} (hE : ∀ P, 0 ≤ E.coeff P) (C : ProperCurve sX)
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX E r L C x) (hneg : x < 0) :
    ∃ P : MMP.Mori.PrimeDivisor X, E.coeff P ≠ 0 ∧ C.point ∈ P.support := by
  classical
  by_contra hno
  push_neg at hno
  choose mult hmult hcart using fun P : MMP.Mori.PrimeDivisor X =>
    hQ.2 (Finsupp.single P (1 : ℤ))
  let e := E.support.equivFin
  let P : Fin E.support.card → MMP.Mori.PrimeDivisor X := fun j => (e.symm j : _)
  let PD : Fin E.support.card → Divisor X := fun j =>
    ((mult (P j) : ℕ) : ℤ) • Finsupp.single (P j) (1 : ℤ)
  have hL : ∀ j, (PD j).IsCartier := fun j => hcart (P j)
  have hterm : ∀ Q : MMP.Mori.PrimeDivisor X,
      (E Q / (mult Q : ℝ)) • Divisor.toRDivisor (((mult Q : ℕ) : ℤ) • Finsupp.single Q (1 : ℤ)) =
        Finsupp.single Q (E Q) := by
    intro Q
    have hm : (mult Q : ℝ) ≠ 0 := by exact_mod_cast (hmult Q).ne'
    ext Q'
    simp only [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    by_cases hQ : Q = Q'
    · subst hQ
      simp [DivisorWithCoeffs.coeff_apply]
      field_simp
    · simp [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, hQ]
  have hEeq : E = ∑ j, (E (P j) / (mult (P j) : ℝ)) • Divisor.toRDivisor (PD j) := by
    rw [Equiv.sum_comp e.symm (fun Q : E.support => (E Q / (mult (Q : MMP.Mori.PrimeDivisor X) : ℝ)) •
      Divisor.toRDivisor (((mult (Q : MMP.Mori.PrimeDivisor X) : ℕ) : ℤ) •
        Finsupp.single (Q : MMP.Mori.PrimeDivisor X) (1 : ℤ) : Divisor X))]
    rw [Finset.sum_coe_sort E.support (fun Q => (E Q / (mult Q : ℝ)) •
      Divisor.toRDivisor (((mult Q : ℕ) : ℤ) • Finsupp.single Q (1 : ℤ) : Divisor X))]
    simp_rw [hterm]
    exact (Finsupp.sum_single E).symm
  have hx' := MMP.Flips.eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C _ _ hL hEeq hx
  have : 0 ≤ x := by
    rw [hx']
    refine Finset.sum_nonneg fun j _ => mul_nonneg (div_nonneg (hE _) (by positivity)) ?_
    have hne : ∃ c : C.scheme, C.ι c ∉ (PD j).supp := by
      refine ⟨genericPoint C.scheme, ?_⟩
      rw [MMP.Mori.ProperCurve.ι_genericPoint]
      intro hmem
      obtain ⟨F, hF, hxF⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
      have hFP : P j = F := by
        by_contra h
        apply hF
        simp [PD, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, h]
      subst hFP
      have hPE : E (P j) ≠ 0 := Finsupp.mem_support_iff.mp (e.symm j).2
      exact hno (P j) hPE hxF
    have h0 := (MMP.Threefold.Mori.degreeOn_nonneg_and_eq_zero_iff sX C.ι C.dim_le _ (hL j)
      (smul_nonneg (by positivity) (Finsupp.single_nonneg.mpr zero_le_one)) hne).1
    exact_mod_cast h0
  linarith

/-- **Non-closed points of constancy lie in the exceptional locus.** If `f` is constant on the
closure of a non-closed point `p`, then `p` has no neighbourhood on which `f` is an open
immersion: such a neighbourhood would contain a closed point of the closure besides `p`, with
the same image. -/
private theorem mem_exceptionalSet_of_forall_eq [JacobsonSpace X] {Y : Scheme.{0}}
    {f : X ⟶ Y} {p : X} (hp : p ∉ closedPoints X)
    (hC : ∀ x ∈ closure ({p} : Set X), f x = f p) : p ∈ MMP.Flips.exceptionalSet f := by
  rintro ⟨V, hpV, hV⟩
  obtain ⟨c, ⟨hcV, hcC⟩, hcl⟩ := nonempty_inter_closedPoints
    (Z := (V : Set X) ∩ closure {p}) ⟨p, hpV, subset_closure rfl⟩
    (V.isOpen.isLocallyClosed.inter isClosed_closure.isLocallyClosed)
  have hne : c ≠ p := fun hc => hp (hc ▸ hcl)
  apply hne
  have hinj := (V.ι ≫ f).isOpenEmbedding.injective
  have h := @hinj ⟨c, hcV⟩ ⟨p, hpV⟩ (by
    change f c = f p
    exact hC c hcC)
  exact congrArg Subtype.val h

/-- **Contracted curves lie in the exceptional locus.** -/
private theorem point_mem_exceptionalSet_of_isContractedBy [LocallyOfFiniteType sX] {Y : Scheme.{0}}
    {f : X ⟶ Y} (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    C.point ∈ MMP.Flips.exceptionalSet f := by
  obtain ⟨w, hw, hwne⟩ :=
    MMP.Chow.DeterminantCurveForm.exists_specializes_ne_of_isProperCurve sX C.point C.isProperCurve
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  exact mem_exceptionalSet_of_forall_eq
    (fun hcl => hwne (hw.mem_closed (mem_closedPoints_iff.mp hcl) rfl)) hC

/-- An `ℝ`-Cartier divisor is its own pull-back along the identity. -/
private theorem isRCartierPullback_id {D : RDivisor X} (hD : IsCartierCombination D) :
    IsRCartierPullback (𝟙 X) D D := by
  obtain ⟨m, r, L, hL, rfl⟩ := hD
  exact ⟨m, r, L, L, hL, rfl, fun j => ⟨_, MMP.Mori.divisor_isPullback_id (L j)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp (𝟙 X) (L j))⟩, rfl⟩

/-- Across a transform sending no two prime divisors to the same one, the coefficient of the
transform along `Q` is that of a prime divisor sent to `Q`, or zero if there is none. -/
private theorem mapPrimeDivisors_coeff_cases {Y : Scheme.{0}}
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    (hinj : ∀ P P' Q, φ P = some Q → φ P' = some Q → P = P') (Q : MMP.Mori.PrimeDivisor Y) :
    (∃ P, φ P = some Q ∧ ∀ D : RDivisor X,
      (DivisorWithCoeffs.mapPrimeDivisors φ D).coeff Q = D.coeff P) ∨
      ∀ D : RDivisor X, (DivisorWithCoeffs.mapPrimeDivisors φ D).coeff Q = 0 := by
  classical
  by_cases h : ∃ P, φ P = some Q
  · obtain ⟨P, hP⟩ := h
    exact Or.inl ⟨P, hP, fun D => MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hP
      (fun P' hP' => hinj P' P Q hP' hP) D⟩
  · push_neg at h
    exact Or.inr fun D => MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne h D

/-- The transform of an effective divisor along a map injective on prime divisors is effective. -/
private theorem mapPrimeDivisors_nonneg {Y : Scheme.{0}}
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    (hinj : ∀ P P' Q, φ P = some Q → φ P' = some Q → P = P') {E : RDivisor X}
    (hE : ∀ P, 0 ≤ E.coeff P) (Q : MMP.Mori.PrimeDivisor Y) :
    0 ≤ (DivisorWithCoeffs.mapPrimeDivisors φ E).coeff Q := by
  rcases mapPrimeDivisors_coeff_cases hinj Q with ⟨P, -, hP⟩ | h0
  · rw [hP]; exact hE P
  · rw [h0]

/-- Along a map injective on prime divisors, a component of the transform of `E` comes from a
component of `E`, with the same coefficient of `B`. -/
private theorem one_le_mapPrimeDivisors {Y : Scheme.{0}}
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    (hinj : ∀ P P' Q, φ P = some Q → φ P' = some Q → P = P') {E B : RDivisor X}
    (hEB : ∀ P, E.coeff P ≠ 0 → 1 ≤ B.coeff P) (Q : MMP.Mori.PrimeDivisor Y)
    (hQ : (DivisorWithCoeffs.mapPrimeDivisors φ E).coeff Q ≠ 0) :
    1 ≤ (DivisorWithCoeffs.mapPrimeDivisors φ B).coeff Q := by
  rcases mapPrimeDivisors_coeff_cases hinj Q with ⟨P, -, hP⟩ | h0
  · rw [hP] at hQ ⊢; exact hEB P hQ
  · exact absurd (h0 E) hQ

/-- The coefficients of a combination of Cartier divisors. -/
private theorem coeff_sum_smul_mapCoeffs {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X)
    (Γ : MMP.Mori.PrimeDivisor X) :
    DivisorWithCoeffs.coeff (∑ j, r j • (L j).mapCoeffs (Int.cast : ℤ → ℝ) Int.cast_zero) Γ =
      ∑ j, r j * ((L j).coeff Γ : ℝ) := by
  simpa only [MMP.Flips.toRDivisor_eq_mapCoeffs] using MMP.Flips.coeff_sum_smul_toRDivisor r L Γ

/-- **Shifting a log discrepancy along an `ℝ`-Cartier direction.** A log discrepancy of
`(X, B + t H)` along `E`, for `H` `ℝ`-Cartier, determines those of `(X, B + s H)` for every `s`:
they are `a - (s - t) c`, with `c = ord_E (f^* H)`. -/
private theorem exists_isLogDiscrepancy_add_smul {B H : RDivisor X}
    (hH : IsCartierCombination H) {n : ℕ} {t : ℝ} {E : DivisorOver ℂ sX} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n (B + t • H) E a) :
    ∃ c : ℝ, ∀ s : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (B + s • H) E (a - (s - t) * c) := by
  obtain ⟨hXn, hEp, ω, hω, hK, mm, r, C, C', hC, hcoef, hpb, ha⟩ := ha
  obtain ⟨p, hh, G, hG, rfl⟩ := hH
  haveI := E.isLocallyNoetherian
  haveI := E.isNormal
  haveI := E.isIntegral
  haveI : IsDominant E.f := E.isBirationalMorphism.isDominant
  haveI : CompactSpace E.Y := QuasiCompact.compactSpace_of_compactSpace E.f
  choose G' hG' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant E.f (hG j)
  refine ⟨∑ j, hh j * ((G' j).coeff E.E : ℝ), fun s => ⟨hXn, hEp, ω, hω, hK, mm + p,
    Fin.append r ((s - t) • hh), Fin.append C G, Fin.append C' G', ?_, fun Γ => ?_, ?_, ?_⟩⟩
  · exact Fin.addCases (fun i => by simpa using hC i) (fun j => by simpa using hG j)
  · have hΓ := hcoef Γ
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul]
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      coeff_sum_smul_mapCoeffs] at hΓ ⊢
    have e : ∑ j, (s - t) * hh j * ((G j).coeff Γ : ℝ) =
        (s - t) * ∑ j, hh j * ((G j).coeff Γ : ℝ) := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
    rw [e]
    linarith
  · exact Fin.addCases (fun i => by simpa using hpb i) (fun j => by
      simp only [Fin.append_right]
      exact ⟨MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp E.f (G j), hG' j⟩)
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul]
    have e : ∑ j, (s - t) * hh j * ((G' j).coeff E.E : ℝ) =
        (s - t) * ∑ j, hh j * ((G' j).coeff E.E : ℝ) := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
    rw [e, ha]
    ring

/-- **Log canonicity along a segment.** If `(X, B)` and `(X, B + λ H)` are lc with `H`
`ℝ`-Cartier and effective, then so is `(X, B + t H)` for `0 ≤ t ≤ λ`: log discrepancies are
affine in `t`. -/
private theorem isRealLcPair_add_smul_of_le {B H : RDivisor X}
    (hH : IsCartierCombination H) (hH0 : ∀ P, 0 ≤ H.coeff P) {lam t : ℝ} (ht0 : 0 ≤ t)
    (htl : t ≤ lam) (h0 : IsRealLcPair sX B) (hl : IsRealLcPair sX (B + lam • H)) :
    IsRealLcPair sX (B + t • H) := by
  refine ⟨h0.1, fun P => ?_, ?_, fun n E a ha => ?_⟩
  · rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact add_nonneg (h0.2.1 P) (mul_nonneg ht0 (hH0 P))
  · obtain ⟨n, K, hK, m1, r1, C1, hC1, h1⟩ := h0.2.2.1
    obtain ⟨p, hh, G, hG, hHe⟩ := hH
    refine ⟨n, K, hK, m1 + p, Fin.append r1 (t • hh), Fin.append C1 G,
      Fin.addCases (fun i => by simpa using hC1 i) (fun j => by simpa using hG j), fun Γ => ?_⟩
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul]
    have hΓ := h1 Γ
    subst hHe
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      coeff_sum_smul_mapCoeffs] at hΓ ⊢
    have e : ∑ j, t * hh j * ((G j).coeff Γ : ℝ) = t * ∑ j, hh j * ((G j).coeff Γ : ℝ) := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun j _ => by ring
    rw [e]
    linarith
  · obtain ⟨c, hc⟩ := exists_isLogDiscrepancy_add_smul hH ha
    have hc0 := hc 0
    rw [zero_smul, add_zero] at hc0
    have a₀ := h0.2.2.2 n E _ hc0
    have a₁ := hl.2.2.2 n E _ (hc lam)
    rcases eq_or_lt_of_le (ht0.trans htl) with hl0 | hlpos
    · have ht : t = 0 := le_antisymm (hl0 ▸ htl) ht0
      subst ht
      linarith
    · have k1 : 0 ≤ (lam - t) * (a - (0 - t) * c) := mul_nonneg (by linarith) a₀
      have k2 : 0 ≤ t * (a - (lam - t) * c) := mul_nonneg ht0 a₁
      have k3 : 0 ≤ lam * a := by nlinarith
      exact (mul_nonneg_iff_of_pos_left hlpos).mp k3

/-- **Coherence of the exceptional loci of a divisorial contraction.** For a proper birational
contraction `f` of varieties whose non-open-immersion locus is a prime divisor `E`, the
complement of the preimage of the biregular locus is also `E`: its closed points lie on
contracted curves, which lie in `E`. -/
private theorem mori_exceptionalSet_eq_of_exceptionalSet_eq [LocallyOfFiniteType sX]
    {W : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)} (hXv : MMP.Mori.IsVariety ℂ sX)
    (hWv : MMP.Mori.IsVariety ℂ sW) {f : X ⟶ W} (hfs : f ≫ sW = sX) [IsProper f]
    (hf : IsBirationalMorphism f) (hO : ∀ U : W.Opens, IsIso (f.app U))
    {E : MMP.Mori.PrimeDivisor X} (hE : MMP.Flips.exceptionalSet f = E.support) :
    (MMP.Mori.exceptionalSet f : Set X) = E.support := by
  rw [← hE]
  apply Set.Subset.antisymm
  · -- closed points of the Mori exceptional locus lie on contracted curves
    haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
    have hScl : IsClosed (MMP.Mori.exceptionalSet f : Set X) :=
      (MMP.Mori.exceptionalSet f).isClosed
    rw [← JacobsonSpace.closure_inter_closedPoints hScl]
    refine closure_minimal ?_ (MMP.Flips.isClosed_exceptionalSet f)
    rintro x ⟨hx, hxc⟩
    obtain ⟨C, hCcl, hCirr, hCdim, hxC, y, hCy⟩ :=
      MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hXv hWv f
        hfs hf hO (mem_closedPoints_iff.mp hxc) hx
    set η := hCirr.genericPoint with hηdef
    have hηC : closure {η} = C := by
      rw [hCirr.isGenericPoint_genericPoint_closure.def, hCcl.closure_eq]
    have hηcl : η ∉ closedPoints X := by
      intro hcl
      have hC1 : C = {η} := by rw [← hηC, (mem_closedPoints_iff.mp hcl).closure_eq]
      haveI : Subsingleton C := (hC1 ▸ Set.subsingleton_singleton).coe_sort
      haveI : Nonempty C := ⟨⟨x, hxC⟩⟩
      have h0 := topologicalKrullDim_zero_of_discreteTopology C
      rw [hCdim] at h0
      exact absurd h0 (not_le.mpr zero_lt_one)
    have hfc : ∀ z ∈ closure ({η} : Set X), f z = f η := fun z hz => by
      have h1 : f z ∈ f '' C := ⟨z, hηC ▸ hz, rfl⟩
      have h2 : f η ∈ f '' C := ⟨η, hηC ▸ subset_closure rfl, rfl⟩
      rw [hCy] at h1 h2
      exact h1.trans h2.symm
    have hηE := mem_exceptionalSet_of_forall_eq hηcl hfc
    exact (hηC ▸ closure_minimal (Set.singleton_subset_iff.mpr hηE)
      (MMP.Flips.isClosed_exceptionalSet f)) hxC
  · intro y hy
    by_contra hyM
    apply hy
    have : IsIso (f ∣_ MMP.Mori.biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
    refine ⟨f ⁻¹ᵁ MMP.Mori.biregularLocus f, ?_, ?_⟩
    · by_contra h
      exact hyM (MMP.Mori.mem_exceptionalSet.mpr h)
    · rw [← morphismRestrict_ι]
      infer_instance

/-- **Curves contracted by a negative contraction lie in `E`.** If `D ≡_Z E` with `E ≥ 0` and
`-D` is ample over a contraction `f` over `Z`, every curve contracted by `f` lies in a component
of `E`: its degree against `E` is `D · C < 0`. -/
private theorem exists_coeff_ne_zero_of_isContractedBy [QuasiCompact sX] (hQ : IsQFactorial sX)
    {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)} {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z}
    (hfh : f ≫ h = π) {D E : RDivisor X} (hneg : IsNegativeExtremalContraction ℂ sX sW D f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P)
    (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) :
    ∃ P : MMP.Mori.PrimeDivisor X, E.coeff P ≠ 0 ∧ Γ.point ∈ P.support := by
  have hΓπ : Γ.IsContractedBy π := fun y hy => by
    rw [← hfh]
    change h (f y) = h (f Γ.point)
    rw [hΓ y hy]
  obtain ⟨_, rD, LD, x, hx⟩ := exists_isRIntersectionNumber (k := ℂ) hnum.1 Γ
  obtain ⟨_, rE, LE, y, hy⟩ := exists_isRIntersectionNumber (k := ℂ) hnum.2.1 Γ
  have hxy := hnum.2.2 Γ hΓπ _ _ _ _ _ _ _ _ hx hy
  have hxneg : x < 0 := by
    have h' := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ (-1) 0 hx hx
    rw [zero_smul, add_zero, neg_one_smul] at h'
    have := pos_of_isRelativelyAmple hneg.isRelativelyAntiAmple Γ hΓ h'
    linarith
  exact exists_coeff_ne_zero_of_isRIntersectionNumber_neg hQ hE0 Γ hy (hxy ▸ hxneg)

/-- **The exceptional divisor of a negative divisorial contraction is a component.** If
`D ≡_Z E` with `E ≥ 0` and `-D` is ample over a birational contraction `f` over `Z` whose
exceptional locus is the prime divisor `F`, then `F` is a component of `E`: through a closed point
of `F` off the other components of `E` passes a curve contracted by `f`, and every contracted
curve lies in a component of `E`. -/
private theorem coeff_ne_zero_of_exceptionalSet_eq [QuasiCompact sX] (hQ : IsQFactorial sX)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z} (hfh : f ≫ h = π) {D E : RDivisor X}
    (hneg : IsNegativeExtremalContraction ℂ sX sW D f) (hfb : IsBirationalMorphism f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P)
    {F : MMP.Mori.PrimeDivisor X} (hF : (MMP.Mori.exceptionalSet f : Set X) = F.support) :
    E.coeff F ≠ 0 := by
  intro h0
  haveI : LocallyOfFiniteType sX := hQ.1.1.toLocallyOfFiniteType
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hXp.isProjective
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  have hPc : ∀ P : MMP.Mori.PrimeDivisor X, IsClosed P.support := fun P => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  set B : Set X := ⋃ P ∈ E.support, P.support with hB
  have hBc : IsClosed B := (E.support.finite_toSet).isClosed_biUnion fun P _ => hPc P
  have hFB : F.genericPoint ∉ B := by
    simp only [hB, Set.mem_iUnion]
    rintro ⟨P, hP, hFP⟩
    obtain rfl := eq_of_genericPoint_mem_support hFP
    exact (Finsupp.mem_support_iff.mp hP) h0
  have hFmem : F.genericPoint ∈ F.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  obtain ⟨y, ⟨hyF, hyB⟩, hyc⟩ := nonempty_inter_closedPoints (Z := F.support ∩ Bᶜ)
    ⟨F.genericPoint, hFmem, hFB⟩
    ((hPc F).isLocallyClosed.inter hBc.isOpen_compl.isLocallyClosed)
  have hyE : y ∈ (MMP.Mori.exceptionalSet f : Set X) := hF ▸ hyF
  haveI : IsProper f := hneg.isContraction.isProper
  obtain ⟨Cs, hCc, hCi, hCd, hyC, w, hw⟩ :=
    MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hQ.1.1
      hneg.isNormalVariety_target.1 f hneg.isContraction.comp_eq hfb
      hneg.isContraction.isIso_app (mem_closedPoints_iff.mp hyc) hyE
  have hgen := hCi.isGenericPoint_genericPoint_closure
  rw [hCc.closure_eq] at hgen
  have hη1 : topologicalKrullDim (MMP.Mori.curveSubschemeAt hCi.genericPoint) = 1 := by
    rw [MMP.Chow.topologicalKrullDim_curveSubschemeAt_eq, hgen.def, hCd]
  let Γ : ProperCurve sX := ⟨hCi.genericPoint, MMP.Mori.isProperCurve_of_isProper sX hη1⟩
  have hΓf : Γ.IsContractedBy f := by
    intro x hx
    change x ∈ closure {hCi.genericPoint} at hx
    rw [hgen.def] at hx
    have h1 : f x ∈ ({w} : Set W) := hw ▸ ⟨x, hx, rfl⟩
    have h2 : f hCi.genericPoint ∈ ({w} : Set W) := hw ▸ ⟨_, hgen.mem, rfl⟩
    exact h1.trans h2.symm
  obtain ⟨P, hP, hΓP⟩ := exists_coeff_ne_zero_of_isContractedBy hQ hfh hneg hnum hE0 Γ hΓf
  apply hyB
  simp only [hB, Set.mem_iUnion]
  exact ⟨P, Finsupp.mem_support_iff.mpr hP, (hgen.specializes hyC).mem_closed (hPc P) hΓP⟩

/-- A morphism `f : Y ⟶ W` to an integral scheme with `𝒪_W ⟶ f_* 𝒪_Y` an isomorphism is
dominant: an open subset missing the image would have no sections upstairs. -/
private theorem isDominant_of_isIso_app {Y W : Scheme.{0}} [IsIntegral W] (f : Y ⟶ W)
    (hO : ∀ U : W.Opens, IsIso (f.app U)) : IsDominant f := by
  refine ⟨dense_iff_inter_open.mpr fun V hV hVne => ?_⟩
  by_contra hempty
  rw [Set.not_nonempty_iff_eq_empty] at hempty
  let V' : W.Opens := ⟨V, hV⟩
  have hbot : f ⁻¹ᵁ V' = ⊥ := by
    refine TopologicalSpace.Opens.ext ?_
    rw [TopologicalSpace.Opens.coe_bot, Set.eq_empty_iff_forall_notMem]
    intro y hy
    exact (Set.eq_empty_iff_forall_notMem.mp hempty) (f y) ⟨hy, y, rfl⟩
  have hsub : Subsingleton Γ(Y, f ⁻¹ᵁ V') := by rw [hbot]; infer_instance
  have : Subsingleton Γ(W, V') :=
    (ConcreteCategory.bijective_of_isIso (f.app V')).1.subsingleton
  obtain ⟨x, hx⟩ := hVne
  have h10 := congrArg (W.presheaf.germ V' x hx).hom (Subsingleton.elim (1 : Γ(W, V')) 0)
  rw [map_one, map_zero] at h10
  exact one_ne_zero h10

/-- **No fibre type.** A `D`-negative extremal contraction `f` over `Z` of a projective variety,
with `D ≡_Z E` for an effective `E`, preserves dimension: every contracted curve lies in
`Supp E`, while if `dim W < dim X` every fibre component has positive dimension, so a closed
point outside `Supp E` lies on a contracted curve not contained in `Supp E`. -/
private theorem topologicalKrullDim_eq_of_isNegativeExtremalContraction [QuasiCompact sX]
    [LocallyOfFiniteType sX] (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ : IsQFactorial sX)
    {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z} (hfh : f ≫ h = π) {D E : RDivisor X}
    (hneg : IsNegativeExtremalContraction ℂ sX sW D f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P) :
    topologicalKrullDim W = topologicalKrullDim X := by
  classical
  by_contra hne
  have hfs : f ≫ sW = sX := hneg.isContraction.comp_eq
  have hXn := hneg.isNormalVariety_source
  have hWn := hneg.isNormalVariety_target
  haveI : IsIntegral W := hWn.1.toIsIntegral
  haveI : AlgebraicGeometry.IsVariety ℂ sX := hXn.1
  haveI : AlgebraicGeometry.IsVariety ℂ sW := hWn.1
  haveI : IsProper f := hneg.isContraction.isProper
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ hXp.isProjective
  haveI : IsDominant f := isDominant_of_isIso_app f hneg.isContraction.isIso_app
  obtain ⟨hfib, ⟨V, hVd, hV⟩, -⟩ := MMP.topologicalKrullDim_fiber_of_isDominant ℂ sX sW f hfs
  -- every contracted curve lies in `Supp E`
  have hcurve : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f → Γ.point ∈ E.supp := fun Γ hΓ => by
    obtain ⟨P, hP, hΓP⟩ := exists_coeff_ne_zero_of_isContractedBy hQ hfh hneg hnum hE0 Γ hΓ
    exact DivisorWithCoeffs.mem_supp_iff.mpr ⟨P, hP, hΓP⟩
  -- `dim W ≤ dim X`, from the generic fibre
  have hη : f (genericPoint X) = genericPoint W :=
    MMP.Positivity.map_genericPoint_eq_of_isDominant f
  have hηV : f (genericPoint X) ∈ V := by
    rw [hη]
    exact ((genericPoint_spec W).mem_open_set_iff V.isOpen).mpr (by simpa using hVd.nonempty)
  have hWX : topologicalKrullDim W ≤ topologicalKrullDim X := by
    obtain ⟨Z', hZ', hηZ'⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      {f.asFiber (genericPoint X)} isIrreducible_singleton
    rw [← hV _ hηV Z' hZ']
    have : (0 : WithBot ℕ∞) ≤ topologicalKrullDim Z' := by
      haveI : Nonempty (TopologicalSpace.IrreducibleCloseds Z') :=
        ⟨⟨closure {⟨_, hηZ' rfl⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      exact Order.krullDim_nonneg
    exact le_add_of_nonneg_left this
  have hlt : topologicalKrullDim W < topologicalKrullDim X := lt_of_le_of_ne hWX hne
  -- a closed point outside `Supp E`
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  have hSc : IsClosed (E.supp : Set X) := E.supp.isClosed
  have hgen : genericPoint X ∉ (E.supp : Set X) := by
    intro hmem
    obtain ⟨P, -, hxP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    exact MMP.Threefold.Mori.CanonUniq.genericPoint_notMem_support P hxP
  obtain ⟨p, hpS, hpcl⟩ := nonempty_inter_closedPoints (Z := (E.supp : Set X)ᶜ) ⟨_, hgen⟩
    hSc.isOpen_compl.isLocallyClosed
  rw [mem_closedPoints_iff] at hpcl
  -- a component of the fibre through `p`, of positive dimension
  obtain ⟨Zc, hZc, hpZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    {f.asFiber p} isIrreducible_singleton
  have hZpos : 0 < topologicalKrullDim Zc := by
    by_contra hle
    push_neg at hle
    have h1 := hfib (f p) Zc hZc
    have h2 : topologicalKrullDim X ≤ topologicalKrullDim W :=
      h1.trans (by
        calc topologicalKrullDim Zc + topologicalKrullDim W ≤ 0 + topologicalKrullDim W := by
              gcongr
          _ = topologicalKrullDim W := zero_add _)
    exact absurd hlt (not_lt.mpr h2)
  have hZirr : IsIrreducible Zc := hZc.1
  have hZcl : IsClosed Zc := isClosed_of_mem_irreducibleComponents Zc hZc
  set ηF := hZirr.genericPoint with hηFdef
  have hηF : closure {ηF} = Zc := by
    rw [hZirr.isGenericPoint_genericPoint_closure.def, hZcl.closure_eq]
  set η := f.fiberι (f p) ηF with hηdef
  have hinj := (f.fiberι (f p)).isEmbedding.injective
  have hηp : η ⤳ p := by
    have h1 : ηF ⤳ f.asFiber p := specializes_iff_mem_closure.mpr (hηF ▸ hpZ rfl)
    have h2 := h1.map (f.fiberι (f p)).continuous
    rwa [Scheme.Hom.fiberι_asFiber] at h2
  have hηne : η ≠ p := by
    intro heq
    have h1 : ηF = f.asFiber p := hinj (heq.trans (Scheme.Hom.fiberι_asFiber f p).symm)
    have hcl : IsClosed ({f.asFiber p} : Set (f.fiber (f p))) := by
      have e : ({f.asFiber p} : Set (f.fiber (f p))) = (f.fiberι (f p)) ⁻¹' {p} := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl; exact Scheme.Hom.fiberι_asFiber f p
        · intro hz; exact hinj (hz.trans (Scheme.Hom.fiberι_asFiber f p).symm)
      rw [e]; exact hpcl.preimage (f.fiberι (f p)).continuous
    have hZ1 : Zc = {f.asFiber p} := by rw [← hηF, h1, hcl.closure_eq]
    haveI : Subsingleton Zc := (hZ1 ▸ Set.subsingleton_singleton).coe_sort
    have : topologicalKrullDim Zc ≤ 0 := topologicalKrullDim_zero_of_discreteTopology Zc
    exact absurd hZpos (not_lt.mpr this)
  -- a contracted curve through `p` outside `Supp E`
  have hηS : η ∉ (E.supp : Set X) := fun h => hpS (hηp.mem_closed hSc h)
  obtain ⟨y, hηy, -, hyZ, hcurv⟩ := MMP.Fourfold.exists_isProperCurve_of_specializes sX hηp hpcl
    (hSc.union hpcl) (Or.inr rfl) (by
      rintro (h | h)
      exacts [hηS h, hηne h])
  have hfp : IsClosed ({f p} : Set W) := by
    simpa [Set.image_singleton] using f.isClosedMap _ hpcl
  have hsub : closure ({η} : Set X) ⊆ f ⁻¹' {f p} := by
    refine closure_minimal (Set.singleton_subset_iff.mpr ?_) (hfp.preimage f.continuous)
    have : η ∈ Set.range (f.fiberι (f p)) := ⟨ηF, rfl⟩
    rwa [Scheme.Hom.range_fiberι] at this
  have hyc : closure ({y} : Set X) ⊆ f ⁻¹' {f p} :=
    (specializes_iff_closure_subset.mp hηy).trans hsub
  have hΓ : (⟨y, hcurv⟩ : ProperCurve sX).IsContractedBy f := fun z hz => by
    change f z = f y
    rw [show f z = f p from hyc hz, show f y = f p from hyc (subset_closure rfl)]
  exact hyZ (Or.inl (hcurve ⟨y, hcurv⟩ hΓ))

/-- **A negative contraction meets the floor.** If `D ≡_Z E` with `E ≥ 0` supported in `⌊B⌋`, the
exceptional locus of a `D`-negative extremal contraction over `Z` meets `⌊B⌋`: a contracted curve
lies in `Ex(f)` and has negative degree against `E`, so lies in a component of `E`. -/
private theorem exceptionalSet_inter_supp_roundDown_nonempty [QuasiCompact sX]
    [LocallyOfFiniteType sX] (hQ : IsQFactorial sX) {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z} (hfh : f ≫ h = π) {D E B : RDivisor X}
    (hneg : IsNegativeExtremalContraction ℂ sX sW D f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P)
    (hEB : ∀ P, E.coeff P ≠ 0 → 1 ≤ B.coeff P) :
    (MMP.Flips.exceptionalSet f ∩
      ((DivisorWithCoeffs.roundDown B).supp : Set X)).Nonempty := by
  obtain ⟨Γ, hΓ⟩ := exists_properCurve_isContractedBy_of_isNegativeExtremalContraction hneg
  obtain ⟨P, hP, hΓP⟩ := exists_coeff_ne_zero_of_isContractedBy hQ hfh hneg hnum hE0 Γ hΓ
  refine ⟨Γ.point, point_mem_exceptionalSet_of_isContractedBy Γ hΓ,
    DivisorWithCoeffs.mem_supp_iff.mpr ⟨P, ?_, hΓP⟩⟩
  rw [DivisorWithCoeffs.coeff_roundDown]
  have h1 : (1 : ℤ) ≤ ⌊B.coeff P⌋ := Int.le_floor.mpr (by exact_mod_cast hEB P hP)
  omega

/-- The strict transform is additive and homogeneous on `B + t H`. -/
private theorem transformDivisor_add_smul {Y : Scheme.{0}} (φ : X.RationalMap Y)
    (B H : RDivisor X) (t : ℝ) :
    RationalMap.transformDivisor φ (B + t • H) =
      RationalMap.transformDivisor φ B + t • RationalMap.transformDivisor φ H := by
  rw [map_add]
  congr 1
  exact DivisorWithCoeffs.mapPrimeDivisors_smul _ t H

/-- A divisor that is nef over a base together with its negative is numerically trivial. -/
private theorem isNumericallyTrivialOver_of_isRelativelyNef_neg [QuasiCompact sX]
    {Y : Scheme.{0}} {f : X ⟶ Y} {N : RDivisor X} (h₁ : IsRelativelyNef ℂ sX f N)
    (h₂ : IsRelativelyNef ℂ sX f (-N)) : IsNumericallyTrivialOver ℂ sX f N := by
  have hNc := isCartierCombination_of_isRelativelyNef' h₁
  refine ⟨hNc, isCartierCombination_zero', fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have hl := IsRIntersectionNumber.eq_and_linear ℂ sX C
  obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := ℂ) hNc C
  have h00 := hl.2 _ _ _ _ _ _ _ _ 0 0 hy hy
  simp only [zero_smul, add_zero, zero_mul] at h00
  rw [hl.1 _ _ _ _ _ _ _ hx₂ h00]
  have hneg := hl.2 _ _ _ _ _ _ _ _ (-1) 0 hx₁ hy
  rw [zero_smul, add_zero, neg_one_smul, zero_mul, add_zero] at hneg
  have a := nonneg_of_isRelativelyNef' h₁ C hC hx₁
  have b := nonneg_of_isRelativelyNef' h₂ C hC hneg
  linarith

/-- **Numerical triviality across a step.** If `N = f^* D` is numerically trivial over `S` for a
proper surjection `f : X ⟶ W` over `S`, then so is `N⁺ = f⁺^* D` for any proper `f⁺ : X⁺ ⟶ W`. -/
private theorem isNumericallyTrivialOver_of_isRCartierPullback [QuasiCompact sX]
    [LocallyOfFiniteType sX] {W X' S : Scheme.{0}} [IsIntegral X'] [IsLocallyNoetherian X']
    [IsNormal X'] [CompactSpace X'] [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)}
    {sX' : X' ⟶ Spec (.of ℂ)} [IsSeparated sW] [LocallyOfFiniteType sW] [QuasiCompact sW]
    [QuasiCompact sX'] {f : X ⟶ W} [IsProper f] [Surjective f] (hfs : f ≫ sW = sX)
    {fp : X' ⟶ W} [IsProper fp] (hfps : fp ≫ sW = sX') (h : W ⟶ S) {D : RDivisor W}
    {N : RDivisor X} {N' : RDivisor X'} (hN : IsRCartierPullback f D N)
    (hN' : IsRCartierPullback fp D N') (htriv : IsNumericallyTrivialOver ℂ sX (f ≫ h) N) :
    IsNumericallyTrivialOver ℂ sX' (fp ≫ h) N' := by
  subst hfps
  have h1 := isRelativelyNef_of_isNumericallyTrivialOver htriv
  have h3 : IsNumericallyTrivialOver ℂ sX (f ≫ h) (-N) := by
    have := numEq_smul htriv (-1)
    rwa [smul_zero, neg_one_smul] at this
  have h2 := isRelativelyNef_of_isNumericallyTrivialOver h3
  have hD1 := IsRelativelyNef.of_isRCartierPullback_of_surjective f hfs h hN h1
  have hD2 := IsRelativelyNef.of_isRCartierPullback_of_surjective f hfs h
    (by simpa using MMP.Fourfold.isRCartierPullback_smul (-1) hN) h2
  have e1 := isRelativelyNef_of_isRCartierPullback (k := ℂ) (𝟙 S) h (fp ≫ h) fp
    (Category.comp_id _) hD1 hN'
  have e2 := isRelativelyNef_of_isRCartierPullback (k := ℂ) (𝟙 S) h (fp ≫ h) fp
    (Category.comp_id _) hD2 (by simpa using MMP.Fourfold.isRCartierPullback_smul (-1) hN')
  exact isNumericallyTrivialOver_of_isRelativelyNef_neg e1 e2

/-- The push-forward of a pull-back along a proper birational morphism of normal varieties is the
divisor itself. -/
private theorem transformDivisor_eq_of_isRCartierPullback' {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (hW : IsNormalVariety ℂ sW) {f : X ⟶ W} (hfs : f ≫ sW = sX) [IsProper f]
    (hf : IsBirationalMorphism f) {D : RDivisor W} {N : RDivisor X}
    (hN : IsRCartierPullback f D N) :
    RationalMap.transformDivisor (X := X) f.toRationalMap N = D := by
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hW
  have hinv := MMP.Mori.RationalMap.IsBirational.isInverse_inverse hf
  have hX' : IsNormalVariety ℂ (f ≫ sW) := by rw [hfs]; exact hX
  have h1 := MMP.Fourfold.transformDivisor_eq_of_isRCartierPullback hW hW
    (φ := Scheme.Hom.toRationalMap (𝟙 W))
    (fun F hF => hF F (transformPrimeDivisor_id F)) f f _ hX' hX' hf hf hinv
    (compHom_eq_of_isInverse hinv) hN
  rw [h1, transformDivisor_id]

/-- **Prime divisors across two small contractions.** For small contractions `f`, `f⁺` to a
normal variety and a birational map `ψ` over it which is a morphism in codimension one, no two
prime divisors have the same transform. -/
private theorem transformPrimeDivisor_injective_of_isSmall {Y Y' T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    [IsSeparated (Y' ↘ ⊤_ Scheme)] {sT : T ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)}
    {sY' : Y' ⟶ Spec (.of ℂ)} (hT : IsNormalVariety ℂ sT) {f : Y ⟶ T} {fp : Y' ⟶ T}
    (hf : IsSmall ℂ sT sY f) (hfp : IsSmall ℂ sT sY' fp) {ψ : Y.RationalMap Y'}
    (hψ : MMP.Flips.RationalMap.IsOver f fp ψ)
    (hcod : MMP.Flips.RationalMap.IsMorphismInCodimOne ψ) :
    ∀ P P' Q, RationalMap.transformPrimeDivisor ψ P = some Q →
      RationalMap.transformPrimeDivisor ψ P' = some Q → P = P' := by
  haveI : IsIntegral T := hT.1.toIsIntegral
  haveI : IsNormal T := hT.2
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian sT
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hT
  haveI : IsProper f := hf.isProper
  haveI : IsProper fp := hfp.isProper
  have hfb : IsBirationalMorphism f := hf.surjective_and_isBirational.2
  have hfpb : IsBirationalMorphism fp := hfp.surjective_and_isBirational.2
  intro P P' Q h₁ h₂
  have hc := coheight_map_le_one_of_isSmall hf P
  have hb1 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hfb hc
  have hb2 := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal fp hfpb hc
  obtain ⟨F', -, -, htr, huniq, -⟩ := exists_transformPrimeDivisor_eq_of_isOver hψ
    (definedAt_genericPoint_of_isMorphismInCodimOne hcod) P hb1 hb2
  rw [h₁] at htr
  cases htr
  exact (huniq P' h₂).symm

/-- **Pull-backs compose.** If `D = f^*M` and `G = g^*D`, then `G = (g ≫ f)^*M`. -/
private theorem isRCartierPullback_comp' {Y V : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V]
    [CompactSpace V] {f : Y ⟶ X} {g : V ⟶ Y} [IsDominant f] [IsDominant g] {M : RDivisor X}
    {D : RDivisor Y} {G : RDivisor V} (hD : IsRCartierPullback f M D)
    (hG : IsRCartierPullback g D G) : IsRCartierPullback (g ≫ f) M G := by
  obtain ⟨m, r, L, L', hLc, hM, hpb, rfl⟩ := hD
  have hL'c : ∀ j, (L' j).IsCartier := fun j => ((hpb j).2).isCartier (hLc j)
  let L'' : Fin m → Divisor V := fun j => (L' j).pullback (hL'c j)
    (MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant g _)
  have hL'' : ∀ j, (L' j).IsPullback g
      (MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant g _) (L'' j) :=
    fun j => Divisor.isPullback_pullback (hL'c j) _
  have hG' : IsRCartierPullback g (∑ j, r j • Divisor.toRDivisor (L' j))
      (∑ j, r j • Divisor.toRDivisor (L'' j)) :=
    ⟨m, r, L', L'', hL'c, rfl, fun j => ⟨_, hL'' j⟩, rfl⟩
  rw [MMP.Flips.IsRCartierPullback.eq g hG hG']
  exact ⟨m, r, L, L'', hLc, hM, fun j =>
    ⟨MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant (g ≫ f) _,
      MMP.ProgramBaseChange.divisor_isPullback_comp rfl (hpb j).2 (hL'' j) _⟩, rfl⟩

/-- **Log discrepancies are crepant invariants.** Let `p : V ⟶ X` be a proper birational morphism
of normal varieties, `ω` a nonzero rational top form on `X` with canonical divisor,
`K_V = div(p^*ω)` canonical, and `K_V + B_V = p^*(K_X + B)`. Then every log discrepancy of
`(V, B_V)` along a divisor `(D, g, E)` over `V` is the log discrepancy of `(X, B)` along
`(D, g ≫ p, E)`. -/
private theorem isLogDiscrepancy_comp_of_isRCartierPullback [LocallyOfFiniteType sX]
    (hX : IsNormalVariety ℂ sX) {V : Scheme.{0}} [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] {p : V ⟶ X} [IsProper p] [IsDominant p]
    (hV : IsNormalVariety ℂ (p ≫ sX))
    (hp : IsBirationalMorphism p) {n : ℕ} {ω : RationalPluriForms sX n 1} (hω0 : ω ≠ 0)
    (hK : (divisorOfForm ω).IsCanonicalDivisor sX n)
    (hKV : (divisorOfForm (pullbackRationalPluriForms sX p ω)).IsCanonicalDivisor (p ≫ sX) n)
    {B : RDivisor X} {BV : RDivisor V}
    (hBV : IsRCartierPullback p (logCanonicalDivisor (divisorOfForm ω) B)
      (logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sX p ω)) BV))
    (D : DivisorOver ℂ (p ≫ sX)) {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy (p ≫ sX) n BV D a) :
    ∃ (hD : IsNormalVariety ℂ (D.f ≫ p ≫ sX)) (hDb : IsBirationalMorphism (D.f ≫ p)),
      MMP.Intersection.IsLogDiscrepancy sX n B ⟨D.Y, D.f ≫ p, by
        rw [Category.assoc]; exact hD, hDb, D.E⟩ a := by
  classical
  obtain ⟨DY, Df, hDn, hDb, DE⟩ := D
  haveI : IsIntegral DY := hDn.1.toIsIntegral
  haveI : IsNormal DY := hDn.2
  haveI : LocallyOfFiniteType (Df ≫ p ≫ sX) := hDn.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian DY := LocallyOfFiniteType.isLocallyNoetherian (Df ≫ p ≫ sX)
  have hDfP : IsProper Df := ha.2.1
  haveI := hDfP
  haveI : LocallyOfFiniteType (p ≫ sX) := hV.1.toLocallyOfFiniteType
  haveI : QuasiCompact (Df ≫ p ≫ sX) := hDn.1.toQuasiCompact
  haveI : CompactSpace DY := QuasiCompact.compactSpace_of_compactSpace (Df ≫ p ≫ sX)
  haveI : IsDominant Df := hDb.isDominant
  have hDpb : IsBirationalMorphism (Df ≫ p) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hDb hp
  haveI : IsProper (Df ≫ p) := inferInstance
  have hDn' : IsNormalVariety ℂ ((Df ≫ p) ≫ sX) := by rw [Category.assoc]; exact hDn
  refine ⟨hDn, hDpb, ?_⟩
  -- the pull-back of `K_V + B_V` to the model of the divisor
  have hBVc : IsCartierCombination
      (logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sX p ω)) BV) := by
    obtain ⟨m, r, L, L', hL, -, hpb, he⟩ := hBV
    exact ⟨m, r, L', fun j => (hpb j).2.isCartier (hL j), he⟩
  obtain ⟨GD, hGD, -⟩ := MMP.Flips.existsUnique_isRCartierPullback Df hBVc
  have h1 := isLogDiscrepancy_of_isRCartierPullback hV hDn hDb
    (MMP.Fourfold.Oai4C1.Main.pullbackRationalPluriForms_ne_zero p hp.functionFieldMap_bijective
      (MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq hK.topologicalKrullDim_eq) hω0)
    hKV hGD DE
  have haeq := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1
  -- the same pull-back along the composite
  have hcomp := isRCartierPullback_comp' hBV hGD
  have h2 := isLogDiscrepancy_of_isRCartierPullback hX hDn' hDpb hω0 hK hcomp DE
  convert h2 using 1
  rw [haeq]
  congr 2
  change (DE.ordForm (pullbackRationalPluriForms (p ≫ sX) Df
    (pullbackRationalPluriForms sX p ω)) : ℝ) = (DE.ordForm (pullbackRationalPluriForms sX (Df ≫ p) ω))
  rw [MMP.Flips.pullbackRationalPluriForms_comp p Df hp.functionFieldMap_bijective
    hDb.functionFieldMap_bijective
    (MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq hK.topologicalKrullDim_eq) ω]
  rfl

/-- **Valuations through a model.** If the birational morphism `f : A ⟶ B` sends the generic
point of the prime divisor `E` to that of `P`, then `ord_E` read on `k(Y)` through `c = f ≫ g`
is `ord_P` read through `g`. -/
private theorem valuationOver_eq_of_comp_eq {A B Y : Scheme.{0}} [IsIntegral A]
    [IsLocallyNoetherian A] [IsNormal A] [IsIntegral B] [IsLocallyNoetherian B] [IsNormal B]
    [IsIntegral Y] {f : A ⟶ B} [IsDominant f] (hf : Function.Surjective (functionFieldMap f))
    {g : B ⟶ Y} [IsDominant g] {c : A ⟶ Y} [IsDominant c] (hc : f ≫ g = c)
    {E : MMP.Mori.PrimeDivisor A} {P : MMP.Mori.PrimeDivisor B}
    (h : f E.genericPoint = P.genericPoint) :
    E.valuationOver c = P.valuationOver g := by
  have h1 := MMP.Fourfold.Oai4C1.CommonModel.valuationOver_eq_of_map_genericPoint f hf E P h
  refine Valuation.ext fun t => ?_
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.PrimeDivisor.valuationOver_apply,
    ← MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply f g hc, ← h1,
    MMP.Mori.PrimeDivisor.valuationOver_apply]

/-- The valuation of a divisor `(Y', f, E)` over `Y` is `ord_E` read through `f`. -/
private theorem divisorOver_valuation_mk {Y Y' : Scheme.{0}} [IsIntegral Y] {sY : Y ⟶ Spec (.of ℂ)}
    [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y'] {f : Y' ⟶ Y} [IsDominant f]
    (h₁ : IsNormalVariety ℂ (f ≫ sY)) (h₂ : IsBirationalMorphism f) (E : MMP.Mori.PrimeDivisor Y') :
    (MMP.Mori.DivisorOver.mk Y' f h₁ h₂ E : MMP.Mori.DivisorOver ℂ sY).valuation =
      E.valuationOver f := rfl

/-- **Prime divisors are determined by their valuations.** Two prime divisors of a normal
variety `A` whose valuations agree on `k(Y)`, read through a dominant `g : A ⟶ Y` with
`g^* : k(Y) → k(A)` surjective, are equal. -/
private theorem eq_of_valuationOver_eq {A Y : Scheme.{0}} [IsIntegral A] [IsLocallyNoetherian A]
    [IsNormal A] [IsIntegral Y] {sA : A ⟶ Spec (.of ℂ)} (hA : IsNormalVariety ℂ sA) {g : A ⟶ Y}
    [IsDominant g] (hg : Function.Surjective (functionFieldMap g))
    {E E' : MMP.Mori.PrimeDivisor A} (h : E.valuationOver g = E'.valuationOver g) : E = E' := by
  have h1 : E.divisorialValuation = E'.divisorialValuation := Valuation.ext fun t => by
    obtain ⟨s, rfl⟩ := hg t
    have := DFunLike.congr_fun h s
    rwa [MMP.Mori.PrimeDivisor.valuationOver_apply,
      MMP.Mori.PrimeDivisor.valuationOver_apply] at this
  have h2 : (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hA E).valuation =
      (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hA E').valuation := by
    refine Valuation.ext fun t => ?_
    change E.divisorialValuation (functionFieldMap (𝟙 A) t) =
      E'.divisorialValuation (functionFieldMap (𝟙 A) t)
    rw [h1]
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hA.1 h2)

/-- **Prime divisors transformed through a common model.** Let `p : W ⟶ X` be a proper birational
morphism with inverse `H` such that every prime divisor of `X` has a strict transform on `W`,
`r : W ⟶ V` a separated birational morphism and `F_W` a prime divisor of `W` over the prime
divisor `F` of `V`. Then `r ∘ H` sends `P` to `F` exactly when `p` sends the generic point of
`F_W` to that of `P`. -/
private theorem transformPrimeDivisor_compHom_eq_some_iff {X W V : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsSeparated (X ↘ ⊤_ Scheme)] [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] [IsSeparated (W ↘ ⊤_ Scheme)] [IsIntegral V]
    [IsLocallyNoetherian V] [IsNormal V] [IsSeparated (V ↘ ⊤_ Scheme)] {p : W ⟶ X} [IsProper p]
    [IsDominant p] (hp : Function.Bijective (functionFieldMap p)) {H : X.RationalMap W}
    (hH : RationalMap.IsInverse p.toRationalMap H) {r : W ⟶ V} [IsSeparated r] [IsDominant r]
    (hr : Function.Bijective (functionFieldMap r)) {F : MMP.Mori.PrimeDivisor V}
    {FW : MMP.Mori.PrimeDivisor W} (hFW : r FW.genericPoint = F.genericPoint)
    (hex : ∀ P : MMP.Mori.PrimeDivisor X, ∃ PW : MMP.Mori.PrimeDivisor W,
      p PW.genericPoint = P.genericPoint) (P : MMP.Mori.PrimeDivisor X) :
    RationalMap.transformPrimeDivisor (H.compHom r) P = some F ↔
      p FW.genericPoint = P.genericPoint := by
  constructor
  · intro h
    obtain ⟨PW, hPW⟩ := hex P
    have h1 := transformPrimeDivisor_eq_some_of_isInverse hp hH hPW
    rw [transformPrimeDivisor_compHom h1 r,
      MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff] at h
    rw [← eq_of_map_eq_genericPoint r hr h hFW]
    exact hPW
  · intro h
    have h1 := transformPrimeDivisor_eq_some_of_isInverse hp hH h
    rw [transformPrimeDivisor_compHom h1 r,
      MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
    exact hFW

open Classical in
/-- The boundary coefficient `mult_F φ_* D + [F new]` along a prime divisor `F` which is the
transform of exactly one prime divisor `P` is `mult_P D`. -/
private theorem coeff_boundary_of_eq_some {X Y : Scheme.{0}} {φ : X.RationalMap Y}
    {P : MMP.Mori.PrimeDivisor X} {F : MMP.Mori.PrimeDivisor Y}
    (hP : RationalMap.transformPrimeDivisor φ P = some F)
    (huniq : ∀ P', RationalMap.transformPrimeDivisor φ P' = some F → P' = P) (D : RDivisor X) :
    (RationalMap.transformDivisor φ D).coeff F +
      (if RationalMap.IsInverseExceptional φ F then 1 else 0) = D.coeff P := by
  rw [if_neg (fun h => h P hP), add_zero]
  exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hP huniq D

open Classical in
/-- The boundary coefficient `mult_F φ_* D + [F new]` along a prime divisor `F` which is the
transform of no prime divisor is one. -/
private theorem coeff_boundary_of_forall_ne {X Y : Scheme.{0}} {φ : X.RationalMap Y}
    {F : MMP.Mori.PrimeDivisor Y} (h : ∀ P, RationalMap.transformPrimeDivisor φ P ≠ some F)
    (D : RDivisor X) :
    (RationalMap.transformDivisor φ D).coeff F +
      (if RationalMap.IsInverseExceptional φ F then 1 else 0) = 1 := by
  have h0 : (RationalMap.transformDivisor φ D).coeff F = 0 :=
    MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne h D
  rw [if_pos (show RationalMap.IsInverseExceptional φ F from h), h0, zero_add]

end ScalingHelpers

section ScalingProgram

/-! ### The program with scaling of a general ample divisor -/

/-- A model of a program with scaling over `Z`: a scheme `M` over `ℂ` and over `Z`, with a
canonical divisor `K`, a boundary `B`, a scaling divisor `H`, an effective divisor `E` with
`K + B ≡_Z E`, and the current level `λ` of the scaling. -/
private structure ScalingStage (Z : Scheme.{0}) where
  M : Scheme.{0}
  [isIntegral : IsIntegral M]
  [compactSpace : CompactSpace M]
  [isLocallyNoetherian : IsLocallyNoetherian M]
  [isNormal : IsNormal M]
  s : M ⟶ Spec (.of ℂ)
  π : M ⟶ Z
  K : Divisor M
  B : RDivisor M
  H : RDivisor M
  E : RDivisor M
  lam : ℝ

attribute [local instance] ScalingStage.isIntegral ScalingStage.compactSpace
  ScalingStage.isLocallyNoetherian ScalingStage.isNormal

variable {Z : Scheme.{0}}

/-- The standing invariants of a model of the program: a projective `ℚ`-factorial fourfold over
`Z` with dlt pair `(M, B)`, effective `H`, a nef lc level `B + λ H` with `λ ≥ 0`, and
`K + B ≡_Z E` for an effective `E` supported in `⌊B⌋`. -/
private structure ScalingStage.IsGood (sZ : Z ⟶ Spec (.of ℂ)) (m : ScalingStage Z) : Prop where
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ m.s
  isQFactorial : IsQFactorial m.s
  dim_eq : topologicalKrullDim m.M = 4
  isCanonicalDivisor : m.K.IsCanonicalDivisor m.s 4
  comp_eq : m.π ≫ sZ = m.s
  isRealDltPair : IsRealDltPair m.s m.B
  coeff_H_nonneg : ∀ P, 0 ≤ m.H.coeff P
  lam_nonneg : 0 ≤ m.lam
  isRelativelyNef_upper :
    IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K (m.B + m.lam • m.H))
  isRealLcPair_upper : IsRealLcPair m.s (m.B + m.lam • m.H)
  numEq : IsNumericallyEquivalentOver ℂ m.s m.π (logCanonicalDivisor m.K m.B) m.E
  coeff_E_nonneg : ∀ P, 0 ≤ m.E.coeff P
  one_le_coeff_B : ∀ P, m.E.coeff P ≠ 0 → 1 ≤ m.B.coeff P

/-- The data of a step `M ⟶ W ⟵ M'` of the program. -/
private structure ScalingStep (m m' : ScalingStage Z) where
  W : Scheme.{0}
  [isLocallyNoetherian : IsLocallyNoetherian W]
  [isNormal : IsNormal W]
  sW : W ⟶ Spec (.of ℂ)
  f : m.M ⟶ W
  g : W ⟶ Z
  fp : m'.M ⟶ W
  ψ : m.M.RationalMap m'.M

attribute [local instance] ScalingStep.isLocallyNoetherian ScalingStep.isNormal

/-- A step of the `(K + B)`-program with scaling of `H` at the threshold `λ' = m'.lam`: the
contraction of a `(K + B)`-negative extremal ray on which `K + B + λ' H` is trivial, divisorial
or followed by its flip, transporting `K`, `B` and `H`. -/
private structure ScalingStep.IsStep {m m' : ScalingStage Z} (st : ScalingStep m m') : Prop where
  comp_eq : st.f ≫ st.g = m.π
  comp_eq_plus : st.fp ≫ st.g = m'.π
  isNormalVariety_target : IsNormalVariety ℂ st.sW
  comp_eq_s : st.f ≫ st.sW = m.s
  comp_eq_s_plus : st.fp ≫ st.sW = m'.s
  isProper : IsProper st.f
  isProper_plus : IsProper st.fp
  isBirationalMorphism : IsBirationalMorphism st.f
  isBirationalMorphism_plus : IsBirationalMorphism st.fp
  isModificationOf : IsModificationOf st.f st.fp st.ψ
  isLeast : IsLeast {t : ℝ | 0 ≤ t ∧
    IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K (m.B + t • m.H))} m'.lam
  isNegativeExtremalContraction :
    IsNegativeExtremalContraction ℂ m.s st.sW (logCanonicalDivisor m.K m.B) st.f
  kind : (AlgebraicGeometry.IsQuasiProjectiveVariety ℂ st.sW ∧ IsProjectiveMorphism st.f ∧
      (∃ E : MMP.Mori.PrimeDivisor m.M, (MMP.Mori.exceptionalSet st.f : Set m.M) = E.support) ∧
      IsIso st.fp) ∨
    (IsRealFlipStep m.s st.sW m'.s m.K m.B m'.K m'.B st.f st.fp ∧
      MMP.Flips.RationalMap.IsMorphismInCodimOne st.ψ)
  meets_floor : (MMP.Flips.exceptionalSet st.f ∩
    ((DivisorWithCoeffs.roundDown m.B).supp : Set m.M)).Nonempty
  eq_K : m'.K = flipTransform st.f st.fp m.K
  eq_B : m'.B = flipTransform st.f st.fp m.B
  eq_H : m'.H = flipTransform st.f st.fp m.H
  transformDivisor_eq : ∀ D : RDivisor m.M,
    RationalMap.transformDivisor st.ψ D = flipTransform st.f st.fp D
  desc : ∃ D : RDivisor st.W,
    IsRCartierPullback st.f D (logCanonicalDivisor m.K (m.B + m'.lam • m.H)) ∧
      IsRCartierPullback st.fp D
        (flipTransform st.f st.fp (logCanonicalDivisor m.K (m.B + m'.lam • m.H)))

/-- **One step of the program.** A model whose adjoint `K + B` is not nef over `Z` has a next
model: the nef threshold `λ' ∈ (0, λ]` of `H` is attained on a `(K + B)`-negative extremal ray,
whose contraction is birational (a contraction of fibre type would contract a curve outside the
effective `E ≡_Z K + B`), divisorial or small, followed by its flip in the small case. -/
private theorem ScalingStage.exists_scalingStep {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m : ScalingStage Z} (hm : m.IsGood sZ)
    (hnot : ¬ IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B)) :
    ∃ (m' : ScalingStage Z) (st : ScalingStep m m'), st.IsStep ∧ m'.IsGood sZ := by
  classical
  obtain ⟨hproj, hQ, hdimM, hK, hπ, hdlt, hH0, hlam0, hnefU, hlcU, hnumE, hE0, hEB⟩ := hm
  have hMv : MMP.Mori.IsVariety ℂ m.s := hproj.toIsVariety
  haveI : QuasiCompact m.s := hMv.toQuasiCompact
  haveI : LocallyOfFiniteType m.s := hMv.toLocallyOfFiniteType
  have hMn : IsNormalVariety ℂ m.s := hQ.1
  have hB0 : ∀ P, 0 ≤ m.B.coeff P := hdlt.1.2.1
  have hD' : ∀ t : ℝ, logCanonicalDivisor m.K (m.B + t • m.H) =
      logCanonicalDivisor m.K m.B + t • m.H := fun t => by
    rw [logCanonicalDivisor, logCanonicalDivisor, add_assoc]
  have hlampos : 0 < m.lam := by
    rcases hlam0.lt_or_eq with h | h
    · exact h
    · exfalso
      apply hnot
      have e : m.B + m.lam • m.H = m.B := by rw [← h, zero_smul, add_zero]
      rwa [e] at hnefU
  obtain ⟨l, hl0, hll, hnefl, -, -, R, hR, hR0, hRneg, -⟩ :=
    exists_isExtremalRay_nef_threshold_of_isRealLcPair hproj hZ hπ hQ hK hB0 hH0 hlampos hlcU
      hnefU hnot
  have hHc := isCartierCombination_of_isQFactorial hQ m.H
  obtain ⟨mK, rK, LK, hLK, hKBeq⟩ := isCartierCombination_of_isQFactorial hQ
    (logCanonicalDivisor m.K m.B)
  obtain ⟨W, _, _, _, _, sW, f, h, hfR, hWp, hneg, hpull, hdiv, hsmall⟩ :=
    IsRealDltPair.exists_isRelativeContractionOfFace_of_isExtremalRay hproj hZ hπ hQ hdimM
      ⟨4, hK⟩ hdlt hR ⟨mK, rK, LK, hLK, hKBeq, hRneg mK rK LK hLK hKBeq⟩
  have hKBc : IsCartierCombination (logCanonicalDivisor m.K m.B) := ⟨mK, rK, LK, hLK, hKBeq⟩
  have hKBlc : IsCartierCombination (logCanonicalDivisor m.K (m.B + l • m.H)) := by
    rw [hD']; exact isCartierCombination_add hKBc (isCartierCombination_smul hHc l)
  have htriv : IsNumericallyTrivialOver ℂ m.s f (logCanonicalDivisor m.K (m.B + l • m.H)) :=
    isNumericallyTrivialOver_of_isRelativeContractionOfFace hfR hKBlc
      fun n c M hM heq u hu => hR0 n c M hM heq u hu
  have hfh : f ≫ h = m.π := hfR.comp_eq
  have hcurve := exists_properCurve_isContractedBy_of_isNegativeExtremalContraction hneg
  have hleast : IsLeast {t : ℝ | 0 ≤ t ∧
      IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K (m.B + t • m.H))} l := by
    have := isLeast_of_isNumericallyTrivialOver hfh hcurve hneg.isRelativelyAntiAmple hHc hl0
      (by rw [← hD']; exact htriv) (by rw [← hD']; exact hnefl)
    simpa only [hD'] using this
  have hlcl : IsRealLcPair m.s (m.B + l • m.H) :=
    isRealLcPair_add_smul_of_le hHc hH0 hl0.le hll hdlt.1 hlcU
  -- divisors of degree zero on the contracted curves
  have hnull : ∀ N : RDivisor m.M, IsNumericallyTrivialOver ℂ m.s f N →
      ∀ (Γ : ProperCurve m.s) (hΓ : Γ.IsContractedBy m.π), Γ.relativeClass m.π hΓ ∈ R →
      ∀ (n : ℕ) (r : Fin n → ℝ) (L : Fin n → Divisor m.M) (x : ℝ),
        IsRIntersectionNumber ℂ m.s N r L Γ x → x = 0 := by
    intro N hN Γ hΓ hΓR n r L x hx
    have hΓf : Γ.IsContractedBy f := (hfR.isContractedBy_iff Γ hΓ).mpr hΓR
    obtain ⟨_, r0, L0, y, hy⟩ := exists_isRIntersectionNumber (k := ℂ) hN.1 Γ
    have hl' := IsRIntersectionNumber.eq_and_linear ℂ m.s Γ
    have h00 := hl'.2 _ _ _ _ _ _ _ _ 0 0 hy hy
    simp only [zero_smul, add_zero, zero_mul] at h00
    rw [hN.2.2 Γ hΓf _ _ _ _ _ _ _ _ hx h00]
  have hRl := hnull _ htriv
  have hfs : f ≫ sW = m.s := hneg.isContraction.comp_eq
  have hWn : IsNormalVariety ℂ sW := hneg.isNormalVariety_target
  haveI : IsIntegral W := hWn.1.toIsIntegral
  haveI : IsProper f := hneg.isContraction.isProper
  have hWv : MMP.Mori.IsVariety ℂ sW := hWn.1
  haveI : LocallyOfFiniteType sW := hWv.toLocallyOfFiniteType
  haveI : QuasiCompact sW := hWv.toQuasiCompact
  haveI : IsSeparated sW := hWv.toIsSeparated
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hWn
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hMn
  have hdimW := topologicalKrullDim_eq_of_isNegativeExtremalContraction hproj hQ hfh hneg hnumE
    hE0
  have hbc : IsBirationalContraction ℂ sW m.s f := ⟨hneg.isContraction, hdimW.symm⟩
  have hfb : IsBirationalMorphism f := hbc.surjective_and_isBirational.2
  haveI : IsDominant f := hfb.isDominant
  haveI : Surjective f := hbc.surjective_and_isBirational.1
  have hhs : h ≫ sZ = sW := by
    refine AlgebraicGeometry.ext_of_isDominant f ?_
    rw [← Category.assoc, hfh, hπ, hfs]
  have hmeets := exceptionalSet_inter_supp_roundDown_nonempty hQ hfh hneg hnumE hE0 hEB
  -- `N = K + B - E` is numerically trivial over `Z`
  have hEc := hnumE.2.1
  have hNc : IsCartierCombination (logCanonicalDivisor m.K m.B - m.E) := by
    rw [sub_eq_add_neg, ← neg_one_smul ℝ m.E]
    exact isCartierCombination_add hKBc (isCartierCombination_smul hEc (-1))
  have hNtriv : IsNumericallyTrivialOver ℂ m.s (f ≫ h)
      (logCanonicalDivisor m.K m.B - m.E) := by
    rw [hfh]
    have := numEq_add_smul hnumE (numEq_refl (k := ℂ) (f := m.π) hEc) 1 (-1)
    change IsNumericallyEquivalentOver ℂ m.s m.π _ 0
    simpa [sub_eq_add_neg] using this
  obtain ⟨DN, hDN⟩ := hpull hfb _ hNc (hnull _ (isNumericallyTrivialOver_of_comp' hNtriv))
  have hHtr : ∀ {Y' : Scheme.{0}} (φ : m.M.RationalMap Y'),
      RationalMap.transformDivisor φ (m.B + l • m.H) =
        RationalMap.transformDivisor φ m.B + l • RationalMap.transformDivisor φ m.H :=
    fun φ => transformDivisor_add_smul φ m.B m.H l
  have hNtr : ∀ {Y' : Scheme.{0}} (φ : m.M.RationalMap Y'),
      RationalMap.transformDivisor φ (logCanonicalDivisor m.K m.B - m.E) =
        logCanonicalDivisor (RationalMap.transformDivisor φ m.K)
          (RationalMap.transformDivisor φ m.B) - RationalMap.transformDivisor φ m.E := by
    intro Y' φ
    rw [logCanonicalDivisor, logCanonicalDivisor, map_sub, map_add, transformDivisor_toRDivisor]
  by_cases hsm : IsSmall ℂ sW m.s f
  · -- the flip of the small contraction
    obtain ⟨X', _, _, _, _, sX', fp, hflip, hX'p, hX'Q, hdimX', hdltX', hpull', hlcnef'⟩ :=
      hsmall hsm
    have hX'n : IsNormalVariety ℂ sX' := hX'Q.1
    have hX'v : MMP.Mori.IsVariety ℂ sX' := hX'n.1
    haveI : QuasiCompact sX' := hX'v.toQuasiCompact
    have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hX'n
    have hfps : fp ≫ sW = sX' := hflip.isSmall_flip.comp_eq
    haveI : IsProper fp := hflip.isSmall_flip.isProper
    obtain ⟨ψ, hψover, hψbir, hψcod, hψtr⟩ :=
      exists_rationalMap_of_isSmall hWn hsm hflip.isSmall_flip
    obtain ⟨hlcX', hnefX'⟩ := hlcnef' (m.B + l • m.H) hlcl hnefl hRl
    have hinj := transformPrimeDivisor_injective_of_isSmall hWn hsm hflip.isSmall_flip hψover
      hψcod
    have hHn := mapPrimeDivisors_nonneg hinj hH0
    have hEn := mapPrimeDivisors_nonneg hinj hE0
    have hEB' := one_le_mapPrimeDivisors hinj hEB
    let m' : ScalingStage Z := ⟨X', sX', fp ≫ h, flipTransform f fp m.K,
      flipTransform f fp m.B, flipTransform f fp m.H, flipTransform f fp m.E, l⟩
    -- the transported numerical class
    obtain ⟨DN', hDN'f, hDN'fp⟩ :=
      hpull' _ hNc (hnull _ (isNumericallyTrivialOver_of_comp' hNtriv))
    have hNt' := isNumericallyTrivialOver_of_isRCartierPullback hfs hfps h hDN'f hDN'fp hNtriv
    have htr : ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R m.M),
        flipTransform f fp D = RationalMap.transformDivisor ψ D := fun D => (hψtr D).symm
    rw [htr, hNtr] at hNt'
    have hK' : Divisor.IsCanonicalDivisor sX' 4 (flipTransform f fp m.K) := by
      obtain ⟨mm, hmm⟩ := hflip.isCanonicalDivisor_flip
      have h1 : (mm : WithBot ℕ∞) = 4 := hmm.topologicalKrullDim_eq.symm.trans hdimX'
      have h2 : mm = 4 := by exact_mod_cast h1
      rw [← h2]; exact hmm
    refine ⟨m', ⟨W, sW, f, h, fp, ψ⟩,
      { comp_eq := hfh
        comp_eq_plus := rfl
        isNormalVariety_target := hWn
        comp_eq_s := hfs
        comp_eq_s_plus := hfps
        isProper := inferInstance
        isProper_plus := inferInstance
        isBirationalMorphism := hfb
        isBirationalMorphism_plus := hflip.isBirationalMorphism_flip
        isModificationOf := ⟨hψbir, hψover⟩
        isLeast := hleast
        isNegativeExtremalContraction := hneg
        kind := Or.inr ⟨hflip, hψcod⟩
        meets_floor := hmeets
        eq_K := rfl
        eq_B := rfl
        eq_H := rfl
        transformDivisor_eq := fun D => hψtr D
        desc := hpull' _ hKBlc hRl }, ?_⟩
    exact
      { isProjectiveVariety := hX'p
        isQFactorial := hX'Q
        dim_eq := hdimX'
        isCanonicalDivisor := hK'
        comp_eq := by
          change (fp ≫ h) ≫ sZ = sX'
          rw [Category.assoc, hhs, hfps]
        isRealDltPair := hdltX'
        coeff_H_nonneg := fun P => by
          change 0 ≤ (flipTransform f fp m.H).coeff P
          rw [htr]; exact hHn P
        lam_nonneg := hl0.le
        isRelativelyNef_upper := by
          change IsRelativelyNef ℂ sX' (fp ≫ h) (logCanonicalDivisor (flipTransform f fp m.K)
            (flipTransform f fp m.B + l • flipTransform f fp m.H))
          simp only [htr] at hnefX' ⊢
          rwa [hHtr] at hnefX'
        isRealLcPair_upper := by
          change IsRealLcPair sX' (flipTransform f fp m.B + l • flipTransform f fp m.H)
          simp only [htr] at hlcX' ⊢
          rwa [hHtr] at hlcX'
        numEq := by
          change IsNumericallyEquivalentOver ℂ sX' (fp ≫ h)
            (logCanonicalDivisor (flipTransform f fp m.K) (flipTransform f fp m.B))
            (flipTransform f fp m.E)
          simp only [htr]
          have hE'c := isCartierCombination_of_isQFactorial hX'Q
            (RationalMap.transformDivisor ψ m.E)
          have := numEq_add_right hNt' hE'c
          simpa using this
        coeff_E_nonneg := fun P => by
          change 0 ≤ (flipTransform f fp m.E).coeff P
          rw [htr]; exact hEn P
        one_le_coeff_B := fun P hP => by
          change (flipTransform f fp m.E).coeff P ≠ 0 at hP
          change 1 ≤ (flipTransform f fp m.B).coeff P
          rw [htr] at hP ⊢; exact hEB' P hP }
  · -- the divisorial contraction: the next model is `W`
    haveI : AlgebraicGeometry.IsVariety ℂ sW := hWv
    haveI : AlgebraicGeometry.IsQuasiProjectiveVariety ℂ m.s :=
      (AlgebraicGeometry.isQuasiProjectiveVariety_iff ℂ m.s).mpr ⟨hMv,
        Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective m.s
          hproj.isProjective.isHQuasiProjective⟩
    have hWqp : AlgebraicGeometry.IsQuasiProjectiveVariety ℂ sW :=
      (AlgebraicGeometry.isQuasiProjectiveVariety_iff ℂ sW).mpr ⟨hWv,
        Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective sW
          hWp.isProjective.isHQuasiProjective⟩
    have hfproj : IsProjectiveMorphism f :=
      MMP.isProjectiveMorphism_of_isProper_of_isQuasiProjectiveVariety m.s sW f hfs
    obtain ⟨F, hF⟩ := MMP.Flips.exists_primeDivisor_exceptionalSet_eq_support_of_not_isSmall
      m.s sW hQ hWn f hbc hfproj hneg.relativePicardNumber_eq_one hsm
    have hFm := mori_exceptionalSet_eq_of_exceptionalSet_eq hMv hWv hfs hfb
      hneg.isContraction.isIso_app hF
    obtain ⟨hQW, hdltW, hlcnef⟩ := hdiv ⟨hfb, F, hFm⟩
    obtain ⟨hlcW, hnefW⟩ := hlcnef (m.B + l • m.H) hlcl hnefl hRl
    have htr : ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R m.M),
        flipTransform f (𝟙 W) D = RationalMap.transformDivisor (X := m.M) f.toRationalMap D :=
      fun D => MMP.Fourfold.inverseTransformDivisor_id _
    have hinj : ∀ P P' Q, RationalMap.transformPrimeDivisor (X := m.M) f.toRationalMap P = some Q →
        RationalMap.transformPrimeDivisor (X := m.M) f.toRationalMap P' = some Q → P = P' :=
      fun P P' Q h₁ h₂ => AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (eq_of_map_eq_genericPoint f hfb.functionFieldMap_bijective
          ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P Q).mp h₁)
          ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P' Q).mp h₂))
    have hHn := mapPrimeDivisors_nonneg hinj hH0
    have hEn := mapPrimeDivisors_nonneg hinj hE0
    have hEB' := one_le_mapPrimeDivisors hinj hEB
    let m' : ScalingStage Z := ⟨W, sW, h, flipTransform f (𝟙 W) m.K,
      flipTransform f (𝟙 W) m.B, flipTransform f (𝟙 W) m.H, flipTransform f (𝟙 W) m.E, l⟩
    have hpush : ∀ {D : RDivisor W} {N : RDivisor m.M}, IsRCartierPullback f D N →
        RationalMap.transformDivisor (X := m.M) f.toRationalMap N = D := fun hN =>
      transformDivisor_eq_of_isRCartierPullback' hMn hWn hfs hfb hN
    have hDNid : IsRCartierPullback (𝟙 W) DN (RationalMap.transformDivisor (X := m.M)
        f.toRationalMap (logCanonicalDivisor m.K m.B - m.E)) := by
      rw [hpush hDN]; exact isRCartierPullback_id (isCartierCombination_of_isQFactorial hQW DN)
    have hNt' := isNumericallyTrivialOver_of_isRCartierPullback hfs (Category.id_comp sW) h hDN
      hDNid hNtriv
    rw [Category.id_comp, hNtr] at hNt'
    have hdimW4 : topologicalKrullDim W = 4 := by rw [hdimW, hdimM]
    have hKW : Divisor.IsCanonicalDivisor sW 4
        (RationalMap.transformDivisor (X := m.M) f.toRationalMap m.K) := by
      obtain ⟨KW₀, hKW₀⟩ := MMP.Mori.exists_isCanonicalDivisor sW hWn (n := 4) hdimW4
      have hMn' : IsNormalVariety ℂ (f ≫ sW) := by rw [hfs]; exact hMn
      haveI : LocallyOfFiniteType (f ≫ sW) := by rw [hfs]; infer_instance
      have hK' : m.K.IsCanonicalDivisor (f ≫ sW) 4 := by rw [hfs]; exact hK
      exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hWn hMn' hfb hKW₀ hK'
    refine ⟨m', ⟨W, sW, f, h, 𝟙 W, f.toRationalMap⟩,
      { comp_eq := hfh
        comp_eq_plus := Category.id_comp h
        isNormalVariety_target := hWn
        comp_eq_s := hfs
        comp_eq_s_plus := Category.id_comp sW
        isProper := inferInstance
        isProper_plus := inferInstance
        isBirationalMorphism := hfb
        isBirationalMorphism_plus := MMP.Mori.isBirationalMorphism_of_isIso _
        isModificationOf := ⟨hfb, by
          change f.toPartialMap.toRationalMap.compHom (𝟙 W) = f.toPartialMap.toRationalMap
          rw [← Scheme.RationalMap.compHom_toRationalMap]
          congr 1⟩
        isLeast := hleast
        isNegativeExtremalContraction := hneg
        kind := Or.inl ⟨hWqp, hfproj, ⟨F, hFm⟩, inferInstance⟩
        meets_floor := hmeets
        eq_K := rfl
        eq_B := rfl
        eq_H := rfl
        transformDivisor_eq := fun D => (htr D).symm
        desc := by
          obtain ⟨M, hM⟩ := hpull hfb _ hKBlc hRl
          refine ⟨M, hM, ?_⟩
          rw [htr, hpush hM]
          exact isRCartierPullback_id (isCartierCombination_of_isQFactorial hQW M) }, ?_⟩
    exact
      { isProjectiveVariety := hWp
        isQFactorial := hQW
        dim_eq := hdimW4
        isCanonicalDivisor := by
          change Divisor.IsCanonicalDivisor sW 4 (flipTransform f (𝟙 W) m.K)
          rw [htr]; exact hKW
        comp_eq := hhs
        isRealDltPair := by
          change IsRealDltPair sW (flipTransform f (𝟙 W) m.B)
          rw [htr]; exact hdltW
        coeff_H_nonneg := fun P => by
          change 0 ≤ (flipTransform f (𝟙 W) m.H).coeff P
          rw [htr]; exact hHn P
        lam_nonneg := hl0.le
        isRelativelyNef_upper := by
          change IsRelativelyNef ℂ sW h (logCanonicalDivisor (flipTransform f (𝟙 W) m.K)
            (flipTransform f (𝟙 W) m.B + l • flipTransform f (𝟙 W) m.H))
          rw [htr, htr, htr, ← hHtr]; exact hnefW
        isRealLcPair_upper := by
          change IsRealLcPair sW (flipTransform f (𝟙 W) m.B + l • flipTransform f (𝟙 W) m.H)
          rw [htr, htr, ← hHtr]; exact hlcW
        numEq := by
          change IsNumericallyEquivalentOver ℂ sW h
            (logCanonicalDivisor (flipTransform f (𝟙 W) m.K) (flipTransform f (𝟙 W) m.B))
            (flipTransform f (𝟙 W) m.E)
          rw [htr, htr, htr]
          have hE'c := isCartierCombination_of_isQFactorial hQW
            (RationalMap.transformDivisor (X := m.M) f.toRationalMap m.E)
          have := numEq_add_right hNt' hE'c
          simpa using this
        coeff_E_nonneg := fun P => by
          change 0 ≤ (flipTransform f (𝟙 W) m.E).coeff P
          rw [htr]; exact hEn P
        one_le_coeff_B := fun P hP => by
          change (flipTransform f (𝟙 W) m.E).coeff P ≠ 0 at hP
          change 1 ≤ (flipTransform f (𝟙 W) m.B).coeff P
          rw [htr] at hP ⊢; exact hEB' P hP }

/-- The trivial step from a model to itself. -/
private noncomputable def ScalingStep.refl (m : ScalingStage Z) : ScalingStep m m :=
  ⟨m.M, m.s, 𝟙 m.M, m.π, 𝟙 m.M, Scheme.Hom.toRationalMap (𝟙 m.M)⟩

open Classical in
/-- The next model of the program: a step when the model is good and its adjoint not nef, and
the model itself otherwise. -/
private noncomputable def ScalingStage.next (sZ : Z ⟶ Spec (.of ℂ))
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (m : ScalingStage Z) :
    Σ m' : ScalingStage Z, ScalingStep m m' :=
  if h : m.IsGood sZ ∧ ¬ IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B) then
    ⟨(ScalingStage.exists_scalingStep hZ h.1 h.2).choose,
      (ScalingStage.exists_scalingStep hZ h.1 h.2).choose_spec.choose⟩
  else ⟨m, ScalingStep.refl m⟩

/-- The models of the program. -/
private noncomputable def ScalingStage.seq (sZ : Z ⟶ Spec (.of ℂ))
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (m₀ : ScalingStage Z) : ℕ → ScalingStage Z
  | 0 => m₀
  | n + 1 => (ScalingStage.next sZ hZ (ScalingStage.seq sZ hZ m₀ n)).1

/-- The steps of the program. -/
private noncomputable def ScalingStage.step (sZ : Z ⟶ Spec (.of ℂ))
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (m₀ : ScalingStage Z) (n : ℕ) :
    ScalingStep (ScalingStage.seq sZ hZ m₀ n) (ScalingStage.seq sZ hZ m₀ (n + 1)) :=
  (ScalingStage.next sZ hZ (ScalingStage.seq sZ hZ m₀ n)).2

/-- The next model of a good model is good, and is reached by a step when the adjoint is not
nef. -/
private theorem ScalingStage.next_spec {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m : ScalingStage Z} (hm : m.IsGood sZ) :
    (ScalingStage.next sZ hZ m).1.IsGood sZ ∧
      (¬ IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B) →
        (ScalingStage.next sZ hZ m).2.IsStep) := by
  by_cases hn : IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B)
  · have h : ¬ (m.IsGood sZ ∧ ¬ IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B)) :=
      fun h => h.2 hn
    rw [ScalingStage.next, dif_neg h]
    exact ⟨hm, fun h' => absurd hn h'⟩
  · rw [ScalingStage.next, dif_pos ⟨hm, hn⟩]
    obtain ⟨h1, h2⟩ := (ScalingStage.exists_scalingStep hZ hm hn).choose_spec.choose_spec
    exact ⟨h2, fun _ => h1⟩

/-- Every model of the program is good. -/
private theorem ScalingStage.isGood_seq {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m₀ : ScalingStage Z} (hm₀ : m₀.IsGood sZ) (n : ℕ) :
    (ScalingStage.seq sZ hZ m₀ n).IsGood sZ := by
  induction n with
  | zero => exact hm₀
  | succ n ih => exact (ScalingStage.next_spec hZ ih).1

/-- Every model of the program whose adjoint is not nef is followed by a step. -/
private theorem ScalingStage.isStep_step {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m₀ : ScalingStage Z} (hm₀ : m₀.IsGood sZ) (n : ℕ)
    (hn : ¬ IsRelativelyNef ℂ (ScalingStage.seq sZ hZ m₀ n).s (ScalingStage.seq sZ hZ m₀ n).π
      (logCanonicalDivisor (ScalingStage.seq sZ hZ m₀ n).K (ScalingStage.seq sZ hZ m₀ n).B)) :
    (ScalingStage.step sZ hZ m₀ n).IsStep :=
  (ScalingStage.next_spec hZ (ScalingStage.isGood_seq hZ hm₀ n)).2 hn

/-- The contractions of the program, indexed by the models `modelSeq` of the program. -/
private noncomputable def ScalingStage.contraction (sZ : Z ⟶ Spec (.of ℂ))
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (m₀ : ScalingStage Z) :
    ∀ i, modelSeq m₀.M (fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).M) i ⟶
      (ScalingStage.step sZ hZ m₀ i).W
  | 0 => (ScalingStage.step sZ hZ m₀ 0).f
  | i + 1 => (ScalingStage.step sZ hZ m₀ (i + 1)).f

/-- A step of the program is a step of a real flip sequence or a divisorial contraction, in the
form of the special termination theorem. -/
private theorem ScalingStep.IsStep.flip_or_divisorial {sZ : Z ⟶ Spec (.of ℂ)}
    {m m' : ScalingStage Z} {st : ScalingStep m m'} (h : st.IsStep) (hm' : m'.IsGood sZ) :
    IsRealFlipStep m.s st.sW m'.s m.K m.B m'.K m'.B st.f st.fp ∨
      (AlgebraicGeometry.IsQuasiProjectiveVariety ℂ st.sW ∧
        IsNegativeExtremalContraction ℂ m.s st.sW (logCanonicalDivisor m.K m.B) st.f ∧
        IsBirationalMorphism st.f ∧ IsProjectiveMorphism st.f ∧
        (∃ E : MMP.Mori.PrimeDivisor m.M, MMP.Flips.exceptionalSet st.f = E.support) ∧
        IsIso st.fp ∧ (∃ n : ℕ, m'.K.IsCanonicalDivisor m'.s n) ∧
        m'.B = flipTransform st.f st.fp m.B) := by
  rcases h.kind with ⟨hq, hp, ⟨E, hE⟩, hiso⟩ | ⟨hflip, -⟩
  · refine Or.inr ⟨hq, h.isNegativeExtremalContraction, h.isBirationalMorphism, hp, ⟨E, ?_⟩,
      hiso, ⟨4, hm'.isCanonicalDivisor⟩, h.eq_B⟩
    have hW := h.isNormalVariety_target
    haveI : IsIntegral st.W := hW.1.toIsIntegral
    haveI := h.isProper
    exact exceptionalSet_eq_of_mori_exceptionalSet_eq h.isBirationalMorphism hE
  · exact Or.inl hflip

/-- **The program terminates.** Some model of the program has adjoint nef over `Z`: otherwise
every step meets `⌊B⌋`, and the special termination theorem makes the program finite. -/
private theorem ScalingStage.exists_isRelativelyNef_seq {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m₀ : ScalingStage Z} (hm₀ : m₀.IsGood sZ)
    (hlam : m₀.lam = 1) (hdlt : IsRealDltPair m₀.s (m₀.B + m₀.H))
    {A : QDivisor m₀.M} (hA0 : ∀ P, 0 ≤ A.coeff P) (hA : A.IsAmple)
    (hAB : ∀ P, (A.coeff P : ℝ) ≤ m₀.B.coeff P)
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (m₀.B + m₀.H).coeff P < 1) :
    ∃ n, IsRelativelyNef ℂ (ScalingStage.seq sZ hZ m₀ n).s (ScalingStage.seq sZ hZ m₀ n).π
      (logCanonicalDivisor (ScalingStage.seq sZ hZ m₀ n).K (ScalingStage.seq sZ hZ m₀ n).B) := by
  by_contra hno
  push_neg at hno
  have hgood := ScalingStage.isGood_seq hZ hm₀
  have hst : ∀ i, (ScalingStage.step sZ hZ m₀ i).IsStep := fun i =>
    ScalingStage.isStep_step hZ hm₀ i (hno i)
  have hnef1 : IsRelativelyNef ℂ m₀.s m₀.π (logCanonicalDivisor m₀.K (m₀.B + m₀.H)) := by
    have := hm₀.isRelativelyNef_upper
    rwa [hlam, one_smul] at this
  have key := IsRealDltPair.eventually_disjoint_exceptionalSet_supp_roundDown_of_scaling
    (n := ⊤) (Y := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).M)
    (sY := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).s)
    (πY := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).π)
    (KY := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).K)
    (BY := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).B)
    (CY := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).H)
    (W := fun i => (ScalingStage.step sZ hZ m₀ i).W)
    (sW := fun i => (ScalingStage.step sZ hZ m₀ i).sW)
    (f := ScalingStage.contraction sZ hZ m₀)
    (fp := fun i => (ScalingStage.step sZ hZ m₀ i).fp)
    (g := fun i => (ScalingStage.step sZ hZ m₀ i).g)
    (lam := fun i => (ScalingStage.seq sZ hZ m₀ (i + 1)).lam)
    hm₀.isProjectiveVariety hZ hm₀.comp_eq hm₀.isQFactorial hm₀.isCanonicalDivisor
    hm₀.isRealDltPair.1.2.1 hm₀.coeff_H_nonneg hdlt hnef1 hA0 hA hAB hAfloor
    (fun i => (hgood (i + 1)).comp_eq)
    (fun i _ => by rcases i with _ | i; exacts [(hst 0).comp_eq, (hst (i + 1)).comp_eq])
    (fun i _ => (hst i).comp_eq_plus)
    (fun i _ => by
      rcases i with _ | i; exacts [(hgood 0).isQFactorial, (hgood (i + 1)).isQFactorial])
    (fun i _ => by
      rcases i with _ | i
      exacts [(hst 0).flip_or_divisorial (hgood 1),
        (hst (i + 1)).flip_or_divisorial (hgood (i + 2))])
    (fun i _ => by rcases i with _ | i; exacts [(hst 0).eq_H, (hst (i + 1)).eq_H])
    (fun i _ => by rcases i with _ | i; exacts [(hst 0).isLeast, (hst (i + 1)).isLeast])
    (fun i _ => by rcases i with _ | i; exacts [(hst 0).desc, (hst (i + 1)).desc])
  exact key.2 (fun i _ _ => by
    rcases i with _ | i; exacts [(hst 0).meets_floor, (hst (i + 1)).meets_floor]) rfl

/-- **The base-case program ends in a log minimal model.** Run from a smooth model, the program
reaches a model with nef adjoint, which is a log minimal model. -/
private theorem ScalingStage.exists_isRealLogMinimalModel {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m₀ : ScalingStage Z} (hm₀ : m₀.IsGood sZ)
    (hsm : IsSmoothScheme m₀.s) (hlam : m₀.lam = 1) (hdlt : IsRealDltPair m₀.s (m₀.B + m₀.H))
    {A : QDivisor m₀.M} (hA0 : ∀ P, 0 ≤ A.coeff P) (hA : A.IsAmple)
    (hAB : ∀ P, (A.coeff P : ℝ) ≤ m₀.B.coeff P)
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (m₀.B + m₀.H).coeff P < 1) :
    ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : CompactSpace Y) (_ : IsLocallyNoetherian Y)
      (_ : IsNormal Y) (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY : RDivisor Y)
      (φ : m₀.M.RationalMap Y),
      IsRealLogMinimalModel m₀.s sY sZ m₀.π πY m₀.K m₀.B KY BY φ := by
  classical
  have hex := ScalingStage.exists_isRelativelyNef_seq hZ hm₀ hlam hdlt hA0 hA hAB hAfloor
  set j := Nat.find hex with hjdef
  have hgood := ScalingStage.isGood_seq hZ hm₀
  have hst : ∀ i < j, (ScalingStage.step sZ hZ m₀ i).IsStep := fun i hi =>
    ScalingStage.isStep_step hZ hm₀ i (Nat.find_min hex hi)
  have hXv : MMP.Mori.IsVariety ℂ (ScalingStage.seq sZ hZ m₀ 0).s := (hgood 0).isProjectiveVariety.toIsVariety
  haveI : LocallyOfFiniteType (ScalingStage.seq sZ hZ m₀ 0).s := hXv.toLocallyOfFiniteType
  have hXn : IsNormalVariety ℂ (ScalingStage.seq sZ hZ m₀ 0).s := ⟨hXv, inferInstance⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hqc : ∀ i, QuasiCompact (ScalingStage.seq sZ hZ m₀ i).s := fun i =>
    (hgood i).isProjectiveVariety.toIsVariety.toQuasiCompact
  have hid : Scheme.Hom.toRationalMap (𝟙 (ScalingStage.seq sZ hZ m₀ 0).M) = Scheme.RationalMap.id (ScalingStage.seq sZ hZ m₀ 0).M := by
    rw [← Scheme.RationalMap.id_compHom, Scheme.RationalMap.id,
      ← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.compHom_id]
  have hrefl : (Scheme.PartialIso.refl (ScalingStage.seq sZ hZ m₀ 0).M).toRationalMap = Scheme.RationalMap.id (ScalingStage.seq sZ hZ m₀ 0).M := by
    rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
    exact ⟨⊤, dense_univ, le_rfl, le_rfl, by
      simp [Scheme.PartialMap.restrict, Scheme.PartialMap.id]; rfl⟩
  have hcomp : (Scheme.Hom.toRationalMap (𝟙 (ScalingStage.seq sZ hZ m₀ 0).M)).compHom (𝟙 (ScalingStage.seq sZ hZ m₀ 0).M) =
      Scheme.RationalMap.id (ScalingStage.seq sZ hZ m₀ 0).M := by
    rw [hid, Scheme.RationalMap.id_compHom]
  obtain ⟨χ, KY, hLMM⟩ := exists_isRealLogMinimalModel_of_program (X := (ScalingStage.seq sZ hZ m₀ 0).M) (sX := (ScalingStage.seq sZ hZ m₀ 0).s)
    (π := (ScalingStage.seq sZ hZ m₀ 0).π) (KX := (ScalingStage.seq sZ hZ m₀ 0).K) (Δ := (ScalingStage.seq sZ hZ m₀ 0).B)
    (Ys := fun i => (ScalingStage.seq sZ hZ m₀ i).M)
    (sYs := fun i => (ScalingStage.seq sZ hZ m₀ i).s)
    (πYs := fun i => (ScalingStage.seq sZ hZ m₀ i).π)
    (Ks := fun i => (ScalingStage.seq sZ hZ m₀ i).K)
    (Γs := fun i => (ScalingStage.seq sZ hZ m₀ i).B)
    (W := fun i => (ScalingStage.step sZ hZ m₀ i).W)
    (sW := fun i => (ScalingStage.step sZ hZ m₀ i).sW)
    (f := fun i => (ScalingStage.step sZ hZ m₀ i).f)
    (g := fun i => (ScalingStage.step sZ hZ m₀ i).g)
    (fp := fun i => (ScalingStage.step sZ hZ m₀ i).fp)
    (ψ := fun i => (ScalingStage.step sZ hZ m₀ i).ψ)
    (hgood 0).isProjectiveVariety (hgood 0).isQFactorial hZ (hgood 0).comp_eq
    ⟨4, (hgood 0).isCanonicalDivisor⟩ (hgood 0).isRealDltPair.1 j
    (fun i _ => ⟨(hgood i).isProjectiveVariety, (hgood i).isQFactorial,
      ⟨4, (hgood i).isCanonicalDivisor⟩, (hgood i).comp_eq⟩)
    (fun i hi => (hst i hi).isNormalVariety_target)
    (fun i hi => (hst i hi).comp_eq_s) (fun i hi => (hst i hi).comp_eq_s_plus)
    (fun i hi => (hst i hi).comp_eq) (fun i hi => (hst i hi).comp_eq_plus)
    (fun i hi => (hst i hi).isProper) (fun i hi => (hst i hi).isProper_plus)
    (fun i hi => (hst i hi).isBirationalMorphism)
    (fun i hi => (hst i hi).isBirationalMorphism_plus)
    (fun i hi => (hst i hi).isModificationOf)
    (fun i hi => by
      change (ScalingStage.seq sZ hZ m₀ (i + 1)).B = _
      rw [(hst i hi).eq_B, (hst i hi).transformDivisor_eq])
    (fun i hi => by
      haveI := hqc i
      exact isRelativelyNef_of_isRelativelyAmple'
        (hst i hi).isNegativeExtremalContraction.isRelativelyAntiAmple)
    (fun i hi => by
      rcases (hst i hi).kind with ⟨-, -, hE, hiso⟩ | ⟨hflip, hcod⟩
      · exact Or.inl ⟨(hst i hi).isNegativeExtremalContraction.isContraction, hE, hiso,
          (hst i hi).isNegativeExtremalContraction.isRelativelyAntiAmple⟩
      · haveI := hqc (i + 1)
        exact Or.inr ⟨hflip.isSmall, hflip.isSmall_flip, hcod,
          isRelativelyNef_of_isRelativelyAmple' hflip.isRelativelyAmple_flip⟩)
    (W₀ := (ScalingStage.seq sZ hZ m₀ 0).M) (p₀ := 𝟙 (ScalingStage.seq sZ hZ m₀ 0).M) (q₀ := 𝟙 (ScalingStage.seq sZ hZ m₀ 0).M) (h₀ := Scheme.Hom.toRationalMap (𝟙 (ScalingStage.seq sZ hZ m₀ 0).M))
    (by rw [Category.id_comp]; exact hXv) (by rw [Category.id_comp]; exact hsm) rfl
    (MMP.isProjectiveMorphism_of_isClosedImmersion _)
    (MMP.isProjectiveMorphism_of_isClosedImmersion _)
    (MMP.Mori.isBirationalMorphism_of_isIso _) (MMP.Mori.isBirationalMorphism_of_isIso _)
    ⟨Scheme.PartialIso.refl (ScalingStage.seq sZ hZ m₀ 0).M, by rw [hrefl, hid], by
      change (Scheme.PartialIso.refl (ScalingStage.seq sZ hZ m₀ 0).M).toRationalMap = _
      rw [hrefl, hid]⟩ rfl
    (fun F => by
      change (ScalingStage.seq sZ hZ m₀ 0).B.coeff F = _
      rw [hcomp, transformDivisor_id,
        if_neg fun h => h F (by rw [← hcomp]; exact hcomp ▸ transformPrimeDivisor_id F),
        add_zero])
    (fun P hP => absurd hP (by
      rw [hcomp]
      exact not_isExceptional_of_transformPrimeDivisor_eq_some (transformPrimeDivisor_id P)))
    (hgood j).isRealDltPair (Nat.find_spec hex)
  exact ⟨_, inferInstance, inferInstance, inferInstance, inferInstance, _, _, KY, _, χ, hLMM⟩

end ScalingProgram

section Skeleton

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X} {A : QDivisor X}

/-- The conclusion: `(X/Z, B)` has a log minimal model. -/
private def HasModel (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z) (KX : Divisor X)
    (B : RDivisor X) : Prop :=
  ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : CompactSpace Y) (_ : IsLocallyNoetherian Y)
      (_ : IsNormal Y) (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY : RDivisor Y)
      (φ : X.RationalMap Y),
      IsRealLogMinimalModel sX sY sZ π πY KX B KY BY φ

/-- The number `θ(B, M)` of components of `M` outside `⌊B⌋`. -/
private noncomputable def theta (B M : RDivisor X) : ℕ :=
  (M.support.filter fun P => B.coeff P < 1).card

/-- A real snc boundary on a smooth projective fourfold is log canonical. -/
private theorem isRealLcPair_of_isSNC {D : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hD : ∀ P, 0 ≤ D.coeff P) (hD1 : ∀ P, D.coeff P ≤ 1)
    (hsnc : DivisorWithCoeffs.IsSNC sX D) : IsRealLcPair sX D := by
  classical
  obtain ⟨m, hm⟩ := hKX
  have hm4 : (m : WithBot ℕ∞) = 4 := hm.topologicalKrullDim_eq.symm.trans hdim
  have hm4' : m = 4 := by exact_mod_cast hm4
  subst hm4'
  refine isRealLcPair_of_isSNC' ⟨hX.toIsVariety, inferInstance⟩ hXsm (by norm_num) hm D.support
    le_rfl (hsnc.of_support_subset fun E hE => ?_) hD hD1
  rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply] at hE
  by_contra h
  refine hE (Finset.sum_eq_zero fun F hF => ?_)
  rw [Finsupp.single_apply, if_neg]
  rintro rfl
  exact h hF

/-- If `K_X + B` is already nef over `Z`, then `X` itself is a log minimal model. -/
private theorem hasModel_of_isRelativelyNef {B : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1)
    (hsnc : DivisorWithCoeffs.IsSNC sX B)
    (hnef : IsRelativelyNef ℂ sX π (logCanonicalDivisor KX B)) :
    HasModel sX sZ π KX B := by
  classical
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hlc := isRealLcPair_of_isSNC hX hXsm hdim hKX hB hB1 hsnc
  obtain ⟨m, hm⟩ := hKX
  have hid : Scheme.Hom.toRationalMap (𝟙 X) = Scheme.RationalMap.id X := by
    rw [← Scheme.RationalMap.id_compHom, Scheme.RationalMap.id,
      ← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.compHom_id]
  have hrefl : (Scheme.PartialIso.refl X).toRationalMap = Scheme.RationalMap.id X := by
    rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
    exact ⟨⊤, dense_univ, le_rfl, le_rfl, by
      simp [Scheme.PartialMap.restrict, Scheme.PartialMap.id]; rfl⟩
  obtain ⟨G, hG, -⟩ := MMP.Flips.existsUnique_isRCartierPullback (𝟙 X)
    (isCartierCombination_of_isSmoothScheme hXsm (logCanonicalDivisor KX B))
  have hres : IsLogComparisonResolution sX sX sX (Scheme.Hom.toRationalMap (𝟙 X)) KX B KX B
      (𝟙 X) (𝟙 X) (Scheme.Hom.toRationalMap (𝟙 X)) G G :=
    { isVariety := hX.toIsVariety
      isSmoothScheme := hXsm
      comp_eq_left := Category.id_comp _
      comp_eq_right := Category.id_comp _
      isProjectiveMorphism_left := MMP.isProjectiveMorphism_of_isClosedImmersion _
      isProjectiveMorphism_right := MMP.isProjectiveMorphism_of_isClosedImmersion _
      isBirationalMorphism_left := MMP.Mori.isBirationalMorphism_of_isIso _
      isBirationalMorphism_right := MMP.Mori.isBirationalMorphism_of_isIso _
      isInverse := ⟨Scheme.PartialIso.refl X, by rw [hrefl, hid], by
        change (Scheme.PartialIso.refl X).toRationalMap = _
        rw [hrefl, hid]⟩
      compHom_eq := by rw [hid, Scheme.RationalMap.id_compHom]
      exists_canonicalDivisor := ⟨m, KX, hm, transformDivisor_id _, transformDivisor_id _⟩
      isRCartierPullback_left := hG
      isRCartierPullback_right := hG
      effective := fun P => by simp
      isExceptional := fun P hP => absurd (by simp) hP }
  refine ⟨X, inferInstance, inferInstance, inferInstance, inferInstance, sX, π, KX, B,
    Scheme.Hom.toRationalMap (𝟙 X),
    { isRealLcPair := hlc
      isCanonicalDivisor := ⟨m, hm⟩
      comp_eq := hπ
      isNormalVariety_model := hXn
      isCanonicalDivisor_model := ⟨m, hm⟩
      isProjectiveVariety_model := hX
      comp_eq_model := hπ
      isQFactorial := ⟨hXn, fun D => ⟨1, one_pos, by
        simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
      isRealDltPair := isRealDltPair_of_isSNC hlc hB1 hXsm hsnc
      isBirational := hid ▸ RationalMap.isBirational_id
      isOver := by
        change (Scheme.Hom.toRationalMap (𝟙 X)).compHom π = π.toRationalMap
        rw [hid, Scheme.RationalMap.id_compHom]
      coeff_boundary := fun F => by
        rw [transformDivisor_id, if_neg fun h => h F (transformPrimeDivisor_id F), add_zero]
      isRelativelyNef := hnef
      exists_resolution := ⟨X, inferInstance, inferInstance, inferInstance, sX, 𝟙 X, 𝟙 X,
        Scheme.Hom.toRationalMap (𝟙 X), G, G, hres⟩
      exists_resolution_pos := ⟨X, inferInstance, inferInstance, inferInstance, sX, 𝟙 X, 𝟙 X,
        Scheme.Hom.toRationalMap (𝟙 X), G, G, hres, fun P hP => absurd hP
          (not_isExceptional_of_transformPrimeDivisor_eq_some (transformPrimeDivisor_id P))⟩ }⟩

/-- **A general ample scaling divisor.** On a smooth projective fourfold with snc divisor `B + M`
and an ample `ℚ`-divisor `A`, there is an effective real divisor `H` with coefficients at most
one and no component in `Supp (B + M)`, with `B + M + H` snc and `K_X + B + H` nef over `Z`: a
general member of a large multiple of a very ample class dominating the Cartier terms of
`K_X + B`, divided by that multiple. -/
private theorem exists_scalingDivisor {B M : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    (hB : ∀ P, 0 ≤ B.coeff P) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M)) (hA : A.IsAmple) :
    ∃ H : RDivisor X, (∀ P, 0 ≤ H.coeff P) ∧ (∀ P, H.coeff P ≤ 1) ∧
      (∀ P, H.coeff P ≠ 0 → B.coeff P = 0 ∧ M.coeff P = 0) ∧
      DivisorWithCoeffs.IsSNC sX (B + M + H) ∧
      IsRelativelyNef ℂ sX π (logCanonicalDivisor KX (B + H)) := by
  classical
  have hXv : MMP.Mori.IsVariety ℂ sX := hX.toIsVariety
  haveI : QuasiCompact sX := hXv.toQuasiCompact
  have hZv : MMP.Mori.IsVariety ℂ sZ := hZ.toIsVariety
  haveI : QuasiSeparated sZ := by haveI := hZv.toIsSeparated; infer_instance
  haveI : QuasiCompact (π ≫ sZ) := by rw [hπ]; infer_instance
  haveI : QuasiCompact π := QuasiCompact.of_comp π sZ
  have hQ : IsQFactorial sX := ⟨⟨hXv, inferInstance⟩, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
  obtain ⟨c, hc0, hnefc⟩ := exists_isRelativelyNef_add_smul_of_isAmple (g := π) hX hQ KX hB hA
  set k : ℕ := ⌈c⌉₊ + 1 with hk
  have hkpos : (0 : ℝ) < k := by positivity
  have hck : c / k ≤ 1 := by
    rw [div_le_one hkpos, hk]
    push_cast
    linarith [Nat.le_ceil c]
  have hck0 : 0 ≤ c / k := div_nonneg hc0 hkpos.le
  have hBM0 : ∀ P, 0 ≤ (B + M).coeff P := fun P => by
    rw [DivisorWithCoeffs.coeff_add]; exact add_nonneg (hB P) (hM P)
  obtain ⟨S, hS01, hSR, hSl, n, r, φ, hSeq⟩ :=
    exists_sum_isLogResolution_id hXv hBM0 (isLogResolution_id_of_isSNC hXsm hsnc) hA k
  have hsncS := isSNC_of_isLogResolution_id hsnc hSl
  refine ⟨(c / k) • S, fun P => ?_, fun P => ?_, fun P hP => ?_, ?_, ?_⟩
  · rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact mul_nonneg hck0 (hS01 P).1
  · rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    calc c / k * S.coeff P ≤ 1 * 1 := mul_le_mul hck (hS01 P).2 (hS01 P).1 zero_le_one
      _ = 1 := one_mul 1
  · rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at hP
    have h := hSR P (right_ne_zero_of_mul hP)
    rw [DivisorWithCoeffs.coeff_add] at h
    have := hB P
    have := hM P
    constructor <;> linarith
  · refine hsncS.of_support_subset fun P hP => ?_
    rw [Finsupp.mem_support_iff] at hP ⊢
    change (B + M + (c / k) • S).coeff P ≠ 0 at hP
    change (B + M + S).coeff P ≠ 0
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at hP
    rw [DivisorWithCoeffs.coeff_add]
    intro h0
    have h1 := hBM0 P
    have h2 := (hS01 P).1
    have h3 : (B + M).coeff P = 0 := by linarith
    have h4 : S.coeff P = 0 := by linarith
    rw [h3, h4, mul_zero, add_zero] at hP
    exact hP rfl
  · have hkne : (k : ℝ) ≠ 0 := hkpos.ne'
    have h := isRelativelyNef_add_sum_smul_principalDivisor hnefc (fun j => c / k * r j) φ
    have heq : logCanonicalDivisor KX (B + (c / k) • S) = logCanonicalDivisor KX B +
        c • QDivisor.toRDivisor A +
          ∑ j, (c / k * r j) • Divisor.toRDivisor (principalDivisor (φ j)) := by
      rw [hSeq, logCanonicalDivisor, logCanonicalDivisor, smul_add, smul_smul,
        div_mul_cancel₀ _ hkne, Finset.smul_sum]
      simp_rw [smul_smul]
      abel
    rw [heq]
    exact h

/-- The base case `θ = 0`: every component of `M` lies in `⌊B⌋`. -/
private theorem hasModel_of_theta_eq_zero {B M : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1) (hM : ∀ P, 0 ≤ M.coeff P)
    (hsnc : DivisorWithCoeffs.IsSNC sX (B + M))
    (hKBM : IsNumericallyEquivalentOver ℂ sX π (logCanonicalDivisor KX B) M)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hAM : ∀ P, A.coeff P ≠ 0 → M.coeff P = 0)
    (hθ : ∀ P, M.coeff P ≠ 0 → B.coeff P = 1) :
    HasModel sX sZ π KX B := by
  classical
  obtain ⟨H, hH0, hH1, hHBM, hsncH, hnefH⟩ :=
    exists_scalingDivisor (KX := KX) hX hXsm hZ hπ hB hM hsnc hA
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  have hKX' := hKX
  obtain ⟨m, hm⟩ := hKX
  have hm4 : (m : WithBot ℕ∞) = 4 := hm.topologicalKrullDim_eq.symm.trans hdim
  have hm4' : m = 4 := by exact_mod_cast hm4
  subst hm4'
  have hsub : (B + H).support ⊆ (B + M + H).support := fun P hP => by
    rw [Finsupp.mem_support_iff] at hP ⊢
    change B.coeff P + M.coeff P + H.coeff P ≠ 0
    change B.coeff P + H.coeff P ≠ 0 at hP
    have := hB P; have := hM P; have := hH0 P
    intro h
    exact hP (by linarith)
  have hsncBH : DivisorWithCoeffs.IsSNC sX (B + H) := hsncH.of_support_subset hsub
  have hsncB : DivisorWithCoeffs.IsSNC sX B := hsncBH.of_support_subset fun P hP => by
    rw [Finsupp.mem_support_iff] at hP ⊢
    change B.coeff P + H.coeff P ≠ 0
    change B.coeff P ≠ 0 at hP
    have := hB P; have := hH0 P
    intro h
    exact hP (by linarith)
  have hBH1 : ∀ P, (B + H).coeff P ≤ 1 := fun P => by
    change B.coeff P + H.coeff P ≤ 1
    by_cases hP : H.coeff P = 0
    · rw [hP, add_zero]; exact hB1 P
    · rw [(hHBM P hP).1, zero_add]; exact hH1 P
  have hBH0 : ∀ P, 0 ≤ (B + H).coeff P := fun P => add_nonneg (hB P) (hH0 P)
  have hlcB := isRealLcPair_of_isSNC hX hXsm hdim hKX' hB hB1 hsncB
  have hlcBH := isRealLcPair_of_isSNC hX hXsm hdim hKX' hBH0 hBH1 hsncBH
  let m₀ : ScalingStage Z := ⟨X, sX, π, KX, B, H, M, 1⟩
  have hm₀ : m₀.IsGood sZ :=
    { isProjectiveVariety := hX
      isQFactorial := ⟨hXn, fun D => ⟨1, one_pos, by
        simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
      dim_eq := hdim
      isCanonicalDivisor := hm
      comp_eq := hπ
      isRealDltPair := isRealDltPair_of_isSNC hlcB hB1 hXsm hsncB
      coeff_H_nonneg := hH0
      lam_nonneg := zero_le_one
      isRelativelyNef_upper := by
        change IsRelativelyNef ℂ sX π (logCanonicalDivisor KX (B + (1 : ℝ) • H))
        rw [one_smul]; exact hnefH
      isRealLcPair_upper := by
        change IsRealLcPair sX (B + (1 : ℝ) • H)
        rw [one_smul]; exact hlcBH
      numEq := hKBM
      coeff_E_nonneg := hM
      one_le_coeff_B := fun P hP => (hθ P hP).ge }
  obtain ⟨Y, _, _, _, _, sY, πY, KY, BY, φ, hY⟩ :=
    ScalingStage.exists_isRealLogMinimalModel (m₀ := m₀) hZ hm₀ hXsm rfl
      (isRealDltPair_of_isSNC hlcBH hBH1 hXsm hsncBH) (A := A) hA0 hA
      (fun P => by
        have := hAB P
        rwa [QDivisor.coeff_toRDivisor] at this)
      (fun P hP => by
        change B.coeff P + H.coeff P < 1
        have hA' : 0 < A.coeff P := lt_of_le_of_ne (hA0 P) (Ne.symm hP)
        have hBpos : 0 < B.coeff P := by
          have := hAB P
          rw [QDivisor.coeff_toRDivisor] at this
          have : (0 : ℝ) < A.coeff P := by exact_mod_cast hA'
          linarith
        have hH : H.coeff P = 0 := by
          by_contra hne
          exact hBpos.ne' (hHBM P hne).1
        rw [hH, add_zero]
        exact hAfl P hP)
  exact ⟨Y, inferInstance, inferInstance, inferInstance, inferInstance, sY, πY, KY, BY, φ, hY⟩

/-- The data of a floor identity `α (K_X + B) ≡_Z C + N` on the snc fourfold `X`, with `B + C`
an lc snc boundary and the ample component `A` of `B` outside `⌊B + C⌋`. -/
private structure IsFloorDatum (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z)
    (KX : Divisor X) (A : QDivisor X) (B C N : RDivisor X) (α : ℝ) : Prop where
  hX : MMP.Mori.IsProjectiveVariety ℂ sX
  hXsm : IsSmoothScheme sX
  hdim : topologicalKrullDim X = 4
  hZ : MMP.Mori.IsProjectiveVariety ℂ sZ
  hπ : π ≫ sZ = sX
  hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m
  hB : ∀ P, 0 ≤ B.coeff P
  hC : ∀ P, 0 ≤ C.coeff P
  hBC1 : ∀ P, (B + C).coeff P ≤ 1
  hlc : IsRealLcPair sX (B + C)
  hsnc : DivisorWithCoeffs.IsSNC sX (B + C)
  hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0
  hA : A.IsAmple
  hA0 : ∀ P, 0 ≤ A.coeff P
  hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P
  hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1
  hα : 0 < α
  hN : ∀ P, 0 ≤ N.coeff P
  hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P
  hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N)

/-- **Left openness.** If `(X/Z, B + t C)` has a log minimal model for some `0 < t ≤ 1`, then so
has `(X/Z, B + u C)` for every `u < t` close enough to `t`. -/
private theorem exists_pos_hasModel_of_hasModel {B C N : RDivisor X} {α : ℝ}
    (hD : IsFloorDatum sX sZ π KX A B C N α) {t : ℝ} (ht0 : 0 < t) (ht1 : t ≤ 1)
    (hm : HasModel sX sZ π KX (B + t • C)) :
    ∃ ε > 0, ∀ u, t - ε < u → u < t → HasModel sX sZ π KX (B + u • C) := by
  classical
  obtain ⟨Y, _, _, _, _, sY, πY, KY, BYt, φ, hY⟩ := hm
  set CY : RDivisor Y := RationalMap.transformDivisor φ C with hCY
  set BY : RDivisor Y := BYt - t • CY with hBYdef
  have hBYt : BY + t • CY = BYt := by rw [hBYdef, sub_add_cancel]
  have hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0 := by
    intro F
    have h := hY.coeff_boundary F
    have htr : RationalMap.transformDivisor φ (B + t • C) =
        RationalMap.transformDivisor φ B + t • CY := by
      rw [map_add, hCY]
      congr 1
      exact DivisorWithCoeffs.mapPrimeDivisors_smul _ t C
    rw [htr] at h
    change BYt.coeff F - (t • CY).coeff F = _
    rw [h]
    change (RationalMap.transformDivisor φ B).coeff F + (t • CY).coeff F + _ - (t • CY).coeff F = _
    ring
  rw [← hBYt] at hY
  obtain ⟨n, Ms, _, _, _, _, sM, πM, KM, BM, CM, lam, Wt, sWt, f, g, fp, ψ, hmodels, hsteps,
      hlamn, hnefn, hlevels⟩ :=
    MMP.Fourfold.IsRealLogMinimalModel.exists_finite_scalingProgram_of_isSNC hD.hX hD.hXsm
      hD.hdim hD.hZ hD.hB hD.hC hD.hlc hD.hsnc hD.hCB hD.hA hD.hA0 hD.hAB hD.hAfl hD.hα hD.hN
      hD.hNB hD.hfloor ht0 ht1 hCY hBY hY
  -- the source
  have hXn : IsNormalVariety ℂ sX := ⟨hD.hX.toIsVariety, inferInstance⟩
  haveI := hXn.1
  have hXQ : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hD.hXsm D⟩⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hD.hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  -- the model at level `t` and its resolution
  have hYn : IsNormalVariety ℂ sY := hY.isNormalVariety_model
  have hYQ : IsQFactorial sY := hY.isQFactorial
  haveI := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  obtain ⟨W₀, _, _, _, sW₀, p₀, q₀, h₀, GX, GY, hres, hpos⟩ := hY.exists_resolution_pos
  have hp₀b := hres.isBirationalMorphism_left
  have hq₀b := hres.isBirationalMorphism_right
  haveI : IsProper p₀ := isProper_of_isProjectiveMorphism p₀ hres.isProjectiveMorphism_left
  haveI : IsProper q₀ := isProper_of_isProjectiveMorphism q₀ hres.isProjectiveMorphism_right
  haveI : IsDominant p₀ := hp₀b.isDominant
  haveI : IsDominant q₀ := hq₀b.isDominant
  have hW₀n : IsNormalVariety ℂ sW₀ := ⟨hres.isVariety, inferInstance⟩
  haveI : QuasiCompact sW₀ := hres.isVariety.toQuasiCompact
  haveI : CompactSpace W₀ := QuasiCompact.compactSpace_of_compactSpace sW₀
  haveI : MMP.Mori.IsVariety ℂ (q₀ ≫ sY) := by rw [hres.comp_eq_right]; exact hres.isVariety
  have hW₀np : IsNormalVariety ℂ (p₀ ≫ sX) := by rw [hres.comp_eq_left]; exact hW₀n
  have hW₀nq : IsNormalVariety ℂ (q₀ ≫ sY) := by rw [hres.comp_eq_right]; exact hW₀n
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hW₀n
  haveI : IsSeparated p₀ := IsSeparated.of_comp p₀ (X ↘ ⊤_ Scheme)
  haveI : LocallyOfFiniteType sW₀ := hres.isVariety.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q₀ ≫ sY) := by rw [hres.comp_eq_right]; infer_instance
  have hpq₀ : p₀ ≫ π = q₀ ≫ πY :=
    MMP.Fourfold.comp_eq_comp_of_isOver π πY hY.isOver p₀ q₀ h₀ hres.isInverse hres.compHom_eq
  -- the pull-back of `C_Y`, compatible forms and strict transforms
  obtain ⟨CW, hCW, -⟩ := MMP.Flips.existsUnique_isRCartierPullback q₀
    (isCartierCombination_of_isQFactorial hYQ CY)
  obtain ⟨mW, KW, hKW, hpK, hqK⟩ := hres.exists_canonicalDivisor
  obtain ⟨mY, hKY⟩ := hY.isCanonicalDivisor_model
  have hKWq : KW.IsCanonicalDivisor (q₀ ≫ sY) mW := by rw [hres.comp_eq_right]; exact hKW
  have hmm : mY = mW := by
    have h1 := hKY.topologicalKrullDim_eq
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q₀ ≫ sY) hq₀b,
      hKWq.topologicalKrullDim_eq] at h1
    exact_mod_cast h1.symm
  subst hmm
  obtain ⟨ωY, hωY0, hωY, hωYW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hW₀nq hq₀b hKY hKWq hqK
  choose PWf hPWf using fun P : MMP.Mori.PrimeDivisor X =>
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hW₀np hp₀b P
  have hPWinj : Function.Injective PWf := fun P P' h =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((hPWf P).1.symm.trans (h ▸ (hPWf P').1))
  have hPWtr : ∀ P, RationalMap.transformPrimeDivisor h₀ P = some (PWf P) := fun P =>
    transformPrimeDivisor_eq_some_of_isInverse hp₀b.functionFieldMap_bijective hres.isInverse
      (hPWf P).1
  -- the primes contracted by `φ` and their margins
  set S : Set (MMP.Mori.PrimeDivisor X) := {P | RationalMap.IsExceptional φ P} with hSdef
  have hδ : ∀ P ∈ S, 0 < (GX - GY).coeff (PWf P) := fun P hP => hpos P hP (PWf P) (hPWtr P)
  have hSfin : S.Finite := by
    refine (((GX - GY).support.finite_toSet).preimage hPWinj.injOn).subset fun P hP => ?_
    exact Finsupp.mem_support_iff.mpr (hδ P hP).ne'
  set σ : MMP.Mori.PrimeDivisor X → ℝ := fun P => CW.coeff (PWf P) - C.coeff P with hσdef
  obtain ⟨ε₁, hε₁, hε₁S⟩ := exists_pos_forall_le_of_finite hSfin
    (fun P => (GX - GY).coeff (PWf P) / (|σ P| + 1))
    (fun P hP => div_pos (hδ P hP) (by positivity))
  -- the thresholds below `t`
  have hΛfin : {i : ℕ | i < n ∧ lam i < t}.Finite :=
    (Set.finite_lt_nat n).subset fun i hi => hi.1
  obtain ⟨ε₂, hε₂, hε₂Λ⟩ := exists_pos_forall_le_of_finite hΛfin (fun i => t - lam i)
    (fun i hi => sub_pos.mpr hi.2)
  refine ⟨min (min ε₁ ε₂) t, lt_min (lt_min hε₁ hε₂) ht0, fun u hu1 hu2 => ?_⟩
  have hεt := min_le_right (min ε₁ ε₂) t
  have hε1 := (min_le_left (min ε₁ ε₂) t).trans (min_le_left ε₁ ε₂)
  have hε2 := (min_le_left (min ε₁ ε₂) t).trans (min_le_right ε₁ ε₂)
  have hu0 : 0 < u := by linarith
  have hlamne : ∀ i < n, u ≠ lam i := by
    intro i hi heq
    by_cases hlt : lam i < t
    · have := hε₂Λ i ⟨hi, hlt⟩
      linarith
    · push_neg at hlt
      linarith
  obtain ⟨j, hjn, hdltj, hnefj, hnegj⟩ := hlevels u ⟨hu0.le, hu2.le⟩
  -- the steps
  have hfb : ∀ i < n, IsBirationalMorphism (f i) := by
    intro i hi
    obtain ⟨-, -, -, -, -, hk, -, -⟩ := hsteps i hi
    rcases hk with ⟨h, -, -, -⟩ | hflip
    · exact h
    · exact hflip.isSmall_source.surjective_and_isBirational.2
  have hgs : ∀ i < n, g i ≫ sZ = sWt i := by
    intro i hi
    obtain ⟨hfg, -, -, hext, -⟩ := hsteps i hi
    have hWv := hext.isNormalVariety_target
    haveI : IsIntegral (Wt i) := hWv.1.toIsIntegral
    haveI : IsReduced (Wt i) := inferInstance
    haveI : IsDominant (f i) := (hfb i hi).isDominant
    refine ext_of_isDominant (ι := f i) ?_
    rw [← Category.assoc, hfg, (hmodels i hi.le).2.2.2.1, hext.isContraction.comp_eq]
  have hlcu : IsRealLcPair sX (B + u • C) := by
    refine isRealLcPair_of_isSNC hD.hX hD.hXsm hD.hdim hD.hKX (fun P => ?_) (fun P => ?_)
      (hD.hsnc.of_support_subset fun E hE => ?_)
    · have := hD.hB P; have := hD.hC P
      change 0 ≤ B.coeff P + u * C.coeff P
      positivity
    · have h1 := hD.hBC1 P; have := hD.hC P
      change B.coeff P + C.coeff P ≤ 1 at h1
      change B.coeff P + u * C.coeff P ≤ 1
      nlinarith
    · rw [Finsupp.mem_support_iff] at hE ⊢
      intro h0
      have hB0 := hD.hB E; have hC0 := hD.hC E
      change B.coeff E + C.coeff E = 0 at h0
      apply hE
      change B.coeff E + u * C.coeff E = 0
      have hb : B.coeff E = 0 := by linarith
      have hc : C.coeff E = 0 := by linarith
      rw [hb, hc]; ring
  have hsm : ∀ (i : ℕ) (c : ℝ) (D : RDivisor (modelSeq Y Ms i)),
      RationalMap.transformDivisor (ψ i) (c • D) = c • RationalMap.transformDivisor (ψ i) D :=
    fun i c D => DivisorWithCoeffs.mapPrimeDivisors_smul _ c D
  obtain ⟨χ, KYj, hLMM⟩ := exists_isRealLogMinimalModel_of_program (Δ := B + u • C)
    (Ys := modelSeq Y Ms) (sYs := modelStr sY sM) (πYs := modelMap πY πM)
    (Ks := divisorSeq KY KM) (Γs := fun i => divisorSeq BY BM i + u • divisorSeq CY CM i)
    (W := Wt) (sW := sWt) (f := f) (g := g) (fp := fp) (ψ := ψ)
    hD.hX hXQ hD.hZ hD.hπ hD.hKX hlcu j
    (fun i hi => by
      obtain ⟨h1, h2, h3, h4, -⟩ := hmodels i (hi.trans hjn)
      exact ⟨h1, h2, h3, h4⟩)
    (fun i hi => (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isNormalVariety_target)
    (fun i hi => (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isContraction.comp_eq)
    (fun i hi => by
      have hin := lt_of_lt_of_le hi hjn
      rw [← hgs i hin]
      erw [← Category.assoc, (hsteps i hin).2.1, (hmodels (i + 1) hin).2.2.2.1])
    (fun i hi => (hsteps i (lt_of_lt_of_le hi hjn)).1)
    (fun i hi => (hsteps i (lt_of_lt_of_le hi hjn)).2.1)
    (fun i hi => (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isContraction.isProper)
    (fun i hi => by
      rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, hiso, -⟩ | hflip
      · haveI := hiso
        show IsProper (fp i : Ms i ⟶ Wt i)
        infer_instance
      · exact hflip.isProper)
    (fun i hi => hfb i (lt_of_lt_of_le hi hjn))
    (fun i hi => by
      rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, hiso, -⟩ | hflip
      · haveI := hiso; exact MMP.Mori.isBirationalMorphism_of_isIso (fp i : Ms i ⟶ Wt i)
      · exact hflip.isSmall.surjective_and_isBirational.2)
    (fun i hi => by
      rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, -, hm⟩ | hflip
      · exact hm
      · exact hflip.isModificationOf)
    (fun i hi => by
      obtain ⟨-, -, -, -, -, -, hBM, hCM⟩ := hsteps i (lt_of_lt_of_le hi hjn)
      change BM i + u • CM i = _
      rw [hBM, hCM, map_add]
      congr 1
      exact (DivisorWithCoeffs.mapPrimeDivisors_smul _ u _).symm)
    (fun i hi => by
      rcases hnegj i hi with hamp | htr
      · exact isRelativelyNef_of_isRelativelyAmple' hamp
      · refine isRelativelyNef_of_isNumericallyTrivialOver ?_
        have := numEq_smul htr (-1)
        simp only [neg_smul, one_smul, smul_zero] at this
        exact this)
    (fun i hi => by
      have hin := lt_of_lt_of_le hi hjn
      obtain ⟨-, hfpg, -, hext, htriv, hk, hBM, hCM⟩ := hsteps i hin
      obtain ⟨hYp, hYq, ⟨mi, hKi⟩, -, -, hlam0, -, -⟩ := hmodels i hin.le
      have hD' : ∀ s : ℝ, logCanonicalDivisor (divisorSeq KY KM i)
          (divisorSeq BY BM i + s • divisorSeq CY CM i) =
          logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i) +
            s • divisorSeq CY CM i := fun s => by
        rw [logCanonicalDivisor, logCanonicalDivisor, add_assoc]
      have hCc := isCartierCombination_of_isQFactorial hYq (divisorSeq CY CM i)
      haveI : QuasiCompact (modelStr sY sM i) := hYp.toIsVariety.toQuasiCompact
      rcases hk with ⟨hb, ⟨E, hE⟩, hiso, hmodif⟩ | hflip
      · refine Or.inl ⟨hext.isContraction, ⟨E, hE⟩, hiso, ?_⟩
        haveI : IsProper (modelStr sY sM i) :=
          isProper_of_isProjectiveMorphism _ hYp.isProjective
        have hWv := hext.isNormalVariety_target
        haveI : IsIntegral (Wt i) := hWv.1.toIsIntegral
        haveI : IsNormal (Wt i) := hWv.2
        haveI : IsProper (f i) := hext.isContraction.isProper
        have hcurve := exists_properCurve_isContractedBy_of_exceptionalSet_eq
          (sY := modelStr sY sM i) hb hE
        rcases hnegj i hi with hamp | htr
        · exact hamp
        · exfalso
          rw [hD'] at htr htriv
          have := (le_of_isRelativelyAntiAmple_or_isNumericallyTrivialOver hcurve
            hext.isRelativelyAntiAmple hCc hlam0 htriv (Or.inr htr)).2 htr
          exact hlamne i hin this
      · refine Or.inr ⟨hflip.isSmall_source, hflip.isSmall, hflip.isMorphismInCodimOne, ?_⟩
        obtain ⟨hYp', hYq', ⟨mi', hKi'⟩, -⟩ := hmodels (i + 1) hin
        change IsRelativelyNef ℂ (sM i) (fp i)
          (logCanonicalDivisor (KM i) (BM i + u • CM i))
        rcases Nat.lt_or_ge (i + 1) j with hlt | hge
        · -- below the threshold of the step
          have hcurve := exists_properCurve_isContractedBy_of_isNegativeExtremalContraction hext
          have hule : u ≤ lam i := by
            have hu := hnegj i hi
            rw [hD'] at hu
            rw [hD'] at htriv
            exact (le_of_isRelativelyAntiAmple_or_isNumericallyTrivialOver hcurve
              hext.isRelativelyAntiAmple hCc hlam0 htriv hu).1
          rw [hBM, hCM]
          exact isRelativelyNef_of_isFlip_of_le hflip hYq hYq' hKi hKi' hu0.le hule htriv
        · have hj : i + 1 = j := le_antisymm hi hge
          subst hj
          have h' : IsRelativelyNef ℂ (sM i) (fp i ≫ g i)
              (logCanonicalDivisor (KM i) (BM i + u • CM i)) := by
            rw [hfpg]; exact hnefj
          exact isRelativelyNef_of_comp' h')
    (by rw [hres.comp_eq_left]; exact hres.isVariety)
    (by rw [hres.comp_eq_left]; exact hres.isSmoothScheme)
    (hres.comp_eq_right.trans hres.comp_eq_left.symm) hres.isProjectiveMorphism_left
    hres.isProjectiveMorphism_right hp₀b hq₀b hres.isInverse hpq₀
    (fun F => by
      change (BY + u • CY).coeff F =
        (RationalMap.transformDivisor (h₀.compHom q₀) (B + u • C)).coeff F +
          if MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F then 1 else 0
      rw [hres.compHom_eq, map_add,
        show RationalMap.transformDivisor φ (u • C) = u • CY from
          DivisorWithCoeffs.mapPrimeDivisors_smul _ u C]
      change BY.coeff F + u * CY.coeff F =
        (RationalMap.transformDivisor φ B).coeff F + u * CY.coeff F + _
      rw [hBY F]
      ring)
    (fun P hP PW hPW hn n a ha => by
      replace hP : RationalMap.IsExceptional φ P := by
        rw [← hres.compHom_eq]; exact hP
      have hPWeq : PW = PWf P := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (eq_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective hPW (hPWf P).1)
      subst hPWeq
      have hδP := hδ P hP
      have hεP := hε₁S P hP
      have hGu : IsRCartierPullback q₀ (logCanonicalDivisor (divisorOfForm ωY) (BY + u • CY))
          (GY + (-(t - u)) • CW) := by
        rw [hωY]
        have h1 := MMP.Fourfold.isRCartierPullback_add hres.isRCartierPullback_right
          (MMP.Fourfold.isRCartierPullback_smul (-(t - u)) hCW)
        convert h1 using 1
        rw [logCanonicalDivisor, logCanonicalDivisor]
        module
      have ha₁ := isLogDiscrepancy_of_isRCartierPullback hYn hW₀nq hq₀b hωY0
        (by rw [hωY]; exact hKY) hGu (PWf P)
      have hau := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha₁
      haveI := isIso_stalkMap_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective
        (hPWf P).1
      have hGX := coeff_eq_of_isRCartierPullback hres.isRCartierPullback_left (PWf P) P
        (hPWf P).1
      have hKWP : (KW.coeff (PWf P) : ℝ) = KX.coeff P := by
        have := (hPWf P).2.2 KW
        rw [hpK] at this
        exact_mod_cast this.symm
      have hord : (((⟨W₀, q₀, hW₀nq, hq₀b, PWf P⟩ : DivisorOver ℂ sY).ordPullback ωY : ℤ) : ℝ) =
          KW.coeff (PWf P) := by
        rw [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωYW]
      rw [hau, hord, hKWP]
      have hGXc : GX.coeff (PWf P) = KX.coeff P + B.coeff P + t * C.coeff P := by
        rw [hGX]
        change (KX.coeff P : ℝ) + (B.coeff P + t * C.coeff P) = _
        ring
      have hδ' : 0 < GX.coeff (PWf P) - GY.coeff (PWf P) := hδP
      have hε' : ε₁ ≤ (GX.coeff (PWf P) - GY.coeff (PWf P)) / (|σ P| + 1) := hεP
      have hd : ε₁ * (|σ P| + 1) ≤ GX.coeff (PWf P) - GY.coeff (PWf P) :=
        (le_div_iff₀ (by positivity)).mp hε'
      have htu : 0 < t - u := by linarith
      have htu' : t - u < ε₁ := by linarith
      have hab : -|σ P| ≤ σ P := neg_abs_le _
      have key : 0 < (GX.coeff (PWf P) - GY.coeff (PWf P)) + (t - u) * σ P := by
        nlinarith [abs_nonneg (σ P)]
      change 1 - (B.coeff P + u * C.coeff P) <
        1 + (KX.coeff P : ℝ) - (GY.coeff (PWf P) + (-(t - u)) * CW.coeff (PWf P))
      simp only [hσdef] at key
      rw [hGXc] at key
      linarith)
    hdltj hnefj
  exact ⟨modelSeq Y Ms j, inferInstance, inferInstance, inferInstance, inferInstance,
    modelStr sY sM j, modelMap πY πM j, KYj, _, χ, hLMM⟩

open Classical in
/-- **A lowered model.** A nef dlt model `(Y, Γ)` over `Z` of `(X/Z, B + τ C)`, with
`Γ = χ_*(B + τ C) + ∑ F` for `χ = q ∘ p⁻¹`, given on a smooth projective common resolution
`p : V ⟶ X`, `q : V ⟶ Y`, along whose contracted primes `D` the log discrepancy over `(Y, Γ)` is
at least `a(D; X, B + t C) = 1 - mult_D (B + t C)`, and contracting only primes of `S`. -/
private structure LoweredModel (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z)
    (B C : RDivisor X) (τ t : ℝ) (S : Finset (MMP.Mori.PrimeDivisor X)) where
  /-- The model. -/
  Y : Scheme.{0}
  [isIntegral : IsIntegral Y]
  [compactSpace : CompactSpace Y]
  [isLocallyNoetherian : IsLocallyNoetherian Y]
  [isNormal : IsNormal Y]
  /-- The structure morphism of the model. -/
  sY : Y ⟶ Spec (.of ℂ)
  /-- The model over the base. -/
  πY : Y ⟶ Z
  /-- A canonical divisor of the model. -/
  KY : Divisor Y
  /-- The boundary of the model. -/
  Γ : RDivisor Y
  /-- The common resolution. -/
  V : Scheme.{0}
  [isIntegralV : IsIntegral V]
  [isLocallyNoetherianV : IsLocallyNoetherian V]
  [isNormalV : IsNormal V]
  /-- The resolution of the source. -/
  p : V ⟶ X
  /-- The resolution of the model. -/
  q : V ⟶ Y
  /-- The inverse of `p`. -/
  h : X.RationalMap V
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ sY
  isQFactorial : IsQFactorial sY
  isCanonicalDivisor : ∃ m : ℕ, KY.IsCanonicalDivisor sY m
  comp_eq : πY ≫ sZ = sY
  isRealDltPair : IsRealDltPair sY Γ
  isRelativelyNef : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY Γ)
  isVariety : MMP.Mori.IsVariety ℂ (p ≫ sX)
  isSmoothScheme : IsSmoothScheme (p ≫ sX)
  comp_eq_res : q ≫ sY = p ≫ sX
  isProjectiveMorphism_left : IsProjectiveMorphism p
  isProjectiveMorphism_right : IsProjectiveMorphism q
  isBirationalMorphism_left : IsBirationalMorphism p
  isBirationalMorphism_right : IsBirationalMorphism q
  isInverse : RationalMap.IsInverse p.toRationalMap h
  comp_eq_base : p ≫ π = q ≫ πY
  coeff_boundary : ∀ F, Γ.coeff F =
    (RationalMap.transformDivisor (h.compHom q) (B + τ • C)).coeff F +
      if MMP.Flips.RationalMap.IsInverseExceptional (h.compHom q) F then 1 else 0
  le_logDiscrepancy : ∀ P, RationalMap.IsExceptional (h.compHom q) P →
    ∀ PV : MMP.Mori.PrimeDivisor V, p PV.genericPoint = P.genericPoint →
    ∀ (hn : IsNormalVariety ℂ (q ≫ sY)) (n : ℕ) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sY n Γ ⟨V, q, hn, isBirationalMorphism_right, PV⟩ a →
        1 - (B + t • C).coeff P ≤ a
  mem_of_isExceptional : ∀ P, RationalMap.IsExceptional (h.compHom q) P → P ∈ S

attribute [local instance] LoweredModel.isIntegral LoweredModel.compactSpace
  LoweredModel.isLocallyNoetherian LoweredModel.isNormal LoweredModel.isIntegralV
  LoweredModel.isLocallyNoetherianV LoweredModel.isNormalV

/-- **Lowering a log minimal model to a lower level.** If `(X/Z, B + t C)` has a log minimal
model for `0 < t ≤ 1`, then for every `0 ≤ τ < t` the finite floor program run from it yields a
lowered model of `(X/Z, B + τ C)` improving on the level `t`, contracting only components of
`B + C + N`. -/
private theorem exists_loweredModel {B C N : RDivisor X} {α : ℝ}
    (hD : IsFloorDatum sX sZ π KX A B C N α) {τ t : ℝ} (hτ0 : 0 ≤ τ) (hτt : τ < t) (ht1 : t ≤ 1)
    (hm : HasModel sX sZ π KX (B + t • C)) :
    Nonempty (LoweredModel sX sZ π B C τ t (B + C + N).support) := by
  have ht0 : 0 < t := lt_of_le_of_lt hτ0 hτt
  classical
  obtain ⟨Y, _, _, _, _, sY, πY, KY, BYt, φ, hY⟩ := hm
  set CY : RDivisor Y := RationalMap.transformDivisor φ C with hCY
  set BY : RDivisor Y := BYt - t • CY with hBYdef
  have hBYt : BY + t • CY = BYt := by rw [hBYdef, sub_add_cancel]
  have hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0 := by
    intro F
    have h := hY.coeff_boundary F
    have htr : RationalMap.transformDivisor φ (B + t • C) =
        RationalMap.transformDivisor φ B + t • CY := by
      rw [map_add, hCY]
      congr 1
      exact DivisorWithCoeffs.mapPrimeDivisors_smul _ t C
    rw [htr] at h
    change BYt.coeff F - (t • CY).coeff F = _
    rw [h]
    change (RationalMap.transformDivisor φ B).coeff F + (t • CY).coeff F + _ - (t • CY).coeff F = _
    ring
  rw [← hBYt] at hY
  obtain ⟨n, Ms, _, _, _, _, sM, πM, KM, BM, CM, lam, Wt, sWt, f, g, fp, ψ, hmodels, hsteps,
      hlamn, hnefn, hlevels⟩ :=
    MMP.Fourfold.IsRealLogMinimalModel.exists_finite_scalingProgram_of_isSNC hD.hX hD.hXsm
      hD.hdim hD.hZ hD.hB hD.hC hD.hlc hD.hsnc hD.hCB hD.hA hD.hA0 hD.hAB hD.hAfl hD.hα hD.hN
      hD.hNB hD.hfloor ht0 ht1 hCY hBY hY
  -- the source
  have hXn : IsNormalVariety ℂ sX := ⟨hD.hX.toIsVariety, inferInstance⟩
  haveI := hXn.1
  have hXQ : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hD.hXsm D⟩⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hD.hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  -- the model at level `t` and its resolution
  have hYn : IsNormalVariety ℂ sY := hY.isNormalVariety_model
  have hYQ : IsQFactorial sY := hY.isQFactorial
  haveI := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  obtain ⟨W₀, _, _, _, sW₀, p₀, q₀, h₀, GX, GY, hres, hpos⟩ := hY.exists_resolution_pos
  have hp₀b := hres.isBirationalMorphism_left
  have hq₀b := hres.isBirationalMorphism_right
  haveI : IsProper p₀ := isProper_of_isProjectiveMorphism p₀ hres.isProjectiveMorphism_left
  haveI : IsProper q₀ := isProper_of_isProjectiveMorphism q₀ hres.isProjectiveMorphism_right
  haveI : IsDominant p₀ := hp₀b.isDominant
  haveI : IsDominant q₀ := hq₀b.isDominant
  have hW₀n : IsNormalVariety ℂ sW₀ := ⟨hres.isVariety, inferInstance⟩
  haveI : QuasiCompact sW₀ := hres.isVariety.toQuasiCompact
  haveI : CompactSpace W₀ := QuasiCompact.compactSpace_of_compactSpace sW₀
  haveI : MMP.Mori.IsVariety ℂ (q₀ ≫ sY) := by rw [hres.comp_eq_right]; exact hres.isVariety
  have hW₀np : IsNormalVariety ℂ (p₀ ≫ sX) := by rw [hres.comp_eq_left]; exact hW₀n
  have hW₀nq : IsNormalVariety ℂ (q₀ ≫ sY) := by rw [hres.comp_eq_right]; exact hW₀n
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hW₀n
  haveI : IsSeparated p₀ := IsSeparated.of_comp p₀ (X ↘ ⊤_ Scheme)
  haveI : LocallyOfFiniteType sW₀ := hres.isVariety.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q₀ ≫ sY) := by rw [hres.comp_eq_right]; infer_instance
  have hpq₀ : p₀ ≫ π = q₀ ≫ πY :=
    MMP.Fourfold.comp_eq_comp_of_isOver π πY hY.isOver p₀ q₀ h₀ hres.isInverse hres.compHom_eq
  -- the pull-back of `C_Y`, compatible forms and strict transforms
  obtain ⟨CW, hCW, -⟩ := MMP.Flips.existsUnique_isRCartierPullback q₀
    (isCartierCombination_of_isQFactorial hYQ CY)
  obtain ⟨mW, KW, hKW, hpK, hqK⟩ := hres.exists_canonicalDivisor
  obtain ⟨mY, hKY⟩ := hY.isCanonicalDivisor_model
  have hKWq : KW.IsCanonicalDivisor (q₀ ≫ sY) mW := by rw [hres.comp_eq_right]; exact hKW
  have hmm : mY = mW := by
    have h1 := hKY.topologicalKrullDim_eq
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q₀ ≫ sY) hq₀b,
      hKWq.topologicalKrullDim_eq] at h1
    exact_mod_cast h1.symm
  subst hmm
  obtain ⟨ωY, hωY0, hωY, hωYW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hW₀nq hq₀b hKY hKWq hqK
  choose PWf hPWf using fun P : MMP.Mori.PrimeDivisor X =>
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hW₀np hp₀b P
  have hPWinj : Function.Injective PWf := fun P P' h =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((hPWf P).1.symm.trans (h ▸ (hPWf P').1))
  have hPWtr : ∀ P, RationalMap.transformPrimeDivisor h₀ P = some (PWf P) := fun P =>
    transformPrimeDivisor_eq_some_of_isInverse hp₀b.functionFieldMap_bijective hres.isInverse
      (hPWf P).1
  obtain ⟨j, hjn, hdltj, hnefj, hnegj⟩ := hlevels τ ⟨hτ0, hτt.le⟩
  -- the steps
  have hfb : ∀ i < n, IsBirationalMorphism (f i) := by
    intro i hi
    obtain ⟨-, -, -, -, -, hk, -, -⟩ := hsteps i hi
    rcases hk with ⟨h, -, -, -⟩ | hflip
    · exact h
    · exact hflip.isSmall_source.surjective_and_isBirational.2
  have hgs : ∀ i < n, g i ≫ sZ = sWt i := by
    intro i hi
    obtain ⟨hfg, -, -, hext, -⟩ := hsteps i hi
    have hWv := hext.isNormalVariety_target
    haveI : IsIntegral (Wt i) := hWv.1.toIsIntegral
    haveI : IsReduced (Wt i) := inferInstance
    haveI : IsDominant (f i) := (hfb i hi).isDominant
    refine ext_of_isDominant (ι := f i) ?_
    rw [← Category.assoc, hfg, (hmodels i hi.le).2.2.2.1, hext.isContraction.comp_eq]
  have hlcτ : IsRealLcPair sX (B + τ • C) := by
    refine isRealLcPair_of_isSNC hD.hX hD.hXsm hD.hdim hD.hKX (fun P => ?_) (fun P => ?_)
      (hD.hsnc.of_support_subset fun E hE => ?_)
    · have := hD.hB P; have := hD.hC P
      change 0 ≤ B.coeff P + τ * C.coeff P
      positivity
    · have h1 := hD.hBC1 P; have := hD.hC P
      change B.coeff P + C.coeff P ≤ 1 at h1
      change B.coeff P + τ * C.coeff P ≤ 1
      nlinarith
    · rw [Finsupp.mem_support_iff] at hE ⊢
      intro h0
      have hB0 := hD.hB E; have hC0 := hD.hC E
      change B.coeff E + C.coeff E = 0 at h0
      apply hE
      change B.coeff E + τ * C.coeff E = 0
      have hb : B.coeff E = 0 := by linarith
      have hc : C.coeff E = 0 := by linarith
      rw [hb, hc]; ring
  -- the hypotheses on the program up to `j`
  have hmodj : ∀ i ≤ j, MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sM i) ∧
      IsQFactorial (modelStr sY sM i) ∧
      (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sM i) m (divisorSeq KY KM i)) ∧
      modelMap πY πM i ≫ sZ = modelStr sY sM i := fun i hi => by
    obtain ⟨h1, h2, h3, h4, -⟩ := hmodels i (hi.trans hjn)
    exact ⟨h1, h2, h3, h4⟩
  have hWj : ∀ i < j, IsNormalVariety ℂ (sWt i) := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isNormalVariety_target
  have hfsj : ∀ i < j, f i ≫ sWt i = modelStr sY sM i := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isContraction.comp_eq
  have hfpsj : ∀ i < j, fp i ≫ sWt i = modelStr sY sM (i + 1) := fun i hi => by
    have hin := lt_of_lt_of_le hi hjn
    rw [← hgs i hin]
    erw [← Category.assoc, (hsteps i hin).2.1, (hmodels (i + 1) hin).2.2.2.1]
  have hfgj : ∀ i < j, f i ≫ g i = modelMap πY πM i := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).1
  have hfpgj : ∀ i < j, fp i ≫ g i = modelMap πY πM (i + 1) := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.1
  have hfPj : ∀ i < j, IsProper (f i) := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.1.isContraction.isProper
  have hfpPj : ∀ i < j, IsProper (fp i) := fun i hi => by
    rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, hiso, -⟩ | hflip
    · haveI := hiso
      show IsProper (fp i : Ms i ⟶ Wt i)
      infer_instance
    · exact hflip.isProper
  have hfbj : ∀ i < j, IsBirationalMorphism (f i) := fun i hi => hfb i (lt_of_lt_of_le hi hjn)
  have hfpbj : ∀ i < j, IsBirationalMorphism (fp i) := fun i hi => by
    rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, hiso, -⟩ | hflip
    · haveI := hiso; exact MMP.Mori.isBirationalMorphism_of_isIso (fp i : Ms i ⟶ Wt i)
    · exact hflip.isSmall.surjective_and_isBirational.2
  have hmodifj : ∀ i < j, IsModificationOf (f i) (fp i) (ψ i) := fun i hi => by
    rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, -, hm⟩ | hflip
    · exact hm
    · exact hflip.isModificationOf
  have hkindj : ∀ i < j, IsIso (fp i) ∨ (IsSmall ℂ (sWt i) (modelStr sY sM i) (f i) ∧
      IsSmall ℂ (sWt i) (modelStr sY sM (i + 1)) (fp i) ∧
      MMP.Flips.RationalMap.IsMorphismInCodimOne (ψ i)) := fun i hi => by
    rcases (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.1 with ⟨-, -, hiso, -⟩ | hflip
    · exact Or.inl hiso
    · exact Or.inr ⟨hflip.isSmall_source, hflip.isSmall, hflip.isMorphismInCodimOne⟩
  have hBj : ∀ i < j, divisorSeq BY BM (i + 1) =
      RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.2.1
  have hCj : ∀ i < j, divisorSeq CY CM (i + 1) =
      RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i) := fun i hi =>
    (hsteps i (lt_of_lt_of_le hi hjn)).2.2.2.2.2.2.2
  -- the comparison along the program at level `τ`
  obtain ⟨V, _, _, _, b, q, h, hbv, hbsm, hbp, hbb, hqp, hqb, hqs, hpqZ, hinv, hΔ, hcmp,
      hcontr⟩ := exists_comparison_of_program (Δ := B + τ • C)
    (Ys := modelSeq Y Ms) (sYs := modelStr sY sM) (πYs := modelMap πY πM)
    (Ks := divisorSeq KY KM) (Γs := fun i => divisorSeq BY BM i + τ • divisorSeq CY CM i)
    (W := Wt) (sW := sWt) (f := f) (g := g) (fp := fp) (ψ := ψ)
    hD.hX hXQ hD.hZ hD.hπ hD.hKX hlcτ j hmodj hWj hfsj hfpsj hfgj hfpgj hfPj hfpPj hfbj hfpbj
    hmodifj
    (fun i hi => by
      change BM i + τ • CM i = _
      rw [show BM i = RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) from hBj i hi,
        show CM i = RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i) from hCj i hi,
        map_add]
      congr 1
      exact (DivisorWithCoeffs.mapPrimeDivisors_smul _ τ _).symm)
    (fun i hi => by
      rcases hnegj i hi with hamp | htr
      · exact isRelativelyNef_of_isRelativelyAmple' hamp
      · refine isRelativelyNef_of_isNumericallyTrivialOver ?_
        have := numEq_smul htr (-1)
        simp only [neg_smul, one_smul, smul_zero] at this
        exact this)
    (fun i hi => by
      have hin := lt_of_lt_of_le hi hjn
      obtain ⟨-, hfpg, -, hext, htriv, hk, hBM, hCM⟩ := hsteps i hin
      obtain ⟨hYp, hYq, ⟨mi, hKi⟩, -, -, hlam0, -, -⟩ := hmodels i hin.le
      have hD' : ∀ s : ℝ, logCanonicalDivisor (divisorSeq KY KM i)
          (divisorSeq BY BM i + s • divisorSeq CY CM i) =
          logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i) +
            s • divisorSeq CY CM i := fun s => by
        rw [logCanonicalDivisor, logCanonicalDivisor, add_assoc]
      have hCc := isCartierCombination_of_isQFactorial hYq (divisorSeq CY CM i)
      haveI : QuasiCompact (modelStr sY sM i) := hYp.toIsVariety.toQuasiCompact
      rcases hk with ⟨hb, ⟨E, hE⟩, hiso, hmodif⟩ | hflip
      · exact Or.inl ⟨hext.isContraction, ⟨E, hE⟩, hiso⟩
      · refine Or.inr ⟨hflip.isSmall_source, hflip.isSmall, hflip.isMorphismInCodimOne, ?_⟩
        obtain ⟨hYp', hYq', ⟨mi', hKi'⟩, -⟩ := hmodels (i + 1) hin
        change IsRelativelyNef ℂ (sM i) (fp i)
          (logCanonicalDivisor (KM i) (BM i + τ • CM i))
        rcases Nat.lt_or_ge (i + 1) j with hlt | hge
        · have hcurve := exists_properCurve_isContractedBy_of_isNegativeExtremalContraction hext
          have hule : τ ≤ lam i := by
            have hu := hnegj i hi
            rw [hD'] at hu
            rw [hD'] at htriv
            exact (le_of_isRelativelyAntiAmple_or_isNumericallyTrivialOver hcurve
              hext.isRelativelyAntiAmple hCc hlam0 htriv hu).1
          rw [hBM, hCM]
          exact isRelativelyNef_of_isFlip_of_le hflip hYq hYq' hKi hKi' hτ0 hule htriv
        · have hj : i + 1 = j := le_antisymm hi hge
          subst hj
          have h' : IsRelativelyNef ℂ (sM i) (fp i ≫ g i)
              (logCanonicalDivisor (KM i) (BM i + τ • CM i)) := by
            rw [hfpg]; exact hnefj
          exact isRelativelyNef_of_comp' h')
    (by rw [hres.comp_eq_left]; exact hres.isVariety)
    (by rw [hres.comp_eq_left]; exact hres.isSmoothScheme)
    (hres.comp_eq_right.trans hres.comp_eq_left.symm) hres.isProjectiveMorphism_left
    hres.isProjectiveMorphism_right hp₀b hq₀b hres.isInverse hpq₀
    (fun F => by
      change (BY + τ • CY).coeff F =
        (RationalMap.transformDivisor (h₀.compHom q₀) (B + τ • C)).coeff F +
          if MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F then 1 else 0
      rw [hres.compHom_eq, map_add,
        show RationalMap.transformDivisor φ (τ • C) = τ • CY from
          DivisorWithCoeffs.mapPrimeDivisors_smul _ τ C]
      change BY.coeff F + τ * CY.coeff F =
        (RationalMap.transformDivisor φ B).coeff F + τ * CY.coeff F + _
      rw [hBY F]
      ring)
  -- the end model
  obtain ⟨hYjp, hYjq, hKj, hπj, -⟩ := hmodels j hjn
  have hpb : IsBirationalMorphism (b ≫ p₀) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hbb hp₀b
  refine ⟨{
      Y := modelSeq Y Ms j
