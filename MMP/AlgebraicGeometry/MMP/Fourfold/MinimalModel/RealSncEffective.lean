/-- A birational map `χ = q ∘ p⁻¹` through a common model over `Z` lies over `Z`. -/
private theorem isOver_compHom_of_comp_eq {Y V : Scheme.{0}} [IsIntegral V] [IsIntegral Y]
    [IsSeparated (X ↘ ⊤_ Scheme)] [IsSeparated (V ↘ ⊤_ Scheme)] {p : V ⟶ X}
    {h : X.RationalMap V} (hinv : RationalMap.IsInverse p.toRationalMap h) {q : V ⟶ Y}
    {πY : Y ⟶ Z} (hpq : p ≫ π = q ≫ πY) :
    MMP.Flips.RationalMap.IsOver π πY (h.compHom q) := by
  change (h.compHom q).compHom πY = π.toRationalMap
  refine Scheme.RationalMap.eq_of_fromFunctionField_eq _ _ ?_
  rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
    MMP.Flips.RationalMap.fromFunctionField_compHom, MMP.Flips.RationalMap.fromFunctionField_hom,
    Category.assoc, ← hpq, ← Category.assoc, fromFunctionField_comp_of_isInverse hinv]

/-- **Lowered models contracting the same primes are crepant.** If two lowered models of
`(X/Z, B + τ C)` contract the same prime divisors of `X`, then every log discrepancy of a prime
divisor `P` of `X` over the first is also its log discrepancy over the second: on a common
resolution of the two resolutions the pull-backs of the two adjoints agree. -/
private theorem LoweredModel.exists_isLogDiscrepancy_of_isExceptional_iff
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) {B C : RDivisor X} {τ t₁ t₂ : ℝ}
    {S : Finset (MMP.Mori.PrimeDivisor X)} (M₁ : LoweredModel sX sZ π B C τ t₁ S)
    (M₂ : LoweredModel sX sZ π B C τ t₂ S)
    (hcontr : ∀ P, RationalMap.IsExceptional (M₁.h.compHom M₁.q) P ↔
      RationalMap.IsExceptional (M₂.h.compHom M₂.q) P)
    (P : MMP.Mori.PrimeDivisor X) (PV₁ : MMP.Mori.PrimeDivisor M₁.V)
    (hPV₁ : M₁.p PV₁.genericPoint = P.genericPoint)
    (hn₁ : IsNormalVariety ℂ (M₁.q ≫ M₁.sY)) (n₁ : ℕ) (a : ℝ)
    (ha : MMP.Intersection.IsLogDiscrepancy M₁.sY n₁ M₁.Γ
      ⟨M₁.V, M₁.q, hn₁, M₁.isBirationalMorphism_right, PV₁⟩ a) :
    ∃ (PV₂ : MMP.Mori.PrimeDivisor M₂.V) (_ : M₂.p PV₂.genericPoint = P.genericPoint)
      (hn₂ : IsNormalVariety ℂ (M₂.q ≫ M₂.sY)) (n₂ : ℕ),
      MMP.Intersection.IsLogDiscrepancy M₂.sY n₂ M₂.Γ
        ⟨M₂.V, M₂.q, hn₂, M₂.isBirationalMorphism_right, PV₂⟩ a := by
  classical
  haveI := M₁.isIntegral; haveI := M₁.compactSpace; haveI := M₁.isLocallyNoetherian
  haveI := M₁.isNormal; haveI := M₁.isIntegralV; haveI := M₁.isLocallyNoetherianV
  haveI := M₁.isNormalV
  haveI := M₂.isIntegral; haveI := M₂.compactSpace; haveI := M₂.isLocallyNoetherian
  haveI := M₂.isNormal; haveI := M₂.isIntegralV; haveI := M₂.isLocallyNoetherianV
  haveI := M₂.isNormalV
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  haveI := hXn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hY₁n : IsNormalVariety ℂ M₁.sY := M₁.isQFactorial.1
  have hY₂n : IsNormalVariety ℂ M₂.sY := M₂.isQFactorial.1
  haveI := hY₁n.1
  haveI := hY₂n.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hY₁n
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hY₂n
  -- the two resolutions
  have hV₁n : IsNormalVariety ℂ (M₁.p ≫ sX) := ⟨M₁.isVariety, inferInstance⟩
  have hV₂n : IsNormalVariety ℂ (M₂.p ≫ sX) := ⟨M₂.isVariety, inferInstance⟩
  have hV₁p : MMP.Mori.IsProjectiveVariety ℂ (M₁.p ≫ sX) :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ (M₁.p ≫ sX)).mpr
      ⟨M₁.isVariety, M₁.isProjectiveMorphism_left.comp hX.isProjective⟩
  have hV₂p : MMP.Mori.IsProjectiveVariety ℂ (M₂.p ≫ sX) :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ (M₂.p ≫ sX)).mpr
      ⟨M₂.isVariety, M₂.isProjectiveMorphism_left.comp hX.isProjective⟩
  haveI : LocallyOfFiniteType (M₁.p ≫ sX) := M₁.isVariety.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (M₂.p ≫ sX) := M₂.isVariety.toLocallyOfFiniteType
  haveI : QuasiCompact (M₁.p ≫ sX) := M₁.isVariety.toQuasiCompact
  haveI : QuasiCompact (M₂.p ≫ sX) := M₂.isVariety.toQuasiCompact
  haveI : CompactSpace M₁.V := QuasiCompact.compactSpace_of_compactSpace (M₁.p ≫ sX)
  haveI : CompactSpace M₂.V := QuasiCompact.compactSpace_of_compactSpace (M₂.p ≫ sX)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV₁n
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV₂n
  haveI : IsProper M₁.p := isProper_of_isProjectiveMorphism _ M₁.isProjectiveMorphism_left
  haveI : IsProper M₂.p := isProper_of_isProjectiveMorphism _ M₂.isProjectiveMorphism_left
  haveI : IsProper M₁.q := isProper_of_isProjectiveMorphism _ M₁.isProjectiveMorphism_right
  haveI : IsProper M₂.q := isProper_of_isProjectiveMorphism _ M₂.isProjectiveMorphism_right
  haveI : IsDominant M₁.p := M₁.isBirationalMorphism_left.isDominant
  haveI : IsDominant M₂.p := M₂.isBirationalMorphism_left.isDominant
  haveI : IsDominant M₁.q := M₁.isBirationalMorphism_right.isDominant
  haveI : IsDominant M₂.q := M₂.isBirationalMorphism_right.isDominant
  haveI : IsSeparated M₁.p := IsSeparated.of_comp M₁.p (X ↘ ⊤_ Scheme)
  haveI : IsSeparated M₂.p := IsSeparated.of_comp M₂.p (X ↘ ⊤_ Scheme)
  haveI : IsSeparated M₁.q := IsSeparated.of_comp M₁.q (M₁.Y ↘ ⊤_ Scheme)
  haveI : IsSeparated M₂.q := IsSeparated.of_comp M₂.q (M₂.Y ↘ ⊤_ Scheme)
  -- a common resolution `W` of `V₁` and `V₂` over `X`
  obtain ⟨W, _, _, _, c, d, hWv, hWsm, hsq, hcp, hdp, hcb, hdb, hcomm⟩ :=
    exists_tower_step (T := X) (sT := sX) hV₁p hV₁n hXn hV₂n hV₂p M₁.isBirationalMorphism_left
      rfl (f := 𝟙 X) (fp := M₂.p) (Category.id_comp _) rfl M₂.isInverse.isBirational_inverse
      (compHom_eq_of_isInverse M₂.isInverse)
  have hcd : c ≫ M₁.p = d ≫ M₂.p := by simpa using hcomm
  haveI : IsProper c := isProper_of_isProjectiveMorphism c hcp
  haveI : IsProper d := isProper_of_isProjectiveMorphism d hdp
  haveI : IsDominant c := hcb.isDominant
  haveI : IsDominant d := hdb.isDominant
  have hWn : IsNormalVariety ℂ (c ≫ M₁.p ≫ sX) := ⟨hWv, inferInstance⟩
  haveI : LocallyOfFiniteType (c ≫ M₁.p ≫ sX) := hWv.toLocallyOfFiniteType
  haveI : QuasiCompact (c ≫ M₁.p ≫ sX) := hWv.toQuasiCompact
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (c ≫ M₁.p ≫ sX)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hWn
  have hcpb : IsBirationalMorphism (c ≫ M₁.p) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hcb M₁.isBirationalMorphism_left
  have hq₁b : IsBirationalMorphism (c ≫ M₁.q) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hcb M₁.isBirationalMorphism_right
  have hq₂b : IsBirationalMorphism (d ≫ M₂.q) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hdb M₂.isBirationalMorphism_right
  haveI : IsDominant (c ≫ M₁.p) := hcpb.isDominant
  haveI : IsDominant (c ≫ M₁.q) := hq₁b.isDominant
  haveI : IsDominant (d ≫ M₂.q) := hq₂b.isDominant
  obtain ⟨e, he⟩ := id hcpb
  have hH₁ : RationalMap.IsInverse (c ≫ M₁.p).toRationalMap e.symm.toRationalMap :=
    ⟨e, he, rfl⟩
  have hH₂ : RationalMap.IsInverse (d ≫ M₂.p).toRationalMap e.symm.toRationalMap := by
    rw [← hcd]; exact hH₁
  have hh₁ : e.symm.toRationalMap.compHom (c ≫ M₁.q) = M₁.h.compHom M₁.q :=
    MMP.Mori.RationalMap.IsInverse.compHom_comp_eq M₁.isInverse hH₁ M₁.q
  have hh₂ : e.symm.toRationalMap.compHom (d ≫ M₂.q) = M₂.h.compHom M₂.q :=
    MMP.Mori.RationalMap.IsInverse.compHom_comp_eq M₂.isInverse hH₂ M₂.q
  have hq₁s : (c ≫ M₁.q) ≫ M₁.sY = c ≫ M₁.p ≫ sX := by
    rw [Category.assoc, M₁.comp_eq_res]
  have hq₂s : (d ≫ M₂.q) ≫ M₂.sY = c ≫ M₁.p ≫ sX := by
    rw [Category.assoc, M₂.comp_eq_res, ← Category.assoc, ← hcd, Category.assoc]
  have hqZ : (c ≫ M₁.q) ≫ M₁.πY = (d ≫ M₂.q) ≫ M₂.πY := by
    rw [Category.assoc, Category.assoc, ← M₁.comp_eq_base, ← M₂.comp_eq_base,
      ← Category.assoc, hcd, Category.assoc]
  have hWn₁ : IsNormalVariety ℂ ((c ≫ M₁.q) ≫ M₁.sY) := by rw [hq₁s]; exact hWn
  have hWn₂ : IsNormalVariety ℂ ((d ≫ M₂.q) ≫ M₂.sY) := by rw [hq₂s]; exact hWn
  -- compatible canonical divisors
  obtain ⟨m₁, hK₁⟩ := M₁.isCanonicalDivisor
  obtain ⟨m₂, hK₂⟩ := M₂.isCanonicalDivisor
  haveI : MMP.Mori.IsVariety ℂ ((c ≫ M₁.q) ≫ M₁.sY) := hWn₁.1
  haveI : MMP.Mori.IsVariety ℂ ((d ≫ M₂.q) ≫ M₂.sY) := hWn₂.1
  have hdim₁ : topologicalKrullDim W = m₁ := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism M₁.sY
      ((c ≫ M₁.q) ≫ M₁.sY) hq₁b]
    exact hK₁.topologicalKrullDim_eq
  have hm : m₂ = m₁ := by
    have h1 := hK₂.topologicalKrullDim_eq
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism M₂.sY
      ((d ≫ M₂.q) ≫ M₂.sY) hq₂b, hdim₁] at h1
    exact_mod_cast h1.symm
  rw [hm] at hK₂
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isNormalVariety
    ((c ≫ M₁.q) ≫ M₁.sY) hWn₁ hdim₁
  obtain ⟨KW, hKW, hKW₁⟩ :=
    MMP.Fourfold.Oai4C1.Main.exists_isCanonicalDivisor_transformDivisor_eq hY₁n hWn₁ hq₁b hK₁ hK₀
  have hKW' : KW.IsCanonicalDivisor (c ≫ M₁.p ≫ sX) m₁ := by rw [← hq₁s]; exact hKW
  have hKW₂c : KW.IsCanonicalDivisor ((d ≫ M₂.q) ≫ M₂.sY) m₁ := by rw [hq₂s]; exact hKW'
  set K₂' : Divisor M₂.Y := RationalMap.transformDivisor (X := W) (d ≫ M₂.q).toRationalMap KW
    with hK₂'def
  have hK₂' : K₂'.IsCanonicalDivisor M₂.sY m₁ :=
    MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hY₂n hWn₂ hq₂b hK₂ hKW₂c
  have hKK : K₂'.LinearlyEquivalent M₂.KY :=
    MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor M₂.sY hY₂n hK₂' hK₂
  haveI : QuasiCompact M₂.sY := hY₂n.1.toQuasiCompact
  have hnef₂ : IsRelativelyNef ℂ M₂.sY M₂.πY (logCanonicalDivisor K₂' M₂.Γ) :=
    isRelativelyNef_logCanonicalDivisor_of_linearlyEquivalent hKK M₂.isRelativelyNef
  -- the pull-backs of the two adjoints agree on `W`
  obtain ⟨G₁, hG₁, -⟩ := MMP.Flips.existsUnique_isRCartierPullback (c ≫ M₁.q)
    (isCartierCombination_of_isQFactorial M₁.isQFactorial (logCanonicalDivisor M₁.KY M₁.Γ))
  obtain ⟨G₂, hG₂, -⟩ := MMP.Flips.existsUnique_isRCartierPullback (d ≫ M₂.q)
    (isCartierCombination_of_isQFactorial M₂.isQFactorial (logCanonicalDivisor K₂' M₂.Γ))
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV₁n
  have hG : G₁ = G₂ := MMP.Fourfold.eq_of_isRCartierPullback_of_isExceptional_iff
    (B := B + τ • C) M₁.comp_eq M₂.comp_eq hY₁n M₁.isProjectiveVariety M₁.isQFactorial hY₂n
    M₂.isProjectiveVariety M₂.isQFactorial ⟨m₁, hK₁⟩ ⟨m₁, hK₂'⟩ M₁.isRealDltPair.1
    M₂.isRealDltPair.1 M₁.isRelativelyNef hnef₂
    (M₁.isInverse.isBirational_compHom M₁.isBirationalMorphism_right)
    (M₂.isInverse.isBirational_compHom M₂.isBirationalMorphism_right)
    (isOver_compHom_of_comp_eq M₁.isInverse M₁.comp_eq_base)
    (isOver_compHom_of_comp_eq M₂.isInverse M₂.comp_eq_base) M₁.coeff_boundary
    M₂.coeff_boundary hcontr hWv hq₁s hq₂s hqZ (hcp.comp M₁.isProjectiveMorphism_right)
    (hdp.comp M₂.isProjectiveMorphism_right) hq₁b hq₂b hh₁ hh₂ hKW' hKW₁ rfl hG₁ hG₂
  -- the strict transforms of `P` on `W` and on `V₂`
  have hWnp : IsNormalVariety ℂ ((c ≫ M₁.p) ≫ sX) := by rw [Category.assoc]; exact hWn
  obtain ⟨PW, hPW, -, -⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hWnp hcpb P
  have hcPW : c PW.genericPoint = PV₁.genericPoint :=
    eq_of_map_eq_genericPoint M₁.p M₁.isBirationalMorphism_left.functionFieldMap_bijective
      (show M₁.p (c PW.genericPoint) = P.genericPoint from hPW) hPV₁
  obtain ⟨PV₂, hPV₂, -, -⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hV₂n
      M₂.isBirationalMorphism_left P
  have hdPW : d PW.genericPoint = PV₂.genericPoint :=
    eq_of_map_eq_genericPoint M₂.p M₂.isBirationalMorphism_left.functionFieldMap_bijective
      (show M₂.p (d PW.genericPoint) = P.genericPoint by
        rw [← Scheme.Hom.comp_apply, ← hcd]; exact hPW) hPV₂
  -- compatible top forms and the log discrepancies of `PW`
  obtain ⟨ω₁, hω₁0, hω₁, hω₁W⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hY₁n hWn₁ hq₁b hK₁ hKW hKW₁
  obtain ⟨ω₂, hω₂0, hω₂, hω₂W⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hY₂n hWn₂ hq₂b hK₂' hKW₂c rfl
  have ha₁W := isLogDiscrepancy_of_isRCartierPullback hY₁n hWn₁ hq₁b hω₁0
    (by rw [hω₁]; exact hK₁) (by rw [hω₁]; exact hG₁) PW
  have ha₂W := isLogDiscrepancy_of_isRCartierPullback hY₂n hWn₂ hq₂b hω₂0
    (by rw [hω₂]; exact hK₂') (by rw [hω₂]; exact hG₂) PW
  have hval₁ : (⟨M₁.V, M₁.q, hn₁, M₁.isBirationalMorphism_right, PV₁⟩ :
      DivisorOver ℂ M₁.sY).valuation =
      (⟨W, c ≫ M₁.q, hWn₁, hq₁b, PW⟩ : DivisorOver ℂ M₁.sY).valuation :=
    (divisorOver_valuation_mk _ _ _).trans ((valuationOver_eq_of_comp_eq (g := M₁.q)
      hcb.functionFieldMap_bijective.2 rfl hcPW).symm.trans (divisorOver_valuation_mk _ _ _).symm)
  have ha1 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha ha₁W hval₁
  -- a log discrepancy of `PV₂` over the second model
  have hn₂ : IsNormalVariety ℂ (M₂.q ≫ M₂.sY) := by rw [M₂.comp_eq_res]; exact hV₂n
  obtain ⟨GV₂, hGV₂, -⟩ := MMP.Flips.existsUnique_isRCartierPullback M₂.q
    (isCartierCombination_of_isQFactorial M₂.isQFactorial
      (logCanonicalDivisor (divisorOfForm ω₂) M₂.Γ))
  have ha₂ := isLogDiscrepancy_of_isRCartierPullback hY₂n hn₂ M₂.isBirationalMorphism_right
    hω₂0 (by rw [hω₂]; exact hK₂') hGV₂ PV₂
  have hval₂ : (⟨M₂.V, M₂.q, hn₂, M₂.isBirationalMorphism_right, PV₂⟩ :
      DivisorOver ℂ M₂.sY).valuation =
      (⟨W, d ≫ M₂.q, hWn₂, hq₂b, PW⟩ : DivisorOver ℂ M₂.sY).valuation :=
    (divisorOver_valuation_mk _ _ _).trans ((valuationOver_eq_of_comp_eq (g := M₂.q)
      hdb.functionFieldMap_bijective.2 rfl hdPW).symm.trans (divisorOver_valuation_mk _ _ _).symm)
  have ha2 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha₂ ha₂W hval₂
  refine ⟨PV₂, hPV₂, hn₂, m₁, ?_⟩
  convert ha₂ using 1
  rw [ha2, ha1, DivisorOver.ordPullback, DivisorOver.ordPullback, ← coeff_divisorOfForm,
    ← coeff_divisorOfForm, hω₁W, hω₂W, hG]

/-- The conclusion at the infimum: `(X/Z, B)` has a nef log birational model. -/
private def HasNefModel (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z)
    (KX : Divisor X) (B : RDivisor X) : Prop :=
  ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : CompactSpace Y) (_ : IsLocallyNoetherian Y)
      (_ : IsNormal Y) (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY : RDivisor Y)
      (φ : X.RationalMap Y),
      IsNefLogBirationalModel sX sY sZ π πY KX B KY BY φ

/-- **Nef log birational models at the infimum** (the limit step of the closedness). If
`(X/Z, B + t C)` has log minimal models for parameters `t > τ` arbitrarily close to `τ`, lowered
to level `τ` by the finite floor program, then infinitely many of the lowered models contract the
same source primes, hence have the same target discrepancies at `τ`, and the limit of the
inequalities `a(D; X, B + t C) ≤ a(D; Y, B_Y + τ C_Y)` makes one of them a nef log birational
model of `(X/Z, B + τ C)`. -/
private theorem hasNefModel_of_frequently_hasModel {B C N : RDivisor X} {α : ℝ}
    (hD : IsFloorDatum sX sZ π KX A B C N α) {τ : ℝ} (hτ0 : 0 ≤ τ) (hτ1 : τ < 1)
    (h : ∀ ε > 0, ∃ t, τ < t ∧ t < τ + ε ∧ t ≤ 1 ∧ HasModel sX sZ π KX (B + t • C)) :
    HasNefModel sX sZ π KX (B + τ • C) := by
  classical
  set S₀ : Finset (MMP.Mori.PrimeDivisor X) := (B + C + N).support with hS₀
  -- lowered models arbitrarily close to `τ`
  have hlow : ∀ ε > 0, ∃ t, τ < t ∧ t < τ + ε ∧
      Nonempty (LoweredModel sX sZ π B C τ t S₀) := fun ε hε => by
    obtain ⟨t, h1, h2, h3, h4⟩ := h ε hε
    exact ⟨t, h1, h2, exists_loweredModel hD hτ0 h1 h3 h4⟩
  -- a set of contracted primes attained arbitrarily close to `τ`
  have hpig : ∃ T ∈ S₀.powerset, ∀ ε > 0, ∃ t, τ < t ∧ t < τ + ε ∧
      ∃ M : LoweredModel sX sZ π B C τ t S₀,
        ∀ P, RationalMap.IsExceptional (M.h.compHom M.q) P ↔ P ∈ T := by
    by_contra hne
    have hne' : ∀ T ∈ S₀.powerset, ∃ ε > 0, ∀ t, τ < t → t < τ + ε →
        ∀ M : LoweredModel sX sZ π B C τ t S₀,
          ¬ ∀ P, (RationalMap.IsExceptional (M.h.compHom M.q) P ↔ P ∈ T) := by
      intro T hT
      by_contra h'
      apply hne
      refine ⟨T, hT, fun ε hε => ?_⟩
      by_contra h''
      exact h' ⟨ε, hε, fun t ht1 ht2 M hM => h'' ⟨t, ht1, ht2, M, hM⟩⟩
    choose! ε hε hεT using hne'
    obtain ⟨δ, hδ, hδε⟩ := exists_pos_forall_le_of_finite (S₀.powerset.finite_toSet) ε
      (fun T hT => hε T hT)
    obtain ⟨t, ht1, ht2, ⟨M⟩⟩ := hlow δ hδ
    set T : Finset (MMP.Mori.PrimeDivisor X) :=
      S₀.filter fun P => RationalMap.IsExceptional (M.h.compHom M.q) P with hTdef
    have hT : T ∈ S₀.powerset := Finset.mem_powerset.mpr (Finset.filter_subset _ _)
    refine hεT T hT t ht1 (by linarith [hδε T hT]) M fun P => ⟨fun hPe => ?_, fun hPT => ?_⟩
    · exact Finset.mem_filter.mpr ⟨M.mem_of_isExceptional P hPe, hPe⟩
    · exact (Finset.mem_filter.mp hPT).2
  obtain ⟨T, -, hfreq⟩ := hpig
  obtain ⟨t₁, -, -, M₁, hM₁⟩ := hfreq 1 one_pos
  -- the comparison holds at `τ` on the first of these models
  have hle : ∀ P, RationalMap.IsExceptional (M₁.h.compHom M₁.q) P →
      ∀ PV : MMP.Mori.PrimeDivisor M₁.V, M₁.p PV.genericPoint = P.genericPoint →
      ∀ (hn : IsNormalVariety ℂ (M₁.q ≫ M₁.sY)) (n : ℕ) (a : ℝ),
        MMP.Intersection.IsLogDiscrepancy M₁.sY n M₁.Γ
          ⟨M₁.V, M₁.q, hn, M₁.isBirationalMorphism_right, PV⟩ a →
          1 - (B + τ • C).coeff P ≤ a := by
    intro P hP PV hPV hn n a ha
    have hC0 := hD.hC P
    change 1 - (B.coeff P + τ * C.coeff P) ≤ a
    refine le_of_forall_pos_lt_add fun ε hε => ?_
    obtain ⟨t₂, ht₂, ht₂', M₂, hM₂⟩ := hfreq (ε / (C.coeff P + 1)) (by positivity)
    have hcontr : ∀ P', RationalMap.IsExceptional (M₁.h.compHom M₁.q) P' ↔
        RationalMap.IsExceptional (M₂.h.compHom M₂.q) P' := fun P' =>
      (hM₁ P').trans (hM₂ P').symm
    obtain ⟨PV₂, hPV₂, hn₂, n₂, ha₂⟩ :=
      LoweredModel.exists_isLogDiscrepancy_of_isExceptional_iff hD.hX M₁ M₂ hcontr P PV hPV hn n
        a ha
    have h2 := M₂.le_logDiscrepancy P ((hcontr P).mp hP) PV₂ hPV₂ hn₂ n₂ a ha₂
    change 1 - (B.coeff P + t₂ * C.coeff P) ≤ a at h2
    have h3 : (t₂ - τ) * C.coeff P < ε := by
      have h4 : t₂ - τ < ε / (C.coeff P + 1) := by linarith
      have h5 : ε / (C.coeff P + 1) * C.coeff P < ε := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by linarith)]
        nlinarith
      calc (t₂ - τ) * C.coeff P ≤ ε / (C.coeff P + 1) * C.coeff P :=
            mul_le_mul_of_nonneg_right h4.le hC0
        _ < ε := h5
    nlinarith
  -- the first model is a nef log birational model at `τ`
  have hXn : IsNormalVariety ℂ sX := ⟨hD.hX.toIsVariety, inferInstance⟩
  haveI := hXn.1
  have hXQ : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hD.hXsm D⟩⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hV₁n : IsNormalVariety ℂ (M₁.p ≫ sX) := ⟨M₁.isVariety, inferInstance⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV₁n
  have hlcτ : IsRealLcPair sX (B + τ • C) := by
    refine isRealLcPair_of_isSNC hD.hX hD.hXsm hD.hdim hD.hKX (fun P => ?_) (fun P => ?_)
      (hD.hsnc.of_support_subset fun E hE => ?_)
    · have := hD.hB P; have := hD.hC P
      change 0 ≤ B.coeff P + τ * C.coeff P
      positivity
    · have h1 := hD.hBC1 P; have := hD.hC P
      change B.coeff P + C.coeff P ≤ 1 at h1
      change B.coeff P + τ * C.coeff P ≤ 1
      nlinarith
    · rw [Finsupp.mem_support_iff] at hE ⊢
      intro h0
      have hB0 := hD.hB E; have hC0 := hD.hC E
      change B.coeff E + C.coeff E = 0 at h0
      apply hE
      change B.coeff E + τ * C.coeff E = 0
      have hb : B.coeff E = 0 := by linarith
      have hc : C.coeff E = 0 := by linarith
      rw [hb, hc]; ring
  obtain ⟨KY', GX, GY, -, hN, -⟩ := exists_isNefLogBirationalModel_of_resolution hD.hX hXQ hD.hZ
    hD.hπ hD.hKX hlcτ M₁.isProjectiveVariety M₁.isQFactorial M₁.comp_eq M₁.isCanonicalDivisor
    M₁.isRealDltPair M₁.isRelativelyNef
    (M₁.isInverse.isBirational_compHom M₁.isBirationalMorphism_right)
    (isOver_compHom_of_comp_eq M₁.isInverse M₁.comp_eq_base) M₁.coeff_boundary M₁.isVariety
    M₁.isSmoothScheme M₁.comp_eq_res M₁.isProjectiveMorphism_left M₁.isProjectiveMorphism_right
    M₁.isBirationalMorphism_left M₁.isBirationalMorphism_right M₁.isInverse rfl M₁.comp_eq_base hle
  exact ⟨M₁.Y, inferInstance, inferInstance, inferInstance, inferInstance, M₁.sY, M₁.πY, KY',
    M₁.Γ, _, hN⟩

/-- **From a nef log birational model to a log minimal model**, assuming `P(4)`. For a real snc
boundary `B` on a smooth projective fourfold containing an ample component outside `⌊B⌋`, a nef
log birational model `(Y, B_Y)` becomes a log minimal model after extracting the finitely many
contracted primes along which the comparison vanishes: the klt perturbation makes `(Y, Δ_Y)`
klt with these primes of log discrepancy in `(0, 1]`, the real finite extraction extracts them,
the crepant boundary of `(Y, B_Y)` on the extraction is lc, and a crepant real dlt modification of
it is a log minimal model. -/
private theorem hasModel_of_hasNefModel {B : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hπ : π ≫ sZ = sX) (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hB : ∀ P, 0 ≤ B.coeff P) (hB1 : ∀ P, B.coeff P ≤ 1)
    (hsnc : DivisorWithCoeffs.IsSNC sX B)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1)
    (hm : HasNefModel sX sZ π KX B) :
    HasModel sX sZ π KX B := by
  classical
  obtain ⟨Y, _, _, _, _, sY, πY, KY, BY, φ, hY⟩ := hm
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  have hlc := hY.isRealLcPair
  -- the klt perturbation and the comparison resolution
  obtain ⟨Δ, ΔY, hΔ0, hΔklt, hΔeq, hΔY0, hΔYklt, hcmp, -⟩ :=
    MMP.Fourfold.exists_isRealKltPair_comparison_eq_of_isNefLogBirationalModel (k := ℂ) hXsm hX
      hlc hsnc A hA hA0 (fun P => by simpa [QDivisor.coeff_toRDivisor] using hAB P) hAfl hY
  obtain ⟨W, _, _, _, sW, p, q, h, GX, GY, hR⟩ := hY.exists_resolution
  obtain ⟨GX', GY', hR', hdiff⟩ := hcmp W sW p q h GX GY hR
  -- standing facts on `X`, `Y`, `W`
  obtain ⟨m, hm⟩ := hKX
  have hm4 : (m : WithBot ℕ∞) = 4 := hm.topologicalKrullDim_eq.symm.trans hdim
  obtain rfl : m = 4 := by exact_mod_cast hm4
  have hYn : IsNormalVariety ℂ sY := hY.isNormalVariety_model
  have hYp := hY.isProjectiveVariety_model
  have hYQ := hY.isQFactorial
  haveI := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  have hpb := hR.isBirationalMorphism_left
  have hqb := hR.isBirationalMorphism_right
  haveI : IsProper p := isProper_of_isProjectiveMorphism p hR.isProjectiveMorphism_left
  haveI : IsProper q := isProper_of_isProjectiveMorphism q hR.isProjectiveMorphism_right
  haveI : IsDominant p := hpb.isDominant
  haveI : IsDominant q := hqb.isDominant
  have hWn : IsNormalVariety ℂ sW := ⟨hR.isVariety, inferInstance⟩
  haveI : QuasiCompact sW := hR.isVariety.toQuasiCompact
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace sW
  haveI : LocallyOfFiniteType sW := hR.isVariety.toLocallyOfFiniteType
  have hWnp : IsNormalVariety ℂ (p ≫ sX) := by rw [hR.comp_eq_left]; exact hWn
  have hWnq : IsNormalVariety ℂ (q ≫ sY) := by rw [hR.comp_eq_right]; exact hWn
  haveI : LocallyOfFiniteType (p ≫ sX) := by rw [hR.comp_eq_left]; infer_instance
  haveI : LocallyOfFiniteType (q ≫ sY) := by rw [hR.comp_eq_right]; infer_instance
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hWn
  haveI : IsSeparated p := IsSeparated.of_comp p (X ↘ ⊤_ Scheme)
  haveI : MMP.Mori.IsVariety ℂ (q ≫ sY) := hWnq.1
  haveI : MMP.Mori.IsVariety ℂ (p ≫ sX) := hWnp.1
  have hdimY : topologicalKrullDim Y = 4 := by
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q ≫ sY) hqb,
      ← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hpb, hdim]
  -- compatible top forms
  obtain ⟨mW, KW, hKW, hpK, hqK⟩ := hR.exists_canonicalDivisor
  have hKWp : KW.IsCanonicalDivisor (p ≫ sX) mW := by rw [hR.comp_eq_left]; exact hKW
  have hKWq : KW.IsCanonicalDivisor (q ≫ sY) mW := by rw [hR.comp_eq_right]; exact hKW
  have hmW : mW = 4 := by
    have h1 := hKWp.topologicalKrullDim_eq
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hpb,
      hdim] at h1
    exact_mod_cast h1.symm
  subst hmW
  obtain ⟨mY, hKY⟩ := hY.isCanonicalDivisor_model
  have hmY : mY = 4 := by
    have h1 := hKY.topologicalKrullDim_eq
    rw [hdimY] at h1
    exact_mod_cast h1.symm
  subst hmY
  obtain ⟨ωY, hωY0, hωY, hωYW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hWnq hqb hKY hKWq hqK
  -- strict transforms of the prime divisors of `X` on `W`
  choose PWf hPWf using fun P : MMP.Mori.PrimeDivisor X =>
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hWnp hpb P
  have hPWtr : ∀ P, RationalMap.transformPrimeDivisor h P = some (PWf P) := fun P =>
    transformPrimeDivisor_eq_some_of_isInverse hpb.functionFieldMap_bijective hR.isInverse
      (hPWf P).1
  have hKWP : ∀ P, (KW.coeff (PWf P) : ℝ) = KX.coeff P := fun P => by
    have := (hPWf P).2.2 KW
    rw [hpK] at this
    exact_mod_cast this.symm
  -- the contracted primes, and among them the equality primes
  have hPWinj : Function.Injective PWf := fun P P' hPP =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((hPWf P).1.symm.trans (hPP ▸ (hPWf P').1))
  have hSfin : {P : MMP.Mori.PrimeDivisor X | RationalMap.IsExceptional φ P}.Finite := by
    haveI : IsSeparated q := IsSeparated.of_comp q (Y ↘ ⊤_ Scheme)
    haveI : IsNoetherian W := ⟨⟩
    set U : W.Opens := q ⁻¹ᵁ MMP.Mori.biregularLocus q with hUdef
    have hηU : genericPoint W ∈ U := by
      change q (genericPoint W) ∈ MMP.Mori.biregularLocus q
      rw [MMP.Positivity.map_genericPoint_eq_of_isDominant q]
      exact MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal q hqb
        ((Order.coheight_eq_zero.mpr fun b _ => genericPoint_specializes b).trans_le zero_le_one)
    have hfin := MMP.Mori.finite_setOf_genericPoint_mem (S := W) U.isOpen.isClosed_compl
      (fun s hs h0 => hs (by
        have hsp : s ⤳ genericPoint W :=
          (Order.coheight_eq_zero.1 h0) ((genericPoint_spec W).specializes trivial)
        rw [hsp.antisymm (genericPoint_specializes s) |>.eq]
        exact hηU))
    refine (hfin.preimage fun P _ P' _ hPP => hPWinj hPP).subset fun P hP => ?_
    change (PWf P).genericPoint ∈ ((U : Set W)ᶜ)
    intro hU
    have hP' : RationalMap.IsExceptional φ P := hP
    rw [← hR.compHom_eq, isExceptional_compHom_iff (hPWtr P) q,
      isExceptional_toRationalMap_iff_two_le_coheight,
      MMP.Positivity.coheight_map_of_mem_biregularLocus q hU,
      (PWf P).coheight_genericPoint] at hP'
    exact absurd hP' (by decide)
  set Eq : Finset (MMP.Mori.PrimeDivisor X) := (hSfin.subset fun P hP => hP.1 :
      {P : MMP.Mori.PrimeDivisor X | RationalMap.IsExceptional φ P ∧
        (GX - GY).coeff (PWf P) = 0}.Finite).toFinset with hEqdef
  have hEqmem : ∀ P, P ∈ Eq ↔ RationalMap.IsExceptional φ P ∧ (GX - GY).coeff (PWf P) = 0 :=
    fun P => by rw [hEqdef, Set.Finite.mem_toFinset]; rfl
  -- the log discrepancy of an equality prime with respect to `(Y, Δ_Y)` and `(Y, B_Y)`
  let EY : MMP.Mori.PrimeDivisor X → DivisorOver ℂ sY := fun P => ⟨W, q, hWnq, hqb, PWf P⟩
  have hKYω : KY = divisorOfForm ωY := hωY.symm
  have hlogY : ∀ (D : RDivisor Y) (G : RDivisor W),
      IsRCartierPullback q (logCanonicalDivisor KY D) G → ∀ P,
      MMP.Intersection.IsLogDiscrepancy sY 4 D (EY P)
        (1 + (KW.coeff (PWf P) : ℝ) - G.coeff (PWf P)) := by
    intro D G hG P
    rw [hKYω] at hG
    have := isLogDiscrepancy_of_isRCartierPullback hYn hWnq hqb hωY0 (hKYω ▸ hKY) hG (PWf P)
    convert this using 2
    rw [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωYW]
  have hGXc : ∀ (D : RDivisor X) (G : RDivisor W),
      IsRCartierPullback p (logCanonicalDivisor KX D) G → ∀ P,
      G.coeff (PWf P) = KX.coeff P + D.coeff P := fun D G hG P => by
    haveI := (hPWf P).2.1
    rw [coeff_eq_of_isRCartierPullback hG (PWf P) P (hPWf P).1]
    rfl
  have haΔ : ∀ P ∈ Eq, MMP.Intersection.IsLogDiscrepancy sY 4 ΔY (EY P) (1 - Δ.coeff P) := by
    intro P hP
    have h1 := hlogY ΔY GY' hR'.isRCartierPullback_right P
    have h2 := hGXc Δ GX' hR'.isRCartierPullback_left P
    have h3 : (GX' - GY').coeff (PWf P) = 0 := by rw [hdiff]; exact ((hEqmem P).mp hP).2
    rw [DivisorWithCoeffs.coeff_sub] at h3
    convert h1 using 1
    rw [hKWP]
    linarith
  have haB : ∀ P ∈ Eq, MMP.Intersection.IsLogDiscrepancy sY 4 BY (EY P) (1 - B.coeff P) := by
    intro P hP
    have h1 := hlogY BY GY hR.isRCartierPullback_right P
    have h2 := hGXc B GX hR.isRCartierPullback_left P
    have h3 : (GX - GY).coeff (PWf P) = 0 := ((hEqmem P).mp hP).2
    rw [DivisorWithCoeffs.coeff_sub] at h3
    convert h1 using 1
    rw [hKWP]
    linarith
  -- the extraction of the equality primes over `(Y, Δ_Y)`
  have hEinj : Function.Injective fun j : Eq => (EY j).valuation := by
    intro j j' hjj
    have hjj' : (EY j).valuation = (EY j').valuation := hjj
    have h1 : (PWf j).valuationOver q = (PWf j').valuationOver q :=
      (divisorOver_valuation_mk _ _ _).symm.trans (hjj'.trans (divisorOver_valuation_mk _ _ _))
    exact Subtype.ext (hPWinj (eq_of_valuationOver_eq hWn hqb.functionFieldMap_bijective.2 h1))
  have hEexc : ∀ j : Eq, (EY j).IsExceptional := fun j => by
    have := ((hEqmem j).mp j.2).1
    rw [← hR.compHom_eq] at this
    exact (isExceptional_compHom_iff (hPWtr j) q).mp this
  obtain ⟨V, _, _, _, pV, hVQ, hpVb, F, hVp, hpVp, hFval, hFinj, hFexc, -, -, KV₀, hKV₀,
      hpVK, -⟩ := MMP.Fourfold.exists_isQFactorial_extraction_of_isRealKltPair sY 4
      projectiveFloorProgramInputs_four hYp hdimY KY
    hKY ΔY hΔY0 hΔYklt (fun j : Eq => EY j) hEinj hEexc (fun j => 1 - Δ.coeff j)
    (fun j => haΔ j j.2) (fun j => by linarith [hΔ0 j])
  -- the crepant boundary of `(Y, B_Y)` on `V`
  have hVn : IsNormalVariety ℂ (pV ≫ sY) := hVQ.1
  haveI := hVn.1
  haveI : IsProper pV := isProper_of_isProjectiveMorphism pV hpVp
  haveI : IsDominant pV := hpVb.isDominant
  haveI : LocallyOfFiniteType (pV ≫ sY) := hVn.1.toLocallyOfFiniteType
  haveI : QuasiCompact (pV ≫ sY) := hVn.1.toQuasiCompact
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace (pV ≫ sY)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hVn
  haveI : IsSeparated pV := IsSeparated.of_comp pV (Y ↘ ⊤_ Scheme)
  obtain ⟨ωV, hωV0, hωVY, hωVV⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hVn hpVb hKY hKV₀ hpVK
  have hKYc : IsCartierCombination (logCanonicalDivisor KY BY) :=
    isCartierCombination_of_isQFactorial hYQ _
  obtain ⟨GV, hGV, -⟩ := MMP.Flips.existsUnique_isRCartierPullback pV hKYc
  set BV : RDivisor V := GV - Divisor.toRDivisor KV₀ with hBVdef
  have hKBV : logCanonicalDivisor KV₀ BV = GV := by
    rw [hBVdef, logCanonicalDivisor]; abel
  have hBVpb : IsRCartierPullback pV (logCanonicalDivisor (divisorOfForm ωV) BY)
      (logCanonicalDivisor (divisorOfForm (pullbackRationalPluriForms sY pV ωV)) BV) := by
    rw [hωVY, hωVV, hKBV]; exact hGV
  have hKV₀ω : (divisorOfForm (pullbackRationalPluriForms sY pV ωV)).IsCanonicalDivisor
      (pV ≫ sY) 4 := by rw [hωVV]; exact hKV₀
  -- the coefficients of `B_V`
  have hBVc : ∀ Q : MMP.Mori.PrimeDivisor V, ¬ RationalMap.IsExceptional (X := V)
      pV.toRationalMap Q → ∃ F : MMP.Mori.PrimeDivisor Y, pV Q.genericPoint = F.genericPoint ∧
        BV.coeff Q = BY.coeff F := by
    intro Q hQ
    obtain ⟨F, hF⟩ := exists_primeDivisor_of_not_isExceptional_toRationalMap pV hpVb Q hQ
    haveI := isIso_stalkMap_of_map_eq_genericPoint pV hpVb.functionFieldMap_bijective hF
    refine ⟨F, hF, ?_⟩
    have h1 := coeff_eq_of_isRCartierPullback hGV Q F hF
    have h2 := coeff_transformDivisor_hom hpVb.functionFieldMap_bijective
      (Divisor.toRDivisor KV₀) hF
    rw [transformDivisor_toRDivisor, hpVK, Divisor.coeff_toRDivisor,
      Divisor.coeff_toRDivisor] at h2
    rw [hBVdef, DivisorWithCoeffs.coeff_sub, h1, Divisor.coeff_toRDivisor, ← h2]
    change (KY.coeff F : ℝ) + BY.coeff F - KY.coeff F = _
    ring
  have hBVF : ∀ j : Eq, BV.coeff (F j) = B.coeff j := by
    intro j
    have h1 := isLogDiscrepancy_of_isRCartierPullback hYn hVn hpVb hωV0 (hωVY ▸ hKY)
      (by rw [hωVY]; exact hGV) (F j)
    have h2 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq h1 (haB j j.2)
      (hFval j)
    have h3 : ((⟨V, pV, hVn, hpVb, F j⟩ : DivisorOver ℂ sY).ordPullback ωV : ℝ) =
        KV₀.coeff (F j) := by
      rw [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωVV]
    rw [h3] at h2
    rw [hBVdef, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toRDivisor]
    linarith
  have hBV0 : ∀ Q, 0 ≤ BV.coeff Q := by
    intro Q
    by_cases hQ : RationalMap.IsExceptional (X := V) pV.toRationalMap Q
    · obtain ⟨j, rfl⟩ := (hFexc Q).mp hQ
      rw [hBVF]; exact hB j
    · obtain ⟨F, -, hF⟩ := hBVc Q hQ
      rw [hF]; exact hY.isRealDltPair.1.2.1 F
  have hlcV : IsRealLcPair (pV ≫ sY) BV := by
    refine ⟨hVn, hBV0, ⟨4, KV₀, hKV₀, ?_⟩, fun n D a ha => ?_⟩
    · obtain ⟨mm, r, L, L', hL, -, hpb, he⟩ := hGV
      refine ⟨mm, r, L', fun j => (hpb j).2.isCartier (hL j), fun Γ => ?_⟩
      have := congrArg (fun D : RDivisor V => D.coeff Γ) he
      change (Divisor.toRDivisor KV₀ + BV).coeff Γ = _
      rw [show Divisor.toRDivisor KV₀ + BV = GV from hKBV]
      simpa only [MMP.Flips.coeff_sum_smul_toRDivisor] using this
    · have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
      have hdimV : topologicalKrullDim V = 4 := by
        haveI : MMP.Mori.IsVariety ℂ (pV ≫ sY) := hVn.1
        rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (pV ≫ sY) hpVb,
          hdimY]
      obtain rfl : n = 4 := by
        rw [hdimV] at hn
        exact_mod_cast hn.symm
      obtain ⟨hD1, hD2, hD3⟩ := isLogDiscrepancy_comp_of_isRCartierPullback hYn hVn hpVb hωV0
        (hωVY ▸ hKY) hKV₀ω hBVpb D ha
      exact hY.isRealDltPair.1.2.2.2 4 _ a hD3
  -- a crepant dlt modification of `(V, B_V)`
  have hdimV : topologicalKrullDim V = 4 := by
    haveI : MMP.Mori.IsVariety ℂ (pV ≫ sY) := hVn.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (pV ≫ sY) hpVb,
      hdimY]
  obtain ⟨V', _, _, _, pV', hV'Q, hpV'b, BV', hV'p, hpV'p, hexc1, hnonexc, hdltV',
      ⟨KV', hKV', hpV'K, hpullV'⟩, hzero⟩ :=
    MMP.Fourfold.exists_isQFactorial_dltModification_of_isRealLcPair (pV ≫ sY) 4
      projectiveFloorProgramInputs_four hVp hdimV
      KV₀ hKV₀ BV hlcV
  -- the composite `c : V' ⟶ Y`
  have hcomp : ∀ {A B C : Scheme.{0}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
    fun _ _ _ => rfl
  have hV'n : IsNormalVariety ℂ (pV' ≫ pV ≫ sY) := hV'Q.1
  haveI := hV'n.1
  haveI : IsProper pV' := isProper_of_isProjectiveMorphism pV' hpV'p
  haveI : IsDominant pV' := hpV'b.isDominant
  haveI : LocallyOfFiniteType (pV' ≫ pV ≫ sY) := hV'n.1.toLocallyOfFiniteType
  haveI : QuasiCompact (pV' ≫ pV ≫ sY) := hV'n.1.toQuasiCompact
  haveI : CompactSpace V' := QuasiCompact.compactSpace_of_compactSpace (pV' ≫ pV ≫ sY)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hV'n
  haveI : IsSeparated pV' := IsSeparated.of_comp pV' (V ↘ ⊤_ Scheme)
  have hdimV' : topologicalKrullDim V' = 4 := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (pV ≫ sY)
      (pV' ≫ pV ≫ sY) hpV'b, hdimV]
  obtain ⟨c, hcdef⟩ : ∃ c : V' ⟶ Y, c = pV' ≫ pV := ⟨_, rfl⟩
  have hcb : IsBirationalMorphism c := by
    rw [hcdef]; exact MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hpV'b hpVb
  haveI : IsDominant c := hcb.isDominant
  haveI : IsProper c := by rw [hcdef]; infer_instance
  haveI : IsSeparated c := by rw [hcdef]; infer_instance
  have hcs : c ≫ sY = pV' ≫ pV ≫ sY := by rw [hcdef, Category.assoc]
  have hcx : ∀ x, c x = pV (pV' x) := fun x => by rw [hcdef]; rfl
  have hV'nc : IsNormalVariety ℂ (c ≫ sY) := by rw [hcs]; exact hV'n
  have hpbij := hpb.functionFieldMap_bijective
  have hqbij := hqb.functionFieldMap_bijective
  have hpVbij := hpVb.functionFieldMap_bijective
  have hpV'bij := hpV'b.functionFieldMap_bijective
  have hcbij := hcb.functionFieldMap_bijective
  haveI : IsSeparated q := IsSeparated.of_comp q (Y ↘ ⊤_ Scheme)
  have hFval' : ∀ j : Eq, (F j).valuationOver pV = (PWf j).valuationOver q := fun j =>
    (divisorOver_valuation_mk _ _ _).symm.trans ((hFval j).trans (divisorOver_valuation_mk _ _ _))
  have hKYω' : (divisorOfForm ωV).IsCanonicalDivisor sY 4 := by rw [hωVY]; exact hKY
  have hvc : ∀ E : MMP.Mori.PrimeDivisor V', E.valuationOver c = E.valuationOver (pV' ≫ pV) := by
    subst hcdef; intro E; rfl
  -- a common resolution `W'` of `W` and `V'`
  have hWp : MMP.Mori.IsProjectiveVariety ℂ sW := by
    rw [← hR.comp_eq_left]
    exact (AlgebraicGeometry.isProjectiveVariety_iff ℂ (p ≫ sX)).mpr
      ⟨hWnp.1, hR.isProjectiveMorphism_left.comp hX.isProjective⟩
  obtain ⟨ψc, hψc⟩ := RationalMap.IsBirational.exists_isInverse hcb
  obtain ⟨W', _, _, _, r₁, r₂, hr₁v, hr₁sm, hsq', hr₁p, hr₂p, hr₁b, hr₂b, hcomm⟩ :=
    exists_tower_step (T := Y) (sT := sY) hWp hWn hYn hV'n hV'p hqb hR.comp_eq_right
      (f := 𝟙 Y) (fp := c) (Category.id_comp _) hcs hψc.isBirational_inverse
      (compHom_eq_of_isInverse hψc)
  have hrq : r₁ ≫ q = r₂ ≫ c := by simpa using hcomm
  haveI : IsProper r₁ := isProper_of_isProjectiveMorphism r₁ hr₁p
  haveI : IsProper r₂ := isProper_of_isProjectiveMorphism r₂ hr₂p
  haveI : IsDominant r₁ := hr₁b.isDominant
  haveI : IsDominant r₂ := hr₂b.isDominant
  have hW'n : IsNormalVariety ℂ (r₁ ≫ sW) := ⟨hr₁v, inferInstance⟩
  have hW'n₂ : IsNormalVariety ℂ (r₂ ≫ pV' ≫ pV ≫ sY) := by rw [hsq']; exact hW'n
  haveI : LocallyOfFiniteType (r₁ ≫ sW) := hr₁v.toLocallyOfFiniteType
  haveI : QuasiCompact (r₁ ≫ sW) := hr₁v.toQuasiCompact
  haveI : CompactSpace W' := QuasiCompact.compactSpace_of_compactSpace (r₁ ≫ sW)
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hW'n
  haveI : IsSeparated r₁ := IsSeparated.of_comp r₁ (W ↘ ⊤_ Scheme)
  haveI : IsSeparated r₂ := IsSeparated.of_comp r₂ (V' ↘ ⊤_ Scheme)
  have hr₁bij := hr₁b.functionFieldMap_bijective
  have hr₂bij := hr₂b.functionFieldMap_bijective
  have hp'b : IsBirationalMorphism (r₁ ≫ p) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hr₁b hpb
  haveI : IsDominant (r₁ ≫ p) := hp'b.isDominant
  have hp'bij := hp'b.functionFieldMap_bijective
  have hr₁qb : IsBirationalMorphism (r₁ ≫ q) :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hr₁b hqb
  have hr₂cb : IsBirationalMorphism (r₂ ≫ c) := hrq ▸ hr₁qb
  have hr₂pV'b : IsBirationalMorphism (r₂ ≫ pV') :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hr₂b hpV'b
  haveI : IsDominant (r₂ ≫ pV') := hr₂pV'b.isDominant
  have hr₂pV'bij := hr₂pV'b.functionFieldMap_bijective
  have hr₂cbij := hr₂cb.functionFieldMap_bijective
  have hW'np : IsNormalVariety ℂ ((r₁ ≫ p) ≫ sX) := by
    rw [Category.assoc, hR.comp_eq_left]; exact hW'n
  have hexX : ∀ P : MMP.Mori.PrimeDivisor X, ∃ PW : MMP.Mori.PrimeDivisor W',
      (r₁ ≫ p) PW.genericPoint = P.genericPoint := fun P => by
    obtain ⟨PW, hPW, -, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hW'np hp'b P
    exact ⟨PW, hPW⟩
  obtain ⟨e', he'⟩ := id hp'b
  have hH : RationalMap.IsInverse (r₁ ≫ p).toRationalMap e'.symm.toRationalMap :=
    ⟨e', he', rfl⟩
  have hψb : RationalMap.IsBirational (e'.symm.toRationalMap.compHom r₂) :=
    isBirational_compHom_of_isBirationalMorphism e'.symm hr₂b
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  have hpq₀ : p ≫ π = q ≫ πY :=
    MMP.Fourfold.comp_eq_comp_of_isOver π πY hY.isOver p q h hR.isInverse hR.compHom_eq
  have hpq' : (r₁ ≫ p) ≫ π = r₂ ≫ c ≫ πY := by
    rw [Category.assoc, hpq₀, ← Category.assoc, hrq, Category.assoc]
  have hψZ : RationalMap.IsOver π (c ≫ πY) (e'.symm.toRationalMap.compHom r₂) := by
    change (e'.symm.toRationalMap.compHom r₂).compHom (c ≫ πY) = π.toRationalMap
    rw [MMP.Fourfold.Oai4C1.Main.compHom_compHom, ← hpq',
      ← MMP.Fourfold.Oai4C1.Main.compHom_compHom, compHom_eq_of_isInverse hH,
      Scheme.Hom.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
      Scheme.Hom.toPartialMap_compHom, Category.id_comp]
  -- the adjoint of `(V', B_{V'})` is the pull-back of that of `(Y, B_Y)`, hence nef over `Z`
  have hpullc : IsRCartierPullback c (logCanonicalDivisor KY BY) (logCanonicalDivisor KV' BV') := by
    rw [hcdef]; exact isRCartierPullback_comp' (hKBV ▸ hGV) hpullV'
  haveI : IsSeparated sY := hYn.1.toIsSeparated
  haveI : QuasiCompact (c ≫ sY) := by rw [hcs]; infer_instance
  have hnefV' : IsRelativelyNef ℂ (pV' ≫ pV ≫ sY) (c ≫ πY) (logCanonicalDivisor KV' BV') := by
    have := isRelativelyNef_of_isRCartierPullback (k := ℂ) (𝟙 Z) πY (c ≫ πY) c
