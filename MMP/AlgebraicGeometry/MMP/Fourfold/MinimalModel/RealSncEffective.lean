      have h0 := hzero T hTe
      obtain ⟨_, _, h0Y⟩ := isLogDiscrepancy_comp_of_isRCartierPullback hYn hVn hpVb hωV0
        hKYω' hKV₀ω hBVpb _ h0
      have heq0 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq h0Y
        (hlogY BY GY hR.isRCartierPullback_right P)
        ((divisorOver_valuation_mk _ _ _).trans (((hvc T).symm.trans hvT).trans
          (divisorOver_valuation_mk _ _ _).symm))
      have hd := hR.effective (PWf P)
      rw [DivisorWithCoeffs.coeff_sub] at hd
      have hGX := hGXc B GX hR.isRCartierPullback_left P
      have hK := hKWP P
      have hBP := hB1 P
      have hd0 : (GX - GY).coeff (PWf P) = 0 := by
        rw [DivisorWithCoeffs.coeff_sub]; linarith
      have hPexc : RationalMap.IsExceptional φ P := by
        by_contra hne
        rw [← hR.compHom_eq, isExceptional_compHom_iff (hPWtr P) q] at hne
        obtain ⟨G, hG⟩ := exists_primeDivisor_of_not_isExceptional_toRationalMap q hqb (PWf P) hne
        obtain ⟨GV, hGV1, -, -⟩ :=
          MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hYn hVn hpVb G
        have h1 : pV (pV' T.genericPoint) = G.genericPoint := by
          rw [← hcx, ← hTW, ← hcomp r₂ c, ← hrq, hcomp r₁ q, hr₁η, hG]
        exact not_isExceptional_of_transformPrimeDivisor_eq_some
          ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff pV' T GV).mpr
            (eq_of_map_eq_genericPoint pV hpVbij h1 hGV1)) hTe
      have hPEq : P ∈ Eq := (hEqmem P).mpr ⟨hPexc, hd0⟩
      obtain ⟨Fj, hFj, -, -⟩ := MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0}
        hVn hV'n hpV'b (F ⟨P, hPEq⟩)
      have hvFj : Fj.valuationOver c = (PWf P).valuationOver q :=
        (valuationOver_eq_of_comp_eq (g := pV) hpV'bij.2 hcdef.symm hFj).trans (hFval' ⟨P, hPEq⟩)
      have hTF : T = Fj := eq_of_valuationOver_eq hV'n hcbij.2 (hvT.trans hvFj.symm)
      rw [hTF] at hTe
      exact not_isExceptional_of_transformPrimeDivisor_eq_some
        ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff pV' Fj _).mpr hFj) hTe
    · obtain ⟨Q, hQ⟩ := exists_primeDivisor_of_not_isExceptional_toRationalMap pV' hpV'b T hTe
      have hBV'T : BV'.coeff T = BV.coeff Q := by
        rw [hnonexc T hTe]
        have hQT : MMP.Mori.inverseTransformPrimeDivisor pV' Q = some T :=
          (MMP.ProgramBaseChange.inverseTransformPrimeDivisor_eq_some_iff' pV' Q T).2
            ⟨MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal pV' hpV'b
              Q.coheight_genericPoint.le, hQ⟩
        exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hQT (fun Q' hQ' =>
          AlgebraicGeometry.PrimeDivisor.genericPoint_injective
            (((MMP.ProgramBaseChange.inverseTransformPrimeDivisor_eq_some_iff' pV' Q' T).1
              hQ').2.symm.trans hQ)) BV
      rw [hBV'T]
      by_cases hQe : RationalMap.IsExceptional (X := V) pV.toRationalMap Q
      · -- the extracted equality primes keep their coefficients
        obtain ⟨j, rfl⟩ := (hFexc Q).mp hQe
        rw [hBVF j]
        obtain ⟨S, hS, -, -⟩ :=
          MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hWn hW'n hr₁b (PWf j)
        have hv1 : S.valuationOver (r₂ ≫ c) = (PWf j).valuationOver q :=
          valuationOver_eq_of_comp_eq (g := q) hr₁bij.2 hrq hS
        have hv2 : TW.valuationOver (r₂ ≫ c) = (PWf j).valuationOver q :=
          (valuationOver_eq_of_comp_eq (f := r₂ ≫ pV') (g := pV) hr₂pV'bij.2
            (by rw [hcdef, Category.assoc]) (by rw [hcomp r₂ pV', hTW, hQ])).trans (hFval' j)
        have hTS : TW = S := eq_of_valuationOver_eq hW'n hr₂cbij.2 (hv2.trans hv1.symm)
        have hTj := (hiff j).mpr (by
          rw [hTS]
