        MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq htr huniq C
      -- the transforms of `N_Y` along the program, and the floor identity on every model
      let Ns : ∀ k, RDivisor (modelSeq Y Ms k) := fun k =>
        Nat.rec (motive := fun k => RDivisor (modelSeq Y Ms k)) NY
          (fun k Nk => RationalMap.transformDivisor (ψ k) Nk) k
