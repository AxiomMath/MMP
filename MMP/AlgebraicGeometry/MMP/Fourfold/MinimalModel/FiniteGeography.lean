universe u

/-! ### Strict transforms on a common resolution -/

section StrictTransform

private theorem source_ι_comp_eq_of_toRationalMap_eq {X Y : Scheme.{u}} [IsReduced Y]
    [IsSeparated (X ↘ ⊤_ Scheme)] (f : Y ⟶ X) (e : Y.PartialIso X)
    (he : e.toRationalMap = f.toRationalMap) : e.source.ι ≫ f = e.iso.hom ≫ e.target.ι :=
  ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
    (Scheme.PartialMap.toRationalMap_eq_iff.mp he)).symm

private theorem apply_hom_eq_of_isInverse {X Y : Scheme.{u}} [IsReduced Y] [IsReduced X]
    [IsSeparated (X ↘ ⊤_ Scheme)] (f : Y ⟶ X) (e : Y.PartialIso X)
    (he : e.toRationalMap = f.toRationalMap) (g' : X.PartialMap Y)
    (hg' : g'.toRationalMap = e.symm.toRationalMap) {x : X} (hx : x ∈ g'.domain) :
    f (g'.hom ⟨x, hx⟩) = x := by
  have h1 : (g'.compHom f).toRationalMap = (Scheme.PartialMap.id X).toRationalMap := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg', ← Scheme.RationalMap.compHom_toRationalMap,
      Scheme.PartialMap.toRationalMap_eq_iff,
      Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)]
    change e.iso.inv ≫ e.source.ι ≫ f = e.target.ι ≫ 𝟙 X
    rw [source_ι_comp_eq_of_toRationalMap_eq f e he, Iso.inv_hom_id_assoc, Category.comp_id]
  have h2 := MMP.Positivity.PartialMap.hom_apply_eq_of_toRationalMap_eq
    (g := g'.compHom f) (g' := Scheme.PartialMap.id X) h1 hx trivial
  change (g'.hom ≫ f) ⟨x, hx⟩ = (X.topIso.hom ≫ 𝟙 X) ⟨x, trivial⟩ at h2
  refine (Scheme.Hom.comp_apply _ _ _).symm.trans (h2.trans ?_)
  rw [Category.comp_id, Scheme.topIso_hom]
  rfl

/-- A scheme separated over `Spec k` is separated over the terminal scheme. -/
private theorem isSeparated_toTerminal {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [IsSeparated sX] : IsSeparated (X ↘ ⊤_ Scheme) := by
  rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
  infer_instance

/-- **The strict transform on a resolution.** Let `p : W ⟶ X` be a proper birational morphism
of normal varieties with inverse `h`, and `P` a prime divisor of `X`. Then `h` is defined at the
codimension-one point `η_P` (properness of `p`) by some `h'`, and `h'(η_P)` is the generic point
of a prime divisor `E` of `W` with `p(η_E) = η_P`, along which `p` induces an isomorphism of local
rings. -/
private theorem exists_strictTransform {k : Type u} [Field k] {X W : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] (hX : IsNormalVariety k sX) (p : W ⟶ X)
    (h : X.RationalMap W) [IsProper p] (hWnp : IsNormalVariety k (p ≫ sX))
    (hpb : IsBirationalMorphism p) (hinv : RationalMap.IsInverse p.toRationalMap h)
    (P : MMP.Mori.PrimeDivisor X) :
    ∃ (E : MMP.Mori.PrimeDivisor W) (h' : X.PartialMap W) (hP : P.genericPoint ∈ h'.domain),
      h'.toRationalMap = h ∧ E.genericPoint = h'.hom ⟨P.genericPoint, hP⟩ ∧
      p E.genericPoint = P.genericPoint ∧ IsIso (p.stalkMap E.genericPoint) := by
  have := hX.1
  have := hWnp.1
  have : IsDominant p := hpb.isDominant
  have := isSeparated_toTerminal sX
  have : IsSeparated p := IsSeparated.of_comp p sX
  obtain ⟨E, heq, hiso, -⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{u, 0} hX hWnp hpb P
  obtain ⟨e, he1, he2⟩ := id hinv
  have hhp : h.compHom p = Scheme.Hom.toRationalMap (𝟙 X) := by
    rw [← he2, ← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff,
      Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)]
    change e.iso.inv ≫ e.source.ι ≫ p = e.target.ι ≫ 𝟙 X
    rw [source_ι_comp_eq_of_toRationalMap_eq p e he1, Iso.inv_hom_id_assoc, Category.comp_id]
  obtain ⟨h', hh'P, hh'⟩ := Scheme.RationalMap.mem_domain.mp
    (MMP.Flips.RationalMap.mem_domain_of_coheight_le_one (𝟙 X) p h hhp
      P.coheight_genericPoint.le)
  have hpw : p (h'.hom ⟨P.genericPoint, hh'P⟩) = P.genericPoint :=
    apply_hom_eq_of_isInverse p e he1 h' (hh'.trans he2.symm) hh'P
  haveI : ValuationRing (X.presheaf.stalk P.genericPoint) := by
    haveI := P.isDiscreteValuationRing_localRing
    exact inferInstanceAs (ValuationRing P.localRing)
  haveI : ValuationRing (X.presheaf.stalk (p E.genericPoint)) := by rw [heq]; infer_instance
  haveI : ValuationRing (X.presheaf.stalk (p (h'.hom ⟨P.genericPoint, hh'P⟩))) := by
    rw [hpw]; infer_instance
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing p hpb.functionFieldMap_bijective
    (h'.hom ⟨P.genericPoint, hh'P⟩)
  exact ⟨E, h', hh'P, hh', MMP.Positivity.eq_of_isIso_stalkMap p hpb.functionFieldMap_bijective
    (hpw.trans heq.symm), heq, hiso⟩

private theorem transformPrimeDivisor_eq_some_of_genericPoint_eq {X Y : Scheme.{u}} [IsReduced X]
    [IsSeparated (Y ↘ ⊤_ Scheme)] {φ : X.RationalMap Y} {P : MMP.Mori.PrimeDivisor X}
    {E : MMP.Mori.PrimeDivisor Y} (g' : X.PartialMap Y) (hg' : g'.toRationalMap = φ)
    (hP : P.genericPoint ∈ g'.domain) (hE : E.genericPoint = g'.hom ⟨P.genericPoint, hP⟩) :
    MMP.Mori.RationalMap.transformPrimeDivisor φ P = some E := by
  refine MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mpr
    ⟨MMP.Mori.RationalMap.definedAt_iff.mpr ⟨g', hP, hg'⟩, ?_⟩
  have h1 : MMP.Mori.RationalMap.transform φ P.idealSheaf.support = E.idealSheaf.support := by
    apply SetLike.coe_injective
    rw [MMP.Flips.coe_transform_eq_closure_singleton g' hg' P hP, ← hE]
    exact (AlgebraicGeometry.PrimeDivisor.support_eq_closure E).symm
  have := E.integral
  rw [MMP.Mori.RationalMap.transformIdeal, h1, MMP.Positivity.vanishingIdeal_support_of_isReduced]

/-- **The inverse of a resolution sends a prime divisor to its strict transform.** For a proper
birational morphism `p : W ⟶ X` of normal varieties with inverse `h`, the birational transform
under `h` of a prime divisor `P` of `X` is the prime divisor `E` of `W` with `p(η_E) = η_P`, along
which `p` induces an isomorphism of local rings. -/
private theorem exists_transformPrimeDivisor_eq_some_of_isInverse {k : Type u} [Field k]
    {X W : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (hX : IsNormalVariety k sX) (p : W ⟶ X) (h : X.RationalMap W) [IsProper p]
    (hWnp : IsNormalVariety k (p ≫ sX)) (hpb : IsBirationalMorphism p)
    (hinv : RationalMap.IsInverse p.toRationalMap h) (P : MMP.Mori.PrimeDivisor X) :
    ∃ E : MMP.Mori.PrimeDivisor W, MMP.Mori.RationalMap.transformPrimeDivisor h P = some E ∧
      p E.genericPoint = P.genericPoint ∧ IsIso (p.stalkMap E.genericPoint) := by
  have := hX.1
  have := hWnp.1
  have := isSeparated_toTerminal (p ≫ sX)
  obtain ⟨E, h', hh'P, hh', hwE, heq, hiso⟩ := exists_strictTransform hX p h hWnp hpb hinv P
  exact ⟨E, transformPrimeDivisor_eq_some_of_genericPoint_eq h' hh' hh'P hwE, heq, hiso⟩

end StrictTransform

/-! ### Points over generic points of prime divisors -/

section GenericPoints

variable {U V : Scheme.{u}} [IsIntegral U] [IsLocallyNoetherian U] [IsNormal U] [IsIntegral V]

/-- A dominant morphism inducing an isomorphism of function fields induces an isomorphism of
local rings at every point lying over the generic point of a prime divisor. -/
private theorem isIso_stalkMap_of_eq_genericPoint (f : V ⟶ U) [IsDominant f]
    (hf : Function.Bijective (functionFieldMap f)) {x : V} {Q : MMP.Mori.PrimeDivisor U}
    (hx : f x = Q.genericPoint) : IsIso (f.stalkMap x) := by
  haveI : ValuationRing (U.presheaf.stalk Q.genericPoint) := by
    haveI := Q.isDiscreteValuationRing_localRing
    exact inferInstanceAs (ValuationRing Q.localRing)
  haveI : ValuationRing (U.presheaf.stalk (f x)) := by rw [hx]; infer_instance
  exact MMP.Positivity.isIso_stalkMap_of_valuationRing f hf x

/-- For a separated dominant morphism inducing an isomorphism of function fields, at most one
point lies over the generic point of a prime divisor. -/
private theorem eq_of_map_eq_genericPoint (f : V ⟶ U) [IsSeparated f] [IsDominant f]
    (hf : Function.Bijective (functionFieldMap f)) {x y : V} {Q : MMP.Mori.PrimeDivisor U}
    (hx : f x = Q.genericPoint) (hy : f y = Q.genericPoint) : x = y := by
  haveI := isIso_stalkMap_of_eq_genericPoint f hf hx
  haveI := isIso_stalkMap_of_eq_genericPoint f hf hy
  haveI : ValuationRing (U.presheaf.stalk Q.genericPoint) := by
    haveI := Q.isDiscreteValuationRing_localRing
    exact inferInstanceAs (ValuationRing Q.localRing)
  haveI : ValuationRing (U.presheaf.stalk (f x)) := by rw [hx]; infer_instance
  exact MMP.Positivity.eq_of_isIso_stalkMap f hf (hy.trans hx.symm)

end GenericPoints

/-! ### Transforms under a composite with a morphism -/

section CompHom

variable {X V Y : Scheme.{u}} [IsReduced X] [IsReduced V] [IsSeparated (V ↘ ⊤_ Scheme)]
  [IsSeparated (Y ↘ ⊤_ Scheme)]

/-- If `h : X ⤏ V` sends the prime divisor `P` to `P'`, then `q ∘ h` sends `P` where the
morphism `q` sends `P'`. -/
private theorem transformPrimeDivisor_compHom {h : X.RationalMap V} {P : MMP.Mori.PrimeDivisor X}
    {P' : MMP.Mori.PrimeDivisor V} (hP : MMP.Mori.RationalMap.transformPrimeDivisor h P = some P')
    (q : V ⟶ Y) :
    MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P =
      MMP.Mori.RationalMap.transformPrimeDivisor (X := V) q.toRationalMap P' := by
  obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
  obtain ⟨g', hg'P, hg'⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
  have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g' hg' hg'P
  have hrep : (g'.compHom q).toRationalMap = h.compHom q := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg']
  refine Option.ext fun F => ?_
  rw [MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]
  constructor
  · intro h1
    have h2 := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h1 (g'.compHom q) hrep
      hg'P
    rw [h2, hη]
    rfl
  · intro h1
    refine transformPrimeDivisor_eq_some_of_genericPoint_eq (g'.compHom q) hrep hg'P ?_
    rw [← h1, hη]
    rfl

/-- If `h : X ⤏ V` sends the prime divisor `P` to `P'`, then `P` is exceptional for `q ∘ h`
exactly when `P'` is exceptional for the morphism `q`. -/
private theorem isExceptional_compHom_iff {h : X.RationalMap V} {P : MMP.Mori.PrimeDivisor X}
    {P' : MMP.Mori.PrimeDivisor V} (hP : MMP.Mori.RationalMap.transformPrimeDivisor h P = some P')
    (q : V ⟶ Y) :
    MMP.Mori.RationalMap.IsExceptional (h.compHom q) P ↔
      MMP.Mori.RationalMap.IsExceptional (X := V) q.toRationalMap P' := by
  obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
  obtain ⟨g', hg'P, hg'⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
  have hη := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g' hg' hg'P
  have hrep : (g'.compHom q).toRationalMap = h.compHom q := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg']
  have hdef1 : MMP.Mori.RationalMap.DefinedAt (h.compHom q) P.genericPoint :=
    MMP.Mori.RationalMap.definedAt_iff.mpr ⟨g'.compHom q, hg'P, hrep⟩
  have hdef2 : MMP.Mori.RationalMap.DefinedAt (X := V) q.toRationalMap P'.genericPoint := by
    rw [MMP.Mori.RationalMap.DefinedAt, MMP.Mori.RationalMap.dom_toRationalMap_hom]
    trivial
  have htr : MMP.Mori.RationalMap.transform (h.compHom q) P.idealSheaf.support =
      MMP.Mori.RationalMap.transform (X := V) q.toRationalMap P'.idealSheaf.support := by
    apply SetLike.coe_injective
    rw [MMP.Flips.coe_transform_eq_closure_singleton (g'.compHom q) hrep P hg'P,
      MMP.Flips.coe_transform_eq_closure_singleton q.toPartialMap rfl P' trivial]
    congr 2
    change q (g'.hom ⟨P.genericPoint, hg'P⟩) = q P'.genericPoint
    rw [hη]
  rw [MMP.Mori.RationalMap.isExceptional_iff, MMP.Mori.RationalMap.isExceptional_iff, htr]
  exact ⟨fun h1 _ => h1 hdef1, fun h1 _ => h1 hdef2⟩

end CompHom

section LogResolutionTest

open MMP.Mori TopologicalSpace

/-- A prime divisor whose generic point lies on a prime divisor `E` is `E`: both generic points
have coheight one, so the specialization `η_E ⤳ η_F` is an equality. -/
private theorem eq_of_genericPoint_mem_support {Y : Scheme.{u}} {E F : MMP.Mori.PrimeDivisor Y}
    (hF : F.genericPoint ∈ E.support) : F = E := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hF
  have hs : E.genericPoint ⤳ F.genericPoint := specializes_iff_mem_closure.mpr hF
  by_contra hne
  have := Order.coheight_add_one_le (a := E.genericPoint) (b := F.genericPoint) ?_
  · rw [E.coheight_genericPoint, F.coheight_genericPoint] at this
    norm_num at this
  · refine lt_of_le_not_ge hs fun h' => hne ?_
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (Inseparable.eq (Specializes.antisymm (h' : F.genericPoint ⤳ E.genericPoint) hs))

/-- **The centre of a divisorial valuation on a proper model.** Let `π : W ⟶ X` be a proper
dominant morphism of integral schemes and `D` a divisor over `X`. A valuation `ξ` of `k(W)`
restricting to `ord_D` on `k(X)` dominates the local ring of some point of `W`. -/
private theorem exists_dominated_point {k : Type u} [Field k] {X W : Scheme.{u}} [IsIntegral X]
    [IsIntegral W] {sX : X ⟶ Spec (.of k)} (π : W ⟶ X) [IsDominant π] (hπ : IsProper π)
    (D : DivisorOver k sX) (ξ : Valuation W.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ.comap (functionFieldMap π) = D.valuation) :
    ∃ x : W, (∀ a : W.presheaf.stalk x, ξ (algebraMap _ W.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk x),
        ξ (algebraMap _ W.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  have hw : ∀ b : X.presheaf.stalk y,
      ξ (functionFieldMap π (algebraMap _ X.functionField b)) =
        D.valuation (algebraMap _ X.functionField b) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ X.functionField b)) h
    simpa only [Valuation.comap_apply] using this
  let R := ξ.valuationSubring
  let φ : X.presheaf.stalk y →+* R :=
    ((functionFieldMap π).comp (algebraMap (X.presheaf.stalk y) X.functionField)).codRestrict R
      fun b => (ξ.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint X ⤳ y := (genericPoint_spec X).specializes trivial
  have hex : ValuativeCriterion.Existence π := by
    have h : @IsProper _ _ π := hπ
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq π :=
    { R := R
      K := W.functionField
      i₁ := W.fromSpecStalk (genericPoint W)
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ X.fromSpecStalk y
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk π,
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R W.functionField)) ≫ l =
      W.fromSpecStalk (genericPoint W) := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint W ⤳ x := (genericPoint_spec W).specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R W.functionField) =
      W.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (W.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : W.presheaf.stalk x,
      algebraMap _ W.functionField a = ((f.hom a : R) : W.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]; exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

end LogResolutionTest

section KltPerturbation

open MMP.Mori

/-! ### Real snc pairs with coefficients less than one are klt -/

section RealSNC

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
  {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- A log discrepancy of a klt pair with rational boundary is positive. -/
private theorem pos_of_isLogDiscrepancy_of_isKltPair (hX : IsNormalVariety k sX) {n : ℕ}
    {K : Divisor X} {Δ : QDivisor X} (hklt : MMP.Mori.IsKltPair sX n K Δ) {n' : ℕ}
    {D : DivisorOver k sX} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n' (QDivisor.toRDivisor Δ) D a) : 0 < a := by
  have hP : MMP.Mori.IsPair sX Δ := hklt.1.isPair
  have hK : K.IsCanonicalDivisor sX n := hklt.1.2.1
  obtain rfl : n' = n := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  by_cases hE : D.IsExceptional
  · obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
    rw [MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc ha]
    have h1 := hklt.2.1.trans_le (discrep_le hE hc)
    have h2 : (-1 : ℝ) < c := by exact_mod_cast (EReal.coe_lt_coe_iff.mp h1)
    linarith
  · obtain ⟨P, hv⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX D hE
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
      (DivisorOver.ofPrimeDivisor k hX P)
    have hb := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 X) from inferInstance)
    rw [MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hb hv,
      IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc]
    have h1 : Δ.coeff P < 1 := roundDown_nonpos_iff.mp hklt.2.2 P
    have : (0 : ℚ) < 1 + -Δ.coeff P := by linarith
    exact_mod_cast this

open Classical in
/-- Sums over the prime divisors of a finite set, written through `Fin`. -/
private theorem sum_equivFin_mul_single (S : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (Γ : MMP.Mori.PrimeDivisor X) :
    ∑ i : Fin S.card, c (S.equivFin.symm i) *
        (((Finsupp.single (S.equivFin.symm i : MMP.Mori.PrimeDivisor X) (1 : ℤ)) Γ : ℤ) : ℝ) =
      if Γ ∈ S then c Γ else 0 := by
  rw [Equiv.sum_comp S.equivFin.symm (fun x : S => c x *
    (((Finsupp.single (x : MMP.Mori.PrimeDivisor X) (1 : ℤ)) Γ : ℤ) : ℝ))]
  rw [Finset.sum_coe_sort S (fun x => c x * (((Finsupp.single x (1 : ℤ)) Γ : ℤ) : ℝ))]
  simp only [Finsupp.single_apply]
  split_ifs with h
  · rw [Finset.sum_eq_single Γ]
    · simp
    · intro b _ hb; simp [hb]
    · intro h'; exact absurd h h'
  · refine Finset.sum_eq_zero fun b hb => ?_
    have : b ≠ Γ := fun h' => h (h' ▸ hb)
    simp [this]

/-- **Real snc pairs are klt.** On a smooth variety `X` over an algebraically closed field of
characteristic zero, an effective `ℝ`-divisor `Δ` whose support lies in a finite set `S` of prime
divisors with `∑_{E ∈ S} E` simple normal crossing, and whose coefficients are less than one, is
a klt boundary. The log discrepancies of `Δ` dominate those of the rational snc boundary
`q ∑_{E ∈ S} E`, for a rational `q < 1` above every coefficient of `Δ`. -/
private theorem isRealKltPair_of_isSNC (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {Δ : RDivisor X}
    (S : Finset (MMP.Mori.PrimeDivisor X)) (hS : Δ.support ⊆ S)
    (hsnc : DivisorWithCoeffs.IsSNC sX (∑ E ∈ S, Finsupp.single E (1 : ℤ)))
    (h0 : ∀ P, 0 ≤ Δ.coeff P) (h1 : ∀ P, Δ.coeff P < 1) : IsRealKltPair sX Δ := by
  classical
  have hΔS : ∀ Γ, Γ ∉ S → Δ.coeff Γ = 0 := fun Γ hΓ => by
    by_contra h
    exact hΓ (hS (Finsupp.mem_support_iff.mpr h))
  -- the presentation `K + ∑_{E ∈ S} c_E E` by Cartier divisors
  let e : Fin S.card → MMP.Mori.PrimeDivisor X := fun i => S.equivFin.symm i
  let C : Fin (S.card + 1) → Divisor X :=
    Fin.cons K (fun i => (Finsupp.single (e i) (1 : ℤ) : Divisor X))
  have hC : ∀ i, (C i).IsCartier := fun i => MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  let r : (MMP.Mori.PrimeDivisor X → ℝ) → Fin (S.card + 1) → ℝ :=
    fun c => Fin.cons 1 (fun i => c (e i))
  have hpres : ∀ (c : MMP.Mori.PrimeDivisor X → ℝ) (Γ : MMP.Mori.PrimeDivisor X),
      ∑ i, r c i * ((C i).coeff Γ : ℝ) = K.coeff Γ + if Γ ∈ S then c Γ else 0 := by
    intro c Γ
    rw [Fin.sum_univ_succ]
    simp only [r, C, Fin.cons_zero, Fin.cons_succ, one_mul, DivisorWithCoeffs.coeff_apply]
    rw [sum_equivFin_mul_single S c Γ]
  refine ⟨hX, h1, ⟨n, K, hK, S.card + 1, r Δ.coeff, C, hC, fun Γ => ?_⟩, ?_⟩
  · rw [hpres]
    change ((K.coeff Γ : ℤ) : ℝ) + Δ.coeff Γ = _
    split_ifs with h
    · rfl
    · rw [hΔS Γ h]
  intro n' D a ha
  obtain rfl : n' = n := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have : CompactSpace D.Y := by
    have := D.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (D.f ≫ sX)
  have hf : IsProper D.f := ha.2.1
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  choose C' hC' using fun i => MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f (hC i)
  -- the log discrepancy of a boundary supported in `S`, through this presentation
  have hb : ∀ B : RDivisor X, (∀ Γ, Γ ∉ S → B.coeff Γ = 0) →
      MMP.Intersection.IsLogDiscrepancy sX n' B D
        (1 + (D.ordPullback ω : ℝ) - ∑ i, r B.coeff i * ((C' i).coeff D.E : ℝ)) := by
    intro B hB
    refine ⟨hX, hf, ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, S.card + 1, r B.coeff, C, C', hC,
      fun Γ => ?_, fun i => ⟨_, hC' i⟩, rfl⟩
    rw [hpres, hω Γ]
    split_ifs with h
    · rfl
    · rw [hB Γ h]
  have haΔ := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha (hb Δ hΔS)
  -- a rational `q < 1` above every coefficient of `Δ`
  obtain ⟨t, ht1, ht⟩ : ∃ t : ℝ, t < 1 ∧ ∀ P ∈ S, Δ.coeff P ≤ t := by
    refine ⟨(insert 0 (S.image Δ.coeff)).max' (Finset.insert_nonempty _ _), ?_, fun P hP =>
      Finset.le_max' _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hP))⟩
    refine (Finset.max'_lt_iff _ _).mpr fun y hy => ?_
    rcases Finset.mem_insert.mp hy with rfl | hy
    · exact one_pos
    · obtain ⟨P, -, rfl⟩ := Finset.mem_image.mp hy
      exact h1 P
  obtain ⟨q, hq0, hq1⟩ := exists_rat_btwn (max_lt ht1 one_pos : max t 0 < 1)
  have hqt : t < q := (le_max_left _ _).trans_lt hq0
  have hq0' : (0 : ℝ) < q := (le_max_right _ _).trans_lt hq0
  let Δq : QDivisor X := ∑ E ∈ S, Finsupp.single E (q : ℚ)
  have hΔq : ∀ Γ, Δq.coeff Γ = if Γ ∈ S then (q : ℚ) else 0 := fun Γ => by
    simp only [Δq, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.single_apply]
    rw [Finset.sum_ite_eq']
  have hΔqR : ∀ Γ, Γ ∉ S → (QDivisor.toRDivisor Δq).coeff Γ = 0 := fun Γ hΓ => by
    rw [QDivisor.coeff_toRDivisor, hΔq, if_neg hΓ, Rat.cast_zero]
  -- the rational snc boundary `q ∑_{E ∈ S} E` is klt
  have hsuppS : ∀ E ∈ S, E ∈ (∑ E ∈ S, Finsupp.single E (1 : ℤ)).support := fun E hE => by
    rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
    simp only [Finsupp.single_apply]
    rw [Finset.sum_ite_eq', if_pos hE]
    exact one_ne_zero
  have hsncq : Δq.IsSNC sX := hsnc.of_support_subset fun E hE => by
    refine hsuppS E ?_
    by_contra h
    exact (Finsupp.mem_support_iff.mp hE) (by rw [← DivisorWithCoeffs.coeff_apply, hΔq, if_neg h])
  have hklt := MMP.Mori.isKltPair_of_isSNC sX hX hsm hK hsncq fun E => by
    rw [hΔq]
    split_ifs
    · exact_mod_cast hq1
    · exact zero_lt_one
  have hposq := pos_of_isLogDiscrepancy_of_isKltPair hX hklt (hb _ hΔqR)
  -- comparison of the two log discrepancies
  rw [haΔ]
  refine lt_of_lt_of_le hposq ?_
  rw [sub_le_sub_iff_left, Fin.sum_univ_succ, Fin.sum_univ_succ]
  simp only [r, Fin.cons_zero, Fin.cons_succ]
  refine add_le_add_right (Finset.sum_le_sum fun i _ => ?_) _
  have hc0 : (0 : ℝ) ≤ ((C' i.succ).coeff D.E : ℝ) := by
    have hnn := MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (hC i.succ)
      (V := ⊤) (fun P _ => ?_) (hC' i.succ) D.E ((D.E.genericPoint_mem_iff _).mp trivial)
    · exact_mod_cast hnn
    · simp only [C, Fin.cons_succ, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
      split_ifs <;> norm_num
  have hle : Δ.coeff (e i) ≤ ((QDivisor.toRDivisor Δq).coeff (e i)) := by
    rw [QDivisor.coeff_toRDivisor, hΔq, if_pos (S.equivFin.symm i).2]
    exact (ht _ (S.equivFin.symm i).2).trans hqt.le
  exact mul_le_mul_of_nonneg_right hle hc0

end RealSNC

end KltPerturbation

section CrepantInputs

open MMP.Flips
open scoped WithZero

/-! ### Log discrepancies and discrepancies -/

section Discrepancy

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]

/-- A discrepancy computed with a form whose divisor is canonical gives the log discrepancy
`1 + a`. -/
private theorem isLogDiscrepancy_of_isDiscrepancyWith {n : ℕ} {D : RDivisor X}
    {ω : RationalPluriForms sX n 1} {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X}
    {E : ProperDivisorOver k sX} {b : ℝ} (hK : (divisorOfForm ω).IsCanonicalDivisor sX n)
    (h : IsDiscrepancyWith sX n D ω r L E b) :
    MMP.Intersection.IsLogDiscrepancy sX n D E.toDivisorOver (1 + b) := by
  obtain ⟨hX, hn, hω, hLc, hsum, L', hpb, rfl⟩ := h
  refine ⟨hX, E.isProper, ω, hω, ⟨divisorOfForm ω, hK, fun Γ => coeff_divisorOfForm ω Γ⟩, m, r,
    L, L', hLc, fun Γ => ?_, hpb, by ring⟩
  have := congrArg (fun D : RDivisor X => D.coeff Γ) hsum
  simpa only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor, coeff_divisorOfForm,
    MMP.Flips.coeff_sum_smul_toRDivisor] using this

/-- With a presentation of `div(ω) + D` by Cartier divisors, every divisor over `X` (with proper
model) has a discrepancy computed with these choices. -/
private theorem exists_isDiscrepancyWith (hX : IsNormalVariety k sX) {n : ℕ}
    (hn : topologicalKrullDim X = n) {D : RDivisor X} {ω : RationalPluriForms sX n 1}
    (hω : ω ≠ 0) {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} (hLc : ∀ j, (L j).IsCartier)
    (hsum : Divisor.toRDivisor (divisorOfForm ω) + D = ∑ j, r j • Divisor.toRDivisor (L j))
    (E : ProperDivisorOver k sX) : ∃ b, IsDiscrepancyWith sX n D ω r L E b := by
  haveI := E.isIntegral
  haveI := E.isNormal
  haveI := E.isLocallyNoetherian
  haveI := E.isDominant
  haveI := E.isProper
  haveI : CompactSpace E.Y := QuasiCompact.compactSpace_of_compactSpace E.f
  choose L' hL' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant E.f (hLc j)
  exact ⟨_, hX, hn, hω, hLc, hsum, L', fun j => ⟨_, hL' j⟩, rfl⟩

/-- The valuation of a divisor over `X` with proper model has nonempty center. -/
private theorem hasNonemptyCenter_valuation (E : ProperDivisorOver k sX) :
    HasNonemptyCenter k sX E.valuation := by
  haveI := E.isIntegral
  haveI := E.isNormal
  haveI := E.isLocallyNoetherian
  haveI := E.isDominant
  exact ⟨⟨E.Y, E.f ≫ sX, E.isNormalVariety, E.E,
    functionFieldAlgEquiv sX E.f E.isBirationalMorphism.functionFieldMap_bijective, rfl⟩, E, rfl⟩

end Discrepancy

/-! ### Changing the structure morphism -/

section StructureMorphism

variable {k : Type u} [Field k] {W : Scheme.{u}} [IsIntegral W] [IsLocallyNoetherian W]
  [IsNormal W] [CompactSpace W]

private theorem isDiscrepancy_of_eq {s s' : W ⟶ Spec (.of k)} (h : s = s')
    [LocallyOfFiniteType s] [LocallyOfFiniteType s'] {n : ℕ} {K : Divisor W} {D : RDivisor W}
    {v : Valuation W.functionField ℤᵐ⁰} {a : ℝ} (ha : MMP.Flips.IsDiscrepancy s n K D v a) :
    MMP.Flips.IsDiscrepancy s' n K D v a := by
  subst h
  exact ha

omit [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] in
private theorem exists_properDivisorOver_of_eq {s s' : W ⟶ Spec (.of k)} (h : s = s')
    (E : ProperDivisorOver k s) : ∃ E' : ProperDivisorOver k s', E'.valuation = E.valuation := by
  subst h
  exact ⟨E, rfl⟩

end StructureMorphism

/-! ### Lifting a divisor over `M` to a proper model `W ⟶ M` -/

section Lift

variable {k : Type u} [Field k] {M W : Scheme.{u}} [IsIntegral M] [IsIntegral W]
  {sM : M ⟶ Spec (.of k)}

variable [IsLocallyNoetherian M] [IsNormal M] [IsLocallyNoetherian W] [IsNormal W]

/-- **Lifting a divisor over `M` along a proper birational morphism.** Every divisor `D` over `M`
with proper model has the valuation `ord_E ∘ q^*` of a divisor `E` over `W`, for `q : W ⟶ M`
proper birational with `W` a variety. -/
private theorem exists_properDivisorOver_comap_eq (q : W ⟶ M) [IsProper q]
    (hq : IsBirationalMorphism q) [AlgebraicGeometry.IsVariety k (q ≫ sM)]
    (D : ProperDivisorOver k sM) :
    haveI := hq.isDominant
    ∃ E : ProperDivisorOver k (q ≫ sM),
      E.valuation.comap (functionFieldMap q) = D.valuation := by
  haveI := hq.isDominant
  haveI := D.isIntegral
  haveI := D.isNormal
  haveI := D.isLocallyNoetherian
  haveI := D.isDominant
  have hbq := hq.functionFieldMap_bijective
  let eq := RingEquiv.ofBijective (functionFieldMap q) hbq
  let ξ : Valuation W.functionField ℤᵐ⁰ := D.valuation.comap eq.symm.toRingHom
  have hξ : ξ.comap (functionFieldMap q) = D.valuation := by
    ext a
    change D.valuation (eq.symm (functionFieldMap q a)) = D.valuation a
    rw [show functionFieldMap q a = eq a from rfl, RingEquiv.symm_apply_apply]
  obtain ⟨x, hle, hlt⟩ := exists_dominated_point q ‹_› D.toDivisorOver ξ hξ
  have hdiv : IsDivisorOfFunctionField k (q ≫ sM) ξ := by
    refine ⟨D.Y, D.f ≫ sM, D.isNormalVariety, D.E, ?_⟩
    letI := functionFieldAlgebra sM
    letI := functionFieldAlgebra (q ≫ sM)
    letI := functionFieldAlgebra (D.f ≫ sM)
    let eP := functionFieldAlgEquiv sM q hbq
    let eY := functionFieldAlgEquiv sM D.f D.isBirationalMorphism.functionFieldMap_bijective
    refine ⟨eP.symm.trans eY, ?_⟩
    ext t
    obtain ⟨s, rfl⟩ := hbq.2 t
    change D.valuation (eq.symm (functionFieldMap q s)) =
      D.E.divisorialValuation (eY (eP.symm (functionFieldMap q s)))
    have h1 : eP.symm (functionFieldMap q s) = s := eP.symm_apply_apply s
    rw [h1, show functionFieldMap q s = eq s from rfl, RingEquiv.symm_apply_apply]
    rfl
  obtain ⟨E, -, hv, -⟩ := exists_properDivisorOver_isProjective_of_dominates (q ≫ sM) hdiv x hle hlt
  exact ⟨E, by rw [hv, hξ]⟩

end Lift

/-! ### Compatible forms -/

section Forms

variable {k : Type u} [Field k] [PerfectField k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]

open MMP.Positivity in
/-- For a proper birational morphism `f : Y → X` of normal varieties of dimension `n` and a
canonical divisor `K_Y` of `Y`, there is a nonzero rational top form `ω` on `X` with
`div_Y(f^*ω) = K_Y` and `div_X(ω) = f_* K_Y`. -/
private theorem exists_divisorOfForm_eq_transformDivisor (hX : IsNormalVariety k sX) {f : Y ⟶ X}
    [LocallyOfFiniteType (f ≫ sX)] (hY : IsNormalVariety k (f ≫ sX)) [IsProper f]
    (hf : IsBirationalMorphism f) [IsDominant f] {n : ℕ} (hn : topologicalKrullDim X = n)
    {KY : Divisor Y} (hKY : KY.IsCanonicalDivisor (f ≫ sX) n) :
    ∃ ω : RationalPluriForms sX n 1, ω ≠ 0 ∧
      divisorOfForm ω = RationalMap.transformDivisor (X := Y) f.toRationalMap KY ∧
      divisorOfForm (pullbackRationalPluriForms sX f ω) = KY := by
  have hbij := hf.functionFieldMap_bijective
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨ω₁, hω₁0, hω₁⟩ := IsCanonicalDivisor.exists_ordForm_eq hY hKY
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldMapAlgebra f
  have := isScalarTower_functionFieldMap sX f
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX f hbij hd
  obtain ⟨g, hg⟩ := hbij.2
    ((ZTensorPower.basis (basisOfSpanSingleton hω.2.1 hω.2.2) 1).repr ω₁ ())
  let τ : RationalPluriForms sX n 1 :=
    g • ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) 1 ()
  have hpull : pullbackRationalPluriForms sX f τ = ω₁ := by
    change pullbackForms (K := X.functionField) (K' := Y.functionField) 1 τ = ω₁
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp only [τ, map_smul, Module.Basis.repr_self, Finsupp.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul, mul_one]
    change functionFieldMap f g • _ = ω₁
    rw [hg]
    exact basis_unit_repr_smul _ ω₁
  refine ⟨τ, fun h0 => hω₁0 ?_, Finsupp.ext fun P => ?_, Finsupp.ext fun Γ => ?_⟩
  · rw [← hpull, h0]
    change pullbackForms (K := X.functionField) (K' := Y.functionField) 1 0 = 0
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp
  · obtain ⟨E, heq, hiso, htr⟩ := exists_isIso_stalkMap_forall_transformDivisor_apply hX hY hf P
    rw [htr]
    change P.ordForm τ = KY.coeff E
    rw [← ordForm_pullbackRationalPluriForms_of_isIso f hbij hd E P heq τ, hpull, hω₁]
  · change Γ.ordForm _ = KY.coeff Γ
    rw [hpull, hω₁]

end Forms

/-! ### Comparison of log discrepancies along a common resolution -/

section Comparison

variable {k : Type u} [Field k] [PerfectField k]

/-- **Adding an effective `ℝ`-Cartier divisor lowers discrepancies.** If `a` is the discrepancy
of a valuation `v` with respect to `D` and `D' ≥ 0` is `ℝ`-Cartier, the discrepancy with respect
to `D + D'` is some `a' ≤ a`. -/
private theorem exists_le_isDiscrepancy_add {W : Scheme.{u}} {sW : W ⟶ Spec (.of k)}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]
    [LocallyOfFiniteType sW] {n : ℕ} {K : Divisor W} {D : RDivisor W}
    {v : Valuation W.functionField ℤᵐ⁰} {a : ℝ} (h : IsDiscrepancy sW n K D v a)
    {D' : RDivisor W} (hD' : RDivisor.IsRCartier D') (h0 : 0 ≤ D') :
    ∃ a', a' ≤ a ∧ IsDiscrepancy sW n K (D + D') v a' := by
  obtain ⟨hK, ⟨m, r, L, hL, hKD⟩, hc, E₀, ω₀, m₀, r₀, L₀, hE₀, hdiv₀, hw₀⟩ := h
  obtain ⟨hX, hn, hω, hLc, hsum, L', hpb, rfl⟩ := hw₀
  obtain ⟨m', r', C, hC, hD'eq⟩ := hD'
  have hD'eq' : D' = ∑ j, r' j • Divisor.toRDivisor (C j) := by
    ext Γ
    exact (hD'eq Γ).trans (MMP.Flips.coeff_sum_smul_toRDivisor r' C Γ).symm
  haveI := E₀.isIntegral
  haveI := E₀.isNormal
  haveI := E₀.isLocallyNoetherian
  haveI := E₀.isDominant
  haveI := E₀.isProper
  haveI : CompactSpace E₀.Y := QuasiCompact.compactSpace_of_compactSpace E₀.f
  choose C' hC' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant E₀.f (hC j)
  have hG : IsRCartierPullback E₀.f D' (∑ j, r' j • Divisor.toRDivisor (C' j)) :=
    ⟨m', r', C, C', hC, hD'eq', fun j => ⟨_, hC' j⟩, rfl⟩
  have hG0 := (MMP.Fourfold.isEffective_of_isRCartierPullback E₀.f
    ⟨m', r', C, hC, hD'eq⟩ h0).2 _ hG
  have hnn : (0 : ℝ) ≤ ∑ j, r' j * ((C' j).coeff E₀.E : ℝ) := by
    have := hG0 E₀.E
    change (0 : ℝ) ≤ DivisorWithCoeffs.coeff (∑ j, r' j • Divisor.toRDivisor (C' j)) E₀.E at this
    rwa [MMP.Flips.coeff_sum_smul_toRDivisor] at this
  refine ⟨(E₀.toDivisorOver.ordPullback ω₀ : ℝ) - ∑ j, r₀ j * (L' j).coeff E₀.E -
    ∑ j, r' j * ((C' j).coeff E₀.E : ℝ), by linarith, hK, ⟨m + m', Fin.append r r',
      Fin.append L C, Fin.addCases (by simpa using hL) (by simpa using hC), ?_⟩, hc, E₀, ω₀,
      m₀ + m', Fin.append r₀ r', Fin.append L₀ C, hE₀, hdiv₀, hX, hn, hω,
      Fin.addCases (by simpa using hLc) (by simpa using hC), ?_, Fin.append L' C',
      Fin.addCases (by simpa using hpb) (by simpa using fun j =>
        (⟨_, hC' j⟩ : ∃ hB, (C j).IsPullback E₀.f hB (C' j))), ?_⟩
  · rw [← add_assoc, hKD, hD'eq', Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, MMP.Flips.toRDivisor_eq_mapCoeffs]
  · rw [← add_assoc, hsum, hD'eq', Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
    ring

variable {X M W : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  {sM : M ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [LocallyOfFiniteType sX] [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
  [LocallyOfFiniteType sM] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]

/-- **Comparison of log discrepancies along a common resolution.** Let `p : W ⟶ X` and
`q : W ⟶ M` be proper birational morphisms of normal varieties of dimension `n`, with rational
top forms `ω_X`, `ω_M` whose canonical divisors pull back to the same `K_W`. If
`G_X = p^*(K_X + D_X)` and `G_M = q^*(K_M + D_M)` differ by an effective `ℝ`-Cartier divisor
`G_X - G_M ≥ 0`, then every log discrepancy of `(M, D_M)` is at least one of `(X, D_X)`; in
particular if all log discrepancies of `(X, D_X)` are positive, so are those of `(M, D_M)`. -/
private theorem logDiscrepancy_pos_of_crepant_le {p : W ⟶ X} {q : W ⟶ M} [IsProper p]
    [IsProper q] [IsDominant p] [IsDominant q] [LocallyOfFiniteType (p ≫ sX)]
    [LocallyOfFiniteType (q ≫ sM)] [AlgebraicGeometry.IsVariety k (q ≫ sM)]
    (hXn : IsNormalVariety k sX) (hMn : IsNormalVariety k sM)
    (hWnp : IsNormalVariety k (p ≫ sX)) (hWnq : IsNormalVariety k (q ≫ sM))
    (hpb : IsBirationalMorphism p) (hqb : IsBirationalMorphism q) (hss : q ≫ sM = p ≫ sX)
    {n : ℕ} (hdM : topologicalKrullDim M = n)
    {ωX : RationalPluriForms sX n 1} (hωX0 : ωX ≠ 0)
    (hKXc : (divisorOfForm ωX).IsCanonicalDivisor sX n)
    {ωM : RationalPluriForms sM n 1} (hωM0 : ωM ≠ 0)
    (hKMc : (divisorOfForm ωM).IsCanonicalDivisor sM n)
    {KW : Divisor W} (hKWp : KW.IsCanonicalDivisor (p ≫ sX) n)
    (hKWq : KW.IsCanonicalDivisor (q ≫ sM) n)
    (hωXW : divisorOfForm (pullbackRationalPluriForms sX p ωX) = KW)
    (hωMW : divisorOfForm (pullbackRationalPluriForms sM q ωM) = KW)
    {DX : RDivisor X} {DM : RDivisor M} {GX GM : RDivisor W}
    (hGp : MMP.Flips.IsRCartierPullback p (Divisor.toRDivisor (divisorOfForm ωX) + DX) GX)
    (hGq : MMP.Flips.IsRCartierPullback q (Divisor.toRDivisor (divisorOfForm ωM) + DM) GM)
    (hRC : RDivisor.IsRCartier (GX - GM)) (hle : 0 ≤ GX - GM)
    (hkltX : ∀ (d : ℕ) (E : DivisorOver k sX) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX d DX E a → 0 < a)
    (d : ℕ) (E : DivisorOver k sM) (a : ℝ)
    (ha : MMP.Intersection.IsLogDiscrepancy sM d DM E a) : 0 < a := by
  obtain rfl : d = n := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans hdM
  let EP : MMP.Flips.ProperDivisorOver k sM := ⟨E, ha.2.1⟩
  obtain ⟨mM, rM, LM, -, hLMc, hLMsum, -, -⟩ := id hGq
  obtain ⟨b, hb⟩ := exists_isDiscrepancyWith hMn hdM hωM0 hLMc hLMsum EP
  rw [MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha
    (isLogDiscrepancy_of_isDiscrepancyWith hKMc hb)]
  have hKDM : MMP.Flips.IsCartierCombination (Divisor.toRDivisor (divisorOfForm ωM) + DM) :=
    ⟨mM, rM, LM, hLMc, by rw [hLMsum]; simp only [MMP.Flips.toRDivisor_eq_mapCoeffs]⟩
  obtain ⟨E', hE'⟩ := exists_properDivisorOver_comap_eq q hqb EP
  have hDYq : MMP.Flips.IsRCartierPullback q (Divisor.toRDivisor (divisorOfForm ωM) + DM)
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sM q ωM)) +
        (GM - Divisor.toRDivisor KW)) := by
    rw [hωMW, add_sub_cancel]; exact hGq
  have h1 := (MMP.Flips.isDiscrepancy_comap_functionFieldMap_iff hMn hωM0 hKMc hKDM q hWnq hqb
    hDYq (by rw [hωMW]; exact hKWq) E' b).mp (by
      rw [hE']
      exact ⟨hKMc, hKDM, hasNonemptyCenter_valuation EP, EP, ωM, mM, rM, LM, rfl, rfl, hb⟩)
  rw [hωMW] at h1
  -- lowering the boundary on `W` from `G_M - K_W` to `G_X - K_W`
  obtain ⟨b', hb'b, h2⟩ := exists_le_isDiscrepancy_add h1 hRC hle
  have hGsum : GM - Divisor.toRDivisor KW + (GX - GM) = GX - Divisor.toRDivisor KW := by abel
  rw [hGsum] at h2
  obtain ⟨E'', hE''⟩ := exists_properDivisorOver_of_eq hss E'
  obtain ⟨mX, rX, LX, -, hLXc, hLXsum, -, -⟩ := id hGp
  have hKDX : MMP.Flips.IsCartierCombination (Divisor.toRDivisor (divisorOfForm ωX) + DX) :=
    ⟨mX, rX, LX, hLXc, by rw [hLXsum]; simp only [MMP.Flips.toRDivisor_eq_mapCoeffs]⟩
  have hDYp : MMP.Flips.IsRCartierPullback p (Divisor.toRDivisor (divisorOfForm ωX) + DX)
      (Divisor.toRDivisor (divisorOfForm (pullbackRationalPluriForms sX p ωX)) +
        (GX - Divisor.toRDivisor KW)) := by
    rw [hωXW, add_sub_cancel]; exact hGp
  obtain ⟨-, -, -, E₀, ω₀, m₀, r₀, L₀, -, hdiv₀, hw₀⟩ :=
    (MMP.Flips.isDiscrepancy_comap_functionFieldMap_iff hXn hωX0 hKXc hKDX p hWnp hpb hDYp
      (by rw [hωXW]; exact hKWp) E'' b').mpr (by rw [hωXW, hE'']; exact isDiscrepancy_of_eq hss h2)
  have := hkltX _ E₀.toDivisorOver (1 + b')
    (isLogDiscrepancy_of_isDiscrepancyWith (by rw [hdiv₀]; exact hKXc) hw₀)
  linarith

omit [PerfectField k] in
open Classical in
/-- On a smooth variety every `ℝ`-divisor is `ℝ`-Cartier. -/
private theorem isRCartier_of_isSmoothScheme {Z : Scheme.{u}} {sZ : Z ⟶ Spec (.of k)}
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] (hsm : IsSmoothScheme sZ)
    (D : RDivisor Z) : RDivisor.IsRCartier D := by
  refine ⟨D.support.card, fun i => D.coeff (D.support.equivFin.symm i),
    fun i => Finsupp.single (D.support.equivFin.symm i : MMP.Mori.PrimeDivisor Z) (1 : ℤ),
    fun i => MMP.Fourfold.isCartier_of_isSmoothScheme hsm _, fun Γ => ?_⟩
  simp only [DivisorWithCoeffs.coeff_apply]
  rw [sum_equivFin_mul_single D.support (⇑D) Γ]
  split_ifs with h
  · rfl
  · exact Finsupp.notMem_support_iff.mp h

end Comparison

end CrepantInputs

section NefModel

open MMP.Flips

variable {k : Type u} [Field k] [PerfectField k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  {sY : Y ⟶ Spec (.of k)} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  [LocallyOfFiniteType sX] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

omit [PerfectField k] [CompactSpace X] [LocallyOfFiniteType sX] in
private theorem isNormalVariety_comp_left {W : Scheme.{u}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of k)} {φ : X.RationalMap Y}
    {KX : Divisor X} {Δ : RDivisor X} {KY : Divisor Y} {ΔY : RDivisor Y} {p : W ⟶ X} {q : W ⟶ Y}
    {h : X.RationalMap W} {GX GY : RDivisor W}
    (hR : IsLogComparisonResolution sX sY sW φ KX Δ KY ΔY p q h GX GY) :
    IsNormalVariety k (p ≫ sX) := by
  rw [hR.comp_eq_left]; exact ⟨hR.isVariety, inferInstance⟩

omit [PerfectField k] [CompactSpace X] [LocallyOfFiniteType sX] in
private theorem isNormalVariety_comp_right {W : Scheme.{u}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of k)} {φ : X.RationalMap Y}
    {KX : Divisor X} {Δ : RDivisor X} {KY : Divisor Y} {ΔY : RDivisor Y} {p : W ⟶ X} {q : W ⟶ Y}
    {h : X.RationalMap W} {GX GY : RDivisor W}
    (hR : IsLogComparisonResolution sX sY sW φ KX Δ KY ΔY p q h GX GY) :
    IsNormalVariety k (q ≫ sY) := by
  rw [hR.comp_eq_right]; exact ⟨hR.isVariety, inferInstance⟩

omit [PerfectField k] [CompactSpace X] [LocallyOfFiniteType sX] in
private theorem compactSpace_of_isLogComparisonResolution {W : Scheme.{u}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of k)} {φ : X.RationalMap Y}
    {KX : Divisor X} {Δ : RDivisor X} {KY : Divisor Y} {ΔY : RDivisor Y} {p : W ⟶ X} {q : W ⟶ Y}
    {h : X.RationalMap W} {GX GY : RDivisor W}
    (hR : IsLogComparisonResolution sX sY sW φ KX Δ KY ΔY p q h GX GY) : CompactSpace W := by
  have := hR.isVariety
  exact QuasiCompact.compactSpace_of_compactSpace sW

/-- **One rational top form on each side of a common resolution.** On a common resolution
`p : W ⟶ X`, `q : W ⟶ Y` comparing canonical divisors `K_X` and `K_Y`, the varieties have the
same dimension `n`, and there are a canonical divisor `K_W` of `W` and nonzero rational top forms
`ω_X`, `ω_Y` with `div ω_X = K_X`, `div ω_Y = K_Y` and `div(p^*ω_X) = K_W = div(q^*ω_Y)`. -/
private theorem exists_rationalPluriForms_of_isLogComparisonResolution {W : Scheme.{u}}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] [CompactSpace Y]
    [LocallyOfFiniteType sY] {sW : W ⟶ Spec (.of k)} {φ : X.RationalMap Y} {KX : Divisor X}
    {Δ : RDivisor X} {KY : Divisor Y} {ΔY : RDivisor Y} {p : W ⟶ X} {q : W ⟶ Y}
    {h : X.RationalMap W} {GX GY : RDivisor W} [IsProper p] [IsProper q] [IsDominant p]
    [IsDominant q] [LocallyOfFiniteType (p ≫ sX)] [LocallyOfFiniteType (q ≫ sY)]
    (hR : IsLogComparisonResolution sX sY sW φ KX Δ KY ΔY p q h GX GY)
    (hXn : IsNormalVariety k sX) (hYn : IsNormalVariety k sY) {n nY : ℕ}
    (hKX : KX.IsCanonicalDivisor sX n) (hKY : KY.IsCanonicalDivisor sY nY) :
    nY = n ∧ ∃ KW : Divisor W, KW.IsCanonicalDivisor (p ≫ sX) n ∧
      KW.IsCanonicalDivisor (q ≫ sY) n ∧
      (∃ ωX : RationalPluriForms sX n 1, ωX ≠ 0 ∧ divisorOfForm ωX = KX ∧
        divisorOfForm (pullbackRationalPluriForms sX p ωX) = KW) ∧
      ∃ ωY : RationalPluriForms sY n 1, ωY ≠ 0 ∧ divisorOfForm ωY = KY ∧
        divisorOfForm (pullbackRationalPluriForms sY q ωY) = KW := by
  have hWnp := isNormalVariety_comp_left hR
  have hWnq := isNormalVariety_comp_right hR
  have hpb := hR.isBirationalMorphism_left
  have hqb := hR.isBirationalMorphism_right
  obtain ⟨nW, KW, hKW, hKWX, hKWY⟩ := hR.exists_canonicalDivisor
  have hdimX := hKX.topologicalKrullDim_eq
  have := hXn.1
  have := hYn.1
  have := hWnp.1
  have := hWnq.1
  have hdimW : topologicalKrullDim W = topologicalKrullDim X :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hpb).symm
  have hdimY : topologicalKrullDim W = topologicalKrullDim Y :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q ≫ sY) hqb).symm
  obtain rfl : nW = n := by
    exact_mod_cast hKW.topologicalKrullDim_eq.symm.trans (hdimW.trans hdimX)
  have hKWp : KW.IsCanonicalDivisor (p ≫ sX) nW := by rw [hR.comp_eq_left]; exact hKW
  have hKWq : KW.IsCanonicalDivisor (q ≫ sY) nW := by rw [hR.comp_eq_right]; exact hKW
  have hdM : topologicalKrullDim Y = nW := hdimY.symm.trans hKW.topologicalKrullDim_eq
  obtain ⟨ωX, hωX0, hωX, hωXW⟩ :=
    exists_divisorOfForm_eq_transformDivisor hXn hWnp hpb hdimX hKWp
  obtain ⟨ωY, hωY0, hωY, hωYW⟩ :=
    exists_divisorOfForm_eq_transformDivisor hYn hWnq hqb hdM hKWq
  exact ⟨by exact_mod_cast hKY.topologicalKrullDim_eq.symm.trans hdM, KW, hKWp, hKWq,
    ⟨ωX, hωX0, hωX.trans hKWX, hωXW⟩, ωY, hωY0, hωY.trans hKWY, hωYW⟩

/-- **Klt descends along an effective comparison.** If a common resolution compares the adjoints
of `(X, Δ)` and `(Y, Δ_Y)` with `p^*(K_X + Δ) - q^*(K_Y + Δ_Y)` effective, then every log
discrepancy of `(Y, Δ_Y)` is positive as soon as every log discrepancy of `(X, Δ)` is. -/
private theorem isLogDiscrepancy_pos_of_isLogComparisonResolution {W : Scheme.{u}}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of k)}
    {φ : X.RationalMap Y} {KX : Divisor X} {Δ : RDivisor X} {KY : Divisor Y} {ΔY : RDivisor Y}
    {p : W ⟶ X} {q : W ⟶ Y} {h : X.RationalMap W} {GX GY : RDivisor W}
    (hR : IsLogComparisonResolution sX sY sW φ KX Δ KY ΔY p q h GX GY)
    (hXn : IsNormalVariety k sX) (hYn : IsNormalVariety k sY) {n nY : ℕ}
    (hKX : KX.IsCanonicalDivisor sX n) (hKY : KY.IsCanonicalDivisor sY nY)
    (hkltX : ∀ (d : ℕ) (E : DivisorOver k sX) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX d Δ E a → 0 < a) :
    ∀ (d : ℕ) (E : DivisorOver k sY) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sY d ΔY E a → 0 < a := by
  have hWnp := isNormalVariety_comp_left hR
  have hWnq := isNormalVariety_comp_right hR
  have := isProper_of_isProjectiveMorphism p hR.isProjectiveMorphism_left
  have := isProper_of_isProjectiveMorphism q hR.isProjectiveMorphism_right
  have hpb := hR.isBirationalMorphism_left
  have hqb := hR.isBirationalMorphism_right
  have : IsDominant p := hpb.isDominant
  have : IsDominant q := hqb.isDominant
  have : LocallyOfFiniteType (p ≫ sX) := hWnp.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (q ≫ sY) := hWnq.1.toLocallyOfFiniteType
  have : AlgebraicGeometry.IsVariety k (q ≫ sY) := hWnq.1
  have : LocallyOfFiniteType sY := hYn.1.toLocallyOfFiniteType
  have := hYn.1
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  have := compactSpace_of_isLogComparisonResolution hR
  obtain ⟨rfl, KW, hKWp, hKWq, ⟨ωX, hωX0, hωX, hωXW⟩, ωY, hωY0, hωY, hωYW⟩ :=
    exists_rationalPluriForms_of_isLogComparisonResolution hR hXn hYn hKX hKY
  have hGp := hR.isRCartierPullback_left
  have hGq := hR.isRCartierPullback_right
  rw [MMP.Flips.logCanonicalDivisor, ← hωX] at hGp
  rw [MMP.Flips.logCanonicalDivisor, ← hωY] at hGq
  exact logDiscrepancy_pos_of_crepant_le hXn hYn hWnp hWnq hpb hqb
    (hR.comp_eq_right.trans hR.comp_eq_left.symm) hKY.topologicalKrullDim_eq hωX0
    (by rw [hωX]; exact hKX) hωY0 (by rw [hωY]; exact hKY) hKWp hKWq hωXW hωYW hGp hGq
    (isRCartier_of_isSmoothScheme hR.isSmoothScheme _) (fun P => hR.effective P) hkltX

end NefModel

section Intersection

open MMP.Flips

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- A normalization of a proper curve is not constant. -/
private theorem not_const_of_isCurveNormalization (C : ProperCurve sX) {C' : Scheme.{u}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) :
    ¬ ∃ y : C.scheme, ∀ x : C', ν.base x = y := by
  rintro ⟨y, hy⟩
  have := hν.isFinite
  have : IsDominant ν := hν.isBirationalMorphism.isDominant
  have huniv : Set.range ν = Set.univ := by
    rw [← ν.isClosedMap.isClosed_range.closure_eq, ν.denseRange.closure_range]
  have : Subsingleton C.scheme := ⟨fun a b => by
    obtain ⟨x, rfl⟩ := huniv.ge (Set.mem_univ a)
    obtain ⟨x', rfl⟩ := huniv.ge (Set.mem_univ b)
    exact (hy x).trans (hy x').symm⟩
  have h0 := topologicalKrullDim_zero_of_discreteTopology C.scheme
  rw [C.dim_eq] at h0
  exact absurd h0 (by decide)

/-- A normalization of a proper curve is a curve. -/
private theorem isCurve_comp (C : ProperCurve sX) {C' : Scheme.{u}} {ν : C' ⟶ C.scheme}
    (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1) :
    AlgebraicGeometry.IsCurve k (ν ≫ C.ι ≫ sX) := by
  have := hν.isFinite
  have := hν.isIntegral
  have hp : IsProper (ν ≫ C.ι ≫ sX) := inferInstance
  have : AlgebraicGeometry.IsVariety k (ν ≫ C.ι ≫ sX) :=
    { toIsIntegral := ‹_›, toIsSeparated := hp.toIsSeparated,
      toLocallyOfFiniteType := hp.toLocallyOfFiniteType, toQuasiCompact := inferInstance }
  refine ⟨le_antisymm hdim ?_⟩
  by_contra! h
  refine not_const_of_isCurveNormalization C hν ⟨ν.base (genericPoint C'), fun x => ?_⟩
  by_cases hx : x = genericPoint C'
  · rw [hx]
  · exact absurd (one_le_topologicalKrullDim_of_specializes_of_ne
      (genericPoint_specializes x) (Ne.symm hx)) (not_le.mpr h)

/-- A proper curve is a curve. -/
private theorem isCurve_ι (C : ProperCurve sX) : AlgebraicGeometry.IsCurve k (C.ι ≫ sX) := by
  have hp : IsProper (C.ι ≫ sX) := inferInstance
  have : AlgebraicGeometry.IsVariety k (C.ι ≫ sX) :=
    { toIsIntegral := inferInstance, toIsSeparated := hp.toIsSeparated,
      toLocallyOfFiniteType := hp.toLocallyOfFiniteType, toQuasiCompact := inferInstance }
  exact ⟨C.dim_eq⟩

/-- A birational morphism of integral schemes has degree one. -/
private theorem degreeOver_eq_one {Y Z : Scheme.{u}} [IsIntegral Y] [IsIntegral Z] (f : Y ⟶ Z)
    (hf : IsBirationalMorphism f) [IsDominant f] [LocallyOfFiniteType f] : degreeOver f = 1 := by
  letI := (functionFieldMap f).toAlgebra
  have heq : functionFieldMap f = dominantFunctionFieldMap f :=
    (congrArg CommRingCat.Hom.hom
      (stalkMap_cast_target f (genericPoint Y) (map_genericPoint_of_isDominant f))).symm
  rw [degreeOver_eq_finrank f heq]
  let e := AlgEquiv.ofBijective (Algebra.ofId Z.functionField Y.functionField)
    (hf.functionFieldMap_bijective)
  rw [← e.toLinearEquiv.finrank_eq, Module.finrank_self]

/-- The degree of an invertible sheaf along a normalization of a proper curve `C` is its degree
along `C`. -/
private theorem degreeOn_normalization (C : ProperCurve sX) {C' : Scheme.{u}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1)
    [IsProper ((ν ≫ C.ι) ≫ sX)] (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M] :
    MMP.Mori.degreeOn k sX (ν ≫ C.ι) hdim M = MMP.Mori.degreeOn k sX C.ι C.dim_le M := by
  have := hν.isFinite
  have := hν.isIntegral
  haveI : IsProper (ν ≫ C.ι ≫ sX) := by rw [← Category.assoc]; infer_instance
  have hc := isCurve_comp C hν hdim
  have hc2 := isCurve_ι (k := k) C
  haveI : IsDominant ν := hν.isBirationalMorphism.isDominant
  have key := curveDegree_pullback_eq_degreeOver_mul k (ν ≫ C.ι ≫ sX) (C.ι ≫ sX) ν rfl
    (not_const_of_isCurveNormalization C hν) ((Scheme.Modules.pullback C.ι).obj M) 1
  rw [degreeOver_eq_one ν hν.isBirationalMorphism, Nat.cast_one, one_mul] at key
  let e : (Scheme.Modules.pullback (ν ≫ C.ι)).obj M ≅
      (Scheme.Modules.pullback ν).obj ((Scheme.Modules.pullback C.ι).obj M) :=
    ((Scheme.Modules.pullbackComp ν C.ι).app M).symm
  rw [MMP.Mori.degreeOn, MMP.Mori.degreeOn,
    invertibleCurveDegree_congr_structure (Category.assoc ν C.ι sX) hdim,
    invertibleCurveDegree_eq_of_iso k _ hdim e,
    invertibleCurveDegree_eq_curveDegree_one, invertibleCurveDegree_eq_curveDegree_one]
  exact key

variable (k sX) [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]

/-- `L · C` is the degree of `𝒪_X(L)` along `C`: every proper curve has a normalization, which is
birational, so of degree one. -/
private theorem isCartierIntersectionNumber_degreeOn_of_properCurve (C : ProperCurve sX)
    (L : Divisor X)
    (hL : L.IsCartier) :
    IsCartierIntersectionNumber k sX C L hL (L.degreeOn k sX C.ι C.dim_le hL) := by
  let p := C.ι ≫ sX
  haveI : AlgebraicGeometry.IsCurve k p := C.isCurve
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k p
  haveI hvar : AlgebraicGeometry.IsVariety k (normalizationOverField k p ≫ p) :=
    isVariety_normalizationOverField k p
  haveI : IsIntegral (normalizationSchemeOverField k p) := hvar.toIsIntegral
  haveI : IsFinite (normalizationOverField k p) := isFinite_normalizationOverField k p
  have hν : IsCurveNormalization (normalizationOverField k p) :=
    { isIntegral := inferInstance
      isNormal := Scheme.isNormal_normalizationScheme C.scheme hX
      isFinite := inferInstance
      isBirationalMorphism := by
        haveI : Finite (irreducibleComponents (normalizationSchemeOverField k p)) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        haveI : Finite (irreducibleComponents C.scheme) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        obtain ⟨U, V, hUV, hU, hV, hiso⟩ := exists_dense_opens_isIso_resLE_of_isBirational
          (normalizationOverField k p) (Scheme.isBirational_normalization C.scheme hX)
          (Or.inl ⟨inferInstance, inferInstance⟩)
        exact isBirationalMorphism_of_isIso_resLE _ U V hU.nonempty hV.nonempty hUV hiso }
  have hdim := (topologicalKrullDim_normalizationSchemeOverField k p).le.trans C.dim_le
  refine ⟨_, _, hν, hdim, ?_⟩
  haveI : IsProper ((normalizationOverField k p ≫ C.ι) ≫ sX) := by
    rw [Category.assoc]; infer_instance
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := hL.isInvertibleModule_divisorialSheaf
  exact (degreeOn_normalization C hν hdim _).symm

/-- `D · C = ∑ r_j (L_j · C)`, computed from the degrees along `C`, for a presentation
`D = ∑ r_j L_j` by Cartier divisors. -/
private theorem isRIntersectionNumber_sum_degreeOn_of_isCartier (C : ProperCurve sX) {m : ℕ}
    (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier) :
    IsRIntersectionNumber k sX (∑ j, r j • Divisor.toRDivisor (L j)) r L C
      (∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ)) :=
  ⟨hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), rfl,
    fun j => isCartierIntersectionNumber_degreeOn_of_properCurve k sX C (L j) (hL j), rfl⟩

/-- Every value of `D · C` is `∑ r_j (L_j · C)`, for any presentation `D = ∑ r_j L_j`. -/
private theorem eq_sum_degreeOn_of_isRIntersectionNumber (C : ProperCurve sX) {D : RDivisor X}
    {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) {m' : ℕ} {r' : Fin m' → ℝ}
    {L' : Fin m' → Divisor X} {x : ℝ} (hx : IsRIntersectionNumber k sX D r' L' C x) :
    x = ∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ) := by
  subst hD
  exact (IsRIntersectionNumber.eq_and_linear k sX C).1 _ r' L' r L _ _ hx
    (isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C r L hL)

/-- The empty presentation of `0` computes `0 · C = 0`. -/
private theorem isRIntersectionNumber_zero (C : ProperCurve sX) :
    IsRIntersectionNumber k sX (0 : RDivisor X) (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) C 0 :=
  ⟨fun j => j.elim0, Fin.elim0, by simp, fun j => j.elim0, by simp⟩

end Intersection

section Nef

open MMP.Flips

/-- **Projection formula** for the pull-back of a Cartier divisor `D` along `h : Y' ⟶ Y`: on a
proper curve `C' ⊆ Y'` whose image is the proper curve `C ⊆ Y`,
`h^*D · C' = [k(C') : k(C)] · (D · C)`. -/
private theorem degreeOn_pullback_eq_mul {k : Type u} [Field k] {Y Y' : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} [IsSeparated sY] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    (h : Y' ⟶ Y) [QuasiCompact (h ≫ sY)] [CompactSpace Y] [CompactSpace Y'] {D : Divisor Y}
    (hD : D.IsCartier)
    (hB : ∀ Z : irreducibleComponents Y', h (componentGenericPoint Y' Z) ∉ D.supp)
    (C' : ProperCurve (h ≫ sY)) (C : ProperCurve sY) (hC : C.point = h C'.point) :
    (D.pullback hD hB).degreeOn k (h ≫ sY) C'.ι C'.dim_le (hD.isCartier_pullback h hB) =
      (residueFieldDegree h C'.point : ℤ) * D.degreeOn k sY C.ι C.dim_le hD := by
  rw [Divisor.degreeOn_pullback_eq_degree_pushforward h rfl hD hB C', OneCycle.pushforward_cycle,
    cyclePushforwardOfPoint, dif_pos (hC ▸ C.isProperCurve)]
  have hCe : (⟨h C'.point, hC ▸ C.isProperCurve⟩ : ProperCurve sY) = C := ProperCurve.ext hC.symm
  rw [hCe]
  simp [OneCycle.degree, ProperCurve.degree, Divisor.degreeOn, mul_comm]

/-- The pull-back of a Cartier divisor along `h : Y' ⟶ Y` has degree zero on a proper curve
`C' ⊆ Y'` whose image is not a proper curve. -/
private theorem degreeOn_pullback_eq_zero {k : Type u} [Field k] {Y Y' : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} [IsSeparated sY] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    (h : Y' ⟶ Y) [QuasiCompact (h ≫ sY)] [CompactSpace Y] [CompactSpace Y'] {D : Divisor Y}
    (hD : D.IsCartier)
    (hB : ∀ Z : irreducibleComponents Y', h (componentGenericPoint Y' Z) ∉ D.supp)
    (C' : ProperCurve (h ≫ sY)) (hc : ¬ IsProperCurve sY (h C'.point)) :
    (D.pullback hD hB).degreeOn k (h ≫ sY) C'.ι C'.dim_le (hD.isCartier_pullback h hB) = 0 := by
  rw [Divisor.degreeOn_pullback_eq_degree_pushforward h rfl hD hB C', OneCycle.pushforward_cycle,
    cyclePushforwardOfPoint, dif_neg hc, map_zero]

end Nef

/-! ### Numerically trivial divisors over a base -/

section NumericallyTrivial

open MMP.Flips

variable {k : Type u} [Field k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X]

omit [QuasiCompact sX] in
/-- A combination of Cartier divisors is a Cartier combination. -/
private theorem isCartierCombination_of_eq_sum' {N : RDivisor X} {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier)
    (hN : N = ∑ j, r j • Divisor.toRDivisor (L j)) : IsCartierCombination N :=
  ⟨m, r, L, hL, by rw [hN]; simp only [MMP.Flips.toRDivisor_eq_mapCoeffs]⟩

omit [QuasiCompact sX] in
/-- A Cartier combination, as a sum of Cartier divisors. -/
private theorem exists_eq_sum_of_isCartierCombination {N : RDivisor X}
    (hN : IsCartierCombination N) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X), (∀ j, (L j).IsCartier) ∧
      N = ∑ j, r j • Divisor.toRDivisor (L j) := by
  obtain ⟨m, r, L, hL, hN⟩ := hN
  exact ⟨m, r, L, hL, by rw [hN]; simp only [MMP.Flips.toRDivisor_eq_mapCoeffs]⟩

/-- **Numerical triviality through one presentation.** A divisor `N = ∑ r_j L_j` is numerically
trivial over `f` as soon as `∑ r_j (L_j · C) = 0` for every curve `C` contracted by `f`. -/
private theorem isNumericallyTrivialOver_of_eq_sum (f : X ⟶ Y) {N : RDivisor X} {m : ℕ}
    (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier)
    (hN : N = ∑ j, r j • Divisor.toRDivisor (L j))
    (h0 : ∀ C : ProperCurve sX, C.IsContractedBy f →
      ∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ) = 0) :
    IsNumericallyTrivialOver k sX f N := by
  refine ⟨isCartierCombination_of_eq_sum' r L hL hN,
    ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
    fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h₁ h₂ => ?_⟩
  rw [eq_sum_degreeOn_of_isRIntersectionNumber k sX C r L hL hN h₁, h0 C hC]
  exact ((IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ h₂
    (isRIntersectionNumber_zero k sX C)).symm

/-- Along a numerically trivial divisor `N = ∑ r_j L_j`, `∑ r_j (L_j · C) = 0` for every curve
`C` contracted by `f`. -/
private theorem sum_degreeOn_eq_zero_of_isNumericallyTrivialOver {f : X ⟶ Y} {N : RDivisor X}
    (hN : IsNumericallyTrivialOver k sX f N) {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X)
    (hL : ∀ j, (L j).IsCartier) (hNL : N = ∑ j, r j • Divisor.toRDivisor (L j))
    (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    ∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ) = 0 := by
  have h1 := isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C r L hL
  rw [← hNL] at h1
  exact hN.2.2 C hC _ r L _ 0 Fin.elim0 Fin.elim0 0 h1 (isRIntersectionNumber_zero k sX C)

/-- A real linear combination of numerically trivial divisors is numerically trivial. -/
private theorem isNumericallyTrivialOver_smul_add_smul {f : X ⟶ Y} {N₁ N₂ : RDivisor X}
    (h₁ : IsNumericallyTrivialOver k sX f N₁) (h₂ : IsNumericallyTrivialOver k sX f N₂)
    (a b : ℝ) : IsNumericallyTrivialOver k sX f (a • N₁ + b • N₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, hN₁⟩ := exists_eq_sum_of_isCartierCombination h₁.1
  obtain ⟨m₂, r₂, L₂, hL₂, hN₂⟩ := exists_eq_sum_of_isCartierCombination h₂.1
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier :=
    Fin.addCases (by simpa using hL₁) (by simpa using hL₂)
  refine isNumericallyTrivialOver_of_eq_sum f (Fin.append (a • r₁) (b • r₂)) (Fin.append L₁ L₂)
    hL ?_ fun C hC => ?_
  · rw [hN₁, hN₂, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Finset.smul_sum, Pi.smul_apply, smul_eq_mul,
      mul_smul]
  · rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, mul_assoc,
      ← Finset.mul_sum]
    rw [sum_degreeOn_eq_zero_of_isNumericallyTrivialOver h₁ r₁ L₁ hL₁ hN₁ C hC,
      sum_degreeOn_eq_zero_of_isNumericallyTrivialOver h₂ r₂ L₂ hL₂ hN₂ C hC]
    ring

/-- A sum of numerically trivial divisors is numerically trivial. -/
private theorem isNumericallyTrivialOver_add {f : X ⟶ Y} {N₁ N₂ : RDivisor X}
    (h₁ : IsNumericallyTrivialOver k sX f N₁) (h₂ : IsNumericallyTrivialOver k sX f N₂) :
    IsNumericallyTrivialOver k sX f (N₁ + N₂) := by
  simpa using isNumericallyTrivialOver_smul_add_smul h₁ h₂ 1 1

/-- `N₁ ≡_f N₂` exactly when `N₁ - N₂` is numerically trivial over `f`. -/
private theorem isNumericallyEquivalentOver_iff_isNumericallyTrivialOver_sub {f : X ⟶ Y}
    {N₁ N₂ : RDivisor X} (h₁ : IsCartierCombination N₁) (h₂ : IsCartierCombination N₂) :
    IsNumericallyEquivalentOver k sX f N₁ N₂ ↔ IsNumericallyTrivialOver k sX f (N₁ - N₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, hN₁⟩ := exists_eq_sum_of_isCartierCombination h₁
  obtain ⟨m₂, r₂, L₂, hL₂, hN₂⟩ := exists_eq_sum_of_isCartierCombination h₂
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier :=
    Fin.addCases (by simpa using hL₁) (by simpa using hL₂)
  have hsub : N₁ - N₂ = ∑ j, Fin.append ((1 : ℝ) • r₁) ((-1 : ℝ) • r₂) j •
      Divisor.toRDivisor (Fin.append L₁ L₂ j) := by
    rw [hN₁, hN₂, Fin.sum_univ_add]
    simp [Fin.append_left, Fin.append_right, sub_eq_add_neg, Finset.sum_neg_distrib, neg_smul]
  have hdeg : ∀ C : ProperCurve sX,
      ∑ j, Fin.append ((1 : ℝ) • r₁) ((-1 : ℝ) • r₂) j *
          ((Fin.append L₁ L₂ j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ) =
        ∑ j, r₁ j * ((L₁ j).degreeOn k sX C.ι C.dim_le (hL₁ j) : ℝ) -
          ∑ j, r₂ j * ((L₂ j).degreeOn k sX C.ι C.dim_le (hL₂ j) : ℝ) := by
    intro C
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, one_mul,
      neg_one_mul, neg_mul, Finset.sum_neg_distrib, sub_eq_add_neg]
  constructor
  · intro h
    refine isNumericallyTrivialOver_of_eq_sum f _ _ hL hsub fun C hC => ?_
    rw [hdeg C]
    have e₁ := isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C r₁ L₁ hL₁
    have e₂ := isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C r₂ L₂ hL₂
    rw [← hN₁] at e₁
    rw [← hN₂] at e₂
    rw [h.2.2 C hC _ r₁ L₁ _ _ r₂ L₂ _ e₁ e₂, sub_self]
  · intro h
    refine ⟨h₁, h₂, fun C hC m₁' r₁' L₁' x₁ m₂' r₂' L₂' x₂ e₁ e₂ => ?_⟩
    rw [eq_sum_degreeOn_of_isRIntersectionNumber k sX C r₁ L₁ hL₁ hN₁ e₁,
      eq_sum_degreeOn_of_isRIntersectionNumber k sX C r₂ L₂ hL₂ hN₂ e₂]
    have := sum_degreeOn_eq_zero_of_isNumericallyTrivialOver h _ _ hL hsub C hC
    rw [hdeg C] at this
    linarith

variable [CompactSpace X] [IsIntegral X]

/-- A real multiple of a principal divisor is numerically trivial over every base. -/
private theorem isNumericallyTrivialOver_smul_principalDivisor (f : X ⟶ Y) (c : ℝ)
    (φ : (RationalFunctions X)ˣ) :
    IsNumericallyTrivialOver k sX f (c • Divisor.toRDivisor (principalDivisor φ)) := by
  refine isNumericallyTrivialOver_of_eq_sum f (fun _ : Fin 1 => c) (fun _ => principalDivisor φ)
    (fun _ => Divisor.isCartier_principalDivisor φ) (by simp) fun C _ => ?_
  rw [Fin.sum_univ_one, Divisor.degreeOn_eq_zero_of_linearlyEquivalent sX C.ι C.dim_le
    (Divisor.isCartier_principalDivisor φ) ⟨φ, by rw [sub_zero]⟩]
  simp

end NumericallyTrivial

section NumericallyTrivialPullback

open MMP.Flips

/-- **Pull-backs of numerically trivial divisors.** If `N` is numerically trivial over `Z` (via
`π`) and `q : W ⟶ X` is proper, then `q^*N` is numerically trivial over `Z` (via `q ≫ π`). -/
private theorem isNumericallyTrivialOver_of_isRCartierPullback {k : Type u} [Field k]
    {W X Z : Scheme.{u}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} [IsSeparated sX]
    [LocallyOfFiniteType sX] [QuasiCompact sX] (π : X ⟶ Z) (q : W ⟶ X) [IsProper q]
    [QuasiCompact (q ≫ sX)] {N : RDivisor X} (hN : IsNumericallyTrivialOver k sX π N)
    {N' : RDivisor W} (hN' : IsRCartierPullback q N N') :
    IsNumericallyTrivialOver k (q ≫ sX) (q ≫ π) N' := by
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (q ≫ sX)
  obtain ⟨m, r, L₀, L₁, hL₀, hNeq, hpb, hN'eq⟩ := hN'
  choose hB hpbj using hpb
  obtain rfl : L₁ = fun j => (L₀ j).pullback (hL₀ j) (hB j) :=
    funext fun j => (Divisor.IsPullback.pullback_eq (hL₀ j) (hpbj j)).symm
  have hL₁c : ∀ j, ((L₀ j).pullback (hL₀ j) (hB j)).IsCartier := fun j =>
    (hL₀ j).isCartier_pullback q (hB j)
  refine isNumericallyTrivialOver_of_eq_sum (q ≫ π) r _ hL₁c hN'eq fun C hC => ?_
  by_cases hc : IsProperCurve sX (q C.point)
  · obtain ⟨C₀, hC₀⟩ : ∃ C₀ : ProperCurve sX, C₀.point = q C.point := ⟨⟨_, hc⟩, rfl⟩
    have hC₀c : C₀.IsContractedBy π := by
      intro z hz
      rw [hC₀] at hz ⊢
      have hsub : closure ({q C.point} : Set X) ⊆ q '' closure ({C.point} : Set W) :=
        closure_minimal (Set.singleton_subset_iff.2 ⟨C.point, subset_closure rfl, rfl⟩)
          (q.isClosedMap _ isClosed_closure)
      obtain ⟨w, hw, rfl⟩ := hsub hz
      have := hC w hw
      simpa only [Scheme.Hom.comp_apply] using this
    have hdeg : ∀ j, ((((L₀ j).pullback (hL₀ j) (hB j)).degreeOn k (q ≫ sX) C.ι C.dim_le
        (hL₁c j) : ℤ) : ℝ) =
        (residueFieldDegree q C.point : ℝ) * (L₀ j).degreeOn k sX C₀.ι C₀.dim_le (hL₀ j) := by
      intro j
      rw [degreeOn_pullback_eq_mul q (hL₀ j) (hB j) C C₀ hC₀]
      push_cast; rfl
    simp only [hdeg, mul_left_comm (r _), ← Finset.mul_sum]
    rw [sum_degreeOn_eq_zero_of_isNumericallyTrivialOver hN r L₀ hL₀ hNeq C₀ hC₀c, mul_zero]
  · have hdeg : ∀ j, ((L₀ j).pullback (hL₀ j) (hB j)).degreeOn k (q ≫ sX) C.ι C.dim_le
        (hL₁c j) = 0 := fun j => degreeOn_pullback_eq_zero q (hL₀ j) (hB j) C hc
    simp [hdeg]

/-- **Nef minus numerically trivial is nef.** -/
private theorem IsRelativelyNef.sub_of_isNumericallyTrivialOver {k : Type u} [Field k]
    {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [IsLocallyNoetherian X]
    [IsNormal X] {f : X ⟶ Y} {D N : RDivisor X} (hD : IsRelativelyNef k sX f D)
    (hN : IsNumericallyTrivialOver k sX f N) : IsRelativelyNef k sX f (D - N) := by
  obtain ⟨m, r, L, hL, hDeq, hnef⟩ := hD
  obtain ⟨m', s, M, hM, hNeq⟩ := exists_eq_sum_of_isCartierCombination hN.1
  have hLM : ∀ j, (Fin.append L M j).IsCartier :=
    Fin.addCases (by simpa using hL) (by simpa using hM)
  have heq : D - N = (1 : ℝ) • D + (-1 : ℝ) • N := by
    rw [one_smul, neg_one_smul, sub_eq_add_neg]
  refine ⟨m + m', Fin.append ((1 : ℝ) • r) ((-1 : ℝ) • s), Fin.append L M, hLM, ?_,
    fun C hC x hx => ?_⟩
  · rw [heq, hDeq, hNeq, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Finset.smul_sum, Pi.smul_apply, smul_eq_mul,
      mul_smul]
  · have hx₁ := isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C r L hL
    have hx₂ := isRIntersectionNumber_sum_degreeOn_of_isCartier k sX C s M hM
    rw [← hDeq] at hx₁
    rw [← hNeq] at hx₂
    have hlin := (IsRIntersectionNumber.eq_and_linear k sX C).2 D N r L s M _ _ 1 (-1) hx₁ hx₂
    rw [← heq] at hlin
    rw [(IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx hlin]
    have h1 := hnef C hC _ hx₁
    have h2 := sum_degreeOn_eq_zero_of_isNumericallyTrivialOver hN s M hM hNeq C hC
    rw [h2]
    linarith

end NumericallyTrivialPullback

/-! ### Birational morphisms and their inverses -/

section RationalMaps

/-- A birational morphism is an open immersion on a dense open. -/
private theorem exists_isOpenImmersion_of_isBirationalMorphism {X Y : Scheme.{u}} {f : X ⟶ Y}
    (hf : IsBirationalMorphism f) :
    ∃ U : X.Opens, Dense (U : Set X) ∧ IsOpenImmersion (U.ι ≫ f) := by
  obtain ⟨e, he⟩ := hf
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff] at he
  obtain ⟨W, hW, hWe, hWf, h⟩ := he
  simp only [Scheme.PartialMap.restrict_hom] at h
  have : IsOpenImmersion e.toPartialMap.hom := by
    change IsOpenImmersion (e.iso.hom ≫ e.target.ι)
    infer_instance
  refine ⟨W, hW, ?_⟩
  have : W.ι ≫ f = X.homOfLE hWf ≫ f.toPartialMap.hom := by
    change W.ι ≫ f = (X.homOfLE (le_top : W ≤ ⊤) ≫ X.topIso.hom) ≫ f
    simp only [Scheme.topIso_hom, Scheme.homOfLE_ι]
  rw [this, ← h]
  infer_instance

/-- Two birational morphisms out of an irreducible scheme are open immersions on a common dense
open. -/
private theorem exists_dense_isOpenImmersion_and_isOpenImmersion {W X Y : Scheme.{u}}
    [IrreducibleSpace W] {p : W ⟶ X} {q : W ⟶ Y} (hp : IsBirationalMorphism p)
    (hq : IsBirationalMorphism q) :
    ∃ U : W.Opens, Dense (U : Set W) ∧ IsOpenImmersion (U.ι ≫ p) ∧ IsOpenImmersion (U.ι ≫ q) := by
  obtain ⟨U₁, hU₁, h₁⟩ := exists_isOpenImmersion_of_isBirationalMorphism hp
  obtain ⟨U₂, hU₂, h₂⟩ := exists_isOpenImmersion_of_isBirationalMorphism hq
  have hne : ((U₁ ⊓ U₂ : W.Opens) : Set W).Nonempty := by
    obtain ⟨x, hx₂, hx₁⟩ := hU₁.inter_open_nonempty _ U₂.2 hU₂.nonempty
    exact ⟨x, hx₁, hx₂⟩
  refine ⟨U₁ ⊓ U₂, (U₁ ⊓ U₂).2.dense hne, ?_, ?_⟩
  · rw [← Scheme.homOfLE_ι W (inf_le_left : U₁ ⊓ U₂ ≤ U₁), Category.assoc]
    infer_instance
  · rw [← Scheme.homOfLE_ι W (inf_le_right : U₁ ⊓ U₂ ≤ U₂), Category.assoc]
    infer_instance

/-- The partial isomorphism `U ≅ f(U)` of a morphism which is an open immersion on a dense
open `U`, from a dominant morphism. -/
private noncomputable def partialIsoOfIsOpenImmersion {W X : Scheme.{u}} (f : W ⟶ X)
    [IsDominant f] (U : W.Opens) (hU : Dense (U : Set W)) [IsOpenImmersion (U.ι ≫ f)] :
    W.PartialIso X where
  source := U
  dense_source := hU
  target := (U.ι ≫ f).opensRange
  dense_target := by
    rw [Scheme.Hom.coe_opensRange, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      Scheme.Opens.range_ι]
    exact f.denseRange.dense_image f.continuous hU
  iso := (U.ι ≫ f).isoOpensRange

private theorem partialIsoOfIsOpenImmersion_toRationalMap {W X : Scheme.{u}} (f : W ⟶ X)
    [IsDominant f] (U : W.Opens) (hU : Dense (U : Set W)) [IsOpenImmersion (U.ι ≫ f)] :
    (partialIsoOfIsOpenImmersion f U hU).toRationalMap = f.toRationalMap := by
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨U, hU, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialIso.toPartialMap_hom,
    Scheme.Hom.toPartialMap_hom, partialIsoOfIsOpenImmersion, Scheme.Hom.isoOpensRange_hom_ι]
  exact (Scheme.homOfLE_ι_assoc _ _ _).trans
    (by rw [Scheme.topIso_hom]; exact (Scheme.homOfLE_ι_assoc _ _ _).symm)

/-- **The birational map `q ∘ p⁻¹`.** For birational morphisms `p : W ⟶ X` and `q : W ⟶ Y`
out of an irreducible scheme, `p` has an inverse `h` with `q ∘ h` birational. -/
private theorem exists_isInverse_and_isBirational_compHom {W X Y : Scheme.{u}}
    [IrreducibleSpace W] {p : W ⟶ X} {q : W ⟶ Y} (hp : IsBirationalMorphism p)
    (hq : IsBirationalMorphism q) [IsDominant p] [IsDominant q] :
    ∃ h : X.RationalMap W, RationalMap.IsInverse p.toRationalMap h ∧
      RationalMap.IsBirational (h.compHom q) := by
  obtain ⟨U, hU, hUp, hUq⟩ := exists_dense_isOpenImmersion_and_isOpenImmersion hp hq
  let ep := partialIsoOfIsOpenImmersion p U hU
  let eq := partialIsoOfIsOpenImmersion q U hU
  refine ⟨ep.symm.toRationalMap,
    ⟨ep, partialIsoOfIsOpenImmersion_toRationalMap p U hU, rfl⟩,
    ⟨ep.symm.trans' eq rfl, ?_⟩⟩
  rw [Scheme.PartialIso.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap]
  congr 1
  refine Scheme.PartialMap.ext _ _ rfl ?_
  change ((U.ι ≫ p).isoOpensRange.inv ≫ (W.isoOfEq rfl).hom ≫ (U.ι ≫ q).isoOpensRange.hom) ≫
      (U.ι ≫ q).opensRange.ι = (X.isoOfEq rfl).hom ≫ ((U.ι ≫ p).isoOpensRange.inv ≫ U.ι) ≫ q
  simp only [Category.assoc, Scheme.isoOfEq_rfl, Iso.refl_hom, Category.id_comp,
    Scheme.Hom.isoOpensRange_hom_ι]

/-- `(φ ∘ f) ∘ g = φ ∘ (g ∘ f)` for a rational map `φ` and morphisms `f`, `g`. -/
private theorem compHom_compHom {X Y Z T : Scheme.{u}} (φ : X.RationalMap Y) (f : Y ⟶ Z)
    (g : Z ⟶ T) : (φ.compHom f).compHom g = φ.compHom (f ≫ g) := by
  obtain ⟨φ', rfl⟩ := φ.exists_rep
  rw [← Scheme.RationalMap.compHom_toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    ← Scheme.RationalMap.compHom_toRationalMap]
  rfl

/-- If `h` is an inverse of the morphism `p`, then `p ∘ h` is the identity. -/
private theorem compHom_eq_of_isInverse {X Y : Scheme.{u}} [IsReduced X] [IsReduced Y]
    [IsSeparated (X ↘ ⊤_ Scheme)] {p : Y ⟶ X} {h : X.RationalMap Y}
    (hinv : RationalMap.IsInverse p.toRationalMap h) :
    h.compHom p = Scheme.Hom.toRationalMap (𝟙 X) := by
  obtain ⟨e, he1, he2⟩ := id hinv
  rw [← he2, ← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff,
    Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)]
  change e.iso.inv ≫ e.source.ι ≫ p = e.target.ι ≫ 𝟙 X
  rw [source_ι_comp_eq_of_toRationalMap_eq p e he1, Iso.inv_hom_id_assoc, Category.comp_id]

/-- If `h` is an inverse of the morphism `p : Y ⟶ X` and `h ∘ r = s` for morphisms `r`, `s`, then
`r = s ∘ p`. -/
private theorem eq_comp_of_isInverse_of_compHom_eq {X Y T : Scheme.{u}} [IsReduced X]
    [IsReduced Y] [IsSeparated (X ↘ ⊤_ Scheme)] [IsSeparated (T ↘ ⊤_ Scheme)] {p : Y ⟶ X}
    {h : X.RationalMap Y} (hinv : RationalMap.IsInverse p.toRationalMap h) (r : Y ⟶ T)
    (s : X ⟶ T) (hrs : h.compHom r = s.toRationalMap) : r = p ≫ s := by
  obtain ⟨e, he1, he2⟩ := id hinv
  have key : (e.iso.inv ≫ e.source.ι) ≫ r = e.target.ι ≫ s := by
    have h1 : (e.symm.toPartialMap.compHom r).toRationalMap = s.toRationalMap := by
      rw [Scheme.RationalMap.compHom_toRationalMap]
      change e.symm.toRationalMap.compHom r = _
      rw [he2, hrs]
    have h2 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)
      (f := e.symm.toPartialMap.compHom r) (g := s)).mp (Scheme.PartialMap.toRationalMap_eq_iff.mp h1)
    exact h2
  have hpe : e.source.ι ≫ p = e.iso.hom ≫ e.target.ι :=
    source_ι_comp_eq_of_toRationalMap_eq p e he1
  haveI : IsDominant e.source.ι := AlgebraicGeometry.Opens.isDominant_ι e.dense_source
  refine ext_of_isDominant_of_isSeparated (T ↘ ⊤_ Scheme) (Limits.terminal.hom_ext _ _)
    e.source.ι ?_
  rw [← Category.assoc e.source.ι p s, hpe, Category.assoc, ← key]
  simp

/-- A composite of birational morphisms out of an irreducible scheme is birational. -/
private theorem isBirationalMorphism_comp {X Y Z : Scheme.{u}} [IrreducibleSpace X]
    {f : X ⟶ Y} {g : Y ⟶ Z} (hf : IsBirationalMorphism f) (hg : IsBirationalMorphism g) :
    IsBirationalMorphism (f ≫ g) := by
  haveI := hf.isDominant
  haveI := hg.isDominant
  obtain ⟨U₁, hU₁, h₁⟩ := exists_isOpenImmersion_of_isBirationalMorphism hf
  obtain ⟨U₂, hU₂, h₂⟩ := exists_isOpenImmersion_of_isBirationalMorphism hg
  let U : X.Opens := U₁ ⊓ f ⁻¹ᵁ U₂
  have hne : (U : Set X).Nonempty := by
    obtain ⟨x₀⟩ := (IrreducibleSpace.isIrreducible_univ X).nonempty
    haveI : Nonempty Y := ⟨f x₀⟩
    have hd : Dense (f '' U₁) := f.denseRange.dense_image f.continuous hU₁
    obtain ⟨y, hy₂, x, hx₁, rfl⟩ := (hU₂.inter_of_isOpen_left hd U₂.2).nonempty
    exact ⟨x, hx₁, hy₂⟩
  have hle : U ≤ f ⁻¹ᵁ U₂ := inf_le_right
  have : IsOpenImmersion (f.resLE U₂ U hle ≫ U₂.ι) := by
    rw [Scheme.Hom.resLE_comp_ι, ← Scheme.homOfLE_ι X (inf_le_left : U ≤ U₁), Category.assoc]
    infer_instance
  have := IsOpenImmersion.of_comp (f.resLE U₂ U hle) U₂.ι
  haveI : IsOpenImmersion (U.ι ≫ f ≫ g) := by
    rw [← Category.assoc, ← Scheme.Hom.resLE_comp_ι f hle, Category.assoc]
    infer_instance
  let e := partialIsoOfIsOpenImmersion (f ≫ g) U (U.2.dense hne)
  exact ⟨e, partialIsoOfIsOpenImmersion_toRationalMap (f ≫ g) U (U.2.dense hne)⟩

end RationalMaps

/-! ### Pull-backs along composites -/

section PullbackComp

private theorem mem_irreducibleComponent' {T : Type*} [TopologicalSpace T] [IrreducibleSpace T]
    (W : irreducibleComponents T) (t : T) : t ∈ W.1 := by
  rw [W.2.eq_of_le (IrreducibleSpace.isIrreducible_univ T) (Set.subset_univ _)]
  trivial

/-- **Pull-back of Cartier divisors along a composite**: `g^*(f^*L) = (g ≫ f)^*L`. -/
private theorem isPullback_comp {X Y Z : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral X] [IsLocallyNoetherian Z] [IsNormal Z]
    {f : Y ⟶ X} {g : Z ⟶ Y} {L : Divisor X} {L' : Divisor Y}
    {L'' : Divisor Z} {hB : ∀ W : irreducibleComponents Y, f (componentGenericPoint Y W) ∉ L.supp}
    {hB' : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉ L'.supp}
    (h : L.IsPullback f hB L') (h' : L'.IsPullback g hB' L'')
    (hB'' : ∀ W : irreducibleComponents Z, (g ≫ f) (componentGenericPoint Z W) ∉ L.supp) :
    L.IsPullback (g ≫ f) hB'' L'' := by
  intro U φ hφ E hE
  have hψ := h.isLocalEquation hφ
  rw [h' (f ⁻¹ᵁ U) _ hψ E hE]
  congr 1
  set z := componentGenericPoint Z E.component
  have hzU : f (g z) ∈ U := E.map_componentGenericPoint_mem (g ≫ f) hE
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hzU (hB'' _) (mem_irreducibleComponent'
    (pointComponent ((g ≫ f) z)) _)
  rw [pullbackComponent_eq hB'' hφ hzU _ a ha]
  set W := pointComponent (g z)
  have hspec : componentGenericPoint Y W ⤳ g z :=
    (isGenericPoint_componentGenericPoint Y W).specializes (mem_pointComponent _)
  have hWU : f (componentGenericPoint Y W) ∈ U :=
    (f.base.hom.map_specializes hspec).mem_open U.isOpen hzU
  have hb : (stalkToRationalFunctions Y (mem_pointComponent (g z))).hom
      (Units.map (f.stalkMap (g z)).hom.toMonoidHom a) =
      ((pullbackLocalEquation f hB hφ : (RationalFunctions Y)ˣ) : RationalFunctions Y) W := by
    have e1 := congrArg Units.val (pullbackLocalEquation_apply f hB hφ W hWU)
    refine Eq.trans ?_ e1.symm
    rw [pullbackComponent_eq hB hφ hWU
      (mem_irreducibleComponent' (pointComponent ((g ≫ f) z)) _)
      (Units.map (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom.toMonoidHom a)
      ?_]
    · change (stalkToRationalFunctions Y _).hom ((f.stalkMap (g z)).hom a.val) =
        (f.stalkMap _).hom ((X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom
          a.val)
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, stalkToRationalFunctions,
        Scheme.Hom.stalkSpecializes_stalkMap]
    · change (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec) ≫
        X.presheaf.stalkSpecializes _).hom a.val = _
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact ha
  rw [pullbackComponent_eq hB' hψ _ (mem_pointComponent (g z)) _ hb]
  ext
  change _ = ((g ≫ f).stalkMap z).hom a.val
  rw [Scheme.Hom.stalkMap_comp]
  rfl

/-- **Pulling a pull-back back once more.** If `D = g^*M` and `f` is dominant, then a pull-back
`G` of `D` along `f` is a pull-back of `M` along `f ≫ g`. -/
private theorem exists_isRCartierPullback_comp {V W Z : Scheme.{u}} [IsIntegral V]
    [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V] [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] (f : V ⟶ W) [IsDominant f]
    (g : W ⟶ Z) [IsDominant g] {M : RDivisor Z} {D : RDivisor W}
    (hD : MMP.Flips.IsRCartierPullback g M D) :
    ∃ G : RDivisor V, MMP.Flips.IsRCartierPullback (f ≫ g) M G ∧
      MMP.Flips.IsRCartierPullback f D G := by
  obtain ⟨m, r, L, L', hLc, hM, hpb, rfl⟩ := hD
  have hL'c : ∀ j, (L' j).IsCartier := fun j => ((hpb j).2).isCartier (hLc j)
  let L'' : Fin m → Divisor V := fun j =>
    (L' j).pullback (hL'c j) (MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _)
  have hL'' : ∀ j, (L' j).IsPullback f
      (MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _) (L'' j) :=
    fun j => Divisor.isPullback_pullback (hL'c j) _
  refine ⟨∑ j, r j • Divisor.toRDivisor (L'' j), ⟨m, r, L, L'', hLc, hM, fun j =>
    ⟨MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant (f ≫ g) _,
      isPullback_comp (hpb j).2 (hL'' j) _⟩, rfl⟩, ⟨m, r, L', L'', hL'c, rfl,
      fun j => ⟨_, hL'' j⟩, rfl⟩⟩

/-- Pull-backs of `ℝ`-Cartier divisors are additive: `f^*(D₁ - D₂) = f^*D₁ - f^*D₂`. -/
private theorem isRCartierPullback_sub {X Y : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : Y ⟶ X} {D₁ D₂ : RDivisor X} {G₁ G₂ : RDivisor Y}
    (h₁ : MMP.Flips.IsRCartierPullback f D₁ G₁) (h₂ : MMP.Flips.IsRCartierPullback f D₂ G₂) :
    MMP.Flips.IsRCartierPullback f (D₁ - D₂) (G₁ - G₂) := by
  have := MMP.Fourfold.isRCartierPullback_add h₁ (MMP.Fourfold.isRCartierPullback_smul (-1) h₂)
  simpa [sub_eq_add_neg] using this

/-- An `ℝ`-Cartier divisor is a combination of Cartier divisors. -/
private theorem isCartierCombination_of_isRCartier {X : Scheme.{u}} [IsLocallyNoetherian X]
    [IsNormal X] {D : RDivisor X} (h : RDivisor.IsRCartier D) : IsCartierCombination D := by
  obtain ⟨m, r, C, hC, hD⟩ := h
  refine ⟨m, r, C, hC, DivisorWithCoeffs.ext' fun Γ => ?_⟩
  rw [hD Γ, ← MMP.Flips.coeff_sum_smul_toRDivisor]
  simp only [MMP.Flips.toRDivisor_eq_mapCoeffs]

end PullbackComp

/-! ### Exceptional prime divisors and log discrepancies on a model -/

section ExceptionalPrimes

open MMP.Flips

/-- In `WithBot ℕ∞`, `d + c = n` gives `d + 2 ≤ n ↔ 2 ≤ c`. -/
private theorem withBot_add_two_le_iff {d : WithBot ℕ∞} {c : ℕ∞} {n : ℕ} (h : d + c = n) :
    d + 2 ≤ n ↔ 2 ≤ c := by
  induction d using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
    have h' : d + c = n := by exact_mod_cast h
    have hd : d ≠ ⊤ := by rintro rfl; simp at h'
    rw [show ((n : ℕ) : WithBot ℕ∞) = ((n : ℕ∞) : WithBot ℕ∞) from rfl, ← h',
      ← WithBot.coe_ofNat, ← WithBot.coe_add, WithBot.coe_le_coe]
    exact ENat.add_le_add_iff_left hd

/-- A divisor over a variety of dimension `n` is exceptional iff the generic point of its centre
has coheight at least two. -/
private theorem isExceptional_iff_two_le_coheight {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [LocallyOfFiniteType sX] {n : ℕ}
    (hn : topologicalKrullDim X = n) (D : MMP.Flips.ProperDivisorOver k sX) :
    D.IsExceptional ↔ 2 ≤ Order.coheight (D.f D.E.genericPoint) := by
  unfold MMP.Flips.ProperDivisorOver.IsExceptional
  rw [D.center_eq_toDivisorOver_center, D.toDivisorOver.center_eq_closure_genericPoint, hn]
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX (D.f D.E.genericPoint)
  rw [hn] at h
  exact withBot_add_two_le_iff h

/-- A prime divisor mapping onto the generic point of a prime divisor is not exceptional. -/
private theorem not_isExceptionalPrimeDivisor_of_map_eq_genericPoint {k : Type u} [Field k]
    {V U : Scheme.{u}} {sU : U ⟶ Spec (.of k)} [IsIntegral U] [LocallyOfFiniteType sU] {n : ℕ}
    (hn : topologicalKrullDim U = n) {f : V ⟶ U} {E : MMP.Mori.PrimeDivisor V}
    {F : MMP.Mori.PrimeDivisor U} (h : f E.genericPoint = F.genericPoint) :
    ¬ IsExceptionalPrimeDivisor sU f E := by
  rintro ⟨hV, hf, hp, hexc⟩
  have h2 := (isExceptional_iff_two_le_coheight hn (ProperDivisorOver.mk ⟨V, f, hV, hf, E⟩ hp)).mp
    hexc
  change 2 ≤ Order.coheight (f E.genericPoint) at h2
  rw [h, F.coheight_genericPoint] at h2
  exact absurd h2 (by decide)

/-- **The log discrepancy of a prime divisor on a model.** For a proper birational morphism
`f : V ⟶ M` of normal varieties, a nonzero rational top form `ω` with `div ω = K_M` and
`div(f^*ω) = K_V`, and `G = f^*(K_M + Δ_M)`, the log discrepancy of a prime divisor `E` of `V`
with respect to `(M, Δ_M)` is `1 + coeff_E(K_V) - coeff_E(G)`. -/
private theorem isLogDiscrepancy_of_isRCartierPullback {k : Type u} [Field k]
    {M V : Scheme.{u}} [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
    {sM : M ⟶ Spec (.of k)} [LocallyOfFiniteType sM] [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] {KM : Divisor M} {ΔM : RDivisor M} {f : V ⟶ M} [IsProper f]
    [IsDominant f] {G : RDivisor V} {e : ℕ} {KV : Divisor V}
    (hMn : IsNormalVariety k sM) (hKM : KM.IsCanonicalDivisor sM e)
    (hVn : IsNormalVariety k (f ≫ sM)) (hfb : IsBirationalMorphism f)
    (ω : RationalPluriForms sM e 1) (hω0 : ω ≠ 0) (hωK : divisorOfForm ω = KM)
    (hωV : divisorOfForm (pullbackRationalPluriForms sM f ω) = KV)
    (hG : IsRCartierPullback f (logCanonicalDivisor KM ΔM) G) (E : MMP.Mori.PrimeDivisor V) :
    MMP.Intersection.IsLogDiscrepancy sM e ΔM ⟨V, f, hVn, hfb, E⟩
      (1 + (KV.coeff E : ℝ) - G.coeff E) := by
  obtain ⟨m, r, L, L', hLc, hD, hpbL, rfl⟩ := hG
  refine ⟨hMn, inferInstanceAs (IsProper f), ω, hω0, ⟨KM, hKM, fun Γ => by
    rw [← hωK]; exact coeff_divisorOfForm ω Γ⟩, m, r, L, L', hLc, fun Γ => ?_, hpbL, ?_⟩
  · have := congrArg (fun D : RDivisor M => D.coeff Γ) hD
    simp only [MMP.Flips.logCanonicalDivisor, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toRDivisor, MMP.Flips.coeff_sum_smul_toRDivisor] at this
    rw [← this, ← hωK, coeff_divisorOfForm]
  · rw [MMP.Flips.coeff_sum_smul_toRDivisor, ← hωV, coeff_divisorOfForm]
    rfl

end ExceptionalPrimes

section CanonicalOnModel

/-- The pull-back of a nonzero rational form along a birational morphism is nonzero. -/
private theorem pullbackRationalPluriForms_ne_zero {k : Type u} [Field k] [PerfectField k]
    {X Y : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    {d : ℕ} (hd : topologicalKrullDim X = d) (g : Y ⟶ X) [IsIntegral Y] [IsDominant g]
    (hg : IsBirationalMorphism g) {m : ℤ} {τ : RationalPluriForms sX d m} (hτ : τ ≠ 0) :
    pullbackRationalPluriForms sX g τ ≠ 0 := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (g ≫ sX)
  let := functionFieldMapAlgebra g
  have := isScalarTower_functionFieldMap sX g
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX g hg.functionFieldMap_bijective
    (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hd)
  have hpull : pullbackRationalPluriForms sX g τ = pullbackFormsAlong hω m τ :=
    pullbackForms_eq hω m τ
  have hrepr := repr_pullbackFormsAlong hω m τ
  intro h0
  have h0' : pullbackFormsAlong hω m τ = 0 := hpull ▸ h0
  have h1 : algebraMap X.functionField Y.functionField
      ((ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) m).repr τ ()) = 0 := by
    rw [← hrepr, h0']
    simp
  exact repr_ne_zero_of_ne_zero _ hτ ((map_eq_zero_iff _ (algebraMap _ _).injective).mp h1)

/-- **The divisor of a nonzero top form on a smooth variety is canonical.** -/
private theorem isCanonicalDivisor_divisorOfForm {k : Type u} [Field k] [PerfectField k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX)
    (hXs : IsSmoothScheme sX) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {n : ℕ} (hn : topologicalKrullDim X = n) {τ : RationalPluriForms sX n 1}
    (hτ : τ ≠ 0) : (divisorOfForm τ).IsCanonicalDivisor sX n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  obtain ⟨K, hK⟩ := @exists_isCanonicalDivisor_of_isSmoothScheme _ _ _ _ _ k _ _ hX hXs n hn
  exact hK.of_linearlyEquivalent <| by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul ⟨hX, inferInstance⟩ hK hτ

/-- **A canonical divisor lifts to a smooth model.** For a proper birational morphism
`f : Y' ⟶ Y` from a smooth variety to a normal variety over a perfect field and a canonical
divisor `K` of `Y`, some canonical divisor `K'` of `Y'` has `f_* K' = K`. -/
private theorem exists_isCanonicalDivisor_transformDivisor_eq {k : Type u} [Field k]
    [PerfectField k] {Y Y' : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [LocallyOfFiniteType sY] [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] [CompactSpace Y'] (hY : IsNormalVariety k sY)
    (f : Y' ⟶ Y) [IsProper f] (hY' : IsNormalVariety k (f ≫ sY))
    (hs : IsSmoothScheme (f ≫ sY)) (hf : IsBirationalMorphism f) {n : ℕ} {K : Divisor Y}
    (hK : K.IsCanonicalDivisor sY n) :
    ∃ K' : Divisor Y', K'.IsCanonicalDivisor (f ≫ sY) n ∧
      RationalMap.transformDivisor (X := Y') f.toRationalMap K' = K := by
  obtain ⟨ω, hω0, hω⟩ :=
    MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq_of_forall_mem_smoothLocus
      hY (MMP.Positivity.PrimeDivisor.genericPoint_mem_smoothLocus hY) hK
  haveI : LocallyOfFiniteType (f ≫ sY) := hY'.1.toLocallyOfFiniteType
  haveI := hf.isDominant
  haveI : AlgebraicGeometry.IsVariety k sY := hY.1
  haveI : AlgebraicGeometry.IsVariety k (f ≫ sY) := hY'.1
  have hbij := hf.functionFieldMap_bijective
  have hdim : topologicalKrullDim Y' = n := by
    rw [← hK.topologicalKrullDim_eq]
    exact (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (f ≫ sY) hf).symm
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY)
    hK.topologicalKrullDim_eq
  refine ⟨divisorOfForm (pullbackRationalPluriForms sY f ω),
    isCanonicalDivisor_divisorOfForm hY'.1 hs hdim
      (pullbackRationalPluriForms_ne_zero sY hK.topologicalKrullDim_eq f hf hω0), ?_⟩
  refine Finsupp.ext fun Γ => ?_
  obtain ⟨E, heq, hiso, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hY hY' hf Γ
  rw [htr]
  change E.ordForm (pullbackRationalPluriForms sY f ω) = K.coeff Γ
  rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso f hbij hd E Γ heq ω, hω Γ]

end CanonicalOnModel

section ExceptionalSet

open MMP.Mori

/-- A prime divisor `P` of `Y` exceptional over `X` has its generic point in `Ex(f)`: over the
biregular locus of `f` the generic point of `P` goes to a point of coheight one. -/
private theorem genericPoint_mem_exceptionalSet {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [LocallyOfFiniteType sX] {n : ℕ}
    (hn : topologicalKrullDim X = n) {Y : Scheme.{u}} {f : Y ⟶ X} {P : MMP.Mori.PrimeDivisor Y}
    (h : MMP.Flips.IsExceptionalPrimeDivisor sX f P) :
    P.genericPoint ∈ (MMP.Mori.exceptionalSet f : Set Y) := by
  obtain ⟨hY, hf, hp, hexc⟩ := h
  set D := MMP.Flips.ProperDivisorOver.mk ⟨Y, f, hY, hf, P⟩ hp
  have h2 : 2 ≤ Order.coheight (f P.genericPoint) := by
    unfold MMP.Flips.ProperDivisorOver.IsExceptional at hexc
    rw [D.center_eq_toDivisorOver_center, D.toDivisorOver.center_eq_closure_genericPoint,
      hn] at hexc
    have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX (f P.genericPoint)
    rw [hn] at h
    exact (withBot_add_two_le_iff h).mp hexc
  by_contra hmem
  have hV : f P.genericPoint ∈ biregularLocus f := by
    by_contra hV
    exact hmem (mem_exceptionalSet.mpr hV)
  rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hV, P.coheight_genericPoint] at h2
  exact absurd h2 (by decide)

end ExceptionalSet

section QFactorial

open MMP.Flips in
/-- A real divisor on a scheme on which every Weil divisor has a Cartier multiple is a real
combination of Cartier divisors. -/
private theorem isCartierCombination_of_forall {X : Scheme.{u}} [IsLocallyNoetherian X]
    [IsNormal X] (hQ : ∀ D : Divisor X, ∃ m : ℕ, 0 < m ∧ ((m : ℤ) • D).IsCartier)
    (D : RDivisor X) : IsCartierCombination D := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => exact ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩
  | add D₁ D₂ h₁ h₂ =>
    obtain ⟨m₁, r₁, L₁, hL₁, rfl⟩ := h₁
    obtain ⟨m₂, r₂, L₂, hL₂, rfl⟩ := h₂
    refine ⟨m₁ + m₂, Fin.append r₁ r₂, Fin.append L₁ L₂, fun j => ?_, ?_⟩
    · refine Fin.addCases (motive := fun j => (Fin.append L₁ L₂ j).IsCartier)
        (fun i => by simpa using hL₁ i) (fun i => by simpa using hL₂ i) j
    · rw [Fin.sum_univ_add]
      simp
  | single P r =>
    obtain ⟨m, hm, hmc⟩ := hQ (Finsupp.single P 1)
    refine ⟨1, fun _ => r / m, fun _ => (m : ℤ) • Finsupp.single P 1, fun _ => hmc, ?_⟩
    have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
    ext Q
    simp only [Fin.sum_univ_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    change (Finsupp.single P r) Q = r / m * ((((m : ℤ) • Finsupp.single P (1 : ℤ)) Q : ℤ) : ℝ)
    by_cases hPQ : P = Q
    · subst hPQ
      simp [Finsupp.single_apply]
      field_simp
    · simp [Finsupp.single_apply, hPQ]

end QFactorial

/-! ### The setting, models with a fixed resolution, and pieces -/

section Pieces

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]

/-- The standing hypotheses on `π : X ⟶ Z`. -/
private structure IsSetting (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z)
    (KX : Divisor X) : Prop where
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ sX
  isProjectiveVariety_base : MMP.Mori.IsProjectiveVariety ℂ sZ
  isNormalVariety_base : IsNormalVariety ℂ sZ
  comp_eq : π ≫ sZ = sX
  isProjectiveMorphism : IsProjectiveMorphism π
  isBirationalMorphism : IsBirationalMorphism π
  dim_eq : topologicalKrullDim X = 4
  isQFactorial : IsQFactorial sX
  isCanonicalDivisor : ∃ m : ℕ, KX.IsCanonicalDivisor sX m

/-- A birational contraction `φ : X ⤏ Y` over `Z` to a normal projective `ℚ`-factorial variety,
together with a fixed common resolution `p : W ⟶ X`, `q : W ⟶ Y`. -/
private structure Model (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z) :
    Type 1 where
  Y : Scheme.{0}
  [isIntegral : IsIntegral Y]
  [compactSpace : CompactSpace Y]
  [isLocallyNoetherian : IsLocallyNoetherian Y]
  [isNormal : IsNormal Y]
  sY : Y ⟶ Spec (.of ℂ)
  πY : Y ⟶ Z
  KY : Divisor Y
  φ : X.RationalMap Y
  W : Scheme.{0}
  [isIntegral_res : IsIntegral W]
  [isLocallyNoetherian_res : IsLocallyNoetherian W]
  [isNormal_res : IsNormal W]
  sW : W ⟶ Spec (.of ℂ)
  p : W ⟶ X
  q : W ⟶ Y
  h : X.RationalMap W
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ sY
  isNormalVariety : IsNormalVariety ℂ sY
  isQFactorial : IsQFactorial sY
  isCanonicalDivisor : ∃ n : ℕ, KY.IsCanonicalDivisor sY n
  comp_eq : πY ≫ sZ = sY
  isBirational : MMP.Mori.RationalMap.IsBirational φ
  isOver : MMP.Flips.RationalMap.IsOver π πY φ
  not_isInverseExceptional : ∀ F : MMP.Mori.PrimeDivisor Y,
    ¬ MMP.Flips.RationalMap.IsInverseExceptional φ F

attribute [local instance] Model.isIntegral Model.compactSpace Model.isLocallyNoetherian
  Model.isNormal Model.isIntegral_res Model.isLocallyNoetherian_res Model.isNormal_res

variable {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}

/-- The model `M` is a klt log minimal model of `(X/Z, B)`, with the strict transform of `B`,
and its fixed resolution compares the adjoints with strict positivity along the contracted
primes. -/
private def Model.IsValidAt (M : Model sX sZ π) (KX : Divisor X) (B : RDivisor X) : Prop :=
  IsRealLogMinimalModel sX M.sY sZ π M.πY KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B) M.φ ∧
    IsRealKltPair M.sY (MMP.Mori.RationalMap.transformDivisor M.φ B) ∧
    ∃ GX GY : RDivisor M.W,
      IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
        (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h GX GY ∧
      ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M.φ P →
        ∀ P' : MMP.Mori.PrimeDivisor M.W,
          MMP.Mori.RationalMap.transformPrimeDivisor M.h P = some P' → 0 < (GX - GY).coeff P'

/-- The boundary `∑ wᵢ Vᵢ` of a weight vector `w`. -/
private noncomputable def wsum {n : ℕ} (V : Fin n → RDivisor X) (w : Fin n → ℝ) : RDivisor X :=
  ∑ i, w i • V i

/-- A *piece* for the boundaries `V`: a simplex in weight space, with vertices `c j`, and a model
which is valid at every point `∑ βⱼ cⱼ` with some `βⱼ > 0`, `j ∉ F`. -/
private structure Piece (sX : X ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sX]
    (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z) (KX : Divisor X) {n : ℕ} (V : Fin n → RDivisor X) :
    Type 1 where
  model : Model sX sZ π
  d : ℕ
  c : Fin d → Fin n → ℝ
  c_mem : ∀ j, c j ∈ stdSimplex ℝ (Fin n)
  F : Finset (Fin d)
  valid : ∀ β ∈ stdSimplex ℝ (Fin d), (∃ j ∉ F, 0 < β j) →
    model.IsValidAt KX (wsum V (∑ j, β j • c j))

/-- Finitely many pieces cover the set `S` of weights. -/
private def HasPieces (sX : X ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sX]
    (sZ : Z ⟶ Spec (.of ℂ)) (π : X ⟶ Z) (KX : Divisor X) {n : ℕ} (V : Fin n → RDivisor X)
    (S : Set (Fin n → ℝ)) : Prop :=
  ∃ (ι : Type) (_ : Finite ι) (P : ι → Piece sX sZ π KX V), ∀ w ∈ S, ∃ i,
    ∃ β ∈ stdSimplex ℝ (Fin (P i).d), (∃ j ∉ (P i).F, 0 < β j) ∧ w = ∑ j, β j • (P i).c j

variable {KX : Divisor X} {n : ℕ} {V : Fin n → RDivisor X}

private theorem HasPieces.mono {S S' : Set (Fin n → ℝ)} (h : HasPieces sX sZ π KX V S)
    (hS : S' ⊆ S) : HasPieces sX sZ π KX V S' := by
  obtain ⟨ι, hι, P, hP⟩ := h
  exact ⟨ι, hι, P, fun w hw => hP w (hS hw)⟩

private theorem hasPieces_empty : HasPieces sX sZ π KX V ∅ :=
  ⟨Empty, inferInstance, Empty.elim, fun _ h => h.elim⟩

private theorem HasPieces.union {S S' : Set (Fin n → ℝ)} (h : HasPieces sX sZ π KX V S)
    (h' : HasPieces sX sZ π KX V S') : HasPieces sX sZ π KX V (S ∪ S') := by
  obtain ⟨ι, hι, P, hP⟩ := h
  obtain ⟨ι', hι', P', hP'⟩ := h'
  refine ⟨ι ⊕ ι', inferInstance, Sum.elim P P', fun w hw => ?_⟩
  rcases hw with hw | hw
  · obtain ⟨i, hi⟩ := hP w hw
    exact ⟨Sum.inl i, hi⟩
  · obtain ⟨i, hi⟩ := hP' w hw
    exact ⟨Sum.inr i, hi⟩

private theorem hasPieces_biUnion {α : Type*} (s : Finset α) (S : α → Set (Fin n → ℝ))
    (h : ∀ a ∈ s, HasPieces sX sZ π KX V (S a)) :
    HasPieces sX sZ π KX V (⋃ a ∈ s, S a) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hasPieces_empty
  | insert a s ha ih =>
    rw [Finset.set_biUnion_insert]
    exact (h a (Finset.mem_insert_self a s)).union
      (ih fun b hb => h b (Finset.mem_insert_of_mem hb))

end Pieces

/-! ### Convex combinations of klt boundaries -/

section Algebra

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)}

private theorem coeff_wsum {n : ℕ} (V : Fin n → RDivisor X) (w : Fin n → ℝ)
    (P : MMP.Mori.PrimeDivisor X) : (wsum V w).coeff P = ∑ i, w i * (V i).coeff P := by
  simp [wsum, DivisorWithCoeffs.coeff, Finsupp.finsetSum_apply]

/-- **Adding Cartier divisors to the boundary.** For Cartier divisors `Cᵢ` and a divisor `D` over
`X` there are numbers `μᵢ` (the coefficients along `D` of the pull-backs of the `Cᵢ`) such that a
log discrepancy `a` of `D` for `(X, B)` gives the log discrepancy `a - ∑ sᵢ μᵢ` for
`(X, B + ∑ sᵢ Cᵢ)`. -/
private theorem exists_isLogDiscrepancy_add {ι : Type*} [Fintype ι] (C : ι → Divisor X)
    (hC : ∀ i, (C i).IsCartier) (D : DivisorOver ℂ sX) :
    ∃ μ : ι → ℝ, ∀ (n : ℕ) (B B' : RDivisor X) (s : ι → ℝ) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n B D a →
      (∀ Γ, B'.coeff Γ = B.coeff Γ + ∑ i, s i * ((C i).coeff Γ : ℝ)) →
      MMP.Intersection.IsLogDiscrepancy sX n B' D (a - ∑ i, s i * μ i) := by
  classical
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isIntegral
  have := D.isBirationalMorphism.isDominant
  have : CompactSpace D.Y := (D.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := fun i => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp D.f (C i)
  choose C' hC' using fun i => (hC i).exists_isPullback (hB i)
  refine ⟨fun i => ((C' i).coeff D.E : ℝ), fun n B B' s a h hB' => ?_⟩
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₀, C₀', hC₀, hrel, hpb, ha⟩ := h
  let e := Fintype.equivFin ι
  refine ⟨hnv, hprop, ω, hω0, hK, m + Fintype.card ι, Fin.append r (s ∘ e.symm),
    Fin.append C₀ (C ∘ e.symm), Fin.append C₀' (C' ∘ e.symm), ?_, ?_, ?_, ?_⟩
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hC₀ j
    · simpa using hC (e.symm j)
  · intro Γ
    rw [Fin.sum_univ_add, hB', ← add_assoc, hrel Γ]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    congr 1
    exact (e.symm.sum_comp (fun i => s i * ((C i).coeff Γ : ℝ))).symm
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hpb j
    · rw [Fin.append_right, Fin.append_right]
      exact ⟨hB _, hC' _⟩
  · rw [ha, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    rw [e.symm.sum_comp (fun i => s i * ((C' i).coeff D.E : ℝ))]
    ring

/-- A weight in the standard simplex has a positive entry. -/
private theorem exists_pos_of_mem_stdSimplex {n : ℕ} {w : Fin n → ℝ}
    (hw : w ∈ stdSimplex ℝ (Fin n)) : ∃ i, 0 < w i := by
  by_contra h
  push Not at h
  have : ∑ i, w i ≤ 0 := Finset.sum_nonpos fun i _ => h i
  linarith [hw.2]

/-- **Convex combinations of klt boundaries are klt** on a `ℚ`-factorial variety. -/
private theorem isRealKltPair_wsum (hXq : IsQFactorial sX) {n : ℕ} {V : Fin n → RDivisor X}
    (hV : ∀ i, IsRealKltPair sX (V i)) {w : Fin n → ℝ} (hw : w ∈ stdSimplex ℝ (Fin n)) :
    IsRealKltPair sX (wsum V w) := by
  classical
  obtain ⟨i₀, hi₀⟩ := exists_pos_of_mem_stdSimplex hw
  obtain ⟨hXn, -, ⟨n₀, K, hK, -⟩, -⟩ := hV i₀
  refine ⟨hXn, fun P => ?_, ⟨n₀, K, hK, hXq.isRCartier _⟩, fun d D a ha => ?_⟩
  · rw [coeff_wsum]
    have : ∑ i, w i * (V i).coeff P < ∑ i, w i * 1 :=
      Finset.sum_lt_sum (fun i _ => mul_le_mul_of_nonneg_left ((hV i).2.1 P).le (hw.1 i))
        ⟨i₀, Finset.mem_univ _, mul_lt_mul_of_pos_left ((hV i₀).2.1 P) hi₀⟩
    simpa [hw.2] using this
  set S : Finset (MMP.Mori.PrimeDivisor X) := Finset.univ.biUnion fun i => (V i).support
  choose m hm hmC using fun P : MMP.Mori.PrimeDivisor X => hXq.2 (Finsupp.single P 1)
  let C : S → Divisor X := fun P =>
    ((m P : ℕ) : ℤ) • Finsupp.single (P : MMP.Mori.PrimeDivisor X) (1 : ℤ)
  obtain ⟨μ, hμ⟩ := exists_isLogDiscrepancy_add C (fun P => hmC P) D
  let s : Fin n → S → ℝ := fun i P => ((V i).coeff P - (wsum V w).coeff P) / m P
  have hCΓ : ∀ (P : S) (Γ : MMP.Mori.PrimeDivisor X),
      ((C P).coeff Γ : ℝ) = if (P : MMP.Mori.PrimeDivisor X) = Γ then (m P : ℝ) else 0 := by
    intro P Γ
    simp only [C, DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, Finsupp.single_apply,
      smul_eq_mul]
    split_ifs <;> simp
  have hnotS : ∀ Γ, Γ ∉ S → ∀ i, (V i).coeff Γ = 0 := fun Γ hΓ i => by
    by_contra h
    exact hΓ (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, Finsupp.mem_support_iff.mpr h⟩)
  have hai : ∀ i, 0 < a - ∑ P, s i P * μ P := fun i =>
    (hV i).2.2.2 d D _ (hμ d _ _ (s i) a ha fun Γ => by
      simp_rw [hCΓ, mul_ite, mul_zero]
      by_cases hΓ : Γ ∈ S
      · rw [Finset.sum_eq_single ⟨Γ, hΓ⟩ (fun P _ hP => if_neg fun h => hP (Subtype.ext h))
          (fun h => (h (Finset.mem_univ _)).elim), if_pos rfl]
        have : (m Γ : ℝ) ≠ 0 := by exact_mod_cast (hm Γ).ne'
        simp only [s]
        field_simp
        ring
      · have h0 : ∑ P : S, (if (P : MMP.Mori.PrimeDivisor X) = Γ then s i P * (m P : ℝ) else 0)
            = 0 := Finset.sum_eq_zero fun (P : S) _ => if_neg fun h => hΓ (by rw [← h]; exact P.2)
        rw [h0, add_zero, hnotS Γ hΓ i, coeff_wsum,
          Finset.sum_eq_zero fun j _ => by rw [hnotS Γ hΓ j, mul_zero]])
  have hsum : ∑ i, w i * (a - ∑ P, s i P * μ P) = a := by
    have h0 : ∀ P : S, ∑ i, w i * s i P = 0 := fun P => by
      simp only [s, mul_div_assoc', ← Finset.sum_div, mul_sub, Finset.sum_sub_distrib,
        ← Finset.sum_mul, hw.2, one_mul, ← coeff_wsum, sub_self, zero_div]
    simp only [mul_sub, Finset.mul_sum, Finset.sum_sub_distrib, ← Finset.sum_mul, hw.2, one_mul]
    rw [Finset.sum_comm]
    simp only [← mul_assoc, ← Finset.sum_mul, h0, zero_mul, Finset.sum_const_zero, sub_zero]
  rw [← hsum]
  exact Finset.sum_pos' (fun i _ => mul_nonneg (hw.1 i) (hai i).le)
    ⟨i₀, Finset.mem_univ _, mul_pos hi₀ (hai i₀)⟩

private theorem coeff_wsum_nonneg {n : ℕ} {V : Fin n → RDivisor X}
    (hV : ∀ i P, 0 ≤ (V i).coeff P) {w : Fin n → ℝ} (hw : w ∈ stdSimplex ℝ (Fin n))
    (P : MMP.Mori.PrimeDivisor X) : 0 ≤ (wsum V w).coeff P := by
  rw [coeff_wsum]
  exact Finset.sum_nonneg fun i _ => mul_nonneg (hw.1 i) (hV i P)

end Algebra

attribute [local instance] Model.isIntegral Model.compactSpace Model.isLocallyNoetherian
  Model.isNormal Model.isIntegral_res Model.isLocallyNoetherian_res Model.isNormal_res

/-! ### Building valid models -/

section Models

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X}

/-- The strict transform of an effective divisor is effective. -/
private theorem coeff_transformDivisor_nonneg {Y : Scheme.{0}} (φ : X.RationalMap Y)
    {B : RDivisor X} (hB : ∀ P, 0 ≤ B.coeff P) (F : MMP.Mori.PrimeDivisor Y) :
    0 ≤ (MMP.Mori.RationalMap.transformDivisor φ B).coeff F := by
  classical
  conv_rhs => rw [← Finsupp.sum_single B]
  rw [Finsupp.sum, map_sum, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
  refine Finset.sum_nonneg fun P _ => ?_
  rw [MMP.Mori.RationalMap.transformDivisor_single]
  cases h : MMP.Mori.RationalMap.transformPrimeDivisor φ P with
  | none => simp
  | some E =>
    simp only [Option.elim_some, Finsupp.single_apply]
    split_ifs
    exacts [hB P, le_rfl]

/-- A klt pair with effective boundary is dlt. -/
private theorem isRealDltPair_of_isRealKltPair {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} {B : RDivisor Y}
    (h0 : ∀ P, 0 ≤ B.coeff P) (h : IsRealKltPair sY B) : IsRealDltPair sY B := by
  obtain ⟨hYn, h1, ⟨n, K, hK, hRC⟩, hklt⟩ := h
  refine ⟨⟨hYn, h0, ⟨n, K, hK, ?_⟩, fun d E a ha => (hklt d E a ha).le⟩,
    fun F => (h1 F).le, ⊤, ?_, ?_, fun d E _ a ha => hklt d E a ha⟩
  · obtain ⟨m, r, L, hLc, hsum⟩ := hRC
    exact ⟨m, r, L, hLc, fun Γ => hsum Γ⟩
  · have hE : ∀ x : Scheme.Opens.toScheme (X := Y) (⊤ : Closeds Y).compl, False :=
      fun x => x.2 trivial
    exact Opens.ext (Set.ext fun x => (hE x).elim)
  · have hE : ∀ x : Scheme.Opens.toScheme (X := Y) (⊤ : Closeds Y).compl, False :=
      fun x => x.2 trivial
    exact ⟨fun E _ => (hE E.genericPoint).elim, fun x => (hE x).elim⟩

/-- **Assembling a valid model.** A model whose fixed resolution compares the adjoints of an
effective klt pair `(X, B)` with strict positivity along the contracted primes, whose transformed
adjoint is nef over `Z` and whose transformed pair is klt, is valid at `B`. -/
private theorem Model.isValidAt_of (M : Model sX sZ π) {B : RDivisor X}
    (hKX : ∃ n : ℕ, KX.IsCanonicalDivisor sX n) (hπ : π ≫ sZ = sX)
    (hB0 : ∀ P, 0 ≤ B.coeff P) (hBklt : IsRealKltPair sX B) {GX GY : RDivisor M.W}
    (hR : IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h GX GY)
    (hpos : ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M.φ P →
      ∀ P' : MMP.Mori.PrimeDivisor M.W,
        MMP.Mori.RationalMap.transformPrimeDivisor M.h P = some P' → 0 < (GX - GY).coeff P')
    (hnef : IsRelativelyNef ℂ M.sY M.πY
      (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ B)))
    (hYklt : IsRealKltPair M.sY (MMP.Mori.RationalMap.transformDivisor M.φ B)) :
    M.IsValidAt KX B := by
  refine ⟨?_, hYklt, GX, GY, hR, hpos⟩
  have hres : ∃ (W' : Scheme.{0}) (_ : IsIntegral W') (_ : IsLocallyNoetherian W')
      (_ : IsNormal W') (sW' : W' ⟶ Spec (.of ℂ)) (p' : W' ⟶ X) (q' : W' ⟶ M.Y)
      (h' : X.RationalMap W') (GX GY : RDivisor W'),
      IsLogComparisonResolution sX M.sY sW' M.φ KX B M.KY
        (MMP.Mori.RationalMap.transformDivisor M.φ B) p' q' h' GX GY :=
    ⟨M.W, inferInstance, inferInstance, inferInstance, M.sW, M.p, M.q, M.h, GX, GY, hR⟩
  obtain ⟨hXn, h1, ⟨n, K, hK, hRC⟩, hklt⟩ := hBklt
  exact
    { isRealLcPair := ⟨hXn, hB0, ⟨n, K, hK, by
        obtain ⟨m, r, L, hLc, hsum⟩ := hRC
        exact ⟨m, r, L, hLc, fun Γ => hsum Γ⟩⟩, fun d E a ha => (hklt d E a ha).le⟩
      isCanonicalDivisor := hKX
      comp_eq := hπ
      isNormalVariety_model := M.isNormalVariety
      isCanonicalDivisor_model := M.isCanonicalDivisor
      isProjectiveVariety_model := M.isProjectiveVariety
      comp_eq_model := M.comp_eq
      isQFactorial := M.isQFactorial
      isRealDltPair := isRealDltPair_of_isRealKltPair
        (coeff_transformDivisor_nonneg M.φ hB0) hYklt
      isBirational := M.isBirational
      isOver := M.isOver
      coeff_boundary := fun F => by rw [if_neg (M.not_isInverseExceptional F), add_zero]
      isRelativelyNef := hnef
      exists_resolution := hres
      exists_resolution_pos :=
        ⟨M.W, inferInstance, inferInstance, inferInstance, M.sW, M.p, M.q, M.h, GX, GY, hR,
          hpos⟩ }

/-- **The central model.** An effective klt pair `(X, B)` in the setting has a valid model, by
`MMP.Fourfold.exists_isRealLogMinimalModel_of_isBirationalMorphism`. -/
private theorem exists_model_isValidAt (hS : IsSetting sX sZ π KX) {B : RDivisor X}
    (hB0 : ∀ P, 0 ≤ B.coeff P) (hklt : IsRealKltPair sX B) :
    ∃ M : Model sX sZ π, M.IsValidAt KX B := by
  obtain ⟨Y, _, _, _, _, sY, πY, KY, BY, φ, hmodel, hkltY, hnoext⟩ :=
    exists_isRealLogMinimalModel_of_isBirationalMorphism hS.isProjectiveVariety
      hS.isProjectiveVariety_base hS.isNormalVariety_base hS.comp_eq hS.isProjectiveMorphism
      hS.isBirationalMorphism hS.dim_eq hS.isQFactorial hS.isCanonicalDivisor hB0 hklt
  obtain rfl : BY = MMP.Mori.RationalMap.transformDivisor φ B := by
    refine DivisorWithCoeffs.ext' fun F => ?_
    rw [hmodel.coeff_boundary F, if_neg (hnoext F), add_zero]
  obtain ⟨W, _, _, _, sW, p, q, h, GX, GY, hR, hpos⟩ := hmodel.exists_resolution_pos
  let M : Model sX sZ π :=
    { Y := Y, sY := sY, πY := πY, KY := KY, φ := φ, W := W, sW := sW, p := p, q := q, h := h
      isProjectiveVariety := hmodel.isProjectiveVariety_model
      isNormalVariety := hmodel.isNormalVariety_model
      isQFactorial := hmodel.isQFactorial
      isCanonicalDivisor := hmodel.isCanonicalDivisor_model
      comp_eq := hmodel.comp_eq_model
      isBirational := hmodel.isBirational
      isOver := hmodel.isOver
      not_isInverseExceptional := hnoext }
  exact ⟨M, hmodel, hkltY, GX, GY, hR, hpos⟩

/-- The single weight `w₀` is covered by one piece, if some model is valid at `∑ w⁰ᵢ Vᵢ`. -/
private theorem hasPieces_singleton {n : ℕ} {V : Fin n → RDivisor X} {w₀ : Fin n → ℝ}
    (hw₀ : w₀ ∈ stdSimplex ℝ (Fin n)) {M : Model sX sZ π} (hM : M.IsValidAt KX (wsum V w₀)) :
    HasPieces sX sZ π KX V {w₀} := by
  have hc : ∀ β ∈ stdSimplex ℝ (Fin 1), ∑ j, β j • (fun _ : Fin 1 => w₀) j = w₀ :=
    fun β hβ => by
      have h1 : β 0 = 1 := by simpa using hβ.2
      simp [h1]
  refine ⟨Unit, inferInstance, fun _ => ⟨M, 1, fun _ => w₀, fun _ => hw₀, ∅,
    fun β hβ _ => by rw [hc β hβ]; exact hM⟩, fun w hw => ⟨(), fun _ => 1, ?_, ?_, ?_⟩⟩
  · exact ⟨fun _ => zero_le_one, by simp⟩
  · exact ⟨0, Finset.notMem_empty _, one_pos⟩
  · rw [Set.mem_singleton_iff.mp hw]
    simp

end Models

/-! ### Strict transforms through a common resolution -/

section ResolutionTransforms

open MMP.Flips

variable {X W Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsIntegral Y] [IsLocallyNoetherian Y]
  [IsNormal Y] {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)}

/-- A prime divisor with a divisorial transform is not contracted. -/
private theorem not_isExceptional_of_transformPrimeDivisor_eq_some {X Y : Scheme.{0}}
    {φ : X.RationalMap Y} {P : MMP.Mori.PrimeDivisor X} {F : MMP.Mori.PrimeDivisor Y}
    (h : MMP.Mori.RationalMap.transformPrimeDivisor φ P = some F) :
    ¬ MMP.Mori.RationalMap.IsExceptional φ P := by
  rw [MMP.Mori.RationalMap.isExceptional_iff]
  intro hex
  have h2 := hex (MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h).1
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight,
    ← MMP.Mori.RationalMap.support_transformPrimeDivisor h] at h2
  have h3 := h2 F.genericPoint (by
    change F.genericPoint ∈ F.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl)
  rw [F.coheight_genericPoint] at h3
  exact absurd h3 (by decide)

/-- Through a common resolution `p : W ⟶ X`, `q : W ⟶ Y` of `φ = q ∘ p⁻¹`, the transform of a
prime divisor `P` of `X` is `F` exactly when `q` maps the strict transform of `P` onto `F`. -/
private theorem transformPrimeDivisor_compHom_eq_some_iff (hX : IsNormalVariety ℂ sX)
    (p : W ⟶ X) (h : X.RationalMap W) [IsProper p] (hWp : IsNormalVariety ℂ (p ≫ sX))
    (hpb : IsBirationalMorphism p) (hinv : RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y)
    [IsSeparated (Y ↘ ⊤_ Scheme)] {P : MMP.Mori.PrimeDivisor X} {PW : MMP.Mori.PrimeDivisor W}
    (hPW : p PW.genericPoint = P.genericPoint) (F : MMP.Mori.PrimeDivisor Y) :
    MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P = some F ↔
      q PW.genericPoint = F.genericPoint := by
  have := hX.1
  have := hWp.1
  have := isSeparated_toTerminal sX
  have := isSeparated_toTerminal (p ≫ sX)
  have : IsSeparated p := IsSeparated.of_comp p sX
  have : IsDominant p := hpb.isDominant
  obtain ⟨P', h1, h2, -⟩ := exists_transformPrimeDivisor_eq_some_of_isInverse hX p h hWp hpb hinv P
  obtain rfl : P' = PW := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_genericPoint p hpb.functionFieldMap_bijective h2 hPW)
  rw [transformPrimeDivisor_compHom h1 q,
    MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff]

/-- The transform through a common resolution is injective on prime divisors. -/
private theorem eq_of_transformPrimeDivisor_compHom_eq_some (hX : IsNormalVariety ℂ sX)
    (hY : IsNormalVariety ℂ sY) (p : W ⟶ X) (h : X.RationalMap W) [IsProper p]
    (hWp : IsNormalVariety ℂ (p ≫ sX)) (hpb : IsBirationalMorphism p)
    (hinv : RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y) (hqs : q ≫ sY = p ≫ sX)
    (hqb : IsBirationalMorphism q) {P P' : MMP.Mori.PrimeDivisor X}
    {F : MMP.Mori.PrimeDivisor Y}
    (h1 : MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P = some F)
    (h2 : MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P' = some F) : P = P' := by
  have := hX.1
  have := hY.1
  have := hWp.1
  have := isSeparated_toTerminal sX
  have := isSeparated_toTerminal sY
  have := isSeparated_toTerminal (p ≫ sX)
  have : IsSeparated p := IsSeparated.of_comp p sX
  have : IsSeparated q := by
    have : IsSeparated (q ≫ sY) := by rw [hqs]; infer_instance
    exact IsSeparated.of_comp q sY
  have : IsDominant p := hpb.isDominant
  have : IsDominant q := hqb.isDominant
  obtain ⟨PW, -, hPW, -⟩ := exists_transformPrimeDivisor_eq_some_of_isInverse hX p h hWp hpb hinv P
  obtain ⟨PW', -, hPW', -⟩ :=
    exists_transformPrimeDivisor_eq_some_of_isInverse hX p h hWp hpb hinv P'
  have e1 := (transformPrimeDivisor_compHom_eq_some_iff hX p h hWp hpb hinv q hPW F).mp h1
  have e2 := (transformPrimeDivisor_compHom_eq_some_iff hX p h hWp hpb hinv q hPW' F).mp h2
  obtain rfl : PW' = PW := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_genericPoint q hqb.functionFieldMap_bijective e2 e1)
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hPW.symm.trans hPW')

/-- **A prime divisor without divisorial transform is contracted.** Through a common resolution
`p : W ⟶ X`, `q : W ⟶ Y`, a prime divisor of `X` whose transform under `q ∘ p⁻¹` is not a prime
divisor of `Y` is exceptional. -/
private theorem isExceptional_of_transformPrimeDivisor_compHom_eq_none
    (hX : IsNormalVariety ℂ sX) (hY : IsNormalVariety ℂ sY) {n : ℕ}
    (hdimY : topologicalKrullDim Y = n) (p : W ⟶ X) (h : X.RationalMap W) [IsProper p]
    (hWp : IsNormalVariety ℂ (p ≫ sX)) (hpb : IsBirationalMorphism p)
    (hinv : RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y) [IsProper q]
    (hWq : IsNormalVariety ℂ (q ≫ sY)) (hqb : IsBirationalMorphism q)
    {P : MMP.Mori.PrimeDivisor X}
    (hP : MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P = none) :
    MMP.Mori.RationalMap.IsExceptional (h.compHom q) P := by
  by_contra hnex
  have := hX.1
  have := hY.1
  have := hWp.1
  have : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  have := isSeparated_toTerminal sY
  have := isSeparated_toTerminal (p ≫ sX)
  obtain ⟨E, h', hh'P, hh', hwE, -, -⟩ := exists_strictTransform hX p h hWp hpb hinv P
  have hcoh := MMP.Fourfold.SamePrimes.coheight_apply_le_one_of_not_isExceptional q h'
    (by rw [Scheme.RationalMap.compHom_toRationalMap, hh']) hh'P hnex
  rw [← hwE] at hcoh
  have hnexc : ¬ IsExceptionalPrimeDivisor sY q E := by
    rintro ⟨hV, hf, hp, hexc⟩
    have h2 := (isExceptional_iff_two_le_coheight hdimY
      (ProperDivisorOver.mk ⟨W, q, hV, hf, E⟩ hp)).mp hexc
    change 2 ≤ Order.coheight (q E.genericPoint) at h2
    exact absurd (h2.trans hcoh) (by decide)
  obtain ⟨F, hF, -, -⟩ :=
    MMP.Fourfold.exists_transformDivisor_apply_eq_of_not_isExceptionalPrimeDivisor hY q hWq hqb E
      hnexc
  have hPE : MMP.Mori.RationalMap.transformPrimeDivisor h P = some E :=
    transformPrimeDivisor_eq_some_of_genericPoint_eq h' hh' hh'P hwE
  rw [transformPrimeDivisor_compHom hPE q,
    (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff q E F).mpr hF] at hP
  exact Option.some_ne_none _ hP

/-- Through a common resolution, a prime divisor of `Y` which is not extracted is the transform
of exactly the prime divisor of `X` whose strict transform maps onto it; consequently the
coefficient of `F` in the transform of `D` is the coefficient of that prime in `D`. -/
private theorem coeff_transformDivisor_compHom (hX : IsNormalVariety ℂ sX)
    (hY : IsNormalVariety ℂ sY) (p : W ⟶ X) (h : X.RationalMap W) [IsProper p]
    (hWp : IsNormalVariety ℂ (p ≫ sX)) (hpb : IsBirationalMorphism p)
    (hinv : RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y) (hqs : q ≫ sY = p ≫ sX)
    (hqb : IsBirationalMorphism q) {P : MMP.Mori.PrimeDivisor X} {F : MMP.Mori.PrimeDivisor Y}
    (hPF : MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) P = some F)
    (D : RDivisor X) :
    (MMP.Mori.RationalMap.transformDivisor (h.compHom q) D).coeff F = D.coeff P :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hPF
    (fun P' hP' => eq_of_transformPrimeDivisor_compHom_eq_some hX hY p h hWp hpb hinv q hqs hqb
      hP' hPF) D

end ResolutionTransforms

/-! ### Transforms along composites of birational morphisms -/

section MorphismTransforms

variable {X W V : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsIntegral V] [IsLocallyNoetherian V]
  [IsNormal V] {sX : X ⟶ Spec (.of ℂ)}

/-- The coefficient of the transform along a proper birational morphism `f` at a prime divisor
`Q` is the coefficient at any prime divisor lying over `Q`. -/
private theorem transformDivisor_toRationalMap_apply_of_map_eq (hX : IsNormalVariety ℂ sX)
    (f : W ⟶ X) [IsProper f] (hW : IsNormalVariety ℂ (f ≫ sX)) (hf : IsBirationalMorphism f)
    {E : MMP.Mori.PrimeDivisor W} {Q : MMP.Mori.PrimeDivisor X}
    (hE : f E.genericPoint = Q.genericPoint) {R : Type} [AddCommMonoid R]
    (D : DivisorWithCoeffs R W) :
    MMP.Mori.RationalMap.transformDivisor f.toRationalMap D Q = D E := by
  have := hX.1
  have := hW.1
  have := isSeparated_toTerminal sX
  have : IsSeparated f := IsSeparated.of_comp f sX
  have : IsDominant f := hf.isDominant
  obtain ⟨E', hE', -, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hW hf Q
  obtain rfl : E' = E := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_genericPoint f hf.functionFieldMap_bijective hE' hE)
  exact htr D

/-- The transform along a composite of proper birational morphisms of normal varieties is the
composite of the transforms. -/
private theorem transformDivisor_comp_toRationalMap (hX : IsNormalVariety ℂ sX) (f : W ⟶ X)
    (g : V ⟶ W) [IsProper f] [IsProper g] (hW : IsNormalVariety ℂ (f ≫ sX))
    (hV : IsNormalVariety ℂ (g ≫ f ≫ sX)) (hf : IsBirationalMorphism f)
    (hg : IsBirationalMorphism g) {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R V) :
    MMP.Mori.RationalMap.transformDivisor (g ≫ f).toRationalMap D =
      MMP.Mori.RationalMap.transformDivisor f.toRationalMap
        (MMP.Mori.RationalMap.transformDivisor g.toRationalMap D) := by
  have := hX.1
  have := hV.1
  have := isSeparated_toTerminal sX
  have : IsSeparated (g ≫ f) := IsSeparated.of_comp (g ≫ f) sX
  have hgf := isBirationalMorphism_comp hg hf
  have : IsDominant (g ≫ f) := hgf.isDominant
  have hV' : IsNormalVariety ℂ ((g ≫ f) ≫ sX) := by rw [Category.assoc]; exact hV
  refine Finsupp.ext fun Q => ?_
  obtain ⟨E, hE, -, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hV' hgf Q
  obtain ⟨EW, hEW, -, htrW⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hW hf Q
  obtain ⟨E', hE', -, htr'⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hW hV hg EW
  obtain rfl : E' = E := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_genericPoint (g ≫ f) hgf.functionFieldMap_bijective
      (by change f (g _) = _; rw [hE']; exact hEW) hE)
  rw [htr D, htrW, htr' D]

end MorphismTransforms

/-! ### Composite models -/

section CompositeModel

open MMP.Flips

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X}

/-- **Composite models.** Let `M₀ : X ⤏ Y₀` be a model over `Z` and `M : Y₀ ⤏ Y₁` a model of
`Y₀` over `Z`. There is a model `M' : X ⤏ Y₁` over `Z` which is valid at every effective klt
boundary `B` of `X` at which `M` is valid for the transform `φ₀_* B`, provided the comparison of
`(X, B)` and `(Y₀, φ₀_* B)` on the resolution of `M₀` is positive along the primes contracted by
`φ₀`. The common resolution of `M'` dominates both resolutions. -/
private theorem exists_model_comp (hS : IsSetting sX sZ π KX) (M0 : Model sX sZ π)
    {B0 : RDivisor X} {G0 G0' : RDivisor M0.W}
    (hR0 : IsLogComparisonResolution sX M0.sY M0.sW M0.φ KX B0 M0.KY
      (MMP.Mori.RationalMap.transformDivisor M0.φ B0) M0.p M0.q M0.h G0 G0')
    [LocallyOfFiniteType M0.sY] (M : Model M0.sY sZ M0.πY) {C0 : RDivisor M0.Y}
    {H0 H0' : RDivisor M.W}
    (hRM : IsLogComparisonResolution M0.sY M.sY M.sW M.φ M0.KY C0 M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ C0) M.p M.q M.h H0 H0') :
    ∃ M' : Model sX sZ π, ∀ B : RDivisor X, (∀ P, 0 ≤ B.coeff P) → IsRealKltPair sX B →
      M.IsValidAt M0.KY (MMP.Mori.RationalMap.transformDivisor M0.φ B) →
      (∀ G G' : RDivisor M0.W, IsRCartierPullback M0.p (logCanonicalDivisor KX B) G →
        IsRCartierPullback M0.q
          (logCanonicalDivisor M0.KY (MMP.Mori.RationalMap.transformDivisor M0.φ B)) G' →
        ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M0.φ P →
          ∀ P' : MMP.Mori.PrimeDivisor M0.W,
            MMP.Mori.RationalMap.transformPrimeDivisor M0.h P = some P' →
              0 < (G - G').coeff P') →
      M'.IsValidAt KX B := by
  classical
  -- the varieties
  have hXp := hS.isProjectiveVariety
  have hXn : IsNormalVariety ℂ sX := ⟨hXp.toIsVariety, inferInstance⟩
  have hY0n := M0.isNormalVariety
  have hY0p := M0.isProjectiveVariety
  have hY1n := M.isNormalVariety
  have hY1p := M.isProjectiveVariety
  have hZp := hS.isProjectiveVariety_base
  have hW1n : IsNormalVariety ℂ M0.sW := ⟨hR0.isVariety, inferInstance⟩
  have hWn : IsNormalVariety ℂ M.sW := ⟨hRM.isVariety, inferInstance⟩
  have hW1np : IsNormalVariety ℂ (M0.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hW1n
  have hW1nq : IsNormalVariety ℂ (M0.q ≫ M0.sY) := by rw [hR0.comp_eq_right]; exact hW1n
  have hWnp : IsNormalVariety ℂ (M.p ≫ M0.sY) := by rw [hRM.comp_eq_left]; exact hWn
  have hWnq : IsNormalVariety ℂ (M.q ≫ M.sY) := by rw [hRM.comp_eq_right]; exact hWn
  have hp1b := hR0.isBirationalMorphism_left
  have hq1b := hR0.isBirationalMorphism_right
  have hp2b := hRM.isBirationalMorphism_left
  have hq2b := hRM.isBirationalMorphism_right
  haveI : IsProper M0.p := isProper_of_isProjectiveMorphism _ hR0.isProjectiveMorphism_left
  haveI : IsProper M0.q := isProper_of_isProjectiveMorphism _ hR0.isProjectiveMorphism_right
  haveI : IsProper M.p := isProper_of_isProjectiveMorphism _ hRM.isProjectiveMorphism_left
  haveI : IsProper M.q := isProper_of_isProjectiveMorphism _ hRM.isProjectiveMorphism_right
  haveI : IsDominant M0.p := hp1b.isDominant
  haveI : IsDominant M0.q := hq1b.isDominant
  haveI : IsDominant M.p := hp2b.isDominant
  haveI : IsDominant M.q := hq2b.isDominant
  haveI := hXn.1
  haveI := hY0n.1
  haveI := hY1n.1
  haveI := hW1n.1
  haveI := hWn.1
  haveI : IsSeparated sX := hXn.1.toIsSeparated
  haveI : IsSeparated M0.sY := hY0n.1.toIsSeparated
  haveI : IsSeparated M.sY := hY1n.1.toIsSeparated
  haveI : IsSeparated M0.sW := hW1n.1.toIsSeparated
  haveI : IsSeparated M.sW := hWn.1.toIsSeparated
  haveI : LocallyOfFiniteType M.sY := hY1n.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType M0.sW := hW1n.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType M.sW := hWn.1.toLocallyOfFiniteType
  haveI : QuasiCompact M0.sW := hW1n.1.toQuasiCompact
  haveI : QuasiCompact M.sW := hWn.1.toQuasiCompact
  haveI : CompactSpace M0.W := QuasiCompact.compactSpace_of_compactSpace M0.sW
  haveI : CompactSpace M.W := QuasiCompact.compactSpace_of_compactSpace M.sW
  have := isSeparated_toTerminal sX
  have := isSeparated_toTerminal M0.sY
  have := isSeparated_toTerminal M.sY
  have := isSeparated_toTerminal sZ
  have := isSeparated_toTerminal M0.sW
  have := isSeparated_toTerminal M.sW
  haveI : IsSeparated M0.p := IsSeparated.of_comp M0.p sX
  haveI : IsSeparated M0.q := by
    have : IsSeparated (M0.q ≫ M0.sY) := by rw [hR0.comp_eq_right]; infer_instance
    exact IsSeparated.of_comp M0.q M0.sY
  haveI : IsSeparated M.p := IsSeparated.of_comp M.p M0.sY
  haveI : IsSeparated M.q := by
    have : IsSeparated (M.q ≫ M.sY) := by rw [hRM.comp_eq_right]; infer_instance
    exact IsSeparated.of_comp M.q M.sY
  -- the common resolution `V` of `W₁ ⟶ Y₀ ⟵ W`
  obtain ⟨V, r, s, hVn, hVsm, hrs, hrp, hrb, hsp, hsb⟩ :=
    MMP.Fourfold.exists_common_model_over (k := ℂ) M0.sY M0.q M.p hq1b hp2b hW1nq hWnp
  haveI : IsIntegral V := hVn.1.toIsIntegral
  haveI : IsLocallyNoetherian V := hVn.1.toLocallyOfFiniteType.isLocallyNoetherian
  haveI : IsNormal V := hVn.2
  set sV : V ⟶ Spec (.of ℂ) := s ≫ M.sW with hsV
  have hVn' : IsNormalVariety ℂ sV := by rw [hsV, ← hRM.comp_eq_left]; exact hVn
  have hVsm' : IsSmoothScheme sV := by rw [hsV, ← hRM.comp_eq_left]; exact hVsm
  haveI := hVn'.1
  haveI : IsProper r := isProper_of_isProjectiveMorphism r hrp
  haveI : IsProper s := isProper_of_isProjectiveMorphism s hsp
  haveI : IsDominant r := hrb.isDominant
  haveI : IsDominant s := hsb.isDominant
  haveI : LocallyOfFiniteType sV := hVn'.1.toLocallyOfFiniteType
  haveI : QuasiCompact sV := hVn'.1.toQuasiCompact
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace sV
  haveI : IsSeparated sV := hVn'.1.toIsSeparated
  have := isSeparated_toTerminal sV
  have hrsV : r ≫ M0.sW = sV := by
    rw [hsV, ← hRM.comp_eq_left, ← hR0.comp_eq_right, ← Category.assoc, hrs, Category.assoc]
  -- the composite resolution `p₀ = r ≫ p₁`, `q₀ = s ≫ q₂`
  set p0 : V ⟶ X := r ≫ M0.p with hp0
  set q0 : V ⟶ M.Y := s ≫ M.q with hq0
  have hp0s : p0 ≫ sX = sV := by rw [hp0, Category.assoc, hR0.comp_eq_left, hrsV]
  have hq0s : q0 ≫ M.sY = sV := by rw [hq0, Category.assoc, hRM.comp_eq_right]
  have hp0b : IsBirationalMorphism p0 := isBirationalMorphism_comp hrb hp1b
  have hq0b : IsBirationalMorphism q0 := isBirationalMorphism_comp hsb hq2b
  have hp0p : IsProjectiveMorphism p0 := hrp.comp hR0.isProjectiveMorphism_left
  have hq0p : IsProjectiveMorphism q0 := hsp.comp hRM.isProjectiveMorphism_right
  haveI : IsProper p0 := isProper_of_isProjectiveMorphism p0 hp0p
  haveI : IsProper q0 := isProper_of_isProjectiveMorphism q0 hq0p
  haveI : IsDominant p0 := hp0b.isDominant
  haveI : IsDominant q0 := hq0b.isDominant
  haveI : IsSeparated p0 := IsSeparated.of_comp p0 sX
  haveI : IsSeparated q0 := by
    have : IsSeparated (q0 ≫ M.sY) := by rw [hq0s]; infer_instance
    exact IsSeparated.of_comp q0 M.sY
  have hVnp0 : IsNormalVariety ℂ (p0 ≫ sX) := by rw [hp0s]; exact hVn'
  have hVnq0 : IsNormalVariety ℂ (q0 ≫ M.sY) := by rw [hq0s]; exact hVn'
  have hVnr : IsNormalVariety ℂ (r ≫ M0.sW) := by rw [hrsV]; exact hVn'
  have hVnr' : IsNormalVariety ℂ (r ≫ M0.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hVnr
  have hVns : IsNormalVariety ℂ (s ≫ M.sW) := hVn'
  have hVns' : IsNormalVariety ℂ (s ≫ M.q ≫ M.sY) := by rw [hRM.comp_eq_right]; exact hVns
  have hVp : MMP.Mori.IsProjectiveVariety ℂ sV :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ sV).mpr
      ⟨hVn'.1, hp0s ▸ hp0p.comp hXp.isProjective⟩
  obtain ⟨h0, hh0, hφb⟩ := exists_isInverse_and_isBirational_compHom hp0b hq0b
  -- commutativity over `Z`
  have hpq1 : M0.q ≫ M0.πY = M0.p ≫ π := by
    have h1 : M0.h.compHom (M0.q ≫ M0.πY) = π.toRationalMap := by
      rw [← compHom_compHom, hR0.compHom_eq]; exact M0.isOver
    exact eq_comp_of_isInverse_of_compHom_eq hR0.isInverse (M0.q ≫ M0.πY) π h1
  have hpq2 : M.q ≫ M.πY = M.p ≫ M0.πY := by
    have h1 : M.h.compHom (M.q ≫ M.πY) = M0.πY.toRationalMap := by
      rw [← compHom_compHom, hRM.compHom_eq]; exact M.isOver
    exact eq_comp_of_isInverse_of_compHom_eq hRM.isInverse (M.q ≫ M.πY) M0.πY h1
  have hcomm : q0 ≫ M.πY = p0 ≫ π := by
    simp only [hq0, hp0, Category.assoc]
    rw [hpq2, ← Category.assoc s, ← hrs, Category.assoc, hpq1]
  -- strict transforms of prime divisors of `X` and of `Y₀`
  have hstX : ∀ P : MMP.Mori.PrimeDivisor X, ∃ (PV : MMP.Mori.PrimeDivisor V)
      (P1 : MMP.Mori.PrimeDivisor M0.W),
      MMP.Mori.RationalMap.transformPrimeDivisor h0 P = some PV ∧
      p0 PV.genericPoint = P.genericPoint ∧
      MMP.Mori.RationalMap.transformPrimeDivisor M0.h P = some P1 ∧
      M0.p P1.genericPoint = P.genericPoint ∧ r PV.genericPoint = P1.genericPoint := by
    intro P
    obtain ⟨PV, h1, h2, -⟩ :=
      exists_transformPrimeDivisor_eq_some_of_isInverse hXn p0 h0 hVnp0 hp0b hh0 P
    obtain ⟨P1, h3, h4, -⟩ :=
      exists_transformPrimeDivisor_eq_some_of_isInverse hXn M0.p M0.h hW1np hp1b hR0.isInverse P
    exact ⟨PV, P1, h1, h2, h3, h4, eq_of_map_eq_genericPoint M0.p hp1b.functionFieldMap_bijective
      (by rw [← Scheme.Hom.comp_apply]; exact h2) h4⟩
  have hstY : ∀ G : MMP.Mori.PrimeDivisor M0.Y, ∃ GW : MMP.Mori.PrimeDivisor M.W,
      MMP.Mori.RationalMap.transformPrimeDivisor M.h G = some GW ∧
      M.p GW.genericPoint = G.genericPoint := by
    intro G
    obtain ⟨GW, h1, h2, -⟩ :=
      exists_transformPrimeDivisor_eq_some_of_isInverse hY0n M.p M.h hWnp hp2b hRM.isInverse G
    exact ⟨GW, h1, h2⟩
  have hchain : ∀ (P : MMP.Mori.PrimeDivisor X) (PV : MMP.Mori.PrimeDivisor V)
      (P1 : MMP.Mori.PrimeDivisor M0.W) (G : MMP.Mori.PrimeDivisor M0.Y)
      (GW : MMP.Mori.PrimeDivisor M.W),
      r PV.genericPoint = P1.genericPoint → M0.p P1.genericPoint = P.genericPoint →
      MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P = some G →
      M.p GW.genericPoint = G.genericPoint →
      M0.q P1.genericPoint = G.genericPoint ∧ s PV.genericPoint = GW.genericPoint := by
    intro P PV P1 G GW hr hp1 hG hGW
    have hq1 : M0.q P1.genericPoint = G.genericPoint := by
      rw [← hR0.compHom_eq] at hG
      exact (transformPrimeDivisor_compHom_eq_some_iff hXn M0.p M0.h hW1np hp1b hR0.isInverse
        M0.q hp1 G).mp hG
    refine ⟨hq1, eq_of_map_eq_genericPoint M.p hp2b.functionFieldMap_bijective ?_ hGW⟩
    rw [← Scheme.Hom.comp_apply, ← hrs, Scheme.Hom.comp_apply, hr, hq1]
  have hφ'G : ∀ (P : MMP.Mori.PrimeDivisor X) (G : MMP.Mori.PrimeDivisor M0.Y),
      MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P = some G →
      ∀ F : MMP.Mori.PrimeDivisor M.Y,
        MMP.Mori.RationalMap.transformPrimeDivisor (h0.compHom q0) P = some F ↔
          MMP.Mori.RationalMap.transformPrimeDivisor M.φ G = some F := by
    intro P G hG F
    obtain ⟨PV, P1, -, hPV, -, hP1, hr⟩ := hstX P
    obtain ⟨GW, -, hGW⟩ := hstY G
    obtain ⟨-, hs⟩ := hchain P PV P1 G GW hr hP1 hG hGW
    rw [transformPrimeDivisor_compHom_eq_some_iff hXn p0 h0 hVnp0 hp0b hh0 q0 hPV F,
      ← hRM.compHom_eq,
      transformPrimeDivisor_compHom_eq_some_iff hY0n M.p M.h hWnp hp2b hRM.isInverse M.q hGW F,
      hq0, Scheme.Hom.comp_apply, hs]
  have hsurj : ∀ F : MMP.Mori.PrimeDivisor M.Y, ∃ (P : MMP.Mori.PrimeDivisor X)
      (G : MMP.Mori.PrimeDivisor M0.Y),
      MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P = some G ∧
      MMP.Mori.RationalMap.transformPrimeDivisor M.φ G = some F := by
    intro F
    obtain ⟨G, hG⟩ : ∃ G, MMP.Mori.RationalMap.transformPrimeDivisor M.φ G = some F := by
      by_contra h
      push Not at h
      exact M.not_isInverseExceptional F h
    obtain ⟨P, hP⟩ : ∃ P, MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P = some G := by
      by_contra h
      push Not at h
      exact M0.not_isInverseExceptional G h
    exact ⟨P, G, hP, hG⟩
  -- the composite model
  let M' : Model sX sZ π :=
    { Y := M.Y, sY := M.sY, πY := M.πY, KY := M.KY, φ := h0.compHom q0, W := V, sW := sV,
      p := p0, q := q0, h := h0
      isProjectiveVariety := M.isProjectiveVariety
      isNormalVariety := M.isNormalVariety
      isQFactorial := M.isQFactorial
      isCanonicalDivisor := M.isCanonicalDivisor
      comp_eq := M.comp_eq
      isBirational := hφb
      isOver := by
        change (h0.compHom q0).compHom M.πY = π.toRationalMap
        rw [compHom_compHom, hcomm, ← compHom_compHom, compHom_eq_of_isInverse hh0]
        have hid : Scheme.Hom.toRationalMap (𝟙 X) = Scheme.RationalMap.id X := by
          rw [Scheme.RationalMap.id]
        rw [hid, Scheme.RationalMap.id_compHom]
      not_isInverseExceptional := fun F hF => by
        obtain ⟨P, G, hP, hG⟩ := hsurj F
        exact hF P ((hφ'G P G hP F).mpr hG) }
  refine ⟨M', fun B hB0 hBklt hMv hpos0 => ?_⟩
  obtain ⟨hmodelM, hkltM, H, H', hRH, hposH⟩ := hMv
  set T0 := MMP.Mori.RationalMap.transformDivisor M0.φ B with hT0
  -- the transform of `B` along the composite
  have hT : MMP.Mori.RationalMap.transformDivisor (h0.compHom q0) B =
      MMP.Mori.RationalMap.transformDivisor M.φ T0 := by
    refine DivisorWithCoeffs.ext' fun F => ?_
    obtain ⟨P, G, hP, hG⟩ := hsurj F
    rw [coeff_transformDivisor_compHom hXn hY1n p0 h0 hVnp0 hp0b hh0 q0 (hq0s.trans hp0s.symm)
      hq0b ((hφ'G P G hP F).mpr hG) B]
    rw [← hRM.compHom_eq] at hG ⊢
    rw [coeff_transformDivisor_compHom hY0n hY1n M.p M.h hWnp hp2b hRM.isInverse M.q
      (hRM.comp_eq_right.trans hRM.comp_eq_left.symm) hq2b hG T0]
    rw [← hR0.compHom_eq] at hP
    rw [hT0, ← hR0.compHom_eq, coeff_transformDivisor_compHom hXn hY0n M0.p M0.h hW1np hp1b
      hR0.isInverse M0.q (hR0.comp_eq_right.trans hR0.comp_eq_left.symm) hq1b hP B]
  -- dimensions
  obtain ⟨nY0, hKY0⟩ := M0.isCanonicalDivisor
  have hdimY0 := hKY0.topologicalKrullDim_eq
  obtain ⟨nY1, hKY1⟩ := M.isCanonicalDivisor
  have hdimY1 := hKY1.topologicalKrullDim_eq
  -- pull-backs on `W₁`
  have hXc : ∀ D : RDivisor X, IsCartierCombination D :=
    isCartierCombination_of_forall hS.isQFactorial.2
  have hY0c : ∀ D : RDivisor M0.Y, IsCartierCombination D :=
    isCartierCombination_of_forall M0.isQFactorial.2
  obtain ⟨G, hG, -⟩ := MMP.Flips.existsUnique_isRCartierPullback M0.p
    (hXc (logCanonicalDivisor KX B))
  obtain ⟨G', hG', -⟩ := MMP.Flips.existsUnique_isRCartierPullback M0.q
    (hY0c (logCanonicalDivisor M0.KY T0))
  have hposG := hpos0 G G' hG hG'
  -- pull-backs to `V`
  obtain ⟨GV, hGV, hGVr⟩ := exists_isRCartierPullback_comp r M0.p hG
  obtain ⟨G'V, hG'V, hG'Vr⟩ := exists_isRCartierPullback_comp r M0.q hG'
  obtain ⟨HV, hHV, hHVs⟩ := exists_isRCartierPullback_comp s M.p hRH.isRCartierPullback_left
  obtain ⟨H'V, hH'V, hH'Vs⟩ := exists_isRCartierPullback_comp s M.q hRH.isRCartierPullback_right
  haveI : IsDominant (s ≫ M.p) := (isBirationalMorphism_comp hsb hp2b).isDominant
  have hGH : G'V = HV := by
    have h1 : IsRCartierPullback (s ≫ M.p) (logCanonicalDivisor M0.KY T0) G'V := by
      rw [← hrs]; exact hG'V
    exact MMP.Flips.IsRCartierPullback.eq (s ≫ M.p) h1 hHV
  have hΔsplit : GV - H'V = (GV - G'V) + (HV - H'V) := by rw [hGH]; abel
  have hrsub := isRCartierPullback_sub hGVr hG'Vr
  have hssub := isRCartierPullback_sub hHVs hH'Vs
  have hHeff : 0 ≤ HV - H'V :=
    (MMP.Fourfold.isEffective_of_isRCartierPullback s
      (isRCartier_of_isSmoothScheme hRM.isSmoothScheme _)
      (DivisorWithCoeffs.isEffective_iff_nonneg.mp hRH.effective)).2 _ hssub
  have hHeffc : ∀ E, 0 ≤ (HV - H'V).coeff E := DivisorWithCoeffs.isEffective_iff_nonneg.mpr hHeff
  have hcoeffr : ∀ (PV : MMP.Mori.PrimeDivisor V) (P1 : MMP.Mori.PrimeDivisor M0.W),
      r PV.genericPoint = P1.genericPoint → (GV - G'V).coeff PV = (G - G').coeff P1 := by
    intro PV P1 hr
    haveI := isIso_stalkMap_of_eq_genericPoint r hrb.functionFieldMap_bijective hr
    exact MMP.Fourfold.coeff_eq_of_isRCartierPullback PV P1 hr hrsub
  have hcoeffs : ∀ (PV : MMP.Mori.PrimeDivisor V) (GW : MMP.Mori.PrimeDivisor M.W),
      s PV.genericPoint = GW.genericPoint → (HV - H'V).coeff PV = (H - H').coeff GW := by
    intro PV GW hs
    haveI := isIso_stalkMap_of_eq_genericPoint s hsb.functionFieldMap_bijective hs
    exact MMP.Fourfold.coeff_eq_of_isRCartierPullback PV GW hs hssub
  -- the comparison on `W₁` vanishes along prime divisors of `X` surviving on `Y₀`
  obtain ⟨nW1, KW1, hKW1, hKW1X, hKW1Y⟩ := hR0.exists_canonicalDivisor
  have hzero1 : ∀ (P : MMP.Mori.PrimeDivisor X) (P1 : MMP.Mori.PrimeDivisor M0.W)
      (G0 : MMP.Mori.PrimeDivisor M0.Y), M0.p P1.genericPoint = P.genericPoint →
      M0.q P1.genericPoint = G0.genericPoint →
      MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P = some G0 → (G - G').coeff P1 = 0 := by
    intro P P1 G0 hp1 hq1 hPG
    haveI := isIso_stalkMap_of_eq_genericPoint M0.p hp1b.functionFieldMap_bijective hp1
    haveI := isIso_stalkMap_of_eq_genericPoint M0.q hq1b.functionFieldMap_bijective hq1
    have e1 := MMP.Fourfold.coeff_eq_of_isRCartierPullback P1 P hp1 hG
    have e2 := MMP.Fourfold.coeff_eq_of_isRCartierPullback P1 G0 hq1 hG'
    have hKX : KX.coeff P = KW1.coeff P1 := by
      rw [← hKW1X]
      exact transformDivisor_toRationalMap_apply_of_map_eq hXn M0.p hW1np hp1b hp1 KW1
    have hKY : M0.KY.coeff G0 = KW1.coeff P1 := by
      rw [← hKW1Y]
      exact transformDivisor_toRationalMap_apply_of_map_eq hY0n M0.q hW1nq hq1b hq1 KW1
    have hBT : T0.coeff G0 = B.coeff P := by
      rw [hT0]
      rw [← hR0.compHom_eq] at hPG ⊢
      exact coeff_transformDivisor_compHom hXn hY0n M0.p M0.h hW1np hp1b hR0.isInverse M0.q
        (hR0.comp_eq_right.trans hR0.comp_eq_left.symm) hq1b hPG B
    rw [DivisorWithCoeffs.coeff_sub, e1, e2]
    simp only [MMP.Flips.logCanonicalDivisor, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toRDivisor]
    rw [hKX, hKY, hBT]
    ring
  -- effectivity of the comparison on `V`, by generic comparison
  have hpush : 0 ≤ MMP.Mori.RationalMap.transformDivisor p0.toRationalMap (GV - H'V) := by
    rw [← DivisorWithCoeffs.isEffective_iff_nonneg]
    intro Q
    obtain ⟨QV, Q1, -, hQV, h3, hQ1, hr⟩ := hstX Q
    change 0 ≤ MMP.Mori.RationalMap.transformDivisor p0.toRationalMap (GV - H'V) Q
    rw [transformDivisor_toRationalMap_apply_of_map_eq hXn p0 hVnp0 hp0b hQV, hΔsplit]
    change 0 ≤ (GV - G'V + (HV - H'V)).coeff QV
    rw [DivisorWithCoeffs.coeff_add, hcoeffr QV Q1 hr]
    refine add_nonneg ?_ (hHeffc QV)
    cases hc : MMP.Mori.RationalMap.transformPrimeDivisor M0.φ Q with
    | none =>
      have hc' := hc
      rw [← hR0.compHom_eq] at hc'
      have hexc := isExceptional_of_transformPrimeDivisor_compHom_eq_none hXn hY0n hdimY0 M0.p
        M0.h hW1np hp1b hR0.isInverse M0.q hW1nq hq1b hc'
      rw [hR0.compHom_eq] at hexc
      exact (hposG Q hexc Q1 h3).le
    | some G0 =>
      obtain ⟨GW, -, hGW⟩ := hstY G0
      obtain ⟨hq1, -⟩ := hchain Q QV Q1 G0 GW hr hQ1 hc hGW
      exact (hzero1 Q Q1 G0 hQ1 hq1 hc).ge
  have hΔ0 : 0 ≤ GV - H'V :=
    MMP.Fourfold.nonneg_sub_of_nonneg_transformDivisor_sub sV sX M.sY hVn' hVp hXn hXp hY1n
      hY1p π M.πY p0 q0 hp0s hq0s hcomm.symm hp0p hp0b hq0p hq0b (hXc _)
      hmodelM.isRelativelyNef hGV hH'V hpush
  have hΔc : ∀ E, 0 ≤ (GV - H'V).coeff E := DivisorWithCoeffs.isEffective_iff_nonneg.mpr hΔ0
  -- the comparison is exceptional over `Y₁`
  have hexcV : ∀ E, (GV - H'V).coeff E ≠ 0 → IsExceptionalPrimeDivisor M.sY q0 E := by
    intro E hE
    by_contra hnexc
    obtain ⟨F, hF, -, -⟩ :=
      MMP.Fourfold.exists_transformDivisor_apply_eq_of_not_isExceptionalPrimeDivisor hY1n q0
        hVnq0 hq0b E hnexc
    obtain ⟨P, G0, hP, hG0⟩ := hsurj F
    obtain ⟨PV, P1, -, hPV, -, hP1, hr⟩ := hstX P
    obtain ⟨GW, -, hGW⟩ := hstY G0
    obtain ⟨hq1, hs⟩ := hchain P PV P1 G0 GW hr hP1 hP hGW
    have hqPV : q0 PV.genericPoint = F.genericPoint :=
      (transformPrimeDivisor_compHom_eq_some_iff hXn p0 h0 hVnp0 hp0b hh0 q0 hPV F).mp
        ((hφ'G P G0 hP F).mpr hG0)
    obtain rfl : E = PV := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (eq_of_map_eq_genericPoint q0 hq0b.functionFieldMap_bijective hF hqPV)
    have hqGW : M.q GW.genericPoint = F.genericPoint := by
      have h1 := hG0
      rw [← hRM.compHom_eq] at h1
      exact (transformPrimeDivisor_compHom_eq_some_iff hY0n M.p M.h hWnp hp2b hRM.isInverse M.q
        hGW F).mp h1
    apply hE
    rw [hΔsplit, DivisorWithCoeffs.coeff_add, hcoeffr E P1 hr, hzero1 P P1 G0 hP1 hq1 hP,
      zero_add, hcoeffs E GW hs]
    by_contra hne
    exact not_isExceptionalPrimeDivisor_of_map_eq_genericPoint hdimY1 hqGW
      (hRH.isExceptional GW hne)
  -- positivity along the contracted primes
  have hposV : ∀ P : MMP.Mori.PrimeDivisor X,
      MMP.Mori.RationalMap.IsExceptional (h0.compHom q0) P →
      ∀ P' : MMP.Mori.PrimeDivisor V, MMP.Mori.RationalMap.transformPrimeDivisor h0 P = some P' →
        0 < (GV - H'V).coeff P' := by
    intro P hexc P' hP'
    obtain ⟨PV, P1, h1, hPV, h3, hP1, hr⟩ := hstX P
    obtain rfl : P' = PV := Option.some.inj (hP'.symm.trans h1)
    rw [hΔsplit, DivisorWithCoeffs.coeff_add, hcoeffr P' P1 hr]
    cases hc : MMP.Mori.RationalMap.transformPrimeDivisor M0.φ P with
    | none =>
      have hc' := hc
      rw [← hR0.compHom_eq] at hc'
      have hexc0 := isExceptional_of_transformPrimeDivisor_compHom_eq_none hXn hY0n hdimY0 M0.p
        M0.h hW1np hp1b hR0.isInverse M0.q hW1nq hq1b hc'
      rw [hR0.compHom_eq] at hexc0
      exact add_pos_of_pos_of_nonneg (hposG P hexc0 P1 h3) (hHeffc P')
    | some G0 =>
      obtain ⟨GW, hGW1, hGW⟩ := hstY G0
      obtain ⟨hq1, hs⟩ := hchain P P' P1 G0 GW hr hP1 hc hGW
      rw [hzero1 P P1 G0 hP1 hq1 hc, zero_add, hcoeffs P' GW hs]
      have hexcG : MMP.Mori.RationalMap.IsExceptional M.φ G0 := by
        by_contra hnex
        cases hcG : MMP.Mori.RationalMap.transformPrimeDivisor M.φ G0 with
        | none =>
          apply hnex
          have hcG' := hcG
          rw [← hRM.compHom_eq] at hcG' ⊢
          exact isExceptional_of_transformPrimeDivisor_compHom_eq_none hY0n hY1n hdimY1 M.p M.h
            hWnp hp2b hRM.isInverse M.q hWnq hq2b hcG'
        | some F =>
          exact not_isExceptional_of_transformPrimeDivisor_eq_some ((hφ'G P G0 hc F).mpr hcG)
            hexc
      exact hposH G0 hexcG GW hGW1
  -- the canonical divisor of `V`
  have hVsmr : IsSmoothScheme (r ≫ M0.sW) := by rw [hrsV]; exact hVsm'
  obtain ⟨KV, hKV, hKVr⟩ := exists_isCanonicalDivisor_transformDivisor_eq hW1n r hVnr hVsmr hrb hKW1
  have hKV' : KV.IsCanonicalDivisor sV nW1 := by rw [← hrsV]; exact hKV
  have hKVX : MMP.Mori.RationalMap.transformDivisor p0.toRationalMap KV = KX := by
    rw [hp0, transformDivisor_comp_toRationalMap hXn M0.p r hW1np hVnr' hp1b hrb KV, hKVr, hKW1X]
  obtain ⟨nW, KW, hKW, hKWY0, hKWY1⟩ := hRH.exists_canonicalDivisor
  have hKVY : MMP.Mori.RationalMap.transformDivisor q0.toRationalMap KV = M.KY := by
    refine Finsupp.ext fun F => ?_
    obtain ⟨P, G0, hP, hG0⟩ := hsurj F
    obtain ⟨PV, P1, -, hPV, -, hP1, hr⟩ := hstX P
    obtain ⟨GW, -, hGW⟩ := hstY G0
    obtain ⟨hq1, hs⟩ := hchain P PV P1 G0 GW hr hP1 hP hGW
    have hqGW : M.q GW.genericPoint = F.genericPoint := by
      have h1 := hG0
      rw [← hRM.compHom_eq] at h1
      exact (transformPrimeDivisor_compHom_eq_some_iff hY0n M.p M.h hWnp hp2b hRM.isInverse M.q
        hGW F).mp h1
    have hqPV : q0 PV.genericPoint = F.genericPoint := by
      rw [hq0, Scheme.Hom.comp_apply, hs, hqGW]
    rw [transformDivisor_toRationalMap_apply_of_map_eq hY1n q0 hVnq0 hq0b hqPV KV]
    rw [← hKWY1, transformDivisor_toRationalMap_apply_of_map_eq hY1n M.q hWnq hq2b hqGW KW]
    have e1 : KV PV = KW1 P1 := by
      rw [← hKVr]
      exact (transformDivisor_toRationalMap_apply_of_map_eq hW1n r hVnr hrb hr KV).symm
    have e2 : KW1 P1 = M0.KY G0 := by
      rw [← hKW1Y]
      exact (transformDivisor_toRationalMap_apply_of_map_eq hY0n M0.q hW1nq hq1b hq1 KW1).symm
    have e3 : M0.KY G0 = KW GW := by
      rw [← hKWY0]
      exact transformDivisor_toRationalMap_apply_of_map_eq hY0n M.p hWnp hp2b hGW KW
    rw [e1, e2, e3]
  -- the common resolution comparing `(X, B)` with `(Y₁, φ'_* B)`
  have hR : IsLogComparisonResolution sX M.sY sV (h0.compHom q0) KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor (h0.compHom q0) B) p0 q0 h0 GV H'V :=
    { isVariety := hVn'.1
      isSmoothScheme := hVsm'
      comp_eq_left := hp0s
      comp_eq_right := hq0s
      isProjectiveMorphism_left := hp0p
      isProjectiveMorphism_right := hq0p
      isBirationalMorphism_left := hp0b
      isBirationalMorphism_right := hq0b
      isInverse := hh0
      compHom_eq := rfl
      exists_canonicalDivisor := ⟨nW1, KV, hKV', hKVX, hKVY⟩
      isRCartierPullback_left := hGV
      isRCartierPullback_right := by rw [hT]; exact hH'V
      effective := hΔc
      isExceptional := hexcV }
  refine M'.isValidAt_of hS.isCanonicalDivisor hS.comp_eq hB0 hBklt hR hposV ?_ ?_
  · change IsRelativelyNef ℂ M.sY M.πY
      (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor (h0.compHom q0) B))
    rw [hT]
    exact hmodelM.isRelativelyNef
  · change IsRealKltPair M.sY (MMP.Mori.RationalMap.transformDivisor (h0.compHom q0) B)
    rw [hT]
    exact hkltM

end CompositeModel

/-! ### Reweighting and transferring pieces -/

section Transfer

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X}

/-- The strict transform of `∑ wᵢ Vᵢ` is `∑ wᵢ φ_* Vᵢ`. -/
private theorem transformDivisor_wsum {Y : Scheme.{0}} (φ : X.RationalMap Y) {n : ℕ}
    (V : Fin n → RDivisor X) (w : Fin n → ℝ) :
    MMP.Mori.RationalMap.transformDivisor φ (wsum V w) =
      wsum (fun i => MMP.Mori.RationalMap.transformDivisor φ (V i)) w := by
  change MMP.Mori.RationalMap.transformDivisorₗ ℝ φ (∑ i, w i • V i) =
    ∑ i, w i • MMP.Mori.RationalMap.transformDivisorₗ ℝ φ (V i)
  rw [map_sum]
  simp only [map_smul]

/-- `∑ⱼ βⱼ ∑ₗ cⱼₗ aₗ = ∑ₗ (∑ⱼ βⱼ cⱼ)ₗ aₗ` in weight space. -/
private theorem sum_smul_sum_smul {d k n : ℕ} (β : Fin d → ℝ) (c : Fin d → Fin k → ℝ)
    (a : Fin k → Fin n → ℝ) :
    ∑ j, β j • ∑ l, c j l • a l = ∑ l, (∑ j, β j • c j) l • a l := by
  ext x
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun j _ => by ring

/-- `∑ᵢ wᵢ (∑ⱼ aᵢⱼ Vⱼ) = ∑ⱼ (∑ᵢ wᵢ aᵢ)ⱼ Vⱼ`. -/
private theorem wsum_wsum {n k : ℕ} (V : Fin n → RDivisor X) (a : Fin k → Fin n → ℝ)
    (w : Fin k → ℝ) : wsum (fun i => wsum V (a i)) w = wsum V (∑ i, w i • a i) := by
  simp only [wsum, Finset.smul_sum, smul_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
    Finset.sum_smul]
  exact Finset.sum_comm

/-- A convex combination of weights is a weight. -/
private theorem sum_smul_mem_stdSimplex {k n : ℕ} {w : Fin k → ℝ}
    (hw : w ∈ stdSimplex ℝ (Fin k)) {a : Fin k → Fin n → ℝ}
    (ha : ∀ i, a i ∈ stdSimplex ℝ (Fin n)) : ∑ i, w i • a i ∈ stdSimplex ℝ (Fin n) :=
  (convex_stdSimplex ℝ _).sum_mem (fun i _ => hw.1 i) hw.2 (fun i _ => ha i)

/-- **Reweighting pieces.** Pieces for the boundaries `∑ⱼ aᵢⱼ Vⱼ` covering `S` give pieces for
the `Vⱼ` covering the image of `S` under `w ↦ ∑ wᵢ aᵢ`. -/
private theorem HasPieces.reweight {n k : ℕ} {V : Fin n → RDivisor X} (a : Fin k → Fin n → ℝ)
    (ha : ∀ i, a i ∈ stdSimplex ℝ (Fin n)) {S : Set (Fin k → ℝ)}
    (h : HasPieces sX sZ π KX (fun i => wsum V (a i)) S) :
    HasPieces sX sZ π KX V ((fun w => ∑ i, w i • a i) '' S) := by
  obtain ⟨ι, hι, P, hP⟩ := h
  refine ⟨ι, hι, fun i => ⟨(P i).model, (P i).d, fun j => ∑ l, (P i).c j l • a l,
    fun j => sum_smul_mem_stdSimplex ((P i).c_mem j) ha, (P i).F, fun β hβ hβF => ?_⟩, ?_⟩
  · have := (P i).valid β hβ hβF
    rw [wsum_wsum] at this
    rw [sum_smul_sum_smul]
    exact this
  · rintro _ ⟨w, hw, rfl⟩
    obtain ⟨i, β, hβ, hβF, rfl⟩ := hP w hw
    exact ⟨i, β, hβ, hβF, (sum_smul_sum_smul β (P i).c a).symm⟩

/-- **Transferring pieces along a model.** Let `M₀ : X ⤏ Y₀` be a model with a fixed resolution
on which the comparison of `(X, ∑ wᵢ qᵢ)` and `(Y₀, φ₀_* ∑ wᵢ qᵢ)` is positive along the primes
contracted by `φ₀`, for every weight `w`. Pieces of `Y₀` for the boundaries `φ₀_* qᵢ` give pieces
of `X` for the `qᵢ`, covering the same weights. -/
private theorem HasPieces.transfer (hS : IsSetting sX sZ π KX) (M0 : Model sX sZ π)
    {B0 : RDivisor X} {G0 G0' : RDivisor M0.W}
    (hR0 : IsLogComparisonResolution sX M0.sY M0.sW M0.φ KX B0 M0.KY
      (MMP.Mori.RationalMap.transformDivisor M0.φ B0) M0.p M0.q M0.h G0 G0')
    [LocallyOfFiniteType M0.sY] {n : ℕ} {q : Fin n → RDivisor X}
    (hq0 : ∀ i P, 0 ≤ (q i).coeff P) (hqklt : ∀ i, IsRealKltPair sX (q i))
    (hpos : ∀ w ∈ stdSimplex ℝ (Fin n), ∀ G G' : RDivisor M0.W,
      IsRCartierPullback M0.p (logCanonicalDivisor KX (wsum q w)) G →
      IsRCartierPullback M0.q
        (logCanonicalDivisor M0.KY (MMP.Mori.RationalMap.transformDivisor M0.φ (wsum q w))) G' →
      ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M0.φ P →
        ∀ P' : MMP.Mori.PrimeDivisor M0.W,
          MMP.Mori.RationalMap.transformPrimeDivisor M0.h P = some P' → 0 < (G - G').coeff P')
    {S : Set (Fin n → ℝ)}
    (h : HasPieces M0.sY sZ M0.πY M0.KY
      (fun i => MMP.Mori.RationalMap.transformDivisor M0.φ (q i)) S) :
    HasPieces sX sZ π KX q S := by
  classical
  obtain ⟨ι, hι, P, hP⟩ := h
  have key : ∀ i, ∃ M' : Model sX sZ π, ∀ β ∈ stdSimplex ℝ (Fin (P i).d),
      (∃ j ∉ (P i).F, 0 < β j) → M'.IsValidAt KX (wsum q (∑ j, β j • (P i).c j)) := by
    intro i
    by_cases hex : ∃ β ∈ stdSimplex ℝ (Fin (P i).d), ∃ j ∉ (P i).F, 0 < β j
    · obtain ⟨β₁, hβ₁, hβ₁F⟩ := hex
      obtain ⟨-, -, H0, H0', hRM, -⟩ := (P i).valid β₁ hβ₁ hβ₁F
      obtain ⟨M', hM'⟩ := exists_model_comp hS M0 hR0 (P i).model hRM
      refine ⟨M', fun β hβ hβF => ?_⟩
      have hw : ∑ j, β j • (P i).c j ∈ stdSimplex ℝ (Fin n) :=
        sum_smul_mem_stdSimplex hβ (P i).c_mem
      refine hM' _ (coeff_wsum_nonneg hq0 hw) (isRealKltPair_wsum hS.isQFactorial hqklt hw) ?_
        (hpos _ hw)
      rw [transformDivisor_wsum]
      exact (P i).valid β hβ hβF
    · exact ⟨M0, fun β hβ hβF => absurd ⟨β, hβ, hβF⟩ hex⟩
  choose M' hM' using key
  exact ⟨ι, hι, fun i => ⟨M' i, (P i).d, (P i).c, (P i).c_mem, (P i).F, hM' i⟩, hP⟩

/-- The target of a model is again in the setting: a normal projective `ℚ`-factorial fourfold,
projective and birational over the same base. -/
private theorem Model.isSetting (hS : IsSetting sX sZ π KX) (M : Model sX sZ π)
    {B0 : RDivisor X} {G0 G0' : RDivisor M.W}
    (hR0 : IsLogComparisonResolution sX M.sY M.sW M.φ KX B0 M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B0) M.p M.q M.h G0 G0') :
    IsSetting M.sY sZ M.πY M.KY := by
  have hXp := hS.isProjectiveVariety
  have hXn : IsNormalVariety ℂ sX := ⟨hXp.toIsVariety, inferInstance⟩
  have hYp := M.isProjectiveVariety
  have hYn := M.isNormalVariety
  have hZp := hS.isProjectiveVariety_base
  have hWn : IsNormalVariety ℂ M.sW := ⟨hR0.isVariety, inferInstance⟩
  have hWnp : IsNormalVariety ℂ (M.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hWn
  have hWnq : IsNormalVariety ℂ (M.q ≫ M.sY) := by rw [hR0.comp_eq_right]; exact hWn
  have hpb := hR0.isBirationalMorphism_left
  have hqb := hR0.isBirationalMorphism_right
  haveI := hXn.1
  haveI := hYn.1
  haveI := hWn.1
  haveI : IsSeparated sZ := hZp.toIsVariety.toIsSeparated
  haveI : IsSeparated M.sY := hYn.1.toIsSeparated
  haveI : IsSeparated sX := hXn.1.toIsSeparated
  have := isSeparated_toTerminal sX
  have := isSeparated_toTerminal sZ
  have := isSeparated_toTerminal M.sW
  haveI : IsDominant M.p := hpb.isDominant
  haveI : IsDominant M.q := hqb.isDominant
  haveI : IsProper M.sY := isProper_of_isProjectiveMorphism _ hYp.isProjective
  haveI : IsProper (M.πY ≫ sZ) := by rw [M.comp_eq]; infer_instance
  haveI : IsProper M.πY := IsProper.of_comp M.πY sZ
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ M.sY := hYp
  haveI : IsQuasiProjectiveVariety ℂ M.sY := IsProjectiveVariety.isQuasiProjectiveVariety ℂ M.sY
  haveI : AlgebraicGeometry.IsVariety ℂ sZ := hZp.toIsVariety
  have hpq : M.q ≫ M.πY = M.p ≫ π := by
    have h1 : M.h.compHom (M.q ≫ M.πY) = π.toRationalMap := by
      rw [← compHom_compHom, hR0.compHom_eq]; exact M.isOver
    exact eq_comp_of_isInverse_of_compHom_eq hR0.isInverse (M.q ≫ M.πY) π h1
  haveI := hWnp.1
  haveI := hWnq.1
  haveI : IsIntegral Z := hZp.toIsVariety.toIsIntegral
  have hdimW : topologicalKrullDim M.W = topologicalKrullDim X :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (M.p ≫ sX) hpb).symm
  have hdimY : topologicalKrullDim M.W = topologicalKrullDim M.Y :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism M.sY (M.q ≫ M.sY) hqb).symm
  refine ⟨hYp, hZp, hS.isNormalVariety_base, M.comp_eq,
    MMP.isProjectiveMorphism_of_isProper_of_isQuasiProjectiveVariety M.sY sZ M.πY M.comp_eq,
    ?_, by rw [← hdimY, hdimW, hS.dim_eq], M.isQFactorial, M.isCanonicalDivisor⟩
  refine MMP.Fourfold.Oai4C1.Main.isBirationalMorphism_of_comp_left M.q M.πY hqb ?_
  rw [hpq]
  exact isBirationalMorphism_comp hpb hS.isBirationalMorphism

end Transfer

/-! ### Nefness along segments and convex combinations -/

section NefConvex

open MMP.Flips

variable {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] [IsLocallyNoetherian X]
  [IsNormal X]

/-- Nefness tested on one presentation. -/
private theorem isRelativelyNef_of_eq_sum (f : X ⟶ Y) {D : RDivisor X} {m : ℕ}
    (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j))
    (h0 : ∀ C : ProperCurve sX, C.IsContractedBy f →
      0 ≤ ∑ j, r j * ((L j).degreeOn ℂ sX C.ι C.dim_le (hL j) : ℝ)) :
    IsRelativelyNef ℂ sX f D :=
  ⟨m, r, L, hL, hD, fun C hC x hx => by
    rw [eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C r L hL hD hx]
    exact h0 C hC⟩

/-- A nef divisor has nonnegative degree, computed with any presentation, on contracted curves. -/
private theorem sum_degreeOn_nonneg_of_isRelativelyNef {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsRelativelyNef ℂ sX f D) {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X)
    (hL : ∀ j, (L j).IsCartier) (hDeq : D = ∑ j, r j • Divisor.toRDivisor (L j))
    (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    0 ≤ ∑ j, r j * ((L j).degreeOn ℂ sX C.ι C.dim_le (hL j) : ℝ) := by
  obtain ⟨m₀, r₀, L₀, hL₀, hD₀, hnn⟩ := hD
  have hx := isRIntersectionNumber_sum_degreeOn_of_isCartier ℂ sX C r₀ L₀ hL₀
  rw [← hD₀] at hx
  have := hnn C hC _ hx
  rwa [eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C r L hL hDeq hx] at this

/-- Every divisor which is a combination of Cartier divisors has a presentation. -/
private theorem exists_presentation_of_isRelativelyNef {f : X ⟶ Y} {D : RDivisor X}
    (hD : IsRelativelyNef ℂ sX f D) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
      D = ∑ j, r j • Divisor.toRDivisor (L j) := by
  obtain ⟨m, r, L, hL, hD, -⟩ := hD
  exact ⟨m, r, L, hL, hD⟩

/-- A nonnegative combination of two nef divisors is nef. -/
private theorem isRelativelyNef_smul_add_smul {f : X ⟶ Y} {D₁ D₂ : RDivisor X}
    (h₁ : IsRelativelyNef ℂ sX f D₁) (h₂ : IsRelativelyNef ℂ sX f D₂) {a b : ℝ} (ha : 0 ≤ a)
    (hb : 0 ≤ b) : IsRelativelyNef ℂ sX f (a • D₁ + b • D₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, hD₁⟩ := exists_presentation_of_isRelativelyNef h₁
  obtain ⟨m₂, r₂, L₂, hL₂, hD₂⟩ := exists_presentation_of_isRelativelyNef h₂
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier :=
    Fin.addCases (by simpa using hL₁) (by simpa using hL₂)
  refine isRelativelyNef_of_eq_sum f (Fin.append (a • r₁) (b • r₂)) (Fin.append L₁ L₂) hL ?_
    fun C hC => ?_
  · rw [hD₁, hD₂, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, Finset.smul_sum,
      smul_smul]
  · have e₁ := sum_degreeOn_nonneg_of_isRelativelyNef h₁ r₁ L₁ hL₁ hD₁ C hC
    have e₂ := sum_degreeOn_nonneg_of_isRelativelyNef h₂ r₂ L₂ hL₂ hD₂ C hC
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, mul_assoc,
      ← Finset.mul_sum]
    exact add_nonneg (mul_nonneg ha e₁) (mul_nonneg hb e₂)

/-- A convex combination of nef divisors is nef. -/
private theorem isRelativelyNef_sum_smul {f : X ⟶ Y} {ι : Type*} (t : Finset ι)
    {D : ι → RDivisor X} (hD : ∀ i ∈ t, IsRelativelyNef ℂ sX f (D i)) {a : ι → ℝ}
    (ha : ∀ i ∈ t, 0 ≤ a i) (hD0 : IsRelativelyNef ℂ sX f 0) :
    IsRelativelyNef ℂ sX f (∑ i ∈ t, a i • D i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simpa using hD0
  | insert i t hi ih =>
    rw [Finset.sum_insert hi]
    have h1 := ih (fun j hj => hD j (Finset.mem_insert_of_mem hj))
      (fun j hj => ha j (Finset.mem_insert_of_mem hj))
    simpa using isRelativelyNef_smul_add_smul (hD i (Finset.mem_insert_self i t)) h1
      (ha i (Finset.mem_insert_self i t)) zero_le_one

/-- The zero divisor is nef. -/
private theorem isRelativelyNef_zero (f : X ⟶ Y) : IsRelativelyNef ℂ sX f 0 :=
  isRelativelyNef_of_eq_sum f (m := 0) Fin.elim0 Fin.elim0 (fun j => j.elim0) (by simp)
    fun C _ => by simp

/-- **Nefness is closed along segments.** If `(1 - ε) D₁ + ε D₂` is nef for every `0 < ε ≤ 1`,
then `D₁` is nef. -/
private theorem isRelativelyNef_of_forall_smul_add_smul {f : X ⟶ Y} {D₁ D₂ : RDivisor X}
    (hc₁ : IsCartierCombination D₁) (hc₂ : IsCartierCombination D₂)
    (h : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → IsRelativelyNef ℂ sX f ((1 - ε) • D₁ + ε • D₂)) :
    IsRelativelyNef ℂ sX f D₁ := by
  obtain ⟨m₁, r₁, L₁, hL₁, hD₁⟩ := exists_eq_sum_of_isCartierCombination hc₁
  obtain ⟨m₂, r₂, L₂, hL₂, hD₂⟩ := exists_eq_sum_of_isCartierCombination hc₂
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier :=
    Fin.addCases (by simpa using hL₁) (by simpa using hL₂)
  refine isRelativelyNef_of_eq_sum f r₁ L₁ hL₁ hD₁ fun C hC => ?_
  set y₁ := ∑ j, r₁ j * ((L₁ j).degreeOn ℂ sX C.ι C.dim_le (hL₁ j) : ℝ)
  set y₂ := ∑ j, r₂ j * ((L₂ j).degreeOn ℂ sX C.ι C.dim_le (hL₂ j) : ℝ)
  have hε : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → 0 ≤ (1 - ε) * y₁ + ε * y₂ := by
    intro ε hε0 hε1
    have := sum_degreeOn_nonneg_of_isRelativelyNef (h ε hε0 hε1) (Fin.append ((1 - ε) • r₁) (ε • r₂))
      (Fin.append L₁ L₂) hL (by
        rw [hD₁, hD₂, Fin.sum_univ_add]
        simp only [Fin.append_left, Fin.append_right, Finset.smul_sum, Pi.smul_apply,
          smul_eq_mul, mul_smul]) C hC
    rw [Fin.sum_univ_add] at this
    simpa only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, mul_assoc,
      ← Finset.mul_sum] using this
  have hcont : Continuous fun ε : ℝ => (1 - ε) * y₁ + ε * y₂ := by fun_prop
  have hlim : Filter.Tendsto (fun ε : ℝ => (1 - ε) * y₁ + ε * y₂)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds y₁) := by
    have := (hcont.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))
    simpa using this
  refine ge_of_tendsto hlim ?_
  filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε'
  exact hε ε hε'.1 hε'.2.le

/-- `K + ((1 - ρ) B + ρ ∑ wᵢ Dᵢ) = (1 - ρ)(K + B) + ρ ∑ wᵢ (K + Dᵢ)` when `∑ wᵢ = 1`. -/
private theorem logCanonicalDivisor_affine {Y : Scheme.{0}} {n : ℕ} (K : Divisor Y)
    (B : RDivisor Y) (D : Fin n → RDivisor Y) {w : Fin n → ℝ} (hw : ∑ i, w i = 1) (ρ : ℝ) :
    logCanonicalDivisor K ((1 - ρ) • B + ρ • ∑ i, w i • D i) =
      (1 - ρ) • logCanonicalDivisor K B + ρ • ∑ i, w i • logCanonicalDivisor K (D i) := by
  simp only [logCanonicalDivisor, smul_add, Finset.sum_add_distrib, ← Finset.sum_smul, hw,
    one_smul]
  module

end NefConvex

/-! ### Changing the base along a contraction -/

section Base

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X}

/-- The rational map of a morphism, followed by a morphism, is the rational map of the
composite. -/
private theorem toRationalMap_compHom' {A B C : Scheme.{0}} (f : A ⟶ B) (g : B ⟶ C) :
    f.toRationalMap.compHom g = (f ≫ g).toRationalMap := by
  rw [Scheme.Hom.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.Hom.toPartialMap_compHom]

/-- A model over `T` is a model over `Z`, for `T ⟶ Z`. -/
private def Model.toBase {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)} {g : X ⟶ T}
    (M : Model sX sT g) {h : T ⟶ Z} (hh : h ≫ sZ = sT) (hgh : g ≫ h = π) : Model sX sZ π where
  Y := M.Y
  sY := M.sY
  πY := M.πY ≫ h
  KY := M.KY
  φ := M.φ
  W := M.W
  sW := M.sW
  p := M.p
  q := M.q
  h := M.h
  isProjectiveVariety := M.isProjectiveVariety
  isNormalVariety := M.isNormalVariety
  isQFactorial := M.isQFactorial
  isCanonicalDivisor := M.isCanonicalDivisor
  comp_eq := by rw [Category.assoc, hh, M.comp_eq]
  isBirational := M.isBirational
  isOver := by
    change M.φ.compHom (M.πY ≫ h) = π.toRationalMap
    rw [← compHom_compHom, M.isOver, toRationalMap_compHom', hgh]
  not_isInverseExceptional := M.not_isInverseExceptional

/-- If `g ≫ h` is birational and `g` dominant, then `g` is birational. -/
private theorem isBirationalMorphism_of_comp_right {A B C : Scheme.{0}} [IsIntegral A]
    [IsIntegral B] [IsIntegral C] (g : A ⟶ B) (h : B ⟶ C) [LocallyOfFiniteType g]
    [IsDominant g] (hgh : IsBirationalMorphism (g ≫ h)) : IsBirationalMorphism g := by
  haveI := hgh.isDominant
  haveI : IsDominant h := IsDominant.of_comp g h
  refine MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_of_isBirational g
    (AlgebraicGeometry.isBirational_of_surjective_functionFieldMap g fun t => ?_)
  obtain ⟨z, hz⟩ := hgh.functionFieldMap_bijective.2 t
  exact ⟨functionFieldMap h z, by rw [MMP.Fourfold.Oai4C1.functionFieldMap_comp_apply g h rfl, hz]⟩

/-- Two morphisms to a separated scheme agreeing after a dominant morphism of reduced schemes
agree. -/
private theorem eq_of_comp_eq_of_isDominant {A B : Scheme.{0}} [IsIntegral A] [IsIntegral B]
    {g : A ⟶ B} [IsDominant g] {u v : B ⟶ Spec (.of ℂ)} (huv : g ≫ u = g ≫ v) : u = v :=
  ext_of_isDominant_of_isSeparated (Spec (.of ℂ) ↘ ⊤_ Scheme) (Limits.terminal.hom_ext _ _) g huv

/-- A birational morphism is birational onto its scheme-theoretic image. -/
private theorem isBirationalMorphism_toImage {A B : Scheme.{0}} [IsIntegral A] [IsIntegral B]
    (f : A ⟶ B) [QuasiCompact f] [LocallyOfFiniteType f] (hf : IsBirationalMorphism f) :
    IsBirationalMorphism f.toImage :=
  isBirationalMorphism_of_comp_right f.toImage f.imageι (by rw [Scheme.Hom.toImage_imageι]; exact hf)

/-- **The zero divisor is big over a birational base.** -/
private theorem isRelativelyBig_zero_of_isBirationalMorphism {Y S : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (sY : Y ⟶ Spec (.of ℂ)) (sS : S ⟶ Spec (.of ℂ))
    (f : Y ⟶ S) (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (hYQ : IsQFactorial sY)
    (hS : MMP.Mori.IsProjectiveVariety ℂ sS) (hSn : IsNormalVariety ℂ sS) (hf : f ≫ sS = sY)
    (hb : IsBirationalMorphism f) : (0 : QDivisor Y).IsRelativelyBig f := by
  haveI : IsIntegral S := hS.toIsVariety.toIsIntegral
  haveI : IsSeparated sS := hS.toIsVariety.toIsSeparated
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ hY.isProjective
  haveI : IsProper (f ≫ sS) := by rw [hf]; infer_instance
  haveI : IsProper f := IsProper.of_comp f sS
  exact (MMP.Fourfold.isRelativelyPseudoEffective_and_isRelativelyBig_zero_of_isBirationalMorphism_toImage
    sY sS f hY hYQ hS hSn hf (isBirationalMorphism_toImage f hb)).2

end Base

/-! ### Radial decomposition of weights -/

section Radial

/-- **Radial decomposition.** Near a weight `w⁰`, every other weight `w` is
`(1 - t) w⁰ + t w''` for some `0 < t ≤ t₀` and a weight `w''` vanishing at a coordinate `k`
with `w⁰ₖ > 0`; `w''` is the insertion of `0` at `k` into a weight `u` of one dimension less. -/
private theorem exists_radial {m : ℕ} {w₀ : Fin (m + 1) → ℝ}
    (hw₀ : w₀ ∈ stdSimplex ℝ (Fin (m + 1))) {t₀ : ℝ} (ht₀ : 0 < t₀) :
    ∃ δ > 0, ∀ w ∈ stdSimplex ℝ (Fin (m + 1)), (∀ i, |w i - w₀ i| < δ) → w ≠ w₀ →
      ∃ (k : Fin (m + 1)) (t : ℝ) (u : Fin m → ℝ), 0 < t ∧ t ≤ t₀ ∧
        u ∈ stdSimplex ℝ (Fin m) ∧ w = (1 - t) • w₀ + t • Fin.insertNth k 0 u := by
  classical
  set S : Finset (Fin (m + 1)) := Finset.univ.filter fun i => 0 < w₀ i
  have hSne : S.Nonempty := by
    obtain ⟨i, hi⟩ := exists_pos_of_mem_stdSimplex hw₀
    exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩⟩
  obtain ⟨i₀, hi₀S, hi₀min⟩ := S.exists_min_image w₀ hSne
  set μ := w₀ i₀
  have hμ : 0 < μ := (Finset.mem_filter.mp hi₀S).2
  refine ⟨t₀ * μ, mul_pos ht₀ hμ, fun w hw hwδ hne => ?_⟩
  -- the radial parameter
  obtain ⟨k, hkS, hkmax⟩ := S.exists_max_image (fun i => (w₀ i - w i) / w₀ i) hSne
  set t := (w₀ k - w k) / w₀ k with ht_def
  have hwk0 : 0 < w₀ k := (Finset.mem_filter.mp hkS).2
  have hratio : ∀ i, 0 < w₀ i → (w₀ i - w i) / w₀ i ≤ t := fun i hi =>
    hkmax i (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩)
  -- some coordinate decreases, so `t > 0`
  have htpos : 0 < t := by
    by_contra hle
    push Not at hle
    have hge : ∀ i, w₀ i ≤ w i := fun i => by
      by_cases hi : 0 < w₀ i
      · have := (hratio i hi).trans hle
        rw [div_nonpos_iff] at this
        rcases this with ⟨_, h⟩ | ⟨h, _⟩
        · linarith
        · linarith
      · linarith [hw.1 i, not_lt.mp hi]
    apply hne
    have hsum : ∑ i, (w i - w₀ i) = 0 := by rw [Finset.sum_sub_distrib, hw.2, hw₀.2, sub_self]
    have h0 := (Finset.sum_eq_zero_iff_of_nonneg fun i _ => sub_nonneg.mpr (hge i)).mp hsum
    funext i
    linarith [h0 i (Finset.mem_univ _)]
  have htle : t ≤ t₀ := by
    have h1 : w₀ k - w k < t₀ * μ := (abs_lt.mp (by rw [abs_sub_comm]; exact hwδ k)).2
    have h2 : μ ≤ w₀ k := hi₀min k hkS
    rw [ht_def, div_le_iff₀ hwk0]
    nlinarith
  -- the endpoint `w'' = (w - (1 - t) w⁰) / t`
  set w'' : Fin (m + 1) → ℝ := t⁻¹ • (w - (1 - t) • w₀) with hw''
  have hw''k : w'' k = 0 := by
    simp only [hw'', Pi.smul_apply, Pi.sub_apply, smul_eq_mul, ht_def]
    field_simp
    ring
  have hw''0 : ∀ i, 0 ≤ w'' i := fun i => by
    simp only [hw'', Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    refine mul_nonneg (inv_nonneg.mpr htpos.le) ?_
    by_cases hi : 0 < w₀ i
    · have := hratio i hi
      rw [div_le_iff₀ hi] at this
      nlinarith
    · have h0 : w₀ i = 0 := le_antisymm (not_lt.mp hi) (hw₀.1 i)
      rw [h0, mul_zero, sub_zero]
      exact hw.1 i
  have hw''sum : ∑ i, w'' i = 1 := by
    simp only [hw'', Pi.smul_apply, Pi.sub_apply, smul_eq_mul, ← Finset.mul_sum,
      Finset.sum_sub_distrib, hw.2, hw₀.2, mul_one]
    field_simp
    ring
  refine ⟨k, t, w'' ∘ k.succAbove, htpos, htle, ⟨fun i => hw''0 _, ?_⟩, ?_⟩
  · have := Fin.sum_univ_succAbove w'' k
    rw [hw''k, zero_add] at this
    show ∑ i, w'' (k.succAbove i) = 1
    rw [← this]
    exact hw''sum
  · have hins : Fin.insertNth k 0 (w'' ∘ k.succAbove) = w'' := by
      funext i
      refine Fin.succAboveCases k ?_ (fun j => ?_) i
      · rw [Fin.insertNth_apply_same, hw''k]
      · rw [Fin.insertNth_apply_succAbove, Function.comp_apply]
    rw [hins, hw'']
    funext i
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    field_simp
    ring

end Radial

/-! ### Ample divisors plus large pull-backs -/

section AmplePullback

open MMP.Flips

/-- The elementary estimate behind `exists_isRelativelyNef_add_smul_of_isRelativelyAmple`. -/
private theorem sum_mul_add_mul_sum_nonneg {mA k : ℕ} (r : Fin mA → ℝ) (hr : ∀ j, 0 ≤ r j)
    (dA : Fin mA → ℝ) (ρ : Fin (k + 1) → ℝ) (hρ : ∀ i, 0 < ρ i) (dB : Fin (k + 1) → ℝ)
    (hdB : ∀ i, 0 ≤ dB i) (N : ℝ) (hA : ∀ j, 0 ≤ dA j + N * dB 0) {l : ℝ}
    (hN : 0 ≤ N) (hl : N * (∑ j, r j) / ρ 0 ≤ l) :
    0 ≤ ∑ j, r j * dA j + l * ∑ i, ρ i * dB i := by
  have h1 : -(N * dB 0) * ∑ j, r j ≤ ∑ j, r j * dA j := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ => by nlinarith [hA j, hr j]
  have h2 : ρ 0 * dB 0 ≤ ∑ i, ρ i * dB i :=
    Finset.single_le_sum (f := fun i => ρ i * dB i)
      (fun i _ => mul_nonneg (hρ i).le (hdB i)) (Finset.mem_univ 0)
  have hR : 0 ≤ ∑ j, r j := Finset.sum_nonneg fun j _ => hr j
  have hl0 : 0 ≤ l := le_trans (div_nonneg (mul_nonneg hN hR) (hρ 0).le) hl
  have hl' : N * ∑ j, r j ≤ l * ρ 0 := by
    rw [div_le_iff₀ (hρ 0)] at hl
    exact hl
  have h3 : l * (ρ 0 * dB 0) ≤ l * ∑ i, ρ i * dB i := mul_le_mul_of_nonneg_left h2 hl0
  nlinarith [mul_le_mul_of_nonneg_right hl' (hdB 0)]

/-- **[Stacks, Tag 0C4K], numerical form for `ℝ`-divisors.** Let `h' : T' ⟶ T` and `h : T ⟶ Z`,
`H'` an `h'`-ample and `H` an `h`-ample `ℝ`-divisor. Then `h'^* H` is `(h' ≫ h)`-nef, and
`H' + l h'^* H` is `(h' ≫ h)`-nef for all large `l`. -/
private theorem exists_isRelativelyNef_add_smul_of_isRelativelyAmple
    {T' T Z : Scheme.{0}} [IsIntegral T'] [CompactSpace T'] [IsLocallyNoetherian T'] [IsNormal T']
    [IsIntegral T] [CompactSpace T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace Z]
    {sT : T ⟶ Spec (.of ℂ)} [IsSeparated sT] [LocallyOfFiniteType sT] [QuasiCompact sT]
    (h' : T' ⟶ T) (h : T ⟶ Z) [IsProper h'] [QuasiCompact h] [IsDominant h']
    [QuasiCompact (h' ≫ sT)]
    {H' : RDivisor T'} (hH' : MMP.Flips.IsRelativelyAmple h' H') {H : RDivisor T}
    (hH : MMP.Flips.IsRelativelyAmple h H) :
    ∃ H'' : RDivisor T', IsRCartierPullback h' H H'' ∧
      IsRelativelyNef ℂ (h' ≫ sT) (h' ≫ h) H'' ∧
      ∃ l₀ : ℝ, ∀ l : ℝ, l₀ ≤ l → IsRelativelyNef ℂ (h' ≫ sT) (h' ≫ h) (H' + l • H'') := by
  classical
  -- ample over every affine open implies ample over a neighbourhood of every point
  have hamp : ∀ {S Y : Scheme.{0}} [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
      {f : Y ⟶ S} {W : Divisor Y} (hW : IsRelativelyAmpleCartier f W),
      W.IsRelativelyAmple f hW.1 := by
    intro S Y _ _ _ f W hW
    obtain ⟨hWc, hW⟩ := hW
    have := hWc.isInvertibleModule_divisorialSheaf
    intro y
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
    exact ⟨V, hV, hyV, hW V hV⟩
  -- a relatively ample Cartier divisor has positive degree on contracted curves
  have hpos : ∀ {S Y : Scheme.{0}} [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
      {sY : Y ⟶ Spec (.of ℂ)} [QuasiCompact sY] {f : Y ⟶ S} {W : Divisor Y} (hW : W.IsCartier)
      (hWa : W.IsRelativelyAmple f hW) (C : ProperCurve sY), C.IsContractedBy f →
      0 < W.degreeOn ℂ sY C.ι C.dim_le hW := by
    intro S Y _ _ _ sY _ f W hW hWa C hC
    have := hW.isInvertibleModule_divisorialSheaf
    exact MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _ hWa C hC
  obtain ⟨mA, r, A, -, hr, hA, rfl⟩ := hH'
  obtain ⟨mB, ρ, B, hmB, hρ, hB, rfl⟩ := hH
  obtain ⟨k, rfl⟩ : ∃ k, mB = k + 1 := ⟨mB - 1, by omega⟩
  have hBg : ∀ i, ∀ W : irreducibleComponents T', h' (componentGenericPoint T' W) ∉ (B i).supp :=
    fun i => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant h' _
  set B' : Fin (k + 1) → Divisor T' := fun i => (B i).pullback (hB i).1 (hBg i) with hB'def
  have hB'pb : ∀ i, (B i).IsPullback h' (hBg i) (B' i) := fun i =>
    Divisor.isPullback_pullback (hB i).1 _
  have hB'c : ∀ i, (B' i).IsCartier := fun i => (hB i).1.isCartier_pullback h' (hBg i)
  -- the pulled back divisors are nef over the composite
  have hBnef : ∀ i, IsRelativelyNef ℂ (h' ≫ sT) (h' ≫ h) (Divisor.toRDivisor (B' i)) := by
    intro i
    have hn : IsRelativelyNef ℂ sT h (Divisor.toRDivisor (B i)) :=
      isRelativelyNef_of_eq_sum h (fun _ : Fin 1 => 1) (fun _ => B i) (fun _ => (hB i).1)
        (by simp) fun C hC => by
          simpa using (hpos (hB i).1 (hamp (hB i)) C hC).le
    exact MMP.Fourfold.isRelativelyNef_of_isRCartierPullback (𝟙 Z) h (h' ≫ h) h'
      (Category.comp_id _) hn ⟨1, fun _ => 1, fun _ => B i, fun _ => B' i, fun _ => (hB i).1, by simp,
        fun _ => ⟨hBg i, hB'pb i⟩, by simp⟩
  have hdB : ∀ (C : ProperCurve (h' ≫ sT)), C.IsContractedBy (h' ≫ h) → ∀ i,
      0 ≤ ((B' i).degreeOn ℂ (h' ≫ sT) C.ι C.dim_le (hB'c i) : ℝ) := fun C hC i => by
    simpa using sum_degreeOn_nonneg_of_isRelativelyNef (hBnef i) (fun _ : Fin 1 => 1)
      (fun _ => B' i) (fun _ => hB'c i) (by simp) C hC
  -- the Cartier thresholds
  have hthr : ∀ j, ∃ n : ℕ, ∀ (C : ProperCurve (h' ≫ sT)), C.IsContractedBy (h' ≫ h) →
      0 < (A j).degreeOn ℂ (h' ≫ sT) C.ι C.dim_le (hA j).1 +
        n * (B' 0).degreeOn ℂ (h' ≫ sT) C.ι C.dim_le (hB'c 0) := by
    intro j
    obtain ⟨n₀, hn₀⟩ := MMP.Fourfold.PltReference.exists_isRelativelyAmple_add_nsmul h' h (hA j).1 (hamp (hA j)) (hB 0).1
      (hamp (hB 0)) (hB'pb 0)
    refine ⟨n₀, fun C hC => ?_⟩
    have := hpos _ (hn₀ n₀ le_rfl) C hC
    rwa [Divisor.degreeOn_add ℂ (h' ≫ sT) C.ι C.dim_le (A j) (n₀ • B' 0) (hA j).1
      ((hB'c 0).nsmul n₀), Divisor.degreeOn_nsmul'] at this
  choose n hn using hthr
  set N : ℕ := ∑ j, n j
  refine ⟨∑ i, ρ i • Divisor.toRDivisor (B' i),
    ⟨k + 1, ρ, B, B', fun i => (hB i).1, rfl, fun i => ⟨hBg i, hB'pb i⟩, rfl⟩, ?_,
    (N : ℝ) * (∑ j, r j) / ρ 0, fun l hl => ?_⟩
  · exact isRelativelyNef_sum_smul Finset.univ (fun i _ => hBnef i) (fun i _ => (hρ i).le)
      (isRelativelyNef_zero _)
  · have hL : ∀ j, (Fin.append A B' j).IsCartier :=
      Fin.addCases (by simpa using fun j => (hA j).1) (by simpa using hB'c)
    refine isRelativelyNef_of_eq_sum _ (Fin.append r (l • ρ)) (Fin.append A B') hL ?_
      fun C hC => ?_
    · rw [Fin.sum_univ_add (a := mA) (b := k + 1)]
      simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, Finset.smul_sum,
        smul_smul]
    · rw [Fin.sum_univ_add (a := mA) (b := k + 1)]
      simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, mul_assoc,
        ← Finset.mul_sum]
      refine sum_mul_add_mul_sum_nonneg r (fun j => (hr j).le) _ ρ hρ _ (hdB C hC) N
        (fun j => ?_) (Nat.cast_nonneg _) hl
      have h1 := hn j C hC
      have h2 : (n j : ℝ) ≤ N := by
        exact_mod_cast Finset.single_le_sum (f := n) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ j)
      have h3 := hdB C hC 0
      have h4 : (0 : ℝ) < (A j).degreeOn ℂ (h' ≫ sT) C.ι C.dim_le (hA j).1 +
          n j * (B' 0).degreeOn ℂ (h' ≫ sT) C.ι C.dim_le (hB'c 0) := by exact_mod_cast h1
      nlinarith

end AmplePullback

/-! ### Nefness near the pull-back of an ample divisor -/

section NefNearAmple

open MMP.Flips

attribute [local instance] Model.isIntegral Model.compactSpace Model.isLocallyNoetherian
  Model.isNormal Model.isIntegral_res Model.isLocallyNoetherian_res Model.isNormal_res

/-- **Nefness near the pull-back of an ample divisor.** Let `f : Y ⟶ T` be in the standing setting,
`h : T ⟶ Z`, `H` an `h`-ample `ℝ`-divisor on `T` with pull-back `H₁ = f^* H`, and `(Y, C)` an
effective klt pair with `K_Y + C` nef over `T`. Then `(1 - s) H₁ + s (K_Y + C)` is nef over `Z`
for all small `s ≥ 0`.

By `MMP.Fourfold.exists_isContraction_of_isRelativelyNef_of_isRelativelyBig` over `T`,
`K_Y + C ∼ g'^* H'` with `H'` ample over `h' : T' ⟶ T`; and `H' + l h'^* H` is nef over `Z` for
large `l`, by `exists_isRelativelyNef_add_smul_of_isRelativelyAmple`. -/
private theorem exists_pos_isRelativelyNef_smul_add_smul
    {Y T Z : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] {sT : T ⟶ Spec (.of ℂ)} {f : Y ⟶ T}
    {KY : Divisor Y} (hS : IsSetting sY sT f KY) {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (h : T ⟶ Z) (hh : h ≫ sZ = sT)
    {H : RDivisor T} (hH : MMP.Flips.IsRelativelyAmple h H) {H₁ : RDivisor Y}
    (hH₁ : IsRCartierPullback f H H₁)
    {C : RDivisor Y} (hC0 : ∀ P, 0 ≤ C.coeff P) (hC : IsRealKltPair sY C)
    (hnef : IsRelativelyNef ℂ sY f (logCanonicalDivisor KY C)) :
    ∃ t > 0, ∀ s : ℝ, 0 ≤ s → s ≤ t →
      IsRelativelyNef ℂ sY (f ≫ h) ((1 - s) • H₁ + s • logCanonicalDivisor KY C) := by
  have hYp := hS.isProjectiveVariety
  have hTp := hS.isProjectiveVariety_base
  have hTn := hS.isNormalVariety_base
  haveI := hTn.1
  haveI : IsIntegral T := hTp.toIsVariety.toIsIntegral
  haveI : IsSeparated sT := hTp.toIsVariety.toIsSeparated
  haveI : IsSeparated sY := hYp.toIsVariety.toIsSeparated
  haveI : IsProper sT := isProper_of_isProjectiveMorphism _ hTp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ hYp.isProjective
  haveI : IsProper sZ := isProper_of_isProjectiveMorphism _ hZ.isProjective
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
  haveI : IsSeparated sZ := hZ.toIsVariety.toIsSeparated
  haveI : IsProper (h ≫ sZ) := by rw [hh]; infer_instance
  haveI : IsProper h := IsProper.of_comp h sZ
  haveI : IsProper (f ≫ sT) := by rw [hS.comp_eq]; infer_instance
  haveI : IsProper f := IsProper.of_comp f sT
  haveI : IsDominant f := hS.isBirationalMorphism.isDominant
  obtain ⟨n, hK⟩ := hS.isCanonicalDivisor
  have hbig := isRelativelyBig_zero_of_isBirationalMorphism sY sT f hYp hS.isQFactorial hTp hTn
    hS.comp_eq hS.isBirationalMorphism
  obtain ⟨T', _, _, _, _, sT', g', h', H', hT', hcon, hgh, hH'amp,
      ⟨gH', hgH', mφ, rφ, φ, hφ⟩, -⟩ :=
    MMP.Fourfold.exists_isContraction_of_isRelativelyNef_of_isRelativelyBig sY sT f hS.comp_eq hYp
      hS.isQFactorial hTp n KY hK C hC0 hC 0 (fun _ => by simp) (fun P => by simpa using hC0 P)
      hbig hnef
  haveI : IsSeparated sT' := hT'.toIsVariety.toIsSeparated
  haveI : IsProper sT' := isProper_of_isProjectiveMorphism _ hT'.isProjective
  haveI : IsDominant g' := ⟨hcon.surjective.denseRange⟩
  haveI : IsDominant (g' ≫ h') := by rw [hgh]; infer_instance
  haveI : IsDominant h' := IsDominant.of_comp g' h'
  have hsT' : h' ≫ sT = sT' := by
    refine eq_of_comp_eq_of_isDominant (g := g') ?_
    rw [← Category.assoc, hgh, hS.comp_eq, hcon.comp_eq]
  haveI : IsProper (h' ≫ sT) := by rw [hsT']; infer_instance
  haveI : IsProper h' := IsProper.of_comp h' sT
  haveI : IsProper (g' ≫ sT') := by rw [hcon.comp_eq]; infer_instance
  haveI : IsProper g' := IsProper.of_comp g' sT'
  obtain ⟨H'', hH''pb, hH''nef, l₀, hl₀⟩ :=
    exists_isRelativelyNef_add_smul_of_isRelativelyAmple (sT := sT) h' h hH'amp hH
  obtain ⟨G, hGf, hGg⟩ := exists_isRCartierPullback_comp g' h' hH''pb
  rw [hgh] at hGf
  rw [IsRCartierPullback.eq f hGf hH₁] at hGg
  have hg's : g' ≫ h' ≫ sT = sY := by rw [hsT', hcon.comp_eq]
  have hcomp : g' ≫ h' ≫ h = f ≫ h := by rw [← Category.assoc, hgh]
  -- the principal part is numerically trivial
  have htriv : ∀ c : ℝ, IsNumericallyTrivialOver ℂ sY (f ≫ h)
      (c • ∑ i, rφ i • Divisor.toRDivisor (principalDivisor (φ i))) := by
    intro c
    rw [Finset.smul_sum]
    refine Finset.sum_induction _ (IsNumericallyTrivialOver ℂ sY (f ≫ h))
      (fun _ _ h₁ h₂ => isNumericallyTrivialOver_add h₁ h₂) ?_ fun i _ => ?_
    · simpa using isNumericallyTrivialOver_smul_principalDivisor (k := ℂ) (sX := sY) (f ≫ h) 0
        (1 : (RationalFunctions Y)ˣ)
    · rw [smul_smul]
      exact isNumericallyTrivialOver_smul_principalDivisor (f ≫ h) _ _
  have hK' : logCanonicalDivisor KY C =
      gH' + ∑ i, rφ i • Divisor.toRDivisor (principalDivisor (φ i)) := by
    rw [← hφ]; abel
  refine ⟨1 / (1 + max l₀ 0), by positivity, fun s hs0 hs1 => ?_⟩
  -- the pulled back part `s H' + (1 - s) H''` is nef over `Z`
  have hN : IsRelativelyNef ℂ (h' ≫ sT) (h' ≫ h) (s • H' + (1 - s) • H'') := by
    rcases hs0.eq_or_lt with rfl | hs
    · simpa using hH''nef
    · have hl : l₀ ≤ (1 - s) / s := by
        rw [le_div_iff₀ hs]
        have := (le_div_iff₀ (by positivity : (0 : ℝ) < 1 + max l₀ 0)).mp hs1
        nlinarith [le_max_left l₀ 0, le_max_right l₀ 0]
      have := isRelativelyNef_smul_add_smul (hl₀ _ hl) (isRelativelyNef_zero (h' ≫ h)) hs.le
        le_rfl
      convert this using 1
      rw [smul_zero, add_zero, smul_add, smul_smul, mul_div_cancel₀ _ hs.ne']
  have hNpb : IsRCartierPullback g' (s • H' + (1 - s) • H'') (s • gH' + (1 - s) • H₁) :=
    MMP.Fourfold.isRCartierPullback_add (MMP.Fourfold.isRCartierPullback_smul s hgH')
      (MMP.Fourfold.isRCartierPullback_smul _ hGg)
  have hNY := MMP.Fourfold.isRelativelyNef_of_isRCartierPullback (𝟙 Z) (h' ≫ h) (g' ≫ h' ≫ h) g'
    (Category.comp_id _) hN hNpb
  rw [hcomp] at hNY
  have key : ∀ (s' : Y ⟶ Spec (.of ℂ)) [QuasiCompact s'], s' = sY → ∀ D : RDivisor Y,
      IsRelativelyNef ℂ s' (f ≫ h) D → IsRelativelyNef ℂ sY (f ≫ h) D := by
    rintro s' _ rfl D hD
    exact hD
  replace hNY := key _ hg's _ hNY
  have := IsRelativelyNef.sub_of_isNumericallyTrivialOver hNY (htriv (-s))
  convert this using 1
  rw [hK', neg_smul, sub_neg_eq_add, smul_add]
  abel

end NefNearAmple

/-! ### Transforms on a model through its resolution, and the crepant centre -/

section Central

open MMP.Flips

variable {X T : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sT : T ⟶ Spec (.of ℂ)} {g : X ⟶ T}
  {KX : Divisor X}

attribute [local instance] Model.isIntegral Model.compactSpace Model.isLocallyNoetherian
  Model.isNormal Model.isIntegral_res Model.isLocallyNoetherian_res Model.isNormal_res

/-- The pull-back of an `ℝ`-Cartier divisor along a proper birational morphism of normal varieties
pushes forward to the divisor itself: `f_* f^* D = D`. -/
private theorem transformDivisor_toRationalMap_of_isRCartierPullback {Y Y' : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y']
    [IsNormal Y'] {sY : Y ⟶ Spec (.of ℂ)} (hY : IsNormalVariety ℂ sY) {f : Y' ⟶ Y}
    (hY' : IsNormalVariety ℂ (f ≫ sY)) [IsProper f] (hf : IsBirationalMorphism f)
    {D : RDivisor Y} {G : RDivisor Y'} (hG : IsRCartierPullback f D G) :
    MMP.Mori.RationalMap.transformDivisor f.toRationalMap G = D := by
  refine DivisorWithCoeffs.ext' fun P => ?_
  obtain ⟨E, heq, hiso, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hY hY' hf P
  rw [DivisorWithCoeffs.coeff_apply, htr]
  exact MMP.Fourfold.coeff_eq_of_isRCartierPullback E P heq hG

/-- Every prime divisor `F` of a model is the transform of a prime divisor `P` of `X`, whose strict
transform `P_W` on the resolution lies over both; the transform has the coefficients of `P` at
`F`. -/
private theorem Model.exists_coeff_transformDivisor_eq (hS : IsSetting sX sT g KX)
    (M : Model sX sT g) {D0 : RDivisor X} {G0 G0' : RDivisor M.W}
    (hR0 : IsLogComparisonResolution sX M.sY M.sW M.φ KX D0 M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ D0) M.p M.q M.h G0 G0')
    (F : MMP.Mori.PrimeDivisor M.Y) :
    ∃ (P : MMP.Mori.PrimeDivisor X) (PW : MMP.Mori.PrimeDivisor M.W),
      M.p PW.genericPoint = P.genericPoint ∧ M.q PW.genericPoint = F.genericPoint ∧
      ∀ D : RDivisor X, (MMP.Mori.RationalMap.transformDivisor M.φ D).coeff F = D.coeff P := by
  have hXn : IsNormalVariety ℂ sX := ⟨hS.isProjectiveVariety.toIsVariety, inferInstance⟩
  have hYn := M.isNormalVariety
  have hWn : IsNormalVariety ℂ M.sW := ⟨hR0.isVariety, inferInstance⟩
  have hWnp : IsNormalVariety ℂ (M.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hWn
  have hpb := hR0.isBirationalMorphism_left
  have hqb := hR0.isBirationalMorphism_right
  haveI := isProper_of_isProjectiveMorphism M.p hR0.isProjectiveMorphism_left
  haveI : IsSeparated M.sY := hYn.1.toIsSeparated
  haveI := isSeparated_toTerminal M.sY
  have hqs : M.q ≫ M.sY = M.p ≫ sX := by rw [hR0.comp_eq_right, hR0.comp_eq_left]
  obtain ⟨P, hP⟩ := not_forall.mp (M.not_isInverseExceptional F)
  rw [not_not] at hP
  obtain ⟨PW, -, h2, -⟩ :=
    exists_transformPrimeDivisor_eq_some_of_isInverse hXn M.p M.h hWnp hpb hR0.isInverse P
  have hP' : MMP.Mori.RationalMap.transformPrimeDivisor (M.h.compHom M.q) P = some F := by
    rw [hR0.compHom_eq]; exact hP
  refine ⟨P, PW, h2, (transformPrimeDivisor_compHom_eq_some_iff hXn M.p M.h hWnp hpb
    hR0.isInverse M.q h2 F).mp hP', fun D => ?_⟩
  have := coeff_transformDivisor_compHom hXn hYn M.p M.h hWnp hpb hR0.isInverse M.q hqs hqb hP' D
  rwa [hR0.compHom_eq] at this

/-- The transform of the canonical divisor of `X` is the canonical divisor of the model, both
being push-forwards of one canonical divisor of the resolution. -/
private theorem Model.transformDivisor_toRDivisor_canonical (hS : IsSetting sX sT g KX)
    (M : Model sX sT g) {D0 : RDivisor X} {G0 G0' : RDivisor M.W}
    (hR0 : IsLogComparisonResolution sX M.sY M.sW M.φ KX D0 M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ D0) M.p M.q M.h G0 G0') :
    MMP.Mori.RationalMap.transformDivisor M.φ (Divisor.toRDivisor KX) =
      Divisor.toRDivisor M.KY := by
  have hXn : IsNormalVariety ℂ sX := ⟨hS.isProjectiveVariety.toIsVariety, inferInstance⟩
  have hYn := M.isNormalVariety
  have hWn : IsNormalVariety ℂ M.sW := ⟨hR0.isVariety, inferInstance⟩
  have hWnp : IsNormalVariety ℂ (M.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hWn
  have hWnq : IsNormalVariety ℂ (M.q ≫ M.sY) := by rw [hR0.comp_eq_right]; exact hWn
  haveI := isProper_of_isProjectiveMorphism M.p hR0.isProjectiveMorphism_left
  haveI := isProper_of_isProjectiveMorphism M.q hR0.isProjectiveMorphism_right
  obtain ⟨-, KW, -, hKX, hKY⟩ := hR0.exists_canonicalDivisor
  refine DivisorWithCoeffs.ext' fun F => ?_
  obtain ⟨P, PW, hp, hq, hc⟩ := Model.exists_coeff_transformDivisor_eq hS M hR0 F
  rw [hc, Divisor.coeff_toRDivisor, Divisor.coeff_toRDivisor, ← hKX, ← hKY,
    DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
    transformDivisor_toRationalMap_apply_of_map_eq hXn M.p hWnp hR0.isBirationalMorphism_left hp,
    transformDivisor_toRationalMap_apply_of_map_eq hYn M.q hWnq hR0.isBirationalMorphism_right hq]

/-- **klt descends along a comparison resolution.** If a fixed resolution of the model compares
the adjoints of a klt pair `(X, B)` effectively, the transformed pair is klt. -/
private theorem Model.isRealKltPair_transformDivisor (hS : IsSetting sX sT g KX)
    (M : Model sX sT g) {B : RDivisor X} {GX GY : RDivisor M.W}
    (hR : IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h GX GY)
    (hB : IsRealKltPair sX B) :
    IsRealKltPair M.sY (MMP.Mori.RationalMap.transformDivisor M.φ B) := by
  have hXn : IsNormalVariety ℂ sX := ⟨hS.isProjectiveVariety.toIsVariety, inferInstance⟩
  obtain ⟨n, hKX⟩ := hS.isCanonicalDivisor
  obtain ⟨nY, hKY⟩ := M.isCanonicalDivisor
  have hkltY :=
    isLogDiscrepancy_pos_of_isLogComparisonResolution hR hXn M.isNormalVariety hKX hKY hB.2.2.2
  have hBY1 : ∀ F, (MMP.Mori.RationalMap.transformDivisor M.φ B).coeff F < 1 := fun F => by
    obtain ⟨P, -, -, -, hc⟩ := Model.exists_coeff_transformDivisor_eq hS M hR F
    rw [hc]
    exact hB.2.1 P
  refine ⟨M.isNormalVariety, hBY1, ⟨nY, M.KY, hKY, ?_⟩, hkltY⟩
  obtain ⟨m, r, L, -, hLc, hD, -, -⟩ := hR.isRCartierPullback_right
  refine ⟨m, r, L, hLc, fun Γ => ?_⟩
  rw [← MMP.Flips.coeff_sum_smul_toRDivisor, ← hD]
  rfl

/-- **The crepant centre.** Let `M` be a model over `T`, `g : X ⟶ T`, `h : T ⟶ Z`, and `(X, B)` an
effective klt pair with `K_X + B = g^* H + ∑ rᵢ div ψᵢ`. Then `K_Y + φ_* B` differs from
`H₁ = π_Y^* H` by a divisor numerically trivial over `Z`, the fixed resolution compares the two
adjoints crepantly, and `(Y, φ_* B)` is klt. -/
private theorem Model.exists_central (hS : IsSetting sX sT g KX) (M : Model sX sT g)
    {D0 : RDivisor X} {G0 G0' : RDivisor M.W}
    (hR0 : IsLogComparisonResolution sX M.sY M.sW M.φ KX D0 M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ D0) M.p M.q M.h G0 G0')
    [IsLocallyNoetherian T] [IsNormal T]
    {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of ℂ)} (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (h : T ⟶ Z) (hh : h ≫ sZ = sT) {B : RDivisor X} (hB : IsRealKltPair sX B)
    {H : RDivisor T} {gH : RDivisor X} (hgH : IsRCartierPullback g H gH)
    {m : ℕ} (r : Fin m → ℝ) (ψ : Fin m → (RationalFunctions X)ˣ)
    (hψ : logCanonicalDivisor KX B - gH =
      ∑ i, r i • Divisor.toRDivisor (principalDivisor (ψ i))) :
    ∃ H₁ : RDivisor M.Y, IsRCartierPullback M.πY H H₁ ∧
      IsNumericallyTrivialOver ℂ M.sY (M.πY ≫ h)
        (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ B) - H₁) ∧
      (∃ G : RDivisor M.W, IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
        (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h G G) ∧
      IsRealKltPair M.sY (MMP.Mori.RationalMap.transformDivisor M.φ B) := by
  classical
  have hXp := hS.isProjectiveVariety
  have hXn : IsNormalVariety ℂ sX := ⟨hXp.toIsVariety, inferInstance⟩
  have hYp := M.isProjectiveVariety
  have hYn := M.isNormalVariety
  have hWn : IsNormalVariety ℂ M.sW := ⟨hR0.isVariety, inferInstance⟩
  have hWnp : IsNormalVariety ℂ (M.p ≫ sX) := by rw [hR0.comp_eq_left]; exact hWn
  have hWnq : IsNormalVariety ℂ (M.q ≫ M.sY) := by rw [hR0.comp_eq_right]; exact hWn
  have hpb := hR0.isBirationalMorphism_left
  have hqb := hR0.isBirationalMorphism_right
  haveI := hXn.1
  haveI := hYn.1
  haveI := isProper_of_isProjectiveMorphism M.p hR0.isProjectiveMorphism_left
  haveI := isProper_of_isProjectiveMorphism M.q hR0.isProjectiveMorphism_right
  haveI : IsDominant M.p := hpb.isDominant
  haveI : IsDominant M.q := hqb.isDominant
  have hSY := Model.isSetting hS M hR0
  haveI := compactSpace_of_isLogComparisonResolution hR0
  haveI : IsIntegral T := hS.isProjectiveVariety_base.toIsVariety.toIsIntegral
  haveI : IsSeparated sT := hS.isProjectiveVariety_base.toIsVariety.toIsSeparated
  haveI := isSeparated_toTerminal sT
  haveI : IsDominant M.πY := hSY.isBirationalMorphism.isDominant
  haveI : IsDominant g := hS.isBirationalMorphism.isDominant
  haveI : QuasiCompact sX := inferInstance
  haveI : QuasiCompact M.sY := inferInstance
  have hWp : MMP.Mori.IsProjectiveVariety ℂ M.sW := by
    have hpr : IsProjectiveMorphism (M.p ≫ sX) :=
      hR0.isProjectiveMorphism_left.comp hXp.isProjective
    rw [hR0.comp_eq_left] at hpr
    exact { toIsVariety := hR0.isVariety, isProjective := hpr }
  have hpq : M.p ≫ g = M.q ≫ M.πY :=
    MMP.Fourfold.comp_eq_comp_of_isOver g M.πY M.isOver M.p M.q M.h hR0.isInverse hR0.compHom_eq
  -- the pull-back `H₁` and its pull-back to the resolution
  have hHc : IsCartierCombination H := by
    obtain ⟨k, c, L, -, hLc, hHL, -, -⟩ := hgH
    exact ⟨k, c, L, hLc, by rw [hHL]; rfl⟩
  obtain ⟨H₁, hH₁, -⟩ := existsUnique_isRCartierPullback M.πY hHc
  obtain ⟨G1, hG1pg, hG1p⟩ := exists_isRCartierPullback_comp M.p g hgH
  obtain ⟨G1', hG1'q, hG1'⟩ := exists_isRCartierPullback_comp M.q M.πY hH₁
  rw [← hpq] at hG1'q
  rw [IsRCartierPullback.eq (M.p ≫ g) hG1'q hG1pg] at hG1'
  -- the principal part and its pull-back
  set N : RDivisor X := ∑ i, r i • Divisor.toRDivisor (principalDivisor (ψ i)) with hNdef
  obtain ⟨NW, hNW, -⟩ := existsUnique_isRCartierPullback M.p
    (isCartierCombination_of_isRCartier (hS.isQFactorial.isRCartier N))
  have hNtriv : IsNumericallyTrivialOver ℂ sX (g ≫ h) N := by
    refine Finset.sum_induction _ (IsNumericallyTrivialOver ℂ sX (g ≫ h))
      (fun _ _ h₁ h₂ => isNumericallyTrivialOver_add h₁ h₂) ?_ fun i _ =>
        isNumericallyTrivialOver_smul_principalDivisor (g ≫ h) _ _
    simpa using isNumericallyTrivialOver_smul_principalDivisor (k := ℂ) (sX := sX) (g ≫ h) 0
      (1 : (RationalFunctions X)ˣ)
  obtain ⟨hNYtriv, hNYpb⟩ :=
    MMP.Fourfold.isNumericallyTrivialOver_transformDivisor_and_isRCartierPullback M.sW sX M.sY sZ
      hWn hWp hXn hXp M.isQFactorial hYp hZ (g ≫ h) (M.πY ≫ h)
      (by rw [Category.assoc, hh, hS.comp_eq]) (by rw [Category.assoc, hh, M.comp_eq]) M.p M.q
      hR0.comp_eq_left hR0.comp_eq_right (by rw [← Category.assoc, hpq, Category.assoc])
      hR0.isProjectiveMorphism_left hpb hR0.isProjectiveMorphism_right hqb hNtriv hNW
  -- identify the transforms
  have h1 : MMP.Mori.RationalMap.transformDivisor M.q.toRationalMap NW =
      MMP.Mori.RationalMap.transformDivisor M.φ N :=
    MMP.Fourfold.transformDivisor_eq_of_isRCartierPullback hXn hYn M.not_isInverseExceptional
      M.p M.q M.h hWnp hWnq hpb hqb hR0.isInverse hR0.compHom_eq hNW
  have h2 : MMP.Mori.RationalMap.transformDivisor M.q.toRationalMap G1 =
      MMP.Mori.RationalMap.transformDivisor M.φ gH :=
    MMP.Fourfold.transformDivisor_eq_of_isRCartierPullback hXn hYn M.not_isInverseExceptional
      M.p M.q M.h hWnp hWnq hpb hqb hR0.isInverse hR0.compHom_eq hG1p
  have h3 : MMP.Mori.RationalMap.transformDivisor M.q.toRationalMap G1 = H₁ :=
    transformDivisor_toRationalMap_of_isRCartierPullback hYn hWnq hqb hG1'
  have h4 := Model.transformDivisor_toRDivisor_canonical hS M hR0
  have hX : logCanonicalDivisor KX B = gH + N := by rw [← hψ]; abel
  have hlog : logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ B) =
      H₁ + MMP.Mori.RationalMap.transformDivisor M.q.toRationalMap NW := by
    have e : logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ B) =
        MMP.Mori.RationalMap.transformDivisor M.φ (logCanonicalDivisor KX B) := by
      simp only [logCanonicalDivisor, map_add, h4]
    rw [e, hX, map_add, ← h2, h3, h1]
  refine ⟨H₁, hH₁, by rw [hlog, add_sub_cancel_left]; exact hNYtriv, ?_⟩
  -- the crepant comparison at `B`
  have hGX : IsRCartierPullback M.p (logCanonicalDivisor KX B) (G1 + NW) := by
    rw [hX]; exact MMP.Fourfold.isRCartierPullback_add hG1p hNW
  have hGY : IsRCartierPullback M.q
      (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ B)) (G1 + NW) := by
    rw [hlog]; exact MMP.Fourfold.isRCartierPullback_add hG1' hNYpb
  have hRB : IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h (G1 + NW) (G1 + NW) :=
    { isVariety := hR0.isVariety
      isSmoothScheme := hR0.isSmoothScheme
      comp_eq_left := hR0.comp_eq_left
      comp_eq_right := hR0.comp_eq_right
      isProjectiveMorphism_left := hR0.isProjectiveMorphism_left
      isProjectiveMorphism_right := hR0.isProjectiveMorphism_right
      isBirationalMorphism_left := hpb
      isBirationalMorphism_right := hqb
      isInverse := hR0.isInverse
      compHom_eq := hR0.compHom_eq
      exists_canonicalDivisor := hR0.exists_canonicalDivisor
      isRCartierPullback_left := hGX
      isRCartierPullback_right := hGY
      effective := fun P => by simp
      isExceptional := fun P hP => by simp at hP }
  exact ⟨⟨_, hRB⟩, Model.isRealKltPair_transformDivisor hS M hRB hB⟩

end Central

/-! ### Segments from the crepant centre -/

section Cone

open MMP.Flips

/-- The strict transform of `a D + b E` is `a φ_* D + b φ_* E`. -/
private theorem transformDivisor_smul_add_smul {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (a b : ℝ) (D E : RDivisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (a • D + b • E) =
      a • MMP.Mori.RationalMap.transformDivisor φ D + b • MMP.Mori.RationalMap.transformDivisor φ E := by
  change MMP.Mori.RationalMap.transformDivisorₗ ℝ φ (a • D + b • E) = _
  rw [map_add, map_smul, map_smul]
  rfl

/-- `K + ((1 - ε) D₁ + ε D₂) = (1 - ε)(K + D₁) + ε (K + D₂)`. -/
private theorem logCanonicalDivisor_smul_add_smul {Y : Scheme.{0}} (K : Divisor Y)
    (D₁ D₂ : RDivisor Y) (ε : ℝ) :
    logCanonicalDivisor K ((1 - ε) • D₁ + ε • D₂) =
      (1 - ε) • logCanonicalDivisor K D₁ + ε • logCanonicalDivisor K D₂ := by
  simp only [logCanonicalDivisor, smul_add]
  module

/-- `∑ wᵢ Vᵢ` is linear in the weights. -/
private theorem wsum_smul_add_smul {Y : Scheme.{0}} {n : ℕ} (V : Fin n → RDivisor Y)
    (a b : ℝ) (u v : Fin n → ℝ) : wsum V (a • u + b • v) = a • wsum V u + b • wsum V v := by
  simp only [wsum, Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_smul, mul_smul,
    Finset.sum_add_distrib, Finset.smul_sum]

/-- `∑ wᵢ Vᵢ` is linear in the weights. -/
private theorem wsum_sum_smul {Y : Scheme.{0}} {n d : ℕ} (V : Fin n → RDivisor Y)
    (β : Fin d → ℝ) (c : Fin d → Fin n → ℝ) :
    wsum V (∑ j, β j • c j) = ∑ j, β j • wsum V (c j) := by
  simp only [wsum, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_smul, mul_smul,
    Finset.smul_sum]
  exact Finset.sum_comm

/-- A weight vanishing at `k` weighs the boundaries other than `V k`. -/
private theorem wsum_insertNth_zero {Y : Scheme.{0}} {m : ℕ} (V : Fin (m + 1) → RDivisor Y)
    (k : Fin (m + 1)) (u : Fin m → ℝ) :
    wsum V (Fin.insertNth k 0 u) = wsum (V ∘ k.succAbove) u := by
  simp only [wsum, Fin.sum_univ_succAbove _ k, Fin.insertNth_apply_same, zero_smul, zero_add,
    Fin.insertNth_apply_succAbove, Function.comp_apply]

/-- Inserting a zero coordinate is linear. -/
private theorem insertNth_zero_sum_smul {m d : ℕ} (k : Fin (m + 1)) (β : Fin d → ℝ)
    (c : Fin d → Fin m → ℝ) :
    Fin.insertNth k (0 : ℝ) (∑ j, β j • c j) = ∑ j, β j • Fin.insertNth k (0 : ℝ) (c j) := by
  funext i
  refine Fin.succAboveCases k ?_ (fun l => ?_) i
  · simp [Fin.insertNth_apply_same]
  · simp [Fin.insertNth_apply_succAbove, Finset.sum_apply]

/-- A real number which is the limit of nonnegative values along a segment is nonnegative. -/
private theorem nonneg_of_forall_smul_add_smul {a b : ℝ}
    (h : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → 0 ≤ (1 - ε) * a + ε * b) : 0 ≤ a := by
  have hcont : Continuous fun ε : ℝ => (1 - ε) * a + ε * b := by fun_prop
  have hlim : Filter.Tendsto (fun ε : ℝ => (1 - ε) * a + ε * b)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds a) := by
    have := (hcont.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))
    simpa using this
  refine ge_of_tendsto hlim ?_
  filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε'
  exact h ε hε'.1 hε'.2.le

/-- An affine function on `[0, 1]` which is nonzero at `0` is nonzero somewhere on `(0, 1]`. -/
private theorem exists_smul_add_smul_ne_zero {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    ∃ ε : ℝ, 0 < ε ∧ ε ≤ 1 ∧ (1 - ε) * a + ε * b ≠ 0 := by
  by_contra h
  push Not at h
  have h1 := h 1 one_pos le_rfl
  have h2 := h (1 / 2) (by norm_num) (by norm_num)
  apply ha
  linarith

/-- Finitely many positive numbers have a common positive lower bound, at most `1`. -/
private theorem exists_pos_le_of_finite {α : Type*} [Finite α] (f : α → ℝ)
    (hf : ∀ a, 0 < f a) : ∃ t > 0, t ≤ 1 ∧ ∀ a, t ≤ f a := by
  cases isEmpty_or_nonempty α with
  | inl h => exact ⟨1, one_pos, le_rfl, fun a => h.elim a⟩
  | inr h =>
    obtain ⟨a₀, ha₀⟩ := Finite.exists_min f
    exact ⟨min (f a₀) 1, lt_min (hf a₀) one_pos, min_le_right _ _,
      fun a => (min_le_left _ _).trans (ha₀ a)⟩

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
  {KX : Divisor X}

attribute [local instance] Model.isIntegral Model.compactSpace Model.isLocallyNoetherian
  Model.isNormal Model.isIntegral_res Model.isLocallyNoetherian_res Model.isNormal_res

/-- **The data of a piece at its vertices.** At every vertex `cⱼ` of a piece with some vertex
outside its removed face, even one in the removed face, the fixed resolution compares the
adjoints effectively, and the transformed adjoint is nef: both are closed conditions along the
segment from `cⱼ` to a vertex `cⱼ₀ ∉ F`, on which the model is valid. -/
private theorem Piece.exists_vertex (hS : IsSetting sX sZ π KX) {n : ℕ} {V : Fin n → RDivisor X}
    (Q : Piece sX sZ π KX V) {j₀ : Fin Q.d} (hj₀ : j₀ ∉ Q.F) (j : Fin Q.d) :
    ∃ G G' : RDivisor Q.model.W,
      IsLogComparisonResolution sX Q.model.sY Q.model.sW Q.model.φ KX (wsum V (Q.c j))
        Q.model.KY (MMP.Mori.RationalMap.transformDivisor Q.model.φ (wsum V (Q.c j)))
        Q.model.p Q.model.q Q.model.h G G' ∧
      IsRelativelyNef ℂ Q.model.sY Q.model.πY (logCanonicalDivisor Q.model.KY
        (MMP.Mori.RationalMap.transformDivisor Q.model.φ (wsum V (Q.c j)))) := by
  classical
  set M := Q.model with hM
  set D₁ := wsum V (Q.c j) with hD₁
  set D₂ := wsum V (Q.c j₀) with hD₂
  have hc : ∀ (a : Fin Q.d) (x : ℝ),
      ∑ i, (x * (Pi.single a (1 : ℝ) : Fin Q.d → ℝ) i) • Q.c i = x • Q.c a := by
    intro a x
    simp [Pi.single_apply, mul_ite, ite_smul]
  have hval : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → M.IsValidAt KX ((1 - ε) • D₁ + ε • D₂) := by
    intro ε h0 h1
    let β : Fin Q.d → ℝ := fun i => (1 - ε) * (Pi.single j (1 : ℝ) : Fin Q.d → ℝ) i +
      ε * (Pi.single j₀ (1 : ℝ) : Fin Q.d → ℝ) i
    have hβ : β ∈ stdSimplex ℝ (Fin Q.d) := by
      refine ⟨fun i => ?_, ?_⟩
      · simp only [β, Pi.single_apply]
        split_ifs <;> nlinarith
      · simp only [β, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_pi_single', 
          Finset.mem_univ, if_true]
        ring
    have hpos : 0 < β j₀ := by
      simp only [β, Pi.single_apply, if_true]
      split_ifs <;> nlinarith
    have := Q.valid β hβ ⟨j₀, hj₀, hpos⟩
    have heq : ∑ i, β i • Q.c i = (1 - ε) • Q.c j + ε • Q.c j₀ := by
      simp only [β, add_smul, Finset.sum_add_distrib, hc]
    rwa [heq, wsum_smul_add_smul] at this
  obtain ⟨-, -, GX₁, GY₁, hR₁, -⟩ := hval 1 one_pos le_rfl
  have hpb := hR₁.isBirationalMorphism_left
  have hqb := hR₁.isBirationalMorphism_right
  haveI : IsDominant M.p := hpb.isDominant
  haveI : IsDominant M.q := hqb.isDominant
  haveI := compactSpace_of_isLogComparisonResolution hR₁
  have hpull : ∀ D : RDivisor X, ∃ G : RDivisor M.W, IsRCartierPullback M.p D G := fun D =>
    (existsUnique_isRCartierPullback M.p
      (isCartierCombination_of_isRCartier (hS.isQFactorial.isRCartier D))).exists
  have hpullY : ∀ D : RDivisor M.Y, ∃ G : RDivisor M.W, IsRCartierPullback M.q D G := fun D =>
    (existsUnique_isRCartierPullback M.q
      (isCartierCombination_of_isRCartier (M.isQFactorial.isRCartier D))).exists
  obtain ⟨G₁, hG₁⟩ := hpull (logCanonicalDivisor KX D₁)
  obtain ⟨G₂, hG₂⟩ := hpull (logCanonicalDivisor KX D₂)
  obtain ⟨G₁', hG₁'⟩ := hpullY (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ D₁))
  obtain ⟨G₂', hG₂'⟩ := hpullY (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ D₂))
  -- along the segment the comparison is the affine combination
  have hseg : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∃ (GX GY : RDivisor M.W),
      IsLogComparisonResolution sX M.sY M.sW M.φ KX ((1 - ε) • D₁ + ε • D₂) M.KY
        (MMP.Mori.RationalMap.transformDivisor M.φ ((1 - ε) • D₁ + ε • D₂)) M.p M.q M.h GX GY ∧
      GX - GY = (1 - ε) • (G₁ - G₁') + ε • (G₂ - G₂') := by
    intro ε h0 h1
    obtain ⟨-, -, GX, GY, hR, -⟩ := hval ε h0 h1
    refine ⟨GX, GY, hR, ?_⟩
    have eX : GX = (1 - ε) • G₁ + ε • G₂ := by
      refine IsRCartierPullback.eq M.p hR.isRCartierPullback_left ?_
      rw [logCanonicalDivisor_smul_add_smul]
      exact MMP.Fourfold.isRCartierPullback_add (MMP.Fourfold.isRCartierPullback_smul _ hG₁)
        (MMP.Fourfold.isRCartierPullback_smul _ hG₂)
    have eY : GY = (1 - ε) • G₁' + ε • G₂' := by
      refine IsRCartierPullback.eq M.q hR.isRCartierPullback_right ?_
      rw [transformDivisor_smul_add_smul, logCanonicalDivisor_smul_add_smul]
      exact MMP.Fourfold.isRCartierPullback_add (MMP.Fourfold.isRCartierPullback_smul _ hG₁')
        (MMP.Fourfold.isRCartierPullback_smul _ hG₂')
    rw [eX, eY]
    module
  have hcoeff : ∀ ε : ℝ, ∀ P, ((1 - ε) • (G₁ - G₁') + ε • (G₂ - G₂')).coeff P =
      (1 - ε) * (G₁ - G₁').coeff P + ε * (G₂ - G₂').coeff P := fun ε P => by
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul]
  refine ⟨G₁, G₁', ?_, ?_⟩
  · exact
    { isVariety := hR₁.isVariety
      isSmoothScheme := hR₁.isSmoothScheme
      comp_eq_left := hR₁.comp_eq_left
      comp_eq_right := hR₁.comp_eq_right
      isProjectiveMorphism_left := hR₁.isProjectiveMorphism_left
      isProjectiveMorphism_right := hR₁.isProjectiveMorphism_right
      isBirationalMorphism_left := hpb
      isBirationalMorphism_right := hqb
      isInverse := hR₁.isInverse
      compHom_eq := hR₁.compHom_eq
      exists_canonicalDivisor := hR₁.exists_canonicalDivisor
      isRCartierPullback_left := hG₁
      isRCartierPullback_right := hG₁'
      effective := fun P => nonneg_of_forall_smul_add_smul fun ε h0 h1 => by
        obtain ⟨GX, GY, hR, he⟩ := hseg ε h0 h1
        have := hR.effective P
        rwa [he, hcoeff] at this
      isExceptional := fun P hP => by
        obtain ⟨ε, h0, h1, hne⟩ := exists_smul_add_smul_ne_zero hP ((G₂ - G₂').coeff P)
        obtain ⟨GX, GY, hR, he⟩ := hseg ε h0 h1
        exact hR.isExceptional P (by rw [he, hcoeff]; exact hne) }
  · refine isRelativelyNef_of_forall_smul_add_smul
      (isCartierCombination_of_isRCartier (M.isQFactorial.isRCartier _))
      (isCartierCombination_of_isRCartier (M.isQFactorial.isRCartier
        (logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ D₂)))) fun ε h0 h1 => ?_
    have hN : IsRelativelyNef ℂ M.sY M.πY (logCanonicalDivisor M.KY
        (MMP.Mori.RationalMap.transformDivisor M.φ ((1 - ε) • D₁ + ε • D₂))) :=
      (hval ε h0 h1).1.isRelativelyNef
    rw [transformDivisor_smul_add_smul, logCanonicalDivisor_smul_add_smul] at hN
    exact hN

/-- **Validity along a segment from a crepant centre.** If the fixed resolution of `M` compares the
adjoints at `B` crepantly and is valid-comparing at `D`, then `M` is valid at every
`(1 - τ) B + τ D`, `0 < τ ≤ 1`, at which the transformed adjoint is nef. -/
private theorem Model.isValidAt_smul_add_smul (hS : IsSetting sX sZ π KX) (M : Model sX sZ π)
    {B D : RDivisor X} (hB0 : ∀ P, 0 ≤ B.coeff P) (hBklt : IsRealKltPair sX B)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDklt : IsRealKltPair sX D) {G : RDivisor M.W}
    (hRB : IsLogComparisonResolution sX M.sY M.sW M.φ KX B M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ B) M.p M.q M.h G G)
    {GX GY : RDivisor M.W}
    (hRD : IsLogComparisonResolution sX M.sY M.sW M.φ KX D M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ D) M.p M.q M.h GX GY)
    (hposD : ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M.φ P →
      ∀ P' : MMP.Mori.PrimeDivisor M.W,
        MMP.Mori.RationalMap.transformPrimeDivisor M.h P = some P' → 0 < (GX - GY).coeff P')
    {τ : ℝ} (hτ0 : 0 < τ) (hτ1 : τ ≤ 1)
    (hnef : IsRelativelyNef ℂ M.sY M.πY (logCanonicalDivisor M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ ((1 - τ) • B + τ • D)))) :
    M.IsValidAt KX ((1 - τ) • B + τ • D) := by
  have hdiff : (1 - τ) • G + τ • GX - ((1 - τ) • G + τ • GY) = τ • (GX - GY) := by module
  have hcoeff : ∀ P, (τ • (GX - GY)).coeff P = τ * (GX - GY).coeff P := fun P => by
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, smul_eq_mul]
  have h0 : ∀ P, 0 ≤ ((1 - τ) • B + τ • D).coeff P := fun P => by
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.smul_apply,
      smul_eq_mul]
    have := hB0 P
    have := hD0 P
    simp only [DivisorWithCoeffs.coeff_apply] at *
    nlinarith
  have hklt : IsRealKltPair sX ((1 - τ) • B + τ • D) := by
    have := isRealKltPair_wsum hS.isQFactorial (V := ![B, D]) (fun i => by
      fin_cases i
      · exact hBklt
      · exact hDklt) (w := ![1 - τ, τ]) ⟨fun i => by
        fin_cases i
        · simp; linarith
        · simp; linarith, by simp⟩
    simpa [wsum, Fin.sum_univ_two] using this
  have hR : IsLogComparisonResolution sX M.sY M.sW M.φ KX ((1 - τ) • B + τ • D) M.KY
      (MMP.Mori.RationalMap.transformDivisor M.φ ((1 - τ) • B + τ • D)) M.p M.q M.h
      ((1 - τ) • G + τ • GX) ((1 - τ) • G + τ • GY) :=
    { isVariety := hRD.isVariety
      isSmoothScheme := hRD.isSmoothScheme
      comp_eq_left := hRD.comp_eq_left
      comp_eq_right := hRD.comp_eq_right
      isProjectiveMorphism_left := hRD.isProjectiveMorphism_left
      isProjectiveMorphism_right := hRD.isProjectiveMorphism_right
      isBirationalMorphism_left := hRD.isBirationalMorphism_left
      isBirationalMorphism_right := hRD.isBirationalMorphism_right
      isInverse := hRD.isInverse
      compHom_eq := hRD.compHom_eq
      exists_canonicalDivisor := hRD.exists_canonicalDivisor
      isRCartierPullback_left := by
        rw [logCanonicalDivisor_smul_add_smul]
        exact MMP.Fourfold.isRCartierPullback_add
          (MMP.Fourfold.isRCartierPullback_smul _ hRB.isRCartierPullback_left)
          (MMP.Fourfold.isRCartierPullback_smul _ hRD.isRCartierPullback_left)
      isRCartierPullback_right := by
        rw [transformDivisor_smul_add_smul, logCanonicalDivisor_smul_add_smul]
        exact MMP.Fourfold.isRCartierPullback_add
          (MMP.Fourfold.isRCartierPullback_smul _ hRB.isRCartierPullback_right)
          (MMP.Fourfold.isRCartierPullback_smul _ hRD.isRCartierPullback_right)
      effective := fun P => by
        rw [hdiff, hcoeff]
        exact mul_nonneg hτ0.le (hRD.effective P)
      isExceptional := fun P hP => by
        rw [hdiff, hcoeff] at hP
        exact hRD.isExceptional P (right_ne_zero_of_mul hP) }
  refine Model.isValidAt_of M hS.isCanonicalDivisor hS.comp_eq h0 hklt hR
    (fun P hP P' hP' => ?_) hnef (Model.isRealKltPair_transformDivisor hS M hR hklt)
  rw [hdiff, hcoeff]
  exact mul_pos hτ0 (hposD P hP P' hP')

end Cone

/-! ### The induction -/

section Induction

/-- The statement proved by induction on the number `n` of vertices. -/
private def Claim (n : ℕ) : Prop :=
  ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X}, IsSetting sX sZ π KX → ∀ V : Fin n → RDivisor X,
      (∀ i P, 0 ≤ (V i).coeff P) → (∀ i, IsRealKltPair sX (V i)) →
      HasPieces sX sZ π KX V (stdSimplex ℝ (Fin n))

private theorem claim_zero : Claim 0 := by
  intro X Z _ _ _ _ sX _ sZ π KX _ V _ _
  refine hasPieces_empty.mono fun w hw => ?_
  have := hw.2
  simp at this

/-- **Local finiteness at a nef centre.** Assuming the claim for `m` vertices, let
`K_X + ∑ w⁰ᵢ Vᵢ` be nef over `Z`. Then a punctured neighbourhood of `w⁰` in the simplex of weights
is covered by finitely many pieces. -/
private theorem exists_nhds_hasPieces_of_isRelativelyNef {m : ℕ} (hm : Claim m)
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} (hS : IsSetting sX sZ π KX) (V : Fin (m + 1) → RDivisor X)
    (hV0 : ∀ i P, 0 ≤ (V i).coeff P) (hVklt : ∀ i, IsRealKltPair sX (V i))
    (w₀ : Fin (m + 1) → ℝ) (hw₀ : w₀ ∈ stdSimplex ℝ (Fin (m + 1)))
    (hnef : IsRelativelyNef ℂ sX π (logCanonicalDivisor KX (wsum V w₀))) :
    ∃ U ∈ nhds w₀, HasPieces sX sZ π KX V ((stdSimplex ℝ (Fin (m + 1)) ∩ U) \ {w₀}) := by
  classical
  set B := wsum V w₀ with hBdef
  have hB0 : ∀ P, 0 ≤ B.coeff P := coeff_wsum_nonneg hV0 hw₀
  have hBklt : IsRealKltPair sX B := isRealKltPair_wsum hS.isQFactorial hVklt hw₀
  have hXp := hS.isProjectiveVariety
  have hZp := hS.isProjectiveVariety_base
  haveI : IsSeparated sX := hXp.toIsVariety.toIsSeparated
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ hXp.isProjective
  haveI : IsSeparated sZ := hZp.toIsVariety.toIsSeparated
  haveI : IsProper sZ := isProper_of_isProjectiveMorphism _ hZp.isProjective
  haveI : IsIntegral Z := hZp.toIsVariety.toIsIntegral
  obtain ⟨n, hK⟩ := hS.isCanonicalDivisor
  have hbig := isRelativelyBig_zero_of_isBirationalMorphism sX sZ π hXp hS.isQFactorial hZp
    hS.isNormalVariety_base hS.comp_eq hS.isBirationalMorphism
  -- the contraction defined by the nef adjoint
  obtain ⟨T, _, _, _, _, sT, g, h, H, hTp, hcon, hgh, hHamp, ⟨gH, hgH, mψ, rψ, ψ, hψ⟩, -⟩ :=
    MMP.Fourfold.exists_isContraction_of_isRelativelyNef_of_isRelativelyBig sX sZ π hS.comp_eq
      hXp hS.isQFactorial hZp n KX hK B hB0 hBklt 0 (fun _ => by simp)
      (fun P => by simpa using hB0 P) hbig hnef
  haveI : IsSeparated sT := hTp.toIsVariety.toIsSeparated
  haveI : IsProper sT := isProper_of_isProjectiveMorphism _ hTp.isProjective
  haveI : IsDominant g := ⟨hcon.surjective.denseRange⟩
  haveI : LocallyOfFiniteType g := by
    haveI : LocallyOfFiniteType (g ≫ sT) := by rw [hcon.comp_eq]; infer_instance
    exact LocallyOfFiniteType.of_comp (f := g) (g := sT) this
  have hh : h ≫ sZ = sT := eq_of_comp_eq_of_isDominant (g := g)
    (by rw [← Category.assoc, hgh, hS.comp_eq, hcon.comp_eq])
  have hST : IsSetting sX sT g KX :=
    ⟨hXp, hTp, hcon.isNormalVariety_target, hcon.comp_eq, hcon.isProjectiveMorphism,
      isBirationalMorphism_of_comp_right g h (by rw [hgh]; exact hS.isBirationalMorphism),
      hS.dim_eq, hS.isQFactorial, hS.isCanonicalDivisor⟩
  -- pieces for the faces, over `T`
  have hface : ∀ k : Fin (m + 1),
      HasPieces sX sT g KX (V ∘ k.succAbove) (stdSimplex ℝ (Fin m)) :=
    fun k => hm hST (V ∘ k.succAbove) (fun i P => hV0 _ P) (fun i => hVklt _)
  choose ι hι P hP using hface
  set TB := fun (k : Fin (m + 1)) (i : ι k) =>
    MMP.Mori.RationalMap.transformDivisor (P k i).model.φ B with hTB
  -- a uniform length of segments at each face piece
  have hgood : ∀ k (i : ι k), ∃ t > 0, ∀ j₀ : Fin (P k i).d, j₀ ∉ (P k i).F →
      (∃ G : RDivisor (P k i).model.W, IsLogComparisonResolution sX (P k i).model.sY
        (P k i).model.sW (P k i).model.φ KX B (P k i).model.KY (TB k i) (P k i).model.p
        (P k i).model.q (P k i).model.h G G) ∧
      ∀ j, ∀ s : ℝ, 0 ≤ s → s ≤ t → IsRelativelyNef ℂ (P k i).model.sY ((P k i).model.πY ≫ h)
        ((1 - s) • logCanonicalDivisor (P k i).model.KY (TB k i) +
          s • logCanonicalDivisor (P k i).model.KY (MMP.Mori.RationalMap.transformDivisor
            (P k i).model.φ (wsum (V ∘ k.succAbove) ((P k i).c j)))) := by
    intro k i
    by_cases hne : ∃ j₀, j₀ ∉ (P k i).F
    swap
    · push Not at hne
      exact ⟨1, one_pos, fun j₀ hj₀ => absurd (hne j₀) hj₀⟩
    obtain ⟨j₀, hj₀⟩ := hne
    set M := (P k i).model with hM
    obtain ⟨G0, G0', hR0, -⟩ := Piece.exists_vertex hST (P k i) hj₀ j₀
    obtain ⟨H₁, hH₁, htriv, ⟨G, hRB⟩, -⟩ :=
      Model.exists_central hST M hR0 hZp h hh hBklt hgH rψ ψ hψ
    have hSY := Model.isSetting hST M hR0
    haveI : LocallyOfFiniteType M.sY := M.isNormalVariety.1.toLocallyOfFiniteType
    have hvert : ∀ j, ∃ t > 0, ∀ s : ℝ, 0 ≤ s → s ≤ t →
        IsRelativelyNef ℂ M.sY (M.πY ≫ h)
          ((1 - s) • logCanonicalDivisor M.KY (TB k i) +
            s • logCanonicalDivisor M.KY (MMP.Mori.RationalMap.transformDivisor M.φ
              (wsum (V ∘ k.succAbove) ((P k i).c j)))) := by
      intro j
      obtain ⟨Gj, Gj', hRj, hnefj⟩ := Piece.exists_vertex hST (P k i) hj₀ j
      have hDklt := isRealKltPair_wsum hS.isQFactorial (fun l => hVklt (k.succAbove l))
        ((P k i).c_mem j)
      have hCklt := Model.isRealKltPair_transformDivisor hST M hRj hDklt
      have hC0 := coeff_transformDivisor_nonneg M.φ
        (coeff_wsum_nonneg (fun l => hV0 (k.succAbove l)) ((P k i).c_mem j))
      obtain ⟨t, ht, hs⟩ :=
        exists_pos_isRelativelyNef_smul_add_smul hSY hZp h hh hHamp hH₁ hC0 hCklt hnefj
      refine ⟨t, ht, fun s hs0 hs1 => ?_⟩
      have h1 := IsRelativelyNef.sub_of_isNumericallyTrivialOver (hs s hs0 hs1)
        (isNumericallyTrivialOver_smul_add_smul htriv htriv (-(1 - s)) 0)
      convert h1 using 1
      simp only [zero_smul, add_zero, neg_smul, sub_neg_eq_add, smul_sub]
      abel
    choose t ht hts using hvert
    obtain ⟨t₁, ht₁, -, ht₁le⟩ := exists_pos_le_of_finite t ht
    exact ⟨t₁, ht₁, fun _ _ => ⟨⟨G, hRB⟩, fun j s hs0 hs1 => hts j s hs0 (hs1.trans (ht₁le j))⟩⟩
  choose tp htp hgoodp using hgood
  haveI := hι
  obtain ⟨t₀, ht₀, ht₀1, ht₀le⟩ :=
    exists_pos_le_of_finite (fun a : (Σ k, ι k) => tp a.1 a.2) fun a => htp a.1 a.2
  -- the cone pieces
  have hins : ∀ (k : Fin (m + 1)) (u : Fin m → ℝ), u ∈ stdSimplex ℝ (Fin m) →
      Fin.insertNth k (0 : ℝ) u ∈ stdSimplex ℝ (Fin (m + 1)) := by
    intro k u hu
    refine ⟨fun x => ?_, ?_⟩
    · refine Fin.succAboveCases k ?_ (fun l => ?_) x
      · simp
      · rw [Fin.insertNth_apply_succAbove]; exact hu.1 l
    · rw [Fin.sum_univ_succAbove _ k, Fin.insertNth_apply_same, zero_add]
      simp only [Fin.insertNth_apply_succAbove]
      exact hu.2
  let C : (Σ k, ι k) → Piece sX sZ π KX V := fun a =>
    { model := (P a.1 a.2).model.toBase hh hgh
      d := (P a.1 a.2).d + 1
      c := Fin.cons w₀ fun j => (1 - t₀) • w₀ + t₀ • Fin.insertNth a.1 0 ((P a.1 a.2).c j)
      c_mem := Fin.cases hw₀ fun j => (convex_stdSimplex ℝ _) hw₀
        (hins a.1 _ ((P a.1 a.2).c_mem j)) (by linarith) ht₀.le (by ring)
      F := insert 0 ((P a.1 a.2).F.map (Fin.succEmb _))
      valid := by
        obtain ⟨k, i⟩ := a
        dsimp only
        intro β hβ ⟨j', hj'F, hj'pos⟩
        -- `j'` is a vertex `j.succ` with `j ∉ F`
        have hj0 : j' ≠ 0 := fun h0 => hj'F (by rw [h0]; exact Finset.mem_insert_self _ _)
        obtain ⟨j, rfl⟩ := Fin.exists_succ_eq.mpr hj0
        have hjF : j ∉ (P k i).F := fun h => hj'F (Finset.mem_insert_of_mem
          (Finset.mem_map.mpr ⟨j, h, rfl⟩))
        set σ := ∑ l, β (Fin.succ l) with hσ
        have hσpos : 0 < σ := lt_of_lt_of_le hj'pos
          (Finset.single_le_sum (f := fun l => β (Fin.succ l)) (fun l _ => hβ.1 _)
            (Finset.mem_univ j))
        have hβ0 : β 0 = 1 - σ := by
          have := hβ.2
          rw [Fin.sum_univ_succ] at this
          linarith
        set γ : Fin (P k i).d → ℝ := fun l => β (Fin.succ l) / σ with hγ
        have hγΔ : γ ∈ stdSimplex ℝ (Fin (P k i).d) :=
          ⟨fun l => div_nonneg (hβ.1 _) hσpos.le, by
            simp only [hγ, ← Finset.sum_div, ← hσ, div_self hσpos.ne']⟩
        have hγpos : 0 < γ j := div_pos hj'pos hσpos
        set τ := t₀ * σ with hτ
        have hσ1 : σ ≤ 1 := by linarith [hβ.1 0]
        have hτ0 : 0 < τ := mul_pos ht₀ hσpos
        have hτ1 : τ ≤ t₀ := by nlinarith
        set D := wsum (V ∘ k.succAbove) (∑ l, γ l • (P k i).c l) with hD
        -- the point is on the segment from `B` to `D`
        have hpt : wsum V (∑ j', β j' • Fin.cons (α := fun _ => Fin (m + 1) → ℝ) w₀
            (fun l => (1 - t₀) • w₀ + t₀ • Fin.insertNth k 0 ((P k i).c l)) j') =
            (1 - τ) • B + τ • D := by
          have e : ∑ j', β j' • Fin.cons (α := fun _ => Fin (m + 1) → ℝ) w₀
              (fun l => (1 - t₀) • w₀ + t₀ • Fin.insertNth k 0 ((P k i).c l)) j' =
              (1 - τ) • w₀ + τ • Fin.insertNth k (0 : ℝ) (∑ l, γ l • (P k i).c l) := by
            rw [Fin.sum_univ_succ, insertNth_zero_sum_smul]
            simp only [Fin.cons_zero, Fin.cons_succ, smul_add, Finset.sum_add_distrib, smul_smul,
              ← Finset.sum_smul, Finset.smul_sum, hβ0]
            have hγσ : ∀ l, τ * γ l = t₀ * β (Fin.succ l) := fun l => by
              simp only [hτ, hγ]
              field_simp
            simp only [hγσ, ← hσ]
            have e2 : ∑ l, β (Fin.succ l) * (1 - t₀) = σ * (1 - t₀) := by
              rw [← Finset.sum_mul]
            rw [e2]
            have e3 : ∀ l, β (Fin.succ l) * t₀ = t₀ * β (Fin.succ l) := fun l => mul_comm _ _
            simp only [e3]
            rw [← add_assoc, ← add_smul]
            congr 2
            ring
          rw [e, wsum_smul_add_smul, wsum_insertNth_zero]
        -- validity on the face
        obtain ⟨-, -, GX, GY, hRD, hposD⟩ := (P k i).valid γ hγΔ ⟨j, hjF, hγpos⟩
        obtain ⟨⟨G, hRB⟩, hnefv⟩ := hgoodp k i j hjF
        have hD0 : ∀ P, 0 ≤ D.coeff P := coeff_wsum_nonneg (fun l => hV0 (k.succAbove l))
          (sum_smul_mem_stdSimplex hγΔ (P k i).c_mem)
        have hDklt : IsRealKltPair sX D := isRealKltPair_wsum hS.isQFactorial
          (fun l => hVklt (k.succAbove l)) (sum_smul_mem_stdSimplex hγΔ (P k i).c_mem)
        change ((P k i).model.toBase hh hgh).IsValidAt KX _
        rw [hpt]
        refine Model.isValidAt_smul_add_smul hS ((P k i).model.toBase hh hgh) hB0 hBklt hD0 hDklt
          hRB hRD hposD hτ0 (hτ1.trans ht₀1) ?_
        -- nefness over `Z` by convexity in the vertices
        change IsRelativelyNef ℂ (P k i).model.sY ((P k i).model.πY ≫ h)
          (logCanonicalDivisor (P k i).model.KY (MMP.Mori.RationalMap.transformDivisor
            (P k i).model.φ ((1 - τ) • B + τ • D)))
        have hTD : MMP.Mori.RationalMap.transformDivisor (P k i).model.φ D =
            ∑ l, γ l • MMP.Mori.RationalMap.transformDivisor (P k i).model.φ
              (wsum (V ∘ k.succAbove) ((P k i).c l)) := by
          rw [hD, wsum_sum_smul]
          change MMP.Mori.RationalMap.transformDivisorₗ ℝ (P k i).model.φ _ = _
          rw [map_sum]
          simp only [map_smul]
          rfl
        rw [transformDivisor_smul_add_smul, hTD, logCanonicalDivisor_affine _ _ _ hγΔ.2]
        have e : (1 - τ) • logCanonicalDivisor (P k i).model.KY (TB k i) +
            τ • ∑ l, γ l • logCanonicalDivisor (P k i).model.KY
              (MMP.Mori.RationalMap.transformDivisor (P k i).model.φ (wsum (V ∘ k.succAbove) ((P k i).c l))) =
            ∑ l, γ l • ((1 - τ) • logCanonicalDivisor (P k i).model.KY (TB k i) +
              τ • logCanonicalDivisor (P k i).model.KY (MMP.Mori.RationalMap.transformDivisor
                (P k i).model.φ (wsum (V ∘ k.succAbove) ((P k i).c l)))) := by
          simp only [smul_add, Finset.sum_add_distrib, ← Finset.sum_smul, hγΔ.2, one_smul,
            Finset.smul_sum, smul_smul, mul_comm]
          rw [← Finset.sum_mul, hγΔ.2, one_mul]
        rw [e]
        exact isRelativelyNef_sum_smul Finset.univ
          (fun l _ => hnefv l τ hτ0.le (hτ1.trans (ht₀le ⟨k, i⟩)))
          (fun l _ => hγΔ.1 l) (isRelativelyNef_zero _) }
  -- the radial cover
  obtain ⟨δ, hδ, hrad⟩ := exists_radial hw₀ ht₀
  refine ⟨Metric.ball w₀ δ, Metric.ball_mem_nhds w₀ hδ, Σ k, ι k, inferInstance, C, ?_⟩
  rintro w ⟨⟨hwΔ, hwU⟩, hne⟩
  have hdist : ∀ x, |w x - w₀ x| < δ := fun x => by
    have := (dist_pi_lt_iff hδ).1 (Metric.mem_ball.mp hwU) x
    rwa [Real.dist_eq] at this
  obtain ⟨k, t', u, ht'0, ht't₀, hu, hwu⟩ := hrad w hwΔ hdist hne
  obtain ⟨i, β, hβ, ⟨j, hjF, hβj⟩, hu_eq⟩ := hP k u hu
  refine ⟨⟨k, i⟩, Fin.cons (1 - t' / t₀) fun l => t' / t₀ * β l, ⟨fun x => ?_, ?_⟩,
    ⟨Fin.succ j, ?_, ?_⟩, ?_⟩
  · refine Fin.cases ?_ (fun l => ?_) x
    · simp only [Fin.cons_zero, sub_nonneg]
      exact (div_le_one ht₀).mpr ht't₀
    · simp only [Fin.cons_succ]
      exact mul_nonneg (div_nonneg ht'0.le ht₀.le) (hβ.1 l)
  · rw [Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, ← Finset.mul_sum, hβ.2, mul_one]
    ring
  · intro hmem
    rcases Finset.mem_insert.mp hmem with h0 | h1
    · exact Fin.succ_ne_zero _ h0
    · obtain ⟨l, hl, hl'⟩ := Finset.mem_map.mp h1
      have : l = j := Fin.succ_injective _ hl'
      exact hjF (this ▸ hl)
  · simp only [Fin.cons_succ]
    exact mul_pos (div_pos ht'0 ht₀) hβj
  · change w = ∑ x, Fin.cons (α := fun _ => ℝ) (1 - t' / t₀) (fun l => t' / t₀ * β l) x •
      Fin.cons (α := fun _ => Fin (m + 1) → ℝ) w₀
        (fun l => (1 - t₀) • w₀ + t₀ • Fin.insertNth k 0 ((P k i).c l)) x
    rw [Fin.sum_univ_succ, hwu, hu_eq, insertNth_zero_sum_smul]
    simp only [Fin.cons_zero, Fin.cons_succ, smul_add, Finset.sum_add_distrib, smul_smul,
      ← Finset.sum_smul, Finset.smul_sum]
    have e2 : ∑ l, t' / t₀ * β l * (1 - t₀) = t' / t₀ * (1 - t₀) := by
      rw [← Finset.sum_mul, ← Finset.mul_sum, hβ.2, mul_one]
    have e3 : ∀ l, t' / t₀ * β l * t₀ = t' * β l := fun l => by
      field_simp
    rw [e2]
    simp only [e3]
    rw [← add_assoc, ← add_smul]
    congr 2
    field_simp
    ring

/-- A divisor supported on a finite set `S` of prime divisors is `∑_{P ∈ S} D_P P`, indexed by an
enumeration of `S`. -/
private theorem eq_sum_single_coeff {Y : Scheme.{0}} (S : Finset (MMP.Mori.PrimeDivisor Y))
    {D : RDivisor Y} (hD : D.support ⊆ S) :
    D = ∑ l : Fin S.card, Finsupp.single (S.equivFin.symm l : MMP.Mori.PrimeDivisor Y)
      (D.coeff (S.equivFin.symm l)) := by
  classical
  rw [Equiv.sum_comp S.equivFin.symm (fun x : S => Finsupp.single (x : MMP.Mori.PrimeDivisor Y)
    (D.coeff x)), Finset.sum_coe_sort S (fun x => Finsupp.single x (D.coeff x))]
  conv_lhs => rw [← Finsupp.sum_single D]
  exact Finsupp.sum_of_support_subset D hD _ (fun _ _ => Finsupp.single_zero _)

/-- The coefficient of an affine combination of differences. -/
private theorem coeff_affine_sub {Y : Scheme.{0}} {n : ℕ} (ρ : ℝ) (w : Fin n → ℝ)
    (A A' : RDivisor Y) (F F' : Fin n → RDivisor Y) (P : MMP.Mori.PrimeDivisor Y) :
    ((1 - ρ) • A + ρ • ∑ i, w i • F i - ((1 - ρ) • A' + ρ • ∑ i, w i • F' i)).coeff P =
      (1 - ρ) * (A - A').coeff P + ρ * ∑ i, w i * (F i - F' i).coeff P := by
  simp only [DivisorWithCoeffs.coeff_apply, Finsupp.sub_apply, Finsupp.add_apply,
    Finsupp.smul_apply, Finsupp.finset_sum_apply, smul_eq_mul, mul_sub, Finset.sum_sub_distrib]
  ring

/-- **Local finiteness.** Assuming the claim for `m` vertices, every weight `w⁰` of `m + 1`
boundaries has a neighbourhood whose weights are covered by finitely many pieces. -/
private theorem exists_nhds_hasPieces {m : ℕ} (hm : Claim m)
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} (hS : IsSetting sX sZ π KX) (V : Fin (m + 1) → RDivisor X)
    (hV0 : ∀ i P, 0 ≤ (V i).coeff P) (hVklt : ∀ i, IsRealKltPair sX (V i))
    (w₀ : Fin (m + 1) → ℝ) (hw₀ : w₀ ∈ stdSimplex ℝ (Fin (m + 1))) :
    ∃ U ∈ nhds w₀, HasPieces sX sZ π KX V (stdSimplex ℝ (Fin (m + 1)) ∩ U) := by
  classical
  -- the central boundary and its model
  set B := wsum V w₀ with hBdef
  have hB0 : ∀ P, 0 ≤ B.coeff P := coeff_wsum_nonneg hV0 hw₀
  have hBklt : IsRealKltPair sX B := isRealKltPair_wsum hS.isQFactorial hVklt hw₀
  obtain ⟨M0, hM0⟩ := exists_model_isValidAt hS hB0 hBklt
  have hvalid0 := hM0
  obtain ⟨hmodel0, hkltY0, G0, G0', hR0, hpos0⟩ := hM0
  haveI : LocallyOfFiniteType M0.sY := M0.isNormalVariety.1.toLocallyOfFiniteType
  have hS0 : IsSetting M0.sY sZ M0.πY M0.KY := M0.isSetting hS hR0
  set T := MMP.Mori.RationalMap.transformDivisor (R := ℝ) M0.φ with hTdef
  haveI : QuasiCompact M0.sW := hR0.isVariety.toQuasiCompact
  haveI : CompactSpace M0.W := QuasiCompact.compactSpace_of_compactSpace M0.sW
  haveI : IsDominant M0.p := hR0.isBirationalMorphism_left.isDominant
  haveI : IsDominant M0.q := hR0.isBirationalMorphism_right.isDominant
  -- pull-backs of the vertices to the resolution of `M₀`
  have hXc : ∀ D : RDivisor X, IsCartierCombination D :=
    isCartierCombination_of_forall hS.isQFactorial.2
  have hY0c : ∀ D : RDivisor M0.Y, IsCartierCombination D :=
    isCartierCombination_of_forall M0.isQFactorial.2
  choose GV hGV using fun i => (MMP.Flips.existsUnique_isRCartierPullback M0.p
    (hXc (logCanonicalDivisor KX (V i)))).exists
  choose GV' hGV' using fun i => (MMP.Flips.existsUnique_isRCartierPullback M0.q
    (hY0c (logCanonicalDivisor M0.KY (T (V i))))).exists
  -- the shrinking factor `ρ`
  set Spos := (G0 - G0').support
  have hev_pos : ∀ᶠ ρ in nhds (0 : ℝ), ∀ P' ∈ Spos, 0 < (G0 - G0').coeff P' →
      ∀ i, 0 < (1 - ρ) * (G0 - G0').coeff P' + ρ * (GV i - GV' i).coeff P' := by
    refine (Filter.eventually_all_finset Spos).2 fun P' _ => ?_
    by_cases hP' : 0 < (G0 - G0').coeff P'
    · have h1 : ∀ᶠ ρ in nhds (0 : ℝ), ∀ i,
          0 < (1 - ρ) * (G0 - G0').coeff P' + ρ * (GV i - GV' i).coeff P' :=
        Filter.eventually_all.2 fun i =>
          ((by fun_prop : Continuous fun ρ : ℝ =>
            (1 - ρ) * (G0 - G0').coeff P' + ρ * (GV i - GV' i).coeff P').tendsto 0).eventually
            (lt_mem_nhds (by simpa using hP'))
      exact h1.mono fun ρ hρ _ => hρ
    · exact Filter.Eventually.of_forall fun ρ h => absurd h hP'
  -- klt of the pushed vertices for small `ρ`
  set SY : Finset (MMP.Mori.PrimeDivisor M0.Y) :=
    (T B).support ∪ Finset.univ.biUnion fun i => (T (V i)).support
  set pY : Fin SY.card → MMP.Mori.PrimeDivisor M0.Y := fun l => SY.equivFin.symm l
  have hsuppY : ∀ (ρ : ℝ) (i : Fin (m + 1)), ((1 - ρ) • T B + ρ • T (V i)).support ⊆ SY := by
    intro ρ i P hP
    rw [Finsupp.mem_support_iff] at hP
    by_contra hPS
    apply hP
    have h1 : (T B) P = 0 := by
      by_contra h; exact hPS (Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr h))
    have h2 : (T (V i)) P = 0 := by
      by_contra h
      exact hPS (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
        ⟨i, Finset.mem_univ _, Finsupp.mem_support_iff.mpr h⟩))
    simp [h1, h2]
  have hev_klt : ∀ᶠ ρ in nhdsWithin (0 : ℝ) (Set.Ioi 0), ∀ i,
      IsRealKltPair M0.sY ((1 - ρ) • T B + ρ • T (V i)) := by
    refine Filter.eventually_all.2 fun i => ?_
    haveI : AlgebraicGeometry.IsProjectiveVariety ℂ M0.sY := M0.isProjectiveVariety
    have hQP : AlgebraicGeometry.IsQuasiProjectiveVariety ℂ M0.sY :=
      IsProjectiveVariety.isQuasiProjectiveVariety ℂ M0.sY
    set x : Fin SY.card → ℝ := fun l => (T B).coeff (pY l)
    have hTBsupp : (T B).support ⊆ SY := by
      have := hsuppY 0 i
      simpa using this
    have hx : IsRealKltPair M0.sY (∑ l, Finsupp.single (pY l) (x l)) := by
      rw [← eq_sum_single_coeff SY hTBsupp]; exact hkltY0
    have hev := (eventually_isRealKltPair_and_isRealTerminalPair M0.sY hQP M0.isQFactorial pY
      x).1 hx
    set y : ℝ → Fin SY.card → ℝ := fun ρ l => ((1 - ρ) • T B + ρ • T (V i)).coeff (pY l)
    have hy : Filter.Tendsto y (nhdsWithin 0 (Set.Ioi 0)) (nhdsWithin x (Set.Ici 0)) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, ?_⟩
      · have hc : Continuous y := by
          refine continuous_pi fun l => ?_
          simp only [y, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
          fun_prop
        have h0 : y 0 = x := by
          funext l
          simp [y, x]
        have h1 := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))
        rwa [h0] at h1
      · filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with ρ hρ
        intro l
        simp only [y, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
        exact add_nonneg (mul_nonneg (by linarith [hρ.2]) (coeff_transformDivisor_nonneg M0.φ hB0 _))
          (mul_nonneg hρ.1.le (coeff_transformDivisor_nonneg M0.φ (hV0 i) _))
    filter_upwards [hy.eventually hev] with ρ hρ
    rw [eq_sum_single_coeff SY (hsuppY ρ i)]
    exact hρ
  obtain ⟨ρ, ⟨hρpos, hρklt⟩, hρ1⟩ : ∃ ρ : ℝ, (( ∀ P' ∈ Spos, 0 < (G0 - G0').coeff P' →
      ∀ i, 0 < (1 - ρ) * (G0 - G0').coeff P' + ρ * (GV i - GV' i).coeff P') ∧
      ∀ i, IsRealKltPair M0.sY ((1 - ρ) • T B + ρ • T (V i))) ∧ ρ ∈ Set.Ioc (0 : ℝ) 1 :=
    (((hev_pos.filter_mono nhdsWithin_le_nhds).and hev_klt).and
      (Ioc_mem_nhdsGT zero_lt_one)).exists
  -- the vertices `qᵢ = (1 - ρ) B + ρ Vᵢ`
  set a : Fin (m + 1) → Fin (m + 1) → ℝ := fun i => (1 - ρ) • w₀ + ρ • Pi.single i 1 with ha_def
  have ha : ∀ i, a i ∈ stdSimplex ℝ (Fin (m + 1)) := fun i =>
    (convex_stdSimplex ℝ _) hw₀ (single_mem_stdSimplex ℝ i) (by linarith [hρ1.2]) hρ1.1.le
      (by ring)
  set q : Fin (m + 1) → RDivisor X := fun i => wsum V (a i) with hq_def
  have hq : ∀ i, q i = (1 - ρ) • B + ρ • V i := fun i => by
    rw [hBdef]
    simp only [hq_def, ha_def, wsum, Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_smul,
      Finset.sum_add_distrib, mul_smul, ← Finset.smul_sum, Pi.single_apply]
    simp
  have hq0 : ∀ i P, 0 ≤ (q i).coeff P := fun i => coeff_wsum_nonneg hV0 (ha i)
  have hqklt : ∀ i, IsRealKltPair sX (q i) := fun i =>
    isRealKltPair_wsum hS.isQFactorial hVklt (ha i)
  have hwq : ∀ w : Fin (m + 1) → ℝ, ∑ i, w i = 1 →
      wsum q w = (1 - ρ) • B + ρ • wsum V w := by
    intro w hw1
    have e1 : ∑ i, (w i * (1 - ρ)) • B = (1 - ρ) • B := by
      rw [← Finset.sum_smul, ← Finset.sum_mul, hw1, one_mul]
    have e2 : ∑ i, (w i * ρ) • V i = ρ • ∑ i, w i • V i := by
      rw [Finset.smul_sum]
      exact Finset.sum_congr rfl fun i _ => by rw [smul_smul, mul_comm]
    simp only [wsum, hq, smul_add, smul_smul, Finset.sum_add_distrib, e1, e2]
  -- positivity on the resolution of `M₀` for every `∑ wᵢ qᵢ`
  have hposq : ∀ w ∈ stdSimplex ℝ (Fin (m + 1)), ∀ G G' : RDivisor M0.W,
      IsRCartierPullback M0.p (logCanonicalDivisor KX (wsum q w)) G →
      IsRCartierPullback M0.q (logCanonicalDivisor M0.KY (T (wsum q w))) G' →
      ∀ P : MMP.Mori.PrimeDivisor X, MMP.Mori.RationalMap.IsExceptional M0.φ P →
        ∀ P' : MMP.Mori.PrimeDivisor M0.W,
          MMP.Mori.RationalMap.transformPrimeDivisor M0.h P = some P' →
            0 < (G - G').coeff P' := by
    intro w hw G G' hG hG' P hP P' hPP'
    have hpos := hpos0 P hP P' hPP'
    have hGeq : G = (1 - ρ) • G0 + ρ • ∑ i, w i • GV i := by
      refine MMP.Flips.IsRCartierPullback.eq M0.p hG ?_
      have e : logCanonicalDivisor KX (wsum q w) = (1 - ρ) • logCanonicalDivisor KX B +
          ρ • ∑ i, w i • logCanonicalDivisor KX (V i) := by
        rw [hwq w hw.2]
        exact logCanonicalDivisor_affine KX B V hw.2 ρ
      rw [e]
      exact MMP.Fourfold.isRCartierPullback_add
        (MMP.Fourfold.isRCartierPullback_smul _ hR0.isRCartierPullback_left)
        (MMP.Fourfold.isRCartierPullback_smul _ (MMP.Fourfold.isRCartierPullback_sum _ _ _
          fun i _ => MMP.Fourfold.isRCartierPullback_smul _ (hGV i)))
    have hG'eq : G' = (1 - ρ) • G0' + ρ • ∑ i, w i • GV' i := by
      refine MMP.Flips.IsRCartierPullback.eq M0.q hG' ?_
      have e : logCanonicalDivisor M0.KY (T (wsum q w)) = (1 - ρ) • logCanonicalDivisor M0.KY (T B) +
          ρ • ∑ i, w i • logCanonicalDivisor M0.KY (T (V i)) := by
        rw [hwq w hw.2, transformDivisor_smul_add_smul, transformDivisor_wsum M0.φ V w]
        exact logCanonicalDivisor_affine M0.KY (T B) (fun i => T (V i)) hw.2 ρ
      rw [e]
      exact MMP.Fourfold.isRCartierPullback_add
        (MMP.Fourfold.isRCartierPullback_smul _ hR0.isRCartierPullback_right)
        (MMP.Fourfold.isRCartierPullback_smul _ (MMP.Fourfold.isRCartierPullback_sum _ _ _
          fun i _ => MMP.Fourfold.isRCartierPullback_smul _ (hGV' i)))
    rw [hGeq, hG'eq, coeff_affine_sub]
    have hP'S : P' ∈ Spos := Finsupp.mem_support_iff.mpr hpos.ne'
    have hsplit : (1 - ρ) * (G0 - G0').coeff P' + ρ * ∑ i, w i * (GV i - GV' i).coeff P' =
        ∑ i, w i * ((1 - ρ) * (G0 - G0').coeff P' + ρ * (GV i - GV' i).coeff P') := by
      rw [Finset.mul_sum]
      simp only [mul_add, Finset.sum_add_distrib, ← Finset.sum_mul, hw.2, one_mul]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hsplit]
    obtain ⟨i₀, hi₀⟩ := exists_pos_of_mem_stdSimplex hw
    exact Finset.sum_pos' (fun i _ => mul_nonneg (hw.1 i) (hρpos P' hP'S hpos i).le)
      ⟨i₀, Finset.mem_univ _, mul_pos hi₀ (hρpos P' hP'S hpos i₀)⟩
  -- pieces on `Y₀` near `w₀`, transferred to `X`
  have hU0 : ∀ i P, 0 ≤ (T (q i)).coeff P := fun i => coeff_transformDivisor_nonneg M0.φ (hq0 i)
  have hUklt : ∀ i, IsRealKltPair M0.sY (T (q i)) := fun i => by
    rw [hq i, transformDivisor_smul_add_smul]
    exact hρklt i
  have hqw0 : wsum q w₀ = B := by
    rw [hwq w₀ hw₀.2, ← hBdef, ← add_smul]
    simp
  obtain ⟨U', hU', hYpieces⟩ := exists_nhds_hasPieces_of_isRelativelyNef hm hS0
    (fun i => T (q i)) hU0 hUklt w₀ hw₀ (by
      rw [← transformDivisor_wsum, hqw0]
      exact hmodel0.isRelativelyNef)
  have hXq := HasPieces.transfer hS M0 hR0 hq0 hqklt hposq hYpieces
  have hXV := HasPieces.reweight a ha hXq
  -- the neighbourhood of `w₀`
  have hρ := hρ1.1
  have hcont : Continuous fun w : Fin (m + 1) → ℝ => w₀ + ρ⁻¹ • (w - w₀) := by fun_prop
  have h1 : ∀ᶠ w in nhds w₀, w₀ + ρ⁻¹ • (w - w₀) ∈ U' :=
    hcont.continuousAt.preimage_mem_nhds (by simpa using hU')
  have h2 : ∀ᶠ w in nhds w₀, ∀ i, 0 < w₀ i → -(ρ * w₀ i) < w i - w₀ i := by
    refine Filter.eventually_all.2 fun i => ?_
    by_cases hi : 0 < w₀ i
    · have hc : Continuous fun w : Fin (m + 1) → ℝ => w i - w₀ i := by fun_prop
      have h3 : ∀ᶠ w in nhds w₀, -(ρ * w₀ i) < w i - w₀ i :=
        (hc.tendsto w₀).eventually (lt_mem_nhds (show -(ρ * w₀ i) < w₀ i - w₀ i by
          rw [sub_self, neg_lt_zero]; positivity))
      exact h3.mono fun w hw _ => hw
    · exact Filter.Eventually.of_forall fun w h => absurd h hi
  refine ⟨_, h1.and h2, ((hasPieces_singleton hw₀ hvalid0).union hXV).mono ?_⟩
  rintro w ⟨hwΔ, hw1, hw2⟩
  by_cases hww : w = w₀
  · exact Or.inl hww
  right
  have hw'sum : ∑ i, (w₀ + ρ⁻¹ • (w - w₀)) i = 1 := by
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, Finset.sum_add_distrib,
      ← Finset.mul_sum, Finset.sum_sub_distrib, hwΔ.2, hw₀.2, sub_self, mul_zero, add_zero]
  refine ⟨w₀ + ρ⁻¹ • (w - w₀), ⟨⟨⟨fun i => ?_, hw'sum⟩, hw1⟩, ?_⟩, ?_⟩
  · simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    by_cases hi : 0 < w₀ i
    · have key : -(w₀ i) < (w i - w₀ i) / ρ := (lt_div_iff₀ hρ).mpr (by nlinarith [hw2 i hi])
      rw [← div_eq_inv_mul]
      linarith
    · have h0 : w₀ i = 0 := le_antisymm (not_lt.mp hi) (hw₀.1 i)
      rw [h0, zero_add, sub_zero]
      exact mul_nonneg (inv_nonneg.mpr hρ.le) (hwΔ.1 i)
  · intro h
    apply hww
    have h' : ρ⁻¹ • (w - w₀) = 0 := by
      have := Set.mem_singleton_iff.mp h
      simpa using this
    rcases smul_eq_zero.mp h' with h'' | h''
    · exact absurd h'' (inv_ne_zero hρ.ne')
    · exact sub_eq_zero.mp h''
  · funext x
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, a]
    have hterm : ∀ i, (w₀ + ρ⁻¹ • (w - w₀)) i *
        (((1 - ρ) • w₀ + ρ • (Pi.single i (1 : ℝ) : Fin (m + 1) → ℝ)) x) =
        (1 - ρ) * w₀ x * (w₀ + ρ⁻¹ • (w - w₀)) i +
          ρ * (if x = i then (w₀ + ρ⁻¹ • (w - w₀)) i else 0) := by
      intro i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl fun i _ => hterm i, Finset.sum_add_distrib, ← Finset.mul_sum,
      ← Finset.mul_sum, Finset.sum_ite_eq, if_pos (Finset.mem_univ _), hw'sum]
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    field_simp
    ring

private theorem claim_succ {m : ℕ} (hm : Claim m) : Claim (m + 1) := by
  intro X Z _ _ _ _ sX _ sZ π KX hS V hV0 hVklt
  choose! U hU hUP using fun w (hw : w ∈ stdSimplex ℝ (Fin (m + 1))) =>
    exists_nhds_hasPieces hm hS V hV0 hVklt w hw
  obtain ⟨t, hcov⟩ := (isCompact_stdSimplex ℝ (Fin (m + 1))).elim_nhds_subcover'
    (fun w _ => U w) (fun w hw => hU w hw)
  refine (hasPieces_biUnion t (fun w => stdSimplex ℝ (Fin (m + 1)) ∩ U w.1)
    fun w _ => hUP w.1 w.2).mono fun w hw => ?_
  obtain ⟨⟨w', hw'⟩, hwt, hwU⟩ := Set.mem_iUnion₂.mp (hcov hw)
  exact Set.mem_iUnion₂.mpr ⟨⟨w', hw'⟩, hwt, hw, hwU⟩

private theorem claim (n : ℕ) : Claim n := by
  induction n with
  | zero => exact claim_zero
  | succ m ih => exact claim_succ ih

end Induction

/-! ### The theorem -/

/-- A klt pair with rational boundary is a klt pair with real boundary. -/
private theorem isRealKltPair_toRDivisor {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXq : IsQFactorial sX) {D : QDivisor X}
    (hD : IsKltPair sX D) : IsRealKltPair sX (QDivisor.toRDivisor D) := by
  have hXn : IsNormalVariety ℂ sX := hD.1.isPair.1
  obtain ⟨n, K, hK, -⟩ := hD.1.isPair.2
  refine ⟨hXn, fun P => ?_, ⟨n, K, hK, hXq.isRCartier _⟩, hD.2⟩
  obtain ⟨m, hm⟩ := isLogDiscrepancy_ofPrimeDivisor hXn hD.1.isPair P
  have := hD.2 _ _ _ hm
  rw [QDivisor.coeff_toRDivisor]
  linarith

private theorem solution :
    ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} (V : Finset (QDivisor X))
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (hπ : π ≫ sZ = sX) (hπp : IsProjectiveMorphism π)
    (hπb : IsBirationalMorphism π) (hdim : topologicalKrullDim X = 4) (hXq : IsQFactorial sX)
    (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hV : ∀ D ∈ V, ∀ P, 0 ≤ D.coeff P) (hVklt : ∀ D ∈ V, IsKltPair sX D),
    ∃ (n : ℕ) (Y : Fin n → Scheme.{0}) (_ : ∀ j, IsIntegral (Y j)) (_ : ∀ j, CompactSpace (Y j))
      (_ : ∀ j, IsLocallyNoetherian (Y j)) (_ : ∀ j, IsNormal (Y j))
      (sY : ∀ j, Y j ⟶ Spec (.of ℂ)) (πY : ∀ j, Y j ⟶ Z) (KY : ∀ j, Divisor (Y j))
      (φ : ∀ j, X.RationalMap (Y j)),
      (∀ j, MMP.Mori.IsProjectiveVariety ℂ (sY j) ∧ IsNormalVariety ℂ (sY j) ∧
        IsQFactorial (sY j) ∧ πY j ≫ sZ = sY j ∧ MMP.Mori.RationalMap.IsBirational (φ j) ∧
        MMP.Flips.RationalMap.IsOver π (πY j) (φ j) ∧
        ∀ F : MMP.Mori.PrimeDivisor (Y j), ¬ MMP.Flips.RationalMap.IsInverseExceptional (φ j) F) ∧
      ∀ B ∈ convexHull ℝ (QDivisor.toRDivisor '' (V : Set (QDivisor X))), ∃ j,
        IsRealLogMinimalModel sX (sY j) sZ π (πY j) KX B (KY j)
          (MMP.Mori.RationalMap.transformDivisor (φ j) B) (φ j) ∧
        IsRealKltPair (sY j) (MMP.Mori.RationalMap.transformDivisor (φ j) B) := by
  intro X Z _ _ _ _ sX _ sZ π KX V hX hZ hZn hπ hπp hπb hdim hXq hKX hV hVklt
  classical
  have hS : IsSetting sX sZ π KX := ⟨hX, hZ, hZn, hπ, hπp, hπb, hdim, hXq, hKX⟩
  set e := V.equivFin.symm
  set Vf : Fin V.card → RDivisor X := fun i => QDivisor.toRDivisor (e i : QDivisor X)
  have hVf0 : ∀ i P, 0 ≤ (Vf i).coeff P := fun i P => by
    simp only [Vf, QDivisor.coeff_toRDivisor]
    exact_mod_cast hV _ (e i).2 P
  have hVfklt : ∀ i, IsRealKltPair sX (Vf i) := fun i =>
    isRealKltPair_toRDivisor hXq (hVklt _ (e i).2)
  obtain ⟨ι, hι, P, hP⟩ := claim V.card hS Vf hVf0 hVfklt
  have : Fintype ι := Fintype.ofFinite ι
  set N := Fintype.card ι
  set f := (Fintype.equivFin ι).symm
  refine ⟨N, fun j => (P (f j)).model.Y, fun j => inferInstance, fun j => inferInstance,
    fun j => inferInstance, fun j => inferInstance, fun j => (P (f j)).model.sY,
    fun j => (P (f j)).model.πY, fun j => (P (f j)).model.KY, fun j => (P (f j)).model.φ,
    fun j => ⟨(P (f j)).model.isProjectiveVariety, (P (f j)).model.isNormalVariety,
      (P (f j)).model.isQFactorial, (P (f j)).model.comp_eq, (P (f j)).model.isBirational,
      (P (f j)).model.isOver, (P (f j)).model.not_isInverseExceptional⟩, fun B hB => ?_⟩
  -- `B = ∑ wᵢ Vᵢ` for a weight `w`
  obtain ⟨w, hw, rfl⟩ : ∃ w ∈ stdSimplex ℝ (Fin V.card), wsum Vf w = B := by
    have hrange : QDivisor.toRDivisor '' (V : Set (QDivisor X)) = Set.range Vf := by
      ext D
      constructor
      · rintro ⟨E, hE, rfl⟩
        exact ⟨V.equivFin ⟨E, hE⟩, by simp [Vf, e]⟩
      · rintro ⟨i, rfl⟩
        exact ⟨_, (e i).2, rfl⟩
    rw [hrange, convexHull_range_eq_exists_affineCombination] at hB
    obtain ⟨s, w, hw0, hw1, rfl⟩ := hB
    refine ⟨fun i => if i ∈ s then w i else 0, ⟨fun i => ?_, ?_⟩, ?_⟩
    · dsimp only
      split_ifs with h
      exacts [hw0 i h, le_rfl]
    · rw [Finset.sum_ite_mem, Finset.univ_inter, hw1]
    · rw [Finset.affineCombination_eq_linear_combination _ _ _ hw1, wsum]
      simp only [ite_smul, zero_smul]
      rw [Finset.sum_ite_mem, Finset.univ_inter]
  obtain ⟨i, β, hβ, hβF, rfl⟩ := hP w hw
  obtain ⟨j, rfl⟩ : ∃ j, f j = i := f.surjective i
  obtain ⟨hmodel, hklt, -⟩ := (P (f j)).valid β hβ hβF
  exact ⟨j, hmodel, hklt⟩

end Proof_thm_fourfold_birational_fourfold_geography

end

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **Finite geography of real klt fourfold models over a birational base.** Let
`π : X ⟶ Z` be a projective birational morphism of normal projective complex varieties, with `X`
a `ℚ`-factorial fourfold and `K_X` a canonical divisor. Let `V` be a finite set of effective
`ℚ`-divisors on `X` with every `(X, V)` klt. There are finitely many birational maps
`φ j : X ⤏ Y j` over `Z`, extracting no prime divisor, to normal projective `ℚ`-factorial
varieties, such that for every `B` in the convex hull of `V` some `Y j`, with the strict
transform `φ_j_* B`, is a klt log minimal model of `(X/Z, B)`. -/
@[mmp "thm_fourfold_birational_fourfold_geography"]
public theorem exists_finite_isRealLogMinimalModel_of_mem_convexHull
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} (V : Finset (QDivisor X))
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (hπ : π ≫ sZ = sX) (hπp : IsProjectiveMorphism π)
    (hπb : IsBirationalMorphism π) (hdim : topologicalKrullDim X = 4) (hXq : IsQFactorial sX)
    (hKX : ∃ m : ℕ, KX.IsCanonicalDivisor sX m)
    (hV : ∀ D ∈ V, ∀ P, 0 ≤ D.coeff P) (hVklt : ∀ D ∈ V, IsKltPair sX D) :
    ∃ (n : ℕ) (Y : Fin n → Scheme.{0}) (_ : ∀ j, IsIntegral (Y j)) (_ : ∀ j, CompactSpace (Y j))
      (_ : ∀ j, IsLocallyNoetherian (Y j)) (_ : ∀ j, IsNormal (Y j))
      (sY : ∀ j, Y j ⟶ Spec (.of ℂ)) (πY : ∀ j, Y j ⟶ Z) (KY : ∀ j, Divisor (Y j))
      (φ : ∀ j, X.RationalMap (Y j)),
      (∀ j, MMP.Mori.IsProjectiveVariety ℂ (sY j) ∧ IsNormalVariety ℂ (sY j) ∧
        IsQFactorial (sY j) ∧ πY j ≫ sZ = sY j ∧ MMP.Mori.RationalMap.IsBirational (φ j) ∧
        MMP.Flips.RationalMap.IsOver π (πY j) (φ j) ∧
        ∀ F : MMP.Mori.PrimeDivisor (Y j), ¬ MMP.Flips.RationalMap.IsInverseExceptional (φ j) F) ∧
      ∀ B ∈ convexHull ℝ (QDivisor.toRDivisor '' (V : Set (QDivisor X))), ∃ j,
        IsRealLogMinimalModel sX (sY j) sZ π (πY j) KX B (KY j)
          (MMP.Mori.RationalMap.transformDivisor (φ j) B) (φ j) ∧
        IsRealKltPair (sY j) (MMP.Mori.RationalMap.transformDivisor (φ j) B) :=
          by revert X Z sX sZ π KX V hX hZ hZn hπ hπp hπb hdim hXq hKX hV hVklt; first | exact Proof_thm_fourfold_birational_fourfold_geography.solution | exact Proof_thm_fourfold_birational_fourfold_geography.solution _ | exact Proof_thm_fourfold_birational_fourfold_geography.solution _ _ | exact Proof_thm_fourfold_birational_fourfold_geography.solution _ _ _ | exact Proof_thm_fourfold_birational_fourfold_geography.solution _ _ _ _

end MMP.Fourfold

