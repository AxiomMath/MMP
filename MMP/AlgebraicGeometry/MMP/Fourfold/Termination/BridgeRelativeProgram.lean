/-- A klt pair with rational boundary is dlt. -/
private theorem isDltPair_of_isKltPair {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X} (hB : MMP.Fourfold.IsKltPair sX B) :
    MMP.Intersection.IsDltPair sX B := by
  obtain ⟨-, n, K, hK, -⟩ := hB.1.isPair
  have hM := (MMP.Fourfold.isKltPair_iff_mori_isKltPair sX hK hB.1).mp hB
  exact (MMP.Threefold.Bridges.isDltPair_iff_isDltPair sX hK B).mpr
    (MMP.Threefold.Mori.IsKltPair.isDltPair hM fun P => hB.1.nonneg P).1

/-- The identity of a normal variety is small. -/
private theorem isSmallMorphism_id {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) : IsSmallMorphism sX sX (𝟙 X) := by
  refine ⟨hX, hX, Category.id_comp _, inferInstance, isBirationalMorphism_of_isIso _, ?_⟩
  rw [le_closedsCodimension_iff]
  intro W hW
  exfalso
  obtain ⟨x, hx⟩ := W.isIrreducible.nonempty
  have hx' := hW hx
  rw [SetLike.mem_coe, mem_exceptionalSet] at hx'
  exact hx' (le_biregularLocus ((isBiregular_top_iff _).mpr inferInstance) trivial)

/-- Every `ℚ`-Cartier `ℚ`-divisor has a multiple which is ample relative to an isomorphism. -/
private theorem hasRelativelyAmpleMultiple_of_isIso {X Y : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (e : X ⟶ Y) [IsIso e] {D : QDivisor X}
    (hD : D.IsQCartier) : D.HasRelativelyAmpleMultiple e := by
  obtain ⟨m, hm, L, hL, hLc⟩ := hD.exists_pos
  refine ⟨m, hm, L, hLc, hL, ?_⟩
  haveI := hLc.isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
  refine ⟨V, hV, hyV, ?_⟩
  haveI : IsAffine (e ⁻¹ᵁ V) := hV.preimage e
  have hinv : Stacks.Ample.IsInvertibleModule (e ⁻¹ᵁ V).toScheme
      ((RingedSpaceModuleAdjunction.modulePullback (e ⁻¹ᵁ V).ι.toLRSHom.toShHom).obj
        L.divisorialSheaf) := inferInstance
  exact (Stacks.AmpleBridge.isAmple_iff_isAmple _ _).mpr
    (@AlgebraicGeometry.Scheme.Modules.isAmple_of_isAffine_of_isInvertible _ _ _ _ hinv)

/-- A morphism from a projective variety to a separated scheme over `ℂ` is projective. -/
private theorem isProjectiveMorphism_of_comp_eq {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} [IsSeparated sY] {f : X ⟶ Y} (hf : f ≫ sY = sX)
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) : IsProjectiveMorphism f :=
  IsProjectiveMorphism.of_comp f sY (hf ▸ hX.isProjective)

section Numerical

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- If `ρ(X/W) = 1`, some proper curve is contracted by `f`. -/
private theorem exists_isContractedBy_of_relativePicardNumber_eq_one' {W : Scheme.{0}}
    (f : X ⟶ W) (hρ : MMP.Flips.relativePicardNumber sX f = 1) :
    ∃ C : ProperCurve sX, C.IsContractedBy f := by
  have hfin : Module.finrank ℝ (MMP.Flips.RelativeNumericalDivisorClasses sX f) = 1 :=
    Module.finrank_eq_of_rank_eq (by rw [Cardinal.toENat_eq_one.mp hρ]; rfl)
  haveI := Module.finite_of_finrank_eq_succ hfin
  obtain ⟨v, hv⟩ :=
    (Module.finrank_pos_iff_exists_ne_zero (R := ℝ)).mp (by rw [hfin]; exact one_pos)
  obtain ⟨δ, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  rw [Ne, Submodule.Quotient.mk_eq_zero, mem_relativeNumericallyTrivialDivisors] at hv
  push Not at hv
  obtain ⟨C, hC, -⟩ := hv
  exact ⟨C, hC⟩

/-- A divisor whose negative is `f`-ample has negative intersection number, computed with any
presentation, on every proper curve contracted by `f`. -/
private theorem isRIntersectionNumber_neg_of_isRelativelyAntiAmple {W : Scheme.{0}}
    (f : X ⟶ W) {L : RDivisor X} (hL : IsRelativelyAntiAmple f L) (Γ : ProperCurve sX)
    (hΓ : Γ.IsContractedBy f) {m : ℕ} (r : Fin m → ℝ) (Ls : Fin m → Divisor X) (x : ℝ)
    (hx : IsRIntersectionNumber k sX L r Ls Γ x) : x < 0 := by
  obtain ⟨m', a, A, hm, ha, hA, hLeq⟩ := hL
  have hAc : ∀ j, (A j).IsCartier := fun j => (hA j).1
  have hLeq' : L = ∑ j, (-a j) • Divisor.toRDivisor (A j) := by
    have hL' : L = -(-L) := (neg_neg L).symm
    rw [hL', hLeq]
    simp [neg_smul, Finset.sum_neg_distrib]
  have hy := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX Γ (fun j => -a j) A hAc
  rw [← hLeq'] at hy
  rw [(IsRIntersectionNumber.eq_and_linear k sX Γ).1 _ _ _ _ _ _ _ hx hy]
  have hpos : ∀ j, (0 : ℝ) < (A j).degreeOn k sX Γ.ι Γ.dim_le (hAc j) := fun j => by
    exact_mod_cast degreeOn_pos_of_isRelativelyAmpleCartier f (hA j) (hAc j) Γ hΓ
  have hsum : 0 < ∑ j, a j * ((A j).degreeOn k sX Γ.ι Γ.dim_le (hAc j) : ℝ) :=
    Finset.sum_pos (fun j _ => mul_pos (ha j) (hpos j)) ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  simp only [neg_mul, Finset.sum_neg_distrib]
  linarith

end Numerical

/-- The rational map of a morphism, composed with a morphism. -/
private theorem toRationalMap_compHom {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    f.toRationalMap.compHom g = (f ≫ g).toRationalMap := by
  rw [Scheme.Hom.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.Hom.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨⊤, dense_univ, le_rfl, le_rfl, ?_⟩
  simp [Scheme.PartialMap.restrict, Scheme.PartialMap.compHom, Scheme.Hom.toPartialMap]

/-- The birational transform of divisors commutes with regarding a divisor as an
`ℝ`-divisor. -/
private theorem transformDivisor_toRDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (D : Divisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (Divisor.toRDivisor D) =
      Divisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor φ D) := by
  classical
  have hs : ∀ {Z : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor Z) (r : ℤ),
      Divisor.toRDivisor (Finsupp.single Q r) = Finsupp.single Q (r : ℝ) :=
    fun Q r => Finsupp.mapRange_single (hf := map_zero (Int.castAddHom ℝ))
  induction D using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add D D' h h' => simp only [map_add, h, h']
  | single P r =>
    rw [hs, MMP.Mori.RationalMap.transformDivisor_single,
      MMP.Mori.RationalMap.transformDivisor_single]
    rcases MMP.Mori.RationalMap.transformPrimeDivisor φ P with _ | Q
    · simp
    · simp [hs]

/-- The birational transform of `ℝ`-divisors is `ℝ`-linear. -/
private theorem transformDivisor_smul {X Y : Scheme.{0}} (φ : X.RationalMap Y) (c : ℝ)
    (D : RDivisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (c • D) =
      c • MMP.Mori.RationalMap.transformDivisor φ D := by
  exact (MMP.Mori.RationalMap.transformDivisorₗ ℝ φ).map_smul c D

/-- The transform of `K + D` is `φ_* K + φ_* D`. -/
private theorem transformDivisor_logCanonicalDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (K : Divisor X) (D : RDivisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (logCanonicalDivisor K D) =
      logCanonicalDivisor (MMP.Mori.RationalMap.transformDivisor φ K)
        (MMP.Mori.RationalMap.transformDivisor φ D) := by
  rw [logCanonicalDivisor, map_add, transformDivisor_toRDivisor, logCanonicalDivisor]

/-- On a `ℚ`-factorial variety every `ℝ`-divisor is an `ℝ`-linear combination of Cartier
divisors. -/
private theorem isCartierCombination_of_isQFactorial {k : Type} [Field k] {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}
    (hX : IsQFactorial sX) (D : RDivisor X) : IsCartierCombination D := by
  obtain ⟨m, r, L, hL, hD⟩ := MMP.Fourfold.IsQFactorial.isRCartier hX D
  refine ⟨m, r, L, hL, Finsupp.ext fun P => ?_⟩
  rw [Finset.sum_apply']
  refine (hD P).trans (Finset.sum_congr rfl fun j _ => ?_)
  simp [DivisorWithCoeffs.mapCoeffs, DivisorWithCoeffs.coeff]

/-- Every intersection number of the zero divisor vanishes. -/
private theorem eq_zero_of_isRIntersectionNumber_zero {k : Type} [Field k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]
    (C : ProperCurve sX) {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber k sX 0 r L C x) : x = 0 := by
  have h0 := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C (fun _ : Fin 0 => (0 : ℝ))
    (fun _ => 0) (fun i => i.elim0)
  simp only [Finset.univ_eq_empty, Finset.sum_empty] at h0
  exact (IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h0

/-- A divisor supported on a finite set `s` is the sum of its coefficients along `s`. -/
private theorem eq_sum_single_of_support_subset {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {Θ : RDivisor X} {s : Finset (MMP.Mori.PrimeDivisor X)}
    (hs : Θ.support ⊆ s) :
    Θ = ∑ j : s, Finsupp.single j.1 (Θ.coeff j.1) := by
  classical
  refine Finsupp.ext fun W => ?_
  have h := MMP.Fourfold.coeff_sum_single (fun j : s => j.1) (fun j => Θ.coeff j.1) W
  rw [DivisorWithCoeffs.coeff_apply] at h
  rw [h]
  by_cases hW : W ∈ s
  · rw [Fintype.sum_eq_single ⟨W, hW⟩ (fun j hj => if_neg fun h' => hj (Subtype.ext h')),
      if_pos rfl]
    rfl
  · rw [Finset.sum_eq_zero fun (j : s) _ => if_neg fun (h' : j.1 = W) => hW (h' ▸ j.2)]
    by_contra h0
    exact hW (hs (Finsupp.mem_support_iff.mpr h0))

/-- The transform of an effective divisor is effective. -/
private theorem transformDivisor_nonneg {X₁ X₂ : Scheme.{0}} (φ' : X₁.RationalMap X₂)
    {D : RDivisor X₁} (hD : ∀ P, 0 ≤ D.coeff P) (Q : MMP.Mori.PrimeDivisor X₂) :
    0 ≤ (MMP.Mori.RationalMap.transformDivisor φ' D).coeff Q := by
  classical
  revert hD
  induction D using Finsupp.induction with
  | zero => intro _; simp
  | single_add a b D ha hb ih =>
    intro hD
    have hDa : D a = 0 := Finsupp.notMem_support_iff.mp ha
    have hD' : ∀ P, 0 ≤ DivisorWithCoeffs.coeff D P := fun P => by
      by_cases hP : P = a
      · subst hP; change 0 ≤ D P; rw [hDa]
      · have := hD P
        change 0 ≤ (Finsupp.single a b + D) P at this
        rw [Finsupp.add_apply, Finsupp.single_apply, if_neg (Ne.symm hP), zero_add] at this
        exact this
    have hb0 : 0 ≤ b := by
      have := hD a
      change 0 ≤ (Finsupp.single a b + D) a at this
      rwa [Finsupp.add_apply, Finsupp.single_eq_same, hDa, add_zero] at this
    rw [map_add, DivisorWithCoeffs.coeff_add]
    refine add_nonneg ?_ (ih hD')
    rw [MMP.Mori.RationalMap.transformDivisor_single]
    rcases MMP.Mori.RationalMap.transformPrimeDivisor φ' a with _ | F
    · simp
    · change 0 ≤ (Finsupp.single F b) Q
      rw [Finsupp.single_apply]
      split_ifs <;> simp [hb0]

/-- An effective klt pair is dlt: take the empty open set as the snc locus. -/
private theorem isRealDltPair_of_isRealKltPair {k : Type} [Field k] {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} {B : RDivisor X}
    (hB : ∀ P, 0 ≤ B.coeff P) (h : IsRealKltPair sX B) : IsRealDltPair sX B := by
  have hempty : IsEmpty ((⊤ : TopologicalSpace.Closeds X).compl : X.Opens) :=
    ⟨fun x => x.2 (by trivial)⟩
  refine ⟨⟨h.1, hB, h.2.2.1, fun n E a ha => (h.2.2.2 n E a ha).le⟩, fun P => (h.2.1 P).le, ⊤,
    ?_, ?_, fun n D _ a ha => h.2.2.2 n D a ha⟩
  · refine TopologicalSpace.Opens.ext (Set.eq_univ_of_forall fun x => ?_)
    exact isEmptyElim (α := ((⊤ : TopologicalSpace.Closeds X).compl : X.Opens)) x
  · refine ⟨fun E _ => ?_, fun x => ?_⟩
    · exact isEmptyElim (α := ((⊤ : TopologicalSpace.Closeds X).compl : X.Opens))
        (AlgebraicGeometry.PrimeDivisor.genericPoint E)
    · exact isEmptyElim (α := ((⊤ : TopologicalSpace.Closeds X).compl : X.Opens)) x

/-- **Log canonical pairs on a `ℚ`-factorial variety are convex**. -/
private theorem isRealLcPair_segment {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hQ : IsQFactorial sX)
    {Θ₀ Θ₁ : RDivisor X} (h₀ : IsRealLcPair sX Θ₀) (h₁ : IsRealLcPair sX Θ₁) {s : ℝ}
    (hs0 : 0 ≤ s) (hs1 : s ≤ 1) : IsRealLcPair sX ((1 - s) • Θ₀ + s • Θ₁) := by
  classical
  set t := Θ₀.support ∪ Θ₁.support
  let p : t → MMP.Mori.PrimeDivisor X := Subtype.val
  have e₀ := eq_sum_single_of_support_subset (Θ := Θ₀) (s := t) Finset.subset_union_left
  have e₁ := eq_sum_single_of_support_subset (Θ := Θ₁) (s := t) Finset.subset_union_right
  have hΘ : (1 - s) • Θ₀ + s • Θ₁ = ∑ j : t, Finsupp.single (p j)
      ((1 - s) * Θ₀.coeff j.1 + s * Θ₁.coeff j.1) := by
    conv_lhs => rw [e₀, e₁]
    simp only [Finset.smul_sum, Finsupp.smul_single, smul_eq_mul, ← Finset.sum_add_distrib,
      ← Finsupp.single_add]
    rfl
  choose m hm hmc using fun j : t => hQ.2 (Finsupp.single (p j) (1 : ℤ))
  obtain ⟨n, K, hK, -⟩ := h₀.2.2.1
  refine ⟨h₀.1, fun P => ?_, ⟨n, K, hK, ?_⟩, fun n' D a ha => ?_⟩
  · rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul,
      smul_eq_mul, smul_eq_mul]
    have := h₀.2.1 P
    have := h₁.2.1 P
    have := sub_nonneg.2 hs1
    positivity
  · rw [hΘ]
    exact MMP.Fourfold.isRCartier_add_sum_single hQ K p _
  · by_contra hneg
    push Not at hneg
    have hconv := MMP.Fourfold.convex_setOf_lt_isLogDiscrepancy (k := ℂ) (sX := sX) p m hm hmc
      a (fun _ => True)
    have hy₀ : (fun j : t => Θ₀.coeff j.1) ∈ {y : t → ℝ | ∀ (n : ℕ) (D : DivisorOver ℂ sX)
        (a' : ℝ), True → MMP.Intersection.IsLogDiscrepancy sX n
          (∑ i, Finsupp.single (p i) (y i)) D a' → a < a'} :=
      fun n D a' _ ha' => hneg.trans_le (h₀.2.2.2 n D a' (e₀ ▸ ha'))
    have hy₁ : (fun j : t => Θ₁.coeff j.1) ∈ {y : t → ℝ | ∀ (n : ℕ) (D : DivisorOver ℂ sX)
        (a' : ℝ), True → MMP.Intersection.IsLogDiscrepancy sX n
          (∑ i, Finsupp.single (p i) (y i)) D a' → a < a'} :=
      fun n D a' _ ha' => hneg.trans_le (h₁.2.2.2 n D a' (e₁ ▸ ha'))
    have hy := hconv hy₀ hy₁ (sub_nonneg.2 hs1) hs0 (by ring)
    rw [hΘ] at ha
    have := hy n' D a trivial (by convert ha using 3)
    exact lt_irrefl a this

/-- The degree of the class of a contracted curve. -/
private theorem degree_relativeClass' {k : Type} [Field k] {X W : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {f : X ⟶ W} (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] (C : ProperCurve sX)
    (hC : C.IsContractedBy f) :
    RelativeNumericalCurveClasses.degree sX f L (C.relativeClass f hC) = C.degree k L := by
  rw [ProperCurve.relativeClass, RelativeNumericalCurveClasses.degree_relativeNumericalClass]
  exact OneCycle.degree_cycle ℝ L C

/-- **From degrees on classes to intersection numbers.** If every Cartier presentation of `D`
has linear form `φ` on the class of a contracted curve `C`, every intersection number of `D`
with `C` satisfies the same relation. -/
private theorem isRIntersectionNumber_of_degree {X W : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {f : X ⟶ W} {D :
        RDivisor X}
    (C : ProperCurve sX) (hC : C.IsContractedBy f) (P : ℝ → Prop)
    (hD : ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
      D = ∑ i, c i • Divisor.toRDivisor (M i) →
      P (∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
        RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf (C.relativeClass f hC))))
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX D r L C x) : P x := by
  obtain ⟨hL, d, hDeq, hd, rfl⟩ := hx
  have h := hD m r L hL hDeq
  have e : (∑ j, r j * (d j : ℝ)) = ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
      RelativeNumericalCurveClasses.degree sX f (L j).divisorialSheaf (C.relativeClass f hC)) := by
    refine Finset.sum_congr rfl fun j _ => ?_
    haveI := (hL j).isInvertibleModule_divisorialSheaf
    rw [degree_relativeClass', ProperCurve.degree_divisorialSheaf C (L j) (hL j),
      (hd j).eq_degreeOn]
  rw [e]
  exact h

/-- A dominant morphism of integral varieties over `k` does not raise dimension in the target:
`dim B ≤ dim A`. -/
private theorem topologicalKrullDim_le_of_isDominant {k : Type} [Field k] {A B : Scheme.{0}}
    [IsIntegral A] [IsIntegral B] {sA : A ⟶ Spec (.of k)} {sB : B ⟶ Spec (.of k)}
    [LocallyOfFiniteType sA] [LocallyOfFiniteType sB] (g : A ⟶ B) [IsDominant g]
    (hg : g ≫ sB = sA) : topologicalKrullDim B ≤ topologicalKrullDim A := by
  subst hg
  rw [MMP.Fourfold.topologicalKrullDim_eq_toNat_trdeg sB,
    MMP.Fourfold.topologicalKrullDim_eq_toNat_trdeg (g ≫ sB)]
  letI := functionFieldAlgebra sB
  letI := functionFieldAlgebra (g ≫ sB)
  letI := functionFieldMapAlgebra g
  haveI := isScalarTower_functionFieldMap sB g
  have h := trdeg_le_of_injective
    (IsScalarTower.toAlgHom k B.functionField A.functionField) (RingHom.injective _)
  haveI := essFiniteType_functionField (sX := g ≫ sB)
  have hfin : Algebra.trdeg k A.functionField < Cardinal.aleph0 :=
    trdeg_lt_aleph0 (K := k) (L := A.functionField)
  exact_mod_cast Cardinal.toNat_le_toNat h hfin

/-- If `K + B + t C` is nef over `Z` and null on a contracted curve on which `C` is positive,
then `t` is the nef threshold of `C`. -/
private theorem isLeast_of_null {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    (hXq : IsQFactorial sX) {π : X ⟶ Z} {K : Divisor X}
    {B C : RDivisor X} {t : ℝ} (ht : 0 ≤ t)
    (hnef : IsRelativelyNef ℂ sX π (logCanonicalDivisor K (B + t • C)))
    (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy π)
    (hnull : ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX (logCanonicalDivisor K (B + t • C)) r L Γ x → x = 0)
    (hpos : ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX C r L Γ x → 0 < x) :
    IsLeast {s : ℝ | 0 ≤ s ∧ IsRelativelyNef ℂ sX π (logCanonicalDivisor K (B + s • C))} t := by
  refine ⟨⟨ht, hnef⟩, fun s ⟨_, hsnef⟩ => ?_⟩
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨m, r, L, hL, hD, hnn⟩ := hsnef
  have hx := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r L hL
  rw [← hD] at hx
  have hx0 := hnn Γ hΓ _ hx
  obtain ⟨_, _, _, y, hy⟩ := MMP.Flips.exists_isRIntersectionNumber (k := ℂ)
    (isCartierCombination_of_isQFactorial hXq C) Γ
  have hy0 := hpos _ _ _ _ hy
  have hlin := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ 1 (t - s) hx hy
  have heq : (1 : ℝ) • logCanonicalDivisor K (B + s • C) + (t - s) • C =
      logCanonicalDivisor K (B + t • C) := by
    simp only [logCanonicalDivisor, one_smul, sub_smul]
    abel
  rw [heq] at hlin
  have := hnull _ _ _ _ hlin
  nlinarith

/-- A divisor which is null on every curve contracted by `f` is numerically trivial over `f`. -/
private theorem isNumericallyTrivialOver_of_null {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {f : X ⟶ W} {N : RDivisor X} (hN : IsCartierCombination N)
    (hnull : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
        IsRIntersectionNumber ℂ sX N r L Γ x → x = 0) :
    IsNumericallyTrivialOver ℂ sX f N :=
  ⟨hN, ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
    fun Γ hΓ _ _ _ _ _ _ _ _ h₁ h₂ =>
      (hnull Γ hΓ _ _ _ _ h₁).trans (eq_zero_of_isRIntersectionNumber_zero Γ h₂).symm⟩

/-- A morphism with `f_* 𝒪_X = 𝒪_Y` onto an integral scheme is dominant: a nonempty open of `Y`
missing the image of `f` would have `Γ(Y, V) ≅ Γ(X, ∅) = 0`. -/
private theorem isDominant_of_isIso_app {X Y : Scheme.{0}} [IsIntegral Y] (p : X ⟶ Y)
    (hp : ∀ U : Y.Opens, IsIso (p.app U)) : IsDominant p := by
  refine ⟨dense_iff_inter_open.mpr fun V hV ⟨y, hy⟩ => ?_⟩
  by_contra hempty
  let V' : Y.Opens := ⟨V, hV⟩
  have hbot : p ⁻¹ᵁ V' = ⊥ := TopologicalSpace.Opens.ext <| Set.eq_empty_iff_forall_notMem.mpr
    fun x hx => hempty ⟨p x, hx, x, rfl⟩
  have : Subsingleton Γ(X, p ⁻¹ᵁ V') := by rw [hbot]; infer_instance
  have : Subsingleton Γ(Y, V') := (ConcreteCategory.bijective_of_isIso (p.app V')).1.subsingleton
  have h10 := congrArg (Y.presheaf.germ V' y hy).hom (Subsingleton.elim (1 : Γ(Y, V')) 0)
  rw [map_one, map_zero] at h10
  exact one_ne_zero h10

/-- **Contractions over a birational base are birational.** If `f : X ⟶ W` is a contraction of
projective varieties and `f ≫ h = π` with `π : X ⟶ Z` birational onto a variety, then `f` is
birational and `h ≫ s_Z = s_W`. -/
private theorem isBirationalMorphism_of_isContraction {X W Z : Scheme.{0}} [IsIntegral X]
    {sX : X ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ W}
    {h : W ⟶ Z} {π : X ⟶ Z} (hc : IsContraction ℂ sW sX f) (hfh : f ≫ h = π)
    (hπ : π ≫ sZ = sX) (hπb : IsBirationalMorphism π) (hZ : MMP.Mori.IsVariety ℂ sZ) :
    IsBirationalMorphism f ∧ h ≫ sZ = sW := by
  haveI : IsIntegral W := hc.isVariety_target.toIsIntegral
  haveI : IsIntegral Z := hZ.toIsIntegral
  haveI : LocallyOfFiniteType sW := hc.isVariety_target.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sX := hc.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sZ := hZ.toLocallyOfFiniteType
  haveI : IsDominant f := isDominant_of_isIso_app f hc.isIso_app
  haveI : IsDominant π := hπb.isDominant
  haveI : IsDominant (f ≫ h) := by rw [hfh]; infer_instance
  haveI : IsDominant h := IsDominant.of_comp f h
  have hhs : h ≫ sZ = sW :=
    ext_of_isDominant f (by rw [← Category.assoc, hfh, hπ, hc.comp_eq])
  have h1 : topologicalKrullDim W ≤ topologicalKrullDim X :=
    topologicalKrullDim_le_of_isDominant f hc.comp_eq
  have h2 : topologicalKrullDim Z ≤ topologicalKrullDim W :=
    topologicalKrullDim_le_of_isDominant h hhs
  haveI : MMP.Mori.IsVariety ℂ sZ := hZ
  haveI : MMP.Mori.IsVariety ℂ sX := hc.isVariety_source
  have h3 : topologicalKrullDim Z = topologicalKrullDim X :=
    MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sZ sX hπb
  refine ⟨?_, hhs⟩
  exact (IsBirationalContraction.surjective_and_isBirational (k := ℂ)
    ⟨hc, (le_antisymm h1 (h3 ▸ h2)).symm⟩).2

/-- A birational morphism `f : X ⟶ W` is a modification of `f` into `𝟙_W`. -/
private theorem isModificationOf_id_of_isBirationalMorphism {X W : Scheme.{0}} (f : X ⟶ W)
    (hfb : IsBirationalMorphism f) : IsModificationOf f (𝟙 W) f.toRationalMap :=
  ⟨hfb, by rw [MMP.Flips.RationalMap.IsOver, toRationalMap_compHom, Category.comp_id]⟩

/-- The push-forward of a canonical divisor along a birational contraction onto a normal variety
is a canonical divisor. -/
private theorem isCanonicalDivisor_transformDivisor_of_isContraction {X W : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W]
    [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] {sX : X ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} {f : X ⟶ W} (hc : IsContraction ℂ sW sX f)
    (hXn : IsNormalVariety ℂ sX) (hWn : IsNormalVariety ℂ sW) (hfb : IsBirationalMorphism f)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) :
    Divisor.IsCanonicalDivisor sW n
      (MMP.Mori.RationalMap.transformDivisor f.toRationalMap K) := by
  haveI := hc.isProper
  haveI := hfb.isDominant
  haveI : LocallyOfFiniteType sW := hWn.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sX := hXn.1.toLocallyOfFiniteType
  haveI : MMP.Mori.IsVariety ℂ sW := hWn.1
  haveI : MMP.Mori.IsVariety ℂ sX := hXn.1
  have hdim : topologicalKrullDim W = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW sX hfb).trans hK.1
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isNormalVariety sW hWn hdim
  have hsrc : IsNormalVariety ℂ (f ≫ sW) := hc.comp_eq ▸ hXn
  haveI : LocallyOfFiniteType (f ≫ sW) := by rw [hc.comp_eq]; infer_instance
  have hK' : K.IsCanonicalDivisor (f ≫ sW) n := hc.comp_eq ▸ hK
  exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hWn hsrc hfb hK₀ hK'

/-- A step of an extremal real flip sequence is a flip `φ = (f⁺)⁻¹ ∘ f` of `f` with respect to
`K + B`, which transforms divisors as `(f⁺)⁻¹_* f_*`. -/
private theorem exists_isFlip_of_isRealFlipStep {X W X' : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}
    {sX' : X' ⟶ Spec (.of ℂ)} {f : X ⟶ W} {fp : X' ⟶ W} {K : Divisor X}
    {B : RDivisor X} (hW : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hstep : IsRealFlipStep sX sW sX' K B (flipTransform f fp K) (flipTransform f fp B) f fp)
    (hsmall : IsSmall ℂ sW sX f) :
    ∃ φ : X.RationalMap X', IsFlip ℂ sX sW sX' (logCanonicalDivisor K B) f fp φ ∧
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X),
        MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D := by
  classical
  have hneg := hstep.isNegativeExtremalContraction
  have hsm' := hstep.isSmall_flip
  obtain ⟨V, hfV, hfpV, hXV, hX'V⟩ := hstep.exists_opens_isIso
  haveI : IsProper f := hneg.isContraction.isProper
  haveI : IsProper fp := hsm'.isProper
  haveI : IsSeparated sW := hW.1.toIsSeparated
  haveI : IsSeparated (W ↘ ⊤_ Scheme) := by
    rw [show (W ↘ ⊤_ Scheme) = sW ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  haveI : IsSeparated sX' := hsm'.isVariety_source.toIsSeparated
  haveI : IsSeparated (X' ↘ ⊤_ Scheme) := by
    rw [show (X' ↘ ⊤_ Scheme) = sX' ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  obtain ⟨em, hm⟩ := hstep.isBirationalMorphism
  obtain ⟨ep, hp⟩ := hstep.isBirationalMorphism_flip
  have h1 := MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq em f (𝟙 W) hm
  have h2 := MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq ep fp (𝟙 W) hp
  simp only [Category.comp_id] at h1 h2
  set e := em.trans ep.symm
  have H : e.IsOver f fp := h1.trans h2.symm
  have hover : MMP.Flips.RationalMap.IsOver f fp e.toRationalMap := by
    rw [MMP.Flips.RationalMap.IsOver, ← Scheme.RationalMap.compHom_toRationalMap,
      Scheme.PartialMap.toRationalMap_eq_iff]
    refine ⟨e.source, e.dense_source, le_rfl, le_top, ?_⟩
    change X.homOfLE (le_rfl : e.source ≤ e.source) ≫ (e.iso.hom ≫ e.target.ι) ≫ fp =
      X.homOfLE (le_top : e.source ≤ ⊤) ≫ X.topIso.hom ≫ f
    rw [Category.assoc, H]
    simp
  have hmod : IsModificationOf f fp e.toRationalMap := ⟨⟨e, rfl⟩, hover⟩
  have hXn : IsNormalVariety ℂ (f ≫ sW) := hneg.isContraction.comp_eq ▸ hneg.isNormalVariety_source
  have htr : ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X),
      MMP.Mori.RationalMap.transformDivisor e.toRationalMap D = flipTransform f fp D :=
    fun D => MMP.Mori.transformDivisor_eq_flipTransform_of_isIso_restrict
      hneg.isNormalVariety_target hXn hstep.isBirationalMorphism V hXV hX'V hover D
  have hKB : MMP.Mori.RationalMap.transformDivisor e.toRationalMap (logCanonicalDivisor K B) =
      logCanonicalDivisor (flipTransform f fp K) (flipTransform f fp B) := by
    rw [transformDivisor_logCanonicalDivisor, htr, htr]
  have hamp := hstep.isRelativelyAmple_flip
  refine ⟨e.toRationalMap,
    { isNormalVariety_source := hneg.isNormalVariety_source
      isNormalVariety_target := hneg.isNormalVariety_target
      isNormalVariety_flip := ⟨hsm'.isVariety_source, inferInstance⟩
      isContraction := hneg.isContraction
      isCartierCombination := hneg.isCartierCombination
      isRelativelyAntiAmple := hneg.isRelativelyAntiAmple
      isProper := inferInstance
      isModificationOf := hmod
      isMorphismInCodimOne := MMP.Flips.RationalMap.isMorphismInCodimOne_of_isOver
        hneg.isNormalVariety_source f fp _ hover
      isSmall := hsm'
      isCartierCombination_transform := by
        rw [hKB]
        obtain ⟨m, r, L, -, -, hL, hD⟩ := hamp
        exact ⟨m, r, L, fun j => (hL j).1, hD⟩
      isRelativelyAmple_transform := by rw [hKB]; exact hamp
      isSmall_source := hsmall }, htr⟩

/-- **FA 6.5 for the biregular exceptional set.** For a divisorial extremal contraction the
biregular exceptional set `X ∖ φ⁻¹(V_φ)` is the prime divisor of FA 6.5: it contains the
exceptional set `Ex(φ)` of points where `φ` is not locally an open immersion, and each of its
closed points lies on a curve `C` contracted by `φ`, which meets no open set on which `φ` is an
open immersion, since `C` would be a single point there. -/
private theorem exists_primeDivisor_moriExceptionalSet_eq_support_of_not_isSmall' {k : Type}
    [Field k] {V W : Scheme.{0}} (sV : V ⟶ Spec (.of k)) (sW : W ⟶ Spec (.of k))
    [IsLocallyNoetherian V] [IsNormal V] (hV : IsQFactorial sV) (hW : IsNormalVariety k sW)
    (φ : V ⟶ W) (hφ : IsBirationalContraction k sW sV φ) (hφp : IsProjectiveMorphism φ)
    (hρ : MMP.Flips.relativePicardNumber sV φ = 1) (hs : ¬ IsSmall k sW sV φ) :
    ∃ F : MMP.Mori.PrimeDivisor V, (MMP.Mori.exceptionalSet φ : Set V) = F.support := by
  obtain ⟨F, hF⟩ := MMP.Flips.exists_primeDivisor_exceptionalSet_eq_support_of_not_isSmall sV sW
    hV hW φ hφ hφp hρ hs
  refine ⟨F, ?_⟩
  rw [← hF]
  haveI : IsIntegral V := hV.1.1.toIsIntegral
  haveI := hφ.isProper
  haveI : LocallyOfFiniteType sV := hV.1.1.toLocallyOfFiniteType
  haveI : JacobsonSpace V := LocallyOfFiniteType.jacobsonSpace sV
  have hbir := hφ.surjective_and_isBirational.2
  refine subset_antisymm ?_ fun y hy => ?_
  · rw [← closure_inter_closedPoints (MMP.Mori.exceptionalSet φ).isClosed]
    refine closure_minimal (fun x ⟨hx, hxc⟩ => ?_) (MMP.Flips.isClosed_exceptionalSet φ)
    obtain ⟨C, hCc, hCi, hCd, hxC, y, hy⟩ :=
      MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hV.1.1 hW.1 φ
        hφ.comp_eq hbir hφ.isIso_app (mem_closedPoints_iff.mp hxc) hx
    by_contra hxF
    obtain ⟨U, hxU, hU⟩ := MMP.Flips.exists_isOpenImmersion_of_notMem_exceptionalSet hxF
    have hsub : C ∩ (U : Set V) ⊆ {x} := fun z ⟨hzC, hzU⟩ => by
      have h1 : φ z ∈ φ '' C := ⟨z, hzC, rfl⟩
      have h2 : φ x ∈ φ '' C := ⟨x, hxC, rfl⟩
      rw [hy] at h1 h2
      have := (U.ι ≫ φ).isOpenEmbedding.injective (a₁ := ⟨z, hzU⟩) (a₂ := ⟨x, hxU⟩)
        (h1.trans h2.symm)
      exact congrArg Subtype.val this
    have hCx : C ⊆ {x} :=
      (subset_closure_inter_of_isPreirreducible_of_isOpen hCi.2 U.isOpen ⟨x, hxC, hxU⟩).trans
        ((closure_mono hsub).trans (mem_closedPoints_iff.mp hxc).closure_subset)
    have : Subsingleton C := Set.Subsingleton.coe_sort fun a ha b hb =>
      (hCx ha).trans (hCx hb).symm
    have : DiscreteTopology C := ⟨Subsingleton.elim _ _⟩
    exact absurd (hCd ▸ topologicalKrullDim_zero_of_discreteTopology C) (by decide)
  · by_contra hyM
    apply hy
    have : IsIso (φ ∣_ biregularLocus φ) := MMP.Mori.isBiregular_biregularLocus φ
    refine ⟨φ ⁻¹ᵁ biregularLocus φ, ?_, ?_⟩
    · by_contra h
      exact hyM (MMP.Mori.mem_exceptionalSet.mpr h)
    · rw [← morphismRestrict_ι]
      infer_instance

section Divisors

variable {X Y : Scheme.{0}}

/-- Pushing prime divisors forward commutes with changing coefficients. -/
private theorem mapPrimeDivisors_mapCoeffsAddMonoidHom' {R S : Type*} [AddCommGroup R]
    [AddCommGroup S] (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y))
    (g : R →+ S) (D : DivisorWithCoeffs R X) :
    DivisorWithCoeffs.mapPrimeDivisors φ (DivisorWithCoeffs.mapCoeffsAddMonoidHom g D) =
      DivisorWithCoeffs.mapCoeffsAddMonoidHom g (DivisorWithCoeffs.mapPrimeDivisors φ D) := by
  induction D using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add a b ha hb => simp only [map_add, ha, hb]
  | single E r =>
    simp only [DivisorWithCoeffs.mapCoeffsAddMonoidHom, Finsupp.mapRange.addMonoidHom_apply,
      Finsupp.mapRange_single, DivisorWithCoeffs.mapPrimeDivisors_single]
    cases φ E <;> simp [Finsupp.mapRange_single]

/-- The strict transform `(f⁺)⁻¹_* f_*` commutes with changing coefficients. -/
private theorem flipTransform_mapCoeffs {Z X' : Scheme.{0}} {R S : Type*} [AddCommGroup R]
    [AddCommGroup S] (f : X ⟶ Z) (fp : X' ⟶ Z) (g : R →+ S) (D : DivisorWithCoeffs R X) :
    flipTransform f fp (DivisorWithCoeffs.mapCoeffsAddMonoidHom g D) =
      DivisorWithCoeffs.mapCoeffsAddMonoidHom g (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.RationalMap.transformDivisor,
    inverseTransformDivisor, mapPrimeDivisors_mapCoeffsAddMonoidHom']

private theorem flipTransform_toQDivisor {Z X' : Scheme.{0}} (f : X ⟶ Z) (fp : X' ⟶ Z)
    (D : Divisor X) :
    flipTransform f fp (Divisor.toQDivisor D) = Divisor.toQDivisor (flipTransform f fp D) :=
  flipTransform_mapCoeffs f fp _ D

private theorem flipTransform_toRDivisor {Z X' : Scheme.{0}} (f : X ⟶ Z) (fp : X' ⟶ Z)
    (D : QDivisor X) :
    flipTransform f fp (QDivisor.toRDivisor D) = QDivisor.toRDivisor (flipTransform f fp D) :=
  flipTransform_mapCoeffs f fp _ D

/-- Pushing prime divisors forward keeps coefficients nonnegative. -/
private theorem mapPrimeDivisors_coeff_nonneg {R : Type*} [AddCommMonoid R] [PartialOrder R]
    [IsOrderedAddMonoid R] (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y))
    {D : DivisorWithCoeffs R X} (hD : ∀ P, 0 ≤ D P) (Q : MMP.Mori.PrimeDivisor Y) :
    0 ≤ DivisorWithCoeffs.mapPrimeDivisors φ D Q := by
  induction D using Finsupp.induction with
  | zero => simp
  | single_add P r D hP hr ih =>
    have hDP : D P = 0 := Finsupp.notMem_support_iff.mp hP
    have hr0 : 0 ≤ r := by simpa [hDP] using hD P
    have hD' : ∀ P', 0 ≤ D P' := fun P' => by
      by_cases h : P' = P
      · subst h; rw [hDP]
      · simpa [Finsupp.single_apply, Ne.symm h] using hD P'
    rw [map_add, Finsupp.add_apply, DivisorWithCoeffs.mapPrimeDivisors_single]
    refine add_nonneg ?_ (ih hD')
    cases φ P with
    | none => simp
    | some P' =>
      by_cases h : P' = Q <;> simp [Finsupp.single_apply, h, hr0]

private theorem flipTransform_coeff_nonneg {Z X' : Scheme.{0}} (f : X ⟶ Z) (fp : X' ⟶ Z)
    {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P) (Q : MMP.Mori.PrimeDivisor X') :
    0 ≤ (flipTransform f fp B).coeff Q :=
  mapPrimeDivisors_coeff_nonneg _ (mapPrimeDivisors_coeff_nonneg _ hB) Q

end Divisors

/-! ### Small contractions and their strict transforms -/

section Small

variable {X X' Z : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
  {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z} {fp : X' ⟶ Z}

/-- A small birational contraction is small in the sense of exceptional sets: `f` is an
isomorphism over an open `V` over which lie all points of codimension at most one of `X`. -/
private theorem isSmallMorphism_of_isSmall [IsNormal X] (hZ : IsNormalVariety ℂ sZ)
    (hf : MMP.Flips.IsSmall ℂ sZ sX f) : IsSmallMorphism sX sZ f := by
  obtain ⟨V, hV, -, hXV, -⟩ := MMP.Mori.exists_opens_isIso_of_isSmall hf hf
  have hVle : V ≤ biregularLocus f := MMP.Mori.isBiregular_iff_le_biregularLocus.mp hV
  refine
    { isNormalVariety_source := ⟨hf.isVariety_source, inferInstance⟩
      isNormalVariety_target := hZ
      comp_eq := hf.comp_eq
      isProper := hf.isProper
      isBirationalMorphism := hf.isBirationalMorphism
      two_le_codimension := ?_ }
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight]
  intro x hx
  by_contra h
  have h1 : Order.coheight x ≤ 1 := by
    by_contra h'
    exact h (by simpa [one_add_one_eq_two] using Order.add_one_le_of_lt (not_le.mp h'))
  exact hx (show x ∈ f ⁻¹ᵁ biregularLocus f from hVle (hXV x h1))

end Small

private theorem isQCartier_neg' {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    {D : QDivisor X} (h : D.IsQCartier) : (-D).IsQCartier := by
  obtain ⟨m, hm, D', hD', hC⟩ := h
  exact ⟨m, hm, -D', by rw [map_neg, hD', smul_neg], hC.neg⟩

private theorem logCanonicalDivisor_eq' {X : Scheme.{0}} (K : Divisor X) (B : QDivisor X) :
    MMP.Flips.logCanonicalDivisor K (QDivisor.toRDivisor B) =
      QDivisor.toRDivisor (Divisor.toQDivisor K + B) := by
  rw [MMP.Flips.logCanonicalDivisor, map_add, QDivisor.toRDivisor_toQDivisor]

/-! ### Relative curve classes of an extremal contraction -/

section Ray

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] in
/-- The degree of a 1-cycle is an isomorphism invariant of the invertible sheaf. -/
private theorem oneCycle_degree_congr [QuasiCompact sX] {L L' : X.Modules}
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L'] (e : L ≅ L') :
    OneCycle.degree ℝ sX L = OneCycle.degree ℝ sX L' := by
  rw [OneCycle.degree, OneCycle.degree]
  congr 2
  funext C
  exact congrArg _ (degreeOn_eq_of_iso ℂ sX C.ι C.dim_le e)

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A relative 1-cycle has intersection number zero with every numerically `f`-trivial
divisor. -/
private theorem intersectionNumber_eq_zero_of_mem_relative {T : KCartierDivisor ℝ X}
    (hT : T ∈ MMP.Flips.relativeNumericallyTrivialDivisors sX f) (W : relativeOneCycles sX f) :
    (W : OneCycle ℝ sX).intersectionNumber T = 0 := by
  rw [MMP.Flips.mem_relativeNumericallyTrivialDivisors] at hT
  have hle : relativeOneCycles sX f ≤
      LinearMap.ker (OneCycle.intersectionPairing (sX := sX) T) := by
    rw [relativeOneCycles, Finsupp.supported_eq_span_single, Submodule.span_le]
    rintro _ ⟨C, hC, rfl⟩
    exact LinearMap.mem_ker.mpr (hT C hC)
  exact LinearMap.mem_ker.mp (hle W.2)

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A morphism with `ρ(X/Z) = 1` contracts some curve. -/
private theorem exists_isContractedBy_of_relativePicardNumber_eq_one
    (h : MMP.Flips.relativePicardNumber sX f = 1) : ∃ C : ProperCurve sX, C.IsContractedBy f := by
  by_contra hno
  push Not at hno
  have : Subsingleton (MMP.Flips.RelativeNumericalDivisorClasses sX f) := by
    refine ⟨fun a b => ?_⟩
    induction a using Submodule.Quotient.induction_on
    induction b using Submodule.Quotient.induction_on
    rw [Submodule.Quotient.eq, MMP.Flips.mem_relativeNumericallyTrivialDivisors]
    intro C hC
    exact absurd hC (hno C)
  rw [MMP.Flips.relativePicardNumber, rank_subsingleton'] at h
  simp at h

variable [QuasiCompact sX]

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [QuasiCompact sX] in
private theorem intersectionNumber_add (W : OneCycle ℝ sX) (D D' : KCartierDivisor ℝ X) :
    W.intersectionNumber (D + D') = W.intersectionNumber D + W.intersectionNumber D' := by
  simp [OneCycle.intersectionNumber]

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [QuasiCompact sX] in
private theorem intersectionNumber_sub (W : OneCycle ℝ sX) (D D' : KCartierDivisor ℝ X) :
    W.intersectionNumber (D - D') = W.intersectionNumber D - W.intersectionNumber D' := by
  simp [OneCycle.intersectionNumber]

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [QuasiCompact sX] in
private theorem intersectionNumber_smul (W : OneCycle ℝ sX) (c : ℝ) (D : KCartierDivisor ℝ X) :
    W.intersectionNumber (c • D) = c * W.intersectionNumber D := by
  simp [OneCycle.intersectionNumber]

/-- `(C · E) = deg_C 𝒪_X(E)` for a proper curve `C` and a Cartier divisor `E`. -/
private theorem cycle_intersectionNumber_ofCartier (C : ProperCurve sX) (E : X.CartierDivisor) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ E) =
      (C.degree ℂ (MMP.CartierDivisor.sheaf E) : ℝ) := by
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]

/-- The relative degree of `𝒪_X(L)` on the class of a contracted curve `C` is `(L · C)`. -/
private theorem degree_relativeClass {L : Divisor X} (hL : L.IsCartier)
    [Stacks.Ample.IsInvertibleModule X L.divisorialSheaf] (C : ProperCurve sX)
    (hC : C.IsContractedBy f) :
    RelativeNumericalCurveClasses.degree sX f L.divisorialSheaf (C.relativeClass f hC) =
      (L.degreeOn ℂ sX C.ι C.dim_le hL : ℝ) := by
  change OneCycle.degree ℝ sX L.divisorialSheaf (C.cycle ℝ) = _
  rw [OneCycle.degree_cycle, ProperCurve.degree_divisorialSheaf C L hL]

/-- **`N₁(X/Z)` is a line.** If `ρ(X/Z) = 1` and `L` is a Cartier divisor of positive degree on
every curve contracted by `f`, then every relative class is a multiple of the class of a given
contracted curve `C₀`, the coefficient being read off from the degree of `L`. -/
private theorem eq_smul_relativeClass (h : MMP.Flips.relativePicardNumber sX f = 1) {L : Divisor X}
    (hL : L.IsCartier) [Stacks.Ample.IsInvertibleModule X L.divisorialSheaf]
    (hpos : ∀ C : ProperCurve sX, C.IsContractedBy f → 0 < L.degreeOn ℂ sX C.ι C.dim_le hL)
    {C₀ : ProperCurve sX} (hC₀ : C₀.IsContractedBy f) (z : RelativeNumericalCurveClasses sX f) :
    z = (RelativeNumericalCurveClasses.degree sX f L.divisorialSheaf z /
      RelativeNumericalCurveClasses.degree sX f L.divisorialSheaf (C₀.relativeClass f hC₀)) •
        C₀.relativeClass f hC₀ := by
  set φ := RelativeNumericalCurveClasses.degree sX f L.divisorialSheaf
  set v := C₀.relativeClass f hC₀
  have hφv : 0 < φ v := by rw [degree_relativeClass hL]; exact_mod_cast hpos C₀ hC₀
  -- the class of `L` spans `N¹(X/Z)`
  obtain ⟨EL, ⟨eL⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf L.divisorialSheaf
  set D₀ : KCartierDivisor ℝ X := KCartierDivisor.ofCartier ℝ EL
  have hD₀ : ∀ W : OneCycle ℝ sX, W.intersectionNumber D₀ = OneCycle.degree ℝ sX L.divisorialSheaf W := by
    intro W
    rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, oneCycle_degree_congr eL]
  have hq₀ : Submodule.Quotient.mk (p := MMP.Flips.relativeNumericallyTrivialDivisors sX f) D₀ ≠ 0 := by
    rw [Ne, Submodule.Quotient.mk_eq_zero, MMP.Flips.mem_relativeNumericallyTrivialDivisors]
    intro h0
    have h1 := h0 C₀ hC₀
    rw [hD₀, OneCycle.degree_cycle, ProperCurve.degree_divisorialSheaf C₀ L hL] at h1
    have h2 := hpos C₀ hC₀
    have h3 : L.degreeOn ℂ sX C₀.ι C₀.dim_le hL = 0 := by exact_mod_cast h1
    omega
  have hfin : Module.finrank ℝ (MMP.Flips.RelativeNumericalDivisorClasses sX f) = 1 := by
    rw [MMP.Flips.relativePicardNumber] at h
    have h1 : Module.rank ℝ (MMP.Flips.RelativeNumericalDivisorClasses sX f) = 1 := by
      have := Cardinal.toENat_eq_natCast.mp (h.trans (by norm_num : (1 : ℕ∞) = ((1 : ℕ) : ℕ∞)))
      exact_mod_cast this
    exact Module.finrank_eq_of_rank_eq (by rw [h1]; norm_num)
  have hspan := (finrank_eq_one_iff_of_nonzero' _ hq₀).mp hfin
  -- `φ` is injective
  have hinj : ∀ w, φ w = 0 → w = 0 := by
    intro w hw
    obtain ⟨W, rfl⟩ := relativeNumericalClass_surjective sX f w
    change Submodule.Quotient.mk W = 0
    rw [Submodule.Quotient.mk_eq_zero, mem_relativeNumericallyTrivial,
      OneCycle.mem_numericallyTrivial]
    intro M _
    obtain ⟨E, ⟨eE⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf M
    obtain ⟨c, hc⟩ := hspan (Submodule.Quotient.mk (KCartierDivisor.ofCartier ℝ E))
    have hT : KCartierDivisor.ofCartier ℝ E - c • D₀ ∈
        MMP.Flips.relativeNumericallyTrivialDivisors sX f := by
      rw [← Submodule.Quotient.eq]
      rw [← hc, Submodule.Quotient.mk_smul]
    have h0 := intersectionNumber_eq_zero_of_mem_relative hT W
    rw [intersectionNumber_sub, intersectionNumber_smul, hD₀, OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree,
      ← oneCycle_degree_congr eE] at h0
    rwa [show OneCycle.degree ℝ sX L.divisorialSheaf W = 0 from hw, mul_zero, sub_zero] at h0
  have key := hinj (z - (φ z / φ v) • v) (by
    rw [map_sub, map_smul, smul_eq_mul, div_mul_cancel₀ _ hφv.ne', sub_self])
  exact (sub_eq_zero.mp key)

/-- **The negative side of a flip is the contraction of the extremal ray `NE̅(X/Z)`.** Let
`f : X ⟶ Z` be a small birational contraction of normal projective varieties with
`ρ(X/Z) = 1`, and `D` a `ℚ`-Cartier `ℚ`-divisor with `-D` `f`-ample. Then `NE̅(X/Z)` is the ray
spanned by the class of a contracted curve `C₀`; its image `R` in `N₁(X)` is a `D`-negative
extremal ray of `NE̅(X)` and `f` is the contraction of `R`. -/
private theorem exists_isNegativeExtremalRayOf_isContractionOfRay
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hXn : IsNormalVariety ℂ sX) (hZn : IsNormalVariety ℂ sZ)
    (hf : MMP.Flips.IsContraction ℂ sZ sX f) (hfb : IsBirationalMorphism f)
    (hρ : MMP.Flips.relativePicardNumber sX f = 1)
    {D : QDivisor X} (hD : D.IsQCartier) (hamp : (-D).HasRelativelyAmpleMultiple f) :
    ∃ (R : Set (NumericalCurveClasses sX)) (C₀ : ProperCurve sX), C₀.IsContractedBy f ∧
      R = {u | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) = u} ∧
      IsNegativeExtremalRayOf sX D R ∧ IsContractionOfRay sX sZ R f := by
  obtain ⟨C₀, hC₀⟩ := exists_isContractedBy_of_relativePicardNumber_eq_one hρ
  obtain ⟨m, hm, L, hL, hLD, hLamp⟩ := id hamp
  haveI := hL.isInvertibleModule_divisorialSheaf
  have hpos : ∀ C : ProperCurve sX, C.IsContractedBy f →
      0 < L.degreeOn ℂ sX C.ι C.dim_le hL := fun C hC =>
    MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _ hLamp C hC
  set φ := RelativeNumericalCurveClasses.degree sX f L.divisorialSheaf
  set v := C₀.relativeClass f hC₀
  have hφv : 0 < φ v := by rw [degree_relativeClass hL]; exact_mod_cast hpos C₀ hC₀
  have hz := eq_smul_relativeClass hρ hL hpos hC₀
  -- `NE̅(X/Z)` is the ray spanned by `[C₀]`
  have hRrel : {w : RelativeNumericalCurveClasses sX f | ∃ c : ℝ, 0 ≤ c ∧ c • v = w} =
      {w | 0 ≤ φ w} := by
    ext w
    constructor
    · rintro ⟨c, hc, rfl⟩
      rw [Set.mem_setOf_eq, map_smul, smul_eq_mul]
      exact mul_nonneg hc hφv.le
    · intro hw
      exact ⟨φ w / φ v, div_nonneg hw hφv.le, (hz w).symm⟩
  have hcone : (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) =
      {w | ∃ c : ℝ, 0 ≤ c ∧ c • v = w} := by
    apply le_antisymm
    · rw [coe_relativeClosedConeOfCurves, hRrel]
      refine closure_minimal ?_ (isClosed_le continuous_const
        (RelativeNumericalCurveClasses.continuous_degree sX f L.divisorialSheaf))
      intro w hw
      change w ∈ Submodule.span _ _ at hw
      refine Submodule.span_induction (p := fun w _ => 0 ≤ φ w) ?_ ?_ ?_ ?_ hw
      · rintro _ ⟨⟨C, hC⟩, rfl⟩
        show 0 ≤ φ (C.relativeClass f hC)
        rw [degree_relativeClass hL]
        exact_mod_cast (hpos C hC).le
      · simp
      · intro a b _ _ ha hb
        rw [map_add]
        exact add_nonneg ha hb
      · intro a w _ hw
        change 0 ≤ φ ((a : ℝ) • w)
        rw [map_smul, smul_eq_mul]
        exact mul_nonneg a.2 hw
    · rintro _ ⟨c, hc, rfl⟩
      have hv : v ∈ relativeClosedConeOfCurves sX f :=
        subset_closure (relativeClass_mem_relativeConeOfCurves hC₀)
      exact (relativeClosedConeOfCurves sX f).smul_mem hc hv
  have hv0 : v ≠ 0 := fun h0 => hφv.ne' (by rw [h0, map_zero])
  have hray : MMP.Mori.IsExtremalRay ℝ
      (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f))
      (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) := by
    refine ⟨⟨subset_rfl, ⟨(relativeClosedConeOfCurves sX f).zero_mem, fun w hw c hc =>
      (relativeClosedConeOfCurves sX f).smul_mem hc.le hw⟩,
      fun a ha b hb => (relativeClosedConeOfCurves sX f).add_mem ha hb,
      fun a ha b hb _ => ⟨ha, hb⟩⟩, v, hv0, hcone⟩
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sZ := hZ
  have habs := MMP.Mori.isExtremalRay_image_relativeToAbsolute sX sZ f hf.comp_eq hray
  have hvabs : relativeToAbsolute sX f v = OneCycle.numericalClass sX (C₀.cycle ℝ) := rfl
  set R : Set (NumericalCurveClasses sX) :=
    {u | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) = u}
  have himage : relativeToAbsolute sX f ''
      (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) = R := by
    rw [hcone]
    ext u
    constructor
    · rintro ⟨_, ⟨c, hc, rfl⟩, rfl⟩
      exact ⟨c, hc, by rw [map_smul, hvabs]⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨c • v, ⟨c, hc, rfl⟩, by rw [map_smul, hvabs]⟩
  rw [himage] at habs
  -- the contraction
  have := hf.isProper
  have hsurj : Function.Surjective f := by
    have : IsDominant f := hfb.isDominant
    have hcl : IsClosed (Set.range f) := f.isClosedMap.isClosed_range
    rw [← Set.range_eq_univ, ← hcl.closure_eq, f.denseRange.closure_range]
  have hsep : IsSeparated sZ := hZ.toIsSeparated
  have hlft : LocallyOfFiniteType sZ := hZ.toLocallyOfFiniteType
  obtain ⟨H, hH, hHa⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety hZ
  have hcontr : IsContractionOfRay sX sZ R f :=
    { isNormalVariety_source := hXn
      isNormalVariety_target := hZn
      comp_eq := hf.comp_eq
      isProjectiveMorphism := isProjectiveMorphism_of_comp_eq hf.comp_eq hX
      surjective := hsurj
      isIso_app := hf.isIso_app
      isContractedBy_iff := fun C => by
        constructor
        · intro hC
          rw [← himage]
          exact ⟨C.relativeClass f hC,
            subset_closure (relativeClass_mem_relativeConeOfCurves hC), rfl⟩
        · rintro ⟨c, -, hc⟩
          refine MMP.ProgramBaseChange.isContractedBy_of_degree_pullback_eq_zero f hf.comp_eq H
            hHa C ?_
          have h0 := ProperCurve.degree_pullback_eq_zero_of_isContractedBy f hf.comp_eq C₀ hC₀ H
          have h1 := congrArg (NumericalCurveClasses.degree sX
            ((Scheme.Modules.pullback f).obj H)) hc
          rw [map_smul, NumericalCurveClasses.degree_numericalClass,
            NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
            OneCycle.degree_cycle, h0, Int.cast_zero, smul_zero] at h1
          exact_mod_cast h1.symm }
  refine ⟨R, C₀, hC₀, rfl, ⟨hD, habs, fun u hu hu0 => ?_⟩, hcontr⟩
  obtain ⟨c, hc, rfl⟩ := hu
  have hc0 : 0 < c := hc.lt_of_ne (by rintro rfl; exact hu0 (zero_smul _ _))
  have hneg : QDivisor.curveForm sX D hD (OneCycle.numericalClass sX (C₀.cycle ℝ)) < 0 := by
    rw [MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
    exact_mod_cast MMP.Fourfold.intersectionNumber_neg_of_isContractedBy hamp C₀ hC₀ hD
  rw [map_smul, smul_eq_mul]
  exact mul_neg_of_pos_of_neg hc0 hneg

end Ray

/-! ### The relative Picard number of the contraction of the ray -/

section Picard

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}

omit [CompactSpace X] in
/-- On an integral, locally Noetherian, normal, quasi-compact scheme every invertible module is
`𝒪(D)` for a Cartier divisor `D`: the divisor of a local frame. -/
private theorem exists_isCartier_divisorialSheaf_iso' [CompactSpace X] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    ∃ D : Divisor X, D.IsCartier ∧ Nonempty (D.divisorialSheaf ≅ L) := by
  have := Stacks.SheafOfModules.isInvertible_of_tensorInvertible (X := X.toRingedSpace) L
  have : ∀ z : X.toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X.toRingedSpace z) :=
    fun z => X.isLocalRing z
  choose W hW a ha using fun y : X =>
    Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible (X := X.toRingedSpace) L y
  obtain ⟨y₀⟩ : Nonempty X := inferInstance
  let F : MMP.Mori.LocalFrame L :=
    { W := W, mem := hW, a := a, isLocalGenerator := fun y V hV => ha y V hV, base := y₀ }
  exact ⟨F.divisor, fun y => ⟨F.W y, F.mem y, _, F.isLocalEquation_divisor y⟩,
    ⟨(@asIso _ _ _ _ F.toDivisorialSheaf F.isIso_toDivisorialSheaf).symm⟩⟩

variable [QuasiCompact sX]

/-- The degree along a proper curve, as an additive map on Cartier divisors. -/
private noncomputable def curveDegreeHom (C : ProperCurve sX) :
    Divisor.cartierSubgroup (X := X) →+ ℤ where
  toFun E := (E : Divisor X).degreeOn ℂ sX C.ι C.dim_le (Divisor.mem_cartierSubgroup.mp E.2)
  map_zero' := Divisor.degreeOn_zero' ℂ sX C.ι C.dim_le
  map_add' E E' := Divisor.degreeOn_add ℂ sX C.ι C.dim_le _ _ _ _

private theorem curveDegreeHom_apply (C : ProperCurve sX) (E : Divisor X) (hE : E.IsCartier) :
    curveDegreeHom C ⟨E, Divisor.mem_cartierSubgroup.mpr hE⟩ = E.degreeOn ℂ sX C.ι C.dim_le hE :=
  rfl

omit [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [QuasiCompact sX] in
private theorem properCurve_degree_congr (C : ProperCurve sX) {L L' : X.Modules}
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L'] (e : L ≅ L') :
    C.degree ℂ L = C.degree ℂ L' :=
  degreeOn_eq_of_iso ℂ sX C.ι C.dim_le e

/-- **`ρ(X/Z) = 1` for the contraction of a negative extremal ray of a klt pair.** If `f` is the
contraction of a `(K + B)`-negative extremal ray `R` of `NE̅(X)` spanned by the class of a curve
`C₀`, for a klt pair `(X, B)` on a projective variety, then `N¹(X) / f^* N¹(Z)` is a line: the
linear form `D ↦ (D · C₀)` is onto, and a divisor of degree zero on `C₀` is numerically a
combination of pull-backs, since a line bundle of degree zero on the curves of `R` descends to
`Z` (Kollár–Mori 3.7(4)). -/
private theorem relativePicardNumberN1_eq_one (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {n : ℕ} {K : Divisor X} {B : QDivisor X}
    (hklt : MMP.Mori.IsKltPair sX n K B) (hBe : B.IsEffective)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsNegativeExtremalRayOf sX (Divisor.toQDivisor K + B) R)
    (hc : IsContractionOfRay sX sZ R f) {C₀ : ProperCurve sX}
    (hRC : R = {u | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) = u}) :
    relativePicardNumberN1 sX f = 1 := by
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  have : IsSeparated sZ := hZ.toIsSeparated
  have : LocallyOfFiniteType sZ := hZ.toLocallyOfFiniteType
  obtain ⟨hQ, hray, hneg⟩ := hR
  have hF : IsNegativeExtremalFace ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
      (QDivisor.curveForm sX (Divisor.toQDivisor K + B) hklt.1.2.2) R :=
    ⟨hray.1, hray.1.2.2.1, fun z hz hz0 => hneg z hz hz0⟩
  have hg : IsContractionOfFace ℂ sX sZ R f :=
    { isProjectiveVariety_source := hX
      isProjectiveVariety_target := hZ
      comp_eq := hc.comp_eq
      isExtremalFace := hray.1
      isContractedBy_iff := hc.isContractedBy_iff
      isIso_app := hc.isIso_app }
  -- line bundles of degree zero on `C₀` descend to `Z`
  have hdesc : ∀ (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L],
      C₀.degree ℂ L = 0 → ∃ LZ : Z.Modules,
        SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 LZ ∧
          Nonempty (L ≅ (Scheme.Modules.pullback f).obj LZ) := by
    intro L _ hL0
    refine MMP.Mori.exists_isInvertible_iso_pullback_of_isContractionOfFace hklt hBe hF hg L
      fun C hC => ?_
    rw [hRC] at hC
    obtain ⟨c, -, hc⟩ := hC
    have h1 := congrArg (NumericalCurveClasses.degree sX L) hc
    rw [map_smul, NumericalCurveClasses.degree_numericalClass,
      NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle, OneCycle.degree_cycle,
      hL0, Int.cast_zero, smul_zero] at h1
    exact_mod_cast h1.symm
  -- the linear form `D ↦ (D · C₀)` on `N¹(X)`
  let ψ : NumericalDivisorClasses sX →ₗ[ℝ] ℝ :=
    (numericallyTrivialDivisors sX).liftQ
      ((OneCycle.intersectionPairing (sX := sX)).flip (C₀.cycle ℝ))
      (fun D hD => LinearMap.mem_ker.mpr ((mem_numericallyTrivialDivisors.mp hD) C₀))
  have hψ : ∀ D, ψ (numericalDivisorClass sX D) = (C₀.cycle ℝ).intersectionNumber D :=
    fun D => rfl
  -- the class of `C₀` is nonzero
  have hC₀ne : OneCycle.numericalClass sX (C₀.cycle ℝ) ≠ 0 := by
    intro h0
    obtain ⟨v, hv0, hRv⟩ := hray.2
    have hvR : v ∈ R := by rw [hRv]; exact ⟨1, zero_le_one, one_smul _ _⟩
    rw [hRC] at hvR
    obtain ⟨c, -, hcv⟩ := hvR
    rw [h0, smul_zero] at hcv
    exact hv0 hcv.symm
  obtain ⟨Es, hEs⟩ : ∃ E : X.CartierDivisor,
      (C₀.degree ℂ (MMP.CartierDivisor.sheaf E) : ℝ) ≠ 0 := by
    by_contra hno
    push Not at hno
    refine hC₀ne ((Submodule.Quotient.mk_eq_zero _).mpr
      (OneCycle.mem_numericallyTrivial.mpr fun M _ => ?_))
    obtain ⟨E, ⟨e⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf M
    rw [OneCycle.degree_cycle, properCurve_degree_congr C₀ e]
    exact hno E
  set b : ℤ := C₀.degree ℂ (MMP.CartierDivisor.sheaf Es)
  -- the image of `b E - (E · C₀) Es` in `N¹(X)` is a pull-back class
  have hδ : ∀ E : X.CartierDivisor, numericalDivisorClass sX
      ((b : ℝ) • KCartierDivisor.ofCartier ℝ E -
        (C₀.degree ℂ (MMP.CartierDivisor.sheaf E) : ℝ) •
          KCartierDivisor.ofCartier ℝ Es) ∈ pullbackNumericalClasses sX f := by
    intro E
    set a : ℤ := C₀.degree ℂ (MMP.CartierDivisor.sheaf E)
    obtain ⟨WE, hWE, ⟨eE⟩⟩ := exists_isCartier_divisorialSheaf_iso'
      (MMP.CartierDivisor.sheaf E)
    obtain ⟨Ws, hWs, ⟨es⟩⟩ := exists_isCartier_divisorialSheaf_iso'
      (MMP.CartierDivisor.sheaf Es)
    have hG : (b • WE - a • Ws).IsCartier := (hWE.zsmul b).sub (hWs.zsmul a)
    haveI := hG.isInvertibleModule_divisorialSheaf
    haveI := hWE.isInvertibleModule_divisorialSheaf
    haveI := hWs.isInvertibleModule_divisorialSheaf
    have hdegG : ∀ C : ProperCurve sX, C.degree ℂ (b • WE - a • Ws).divisorialSheaf =
        b * C.degree ℂ (MMP.CartierDivisor.sheaf E) -
          a * C.degree ℂ (MMP.CartierDivisor.sheaf Es) := by
      intro C
      rw [ProperCurve.degree_divisorialSheaf C _ hG, ← properCurve_degree_congr C eE,
        ← properCurve_degree_congr C es, ProperCurve.degree_divisorialSheaf C _ hWE,
        ProperCurve.degree_divisorialSheaf C _ hWs, ← curveDegreeHom_apply C _ hG,
        ← curveDegreeHom_apply C _ hWE, ← curveDegreeHom_apply C _ hWs]
      rw [show (⟨b • WE - a • Ws, Divisor.mem_cartierSubgroup.mpr hG⟩ :
          Divisor.cartierSubgroup (X := X)) =
          b • ⟨WE, Divisor.mem_cartierSubgroup.mpr hWE⟩ -
            a • ⟨Ws, Divisor.mem_cartierSubgroup.mpr hWs⟩ from rfl, map_sub, map_zsmul,
        map_zsmul, smul_eq_mul, smul_eq_mul]
    obtain ⟨LZ, hLZ, ⟨eZ⟩⟩ := hdesc (b • WE - a • Ws).divisorialSheaf
      (by rw [hdegG]; ring)
    obtain ⟨G', ⟨eG'⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf
      (b • WE - a • Ws).divisorialSheaf
    have hmem : numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ G') ∈
        pullbackNumericalClasses sX f :=
      Submodule.subset_span ⟨G', LZ, hLZ, ⟨eG'.symm ≪≫ eZ⟩, rfl⟩
    convert hmem using 1
    refine (Submodule.Quotient.eq _).mpr (mem_numericallyTrivialDivisors.mpr fun C => ?_)
    simp only [intersectionNumber_sub, intersectionNumber_smul,
      cycle_intersectionNumber_ofCartier]
    rw [← properCurve_degree_congr C eG', hdegG]
    push_cast
    ring
  -- every class of degree zero on `C₀` is a pull-back class
  have hker : LinearMap.ker ψ = pullbackNumericalClasses sX f := by
    apply le_antisymm
    · intro d hd
      obtain ⟨D, rfl⟩ := Submodule.Quotient.mk_surjective _ d
      have hΦ : ∀ D : KCartierDivisor ℝ X, (b : ℝ) • numericalDivisorClass sX D -
          (C₀.cycle ℝ).intersectionNumber D •
            numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ Es) ∈
          pullbackNumericalClasses sX f := by
        intro D
        induction D using Finsupp.induction_linear with
        | zero => simpa [OneCycle.intersectionNumber] using zero_mem _
        | add D₁ D₂ h₁ h₂ =>
          rw [intersectionNumber_add, map_add, smul_add, add_smul]
          convert add_mem h₁ h₂ using 1
          abel
        | single E c =>
          have hs : Finsupp.single E c = c • KCartierDivisor.ofCartier ℝ E := by
            rw [KCartierDivisor.ofCartier, Finsupp.smul_single, smul_eq_mul, mul_one]
          rw [hs]
          rw [intersectionNumber_smul, cycle_intersectionNumber_ofCartier]
          convert Submodule.smul_mem _ c (hδ E) using 1
          simp only [map_sub, map_smul, smul_sub, smul_smul, mul_comm]
      have h := hΦ D
      rw [show (C₀.cycle ℝ).intersectionNumber D = 0 from hd, zero_smul, sub_zero] at h
      have := Submodule.smul_mem _ ((b : ℝ)⁻¹) h
      rwa [smul_smul, inv_mul_cancel₀ hEs, one_smul] at this
    · rw [pullbackNumericalClasses, Submodule.span_le]
      rintro _ ⟨E, M, hM, ⟨e⟩, rfl⟩
      change ψ _ = 0
      rw [hψ, cycle_intersectionNumber_ofCartier, properCurve_degree_congr C₀ e,
        ProperCurve.degree_pullback_eq_zero_of_isContractedBy f hc.comp_eq C₀ ?_ M, Int.cast_zero]
      rw [hc.isContractedBy_iff, hRC]
      exact ⟨1, zero_le_one, one_smul _ _⟩
  have hsurj : Function.Surjective ψ := by
    intro r
    refine ⟨numericalDivisorClass sX
      ((r / (b : ℝ)) • KCartierDivisor.ofCartier ℝ Es), ?_⟩
    rw [hψ, intersectionNumber_smul, cycle_intersectionNumber_ofCartier, div_mul_cancel₀ _ hEs]
  rw [relativePicardNumberN1, ((Submodule.quotEquivOfEq _ _ hker.symm).trans
    (ψ.quotKerEquivOfSurjective hsurj)).rank_eq, Module.rank_self]
  simp

end Picard

/-- An `f`-ample Cartier divisor has an `f`-ample divisorial sheaf. -/
private theorem isRelativelyAmple_divisorialSheaf {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ W} {L : Divisor X}
    (hL : MMP.Flips.IsRelativelyAmpleCartier f L) :
    haveI := hL.1.isInvertibleModule_divisorialSheaf
    MMP.Mori.IsRelativelyAmple f L.divisorialSheaf := by
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
  exact ⟨V, hV, hyV, hL.2 V hV⟩

/-- An `f`-ample Cartier divisor has positive degree on every curve contracted by `f`. -/
private theorem degreeOn_pos_of_isRelativelyAmpleCartier {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {f : X ⟶ W} {L : Divisor X} (hL : MMP.Flips.IsRelativelyAmpleCartier f L)
    (C : ProperCurve sX) (hC : C.IsContractedBy f) : 0 < L.degreeOn ℂ sX C.ι C.dim_le hL.1 :=
  haveI := hL.1.isInvertibleModule_divisorialSheaf
  MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _
    (isRelativelyAmple_divisorialSheaf hL) C hC

/-- An ample `ℝ`-Cartier divisor on a proper variety is nef over any base. -/
private theorem isRelativelyNef_of_isRelativelyAmple_spec {X Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {A : RDivisor X} (h : MMP.Flips.IsRelativelyAmple sX A) (g : X ⟶ Z) :
    MMP.Flips.IsRelativelyNef ℂ sX g A := by
  obtain ⟨m, r, L, -, hr, hL, hA⟩ := h
  refine ⟨m, r, L, fun j => (hL j).1, hA, fun C _ x hx => ?_⟩
  obtain ⟨hL', d, -, hd, rfl⟩ := hx
  refine Finset.sum_nonneg fun j _ => mul_nonneg (hr j).le ?_
  rw [MMP.Fourfold.Oai4C1.Negativity.eq_degreeOn_of_isCartierIntersectionNumber (hd j)]
  exact_mod_cast (degreeOn_pos_of_isRelativelyAmpleCartier (hL j) C
    fun x _ => Subsingleton.elim _ _).le

/-- An ample scaling boundary for a klt pair over a birational base: an effective `ℝ`-Cartier
`C` with `(X, Δ + C)` klt and `K + Δ + C` nef over `Z`. -/
private theorem exists_scalingBoundary {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hdim : topologicalKrullDim X = 4)
    (hQ : IsQFactorial sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 4) {g : X ⟶ Z}
    (hgZ : g ≫ sZ = sX) {Δ : QDivisor X} (hΔ : IsKltPair sX Δ) :
    ∃ C : RDivisor X, (∀ P, 0 ≤ C.coeff P) ∧ IsCartierCombination C ∧
      IsRealKltPair sX (QDivisor.toRDivisor Δ + C) ∧
      MMP.Flips.IsRelativelyNef ℂ sX g (logCanonicalDivisor K (QDivisor.toRDivisor Δ + C)) := by
  classical
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  have hΔ0 : ∀ P, 0 ≤ (QDivisor.toRDivisor Δ).coeff P := fun P => by
    rw [QDivisor.coeff_toRDivisor]; exact_mod_cast hΔ.1.nonneg P
  have hreal : IsRealKltPair sX (QDivisor.toRDivisor Δ) := by
    have hmori := (isKltPair_iff_mori_isKltPair sX hK hΔ.1).1 hΔ
    have hlt := roundDown_nonpos_iff.mp hmori.2.2
    obtain ⟨n', r, L, hL, hpres⟩ := isCartierCombination_of_isQFactorial hQ
      (Divisor.toRDivisor K + QDivisor.toRDivisor Δ)
    refine ⟨hQ.1, fun P => by rw [QDivisor.coeff_toRDivisor]; exact_mod_cast hlt P,
      ⟨4, K, hK, n', r, L, hL, fun Γ => ?_⟩, hΔ.2⟩
    have h := congrArg (fun D : RDivisor X => D.coeff Γ) hpres
    change DivisorWithCoeffs.coeff (Divisor.toRDivisor K + QDivisor.toRDivisor Δ) Γ = _
    rw [h]
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.coe_finset_sum, Finset.sum_apply,
      Finsupp.smul_apply, smul_eq_mul]
    rfl
  have hdim2 : (2 : WithBot ℕ∞) ≤ topologicalKrullDim X := by rw [hdim]; norm_num
  obtain ⟨l, P, E, h, -, -, -, -, -, hh, -, hklt, hamp⟩ :=
    IsRealKltPair.exists_isRelativelyAmple_add_linearIndependent hQ hX hdim2 hΔ0 hreal
  set H : RDivisor X := ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1)
  refine ⟨H, fun Q => ?_, ?_, hklt, ?_⟩
  · change (0 : ℝ) ≤ (∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1)) Q
    rw [Finsupp.finset_sum_apply]
    refine Finset.sum_nonneg fun j _ => ?_
    rw [Finsupp.smul_apply, smul_eq_mul]
    refine mul_nonneg (hh j).1.le ?_
    change (0 : ℝ) ≤ ((Finsupp.single (P j) (1 : ℤ) Q : ℤ) : ℝ)
    rw [Finsupp.single_apply]; split_ifs <;> norm_num
  · obtain ⟨n', r, L, hL, hpres⟩ := isCartierCombination_of_isQFactorial hQ H
    exact ⟨n', r, L, hL, by simpa only [toRDivisor_eq_mapCoeffs] using hpres⟩
  · have h := hamp 4 K hK
    rw [show logCanonicalDivisor K (QDivisor.toRDivisor Δ + H) =
      Divisor.toRDivisor K + QDivisor.toRDivisor Δ + H from (add_assoc _ _ _).symm]
    exact isRelativelyNef_of_isRelativelyAmple_spec h g

/-! ### Comparing the rational and the real formalism -/

section Compare

/-- The strict transform along the identity of the target is the push-forward. -/
private theorem flipTransform_id {X W : Scheme.{0}} {R : Type*} [AddCommMonoid R] (f : X ⟶ W)
    (D : DivisorWithCoeffs R X) :
    flipTransform f (𝟙 W) D = MMP.Mori.RationalMap.transformDivisor f.toRationalMap D :=
  MMP.Fourfold.inverseTransformDivisor_id _

/-- An effective klt `ℚ`-boundary on a `ℚ`-factorial variety is klt as a real boundary. -/
private theorem isRealKltPair_toRDivisor {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hQ : IsQFactorial sX) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX 4) {Δ : QDivisor X} (hΔ : MMP.Fourfold.IsKltPair sX Δ) :
    IsRealKltPair sX (QDivisor.toRDivisor Δ) := by
  have hmori := (isKltPair_iff_mori_isKltPair sX hK hΔ.1).1 hΔ
  have hlt := roundDown_nonpos_iff.mp hmori.2.2
  exact ⟨hQ.1, fun P => by rw [QDivisor.coeff_toRDivisor]; exact_mod_cast hlt P,
    ⟨4, K, hK, MMP.Fourfold.IsQFactorial.isRCartier hQ _⟩, hΔ.2⟩

/-- A `ℚ`-Cartier `ℚ`-divisor which is nef over `Y` as an `ℝ`-divisor is nef over `Y`. -/
private theorem isRelativelyNef_of_isRelativelyNef_toRDivisor {k : Type} [Field k]
    {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Y} {D : QDivisor X} (hD : D.IsQCartier)
    (h : MMP.Flips.IsRelativelyNef k sX f (QDivisor.toRDivisor D)) :
    QDivisor.IsRelativelyNef sX f D := by
  refine ⟨hD, fun C hC => ?_⟩
  obtain ⟨m, r, L, hL, hpres, hnn⟩ := h
  have hx := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C r L hL
  rw [← hpres] at hx
  have h0 := hnn C hC _ hx
  set N := D.cartierIndex hD
  set Lc : Divisor X := (D.cartierIndexSMul hD : Divisor X)
  have hLc : Lc.IsCartier := (D.cartierIndexSMul hD).2
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast (QDivisor.cartierIndex_pos hD).ne'
  have hpres1 : QDivisor.toRDivisor D =
      ∑ _j : Fin 1, ((N : ℝ)⁻¹) • Divisor.toRDivisor Lc := by
    rw [Fin.sum_univ_one]
    ext P
    have := congrArg (fun T : QDivisor X => T.coeff P) (QDivisor.toQDivisor_cartierIndexSMul D hD)
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at this
    simp only [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor,
      smul_eq_mul]
    rw [show ((Lc.coeff P : ℤ) : ℝ) = (((Lc.coeff P : ℤ) : ℚ) : ℝ) by push_cast; rfl, this]
    push_cast
    field_simp
    try rfl
  have h1 := MMP.Flips.isRIntersectionNumber_sum_degreeOn k sX C
    (fun _ : Fin 1 => (N : ℝ)⁻¹) (fun _ => Lc) (fun _ => hLc)
  rw [← hpres1] at h1
  have heq := (MMP.Flips.IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h1
  rw [heq, Fin.sum_univ_one] at h0
  have h2 : (0 : ℝ) ≤ (Lc.degreeOn k sX C.ι C.dim_le hLc : ℝ) := by
    have hNpos : (0 : ℝ) < (N : ℝ)⁻¹ := inv_pos.mpr (by exact_mod_cast QDivisor.cartierIndex_pos hD)
    exact (mul_nonneg_iff_of_pos_left hNpos).mp h0
  rw [QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier, Finsupp.smul_single,
    smul_eq_mul, mul_one, Finsupp.sum_single_index (by simp)]
  exact mul_nonneg (by positivity) h2

end Compare

/-! ### Stages of the program -/

section Stage

variable {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ))

/-- A model of the program over `Z` at level `μ`: a `ℚ`-factorial projective klt fourfold pair
`(V, Θ)` with a projective birational morphism to `Z` over `ℂ`, together with an effective real
divisor `C` (the transform of the scaling divisor) such that `(V, Θ + μ C)` is lc and
`K + Θ + μ C` is nef over `Z`. -/
private structure Stage where
  V : Scheme.{0}
  [isIntegral : IsIntegral V]
  [compactSpace : CompactSpace V]
  [isLocallyNoetherian : IsLocallyNoetherian V]
  [isNormal : IsNormal V]
  sV : V ⟶ Spec (.of ℂ)
  K : Divisor V
  Θ : QDivisor V
  C : RDivisor V
  μ : ℝ
  π : V ⟶ Z
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ sV
  isQFactorial : MMP.Fourfold.IsQFactorial sV
  dim_eq : topologicalKrullDim V = 4
  isCanonicalDivisor : K.IsCanonicalDivisor sV 4
  isKltPair : MMP.Fourfold.IsKltPair sV Θ
  comp_eq : π ≫ sZ = sV
  isProjectiveMorphism : IsProjectiveMorphism π
  isBirationalMorphism : MMP.Mori.IsBirationalMorphism π
  nonneg_C : ∀ P, 0 ≤ C.coeff P
  pos_μ : 0 < μ
  isRealLcPair : IsRealLcPair sV (QDivisor.toRDivisor Θ + μ • C)
  isRelativelyNef_level : MMP.Flips.IsRelativelyNef ℂ sV π
    (MMP.Flips.logCanonicalDivisor K (QDivisor.toRDivisor Θ + μ • C))

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

variable {sZ}

/-- The adjoint of a stage is nef over the base (as a real divisor). -/
private def Stage.IsNef (s : Stage sZ) : Prop :=
  MMP.Flips.IsRelativelyNef ℂ s.sV s.π
    (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ))

/-- A step of the program with scaling from the stage `s` to the stage `s'`: a step of a relative
program over `Z` in the sense of `MMP.Fourfold.RelativeFourfoldProgram`, which is at the same
time a step of the `(K + Θ)`-program over `Z` with scaling of `C`, with threshold `t`. -/
private structure IsStep (s s' : Stage sZ) {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ))
    (g : s.V ⟶ T) (gp : s'.V ⟶ T) (h : T ⟶ Z) (R : Set (NumericalCurveClasses s.sV)) (t : ℝ)
    (φ : s.V.RationalMap s'.V) : Prop where
  isFourfoldStepDiagram : IsFourfoldStepDiagram s.sV sT s'.sV s.K s.Θ g gp
  K_eq : s'.K = flipTransform g gp s.K
  Θ_eq : s'.Θ = flipTransform g gp s.Θ
  comp_eq_base : h ≫ sZ = sT
  isProjectiveMorphism_base : IsProjectiveMorphism h
  π_eq : s.π = g ≫ h
  π_eq' : s'.π = gp ≫ h
  isNegativeExtremalRayOf : IsNegativeExtremalRayOf s.sV (Divisor.toQDivisor s.K + s.Θ) R
  exists_ray_eq : ∃ C : ProperCurve s.sV, C.IsContractedBy s.π ∧
    R = {u | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass _ (C.cycle ℝ) = u}
  isContractionOfRay : IsContractionOfRay s.sV sT R g
  relativePicardNumber_eq_one : relativePicardNumberN1 s.sV g = 1
  isLeast : IsLeast {u : ℝ | 0 ≤ u ∧ MMP.Flips.IsRelativelyNef ℂ s.sV s.π
    (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ + u • s.C))} t
  isNegativeExtremalContraction : MMP.Flips.IsNegativeExtremalContraction ℂ s.sV sT
    (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ)) g
  isNumericallyTrivialOver : MMP.Flips.IsNumericallyTrivialOver ℂ s.sV g
    (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ + t • s.C))
  kind : (MMP.Mori.IsBirationalMorphism g ∧
      (∃ E : MMP.Mori.PrimeDivisor s.V, (MMP.Mori.exceptionalSet g : Set s.V) = E.support) ∧
      IsIso gp ∧ MMP.Flips.IsModificationOf g gp φ) ∨
    MMP.Flips.IsFlip ℂ s.sV sT s'.sV
      (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ)) g gp φ
  B_eq : QDivisor.toRDivisor s'.Θ =
    MMP.Mori.RationalMap.transformDivisor φ (QDivisor.toRDivisor s.Θ)
  C_eq : s'.C = MMP.Mori.RationalMap.transformDivisor φ s.C

/-- The data of a step from `s`, which is a step of the program when the adjoint of `s` is not
nef over the base. -/
private structure StepData (s : Stage sZ) where
  next : Stage sZ
  T : Scheme.{0}
  sT : T ⟶ Spec (.of ℂ)
  g : s.V ⟶ T
  gp : next.V ⟶ T
  h : T ⟶ Z
  R : Set (NumericalCurveClasses s.sV)
  t : ℝ
  φ : s.V.RationalMap next.V
  spec : ¬ s.IsNef → IsStep s next sT g gp h R t φ

end Stage

/-! ### One step of the program with scaling -/

section StepSection

variable {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of ℂ)}

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

/-- **One step of the program with scaling.** At a stage whose adjoint is not nef over the base,
the nef threshold `t` of `C` comes with a `(K + Θ)`-negative extremal ray of `NE̅(V/Z)` null for
`K + Θ + t C`; its contraction over `Z` (the base is birational over `Z`) is divisorial or small,
and the divisorial contraction or the flip gives the next stage, at level `t`. The contraction
is also the contraction of the image of the ray in `NE̅(V)`, an extremal ray spanned by the class
of a curve contracted over `Z`. -/
private theorem exists_isStep (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (s : Stage sZ) (hs : ¬ s.IsNef) :
    ∃ (s' : Stage sZ) (T : Scheme.{0}) (sT : T ⟶ Spec (.of ℂ)) (g : s.V ⟶ T) (gp : s'.V ⟶ T)
      (h : T ⟶ Z) (R : Set (NumericalCurveClasses s.sV)) (t : ℝ) (φ : s.V.RationalMap s'.V),
      IsStep s s' sT g gp h R t φ := by
  classical
  haveI : IsIntegral Z := hZ.toIsVariety.toIsIntegral
  haveI : QuasiCompact s.sV := s.isProjectiveVariety.toIsVariety.toQuasiCompact
  haveI : IsSeparated sZ := hZ.toIsSeparated
  have hq := s.isQFactorial
  have hproj := s.isProjectiveVariety
  have hK4 := s.isCanonicalDivisor
  have hXn : IsNormalVariety ℂ s.sV := hq.1
  have hklt := s.isKltPair
  have hπ := s.comp_eq
  have hπb := s.isBirationalMorphism
  have hC := s.nonneg_C
  have hB : ∀ P, 0 ≤ (QDivisor.toRDivisor s.Θ).coeff P := fun P => by
    rw [QDivisor.coeff_toRDivisor]; exact_mod_cast hklt.1.nonneg P
  have hrklt : IsRealKltPair s.sV (QDivisor.toRDivisor s.Θ) := isRealKltPair_toRDivisor hq hK4 hklt
  have hdlt : IsRealDltPair s.sV (QDivisor.toRDivisor s.Θ) :=
    isRealDltPair_of_isRealKltPair hB hrklt
  -- the nef threshold and its ray
  obtain ⟨l, hl0, hlμ, hnefl, hKBc, -, Rr, hR, hnull, hneg, hpos⟩ :=
    exists_isExtremalRay_nef_threshold_of_isRealLcPair hproj hZ hπ hq hK4 hB hC s.pos_μ
      s.isRealLcPair s.isRelativelyNef_level hs
  -- a presentation of `K + Θ`, negative on `Rr`
  have hneg' : ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.V) (hL : ∀ j, (L j).IsCartier),
      MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ) =
          ∑ j, r j • Divisor.toRDivisor (L j) ∧
        ∀ u ∈ Rr, u ≠ 0 → ∑ j, r j *
          (haveI := (hL j).isInvertibleModule_divisorialSheaf
           RelativeNumericalCurveClasses.degree s.sV s.π (L j).divisorialSheaf u) < 0 := by
    obtain ⟨m, r, L, hL, hD⟩ := hKBc
    have heq : MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ) =
        ∑ j, r j • Divisor.toRDivisor (L j) := by
      refine Finsupp.ext fun P => ?_
      change (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ)).coeff P =
        (∑ j, r j • Divisor.toRDivisor (L j)).coeff P
      rw [show MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ) =
        Divisor.toRDivisor s.K + QDivisor.toRDivisor s.Θ from rfl, hD P]
      simp [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
      rfl
    exact ⟨m, r, L, hL, heq, fun u hu hu0 => hneg m r L hL heq u hu hu0⟩
  -- the elementary step of the ray
  obtain ⟨W, iW, cW, lW, nW, sW, f, h, hcontr, hWproj, hnegext, -, hdiv, hsmall⟩ :=
    IsRealDltPair.exists_isRelativeContractionOfFace_of_isExtremalRay hproj hZ hπ hq s.dim_eq
      ⟨4, hK4⟩ hdlt hR hneg'
  have hcomm : f ≫ h = s.π := hcontr.comp_eq
  obtain ⟨hfb, hhs⟩ := isBirationalMorphism_of_isContraction hnegext.isContraction hcomm hπ hπb
    hZ.toIsVariety
  have hWn : IsNormalVariety ℂ sW := hnegext.isNormalVariety_target
  haveI : LocallyOfFiniteType sW := hWn.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (h ≫ sZ) := by rw [hhs]; infer_instance
  haveI : LocallyOfFiniteType h := LocallyOfFiniteType.of_comp (f := h) (g := sZ) inferInstance
  have hhb : IsBirationalMorphism h :=
    MMP.Fourfold.Oai4C1.Main.isBirationalMorphism_of_comp_left f h hfb (hcomm ▸ hπb)
  -- curves contracted by `f` are contracted by `π`, with class in `Rr`
  have hRf : ∀ Γ : ProperCurve s.sV, Γ.IsContractedBy f →
      ∃ hΓ : Γ.IsContractedBy s.π, Γ.relativeClass s.π hΓ ∈ Rr := by
    intro Γ hΓ
    have hΓπ : Γ.IsContractedBy s.π := by
      rw [← hcomm]
      intro x hx
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ x hx]
    exact ⟨hΓπ, (hcontr.isContractedBy_iff Γ hΓπ).mp hΓ⟩
  have hnullC : ∀ (Γ : ProperCurve s.sV) (hΓ : Γ.IsContractedBy s.π),
      Γ.relativeClass s.π hΓ ∈ Rr → ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.V) (x : ℝ),
        IsRIntersectionNumber ℂ s.sV
          (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ + l • s.C)) r L Γ x →
          x = 0 :=
    fun Γ hΓ hΓR m r L x hx => isRIntersectionNumber_of_degree Γ hΓ (· = 0)
      (fun n c N hN hD => hnull n c N hN hD _ hΓR) hx
  -- a contracted curve
  obtain ⟨Γ, hΓ⟩ :=
    exists_isContractedBy_of_relativePicardNumber_eq_one' f hnegext.relativePicardNumber_eq_one
  obtain ⟨hΓπ, hΓR⟩ := hRf Γ hΓ
  have hΓ0 : Γ.relativeClass s.π hΓπ ≠ 0 := by
    intro h0
    obtain ⟨m', r', L', hL', hN'⟩ := hnegext.isCartierCombination
    have hy := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ s.sV Γ r' L' hL'
    have hN'' : MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ) =
        ∑ i, r' i • Divisor.toRDivisor (L' i) := by
      rw [hN']
      simp_rw [← MMP.Flips.toRDivisor_eq_mapCoeffs]
    rw [← hN''] at hy
    have hlt := isRIntersectionNumber_neg_of_isRelativelyAntiAmple f
      hnegext.isRelativelyAntiAmple Γ hΓ r' L' _ hy
    have h00 := isRIntersectionNumber_of_degree Γ hΓπ (· = 0)
      (fun n c N hN _ => by simp [h0]) hy
    exact (lt_irrefl _ (h00 ▸ hlt))
  have hposC : ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.V) (x : ℝ),
      IsRIntersectionNumber ℂ s.sV s.C r L Γ x → 0 < x :=
    fun m r L x hx => isRIntersectionNumber_of_degree Γ hΓπ (0 < ·)
      (fun n c N hN hD => hpos n c N hN hD _ hΓR hΓ0) hx
  have hleast : IsLeast {u : ℝ | 0 ≤ u ∧ MMP.Flips.IsRelativelyNef ℂ s.sV s.π
      (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ + u • s.C))} l :=
    isLeast_of_null hq hl0.le hnefl Γ hΓπ (hnullC Γ hΓπ hΓR) hposC
  have htriv : MMP.Flips.IsNumericallyTrivialOver ℂ s.sV f
      (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ + l • s.C)) :=
    isNumericallyTrivialOver_of_null (isCartierCombination_of_isQFactorial hq _)
      fun Γ' hΓ' m r L x hx => by
        obtain ⟨hΓ'π, hΓ'R⟩ := hRf Γ' hΓ'
        exact hnullC Γ' hΓ'π hΓ'R m r L x hx
  -- `(V, Θ + l C)` is lc
  have hlcl : IsRealLcPair s.sV (QDivisor.toRDivisor s.Θ + l • s.C) := by
    have h := isRealLcPair_segment hq hdlt.1 s.isRealLcPair (s := l / s.μ) (by
      have := s.pos_μ; positivity) ((div_le_one s.pos_μ).2 hlμ)
    convert h using 1
    rw [smul_add, smul_smul, div_mul_cancel₀ l s.pos_μ.ne']
    module
  -- the rational side: the absolute ray and the ampleness of `-(K + Θ)` over `f`
  haveI : IsProper f := hnegext.isContraction.isProper
  have hKΘq : (Divisor.toQDivisor s.K + s.Θ).IsQCartier := isQCartier_of_isQFactorial _ hq _
  have hamp : (-(Divisor.toQDivisor s.K + s.Θ)).HasRelativelyAmpleMultiple f :=
    MMP.IndexTailFromSequence.hasRelativelyAmpleMultiple_of_isRelativelyAmple hXn hWn
      hnegext.isContraction.comp_eq (isQCartier_neg' hKΘq)
      (by rw [map_neg, ← logCanonicalDivisor_eq']; exact hnegext.isRelativelyAntiAmple)
  obtain ⟨R, C₀, hC₀, hRC, hRneg, hRc⟩ := exists_isNegativeExtremalRayOf_isContractionOfRay
    hproj hWproj hXn hWn hnegext.isContraction hfb hnegext.relativePicardNumber_eq_one hKΘq hamp
  have hmklt : MMP.Mori.IsKltPair s.sV 4 s.K s.Θ :=
    (isKltPair_iff_mori_isKltPair s.sV hK4 hklt.1).1 hklt
  have hρ : relativePicardNumberN1 s.sV f = 1 :=
    relativePicardNumberN1_eq_one hproj hWproj hmklt (fun P => hklt.1.nonneg P) hRneg hRc hRC
  have hC₀π : C₀.IsContractedBy s.π := by
    rw [← hcomm]
    intro x hx
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC₀ x hx]
  haveI : MMP.Mori.IsVariety ℂ s.sV := hXn.1
  haveI : MMP.Mori.IsVariety ℂ sW := hWn.1
  have hdimW : topologicalKrullDim W = 4 := by
    rw [← s.dim_eq, MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW s.sV hfb]
  -- the step, given its positive side `fp : U' ⟶ W` and the birational map `φ`
  have key : ∀ (U' : Scheme.{0}) [IsIntegral U'] [CompactSpace U'] [IsLocallyNoetherian U']
      [IsNormal U'] (sU' : U' ⟶ Spec (.of ℂ)) (fp : U' ⟶ W) (φ : s.V.RationalMap U'),
      IsSmallMorphism sU' sW fp → IsProjectiveMorphism fp →
      MMP.Mori.IsProjectiveVariety ℂ sU' → MMP.Fourfold.IsQFactorial sU' →
      MMP.Mori.Divisor.IsCanonicalDivisor sU' 4 (flipTransform f fp s.K) →
      MMP.Mori.QDivisor.HasRelativelyAmpleMultiple
        (Divisor.toQDivisor (flipTransform f fp s.K) + flipTransform f fp s.Θ) fp →
      ((MMP.Mori.IsBirationalMorphism f ∧
          (∃ E : MMP.Mori.PrimeDivisor s.V, (MMP.Mori.exceptionalSet f : Set s.V) = E.support) ∧
          IsIso fp ∧ MMP.Flips.IsModificationOf f fp φ) ∨
        MMP.Flips.IsFlip ℂ s.sV sW sU'
          (MMP.Flips.logCanonicalDivisor s.K (QDivisor.toRDivisor s.Θ)) f fp φ) →
      QDivisor.toRDivisor (flipTransform f fp s.Θ) =
        MMP.Mori.RationalMap.transformDivisor φ (QDivisor.toRDivisor s.Θ) →
      IsRealLcPair sU' (QDivisor.toRDivisor (flipTransform f fp s.Θ) +
        l • MMP.Mori.RationalMap.transformDivisor φ s.C) →
      MMP.Flips.IsRelativelyNef ℂ sU' (fp ≫ h)
        (MMP.Flips.logCanonicalDivisor (flipTransform f fp s.K)
          (QDivisor.toRDivisor (flipTransform f fp s.Θ) +
            l • MMP.Mori.RationalMap.transformDivisor φ s.C)) →
      ∃ (s' : Stage sZ) (gp : s'.V ⟶ W) (φ' : s.V.RationalMap s'.V),
        IsStep s s' sW f gp h R l φ' := by
    intro U' _ _ _ _ sU' fp φ hfs hfp hU'proj hU'q hU'K hampp hkind hBeq hlc' hnef'
    have hU'n : IsNormalVariety ℂ sU' := hU'q.1
    haveI : MMP.Mori.IsVariety ℂ sU' := hU'n.1
    haveI : IsProper fp := hfs.isProper
    have hfpb : IsBirationalMorphism fp := hfs.isBirationalMorphism
    have hdimU' : topologicalKrullDim U' = 4 := by
      rw [← hdimW, MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW sU' hfpb]
    have hdiag : IsFourfoldStepDiagram s.sV sW sU' s.K s.Θ f fp :=
      { isProjectiveVariety_minus := hproj
        isNormalVariety_minus := hXn
        dim_minus := s.dim_eq
        isProjectiveVariety_plus := hU'proj
        isNormalVariety_plus := hU'n
        dim_plus := hdimU'
        isProjectiveVariety_target := hWproj
        isNormalVariety_target := hWn
        comp_eq_minus := hnegext.isContraction.comp_eq
        comp_eq_plus := hfs.comp_eq
        isProjectiveMorphism_minus := hRc.isProjectiveMorphism
        isProjectiveMorphism_plus := hfp
        isBirationalMorphism_minus := hfb
        isIso_app_minus := hnegext.isContraction.isIso_app
        isIso_app_plus := (MMP.Resolution.Bridges.isIso_app_and_isConnected_of_isBirationalMorphism
          sU' sW hU'n.1 hWn fp hfpb).1
        isSmallMorphism_plus := hfs
        isCanonicalDivisor := ⟨4, hK4⟩
        nonneg := hklt.1.nonneg
        isQCartier_minus := hKΘq
        isQCartier_plus := isQCartier_of_isQFactorial _ hU'q _
        hasRelativelyAmpleMultiple_minus := hamp
        hasRelativelyAmpleMultiple_plus := hampp }
    have hcomp' : (fp ≫ h) ≫ sZ = sU' := by rw [Category.assoc, hhs, hfs.comp_eq]
    let s' : Stage sZ :=
      { V := U'
        sV := sU'
        K := flipTransform f fp s.K
        Θ := flipTransform f fp s.Θ
        C := MMP.Mori.RationalMap.transformDivisor φ s.C
        μ := l
        π := fp ≫ h
        isProjectiveVariety := hU'proj
        isQFactorial := hU'q
        dim_eq := hdimU'
        isCanonicalDivisor := hU'K
        isKltPair := hdiag.isKltPair_flipTransform hklt
        comp_eq := hcomp'
        isProjectiveMorphism := isProjectiveMorphism_of_comp_eq hcomp' hU'proj
        isBirationalMorphism :=
          MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hfpb hhb
        nonneg_C := fun P => transformDivisor_nonneg φ hC P
        pos_μ := hl0
        isRealLcPair := hlc'
        isRelativelyNef_level := hnef' }
    exact ⟨s', fp, φ,
      { isFourfoldStepDiagram := hdiag
        K_eq := rfl
        Θ_eq := rfl
        comp_eq_base := hhs
        isProjectiveMorphism_base := isProjectiveMorphism_of_comp_eq hhs hWproj
        π_eq := hcomm.symm
        π_eq' := rfl
        isNegativeExtremalRayOf := hRneg
        exists_ray_eq := ⟨C₀, hC₀π, hRC⟩
        isContractionOfRay := hRc
        relativePicardNumber_eq_one := hρ
        isLeast := hleast
        isNegativeExtremalContraction := hnegext
        isNumericallyTrivialOver := htriv
        kind := hkind
        B_eq := hBeq
        C_eq := rfl }⟩
  by_cases hsm : MMP.Flips.IsSmall ℂ sW s.sV f
  · -- the flip
    obtain ⟨X', iI, iC, iL, iN, sX', fp, hstep, hX'proj, hX'q, hX'dim, -, -, hX'⟩ :=
      hsmall hsm
    obtain ⟨φ, hflip, htr⟩ := exists_isFlip_of_isRealFlipStep hWproj hstep hsm
    have hsm' := hstep.isSmall_flip
    have hX'n : IsNormalVariety ℂ sX' := ⟨hsm'.isVariety_source, inferInstance⟩
    haveI : IsProper fp := hsm'.isProper
    obtain ⟨m, hm⟩ := hstep.isCanonicalDivisor_flip
    have hm4 : m = 4 := by
      have := hm.1.symm.trans hX'dim
      exact_mod_cast this
    subst hm4
    have hBtr : QDivisor.toRDivisor (flipTransform f fp s.Θ) =
        MMP.Mori.RationalMap.transformDivisor φ (QDivisor.toRDivisor s.Θ) := by
      rw [htr, flipTransform_toRDivisor]
    have hlin : flipTransform f fp (QDivisor.toRDivisor s.Θ + l • s.C) =
        QDivisor.toRDivisor (flipTransform f fp s.Θ) +
          l • MMP.Mori.RationalMap.transformDivisor φ s.C := by
      rw [← htr (QDivisor.toRDivisor s.Θ + l • s.C), map_add, transformDivisor_smul, hBtr]
    obtain ⟨hlc', hnef'⟩ := hX' (QDivisor.toRDivisor s.Θ + l • s.C) hlcl hnefl hnullC
    rw [hlin] at hlc' hnef'
    have hQ' : (Divisor.toQDivisor (flipTransform f fp s.K) +
        flipTransform f fp s.Θ).IsQCartier := isQCartier_of_isQFactorial _ hX'q _
    have hampp : MMP.Mori.QDivisor.HasRelativelyAmpleMultiple
        (Divisor.toQDivisor (flipTransform f fp s.K) + flipTransform f fp s.Θ) fp := by
      refine MMP.IndexTailFromSequence.hasRelativelyAmpleMultiple_of_isRelativelyAmple hX'n hWn
        hsm'.comp_eq hQ' ?_
      have := hstep.isRelativelyAmple_flip
      rwa [flipTransform_toRDivisor, logCanonicalDivisor_eq'] at this
    obtain ⟨s', gp, φ', hst⟩ := key X' sX' fp φ (isSmallMorphism_of_isSmall hWn hsm')
      hstep.isProjectiveMorphism_flip hX'proj hX'q hm hampp (Or.inr hflip) hBtr hlc' hnef'
    exact ⟨s', W, sW, f, gp, h, R, l, φ', hst⟩
  · -- the divisorial contraction
    have hbc : MMP.Flips.IsBirationalContraction ℂ sW s.sV f :=
      ⟨hnegext.isContraction,
        (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW s.sV hfb).symm⟩
    have hfp : IsProjectiveMorphism f := hRc.isProjectiveMorphism
    obtain ⟨E, hE⟩ := exists_primeDivisor_moriExceptionalSet_eq_support_of_not_isSmall'
      s.sV sW hq hWn f hbc hfp hnegext.relativePicardNumber_eq_one hsm
    obtain ⟨hWq, -, hW'⟩ := hdiv ⟨hfb, E, hE⟩
    obtain ⟨hlc', hnef'⟩ := hW' (QDivisor.toRDivisor s.Θ + l • s.C) hlcl hnefl hnullC
    have hBtr : QDivisor.toRDivisor (flipTransform f (𝟙 W) s.Θ) =
        MMP.Mori.RationalMap.transformDivisor f.toRationalMap (QDivisor.toRDivisor s.Θ) := by
      rw [← flipTransform_toRDivisor, flipTransform_id]
    have hlin : MMP.Mori.RationalMap.transformDivisor f.toRationalMap
        (QDivisor.toRDivisor s.Θ + l • s.C) =
        QDivisor.toRDivisor (flipTransform f (𝟙 W) s.Θ) +
          l • MMP.Mori.RationalMap.transformDivisor f.toRationalMap s.C := by
      rw [map_add, transformDivisor_smul, hBtr]
    rw [hlin] at hlc' hnef'
    rw [← flipTransform_id f s.K, ← Category.id_comp h] at hnef'
    have hWK : MMP.Mori.Divisor.IsCanonicalDivisor sW 4 (flipTransform f (𝟙 W) s.K) := by
      rw [flipTransform_id]
      exact isCanonicalDivisor_transformDivisor_of_isContraction hnegext.isContraction hXn hWn
        hfb hK4
    obtain ⟨s', gp, φ', hst⟩ := key W sW (𝟙 W) f.toRationalMap (isSmallMorphism_id hWn)
      (isProjectiveMorphism_of_comp_eq (Category.id_comp sW) hWproj) hWproj hWq hWK
      (hasRelativelyAmpleMultiple_of_isIso _ (isQCartier_of_isQFactorial _ hWq _))
      (Or.inl ⟨hfb, ⟨E, hE⟩, inferInstance, isModificationOf_id_of_isBirationalMorphism f hfb⟩)
      hBtr hlc' hnef'
    exact ⟨s', W, sW, f, gp, h, R, l, φ', hst⟩

private theorem nonempty_stepData (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (s : Stage sZ) : Nonempty (StepData s) := by
  by_cases hs : s.IsNef
  · exact ⟨⟨s, s.V, s.sV, 𝟙 _, 𝟙 _, s.π, ∅, 0, Scheme.Hom.toRationalMap (𝟙 s.V),
      fun h => absurd hs h⟩⟩
  · obtain ⟨s', T, sT, g, gp, h, R, t, φ, hst⟩ := exists_isStep hZ hZn s hs
    exact ⟨⟨s', T, sT, g, gp, h, R, t, φ, fun _ => hst⟩⟩

end StepSection

/-! ### The program -/

section Program

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

variable {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of ℂ)} (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
  (hZn : IsNormalVariety ℂ sZ)

/-- The chosen step from a stage. -/
private noncomputable def stepOf (s : Stage sZ) : StepData s :=
  Classical.choice (nonempty_stepData hZ hZn s)

/-- The stages `s_k` of the program from `s₀`: `s_{k+1}` is the output of the chosen step from
`s_k`. -/
private noncomputable def stages (s₀ : Stage sZ) (k : ℕ) : Stage sZ :=
  Nat.rec (motive := fun _ => Stage sZ) s₀ (fun _ s => (stepOf hZ hZn s).next) k

/-- **Termination.** If no stage of the program had nef adjoint, its stages would form an
infinite `(K + Θ)`-program over `Z` with scaling of `C`, which is impossible by the termination
of real klt fourfold programs with scaling over a birational base. -/
private theorem exists_isNef (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (s₀ : Stage sZ)
    (hklt₁ : IsRealKltPair s₀.sV (QDivisor.toRDivisor s₀.Θ + s₀.C))
    (hnef₁ : MMP.Flips.IsRelativelyNef ℂ s₀.sV s₀.π
      (MMP.Flips.logCanonicalDivisor s₀.K (QDivisor.toRDivisor s₀.Θ + s₀.C))) :
    ∃ k, (stages hZ hZn s₀ k).IsNef := by
  by_contra hne
  push Not at hne
  let st := stages hZ hZn s₀
  have hst (k : ℕ) : IsStep (st k) (st (k + 1)) (stepOf hZ hZn (st k)).sT
      (stepOf hZ hZn (st k)).g (stepOf hZ hZn (st k)).gp (stepOf hZ hZn (st k)).h
      (stepOf hZ hZn (st k)).R (stepOf hZ hZn (st k)).t (stepOf hZ hZn (st k)).φ :=
    (stepOf hZ hZn (st k)).spec (hne k)
  have hB : ∀ P, 0 ≤ (QDivisor.toRDivisor s₀.Θ).coeff P := fun P => by
    rw [QDivisor.coeff_toRDivisor]; exact_mod_cast s₀.isKltPair.1.nonneg P
  have hfin := (MMP.Fourfold.exists_scalingProgram_and_finite_of_isBirationalMorphism s₀.sV sZ
    s₀.π s₀.comp_eq s₀.isProjectiveVariety hZ hZn s₀.isProjectiveMorphism s₀.isBirationalMorphism
    s₀.isQFactorial s₀.K s₀.isCanonicalDivisor (QDivisor.toRDivisor s₀.Θ) s₀.C hB s₀.nonneg_C
    (isCartierCombination_of_isQFactorial s₀.isQFactorial _)
    (isCartierCombination_of_isQFactorial s₀.isQFactorial _) hklt₁ hnef₁).2
  refine hfin ⊤ (fun k => (st (k + 1)).V) (fun k => (st (k + 1)).sV)
    (fun k => (st (k + 1)).π) (fun k => (st (k + 1)).K)
    (fun k => QDivisor.toRDivisor (st (k + 1)).Θ) (fun k => (st (k + 1)).C)
    (fun k => (stepOf hZ hZn (st k)).t) (fun k => (stepOf hZ hZn (st k)).T)
    (fun k => (stepOf hZ hZn (st k)).sT)
    (fun k => match k with
      | 0 => (stepOf hZ hZn (st 0)).g
      | k + 1 => (stepOf hZ hZn (st (k + 1))).g)
    (fun k => (stepOf hZ hZn (st k)).h) (fun k => (stepOf hZ hZn (st k)).gp)
    (fun k => match k with
      | 0 => (stepOf hZ hZn (st 0)).φ
      | k + 1 => (stepOf hZ hZn (st (k + 1))).φ)
    (fun k _ => ?_) (fun k _ => ?_) rfl
  · rcases k with _ | k
    · exact ⟨(st 0).comp_eq, (st 0).isProjectiveVariety, (st 0).isQFactorial,
        ⟨4, (st 0).isCanonicalDivisor⟩,
        isRealKltPair_toRDivisor (st 0).isQFactorial (st 0).isCanonicalDivisor
          (st 0).isKltPair⟩
    · exact ⟨(st (k + 1)).comp_eq, (st (k + 1)).isProjectiveVariety, (st (k + 1)).isQFactorial,
        ⟨4, (st (k + 1)).isCanonicalDivisor⟩,
        isRealKltPair_toRDivisor (st (k + 1)).isQFactorial (st (k + 1)).isCanonicalDivisor
          (st (k + 1)).isKltPair⟩
  · rcases k with _ | k
    · have h := hst 0
      exact ⟨h.isLeast, h.isFourfoldStepDiagram.isProjectiveVariety_target, h.π_eq.symm,
        h.π_eq'.symm, h.isNegativeExtremalContraction, h.isNumericallyTrivialOver, h.kind,
        h.B_eq, h.C_eq⟩
    · have h := hst (k + 1)
      exact ⟨h.isLeast, h.isFourfoldStepDiagram.isProjectiveVariety_target, h.π_eq.symm,
        h.π_eq'.symm, h.isNegativeExtremalContraction, h.isNumericallyTrivialOver, h.kind,
        h.B_eq, h.C_eq⟩

open Classical in
/-- The program from `s₀`, stopped at its first stage with nef adjoint. -/
private theorem exists_program (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hZn : IsNormalVariety ℂ sZ) (s₀ : Stage sZ)
    (hklt₁ : IsRealKltPair s₀.sV (QDivisor.toRDivisor s₀.Θ + s₀.C))
    (hnef₁ : MMP.Flips.IsRelativelyNef ℂ s₀.sV s₀.π
      (MMP.Flips.logCanonicalDivisor s₀.K (QDivisor.toRDivisor s₀.Θ + s₀.C))) :
    ∃ P : RelativeFourfoldProgram s₀.sV sZ s₀.π s₀.K s₀.Θ,
      (∀ k ≤ P.m, MMP.Fourfold.IsKltPair (P.modelStructure k) (P.boundary k)) ∧
      QDivisor.IsRelativelyNef (P.modelStructure P.m) (P.toBase P.m)
        (Divisor.toQDivisor (P.canonical P.m) + P.endBoundary) := by
  let st := stages hZ hZn s₀
  have hm := exists_isNef hZ hZn s₀ hklt₁ hnef₁
  have hst (k : ℕ) (hk : k < Nat.find hm) : IsStep (st k) (st (k + 1))
      (stepOf hZ hZn (st k)).sT (stepOf hZ hZn (st k)).g (stepOf hZ hZn (st k)).gp
      (stepOf hZ hZn (st k)).h (stepOf hZ hZn (st k)).R (stepOf hZ hZn (st k)).t
      (stepOf hZ hZn (st k)).φ :=
    (stepOf hZ hZn (st k)).spec (Nat.find_min hm hk)
  let P : RelativeFourfoldProgram s₀.sV sZ s₀.π s₀.K s₀.Θ :=
    { m := Nat.find hm
      Y := fun k => (st (k + 1)).V
      sY := fun k => (st (k + 1)).sV
      isIntegral := fun k => inferInstance
      compactSpace := fun k => inferInstance
      isLocallyNoetherian := fun k => inferInstance
      isNormal := fun k => inferInstance
      KY := fun k => (st (k + 1)).K
      ΘY := fun k => (st (k + 1)).Θ
      πY := fun k => (st (k + 1)).π
      T := fun k => (stepOf hZ hZn (st k)).T
      sT := fun k => (stepOf hZ hZn (st k)).sT
      g := fun k => match k with
        | 0 => (stepOf hZ hZn (st 0)).g
        | k + 1 => (stepOf hZ hZn (st (k + 1))).g
      gp := fun k => (stepOf hZ hZn (st k)).gp
      h := fun k => (stepOf hZ hZn (st k)).h
      R := fun k => match k with
        | 0 => (stepOf hZ hZn (st 0)).R
        | k + 1 => (stepOf hZ hZn (st (k + 1))).R
      isProjectiveVariety_base := hZ
      isNormalVariety_base := hZn
      isProjectiveVariety := s₀.isProjectiveVariety
      dim_eq := s₀.dim_eq
      isPair := s₀.isKltPair.1
      isCanonicalDivisor := ⟨4, s₀.isCanonicalDivisor⟩
      comp_eq := s₀.comp_eq
      isProjectiveMorphism := s₀.isProjectiveMorphism
      isQFactorial := fun k _ => by
        rcases k with _ | k
        exacts [(st 0).isQFactorial, (st (k + 1)).isQFactorial]
      isFourfoldStepDiagram := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).isFourfoldStepDiagram
      KY_eq := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).K_eq
      ΘY_eq := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).Θ_eq
      comp_eq_base := fun k hk => (hst k hk).comp_eq_base
      isProjectiveMorphism_base := fun k hk =>
        (hst k hk).isProjectiveMorphism_base
      modelMap_eq := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).π_eq
      πY_eq := fun k hk => (hst k hk).π_eq'
      isNegativeExtremalRayOf := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).isNegativeExtremalRayOf
      exists_ray_eq := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).exists_ray_eq
      isContractionOfRay := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).isContractionOfRay
      relativePicardNumber_eq_one := fun k hk => by
        rcases k with _ | k <;> exact (hst _ hk).relativePicardNumber_eq_one }
  refine ⟨P, fun k _ => ?_, ?_⟩
  · rcases k with _ | k
    exacts [(st 0).isKltPair, (st (k + 1)).isKltPair]
  · have key (k : ℕ) (hk : (st k).IsNef) : QDivisor.IsRelativelyNef (P.modelStructure k)
        (P.toBase k) (Divisor.toQDivisor (P.canonical k) + P.boundary k) := by
      have hq : (Divisor.toQDivisor (st k).K + (st k).Θ).IsQCartier :=
        isQCartier_of_isQFactorial _ (st k).isQFactorial _
      haveI : QuasiCompact (st k).sV := (st k).isProjectiveVariety.toIsVariety.toQuasiCompact
      have hk' : MMP.Flips.IsRelativelyNef ℂ (st k).sV (st k).π
          (QDivisor.toRDivisor (Divisor.toQDivisor (st k).K + (st k).Θ)) := by
        rw [← logCanonicalDivisor_eq']; exact hk
      have h := isRelativelyNef_of_isRelativelyNef_toRDivisor hq hk'
      rcases k with _ | k <;> exact h
    exact key _ (Nat.find_spec hm)

end Program

/-- In the setting of a decreased boundary `Θ'` of a crepant junction `J` of `(X_i, B_i)`
extracting `I_∞` over a stabilized small klt tail `T`, for any canonical divisor `K` of `Y_i`
there is a finite relative program over `Z_i` from `(Y_i, Θ')` in which every model
`(V_k, Θ_k)`, `k ≤ m`, is klt and whose end has `K_{V_m} + Θ_m` nef over `Z_i`. -/
private theorem solution
    {T : StabilizedSmallKltTail} {i : ℕ}
    {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (hI : (I : Set _) = T.stableLowDiscrepancySetAt i)
    {J : FourfoldCrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}
    (hΘ' : IsDecreasedBoundary J Θ') (K : Divisor J.Y)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor J.sY n) :
    ∃ P : RelativeFourfoldProgram J.sY (T.sZ i) (J.p ≫ T.f i) K Θ',
      (∀ k ≤ P.m, MMP.Fourfold.IsKltPair (P.modelStructure k) (P.boundary k)) ∧
      QDivisor.IsRelativelyNef (P.modelStructure P.m) (P.toBase P.m)
        (Divisor.toQDivisor (P.canonical P.m) + P.endBoundary) := by
  have hD := T.isFourfoldStepDiagram i
  have hZ := hD.isProjectiveVariety_target
  have hZn := hD.isNormalVariety_target
  have hcomp : (J.p ≫ T.f i) ≫ T.sZ i = J.sY := by
    rw [Category.assoc, hD.comp_eq_minus]
  haveI : IsSeparated (T.sZ i) := hZ.toIsSeparated
  have hklt : MMP.Fourfold.IsKltPair J.sY Θ' := (hΘ'.isKltTerminalPair hI).1
  obtain ⟨n, hKn⟩ := hK
  have hn : n = 4 := by
    have := hKn.1.symm.trans J.dim_eq
    exact_mod_cast this
  subst hn
  -- the scaling divisor
  obtain ⟨C, hC0, -, hCklt, hCnef⟩ :=
    exists_scalingBoundary J.isProjectiveVariety J.dim_eq J.isQFactorial hKn hcomp hklt
  have hBC : ∀ P, 0 ≤ (QDivisor.toRDivisor Θ' + C).coeff P := fun P => by
    rw [DivisorWithCoeffs.coeff_add, QDivisor.coeff_toRDivisor]
    have := hklt.1.nonneg P
    have := hC0 P
    have : (0 : ℝ) ≤ (Θ'.coeff P : ℝ) := by exact_mod_cast hklt.1.nonneg P
    linarith
  let s₀ : Stage (T.sZ i) :=
    { V := J.Y
      sV := J.sY
      K := K
      Θ := Θ'
      C := C
      μ := 1
      π := J.p ≫ T.f i
      isProjectiveVariety := J.isProjectiveVariety
      isQFactorial := J.isQFactorial
      dim_eq := J.dim_eq
      isCanonicalDivisor := hKn
      isKltPair := hklt
      comp_eq := hcomp
      isProjectiveMorphism := isProjectiveMorphism_of_comp_eq hcomp J.isProjectiveVariety
      isBirationalMorphism := MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp
        J.isBirationalMorphism hD.isBirationalMorphism_minus
      nonneg_C := hC0
      pos_μ := one_pos
      isRealLcPair := by
        rw [one_smul]
        exact ⟨hCklt.1, hBC, hCklt.2.2.1, fun n E a ha => (hCklt.2.2.2 n E a ha).le⟩
      isRelativelyNef_level := by rw [one_smul]; exact hCnef }
  exact exists_program hZ hZn s₀ hCklt hCnef

end Proof_lem_oai4_c1_bridge_mmp

end

open CategoryTheory AlgebraicGeometry

namespace MMP.Fourfold.StabilizedSmallKltTail

open MMP.Mori

/-- In the setting of a decreased boundary `Θ'` of a crepant junction `J` of `(X_i, B_i)`
extracting `I_∞` over a stabilized small klt tail `T`, for any canonical divisor `K` of `Y_i`
there is a finite relative program over `Z_i` from `(Y_i, Θ')` in which every model
`(V_k, Θ_k)`, `k ≤ m`, is klt and whose end has `K_{V_m} + Θ_m` nef over `Z_i`. -/
@[mmp "lem_oai4_c1_bridge_mmp"]
public theorem IsDecreasedBoundary.exists_relativeFourfoldProgram
    {T : StabilizedSmallKltTail} {i : ℕ}
    {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (hI : (I : Set _) = T.stableLowDiscrepancySetAt i)
    {J : FourfoldCrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}
    (hΘ' : IsDecreasedBoundary J Θ') (K : Divisor J.Y)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor J.sY n) :
    ∃ P : RelativeFourfoldProgram J.sY (T.sZ i) (J.p ≫ T.f i) K Θ',
      (∀ k ≤ P.m, IsKltPair (P.modelStructure k) (P.boundary k)) ∧
      QDivisor.IsRelativelyNef (P.modelStructure P.m) (P.toBase P.m)
        (Divisor.toQDivisor (P.canonical P.m) + P.endBoundary) :=
          by revert T i I hI J Θ' hΘ' K hK; first | exact Proof_lem_oai4_c1_bridge_mmp.solution | exact Proof_lem_oai4_c1_bridge_mmp.solution _ | exact Proof_lem_oai4_c1_bridge_mmp.solution _ _ | exact Proof_lem_oai4_c1_bridge_mmp.solution _ _ _ | exact Proof_lem_oai4_c1_bridge_mmp.solution _ _ _ _

end MMP.Fourfold.StabilizedSmallKltTail

