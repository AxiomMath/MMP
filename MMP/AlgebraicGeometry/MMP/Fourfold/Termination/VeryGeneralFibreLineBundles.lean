/-! ### Germs of inverse images -/

section Transport

variable {X Y : TopCat.{0}} (f : X ⟶ Y) (F : TopCat.Sheaf (ModuleCat.{0} ℚ) Y)

private theorem exists_section_of_local
    (y : ∀ x : X, ToType (((TopCat.Sheaf.forget _ Y).obj F).stalk (f x)))
    (hy : ∀ x₀ : X, ∃ (W : Opens Y) (r : ToType (((TopCat.Sheaf.forget _ Y).obj F).obj (op W)))
      (N : Opens X) (_ : x₀ ∈ N) (hNW : N ≤ (Opens.map f).obj W),
      ∀ x (hx : x ∈ N), y x = ((TopCat.Sheaf.forget _ Y).obj F).germ W (f x) (hNW hx) r) :
    ∃ s : ToType (((TopCat.Sheaf.forget _ X).obj (Pb f F)).obj (op ⊤)), ∀ x,
      ((TopCat.Sheaf.forget _ X).obj (Pb f F)).germ ⊤ x trivial s =
        (stalkToPullbackStalk f F x).hom (y x) := by
  choose W r N hN hNW hloc using hy
  set P := (TopCat.Sheaf.forget _ X).obj (Pb f F)
  let sf : ∀ i : X, ToType (P.obj (op (N i))) := fun i =>
    P.map (homOfLE (hNW i)).op (unitSec f F (r i))
  have hgerm : ∀ i x (hx : x ∈ N i), P.germ (N i) x hx (sf i) =
      (stalkToPullbackStalk f F x).hom (y x) := by
    intro i x hx
    rw [TopCat.Presheaf.germ_res_apply, hloc i x hx]
    exact (stalkToPullbackStalk_germ f F (r i) x _).symm
  have hcompat : TopCat.Presheaf.IsCompatible P N sf := by
    intro i j
    refine TopCat.Presheaf.section_ext (Pb f F) _ _ _ fun x hx => ?_
    change P.germ _ x hx _ = P.germ _ x hx _
    rw [TopCat.Presheaf.germ_res_apply P ((N i).infLELeft (N j)) x hx (sf i),
      TopCat.Presheaf.germ_res_apply P ((N i).infLERight (N j)) x hx (sf j), hgerm, hgerm]
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' (Pb f F) N ⊤ (fun i => homOfLE le_top)
    (fun x _ => Opens.mem_iSup.2 ⟨x, hN x⟩) sf hcompat
  refine ⟨s, fun x => ?_⟩
  rw [← hgerm x x (hN x), ← hs x]
  exact (TopCat.Presheaf.germ_res_apply _ _ _ _ _).symm

omit F in
private theorem stalkCongr_stalkCongr (P : TopCat.Presheaf (ModuleCat.{0} ℚ) Y) {p q u : Y}
    (e : Inseparable p q) (e' : Inseparable q u) (y : ToType (P.stalk p)) :
    (P.stalkCongr e').hom.hom ((P.stalkCongr e).hom.hom y) =
      (P.stalkCongr (e.trans e')).hom.hom y :=
  TopCat.Presheaf.stalkSpecializes_comp_apply P e'.ge e.ge y

omit F in
private theorem stalkCongr_self (P : TopCat.Presheaf (ModuleCat.{0} ℚ) Y) {p : Y}
    (e : Inseparable p p) (y : ToType (P.stalk p)) : (P.stalkCongr e).hom.hom y = y := by
  change (P.stalkSpecializes e.ge).hom y = y
  rw [show e.ge = specializes_refl p from rfl, TopCat.Presheaf.stalkSpecializes_refl]
  rfl

end Transport

/-! ### Sheets of a family over a base change -/

/-- The sheet `F_t × {t''} ⟶ 𝓕' = 𝓕 ×_{T°} T'` over a `ℂ`-point `t''` of `T'` above `t`: its
components are the inclusion `F_t ⟶ 𝓕` and `F_t ⟶ Spec ℂ ⟶ T'` through `t''`. -/
private def sheetι {Y Yt : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)} {T : IrreducibleCloseds Y}
    {π : Yt ⟶ Y} {To : (curveScheme T).Opens} {t : ComplexPoints (To.ι ≫ curveι T ≫ sY)}
    {T' : Scheme.{0}} {φ : T' ⟶ (To : Scheme.{0})}
    (t'' : {t'' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY) // t''.hom ≫ φ = t.hom}) :
    pointFibre sY π To t ⟶ pullback (pullback.snd π (To.ι ≫ curveι T)) φ :=
  pullback.lift (pointFibreToFamily sY π To t) (pointFibreSnd sY π To t ≫ t''.1.hom) (by
    rw [Category.assoc, t''.2]
    exact pullback.lift_snd _ _ _)

/-- The sheet `F_t × {t''}` lies over the inclusion `F_t ⟶ 𝓕`. -/
private theorem sheetι_comp_fst {Y Yt : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)}
    {T : IrreducibleCloseds Y} {π : Yt ⟶ Y} {To : (curveScheme T).Opens}
    {t : ComplexPoints (To.ι ≫ curveι T ≫ sY)} {T' : Scheme.{0}} {φ : T' ⟶ (To : Scheme.{0})}
    (s : {t'' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY) // t''.hom ≫ φ = t.hom}) :
    sheetι s ≫ pullback.fst (pullback.snd π (To.ι ≫ curveι T)) φ = pointFibreToFamily sY π To t :=
  pullback.lift_fst _ _ _

section AnalyticInputs

/-- The structure morphism of a Zariski-open `T°` of the curve `T` of a local setting is locally of
finite type, quasi-compact and separated. -/
private theorem curveOpen_structure {Y Yt : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (sY : Y ⟶ Spec (.of ℂ)) (Θ : QDivisor Y) (T : IrreducibleCloseds Y)
    (π : Yt ⟶ Y) (hS : IsLocalSetting sY Θ T π) (To : (curveScheme T).Opens) :
    LocallyOfFiniteType (To.ι ≫ curveι T ≫ sY) ∧ QuasiCompact (To.ι ≫ curveι T ≫ sY) ∧
      IsSeparated (To.ι ≫ curveι T ≫ sY) := by
  haveI : AlgebraicGeometry.IsVariety ℂ sY := hS.isProjectiveVariety.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsLocallyNoetherian (curveScheme T) :=
    LocallyOfFiniteType.isLocallyNoetherian (curveι T ≫ sY)
  haveI : CompactSpace (curveScheme T) :=
    QuasiCompact.compactSpace_of_compactSpace (curveι T ≫ sY)
  haveI : IsNoetherian (curveScheme T) := ⟨⟩
  exact ⟨inferInstance, inferInstance, inferInstance⟩

end AnalyticInputs

/-! ### Deformation of tubes onto proper fibres -/

section TubeDeformation

open unitInterval

/-- A continuous map with values in `j '' interior N`, for an open embedding `j`, lifts
continuously through `j` to `N`. -/
private theorem exists_continuous_lift_of_isOpenEmbedding {T Y W : Type*} [TopologicalSpace T]
    [TopologicalSpace Y] [TopologicalSpace W] {j : T → Y} (hj : IsOpenEmbedding j) {N : Set T}
    {f : W → Y} (hf : Continuous f) (hfN : ∀ w, f w ∈ j '' interior N) :
    ∃ s : C(W, N), ∀ w, j (s w) = f w := by
  have hr : ∀ w, f w ∈ Set.range j := fun w ↦ by
    obtain ⟨u, -, hu⟩ := hfN w
    exact ⟨u, hu⟩
  let e := hj.isEmbedding.toHomeomorph
  let sec : W → T := fun w ↦ e.symm ⟨f w, hr w⟩
  have hjsec : ∀ w, j (sec w) = f w := fun w ↦
    congrArg Subtype.val (e.apply_symm_apply ⟨f w, hr w⟩)
  have hsecN : ∀ w, sec w ∈ N := fun w ↦ by
    obtain ⟨u, hu, hju⟩ := hfN w
    exact hj.injective ((hjsec w).trans hju.symm) ▸ interior_subset hu
  exact ⟨⟨fun w ↦ ⟨sec w, hsecN w⟩, (e.symm.continuous.comp (hf.subtype_mk _)).subtype_mk _⟩,
    hjsec⟩

/-- An open subspace of a space with bases of open contractible neighbourhoods has such bases. -/
private theorem hasOpenContractibleBasis_of_isOpenEmbedding {T Y : Type*} [TopologicalSpace T]
    [TopologicalSpace Y] {j : T → Y} (hj : IsOpenEmbedding j)
    (hY : MMP.HasOpenContractibleBasis Y) :
    MMP.HasOpenContractibleBasis T := by
  intro t
  refine ⟨fun s ↦ ⟨fun hs ↦ ?_, fun ⟨V, ⟨hVo, htV, _⟩, hVs⟩ ↦
    Filter.mem_of_superset (hVo.mem_nhds htV) hVs⟩⟩
  obtain ⟨V, ⟨hVo, hjV, hVc⟩, hVs⟩ := (hY (j t)).mem_iff.1 (hj.image_mem_nhds.2 hs)
  have hVr : V ⊆ Set.range j := hVs.trans (Set.image_subset_range _ _)
  refine ⟨j ⁻¹' V, ⟨hVo.preimage hj.continuous, hjV, ?_⟩, ?_⟩
  · haveI := hVc
    exact (hj.isEmbedding.homeomorphOfSubsetRange hVr).contractibleSpace
  · intro u hu
    obtain ⟨u', hu', he⟩ := hVs hu
    exact hj.injective he ▸ hu'

/-- **Deformation of a tube onto a fibre.** -/
private theorem exists_tube_deformation {Y B T : Type*} [TopologicalSpace Y] [TopologicalSpace B]
    [TopologicalSpace T] {p : Y → B} (hp : Continuous p) (hpc : IsClosedMap p) {b : B}
    (hb : IsClosed ({b} : Set B)) {j : T → Y} (hj : IsOpenEmbedding j)
    (hZj : p ⁻¹' {b} ⊆ Set.range j) {n : ℕ} {E : T → EuclideanSpace ℝ (Fin n)}
    (hE : IsClosedEmbedding E) (hY : MMP.HasOpenContractibleBasis Y)
    (hZ : MMP.HasOpenContractibleBasis (p ⁻¹' {b})) {V : Set B} (hV : IsOpen V)
    (hbV : b ∈ V) :
    ∃ W : Set B, IsOpen W ∧ b ∈ W ∧ W ⊆ V ∧ ∃ ρ : C(p ⁻¹' W, p ⁻¹' {b}),
      (∀ y : p ⁻¹' W, p y = b → (ρ y : Y) = y) ∧
      ∃ H : C(I × p ⁻¹' W, p ⁻¹' V), (∀ y, (H (0, y) : Y) = y) ∧
        ∀ y, (H (1, y) : Y) = ρ y := by
  set Z : Set Y := p ⁻¹' {b}
  set ZT : Set T := (p ∘ j) ⁻¹' {b}
  have hZTc : IsClosed ZT := hb.preimage (hp.comp hj.continuous)
  have eZ : ZT ≃ₜ Z := hj.isEmbedding.homeomorphOfSubsetRange hZj
  have hM : (p ∘ j) ⁻¹' V ∈ 𝓝ˢ ZT :=
    (hV.preimage (hp.comp hj.continuous)).mem_nhdsSet.2 fun t ht ↦ by
      have : p (j t) = b := ht
      change p (j t) ∈ V
      rwa [this]
  obtain ⟨N, -, hZN, -, r, -, hrfix, G, -, hG0, hG1, -, hGM⟩ :=
    MMP.exists_isClosed_isProperMap_retraction_homotopy hE hZTc (hZ.of_homeomorph eZ.symm)
      (hasOpenContractibleBasis_of_isOpenEmbedding hj hY) hM
  set O : Set Y := j '' interior N
  have hO : IsOpen O := hj.isOpenMap _ isOpen_interior
  have hZO : Z ⊆ O := fun z hz ↦ by
    obtain ⟨u, rfl⟩ := hZj hz
    exact ⟨u, hZN (show p (j u) = b from hz), rfl⟩
  refine ⟨V ∩ (p '' Oᶜ)ᶜ, hV.inter (hpc _ hO.isClosed_compl).isOpen_compl,
    ⟨hbV, ?_⟩, Set.inter_subset_left, ?_⟩
  · rintro ⟨y, hy, hyb⟩
    exact hy (hZO hyb)
  have hWO : ∀ y : p ⁻¹' (V ∩ (p '' Oᶜ)ᶜ), (y : Y) ∈ O := fun y ↦ by
    by_contra h
    exact y.2.2 ⟨y, h, rfl⟩
  obtain ⟨secN, hjsec⟩ := exists_continuous_lift_of_isOpenEmbedding hj continuous_subtype_val hWO
  let ρ : C(p ⁻¹' (V ∩ (p '' Oᶜ)ᶜ), Z) :=
    ⟨fun y ↦ ⟨j (r (secN y)), (r (secN y)).2⟩, ((hj.continuous.comp continuous_subtype_val).comp
      (r.continuous.comp secN.continuous)).subtype_mk _⟩
  refine ⟨ρ, fun y hy ↦ ?_, ?_⟩
  · change j (r (secN y)) = y
    have hsecZ : ((secN y : N) : T) ∈ ZT := by
      change p (j (secN y)) = b
      rwa [hjsec]
    rw [hrfix (secN y) hsecZ]
    exact hjsec y
  · refine ⟨⟨fun q ↦ ⟨j (G (secN q.2, q.1)), hGM _⟩, ?_⟩, fun y ↦ ?_, fun y ↦ ?_⟩
    · exact (hj.continuous.comp (G.continuous.comp
        ((secN.continuous.comp continuous_snd).prodMk continuous_fst))).subtype_mk _
    · change j (G (secN y, 0)) = y
      rw [hG0]
      exact hjsec y
    · change j (G (secN y, 1)) = j (r (secN y))
      rw [hG1]

end TubeDeformation

section RealizationInputs

/-- The underlying space of a compact scheme separated and locally of finite type over `ℂ` has
a closed imbedding in some `ℝᴺ`. -/
private theorem exists_isClosedEmbedding_euclideanSpace' (X : Scheme.{0}) [X.Over (Spec (.of ℂ))]
    [LocallyOfFiniteType (X ↘ Spec (.of ℂ))] [IsSeparated (X ↘ Spec (.of ℂ))]
    [CompactSpace X] :
    ∃ (N : ℕ) (F : UnderlyingSpace ℂ X → EuclideanSpace ℝ (Fin N)), IsClosedEmbedding F := by
  haveI : QuasiCompact (X ↘ Spec (.of ℂ)) := inferInstance
  haveI : T2Space (UnderlyingSpace ℂ X) := t2Space_of_isSeparated X
  have hV : ∀ x : X, ∃ V : X.Opens, IsAffineOpen V ∧ x ∈ V := fun x ↦ by
    obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    exact ⟨V, hV, hxV⟩
  choose V hVa hxV using hV
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x ↦ (V x : Set X))
    (fun x ↦ (V x).2) (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hxV x⟩)
  letI (x : X) : (V x).toScheme.Over (Spec (.of ℂ)) := ⟨(V x).ι ≫ X ↘ Spec (.of ℂ)⟩
  haveI (x : X) : (V x).ι.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
  haveI (x : X) : IsAffine (V x) := hVa x
  haveI (x : X) : LocallyOfFiniteType ((V x).toScheme ↘ Spec (.of ℂ)) := by
    change LocallyOfFiniteType ((V x).ι ≫ X ↘ Spec (.of ℂ))
    infer_instance
  choose n m f φ using fun x : X ↦ exists_homeomorph_zeroLocus (V x)
  let U : t → Set (UnderlyingSpace ℂ X) := fun x ↦ Set.range (map (K := ℂ) (V x.1).ι)
  let g : ∀ x : t, U x → (Fin (n x.1) → ℂ) := fun x ↦
    Subtype.val ∘ (φ x.1).some ∘
      (isOpenEmbedding_map_of_isOpenImmersion (K := ℂ) (V x.1).ι).isEmbedding.toHomeomorph.symm
  have hg : ∀ x, IsClosedEmbedding (g x) := fun x ↦
    (isClosed_zeroLocus (f x.1)).isClosedEmbedding_subtypeVal.comp
      ((φ x.1).some.isClosedEmbedding.comp (Homeomorph.isClosedEmbedding _))
  have hcov : ⋃ x, U x = Set.univ := by
    refine Set.eq_univ_of_forall fun p ↦ ?_
    obtain ⟨x, hx, hpx⟩ :=
      Set.mem_iUnion₂.mp (ht (Set.mem_univ (p.toHom (IsLocalRing.closedPoint ℂ))))
    exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, mem_range_map_ι (V x) p hpx⟩
  obtain ⟨F, hF⟩ := exists_isClosedEmbedding_of_finite_cover U
    (fun x ↦ (isOpenEmbedding_map_of_isOpenImmersion (K := ℂ) (V x.1).ι).isOpen_range) hcov g hg
  let T := (t → ℝ) × (∀ x : t, Fin (n x.1) → ℂ)
  let e : T ≃L[ℝ] EuclideanSpace ℝ (Fin (Module.finrank ℝ T)) :=
    ContinuousLinearEquiv.ofFinrankEq (finrank_euclideanSpace_fin).symm
  exact ⟨_, e ∘ F, e.toHomeomorph.isClosedEmbedding.comp hF⟩

/-- A compact subset of the underlying space of a scheme separated and locally of finite type
over `ℂ` lies in the image of an open imbedding of a space with a closed imbedding in some
`ℝᴺ`: the underlying space of a quasi-compact open subscheme. -/
private theorem exists_isOpenEmbedding_of_isCompact (X : Scheme.{0}) [X.Over (Spec (.of ℂ))]
    [LocallyOfFiniteType (X ↘ Spec (.of ℂ))] [IsSeparated (X ↘ Spec (.of ℂ))]
    {K : Set (UnderlyingSpace ℂ X)} (hK : IsCompact K) :
    ∃ (T : Type) (_ : TopologicalSpace T) (j : T → UnderlyingSpace ℂ X) (N : ℕ)
      (E : T → EuclideanSpace ℝ (Fin N)), IsOpenEmbedding j ∧ K ⊆ Set.range j ∧
        IsClosedEmbedding E := by
  have hV : ∀ p : UnderlyingSpace ℂ X, ∃ V : X.Opens, IsAffineOpen V ∧
      p.toHom (IsLocalRing.closedPoint ℂ) ∈ V := fun p ↦ by
    obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := p.toHom (IsLocalRing.closedPoint ℂ)) (U := ⊤) trivial
    exact ⟨V, hV, hxV⟩
  choose V hVa hpV using hV
  have hopen : ∀ p : UnderlyingSpace ℂ X, IsOpen {q : UnderlyingSpace ℂ X |
      q.toHom (IsLocalRing.closedPoint ℂ) ∈ V p} := fun p ↦ by
    letI : (V p).toScheme.Over (Spec (.of ℂ)) := ⟨(V p).ι ≫ X ↘ Spec (.of ℂ)⟩
    haveI : (V p).ι.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
    convert (isOpenEmbedding_map_of_isOpenImmersion (K := ℂ) (V p).ι).isOpen_range using 1
    ext q
    refine ⟨fun hq ↦ mem_range_map_ι (V p) q hq, ?_⟩
    rintro ⟨r, rfl⟩
    change (V p).ι (r.toHom (IsLocalRing.closedPoint ℂ)) ∈ V p
    exact (Scheme.Opens.ι_apply (V p) _).symm ▸ Subtype.prop _
  obtain ⟨s, hsK, hs⟩ := hK.elim_nhds_subcover (fun p ↦ {q : UnderlyingSpace ℂ X |
      q.toHom (IsLocalRing.closedPoint ℂ) ∈ V p}) (fun p _ ↦ (hopen p).mem_nhds (hpV p))
  let U : X.Opens := ⨆ p ∈ s, V p
  have hUc : IsCompact (U : Set X) := by
    rw [show (U : Set X) = ⋃ p ∈ s, (V p : Set X) by simp [U]]
    exact s.isCompact_biUnion fun p _ ↦ (hVa p).isCompact
  haveI : CompactSpace U := isCompact_iff_compactSpace.mp hUc
  letI : U.toScheme.Over (Spec (.of ℂ)) := ⟨U.ι ≫ X ↘ Spec (.of ℂ)⟩
  haveI : U.ι.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
  haveI : LocallyOfFiniteType (U.toScheme ↘ Spec (.of ℂ)) := by
    change LocallyOfFiniteType (U.ι ≫ X ↘ Spec (.of ℂ))
    infer_instance
  haveI : IsSeparated (U.toScheme ↘ Spec (.of ℂ)) := by
    change IsSeparated (U.ι ≫ X ↘ Spec (.of ℂ))
    infer_instance
  obtain ⟨N, E, hE⟩ := exists_isClosedEmbedding_euclideanSpace' U
  refine ⟨UnderlyingSpace ℂ U, inferInstance, map (K := ℂ) U.ι, N, E,
    isOpenEmbedding_map_of_isOpenImmersion _, fun q hq ↦ ?_, hE⟩
  obtain ⟨p, hp, hqp⟩ := Set.mem_iUnion₂.mp (hs hq)
  exact mem_range_map_ι U q <| (show V p ≤ U from le_iSup₂_of_le p hp le_rfl) hqp

/-- The realization of a morphism of schemes over `ℂ`, read on Fulton's underlying spaces. -/
theorem analyticMap_eq_mapFun {X Y : Scheme.{0}} (sY : Y ⟶ Spec (.of ℂ)) (g : X ⟶ Y) :
    letI : X.Over (Spec (.of ℂ)) := ⟨g ≫ sY⟩
    letI : Y.Over (Spec (.of ℂ)) := ⟨sY⟩
    haveI : g.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
    ((analyticMap g (sY := sY) rfl : analyticSpace (g ≫ sY) → analyticSpace sY)) =
      (homeomorphUnderlyingSpace (X := Y)).symm ∘ mapFun (K := ℂ) g ∘
        homeomorphUnderlyingSpace (X := X) := by
  letI : X.Over (Spec (.of ℂ)) := ⟨g ≫ sY⟩
  letI : Y.Over (Spec (.of ℂ)) := ⟨sY⟩
  haveI : g.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
  funext x
  apply (homeomorphUnderlyingSpace (X := Y)).injective
  refine UnderlyingSpace.ext ?_
  simp only [Function.comp_apply, Homeomorph.apply_symm_apply]
  rfl

/-- The realization of a proper morphism to a scheme locally of finite type over `ℂ` is
proper. -/
theorem isProperMap_analyticMap {X B : Scheme.{0}} (f : X ⟶ B) (sB : B ⟶ Spec (.of ℂ))
    [IsProper f] [LocallyOfFiniteType sB] :
    IsProperMap (analyticMap f (sY := sB) rfl) := by
  letI : X.Over (Spec (.of ℂ)) := ⟨f ≫ sB⟩
  letI : B.Over (Spec (.of ℂ)) := ⟨sB⟩
  haveI : f.IsOver (Spec (.of ℂ)) := ⟨rfl⟩
  haveI : LocallyOfFiniteType (B ↘ Spec (.of ℂ)) := ‹LocallyOfFiniteType sB›
  have h := (homeomorphUnderlyingSpace (X := B)).symm.isProperMap.comp
    ((isProperMap_map (K := ℂ) f).comp (homeomorphUnderlyingSpace (X := X)).isProperMap)
  rwa [analyticMap_eq_mapFun sB f]

/-- The complex realization of a scheme separated over `ℂ` is Hausdorff. -/
theorem t2Space_analyticSpace {B : Scheme.{0}} (sB : B ⟶ Spec (.of ℂ)) [IsSeparated sB] :
    T2Space (analyticSpace sB) := by
  letI : B.Over (Spec (.of ℂ)) := ⟨sB⟩
  haveI : IsSeparated (B ↘ Spec (.of ℂ)) := ‹IsSeparated sB›
  haveI := t2Space_of_isSeparated (K := ℂ) B
  exact (homeomorphUnderlyingSpace (X := B)).isEmbedding.t2Space

/-- The complex realization of a scheme locally of finite type over `ℂ` has bases of open
contractible neighbourhoods. -/
theorem hasOpenContractibleBasis_analyticSpace {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] : HasOpenContractibleBasis (analyticSpace sX) := by
  letI : X.Over (Spec (.of ℂ)) := ⟨sX⟩
  haveI : LocallyOfFiniteType (X ↘ Spec (.of ℂ)) := ‹LocallyOfFiniteType sX›
  exact (UnderlyingSpace.hasOpenContractibleBasis X).of_homeomorph
    (homeomorphUnderlyingSpace (X := X)).symm

end RealizationInputs

/-! ### Change of coefficients and the fibre comparison -/

section FibreComparison

/-- The change of coefficients `H^n(-; ℤ) ⟶ H^n(-; ℚ)` commutes with pullbacks. -/
theorem mapCoeff_rationalCohomologyMap {Y' Y : TopCat.{0}} (g : Y' ⟶ Y) (n : ℕ)
    (x : singularCohomology ℤ Y n) :
    singularCohomology.mapCoeff (Int.castRingHom ℚ) n
      ((MMP.relativeSingularCohomology.map ℤ (ModuleCat.of ℤ ℤ) g (A' := Set.univᶜ)
        (A := Set.univᶜ) (fun _ hx ↦ (hx (Set.mem_univ _)).elim) n).hom x) =
    (rationalCohomologyMap g n).hom (singularCohomology.mapCoeff (Int.castRingHom ℚ) n x) := by
  have k : ∀ {Z : TopCat.{0}} (y : singularCohomology ℤ Z n),
      MMP.SingularCochain.relativeSingularCohomologyEquiv ℚ (Set.univᶜ : Set Z) n
        (singularCohomology.mapCoeff (Int.castRingHom ℚ) n y) =
      singularCohomology.relCohomologyMap (Int.castRingHom ℚ) Set.univᶜ n
        (MMP.SingularCochain.relativeSingularCohomologyEquiv ℤ Set.univᶜ n y) :=
    fun y => LinearEquiv.apply_symm_apply _ _
  have h₁ := MMP.SingularCochain.relativeSingularCohomologyEquiv_map (R := ℚ) g
    (A' := (Set.univᶜ : Set Y')) (A := (Set.univᶜ : Set Y))
    (fun _ hx ↦ (hx (Set.mem_univ _)).elim) n (singularCohomology.mapCoeff (Int.castRingHom ℚ) n x)
  have h₂ := MMP.SingularCochain.relativeSingularCohomologyEquiv_map (R := ℤ) g
    (A' := (Set.univᶜ : Set Y')) (A := (Set.univᶜ : Set Y))
    (fun _ hx ↦ (hx (Set.mem_univ _)).elim) n x
  apply (MMP.SingularCochain.relativeSingularCohomologyEquiv ℚ
    (Set.univᶜ : Set Y') n).injective
  refine (k _).trans (Eq.trans ?_ h₁.symm)
  refine (congrArg _ h₂).trans ?_
  rw [k x]
  generalize MMP.SingularCochain.relativeSingularCohomologyEquiv ℤ _ n x = y
  induction y using Submodule.Quotient.induction_on
  rfl

/-- A morphism `i : F_b ⟶ X` over a `ℂ`-point `b` of `B` is a morphism over `ℂ`. -/
theorem fibreIncl_w {X B Fb : Scheme.{0}} (f : X ⟶ B) (sB : B ⟶ Spec (.of ℂ))
    (b : ComplexPoints sB) (i : Fb ⟶ X) (sF : Fb ⟶ Spec (.of ℂ)) (hi : i ≫ f = sF ≫ b.hom) :
    i ≫ f ≫ sB = sF := by
  rw [← Category.assoc, hi, Category.assoc, b.hom_comp_structure, Category.comp_id]

/-- The realization of a morphism `i : F_b ⟶ X` over a `ℂ`-point `b` of `B` lands in the
fibre of `f^an` over `b`. -/
theorem analyticMap_analyticMap_fibreIncl_eq {X B Fb : Scheme.{0}} (f : X ⟶ B)
    (sB : B ⟶ Spec (.of ℂ)) (b : ComplexPoints sB) (i : Fb ⟶ X) (sF : Fb ⟶ Spec (.of ℂ))
    (hi : i ≫ f = sF ≫ b.hom) (x : analyticSpace sF) :
    analyticMap f (sY := sB) rfl (analyticMap i (fibreIncl_w f sB b i sF hi) x) = b := by
  ext1
  change (x.hom ≫ i) ≫ f = b.hom
  rw [Category.assoc, hi, ← Category.assoc, x.hom_comp_structure, Category.id_comp]

/-- The inclusion `F_b(ℂ) ⟶ f⁻¹(V)` of the realization of a scheme `F_b` over `b`, for `b ∈ V`. -/
def fibreIncl {X B Fb : Scheme.{0}} (f : X ⟶ B) (sB : B ⟶ Spec (.of ℂ))
    (b : ComplexPoints sB) (i : Fb ⟶ X) (sF : Fb ⟶ Spec (.of ℂ)) (hi : i ≫ f = sF ≫ b.hom)
    {V : Opens (analyticSpace sB)} (hV : b ∈ V) :
    analyticSpace sF ⟶ preimageSpace (analyticMap f (sY := sB) rfl) V :=
  TopCat.ofHom ⟨fun x ↦ ⟨analyticMap i (fibreIncl_w f sB b i sF hi) x, by
      rw [Set.mem_preimage, analyticMap_analyticMap_fibreIncl_eq f sB b i sF hi x]
      exact hV⟩,
    ((analyticMap i (fibreIncl_w f sB b i sF hi)).hom.continuous).subtype_mk _⟩

/-- The realization of the fibre `F_b ⟶ X` of `f` over a `ℂ`-point `b` is a topological
imbedding onto `f^an⁻¹(b)`. -/
theorem isEmbedding_analyticMap_fibre {X B Fb : Scheme.{0}} (f : X ⟶ B)
    (sB : B ⟶ Spec (.of ℂ))
    (b : ComplexPoints sB) (i : Fb ⟶ X) (sF : Fb ⟶ Spec (.of ℂ)) (H : IsPullback i sF f b.hom) :
    IsEmbedding (analyticMap i (fibreIncl_w f sB b i sF H.w)) ∧
      Set.range (analyticMap i (fibreIncl_w f sB b i sF H.w)) =
        analyticMap f (sY := sB) rfl ⁻¹' {b} := by
  letI : X.Over (Spec (.of ℂ)) := ⟨f ≫ sB⟩
  letI : Fb.Over (Spec (.of ℂ)) := ⟨sF⟩
  letI : (Spec (.of ℂ)).Over (Spec (.of ℂ)) := ⟨𝟙 _⟩
  haveI : i.IsOver (Spec (.of ℂ)) := ⟨fibreIncl_w f sB b i sF H.w⟩
  haveI : sF.IsOver (Spec (.of ℂ)) := ⟨Category.comp_id _⟩
  haveI : Unique (UnderlyingSpace ℂ (Spec (.of ℂ))) :=
    { default := ⟨𝟙 _, Category.comp_id _⟩
      uniq := fun a ↦ UnderlyingSpace.ext ((Category.comp_id _).symm.trans a.toHom_comp_over) }
  have hP := isEmbedding_prodMap_of_isPullback (K := ℂ) H
  have hi : IsEmbedding (mapFun (K := ℂ) i) :=
    (Homeomorph.prodUnique _ _).isEmbedding.comp hP
  have e : (analyticMap i (fibreIncl_w f sB b i sF H.w) : analyticSpace sF → analyticSpace (f ≫ sB))
      = (homeomorphUnderlyingSpace (X := X)).symm ∘ mapFun (K := ℂ) i ∘
        homeomorphUnderlyingSpace (X := Fb) := by
    funext x
    apply (homeomorphUnderlyingSpace (X := X)).injective
    refine UnderlyingSpace.ext ?_
    simp only [Function.comp_apply, Homeomorph.apply_symm_apply]
    rfl
  refine ⟨?_, ?_⟩
  · rw [e]
    exact (homeomorphUnderlyingSpace (X := X)).symm.isEmbedding.comp
      (hi.comp (homeomorphUnderlyingSpace (X := Fb)).isEmbedding)
  · ext x
    refine ⟨?_, fun hx ↦ ?_⟩
    · rintro ⟨y, rfl⟩
      exact analyticMap_analyticMap_fibreIncl_eq f sB b i sF H.w y
    · have hx' : x.hom ≫ f = (𝟙 _) ≫ b.hom := by
        rw [Category.id_comp]
        exact congrArg ComplexPoints.hom hx
      refine ⟨⟨H.lift x.hom (𝟙 _) hx', H.lift_snd _ _ _⟩, ?_⟩
      ext1
      exact H.lift_fst _ _ _

/-- **The fibre comparison for proper morphisms.** Let `f : X ⟶ B` be a proper morphism of
schemes, with `B` separated and locally of finite type over `ℂ`, let `b ∈ B(ℂ)` and let `F_b` be
the fibre of `f` over `b`. Then the restriction maps `H^q(f^an⁻¹(V); ℚ) ⟶ H^q(F_b(ℂ); ℚ)`,
`V` running over the open neighbourhoods of `b` in `B(ℂ)`, induce a bijection from their colimit:
every class on `F_b(ℂ)` extends to some `f^an⁻¹(V)`, and a class on `f^an⁻¹(V)` vanishing on
`F_b(ℂ)` vanishes on `f^an⁻¹(W)` for some smaller neighbourhood `W` of `b`. -/
theorem fibre_comparison {X B Fb : Scheme.{0}} (f : X ⟶ B) (sB : B ⟶ Spec (.of ℂ))
    [IsProper f] [LocallyOfFiniteType sB] [IsSeparated sB]
    (b : ComplexPoints sB) (i : Fb ⟶ X) (sF : Fb ⟶ Spec (.of ℂ)) (H : IsPullback i sF f b.hom)
    (q : ℕ) :
    (∀ x : rationalCohomology (analyticSpace sF) q,
      ∃ (V : Opens (analyticSpace sB)) (hV : b ∈ V)
        (α : rationalCohomology (preimageSpace (analyticMap f (sY := sB) rfl) V) q),
        (rationalCohomologyMap (fibreIncl f sB b i sF H.w hV) q).hom α = x) ∧
    (∀ (V : Opens (analyticSpace sB)) (hV : b ∈ V)
      (α : rationalCohomology (preimageSpace (analyticMap f (sY := sB) rfl) V) q),
      (rationalCohomologyMap (fibreIncl f sB b i sF H.w hV) q).hom α = 0 →
      ∃ (W : Opens (analyticSpace sB)) (hWV : W ≤ V), b ∈ W ∧
        (rationalCohomologyMap (preimageInclusion _ hWV) q).hom α = 0) := by
  set p := analyticMap f (sY := sB) rfl with hpdef
  obtain ⟨hemb, hrange⟩ := isEmbedding_analyticMap_fibre f sB b i sF H
  let ψ : analyticSpace sF ≃ₜ (p ⁻¹' {b}) :=
    hemb.toHomeomorph.trans (Homeomorph.setCongr hrange)
  have hψ : ∀ y, ((ψ y : p ⁻¹' {b}) : analyticSpace (f ≫ sB)) =
      analyticMap i (fibreIncl_w f sB b i sF H.w) y := fun _ ↦ rfl
  have hprop := isProperMap_analyticMap f sB
  haveI := t2Space_analyticSpace sB
  haveI : LocallyOfFiniteType sF := MorphismProperty.of_isPullback H
    (inferInstance : LocallyOfFiniteType f)
  have hZ : HasOpenContractibleBasis (p ⁻¹' {b}) :=
    (hasOpenContractibleBasis_analyticSpace sF).of_homeomorph ψ
  have hY := hasOpenContractibleBasis_analyticSpace (f ≫ sB)
  letI : X.Over (Spec (.of ℂ)) := ⟨f ≫ sB⟩
  haveI : LocallyOfFiniteType (X ↘ Spec (.of ℂ)) := inferInstanceAs (LocallyOfFiniteType (f ≫ sB))
  haveI : IsSeparated (X ↘ Spec (.of ℂ)) := inferInstanceAs (IsSeparated (f ≫ sB))
  let hX := homeomorphUnderlyingSpace (X := X)
  obtain ⟨T, _, j, n, E, hj, hKj, hE⟩ := exists_isOpenEmbedding_of_isCompact X
    ((hprop.isCompact_preimage isCompact_singleton).image hX.continuous)
  have hj' : IsOpenEmbedding (hX.symm ∘ j) := hX.symm.isOpenEmbedding.comp hj
  have hKj' : p ⁻¹' {b} ⊆ Set.range (hX.symm ∘ j) := fun y hy ↦ by
    obtain ⟨t, ht⟩ := hKj ⟨y, hy, rfl⟩
    exact ⟨t, (congrArg hX.symm ht).trans (hX.symm_apply_apply y)⟩
  have tube := fun (V : Set (analyticSpace sB)) (hV : IsOpen V) (hbV : b ∈ V) ↦
    exists_tube_deformation (p := p) p.hom.continuous hprop.isClosedMap isClosed_singleton hj'
      hKj' hE hY hZ hV hbV
  -- the retraction, read on `F_b(ℂ)`
  have retr : ∀ {W : Set (analyticSpace sB)} (ρ : C(p ⁻¹' W, p ⁻¹' {b})),
      (∀ y : p ⁻¹' W, p y = b → (ρ y : analyticSpace (f ≫ sB)) = y) →
      ∀ (hWo : IsOpen W) (hbW : b ∈ W),
        fibreIncl f sB b i sF H.w (V := ⟨W, hWo⟩) hbW ≫
          TopCat.ofHom ⟨fun y ↦ ψ.symm (ρ y), ψ.symm.continuous.comp ρ.continuous⟩ = 𝟙 _ := by
    intro W ρ hρ hWo hbW
    refine TopCat.ext fun y ↦ ?_
    change ψ.symm (ρ _) = y
    rw [Homeomorph.symm_apply_eq]
    apply Subtype.ext
    rw [hρ _ (analyticMap_analyticMap_fibreIncl_eq f sB b i sF H.w y), hψ]
    rfl
  refine ⟨fun x ↦ ?_, fun V hV α hα ↦ ?_⟩
  · obtain ⟨W, hWo, hbW, -, ρ, hρ, -⟩ := tube Set.univ isOpen_univ (Set.mem_univ _)
    refine ⟨⟨W, hWo⟩, hbW, (rationalCohomologyMap (TopCat.ofHom
      ⟨fun y ↦ ψ.symm (ρ y), ψ.symm.continuous.comp ρ.continuous⟩) q).hom x, ?_⟩
    rw [← ModuleCat.comp_apply, ← rationalCohomologyMap_comp, retr ρ hρ hWo hbW,
      rationalCohomologyMap_id]
    rfl
  · obtain ⟨W, hWo, hbW, hWV, ρ, hρ, G, hG0, hG1⟩ := tube V V.isOpen hV
    let r : preimageSpace p ⟨W, hWo⟩ ⟶ analyticSpace sF :=
      TopCat.ofHom ⟨fun y ↦ ψ.symm (ρ y), ψ.symm.continuous.comp ρ.continuous⟩
    have hWV' : (⟨W, hWo⟩ : Opens (analyticSpace sB)) ≤ V := hWV
    let Hh : TopCat.Homotopy (preimageInclusion p hWV') (r ≫ fibreIncl f sB b i sF H.w hV) :=
      { toContinuousMap := G
        map_zero_left := fun y ↦ Subtype.ext (hG0 y)
        map_one_left := fun y ↦ Subtype.ext ((hG1 y).trans (by
          change _ = analyticMap i (fibreIncl_w f sB b i sF H.w) (ψ.symm (ρ y))
          rw [← hψ, Homeomorph.apply_symm_apply])) }
    have hmap : rationalCohomologyMap (preimageInclusion p hWV') q =
        rationalCohomologyMap (r ≫ fibreIncl f sB b i sF H.w hV) q :=
      MMP.relativeSingularCohomology.map_eq_of_homotopy ℚ Hh
        (fun y hy ↦ absurd (Set.mem_univ y) hy) _ _ q
    refine ⟨⟨W, hWo⟩, hWV', hbW, ?_⟩
    rw [hmap, rationalCohomologyMap_comp, ModuleCat.comp_apply, hα, map_zero]

/-- The inclusion `p⁻¹(b) ⟶ p⁻¹(V)` of a fibre of a continuous map into a tube, for `b ∈ V`. -/
abbrev fibreInclusion {X B : TopCat.{0}} (p : X ⟶ B) {b : B} {V : Opens B} (hb : b ∈ V) :
    TopCat.of (p ⁻¹' {b}) ⟶ preimageSpace p V :=
  TopCat.ofHom ⟨Set.inclusion (Set.preimage_mono (Set.singleton_subset_iff.2 hb)),
    continuous_inclusion _⟩

/-- **The stalk of a higher direct image at a taut fibre.** If every class on the fibre
`p⁻¹(b)` extends to a tube `p⁻¹(V)`, and every class on a tube vanishing on `p⁻¹(b)` vanishes
on a smaller tube, then restriction to the fibre induces an isomorphism
`(R^q p_* ℚ)_b ≅ H^q(p⁻¹(b); ℚ)`, compatibly with germs. -/
theorem exists_stalk_higherDirectImage_iso_of_taut {X B : TopCat.{0}} (p : X ⟶ B) (b : B) (q : ℕ)
    (hsurj : ∀ x : rationalCohomology (TopCat.of (p ⁻¹' {b})) q,
      ∃ (V : Opens B) (hV : b ∈ V) (α : rationalCohomology (preimageSpace p V) q),
        (rationalCohomologyMap (fibreInclusion p hV) q).hom α = x)
    (hker : ∀ (V : Opens B) (hV : b ∈ V) (α : rationalCohomology (preimageSpace p V) q),
      (rationalCohomologyMap (fibreInclusion p hV) q).hom α = 0 →
      ∃ (W : Opens B) (hWV : W ≤ V), b ∈ W ∧
        (rationalCohomologyMap (preimageInclusion p hWV) q).hom α = 0) :
    ∃ e : ((TopCat.Sheaf.forget _ _).obj (higherDirectImage p q)).stalk b ≅
        rationalCohomology (TopCat.of (p ⁻¹' {b})) q,
      ∀ (V : Opens B) (hb : b ∈ V),
        higherDirectImageGerm p q b hb ≫ e.hom = rationalCohomologyMap (fibreInclusion p hb) q := by
  set P := directImagePresheaf p q
  let d : P.stalk b ⟶ rationalCohomology (TopCat.of (p ⁻¹' {b})) q :=
    colimit.desc ((OpenNhds.inclusion b).op ⋙ P)
      { pt := _
        ι :=
          { app := fun U ↦ rationalCohomologyMap (fibreInclusion p U.unop.2) q
            naturality := fun U U' i ↦ (rationalCohomologyMap_comp
              (fibreInclusion p U'.unop.2) (preimageInclusion p i.unop.le) q).symm.trans
                (Category.comp_id _).symm } }
  have hd : ∀ (V : Opens B) (hb : b ∈ V), P.germ V b hb ≫ d =
      rationalCohomologyMap (fibreInclusion p hb) q := fun V hb ↦
    colimit.ι_desc _ _
  have hd' : ∀ (V : Opens B) (hb : b ∈ V) α, d.hom (P.germ V b hb α) =
      (rationalCohomologyMap (fibreInclusion p hb) q).hom α := fun V hb α ↦ by
    rw [← hd V hb]
    rfl
  have hdi : IsIso d := by
    refine (ConcreteCategory.isIso_iff_bijective d).2 ⟨?_, fun x ↦ ?_⟩
    · rw [← LinearMap.ker_eq_bot (f := d.hom), LinearMap.ker_eq_bot']
      intro s hs
      obtain ⟨V, hV, α, rfl⟩ := P.exists_germ_eq s
      obtain ⟨W, hWV, hW, h0⟩ := hker V hV α ((hd' V hV α).symm.trans hs)
      rw [← P.germ_res_apply (homOfLE hWV) b hW α]
      exact (congrArg (P.germ W b hW).hom h0).trans (map_zero _)
    · obtain ⟨V, hV, α, rfl⟩ := hsurj x
      exact ⟨_, hd' V hV α⟩
  let η : P.stalk b ⟶ ((TopCat.Sheaf.forget _ _).obj (higherDirectImage p q)).stalk b :=
    (TopCat.Presheaf.stalkFunctor _ b).map (toSheafify _ P)
  have hη : IsIso η :=
    TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso b (ModuleCat.{0} ℚ) P
  refine ⟨(@asIso _ _ _ _ η hη).symm ≪≫ @asIso _ _ _ _ d hdi, fun V hb ↦ ?_⟩
  have hg : higherDirectImageGerm p q b hb = P.germ V b hb ≫ η := rfl
  rw [hg, Iso.trans_hom, Iso.symm_hom, asIso_inv, asIso_hom]
  exact (Category.assoc _ _ _).trans ((congrArg (P.germ V b hb ≫ ·)
    (IsIso.hom_inv_id_assoc η d)).trans (hd V hb))

/-- **The stalk of a higher direct image of a proper morphism.** Let `f : X ⟶ B` be a proper
morphism of schemes, with `B` separated and locally of finite type over `ℂ`, and `b ∈ B(ℂ)`.
Restriction to the fibre `f^an⁻¹(b)` induces an isomorphism
`(R^q f^an_* ℚ)_b ≅ H^q(f^an⁻¹(b); ℚ)` sending the germ of a class on `f^an⁻¹(V)` to its
restriction. -/
theorem exists_stalk_higherDirectImage_iso {X B : Scheme.{0}} (f : X ⟶ B)
    (sB : B ⟶ Spec (.of ℂ)) [IsProper f] [LocallyOfFiniteType sB] [IsSeparated sB]
    (b : analyticSpace sB) (q : ℕ) :
    ∃ e : ((TopCat.Sheaf.forget _ _).obj
          (higherDirectImage (analyticMap f (sY := sB) rfl) q)).stalk b ≅
        rationalCohomology (TopCat.of (analyticMap f (sY := sB) rfl ⁻¹' {b})) q,
      ∀ (V : Opens (analyticSpace sB)) (hb : b ∈ V),
        higherDirectImageGerm (analyticMap f (sY := sB) rfl) q b hb ≫ e.hom =
          rationalCohomologyMap (fibreInclusion (analyticMap f (sY := sB) rfl) hb) q := by
  set p := analyticMap f (sY := sB) rfl
  have H := IsPullback.of_hasPullback f b.hom
  obtain ⟨hemb, hrange⟩ := isEmbedding_analyticMap_fibre f sB b _ _ H
  let ψ := hemb.toHomeomorph.trans (Homeomorph.setCongr hrange)
  let ψf : analyticSpace (pullback.snd f b.hom) ⟶ TopCat.of (p ⁻¹' {b}) :=
    TopCat.ofHom ⟨ψ, ψ.continuous⟩
  let ψi : TopCat.of (p ⁻¹' {b}) ⟶ analyticSpace (pullback.snd f b.hom) :=
    TopCat.ofHom ⟨ψ.symm, ψ.symm.continuous⟩
  have hψ : ψi ≫ ψf = 𝟙 _ := TopCat.ext ψ.apply_symm_apply
  have hi : ∀ {V : Opens (analyticSpace sB)} (hV : b ∈ V),
      fibreIncl f sB b _ _ H.w hV = ψf ≫ fibreInclusion p hV := fun _ ↦
    TopCat.ext fun _ ↦ rfl
  have hc := fibre_comparison f sB b _ _ H q
  refine exists_stalk_higherDirectImage_iso_of_taut p b q (fun x ↦ ?_)
    (fun V hV α hα ↦ hc.2 V hV α ?_)
  · obtain ⟨V, hV, α, hα⟩ := hc.1 ((rationalCohomologyMap ψf q).hom x)
    refine ⟨V, hV, α, ?_⟩
    rw [← Category.id_comp (fibreInclusion p hV), ← hψ, Category.assoc, ← hi,
      rationalCohomologyMap_comp, ModuleCat.comp_apply, hα, ← ModuleCat.comp_apply,
      ← rationalCohomologyMap_comp, hψ, rationalCohomologyMap_id]
    rfl
  · rw [hi, rationalCohomologyMap_comp, ModuleCat.comp_apply, hα, map_zero]

/-- **Fibres of a projective morphism have finite-dimensional rational cohomology.** For a
projective morphism `f : X ⟶ B` of schemes over `ℂ` and `b ∈ B(ℂ)`, every `H^q(f^an⁻¹(b); ℚ)` is
finite-dimensional. -/
theorem finiteDimensional_rationalCohomology_preimage_singleton {X B : Scheme.{0}} (f : X ⟶ B)
    (sB : B ⟶ Spec (.of ℂ)) (hf : IsProjectiveMorphism f) (b : analyticSpace sB) (q : ℕ) :
    FiniteDimensional ℚ
      (rationalCohomology (TopCat.of (analyticMap f (sY := sB) rfl ⁻¹' {b})) q) := by
  set p := analyticMap f (sY := sB) rfl
  obtain ⟨hemb, hrange⟩ :=
    isEmbedding_analyticMap_fibre f sB b _ _ (IsPullback.of_hasPullback f b.hom)
  let ψ := hemb.toHomeomorph.trans (Homeomorph.setCongr hrange)
  obtain ⟨-, hfin, hbc⟩ :=
    MMP.Analytic.exists_homotopyEquiv_singularChainComplex_of_isProjectiveMorphism _
      (hf.baseChange b.hom)
  have := hfin q
  have : FiniteDimensional ℚ (rationalCohomology (analyticSpace (pullback.snd f b.hom)) q) :=
    Module.Finite.equiv (hbc q).equiv
  let ψf : analyticSpace (pullback.snd f b.hom) ⟶ TopCat.of (p ⁻¹' {b}) :=
    TopCat.ofHom ⟨ψ, ψ.continuous⟩
  let ψi : TopCat.of (p ⁻¹' {b}) ⟶ analyticSpace (pullback.snd f b.hom) :=
    TopCat.ofHom ⟨ψ.symm, ψ.symm.continuous⟩
  have hψ : ψi ≫ ψf = 𝟙 _ := TopCat.ext ψ.apply_symm_apply
  refine Module.Finite.of_surjective (rationalCohomologyMap ψi q).hom fun x ↦
    ⟨(rationalCohomologyMap ψf q).hom x, ?_⟩
  rw [← ModuleCat.comp_apply, ← rationalCohomologyMap_comp, hψ, rationalCohomologyMap_id]
  rfl

end FibreComparison

/-! ### The sheet classes form a flat family over the cover -/

section SheetFamily

variable {Y Yt : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)} {T : IrreducibleCloseds Y}
  {To : (curveScheme T).Opens} {T' : Scheme.{0}} {φ : T' ⟶ (To : Scheme.{0})}

/-- The point `φ(u') ∈ T°(ℂ)` under a point `u' ∈ T'(ℂ)`. -/
private abbrev coverPt (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    ComplexPoints (To.ι ≫ curveι T ≫ sY) :=
  analyticMap φ (sY := To.ι ≫ curveι T ≫ sY) rfl u'

/-- The sheet `F_{φ(u')} × {u'} ⟶ 𝓕' = 𝓕 ×_{T°} T'` through a point `u' ∈ T'(ℂ)`. -/
private abbrev sheetAt (π : Yt ⟶ Y) (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    pointFibre sY π To (coverPt u') ⟶ pullback (pullback.snd π (To.ι ≫ curveι T)) φ :=
  sheetι (t := coverPt u') ⟨u', rfl⟩

private theorem sheetAt_fst_fst (π : Yt ⟶ Y) (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    sheetAt π u' ≫ pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T) =
      pointFibreFst sY π To (coverPt u') := by
  rw [← Category.assoc, sheetι_comp_fst]
  exact (pullback.lift_fst _ _ _).trans (Category.comp_id _)

private theorem sheetAt_snd (π : Yt ⟶ Y) (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    sheetAt π u' ≫ pullback.snd _ φ = pointFibreSnd sY π To (coverPt u') ≫ u'.hom :=
  pullback.lift_snd _ _ _

private theorem fam_comm (π : Yt ⟶ Y) :
    (pullback.fst (pullback.snd π (To.ι ≫ curveι T)) φ ≫ pullback.fst π (To.ι ≫ curveι T)) ≫ π =
      pullback.snd _ φ ≫ φ ≫ To.ι ≫ curveι T := by
  rw [Category.assoc, pullback.condition, ← Category.assoc, pullback.condition, Category.assoc]

/-- The fibre `F_{φ(u')}` is the fibre of `𝓕' ⟶ T'` over `u'`, through the sheet at `u'`. -/
private theorem isPullback_sheetAt (π : Yt ⟶ Y) (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    IsPullback (sheetAt π u') (pointFibreSnd sY π To (coverPt u'))
      (pullback.snd (pullback.snd π (To.ι ≫ curveι T)) φ) u'.hom := by
  have t := (IsPullback.of_hasPullback (pullback.snd π (To.ι ≫ curveι T)) φ).paste_horiz
    (IsPullback.of_hasPullback π (To.ι ≫ curveι T))
  have e2 : (coverPt u').hom ≫ To.ι ≫ curveι T = u'.hom ≫ φ ≫ To.ι ≫ curveι T :=
    Category.assoc _ _ _
  have s : IsPullback (sheetAt π u' ≫ pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T))
      (pointFibreSnd sY π To (coverPt u')) π (u'.hom ≫ φ ≫ To.ι ≫ curveι T) := by
    rw [sheetAt_fst_fst, ← e2]
    exact IsPullback.of_hasPullback _ _
  exact s.of_right (sheetAt_snd π u') t

private theorem sheetAt_w (π : Yt ⟶ Y) (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    sheetAt π u' ≫ pullback.snd (pullback.snd π (To.ι ≫ curveι T)) φ ≫
      φ ≫ To.ι ≫ curveι T ≫ sY = pointFibreSnd sY π To (coverPt u') :=
  fibreIncl_w _ _ u' _ _ (isPullback_sheetAt π u').w

/-- The class `c₁(𝓛') ∈ H²(𝓕'(ℂ); ℚ)`. -/
private def famClass (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0}))
    (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Modules)
    [SheafOfModules.IsInvertible (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).ringCatSheaf.2 L'] :
    rationalCohomology (analyticSpace (pullback.snd (pullback.snd π (To.ι ≫ curveι T)) φ ≫
      φ ≫ To.ι ≫ curveι T ≫ sY)) 2 :=
  letI : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Over (Spec (.of ℂ)) :=
    ⟨pullback.snd _ φ ≫ φ ≫ To.ι ≫ curveι T ≫ sY⟩
  singularCohomology.mapCoeff (Int.castRingHom ℚ) 2 (algebraicFirstChernClass L')

/-- The class of `𝓛'` restricts on each sheet to the class of the restriction of `𝓛'`. -/
private theorem rationalCohomologyMap_famClass (π : Yt ⟶ Y)
    (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Modules)
    [SheafOfModules.IsInvertible (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).ringCatSheaf.2 L']
    (u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    (rationalCohomologyMap (analyticMap (sheetAt π u') (sheetAt_w π u')) 2).hom
        (famClass π φ L') =
      pointFibreChernClass sY π To (coverPt u')
        ((Scheme.Modules.pullback (sheetAt π u')).obj L') := by
  letI : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Over (Spec (.of ℂ)) :=
    ⟨pullback.snd _ φ ≫ φ ≫ To.ι ≫ curveι T ≫ sY⟩
  unfold pointFibreChernClass
  rw [algebraicFirstChernClass_pullback (sheetAt π u')
    (analyticMap (sheetAt π u') (sheetAt_w π u')) (fun _ => rfl) L']
  exact (mapCoeff_rationalCohomologyMap _ 2 _).symm

/-- The germ in `𝒲_u` of a class on `π⁻¹(V)`, for `V ∋ u`. -/
private abbrev germOf (π : Yt ⟶ Y) (u : ComplexPoints (To.ι ≫ curveι T ≫ sY))
    {V : Opens (analyticSpace sY)} (hV : curveOpenInclusion sY To u ∈ V)
    (α : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V) 2) :
    resolutionLocalSystemFibre sY π To u :=
  (stalkToPullbackStalk (curveOpenInclusion sY To) (resolutionHigherDirectImage sY π 2) u).hom
    ((higherDirectImageGerm (resolutionAnalyticMap sY π) 2 _ hV).hom α)

/-- The germ of a class is the germ of the section of `𝒲` it defines. -/
private theorem germOf_eq_germ (π : Yt ⟶ Y) {V : Opens (analyticSpace sY)}
    (α : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V) 2)
    (u : ComplexPoints (To.ι ≫ curveι T ≫ sY)) (hV : curveOpenInclusion sY To u ∈ V) :
    germOf π u hV α = ((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).germ
      ((Opens.map (curveOpenInclusion sY To)).obj V) u hV
      (unitSec (curveOpenInclusion sY To) (resolutionHigherDirectImage sY π 2)
        (((CategoryTheory.toSheafify _ (directImagePresheaf (resolutionAnalyticMap sY π) 2)).app
          (op V)).hom α)) := by
  have h1 : (higherDirectImageGerm (resolutionAnalyticMap sY π) 2 _ hV).hom α =
      ((TopCat.Sheaf.forget _ _).obj (resolutionHigherDirectImage sY π 2)).germ V _ hV
        (((CategoryTheory.toSheafify _
          (directImagePresheaf (resolutionAnalyticMap sY π) 2)).app (op V)).hom α) :=
    TopCat.Presheaf.stalkFunctor_map_germ_apply
      (F := directImagePresheaf (resolutionAnalyticMap sY π) 2) V _ hV
      (CategoryTheory.toSheafify _ (directImagePresheaf (resolutionAnalyticMap sY π) 2)) α
  exact (congrArg (stalkToPullbackStalk (curveOpenInclusion sY To)
    (resolutionHigherDirectImage sY π 2) u).hom h1).trans
    (stalkToPullbackStalk_germ (curveOpenInclusion sY To)
    (resolutionHigherDirectImage sY π 2) (((CategoryTheory.toSheafify _
      (directImagePresheaf (resolutionAnalyticMap sY π) 2)).app (op V)).hom α) u hV)

/-- The family `𝓕' = 𝓕 ×_{T°} T' ⟶ T'`. -/
private abbrev famMap (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0})) :
    pullback (pullback.snd π (To.ι ≫ curveι T)) φ ⟶ T' :=
  pullback.snd (pullback.snd π (To.ι ≫ curveι T)) φ

/-- The inverse image in `T'(ℂ)` of an open `V ⊆ Y(ℂ)`. -/
private abbrev coverOpen (φ : T' ⟶ (To : Scheme.{0})) (V : Opens (analyticSpace sY)) :
    Opens (analyticSpace (φ ≫ To.ι ≫ curveι T ≫ sY)) :=
  (Opens.map (analyticMap φ (sY := To.ι ≫ curveι T ≫ sY) rfl ≫ curveOpenInclusion sY To)).obj V

private theorem famToRes_w (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0})) :
    (pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T)) ≫ π ≫ sY =
      famMap π φ ≫ φ ≫ To.ι ≫ curveι T ≫ sY := by
  rw [← Category.assoc _ π sY, fam_comm]
  simp only [Category.assoc]

/-- The realization `𝓕'(ℂ) ⟶ Ỹ(ℂ)` of `𝓕' ⟶ Ỹ`. -/
private abbrev famToResolution (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0})) :
    analyticSpace (famMap π φ ≫ φ ≫ To.ι ≫ curveι T ≫ sY) ⟶ analyticSpace (π ≫ sY) :=
  analyticMap (pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T)) (famToRes_w π φ)

private theorem famToResolution_mem (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0}))
    (V : Opens (analyticSpace sY))
    (x : preimageSpace (analyticMap (famMap π φ) (sY := φ ≫ To.ι ≫ curveι T ≫ sY) rfl)
      (coverOpen φ V)) :
    famToResolution π φ x.1 ∈ resolutionAnalyticMap sY π ⁻¹' (V : Set (analyticSpace sY)) := by
  have e : resolutionAnalyticMap sY π (famToResolution π φ x.1) =
      curveOpenInclusion sY To (analyticMap φ (sY := To.ι ≫ curveι T ≫ sY) rfl
        (analyticMap (famMap π φ) (sY := φ ≫ To.ι ≫ curveι T ≫ sY) rfl x.1)) := by
    ext1
    change (x.1.hom ≫ (pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T))) ≫ π =
      ((x.1.hom ≫ famMap π φ) ≫ φ) ≫ To.ι ≫ curveι T
    rw [Category.assoc, fam_comm]
    simp only [Category.assoc]
  rw [Set.mem_preimage, e]
  exact x.2

/-- The map `𝓕'(ℂ) ⊇ f'⁻¹(O) ⟶ π⁻¹(V)` induced by `𝓕' ⟶ Ỹ`, `O` the inverse image of `V`. -/
private def famToRes (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0})) (V : Opens (analyticSpace sY)) :
    preimageSpace (analyticMap (famMap π φ) (sY := φ ≫ To.ι ≫ curveι T ≫ sY) rfl)
      (coverOpen φ V) ⟶ preimageSpace (resolutionAnalyticMap sY π) V :=
  TopCat.ofHom ⟨fun x => ⟨famToResolution π φ x.1, famToResolution_mem π φ V x⟩,
    ((famToResolution π φ).hom.continuous.comp continuous_subtype_val).subtype_mk _⟩

/-- The inclusion `f'⁻¹(O) ⟶ 𝓕'(ℂ)`. -/
private def famIncl (π : Yt ⟶ Y) (φ : T' ⟶ (To : Scheme.{0})) (V : Opens (analyticSpace sY)) :
    preimageSpace (analyticMap (famMap π φ) (sY := φ ≫ To.ι ≫ curveι T ≫ sY) rfl)
      (coverOpen φ V) ⟶ analyticSpace (famMap π φ ≫ φ ≫ To.ι ≫ curveι T ≫ sY) :=
  TopCat.ofHom ⟨Subtype.val, continuous_subtype_val⟩

/-- **Local flatness of the sheet classes.** Near every point `u₀ ∈ T'(ℂ)` the classes of the
restrictions of `𝓛'` to the sheets are the restrictions of one class on a neighbourhood of the
fibre in `Ỹ(ℂ)`: a class realizing the sheet class at `u₀` (proper base change for `π`) and the
class of `𝓛'` agree on `F_{u₀}`, hence (proper base change for `𝓕' ⟶ T'`) on the part of `𝓕'` over
a neighbourhood of `u₀`. -/
private theorem exists_local_class (π : Yt ⟶ Y) [IsProper π] [LocallyOfFiniteType sY]
    [IsSeparated sY] [IsProper (famMap π φ)]
    [LocallyOfFiniteType (φ ≫ To.ι ≫ curveι T ≫ sY)] [IsSeparated (φ ≫ To.ι ≫ curveι T ≫ sY)]
    (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Modules)
    [SheafOfModules.IsInvertible (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).ringCatSheaf.2 L']
    (u₀ : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)) :
    ∃ (V : Opens (analyticSpace sY))
      (β : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V) 2)
      (N : Opens (analyticSpace (φ ≫ To.ι ≫ curveι T ≫ sY))) (hN : N ≤ coverOpen φ V), u₀ ∈ N ∧
      ∀ u' (hu' : u' ∈ N), (rationalCohomologyMap (pointFibreInclusion sY π To (coverPt u')
          (hN hu')) 2).hom β =
        pointFibreChernClass sY π To (coverPt u')
          ((Scheme.Modules.pullback (sheetAt π u')).obj L') := by
  obtain ⟨V, hV, β, hβ⟩ := (fibre_comparison π sY (curveOpenInclusion sY To (coverPt u₀))
    (pointFibreFst sY π To (coverPt u₀)) (pointFibreSnd sY π To (coverPt u₀))
    (IsPullback.of_hasPullback _ _) 2).1
    (pointFibreChernClass sY π To (coverPt u₀) ((Scheme.Modules.pullback (sheetAt π u₀)).obj L'))
  have hu₀ : u₀ ∈ coverOpen φ V := hV
  let δ := (rationalCohomologyMap (famToRes π φ V) 2).hom β -
    (rationalCohomologyMap (famIncl π φ V) 2).hom (famClass π φ L')
  have key : ∀ u' (hu' : u' ∈ coverOpen φ V),
      (rationalCohomologyMap (fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
        (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w hu')
          2).hom δ =
      (rationalCohomologyMap (pointFibreInclusion sY π To (coverPt u') hu') 2).hom β -
        pointFibreChernClass sY π To (coverPt u')
          ((Scheme.Modules.pullback (sheetAt π u')).obj L') := by
    intro u' hu'
    have e1 : fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
        (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w hu' ≫
          famToRes π φ V = pointFibreInclusion sY π To (coverPt u') hu' := by
      ext x
      change x.hom ≫ sheetAt π u' ≫ pullback.fst _ φ ≫ pullback.fst π (To.ι ≫ curveι T) =
        x.hom ≫ pointFibreFst sY π To (coverPt u')
      rw [sheetAt_fst_fst]
    have e2 : fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
        (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w hu' ≫
          famIncl π φ V = analyticMap (sheetAt π u') (sheetAt_w π u') := rfl
    have k1 := congrArg (fun m => (rationalCohomologyMap m 2).hom β) e1
    have k2 := congrArg (fun m => (rationalCohomologyMap m 2).hom (famClass π φ L')) e2
    simp only [rationalCohomologyMap_comp, ModuleCat.comp_apply] at k2
    rw [rationalCohomologyMap_famClass] at k2
    refine (map_sub _ _ _).trans (congrArg₂ (· - ·) ?_ k2)
    refine Eq.trans ?_ k1
    exact (congrArg (fun m : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V) 2 ⟶
        rationalCohomology (analyticSpace (pointFibreSnd sY π To (coverPt u'))) 2 => m.hom β)
      (rationalCohomologyMap_comp (fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
        (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w hu')
        (famToRes π φ V) 2)).symm
  obtain ⟨W, hWV, hW0, hz⟩ := (fibre_comparison (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u₀
    (sheetAt π u₀) (pointFibreSnd sY π To (coverPt u₀)) (isPullback_sheetAt π u₀) 2).2
      (coverOpen φ V) hu₀ δ ((key u₀ hu₀).trans (sub_eq_zero.2 hβ))
  refine ⟨V, β, W, hWV, hW0, fun u' hu' => ?_⟩
  have e3 : fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
      (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w (hWV hu') =
      fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
        (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w hu' ≫
          preimageInclusion _ hWV := rfl
  have hz' : (rationalCohomologyMap (fibreIncl (famMap π φ) (φ ≫ To.ι ≫ curveι T ≫ sY) u'
      (sheetAt π u') (pointFibreSnd sY π To (coverPt u')) (isPullback_sheetAt π u').w
        (hWV hu')) 2).hom δ = 0 := by
    rw [e3, rationalCohomologyMap_comp, ModuleCat.comp_apply, hz, map_zero]
  exact sub_eq_zero.1 ((key u' (hWV hu')).symm.trans hz')

/-- **The flat family of sheet classes.** The germs in `𝒲` realizing the classes of `𝓛'` on the
sheets through the points of `T'(ℂ)` form a family along `T'(ℂ) ⟶ T°(ℂ)` which is locally given by
sections of `𝒲`. -/
private theorem exists_flat_family (π : Yt ⟶ Y) [IsProper π] [LocallyOfFiniteType sY]
    [IsSeparated sY] [IsProper (famMap π φ)]
    [LocallyOfFiniteType (φ ≫ To.ι ≫ curveι T ≫ sY)] [IsSeparated (φ ≫ To.ι ≫ curveι T ≫ sY)]
    (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Modules)
    [SheafOfModules.IsInvertible (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).ringCatSheaf.2 L'] :
    ∃ Ef : ∀ u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY),
        resolutionLocalSystemFibre sY π To (coverPt u'),
      (∀ u', IsRealized (sY := sY) (π := π) (To := To) (t := coverPt u')
        (pointFibreChernClass sY π To (coverPt u')
          ((Scheme.Modules.pullback (sheetAt π u')).obj L')) (Ef u')) ∧
      ∀ e₀, ∃ (W : Opens (analyticSpace (To.ι ≫ curveι T ≫ sY)))
        (r : ToType (((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).obj (op W)))
        (N : Opens (analyticSpace (φ ≫ To.ι ≫ curveι T ≫ sY))) (_ : e₀ ∈ N)
        (hNW : N ≤ (Opens.map (analyticMap φ (sY := To.ι ≫ curveι T ≫ sY) rfl)).obj W),
        ∀ e (he : e ∈ N), Ef e =
          ((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).germ W
            (analyticMap φ (sY := To.ι ≫ curveι T ≫ sY) rfl e) (hNW he) r := by
  have hex : ∀ u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY), ∃ y,
      IsRealized (sY := sY) (π := π) (To := To) (t := coverPt u')
        (pointFibreChernClass sY π To (coverPt u')
          ((Scheme.Modules.pullback (sheetAt π u')).obj L')) y := by
    intro u'
    obtain ⟨V, hV, α, hα⟩ := (fibre_comparison π sY (curveOpenInclusion sY To (coverPt u'))
      (pointFibreFst sY π To (coverPt u')) (pointFibreSnd sY π To (coverPt u'))
      (IsPullback.of_hasPullback _ _) 2).1 (pointFibreChernClass sY π To (coverPt u')
        ((Scheme.Modules.pullback (sheetAt π u')).obj L'))
    exact ⟨_, V, hV, α, hα, rfl⟩
  choose Ef hEf using hex
  refine ⟨Ef, hEf, fun e₀ => ?_⟩
  obtain ⟨V, β, N, hN, he₀, hloc⟩ := exists_local_class π L' e₀
  refine ⟨(Opens.map (curveOpenInclusion sY To)).obj V,
    unitSec (curveOpenInclusion sY To) (resolutionHigherDirectImage sY π 2)
      (((CategoryTheory.toSheafify _ (directImagePresheaf (resolutionAnalyticMap sY π) 2)).app
        (op V)).hom β), N, he₀, hN, fun e he => ?_⟩
  exact ((hEf e).unique ⟨V, hN he, β, hloc e he, rfl⟩).trans (germOf_eq_germ π β _ (hN he))

private theorem isRealized_transport {π : Yt ⟶ Y}
    (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).Modules)
    [SheafOfModules.IsInvertible (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) φ).ringCatSheaf.2 L']
    {u' : ComplexPoints (φ ≫ To.ι ≫ curveι T ≫ sY)}
    {y : resolutionLocalSystemFibre sY π To (coverPt u')}
    (hy : IsRealized (sY := sY) (π := π) (To := To) (t := coverPt u')
      (pointFibreChernClass sY π To (coverPt u')
        ((Scheme.Modules.pullback (sheetAt π u')).obj L')) y)
    {t : ComplexPoints (To.ι ≫ curveι T ≫ sY)} (h : coverPt u' = t) (h' : u'.hom ≫ φ = t.hom) :
    IsRealized (sY := sY) (π := π) (To := To) (t := t)
      (pointFibreChernClass sY π To t ((Scheme.Modules.pullback (sheetι (π := π) ⟨u', h'⟩)).obj L'))
      ((((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).stalkCongr
        (.of_eq h)).hom.hom y) := by
  subst h
  rwa [stalkCongr_self]

private theorem stalkCongr_congr_point {Z E : TopCat.{0}} (F : TopCat.Sheaf (ModuleCat.{0} ℚ) Z)
    (p : E ⟶ Z) (Ef : ∀ e : E, ToType (((TopCat.Sheaf.forget _ Z).obj F).stalk (p e)))
    {e₁ e₂ : E} (he : e₁ = e₂) {t : Z} (h₁ : p e₁ = t) (h₂ : p e₂ = t) :
    (((TopCat.Sheaf.forget _ Z).obj F).stalkCongr (.of_eq h₁)).hom.hom (Ef e₁) =
      (((TopCat.Sheaf.forget _ Z).obj F).stalkCongr (.of_eq h₂)).hom.hom (Ef e₂) := by
  subst he
  rfl

end SheetFamily

/-! ### A finite étale multisection, algebraically -/

section Multisection

open TensorProduct in
/-- **A closed point of the generic fibre.** For an injective finite-type algebra `R ⟶ B` over a
domain `R`, a maximal ideal of `K ⊗_R B`, `K = Frac R`, contracts to a prime `P` of `B` such
that `R ⟶ B/P` is injective and `B/P` is algebraic over `R`: its residue field is finite over
`K` (Zariski's lemma). -/
private theorem exists_isPrime_isAlgebraic_quotient {R B : Type} [CommRing R] [IsDomain R]
    [CommRing B] [Algebra R B] [Algebra.FiniteType R B]
    (hinj : Function.Injective (algebraMap R B)) :
    ∃ P : Ideal B, P.IsPrime ∧ Function.Injective (algebraMap R (B ⧸ P)) ∧
      Algebra.IsAlgebraic R (B ⧸ P) := by
  classical
  let K := FractionRing R
  -- `K ⊗_R B` is nonzero, `K` being flat over `R`
  have hinjK : Function.Injective (LinearMap.lTensor K (Algebra.linearMap R B)) :=
    Module.Flat.lTensor_preserves_injective_linearMap _ hinj
  haveI : Nontrivial (K ⊗[R] B) := by
    refine ⟨⟨1, 0, fun h => ?_⟩⟩
    have h1 : LinearMap.lTensor K (Algebra.linearMap R B) ((1 : K) ⊗ₜ[R] (1 : R)) = 1 := by
      simp [Algebra.TensorProduct.one_def]
    have h2 : (1 : K) ⊗ₜ[R] (1 : R) = 0 := hinjK (by rw [h1, map_zero, h])
    have h3 := congrArg (TensorProduct.rid R K) h2
    simp at h3
  obtain ⟨𝔫, h𝔫⟩ := Ideal.exists_maximal (K ⊗[R] B)
  set L := (K ⊗[R] B) ⧸ 𝔫
  letI : Field L := Ideal.Quotient.field 𝔫
  haveI : Algebra.FiniteType K (K ⊗[R] B) := Algebra.FiniteType.baseChange K
  haveI : Algebra.FiniteType K L :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K 𝔫) Ideal.Quotient.mk_surjective
  haveI : Module.Finite K L := finite_of_finite_type_of_isJacobsonRing K _
  haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
  let ρ : B →ₐ[R] L :=
    ((Ideal.Quotient.mkₐ K 𝔫).restrictScalars R).comp Algebra.TensorProduct.includeRight
  haveI : (RingHom.ker ρ).IsPrime := RingHom.ker_isPrime _
  refine ⟨RingHom.ker ρ, inferInstance, ?_, ?_⟩
  · intro r r' hrr'
    have e := congrArg (Ideal.kerLiftAlg ρ) hrr'
    simp only [AlgHom.commutes] at e
    rw [IsScalarTower.algebraMap_apply R K, IsScalarTower.algebraMap_apply R K _ r'] at e
    exact IsFractionRing.injective R K ((algebraMap K _).injective e)
  · refine ⟨fun a => ?_⟩
    have h := Algebra.IsAlgebraic.isAlgebraic (R := K) (Ideal.kerLiftAlg ρ a)
    rw [← IsFractionRing.isAlgebraic_iff R K] at h
    exact (isAlgebraic_algHom_iff (Ideal.kerLiftAlg ρ) (Ideal.kerLiftAlg_injective ρ)).1 h

/-- **Generic étaleness.** A domain `A` of finite type and algebraic over a Noetherian domain `R`
of characteristic zero, with `R ⟶ A` injective, is étale over `R` after inverting some nonzero
`f`: the fraction field of `A` is a separable algebraic extension of that of `R`, so `A` is
étale over `R` at its generic point, and the étale locus is open. -/
private theorem exists_ne_zero_etale_away {R A : Type} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [CharZero R] [CommRing A] [IsDomain A] [Algebra R A]
    [Algebra.FiniteType R A] [Algebra.IsAlgebraic R A]
    (hinj : Function.Injective (algebraMap R A)) :
    ∃ f : A, f ≠ 0 ∧ Algebra.Etale R (Localization.Away f) := by
  classical
  let K := FractionRing R
  let L := FractionRing A
  haveI : FaithfulSMul R L :=
    (faithfulSMul_iff_algebraMap_injective R L).2 (by
      rw [IsScalarTower.algebraMap_eq R A L]
      exact (IsFractionRing.injective A L).comp hinj)
  letI : Algebra K L := FractionRing.liftAlgebra R L
  haveI : IsScalarTower R K L := FractionRing.isScalarTower_liftAlgebra R L
  haveI : Algebra.IsAlgebraic A L := IsLocalization.isAlgebraic L (nonZeroDivisors A)
  haveI : Algebra.IsAlgebraic R L := Algebra.IsAlgebraic.trans R A L
  haveI : Algebra.IsAlgebraic K L :=
    ⟨fun x => (IsFractionRing.isAlgebraic_iff R K L).1 (Algebra.IsAlgebraic.isAlgebraic x)⟩
  haveI : CharZero K := IsFractionRing.charZero R
  haveI : Algebra.IsSeparable K L := Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : Algebra.FormallyEtale K L := Algebra.FormallyEtale.of_isSeparable K L
  haveI : Algebra.FormallyEtale R K := Algebra.FormallyEtale.of_isLocalization (nonZeroDivisors R)
  haveI : Algebra.FormallyEtale R L := Algebra.FormallyEtale.comp R K L
  have hM : (⊥ : Ideal A).primeCompl = nonZeroDivisors A := by
    ext x
    simp [Ideal.primeCompl, mem_nonZeroDivisors_iff_ne_zero]
  haveI : IsLocalization (⊥ : Ideal A).primeCompl L := by
    rw [hM]
    infer_instance
  haveI : Algebra.IsEtaleAt R (⊥ : Ideal A) :=
    Algebra.FormallyEtale.of_equiv
      ((IsLocalization.algEquiv (⊥ : Ideal A).primeCompl L
        (Localization.AtPrime (⊥ : Ideal A))).restrictScalars R)
  haveI : Algebra.FinitePresentation R A :=
    Algebra.FinitePresentation.of_finiteType.1 inferInstance
  exact Algebra.exists_etale_of_isEtaleAt (R := R) (⊥ : Ideal A)

/-- **Generic finiteness.** A domain `A` étale, of finite type and algebraic over a Noetherian
domain `R` becomes finite étale over `R_d` after inverting a single nonzero `d ∈ R`: a common
denominator of integral multiples of the generators of `A`. -/
private theorem exists_finite_etale_away {R A : Type} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [CommRing A] [IsDomain A] [Algebra R A] [Algebra.FiniteType R A]
    [Algebra.IsAlgebraic R A] [Algebra.Etale R A] :
    ∃ d : R, d ≠ 0 ∧
      (IsLocalization.Away.map (Localization.Away d) (Localization.Away (algebraMap R A d))
        (algebraMap R A) d).Finite ∧
      (IsLocalization.Away.map (Localization.Away d) (Localization.Away (algebraMap R A d))
        (algebraMap R A) d).Etale := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := R) (A := A)
  choose y hy hint using fun x : A =>
    (Algebra.IsAlgebraic.isAlgebraic (R := R) x).exists_integral_multiple
  let d : R := ∏ x ∈ s, y x
  have hd : d ≠ 0 := Finset.prod_ne_zero_iff.2 fun x _ => hy x
  refine ⟨d, hd, ?_⟩
  set Rd := Localization.Away d
  set B' := Localization.Away (algebraMap R A d)
  set ψ := IsLocalization.Away.map Rd B' (algebraMap R A) d
  letI : Algebra Rd B' := ψ.toAlgebra
  have hψ : ψ.comp (algebraMap R Rd) = algebraMap R B' := by
    rw [IsScalarTower.algebraMap_eq R A B']
    exact IsLocalization.map_comp _
  haveI : IsScalarTower R Rd B' := IsScalarTower.of_algebraMap_eq' hψ.symm
  have hunit : ∀ x ∈ s, IsUnit (algebraMap R Rd (y x)) := fun x hx => by
    have h : IsUnit (algebraMap R Rd (∏ x ∈ s, y x)) := IsLocalization.Away.algebraMap_isUnit d
    rw [← Finset.mul_prod_erase s y hx, map_mul] at h
    exact isUnit_of_mul_isUnit_left h
  have hgen : ∀ x ∈ s, IsIntegral Rd (algebraMap A B' x) := fun x hx => by
    obtain ⟨u, hu⟩ := hunit x hx
    have h1 : IsIntegral Rd (algebraMap A B' (y x • x)) :=
      ((hint x).map (IsScalarTower.toAlgHom R A B')).tower_top
    have h2 : algebraMap A B' x =
        algebraMap A B' (y x • x) * algebraMap Rd B' (↑u⁻¹ : Rd) := by
      rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply R Rd B', ← hu, mul_comm (algebraMap Rd B' ↑u), mul_assoc,
        ← map_mul, Units.mul_inv, map_one, mul_one]
    rw [h2]
    exact h1.mul isIntegral_algebraMap
  have key : ∀ a : A, IsIntegral Rd (algebraMap A B' a) := fun a => by
    have ha : a ∈ Algebra.adjoin R (s : Set A) := hs ▸ trivial
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact hgen x hx
    | algebraMap r =>
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply R Rd B']
      exact isIntegral_algebraMap
    | add a b _ _ ha hb =>
      rw [map_add]
      exact ha.add hb
    | mul a b _ _ ha hb =>
      rw [map_mul]
      exact ha.mul hb
  haveI : Algebra.IsIntegral Rd B' := ⟨fun b => by
    obtain ⟨⟨a, m⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Submonoid.powers (algebraMap R A d)) b
    obtain ⟨n, hn⟩ := Submonoid.mem_powers_iff _ _ |>.1 m.2
    obtain ⟨v, hv⟩ : IsUnit (algebraMap R Rd (d ^ n)) := by
      rw [map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit d).pow n
    have hv' : algebraMap A B' (m : A) = algebraMap Rd B' ↑v := by
      rw [hv, ← hn, ← map_pow, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    have e : IsLocalization.mk' B' a m = algebraMap A B' a * algebraMap Rd B' ↑v⁻¹ := by
      rw [← IsLocalization.mk'_spec B' a m, hv', mul_assoc, ← map_mul, Units.mul_inv, map_one,
        mul_one]
    change IsIntegral Rd (IsLocalization.mk' B' a m)
    rw [e]
    exact (key a).mul isIntegral_algebraMap⟩
  haveI : Algebra.FiniteType R B' :=
    Algebra.FiniteType.trans (S := A) inferInstance
      (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers (algebraMap R A d)) B')
  haveI : Algebra.FiniteType Rd B' := Algebra.FiniteType.of_restrictScalars_finiteType R Rd B'
  haveI : Module.Finite Rd B' := Algebra.IsIntegral.finite
  haveI : Algebra.Etale A B' := Algebra.Etale.of_isLocalizationAway (algebraMap R A d)
  haveI : Algebra.Etale R B' := Algebra.Etale.comp R A B'
  haveI : Algebra.FormallyEtale R Rd :=
    Algebra.FormallyEtale.of_isLocalization (Submonoid.powers d)
  haveI : Algebra.FormallyEtale Rd B' := Algebra.FormallyEtale.of_restrictScalars (R := R)
  haveI : IsNoetherianRing Rd :=
    IsLocalization.isNoetherianRing (Submonoid.powers d) Rd inferInstance
  haveI : Algebra.FinitePresentation Rd B' :=
    Algebra.FinitePresentation.of_finiteType.1 inferInstance
  haveI : Algebra.Etale Rd B' := ⟨inferInstance, inferInstance⟩
  exact ⟨RingHom.finite_algebraMap.2 inferInstance, RingHom.etale_algebraMap.2 inferInstance⟩

/-- **A finite étale quotient over a localization.** For an injective finite-type algebra
`R ⟶ B` over a Noetherian domain of characteristic zero, there are `d ≠ 0` in `R` and a domain
`B'` under `B` which is finite étale over `R_d`, compatibly with `R ⟶ B`. -/
private theorem exists_finite_etale_of_injective {R B : Type} [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [CharZero R] [CommRing B] [Algebra R B] [Algebra.FiniteType R B]
    (hinj : Function.Injective (algebraMap R B)) :
    ∃ (d : R) (B' : Type) (_ : CommRing B') (_ : IsDomain B')
      (ψ : Localization.Away d →+* B') (q : B →+* B'),
      d ≠ 0 ∧ ψ.Finite ∧ ψ.Etale ∧
        ψ.comp (algebraMap R (Localization.Away d)) = q.comp (algebraMap R B) := by
  classical
  obtain ⟨P, hP, hinjA, halg⟩ := exists_isPrime_isAlgebraic_quotient hinj
  set A := B ⧸ P
  haveI : Algebra.FiniteType R A :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R P) Ideal.Quotient.mk_surjective
  obtain ⟨f, hf, hfe⟩ := exists_ne_zero_etale_away hinjA
  set A₁ := Localization.Away f
  have hle := powers_le_nonZeroDivisors_of_noZeroDivisors hf
  haveI : IsDomain A₁ := IsLocalization.isDomain_localization hle
  haveI : Algebra.FiniteType R A₁ :=
    Algebra.FiniteType.trans (S := A) inferInstance
      (IsLocalization.finiteType_of_monoid_fg (Submonoid.powers f) A₁)
  haveI : Algebra.IsAlgebraic A A₁ := IsLocalization.isAlgebraic A₁ (Submonoid.powers f)
  haveI : Algebra.IsAlgebraic R A₁ := Algebra.IsAlgebraic.trans R A A₁
  have hinj₁ : Function.Injective (algebraMap R A₁) := by
    rw [IsScalarTower.algebraMap_eq R A A₁]
    exact (IsLocalization.injective A₁ hle).comp hinjA
  obtain ⟨d, hd, hfin, het⟩ := exists_finite_etale_away (R := R) (A := A₁)
  have hd₁ : algebraMap R A₁ d ≠ 0 := fun h => hd (hinj₁ (h.trans (map_zero _).symm))
  haveI : IsDomain (Localization.Away (algebraMap R A₁ d)) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hd₁)
  refine ⟨d, Localization.Away (algebraMap R A₁ d), inferInstance, inferInstance, _,
    (algebraMap A₁ _).comp ((algebraMap A A₁).comp (Ideal.Quotient.mk P)), hd, hfin, het, ?_⟩
  ext r
  simp only [RingHom.comp_apply]
  rw [IsLocalization.Away.map, IsLocalization.map_eq, IsScalarTower.algebraMap_apply R A A₁]
  rfl

/-- A morphism `Spec B ⟶ Spec ℂ` locally of finite type, `B` nonzero, has a section. -/
private lemma exists_section_of_locallyOfFiniteType {B : Type} [CommRing B] [Nontrivial B]
    (σ : Spec (.of B) ⟶ Spec (.of ℂ)) [LocallyOfFiniteType σ] :
    ∃ t : Spec (.of ℂ) ⟶ Spec (.of B), t ≫ σ = 𝟙 _ := by
  set j : CommRingCat.of ℂ ⟶ CommRingCat.of B := Spec.preimage σ
  have hj : Spec.map j = σ := Spec.map_preimage σ
  have hjf : j.hom.FiniteType := by
    rw [← HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType), hj]
    infer_instance
  letI : Algebra ℂ B := j.hom.toAlgebra
  haveI : Algebra.FiniteType ℂ B := hjf
  obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal B
  letI : Field (B ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  haveI : Algebra.FiniteType ℂ (B ⧸ 𝔪) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℂ 𝔪) Ideal.Quotient.mk_surjective
  haveI : Module.Finite ℂ (B ⧸ 𝔪) := finite_of_finite_type_of_isJacobsonRing ℂ _
  let eκ := RingEquiv.ofBijective (algebraMap ℂ (B ⧸ 𝔪))
    (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := ℂ) (K := B ⧸ 𝔪))
  refine ⟨Spec.map (CommRingCat.ofHom (eκ.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪))), ?_⟩
  rw [← hj, ← Spec.map_comp, ← Spec.map_id]
  congr 1
  ext c
  change eκ.symm (Ideal.Quotient.mk 𝔪 (j.hom c)) = c
  exact eκ.symm_apply_apply c

/-- A complex point `μ` of `N` in an affine chart `U`, and a generization `ζ` of it, give a point
`ζ'` of `Spec Γ(N, U)` over `ζ` and a character `χ : Γ(N, U) ⟶ ℂ` inducing `μ` and vanishing on
the prime of `ζ'`. -/
private lemma exists_character_of_specializes {N : Scheme.{0}} {U : N.Opens} (hU : IsAffineOpen U)
    (μ : Spec (.of ℂ) ⟶ N) (hmU : μ (IsLocalRing.closedPoint ℂ) ∈ U) (ζ : N)
    (hζ : ζ ⤳ μ (IsLocalRing.closedPoint ℂ)) :
    ∃ (ζ' : Spec Γ(N, U)) (χ : Γ(N, U) ⟶ CommRingCat.of ℂ), hU.fromSpec ζ' = ζ ∧
      Spec.map χ ≫ hU.fromSpec = μ ∧ ∀ c ∈ (ζ' : PrimeSpectrum Γ(N, U)).asIdeal, χ.hom c = 0 := by
  obtain ⟨ζ', hζ'⟩ : ζ ∈ Set.range hU.fromSpec := hU.range_fromSpec ▸ hζ.mem_open U.isOpen hmU
  have hrange : Set.range μ ⊆ Set.range hU.fromSpec := by
    rw [hU.range_fromSpec]
    rintro _ ⟨x, rfl⟩
    rwa [Subsingleton.elim x (IsLocalRing.closedPoint ℂ)]
  set μU := IsOpenImmersion.lift hU.fromSpec μ hrange
  have hμU : μU ≫ hU.fromSpec = μ := IsOpenImmersion.lift_fac _ _ _
  set χ : Γ(N, U) ⟶ CommRingCat.of ℂ := Spec.preimage μU
  have hχ : Spec.map χ = μU := Spec.map_preimage μU
  set m' := μU (IsLocalRing.closedPoint ℂ)
  have hm' : hU.fromSpec m' = μ (IsLocalRing.closedPoint ℂ) := by
    change (μU ≫ hU.fromSpec) _ = _
    rw [hμU]
  have hspec : ζ' ⤳ m' := by
    rw [← hU.fromSpec.isOpenEmbedding.toIsInducing.specializes_iff, hζ', hm']
    exact hζ
  refine ⟨ζ', χ, hζ', hχ ▸ hμU, fun c hc => ?_⟩
  have h1 := (PrimeSpectrum.le_iff_specializes (R := Γ(N, U)) ζ' m').2 hspec
  have h2 : c ∈ (m' : PrimeSpectrum Γ(N, U)).asIdeal :=
    (show (ζ' : PrimeSpectrum Γ(N, U)).asIdeal ≤ (m' : PrimeSpectrum Γ(N, U)).asIdeal from h1) hc
  have h3 : m' = Spec.map χ (IsLocalRing.closedPoint ℂ) := by rw [hχ]
  rw [h3] at h2
  change c ∈ (PrimeSpectrum.comap χ.hom (IsLocalRing.closedPoint ℂ)).asIdeal at h2
  rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at h2
  simpa [IsLocalRing.closedPoint] using h2

/-- **A finite étale multisection through a dominating point.** Let `g : N ⟶ S` be locally of
finite type, `S` integral and locally of finite type over `ℂ`, `μ` a complex point of `N` and
`ζ` a point of `N` specializing to `μ` with `g ζ` the generic point of `S`. Then there are an
integral affine scheme `W ⟶ N` through `μ` (the closure of `ζ` in an affine chart), a dense open
`T₁ ⊆ S`, a connected finite étale `φ : T' ⟶ T₁` with a complex point, and a morphism
`T' ⟶ W` over `S`. -/
private theorem exists_finiteEtale_multisection {S N : Scheme.{0}} (sS : S ⟶ Spec (.of ℂ))
    [IsIntegral S] [LocallyOfFiniteType sS] (g : N ⟶ S) [LocallyOfFiniteType g]
    (μ : Spec (.of ℂ) ⟶ N) (ζ : N) (hζ : ζ ⤳ μ (IsLocalRing.closedPoint ℂ))
    (hgζ : g ζ = genericPoint S) :
    ∃ (W : Scheme.{0}) (w : W ⟶ N) (_ : IsAffine W) (_ : IsIntegral W)
      (_ : LocallyOfFiniteType w) (μW : Spec (.of ℂ) ⟶ W) (_ : μW ≫ w = μ)
      (T₁ : S.Opens) (_ : Dense (T₁ : Set S)) (T' : Scheme.{0}) (φ : T' ⟶ (T₁ : Scheme.{0}))
      (_ : IsFinite φ) (_ : Etale φ) (_ : ConnectedSpace T') (ψ : T' ⟶ W)
      (_ : ψ ≫ w ≫ g = φ ≫ T₁.ι) (t' : Spec (.of ℂ) ⟶ T'), t' ≫ φ ≫ T₁.ι ≫ sS = 𝟙 _ := by
  classical
  set m := μ (IsLocalRing.closedPoint ℂ)
  -- affine charts `U ∋ m` and `V ∋ g m` with `g(U) ⊆ V`
  obtain ⟨V, hV, hmV, -⟩ := exists_isAffineOpen_mem_and_subset (x := g m) (U := ⊤) trivial
  obtain ⟨U, hU, hmU, hUV⟩ := exists_isAffineOpen_mem_and_subset (x := m) (U := g ⁻¹ᵁ V) hmV
  have hUV' : U ≤ g ⁻¹ᵁ V := hUV
  haveI : Nonempty V := ⟨⟨g m, hmV⟩⟩
  set R := Γ(S, V)
  set C := Γ(N, U)
  set φC : R ⟶ C := g.appLE V U hUV'
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS
  haveI : IsNoetherianRing R := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  have hfC : φC.hom.FiniteType :=
    HasRingHomProperty.appLE (P := @LocallyOfFiniteType) g inferInstance ⟨V, hV⟩ ⟨U, hU⟩ hUV'
  let e : ℂ →+* R := (S.presheaf.map (homOfLE le_top).op).hom.comp
    (sS.appTop.hom.comp (Scheme.ΓSpecIso (.of ℂ)).inv.hom)
  haveI : CharZero R := charZero_of_injective_ringHom e.injective
  obtain ⟨ζ', χ, hζ', hχμ, hle⟩ := exists_character_of_specializes hU μ hmU ζ hζ
  set P₀ : Ideal C := (ζ' : PrimeSpectrum C).asIdeal
  -- `R ⟶ C/𝔭_ζ` is injective, `ζ` lying over the generic point
  have hgen : Spec.map φC ζ' = genericPoint (Spec R) := by
    have h1 : hV.fromSpec (Spec.map φC ζ') = g ζ := by
      rw [← hζ', ← Scheme.Hom.comp_apply, IsAffineOpen.SpecMap_appLE_fromSpec,
        Scheme.Hom.comp_apply]
    have h2 : hV.fromSpec (genericPoint (Spec R)) = genericPoint S :=
      genericPoint_eq_of_isOpenImmersion _
    exact hV.fromSpec.isOpenEmbedding.injective (h1.trans (hgζ.trans h2.symm))
  haveI : P₀.IsPrime := (ζ' : PrimeSpectrum C).isPrime
  letI : Algebra R (C ⧸ P₀) := ((Ideal.Quotient.mk P₀).comp φC.hom).toAlgebra
  have hinj : Function.Injective (algebraMap R (C ⧸ P₀)) := by
    rw [RingHom.injective_iff_ker_eq_bot]
    change RingHom.ker ((Ideal.Quotient.mk P₀).comp φC.hom) = ⊥
    rw [← RingHom.comap_ker, Ideal.mk_ker]
    have := congrArg (fun x : Spec R => (x : PrimeSpectrum R).asIdeal) hgen
    simp only at this
    rwa [genericPoint_eq_bot_of_affine] at this
  haveI : Algebra.FiniteType R (C ⧸ P₀) :=
    RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hfC
  obtain ⟨d, B', _, _, ψ, q, hd, hfin, het, hcomp⟩ :=
    exists_finite_etale_of_injective (R := R) (B := C ⧸ P₀) hinj
  -- the integral affine scheme `W = Spec (C/𝔭_ζ)` through `μ`
  let w : Spec (.of (C ⧸ P₀)) ⟶ N :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P₀)) ≫ hU.fromSpec
  let χ' : C ⧸ P₀ →+* ℂ := Ideal.Quotient.lift P₀ χ.hom hle
  have hμW : Spec.map (CommRingCat.ofHom χ') ≫ w = μ := by
    rw [← hχμ, ← Spec.map_comp_assoc]
    congr 2
  haveI : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk P₀))) :=
    HasRingHomProperty.Spec_iff.2 (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
  -- the dense open `T₁ = D(d)` and the cover `T' = Spec B'`
  set T₁ := S.basicOpen (d : Γ(S, V))
  have hT₁ : IsAffineOpen T₁ := hV.basicOpen d
  haveI := hV.isLocalization_basicOpen d
  let ε : Γ(S, T₁) ≃ₐ[R] Localization.Away (d : R) :=
    IsLocalization.algEquiv (Submonoid.powers d) _ _
  let εi : CommRingCat.of Γ(S, T₁) ≅ CommRingCat.of (Localization.Away (d : R)) :=
    ε.toRingEquiv.toCommRingCatIso
  let φ : Spec (.of B') ⟶ (T₁ : Scheme.{0}) :=
    Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map εi.hom ≫ hT₁.isoSpec.inv
  haveI : IsFinite (Spec.map (CommRingCat.ofHom ψ)) := IsFinite.SpecMap_iff _ |>.2 hfin
  haveI : Etale (Spec.map (CommRingCat.ofHom ψ)) := HasRingHomProperty.Spec_iff.2 het
  have hφ : φ ≫ T₁.ι = Spec.map (CommRingCat.ofHom q) ≫ w ≫ g := by
    simp only [φ, w, Category.assoc, IsAffineOpen.isoSpec_inv_ι]
    rw [← hV.map_fromSpec hT₁ (homOfLE (S.basicOpen_le d)).op,
      ← IsAffineOpen.SpecMap_appLE_fromSpec g hV hU hUV']
    simp only [← Spec.map_comp_assoc]
    congr 2
    ext r
    have h1 := congrArg (fun f => f r) hcomp
    simp only [RingHom.comp_apply] at h1
    change ψ (ε (algebraMap R Γ(S, T₁) r)) = q (Ideal.Quotient.mk P₀ (φC.hom r))
    rwa [AlgEquiv.commutes]
  -- `T₁` is dense
  have hT₁d : Dense (T₁ : Set S) := by
    refine T₁.isOpen.dense ?_
    rwa [← Opens.ne_bot_iff_nonempty, Ne, basicOpen_eq_bot_iff]
  obtain ⟨t', ht'⟩ := exists_section_of_locallyOfFiniteType (φ ≫ T₁.ι ≫ sS)
  exact ⟨_, w, inferInstance, inferInstance, inferInstance, _, hμW, T₁, hT₁d, _, φ,
    inferInstance, inferInstance, inferInstance, Spec.map (CommRingCat.ofHom q), hφ.symm, _, ht'⟩

end Multisection

/-- **A point all of whose components dominate lies under the generic point.** If every
irreducible component through `m` of a scheme `M` has dense image under `g : M ⟶ S`, `S`
irreducible, then some generization `ζ` of `m` (the generic point of a component through `m`)
maps to the generic point of `S`. -/
private theorem exists_specializes_map_eq_genericPoint {M S : Scheme.{0}} [IrreducibleSpace S]
    (g : M ⟶ S) (m : M)
    (h : ∀ C ∈ irreducibleComponents M, m ∈ C → closure (g '' C) = Set.univ) :
    ∃ ζ : M, ζ ⤳ m ∧ g ζ = genericPoint S := by
  obtain ⟨C, hC, hmC⟩ :=
    exists_mem_irreducibleComponents_subset_of_isIrreducible {m} isIrreducible_singleton
  have hζC : IsGenericPoint hC.1.genericPoint C := by
    simpa [(isClosed_of_mem_irreducibleComponents C hC).closure_eq] using
      hC.1.isGenericPoint_genericPoint_closure
  refine ⟨_, hζC.specializes (hmC rfl), (IsGenericPoint.eq ?_ (genericPoint_spec S))⟩
  refine Set.eq_univ_of_univ_subset ((h C hC (hmC rfl)).symm.trans_le ?_)
  refine closure_minimal ?_ isClosed_closure
  rintro _ ⟨c, hc, rfl⟩
  exact specializes_iff_mem_closure.1 ((hζC.specializes hc).map (g.continuous))

/-- The class on `F_t` of a line bundle pulled back along `a` then `ι` is that of its pullback
along `a ≫ ι`. -/
private theorem pointFibreChernClass_pullback_pullback {Y Yt : Scheme.{0}}
    {sY : Y ⟶ Spec (.of ℂ)} {T : IrreducibleCloseds Y} {π : Yt ⟶ Y} {To : (curveScheme T).Opens}
    {t : ComplexPoints (To.ι ≫ curveι T ≫ sY)} {X Z : Scheme.{0}}
    (a : pointFibre sY π To t ⟶ X) (ι : X ⟶ Z) {b : pointFibre sY π To t ⟶ Z} (h : a ≫ ι = b)
    (M : Z.Modules) [SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M] :
    pointFibreChernClass sY π To t ((Scheme.Modules.pullback a).obj
        ((Scheme.Modules.pullback ι).obj M)) =
      pointFibreChernClass sY π To t ((Scheme.Modules.pullback b).obj M) := by
  let e : (Scheme.Modules.pullback a).obj ((Scheme.Modules.pullback ι).obj M) ≅
      (Scheme.Modules.pullback b).obj M :=
    (Scheme.Modules.pullbackComp a ι).app M ≪≫
      eqToIso (congrArg (fun f => (Scheme.Modules.pullback f).obj M) h)
  unfold pointFibreChernClass
  rw [algebraicFirstChernClass_eq_of_iso e]

/-- **Line bundles on very general fibres spread over finite étale covers.** For a local setting
`(Y, Θ, T, π)` and a `π`-adapted open `T°` with family `𝓕 = Ỹ ×_Y T° ⟶ T°`, there is a countable
set `Ω` of proper closed subsets of `T°` such that for every complex point `t` of `T°` outside
`⋃ Ω` and every invertible sheaf `𝓛` on `F_t`, there are a dense open `T¹ ⊆ T°`, a connected
finite étale `φ : T' ⟶ T¹`, an invertible sheaf `𝓛'` on `𝓕 ×_{T°} T'`, a complex point `t'` of
`T'` over the point `t₁` of `T°`, and a path `γ` from `t` to `t₁` in `T°(ℂ)` along which parallel
transport in `resolutionLocalSystem sY π To` carries `c₁(𝓛)` to `c₁(𝓛'|_{F_{t₁} × {t'}})`. -/
@[mmp "lem_oai4_c2_cover_line_bundle"]
public theorem exists_finiteEtaleCover_pointFibreChernClass_transport
    {Y Yt : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (sY : Y ⟶ Spec (.of ℂ)) (Θ : QDivisor Y) (T : IrreducibleCloseds Y) (π : Yt ⟶ Y)
    (hS : IsLocalSetting sY Θ T π)
    (To : (curveScheme T).Opens) (hTo : IsAdaptedOpen sY π To) :
    ∃ Ω : Set (Set (To : Scheme.{0})), Ω.Countable ∧
      (∀ Z ∈ Ω, IsClosed Z ∧ Z ≠ Set.univ) ∧
      ∀ (t : ComplexPoints (To.ι ≫ curveι T ≫ sY)), t.hom.base default ∉ ⋃₀ Ω →
      ∀ (L : (pointFibre sY π To t).Modules)
        (_ : SheafOfModules.IsInvertible (pointFibre sY π To t).presheaf
          (pointFibre sY π To t).ringCatSheaf.2 L),
      ∃ (T₁ : (To : Scheme.{0}).Opens) (_ : Dense (T₁ : Set (To : Scheme.{0})))
        (T' : Scheme.{0}) (φ : T' ⟶ (T₁ : Scheme.{0})) (_ : IsFinite φ) (_ : Etale φ)
        (_ : ConnectedSpace T')
        (L' : (pullback (pullback.snd π (To.ι ≫ curveι T)) (φ ≫ T₁.ι)).Modules)
        (_ : SheafOfModules.IsInvertible
          (pullback (pullback.snd π (To.ι ≫ curveι T)) (φ ≫ T₁.ι)).presheaf
          (pullback (pullback.snd π (To.ι ≫ curveι T)) (φ ≫ T₁.ι)).ringCatSheaf.2 L')
        (t' : ComplexPoints (φ ≫ T₁.ι ≫ To.ι ≫ curveι T ≫ sY))
        (t₁ : ComplexPoints (To.ι ≫ curveι T ≫ sY)) (ht' : t'.hom ≫ φ ≫ T₁.ι = t₁.hom)
        (γ : Path t t₁)
        (V : Opens (analyticSpace sY)) (hV : curveOpenInclusion sY To t ∈ V)
        (α : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V) 2)
        (V₁ : Opens (analyticSpace sY)) (hV₁ : curveOpenInclusion sY To t₁ ∈ V₁)
        (β : rationalCohomology (preimageSpace (resolutionAnalyticMap sY π) V₁) 2)
        (_ : SheafOfModules.IsInvertible (pointFibre sY π To t₁).presheaf
          (pointFibre sY π To t₁).ringCatSheaf.2
          ((Scheme.Modules.pullback (pullback.lift (pointFibreToFamily sY π To t₁)
            (pointFibreSnd sY π To t₁ ≫ t'.hom)
            (by rw [Category.assoc, ht']; exact pullback.lift_snd _ _ _))).obj L'))
        (s : ToType (((TopCat.Sheaf.pullback (ModuleCat.{0} ℚ)
          (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)).obj
            (resolutionLocalSystem sY π To)).obj.obj (op ⊤))),
        (rationalCohomologyMap (pointFibreInclusion sY π To t hV) 2).hom α =
          pointFibreChernClass sY π To t L ∧
        (rationalCohomologyMap (pointFibreInclusion sY π To t₁ hV₁) 2).hom β =
          pointFibreChernClass sY π To t₁
            ((Scheme.Modules.pullback (pullback.lift (pointFibreToFamily sY π To t₁)
              (pointFibreSnd sY π To t₁ ≫ t'.hom)
              (by rw [Category.assoc, ht']; exact pullback.lift_snd _ _ _))).obj L') ∧
        (stalkToPullbackStalk (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)
            (resolutionLocalSystem sY π To) 0).hom
            ((((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).stalkCongr
              (.of_eq γ.source.symm)).hom.hom
              ((stalkToPullbackStalk (curveOpenInclusion sY To)
                (resolutionHigherDirectImage sY π 2) t).hom
                ((higherDirectImageGerm (resolutionAnalyticMap sY π) 2 _ hV).hom α))) =
          (((TopCat.Sheaf.forget _ _).obj ((TopCat.Sheaf.pullback (ModuleCat.{0} ℚ)
            (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)).obj
              (resolutionLocalSystem sY π To))).germ ⊤ 0 trivial).hom s ∧
        (stalkToPullbackStalk (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)
            (resolutionLocalSystem sY π To) 1).hom
            ((((TopCat.Sheaf.forget _ _).obj (resolutionLocalSystem sY π To)).stalkCongr
              (.of_eq γ.target.symm)).hom.hom
              ((stalkToPullbackStalk (curveOpenInclusion sY To)
                (resolutionHigherDirectImage sY π 2) t₁).hom
                ((higherDirectImageGerm (resolutionAnalyticMap sY π) 2 _ hV₁).hom β))) =
          (((TopCat.Sheaf.forget _ _).obj ((TopCat.Sheaf.pullback (ModuleCat.{0} ℚ)
            (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)).obj
              (resolutionLocalSystem sY π To))).germ ⊤ 1 trivial).hom s := by
  classical
  obtain ⟨hlft, hqc, hsep⟩ := curveOpen_structure sY Θ T π hS To
  haveI : AlgebraicGeometry.IsVariety ℂ sY := hS.isProjectiveVariety.toIsVariety
  haveI : IsProper π := isProper_of_isProjectiveMorphism π hS.isResolution.2.2.2.1
  haveI : IsProper (pullback.snd π (To.ι ≫ curveι T)) :=
    isProper_of_isProjectiveMorphism _ hTo.isProjectiveMorphism
  haveI : Smooth (To.ι ≫ curveι T ≫ sY) := hTo.smooth
  haveI : ConnectedSpace To := hTo.connectedSpace
  haveI : IsIntegral (To : Scheme.{0}) :=
    Stacks.Chow.isIntegral_of_connectedSpace_of_smooth (To.ι ≫ curveι T ≫ sY)
  haveI : CompactSpace (To : Scheme.{0}) :=
    QuasiCompact.compactSpace_of_compactSpace (To.ι ≫ curveι T ≫ sY)
  haveI : IsLocallyNoetherian (To : Scheme.{0}) :=
    LocallyOfFiniteType.isLocallyNoetherian (To.ι ≫ curveι T ≫ sY)
  obtain ⟨ι, hι, M, g, hg1, hg2, U, hU, hcov⟩ :=
    exists_countable_families_isInvertible_pointFibre_iso sY Θ T π hS To hTo
  have hnoeth : ∀ α, NoetherianSpace (M α) := fun α => by
    haveI := hg1 α
    haveI := hg2 α
    haveI : CompactSpace (M α) := QuasiCompact.compactSpace_of_compactSpace (g α)
    haveI : IsLocallyNoetherian (M α) := LocallyOfFiniteType.isLocallyNoetherian (g α)
    haveI : IsNoetherian (M α) := ⟨⟩
    infer_instance
  -- `Ω`: the closures of the images of the non-dominating components
  refine ⟨⋃ α, (fun C => closure (g α '' C)) ''
      {C | C ∈ irreducibleComponents (M α) ∧ closure (g α '' C) ≠ Set.univ}, ?_, ?_, ?_⟩
  · refine Set.countable_iUnion fun α => ?_
    haveI := hnoeth α
    exact ((NoetherianSpace.finite_irreducibleComponents).subset fun C hC => hC.1).image _
      |>.countable
  · intro Z hZ
    obtain ⟨α, C, hC, rfl⟩ := Set.mem_iUnion.1 hZ
    exact ⟨isClosed_closure, hC.2⟩
  intro t ht L hL
  obtain ⟨α, μ, hμ, ⟨eL⟩⟩ := hcov t L hL
  haveI := hg1 α
  haveI := hU α
  -- every component through `μ` dominates `T°`
  obtain ⟨ζ, hζm, hgζ⟩ :=
    exists_specializes_map_eq_genericPoint (g α) (μ (IsLocalRing.closedPoint ℂ)) fun C hC hmC => by
      by_contra hne
      refine ht (Set.mem_sUnion.2 ⟨closure (g α '' C), Set.mem_iUnion.2 ⟨α, C, ⟨hC, hne⟩, rfl⟩,
        subset_closure ⟨_, hmC, ?_⟩⟩)
      change (μ ≫ g α) _ = _
      rw [hμ]
      exact congrArg t.hom.base (Subsingleton.elim _ _)
  -- the multisection
  obtain ⟨W, w, hWa, hWi, hwl, μW, hμW, T₁, hT₁, T', φ, hφf, hφe, hT'c, ψ, hψ, t'0, ht'0⟩ :=
    exists_finiteEtale_multisection (To.ι ≫ curveι T ≫ sY) (g α) μ ζ hζm hgζ
  haveI : LocallyOfFiniteType ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY) := by
    rw [Category.assoc]
    infer_instance
  haveI : IsSeparated ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY) := inferInstance
  haveI : QuasiCompact ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY) := inferInstance
  haveI : IsProper (pullback.snd (pullback.snd π (To.ι ≫ curveι T)) (w ≫ g α)) := inferInstance
  -- the universal bundle over `W` and its flat family of fibre classes
  let ιW : pullback (pullback.snd π (To.ι ≫ curveι T)) (w ≫ g α) ⟶
      pullback (pullback.snd π (To.ι ≫ curveι T)) (g α) :=
    pullback.map _ _ _ _ (𝟙 _) w (𝟙 _) (by rw [Category.comp_id, Category.id_comp])
      (Category.comp_id _)
  let U' := (Scheme.Modules.pullback ιW).obj (U α)
  haveI hU' : SheafOfModules.IsInvertible
      (pullback (pullback.snd π (To.ι ≫ curveι T)) (w ≫ g α)).presheaf
      (pullback (pullback.snd π (To.ι ≫ curveι T)) (w ≫ g α)).ringCatSheaf.2 U' :=
    MMP.Mori.isInvertible_pullback_obj ιW (U α)
  haveI : LocallyOfFiniteType sY := inferInstance
  haveI : IsSeparated sY := inferInstance
  obtain ⟨Ef, hEf, hloc⟩ := @exists_flat_family Y Yt sY T To W (w ≫ g α) π _ _ _ _ _ _ U' hU'
  -- `W(ℂ)` is path connected
  haveI : ConnectedSpace (analyticSpace ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY)) :=
    connectedSpace_analyticSpace _
  haveI := locallyPathConnectedSpace_analyticSpace ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY)
  haveI : PathConnectedSpace (analyticSpace ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY)) :=
    pathConnectedSpace_iff_connectedSpace.2 inferInstance
  -- the points `μ` of `W` over `t`, `t'` of `T'` and its image `w₁` in `W`, over `t₁`
  have hμ' : μW ≫ (w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY = 𝟙 _ := by
    simp only [Category.assoc]
    rw [reassoc_of% hμW, reassoc_of% hμ]
    exact t.hom_comp_structure
  let μ' : ComplexPoints ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY) := ⟨μW, hμ'⟩
  have h' : μ'.hom ≫ (w ≫ g α) = t.hom := by
    change μW ≫ w ≫ g α = t.hom
    rw [reassoc_of% hμW, hμ]
  have hcp : coverPt (φ := w ≫ g α) μ' = t := ComplexPoints.ext h'
  have hw₁ : (t'0 ≫ ψ) ≫ (w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY = 𝟙 _ := by
    simp only [Category.assoc]
    rwa [reassoc_of% hψ]
  let w₁ : ComplexPoints ((w ≫ g α) ≫ To.ι ≫ curveι T ≫ sY) := ⟨t'0 ≫ ψ, hw₁⟩
  let t' : ComplexPoints (φ ≫ T₁.ι ≫ To.ι ≫ curveι T ≫ sY) := ⟨t'0, ht'0⟩
  let t₁ : ComplexPoints (To.ι ≫ curveι T ≫ sY) := coverPt (φ := w ≫ g α) w₁
  have ht' : t'.hom ≫ φ ≫ T₁.ι = t₁.hom := by
    change t'0 ≫ φ ≫ T₁.ι = (t'0 ≫ ψ) ≫ w ≫ g α
    rw [Category.assoc, hψ]
  -- the path `γ`, the projection of a path in `W(ℂ)` from `μ` to `w₁`
  let p := analyticMap (w ≫ g α) (sY := To.ι ≫ curveι T ≫ sY) rfl
  let δ : Path μ' w₁ := PathConnectedSpace.somePath μ' w₁
  let γ : Path t t₁ := (δ.map p.hom.continuous).cast hcp.symm rfl
  -- the family of germs along `γ` is a global section of `γ^* 𝒲`
  obtain ⟨s, hs⟩ := exists_section_of_local
    (TopCat.ofHom (X := TopCat.of unitInterval) γ.toContinuousMap)
    (resolutionLocalSystem sY π To) (fun x => Ef (δ x)) (fun x₀ => by
      obtain ⟨Wl, r, Nl, he₀, hNW, hl⟩ := hloc (δ x₀)
      exact ⟨Wl, r, ⟨δ ⁻¹' Nl, Nl.isOpen.preimage δ.continuous⟩, he₀, fun x hx => hNW hx,
        fun x hx => hl (δ x) hx⟩)
  -- the classes realizing the germs at the two ends
  obtain ⟨V, hV, αc, hα1, hα2⟩ := isRealized_transport U' (hEf μ') hcp h'
  obtain ⟨V₁, hV₁, β, hβ1, hβ2⟩ := hEf w₁
  -- the class at `t` is `c₁(𝓛)`
  have key0 : sheetι (π := π) (t := t) ⟨μ', h'⟩ ≫ ιW =
      pullback.lift (pointFibreToFamily sY π To t) (pointFibreSnd sY π To t ≫ μ)
        (by rw [Category.assoc, hμ]; exact pullback.lift_snd _ _ _) := by
    apply pullback.hom_ext
    · simp only [ιW, sheetι, Category.assoc, pullback.lift_fst, Category.comp_id]
    · simp only [ιW, sheetι, Category.assoc, pullback.lift_snd, limit.lift_π_assoc,
        PullbackCone.mk_pt, PullbackCone.mk_π_app, pullback.lift_snd_assoc]
      change pointFibreSnd sY π To t ≫ μW ≫ w = _
      rw [hμW]
  -- the cover's bundle `𝓛'` and its class at `t₁`
  let ιT : pullback (pullback.snd π (To.ι ≫ curveι T)) (φ ≫ T₁.ι) ⟶
      pullback (pullback.snd π (To.ι ≫ curveι T)) (g α) :=
    pullback.map _ _ _ _ (𝟙 _) (ψ ≫ w) (𝟙 _) (by rw [Category.comp_id, Category.id_comp])
      (by rw [Category.comp_id, Category.assoc, hψ])
  let L' := (Scheme.Modules.pullback ιT).obj (U α)
  let sheet₁ : pointFibre sY π To t₁ ⟶ pullback (pullback.snd π (To.ι ≫ curveι T)) (φ ≫ T₁.ι) :=
    pullback.lift (pointFibreToFamily sY π To t₁) (pointFibreSnd sY π To t₁ ≫ t'.hom)
      (by rw [Category.assoc, ht']; exact pullback.lift_snd _ _ _)
  have key1 : sheet₁ ≫ ιT = sheetAt π w₁ ≫ ιW := by
    apply pullback.hom_ext
    · simp only [ιT, ιW, sheet₁, sheetι, Category.assoc, pullback.lift_fst, Category.comp_id]
      rfl
    · simp only [ιT, ιW, sheet₁, sheetι, Category.assoc, pullback.lift_snd, limit.lift_π_assoc,
        PullbackCone.mk_pt, PullbackCone.mk_π_app, pullback.lift_snd_assoc]
      rfl
  refine ⟨T₁, hT₁, T', φ, hφf, hφe, hT'c, L', inferInstance, t', t₁, ht', γ, V, hV, αc, V₁, hV₁,
    β, inferInstance, s, ?_, ?_, ?_, ?_⟩
  · rw [hα1, pointFibreChernClass_pullback_pullback _ ιW key0]
    unfold pointFibreChernClass
    rw [algebraicFirstChernClass_eq_of_iso eL]
  · exact hβ1.trans ((pointFibreChernClass_pullback_pullback _ ιW rfl (U α)).trans
      (pointFibreChernClass_pullback_pullback sheet₁ ιT key1 (U α)).symm)
  · rw [hs 0]
    refine congrArg (stalkToPullbackStalk _ _ 0).hom ?_
    rw [hα2, stalkCongr_stalkCongr]
    exact (stalkCongr_congr_point (resolutionLocalSystem sY π To) p Ef δ.source.symm
      (hcp.trans γ.source.symm) rfl).trans (stalkCongr_self _ _ _)
  · rw [hs 1]
    refine congrArg (stalkToPullbackStalk _ _ 1).hom ?_
    rw [hβ2]
    exact (stalkCongr_congr_point (resolutionLocalSystem sY π To) p Ef δ.target.symm
      γ.target.symm rfl).trans (stalkCongr_self _ _ _)

end CoverLineBundle

/-! ## Change of an algebraically closed ground field -/

section FieldExtension

open CategoryTheory.Limits RingedSpaceModuleAdjunction
open scoped TensorProduct

universe u

/-- The morphism `Spec L ⟶ Spec k` of a field extension is surjective, flat and quasi-compact. -/
private lemma specMap_mem_surjective_flat_quasiCompact {k L : Type u} [Field k] [Field L]
    (σ : k →+* L) :
    (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})
      (Spec.map (CommRingCat.ofHom σ)) := by
  have h1 : Surjective (Spec.map (CommRingCat.ofHom σ)) :=
    ⟨fun _ => ⟨IsLocalRing.closedPoint L, Subsingleton.elim (α := PrimeSpectrum k) _ _⟩⟩
  have h2 : Flat (Spec.map (CommRingCat.ofHom σ)) :=
    Flat.SpecMap_iff.mpr (RingHom.Flat.of_isField (Field.toIsField _) _)
  have h3 : QuasiCompact (Spec.map (CommRingCat.ofHom σ)) := inferInstance
  exact ⟨⟨h1, h2⟩, h3⟩

private lemma isNormal_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) [IsNormal Y] : IsNormal X := by
  have hr (x : X) := @asIso _ _ _ _ (e.hom.stalkMap x)
    (IsOpenImmersion.instIsIsoCommRingCatStalkMap e.hom x)
  have hd (x : X) : IsDomain (X.presheaf.stalk x) := by
    have := IsNormal.stalk_isDomain (X := Y) (e.hom x)
    exact (hr x).commRingCatIsoToRingEquiv.symm.toMulEquiv.isDomain
  exact ⟨hd, fun x => IsIntegrallyClosed.of_equiv (hr x).commRingCatIsoToRingEquiv⟩

/-- Normality, integrality and dimension are insensitive to a base change along
`Spec K ⟶ Spec k₀`, for `k₀` algebraically closed, in any pullback square. -/
private lemma invariants_of_isPullback {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K]
    [IsAlgClosed k₀] {X W : Scheme.{u}} (f : X ⟶ Spec (.of k₀)) [LocallyOfFiniteType f]
    {p : W ⟶ X} {s : W ⟶ Spec (.of K)}
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) :
    (IsNormal X ↔ IsNormal W) ∧ (IsIntegral X ↔ IsIntegral W) ∧
      topologicalKrullDim W = topologicalKrullDim X := by
  obtain ⟨-, hint, hnor, -, hdim⟩ :=
    MMP.isReduced_isIntegral_isNormal_dim_baseChange_of_isAlgClosed (K := K) f
  let e := h.isoPullback
  refine ⟨hnor.trans ⟨fun _ => isNormal_of_iso e, fun _ => isNormal_of_iso e.symm⟩,
    hint.trans ⟨fun _ => IsIntegral.of_isIso e.inv, fun _ => IsIntegral.of_isIso e.hom⟩, ?_⟩
  have h1 := hdim Set.univ (IsOpen.isLocallyClosed isOpen_univ)
  rw [Set.preimage_univ] at h1
  rwa [(Scheme.homeoOfIso e).isHomeomorph.topologicalKrullDim_eq,
    ← (Homeomorph.Set.univ _).isHomeomorph.topologicalKrullDim_eq,
    ← (Homeomorph.Set.univ X).isHomeomorph.topologicalKrullDim_eq]

/-! ### Points and closed subsets under a base change of the ground field -/

section Square

variable {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K] [IsAlgClosed k₀] {X W : Scheme.{u}}
  (f : X ⟶ Spec (.of k₀)) [LocallyOfFiniteType f] {p : W ⟶ X} {s : W ⟶ Spec (.of K)}

/-- The preimage of a locally closed subset under the projection of a base change of the ground
field has the same dimension. -/
private lemma topologicalKrullDim_preimage_of_isPullback
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) {Z : Set X}
    (hZ : IsLocallyClosed Z) : topologicalKrullDim (p ⁻¹' Z) = topologicalKrullDim Z := by
  obtain ⟨-, -, -, -, hdim⟩ :=
    MMP.isReduced_isIntegral_isNormal_dim_baseChange_of_isAlgClosed (K := K) f
  rw [← hdim Z hZ]
  have hp (w : W) : p w = pullback.fst f _ (h.isoPullback.hom w) := by
    rw [← Scheme.Hom.comp_apply, h.isoPullback_hom_fst]
  refine (Homeomorph.subtype (Scheme.homeoOfIso h.isoPullback) fun w => ?_).isHomeomorph
    |>.topologicalKrullDim_eq
  simp only [Set.mem_preimage, Scheme.homeoOfIso_apply]
  rw [hp w]

/-- The preimage of an irreducible closed subset under the projection of a base change of an
algebraically closed ground field is irreducible. -/
private lemma isIrreducible_preimage_of_isPullback
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) {Z : Set X}
    (hZc : IsClosed Z) (hZ : IsIrreducible Z) : IsIrreducible (p ⁻¹' Z) := by
  let C : TopologicalSpace.Closeds X := ⟨Z, hZc⟩
  let I := Scheme.IdealSheafData.vanishingIdeal C
  have : IsIntegral I.subscheme :=
    StacksTag09NX.isIntegral_subscheme_vanishingIdeal_of_isIrreducible C hZ
  have : LocallyOfFiniteType (I.subschemeι ≫ f) := inferInstance
  have hsq : IsPullback (pullback.snd p I.subschemeι) (pullback.fst p I.subschemeι ≫ s)
      (I.subschemeι ≫ f) (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) :=
    (IsPullback.of_hasPullback p I.subschemeι).flip.paste_vert h
  obtain ⟨-, hint, -⟩ :=
    MMP.isReduced_isIntegral_isNormal_dim_baseChange_of_isAlgClosed (K := K) (I.subschemeι ≫ f)
  have : IsIntegral (pullback (I.subschemeι ≫ f)
      (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) := hint.1 ‹_›
  have : IsIntegral (pullback p I.subschemeι) := IsIntegral.of_isIso hsq.isoPullback.inv
  have hr : Set.range (pullback.fst p I.subschemeι) = p ⁻¹' Z := by
    rw [Scheme.Pullback.range_fst, Scheme.IdealSheafData.range_subschemeι,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  rw [← hr, ← Set.image_univ]
  exact (IrreducibleSpace.isIrreducible_univ _).image _ (Scheme.Hom.continuous _).continuousOn

/-- Cancellation in `WithBot ℕ∞` against a natural number. -/
private lemma le_of_add_eq_add_of_le {a b : WithBot ℕ∞} {c d : ℕ∞} {n : ℕ}
    (ha : a + c = n) (hb : b + d = n) (hab : a ≤ b) : d ≤ c := by
  induction a with
  | bot => simp at ha
  | coe a =>
  induction b with
  | bot => simp at hb
  | coe b =>
  have ha' : a + c = n := by exact_mod_cast ha
  have hb' : b + d = n := by exact_mod_cast hb
  have hab' : a ≤ b := by exact_mod_cast hab
  induction a with
  | top => simp at ha'
  | coe a =>
  induction b with
  | top => simp at hb'
  | coe b =>
  induction c with
  | top => simp at ha'
  | coe c =>
  induction d with
  | top => simp at hb'
  | coe d =>
  have : a + c = n := by exact_mod_cast ha'
  have : b + d = n := by exact_mod_cast hb'
  have : a ≤ b := by exact_mod_cast hab'
  exact_mod_cast (by omega : d ≤ c)

/-- Under a base change of an algebraically closed ground field of an integral scheme, coheights
can only grow, and every point has a preimage of the same coheight (the generic point of its
preimage closure). -/
private lemma coheight_le_of_isPullback
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) [IsIntegral X]
    [IsIntegral W] [LocallyOfFiniteType s] [Surjective p] :
    (∀ w : W, Order.coheight (p w) ≤ Order.coheight w) ∧
      ∀ x : X, ∃ w, p w = x ∧ Order.coheight w ≤ Order.coheight x := by
  have hD : topologicalKrullDim W = topologicalKrullDim X := (invariants_of_isPullback f h).2.2
  have hn := MMP.Fourfold.topologicalKrullDim_eq_toNat_trdeg f
  have hX (x : X) := (MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight f x).trans hn
  have hW (w : W) := ((MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight s w).trans
    hD).trans hn
  have hcl (x : X) : topologicalKrullDim (p ⁻¹' closure {x}) =
      topologicalKrullDim (closure {x} : Set X) :=
    topologicalKrullDim_preimage_of_isPullback f h isClosed_closure.isLocallyClosed
  constructor
  · intro w
    have hsub : closure {w} ⊆ p ⁻¹' closure {p w} :=
      closure_minimal (Set.singleton_subset_iff.mpr (subset_closure rfl))
        (isClosed_closure.preimage p.continuous)
    have hle : topologicalKrullDim (closure {w} : Set W) ≤
        topologicalKrullDim (closure {p w} : Set X) := by
      rw [← hcl]
      exact (Topology.IsEmbedding.inclusion hsub).isInducing.topologicalKrullDim_le
    exact le_of_add_eq_add_of_le (hW w) (hX (p w)) hle
  · intro x
    have hirr := isIrreducible_preimage_of_isPullback f h (isClosed_closure (s := {x}))
      isIrreducible_singleton.closure
    obtain ⟨w, hw⟩ := QuasiSober.sober hirr (isClosed_closure.preimage p.continuous)
    have hpw : p w = x := by
      obtain ⟨w', rfl⟩ := p.surjective x
      exact ((hw.specializes (subset_closure rfl)).map p.continuous).antisymm
        (specializes_iff_mem_closure.mpr hw.mem) |>.eq
    refine ⟨w, hpw, ?_⟩
    have heq : topologicalKrullDim (closure {w} : Set W) =
        topologicalKrullDim (closure {x} : Set X) := by
      rw [← hcl, ← hw.def]
    exact le_of_add_eq_add_of_le (hX x) (hW w) heq.ge

/-- Codimension bounds of a closed subset are insensitive to a base change of an algebraically
closed ground field of an integral scheme. -/
private lemma le_closedsCodimension_iff_of_isPullback
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) [IsIntegral X]
    [IsIntegral W] [LocallyOfFiniteType s] [Surjective p] (n : ℕ∞)
    (C : TopologicalSpace.Closeds X) (C' : TopologicalSpace.Closeds W)
    (hC : (C' : Set W) = p ⁻¹' C) :
    n ≤ MMP.Mori.closedsCodimension C' ↔ n ≤ MMP.Mori.closedsCodimension C := by
  obtain ⟨h1, h2⟩ := coheight_le_of_isPullback f h
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight,
    MMP.Flips.le_closedsCodimension_iff_le_coheight, hC]
  constructor
  · intro H x hx
    obtain ⟨w, rfl, hw⟩ := h2 x
    exact (H w hx).trans hw
  · intro H w hw
    exact (H (p w) hw).trans (h1 w)

/-- The base change of a normal variety along an extension of an algebraically closed ground
field is a normal variety. -/
private lemma isNormalVariety_of_isPullback
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    (hv : MMP.Mori.IsNormalVariety k₀ f) : MMP.Mori.IsNormalVariety K s := by
  obtain ⟨hn, hi, -⟩ := invariants_of_isPullback f h
  have := hv.1.toIsIntegral
  exact ⟨{ toIsIntegral := hi.1 ‹_›
           toIsSeparated := MorphismProperty.of_isPullback (P := @IsSeparated) h
             hv.1.toIsSeparated
           toLocallyOfFiniteType :=
             MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) h ‹_›
           toQuasiCompact := MorphismProperty.of_isPullback (P := @QuasiCompact) h
             hv.1.toQuasiCompact }, hn.1 hv.2⟩

end Square

/-! ### Birationality through the generic fibre -/

section Birational

variable {X Y : Scheme.{u}}

/-- A morphism to an irreducible scheme whose generic fibre is the spectrum of the function field
of the target is dominant: that fibre is nonempty. -/
private lemma isDominant_of_isIso_fiberToSpecResidueField [IrreducibleSpace Y] (g : X ⟶ Y)
    [IsIso (g.fiberToSpecResidueField (genericPoint Y))] : IsDominant g := by
  obtain ⟨z⟩ : Nonempty (g.fiber (genericPoint Y)) :=
    ⟨inv (g.fiberToSpecResidueField (genericPoint Y)) (IsLocalRing.closedPoint _)⟩
  have hz : g (g.fiberι _ z) = genericPoint Y := (g.range_fiberι (genericPoint Y)).le ⟨z, rfl⟩
  have h1 : genericPoint Y ∈ Set.range g := ⟨_, hz⟩
  exact ⟨dense_iff_closure_eq.mpr <| Set.eq_univ_of_forall fun y =>
    closure_mono (Set.singleton_subset_iff.mpr h1)
      ((genericPoint_spec Y).specializes (Set.mem_univ y)).mem_closure⟩

/-- A morphism of integral schemes whose generic fibre is the spectrum of the residue field of the
generic point is birational in the sense of [Stacks, Tag 01RO]. -/
private lemma isBirational_of_isIso_fiberToSpecResidueField [IsIntegral X] [IsIntegral Y]
    (g : X ⟶ Y) [h : IsIso (g.fiberToSpecResidueField (genericPoint Y))] : IsBirational g := by
  have := isDominant_of_isIso_fiberToSpecResidueField g
  have hη : g (genericPoint X) = genericPoint Y := map_genericPoint_of_isDominant g
  refine ⟨?_, fun x hx' => ?_⟩
  · rw [genericPoints_eq_singleton, genericPoints_eq_singleton, ← hη]
    exact Set.bijOn_singleton.mpr rfl
  · rw [genericPoints_eq_singleton, Set.mem_singleton_iff] at hx'
    subst hx'
    have : IsIso (g.fiberToSpecResidueField (g (genericPoint X))) := hη ▸ h
    have hpre : IsPreimmersion (Spec.map (g.residueFieldMap (genericPoint X))) := by
      rw [← g.asFiberHom_fiberToSpecResidueField]
      infer_instance
    have hsurj : Function.Surjective (g.residueFieldMap (genericPoint X)).hom := by
      have h2 : SurjectiveOnStalks (Spec.map (g.residueFieldMap (genericPoint X))) :=
        inferInstance
      rw [HasRingHomProperty.Spec_iff (P := @SurjectiveOnStalks)] at h2
      exact RingHom.surjectiveOnStalks_iff_of_isLocalHom.mp h2
    have hX : IsIso (X.residue (genericPoint X)) := isIso_residue_genericPoint X
    have hY : IsIso (Y.residue (g (genericPoint X))) := by
      rw [hη]; exact isIso_residue_genericPoint Y
    have hfac : g.stalkMap (genericPoint X) = Y.residue (g (genericPoint X)) ≫
        g.residueFieldMap (genericPoint X) ≫ inv (X.residue (genericPoint X)) := by
      rw [← Category.assoc, IsIso.eq_comp_inv]
      exact (Scheme.residue_residueFieldMap g _).symm
    rw [hfac]
    have : IsIso (g.residueFieldMap (genericPoint X)) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr
        ⟨(g.residueFieldMap (genericPoint X)).hom.injective, hsurj⟩
    infer_instance

/-- For a proper morphism of integral schemes with normal target, birationality is equivalent to
the generic fibre being the spectrum of the function field of the target. -/
private lemma isBirationalMorphism_iff_isIso_fiberToSpecResidueField [IsIntegral X]
    [IsIntegral Y] [IsNormal Y] (g : X ⟶ Y) [IsProper g] :
    MMP.Mori.IsBirationalMorphism g ↔ IsIso (g.fiberToSpecResidueField (genericPoint Y)) := by
  refine ⟨fun hb => isIso_fiberToSpecResidueField_genericPoint_of_isBirational g
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hb), fun h => ?_⟩
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso g
    (isBirational_of_isIso_fiberToSpecResidueField g)).1 ‹_›
  have := isDominant_of_isIso_fiberToSpecResidueField g
  have hη : g (genericPoint X) = genericPoint Y := map_genericPoint_of_isDominant g
  have hfin : genericPoint Y ∈ MMP.Resolution.Bridges.finiteFibreLocus g := by
    have : Finite (g.fiber (genericPoint Y)) :=
      Finite.of_equiv _ (Scheme.homeoOfIso
        (asIso (g.fiberToSpecResidueField (genericPoint Y)))).toEquiv.symm
    exact Set.finite_coe_iff.mp (Finite.of_equiv _ (g.fiberHomeo _).toEquiv)
  let V : Y.Opens := ⟨_, hU⟩
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE g (g ⁻¹ᵁ V) V
    ⟨genericPoint X, show g (genericPoint X) ∈ V from hη ▸ hfin⟩ ⟨_, hfin⟩ le_rfl ?_
  rwa [Scheme.Hom.resLE_eq_morphismRestrict]

/-- In a pullback square, the fibre of the base change over `y'` is a base change of the fibre
over the image of `y'` along a field extension, so one is the spectrum of its residue field
exactly when the other is. -/
private lemma isIso_fiberToSpecResidueField_iff_of_isPullback {X Y X' Y' : Scheme.{u}}
    {p : X' ⟶ X} {g' : X' ⟶ Y'} {g : X ⟶ Y} {q : Y' ⟶ Y} (h : IsPullback p g' g q) (y' : Y') :
    IsIso (g'.fiberToSpecResidueField y') ↔ IsIso (g.fiberToSpecResidueField (q y')) := by
  have L := isPullback_fiberToSpecResidueField_of_isPullback h y'
  have hres := specMap_mem_surjective_flat_quasiCompact (q.residueFieldMap y').hom
  rw [CommRingCat.ofHom_hom] at hres
  exact MorphismProperty.iff_of_isPullback (P := MorphismProperty.isomorphisms Scheme.{u})
    L.flip hres

/-- In a pullback square, the fibre of the base change over `y'` is finite exactly when the fibre
over the image of `y'` is: the first is the base change of the second along a field extension,
which is surjective, and quasi-finiteness is stable under base change. -/
private lemma finite_preimage_singleton_iff_of_isPullback {X Y X' Y' : Scheme.{u}}
    {p : X' ⟶ X} {g' : X' ⟶ Y'} {g : X ⟶ Y} {q : Y' ⟶ Y} (h : IsPullback p g' g q)
    [LocallyOfFiniteType g] [QuasiCompact g] [QuasiCompact g'] (y' : Y') :
    (g' ⁻¹' {y'}).Finite ↔ (g ⁻¹' {q y'}).Finite := by
  have L := isPullback_fiberToSpecResidueField_of_isPullback h y'
  have hres := specMap_mem_surjective_flat_quasiCompact (q.residueFieldMap y').hom
  rw [CommRingCat.ofHom_hom] at hres
  rw [← Set.finite_coe_iff, ← Set.finite_coe_iff, ← (g'.fiberHomeo y').toEquiv.finite_iff,
    ← (g.fiberHomeo (q y')).toEquiv.finite_iff]
  constructor
  · intro hF
    have hm := MorphismProperty.of_isPullback (P := @Surjective) L.flip hres.1.1
    exact @Finite.of_surjective _ _ hF _ hm.surj
  · intro _
    have : LocallyOfFiniteType (g.fiberToSpecResidueField (q y')) :=
      inferInstanceAs (LocallyOfFiniteType (pullback.snd _ _))
    have : QuasiCompact (g.fiberToSpecResidueField (q y')) :=
      inferInstanceAs (QuasiCompact (pullback.snd _ _))
    have : QuasiCompact (g'.fiberToSpecResidueField y') :=
      inferInstanceAs (QuasiCompact (pullback.snd _ _))
    have hl : LocallyQuasiFinite (g.fiberToSpecResidueField (q y')) :=
      locallyQuasiFinite_iff_finite_preimage_singleton.mpr fun _ => Set.toFinite _
    have : LocallyQuasiFinite (g'.fiberToSpecResidueField y') :=
      MorphismProperty.of_isPullback (P := @LocallyQuasiFinite) L hl
    have hfin := (g'.fiberToSpecResidueField y').finite_preimage_singleton
      (IsLocalRing.closedPoint (Y'.residueField y'))
    exact Set.finite_univ_iff.mp <|
      hfin.subset fun z _ => Subsingleton.elim (α := PrimeSpectrum (Y'.residueField y')) _ _

/-- A morphism restricting to an isomorphism over `V` has subsingleton fibres over `V`. -/
private lemma subsingleton_preimage_singleton_of_isIso_restrict (g : X ⟶ Y) (V : Y.Opens)
    [IsIso (g ∣_ V)] (y : Y) (hy : y ∈ V) : (g ⁻¹' {y}).Subsingleton := by
  intro a ha b hb
  have ha' : a ∈ g ⁻¹ᵁ V := show g a ∈ V by rwa [Set.mem_singleton_iff.mp ha]
  have hb' : b ∈ g ⁻¹ᵁ V := show g b ∈ V by rwa [Set.mem_singleton_iff.mp hb]
  exact congrArg Subtype.val <| (g ∣_ V).isOpenEmbedding.injective (a₁ := ⟨a, ha'⟩)
    (a₂ := ⟨b, hb'⟩) (Subtype.ext (by
      rw [morphismRestrict_base_coe g V ⟨a, ha'⟩, morphismRestrict_base_coe g V ⟨b, hb'⟩]
      exact (Set.mem_singleton_iff.mp ha).trans (Set.mem_singleton_iff.mp hb).symm))

/-- For a proper birational morphism of integral schemes with normal target, the largest open
over which it is an isomorphism is the locus of finite fibres. -/
private lemma coe_biregularLocus_eq_finiteFibreLocus [IsIntegral X] [IsIntegral Y] [IsNormal Y]
    (g : X ⟶ Y) [IsProper g] (hb : MMP.Mori.IsBirationalMorphism g) :
    ((MMP.Mori.biregularLocus g : Y.Opens) : Set Y) =
      MMP.Resolution.Bridges.finiteFibreLocus g := by
  have hb' := MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hb
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso g hb').1 ‹_›
  refine subset_antisymm (fun y hy => ?_) (MMP.Mori.le_biregularLocus (V := ⟨_, hU⟩) hiso)
  have : IsIso (g ∣_ MMP.Mori.biregularLocus g) := MMP.Mori.isBiregular_biregularLocus g
  exact (subsingleton_preimage_singleton_of_isIso_restrict g _ y hy).finite

/-- **Exceptional sets under base change.** In a pullback square of proper birational morphisms
of integral schemes with normal targets, the exceptional set of the base change is the preimage
of the exceptional set: both are complements of finite-fibre loci, and finiteness of fibres is
insensitive to the field extensions between residue fields. -/
private lemma coe_exceptionalSet_eq_preimage_of_isPullback {X' Y' : Scheme.{u}} {p : X' ⟶ X}
    {g' : X' ⟶ Y'} {g : X ⟶ Y} {q : Y' ⟶ Y} (h : IsPullback p g' g q) [IsIntegral X]
    [IsIntegral Y] [IsNormal Y] [IsIntegral X'] [IsIntegral Y'] [IsNormal Y'] [IsProper g]
    [IsProper g'] (hb : MMP.Mori.IsBirationalMorphism g)
    (hb' : MMP.Mori.IsBirationalMorphism g') :
    (MMP.Mori.exceptionalSet g' : Set X') = p ⁻¹' MMP.Mori.exceptionalSet g := by
  ext x
  simp only [SetLike.mem_coe, MMP.Mori.mem_exceptionalSet, Set.mem_preimage]
  rw [← SetLike.mem_coe, coe_biregularLocus_eq_finiteFibreLocus g' hb', ← SetLike.mem_coe,
    coe_biregularLocus_eq_finiteFibreLocus g hb]
  simp only [MMP.Resolution.Bridges.finiteFibreLocus, Set.mem_setOf_eq]
  rw [finite_preimage_singleton_iff_of_isPullback h (g' x), ← Scheme.Hom.comp_apply, ← h.w,
    Scheme.Hom.comp_apply]

end Birational

/-! ### Regular systems of parameters along a flat local homomorphism -/

section LocalAlgebra

open IsLocalRing

/-- In a regular local ring, finitely many elements of the maximal ideal whose classes in
`𝔪/𝔪²` are linearly independent are part of a regular system of parameters. -/
private lemma exists_isRegularSystemOfParameters_of_linearIndependent {A : Type*} [CommRing A]
    [IsRegularLocalRing A] {ι : Type*} [Finite ι]
    (a : ι → A) (ha : ∀ i, a i ∈ maximalIdeal A)
    (hli : LinearIndependent (ResidueField A)
      (fun i => (maximalIdeal A).toCotangent ⟨a i, ha i⟩)) :
    ∃ (n : ℕ) (z : Fin n → A) (c : ι → Fin n), MMP.Mori.IsRegularSystemOfParameters z ∧
      (∀ i, z (c i) = a i) ∧ Function.Injective c := by
  classical
  let b := Module.Basis.sumExtend hli
  let J := ι ⊕ (Module.Basis.sumExtendIndex hli)
  have : Finite J := Module.Finite.finite_basis b
  have : Fintype J := Fintype.ofFinite J
  choose y hy using fun j : J => (maximalIdeal A).toCotangent_surjective (b j)
  let z' : J → A := Sum.elim a fun s => (y (Sum.inr s) : A)
  have hz'm : ∀ j, z' j ∈ maximalIdeal A := by
    rintro (i | s)
    · exact ha i
    · exact (y (Sum.inr s)).2
  have hz'b : ∀ j, (maximalIdeal A).toCotangent ⟨z' j, hz'm j⟩ = b j := by
    rintro (i | s)
    · exact (sumExtend_inl _ hli i).symm
    · exact hy _
  let e := Fintype.equivFin J
  refine ⟨Fintype.card J, z' ∘ e.symm, e ∘ Sum.inl, ⟨?_, ?_⟩, fun i => by simp [z'],
    e.injective.comp Sum.inl_injective⟩
  · have hspan : Submodule.span (ResidueField A)
        ((maximalIdeal A).toCotangent '' Set.range fun j => (⟨z' j, hz'm j⟩ : maximalIdeal A)) =
          ⊤ := by
      rw [← Set.range_comp,
        show ((maximalIdeal A).toCotangent ∘ fun j => (⟨z' j, hz'm j⟩ : maximalIdeal A)) = b
          from funext hz'b]
      exact b.span_eq
    have h1 := (CotangentSpace.span_image_eq_top_iff (R := A)).mp hspan
    have h2 := congrArg (Submodule.map (maximalIdeal A).subtype) h1
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp] at h2
    rwa [Set.range_comp, Equiv.range_eq_univ, Set.image_univ]
  · rw [← IsRegularLocalRing.spanFinrank_maximalIdeal,
      spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, Module.finrank_eq_card_basis b]

/-- Along a local homomorphism, elements of `𝔪_A` mapping to unit multiples of distinct members of
a regular system of parameters of `B` have linearly independent classes in `𝔪_A/𝔪_A²`. -/
private lemma linearIndependent_toCotangent_of_map_eq_unit_mul {A B : Type*} [CommRing A]
    [CommRing B] [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing B]
    (φ : A →+* B) [IsLocalHom φ] {ι : Type*} [Finite ι] {n' : ℕ} {w : Fin n' → B}
    (hw : MMP.Mori.IsRegularSystemOfParameters w) {c' : ι → Fin n'} (hc' : Function.Injective c')
    (a : ι → A) (ham : ∀ i, a i ∈ maximalIdeal A) (u : ι → B) (hu : ∀ i, IsUnit (u i))
    (hau : ∀ i, φ (a i) = u i * w (c' i)) :
    LinearIndependent (ResidueField A) (fun i => (maximalIdeal A).toCotangent ⟨a i, ham i⟩) := by
  classical
  have := Fintype.ofFinite ι
  have hwm : ∀ k, w k ∈ maximalIdeal B := fun k => hw.1 ▸ Ideal.subset_span ⟨k, rfl⟩
  have hli := MMP.Mori.linearIndependent_toCotangent_of_isRegularSystemOfParameters hw hwm
  rw [Fintype.linearIndependent_iff]
  intro g hg i
  choose l hl using fun j => IsLocalRing.residue_surjective (g j)
  have h1 : (maximalIdeal A).toCotangent (∑ j, l j • (⟨a j, ham j⟩ : maximalIdeal A)) = 0 := by
    rw [map_sum, ← hg]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, ← hl j]
    exact (algebraMap_smul (ResidueField A) (l j) _).symm
  rw [Ideal.toCotangent_eq_zero] at h1
  have hmap : (maximalIdeal A).map φ ≤ maximalIdeal B :=
    Ideal.map_le_iff_le_comap.mpr (fun x hx => (IsLocalRing.mem_maximalIdeal _).mpr
      (fun h => (IsLocalRing.mem_maximalIdeal _).mp hx (isUnit_of_map_unit φ x h)))
  have h2 : φ (∑ j, l j * a j) ∈ (maximalIdeal B) ^ 2 := by
    have : φ (∑ j, l j * a j) ∈ ((maximalIdeal A) ^ 2).map φ :=
      Ideal.mem_map_of_mem φ (by simpa using h1)
    rw [Ideal.map_pow] at this
    exact Ideal.pow_right_mono hmap 2 this
  have h3 : (maximalIdeal B).toCotangent
      (∑ j, (φ (l j) * u j) • (⟨w (c' j), hwm _⟩ : maximalIdeal B)) = 0 := by
    rw [Ideal.toCotangent_eq_zero]
    convert h2 using 1
    simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul, map_sum, map_mul, hau]
    exact Finset.sum_congr rfl fun j _ => by ring
  have h4 : ∑ j, (IsLocalRing.residue B (φ (l j) * u j)) •
      (maximalIdeal B).toCotangent ⟨w (c' j), hwm (c' j)⟩ = 0 := by
    rw [← h3, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul]
    exact (algebraMap_smul (ResidueField B) _ _)
  have hli' := hli.comp c' hc'
  rw [Fintype.linearIndependent_iff] at hli'
  have h5 := hli' _ h4 i
  rw [IsLocalRing.residue_eq_zero_iff] at h5
  have h6 : φ (l i) ∈ maximalIdeal B := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h5 ⊢
    exact fun h => h5 (h.mul (hu i))
  have h7 : l i ∈ maximalIdeal A := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h6 ⊢
    exact fun h => h6 (h.map φ)
  rwa [← hl i, IsLocalRing.residue_eq_zero_iff]

/-- **Coordinate hyperplanes descend along a flat local homomorphism.** Let `A → B` be a flat
local homomorphism of Noetherian local rings with `A` regular, and `I_i` finitely many ideals of
`A` whose extensions to `B` are generated by distinct members of a regular system of parameters
of `B`. Then the `I_i` are generated by distinct members of a regular system of parameters of
`A`. -/
private lemma exists_isRegularSystemOfParameters_of_map_eq_span {A B : Type*} [CommRing A]
    [CommRing B] [IsLocalRing B] [IsNoetherianRing B]
    [IsRegularLocalRing A] (φ : A →+* B) [IsLocalHom φ] (hφ : φ.Flat)
    {ι : Type*} [Finite ι] (I : ι → Ideal A) {n' : ℕ} {w : Fin n' → B}
    (hw : MMP.Mori.IsRegularSystemOfParameters w) {c' : ι → Fin n'} (hc' : Function.Injective c')
    (hI : ∀ i, (I i).map φ = Ideal.span {w (c' i)}) :
    ∃ (n : ℕ) (z : Fin n → A) (c : ι → Fin n), MMP.Mori.IsRegularSystemOfParameters z ∧
      (∀ i, I i = Ideal.span {z (c i)}) ∧ Function.Injective c := by
  classical
  letI := φ.toAlgebra
  have : Module.Flat A B := hφ
  have : IsLocalHom (algebraMap A B) := ‹IsLocalHom φ›
  have : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hwm : ∀ k, w k ∈ maximalIdeal B := fun k => hw.1 ▸ Ideal.subset_span ⟨k, rfl⟩
  have hli := MMP.Mori.linearIndependent_toCotangent_of_isRegularSystemOfParameters hw hwm
  have hw0 : ∀ k, w k ≠ 0 := by
    intro k hk
    apply hli.ne_zero k
    rw [Ideal.toCotangent_eq_zero]
    simp [hk]
  have hgen : ∀ i, ∃ a ∈ I i, ∃ u : B, IsUnit u ∧ φ a = u * w (c' i) := by
    intro i
    by_contra hcon
    push Not at hcon
    set t := w (c' i)
    have hle : (I i).map φ ≤ Ideal.span {t} * maximalIdeal B := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      have : φ a ∈ Ideal.span {t} := hI i ▸ Ideal.mem_map_of_mem φ ha
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp this
      have hbm : b ∈ maximalIdeal B := by
        by_contra hb'
        exact hcon a ha b ((IsLocalRing.notMem_maximalIdeal).mp hb') hb.symm
      exact Ideal.mem_span_singleton_mul.mpr ⟨b, hbm, by rw [mul_comm]; exact hb⟩
    have ht : t ∈ Ideal.span {t} * maximalIdeal B := hle (hI i ▸ Ideal.mem_span_singleton_self t)
    obtain ⟨m, hm, htm⟩ := Ideal.mem_span_singleton_mul.mp ht
    have h0 : t * (1 - m) = 0 := by rw [mul_sub, mul_one, htm, sub_self]
    have hu : IsUnit (1 - m) := by
      by_contra hu
      have h1 : 1 - m ∈ maximalIdeal B := (IsLocalRing.mem_maximalIdeal _).mpr hu
      have := Ideal.add_mem _ h1 hm
      rw [sub_add_cancel] at this
      exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr this)
    exact hw0 _ ((hu.mul_left_eq_zero).mp h0)
  choose a ha u hu hau using hgen
  have hIa : ∀ i, I i = Ideal.span {a i} := by
    intro i
    refine le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (ha i)))
    have h1 : (I i).map (algebraMap A B) = (Ideal.span {a i}).map (algebraMap A B) := by
      change (I i).map φ = (Ideal.span {a i}).map φ
      rw [hI i, Ideal.map_span, Set.image_singleton, hau i,
        Ideal.span_singleton_mul_left_unit (hu i)]
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) (I i), h1,
      Ideal.comap_map_eq_self_of_faithfullyFlat]
  have ham : ∀ i, a i ∈ maximalIdeal A := by
    intro i
    have : φ (a i) ∈ maximalIdeal B := by rw [hau i]; exact Ideal.mul_mem_left _ _ (hwm _)
    exact (IsLocalRing.mem_maximalIdeal _).mpr
      (fun h => (IsLocalRing.mem_maximalIdeal _).mp this (h.map φ))
  obtain ⟨n, z, c, hz, hzc, hc⟩ := exists_isRegularSystemOfParameters_of_linearIndependent a ham
    (linearIndependent_toCotangent_of_map_eq_unit_mul φ hw hc' a ham u hu hau)
  exact ⟨n, z, c, hz, fun i => by rw [hIa i, hzc i], hc⟩

end LocalAlgebra

/-! ### Simple normal crossings under a base change of the ground field -/

section SNC

open MMP.Resolution

/-- Over an algebraically closed field `k`, `κ ⊗_k L` is a regular ring for every finitely
generated field extension `κ/k` and every field extension `L/k`: regularity after every finitely
generated extension is detected after the finite purely inseparable ones, which are trivial. -/
private lemma isRegularRing_tensorProduct_of_isAlgClosed (k : Type u) (κ : Type u) (L : Type*)
    [Field k] [IsAlgClosed k] [Field κ] [Field L] [Algebra k κ] [Algebra k L]
    [Algebra.EssFiniteType k κ] : IsRegularRing (κ ⊗[k] L) := by
  refine (Algebra.forall_isRegularRing_tensorProduct_essFiniteType_iff_finite_isPurelyInseparable
    k L).mpr (fun K' _ _ _ _ => ?_) κ
  have hbij : Function.Bijective (algebraMap k K') := IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : K' ≃ₐ[k] k := (AlgEquiv.ofBijective (Algebra.ofId k K') hbij).symm
  exact IsRegularRing.of_ringEquiv ((Algebra.TensorProduct.congr e AlgEquiv.refl).trans
    (Algebra.TensorProduct.lid k L)).toRingEquiv.symm

/-- For `X` locally of finite type over an algebraically closed field `k` and a field extension
`σ : k → L`, the fibres of the projection `X ×_{Spec k} Spec L → X` are regular: the fibre over
`x` is the spectrum of `κ(x) ⊗_k L`. -/
private lemma isRegular_fiber_pullback_fst_of_isAlgClosed {k L : Type u} [Field k] [IsAlgClosed k]
    [Field L] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (σ : k →+* L)
    (x : X) : IsRegular ((pullback.fst sX (Spec.map (CommRingCat.ofHom σ))).fiber x) := by
  let h := pullback.fst sX (Spec.map (CommRingCat.ofHom σ))
  let : Algebra k L := σ.toAlgebra
  let : Algebra k (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.Γevaluation x).hom.toAlgebra
  have : Algebra.EssFiniteType k (X.residueField x) := residueField_essFiniteType k sX x
  have hpaste : IsPullback (h.fiberToSpecResidueField x) (h.fiberι x ≫ pullback.snd _ _)
      (X.fromSpecResidueField x ≫ sX) (Spec.map (CommRingCat.ofHom (algebraMap k L))) :=
    (IsPullback.of_hasPullback h (X.fromSpecResidueField x)).flip.paste_vert
      (IsPullback.of_hasPullback sX (Spec.map (CommRingCat.ofHom σ)))
  rw [← SpecMap_algebraMap_residueField sX x] at hpaste
  let e : h.fiber x ≅ Spec (.of (X.residueField x ⊗[k] L)) :=
    hpaste.isoPullback ≪≫ pullbackSpecIso k (X.residueField x) L
  have := isRegularRing_tensorProduct_of_isAlgClosed k (X.residueField x) L
  exact IsRegular.of_iso e ((isRegular_spec_iff _).2 this)

variable {k₀ K : Type u} [Field k₀] [IsAlgClosed k₀] [Field K] [Algebra k₀ K] {X : Scheme.{u}}
  (f : X ⟶ Spec (.of k₀)) [LocallyOfFiniteType f]

/-- The inverse image of a reduced closed subscheme under a base change of an algebraically
closed ground field is reduced, so it is the vanishing ideal of the preimage. -/
private lemma comap_vanishingIdeal_pullback_fst (Z : TopologicalSpace.Closeds X) :
    (Scheme.IdealSheafData.vanishingIdeal Z).comap
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) =
      Scheme.IdealSheafData.vanishingIdeal ⟨pullback.fst f _ ⁻¹' Z,
        Z.isClosed.preimage (pullback.fst f _).continuous⟩ := by
  set π := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))
  set I := Scheme.IdealSheafData.vanishingIdeal Z
  have : IsReduced I.subscheme := Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal Z
  have hsq : IsPullback (pullback.snd π I.subschemeι)
      (pullback.fst π I.subschemeι ≫ pullback.snd f _) (I.subschemeι ≫ f)
      (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) :=
    (IsPullback.of_hasPullback π I.subschemeι).flip.paste_vert (IsPullback.of_hasPullback _ _)
  obtain ⟨hred, -⟩ :=
    MMP.isReduced_isIntegral_isNormal_dim_baseChange_of_isAlgClosed (K := K) (I.subschemeι ≫ f)
  have : IsReduced (pullback (I.subschemeι ≫ f)
      (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) := hred.1 ‹_›
  have : IsReduced (pullback π I.subschemeι) := isReduced_of_isOpenImmersion hsq.isoPullback.hom
  set J := I.comap π
  have : IsReduced J.subscheme := isReduced_of_isOpenImmersion (I.comapIso π).hom
  have hrad : J.radical = J := by
    ext1
    funext U
    rw [Scheme.IdealSheafData.radical_ideal, ← J.ker_subschemeι, Scheme.Hom.ker_apply]
    exact Ideal.radical_eq_iff.mpr
      ((RingHom.ker_isRadical_iff_reduced_of_surjective
        (J.subschemeι_app_surjective U)).mpr inferInstance)
  rw [← hrad, ← Scheme.IdealSheafData.vanishingIdeal_support]
  congr 1
  ext x
  simp [J, I, Scheme.IdealSheafData.support_comap]

/-- Preimages of irreducible components along a continuous surjection pulling back irreducible
closed sets to irreducible sets are irreducible components. -/
private lemma preimage_mem_componentsOf {T T' : Type*} [TopologicalSpace T] [TopologicalSpace T']
    {π : T' → T} (hπ : Continuous π) (hs : Function.Surjective π)
    (hirr : ∀ W : Set T, IsClosed W → IsIrreducible W → IsIrreducible (π ⁻¹' W)) {D : Set T}
    (hD : IsClosed D) {W : Set T} (hW : W ∈ componentsOf D) :
    π ⁻¹' W ∈ componentsOf (π ⁻¹' D) := by
  have hWc := Aux.isClosed_of_mem_componentsOf hD hW
  refine ⟨⟨hirr W hWc hW.1.1, Set.preimage_mono hW.1.2⟩, fun T hT hle => ?_⟩
  have h3 : W ⊆ π '' T := by
    intro w hw
    obtain ⟨t, rfl⟩ := hs w
    exact ⟨t, hle hw, rfl⟩
  exact fun t ht => hW.2 ⟨hT.1.image π hπ.continuousOn, Set.image_subset_iff.2 hT.2⟩ h3
    ⟨t, ht, rfl⟩

/-- Being snc at a point pulls back along a morphism whose stalk map there is flat with regular
closed fibre: a regular system of parameters extends by lifts of parameters of the closed
fibre. -/
private lemma isSNCAt_preimage_of_flat {X Y : Scheme.{u}} (h : Y ⟶ X) (y : Y)
    [IsNoetherianRing (X.presheaf.stalk (h y))] [IsNoetherianRing (Y.presheaf.stalk y)]
    (hflat : (h.stalkMap y).hom.Flat)
    (hfib : letI := (h.stalkMap y).hom.toAlgebra
      IsRegularLocalRing (ClosedFibre (X.presheaf.stalk (h y)) (Y.presheaf.stalk y)))
    {T : Set X} (hT : IsSNCAt T (h y)) : IsSNCAt (h ⁻¹' T) y := by
  obtain ⟨n, w, C, hw, hC⟩ := hT
  let := (h.stalkMap y).hom.toAlgebra
  have : IsLocalHom (algebraMap (X.presheaf.stalk (h y)) (Y.presheaf.stalk y)) :=
    inferInstanceAs (IsLocalHom (h.stalkMap y).hom)
  have : Module.Flat (X.presheaf.stalk (h y)) (Y.presheaf.stalk y) := hflat
  obtain ⟨s, bbar, hb⟩ := MMP.Mori.exists_isRegularSystemOfParameters
    (ClosedFibre (X.presheaf.stalk (h y)) (Y.presheaf.stalk y))
  choose b hbb using fun j => Ideal.Quotient.mk_surjective (bbar j)
  have hw' := MMP.Flips.ResolutionInputs.isRegularSystemOfParameters_append_of_flat hw hb
    (b := b) (funext hbb)
  refine ⟨n + s, _, C.map (Fin.castAddEmb s), hw', ?_⟩
  rw [preimage_fromSpecStalk_preimage h y hC]
  ext q
  simp only [Set.mem_iUnion, exists_prop, Finset.mem_map, Fin.castAddEmb_apply]
  constructor
  · rintro ⟨c, hc, hq⟩
    exact ⟨_, ⟨c, hc, rfl⟩, by rwa [Fin.append_left]⟩
  · rintro ⟨_, ⟨c, hc, rfl⟩, hq⟩
    rw [Fin.append_left] at hq
    exact ⟨c, hc, hq⟩

/-- An snc chart of the preimage of `D` at `y` in `X_K` descends to an snc chart of `D` at the
image of `y`. -/
private lemma isSNCAt_of_isSNCFamily_preimage_pullback_fst [QuasiCompact f] [Smooth f]
    [IsNoetherian X] [Surjective (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))]
    [Flat (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))] {D : Set X}
    (hD : IsClosed D)
    (hfam : IsSNCFamily (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
      (componentsFamily (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) ⁻¹' D)))
    (y : pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) :
    IsSNCAt D (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) y) := by
  classical
  set π := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))
  have hD' : IsClosed (π ⁻¹' D) := hD.preimage π.continuous
  have := LocallyOfFiniteType.isLocallyNoetherian f
  have := LocallyOfFiniteType.isLocallyNoetherian
    (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
  have hregX : IsRegularLocalRing (X.presheaf.stalk (π y)) :=
    ((isRegular_iff_regular_stalks X).mp (isRegular_of_smooth_over_field f)).2 _
  have hirr : ∀ W : Set X, IsClosed W → IsIrreducible W → IsIrreducible (π ⁻¹' W) :=
    fun W hc hi => isIrreducible_preimage_of_isPullback f (IsPullback.of_hasPullback _ _) hc hi
  obtain ⟨n', w', c', hw', hc', hinj'⟩ := hfam.2 y
  let ι := {W : componentsOf D // π y ∈ (componentsFamily D W).support}
  have : Finite (componentsOf D) := (Aux.finite_and_cover_componentsOf hD).1.to_subtype
  have : Finite ι := Subtype.finite
  have hmem (W : ι) : π y ∈ (W.1 : Set X) := by
    have := W.2
    rwa [← SetLike.mem_coe, coe_support_componentsFamily hD] at this
  let V' : ι → {V // y ∈ (componentsFamily (π ⁻¹' D) V).support} := fun W =>
    ⟨⟨π ⁻¹' W.1, preimage_mem_componentsOf π.continuous π.surjective hirr hD W.1.2⟩, by
      rw [← SetLike.mem_coe, coe_support_componentsFamily hD']
      exact hmem W⟩
  have hV' : Function.Injective V' := by
    intro W₁ W₂ h
    have h1 : π ⁻¹' (W₁.1 : Set X) = π ⁻¹' W₂.1 := congrArg (fun V => V.1.1) h
    exact Subtype.ext (Subtype.ext ((Set.preimage_injective.mpr π.surjective) h1))
  have hI : ∀ W : ι, (IdealSheafData.stalk (componentsFamily D W.1) (π y)).map
      (π.stalkMap y).hom = Ideal.span {w' (c' (V' W))} := by
    intro W
    rw [← hc' (V' W), ← IdealSheafData.stalk_comap]
    congr 1
    have hWc := Aux.isClosed_of_mem_componentsOf hD W.1.2
    change (Scheme.IdealSheafData.vanishingIdeal _).comap π =
      Scheme.IdealSheafData.vanishingIdeal _
    rw [comap_vanishingIdeal_pullback_fst f]
    congr 1
    ext1
    simp only [TopologicalSpace.Closeds.coe_closure, TopologicalSpace.Closeds.coe_mk]
    rw [hWc.closure_eq, (hWc.preimage π.continuous).closure_eq]
  obtain ⟨n, z, c, hz, hzc, -⟩ := exists_isRegularSystemOfParameters_of_map_eq_span
    (π.stalkMap y).hom (Flat.stalkMap π y)
    (fun W : ι => IdealSheafData.stalk (componentsFamily D W.1) (π y)) hw'
    (hinj'.comp hV') hI
  obtain ⟨C, hC⟩ := isSNCAt_iUnion_support (componentsFamily D) (π y) (c := c) hzc
  rw [iUnion_support_componentsFamily hD] at hC
  exact ⟨n, z, C, hz, hC⟩

/-- **Simple normal crossing divisors under a base change of an algebraically closed ground
field.** For `X` smooth and of finite type over `k₀` algebraically closed, a subset `D ⊆ X` is a
divisor with simple normal crossings exactly when its preimage in `X_K` is one. -/
private lemma isSNCClosedSubset_iff_preimage_pullback_fst [PerfectField K] [QuasiCompact f]
    [Smooth f] (D : Set X) :
    IsSNCClosedSubset f D ↔
      IsSNCClosedSubset (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) ⁻¹' D) := by
  classical
  set φ := Spec.map (CommRingCat.ofHom (algebraMap k₀ K))
  set π := pullback.fst f φ
  set s := pullback.snd f φ
  have hφ := specMap_mem_surjective_flat_quasiCompact (algebraMap k₀ K)
  have : Surjective π :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback f φ).flip hφ.1.1
  have : Flat π :=
    MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback f φ).flip hφ.1.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X := {}
  have := LocallyOfFiniteType.isLocallyNoetherian s
  have := QuasiCompact.compactSpace_of_compactSpace s
  have : IsNoetherian (pullback (C := Scheme.{u}) f φ) := {}
  constructor
  · rintro ⟨hD, h0 | ⟨-, -, hfam⟩⟩
    · exact ⟨hD.preimage π.continuous, Or.inl (by rw [h0, Set.preimage_empty])⟩
    · have hat := IsSNCClosedSubset.isSNCAt_of_nonempty hD hfam
      refine isSNCClosedSubset_of_forall_isSNCAt s (hD.preimage π.continuous) fun y => ?_
      exact isSNCAt_preimage_of_flat π y (Flat.stalkMap π y)
        (isRegularLocalRing_closedFibre_of_isRegular_fiber π y
          (isRegular_fiber_pullback_fst_of_isAlgClosed f (algebraMap k₀ K) (π y))) (hat (π y))
  · rintro ⟨hD', hrest⟩
    have hD : IsClosed D := by
      have := π.isOpenMap _ hD'.isOpen_compl
      rw [← Set.preimage_compl, Set.image_preimage_eq _ π.surjective] at this
      exact isOpen_compl_iff.mp this
    obtain h0 | ⟨-, -, hfam⟩ := hrest
    · refine ⟨hD, Or.inl (Set.eq_empty_of_forall_notMem fun x hx => ?_)⟩
      obtain ⟨y, rfl⟩ := π.surjective x
      exact Set.eq_empty_iff_forall_notMem.mp h0 y hx
    exact isSNCClosedSubset_of_forall_isSNCAt f hD fun x => by
      obtain ⟨y, rfl⟩ := π.surjective x
      exact isSNCAt_of_isSNCFamily_preimage_pullback_fst f hD hfam y

/-- `isSNCClosedSubset_iff_preimage_pullback_fst` in an arbitrary pullback square. -/
private lemma isSNCClosedSubset_iff_preimage_of_isPullback [PerfectField K] [QuasiCompact f]
    [Smooth f] {W : Scheme.{u}} {p : W ⟶ X} {s : W ⟶ Spec (.of K)}
    (h : IsPullback p s f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    [LocallyOfFiniteType s] [QuasiCompact s] (D : Set X) :
    IsSNCClosedSubset f D ↔ IsSNCClosedSubset s (p ⁻¹' D) := by
  rw [isSNCClosedSubset_iff_preimage_pullback_fst (K := K) f D]
  have e₁ (w : W) : pullback.fst f _ (h.isoPullback.hom w) = p w := by
    rw [← Scheme.Hom.comp_apply, h.isoPullback_hom_fst]
  have e₂ (w : pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) :
      p (h.isoPullback.inv w) = pullback.fst f _ w := by
    rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]
  refine ⟨fun H => ?_, fun H => ?_⟩
  · have := IsSNCClosedSubset.preimage_of_isIso h.isoPullback.hom H
    rwa [h.isoPullback_hom_snd, Set.preimage_preimage, funext e₁] at this
  · have := IsSNCClosedSubset.preimage_of_isIso h.isoPullback.inv H
    rwa [h.isoPullback_inv_snd, Set.preimage_preimage, funext e₂] at this

end SNC

/-- **Change of algebraically closed ground field.** Let `k₀ ⊆ K` be algebraically closed
fields and `g : X ⟶ Y` a proper morphism of `k₀`-schemes of finite type with `Y`
quasi-projective. Let `Y_K = Y ×_{k₀} Spec K`, `p : X_K = X ×_Y Y_K ⟶ X` and
`g_K : X_K ⟶ Y_K` the base change. Then normality, integrality and dimension of `X` and `Y`,
H-projectivity, surjectivity, being an isomorphism and smoothness of `g`, smoothness of `X` and
`Y` over the ground field, and relative ampleness of any invertible sheaf `L` on `X` (against
`p^* L`) hold over `k₀` if and only if they hold over `K`. If `X` and `Y` are normal varieties,
`g` is birational, respectively small, iff `g_K` is. If `X` is smooth over `k₀`, a subset
`D ⊆ X` is a simple normal crossing closed subset iff `p⁻¹ D` is one. -/
@[mmp "thm_mmp_field_extension_mmp_geometry"]
public theorem baseChange_iff_of_isAlgClosed
    (k₀ K : Type u) [Field k₀] [IsAlgClosed k₀] [Field K] [IsAlgClosed K] [Algebra k₀ K]
    {X Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k₀)) (g : X ⟶ Y)
    [LocallyOfFiniteType sY] [QuasiCompact sY] [IsProper g]
    (hY : Stacks.HProjective.IsQuasiProjective sY) :
    let φ : Spec (.of K) ⟶ Spec (.of k₀) := Spec.map (CommRingCat.ofHom (algebraMap k₀ K))
    let YK : Scheme.{u} := pullback sY φ
    let sYK : YK ⟶ Spec (.of K) := pullback.snd sY φ
    let q : YK ⟶ Y := pullback.fst sY φ
    let XK : Scheme.{u} := pullback g q
    let p : XK ⟶ X := pullback.fst g q
    let gK : XK ⟶ YK := pullback.snd g q
    ((IsNormal X ↔ IsNormal XK) ∧ (IsNormal Y ↔ IsNormal YK)) ∧
    ((IsIntegral X ↔ IsIntegral XK) ∧ (IsIntegral Y ↔ IsIntegral YK)) ∧
    (topologicalKrullDim XK = topologicalKrullDim X ∧
      topologicalKrullDim YK = topologicalKrullDim Y) ∧
    (IsProjectiveMorphism g ↔ IsProjectiveMorphism gK) ∧
    (Surjective g ↔ Surjective gK) ∧
    (IsIso g ↔ IsIso gK) ∧
    (Smooth g ↔ Smooth gK) ∧
    ((Smooth (g ≫ sY) ↔ Smooth (gK ≫ sYK)) ∧ (Smooth sY ↔ Smooth sYK)) ∧
    (∀ (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L],
      Stacks.RelativeAmple.IsRelativelyAmple g L ↔
        Stacks.RelativeAmple.IsRelativelyAmple gK
          ((modulePullback p.toLRSHom.toShHom).obj L)) ∧
    (MMP.Mori.IsNormalVariety k₀ (g ≫ sY) → MMP.Mori.IsNormalVariety k₀ sY →
      (MMP.Mori.IsBirationalMorphism g ↔ MMP.Mori.IsBirationalMorphism gK) ∧
      (IsSmallMorphism (g ≫ sY) sY g ↔ IsSmallMorphism (gK ≫ sYK) sYK gK)) ∧
    (Smooth (g ≫ sY) → ∀ D : Set X,
      MMP.Resolution.IsSNCClosedSubset (g ≫ sY) D ↔
        MMP.Resolution.IsSNCClosedSubset (gK ≫ sYK) (p.base ⁻¹' D)) := by
  intro φ YK sYK q XK p gK
  have hφ : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) φ :=
    specMap_mem_surjective_flat_quasiCompact _
  have hsq1 : IsPullback p gK g q := IsPullback.of_hasPullback g q
  have hsq2 : IsPullback q sYK sY φ := IsPullback.of_hasPullback sY φ
  have hsq : IsPullback p (gK ≫ sYK) (g ≫ sY) φ := hsq1.paste_vert hsq2
  have hq : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) q :=
    ⟨⟨MorphismProperty.of_isPullback (P := @Surjective) hsq2.flip hφ.1.1,
      MorphismProperty.of_isPullback (P := @Flat) hsq2.flip hφ.1.2⟩,
      MorphismProperty.of_isPullback (P := @QuasiCompact) hsq2.flip hφ.2⟩
  obtain ⟨hXn, hXi, hXd⟩ := invariants_of_isPullback (g ≫ sY) hsq
  obtain ⟨hYn, hYi, hYd⟩ := invariants_of_isPullback sY hsq2
  have hsurj : Surjective g ↔ Surjective gK := by
    refine ⟨fun _ => MorphismProperty.of_isPullback (P := @Surjective) hsq1 ‹_›,
      fun h => ⟨fun y => ?_⟩⟩
    obtain ⟨y', rfl⟩ := hq.1.1.surj y
    obtain ⟨x', rfl⟩ := h.surj y'
    exact ⟨p x', by rw [← Scheme.Hom.comp_apply, hsq1.w, Scheme.Hom.comp_apply]⟩
  refine ⟨⟨hXn, hYn⟩, ⟨hXi, hYi⟩, ⟨hXd, hYd⟩,
    (@MMP.isRelativelyAmple_iff_and_isProjectiveMorphism_iff_of_fieldExtension k₀ K _ _ _ _ X Y
      sY g _ _ hY (Stacks.Ample.unitModule X) (Stacks.Ample.isInvertibleModule_unit X)).2, hsurj,
    (MorphismProperty.iff_of_isPullback (P := MorphismProperty.isomorphisms Scheme.{u})
      hsq1.flip hq).symm, (MorphismProperty.iff_of_isPullback (P := @Smooth) hsq1.flip hq).symm,
    ⟨(MorphismProperty.iff_of_isPullback (P := @Smooth) hsq.flip hφ).symm,
      (MorphismProperty.iff_of_isPullback (P := @Smooth) hsq2.flip hφ).symm⟩, ?_, ?_, ?_⟩
  · intro L _
    exact (MMP.isRelativelyAmple_iff_and_isProjectiveMorphism_iff_of_fieldExtension k₀ K sY g hY
      L).1
  · intro hXv hYv
    have : IsIntegral X := hXv.1.toIsIntegral
    have : IsIntegral Y := hYv.1.toIsIntegral
    have : IsNormal Y := hYv.2
    have hXvK := isNormalVariety_of_isPullback (g ≫ sY) hsq hXv
    have hYvK := isNormalVariety_of_isPullback sY hsq2 hYv
    have : IsIntegral XK := hXvK.1.toIsIntegral
    have : IsIntegral YK := hYvK.1.toIsIntegral
    have : IsNormal YK := hYvK.2
    have : Surjective p := MorphismProperty.of_isPullback (P := @Surjective) hsq1.flip hq.1.1
    have : Surjective q := hq.1.1
    have hbir : MMP.Mori.IsBirationalMorphism g ↔ MMP.Mori.IsBirationalMorphism gK := by
      rw [isBirationalMorphism_iff_isIso_fiberToSpecResidueField g,
        isBirationalMorphism_iff_isIso_fiberToSpecResidueField gK,
        isIso_fiberToSpecResidueField_iff_of_isPullback hsq1, map_genericPoint_of_isDominant q]
    have hcod (hb : MMP.Mori.IsBirationalMorphism g) :
        2 ≤ MMP.Mori.closedsCodimension (MMP.Mori.exceptionalSet gK) ↔
          2 ≤ MMP.Mori.closedsCodimension (MMP.Mori.exceptionalSet g) :=
      le_closedsCodimension_iff_of_isPullback (g ≫ sY) hsq 2 _ _
        (coe_exceptionalSet_eq_preimage_of_isPullback hsq1 hb (hbir.1 hb))
    refine ⟨hbir, fun H => ?_, fun H => ?_⟩
    · exact
        { isNormalVariety_source := hXvK
          isNormalVariety_target := hYvK
          comp_eq := rfl
          isProper := inferInstance
          isBirationalMorphism := hbir.1 H.isBirationalMorphism
          two_le_codimension := (hcod H.isBirationalMorphism).2 H.two_le_codimension }
    · have hb := hbir.2 H.isBirationalMorphism
      exact
        { isNormalVariety_source := hXv
          isNormalVariety_target := hYv
          comp_eq := rfl
          isProper := ‹_›
          isBirationalMorphism := hb
          two_le_codimension := (hcod hb).1 H.two_le_codimension }
  · intro _ D
    have : LocallyOfFiniteType (gK ≫ sYK) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hsq inferInstance
    have : QuasiCompact (gK ≫ sYK) :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hsq inferInstance
    exact isSNCClosedSubset_iff_preimage_of_isPullback (K := K) (g ≫ sY) hsq D

end FieldExtension

end MMP.Fourfold

