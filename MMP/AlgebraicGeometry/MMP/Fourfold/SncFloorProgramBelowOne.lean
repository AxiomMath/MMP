open AlgebraicGeometry CategoryTheory TopologicalSpace MMP.Mori MMP.Fourfold

namespace Proof_lem_fourfold_real_floor_program_below_one.NefThreshold

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

section Normalization

open MMP.Flips

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}

/-- Every proper curve has a normalization, of dimension at most one. -/
private theorem exists_curveNormalization (C : ProperCurve sX) :
    ∃ (N : Scheme.{0}) (ν : N ⟶ C.scheme) (_ : IsCurveNormalization ν),
      topologicalKrullDim N ≤ 1 := by
  let p := C.ι ≫ sX
  haveI : AlgebraicGeometry.IsCurve k p := C.isCurve
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k p
  haveI hvar : AlgebraicGeometry.IsVariety k (normalizationOverField k p ≫ p) :=
    isVariety_normalizationOverField k p
  haveI : IsIntegral (normalizationSchemeOverField k p) := hvar.toIsIntegral
  haveI : IsFinite (normalizationOverField k p) := isFinite_normalizationOverField k p
  have hν : IsCurveNormalization (normalizationOverField k p) :=
    { isIntegral := inferInstance
      isNormal := Scheme.isNormal_normalizationScheme C.scheme hX
      isFinite := inferInstance
      isBirationalMorphism := by
        haveI : Finite (irreducibleComponents (normalizationSchemeOverField k p)) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        haveI : Finite (irreducibleComponents C.scheme) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        obtain ⟨U, V, hUV, hU, hV, hiso⟩ := exists_dense_opens_isIso_resLE_of_isBirational
          (normalizationOverField k p) (Scheme.isBirational_normalization C.scheme hX)
          (Or.inl ⟨inferInstance, inferInstance⟩)
        exact isBirationalMorphism_of_isIso_resLE _ U V hU.nonempty hV.nonempty hUV hiso }
  exact ⟨_, _, hν, (topologicalKrullDim_normalizationSchemeOverField k p).le.trans C.dim_le⟩
/-- A normalization of a proper curve is not constant. -/
private theorem not_const_of_isCurveNormalization (C : ProperCurve sX) {C' : Scheme.{0}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) :
    ¬ ∃ y : C.scheme, ∀ x : C', ν.base x = y := by
  rintro ⟨y, hy⟩
  have := hν.isFinite
  have : IsDominant ν := hν.isBirationalMorphism.isDominant
  have huniv : Set.range ν = Set.univ := by
    rw [← ν.isClosedMap.isClosed_range.closure_eq, ν.denseRange.closure_range]
  have : Subsingleton C.scheme := ⟨fun a b => by
    obtain ⟨x, rfl⟩ := huniv.ge (Set.mem_univ a)
    obtain ⟨x', rfl⟩ := huniv.ge (Set.mem_univ b)
    exact (hy x).trans (hy x').symm⟩
  have h0 := topologicalKrullDim_zero_of_discreteTopology C.scheme
  rw [C.dim_eq] at h0
  exact absurd h0 (by decide)
/-- An integral scheme proper over `k` is a `k`-variety. -/
private theorem isVariety_of_isProper {Y : Scheme.{0}} [IsIntegral Y] (f : Y ⟶ Spec (.of k))
    [hp : IsProper f] : AlgebraicGeometry.IsVariety k f :=
  { toIsIntegral := ‹_›, toIsSeparated := hp.toIsSeparated,
    toLocallyOfFiniteType := hp.toLocallyOfFiniteType, toQuasiCompact := inferInstance }
/-- A normalization of a proper curve is a curve. -/
private theorem isCurve_comp (C : ProperCurve sX) {C' : Scheme.{0}} {ν : C' ⟶ C.scheme}
    (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1) :
    AlgebraicGeometry.IsCurve k (ν ≫ C.ι ≫ sX) := by
  have := hν.isFinite
  have := hν.isIntegral
  have := isVariety_of_isProper (ν ≫ C.ι ≫ sX)
  refine ⟨le_antisymm hdim ?_⟩
  by_contra! h
  refine not_const_of_isCurveNormalization C hν ⟨ν.base (genericPoint C'), fun x => ?_⟩
  by_cases hx : x = genericPoint C'
  · rw [hx]
  · exact absurd (one_le_topologicalKrullDim_of_specializes_of_ne
      (genericPoint_specializes x) (Ne.symm hx)) (not_le.mpr h)
/-- A birational morphism of integral schemes has degree one. -/
private theorem degreeOver_eq_one_of_isBirationalMorphism {Y Z : Scheme.{0}} [IsIntegral Y]
    [IsIntegral Z] (f : Y ⟶ Z) (hf : IsBirationalMorphism f) [IsDominant f]
    [LocallyOfFiniteType f] : degreeOver f = 1 := by
  letI := (functionFieldMap f).toAlgebra
  have heq : functionFieldMap f = dominantFunctionFieldMap f :=
    (congrArg CommRingCat.Hom.hom
      (stalkMap_cast_target f (genericPoint Y) (map_genericPoint_of_isDominant f))).symm
  rw [degreeOver_eq_finrank f heq]
  let e := AlgEquiv.ofBijective (Algebra.ofId Z.functionField Y.functionField)
    (hf.functionFieldMap_bijective)
  rw [← e.toLinearEquiv.finrank_eq, Module.finrank_self]
/-- The degree of an invertible sheaf along a normalization of a proper curve `C` is its degree
along `C`. -/
private theorem degreeOn_normalization (C : ProperCurve sX) {C' : Scheme.{0}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1)
    [IsProper ((ν ≫ C.ι) ≫ sX)] (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M] :
    MMP.Mori.degreeOn k sX (ν ≫ C.ι) hdim M = MMP.Mori.degreeOn k sX C.ι C.dim_le M := by
  have := hν.isFinite
  have := hν.isIntegral
  haveI : IsProper (ν ≫ C.ι ≫ sX) := by rw [← Category.assoc]; infer_instance
  have hc := isCurve_comp C hν hdim
  have hc2 := C.isCurve
  haveI : IsDominant ν := hν.isBirationalMorphism.isDominant
  have key := curveDegree_pullback_eq_degreeOver_mul k (ν ≫ C.ι ≫ sX) (C.ι ≫ sX) ν rfl
    (not_const_of_isCurveNormalization C hν) ((Scheme.Modules.pullback C.ι).obj M) 1
  rw [degreeOver_eq_one_of_isBirationalMorphism ν hν.isBirationalMorphism, Nat.cast_one,
    one_mul] at key
  let e : (Scheme.Modules.pullback (ν ≫ C.ι)).obj M ≅
      (Scheme.Modules.pullback ν).obj ((Scheme.Modules.pullback C.ι).obj M) :=
    ((Scheme.Modules.pullbackComp ν C.ι).app M).symm
  rw [MMP.Mori.degreeOn, MMP.Mori.degreeOn,
    invertibleCurveDegree_congr_structure (Category.assoc ν C.ι sX) hdim,
    invertibleCurveDegree_eq_of_iso k _ hdim e,
    invertibleCurveDegree_eq_curveDegree_one, invertibleCurveDegree_eq_curveDegree_one]
  exact key

variable [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]

/-- For a presentation `D = ∑ⱼ rⱼ Lⱼ`, the number `∑ⱼ rⱼ deg_C 𝒪_X(Lⱼ)` is a value of `D · C`. -/
private theorem isRIntersectionNumber_sum_degreeOn (D : RDivisor X) {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) (C : ProperCurve sX) :
    IsRIntersectionNumber k sX D r L C (∑ j, r j * (L j).degreeOn k sX C.ι C.dim_le (hL j)) := by
  obtain ⟨N, ν, hν, hdim⟩ := exists_curveNormalization C
  refine ⟨hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), hD, fun j => ?_, rfl⟩
  refine ⟨N, ν, hν, hdim, ?_⟩
  have := hν.isFinite
  haveI : IsProper ((ν ≫ C.ι) ≫ sX) := by rw [Category.assoc]; infer_instance
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := (hL j).isInvertibleModule_divisorialSheaf
  exact (degreeOn_normalization C hν hdim _).symm
/-- A value of `D · C` computed from a presentation `D = ∑ⱼ rⱼ Lⱼ` is `∑ⱼ rⱼ deg_C 𝒪_X(Lⱼ)`. -/
private theorem eq_sum_degreeOn_of_isRIntersectionNumber {D : RDivisor X} {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) {C : ProperCurve sX} {x : ℝ}
    (h : IsRIntersectionNumber k sX D r L C x) :
    x = ∑ j, r j * (L j).degreeOn k sX C.ι C.dim_le (hL j) :=
  (IsRIntersectionNumber.eq_and_linear k sX C).1 D r L r L _ _ h
    (isRIntersectionNumber_sum_degreeOn D r L hL hD C)
/-- Two presentations of the same `ℝ`-divisor give the same degree on a proper curve. -/
private theorem sum_degreeOn_eq_of_sum_eq (C : ProperCurve sX) {m n : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier)
    {s : Fin n → ℝ} {M : Fin n → Divisor X} (hM : ∀ i, (M i).IsCartier)
    (heq : ∑ j, r j • Divisor.toRDivisor (L j) = ∑ i, s i • Divisor.toRDivisor (M i)) :
    ∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ) =
      ∑ i, s i * ((M i).degreeOn k sX C.ι C.dim_le (hM i) : ℝ) :=
  (IsRIntersectionNumber.eq_and_linear k sX C).1 _ r L s M _ _
    (isRIntersectionNumber_sum_degreeOn _ r L hL rfl C)
    (isRIntersectionNumber_sum_degreeOn _ s M hM heq C)

end Normalization

section Divisors

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]

/-- The concatenation of two presentations by Cartier divisors is one. -/
private theorem isCartier_append {n m : ℕ} {M : Fin n → Divisor X} {N : Fin m → Divisor X}
    (hM : ∀ i, (M i).IsCartier) (hN : ∀ j, (N j).IsCartier) :
    ∀ i, (Fin.append M N i).IsCartier := fun i => by
  refine Fin.addCases (fun i => ?_) (fun j => ?_) i
  · rw [Fin.append_left]; exact hM i
  · rw [Fin.append_right]; exact hN j
/-- On a `ℚ`-factorial variety every `ℝ`-divisor `D` is a real combination `∑ rⱼ Lⱼ` of effective
Cartier divisors `Lⱼ`, with `rⱼ ≥ 0` when `D` is effective. -/
private theorem exists_effective_presentation_of_isQFactorial {k : Type} [Field k]
    {sX : X ⟶ Spec (.of k)} (hX : IsQFactorial sX) (D : RDivisor X) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X), (∀ j, (L j).IsCartier) ∧
      (∀ j P, 0 ≤ (L j).coeff P) ∧ ((∀ P, 0 ≤ D.coeff P) → ∀ j, 0 ≤ r j) ∧
      D = ∑ j, r j • Divisor.toRDivisor (L j) := by
  classical
  choose m hm hc using fun P : MMP.Mori.PrimeDivisor X => hX.2 (Finsupp.single P 1)
  let e := D.support.equivFin
  refine ⟨D.support.card, fun j => D (e.symm j) / m (e.symm j),
    fun j => ((m (e.symm j) : ℕ) : ℤ) • Finsupp.single (e.symm j : MMP.Mori.PrimeDivisor X) 1,
    fun j => hc _, fun j P => ?_, fun hD j => div_nonneg (hD _) (Nat.cast_nonneg _), ?_⟩
  · simp only [DivisorWithCoeffs.coeff, Finsupp.smul_apply, Finsupp.single_apply, smul_eq_mul]
    split_ifs <;> simp
  have hterm : ∀ P : MMP.Mori.PrimeDivisor X, (D P / m P) •
      Divisor.toRDivisor (((m P : ℕ) : ℤ) • Finsupp.single P (1 : ℤ) : Divisor X) =
        Finsupp.single P (D P) := by
    intro P
    ext E
    have hm' : (m P : ℝ) ≠ 0 := by exact_mod_cast (hm P).ne'
    change (D P / m P) * ((((m P : ℕ) : ℤ) • Finsupp.single P (1 : ℤ) : Divisor X) E : ℝ) = _
    by_cases hE : P = E
    · subst hE
      simp [hm', DivisorWithCoeffs.coeff]
    · simp [Finsupp.single_apply, hE, DivisorWithCoeffs.coeff]
  simp only [hterm]
  rw [e.symm.sum_comp (fun P : D.support => Finsupp.single (P : MMP.Mori.PrimeDivisor X) (D P)),
    Finset.sum_coe_sort D.support (fun P => Finsupp.single P (D P))]
  exact (Finsupp.sum_single D).symm
/-- A real combination of Cartier divisors is `ℝ`-Cartier. -/
private theorem isRCartier_of_eq_sum [IsIntegral X] {D : RDivisor X} {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) : RDivisor.IsRCartier D :=
  ⟨m, r, L, hL, fun Γ => by
    subst hD
    simp [DivisorWithCoeffs.coeff, Finsupp.finset_sum_apply]
    rfl⟩

end Divisors

/-- **Lowering an effective boundary keeps a pair log canonical.** On a `ℚ`-factorial variety, if
`B, C ≥ 0` and `(X, B + t C)` is log canonical then so is `(X, B + s C)` for `0 ≤ s ≤ t`: the log
discrepancies only grow, by `(t - s)` times the multiplicity of the pull-back of the effective
divisor `C`. -/
private theorem isRealLcPair_add_smul_of_le {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXq : IsQFactorial sX)
    {B C : RDivisor X} (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P) {s t : ℝ}
    (hs : 0 ≤ s) (hst : s ≤ t) (hlc : IsRealLcPair sX (B + t • C)) :
    IsRealLcPair sX (B + s • C) := by
  obtain ⟨hN, -, ⟨n₀, K₀, hK₀, -⟩, hld⟩ := hlc
  obtain ⟨q, ρ, G, hG, hGeff, hρ, hCG⟩ := exists_effective_presentation_of_isQFactorial hXq C
  have hρ' := hρ hC
  refine ⟨hN, fun P => ?_, ⟨n₀, K₀, hK₀, ?_⟩, fun n E a ha => ?_⟩
  · have h1 := hB P
    have h2 := hC P
    simp only [DivisorWithCoeffs.coeff, Finsupp.add_apply, Finsupp.smul_apply,
      smul_eq_mul] at h1 h2 ⊢
    positivity
  · obtain ⟨m, r, L, hL, -, -, h⟩ := exists_effective_presentation_of_isQFactorial hXq
      (Divisor.toRDivisor K₀ + (B + s • C))
    exact isRCartier_of_eq_sum hL h
  obtain ⟨hN', hprop, ω, hω, hK, m, r, Cc, C', hCc, hcoeff, hpull, rfl⟩ := ha
  haveI := E.isIntegral
  haveI := E.isLocallyNoetherian
  haveI := E.isNormal
  haveI := E.isDominant
  haveI : CompactSpace E.Y := by
    haveI := E.isNormalVariety.1.toQuasiCompact
    exact QuasiCompact.compactSpace_of_compactSpace (E.f ≫ sX)
  have hBG := fun j => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant E.f (G j)
  let G' := fun j => (G j).pullback (hG j) (hBG j)
  have hG' : ∀ j, 0 ≤ (G' j).coeff E.E := fun j =>
    coeff_nonneg_of_isPullback_of_isEffectiveOn (hG j) (V := ⊤) (fun P _ => hGeff j P)
      (Divisor.isPullback_pullback (hG j) (hBG j)) E.E
      ⟨E.E.genericPoint, by rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl,
        trivial⟩
  have key := hld n E (1 + (E.ordPullback ω : ℝ) -
      ∑ i, Fin.append r (fun j => (t - s) * ρ j) i * ((Fin.append C' G' i).coeff E.E : ℝ))
    ⟨hN', hprop, ω, hω, hK, m + q, Fin.append r (fun j => (t - s) * ρ j), Fin.append Cc G,
      Fin.append C' G', isCartier_append hCc hG, fun Γ => ?_, fun i => ?_, rfl⟩
  · rw [Fin.sum_univ_add] at key
    simp only [Fin.append_left, Fin.append_right] at key
    have hnn : 0 ≤ ∑ j, (t - s) * ρ j * ((G' j).coeff E.E : ℝ) :=
      Finset.sum_nonneg fun j _ =>
        mul_nonneg (mul_nonneg (sub_nonneg.mpr hst) (hρ' j)) (by exact_mod_cast hG' j)
    linarith
  · have h1 := hcoeff Γ
    have h2 : C.coeff Γ = ∑ j, ρ j * ((G j).coeff Γ : ℝ) := by
      rw [hCG]
      simp [DivisorWithCoeffs.coeff, Finsupp.finset_sum_apply]
      rfl
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, mul_assoc, ← Finset.mul_sum]
    rw [← h2]
    simp only [DivisorWithCoeffs.coeff, Finsupp.add_apply, Finsupp.smul_apply,
      smul_eq_mul] at h1 ⊢
    linear_combination h1
  · refine Fin.addCases (fun i => ?_) (fun j => ?_) i
    · simp only [Fin.append_left]
      exact hpull i
    · simp only [Fin.append_right]
      exact ⟨hBG j, Divisor.isPullback_pullback (hG j) (hBG j)⟩
/-- A linear form negative at one point of an extremal ray is negative on all of its nonzero
points. -/
private theorem neg_of_mem_isExtremalRay {V : Type*} [AddCommGroup V] [Module ℝ V] {N R : Set V}
    (hR : IsExtremalRay ℝ N R) (ℓ : V →ₗ[ℝ] ℝ) {w : V} (hw : w ∈ R) (hℓ : ℓ w < 0) :
    ∀ u ∈ R, u ≠ 0 → ℓ u < 0 := by
  obtain ⟨-, v, -, rfl⟩ := hR
  obtain ⟨a, ha, rfl⟩ := hw
  rintro _ ⟨b, hb, rfl⟩ hu
  have hb' : 0 < b := lt_of_le_of_ne hb (by rintro rfl; simp at hu)
  rw [map_smul, smul_eq_mul] at hℓ ⊢
  have hv : ℓ v < 0 := by
    by_contra h
    exact absurd hℓ (not_lt.mpr (mul_nonneg ha (not_lt.mp h)))
  exact mul_neg_of_pos_of_neg hb' hv

section Pairing

variable {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
variable (sX f) in
/-- The degree form `z ↦ (z · 𝒪_X(M))` of a Cartier divisor `M` on `N₁(X/Z)`. -/
private noncomputable def degreeForm (M : Divisor X) (hM : M.IsCartier) :
    RelativeNumericalCurveClasses sX f →ₗ[ℝ] ℝ :=
  haveI := hM.isInvertibleModule_divisorialSheaf
  RelativeNumericalCurveClasses.degree sX f M.divisorialSheaf
private theorem degreeForm_congr {M N : Divisor X} (h : M = N) (hM : M.IsCartier)
    (hN : N.IsCartier) : degreeForm sX f M hM = degreeForm sX f N hN := by
  subst h; rfl

variable (sX f) in
/-- The pairing `z ↦ ∑ cᵢ (z · 𝒪_X(Mᵢ))` of a presentation `∑ cᵢ Mᵢ` by Cartier divisors. -/
private noncomputable def pairing {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) : RelativeNumericalCurveClasses sX f →ₗ[ℝ] ℝ :=
  ∑ i, c i • degreeForm sX f (M i) (hM i)
private theorem pairing_apply {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (u : RelativeNumericalCurveClasses sX f) :
    pairing sX f c M hM u = ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
      RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) := by
  simp [pairing, degreeForm]

variable [QuasiCompact sX]

/-- On the class of a relative 1-cycle `∑ a_Γ Γ` the pairing is `∑ a_Γ ∑ cᵢ deg_Γ 𝒪_X(Mᵢ)`. -/
private theorem pairing_relativeNumericalClass {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (Zc : relativeOneCycles sX f) :
    pairing sX f c M hM (relativeNumericalClass sX f Zc) =
      (Zc : OneCycle ℝ sX).sum fun C a =>
        a * ∑ i, c i * ((M i).degreeOn ℂ sX C.ι C.dim_le (hM i) : ℝ) := by
  simp only [pairing, degreeForm, LinearMap.sum_apply, LinearMap.add_apply, LinearMap.smul_apply,
    RelativeNumericalCurveClasses.degree_relativeNumericalClass, OneCycle.degree_apply,
    smul_eq_mul, Finsupp.sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun C _ => Finset.sum_congr rfl fun i _ => ?_
  rw [mul_left_comm]
  rfl
/-- On the class of a contracted curve `Γ` the pairing is `∑ cᵢ deg_Γ 𝒪_X(Mᵢ)`. -/
private theorem pairing_relativeClass {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    pairing sX f c M hM (C.relativeClass f hC) =
      ∑ i, c i * ((M i).degreeOn ℂ sX C.ι C.dim_le (hM i) : ℝ) := by
  rw [ProperCurve.relativeClass, pairing_relativeNumericalClass]
  simp [ProperCurve.cycle]
/-- The pairing depends only on the divisor `∑ cᵢ Mᵢ`. -/
private theorem pairing_eq_of_sum_eq {n m : ℕ} {c : Fin n → ℝ} {M : Fin n → Divisor X}
    (hM : ∀ i, (M i).IsCartier) {d : Fin m → ℝ} {N : Fin m → Divisor X}
    (hN : ∀ j, (N j).IsCartier)
    (h : ∑ i, c i • Divisor.toRDivisor (M i) = ∑ j, d j • Divisor.toRDivisor (N j)) :
    pairing sX f c M hM = pairing sX f d N hN := by
  refine LinearMap.ext fun u => ?_
  obtain ⟨Zc, rfl⟩ := relativeNumericalClass_surjective sX f u
  rw [pairing_relativeNumericalClass, pairing_relativeNumericalClass]
  exact Finsupp.sum_congr fun C _ => by rw [sum_degreeOn_eq_of_sum_eq C hM hN h]
/-- A nef divisor pairs nonnegatively with every contracted curve, for every presentation. -/
private theorem pairing_nonneg_of_isRelativelyNef {D : RDivisor X}
    (hD : MMP.Flips.IsRelativelyNef ℂ sX f D) {n : ℕ} {c : Fin n → ℝ} {M : Fin n → Divisor X}
    (hM : ∀ i, (M i).IsCartier) (hDM : D = ∑ i, c i • Divisor.toRDivisor (M i))
    (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    0 ≤ pairing sX f c M hM (C.relativeClass f hC) := by
  obtain ⟨m, r, L, hL, hDL, hnn⟩ := hD
  have h := hnn C hC _ (isRIntersectionNumber_sum_degreeOn D r L hL hDL C)
  rwa [pairing_relativeClass, ← sum_degreeOn_eq_of_sum_eq C hL hM (hDL.symm.trans hDM)]
/-- A divisor pairing nonnegatively with every contracted curve is nef. -/
private theorem isRelativelyNef_of_pairing_nonneg {D : RDivisor X} {n : ℕ} {c : Fin n → ℝ}
    {M : Fin n → Divisor X} (hM : ∀ i, (M i).IsCartier)
    (hDM : D = ∑ i, c i • Divisor.toRDivisor (M i))
    (h : ∀ (C : ProperCurve sX) (hC : C.IsContractedBy f),
      0 ≤ pairing sX f c M hM (C.relativeClass f hC)) :
    MMP.Flips.IsRelativelyNef ℂ sX f D :=
  ⟨n, c, M, hM, hDM, fun C hC x hx => by
    rw [eq_sum_degreeOn_of_isRIntersectionNumber hM hDM hx, ← pairing_relativeClass c M hM C hC]
    exact h C hC⟩
/-- The pairing of the concatenated presentation of `D + t E`. -/
private theorem pairing_append {n m : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (d : Fin m → ℝ) (N : Fin m → Divisor X)
    (hN : ∀ j, (N j).IsCartier) (t : ℝ) (hMN : ∀ i, (Fin.append M N i).IsCartier)
    (u : RelativeNumericalCurveClasses sX f) :
    pairing sX f (Fin.append c (t • d)) (Fin.append M N) hMN u =
      pairing sX f c M hM u + t * pairing sX f d N hN u := by
  simp only [pairing, LinearMap.sum_apply, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul,
    Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply, Finset.mul_sum,
    mul_assoc]
/-- The concatenated presentation of `D + t E`. -/
private theorem add_smul_eq_sum_append {n m : ℕ} {D E : RDivisor X} {c : Fin n → ℝ}
    {M : Fin n → Divisor X} {d : Fin m → ℝ} {N : Fin m → Divisor X}
    (hD : D = ∑ i, c i • Divisor.toRDivisor (M i)) (hE : E = ∑ j, d j • Divisor.toRDivisor (N j))
    (t : ℝ) :
    D + t • E = ∑ i, Fin.append c (t • d) i • Divisor.toRDivisor (Fin.append M N i) := by
  rw [Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul, hD, hE,
    Finset.smul_sum, smul_smul]
/-- A linear form on `N₁(X/Z)` that is negative on the class of a contracted curve is negative on
the nonzero points of some extremal ray of `NE̅(X/Z)`: the class is a sum of points of extremal
rays, and one summand must be negative. -/
private theorem exists_isExtremalRay_neg_of_relativeClass_neg {sZ : Z ⟶ Spec (.of ℂ)}
    [MMP.Mori.IsProjectiveVariety ℂ sX] [MMP.Mori.IsProjectiveVariety ℂ sZ] (hf : f ≫ sZ = sX)
    (ℓ : RelativeNumericalCurveClasses sX f →ₗ[ℝ] ℝ) {Γ : ProperCurve sX}
    (hΓ : Γ.IsContractedBy f) (hℓ : ℓ (Γ.relativeClass f hΓ) < 0) :
    ∃ R : Set (RelativeNumericalCurveClasses sX f),
      IsExtremalRay ℝ (relativeClosedConeOfCurves sX f :
        Set (RelativeNumericalCurveClasses sX f)) R ∧ ∀ u ∈ R, u ≠ 0 → ℓ u < 0 := by
  have hz : Γ.relativeClass f hΓ ∈ relativeClosedConeOfCurves sX f := by
    change _ ∈ (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f))
    rw [coe_relativeClosedConeOfCurves]
    exact subset_closure (relativeClass_mem_relativeConeOfCurves hΓ)
  obtain ⟨s, R, w, hRw, hzw⟩ :=
    exists_sum_mem_isExtremalRay_relativeClosedConeOfCurves sX sZ f hf hz
  obtain ⟨i, hi⟩ : ∃ i, ℓ (w i) < 0 := by
    by_contra! h
    rw [hzw, map_sum] at hℓ
    exact hℓ.not_ge (Finset.sum_nonneg fun i _ => h i)
  exact ⟨R i, (hRw i).1, neg_of_mem_isExtremalRay (hRw i).1 ℓ (hRw i).2 hi⟩

end Pairing

/-- **Comparing two levels.** If `a + l b = 0` and `a + l' b < 0` with `l' < l` and `l > 0`, then
`b > 0` and `a < 0`. -/
private theorem pos_and_neg_of_add_mul_eq_zero_of_lt {a b l l' : ℝ} (hl : 0 < l) (hl' : l' < l)
    (h₀ : a + l * b = 0) (h₁ : a + l' * b < 0) : 0 < b ∧ a < 0 := by
  have hb : 0 < b := by nlinarith
  exact ⟨hb, by nlinarith⟩
/-- **An attained real lc nef threshold in dimension four.** -/
private theorem exists_isExtremalRay_nef_threshold_of_isRealLcPair : ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {f : X ⟶ Z} (hf : f ≫ sZ = sX)
    (hXq : IsQFactorial sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 4)
    {B C : RDivisor X} (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    {t₀ : ℝ} (ht₀ : 0 < t₀) (hlc : IsRealLcPair sX (B + t₀ • C))
    (hnef : MMP.Flips.IsRelativelyNef ℂ sX f (MMP.Flips.logCanonicalDivisor K (B + t₀ • C)))
    (hnot : ¬ MMP.Flips.IsRelativelyNef ℂ sX f (MMP.Flips.logCanonicalDivisor K B)),
    ∃ l : ℝ, 0 < l ∧ l ≤ t₀ ∧
      MMP.Flips.IsRelativelyNef ℂ sX f (MMP.Flips.logCanonicalDivisor K (B + l • C)) ∧
      RDivisor.IsRCartier (Divisor.toRDivisor K + B) ∧ RDivisor.IsRCartier C ∧
      ∃ R : Set (RelativeNumericalCurveClasses sX f),
        IsExtremalRay ℝ
          (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) R ∧
        (∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
          Divisor.toRDivisor K + (B + l • C) = ∑ i, c i • Divisor.toRDivisor (M i) →
          ∀ u ∈ R, ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
            RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) = 0) ∧
        (∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
          Divisor.toRDivisor K + B = ∑ i, c i • Divisor.toRDivisor (M i) →
          ∀ u ∈ R, u ≠ 0 → ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
            RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) < 0) ∧
        (∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
          C = ∑ i, c i • Divisor.toRDivisor (M i) →
          ∀ u ∈ R, u ≠ 0 → 0 < ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
            RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u)) := by
  intro X Z _ _ _ _ sX sZ hX hZ f hf hXq K hK B C hB hC t₀ ht₀ hlc hnef hnot
  haveI := hX
  haveI := hZ
  -- presentations of `K + B` and `C`, and of the adjoints `K + B + t C`
  obtain ⟨m₁, a, P, hP, -, -, hKB⟩ :=
    exists_effective_presentation_of_isQFactorial hXq (Divisor.toRDivisor K + B)
  obtain ⟨m₂, b, Q, hQ, -, -, hCQ⟩ := exists_effective_presentation_of_isQFactorial hXq C
  have hPQ := isCartier_append hP hQ
  have hpres : ∀ t : ℝ, Divisor.toRDivisor K + (B + t • C) =
      ∑ i, Fin.append a (t • b) i • Divisor.toRDivisor (Fin.append P Q i) := fun t => by
    rw [← add_assoc]
    exact add_smul_eq_sum_append hKB hCQ t
  have hpair : ∀ (t : ℝ) (u : RelativeNumericalCurveClasses sX f),
      pairing sX f (Fin.append a (t • b)) (Fin.append P Q) hPQ u =
        pairing sX f a P hP u + t * pairing sX f b Q hQ u :=
    fun t u => pairing_append a P hP b Q hQ t hPQ u
  set α := pairing sX f a P hP
  set β := pairing sX f b Q hQ
  have hnefS : ∀ t : ℝ, (∀ (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f),
      0 ≤ α (Γ.relativeClass f hΓ) + t * β (Γ.relativeClass f hΓ)) ↔
      MMP.Flips.IsRelativelyNef ℂ sX f (MMP.Flips.logCanonicalDivisor K (B + t • C)) :=
    fun t => ⟨fun h => isRelativelyNef_of_pairing_nonneg hPQ (hpres t) fun Γ hΓ => by
        rw [hpair]; exact h Γ hΓ,
      fun h Γ hΓ => by
        rw [← hpair]; exact pairing_nonneg_of_isRelativelyNef h hPQ (hpres t) Γ hΓ⟩
  -- the nef threshold
  let S : Set ℝ := {t | 0 ≤ t ∧ t ≤ t₀ ∧ ∀ (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f),
      0 ≤ α (Γ.relativeClass f hΓ) + t * β (Γ.relativeClass f hΓ)}
  have ht₀S : t₀ ∈ S := ⟨ht₀.le, le_rfl, (hnefS t₀).2 hnef⟩
  have hbdd : BddBelow S := ⟨0, fun t ht => ht.1⟩
  have hSc : IsClosed S := by
    simp only [S, Set.setOf_and, Set.setOf_forall]
    exact (isClosed_le continuous_const continuous_id).inter <|
      (isClosed_le continuous_id continuous_const).inter <|
        isClosed_iInter fun Γ => isClosed_iInter fun hΓ => isClosed_le continuous_const
          (by fun_prop)
  set l := sInf S
  obtain ⟨hl0, hlt₀, hlS⟩ : l ∈ S := hSc.csInf_mem ⟨t₀, ht₀S⟩ hbdd
  have hnefl := (hnefS l).1 hlS
  have hl_pos : 0 < l := by
    refine lt_of_le_of_ne hl0 fun h0 => hnot ?_
    rw [← h0] at hlS
    simpa using (hnefS 0).1 hlS
  -- the two log canonical pairs
  have hlcl : IsRealLcPair sX (B + l • C) := isRealLcPair_add_smul_of_le hXq hB hC hl0 hlt₀ hlc
  have hlc0 : IsRealLcPair sX B := by
    simpa using isRealLcPair_add_smul_of_le hXq hB hC le_rfl ht₀.le hlc
  obtain ⟨t₁, ht₁, hnull⟩ :=
    RadialNullRay.exists_pos_forall_isExtremalRay_null_of_isRealLcPair hX hZ hf hXq hK hlcl hlc0
      hnefl
  -- a level `l' < l` close to `l`
  set τ := min (t₁ / 2) (1 / 2)
  have hτ0 : 0 < τ := lt_min (by positivity) (by norm_num)
  have hτt : τ < t₁ := min_lt_of_left_lt (half_lt_self ht₁)
  have hτ1 : τ < 1 := min_lt_of_right_lt (by norm_num)
  set l' := (1 - τ) * l with hl'
  have hl'0 : 0 ≤ l' := mul_nonneg (by linarith) hl0
  have hl'l : l' < l := by nlinarith
  have hl'S : l' ∉ S := notMem_of_lt_csInf hl'l hbdd
  obtain ⟨Γ, hΓ, hneg⟩ : ∃ (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f),
      α (Γ.relativeClass f hΓ) + l' * β (Γ.relativeClass f hΓ) < 0 := by
    by_contra h
    push Not at h
    exact hl'S ⟨hl'0, by linarith, h⟩
  -- a negative extremal ray at level `l'`
  obtain ⟨R, hR, hRneg⟩ := exists_isExtremalRay_neg_of_relativeClass_neg hf
    (pairing sX f (Fin.append a (l' • b)) (Fin.append P Q) hPQ) hΓ (by rw [hpair]; exact hneg)
  -- the radial-null lemma makes it null at level `l`
  have hRnull := hnull τ hτ0 hτt R hR ⟨_, _, _, hPQ, by
      rw [← hpres l', hl']
      module,
    fun u hu hu0 => by rw [← pairing_apply _ _ hPQ]; exact hRneg u hu hu0⟩
  have hsign : ∀ u ∈ R, u ≠ 0 → 0 < β u ∧ α u < 0 := fun u hu hu0 =>
    pos_and_neg_of_add_mul_eq_zero_of_lt hl_pos hl'l
      (by rw [← hpair, pairing_apply]; exact hRnull _ _ _ hPQ (hpres l) u hu)
      (by rw [← hpair]; exact hRneg u hu hu0)
  refine ⟨l, hl_pos, hlt₀, hnefl, isRCartier_of_eq_sum hP hKB, isRCartier_of_eq_sum hQ hCQ,
    R, hR, hRnull, ?_, ?_⟩
  · intro n c M hM hKBM u hu hu0
    rw [← pairing_apply _ _ hM, pairing_eq_of_sum_eq hM hP (hKBM.symm.trans hKB)]
    exact (hsign u hu hu0).2
  · intro n c M hM hCM u hu hu0
    rw [← pairing_apply _ _ hM, pairing_eq_of_sum_eq hM hQ (hCM.symm.trans hCQ)]
    exact (hsign u hu hu0).1

end Proof_lem_fourfold_real_floor_program_below_one.NefThreshold

open CategoryTheory AlgebraicGeometry MMP.Fourfold MMP.Mori MMP.Flips

namespace Proof_lem_fourfold_real_floor_program_below_one

/-! ### Stages of the program -/

/-- A stage `(Y_i/Z, K_i, B_i, C_i)` of the program, with its upper level `μ_i`. -/
private structure Stage (Z : Scheme.{0}) where
  Y : Scheme.{0}
  [isIntegral : IsIntegral Y]
  [compactSpace : CompactSpace Y]
  [isLocallyNoetherian : IsLocallyNoetherian Y]
  [isNormal : IsNormal Y]
  sY : Y ⟶ Spec (.of ℂ)
  πY : Y ⟶ Z
  K : Divisor Y
  B : RDivisor Y
  C : RDivisor Y
  μ : ℝ

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

/-- The data of one step from a stage `S` to a stage `S'`. -/
private structure StepData {Z : Scheme.{0}} (S S' : Stage Z) where
  W : Scheme.{0}
  [isIntegral : IsIntegral W]
  [compactSpace : CompactSpace W]
  [isLocallyNoetherian : IsLocallyNoetherian W]
  [isNormal : IsNormal W]
  sW : W ⟶ Spec (.of ℂ)
  f : S.Y ⟶ W
  g : W ⟶ Z
  fp : S'.Y ⟶ W
  φ : S.Y.RationalMap S'.Y
  thr : ℝ

attribute [local instance] StepData.isIntegral StepData.compactSpace StepData.isLocallyNoetherian
  StepData.isNormal

variable {Z : Scheme.{0}}

/-- The initial stage `(Y, K_Y, B_Y, C_Y)` with upper level `t`. -/
private def initStage {Y : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (sY : Y ⟶ Spec (.of ℂ)) (πY : Y ⟶ Z) (KY : Divisor Y) (BY CY : RDivisor Y)
    (t : ℝ) : Stage Z :=
  ⟨Y, sY, πY, KY, BY, CY, t⟩

/-- The trivial step, used once the program has stopped. -/
private def StepData.trivial (S : Stage Z) : StepData S S where
  W := S.Y
  sW := S.sY
  f := 𝟙 _
  g := S.πY
  fp := 𝟙 _
  φ := Scheme.Hom.toRationalMap (𝟙 S.Y)
  thr := 0

/-- The adjoint `K_i + B_i` of a stage is nef over `Z`. -/
private def Stage.IsNef (S : Stage Z) : Prop :=
  IsRelativelyNef ℂ S.sY S.πY (logCanonicalDivisor S.K S.B)

/-- The invariants carried along the program. -/
private def Stage.Inv (sZ : Z ⟶ Spec (.of ℂ)) (α : ℝ) (S : Stage Z) : Prop :=
  MMP.Mori.IsProjectiveVariety ℂ S.sY ∧ IsQFactorial S.sY ∧ S.K.IsCanonicalDivisor S.sY 4 ∧
    S.πY ≫ sZ = S.sY ∧ IsRealDltPair S.sY S.B ∧ (∀ P, 0 ≤ S.B.coeff P) ∧
    (∀ P, 0 ≤ S.C.coeff P) ∧ 0 < S.μ ∧ IsRealLcPair S.sY (S.B + S.μ • S.C) ∧
    IsRelativelyNef ℂ S.sY S.πY (logCanonicalDivisor S.K (S.B + S.μ • S.C)) ∧
    ∃ N : RDivisor S.Y, (∀ P, 0 ≤ N.coeff P) ∧ (∀ P, N.coeff P ≠ 0 → 1 ≤ S.B.coeff P) ∧
      IsNumericallyEquivalentOver ℂ S.sY S.πY (α • logCanonicalDivisor S.K S.B) (S.C + N)

open Classical in
/-- The properties of a step of the program, as in the conclusion of the main theorem. -/
private def StepProps (S S' : Stage Z) (D : StepData S S') : Prop :=
  IsRelativelyNef ℂ S.sY S.πY (logCanonicalDivisor S.K (S.B + D.thr • S.C)) ∧
    (∀ s : ℝ, 0 ≤ s → s < D.thr →
      ¬ IsRelativelyNef ℂ S.sY S.πY (logCanonicalDivisor S.K (S.B + s • S.C))) ∧
    IsNegativeExtremalContraction ℂ S.sY D.sW (logCanonicalDivisor S.K S.B) D.f ∧
    D.f ≫ D.g = S.πY ∧ D.fp ≫ D.g = S'.πY ∧
    IsNumericallyEquivalentOver ℂ S.sY D.f (logCanonicalDivisor S.K (S.B + D.thr • S.C)) 0 ∧
    ((IsBirationalMorphism D.f ∧
        (∃ E : MMP.Mori.PrimeDivisor S.Y,
          (MMP.Mori.exceptionalSet D.f : Set S.Y) = E.support) ∧
        IsIso D.fp ∧ IsModificationOf D.f D.fp D.φ) ∨
      IsFlip ℂ S.sY D.sW S'.sY (logCanonicalDivisor S.K S.B) D.f D.fp D.φ) ∧
    S'.K = MMP.Mori.RationalMap.transformDivisor D.φ S.K ∧
    S'.B = MMP.Mori.RationalMap.transformDivisor D.φ S.B ∧
    S'.C = MMP.Mori.RationalMap.transformDivisor D.φ S.C ∧
    ∃ E : MMP.Mori.PrimeDivisor S.Y, S.B.coeff E = 1 ∧
      ∀ Γ : ProperCurve S.sY, Γ.IsContractedBy D.f →
        ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor S.Y) (x : ℝ),
          IsRIntersectionNumber ℂ S.sY (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0

/-- A divisorial step: `f` is birational with a prime exceptional divisor, `f⁺` is an
isomorphism, and the transform drops a component of the floor. -/
private def StepDiv (S S' : Stage Z) (D : StepData S S') : Prop :=
  IsBirationalMorphism D.f ∧
    (∃ E : MMP.Mori.PrimeDivisor S.Y, (MMP.Mori.exceptionalSet D.f : Set S.Y) = E.support) ∧
    IsIso D.fp ∧
    ∃ τ : MMP.Mori.PrimeDivisor S.Y → Option (MMP.Mori.PrimeDivisor S'.Y),
      S'.B = MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ S.B ∧
      S'.C = MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ S.C ∧
      ∃ P : MMP.Mori.PrimeDivisor S.Y, S.B.coeff P = 1 ∧ τ P = none

/-- A flip step: an extremal real flip, the strict transforms, and the crepant descent of the
upper level. -/
private def StepFlip (S S' : Stage Z) (D : StepData S S') : Prop :=
  IsRealFlipStep S.sY D.sW S'.sY S.K S.B S'.K S'.B D.f D.fp ∧
    S'.K = flipTransform D.f D.fp S.K ∧ S'.B = flipTransform D.f D.fp S.B ∧
    S'.C = flipTransform D.f D.fp S.C ∧
    ∃ M : RDivisor D.W,
      IsRCartierPullback D.f M (logCanonicalDivisor S.K (S.B + D.thr • S.C)) ∧
      IsRCartierPullback D.fp M (logCanonicalDivisor S'.K (S'.B + D.thr • S'.C))

/-- The roof `S.Y ⟶ W ⟵ S'.Y` of a step: `f` a birational contraction onto a normal variety, `f⁺`
a small contraction (an isomorphism for a divisorial step), the next stage the strict transform,
the primes contracted by `f` in the floor, and the upper adjoint at the threshold the pull-back of
one `ℝ`-Cartier divisor of `W`. -/
private def StepRoof (S S' : Stage Z) (D : StepData S S') : Prop :=
  IsNormalVariety ℂ D.sW ∧ IsContraction ℂ D.sW S.sY D.f ∧ IsBirationalMorphism D.f ∧
    IsSmall ℂ D.sW S'.sY D.fp ∧
    S'.K = flipTransform D.f D.fp S.K ∧ S'.B = flipTransform D.f D.fp S.B ∧
    S'.C = flipTransform D.f D.fp S.C ∧
    (∀ P : MMP.Mori.PrimeDivisor S.Y, 2 ≤ Order.coheight (D.f P.genericPoint) →
      S.B.coeff P = 1) ∧
    ∃ M : RDivisor D.W,
      IsRCartierPullback D.f M (logCanonicalDivisor S.K (S.B + D.thr • S.C)) ∧
      IsRCartierPullback D.fp M (logCanonicalDivisor S'.K (S'.B + D.thr • S'.C))

/-- The additional properties of a step used for the termination of the program. -/
private def StepExtra (S S' : Stage Z) (D : StepData S S') : Prop :=
  D.thr ≤ S.μ ∧ S'.μ = D.thr ∧ (StepDiv S S' D ∨ StepFlip S S' D) ∧ StepRoof S S' D

open Classical in
/-- The components of `⌊B⌋` of a stage. -/
private noncomputable def Stage.floor (S : Stage Z) : Finset (MMP.Mori.PrimeDivisor S.Y) :=
  S.B.support.filter fun P => S.B.coeff P = 1

/-! ### Divisors and log discrepancies -/

section Helpers

/-- The birational transform along a map of prime divisors preserves effectivity. -/
private theorem coeff_mapPrimeDivisors_nonneg {X Y : Scheme.{0}}
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)} {D : RDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) (Q : MMP.Mori.PrimeDivisor Y) :
    0 ≤ (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ D).coeff Q := by
  classical
  rw [DivisorWithCoeffs.coeff_apply, MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors,
    Finsupp.liftAddHom_apply,
    Finsupp.sum_apply]
  unfold Finsupp.sum
  refine Finset.sum_nonneg fun P _ => ?_
  rcases h : φ P with _ | Q'
  · simp [h]
  · simp only [h, Option.elim_some, Finsupp.singleAddHom_apply, Finsupp.single_apply]
    split_ifs
    · exact hD P
    · exact le_rfl

/-- An `ℝ`-Cartier divisor, as a combination of Cartier divisors. -/
private theorem isCartierCombination_of_isRCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {D : RDivisor X} (h : RDivisor.IsRCartier D) :
    IsCartierCombination D := by
  obtain ⟨m, r, C, hC, hD⟩ := h
  refine ⟨m, r, C, hC, Finsupp.ext fun Γ => ?_⟩
  rw [Finsupp.finsetSum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul, DivisorWithCoeffs.mapCoeffs, Finsupp.mapRange_apply]
  exact hD Γ

/-- The log discrepancy of a prime divisor `P` of `X`, regarded as the divisor `(X, 𝟙, P)` over
`X`, is `1 - coeff_P B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {B : RDivisor X} (hKB : RDivisor.IsRCartier (Divisor.toRDivisor K + B))
    (P : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n B (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hX P)
      (1 - B.coeff P) := by
  have hn := hK.topologicalKrullDim_eq
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, r, C, hC, hsum⟩ := hKB
  let E := MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hX P
  choose C' hC' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant (𝟙 X) (hC j)
  have hsumΓ : ∀ Γ : MMP.Mori.PrimeDivisor X,
      (Γ.ordForm ω : ℝ) + B.coeff Γ = ∑ i, r i * ((C i).coeff Γ : ℝ) := fun Γ => by
    have := hsum Γ
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor, ← hωK Γ] at this
    exact this
  refine ⟨hX, inferInstanceAs (IsProper (𝟙 X)), ω, hω0, ⟨K, hK, fun Γ => (hωK Γ).symm⟩, m, r, C,
    C', hC, hsumΓ, fun j => ⟨_, hC' j⟩, ?_⟩
  have hco : ∀ j, ((C' j).coeff P : ℝ) = (C j).coeff P := by
    intro j
    obtain ⟨U, hU, φ, hφ⟩ := hC j P.genericPoint
    have h1 := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF (hC' j) hφ P hU
      (MMP.Mori.pointComponent P.genericPoint)
    have hPU : (P.support ∩ U).Nonempty := (P.genericPoint_mem_iff U).mp hU
    have h2 := hφ P hPU
    rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord] at h2
    have hZ : P.component = MMP.Mori.pointComponent P.genericPoint := Subsingleton.elim
      (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := X)) _ _
    rw [hZ] at h2
    change (C' j).coeff P = X.ord (functionFieldMap (𝟙 X) _) P.genericPoint at h1
    rw [functionFieldMap_id_apply] at h1
    exact_mod_cast h1.trans h2.symm
  have hord : E.ordPullback ω = P.ordForm ω :=
    MMP.Mori.DivisorOver.ordPullback_ofPrimeDivisor hX hn P ω
  change 1 - B.coeff P = 1 + (E.ordPullback ω : ℝ) - ∑ i, r i * ((C' i).coeff P : ℝ)
  simp_rw [hco, hord]
  have := hsumΓ P
  linarith

/-- The coefficients of an lc boundary are at most one. -/
private theorem coeff_le_one_of_isRealLcPair {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    {B : RDivisor X} (h : IsRealLcPair sX B) (P : MMP.Mori.PrimeDivisor X) : B.coeff P ≤ 1 := by
  obtain ⟨hX, -, ⟨n, K, hK, hKB⟩, hlc⟩ := h
  have := hlc n _ _ (isLogDiscrepancy_ofPrimeDivisor hX hK hKB P)
  linarith

/-- Adding an effective `ℝ`-Cartier divisor to the boundary lowers every log discrepancy. -/
private theorem exists_isLogDiscrepancy_add_le {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} {B E : RDivisor X}
    {D : MMP.Mori.DivisorOver ℂ sX} {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B D a)
    (hE : RDivisor.IsRCartier E) (hE0 : 0 ≤ E) :
    ∃ a', MMP.Intersection.IsLogDiscrepancy sX n (B + E) D a' ∧ a' ≤ a := by
  obtain ⟨hX, hp, ω, hω0, hK, m, r, C, C', hC, hsum, hpb, rfl⟩ := h
  have := D.isIntegral
  have := D.isNormal
  have := D.isLocallyNoetherian
  have := D.isDominant
  have : CompactSpace D.Y := QuasiCompact.compactSpace_of_compactSpace D.f
  obtain ⟨hex, hnonneg⟩ := MMP.Fourfold.isEffective_of_isRCartierPullback D.f hE hE0
  obtain ⟨G, hG⟩ := hex
  have hG0 := hnonneg G hG
  obtain ⟨m₃, s, L, L', hLc, hEeq, hLpb, hGeq⟩ := hG
  refine ⟨1 + (D.ordPullback ω : ℝ) -
      ∑ i, Fin.append r s i * ((Fin.append C' L' i).coeff D.E : ℝ),
    ⟨hX, hp, ω, hω0, hK, m + m₃, Fin.append r s, Fin.append C L, Fin.append C' L',
      Fin.addCases (fun j => by simpa using hC j) (fun j => by simpa using hLc j), fun Γ => ?_,
      Fin.addCases (fun j => by simpa using hpb j) (fun j => by simpa using hLpb j), rfl⟩, ?_⟩
  · simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, DivisorWithCoeffs.coeff_add]
    rw [hEeq, MMP.Fourfold.coeff_sum_smul_toRDivisor, ← add_assoc, hsum Γ]
  · simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right]
    have h0 : (0 : ℝ) ≤ G.coeff D.E := Finsupp.le_def.mp hG0 D.E
    rw [hGeq, MMP.Fourfold.coeff_sum_smul_toRDivisor] at h0
    linarith

/-- Lowering the boundary of a `ℚ`-factorial dlt pair by an effective divisor keeps it dlt. -/
private theorem isRealDltPair_of_add {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B E : RDivisor X}
    (hdlt : IsRealDltPair sX (B + E)) (hQ : IsQFactorial sX) (hB : ∀ P, 0 ≤ B.coeff P)
    (hE : ∀ P, 0 ≤ E.coeff P) : IsRealDltPair sX B := by
  obtain ⟨⟨hX, -, ⟨n, K, hK, -⟩, hlc⟩, hle, Z, hsm, hsnc, hpos⟩ := hdlt
  have hEc : RDivisor.IsRCartier E := hQ.isRCartier E
  have hE0 : 0 ≤ E := Finsupp.le_def.mpr hE
  refine ⟨⟨hX, hB, ⟨n, K, hK, hQ.isRCartier _⟩, fun n D a ha => ?_⟩, fun P => ?_, Z, hsm, ?_,
    fun n D hD a ha => ?_⟩
  · obtain ⟨a', ha', hle'⟩ := exists_isLogDiscrepancy_add_le ha hEc hE0
    exact (hlc n D a' ha').trans hle'
  · have := hle P
    rw [DivisorWithCoeffs.coeff_add] at this
    linarith [hE P]
  · refine hsnc.of_support_subset fun Q hQ => ?_
    rw [Finsupp.mem_support_iff] at hQ ⊢
    have h1 := coeff_mapPrimeDivisors_nonneg
      (φ := MMP.Mori.inverseTransformPrimeDivisor (Scheme.Opens.ι (Z.compl : X.Opens))) hB Q
    have h2 := coeff_mapPrimeDivisors_nonneg
      (φ := MMP.Mori.inverseTransformPrimeDivisor (Scheme.Opens.ι (Z.compl : X.Opens))) hE Q
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ B Q ≠ 0 at hQ
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (B + E) Q ≠ 0
    rw [map_add, Finsupp.add_apply]
    change 0 ≤ MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ B Q at h1
    change 0 ≤ MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ E Q at h2
    intro h
    exact hQ (by linarith)
  · obtain ⟨a', ha', hle'⟩ := exists_isLogDiscrepancy_add_le ha hEc hE0
    exact (hpos n D hD a' ha').trans_le hle'

/-- Lowering the boundary of a `ℚ`-factorial lc pair by an effective divisor keeps it lc. -/
private theorem isRealLcPair_of_add {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B E : RDivisor X}
    (hlc : IsRealLcPair sX (B + E)) (hQ : IsQFactorial sX) (hB : ∀ P, 0 ≤ B.coeff P)
    (hE : ∀ P, 0 ≤ E.coeff P) : IsRealLcPair sX B := by
  obtain ⟨hX, -, ⟨n, K, hK, -⟩, hlc⟩ := hlc
  refine ⟨hX, hB, ⟨n, K, hK, hQ.isRCartier _⟩, fun n D a ha => ?_⟩
  obtain ⟨a', ha', hle'⟩ :=
    exists_isLogDiscrepancy_add_le ha (hQ.isRCartier E) (Finsupp.le_def.mpr hE)
  exact (hlc n D a' ha').trans hle'

end Helpers

/-- **A log smooth lc pair is dlt.** On a smooth variety, an lc pair whose boundary is snc is
dlt: take the empty closed subset in the definition. -/
private theorem isRealDltPair_of_isSmoothScheme {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] (hXs : MMP.Mori.IsSmoothScheme sX) {B : RDivisor X}
    (hlc : IsRealLcPair sX B) (hsnc : DivisorWithCoeffs.IsSNC sX B) : IsRealDltPair sX B := by
  refine ⟨hlc, coeff_le_one_of_isRealLcPair hlc, ⊥,
    MMP.Threefold.Resolution.isSmoothScheme_ι ℂ hXs _, ?_, fun n D hD => ?_⟩
  · rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen]
    exact hsnc.restrictOpen _
  · exact absurd (hD D.isGenericPoint_center.mem) (by simp)

/-! ### Intersection numbers on contracted curves -/

section Curves

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)}

/-- An `ℝ`-Cartier divisor, as an equality with a combination of Cartier divisors. -/
private theorem exists_eq_sum_of_isRCartier {D : RDivisor X} (h : RDivisor.IsRCartier D) :
    ∃ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X), (∀ i, (M i).IsCartier) ∧
      D = ∑ i, c i • Divisor.toRDivisor (M i) := by
  obtain ⟨n, c, M, hM, hD⟩ := h
  refine ⟨n, c, M, hM, Finsupp.ext fun Γ => ?_⟩
  show D.coeff Γ = (∑ i, c i • Divisor.toRDivisor (M i)).coeff Γ
  rw [hD Γ, MMP.Fourfold.coeff_sum_smul_toRDivisor]

/-- A combination of Cartier divisors is a Cartier combination. -/
private theorem isCartierCombination_of_eq_sum {D : RDivisor X} {n : ℕ} {c : Fin n → ℝ}
    {M : Fin n → Divisor X} (hM : ∀ i, (M i).IsCartier)
    (hD : D = ∑ i, c i • Divisor.toRDivisor (M i)) : IsCartierCombination D :=
  ⟨n, c, M, hM, by simpa only [MMP.Flips.toRDivisor_eq_mapCoeffs] using hD⟩

private theorem isCartierCombination_zero' : IsCartierCombination (0 : RDivisor X) :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩

/-- Appending two presentations. -/
private theorem sum_append_smul_toRDivisor {m n : ℕ} (r : Fin m → ℝ) (s : Fin n → ℝ)
    (L : Fin m → Divisor X) (M : Fin n → Divisor X) :
    ∑ i, Fin.append r s i • Divisor.toRDivisor (Fin.append L M i) =
      ∑ i, r i • Divisor.toRDivisor (L i) + ∑ i, s i • Divisor.toRDivisor (M i) := by
  simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right]

private theorem smul_sum_smul_toRDivisor {n : ℕ} (a : ℝ) (s : Fin n → ℝ)
    (M : Fin n → Divisor X) :
    a • ∑ i, s i • Divisor.toRDivisor (M i) = ∑ i, (a • s) i • Divisor.toRDivisor (M i) := by
  rw [Finset.smul_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [smul_smul]; rfl

/-- A curve contracted by `f` is contracted by `f ≫ h`. -/
private theorem isContractedBy_comp {W T : Scheme.{0}} {C : ProperCurve sX} {f : X ⟶ W}
    (hC : C.IsContractedBy f) (h : W ⟶ T) : C.IsContractedBy (f ≫ h) := fun x hx => by
  rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC x hx]

variable [QuasiCompact sX]

/-- The value of `(∑ c_i M_i) · C` computed from the presentation `∑ c_i M_i`. -/
private theorem isRIntersectionNumber_sum (C : ProperCurve sX) {n : ℕ} (c : Fin n → ℝ)
    (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier) :
    IsRIntersectionNumber ℂ sX (∑ i, c i • Divisor.toRDivisor (M i)) c M C
      (∑ i, c i * ((M i).degreeOn ℂ sX C.ι C.dim_le (hM i) : ℝ)) :=
  ⟨hM, fun i => (M i).degreeOn ℂ sX C.ι C.dim_le (hM i), rfl, fun i => by
    obtain ⟨d, hd⟩ := MMP.Flips.exists_isCartierIntersectionNumber C (M i) (hM i)
    have h' := MMP.Fourfold.Oai4C1.Negativity.eq_degreeOn_of_isCartierIntersectionNumber hd
    dsimp only
    rw [← h']
    exact hd, rfl⟩

/-- The degree of `𝒪_X(L)` on the class of a contracted curve is its degree along the curve. -/
private theorem degree_relativeClass {S : Scheme.{0}} {g : X ⟶ S} (C : ProperCurve sX)
    (hC : C.IsContractedBy g) (L : Divisor X) (hL : L.IsCartier) :
    (haveI := hL.isInvertibleModule_divisorialSheaf;
      RelativeNumericalCurveClasses.degree sX g L.divisorialSheaf (C.relativeClass g hC)) =
      (L.degreeOn ℂ sX C.ι C.dim_le hL : ℝ) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  change OneCycle.degree ℝ sX L.divisorialSheaf (C.cycle ℝ) = _
  rw [OneCycle.degree_cycle]
  rfl

/-- The degrees on the class of a contracted curve, summed along a presentation. -/
private theorem sum_degree_relativeClass {S : Scheme.{0}} {g : X ⟶ S} (C : ProperCurve sX)
    (hC : C.IsContractedBy g) {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) :
    ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf;
      RelativeNumericalCurveClasses.degree sX g (M i).divisorialSheaf (C.relativeClass g hC)) =
      ∑ i, c i * ((M i).degreeOn ℂ sX C.ι C.dim_le (hM i) : ℝ) :=
  Finset.sum_congr rfl fun i _ => by rw [degree_relativeClass]

private theorem coeff_smul_real (a : ℝ) (D : RDivisor X) (P : MMP.Mori.PrimeDivisor X) :
    (a • D).coeff P = a * D.coeff P := by
  rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply,
    smul_eq_mul]

/-- Every value of `D · C` on a contracted curve is computed, from any presentation of `D`, by the
degrees on the class of `C`. -/
private theorem eq_sum_degree_of_isRIntersectionNumber {S : Scheme.{0}} {g : X ⟶ S}
    (C : ProperCurve sX) (hC : C.IsContractedBy g) {D : RDivisor X} {n : ℕ} (c : Fin n → ℝ)
    (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier)
    (hD : D = ∑ i, c i • Divisor.toRDivisor (M i)) {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {x : ℝ} (hx : IsRIntersectionNumber ℂ sX D r L C x) :
    x = ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf;
      RelativeNumericalCurveClasses.degree sX g (M i).divisorialSheaf (C.relativeClass g hC)) := by
  have h0 := isRIntersectionNumber_sum C c M hM
  rw [← hD] at h0
  rw [(MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 D r L c M x _ hx h0]
  exact Finset.sum_congr rfl fun i _ => by rw [degree_relativeClass]

/-- Every value of `D · C` is computed from a given presentation. -/
private theorem eq_sum_degreeOn_of_isRIntersectionNumber (C : ProperCurve sX) {D : RDivisor X}
    {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier)
    (hD : D = ∑ i, c i • Divisor.toRDivisor (M i)) {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {x : ℝ} (hx : IsRIntersectionNumber ℂ sX D r L C x) :
    x = ∑ i, c i * ((M i).degreeOn ℂ sX C.ι C.dim_le (hM i) : ℝ) := by
  have h0 := isRIntersectionNumber_sum C c M hM
  rw [← hD] at h0
  exact (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 D r L c M x _ hx h0

/-- An `f`-anti-ample divisor is negative on every curve contracted by `f`. -/
private theorem lt_zero_of_isRelativelyAntiAmple {W : Scheme.{0}} {f : X ⟶ W} {E : RDivisor X}
    (hE : IsRelativelyAntiAmple f E) {Γ : ProperCurve sX} (hΓ : Γ.IsContractedBy f) {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX E r L Γ x) : x < 0 := by
  obtain ⟨n, a, A, hn, ha, hA, hEA⟩ := hE
  have hAc : ∀ j, (A j).IsCartier := fun j => (hA j).1
  have hE' : E = ∑ j, (fun j => -a j) j • Divisor.toRDivisor (A j) := by
    have : E = -∑ j, a j • Divisor.toRDivisor (A j) := by rw [← hEA, neg_neg]
    rw [this, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun j _ => (neg_smul _ _).symm
  rw [eq_sum_degreeOn_of_isRIntersectionNumber Γ _ A hAc hE' hx]
  have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  have hpos' : ∀ j, 0 < (A j).degreeOn ℂ sX Γ.ι Γ.dim_le (hAc j) := fun j => by
    obtain ⟨hD', hamp⟩ := hA j
    have := hD'.isInvertibleModule_divisorialSheaf
    have hrel : MMP.Mori.IsRelativelyAmple f (A j).divisorialSheaf := fun y => by
      obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
      exact ⟨V, hV, hyV, hamp V hV⟩
    exact MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _ hrel
      Γ hΓ
  have hpos : 0 < ∑ j, a j * ((A j).degreeOn ℂ sX Γ.ι Γ.dim_le (hAc j) : ℝ) :=
    Finset.sum_pos (fun j _ => mul_pos (ha j) (by exact_mod_cast hpos' j)) Finset.univ_nonempty
  simp only [neg_mul, Finset.sum_neg_distrib]
  linarith

/-- A contraction with `ρ = 1` contracts a curve. -/
private theorem exists_isContractedBy_of_relativePicardNumber_eq_one {W : Scheme.{0}}
    {f : X ⟶ W} (hρ : MMP.Flips.relativePicardNumber sX f = 1) :
    ∃ Γ : ProperCurve sX, Γ.IsContractedBy f := by
  by_contra hne
  push Not at hne
  have htop : MMP.Flips.relativeNumericallyTrivialDivisors sX f = ⊤ :=
    eq_top_iff.mpr fun D _ => (MMP.Flips.mem_relativeNumericallyTrivialDivisors sX f).mpr
      fun C hC => absurd hC (hne C)
  have : Subsingleton (MMP.Flips.RelativeNumericalDivisorClasses sX f) :=
    Submodule.Quotient.subsingleton_iff.mpr htop
  unfold MMP.Flips.relativePicardNumber at hρ
  rw [rank_subsingleton'] at hρ
  simp at hρ

end Curves

/-! ### Transforms of divisors -/

section Transforms

/-- The birational transform along a map of prime divisors commutes with `Divisor.toRDivisor`. -/
private theorem mapPrimeDivisors_toRDivisor {X Y : Scheme.{0}}
    (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (D : Divisor X) :
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ (Divisor.toRDivisor D) =
      Divisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ D) := by
  classical
  have hs : ∀ (Q : MMP.Mori.PrimeDivisor Y) (n : ℤ),
      Divisor.toRDivisor (Finsupp.single Q n) = Finsupp.single Q (n : ℝ) := fun Q n => by
    ext Q'
    rw [Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> simp
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
  | single P n =>
    have hs' : Divisor.toRDivisor (Finsupp.single P n) = Finsupp.single P (n : ℝ) := by
      ext Q'
      rw [Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
        Finsupp.single_apply, Finsupp.single_apply]
      split_ifs <;> simp
    rw [hs', MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single,
      MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single]
    rcases φ P with _ | Q
    · simp
    · simp only [Option.elim_some]
      exact (hs Q n).symm

private theorem mapPrimeDivisors_add_smul {X Y : Scheme.{0}}
    (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (B C : RDivisor X) (l : ℝ) :
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ (B + l • C) =
      MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ B +
        l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ C := by
  rw [map_add, MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_smul]

private theorem mapPrimeDivisors_logCanonicalDivisor {X Y : Scheme.{0}}
    (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (K : Divisor X)
    (B C : RDivisor X) (l : ℝ) :
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ (logCanonicalDivisor K (B + l • C)) =
      logCanonicalDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ K)
        (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ B +
          l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors φ C) := by
  unfold logCanonicalDivisor
  rw [map_add, mapPrimeDivisors_toRDivisor, mapPrimeDivisors_add_smul]

private theorem flipTransform_add_smul {X Y X' : Scheme.{0}} (f : X ⟶ Y) (fp : X' ⟶ Y)
    (B C : RDivisor X) (l : ℝ) :
    flipTransform f fp (B + l • C) = flipTransform f fp B + l • flipTransform f fp C := by
  change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (B + l • C)) =
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ B) +
    l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ C)
  rw [mapPrimeDivisors_add_smul, mapPrimeDivisors_add_smul]

private theorem flipTransform_logCanonicalDivisor {X Y X' : Scheme.{0}} (f : X ⟶ Y)
    (fp : X' ⟶ Y) (K : Divisor X) (B C : RDivisor X) (l : ℝ) :
    flipTransform f fp (logCanonicalDivisor K (B + l • C)) =
      logCanonicalDivisor (flipTransform f fp K)
        (flipTransform f fp B + l • flipTransform f fp C) := by
  change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (logCanonicalDivisor K (B + l • C))) = _
  rw [mapPrimeDivisors_logCanonicalDivisor, mapPrimeDivisors_logCanonicalDivisor]
  rfl

private theorem coeff_flipTransform_nonneg {X Y X' : Scheme.{0}} (f : X ⟶ Y) (fp : X' ⟶ Y)
    {D : RDivisor X} (hD : ∀ P, 0 ≤ D.coeff P) (Q : MMP.Mori.PrimeDivisor X') :
    0 ≤ (flipTransform f fp D).coeff Q :=
  coeff_mapPrimeDivisors_nonneg (fun P => coeff_mapPrimeDivisors_nonneg hD P) Q

/-- Morphisms to an affine scheme agree once they agree after a map with bijective global
sections. -/
private theorem eq_of_comp_eq_of_isIso_app {Y W T : Scheme.{0}} [IsAffine T] (f : Y ⟶ W)
    (hf : ∀ U : W.Opens, IsIso (f.app U)) {a b : W ⟶ T} (h : f ≫ a = f ≫ b) : a = b := by
  apply AlgebraicGeometry.ext_of_isAffine
  have h' := congrArg Scheme.Hom.appTop h
  simp only [Scheme.Hom.comp_appTop] at h'
  haveI : IsIso f.appTop := hf ⊤
  exact (cancel_mono f.appTop).mp h'

end Transforms

/-! ### Curves on the floor and in the exceptional set -/

section FloorCurves

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- A curve on which a prime divisor `E` of a `ℚ`-factorial variety is negative lies in `E`. -/
private theorem closure_subset_support_of_neg (hQ : IsQFactorial sX)
    (E : MMP.Mori.PrimeDivisor X) (Γ : ProperCurve sX)
    (hneg : ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0) :
    closure ({Γ.point} : Set X) ⊆ E.support := by
  classical
  obtain ⟨n, c, M, hM, hEq⟩ :=
    exists_eq_sum_of_isRCartier (hQ.isRCartier (Finsupp.single E (1 : ℝ)))
  have hx := isRIntersectionNumber_sum Γ c M hM
  rw [← hEq] at hx
  have hlt := hneg _ _ _ _ hx
  have hq : QDivisor.toRDivisor (Finsupp.single E (1 : ℚ)) =
      ∑ i, c i • Divisor.toRDivisor (M i) := by
    rw [← hEq]
    ext P
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> simp
  have h := MMP.Flips.intersectionNumber_eq_sum_of_toRDivisor_eq (k := ℂ) (sX := sX) Γ.ι Γ.dim_le
    _ (MMP.Fourfold.isQCartier_of_isQFactorial sX hQ _) c M hM hq
  have hneg' : QDivisor.intersectionNumber ℂ sX Γ.ι Γ.dim_le (Finsupp.single E (1 : ℚ))
      (MMP.Fourfold.isQCartier_of_isQFactorial sX hQ _) < 0 := by
    have : ((QDivisor.intersectionNumber ℂ sX Γ.ι Γ.dim_le (Finsupp.single E (1 : ℚ))
        (MMP.Fourfold.isQCartier_of_isQFactorial sX hQ _) : ℚ) : ℝ) < 0 := by
      rw [h]; exact hlt
    exact_mod_cast this
  have hpt := MMP.Mori.point_mem_support_of_intersectionNumber_neg hQ E Γ hneg'
  exact (E.idealSheaf.support.isClosed).closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hpt)

/-- The exceptional set of a birational contraction lies in any prime divisor `E` which is
negative on every contracted curve: the contracted curves cover the exceptional set. -/
private theorem exceptionalSet_subset_support_of_neg {W : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    [IsProper sX] (hQ : IsQFactorial sX) {f : X ⟶ W} (hf : IsContraction ℂ sW sX f)
    (hbir : IsBirationalMorphism f) {E : MMP.Mori.PrimeDivisor X}
    (hneg : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
        IsRIntersectionNumber ℂ sX (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0) :
    (MMP.Mori.exceptionalSet f : Set X) ⊆ E.support := by
  haveI := hf.isProper
  haveI : LocallyOfFiniteType sX := hf.isVariety_source.toLocallyOfFiniteType
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  rw [← closure_inter_closedPoints (MMP.Mori.isClosed_exceptionalSet f)]
  refine closure_minimal ?_ E.idealSheaf.support.isClosed
  rintro x ⟨hx, hxc⟩
  obtain ⟨C, hCc, hCi, hCd, hxC, y, hy⟩ :=
    MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet
      hf.isVariety_source hf.isVariety_target f hf.comp_eq hbir hf.isIso_app hxc hx
  obtain ⟨Γ, hΓ, hΓC⟩ :=
    MMP.Mori.exists_properCurve_isContractedBy_of_image_eq_singleton (sX := sX) f hCc hCi hCd hy
  have h1 := closure_subset_support_of_neg hQ E Γ (hneg Γ hΓ)
  rw [hΓC] at h1
  exact h1 hxC

/-- The exceptional prime divisor of a birational contraction is any prime `E` which is negative
on every contracted curve: the contracted curves cover the exceptional set and lie in `E`. -/
private theorem eq_of_exceptionalSet_eq_of_neg {W : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    [IsProper sX] (hQ : IsQFactorial sX) {f : X ⟶ W} (hf : IsContraction ℂ sW sX f)
    (hbir : IsBirationalMorphism f) {P E : MMP.Mori.PrimeDivisor X}
    (hP : (MMP.Mori.exceptionalSet f : Set X) = P.support)
    (hneg : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
        IsRIntersectionNumber ℂ sX (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0) : P = E := by
  have hPE : (P.support : Set X) ⊆ E.support := by
    rw [← hP]; exact exceptionalSet_subset_support_of_neg hQ hf hbir hneg
  by_contra hne
  exact MMP.Threefold.Resolution.genericPoint_notMem_support_of_ne hne (hPE (by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl))

end FloorCurves

/-- A curve contracted by a morphism meets its exceptional set: over the biregular locus the
morphism is injective, so a curve inside it would be a point. -/
private theorem exists_mem_closure_exceptionalSet {X W : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (f : X ⟶ W) (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) :
    ∃ y ∈ closure ({Γ.point} : Set X), y ∈ (MMP.Mori.exceptionalSet f : Set X) := by
  by_contra hcon
  push Not at hcon
  have : IsIso (f ∣_ MMP.Mori.biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
  have hinj : Function.Injective ((f ⁻¹ᵁ MMP.Mori.biregularLocus f).ι ≫ f).base := by
    rw [← morphismRestrict_ι]
    exact ((f ∣_ MMP.Mori.biregularLocus f) ≫
      (MMP.Mori.biregularLocus f).ι).isOpenEmbedding.injective
  have hmem : ∀ y ∈ closure ({Γ.point} : Set X), y ∈ f ⁻¹ᵁ MMP.Mori.biregularLocus f := by
    intro y hy
    by_contra h
    exact hcon y hy (MMP.Mori.mem_exceptionalSet.mpr h)
  have hpt : Γ.point ∈ closure ({Γ.point} : Set X) := subset_closure rfl
  have hsub : ∀ y ∈ closure ({Γ.point} : Set X), y = Γ.point := by
    intro y hy
    have := @hinj ⟨y, hmem y hy⟩ ⟨Γ.point, hmem _ hpt⟩ (by
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]
      exact hΓ y hy)
    exact congrArg Subtype.val this
  have hsing : (closure ({Γ.point} : Set X)) = {Γ.point} :=
    Set.eq_singleton_iff_unique_mem.mpr ⟨hpt, hsub⟩
  have hdim := Γ.isProperCurve.dim_eq
  rw [MMP.Chow.topologicalKrullDim_curveSubschemeAt_eq, hsing] at hdim
  have hsub' : Subsingleton (TopologicalSpace.IrreducibleCloseds ({Γ.point} : Set X)) :=
    ⟨fun a b => by
      have hx : ∀ z w : ({Γ.point} : Set X), z = w := fun z w => Subtype.ext (z.2.trans w.2.symm)
      obtain ⟨za, hza⟩ := a.isIrreducible.nonempty
      obtain ⟨zb, hzb⟩ := b.isIrreducible.nonempty
      ext x
      constructor
      · intro _; rw [hx x zb]; exact hzb
      · intro _; rw [hx x za]; exact hza⟩
  have h0 : topologicalKrullDim ({Γ.point} : Set X) ≤ 0 := Order.krullDim_nonpos_of_subsingleton
  rw [hdim] at h0
  exact absurd h0 (by decide)

/-! ### Prime divisors along flips -/

section FlipPrimes

/-- Two prime divisors with the same generic point coincide. -/
private theorem primeDivisor_eq_of_genericPoint_eq {X : Scheme.{0}} {P Q : MMP.Mori.PrimeDivisor X}
    (h : P.genericPoint = Q.genericPoint) : P = Q := by
  by_contra hne
  exact MMP.Threefold.Resolution.genericPoint_notMem_support_of_ne hne (by
    rw [h, AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)

/-- The coefficient of a transform along a map of prime divisors which is injective over `Q`. -/
private theorem mapPrimeDivisors_apply_of_eq_some {X Y : Scheme.{0}} {R : Type*}
    [AddCommMonoid R] {τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    {P : MMP.Mori.PrimeDivisor X} {Q : MMP.Mori.PrimeDivisor Y} (hP : τ P = some Q)
    (huniq : ∀ P', τ P' = some Q → P' = P) (D : DivisorWithCoeffs R X) :
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D Q = D P := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ h₁ h₂ => rw [map_add, Finsupp.add_apply, h₁, h₂, Finsupp.add_apply]
  | single P' r =>
    rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single]
    rcases h : τ P' with _ | Q'
    · have hne : P' ≠ P := fun he => by rw [he, hP] at h; simp at h
      simp only [Option.elim_none, Finsupp.coe_zero, Pi.zero_apply]
      rw [Finsupp.single_apply, if_neg hne]
    · simp only [Option.elim_some]
      rw [Finsupp.single_apply, Finsupp.single_apply]
      by_cases hQ : Q' = Q
      · subst hQ
        rw [if_pos rfl, if_pos (huniq P' h)]
      · have hne : P' ≠ P := fun he => by
          rw [he, hP] at h; exact hQ (Option.some.inj h).symm
        rw [if_neg hQ, if_neg hne]

variable {X X' W : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] [IsIntegral X'] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
  [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
  {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- A proper birational morphism onto a normal variety is biregular at the generic point of every
prime divisor of the target, every prime divisor of the target is the image of one of the source,
and it is injective over its biregular locus. -/
private theorem birational_prime_data (hW : IsNormalVariety ℂ sW) {f : X ⟶ W} [IsProper f]
    (hbir : IsBirationalMorphism f) :
    (∀ Q : MMP.Mori.PrimeDivisor W, Q.genericPoint ∈ MMP.Mori.biregularLocus f) ∧
    (∀ Q : MMP.Mori.PrimeDivisor W, ∃ P : MMP.Mori.PrimeDivisor X,
      f P.genericPoint = Q.genericPoint) ∧
    (∀ P P' : MMP.Mori.PrimeDivisor X, f P.genericPoint = f P'.genericPoint →
      f P.genericPoint ∈ MMP.Mori.biregularLocus f → P = P') := by
  have hV : ∀ Q : MMP.Mori.PrimeDivisor W, Q.genericPoint ∈ MMP.Mori.biregularLocus f := fun Q =>
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hbir
      (by rw [Q.coheight_genericPoint])
  haveI : IsIso (f ∣_ MMP.Mori.biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
  have hinj : Function.Injective ((f ⁻¹ᵁ MMP.Mori.biregularLocus f).ι ≫ f).base := by
    rw [← morphismRestrict_ι]
    exact ((f ∣_ MMP.Mori.biregularLocus f) ≫
      (MMP.Mori.biregularLocus f).ι).isOpenEmbedding.injective
  refine ⟨hV, fun Q => ?_, fun P P' hPP' hmem => ?_⟩
  · obtain ⟨y, hy⟩ := (f ∣_ MMP.Mori.biregularLocus f).surjective ⟨Q.genericPoint, hV Q⟩
    have hfy : f y.1 = Q.genericPoint := by
      have := congrArg Subtype.val hy
      rwa [morphismRestrict_base_coe] at this
    have hcoh : Order.coheight y.1 = 1 := by
      rw [← MMP.Flips.coheight_map_eq_of_isIso_morphismRestrict f (MMP.Mori.biregularLocus f)
        (y := y.1) (by rw [hfy]; exact hV Q), hfy, Q.coheight_genericPoint]
    refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh, ?_⟩
    have h1 : (AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh :
        MMP.Mori.PrimeDivisor X).genericPoint = y.1 :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hcoh
    exact (congrArg f h1).trans hfy
  · have h1 : P.genericPoint ∈ f ⁻¹ᵁ MMP.Mori.biregularLocus f := hmem
    have h2 : P'.genericPoint ∈ f ⁻¹ᵁ MMP.Mori.biregularLocus f :=
      (show f P'.genericPoint ∈ MMP.Mori.biregularLocus f from hPP' ▸ hmem)
    have := @hinj ⟨_, h1⟩ ⟨_, h2⟩ (by
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]; exact hPP')
    exact primeDivisor_eq_of_genericPoint_eq (congrArg Subtype.val this)

/-- **Prime divisors along a roof.** For a proper birational morphism `f : X ⟶ W` onto a normal
variety and a small contraction `f⁺ : X' ⟶ W`, the strict transform `(f⁺)⁻¹_* f_*` of prime
divisors is defined at every prime of `X` not contracted by `f`, is characterized by
`f(η_P) = f⁺(η_E)`, is a bijection onto the prime divisors of `X'` where defined, and carries
the coefficients of every divisor. -/
private theorem roofTransformPrimeDivisor_spec (hW : IsNormalVariety ℂ sW) {f : X ⟶ W}
    [IsProper f] (hbf : IsBirationalMorphism f) {fp : X' ⟶ W} (hfp : IsSmall ℂ sW sX' fp) :
    (∀ (P : MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor W),
      f P.genericPoint = Q.genericPoint → ∃ E : MMP.Mori.PrimeDivisor X',
        MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E) ∧
    (∀ (P : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        f P.genericPoint = fp E.genericPoint) ∧
    (∀ E : MMP.Mori.PrimeDivisor X', ∃ P : MMP.Mori.PrimeDivisor X,
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E) ∧
    (∀ (P P' : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        MMP.Fourfold.flipTransformPrimeDivisor f fp P' = some E → P = P') ∧
    (∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X) (P : MMP.Mori.PrimeDivisor X)
      (E : MMP.Mori.PrimeDivisor X'), MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        flipTransform f fp D E = D P) := by
  classical
  haveI : IsSeparated sW := hW.1.toIsSeparated
  haveI : W.IsSeparated := ⟨by rw [← Limits.terminal.comp_from sW]; infer_instance⟩
  haveI := hfp.isProper
  obtain ⟨hfV, hf2, hf3⟩ := birational_prime_data hW hbf
  obtain ⟨hpV, hp2, hp3⟩ :=
    birational_prime_data hW (MMP.Flips.IsSmall.isBirationalMorphism sW sX' hfp)
  have htr : ∀ (P : MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor W),
      MMP.Mori.RationalMap.transformPrimeDivisor (X := X) (Scheme.Hom.toRationalMap f) P = some Q ↔
        f P.genericPoint = Q.genericPoint := fun P Q =>
    MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P Q
  have hinv : ∀ (Q : MMP.Mori.PrimeDivisor W) (E : MMP.Mori.PrimeDivisor X'),
      fp E.genericPoint = Q.genericPoint →
        MMP.Mori.inverseTransformPrimeDivisor fp Q = some E := fun Q E hE =>
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint hE
      (hE ▸ hpV Q)
  -- the characterization
  have hchar : ∀ (P : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        f P.genericPoint = fp E.genericPoint := by
    intro P E h
    unfold MMP.Fourfold.flipTransformPrimeDivisor at h
    obtain ⟨Q, hQ, hQE⟩ := Option.bind_eq_some_iff.mp h
    rw [(htr P Q).mp hQ,
      (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hQE).1]
  have hmk : ∀ (P : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X')
      (Q : MMP.Mori.PrimeDivisor W), f P.genericPoint = Q.genericPoint →
        fp E.genericPoint = Q.genericPoint →
          MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E := by
    intro P E Q hP hE
    unfold MMP.Fourfold.flipTransformPrimeDivisor
    rw [(htr P Q).mpr hP]
    exact hinv Q E hE
  -- the intermediate prime of a defined transform
  have hmid : ∀ (P : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        ∃ Q : MMP.Mori.PrimeDivisor W, f P.genericPoint = Q.genericPoint ∧
          fp E.genericPoint = Q.genericPoint := by
    intro P E h
    have h' := h
    unfold MMP.Fourfold.flipTransformPrimeDivisor at h'
    obtain ⟨Q, hQ, hQE⟩ := Option.bind_eq_some_iff.mp h'
    exact ⟨Q, (htr P Q).mp hQ,
      (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hQE).1⟩
  refine ⟨fun P Q hQ => ?_, hchar, fun E => ?_, fun P P' E h h' => ?_, fun D P E h => ?_⟩
  · obtain ⟨E, hE⟩ := hp2 Q
    exact ⟨E, hmk P E Q hQ hE⟩
  · obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hfp E
    obtain ⟨P, hP⟩ := hf2 Q
    exact ⟨P, hmk P E Q hP hQ⟩
  · obtain ⟨Q, hQ, -⟩ := hmid P E h
    exact hf3 P P' ((hchar P E h).trans (hchar P' E h').symm) (hQ ▸ hfV Q)
  · obtain ⟨Q, hQ, hEQ⟩ := hmid P E h
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ D) E = D P
    rw [mapPrimeDivisors_apply_of_eq_some (hinv Q E hEQ) (fun Q' hQ' =>
        primeDivisor_eq_of_genericPoint_eq
          ((MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
            hQ').1.symm.trans hEQ)),
      mapPrimeDivisors_apply_of_eq_some ((htr P Q).mpr hQ) (fun P' hP' =>
        hf3 P' P (((htr P' Q).mp hP').trans hQ.symm) (((htr P' Q).mp hP') ▸ hfV Q))]

/-- **Prime divisors along a flip.** For small contractions `f : X ⟶ W ⟵ X' : f⁺`, the strict
transform is a bijection between the prime divisors of `X` and `X'`, characterized by
`f(η_P) = f⁺(η_E)`, and it carries the coefficients of every divisor. -/
private theorem flipTransformPrimeDivisor_spec (hW : IsNormalVariety ℂ sW) {f : X ⟶ W}
    {fp : X' ⟶ W} (hf : IsSmall ℂ sW sX f) (hfp : IsSmall ℂ sW sX' fp) :
    (∀ P : MMP.Mori.PrimeDivisor X, ∃ E : MMP.Mori.PrimeDivisor X',
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E) ∧
    (∀ (P : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        f P.genericPoint = fp E.genericPoint) ∧
    (∀ E : MMP.Mori.PrimeDivisor X', ∃ P : MMP.Mori.PrimeDivisor X,
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E) ∧
    (∀ (P P' : MMP.Mori.PrimeDivisor X) (E : MMP.Mori.PrimeDivisor X'),
      MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        MMP.Fourfold.flipTransformPrimeDivisor f fp P' = some E →
        P = P') ∧
    (∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X) (P : MMP.Mori.PrimeDivisor X)
      (E : MMP.Mori.PrimeDivisor X'), MMP.Fourfold.flipTransformPrimeDivisor f fp P = some E →
        flipTransform f fp D E = D P) := by
  haveI := hf.isProper
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    roofTransformPrimeDivisor_spec hW (MMP.Flips.IsSmall.isBirationalMorphism sW sX hf) hfp
  refine ⟨fun P => ?_, h2, h3, h4, h5⟩
  obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hf P
  exact h1 P Q hQ

end FlipPrimes

/-! ### Numerical equivalence along birational maps -/

section NumericalTransport

open Classical in
/-- The coefficient of a transform along a partial map of prime divisors, as a sum over the
prime divisors mapping to it. -/
private theorem mapPrimeDivisors_apply_eq_sum {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (D : RDivisor X)
    (E : MMP.Mori.PrimeDivisor Y) :
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D E =
      ∑ P ∈ D.support, if τ P = some E then D P else 0 := by
  rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors, Finsupp.liftAddHom_apply, Finsupp.sum,
    Finsupp.finset_sum_apply]
  refine Finset.sum_congr rfl fun P _ => ?_
  rcases τ P with _ | Q
  · simp
  · simp only [Option.elim_some, Finsupp.singleAddHom_apply, Finsupp.single_apply,
      Option.some.injEq]

/-- A transform along a partial map of prime divisors keeps a divisor supported where `B ≥ 1`
supported where the transform of an effective `B` is `≥ 1`. -/
private theorem one_le_mapPrimeDivisors_of_ne_zero {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) {B N : RDivisor X}
    (hB : ∀ P, 0 ≤ B.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (E : MMP.Mori.PrimeDivisor Y)
    (hE : (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ N).coeff E ≠ 0) :
    1 ≤ (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ B).coeff E := by
  classical
  rw [DivisorWithCoeffs.coeff_apply] at hE ⊢
  rw [mapPrimeDivisors_apply_eq_sum] at hE ⊢
  obtain ⟨P, -, hPne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hE
  have hτ : τ P = some E := by
    by_contra h; rw [if_neg h] at hPne; exact hPne rfl
  rw [if_pos hτ] at hPne
  have h1 : 1 ≤ B P := by
    have := hNB P (by rwa [DivisorWithCoeffs.coeff_apply])
    rwa [DivisorWithCoeffs.coeff_apply] at this
  have hPB : P ∈ B.support := Finsupp.mem_support_iff.mpr (by linarith)
  calc (1 : ℝ) ≤ B P := h1
    _ = if τ P = some E then B P else 0 := (if_pos hτ).symm
    _ ≤ ∑ P' ∈ B.support, if τ P' = some E then B P' else 0 :=
      Finset.single_le_sum (f := fun P' => if τ P' = some E then B P' else 0)
        (fun P' _ => by
          split_ifs
          · have := hB P'; rwa [DivisorWithCoeffs.coeff_apply] at this
          · exact le_rfl) hPB

/-- The birational transform commutes with forming the log canonical divisor. -/
private theorem transformDivisor_logCanonicalDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (K : Divisor X) (B : RDivisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (logCanonicalDivisor K B) =
      logCanonicalDivisor (MMP.Mori.RationalMap.transformDivisor φ K)
        (MMP.Mori.RationalMap.transformDivisor φ B) := by
  unfold logCanonicalDivisor
  rw [map_add]
  congr 1
  exact mapPrimeDivisors_toRDivisor _ K

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- An `ℝ`-Cartier divisor has an intersection number with every proper curve. -/
private theorem exists_isRIntersectionNumber {D : RDivisor X} (hD : IsCartierCombination D)
    (C : ProperCurve sX) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX D r L C x := by
  obtain ⟨n, c, M, hM, hDe⟩ := hD
  have hDe' : D = ∑ i, c i • Divisor.toRDivisor (M i) := by
    simpa only [MMP.Flips.toRDivisor_eq_mapCoeffs] using hDe
  subst hDe'
  exact ⟨n, c, M, _, isRIntersectionNumber_sum C c M hM⟩

/-- The zero divisor has intersection number zero with every curve. -/
private theorem isRIntersectionNumber_zero {C : ProperCurve sX} :
    IsRIntersectionNumber ℂ sX (0 : RDivisor X) (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) C 0 := by
  simpa using isRIntersectionNumber_sum C (Fin.elim0 : Fin 0 → ℝ)
    (Fin.elim0 : Fin 0 → Divisor X) (fun i => i.elim0)

/-- Numerically equivalent divisors differ by a numerically trivial one. -/
private theorem isNumericallyTrivialOver_sub (hQ : IsQFactorial sX) {V : Scheme.{0}}
    {g : X ⟶ V} {D₁ D₂ : RDivisor X} (h : IsNumericallyEquivalentOver ℂ sX g D₁ D₂) :
    IsNumericallyTrivialOver ℂ sX g (D₁ - D₂) := by
  obtain ⟨h1, h2, h12⟩ := h
  refine ⟨isCartierCombination_of_isRCartier (hQ.isRCartier _), isCartierCombination_zero',
    fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  obtain ⟨_, a, A, y₁, hy₁⟩ := exists_isRIntersectionNumber h1 C
  obtain ⟨_, b, B, y₂, hy₂⟩ := exists_isRIntersectionNumber h2 C
  have hlin := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).2 _ _ _ _ _ _ _ _ 1 (-1)
    hy₁ hy₂
  rw [one_smul, neg_one_smul, ← sub_eq_add_neg] at hlin
  have e1 := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ _ _ _ _ _ _ hx₁ hlin
  have e2 := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ _ _ _ _ _ _ hx₂
    isRIntersectionNumber_zero
  rw [e1, e2, h12 C hC _ _ _ _ _ _ _ _ hy₁ hy₂]
  ring

/-- Divisors differing by a numerically trivial one are numerically equivalent. -/
private theorem isNumericallyEquivalentOver_of_sub (hQ : IsQFactorial sX) {V : Scheme.{0}}
    {g : X ⟶ V} {D₁ D₂ : RDivisor X} (h : IsNumericallyTrivialOver ℂ sX g (D₁ - D₂)) :
    IsNumericallyEquivalentOver ℂ sX g D₁ D₂ := by
  obtain ⟨-, -, h0⟩ := h
  refine ⟨isCartierCombination_of_isRCartier (hQ.isRCartier _),
    isCartierCombination_of_isRCartier (hQ.isRCartier _),
    fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have hlin := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).2 _ _ _ _ _ _ _ _ 1 (-1)
    hx₁ hx₂
  rw [one_smul, neg_one_smul, ← sub_eq_add_neg] at hlin
  have := h0 C hC _ _ _ _ _ _ _ _ hlin isRIntersectionNumber_zero
  linarith

variable {X' Z : Scheme.{0}} [IsIntegral X'] [CompactSpace X'] [IsLocallyNoetherian X']
  [IsNormal X'] {sX' : X' ⟶ Spec (.of ℂ)} [QuasiCompact sX'] {sZ : Z ⟶ Spec (.of ℂ)}

/-- **Numerical equivalence along a birational map over a base.** A birational map of
`ℚ`-factorial projective varieties over `Z` extracting no divisor carries divisors numerically
equivalent over `Z` to divisors numerically equivalent over `Z`. -/
private theorem isNumericallyEquivalentOver_transformDivisor (hQ : IsQFactorial sX)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ' : IsQFactorial sX')
    (hX'p : MMP.Mori.IsProjectiveVariety ℂ sX') (hZp : MMP.Mori.IsProjectiveVariety ℂ sZ)
    {π : X ⟶ Z} {π' : X' ⟶ Z} (hπ : π ≫ sZ = sX) (hπ' : π' ≫ sZ = sX')
    {φ : X.RationalMap X'} (hφ : MMP.Mori.RationalMap.IsBirational φ)
    (hφZ : MMP.Flips.RationalMap.IsOver π π' φ)
    (hφE : ∀ F, ¬ MMP.Flips.RationalMap.IsInverseExceptional φ F) {D₁ D₂ : RDivisor X}
    (h : IsNumericallyEquivalentOver ℂ sX π D₁ D₂) :
    IsNumericallyEquivalentOver ℂ sX' π' (MMP.Mori.RationalMap.transformDivisor φ D₁)
      (MMP.Mori.RationalMap.transformDivisor φ D₂) := by
  have h0 := (MMP.Fourfold.isNumericallyTrivialOver_transformDivisor_and_pullback_eq sX sX' sZ
    hQ hXp hQ' hX'p hZp π π' hπ hπ' hφ hφZ hφE (isNumericallyTrivialOver_sub hQ h)).1
  rw [map_sub] at h0
  exact isNumericallyEquivalentOver_of_sub hQ' h0

/-- **The floor identity along a birational map.** If `α (K + B) ≡_Z C + N` with `N ≥ 0`
supported where `B ≥ 1`, the same holds for the transforms along a birational map over `Z`
extracting no divisor, with `N` replaced by its transform. -/
private theorem exists_floor_of_isBirational (hQ : IsQFactorial sX)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ' : IsQFactorial sX')
    (hX'p : MMP.Mori.IsProjectiveVariety ℂ sX') (hZp : MMP.Mori.IsProjectiveVariety ℂ sZ)
    {π : X ⟶ Z} {π' : X' ⟶ Z} (hπ : π ≫ sZ = sX) (hπ' : π' ≫ sZ = sX')
    {φ : X.RationalMap X'} (hφ : MMP.Mori.RationalMap.IsBirational φ)
    (hφZ : MMP.Flips.RationalMap.IsOver π π' φ)
    (hφE : ∀ F, ¬ MMP.Flips.RationalMap.IsInverseExceptional φ F) {K : Divisor X}
    {B C N : RDivisor X} {α : ℝ} (hB : ∀ P, 0 ≤ B.coeff P) (hN : ∀ P, 0 ≤ N.coeff P)
    (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hnum : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor K B) (C + N)) :
    ∃ N' : RDivisor X', (∀ P, 0 ≤ N'.coeff P) ∧
      (∀ P, N'.coeff P ≠ 0 → 1 ≤ (MMP.Mori.RationalMap.transformDivisor φ B).coeff P) ∧
      IsNumericallyEquivalentOver ℂ sX' π'
        (α • logCanonicalDivisor (MMP.Mori.RationalMap.transformDivisor φ K)
          (MMP.Mori.RationalMap.transformDivisor φ B))
        (MMP.Mori.RationalMap.transformDivisor φ C + N') := by
  refine ⟨MMP.Mori.RationalMap.transformDivisor φ N, fun P => coeff_mapPrimeDivisors_nonneg hN P,
    one_le_mapPrimeDivisors_of_ne_zero _ hB hNB, ?_⟩
  have h := isNumericallyEquivalentOver_transformDivisor hQ hXp hQ' hX'p hZp hπ hπ' hφ hφZ hφE
    hnum
  have hs : MMP.Mori.RationalMap.transformDivisor φ (α • logCanonicalDivisor K B) =
      α • MMP.Mori.RationalMap.transformDivisor φ (logCanonicalDivisor K B) :=
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_smul _ α _
  rw [hs, transformDivisor_logCanonicalDivisor, map_add] at h
  exact h

end NumericalTransport

/-! ### Principal shifts of real divisors -/

section Principal

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- A principal divisor has degree zero along every proper curve. -/
private theorem degreeOn_principalDivisor (C : ProperCurve sX) (h : (RationalFunctions X)ˣ) :
    (principalDivisor h).degreeOn ℂ sX C.ι C.dim_le (Divisor.isCartier_principalDivisor h) = 0 := by
  haveI := (Divisor.isCartier_principalDivisor h).isInvertibleModule_divisorialSheaf
  haveI := (Divisor.isCartier_zero (X := X)).isInvertibleModule_divisorialSheaf
  exact (degreeOn_eq_of_iso ℂ sX C.ι C.dim_le
    (Divisor.linearlyEquivalent_principalDivisor_zero h).divisorialSheafIso).trans
    (Divisor.degreeOn_zero' ℂ sX C.ι C.dim_le)

/-- Adding a real multiple of a principal divisor does not change intersection numbers. -/
private theorem exists_isRIntersectionNumber_add_principal {D : RDivisor X} {C : ProperCurve sX}
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX D r L C x) (c : ℝ) (h : (RationalFunctions X)ˣ) :
    ∃ (m' : ℕ) (r' : Fin m' → ℝ) (L' : Fin m' → Divisor X),
      IsRIntersectionNumber ℂ sX (D + c • Divisor.toRDivisor (principalDivisor h)) r' L' C x := by
  have hM : ∀ i : Fin 1, ((fun _ : Fin 1 => principalDivisor h) i).IsCartier :=
    fun _ => Divisor.isCartier_principalDivisor h
  have hp := isRIntersectionNumber_sum C (fun _ : Fin 1 => (1 : ℝ))
    (fun _ : Fin 1 => principalDivisor h) hM
  simp only [Fin.sum_univ_one, one_smul] at hp
  have hlin := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).2 _ _ _ _ _ _ _ _ 1 c hx hp
  rw [one_smul, degreeOn_principalDivisor C h] at hlin
  simp only [Int.cast_zero, mul_zero, add_zero, one_mul] at hlin
  exact ⟨_, _, _, hlin⟩

/-- Intersection numbers of `D + c · div(h)` and of `D` agree. -/
private theorem eq_of_isRIntersectionNumber_add_principal {D : RDivisor X} {C : ProperCurve sX}
    {m m' : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {r' : Fin m' → ℝ} {L' : Fin m' → Divisor X}
    {x x' : ℝ} (hx : IsRIntersectionNumber ℂ sX D r L C x) (c : ℝ) (h : (RationalFunctions X)ˣ)
    (hx' : IsRIntersectionNumber ℂ sX (D + c • Divisor.toRDivisor (principalDivisor h)) r' L' C
      x') :
    x' = x := by
  obtain ⟨_, _, _, hy⟩ := exists_isRIntersectionNumber_add_principal hx c h
  exact (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ _ _ _ _ _ _ hx' hy

/-- Relative nefness is unchanged by a principal shift. -/
private theorem isRelativelyNef_add_principal {V : Scheme.{0}} {g : X ⟶ V} {D : RDivisor X}
    (hD : IsRelativelyNef ℂ sX g D) (c : ℝ) (h : (RationalFunctions X)ˣ) :
    IsRelativelyNef ℂ sX g (D + c • Divisor.toRDivisor (principalDivisor h)) := by
  obtain ⟨m, r, L, hL, hDe, hnef⟩ := hD
  have hL' : ∀ j, (Fin.append L (fun _ : Fin 1 => principalDivisor h) j).IsCartier :=
    Fin.addCases (fun j => by simpa using hL j)
      (fun _ => by simpa using Divisor.isCartier_principalDivisor h)
  refine ⟨m + 1, Fin.append r (fun _ => c), Fin.append L (fun _ => principalDivisor h), hL', ?_,
    fun C hC x hx => ?_⟩
  · rw [sum_append_smul_toRDivisor, ← hDe, Fin.sum_univ_one]
  · have hx0 := isRIntersectionNumber_sum C r L hL
    rw [← hDe] at hx0
    rw [eq_of_isRIntersectionNumber_add_principal hx0 c h hx]
    exact hnef C hC _ hx0

/-- Numerical equivalence is unchanged by a principal shift. -/
private theorem isNumericallyEquivalentOver_add_principal (hQ : IsQFactorial sX) {V : Scheme.{0}}
    {g : X ⟶ V} {D₁ D₂ : RDivisor X} (h12 : IsNumericallyEquivalentOver ℂ sX g D₁ D₂) (c : ℝ)
    (h : (RationalFunctions X)ˣ) :
    IsNumericallyEquivalentOver ℂ sX g (D₁ + c • Divisor.toRDivisor (principalDivisor h)) D₂ := by
  obtain ⟨h1, h2, he⟩ := h12
  refine ⟨isCartierCombination_of_isRCartier (hQ.isRCartier _), h2,
    fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  obtain ⟨_, a, A, y, hy⟩ := exists_isRIntersectionNumber h1 C
  rw [eq_of_isRIntersectionNumber_add_principal hy c h hx₁]
  exact he C hC _ _ _ _ _ _ _ _ hy hx₂

/-- A Cartier divisor linearly equivalent to a relatively ample one is relatively ample. -/
private theorem isRelativelyAmpleCartier_add_principal {V : Scheme.{0}} {g : X ⟶ V}
    {L : Divisor X} (hL : IsRelativelyAmpleCartier g L) (h : (RationalFunctions X)ˣ) :
    IsRelativelyAmpleCartier g (L + principalDivisor h) := by
  obtain ⟨hc, hamp⟩ := hL
  have hc' : (L + principalDivisor h).IsCartier := hc.add (Divisor.isCartier_principalDivisor h)
  refine ⟨hc', fun U hU => ?_⟩
  haveI := hc.isInvertibleModule_divisorialSheaf
  haveI := hc'.isInvertibleModule_divisorialSheaf
  have e : (L + principalDivisor h).divisorialSheaf ≅ L.divisorialSheaf :=
    Divisor.LinearlyEquivalent.divisorialSheafIso ⟨h, add_sub_cancel_left L _⟩
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ U).ι.toLRSHom.toShHom).mapIso e)).2
    (hamp U hU)

/-- Relative ampleness of a real divisor is unchanged by a principal shift. -/
private theorem isRelativelyAmple_add_principal {V : Scheme.{0}} {g : X ⟶ V} {A : RDivisor X}
    (hA : IsRelativelyAmple g A) (c : ℝ) (h : (RationalFunctions X)ˣ) :
    IsRelativelyAmple g (A + c • Divisor.toRDivisor (principalDivisor h)) := by
  classical
  obtain ⟨m, r, L, hm, hr, hL, hAe⟩ := hA
  rcases eq_or_ne c 0 with rfl | hc
  · rw [zero_smul, add_zero]; exact ⟨m, r, L, hm, hr, hL, hAe⟩
  set j₀ : Fin m := ⟨0, hm⟩
  obtain ⟨N, hN⟩ := exists_nat_gt (|c| / r j₀)
  have hNpos : (0 : ℝ) < N := lt_of_le_of_lt (div_nonneg (abs_nonneg c) (hr j₀).le) hN
  set ε : ℝ := |c| / N with hεdef
  have hε : 0 < ε := div_pos (abs_pos.mpr hc) hNpos
  have hεr : ε < r j₀ := by
    rw [hεdef, div_lt_iff₀ hNpos]
    rw [div_lt_iff₀ (hr j₀)] at hN
    linarith
  set k : ℤ := if 0 < c then (N : ℤ) else -(N : ℤ) with hkdef
  have hk : ε * (k : ℝ) = c := by
    rw [hεdef, hkdef]
    split_ifs with hcpos
    · rw [abs_of_pos hcpos]; push_cast; field_simp
    · rw [abs_of_neg (lt_of_le_of_ne (not_lt.mp hcpos) hc)]; push_cast; field_simp
  have hpk : Divisor.toRDivisor (principalDivisor (h ^ k)) =
      (k : ℝ) • Divisor.toRDivisor (principalDivisor h) := by
    have e1 : principalDivisor (h ^ k) = k • principalDivisor h := by
      have := map_zsmul (principalDivisorHom (X := X)) k (Additive.ofMul h)
      simpa using this
    rw [e1, map_zsmul, Int.cast_smul_eq_zsmul]
  refine ⟨m + 1, Fin.append (fun j => r j - if j = j₀ then ε else 0) (fun _ => ε),
    Fin.append L (fun _ => L j₀ + principalDivisor (h ^ k)), by omega,
    Fin.addCases (fun j => ?_) (fun _ => by simpa using hε),
    Fin.addCases (fun j => by simpa using hL j)
      (fun _ => by simpa using isRelativelyAmpleCartier_add_principal (hL j₀) (h ^ k)), ?_⟩
  · rw [sum_append_smul_toRDivisor, Fin.sum_univ_one]
    simp only [sub_smul, Finset.sum_sub_distrib, ite_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true]
    rw [← hAe, map_add, hpk, ← hk]
    module
  · simp only [Fin.append_left]
    split_ifs with hj
    · subst hj; linarith
    · simpa using hr j

end Principal

/-! ### Real flip steps for principal modifications of the boundary -/

section FlipStepShift

variable {X X' W : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] [IsIntegral X'] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
  [IsLocallyNoetherian W] [IsNormal W]
  {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

private theorem logCanonicalDivisor_add {Y : Scheme.{0}} (K : Divisor Y) (B D : RDivisor Y) :
    logCanonicalDivisor K (B + D) = logCanonicalDivisor K B + D := by
  unfold logCanonicalDivisor; rw [add_assoc]

/-- The negative of a divisor whose negative is relatively ample is a Cartier combination. -/
private theorem isCartierCombination_of_isRelativelyAntiAmple {Y V : Scheme.{0}}
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] {g : Y ⟶ V}
    {D : RDivisor Y}
    (h : IsRelativelyAntiAmple g D) : IsCartierCombination D := by
  obtain ⟨m, r, L, -, -, hL, hD⟩ := h
  have hD' : D = ∑ j, (-r j) • Divisor.toRDivisor (L j) := by
    rw [← neg_neg D, hD, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun j _ => (neg_smul _ _).symm
  exact isCartierCombination_of_eq_sum (fun j => (hL j).choose) hD'

/-- A real flip step for `(K, B)` is a real flip step for a principal modification
`B + c · div(u)` of the boundary, whose strict transform is `B' + c · div(u')`. -/
private theorem IsRealFlipStep.add_principal {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {f : X ⟶ W} {fp : X' ⟶ W}
    (h : IsRealFlipStep sX sW sX' K B K' B' f fp) (c : ℝ) (u : (RationalFunctions X)ˣ)
    (u' : (RationalFunctions X')ˣ)
    (htr : flipTransform f fp (B + c • Divisor.toRDivisor (principalDivisor u)) =
      B' + c • Divisor.toRDivisor (principalDivisor u')) :
    IsRealFlipStep sX sW sX' K (B + c • Divisor.toRDivisor (principalDivisor u)) K'
      (B' + c • Divisor.toRDivisor (principalDivisor u')) f fp := by
  have hne := h.isNegativeExtremalContraction
  have hanti : IsRelativelyAntiAmple f
      (logCanonicalDivisor K (B + c • Divisor.toRDivisor (principalDivisor u))) := by
    have := isRelativelyAmple_add_principal hne.isRelativelyAntiAmple (-c) u
    show IsRelativelyAmple f _
    rw [logCanonicalDivisor_add, neg_add, ← neg_smul]
    exact this
  exact
    { isQuasiProjectiveVariety_target := h.isQuasiProjectiveVariety_target
      isNegativeExtremalContraction :=
        { isNormalVariety_source := hne.isNormalVariety_source
          isNormalVariety_target := hne.isNormalVariety_target
          isCartierCombination := isCartierCombination_of_isRelativelyAntiAmple hanti
          isContraction := hne.isContraction
          isRelativelyAntiAmple := hanti
          relativePicardNumber_eq_one := hne.relativePicardNumber_eq_one }
      isSmall := h.isSmall
      isBirationalMorphism := h.isBirationalMorphism
      isProjectiveMorphism := h.isProjectiveMorphism
      not_isIso := h.not_isIso
      isCanonicalDivisor_flip := h.isCanonicalDivisor_flip
      isSmall_flip := h.isSmall_flip
      isBirationalMorphism_flip := h.isBirationalMorphism_flip
      isProjectiveMorphism_flip := h.isProjectiveMorphism_flip
      not_isIso_flip := h.not_isIso_flip
      relativePicardNumber_flip := h.relativePicardNumber_flip
      isRelativelyAmple_flip := by
        rw [logCanonicalDivisor_add]
        exact isRelativelyAmple_add_principal h.isRelativelyAmple_flip c u'
      eq_flipTransform := htr.symm }

end FlipStepShift

/-! ### Crepant invariance of log discrepancies -/

section Crepant

variable {Y W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)}

/-- **Crepant invariance of log discrepancies.** If `K_Y + Δ_Y = f^*(K_W + Δ_W)` for a proper
birational morphism `f : Y ⟶ W`, with `K_W = div(ω)` and `K_Y = div(f^*ω)`, then a divisor over
`Y` and the same divisor regarded over `W` have a common log discrepancy. -/
private theorem exists_isLogDiscrepancy_compDivisorOver (hW : IsNormalVariety ℂ sW) (f : Y ⟶ W)
    (hY : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] [IsDominant f] [LocallyOfFiniteType sW]
    [LocallyOfFiniteType (f ≫ sW)] (hf : IsBirationalMorphism f) {n : ℕ}
    (hn : topologicalKrullDim W = n) (ω : MMP.Mori.RationalPluriForms sW n 1) (hω : ω ≠ 0)
    (hK : (MMP.Mori.divisorOfForm ω).IsCanonicalDivisor sW n)
    (hKY : (MMP.Mori.divisorOfForm
      (MMP.Mori.pullbackRationalPluriForms sW f ω)).IsCanonicalDivisor (f ≫ sW) n)
    {ΔW : RDivisor W} {ΔY : RDivisor Y}
    (hcrep : IsRCartierPullback f (Divisor.toRDivisor (MMP.Mori.divisorOfForm ω) + ΔW)
      (Divisor.toRDivisor (MMP.Mori.divisorOfForm
        (MMP.Mori.pullbackRationalPluriForms sW f ω)) + ΔY))
    (E : MMP.Mori.DivisorOver ℂ (f ≫ sW)) (hEp : IsProper E.f) :
    ∃ a, MMP.Intersection.IsLogDiscrepancy (f ≫ sW) n ΔY E a ∧
      MMP.Intersection.IsLogDiscrepancy sW n ΔW (MMP.Mori.compDivisorOver f hY hf E) a := by
  classical
  haveI := E.isIntegral
  haveI := E.isNormal
  haveI := E.isLocallyNoetherian
  haveI := E.isDominant
  haveI : CompactSpace E.Y := QuasiCompact.compactSpace_of_compactSpace E.f
  obtain ⟨m, r, L, L', hL, hKΔ, hpb, hKYΔ⟩ := hcrep
  choose hB hL' using hpb
  have hL'c : ∀ j, (L' j).IsCartier := fun j => (hL' j).isCartier (hL j)
  choose L'' hL'' using fun j =>
    MMP.Threefold.Bridges.exists_isPullback_of_isDominant E.f (hL'c j)
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sW) hn
  have hωY : MMP.Mori.pullbackRationalPluriForms sW f ω ≠ 0 :=
    MMP.Fourfold.Oai4C1.Main.pullbackRationalPluriForms_ne_zero f hf.functionFieldMap_bijective
      hd hω
  refine ⟨1 + (E.ordPullback (MMP.Mori.pullbackRationalPluriForms sW f ω) : ℝ) -
      ∑ j, r j * ((L'' j).coeff E.E : ℝ),
    ⟨hY, hEp, _, hωY, ⟨_, hKY, fun Γ => rfl⟩, m, r, L', L'', hL'c, fun Γ => ?_,
      fun j => ⟨_, hL'' j⟩, rfl⟩,
    ⟨hW, inferInstanceAs (IsProper (E.f ≫ f)), ω, hω, ⟨_, hK, fun Γ => rfl⟩, m, r, L, L'', hL,
      fun Γ => ?_, fun j => ⟨_, MMP.ProgramBaseChange.divisor_isPullback_comp rfl (hL' j) (hL'' j)
        (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp _ _)⟩, ?_⟩⟩
  · have := congrArg (fun D : RDivisor Y => D.coeff Γ) hKYΔ
    simpa only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor,
      MMP.Mori.coeff_divisorOfForm, MMP.Flips.coeff_sum_smul_toRDivisor] using this
  · have := congrArg (fun D : RDivisor W => D.coeff Γ) hKΔ
    simpa only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor,
      MMP.Mori.coeff_divisorOfForm, MMP.Flips.coeff_sum_smul_toRDivisor] using this
  · have hord : (MMP.Mori.compDivisorOver f hY hf E).ordPullback ω =
        E.ordPullback (MMP.Mori.pullbackRationalPluriForms sW f ω) := by
      rw [MMP.Threefold.Mori.ModelIndependence.ordPullback_eq_of_valuation_eq hW hn
        ((MMP.Mori.valuation_compDivisorOver f hY hf E).trans
          (MMP.Mori.IsPair.valuation_compDivisorOver f hY hf E).symm) ω]
      exact MMP.Mori.IsPair.ordPullback_compDivisorOver hd f hY hf E ω
    rw [hord]
    rfl

/-- **Positivity of the exceptional log discrepancies descends along a crepant proper birational
morphism**, provided the prime divisors of `Y` mapped to codimension `≥ 2` have coefficient
`< 1` in `Δ_Y`. -/
private theorem pos_of_isExceptional_of_crepant (hW : IsNormalVariety ℂ sW) (f : Y ⟶ W)
    (hY : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] [IsDominant f] [LocallyOfFiniteType sW]
    [LocallyOfFiniteType (f ≫ sW)] (hf : IsBirationalMorphism f) {n : ℕ}
    (hn : topologicalKrullDim W = n) (ω : MMP.Mori.RationalPluriForms sW n 1) (hω : ω ≠ 0)
    (hK : (MMP.Mori.divisorOfForm ω).IsCanonicalDivisor sW n)
    (hKY : (MMP.Mori.divisorOfForm
      (MMP.Mori.pullbackRationalPluriForms sW f ω)).IsCanonicalDivisor (f ≫ sW) n)
    {ΔW : RDivisor W} {ΔY : RDivisor Y}
    (hcrep : IsRCartierPullback f (Divisor.toRDivisor (MMP.Mori.divisorOfForm ω) + ΔW)
      (Divisor.toRDivisor (MMP.Mori.divisorOfForm
        (MMP.Mori.pullbackRationalPluriForms sW f ω)) + ΔY))
    (hpos : ∀ (n' : ℕ) (E : MMP.Mori.DivisorOver ℂ (f ≫ sW)) (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy (f ≫ sW) n' ΔY E a → 0 < a)
    (hcoeff : ∀ P : MMP.Mori.PrimeDivisor Y, 2 ≤ Order.coheight (f P.genericPoint) →
      ΔY.coeff P < 1) :
    ∀ (n' : ℕ) (E : MMP.Mori.DivisorOver ℂ sW) (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sW n' ΔW E a → 0 < a := by
  intro n' E a hE ha
  obtain ⟨E', hE'⟩ := MMP.Mori.exists_divisorOver_comap_eq hY hf E
  obtain ⟨E'', hE''⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hY E'
  obtain ⟨a'', h1, h2⟩ := exists_isLogDiscrepancy_compDivisorOver hW f hY hf hn ω hω hK hKY hcrep
    E''.toDivisorOver E''.isProper
  have hv : (MMP.Mori.compDivisorOver f hY hf E''.toDivisorOver).valuation = E.valuation := by
    rw [MMP.Mori.valuation_compDivisorOver, hE', ← hE'']
  have haa : a = a'' := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha h2 hv.symm
  rw [haa]
  by_cases hex : E''.toDivisorOver.IsExceptional
  · exact hpos n E''.toDivisorOver a'' hex h1
  · obtain ⟨P, hP⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hY
        E''.toDivisorOver hex
    have hKYc : RDivisor.IsRCartier (Divisor.toRDivisor (MMP.Mori.divisorOfForm
        (MMP.Mori.pullbackRationalPluriForms sW f ω)) + ΔY) := by
      obtain ⟨m, r, L, L', hL, -, hpb, hKYΔ⟩ := hcrep
      choose hB hL' using hpb
      refine ⟨m, r, L', fun j => (hL' j).isCartier (hL j), fun Γ => ?_⟩
      rw [hKYΔ, MMP.Flips.coeff_sum_smul_toRDivisor]
    have hlogP := isLogDiscrepancy_ofPrimeDivisor hY hKY hKYc P
    have hPv : a'' = 1 - ΔY.coeff P :=
      MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq h1 hlogP hP
    -- the image of `P` has codimension at least two
    have hcod := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_codimension hW E).mp hE
    have hvP : E.valuation = (MMP.Mori.compDivisorOver f hY hf
        (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hY P)).valuation := by
      rw [← hv, MMP.Mori.valuation_compDivisorOver, MMP.Mori.valuation_compDivisorOver, hP]
    rw [MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hW.1 hvP,
      MMP.Positivity.DivisorOver.codimension_center] at hcod
    have hcoh : 2 ≤ Order.coheight (f P.genericPoint) := by
      have : (MMP.Mori.compDivisorOver f hY hf (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hY P)).f
          (MMP.Mori.compDivisorOver f hY hf
            (MMP.Mori.DivisorOver.ofPrimeDivisor ℂ hY P)).E.genericPoint = f P.genericPoint := by
        change (𝟙 Y ≫ f) P.genericPoint = f P.genericPoint
        rw [Category.id_comp]
      rw [this] at hcod
      exact hcod
    linarith [hcoeff P hcoh]

end Crepant

/-! ### Roofs: transforms, pull-backs and log discrepancies along a step -/

section Roof

variable {Y Y' W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y]
  [IsNormal Y] [IsIntegral Y'] [CompactSpace Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- The strict transform along `f` followed by the identity is the push-forward along `f`. -/
private theorem flipTransform_id_right (hW : IsNormalVariety ℂ sW) (f : Y ⟶ W) {R : Type}
    [AddCommMonoid R] (D : DivisorWithCoeffs R Y) :
    flipTransform f (𝟙 W) D =
      MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) D := by
  have hV := (birational_prime_data hW (MMP.Mori.isBirationalMorphism_of_isIso (𝟙 W))).1
  have hinv : ∀ Q : MMP.Mori.PrimeDivisor W,
      MMP.Mori.inverseTransformPrimeDivisor (𝟙 W) Q = some Q := fun Q =>
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint (E := Q)
      (show (𝟙 W : W ⟶ W) Q.genericPoint = Q.genericPoint from rfl) (hV Q)
  change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
    (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) D) = _
  ext Q
  rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply]
  exact mapPrimeDivisors_apply_of_eq_some (hinv Q)
    (fun Q' h => Option.some.inj ((hinv Q').symm.trans h)) _

/-- The push-forward of a real pull-back is the divisor pulled back. -/
private theorem transformDivisor_of_isRCartierPullback (hW : IsNormalVariety ℂ sW) {f : Y ⟶ W}
    (hY : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] (hf : IsBirationalMorphism f)
    {M : RDivisor W} {G : RDivisor Y} (h : IsRCartierPullback f M G) :
    MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) G = M := by
  obtain ⟨m, r, L, L', hL, rfl, hp, rfl⟩ := h
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  obtain ⟨hB, hpj⟩ := hp j
  have h1 : MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f)
      (r j • Divisor.toRDivisor (L' j)) = r j • Divisor.toRDivisor
        (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) (L' j)) := by
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (r j • Divisor.toRDivisor (L' j)) =
      r j • Divisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (L' j))
    rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_smul, mapPrimeDivisors_toRDivisor]
  rw [h1, MMP.Positivity.transformDivisor_of_isPullback_divisor hW hY hf (hL j) hpj]

/-- An `ℝ`-Cartier divisor is its own pull-back along the identity. -/
private theorem isRCartierPullback_id {M : RDivisor W} (hM : RDivisor.IsRCartier M) :
    IsRCartierPullback (𝟙 W) M M := by
  obtain ⟨n, c, L, hL, hMe⟩ := exists_eq_sum_of_isRCartier hM
  exact ⟨n, c, L, L, hL, hMe, fun j =>
    ⟨MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant (𝟙 W) (L j),
      MMP.Mori.divisor_isPullback_id (L j) _⟩, hMe⟩

/-- The push-forward to the base of a roof of the strict transform is the push-forward. -/
private theorem transformDivisor_flipTransform (hW : IsNormalVariety ℂ sW) {f : Y ⟶ W}
    (hYn : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] (hbf : IsBirationalMorphism f)
    {fp : Y' ⟶ W} (hfp : IsSmall ℂ sW sY' fp) (D : Divisor Y) :
    MMP.Mori.RationalMap.transformDivisor (X := Y') (Scheme.Hom.toRationalMap fp)
        (flipTransform f fp D) =
      MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) D := by
  haveI := hfp.isProper
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp
  have hY'n : IsNormalVariety ℂ (fp ≫ sW) := by
    rw [hfp.comp_eq]; exact ⟨hfp.isVariety_source, inferInstance⟩
  obtain ⟨-, hchar, hsurj, -, hcoeff⟩ := roofTransformPrimeDivisor_spec hW hbf hfp
  obtain ⟨-, hp2, -⟩ := birational_prime_data hW hbfp
  ext Q
  rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply]
  obtain ⟨E, hEQ⟩ := hp2 Q
  obtain ⟨P, hP⟩ := hsurj E
  rw [MMP.Flips.transformDivisor_apply_of_map_genericPoint_eq hW hY'n hbfp hEQ, hcoeff _ P E hP,
    MMP.Flips.transformDivisor_apply_of_map_genericPoint_eq hW hYn hbf ((hchar P E hP).trans hEQ)]

/-- The strict transform along a roof of the divisor of the pull-back of a rational function on
the base is the divisor of its pull-back. -/
private theorem flipTransform_principalDivisor_pullback_roof (hW : IsNormalVariety ℂ sW)
    {f : Y ⟶ W} (hYn : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] (hbf : IsBirationalMorphism f)
    {fp : Y' ⟶ W} (hfp : IsSmall ℂ sW sY' fp) (g : (RationalFunctions W)ˣ) :
    haveI : IsDominant f := hbf.isDominant
    haveI : IsDominant fp := (MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp).isDominant
    flipTransform f fp (principalDivisor (pullbackRationalFunction f g
        (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant f _))) =
      principalDivisor (pullbackRationalFunction fp g
        (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fp _)) := by
  haveI : IsDominant f := hbf.isDominant
  haveI : IsDominant fp := (MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp).isDominant
  haveI := hfp.isProper
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp
  have hY'n : IsNormalVariety ℂ (fp ≫ sW) := by
    rw [hfp.comp_eq]; exact ⟨hfp.isVariety_source, inferInstance⟩
  obtain ⟨-, hchar, hsurj, -, hcoeff⟩ := roofTransformPrimeDivisor_spec hW hbf hfp
  ext E
  obtain ⟨P, hP⟩ := hsurj E
  obtain ⟨Q, hEQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hfp E
  have hQ : f P.genericPoint = Q.genericPoint := (hchar P E hP).trans hEQ
  rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, hcoeff _ P E hP]
  have h1 := MMP.Flips.transformDivisor_apply_of_map_genericPoint_eq hW hYn hbf hQ
    (principalDivisor (pullbackRationalFunction f g
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant f _)))
  have h2 := MMP.Flips.transformDivisor_apply_of_map_genericPoint_eq hW hY'n hbfp hEQ
    (principalDivisor (pullbackRationalFunction fp g
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fp _)))
  rw [MMP.Positivity.transformDivisor_principalDivisor_pullback hW hYn hbf] at h1
  rw [MMP.Positivity.transformDivisor_principalDivisor_pullback hW hY'n hbfp] at h2
  exact h1.symm.trans h2

/-- **Positivity of the exceptional log discrepancies ascends along a crepant proper birational
morphism.** -/
private theorem pos_of_isExceptional_of_crepant_up (hW : IsNormalVariety ℂ sW) (f : Y ⟶ W)
    (hY : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] [IsDominant f] [LocallyOfFiniteType sW]
    [LocallyOfFiniteType (f ≫ sW)] (hf : IsBirationalMorphism f) {n : ℕ}
    (hn : topologicalKrullDim W = n) (ω : MMP.Mori.RationalPluriForms sW n 1) (hω : ω ≠ 0)
    (hK : (MMP.Mori.divisorOfForm ω).IsCanonicalDivisor sW n)
    (hKY : (MMP.Mori.divisorOfForm
      (MMP.Mori.pullbackRationalPluriForms sW f ω)).IsCanonicalDivisor (f ≫ sW) n)
    {ΔW : RDivisor W} {ΔY : RDivisor Y}
    (hcrep : IsRCartierPullback f (Divisor.toRDivisor (MMP.Mori.divisorOfForm ω) + ΔW)
      (Divisor.toRDivisor (MMP.Mori.divisorOfForm
        (MMP.Mori.pullbackRationalPluriForms sW f ω)) + ΔY))
    (hpos : ∀ (n' : ℕ) (E : MMP.Mori.DivisorOver ℂ sW) (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sW n' ΔW E a → 0 < a) :
    ∀ (n' : ℕ) (E : MMP.Mori.DivisorOver ℂ (f ≫ sW)) (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy (f ≫ sW) n' ΔY E a → 0 < a := by
  intro n' E a hE ha
  obtain ⟨a', h1, h2⟩ :=
    exists_isLogDiscrepancy_compDivisorOver hW f hY hf hn ω hω hK hKY hcrep E ha.2.1
  have hn' : n' = n := by
    obtain ⟨-, -, -, -, ⟨K', hK', -⟩, -⟩ := ha
    have := hK'.topologicalKrullDim_eq.symm.trans hKY.topologicalKrullDim_eq
    exact_mod_cast this
  subst hn'
  have haa : a = a' := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha h1 rfl
  rw [haa]
  refine hpos n' _ a' ?_ h2
  rw [MMP.Mori.DivisorOver.isExceptional_iff_two_le_codimension hW,
    MMP.Positivity.DivisorOver.codimension_center]
  rw [MMP.Mori.DivisorOver.isExceptional_iff_two_le_codimension hY,
    MMP.Positivity.DivisorOver.codimension_center] at hE
  change 2 ≤ Order.coheight ((E.f ≫ f) E.E.genericPoint)
  rw [Scheme.Hom.comp_apply]
  by_contra hlt
  have hle : Order.coheight (f (E.f E.E.genericPoint)) ≤ 1 := by
    by_contra h
    push Not at h
    exact hlt (by simpa [one_add_one_eq_two] using Order.add_one_le_of_lt h)
  have hmem : E.f E.E.genericPoint ∈ f ⁻¹ᵁ MMP.Mori.biregularLocus f :=
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hf hle
  rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hmem] at hle
  exact absurd (hE.trans hle) (by decide)

end Roof

/-! ### The contraction of a step -/

section Contraction

variable {Y W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- A surjective morphism of varieties does not raise dimension: a general fibre has a component
of dimension `dim X - dim Y ≥ 0`. -/
private theorem topologicalKrullDim_le_of_surjective {X V : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sV : V ⟶ Spec (.of ℂ)} [MMP.Mori.IsVariety ℂ sX] [MMP.Mori.IsVariety ℂ sV] (g : X ⟶ V)
    (hg : g ≫ sV = sX) (hs : Function.Surjective g) :
    topologicalKrullDim V ≤ topologicalKrullDim X := by
  haveI : IsDominant g := ⟨hs.denseRange⟩
  obtain ⟨-, ⟨U, hUd, hU⟩, -⟩ := MMP.topologicalKrullDim_fiber_of_isDominant ℂ sX sV g hg
  obtain ⟨v, hv⟩ := hUd.nonempty
  obtain ⟨x, rfl⟩ := hs v
  obtain ⟨T, hT, hxT⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    ({g.asFiber x} : Set (g.fiber (g x))) isIrreducible_singleton
  have h0 : 0 ≤ topologicalKrullDim T := by
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds T) :=
      ⟨⟨closure {(⟨g.asFiber x, hxT rfl⟩ : T)}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    exact Order.krullDim_nonneg
  rw [← hU _ hv T hT]
  exact le_add_of_nonneg_left h0

/-- A morphism between projective varieties over `ℂ` is projective. -/
private theorem isProjectiveMorphism_of_comp_eq {X V : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sV : V ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hV : MMP.Mori.IsProjectiveVariety ℂ sV) {g : X ⟶ V} (hg : g ≫ sV = sX) :
    IsProjectiveMorphism g := by
  haveI : IsSeparated sV := hV.toIsVariety.toIsSeparated
  exact IsProjectiveMorphism.of_comp g sV (by rw [hg]; exact hX.isProjective)

/-- A point outside the exceptional set of `MMP.Mori.exceptionalSet` (over whose image the
morphism is biregular) has a neighbourhood on which the morphism is an open immersion. -/
private theorem flips_exceptionalSet_subset {X V : Scheme.{0}} (g : X ⟶ V) :
    MMP.Flips.exceptionalSet g ⊆ (MMP.Mori.exceptionalSet g : Set X) := by
  intro x hx
  by_contra hx'
  have hU : g x ∈ MMP.Mori.biregularLocus g := by
    by_contra h; exact hx' (MMP.Mori.mem_exceptionalSet.mpr h)
  have : IsIso (g ∣_ MMP.Mori.biregularLocus g) := MMP.Mori.isBiregular_biregularLocus g
  refine hx ⟨g ⁻¹ᵁ MMP.Mori.biregularLocus g, hU, ?_⟩
  rw [← morphismRestrict_ι]
  infer_instance

/-- **Trichotomy.** An extremal contraction of a `ℚ`-factorial projective variety is divisorial,
small, or of fibre type. -/
private theorem divisorial_or_isSmall_or_dim_lt {E : RDivisor Y} {f : Y ⟶ W}
    (hQ : IsQFactorial sY) (hYp : MMP.Mori.IsProjectiveVariety ℂ sY)
    (hWp : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hf : IsNegativeExtremalContraction ℂ sY sW E f) [IsProper sY] (P₀ : MMP.Mori.PrimeDivisor Y)
    (hneg : ∀ Γ : ProperCurve sY, Γ.IsContractedBy f →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor Y) (x : ℝ),
        IsRIntersectionNumber ℂ sY (Finsupp.single P₀ (1 : ℝ)) r L Γ x → x < 0) :
    (IsBirationalMorphism f ∧
        ∃ P : MMP.Mori.PrimeDivisor Y, (MMP.Mori.exceptionalSet f : Set Y) = P.support) ∨
      IsSmall ℂ sW sY f ∨ topologicalKrullDim W < topologicalKrullDim Y := by
  have hc := hf.isContraction
  rcases lt_or_ge (topologicalKrullDim W) (topologicalKrullDim Y) with hlt | hge
  · exact Or.inr (Or.inr hlt)
  haveI : MMP.Mori.IsVariety ℂ sY := hc.isVariety_source
  haveI : MMP.Mori.IsVariety ℂ sW := hc.isVariety_target
  haveI := hc.isProper
  haveI : Surjective f := Scheme.Hom.surjective_of_isIso_app f hc.isIso_app
  have hdim : topologicalKrullDim Y = topologicalKrullDim W :=
    le_antisymm hge (topologicalKrullDim_le_of_surjective f hc.comp_eq f.surjective)
  have hbc : IsBirationalContraction ℂ sW sY f := ⟨hc, hdim⟩
  have hbir : IsBirationalMorphism f := hbc.surjective_and_isBirational.2
  by_cases hs : IsSmall ℂ sW sY f
  · exact Or.inr (Or.inl hs)
  obtain ⟨F, hF⟩ := MMP.Flips.exists_primeDivisor_exceptionalSet_eq_support_of_not_isSmall sY sW hQ
    hf.isNormalVariety_target f hbc (isProjectiveMorphism_of_comp_eq hYp hWp hc.comp_eq)
    hf.relativePicardNumber_eq_one hs
  have h1 : (MMP.Mori.exceptionalSet f : Set Y) ⊆ P₀.support :=
    exceptionalSet_subset_support_of_neg hQ hc hbir hneg
  have h2 : MMP.Flips.exceptionalSet f ⊆ (MMP.Mori.exceptionalSet f : Set Y) :=
    flips_exceptionalSet_subset f
  have hFP : F = P₀ := by
    by_contra hne
    exact MMP.Threefold.Resolution.genericPoint_notMem_support_of_ne hne (h1 (h2 (by
      rw [hF, AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)))
  refine Or.inl ⟨hbir, P₀, h1.antisymm ?_⟩
  rw [← hFP, ← hF]
  exact h2

/-- The exceptional set of a small contraction has codimension at least two. -/
private theorem two_le_closedsCodimension_exceptionalSet_of_isSmall {X V : Scheme.{0}}
    [IsIntegral X] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] {sX : X ⟶ Spec (.of ℂ)}
    {sV : V ⟶ Spec (.of ℂ)} {g : X ⟶ V} (hg : IsSmall ℂ sV sX g) :
    2 ≤ closedsCodimension (MMP.Mori.exceptionalSet g) := by
  have hbc := hg.toIsBirationalContraction
  haveI : IsProper g := hbc.isProper
  have hbir := hg.isBirationalMorphism
  have h2 := (MMP.Flips.isSmall_iff_two_le_closedsCodimension_exceptionalSet hbc).mp hg
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h2 ⊢
  intro x hx
  by_contra hlt
  push Not at hlt
  have hxF : x ∉ MMP.Flips.exceptionalSet g := fun h => absurd (h2 x h) (not_le.mpr hlt)
  have hle : Order.coheight (g x) ≤ 1 := by
    rw [MMP.Flips.coheight_map_of_notMem_exceptionalSet hxF]; simpa using hlt
  exact (MMP.Mori.mem_exceptionalSet.mp hx)
    (MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal g hbir hle)

/-- A step of an extremal real flip sequence is a flip in the sense of `MMP.Flips.IsFlip`, along
the birational map `(f⁺)⁻¹ ∘ f`, whose birational transform is the strict transform. -/
private theorem exists_isFlip_of_isRealFlipStep {Y' : Scheme.{0}} [IsIntegral Y']
    [CompactSpace Y'] [IsLocallyNoetherian Y'] [IsNormal Y'] {sY' : Y' ⟶ Spec (.of ℂ)}
    {K : Divisor Y} {B : RDivisor Y} {B' : RDivisor Y'} {f : Y ⟶ W}
    {fp : Y' ⟶ W} (hWp : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hY'p : MMP.Mori.IsProjectiveVariety ℂ sY')
    (h : IsRealFlipStep sY sW sY' K B (flipTransform f fp K) B' f fp) :
    ∃ φ : Y.RationalMap Y', IsFlip ℂ sY sW sY' (logCanonicalDivisor K B) f fp φ ∧
      (∀ D : Divisor Y, MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D) ∧
      ∀ D : RDivisor Y, MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D := by
  have hne := h.isNegativeExtremalContraction
  haveI : IsSeparated sW := hWp.toIsVariety.toIsSeparated
  haveI : IsSeparated sY' := hY'p.toIsVariety.toIsSeparated
  obtain ⟨φ, hmod⟩ := MMP.Fourfold.exists_isModificationOf_of_isBirationalMorphism (sZ := sW)
    h.isBirationalMorphism h.isBirationalMorphism_flip
  have h1 := two_le_closedsCodimension_exceptionalSet_of_isSmall h.isSmall
  have h2 := two_le_closedsCodimension_exceptionalSet_of_isSmall h.isSmall_flip
  have htr : ∀ {R : Type} [AddCommMonoid R] (D : MMP.Mori.DivisorWithCoeffs R Y),
      MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D :=
    fun D => MMP.Fourfold.transformDivisor_eq_flipTransform_of_isModificationOf (sZ := sW)
      (sX' := sY') h1 h2 hmod D
  have hE : MMP.Mori.RationalMap.transformDivisor φ (logCanonicalDivisor K B) =
      logCanonicalDivisor (flipTransform f fp K) B' := by
    have h0 : logCanonicalDivisor K B = logCanonicalDivisor K (B + (0 : ℝ) • (0 : RDivisor Y)) := by
      rw [zero_smul, add_zero]
    rw [htr, h0, flipTransform_logCanonicalDivisor, zero_smul, add_zero, ← h.eq_flipTransform]
  haveI := h.isSmall_flip.isProper
  have hcart : IsCartierCombination (logCanonicalDivisor (flipTransform f fp K) B') := by
    obtain ⟨m, r, L, -, -, hL, heq⟩ := h.isRelativelyAmple_flip
    exact isCartierCombination_of_eq_sum (fun j => (hL j).choose) heq
  refine ⟨φ,
    { isNormalVariety_source := hne.isNormalVariety_source
      isNormalVariety_target := hne.isNormalVariety_target
      isNormalVariety_flip := ⟨hY'p.toIsVariety, inferInstance⟩
      isContraction := hne.isContraction
      isCartierCombination := hne.isCartierCombination
      isRelativelyAntiAmple := hne.isRelativelyAntiAmple
      isProper := inferInstance
      isModificationOf := hmod
      isMorphismInCodimOne :=
        MMP.Flips.RationalMap.isMorphismInCodimOne_of_isOver hne.isNormalVariety_source f fp φ
          hmod.2
      isSmall := h.isSmall_flip
      isCartierCombination_transform := by rw [hE]; exact hcart
      isRelativelyAmple_transform := by rw [hE]; exact h.isRelativelyAmple_flip
      isSmall_source := h.isSmall }, fun D => htr D, fun D => htr D⟩

/-- A birational morphism is a modification of itself into the identity. -/
private theorem isModificationOf_toRationalMap_id {f : Y ⟶ W} (hf : IsBirationalMorphism f) :
    IsModificationOf f (𝟙 W) (Scheme.Hom.toRationalMap f) := by
  refine ⟨hf, ?_⟩
  show (Scheme.Hom.toPartialMap f).toRationalMap.compHom (𝟙 W) =
    (Scheme.Hom.toPartialMap f).toRationalMap
  rw [← Scheme.RationalMap.compHom_toRationalMap]
  congr 1

/-- The push-forward of a canonical divisor along a birational contraction is a canonical
divisor. -/
private theorem isCanonicalDivisor_transformDivisor_of_isContraction {f : Y ⟶ W}
    (hW : IsNormalVariety ℂ sW) (hf : IsContraction ℂ sW sY f) (hbir : IsBirationalMorphism f)
    {K : Divisor Y} (hK : K.IsCanonicalDivisor sY 4) :
    MMP.Mori.Divisor.IsCanonicalDivisor sW 4
      (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) K) := by
  haveI : MMP.Mori.IsVariety ℂ sW := hW.1
  haveI : MMP.Mori.IsVariety ℂ sY := hf.isVariety_source
  have hdim : topologicalKrullDim W = 4 := by
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW sY hbir,
      hK.topologicalKrullDim_eq]
    rfl
  obtain ⟨KW, hKW⟩ := MMP.Mori.exists_isCanonicalDivisor sW hW hdim
  haveI := hf.isProper
  haveI : LocallyOfFiniteType sW := hW.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (f ≫ sW) := by
    rw [hf.comp_eq]; exact hf.isVariety_source.toLocallyOfFiniteType
  haveI : IsDominant f := hbir.isDominant
  have hY' : IsNormalVariety ℂ (f ≫ sW) := by
    rw [hf.comp_eq]; exact ⟨hf.isVariety_source, inferInstance⟩
  have hK' : K.IsCanonicalDivisor (f ≫ sW) 4 := by rw [hf.comp_eq]; exact hK
  exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hW hY' hbir hKW hK'

/-- The strict transform of the exceptional prime divisor of a birational contraction is `none`:
its image has codimension at least two. -/
private theorem transformPrimeDivisor_eq_none_of_exceptionalSet_eq {f : Y ⟶ W} [IsProper f]
    (hbir : IsBirationalMorphism f) (hW : IsNormalVariety ℂ sW) (P : MMP.Mori.PrimeDivisor Y)
    (hP : (MMP.Mori.exceptionalSet f : Set Y) = P.support) :
    MMP.Mori.RationalMap.transformPrimeDivisor (X := Y) (Scheme.Hom.toRationalMap f) P = none := by
  haveI : IsSeparated sW := hW.1.toIsSeparated
  haveI : W.IsSeparated := ⟨by rw [← Limits.terminal.comp_from sW]; infer_instance⟩
  rcases h : MMP.Mori.RationalMap.transformPrimeDivisor (X := Y) (Scheme.Hom.toRationalMap f) P
    with _ | Q
  · rfl
  · exfalso
    have h1 := (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P Q).mp h
    have h2 : Q.genericPoint ∈ MMP.Mori.biregularLocus f :=
      MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hbir
        (by rw [Q.coheight_genericPoint])
    have h3 : P.genericPoint ∈ (MMP.Mori.exceptionalSet f : Set Y) := by
      rw [hP, AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
    exact MMP.Mori.mem_exceptionalSet.mp h3 (h1 ▸ h2)

end Contraction

section Floor

variable {Y W Z : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}

/-- Through every closed point of the source of a surjective morphism of varieties which lowers
dimension passes a proper curve contracted by the morphism: the fibre through the point has a
component of positive dimension. -/
private theorem exists_properCurve_isContractedBy_mem_closure {X V : Scheme.{0}}
    {sX : X ⟶ Spec (.of ℂ)} {sV : V ⟶ Spec (.of ℂ)} [MMP.Mori.IsVariety ℂ sX]
    [MMP.Mori.IsVariety ℂ sV] [IsProper sX] (g : X ⟶ V) [IsProper g] (hg : g ≫ sV = sX)
    (hs : Function.Surjective g) (hlt : topologicalKrullDim V < topologicalKrullDim X) {p : X}
    (hp : IsClosed ({p} : Set X)) :
    ∃ Γ : ProperCurve sX, Γ.IsContractedBy g ∧ p ∈ closure ({Γ.point} : Set X) := by
  haveI : IsDominant g := ⟨hs.denseRange⟩
  haveI : LocallyOfFiniteType sX := inferInstance
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  obtain ⟨h1, -, -⟩ := MMP.topologicalKrullDim_fiber_of_isDominant ℂ sX sV g hg
  set q := g.asFiber p
  obtain ⟨T, hT, hqT⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    ({q} : Set (g.fiber (g p))) isIrreducible_singleton
  have hdimT := h1 (g p) T hT
  obtain ⟨ξ, hξ⟩ := QuasiSober.sober hT.1 (isClosed_of_mem_irreducibleComponents T hT)
  have hξq : ξ ⤳ q := by
    rw [specializes_iff_mem_closure, hξ.def]; exact hqT rfl
  have hinj : Function.Injective (g.fiberι (g p)) := (g.fiberι (g p)).isEmbedding.injective
  have hqc : IsClosed ({q} : Set (g.fiber (g p))) := by
    have : ({q} : Set (g.fiber (g p))) = g.fiberι (g p) ⁻¹' {p} := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact g.fiberι_asFiber p
      · intro hz; exact hinj (hz.trans (g.fiberι_asFiber p).symm)
    rw [this]; exact hp.preimage (g.fiberι (g p)).continuous
  have hξne : ξ ≠ q := by
    intro hEq
    rw [hEq] at hξ
    have hTq : T = {q} := by rw [← hξ.def, hqc.closure_eq]
    have h0 : topologicalKrullDim T ≤ 0 := by
      haveI : Subsingleton T := by rw [hTq]; infer_instance
      haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds T) :=
        ⟨fun a b => by
          obtain ⟨za, hza⟩ := a.isIrreducible.nonempty
          obtain ⟨zb, hzb⟩ := b.isIrreducible.nonempty
          ext x
          constructor
          · intro _; rw [Subsingleton.elim x zb]; exact hzb
          · intro _; rw [Subsingleton.elim x za]; exact hza⟩
      exact Order.krullDim_nonpos_of_subsingleton
    have : topologicalKrullDim X ≤ topologicalKrullDim V := by
      calc topologicalKrullDim X ≤ topologicalKrullDim T + topologicalKrullDim V := hdimT
        _ ≤ 0 + topologicalKrullDim V := by gcongr
        _ = topologicalKrullDim V := zero_add _
    exact absurd hlt (not_lt.mpr this)
  set η := g.fiberι (g p) ξ
  have hηp : η ⤳ p := by
    have := hξq.map (g.fiberι (g p)).continuous
    rwa [g.fiberι_asFiber] at this
  have hηne : η ∉ ({p} : Set X) := fun h =>
    hξne (hinj (h.trans (g.fiberι_asFiber p).symm))
  obtain ⟨y, hηy, hyp, -, hy⟩ :=
    MMP.Fourfold.exists_isProperCurve_of_specializes sX hηp hp hp rfl hηne
  have hFc : IsClosed (g ⁻¹' {g p}) := by
    have : IsClosed ({g p} : Set V) := by
      rw [← Set.image_singleton]; exact g.isClosedMap _ hp
    exact this.preimage g.continuous
  have hηF : η ∈ g ⁻¹' {g p} := by
    rw [← g.range_fiberι]; exact ⟨ξ, rfl⟩
  have hsub : closure ({y} : Set X) ⊆ g ⁻¹' {g p} :=
    hFc.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr (hηy.mem_closed hFc hηF))
  refine ⟨⟨y, hy⟩, fun z hz => ?_, specializes_iff_mem_closure.mp hyp⟩
  have h1 : g z = g p := hsub hz
  have h2 : g y = g p := hsub (subset_closure rfl)
  exact h1.trans h2.symm

/-- **No fibre type contraction.** A contraction on whose contracted curves some prime divisor `E`
is negative is not of fibre type: the contracted curves through a closed point off `E` are not
contained in `E`. -/
private theorem not_topologicalKrullDim_lt_of_neg [QuasiCompact sY] [IsProper sY] {f : Y ⟶ W}
    (hQ : IsQFactorial sY) (hf : IsContraction ℂ sW sY f) (E : MMP.Mori.PrimeDivisor Y)
    (hneg : ∀ Γ : ProperCurve sY, Γ.IsContractedBy f →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor Y) (x : ℝ),
        IsRIntersectionNumber ℂ sY (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0) :
    ¬ topologicalKrullDim W < topologicalKrullDim Y := by
  intro hlt
  haveI : MMP.Mori.IsVariety ℂ sY := hf.isVariety_source
  haveI : MMP.Mori.IsVariety ℂ sW := hf.isVariety_target
  haveI := hf.isProper
  haveI : LocallyOfFiniteType sY := hf.isVariety_source.toLocallyOfFiniteType
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace sY
  obtain ⟨p, hpE, hpc⟩ : ((E.support : Set Y)ᶜ ∩ closedPoints Y).Nonempty :=
    nonempty_inter_closedPoints
      ⟨genericPoint Y, MMP.Threefold.Mori.OpenRestriction.genericPoint_notMem_support E⟩
      E.idealSheaf.support.isClosed.isOpen_compl.isLocallyClosed
  obtain ⟨Γ, hΓ, hpΓ⟩ := exists_properCurve_isContractedBy_mem_closure f hf.comp_eq
    (Scheme.Hom.surjective_of_isIso_app f hf.isIso_app).surj hlt hpc
  exact hpE (closure_subset_support_of_neg hQ E Γ (hneg Γ hΓ) hpΓ)

/-- **The floor identity on the target of a divisorial contraction.** -/
private theorem exists_floor_transformDivisor {K : Divisor Y} {B C N : RDivisor Y} {α : ℝ}
    {π : Y ⟶ Z} {f : Y ⟶ W} {h : W ⟶ Z} (hQ : IsQFactorial sY) (hWQ : IsQFactorial sW)
    (hYp : MMP.Mori.IsProjectiveVariety ℂ sY) (hWp : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hZp : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sY) (hfh : f ≫ h = π)
    (hhZ : h ≫ sZ = sW) (hf : IsContraction ℂ sW sY f) (hbir : IsBirationalMorphism f)
    (hB : ∀ P, 0 ≤ B.coeff P)
    (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hnum : IsNumericallyEquivalentOver ℂ sY π (α • logCanonicalDivisor K B) (C + N)) :
    ∃ N' : RDivisor W, (∀ P, 0 ≤ N'.coeff P) ∧
      (∀ P, N'.coeff P ≠ 0 →
        1 ≤ (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f)
          B).coeff P) ∧
      IsNumericallyEquivalentOver ℂ sW h
        (α • logCanonicalDivisor
          (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) K)
          (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) B))
        (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) C + N') := by
  haveI : QuasiCompact sY := hYp.toIsVariety.toQuasiCompact
  haveI : QuasiCompact sW := hWp.toIsVariety.toQuasiCompact
  haveI : IsSeparated sW := hWp.toIsVariety.toIsSeparated
  haveI : W.IsSeparated := ⟨by rw [← Limits.terminal.comp_from sW]; infer_instance⟩
  haveI := hf.isProper
  have hφZ : MMP.Flips.RationalMap.IsOver π h (Scheme.Hom.toRationalMap f) := by
    show Scheme.Hom.toRationalMap (f ≫ h) = Scheme.Hom.toRationalMap π
    rw [hfh]
  have hφE : ∀ F, ¬ MMP.Flips.RationalMap.IsInverseExceptional (Scheme.Hom.toRationalMap f) F := by
    intro F hF
    haveI : IsIso (f ∣_ MMP.Mori.biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
    have hFV : F.genericPoint ∈ MMP.Mori.biregularLocus f :=
      MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hbir
        (by rw [F.coheight_genericPoint])
    obtain ⟨y, hy⟩ := (f ∣_ MMP.Mori.biregularLocus f).surjective ⟨F.genericPoint, hFV⟩
    have hfy : f y.1 = F.genericPoint := by
      have := congrArg Subtype.val hy
      rwa [morphismRestrict_base_coe] at this
    have hcoh : Order.coheight y.1 = 1 := by
      rw [← MMP.Flips.coheight_map_eq_of_isIso_morphismRestrict f (MMP.Mori.biregularLocus f)
        (y := y.1) (by rw [hfy]; exact hFV), hfy, F.coheight_genericPoint]
    have h1 : (AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh :
        MMP.Mori.PrimeDivisor Y).genericPoint = y.1 :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hcoh
    exact hF (AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh)
      ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f _ F).mpr
        ((congrArg f h1).trans hfy))
  exact exists_floor_of_isBirational hQ hYp hWQ hWp hZp hπ hhZ
    (isModificationOf_toRationalMap_id hbir).1 hφZ hφE hB hN hNB hnum

/-- **The floor identity on a flip.** -/
private theorem exists_floor_flipTransform {Y' : Scheme.{0}} [IsIntegral Y'] [CompactSpace Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {sY' : Y' ⟶ Spec (.of ℂ)} {K : Divisor Y}
    {B C N : RDivisor Y} {α : ℝ} {π : Y ⟶ Z} {f : Y ⟶ W} {h : W ⟶ Z} {fp : Y' ⟶ W}
    (hQ : IsQFactorial sY) (hY'Q : IsQFactorial sY')
    (hYp : MMP.Mori.IsProjectiveVariety ℂ sY) (hY'p : MMP.Mori.IsProjectiveVariety ℂ sY')
    (hZp : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sY) (hfh : f ≫ h = π)
    (hhZ : h ≫ sZ = sW) (hf : IsSmall ℂ sW sY f) (hfp : IsSmall ℂ sW sY' fp)
    (hWn : IsNormalVariety ℂ sW) {φ : Y.RationalMap Y'} (hmod : IsModificationOf f fp φ)
    (htrK : ∀ D : Divisor Y, MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D)
    (htr : ∀ D : RDivisor Y, MMP.Mori.RationalMap.transformDivisor φ D = flipTransform f fp D)
    (hB : ∀ P, 0 ≤ B.coeff P)
    (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hnum : IsNumericallyEquivalentOver ℂ sY π (α • logCanonicalDivisor K B) (C + N)) :
    ∃ N' : RDivisor Y', (∀ P, 0 ≤ N'.coeff P) ∧
      (∀ P, N'.coeff P ≠ 0 → 1 ≤ (flipTransform f fp B).coeff P) ∧
      IsNumericallyEquivalentOver ℂ sY' (fp ≫ h)
        (α • logCanonicalDivisor (flipTransform f fp K) (flipTransform f fp B))
        (flipTransform f fp C + N') := by
  classical
  haveI : QuasiCompact sY := hYp.toIsVariety.toQuasiCompact
  haveI : QuasiCompact sY' := hY'p.toIsVariety.toQuasiCompact
  have hspec := flipTransformPrimeDivisor_spec hWn hf hfp
  have hφZ : MMP.Flips.RationalMap.IsOver π (fp ≫ h) φ := by
    show φ.compHom (fp ≫ h) = Scheme.Hom.toRationalMap π
    rw [← MMP.Fourfold.Oai4C1.Main.compHom_compHom, hmod.2]
    show Scheme.Hom.toRationalMap (f ≫ h) = Scheme.Hom.toRationalMap π
    rw [hfh]
  have hφE : ∀ F, ¬ MMP.Flips.RationalMap.IsInverseExceptional φ F := by
    intro F hF
    obtain ⟨P, hP⟩ := hspec.2.2.1 F
    have hc : flipTransform f fp (Finsupp.single P (1 : ℝ)) F = 1 := by
      rw [hspec.2.2.2.2 _ P F hP, Finsupp.single_eq_same]
    rw [← htr] at hc
    change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ _ F = 1 at hc
    rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single] at hc
    rcases hτ : MMP.Mori.RationalMap.transformPrimeDivisor φ P with _ | E
    · rw [hτ] at hc; simp at hc
    · rw [hτ] at hc
      simp only [Option.elim_some, Finsupp.single_apply] at hc
      split_ifs at hc with hEF
      · exact hF P (hEF ▸ hτ)
      · simp at hc
  obtain ⟨N', h1, h2, h3⟩ := exists_floor_of_isBirational hQ hYp hY'Q hY'p hZp hπ
    (by rw [Category.assoc, hhZ, hfp.comp_eq]) hmod.1 hφZ hφE hB hN hNB hnum
  rw [htrK, htr, htr] at h3
  rw [htr] at h2
  exact ⟨N', h1, h2, h3⟩

end Floor

/-! ### Plt boundaries along a roof -/

section RoofPlt

variable {Y Y' W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y]
  [IsNormal Y] [IsIntegral Y'] [CompactSpace Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- **Positivity of exceptional log discrepancies across a crepant roof.** Let
`f : Y ⟶ W ⟵ Y' : f⁺` be a birational contraction and a small contraction onto a normal variety,
`K` a canonical divisor of the fourfold `Y` whose strict transform is canonical, and `Δ` a real
divisor with `K + Δ` and `K' + Δ'` (strict transforms) pull-backs of one `ℝ`-Cartier divisor of
`W`. If the exceptional log discrepancies of `(Y, Δ)` are positive and the primes contracted by
`f` have coefficient `< 1` in `Δ`, then the exceptional log discrepancies of `(Y', Δ')` are
positive. -/
private theorem pos_of_roof (hW : IsNormalVariety ℂ sW) {f : Y ⟶ W} {fp : Y' ⟶ W}
    (hf : IsContraction ℂ sW sY f) (hbf : IsBirationalMorphism f) (hfp : IsSmall ℂ sW sY' fp)
    {K : Divisor Y} (hK : K.IsCanonicalDivisor sY 4)
    (hK' : MMP.Mori.Divisor.IsCanonicalDivisor sY' 4 (flipTransform f fp K))
    {Δ : RDivisor Y} {M : RDivisor W}
    (h1 : IsRCartierPullback f M (logCanonicalDivisor K Δ))
    (h2 : IsRCartierPullback fp M
      (logCanonicalDivisor (flipTransform f fp K) (flipTransform f fp Δ)))
    (hcoeff : ∀ P : MMP.Mori.PrimeDivisor Y, 2 ≤ Order.coheight (f P.genericPoint) →
      Δ.coeff P < 1)
    (hpos : ∀ (n : ℕ) (E : MMP.Mori.DivisorOver ℂ sY) (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sY n Δ E a → 0 < a) :
    ∀ (n : ℕ) (E : MMP.Mori.DivisorOver ℂ sY') (a : ℝ), E.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sY' n (flipTransform f fp Δ) E a → 0 < a := by
  haveI := hf.isProper
  haveI := hfp.isProper
  haveI : IsDominant f := hbf.isDominant
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp
  haveI : IsDominant fp := hbfp.isDominant
  haveI : LocallyOfFiniteType sW := hW.1.toLocallyOfFiniteType
  have e : f ≫ sW = sY := hf.comp_eq
  have e' : fp ≫ sW = sY' := hfp.comp_eq
  haveI : LocallyOfFiniteType (f ≫ sW) := by
    rw [e]; exact hf.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (fp ≫ sW) := by
    rw [e']; exact hfp.isVariety_source.toLocallyOfFiniteType
  have hYn : IsNormalVariety ℂ (f ≫ sW) := by
    rw [e]; exact ⟨hf.isVariety_source, inferInstance⟩
  have hY'n : IsNormalVariety ℂ (fp ≫ sW) := by
    rw [e']; exact ⟨hfp.isVariety_source, inferInstance⟩
  have hKW := isCanonicalDivisor_transformDivisor_of_isContraction hW hf hbf hK
  have hKf : K.IsCanonicalDivisor (f ≫ sW) 4 := by rw [e]; exact hK
  have hK'f : MMP.Mori.Divisor.IsCanonicalDivisor (fp ≫ sW) 4 (flipTransform f fp K) := by
    rw [e']; exact hK'
  obtain ⟨ω, hω0, hωK, hωKY⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hW hYn hbf hKW hKf rfl
  obtain ⟨ω', hω'0, hω'K, hω'KY⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hW hY'n hbfp hKW hK'f
      (transformDivisor_flipTransform hW hYn hbf hfp K)
  have hn : topologicalKrullDim W = ((4 : ℕ) : WithBot ℕ∞) := hKW.topologicalKrullDim_eq
  set ΔW : RDivisor W := M - Divisor.toRDivisor
    (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) K) with hΔW
  have hM : Divisor.toRDivisor
      (MMP.Mori.RationalMap.transformDivisor (X := Y) (Scheme.Hom.toRationalMap f) K) + ΔW = M :=
    add_sub_cancel _ _
  have hdown := pos_of_isExceptional_of_crepant hW f hYn hbf hn ω hω0
    (by rw [hωK]; exact hKW) (by rw [hωKY]; exact hKf) (ΔW := ΔW) (ΔY := Δ)
    (by rw [hωK, hωKY, hM]; exact h1) (by rw [e]; exact hpos) hcoeff
  have hup := pos_of_isExceptional_of_crepant_up hW fp hY'n hbfp hn ω' hω'0
    (by rw [hω'K]; exact hKW) (by rw [hω'KY]; exact hK'f) (ΔW := ΔW)
    (ΔY := flipTransform f fp Δ) (by rw [hω'K, hω'KY, hM]; exact h2) hdown
  rw [e'] at hup
  exact hup

end RoofPlt

/-! ### Zero places of the log minimal model -/

section ZeroPlace

/-- **The log discrepancy is affine in the boundary** along an effective `ℝ`-Cartier direction
`E`: `a(D; X, B + sE) = a(D; X, B) - s · ord_D(E)`, with `ord_D(E) ≥ 0`. -/
private theorem exists_isLogDiscrepancy_add_smul {X : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {B E : RDivisor X} {D : MMP.Mori.DivisorOver ℂ sX} {a : ℝ}
    (h : MMP.Intersection.IsLogDiscrepancy sX n B D a) (hE : RDivisor.IsRCartier E)
    (hE0 : 0 ≤ E) :
    ∃ μ : ℝ, 0 ≤ μ ∧ ∀ s : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (B + s • E) D (a - s * μ) := by
  obtain ⟨hX, hp, ω, hω0, hK, m, r, C, C', hC, hsum, hpb, rfl⟩ := h
  have := D.isIntegral
  have := D.isNormal
  have := D.isLocallyNoetherian
  have := D.isDominant
  have : CompactSpace D.Y := QuasiCompact.compactSpace_of_compactSpace D.f
  obtain ⟨hex, hnonneg⟩ := MMP.Fourfold.isEffective_of_isRCartierPullback D.f hE hE0
  obtain ⟨G, hG⟩ := hex
  have hG0 := hnonneg G hG
  obtain ⟨m₃, s₀, L, L', hLc, hEeq, hLpb, hGeq⟩ := hG
  have hμ : G.coeff D.E = ∑ i, s₀ i * ((L' i).coeff D.E : ℝ) := by
    rw [hGeq, MMP.Fourfold.coeff_sum_smul_toRDivisor]
  refine ⟨G.coeff D.E, Finsupp.le_def.mp hG0 D.E, fun s => ?_⟩
  refine ⟨hX, hp, ω, hω0, hK, m + m₃, Fin.append r (s • s₀), Fin.append C L, Fin.append C' L',
    Fin.addCases (fun j => by simpa using hC j) (fun j => by simpa using hLc j), fun Γ => ?_,
    Fin.addCases (fun j => by simpa using hpb j) (fun j => by simpa using hLpb j), ?_⟩
  · simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, DivisorWithCoeffs.coeff_add,
      coeff_smul_real, Pi.smul_apply, smul_eq_mul]
    rw [hEeq, MMP.Fourfold.coeff_sum_smul_toRDivisor, Finset.mul_sum, ← add_assoc, hsum Γ]
    congr 1
    exact Finset.sum_congr rfl fun i _ => by ring
  · simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul]
    rw [hμ, Finset.mul_sum]
    have : ∑ i, s * s₀ i * ((L' i).coeff D.E : ℝ) = ∑ i, s * (s₀ i * ((L' i).coeff D.E : ℝ)) :=
      Finset.sum_congr rfl fun i _ => by ring
    rw [this]
    ring

/-- A smooth variety is `ℚ`-factorial: every Weil divisor is Cartier. -/
private theorem isQFactorial_of_isSmoothScheme {X : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (hXs : MMP.Mori.IsSmoothScheme sX) : IsQFactorial sX :=
  ⟨hX, fun D => ⟨1, one_pos, by simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXs D⟩⟩

/-- **New primes of the log minimal model are zero places of `(X, B)`.** If `(X, B + C)` is lc
with `C ≥ 0` `ℝ`-Cartier and `(Y, B_Y)` is a log minimal model of `(X, B + t C)` with `0 < t < 1`,
then every prime divisor of `Y` extracted by `φ` has log discrepancy zero over `(X, B)`: it has
log discrepancy zero over `(X, B + t C)`, nonnegative over `(X, B + C)`, and the log discrepancy
is affine in the boundary. -/
private theorem isLogDiscrepancy_eq_zero_of_isRealLogMinimalModel {X Y Z : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z} {K : Divisor X} {B C : RDivisor X}
    {t : ℝ} {KY : Divisor Y} {BY : RDivisor Y} {φ : X.RationalMap Y}
    (hlc : IsRealLcPair sX (B + C)) (hCc : RDivisor.IsRCartier C) (hC0 : 0 ≤ C) (ht₁ : t < 1)
    (hY : IsRealLogMinimalModel sX sY sZ π πY K (B + t • C) KY BY φ)
    (F : MMP.Mori.PrimeDivisor Y) (hF : MMP.Flips.RationalMap.IsInverseExceptional φ F)
    (D : MMP.Flips.ProperDivisorOver ℂ sX) (hD : MMP.Flips.IsRealizedOver sX φ F D) (n : ℕ)
    (a : ℝ) (ha : MMP.Intersection.IsLogDiscrepancy sX n B D.toDivisorOver a) : a = 0 := by
  obtain ⟨μ, hμ0, hμ⟩ := exists_isLogDiscrepancy_add_smul ha hCc hC0
  have h1 := hY.toIsNefLogBirationalModel.isLogDiscrepancy_eq_zero F hF D hD n _ (hμ t)
  have h2' : MMP.Intersection.IsLogDiscrepancy sX n (B + C) D.toDivisorOver (a - μ) := by
    simpa using hμ 1
  have h2 := hlc.2.2.2 n _ _ h2'
  have e1 : (1 - t) * μ ≤ 0 := by nlinarith
  have e2 : 0 ≤ (1 - t) * μ := mul_nonneg (by linarith) hμ0
  have hμz : μ = 0 := by
    rcases mul_eq_zero.mp (le_antisymm e1 e2) with h | h
    · linarith
    · exact h
  rw [hμz] at h1
  linarith

end ZeroPlace

/-! ### Primes contracted by a step -/

section Contracted

variable {Y W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- A prime divisor mapped to codimension at least two by a birational morphism whose exceptional
set is the prime divisor `P₀` is `P₀`. -/
private theorem eq_of_two_le_coheight {f : Y ⟶ W} {P₀ : MMP.Mori.PrimeDivisor Y}
    (hP₀ : (MMP.Mori.exceptionalSet f : Set Y) = P₀.support) (P : MMP.Mori.PrimeDivisor Y)
    (hP : 2 ≤ Order.coheight (f P.genericPoint)) : P = P₀ := by
  by_contra hne
  have hmem : P.genericPoint ∉ (MMP.Mori.exceptionalSet f : Set Y) := fun h =>
    MMP.Threefold.Resolution.genericPoint_notMem_support_of_ne hne (hP₀ ▸ h)
  have hbr : f P.genericPoint ∈ MMP.Mori.biregularLocus f := by
    by_contra h; exact hmem (MMP.Mori.mem_exceptionalSet.mpr h)
  rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f
    (show P.genericPoint ∈ f ⁻¹ᵁ MMP.Mori.biregularLocus f from hbr),
    P.coheight_genericPoint] at hP
  exact absurd hP (by decide)

/-- A small contraction maps the generic point of every prime divisor to a point of codimension
one. -/
private theorem coheight_map_genericPoint_of_isSmall {f : Y ⟶ W} (hf : IsSmall ℂ sW sY f)
    (P : MMP.Mori.PrimeDivisor Y) : Order.coheight (f P.genericPoint) = 1 := by
  obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hf P
  rw [hQ, Q.coheight_genericPoint]

end Contracted

/-! ### One step of the program -/

/-- **One step of the program.** At a stage whose adjoint is not nef over `Z`, the nef threshold
is attained on an extremal ray, whose contraction is divisorial or small; the next stage is its
target or the flip, and the invariants persist. -/
private theorem Stage.exists_step {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S : Stage Z) (hS : S.Inv sZ α)
    (hnef : ¬ S.IsNef) :
    ∃ (S' : Stage Z) (D : StepData S S'), StepProps S S' D ∧ StepExtra S S' D ∧ S'.Inv sZ α := by
  classical
  obtain ⟨hYp, hQ, hK, hπ, hdlt, hB0, hC0, hμ, hlcμ, hnefμ, N, hN0, hNB, hfloor⟩ := hS
  haveI : IsProper S.sY := isProper_of_isProjectiveMorphism S.sY hYp.isProjective
  have hdim : topologicalKrullDim S.Y = 4 := hK.topologicalKrullDim_eq
  -- the nef threshold `l` and its extremal ray `R`
  obtain ⟨l, hl0, hlμ, hnefl, hKBc, hCc, R, hR, hnull, hneg, hpos⟩ :=
    NefThreshold.exists_isExtremalRay_nef_threshold_of_isRealLcPair hYp hZ hπ hQ hK hB0 hC0 hμ
      hlcμ hnefμ hnef
  obtain ⟨n₁, c₁, M₁, hM₁, hKB⟩ := exists_eq_sum_of_isRCartier hKBc
  obtain ⟨n₂, c₂, M₂, hM₂, hCeq⟩ := exists_eq_sum_of_isRCartier hCc
  have hMa : ∀ i, (Fin.append M₁ M₂ i).IsCartier :=
    Fin.addCases (fun j => by simpa using hM₁ j) (fun j => by simpa using hM₂ j)
  have heq : ∀ s : ℝ, logCanonicalDivisor S.K (S.B + s • S.C) =
      ∑ i, Fin.append c₁ (s • c₂) i • Divisor.toRDivisor (Fin.append M₁ M₂ i) := fun s => by
    rw [sum_append_smul_toRDivisor, ← smul_sum_smul_toRDivisor, ← hCeq, ← hKB]
    unfold logCanonicalDivisor
    abel
  have hKB' : logCanonicalDivisor S.K S.B = ∑ i, c₁ i • Divisor.toRDivisor (M₁ i) := hKB
  -- the contraction of `R`
  obtain ⟨W, _, _, _, _, sW, f, h, hface, hWp, hnec, hdesc, hdiv, hsmall⟩ :=
    MMP.Fourfold.IsRealDltPair.exists_isRelativeContractionOfFace_of_isExtremalRay hYp hZ hπ hQ
      hdim ⟨4, hK⟩ hdlt hR ⟨n₁, c₁, M₁, hM₁, hKB', fun u hu hu0 => hneg n₁ c₁ M₁ hM₁ hKB u hu hu0⟩
  have hfh : f ≫ h = S.πY := hface.comp_eq
  have hhZ : h ≫ sZ = sW := eq_of_comp_eq_of_isIso_app f hnec.isContraction.isIso_app
    (by rw [← Category.assoc, hfh, hπ, hnec.isContraction.comp_eq])
  have hcontr : ∀ Γ : ProperCurve S.sY, Γ.IsContractedBy f → Γ.IsContractedBy S.πY :=
    fun Γ hΓ => hfh ▸ isContractedBy_comp hΓ h
  -- the values of `K + B` and `C` on the contracted curves
  set A : ProperCurve S.sY → ℝ := fun Γ =>
    ∑ i, c₁ i * ((M₁ i).degreeOn ℂ S.sY Γ.ι Γ.dim_le (hM₁ i) : ℝ) with hA
  set Bc : ProperCurve S.sY → ℝ := fun Γ =>
    ∑ i, c₂ i * ((M₂ i).degreeOn ℂ S.sY Γ.ι Γ.dim_le (hM₂ i) : ℝ) with hBc
  have hval : ∀ (Γ : ProperCurve S.sY) (s : ℝ) {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor S.Y}
      {x : ℝ}, IsRIntersectionNumber ℂ S.sY (logCanonicalDivisor S.K (S.B + s • S.C)) r L Γ x →
      x = A Γ + s * Bc Γ := by
    intro Γ s m r L x hx
    rw [eq_sum_degreeOn_of_isRIntersectionNumber Γ _ _ hMa (heq s) hx]
    simp only [hA, hBc, Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply,
      smul_eq_mul, Finset.mul_sum]
    congr 1
    exact Finset.sum_congr rfl fun i _ => by ring
  have hvalA : ∀ (Γ : ProperCurve S.sY), IsRIntersectionNumber ℂ S.sY
      (logCanonicalDivisor S.K S.B) c₁ M₁ Γ (A Γ) := fun Γ => by
    rw [hKB']; exact isRIntersectionNumber_sum Γ c₁ M₁ hM₁
  have key : ∀ Γ : ProperCurve S.sY, ∀ hΓ : Γ.IsContractedBy f,
      A Γ + l * Bc Γ = 0 ∧ A Γ < 0 ∧ 0 < Bc Γ ∧
        Γ.relativeClass S.πY (hcontr Γ hΓ) ∈ R ∧ Γ.relativeClass S.πY (hcontr Γ hΓ) ≠ 0 := by
    intro Γ hΓ
    have hu : Γ.relativeClass S.πY (hcontr Γ hΓ) ∈ R :=
      (hface.isContractedBy_iff Γ (hcontr Γ hΓ)).mp hΓ
    have h1 := (sum_degree_relativeClass Γ (hcontr Γ hΓ) _ _ hMa).symm.trans
      (hnull _ _ _ hMa (heq l) _ hu)
    have h1' : A Γ + l * Bc Γ = 0 := by
      rw [← h1]
      simp only [hA, hBc, Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply,
        smul_eq_mul, Finset.mul_sum]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    have h2 : A Γ < 0 := lt_zero_of_isRelativelyAntiAmple hnec.isRelativelyAntiAmple hΓ (hvalA Γ)
    have hu0 : Γ.relativeClass S.πY (hcontr Γ hΓ) ≠ 0 := by
      intro h0
      have h3 : ∑ i, c₁ i * (haveI := (hM₁ i).isInvertibleModule_divisorialSheaf;
          RelativeNumericalCurveClasses.degree S.sY S.πY (M₁ i).divisorialSheaf
            (Γ.relativeClass S.πY (hcontr Γ hΓ))) = A Γ :=
        sum_degree_relativeClass Γ (hcontr Γ hΓ) c₁ M₁ hM₁
      rw [h0] at h3
      simp only [map_zero, mul_zero, Finset.sum_const_zero] at h3
      linarith
    have h4 : 0 < Bc Γ := lt_of_lt_of_eq (hpos n₂ c₂ M₂ hM₂ hCeq _ hu hu0)
      (sum_degree_relativeClass Γ (hcontr Γ hΓ) c₂ M₂ hM₂)
    exact ⟨h1', h2, h4, hu, hu0⟩
  -- a contracted curve
  obtain ⟨Γ₀, hΓ₀⟩ :=
    exists_isContractedBy_of_relativePicardNumber_eq_one hnec.relativePicardNumber_eq_one
  -- the threshold
  have hP2 : ∀ s : ℝ, 0 ≤ s → s < l →
      ¬ IsRelativelyNef ℂ S.sY S.πY (logCanonicalDivisor S.K (S.B + s • S.C)) := by
    rintro s - hsl ⟨m, r, L, hLc, hD, hvals⟩
    have hx := isRIntersectionNumber_sum Γ₀ r L hLc
    rw [← hD] at hx
    have h1 := hvals Γ₀ (hcontr Γ₀ hΓ₀) _ hx
    rw [hval Γ₀ s hx] at h1
    obtain ⟨k1, -, k3, -⟩ := key Γ₀ hΓ₀
    nlinarith
  -- numerical triviality over `W`
  have hP6 : IsNumericallyEquivalentOver ℂ S.sY f
      (logCanonicalDivisor S.K (S.B + l • S.C)) 0 := by
    refine ⟨isCartierCombination_of_eq_sum hMa (heq l), isCartierCombination_zero',
      fun Γ hΓ m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h₁ h₂ => ?_⟩
    rw [hval Γ l h₁, (key Γ hΓ).1]
    have h0 : (0 : RDivisor S.Y) = ∑ i : Fin 0, (Fin.elim0 i : ℝ) •
        Divisor.toRDivisor (Fin.elim0 i : Divisor S.Y) := by simp
    rw [eq_sum_degreeOn_of_isRIntersectionNumber Γ (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor S.Y) (fun i => i.elim0) h0 h₂]
    simp
  -- curves with class in `R` are null for the upper level
  have hnullR : ∀ (Γ : ProperCurve S.sY) (hΓ : Γ.IsContractedBy S.πY),
      Γ.relativeClass S.πY hΓ ∈ R → ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor S.Y) (x : ℝ),
        IsRIntersectionNumber ℂ S.sY (logCanonicalDivisor S.K (S.B + l • S.C)) r L Γ x →
          x = 0 := by
    intro Γ hΓ hu m r L x hx
    have hΓf : Γ.IsContractedBy f := (hface.isContractedBy_iff Γ hΓ).mpr hu
    rw [hval Γ l hx]
    exact (key Γ hΓf).1
  -- a negative floor component
  have hP11 : ∃ E : MMP.Mori.PrimeDivisor S.Y, S.B.coeff E = 1 ∧
      ∀ Γ : ProperCurve S.sY, Γ.IsContractedBy f →
        ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor S.Y) (x : ℝ),
          IsRIntersectionNumber ℂ S.sY (Finsupp.single E (1 : ℝ)) r L Γ x → x < 0 := by
    classical
    obtain ⟨v, hv0, hRv⟩ := hR.2
    -- every contracted class is a positive multiple of `v`
    have hclass : ∀ (Γ : ProperCurve S.sY) (hΓ : Γ.IsContractedBy f),
        ∃ c : ℝ, 0 < c ∧ c • v = Γ.relativeClass S.πY (hcontr Γ hΓ) := by
      intro Γ hΓ
      obtain ⟨-, -, -, hu, hu0⟩ := key Γ hΓ
      rw [hRv] at hu
      obtain ⟨c, hc0, hc⟩ := hu
      refine ⟨c, lt_of_le_of_ne hc0 ?_, hc⟩
      rintro rfl
      exact hu0 (by rw [← hc, zero_smul])
    -- the sign of a prime divisor is the same on all contracted curves
    have hsign : ∀ P : MMP.Mori.PrimeDivisor S.Y,
        (∃ Γ : ProperCurve S.sY, Γ.IsContractedBy f ∧ ∃ (m : ℕ) (r : Fin m → ℝ)
          (L : Fin m → Divisor S.Y) (x : ℝ),
          IsRIntersectionNumber ℂ S.sY (Finsupp.single P (1 : ℝ)) r L Γ x ∧ 0 ≤ x) →
        ∀ Γ' : ProperCurve S.sY, Γ'.IsContractedBy f → ∀ (m : ℕ) (r : Fin m → ℝ)
          (L : Fin m → Divisor S.Y) (x : ℝ),
          IsRIntersectionNumber ℂ S.sY (Finsupp.single P (1 : ℝ)) r L Γ' x → 0 ≤ x := by
      rintro P ⟨Γ, hΓ, m, r, L, x, hx, hx0⟩ Γ' hΓ' m' r' L' x' hx'
      obtain ⟨nP, cP, MP, hMP, hPeq⟩ :=
        exists_eq_sum_of_isRCartier (hQ.isRCartier (Finsupp.single P (1 : ℝ)))
      have hv : ∀ (Γ : ProperCurve S.sY) (hΓ : Γ.IsContractedBy f) {m : ℕ} {r : Fin m → ℝ}
          {L : Fin m → Divisor S.Y} {x : ℝ},
          IsRIntersectionNumber ℂ S.sY (Finsupp.single P (1 : ℝ)) r L Γ x →
          ∃ c : ℝ, 0 < c ∧ x = c * ∑ i, cP i * (haveI := (hMP i).isInvertibleModule_divisorialSheaf;
            RelativeNumericalCurveClasses.degree S.sY S.πY (MP i).divisorialSheaf v) := by
        intro Γ hΓ m r L x hx
        obtain ⟨c, hc0, hc⟩ := hclass Γ hΓ
        refine ⟨c, hc0, ?_⟩
        rw [eq_sum_degree_of_isRIntersectionNumber Γ (hcontr Γ hΓ) cP MP hMP hPeq hx, ← hc,
          Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by rw [LinearMap.map_smul, smul_eq_mul]; ring
      obtain ⟨c, hc, rfl⟩ := hv Γ hΓ hx
      obtain ⟨c', hc', rfl⟩ := hv Γ' hΓ' hx'
      have hσ : 0 ≤ ∑ i, cP i * (haveI := (hMP i).isInvertibleModule_divisorialSheaf;
          RelativeNumericalCurveClasses.degree S.sY S.πY (MP i).divisorialSheaf v) := by
        by_contra hneg'
        push Not at hneg'
        nlinarith
      exact mul_nonneg hc'.le hσ
    by_contra hcon
    push Not at hcon
    -- every component of `N` is nonnegative on `Γ₀`
    have hP0 : ∀ P ∈ N.support, ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor S.Y) (x : ℝ),
        IsRIntersectionNumber ℂ S.sY (Finsupp.single P (1 : ℝ)) r L Γ₀ x → 0 ≤ x := by
      intro P hP m r L x hx
      have hBP : S.B.coeff P = 1 :=
        le_antisymm (hdlt.2.1 P) (hNB P (Finsupp.mem_support_iff.mp hP))
      exact hsign P (hcon P hBP) Γ₀ hΓ₀ m r L x hx
    -- hence so is `N`
    have hind : ∀ s : Finset (MMP.Mori.PrimeDivisor S.Y), s ⊆ N.support →
        ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor S.Y) (x : ℝ),
          IsRIntersectionNumber ℂ S.sY (∑ P ∈ s, N P • Finsupp.single P (1 : ℝ)) r L Γ₀ x ∧
            0 ≤ x := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        intro _
        refine ⟨0, Fin.elim0, Fin.elim0, 0, ?_, le_rfl⟩
        have := isRIntersectionNumber_sum Γ₀ (Fin.elim0 : Fin 0 → ℝ)
          (Fin.elim0 : Fin 0 → Divisor S.Y) (fun i => i.elim0)
        simpa using this
      | @insert P s hPs ih =>
        intro hsub
        obtain ⟨m, r, L, x, hx, hx0⟩ := ih fun Q hQ => hsub (Finset.mem_insert_of_mem hQ)
        obtain ⟨nP, cP, MP, hMP, hPeq⟩ :=
          exists_eq_sum_of_isRCartier (hQ.isRCartier (Finsupp.single P (1 : ℝ)))
        have hxP := isRIntersectionNumber_sum Γ₀ cP MP hMP
        rw [← hPeq] at hxP
        have hxP0 := hP0 P (hsub (Finset.mem_insert_self P s)) _ _ _ _ hxP
        have hlin := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ S.sY Γ₀).2 _ _ _ _ _ _ _ _
          (N P) 1 hxP hx
        simp only [one_smul, one_mul] at hlin
        have hsum : ∑ Q ∈ insert P s, N Q • Finsupp.single Q (1 : ℝ) =
            N P • Finsupp.single P (1 : ℝ) + ∑ Q ∈ s, N Q • Finsupp.single Q (1 : ℝ) :=
          Finset.sum_insert hPs
        rw [hsum]
        exact ⟨_, _, _, _, hlin, add_nonneg (mul_nonneg (hN0 P) hxP0) hx0⟩
    obtain ⟨m, r, L, x, hx, hx0⟩ := hind N.support subset_rfl
    have hNsum : ∑ P ∈ N.support, N P • Finsupp.single P (1 : ℝ) = N := by
      conv_rhs => rw [← Finsupp.sum_single N]
      unfold Finsupp.sum
      exact Finset.sum_congr rfl fun P _ => by rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [hNsum] at hx
    -- the value of `N` on `Γ₀` from the floor identity
    obtain ⟨nN, cN, MN, hMN, hNeq⟩ := exists_eq_sum_of_isRCartier (hQ.isRCartier N)
    have hxN := eq_sum_degreeOn_of_isRIntersectionNumber Γ₀ cN MN hMN hNeq hx
    have hMa2 : ∀ i, (Fin.append M₂ MN i).IsCartier :=
      Fin.addCases (fun j => by simpa using hM₂ j) (fun j => by simpa using hMN j)
    have hv1 : IsRIntersectionNumber ℂ S.sY (α • logCanonicalDivisor S.K S.B) (α • c₁) M₁ Γ₀
        (α * A Γ₀) := by
      have := isRIntersectionNumber_sum Γ₀ (α • c₁) M₁ hM₁
      rw [← smul_sum_smul_toRDivisor, ← hKB'] at this
      convert this using 1
      simp only [hA, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring
    have hv2 : IsRIntersectionNumber ℂ S.sY (S.C + N) (Fin.append c₂ cN) (Fin.append M₂ MN) Γ₀
        (Bc Γ₀ + ∑ i, cN i * ((MN i).degreeOn ℂ S.sY Γ₀.ι Γ₀.dim_le (hMN i) : ℝ)) := by
      have := isRIntersectionNumber_sum Γ₀ (Fin.append c₂ cN) (Fin.append M₂ MN) hMa2
      rw [sum_append_smul_toRDivisor, ← hCeq, ← hNeq] at this
      convert this using 1
      simp only [hBc, Fin.sum_univ_add, Fin.append_left, Fin.append_right]
    have hfl := hfloor.2.2 Γ₀ (hcontr Γ₀ hΓ₀) _ _ _ _ _ _ _ _ hv1 hv2
    obtain ⟨k1, -, k3, -⟩ := key Γ₀ hΓ₀
    have e1 : A Γ₀ = -(l * Bc Γ₀) := by linarith
    rw [e1] at hfl
    rw [hxN] at hx0
    nlinarith [mul_pos (mul_pos hα hl0) k3]
  -- the lower level of the next stage is lc and nef
  have hlcl : IsRealLcPair S.sY (S.B + l • S.C) := by
    have heqμ : S.B + S.μ • S.C = (S.B + l • S.C) + (S.μ - l) • S.C := by
      rw [add_assoc, ← add_smul]; congr 2; ring
    rw [heqμ] at hlcμ
    refine isRealLcPair_of_add hlcμ hQ (fun P => ?_) (fun P => ?_)
    · rw [DivisorWithCoeffs.coeff_add, coeff_smul_real]
      exact add_nonneg (hB0 P) (mul_nonneg hl0.le (hC0 P))
    · rw [coeff_smul_real]
      exact mul_nonneg (by linarith) (hC0 P)
  obtain ⟨E₀, -, hE₀neg⟩ := id hP11
  rcases divisorial_or_isSmall_or_dim_lt hQ hYp hWp hnec E₀ hE₀neg with ⟨hbir, P, hP⟩ | hsm | hfib
  · -- a divisorial contraction
    obtain ⟨hWQ, hdltW, hlcW⟩ := hdiv ⟨hbir, P, hP⟩
    haveI := hnec.isContraction.isProper
    obtain ⟨E, hE1, hEneg⟩ := id hP11
    have hPE : P = E := eq_of_exceptionalSet_eq_of_neg hQ hnec.isContraction hbir hP hEneg
    have hPnone := transformPrimeDivisor_eq_none_of_exceptionalSet_eq hbir hWQ.1 P hP
    obtain ⟨hlc', hnef'⟩ := hlcW (S.B + l • S.C) hlcl hnefl hnullR
    obtain ⟨N', hN'0, hN'B, hN'⟩ := exists_floor_transformDivisor hQ hWQ hYp hWp hZ hπ hfh hhZ
      hnec.isContraction hbir hB0 hN0 hNB hfloor
    have hroof : StepRoof (S := S)
        ⟨W, sW, h,
          MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.K,
          MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.B,
          MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.C, l⟩
        ⟨W, sW, f, h, 𝟙 W, Scheme.Hom.toRationalMap f, l⟩ := by
      have hYn : IsNormalVariety ℂ (f ≫ sW) := by
        rw [hnec.isContraction.comp_eq]; exact hnec.isNormalVariety_source
      obtain ⟨M, hM⟩ := hdesc hbir (logCanonicalDivisor S.K (S.B + l • S.C))
        (isCartierCombination_of_eq_sum hMa (heq l)) hnullR
      refine ⟨hWQ.1, hnec.isContraction, hbir, MMP.Flips.isSmall_id hWQ.1.1,
        (flipTransform_id_right hWQ.1 f S.K).symm, (flipTransform_id_right hWQ.1 f S.B).symm,
        (flipTransform_id_right hWQ.1 f S.C).symm, fun Q hQ2 => ?_, M, hM, ?_⟩
      · rw [eq_of_two_le_coheight hP Q hQ2, hPE]; exact hE1
      · show IsRCartierPullback (𝟙 W) M (logCanonicalDivisor
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.K)
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.B +
            l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.C))
        rw [← mapPrimeDivisors_logCanonicalDivisor]
        have := transformDivisor_of_isRCartierPullback hWQ.1 hYn hbir hM
        change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ _ = M at this
        rw [this]
        exact isRCartierPullback_id (hWQ.isRCartier M)
    refine ⟨⟨W, sW, h,
        MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.K,
        MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.B,
        MMP.Mori.RationalMap.transformDivisor (X := S.Y) (Scheme.Hom.toRationalMap f) S.C, l⟩,
      ⟨W, sW, f, h, 𝟙 W, Scheme.Hom.toRationalMap f, l⟩,
      ⟨hnefl, hP2, hnec, hfh, Category.id_comp h, hP6,
        Or.inl ⟨hbir, ⟨P, hP⟩, inferInstance, isModificationOf_toRationalMap_id hbir⟩, rfl, rfl,
        rfl, hP11⟩,
      ⟨hlμ, rfl, Or.inl ⟨hbir, ⟨P, hP⟩, inferInstance,
        MMP.Mori.RationalMap.transformPrimeDivisor (X := S.Y) (Scheme.Hom.toRationalMap f), rfl,
        rfl, P, by rw [hPE]; exact hE1, hPnone⟩, hroof⟩,
      ⟨hWp, hWQ, isCanonicalDivisor_transformDivisor_of_isContraction hWQ.1 hnec.isContraction
        hbir hK, hhZ, hdltW, fun Q => coeff_mapPrimeDivisors_nonneg hB0 Q,
        fun Q => coeff_mapPrimeDivisors_nonneg hC0 Q, hl0, ?_, ?_, N', hN'0, hN'B, hN'⟩⟩
    · have := mapPrimeDivisors_add_smul
        (MMP.Mori.RationalMap.transformPrimeDivisor (X := S.Y) (Scheme.Hom.toRationalMap f))
        S.B S.C l
      change IsRealLcPair sW (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.B +
        l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.C)
      rw [← this]
      exact hlc'
    · have := mapPrimeDivisors_add_smul
        (MMP.Mori.RationalMap.transformPrimeDivisor (X := S.Y) (Scheme.Hom.toRationalMap f))
        S.B S.C l
      change IsRelativelyNef ℂ sW h (logCanonicalDivisor _
        (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.B +
        l • MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ S.C))
      rw [← this]
      exact hnef'
  · -- a flip
    obtain ⟨X', _, _, _, _, sX', fp, hflip, hX'p, hX'Q, hdimX', hdltX', hdesc2, hlc2⟩ := hsmall hsm
    obtain ⟨φ, hφ, hφK, hφB⟩ := exists_isFlip_of_isRealFlipStep hWp hX'p hflip
    obtain ⟨hlc', hnef'⟩ := hlc2 (S.B + l • S.C) hlcl hnefl hnullR
    rw [flipTransform_add_smul] at hlc' hnef'
    obtain ⟨N', hN'0, hN'B, hN'⟩ := exists_floor_flipTransform hQ hX'Q hYp hX'p hZ hπ hfh hhZ hsm
      hflip.isSmall_flip hφ.isNormalVariety_target hφ.isModificationOf hφK hφB hB0 hN0 hNB hfloor
    obtain ⟨M, hM1, hM2⟩ := hdesc2 (logCanonicalDivisor S.K (S.B + l • S.C))
      (isCartierCombination_of_eq_sum hMa (heq l)) hnullR
    rw [flipTransform_logCanonicalDivisor] at hM2
    obtain ⟨mK, hmK⟩ := hflip.isCanonicalDivisor_flip
    have hmK4 : mK = 4 := by
      have := hmK.topologicalKrullDim_eq
      rw [hdimX'] at this
      exact_mod_cast this.symm
    subst hmK4
    refine ⟨⟨X', sX', fp ≫ h, flipTransform f fp S.K, flipTransform f fp S.B,
        flipTransform f fp S.C, l⟩,
      ⟨W, sW, f, h, fp, φ, l⟩,
      ⟨hnefl, hP2, hnec, hfh, rfl, hP6, Or.inr hφ, (hφK S.K).symm, (hφB S.B).symm,
        (hφB S.C).symm, hP11⟩,
      ⟨hlμ, rfl, Or.inr ⟨hflip, rfl, rfl, rfl, M, hM1, hM2⟩,
        ⟨hnec.isNormalVariety_target, hnec.isContraction, hflip.isBirationalMorphism,
          hflip.isSmall_flip, rfl, rfl, rfl, fun Q hQ2 => absurd
            (coheight_map_genericPoint_of_isSmall hsm Q ▸ hQ2) (by decide), M, hM1, hM2⟩⟩,
      ⟨hX'p, hX'Q, hmK, by rw [Category.assoc, hhZ, hflip.isSmall_flip.comp_eq], hdltX',
        coeff_flipTransform_nonneg f fp hB0, coeff_flipTransform_nonneg f fp hC0, hl0, hlc',
        hnef', N', hN'0, hN'B, hN'⟩⟩
  · obtain ⟨E, -, hEneg⟩ := hP11
    exact absurd hfib (not_topologicalKrullDim_lt_of_neg hQ hnec.isContraction E hEneg)

/-- The next stage of the program: the step of `Stage.exists_step`, or the trivial step once the
program has stopped. -/
private noncomputable def Stage.next {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S : Stage Z) :
    Σ S' : Stage Z, StepData S S' :=
  open Classical in
  if h : S.Inv sZ α ∧ ¬ S.IsNef then
    ⟨(S.exists_step hZ hα h.1 h.2).choose, (S.exists_step hZ hα h.1 h.2).choose_spec.choose⟩
  else ⟨S, StepData.trivial S⟩

/-- The stages of the program starting at `S₀`. -/
private noncomputable def Stage.seq {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S₀ : Stage Z) : ℕ → Stage Z
  | 0 => S₀
  | i + 1 => (Stage.next hZ hα (Stage.seq hZ hα S₀ i)).1

private theorem Stage.next_spec {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S : Stage Z) (hS : S.Inv sZ α)
    (hnef : ¬ S.IsNef) :
    StepProps S (S.next hZ hα).1 (S.next hZ hα).2 ∧
      StepExtra S (S.next hZ hα).1 (S.next hZ hα).2 ∧ (S.next hZ hα).1.Inv sZ α := by
  classical
  have h : S.Inv sZ α ∧ ¬ S.IsNef := ⟨hS, hnef⟩
  unfold Stage.next
  rw [dif_pos h]
  exact (S.exists_step hZ hα h.1 h.2).choose_spec.choose_spec

private theorem Stage.next_inv {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S : Stage Z) (hS : S.Inv sZ α) :
    (S.next hZ hα).1.Inv sZ α := by
  classical
  by_cases h : S.IsNef
  · unfold Stage.next
    rw [dif_neg (fun h' => h'.2 h)]
    exact hS
  · exact (S.next_spec hZ hα hS h).2.2

private theorem Stage.seq_inv {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S₀ : Stage Z) (h₀ : S₀.Inv sZ α) :
    ∀ i, (Stage.seq hZ hα S₀ i).Inv sZ α
  | 0 => h₀
  | i + 1 => Stage.next_inv hZ hα _ (Stage.seq_inv hZ hα S₀ h₀ i)

/-! ### Floor chains: principal modifications of the boundary along the program -/

section Chain

/-- The strict transform commutes with real multiples of integral divisors. -/
private theorem flipTransform_smul_toRDivisor {X Y X' : Scheme.{0}} (f : X ⟶ Y) (fp : X' ⟶ Y)
    (c : ℝ) (D : Divisor X) :
    flipTransform f fp (c • Divisor.toRDivisor D) =
      c • Divisor.toRDivisor (flipTransform f fp D) := by
  change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (c • Divisor.toRDivisor D)) =
    c • Divisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
      (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ D))
  rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_smul, mapPrimeDivisors_toRDivisor,
    MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_smul, mapPrimeDivisors_toRDivisor]

/-- Lowering the boundary by an effective `ℝ`-Cartier divisor keeps the exceptional log
discrepancies positive. -/
private theorem pos_of_add {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B E : RDivisor X}
    (hE : RDivisor.IsRCartier E) (hE0 : 0 ≤ E)
    (hpos : ∀ (n : ℕ) (D : MMP.Mori.DivisorOver ℂ sX) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sX n (B + E) D a → 0 < a) :
    ∀ (n : ℕ) (D : MMP.Mori.DivisorOver ℂ sX) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sX n B D a → 0 < a := fun n D a hD ha => by
  obtain ⟨a', ha', hle⟩ := exists_isLogDiscrepancy_add_le ha hE hE0
  exact (hpos n D a' hD ha').trans_le hle

variable {Z : Scheme.{0}}

/-- **A floor chain at a stage.** A principal modification `B' = B + c · div(u)` of the boundary
which is effective, whose upper level `B' + μ C` has coefficients at most one and positive
exceptional log discrepancies, with `E` the unique component of coefficient one of `B'` and
`C(E) = 0`. -/
private def Stage.IsChainBoundary (S : Stage Z) (E : MMP.Mori.PrimeDivisor S.Y) (c : ℝ)
    (u : (RationalFunctions S.Y)ˣ) : Prop :=
  (∀ P, 0 ≤ (S.B + c • Divisor.toRDivisor (principalDivisor u)).coeff P) ∧
    (∀ P, (S.B + c • Divisor.toRDivisor (principalDivisor u) + S.μ • S.C).coeff P ≤ 1) ∧
    (∀ (n : ℕ) (D : MMP.Mori.DivisorOver ℂ S.sY) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy S.sY n
        (S.B + c • Divisor.toRDivisor (principalDivisor u) + S.μ • S.C) D a → 0 < a) ∧
    (S.B + c • Divisor.toRDivisor (principalDivisor u)).coeff E = 1 ∧
    (∀ P, P ≠ E → (S.B + c • Divisor.toRDivisor (principalDivisor u)).coeff P < 1) ∧
    S.C.coeff E = 0

/-- **A floor chain survives a step.** If `E` has a strict transform `E'` along a step of the
program, a floor chain at `E` gives one at `E'`, whose boundary is the strict transform of the
old one; the upper adjoint at the threshold of the modified boundaries descends crepantly. -/
private theorem Stage.IsChainBoundary.next {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ} {S S' : Stage Z}
    {D : StepData S S'} (hS : S.Inv sZ α) (hS' : S'.Inv sZ α) (hext : StepExtra S S' D)
    {E : MMP.Mori.PrimeDivisor S.Y} {c : ℝ} {u : (RationalFunctions S.Y)ˣ}
    (hch : S.IsChainBoundary E c u) {E' : MMP.Mori.PrimeDivisor S'.Y}
    (hEE' : MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp E = some E') :
    ∃ u' : (RationalFunctions S'.Y)ˣ, S'.IsChainBoundary E' c u' ∧
      flipTransform D.f D.fp (S.B + c • Divisor.toRDivisor (principalDivisor u)) =
        S'.B + c • Divisor.toRDivisor (principalDivisor u') ∧
      ∃ M' : RDivisor D.W,
        IsRCartierPullback D.f M' (logCanonicalDivisor S.K
          (S.B + c • Divisor.toRDivisor (principalDivisor u) + D.thr • S.C)) ∧
        IsRCartierPullback D.fp M' (logCanonicalDivisor S'.K
          (S'.B + c • Divisor.toRDivisor (principalDivisor u') + D.thr • S'.C)) := by
  classical
  obtain ⟨-, hQ, hK, -, -, -, hC0, hμ, hlcμ, -, -⟩ := hS
  obtain ⟨-, -, hK', -, -, -, -, -, -, -, -⟩ := hS'
  obtain ⟨hthr, hμ', -, hWn, hfc, hbf, hfp, hKt, hBt, hCt, hcontr, M, hM1, hM2⟩ := hext
  obtain ⟨hB'0, hle1, hpos, hE1, hElt, hCE⟩ := hch
  haveI := hfc.isProper
  haveI := hfp.isProper
  haveI : IsDominant D.f := hbf.isDominant
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism D.sW S'.sY hfp
  haveI : IsDominant D.fp := hbfp.isDominant
  have hYn : IsNormalVariety ℂ (D.f ≫ D.sW) := by
    rw [hfc.comp_eq]; exact hQ.1
  obtain ⟨-, hchar, hsurj, hinj, hcoeff⟩ := roofTransformPrimeDivisor_spec hWn hbf hfp
  -- the rational function on the base and its pull-back to the next stage
  obtain ⟨g, hgdom, hg⟩ := MMP.Fourfold.exists_pullbackRationalFunction_eq hbf u
  set u' : (RationalFunctions S'.Y)ˣ := pullbackRationalFunction D.fp g
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant D.fp _) with hu'
  have hdiv : flipTransform D.f D.fp (principalDivisor u) = principalDivisor u' := by
    rw [← hg]
    exact flipTransform_principalDivisor_pullback_roof hWn hYn hbf hfp g
  set B' := S.B + c • Divisor.toRDivisor (principalDivisor u) with hB'def
  set B'' := S'.B + c • Divisor.toRDivisor (principalDivisor u') with hB''def
  have htr : flipTransform D.f D.fp B' = B'' := by
    rw [hB'def, hB''def, map_add, flipTransform_smul_toRDivisor, hdiv, ← hBt]
  -- the crepant descent of the modified upper adjoint
  have hpb1 := MMP.Fourfold.isRCartierPullback_add_sum_principal D.f hM1 (fun _ : Fin 1 => c)
    (fun _ : Fin 1 => g)
  have hpb2 := MMP.Fourfold.isRCartierPullback_add_sum_principal D.fp hM2 (fun _ : Fin 1 => c)
    (fun _ : Fin 1 => g)
  simp only [Fin.sum_univ_one] at hpb1 hpb2
  have e1 : logCanonicalDivisor S.K (S.B + D.thr • S.C) + c • Divisor.toRDivisor
      (principalDivisor (pullbackRationalFunction D.f g
        (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant D.f _))) =
      logCanonicalDivisor S.K (B' + D.thr • S.C) := by
    rw [hg, hB'def]; unfold logCanonicalDivisor; abel
  have e2 : logCanonicalDivisor S'.K (S'.B + D.thr • S'.C) + c • Divisor.toRDivisor
      (principalDivisor (pullbackRationalFunction D.fp g
        (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant D.fp _))) =
      logCanonicalDivisor S'.K (B'' + D.thr • S'.C) := by
    rw [hB''def]; unfold logCanonicalDivisor; abel
  rw [e1] at hpb1
  rw [e2] at hpb2
  set M' : RDivisor D.W := M + c • Divisor.toRDivisor (principalDivisor g) with hM'
  refine ⟨u', ?_, htr, M', hpb1, hpb2⟩
  -- positivity of the lowered upper level `B' + λ C`
  have hlow : ∀ (n : ℕ) (Δ : MMP.Mori.DivisorOver ℂ S.sY) (a : ℝ), Δ.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy S.sY n (B' + D.thr • S.C) Δ a → 0 < a := by
    refine pos_of_add (E := (S.μ - D.thr) • S.C) (hQ.isRCartier _)
      (Finsupp.le_def.mpr fun P => ?_) ?_
    · have h0 := hC0 P
      rw [DivisorWithCoeffs.coeff_apply] at h0
      simp only [Finsupp.coe_zero, Pi.zero_apply, Finsupp.smul_apply, smul_eq_mul]
      exact mul_nonneg (by linarith) h0
    · have : B' + D.thr • S.C + (S.μ - D.thr) • S.C = B' + S.μ • S.C := by
        rw [add_assoc, ← add_smul]; congr 2; ring
      rw [this]; exact hpos
  -- the floor component is not contracted
  have hEc : Order.coheight (D.f E.genericPoint) = 1 := by
    rw [hchar E E' hEE', coheight_map_genericPoint_of_isSmall hfp E']
  have hC0P : ∀ P, S.B.coeff P = 1 → S.C.coeff P = 0 := fun P hP => by
    have h1 := coeff_le_one_of_isRealLcPair hlcμ P
    rw [DivisorWithCoeffs.coeff_add, coeff_smul_real, hP] at h1
    have h2 := hC0 P
    have h3 : S.μ * S.C.coeff P ≤ 0 := by linarith
    have h4 : S.C.coeff P ≤ 0 := by
      by_contra h
      push Not at h
      linarith [mul_pos hμ h]
    linarith
  have hcoeffΔ : ∀ P : MMP.Mori.PrimeDivisor S.Y, 2 ≤ Order.coheight (D.f P.genericPoint) →
      (B' + D.thr • S.C).coeff P < 1 := fun P hP => by
    have hPE : P ≠ E := fun h => by rw [h, hEc] at hP; exact absurd hP (by decide)
    rw [DivisorWithCoeffs.coeff_add, coeff_smul_real, hC0P P (hcontr P hP), mul_zero, add_zero]
    exact hElt P hPE
  have hK't : MMP.Mori.Divisor.IsCanonicalDivisor S'.sY 4 (flipTransform D.f D.fp S.K) := by
    rw [← hKt]; exact hK'
  have hΔtr : flipTransform D.f D.fp (B' + D.thr • S.C) = B'' + D.thr • S'.C := by
    rw [flipTransform_add_smul, htr, ← hCt]
  have hM2' : IsRCartierPullback D.fp M' (logCanonicalDivisor (flipTransform D.f D.fp S.K)
      (flipTransform D.f D.fp (B' + D.thr • S.C))) := by
    rw [hΔtr, ← hKt]; exact hpb2
  have hup := pos_of_roof hWn hfc hbf hfp hK hK't hpb1 hM2' hcoeffΔ hlow
  rw [hΔtr] at hup
  -- the coefficients at the next stage
  have hcB : ∀ (P : MMP.Mori.PrimeDivisor S.Y) (P' : MMP.Mori.PrimeDivisor S'.Y),
      MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp P = some P' →
        B''.coeff P' = B'.coeff P := fun P P' h => by
    rw [← htr, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, hcoeff _ P P' h]
  have hcC : ∀ (P : MMP.Mori.PrimeDivisor S.Y) (P' : MMP.Mori.PrimeDivisor S'.Y),
      MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp P = some P' →
        S'.C.coeff P' = S.C.coeff P := fun P P' h => by
    rw [hCt, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, hcoeff _ P P' h]
  refine ⟨fun P' => ?_, fun P' => ?_, ?_, ?_, fun P' hP' => ?_, ?_⟩
  · obtain ⟨P, hP⟩ := hsurj P'
    rw [hcB P P' hP]; exact hB'0 P
  · obtain ⟨P, hP⟩ := hsurj P'
    rw [DivisorWithCoeffs.coeff_add, coeff_smul_real, hcB P P' hP, hcC P P' hP, hμ']
    have := hle1 P
    rw [DivisorWithCoeffs.coeff_add, coeff_smul_real] at this
    have := hC0 P
    nlinarith
  · rw [hμ']; exact hup
  · rw [hcB E E' hEE']; exact hE1
  · obtain ⟨P, hP⟩ := hsurj P'
    rw [hcB P P' hP]
    refine hElt P fun h => hP' ?_
    rw [h, hEE'] at hP
    exact (Option.some.inj hP).symm
  · rw [hcC E E' hEE']; exact hCE

end Chain

/-! ### The birational map of a roof as a partial isomorphism -/

section RoofIso

variable {Y Y' W : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y]
  [IsNormal Y] [IsIntegral Y'] [CompactSpace Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}

/-- The open of the base of a roof over which both legs are isomorphisms. -/
private noncomputable def roofLocus (f : Y ⟶ W) (fp : Y' ⟶ W) : W.Opens :=
  MMP.Mori.biregularLocus f ⊓ MMP.Mori.biregularLocus fp

/-- The generic point of every prime divisor of the base lies in the roof locus. -/
private theorem genericPoint_mem_roofLocus (hW : IsNormalVariety ℂ sW) {f : Y ⟶ W}
    [IsProper f] (hbf : IsBirationalMorphism f) {fp : Y' ⟶ W} [IsProper fp]
    (hbfp : IsBirationalMorphism fp) (Q : MMP.Mori.PrimeDivisor W) :
    Q.genericPoint ∈ roofLocus f fp :=
  ⟨(birational_prime_data hW hbf).1 Q, (birational_prime_data hW hbfp).1 Q⟩

/-- The generic point of the base lies in the roof locus. -/
private theorem genericPoint_mem_roofLocus' {f : Y ⟶ W} [IsProper f]
    (hbf : IsBirationalMorphism f) {fp : Y' ⟶ W} [IsProper fp] (hbfp : IsBirationalMorphism fp) :
    genericPoint W ∈ roofLocus f fp := by
  have h0 : Order.coheight (genericPoint W) ≤ 1 := by
    rw [Order.coheight_eq_zero.mpr (fun y _ => genericPoint_specializes y)]; exact zero_le_one
  exact ⟨MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hbf h0,
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal fp hbfp h0⟩

/-- **The birational map `(f⁺)⁻¹ ∘ f` of a roof**, as the partial isomorphism
`f⁻¹(U) ≅ U ≅ (f⁺)⁻¹(U)` over the roof locus `U`. -/
private noncomputable def roofIso {f : Y ⟶ W} [IsProper f] (hbf : IsBirationalMorphism f)
    {fp : Y' ⟶ W} [IsProper fp] (hbfp : IsBirationalMorphism fp) : Y.PartialIso Y' :=
  haveI : IsIso (f ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_left
  haveI : IsIso (fp ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_right
  haveI : IsDominant f := hbf.isDominant
  haveI : IsDominant fp := hbfp.isDominant
  { source := f ⁻¹ᵁ roofLocus f fp
    dense_source := (f ⁻¹ᵁ roofLocus f fp).2.dense (by
      obtain ⟨z, hz, y, hy⟩ := f.denseRange.inter_open_nonempty _ (roofLocus f fp).2
        ⟨_, genericPoint_mem_roofLocus' hbf hbfp⟩
      exact ⟨y, show f y ∈ roofLocus f fp from hy ▸ hz⟩)
    target := fp ⁻¹ᵁ roofLocus f fp
    dense_target := (fp ⁻¹ᵁ roofLocus f fp).2.dense (by
      obtain ⟨z, hz, y, hy⟩ := fp.denseRange.inter_open_nonempty _ (roofLocus f fp).2
        ⟨_, genericPoint_mem_roofLocus' hbf hbfp⟩
      exact ⟨y, show fp y ∈ roofLocus f fp from hy ▸ hz⟩)
    iso := asIso (f ∣_ roofLocus f fp) ≪≫ (asIso (fp ∣_ roofLocus f fp)).symm }

/-- The roof isomorphism lies over `f` and `f⁺`. -/
private theorem roofIso_isOver {f : Y ⟶ W} [IsProper f] (hbf : IsBirationalMorphism f)
    {fp : Y' ⟶ W} [IsProper fp] (hbfp : IsBirationalMorphism fp) :
    (roofIso hbf hbfp).IsOver f fp := by
  haveI : IsIso (f ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_left
  haveI : IsIso (fp ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_right
  show (asIso (f ∣_ roofLocus f fp) ≪≫ (asIso (fp ∣_ roofLocus f fp)).symm).hom ≫
      (fp ⁻¹ᵁ roofLocus f fp).ι ≫ fp = (f ⁻¹ᵁ roofLocus f fp).ι ≫ f
  simp only [Iso.trans_hom, Iso.symm_hom, asIso_hom, asIso_inv, Category.assoc]
  rw [← morphismRestrict_ι, IsIso.inv_hom_id_assoc, morphismRestrict_ι]

/-- The roof isomorphism, as a rational map, lies over `f` and `f⁺`. -/
private theorem roofIso_toRationalMap_isOver {f : Y ⟶ W} [IsProper f]
    (hbf : IsBirationalMorphism f) {fp : Y' ⟶ W} [IsProper fp] (hbfp : IsBirationalMorphism fp) :
    MMP.Flips.RationalMap.IsOver f fp (roofIso hbf hbfp).toRationalMap := by
  have H := roofIso_isOver hbf hbfp
  rw [MMP.Flips.RationalMap.IsOver, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨(roofIso hbf hbfp).source, (roofIso hbf hbfp).dense_source, le_rfl, le_top, ?_⟩
  change Y.homOfLE (le_rfl : (roofIso hbf hbfp).source ≤ (roofIso hbf hbfp).source) ≫
      ((roofIso hbf hbfp).iso.hom ≫ (roofIso hbf hbfp).target.ι) ≫ fp =
    Y.homOfLE (le_top : (roofIso hbf hbfp).source ≤ ⊤) ≫ Y.topIso.hom ≫ f
  rw [Category.assoc, H]
  simp

/-- **Prime divisors along the roof isomorphism**: its strict transform is the strict transform
`(f⁺)⁻¹_* f_*`. -/
private theorem transformPrimeDivisor_roofIso (hW : IsNormalVariety ℂ sW) {f : Y ⟶ W}
    [IsProper f] (hbf : IsBirationalMorphism f) {fp : Y' ⟶ W} (hfp : IsSmall ℂ sW sY' fp)
    (P : MMP.Mori.PrimeDivisor Y) :
    haveI := hfp.isProper
    MMP.Mori.RationalMap.transformPrimeDivisor
        (roofIso hbf (MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp)).toRationalMap P =
      MMP.Fourfold.flipTransformPrimeDivisor f fp P := by
  haveI := hfp.isProper
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism sW sY' hfp
  haveI : IsSeparated sW := hW.1.toIsSeparated
  haveI : W.IsSeparated := ⟨by rw [← Limits.terminal.comp_from sW]; infer_instance⟩
  haveI : IsSeparated sY' := hfp.isVariety_source.toIsSeparated
  haveI : Y'.IsSeparated := ⟨by rw [← Limits.terminal.comp_from sY']; infer_instance⟩
  haveI : IsIso (f ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_left
  haveI : IsIso (fp ∣_ roofLocus f fp) :=
    MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_right
  obtain ⟨hdef, hchar, -, -, -⟩ := roofTransformPrimeDivisor_spec hW hbf hfp
  set ε := roofIso hbf hbfp with hε
  have H := roofIso_isOver hbf hbfp
  -- every representative of `ε` composed with `f⁺` is `f`
  have hrep : ∀ (g : Y.PartialMap Y') (_ : g.toRationalMap = ε.toRationalMap) (y : g.domain),
      fp (g.hom y) = f y.1 := fun g hg y => by
    have := MMP.Fourfold.hom_comp_eq_of_isOver f fp (roofIso_toRationalMap_isOver hbf hbfp) g hg
    have h2 : (g.hom ≫ fp) y = (g.domain.ι ≫ f) y := by rw [this]
    exact h2
  -- a defined transform satisfies `f(η_P) = f⁺(η_E)`
  have hsome : ∀ E : MMP.Mori.PrimeDivisor Y',
      MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap P = some E →
        f P.genericPoint = fp E.genericPoint := fun E h => by
    obtain ⟨hdefP, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h
    obtain ⟨g, hPg, hg⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdefP
    have hE := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h g hg hPg
    rw [hE, hrep g hg ⟨_, hPg⟩]
  rcases hflip : MMP.Fourfold.flipTransformPrimeDivisor f fp P with _ | E
  · rcases htr : MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap P with _ | E
    · rfl
    · exfalso
      have h1 := hsome E htr
      obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hfp E
      obtain ⟨E', hE'⟩ := hdef P Q (h1.trans hQ)
      rw [hflip] at hE'
      exact absurd hE' (by simp)
  · have h1 := hchar P E hflip
    obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hfp E
    have hPU : P.genericPoint ∈ ε.source := by
      show f P.genericPoint ∈ roofLocus f fp
      rw [h1, hQ]; exact genericPoint_mem_roofLocus hW hbf hbfp Q
    have hval : fp (ε.toPartialMap.hom ⟨P.genericPoint, hPU⟩) = fp E.genericPoint := by
      rw [hrep ε.toPartialMap rfl ⟨_, hPU⟩, h1]
    have hEU : fp E.genericPoint ∈ MMP.Mori.biregularLocus fp := by
      rw [hQ]; exact (birational_prime_data hW hbfp).1 Q
    -- injectivity of `f⁺` over its biregular locus
    have hinj' : Function.Injective ((fp ⁻¹ᵁ MMP.Mori.biregularLocus fp).ι ≫ fp).base := by
      haveI : IsIso (fp ∣_ MMP.Mori.biregularLocus fp) := MMP.Mori.isBiregular_biregularLocus fp
      rw [← morphismRestrict_ι]
      exact ((fp ∣_ MMP.Mori.biregularLocus fp) ≫
        (MMP.Mori.biregularLocus fp).ι).isOpenEmbedding.injective
    have hy : ε.toPartialMap.hom ⟨P.genericPoint, hPU⟩ ∈ fp ⁻¹ᵁ MMP.Mori.biregularLocus fp := by
      have h' : fp (ε.toPartialMap.hom ⟨P.genericPoint, hPU⟩) ∈ MMP.Mori.biregularLocus fp := by
        rw [hval]; exact hEU
      exact h'
    have := @hinj' ⟨_, hy⟩ ⟨E.genericPoint, hEU⟩ (by
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]; exact hval)
    exact MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq ε.toPartialMap rfl hPU
      (congrArg Subtype.val this).symm

end RoofIso

/-! ### Composites of rational maps with partial isomorphisms -/

section Composite

/-- The linear extension of a partial map on prime divisors commutes with
`QDivisor.toRDivisor`. -/
private theorem mapPrimeDivisors_qtoRDivisor {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (D : QDivisor X) :
    QDivisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D) =
      MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ (QDivisor.toRDivisor D) := by
  classical
  have hs : ∀ {T : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor T) (q : ℚ),
      QDivisor.toRDivisor (Finsupp.single Q q) = Finsupp.single Q (q : ℝ) := fun Q q => by
    ext Q'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> simp
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
  | single P q =>
    rw [hs, MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single,
      MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single]
    rcases τ P with _ | Q
    · simp
    · exact hs Q q

/-- The underlying morphism of a partial isomorphism is dominant. -/
private theorem isDominant_partialIso_hom {X Y : Scheme.{0}} (e : X.PartialIso Y) :
    IsDominant e.toPartialMap.hom := by
  have := AlgebraicGeometry.Opens.isDominant_ι e.dense_target
  show IsDominant (e.iso.hom ≫ e.target.ι)
  infer_instance

/-- Restricting the source of a partial isomorphism restricts its underlying morphism. -/
private theorem restrictSource_iso_hom_ι {X Y : Scheme.{0}} (e : X.PartialIso Y) (U : X.Opens)
    (hU : Dense (U : Set X)) (hU' : U ≤ e.source) :
    (e.restrictSource U hU hU').iso.hom ≫ (e.restrictSource U hU hU').target.ι =
      X.homOfLE hU' ≫ e.iso.hom ≫ e.target.ι := by
  have h : (Scheme.Opens.isoOfLE hU').inv ≫ (e.source.ι ⁻¹ᵁ U).ι = X.homOfLE hU' := by
    rw [← cancel_mono e.source.ι]; simp
  simp [Scheme.PartialIso.restrictSource, ← h]

/-- The composite of the rational maps of two partial isomorphisms is the rational map of
their composite. -/
private theorem toRationalMap_trans {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsSeparated (Z ↘ ⊤_ Scheme)] (e : X.PartialIso Y) (e' : Y.PartialIso Z)
    [IsDominant e.toPartialMap.hom] :
    (e.trans e').toRationalMap = e.toRationalMap.comp e'.toRationalMap := by
  haveI := isDominant_partialIso_hom e
  rw [Scheme.RationalMap.toRationalMap_comp, Scheme.PartialIso.toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff,
    Scheme.PartialMap.equiv_iff_of_isSeparated (S := ⊤_ Scheme)]
  set U : Y.Opens := e.target ⊓ e'.source with hUdef
  have hU : Dense (U : Set Y) := e.dense_target.inter_of_isOpen_right e'.dense_source e'.source.2
  set rS' := e.symm.restrictSource U hU inf_le_left with hrS'
  have hrTe : rS'.target ≤ e.source := Scheme.Opens.ι_image_le e.source _
  have hSt : rS'.source ≤ e.target := inf_le_left
  have hSs : rS'.source ≤ e'.source := inf_le_right
  have h1 : rS'.iso.hom ≫ rS'.target.ι = Y.homOfLE hSt ≫ e.iso.inv ≫ e.source.ι :=
    restrictSource_iso_hom_ι e.symm U hU inf_le_left
  have h1' : rS'.iso.hom ≫ X.homOfLE hrTe = Y.homOfLE hSt ≫ e.iso.inv := by
    refine (cancel_mono e.source.ι).mp ?_
    simp only [Category.assoc, Scheme.homOfLE_ι]; exact h1
  have h2 : X.homOfLE hrTe = rS'.iso.inv ≫ Y.homOfLE hSt ≫ e.iso.inv :=
    (Iso.eq_inv_comp _).mpr h1'
  have hrTι : rS'.iso.inv ≫ rS'.source.ι = X.homOfLE hrTe ≫ e.iso.hom ≫ e.target.ι := by
    rw [h2]; simp
  have h3 : (e'.restrictSource U hU inf_le_right).iso.hom ≫
      (e'.restrictSource U hU inf_le_right).target.ι =
      Y.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι := restrictSource_iso_hom_ι e' U hU inf_le_right
  have hid : (Y.isoOfEq (refl U)).hom = 𝟙 _ := by simp [Scheme.isoOfEq_rfl]
  -- the composite partial isomorphism, as a morphism
  have htrans : (e.trans e').iso.hom ≫ (e.trans e').target.ι =
      rS'.iso.inv ≫ Y.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι := by
    have : (e.trans e').iso.hom ≫ (e.trans e').target.ι = rS'.iso.inv ≫ (Y.isoOfEq (refl U)).hom ≫
        ((e'.restrictSource U hU inf_le_right).iso.hom ≫
          (e'.restrictSource U hU inf_le_right).target.ι) := rfl
    exact this.trans (congrArg (rS'.iso.inv ≫ ·)
      ((congrArg ((Y.isoOfEq (refl U)).hom ≫ ·) h3).trans
        ((congrArg (· ≫ (Y.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι)) hid).trans
          (Category.id_comp _))))
  -- both restricted morphisms factor through the source of `e'`
  set c := e.toPartialMap.comp e'.toPartialMap with hc
  set O := (e.trans e').toPartialMap.domain ⊓ c.domain with hOdef
  have hOa : O ≤ rS'.target := inf_le_left
  have hOc : O ≤ c.domain := inf_le_right
  have hOe : O ≤ e.source := hOa.trans hrTe
  have R1 : ((e.toPartialMap.domain.ι.isoImage (e.toPartialMap.hom ⁻¹ᵁ e'.source)).inv ≫
      e.toPartialMap.hom ∣_ e'.source) ≫ e'.source.ι =
      X.homOfLE (Scheme.Opens.ι_image_le e.toPartialMap.domain _) ≫ e.toPartialMap.hom := by
    rw [Category.assoc, morphismRestrict_ι, Scheme.Opens.isoImage_ι_inv_ι_assoc]
  have key : X.homOfLE hOa ≫ rS'.iso.inv ≫ Y.homOfLE hSs =
      X.homOfLE hOc ≫ (e.toPartialMap.domain.ι.isoImage (e.toPartialMap.hom ⁻¹ᵁ e'.source)).inv ≫
        e.toPartialMap.hom ∣_ e'.source := by
    refine (cancel_mono e'.source.ι).mp ?_
    have L : (X.homOfLE hOa ≫ rS'.iso.inv ≫ Y.homOfLE hSs) ≫ e'.source.ι =
        X.homOfLE hOe ≫ e.toPartialMap.hom := by
      simp only [Category.assoc, Scheme.homOfLE_ι]
      rw [hrTι, Scheme.homOfLE_homOfLE_assoc]; rfl
    have R : (X.homOfLE hOc ≫
        (e.toPartialMap.domain.ι.isoImage (e.toPartialMap.hom ⁻¹ᵁ e'.source)).inv ≫
        e.toPartialMap.hom ∣_ e'.source) ≫ e'.source.ι = X.homOfLE hOe ≫ e.toPartialMap.hom :=
      (Category.assoc _ _ _).trans ((congrArg (X.homOfLE hOc ≫ ·) R1).trans
        (X.homOfLE_homOfLE_assoc hOc (Scheme.Opens.ι_image_le e.toPartialMap.domain _) _))
    rw [L, R]
  show X.homOfLE hOa ≫ ((e.trans e').iso.hom ≫ (e.trans e').target.ι) =
    X.homOfLE hOc ≫
      ((Scheme.Hom.isoImage e.toPartialMap.domain.ι (e.toPartialMap.hom ⁻¹ᵁ e'.source)).inv ≫
      e.toPartialMap.hom ∣_ e'.source ≫ e'.toPartialMap.hom)
  exact (congrArg (X.homOfLE hOa ≫ ·) htrans).trans ((reassoc_of% key) (e'.iso.hom ≫ e'.target.ι))

/-- The value of a composite of partial maps at a point where it is defined. -/
private theorem comp_hom_apply {X Y Z : Scheme.{0}} [PreirreducibleSpace X] [Nonempty Y]
    (g : X.PartialMap Y) [IsDominant g.hom] (h : Y.PartialMap Z) {x : X} (hx : x ∈ g.domain)
    (hgx : g.hom ⟨x, hx⟩ ∈ h.domain) :
    ∃ hxc : x ∈ (g.comp h).domain, (g.comp h).hom ⟨x, hxc⟩ = h.hom ⟨g.hom ⟨x, hx⟩, hgx⟩ := by
  have hxc : x ∈ (g.comp h).domain := ⟨⟨x, hx⟩, hgx, rfl⟩
  refine ⟨hxc, ?_⟩
  set z := (Scheme.Hom.isoImage g.domain.ι (g.hom ⁻¹ᵁ h.domain)).inv ⟨x, hxc⟩ with hz
  have hz1 : (z.1 : g.domain.toScheme) = ⟨x, hx⟩ := by
    have h1 : (g.domain.ι ''ᵁ g.hom ⁻¹ᵁ h.domain).ι
        ((Scheme.Hom.isoImage g.domain.ι (g.hom ⁻¹ᵁ h.domain)).hom z) =
          g.domain.ι ((g.hom ⁻¹ᵁ h.domain).ι z) :=
      congrArg (fun φ : (g.hom ⁻¹ᵁ h.domain).toScheme ⟶ X => φ z)
        (Scheme.Hom.isoImage_hom_ι g.domain.ι (g.hom ⁻¹ᵁ h.domain))
    have h2 : (Scheme.Hom.isoImage g.domain.ι (g.hom ⁻¹ᵁ h.domain)).hom z = ⟨x, hxc⟩ :=
      congrArg (fun φ : (g.domain.ι ''ᵁ g.hom ⁻¹ᵁ h.domain).toScheme ⟶ _ => φ ⟨x, hxc⟩)
        (Iso.inv_hom_id (Scheme.Hom.isoImage g.domain.ι (g.hom ⁻¹ᵁ h.domain)))
    rw [h2] at h1
    exact Subtype.ext h1.symm
  have hz2 : (g.hom ∣_ h.domain) z = ⟨g.hom ⟨x, hx⟩, hgx⟩ := by
    apply Subtype.ext
    rw [morphismRestrict_base_coe, hz1]
  show h.hom ((g.hom ∣_ h.domain) z) = h.hom ⟨g.hom ⟨x, hx⟩, hgx⟩
  rw [hz2]

/-- A composite with a partial isomorphism followed by its inverse. -/
private theorem comp_comp_symm {X Y Y' : Scheme.{0}} [IsIntegral X] [IsIntegral Y] [IsIntegral Y']
    (ψ : X.RationalMap Y) [ψ.IsDominant] (ε : Y.PartialIso Y') [IsDominant ε.toPartialMap.hom] :
    (ψ.comp ε.toRationalMap).comp ε.symm.toRationalMap = ψ := by
  haveI := isDominant_partialIso_hom ε
  rw [Scheme.RationalMap.comp_assoc, MMP.Fourfold.Crepant.comp_eq_id_of_isInverse
    (MMP.Mori.RationalMap.isInverse_toRationalMap ε), Scheme.RationalMap.comp_id]

/-- **Prime divisors along a composite with a partial isomorphism** `ε : Y ⤏ Y'` whose source
contains the generic points of the primes it carries onto every prime of `Y'`: the strict
transform of the composite is the composite of the strict transforms. -/
private theorem transformPrimeDivisor_comp_partialIso {X Y Y' : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsIntegral Y'] [IsSeparated (Y ↘ ⊤_ Scheme)] [IsSeparated (Y' ↘ ⊤_ Scheme)]
    (ψ : X.RationalMap Y) [ψ.IsDominant] (ε : Y.PartialIso Y')
    (hS : ∀ G' : MMP.Mori.PrimeDivisor Y', ∃ (G : MMP.Mori.PrimeDivisor Y)
      (hG : G.genericPoint ∈ ε.source), ε.toPartialMap.hom ⟨G.genericPoint, hG⟩ = G'.genericPoint)
    (P : MMP.Mori.PrimeDivisor X) [IsDominant ε.toPartialMap.hom] :
    MMP.Mori.RationalMap.transformPrimeDivisor (ψ.comp ε.toRationalMap) P =
      (MMP.Mori.RationalMap.transformPrimeDivisor ψ P).bind
        (MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap) := by
  haveI := isDominant_partialIso_hom ε
  haveI := isDominant_partialIso_hom ε.symm
  -- a representative at the generic point of a transform
  have hrep : ∀ {A B : Scheme.{0}} [IsReduced A] [IsSeparated (B ↘ ⊤_ Scheme)]
      (φ : A.RationalMap B) (R : MMP.Mori.PrimeDivisor A) (R' : MMP.Mori.PrimeDivisor B),
      MMP.Mori.RationalMap.transformPrimeDivisor φ R = some R' →
        ∃ (g : A.PartialMap B) (hg : g.toRationalMap = φ) (hR : R.genericPoint ∈ g.domain),
          g.hom ⟨R.genericPoint, hR⟩ = R'.genericPoint := by
    intro A B _ _ φ R R' h
    obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h
    obtain ⟨g, hRg, hg⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
    exact ⟨g, hg, hRg, (MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h g hg hRg).symm⟩
  -- the composite of representatives
  have hcomp : ∀ (Q : MMP.Mori.PrimeDivisor Y) (Q' : MMP.Mori.PrimeDivisor Y'),
      MMP.Mori.RationalMap.transformPrimeDivisor ψ P = some Q →
      MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap Q = some Q' →
      MMP.Mori.RationalMap.transformPrimeDivisor (ψ.comp ε.toRationalMap) P = some Q' := by
    intro Q Q' hQ hQ'
    obtain ⟨g, hg, hPg, hgP⟩ := hrep ψ P Q hQ
    obtain ⟨h, hh, hQh, hhQ⟩ := hrep ε.toRationalMap Q Q' hQ'
    haveI : IsDominant g.hom := by
      rw [← g.isDominant_toRationalMap_iff, hg]; infer_instance
    obtain ⟨hxc, hval⟩ := comp_hom_apply g h hPg (by rw [hgP]; exact hQh)
    refine MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq (g.comp h) ?_ hxc ?_
    · rw [← Scheme.RationalMap.toRationalMap_comp, hh]
      exact MMP.Fourfold.Crepant.comp_eq_comp_of_eq hg _
    · rw [hval, ← hhQ]
      congr 1
      exact Subtype.ext hgP.symm
  -- the converse, through the inverse
  have hback : ∀ G' : MMP.Mori.PrimeDivisor Y',
      MMP.Mori.RationalMap.transformPrimeDivisor (ψ.comp ε.toRationalMap) P = some G' →
        ∃ G : MMP.Mori.PrimeDivisor Y, MMP.Mori.RationalMap.transformPrimeDivisor ψ P = some G ∧
          MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap G = some G' := by
    intro G' hG'
    obtain ⟨k, hk, hPk, hkP⟩ := hrep _ P G' hG'
    obtain ⟨G, hG, hεG⟩ := hS G'
    have hG'T : G'.genericPoint ∈ ε.target := by
      rw [← hεG]; exact (ε.iso.hom ⟨G.genericPoint, hG⟩).2
    haveI : IsDominant k.hom := by
      rw [← k.isDominant_toRationalMap_iff, hk]; infer_instance
    have hmem : k.hom ⟨P.genericPoint, hPk⟩ ∈ ε.target := by rw [hkP]; exact hG'T
    obtain ⟨hxc, hval⟩ := comp_hom_apply k ε.symm.toPartialMap hPk hmem
    have hsymm : ε.symm.toPartialMap.hom ⟨k.hom ⟨P.genericPoint, hPk⟩, hmem⟩ =
        G.genericPoint := by
      have e1 : ε.iso.hom ⟨G.genericPoint, hG⟩ = ⟨k.hom ⟨P.genericPoint, hPk⟩, hmem⟩ :=
        Subtype.ext (hεG.trans hkP.symm)
      have e2 : ε.iso.inv ⟨k.hom ⟨P.genericPoint, hPk⟩, hmem⟩ = ⟨G.genericPoint, hG⟩ := by
        rw [← e1]
        exact congrArg (fun φ : ε.source.toScheme ⟶ ε.source.toScheme => φ ⟨G.genericPoint, hG⟩)
          (Iso.hom_inv_id ε.iso)
      show ε.source.ι (ε.iso.inv ⟨k.hom ⟨P.genericPoint, hPk⟩, hmem⟩) = G.genericPoint
      rw [e2]; rfl
    refine ⟨G, MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq
      (k.comp ε.symm.toPartialMap)
      ?_ hxc ?_, MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq ε.toPartialMap rfl hG
        hεG.symm⟩
    · rw [← Scheme.RationalMap.toRationalMap_comp]
      exact (MMP.Fourfold.Crepant.comp_eq_comp_of_eq hk _).trans (comp_comp_symm ψ ε)
    · rw [hval, hsymm]
  rcases hψP : MMP.Mori.RationalMap.transformPrimeDivisor ψ P with _ | Q
  · rcases hc : MMP.Mori.RationalMap.transformPrimeDivisor (ψ.comp ε.toRationalMap) P with _ | G'
    · rfl
    · obtain ⟨G, hG, -⟩ := hback G' hc
      rw [hψP] at hG; exact absurd hG (by simp)
  · show _ = MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap Q
    rcases hεQ : MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap Q with _ | Q'
    · rcases hc : MMP.Mori.RationalMap.transformPrimeDivisor (ψ.comp ε.toRationalMap) P with _ | G'
      · rfl
      · obtain ⟨G, hG, hεG⟩ := hback G' hc
        rw [hψP] at hG
        obtain rfl := Option.some.inj hG
        rw [hεQ] at hεG; exact absurd hεG (by simp)
    · exact hcomp Q Q' hψP hεQ

/-- A partial isomorphism over `p`, `q` defines a rational map over `p`, `q`. -/
private theorem partialIso_toRationalMap_isOver {X Y T : Scheme.{0}} (e : X.PartialIso Y)
    {p : X ⟶ T} {q : Y ⟶ T} (h : e.IsOver p q) :
    MMP.Flips.RationalMap.IsOver p q e.toRationalMap := by
  rw [MMP.Flips.RationalMap.IsOver, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨e.source, e.dense_source, le_rfl, le_top, ?_⟩
  change X.homOfLE (le_rfl : e.source ≤ e.source) ≫ (e.iso.hom ≫ e.target.ι) ≫ q =
    X.homOfLE (le_top : e.source ≤ ⊤) ≫ X.topIso.hom ≫ p
  rw [Category.assoc, h]
  simp

/-- A rational map left-inverse to a composite with a partial isomorphism. -/
private theorem comp_symm_trans_eq {X Y Y' : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Y'] [IsSeparated (Y' ↘ ⊤_ Scheme)] (e : X.PartialIso Y) (ε : Y.PartialIso Y')
    [IsDominant ε.toPartialMap.hom] :
    ε.toRationalMap.comp (e.trans ε).symm.toRationalMap = e.symm.toRationalMap := by
  haveI := isDominant_partialIso_hom e
  haveI := isDominant_partialIso_hom e.symm
  haveI := isDominant_partialIso_hom ε
  haveI := isDominant_partialIso_hom (e.trans ε)
  set x := ε.toRationalMap.comp (e.trans ε).symm.toRationalMap
  have h1 : e.toRationalMap.comp x = Scheme.RationalMap.id X := by
    rw [← Scheme.RationalMap.comp_assoc]
    exact (MMP.Fourfold.Crepant.comp_eq_comp_of_eq (toRationalMap_trans e ε).symm _).trans
      (MMP.Fourfold.Crepant.comp_eq_id_of_isInverse
        (MMP.Mori.RationalMap.isInverse_toRationalMap (e.trans ε)))
  have h2 : e.symm.toRationalMap.comp e.toRationalMap = Scheme.RationalMap.id Y :=
    MMP.Fourfold.Crepant.comp_eq_id_of_isInverse
      (MMP.Mori.RationalMap.isInverse_toRationalMap e).symm
  calc x = (Scheme.RationalMap.id Y).comp x := (Scheme.RationalMap.id_comp x).symm
    _ = (e.symm.toRationalMap.comp e.toRationalMap).comp x :=
        MMP.Fourfold.Crepant.comp_eq_comp_of_eq h2.symm x
    _ = e.symm.toRationalMap.comp (e.toRationalMap.comp x) := Scheme.RationalMap.comp_assoc _ _ _
    _ = e.symm.toRationalMap := by rw [h1, Scheme.RationalMap.comp_id]

end Composite

/-! ### Birationality of the reference map -/

section PltReferenceHelpers

open AlgebraicGeometry CategoryTheory

/-- A rational map commuting with the structure morphisms at the generic point is a rational
map over `Spec k`. -/
private theorem compHom_eq_toRationalMap_of_fromFunctionField_comp {k : Type u} [Field k]
    {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} [IsIntegral X]
    (φ : X.RationalMap Y)
    (hφk : φ.fromFunctionField ≫ sY = X.fromSpecStalk (genericPoint X) ≫ sX) :
    φ.compHom sY = sX.toRationalMap := by
  apply Scheme.RationalMap.eq_of_fromFunctionField_eq
  rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
    Scheme.RationalMap.fromFunctionField_toRationalMap, hφk]
  exact (Scheme.PartialMap.fromSpecStalkOfMem_toPartialMap _ _).symm

/-- The birational map to a nef log birational model commutes with the structure morphisms at
the generic point. -/
private theorem fromFunctionField_comp_eq_of_isNefLogBirationalModel {k : Type u} [Field k]
    {X Y Z : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} {sZ : Z ⟶ Spec (.of k)}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [LocallyOfFiniteType sX]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : MMP.Mori.Divisor X} {Δ : MMP.Mori.RDivisor X} {KY : MMP.Mori.Divisor Y}
    {ΔY : MMP.Mori.RDivisor Y} {φ : X.RationalMap Y}
    (hY : MMP.Fourfold.IsNefLogBirationalModel sX sY sZ π πY KX Δ KY ΔY φ) :
    φ.fromFunctionField ≫ sY = X.fromSpecStalk (genericPoint X) ≫ sX := by
  have h1 := congrArg Scheme.RationalMap.fromFunctionField hY.isOver
  have h2 : π.toPartialMap.fromFunctionField = X.fromSpecStalk (genericPoint X) ≫ π :=
    Scheme.PartialMap.fromSpecStalkOfMem_toPartialMap π _
  rw [MMP.Flips.RationalMap.fromFunctionField_compHom,
    Scheme.RationalMap.fromFunctionField_toRationalMap, h2] at h1
  rw [← hY.comp_eq_model, ← Category.assoc, h1, Category.assoc, hY.comp_eq]

end PltReferenceHelpers

section ReferenceInverse

/-- The canonical map from the spectrum of a stalk into an open factors through every larger
open. -/
private theorem fromSpecStalkOfMem_homOfLE {X : Scheme.{0}} {U V : X.Opens} (h : U ≤ V) (x : X)
    (hx : x ∈ U) :
    U.fromSpecStalkOfMem x hx ≫ X.homOfLE h = V.fromSpecStalkOfMem x (h hx) := by
  rw [← cancel_mono V.ι, Category.assoc, Scheme.homOfLE_ι, Scheme.Opens.fromSpecStalkOfMem_ι,
    Scheme.Opens.fromSpecStalkOfMem_ι]

/-- If a partial isomorphism `e` represents a dominant morphism `p`, then `e.trans e'` sends the
generic point as `p` followed by `e'`. -/
private theorem fromFunctionField_trans_of_toRationalMap_eq {W X Y : Scheme.{0}} [IsIntegral W]
    [IsIntegral X] (p : W ⟶ X) [IsDominant p] (e : W.PartialIso X)
    (he : e.toRationalMap = p.toRationalMap) (e' : X.PartialIso Y) :
    (e.trans e').toRationalMap.fromFunctionField =
      Spec.map (CommRingCat.ofHom (functionFieldMap p)) ≫ e'.toRationalMap.fromFunctionField := by
  set U : X.Opens := e.target ⊓ e'.source with hUdef
  have hU : Dense (U : Set X) := e.dense_target.inter_of_isOpen_right e'.dense_source e'.source.2
  set rS' := e.symm.restrictSource U hU inf_le_left with hrS'
  have hrTe : rS'.target ≤ e.source := Scheme.Opens.ι_image_le e.source _
  have hSt : rS'.source ≤ e.target := inf_le_left
  have hSs : rS'.source ≤ e'.source := inf_le_right
  have h1 : rS'.iso.hom ≫ rS'.target.ι = X.homOfLE hSt ≫ e.iso.inv ≫ e.source.ι :=
    restrictSource_iso_hom_ι e.symm U hU inf_le_left
  have h1' : rS'.iso.hom ≫ W.homOfLE hrTe = X.homOfLE hSt ≫ e.iso.inv := by
    refine (cancel_mono e.source.ι).mp ?_
    simp only [Category.assoc, Scheme.homOfLE_ι]; exact h1
  have h2 : W.homOfLE hrTe = rS'.iso.inv ≫ X.homOfLE hSt ≫ e.iso.inv :=
    (Iso.eq_inv_comp _).mpr h1'
  have hrTι : rS'.iso.inv ≫ rS'.source.ι = W.homOfLE hrTe ≫ e.iso.hom ≫ e.target.ι := by
    rw [h2]; simp
  have h3 : (e'.restrictSource U hU inf_le_right).iso.hom ≫
      (e'.restrictSource U hU inf_le_right).target.ι =
      X.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι := restrictSource_iso_hom_ι e' U hU inf_le_right
  have hid : (X.isoOfEq (refl U)).hom = 𝟙 _ := by simp [Scheme.isoOfEq_rfl]
  have htrans : (e.trans e').iso.hom ≫ (e.trans e').target.ι =
      rS'.iso.inv ≫ X.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι := by
    have : (e.trans e').iso.hom ≫ (e.trans e').target.ι = rS'.iso.inv ≫ (X.isoOfEq (refl U)).hom ≫
        ((e'.restrictSource U hU inf_le_right).iso.hom ≫
          (e'.restrictSource U hU inf_le_right).target.ι) := rfl
    exact this.trans (congrArg (rS'.iso.inv ≫ ·)
      ((congrArg ((X.isoOfEq (refl U)).hom ≫ ·) h3).trans
        ((congrArg (· ≫ (X.homOfLE hSs ≫ e'.iso.hom ≫ e'.target.ι)) hid).trans
          (Category.id_comp _))))
  -- the generic points
  have hgX : genericPoint X ∈ rS'.source :=
    (genericPoint_specializes _).mem_open rS'.source.2 rS'.dense_source.nonempty.choose_spec
  have hgW : genericPoint W ∈ rS'.target :=
    (genericPoint_specializes _).mem_open rS'.target.2 rS'.dense_target.nonempty.choose_spec
  have hgWe : genericPoint W ∈ e.source := hrTe hgW
  -- the generic point of `W` along `e`
  have hep : e.source.fromSpecStalkOfMem (genericPoint W) hgWe ≫ e.iso.hom ≫ e.target.ι =
      W.fromSpecStalk (genericPoint W) ≫ p := by
    have h := congrArg Scheme.RationalMap.fromFunctionField he
    rw [Scheme.RationalMap.fromFunctionField_toRationalMap,
      MMP.Flips.RationalMap.fromFunctionField_hom] at h
    exact h
  have ha : rS'.target.fromSpecStalkOfMem (genericPoint W) hgW ≫ rS'.iso.inv =
      Spec.map (CommRingCat.ofHom (functionFieldMap p)) ≫
        rS'.source.fromSpecStalkOfMem (genericPoint X) hgX := by
    refine (cancel_mono rS'.source.ι).mp ?_
    rw [Category.assoc, hrTι, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι,
      ← Category.assoc, fromSpecStalkOfMem_homOfLE, hep, functionFieldMap_fromSpecStalk]
  rw [Scheme.RationalMap.fromFunctionField_toRationalMap,
    Scheme.RationalMap.fromFunctionField_toRationalMap]
  show rS'.target.fromSpecStalkOfMem (genericPoint W) hgW ≫
      ((e.trans e').iso.hom ≫ (e.trans e').target.ι) =
    Spec.map (CommRingCat.ofHom (functionFieldMap p)) ≫
      (e'.source.fromSpecStalkOfMem (genericPoint X) (hSs hgX) ≫ (e'.iso.hom ≫ e'.target.ι))
  refine (congrArg (rS'.target.fromSpecStalkOfMem (genericPoint W) hgW ≫ ·) htrans).trans ?_
  rw [← Category.assoc, ha, Category.assoc, ← Category.assoc
    (rS'.source.fromSpecStalkOfMem (genericPoint X) hgX), fromSpecStalkOfMem_homOfLE]

/-- A partial isomorphism whose rational map lies over `p`, `q`, for a separated base, lies over
`p`, `q`. -/
private theorem partialIso_isOver_of_isOver {X Y T : Scheme.{0}} [IsReduced X]
    [IsSeparated (T ↘ ⊤_ Scheme)] (e : X.PartialIso Y) {p : X ⟶ T} {q : Y ⟶ T}
    (h : MMP.Flips.RationalMap.IsOver p q e.toRationalMap) : e.IsOver p q := by
  have h1 : (e.toPartialMap.compHom q).toRationalMap = p.toPartialMap.toRationalMap := by
    rw [Scheme.RationalMap.compHom_toRationalMap]; exact h
  have h2 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
    (Scheme.PartialMap.toRationalMap_eq_iff.mp h1)
  have h3 : (e.iso.hom ≫ e.target.ι) ≫ q = e.source.ι ≫ p := h2
  exact (Category.assoc _ _ _).symm.trans h3

/-- **Strict transforms along a birational map are injective** when the inverse is defined in
codimension one: distinct prime divisors have distinct strict transforms. -/
private theorem eq_of_transformPrimeDivisor_eq_some {X Y S : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [IsSeparated (X ↘ ⊤_ Scheme)]
    [IsSeparated (Y ↘ ⊤_ Scheme)] {sX : X ⟶ S} {sY : Y ⟶ S} [IsProper sX]
    {ψ : X.RationalMap Y} {ψinv : Y.RationalMap X} (H : MMP.Mori.RationalMap.IsInverse ψ ψinv)
    (hk : MMP.Flips.RationalMap.IsOver sY sX ψinv) {P Q : MMP.Mori.PrimeDivisor X}
    {F : MMP.Mori.PrimeDivisor Y}
    (hP : MMP.Mori.RationalMap.transformPrimeDivisor ψ P = some F)
    (hQ : MMP.Mori.RationalMap.transformPrimeDivisor ψ Q = some F) : P = Q := by
  obtain ⟨e, he, -⟩ := id H
  haveI := isDominant_partialIso_hom e
  haveI : ψ.IsDominant := he ▸ inferInstance
  have hF : F.genericPoint ∈ ψinv.domain :=
    MMP.Flips.RationalMap.mem_domain_of_coheight_le_one sY sX ψinv hk
      F.coheight_genericPoint.le
  obtain ⟨r, hrF, hr⟩ := Scheme.RationalMap.mem_domain.mp hF
  have key : ∀ P : MMP.Mori.PrimeDivisor X,
      MMP.Mori.RationalMap.transformPrimeDivisor ψ P = some F →
        r.hom ⟨F.genericPoint, hrF⟩ = P.genericPoint := by
    intro P hP
    obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp hP
    obtain ⟨g, hPg, hg⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
    have hgF := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hP g hg hPg
    haveI : IsDominant g.hom :=
      (Scheme.PartialMap.isDominant_toRationalMap_iff g).mp (hg ▸ inferInstance)
    have hgr : g.hom ⟨P.genericPoint, hPg⟩ ∈ r.domain := hgF ▸ hrF
    obtain ⟨hxc, hval⟩ := comp_hom_apply g r hPg hgr
    have hid : (g.comp r).toRationalMap = ((𝟙 X : X ⟶ X).toPartialMap).toRationalMap := by
      have hgr' : g.toRationalMap.comp r.toRationalMap = ψ.comp ψinv := by
        rw [hr]; exact MMP.Fourfold.Crepant.comp_eq_comp_of_eq hg _
      rw [← Scheme.RationalMap.toRationalMap_comp, hgr']
      exact MMP.Fourfold.Crepant.comp_eq_id_of_isInverse H
    have h2 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp hid)
    rw [Category.comp_id] at h2
    have h3 : (g.comp r).hom ⟨P.genericPoint, hxc⟩ = P.genericPoint :=
      (congrArg (fun φ : (g.comp r).domain.toScheme ⟶ X => φ ⟨P.genericPoint, hxc⟩) h2).trans
        rfl
    calc r.hom ⟨F.genericPoint, hrF⟩ = r.hom ⟨g.hom ⟨P.genericPoint, hPg⟩, hgr⟩ :=
          congrArg (fun y => r.hom y) (Subtype.ext hgF)
      _ = (g.comp r).hom ⟨P.genericPoint, hxc⟩ := hval.symm
      _ = P.genericPoint := h3
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    ((key P hP).symm.trans (key Q hQ))

/-- **The reference map is birational over `Spec ℂ`.** Let `p : W ⟶ X` be a birational morphism
over `Spec ℂ` and `φ : X ⤏ Y` a birational map over `Spec ℂ`. A rational map `ψ : W ⤏ Y` that
agrees with `φ ∘ p` at the generic point of `W` has an inverse, and both lie over `Spec ℂ`. -/
private theorem exists_isInverse_of_fromFunctionField_eq {W X Y : Scheme.{0}} [IsIntegral W]
    [IsIntegral X] [IsIntegral Y] [IsSeparated (X ↘ ⊤_ Scheme)] [IsSeparated (Y ↘ ⊤_ Scheme)]
    [IsSeparated (W ↘ ⊤_ Scheme)] {sW : W ⟶ Spec (.of ℂ)} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} {p : W ⟶ X} [IsDominant p] (hp : IsBirationalMorphism p)
    (hpX : p ≫ sX = sW) {φ : X.RationalMap Y} (hφ : MMP.Mori.RationalMap.IsBirational φ)
    (hφk : φ.fromFunctionField ≫ sY = X.fromSpecStalk (genericPoint X) ≫ sX)
    {ψ : W.RationalMap Y}
    (hψ : Spec.map (CommRingCat.ofHom (functionFieldMap p)) ≫ φ.fromFunctionField =
      ψ.fromFunctionField) :
    ∃ ψinv : Y.RationalMap W, MMP.Mori.RationalMap.IsInverse ψ ψinv ∧
      MMP.Flips.RationalMap.IsOver sW sY ψ ∧ MMP.Flips.RationalMap.IsOver sY sW ψinv := by
  haveI : IsSeparated (Spec (.of ℂ) ↘ ⊤_ Scheme) := inferInstance
  obtain ⟨ep, hep⟩ := hp
  obtain ⟨eφ, heφ⟩ := hφ
  have hψe : ψ = (ep.trans eφ).toRationalMap := by
    apply Scheme.RationalMap.eq_of_fromFunctionField_eq
    rw [fromFunctionField_trans_of_toRationalMap_eq p ep hep eφ, heφ, hψ]
  have hψk : ψ.fromFunctionField ≫ sY = W.fromSpecStalk (genericPoint W) ≫ sW := by
    rw [← hψ, Category.assoc, hφk, ← Category.assoc, functionFieldMap_fromSpecStalk,
      Category.assoc, hpX]
  have hover : MMP.Flips.RationalMap.IsOver sW sY ψ :=
    compHom_eq_toRationalMap_of_fromFunctionField_comp ψ hψk
  have he : (ep.trans eφ).IsOver sW sY := partialIso_isOver_of_isOver _ (hψe ▸ hover)
  exact ⟨(ep.trans eφ).symm.toRationalMap, ⟨ep.trans eφ, hψe.symm, rfl⟩, hover,
    partialIso_toRationalMap_isOver _ he.symm⟩

end ReferenceInverse

/-! ### The reference along a floor chain -/

section Reference

variable {Z : Scheme.{0}} {W₀ : Scheme.{0}} [IsIntegral W₀] [CompactSpace W₀]
  [IsLocallyNoetherian W₀] [IsNormal W₀]

/-- The properties of the reference maps `ψ : W₀ ⤏ Y_i`, `ψ⁻¹` at a stage of a floor chain at
`E`: inverse birational maps over `ℂ` carrying the reference prime `E_W` to `E`, whose extracted
primes are sent off `Supp A'`, and with `ψ_* A' ≤ B' - E` for the modified boundary
`B' = B + c · div(u)`. -/
private def Stage.IsReferenceChain (sW₀ : W₀ ⟶ Spec (.of ℂ)) (EW : MMP.Mori.PrimeDivisor W₀)
    (A' : QDivisor W₀) (S : Stage Z) (E : MMP.Mori.PrimeDivisor S.Y) (c : ℝ)
    (u : (RationalFunctions S.Y)ˣ) (ψ : W₀.RationalMap S.Y) (ψinv : S.Y.RationalMap W₀) : Prop :=
  MMP.Mori.RationalMap.IsInverse ψ ψinv ∧ MMP.Flips.RationalMap.IsOver sW₀ S.sY ψ ∧
    MMP.Flips.RationalMap.IsOver S.sY sW₀ ψinv ∧
    MMP.Mori.RationalMap.transformPrimeDivisor ψ EW = some E ∧
    (∀ F : MMP.Mori.PrimeDivisor S.Y, MMP.Flips.RationalMap.IsInverseExceptional ψ F →
      ∀ q : S.Y.PartialMap W₀, q.toRationalMap = ψinv → ∀ hF : F.genericPoint ∈ q.domain,
        q.hom ⟨F.genericPoint, hF⟩ ∉ (A'.supp : Set W₀)) ∧
    QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ A') ≤
      S.B + c • Divisor.toRDivisor (principalDivisor u) - Finsupp.single E 1

/-- **The reference maps survive a step**: composing with the birational map of the step. -/
private theorem Stage.IsReferenceChain.next {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    {sW₀ : W₀ ⟶ Spec (.of ℂ)} (hW₀ : IsNormalVariety ℂ sW₀) {EW : MMP.Mori.PrimeDivisor W₀}
    {A' : QDivisor W₀} (hA'0 : 0 ≤ A') {S S' : Stage Z} {D : StepData S S'} (hS : S.Inv sZ α)
    (hS' : S'.Inv sZ α) (hext : StepExtra S S' D) {E : MMP.Mori.PrimeDivisor S.Y} {c : ℝ}
    {u : (RationalFunctions S.Y)ˣ} {ψ : W₀.RationalMap S.Y} {ψinv : S.Y.RationalMap W₀}
    (href : S.IsReferenceChain sW₀ EW A' E c u ψ ψinv) {E' : MMP.Mori.PrimeDivisor S'.Y}
    (hEE' : MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp E = some E')
    {u' : (RationalFunctions S'.Y)ˣ}
    (htr : flipTransform D.f D.fp (S.B + c • Divisor.toRDivisor (principalDivisor u)) =
      S'.B + c • Divisor.toRDivisor (principalDivisor u')) :
    ∃ (ψ' : W₀.RationalMap S'.Y) (ψinv' : S'.Y.RationalMap W₀),
      S'.IsReferenceChain sW₀ EW A' E' c u' ψ' ψinv' := by
  classical
  obtain ⟨-, -, -, hWn, hfc, hbf, hfp, -, -, -, -, -⟩ := hext
  haveI := hfc.isProper
  haveI := hfp.isProper
  have hbfp := MMP.Flips.IsSmall.isBirationalMorphism D.sW S'.sY hfp
  have hYp := hS.1
  have hY'p := hS'.1
  haveI : IsSeparated S.sY := hYp.toIsVariety.toIsSeparated
  haveI : S.Y.IsSeparated := ⟨by rw [← Limits.terminal.comp_from S.sY]; infer_instance⟩
  haveI : IsSeparated S'.sY := hY'p.toIsVariety.toIsSeparated
  haveI : S'.Y.IsSeparated := ⟨by rw [← Limits.terminal.comp_from S'.sY]; infer_instance⟩
  set ε := roofIso hbf hbfp with hε
  obtain ⟨⟨e, he, he'⟩, hψk, hψinvk, hψS, hord, hAB⟩ := href
  haveI := isDominant_partialIso_hom e
  haveI := isDominant_partialIso_hom ε
  haveI := isDominant_partialIso_hom ε.symm
  haveI := isDominant_partialIso_hom e.symm
  haveI : ψ.IsDominant := he ▸ inferInstance
  have hεtr : ∀ Q, MMP.Mori.RationalMap.transformPrimeDivisor ε.toRationalMap Q =
      MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp Q := transformPrimeDivisor_roofIso hWn hbf hfp
  obtain ⟨-, -, hsurj, -, -⟩ := roofTransformPrimeDivisor_spec hWn hbf hfp
  -- every prime of the next stage is reached by `ε` from the source
  have hSε : ∀ G' : MMP.Mori.PrimeDivisor S'.Y, ∃ (G : MMP.Mori.PrimeDivisor S.Y)
      (hG : G.genericPoint ∈ ε.source), ε.toPartialMap.hom ⟨G.genericPoint, hG⟩ =
        G'.genericPoint := fun G' => by
    obtain ⟨G, hG⟩ := hsurj G'
    have h1 := (hεtr G).trans hG
    obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h1
    -- `ε` itself is defined at `η_G`
    have hGU : G.genericPoint ∈ ε.source := by
      obtain ⟨hchar, -⟩ := (roofTransformPrimeDivisor_spec hWn hbf hfp).2
      obtain ⟨Q, hQ⟩ := MMP.Flips.exists_primeDivisor_map_genericPoint_eq_of_isSmall hfp G'
      show D.f G.genericPoint ∈ roofLocus D.f D.fp
      rw [hchar G G' hG, hQ]
      exact genericPoint_mem_roofLocus hWn hbf hbfp Q
    exact ⟨G, hGU, (MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h1
      ε.toPartialMap rfl hGU).symm⟩
  have htrans : (e.trans ε).toRationalMap = ψ.comp ε.toRationalMap := by
    rw [toRationalMap_trans]
    exact MMP.Fourfold.Crepant.comp_eq_comp_of_eq he _
  have hbind : ∀ P, MMP.Mori.RationalMap.transformPrimeDivisor (e.trans ε).toRationalMap P =
      (MMP.Mori.RationalMap.transformPrimeDivisor ψ P).bind
        (MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp) := fun P => by
    rw [htrans, transformPrimeDivisor_comp_partialIso ψ ε hSε P]
    congr 1
    funext Q
    exact hεtr Q
  -- the inverse of the composite
  have hinv' : ε.toRationalMap.comp (e.trans ε).symm.toRationalMap = ψinv := by
    rw [comp_symm_trans_eq, he']
  have hinv'' : (e.trans ε).symm.toRationalMap = ε.symm.toRationalMap.comp ψinv := by
    have h3 : ε.symm.toRationalMap.comp ε.toRationalMap = Scheme.RationalMap.id S'.Y :=
      MMP.Fourfold.Crepant.comp_eq_id_of_isInverse
        (MMP.Mori.RationalMap.isInverse_toRationalMap ε).symm
    calc (e.trans ε).symm.toRationalMap
        = (Scheme.RationalMap.id S'.Y).comp (e.trans ε).symm.toRationalMap :=
          (Scheme.RationalMap.id_comp _).symm
      _ = (ε.symm.toRationalMap.comp ε.toRationalMap).comp (e.trans ε).symm.toRationalMap :=
          MMP.Fourfold.Crepant.comp_eq_comp_of_eq h3.symm _
      _ = ε.symm.toRationalMap.comp (ε.toRationalMap.comp (e.trans ε).symm.toRationalMap) :=
          Scheme.RationalMap.comp_assoc _ _ _
      _ = ε.symm.toRationalMap.comp ψinv := by rw [hinv']
  -- the step map over the base
  have hεk : ε.toRationalMap.compHom S'.sY = S.sY.toRationalMap := by
    refine partialIso_toRationalMap_isOver ε ?_
    have H := (roofIso_isOver hbf hbfp) =≫ D.sW
    show ε.iso.hom ≫ ε.target.ι ≫ S'.sY = ε.source.ι ≫ S.sY
    simpa only [Category.assoc, hfp.comp_eq, hfc.comp_eq] using H
  have hεinvk : ε.symm.toRationalMap.compHom S.sY = S'.sY.toRationalMap := by
    refine partialIso_toRationalMap_isOver ε.symm ?_
    have H := (roofIso_isOver hbf hbfp).symm =≫ D.sW
    show ε.symm.iso.hom ≫ ε.symm.target.ι ≫ S.sY = ε.symm.source.ι ≫ S'.sY
    simpa only [Category.assoc, hfp.comp_eq, hfc.comp_eq] using H
  refine ⟨(e.trans ε).toRationalMap, (e.trans ε).symm.toRationalMap,
    MMP.Mori.RationalMap.isInverse_toRationalMap (e.trans ε), ?_, ?_, ?_, ?_, ?_⟩
  · -- over the base point
    show ((e.trans ε).toRationalMap).compHom S'.sY = sW₀.toRationalMap
    have hψk' : ψ.compHom S.sY = sW₀.toRationalMap := hψk
    rw [htrans, ← Scheme.RationalMap.comp_toRationalMap, Scheme.RationalMap.comp_assoc,
      Scheme.RationalMap.comp_toRationalMap, hεk, Scheme.RationalMap.comp_toRationalMap]
    exact hψk'
  · show ((e.trans ε).symm.toRationalMap).compHom sW₀ = S'.sY.toRationalMap
    have hψinvk' : ψinv.compHom sW₀ = S.sY.toRationalMap := hψinvk
    haveI : ψinv.IsDominant := he' ▸ inferInstance
    rw [hinv'', ← Scheme.RationalMap.comp_toRationalMap, Scheme.RationalMap.comp_assoc,
      Scheme.RationalMap.comp_toRationalMap, hψinvk', Scheme.RationalMap.comp_toRationalMap]
    exact hεinvk
  · rw [hbind, hψS]
    exact hEE'
  · intro F' hF' q' hq' hF'q
    obtain ⟨G, hG, hεG⟩ := hSε F'
    have hGexc : MMP.Flips.RationalMap.IsInverseExceptional ψ G := by
      intro P hP
      have hεG' : MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp G = some F' := by
        rw [← hεtr]
        exact MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq ε.toPartialMap rfl hG
          hεG.symm
      exact hF' P (by rw [hbind, hP]; exact hεG')
    obtain ⟨hxc, hval⟩ := comp_hom_apply ε.toPartialMap q' hG (by rw [hεG]; exact hF'q)
    have hq : (ε.toPartialMap.comp q').toRationalMap = ψinv := by
      rw [← Scheme.RationalMap.toRationalMap_comp, hq', hinv']
    have := hord G hGexc (ε.toPartialMap.comp q') hq hxc
    rw [hval] at this
    convert this using 2
    exact congrArg (fun y => q'.hom y) (Subtype.ext hεG.symm)
  · -- the reference ample divisor stays below the modified boundary
    have hdivψ : MMP.Mori.RationalMap.transformDivisor (e.trans ε).toRationalMap A' =
        flipTransform D.f D.fp (MMP.Mori.RationalMap.transformDivisor ψ A') := by
      change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ A' =
        MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
            (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ A'))
      rw [MMP.Fourfold.mapPrimeDivisors_mapPrimeDivisors,
        MMP.Fourfold.mapPrimeDivisors_mapPrimeDivisors]
      have hfun : MMP.Mori.RationalMap.transformPrimeDivisor (e.trans ε).toRationalMap =
          fun G => (MMP.Mori.RationalMap.transformPrimeDivisor ψ G).bind fun G =>
            (MMP.Mori.RationalMap.transformPrimeDivisor (Scheme.Hom.toRationalMap D.f) G).bind
              (MMP.Mori.inverseTransformPrimeDivisor D.fp) :=
        funext fun P => by rw [hbind P]; rfl
      rw [hfun]
    have hsingle : flipTransform D.f D.fp (Finsupp.single E (1 : ℝ)) = Finsupp.single E' 1 := by
      change MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
        (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (Finsupp.single E (1 : ℝ))) = _
      rw [MMP.Fourfold.mapPrimeDivisors_mapPrimeDivisors]
      exact MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single_of_eq_some hEE' 1
    have hmono : ∀ D₁ D₂ : RDivisor S.Y, D₁ ≤ D₂ →
        flipTransform D.f D.fp D₁ ≤ flipTransform D.f D.fp D₂ := fun D₁ D₂ h => by
      have h0 : 0 ≤ flipTransform D.f D.fp (D₂ - D₁) := by
        change 0 ≤ MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ (D₂ - D₁))
        exact MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_nonneg _
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_nonneg _ (sub_nonneg.mpr h))
      rw [map_sub] at h0
      exact sub_nonneg.mp h0
    rw [hdivψ]
    have h1 := hmono _ _ hAB
    rw [map_sub, htr, hsingle] at h1
    have h2 : QDivisor.toRDivisor (flipTransform D.f D.fp
        (MMP.Mori.RationalMap.transformDivisor ψ A')) = flipTransform D.f D.fp
          (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ A')) := by
      change QDivisor.toRDivisor (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ _)) =
        MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _
          (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors _ _)
      rw [mapPrimeDivisors_qtoRDivisor, mapPrimeDivisors_qtoRDivisor]
    rw [h2]
    exact h1

end Reference

/-! ### Floor chains along the program -/

section Chains

variable {Z : Scheme.{0}}

/-- A `ℚ`-divisor with a Cartier multiple ample over the base point is ample. -/
private theorem isAmple_of_hasRelativelyAmpleMultiple {W : Scheme.{0}} [CompactSpace W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)} [QuasiCompact sW]
    {A : QDivisor W} (h : A.HasRelativelyAmpleMultiple sW) : A.IsAmple := by
  obtain ⟨m, hm, L, hL, hLA, hamp⟩ := h
  refine ⟨m, hm, L, ?_, hL, ?_⟩
  · rw [hLA, ← Int.cast_smul_eq_zsmul ℚ, Int.cast_natCast]
  · haveI := hL.isInvertibleModule_divisorialSheaf
    exact (Stacks.RelativeAmpleAffineBase.isRelativelyAmple_iff_isAmple sW _).mp
      (MMP.Mori.IsRelativelyAmple.to_stacks hamp)

/-- A floor chain at the prime `F` of a stage: a plt reference `(W₀, E_W, A')`, a principal
modification `B + c · div(u)` of the boundary and reference maps `ψ`, `ψ⁻¹`. -/
private def Stage.HasChain (S : Stage Z) (F : MMP.Mori.PrimeDivisor S.Y) : Prop :=
  ∃ (W₀ : Scheme.{0}) (_ : IsIntegral W₀) (_ : CompactSpace W₀) (_ : IsLocallyNoetherian W₀)
    (_ : IsNormal W₀) (sW₀ : W₀ ⟶ Spec (.of ℂ)) (EW : MMP.Mori.PrimeDivisor W₀)
    (_ : IsNormal EW.idealSheaf.subscheme) (A' : QDivisor W₀) (c : ℝ)
    (u : (RationalFunctions S.Y)ˣ) (ψ : W₀.RationalMap S.Y) (ψinv : S.Y.RationalMap W₀),
    IsNormalVariety ℂ sW₀ ∧ MMP.Mori.IsProjectiveVariety ℂ sW₀ ∧ 0 ≤ A' ∧ A'.IsAmple ∧
      A'.coeff EW = 0 ∧ S.IsChainBoundary F c u ∧ S.IsReferenceChain sW₀ EW A' F c u ψ ψinv

/-- Every component of the floor after a step is the strict transform of a component of the
floor before it. -/
private theorem StepExtra.exists_floor {S S' : Stage Z} {D : StepData S S'}
    (h : StepExtra S S' D) (E' : MMP.Mori.PrimeDivisor S'.Y) (hE' : E' ∈ S'.floor) :
    ∃ E ∈ S.floor, MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp E = some E' := by
  classical
  obtain ⟨-, -, -, hWn, hfc, hbf, hfp, -, hBt, -, -, -⟩ := h
  haveI := hfc.isProper
  obtain ⟨-, -, hsurj, -, hcoeff⟩ := roofTransformPrimeDivisor_spec hWn hbf hfp
  obtain ⟨E, hE⟩ := hsurj E'
  refine ⟨E, ?_, hE⟩
  have hBE' : S'.B.coeff E' = 1 := (Finset.mem_filter.mp hE').2
  have hBE : S.B.coeff E = 1 := by
    have := hcoeff S.B E E' hE
    rw [← hBt] at this
    change S'.B.coeff E' = S.B.coeff E at this
    rw [← this, hBE']
  rw [Stage.floor, Finset.mem_filter, Finsupp.mem_support_iff]
  exact ⟨by change S.B.coeff E ≠ 0; rw [hBE]; exact one_ne_zero, hBE⟩

/-- **Floor chains exist along the program**: if every floor component of the first stage
carries a floor chain, so does every floor component of every later stage. -/
private theorem Stage.hasChain_seq {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hα : 0 < α) (S₀ : Stage Z) (h₀ : S₀.Inv sZ α)
    (hall : ∀ i, ¬ (Stage.seq hZ hα S₀ i).IsNef) (hinit : ∀ F ∈ S₀.floor, S₀.HasChain F) :
    ∀ i, ∀ F ∈ (Stage.seq hZ hα S₀ i).floor, (Stage.seq hZ hα S₀ i).HasChain F := by
  intro i
  induction i with
  | zero => exact hinit
  | succ i ih =>
    intro F' hF'
    have hinv := Stage.seq_inv hZ hα S₀ h₀ i
    obtain ⟨-, hext, hinv'⟩ := Stage.next_spec hZ hα _ hinv (hall i)
    obtain ⟨F, hF, hFF'⟩ := hext.exists_floor F' hF'
    obtain ⟨W₀, _, _, _, _, sW₀, EW, _, A', c, u, ψ, ψinv, hW₀n, hW₀p, hA0, hAamp, hAS, hch,
      href⟩ := ih F hF
    obtain ⟨u', hch', htr, -⟩ := hch.next hinv hinv' hext hFF'
    obtain ⟨ψ', ψinv', href'⟩ := href.next hW₀n hA0 hinv hinv' hext hFF' htr
    exact ⟨W₀, inferInstance, inferInstance, inferInstance, inferInstance, sW₀, EW, inferInstance,
      A', c, u', ψ', ψinv', hW₀n, hW₀p, hA0, hAamp, hAS, hch', href'⟩

end Chains

section ChainPlt

variable {Z : Scheme.{0}}

/-- The levels `B' + λ C`, `0 ≤ λ ≤ μ`, of a floor chain are plt. -/
private theorem Stage.IsChainBoundary.isPlt {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ} {S : Stage Z}
    (hS : S.Inv sZ α) {E : MMP.Mori.PrimeDivisor S.Y} {c : ℝ} {u : (RationalFunctions S.Y)ˣ}
    (hch : S.IsChainBoundary E c u) {l : ℝ} (hl0 : 0 ≤ l) (hlμ : l ≤ S.μ) :
    (∀ P, 0 ≤ (S.B + c • Divisor.toRDivisor (principalDivisor u) + l • S.C).coeff P ∧
      (S.B + c • Divisor.toRDivisor (principalDivisor u) + l • S.C).coeff P ≤ 1) ∧
    RDivisor.IsRCartier (Divisor.toRDivisor S.K +
      (S.B + c • Divisor.toRDivisor (principalDivisor u) + l • S.C)) ∧
    ∀ (n : ℕ) (D : MMP.Mori.DivisorOver ℂ S.sY) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy S.sY n
        (S.B + c • Divisor.toRDivisor (principalDivisor u) + l • S.C) D a → 0 < a := by
  obtain ⟨-, hQ, -, -, -, -, hC0, -, -, -, -⟩ := hS
  obtain ⟨hB'0, hle1, hpos, -, -, -⟩ := hch
  refine ⟨fun P => ⟨?_, ?_⟩, hQ.isRCartier _, ?_⟩
  · rw [DivisorWithCoeffs.coeff_add, coeff_smul_real]
    exact add_nonneg (hB'0 P) (mul_nonneg hl0 (hC0 P))
  · have h1 := hle1 P
    rw [DivisorWithCoeffs.coeff_add, coeff_smul_real] at h1 ⊢
    nlinarith [hC0 P]
  · refine pos_of_add (E := (S.μ - l) • S.C) (hQ.isRCartier _)
      (Finsupp.le_def.mpr fun P => ?_) ?_
    · have h0 := hC0 P
      rw [DivisorWithCoeffs.coeff_apply] at h0
      simp only [Finsupp.coe_zero, Pi.zero_apply, Finsupp.smul_apply, smul_eq_mul]
      exact mul_nonneg (by linarith) h0
    · have : S.B + c • Divisor.toRDivisor (principalDivisor u) + l • S.C + (S.μ - l) • S.C =
          S.B + c • Divisor.toRDivisor (principalDivisor u) + S.μ • S.C := by
        rw [add_assoc, ← add_smul]; congr 2; ring
      rw [this]; exact hpos

/-- The log canonical divisor of a principal modification of the boundary. -/
private theorem logCanonicalDivisor_add_principal {Y : Scheme.{0}} (K : Divisor Y)
    (B C P : RDivisor Y) (c l : ℝ) :
    logCanonicalDivisor K (B + c • P + l • C) = logCanonicalDivisor K (B + l • C) + c • P := by
  unfold logCanonicalDivisor; abel

end ChainPlt

open Classical in
/-- **Floor chains at the log minimal model.** Every component of the floor of `B_Y` carries a
floor chain: the plt reference of `exists_pltReference_of_isNefLogBirationalModel` for it. -/
private theorem initStage_hasChain {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z} {K : Divisor X} {B C : RDivisor X}
    {A : QDivisor X} {α t : ℝ} {KY : Divisor Y} {BY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXs : MMP.Mori.IsSmoothScheme sX)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, B.coeff P = 1 → C.coeff P = 0)
    (hA : ∀ P, 0 ≤ A.coeff P) (hAB : ∀ P, (A.coeff P : ℝ) ≤ B.coeff P)
    (hAmple : IsRelativelyAmple sX (QDivisor.toRDivisor A))
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P ≠ 1)
    (ht₀ : 0 < t) (ht₁ : t < 1)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y,
      BY.coeff F = (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY K (B + t • C) KY
      (BY + t • RationalMap.transformDivisor φ C) φ)
    (h₀ : (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t).Inv sZ α) :
    ∀ F ∈ (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t).floor,
      (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t).HasChain F := by
  classical
  intro (F : MMP.Mori.PrimeDivisor Y) hF
  have hFB : BY.coeff F = 1 := (Finset.mem_filter.mp hF).2
  have hXn : IsNormalVariety ℂ sX := hlc.1
  have hQX : IsQFactorial sX := isQFactorial_of_isSmoothScheme hXn hXs
  have hB1 : ∀ P, B.coeff P ≤ 1 := fun P => by
    have h1 := coeff_le_one_of_isRealLcPair hlc P
    rw [DivisorWithCoeffs.coeff_add] at h1
    linarith [hC P]
  have hCB' : ∀ P, C.coeff P ≠ 0 → B.coeff P < 1 := fun P hP =>
    lt_of_le_of_ne (hB1 P) fun h => hP (hCB P h)
  have hA₀ : 0 ≤ A := Finsupp.le_def.mpr fun P => hA P
  have hAB' : A.toRDivisor ≤ B := Finsupp.le_def.mpr fun P => by
    show (QDivisor.toRDivisor A).coeff P ≤ B.coeff P
    rw [QDivisor.coeff_toRDivisor]
    exact hAB P
  have hAfl : ∀ P, A.coeff P ≠ 0 → B.coeff P < 1 := fun P hP => by
    have h1 := hAfloor P hP
    have h2 := coeff_le_one_of_isRealLcPair hlc P
    rw [DivisorWithCoeffs.coeff_add] at h1 h2
    have h3 := hC P
    have h4 : B.coeff P + C.coeff P < 1 := lt_of_le_of_ne h2 h1
    linarith
  have hzero : ∀ G : MMP.Mori.PrimeDivisor Y, MMP.Flips.RationalMap.IsInverseExceptional φ G →
      ∀ (D : MMP.Flips.ProperDivisorOver ℂ sX), MMP.Flips.IsRealizedOver sX φ G D →
        ∀ (n : ℕ) (a : ℝ), MMP.Intersection.IsLogDiscrepancy sX n B D.toDivisorOver a → a = 0 :=
    fun G hG D hD n a ha => isLogDiscrepancy_eq_zero_of_isRealLogMinimalModel hlc
      (hQX.isRCartier C) (Finsupp.le_def.mpr hC) ht₁ hY G hG D hD n a ha
  have hdlt : IsRealDltPair sX (B + C) := isRealDltPair_of_isSmoothScheme hXs hlc hsnc
  have hAm : A.HasRelativelyAmpleMultiple sX := by
    haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
    exact MMP.IndexTailFromSequence.hasRelativelyAmpleMultiple_of_isRelativelyAmple hXn
      MMP.Chow.DeterminantCurveForm.isNormalVariety_id_spec (Category.comp_id sX)
      (MMP.Fourfold.isQCartier_of_isQFactorial sX hQX A) hAmple
  obtain ⟨W, _, _, _, _, sW, _, p, hp, ψ, EW, B'W, A', BY', hWp, hWs, hpX, hψff, -, hψS, -, -, -,
    hA'amp, hA'0, -, hA'E, ⟨m, u, hm, hmu⟩, ⟨hBY'lc, -⟩, hBY'E, hBY'lt, hψA, ⟨hlcup, hposup⟩, -,
    hEWn, hord⟩ :=
    MMP.Fourfold.exists_pltReference_of_isNefLogBirationalModel hX hXs hdlt hsnc hB hC hCB'
      hAm
      hA₀ hAB' hAfl ht₀ ht₁ hBY hY.toIsNefLogBirationalModel hzero F hFB
  haveI : QuasiCompact sW := hWp.toIsVariety.toQuasiCompact
  have hWn : IsNormalVariety ℂ sW := ⟨hWp.toIsVariety, inferInstance⟩
  -- the inverse and the order-zero data of the reference map
  have hpend : ∃ ψinv : Y.RationalMap W, MMP.Mori.RationalMap.IsInverse ψ ψinv ∧
      MMP.Flips.RationalMap.IsOver sW sY ψ ∧ MMP.Flips.RationalMap.IsOver sY sW ψinv ∧
      (MMP.Mori.RationalMap.transformDivisor ψ (QDivisor.toRDivisor A')).coeff F = 0 := by
    haveI : IsDominant p := hp.isDominant
    haveI : IsSeparated (X ↘ ⊤_ Scheme) := isSeparated_toTerminal_of_isNormalVariety hXn
    haveI : IsSeparated (Y ↘ ⊤_ Scheme) :=
      isSeparated_toTerminal_of_isNormalVariety hY.isNormalVariety_model
    haveI : IsSeparated (W ↘ ⊤_ Scheme) := isSeparated_toTerminal_of_isNormalVariety hWn
    haveI : IsProper sW := isProper_of_isProjectiveMorphism sW hWp.isProjective
    obtain ⟨ψinv, hinv, hψk, hψinvk⟩ := exists_isInverse_of_fromFunctionField_eq hp hpX
      hY.isBirational
      (fromFunctionField_comp_eq_of_isNefLogBirationalModel
        hY.toIsNefLogBirationalModel) hψff
    refine ⟨ψinv, hinv, hψk, hψinvk, ?_⟩
    rw [DivisorWithCoeffs.coeff_apply]
    show MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors
      (MMP.Mori.RationalMap.transformPrimeDivisor ψ) (QDivisor.toRDivisor A') F = 0
    rw [mapPrimeDivisors_apply_eq_sum]
    refine Finset.sum_eq_zero fun P _ => ?_
    split_ifs with hPF
    · have hPE := eq_of_transformPrimeDivisor_eq_some hinv hψinvk hPF hψS
      subst hPE
      show ((A'.coeff _ : ℚ) : ℝ) = 0
      rw [hA'E, Rat.cast_zero]
    · rfl
  obtain ⟨ψinv, hinv, hψk, hψinvk, hψAF⟩ := hpend
  -- the principal modification
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hBY' : BY' = BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u) := by
    rw [← hmu, smul_smul, inv_mul_cancel₀ hm', one_smul]; abel
  refine ⟨W, inferInstance, inferInstance, inferInstance, inferInstance, sW, EW, hEWn, A',
    (m : ℝ)⁻¹, u, ψ, ψinv, hWn, hWp, hA'0, isAmple_of_hasRelativelyAmpleMultiple hA'amp, hA'E,
    ?_, ?_⟩
  · show (∀ P, 0 ≤ (BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u)).coeff P) ∧
      (∀ P, (BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u) +
        t • RationalMap.transformDivisor φ C).coeff P ≤ 1) ∧
      (∀ (n : ℕ) (D : MMP.Mori.DivisorOver ℂ sY) (a : ℝ), D.IsExceptional →
        MMP.Intersection.IsLogDiscrepancy sY n
          (BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u) +
            t • RationalMap.transformDivisor φ C) D a → 0 < a) ∧
      (BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u)).coeff F = 1 ∧
      (∀ P, P ≠ F → (BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u)).coeff P < 1) ∧
      (RationalMap.transformDivisor φ C).coeff F = 0
    rw [← hBY']
    refine ⟨hBY'lc.2.1, fun P => coeff_le_one_of_isRealLcPair hlcup P,
      fun n D a hD ha => hposup n D hD a ha, hBY'E, hBY'lt, ?_⟩
    have h1 : BY'.coeff F + t * (RationalMap.transformDivisor φ C).coeff F ≤ 1 :=
      coeff_le_one_of_isRealLcPair hlcup F
    rw [hBY'E] at h1
    have h2 : 0 ≤ (RationalMap.transformDivisor φ C).coeff F :=
      coeff_mapPrimeDivisors_nonneg hC F
    have h3 : t * (RationalMap.transformDivisor φ C).coeff F ≤ 0 := by linarith
    have h4 : (RationalMap.transformDivisor φ C).coeff F ≤ 0 := by
      by_contra h
      push Not at h
      linarith [mul_pos ht₀ h]
    linarith
  · refine ⟨hinv, hψk, hψinvk, hψS, fun G hG q hq hGq => ?_, ?_⟩
    · obtain ⟨e, he, he'⟩ := hinv
      exact hord G hG q ⟨e, he, he'.trans hq.symm⟩ hGq
    · show QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ A') ≤
        BY + (m : ℝ)⁻¹ • Divisor.toRDivisor (principalDivisor u) -
          (Finsupp.single F (1 : ℝ) : RDivisor Y)
      have hq : QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ A') =
          MMP.Mori.RationalMap.transformDivisor ψ (QDivisor.toRDivisor A') :=
        mapPrimeDivisors_qtoRDivisor _ _
      rw [← hBY', hq]
      refine Finsupp.le_def.mpr fun P => ?_
      have h1 := Finsupp.le_def.mp hψA P
      rw [Finsupp.sub_apply, Finsupp.single_apply]
      split_ifs with hP
      · subst hP
        have e1 := hψAF
        have e2 := hBY'E
        rw [DivisorWithCoeffs.coeff_apply] at e1 e2
        rw [e1, e2]
        norm_num
      · simpa using h1

/-! ### Termination -/

/-- The total coefficient of `B` of a stage. -/
private noncomputable def Stage.mass (S : Stage Z) : ℝ := S.B.sum fun _ c => c

private theorem sum_mapPrimeDivisors {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (D : RDivisor X) :
    (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D).sum (fun _ c => c) =
      D.sum (fun P c => if τ P = none then 0 else c) := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D₁ D₂ h₁ h₂ =>
    rw [map_add, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), h₁, h₂,
      Finsupp.sum_add_index' (fun _ => by simp) (fun P c₁ c₂ => by split_ifs <;> simp)]
  | single P r =>
    rw [MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_single, Finsupp.sum_single_index (by simp)]
    rcases h : τ P with _ | Q
    · simp
    · simp

private theorem sum_mapPrimeDivisors_le {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) {D : RDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) :
    (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D).sum (fun _ c => c) ≤
      D.sum (fun _ c => c) := by
  rw [sum_mapPrimeDivisors]
  unfold Finsupp.sum
  exact Finset.sum_le_sum fun P _ => by
    dsimp only
    split_ifs
    · exact hD P
    · exact le_rfl

private theorem sum_mapPrimeDivisors_le_sub_one {X Y : Scheme.{0}}
    (τ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) {D : RDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) {P : MMP.Mori.PrimeDivisor X} (hP : D.coeff P = 1)
    (hτ : τ P = none) :
    (MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors τ D).sum (fun _ c => c) ≤
      D.sum (fun _ c => c) - 1 := by
  classical
  rw [sum_mapPrimeDivisors]
  have hmem : P ∈ D.support := Finsupp.mem_support_iff.mpr (by
    change D.coeff P ≠ 0
    rw [hP]; exact one_ne_zero)
  unfold Finsupp.sum
  dsimp only
  rw [← Finset.add_sum_erase _ _ hmem, ← Finset.add_sum_erase _ (fun x => D x) hmem]
  have h1 : (if τ P = none then (0 : ℝ) else D P) = 0 := by rw [if_pos hτ]
  have h2 : D P = 1 := hP
  have h3 : ∑ x ∈ D.support.erase P, (if τ x = none then (0 : ℝ) else D x) ≤
      ∑ x ∈ D.support.erase P, D x := Finset.sum_le_sum fun x _ => by
    split_ifs
    · exact hD x
    · exact le_rfl
  linarith

private theorem mass_nonneg {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ} {S : Stage Z} (hS : S.Inv sZ α) :
    0 ≤ S.mass :=
  Finset.sum_nonneg fun P _ => hS.2.2.2.2.2.1 P

/-- A step does not increase the mass of `B`, and a divisorial step decreases it by one. -/
private theorem mass_le_of_step {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ} {S S' : Stage Z}
    {D : StepData S S'} (hS : S.Inv sZ α) (hE : StepExtra S S' D) :
    S'.mass ≤ S.mass ∧ (StepDiv S S' D → S'.mass ≤ S.mass - 1) := by
  have hB0 : ∀ P, 0 ≤ S.B.coeff P := hS.2.2.2.2.2.1
  rcases hE.2.2.1 with ⟨-, -, -, τ, hB, -, P, hP1, hPτ⟩ | ⟨-, -, hB, -, -, -⟩
  · have h := sum_mapPrimeDivisors_le_sub_one τ hB0 hP1 hPτ
    unfold Stage.mass
    rw [hB]
    exact ⟨by linarith, fun _ => h⟩
  · unfold Stage.mass
    rw [hB]
    refine ⟨?_, fun ⟨_, _, _, τ', hB', _, P', hP', hτ'⟩ => ?_⟩
    · exact (sum_mapPrimeDivisors_le _ (fun Q => coeff_mapPrimeDivisors_nonneg hB0 Q)).trans
        (sum_mapPrimeDivisors_le _ hB0)
    · rw [← hB, hB']
      exact sum_mapPrimeDivisors_le_sub_one τ' hB0 hP' hτ'

/-- The flip of a step meets the floor: some contracted curve lies in the negative floor
component and in the exceptional set. -/
private theorem exists_mem_exceptionalSet_inter_of_step {sZ : Z ⟶ Spec (.of ℂ)} {α : ℝ}
    {S S' : Stage Z} {D : StepData S S'} (hS : S.Inv sZ α) (hP : StepProps S S' D)
    (hE : StepExtra S S' D) :
    ∃ E ∈ S.floor, ∃ y ∈ (MMP.Mori.exceptionalSet D.f : Set S.Y), y ∈ E.support := by
  classical
  haveI : IsProper S.sY := isProper_of_isProjectiveMorphism S.sY hS.1.isProjective
  obtain ⟨E, hE1, hneg⟩ := hP.2.2.2.2.2.2.2.2.2.2
  obtain ⟨Γ, hΓ⟩ :=
    exists_isContractedBy_of_relativePicardNumber_eq_one hP.2.2.1.relativePicardNumber_eq_one
  obtain ⟨y, hy, hyE⟩ := exists_mem_closure_exceptionalSet D.f Γ hΓ
  refine ⟨E, ?_, y, hyE, closure_subset_support_of_neg hS.2.1 E Γ (hneg Γ hΓ) hy⟩
  rw [Stage.floor, Finset.mem_filter, Finsupp.mem_support_iff]
  refine ⟨?_, hE1⟩
  change S.B.coeff E ≠ 0
  rw [hE1]; exact one_ne_zero

/-- The flips of the tail are small on both sides, over normal targets. -/
private theorem StepFlip.isSmall {S S' : Stage Z} {D : StepData S S'} (h : StepFlip S S' D) :
    IsNormalVariety ℂ D.sW ∧ IsSmall ℂ D.sW S.sY D.f ∧ IsSmall ℂ D.sW S'.sY D.fp :=
  ⟨h.1.isNegativeExtremalContraction.isNormalVariety_target, h.1.isSmall, h.1.isSmall_flip⟩

/-- Along a flip every prime divisor has a strict transform. -/
private theorem StepFlip.exists_transform {S S' : Stage Z} {D : StepData S S'}
    (h : StepFlip S S' D) (P : MMP.Mori.PrimeDivisor S.Y) :
    ∃ E : MMP.Mori.PrimeDivisor S'.Y, MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp P = some E :=
  (flipTransformPrimeDivisor_spec h.isSmall.1 h.isSmall.2.1 h.isSmall.2.2).1 P

/-- Along a flip every component of the new floor is the transform of a component of the old
one. -/
private theorem StepFlip.exists_floor {S S' : Stage Z} {D : StepData S S'} (h : StepFlip S S' D)
    (E : MMP.Mori.PrimeDivisor S'.Y) (hE : E ∈ S'.floor) :
    ∃ P ∈ S.floor, MMP.Fourfold.flipTransformPrimeDivisor D.f D.fp P = some E := by
  classical
  obtain ⟨-, -, hsurj, -, hcoeff⟩ :=
    flipTransformPrimeDivisor_spec h.isSmall.1 h.isSmall.2.1 h.isSmall.2.2
  obtain ⟨P, hP⟩ := hsurj E
  refine ⟨P, ?_, hP⟩
  have hBE : S'.B.coeff E = 1 := (Finset.mem_filter.mp hE).2
  have hBP : S.B.coeff P = 1 := by
    have := hcoeff S.B P E hP
    rw [← h.2.2.1] at this
    change S'.B.coeff E = S.B.coeff P at this
    rw [← this, hBE]
  rw [Stage.floor, Finset.mem_filter, Finsupp.mem_support_iff]
  exact ⟨by change S.B.coeff P ≠ 0; rw [hBP]; exact one_ne_zero, hBP⟩

open Classical in
/-- **Special termination along the tail of flips, for one floor component.** -/
private theorem eventually_disjoint_of_flips_of_mem_floor
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {K : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXs : MMP.Mori.IsSmoothScheme sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    (hdim : topologicalKrullDim X = 4) (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, B.coeff P = 1 → C.coeff P = 0)
    (hA : ∀ P, 0 ≤ A.coeff P) (hAB : ∀ P, (A.coeff P : ℝ) ≤ B.coeff P)
    (hAmple : IsRelativelyAmple sX (QDivisor.toRDivisor A))
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P ≠ 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → B.coeff P = 1)
    (hnum : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor K B) (C + N))
    (ht₀ : 0 < t) (ht₁ : t < 1)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y,
      BY.coeff F = (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY K (B + t • C) KY
      (BY + t • RationalMap.transformDivisor φ C) φ)
    (h₀ : (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t).Inv sZ α)
    (hall : ∀ i, ¬ (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t)
      i).IsNef)
    (i₀ : ℕ)
    (hflip : ∀ i, i₀ ≤ i →
      StepFlip (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i)
        (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) (i + 1))
        ((Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i).next
          hZ hα).2)
    (T : ∀ j, MMP.Mori.PrimeDivisor (Stage.seq hZ hα
      (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) (i₀ + j)).Y)
    (hT0 : T 0 ∈ (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t)
      i₀).floor)
    (hT : ∀ j, MMP.Fourfold.flipTransformPrimeDivisor
      ((Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t)
        (i₀ + j)).next hZ hα).2.f
      ((Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t)
        (i₀ + j)).next hZ hα).2.fp (T j) = some (T (j + 1))) :
    ∃ n₀ : ℕ, ∀ j, n₀ ≤ j → Disjoint (MMP.Mori.exceptionalSet ((Stage.seq hZ hα
        (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) (i₀ + j)).next hZ hα).2.f :
          Set _) (T j).support := by
  classical
  let S₀ := initStage sY πY KY BY (RationalMap.transformDivisor φ C) t
  let seq := Stage.seq hZ hα S₀
  have hinv : ∀ i, (seq i).Inv sZ α := Stage.seq_inv hZ hα S₀ h₀
  have hspec : ∀ i, StepProps (seq i) (seq (i + 1)) ((seq i).next hZ hα).2 ∧
      StepExtra (seq i) (seq (i + 1)) ((seq i).next hZ hα).2 ∧ (seq (i + 1)).Inv sZ α :=
    fun i => Stage.next_spec hZ hα (seq i) (hinv i) (hall i)
  have hinit := initStage_hasChain (α := α) (sZ := sZ) hX hXs hB hC hlc hsnc hCB hA hAB hAmple
    hAfloor ht₀ ht₁ hBY hY h₀
  obtain ⟨W₀, _, _, _, _, sW₀, EW, _, A', c, u₀, ψ₀, ψinv₀, hW₀n, hW₀p, hA0, hAamp, hAS, hch₀,
    href₀⟩ := Stage.hasChain_seq hZ hα S₀ h₀ hall hinit i₀ (T 0) hT0
  -- one step of the chain along the tail
  have hnext : ∀ (j : ℕ) (u : (RationalFunctions (seq (i₀ + j)).Y)ˣ)
      (ψ : W₀.RationalMap (seq (i₀ + j)).Y) (ψinv : (seq (i₀ + j)).Y.RationalMap W₀),
      (seq (i₀ + j)).IsChainBoundary (T j) c u →
      (seq (i₀ + j)).IsReferenceChain sW₀ EW A' (T j) c u ψ ψinv →
      ∃ (u' : (RationalFunctions (seq (i₀ + (j + 1))).Y)ˣ)
        (ψ' : W₀.RationalMap (seq (i₀ + (j + 1))).Y)
        (ψinv' : (seq (i₀ + (j + 1))).Y.RationalMap W₀),
        (seq (i₀ + (j + 1))).IsChainBoundary (T (j + 1)) c u' ∧
        (seq (i₀ + (j + 1))).IsReferenceChain sW₀ EW A' (T (j + 1)) c u' ψ' ψinv' ∧
        flipTransform ((seq (i₀ + j)).next hZ hα).2.f ((seq (i₀ + j)).next hZ hα).2.fp
          ((seq (i₀ + j)).B + c • Divisor.toRDivisor (principalDivisor u)) =
          (seq (i₀ + (j + 1))).B + c • Divisor.toRDivisor (principalDivisor u') ∧
        ∃ M' : RDivisor ((seq (i₀ + j)).next hZ hα).2.W,
          IsRCartierPullback ((seq (i₀ + j)).next hZ hα).2.f M'
            (logCanonicalDivisor (seq (i₀ + j)).K
              ((seq (i₀ + j)).B + c • Divisor.toRDivisor (principalDivisor u) +
                ((seq (i₀ + j)).next hZ hα).2.thr • (seq (i₀ + j)).C)) ∧
          IsRCartierPullback ((seq (i₀ + j)).next hZ hα).2.fp M'
            (logCanonicalDivisor (seq (i₀ + (j + 1))).K
              ((seq (i₀ + (j + 1))).B + c • Divisor.toRDivisor (principalDivisor u') +
                ((seq (i₀ + j)).next hZ hα).2.thr • (seq (i₀ + (j + 1))).C)) := by
    intro j u ψ ψinv hch href
    obtain ⟨u', hch', htr, hcrep⟩ := hch.next (hinv _) (hspec _).2.2 (hspec _).2.1 (hT j)
    obtain ⟨ψ', ψinv', href'⟩ :=
      href.next hW₀n hA0 (hinv _) (hspec _).2.2 (hspec _).2.1 (hT j) htr
    exact ⟨u', ψ', ψinv', hch', href', htr, hcrep⟩
  choose U Ψ Ψinv hU using hnext
  -- the chain along the tail
  let st : ∀ j : ℕ, {x : (RationalFunctions (seq (i₀ + j)).Y)ˣ ×
      W₀.RationalMap (seq (i₀ + j)).Y × (seq (i₀ + j)).Y.RationalMap W₀ //
        (seq (i₀ + j)).IsChainBoundary (T j) c x.1 ∧
        (seq (i₀ + j)).IsReferenceChain sW₀ EW A' (T j) c x.1 x.2.1 x.2.2} := fun j =>
    Nat.rec (motive := fun j => {x : (RationalFunctions (seq (i₀ + j)).Y)ˣ ×
        W₀.RationalMap (seq (i₀ + j)).Y × (seq (i₀ + j)).Y.RationalMap W₀ //
          (seq (i₀ + j)).IsChainBoundary (T j) c x.1 ∧
          (seq (i₀ + j)).IsReferenceChain sW₀ EW A' (T j) c x.1 x.2.1 x.2.2})
      ⟨(u₀, ψ₀, ψinv₀), hch₀, href₀⟩
      (fun j s => ⟨(U j s.1.1 s.1.2.1 s.1.2.2 s.2.1 s.2.2, Ψ j s.1.1 s.1.2.1 s.1.2.2 s.2.1 s.2.2,
          Ψinv j s.1.1 s.1.2.1 s.1.2.2 s.2.1 s.2.2),
        (hU j s.1.1 s.1.2.1 s.1.2.2 s.2.1 s.2.2).1, (hU j s.1.1 s.1.2.1 s.1.2.2 s.2.1 s.2.2).2.1⟩) j
  have hstep : ∀ j, flipTransform ((seq (i₀ + j)).next hZ hα).2.f ((seq (i₀ + j)).next hZ hα).2.fp
        ((seq (i₀ + j)).B + c • Divisor.toRDivisor (principalDivisor (st j).1.1)) =
        (seq (i₀ + (j + 1))).B + c • Divisor.toRDivisor (principalDivisor (st (j + 1)).1.1) ∧
      ∃ M' : RDivisor ((seq (i₀ + j)).next hZ hα).2.W,
        IsRCartierPullback ((seq (i₀ + j)).next hZ hα).2.f M'
          (logCanonicalDivisor (seq (i₀ + j)).K
            ((seq (i₀ + j)).B + c • Divisor.toRDivisor (principalDivisor (st j).1.1) +
              ((seq (i₀ + j)).next hZ hα).2.thr • (seq (i₀ + j)).C)) ∧
        IsRCartierPullback ((seq (i₀ + j)).next hZ hα).2.fp M'
          (logCanonicalDivisor (seq (i₀ + (j + 1))).K
            ((seq (i₀ + (j + 1))).B + c • Divisor.toRDivisor (principalDivisor (st (j + 1)).1.1) +
              ((seq (i₀ + j)).next hZ hα).2.thr • (seq (i₀ + (j + 1))).C)) := fun j =>
    (hU j (st j).1.1 (st j).1.2.1 (st j).1.2.2 (st j).2.1 (st j).2.2).2.2
  have hflip' : ∀ j, StepFlip (seq (i₀ + j)) (seq (i₀ + (j + 1))) ((seq (i₀ + j)).next hZ hα).2 :=
    fun j => hflip (i₀ + j) (Nat.le_add_right _ _)
  have hthr : ∀ j, 0 < ((seq (i₀ + j)).next hZ hα).2.thr := fun j => by
    rw [← (hspec (i₀ + j)).2.1.2.1]; exact (hspec (i₀ + j)).2.2.2.2.2.2.2.2.2.1
  obtain ⟨N₀, hN₀⟩ := MMP.Fourfold.eventually_disjoint_exceptionalSet_of_realPltFlip_scaling
    (fun j => (seq (i₀ + j)).Y) (fun j => (seq (i₀ + j)).sY) (fun j => (seq (i₀ + j)).K)
    (fun j => (seq (i₀ + j)).B + c • Divisor.toRDivisor (principalDivisor (st j).1.1))
    (fun j => (seq (i₀ + j)).C)
    (fun j => ((seq (i₀ + j)).next hZ hα).2.W) (fun j => ((seq (i₀ + j)).next hZ hα).2.sW)
    (fun j => ((seq (i₀ + j)).next hZ hα).2.f) (fun j => ((seq (i₀ + j)).next hZ hα).2.fp)
    Z sZ hZ (fun j => (seq (i₀ + j)).πY) (fun j => ((seq (i₀ + j)).next hZ hα).2.g)
    (fun j => (hinv (i₀ + j)).2.2.2.1) (fun j => (hspec (i₀ + j)).1.2.2.2.1)
    (fun j => (hspec (i₀ + j)).1.2.2.2.2.1)
    (fun j => ⟨4, (hinv (i₀ + j)).2.2.1⟩) (fun j => (hinv (i₀ + j)).1)
    (fun j => (hinv (i₀ + j)).2.1)
    (fun j => by rw [(hinv (i₀ + j)).2.2.1.topologicalKrullDim_eq]; rfl)
    (fun j => IsRealFlipStep.add_principal (hflip' j).1 c (st j).1.1 (st (j + 1)).1.1 (hstep j).1)
    (fun j => by
      have h := (st j).2.1.isPlt (hinv (i₀ + j)) le_rfl (hinv (i₀ + j)).2.2.2.2.2.2.2.1.le
      rw [zero_smul, add_zero] at h
      exact h)
    (fun j => Finsupp.le_def.mpr fun P => (hinv (i₀ + j)).2.2.2.2.2.2.1 P)
    (fun j => (hflip' j).2.2.2.1)
    (fun j => ((seq (i₀ + j)).next hZ hα).2.thr) hthr
    (antitone_nat_of_succ_le fun j => by
      have h1 := (hspec (i₀ + (j + 1))).2.1.1
      have h2 := (hspec (i₀ + j)).2.1.2.1
      exact h1.trans h2.le)
    (fun j => by
      rw [logCanonicalDivisor_add_principal]
      exact isRelativelyNef_add_principal (hspec (i₀ + j)).1.1 c _)
    (fun j => (st j).2.1.isPlt (hinv (i₀ + j)) (hthr j).le (hspec (i₀ + j)).2.1.1)
    (fun j => (hstep j).2)
    T (fun j => (st j).2.1.2.2.2.1) (fun j => (st j).2.1.2.2.2.2.2) hT
    W₀ sW₀ hW₀n hW₀p EW A' hA0 hAamp hAS (fun j => (st j).1.2.1) (fun j => (st j).1.2.2)
    (fun j => (st j).2.2.1) (fun j => (st j).2.2.2.1) (fun j => (st j).2.2.2.2.1)
    (fun j => (st j).2.2.2.2.2.1) (fun j => (st j).2.2.2.2.2.2.1)
    (fun j => (st j).2.2.2.2.2.2.2)
  exact ⟨N₀, fun j hj => (hN₀ j hj).1⟩

open Classical in
/-- **Special termination along the tail of flips.** -/
private theorem eventually_disjoint_of_flips
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {K : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXs : MMP.Mori.IsSmoothScheme sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    (hdim : topologicalKrullDim X = 4) (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, B.coeff P = 1 → C.coeff P = 0)
    (hA : ∀ P, 0 ≤ A.coeff P) (hAB : ∀ P, (A.coeff P : ℝ) ≤ B.coeff P)
    (hAmple : IsRelativelyAmple sX (QDivisor.toRDivisor A))
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P ≠ 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → B.coeff P = 1)
    (hnum : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor K B) (C + N))
    (ht₀ : 0 < t) (ht₁ : t < 1)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y,
      BY.coeff F = (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY K (B + t • C) KY
      (BY + t • RationalMap.transformDivisor φ C) φ)
    (h₀ : (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t).Inv sZ α)
    (hall : ∀ i, ¬ (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t)
      i).IsNef)
    (i₀ : ℕ)
    (hflip : ∀ i, i₀ ≤ i →
      StepFlip (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i)
        (Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) (i + 1))
        ((Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i).next
          hZ hα).2) :
    ∃ i₁, i₀ ≤ i₁ ∧ ∀ i, i₁ ≤ i → ∀ E ∈ (Stage.seq hZ hα
        (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i).floor,
      Disjoint (MMP.Mori.exceptionalSet ((Stage.seq hZ hα
          (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) i).next hZ hα).2.f :
            Set _) E.support := by
  classical
  set seq := Stage.seq hZ hα (initStage sY πY KY BY (RationalMap.transformDivisor φ C) t) with hseq
  -- the chain of transforms of a prime divisor of the tail start
  have hchain : ∀ F : MMP.Mori.PrimeDivisor (seq i₀).Y,
      ∃ T : ∀ j, MMP.Mori.PrimeDivisor (seq (i₀ + j)).Y, T 0 = F ∧
        ∀ j, MMP.Fourfold.flipTransformPrimeDivisor ((seq (i₀ + j)).next hZ hα).2.f
          ((seq (i₀ + j)).next hZ hα).2.fp (T j) = some (T (j + 1)) := by
    intro F
    let T : ∀ j, MMP.Mori.PrimeDivisor (seq (i₀ + j)).Y := fun j =>
      Nat.rec (motive := fun j => MMP.Mori.PrimeDivisor (seq (i₀ + j)).Y) F
        (fun j Tj => ((hflip (i₀ + j) (Nat.le_add_right _ _)).exists_transform Tj).choose) j
    exact ⟨T, rfl, fun j =>
      ((hflip (i₀ + j) (Nat.le_add_right _ _)).exists_transform (T j)).choose_spec⟩
  choose T hT0 hT using hchain
  -- every floor component of the tail lies on a chain
  have hcover : ∀ j, ∀ E ∈ (seq (i₀ + j)).floor, ∃ F ∈ (seq i₀).floor, T F j = E := by
    intro j
    induction j with
    | zero => exact fun E hE => ⟨E, hE, hT0 E⟩
    | succ j ih =>
      intro E hE
      obtain ⟨P, hP, hPE⟩ := (hflip (i₀ + j) (Nat.le_add_right _ _)).exists_floor E hE
      obtain ⟨F, hF, rfl⟩ := ih P hP
      exact ⟨F, hF, Option.some.inj ((hT F j).symm.trans hPE)⟩
  -- special termination for each chain
  have hST : ∀ F ∈ (seq i₀).floor, ∃ n₀ : ℕ, ∀ j, n₀ ≤ j →
      Disjoint (MMP.Mori.exceptionalSet ((seq (i₀ + j)).next hZ hα).2.f : Set _)
        (T F j).support := fun F hF =>
    eventually_disjoint_of_flips_of_mem_floor hX hXs hZ hπ hdim hK hB hC hlc hsnc hCB hA hAB
      hAmple hAfloor hα hN hNB hnum ht₀ ht₁ hBY hY h₀ hall i₀ hflip (T F) (by rw [hT0]; exact hF)
      (hT F)
  choose! n₀ hn₀ using hST
  refine ⟨i₀ + (seq i₀).floor.sup n₀, Nat.le_add_right _ _, fun i hi E hE => ?_⟩
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (le_trans (Nat.le_add_right _ _) hi)
  obtain ⟨F, hF, rfl⟩ := hcover j E hE
  exact hn₀ F hF j (le_trans (Finset.le_sup hF) (by omega))

/-! ### The main theorem -/

open Classical in
private theorem solution
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {K : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXs : MMP.Mori.IsSmoothScheme sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) (hπ : π ≫ sZ = sX)
    (hdim : topologicalKrullDim X = 4) (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, B.coeff P = 1 → C.coeff P = 0)
    (hA : ∀ P, 0 ≤ A.coeff P) (hAB : ∀ P, (A.coeff P : ℝ) ≤ B.coeff P)
    (hAmple : IsRelativelyAmple sX (QDivisor.toRDivisor A))
    (hAfloor : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P ≠ 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → B.coeff P = 1)
    (hnum : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor K B) (C + N))
    (ht₀ : 0 < t) (ht₁ : t < 1)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y,
      BY.coeff F = (RationalMap.transformDivisor φ B).coeff F +
        if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY K (B + t • C) KY
      (BY + t • RationalMap.transformDivisor φ C) φ) :
    ∃ (n : ℕ) (Ys : ℕ → Scheme.{0}) (sYs : ∀ i, Ys i ⟶ Spec (.of ℂ))
      (_ : ∀ i, IsIntegral (Ys i)) (_ : ∀ i, CompactSpace (Ys i))
      (_ : ∀ i, IsLocallyNoetherian (Ys i)) (_ : ∀ i, IsNormal (Ys i))
      (πYs : ∀ i, Ys i ⟶ Z) (KYs : ∀ i, Divisor (Ys i)) (BYs CYs : ∀ i, RDivisor (Ys i))
      (W : ℕ → Scheme.{0}) (sW : ∀ i, W i ⟶ Spec (.of ℂ)) (f : ∀ i, modelSeq Y Ys i ⟶ W i)
      (g : ∀ i, W i ⟶ Z) (fp : ∀ i, Ys i ⟶ W i)
      (φs : ∀ i, (modelSeq Y Ys i).RationalMap (Ys i)) (thr : ℕ → ℝ),
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sYs i) ∧ IsQFactorial (modelStr sY sYs i) ∧
          (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sYs i) m (divisorSeq KY KYs i)) ∧
          IsRealDltPair (modelStr sY sYs i) (divisorSeq BY BYs i)) ∧
      (∀ i < n,
        IsRelativelyNef ℂ (modelStr sY sYs i) (modelMap πY πYs i)
            (logCanonicalDivisor (divisorSeq KY KYs i)
              (divisorSeq BY BYs i + thr i •
                divisorSeq (RationalMap.transformDivisor φ C) CYs i)) ∧
          (∀ s : ℝ, 0 ≤ s → s < thr i →
            ¬ IsRelativelyNef ℂ (modelStr sY sYs i) (modelMap πY πYs i)
              (logCanonicalDivisor (divisorSeq KY KYs i)
                (divisorSeq BY BYs i + s •
                  divisorSeq (RationalMap.transformDivisor φ C) CYs i))) ∧
          IsNegativeExtremalContraction ℂ (modelStr sY sYs i) (sW i)
            (logCanonicalDivisor (divisorSeq KY KYs i) (divisorSeq BY BYs i)) (f i) ∧
          f i ≫ g i = modelMap πY πYs i ∧ fp i ≫ g i = πYs i ∧
          IsNumericallyEquivalentOver ℂ (modelStr sY sYs i) (f i)
            (logCanonicalDivisor (divisorSeq KY KYs i)
              (divisorSeq BY BYs i + thr i •
                divisorSeq (RationalMap.transformDivisor φ C) CYs i)) 0 ∧
          ((IsBirationalMorphism (f i) ∧
              (∃ E : MMP.Mori.PrimeDivisor (modelSeq Y Ys i),
                (MMP.Mori.exceptionalSet (f i) : Set (modelSeq Y Ys i)) = E.support) ∧
              IsIso (fp i) ∧ IsModificationOf (f i) (fp i) (φs i)) ∨
            IsFlip ℂ (modelStr sY sYs i) (sW i) (sYs i)
              (logCanonicalDivisor (divisorSeq KY KYs i) (divisorSeq BY BYs i)) (f i) (fp i)
              (φs i)) ∧
          KYs i = RationalMap.transformDivisor (φs i) (divisorSeq KY KYs i) ∧
          BYs i = RationalMap.transformDivisor (φs i) (divisorSeq BY BYs i) ∧
          CYs i = RationalMap.transformDivisor (φs i)
            (divisorSeq (RationalMap.transformDivisor φ C) CYs i) ∧
          ∃ E : MMP.Mori.PrimeDivisor (modelSeq Y Ys i), (divisorSeq BY BYs i).coeff E = 1 ∧
            ∀ Γ : ProperCurve (modelStr sY sYs i), Γ.IsContractedBy (f i) →
              ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (modelSeq Y Ys i)) (x : ℝ),
                IsRIntersectionNumber ℂ (modelStr sY sYs i) (Finsupp.single E (1 : ℝ)) r L Γ x →
                  x < 0) ∧
      IsRelativelyNef ℂ (modelStr sY sYs n) (modelMap πY πYs n)
        (logCanonicalDivisor (divisorSeq KY KYs n) (divisorSeq BY BYs n))  := by
  classical
  set CY : RDivisor Y := MMP.Mori.RationalMap.transformDivisor φ C with hCY
  let S₀ : Stage Z := initStage sY πY KY BY CY t
  have h₀ : S₀.Inv sZ α := by
    have hXn : IsNormalVariety ℂ sX := hlc.1
    haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
    have hYp := hY.isProjectiveVariety_model
    haveI : IsProper sY := isProper_of_isProjectiveMorphism sY hYp.isProjective
    have hQX : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
      simpa using MMP.Threefold.Resolution.isCartier_of_isSmoothScheme hXs D⟩⟩
    have hQY := hY.isQFactorial
    -- the dimension of `Y`
    obtain ⟨nY, hKY⟩ := hY.isCanonicalDivisor_model
    obtain ⟨W, _, _, _, sW, p, q, h', GX, GY, hR⟩ := hY.exists_resolution
    have hXv : MMP.Mori.IsVariety ℂ sX := hXn.1
    have hYv : MMP.Mori.IsVariety ℂ sY := hY.isNormalVariety_model.1
    have hWp : MMP.Mori.IsVariety ℂ (p ≫ sX) := by rw [hR.comp_eq_left]; exact hR.isVariety
    have hWq : MMP.Mori.IsVariety ℂ (q ≫ sY) := by rw [hR.comp_eq_right]; exact hR.isVariety
    have e1 := MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX)
      hR.isBirationalMorphism_left
    have e2 := MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q ≫ sY)
      hR.isBirationalMorphism_right
    have hdimY : topologicalKrullDim Y = 4 := by rw [e2, ← e1, hdim]
    -- effectivity
    have hCY0 : ∀ P, 0 ≤ CY.coeff P := fun P =>
      coeff_mapPrimeDivisors_nonneg (φ := MMP.Mori.RationalMap.transformPrimeDivisor φ) hC P
    have hBY0 : ∀ P, 0 ≤ BY.coeff P := fun F => by
      rw [hBY F]
      have := coeff_mapPrimeDivisors_nonneg (φ := MMP.Mori.RationalMap.transformPrimeDivisor φ)
        hB F
      change 0 ≤ (MMP.Mori.RationalMap.transformDivisor φ B).coeff F at this
      split_ifs <;> linarith
    have htC : ∀ P, 0 ≤ (t • CY).coeff P := fun P => by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, smul_eq_mul]
      exact mul_nonneg ht₀.le (hCY0 P)
    have hdltY := hY.isRealDltPair
    refine ⟨hYp, hQY, ?_, hY.comp_eq_model, isRealDltPair_of_add hdltY hQY hBY0 htC, hBY0, hCY0,
      ht₀, hdltY.1, hY.isRelativelyNef, ?_⟩
    · obtain rfl : nY = 4 := by
        have := hKY.topologicalKrullDim_eq
        rw [hdimY] at this
        exact_mod_cast this.symm
      exact hKY
    · have hB1 : ∀ P, B.coeff P ≤ 1 := fun P => by
        have := coeff_le_one_of_isRealLcPair hlc P
        rw [DivisorWithCoeffs.coeff_add] at this
        linarith [hC P]
      have hCB' : ∀ P, C.coeff P ≠ 0 → B.coeff P < 1 := fun P hP =>
        lt_of_le_of_ne (hB1 P) fun h => hP (hCB P h)
      have hNB' : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P := fun P hP => (hNB P hP).ge
      obtain ⟨NY, h1, h2, h3, -⟩ :=
        MMP.Fourfold.exists_isNumericallyEquivalentOver_logCanonicalDivisor_of_isRealLogMinimalModel
          hX hZ hlc hQX hB hC hCB' hα hN hNB' hnum ht₀ ht₁.le hBY hY
      exact ⟨NY, h1, h2, h3⟩
  have hterm : ∃ i, (Stage.seq hZ hα S₀ i).IsNef := by
    by_contra hcon
    push Not at hcon
    have hinv := Stage.seq_inv hZ hα S₀ h₀
    have hstep : ∀ i, StepProps (Stage.seq hZ hα S₀ i) (Stage.seq hZ hα S₀ (i + 1))
        ((Stage.seq hZ hα S₀ i).next hZ hα).2 ∧
        StepExtra (Stage.seq hZ hα S₀ i) (Stage.seq hZ hα S₀ (i + 1))
          ((Stage.seq hZ hα S₀ i).next hZ hα).2 := fun i =>
      ⟨(Stage.next_spec hZ hα _ (hinv i) (hcon i)).1,
        (Stage.next_spec hZ hα _ (hinv i) (hcon i)).2.1⟩
    -- only finitely many divisorial steps
    have hmass := fun i => mass_le_of_step (hinv i) (hstep i).2
    have hanti : Antitone fun i => (Stage.seq hZ hα S₀ i).mass :=
      antitone_nat_of_succ_le fun i => (hmass i).1
    have hfin : ∃ i₀, ∀ i, i₀ ≤ i → ¬ StepDiv (Stage.seq hZ hα S₀ i)
        (Stage.seq hZ hα S₀ (i + 1)) ((Stage.seq hZ hα S₀ i).next hZ hα).2 := by
      by_contra hcon'
      push Not at hcon'
      have hdec : ∀ k : ℕ, ∃ i, (Stage.seq hZ hα S₀ i).mass ≤ (Stage.seq hZ hα S₀ 0).mass - k := by
        intro k
        induction k with
        | zero => exact ⟨0, by simp⟩
        | succ k ih =>
          obtain ⟨i, hi⟩ := ih
          obtain ⟨j, hj, hdiv⟩ := hcon' i
          refine ⟨j + 1, ?_⟩
          have h1 := (hmass j).2 hdiv
          have h2 := hanti hj
          push_cast
          linarith
      obtain ⟨k, hk⟩ := exists_nat_gt (Stage.seq hZ hα S₀ 0).mass
      obtain ⟨i, hi⟩ := hdec k
      linarith [mass_nonneg (hinv i)]
    obtain ⟨i₀, hi₀⟩ := hfin
    have hflip : ∀ i, i₀ ≤ i → StepFlip (Stage.seq hZ hα S₀ i) (Stage.seq hZ hα S₀ (i + 1))
        ((Stage.seq hZ hα S₀ i).next hZ hα).2 := fun i hi =>
      ((hstep i).2.2.2.1).resolve_left (hi₀ i hi)
    -- special termination along the tail of flips
    obtain ⟨i₁, -, hi₁⟩ := eventually_disjoint_of_flips hX hXs hZ hπ hdim hK hB hC hlc hsnc hCB hA
      hAB hAmple hAfloor hα hN hNB hnum ht₀ ht₁ hBY hY h₀ hcon i₀ hflip
    obtain ⟨E, hE, y, hy, hyE⟩ :=
      exists_mem_exceptionalSet_inter_of_step (hinv i₁) (hstep i₁).1 (hstep i₁).2
    exact Set.disjoint_left.mp (hi₁ i₁ le_rfl E hE) hy hyE
  let n := Nat.find hterm
  have hn : (Stage.seq hZ hα S₀ n).IsNef := Nat.find_spec hterm
  have hlt : ∀ i < n, ¬ (Stage.seq hZ hα S₀ i).IsNef := fun i hi => Nat.find_min hterm hi
  have hinv := Stage.seq_inv hZ hα S₀ h₀
  have hstep : ∀ i < n, StepProps (Stage.seq hZ hα S₀ i) (Stage.seq hZ hα S₀ (i + 1))
      ((Stage.seq hZ hα S₀ i).next hZ hα).2 := fun i hi =>
    (Stage.next_spec hZ hα _ (hinv i) (hlt i hi)).1
  refine ⟨n, fun i => (Stage.seq hZ hα S₀ (i + 1)).Y, fun i => (Stage.seq hZ hα S₀ (i + 1)).sY,
    fun i => inferInstance, fun i => inferInstance, fun i => inferInstance, fun i => inferInstance,
    fun i => (Stage.seq hZ hα S₀ (i + 1)).πY, fun i => (Stage.seq hZ hα S₀ (i + 1)).K,
    fun i => (Stage.seq hZ hα S₀ (i + 1)).B, fun i => (Stage.seq hZ hα S₀ (i + 1)).C,
    fun i => ((Stage.seq hZ hα S₀ i).next hZ hα).2.W,
    fun i => ((Stage.seq hZ hα S₀ i).next hZ hα).2.sW,
    fun i => match i with
      | 0 => ((Stage.seq hZ hα S₀ 0).next hZ hα).2.f
      | i + 1 => ((Stage.seq hZ hα S₀ (i + 1)).next hZ hα).2.f,
    fun i => ((Stage.seq hZ hα S₀ i).next hZ hα).2.g,
    fun i => ((Stage.seq hZ hα S₀ i).next hZ hα).2.fp,
    fun i => match i with
      | 0 => ((Stage.seq hZ hα S₀ 0).next hZ hα).2.φ
      | i + 1 => ((Stage.seq hZ hα S₀ (i + 1)).next hZ hα).2.φ,
    fun i => ((Stage.seq hZ hα S₀ i).next hZ hα).2.thr, ?_, ?_, ?_⟩
  · intro i hi
    obtain ⟨h1, h2, h3, -, h5, -⟩ := hinv i
    rcases i with _ | i
    · exact ⟨h1, h2, ⟨4, h3⟩, h5⟩
    · exact ⟨h1, h2, ⟨4, h3⟩, h5⟩
  · intro i hi
    have := hstep i hi
    rcases i with _ | i
    · exact this
    · exact this
  · rcases hn' : n with _ | n'
    · rw [hn'] at hn
      exact hn
    · rw [hn'] at hn
      exact hn

end Proof_lem_fourfold_real_floor_program_below_one

