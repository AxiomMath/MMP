/-! ### Convex cones -/

section Convex

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- A linear form nonnegative on a set is nonnegative on the convex cone it spans. -/
private theorem nonneg_of_mem_hull (α : V →ₗ[ℝ] ℝ) {S : Set V} (hS : ∀ g ∈ S, 0 ≤ α g)
    {z : V} (hz : z ∈ PointedCone.hull ℝ S) : 0 ≤ α z := by
  induction hz using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_nonneg hx hy
  | smul a x _ hx =>
    rw [← Nonneg.coe_smul, map_smul, smul_eq_mul]
    exact mul_nonneg a.2 hx
/-- In a ray `ℝ_{≥0} v`, every nonzero element spans the same ray. -/
private theorem ray_eq_of_mem {R : Set V} {v : V} (hR : R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • v = w})
    {u : V} (hu : u ∈ R) (hu0 : u ≠ 0) : R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • u = w} := by
  rw [hR] at hu ⊢
  obtain ⟨c, hc, rfl⟩ := hu
  have hc0 : c ≠ 0 := by rintro rfl; simp at hu0
  have hcpos : 0 < c := lt_of_le_of_ne hc (Ne.symm hc0)
  ext w
  constructor
  · rintro ⟨d, hd, rfl⟩
    exact ⟨d / c, div_nonneg hd hc, by rw [smul_smul, div_mul_cancel₀ _ hc0]⟩
  · rintro ⟨d, hd, rfl⟩
    exact ⟨d * c, mul_nonneg hd hc, by rw [smul_smul]⟩
/-- A linear form negative at one point of a ray is negative at every nonzero point of it. -/
private theorem neg_of_mem_ray (ℓ : V →ₗ[ℝ] ℝ) {R : Set V} {v : V}
    (hR : R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • v = w}) {u : V} (hu : u ∈ R) (hℓu : ℓ u < 0) :
    ∀ w ∈ R, w ≠ 0 → ℓ w < 0 := by
  have hu0 : u ≠ 0 := by rintro rfl; simp at hℓu
  rw [ray_eq_of_mem hR hu hu0]
  rintro _ ⟨c, hc, rfl⟩ hw
  have hc0 : c ≠ 0 := by rintro rfl; simp at hw
  rw [map_smul, smul_eq_mul]
  exact mul_neg_of_pos_of_neg (lt_of_le_of_ne hc (Ne.symm hc0)) hℓu
/-- A finite sum of elements of a cone `N` lying in an extremal face of `N` has all its summands
in the face. -/
private theorem mem_of_sum_mem {N R : Set V} (hNadd : ∀ u ∈ N, ∀ v ∈ N, u + v ∈ N)
    (hN0 : (0 : V) ∈ N) (hR : IsExtremalFace ℝ N R) {ι : Type*} (s : Finset ι) (x : ι → V)
    (hx : ∀ i ∈ s, x i ∈ N) (hsum : ∑ i ∈ s, x i ∈ R) : ∀ i ∈ s, x i ∈ R := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s has ih =>
    rw [Finset.sum_insert has] at hsum
    have hsN : ∑ i ∈ s, x i ∈ N := by
      have : ∀ t : Finset ι, (∀ i ∈ t, x i ∈ N) → ∑ i ∈ t, x i ∈ N := by
        intro t
        induction t using Finset.induction_on with
        | empty => simpa using hN0
        | insert b t hbt iht =>
          intro ht
          rw [Finset.sum_insert hbt]
          exact hNadd _ (ht b (Finset.mem_insert_self _ _)) _
            (iht fun i hi => ht i (Finset.mem_insert_of_mem hi))
      exact this s fun i hi => hx i (Finset.mem_insert_of_mem hi)
    obtain ⟨ha, hs⟩ := hR.2.2.2 _ (hx a (Finset.mem_insert_self _ _)) _ hsN hsum
    intro i hi
    rcases Finset.mem_insert.mp hi with rfl | hi
    · exact ha
    · exact ih (fun j hj => hx j (Finset.mem_insert_of_mem hj)) hs i hi
/-- **A ray inside a finitely generated decomposition.** Let `R` be an extremal ray of a convex
cone `N`, on whose nonzero elements the linear form `μ` is negative. If
`N ⊆ N_{μ ≥ 0} + hull F` with `F ⊆ N`, then `R = ℝ_{≥0} g` for some `g ∈ F`. -/
private theorem exists_mem_eq_ray {N : PointedCone ℝ V} {R : Set V}
    (hR : IsExtremalRay ℝ (N : Set V) R) (μ : V →ₗ[ℝ] ℝ) (hμ : ∀ u ∈ R, u ≠ 0 → μ u < 0)
    {F : Set V} (hF : F ⊆ N)
    (hdec : (N : Set V) ⊆ {z | z ∈ N ∧ 0 ≤ μ z} + (PointedCone.hull ℝ F : Set V)) :
    ∃ g ∈ F, R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • g = w} := by
  classical
  obtain ⟨hface, v, hv0, hRv⟩ := hR
  have hvR : v ∈ R := by rw [hRv]; exact ⟨1, zero_le_one, one_smul _ _⟩
  obtain ⟨w, ⟨hwN, hwμ⟩, h, hh, hvwh⟩ := hdec (hface.1 hvR)
  obtain ⟨n, f, g, rfl⟩ := Submodule.mem_span_set'.mp hh
  have hterm : ∀ i ∈ Finset.univ, (f i • (g i : V)) ∈ (N : Set V) := fun i _ =>
    Submodule.smul_mem N (f i) (hF (g i).2)
  subst hvwh
  -- the summands all lie on `R`
  have hall : ∀ i ∈ (Finset.univ : Finset (Option (Fin n))),
      (Option.elim i w fun j => f j • (g j : V)) ∈ R := by
    refine mem_of_sum_mem (fun u hu v hv => N.add_mem hu hv) N.zero_mem hface _ _ ?_ ?_
    · rintro (_ | j) -
      · exact hwN
      · exact hterm j (Finset.mem_univ _)
    · rw [Fintype.sum_option]
      simpa using hvR
  have hw0 : w = 0 := by
    by_contra hw0
    exact absurd hwμ (not_le.mpr (hμ w (hall none (Finset.mem_univ _)) hw0))
  have hsum0 : ∑ i, f i • (g i : V) ≠ 0 := by
    simpa [hw0] using hv0
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum0
  have hiR : f i • (g i : V) ∈ R := hall (some i) (Finset.mem_univ _)
  have hf0 : (f i : ℝ) ≠ 0 := by
    intro h0
    apply hi
    rw [← Nonneg.coe_smul, h0, zero_smul]
  refine ⟨g i, (g i).2, ?_⟩
  rw [ray_eq_of_mem hRv hiR hi, ← Nonneg.coe_smul]
  ext u
  constructor
  · rintro ⟨c, hc, rfl⟩
    exact ⟨c * f i, mul_nonneg hc (f i).2, by rw [smul_smul]⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨c / f i, div_nonneg hc (f i).2, by rw [smul_smul, div_mul_cancel₀ _ hf0]⟩

end Convex

section Topology

variable {V : Type*} [AddCommGroup V] [Module ℝ V] [TopologicalSpace V] [IsTopologicalAddGroup V]
  [ContinuousSMul ℝ V]

/-- Adding a ray to a closed set on which a continuous linear form `α` is nonnegative keeps it
closed, provided `α` is positive on the ray. -/
private theorem isClosed_add_hull_singleton (α : V →ₗ[ℝ] ℝ) (hα : Continuous α) {K : Set V}
    (hK : IsClosed K) (hKα : ∀ z ∈ K, 0 ≤ α z) {g : V} (hg : 0 < α g) :
    IsClosed (K + (PointedCone.hull ℝ {g} : Set V)) := by
  refine isClosed_of_closure_subset fun x hx => ?_
  set T : ℝ := (α x + 1) / α g
  set S : Set V := (fun t : ℝ => t • g) '' Set.Icc 0 T
  have hS : IsCompact S := isCompact_Icc.image (continuous_id.smul continuous_const)
  have hKS : IsClosed (K + S) := hK.add_right_of_isCompact hS
  have hsub : K + S ⊆ K + (PointedCone.hull ℝ {g} : Set V) := by
    rintro _ ⟨a, ha, _, ⟨t, ht, rfl⟩, rfl⟩
    refine ⟨a, ha, t • g, ?_, rfl⟩
    exact Submodule.mem_span_singleton.mpr ⟨⟨t, ht.1⟩, rfl⟩
  refine hsub (hKS.closure_subset ?_)
  rw [mem_closure_iff] at hx ⊢
  intro o ho hxo
  have hU : IsOpen {y : V | α y < α x + 1} := isOpen_lt hα continuous_const
  obtain ⟨y, ⟨hyo, hyU⟩, a, ha, b, hb, rfl⟩ :=
    hx (o ∩ {y | α y < α x + 1}) (ho.inter hU) ⟨hxo, by simp⟩
  obtain ⟨t, rfl⟩ := Submodule.mem_span_singleton.mp hb
  refine ⟨a + t • g, hyo, a, ha, (t : ℝ) • g, ⟨t, ⟨t.2, ?_⟩, rfl⟩, by
    simp only [Nonneg.coe_smul]⟩
  have h1 := hKα a ha
  have h2 : α (a + (t : ℝ) • g) < α x + 1 := by rwa [Nonneg.coe_smul]
  rw [map_add, map_smul, smul_eq_mul] at h2
  rw [le_div_iff₀ hg]
  linarith
/-- Adding a finitely generated cone, on whose generators `α` is positive, to a closed set on
which `α` is nonnegative keeps it closed. -/
private theorem isClosed_add_hull (α : V →ₗ[ℝ] ℝ) (hα : Continuous α) {K : Set V}
    (hK : IsClosed K) (hKα : ∀ z ∈ K, 0 ≤ α z) (F : Finset V) (hF : ∀ g ∈ F, 0 < α g) :
    IsClosed (K + (PointedCone.hull ℝ (F : Set V) : Set V)) := by
  classical
  induction F using Finset.induction_on with
  | empty =>
    simp only [Finset.coe_empty, Submodule.span_empty, Submodule.bot_coe]
    simpa [Set.add_singleton] using hK
  | insert g F _ ih =>
    have ih' := ih fun g' hg' => hF g' (Finset.mem_insert_of_mem hg')
    have e : ∀ a b c : Set V, a + (b + c) = a + c + b := fun a b c => by
      rw [add_comm b c, add_assoc]
    rw [Finset.coe_insert, PointedCone.hull, Submodule.span_insert, Submodule.coe_sup, e]
    refine isClosed_add_hull_singleton α hα ih' ?_ (hF g (Finset.mem_insert_self _ _))
    rintro _ ⟨a, ha, b, hb, rfl⟩
    rw [map_add]
    exact add_nonneg (hKα a ha)
      (nonneg_of_mem_hull α (fun g' hg' => (hF g' (Finset.mem_insert_of_mem hg')).le) hb)
/-- **Absorbing rays, then closing up.** Let `N` be a closed convex cone, `ℓ` and `α`
continuous linear forms with `α ≥ 0` on `N`, and `g` a family in `N` with `α > 0` on it. If the
classes of a set `N₀` with `N = closure N₀` decompose as `N₀ ⊆ N_{ℓ ≥ 0} + hull g`, then for every
`ε > 0` with only finitely many `(ℓ + εα)`-negative members `F_ε` of the family,
`N ⊆ N_{ℓ + εα ≥ 0} + hull F_ε`. -/
private theorem subset_add_hull_of_finite {N : PointedCone ℝ V} (hN : IsClosed (N : Set V))
    {N₀ : Set V} (hN₀ : (N : Set V) ⊆ closure N₀) (ℓ α : V →ₗ[ℝ] ℝ) (hℓc : Continuous ℓ)
    (hαc : Continuous α) (hα : ∀ z ∈ N, 0 ≤ α z) {ι : Type*} (g : ι → V) (hg : ∀ j, g j ∈ N)
    (hgα : ∀ j, 0 < α (g j))
    (hdec : N₀ ⊆ {z | z ∈ N ∧ 0 ≤ ℓ z} + (PointedCone.hull ℝ (Set.range g) : Set V))
    {ε : ℝ} (hε : 0 < ε) (hfin : {x | ∃ j, g j = x ∧ ℓ x + ε * α x < 0}.Finite) :
    (N : Set V) ⊆ {z | z ∈ N ∧ 0 ≤ ℓ z + ε * α z} +
      (PointedCone.hull ℝ {x | ∃ j, g j = x ∧ ℓ x + ε * α x < 0} : Set V) := by
  classical
  set F := {x | ∃ j, g j = x ∧ ℓ x + ε * α x < 0}
  let P : PointedCone ℝ V :=
    { carrier := {z | z ∈ N ∧ 0 ≤ ℓ z + ε * α z}
      add_mem' := fun {a b} ha hb => ⟨N.add_mem ha.1 hb.1, by
        simp only [map_add]; nlinarith [ha.2, hb.2]⟩
      zero_mem' := ⟨N.zero_mem, by simp⟩
      smul_mem' := fun c z hz => ⟨Submodule.smul_mem N c hz.1, by
        change 0 ≤ ℓ ((c : ℝ) • z) + ε * α ((c : ℝ) • z)
        simp only [map_smul, smul_eq_mul]
        nlinarith [hz.2, c.2]⟩ }
  have hPcl : IsClosed (P : Set V) :=
    hN.inter (isClosed_le continuous_const (hℓc.add (continuous_const.mul hαc)))
  have hcl : IsClosed ((P : Set V) + (PointedCone.hull ℝ (hfin.toFinset : Set V) : Set V)) := by
    refine isClosed_add_hull α hαc hPcl (fun z hz => hα z hz.1) _ fun x hx => ?_
    obtain ⟨j, rfl, -⟩ := hfin.mem_toFinset.mp hx
    exact hgα j
  rw [hfin.coe_toFinset] at hcl
  refine hN₀.trans (closure_minimal (fun z hz => ?_) hcl)
  obtain ⟨a, ⟨haN, ha⟩, h, hh, rfl⟩ := hdec hz
  have hle : PointedCone.hull ℝ (Set.range g) ≤ P ⊔ PointedCone.hull ℝ F := by
    refine Submodule.span_le.mpr (Set.range_subset_iff.mpr fun j => ?_)
    by_cases hj : ℓ (g j) + ε * α (g j) < 0
    · exact (le_sup_right : PointedCone.hull ℝ F ≤ _) (Submodule.subset_span ⟨j, rfl, hj⟩)
    · exact (le_sup_left : P ≤ _) ⟨hg j, le_of_not_gt hj⟩
  obtain ⟨p, hp, h', hh', rfl⟩ := Submodule.mem_sup.mp (hle hh)
  have haP : a ∈ P := ⟨haN, by nlinarith [hα a haN]⟩
  exact ⟨a + p, P.add_mem haP hp, h', hh', add_assoc _ _ _⟩

end Topology

/-! ### Crepancy as a pull-back -/

section Crepancy

universe u

/-- The order of `c ^ m * g⁻¹` along a point, for nonzero rational functions `c` and `g`. -/
private theorem ord_zpow_mul_inv {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] (z : Y)
    {c g : Y.functionField} (hc : c ≠ 0) (hg : g ≠ 0) (m : ℤ) :
    Y.ord (c ^ m * g⁻¹) z = m * Y.ord c z - Y.ord g z := by
  rw [Scheme.ord_mul (zpow_ne_zero _ hc) (inv_ne_zero hg), MMP.Mori.ord_zpow _ hc,
    ← zpow_neg_one, MMP.Mori.ord_zpow _ hg]
  ring

variable {k : Type u} [Field k] [PerfectField k] {X U : Scheme.{u}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral U] [CompactSpace U] [IsLocallyNoetherian U] [IsNormal U]

/-- Coefficientwise crepancy: along a prime divisor `F` of `U`, the pull-back of a Cartier
multiple `E = m (K + B)` has coefficient `m (ord_F div(p^*ω) + Δ_F)` when `K = div(ω)`. -/
private theorem coeff_pullback_eq {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX) {p : U ⟶ X}
    [IsDominant p] [LocallyOfFiniteType (p ≫ sX)]
    (hY : IsNormalVariety k (p ≫ sX)) (hp : IsBirationalMorphism p) {n n' : ℕ} {K : Divisor X}
    (hK' : K.IsCanonicalDivisor sX n') {B : QDivisor X} {Δ : QDivisor U}
    (hcrep : IsCrepantBoundary sX n K B p hY hp Δ) {m : ℕ} (hm0 : 0 < m) {E : Divisor X}
    (hE : Divisor.toQDivisor E = (m : ℤ) • (Divisor.toQDivisor K + B)) (hEc : E.IsCartier)
    {hB : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉ E.supp}
    {Dp : Divisor U} (hDp : E.IsPullback p hB Dp) {ω : RationalPluriForms sX n' 1}
    (hω0 : ω ≠ 0) (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = K.coeff Γ)
    (F : MMP.Mori.PrimeDivisor U) :
    (Dp.coeff F : ℚ) =
      m * ((divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F + Δ.coeff F) := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have hK := (hcrep F).2.1
  obtain rfl : n = n' := by exact_mod_cast hK.1.symm.trans hK'.1
  have hn := hK.topologicalKrullDim_eq
  set D : DivisorOver k sX := ⟨U, p, hY, hp, F⟩ with hD
  obtain ⟨b, N', hb0⟩ := D.exists_ordPullback_eq hX hn
  have hb : ∀ (m : ℤ) (τ : RationalPluriForms sX n m), τ ≠ 0 → D.ordPullback τ =
      U.ord (functionFieldMap p ((ZTensorPower.basis b m).repr τ ())) F.genericPoint + m * N' :=
    hb0
  let := functionFieldAlgebra sX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨V, hxV, φ, hφ⟩ := hEc (p F.genericPoint)
  let Z0 : irreducibleComponents X := ⟨Set.univ, by
    rw [irreducibleComponents_eq_singleton]; simp⟩
  set c := (ZTensorPower.basis b 1).repr ω () with hc_def
  have hc : c ≠ 0 := repr_ne_zero_of_ne_zero b hω0
  set g := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : RationalFunctions X) with hg_def
  have hg : g ≠ 0 := (φ.isUnit.map _).ne_zero
  set c'' : X.functionField := c ^ (m : ℤ) * g⁻¹ with hc''_def
  have hc'' : c'' ≠ 0 := mul_ne_zero (zpow_ne_zero _ hc) (inv_ne_zero hg)
  let τ : RationalPluriForms sX n m := c'' • ZTensorPower.basis b (m : ℤ) ()
  have hτr : (ZTensorPower.basis b (m : ℤ)).repr τ () = c'' := by simp [τ]
  have hτ0 : τ ≠ 0 := smul_ne_zero hc'' ((ZTensorPower.basis b (m : ℤ)).ne_zero ())
  have hKcoeff : ∀ Γ : MMP.Mori.PrimeDivisor X, ∃ NΓ : ℤ,
      (K.coeff Γ : ℤ) = X.ord c Γ.genericPoint + NΓ ∧
      (Γ.ordForm τ : ℤ) = m * X.ord c Γ.genericPoint - X.ord g Γ.genericPoint + m * NΓ := by
    intro Γ
    obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
    refine ⟨NΓ, ?_, ?_⟩
    · rw [← hωK Γ, hNΓ 1 ω hω0]
      simp [hc_def]
    · rw [hNΓ _ τ hτ0, hτr, hc''_def, ord_zpow_mul_inv _ hc hg]
  have hgord : ∀ Γ : MMP.Mori.PrimeDivisor X, (Γ.support ∩ V).Nonempty →
      X.ord g Γ.genericPoint = E.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ hΓ, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    have : Γ.component = Z0 :=
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _
    rw [this]
  have hCq : ∀ Γ : MMP.Mori.PrimeDivisor X,
      (E.coeff Γ : ℚ) = m * (K.coeff Γ + B.coeff Γ) := by
    intro Γ
    have := congrArg (fun D : QDivisor X => D.coeff Γ) hE
    rw [mul_add]
    simpa [zsmul_eq_mul] using this
  have hgen : GeneratesOn B m V τ := by
    refine ⟨hτ0, fun Γ hΓ => ?_⟩
    obtain ⟨NΓ, h1, h2⟩ := hKcoeff Γ
    have h3 := hgord Γ hΓ
    have h1' : (K.coeff Γ : ℚ) = X.ord c Γ.genericPoint + NΓ := by exact_mod_cast h1
    have h2' : (Γ.ordForm τ : ℚ) = m * X.ord c Γ.genericPoint - X.ord g Γ.genericPoint
        + m * NΓ := by exact_mod_cast h2
    have h3' : (X.ord g Γ.genericPoint : ℚ) = E.coeff Γ := by exact_mod_cast h3
    linear_combination h2' - hCq Γ - h3' - (m : ℚ) * h1'
  have hKY : (divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F =
      U.ord (functionFieldMap p c) F.genericPoint + N' := by
    have h := hb 1 ω hω0
    have e : D.ordPullback ω = (divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F := by
      rw [coeff_divisorOfForm]
      rfl
    rw [← e, h]
    simp [hc_def]
  have hcoeff : Dp.coeff F = U.ord (functionFieldMap p g) F.genericPoint :=
    MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hDp hφ F hxV Z0
  have hgY : functionFieldMap p g ≠ 0 := (map_ne_zero _).mpr hg
  have hcY : functionFieldMap p c ≠ 0 := (map_ne_zero _).mpr hc
  have hordτ : D.ordPullback τ = m * U.ord (functionFieldMap p c) F.genericPoint
      - U.ord (functionFieldMap p g) F.genericPoint + m * N' := by
    rw [hb _ τ hτ0, hτr, hc''_def, map_mul, map_zpow₀, map_inv₀, ord_zpow_mul_inv _ hcY hgY]
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm0.ne'
  have hdisc : IsDiscrepancy sX n K B D
      ((divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F - Dp.coeff F / m) := by
    refine ⟨hX, hK, m, hm0, ⟨E, hE, hEc⟩, V, hxV, τ, hgen, ?_⟩
    have e1 : (D.ordPullback τ : ℚ) = m * U.ord (functionFieldMap p c) F.genericPoint
        - U.ord (functionFieldMap p g) F.genericPoint + m * N' := by exact_mod_cast hordτ
    have e2 : ((divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F : ℚ) =
        U.ord (functionFieldMap p c) F.genericPoint + N' := by exact_mod_cast hKY
    have e3 : (Dp.coeff F : ℚ) = U.ord (functionFieldMap p g) F.genericPoint := by
      exact_mod_cast hcoeff
    rw [e1, e2, e3]
    field_simp
    ring
  have heq := IsDiscrepancy.eq (hcrep F) hdisc
  field_simp at heq
  linear_combination heq
/-- The pull-back of a nonzero rational form along a birational morphism is nonzero. -/
private theorem pullbackRationalPluriForms_ne_zero {sX : X ⟶ Spec (.of k)}
    (hX : IsNormalVariety k sX)
    {p : U ⟶ X} [IsDominant p] (hp : IsBirationalMorphism p) {n : ℕ}
    (hn : topologicalKrullDim X = n) {m : ℤ} {τ : RationalPluriForms sX n m} (hτ : τ ≠ 0) :
    pullbackRationalPluriForms sX p τ ≠ 0 := by
  let := functionFieldAlgebra sX
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  have hbij := hp.functionFieldMap_bijective
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX p hbij hd
  let := functionFieldAlgebra (p ≫ sX)
  let := functionFieldMapAlgebra p
  have := isScalarTower_functionFieldMap sX p
  have hpull : pullbackRationalPluriForms sX p τ = pullbackFormsAlong hω m τ :=
    pullbackForms_eq hω m τ
  have hrepr := repr_pullbackFormsAlong hω m τ
  intro h0
  have h0' : pullbackFormsAlong hω m τ = 0 := hpull ▸ h0
  have h1 : algebraMap X.functionField U.functionField
      ((ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) m).repr τ ()) = 0 := by
    rw [← hrepr, h0']
    simp
  exact repr_ne_zero_of_ne_zero _ hτ ((map_eq_zero_iff _ (algebraMap _ _).injective).mp h1)
/-- **Crepancy as a pull-back.** If `Δ` is the crepant boundary of `(X, B)` on `U` and
`K = div(ω)`, then `div(p^*ω) + Δ = p^*(K + B)`. -/
private theorem isPullback_divisorOfForm_add {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX)
    {p : U ⟶ X} [IsDominant p] [LocallyOfFiniteType (p ≫ sX)]
    (hY : IsNormalVariety k (p ≫ sX)) (hp : IsBirationalMorphism p) {n n' : ℕ} {K : Divisor X}
    (hK' : K.IsCanonicalDivisor sX n') {B : QDivisor X} {Δ : QDivisor U}
    (hcrep : IsCrepantBoundary sX n K B p hY hp Δ) {ω : RationalPluriForms sX n' 1}
    (hω0 : ω ≠ 0) (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = K.coeff Γ)
    (hLB : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉
      (Divisor.toQDivisor K + B).supp) :
    (Divisor.toQDivisor K + B).IsPullback p hLB
      (Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms sX p ω)) + Δ) := by
  intro m hm D hD hDc
  have hB' : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉ D.supp :=
    fun Z hZ => hLB Z (by
      rwa [QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD] at hZ)
  refine ⟨D.pullback hDc hB', ?_, Divisor.isPullback_pullback hDc hB'⟩
  ext F
  have h := coeff_pullback_eq hX hY hp hK' hcrep hm hD hDc
    (Divisor.isPullback_pullback hDc hB') hω0 hωK F
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, zsmul_eq_mul,
    Divisor.coeff_toQDivisor, Int.cast_natCast]
  exact h

end Crepancy

/-! ### Curve forms -/

section CurveForm

variable {k : Type} [Field k] {X S : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X]

/-- The pairing of a `ℚ`-Cartier `ℚ`-divisor with `N₁(X/S)` is continuous. -/
private theorem continuous_relativeCurveForm (sX : X ⟶ Spec (.of k)) (f : X ⟶ S)
    (D : QDivisor X) (h : D.IsQCartier) :
    Continuous (QDivisor.relativeCurveForm sX f D h) := by
  unfold QDivisor.relativeCurveForm
  rw [Finsupp.sum, LinearMap.coe_sum, Finset.sum_fn]
  refine continuous_finsetSum _ fun E _ => ?_
  have := (Divisor.mem_cartierSubgroup.mp E.2).isInvertibleModule_divisorialSheaf
  rw [LinearMap.coe_smul]
  exact (RelativeNumericalCurveClasses.continuous_degree sX f _).const_smul _
/-- The pairing of a `ℚ`-Cartier `ℚ`-divisor with the class of a contracted curve is its
intersection number with the curve. -/
private theorem relativeCurveForm_relativeClass {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
    (f : X ⟶ S) (D : QDivisor X) (h : D.IsQCartier) (C : ProperCurve sX)
    (hC : C.IsContractedBy f) :
    QDivisor.relativeCurveForm sX f D h (C.relativeClass f hC) =
      (D.intersectionNumber k sX C.ι C.dim_le h : ℝ) := by
  rw [QDivisor.relativeCurveForm_eq_comp, LinearMap.comp_apply]
  exact MMP.ProgramBaseChange.curveForm_numericalClass_cycle sX D h C
/-- The curve form of a `ℚ`-Cartier `ℚ`-divisor `D` is `1 / m_D` times the degree of
`𝒪_X(m_D D)`. -/
private theorem curveForm_apply (sX : X ⟶ Spec (.of k)) (D : QDivisor X) (h : D.IsQCartier)
    (z : NumericalCurveClasses sX) :
    haveI :=
      (Divisor.mem_cartierSubgroup.mp (D.cartierIndexSMul h).2).isInvertibleModule_divisorialSheaf
    QDivisor.curveForm sX D h z = (1 / (D.cartierIndex h : ℝ)) *
      NumericalCurveClasses.degree sX (D.cartierIndexSMul h : Divisor X).divisorialSheaf z := by
  rw [QDivisor.curveForm, QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier,
    Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.sum_single_index]
  · rw [LinearMap.smul_apply, smul_eq_mul]
    push_cast
    rfl
  · simp
/-- A `ℚ`-Cartier `ℚ`-divisor `D` is nef over `S` once `(D · C) ≥ 0` for every curve contracted
to a point of `S`. -/
private theorem isRelativelyNef_of_forall {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
    (f : X ⟶ S) (D : QDivisor X) (h : D.IsQCartier)
    (hC : ∀ C : ProperCurve sX, C.IsContractedBy f →
      0 ≤ D.intersectionNumber k sX C.ι C.dim_le h) :
    QDivisor.IsRelativelyNef sX f D := by
  refine ⟨h, fun C hCf => ?_⟩
  have key := hC C hCf
  rw [QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier, Finsupp.smul_single,
    Finsupp.sum_single_index (by simp)]
  rw [QDivisor.intersectionNumber] at key
  have hm : (0 : ℚ) < D.cartierIndex h := by exact_mod_cast QDivisor.cartierIndex_pos h
  have h1 : (0 : ℚ) ≤ ((QDivisor.isCartierDivisor_cartierIndex_smul h).toDivisor.degreeOn k sX C.ι
      C.dim_le (QDivisor.isCartierDivisor_cartierIndex_smul h).isCartier_toDivisor : ℚ) := by
    have := mul_nonneg key hm.le
    rwa [div_mul_cancel₀ _ hm.ne'] at this
  have hm' : (0 : ℝ) < (D.cartierIndex h : ℝ) := by exact_mod_cast hm
  simp only [smul_eq_mul, mul_one]
  push_cast
  exact mul_nonneg (by positivity) (by exact_mod_cast h1)

end CurveForm

/-! ### The crepant projection formula -/

section Projection

variable {X W : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- **The crepant projection formula on one curve.** If `Δ_W` is the crepant boundary of
`(X, B)` on the birational model `p : W ⟶ X` and `K_W` is a canonical divisor of `W`, then for
every curve `Γ ⊆ W`, `(K + B) · p_*Γ = (K_W + Δ_W) · Γ`. -/
private theorem curveForm_pushforward_cycle (hXv : IsNormalVariety ℂ sX) {p : W ⟶ X}
    [IsDominant p] (hW : IsNormalVariety ℂ (p ≫ sX)) (hp : IsBirationalMorphism p) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {B : QDivisor X} {ΔW : QDivisor W}
    (hcrep : IsCrepantBoundary sX n K B p hW hp ΔW) (hD : (Divisor.toQDivisor K + B).IsQCartier)
    {KW : Divisor W} (hKW : KW.IsCanonicalDivisor (p ≫ sX) n)
    (hDW : (Divisor.toQDivisor KW + ΔW).IsQCartier) (Γ : ProperCurve (p ≫ sX)) :
    haveI : QuasiCompact (p ≫ sX) := hW.1.toQuasiCompact
    QDivisor.curveForm sX (Divisor.toQDivisor K + B) hD
        (OneCycle.numericalClass sX (OneCycle.pushforward ℝ (p ≫ sX) sX p (Γ.cycle ℝ))) =
      ((Divisor.toQDivisor KW + ΔW).intersectionNumber ℂ (p ≫ sX) Γ.ι Γ.dim_le hDW : ℝ) := by
  haveI : QuasiCompact (p ≫ sX) := hW.1.toQuasiCompact
  haveI : LocallyOfFiniteType (p ≫ sX) := hW.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sX := hXv.1.toLocallyOfFiniteType
  haveI : IsSeparated sX := hXv.1.toIsSeparated
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hXv hK
  have hLB : ∀ Z : irreducibleComponents W, p (componentGenericPoint W Z) ∉
      (Divisor.toQDivisor K + B).supp := fun Z => by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    exact MMP.Fourfold.genericPoint_notMem_supp _
  have hpb := isPullback_divisorOfForm_add hXv hW hp hK hcrep hω0 hωK hLB
  set m := (Divisor.toQDivisor K + B).cartierIndex hD with hm_def
  have hm := QDivisor.cartierIndex_pos hD
  set E : Divisor X := ((Divisor.toQDivisor K + B).cartierIndexSMul hD : Divisor X) with hE_def
  have hEc : E.IsCartier :=
    Divisor.mem_cartierSubgroup.mp ((Divisor.toQDivisor K + B).cartierIndexSMul hD).2
  have hE : Divisor.toQDivisor E = (m : ℤ) • (Divisor.toQDivisor K + B) :=
    QDivisor.toQDivisor_cartierIndexSMul _ hD
  obtain ⟨D', hD', hpbE⟩ := hpb m hm E hE hEc
  have hD'c := hpbE.isCartier hEc
  haveI := hEc.isInvertibleModule_divisorialSheaf
  haveI := hD'c.isInvertibleModule_divisorialSheaf
  -- the left side is `(1 / m) deg_Γ p^* 𝒪_X(E) = (1 / m) deg_Γ 𝒪_W(D')`
  rw [curveForm_apply, NumericalCurveClasses.degree_numericalClass, OneCycle.pushforward_cycle,
    ProperCurve.degree_pushforward_eq_degree_pullback p rfl Γ E.divisorialSheaf]
  have h1 : Γ.degree ℂ ((Scheme.Modules.pullback p).obj E.divisorialSheaf) =
      D'.degreeOn ℂ (p ≫ sX) Γ.ι Γ.dim_le hD'c := by
    rw [← ProperCurve.degree_divisorialSheaf Γ D' hD'c]
    exact (degreeOn_eq_of_iso ℂ (p ≫ sX) Γ.ι Γ.dim_le (hpbE.divisorialSheafIso (hBc := hEc))).symm
  rw [h1]
  -- the right side, through the canonical divisor `div(p^*ω)`
  set KW' := divisorOfForm (pullbackRationalPluriForms sX p ω)
  have hW' : (Divisor.toQDivisor KW' + ΔW).IsQCartier := hpb.isQCartier hD
  have h2 := QDivisor.intersectionNumber_eq_of_smul ℂ (p ≫ sX) Γ.ι Γ.dim_le _ hW' hm D' hD'c hD'
  have hne := pullbackRationalPluriForms_ne_zero hXv hp hK.1 hω0
  have hlin : KW'.LinearlyEquivalent KW := by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hW hKW hne
  obtain ⟨_, _, _, h3⟩ := MMP.Flips.isIntersectionNumber_add_of_linearlyEquivalent
    (sX := p ≫ sX) (C := Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({Γ.point} : Set W)))
    (x := (Divisor.toQDivisor KW' + ΔW).intersectionNumber ℂ (p ≫ sX) Γ.ι Γ.dim_le hW') hlin
    ⟨inferInstance, Γ.dim_le, hW', rfl⟩
  change (Divisor.toQDivisor KW + ΔW).intersectionNumber ℂ (p ≫ sX) Γ.ι Γ.dim_le _ = _ at h3
  rw [show (Divisor.toQDivisor KW + ΔW).intersectionNumber ℂ (p ≫ sX) Γ.ι Γ.dim_le hDW =
      (Divisor.toQDivisor KW' + ΔW).intersectionNumber ℂ (p ≫ sX) Γ.ι Γ.dim_le hW' from h3, h2]
  push_cast
  ring
/-- The image of a curve contracted by `p ≫ h` under a closed map `p` is contracted by `h`. -/
private theorem isContractedBy_image {S : Scheme.{0}} {h : X ⟶ S} {p : W ⟶ X} [IsProper p]
    {Γ : ProperCurve (p ≫ sX)} (hΓ : Γ.IsContractedBy (p ≫ h)) (hC : IsProperCurve sX (p Γ.point)) :
    (⟨p Γ.point, hC⟩ : ProperCurve sX).IsContractedBy h := by
  intro x hx
  have hsub : closure ({p Γ.point} : Set X) ⊆ p '' closure ({Γ.point} : Set W) :=
    closure_minimal (Set.singleton_subset_iff.mpr ⟨Γ.point, subset_closure rfl, rfl⟩)
      (p.isClosedMap _ isClosed_closure)
  obtain ⟨y, hy, rfl⟩ := hsub hx
  have := hΓ y hy
  simpa only [Scheme.Hom.comp_apply] using this
/-- The push-forward of a curve contracted by `p ≫ h` is a relative 1-cycle over `S`. -/
private theorem pushforward_mem_relativeOneCycles {S : Scheme.{0}} {h : X ⟶ S} {p : W ⟶ X}
    [IsProper p] {Γ : ProperCurve (p ≫ sX)} (hΓ : Γ.IsContractedBy (p ≫ h)) :
    OneCycle.pushforward ℝ (p ≫ sX) sX p (Γ.cycle ℝ) ∈ relativeOneCycles sX h := by
  classical
  rw [OneCycle.pushforward_cycle, cyclePushforwardOfPoint]
  split_ifs with hC
  · exact Finsupp.single_mem_supported ℝ _ (isContractedBy_image hΓ hC)
  · exact zero_mem _
/-- Two linear forms on the relative 1-cycles agree once they agree on the contracted curves. -/
private theorem linearMap_ext_relativeOneCycles {k : Type} [Field k] {Y T : Scheme.{0}}
    {sY : Y ⟶ Spec (.of k)} {f : Y ⟶ T} {g₁ g₂ : relativeOneCycles sY f →ₗ[ℝ] ℝ}
    (hg : ∀ (C : ProperCurve sY) (hC : C.IsContractedBy f),
      g₁ ⟨C.cycle ℝ, C.cycle_mem_relativeOneCycles hC⟩ =
        g₂ ⟨C.cycle ℝ, C.cycle_mem_relativeOneCycles hC⟩) : g₁ = g₂ := by
  classical
  let e : relativeOneCycles sY f ≃ₗ[ℝ] ({C : ProperCurve sY | C.IsContractedBy f} →₀ ℝ) :=
    Finsupp.supportedEquivFinsupp (M := ℝ) (R := ℝ) {C : ProperCurve sY | C.IsContractedBy f}
  suffices hs : g₁ ∘ₗ e.symm.toLinearMap = g₂ ∘ₗ e.symm.toLinearMap by
    ext Z
    simpa using LinearMap.congr_fun hs (e Z)
  refine Finsupp.lhom_ext fun a b => ?_
  have he : e.symm (Finsupp.single a b) =
      b • ⟨a.1.cycle ℝ, a.1.cycle_mem_relativeOneCycles a.2⟩ := by
    apply Subtype.ext
    change ((Finsupp.supportedEquivFinsupp (M := ℝ) (R := ℝ)
      {C : ProperCurve sY | C.IsContractedBy f}).symm (Finsupp.single a b) :
        ProperCurve sY →₀ ℝ) = _
    rw [Finsupp.supportedEquivFinsupp_symm_single]
    simp [ProperCurve.cycle]
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, he, map_smul, hg a.1 a.2]
/-- **The crepant projection formula on `N₁(W/S)`.** For a crepant model `p : (W, Δ_W) ⟶ (X, B)`
over `S` and the push-forward `φ = p_* : N₁(W/S) ⟶ N₁(X/S)`,
`((K + B) · φ z) = ((K_W + Δ_W) · z)`. -/
private theorem relativeCurveForm_comp_eq {S : Scheme.{0}} (h : X ⟶ S)
    (hXv : IsNormalVariety ℂ sX) {p : W ⟶ X} [IsDominant p] [IsProper p]
    (hW : IsNormalVariety ℂ (p ≫ sX)) (hp : IsBirationalMorphism p) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {B : QDivisor X} {ΔW : QDivisor W}
    (hcrep : IsCrepantBoundary sX n K B p hW hp ΔW) (hD : (Divisor.toQDivisor K + B).IsQCartier)
    {KW : Divisor W} (hKW : KW.IsCanonicalDivisor (p ≫ sX) n)
    (hDW : (Divisor.toQDivisor KW + ΔW).IsQCartier)
    (φ : RelativeNumericalCurveClasses (p ≫ sX) (p ≫ h) →ₗ[ℝ] RelativeNumericalCurveClasses sX h)
    (hφ : ∀ (Z : relativeOneCycles (p ≫ sX) (p ≫ h)) (Z' : relativeOneCycles sX h),
      (Z' : OneCycle ℝ sX) = OneCycle.pushforward ℝ (p ≫ sX) sX p Z →
        φ (relativeNumericalClass (p ≫ sX) (p ≫ h) Z) = relativeNumericalClass sX h Z')
    (z : RelativeNumericalCurveClasses (p ≫ sX) (p ≫ h)) :
    QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD (φ z) =
      QDivisor.relativeCurveForm (p ≫ sX) (p ≫ h) (Divisor.toQDivisor KW + ΔW) hDW z := by
  haveI : QuasiCompact (p ≫ sX) := hW.1.toQuasiCompact
  suffices hs : QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD ∘ₗ φ =
      QDivisor.relativeCurveForm (p ≫ sX) (p ≫ h) (Divisor.toQDivisor KW + ΔW) hDW from
    LinearMap.congr_fun hs z
  refine Submodule.linearMap_qext _ (linearMap_ext_relativeOneCycles fun Γ hΓ => ?_)
  simp only [LinearMap.comp_apply, Submodule.mkQ_apply]
  change QDivisor.relativeCurveForm sX h _ hD
      (φ (relativeNumericalClass (p ≫ sX) (p ≫ h) ⟨Γ.cycle ℝ, _⟩)) =
    QDivisor.relativeCurveForm (p ≫ sX) (p ≫ h) _ hDW (Γ.relativeClass (p ≫ h) hΓ)
  rw [hφ _ ⟨_, pushforward_mem_relativeOneCycles hΓ⟩ rfl,
    relativeCurveForm_relativeClass, QDivisor.relativeCurveForm_eq_comp, LinearMap.comp_apply]
  exact curveForm_pushforward_cycle hXv hW hp hK hcrep hD hKW hDW Γ

end Projection

/-! ### Degrees of an ample divisor -/

section Ample

variable {X S : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- A projective variety carries a Cartier divisor whose sheaf is ample. -/
private theorem exists_isAmple_cartierSheaf (hX : MMP.Mori.IsProjectiveVariety ℂ sX) :
    ∃ M : X.CartierDivisor,
      Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M) := by
  haveI : IsIntegral X := hX.toIsIntegral
  obtain ⟨H, hH, hHa⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety hX
  obtain ⟨M, ⟨e⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf H
  exact ⟨M, (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mp
    ((Stacks.AmpleBridge.isAmple_iff_isAmple X H).mpr hHa)⟩
/-- Isomorphic invertible sheaves have the same degree form on `N₁(X/S)`. -/
private theorem relativeDegree_eq_of_iso (h : X ⟶ S) {L L' : X.Modules}
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L'] (e : L ≅ L') :
    RelativeNumericalCurveClasses.degree sX h L = RelativeNumericalCurveClasses.degree sX h L' := by
  refine Submodule.linearMap_qext _ (LinearMap.ext fun Z => ?_)
  change OneCycle.degree ℝ sX L Z = OneCycle.degree ℝ sX L' Z
  rw [OneCycle.degree, OneCycle.degree]
  congr 2
  funext C
  exact congrArg _ (degreeOn_eq_of_iso ℂ sX C.ι C.dim_le e)
/-- An ample Cartier divisor has positive degree on every contracted curve. -/
private theorem relativeDegree_pos (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (h : X ⟶ S)
    (M : X.CartierDivisor) (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M))
    (C : ProperCurve sX) (hC : C.IsContractedBy h) :
    0 < RelativeNumericalCurveClasses.degree sX h (MMP.CartierDivisor.sheaf M)
      (C.relativeClass h hC) := by
  rw [ProperCurve.relativeClass, RelativeNumericalCurveClasses.degree_relativeNumericalClass]
  change 0 < OneCycle.degree ℝ sX _ (C.cycle ℝ)
  rw [OneCycle.degree_cycle]
  exact_mod_cast MMP.Threefold.Mori.degreeOn_cartierSheaf_pos_of_isAmple hX.toIsVariety M hM C
/-- An ample Cartier divisor has nonnegative degree on `NE̅(X/S)`. -/
private theorem relativeDegree_nonneg (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (h : X ⟶ S)
    (M : X.CartierDivisor) (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M))
    {z : RelativeNumericalCurveClasses sX h} (hz : z ∈ relativeClosedConeOfCurves sX h) :
    0 ≤ RelativeNumericalCurveClasses.degree sX h
      (MMP.CartierDivisor.sheaf M) z := by
  rw [← SetLike.mem_coe, coe_relativeClosedConeOfCurves] at hz
  refine closure_minimal (fun w hw => ?_) (isClosed_le continuous_const
    (RelativeNumericalCurveClasses.continuous_degree sX h _)) hz
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨C, hC⟩, rfl⟩ := hx
    exact (relativeDegree_pos hX h M hM C hC).le
  | zero => simp
  | add x y _ _ hx hy =>
    change 0 ≤ RelativeNumericalCurveClasses.degree sX h _ (x + y)
    rw [map_add]
    exact add_nonneg hx hy
  | smul a x _ hx =>
    change 0 ≤ RelativeNumericalCurveClasses.degree sX h _ ((a : ℝ) • x)
    rw [map_smul, smul_eq_mul]
    exact mul_nonneg a.2 hx
/-- **Bounded classes.** Only finitely many classes of contracted curves have bounded degree
against an ample Cartier divisor: `N₁(X/S) → N₁(X)` is injective, and in `N₁(X)` the classes of
effective integral cycles of bounded ample degree are finitely many. -/
private theorem finite_relativeClass_degree_le [hXp : MMP.Mori.IsProjectiveVariety ℂ sX]
    (h : X ⟶ S) (M : X.CartierDivisor)
    (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M)) (c : ℝ) :
    {z : RelativeNumericalCurveClasses sX h | ∃ (C : ProperCurve sX) (hC : C.IsContractedBy h),
      C.relativeClass h hC = z ∧
        RelativeNumericalCurveClasses.degree sX h (MMP.CartierDivisor.sheaf M) z ≤
          c}.Finite := by
  have hS := (MMP.Mori.isCompact_closedConeOfCurves_inter_le_and_finite sX M hM
    (max c 1)).2
  have hinj : Function.Injective (relativeToAbsolute sX h) :=
    (MMP.Mori.existsUnique_isNaturalRelativeMap_and_injective sX h).2 _
      (isNaturalRelativeMap_relativeToAbsolute sX h)
  refine (hS.preimage hinj.injOn).subset ?_
  rintro _ ⟨C, hC, rfl, hc⟩
  refine ⟨C.cycle ℤ, fun D => ?_, ?_, ?_⟩
  · classical
    unfold ProperCurve.cycle
    rw [Finsupp.single_apply]
    split_ifs <;> norm_num
  · simp only [ProperCurve.cycle, Finsupp.mapRange_single, Int.cast_one]
    rfl
  · rw [NumericalCurveClasses.intersectionNumber_ofCartier]
    exact hc.trans (le_max_left _ _)

end Ample

/-! ### The decomposition through a crepant dlt modification -/

/-- **The curves of the cone theorem.** For a projective lc fourfold `(X, B)` over `S` there is a
countable family of rational curves `Cⱼ ⊆ X` contracted to points of `S`, with
`0 < -((K + B) · Cⱼ) ≤ 8`, such that every class of the cone of curves of `X` over `S` lies in
`NE̅(X/S)_{K + B ≥ 0} + ∑ⱼ ℝ_{≥0} [Cⱼ]`. The curves are the images of those of the dlt cone
theorem on a crepant dlt modification. -/
private theorem exists_curves_subset_add_hull
    {X S : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] {sS : S ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (h : X ⟶ S) (hh : h ≫ sS = sX) (hdim : topologicalKrullDim X = 4)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 4)
    {B : QDivisor X} (hB : MMP.Intersection.IsLogCanonicalPair sX B)
    (hD : (Divisor.toQDivisor K + B).IsQCartier) :
    ∃ (ι : Type) (_ : Countable ι) (C : ι → ProperCurve sX) (hC : ∀ j, (C j).IsContractedBy h),
      (∀ j, IsRationalCurve sX
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({(C j).point} : Set X)))) ∧
      (∀ j, 0 < -QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD
          ((C j).relativeClass h (hC j)) ∧
        -QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD
          ((C j).relativeClass h (hC j)) ≤ 8) ∧
      (relativeConeOfCurves sX h : Set (RelativeNumericalCurveClasses sX h)) ⊆
        {z | z ∈ relativeClosedConeOfCurves sX h ∧
          0 ≤ QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD z} +
        (PointedCone.hull ℝ (Set.range fun j => (C j).relativeClass h (hC j)) :
          Set (RelativeNumericalCurveClasses sX h)) := by
  classical
  obtain ⟨W, _, _, _, p, hp, hWq, ΔW, hpproj, hdlt, hcrepall, -⟩ :=
    MMP.Fourfold.projectiveFloorProgramInputs_four.exists_crepant_dltModification sX hX
      (by rw [hdim]; rfl) hB
  have hcrep := hcrepall K hK
  have hXv : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  have hWv : IsNormalVariety ℂ (p ≫ sX) := hWq.1
  haveI : IsProper p := isProper_of_isProjectiveMorphism _ hpproj
  haveI : IsDominant p := hp.isDominant
  haveI : QuasiCompact (p ≫ sX) := hWv.1.toQuasiCompact
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  haveI : IsSeparated sX := hX.toIsVariety.toIsSeparated
  have hpX : IsProjectiveMorphism sX := ((MMP.Mori.isProjectiveVariety_iff ℂ sX).1 hX).2
  have hWp : MMP.Mori.IsProjectiveVariety ℂ (p ≫ sX) :=
    (MMP.Mori.isProjectiveVariety_iff ℂ _).2 ⟨hWv.1, IsProjectiveMorphism.comp hpproj hpX⟩
  haveI : Surjective p := ⟨fun x => by
    have : Set.range p = Set.univ := by
      rw [← p.isClosedMap.isClosed_range.closure_eq]; exact p.denseRange.closure_range
    rw [← Set.mem_range, this]; trivial⟩
  have hdimW : topologicalKrullDim W = (4 : ℕ) := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hp, hdim]
    rfl
  obtain ⟨KW, hKW⟩ := MMP.Mori.exists_isCanonicalDivisor (p ≫ sX) hWv hdimW
  have hdltM : MMP.Mori.IsDltPair (p ≫ sX) 4 KW ΔW :=
    (MMP.Threefold.Bridges.isDltPair_iff_isDltPair (p ≫ sX) hKW ΔW).1 hdlt
  haveI : MMP.Mori.IsProjectiveVariety ℂ sX := hX
  haveI : MMP.Mori.IsProjectiveVariety ℂ sS := hS
  haveI : MMP.Mori.IsProjectiveVariety ℂ (p ≫ sX) := hWp
  have hπW : (p ≫ h) ≫ sS = p ≫ sX := by rw [Category.assoc, hh]
  obtain ⟨ι, hι, Γ, hΓ, hrat, hbd, heq⟩ :=
    hdltM.exists_relativeClosedConeOfCurves_eq_add_hull sS (p ≫ h) hπW hWq
  obtain ⟨φ, hφ, -, hmap, himg, -, -⟩ :=
    MMP.Mori.exists_relativeNumericalPushforward_of_surjective hWp hX hS hπW hh (p := p) rfl
  set ℓX := QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD
  set ℓW := QDivisor.relativeCurveForm (p ≫ sX) (p ≫ h) (Divisor.toQDivisor KW + ΔW)
    hdltM.1.2.2
  have hℓ : ∀ z, ℓX (φ z) = ℓW z :=
    relativeCurveForm_comp_eq h hXv hWv hp hK hcrep hD hKW hdltM.1.2.2 φ hφ
  -- the image of each `Γⱼ` is a proper curve, since `K_W + Δ_W` is negative on `Γⱼ`
  have hφΓ : ∀ j, φ ((Γ j).relativeClass (p ≫ h) (hΓ j)) =
      relativeNumericalClass sX h ⟨_, pushforward_mem_relativeOneCycles (hΓ j)⟩ :=
    fun j => hφ _ _ rfl
  have hprop : ∀ j, IsProperCurve sX (p (Γ j).point) := by
    intro j
    by_contra hnp
    have h0' : OneCycle.pushforward ℝ (p ≫ sX) sX p ((Γ j).cycle ℝ) = 0 := by
      rw [OneCycle.pushforward_cycle, cyclePushforwardOfPoint, dif_neg hnp]
    have h0 : (⟨_, pushforward_mem_relativeOneCycles (hΓ j)⟩ : relativeOneCycles sX h) = 0 :=
      Subtype.ext h0'
    have := hℓ ((Γ j).relativeClass (p ≫ h) (hΓ j))
    rw [hφΓ j, h0, map_zero, map_zero] at this
    linarith [(hbd j).1]
  let C : ι → ProperCurve sX := fun j => ⟨p (Γ j).point, hprop j⟩
  have hC : ∀ j, (C j).IsContractedBy h := fun j => isContractedBy_image (hΓ j) (hprop j)
  let d : ι → ℕ := fun j => residueFieldDegree p (Γ j).point
  have hφC : ∀ j, φ ((Γ j).relativeClass (p ≫ h) (hΓ j)) =
      (d j : ℝ) • (C j).relativeClass h (hC j) := by
    intro j
    have e1 : OneCycle.pushforward ℝ (p ≫ sX) sX p ((Γ j).cycle ℝ) =
        (d j : ℝ) • (C j).cycle ℝ := by
      rw [OneCycle.pushforward_cycle, cyclePushforwardOfPoint, dif_pos (hprop j)]
      simp [ProperCurve.cycle, C, d]
    rw [hφΓ j, ProperCurve.relativeClass, ← map_smul]
    congr 1
    exact Subtype.ext e1
  have hℓC : ∀ j, ℓW ((Γ j).relativeClass (p ≫ h) (hΓ j)) =
      (d j : ℝ) * ℓX ((C j).relativeClass h (hC j)) := by
    intro j
    rw [← hℓ, hφC j, map_smul, smul_eq_mul]
  have hhull : ∀ b ∈ PointedCone.hull ℝ
      (Set.range fun j => (Γ j).relativeClass (p ≫ h) (hΓ j)),
      φ b ∈ PointedCone.hull ℝ (Set.range fun j => (C j).relativeClass h (hC j)) := by
    intro b hb
    induction hb using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      rw [hφC j, ← Nonneg.mk_smul _ (Nat.cast_nonneg (d j))]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | smul a x _ hx =>
      rw [← Nonneg.coe_smul, map_smul, Nonneg.coe_smul]
      exact Submodule.smul_mem _ a hx
  refine ⟨ι, hι, C, hC, fun j => ?_, fun j => ?_, ?_⟩
  · -- the image of a rational curve is rational
    have hnc : ¬ (p.base '' ((Scheme.IdealSheafData.vanishingIdeal
        (Closeds.closure ({(Γ j).point} : Set W))).support : Set W)).Subsingleton := by
      intro hsub
      have hmem : ∀ x ∈ closure ({(Γ j).point} : Set W), x ∈ ((Scheme.IdealSheafData.vanishingIdeal
          (Closeds.closure ({(Γ j).point} : Set W))).support : Set W) := fun x hx => by
        rwa [Scheme.IdealSheafData.coe_support_vanishingIdeal]
      refine ProperCurve.not_isProperCurve_of_forall_eq p (Γ j) (y := p (Γ j).point)
        (fun z => ?_) (hprop j)
      rw [Scheme.Hom.comp_apply]
      exact hsub ⟨_, hmem _ (by rw [← (Γ j).range_ι]; exact ⟨z, rfl⟩), rfl⟩
        ⟨_, hmem _ (subset_closure rfl), rfl⟩
    have := IsRationalCurve.ker_subschemeι_comp (sY := sX) (f := p) rfl (hrat j) hnc
    rwa [show (Scheme.IdealSheafData.vanishingIdeal
        (Closeds.closure ({(Γ j).point} : Set W))).subschemeι ≫ p = (Γ j).ι ≫ p from rfl,
      ProperCurve.ker_comp] at this
  · -- the length bound, through `p_*[Γⱼ] = dⱼ [Cⱼ]`
    obtain ⟨h1, h2⟩ := hbd j
    rw [hℓC j] at h1 h2
    have hd0 : d j ≠ 0 := by
      rintro h0
      simp [h0] at h1
    have hd1 : (1 : ℝ) ≤ d j := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hd0
    have hpos : 0 < -ℓX ((C j).relativeClass h (hC j)) := by nlinarith
    refine ⟨hpos, ?_⟩
    push_cast at h2
    nlinarith
  · -- every curve class of `X` over `S` is a push-forward
    intro z hz
    rw [SetLike.mem_coe, ← hmap] at hz
    obtain ⟨w, hw, rfl⟩ := Submodule.mem_map.mp hz
    have hw' : w ∈ (relativeClosedConeOfCurves (p ≫ sX) (p ≫ h) : Set _) := subset_closure hw
    rw [heq] at hw'
    obtain ⟨a, ⟨haN, ha⟩, b, hb, rfl⟩ := hw'
    refine ⟨φ a, ⟨himg ⟨a, haN, rfl⟩, by rw [hℓ]; exact ha⟩, φ b, ?_, by
      simp only [LinearMap.restrictScalars_apply, map_add]⟩
    exact hhull b hb

/-! ### The cone theorem -/

/-- The `D`-negative rays meeting the region `D + εA < 0`, for an ample Cartier divisor `A`, are
among the rays of the curves `Cⱼ`. -/
private theorem finite_rays {X S : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    [MMP.Mori.IsProjectiveVariety ℂ sX] (h : X ⟶ S) {D : QDivisor X} (hD : D.IsQCartier)
    {ι : Type} (C : ι → ProperCurve sX) (hC : ∀ j, (C j).IsContractedBy h)
    (hpos : ∀ j, 0 < -QDivisor.relativeCurveForm sX h D hD ((C j).relativeClass h (hC j)))
    (hbd : ∀ j, -QDivisor.relativeCurveForm sX h D hD ((C j).relativeClass h (hC j)) ≤ 8)
    (hray : ∀ R, IsNegativeRelativeExtremalRayOf sX h D R →
      ∃ j, R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • (C j).relativeClass h (hC j) = w})
    (M : X.CartierDivisor) (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M))
    {ε : ℝ} (hε : 0 < ε) :
    {R : Set (RelativeNumericalCurveClasses sX h) | IsNegativeRelativeExtremalRayOf sX h D R ∧
      ∀ u ∈ R, u ≠ 0 → QDivisor.relativeCurveForm sX h D hD u +
        ε * RelativeNumericalCurveClasses.degree sX h
          (MMP.CartierDivisor.sheaf M) u < 0}.Finite := by
  set ℓ := QDivisor.relativeCurveForm sX h D hD
  set α := RelativeNumericalCurveClasses.degree sX h (MMP.CartierDivisor.sheaf M)
  have hF : {x | ∃ j, (C j).relativeClass h (hC j) = x ∧ ℓ x + ε * α x < 0}.Finite := by
    refine (finite_relativeClass_degree_le h M hM (8 / ε)).subset ?_
    rintro _ ⟨j, rfl, hj⟩
    refine ⟨C j, hC j, rfl, ?_⟩
    rw [le_div_iff₀ hε]
    nlinarith [hbd j]
  refine (hF.image fun x => {w | ∃ c : ℝ, 0 ≤ c ∧ c • x = w}).subset ?_
  rintro R ⟨hR, hneg⟩
  obtain ⟨j, hj⟩ := hray R hR
  have hjR : (C j).relativeClass h (hC j) ∈ R := by rw [hj]; exact ⟨1, zero_le_one, one_smul _ _⟩
  have hj0 : (C j).relativeClass h (hC j) ≠ 0 := by
    intro h0
    have := hpos j
    rw [h0, map_zero, neg_zero] at this
    exact lt_irrefl _ this
  exact ⟨_, ⟨j, rfl, hneg _ hjR hj0⟩, hj.symm⟩
private theorem exists_relativeClosedConeOfCurves_eq_add_hull_of_isLogCanonicalPair :
    ∀ {X S : Scheme.{0}} [inst : IsIntegral X] [inst_1 : CompactSpace X]
      [inst_2 : IsLocallyNoetherian X] [inst_3 : IsNormal X]
      {sX : X ⟶ Spec (.of ℂ)} [inst_4 : QuasiCompact sX] {sS : S ⟶ Spec (.of ℂ)}
      (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
      (h : X ⟶ S), h ≫ sS = sX → topologicalKrullDim X = 4 →
      ∀ {K : Divisor X}, K.IsCanonicalDivisor sX 4 →
      ∀ {B : QDivisor X}, MMP.Intersection.IsLogCanonicalPair sX B →
    ∃ hD : (Divisor.toQDivisor K + B).IsQCartier,
      (∀ R : Set (RelativeNumericalCurveClasses sX h),
        IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R →
          ∃ (C : ProperCurve sX) (hC : C.IsContractedBy h),
            IsRationalCurve sX
              (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) ∧
            R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • C.relativeClass h hC = w} ∧
            0 < -QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD
              (C.relativeClass h hC) ∧
            -QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD
              (C.relativeClass h hC) ≤ 8) ∧
      {R : Set (RelativeNumericalCurveClasses sX h) |
        IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R}.Countable ∧
      (relativeClosedConeOfCurves sX h : Set (RelativeNumericalCurveClasses sX h)) =
        {z | z ∈ relativeClosedConeOfCurves sX h ∧
          0 ≤ QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD z} +
        (PointedCone.hull ℝ (⋃₀ {R : Set (RelativeNumericalCurveClasses sX h) |
            IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R}) :
          Set (RelativeNumericalCurveClasses sX h)) ∧
      (∀ (A : Divisor X) (hA : A.IsCartier), A.IsAmple hA → ∀ ε : ℝ, 0 < ε →
        haveI := hA.isInvertibleModule_divisorialSheaf
        {R : Set (RelativeNumericalCurveClasses sX h) |
          IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R ∧
            ∀ u ∈ R, u ≠ 0 →
              QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD u +
                ε * RelativeNumericalCurveClasses.degree sX h A.divisorialSheaf u < 0}.Finite) ∧
      (∀ z : RelativeNumericalCurveClasses sX h,
        QDivisor.relativeCurveForm sX h (Divisor.toQDivisor K + B) hD z < 0 →
          ∃ U ∈ 𝓝 z, {R : Set (RelativeNumericalCurveClasses sX h) |
            IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R ∧
              (R ∩ U).Nonempty}.Finite) ∧
      (¬ QDivisor.IsRelativelyNef sX h (Divisor.toQDivisor K + B) →
        ∃ R : Set (RelativeNumericalCurveClasses sX h),
          IsNegativeRelativeExtremalRayOf sX h (Divisor.toQDivisor K + B) R) := by
  intro X S _ _ _ _ sX _ sS hX hS h hh hdim K hK B hB
  classical
  haveI : MMP.Mori.IsProjectiveVariety ℂ sX := hX
  haveI : MMP.Mori.IsProjectiveVariety ℂ sS := hS
  have hD : (Divisor.toQDivisor K + B).IsQCartier := by
    obtain ⟨⟨hXn, n', K', hK', hQ'⟩, -, -⟩ := hB
    exact hQ'.add_of_linearlyEquivalent
      (MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sX hXn hK' hK)
  refine ⟨hD, ?_⟩
  obtain ⟨ι, hι, C, hC, hrat, hbd, hdec⟩ := exists_curves_subset_add_hull hX hS h hh hdim hK hB hD
  set D := Divisor.toQDivisor K + B
  set ℓ := QDivisor.relativeCurveForm sX h D hD with hℓ_def
  set N := relativeClosedConeOfCurves sX h
  haveI : IsTopologicalAddGroup (RelativeNumericalCurveClasses sX h) :=
    topologicalAddGroup_iInf fun _ => topologicalAddGroup_iInf fun _ =>
      topologicalAddGroup_induced _
  haveI : ContinuousSMul ℝ (RelativeNumericalCurveClasses sX h) :=
    continuousSMul_iInf fun _ => continuousSMul_iInf fun _ => continuousSMul_induced _
  have hℓc : Continuous ℓ := continuous_relativeCurveForm sX h D hD
  set g : ι → RelativeNumericalCurveClasses sX h := fun j => (C j).relativeClass h (hC j)
  have hgN : ∀ j, g j ∈ N := fun j => by
    rw [← SetLike.mem_coe, coe_relativeClosedConeOfCurves]
    exact subset_closure (relativeClass_mem_relativeConeOfCurves (hC j))
  have hNcl : IsClosed (N : Set (RelativeNumericalCurveClasses sX h)) := by
    rw [coe_relativeClosedConeOfCurves]; exact isClosed_closure
  have hN₀ : (N : Set (RelativeNumericalCurveClasses sX h)) ⊆
      closure (relativeConeOfCurves sX h : Set _) := by
    rw [coe_relativeClosedConeOfCurves]
  -- for every ample `M` and `ε > 0`, `NE̅(X/S) ⊆ NE̅(X/S)_{D + εM ≥ 0} + hull F_ε`
  have key : ∀ (M : X.CartierDivisor)
      (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M)) (ε : ℝ),
      0 < ε → (N : Set (RelativeNumericalCurveClasses sX h)) ⊆
        {z | z ∈ N ∧ 0 ≤ ℓ z + ε * RelativeNumericalCurveClasses.degree sX h
          (MMP.CartierDivisor.sheaf M) z} +
        (PointedCone.hull ℝ {x | ∃ j, g j = x ∧ ℓ x + ε * RelativeNumericalCurveClasses.degree
          sX h (MMP.CartierDivisor.sheaf M) x < 0} : Set _) := by
    intro M hM ε hε
    refine subset_add_hull_of_finite hNcl hN₀ ℓ _ hℓc
      (RelativeNumericalCurveClasses.continuous_degree sX h _)
      (fun z hz => relativeDegree_nonneg hX h M hM hz) g hgN
      (fun j => relativeDegree_pos hX h M hM (C j) (hC j)) hdec hε ?_
    refine (finite_relativeClass_degree_le h M hM (8 / ε)).subset ?_
    rintro _ ⟨j, rfl, hj⟩
    refine ⟨C j, hC j, rfl, ?_⟩
    rw [le_div_iff₀ hε]
    nlinarith [(hbd j).2]
  obtain ⟨M₀, hM₀⟩ := exists_isAmple_cartierSheaf hX
  set α₀ := RelativeNumericalCurveClasses.degree sX h (MMP.CartierDivisor.sheaf M₀)
  have hα₀c : Continuous α₀ := RelativeNumericalCurveClasses.continuous_degree sX h _
  -- every negative extremal ray is spanned by one of the `Cⱼ`
  have hray : ∀ R, IsNegativeRelativeExtremalRayOf sX h D R →
      ∃ j, R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • g j = w} := by
    rintro R ⟨hD', hR, hneg⟩
    obtain ⟨-, v, hv0, hRv⟩ := id hR
    have hvR : v ∈ R := by rw [hRv]; exact ⟨1, zero_le_one, one_smul _ _⟩
    have hαv : 0 ≤ α₀ v := relativeDegree_nonneg hX h M₀ hM₀ (hR.1.1 hvR)
    have hℓv : ℓ v < 0 := hneg v hvR hv0
    set ε := -ℓ v / (α₀ v + 1)
    have hε : 0 < ε := div_pos (neg_pos.mpr hℓv) (by linarith)
    set μ : RelativeNumericalCurveClasses sX h →ₗ[ℝ] ℝ := ℓ + ε • α₀
    have hμv : μ v < 0 := by
      have e : μ v = ℓ v / (α₀ v + 1) := by
        simp only [μ, ε, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
        field_simp
        ring
      rw [e]
      exact div_neg_of_neg_of_pos hℓv (by linarith)
    obtain ⟨_, ⟨j, rfl, -⟩, hRj⟩ := exists_mem_eq_ray hR μ (neg_of_mem_ray μ hRv hvR hμv)
      (F := {x | ∃ j, g j = x ∧ ℓ x + ε * α₀ x < 0}) (by rintro _ ⟨j, rfl, -⟩; exact hgN j)
      (fun z hz => by
        obtain ⟨a, ha, b, hb, rfl⟩ := key M₀ hM₀ ε hε hz
        exact ⟨a, ⟨ha.1, by simpa [μ] using ha.2⟩, b, hb, rfl⟩)
    exact ⟨j, hRj⟩
  have hfin : ∀ (M : X.CartierDivisor)
      (hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M)) {ε : ℝ}, 0 < ε →
      {R : Set (RelativeNumericalCurveClasses sX h) | IsNegativeRelativeExtremalRayOf sX h D R ∧
        ∀ u ∈ R, u ≠ 0 → ℓ u + ε * RelativeNumericalCurveClasses.degree sX h
          (MMP.CartierDivisor.sheaf M) u < 0}.Finite :=
    fun M hM ε hε => finite_rays h hD C hC (fun j => (hbd j).1) (fun j => (hbd j).2) hray M hM hε
  refine ⟨fun R hR => ?_, ?_, ?_, fun A hA hAmp ε hε => ?_, fun z hz => ?_, fun hnn => ?_⟩
  · -- the rays
    obtain ⟨j, hj⟩ := hray R hR
    exact ⟨C j, hC j, hrat j, hj, hbd j⟩
  · -- countability
    refine (Set.countable_range fun j => {w | ∃ c : ℝ, 0 ≤ c ∧ c • g j = w}).mono ?_
    intro R hR
    obtain ⟨j, hj⟩ := hray R hR
    exact ⟨j, hj.symm⟩
  · -- the cone formula, from the decomposition into extremal rays
    apply Set.Subset.antisymm
    · intro z hz
      obtain ⟨s, Rs, w, hRw, rfl⟩ :=
        exists_sum_mem_isExtremalRay_relativeClosedConeOfCurves sX sS h hh hz
      have hsplit := Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun i => IsNegativeRelativeExtremalRayOf sX h D (Rs i)) w
      rw [← hsplit]
      refine Set.mem_add.mpr ⟨∑ i ∈ Finset.univ.filter
          (fun i => ¬ IsNegativeRelativeExtremalRayOf sX h D (Rs i)), w i, ?_,
        ∑ i ∈ Finset.univ.filter (fun i => IsNegativeRelativeExtremalRayOf sX h D (Rs i)), w i,
        ?_, add_comm _ _⟩
      swap
      · exact Submodule.sum_mem _ fun i hi => Submodule.subset_span
          (Set.mem_sUnion_of_mem (hRw i).2 (Finset.mem_filter.mp hi).2)
      refine ⟨Submodule.sum_mem _ fun i _ => (hRw i).1.1.1 (hRw i).2, ?_⟩
      rw [map_sum]
      refine Finset.sum_nonneg fun i hi => ?_
      by_contra hlt
      obtain ⟨-, v, -, hRv⟩ := (hRw i).1
      exact (Finset.mem_filter.mp hi).2
        ⟨hD, (hRw i).1, neg_of_mem_ray ℓ hRv (hRw i).2 (not_le.mp hlt)⟩
    · rintro _ ⟨a, ha, b, hb, rfl⟩
      refine N.add_mem ha.1 ?_
      refine (Submodule.span_le.mpr ?_ : PointedCone.hull ℝ _ ≤ N) hb
      rintro x ⟨R, ⟨-, hR, -⟩, hx⟩
      exact hR.1.1 hx
  · -- finiteness in each region `D + εA < 0`
    haveI := hA.isInvertibleModule_divisorialSheaf
    obtain ⟨M, ⟨e⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf A.divisorialSheaf
    have hM : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf M) :=
      (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mp hAmp
    have hdeg := relativeDegree_eq_of_iso (sX := sX) h e
    simp only [hdeg]
    exact hfin M hM hε
  · -- local finiteness in `D < 0`
    set ε := -ℓ z / (|α₀ z| + 1)
    have hε : 0 < ε := div_pos (neg_pos.mpr hz) (by positivity)
    have hεz : ℓ z + ε * α₀ z < 0 := by
      have h1 : ε * α₀ z ≤ ε * |α₀ z| := mul_le_mul_of_nonneg_left (le_abs_self _) hε.le
      have h2 : ε * |α₀ z| < -ℓ z := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
        nlinarith [abs_nonneg (α₀ z), neg_pos.mpr hz]
      linarith
    set U := {y : RelativeNumericalCurveClasses sX h | ℓ y + ε * α₀ y < 0}
    have hU : IsOpen U := isOpen_lt (hℓc.add (continuous_const.mul hα₀c)) continuous_const
    refine ⟨U, hU.mem_nhds hεz, (hfin M₀ hM₀ hε).subset ?_⟩
    rintro R ⟨hR, y, hyR, hyU⟩
    obtain ⟨j, hj⟩ := hray R hR
    refine ⟨hR, neg_of_mem_ray (ℓ + ε • α₀) hj hyR ?_⟩
    have hyU' : ℓ y + ε * α₀ y < 0 := hyU
    simpa using hyU'
  · -- a non-nef adjoint has a negative ray
    by_contra hno
    simp only [not_exists] at hno
    apply hnn
    refine isRelativelyNef_of_forall h D hD fun Γ hΓ => ?_
    have hΓN : Γ.relativeClass h hΓ ∈ N := by
      rw [← SetLike.mem_coe, coe_relativeClosedConeOfCurves]
      exact subset_closure (relativeClass_mem_relativeConeOfCurves hΓ)
    have e := relativeCurveForm_relativeClass h D hD Γ hΓ
    by_contra hlt
    have hlt' : ℓ (Γ.relativeClass h hΓ) < 0 := by
      rw [e]; exact_mod_cast not_le.mp hlt
    obtain ⟨s, Rs, w, hRw, hsum⟩ :=
      exists_sum_mem_isExtremalRay_relativeClosedConeOfCurves sX sS h hh hΓN
    rw [hsum, map_sum] at hlt'
    obtain ⟨i, -, hi⟩ := Finset.exists_lt_of_sum_lt (by simpa using hlt' :
      ∑ i, ℓ (w i) < ∑ i : Fin s, (0 : ℝ))
    obtain ⟨-, v, -, hRv⟩ := (hRw i).1
    exact hno (Rs i) ⟨hD, (hRw i).1, neg_of_mem_ray ℓ hRv (hRw i).2 hi⟩

end Proof_lem_fourfold_real_floor_program_below_one.LcCone

/-! ## A positive gap for the rational curves of a fixed lc polytope -/

open AlgebraicGeometry CategoryTheory TopologicalSpace MMP.Mori MMP.Fourfold
open scoped TensorProduct

namespace Proof_lem_fourfold_real_floor_program_below_one.PositiveGap

section Pairing

variable {X Z : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] (f : X ⟶ Z)

/-- The degree of `𝒪_X(M + N)` on a relative class is the sum of the degrees. -/
private theorem degree_divisorialSheaf_add (M N : Divisor X) (hM : M.IsCartier)
    (hN : N.IsCartier) (z : RelativeNumericalCurveClasses sX f) :
    (haveI := (hM.add hN).isInvertibleModule_divisorialSheaf;
        RelativeNumericalCurveClasses.degree sX f (M + N).divisorialSheaf z) =
      (haveI := hM.isInvertibleModule_divisorialSheaf;
        RelativeNumericalCurveClasses.degree sX f M.divisorialSheaf z) +
      (haveI := hN.isInvertibleModule_divisorialSheaf;
        RelativeNumericalCurveClasses.degree sX f N.divisorialSheaf z) := by
  obtain ⟨Zc, rfl⟩ := relativeNumericalClass_surjective sX f z
  simp only [RelativeNumericalCurveClasses.degree_relativeNumericalClass, OneCycle.degree_apply]
  rw [← Finsupp.sum_add]
  refine Finsupp.sum_congr fun C _ => ?_
  have h := Divisor.degreeOn_add ℂ sX C.ι C.dim_le M N hM hN
  have e1 : ∀ (D : Divisor X) (hD : D.IsCartier),
      (haveI := hD.isInvertibleModule_divisorialSheaf; C.degree ℂ D.divisorialSheaf) =
        D.degreeOn ℂ sX C.ι C.dim_le hD := fun D hD => rfl
  rw [e1 _ (hM.add hN), e1 _ hM, e1 _ hN, h]
  push_cast
  ring
/-- `M ↦ (z · 𝒪_X(M))` as an additive map on Cartier divisors. -/
private noncomputable def cartierDegree (z : RelativeNumericalCurveClasses sX f) :
    Divisor.cartierSubgroup (X := X) →+ ℝ :=
  AddMonoidHom.mk' (fun M =>
    haveI := (Divisor.mem_cartierSubgroup.mp M.2).isInvertibleModule_divisorialSheaf
    RelativeNumericalCurveClasses.degree sX f (M : Divisor X).divisorialSheaf z)
    fun M N => degree_divisorialSheaf_add f _ _ (Divisor.mem_cartierSubgroup.mp M.2)
      (Divisor.mem_cartierSubgroup.mp N.2) z
/-- The extension `Ca(X) ⊗ ℝ → ℝ` of `cartierDegree`. -/
private noncomputable def tensorDegree (z : RelativeNumericalCurveClasses sX f) :
    Divisor.cartierSubgroup (X := X) ⊗[ℤ] ℝ →+ ℝ :=
  TensorProduct.liftAddHom (AddMonoidHom.mul.comp (cartierDegree f z))
    fun n M r => by simp [mul_assoc, mul_left_comm]
private theorem tensorDegree_tmul (z : RelativeNumericalCurveClasses sX f)
    (M : Divisor.cartierSubgroup (X := X)) (r : ℝ) :
    tensorDegree f z (M ⊗ₜ r) = cartierDegree f z M * r := by
  simp [tensorDegree]
/-- The degree `(z · 𝒪_X(M))` of a Cartier divisor `M` on a relative class `z`. -/
private noncomputable def degreeOf (z : RelativeNumericalCurveClasses sX f) (M : Divisor X)
    (hM : M.IsCartier) : ℝ :=
  haveI := hM.isInvertibleModule_divisorialSheaf
  RelativeNumericalCurveClasses.degree sX f M.divisorialSheaf z
private theorem degreeOf_smul (μ : ℝ) (z : RelativeNumericalCurveClasses sX f) (M : Divisor X)
    (hM : M.IsCartier) : degreeOf f (μ • z) M hM = μ * degreeOf f z M hM := by
  haveI := hM.isInvertibleModule_divisorialSheaf
  simp only [degreeOf, map_smul, smul_eq_mul]
/-- **Independence of the presentation.** Two presentations of the same `ℝ`-divisor by Cartier
divisors give the same degree on every relative class. -/
private theorem sum_mul_degree_eq_of_sum_smul_eq {α β : Type*} [Fintype α] [Fintype β]
    (z : RelativeNumericalCurveClasses sX f) (c : α → ℝ) (M : α → Divisor X)
    (hM : ∀ a, (M a).IsCartier) (c' : β → ℝ) (M' : β → Divisor X) (hM' : ∀ b, (M' b).IsCartier)
    (h : ∑ a, c a • Divisor.toRDivisor (M a) = ∑ b, c' b • Divisor.toRDivisor (M' b)) :
    ∑ a, c a * degreeOf f z (M a) (hM a) = ∑ b, c' b * degreeOf f z (M' b) (hM' b) := by
  have ht : ∑ a, (⟨M a, Divisor.mem_cartierSubgroup.mpr (hM a)⟩ :
      Divisor.cartierSubgroup (X := X)) ⊗ₜ[ℤ] c a =
      ∑ b, (⟨M' b, Divisor.mem_cartierSubgroup.mpr (hM' b)⟩ :
        Divisor.cartierSubgroup (X := X)) ⊗ₜ[ℤ] c' b := by
    apply MMP.Flips.rDivisorTensorMap_cartierSubgroup_injective
    simpa only [map_sum, MMP.Flips.rDivisorTensorMap_tmul, AddSubgroup.coe_subtype] using h
  have := congrArg (tensorDegree f z) ht
  simp only [map_sum, tensorDegree_tmul] at this
  calc _ = ∑ a, cartierDegree f z ⟨M a, Divisor.mem_cartierSubgroup.mpr (hM a)⟩ * c a :=
        Finset.sum_congr rfl fun a _ => mul_comm _ _
    _ = _ := this
    _ = _ := Finset.sum_congr rfl fun b _ => mul_comm _ _
/-- The degree of `𝒪_X(M)` on the class of a contracted curve is an integer. -/
private theorem degree_relativeClass (L : ProperCurve sX) (hL : L.IsContractedBy f)
    (M : Divisor X) (hM : M.IsCartier) :
    (haveI := hM.isInvertibleModule_divisorialSheaf;
        RelativeNumericalCurveClasses.degree sX f M.divisorialSheaf (L.relativeClass f hL)) =
      (M.degreeOn ℂ sX L.ι L.dim_le hM : ℝ) := by
  haveI := hM.isInvertibleModule_divisorialSheaf
  rw [ProperCurve.relativeClass, RelativeNumericalCurveClasses.degree_relativeNumericalClass]
  exact OneCycle.degree_cycle ℝ _ L
/-- The form `relativeCurveForm` of a `ℚ`-Cartier `ℚ`-divisor `D` is `1 / m_D` times the degree
of `𝒪_X(m_D D)`. -/
private theorem relativeCurveForm_apply (D : QDivisor X) (hD : D.IsQCartier)
    (z : RelativeNumericalCurveClasses sX f) :
    QDivisor.relativeCurveForm sX f D hD z =
      (1 / (D.cartierIndex hD : ℝ)) * cartierDegree f z (D.cartierIndexSMul hD) := by
  rw [QDivisor.relativeCurveForm, QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier,
    Finsupp.smul_single, smul_eq_mul, mul_one, Finsupp.sum_single_index]
  · rw [LinearMap.smul_apply, smul_eq_mul]
    push_cast
    rfl
  · simp

end Pairing

/-- `D₀ + ∑ wₐ Dₐ = ∑ wₐ (D₀ + Dₐ)` when `∑ wₐ = 1`. -/
private theorem add_sum_smul_eq {E : Type*} [AddCommGroup E] [Module ℝ E] {α : Type*}
    [Fintype α] (w : α → ℝ) (hw : ∑ a, w a = 1) (D₀ : E) (D : α → E) :
    D₀ + ∑ a, w a • D a = ∑ a, w a • (D₀ + D a) := by
  simp only [smul_add, Finset.sum_add_distrib, ← Finset.sum_smul, hw, one_smul]
/-- `D = (1 / m_D) • (m_D D)` as `ℝ`-divisors. -/
private theorem toRDivisor_eq_smul_cartierIndexSMul {X : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] (D : QDivisor X) (hD : D.IsQCartier) :
    QDivisor.toRDivisor D =
      (1 / (D.cartierIndex hD : ℝ)) • Divisor.toRDivisor (D.cartierIndexSMul hD : Divisor X) := by
  have hm : (D.cartierIndex hD : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (QDivisor.cartierIndex_pos hD).ne'
  rw [← QDivisor.toRDivisor_toQDivisor, QDivisor.toQDivisor_cartierIndexSMul, map_zsmul,
    ← Int.cast_smul_eq_zsmul ℝ, smul_smul]
  push_cast
  rw [one_div_mul_cancel hm, one_smul]
/-- **The arithmetic gap.** For positive weights `r j` and positive integers `m j`, the positive
values of `∑ r j * x j` over the tuples with `x j ≥ b` and `m j * x j ∈ ℤ` are bounded below by a
positive constant. -/
private theorem exists_pos_le_sum_mul {κ : Type*} [Fintype κ] (r : κ → ℝ) (hr : ∀ j, 0 < r j)
    (m : κ → ℕ) (hm : ∀ j, 0 < m j) (b : ℝ) :
    ∃ τ : ℝ, 0 < τ ∧ ∀ x : κ → ℝ, (∀ j, b ≤ x j) → (∀ j, ∃ n : ℤ, (m j : ℝ) * x j = n) →
      0 < ∑ j, r j * x j → τ ≤ ∑ j, r j * x j := by
  classical
  set A : ℝ := 1 + |b| * ∑ k, r k
  have hbound : ∀ x : κ → ℝ, (∀ j, b ≤ x j) → ∑ j, r j * x j < 1 → ∀ j, x j ≤ A / r j := by
    intro x hb hs j
    rw [le_div_iff₀ (hr j)]
    have hsplit := Finset.add_sum_erase Finset.univ (fun k => r k * x k) (Finset.mem_univ j)
    have h1 := Finset.add_sum_erase Finset.univ (fun k => r k * (-|b|)) (Finset.mem_univ j)
    have h2 : ∑ k ∈ Finset.univ.erase j, r k * (-|b|) ≤ ∑ k ∈ Finset.univ.erase j, r k * x k :=
      Finset.sum_le_sum fun k _ =>
        mul_le_mul_of_nonneg_left ((neg_abs_le b).trans (hb k)) (hr k).le
    have h3 : ∑ k, r k * (-|b|) = -(|b| * ∑ k, r k) := by rw [← Finset.sum_mul]; ring
    have h4 : r j * (-|b|) ≤ 0 := by nlinarith [abs_nonneg b, hr j]
    linarith
  let F : κ → Set ℝ := fun j => {y | b ≤ y ∧ y ≤ A / r j ∧ ∃ n : ℤ, (m j : ℝ) * y = n}
  have hF : ∀ j, (F j).Finite := by
    intro j
    have hmj : (0 : ℝ) < m j := by exact_mod_cast hm j
    refine ((Set.finite_Icc (⌊b * m j⌋) (⌈A / r j * m j⌉)).image
      (fun n : ℤ => (n : ℝ) / m j)).subset ?_
    rintro y ⟨hby, hyA, n, hn⟩
    refine ⟨n, ⟨?_, ?_⟩, ?_⟩
    · have : b * m j ≤ (n : ℝ) := by rw [← hn]; nlinarith
      exact (Int.floor_mono this).trans (Int.floor_intCast n).le
    · have : (n : ℝ) ≤ A / r j * m j := by rw [← hn]; nlinarith
      exact (Int.ceil_intCast n).symm.le.trans (Int.ceil_mono this)
    · simp only
      rw [← hn]
      field_simp
  have hT : (Set.univ.pi F).Finite := Set.Finite.pi hF
  let S : Set ℝ := ((fun x : κ → ℝ => ∑ j, r j * x j) '' Set.univ.pi F) ∩ Set.Ioi 0
  have hS : S.Finite := (hT.image _).inter_of_left _
  have hmem : ∀ x : κ → ℝ, (∀ j, b ≤ x j) → (∀ j, ∃ n : ℤ, (m j : ℝ) * x j = n) →
      0 < ∑ j, r j * x j → ∑ j, r j * x j < 1 → ∑ j, r j * x j ∈ S :=
    fun x hb hn hpos h1 =>
      ⟨⟨x, fun j _ => ⟨hb j, hbound x hb h1 j, hn j⟩, rfl⟩, hpos⟩
  by_cases hne : S.Nonempty
  · obtain ⟨s0, hs0, hmin⟩ := Set.exists_min_image S id hS hne
    refine ⟨min 1 s0, lt_min one_pos hs0.2, fun x hb hn hpos => ?_⟩
    by_cases h1 : 1 ≤ ∑ j, r j * x j
    · exact (min_le_left _ _).trans h1
    · exact (min_le_right _ _).trans (hmin _ (hmem x hb hn hpos (not_le.mp h1)))
  · refine ⟨1, one_pos, fun x hb hn hpos => ?_⟩
    by_contra h1
    exact hne ⟨_, hmem x hb hn hpos (not_le.mp h1)⟩
/-- **The uniform curve along a ray.** Let `g i` be the values of finitely many forms on a
generator of a ray, some negative, and let each negative form `i` come with a positive multiple
`μ i` of the generator on which it is at least `b ≤ 0`. Then the least multiple `μ i₀` makes
every form at least `b`. -/
private theorem exists_forall_le_mul_of_min {ι : Type*} [Fintype ι] (g : ι → ℝ)
    (hg : ∃ i, g i < 0) (μ : ∀ i, g i < 0 → ℝ) (hμ : ∀ i hi, 0 < μ i hi) {b : ℝ} (hb : b ≤ 0)
    (hle : ∀ i hi, b ≤ μ i hi * g i) : ∃ i₀ hi₀, ∀ i, b ≤ μ i₀ hi₀ * g i := by
  classical
  obtain ⟨i₁, hi₁⟩ := hg
  obtain ⟨i₀, hi₀N, hmin⟩ := (Finset.univ.filter fun i => g i < 0).exists_min_image
    (fun i => if h : g i < 0 then μ i h else 0) ⟨i₁, by simp [hi₁]⟩
  have hi₀ : g i₀ < 0 := (Finset.mem_filter.mp hi₀N).2
  refine ⟨i₀, hi₀, fun i => ?_⟩
  by_cases hi : g i < 0
  · have : μ i₀ hi₀ ≤ μ i hi := by simpa [hi, hi₀] using hmin i (by simp [hi])
    nlinarith [hle i hi]
  · nlinarith [hμ i₀ hi₀, not_lt.mp hi]
private theorem exists_pos_forall_isExtremalRay_exists_isRationalCurve_neg_eight_le :
    ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {f : X ⟶ Z} (hf : f ≫ sZ = sX)
    (hXq : IsQFactorial sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 4)
    {ι : Type*} [Fintype ι] {V : ι → QDivisor X} (hV0 : ∀ i P, 0 ≤ (V i).coeff P)
    (hV : ∀ i, MMP.Intersection.IsLogCanonicalPair sX (V i))
    {B : RDivisor X}
    (hBP : B ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)))
    {κ : Type*} [Fintype κ] {r : κ → ℝ} (hr : ∀ j, 0 < r j) (hr1 : ∑ j, r j = 1)
    {Bj : κ → QDivisor X}
    (hBjP : ∀ j, QDivisor.toRDivisor (Bj j) ∈
      convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)))
    (hBjlc : ∀ j, MMP.Intersection.IsLogCanonicalPair sX (Bj j))
    (hBeq : B = ∑ j, r j • QDivisor.toRDivisor (Bj j)),
    ∃ τ : ℝ, 0 < τ ∧
      ∀ R : Set (RelativeNumericalCurveClasses sX f),
        IsExtremalRay ℝ
          (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) R →
        (∃ B' ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)),
          ∃ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
            Divisor.toRDivisor K + B' = ∑ i, c i • Divisor.toRDivisor (M i) ∧
            ∀ u ∈ R, u ≠ 0 →
              ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
                RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) < 0) →
        ∃ (L : ProperCurve sX) (hL : L.IsContractedBy f),
          IsRationalCurve sX
            (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({L.point} : Set X))) ∧
          L.relativeClass f hL ∈ R ∧ L.relativeClass f hL ≠ 0 ∧
          (∀ B' ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)),
            ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
              Divisor.toRDivisor K + B' = ∑ i, c i • Divisor.toRDivisor (M i) →
              -8 ≤ ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
                RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf
                  (L.relativeClass f hL))) ∧
          ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
            Divisor.toRDivisor K + B = ∑ i, c i • Divisor.toRDivisor (M i) →
            0 < ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
                RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf
                  (L.relativeClass f hL)) →
            τ ≤ ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
                RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf
                  (L.relativeClass f hL)) := by
  intro X Z _ _ _ _ sX sZ hX hZ f hf _hXq K hK ι _ V _hV0 hV B _hBP κ _ r hr hr1 Bj hBjP
    hBjlc hBeq
  haveI : QuasiCompact sX := inferInstance
  have hdim : topologicalKrullDim X = 4 := by exact_mod_cast hK.1
  have cone := fun (D : QDivisor X) (hD : MMP.Intersection.IsLogCanonicalPair sX D) =>
    LcCone.exists_relativeClosedConeOfCurves_eq_add_hull_of_isLogCanonicalPair hX hZ f hf hdim hK hD
  choose hDV hconeV using fun i => cone (V i) (hV i)
  choose hDB _ using fun j => cone (Bj j) (hBjlc j)
  -- the Cartier multiples `m (K + V i)` and `m (K + Bj j)`
  let mV : ι → ℕ := fun i => (Divisor.toQDivisor K + V i).cartierIndex (hDV i)
  let EV : ι → Divisor X := fun i =>
    ((Divisor.toQDivisor K + V i).cartierIndexSMul (hDV i) : Divisor X)
  have hEV : ∀ i, (EV i).IsCartier := fun i =>
    Divisor.mem_cartierSubgroup.mp ((Divisor.toQDivisor K + V i).cartierIndexSMul (hDV i)).2
  have hpresV : ∀ i, Divisor.toRDivisor K + QDivisor.toRDivisor (V i) =
      (1 / (mV i : ℝ)) • Divisor.toRDivisor (EV i) := fun i => by
    rw [← toRDivisor_eq_smul_cartierIndexSMul, map_add, QDivisor.toRDivisor_toQDivisor]
  let mB : κ → ℕ := fun j => (Divisor.toQDivisor K + Bj j).cartierIndex (hDB j)
  have hmB : ∀ j, 0 < mB j := fun j => QDivisor.cartierIndex_pos _
  let EB : κ → Divisor X := fun j =>
    ((Divisor.toQDivisor K + Bj j).cartierIndexSMul (hDB j) : Divisor X)
  have hEB : ∀ j, (EB j).IsCartier := fun j =>
    Divisor.mem_cartierSubgroup.mp ((Divisor.toQDivisor K + Bj j).cartierIndexSMul (hDB j)).2
  have hpresB : ∀ j, Divisor.toRDivisor K + QDivisor.toRDivisor (Bj j) =
      (1 / (mB j : ℝ)) • Divisor.toRDivisor (EB j) := fun j => by
    rw [← toRDivisor_eq_smul_cartierIndexSMul, map_add, QDivisor.toRDivisor_toQDivisor]
  -- the forms `(K + V i) · z`
  let G : ι → RelativeNumericalCurveClasses sX f → ℝ := fun i z =>
    1 / (mV i : ℝ) * degreeOf f z (EV i) (hEV i)
  have hGsmul : ∀ i (μ : ℝ) z, G i (μ • z) = μ * G i z := fun i μ z => by
    simp only [G, degreeOf_smul]; ring
  have hGrel : ∀ i z, QDivisor.relativeCurveForm sX f (Divisor.toQDivisor K + V i) (hDV i) z =
      G i z := fun i z => relativeCurveForm_apply f _ _ z
  -- the pairing with `K + B'` for `B' ∈ P` is a convex combination of the forms `G i`
  have hval : ∀ B' ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)),
      ∃ (α : Type) (_ : Fintype α) (w : α → ℝ) (g : α → ι), (∀ a, 0 ≤ w a) ∧ ∑ a, w a = 1 ∧
        ∀ (β : Type) [Fintype β] (c : β → ℝ) (M : β → Divisor X) (hM : ∀ b, (M b).IsCartier),
          Divisor.toRDivisor K + B' = ∑ b, c b • Divisor.toRDivisor (M b) →
          ∀ z, ∑ b, c b * degreeOf f z (M b) (hM b) = ∑ a, w a * G (g a) z := by
    intro B' hB'
    obtain ⟨α, _, w, zz, hw0, hw1, hzz, hsum⟩ := mem_convexHull_iff_exists_fintype.mp hB'
    choose g hg using hzz
    refine ⟨α, inferInstance, w, g, hw0, hw1, fun β _ c M hM hpres z => ?_⟩
    have hrepr : Divisor.toRDivisor K + B' =
        ∑ a, (w a / mV (g a)) • Divisor.toRDivisor (EV (g a)) := by
      rw [← hsum, add_sum_smul_eq w hw1]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← hg a, hpresV, smul_smul]
      congr 1
      ring
    rw [sum_mul_degree_eq_of_sum_smul_eq f z c M hM _ _ (fun a => hEV (g a))
      (hpres.symm.trans hrepr)]
    refine Finset.sum_congr rfl fun a _ => ?_
    simp only [G]
    ring
  obtain ⟨τ, hτ, hgap⟩ := exists_pos_le_sum_mul r hr mB hmB (-8)
  refine ⟨τ, hτ, fun R hR hneg => ?_⟩
  obtain ⟨-, v, hv0, hRv⟩ := id hR
  have hvR : v ∈ R := hRv ▸ ⟨1, zero_le_one, one_smul _ _⟩
  -- a vertex negative on `R`
  obtain ⟨B', hB', n, c, M, hM, hpres, hnegB⟩ := hneg
  obtain ⟨α, _, w, g, hw0, hw1, hpair⟩ := hval B' hB'
  have hsumneg : ∑ a, w a * G (g a) v < 0 := by
    rw [← hpair (Fin n) c M hM hpres v]
    exact hnegB v hvR hv0
  have hex : ∃ i, G i v < 0 := by
    by_contra hcon
    simp only [not_exists, not_lt] at hcon
    exact absurd hsumneg (not_lt.mpr (Finset.sum_nonneg fun a _ => mul_nonneg (hw0 a) (hcon _)))
  -- the cone theorem on each negative vertex
  have hcurve : ∀ i, G i v < 0 → ∃ (C : ProperCurve sX) (hC : C.IsContractedBy f),
      IsRationalCurve sX
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) ∧
      (∃ μ : ℝ, 0 < μ ∧ C.relativeClass f hC = μ • v) ∧ -8 ≤ G i (C.relativeClass f hC) := by
    intro i hi
    have hnegray : IsNegativeRelativeExtremalRayOf sX f (Divisor.toQDivisor K + V i) R := by
      refine ⟨hDV i, hR, fun u hu hu0 => ?_⟩
      rw [hRv] at hu
      obtain ⟨μ, hμ, rfl⟩ := hu
      have hμ0 : μ ≠ 0 := by rintro rfl; exact hu0 (zero_smul _ _)
      rw [hGrel, hGsmul]
      exact mul_neg_of_pos_of_neg (lt_of_le_of_ne hμ (Ne.symm hμ0)) hi
    obtain ⟨C, hC, hrat, hRC, hpos, hle⟩ := (hconeV i).1 R hnegray
    have hCR : C.relativeClass f hC ∈ R := hRC ▸ ⟨1, zero_le_one, one_smul _ _⟩
    rw [hRv] at hCR
    obtain ⟨μ, hμ, hμv⟩ := hCR
    refine ⟨C, hC, hrat, ⟨μ, lt_of_le_of_ne hμ ?_, hμv.symm⟩, ?_⟩
    · rintro rfl
      rw [zero_smul] at hμv
      rw [← hμv, map_zero, neg_zero] at hpos
      exact lt_irrefl _ hpos
    · rw [← hGrel]
      linarith
  choose C hC hrat hμ hle using hcurve
  choose μ hμpos hμv using hμ
  obtain ⟨i₀, hi₀, hvert⟩ := exists_forall_le_mul_of_min (fun i => G i v) hex μ hμpos
    (b := -8) (by norm_num) fun i hi => by simpa [hμv, hGsmul] using hle i hi
  have hLv : (C i₀ hi₀).relativeClass f (hC i₀ hi₀) = μ i₀ hi₀ • v := hμv i₀ hi₀
  replace hvert : ∀ i, -8 ≤ G i ((C i₀ hi₀).relativeClass f (hC i₀ hi₀)) := fun i => by
    rw [hLv, hGsmul]; exact hvert i
  have hlow : ∀ B' ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)),
      ∀ (β : Type) [Fintype β] (c : β → ℝ) (M : β → Divisor X) (hM : ∀ b, (M b).IsCartier),
        Divisor.toRDivisor K + B' = ∑ b, c b • Divisor.toRDivisor (M b) →
        -8 ≤ ∑ b, c b * degreeOf f ((C i₀ hi₀).relativeClass f (hC i₀ hi₀)) (M b) (hM b) := by
    intro B' hB' β _ c M hM hpres
    obtain ⟨α, _, w, g, hw0, hw1, hpair⟩ := hval B' hB'
    rw [hpair β c M hM hpres]
    calc (-8 : ℝ) = ∑ a, w a * (-8) := by rw [← Finset.sum_mul, hw1]; ring
      _ ≤ _ := Finset.sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hvert (g a)) (hw0 a)
  refine ⟨C i₀ hi₀, hC i₀ hi₀, hrat i₀ hi₀, ?_, ?_,
    fun B' hB' n c M hM hpres => hlow B' hB' (Fin n) c M hM hpres, ?_⟩
  · rw [hLv, hRv]
    exact ⟨_, (hμpos i₀ hi₀).le, rfl⟩
  · rw [hLv]
    exact smul_ne_zero (hμpos i₀ hi₀).ne' hv0
  · intro n c M hM hpres hpos
    set z := (C i₀ hi₀).relativeClass f (hC i₀ hi₀)
    let x : κ → ℝ := fun j => 1 / (mB j : ℝ) * degreeOf f z (EB j) (hEB j)
    have hrepr : Divisor.toRDivisor K + B = ∑ j, (r j / mB j) • Divisor.toRDivisor (EB j) := by
      rw [hBeq, add_sum_smul_eq r hr1]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hpresB, smul_smul]
      congr 1
      ring
    have hx : ∑ i, c i * degreeOf f z (M i) (hM i) = ∑ j, r j * x j := by
      rw [sum_mul_degree_eq_of_sum_smul_eq f z c M hM _ _ hEB (hpres.symm.trans hrepr)]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [x]
      ring
    have hxb : ∀ j, -8 ≤ x j := fun j => by
      have := hlow _ (hBjP j) Unit (fun _ => 1 / (mB j : ℝ)) (fun _ => EB j) (fun _ => hEB j)
        (by simpa using hpresB j)
      simpa [x] using this
    have hxint : ∀ j, ∃ k : ℤ, (mB j : ℝ) * x j = k := fun j => by
      refine ⟨(EB j).degreeOn ℂ sX (C i₀ hi₀).ι (C i₀ hi₀).dim_le (hEB j), ?_⟩
      have hm : (mB j : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (hmB j).ne'
      simp only [x, degreeOf]
      rw [degree_relativeClass f (C i₀ hi₀) (hC i₀ hi₀) (EB j) (hEB j)]
      field_simp
    have hpos' : 0 < ∑ j, r j * x j := by rw [← hx]; exact hpos
    exact (hgap x hxb hxint hpos').trans_eq hx.symm

end Proof_lem_fourfold_real_floor_program_below_one.PositiveGap

/-! ## Radial null rays of a real lc nef adjoint -/

universe u

open AlgebraicGeometry CategoryTheory TopologicalSpace Filter Topology MMP.Mori MMP.Fourfold

namespace Proof_lem_fourfold_real_floor_program_below_one.RadialNullRay

section ErasedIntegral

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

section Pairing

open MMP.Flips

variable {k : Type} [Field k] {X Z : Scheme.{0}} {sX : X ⟶ Spec (.of k)} (f : X ⟶ Z)

/-- Linear forms on `N₁(X/Z)` which agree on the classes of the contracted curves are equal. -/
private theorem linearMap_ext_relativeClass
    {φ ψ : RelativeNumericalCurveClasses sX f →ₗ[ℝ] ℝ}
    (h : ∀ (C : ProperCurve sX) (hC : C.IsContractedBy f),
      φ (C.relativeClass f hC) = ψ (C.relativeClass f hC)) : φ = ψ := by
  have hsp : relativeOneCycles sX f = Submodule.span ℝ
      ((fun C => Finsupp.single C (1 : ℝ)) '' {C : ProperCurve sX | C.IsContractedBy f}) := by
    rw [relativeOneCycles, Finsupp.supported_eq_span_single]
  have key : ∀ (x : OneCycle ℝ sX) (hx : x ∈ Submodule.span ℝ
      ((fun C => Finsupp.single C (1 : ℝ)) '' {C : ProperCurve sX | C.IsContractedBy f})),
      φ (relativeNumericalClass sX f ⟨x, hsp ▸ hx⟩) =
        ψ (relativeNumericalClass sX f ⟨x, hsp ▸ hx⟩) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨C, hC, rfl⟩ := hx
      exact h C hC
    | zero =>
      have : (⟨0, hsp ▸ Submodule.zero_mem _⟩ : relativeOneCycles sX f) = 0 := rfl
      rw [this, map_zero, map_zero, map_zero]
    | add x y hx hy ihx ihy =>
      have : (⟨x + y, hsp ▸ Submodule.add_mem _ hx hy⟩ : relativeOneCycles sX f) =
          ⟨x, hsp ▸ hx⟩ + ⟨y, hsp ▸ hy⟩ := rfl
      rw [this, map_add, map_add, map_add, ihx, ihy]
    | smul c x hx ih =>
      have : (⟨c • x, hsp ▸ Submodule.smul_mem _ c hx⟩ : relativeOneCycles sX f) =
          c • ⟨x, hsp ▸ hx⟩ := rfl
      rw [this, map_smul, map_smul, map_smul, ih]
  refine Submodule.linearMap_qext _ (LinearMap.ext fun Z => ?_)
  obtain ⟨Z, hZ⟩ := Z
  exact key Z (hsp ▸ hZ)
/-- Every proper curve has a normalization, of dimension at most one. -/
private theorem exists_curveNormalization (C : ProperCurve sX) :
    ∃ (N : Scheme.{0}) (ν : N ⟶ C.scheme) (_ : IsCurveNormalization ν),
      topologicalKrullDim N ≤ 1 := by
  let p := C.ι ≫ sX
  haveI : AlgebraicGeometry.IsCurve k p := C.isCurve
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k p
  haveI hvar : AlgebraicGeometry.IsVariety k (normalizationOverField k p ≫ p) :=
    isVariety_normalizationOverField k p
  haveI : IsIntegral (normalizationSchemeOverField k p) := hvar.toIsIntegral
  haveI : IsFinite (normalizationOverField k p) := isFinite_normalizationOverField k p
  have hν : IsCurveNormalization (normalizationOverField k p) :=
    { isIntegral := inferInstance
      isNormal := Scheme.isNormal_normalizationScheme C.scheme hX
      isFinite := inferInstance
      isBirationalMorphism := by
        haveI : Finite (irreducibleComponents (normalizationSchemeOverField k p)) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        haveI : Finite (irreducibleComponents C.scheme) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        obtain ⟨U, V, hUV, hU, hV, hiso⟩ := exists_dense_opens_isIso_resLE_of_isBirational
          (normalizationOverField k p) (Scheme.isBirational_normalization C.scheme hX)
          (Or.inl ⟨inferInstance, inferInstance⟩)
        exact isBirationalMorphism_of_isIso_resLE _ U V hU.nonempty hV.nonempty hUV hiso }
  exact ⟨_, _, hν, (topologicalKrullDim_normalizationSchemeOverField k p).le.trans C.dim_le⟩

variable [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]

/-- For a presentation `D = ∑ⱼ rⱼ Lⱼ`, the number `∑ⱼ rⱼ deg_C 𝒪_X(Lⱼ)` is a value of `D · C`. -/
private theorem isRIntersectionNumber_sum_degreeOn {D : RDivisor X} {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier)
    (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) (C : ProperCurve sX) :
    IsRIntersectionNumber k sX D r L C (∑ j, r j * (L j).degreeOn k sX C.ι C.dim_le (hL j)) := by
  obtain ⟨N, ν, hν, hdim⟩ := exists_curveNormalization C
  refine ⟨hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), hD, fun j => ?_, rfl⟩
  refine ⟨N, ν, hν, hdim, ?_⟩
  have := hν.isFinite
  haveI : IsProper ((ν ≫ C.ι) ≫ sX) := by rw [Category.assoc]; infer_instance
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := (hL j).isInvertibleModule_divisorialSheaf
  exact (MMP.Fourfold.Oai4C1.Negativity.degreeOn_normalization C hν hdim _).symm

variable [CompactSpace X]
variable (sX) in
/-- The linear form `z ↦ ∑ᵢ cᵢ (z · 𝒪_X(Mᵢ))` on `N₁(X/Z)` of a presentation `∑ᵢ cᵢ Mᵢ` by
Cartier divisors. -/
private noncomputable def presForm {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) : RelativeNumericalCurveClasses sX f →ₗ[ℝ] ℝ :=
  ∑ i, c i • (haveI := (hM i).isInvertibleModule_divisorialSheaf
    RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf)
private theorem presForm_apply {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (u : RelativeNumericalCurveClasses sX f) :
    presForm sX f c M hM u = ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
      RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) := by
  simp [presForm, LinearMap.sum_apply]
/-- On the class of a contracted curve `C`, the form of `∑ᵢ cᵢ Mᵢ` is `∑ᵢ cᵢ deg_C 𝒪_X(Mᵢ)`. -/
private theorem presForm_relativeClass {n : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    presForm sX f c M hM (C.relativeClass f hC) =
      ∑ i, c i * ((M i).degreeOn k sX C.ι C.dim_le (hM i) : ℝ) := by
  rw [presForm_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  have := (hM i).isInvertibleModule_divisorialSheaf
  exact congrArg (c i * ·) (OneCycle.degree_cycle ℝ _ C)
/-- Two presentations of the same `ℝ`-divisor give the same linear form on `N₁(X/Z)`. -/
private theorem presForm_eq_of_eq {n n' : ℕ} {c : Fin n → ℝ} {M : Fin n → Divisor X}
    (hM : ∀ i, (M i).IsCartier) {c' : Fin n' → ℝ} {M' : Fin n' → Divisor X}
    (hM' : ∀ i, (M' i).IsCartier)
    (h : ∑ i, c i • Divisor.toRDivisor (M i) = ∑ i, c' i • Divisor.toRDivisor (M' i)) :
    presForm sX f c M hM = presForm sX f c' M' hM' := by
  refine linearMap_ext_relativeClass f fun C hC => ?_
  rw [presForm_relativeClass, presForm_relativeClass]
  exact (IsRIntersectionNumber.eq_and_linear k sX C).1 _ c M c' M' _ _
    (isRIntersectionNumber_sum_degreeOn hM rfl C) (isRIntersectionNumber_sum_degreeOn hM' h C)
/-- The form of the concatenated presentation `∑ a cᵢ Mᵢ + ∑ b c'ⱼ M'ⱼ` is `a φ + b φ'`. -/
private theorem presForm_append {n n' : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (hM : ∀ i, (M i).IsCartier) (c' : Fin n' → ℝ) (M' : Fin n' → Divisor X)
    (hM' : ∀ i, (M' i).IsCartier) (a b : ℝ) (hMM : ∀ i, (Fin.append M M' i).IsCartier) :
    presForm sX f (Fin.append (a • c) (b • c')) (Fin.append M M') hMM =
      a • presForm sX f c M hM + b • presForm sX f c' M' hM' := by
  refine linearMap_ext_relativeClass f fun C hC => ?_
  rw [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.smul_apply, presForm_relativeClass,
    presForm_relativeClass, presForm_relativeClass, Fin.sum_univ_add, smul_eq_mul, smul_eq_mul,
    Finset.mul_sum, Finset.mul_sum]
  congr 1 <;> refine Finset.sum_congr rfl fun i _ => ?_
  · simp only [Fin.append_left, Pi.smul_apply, smul_eq_mul, mul_assoc]
  · simp only [Fin.append_right, Pi.smul_apply, smul_eq_mul, mul_assoc]
/-- The concatenation of two presentations presents `a D + b D'`. -/
private theorem sum_append_eq {n n' : ℕ} (c : Fin n → ℝ) (M : Fin n → Divisor X)
    (c' : Fin n' → ℝ) (M' : Fin n' → Divisor X) (a b : ℝ) :
    ∑ i, Fin.append (a • c) (b • c') i • Divisor.toRDivisor (Fin.append M M' i) =
      a • ∑ i, c i • Divisor.toRDivisor (M i) + b • ∑ i, c' i • Divisor.toRDivisor (M' i) := by
  rw [Fin.sum_univ_add, Finset.smul_sum, Finset.smul_sum]
  simp [smul_smul]

end Pairing

section Analysis

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

open scoped Classical in
/-- The coefficient of `∑ᵢ yᵢ pᵢ` along `P`. -/
private theorem coeff_sum_single {ι : Type*} [Fintype ι] {R : Type*} [AddCommMonoid R]
    (p : ι → MMP.Mori.PrimeDivisor X) (y : ι → R) (P : MMP.Mori.PrimeDivisor X) :
    (∑ i, Finsupp.single (p i) (y i) : DivisorWithCoeffs R X).coeff P =
      ∑ i, if p i = P then y i else 0 := by
  classical
  simp [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.single_apply]
/-- **Adding Cartier divisors to the boundary.** For Cartier divisors `Cᵢ` and a divisor `D` over
`X`, there are numbers `μᵢ` (the orders along `D` of the pull-backs of the `Cᵢ`) such that a log
discrepancy `a` of `D` for `(X, B)` gives the log discrepancy `a - ∑ sᵢ μᵢ` for
`(X, B + ∑ sᵢ Cᵢ)`, for all real `sᵢ`. -/
private theorem exists_isLogDiscrepancy_add_sum {ι : Type*} [Fintype ι] (C : ι → Divisor X)
    (hC : ∀ i, (C i).IsCartier) (D : DivisorOver k sX) :
    ∃ μ : ι → ℝ, ∀ (n : ℕ) (B B' : RDivisor X) (s : ι → ℝ) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n B D a →
      (∀ Γ, B'.coeff Γ = B.coeff Γ + ∑ i, s i * ((C i).coeff Γ : ℝ)) →
      MMP.Intersection.IsLogDiscrepancy sX n B' D (a - ∑ i, s i * μ i) := by
  classical
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isIntegral
  have := D.isBirationalMorphism.isDominant
  have : CompactSpace D.Y := (D.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := fun i => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp D.f (C i)
  choose C' hC' using fun i => (hC i).exists_isPullback (hB i)
  refine ⟨fun i => ((C' i).coeff D.E : ℝ), fun n B B' s a h hB' => ?_⟩
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₀, C₀', hC₀, hrel, hpb, ha⟩ := h
  let e := Fintype.equivFin ι
  refine ⟨hnv, hprop, ω, hω0, hK, m + Fintype.card ι, Fin.append r (s ∘ e.symm),
    Fin.append C₀ (C ∘ e.symm), Fin.append C₀' (C' ∘ e.symm), ?_, ?_, ?_, ?_⟩
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hC₀ j
    · simpa using hC (e.symm j)
  · intro Γ
    rw [Fin.sum_univ_add, hB', ← add_assoc, hrel Γ]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    congr 1
    exact (e.symm.sum_comp (fun i => s i * ((C i).coeff Γ : ℝ))).symm
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hpb j
    · rw [Fin.append_right, Fin.append_right]
      exact ⟨hB _, hC' _⟩
  · rw [ha, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    rw [e.symm.sum_comp (fun i => s i * ((C' i).coeff D.E : ℝ))]
    ring

end Analysis

section Exceptional

open TopologicalSpace

/-- A divisor over a normal variety is exceptional if and only if its center has codimension at
least two. -/
private theorem isExceptional_iff_two_le_coheight {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}
    (hX : IsNormalVariety k sX) (D : DivisorOver k sX) :
    D.IsExceptional ↔ 2 ≤ Order.coheight (D.f D.E.genericPoint) := by
  have := D.isLocallyNoetherian
  have := D.isNormal
  have : IsSeparated sX := hX.1.toIsSeparated
  have : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  unfold DivisorOver.IsExceptional
  rw [MMP.Positivity.isExceptional_toRationalMap_iff]
  have hcl : Closeds.closure (D.f '' (D.E.idealSheaf.support : Set D.Y)) =
      ⟨(D.center : Set X), D.center.isClosed⟩ := Closeds.ext rfl
  rw [hcl, closedsCodimension_coe, MMP.Positivity.DivisorOver.codimension_center]
/-- A variety of dimension `n` with an exceptional divisor over it has `n ≥ 2`. -/
private theorem two_le_of_isExceptional {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}
    (hX : IsNormalVariety k sX) {n : ℕ} (hn : topologicalKrullDim X = n)
    {D : DivisorOver k sX} (hD : D.IsExceptional) : 2 ≤ n := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX
    (D.f D.E.genericPoint)
  rw [hn] at h
  have h0 : 0 ≤ topologicalKrullDim (closure {D.f D.E.genericPoint} : Set X) :=
    Order.krullDim_nonneg_iff.mpr ⟨⟨closure {⟨_, subset_closure rfl⟩},
      isIrreducible_singleton.closure, isClosed_closure⟩⟩
  have : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) ≤ n :=
    h ▸ le_add_of_nonneg_left h0
  exact_mod_cast ((isExceptional_iff_two_le_coheight hX D).mp hD).trans
    (WithBot.coe_le_coe.mp this)

end Exceptional

section Resolution

/-- The components of an snc subset form a finite set of prime divisors with snc reduced sum. -/
private theorem exists_finset_isSNC {k : Type u} [Field k] {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] {sY : Y ⟶ Spec (.of k)} [LocallyOfFinitePresentation sY]
    (hsm : IsSmoothScheme sY) {T : TopologicalSpace.Closeds Y} (hT : IsSNCSubset sY T) :
    ∃ S : Finset (MMP.Mori.PrimeDivisor Y),
      DivisorWithCoeffs.IsSNC sY (∑ E ∈ S, Finsupp.single E (1 : ℤ)) ∧
      ∀ F : MMP.Mori.PrimeDivisor Y, F.genericPoint ∈ (T : Set Y) → F ∈ S := by
  rcases hT with h0 | ⟨s, hs, hsnc⟩
  · refine ⟨∅, ?_, fun F hF => ?_⟩
    · rw [Finset.sum_empty]
      exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme _ hsm
    · rw [h0] at hF
      exact absurd hF (by simp)
  · refine ⟨s, hsnc, fun F hF => ?_⟩
    rw [← hs] at hF
    obtain ⟨E, hE, hgen⟩ := Set.mem_iUnion₂.mp hF
    rwa [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hgen] at hE
/-- A prime divisor of a proper birational model that is not exceptional maps generically onto a
prime divisor `P` of `X`, and its coefficient in the crepant boundary is `coeff_P Δ`. -/
private theorem exists_coeff_eq_of_not_isExceptional {k : Type u} [Field k] [PerfectField k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of k)} {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (hP : IsPairWith sX n K Δ) {f : Y ⟶ X} (hY : IsNormalVariety k (f ≫ sX))
    (hf : IsBirationalMorphism f) {ΔY : QDivisor Y}
    (hΔY : IsCrepantBoundary sX n K Δ f hY hf ΔY) {G : MMP.Mori.PrimeDivisor Y}
    (hG : ¬ (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX).IsExceptional) :
    ∃ P : MMP.Mori.PrimeDivisor X, ΔY.coeff G = Δ.coeff P ∧
      f G.genericPoint = P.genericPoint := by
  obtain ⟨P, hc, hd⟩ := DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hP _ hG
  have hη : f G.genericPoint = P.genericPoint := by
    refine (inseparable_iff_closure_eq.2 ?_).eq
    rw [← DivisorOver.center_eq_closure_genericPoint (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX), hc,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact ⟨P, neg_injective ((hΔY G).eq hd), hη⟩

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **The lc data of a log resolution of `∑ pᵢ`.** There are finitely many affine functions
`ℓ_s(y) = c_s - ∑ᵢ yᵢ w_{s,i}` with rational `c_s`, `w_{s,i}` (the log discrepancies of the
components `s` of the snc divisor of a log resolution), such that each `ℓ_s(y)` is a log
discrepancy of `(X, ∑ yᵢ pᵢ)`, and for an effective rational `y` with coefficients at most one
the pair `(X, ∑ yᵢ pᵢ)` is log canonical as soon as every `ℓ_s(y)` is nonnegative. -/
private theorem exists_lcResolution_data [IsAlgClosed k] [CharZero k] (hQ : IsQFactorial sX)
    {ι : Type*} [Fintype ι] (p : ι → MMP.Mori.PrimeDivisor X) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) :
    ∃ (σ : Type u) (S : Finset σ) (c : σ → ℚ) (w : σ → ι → ℚ),
      (∀ s ∈ S, ∀ y : ι → ℝ, ∃ D : DivisorOver k sX,
        MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D
          ((c s : ℝ) - ∑ i, y i * (w s i : ℝ))) ∧
      (∀ q : ι → ℚ, (∀ s ∈ S, 0 ≤ (c s : ℝ) - ∑ i, (q i : ℝ) * (w s i : ℝ)) →
        (∀ j, (∑ i, Finsupp.single (p i) (q i) : QDivisor X).coeff (p j) ≤ 1) →
        (∀ P, 0 ≤ (∑ i, Finsupp.single (p i) (q i) : QDivisor X).coeff P) →
        MMP.Intersection.IsLogCanonicalPair sX (∑ i, Finsupp.single (p i) (q i))) := by
  classical
  have hX : IsNormalVariety k sX := hQ.1
  have : MMP.Mori.IsVariety k sX := hX.1
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : QuasiCompact sX := hX.1.toQuasiCompact
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hn : topologicalKrullDim X = n := hK.topologicalKrullDim_eq
  -- Cartier multiples of the `pᵢ`
  choose m hm hmC using fun i => hQ.2 (Finsupp.single (p i) (1 : ℤ))
  set C : ι → Divisor X := fun i => (m i : ℤ) • Finsupp.single (p i) (1 : ℤ) with hCdef
  have hCcoeff : ∀ i Γ, ((C i).coeff Γ : ℝ) = (m i : ℝ) * if p i = Γ then 1 else 0 := by
    intro i Γ
    simp only [hCdef, DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, Finsupp.single_apply,
      smul_eq_mul]
    split_ifs <;> simp
  have hcoeffrel : ∀ (q : ι → ℚ) (y : ι → ℝ) Γ,
      (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff Γ =
        (∑ i, Finsupp.single (p i) ((q i : ℝ)) : RDivisor X).coeff Γ +
          ∑ i, ((y i - q i) / m i) * ((C i).coeff Γ : ℝ) := by
    intro q y Γ
    rw [coeff_sum_single, coeff_sum_single, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hCcoeff]
    have hm0 : (m i : ℝ) ≠ 0 := by exact_mod_cast (hm i).ne'
    split_ifs <;> field_simp <;> ring
  -- the rational boundaries `B_q`
  set BQ : (ι → ℚ) → QDivisor X := fun q => ∑ i, Finsupp.single (p i) (q i) with hBQdef
  have hBQc : ∀ q P, (BQ q).coeff P = ∑ i, if p i = P then q i else 0 :=
    fun q P => coeff_sum_single p q P
  have hBQ : ∀ q : ι → ℚ,
      QDivisor.toRDivisor (BQ q) = ∑ i, Finsupp.single (p i) ((q i : ℝ)) := by
    intro q
    refine Finsupp.ext fun P => ?_
    change (QDivisor.toRDivisor (BQ q)).coeff P =
      (∑ i, Finsupp.single (p i) ((q i : ℝ)) : RDivisor X).coeff P
    rw [QDivisor.coeff_toRDivisor, hBQc, coeff_sum_single, Rat.cast_sum]
    exact Finset.sum_congr rfl fun i _ => by split_ifs <;> simp
  have hQC : ∀ D : Divisor X, (Divisor.toQDivisor D).IsQCartier := fun D => by
    obtain ⟨m', hm', hC'⟩ := hQ.2 D
    exact ⟨(m' : ℤ), by exact_mod_cast hm'.ne', (m' : ℤ) • D, map_zsmul _ _ _, hC'⟩
  have hBQcart : ∀ q, (BQ q).IsQCartier := by
    intro q
    have e : BQ q = ∑ i, q i • Divisor.toQDivisor (Finsupp.single (p i) (1 : ℤ)) := by
      refine Finset.sum_congr rfl fun i _ => Finsupp.ext fun P => ?_
      change Finsupp.single (p i) (q i) P =
        q i * ((Finsupp.single (p i) (1 : ℤ) P : ℤ) : ℚ)
      simp only [Finsupp.single_apply]
      split_ifs <;> simp
    rw [e]
    refine Finset.sum_induction _ QDivisor.IsQCartier (fun _ _ h h' => h.add h') ?_
      fun i _ => MMP.Flips.isQCartier_smul (hQC _) _
    simpa using QDivisor.isQCartier_toQDivisor (Divisor.isCartier_zero (X := X))
  have hpair : ∀ q, IsPairWith sX n K (BQ q) := fun q => ⟨hX, hK, (hQC K).add (hBQcart q)⟩
  -- a log resolution of `∑ pᵢ`
  obtain ⟨Y, f, hf⟩ := exists_isLogResolution sX hX (∑ i, Finsupp.single (p i) (1 : ℝ))
  obtain ⟨hY, hdimY, -⟩ := hf.toIsSmoothResolution.isNormalVariety hX
  have : IsIntegral Y := hY.1.toIsIntegral
  have : LocallyOfFiniteType (f ≫ sX) := hY.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (f ≫ sX)
  have : IsNormal Y := hY.2
  have : IsProper f := hf.isProper
  have : MMP.Mori.IsVariety k (f ≫ sX) := hY.1
  have : IsDominant f := hf.isBirationalMorphism.isDominant
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (f ≫ sX)
  set hfb := hf.isBirationalMorphism
  let DG : MMP.Mori.PrimeDivisor Y → DivisorOver k sX := fun G => ⟨Y, f, hY, hfb, G⟩
  have hnY : topologicalKrullDim Y = n := hdimY.trans hn
  obtain ⟨KY, hKY⟩ := exists_isCanonicalDivisor_of_isSmoothScheme (f ≫ sX) hf.isSmoothScheme hnY
  obtain ⟨S, hsncS, hmemS⟩ := exists_finset_isSNC hf.isSmoothScheme hf.isSNCSubset
  have hexcS : ∀ G, (DG G).IsExceptional → G ∈ S := fun G hG =>
    hmemS G (Or.inl (MMP.Positivity.support_subset_exceptionalSet G hG
      (MMP.Flips.primeDivisor_genericPoint_mem_support G)))
  -- the crepant boundaries `Θ_q` of `(X, B_q)` on `Y`
  have hex : ∀ q, ∃ Θ : QDivisor Y, IsCrepantBoundary sX n K (BQ q) f hY hfb Θ := fun q => by
    obtain ⟨⟨Θ, hΘ, -⟩, -⟩ :=
      MMP.Mori.IsPair.existsUnique_isCrepantBoundary (hpair q).isPair hK f hY hfb
    exact ⟨Θ, hΘ⟩
  choose Θ hΘ using hex
  have hlogG : ∀ q G, MMP.Intersection.IsLogDiscrepancy sX n
      (∑ i, Finsupp.single (p i) ((q i : ℝ))) (DG G) (1 - ((Θ q).coeff G : ℝ)) := fun q G => by
    have := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hΘ q G)
      (inferInstance : IsProper f)
    rw [hBQ q] at this
    convert this using 1
    push_cast
    ring
  -- log discrepancies are affine in the coefficients
  have hlin : ∀ D : DivisorOver k sX, ∃ w : ι → ℝ, ∀ a₀ : ℝ,
      MMP.Intersection.IsLogDiscrepancy sX n
        (∑ i, Finsupp.single (p i) ((((0 : ι → ℚ) i : ℚ)) : ℝ)) D a₀ →
      ∀ y : ι → ℝ, MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D
        (a₀ - ∑ i, y i * w i) := by
    intro D
    obtain ⟨μ, hμ⟩ := exists_isLogDiscrepancy_add_sum C (fun i => hmC i) D
    refine ⟨fun i => μ i / m i, fun a₀ h₀ y => ?_⟩
    have := hμ n _ _ (fun i => (y i - (((0 : ι → ℚ) i : ℚ) : ℝ)) / m i) a₀ h₀ (hcoeffrel 0 y)
    convert this using 2
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.zero_apply, Rat.cast_zero, sub_zero]
    ring
  choose wG hwG using fun G => hlin (DG G)
  set cG : MMP.Mori.PrimeDivisor Y → ℝ := fun G => 1 - ((Θ 0).coeff G : ℝ) with hcG
  have ha : ∀ G (y : ι → ℝ), MMP.Intersection.IsLogDiscrepancy sX n
      (∑ i, Finsupp.single (p i) (y i)) (DG G) (cG G - ∑ i, y i * wG G i) :=
    fun G y => hwG G _ (hlogG 0 G) y
  have hkey : ∀ q G, ((Θ q).coeff G : ℝ) = 1 - (cG G - ∑ i, (q i : ℝ) * wG G i) := fun q G => by
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hlogG q G) (ha G _)
    linarith
  have hsupp : ∀ q, (Θ q).support ⊆ S := by
    intro q G hG
    rw [Finsupp.mem_support_iff] at hG
    by_cases hGe : (DG G).IsExceptional
    · exact hexcS G hGe
    obtain ⟨P, hθP, hη⟩ := exists_coeff_eq_of_not_isExceptional (hpair q) hY hfb (hΘ q) hGe
    have hP0 : (BQ q).coeff P ≠ 0 := hθP ▸ hG
    obtain ⟨i, hi⟩ : ∃ i, p i = P := by
      by_contra h
      push Not at h
      exact hP0 (by rw [hBQc]; exact Finset.sum_eq_zero fun i _ => if_neg (h i))
    refine hmemS G (Or.inr ?_)
    change f G.genericPoint ∈ (∑ i, Finsupp.single (p i) (1 : ℝ) : RDivisor X).supp
    rw [hη]
    refine DivisorWithCoeffs.support_subset_supp ?_
      (MMP.Flips.primeDivisor_genericPoint_mem_support P)
    rw [coeff_sum_single]
    exact (Finset.sum_pos' (fun j _ => by split_ifs <;> norm_num)
      ⟨i, Finset.mem_univ _, by simp [hi]⟩).ne'
  -- the discrepancy of `(X, B_q)`, bounded below on the resolution
  have hdisc : ∀ (q : ι → ℚ) (b : ℚ), (∀ G ∈ S, (Θ q).coeff G ≤ 1) →
      (∀ G ∈ S, b ≤ 1 - (Θ q).coeff G) →
      (∀ E ∈ S, ∀ F ∈ S, E ≠ F → (E.support ∩ F.support).Nonempty →
        b ≤ 1 - (Θ q).coeff E - (Θ q).coeff F) → b ≤ 1 →
      (∀ G, (DG G).IsExceptional → b ≤ -(Θ q).coeff G) → 2 ≤ n →
      (((b : ℚ) : ℝ) : EReal) ≤ discrep sX n K (BQ q) := by
    intro q b h0 h1 h2 h3 h4 hn2
    rw [IsCrepantBoundary.discrep_eq_min (hpair q).isPair hK hKY (hΘ q),
      discrep_eq_of_isSNC (f ≫ sX) hY hf.isSmoothScheme hn2 hKY S (hsupp q) hsncS h0]
    refine le_min (le_inf (le_inf ?_ ?_) ?_) ?_
    · exact le_iInf₂ fun E hE => le_iInf₂ fun F hF => le_iInf₂ fun hEF hm =>
        EReal.coe_le_coe_iff.mpr (by exact_mod_cast h2 E hE F hF hEF hm)
    · exact le_iInf₂ fun G hG => EReal.coe_le_coe_iff.mpr (by exact_mod_cast h1 G hG)
    · exact_mod_cast EReal.coe_le_coe_iff.mpr (by exact_mod_cast h3 : ((b : ℚ) : ℝ) ≤ 1)
    · refine le_sInf ?_
      rintro _ ⟨G, a, hGe, hGa, rfl⟩
      have := (hΘ q G).eq hGa
      refine EReal.coe_le_coe_iff.mpr ?_
      rw [← this]
      exact_mod_cast h4 G hGe
  -- the discrepancy of a divisor over `X` is `a - 1` for a log discrepancy `a`
  have hstart : ∀ (q : ι → ℚ) (n' : ℕ) (D : DivisorOver k sX) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n' (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
      ∃ c : ℚ, IsDiscrepancy sX n K (BQ q) D c ∧ a = 1 + c := by
    intro q n' D a hDa
    have hn' : n' = n := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDa).symm.trans hn
      exact_mod_cast this
    subst hn'
    rw [← hBQ q] at hDa
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK D
    exact ⟨c, hc, ((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hc a).mp hDa).2⟩
  -- the coefficients are rational
  set cQ : MMP.Mori.PrimeDivisor Y → ℚ := fun G => 1 - (Θ 0).coeff G with hcQ
  set wQ : MMP.Mori.PrimeDivisor Y → ι → ℚ :=
    fun G i => (Θ (Pi.single i 1)).coeff G - (Θ 0).coeff G with hwQ
  have hcc : ∀ G, cG G = cQ G := fun G => by simp [hcG, hcQ]
  have hww : ∀ G i, wG G i = wQ G i := fun G i => by
    classical
    have h1 := hkey (Pi.single i 1) G
    have h0 := hkey 0 G
    simp only [Pi.single_apply, apply_ite (fun q : ℚ => (q : ℝ)), Rat.cast_one, Rat.cast_zero,
      ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true, Pi.zero_apply,
      Finset.sum_const_zero, sub_zero] at h1 h0
    simp only [hwQ, Rat.cast_sub]
    linarith
  refine ⟨MMP.Mori.PrimeDivisor Y, S, cQ, wQ, fun G _ y => ⟨DG G, ?_⟩, ?_⟩
  · have h := ha G y
    simp only [hcc, hww] at h
    exact h
  · -- lc for rational coefficients
    intro q hq hcoef hnn
    refine ⟨(hpair q).isPair, hnn, fun n' D a hDa => ?_⟩
    rw [hBQ q] at hDa
    obtain ⟨c, hc, rfl⟩ := hstart q n' D a hDa
    suffices h : -1 ≤ c by
      have : (-1 : ℝ) ≤ c := by exact_mod_cast h
      linarith
    have hθ : ∀ G ∈ S, (Θ q).coeff G ≤ 1 := fun G hG => by
      have h := hkey q G
      have h' := hq G hG
      simp only [hcc, hww] at h
      exact_mod_cast (by linarith : ((Θ q).coeff G : ℝ) ≤ 1)
    by_cases hD : D.IsExceptional
    · have hn2 := two_le_of_isExceptional hX hn hD
      have hdl := hdisc q (-1) hθ (fun G hG => by linarith [hθ G hG])
        (fun E hE F hF _ _ => by linarith [hθ E hE, hθ F hF])
        (by norm_num) (fun G hGe => by linarith [hθ G (hexcS G hGe)]) hn2
      have h' := EReal.coe_le_coe_iff.mp (hdl.trans (discrep_le hD hc))
      exact_mod_cast h'
    · obtain ⟨P, hPv⟩ :=
        MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX D hD
      obtain ⟨c', hc'⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK
        (DivisorOver.ofPrimeDivisor k hX P)
      rw [MMP.Threefold.Mori.isDiscrepancy_eq_of_valuation_eq (hpair q) hPv hc hc',
        hc'.eq_neg_coeff_of_ofPrimeDivisor hX]
      have : (BQ q).coeff P ≤ 1 := by
        by_cases hP : ∃ j, p j = P
        · obtain ⟨j, rfl⟩ := hP
          exact hcoef j
        · rw [hBQc, Finset.sum_eq_zero fun i _ => if_neg fun h => hP ⟨i, h⟩]
          norm_num
      linarith

end Resolution

section PolytopeHelpers

open Set

variable {r : ℕ}

/-- The intersection of two rational polyhedra is a rational polyhedron. -/
private theorem IsRationalPolyhedron.inter {N N' : Set (Fin r → ℝ)} (hN : IsRationalPolyhedron N)
    (hN' : IsRationalPolyhedron N') : IsRationalPolyhedron (N ∩ N') := by
  classical
  obtain ⟨E, I, rfl⟩ := hN
  obtain ⟨E', I', rfl⟩ := hN'
  refine ⟨E ∪ E', I ∪ I', ?_⟩
  ext x
  simp only [mem_inter_iff, mem_setOf_eq, Finset.mem_union]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    exact ⟨fun f hf => hf.elim (h1 f) (h3 f), fun f hf => hf.elim (h2 f) (h4 f)⟩
  · rintro ⟨h1, h2⟩
    exact ⟨⟨fun f hf => h1 f (.inl hf), fun f hf => h2 f (.inl hf)⟩,
      fun f hf => h1 f (.inr hf), fun f hf => h2 f (.inr hf)⟩
private theorem ratAffineForm_single (i : Fin r) (c q : ℚ) (x : Fin r → ℝ) :
    ratAffineForm (Pi.single i c, q) x = c * x i + q := by
  classical
  simp only [ratAffineForm]
  rw [Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj]) (by simp)]
  simp
/-- A set `{x | ∀ i, lᵢ ≤ xᵢ ≤ uᵢ}` with rational bounds is a rational polyhedron. -/
private theorem isRationalPolyhedron_box (l u : Fin r → ℚ) :
    IsRationalPolyhedron {x : Fin r → ℝ | ∀ i, (l i : ℝ) ≤ x i ∧ x i ≤ u i} := by
  classical
  refine ⟨∅, Finset.univ.image (fun i => (Pi.single i 1, -l i)) ∪
    Finset.univ.image (fun i => (Pi.single i (-1), u i)), ?_⟩
  ext x
  simp only [mem_setOf_eq, Finset.notMem_empty, IsEmpty.forall_iff, implies_true, true_and,
    Finset.mem_union, Finset.mem_image, Finset.mem_univ]
  constructor
  · rintro h f (⟨i, rfl⟩ | ⟨i, rfl⟩) <;> rw [ratAffineForm_single] <;> push_cast <;>
      linarith [(h i).1, (h i).2]
  · intro h i
    have h1 := h _ (.inl ⟨i, rfl⟩)
    have h2 := h _ (.inr ⟨i, rfl⟩)
    rw [ratAffineForm_single] at h1 h2
    push_cast at h1 h2
    constructor <;> linarith
/-- The coordinatewise lower bound `{x | ∀ i, gᵢ ≤ xᵢ}` with rational `g` is a rational
polyhedron. -/
private theorem isRationalPolyhedron_lowerBound (g : Fin r → ℚ) :
    IsRationalPolyhedron {x : Fin r → ℝ | ∀ i, (g i : ℝ) ≤ x i} := by
  classical
  refine ⟨∅, Finset.univ.image (fun i => (Pi.single i 1, -g i)), ?_⟩
  ext x
  simp only [mem_setOf_eq, Finset.notMem_empty, IsEmpty.forall_iff, implies_true, true_and,
    Finset.mem_image, Finset.mem_univ]
  constructor
  · rintro h f ⟨i, rfl⟩
    rw [ratAffineForm_single]; push_cast; linarith [h i]
  · intro h i
    have h1 := h _ ⟨i, rfl⟩
    rw [ratAffineForm_single] at h1
    push_cast at h1
    linarith
/-- A rational parallelotope is the convex hull of finitely many rational points (its corners). -/
private theorem IsRationalParallelotope.exists_finset {Q : Set (Fin r → ℝ)}
    (hQ : IsRationalParallelotope Q) :
    ∃ V : Finset (Fin r → ℚ), Q = convexHull ℝ ((fun v i => (v i : ℝ)) '' (V : Set (Fin r → ℚ))) := by
  classical
  obtain ⟨d, p, e, a, b, -, hab, rfl⟩ := hQ
  let φ : (Fin d → ℝ) →ᵃ[ℝ] (Fin r → ℝ) :=
    (Fintype.linearCombination ℝ (fun i j => (e i j : ℝ))).toAffineMap +
      AffineMap.const ℝ _ (fun j => (p j : ℝ))
  have hφ : ∀ s j, φ s j = (p j : ℝ) + ∑ i, s i * (e i j : ℝ) := fun s j => by
    simp [φ, Fintype.linearCombination_apply, add_comm]
  let corner : (Fin d → Bool) → Fin r → ℚ := fun c j => p j + ∑ i, (if c i then b i else a i) * e i j
  let C : Set (Fin d → ℝ) := univ.pi fun i => {(a i : ℝ), (b i : ℝ)}
  refine ⟨Finset.univ.image corner, ?_⟩
  have hbox : (univ.pi fun i => Icc (a i : ℝ) (b i)) = convexHull ℝ C := by
    rw [convexHull_pi]
    refine pi_congr rfl fun i _ => ?_
    rw [convexHull_pair, segment_eq_Icc (by exact_mod_cast (hab i).le)]
  have hV : (fun v i => (v i : ℝ)) '' ((Finset.univ.image corner : Finset _) : Set (Fin r → ℚ)) =
      φ '' C := by
    ext x
    simp only [Finset.coe_image, Finset.coe_univ, image_univ, mem_image, mem_range]
    constructor
    · rintro ⟨_, ⟨c, rfl⟩, rfl⟩
      refine ⟨fun i => ((if c i then b i else a i : ℚ) : ℝ), fun i _ => ?_, ?_⟩
      · by_cases h : c i <;> simp [h]
      · funext j
        rw [hφ]
        simp only [corner]
        push_cast
        exact congrArg _ (Finset.sum_congr rfl fun i _ => by by_cases h : c i <;> simp [h])
    · rintro ⟨s, hs, rfl⟩
      have hs' : ∀ i, s i = ((if decide (s i = b i) then b i else a i : ℚ) : ℝ) := fun i => by
        rcases hs i (mem_univ i) with h | h <;> by_cases h' : s i = b i <;> simp_all
      refine ⟨corner fun i => decide (s i = b i), ⟨_, rfl⟩, ?_⟩
      funext j; rw [hφ]; simp only [corner]; push_cast
      exact congrArg _ (Finset.sum_congr rfl fun i _ => by rw [← hs' i])
  rw [hV, ← AffineMap.image_convexHull, ← hbox]
  ext x
  constructor
  · rintro ⟨s, hs, rfl⟩
    exact ⟨s, Set.mem_univ_pi.2 hs, funext fun j => hφ s j⟩
  · rintro ⟨s, hs, rfl⟩
    exact ⟨s, Set.mem_univ_pi.1 hs, funext fun j => hφ s j⟩
/-- A divisor supported on the injective family `p` is the sum of its coefficients along `p`. -/
private theorem eq_sum_single_coeff {R : Type*} [AddCommMonoid R] {Y : Scheme.{u}}
    {p : Fin r → MMP.Mori.PrimeDivisor Y} (hp : Function.Injective p)
    {D : DivisorWithCoeffs R Y}
    (hD : ∀ P, D.coeff P ≠ 0 → P ∈ Set.range p) :
    D = ∑ i, Finsupp.single (p i) (D.coeff (p i)) := by
  classical
  conv_lhs => rw [← Finsupp.sum_single D]
  rw [Finsupp.sum_of_support_subset D (s := Finset.univ.image p) (g := Finsupp.single)
    (fun P hP => by simpa using hD P (by simpa [DivisorWithCoeffs.coeff_apply] using hP))
    (fun _ _ => Finsupp.single_zero _), Finset.sum_image fun i _ j _ h => hp h]
  rfl
/-- Casting the coefficients of `∑ᵢ vᵢ pᵢ` from `ℚ` to `ℝ`. -/
private theorem toRDivisor_sum_single {Y : Scheme.{u}} (p : Fin r → MMP.Mori.PrimeDivisor Y)
    (v : Fin r → ℚ) :
    QDivisor.toRDivisor (∑ i, Finsupp.single (p i) (v i)) =
      ∑ i, Finsupp.single (p i) (v i : ℝ) := by
  classical
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => DivisorWithCoeffs.ext' fun P => ?_
  rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
    Finsupp.single_apply, Finsupp.single_apply]
  split_ifs <;> simp

end PolytopeHelpers

section PrimeDivisorDiscrepancy

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
  {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The log discrepancy of a prime divisor `P` of `X` with respect to an `ℝ`-divisor `B` with
`K + B` `ℝ`-Cartier is `1 - coeff_P B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [CompactSpace X] (hX : IsNormalVariety k sX)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {B : RDivisor X}
    (hKB : RDivisor.IsRCartier (Divisor.toRDivisor K + B)) (P : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n B (DivisorOver.ofPrimeDivisor k hX P)
      (1 - B.coeff P) := by
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, r, C, hC, hsum⟩ := hKB
  choose C' hC' using fun i => MMP.Threefold.Bridges.exists_isPullback_of_isDominant (𝟙 X) (hC i)
  have hC'P : ∀ i, (C' i).coeff P = (C i).coeff P := fun i =>
    MMP.Positivity.coeff_eq_of_isPullback (f := 𝟙 X) P P rfl (hC i) (hC' i)
  have hord : (DivisorOver.ofPrimeDivisor k hX P).ordPullback ω = P.ordForm ω :=
    DivisorOver.ordPullback_ofPrimeDivisor hX hK.topologicalKrullDim_eq P ω
  have hsumΓ : ∀ Γ, (Γ.ordForm ω : ℝ) + B.coeff Γ = ∑ i, r i * (C i).coeff Γ := fun Γ => by
    rw [← hsum Γ, hω Γ, DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor]
  refine ⟨hX, (inferInstance : IsProper (𝟙 X)), ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, m, r, C,
    C', hC, hsumΓ, fun i => ⟨_, hC' i⟩, ?_⟩
  change 1 - B.coeff P = 1 + ((DivisorOver.ofPrimeDivisor k hX P).ordPullback ω : ℝ) -
    ∑ i, r i * ((C' i).coeff P : ℝ)
  simp_rw [hC'P, hord]
  rw [← hsumΓ P]
  ring

end PrimeDivisorDiscrepancy

section Polytope

/-- **Effective real lc boundaries lie in a rational lc polytope.** On a normal `ℚ`-factorial
variety over `ℂ`, two effective real lc boundaries `B`, `E` lie in the convex hull of finitely many
effective rational boundaries `V i` with every `(X, V i)` log canonical. -/
private theorem exists_lcPolytope {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    (hXq : IsQFactorial sX) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX 4) {B E : RDivisor X} (hB : IsRealLcPair sX B)
    (hE : IsRealLcPair sX E) :
    ∃ (ι : Type) (_ : Fintype ι) (V : ι → QDivisor X), (∀ i P, 0 ≤ (V i).coeff P) ∧
      (∀ i, MMP.Intersection.IsLogCanonicalPair sX (V i)) ∧
      B ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)) ∧
      E ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)) := by
  classical
  -- the joint support, as an injective family `p : Fin r → PrimeDivisor X`
  set T : Finset (MMP.Mori.PrimeDivisor X) := B.support ∪ E.support with hT
  let p : Fin T.card → MMP.Mori.PrimeDivisor X := fun i => (T.equivFin.symm i : _)
  have hp : Function.Injective p := Subtype.val_injective.comp T.equivFin.symm.injective
  have hTp : ∀ P ∈ T, P ∈ Set.range p := fun P hP =>
    ⟨T.equivFin ⟨P, hP⟩, by simp [p]⟩
  have hBp : ∀ P, B.coeff P ≠ 0 → P ∈ Set.range p := fun P hP =>
    hTp P (Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr hP))
  have hEp : ∀ P, E.coeff P ≠ 0 → P ∈ Set.range p := fun P hP =>
    hTp P (Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr hP))
  obtain ⟨σ, S, c, w, hlog, hlc⟩ := exists_lcResolution_data hXq p hK
  -- the lc polyhedron `N` in the coefficient space
  have hform : ∀ s (y : Fin T.card → ℝ), ratAffineForm (fun i => -w s i, c s) y =
      (c s : ℝ) - ∑ i, y i * (w s i : ℝ) := fun s y => by
    simp only [ratAffineForm, Rat.cast_neg, neg_mul, Finset.sum_neg_distrib]
    rw [show ∑ i, (w s i : ℝ) * y i = ∑ i, y i * (w s i : ℝ) from
      Finset.sum_congr rfl fun i _ => mul_comm _ _]
    ring
  set N : Set (Fin T.card → ℝ) :=
    {y | ∀ s ∈ S, 0 ≤ (c s : ℝ) - ∑ i, y i * (w s i : ℝ)} ∩
      {x | ∀ i, (((0 : Fin T.card → ℚ) i : ℚ) : ℝ) ≤ x i ∧ x i ≤ ((1 : Fin T.card → ℚ) i : ℚ)}
    with hNdef
  have hN : IsRationalPolyhedron N := by
    refine IsRationalPolyhedron.inter ⟨∅, S.image fun s => (fun i => -w s i, c s), ?_⟩
      (isRationalPolyhedron_box 0 1)
    ext y
    simp only [Set.mem_setOf_eq, Finset.notMem_empty, IsEmpty.forall_iff, implies_true,
      true_and, Finset.mem_image]
    constructor
    · rintro h _ ⟨s, hs, rfl⟩
      rw [hform]; exact h s hs
    · intro h s hs
      rw [← hform]; exact h _ ⟨s, hs, rfl⟩
  -- the coefficient vector of an effective real lc boundary on the support lies in `N`
  have hmemN : ∀ D : RDivisor X, IsRealLcPair sX D → (∀ P, D.coeff P ≠ 0 → P ∈ Set.range p) →
      (fun i => D.coeff (p i)) ∈ N := by
    intro D hD hDp
    have hDeq := eq_sum_single_coeff hp hDp
    refine ⟨fun s hs => ?_, fun i => ⟨?_, ?_⟩⟩
    · obtain ⟨Dv, hDv⟩ := hlog s hs fun i => D.coeff (p i)
      rw [← hDeq] at hDv
      exact hD.2.2.2 4 Dv _ hDv
    · simpa using hD.2.1 (p i)
    · obtain ⟨hnv, -, ⟨n', K', hK', hKD⟩, hla⟩ := hD
      have := hla n' _ _ (isLogDiscrepancy_ofPrimeDivisor hnv hK' hKD (p i))
      simp only [Pi.one_apply, Rat.cast_one]
      linarith
  -- a rational polytope with vertices in `N` around such a coefficient vector
  have hfin : ∀ D : RDivisor X, IsRealLcPair sX D → (∀ P, D.coeff P ≠ 0 → P ∈ Set.range p) →
      ∃ W : Finset (Fin T.card → ℚ), (∀ v ∈ W, (fun i => (v i : ℝ)) ∈ N) ∧
        (fun i => D.coeff (p i)) ∈
          convexHull ℝ ((fun v i => (v i : ℝ)) '' (W : Set (Fin T.card → ℚ))) := by
    intro D hD hDp
    obtain ⟨-, Q, hQ, hQN, hδQ, -⟩ := rational_hull_neighborhood hN (hmemN D hD hDp)
    obtain ⟨W, rfl⟩ := IsRationalParallelotope.exists_finset hQ
    exact ⟨W, fun v hv => (hQN (subset_convexHull ℝ _ ⟨v, hv, rfl⟩)).1,
      intrinsicInterior_subset hδQ⟩
  obtain ⟨WB, hWB, hBW⟩ := hfin B hB hBp
  obtain ⟨WE, hWE, hEW⟩ := hfin E hE hEp
  set W := WB ∪ WE
  have hWN : ∀ v ∈ W, (fun i => (v i : ℝ)) ∈ N := fun v hv =>
    (Finset.mem_union.mp hv).elim (hWB v) (hWE v)
  -- the rational boundaries of the vertices
  let Vd : W → QDivisor X := fun v => ∑ i, Finsupp.single (p i) (v.1 i)
  have hcoeffV : ∀ (v : Fin T.card → ℚ) j,
      (∑ i, Finsupp.single (p i) (v i) : QDivisor X).coeff (p j) = v j := fun v j => by
    rw [coeff_sum_single, Finset.sum_eq_single j (fun i _ hij => if_neg (hp.ne hij))
      (by simp)]
    simp
  have hV0 : ∀ v : W, ∀ P, 0 ≤ (Vd v).coeff P := fun v P => by
    rw [coeff_sum_single]
    refine Finset.sum_nonneg fun i _ => ?_
    split_ifs
    · have := ((hWN v.1 v.2).2 i).1
      simp only [Pi.zero_apply, Rat.cast_zero] at this
      exact_mod_cast this
    · exact le_rfl
  refine ⟨W, inferInstance, Vd, hV0, fun v => ?_, ?_⟩
  · refine hlc v.1 (fun s hs => (hWN v.1 v.2).1 s hs) (fun j => ?_) (hV0 v)
    rw [hcoeffV]
    have := ((hWN v.1 v.2).2 j).2
    simp only [Pi.one_apply, Rat.cast_one] at this
    exact_mod_cast this
  -- `B` and `E` are images of points of the polytopes under the coefficient map
  let Φ : (Fin T.card → ℝ) →ₗ[ℝ] RDivisor X :=
    ∑ i, (Finsupp.lsingle (p i)).comp (LinearMap.proj i)
  have hΦ : ∀ y, Φ y = ∑ i, Finsupp.single (p i) (y i) := fun y => by
    simp [Φ, LinearMap.sum_apply]
  have hsub : ∀ W' ⊆ W, Φ '' ((fun v i => (v i : ℝ)) '' (W' : Set (Fin T.card → ℚ))) ⊆
      Set.range fun v : W => QDivisor.toRDivisor (Vd v) := by
    rintro W' hW' _ ⟨_, ⟨v, hv, rfl⟩, rfl⟩
    exact ⟨⟨v, hW' hv⟩, by rw [hΦ]; exact toRDivisor_sum_single p v⟩
  have hmem : ∀ D : RDivisor X, (∀ P, D.coeff P ≠ 0 → P ∈ Set.range p) → ∀ W' ⊆ W,
      (fun i => D.coeff (p i)) ∈
        convexHull ℝ ((fun v i => (v i : ℝ)) '' (W' : Set (Fin T.card → ℚ))) →
      D ∈ convexHull ℝ (Set.range fun v : W => QDivisor.toRDivisor (Vd v)) := by
    intro D hDp W' hW' hD
    have h := Set.mem_image_of_mem Φ hD
    rw [LinearMap.image_convexHull, hΦ, ← eq_sum_single_coeff hp hDp] at h
    exact convexHull_mono (hsub W' hW') h
  exact ⟨hmem B hBp WB Finset.subset_union_left hBW, hmem E hEp WE Finset.subset_union_right hEW⟩

end Polytope

section Endgame

/-- A sum over indices weighted by nonnegative `w` only sees the indices of positive weight. -/
private theorem sum_subtype_pos_eq_sum {ι M : Type*} [Fintype ι] [AddCommMonoid M]
    {w : ι → ℝ} (hw : ∀ j, 0 ≤ w j) (F : ι → M) (hF : ∀ j, w j = 0 → F j = 0) :
    ∑ j : {j // 0 < w j}, F j.1 = ∑ j, F j := by
  classical
  rw [← Finset.subtype_univ, Finset.sum_subtype_eq_sum_filter (p := fun j => 0 < w j) (f := F),
    Finset.sum_filter_of_ne]
  intro j _ hj
  by_contra h
  exact hj (hF j (le_antisymm (not_lt.mp h) (hw j)))
/-- **The radial gap.** If `D · L ≥ 0`, `D · L > 0` forces `D · L ≥ τ`, `(K + E) · L ≥ -8` and
`D_t · L = (1 - t) (D · L) + t ((K + E) · L) < 0` for some `0 < t < 1` with `t (τ + 8) < τ`,
then `D · L = 0`. -/
private theorem eq_zero_of_radial_gap {τ t a b : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
    (htτ : t * (τ + 8) < τ) (ha : 0 ≤ a) (hgap : 0 < a → τ ≤ a) (hb : -8 ≤ b)
    (hneg : (1 - t) * a + t * b < 0) : a = 0 :=
  le_antisymm (not_lt.mp fun hpos => by nlinarith [hgap hpos]) ha
/-- A linear form vanishing at a nonzero point of an extremal ray vanishes on the whole ray. -/
private theorem IsExtremalRay.map_eq_zero {𝕜 V : Type*} [Field 𝕜] [LinearOrder 𝕜]
    [IsStrictOrderedRing 𝕜] [AddCommGroup V] [Module 𝕜 V] {N R : Set V}
    (hR : IsExtremalRay 𝕜 N R) (φ : V →ₗ[𝕜] 𝕜) {ℓ : V} (hℓR : ℓ ∈ R) (hℓ : ℓ ≠ 0)
    (h : φ ℓ = 0) : ∀ u ∈ R, φ u = 0 := by
  obtain ⟨v, -, rfl⟩ := hR.2
  obtain ⟨a, -, rfl⟩ := hℓR
  rintro _ ⟨b, -, rfl⟩
  have ha : a ≠ 0 := by rintro rfl; exact hℓ (zero_smul _ _)
  rw [map_smul, smul_eq_mul] at h
  rw [map_smul, (mul_eq_zero.mp h).resolve_left ha, smul_zero]

end Endgame

open MMP.Flips in
private theorem exists_pos_forall_isExtremalRay_null_of_isRealLcPair :
    ∀ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {f : X ⟶ Z} (hf : f ≫ sZ = sX)
    (hXq : IsQFactorial sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 4)
    {B E : RDivisor X} (hB : IsRealLcPair sX B) (hE : IsRealLcPair sX E)
    (hD : MMP.Flips.IsRelativelyNef ℂ sX f (MMP.Flips.logCanonicalDivisor K B)),
    ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, 0 < t → t < t₀ →
      ∀ R : Set (RelativeNumericalCurveClasses sX f),
        IsExtremalRay ℝ
          (relativeClosedConeOfCurves sX f : Set (RelativeNumericalCurveClasses sX f)) R →
        (∃ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
          (1 - t) • (Divisor.toRDivisor K + B) + t • (Divisor.toRDivisor K + E) =
              ∑ i, c i • Divisor.toRDivisor (M i) ∧
            ∀ u ∈ R, u ≠ 0 →
              ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
                RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) < 0) →
        ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
          Divisor.toRDivisor K + B = ∑ i, c i • Divisor.toRDivisor (M i) →
          ∀ u ∈ R, ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
            RelativeNumericalCurveClasses.degree sX f (M i).divisorialSheaf u) = 0 := by
  intro X Z _ _ _ _ sX sZ hX hZ f hf hXq K hK B E hB hE hD
  obtain ⟨ι, _, V, hV0, hV, hBP, hEP⟩ := exists_lcPolytope hXq hK hB hE
  -- `B` as a positive convex combination of rational lc points of the polytope
  obtain ⟨ι', _, w, z, hw0, hw1, hz, hwz⟩ := mem_convexHull_iff_exists_fintype.mp hBP
  choose g hg using hz
  simp only at hg
  let κ := {j : ι' // 0 < w j}
  have hsubR : ∑ j : κ, w j.1 = 1 := (sum_subtype_pos_eq_sum hw0 w fun _ h => h).trans hw1
  obtain ⟨τ, hτ, hgap⟩ :=
    PositiveGap.exists_pos_forall_isExtremalRay_exists_isRationalCurve_neg_eight_le hX hZ hf hXq hK hV0 hV
      hBP (κ := κ) (r := fun j => w j.1) (fun j => j.2) hsubR (Bj := fun j => V (g j.1))
      (fun j => subset_convexHull ℝ _ ⟨g j.1, rfl⟩) (fun j => hV _) (by
        rw [← hwz, sum_subtype_pos_eq_sum hw0 (fun j => w j • QDivisor.toRDivisor (V (g j)))
          (fun j hj => by rw [hj, zero_smul])]
        exact Finset.sum_congr rfl fun j _ => by rw [hg j])
  refine ⟨τ / (τ + 8), div_pos hτ (by linarith), ?_⟩
  intro t ht0 htt R hR ⟨n, c, M, hM, heq, hneg⟩ n' c' M' hM' heq' u hu
  have ht1 : t < 1 := htt.trans ((div_lt_one (by linarith)).mpr (by linarith))
  have htτ : t * (τ + 8) < τ := (lt_div_iff₀ (by linarith)).mp htt
  -- the nearby adjoint is `K + B'` for the point `B' = (1 - t) B + t E` of the polytope
  have hB'P : (1 - t) • B + t • E ∈ convexHull ℝ (Set.range fun i => QDivisor.toRDivisor (V i)) :=
    convex_convexHull ℝ _ hBP hEP (by linarith) ht0.le (by ring)
  have hKB' : Divisor.toRDivisor K + ((1 - t) • B + t • E) = ∑ i, c i • Divisor.toRDivisor (M i) := by
    rw [← heq]; module
  obtain ⟨L, hLc, -, hLR, hL0, h8, hτL⟩ := hgap R hR ⟨_, hB'P, n, c, M, hM, hKB', hneg⟩
  set ℓ := L.relativeClass f hLc
  -- a presentation of `K + E`
  set cE := Fin.append ((1 / t) • c) ((-(1 - t) / t) • c') with hcE
  set ME := Fin.append M M' with hMEdef
  have hME : ∀ i, (ME i).IsCartier := fun i =>
    Fin.addCases (motive := fun i => (Fin.append M M' i).IsCartier)
      (fun i => by simpa using hM i) (fun i => by simpa using hM' i) i
  have hKE : Divisor.toRDivisor K + E = ∑ i, cE i • Divisor.toRDivisor (ME i) := by
    rw [sum_append_eq, ← heq, ← heq']
    match_scalars <;> field_simp <;> ring
  -- the forms of `D`, `K + E` and `D_t`
  have hMM : ∀ i, (Fin.append M' ME i).IsCartier := fun i =>
    Fin.addCases (motive := fun i => (Fin.append M' ME i).IsCartier)
      (fun i => by simpa using hM' i) (fun i => by simpa using hME i) i
  have hlin : presForm sX f c M hM =
      (1 - t) • presForm sX f c' M' hM' + t • presForm sX f cE ME hME := by
    rw [← presForm_append f c' M' hM' cE ME hME (1 - t) t hMM]
    refine presForm_eq_of_eq f hM hMM ?_
    rw [sum_append_eq, ← heq', ← hKE, heq]
  have hneg' : presForm sX f c M hM ℓ < 0 := by
    rw [presForm_apply]; exact hneg ℓ hLR hL0
  have h8' : -8 ≤ presForm sX f cE ME hME ℓ := by
    rw [presForm_apply]; exact h8 E hEP _ cE ME hME hKE
  have hτ' : 0 < presForm sX f c' M' hM' ℓ → τ ≤ presForm sX f c' M' hM' ℓ := by
    rw [presForm_apply]; exact hτL _ c' M' hM' heq'
  -- nefness of `D` over `Z`
  have hnef : 0 ≤ presForm sX f c' M' hM' ℓ := by
    obtain ⟨m, r, L₀, hL₀, hDeq, hDnef⟩ := hD
    have hDeq' : Divisor.toRDivisor K + B = ∑ j, r j • Divisor.toRDivisor (L₀ j) := hDeq
    rw [← presForm_eq_of_eq f hL₀ hM' (hDeq'.symm.trans heq'), presForm_relativeClass]
    exact hDnef L hLc _ (isRIntersectionNumber_sum_degreeOn hL₀ hDeq L)
  have hzero : presForm sX f c' M' hM' ℓ = 0 :=
    eq_zero_of_radial_gap ht0 ht1 htτ hnef hτ' h8' (by simpa [hlin] using hneg')
  -- `D` vanishes on the ray spanned by `[L]`
  rw [← presForm_apply f c' M' hM']
  exact IsExtremalRay.map_eq_zero hR _ hLR hL0 hzero u hu

end ErasedIntegral

