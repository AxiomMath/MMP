/-!
# Junctions, bridges and labels along a stabilized tail

Let `(X_i, B_i, Z_i, f_i, f_i⁺)_{i ≥ 0}` be a stabilized tail of threefold steps, with common
low-discrepancy set `I_∞`, let `(p_i, Θ_i)`, `p_i : Y_i ⟶ X_i`, be a crepant junction of
`(X_i, B_i)` extracting `I_∞`, and let
`Θ_i' = (p_i)⁻¹_* B_i + ∑_{s ∈ I_∞} (1 - a_{i+1}(s)) E_{i,s}` be its decreased boundary.

*The decreased pair is terminal.* The coefficients of `Θ_i'` lie in `[0, 1)`, since
`0 < a_{i+1}(s) ≤ 1`. For a divisor `D` over `Y_i`,
`a(D; X_i, B_i) = a(D; Y_i, Θ_i) ≤ a(D; Y_i, Θ_i')`, which is positive as `(X_i, B_i)` is klt, and
exceeds `1` when `D` is exceptional over `Y_i`, its valuation being then exceptional over `X_i` and
not among the extracted ones.

*No divisor is lost in a bridge.* Every contraction `g_k` of a finite relative programme over
`Z_i` from `(Y_i, Θ_i')` is small. The models `(V_k, Θ_k)` are compared with `(X_{i+1}, B_{i+1})`,
whose `K + B` is ample over `Z_i`: the log discrepancies of prime divisors of `V_k` agree, and the
negativity lemma, applied on a common model to the difference of the two crepant boundaries, gives
`a(ξ; V_k, Θ_k) ≤ a(ξ; X_{i+1}, B_{i+1})` for every divisorial `ξ`. A divisor contracted by `g_k`
would have strictly larger log discrepancy on `V_{k+1}`, a contradiction. The strict transforms
then identify the prime divisors of all models, preserving coefficients, and terminality
propagates.

*Labels from the boundary.* A label that is the strict transform of a component `Γ` of `B_0` has
coefficient `coeff_Γ B_0` on every model of a terminal chain, and is therefore fixed.

*A uniform margin.* There are `q, r ≥ 1` with every `q B_i` integral and every log discrepancy of
every `(X_i, B_i)` at least `1 / r`: the coefficients of all `B_i` are among those of `B_0`,
`r a(ξ; X_0, B_0)` is a positive integer when `r (K + B_0)` is Cartier, and log discrepancies do
not drop along a step. Every `I(X_i, B_i)` is finite of cardinality `|I_∞|`, finiteness of
`I(X_0, B_0)` being computed on a log-smooth model.

## Main results

* `MMP.Fourfold.StabilizedTail.IsDecreasedBoundary.isKltTerminalPair_and_coeff_mem_Ico`:
  `(Y_i, Θ_i')` is terminal and its coefficients lie in `[0, 1)`.
* `MMP.Fourfold.StabilizedTail.IsDecreasedBoundary.isSmallMorphism_relativeThreefoldProgram`:
  smallness of the contractions of a bridge programme, the bijections of prime divisors, the
  boundaries and the terminality of the models.
* `MMP.Fourfold.StabilizedTail.TerminalChain.isLabelCoefficient_coeff_and_isFixedLabel`: labels
  coming from the boundary have constant coefficient and are fixed.
* `MMP.Fourfold.StabilizedTail.exists_smul_eq_and_inv_le_and_ncard_eq`: the margin `(q, r)` and
  the finiteness of the low-discrepancy sets.

## Implementation notes

That `Y_i` is a normal projective `ℚ`-factorial threefold is part of the data of a crepant
junction, so it is not restated. Terminality is `MMP.Fourfold.IsKltTerminalPair`, which contains
effectivity of the boundary and `ℚ`-Cartierness of `K + Θ`.

The bijections of prime divisors along a bridge are equivalences `e k` from the prime divisors of
`Y_i = V_0` to those of `V_k`, starting at the identity and characterised by the strict transform
`MMP.Fourfold.flipTransformPrimeDivisor (g_k) (g_k⁺) (e k P) = some (e (k + 1) P)`; that `Θ_k` is
the strict transform of `Θ_i'` is stated coefficientwise. The comparison with
`(X_{i+1}, B_{i+1})` is proved for any pair of proper birational morphisms `π : V ⟶ Z`,
`f : X ⟶ Z` with `K_X + B` relatively ample over `Z`; valuations of the different models are
compared through their restrictions to `k(Z_i)`.

The label `S` is identified with the strict transform of `Γ` through
`MMP.Mori.inverseTransformPrimeDivisor` along `p_0`. The identification `I(X_i, B_i) = I_∞` is the
field `MMP.Fourfold.StabilizedTail.lowDiscrepancySet_eq`; what is recorded here is that each
`I(X_i, B_i)` is finite of cardinality `|I_∞|`.

## References

* [OpenAI, *Projective lc fourfolds*][OAI4], the threefold terminal chain
* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], 3.39
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace
open scoped WithZero

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

universe u

namespace MMP.Fourfold

open MMP.Mori

namespace StabilizedTail

/-! ### The decreased pair of a junction is terminal -/

/-- Restriction of valuations along a surjective ring map is injective. -/
private theorem comap_injective_of_surjective {A B Γ : Type*} [Ring A] [Ring B]
    [LinearOrderedCommMonoidWithZero Γ] {φ : A →+* B} (hφ : Function.Surjective φ) :
    Function.Injective (fun v : Valuation B Γ => v.comap φ) := by
  intro v v' h
  ext b
  obtain ⟨a, rfl⟩ := hφ b
  exact congrArg (fun w : Valuation A Γ => w a) h

/-- The inverse transform of an effective divisor is effective. -/
private theorem inverseTransformDivisor_nonneg {X Y : Scheme.{0}} (g : Y ⟶ X) {D : QDivisor X}
    (hD : 0 ≤ D) : 0 ≤ inverseTransformDivisor g D := by
  classical
  rw [inverseTransformDivisor, DivisorWithCoeffs.mapPrimeDivisors, Finsupp.liftAddHom_apply,
    Finsupp.sum]
  refine Finset.sum_nonneg fun P _ => ?_
  cases inverseTransformPrimeDivisor g P with
  | none => exact le_rfl
  | some E => exact Finsupp.single_nonneg.mpr (hD P)

/-- The centre of a divisor exceptional over a normal variety has codimension at least two. -/
private theorem two_le_codimension_center_of_isExceptional {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} (hY : IsNormalVariety ℂ sY)
    (D : DivisorOver ℂ sY) (hE : D.IsExceptional) : 2 ≤ codimension D.center := by
  have := D.isLocallyNoetherian
  have := D.isNormal
  have : IsSeparated sY := hY.1.toIsSeparated
  have hsep : IsSeparated (Y ↘ ⊤_ Scheme) := by
    have : (Y ↘ ⊤_ Scheme) = sY ≫ Limits.terminal.from (Spec (.of ℂ)) := Subsingleton.elim _ _
    rw [this]
    infer_instance
  unfold DivisorOver.IsExceptional at hE
  rw [MMP.Positivity.isExceptional_toRationalMap_iff] at hE
  have hc : Closeds.closure (D.f '' (D.E.idealSheaf.support : Set D.Y)) =
      ⟨(D.center : Set Y), D.center.isClosed⟩ := by
    refine Closeds.ext ?_
    rw [Closeds.coe_closure]
    exact D.coe_center.symm
  rw [hc] at hE
  change 2 ≤ closedsCodimension (T := Y) ⟨(D.center : Set Y), D.center.isClosed⟩ at hE
  rwa [closedsCodimension_coe] at hE

section Junction

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X}
  {I : Finset (Valuation X.functionField (WithZero (Multiplicative ℤ)))}

/-- The divisor `(Y, p, Q)` over `X` of a prime divisor `Q` of the source of a junction. -/
private abbrev divisorOver (J : CrepantJunction sX B I) (Q : MMP.Mori.PrimeDivisor J.Y) :
    DivisorOver ℂ sX :=
  ⟨J.Y, J.p, J.isQFactorial.1, J.isBirationalMorphism, Q⟩

/-- **Strict transforms.** Every prime divisor `P` of `X` has a strict transform `Q` on `Y`, with
`ord_Q = ord_P` as valuations of `k(X)`. -/
private theorem exists_valuation_divisorOver_eq (J : CrepantJunction sX B I)
    (hX : IsNormalVariety ℂ sX) (P : MMP.Mori.PrimeDivisor X) :
    ∃ Q : MMP.Mori.PrimeDivisor J.Y,
      (divisorOver J Q).valuation = (DivisorOver.ofPrimeDivisor ℂ hX P).valuation := by
  have : IsProper J.p := isProper_of_isProjectiveMorphism _ J.isProjectiveMorphism
  have := J.isBirationalMorphism.isDominant
  obtain ⟨y, hy, hcoh, -, -⟩ := MMP.Intersection.exists_preimage_of_coheight_eq_one J.p
    (IsBirationalMorphism.functionFieldMap_bijective J.isBirationalMorphism)
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint P)
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh, ?_⟩
  refine MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX _ P ?_
  change J.p (AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh).genericPoint = _
  rw [AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne, hy]

/-- The valuation of a divisor exceptional over the source `Y` of a junction, restricted to
`k(X)`, is not the valuation `ord_Q` of a prime divisor `Q` of `Y`. -/
private theorem comap_valuation_ne (J : CrepantJunction sX B I)
    {D : DivisorOver ℂ (J.p ≫ sX)} (hE : D.IsExceptional) (Q : MMP.Mori.PrimeDivisor J.Y) :
    haveI := J.isBirationalMorphism.isDominant
    D.valuation.comap (functionFieldMap J.p) ≠ (divisorOver J Q).valuation := by
  have := J.isBirationalMorphism.isDominant
  intro hv
  have hY : IsNormalVariety ℂ (J.p ≫ sX) := J.isQFactorial.1
  have hvY : D.valuation = (DivisorOver.ofPrimeDivisor ℂ hY Q).valuation := by
    refine comap_injective_of_surjective J.isBirationalMorphism.functionFieldMap_bijective.2
      (hv.trans ?_)
    ext g
    change Q.divisorialValuation (functionFieldMap J.p g) =
      Q.divisorialValuation (functionFieldMap (𝟙 J.Y) (functionFieldMap J.p g))
    rw [MMP.Mori.functionFieldMap_id_apply]
  exact ((MMP.Positivity.DivisorOver.two_le_codimension_center_iff hY D).mp
    (two_le_codimension_center_of_isExceptional hY D hE)) Q hvY

/-- A divisor exceptional over the source `Y` of a junction has, restricted to `k(X)`, a
valuation exceptional over `X`. -/
private theorem isExceptionalValuation_comap (J : CrepantJunction sX B I)
    (hX : IsNormalVariety ℂ sX) {D : DivisorOver ℂ (J.p ≫ sX)} (hE : D.IsExceptional)
    {D' : DivisorOver ℂ sX} (hD' : IsProper D'.f)
    (hv : haveI := J.isBirationalMorphism.isDominant
      D'.valuation = D.valuation.comap (functionFieldMap J.p)) :
    MMP.Intersection.IsExceptionalValuation ℂ sX D'.valuation := by
  refine ⟨D', hD', rfl, ?_⟩
  rw [MMP.Positivity.DivisorOver.two_le_codimension_center_iff hX]
  intro P hP
  obtain ⟨Q, hQ⟩ := exists_valuation_divisorOver_eq J hX P
  exact comap_valuation_ne J hE Q (hv.symm.trans (hP.trans hQ.symm))

/-- **Terminality over a junction extracting `I(X, B)`.** If the junction extracts exactly the
low-discrepancy set `I(X, B)`, then a divisor exceptional over its source `Y` has log
discrepancy `> 1` over `(X, B)`: its valuation is exceptional over `X` and differs from every
extracted valuation, whose centres on `Y` are divisors. -/
private theorem one_lt_of_isExceptional (J : CrepantJunction sX B I)
    (hI : (I : Set _) = lowDiscrepancySet sX B) (hX : IsNormalVariety ℂ sX)
    {D : DivisorOver ℂ (J.p ≫ sX)} (hE : D.IsExceptional) {b : ℝ}
    (hb : haveI := J.isBirationalMorphism.isDominant
      IsValuationLogDiscrepancy sX B (D.valuation.comap (functionFieldMap J.p)) b) : 1 < b := by
  have := J.isBirationalMorphism.isDominant
  by_contra! h1
  obtain ⟨-, D', hD'p, hv, -⟩ := id hb
  have hmem : D.valuation.comap (functionFieldMap J.p) ∈ (I : Set _) := by
    rw [hI]
    exact ⟨hv ▸ isExceptionalValuation_comap J hX hE hD'p hv, b, hb, h1⟩
  exact comap_valuation_ne J hE (J.E ⟨_, hmem⟩) (J.valuation_eq ⟨_, hmem⟩).symm

end Junction

/-- Every coefficient of the boundary of a klt pair on a normal variety is `< 1`: the log
discrepancy `1 - Θ_Γ` of a prime divisor `Γ` is positive. -/
private theorem coeff_lt_one_of_isKltPair {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} (hY : IsNormalVariety ℂ sY) {Θ : QDivisor Y}
    (hklt : IsKltPair sY Θ) (Γ : MMP.Mori.PrimeDivisor Y) : Θ.coeff Γ < 1 := by
  obtain ⟨-, nY, _, hKY, -⟩ := hklt.1.isPair
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hklt.1.isPair hKY
    (DivisorOver.ofPrimeDivisor ℂ hY Γ)
  have hprop : IsProper (DivisorOver.ofPrimeDivisor ℂ hY Γ).f := by
    change IsProper (𝟙 Y)
    infer_instance
  have hpos := hklt.2 nY _ _
    (MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hprop)
  rw [IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hY hc] at hpos
  push_cast at hpos
  exact_mod_cast (by linarith : ((Θ.coeff Γ : ℚ) : ℝ) < 1)

section Tail

variable {T : StabilizedTail} {i : ℕ}

/-- **`a_{i+1}(s) ≤ 1`.** The transport `s'` to `k(X_{i+1})` of a valuation `s ∈ I(X_i, B_i)`
lies in `I(X_{i+1}, B_{i+1})`, so its log discrepancy is at most `1`. -/
private theorem le_one_of_isTransportedValuation
    {s : Valuation (T.X i).functionField (WithZero (Multiplicative ℤ))}
    {s' : Valuation (T.X (i + 1)).functionField (WithZero (Multiplicative ℤ))}
    (hs : s ∈ lowDiscrepancySet (T.sX i) (T.B i)) (hss' : T.IsTransportedValuation i s s')
    {a : ℝ} (ha : IsValuationLogDiscrepancy (T.sX (i + 1)) (T.B (i + 1)) s' a) : a ≤ 1 := by
  have hst := T.isThreefoldStepDiagram i
  have : IsIntegral (T.Z i) := hst.isNormalVariety_target.1.toIsIntegral
  have := hst.isBirationalMorphism_minus.isDominant
  have := hst.isSmallMorphism_plus.isBirationalMorphism.isDominant
  have hmem : s.comap (functionFieldMap (T.f i)) ∈
      valuationsOver (T.f i) (lowDiscrepancySet (T.sX i) (T.B i)) := ⟨s, hs, rfl⟩
  rw [T.lowDiscrepancySet_eq i] at hmem
  obtain ⟨t, ⟨-, b, ⟨_, D, -, hv, hD⟩, hb1⟩, ht⟩ := hmem
  obtain rfl : t = s' := comap_injective_of_surjective
    hst.isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective.2 (ht.trans hss'.symm)
  obtain ⟨_, D', -, hv', hD'⟩ := ha
  rwa [← MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hD hD' (hv.trans hv'.symm)]

variable {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
  (hI : (I : Set _) = lowDiscrepancySet (T.sX i) (T.B i))
  {J : CrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}

include hI

/-- The decreased boundary is effective. -/
private theorem coeff_nonneg_of_isDecreasedBoundary (hΘ' : IsDecreasedBoundary J Θ')
    (Γ : MMP.Mori.PrimeDivisor J.Y) : 0 ≤ Θ'.coeff Γ := by
  obtain ⟨a, ha, rfl⟩ := hΘ'
  refine add_nonneg (inverseTransformDivisor_nonneg _ fun P => (T.isKltPair i).1.nonneg P)
    (Finset.sum_nonneg fun s _ => Finsupp.single_nonneg.mpr (sub_nonneg.mpr ?_)) Γ
  obtain ⟨s', hs', hs'a⟩ := ha s
  exact_mod_cast le_one_of_isTransportedValuation (hI ▸ s.2) hs' hs'a

/-- **Decreasing the boundary raises log discrepancies.** For a divisor `D` over `Y_i`,
`a(D; X_i, B_i) = a(D; Y_i, Θ_i) ≤ a(D; Y_i, Θ_i')`. -/
private theorem exists_le_isValuationLogDiscrepancy (hΘ' : IsDecreasedBoundary J Θ') {n : ℕ}
    {D : DivisorOver ℂ (J.p ≫ T.sX i)} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy (J.p ≫ T.sX i) n (QDivisor.toRDivisor Θ') D a) :
    haveI := J.isBirationalMorphism.isDominant
    ∃ b ≤ a, IsValuationLogDiscrepancy (T.sX i) (T.B i)
      (D.valuation.comap (functionFieldMap J.p)) b := by
  have := J.isBirationalMorphism.isDominant
  obtain ⟨-, -, hle⟩ := IsDecreasedBoundary.sub_eq_sum_and_le hI hΘ'
  obtain ⟨hPΘ, -, hcrep⟩ := J.isCrepant
  obtain ⟨-, nY, _, hKY, -⟩ := hPΘ.isPair
  have hDp : IsProper D.f := ha.2.1
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPΘ.isPair hKY D
  have hb := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hDp
  exact ⟨_, hle _ _ _ ⟨nY, D, hDp, rfl, hb⟩ ⟨n, D, hDp, rfl, ha⟩,
    (hcrep _ _).mp ⟨nY, D, hDp, rfl, hb⟩⟩

end Tail

/-- **The decreased threefold pair is terminal.** Let `(p_i, Θ_i)` be a crepant junction of
`(X_i, B_i)` extracting `I_∞ = I(X_i, B_i)`, and `Θ_i'` its decreased boundary. Then
`(Y_i, Θ_i')` is a terminal pair and every coefficient of `Θ_i'` lies in `[0, 1)`. -/
@[mmp "lem_mmp_indexc_decrease_terminal"]
public theorem IsDecreasedBoundary.isKltTerminalPair_and_coeff_mem_Ico {T : StabilizedTail}
    {i : ℕ} {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (hI : (I : Set _) = lowDiscrepancySet (T.sX i) (T.B i))
    {J : CrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}
    (hΘ' : IsDecreasedBoundary J Θ') :
    IsKltTerminalPair (J.p ≫ T.sX i) Θ' ∧
      ∀ Γ : MMP.Mori.PrimeDivisor J.Y, 0 ≤ Θ'.coeff Γ ∧ Θ'.coeff Γ < 1 := by
  have hY : IsNormalVariety ℂ (J.p ≫ T.sX i) := J.isQFactorial.1
  have hnonneg := coeff_nonneg_of_isDecreasedBoundary hI hΘ'
  obtain ⟨hPΘ, -, -⟩ := J.isCrepant
  obtain ⟨-, nY, KY, hKY, -⟩ := hPΘ.isPair
  have hklt : IsKltPair (J.p ≫ T.sX i) Θ' := ⟨⟨hPΘ.isAlgClosed, hPΘ.charZero,
      ⟨hY, nY, KY, hKY, isQCartier_of_isQFactorial _ J.isQFactorial _⟩, hnonneg⟩,
    fun _ _ _ ha => by
      obtain ⟨b, hba, n', D', -, -, hD'⟩ :=
        exists_le_isValuationLogDiscrepancy hI hΘ' ha
      exact ((T.isKltPair i).2 n' D' b hD').trans_le hba⟩
  refine ⟨⟨hklt, fun _ _ _ hE ha => ?_⟩, fun Γ => ⟨hnonneg Γ, coeff_lt_one_of_isKltPair hY hklt Γ⟩⟩
  obtain ⟨b, hba, hb⟩ := exists_le_isValuationLogDiscrepancy hI hΘ' ha
  exact (one_lt_of_isExceptional J hI (T.isKltPair i).1.isPair.1 hE hb).trans_le hba

/-! ### No divisor is lost in a bridge programme -/

/-- The birational map `f'⁻¹ ∘ f : X ⤏ X'` of two birational morphisms to a separated scheme is a
birational map over the target. -/
private theorem exists_isBirational_compHom_eq {X X' Y : Scheme.{0}} [IsReduced X]
    [IsReduced X'] [IsSeparated (Y ↘ ⊤_ Scheme)] {f : X ⟶ Y} {f' : X' ⟶ Y}
    (hf : IsBirationalMorphism f) (hf' : IsBirationalMorphism f') :
    ∃ φ : MMP.Mori.RationalMap X X', MMP.Mori.RationalMap.IsBirational φ ∧
      φ.compHom f' = f.toRationalMap := by
  obtain ⟨em, hem⟩ := hf
  obtain ⟨ep, hep⟩ := hf'
  have h1 := MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq em f (𝟙 Y) hem
  have h2 := MMP.Fourfold.PartialIso.isOver_comp_of_toRationalMap_eq ep f' (𝟙 Y) hep
  set e := em.trans ep.symm
  have H : e.IsOver (f ≫ 𝟙 Y) (f' ≫ 𝟙 Y) := h1.trans h2.symm
  have H' : e.iso.hom ≫ e.target.ι ≫ f' = e.source.ι ≫ f := by
    simpa only [Scheme.PartialIso.IsOver, Category.comp_id] using H
  refine ⟨e.toRationalMap, MMP.Mori.RationalMap.isBirational_toRationalMap e, ?_⟩
  rw [← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨e.source, e.dense_source, le_rfl, le_top, ?_⟩
  change X.homOfLE (le_rfl : e.source ≤ e.source) ≫ (e.iso.hom ≫ e.target.ι) ≫ f' =
    X.homOfLE (le_top : e.source ≤ ⊤) ≫ X.topIso.hom ≫ f
  rw [Category.assoc, H']
  simp

section IntersectionNumbers

section Intersection

open MMP.Flips

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

variable (k sX) [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X]

/-- `L · C` is the degree of `𝒪_X(L)` along `C`: every proper curve has a normalization, which is
birational, so of degree one. -/
private theorem isCartierIntersectionNumber_degreeOn (C : ProperCurve sX) (L : Divisor X)
    (hL : L.IsCartier) :
    IsCartierIntersectionNumber k sX C L hL (L.degreeOn k sX C.ι C.dim_le hL) := by
  let p := C.ι ≫ sX
  have : AlgebraicGeometry.IsCurve k p := C.isCurve
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k p
  have hvar : AlgebraicGeometry.IsVariety k (normalizationOverField k p ≫ p) :=
    isVariety_normalizationOverField k p
  have : IsIntegral (normalizationSchemeOverField k p) := hvar.toIsIntegral
  have : IsFinite (normalizationOverField k p) := isFinite_normalizationOverField k p
  have hν : IsCurveNormalization (normalizationOverField k p) :=
    { isIntegral := inferInstance
      isNormal := Scheme.isNormal_normalizationScheme C.scheme hX
      isFinite := inferInstance
      isBirationalMorphism := by
        have : Finite (irreducibleComponents (normalizationSchemeOverField k p)) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        have : Finite (irreducibleComponents C.scheme) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        obtain ⟨U, V, hUV, hU, hV, hiso⟩ := exists_dense_opens_isIso_resLE_of_isBirational
          (normalizationOverField k p) (Scheme.isBirational_normalization C.scheme hX)
          (Or.inl ⟨inferInstance, inferInstance⟩)
        exact isBirationalMorphism_of_isIso_resLE _ U V hU.nonempty hV.nonempty hUV hiso }
  have hdim := (topologicalKrullDim_normalizationSchemeOverField k p).le.trans C.dim_le
  refine ⟨_, _, hν, hdim, ?_⟩
  have : IsProper ((normalizationOverField k p ≫ C.ι) ≫ sX) := by
    rw [Category.assoc]; infer_instance
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := hL.isInvertibleModule_divisorialSheaf
  exact (Oai4C1.Negativity.degreeOn_normalization C hν hdim _).symm

end Intersection

section Crepancy

/-- The order of `c ^ m * g⁻¹` along a point, for nonzero rational functions `c` and `g`. -/
private theorem ord_zpow_mul_inv {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] (z : Y)
    {c g : Y.functionField} (hc : c ≠ 0) (hg : g ≠ 0) (m : ℤ) :
    Y.ord (c ^ m * g⁻¹) z = m * Y.ord c z - Y.ord g z := by
  rw [Scheme.ord_mul (zpow_ne_zero _ hc) (inv_ne_zero hg), MMP.Mori.ord_zpow _ hc,
    ← zpow_neg_one, MMP.Mori.ord_zpow _ hg]
  ring

variable {k : Type u} [Field k] [PerfectField k] {X U : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral U] [CompactSpace U] [IsLocallyNoetherian U] [IsNormal U]

/-- Coefficientwise crepancy: along a prime divisor `F` of `U`, the pull-back of a Cartier
multiple `E = m (K + B)` has coefficient `m (ord_F div(p^*ω) + Δ_F)` when `K = div(ω)`. -/
private theorem coeff_pullback_eq {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX) {p : U ⟶ X}
    [IsDominant p] [LocallyOfFiniteType (p ≫ sX)]
    (hY : IsNormalVariety k (p ≫ sX)) (hp : IsBirationalMorphism p) {n n' : ℕ} {K : Divisor X}
    (hK' : K.IsCanonicalDivisor sX n') {B : QDivisor X} {Δ : QDivisor U}
    (hcrep : IsCrepantBoundary sX n K B p hY hp Δ) {m : ℕ} (hm0 : 0 < m) {E : Divisor X}
    (hE : Divisor.toQDivisor E = (m : ℤ) • (Divisor.toQDivisor K + B)) (hEc : E.IsCartier)
    {hB : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉ E.supp}
    {Dp : Divisor U} (hDp : E.IsPullback p hB Dp) {ω : RationalPluriForms sX n' 1}
    (hω0 : ω ≠ 0) (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = K.coeff Γ)
    (F : MMP.Mori.PrimeDivisor U) :
    (Dp.coeff F : ℚ) =
      m * ((divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F + Δ.coeff F) := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have hK := (hcrep F).2.1
  obtain rfl : n = n' := by exact_mod_cast hK.1.symm.trans hK'.1
  have hn := hK.topologicalKrullDim_eq
  set D : DivisorOver k sX := ⟨U, p, hY, hp, F⟩ with hD
  obtain ⟨b, N', hb0⟩ := D.exists_ordPullback_eq hX hn
  have hb : ∀ (m : ℤ) (τ : RationalPluriForms sX n m), τ ≠ 0 → D.ordPullback τ =
      U.ord (functionFieldMap p ((ZTensorPower.basis b m).repr τ ())) F.genericPoint + m * N' :=
    hb0
  let := functionFieldAlgebra sX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨V, hxV, φ, hφ⟩ := hEc (p F.genericPoint)
  let Z0 : irreducibleComponents X := ⟨Set.univ, by
    rw [irreducibleComponents_eq_singleton]; simp⟩
  set c := (ZTensorPower.basis b 1).repr ω () with hc_def
  have hc : c ≠ 0 := repr_ne_zero_of_ne_zero b hω0
  set g := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : RationalFunctions X) with hg_def
  have hg : g ≠ 0 := (φ.isUnit.map _).ne_zero
  set c'' : X.functionField := c ^ (m : ℤ) * g⁻¹ with hc''_def
  have hc'' : c'' ≠ 0 := mul_ne_zero (zpow_ne_zero _ hc) (inv_ne_zero hg)
  let τ : RationalPluriForms sX n m := c'' • ZTensorPower.basis b (m : ℤ) ()
  have hτr : (ZTensorPower.basis b (m : ℤ)).repr τ () = c'' := by simp [τ]
  have hτ0 : τ ≠ 0 := smul_ne_zero hc'' ((ZTensorPower.basis b (m : ℤ)).ne_zero ())
  have hKcoeff : ∀ Γ : MMP.Mori.PrimeDivisor X, ∃ NΓ : ℤ,
      (K.coeff Γ : ℤ) = X.ord c Γ.genericPoint + NΓ ∧
      (Γ.ordForm τ : ℤ) = m * X.ord c Γ.genericPoint - X.ord g Γ.genericPoint + m * NΓ := by
    intro Γ
    obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
    refine ⟨NΓ, ?_, ?_⟩
    · rw [← hωK Γ, hNΓ 1 ω hω0]
      simp [hc_def]
    · rw [hNΓ _ τ hτ0, hτr, hc''_def, ord_zpow_mul_inv _ hc hg]
  have hgord : ∀ Γ : MMP.Mori.PrimeDivisor X, (Γ.support ∩ V).Nonempty →
      X.ord g Γ.genericPoint = E.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ hΓ, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    have : Γ.component = Z0 :=
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _
    rw [this]
  have hCq : ∀ Γ : MMP.Mori.PrimeDivisor X,
      (E.coeff Γ : ℚ) = m * (K.coeff Γ + B.coeff Γ) := by
    intro Γ
    have := congrArg (fun D : QDivisor X => D.coeff Γ) hE
    rw [mul_add]
    simpa [zsmul_eq_mul] using this
  have hgen : GeneratesOn B m V τ := by
    refine ⟨hτ0, fun Γ hΓ => ?_⟩
    obtain ⟨NΓ, h1, h2⟩ := hKcoeff Γ
    have h3 := hgord Γ hΓ
    qify at h1 h2 h3
    linear_combination h2 - hCq Γ - h3 - (m : ℚ) * h1
  have hKY : (divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F =
      U.ord (functionFieldMap p c) F.genericPoint + N' := by
    have h := hb 1 ω hω0
    have e : D.ordPullback ω = (divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F := by
      rw [coeff_divisorOfForm]
      rfl
    rw [← e, h]
    simp [hc_def]
  have hcoeff : Dp.coeff F = U.ord (functionFieldMap p g) F.genericPoint :=
    MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hDp hφ F hxV Z0
  have hgY : functionFieldMap p g ≠ 0 := (map_ne_zero _).mpr hg
  have hcY : functionFieldMap p c ≠ 0 := (map_ne_zero _).mpr hc
  have hordτ : D.ordPullback τ = m * U.ord (functionFieldMap p c) F.genericPoint
      - U.ord (functionFieldMap p g) F.genericPoint + m * N' := by
    rw [hb _ τ hτ0, hτr, hc''_def, map_mul, map_zpow₀, map_inv₀, ord_zpow_mul_inv _ hcY hgY]
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm0.ne'
  have hdisc : IsDiscrepancy sX n K B D
      ((divisorOfForm (pullbackRationalPluriForms sX p ω)).coeff F - Dp.coeff F / m) := by
    refine ⟨hX, hK, m, hm0, ⟨E, hE, hEc⟩, V, hxV, τ, hgen, ?_⟩
    qify at hordτ hKY hcoeff
    rw [hordτ, hKY, hcoeff]
    field_simp
    ring
  have heq := IsDiscrepancy.eq (hcrep F) hdisc
  field_simp at heq
  linear_combination heq

/-- **Crepancy as a pull-back.** If `Δ` is the crepant boundary of `(X, B)` on `U` and
`K = div(ω)`, then `div(p^*ω) + Δ = p^*(K + B)`. -/
private theorem isPullback_divisorOfForm_add {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX)
    {p : U ⟶ X} [IsDominant p] [LocallyOfFiniteType (p ≫ sX)]
    (hY : IsNormalVariety k (p ≫ sX)) (hp : IsBirationalMorphism p) {n n' : ℕ} {K : Divisor X}
    (hK' : K.IsCanonicalDivisor sX n') {B : QDivisor X} {Δ : QDivisor U}
    (hcrep : IsCrepantBoundary sX n K B p hY hp Δ) {ω : RationalPluriForms sX n' 1}
    (hω0 : ω ≠ 0) (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = K.coeff Γ)
    (hLB : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉
      (Divisor.toQDivisor K + B).supp) :
    (Divisor.toQDivisor K + B).IsPullback p hLB
      (Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms sX p ω)) + Δ) := by
  intro m hm D hD hDc
  have hB' : ∀ Z : irreducibleComponents U, p (componentGenericPoint U Z) ∉ D.supp :=
    fun Z hZ => hLB Z (by
      rwa [QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD] at hZ)
  refine ⟨D.pullback hDc hB', ?_, Divisor.isPullback_pullback hDc hB'⟩
  ext F
  have h := coeff_pullback_eq hX hY hp hK' hcrep hm hD hDc
    (Divisor.isPullback_pullback hDc hB') hω0 hωK F
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, zsmul_eq_mul,
    Divisor.coeff_toQDivisor, Int.cast_natCast]
  exact h

end Crepancy

section Curves

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- Intersection numbers of `K + Δ` along a curve depend on `K` only up to linear equivalence. -/
private theorem intersectionNumber_add_eq_of_linearlyEquivalent [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (sX : X ⟶ Spec (.of k)) [QuasiCompact sX]
    {C : Scheme.{u}} (i : C ⟶ X)
    [IsProper (i ≫ sX)] (hdim : topologicalKrullDim C ≤ 1) {K₁ K₂ : Divisor X}
    (h : K₁.LinearlyEquivalent K₂) (Δ : QDivisor X) (h₁ : (Divisor.toQDivisor K₁ + Δ).IsQCartier)
    (h₂ : (Divisor.toQDivisor K₂ + Δ).IsQCartier) :
    (Divisor.toQDivisor K₁ + Δ).intersectionNumber k sX i hdim h₁ =
      (Divisor.toQDivisor K₂ + Δ).intersectionNumber k sX i hdim h₂ := by
  obtain ⟨D', hD', hD'c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul h₂
  set m := (Divisor.toQDivisor K₂ + Δ).cartierIndex h₂
  have hm := QDivisor.cartierIndex_pos h₂
  obtain ⟨φ, hφ⟩ := h
  set a : Additive (RationalFunctions X)ˣ := (m : ℤ) • Additive.ofMul φ with ha
  set G := D' + principalDivisorHom a with hG_def
  have hGc : G.IsCartier := hD'c.add (Divisor.isCartier_principalDivisor _)
  have hG : Divisor.toQDivisor G = (m : ℤ) • (Divisor.toQDivisor K₁ + Δ) := by
    have e : principalDivisorHom a = (m : ℤ) • (K₁ - K₂) := by
      rw [ha, map_zsmul, principalDivisorHom_apply, toMul_ofMul, hφ]
    rw [hG_def, e, map_add, hD', map_zsmul, map_sub, ← smul_add]
    congr 1
    abel
  have hGD : G.LinearlyEquivalent D' := ⟨a.toMul, by
    rw [hG_def, add_sub_cancel_left, principalDivisorHom_apply]⟩
  rw [QDivisor.intersectionNumber_eq_of_smul k sX i hdim _ h₁ hm G hGc hG,
    QDivisor.intersectionNumber_eq_of_smul k sX i hdim _ h₂ hm D' hD'c hD']
  congr 2
  have := hGc.isInvertibleModule_divisorialSheaf
  have := hD'c.isInvertibleModule_divisorialSheaf
  exact degreeOn_eq_of_iso k sX i hdim hGD.divisorialSheafIso

/-- Intersection numbers are unchanged by an isomorphism of curves over `X`. -/
private theorem intersectionNumber_eq_of_iso_comp [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of k)) [QuasiCompact sX] {C C' : Scheme.{u}} (i : C ⟶ X) (i' : C' ⟶ X)
    [IsProper (i ≫ sX)] [IsProper (i' ≫ sX)] (hdim : topologicalKrullDim C ≤ 1)
    (hdim' : topologicalKrullDim C' ≤ 1) (e : C ≅ C') (he : e.hom ≫ i' = i) (D : QDivisor X)
    (hD : D.IsQCartier) :
    D.intersectionNumber k sX i hdim hD = D.intersectionNumber k sX i' hdim' hD := by
  have := QuasiCompact.compactSpace_of_compactSpace sX
  unfold QDivisor.intersectionNumber Divisor.degreeOn
  have := (QDivisor.isCartierDivisor_cartierIndex_smul hD).isCartier_toDivisor
    |>.isInvertibleModule_divisorialSheaf
  rw [MMP.Threefold.Resolution.degreeOn_eq_of_iso_comp k sX i i' hdim hdim' e he]

/-- Two closed subschemes cut out by equal ideal sheaves are isomorphic over `X`. -/
private theorem exists_iso_subscheme_of_eq {I J : X.IdealSheafData} (h : I = J) :
    ∃ e : I.subscheme ≅ J.subscheme, e.hom ≫ J.subschemeι = I.subschemeι := by
  subst h
  exact ⟨Iso.refl _, by simp⟩

end Curves

/-- The divisors of two nonzero rational top forms on a normal variety are linearly
equivalent. -/
private theorem linearlyEquivalent_divisorOfForm {k : Type u} [Field k] [PerfectField k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] [LocallyOfFiniteType sX] (hX : IsNormalVariety k sX) {n : ℕ}
    (hn : topologicalKrullDim X = n) {τ ω : RationalPluriForms sX n 1} (hτ : τ ≠ 0)
    (hω : ω ≠ 0) : Divisor.LinearlyEquivalent (divisorOfForm τ) (divisorOfForm ω) := by
  let := functionFieldAlgebra sX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨b⟩ := MMP.Positivity.exists_basis_topForms hX hn
  set c := (ZTensorPower.basis b 1).repr ω () with hc_def
  set e := (ZTensorPower.basis b 1).repr τ () with he_def
  have hc : c ≠ 0 := repr_ne_zero_of_ne_zero b hω
  have he : e ≠ 0 := repr_ne_zero_of_ne_zero b hτ
  obtain ⟨φ, hφ⟩ := MMP.Positivity.exists_units_of_ne_zero (mul_ne_zero he (inv_ne_zero hc))
  refine ⟨φ, ?_⟩
  ext Γ
  obtain ⟨N, hN⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
  have e1 := hN 1 ω hω
  have e2 := hN 1 τ hτ
  rw [← hc_def] at e1
  rw [← he_def] at e2
  rw [DivisorWithCoeffs.coeff_sub, coeff_principalDivisor, hφ Γ,
    Scheme.ord_mul he (inv_ne_zero hc), ← zpow_neg_one, ord_zpow _ hc, coeff_divisorOfForm,
    coeff_divisorOfForm, e1, e2]
  ring

/-- `((-D) · C) = -(D · C)`. -/
private theorem intersectionNumber_neg (k : Type u) [Field k] {X C : Scheme.{u}}
    [IsLocallyNoetherian X] [IsNormal X] (sX : X ⟶ Spec (.of k)) [QuasiCompact sX]
    (i : C ⟶ X) [IsProper (i ≫ sX)] (hdim : topologicalKrullDim C ≤ 1) {D : QDivisor X}
    (hD : D.IsQCartier) (hD' : (-D).IsQCartier) :
    (-D).intersectionNumber k sX i hdim hD' = -(D.intersectionNumber k sX i hdim hD) := by
  have hadd := QDivisor.intersectionNumber_add' k sX i hdim D (-D) hD hD'
    (by rw [add_neg_cancel]; exact QDivisor.isQCartier_zero)
  rw [MMP.Fourfold.intersectionNumber_congr sX i hdim _ QDivisor.isQCartier_zero (add_neg_cancel D),
    MMP.Fourfold.intersectionNumber_zero sX i hdim] at hadd
  linarith

/-- **Projection onto the image curve.** Let `L' = u^*L` be the pull-back of a `ℚ`-Cartier
`ℚ`-divisor along a proper morphism `u : V ⟶ W` of normal varieties and `C ⊆ V` a proper curve
whose image `u(C)` is not a point. Then `u(C)` is a proper curve `C''` of `W` with generic point
`u(η_C)`, and `(L' · C) = d (L · C'')` with `d = [k(C) : k(C'')] > 0`. -/
private theorem exists_intersectionNumber_pullback_eq_mul {k : Type u} [Field k]
    {V W : Scheme.{u}} {sV : V ⟶ Spec (.of k)} {sW : W ⟶ Spec (.of k)}
    [AlgebraicGeometry.IsVariety k sV] [AlgebraicGeometry.IsVariety k sW]
    [IsLocallyNoetherian V] [IsNormal V] [IsLocallyNoetherian W] [IsNormal W]
    (u : V ⟶ W) [IsProper u] (hu : u ≫ sW = sV) {L : QDivisor W} (hL : L.IsQCartier)
    {hLB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ L.supp}
    {L' : QDivisor V} (h : L.IsPullback u hLB L') (hL' : L'.IsQCartier) (C : ProperCurve sV)
    (hpt : ¬ ∃ w : W, Set.range (C.ι ≫ u) = {w}) :
    ∃ C'' : ProperCurve sW, C''.point = u C.point ∧ ∃ d : ℚ, 0 < d ∧
      L'.intersectionNumber k sV C.ι C.dim_le hL' =
        d * L.intersectionNumber k sW C''.ι C''.dim_le hL := by
  have := C.isCurve
  set φ := C.ι ≫ u with hφ
  have : AlgebraicGeometry.IsCurve k (φ ≫ sW) := by rw [hφ, Category.assoc, hu]; infer_instance
  have : IsProper (φ ≫ sW) := by rw [hφ, Category.assoc, hu]; infer_instance
  have hcurve := isCurve_imageι_comp sW φ hpt
  have key := intersectionNumber_pullback_eq_degreeOver_mul k sV sW u hu C.ι hL h hcurve
  obtain ⟨e, he⟩ := exists_iso_subscheme_of_eq (C.ker_comp (f := u))
  have : IsProper φ := IsProper.of_comp φ sW
  have : IsProper (φ.imageι ≫ sW) := isProper_imageι_comp φ sW
  have hdim : topologicalKrullDim (curveSubschemeAt (u C.point)) = 1 :=
    (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso e).isHomeomorph).symm.trans
      hcurve.topologicalKrullDim_eq_one
  have hι : curveSubschemeAtι (u C.point) = e.inv ≫ φ.imageι := by
    rwa [Iso.eq_inv_comp]
  have hprop : IsProper (curveSubschemeAtι (u C.point) ≫ sW) := by
    rw [hι, Category.assoc]; infer_instance
  let C'' : ProperCurve sW := ⟨u C.point, ⟨hdim, hprop⟩⟩
  have hφs : φ.toImage ≫ φ.imageι ≫ sW = C.ι ≫ sV := by
    rw [← Category.assoc, Scheme.Hom.toImage_imageι, hφ, Category.assoc, hu]
  have : LocallyOfFiniteType φ.toImage := by
    have : LocallyOfFiniteType (φ.toImage ≫ φ.imageι ≫ sW) := by
      rw [hφs]; infer_instance
    exact locallyOfFiniteType_of_comp φ.toImage (φ.imageι ≫ sW)
  have hnc : ¬ ∃ y : φ.image, ∀ x : C.scheme, φ.toImage.base x = y := by
    rintro ⟨y, hy⟩
    have hφy : ∀ x, φ x = φ.imageι y := fun x => by
      calc φ x = (φ.toImage ≫ φ.imageι) x := by rw [Scheme.Hom.toImage_imageι]
        _ = φ.imageι y := by rw [Scheme.Hom.comp_apply, hy x]
    obtain ⟨x⟩ : Nonempty C.scheme := inferInstance
    exact hpt ⟨φ.imageι y, Set.eq_singleton_iff_unique_mem.mpr
      ⟨⟨x, hφy x⟩, by rintro _ ⟨x, rfl⟩; exact hφy x⟩⟩
  have hdeg : 0 < degreeOver φ.toImage :=
    degreeOver_pos_of_not_constant k (C.ι ≫ sV) (φ.imageι ≫ sW) φ.toImage hφs hnc
  refine ⟨C'', rfl, (degreeOver φ.toImage : ℚ), by exact_mod_cast hdeg, key.trans ?_⟩
  rw [intersectionNumber_eq_of_iso_comp sW φ.imageι C''.ι _ C''.dim_le e he _ hL]

/-- **Projection of a contracted curve.** With `L' = u^*L` as in
`exists_intersectionNumber_pullback_eq_mul` and `C ⊆ V` a proper curve contracted by `u ≫ f`,
either `(L' · C) = 0` (when `u(C)` is a point), or `(L' · C) = d (L · u(C))` with `d ≥ 0`, where
`u(C)` is a proper curve of `W` contracted by `f`. -/
private theorem intersectionNumber_pullback_eq_zero_or {k : Type u} [Field k]
    {V W Y : Scheme.{u}} {sV : V ⟶ Spec (.of k)} {sW : W ⟶ Spec (.of k)}
    [AlgebraicGeometry.IsVariety k sV] [AlgebraicGeometry.IsVariety k sW]
    [IsLocallyNoetherian V] [IsNormal V] [IsLocallyNoetherian W] [IsNormal W]
    (u : V ⟶ W) [IsProper u] (hu : u ≫ sW = sV) (f : W ⟶ Y) {L : QDivisor W}
    (hL : L.IsQCartier)
    {hLB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ L.supp}
    {L' : QDivisor V} (h : L.IsPullback u hLB L') (hL' : L'.IsQCartier) (C : ProperCurve sV)
    (hC : C.IsContractedBy (u ≫ f)) :
    L'.intersectionNumber k sV C.ι C.dim_le hL' = 0 ∨
      ∃ d : ℚ, 0 ≤ d ∧ ∃ C'' : ProperCurve sW, C''.IsContractedBy f ∧
        L'.intersectionNumber k sV C.ι C.dim_le hL' =
          d * L.intersectionNumber k sW C''.ι C''.dim_le hL := by
  have := C.isCurve
  by_cases hpt : ∃ w : W, Set.range (C.ι ≫ u) = {w}
  · exact .inl (intersectionNumber_pullback_eq_zero k sV sW u hu C.ι hL h hpt)
  obtain ⟨C'', hC''u, d, hd, heq⟩ :=
    exists_intersectionNumber_pullback_eq_mul u hu hL h hL' C hpt
  refine .inr ⟨d, hd.le, C'', fun x hx => ?_, heq⟩
  have hsub : closure ({u C.point} : Set W) ⊆ u '' closure ({C.point} : Set V) :=
    (u.isClosedMap _ isClosed_closure).closure_subset_iff.mpr (by
      rintro _ rfl; exact ⟨C.point, subset_closure rfl, rfl⟩)
  rw [hC''u] at hx ⊢
  obtain ⟨z, hz, rfl⟩ := hsub hx
  simpa only [Scheme.Hom.comp_apply] using hC z hz

/-- An exceptional prime divisor of a morphism maps its generic point to a point of coheight at
least two. -/
private theorem two_le_coheight_of_isExceptional {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {f : Y ⟶ X} (E : MMP.Mori.PrimeDivisor Y)
    (hE : RationalMap.IsExceptional (X := Y) f.toRationalMap E) :
    2 ≤ Order.coheight (f E.genericPoint) := by
  set η := E.genericPoint
  have hdef : RationalMap.DefinedAt (X := Y) f.toRationalMap η := by
    rw [RationalMap.DefinedAt, RationalMap.dom_toRationalMap_hom]
    trivial
  have h2 := (RationalMap.isExceptional_iff.mp hE) hdef
  have hsub : (TopologicalSpace.IrreducibleCloseds.closureSingleton (f η) : Set X) ⊆
      (RationalMap.transform (X := Y) f.toRationalMap E.idealSheaf.support : Set X) := by
    rw [TopologicalSpace.IrreducibleCloseds.coe_closureSingleton]
    refine (TopologicalSpace.Closeds.isClosed _).closure_subset_iff.mpr ?_
    rintro _ rfl
    refine RationalMap.image_subset_transform f.toPartialMap rfl _ ?_
    rw [MMP.Positivity.image_toPartialMap_hom]
    refine ⟨η, ?_, rfl⟩
    change η ∈ E.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have hle := le_closedsCodimension_iff.mp h2 _ hsub
  have hcodim : codimension (TopologicalSpace.IrreducibleCloseds.closureSingleton (f η)) =
      Order.coheight (f η) := by
    have h : TopologicalSpace.IrreducibleCloseds.closureSingleton (f η) =
        irreducibleSetEquivPoints.symm (f η) :=
      TopologicalSpace.IrreducibleCloseds.ext (by
        rw [TopologicalSpace.IrreducibleCloseds.coe_closureSingleton,
          coe_irreducibleEquivPoints_symm_apply])
    rw [codimension_eq_coheight, h]
    exact Order.coheight_orderIso irreducibleSetEquivPoints.symm (f η)
  rwa [hcodim] at hle

end IntersectionNumbers

/-! ### Positivity, negativity and the projection formula -/

section Negativity

/-- **The negativity lemma for `ℚ`-Cartier divisors.** Let `f : Y ⟶ X` be a proper birational
morphism of normal varieties and `B` a `ℚ`-Cartier divisor on `Y` with `(B · C) ≤ 0` on every
curve contracted by `f`, whose coefficients along the prime divisors not exceptional over `X` are
nonnegative. Then `B` is effective. -/
private theorem nonneg_of_intersectionNumber_nonpos {k : Type u} [Field k] {X Y : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)} [QuasiCompact sY] [IsLocallyNoetherian X]
    [IsNormal X] [IsLocallyNoetherian Y] [IsNormal Y] (hX : IsNormalVariety k sX)
    (hY : IsNormalVariety k sY) (f : Y ⟶ X) (hf : f ≫ sX = sY) [IsProper f]
    (hfb : IsBirationalMorphism f) {B : QDivisor Y} (hB : B.IsQCartier)
    (hnef : ∀ C : ProperCurve sY, C.IsContractedBy f →
      B.intersectionNumber k sY C.ι C.dim_le hB ≤ 0)
    (hBG : ∀ P : MMP.Mori.PrimeDivisor Y, ¬ MMP.Flips.IsExceptionalPrimeDivisor sX f P →
      0 ≤ B.coeff P) :
    0 ≤ B := by
  obtain ⟨E, hEB, hEc⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hB
  have hm : 0 < B.cartierIndex hB := QDivisor.cartierIndex_pos hB
  set m := B.cartierIndex hB with hm_def
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  set BR := QDivisor.toRDivisor B with hBR
  have hBRE : BR = ((1 : ℝ) / m) • Divisor.toRDivisor E := by
    ext P
    have h1 := congrArg (fun D : QDivisor Y => D.coeff P) hEB
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h1
    change (QDivisor.toRDivisor B).coeff P = (((1 : ℝ) / m) • Divisor.toRDivisor E).coeff P
    rw [DivisorWithCoeffs.coeff_smul, QDivisor.coeff_toRDivisor, Divisor.coeff_toRDivisor,
      smul_eq_mul]
    have h2 : ((E.coeff P : ℚ) : ℝ) = ((m * B.coeff P : ℚ) : ℝ) := by rw [h1]
    push_cast at h2
    rw [h2]
    field_simp
  have hL0 : MMP.Flips.IsCartierCombination (0 : RDivisor X) :=
    ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩
  have hpb0 : MMP.Flips.IsRCartierPullback f (0 : RDivisor X) 0 :=
    ⟨0, Fin.elim0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp, fun j => j.elim0, by simp⟩
  have hBRc : MMP.Flips.IsCartierCombination BR :=
    ⟨1, fun _ => 1 / (m : ℝ), fun _ => E, fun _ => hEc, by
      rw [Fin.sum_univ_one, ← MMP.Flips.toRDivisor_eq_mapCoeffs]
      exact hBRE⟩
  have hMc : MMP.Flips.IsCartierCombination (-BR) :=
    ⟨1, fun _ => -(1 / (m : ℝ)), fun _ => E, fun _ => hEc, by
      rw [Fin.sum_univ_one, ← MMP.Flips.toRDivisor_eq_mapCoeffs, hBRE, neg_smul]⟩
  have hpres : -BR = ∑ j : Fin 1, (fun _ => -(1 / (m : ℝ))) j •
      Divisor.toRDivisor ((fun _ => E) j) := by
    rw [Fin.sum_univ_one, hBRE, neg_smul]
  have hMnef : MMP.Flips.IsRelativelyNef k sY f (-BR) := by
    refine ⟨1, fun _ => -(1 / (m : ℝ)), fun _ => E, fun _ => hEc, hpres, fun C hC x hx => ?_⟩
    have hx₀ : MMP.Flips.IsRIntersectionNumber k sY (-BR) (fun _ => -(1 / (m : ℝ)))
        (fun _ => E) C (∑ j : Fin 1, (fun _ => -(1 / (m : ℝ))) j *
          ((E.degreeOn k sY C.ι C.dim_le hEc : ℤ) : ℝ)) :=
      ⟨fun _ => hEc, fun _ => E.degreeOn k sY C.ι C.dim_le hEc, hpres,
        fun _ => isCartierIntersectionNumber_degreeOn k sY C E hEc, rfl⟩
    rw [(MMP.Flips.IsRIntersectionNumber.eq_and_linear k sY C).1 _ _ _ _ _ _ _ hx hx₀,
      Fin.sum_univ_one]
    have hI := hnef C hC
    rw [QDivisor.intersectionNumber_eq_of_smul k sY C.ι C.dim_le B hB hm E hEc hEB] at hI
    have hmq : (0 : ℚ) < m := by exact_mod_cast hm
    have hdeg : (E.degreeOn k sY C.ι C.dim_le hEc : ℚ) ≤ 0 := by
      have := mul_nonpos_of_nonneg_of_nonpos hmq.le hI
      rwa [mul_div_cancel₀ _ hmq.ne'] at this
    have hdeg' : ((E.degreeOn k sY C.ι C.dim_le hEc : ℤ) : ℝ) ≤ 0 := by exact_mod_cast hdeg
    have hmr : (0 : ℝ) < m := by exact_mod_cast hm
    have : 0 ≤ -(1 / (m : ℝ)) * ((E.degreeOn k sY C.ι C.dim_le hEc : ℤ) : ℝ) := by
      rw [neg_mul]
      exact neg_nonneg.mpr (mul_nonpos_of_nonneg_of_nonpos (by positivity) hdeg')
    exact this
  have hBG' : ∀ P : MMP.Mori.PrimeDivisor Y, ¬ MMP.Flips.IsExceptionalPrimeDivisor sX f P →
      0 ≤ BR.coeff P := fun P hP => by
    rw [hBR, QDivisor.coeff_toRDivisor]
    exact_mod_cast hBG P hP
  have hnum : MMP.Flips.IsNumericallyEquivalentOver k sY f (0 : RDivisor Y) (-BR + BR) := by
    refine ⟨⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩, by
      rw [neg_add_cancel]; exact ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
      fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h₁ h₂ => ?_⟩
    rw [neg_add_cancel] at h₂
    exact (MMP.Flips.IsRIntersectionNumber.eq_and_linear k sY C).1 _ _ _ _ _ _ _ h₁ h₂
  have heff := MMP.Flips.isEffective_of_isNumericallyEquivalentOver_pullback k sX sY hX hY f hf
    hfb hL0 hpb0 hMc hMnef hBRc hBG' hnum
  refine Finsupp.le_def.mpr fun P => ?_
  have hP := heff P
  rw [hBR, QDivisor.coeff_toRDivisor] at hP
  change (0 : ℚ) ≤ B.coeff P
  exact_mod_cast hP

end Negativity

/-! ### The difference of the crepant boundaries -/

section CrepantDifference

variable {k : Type u} [Field k] [PerfectField k]

/-- **The difference of two crepant boundaries along curves.** With `K_Z = div(g^*ω)`, crepancy
`K_Z + Δ_Z = g^*(K_X + Δ)` and `K'_Z + Δ'_Z = g'^*(K_{X'} + Δ')` with `K'_Z ∼ K_Z` give
`((Δ_Z - Δ'_Z) · C) = (g^*(K_X + Δ) · C) - (g'^*(K_{X'} + Δ') · C)` for every curve `C`. -/
private theorem exists_intersectionNumber_sub_eq {n : ℕ} {X X' Z : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X']
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)}
    [QuasiCompact sX] [QuasiCompact sX']
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX')
    {KX : Divisor X} {KX' : Divisor X'} (hK : KX.IsCanonicalDivisor sX n)
    (hK' : KX'.IsCanonicalDivisor sX' n) {Δ : QDivisor X} {Δ' : QDivisor X'}
    (hQ : (Divisor.toQDivisor KX + Δ).IsQCartier)
    (hQ' : (Divisor.toQDivisor KX' + Δ').IsQCartier)
    {g : Z ⟶ X} {g' : Z ⟶ X'} [IsProper g] [IsProper g'] (hZ : IsNormalVariety k (g ≫ sX))
    (hZ' : IsNormalVariety k (g' ≫ sX'))
    (hg : IsBirationalMorphism g) (hg' : IsBirationalMorphism g') (hsZ : g' ≫ sX' = g ≫ sX)
    {ΔZ ΔZ' : QDivisor Z} (hΔZ : IsCrepantBoundary sX n KX Δ g hZ hg ΔZ)
    (hΔZ' : IsCrepantBoundary sX' n KX' Δ' g' hZ' hg' ΔZ') :
    haveI : QuasiCompact (g ≫ sX) := hZ.1.toQuasiCompact
    ∃ (hH : (ΔZ - ΔZ').IsQCartier) (L L' : QDivisor Z)
      (hLB : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉
        (Divisor.toQDivisor KX + Δ).supp)
      (hLB' : ∀ W : irreducibleComponents Z, g' (componentGenericPoint Z W) ∉
        (Divisor.toQDivisor KX' + Δ').supp)
      (_ : (Divisor.toQDivisor KX + Δ).IsPullback g hLB L)
      (_ : (Divisor.toQDivisor KX' + Δ').IsPullback g' hLB' L')
      (hLq : L.IsQCartier) (hLq' : L'.IsQCartier),
      ∀ C : ProperCurve (g ≫ sX), (ΔZ - ΔZ').intersectionNumber k (g ≫ sX) C.ι C.dim_le hH =
        L.intersectionNumber k (g ≫ sX) C.ι C.dim_le hLq -
          L'.intersectionNumber k (g ≫ sX) C.ι C.dim_le hLq' := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType sX' := hX'.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (g ≫ sX) := hZ.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (g' ≫ sX') := hZ'.1.toLocallyOfFiniteType
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have : CompactSpace X' := QuasiCompact.compactSpace_of_compactSpace sX'
  have : QuasiCompact (g ≫ sX) := hZ.1.toQuasiCompact
  have : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace (g ≫ sX)
  have : IsDominant g := hg.isDominant
  have : IsDominant g' := hg'.isDominant
  have : MMP.Mori.IsVariety k sX := hX.1
  have : MMP.Mori.IsVariety k (g ≫ sX) := hZ.1
  have hnZ : topologicalKrullDim Z = n := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (g ≫ sX) hg, hK.1]
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨ω', hω0', hωK'⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX' hK'
  have hLB : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉
      (Divisor.toQDivisor KX + Δ).supp := fun W => by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    exact MMP.Fourfold.genericPoint_notMem_supp _
  have hLB' : ∀ W : irreducibleComponents Z, g' (componentGenericPoint Z W) ∉
      (Divisor.toQDivisor KX' + Δ').supp := fun W => by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    exact MMP.Fourfold.genericPoint_notMem_supp _
  set KZ := divisorOfForm (pullbackRationalPluriForms sX g ω) with hKZ
  set KZ' := divisorOfForm (pullbackRationalPluriForms sX' g' ω') with hKZ'
  have hpb := isPullback_divisorOfForm_add hX hZ hg hK hΔZ hω0 hωK hLB
  have hpb' := isPullback_divisorOfForm_add hX' hZ' hg' hK' hΔZ' hω0' hωK' hLB'
  have hB := hpb.isQCartier hQ
  have hA := hpb'.isQCartier hQ'
  have hne : pullbackRationalPluriForms sX g ω ≠ 0 :=
    Oai4C1.Main.pullbackRationalPluriForms_ne_zero g hg.functionFieldMap_bijective
      (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hK.1) hω0
  have hlin : KZ'.LinearlyEquivalent KZ := by
    have key : ∀ (s : Z ⟶ Spec (.of k)) (_ : s = g ≫ sX) [LocallyOfFiniteType s]
        (τ : RationalPluriForms s n 1), τ ≠ 0 → (divisorOfForm τ).LinearlyEquivalent KZ := by
      rintro s rfl _ τ hτ
      exact linearlyEquivalent_divisorOfForm hZ hnZ hτ hne
    exact key _ hsZ _ (Oai4C1.Main.pullbackRationalPluriForms_ne_zero g'
      hg'.functionFieldMap_bijective
      (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX') hK'.1) hω0')
  have hA2 : (Divisor.toQDivisor KZ + ΔZ').IsQCartier := hA.add_of_linearlyEquivalent hlin
  have hBn : (-(Divisor.toQDivisor KZ + ΔZ')).IsQCartier := Oai4C1.isQCartier_neg hA2
  have hH : ΔZ - ΔZ' = (Divisor.toQDivisor KZ + ΔZ) + -(Divisor.toQDivisor KZ + ΔZ') := by abel
  have hHq : (ΔZ - ΔZ').IsQCartier := hH ▸ hB.add hBn
  refine ⟨hHq, _, _, hLB, hLB', hpb, hpb', hB, hA, fun C => ?_⟩
  rw [MMP.Fourfold.intersectionNumber_congr _ C.ι C.dim_le hHq (hB.add hBn) hH,
    QDivisor.intersectionNumber_add' k _ C.ι C.dim_le _ _ hB hBn,
    intersectionNumber_neg k _ C.ι C.dim_le hA2 hBn,
    ← intersectionNumber_add_eq_of_linearlyEquivalent (g ≫ sX) C.ι C.dim_le hlin ΔZ' hA hA2]
  ring

end CrepantDifference

/-- A log discrepancy `a(ξ; X, B)` of a valuation is unique. -/
private theorem isValuationLogDiscrepancy_unique {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X}
    {ξ : Valuation X.functionField (WithZero (Multiplicative ℤ))} {a a' : ℝ}
    (h : IsValuationLogDiscrepancy sX B ξ a) (h' : IsValuationLogDiscrepancy sX B ξ a') :
    a = a' := by
  obtain ⟨n, D, -, hD, ha⟩ := h
  obtain ⟨n', D', -, hD', ha'⟩ := h'
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha ha' (hD.trans hD'.symm)

/-! ### Valuations and log discrepancies on the variety itself -/

section Valuations

/-- The valuation of a prime divisor of `X`, regarded as a divisor over `X`. -/
private theorem valuation_ofPrimeDivisor {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX)
    (P : MMP.Mori.PrimeDivisor X) :
    (DivisorOver.ofPrimeDivisor k hX P).valuation = P.divisorialValuation := by
  ext t
  change P.divisorialValuation (functionFieldMap (𝟙 X) t) = _
  rw [functionFieldMap_id_apply]

/-- A divisor `(W, g, E)` over `X` with `g` proper has a log discrepancy `1 + a(E, X, B)`. -/
private theorem isValuationLogDiscrepancy_of_isDiscrepancy {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} {K : Divisor X}
    {B : QDivisor X} {D : DivisorOver ℂ sX} (hDp : IsProper D.f) {c : ℚ}
    (hc : IsDiscrepancy sX n K B D c) :
    IsValuationLogDiscrepancy sX B D.valuation (1 + c) :=
  ⟨n, D, hDp, rfl, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hDp⟩

/-- The log discrepancy of `ord_P`, for a prime divisor `P` of `X`, is `1 - coeff_P B`. -/
private theorem isValuationLogDiscrepancy_divisorialValuation {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    {B : QDivisor X} (hpair : MMP.Mori.IsPair sX B) (P : MMP.Mori.PrimeDivisor X) :
    IsValuationLogDiscrepancy sX B P.divisorialValuation (1 - (B.coeff P : ℝ)) := by
  obtain ⟨-, n, K, hK, -⟩ := id hpair
  obtain ⟨a, ha⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hpair hK
    (DivisorOver.ofPrimeDivisor ℂ hX P)
  have ha' := IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX ha
  have hp : IsProper (DivisorOver.ofPrimeDivisor ℂ hX P).f := by
    change IsProper (𝟙 X); infer_instance
  have := isValuationLogDiscrepancy_of_isDiscrepancy hp ha
  rw [valuation_ofPrimeDivisor, ha'] at this
  convert this using 1
  push_cast; ring

/-- A divisor over `X` with proper structure morphism has a log discrepancy. -/
private theorem exists_isValuationLogDiscrepancy {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    {B : QDivisor X} (hpair : MMP.Mori.IsPair sX B) (D : DivisorOver ℂ sX) (hD : IsProper D.f) :
    ∃ a : ℝ, IsValuationLogDiscrepancy sX B D.valuation a := by
  obtain ⟨-, n, K, hK, -⟩ := id hpair
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hpair hK D
  exact ⟨_, isValuationLogDiscrepancy_of_isDiscrepancy hD hc⟩

end Valuations

/-! ### Birational morphisms and transported valuations -/

section Transport

/-- If `g` and `g ≫ h` are birational, so is `h`. -/
private theorem isBirational_of_comp {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] {g : X ⟶ Y} {h : Y ⟶ Z} (hg : IsBirational g) (hgh : IsBirational (g ≫ h)) :
    IsBirational h := by
  have h1 := hg.1
  have h2 := hgh.1
  rw [genericPoints_eq_singleton, genericPoints_eq_singleton, Set.bijOn_singleton] at h1 h2
  refine ⟨?_, fun x hx => ?_⟩
  · rw [genericPoints_eq_singleton, genericPoints_eq_singleton, ← h1, Set.bijOn_singleton]
    exact h2
  · rw [genericPoints_eq_singleton, Set.mem_singleton_iff] at hx
    subst hx
    have a := hgh.2 (genericPoint X) (by rw [genericPoints_eq_singleton]; rfl)
    have b := hg.2 (genericPoint X) (by rw [genericPoints_eq_singleton]; rfl)
    rw [Scheme.Hom.stalkMap_comp] at a
    have c : IsIso (h.stalkMap (g (genericPoint X))) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ b a
    rw [← h1]
    exact c

/-- Restriction of valuations along the function field map of a composite. -/
private theorem comap_functionFieldMap_comp {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] (a : X ⟶ Y) (b : Y ⟶ Z) [IsDominant a] [IsDominant b] [IsDominant (a ≫ b)]
    (v : Valuation X.functionField (WithZero (Multiplicative ℤ))) :
    v.comap (functionFieldMap (a ≫ b)) =
      (v.comap (functionFieldMap a)).comap (functionFieldMap b) :=
  Valuation.ext fun t => by
    simp only [Valuation.comap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]

/-- The valuation of a prime divisor seen through a composite. -/
private theorem valuationOver_comp {X Y Z : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsIntegral Z] (P : MMP.Mori.PrimeDivisor X) (a : X ⟶ Y)
    (b : Y ⟶ Z) [IsDominant a] [IsDominant b] [IsDominant (a ≫ b)] :
    P.valuationOver (a ≫ b) = (P.valuationOver a).comap (functionFieldMap b) :=
  comap_functionFieldMap_comp a b P.divisorialValuation

/-- The valuation of a prime divisor seen through a morphism `a = g ≫ h`. -/
private theorem valuationOver_eq_comap_of_eq {X T Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral T] [IsIntegral Z]
    (P : MMP.Mori.PrimeDivisor X) {a : X ⟶ Z} {g : X ⟶ T} {h : T ⟶ Z} (hda : IsDominant a)
    (hg : IsDominant g) (hh : IsDominant h) (ha : a = g ≫ h) :
    P.valuationOver a = (P.valuationOver g).comap (functionFieldMap h) := by
  subst ha
  exact valuationOver_comp P g h

/-- Two valuations with the same restriction along `g` and `g⁺` have the same restriction along
`a = g ≫ h` and `b = g⁺ ≫ h`. -/
private theorem comap_functionFieldMap_eq_of_eq {Xm Xp T Z : Scheme.{0}} [IsIntegral Xm]
    [IsIntegral Xp] [IsIntegral T] [IsIntegral Z] {g : Xm ⟶ T} {gp : Xp ⟶ T} {h : T ⟶ Z}
    {a : Xm ⟶ Z} {b : Xp ⟶ Z} (hg : IsDominant g) (hgp : IsDominant gp) (hh : IsDominant h)
    (hda : IsDominant a) (hdb : IsDominant b) (ha : a = g ≫ h) (hb : b = gp ≫ h)
    {u : Valuation Xm.functionField (WithZero (Multiplicative ℤ))}
    {w : Valuation Xp.functionField (WithZero (Multiplicative ℤ))}
    (hw : w.comap (functionFieldMap gp) = u.comap (functionFieldMap g)) :
    w.comap (functionFieldMap b) = u.comap (functionFieldMap a) := by
  subst ha hb
  rw [comap_functionFieldMap_comp, comap_functionFieldMap_comp, hw]

end Transport

/-! ### Comparison with a relatively ample model -/

section Comparison

/-- **Comparison with a relatively ample model.** Let `π : V ⟶ Z` and `f : X ⟶ Z` be proper
birational morphisms of normal projective varieties over `ℂ` with canonical divisors `K_V`,
`K_X`, let `(V, Θ)` and `(X, B)` be pairs with `K_X + B` relatively ample over `Z`, and suppose
that `a(ord_Q; X, B) = 1 - coeff_Q Θ = a(ord_Q; V, Θ)` for every prime divisor `Q` of `V`
(the valuations being identified through `k(V) ≅ k(Z) ≅ k(X)`). Then `a(ξ; V, Θ) ≤ a(ξ; X, B)`
for every normalized divisorial valuation `ξ`. -/
private theorem le_of_forall_primeDivisor {V X Z : Scheme.{0}} [IsIntegral V] [CompactSpace V]
    [IsLocallyNoetherian V] [IsNormal V] [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X]
    {sV : V ⟶ Spec (.of ℂ)} {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    (hV : IsNormalVariety ℂ sV) (hX : IsNormalVariety ℂ sX) (hZ : IsNormalVariety ℂ sZ)
    (hZs : IsSeparated sZ) {n : ℕ}
    {KV : Divisor V} (hKV : KV.IsCanonicalDivisor sV n) {Θ : QDivisor V}
    (hΘ : (Divisor.toQDivisor KV + Θ).IsQCartier)
    {KX : Divisor X} (hKX : KX.IsCanonicalDivisor sX n) {B : QDivisor X}
    (hB : (Divisor.toQDivisor KX + B).IsQCartier)
    (π : V ⟶ Z) (f : X ⟶ Z) (hπ : π ≫ sZ = sV) (hf : f ≫ sZ = sX) [hπp : IsProper π]
    [hfp : IsProper f]
    (hπb : IsBirationalMorphism π) (hfb : IsBirationalMorphism f)
    (hamp : (Divisor.toQDivisor KX + B).HasRelativelyAmpleMultiple f)
    (heq : haveI : IsIntegral Z := hZ.1.toIsIntegral
      haveI := hπb.isDominant
      haveI := hfb.isDominant
      ∀ (Q : MMP.Mori.PrimeDivisor V) (s : Valuation X.functionField (WithZero (Multiplicative ℤ))),
        s.comap (functionFieldMap f) = Q.valuationOver π →
          IsValuationLogDiscrepancy sX B s (1 - (Θ.coeff Q : ℝ)))
    {ξ : Valuation V.functionField (WithZero (Multiplicative ℤ))}
    {ξX : Valuation X.functionField (WithZero (Multiplicative ℤ))}
    (hξ : haveI : IsIntegral Z := hZ.1.toIsIntegral
      haveI := hπb.isDominant
      haveI := hfb.isDominant
      ξX.comap (functionFieldMap f) = ξ.comap (functionFieldMap π))
    {a aX : ℝ} (ha : IsValuationLogDiscrepancy sV Θ ξ a)
    (haX : IsValuationLogDiscrepancy sX B ξX aX) :
    a ≤ aX := by
  -- instances
  have : IsIntegral Z := hZ.1.toIsIntegral
  have : IsNormal Z := hZ.2
  have : LocallyOfFiniteType sZ := hZ.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
  have : QuasiCompact sV := hV.1.toQuasiCompact
  have : QuasiCompact sX := hX.1.toQuasiCompact
  have := hπb.isDominant
  have := hfb.isDominant
  have : AlgebraicGeometry.IsVariety ℂ sV := hV.1
  have : AlgebraicGeometry.IsVariety ℂ sX := hX.1
  -- a common model `W` realizing `ξ`
  have ha' := ha
  obtain ⟨n₀, D, hDp, rfl, -⟩ := ha
  have : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have e : (Z ↘ ⊤_ Scheme) = sZ ≫ Limits.terminal.from (Spec (.of ℂ)) := Subsingleton.elim _ _
    rw [e]
    infer_instance
  obtain ⟨φ, hφ, hφS⟩ := exists_isBirational_compHom_eq hπb hfb
  obtain ⟨W, q, r, hW, hq, hqp, hrp, hr, -, hcomm, E, hE⟩ :=
    MMP.Mori.exists_isNormalVariety_isProper_isBirationalMorphism_primeDivisor_valuation_eq
      hV hX π f φ hφ hφS D
  have hsW : r ≫ sX = q ≫ sV := by rw [← hf, ← Category.assoc, ← hcomm, Category.assoc, hπ]
  have hW' : IsNormalVariety ℂ (r ≫ sX) := by rwa [hsW]
  have : IsIntegral W := hW.1.toIsIntegral
  have : IsNormal W := hW.2
  have : LocallyOfFiniteType (q ≫ sV) := hW.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (q ≫ sV)
  have : QuasiCompact (q ≫ sV) := hW.1.toQuasiCompact
  have := hq.isDominant
  have := hr.isDominant
  have : AlgebraicGeometry.IsVariety ℂ (q ≫ sV) := hW.1
  -- the transport of valuations along the common model
  have htr : ∀ P : MMP.Mori.PrimeDivisor W,
      (⟨W, r, hW', hr, P⟩ : DivisorOver ℂ sX).valuation.comap (functionFieldMap f) =
        (⟨W, q, hW, hq, P⟩ : DivisorOver ℂ sV).valuation.comap (functionFieldMap π) := by
    intro P
    ext t
    simp only [Valuation.comap_apply]
    change P.divisorialValuation (functionFieldMap r (functionFieldMap f t)) =
      P.divisorialValuation (functionFieldMap q (functionFieldMap π t))
    rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
    simp only [hcomm]
  have hEX : (⟨W, r, hW', hr, E⟩ : DivisorOver ℂ sX).valuation = ξX :=
    comap_injective_of_surjective hfb.functionFieldMap_bijective.2
      ((htr E).trans (by rw [hE]; exact hξ.symm))
  -- pairs and crepant boundaries
  have hPV : MMP.Mori.IsPair sV Θ := ⟨hV, n, KV, hKV, hΘ⟩
  have hPX : MMP.Mori.IsPair sX B := ⟨hX, n, KX, hKX, hB⟩
  obtain ⟨⟨ΔV, hΔV, -⟩, -⟩ := MMP.Mori.IsPair.existsUnique_isCrepantBoundary hPV hKV q hW hq
  obtain ⟨⟨ΔX, hΔX, -⟩, -⟩ := MMP.Mori.IsPair.existsUnique_isCrepantBoundary hPX hKX r hW' hr
  -- log discrepancies of the prime divisors of `W`
  have hlogV : ∀ P : MMP.Mori.PrimeDivisor W, IsValuationLogDiscrepancy sV Θ
      (⟨W, q, hW, hq, P⟩ : DivisorOver ℂ sV).valuation (1 + -(ΔV.coeff P : ℝ)) := fun P => by
    have := isValuationLogDiscrepancy_of_isDiscrepancy (D := ⟨W, q, hW, hq, P⟩) hqp (hΔV P)
    exact_mod_cast this
  have hlogX : ∀ P : MMP.Mori.PrimeDivisor W, IsValuationLogDiscrepancy sX B
      (⟨W, r, hW', hr, P⟩ : DivisorOver ℂ sX).valuation (1 + -(ΔX.coeff P : ℝ)) := fun P => by
    have := isValuationLogDiscrepancy_of_isDiscrepancy (D := ⟨W, r, hW', hr, P⟩) hrp (hΔX P)
    exact_mod_cast this
  -- the divisor `G = Δ_V - Δ_X` along curves
  obtain ⟨hH, L, L', hLB, hLB', hL, hL', hLq, hLq', hform⟩ :=
    exists_intersectionNumber_sub_eq hV hX hKV hKX hΘ hB hW hW' hq hr hsW hΔV hΔX
  set G := ΔV - ΔX with hG_def
  have hnef : ∀ C : ProperCurve (q ≫ sV), C.IsContractedBy q →
      G.intersectionNumber ℂ (q ≫ sV) C.ι C.dim_le hH ≤ 0 := fun C hC => by
    rw [hform C]
    have hpt : ∃ w : V, Set.range (C.ι ≫ q) = {w} := by
      refine ⟨q C.point, ?_⟩
      rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, C.range_ι]
      refine Set.eq_singleton_iff_unique_mem.mpr ⟨⟨C.point, subset_closure rfl, rfl⟩, ?_⟩
      rintro _ ⟨x, hx, rfl⟩
      exact hC x hx
    have := C.isCurve
    have h0 : L.intersectionNumber ℂ (q ≫ sV) C.ι C.dim_le hLq = 0 :=
      MMP.Mori.intersectionNumber_pullback_eq_zero ℂ (q ≫ sV) sV q rfl C.ι hΘ hL hpt
    have hC' : C.IsContractedBy (r ≫ f) := by
      rw [← hcomm]
      intro x hx
      simp only [Scheme.Hom.comp_apply, hC x hx]
    have h1 : 0 ≤ L'.intersectionNumber ℂ (q ≫ sV) C.ι C.dim_le hLq' := by
      rcases intersectionNumber_pullback_eq_zero_or r hsW f hB hL' hLq' C hC' with
        h0 | ⟨d, hd, C'', hC'', heq⟩
      · rw [h0]
      · rw [heq]
        exact mul_nonneg hd
          (Oai4C1.TwoEnds.intersectionNumber_pos_of_hasRelativelyAmpleMultiple _ hB hamp C''
            hC'').le
    linarith
  -- the coefficients along the prime divisors of `V` vanish
  have hBG : ∀ P : MMP.Mori.PrimeDivisor W,
      ¬ MMP.Flips.IsExceptionalPrimeDivisor sV q P → 0 ≤ G.coeff P := fun P hP => by
    have hex : ¬ MMP.Mori.RationalMap.IsExceptional (X := W) q.toRationalMap P :=
      fun hex => hP (Oai4C1.Negativity.isExceptionalPrimeDivisor_of_two_le_coheight hV q hW hq P
        (two_le_coheight_of_isExceptional P hex))
    obtain ⟨Q, hv⟩ := MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hV
      (⟨W, q, hW, hq, P⟩ : DivisorOver ℂ sV) hex
    rw [valuation_ofPrimeDivisor] at hv
    have h1 := isValuationLogDiscrepancy_unique (hlogV P)
      (hv ▸ isValuationLogDiscrepancy_divisorialValuation hV hPV Q)
    have h2 := isValuationLogDiscrepancy_unique (hlogX P)
      (heq Q _ ((htr P).trans (by rw [hv]; rfl)))
    have : (G.coeff P : ℝ) = 0 := by
      rw [hG_def, DivisorWithCoeffs.coeff_sub]
      push_cast
      linarith
    exact_mod_cast this.ge
  -- the negativity lemma
  have hG : 0 ≤ G := nonneg_of_intersectionNumber_nonpos hV hW q rfl hq hH hnef hBG
  have hGE : 0 ≤ G.coeff E := Finsupp.le_def.mp hG E
  have e1 := isValuationLogDiscrepancy_unique (hlogV E) (by rwa [hE])
  have e2 := isValuationLogDiscrepancy_unique (hlogX E) (by rwa [hEX])
  have hGE' : (0 : ℝ) ≤ ΔV.coeff E - ΔX.coeff E := by
    have : (0 : ℚ) ≤ ΔV.coeff E - ΔX.coeff E := by
      rwa [← DivisorWithCoeffs.coeff_sub]
    exact_mod_cast this
  linarith

end Comparison

/-- Equivalences composed along a finite sequence of moves. -/
private noncomputable def seqEquiv {α : Type*} {β : ℕ → Type*} (m : ℕ) (e₀ : α ≃ β 0)
    (F : ∀ k < m, β k ≃ β (k + 1)) : ∀ k ≤ m, α ≃ β k
  | 0, _ => e₀
  | k + 1, h => (seqEquiv m e₀ F k (Nat.le_of_succ_le h)).trans (F k h)

/-- **No divisor is lost in a bridge programme.** Let `(p_i, Θ_i)` be a crepant junction of
`(X_i, B_i)` extracting `I_∞ = I(X_i, B_i)`, `Θ_i'` its decreased boundary, and `P` a finite
relative threefold programme over `Z_i` (by `f_i ∘ p_i`) from `(Y_i, Θ_i')`. Then every
contraction `g_k`, `k < m`, is small, and there are bijections `e k`, `k ≤ m`, from the prime
divisors of `Y_i` to those of the model `V_k`, with `e 0` the identity and `e (k + 1) P` the strict
transform of `e k P`, such that `coeff_{e k P} Θ_k = coeff_P Θ_i'`; every model `(V_k, Θ_k)` is a
terminal pair on a projective `ℚ`-factorial threefold. -/
@[mmp "lem_mmp_indexc_bridge_no_divisor_lost"]
public theorem IsDecreasedBoundary.isSmallMorphism_relativeThreefoldProgram {T : StabilizedTail}
    {i : ℕ} {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (hI : (I : Set _) = lowDiscrepancySet (T.sX i) (T.B i))
    {J : CrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}
    (hΘ' : IsDecreasedBoundary J Θ') {K : Divisor J.Y}
    (P : RelativeThreefoldProgram (J.p ≫ T.sX i) (T.sZ i) (J.p ≫ T.f i) K Θ') :
    (∀ k < P.m, IsSmallMorphism (modelStr (J.p ≫ T.sX i) P.sY k) (P.sT k) (P.g k)) ∧
    ∃ e : ∀ k ≤ P.m, MMP.Mori.PrimeDivisor J.Y ≃ MMP.Mori.PrimeDivisor (modelSeq J.Y P.Y k),
      (∀ Γ, e 0 (Nat.zero_le _) Γ = Γ) ∧
      (∀ (k : ℕ) (hk : k < P.m) (Γ : MMP.Mori.PrimeDivisor J.Y),
        flipTransformPrimeDivisor (P.g k) (P.gp k) (e k hk.le Γ) = some (e (k + 1) hk Γ)) ∧
      (∀ (k : ℕ) (hk : k ≤ P.m) (Γ : MMP.Mori.PrimeDivisor J.Y),
        (P.boundary k).coeff (e k hk Γ) = Θ'.coeff Γ) ∧
      ∀ k ≤ P.m,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr (J.p ≫ T.sX i) P.sY k) ∧
        topologicalKrullDim (modelSeq J.Y P.Y k) = 3 ∧
        IsQFactorial (modelStr (J.p ≫ T.sX i) P.sY k) ∧
        IsKltTerminalPair (modelStr (J.p ≫ T.sX i) P.sY k) (P.boundary k) := by
  -- the `i`-th step of the tail and its base `Z_i`
  have hT := T.isThreefoldStepDiagram i
  have hZ : IsNormalVariety ℂ (T.sZ i) := hT.isNormalVariety_target
  have : IsIntegral (T.Z i) := hZ.1.toIsIntegral
  have : IsNormal (T.Z i) := hZ.2
  have : LocallyOfFiniteType (T.sZ i) := hZ.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian (T.Z i) := LocallyOfFiniteType.isLocallyNoetherian (T.sZ i)
  have hZs : IsSeparated (T.sZ i) := hT.isProjectiveVariety_target.1.toIsSeparated
  have hfpb : IsBirationalMorphism (T.fp i) := hT.isSmallMorphism_plus.isBirationalMorphism
  have : IsProper (T.fp i) := hT.isSmallMorphism_plus.isProper
  have := hfpb.isDominant
  -- the models of the programme
  have hmodel : ∀ k ≤ P.m, MMP.Mori.IsProjectiveVariety ℂ (modelStr (J.p ≫ T.sX i) P.sY k) ∧
      topologicalKrullDim (modelSeq J.Y P.Y k) = 3 := by
    intro k hk
    rcases Nat.lt_or_ge k P.m with hk' | hk'
    · have hD := P.isThreefoldStepDiagram k hk'
      exact ⟨hD.isProjectiveVariety_minus, hD.dim_minus⟩
    · obtain rfl : k = P.m := le_antisymm hk hk'
      rcases hm : P.m with _ | m
      · exact ⟨P.isProjectiveVariety, P.dim_eq⟩
      · have hD := P.isThreefoldStepDiagram m (by omega)
        exact ⟨hD.isProjectiveVariety_plus, hD.dim_plus⟩
  -- the morphisms `π_k : V_k ⟶ Z_i`
  obtain ⟨pr, hpr⟩ : ∃ pr, pr = modelMap (J.p ≫ T.f i) P.πY := ⟨_, rfl⟩
  have hpr0 : pr 0 = J.p ≫ T.f i := by rw [hpr]; rfl
  have hprS : ∀ k < P.m, pr (k + 1) = P.gp k ≫ P.h k := fun k hk => by
    rw [hpr, ← P.πY_eq k hk]; rfl
  have hprk : ∀ k < P.m, pr k = P.g k ≫ P.h k := fun k hk => by
    rw [hpr, P.modelMap_eq k hk]
  have hprs : ∀ k ≤ P.m, pr k ≫ T.sZ i = modelStr (J.p ≫ T.sX i) P.sY k := by
    intro k hk
    cases k with
    | zero => rw [hpr0]; exact P.comp_eq
    | succ k =>
      have hk' : k < P.m := hk
      rw [hpr]
      change P.πY k ≫ _ = P.sY k
      rw [P.πY_eq k hk', Category.assoc, P.comp_eq_base k hk',
        (P.isThreefoldStepDiagram k hk').comp_eq_plus]
  have hprp : ∀ k ≤ P.m, IsProper (pr k) := fun k hk => by
    have : IsProper (pr k ≫ T.sZ i) := by
      rw [hprs k hk]; exact isProper_of_isProjectiveMorphism _ (hmodel k hk).1.isProjective
    exact IsProper.of_comp (pr k) (T.sZ i)
  have hprB : ∀ k ≤ P.m, IsBirational (pr k) := by
    intro k hk
    induction k with
    | zero =>
      rw [hpr0]
      exact (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
        J.isBirationalMorphism).comp
        (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hT.isBirationalMorphism_minus)
    | succ k ih =>
      have hk' : k < P.m := hk
      have hD := P.isThreefoldStepDiagram k hk'
      have : IsIntegral (P.T k) := hD.isNormalVariety_target.1.toIsIntegral
      have hh : IsBirational (P.h k) := isBirational_of_comp
        (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hD.isBirationalMorphism_minus)
        (by rw [← hprk k hk']; exact ih hk'.le)
      rw [hprS k hk']
      exact (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
        hD.isSmallMorphism_plus.isBirationalMorphism).comp hh
  have hprb : ∀ k ≤ P.m, IsBirationalMorphism (pr k) := fun k hk => by
    have := hprp k hk
    simpa using MMP.Mori.isBirationalMorphism_comp_of_isBirational (𝟙 (T.Z i)) (pr k)
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
        (isBirationalMorphism_of_isIso _)) (hprB k hk)
  -- the equality clause: `a(ord_Q; X_{i+1}, B_{i+1}) = 1 - coeff_Q Θ_k` for primes `Q` of `V_k`
  have heqc : ∀ k (hk : k ≤ P.m) (Q : MMP.Mori.PrimeDivisor (modelSeq J.Y P.Y k)),
      haveI := (hprb k hk).isDominant
      ∃ s' : Valuation (T.X (i + 1)).functionField (WithZero (Multiplicative ℤ)),
        s'.comap (functionFieldMap (T.fp i)) = Q.valuationOver (pr k) ∧
        IsValuationLogDiscrepancy (T.sX (i + 1)) (T.B (i + 1)) s'
          (1 - ((P.boundary k).coeff Q : ℝ)) := by
    intro k hk
    induction k with
    | zero =>
      intro Q
      have := J.isBirationalMorphism.isDominant
      have := hT.isBirationalMorphism_minus.isDominant
      obtain ⟨s', hs', hlog, -⟩ :=
        IsDecreasedBoundary.isValuationLogDiscrepancy_one_sub_coeff hI hΘ' Q
      exact ⟨s', hs'.trans (valuationOver_eq_comap_of_eq Q (hprb 0 hk).isDominant
        J.isBirationalMorphism.isDominant hT.isBirationalMorphism_minus.isDominant hpr0).symm,
        hlog⟩
    | succ k ih =>
      intro Q
      have hk' : k < P.m := hk
      have hD := P.isThreefoldStepDiagram k hk'
      have : IsIntegral (P.T k) := hD.isNormalVariety_target.1.toIsIntegral
      have := hD.isBirationalMorphism_minus.isDominant
      have := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
      obtain ⟨Pm, -, hPm, -, -, -, hc, -⟩ := hD.exists_primeDivisor_valuationOver_eq Q
      obtain ⟨s', hs', hlog⟩ := ih hk'.le Pm
      have : IsDominant (P.g k ≫ P.h k) := hprk k hk' ▸ (hprb k hk'.le).isDominant
      have hh : IsDominant (P.h k) := IsDominant.of_comp (P.g k) (P.h k)
      refine ⟨s', hs'.trans ?_, ?_⟩
      · exact (comap_functionFieldMap_eq_of_eq hD.isBirationalMorphism_minus.isDominant
          hD.isSmallMorphism_plus.isBirationalMorphism.isDominant hh (hprb k hk'.le).isDominant
          (hprb (k + 1) hk).isDominant (hprk k hk') (hprS k hk') hPm.symm).symm
      · have hcQ : (P.ΘY k).coeff Q = (divisorSeq Θ' P.ΘY k).coeff Pm := by
          rwa [P.ΘY_eq k hk']
        rw [show (P.boundary (k + 1)).coeff Q = (P.boundary k).coeff Pm from hcQ]
        exact hlog
  -- every contraction `g_k` is small
  have hsmall : ∀ k < P.m,
      IsSmallMorphism (modelStr (J.p ≫ T.sX i) P.sY k) (P.sT k) (P.g k) := by
    intro k hk
    by_contra hns
    have hD := P.isThreefoldStepDiagram k hk
    have : IsIntegral (P.T k) := hD.isNormalVariety_target.1.toIsIntegral
    have := hD.isBirationalMorphism_minus.isDominant
    have := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
    have : IsDominant (P.g k ≫ P.h k) := hprk k hk ▸ (hprb k hk.le).isDominant
    have hh : IsDominant (P.h k) := IsDominant.of_comp (P.g k) (P.h k)
    obtain ⟨E, v, hv, hexc⟩ :=
      hD.exists_primeDivisor_isExceptionalValuation_of_not_isSmallMorphism hns
    -- `a(ord_E; V_k, Θ_k) < a(v; V_{k+1}, Θ_{k+1})`
    obtain ⟨nk, hKk⟩ := hD.isCanonicalDivisor
    have hpk : MMP.Mori.IsPair (modelStr (J.p ≫ T.sX i) P.sY k) (P.boundary k) :=
      ⟨hD.isNormalVariety_minus, nk, _, hKk, hD.isQCartier_minus⟩
    have ham := isValuationLogDiscrepancy_divisorialValuation hD.isNormalVariety_minus hpk E
    obtain ⟨n', hK'⟩ := hD.isCanonicalDivisor_plus
    have hpk' : MMP.Mori.IsPair (P.sY k) (flipTransform (P.g k) (P.gp k) (P.boundary k)) :=
      ⟨hD.isNormalVariety_plus, n', _, hK', hD.isQCartier_plus⟩
    obtain ⟨Dv, hDvp, hDv, -⟩ := id hexc
    obtain ⟨ap, hap⟩ := exists_isValuationLogDiscrepancy hpk' Dv hDvp
    rw [← hDv] at hap
    have hlt := hD.lt_of_isExceptionalValuation E hv hexc ham hap
    -- `a(ord_E; V_k, Θ_k) = a(ord_E; X_{i+1}, B_{i+1})`
    obtain ⟨s', hs', hlog⟩ := heqc k hk.le E
    rw [T.B_eq i] at hlog
    -- `a(v; V_{k+1}, Θ_{k+1}) ≤ a(v; X_{i+1}, B_{i+1})`
    obtain ⟨nX, hKX⟩ := hT.isCanonicalDivisor_plus
    have hn' : n' = 3 := by
      have := hK'.topologicalKrullDim_eq.symm.trans hD.dim_plus
      exact_mod_cast this
    have hnX : nX = 3 := by
      have := hKX.topologicalKrullDim_eq.symm.trans hT.dim_plus
      exact_mod_cast this
    subst hn' hnX
    have hvcomp := comap_functionFieldMap_eq_of_eq (a := pr k) (b := pr (k + 1))
      hD.isBirationalMorphism_minus.isDominant
      hD.isSmallMorphism_plus.isBirationalMorphism.isDominant hh (hprb k hk.le).isDominant
      (hprb (k + 1) hk).isDominant (hprk k hk) (hprS k hk) hv
    have hle := le_of_forall_primeDivisor (V := P.Y k) (Θ := flipTransform (P.g k) (P.gp k)
        (P.boundary k)) hD.isNormalVariety_plus hT.isNormalVariety_plus hZ hZs hK'
      hD.isQCartier_plus hKX hT.isQCartier_plus (pr (k + 1)) (T.fp i) (hπp := hprp (k + 1) hk)
      (hprs (k + 1) hk)
      hT.comp_eq_plus (hprb (k + 1) hk) hfpb hT.hasRelativelyAmpleMultiple_plus
      (fun Q s hs => by
        obtain ⟨s'', hs'', hlog''⟩ := heqc (k + 1) hk Q
        obtain rfl : s = s'' :=
          comap_injective_of_surjective hfpb.functionFieldMap_bijective.2 (hs.trans hs''.symm)
        change IsValuationLogDiscrepancy _ _ _ (1 - ((P.ΘY k).coeff Q : ℝ)) at hlog''
        rw [T.B_eq i, P.ΘY_eq k hk] at hlog''
        exact hlog'')
      (hs'.trans hvcomp.symm) hap hlog
    linarith
  have hF : ∀ k (hk : k < P.m), ∃ F : MMP.Mori.PrimeDivisor (modelSeq J.Y P.Y k) ≃
      MMP.Mori.PrimeDivisor (modelSeq J.Y P.Y (k + 1)), ∀ Q,
        flipTransformPrimeDivisor (P.g k) (P.gp k) Q = some (F Q) ∧
          (P.boundary (k + 1)).coeff (F Q) = (P.boundary k).coeff Q := by
    intro k hk
    obtain ⟨-, e, he⟩ :=
      (P.isThreefoldStepDiagram k hk).isExceptionalValuation_iff_of_isSmallMorphism (hsmall k hk)
    exact ⟨e, fun Q => ⟨(he Q).1, by rw [P.boundary_succ_eq_flipTransform hk]; exact (he Q).2.2⟩⟩
  choose F hF using hF
  let e := seqEquiv (β := fun k => MMP.Mori.PrimeDivisor (modelSeq J.Y P.Y k)) P.m
    (Equiv.refl _) F
  have hterm : ∀ k (hk : k ≤ P.m),
      IsKltTerminalPair (modelStr (J.p ≫ T.sX i) P.sY k) (P.boundary k) := by
    intro k hk
    induction k with
    | zero => exact (IsDecreasedBoundary.isKltTerminalPair_and_coeff_mem_Ico hI hΘ').1
    | succ k ih =>
      have hk' : k < P.m := hk
      have ih := ih hk'.le
      rw [P.boundary_succ_eq_flipTransform hk']
      exact ((P.isThreefoldStepDiagram k hk').isKltPair_and_isKltTerminalPair_flipTransform
        ih.1).2 (hsmall k hk') ih
  refine ⟨hsmall, e, fun Γ => rfl, fun k hk Γ => (hF k hk _).1, fun k hk Γ => ?_,
    fun k hk => ⟨(hmodel k hk).1, (hmodel k hk).2, P.isQFactorial k hk, hterm k hk⟩⟩
  · induction k with
    | zero => rfl
    | succ k ih =>
      have hk' : k < P.m := hk
      exact ((hF k hk' _).2).trans (ih hk'.le)

/-! ### Labels coming from the boundary -/

namespace TerminalChain

section Junction

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X}
  {I : Finset (Valuation X.functionField (WithZero (Multiplicative ℤ)))}

/-- Only `Q` has inverse transform `P`, when `f(η_P) = η_Q`. -/
private theorem eq_of_inverseTransformPrimeDivisor_eq_some {X Y : Scheme.{u}} {f : X ⟶ Y}
    (P : MMP.Mori.PrimeDivisor X) (Q Q' : MMP.Mori.PrimeDivisor Y)
    (he : f P.genericPoint = Q.genericPoint) (h : inverseTransformPrimeDivisor f Q' = some P) :
    Q' = Q := by
  have hs := support_inverseTransformPrimeDivisor h
  have hP : P.genericPoint ∈ (P.support : Set X) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  rw [hs] at hP
  have hcl : IsClosed (f ⁻¹' (Q'.support : Set Y)) :=
    (Q'.idealSheaf.support.isClosed).preimage f.continuous
  have hsub : (inverseTransform f Q'.idealSheaf.support : Set X) ⊆ f ⁻¹' (Q'.support : Set Y) :=
    closure_minimal (fun z hz => hz.1) hcl
  have hQ' : Q.genericPoint ∈ (Q'.support : Set Y) := he ▸ hsub hP
  have := Q'.eq_genericPoint_of_mem_support hQ' Q.coheight_genericPoint
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective this.symm

/-- **The strict transform under a crepant junction.** For a prime divisor `Q` of `X`, the strict
transform `P = p⁻¹_* Q` under a crepant junction `p : Y ⟶ X` exists, `ord_P = ord_Q`, and for
any coefficients `c` the coefficient of `P` in `p⁻¹_* B + ∑_s c_s E_s` is `coeff_Q B`. -/
private theorem CrepantJunction.exists_inverseTransform (J : CrepantJunction sX B I)
    (Q : MMP.Mori.PrimeDivisor X) :
    ∃ P : MMP.Mori.PrimeDivisor J.Y, inverseTransformPrimeDivisor J.p Q = some P ∧
      (haveI := J.isBirationalMorphism.isDominant;
        P.valuationOver J.p = Q.divisorialValuation) ∧
      ∀ c : I → ℚ,
        (inverseTransformDivisor J.p B + ∑ s : I, Finsupp.single (J.E s) (c s)).coeff P =
          B.coeff Q := by
  have := J.isBirationalMorphism.isDominant
  have : IsProper J.p := isProper_of_isProjectiveMorphism _ J.isProjectiveMorphism
  have hX : IsNormalVariety ℂ sX := ⟨J.isProjectiveVariety_base.toIsVariety, inferInstance⟩
  have hY : AlgebraicGeometry.IsVariety ℂ (J.p ≫ sX) := J.isProjectiveVariety.toIsVariety
  have hQV : Q.genericPoint ∈ biregularLocus J.p :=
    mem_biregularLocus_of_ringKrullDim_stalk_le_one hX J.p hY J.isBirationalMorphism (by
      rw [ringKrullDim_stalk_eq_coheight, Q.coheight_genericPoint]; norm_num)
  set V := biregularLocus J.p
  have : IsIso (J.p ∣_ V) := isBiregular_biregularLocus J.p
  let z : V.toScheme := ⟨Q.genericPoint, hQV⟩
  let y : J.Y := (J.p ⁻¹ᵁ V).ι (inv (J.p ∣_ V) z)
  have hy : J.p y = Q.genericPoint := by
    have hz : (J.p ∣_ V) (inv (J.p ∣_ V) z) = z := by
      rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; rfl
    simp only [y]
    rw [← Scheme.Hom.comp_apply, ← morphismRestrict_ι, Scheme.Hom.comp_apply, hz]
    rfl
  have hyV : J.p y ∈ V := hy ▸ hQV
  have hyc : Order.coheight y = 1 := by
    rw [← MMP.Positivity.coheight_map_of_mem_biregularLocus J.p hyV, hy, Q.coheight_genericPoint]
  let P : MMP.Mori.PrimeDivisor J.Y := AlgebraicGeometry.PrimeDivisor.ofCoheightOne y hyc
  have hP : P.genericPoint = y := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _
  have hPQ : J.p P.genericPoint = Q.genericPoint := hP ▸ hy
  have hPV : J.p P.genericPoint ∈ V := hPQ ▸ hQV
  have := MMP.isIso_stalkMap_of_mem_biregularLocus J.p hPV
  have hinv : inverseTransformPrimeDivisor J.p Q = some P :=
    Oai4C1.StepChain.inverseTransformPrimeDivisor_eq_some_of P Q hPQ hQV
  refine ⟨P, hinv, Oai4C1.valuationOver_eq_of_isIso J.p P Q hPQ, fun c => ?_⟩
  have : IsProper sX := isProper_of_isProjectiveMorphism _ J.isProjectiveVariety_base.isProjective
  have : IsSeparated (X ↘ Limits.terminal Scheme) := by
    rw [show (X ↘ Limits.terminal Scheme) = sX ≫ (Spec (.of ℂ) ↘ Limits.terminal Scheme) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  have hPmem : P.genericPoint ∈ (P.idealSheaf.support : Set J.Y) := by
    change P.genericPoint ∈ (P.support : Set J.Y)
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ∀ s, J.E s ≠ P := by
    intro s hs
    have hex := (J.isExceptional_iff P).mpr ⟨s, hs⟩
    rw [MMP.Positivity.isExceptional_toRationalMap_iff,
      MMP.Flips.le_closedsCodimension_iff_le_coheight] at hex
    have h2 := hex Q.genericPoint (subset_closure ⟨P.genericPoint, hPmem, hPQ⟩)
    rw [Q.coheight_genericPoint] at h2
    exact absurd h2 (by decide)
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.finset_sum_apply,
    Finset.sum_eq_zero (fun s _ => Finsupp.single_eq_of_ne (hne s).symm), add_zero,
    inverseTransformDivisor, MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv
      (fun Q' h => eq_of_inverseTransformPrimeDivisor_eq_some P Q Q' hPQ h),
    DivisorWithCoeffs.coeff_apply]

end Junction

section Valuations

/-- An element `x` with `v x < 1` lies in the maximal ideal of the valuation subring of `v`. -/
private theorem mem_nonunits_valuationSubring {K Γ : Type*} [Field K]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation K Γ) {x : K} (h : v x < 1) :
    x ∈ v.valuationSubring.nonunits := by
  rw [ValuationSubring.mem_nonunits_iff]
  have := Valuation.isEquiv_valuation_valuationSubring v 1 x
  simp only [map_one] at this
  exact lt_of_not_ge fun h' => (not_le.2 h) (this.2 h')

/-- On a normal integral scheme separated over a field, a prime divisor is determined by its
divisorial valuation: its generic point is the unique centre of that valuation. -/
private theorem divisorialValuation_injective {k : Type u} [Field k] {Y : Scheme.{u}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (sY : Y ⟶ Spec (.of k))
    [IsSeparated sY] :
    Function.Injective (fun P : MMP.Mori.PrimeDivisor Y => P.divisorialValuation) := by
  intro P P' h
  simp only at h
  apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
  refine MMP.Flips.eq_of_isLocal_le_valuationSubring sY P.divisorialValuation.valuationSubring
    ?_ ?_ ?_ ?_
  · intro a
    exact (P.divisorialValuation_le_one_iff _).2 ⟨a, rfl⟩
  · intro a ha
    exact mem_nonunits_valuationSubring _ ((P.divisorialValuation_algebraMap_lt_one_iff a).2 ha)
  · intro a
    rw [Valuation.mem_valuationSubring_iff, h]
    exact (P'.divisorialValuation_le_one_iff _).2 ⟨a, rfl⟩
  · intro a ha
    rw [h]
    exact mem_nonunits_valuationSubring _ ((P'.divisorialValuation_algebraMap_lt_one_iff a).2 ha)

/-- The extension of function fields of a composite of dominant morphisms is the composite. -/
private theorem functionFieldMap_comp' {X Y Z : Scheme.{0}} (a : X ⟶ Y) (b : Y ⟶ Z)
    [IsIntegral X] [IsIntegral Y] [IsIntegral Z] [IsDominant a] [IsDominant b] :
    functionFieldMap (a ≫ b) = (functionFieldMap a).comp (functionFieldMap b) :=
  RingHom.ext fun t =>
    (MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply a b t).symm

/-- Over a dominant morphism inducing a surjection of function fields, a prime divisor of a normal
integral scheme separated over a field is determined by the valuation it induces downstairs. -/
private theorem valuationOver_injective {k : Type} [Field k] {Y Z : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Z] (sY : Y ⟶ Spec (.of k)) [IsSeparated sY]
    (g : Y ⟶ Z) [IsDominant g] (hg : Function.Surjective (functionFieldMap g)) :
    Function.Injective (fun P : MMP.Mori.PrimeDivisor Y => P.valuationOver g) :=
  (comap_injective_of_surjective hg).comp (divisorialValuation_injective sY)

end Valuations

section Tail

variable {T : StabilizedTail}

/-- **Boundary coefficients along a stabilized tail.** A prime divisor `Γ` of `X_0` has a strict
transform `Γ_i` on every `X_i`, with `ord_{Γ_i}` the transport of `ord_Γ` and
`coeff_{Γ_i} B_i = coeff_Γ B_0`. -/
private theorem exists_primeDivisor_coeff_eq (T : StabilizedTail)
    (Γ : MMP.Mori.PrimeDivisor (T.X 0)) :
    ∀ i, ∃ Γi : MMP.Mori.PrimeDivisor (T.X i), (T.B i).coeff Γi = (T.B 0).coeff Γ ∧
      T.IsTransportedValuationFrom i Γ.divisorialValuation Γi.divisorialValuation
  | 0 => ⟨Γ, rfl, rfl⟩
  | i + 1 => by
    obtain ⟨Γi, hc, ht⟩ := exists_primeDivisor_coeff_eq T Γ i
    obtain ⟨-, e, he⟩ := (T.isThreefoldStepDiagram i).isExceptionalValuation_iff_of_isSmallMorphism
      (T.isSmallMorphism i)
    refine ⟨e Γi, ?_, Γi.divisorialValuation, ht, (he Γi).2.1⟩
    rw [T.B_eq i, (he Γi).2.2, hc]

/-- The transport of a valuation of `k(X_0)` to `k(X_i)` is unique. -/
private theorem isTransportedValuationFrom_unique : ∀ (i : ℕ)
    {ν : Valuation (T.X 0).functionField (WithZero (Multiplicative ℤ))}
    {w w' : Valuation (T.X i).functionField (WithZero (Multiplicative ℤ))},
    T.IsTransportedValuationFrom i ν w → T.IsTransportedValuationFrom i ν w' → w = w'
  | 0, _, _, _, h, h' => h.trans h'.symm
  | i + 1, _, _, _, ⟨u, hu, h⟩, ⟨u', hu', h'⟩ => by
    obtain rfl := isTransportedValuationFrom_unique i hu hu'
    have := (T.isThreefoldStepDiagram i).isNormalVariety_target.1.toIsIntegral
    have := (T.isThreefoldStepDiagram i).isSmallMorphism_plus.isBirationalMorphism.isDominant
    exact comap_injective_of_surjective (T.isThreefoldStepDiagram
      i).isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective.2 (h.trans h'.symm)

variable {C : TerminalChain T}

/-- **The label coefficient at a junction.** If `ord_S = ord_Γ` for a prime divisor `Γ` of `X_0`,
the centre of `ord_S` on the junction `Y_i` is a prime divisor `P` whose coefficient in `Θ_i`, and
in the decreased boundary `Θ_i'`, is `coeff_Γ B_0`. -/
private theorem exists_isLabelCentre_coeff_eq {Γ : MMP.Mori.PrimeDivisor (T.X 0)} {S : C.Label}
    (hlab : labelValuation S = Γ.divisorialValuation) (i : ℕ) :
    ∃ P : MMP.Mori.PrimeDivisor (C.junction i).Y, C.IsLabelCentre S ⟨i, none⟩ P ∧
      (C.junction i).Θ.coeff P = (T.B 0).coeff Γ ∧ (C.bridge i).Θ'.coeff P = (T.B 0).coeff Γ := by
  obtain ⟨Γi, hΓc, hΓt⟩ := exists_primeDivisor_coeff_eq T Γ i
  have := (C.junction i).isBirationalMorphism.isDominant
  obtain ⟨P, -, hv, hc⟩ := CrepantJunction.exists_inverseTransform (C.junction i) Γi
  obtain ⟨a, -, hΘ⟩ := (C.junction i).Θ_eq
  obtain ⟨a', -, hΘ'⟩ := (C.bridge i).isDecreasedBoundary
  exact ⟨P, ⟨_, hlab ▸ hΓt, hv⟩, by rw [hΘ, hc, hΓc], by rw [hΘ', hc, hΓc]⟩

/-- **The centre on the first model of a bridge.** A prime divisor `Q` of `V_0 = Y_i` that is a
centre of `ord_S` as a model of the `i`-th bridge is the centre of `ord_S` on the junction
`Y_i`. -/
private theorem eq_of_isLabelCentre_bridge_zero (S : C.Label) {i : ℕ} (h0 : 0 < (C.bridge i).P.m)
    {Q P : MMP.Mori.PrimeDivisor (C.junction i).Y} (hQ : C.IsLabelCentre S ⟨i, some ⟨0, h0⟩⟩ Q)
    (hP : C.IsLabelCentre S ⟨i, none⟩ P) : Q = P := by
  have := (C.junction i).isBirationalMorphism.isDominant
  have := (T.isThreefoldStepDiagram i).isNormalVariety_target.1.toIsIntegral
  have := (T.isThreefoldStepDiagram i).isBirationalMorphism_minus.isDominant
  have : IsProper ((C.junction i).p ≫ T.sX i) :=
    isProper_of_isProjectiveMorphism _ (C.junction i).isProjectiveVariety.isProjective
  obtain ⟨w, hw, _, hval⟩ := hQ
  obtain ⟨w', hw', rfl⟩ := hP
  obtain rfl := isTransportedValuationFrom_unique i hw hw'
  refine valuationOver_injective ((C.junction i).p ≫ T.sX i) ((C.junction i).p ≫ T.f i) ?_
    (Eq.trans hval (valuationOver_comp P _ _).symm)
  rw [functionFieldMap_comp']
  exact (C.junction i).isBirationalMorphism.functionFieldMap_bijective.2.comp
    (T.isThreefoldStepDiagram i).isBirationalMorphism_minus.functionFieldMap_bijective.2

/-- Along the `i`-th bridge, the coefficient of the image of a prime divisor of `Y_0` in the
boundary of each model `V_n` is its coefficient in `V_0`, every flip keeping it. -/
private theorem coeff_boundary_eq_coeff_boundary_zero {i : ℕ}
    (e : ∀ k ≤ (C.bridge i).P.m, MMP.Mori.PrimeDivisor (C.junction 0).Y ≃
      MMP.Mori.PrimeDivisor (modelSeq (C.junction i).Y (C.bridge i).P.Y k))
    (hstep : ∀ (k : ℕ) (hk : k < (C.bridge i).P.m) (P : MMP.Mori.PrimeDivisor (C.junction 0).Y),
      ((C.bridge i).P.boundary (k + 1)).coeff (e (k + 1) hk P) =
        ((C.bridge i).P.boundary k).coeff (e k hk.le P))
    (P : MMP.Mori.PrimeDivisor (C.junction 0).Y) :
    ∀ (n : ℕ) (hn : n ≤ (C.bridge i).P.m),
      ((C.bridge i).P.boundary n).coeff (e n hn P) =
        ((C.bridge i).P.boundary 0).coeff (e 0 (Nat.zero_le _) P)
  | 0, _ => rfl
  | n + 1, hn => (hstep n hn P).trans (coeff_boundary_eq_coeff_boundary_zero e hstep P n _)

end Tail

/-- **Labels coming from the boundary have constant coefficient.** Let `C` be a terminal chain
over a stabilized tail `T`, and let `S` be a label of `C` that is the strict transform
`p_0⁻¹_* Γ` of a component `Γ` of `B_0`. Then for every model `M` of `C` the label
coefficient of `S` at `M` is `coeff_Γ B_0`; in particular `S` is fixed. -/
@[mmp "lem_mmp_indexc_original_labels_fixed"]
public theorem isLabelCoefficient_coeff_and_isFixedLabel {T : StabilizedTail}
    (C : TerminalChain T) {Γ : MMP.Mori.PrimeDivisor (T.X 0)}
    (hΓ : (T.B 0).coeff Γ ≠ 0) {S : C.Label}
    (hS : inverseTransformPrimeDivisor (C.junction 0).p Γ = some S.1) :
    (∀ x : C.ModelIndex, C.IsLabelCoefficient S x ((T.B 0).coeff Γ)) ∧ C.IsFixedLabel S := by
  have hlab : labelValuation S = Γ.divisorialValuation := by
    have := (C.junction 0).isBirationalMorphism.isDominant
    obtain ⟨P, hP, hv, -⟩ := CrepantJunction.exists_inverseTransform (C.junction 0) Γ
    obtain rfl : P = S.1 := Option.some.inj (hP.symm.trans hS)
    exact hv
  have hcoef : ∀ x, C.IsLabelCoefficient S x ((T.B 0).coeff Γ) := by
    rintro ⟨i, _ | k⟩ <;> obtain ⟨P, hP, hΘ, hΘ'⟩ := exists_isLabelCentre_coeff_eq hlab i
    · exact ⟨P, hP, hΘ⟩
    · obtain ⟨e, he, hstep⟩ := (exists_equiv_primeDivisor C).2.1 i
      refine ⟨e k k.2.le S.1, he k k.2.le S.1, ?_⟩
      change ((C.bridge i).P.boundary k).coeff (e k k.2.le S.1) = _
      rw [coeff_boundary_eq_coeff_boundary_zero e hstep,
        eq_of_isLabelCentre_bridge_zero S (k.pos) (he 0 (Nat.zero_le _) S.1) hP]
      exact hΘ'
  exact ⟨hcoef, _, 0, fun i _ => hcoef ⟨i, none⟩⟩

end TerminalChain

/-! ### A uniform discrepancy margin -/

/-- Every coefficient of `B_i` is a coefficient of `B_0`. -/
private theorem exists_coeff_eq (T : StabilizedTail) (i : ℕ) (P : MMP.Mori.PrimeDivisor (T.X i)) :
    ∃ Q : MMP.Mori.PrimeDivisor (T.X 0), (T.B i).coeff P = (T.B 0).coeff Q := by
  induction i with
  | zero => exact ⟨P, rfl⟩
  | succ i ih =>
    obtain ⟨Pm, -, -, -, -, -, hc, -⟩ :=
      (T.isThreefoldStepDiagram i).exists_primeDivisor_valuationOver_eq P
    obtain ⟨Q, hQ⟩ := ih Pm
    exact ⟨Q, by rw [T.B_eq i, hc, hQ]⟩

/-- A common denominator of the coefficients of all `B_i`. -/
private theorem exists_smul_eq (T : StabilizedTail) :
    ∃ q : ℕ, 1 ≤ q ∧ ∀ i, ∃ G : Divisor (T.X i), Divisor.toQDivisor G = (q : ℚ) • T.B i := by
  classical
  refine ⟨∏ Q ∈ (T.B 0).support, ((T.B 0).coeff Q).den, Nat.one_le_iff_ne_zero.mpr
    (Finset.prod_ne_zero_iff.mpr fun Q _ => (Rat.den_pos _).ne'), fun i => ?_⟩
  refine (QDivisor.mem_range_toQDivisor_iff _).2 fun P => ?_
  obtain ⟨Q, hQ⟩ := exists_coeff_eq T i P
  set c := (T.B 0).coeff Q with hc
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, ← DivisorWithCoeffs.coeff_apply, hQ,
    smul_eq_mul]
  by_cases hQs : Q ∈ (T.B 0).support
  · obtain ⟨m, hm⟩ := Finset.dvd_prod_of_mem (fun Q => ((T.B 0).coeff Q).den) hQs
    refine ⟨m * c.num, ?_⟩
    rw [hm]
    push_cast
    rw [mul_comm (c.den : ℚ), mul_assoc, Rat.den_mul_eq_num]
  · refine ⟨0, ?_⟩
    rw [Finsupp.notMem_support_iff, ← DivisorWithCoeffs.coeff_apply] at hQs
    rw [hc, hQs, mul_zero, Int.cast_zero]

/-- The margin at the first stage. -/
private theorem exists_inv_le_of_isLogDiscrepancy_zero (T : StabilizedTail) :
    ∃ r : ℕ, 1 ≤ r ∧ ∀ (n : ℕ) (D : DivisorOver ℂ (T.sX 0)) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy (T.sX 0) n (QDivisor.toRDivisor (T.B 0)) D a →
        (r : ℝ)⁻¹ ≤ a := by
  obtain ⟨⟨-, -, ⟨hX, n₀, K, hK, hQ⟩, -⟩, hpos⟩ := T.isKltPair 0
  have hP : MMP.Mori.IsPair (T.sX 0) (T.B 0) := ⟨hX, n₀, K, hK, hQ⟩
  obtain ⟨r, hr, hC⟩ := hQ.exists_pos
  refine ⟨r, hr, fun n D a ha => ?_⟩
  have h0 : 0 < a := hpos n D a ha
  obtain rfl : n = n₀ := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
  have hac : a = 1 + (c : ℝ) :=
    ((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hc a).mp ha).2
  obtain ⟨-, U, hU, τ, hτ⟩ :=
    MMP.Positivity.IsPair.exists_generatesOn hP hK hC (D.f D.E.genericPoint)
  have hr' : (r : ℚ) ≠ 0 := by exact_mod_cast hr.ne'
  have hcz : (r : ℚ) * c = D.ordPullback τ := by
    rw [hc.eq (show IsDiscrepancy (T.sX 0) n K (T.B 0) D (D.ordPullback τ / r) from
      ⟨hc.1, hK, r, hr, hC, U, hU, τ, hτ, by field_simp⟩)]
    field_simp
  have hcz' : (r : ℝ) * c = D.ordPullback τ := by exact_mod_cast hcz
  have hrpos : (0 : ℝ) < r := by exact_mod_cast hr
  -- `r a = r + ord τ` is a positive integer
  have hint : (0 : ℤ) < r + D.ordPullback τ := by
    have : (0 : ℝ) < r + D.ordPullback τ := by rw [← hcz']; nlinarith
    exact_mod_cast this
  have hint' : (1 : ℝ) ≤ r + D.ordPullback τ := by exact_mod_cast hint
  rw [inv_le_iff_one_le_mul₀ hrpos, hac]
  linarith

/-! ### Log discrepancies along a step -/

section OffBadLocus

variable {Xm Xp Z : Scheme.{0}} [IsIntegral Xm] [CompactSpace Xm] [IsLocallyNoetherian Xm]
  [IsNormal Xm] [IsIntegral Xp] [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]
  {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
  {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}

/-- The divisorial valuation of a prime divisor `E'` of an open subscheme is that of its closure,
through the identification of function fields. -/
private theorem divisorialValuation_primeDivisorMap {Y V : Scheme.{0}} [IsIntegral Y]
    [IsIntegral V] [IsLocallyNoetherian Y] [IsLocallyNoetherian V] [IsNormal Y] [IsNormal V]
    (j : V ⟶ Y) [IsOpenImmersion j] [IsDominant j] (E' : MMP.Mori.PrimeDivisor V) :
    MMP.Mori.PrimeDivisor.divisorialValuation (OpenWeilRestriction.primeDivisorMap j E') =
      E'.divisorialValuation.comap (functionFieldMap j) := by
  ext g
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  have hg' : functionFieldMap j g ≠ 0 := (map_ne_zero _).2 hg
  rw [Valuation.comap_apply, MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg',
    MMP.Positivity.ord_functionFieldMap_of_isIso j E' _
      (OpenWeilRestriction.genericPoint_primeDivisorMap j E').symm]

/-- An open immersion of nonempty irreducible schemes is birational. -/
private theorem isBirationalMorphism_of_isOpenImmersion {W Y : Scheme.{0}} [IrreducibleSpace W]
    [IrreducibleSpace Y] [Nonempty W] (j : W ⟶ Y) [IsOpenImmersion j] :
    IsBirationalMorphism j := by
  let U : W.Opens := ⊤
  let V' : Y.Opens := (U.ι ≫ j).opensRange
  have hle : U ≤ j ⁻¹ᵁ V' := fun x hx => ⟨⟨x, hx⟩, rfl⟩
  obtain ⟨w⟩ := ‹Nonempty W›
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE j U V' ⟨w, trivial⟩
    ⟨_, ⟨⟨w, trivial⟩, rfl⟩⟩ hle ?_
  have e : j.resLE V' U hle = (U.ι ≫ j).isoOpensRange.hom := by
    rw [← cancel_mono V'.ι, Scheme.Hom.resLE_comp_ι, Scheme.Hom.isoOpensRange_hom_ι]
  rw [e]
  infer_instance

/-- **Crepant invariance**, with the structure morphism of the source given up to equality: if
`ΔY` is the crepant boundary of `(X, Δ)` along a birational `φ : Y ⟶ X`, divisors over `Y` and
over `X` with corresponding valuations have the same discrepancies. -/
private theorem isDiscrepancy_iff_of_crepant {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {n : ℕ} {KX : Divisor X} {Δ : QDivisor X}
    {KY : Divisor Y} {ΔY : QDivisor Y} (hP : MMP.Mori.IsPair sX Δ)
    (hKX : KX.IsCanonicalDivisor sX n) (φ : Y ⟶ X) [IsDominant φ] (hs : φ ≫ sX = sY)
    (hY : IsNormalVariety ℂ sY) (hφ : IsBirationalMorphism φ) (hKY : KY.IsCanonicalDivisor sY n)
    (hcb : ∀ (F : MMP.Mori.PrimeDivisor Y) (D : DivisorOver ℂ sX), D.valuation = F.valuationOver φ →
      IsDiscrepancy sX n KX Δ D (-ΔY.coeff F))
    (E : DivisorOver ℂ sY) (E' : DivisorOver ℂ sX)
    (hv : E'.valuation = E.valuation.comap (functionFieldMap φ)) (a : ℚ) :
    IsDiscrepancy sY n KY ΔY E a ↔ IsDiscrepancy sX n KX Δ E' a := by
  subst hs
  have hcb' : IsCrepantBoundary sX n KX Δ φ hY hφ ΔY := fun F => hcb F _ rfl
  exact (IsPair.isDiscrepancy_iff_of_crepant hP φ hY hφ hKX hKY (Or.inl hcb')).2 E E' hv a

/-- Off the bad locus the log discrepancies of corresponding divisors agree. -/
private theorem eq_of_not_subset_badLocusPlus (h : IsThreefoldStepDiagram sXm sZ sXp K B fm fp)
    (hB : MMP.Fourfold.IsPair sXm B)
    (Dp : DivisorOver ℂ sXp) (Dm : DivisorOver ℂ sXm)
    (hv : haveI : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
      haveI := h.isBirationalMorphism_minus.isDominant
      haveI := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
      Dp.valuation.comap (functionFieldMap fp) = Dm.valuation.comap (functionFieldMap fm))
    (hc : ¬ (Dp.center : Set Xp) ⊆ badLocusPlus fm fp)
    {n n' : ℕ} {ap am : ℝ}
    (hap : MMP.Intersection.IsLogDiscrepancy sXp n
      (QDivisor.toRDivisor (flipTransform fm fp B)) Dp ap)
    (ham : MMP.Intersection.IsLogDiscrepancy sXm n' (QDivisor.toRDivisor B) Dm am) :
    am = ap := by
  have : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
  have := h.isBirationalMorphism_minus.isDominant
  have := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
  have hU : ((Dp.center : Set Xp) ∩ (fp ⁻¹ᵁ commonBiregularLocus fm fp : Set Xp)).Nonempty := by
    rw [Set.not_subset] at hc
    obtain ⟨x, hx, hxW⟩ := hc
    refine ⟨x, hx, ?_⟩
    rw [coe_badLocusPlus, coe_badLocusBase] at hxW
    simpa using hxW
  -- dimensions and canonical divisors
  obtain ⟨mp, hKp⟩ := h.isCanonicalDivisor_plus
  obtain ⟨mm, hKm⟩ := h.isCanonicalDivisor
  obtain rfl : mp = n := by
    exact_mod_cast hKp.topologicalKrullDim_eq.symm.trans
      (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hap)
  obtain rfl : mm = n' := by
    exact_mod_cast hKm.topologicalKrullDim_eq.symm.trans
      (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ham)
  obtain rfl : mm = mp := by
    exact_mod_cast hKm.topologicalKrullDim_eq.symm.trans
      (h.dim_minus.trans (h.dim_plus.symm.trans hKp.topologicalKrullDim_eq))
  have hPp : IsPairWith sXp mm (flipTransform fm fp K) (flipTransform fm fp B) :=
    ⟨h.isNormalVariety_plus, hKp, h.isQCartier_plus⟩
  obtain ⟨cp, hcp⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPp.isPair hKp Dp
  obtain ⟨cm, hcm⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hB.isPair hKm Dm
  rw [((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hcp ap).mp hap).2,
    ((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hcm am).mp ham).2]
  suffices hcc : cm = cp by rw [hcc]
  -- restriction of `Dp` to `V⁺ = (f⁺)⁻¹(U)`
  obtain ⟨hY, hf, E', -, hval, hiff⟩ := DivisorOver.exists_restrict_isDiscrepancy_iff hPp Dp _ hU
  have hcE := (hiff cp).mp hcp
  -- the identification `V⁺ ≅ V⁻ ⊆ X⁻` over `U`
  have : Nonempty (fp ⁻¹ᵁ commonBiregularLocus fm fp) := ⟨⟨hU.choose, hU.choose_spec.2⟩⟩
  have : IsIso (fm ∣_ commonBiregularLocus fm fp) := isBiregular_commonBiregularLocus_left fm fp
  have : IsIso (fp ∣_ commonBiregularLocus fm fp) := isBiregular_commonBiregularLocus_right fm fp
  let φ : (fp ⁻¹ᵁ commonBiregularLocus fm fp).toScheme ⟶ Xm :=
    (fp ∣_ commonBiregularLocus fm fp) ≫ inv (fm ∣_ commonBiregularLocus fm fp) ≫
      (fm ⁻¹ᵁ commonBiregularLocus fm fp).ι
  have hφ : φ ≫ fm = (fp ⁻¹ᵁ commonBiregularLocus fm fp).ι ≫ fp := by
    simp only [φ, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
  have hs : φ ≫ sXm = (fp ⁻¹ᵁ commonBiregularLocus fm fp).ι ≫ sXp := by
    rw [← h.comp_eq_minus, ← h.comp_eq_plus, ← Category.assoc, hφ, Category.assoc]
  have : IsOpenImmersion φ := by dsimp only [φ]; infer_instance
  have hφb : IsBirationalMorphism φ := isBirationalMorphism_of_isOpenImmersion φ
  have : IsDominant φ := hφb.isDominant
  have : IsDominant (fp ⁻¹ᵁ commonBiregularLocus fm fp).ι :=
    Opens.isDominant_ι ((fp ⁻¹ᵁ commonBiregularLocus fm fp).isOpen.dense
      ⟨hU.choose, hU.choose_spec.2⟩)
  have : IsDominant (φ ≫ fm) := inferInstance
  have : IsDominant ((fp ⁻¹ᵁ commonBiregularLocus fm fp).ι ≫ fp) := inferInstance
  have hfm := h.isBirationalMorphism_minus.functionFieldMap_bijective.2
  -- valuations of prime divisors of `V⁺`, read on `k(X⁻)` and on `k(X⁺)`
  have hvF : ∀ F : MMP.Mori.PrimeDivisor (fp ⁻¹ᵁ commonBiregularLocus fm fp).toScheme,
      (F.valuationOver φ).comap (functionFieldMap fm) =
        MMP.Mori.PrimeDivisor.valuationOver
          (OpenWeilRestriction.primeDivisorMap (fp ⁻¹ᵁ commonBiregularLocus fm fp).ι F) fp := by
    intro F
    ext t
    simp only [MMP.Mori.PrimeDivisor.valuationOver, Valuation.comap_apply]
    rw [divisorialValuation_primeDivisorMap, Valuation.comap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_congr hφ]
  have hvE : Dm.valuation = (DivisorOver.valuation (⟨_, Dp.f ∣_ _, hY, hf, E'⟩ :
      DivisorOver ℂ ((fp ⁻¹ᵁ commonBiregularLocus fm fp).ι ≫ sXp))).comap
        (functionFieldMap φ) := by
    apply comap_injective_of_surjective hfm
    beta_reduce
    rw [← hv, hval]
    ext t
    simp only [Valuation.comap_apply]
    rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_congr hφ]
  have hcb : ∀ (F : MMP.Mori.PrimeDivisor (fp ⁻¹ᵁ commonBiregularLocus fm fp).toScheme)
      (D : DivisorOver ℂ sXm), D.valuation = F.valuationOver φ →
      IsDiscrepancy sXm mm K B D
        (-((flipTransform fm fp B).restrictOpen (fp ⁻¹ᵁ commonBiregularLocus fm fp)).coeff F) := by
    intro F D hD
    rw [DivisorWithCoeffs.coeff_restrictOpen]
    obtain ⟨Pm, -, hPm, -, -, -, hcoef, -⟩ := h.exists_primeDivisor_valuationOver_eq
      (OpenWeilRestriction.primeDivisorMap (fp ⁻¹ᵁ commonBiregularLocus fm fp).ι F)
    rw [hcoef]
    obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hB.isPair hKm
      (DivisorOver.ofPrimeDivisor ℂ h.isNormalVariety_minus Pm)
    obtain ⟨cD, hcD⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hB.isPair hKm D
    have hvD :
        D.valuation = (DivisorOver.ofPrimeDivisor ℂ h.isNormalVariety_minus Pm).valuation := by
      rw [valuation_ofPrimeDivisor, hD]
      apply comap_injective_of_surjective hfm
      beta_reduce
      rw [hvF, ← hPm]
      rfl
    have e := MMP.Threefold.Mori.ModelIndependence.isDiscrepancy_eq_of_center_eq hvD
      (MMP.Threefold.Mori.ModelIndependence.center_eq_of_valuation_eq h.isNormalVariety_minus hvD)
      hcD hc₀
    rw [← hc₀.eq_neg_coeff_of_ofPrimeDivisor h.isNormalVariety_minus, ← e]
    exact hcD
  have hcrep := isDiscrepancy_iff_of_crepant hB.isPair hKm φ hs hcE.1 hφb hcE.2.1 hcb
    ⟨_, Dp.f ∣_ _, hY, hf, E'⟩ Dm hvE cp
  exact hcm.eq (hcrep.mp hcE)

/-- **The comparison** `a(ξ; X⁻, B⁻) ≤ a(ξ; X⁺, B⁺)`. -/
private theorem le_of_isLogDiscrepancy (h : IsThreefoldStepDiagram sXm sZ sXp K B fm fp)
    (hB : MMP.Fourfold.IsPair sXm B)
    (Dp : DivisorOver ℂ sXp) (Dm : DivisorOver ℂ sXm) (hDm : IsProper Dm.f)
    (hv : haveI : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
      haveI := h.isBirationalMorphism_minus.isDominant
      haveI := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
      Dp.valuation.comap (functionFieldMap fp) = Dm.valuation.comap (functionFieldMap fm))
    {n n' : ℕ} {ap am : ℝ}
    (hap : MMP.Intersection.IsLogDiscrepancy sXp n
      (QDivisor.toRDivisor (flipTransform fm fp B)) Dp ap)
    (ham : MMP.Intersection.IsLogDiscrepancy sXm n' (QDivisor.toRDivisor B) Dm am) :
    am ≤ ap := by
  by_cases hc : (Dp.center : Set Xp) ⊆ badLocusPlus fm fp
  · have ham' : IsValuationLogDiscrepancy sXm B Dm.valuation am := ⟨n', Dm, hDm, rfl, ham⟩
    have hap' : IsValuationLogDiscrepancy sXp (flipTransform fm fp B) Dp.valuation ap :=
      ⟨n, Dp, hap.2.1, rfl, hap⟩
    have hCm : MMP.Intersection.IsCentre ℂ sXm Dm.valuation Dm.center := ⟨Dm, hDm, rfl, rfl⟩
    have hCp : MMP.Intersection.IsCentre ℂ sXp Dp.valuation Dp.center :=
      ⟨Dp, hap.2.1, rfl, rfl⟩
    have hT := IsThreefoldStepDiagram.tfae_lt_and_centre_subset_badLocus h hv
      ham' hap' hCm hCp
    exact (show am < ap from (hT.out 3 1).mp hc).le
  · exact (eq_of_not_subset_badLocusPlus h hB Dp Dm hv hc hap ham).le

/-- The log discrepancy of a proper divisor over a pair exists. -/
private theorem exists_isLogDiscrepancy (hB : MMP.Fourfold.IsPair sXm B) (Dm : DivisorOver ℂ sXm)
    (hDm : IsProper Dm.f) :
    ∃ (n : ℕ) (am : ℝ), MMP.Intersection.IsLogDiscrepancy sXm n (QDivisor.toRDivisor B) Dm am := by
  obtain ⟨-, n, K', hK', -⟩ := hB.isPair
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hB.isPair hK' Dm
  exact ⟨n, _, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hDm⟩

/-- Every divisor `D⁺` over `X⁺` has a counterpart `D⁻` over `X⁻`, proper, whose valuation
agrees with that of `D⁺` on `k(Z)`. -/
private theorem exists_properDivisorOver_minus (h : IsThreefoldStepDiagram sXm sZ sXp K B fm fp)
    (D : DivisorOver ℂ sXp) :
    haveI : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
    haveI := h.isBirationalMorphism_minus.isDominant
    haveI := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
    ∃ D' : DivisorOver ℂ sXm, IsProper D'.f ∧
      D.valuation.comap (functionFieldMap fp) = D'.valuation.comap (functionFieldMap fm) := by
  have : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
  have := h.isBirationalMorphism_minus.isDominant
  have := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
  have : IsSeparated sZ := h.isProjectiveVariety_target.1.toIsSeparated
  have : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have e : (Z ↘ ⊤_ Scheme) = sZ ≫ Limits.terminal.from (Spec (.of ℂ)) := Subsingleton.elim _ _
    rw [e]
    infer_instance
  obtain ⟨φ, hφ, hφS⟩ := exists_isBirational_compHom_eq
    h.isSmallMorphism_plus.isBirationalMorphism h.isBirationalMorphism_minus
  have : IsProper fm := isProper_of_isProjectiveMorphism fm h.isProjectiveMorphism_minus
  have : IsProper fp := h.isSmallMorphism_plus.isProper
  obtain ⟨W, g, g', hW, hg, -, hg'p, hg', -, hcomm, P, hP⟩ :=
    MMP.Mori.exists_isNormalVariety_isProper_isBirationalMorphism_primeDivisor_valuation_eq
      h.isNormalVariety_plus h.isNormalVariety_minus fp fm φ hφ hφS D
  have hW' : IsNormalVariety ℂ (g' ≫ sXm) := by
    rwa [← h.comp_eq_minus, ← Category.assoc, ← hcomm, Category.assoc, h.comp_eq_plus]
  have : IsIntegral W := hW.1.toIsIntegral
  have : IsNormal W := hW.2
  have : IsLocallyNoetherian W :=
    have := hW.1.toLocallyOfFiniteType
    LocallyOfFiniteType.isLocallyNoetherian (g ≫ sXp)
  have := hg.isDominant
  have := hg'.isDominant
  refine ⟨⟨W, g', hW', hg', P⟩, hg'p, ?_⟩
  rw [← hP]
  ext t
  change P.divisorialValuation (functionFieldMap g (functionFieldMap fp t)) =
    P.divisorialValuation (functionFieldMap g' (functionFieldMap fm t))
  rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
    MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
  simp only [hcomm]

end OffBadLocus

/-- Log discrepancies do not drop along a step of the tail. -/
private theorem exists_isLogDiscrepancy_le_succ (T : StabilizedTail) (i : ℕ) {n : ℕ}
    {D : DivisorOver ℂ (T.sX (i + 1))} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy (T.sX (i + 1)) n
      (QDivisor.toRDivisor (T.B (i + 1))) D a) :
    ∃ (n' : ℕ) (D' : DivisorOver ℂ (T.sX i)) (a' : ℝ),
      MMP.Intersection.IsLogDiscrepancy (T.sX i) n' (QDivisor.toRDivisor (T.B i)) D' a' ∧
        a' ≤ a := by
  have h := T.isThreefoldStepDiagram i
  rw [T.B_eq i] at ha
  obtain ⟨Dm, hDm, hv⟩ := exists_properDivisorOver_minus h D
  obtain ⟨n', am, ham⟩ := exists_isLogDiscrepancy (T.isKltPair i).1 Dm hDm
  exact ⟨n', Dm, am, ham, le_of_isLogDiscrepancy h (T.isKltPair i).1 D Dm hDm hv ha ham⟩

/-- **The uniform margin.** A lower bound `1 / r` on the log discrepancies of `(X_0, B_0)`
propagates to every `(X_i, B_i)`, since log discrepancies do not drop along a step. -/
private theorem inv_le_of_isLogDiscrepancy (T : StabilizedTail) {r : ℕ}
    (hr : ∀ (n : ℕ) (D : DivisorOver ℂ (T.sX 0)) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy (T.sX 0) n (QDivisor.toRDivisor (T.B 0)) D a →
        (r : ℝ)⁻¹ ≤ a) :
    ∀ (i : ℕ) {n : ℕ} {D : DivisorOver ℂ (T.sX i)} {a : ℝ},
      MMP.Intersection.IsLogDiscrepancy (T.sX i) n (QDivisor.toRDivisor (T.B i)) D a →
        (r : ℝ)⁻¹ ≤ a := by
  intro i
  induction i with
  | zero => exact fun ha => hr _ _ _ ha
  | succ i ih =>
    intro n D a ha
    obtain ⟨n', D', a', ha', hle⟩ := exists_isLogDiscrepancy_le_succ T i ha
    exact (ih ha').trans hle

/-! ### Log resolutions and log-smooth data -/

section Hironaka

open MMP.Resolution

variable {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}

/-- A variety is a Noetherian scheme. -/
private theorem isNoetherian_of_isVariety (h : AlgebraicGeometry.IsVariety k sY) :
    IsNoetherian Y := by
  have : LocallyOfFiniteType sY := h.toLocallyOfFiniteType
  have : QuasiCompact sY := h.toQuasiCompact
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  exact ⟨⟩

/-- A prime divisor is determined by its support. -/
private theorem primeDivisor_eq_of_support_eq {P Q : MMP.Mori.PrimeDivisor Y}
    (h : (P.support : Set Y) = Q.support) : P = Q := by
  refine AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
    AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
  exact (inseparable_iff_closure_eq.2 h).eq

/-- The ideal sheaf of a prime divisor is the vanishing ideal of its support. -/
private theorem idealSheaf_eq_vanishingIdeal (P : MMP.Mori.PrimeDivisor Y)
    {T : Closeds Y} (hT : (T : Set Y) = P.support) :
    P.idealSheaf = Scheme.IdealSheafData.vanishingIdeal T := by
  have := P.integral
  exact Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ (Closeds.ext hT.symm)

/-- The reduced divisor with components a finite set `s` of prime divisors has support `s`. -/
private theorem support_sum_single (s : Finset (MMP.Mori.PrimeDivisor Y)) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).support = s := by
  classical
  ext E
  simp [Finsupp.finset_sum_apply, Finsupp.single_apply]

/-- A component of a closed subset of pure codimension one is the closure of a point of
codimension one. -/
private theorem exists_coheight_eq_one_of_mem_componentsOf {S : Set Y} (hSc : IsClosed S)
    (hS : MMP.Mori.IsPureCodimOne (⟨S, hSc⟩ : Closeds Y)) {V : Set Y}
    (hV : V ∈ componentsOf S) : ∃ ξ : Y, V = closure {ξ} ∧ Order.coheight ξ = 1 := by
  obtain ⟨ξ, -, hξ⟩ := Aux.exists_eq_closure_of_mem_componentsOf hSc hV
  refine ⟨ξ, hξ, ?_⟩
  rw [← MMP.Flips.codimension_closureSingleton]
  apply hS
  refine ⟨?_, fun W' hW' hle => ?_⟩
  · change closure {ξ} ⊆ S
    rw [← hξ]
    exact hV.1.2
  · have : (W' : Set Y) ⊆ V := hV.2 ⟨W'.isIrreducible, hW'⟩ (by rw [hξ]; exact hle)
    change (W' : Set Y) ⊆ closure {ξ}
    rw [← hξ]
    exact this

/-- The support of a prime divisor contained in an snc closed subset `S` is an irreducible
component of `S`. -/
private theorem support_mem_componentsOf [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) {P : MMP.Mori.PrimeDivisor Y} (hP : (P.support : Set Y) ⊆ S) :
    (P.support : Set Y) ∈ componentsOf S := by
  obtain ⟨hSc, hempty | ⟨hpure, -, -⟩⟩ := hS
  · exfalso
    have := hP (MMP.Flips.primeDivisor_genericPoint_mem_support P)
    rw [hempty] at this
    exact this
  · obtain ⟨-, hcov⟩ := Aux.finite_and_cover_componentsOf hSc
    obtain ⟨W, hW, hηW⟩ := hcov (hP (MMP.Flips.primeDivisor_genericPoint_mem_support P))
    obtain ⟨ξ, hWξ, hξ1⟩ := exists_coheight_eq_one_of_mem_componentsOf hSc hpure hW
    have hsp : ξ ⤳ P.genericPoint := specializes_iff_mem_closure.mpr (hWξ ▸ hηW)
    have hξη : ξ = P.genericPoint := by
      by_contra hne
      have hlt : P.genericPoint < ξ := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hsp)
        fun hle => hne (hsp.antisymm (Scheme.le_iff_specializes.mp hle)).eq
      have := Order.coheight_strictAnti hlt
      rw [hξ1, P.coheight_genericPoint] at this
      exact lt_irrefl _ (this (by simp))
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    change closure {P.genericPoint} ∈ _
    rw [← hξη, ← hWξ]
    exact hW

/-- Only finitely many prime divisors are contained in an snc closed subset. -/
private theorem finite_setOf_support_subset [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) :
    {P : MMP.Mori.PrimeDivisor Y | (P.support : Set Y) ⊆ S}.Finite := by
  refine Set.Finite.of_finite_image ((Aux.finite_and_cover_componentsOf hS.1).1.subset ?_)
    fun P _ Q _ h => primeDivisor_eq_of_support_eq h
  rintro - ⟨P, hP, rfl⟩
  exact support_mem_componentsOf hS hP

/-- **A reduced divisor whose components lie in an snc closed subset is snc.** -/
private theorem isSNC_sum_single_of_support_subset [LocallyOfFiniteType sY] [NoetherianSpace Y]
    [IsLocallyNoetherian Y] (hsm : IsSmoothScheme sY) {S : Set Y} (hS : IsSNCClosedSubset sY S)
    (s : Finset (MMP.Mori.PrimeDivisor Y)) (hs : ∀ P ∈ s, (P.support : Set Y) ⊆ S) :
    (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).IsSNC sY := by
  classical
  have hc : ∀ P ∈ s, (P.support : Set Y) ∈ componentsOf S := fun P hP =>
    support_mem_componentsOf hS (hs P hP)
  obtain ⟨hSc, hempty | ⟨-, -, hfam⟩⟩ := id hS
  · have hs0 : s = ∅ := Finset.eq_empty_of_forall_notMem fun P hP => by
      have := hs P hP (MMP.Flips.primeDivisor_genericPoint_mem_support P)
      rw [hempty] at this
      exact this
    subst hs0
    rw [Finset.sum_empty]
    exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sY hsm
  have hG := support_sum_single s
  have hideal : ∀ P (hP : P ∈ s),
      P.idealSheaf = componentsFamily S ⟨(P.support : Set Y), hc P hP⟩ := fun P hP =>
    idealSheaf_eq_vanishingIdeal P (by
      rw [Closeds.coe_closure, (Aux.isClosed_of_mem_componentsOf hSc (hc P hP)).closure_eq])
  refine ⟨fun P hP => ?_, fun x => ?_⟩
  · rw [hG] at hP
    rw [hideal P hP]
    exact (hfam.1 _).2.2
  · obtain ⟨m, z, c, hz, hcI, hcinj⟩ := hfam.2 x
    have hs' : ∀ P : {P : MMP.Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        P.1 ∈ s := fun P => hG.subset P.2.1
    have hmem : ∀ P : {P : MMP.Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        x ∈ (componentsFamily S ⟨(P.1.support : Set Y), hc P.1 (hs' P)⟩).support := fun P => by
      rw [← SetLike.mem_coe, coe_support_componentsFamily hSc]
      exact P.2.2
    refine ⟨m, z, fun P => c ⟨_, hmem P⟩, hz, fun P Q h => ?_, fun P => ?_⟩
    · have h1 := congrArg (fun V => (V.1.1 : Set Y)) (hcinj h)
      exact Subtype.ext (primeDivisor_eq_of_support_eq h1)
    · rw [hideal P.1 (hs' P)]
      exact hcI ⟨_, hmem P⟩

/-- An snc closed subset of a smooth Noetherian scheme is an snc divisor in the sense of
`MMP.Mori.IsSNCSubset`. -/
private theorem isSNCSubset_of_isSNCClosedSubset [LocallyOfFiniteType sY] [NoetherianSpace Y]
    [IsLocallyNoetherian Y] (hsm : IsSmoothScheme sY) {S : Closeds Y}
    (hS : IsSNCClosedSubset sY (S : Set Y)) : IsSNCSubset sY S := by
  classical
  by_cases hS0 : (S : Set Y) = ∅
  · exact Or.inl (Closeds.ext (by rw [hS0, Closeds.coe_bot]))
  obtain ⟨hSc, hempty | ⟨hpure, -, -⟩⟩ := id hS
  · exact absurd hempty hS0
  set s := (finite_setOf_support_subset hS).toFinset with hs
  have hmem : ∀ P, P ∈ s ↔ (P.support : Set Y) ⊆ S := fun P => by
    rw [hs, Set.Finite.mem_toFinset]; rfl
  refine Or.inr ⟨s, ?_, isSNC_sum_single_of_support_subset hsm hS s fun P hP => (hmem P).mp hP⟩
  apply subset_antisymm
  · exact Set.iUnion₂_subset fun P hP => (hmem P).mp hP
  · intro y hy
    obtain ⟨W, hW, hyW⟩ := (Aux.finite_and_cover_componentsOf hSc).2 hy
    obtain ⟨ξ, hWξ, hξ1⟩ := exists_coheight_eq_one_of_mem_componentsOf hSc hpure hW
    set P := AlgebraicGeometry.PrimeDivisor.ofCoheightOne ξ hξ1
    have hPs : (P.support : Set Y) = W := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
        AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne, hWξ]
    refine Set.mem_iUnion₂.mpr ⟨P, (hmem P).mpr (hPs ▸ hW.1.2), hPs ▸ hyW⟩

variable {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- **Projective log resolutions exist** in characteristic zero (Hironaka). -/
private theorem exists_isLogResolution [CharZero k] [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (hX : IsNormalVariety k sX) (Δ : QDivisor X) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), MMP.Mori.IsLogResolution sX (QDivisor.toRDivisor Δ) f ∧
      AlgebraicGeometry.IsProjective f ∧ AlgebraicGeometry.IsVariety k (f ≫ sX) := by
  obtain ⟨Y, f, hres, hpure, hS, -⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX Δ.support
  have hYv : AlgebraicGeometry.IsVariety k (f ≫ sX) := hres.isVariety_source
  have : IsProper f := hres.isProjective.isProper
  have : IsNoetherian Y := isNoetherian_of_isVariety hYv
  have : IsLocallyNoetherian Y := this.toIsLocallyNoetherian
  have hsupp_eq : ((QDivisor.toRDivisor Δ).supp : Set X) =
      Δ.support.sup fun E => (E.idealSheaf.support : Set X) := by
    rw [QDivisor.supp_toRDivisor, DivisorWithCoeffs.supp, Closeds.coe_finset_sup]
    rfl
  refine ⟨Y, f, ⟨⟨inferInstance, hres.isBirationalMorphism, hres.isSmoothScheme⟩, hpure, ?_⟩,
    hres.isProjective, hYv⟩
  apply isSNCSubset_of_isSNCClosedSubset hres.isSmoothScheme
  change IsSNCClosedSubset (f ≫ sX)
    ((exceptionalSet f : Set Y) ∪ f ⁻¹' ((QDivisor.toRDivisor Δ).supp : Set X))
  rwa [hsupp_eq]

end Hironaka

/-- **Log-smooth data exist** for a klt pair `(X, B)` on a normal projective complex variety: a
log resolution `π : W ⟶ X`, projective since `X` carries an ample invertible sheaf, together with
the reduced divisor `T` of the components of `Ex(π) ∪ π⁻¹(Supp B)`, which carries the crepant
pull-back of `B`. -/
private theorem exists_isLogSmoothDatum {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXp : MMP.Mori.IsProjectiveVariety ℂ sX)
    {B : QDivisor X} (hB : IsKltPair sX B) :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (π : W ⟶ X) (T : Divisor W), IsLogSmoothDatum sX B π T := by
  classical
  obtain ⟨⟨-, -, ⟨hX, n₀, K, hK, hQ⟩, -⟩, -⟩ := id hB
  have hP : MMP.Mori.IsPair sX B := ⟨hX, n₀, K, hK, hQ⟩
  obtain ⟨W, π, hres, hproj, hWv⟩ := exists_isLogResolution hX B
  have : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hXp
  have hpm : IsProjectiveMorphism π := by
    have := Stacks.Ample.isInvertibleModule_unit (Spec (.of ℂ))
    have hqp := (IsProjectiveVariety.isProjective (f := sX)).isQuasiProjective
    obtain ⟨L, _, hLa⟩ := exists_isAmple_of_isQuasiProjective sX _
      (Stacks.Ample.isAmple_unitModule_of_isAffine _) hqp
    exact isProjectiveMorphism_of_isProjective π L hLa hproj
  have hsm : IsSmoothScheme (π ≫ sX) := hres.isSmoothScheme
  have hbir : IsBirationalMorphism π := hres.isBirationalMorphism
  have : IsIntegral W := hWv.toIsIntegral
  obtain ⟨hWn, hWn'⟩ :=
    MMP.Threefold.Resolution.isLocallyNoetherian_and_isNormal_of_isSmoothScheme hsm
  have := hWn
  have := hWn'
  have hW : IsNormalVariety ℂ (π ≫ sX) := ⟨hWv, hWn'⟩
  have : LocallyOfFiniteType (π ≫ sX) := hWv.toLocallyOfFiniteType
  -- the components of `Ex(π) ∪ π⁻¹(Supp B)`
  obtain ⟨s, hs, hsnc⟩ : ∃ s : Finset (MMP.Mori.PrimeDivisor W),
      (⋃ E ∈ s, (E.support : Set W)) =
        ((MMP.Mori.exceptionalSet π ⊔ (QDivisor.toRDivisor B).supp.preimage π.continuous :
          Closeds W) : Set W) ∧
      DivisorWithCoeffs.IsSNC (π ≫ sX) (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
    rcases hres.isSNCSubset with h0 | h
    · refine ⟨∅, ?_, by simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme _ hsm⟩
      rw [h0]
      simp
    · exact h
  set T : Divisor W := ∑ E ∈ s, Finsupp.single E (1 : ℤ) with hTdef
  have hTs : T.support = s := support_sum_single s
  have hcoeff : ∀ P, T.coeff P = if P ∈ s then 1 else 0 := fun P => by
    simp [T, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.single_apply]
  obtain ⟨⟨BW, hBW, -⟩, -⟩ := hP.existsUnique_isCrepantBoundary hK π hW hbir
  refine ⟨W, inferInstance, inferInstance, inferInstance, π, T,
    ⟨hB, hpm.isProjective, hbir, hW, hsm,
    fun P => ?_, hsnc, fun x hx => ?_, n₀, K, BW, hBW, fun F hF => ?_⟩⟩
  · rw [hcoeff P]
    split_ifs <;> simp
  · rw [hTs, hs, Closeds.coe_sup]
    exact Or.inl hx
  · have hF' : BW.coeff F ≠ 0 := by
      simpa [DivisorWithCoeffs.coeff_apply] using hF
    have h1 := support_subset_of_coeff_ne_zero hX hW hbir hBW F hF'
    rw [← hs] at h1
    obtain ⟨E, hE, hηE⟩ :=
      Set.mem_iUnion₂.mp (h1 (MMP.Flips.primeDivisor_genericPoint_mem_support F))
    rw [hTs, MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support hηE]
    exact hE

/-! ### Finiteness of the low-discrepancy set -/

section Finiteness

/-- The coheight of a point of a locally Noetherian scheme is finite. -/
private theorem coheight_ne_top {X : Scheme.{0}} [IsLocallyNoetherian X] (x : X) :
    Order.coheight x ≠ ⊤ := by
  intro htop
  have h1 := ringKrullDim_le_spanFinrank_maximalIdeal (X.presheaf.stalk x)
  rw [ringKrullDim_stalk_eq_coheight, htop] at h1
  have h2 : (⊤ : ℕ∞) ≤ ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).spanFinrank : ℕ∞) := by
    exact_mod_cast h1
  exact ENat.coe_ne_top _ (top_le_iff.1 h2)

variable {X W : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]

/-- **Finitely many valuations of log discrepancy at most one.** If a klt pair `(X, B)` has a
log-smooth datum `(π, T)`, then the set `I(X, B)` of normalized divisorial valuations exceptional
over `X` with `a(ξ; X, B) ≤ 1` is finite. For `ξ ∈ I(X, B)`, regarded on `W`, with centre `Z`,
`a(ξ; X, B) = ∑_{j ∈ J(ξ)} ξ(T_j) a_j + e_T(ξ)` with `a_j > 0` and `e_T(ξ) ∈ ℕ`. If `J(ξ) = ∅`
then `a(ξ; X, B) = e_T(ξ) ≥ codim Z`, while `Z` lies off `Ex(π)`, so `codim Z` is the codimension
of the centre of `ξ` on `X`, at least two. Hence `J(ξ) ≠ ∅`, `e_T(ξ) = 0` and every
`ξ(T_j) ≤ 1 / a_j` is bounded, which leaves finitely many `ξ`. -/
private theorem finite_lowDiscrepancySet_of_isLogSmoothDatum {B : QDivisor X} {π : W ⟶ X}
    {T : Divisor W} (hπ : IsLogSmoothDatum sX B π T) : (lowDiscrepancySet sX B).Finite := by
  classical
  have := hπ.isBirationalMorphism.isDominant
  have : IsProper π := hπ.isProjective.isProper
  obtain ⟨⟨-, -, ⟨hX, n₀, K, hK, hQ⟩, -⟩, hpos⟩ := hπ.isKltPair
  have hP : MMP.Mori.IsPair sX B := ⟨hX, n₀, K, hK, hQ⟩
  have hXv : MMP.Mori.IsVariety ℂ sX := hX.1
  have hWv : MMP.Mori.IsVariety ℂ (π ≫ sX) := hπ.isNormalVariety.1
  -- log discrepancies exist
  have hexLD : ∀ D : DivisorOver ℂ sX, IsProper D.f →
      ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n₀ (QDivisor.toRDivisor B) D a := by
    intro D hD
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
    exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hD⟩
  let Dj : MMP.Mori.PrimeDivisor W → DivisorOver ℂ sX := fun j =>
    ⟨W, π, hπ.isNormalVariety, hπ.isBirationalMorphism, j⟩
  choose aT haT using fun j => hexLD (Dj j) (inferInstanceAs (IsProper π))
  have haTpos : ∀ j, 0 < aT j := fun j => hpos n₀ (Dj j) (aT j) (haT j)
  -- the bound `M`
  set M : ℕ := ⌈∑ j ∈ T.support, (aT j)⁻¹⌉₊ + 1 with hMdef
  have hM : 1 ≤ M := by omega
  have hMj : ∀ j ∈ T.support, (aT j)⁻¹ ≤ M := by
    intro j hj
    calc (aT j)⁻¹ ≤ ∑ j ∈ T.support, (aT j)⁻¹ :=
          Finset.single_le_sum (fun i _ => (inv_pos.2 (haTpos i)).le) hj
      _ ≤ ⌈∑ j ∈ T.support, (aT j)⁻¹⌉₊ := Nat.le_ceil _
      _ ≤ M := by rw [hMdef]; push_cast; linarith
  -- the transport of valuations to `W`
  let e : X.functionField ≃+* W.functionField :=
    RingEquiv.ofBijective (functionFieldMap π) hπ.isBirationalMorphism.functionFieldMap_bijective
  let Φ : Valuation X.functionField ℤᵐ⁰ → Valuation W.functionField ℤᵐ⁰ :=
    fun ξ₀ => ξ₀.comap e.symm.toRingHom
  have hΦ : ∀ ξ₀, (Φ ξ₀).comap (functionFieldMap π) = ξ₀ := by
    intro ξ₀
    ext t
    simp only [Φ, Valuation.comap_apply]
    congr 1
    exact e.symm_apply_apply t
  have hΦinj : Function.Injective Φ := fun ξ₀ ξ₁ h => by rw [← hΦ ξ₀, ← hΦ ξ₁, h]
  have hF := MMP.Fourfold.finite_setOf_isReducedSNCDiscrepancy_zero (π ≫ sX) T hM
  refine (hF.subset ?_).of_finite_image hΦinj.injOn
  rintro _ ⟨ξ₀, ⟨⟨D, hDp, hDv, hcod⟩, a, ⟨n, D', hD'p, hD'v, ha⟩, ha1⟩, rfl⟩
  obtain rfl : n = n₀ := by
    exact_mod_cast (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hK.topologicalKrullDim_eq
  set ξ := Φ ξ₀ with hξdef
  have hξ : ξ.comap (functionFieldMap π) = D'.valuation := by rw [hΦ, hD'v]
  obtain ⟨Z, hZ, e₀, he₀, hform⟩ :=
    IsLogSmoothDatum.logDiscrepancy_eq_sum_add_reducedSNCDiscrepancy sX hπ aT (fun j _ => haT j)
      D' hD'p ha ξ hξ
  obtain ⟨m₀, rfl⟩ := he₀.exists_eq_natCast
  set J := sncIndexSet T (Z : Set W) with hJ
  set η := Z.isIrreducible.genericPoint with hη
  have hZcl : (Z : Set W) = closure {η} := by
    have := Z.isIrreducible.isGenericPoint_genericPoint_closure
    rw [Z.isClosed.closure_eq] at this
    exact this.symm
  have hηZ : η ∈ (Z : Set W) := by rw [hZcl]; exact subset_closure rfl
  have hmem : ∀ j : J, η ∈ (j.1.support : Set W) := fun j => (Finset.mem_filter.1 j.2).2 hηZ
  have hJT : J ⊆ T.support := Finset.filter_subset _ _
  have hdom := SNCWeight.Restriction.dominates_of_isCentre hZcl hZ
  obtain ⟨z₀, hz₀⟩ := SNCWeight.Restriction.exists_localEqs hπ.isSNC hJT hmem
  -- the values `ξ(T_j)` are positive integers
  have hval : ∀ j : J, ∃ m : ℤ, 1 ≤ m ∧
      ξ (algebraMap _ W.functionField (z₀ j)) = WithZero.exp (-m) := by
    intro j
    have hlt := SNCWeight.Subtraction.valuation_lt_one_of_localEq hdom j.1 (hmem j) (hz₀ j)
    have hne : ξ (algebraMap _ W.functionField (z₀ j)) ≠ 0 :=
      (Valuation.ne_zero_iff ξ).2 (SNCWeight.LocalEquation.localEq_ne_zero j.1 (hmem j) (hz₀ j))
    obtain ⟨m, hm⟩ := SNCWeight.Subtraction.exists_exp_of_ne_zero hne
    rw [hm, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hlt
    exact ⟨-m, by omega, by rw [hm, neg_neg]⟩
  choose m hm1 hm using hval
  have hsum := hform z₀ m hz₀ hm
  have hterm : ∀ j : J, 0 ≤ (m j : ℝ) * aT j := fun j =>
    mul_nonneg (by exact_mod_cast (zero_le_one.trans (hm1 j))) (haTpos j).le
  -- `J(ξ)` is nonempty
  have hJne : J.Nonempty := by
    by_contra hJe
    rw [Finset.not_nonempty_iff_eq_empty] at hJe
    obtain ⟨D'', hD''p, hξD'', hD''η⟩ := SNCWeight.Restriction.exists_eq_of_isCentre hZcl hZ
    have hZD : Z = D''.center := by
      ext1
      rw [D''.center_eq_closure_genericPoint, hD''η, ← hZcl]
    -- the centre lies off `Ex(π)`
    have hηE : η ∉ (MMP.Mori.exceptionalSet π : Set W) := by
      intro hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.1 (hπ.exceptionalSet_subset hx)
      have hEJ : E ∈ J := Finset.mem_filter.2 ⟨hE, by
        rw [hZcl]
        exact closure_minimal (Set.singleton_subset_iff.2 hxE) E.idealSheaf.support.isClosed⟩
      rw [hJe] at hEJ
      exact Finset.notMem_empty _ hEJ
    have hcodZ : codimension Z = Order.coheight η := by
      rw [hZD, MMP.Positivity.DivisorOver.codimension_center, hD''η]
    obtain ⟨c, hc⟩ := ENat.ne_top_iff_exists.1 (show codimension Z ≠ ⊤ by
      rw [hcodZ]; exact coheight_ne_top η)
    have hle := he₀.sub_card_sncIndexSet_le hZ hc.symm
    rw [← hJ, hJe, Finset.card_empty, Nat.cast_zero, sub_zero] at hle
    have hsum0 : ∑ j : J, (m j : ℝ) * aT j = 0 :=
      Finset.sum_eq_zero fun j _ => absurd j.2 (Finset.eq_empty_iff_forall_notMem.1 hJe j.1)
    rw [hsum0, zero_add] at hsum
    have hc1 : (c : ℝ) ≤ 1 := by linarith
    -- the centre of `ξ₀` on `X`
    have := D''.isIntegral
    have := D''.isNormal
    have := D''.isLocallyNoetherian
    have := D''.isDominant
    have hb : IsBirationalMorphism (D''.f ≫ π) :=
      MMP.Mori.isBirationalMorphism_comp_of_isBirational π D''.f
        (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hπ.isBirationalMorphism)
        (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism D''.isBirationalMorphism)
    let D₃ : DivisorOver ℂ sX :=
      ⟨D''.Y, D''.f ≫ π, by rw [Category.assoc]; exact D''.isNormalVariety, hb, D''.E⟩
    have hD₃v : D₃.valuation = D.valuation := by
      rw [← hDv, ← hD'v, ← hξ, hξD'']
      ext t
      change D''.E.divisorialValuation (functionFieldMap (D''.f ≫ π) t) =
        D''.E.divisorialValuation (functionFieldMap D''.f (functionFieldMap π t))
      rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
    have hcen := MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hXv hD₃v
    have hcD : codimension D.center = c := by
      rw [← hcen, MMP.Positivity.DivisorOver.codimension_center]
      change Order.coheight (π (D''.f D''.E.genericPoint)) = c
      rw [hD''η, MMP.Positivity.coheight_map_of_mem_biregularLocus π (not_not.mp hηE),
        ← hcodZ, hc]
    rw [hcD] at hcod
    have : (2 : ℝ) ≤ c := by exact_mod_cast hcod
    linarith
  obtain ⟨j₀, hj₀⟩ := hJne
  have hS : ∀ j : J, (m j : ℝ) * aT j ≤ ∑ j : J, (m j : ℝ) * aT j := fun j =>
    Finset.single_le_sum (fun j _ => hterm j) (Finset.mem_univ j)
  have hpos₀ : 0 < (m ⟨j₀, hj₀⟩ : ℝ) * aT j₀ :=
    mul_pos (by exact_mod_cast (zero_lt_one.trans_le (hm1 _))) (haTpos j₀)
  have hm₀ : m₀ = 0 := by
    have h1 := hS ⟨j₀, hj₀⟩
    have : (m₀ : ℝ) < 1 := by linarith
    exact_mod_cast Nat.lt_one_iff.1 (by exact_mod_cast this)
  subst hm₀
  refine ⟨by simpa using he₀, fun Z' hZ' j hj z hz => ?_⟩
  have hZZ' : Z' = Z := by
    obtain ⟨D1, -, h1, h1c⟩ := hZ'
    obtain ⟨D2, -, h2, h2c⟩ := hZ
    rw [h1c, h2c]
    exact MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hWv (h1.symm.trans h2)
  subst hZZ'
  rw [SNCWeight.Subtraction.valuation_eq_of_span_eq hdom (hz.symm.trans (hz₀ ⟨j, hj⟩)),
    hm, WithZero.exp_le_exp, neg_le_neg_iff]
  have h1 : (m ⟨j, hj⟩ : ℝ) * aT j ≤ 1 := by
    have := hS ⟨j, hj⟩
    push_cast at hsum
    linarith
  have h2 : (m ⟨j, hj⟩ : ℝ) ≤ (aT j)⁻¹ := by
    rwa [← one_div, le_div_iff₀ (haTpos j)]
  exact_mod_cast h2.trans (hMj j (hJT hj))

end Finiteness

/-- `I(X_i, B_i)` is finite of cardinality `|I(X_0, B_0)|`. -/
private theorem finite_and_ncard_eq (T : StabilizedTail) (i : ℕ) :
    (lowDiscrepancySet (T.sX i) (T.B i)).Finite ∧
      (lowDiscrepancySet (T.sX i) (T.B i)).ncard = T.lowDiscrepancySetLimit.ncard := by
  induction i with
  | zero =>
    obtain ⟨W, _, _, _, π, D, hπ⟩ :=
      exists_isLogSmoothDatum (T.isProjectiveVariety 0) (T.isKltPair 0)
    exact ⟨finite_lowDiscrepancySet_of_isLogSmoothDatum hπ, rfl⟩
  | succ i ih =>
    have hst := T.isThreefoldStepDiagram i
    have : IsIntegral (T.Z i) := hst.isNormalVariety_target.1.toIsIntegral
    have := hst.isBirationalMorphism_minus.isDominant
    have := hst.isSmallMorphism_plus.isBirationalMorphism.isDominant
    have he := T.lowDiscrepancySet_eq i
    simp only [valuationsOver] at he
    have hm : Function.Injective fun ξ : Valuation _ ℤᵐ⁰ => ξ.comap (functionFieldMap (T.f i)) :=
      comap_injective_of_surjective
        hst.isBirationalMorphism_minus.functionFieldMap_bijective.2
    have hp : Function.Injective fun ξ : Valuation _ ℤᵐ⁰ =>
        ξ.comap (functionFieldMap (T.fp i)) :=
      comap_injective_of_surjective
        hst.isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective.2
    obtain ⟨hfin, hcard⟩ := ih
    have hfin' := hfin.image (fun ξ => ξ.comap (functionFieldMap (T.f i)))
    rw [he] at hfin'
    refine ⟨hfin'.of_finite_image hp.injOn, ?_⟩
    rw [← hcard, ← Set.ncard_image_of_injective _ hp, ← he, Set.ncard_image_of_injective _ hm]

/-- **A uniform discrepancy margin on a stabilized tail.** There are `q, r ≥ 1` such that
`q B_i` is integral and `a(ξ; X_i, B_i) ≥ 1 / r` for every normalized divisorial valuation `ξ`
and every `i`, and every `I(X_i, B_i)` is finite with `|I(X_i, B_i)| = |I_∞|`. -/
@[mmp "lem_mmp_indexc_tail_margin"]
public theorem exists_smul_eq_and_inv_le_and_ncard_eq (T : StabilizedTail) :
    ∃ q r : ℕ, 1 ≤ q ∧ 1 ≤ r ∧
      (∀ i, ∃ G : Divisor (T.X i), Divisor.toQDivisor G = (q : ℚ) • T.B i) ∧
      (∀ i (ξ : Valuation (T.X i).functionField (WithZero (Multiplicative ℤ))),
        MMP.Intersection.IsNormalizedDivisorialValuation ℂ (T.sX i) ξ →
          ∀ a : ℝ, T.IsLogDiscrepancyAt i ξ a → (r : ℝ)⁻¹ ≤ a) ∧
      (∀ i, (lowDiscrepancySet (T.sX i) (T.B i)).Finite ∧
        (lowDiscrepancySet (T.sX i) (T.B i)).ncard = T.lowDiscrepancySetLimit.ncard) := by
  obtain ⟨q, hq, hqB⟩ := exists_smul_eq T
  obtain ⟨r, hr, hr0⟩ := exists_inv_le_of_isLogDiscrepancy_zero T
  refine ⟨q, r, hq, hr, hqB, fun i ξ _ a ⟨n, D, _, _, hD⟩ => ?_, finite_and_ncard_eq T⟩
  exact inv_le_of_isLogDiscrepancy T hr0 i hD

end StabilizedTail

end MMP.Fourfold
