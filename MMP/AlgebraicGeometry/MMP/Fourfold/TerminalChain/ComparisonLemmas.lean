open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold

/-! ### The end morphism of a program lies over the base -/

/-- If `f ∘ u ∘ ψ = π` as rational maps, for the composite birational map `ψ : V_0 ⤏ V_m` of a
finite relative program over `Z`, then `u ≫ f = π_m`: both agree on the dense target of `ψ`. -/
theorem comp_eq_toBase_of_compHom_eq {V Z X : Scheme.{0}} [IsIntegral V]
    [CompactSpace V] [IsLocallyNoetherian V] [IsNormal V] {sV : V ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : V ⟶ Z} {K : Divisor V} {Θ : QDivisor V}
    (P : RelativeFourfoldProgram sV sZ π K Θ) {u : P.endModel ⟶ X} {f : X ⟶ Z}
    (h : (P.compositeMap.compHom u).compHom f = π.toRationalMap) :
    u ≫ f = P.toBase P.m := by
  have : IsSeparated sZ := P.isProjectiveVariety_base.1.toIsSeparated
  have hsep : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have : (Z ↘ ⊤_ Scheme) = sZ ≫ Limits.terminal.from (Spec (.of ℂ)) := Subsingleton.elim _ _
    rw [this]
    infer_instance
  have H := P.isOver_compositePartialIso P.m le_rfl
  set ψ := P.compositePartialIso P.m le_rfl with hψ
  rw [RelativeFourfoldProgram.compositeMap, ← hψ, Scheme.PartialIso.toRationalMap,
    ← Scheme.RationalMap.compHom_toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff] at h
  have h3 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated
    (S := ⊤_ Scheme)).mp h
  have h4 : ψ.iso.hom ≫ ψ.target.ι ≫ P.toBase P.m = ψ.iso.hom ≫ ψ.target.ι ≫ u ≫ f := by
    rw [H]
    exact h3.symm
  have h5 : ψ.target.ι ≫ P.toBase P.m = ψ.target.ι ≫ u ≫ f := (cancel_epi ψ.iso.hom).mp h4
  have : IsDominant ψ.target.ι := Opens.isDominant_ι ψ.dense_target
  exact (ext_of_isDominant_of_isSeparated (Z ↘ ⊤_ Scheme) (Subsingleton.elim _ _)
    ψ.target.ι h5).symm

end

