/-!
# Curves, prime divisors, negativity and common models for terminal chains of fourfolds

This file collects the general lemmas used in the comparison of a stabilized small klt tail of
fourfolds with the programs run from its decreased pairs: that is, in the proofs that the nef
end of such a program is the next crepant junction, that lowering the boundary of a junction
does not lower discrepancies, and that the models of a terminal chain are terminal.

* *Degrees on curves.* For a morphism `u : V ⟶ T` over a field and a Cartier divisor (or
  `ℚ`-Cartier `ℚ`-divisor) `L` on `T`, the pull-back `u^*L` has degree zero on curves contracted
  by `u`, and, by the projection formula, degree `deg(Γ → u(Γ)) · (L · u(Γ))` on the others.
  Hence pull-backs of relatively nef or ample divisors are nef on curves contracted over the
  base.
* *Prime divisors under birational morphisms.* A separated birational morphism `f : X ⟶ Y` onto
  a normal scheme is a local isomorphism over the generic point `η_Q` of each prime divisor `Q`
  of `Y` it reaches, has at most one point over it, and identifies the divisorial valuations;
  transforms and inverse transforms of divisors are computed coefficientwise from this.
* *Negativity.* If `h : Z ⟶ Y` is a proper birational morphism of normal varieties and `-B` is
  nef over `Y` with `h_* B` effective, then `B` is effective
  (`MMP.Fourfold.Oai4C1.Negativity.nonneg_of_transformDivisor_nonneg`).
* *Common models.* Finitely many proper birational models of a normal variety over a field of
  characteristic zero are dominated by a common smooth projective model
  (`MMP.Fourfold.Oai4C1.CommonModel.exists_smooth_projective_model`), on which the strict
  transforms of prime divisors keep their valuations.
* *Finite chains of step diagrams.* Along a chain `V_0 → T_0 ← V_1 → ⋯ ← V_m` of fourfold step
  diagrams dominated by a common model `W`, the comparison divisor
  `q_0^*(K_0 + Θ_0) - q_m^*(K_m + Θ_m)` is effective, anti-nef step by step, and its push-forward
  to `V_m` vanishes.

## Main definitions

* `MMP.Fourfold.Oai4C1.CommonModel.partialIsoOfIsOpenImmersion`: the partial isomorphism
  `U ≅ f(U)` of a dominant morphism which is an open immersion on a dense open `U`.

## Main results

* `MMP.Fourfold.Oai4C1.intersectionNumber_isPullback_eq_mul`,
  `MMP.Fourfold.Oai4C1.intersectionNumber_isPullback_eq_zero`: the projection formula for
  pull-backs of `ℚ`-Cartier `ℚ`-divisors on proper curves.
* `MMP.Fourfold.Oai4C1.transformDivisor_apply_of_map_genericPoint`,
  `MMP.Fourfold.Oai4C1.inverseTransformDivisor_apply_of_map_genericPoint`: coefficients of
  transforms along birational morphisms.
* `MMP.Fourfold.Oai4C1.Negativity.nonneg_of_transformDivisor_nonneg`: the negativity lemma.
* `MMP.Fourfold.Oai4C1.CommonModel.exists_common_model`,
  `MMP.Fourfold.Oai4C1.CommonModel.exists_smooth_projective_model`: common normal and smooth
  projective models.
* `MMP.Fourfold.Oai4C1.StepChain.transformDivisor_pullback_sub_pullback_eq_zero`: the comparison
  divisor of a finite chain of step diagrams is exceptional over its end.
* `MMP.Fourfold.Oai4C1.ProgramComparison.pullback_sub_pullback_succ_nonneg`: the comparison
  divisor of one step of a program is effective.
* `MMP.Fourfold.Oai4C1.BridgeComparison.coeff_isPullback_eq_of_isLogDiscrepancy`: the log
  discrepancy of a divisor over `X` read off a model with compatible canonical divisors.
* `MMP.Fourfold.Oai4C1.comp_eq_toBase_of_compHom_eq`: a morphism from the end of a finite
  relative program compatible with its structure as rational maps lies over the base.

## References

* [OpenAI, *Termination for projective log canonical fourfolds with rational boundary*][oai4]
* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori]
-/

@[expose] public section

namespace MMP.Fourfold.Oai4C1

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold TopologicalSpace

universe u

section Pullback

variable {k : Type u} [Field k] {V T : Scheme.{u}} {sV : V ⟶ Spec (.of k)}
  {sT : T ⟶ Spec (.of k)} [IsSeparated sT] [LocallyOfFiniteType sT]

/-- A proper curve which is not contracted by `u` does not have a point as image. -/
theorem not_exists_range_eq_singleton (u : V ⟶ T) (Γ : ProperCurve sV)
    (h : ¬ Γ.IsContractedBy u) : ¬ ∃ t : T, Set.range (Γ.ι ≫ u) = {t} := by
  rintro ⟨t, ht⟩
  refine h fun x hx => ?_
  rw [← Γ.range_ι] at hx
  obtain ⟨y, rfl⟩ := hx
  have h1 : (Γ.ι ≫ u) y ∈ Set.range (Γ.ι ≫ u) := ⟨y, rfl⟩
  have h2 : (Γ.ι ≫ u) (genericPoint Γ.scheme) ∈ Set.range (Γ.ι ≫ u) := ⟨_, rfl⟩
  rw [ht] at h1 h2
  rw [Scheme.Hom.comp_apply] at h1 h2
  rw [Γ.ι_genericPoint] at h2
  exact h1.trans h2.symm

/-- The image of a proper curve not contracted by `u` is a proper curve. -/
theorem isProperCurve_map (u : V ⟶ T) (hu : u ≫ sT = sV) (Γ : ProperCurve sV)
    (h : ¬ Γ.IsContractedBy u) : IsProperCurve sT (u Γ.point) := by
  set φ := Γ.ι ≫ u with hφdef
  have hφ : φ ≫ sT = Γ.ι ≫ sV := by rw [hφdef, Category.assoc, hu]
  have : IsProper (φ ≫ sT) := hφ ▸ inferInstance
  have : IsProper φ := IsProper.of_comp _ sT
  have := Γ.isCurve
  have : AlgebraicGeometry.IsCurve k (φ ≫ sT) := hφ ▸ inferInstance
  have hpt := not_exists_range_eq_singleton u Γ h
  have hcurve := isCurve_imageι_comp sT φ hpt
  have hker := Γ.ker_comp u
  rw [← hφdef] at hker
  have hdim : topologicalKrullDim (curveSubschemeAt (u Γ.point)) = 1 := by
    have h1 := hcurve.topologicalKrullDim_eq_one
    change topologicalKrullDim φ.ker.subscheme = 1 at h1
    rwa [hker] at h1
  have hprop : IsProper (curveSubschemeAtι (u Γ.point) ≫ sT) := by
    have h1 : IsProper (φ.imageι ≫ sT) := isProper_imageι_comp φ sT
    change IsProper (φ.ker.subschemeι ≫ sT) at h1
    rwa [hker] at h1
  exact ⟨hdim, hprop⟩

/-- If `u ≫ π` contracts a curve `Γ` that `u` does not contract, then `π` contracts the image
curve `u(Γ)`. -/
theorem isContractedBy_map {S : Scheme.{u}} (u : V ⟶ T) (hu : u ≫ sT = sV) (π : T ⟶ S)
    (Γ : ProperCurve sV) (h : ¬ Γ.IsContractedBy u) (hΓ : Γ.IsContractedBy (u ≫ π)) :
    (⟨u Γ.point, isProperCurve_map u hu Γ h⟩ : ProperCurve sT).IsContractedBy π := by
  intro y hy
  change y ∈ closure {u Γ.point} at hy
  rw [← ProperCurve.range_comp u hu Γ] at hy
  obtain ⟨x, rfl⟩ := hy
  have hx : Γ.ι x ∈ closure {Γ.point} := Γ.range_ι ▸ ⟨x, rfl⟩
  have h1 := hΓ _ hx
  simp only [Scheme.Hom.comp_apply] at h1 ⊢
  exact h1

variable [QuasiCompact sV] [QuasiCompact sT] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V]
  [IsLocallyNoetherian T] [IsNormal T]

/-- The pull-back of a Cartier divisor has degree zero on a contracted curve. -/
theorem degreeOn_isPullback_eq_zero (u : V ⟶ T) (hu : u ≫ sT = sV) {D : Divisor T}
    (hD : D.IsCartier) {hB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ D.supp}
    {D' : Divisor V} (h : D.IsPullback u hB D') (Γ : ProperCurve sV) (hΓ : Γ.IsContractedBy u) :
    D'.degreeOn k sV Γ.ι Γ.dim_le (h.isCartier hD) = 0 := by
  have := QuasiCompact.compactSpace_of_compactSpace sT
  have := QuasiCompact.compactSpace_of_compactSpace sV
  obtain rfl := h.eq hD (Divisor.isPullback_pullback hD hB)
  exact Divisor.degreeOn_pullback_eq_zero_of_isContractedBy u hu hD hB Γ hΓ

/-- **Projection formula.** On a curve `Γ` not contracted by `u`, with image the proper curve
`Γ'`, `deg_Γ u^*D = [k(Γ) : k(Γ')] · deg_{Γ'} D`. -/
theorem degreeOn_isPullback_eq_mul (u : V ⟶ T) (hu : u ≫ sT = sV) {D : Divisor T}
    (hD : D.IsCartier) {hB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ D.supp}
    {D' : Divisor V} (h : D.IsPullback u hB D') (Γ : ProperCurve sV) (Γ' : ProperCurve sT)
    (hΓ' : Γ'.point = u Γ.point) :
    D'.degreeOn k sV Γ.ι Γ.dim_le (h.isCartier hD) =
      (residueFieldDegree u Γ.point : ℤ) * D.degreeOn k sT Γ'.ι Γ'.dim_le hD := by
  have := QuasiCompact.compactSpace_of_compactSpace sT
  have := QuasiCompact.compactSpace_of_compactSpace sV
  obtain rfl := h.eq hD (Divisor.isPullback_pullback hD hB)
  rw [Divisor.degreeOn_pullback_eq_degree_pushforward u hu hD hB Γ, OneCycle.pushforward_cycle,
    cyclePushforwardOfPoint, dif_pos (hΓ' ▸ Γ'.isProperCurve)]
  obtain ⟨pt, hpt⟩ := Γ'
  simp only at hΓ'
  subst hΓ'
  simp [OneCycle.degree, Finsupp.linearCombination_single, ProperCurve.degree, Divisor.degreeOn]

/-- The pull-back of a `ℚ`-Cartier `ℚ`-divisor has intersection number zero with a contracted
curve. -/
theorem intersectionNumber_isPullback_eq_zero (u : V ⟶ T) (hu : u ≫ sT = sV)
    {L : QDivisor T} (hL : L.IsQCartier)
    {hB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ L.supp}
    {L' : QDivisor V} (h : L.IsPullback u hB L') (Γ : ProperCurve sV) (hΓ : Γ.IsContractedBy u) :
    L'.intersectionNumber k sV Γ.ι Γ.dim_le (h.isQCartier hL) = 0 := by
  obtain ⟨D, D', hDc, hDB, -, hD', hp⟩ := h.exists_cartierIndex hL
  rw [QDivisor.intersectionNumber_eq_of_smul k sV Γ.ι _ _ _ (QDivisor.cartierIndex_pos hL) D'
    (hp.isCartier hDc) hD', degreeOn_isPullback_eq_zero u hu hDc hp Γ hΓ]
  simp

/-- **Projection formula** for `ℚ`-Cartier `ℚ`-divisors:
`(u^*L · Γ) = [k(Γ) : k(Γ')] · (L · Γ')` for the image curve `Γ'` of `Γ`. -/
theorem intersectionNumber_isPullback_eq_mul (u : V ⟶ T) (hu : u ≫ sT = sV)
    {L : QDivisor T} (hL : L.IsQCartier)
    {hB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ L.supp}
    {L' : QDivisor V} (h : L.IsPullback u hB L') (Γ : ProperCurve sV) (Γ' : ProperCurve sT)
    (hΓ' : Γ'.point = u Γ.point) :
    L'.intersectionNumber k sV Γ.ι Γ.dim_le (h.isQCartier hL) =
      (residueFieldDegree u Γ.point : ℚ) * L.intersectionNumber k sT Γ'.ι Γ'.dim_le hL := by
  obtain ⟨D, D', hDc, hDB, hD, hD', hp⟩ := h.exists_cartierIndex hL
  rw [QDivisor.intersectionNumber_eq_of_smul k sV Γ.ι _ _ _ (QDivisor.cartierIndex_pos hL) D'
    (hp.isCartier hDc) hD', QDivisor.intersectionNumber_eq_of_smul k sT Γ'.ι _ _ _
    (QDivisor.cartierIndex_pos hL) D hDc hD, degreeOn_isPullback_eq_mul u hu hDc hp Γ Γ' hΓ']
  push_cast
  ring

/-- **Nefness of a pull-back.** If `L` is `π`-nef, then `u^*L` has nonnegative intersection
number with every curve contracted by `u ≫ π`: either `u` contracts the curve, or its image is a
curve contracted by `π` and the projection formula applies. -/
theorem intersectionNumber_isPullback_nonneg {S : Scheme.{u}} (u : V ⟶ T)
    (hu : u ≫ sT = sV) (π : T ⟶ S) {L : QDivisor T} (hL : L.IsQCartier)
    (hn : L.IsRelativelyNef sT π)
    {hB : ∀ Z : irreducibleComponents V, u (componentGenericPoint V Z) ∉ L.supp}
    {L' : QDivisor V} (h : L.IsPullback u hB L') (Γ : ProperCurve sV)
    (hΓ : Γ.IsContractedBy (u ≫ π)) :
    0 ≤ L'.intersectionNumber k sV Γ.ι Γ.dim_le (h.isQCartier hL) := by
  by_cases hc : Γ.IsContractedBy u
  · rw [intersectionNumber_isPullback_eq_zero u hu hL h Γ hc]
  · rw [intersectionNumber_isPullback_eq_mul u hu hL h Γ ⟨_, isProperCurve_map u hu Γ hc⟩ rfl]
    exact mul_nonneg (by positivity)
      (QDivisor.IsRelativelyNef.intersectionNumber_nonneg sT hn hL _
        (isContractedBy_map u hu π Γ hc hΓ))

end Pullback

/-- The negative of a `ℚ`-Cartier `ℚ`-divisor is `ℚ`-Cartier. -/
theorem isQCartier_neg {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    {D : QDivisor X} (hD : D.IsQCartier) : (-D).IsQCartier := by
  obtain ⟨m, hm, h⟩ := hD
  exact ⟨m, hm, by rw [smul_neg]; exact h.neg⟩

section Helpers

variable {X Y : Scheme.{u}}

/-- A separated birational morphism onto a normal scheme has at most one point over the generic
point of a prime divisor. -/
theorem eq_of_map_eq_genericPoint [IsIntegral X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {f : X ⟶ Y} [IsSeparated f] (hf : IsBirationalMorphism f)
    {Q : MMP.Mori.PrimeDivisor Y} {x₁ x₂ : X} (h₁ : f x₁ = Q.genericPoint)
    (h₂ : f x₂ = Q.genericPoint) : x₁ = x₂ := by
  have := Q.isDiscreteValuationRing_localRing
  have := hf.isDominant
  exact eq_of_map_eq_of_valuationRing hf.functionFieldMap_bijective h₁ h₂

/-- If `f(η_E) = η_Q` and `f^♯ : 𝒪_{Y,Q} ⟶ 𝒪_{X,E}` is an isomorphism, then `v_E`, seen on
`k(Y)` through `f`, is `v_Q`. -/
theorem valuationOver_eq_of_isIso [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y) [IsDominant f]
    (E : MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor Y)
    (heq : f E.genericPoint = Q.genericPoint) [IsIso (f.stalkMap E.genericPoint)] :
    E.valuationOver f = Q.divisorialValuation := by
  refine Valuation.ext fun t => ?_
  rw [PrimeDivisor.valuationOver_apply]
  by_cases ht : t = 0
  · rw [ht, map_zero, map_zero, map_zero]
  rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
    PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
    MMP.Positivity.ord_functionFieldMap_of_isIso f E Q heq t]

/-- The transform `φ_* D` has coefficient zero at a prime divisor which is the transform of no
prime divisor. -/
theorem mapPrimeDivisors_apply_eq_zero {R : Type*} [AddCommMonoid R]
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)} {P : MMP.Mori.PrimeDivisor Y}
    (h : ∀ E, φ E ≠ some P) (D : DivisorWithCoeffs R X) :
    DivisorWithCoeffs.mapPrimeDivisors φ D P = 0 := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' hD hD' => rw [map_add, Finsupp.add_apply, hD, hD', add_zero]
  | single E r =>
    rw [DivisorWithCoeffs.mapPrimeDivisors_single]
    rcases hφ : φ E with _ | Q
    · rfl
    · have hQ : Q ≠ P := fun hQ => h E (hφ.trans (congrArg some hQ))
      exact Finsupp.single_eq_of_ne (Ne.symm hQ)

/-- Along a separated birational morphism onto a normal scheme, the transform of a divisor has,
at a prime divisor `Q`, the coefficient of the prime divisor `P` over it. -/
theorem transformDivisor_apply_of_map_genericPoint [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsSeparated (Y ↘ Limits.terminal Scheme)]
    {f : X ⟶ Y} [IsSeparated f] (hf : IsBirationalMorphism f) {P : MMP.Mori.PrimeDivisor X}
    {Q : MMP.Mori.PrimeDivisor Y} (h : f P.genericPoint = Q.genericPoint) {R : Type*}
    [AddCommMonoid R] (D : DivisorWithCoeffs R X) :
    RationalMap.transformDivisor (X := X) f.toRationalMap D Q = D P :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq
    ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P Q).mpr h)
    (fun E' hE' => AlgebraicGeometry.PrimeDivisor.genericPoint_injective <|
      eq_of_map_eq_genericPoint hf
        ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f E' Q).mp hE') h) D

/-- Over the biregular locus, the inverse transform of a divisor has, at `P`, the coefficient of
the prime divisor `Q` under `P`. -/
theorem inverseTransformDivisor_apply_of_map_genericPoint {g : X ⟶ Y}
    {P : MMP.Mori.PrimeDivisor X} {Q : MMP.Mori.PrimeDivisor Y}
    (h : g P.genericPoint = Q.genericPoint) (hV : Q.genericPoint ∈ biregularLocus g)
    {R : Type*} [AddCommMonoid R] (D : DivisorWithCoeffs R Y) :
    inverseTransformDivisor g D P = D Q :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq
    (MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint h
      (h ▸ hV))
    (fun Q' hQ' => AlgebraicGeometry.PrimeDivisor.genericPoint_injective <|
      ((MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
        hQ').1.symm.trans h)) D

/-- **A proper birational morphism onto a normal scheme is an isomorphism over the generic point
of every prime divisor**: the fibre over it is a single point, so it lies in the finite-fibre
locus. -/
theorem genericPoint_mem_biregularLocus [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y) [IsProper f] (hf : IsBirationalMorphism f)
    (Q : MMP.Mori.PrimeDivisor Y) : Q.genericPoint ∈ biregularLocus f := by
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso f
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hf)).1 inferInstance
  refine le_biregularLocus (f := f) (V := ⟨_, hU⟩) hiso ?_
  exact Set.Subsingleton.finite fun x₁ h₁ x₂ h₂ => eq_of_map_eq_genericPoint hf h₁ h₂

/-- A morphism whose exceptional set has codimension at least two is biregular over the image
of the generic point of every prime divisor. -/
theorem map_genericPoint_mem_biregularLocus {f : X ⟶ Y}
    (h2 : 2 ≤ closedsCodimension (exceptionalSet f)) (P : MMP.Mori.PrimeDivisor X) :
    f P.genericPoint ∈ biregularLocus f := by
  by_contra h
  have := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet h2 (mem_exceptionalSet.mpr h)
  rw [P.coheight_genericPoint] at this
  exact absurd this (by decide)

/-- Pull-backs of rational functions compose along dominant morphisms of integral schemes. -/
theorem functionFieldMap_comp_apply {A B C : Scheme.{u}} [IsIntegral A] [IsIntegral B]
    [IsIntegral C] (a : A ⟶ B) (b : B ⟶ C) [IsDominant a] [IsDominant b] {c : A ⟶ C}
    [IsDominant c] (hc : a ≫ b = c) (t : C.functionField) :
    functionFieldMap a (functionFieldMap b t) = functionFieldMap c t := by
  subst hc
  have := Scheme.Hom.stalkMapOfEq_comp a b (genericPoint A) (genericPoint B) (genericPoint C)
    (map_genericPoint_of_isDominant a) (map_genericPoint_of_isDominant b)
    (map_genericPoint_of_isDominant (a ≫ b))
  exact (congrArg (fun φ => φ.hom t) this).symm

/-- Valuations with the same pull-back along a surjective ring map are equal. -/
theorem valuation_eq_of_comap_eq {K L : Type*} [Field K] [Field L] {e : K →+* L}
    (he : Function.Surjective e) {v w : Valuation L (WithZero (Multiplicative ℤ))}
    (h : v.comap e = w.comap e) : v = w := by
  refine Valuation.ext fun x => ?_
  obtain ⟨y, rfl⟩ := he x
  exact congrArg (fun u : Valuation K (WithZero (Multiplicative ℤ)) => u y) h

end Helpers

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori

/-! ### Pull-backs of relatively ample divisors -/

/-- The pull-back of a `g`-ample Cartier divisor along `u` has nonnegative degree on every proper
curve contracted by `u ≫ g`. -/
theorem degreeOn_nonneg_of_isPullback {W V T : Scheme.{0}} [IsIntegral W]
    [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace V]
    [IsLocallyNoetherian V] [IsNormal V] {sW : W ⟶ Spec (.of ℂ)} [QuasiCompact sW]
    {sV : V ⟶ Spec (.of ℂ)} [IsSeparated sV] [LocallyOfFiniteType sV] (u : W ⟶ V)
    (hu : u ≫ sV = sW) [IsProper u] {g : V ⟶ T} {L : Divisor V} (hL : L.IsCartier)
    (hamp : L.IsRelativelyAmple g hL)
    {hB : ∀ Z : irreducibleComponents W, u (componentGenericPoint W Z) ∉ L.supp}
    {L' : Divisor W} (hp : L.IsPullback u hB L') (C : ProperCurve sW)
    (hC : C.IsContractedBy (u ≫ g)) :
    0 ≤ L'.degreeOn ℂ sW C.ι C.dim_le (hp.isCartier hL) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := (hp.isCartier hL).isInvertibleModule_divisorialSheaf
  rw [Divisor.degreeOn, degreeOn_eq_of_iso ℂ sW C.ι C.dim_le (hp.divisorialSheafIso (hBc := hL))]
  change 0 ≤ C.degree ℂ ((Scheme.Modules.pullback u).obj L.divisorialSheaf)
  rw [C.degree_pullback u hu]
  split_ifs with h
  · refine mul_nonneg (Nat.cast_nonneg _) (le_of_lt ?_)
    refine MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy g _ hamp
      (⟨u C.point, h⟩ : ProperCurve sV) fun y hy => ?_
    have hcl : IsClosed (u '' closure {C.point}) := u.isClosedMap _ isClosed_closure
    have hsub : ({u C.point} : Set V) ⊆ u '' closure {C.point} :=
      Set.singleton_subset_iff.mpr ⟨C.point, subset_closure rfl, rfl⟩
    obtain ⟨x, hx, rfl⟩ := closure_minimal hsub hcl hy
    simpa only [Scheme.Hom.comp_apply] using hC x hx
  · exact le_rfl

/-- The pull-back of a `ℚ`-divisor with a `g`-ample multiple along `u` has nonnegative
intersection number with every proper curve contracted by `u ≫ g`. -/
theorem intersectionNumber_nonneg_of_isPullback {W V T : Scheme.{0}} [IsIntegral W]
    [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace V]
    [IsLocallyNoetherian V] [IsNormal V] {sW : W ⟶ Spec (.of ℂ)} [QuasiCompact sW]
    {sV : V ⟶ Spec (.of ℂ)} [IsSeparated sV] [LocallyOfFiniteType sV] (u : W ⟶ V)
    (hu : u ≫ sV = sW) [IsProper u] {g : V ⟶ T} {D : QDivisor V}
    (hD : D.HasRelativelyAmpleMultiple g)
    {hB : ∀ Z : irreducibleComponents W, u (componentGenericPoint W Z) ∉ D.supp}
    {P : QDivisor W} (hp : D.IsPullback u hB P) (hPq : P.IsQCartier) (C : ProperCurve sW)
    (hC : C.IsContractedBy (u ≫ g)) :
    0 ≤ P.intersectionNumber ℂ sW C.ι C.dim_le hPq := by
  obtain ⟨m, hm, L, hL, hLq, hamp⟩ := hD
  obtain ⟨L', hL'q, hp'⟩ := hp m hm L hLq hL
  rw [QDivisor.intersectionNumber_eq_of_smul ℂ sW C.ι C.dim_le P hPq hm L' (hp'.isCartier hL)
    hL'q]
  exact div_nonneg (by exact_mod_cast degreeOn_nonneg_of_isPullback u hu hL hamp hp' C hC)
    (Nat.cast_nonneg _)

/-- If `P = u^* D`, then `-P = u^*(-D)`. -/
theorem isPullback_neg {W V : Scheme.{0}} [IsLocallyNoetherian W] [IsNormal W]
    [IsLocallyNoetherian V] [IsNormal V] {u : W ⟶ V} {D : QDivisor V}
    {hB : ∀ Z : irreducibleComponents W, u (componentGenericPoint W Z) ∉ D.supp}
    {P : QDivisor W} (hp : D.IsPullback u hB P)
    (hB' : ∀ Z : irreducibleComponents W, u (componentGenericPoint W Z) ∉ (-D).supp) :
    (-D).IsPullback u hB' (-P) := by
  intro m hm L hLq hL
  have hq : Divisor.toQDivisor ((-1 : ℤ) • L) = (m : ℤ) • D := by
    rw [map_zsmul, hLq, smul_smul, smul_neg]; simp
  obtain ⟨L', hL'q, hp'⟩ := hp m hm _ hq (hL.zsmul _)
  have hm' : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  have hsupp : ∀ Z : irreducibleComponents W,
      u (componentGenericPoint W Z) ∉ ((-1 : ℤ) • ((-1 : ℤ) • L)).supp := fun Z hZ => hB Z (by
    rwa [← Divisor.supp_toQDivisor, map_zsmul, hq, QDivisor.supp_zsmul (by norm_num),
      QDivisor.supp_zsmul hm'] at hZ)
  refine ⟨(-1 : ℤ) • L', by rw [map_zsmul, hL'q, smul_smul, smul_neg]; simp, ?_⟩
  exact (hp'.zsmul (hL.zsmul _) (-1) hsupp).of_eq (by rw [smul_smul]; simp)

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Flips TopologicalSpace

universe u

namespace Negativity

section Intersection

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- A normalization of a proper curve is not constant. -/
theorem not_const_of_isCurveNormalization (C : ProperCurve sX) {C' : Scheme.{u}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) :
    ¬ ∃ y : C.scheme, ∀ x : C', ν.base x = y := by
  rintro ⟨y, hy⟩
  have := hν.isFinite
  have : IsDominant ν := hν.isBirationalMorphism.isDominant
  have huniv : Set.range ν = Set.univ := by
    rw [← ν.isClosedMap.isClosed_range.closure_eq, ν.denseRange.closure_range]
  have : Subsingleton C.scheme := ⟨fun a b => by
    obtain ⟨x, rfl⟩ := huniv.ge (Set.mem_univ a)
    obtain ⟨x', rfl⟩ := huniv.ge (Set.mem_univ b)
    exact (hy x).trans (hy x').symm⟩
  have h0 := topologicalKrullDim_zero_of_discreteTopology C.scheme
  rw [C.dim_eq] at h0
  exact absurd h0 (by decide)

/-- A normalization of a proper curve is a curve. -/
theorem isCurve_comp (C : ProperCurve sX) {C' : Scheme.{u}} {ν : C' ⟶ C.scheme}
    (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1) :
    AlgebraicGeometry.IsCurve k (ν ≫ C.ι ≫ sX) := by
  have := hν.isFinite
  have := hν.isIntegral
  have hp : IsProper (ν ≫ C.ι ≫ sX) := inferInstance
  have : AlgebraicGeometry.IsVariety k (ν ≫ C.ι ≫ sX) :=
    { toIsIntegral := ‹_›, toIsSeparated := hp.toIsSeparated,
      toLocallyOfFiniteType := hp.toLocallyOfFiniteType, toQuasiCompact := inferInstance }
  refine ⟨le_antisymm hdim ?_⟩
  by_contra! h
  refine not_const_of_isCurveNormalization C hν ⟨ν.base (genericPoint C'), fun x => ?_⟩
  by_cases hx : x = genericPoint C'
  · rw [hx]
  · exact absurd (one_le_topologicalKrullDim_of_specializes_of_ne
      (genericPoint_specializes x) (Ne.symm hx)) (not_le.mpr h)

/-- A birational morphism of integral schemes has degree one. -/
theorem degreeOver_eq_one {Y Z : Scheme.{u}} [IsIntegral Y] [IsIntegral Z] (f : Y ⟶ Z)
    (hf : IsBirationalMorphism f) [IsDominant f] [LocallyOfFiniteType f] : degreeOver f = 1 := by
  letI := (functionFieldMap f).toAlgebra
  have heq : functionFieldMap f = dominantFunctionFieldMap f :=
    (congrArg CommRingCat.Hom.hom
      (stalkMap_cast_target f (genericPoint Y) (map_genericPoint_of_isDominant f))).symm
  rw [degreeOver_eq_finrank f heq]
  let e := AlgEquiv.ofBijective (Algebra.ofId Z.functionField Y.functionField)
    (hf.functionFieldMap_bijective)
  rw [← e.toLinearEquiv.finrank_eq, Module.finrank_self]

/-- The degree of an invertible sheaf along a normalization of a proper curve `C` is its degree
along `C`. -/
theorem degreeOn_normalization (C : ProperCurve sX) {C' : Scheme.{u}}
    {ν : C' ⟶ C.scheme} (hν : IsCurveNormalization ν) (hdim : topologicalKrullDim C' ≤ 1)
    [IsProper ((ν ≫ C.ι) ≫ sX)] (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M] :
    MMP.Mori.degreeOn k sX (ν ≫ C.ι) hdim M = MMP.Mori.degreeOn k sX C.ι C.dim_le M := by
  have := hν.isFinite
  have := hν.isIntegral
  haveI : IsProper (ν ≫ C.ι ≫ sX) := by rw [← Category.assoc]; infer_instance
  have hc := isCurve_comp C hν hdim
  have hc2 := C.isCurve
  haveI : IsDominant ν := hν.isBirationalMorphism.isDominant
  have key := curveDegree_pullback_eq_degreeOver_mul k (ν ≫ C.ι ≫ sX) (C.ι ≫ sX) ν rfl
    (not_const_of_isCurveNormalization C hν) ((Scheme.Modules.pullback C.ι).obj M) 1
  rw [degreeOver_eq_one ν hν.isBirationalMorphism, Nat.cast_one, one_mul] at key
  let e : (Scheme.Modules.pullback (ν ≫ C.ι)).obj M ≅
      (Scheme.Modules.pullback ν).obj ((Scheme.Modules.pullback C.ι).obj M) :=
    ((Scheme.Modules.pullbackComp ν C.ι).app M).symm
  rw [MMP.Mori.degreeOn, MMP.Mori.degreeOn,
    invertibleCurveDegree_congr_structure (Category.assoc ν C.ι sX) hdim,
    invertibleCurveDegree_eq_of_iso k _ hdim e,
    invertibleCurveDegree_eq_curveDegree_one, invertibleCurveDegree_eq_curveDegree_one]
  exact key

/-- `L · C` is the degree of `𝒪_X(L)` along `C`, whichever normalization computes it. -/
theorem eq_degreeOn_of_isCartierIntersectionNumber [QuasiCompact sX]
    [IsLocallyNoetherian X] [IsNormal X] {C : ProperCurve sX} {L : Divisor X}
    {hL : L.IsCartier} {d : ℤ} (h : IsCartierIntersectionNumber k sX C L hL d) :
    d = L.degreeOn k sX C.ι C.dim_le hL := by
  obtain ⟨C', ν, hν, hdim, hd⟩ := h
  have := hν.isFinite
  haveI : IsProper ((ν ≫ C.ι) ≫ sX) := by rw [Category.assoc]; infer_instance
  rw [hd]
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := hL.isInvertibleModule_divisorialSheaf
  exact degreeOn_normalization C hν hdim _

/-- **`ℚ`-nefness is `ℝ`-nefness.** A `ℚ`-Cartier `ℚ`-divisor which is nef over `Y` is, as an
`ℝ`-divisor, `ℝ`-Cartier and nef over `Y`. -/
theorem isRelativelyNef_toRDivisor [QuasiCompact sX] [IsLocallyNoetherian X]
    [IsNormal X] {Y : Scheme.{u}} {f : X ⟶ Y} {D : QDivisor X}
    (h : QDivisor.IsRelativelyNef sX f D) :
    MMP.Flips.IsRelativelyNef k sX f (QDivisor.toRDivisor D) := by
  obtain ⟨hD, hh⟩ := h
  set N := D.cartierIndex hD
  have hNpos : (0 : ℚ) < N := by exact_mod_cast QDivisor.cartierIndex_pos hD
  set L : Divisor X := (D.cartierIndexSMul hD : Divisor X)
  have hLc : L.IsCartier := (D.cartierIndexSMul hD).2
  have hLD : ∀ P, (L.coeff P : ℚ) = N * D.coeff P := fun P => by
    have := congrArg (fun G : QDivisor X => G.coeff P) (QDivisor.toQDivisor_cartierIndexSMul D hD)
    simpa [zsmul_eq_mul] using this
  refine ⟨1, fun _ => ((1 / N : ℚ) : ℝ), fun _ => L, fun _ => hLc, ?_, fun C hC x hx => ?_⟩
  · ext P
    rw [Fin.sum_univ_one, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor,
      QDivisor.coeff_toRDivisor, smul_eq_mul, ← Rat.cast_intCast, hLD P]
    push_cast
    field_simp [show (N : ℝ) ≠ 0 by exact_mod_cast hNpos.ne']
  · obtain ⟨hL', d, -, hd, rfl⟩ := hx
    have key := hh C hC
    rw [QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier, Finsupp.smul_single,
      Finsupp.sum_single_index (by simp)] at key
    simp only [smul_eq_mul, mul_one] at key
    rw [Fin.sum_univ_one, eq_degreeOn_of_isCartierIntersectionNumber (hd 0)]
    exact (by exact_mod_cast key :
      (0 : ℝ) ≤ ((1 / N : ℚ) : ℝ) * (L.degreeOn k sX C.ι C.dim_le hLc : ℝ))

end Intersection

/-- An `ℝ`-divisor that is nef over `Y` is `ℝ`-Cartier. -/
theorem isCartierCombination_of_isRelativelyNef {k : Type u} [Field k] {X Y : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Y}
    {D : RDivisor X} (h : MMP.Flips.IsRelativelyNef k sX f D) : IsCartierCombination D := by
  obtain ⟨m, r, L, hL, hD, -⟩ := h
  exact ⟨m, r, L, hL, hD⟩

/-- The negative of an `ℝ`-Cartier divisor is `ℝ`-Cartier. -/
theorem isCartierCombination_neg {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    {D : RDivisor X} (h : IsCartierCombination D) : IsCartierCombination (-D) := by
  obtain ⟨m, r, L, hL, rfl⟩ := h
  exact ⟨m, -r, L, hL, by simp [neg_smul, Finset.sum_neg_distrib]⟩

/-- The zero divisor is `ℝ`-Cartier. -/
theorem isCartierCombination_zero {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] :
    IsCartierCombination (0 : RDivisor X) :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩

/-- For `d + c = n`, the bound `d + 2 ≤ n` is equivalent to `2 ≤ c`. -/
theorem withBot_add_two_le_iff {d : WithBot ℕ∞} {c : ℕ∞} {n : ℕ} (h : d + c = n) :
    d + 2 ≤ n ↔ 2 ≤ c := by
  induction d using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
    rw [← WithBot.coe_add] at h
    have h := WithBot.coe_injective h
    obtain ⟨hd, hc⟩ : d ≠ ⊤ ∧ c ≠ ⊤ := by
      rw [← not_or, ← ENat.add_eq_top, h]; exact ENat.natCast_ne_top n
    lift d to ℕ using hd
    lift c to ℕ using hc
    rw [show (n : WithBot ℕ∞) = ((n : ℕ∞) : WithBot ℕ∞) from rfl, ← WithBot.coe_ofNat,
      ← WithBot.coe_add, WithBot.coe_le_coe]
    norm_cast at h ⊢
    omega

/-- An integral quasi-compact scheme locally of finite type over a field has finite dimension. -/
theorem exists_topologicalKrullDim_eq_natCast {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX] [CompactSpace X] :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  have h1 := topologicalKrullDim_ne_top_of_locallyOfFiniteType k sX
  induction hd : topologicalKrullDim X using WithBot.recBotCoe with
  | bot =>
    exact ((Order.krullDim_eq_bot_iff.mp hd).false
      (IrreducibleCloseds.closureSingleton (genericPoint X))).elim
  | coe d =>
    lift d to ℕ using fun h => h1 (by rw [hd, h]; rfl)
    exact ⟨d, rfl⟩

/-- A prime divisor `P` of `Z` whose image `h(η_P)` has coheight at least two in `Y` is
exceptional over `Y`. -/
theorem isExceptionalPrimeDivisor_of_two_le_coheight {k : Type u} [Field k]
    {Y Z : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} (hY : IsNormalVariety k sY) (h : Z ⟶ Y)
    (hZ : IsNormalVariety k (h ≫ sY)) [IsProper h] (hhb : IsBirationalMorphism h)
    (P : MMP.Mori.PrimeDivisor Z) (h2 : 2 ≤ Order.coheight (h P.genericPoint)) :
    IsExceptionalPrimeDivisor sY h P := by
  have : IsIntegral Y := hY.1.toIsIntegral
  have : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  have : QuasiCompact sY := hY.1.toQuasiCompact
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  obtain ⟨n, hYdim⟩ := exists_topologicalKrullDim_eq_natCast sY
  refine ⟨hZ, hhb, inferInstance, ?_⟩
  unfold ProperDivisorOver.IsExceptional
  rw [ProperDivisorOver.center_eq_toDivisorOver_center,
    DivisorOver.center_eq_closure_genericPoint, hYdim]
  have hd := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sY (h P.genericPoint)
  rw [hYdim] at hd
  exact (withBot_add_two_le_iff hd).mpr h2

/-- If `h_* B` is effective, then `B` has nonnegative coefficient at every prime divisor of `Z`
that is not exceptional over `Y`. -/
theorem coeff_nonneg_of_not_isExceptionalPrimeDivisor {k : Type u} [Field k]
    {Y Z : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} (hY : IsNormalVariety k sY) (h : Z ⟶ Y)
    (hZ : IsNormalVariety k (h ≫ sY)) [IsProper h] (hhb : IsBirationalMorphism h) {B : QDivisor Z}
    (heff : (RationalMap.transformDivisor (X := Z) h.toRationalMap B).IsEffective)
    (P : MMP.Mori.PrimeDivisor Z) (hP : ¬ IsExceptionalPrimeDivisor sY h P) :
    0 ≤ B.coeff P := by
  have : IsIntegral Y := hY.1.toIsIntegral
  have : IsIntegral Z := hZ.1.toIsIntegral
  have : IsDominant h := hhb.isDominant
  have : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : IsNormal Y := hY.2
  have : IsNormal Z := hZ.2
  have hbij := hhb.functionFieldMap_bijective
  have hle : Order.coheight (h P.genericPoint) ≤ 1 := by
    by_contra hlt
    exact hP (isExceptionalPrimeDivisor_of_two_le_coheight hY h hZ hhb P
      (Order.add_one_le_of_lt (not_le.mp hlt)))
  haveI : ValuationRing (Y.presheaf.stalk (h P.genericPoint)) := by
    rcases lt_or_eq_of_le hle with h0 | h1
    · have hmax : IsMax (h P.genericPoint) :=
        Order.coheight_eq_zero.mp (Order.lt_one_iff.mp h0)
      have hgy : h P.genericPoint = genericPoint Y :=
        Specializes.antisymm (hmax (genericPoint_specializes _))
          (genericPoint_specializes _) |>.eq
      rw [hgy]
      change ValuationRing Y.functionField
      infer_instance
    · set Q : MMP.Mori.PrimeDivisor Y := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1
      have hQ : Q.genericPoint = h P.genericPoint :=
        AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1
      have := Q.isDiscreteValuationRing_localRing
      rw [← hQ]
      infer_instance
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing h hbij P.genericPoint
  have hco : Order.coheight (h P.genericPoint) = 1 := by
    have h1 := ringKrullDim_eq_of_ringEquiv
      (asIso (h.stalkMap P.genericPoint)).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight,
      P.coheight_genericPoint] at h1
    exact_mod_cast h1
  set Q : MMP.Mori.PrimeDivisor Y := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hco
  have hQ : Q.genericPoint = h P.genericPoint :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hco
  obtain ⟨E, hE, hiso, hcoeff⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hY hZ hhb Q
  have hEP : E = P := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (MMP.Positivity.eq_of_isIso_stalkMap h hbij (x₁ := P.genericPoint) (x₂ := E.genericPoint)
      (hE.trans hQ)).symm
  have := heff Q
  rwa [DivisorWithCoeffs.coeff_apply, hcoeff B, hEP] at this

/-- **The negativity lemma for `ℝ`-divisors.** Let `h : Z ⟶ Y` be a proper birational morphism of
normal varieties and `B` an `ℝ`-divisor on `Z` with `-B` nef over `Y`. If the coefficient of `B`
along every prime divisor not exceptional over `Y` is nonnegative, then `B` is effective. -/
theorem isEffective_of_isRelativelyNef_neg (k : Type u) [Field k] {Y Z : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) (sZ : Z ⟶ Spec (.of k)) [QuasiCompact sZ] [IsLocallyNoetherian Z]
    [IsNormal Z] (hY : IsNormalVariety k sY) (hZ : IsNormalVariety k sZ) (h : Z ⟶ Y)
    (hh : h ≫ sY = sZ) [IsProper h] (hhb : IsBirationalMorphism h) {B : RDivisor Z}
    (hnef : MMP.Flips.IsRelativelyNef k sZ h (-B))
    (hBG : ∀ P : MMP.Mori.PrimeDivisor Z, ¬ IsExceptionalPrimeDivisor sY h P → 0 ≤ B.coeff P) :
    B.IsEffective := by
  have : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : IsNormal Y := hY.2
  have hMc := isCartierCombination_of_isRelativelyNef hnef
  refine isEffective_of_isNumericallyEquivalentOver_pullback k sY sZ hY hZ h hh hhb
    (L := 0) (L' := 0) isCartierCombination_zero
    ⟨0, Fin.elim0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp, fun j => j.elim0, by simp⟩
    hMc hnef (by simpa using isCartierCombination_neg hMc) hBG ?_
  rw [neg_add_cancel]
  exact ⟨isCartierCombination_zero, isCartierCombination_zero, fun C _ _ r₁ L₁ x₁ _ r₂ L₂ x₂
    h₁ h₂ => (IsRIntersectionNumber.eq_and_linear k sZ C).1 0 r₁ L₁ r₂ L₂ x₁ x₂ h₁ h₂⟩

/-- **The negativity lemma.** Let `h : Z ⟶ Y` be a proper birational morphism of normal
varieties and `B` a `ℚ`-divisor on `Z` with `-B` nef over `Y`. If `h_* B` is effective, then `B`
is effective. -/
theorem nonneg_of_transformDivisor_nonneg (k : Type u) [Field k] {Y Z : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) (sZ : Z ⟶ Spec (.of k)) [QuasiCompact sZ] [IsLocallyNoetherian Z]
    [IsNormal Z] (hY : IsNormalVariety k sY) (hZ : IsNormalVariety k sZ) (h : Z ⟶ Y)
    (hh : h ≫ sY = sZ) [IsProper h] (hhb : IsBirationalMorphism h) {B : QDivisor Z}
    (hnef : (-B).IsRelativelyNef sZ h)
    (heff : 0 ≤ RationalMap.transformDivisor (X := Z) h.toRationalMap B) : 0 ≤ B := fun E => by
  have := isEffective_of_isRelativelyNef_neg k sY sZ hY hZ h hh hhb (B := B.toRDivisor)
    (by simpa using isRelativelyNef_toRDivisor (k := k) hnef) (fun P hP => by
      rw [QDivisor.coeff_toRDivisor]
      exact_mod_cast coeff_nonneg_of_not_isExceptionalPrimeDivisor hY h (hh ▸ hZ) hhb
        (DivisorWithCoeffs.isEffective_iff_nonneg.mpr heff) P hP) E
  rw [QDivisor.coeff_toRDivisor] at this
  exact_mod_cast this

end Negativity

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori Topology TopologicalSpace

universe u

namespace TwoEnds

/-! ### Relatively ample divisors on contracted curves -/

/-- A `ℚ`-divisor with an `f`-ample Cartier multiple has positive intersection number with every
proper curve contracted by `f`. -/
theorem intersectionNumber_pos_of_hasRelativelyAmpleMultiple {k : Type u} [Field k]
    {X Y : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [QuasiCompact sX] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Y} {D : QDivisor X} (hD : D.IsQCartier)
    (ha : D.HasRelativelyAmpleMultiple f) (C : ProperCurve sX) (hC : C.IsContractedBy f) :
    0 < D.intersectionNumber k sX C.ι C.dim_le hD := by
  obtain ⟨m, hm, L, hL, hLD, hamp⟩ := ha
  rw [QDivisor.intersectionNumber_eq_of_smul k sX C.ι C.dim_le D hD hm L hL hLD]
  have := hL.isInvertibleModule_divisorialSheaf
  have hpos := MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f
    L.divisorialSheaf hamp C hC
  have : 0 < L.degreeOn k sX C.ι C.dim_le hL := hpos
  positivity

/-! ### Pull-backs along a composite -/

/-- **Pull-back of Cartier divisors along a composite**: `g^*(f^*L) = (f ∘ g)^*L`. -/
theorem divisor_isPullback_comp {X Y Z : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsLocallyNoetherian Z] [IsNormal Z]
    {f : Y ⟶ X} {g : Z ⟶ Y} {L : Divisor X} {L' : Divisor Y}
    {L'' : Divisor Z} {hB : ∀ W : irreducibleComponents Y, f (componentGenericPoint Y W) ∉ L.supp}
    {hB' : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉ L'.supp}
    (h : L.IsPullback f hB L') (h' : L'.IsPullback g hB' L'')
    (hB'' : ∀ W : irreducibleComponents Z, (g ≫ f) (componentGenericPoint Z W) ∉ L.supp) :
    L.IsPullback (g ≫ f) hB'' L'' := by
  intro U φ hφ E hE
  have hψ := h.isLocalEquation hφ
  rw [h' (f ⁻¹ᵁ U) _ hψ E hE]
  congr 1
  set z := componentGenericPoint Z E.component
  have hzU : f (g z) ∈ U := E.map_componentGenericPoint_mem (g ≫ f) hE
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hzU (hB'' _) (mem_irreducibleComponent_of_irreducibleSpace
    (pointComponent ((g ≫ f) z)) _)
  rw [pullbackComponent_eq hB'' hφ hzU _ a ha]
  set W := pointComponent (g z)
  have hspec : componentGenericPoint Y W ⤳ g z :=
    (isGenericPoint_componentGenericPoint Y W).specializes (mem_pointComponent _)
  have hWU : f (componentGenericPoint Y W) ∈ U :=
    (f.base.hom.map_specializes hspec).mem_open U.isOpen hzU
  have hb : (stalkToRationalFunctions Y (mem_pointComponent (g z))).hom
      (Units.map (f.stalkMap (g z)).hom.toMonoidHom a) =
      ((pullbackLocalEquation f hB hφ : (RationalFunctions Y)ˣ) : RationalFunctions Y) W := by
    have e1 := congrArg Units.val (pullbackLocalEquation_apply f hB hφ W hWU)
    refine Eq.trans ?_ e1.symm
    rw [pullbackComponent_eq hB hφ hWU
      (mem_irreducibleComponent_of_irreducibleSpace (pointComponent ((g ≫ f) z)) _)
      (Units.map (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom.toMonoidHom a)
      ?_]
    · change (stalkToRationalFunctions Y _).hom ((f.stalkMap (g z)).hom a.val) =
        (f.stalkMap _).hom ((X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom
          a.val)
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, stalkToRationalFunctions,
        Scheme.Hom.stalkSpecializes_stalkMap]
    · change (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec) ≫
        X.presheaf.stalkSpecializes _).hom a.val = _
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact ha
  rw [pullbackComponent_eq hB' hψ _ (mem_pointComponent (g z)) _ hb]
  ext
  change _ = ((g ≫ f).stalkMap z).hom a.val
  rw [Scheme.Hom.stalkMap_comp]
  rfl

/-- Pull-back of `ℚ`-divisors along a dominant composite `q ≫ p` from an irreducible scheme to
an integral one is the composite of the pull-backs. -/
theorem qDivisor_isPullback_comp
    {X Y Z : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IrreducibleSpace Z] [IsLocallyNoetherian Z] [IsNormal Z]
    (p : Y ⟶ X) (q : Z ⟶ Y) [IsDominant (q ≫ p)]
    {M : QDivisor X} {MY : QDivisor Y} {MZ : QDivisor Z}
    {hM : ∀ C : irreducibleComponents Y, p (componentGenericPoint Y C) ∉ M.supp}
    {hMY : ∀ C : irreducibleComponents Z, q (componentGenericPoint Z C) ∉ MY.supp}
    (h₁ : M.IsPullback p hM MY) (h₂ : MY.IsPullback q hMY MZ) :
    ∃ hM' : ∀ C : irreducibleComponents Z, (q ≫ p) (componentGenericPoint Z C) ∉ M.supp,
      M.IsPullback (q ≫ p) hM' MZ := by
  refine ⟨MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' _ M,
    fun m hm D hD hDc => ?_⟩
  obtain ⟨D', hD', hpb⟩ := h₁ m hm D hD hDc
  obtain ⟨D'', hD'', hpb'⟩ := h₂ m hm D' hD' (hpb.isCartier hDc)
  exact ⟨D'', hD'', divisor_isPullback_comp hpb hpb' _⟩

end TwoEnds

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Flips
open scoped WithZero

universe u

namespace CommonModel

/-! ### Birational morphisms -/

/-- The partial isomorphism `U ≅ f(U)` of a dominant morphism `f` which is an open immersion on
a dense open `U`. -/
noncomputable def partialIsoOfIsOpenImmersion {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsDominant f] (U : X.Opens) (hU : Dense (U : Set X)) [IsOpenImmersion (U.ι ≫ f)] :
    X.PartialIso Y where
  source := U
  dense_source := hU
  target := (U.ι ≫ f).opensRange
  dense_target := by
    rw [Scheme.Hom.coe_opensRange, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      Scheme.Opens.range_ι]
    exact f.denseRange.dense_image f.continuous hU
  iso := (U.ι ≫ f).isoOpensRange

/-- The partial isomorphism `partialIsoOfIsOpenImmersion f U hU` lies over `f`. -/
theorem partialIsoOfIsOpenImmersion_isOver {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsDominant f] (U : X.Opens) (hU : Dense (U : Set X)) [IsOpenImmersion (U.ι ≫ f)] :
    (partialIsoOfIsOpenImmersion f U hU).IsOver f (𝟙 Y) := by
  simp [partialIsoOfIsOpenImmersion, Scheme.PartialIso.IsOver]

/-- A dominant morphism which is an open immersion on a dense open is birational. -/
theorem isBirationalMorphism_of_isOpenImmersion {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsDominant f] (U : X.Opens) (hU : Dense (U : Set X)) [IsOpenImmersion (U.ι ≫ f)] :
    IsBirationalMorphism f := by
  refine ⟨partialIsoOfIsOpenImmersion f U hU, ?_⟩
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨U, hU, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialIso.toPartialMap_hom,
    Scheme.Hom.toPartialMap_hom, partialIsoOfIsOpenImmersion, Scheme.Hom.isoOpensRange_hom_ι]
  exact (Scheme.homOfLE_ι_assoc _ _ _).trans
    (by rw [Scheme.topIso_hom]; exact (Scheme.homOfLE_ι_assoc _ _ _).symm)

/-- A birational morphism is an open immersion on a dense open. -/
theorem exists_isOpenImmersion_of_isBirationalMorphism {X Y : Scheme.{u}} {f : X ⟶ Y}
    (hf : IsBirationalMorphism f) :
    ∃ U : X.Opens, Dense (U : Set X) ∧ IsOpenImmersion (U.ι ≫ f) := by
  obtain ⟨e, he⟩ := hf
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff] at he
  obtain ⟨W, hW, hWe, hWf, h⟩ := he
  simp only [Scheme.PartialMap.restrict_hom] at h
  have : IsOpenImmersion e.toPartialMap.hom := by
    change IsOpenImmersion (e.iso.hom ≫ e.target.ι)
    infer_instance
  refine ⟨W, hW, ?_⟩
  have : W.ι ≫ f = X.homOfLE hWf ≫ f.toPartialMap.hom := by
    change W.ι ≫ f = (X.homOfLE (le_top : W ≤ ⊤) ≫ X.topIso.hom) ≫ f
    simp only [Scheme.topIso_hom, Scheme.homOfLE_ι]
  rw [this, ← h]
  infer_instance

/-- A composite of birational morphisms out of an irreducible scheme is birational. -/
theorem isBirationalMorphism_comp {X Y Z : Scheme.{u}} [IrreducibleSpace X]
    {f : X ⟶ Y} {g : Y ⟶ Z} (hf : IsBirationalMorphism f) (hg : IsBirationalMorphism g) :
    IsBirationalMorphism (f ≫ g) := by
  haveI := hf.isDominant
  haveI := hg.isDominant
  obtain ⟨U₁, hU₁, h₁⟩ := exists_isOpenImmersion_of_isBirationalMorphism hf
  obtain ⟨U₂, hU₂, h₂⟩ := exists_isOpenImmersion_of_isBirationalMorphism hg
  let U : X.Opens := U₁ ⊓ f ⁻¹ᵁ U₂
  have hne : (U : Set X).Nonempty := by
    obtain ⟨x₀⟩ := (IrreducibleSpace.isIrreducible_univ X).nonempty
    haveI : Nonempty Y := ⟨f x₀⟩
    have hd : Dense (f '' U₁) := f.denseRange.dense_image f.continuous hU₁
    obtain ⟨y, hy₂, x, hx₁, rfl⟩ := (hU₂.inter_of_isOpen_left hd U₂.2).nonempty
    exact ⟨x, hx₁, hy₂⟩
  have hle : U ≤ f ⁻¹ᵁ U₂ := inf_le_right
  have : IsOpenImmersion (f.resLE U₂ U hle ≫ U₂.ι) := by
    rw [Scheme.Hom.resLE_comp_ι, ← Scheme.homOfLE_ι X (inf_le_left : U ≤ U₁), Category.assoc]
    infer_instance
  have := IsOpenImmersion.of_comp (f.resLE U₂ U hle) U₂.ι
  haveI : IsOpenImmersion (U.ι ≫ f ≫ g) := by
    rw [← Category.assoc, ← Scheme.Hom.resLE_comp_ι f hle, Category.assoc]
    infer_instance
  exact isBirationalMorphism_of_isOpenImmersion (f ≫ g) U (U.2.dense hne)

/-- A morphism of integral schemes, locally of finite type and birational in the sense of
`AlgebraicGeometry.IsBirational`, is a birational morphism. -/
theorem isBirationalMorphism_of_isBirational {X Y : Scheme.{u}} [IsIntegral X]
    [IsIntegral Y] (f : X ⟶ Y) [LocallyOfFiniteType f] (hf : IsBirational f) :
    IsBirationalMorphism f := by
  haveI : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]
    exact Set.finite_singleton _
  haveI : Finite (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]
    exact Set.finite_singleton _
  obtain ⟨U, V, hUV, hU, hV, hiso⟩ :=
    exists_dense_opens_isIso_resLE_of_isBirational f hf (Or.inl ⟨inferInstance, inferInstance⟩)
  exact isBirationalMorphism_of_isIso_resLE f U V hU.nonempty hV.nonempty hUV hiso

/-! ### H-projectivity from a quasi-projective source -/

/-- A proper morphism `w : W ⟶ S` whose composite with a separated `s : S ⟶ T` is the
restriction of the structure morphism of `ℙⁿ_T` along an immersion is H-projective: the
immersion lifts to `ℙⁿ_T ×_T S ≅ ℙⁿ_S`, and the lift is proper, hence a closed immersion. -/
theorem isProjectiveMorphism_of_isImmersion {W S T : Scheme.{u}} {n : ℕ}
    (i : W ⟶ projectiveSpaceOver n T) [IsImmersion i] (w : W ⟶ S) [IsProper w]
    (s : S ⟶ T) [IsSeparated s] (h : i ≫ (projectiveSpaceOver n T ↘ T) = w ≫ s) :
    IsProjectiveMorphism w := by
  have := isProper_projectiveSpaceOver n T
  let κ := Limits.pullback.lift i w h
  have : IsImmersion (κ ≫ Limits.pullback.fst (projectiveSpaceOver n T ↘ T) s) := by
    rw [Limits.pullback.lift_fst]
    infer_instance
  have : IsImmersion κ := IsImmersion.of_comp κ (Limits.pullback.fst _ _)
  have : IsProper (κ ≫ Limits.pullback.snd (projectiveSpaceOver n T ↘ T) s) := by
    rw [Limits.pullback.lift_snd]
    infer_instance
  have : IsProper κ := IsProper.of_comp κ (Limits.pullback.snd _ _)
  have : IsClosedImmersion κ := IsClosedImmersion.of_isPreimmersion κ κ.isClosedMap.isClosed_range
  exact ⟨n, κ ≫ (projectiveSpaceOverBaseChangeIso n s).hom, inferInstance, by
    rw [Category.assoc, projectiveSpaceOverBaseChangeIso_hom_over, Limits.pullback.lift_snd]⟩

/-! ### A smooth quasi-projective model of a variety -/

/-- **Nagata compactification of a variety.** A variety is an open subvariety of a proper
variety. -/
theorem exists_isOpenImmersion_isProper {k : Type u} [Field k] {M : Scheme.{u}}
    (sM : M ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sM] :
    ∃ (Mb : Scheme.{u}) (e : M ⟶ Mb) (sMb : Mb ⟶ Spec (.of k)),
      AlgebraicGeometry.IsVariety k sMb ∧ IsProper sMb ∧ IsOpenImmersion e ∧ e ≫ sMb = sM := by
  obtain ⟨c, hqc⟩ := hasCompactification_of_compactSpace_quasiSeparatedSpace sM
  refine ⟨c.immersion.image, c.immersion.toImage, c.immersion.imageι ≫ c.toBase,
    Scheme.Hom.isVariety_image k c.immersion c.toBase, inferInstance,
    isOpenImmersion_toImage _ (.inl hqc), ?_⟩
  rw [← Category.assoc, Scheme.Hom.toImage_imageι]
  exact Over.w c.obj.hom

/-- **A smooth quasi-projective model.** Over a field of characteristic zero, every variety `M`
is the target of a proper birational morphism `p : W ⟶ M` from a smooth variety `W` immersed in
some `ℙⁿ_k`. -/
theorem exists_isImmersion_isSmoothScheme {k : Type u} [Field k] [CharZero k]
    {M : Scheme.{u}} (sM : M ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sM] :
    ∃ (W : Scheme.{u}) (p : W ⟶ M) (n : ℕ) (i : W ⟶ projectiveSpaceOver n (Spec (.of k))),
      IsImmersion i ∧ i ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = p ≫ sM ∧
      AlgebraicGeometry.IsVariety k (p ≫ sM) ∧ IsSmoothScheme (p ≫ sM) ∧ IsProper p ∧
      IsBirationalMorphism p := by
  obtain ⟨Mb, e, sMb, hMb, hMbp, he, hes⟩ := exists_isOpenImmersion_isProper sM
  obtain ⟨P, π, hP, hPproj, -, hπb⟩ :=
    (MMP.Resolution.Bridges.exists_isProjectiveMorphism_isBirational_chowModification k).2 hMb hMbp
  obtain ⟨Y, g, hY, hg, hgb, hYs, -, -⟩ := MMP.Resolution.exists_isStrongResolution (π ≫ sMb) hP
  obtain ⟨A, hA, hAa⟩ := Stacks.HProjective.exists_isAmple_of_isAffine (Spec (.of k))
  obtain ⟨L, hL, hLa⟩ := exists_isAmple_of_isProjectiveMorphism (π ≫ sMb) A hAa hPproj
  obtain ⟨n, c, hc, hcY⟩ := (isProjectiveMorphism_of_isProjective g L hLa hg).comp hPproj
  haveI := hc
  haveI := hY
  haveI := hP
  haveI := hMb
  haveI : IsIntegral Y := hY.toIsIntegral
  haveI : LocallyOfFiniteType π :=
    haveI := hP.toLocallyOfFiniteType
    locallyOfFiniteType_of_comp π sMb
  haveI : IsProper π :=
    haveI := isProper_of_isProjectiveMorphism _ hPproj
    IsProper.of_comp π sMb
  haveI : IsProper g := hg.isProper
  have hgπ : IsBirationalMorphism (g ≫ π) :=
    isBirationalMorphism_comp hgb (isBirationalMorphism_of_isBirational π hπb)
  haveI := hgπ.isDominant
  obtain ⟨U, hU, hUi⟩ := exists_isOpenImmersion_of_isBirationalMorphism hgπ
  let V : Mb.Opens := e.opensRange
  let W : Y.Opens := (g ≫ π) ⁻¹ᵁ V
  have hVne : (V : Set Mb).Nonempty := by
    obtain ⟨x⟩ := (IrreducibleSpace.isIrreducible_univ M).nonempty
    exact ⟨e x, x, rfl⟩
  have hWne : (W : Set Y).Nonempty := by
    obtain ⟨_, hy, y, rfl⟩ := (g ≫ π).denseRange.inter_open_nonempty V V.isOpen hVne
    exact ⟨y, hy⟩
  haveI : Nonempty W := hWne.to_subtype
  let p : W.toScheme ⟶ M := ((g ≫ π) ∣_ V) ≫ e.isoOpensRange.inv
  have hpe : p ≫ e = W.ι ≫ g ≫ π := by
    simp only [p, Category.assoc, Scheme.Hom.isoOpensRange_inv_comp]
    exact morphismRestrict_ι _ _
  have hps : p ≫ sM = W.ι ≫ g ≫ π ≫ sMb := by
    rw [← hes, ← Category.assoc, hpe, Category.assoc, Category.assoc]
  haveI : IsProper p := by
    haveI : IsProper ((g ≫ π) ∣_ V) := IsZariskiLocalAtTarget.restrict (P := @IsProper)
      (inferInstanceAs (IsProper (g ≫ π))) V
    infer_instance
  haveI := hY.toLocallyOfFiniteType
  haveI := hY.toQuasiCompact
  haveI := hY.toIsSeparated
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ π ≫ sMb)
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (g ≫ π ≫ sMb)
  haveI : IsNoetherian Y := ⟨⟩
  haveI : IsIntegral W := isIntegral_of_isOpenImmersion W.ι
  refine ⟨W, p, n, W.ι ≫ c, inferInstance, ?_, ?_, ?_, inferInstance, ?_⟩
  · rw [Category.assoc, hcY, hps]
  · rw [hps]
    exact AlgebraicGeometry.IsVariety.mk
  · rw [hps]
    haveI : IsLocallyNoetherian (Spec (.of k)) := isLocallyNoetherian_Spec.mpr inferInstance
    haveI : LocallyOfFinitePresentation (g ≫ π ≫ sMb) :=
      LocallyOfFinitePresentation.iff_locallyOfFiniteType.2 hY.toLocallyOfFiniteType
    haveI : Smooth (g ≫ π ≫ sMb) := (isSmoothScheme_iff _).1 hYs
    exact MMP.Mori.isSmoothScheme_of_smooth inferInstance
  · let U' : W.toScheme.Opens := W.ι ⁻¹ᵁ U
    have hU'ne : (U' : Set W.toScheme).Nonempty := by
      obtain ⟨y, hyW, hyU⟩ := hU.inter_open_nonempty W W.isOpen hWne
      exact ⟨⟨y, hyW⟩, hyU⟩
    haveI : Nonempty U' := hU'ne.to_subtype
    have : IsOpenImmersion (W.ι.resLE U U' le_rfl ≫ U.ι) := by
      rw [Scheme.Hom.resLE_comp_ι]; infer_instance
    have := IsOpenImmersion.of_comp (W.ι.resLE U U' le_rfl) U.ι
    have : IsOpenImmersion ((U'.ι ≫ p) ≫ e) := by
      rw [Category.assoc, hpe, ← Category.assoc, ← Scheme.Hom.resLE_comp_ι W.ι le_rfl,
        Category.assoc]
      infer_instance
    have : IsOpenImmersion (U'.ι ≫ p) := IsOpenImmersion.of_comp _ e
    haveI : IsDominant p := ⟨(((U'.ι ≫ p).isOpenEmbedding.isOpen_range.dense
      (Set.range_nonempty _)).mono (by rintro _ ⟨x, rfl⟩; exact ⟨U'.ι x, rfl⟩))⟩
    exact isBirationalMorphism_of_isOpenImmersion p U' (U'.isOpen.dense hU'ne)

/-! ### A common normal model of finitely many models -/

/-- A birational morphism `f : X ⟶ S` restricts to an isomorphism of dense opens over `S`. -/
theorem exists_partialIso_isOver {X S : Scheme.{u}} {f : X ⟶ S}
    (hf : IsBirationalMorphism f) : ∃ e : X.PartialIso S, e.IsOver f (𝟙 S) := by
  haveI := hf.isDominant
  obtain ⟨U, hU, _⟩ := exists_isOpenImmersion_of_isBirationalMorphism hf
  exact ⟨_, partialIsoOfIsOpenImmersion_isOver f U hU⟩

/-- A partial isomorphism over `S` induces the rational map of the structure morphism after
composing with the structure morphism of the target. -/
theorem compHom_toRationalMap_of_isOver {S X Y : Scheme.{u}} {sX : X ⟶ S}
    {sY : Y ⟶ S} (e : X.PartialIso Y) (he : e.IsOver sX sY) :
    e.toRationalMap.compHom sY = sX.toRationalMap := by
  rw [← Scheme.RationalMap.compHom_toRationalMap, Scheme.Hom.toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨e.source, e.dense_source, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialMap.compHom, Scheme.PartialIso.toPartialMap,
    Scheme.Hom.toPartialMap]
  rw [Category.assoc, he, Scheme.homOfLE_ι_assoc, Scheme.topIso_hom, Scheme.homOfLE_ι_assoc]

/-- Two proper birational morphisms of normal varieties onto `S` have a common proper birational
normal model over `S`. -/
theorem exists_common_model_two {k : Type u} [Field k] {S M X : Scheme.{u}}
    (sS : S ⟶ Spec (.of k)) (m : M ⟶ S) [IsProper m]
    (hm : IsBirationalMorphism m) (hM : IsNormalVariety k (m ≫ sS)) (f : X ⟶ S) [IsProper f]
    (hf : IsBirationalMorphism f) (hX : IsNormalVariety k (f ≫ sS)) :
    ∃ (Z : Scheme.{u}) (g₁ : Z ⟶ M) (g₂ : Z ⟶ X), IsNormalVariety k (g₁ ≫ m ≫ sS) ∧
      IsProper g₁ ∧ IsProper g₂ ∧ IsBirationalMorphism g₁ ∧ IsBirationalMorphism g₂ ∧
      g₁ ≫ m = g₂ ≫ f := by
  obtain ⟨e₁, he₁⟩ := exists_partialIso_isOver hm
  obtain ⟨e₂, he₂⟩ := exists_partialIso_isOver hf
  obtain ⟨Z, g₁, g₂, hZ, hg₁, hg₂, hb₁, hb₂, -, hc⟩ :=
    exists_isNormalVariety_isProper_isBirationalMorphism hM hX m f (e₁.trans e₂.symm).toRationalMap
      (RationalMap.isBirational_toRationalMap _)
      (compHom_toRationalMap_of_isOver _ (he₁.trans he₂.symm))
  exact ⟨Z, g₁, g₂, hZ, hg₁, hg₂, hb₁, hb₂, hc⟩

/-- Finitely many proper birational morphisms of normal varieties onto `S` have a common proper
birational normal model over `S`. -/
theorem exists_common_model {k : Type u} [Field k] {S : Scheme.{u}}
    (sS : S ⟶ Spec (.of k)) (hS : IsNormalVariety k sS) {ι : Type*} [Finite ι]
    (X : ι → Scheme.{u}) (f : ∀ i, X i ⟶ S) [∀ i, IsProper (f i)]
    (hfb : ∀ i, IsBirationalMorphism (f i)) (hX : ∀ i, IsNormalVariety k (f i ≫ sS)) :
    ∃ (M : Scheme.{u}) (m : M ⟶ S) (h : ∀ i, M ⟶ X i), IsNormalVariety k (m ≫ sS) ∧
      IsProper m ∧ IsBirationalMorphism m ∧
      ∀ i, h i ≫ f i = m ∧ IsProper (h i) ∧ IsBirationalMorphism (h i) := by
  classical
  have := Fintype.ofFinite ι
  suffices H : ∀ s : Finset ι, ∃ (M : Scheme.{u}) (m : M ⟶ S), IsNormalVariety k (m ≫ sS) ∧
      IsProper m ∧ IsBirationalMorphism m ∧
      ∀ i ∈ s, ∃ h : M ⟶ X i, h ≫ f i = m ∧ IsProper h ∧ IsBirationalMorphism h by
    obtain ⟨M, m, hM, hm, hmb, hh⟩ := H Finset.univ
    choose h hh using fun i => hh i (Finset.mem_univ i)
    exact ⟨M, m, h, hM, hm, hmb, hh⟩
  intro s
  induction s using Finset.induction_on with
  | empty =>
    exact ⟨S, 𝟙 S, by rwa [Category.id_comp], inferInstance, isBirationalMorphism_of_isIso _,
      fun i hi => absurd hi (Finset.notMem_empty i)⟩
  | insert a s ha ih =>
    obtain ⟨M, m, hM, hm, hmb, hh⟩ := ih
    haveI := hm
    obtain ⟨Z, g₁, g₂, hZ, hg₁, hg₂, hb₁, hb₂, hc⟩ :=
      exists_common_model_two sS m hmb hM (f a) (hfb a) (hX a)
    haveI := hg₁
    haveI := hg₂
    haveI : IsIntegral Z := hZ.1.toIsIntegral
    refine ⟨Z, g₁ ≫ m, by rwa [Category.assoc], inferInstance, isBirationalMorphism_comp hb₁ hmb,
      fun i hi => ?_⟩
    rcases Finset.mem_insert.1 hi with rfl | hi
    · exact ⟨g₂, hc.symm, hg₂, hb₂⟩
    · obtain ⟨h, hhf, hhp, hhb⟩ := hh i hi
      haveI := hhp
      exact ⟨g₁ ≫ h, by rw [Category.assoc, hhf], inferInstance, isBirationalMorphism_comp hb₁ hhb⟩

/-! ### Strict transforms of prime divisors -/

/-- If a dominant morphism `f : Y ⟶ X` of normal integral schemes inducing a surjection of
function fields maps the generic point of a prime divisor `E` of `Y` to that of a prime divisor
`P` of `X`, then `ord_E`, read in `k(X)`, is `ord_P`. -/
theorem valuationOver_eq_of_map_genericPoint {X Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (f : Y ⟶ X) [IsDominant f] (hf : Function.Surjective (functionFieldMap f))
    (E : MMP.Mori.PrimeDivisor Y) (P : MMP.Mori.PrimeDivisor X)
    (h : f E.genericPoint = P.genericPoint) :
    E.valuationOver f = P.divisorialValuation := by
  have := P.isDiscreteValuationRing_localRing
  have h1 : ∀ z, f E.genericPoint = z → ∀ a : X.presheaf.stalk z,
      E.valuationOver f (algebraMap _ X.functionField a) ≤ 1 := by
    rintro z rfl a
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_algebraMap_stalk,
      MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
    exact ⟨_, rfl⟩
  have h2 : ∀ z, f E.genericPoint = z → ∀ a : X.presheaf.stalk z,
      a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z) →
      E.valuationOver f (algebraMap _ X.functionField a) < 1 := by
    rintro z rfl a ha
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_algebraMap_stalk,
      MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff]
    exact (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
      (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit _ _ hu)
  have h3 : ∃ g, E.valuationOver f g = WithZero.exp (-1) := by
    have := E.isDiscreteValuationRing_localRing
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
    obtain ⟨g, hg⟩ := hf (algebraMap E.localRing Y.functionField ϖ)
    exact ⟨g, by rw [MMP.Mori.PrimeDivisor.valuationOver_apply, hg,
      MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_of_irreducible _ hϖ]⟩
  have h3' : ∃ g, P.divisorialValuation g = WithZero.exp (-1) := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P.localRing
    exact ⟨_, P.divisorialValuation_algebraMap_of_irreducible hϖ⟩
  exact MMP.Positivity.DivisorOver.valuation_eq_of_isDiscreteValuationRing (R := P.localRing)
    (h1 _ h) (h2 _ h) h3 (fun r => (P.divisorialValuation_le_one_iff _).2 ⟨r, rfl⟩)
    (fun r hr => (P.divisorialValuation_algebraMap_lt_one_iff r).2 hr) h3'

/-- **Strict transforms keep valuations.** A divisor `(Y, f, E)` over `S` and a proper birational
morphism `g : W ⟶ Y` from a normal variety: the strict transform of `E` on `W` is a prime divisor
with the same valuation of `k(S)`. -/
theorem exists_primeDivisor_valuation_eq {k : Type u} [Field k] {S : Scheme.{u}}
    {sS : S ⟶ Spec (.of k)} [IsIntegral S] (D : DivisorOver k sS) {W : Scheme.{u}} (w : W ⟶ S)
    (hW : IsNormalVariety k (w ≫ sS)) (hwb : IsBirationalMorphism w) (g : W ⟶ D.Y)
    [IsProper g] (hgb : IsBirationalMorphism g) (hg : g ≫ D.f = w) :
    ∃ E : MMP.Mori.PrimeDivisor W, (⟨W, w, hW, hwb, E⟩ : DivisorOver k sS).valuation =
      D.valuation := by
  subst hg
  haveI := D.isNormal
  haveI := D.isLocallyNoetherian
  haveI := D.isIntegral
  haveI := hgb.isDominant
  haveI := D.isDominant
  haveI := hW.1.toIsIntegral
  haveI := hW.2
  haveI := hW.1.toLocallyOfFiniteType
  haveI := LocallyOfFiniteType.isLocallyNoetherian ((g ≫ D.f) ≫ sS)
  haveI := hwb.isDominant
  obtain ⟨E, hE, -, -⟩ := MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{u, 0}
    D.isNormalVariety (by rwa [← Category.assoc]) hgb D.E
  refine ⟨E, ?_⟩
  ext t
  change E.divisorialValuation (functionFieldMap (g ≫ D.f) t) =
    D.E.divisorialValuation (functionFieldMap D.f t)
  rw [← valuationOver_eq_of_map_genericPoint g hgb.functionFieldMap_bijective.2 E D.E hE,
    MMP.Mori.PrimeDivisor.valuationOver_apply,
    MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]

/-- **A common smooth projective resolution.** Finitely many proper birational models `X_i` of
a normal variety `S` over a field of characteristic zero are dominated by one smooth model
`w : W ⟶ S`, projective over `S` and over each `X_i`, on which finitely many given divisorial
valuations with a centre on `S` are realised by prime divisors. -/
theorem exists_smooth_projective_model {k : Type u} [Field k] [CharZero k] {S : Scheme.{u}}
    (sS : S ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sS] [IsNormal S]
    {ι : Type*} [Finite ι] {X : ι → Scheme.{u}} (f : ∀ i, X i ⟶ S)
    [∀ i, IsProper (f i)] (hfb : ∀ i, IsBirationalMorphism (f i))
    (hX : ∀ i, IsNormalVariety k (f i ≫ sS))
    {κ : Type*} [Finite κ] (v : κ → Valuation S.functionField ℤᵐ⁰)
    (hv : ∀ j, HasNonemptyCenter k sS (v j)) :
    ∃ (W : Scheme.{u}) (w : W ⟶ S) (hW : IsNormalVariety k (w ≫ sS))
      (hwb : IsBirationalMorphism w) (g : ∀ i, W ⟶ X i),
      IsSmoothScheme (w ≫ sS) ∧ IsProjectiveMorphism w ∧
      (∀ i, g i ≫ f i = w ∧ IsProjectiveMorphism (g i) ∧ IsBirationalMorphism (g i)) ∧
      (∀ j, ∃ E : MMP.Mori.PrimeDivisor W,
        (⟨W, w, hW, hwb, E⟩ : DivisorOver k sS).valuation = v j) ∧
      (AlgebraicGeometry.IsProjectiveVariety k sS →
        AlgebraicGeometry.IsProjectiveVariety k (w ≫ sS)) := by
  choose D hD using fun j => (hv j).2
  let Y : ι ⊕ κ → Scheme.{u} := fun s => Sum.rec X (fun j => (D j).Y) s
  let F : ∀ s, Y s ⟶ S := fun s => match s with
    | .inl i => f i
    | .inr j => (D j).f
  haveI hFp : ∀ s, IsProper (F s) := fun s => match s with
    | .inl i => inferInstanceAs (IsProper (f i))
    | .inr j => (D j).isProper
  have hFb : ∀ s, IsBirationalMorphism (F s) := fun s => match s with
    | .inl i => hfb i
    | .inr j => (D j).isBirationalMorphism
  have hY : ∀ s, IsNormalVariety k (F s ≫ sS) := fun s => match s with
    | .inl i => hX i
    | .inr j => (D j).isNormalVariety
  obtain ⟨M, m, h, hM, hmp, hmb, hmh⟩ :=
    @exists_common_model k _ S sS ⟨inferInstance, inferInstance⟩ (ι ⊕ κ) _ Y F hFp hFb hY
  haveI := hmp
  haveI : AlgebraicGeometry.IsVariety k (m ≫ sS) := hM.1
  haveI : IsIntegral M := hM.1.toIsIntegral
  obtain ⟨W, p, n, i, hi, hip, hWv, hWs, hpp, hpb⟩ := exists_isImmersion_isSmoothScheme (m ≫ sS)
  haveI := hpp
  haveI := hi
  have hW : IsNormalVariety k ((p ≫ m) ≫ sS) := by
    rw [Category.assoc]
    exact ⟨hWv, (MMP.Threefold.Resolution.isLocallyNoetherian_and_isNormal_of_isSmoothScheme hWs).2⟩
  have hwb : IsBirationalMorphism (p ≫ m) := isBirationalMorphism_comp hpb hmb
  have hwp : IsProjectiveMorphism (p ≫ m) :=
    isProjectiveMorphism_of_isImmersion i (p ≫ m) sS (by rw [hip, Category.assoc])
  have hgs : ∀ s, IsProper (p ≫ h s) := fun s =>
    MorphismProperty.comp_mem @IsProper p (h s) hpp (hmh s).2.1
  refine ⟨W, p ≫ m, hW, hwb, fun i => p ≫ h (.inl i), by rwa [Category.assoc], hwp,
    fun i' => ⟨?_, ?_, isBirationalMorphism_comp hpb (hmh (.inl i')).2.2⟩, fun j => ?_, ?_⟩
  · rw [Category.assoc]
    exact congrArg (p ≫ ·) (hmh (.inl i')).1
  · haveI := hgs (.inl i')
    haveI : IsSeparated (f i' ≫ sS) := (hX i').1.toIsSeparated
    exact isProjectiveMorphism_of_isImmersion i (p ≫ h (.inl i')) (f i' ≫ sS)
      (by rw [hip, ← (hmh (.inl i')).1]; simp only [Category.assoc]; rfl)
  · haveI := hgs (.inr j)
    rw [← hD j]
    exact exists_primeDivisor_valuation_eq (D j).toDivisorOver _ hW hwb _
      (isBirationalMorphism_comp hpb (hmh (.inr j)).2.2)
      (by rw [Category.assoc, (hmh (.inr j)).1])
  · intro hSp
    exact (AlgebraicGeometry.isProjectiveVariety_iff k _).2 ⟨hW.1, hwp.comp hSp.isProjective⟩

end CommonModel

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold TopologicalSpace

universe u

namespace StepChain

section Helpers

variable {X Y : Scheme.{u}}

/-- Over the biregular locus, a morphism reflects specialization. -/
theorem specializes_of_map_specializes {f : X ⟶ Y} {x y : X}
    (hx : f x ∈ biregularLocus f) (hy : f y ∈ biregularLocus f) (h : f x ⤳ f y) : x ⤳ y := by
  set V := biregularLocus f
  have : IsIso (f ∣_ V) := isBiregular_biregularLocus f
  let p : (f ⁻¹ᵁ V).toScheme := ⟨x, hx⟩
  let q : (f ⁻¹ᵁ V).toScheme := ⟨y, hy⟩
  have hp : ((f ∣_ V) ≫ V.ι) p = f x := by rw [morphismRestrict_ι]; rfl
  have hq : ((f ∣_ V) ≫ V.ι) q = f y := by rw [morphismRestrict_ι]; rfl
  have hpq : p ⤳ q := by
    rwa [← ((f ∣_ V) ≫ V.ι).isOpenEmbedding.isInducing.specializes_iff, hp, hq]
  exact hpq.map (f ⁻¹ᵁ V).ι.continuous

/-- The ideal sheaf of a prime divisor is the vanishing ideal of its support. -/
theorem idealSheaf_eq_vanishingIdeal_support (D : MMP.Mori.PrimeDivisor X) :
    D.idealSheaf = Scheme.IdealSheafData.vanishingIdeal D.idealSheaf.support := by
  have := D.integral
  exact Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ rfl

/-- A point lies on a prime divisor exactly when it is a specialization of its generic
point. -/
theorem mem_support_iff (D : MMP.Mori.PrimeDivisor X) (x : X) :
    x ∈ D.support ↔ D.genericPoint ⤳ x := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, specializes_iff_mem_closure]

/-- Over the biregular locus, the inverse transform of `Q` is the prime divisor through the
point over `η_Q`. -/
theorem inverseTransformPrimeDivisor_eq_some_of {f : X ⟶ Y}
    (P : MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor Y)
    (hPQ : f P.genericPoint = Q.genericPoint) (hV : Q.genericPoint ∈ biregularLocus f) :
    inverseTransformPrimeDivisor f Q = some P := by
  have hset : (inverseTransform f Q.idealSheaf.support : Set X) = P.support := by
    rw [inverseTransform, Closeds.coe_closure]
    refine le_antisymm (closure_minimal ?_ ?_) ?_
    · rintro y ⟨hyQ, hyV⟩
      have h1 : f P.genericPoint ⤳ f y := hPQ ▸ (mem_support_iff Q _).mp hyQ
      exact (mem_support_iff P y).mpr (specializes_of_map_specializes (hPQ ▸ hV) hyV h1)
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      refine closure_minimal (Set.singleton_subset_iff.mpr (subset_closure ?_)) isClosed_closure
      refine ⟨?_, ?_⟩
      · change f P.genericPoint ∈ Q.support
        rw [hPQ]; exact (mem_support_iff Q _).mpr specializes_rfl
      · change f P.genericPoint ∈ biregularLocus f
        rwa [hPQ]
  refine inverseTransformPrimeDivisor_eq_some_iff.mpr ⟨⟨Q.genericPoint,
    (mem_support_iff Q _).mpr specializes_rfl, hV⟩, ?_⟩
  rw [inverseTransformIdeal, idealSheaf_eq_vanishingIdeal_support P]
  congr 1
  ext1
  exact hset.symm

end Helpers

/-! ### The comparison divisor of a finite chain of steps is exceptional -/

/-- **One step of the chain.** In a step diagram `X⁻ → Z ← X⁺`, let `P` be a prime divisor of
`X⁺` and `x ∈ X⁻` a point with `f⁻(x) = f⁺(η_P)`. Then `x` is the generic point of a prime
divisor `P⁻` of `X⁻`, and the coefficient of `P` in a strict transform `(f⁺)⁻¹_* f⁻_* D` is the
coefficient of `P⁻` in `D`. -/
theorem exists_eq_genericPoint_flipTransform_apply
    {Xm Xp Z : Scheme.{0}} [IsIntegral Xm] [CompactSpace Xm] [IsLocallyNoetherian Xm]
    [IsNormal Xm] [IsIntegral Xp] [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}
    (hD : IsFourfoldStepDiagram sXm sZ sXp K B fm fp)
    (P : MMP.Mori.PrimeDivisor Xp) (x : Xm) (hx : fm x = fp P.genericPoint) :
    ∃ Pm : MMP.Mori.PrimeDivisor Xm, x = Pm.genericPoint ∧
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R Xm),
        flipTransform fm fp D P = D Pm := by
  haveI : IsProper fm := isProper_of_isProjectiveMorphism _ hD.isProjectiveMorphism_minus
  exact MMP.Fourfold.exists_eq_genericPoint_flipTransform_apply hD.isBirationalMorphism_minus
    hD.isSmallMorphism_plus P x hx

section Chain

variable {m : ℕ} {V : ℕ → Scheme.{0}} {sV : ∀ k, V k ⟶ Spec (.of ℂ)} [∀ k, IsIntegral (V k)]
  [∀ k, CompactSpace (V k)] [∀ k, IsLocallyNoetherian (V k)] [∀ k, IsNormal (V k)]
  {K : ∀ k, Divisor (V k)} {Θ : ∀ k, QDivisor (V k)} {T : ℕ → Scheme.{0}}
  {sT : ∀ k, T k ⟶ Spec (.of ℂ)} {g : ∀ k, V k ⟶ T k} {gp : ∀ k, V (k + 1) ⟶ T k}
  {W : Scheme.{0}} {q : ∀ k, k ≤ m → (W ⟶ V k)}

/-- **Descending the chain.** For a point `w` of `W` lying over the generic point of a prime
divisor `P` of `V_k`, `k ≤ m`, the point `q_0(w)` is the generic point of a prime divisor `P₀` of
`V_0`, and every family of strict transforms along the chain has the same coefficient at `P`
as at `P₀`. -/
theorem exists_primeDivisor_zero_forall_coeff_eq
    (hstep : ∀ k < m, IsFourfoldStepDiagram (sV k) (sT k) (sV (k + 1)) (K k) (Θ k) (g k) (gp k))
    (hcomp : ∀ k (hk : k < m), q k (Nat.le_of_lt hk) ≫ g k = q (k + 1) hk ≫ gp k) (w : W) :
    ∀ k (hk : k ≤ m), ∀ P : MMP.Mori.PrimeDivisor (V k), q k hk w = P.genericPoint →
      ∃ P₀ : MMP.Mori.PrimeDivisor (V 0), q 0 m.zero_le w = P₀.genericPoint ∧
        ∀ {R : Type} [AddCommMonoid R] (B : ∀ k, DivisorWithCoeffs R (V k)),
          (∀ k < m, B (k + 1) = flipTransform (g k) (gp k) (B k)) → B k P = B 0 P₀ := by
  intro k
  induction k with
  | zero => exact fun _ P hP => ⟨P, hP, fun _ _ => rfl⟩
  | succ k ih =>
    intro hk P hP
    obtain ⟨Pk, hPk, hfl⟩ := exists_eq_genericPoint_flipTransform_apply (hstep k hk) P
      (q k (Nat.le_of_lt hk) w)
      (by rw [← hP, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomp k hk])
    obtain ⟨P₀, hP₀, hB⟩ := ih (Nat.le_of_lt hk) Pk hPk
    exact ⟨P₀, hP₀, fun B hBfl => by rw [hBfl k hk, hfl, hB B hBfl]⟩

end Chain

/-- **The comparison divisor of a finite chain of step diagrams is exceptional**, for morphisms
`q_k : W ⟶ V_k` given only for `k ≤ m`. -/
theorem transformDivisor_pullback_sub_pullback_eq_zero (m : ℕ)
    {V : ℕ → Scheme.{0}} (sV : ∀ k, V k ⟶ Spec (.of ℂ)) [∀ k, IsIntegral (V k)]
    [∀ k, CompactSpace (V k)] [∀ k, IsLocallyNoetherian (V k)] [∀ k, IsNormal (V k)]
    (K : ∀ k, Divisor (V k)) (Θ : ∀ k, QDivisor (V k))
    {T : ℕ → Scheme.{0}} (sT : ∀ k, T k ⟶ Spec (.of ℂ))
    (g : ∀ k, V k ⟶ T k) (gp : ∀ k, V (k + 1) ⟶ T k)
    (hstep : ∀ k < m, IsFourfoldStepDiagram (sV k) (sT k) (sV (k + 1)) (K k) (Θ k) (g k) (gp k))
    (hK : ∀ k < m, K (k + 1) = flipTransform (g k) (gp k) (K k))
    (hΘ : ∀ k < m, Θ (k + 1) = flipTransform (g k) (gp k) (Θ k))
    {W : Scheme.{0}} [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
    (q : ∀ k, k ≤ m → (W ⟶ V k)) (hq : ∀ k (hk : k ≤ m), IsBirationalMorphism (q k hk))
    (hcomp : ∀ k (hk : k < m), q k (Nat.le_of_lt hk) ≫ g k = q (k + 1) hk ≫ gp k)
    (hD₀ : (Divisor.toQDivisor (K 0) + Θ 0).IsQCartier)
    (hDₘ : (Divisor.toQDivisor (K m) + Θ m).IsQCartier)
    (h₀ : ∀ Z : irreducibleComponents W,
      q 0 m.zero_le (componentGenericPoint W Z) ∉ (Divisor.toQDivisor (K 0) + Θ 0).supp)
    (hₘ : ∀ Z : irreducibleComponents W,
      q m le_rfl (componentGenericPoint W Z) ∉ (Divisor.toQDivisor (K m) + Θ m).supp) :
    RationalMap.transformDivisor (X := W) (q m le_rfl).toRationalMap
      ((Divisor.toQDivisor (K 0) + Θ 0).pullback hD₀ h₀ -
        (Divisor.toQDivisor (K m) + Θ m).pullback hDₘ hₘ) = 0 := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [sub_self, map_zero]
  have hVm := (hstep (m - 1) (by omega)).isNormalVariety_plus
  rw [Nat.sub_add_cancel hm] at hVm
  have := isSeparated_toTerminal_of_isNormalVariety hVm
  rw [RationalMap.transformDivisor]
  refine mapPrimeDivisors_eq_zero_of_forall _ fun E P hEP => ?_
  have hEm :=
    (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff (q m le_rfl) E P).mp hEP
  obtain ⟨P₀, hP₀, hB⟩ :=
    exists_primeDivisor_zero_forall_coeff_eq hstep hcomp E.genericPoint m le_rfl P hEm
  haveI := isIso_stalkMap_of_map_eq_genericPoint (hq 0 m.zero_le) hP₀
  haveI := isIso_stalkMap_of_map_eq_genericPoint (hq m le_rfl) hEm
  rw [Finsupp.sub_apply,
    coeff_eq_of_isPullback_qDivisor E P₀ hP₀ hD₀ (QDivisor.isPullback_pullback hD₀ h₀),
    coeff_eq_of_isPullback_qDivisor E P hEm hDₘ (QDivisor.isPullback_pullback hDₘ hₘ)]
  change ((K 0 P₀ : ℤ) : ℚ) + Θ 0 P₀ - (((K m P : ℤ) : ℚ) + Θ m P) = 0
  rw [hB K hK, hB Θ hΘ, sub_self]

end StepChain

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold

namespace ProgramComparison

/-- A morphism `u` with `u ≫ s` proper and `s` separated is proper. -/
theorem isProper_of_comp_eq {W V : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)} [IsProper sW]
    {sV : V ⟶ Spec (.of ℂ)} [IsSeparated sV] (u : W ⟶ V) (hu : u ≫ sV = sW) : IsProper u := by
  subst hu; exact IsProper.of_comp u sV

/-- **The comparison divisor of one step is anti-nef.** Let `(X⁻, Θ⁻) → T ← (X⁺, Θ⁺)` be a step
diagram with `K⁺ + Θ⁺` the strict transform of `K⁻ + Θ⁻`, and let `q : W ⟶ X⁻`, `p : W ⟶ X⁺` be
proper with `q ≫ g = p ≫ g⁺`. Then `-(q^*(K⁻ + Θ⁻) - p^*(K⁺ + Θ⁺))` is `p`-nef: a curve contracted
by `p` is contracted by `q ≫ g = p ≫ g⁺`, and on it both `p^*(K⁺ + Θ⁺)` and `q^*(-(K⁻ + Θ⁻))` are
pull-backs of relatively ample divisors. -/
theorem isRelativelyNef_neg_pullback_sub_pullback
    {Xm Xp T W : Scheme.{0}} [IsIntegral Xm] [CompactSpace Xm] [IsLocallyNoetherian Xm]
    [IsNormal Xm] [IsIntegral Xp] [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]
    [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
    {sXm : Xm ⟶ Spec (.of ℂ)} {sT : T ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {Θ : QDivisor Xm} {g : Xm ⟶ T} {gp : Xp ⟶ T}
    (hS : IsFourfoldStepDiagram sXm sT sXp K Θ g gp) {Kp : Divisor Xp} {Θp : QDivisor Xp}
    (hK : Kp = flipTransform g gp K) (hΘ : Θp = flipTransform g gp Θ)
    (sW : W ⟶ Spec (.of ℂ)) [QuasiCompact sW] {q : W ⟶ Xm} {p : W ⟶ Xp} [IsProper q] [IsProper p]
    [IsDominant q] (hqs : q ≫ sXm = sW) (hps : p ≫ sXp = sW) (hcomp : q ≫ g = p ≫ gp)
    {h₁ : ∀ Z : irreducibleComponents W,
      q (componentGenericPoint W Z) ∉ (Divisor.toQDivisor K + Θ).supp}
    {h₂ : ∀ Z : irreducibleComponents W,
      p (componentGenericPoint W Z) ∉ (Divisor.toQDivisor Kp + Θp).supp}
    {P₁ P₂ : QDivisor W} (hp₁ : (Divisor.toQDivisor K + Θ).IsPullback q h₁ P₁)
    (hp₂ : (Divisor.toQDivisor Kp + Θp).IsPullback p h₂ P₂) (hP₁ : P₁.IsQCartier)
    (hP₂ : P₂.IsQCartier) :
    (-(P₁ - P₂)).IsRelativelyNef sW p := by
  subst hK hΘ
  haveI := hS.isNormalVariety_minus.1
  haveI := hS.isNormalVariety_plus.1
  rw [show -(P₁ - P₂) = P₂ + -P₁ by abel]
  refine QDivisor.isRelativelyNef_of_intersectionNumber_nonneg sW
    (hP₂.add (isQCartier_neg hP₁)) fun C hC => ?_
  rw [QDivisor.intersectionNumber_add' ℂ sW C.ι C.dim_le _ _ hP₂ (isQCartier_neg hP₁)]
  refine add_nonneg (intersectionNumber_nonneg_of_isPullback p hps
    hS.hasRelativelyAmpleMultiple_plus hp₂ hP₂ C fun x hx => by
      simp only [Scheme.Hom.comp_apply, hC x hx]) ?_
  refine intersectionNumber_nonneg_of_isPullback q hqs hS.hasRelativelyAmpleMultiple_minus
    (isPullback_neg hp₁
      (MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' _ _))
    (isQCartier_neg hP₁) C fun x hx => ?_
  rw [hcomp]
  simp only [Scheme.Hom.comp_apply, hC x hx]

/-- **One step of the chain.** For the `k`-th step diagram `(V_k, Θ_k) → T_k ← (V_{k+1}, Θ_{k+1})`
and birational morphisms `q₁ : W ⟶ V_k`, `q₂ : W ⟶ V_{k+1}`, the divisor
`E = q₁^*(K_k + Θ_k) - q₂^*(K_{k+1} + Θ_{k+1})` is effective, by the negativity lemma for `q₂`:
`-E` is `q₂`-nef and `q₂_* E = 0`. -/
theorem pullback_sub_pullback_succ_nonneg
    {V : ℕ → Scheme.{0}} (sV : ∀ k, V k ⟶ Spec (.of ℂ)) [∀ k, IsIntegral (V k)]
    [∀ k, CompactSpace (V k)] [∀ k, IsLocallyNoetherian (V k)] [∀ k, IsNormal (V k)]
    (K : ∀ k, Divisor (V k)) (Θ : ∀ k, QDivisor (V k))
    {T : ℕ → Scheme.{0}} (sT : ∀ k, T k ⟶ Spec (.of ℂ))
    (g : ∀ k, V k ⟶ T k) (gp : ∀ k, V (k + 1) ⟶ T k) (k : ℕ)
    (hS : IsFourfoldStepDiagram (sV k) (sT k) (sV (k + 1)) (K k) (Θ k) (g k) (gp k))
    (hK : K (k + 1) = flipTransform (g k) (gp k) (K k))
    (hΘ : Θ (k + 1) = flipTransform (g k) (gp k) (Θ k))
    {W : Scheme.{0}} [IsIntegral W] [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W]
    (sW : W ⟶ Spec (.of ℂ)) (hW : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hWn : IsNormalVariety ℂ sW) (q₁ : W ⟶ V k) (q₂ : W ⟶ V (k + 1)) (hqs₁ : q₁ ≫ sV k = sW)
    (hqs₂ : q₂ ≫ sV (k + 1) = sW) (hq₁ : IsBirationalMorphism q₁)
    (hq₂ : IsBirationalMorphism q₂) (hcomp : q₁ ≫ g k = q₂ ≫ gp k)
    (hD₁ : (Divisor.toQDivisor (K k) + Θ k).IsQCartier)
    (hD₂ : (Divisor.toQDivisor (K (k + 1)) + Θ (k + 1)).IsQCartier)
    (h₁ : ∀ Z : irreducibleComponents W,
      q₁ (componentGenericPoint W Z) ∉ (Divisor.toQDivisor (K k) + Θ k).supp)
    (h₂ : ∀ Z : irreducibleComponents W,
      q₂ (componentGenericPoint W Z) ∉ (Divisor.toQDivisor (K (k + 1)) + Θ (k + 1)).supp) :
    0 ≤ (Divisor.toQDivisor (K k) + Θ k).pullback hD₁ h₁ -
      (Divisor.toQDivisor (K (k + 1)) + Θ (k + 1)).pullback hD₂ h₂ := by
  haveI := hS.isNormalVariety_minus.1
  haveI := hS.isNormalVariety_plus.1
  haveI := isProper_of_comp_eq q₁ hqs₁
  haveI := isProper_of_comp_eq q₂ hqs₂
  haveI := hq₁.isDominant
  have hp₁ := QDivisor.isPullback_pullback hD₁ h₁
  have hp₂ := QDivisor.isPullback_pullback hD₂ h₂
  have hP₁ := hp₁.isQCartier hD₁
  have hP₂ := hp₂.isQCartier hD₂
  let q' : ∀ j, j ≤ 1 → (W ⟶ V (k + j)) := fun j =>
    match j with
    | 0 => fun _ => q₁
    | 1 => fun _ => q₂
    | _ + 2 => fun h => absurd h (by omega)
  have h0 := StepChain.transformDivisor_pullback_sub_pullback_eq_zero 1
    (V := fun j => V (k + j))
    (fun j => sV (k + j)) (fun j => K (k + j)) (fun j => Θ (k + j)) (T := fun j => T (k + j))
    (fun j => sT (k + j)) (fun j => g (k + j)) (fun j => gp (k + j))
    (fun j hj => by obtain rfl := Nat.lt_one_iff.mp hj; exact hS)
    (fun j hj => by obtain rfl := Nat.lt_one_iff.mp hj; exact hK)
    (fun j hj => by obtain rfl := Nat.lt_one_iff.mp hj; exact hΘ)
    q' (fun j hj => by
      obtain rfl | rfl := Nat.le_one_iff_eq_zero_or_eq_one.mp hj
      exacts [hq₁, hq₂])
    (fun j hj => by obtain rfl := Nat.lt_one_iff.mp hj; exact hcomp) hD₁ hD₂ h₁ h₂
  exact Negativity.nonneg_of_transformDivisor_nonneg ℂ (sV (k + 1)) sW hS.isNormalVariety_plus hWn
    q₂ hqs₂ hq₂
    (isRelativelyNef_neg_pullback_sub_pullback hS hK hΘ sW hqs₁ hqs₂ hcomp hp₁ hp₂ hP₁ hP₂) h0.ge

end ProgramComparison

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold

namespace BridgeComparison

open MMP.Fourfold.StabilizedSmallKltTail

/-! ### The log discrepancy read on a model -/

/-- **The log discrepancy on a model with compatible canonical divisors.** Let `(X, B)` be a
normal variety with canonical divisor `K` and `K + B` `ℚ`-Cartier, `r : W ⟶ X` a proper
birational morphism from a normal variety with canonical divisor `K_W`, `r_* K_W = K`, and
`R = r^*(K + B)`. If a divisor over `X` with log discrepancy `a` has the valuation of a prime
divisor `P` of `W`, then `coeff_P R = coeff_P K_W + 1 - a`, that is,
`a = 1 + coeff_P (K_W - r^*(K + B))`. -/
theorem coeff_isPullback_eq_of_isLogDiscrepancy {X W : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX]
    (hX : IsNormalVariety ℂ sX) {d : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX d)
    {B : QDivisor X} (hKB : (Divisor.toQDivisor K + B).IsQCartier) {r : W ⟶ X} [IsProper r]
    (hr : IsBirationalMorphism r) (hW : IsNormalVariety ℂ (r ≫ sX))
    [LocallyOfFiniteType (r ≫ sX)] {KW : Divisor W} (hKW : KW.IsCanonicalDivisor (r ≫ sX) d)
    (hKX : RationalMap.transformDivisor (X := W) r.toRationalMap KW = K)
    {hR₀ : ∀ Z : irreducibleComponents W,
      r (componentGenericPoint W Z) ∉ (Divisor.toQDivisor K + B).supp}
    {R : QDivisor W} (hR : (Divisor.toQDivisor K + B).IsPullback r hR₀ R)
    (P : MMP.Mori.PrimeDivisor W) {n : ℕ} {D : DivisorOver ℂ sX} {a : ℝ}
    (hD : MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) D a)
    (hv : D.valuation = (⟨W, r, hW, hr, P⟩ : DivisorOver ℂ sX).valuation) :
    (R P : ℝ) = (KW P : ℝ) + 1 - a := by
  haveI := hr.isDominant
  obtain ⟨ω, hω0, hωK, hωW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hX hW hr hK hKW hKX
  obtain ⟨m, hm, L, hL, hLc⟩ := hKB.exists_pos
  obtain ⟨L', hL'q, hLp⟩ := hR m hm L hL hLc
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hlog : MMP.Intersection.IsLogDiscrepancy sX d (QDivisor.toRDivisor B)
      (⟨W, r, hW, hr, P⟩ : DivisorOver ℂ sX) (1 + KW P - R P) := by
    refine ⟨hX, inferInstance, ω, hω0, ⟨K, hK, fun Γ => by rw [← hωK]; rfl⟩, 1,
      fun _ => ((m : ℝ)⁻¹), fun _ => L, fun _ => L', fun _ => hLc, fun Γ => ?_,
      fun _ => ⟨_, hLp⟩, ?_⟩
    · have h1 := congrArg (fun G : QDivisor X => G Γ) hL
      have h2 : Γ.ordForm ω = K Γ := by rw [← hωK]; rfl
      simp only [Finsupp.smul_apply, zsmul_eq_mul, Int.cast_natCast, Finsupp.add_apply] at h1
      change ((L Γ : ℤ) : ℚ) = m * (((K Γ : ℤ) : ℚ) + B Γ) at h1
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
        QDivisor.coeff_toRDivisor, h2]
      change (((K Γ : ℤ) : ℝ)) + ((B Γ : ℚ) : ℝ) = (m : ℝ)⁻¹ * ((L Γ : ℤ) : ℝ)
      have h3 : ((L Γ : ℤ) : ℝ) = (m : ℝ) * (((K Γ : ℤ) : ℝ) + ((B Γ : ℚ) : ℝ)) := by
        exact_mod_cast h1
      rw [h3]
      field_simp
    · have h1 := congrArg (fun G : QDivisor W => G P) hL'q
      simp only [Finsupp.smul_apply, zsmul_eq_mul, Int.cast_natCast] at h1
      change ((L' P : ℤ) : ℚ) = m * R P at h1
      have h2 : DivisorOver.ordPullback (⟨W, r, hW, hr, P⟩ : DivisorOver ℂ sX) ω = KW P := by
        rw [← hωW]; rfl
      simp only [Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton, h2]
      change 1 + ((KW P : ℤ) : ℝ) - ((R P : ℚ) : ℝ) =
        1 + ((KW P : ℤ) : ℝ) - (m : ℝ)⁻¹ * ((L' P : ℤ) : ℝ)
      have h3 : ((L' P : ℤ) : ℝ) = (m : ℝ) * ((R P : ℚ) : ℝ) := by exact_mod_cast h1
      rw [h3]
      field_simp
  have := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hD hlog hv
  linarith

/-- **`r^* D_V - q^* D_Y` is relatively nef.** Let `q : W ⟶ Y`, `r : W ⟶ V` be proper morphisms with
`q ≫ h = r ≫ g`, `D_Y` a `ℚ`-Cartier `ℚ`-divisor on `Y` and `D_V` a `ℚ`-divisor on `V` with a
`g`-ample multiple. Then `r^* D_V - q^* D_Y` is `q`-nef: on a curve contracted by `q`, `q^* D_Y`
has degree zero, and `r^* D_V` has nonnegative degree, the curve being contracted by `r ≫ g`. -/
theorem isRelativelyNef_neg_sub_of_isPullback {W V Y T : Scheme.{0}} [IsIntegral W]
    [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace V] [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] {sW : W ⟶ Spec (.of ℂ)}
    [QuasiCompact sW] {sV : V ⟶ Spec (.of ℂ)} [IsSeparated sV] [LocallyOfFiniteType sV]
    {sY : Y ⟶ Spec (.of ℂ)} [IsSeparated sY] [LocallyOfFiniteType sY] [QuasiCompact sY]
    {q : W ⟶ Y} [IsDominant q] (hq : q ≫ sY = sW) {r : W ⟶ V} [IsProper r] (hr : r ≫ sV = sW)
    {h : Y ⟶ T} {g : V ⟶ T} (hcomp : q ≫ h = r ≫ g) {DY : QDivisor Y} (hDY : DY.IsQCartier)
    {DV : QDivisor V} (hDV : DV.IsQCartier) (hamp : DV.HasRelativelyAmpleMultiple g)
    {hA₀ : ∀ Z : irreducibleComponents W, q (componentGenericPoint W Z) ∉ DY.supp}
    {hR₀ : ∀ Z : irreducibleComponents W, r (componentGenericPoint W Z) ∉ DV.supp}
    {A R : QDivisor W} (hA : DY.IsPullback q hA₀ A) (hR : DV.IsPullback r hR₀ R) :
    (-(A - R)).IsRelativelyNef sW q := by
  have hRq := hR.isQCartier hDV
  have hnAq := isQCartier_neg (hA.isQCartier hDY)
  rw [show -(A - R) = R + -A by abel]
  refine QDivisor.isRelativelyNef_of_intersectionNumber_nonneg sW (hRq.add hnAq) fun C hC => ?_
  rw [QDivisor.intersectionNumber_add' ℂ sW C.ι C.dim_le _ _ hRq hnAq]
  refine add_nonneg (intersectionNumber_nonneg_of_isPullback r hr hamp hR hRq C fun x hx => ?_)
    (intersectionNumber_isPullback_eq_zero q hq (isQCartier_neg hDY) (isPullback_neg hA
      (MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' _ _)) C hC).ge
  rw [← hcomp]
  simp only [Scheme.Hom.comp_apply, hC x hx]

section DecreasedBoundary

variable {T : StabilizedSmallKltTail} {i : ℕ}
  {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
  {J : FourfoldCrepantJunction (T.sX i) (T.B i) I} {a : I → ℚ} {Θ' : QDivisor J.Y}

/-- The canonical divisor of the tail at `X_j` is a canonical divisor of dimension four. -/
theorem isCanonicalDivisor_K (j : ℕ) : (T.K j).IsCanonicalDivisor (T.sX j) 4 := by
  obtain ⟨m, hm⟩ := (T.isFourfoldStepDiagram j).isCanonicalDivisor
  have h4 := hm.topologicalKrullDim_eq
  rw [(T.isFourfoldStepDiagram j).dim_minus] at h4
  obtain rfl : m = 4 := by exact_mod_cast h4.symm
  exact hm

/-- The decreased boundary `Θ_i' = (p_i)⁻¹_* B_i + ∑ (1 - a(s)) E_{i,s}` has coefficient
`1 - a(s)` at the marked divisor `E_{i,s}`: it is `p_i`-exceptional, so no prime divisor of
`X_i` has it as strict transform. -/
theorem decreasedBoundary_apply_E
    (hΘ' : Θ' = inverseTransformDivisor J.p (T.B i) + ∑ s : I, Finsupp.single (J.E s) (1 - a s))
    (s : I) : Θ' (J.E s) = 1 - a s := by
  have hXi := (T.isFourfoldStepDiagram i).isNormalVariety_minus
  haveI := isSeparated_toTerminal_of_isNormalVariety hXi
  have hinv : inverseTransformDivisor J.p (T.B i) (J.E s) = 0 := by
    refine mapPrimeDivisors_apply_eq_zero (fun D hD => ?_) _
    have hη :=
      (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hD).1
    have hex := MMP.Positivity.isExceptional_toRationalMap_iff (f := J.p) (J.E s) |>.mp
      ((J.isExceptional_iff _).mpr ⟨s, rfl⟩)
    have h2 := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp hex _ <|
      subset_closure ⟨(J.E s).genericPoint, by
        change (J.E s).genericPoint ∈ (J.E s).support
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl, hη⟩
    rw [D.coheight_genericPoint] at h2
    exact absurd h2 (by decide)
  rw [hΘ', Finsupp.add_apply, hinv, zero_add, Finsupp.finset_sum_apply,
    Finset.sum_eq_single s
      (fun t _ hts => Finsupp.single_eq_of_ne fun h => hts (J.injective h.symm))
      (fun h => absurd (Finset.mem_univ s) h)]
  exact Finsupp.single_eq_same

end DecreasedBoundary

/-- A point over the generic point of a prime divisor of a normal scheme, under a birational
morphism, is the generic point of a prime divisor, and the morphism is a local isomorphism
there. -/
theorem exists_primeDivisor_of_map_eq_genericPoint {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {f : X ⟶ Y}
    (hf : IsBirationalMorphism f) {x : X} {D : MMP.Mori.PrimeDivisor Y}
    (hx : f x = D.genericPoint) :
    ∃ E : MMP.Mori.PrimeDivisor X, E.genericPoint = x ∧ IsIso (f.stalkMap x) := by
  haveI hiso := isIso_stalkMap_of_map_eq_genericPoint hf hx
  have hco : Order.coheight x = 1 := by
    have h := ringKrullDim_eq_of_ringEquiv (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight, hx,
      D.coheight_genericPoint] at h
    exact_mod_cast h.symm
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne x hco,
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne x hco, hiso⟩

end BridgeComparison

end

section

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold MMP.Positivity
  RingedSpaceModuleAdjunction

namespace Main

/-! ### Birational morphisms -/

/-- If `g` and `g ≫ h` are birational morphisms of integral schemes and `h` is locally of finite
type, then `h` is birational: `h^*` is onto `k(Y)` since `g^* ∘ h^* = (g ≫ h)^*` is onto and
`g^*` is injective. -/
theorem isBirationalMorphism_of_comp_left {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsIntegral Z] (g : X ⟶ Y) (h : Y ⟶ Z) [LocallyOfFiniteType h]
    (hg : IsBirationalMorphism g) (hgh : IsBirationalMorphism (g ≫ h)) :
    IsBirationalMorphism h := by
  haveI := hg.isDominant
  haveI := hgh.isDominant
  haveI : IsDominant h := IsDominant.of_comp g h
  refine CommonModel.isBirationalMorphism_of_isBirational
    h (AlgebraicGeometry.isBirational_of_surjective_functionFieldMap h fun t => ?_)
  obtain ⟨z, hz⟩ := hgh.functionFieldMap_bijective.2 (functionFieldMap g t)
  refine ⟨z, hg.functionFieldMap_bijective.1 ?_⟩
  rw [functionFieldMap_comp_apply g h rfl, hz]

/-- Two morphisms `a₁, a₂ : W ⟶ T` of integral schemes agreeing after a proper birational
morphism `h : T ⟶ Z` onto a normal scheme are equal, when `a₁ ≫ h` is dominant: `h` is an
isomorphism over the open locus of finite fibres, which contains the generic point of `Z`. -/
theorem eq_of_comp_eq {W T Z : Scheme.{0}} [IsIntegral W] [IsIntegral T] [IsIntegral Z]
    [IsNormal Z] [IsLocallyNoetherian Z] {h : T ⟶ Z} [IsProper h] (hh : IsBirationalMorphism h)
    {a₁ a₂ : W ⟶ T} [IsDominant (a₁ ≫ h)] (e : a₁ ≫ h = a₂ ≫ h) : a₁ = a₂ := by
  have hbir := MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hh
  obtain ⟨hU, hiso⟩ :=
    (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso h hbir).1 inferInstance
  set V : Z.Opens := ⟨_, hU⟩
  have hgen : genericPoint Z ∈ V := by
    have := MMP.Mori.map_genericPoint_mem_finiteFibreLocus h hbir
    rwa [MMP.Mori.map_genericPoint_eq h hbir] at this
  have hW : genericPoint W ∈ (a₁ ≫ h) ⁻¹ᵁ V := by
    change (a₁ ≫ h) (genericPoint W) ∈ V
    rw [map_genericPoint_of_isDominant]
    exact hgen
  haveI : IsDominant ((a₁ ≫ h) ⁻¹ᵁ V).ι :=
    ⟨by rw [DenseRange, Scheme.Opens.range_ι]; exact ((a₁ ≫ h) ⁻¹ᵁ V).isOpen.dense ⟨_, hW⟩⟩
  have hle₁ : (a₁ ≫ h) ⁻¹ᵁ V ≤ a₁ ⁻¹ᵁ (h ⁻¹ᵁ V) := fun x hx => hx
  have hle₂ : (a₁ ≫ h) ⁻¹ᵁ V ≤ a₂ ⁻¹ᵁ (h ⁻¹ᵁ V) := fun x hx => by
    change (a₂ ≫ h) x ∈ V
    rw [← e]
    exact hx
  refine ext_of_isDominant_of_isSeparated h e ((a₁ ≫ h) ⁻¹ᵁ V).ι ?_
  rw [← Scheme.Hom.resLE_comp_ι a₁ hle₁, ← Scheme.Hom.resLE_comp_ι a₂ hle₂]
  congr 1
  rw [← cancel_mono (h ∣_ V ≫ V.ι)]
  simp only [morphismRestrict_ι, Scheme.Hom.resLE_comp_ι_assoc, e]

/-- Composing a rational map with two morphisms in turn is composing with their composite. -/
theorem compHom_compHom {X Y Z S : Scheme.{0}} (φ : X.RationalMap Y) (g : Y ⟶ Z)
    (h : Z ⟶ S) : (φ.compHom g).compHom h = φ.compHom (g ≫ h) := by
  obtain ⟨φ, rfl⟩ := Quotient.exists_rep φ
  change (φ.toRationalMap.compHom g).compHom h = φ.toRationalMap.compHom (g ≫ h)
  rw [← Scheme.RationalMap.compHom_toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    ← Scheme.RationalMap.compHom_toRationalMap]
  congr 1

section Program

variable {V Z : Scheme.{0}} [IsIntegral V] [CompactSpace V] [IsLocallyNoetherian V] [IsNormal V]
  {sV : V ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {π : V ⟶ Z} {K : Divisor V} {Θ : QDivisor V}
  (P : RelativeFourfoldProgram sV sZ π K Θ)

/-- Every model `V_k`, `k ≤ m`, of a program from a normal variety is a normal projective
variety. -/
theorem isNormalVariety_modelStructure (hV : IsNormalVariety ℂ sV) {k : ℕ}
    (hk : k ≤ P.m) : IsNormalVariety ℂ (P.modelStructure k) ∧
      MMP.Mori.IsProjectiveVariety ℂ (P.modelStructure k) := by
  cases k with
  | zero => exact ⟨hV, P.isProjectiveVariety⟩
  | succ k => exact ⟨(P.isFourfoldStepDiagram k hk).isNormalVariety_plus,
      (P.isFourfoldStepDiagram k hk).isProjectiveVariety_plus⟩

/-- Every map `π_k : V_k ⟶ Z`, `k ≤ m`, lies over `ℂ`. -/
theorem toBase_comp {k : ℕ} (hk : k ≤ P.m) : P.toBase k ≫ sZ = P.modelStructure k := by
  cases k with
  | zero => exact P.comp_eq
  | succ k =>
    change P.πY k ≫ sZ = P.sY k
    rw [P.πY_eq k hk, Category.assoc, P.comp_eq_base k hk]
    exact (P.isFourfoldStepDiagram k hk).comp_eq_plus

/-- Every map `π_k : V_k ⟶ Z`, `k ≤ m`, is proper. -/
theorem isProper_toBase [IsSeparated sZ] (hV : IsNormalVariety ℂ sV) {k : ℕ}
    (hk : k ≤ P.m) : IsProper (P.toBase k) := by
  haveI : IsProper (P.modelStructure k) := isProper_of_isProjectiveMorphism _
    (isNormalVariety_modelStructure P hV hk).2.isProjective
  haveI : IsProper (P.toBase k ≫ sZ) := by rw [toBase_comp P hk]; infer_instance
  exact IsProper.of_comp _ sZ

/-- If `π_k = g_k ≫ h_k` is birational, so is `h_k : T_k ⟶ Z`. -/
theorem isBirationalMorphism_h [IsIntegral Z] {k : ℕ} (hk : k < P.m)
    (hb : IsBirationalMorphism (P.toBase k)) : IsBirationalMorphism (P.h k) := by
  have hS := P.isFourfoldStepDiagram k hk
  haveI : IsIntegral (P.T k) := hS.isNormalVariety_target.1.toIsIntegral
  haveI : IsProper (P.h k) :=
    isProper_of_isProjectiveMorphism _ (P.isProjectiveMorphism_base k hk)
  refine isBirationalMorphism_of_comp_left (P.g k) (P.h k) hS.isBirationalMorphism_minus ?_
  rw [← P.modelMap_eq k hk]
  exact hb

/-- If `π` is birational, so is every `π_k : V_k ⟶ Z`, `k ≤ m`. -/
theorem isBirationalMorphism_toBase [IsIntegral Z] (hπ : IsBirationalMorphism π) :
    ∀ {k : ℕ}, k ≤ P.m → IsBirationalMorphism (P.toBase k)
  | 0, _ => hπ
  | k + 1, hk => by
    change IsBirationalMorphism (P.πY k)
    rw [P.πY_eq k hk]
    exact CommonModel.isBirationalMorphism_comp
      (P.isFourfoldStepDiagram k hk).isBirationalMorphism_plus
      (isBirationalMorphism_h P hk (isBirationalMorphism_toBase hπ (Nat.le_of_lt hk)))

/-- Morphisms `q_k : W ⟶ V_k` over a common dominant `w : W ⟶ Z` are compatible with the steps:
`q_k ≫ g_k = q_{k+1} ≫ g_k⁺`, both being lifts of `w` along the birational `h_k`. -/
theorem comp_g_eq_comp_gp [IsIntegral Z] [IsNormal Z] [IsLocallyNoetherian Z]
    (hπ : IsBirationalMorphism π) {W : Scheme.{0}} [IsIntegral W] {w : W ⟶ Z} [IsDominant w]
    (q : ∀ k, k ≤ P.m → (W ⟶ P.model k)) (hq : ∀ k (hk : k ≤ P.m), q k hk ≫ P.toBase k = w)
    (k : ℕ) (hk : k < P.m) : q k (Nat.le_of_lt hk) ≫ P.g k = q (k + 1) hk ≫ P.gp k := by
  haveI : IsIntegral (P.T k) :=
    (P.isFourfoldStepDiagram k hk).isNormalVariety_target.1.toIsIntegral
  haveI : IsProper (P.h k) :=
    isProper_of_isProjectiveMorphism _ (P.isProjectiveMorphism_base k hk)
  have e1 : (q k (Nat.le_of_lt hk) ≫ P.g k) ≫ P.h k = w := by
    rw [Category.assoc, ← P.modelMap_eq k hk]; exact hq k _
  have e2 : (q (k + 1) hk ≫ P.gp k) ≫ P.h k = w := (Category.assoc _ _ _).trans
    ((congrArg (q (k + 1) hk ≫ ·) (P.πY_eq k hk).symm).trans (hq (k + 1) hk))
  haveI : IsDominant ((q k (Nat.le_of_lt hk) ≫ P.g k) ≫ P.h k) := by rw [e1]; infer_instance
  exact eq_of_comp_eq (isBirationalMorphism_h P hk
    (isBirationalMorphism_toBase P hπ (Nat.le_of_lt hk))) (e1.trans e2.symm)

end Program

/-! ### Linear equivalence -/

/-- `div(φ^m) = m · div(φ)`. -/
theorem principalDivisor_pow {X : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X]
    [IsNormal X]
    (φ : (RationalFunctions X)ˣ) (m : ℕ) :
    MMP.Mori.principalDivisor (φ ^ m) = m • MMP.Mori.principalDivisor φ := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ, MMP.Mori.principalDivisor_mul, ih, succ_nsmul]

/-- Relative ampleness of a multiple of `K + Δ` passes to `K' + Δ` for `K ∼ K'`: if
`m(K + Δ) = L` is Cartier and `f`-ample and `K - K' = div φ`, then
`m(K' + Δ) = L - m div φ ∼ L` is Cartier with isomorphic invertible sheaf. -/
theorem hasRelativelyAmpleMultiple_add_of_linearlyEquivalent {X Y : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {K K' : Divisor X} {Δ : QDivisor X}
    {f : X ⟶ Y} (h : (Divisor.toQDivisor K + Δ).HasRelativelyAmpleMultiple f)
    (hK : K.LinearlyEquivalent K') :
    (Divisor.toQDivisor K' + Δ).HasRelativelyAmpleMultiple f := by
  obtain ⟨m, hm, L, hL, hLeq, hamp⟩ := h
  obtain ⟨φ, hφ⟩ := hK
  have hL' : (L - (m : ℤ) • MMP.Mori.principalDivisor φ).IsCartier :=
    hL.sub ((Divisor.isCartier_principalDivisor φ).zsmul m)
  refine ⟨m, hm, L - (m : ℤ) • MMP.Mori.principalDivisor φ, hL', ?_, ?_⟩
  · rw [map_sub, map_zsmul, hLeq, ← hφ, map_sub, smul_add, smul_add, smul_sub]
    abel
  · have hlin : (L - (m : ℤ) • MMP.Mori.principalDivisor φ).LinearlyEquivalent L :=
      ⟨(φ ^ m)⁻¹, by rw [MMP.Mori.principalDivisor_inv, principalDivisor_pow, natCast_zsmul]; abel⟩
    haveI := hL.isInvertibleModule_divisorialSheaf
    haveI := hL'.isInvertibleModule_divisorialSheaf
    have e := hlin.divisorialSheafIso
    intro y
    obtain ⟨V, hV, hyV, hA⟩ := hamp y
    exact ⟨V, hV, hyV, (Stacks.RelativeVeryAmple.isAmple_congr _ _
      ((modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e)).mpr hA⟩

/-! ### Canonical divisors along birational morphisms -/

section Canonical

universe u

variable {k : Type u} [Field k] [PerfectField k]

/-- The pull-back of a nonzero rational top form along a birational morphism is nonzero. -/
theorem pullbackRationalPluriForms_ne_zero {X Y : Scheme.{u}} [IsIntegral X]
    [IsIntegral Y] {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX] (f : Y ⟶ X) [IsDominant f]
    (hbij : Function.Bijective (functionFieldMap f)) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d)
    {τ : RationalPluriForms sX d 1} (hτ : τ ≠ 0) : pullbackRationalPluriForms sX f τ ≠ 0 := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldMapAlgebra f
  have := isScalarTower_functionFieldMap sX f
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX f hbij hd
  intro h0
  apply hτ
  have h2 : pullbackFormsAlong hω 1 τ = 0 := (pullbackForms_eq hω 1 τ).symm.trans h0
  have h1 := repr_pullbackFormsAlong hω 1 τ
  simp only [h2, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h1
  have h3 := (map_eq_zero_iff _ (algebraMap X.functionField Y.functionField).injective).mp h1.symm
  exact (LinearEquiv.map_eq_zero_iff
    (ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) 1).repr).mp
    (Finsupp.ext fun u => by cases u; simpa using h3)

/-- For a proper birational morphism `f : Y → X` of normal varieties of dimension `n` and a
canonical divisor `K_Y` of `Y`, there is a nonzero rational top form `ω` on `X` with
`div_X(ω) = f_* K_Y`. -/
theorem exists_divisorOfForm_eq_transformDivisor {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (hX : IsNormalVariety k sX) {f : Y ⟶ X}
    [LocallyOfFiniteType (f ≫ sX)] (hY : IsNormalVariety k (f ≫ sX)) [IsProper f]
    (hf : IsBirationalMorphism f) [IsDominant f] {n : ℕ} (hn : topologicalKrullDim X = n)
    {KY : Divisor Y} (hKY : KY.IsCanonicalDivisor (f ≫ sX) n) :
    ∃ ω : RationalPluriForms sX n 1, ω ≠ 0 ∧
      divisorOfForm ω = RationalMap.transformDivisor (X := Y) f.toRationalMap KY := by
  have hbij := hf.functionFieldMap_bijective
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨ω₁, hω₁0, hω₁⟩ := IsCanonicalDivisor.exists_ordForm_eq hY hKY
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldMapAlgebra f
  have := isScalarTower_functionFieldMap sX f
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX f hbij hd
  obtain ⟨g, hg⟩ := hbij.2
    ((ZTensorPower.basis (basisOfSpanSingleton hω.2.1 hω.2.2) 1).repr ω₁ ())
  let τ : RationalPluriForms sX n 1 :=
    g • ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) 1 ()
  have hpull : pullbackRationalPluriForms sX f τ = ω₁ := by
    change pullbackForms (K := X.functionField) (K' := Y.functionField) 1 τ = ω₁
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp only [τ, map_smul, Module.Basis.repr_self, Finsupp.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul, mul_one]
    change functionFieldMap f g • _ = ω₁
    rw [hg]
    exact basis_unit_repr_smul _ ω₁
  refine ⟨τ, fun h0 => hω₁0 ?_, Finsupp.ext fun P => ?_⟩
  · rw [← hpull, h0]
    change pullbackForms (K := X.functionField) (K' := Y.functionField) 1 0 = 0
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp
  · obtain ⟨E, heq, hiso, htr⟩ := exists_isIso_stalkMap_forall_transformDivisor_apply hX hY hf P
    rw [htr]
    change P.ordForm τ = KY.coeff E
    rw [← ordForm_pullbackRationalPluriForms_of_isIso f hbij hd E P heq τ, hpull, hω₁]

/-- The push-forward of a canonical divisor along a proper birational morphism of normal
varieties is a canonical divisor. -/
theorem isCanonicalDivisor_transformDivisor {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (hX : IsNormalVariety k sX) {f : Y ⟶ X}
    [LocallyOfFiniteType (f ≫ sX)] (hY : IsNormalVariety k (f ≫ sX)) [IsProper f]
    (hf : IsBirationalMorphism f) [IsDominant f] {n : ℕ} {KX : Divisor X}
    (hKX : KX.IsCanonicalDivisor sX n) {KY : Divisor Y} (hKY : KY.IsCanonicalDivisor (f ≫ sX) n) :
    Divisor.IsCanonicalDivisor sX n (RationalMap.transformDivisor (X := Y) f.toRationalMap KY) := by
  obtain ⟨ω, hω0, hω⟩ :=
    exists_divisorOfForm_eq_transformDivisor hX hY hf hKX.topologicalKrullDim_eq hKY
  have h := linearlyEquivalent_divisorOfForm_zsmul hX hKX hω0
  rw [one_zsmul, hω] at h
  exact hKX.of_linearlyEquivalent h

/-- **A compatible canonical divisor upstairs.** For a proper birational morphism `f : Y → X` of
normal varieties of dimension `n` and a canonical divisor `K_X`, there is a canonical divisor
`K_Y` of `Y` with `f_* K_Y = K_X`: if `K_X = div(ω)`, take `K_Y = div(f^*ω)`. -/
theorem exists_isCanonicalDivisor_transformDivisor_eq {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (hX : IsNormalVariety k sX) {f : Y ⟶ X}
    [LocallyOfFiniteType (f ≫ sX)] (hY : IsNormalVariety k (f ≫ sX)) [IsProper f]
    (hf : IsBirationalMorphism f) [IsDominant f] {n : ℕ} {KX : Divisor X}
    (hKX : KX.IsCanonicalDivisor sX n) {K₀ : Divisor Y} (hK₀ : K₀.IsCanonicalDivisor (f ≫ sX) n) :
    ∃ KY : Divisor Y, KY.IsCanonicalDivisor (f ≫ sX) n ∧
      RationalMap.transformDivisor (X := Y) f.toRationalMap KY = KX := by
  have hbij := hf.functionFieldMap_bijective
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX)
    hKX.topologicalKrullDim_eq
  obtain ⟨ω, hω0, hω⟩ := IsCanonicalDivisor.exists_ordForm_eq hX hKX
  have hτ0 := pullbackRationalPluriForms_ne_zero f hbij hd hω0
  refine ⟨divisorOfForm (pullbackRationalPluriForms sX f ω), ?_, Finsupp.ext fun P => ?_⟩
  · have h := linearlyEquivalent_divisorOfForm_zsmul hY hK₀ hτ0
    rw [one_zsmul] at h
    exact hK₀.of_linearlyEquivalent h
  · obtain ⟨E, heq, hiso, htr⟩ := exists_isIso_stalkMap_forall_transformDivisor_apply hX hY hf P
    rw [htr]
    change E.ordForm (pullbackRationalPluriForms sX f ω) = KX.coeff P
    rw [ordForm_pullbackRationalPluriForms_of_isIso f hbij hd E P heq ω, hω]

end Canonical

end Main

