module
public import MMP.Attr
public import MMP.AlgebraicGeometry.MMP.Fourfold.Defs
public import MMP.AlgebraicGeometry.Singularities.LogDiscrepancy
import MMP.AlgebraicGeometry.Singularities.BoundaryLowering
import MMP.AlgebraicGeometry.Singularities.Bertini.GeneralMemberSNC
import MMP.AlgebraicGeometry.Singularities.DiscrepancyBoundaryChange
import MMP.AlgebraicGeometry.Resolution.SncPreservingLogResolution
import MMP.AlgebraicGeometry.Resolution.Surface.PointBlowupCurvePullback
import MMP.AlgebraicGeometry.MMP.Contraction.BirationalContraction

/-!
# An lc complement over the base

Let `(X, B)` be a projective lc fourfold pair over `ℂ` with rational boundary and canonical
divisor `K`, put `D = K + B`, and let `f : X ⟶ Z` be a projective contraction onto a normal
projective variety `Z` with `-D` `f`-ample. Then there is an effective `ℚ`-Cartier
`ℚ`-divisor `A` on `X` with `D + A ∼_ℚ 0` over `Z` such that `(X, B + A)` is still log
canonical.

Write `mD = -L` with `L` an `f`-ample Cartier divisor and choose an ample Cartier divisor `H` on
`Z`. For `a` large, `L + f^*(aH)` is ample, so for some `c > 0` the divisor
`𝓛 = c (L + f^*(aH))` is Cartier and `𝒪_X(𝓛)` is generated by finitely many global sections.
Fix a log resolution `π : W ⟶ X` of `(X, B)`. A general member `G = (σ)₀` of the free system
spanned by these sections has `π^*G` reduced, with no component in common with the snc boundary
`∑ π⁻¹_* B_j + ∑ E_i`, and their sum is snc. Put `A = G / (mc)`. Then
`D + A = (1/(mc)) div σ + (1/m) f^*(aH) ∼_ℚ (1/m) f^*(aH)`, and `π` is a log resolution of
`(X, B + A)` whose crepant boundary is `B_W + (1/(mc)) π^*G`. Along a component of `π^*G` the
coefficient of `B_W` is zero, so every coefficient of the crepant boundary is at most one, and
`(X, B + A)` is log canonical by the log resolution test
`MMP.Fourfold.isLogCanonicalPair_iff_forall_coeff_le_one`.

## Main results

* `MMP.Fourfold.exists_isLogCanonicalPair_add_of_hasRelativelyAmpleMultiple_neg`: the statement
  above.

## Implementation notes

"`D + A ∼_ℚ 0` over `Z`", that is `D + A ∼_ℚ f^*H` for a rational Cartier divisor `H` on `Z`, is
stated as `D + A ∼_ℚ G` (`MMP.Mori.QDivisor.QLinearlyEquivalent`) for a `ℚ`-divisor `G` on `X`
with `𝒪_X(mG) ≅ f^* M` for some `m > 0` and an invertible `𝒪_Z`-module `M` (`M = 𝒪_Z(mH)`), as in
`MMP.Fourfold.exists_isRelativelyFreeDivisor_of_isDltPair_of_add_qLinearlyEquivalent`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], 5.17
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Fourfold

universe u

open MMP.Mori

/-! ### Log resolutions -/

section Hironaka

open MMP.Resolution

variable {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}

/-- A variety is a Noetherian scheme. -/
private theorem isNoetherian_of_isVariety (h : AlgebraicGeometry.IsVariety k sY) :
    IsNoetherian Y := by
  have : LocallyOfFiniteType sY := h.toLocallyOfFiniteType
  have : QuasiCompact sY := h.toQuasiCompact
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  exact ⟨⟩

/-- A prime divisor is determined by its support. -/
private theorem primeDivisor_eq_of_support_eq {P Q : MMP.Mori.PrimeDivisor Y}
    (h : (P.support : Set Y) = Q.support) : P = Q := by
  refine AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
    AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
  exact (inseparable_iff_closure_eq.2 h).eq

/-- The ideal sheaf of a prime divisor is the vanishing ideal of its support. -/
private theorem idealSheaf_eq_vanishingIdeal (P : MMP.Mori.PrimeDivisor Y)
    {T : Closeds Y} (hT : (T : Set Y) = P.support) :
    P.idealSheaf = Scheme.IdealSheafData.vanishingIdeal T := by
  have := P.integral
  exact Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ (Closeds.ext hT.symm)

/-- The reduced divisor with components a finite set `s` of prime divisors has support `s`. -/
private theorem support_sum_single (s : Finset (MMP.Mori.PrimeDivisor Y)) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).support = s := by
  classical
  ext E
  simp [Finsupp.finset_sum_apply, Finsupp.single_apply]

/-- A component of a closed subset of pure codimension one is the closure of a point of
codimension one. -/
private theorem exists_coheight_eq_one_of_mem_componentsOf {S : Set Y} (hSc : IsClosed S)
    (hS : MMP.Mori.IsPureCodimOne (⟨S, hSc⟩ : Closeds Y)) {V : Set Y}
    (hV : V ∈ componentsOf S) : ∃ ξ : Y, V = closure {ξ} ∧ Order.coheight ξ = 1 := by
  obtain ⟨ξ, -, hξ⟩ := Aux.exists_eq_closure_of_mem_componentsOf hSc hV
  refine ⟨ξ, hξ, ?_⟩
  rw [← MMP.Flips.codimension_closureSingleton]
  apply hS
  refine ⟨?_, fun W' hW' hle => ?_⟩
  · change closure {ξ} ⊆ S
    rw [← hξ]
    exact hV.1.2
  · change (W' : Set Y) ⊆ closure {ξ}
    rw [← hξ]
    exact hV.2 ⟨W'.isIrreducible, hW'⟩ (by rwa [hξ])

/-- The support of a prime divisor contained in an snc closed subset `S` is an irreducible
component of `S`. -/
private theorem support_mem_componentsOf [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) {P : MMP.Mori.PrimeDivisor Y} (hP : (P.support : Set Y) ⊆ S) :
    (P.support : Set Y) ∈ componentsOf S := by
  obtain ⟨hSc, hempty | ⟨hpure, -, -⟩⟩ := hS
  · simpa [hempty] using hP (MMP.Flips.primeDivisor_genericPoint_mem_support P)
  · obtain ⟨-, hcov⟩ := Aux.finite_and_cover_componentsOf hSc
    obtain ⟨W, hW, hηW⟩ := hcov (hP (MMP.Flips.primeDivisor_genericPoint_mem_support P))
    obtain ⟨ξ, hWξ, hξ1⟩ := exists_coheight_eq_one_of_mem_componentsOf hSc hpure hW
    have hsp : ξ ⤳ P.genericPoint := specializes_iff_mem_closure.mpr (hWξ ▸ hηW)
    have hξη : ξ = P.genericPoint := by
      by_contra hne
      have hlt : P.genericPoint < ξ := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hsp)
        fun hle => hne (hsp.antisymm (Scheme.le_iff_specializes.mp hle)).eq
      have := Order.coheight_strictAnti hlt
      rw [hξ1, P.coheight_genericPoint] at this
      exact lt_irrefl _ (this (by simp))
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    change closure {P.genericPoint} ∈ _
    rw [← hξη, ← hWξ]
    exact hW

/-- Only finitely many prime divisors are contained in an snc closed subset. -/
private theorem finite_setOf_support_subset [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) :
    {P : MMP.Mori.PrimeDivisor Y | (P.support : Set Y) ⊆ S}.Finite := by
  refine Set.Finite.of_finite_image ((Aux.finite_and_cover_componentsOf hS.1).1.subset ?_)
    fun P _ Q _ h => primeDivisor_eq_of_support_eq h
  rintro - ⟨P, hP, rfl⟩
  exact support_mem_componentsOf hS hP

/-- **A reduced divisor whose components lie in an snc closed subset is snc.** -/
private theorem isSNC_sum_single_of_support_subset [LocallyOfFiniteType sY] [NoetherianSpace Y]
    [IsLocallyNoetherian Y] (hsm : IsSmoothScheme sY) {S : Set Y} (hS : IsSNCClosedSubset sY S)
    (s : Finset (MMP.Mori.PrimeDivisor Y)) (hs : ∀ P ∈ s, (P.support : Set Y) ⊆ S) :
    (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).IsSNC sY := by
  classical
  have hc : ∀ P ∈ s, (P.support : Set Y) ∈ componentsOf S := fun P hP =>
    support_mem_componentsOf hS (hs P hP)
  obtain ⟨hSc, hempty | ⟨-, -, hfam⟩⟩ := id hS
  · have hs0 : s = ∅ := Finset.eq_empty_of_forall_notMem fun P hP => by
      simpa [hempty] using hs P hP (MMP.Flips.primeDivisor_genericPoint_mem_support P)
    subst hs0
    rw [Finset.sum_empty]
    exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sY hsm
  have hG := support_sum_single s
  have hideal : ∀ P (hP : P ∈ s),
      P.idealSheaf = componentsFamily S ⟨(P.support : Set Y), hc P hP⟩ := fun P hP =>
    idealSheaf_eq_vanishingIdeal P (by
      rw [Closeds.coe_closure, (Aux.isClosed_of_mem_componentsOf hSc (hc P hP)).closure_eq])
  refine ⟨fun P hP => ?_, fun x => ?_⟩
  · rw [hG] at hP
    rw [hideal P hP]
    exact (hfam.1 _).2.2
  · obtain ⟨m, z, c, hz, hcI, hcinj⟩ := hfam.2 x
    have hs' : ∀ P : {P : MMP.Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        P.1 ∈ s := fun P => hG.subset P.2.1
    have hmem : ∀ P : {P : MMP.Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        x ∈ (componentsFamily S ⟨(P.1.support : Set Y), hc P.1 (hs' P)⟩).support := fun P => by
      rw [← SetLike.mem_coe, coe_support_componentsFamily hSc]
      exact P.2.2
    refine ⟨m, z, fun P => c ⟨_, hmem P⟩, hz, fun P Q h => ?_, fun P => ?_⟩
    · exact Subtype.ext (primeDivisor_eq_of_support_eq
        (congrArg (fun V => (V.1.1 : Set Y)) (hcinj h)))
    · rw [hideal P.1 (hs' P)]
      exact hcI ⟨_, hmem P⟩

/-- An snc closed subset of a smooth Noetherian scheme is an snc divisor in the sense of
`MMP.Mori.IsSNCSubset`. -/
private theorem isSNCSubset_of_isSNCClosedSubset [LocallyOfFiniteType sY] [NoetherianSpace Y]
    [IsLocallyNoetherian Y] (hsm : IsSmoothScheme sY) {S : Closeds Y}
    (hS : IsSNCClosedSubset sY (S : Set Y)) : IsSNCSubset sY S := by
  classical
  by_cases hS0 : (S : Set Y) = ∅
  · exact Or.inl (Closeds.ext (by rw [hS0, Closeds.coe_bot]))
  obtain ⟨hSc, hempty | ⟨hpure, -, -⟩⟩ := id hS
  · exact absurd hempty hS0
  set s := (finite_setOf_support_subset hS).toFinset with hs
  have hmem : ∀ P, P ∈ s ↔ (P.support : Set Y) ⊆ S := fun P => by
    rw [hs, Set.Finite.mem_toFinset]; rfl
  refine Or.inr ⟨s, ?_, isSNC_sum_single_of_support_subset hsm hS s fun P hP => (hmem P).mp hP⟩
  apply subset_antisymm
  · exact Set.iUnion₂_subset fun P hP => (hmem P).mp hP
  · intro y hy
    obtain ⟨W, hW, hyW⟩ := (Aux.finite_and_cover_componentsOf hSc).2 hy
    obtain ⟨ξ, hWξ, hξ1⟩ := exists_coheight_eq_one_of_mem_componentsOf hSc hpure hW
    set P := AlgebraicGeometry.PrimeDivisor.ofCoheightOne ξ hξ1
    have hPs : (P.support : Set Y) = W := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
        AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne, hWξ]
    exact Set.mem_iUnion₂.mpr ⟨P, (hmem P).mpr (hPs ▸ hW.1.2), hPs ▸ hyW⟩

variable {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- **Projective log resolutions exist** in characteristic zero (Hironaka). -/
private theorem exists_isLogResolution [CharZero k] [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (hX : IsNormalVariety k sX) (Δ : QDivisor X) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), MMP.Mori.IsLogResolution sX (QDivisor.toRDivisor Δ) f ∧
      AlgebraicGeometry.IsProjective f := by
  obtain ⟨Y, f, hres, hpure, hS, -⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX Δ.support
  have hYv : AlgebraicGeometry.IsVariety k (f ≫ sX) := hres.isVariety_source
  have : IsProper f := hres.isProjective.isProper
  have : IsNoetherian Y := isNoetherian_of_isVariety hYv
  have : IsLocallyNoetherian Y := this.toIsLocallyNoetherian
  have hsupp_eq : ((QDivisor.toRDivisor Δ).supp : Set X) =
      Δ.support.sup fun E => (E.idealSheaf.support : Set X) := by
    rw [QDivisor.supp_toRDivisor, DivisorWithCoeffs.supp, Closeds.coe_finset_sup]
    rfl
  refine ⟨Y, f, ⟨⟨inferInstance, hres.isBirationalMorphism, hres.isSmoothScheme⟩, hpure, ?_⟩,
    hres.isProjective⟩
  apply isSNCSubset_of_isSNCClosedSubset hres.isSmoothScheme
  change IsSNCClosedSubset (f ≫ sX)
    ((exceptionalSet f : Set Y) ∪ f ⁻¹' ((QDivisor.toRDivisor Δ).supp : Set X))
  rwa [hsupp_eq]

/-- The exceptional prime divisors of a log resolution are finitely many. -/
private theorem exists_finset_isExceptional {D : RDivisor X} {Y : Scheme.{u}} {f : Y ⟶ X}
    (hf : MMP.Mori.IsLogResolution sX D f) :
    ∃ Ex : Finset (MMP.Mori.PrimeDivisor Y),
      ∀ F : MMP.Mori.PrimeDivisor Y, F ∈ Ex ↔ RationalMap.IsExceptional f.toRationalMap F := by
  classical
  have hmem : ∀ F : MMP.Mori.PrimeDivisor Y, RationalMap.IsExceptional f.toRationalMap F →
      F.genericPoint ∈ ((exceptionalSet f ⊔ D.supp.preimage f.continuous : Closeds Y) : Set Y) :=
    fun F hF => Or.inl (MMP.Positivity.support_subset_exceptionalSet F hF
      (MMP.Flips.primeDivisor_genericPoint_mem_support F))
  rcases hf.isSNCSubset with h0 | ⟨s, hs, -⟩
  · exact ⟨∅, fun F => ⟨fun h => absurd h (Finset.notMem_empty _), fun hF => by
      simpa [h0] using hmem F hF⟩⟩
  · refine ⟨s.filter (fun F => RationalMap.IsExceptional f.toRationalMap F), fun F => ?_⟩
    rw [Finset.mem_filter]
    refine ⟨fun h => h.2, fun hF => ⟨?_, hF⟩⟩
    have h := hmem F hF
    rw [← hs] at h
    obtain ⟨E, hE, hgen⟩ := Set.mem_iUnion₂.mp h
    rwa [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hgen] at hE

end Hironaka

/-! ### Proper birational morphisms over prime divisors -/

section CodimOne

/-- Two points of `X` over the generic point of a prime divisor `Q` of the normal scheme `Y` are
equal, for `f : X ⟶ Y` separated, dominant and birational. -/
private theorem eq_of_map_eq_genericPoint {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y) [IsSeparated f] [IsDominant f]
    (hf : Function.Bijective (functionFieldMap f)) (Q : MMP.Mori.PrimeDivisor Y) {x₁ x₂ : X}
    (h₁ : f x₁ = Q.genericPoint) (h₂ : f x₂ = Q.genericPoint) : x₁ = x₂ := by
  have := Q.isDiscreteValuationRing_localRing
  haveI : ValuationRing (Y.presheaf.stalk (f x₁)) := by rw [h₁]; infer_instance
  haveI : ValuationRing (Y.presheaf.stalk (f x₂)) := by rw [h₂]; infer_instance
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing f hf x₁
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing f hf x₂
  exact MMP.Positivity.eq_of_isIso_stalkMap f hf (h₂.trans h₁.symm)

/-- A proper birational morphism onto a normal integral scheme is an isomorphism over the generic
point of every prime divisor. -/
private theorem genericPoint_mem_biregularLocus {X Y : Scheme.{u}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y) [IsProper f]
    (hf : IsBirationalMorphism f) (P : MMP.Mori.PrimeDivisor Y) :
    P.genericPoint ∈ biregularLocus f := by
  haveI := hf.isDominant
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso f
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hf)).1 inferInstance
  exact le_biregularLocus (V := ⟨_, hU⟩) hiso (Set.Subsingleton.finite fun _ ha _ hb =>
    eq_of_map_eq_genericPoint f hf.functionFieldMap_bijective P ha hb)

variable {k : Type u} [Field k] [PerfectField k] {X W : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W]

/-- **A non-exceptional prime divisor of a proper birational model is a strict transform.** If
`F` is a prime divisor of `W` which is not exceptional over `X`, then `π` maps the generic point
of `F` to that of a prime divisor `P` of `X`, `F = π⁻¹_* P`, and the discrepancy of `F` over a
pair `(X, Δ)` is `-coeff_P Δ`. -/
private theorem exists_inverseTransformPrimeDivisor_eq_some {n : ℕ} {K : Divisor X}
    {Δ : QDivisor X} (hP : IsPairWith sX n K Δ) {π : W ⟶ X} [IsProper π]
    (hW : IsNormalVariety k (π ≫ sX)) (hbir : IsBirationalMorphism π)
    (F : MMP.Mori.PrimeDivisor W) (hF : ¬ RationalMap.IsExceptional π.toRationalMap F) :
    ∃ P : MMP.Mori.PrimeDivisor X, π F.genericPoint = P.genericPoint ∧
      inverseTransformPrimeDivisor π P = some F ∧
      IsDiscrepancy sX n K Δ ⟨W, π, hW, hbir, F⟩ (-Δ.coeff P) := by
  obtain ⟨P, hc, hd⟩ := DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hP
    ⟨W, π, hW, hbir, F⟩ hF
  have hη : π F.genericPoint = P.genericPoint := by
    rw [DivisorOver.center_eq_closure_genericPoint,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hc
    exact (inseparable_iff_closure_eq.2 hc).eq
  exact ⟨P, hη, MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
    hη (hη ▸ genericPoint_mem_biregularLocus π hbir P), hd⟩

/-- The coefficient of `π⁻¹_* B` along `π⁻¹_* P` is the coefficient of `B` along `P`. -/
private theorem coeff_inverseTransformDivisor_of_eq_some {R : Type*} [AddCommMonoid R]
    {g : W ⟶ X} {P : MMP.Mori.PrimeDivisor X} {F : MMP.Mori.PrimeDivisor W}
    (hP : inverseTransformPrimeDivisor g P = some F) (B : DivisorWithCoeffs R X) :
    (inverseTransformDivisor g B).coeff F = B.coeff P :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hP (fun _ hP' =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective <|
      (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
        hP').1.symm.trans
      (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hP).1) B

/-- A strict transform `π⁻¹_* P` of a component `P` of `B` is a component of `π⁻¹_* B`. -/
private theorem mem_support_inverseTransformDivisor {π : W ⟶ X} {B : QDivisor X}
    {P : MMP.Mori.PrimeDivisor X} {F : MMP.Mori.PrimeDivisor W}
    (hinv : inverseTransformPrimeDivisor π P = some F) (hP : B.coeff P ≠ 0) :
    F ∈ (inverseTransformDivisor π B).support := by
  rwa [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
    coeff_inverseTransformDivisor_of_eq_some hinv]

open Classical in
/-- **The snc boundary of a log resolution.** The snc divisor `Ex(π) ∪ π⁻¹ Supp B` of a log
resolution `π` of `(X, B)` is the union of finitely many prime divisors, each a component of
`π⁻¹_* B` or exceptional. -/
private theorem exists_finset_subset_support_union {n : ℕ} {K : Divisor X} {B : QDivisor X}
    (hPW : IsPairWith sX n K B) {π : W ⟶ X} [IsProper π] (hπ : MMP.Fourfold.IsLogResolution sX B π)
    (hW : IsNormalVariety k (π ≫ sX)) (hbir : IsBirationalMorphism π)
    (Ex : Finset (MMP.Mori.PrimeDivisor W))
    (hEx : ∀ F : MMP.Mori.PrimeDivisor W, F ∈ Ex ↔ RationalMap.IsExceptional π.toRationalMap F) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor W), (⋃ E ∈ s, (E.support : Set W)) =
      ((exceptionalSet π ⊔ (QDivisor.toRDivisor B).supp.preimage π.continuous : Closeds W) :
        Set W) ∧ s ⊆ (inverseTransformDivisor π B).support ∪ Ex := by
  rcases hπ.isSNCSubset with h0 | ⟨s, hs, -⟩
  · exact ⟨∅, by rw [h0]; simp, Finset.empty_subset _⟩
  refine ⟨s, hs, fun E hE => ?_⟩
  by_cases hEE : E ∈ Ex
  · exact Finset.mem_union_right _ hEE
  obtain ⟨P, hη, hinv, -⟩ :=
    exists_inverseTransformPrimeDivisor_eq_some hPW hW hbir E (fun h => hEE ((hEx E).mpr h))
  refine Finset.mem_union_left _ (mem_support_inverseTransformDivisor hinv ?_)
  have hmem : E.genericPoint ∈ ((exceptionalSet π ⊔
      (QDivisor.toRDivisor B).supp.preimage π.continuous : Closeds W) : Set W) := by
    rw [← hs]
    exact Set.mem_iUnion₂.mpr ⟨E, hE, MMP.Flips.primeDivisor_genericPoint_mem_support E⟩
  rcases hmem with hx | hx
  · exfalso
    rw [SetLike.mem_coe, mem_exceptionalSet, hη] at hx
    exact hx (genericPoint_mem_biregularLocus π hbir P)
  · change π E.genericPoint ∈ (QDivisor.toRDivisor B).supp at hx
    rw [QDivisor.supp_toRDivisor, hη, DivisorWithCoeffs.mem_supp_iff] at hx
    obtain ⟨Q, hQ, hPQ⟩ := hx
    obtain rfl := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPQ
    exact hQ

open Classical in
/-- Off the snc boundary `π⁻¹_* B ∪ Ex(π)`, the crepant boundary of `(X, B)` vanishes. -/
private theorem coeff_eq_zero_of_notMem_union {n : ℕ} {K : Divisor X} {B : QDivisor X}
    (hPW : IsPairWith sX n K B) {π : W ⟶ X} [IsProper π] (hW : IsNormalVariety k (π ≫ sX))
    (hbir : IsBirationalMorphism π) {BW : QDivisor W}
    (hBW : IsCrepantBoundary sX n K B π hW hbir BW) (Ex : Finset (MMP.Mori.PrimeDivisor W))
    (hEx : ∀ F : MMP.Mori.PrimeDivisor W, F ∈ Ex ↔ RationalMap.IsExceptional π.toRationalMap F)
    {F : MMP.Mori.PrimeDivisor W} (hF : F ∉ (inverseTransformDivisor π B).support ∪ Ex) :
    BW.coeff F = 0 := by
  obtain ⟨P, -, hinv, hd⟩ := exists_inverseTransformPrimeDivisor_eq_some hPW hW hbir F
    fun h => hF (Finset.mem_union_right _ ((hEx F).mpr h))
  rw [show BW.coeff F = B.coeff P by linarith [(hBW F).eq hd]]
  by_contra hP
  exact hF (Finset.mem_union_left _ (mem_support_inverseTransformDivisor hinv hP))

end CodimOne

/-! ### Global generation -/

section GlobalGeneration

open Stacks.Ample Stacks.RelativeVeryAmple

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- `𝒪_X(n H + F) ≅ 𝒪_X(F) ⊗ 𝒪_X(H)^{⊗ n}` for Cartier divisors `H` and `F`. -/
private theorem nonempty_divisorialSheaf_nsmul_add_iso {H F : Divisor X} (hH : H.IsCartier)
    (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((n • H + F).divisorialSheaf ≅
      tensorModules X F.divisorialSheaf (tensorPowModule X H.divisorialSheaf (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- `𝒪_X(H)^{⊗ (n + 1)} ≅ 𝒪_X((n + 1) H)` for a Cartier divisor `H`. -/
private theorem nonempty_tensorPowModule_iso_divisorialSheaf {H : Divisor X} (hH : H.IsCartier)
    [Stacks.Ample.IsInvertibleModule X H.divisorialSheaf] (n : ℕ) :
    Nonempty (Stacks.Ample.tensorPowModule X H.divisorialSheaf ((n + 1 : ℕ) : ℤ) ≅
      (((n + 1 : ℕ) : ℤ) • H).divisorialSheaf) := by
  induction n with
  | zero => exact ⟨Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by norm_num) ≪≫
      Stacks.Ample.tensorPowModuleOneIso X _ ≪≫
      eqToIso (by rw [Nat.cast_one, one_smul])⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by push_cast; ring) ≪≫
      (Stacks.Ample.tensorPowModuleAddIso X _ ((n + 1 : ℕ) : ℤ) 1).symm ≪≫
      Stacks.RelativeVeryAmple.tensorModulesMapIso X e (Stacks.Ample.tensorPowModuleOneIso X _) ≪≫
      (hH.zsmul _).divisorialSheafTensorIso hH ≪≫
      eqToIso (by congr 1; push_cast; simp only [add_smul, one_smul])⟩

/-- **Serre generation for `𝒪_X(n H + F)`.** If `𝒪_X(H)` is ample and `F` is Cartier, then for
some `n` finitely many global sections `s₀, …, s_N` of `𝒪_X(n H + F)` have nonvanishing opens
covering `X`. -/
private theorem exists_forall_mem_nonvanishingOpen [IsIntegral X] {H F : Divisor X}
    (hH : H.IsCartier) (hF : F.IsCartier)
    (hamp : haveI := hH.isInvertibleModule_divisorialSheaf
      Stacks.Ample.IsAmple X H.divisorialSheaf) :
    ∃ (n N : ℕ) (s : Fin (N + 1) → Γ((n • H + F).divisorialSheaf, ⊤)),
      haveI := ((hH.nsmul n).add hF).isInvertibleModule_divisorialSheaf
      ∀ x : X, ∃ i, x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X (n • H + F).divisorialSheaf
        (s i) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  have : SheafOfModules.IsFiniteType.{u, u, u} F.divisorialSheaf :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule _
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hamp).2 F.divisorialSheaf inferInstance inferInstance
  set n : ℕ := n₀.toNat
  obtain ⟨σ, hσ⟩ := hn₀ (n : ℤ) (by omega)
  haveI := ((hH.nsmul n).add hF).isInvertibleModule_divisorialSheaf
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X F.divisorialSheaf
    (tensorPowModule X H.divisorialSheaf (n : ℤ))
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_add_iso hH hF n
  let p := i.hom ≫ e.inv
  haveI : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ p :=
    @IsIso.epi_of_iso _ _ _ _ p inferInstance
  let σ' := σ.ofEpi p
  haveI : Finite σ'.I := hσ
  haveI : Fintype σ'.I := Fintype.ofFinite _
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  obtain ⟨i₀, -⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing _ σ' x₀
  have hcard : 0 < Fintype.card σ'.I := Fintype.card_pos_iff.mpr ⟨i₀⟩
  let eI : σ'.I ≃ Fin (Fintype.card σ'.I - 1 + 1) :=
    Fintype.equivFinOfCardEq (by omega)
  refine ⟨n, Fintype.card σ'.I - 1, fun j => (σ'.s (eI.symm j)).eval (Opposite.op ⊤),
    fun x => ?_⟩
  obtain ⟨j, hj⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing _ σ' x
  refine ⟨eI j, ?_⟩
  have hx : x ∈ (Stacks.SheafOfModules.nonvanishingOpen _ (σ'.s j) : Set X) := hj
  rw [Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X _ (σ'.s j)] at hx
  simp only [Equiv.symm_apply_apply]
  exact hx

variable [IsIntegral X]

/-- A nonzero section `σ` of `𝒪_X(M)` is the rational function `φ` with `div φ + M = (σ)₀`;
multiplication by `φ⁻¹` carries it to the section `1` of `𝒪_X((σ)₀)`. -/
private theorem divisorialSheafMulIso_app_eq_oneSection {M : Divisor X}
    (σ : M.divisorialSubmodule ⊤) (hσ : σ ≠ 0) :
    ((Divisor.divisorialSheafMulIso (D := M) (D' := M.zeroDivisor σ hσ)
        (Divisor.isUnit_sectionToRationalFunctions hσ).unit⁻¹ fun E => by
          rw [Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
            PrimeDivisor.ord_inv]; ring).hom.app ⊤ σ) =
      MMP.Threefold.Mori.oneSection (M.zeroDivisor_nonneg σ hσ) := by
  refine Subtype.ext (funext fun Z => ?_)
  change ((Divisor.isUnit_sectionToRationalFunctions hσ).unit⁻¹ : (RationalFunctions X)ˣ).1 Z.1 *
      σ.1 Z = ((Divisor.structureSheafToDivisorialSheaf _).app ⊤ (1 : Γ(X, ⊤))).1 Z
  rw [Divisor.coe_structureSheafToDivisorialSheaf_app, map_one,
    show σ.1 Z = ((Divisor.isUnit_sectionToRationalFunctions hσ).unit :
      RationalFunctions X) Z.1 from rfl, ← Pi.mul_apply, ← Units.val_mul, inv_mul_cancel,
    Units.val_one]
  rfl

/-- **The nonvanishing locus of a section is the complement of its divisor of zeros**, for a
Cartier divisor `M`. -/
private theorem nonvanishingLocus_eq_compl_supp_zeroDivisor {M : Divisor X} (hM : M.IsCartier)
    (σ : M.divisorialSubmodule ⊤) (hσ : σ ≠ 0) :
    haveI := hM.isInvertibleModule_divisorialSheaf
    Stacks.Ample.nonvanishingLocus M.divisorialSheaf σ = ((M.zeroDivisor σ hσ).supp : Set X)ᶜ := by
  haveI := hM.isInvertibleModule_divisorialSheaf
  have hZc : (M.zeroDivisor σ hσ).IsCartier := by
    rw [Divisor.zeroDivisor_eq]
    exact (Divisor.isCartier_principalDivisor _).add hM
  haveI := hZc.isInvertibleModule_divisorialSheaf
  rw [← Stacks.CokernelSupport.nonvanishingLocus_iso_app (Divisor.divisorialSheafMulIso (D := M)
    (D' := M.zeroDivisor σ hσ) (Divisor.isUnit_sectionToRationalFunctions hσ).unit⁻¹ fun E => by
      rw [Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
        PrimeDivisor.ord_inv]; ring) σ, divisorialSheafMulIso_app_eq_oneSection σ hσ]
  exact MMP.Threefold.Mori.nonvanishingLocus_oneSection _ hZc

/-- Sections of `𝒪_X(M)` whose nonvanishing opens cover `X` are nonzero where they are used, and
have divisors of zeros without common point. -/
private theorem forall_exists_notMem_supp_zeroDivisor {M : Divisor X} (hM : M.IsCartier) {N : ℕ}
    (s : Fin (N + 1) → Γ(M.divisorialSheaf, ⊤))
    (hs : haveI := hM.isInvertibleModule_divisorialSheaf
      ∀ x : X, ∃ i, x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X M.divisorialSheaf (s i)) :
    ∀ x : X, ∃ (i : Fin (N + 1)) (hi : (s i : M.divisorialSubmodule ⊤) ≠ 0),
      x ∉ (M.zeroDivisor (s i) hi).supp := by
  haveI := hM.isInvertibleModule_divisorialSheaf
  intro x
  obtain ⟨i, hx⟩ := hs x
  have hx' : x ∈ Stacks.Ample.nonvanishingLocus M.divisorialSheaf (s i) := hx
  have hi : (s i : M.divisorialSubmodule ⊤) ≠ 0 := by
    intro h0
    change s i = 0 at h0
    rw [h0, Stacks.Ample.nonvanishingLocus_zero] at hx'
    exact hx'
  refine ⟨i, hi, ?_⟩
  rwa [nonvanishingLocus_eq_compl_supp_zeroDivisor hM (s i) hi] at hx'

end GlobalGeneration

/-! ### The free linear system -/

section FreeSystem

open RingedSpaceModuleAdjunction

/-- **An ample divisor.** A projective variety carries a Cartier divisor `A` with `𝒪_X(A)` ample:
the divisor of a section of a power of an ample invertible sheaf. -/
private theorem exists_isAmple {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X] [CompactSpace X]
    (hX : MMP.Mori.IsProjectiveVariety k sX) :
    ∃ (A : Divisor X) (hA : A.IsCartier), A.IsAmple hA := by
  obtain ⟨-, M, hMinv, hMamp⟩ :=
    Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective sX hX.isProjective.isHQuasiProjective
  have hM : Stacks.Ample.IsAmple X M :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine sX M hMamp
  obtain ⟨IX, hIX, -, -, n, hn, ⟨eX⟩⟩ :=
    MMP.Threefold.Resolution.exists_isEffectiveCartierDivisor_of_isAmple M hM isClosed_empty
      (Set.notMem_empty (genericPoint X))
  obtain ⟨H, -, hHc, ⟨eH⟩, -⟩ :=
    MMP.Threefold.Resolution.exists_divisor_of_isEffectiveCartierDivisor IX hIX
  haveI := hHc.isInvertibleModule_divisorialSheaf
  exact ⟨H, hHc, (Stacks.RelativeVeryAmple.isAmple_congr _ _ (eX ≪≫ eH.symm)).mp
    (Stacks.AmplePositivePower.isAmple_tensorPowModule_of_isAmple M n hn hM)⟩

/-- Over the spectrum of a field, relative ampleness is ampleness. -/
private theorem isAmple_of_isRelativelyAmple {k : Type u} [Field k] {X : Scheme.{u}}
    {s : X ⟶ Spec (.of k)} {N : X.Modules} [Stacks.Ample.IsInvertibleModule X N]
    (h : MMP.Mori.IsRelativelyAmple s N) : Stacks.Ample.IsAmple X N := by
  obtain ⟨V, -, hyV, hA⟩ := h (IsLocalRing.closedPoint _)
  have hV : V = ⊤ := TopologicalSpace.Opens.ext (Set.eq_univ_of_forall fun z => by
    rwa [Subsingleton.elim z (IsLocalRing.closedPoint _)])
  subst hV
  have : IsIso (s ⁻¹ᵁ (⊤ : (Spec (.of k)).Opens)).ι := inferInstanceAs (IsIso X.topIso.hom)
  exact Stacks.RelativeAmpleAffineBase.isAmple_of_isAmple_modulePullback _ N hA

/-- The ringed-space pull-back of modules is the scheme pull-back. -/
private noncomputable def modulePullbackIso {X Y : Scheme.{u}} (f : X ⟶ Y) (F : Y.Modules) :
    (modulePullback f.toLRSHom.toShHom).obj F ≅ (Scheme.Modules.pullback f).obj F :=
  (Adjunction.leftAdjointUniq (modulePullbackPushforwardAdjunction f.toLRSHom.toShHom)
    (Scheme.Modules.pullbackPushforwardAdjunction f)).app F

/-- **A free linear system computing `-D` over `Z`.** Let `f : X ⟶ Z` be a quasi-compact
dominant morphism over `k` to a projective variety `Z`, and `D` a `ℚ`-divisor on `X` with `-D`
`f`-ample. There are integers `m, c > 0`, a divisor `P` on `X` with `𝒪_X(P) ≅ f^*M` for an
invertible `𝒪_Z`-module `M`, and a Cartier divisor `𝓛 = mc(-D) + cP` such that `𝒪_X(𝓛)` is
generated by finitely many global sections. -/
private theorem exists_free_system {k : Type u} [Field k] {X Z : Scheme.{u}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z] [CompactSpace Z]
    [IsLocallyNoetherian Z] [IsNormal Z] {sX : X ⟶ Spec (.of k)} {sZ : Z ⟶ Spec (.of k)}
    {f : X ⟶ Z} (hfZ : f ≫ sZ = sX) [QuasiCompact f] [IsDominant f]
    (hZ : MMP.Mori.IsProjectiveVariety k sZ) {D : QDivisor X}
    (hamp : (-D).HasRelativelyAmpleMultiple f) :
    ∃ (m c : ℕ), 0 < m ∧ 0 < c ∧ ∃ (𝓛 P : Divisor X) (M : Z.Modules),
      Stacks.Ample.IsInvertibleModule Z M ∧
      Nonempty (P.divisorialSheaf ≅ (Scheme.Modules.pullback f).obj M) ∧ 𝓛.IsCartier ∧
      Divisor.toQDivisor 𝓛 = ((m * c : ℕ) : ℤ) • (-D) + (c : ℤ) • Divisor.toQDivisor P ∧
      ∃ (N : ℕ) (s : Fin (N + 1) → 𝓛.divisorialSubmodule ⊤),
        ∀ x : X, ∃ (i : Fin (N + 1)) (hi : s i ≠ 0), x ∉ (𝓛.zeroDivisor (s i) hi).supp := by
  obtain ⟨m, hm, L, hLc, hLD, hLamp⟩ := hamp
  obtain ⟨H, hHc, hHamp⟩ := exists_isAmple hZ
  haveI := hLc.isInvertibleModule_divisorialSheaf
  haveI := hHc.isInvertibleModule_divisorialSheaf
  have hfL : Stacks.RelativeAmple.IsRelativelyAmple f L.divisorialSheaf :=
    (Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover f _
      inferInstance).mpr hLamp
  have hgH : Stacks.RelativeAmple.IsRelativelyAmple sZ H.divisorialSheaf :=
    (Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover sZ _
      hZ.toIsVariety.toQuasiCompact).mpr
      (MMP.Threefold.Resolution.isRelativelyAmple_of_isAmple sZ _ hHamp)
  obtain ⟨a₀, ha₀⟩ :=
    Stacks.AmplePullbackDatum.exists_threshold_isRelativelyAmple_comp f sZ _ _ hfL hgH
  set Ha : Divisor Z := ((a₀ + 1 : ℕ) : ℤ) • H
  have hHac : Ha.IsCartier := hHc.zsmul _
  have hBa : ∀ Z' : irreducibleComponents X, f (componentGenericPoint X Z') ∉ Ha.supp :=
    fun Z' => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z'
  set P := Ha.pullback hHac hBa
  have hP := Divisor.isPullback_pullback hHac hBa
  have hPc : P.IsCartier := MMP.Fourfold.isCartier_of_isPullback f hHac hP
  haveI := hPc.isInvertibleModule_divisorialSheaf
  haveI := hHac.isInvertibleModule_divisorialSheaf
  haveI := (hLc.add hPc).isInvertibleModule_divisorialSheaf
  obtain ⟨eH⟩ := nonempty_tensorPowModule_iso_divisorialSheaf hHc a₀
  have e : Stacks.AmplePullbackPart1.tensorPullbackPowModule f L.divisorialSheaf
      H.divisorialSheaf (a₀ + 1) ≅ (L + P).divisorialSheaf :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
      (modulePullbackIso f _ ≪≫ (Scheme.Modules.pullback f).mapIso eH ≪≫
        (hP.divisorialSheafIso (hBc := hHac)).symm) ≪≫
    hLc.divisorialSheafTensorIso hPc
  have h2 : Stacks.Ample.IsAmple X (L + P).divisorialSheaf := by
    have h3 := (Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _ e).mp
      (ha₀ (a₀ + 1) (by omega))
    rw [hfZ] at h3
    exact isAmple_of_isRelativelyAmple (MMP.Mori.IsRelativelyAmple.of_stacks _ _ h3)
  obtain ⟨N', N, s, hs⟩ := exists_forall_mem_nonvanishingOpen (hLc.add hPc) (hLc.add hPc) h2
  have h𝓛c : (N' • (L + P) + (L + P)).IsCartier := ((hLc.add hPc).nsmul N').add (hLc.add hPc)
  refine ⟨m, N' + 1, hm, by omega, N' • (L + P) + (L + P), P, Ha.divisorialSheaf, inferInstance,
    ⟨hP.divisorialSheafIso (hBc := hHac)⟩, h𝓛c, ?_, N, s,
    forall_exists_notMem_supp_zeroDivisor h𝓛c s hs⟩
  rw [map_add, map_nsmul, map_add, hLD]
  push_cast
  module

end FreeSystem

/-! ### Rescaling an integral divisor -/

section InvSmul

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {r : ℕ}

/-- An integral divisor `D` is `r • (D / r)`. -/
private theorem toQDivisor_eq_zsmul_inv_smul (hr : r ≠ 0) (D : Divisor X) :
    Divisor.toQDivisor D = (r : ℤ) • ((r : ℚ)⁻¹ • Divisor.toQDivisor D) := by
  rw [← Int.cast_smul_eq_zsmul ℚ, smul_smul]
  push_cast
  rw [mul_inv_cancel₀ (by exact_mod_cast hr), one_smul]

private theorem coeff_inv_smul_toQDivisor (D : Divisor X) (P : MMP.Mori.PrimeDivisor X) :
    ((r : ℚ)⁻¹ • Divisor.toQDivisor D).coeff P = (r : ℚ)⁻¹ * D.coeff P := by
  rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, smul_eq_mul]

/-- `D / r` is `ℚ`-Cartier for a Cartier divisor `D`. -/
private theorem isQCartier_inv_smul_toQDivisor (hr : r ≠ 0) {D : Divisor X} (hD : D.IsCartier) :
    ((r : ℚ)⁻¹ • Divisor.toQDivisor D).IsQCartier :=
  ⟨r, by exact_mod_cast hr, ⟨D, toQDivisor_eq_zsmul_inv_smul hr D, hD⟩⟩

private theorem inv_smul_toQDivisor_nonneg {D : Divisor X} (hD : 0 ≤ D) :
    0 ≤ (r : ℚ)⁻¹ • Divisor.toQDivisor D := fun P => by
  change (0 : ℚ) ≤ DivisorWithCoeffs.coeff ((r : ℚ)⁻¹ • Divisor.toQDivisor D) P
  rw [coeff_inv_smul_toQDivisor]
  have : (0 : ℚ) ≤ D.coeff P := by exact_mod_cast hD P
  positivity

/-- For `B ≥ 0` and `D ≥ 0`, the support of `B + D / r` is the union of the supports. -/
private theorem mem_supp_add_inv_smul_iff {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P)
    {D : Divisor X} (hD : 0 ≤ D) (hr : r ≠ 0) (x : X) :
    x ∈ (QDivisor.toRDivisor (B + (r : ℚ)⁻¹ • Divisor.toQDivisor D)).supp ↔
      x ∈ D.supp ∨ x ∈ (QDivisor.toRDivisor B).supp := by
  have hc : ∀ P, (B + (r : ℚ)⁻¹ • Divisor.toQDivisor D).coeff P ≠ 0 ↔
      D.coeff P ≠ 0 ∨ B.coeff P ≠ 0 := fun P => by
    have : (0 : ℚ) ≤ D.coeff P := by exact_mod_cast hD P
    rw [DivisorWithCoeffs.coeff_add, coeff_inv_smul_toQDivisor, ne_eq,
      add_eq_zero_iff_of_nonneg (hB P) (by positivity)]
    simp only [mul_eq_zero, inv_eq_zero, Nat.cast_eq_zero, hr, Int.cast_eq_zero, false_or,
      not_and, ne_eq]
    tauto
  simp only [QDivisor.supp_toRDivisor, DivisorWithCoeffs.mem_supp_iff, hc, or_and_right,
    exists_or]

/-- If `L = mc • (-D) + c • P`, then `mc • (D + (Φ + L) / (mc) - P / m) = Φ`. -/
private theorem zsmul_add_inv_smul_sub_inv_smul_eq {D Φ L P : QDivisor X} {m c : ℕ}
    (hm : 0 < m) (hc : 0 < c) (hL : L = ((m * c : ℕ) : ℤ) • (-D) + (c : ℤ) • P) :
    ((m * c : ℕ) : ℤ) • (D + ((m * c : ℕ) : ℚ)⁻¹ • (Φ + L) - (m : ℚ)⁻¹ • P) = Φ := by
  subst hL
  refine Finsupp.ext fun E => ?_
  simp only [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_neg,
    zsmul_eq_mul, smul_eq_mul]
  push_cast
  field_simp
  ring

end InvSmul

/-! ### Adding a general member to an lc pair -/

section LogCanonical

variable {k : Type u} [Field k] {X W : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]

open Classical in
/-- The coefficient of the reduced divisor `∑_{E ∈ S} E` at `F` is `1` or `0`. -/
private theorem coeff_sum_single {Y : Scheme.{u}} (S : Finset (MMP.Mori.PrimeDivisor Y))
    (F : MMP.Mori.PrimeDivisor Y) :
    DivisorWithCoeffs.coeff (∑ E ∈ S, Finsupp.single E (1 : ℤ) : Divisor Y) F =
      if F ∈ S then 1 else 0 := by
  change (∑ E ∈ S, Finsupp.single E (1 : ℤ)) F = _
  rw [Finsupp.finset_sum_apply]
  simp [Finsupp.single_apply]

open Classical in
/-- If `H ≥ 0` and `H + ∑_{E ∈ S} E` has coefficient `0` or `1` at `F`, then either `F` is not a
component of `H`, or `F` is a reduced component of `H` outside `S`. -/
private theorem coeff_eq_zero_or_of_coeff_add_sum_single {Y : Scheme.{u}} {H : Divisor Y}
    {S : Finset (MMP.Mori.PrimeDivisor Y)} {F : MMP.Mori.PrimeDivisor Y} (h0 : 0 ≤ H.coeff F)
    (h : (H + ∑ E ∈ S, Finsupp.single E (1 : ℤ)).coeff F = 0 ∨
      (H + ∑ E ∈ S, Finsupp.single E (1 : ℤ)).coeff F = 1) :
    H.coeff F = 0 ∨ (H.coeff F = 1 ∧ F ∉ S) := by
  rw [DivisorWithCoeffs.coeff_add, coeff_sum_single] at h
  split_ifs at h with hF
  · left
    omega
  · rcases h with h | h
    · left
      omega
    · exact Or.inr ⟨by omega, hF⟩

/-- The pull-back of `G / r` is `H' / r`, for `H'` the pull-back of the Cartier divisor `G`. -/
private theorem coeff_eq_inv_mul_of_isPullback [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {π : W ⟶ X} {G : Divisor X} (hGc : G.IsCartier)
    {hBG : ∀ Z : irreducibleComponents W, π (componentGenericPoint W Z) ∉ G.supp}
    {H' : Divisor W} (hH' : G.IsPullback π hBG H') {r : ℕ} (hr : 0 < r)
    {hBA : ∀ Z : irreducibleComponents W,
      π (componentGenericPoint W Z) ∉ ((r : ℚ)⁻¹ • Divisor.toQDivisor G).supp}
    {B' : QDivisor W} (hB' : ((r : ℚ)⁻¹ • Divisor.toQDivisor G).IsPullback π hBA B')
    (F : MMP.Mori.PrimeDivisor W) : B'.coeff F = (r : ℚ)⁻¹ * H'.coeff F := by
  obtain ⟨D', hD', hpD'⟩ := hB' r hr G (toQDivisor_eq_zsmul_inv_smul hr.ne' G) hGc
  obtain rfl := hpD'.eq hGc hH'
  have := congrArg (fun E : QDivisor W => E.coeff F) hD'
  simp only [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul, Divisor.coeff_toQDivisor] at this
  rw [this]
  push_cast
  field_simp

open Classical in
/-- If `H' = π^*G` is reduced off the snc boundary `S₀` of a log resolution `π` of `(X, B)` and
`H' + ∑_{E ∈ S₀} E` is snc, then `π` resolves the boundary of `(X, B + G / r)` too. -/
private theorem isSNCSubset_add_inv_smul [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P) {π : W ⟶ X} {G : Divisor X} (hG0 : 0 ≤ G)
    {H' : Divisor W} (hsuppH' : (H'.supp : Set W) = π ⁻¹' (G.supp : Set X))
    {S₀ s : Finset (MMP.Mori.PrimeDivisor W)}
    (hs : (⋃ E ∈ s, (E.support : Set W)) =
      ((exceptionalSet π ⊔ (QDivisor.toRDivisor B).supp.preimage π.continuous : Closeds W) :
        Set W))
    (hsS₀ : s ⊆ S₀) (hH'0 : ∀ F, 0 ≤ H'.coeff F)
    (hH'01 : ∀ F, H'.coeff F = 0 ∨ (H'.coeff F = 1 ∧ F ∉ S₀))
    (hsnc : DivisorWithCoeffs.IsSNC (π ≫ sX) (H' + ∑ F ∈ S₀, Finsupp.single F (1 : ℤ)))
    {r : ℕ} (hr : 0 < r) :
    IsSNCSubset (π ≫ sX) (exceptionalSet π ⊔ (QDivisor.toRDivisor
      (B + (r : ℚ)⁻¹ • Divisor.toQDivisor G)).supp.preimage π.continuous) := by
  refine Or.inr ⟨H'.support ∪ s, ?_, ?_⟩
  · rw [Finset.set_biUnion_union, hs, ← DivisorWithCoeffs.coe_supp, hsuppH']
    ext x
    simp only [Closeds.coe_sup, Set.mem_union, Set.mem_preimage, SetLike.mem_coe]
    change π x ∈ G.supp ∨ x ∈ exceptionalSet π ∨ π x ∈ (QDivisor.toRDivisor B).supp ↔
      x ∈ exceptionalSet π ∨
        π x ∈ (QDivisor.toRDivisor (B + (r : ℚ)⁻¹ • Divisor.toQDivisor G)).supp
    rw [mem_supp_add_inv_smul_iff hB hG0 hr.ne']
    tauto
  · refine hsnc.of_support_subset ?_
    rw [support_sum_single]
    intro F hF
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_add, coeff_sum_single]
    rcases Finset.mem_union.mp hF with hF | hF
    · have hF' : H'.coeff F ≠ 0 := by
        rwa [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply] at hF
      rcases hH'01 F with h | ⟨h, hFS⟩
      · exact absurd h hF'
      · rw [if_neg hFS, h]
        norm_num
    · rw [if_pos (hsS₀ hF)]
      have := hH'0 F
      omega

/-- If the coefficients of `BW` are at most one and vanish along every component of `H'` (outside
`S`), and `H'` is reduced, then the coefficients of `BW + H' / r` are at most one. -/
private theorem coeff_add_le_one_of_coeff_eq {Y : Scheme.{u}} {BW B' : QDivisor Y}
    {H' : Divisor Y} {S : Finset (MMP.Mori.PrimeDivisor Y)} {r : ℕ} (hr : 0 < r)
    (hle1 : ∀ F, BW.coeff F ≤ 1) (hB'H : ∀ F, B'.coeff F = (r : ℚ)⁻¹ * H'.coeff F)
    (hH'01 : ∀ F, H'.coeff F = 0 ∨ (H'.coeff F = 1 ∧ F ∉ S))
    (hzero : ∀ F, F ∉ S → BW.coeff F = 0) (F : MMP.Mori.PrimeDivisor Y) :
    (BW + B').coeff F ≤ 1 := by
  rw [DivisorWithCoeffs.coeff_add, hB'H]
  rcases hH'01 F with h | ⟨h, hFS⟩
  · rw [h]
    simpa using hle1 F
  · rw [h, hzero F hFS]
    push_cast
    rw [zero_add, mul_one]
    exact inv_le_one_of_one_le₀ (by exact_mod_cast hr)

open Classical in
/-- **A general member keeps a pair log canonical** (Kollár–Mori, proof of 5.17). Let `(X, B)` be
an lc pair, `π : W ⟶ X` a log resolution of `(X, B)` with exceptional prime divisors `Ex`, and
`G` an effective Cartier divisor whose pull-back `H' = π^*G` is such that
`H' + ∑ π⁻¹_* B_j + ∑ E_i` is a reduced snc divisor. Then `(X, B + G / r)` is lc for every
integer `r > 0`. -/
private theorem isLogCanonicalPair_add_inv_smul [IsLocallyNoetherian W] [IsNormal W]
    {B : QDivisor X} (hBp : MMP.Fourfold.IsPair sX B)
    (hB : MMP.Intersection.IsLogCanonicalPair sX B) {π : W ⟶ X}
    (hπ : MMP.Fourfold.IsLogResolution sX B π) (Ex : Finset (MMP.Mori.PrimeDivisor W))
    (hEx : ∀ F : MMP.Mori.PrimeDivisor W, F ∈ Ex ↔ RationalMap.IsExceptional π.toRationalMap F)
    {G : Divisor X} (hG0 : 0 ≤ G) (hGc : G.IsCartier)
    {hBG : ∀ Z : irreducibleComponents W, π (componentGenericPoint W Z) ∉ G.supp}
    {H' : Divisor W} (hH' : G.IsPullback π hBG H')
    (hcoef : ∀ F : MMP.Mori.PrimeDivisor W,
      (H' + ∑ F ∈ (inverseTransformDivisor π B).support ∪ Ex,
        Finsupp.single F (1 : ℤ)).coeff F = 0 ∨
      (H' + ∑ F ∈ (inverseTransformDivisor π B).support ∪ Ex,
        Finsupp.single F (1 : ℤ)).coeff F = 1)
    (hsnc : DivisorWithCoeffs.IsSNC (π ≫ sX)
      (H' + ∑ F ∈ (inverseTransformDivisor π B).support ∪ Ex, Finsupp.single F (1 : ℤ)))
    {r : ℕ} (hr : 0 < r) :
    MMP.Intersection.IsLogCanonicalPair sX (B + (r : ℚ)⁻¹ • Divisor.toQDivisor G) := by
  haveI : IsAlgClosed k := hBp.isAlgClosed
  haveI : CharZero k := hBp.charZero
  obtain ⟨hXn, n, K, hK, hKq⟩ := hB.1
  have hPW : IsPairWith sX n K B := ⟨hXn, hK, hKq⟩
  set A : QDivisor X := (r : ℚ)⁻¹ • Divisor.toQDivisor G
  have hAq : A.IsQCartier := isQCartier_inv_smul_toQDivisor hr.ne' hGc
  have hbir : IsBirationalMorphism π := hπ.isBirationalMorphism
  have hW : IsNormalVariety k (π ≫ sX) :=
    (hπ.toIsSmoothResolution.isNormalVariety hXn).1
  haveI : IsIntegral W := hW.1.toIsIntegral
  haveI : IsDominant π := hbir.isDominant
  haveI : IsProper π := hπ.toIsSmoothResolution.isProper
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace π
  obtain ⟨BW, hBW, -⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hB.1 hK π hW hbir).1
  have hBA : ∀ Z : irreducibleComponents W, π (componentGenericPoint W Z) ∉ A.supp := fun Z => by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    exact MMP.Fourfold.genericPoint_notMem_supp A
  set B' := A.pullback hAq hBA
  have hB' : A.IsPullback π hBA B' := QDivisor.isPullback_pullback hAq hBA
  have hBW' : IsCrepantBoundary sX n K (B + A) π hW hbir (BW + B') := by
    intro F
    obtain ⟨-, hB'', hiff⟩ := IsPairWith.isDiscrepancy_add_smul_iff hPW hAq ⟨W, π, hW, hbir, F⟩
    convert ((hiff B' hB').1 (-BW.coeff F)).mpr (hBW F) using 1
    rw [DivisorWithCoeffs.coeff_add]
    ring
  have hpairBA : MMP.Fourfold.IsPair sX (B + A) :=
    ⟨hBp.isAlgClosed, hBp.charZero, ⟨hXn, n, K, hK, add_assoc _ B A ▸ hKq.add hAq⟩, fun P => by
      rw [DivisorWithCoeffs.coeff_add]
      exact add_nonneg (hBp.nonneg P) (inv_smul_toQDivisor_nonneg hG0 P)⟩
  set S₀ := (inverseTransformDivisor π B).support ∪ Ex
  have hH'0 : ∀ F, 0 ≤ H'.coeff F := fun F =>
    MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (V := ⊤) hGc (fun P _ => hG0 P) hH'
      F ⟨F.genericPoint, MMP.Flips.primeDivisor_genericPoint_mem_support F, trivial⟩
  have hH'01 : ∀ F, H'.coeff F = 0 ∨ (H'.coeff F = 1 ∧ F ∉ S₀) := fun F =>
    coeff_eq_zero_or_of_coeff_add_sum_single (hH'0 F) (hcoef F)
  obtain ⟨s, hs, hsS₀⟩ := exists_finset_subset_support_union hPW hπ hW hbir Ex hEx
  have hπ' : MMP.Fourfold.IsLogResolution sX (B + A) π :=
    ⟨⟨hπ.toIsSmoothResolution, hπ.isPureCodimOne_exceptionalSet,
      isSNCSubset_add_inv_smul hBp.nonneg hG0
        (MMP.Flips.supp_eq_preimage_supp_of_isPullback hGc hG0 hH') hs hsS₀ hH'0 hH'01 hsnc hr⟩,
      hπ.isProjectiveMorphism⟩
  exact (isLogCanonicalPair_iff_forall_coeff_le_one sX hpairBA hπ' hW hBW').mpr <|
    coeff_add_le_one_of_coeff_eq hr
      ((isLogCanonicalPair_iff_forall_coeff_le_one sX hBp hπ hW hBW).mp hB)
      (coeff_eq_inv_mul_of_isPullback hGc hH' hr hB') hH'01 fun _ =>
        coeff_eq_zero_of_notMem_union hPW hW hbir hBW Ex hEx

end LogCanonical

/-! ### The complement -/

/-- **An lc complement over the base.** Let `(X, B)` be a projective log canonical fourfold pair
over `ℂ` with canonical divisor `K`, let `D = K + B`, and let `f : X ⟶ Z` be a contraction
(`MMP.Fourfold.IsContraction`) onto a projective variety `Z` with `-D` `f`-ample. Then there is an
effective `ℚ`-Cartier `ℚ`-divisor `A` on `X` such that `D + A ∼_ℚ 0` over `Z` — that is,
`D + A ∼_ℚ G` where `𝒪_X(mG) ≅ f^* M` for some `m > 0` and some invertible `𝒪_Z`-module `M` —
and `(X, B + A)` is log canonical. -/
@[mmp "lem_oai4_c3_lc_complement_divisor"]
public theorem exists_isLogCanonicalPair_add_of_hasRelativelyAmpleMultiple_neg
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ)) (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hdim : topologicalKrullDim X = 4) {K : Divisor X} (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    {B : QDivisor X} (hB : MMP.Intersection.IsLogCanonicalPair sX B) {f : X ⟶ Z}
    (hf : IsContraction sX sZ f) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hamp : (-(Divisor.toQDivisor K + B)).HasRelativelyAmpleMultiple f) :
    ∃ A : QDivisor X, 0 ≤ A ∧ A.IsQCartier ∧
      (∃ (G : QDivisor X) (M : Z.Modules), Stacks.Ample.IsInvertibleModule Z M ∧
        (Divisor.toQDivisor K + B + A).QLinearlyEquivalent G ∧
        ∃ m : ℕ, 0 < m ∧ ∃ L : Divisor X, Divisor.toQDivisor L = (m : ℤ) • G ∧
          Nonempty (L.divisorialSheaf ≅ (Scheme.Modules.pullback f).obj M)) ∧
      MMP.Intersection.IsLogCanonicalPair sX (B + A) := by
  have hXn : IsNormalVariety ℂ sX := hf.isNormalVariety_source
  have hZn : IsNormalVariety ℂ sZ := hf.isNormalVariety_target
  haveI : IsIntegral Z := hZn.1.toIsIntegral
  haveI : IsNormal Z := hZn.2
  haveI : IsNoetherian Z := isNoetherian_of_isVariety hZn.1
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf.isProjectiveMorphism
  haveI : Surjective f := ⟨hf.surjective⟩
  obtain ⟨m, c, hm, hc, 𝓛, P, M, hMinv, ⟨eP⟩, h𝓛c, h𝓛, N, s, hs⟩ :=
    exists_free_system hf.comp_eq hZ hamp
  have hBp : MMP.Fourfold.IsPair sX B := ⟨inferInstance, inferInstance, hB.1, hB.2.1⟩
  obtain ⟨W, π, hπM, hπp⟩ := exists_isLogResolution hXn B
  obtain ⟨-, MX, hMXinv, hMXamp⟩ :=
    Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective sX hX.isProjective.isHQuasiProjective
  have hπ : MMP.Fourfold.IsLogResolution sX B π :=
    ⟨hπM, AlgebraicGeometry.isProjectiveMorphism_of_isProjective π MX
      (Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine sX MX hMXamp) hπp⟩
  obtain ⟨Ex, hEx⟩ := exists_finset_isExceptional hπM
  have hW : IsNormalVariety ℂ (π ≫ sX) := (hπM.toIsSmoothResolution.isNormalVariety hXn).1
  haveI : LocallyOfFiniteType (π ≫ sX) := hW.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (π ≫ sX)
  haveI : IsNormal W := hW.2
  obtain ⟨Q, hQ0, hQ⟩ := hπM.exists_polynomial_isSNC_pullback_zeroDivisor_add' hB.1 Ex hEx s hs
  obtain ⟨cc, hcc⟩ : ∃ cc : Fin (N + 1) → ℂ, MvPolynomial.eval cc Q ≠ 0 := by
    by_contra h
    push Not at h
    exact hQ0 (MvPolynomial.funext fun x => by simpa using h x)
  obtain ⟨hσ, hBσ, H', hH', hcoef, hsnc, -⟩ := hQ cc hcc
  set σ := ∑ i, scalarsToGlobalSections ℂ sX (cc i) • s i
  set G := 𝓛.zeroDivisor σ hσ with hGdef
  have hG0 : 0 ≤ G := Divisor.zeroDivisor_nonneg _ _ _
  have hGc : G.IsCartier := by
    rw [hGdef, Divisor.zeroDivisor_eq]
    exact (Divisor.isCartier_principalDivisor _).add h𝓛c
  set r := m * c
  have hr : 0 < r := Nat.mul_pos hm hc
  refine ⟨(r : ℚ)⁻¹ • Divisor.toQDivisor G, inv_smul_toQDivisor_nonneg hG0,
    isQCartier_inv_smul_toQDivisor hr.ne' hGc, ?_,
    isLogCanonicalPair_add_inv_smul hBp hB hπ Ex hEx hG0 hGc hH' hcoef hsnc hr⟩
  refine ⟨(m : ℚ)⁻¹ • Divisor.toQDivisor P, M, hMinv, ?_, m, hm, P,
    toQDivisor_eq_zsmul_inv_smul hm.ne' P, ⟨eP⟩⟩
  refine ⟨r, hr, (Divisor.isUnit_sectionToRationalFunctions hσ).unit, ?_⟩
  rw [hGdef, Divisor.zeroDivisor_eq, map_add]
  exact zsmul_add_inv_smul_sub_inv_smul_eq hm hc h𝓛

end MMP.Fourfold
