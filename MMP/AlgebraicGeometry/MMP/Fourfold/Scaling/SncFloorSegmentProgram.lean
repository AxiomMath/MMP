        · have hK' := ((hstp i).eq_flipTransform_K).resolve_left
            fun ⟨_, _, hiso⟩ => hflip.not_isIso_flip hiso
          obtain ⟨hlog, hsm⟩ := IsRealFlipStep.flipTransform_logCanonicalDivisor hflip
          rw [hj i hi] at hD'
          have hN : flipTransform (stp i).f (stp i).fp
