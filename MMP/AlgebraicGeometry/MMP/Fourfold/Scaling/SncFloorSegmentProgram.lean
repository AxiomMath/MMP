  obtain ⟨mW, KW, hKW, hpK, hqK⟩ := hres.exists_canonicalDivisor
  obtain ⟨mY, hKY⟩ := hY.isCanonicalDivisor_model
  have hKWq : KW.IsCanonicalDivisor (q₀ ≫ sY) mW := by rw [hres.comp_eq_right]; exact hKW
  have hmm : mY = mW := by
    have h1 := hKY.topologicalKrullDim_eq
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q₀ ≫ sY) hq₀b,
      hKWq.topologicalKrullDim_eq] at h1
    exact_mod_cast h1.symm
  subst hmm
  obtain ⟨ωY, hωY0, hωY, hωYW⟩ :=
    MMP.Positivity.exists_divisorOfForm_eq_of_transformDivisor_eq hYn hW₀nq hq₀b hKY hKWq hqK
  choose PWf hPWf using fun P : MMP.Mori.PrimeDivisor X =>
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hXn hW₀np hp₀b P
  have hPWinj : Function.Injective PWf := fun P P' h =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
