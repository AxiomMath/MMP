    (fun i hi => by
      rcases (hstp i).divisorial_or_realFlip with ⟨-, hex, hiso⟩ | hfl
      · exact Or.inl ⟨(hstp i).isNegativeExtremalContraction.isContraction, hex, hiso, hanti i hi⟩
      · obtain ⟨hflip, ⟨_, _, D, -, hD'⟩, -⟩ := hfl
        refine Or.inr ⟨hflip.isSmall, hflip.isSmall_flip, ?_, ?_⟩
        · exact ((hstp i).divisorial_or_flip.resolve_left
