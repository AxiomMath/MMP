  set u := (max lam' (1 - ε₁) + 1) / 2 with hudef
  have hmax : max lam' (1 - ε₁) < 1 := max_lt hj' (by linarith)
  have hlu : lam' < u := by
    have := le_max_left lam' (1 - ε₁)
    rw [hudef]; linarith
  have hu1 : u < 1 := by rw [hudef]; linarith
  have h1u : 1 - u < ε₁ := by
