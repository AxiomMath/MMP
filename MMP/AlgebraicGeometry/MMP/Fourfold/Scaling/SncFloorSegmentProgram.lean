/-- Scaling a presentation of an intersection number: `(c D) · C = c (D · C)`. -/
private theorem isRIntersectionNumber_smul {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {D : RDivisor X} {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} {C : ProperCurve sX} {x : ℝ} (c : ℝ)
    (h : IsRIntersectionNumber ℂ sX D r L C x) :
    IsRIntersectionNumber ℂ sX (c • D) (c • r) L C (c * x) := by
  obtain ⟨hL, d, hD, hd, hx⟩ := h
  refine ⟨hL, d, ?_, hd, ?_⟩
  · rw [hD, Finset.smul_sum]
    simp [smul_smul]
  · rw [hx, Finset.mul_sum]
    simp [mul_assoc]

private theorem isCartierCombination_smul {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    {D : RDivisor X} (c : ℝ) (h : IsCartierCombination D) : IsCartierCombination (c • D) := by
  obtain ⟨m, r, L, hL, hD⟩ := h
  refine ⟨m, c • r, L, hL, ?_⟩
  rw [hD, Finset.smul_sum]
  simp [smul_smul]

/-- Numerical equivalence over a base is preserved by a nonzero real rescaling. -/
private theorem isNumericallyEquivalentOver_smul {X Y : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {f : X ⟶ Y}
    {N₁ N₂ : RDivisor X} {c : ℝ} (hc : c ≠ 0)
    (h : IsNumericallyEquivalentOver ℂ sX f N₁ N₂) :
    IsNumericallyEquivalentOver ℂ sX f (c • N₁) (c • N₂) := by
  obtain ⟨h₁, h₂, h⟩ := h
  refine ⟨isCartierCombination_smul c h₁, isCartierCombination_smul c h₂,
    fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have e₁ := isRIntersectionNumber_smul c⁻¹ hx₁
  have e₂ := isRIntersectionNumber_smul c⁻¹ hx₂
  rw [smul_smul, inv_mul_cancel₀ hc, one_smul] at e₁ e₂
  have := h C hC _ _ _ _ _ _ _ _ e₁ e₂
  exact mul_left_cancel₀ (inv_ne_zero hc) this

section Numerical

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X]

/-- An `f`-ample Cartier divisor has positive degree on every proper curve contracted by `f`. -/
private theorem degreeOn_pos_of_isRelativelyAmpleCartier {Z : Scheme.{0}} (f : X ⟶ Z)
    {D : Divisor X} (hD : IsRelativelyAmpleCartier f D) (hDc : D.IsCartier) (C : ProperCurve sX)
    (hC : C.IsContractedBy f) : 0 < D.degreeOn ℂ sX C.ι C.dim_le hDc := by
  obtain ⟨hD', hamp⟩ := hD
  haveI := hD'.isInvertibleModule_divisorialSheaf
  have hrel : MMP.Mori.IsRelativelyAmple f D.divisorialSheaf := fun y => by
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
    exact ⟨V, hV, hyV, hamp V hV⟩
  exact MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _ hrel C hC

/-- A divisor whose negative is `f`-ample has negative intersection number, computed with any
presentation, on every proper curve contracted by `f`. -/
private theorem isRIntersectionNumber_neg_of_isRelativelyAntiAmple {W : Scheme.{0}}
    (f : X ⟶ W) {L : RDivisor X} (hL : IsRelativelyAntiAmple f L) (Γ : ProperCurve sX)
    (hΓ : Γ.IsContractedBy f) {m : ℕ} (r : Fin m → ℝ) (Ls : Fin m → Divisor X) (x : ℝ)
    (hx : IsRIntersectionNumber ℂ sX L r Ls Γ x) : x < 0 := by
  obtain ⟨m', a, A, hm, ha, hA, hLeq⟩ := hL
  have hAc : ∀ j, (A j).IsCartier := fun j => (hA j).1
  have hLeq' : L = ∑ j, (-a j) • Divisor.toRDivisor (A j) := by
    have hL' : L = -(-L) := (neg_neg L).symm
    rw [hL', hLeq]
    simp [neg_smul, Finset.sum_neg_distrib]
  have hy := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ (fun j => -a j) A hAc
  rw [← hLeq'] at hy
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx hy]
  have hpos : ∀ j, (0 : ℝ) < (A j).degreeOn ℂ sX Γ.ι Γ.dim_le (hAc j) := fun j => by
    exact_mod_cast degreeOn_pos_of_isRelativelyAmpleCartier f (hA j) (hAc j) Γ hΓ
  have hsum : 0 < ∑ j, a j * ((A j).degreeOn ℂ sX Γ.ι Γ.dim_le (hAc j) : ℝ) :=
    Finset.sum_pos (fun j _ => mul_pos (ha j) (hpos j)) ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  simp only [neg_mul, Finset.sum_neg_distrib]
  linarith

/-- If `ρ(X/W) = 1`, some proper curve is contracted by `f`. -/
private theorem exists_isContractedBy_of_relativePicardNumber_eq_one {W : Scheme.{0}}
    (f : X ⟶ W) (hρ : MMP.Flips.relativePicardNumber sX f = 1) :
    ∃ C : ProperCurve sX, C.IsContractedBy f := by
  have hfin : Module.finrank ℝ (MMP.Flips.RelativeNumericalDivisorClasses sX f) = 1 :=
    Module.finrank_eq_of_rank_eq (by rw [Cardinal.toENat_eq_one.mp hρ]; rfl)
  haveI := Module.finite_of_finrank_eq_succ hfin
  obtain ⟨v, hv⟩ :=
    (Module.finrank_pos_iff_exists_ne_zero (R := ℝ)).mp (by rw [hfin]; exact one_pos)
  obtain ⟨δ, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  rw [Ne, Submodule.Quotient.mk_eq_zero, mem_relativeNumericallyTrivialDivisors] at hv
  push Not at hv
  obtain ⟨C, hC, -⟩ := hv
  exact ⟨C, hC⟩

/-- The value of a numerically `f`-trivial divisor on a contracted curve is zero. -/
private theorem IsNumericallyTrivialOver.eq_zero {W : Scheme.{0}} {f : X ⟶ W} {N : RDivisor X}
    (h : IsNumericallyTrivialOver ℂ sX f N) (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f)
    {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ)
    (hx : IsRIntersectionNumber ℂ sX N r L Γ x) : x = 0 := by
  have h0 : IsRIntersectionNumber ℂ sX (0 : RDivisor X) (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) Γ 0 := by
    simpa using MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) (fun j => j.elim0)
  exact h.2.2 Γ hΓ _ _ _ _ _ _ _ _ hx h0

/-- A Cartier combination whose every value on the contracted curves is zero is numerically
trivial. -/
private theorem isNumericallyTrivialOver_of_forall {W : Scheme.{0}} {f : X ⟶ W} {N : RDivisor X}
    (hN : IsCartierCombination N)
    (h : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f → ∀ (m : ℕ) (r : Fin m → ℝ)
      (L : Fin m → Divisor X) (x : ℝ), IsRIntersectionNumber ℂ sX N r L Γ x → x = 0) :
    IsNumericallyTrivialOver ℂ sX f N := by
  refine ⟨hN, ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
    fun Γ hΓ m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have h00 : IsRIntersectionNumber ℂ sX (0 : RDivisor X) (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) Γ 0 := by
    simpa using MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ (Fin.elim0 : Fin 0 → ℝ)
      (Fin.elim0 : Fin 0 → Divisor X) (fun j => j.elim0)
  rw [h Γ hΓ _ _ _ _ hx₁, (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx₂ h00]

/-- Every value of a relatively nef divisor on a contracted curve is nonnegative. -/
private theorem IsRelativelyNef.nonneg {W : Scheme.{0}} {f : X ⟶ W} {D : RDivisor X}
    (h : IsRelativelyNef ℂ sX f D) (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX D r L Γ x) : 0 ≤ x := by
  obtain ⟨m', r', L', hL', hD', hn⟩ := h
  have e := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r' L' hL'
  rw [← hD'] at e
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx e]
  exact hn Γ hΓ _ e

/-- The negative of a value is a value of the negative divisor. -/
private theorem isRIntersectionNumber_neg {D : RDivisor X} {Γ : ProperCurve sX} {m : ℕ}
    {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX D r L Γ x) :
    ∃ (m' : ℕ) (r' : Fin m' → ℝ) (L' : Fin m' → Divisor X),
      IsRIntersectionNumber ℂ sX (-D) r' L' Γ (-x) := by
  have e := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ (-1) 0 hx hx
  rw [neg_one_smul, zero_smul, add_zero, zero_mul, add_zero, neg_one_mul] at e
  exact ⟨_, _, _, e⟩

/-- A divisor which is nef together with its negative is numerically trivial. -/
private theorem isNumericallyTrivialOver_of_isRelativelyNef_of_neg {W : Scheme.{0}}
    {f : X ⟶ W} {D : RDivisor X} (hD : IsCartierCombination D) (h₁ : IsRelativelyNef ℂ sX f D)
    (h₂ : IsRelativelyNef ℂ sX f (-D)) : IsNumericallyTrivialOver ℂ sX f D := by
  refine isNumericallyTrivialOver_of_forall hD fun Γ hΓ m r L x hx => ?_
  obtain ⟨m', r', L', hx'⟩ := isRIntersectionNumber_neg hx
  have a := IsRelativelyNef.nonneg h₁ Γ hΓ hx
  have b := IsRelativelyNef.nonneg h₂ Γ hΓ hx'
  linarith

/-- A numerically trivial divisor is nef. -/
private theorem IsNumericallyTrivialOver.isRelativelyNef {W : Scheme.{0}} {f : X ⟶ W}
    {D : RDivisor X} (h : IsNumericallyTrivialOver ℂ sX f D) : IsRelativelyNef ℂ sX f D := by
  obtain ⟨m, r, L, hL, hD⟩ := h.1
  exact ⟨m, r, L, hL, hD, fun Γ hΓ x hx => (IsNumericallyTrivialOver.eq_zero h Γ hΓ _ _ _ hx).ge⟩

/-- The negative of a numerically trivial divisor is numerically trivial. -/
private theorem IsNumericallyTrivialOver.neg' {W : Scheme.{0}} {f : X ⟶ W}
    {D : RDivisor X} (h : IsNumericallyTrivialOver ℂ sX f D) :
    IsNumericallyTrivialOver ℂ sX f (-D) := by
  obtain ⟨m, r, L, hL, hD⟩ := h.1
  refine isNumericallyTrivialOver_of_forall ⟨m, -r, L, hL, by rw [hD]; simp [neg_smul]⟩
    fun Γ hΓ m' r' L' x hx => ?_
  obtain ⟨m'', r'', L'', hx'⟩ := isRIntersectionNumber_neg hx
  rw [neg_neg] at hx'
  linarith [IsNumericallyTrivialOver.eq_zero h Γ hΓ _ _ _ hx']

/-- `N₁ ≡_f N₂` makes `N₁ - N₂` numerically trivial. -/
private theorem IsNumericallyEquivalentOver.sub_isNumericallyTrivialOver {W : Scheme.{0}}
    {f : X ⟶ W} {N₁ N₂ : RDivisor X} (h : IsNumericallyEquivalentOver ℂ sX f N₁ N₂) :
    IsNumericallyTrivialOver ℂ sX f (N₁ - N₂) := by
  obtain ⟨⟨m₁, r₁, L₁, hL₁, hN₁⟩, ⟨m₂, r₂, L₂, hL₂, hN₂⟩, heq⟩ := h
  replace hN₁ : N₁ = ∑ j, r₁ j • Divisor.toRDivisor (L₁ j) := hN₁
  replace hN₂ : N₂ = ∑ j, r₂ j • Divisor.toRDivisor (L₂ j) := hN₂
  refine isNumericallyTrivialOver_of_forall ⟨m₁ + m₂, Fin.append r₁ (-r₂), Fin.append L₁ L₂,
    Fin.addCases (fun i => by simpa using hL₁ i) (fun j => by simpa using hL₂ j), ?_⟩
    fun Γ hΓ m r L x hx => ?_
  · rw [Fin.sum_univ_add, hN₁, hN₂]
    simp [sub_eq_add_neg, neg_smul, Finset.sum_neg_distrib]
    rfl
  · have a₁ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r₁ L₁ hL₁
    have a₂ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r₂ L₂ hL₂
    rw [← hN₁] at a₁
    rw [← hN₂] at a₂
    have e := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ 1 (-1) a₁ a₂
    rw [one_smul, neg_one_smul, ← sub_eq_add_neg] at e
    rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx e,
      heq Γ hΓ _ _ _ _ _ _ _ _ a₁ a₂]
    ring

/-- If `N₁ - N₂` is numerically trivial and `N₂` is a Cartier combination, then `N₁ ≡_f N₂`. -/
private theorem isNumericallyEquivalentOver_of_sub {W : Scheme.{0}} {f : X ⟶ W}
    {N₁ N₂ : RDivisor X} (h₂ : IsCartierCombination N₂)
    (h : IsNumericallyTrivialOver ℂ sX f (N₁ - N₂)) :
    IsNumericallyEquivalentOver ℂ sX f N₁ N₂ := by
  obtain ⟨m, r, L, hL, hD⟩ := h.1
  obtain ⟨m₂, r₂, L₂, hL₂, hN₂⟩ := h₂
  replace hD : N₁ - N₂ = ∑ j, r j • Divisor.toRDivisor (L j) := hD
  replace hN₂ : N₂ = ∑ j, r₂ j • Divisor.toRDivisor (L₂ j) := hN₂
  have hN₁ : N₁ = ∑ j, Fin.append r r₂ j • Divisor.toRDivisor (Fin.append L L₂ j) := by
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
    rw [← hD, ← hN₂, sub_add_cancel]
  refine ⟨⟨m + m₂, Fin.append r r₂, Fin.append L L₂,
    Fin.addCases (fun i => by simpa using hL i) (fun j => by simpa using hL₂ j), hN₁⟩,
    ⟨m₂, r₂, L₂, hL₂, hN₂⟩, fun Γ hΓ m₁ r₁' L₁' x₁ m₂' r₂' L₂' x₂ hx₁ hx₂ => ?_⟩
  have a := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r L hL
  rw [← hD] at a
  have e := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ 1 1 a hx₂
  rw [one_smul, one_smul, sub_add_cancel] at e
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx₁ e,
    IsNumericallyTrivialOver.eq_zero h Γ hΓ _ _ _ a]
  ring

/-- Below the nef threshold `l > 0` of an extremal step, the adjoint `K + B + u C` is anti-ample
for every real `u < l`: it is a negative combination of the anti-ample `K + B` and the numerically
trivial `K + B + l C`. -/
private theorem isRelativelyAntiAmple_of_lt {W : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    {K : Divisor X} {B C : RDivisor X} {f : X ⟶ W} {l u : ℝ}
    (hf : IsNegativeExtremalContraction ℂ sX sW (logCanonicalDivisor K B) f)
    (hfp : IsProjective f)
    (htriv : IsNumericallyTrivialOver ℂ sX f (logCanonicalDivisor K (B + l • C)))
    (hl : 0 < l) (hul : u < l) :
    IsRelativelyAntiAmple f (logCanonicalDivisor K (B + u • C)) := by
  set s := u / l with hs
  have hs1 : s < 1 := (div_lt_one hl).mpr hul
  have hD : -logCanonicalDivisor K (B + u • C) =
      (-(1 - s)) • logCanonicalDivisor K B + (-s) • logCanonicalDivisor K (B + l • C) := by
    have hu : u = s * l := by rw [hs, div_mul_cancel₀ _ hl.ne']
    simp only [logCanonicalDivisor]
    rw [hu]
    module
  obtain ⟨m₁, r₁, L₁, hL₁, hE₁⟩ := hf.isCartierCombination
  obtain ⟨m₂, r₂, L₂, hL₂, hE₂⟩ := htriv.1
  have hE₁' : logCanonicalDivisor K B = ∑ j, r₁ j • Divisor.toRDivisor (L₁ j) := hE₁
  have hE₂' : logCanonicalDivisor K (B + l • C) = ∑ j, r₂ j • Divisor.toRDivisor (L₂ j) := hE₂
  -- the value of `-(K + B + u C)` on a contracted curve, for the combined presentation
  have hval : ∀ Γ : ProperCurve sX, Γ.IsContractedBy f → ∃ x, 0 < x ∧
      IsRIntersectionNumber ℂ sX (-logCanonicalDivisor K (B + u • C))
        (Fin.append ((-(1 - s)) • r₁) ((-s) • r₂)) (Fin.append L₁ L₂) Γ x := by
    intro Γ hΓ
    have e₁ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r₁ L₁ hL₁
    have e₂ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r₂ L₂ hL₂
    rw [← hE₁'] at e₁
    rw [← hE₂'] at e₂
    have h₁ := isRIntersectionNumber_neg_of_isRelativelyAntiAmple f hf.isRelativelyAntiAmple Γ hΓ
      _ _ _ e₁
    have h₂ := IsNumericallyTrivialOver.eq_zero htriv Γ hΓ _ _ _ e₂
    have e := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ (-(1 - s)) (-s) e₁ e₂
    rw [← hD] at e
    refine ⟨_, ?_, e⟩
    rw [h₂, mul_zero, add_zero]
    exact mul_pos_of_neg_of_neg (by linarith) h₁
  obtain ⟨Γ₀, hΓ₀⟩ := exists_isContractedBy_of_relativePicardNumber_eq_one f
    hf.relativePicardNumber_eq_one
  obtain ⟨x₀, hx₀, e₀⟩ := hval Γ₀ hΓ₀
  obtain ⟨hLc, -, hpres, -, -⟩ := id e₀
  have hCc : IsCartierCombination (-logCanonicalDivisor K (B + u • C)) :=
    ⟨_, _, _, hLc, hpres⟩
  refine isRelativelyAmple_of_isRelativelyNef_of_relativePicardNumber_eq_one sX sW
    hf.isNormalVariety_source hf.isNormalVariety_target f hfp hf.isContraction.comp_eq
    hf.relativePicardNumber_eq_one _ hCc ⟨_, _, _, hLc, hpres, fun Γ hΓ x hx => ?_⟩ ?_
  · obtain ⟨y, hy, ey⟩ := hval Γ hΓ
    rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx ey]
    exact hy.le
  · intro htr
    exact hx₀.ne' (IsNumericallyTrivialOver.eq_zero htr Γ₀ hΓ₀ _ _ _ e₀)

/-- A sum of divisors nef over `g` is nef over `g`. -/
private theorem IsRelativelyNef.add' {Y : Scheme.{0}} {g : X ⟶ Y} {D₁ D₂ : RDivisor X}
    (h₁ : IsRelativelyNef ℂ sX g D₁) (h₂ : IsRelativelyNef ℂ sX g D₂) :
    IsRelativelyNef ℂ sX g (D₁ + D₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, hD₁, hn₁⟩ := h₁
  obtain ⟨m₂, r₂, L₂, hL₂, hD₂, hn₂⟩ := h₂
  refine ⟨m₁ + m₂, Fin.append r₁ r₂, Fin.append L₁ L₂,
    fun j => Fin.addCases (motive := fun j => (Fin.append L₁ L₂ j).IsCartier)
      (fun i => by simpa using hL₁ i) (fun i => by simpa using hL₂ i) j, ?_,
    fun C hC x hx => ?_⟩
  · rw [Fin.sum_univ_add, hD₁, hD₂]
    simp only [Fin.append_left, Fin.append_right]
  · have e₁ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX C r₁ L₁ hL₁
    have e₂ := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX C r₂ L₂ hL₂
    rw [← hD₁] at e₁
    rw [← hD₂] at e₂
    have hsum := (IsRIntersectionNumber.eq_and_linear ℂ sX C).2 D₁ D₂ r₁ L₁ r₂ L₂ _ _ 1 1 e₁ e₂
    simp only [one_smul, one_mul] at hsum
    rw [(IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ _ _ _ _ _ _ hx hsum]
    exact add_nonneg (hn₁ C hC _ e₁) (hn₂ C hC _ e₂)

/-- A nonnegative multiple of a divisor nef over `g` is nef over `g`. -/
private theorem IsRelativelyNef.smul' {Y : Scheme.{0}} {g : X ⟶ Y} {D : RDivisor X}
    (h : IsRelativelyNef ℂ sX g D) {a : ℝ} (ha : 0 ≤ a) : IsRelativelyNef ℂ sX g (a • D) := by
  obtain ⟨m, r, L, hL, hD, hn⟩ := h
  have hD' : a • D = ∑ j, (a • r) j • Divisor.toRDivisor (L j) := by
    rw [hD, Finset.smul_sum]
    simp only [Pi.smul_apply, smul_smul, smul_eq_mul]
  refine ⟨m, a • r, L, hL, hD', fun C hC x hx => ?_⟩
  have e := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX C (a • r) L hL
  rw [← hD'] at e
  have e0 := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX C r L hL
  rw [← hD] at e0
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ _ _ _ _ _ _ hx e]
  have h0 := hn C hC _ e0
  simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum]
  exact mul_nonneg ha h0

/-- Nefness of the adjoints `K + B + u C` is convex in the level `u`. -/
private theorem isRelativelyNef_of_mem_Icc {Y : Scheme.{0}} {g : X ⟶ Y} {K : Divisor X}
    {B C : RDivisor X} {a b u : ℝ} (hu : u ∈ Set.Icc a b)
    (ha : IsRelativelyNef ℂ sX g (logCanonicalDivisor K (B + a • C)))
    (hb : IsRelativelyNef ℂ sX g (logCanonicalDivisor K (B + b • C))) :
    IsRelativelyNef ℂ sX g (logCanonicalDivisor K (B + u • C)) := by
  obtain ⟨hau, hub⟩ := hu
  rcases (hau.trans hub).eq_or_lt with hab | hab
  · obtain rfl : u = a := le_antisymm (hab ▸ hub) hau
    exact ha
  have hba : 0 < b - a := sub_pos.mpr hab
  set s := (u - a) / (b - a) with hs
  have hs0 : 0 ≤ s := div_nonneg (sub_nonneg.mpr hau) hba.le
  have hs1 : s ≤ 1 := (div_le_one hba).mpr (by linarith)
  have hu' : u = (1 - s) * a + s * b := by
    rw [hs]; field_simp; ring
  have e : logCanonicalDivisor K (B + u • C) =
      (1 - s) • logCanonicalDivisor K (B + a • C) + s • logCanonicalDivisor K (B + b • C) := by
    simp only [logCanonicalDivisor]
    rw [hu']
    module
  rw [e]
  exact IsRelativelyNef.add' (IsRelativelyNef.smul' ha (by linarith))
    (IsRelativelyNef.smul' hb hs0)

/-- **The nef dlt model of every level.** In a program with scaling of `C` from `Y = Y_0` with nef
thresholds `t ≥ λ_0 ≥ ⋯ ≥ λ_n = 0`, in which `K_j + B_j + u C_j` is dlt for `u ∈ [λ_0, t]` if
`j = 0` and for `u ∈ [λ_j, λ_{j-1})` if `j > 0`, the upper level `K_{j} + B_{j} + λ_{j-1} C_{j}` is
nef after every step, and every step is anti-ample for the levels below its threshold, the model
`Y_j` with `j` least such that `λ_j ≤ u` is a nef dlt model for the level `u`. -/
private theorem forall_mem_Icc_exists_nef_dltModel
    {Y Z : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sY : Y ⟶ Spec (.of ℂ)} {πY : Y ⟶ Z} {KY : Divisor Y} {BY CY : RDivisor Y} {t : ℝ}
    {n : ℕ} {M : ℕ → Scheme.{0}} [∀ i, IsIntegral (M i)] [∀ i, CompactSpace (M i)]
    [∀ i, IsLocallyNoetherian (M i)] [∀ i, IsNormal (M i)]
    {sM : ∀ i, M i ⟶ Spec (.of ℂ)} {πM : ∀ i, M i ⟶ Z} {KM : ∀ i, Divisor (M i)}
    {BM CM : ∀ i, RDivisor (M i)} {lam : ℕ → ℝ} {W : ℕ → Scheme.{0}}
    {f : ∀ i, modelSeq Y M i ⟶ W i}
    (hnef : ∀ i ≤ n, IsRelativelyNef ℂ (modelStr sY sM i) (modelMap πY πM i)
      (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i + lam i • divisorSeq CY CM i)))
    (hlamn : lam n = 0)
    (hnef₀ : IsRelativelyNef ℂ sY πY (logCanonicalDivisor KY (BY + t • CY)))
    (hdlt₀ : ∀ u ∈ Set.Icc (lam 0) t, IsRealDltPair sY (BY + u • CY))
    (hup : ∀ i < n, IsRelativelyNef ℂ (sM i) (πM i)
      (logCanonicalDivisor (KM i) (BM i + lam i • CM i)))
    (hdlt : ∀ i < n, ∀ u ∈ Set.Ico (lam (i + 1)) (lam i), IsRealDltPair (sM i) (BM i + u • CM i))
    (hanti : ∀ i < n, ∀ u : ℝ, 0 ≤ u → u < lam i →
      IsRelativelyAntiAmple (f i) (logCanonicalDivisor (divisorSeq KY KM i)
        (divisorSeq BY BM i + u • divisorSeq CY CM i))) :
    ∀ u ∈ Set.Icc (0 : ℝ) t, ∃ j ≤ n,
      IsRealDltPair (modelStr sY sM j) (divisorSeq BY BM j + u • divisorSeq CY CM j) ∧
      IsRelativelyNef ℂ (modelStr sY sM j) (modelMap πY πM j)
        (logCanonicalDivisor (divisorSeq KY KM j)
          (divisorSeq BY BM j + u • divisorSeq CY CM j)) ∧
      ∀ i < j,
        IsRelativelyAntiAmple (f i) (logCanonicalDivisor (divisorSeq KY KM i)
          (divisorSeq BY BM i + u • divisorSeq CY CM i)) ∨
        IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + u • divisorSeq CY CM i)) := by
  classical
  rintro u ⟨hu0, hut⟩
  have hex : ∃ j, lam j ≤ u := ⟨n, hlamn.symm ▸ hu0⟩
  obtain ⟨j, hjn, hj, hlt⟩ : ∃ j ≤ n, lam j ≤ u ∧ ∀ i < j, u < lam i :=
    ⟨Nat.find hex, Nat.find_min' hex (hlamn.symm ▸ hu0), Nat.find_spec hex,
      fun i hi => lt_of_not_ge (Nat.find_min hex hi)⟩
  refine ⟨j, hjn, ?_, ?_, fun i hi => Or.inl (hanti i (by omega) u hu0 (hlt i hi))⟩
  · cases j with
    | zero => exact hdlt₀ u ⟨hj, hut⟩
    | succ k => exact hdlt k (by omega) u ⟨hj, hlt k (by omega)⟩
  · cases j with
    | zero => exact isRelativelyNef_of_mem_Icc ⟨hj, hut⟩ (hnef 0 (Nat.zero_le _)) hnef₀
    | succ k =>
      exact isRelativelyNef_of_mem_Icc ⟨hj, (hlt k (by omega)).le⟩ (hnef (k + 1) hjn)
        (hup k (by omega))

end Numerical

/-- An open subscheme contained in the smooth locus of `s` is smooth. -/
private theorem isSmoothScheme_ι_of_le_smoothLocus {Y : Scheme.{0}} {k : Type} [Field k]
    {s : Y ⟶ Spec (.of k)} {V : Y.Opens} (hV : V ≤ smoothLocus s) :
    IsSmoothScheme (V.ι ≫ s) := by
  rw [IsSmoothScheme, eq_top_iff]
  intro x _
  obtain ⟨W, hxW, hW⟩ := mem_smoothLocus_iff.1 (hV x.2 : V.ι x ∈ smoothLocus s)
  refine mem_smoothLocus_iff.2 ⟨V.ι ⁻¹ᵁ W, hxW, ?_⟩
  have : Smooth (W.ι ≫ s) := hW
  rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  infer_instance

/-- A smooth open subscheme lies in the smooth locus, for `s` locally of finite type over a
field. -/
private theorem le_smoothLocus_of_isSmoothScheme_ι {Y : Scheme.{0}} {k : Type} [Field k]
    {s : Y ⟶ Spec (.of k)} [LocallyOfFiniteType s] {V : Y.Opens}
    (hV : IsSmoothScheme (V.ι ≫ s)) : V ≤ smoothLocus s := by
  have : LocallyOfFinitePresentation (V.ι ≫ s) := inferInstance
  exact le_smoothLocus _ ((isSmoothScheme_iff _).mp hV)

section PrimeDivisorDiscrepancy

variable {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
  {sY : Y ⟶ Spec (.of ℂ)}

/-- **The log discrepancy of a prime divisor.** A prime divisor `P` of `Y`, as the divisor
`(Y, 𝟙, P)` over `Y`, has log discrepancy `1 - coeff_P D` for a real boundary `D` with `K_Y + D`
`ℝ`-Cartier. -/
private theorem isLogDiscrepancy_ofPrimeDivisor (hX : IsNormalVariety ℂ sY) {D : RDivisor Y}
    {n : ℕ} {K : Divisor Y} (hK : K.IsCanonicalDivisor sY n)
    (hKD : RDivisor.IsRCartier (Divisor.toRDivisor K + D)) (P : MMP.Mori.PrimeDivisor Y) :
    MMP.Intersection.IsLogDiscrepancy sY n D (DivisorOver.ofPrimeDivisor ℂ hX P)
      (1 - D.coeff P) := by
  obtain ⟨ω, hω, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, r, C, hC, hcoef⟩ := hKD
  have hn := hK.topologicalKrullDim_eq
  refine ⟨hX, inferInstanceAs (IsProper (𝟙 Y)), ω, hω, ⟨K, hK, fun Γ => (hωK Γ).symm⟩, m, r, C,
    C, hC, fun Γ => ?_, fun i => ⟨_, divisor_isPullback_id (C i)
      (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp (𝟙 Y) (C i))⟩, ?_⟩
  · rw [← hcoef Γ, hωK Γ]
    simp [Divisor.toRDivisor]
  · have e := DivisorOver.ordPullback_ofPrimeDivisor hX hn P ω
    have e2 := hcoef P
    simp only [DivisorWithCoeffs.coeff_add] at e2
    change 1 - D.coeff P = 1 + ((DivisorOver.ofPrimeDivisor ℂ hX P).ordPullback ω : ℝ) -
      ∑ i, r i * (C i).coeff P
    have hK' : (Divisor.toRDivisor K).coeff P = (K.coeff P : ℝ) := by simp [Divisor.toRDivisor]
    rw [e, hωK P, ← e2, hK']
    ring

/-- The coefficients of the boundary of a real lc pair are at most one. -/
private theorem IsRealLcPair.coeff_le_one {D : RDivisor Y} (h : IsRealLcPair sY D)
    (P : MMP.Mori.PrimeDivisor Y) : D.coeff P ≤ 1 := by
  obtain ⟨hX, -, ⟨n, K, hK, hKD⟩, hlc⟩ := h
  have := hlc n _ _ (isLogDiscrepancy_ofPrimeDivisor hX hK hKD P)
  linarith

/-- On a `ℚ`-factorial variety an effective `ℝ`-divisor `C` is a positive combination
`∑ q_j M_j` of effective Cartier divisors, the `M_j` being multiples of the components of `C`
and covering its support. -/
private theorem exists_eq_sum_smul_of_isQFactorial (hQ : IsQFactorial sY) {C : RDivisor Y}
    (hC : ∀ P, 0 ≤ C.coeff P) :
    ∃ (k : ℕ) (q : Fin k → ℝ) (M : Fin k → Divisor Y), (∀ j, 0 < q j) ∧ (∀ j, (M j).IsCartier) ∧
      (∀ j, DivisorWithCoeffs.IsEffective (M j)) ∧
      (∀ Γ, C.coeff Γ = ∑ j, q j * ((M j).coeff Γ : ℝ)) ∧
      ∀ y ∈ (C.supp : Set Y), ∃ j, y ∈ ((M j).supp : Set Y) := by
  classical
  choose m hm hmc using fun P : MMP.Mori.PrimeDivisor Y => hQ.2 (Finsupp.single P 1)
  set S := C.support
  set e := S.equivFin
  set P : Fin S.card → MMP.Mori.PrimeDivisor Y := fun j => (e.symm j : MMP.Mori.PrimeDivisor Y)
  have hPS : ∀ j, P j ∈ S := fun j => (e.symm j).2
  have hCpos : ∀ j, 0 < C.coeff (P j) := fun j =>
    lt_of_le_of_ne (hC _) (Ne.symm (Finsupp.mem_support_iff.mp (hPS j)))
  set M : Fin S.card → Divisor Y := fun j => (m (P j) : ℤ) • Finsupp.single (P j) 1 with hMdef
  have hMcoeffZ : ∀ j Γ, DivisorWithCoeffs.coeff (M j) Γ = (m (P j) : ℤ) * (if P j = Γ then 1 else 0) :=
    fun j Γ => by simp [hMdef, DivisorWithCoeffs.coeff, Finsupp.single_apply]
  have hMcoeff : ∀ j Γ, ((DivisorWithCoeffs.coeff (M j) Γ : ℤ) : ℝ) =
      (m (P j) : ℝ) * (if P j = Γ then 1 else 0) := fun j Γ => by
    rw [hMcoeffZ]; push_cast; rfl
  refine ⟨S.card, fun j => C.coeff (P j) / m (P j), M, fun j => div_pos (hCpos j)
      (by exact_mod_cast hm (P j)), fun j => hmc (P j), fun j Γ => ?_, fun Γ => ?_, ?_⟩
  · rw [hMcoeffZ]
    split_ifs <;> simp
  · simp_rw [hMcoeff]
    have hsum : ∑ j, C.coeff (P j) / m (P j) * (m (P j) * (if P j = Γ then (1 : ℝ) else 0)) =
        ∑ j, (if P j = Γ then C.coeff Γ else 0) := by
      refine Finset.sum_congr rfl fun j _ => ?_
      have : (m (P j) : ℝ) ≠ 0 := by exact_mod_cast (hm (P j)).ne'
      split_ifs with h
      · subst h; field_simp
      · simp
    rw [hsum]
    rw [show (∑ j, (if P j = Γ then C.coeff Γ else 0)) =
        ∑ x ∈ S, (if x = Γ then C.coeff Γ else 0) from by
      rw [← Finset.sum_coe_sort S]
      exact Fintype.sum_equiv e.symm _ _ (fun _ => rfl)]
    rw [Finset.sum_ite_eq']
    split_ifs with h
    · rfl
    · exact Finsupp.notMem_support_iff.mp h
  · intro y hy
    obtain ⟨E, hE0, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hy
    have hES : E ∈ S := Finsupp.mem_support_iff.mpr hE0
    refine ⟨e ⟨E, hES⟩, DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hyE⟩⟩
    have hPE : P (e ⟨E, hES⟩) = E := by simp [P]
    rw [hMcoeffZ, hPE, if_pos rfl, mul_one]
    exact_mod_cast (hm E).ne'

/-- **The pull-back of an effective Cartier divisor is positive over its support.** -/
private theorem coeff_pos_of_isPullback_of_mem_supp {X C : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] [IsLocallyNoetherian C] [IsNormal C] {f : X ⟶ C} {B : Divisor C}
    (hBc : B.IsCartier) (hBe : DivisorWithCoeffs.IsEffective B)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ B.supp}
    {F : Divisor X} (hF : B.IsPullback f hB F) (E : MMP.Mori.PrimeDivisor X)
    (hE : f E.genericPoint ∈ (B.supp : Set C)) : 0 < F.coeff E := by
  obtain ⟨U, hU, φ, hφ⟩ := hBc (f E.genericPoint)
  have hEU : (E.support ∩ f ⁻¹ᵁ U).Nonempty := (E.genericPoint_mem_iff (f ⁻¹ᵁ U)).mp hU
  rw [hF U φ hφ E hEU]
  have hWc := mem_pointComponent (f E.genericPoint)
  obtain ⟨ϖ, hϖ⟩ := exists_stalk_eq_of_isLocalEquation_of_isEffective hBe hφ hU hWc
  have hnu := not_isUnit_of_isLocalEquation_of_mem_supp hφ hU hE hWc hϖ
  have h1 := MMP.Fourfold.pullbackComponent_val_eq_stalkMap f hB hφ hWc ϖ hϖ.symm
    E.genericPoint_mem_component (E.map_componentGenericPoint_mem f hEU)
  exact MMP.Fourfold.PrimeDivisor.ordUnit_pos_of_mem_maximalIdeal E
    (map_nonunit (f.stalkMap E.genericPoint).hom ϖ
      ((IsLocalRing.mem_maximalIdeal ϖ).mpr hnu)) h1.symm

/-- **The log discrepancies along the pencil `B + v C`.** On a `ℚ`-factorial `Y`, with `C ≥ 0`, a
log discrepancy `a` of `B + u C` along a divisor `E` over `Y` extends to the affine family
`a - (v - u) μ` of log discrepancies of `B + v C`, where `μ = mult_E C ≥ 0` is positive when the
centre of `E` lies in `Supp C`. -/
private theorem exists_isLogDiscrepancy_add_smul (hQ : IsQFactorial sY) {B C : RDivisor Y}
    (hC : ∀ P, 0 ≤ C.coeff P) {n : ℕ} {D : DivisorOver ℂ sY} {u a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sY n (B + u • C) D a) :
    ∃ μ : ℝ, 0 ≤ μ ∧ ((D.center : Set Y) ⊆ C.supp → 0 < μ) ∧
      ∀ v : ℝ, MMP.Intersection.IsLogDiscrepancy sY n (B + v • C) D (a - (v - u) * μ) := by
  obtain ⟨k, q, M, hq, hMc, hMe, hCeq, hsupp⟩ := exists_eq_sum_smul_of_isQFactorial hQ hC
  obtain ⟨hX, hp, ω, hω, hK, m, r, Cc, C', hCc, hsum, hpb, rfl⟩ := ha
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have := D.isNormalVariety.1
  have : CompactSpace D.Y := QuasiCompact.compactSpace_of_compactSpace (D.f ≫ sY)
  choose M' hM' using fun j => MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f (hMc j)
  have hM'0 : ∀ j, (0 : ℝ) ≤ (M' j).coeff D.E := fun j => by
    exact_mod_cast MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (V := ⊤) (hMc j)
      (fun P _ => hMe j P) (hM' j) D.E ((D.E.genericPoint_mem_iff _).mp trivial)
  refine ⟨∑ j, q j * (M' j).coeff D.E,
    Finset.sum_nonneg fun j _ => mul_nonneg (hq j).le (hM'0 j), fun hcen => ?_, fun v => ?_⟩
  · have hy : D.f D.E.genericPoint ∈ (C.supp : Set Y) := hcen (by
      rw [DivisorOver.center_eq_closure_genericPoint]; exact subset_closure rfl)
    obtain ⟨j, hj⟩ := hsupp _ hy
    have hpos := coeff_pos_of_isPullback_of_mem_supp (hMc j) (hMe j) (hM' j) D.E hj
    exact lt_of_lt_of_le (mul_pos (hq j) (by exact_mod_cast hpos))
      (Finset.single_le_sum (f := fun j => q j * ((M' j).coeff D.E : ℝ))
        (fun i _ => mul_nonneg (hq i).le (hM'0 i)) (Finset.mem_univ j))
  · refine ⟨hX, hp, ω, hω, hK, m + k, Fin.append r ((v - u) • q), Fin.append Cc M,
      Fin.append C' M', Fin.addCases (fun i => by simpa using hCc i) (fun j => by simpa using hMc j),
      fun Γ => ?_, Fin.addCases (fun i => by simpa using hpb i)
        (fun j => by simpa using (⟨_, hM' j⟩ : ∃ hC, (M j).IsPullback D.f hC (M' j))), ?_⟩
    · have h1 := hsum Γ
      simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply,
        smul_eq_mul] at h1 ⊢
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h1 ⊢
      have h2 : ∑ j, (v - u) * q j * ((M j).coeff Γ : ℝ) = (v - u) * C.coeff Γ := by
        rw [hCeq Γ, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [h2, ← h1]
      ring
    · simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply,
        smul_eq_mul]
      rw [Finset.mul_sum]
      simp only [mul_assoc, Finset.sum_sub_distrib]
      ring_nf

/-- **Dlt below an lc upper level.** If `(Y, B)` is dlt, `C ≥ 0` and `(Y, B + b C)` is lc on a
`ℚ`-factorial `Y`, then `(Y, B + u C)` is dlt for every `0 ≤ u < b`: the closed set `Z ∪ Supp C`
witnesses it, `Z` being a witness for `(Y, B)`. -/
private theorem isRealDltPair_add_smul {B C : RDivisor Y} {b u : ℝ} (hQ : IsQFactorial sY)
    (hC : ∀ P, 0 ≤ C.coeff P) (hdlt : IsRealDltPair sY B) (hlc : IsRealLcPair sY (B + b • C))
    (hu0 : 0 ≤ u) (hub : u < b) : IsRealDltPair sY (B + u • C) := by
  classical
  obtain ⟨⟨hX, hB0, ⟨n₀, K, hK, hKB⟩, hlcB⟩, hB1, Z, hZs, hZsnc, hZpos⟩ := hdlt
  have hlcb := hlc.2.2.2
  have hb1 := IsRealLcPair.coeff_le_one hlc
  have : LocallyOfFiniteType sY := hX.1.toLocallyOfFiniteType
  -- every log discrepancy of `B + u C` is controlled by those of `B` and `B + b C`
  have key : ∀ (n : ℕ) (D : DivisorOver ℂ sY) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sY n (B + u • C) D a →
      ∃ μ : ℝ, 0 ≤ μ ∧ ((D.center : Set Y) ⊆ C.supp → 0 < μ) ∧
        MMP.Intersection.IsLogDiscrepancy sY n B D (a + u * μ) ∧ 0 ≤ a - (b - u) * μ := by
    intro n D a ha
    obtain ⟨μ, hμ0, hμpos, hfam⟩ := exists_isLogDiscrepancy_add_smul hQ hC ha
    have h0 := hfam 0
    rw [zero_smul, add_zero] at h0
    refine ⟨μ, hμ0, hμpos, by convert h0 using 1; ring, hlcb n D _ (hfam b)⟩
  obtain ⟨k, q, M, hq, hMc, -, hCeq, -⟩ := exists_eq_sum_smul_of_isQFactorial hQ hC
  refine ⟨⟨hX, fun P => ?_, ⟨n₀, K, hK, ?_⟩, fun n D a ha => ?_⟩, fun P => ?_, Z ⊔ C.supp, ?_, ?_,
    fun n D hD a ha => ?_⟩
  · simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact add_nonneg (hB0 P) (mul_nonneg hu0 (hC P))
  · obtain ⟨m, r, Cc, hCc, hcoef⟩ := hKB
    refine ⟨m + k, Fin.append r (u • q), Fin.append Cc M,
      Fin.addCases (fun i => by simpa using hCc i) (fun j => by simpa using hMc j), fun Γ => ?_⟩
    have h1 := hcoef Γ
    simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul,
      DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul] at h1 ⊢
    rw [hCeq Γ, Finset.mul_sum, ← h1]
    simp only [mul_assoc]
    ring
  · obtain ⟨μ, hμ0, -, -, hb⟩ := key n D a ha
    nlinarith
  · simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    have := hb1 P
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at this
    nlinarith [hC P]
  · refine isSmoothScheme_ι_of_le_smoothLocus (le_trans ?_ (le_smoothLocus_of_isSmoothScheme_ι hZs))
    intro x hx
    simp only [TopologicalSpace.Closeds.compl, SetLike.mem_coe, Set.mem_compl_iff,
      TopologicalSpace.Closeds.coe_sup, Set.mem_union, not_or] at hx ⊢
    exact fun h => hx (Or.inl h)
  · rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen] at hZsnc ⊢
    haveI : ∀ E : MMP.Mori.PrimeDivisor Y,
        LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ sY) := fun E =>
      LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
    have hcov : ∀ x ∈ ((Z ⊔ C.supp).compl : Y.Opens), ∃ _ : Unit, x ∈ (Z.compl : Y.Opens) :=
      fun x hx => ⟨(), by
        simp only [TopologicalSpace.Closeds.compl, SetLike.mem_coe, Set.mem_compl_iff,
          TopologicalSpace.Closeds.coe_sup, Set.mem_union, not_or] at hx ⊢
        exact fun h => hx (Or.inl h)⟩
    have hB' := MMP.Threefold.Mori.OpenRestriction.isSNC_restrictOpen_of_cover sY
      (fun _ : Unit => (Z.compl : Y.Opens)) _ hcov B (fun _ => hZsnc)
    refine hB'.of_support_subset fun W hW => ?_
    rw [Finsupp.mem_support_iff] at hW ⊢
    have hW' : (B + u • C).coeff (OpenWeilRestriction.primeDivisorMap
        (Scheme.Opens.ι ((Z ⊔ C.supp).compl : Y.Opens)) W) ≠ 0 := hW
    change B.coeff (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι ((Z ⊔ C.supp).compl : Y.Opens)) W) ≠ 0
    have hC0 : C.coeff (OpenWeilRestriction.primeDivisorMap
        (Scheme.Opens.ι ((Z ⊔ C.supp).compl : Y.Opens)) W) = 0 := by
      by_contra hne
      set Q := OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι ((Z ⊔ C.supp).compl : Y.Opens)) W
      have hQ : Q.genericPoint ∈ (C.supp : Set Y) := DivisorWithCoeffs.mem_supp_iff.mpr
        ⟨Q, hne, by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
      have hU : Q.genericPoint ∈ ((Z ⊔ C.supp).compl : Y.Opens) := by
        rw [OpenWeilRestriction.genericPoint_primeDivisorMap]
        exact (W.genericPoint).2
      simp only [TopologicalSpace.Closeds.compl, SetLike.mem_coe, Set.mem_compl_iff,
        TopologicalSpace.Closeds.coe_sup, Set.mem_union, not_or] at hU
      exact hU (Or.inr hQ)
    simpa [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, hC0] using hW'
  · obtain ⟨μ, hμ0, hμpos, h0, hb⟩ := key n D a ha
    have hmem : D.f D.E.genericPoint ∈ (D.center : Set Y) := by
      rw [DivisorOver.center_eq_closure_genericPoint]; exact subset_closure rfl
    have hsub : ∀ T : TopologicalSpace.Closeds Y, D.f D.E.genericPoint ∈ (T : Set Y) →
        (D.center : Set Y) ⊆ T := fun T hT => by
      rw [DivisorOver.center_eq_closure_genericPoint]
      exact closure_minimal (Set.singleton_subset_iff.mpr hT) T.isClosed
    rcases (by simpa [TopologicalSpace.Closeds.coe_sup] using hD hmem :
      D.f D.E.genericPoint ∈ (Z : Set Y) ∨ D.f D.E.genericPoint ∈ (C.supp : Set Y)) with hZ | hCs
    · have := hZpos n D (hsub Z hZ) _ h0
      nlinarith
    · have := hμpos (hsub _ hCs)
      nlinarith

/-- **Lowering a dlt boundary.** On a `ℚ`-factorial `Y`, if `(Y, B + b C)` is dlt with `B, C ≥ 0`
and `b ≥ 0`, then `(Y, B)` is dlt, with the same witness. -/
private theorem isRealDltPair_of_add_smul {B C : RDivisor Y} {b : ℝ} (hQ : IsQFactorial sY)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P) (hb : 0 ≤ b)
    (hdlt : IsRealDltPair sY (B + b • C)) : IsRealDltPair sY B := by
  classical
  obtain ⟨⟨hX, -, ⟨n₀, K, hK, hKB⟩, hlcb⟩, hB1, Z, hZs, hZsnc, hZpos⟩ := hdlt
  -- every log discrepancy of `B` dominates one of `B + b C`
  have key : ∀ (n : ℕ) (D : DivisorOver ℂ sY) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sY n B D a →
      ∃ μ : ℝ, 0 ≤ μ ∧ MMP.Intersection.IsLogDiscrepancy sY n (B + b • C) D (a - b * μ) := by
    intro n D a ha
    have ha' : MMP.Intersection.IsLogDiscrepancy sY n (B + (0 : ℝ) • C) D a := by
      rwa [zero_smul, add_zero]
    obtain ⟨μ, hμ0, -, hfam⟩ := exists_isLogDiscrepancy_add_smul hQ hC ha'
    exact ⟨μ, hμ0, by simpa using hfam b⟩
  obtain ⟨k, q, M, hq, hMc, -, hCeq, -⟩ := exists_eq_sum_smul_of_isQFactorial hQ hC
  refine ⟨⟨hX, hB, ⟨n₀, K, hK, ?_⟩, fun n D a ha => ?_⟩, fun P => ?_, Z, hZs, ?_,
    fun n D hD a ha => ?_⟩
  · obtain ⟨m, r, Cc, hCc, hcoef⟩ := hKB
    refine ⟨m + k, Fin.append r ((-b) • q), Fin.append Cc M,
      Fin.addCases (fun i => by simpa using hCc i) (fun j => by simpa using hMc j), fun Γ => ?_⟩
    have h1 := hcoef Γ
    simp only [Fin.sum_univ_add, Fin.append_left, Fin.append_right, Pi.smul_apply, smul_eq_mul,
      DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul] at h1 ⊢
    rw [hCeq Γ] at h1
    have h2 : ∑ j, -b * q j * ((M j).coeff Γ : ℝ) = -(b * ∑ j, q j * ((M j).coeff Γ : ℝ)) := by
      rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [h2]
    linarith
  · obtain ⟨μ, hμ0, h⟩ := key n D a ha
    have := hlcb n D _ h
    nlinarith
  · have := hB1 P
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at this
    nlinarith [hC P]
  · rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen] at hZsnc ⊢
    refine hZsnc.of_support_subset fun W hW => ?_
    rw [Finsupp.mem_support_iff] at hW ⊢
    change (B + b • C).coeff (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι
      (Z.compl : Y.Opens)) W) ≠ 0
    have hW' : B.coeff (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι
      (Z.compl : Y.Opens)) W) ≠ 0 := hW
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    have h1 := hB (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι (Z.compl : Y.Opens)) W)
    have h2 := hC (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι (Z.compl : Y.Opens)) W)
    have h3 : 0 < B.coeff (OpenWeilRestriction.primeDivisorMap (Scheme.Opens.ι
      (Z.compl : Y.Opens)) W) := lt_of_le_of_ne h1 (Ne.symm hW')
    nlinarith
  · obtain ⟨μ, hμ0, h⟩ := key n D a ha
    have := hZpos n D hD _ h
    nlinarith

end PrimeDivisorDiscrepancy

open MMP.Threefold.Mori.OpenRestriction in
/-- The restriction of an snc divisor to an open subscheme is snc. -/
private theorem isSNC_restrictOpen {R : Type*} [Zero R] {X Y : Scheme.{0}} (g : X ⟶ Y)
    [∀ E : MMP.Mori.PrimeDivisor X, LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ g)]
    {D : DivisorWithCoeffs R X} (hD : D.IsSNC g) (U : X.Opens) :
    (D.restrictOpen U).IsSNC (U.ι ≫ g) := by
  refine ⟨fun E₀ hE₀ => ?_, fun x => (sncStalk_restrict_iff U.ι D x).mpr (hD.2 (U.ι x))⟩
  have hsm := hD.1 (OpenWeilRestriction.primeDivisorMap U.ι E₀)
    (Finsupp.mem_support_iff.2 (Finsupp.mem_support_iff.1 hE₀ : D.restrictOpen U E₀ ≠ 0))
  rw [IsSmoothScheme, smoothLocus_eq_smoothLocus] at hsm
  exact (isSmoothScheme_comap_iff U.ι g (OpenWeilRestriction.primeDivisorMap U.ι E₀).idealSheaf
    E₀.idealSheaf (idealSheaf_comap_primeDivisorMap U.ι E₀)).mpr fun z _ => hsm ▸ trivial

/-- **An lc pair with snc boundary on a smooth variety is dlt**, with empty witness. -/
private theorem isRealDltPair_of_isSmoothScheme {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXsm : IsSmoothScheme sX)
    {D : RDivisor X} (hlc : IsRealLcPair sX D) (hsnc : DivisorWithCoeffs.IsSNC sX D) :
    IsRealDltPair sX D := by
  have : LocallyOfFiniteType sX := hlc.1.1.toLocallyOfFiniteType
  haveI : ∀ E : MMP.Mori.PrimeDivisor X,
      LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ sX) := fun E =>
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  refine ⟨hlc, IsRealLcPair.coeff_le_one hlc, ⊥, ?_, ?_, fun n E hE a _ => ?_⟩
  · refine isSmoothScheme_ι_of_le_smoothLocus ?_
    rw [show smoothLocus sX = ⊤ from hXsm]
    exact le_top
  · rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen]
    exact isSNC_restrictOpen sX hsnc _
  · exfalso
    have hmem : E.f E.E.genericPoint ∈ (E.center : Set X) := by
      rw [DivisorOver.center_eq_closure_genericPoint]; exact subset_closure rfl
    simpa using hE hmem

/-- The strict transform of an effective divisor is effective. -/
private theorem coeff_transformDivisor_nonneg {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    {D : RDivisor X} (hD : ∀ P, 0 ≤ D.coeff P) (F : MMP.Mori.PrimeDivisor Y) :
    0 ≤ (MMP.Mori.RationalMap.transformDivisor φ D).coeff F := by
  classical
  rw [← Finsupp.sum_single D, Finsupp.sum, map_sum]
  change 0 ≤ (∑ P ∈ D.support, MMP.Mori.RationalMap.transformDivisor φ
    (Finsupp.single P (D P))) F
  rw [Finsupp.finset_sum_apply]
  refine Finset.sum_nonneg fun P _ => ?_
  rcases h : MMP.Mori.RationalMap.transformPrimeDivisor φ P with _ | E
  · rw [MMP.Mori.RationalMap.transformDivisor_single_of_eq_none h]
    simp
  · rw [MMP.Mori.RationalMap.transformDivisor_single_of_eq_some h, Finsupp.single_apply]
    split_ifs
    · exact hD P
    · exact le_rfl

/-- **Null on a face, trivial over its contraction.** An `ℝ`-Cartier divisor of degree zero on an
extremal face `R` of `NE̅(X/S)` is numerically trivial over the contraction of `R`. -/
private theorem isNumericallyTrivialOver_of_isRelativeContractionOfFace {X S W : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    {g : X ⟶ S} {R : Set (RelativeNumericalCurveClasses sX g)} {f : X ⟶ W} {h : W ⟶ S}
    (hf : IsRelativeContractionOfFace g R f h) {D : RDivisor X} (hD : IsCartierCombination D)
    (h0 : ∀ (n : ℕ) (c : Fin n → ℝ) (M : Fin n → Divisor X) (hM : ∀ i, (M i).IsCartier),
      D = ∑ i, c i • Divisor.toRDivisor (M i) →
      ∀ u ∈ R, ∑ i, c i * (haveI := (hM i).isInvertibleModule_divisorialSheaf
        RelativeNumericalCurveClasses.degree sX g (M i).divisorialSheaf u) = 0) :
    IsNumericallyTrivialOver ℂ sX f D := by
  refine ⟨hD, ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
    fun Γ hΓ m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
  have hx₂0 : x₂ = 0 := by
    have h00 : IsRIntersectionNumber ℂ sX (0 : RDivisor X) (Fin.elim0 : Fin 0 → ℝ)
        (Fin.elim0 : Fin 0 → Divisor X) Γ 0 := by
      simpa using MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ (Fin.elim0 : Fin 0 → ℝ)
        (Fin.elim0 : Fin 0 → Divisor X) (fun j => j.elim0)
    exact (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx₂ h00
  rw [hx₂0]
  obtain ⟨hL, -, hDeq, -, -⟩ := id hx₁
  have hs := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r₁ L₁ hL
  rw [← hDeq] at hs
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sX Γ).1 _ _ _ _ _ _ _ hx₁ hs]
  have hΓg : Γ.IsContractedBy g := fun x hx => by
    rw [← hf.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ x hx]
  have hu := (hf.isContractedBy_iff Γ hΓg).mp hΓ
  have := h0 m₁ r₁ L₁ hL hDeq _ hu
  rw [← this]
  refine Finset.sum_congr rfl fun j _ => ?_
  congr 1
  have := (hL j).isInvertibleModule_divisorialSheaf
  exact (OneCycle.degree_cycle ℝ _ Γ).symm

/-- An `ℝ`-Cartier divisor in the coefficient form is a combination of Cartier divisors. -/
private theorem isCartierCombination_of_isRCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {D : RDivisor X} (h : RDivisor.IsRCartier D) :
    IsCartierCombination D := by
  obtain ⟨m, r, L, hL, hcoeff⟩ := h
  refine ⟨m, r, L, hL, Finsupp.ext fun Γ => ?_⟩
  have := hcoeff Γ
  simp only [DivisorWithCoeffs.coeff] at this
  rw [this, Finsupp.finset_sum_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Finsupp.smul_apply, smul_eq_mul]
  exact congrArg (r j * ·)
    (DivisorWithCoeffs.coeff_mapCoeffs (fun x : ℤ => (x : ℝ)) Int.cast_zero (L j) Γ).symm

/-- A real combination `D₁ + c D₂` of `ℝ`-Cartier divisors is `ℝ`-Cartier. -/
private theorem IsCartierCombination.add_smul' {X : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {D₁ D₂ : RDivisor X} (h₁ : IsCartierCombination D₁)
    (h₂ : IsCartierCombination D₂) (c : ℝ) : IsCartierCombination (D₁ + c • D₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, rfl⟩ := h₁
  obtain ⟨m₂, r₂, L₂, hL₂, rfl⟩ := h₂
  refine ⟨m₁ + m₂, Fin.append r₁ (c • r₂), Fin.append L₁ L₂,
    Fin.addCases (fun i => by simpa using hL₁ i) (fun j => by simpa using hL₂ j), ?_⟩
  rw [Fin.sum_univ_add, Finset.smul_sum]
  simp [smul_smul]

/-- The strict transform of an integral divisor, as a real divisor, is the strict transform of
the real divisor. -/
private theorem transformDivisor_toRDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (D : Divisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (Divisor.toRDivisor D) =
      Divisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor φ D) := by
  classical
  have hs : ∀ {T : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor T) (r : ℤ),
      Divisor.toRDivisor (Finsupp.single Q r) = Finsupp.single Q (r : ℝ) := fun Q r =>
    Finsupp.mapRange_single (hf := map_zero (Int.castAddHom ℝ))
  induction D using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add D D' h h' => simp only [map_add, h, h']
  | single P r =>
    rw [hs, MMP.Mori.RationalMap.transformDivisor_single,
      MMP.Mori.RationalMap.transformDivisor_single]
    cases MMP.Mori.RationalMap.transformPrimeDivisor φ P with
    | none => simp
    | some E => simp [hs]

/-- Numerical triviality only depends on the structure morphism, not on its spelling. -/
private theorem IsNumericallyTrivialOver.congr_str {X W : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {s₁ s₂ : X ⟶ Spec (.of ℂ)} [QuasiCompact s₁] [QuasiCompact s₂] {f : X ⟶ W}
    {D : RDivisor X} (e : s₁ = s₂) (h : IsNumericallyTrivialOver ℂ s₁ f D) :
    IsNumericallyTrivialOver ℂ s₂ f D := by
  subst e
  exact h

/-- The pull-back of the negative is the negative of the pull-back. -/
private theorem IsRCartierPullback.neg' {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : Y ⟶ X} {D : RDivisor X} {G : RDivisor Y}
    (h : IsRCartierPullback f D G) : IsRCartierPullback f (-D) (-G) := by
  obtain ⟨m, r, L, L', hL, hD, hpb, hG⟩ := h
  exact ⟨m, -r, L, L', hL, by rw [hD]; simp [neg_smul], hpb, by rw [hG]; simp [neg_smul]⟩

/-- Numerical triviality descends along a proper surjection. -/
private theorem IsNumericallyTrivialOver.of_isRCartierPullback_of_surjective
    {V Y S : Scheme.{0}} [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V]
    [IsLocallyNoetherian Y] [IsNormal Y] {sV : V ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sV] [QuasiCompact sV] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsSeparated sY] (q : V ⟶ Y) [IsProper q] [Surjective q] (hq : q ≫ sY = sV) (π : Y ⟶ S)
    {D : RDivisor Y} {G : RDivisor V} (hG : IsRCartierPullback q D G)
    (h : IsNumericallyTrivialOver ℂ sV (q ≫ π) G) : IsNumericallyTrivialOver ℂ sY π D := by
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace sV
  obtain ⟨m, r, L, L', hL, hD, -, -⟩ := id hG
  exact isNumericallyTrivialOver_of_isRelativelyNef_of_neg ⟨m, r, L, hL, hD⟩
    (IsRelativelyNef.of_isRCartierPullback_of_surjective q hq π hG
      (IsNumericallyTrivialOver.isRelativelyNef h))
    (IsRelativelyNef.of_isRCartierPullback_of_surjective q hq π (IsRCartierPullback.neg' hG)
      (IsNumericallyTrivialOver.isRelativelyNef (IsNumericallyTrivialOver.neg' h)))

/-- The pull-back of a numerically trivial divisor is numerically trivial. -/
private theorem IsNumericallyTrivialOver.isRCartierPullback'
    {W Y Z S : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    [IsLocallyNoetherian Z] [IsNormal Z] {sZ : Z ⟶ Spec (.of ℂ)} [IsSeparated sZ]
    [LocallyOfFiniteType sZ] [QuasiCompact sZ] (πY : Y ⟶ S) (πZ : Z ⟶ S) (p : W ⟶ Y)
    (q : W ⟶ Z) [IsProper q] [QuasiCompact (q ≫ sZ)] (hpq : p ≫ πY = q ≫ πZ)
    {M : RDivisor Z} (hM : IsNumericallyTrivialOver ℂ sZ πZ M) {M' : RDivisor W}
    (hM' : IsRCartierPullback q M M') : IsNumericallyTrivialOver ℂ (q ≫ sZ) p M' := by
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (q ≫ sZ)
  have h₁ := isRelativelyNef_of_isRCartierPullback πY πZ p q hpq
    (IsNumericallyTrivialOver.isRelativelyNef hM) hM'
  have h₂ := isRelativelyNef_of_isRCartierPullback πY πZ p q hpq
    (IsNumericallyTrivialOver.isRelativelyNef (IsNumericallyTrivialOver.neg' hM))
    (IsRCartierPullback.neg' hM')
  obtain ⟨m, r, L, hL, hD, -⟩ := id h₁
  exact isNumericallyTrivialOver_of_isRelativelyNef_of_neg ⟨m, r, L, hL, hD⟩ h₁ h₂

/-- **`f_* f^* D = D`** for a real Cartier combination `D` and a proper birational morphism `f`
of normal varieties. -/
private theorem transformDivisor_of_isRCartierPullback_hom {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sY : Y ⟶ Spec (.of ℂ)} (hY : IsNormalVariety ℂ sY) {f : X ⟶ Y}
    (hX : IsNormalVariety ℂ (f ≫ sY)) [IsProper f] (hf : IsBirationalMorphism f)
    {D : RDivisor Y} {G : RDivisor X} (h : IsRCartierPullback f D G) :
    MMP.Mori.RationalMap.transformDivisor (X := X) f.toRationalMap G = D := by
  obtain ⟨m, r, L, L', hL, rfl, hpb, rfl⟩ := h
  choose hB hpbj using hpb
  rw [← MMP.Mori.RationalMap.transformDivisorₗ_apply ℝ, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [LinearMap.map_smul, MMP.Mori.RationalMap.transformDivisorₗ_apply,
    transformDivisor_toRDivisor,
    MMP.Positivity.transformDivisor_of_isPullback_divisor hY hX hf (hL j) (hpbj j)]

/-- The coefficient of the image of `D` under a map of divisors induced by a partial map of
prime divisors. -/
private theorem apply_eq_sum_of_map_single {X Y : Scheme.{0}} {R : Type*} [AddCommMonoid R]
    (T : DivisorWithCoeffs R X →+ DivisorWithCoeffs R Y)
    (o : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y))
    (hT : ∀ P r, T (Finsupp.single P r) = (o P).elim 0 (Finsupp.single · r))
    (D : DivisorWithCoeffs R X) (F : MMP.Mori.PrimeDivisor Y) :
    open Classical in T D F = ∑ P ∈ D.support, if o P = some F then D P else 0 := by
  classical
  conv_lhs => rw [← Finsupp.sum_single D, Finsupp.sum, map_sum]
  rw [Finsupp.finset_sum_apply]
  refine Finset.sum_congr rfl fun P _ => ?_
  rw [hT]
  rcases h : o P with _ | E
  · simp
  · simp [Finsupp.single_apply]

/-- A map of divisors induced by a partial map of prime divisors keeps a divisor `N` supported
where an effective `B` has coefficient at least one. -/
private theorem one_le_apply_of_map_single {X Y : Scheme.{0}}
    (T : RDivisor X →+ RDivisor Y)
    (o : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y))
    (hT : ∀ P r, T (Finsupp.single P r) = (o P).elim 0 (Finsupp.single · r))
    {B N : RDivisor X} (hB : ∀ P, 0 ≤ B P) (hNB : ∀ P, N P ≠ 0 → 1 ≤ B P)
    (F : MMP.Mori.PrimeDivisor Y) (hF : T N F ≠ 0) : 1 ≤ T B F := by
  classical
  rw [apply_eq_sum_of_map_single T o hT] at hF
  obtain ⟨P, hP, hPF⟩ := Finset.exists_ne_zero_of_sum_ne_zero hF
  have hoP : o P = some F := by by_contra h; simp [h] at hPF
  have hNP : N P ≠ 0 := Finsupp.mem_support_iff.mp hP
  have h1 := hNB P hNP
  rw [apply_eq_sum_of_map_single T o hT]
  have hBP : P ∈ B.support := Finsupp.mem_support_iff.mpr (by linarith)
  calc (1 : ℝ) ≤ if o P = some F then B P else 0 := by rw [if_pos hoP]; exact h1
    _ ≤ _ := Finset.single_le_sum (f := fun P => if o P = some F then B P else 0)
        (fun Q _ => by split_ifs <;> simp [hB Q]) hBP

/-- An open subset of an irreducible scheme containing every point of codimension at most one
is dense. -/
private theorem dense_of_forall_coheight_le_one {T : Scheme.{0}} [IrreducibleSpace T]
    (U : T.Opens) (hU : ∀ y : T, Order.coheight y ≤ 1 → y ∈ U) : Dense (U : Set T) := by
  have hg : Order.coheight (genericPoint T) ≤ 1 := by
    rw [Order.coheight_eq_zero.mpr]
    · exact zero_le_one
    · intro b _
      exact Scheme.le_iff_specializes.mpr ((genericPoint_spec T).specializes (Set.mem_univ b))
  exact U.isOpen.dense ⟨_, hU _ hg⟩

/-- **The flip of a real flip step as a partial isomorphism.** Both contractions are isomorphisms
over an open `V` of the base over which lie the points of codimension at most one; the induced
isomorphism `f⁻¹(V) ≅ (f⁺)⁻¹(V)` is a partial isomorphism `X ⤏ X⁺` over the base. -/
private theorem IsRealFlipStep.exists_partialIso {X Z X' : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    {sX' : X' ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {f : X ⟶ Z} {fp : X' ⟶ Z}
    (h : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    ∃ φ : X.PartialIso X', φ.toRationalMap.compHom fp = f.toRationalMap ∧
      (∀ x : X, Order.coheight x ≤ 1 → x ∈ φ.source) ∧
      (∀ x : X', Order.coheight x ≤ 1 → x ∈ φ.target) := by
  obtain ⟨V, hV, hV', hXV, hX'V⟩ := h.exists_opens_isIso
  have hd : Dense ((f ⁻¹ᵁ V : X.Opens) : Set X) :=
    dense_of_forall_coheight_le_one _ fun x hx => hXV x hx
  have hd' : Dense ((fp ⁻¹ᵁ V : X'.Opens) : Set X') :=
    dense_of_forall_coheight_le_one _ fun x hx => hX'V x hx
  refine ⟨⟨f ⁻¹ᵁ V, hd, fp ⁻¹ᵁ V, hd', asIso (f ∣_ V) ≪≫ (asIso (fp ∣_ V)).symm⟩, ?_, hXV, hX'V⟩
  have hinv : inv (fp ∣_ V) ≫ (fp ⁻¹ᵁ V).ι ≫ fp = V.ι := by
    rw [← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
  rw [Scheme.PartialIso.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap]
  change _ = f.toPartialMap.toRationalMap
  rw [← Scheme.PartialMap.restrict_toRationalMap f.toPartialMap (f ⁻¹ᵁ V) hd le_top]
  congr 1
  refine Scheme.PartialMap.ext _ _ rfl ?_
  simp only [Scheme.PartialMap.compHom_hom, Scheme.PartialIso.toPartialMap_hom,
    Scheme.PartialMap.restrict_hom, Scheme.Hom.toPartialMap_hom, Iso.trans_hom, asIso_hom,
    Iso.symm_hom, asIso_inv, Category.assoc, hinv, morphismRestrict_ι]
  have e₁ : (f ∣_ V ≫ inv (fp ∣_ V) ≫ (fp ⁻¹ᵁ V).ι) ≫ fp = (f ⁻¹ᵁ V).ι ≫ f := by
    rw [Category.assoc, Category.assoc, hinv, morphismRestrict_ι]
  refine e₁.trans ?_
  change (f ⁻¹ᵁ V).ι ≫ f = (X.isoOfEq _).hom ≫ (X.homOfLE le_top ≫ X.topIso.hom ≫ f)
  simp only [Scheme.topIso_hom, Scheme.homOfLE_ι_assoc]
  exact (Scheme.isoOfEq_hom_ι_assoc X _ f).symm

/-- The exceptional set of a morphism lies in its biregular exceptional set. -/
private theorem flips_exceptionalSet_subset {X Y : Scheme.{0}} (f : X ⟶ Y) :
    MMP.Flips.exceptionalSet f ⊆ (MMP.Mori.exceptionalSet f : Set X) := by
  intro y hy
  by_contra hyM
  apply hy
  have : IsIso (f ∣_ biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
  refine ⟨f ⁻¹ᵁ biregularLocus f, ?_, ?_⟩
  · by_contra h
    exact hyM (MMP.Mori.mem_exceptionalSet.mpr h)
  · rw [← morphismRestrict_ι]
    infer_instance

section CodimOne

variable {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y] [IsSeparated (Y ↘ ⊤_ Scheme)]

/-- A partial isomorphism defined at the generic point of a prime divisor `Q` sends it to the
generic point of a prime divisor, the strict transform of `Q`. -/
private theorem exists_transformPrimeDivisor_eq_some (φ : X.PartialIso Y)
    (Q : MMP.Mori.PrimeDivisor X) (hQ : Q.genericPoint ∈ φ.source) :
    ∃ Q' : MMP.Mori.PrimeDivisor Y,
      MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q = some Q' ∧
        Q'.genericPoint = φ.toPartialMap.hom ⟨Q.genericPoint, hQ⟩ := by
  have hemb : Topology.IsOpenEmbedding φ.toPartialMap.hom :=
    (φ.iso.hom ≫ φ.target.ι).isOpenEmbedding
  have h1 : Order.coheight (φ.toPartialMap.hom ⟨Q.genericPoint, hQ⟩) = 1 := by
    have e1 := Topology.IsOpenEmbedding.coheight_eq (x := ⟨Q.genericPoint, hQ⟩) _ hemb
    have e2 := Topology.IsOpenEmbedding.coheight_eq (x := ⟨Q.genericPoint, hQ⟩) _
      φ.source.ι.isOpenEmbedding
    exact e1.trans (e2.symm.trans (MMP.Mori.PrimeDivisor.coheight_genericPoint Q))
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1, ?_,
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1⟩
  exact MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq φ.toPartialMap rfl hQ
    (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1)

/-- The strict transform of prime divisors under a partial isomorphism is injective on the prime
divisors whose generic points lie in its source. -/
private theorem transformPrimeDivisor_injective (φ : X.PartialIso Y)
    {Q₁ Q₂ : MMP.Mori.PrimeDivisor X} {Q' : MMP.Mori.PrimeDivisor Y}
    (hQ₁ : Q₁.genericPoint ∈ φ.source) (hQ₂ : Q₂.genericPoint ∈ φ.source)
    (h₁ : MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q₁ = some Q')
    (h₂ : MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q₂ = some Q') :
    Q₁ = Q₂ := by
  have e₁ := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h₁ φ.toPartialMap rfl hQ₁
  have e₂ := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h₂ φ.toPartialMap rfl hQ₂
  have hinj : Function.Injective φ.toPartialMap.hom :=
    (φ.iso.hom ≫ φ.target.ι).isOpenEmbedding.injective
  have := hinj (e₁.symm.trans e₂)
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (congrArg Subtype.val this)

/-- The coefficient of a strict transform under a partial isomorphism which is defined at the
generic points of all prime divisors. -/
private theorem coeff_transformDivisor_of_eq_some {R : Type*} [AddCommMonoid R]
    (φ : X.PartialIso Y) (hs : ∀ Q : MMP.Mori.PrimeDivisor X, Q.genericPoint ∈ φ.source)
    {Q : MMP.Mori.PrimeDivisor X} {Q' : MMP.Mori.PrimeDivisor Y}
    (h : MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q = some Q')
    (D : DivisorWithCoeffs R X) :
    (MMP.Mori.RationalMap.transformDivisor φ.toRationalMap D) Q' = D Q :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq h
    (fun _ h' => transformPrimeDivisor_injective φ (hs _) (hs Q) h' h) D

/-- A prime divisor whose generic point lies in the target of a partial isomorphism is the strict
transform of a prime divisor. -/
private theorem exists_transformPrimeDivisor_eq_some_of_mem_target [IsSeparated (X ↘ ⊤_ Scheme)]
    (φ : X.PartialIso Y) (Q' : MMP.Mori.PrimeDivisor Y) (hQ' : Q'.genericPoint ∈ φ.target) :
    ∃ Q : MMP.Mori.PrimeDivisor X,
      MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q = some Q' := by
  obtain ⟨Q, -, hQ⟩ := exists_transformPrimeDivisor_eq_some φ.symm Q' hQ'
  set y : φ.target.toScheme := ⟨Q'.genericPoint, hQ'⟩ with hy
  set p : φ.source.toScheme := φ.iso.inv y with hp
  have hQp : Q.genericPoint = φ.source.ι p := hQ
  have hmem : Q.genericPoint ∈ φ.source := by rw [hQp]; exact p.2
  have key : φ.iso.hom p = y := by
    rw [hp, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have hval : φ.toPartialMap.hom ⟨Q.genericPoint, hmem⟩ = Q'.genericPoint := by
    have e1 : (⟨Q.genericPoint, hmem⟩ : φ.source.toScheme) = p := Subtype.ext hQp
    change (φ.iso.hom ≫ φ.target.ι) ⟨Q.genericPoint, hmem⟩ = _
    rw [e1, Scheme.Hom.comp_apply, key]
    rfl
  exact ⟨Q, MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq φ.toPartialMap rfl
    hmem hval.symm⟩

end CodimOne

/-- The strict transform of a prime divisor is read off the transform of the divisor `1 · P`. -/
private theorem flipTransformPrimeDivisor_eq_some_of_flipTransform {X W X' : Scheme.{0}}
    {f : X ⟶ W} {fp : X' ⟶ W} {P : MMP.Mori.PrimeDivisor X} {P' : MMP.Mori.PrimeDivisor X'}
    (h : flipTransform f fp (Finsupp.single P (1 : ℝ)) = Finsupp.single P' 1) :
    flipTransformPrimeDivisor f fp P = some P' := by
  unfold flipTransformPrimeDivisor
  simp only [flipTransform, AddMonoidHom.coe_comp, Function.comp_apply] at h
  rcases h1 : MMP.Mori.RationalMap.transformPrimeDivisor (X := X) f.toRationalMap P with _ | Q
  · rw [MMP.Mori.RationalMap.transformDivisor_single_of_eq_none h1, map_zero] at h
    exact absurd h.symm (by simp)
  · rw [MMP.Mori.RationalMap.transformDivisor_single_of_eq_some h1,
      MMP.Mori.inverseTransformDivisor_single] at h
    rcases h2 : MMP.Mori.inverseTransformPrimeDivisor fp Q with _ | Q'
    · rw [h2] at h
      exact absurd h.symm (by simp)
    · rw [h2] at h
      simp only [Option.bind_some, h2]
      exact congrArg some ((Finsupp.single_left_inj one_ne_zero).mp h)

/-- **The prime divisors across a real flip step.** The strict transform `(f⁺)⁻¹_* f_*` is a
bijection from the prime divisors of `X` onto those of `X⁺` which preserves coefficients. -/
private theorem IsRealFlipStep.forall_flipTransformPrimeDivisor {X Z X' : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X']
    [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {f : X ⟶ Z} {fp : X' ⟶ Z}
    (h : IsRealFlipStep sX sZ sX' K B K' B' f fp) (hX : IsSeparated sX)
    (hX' : IsSeparated sX') :
    (∀ P, ∃ P', flipTransformPrimeDivisor f fp P = some P') ∧
      (∀ P P', flipTransformPrimeDivisor f fp P = some P' →
        ∀ D : RDivisor X, (flipTransform f fp D).coeff P' = D.coeff P) ∧
      ∀ P', ∃ P, flipTransformPrimeDivisor f fp P = some P' := by
  have : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  have : IsSeparated (X' ↘ ⊤_ Scheme) := by
    rw [show (X' ↘ ⊤_ Scheme) = sX' ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  obtain ⟨φ, hφf, hφs, hφt⟩ := IsRealFlipStep.exists_partialIso h
  obtain ⟨V, hfV, hfpV, hXV, hX'V⟩ := h.exists_opens_isIso
  have hWn := h.isNegativeExtremalContraction.isNormalVariety_target
  have hMn := h.isNegativeExtremalContraction.isNormalVariety_source
  have hfs := h.isNegativeExtremalContraction.isContraction.comp_eq
  have : IsProper f := h.isNegativeExtremalContraction.isContraction.isProper
  have htr : ∀ D : RDivisor X,
      MMP.Mori.RationalMap.transformDivisor φ.toRationalMap D = flipTransform f fp D :=
    fun D => MMP.Mori.transformDivisor_eq_flipTransform_of_isIso_restrict hWn
      (by rw [hfs]; exact hMn) h.isBirationalMorphism V hXV hX'V hφf D
  have hsrc : ∀ Q : MMP.Mori.PrimeDivisor X, Q.genericPoint ∈ φ.source := fun Q =>
    hφs _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le
  have hfl : ∀ P P', MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap P = some P' →
      flipTransformPrimeDivisor f fp P = some P' := by
    intro P P' hP
    apply flipTransformPrimeDivisor_eq_some_of_flipTransform
    rw [← htr, MMP.Mori.RationalMap.transformDivisor_single_of_eq_some hP]
  refine ⟨fun P => ?_, fun P P' hP D => ?_, fun P' => ?_⟩
  · obtain ⟨P', hP', -⟩ := exists_transformPrimeDivisor_eq_some φ P (hsrc P)
    exact ⟨P', hfl P P' hP'⟩
  · obtain ⟨P'', hP'', -⟩ := exists_transformPrimeDivisor_eq_some φ P (hsrc P)
    obtain rfl : P'' = P' := Option.some_injective _ ((hfl P P'' hP'').symm.trans hP)
    rw [← htr]
    exact coeff_transformDivisor_of_eq_some φ hsrc hP'' D
  · obtain ⟨P, hP⟩ := exists_transformPrimeDivisor_eq_some_of_mem_target φ P'
      (hφt _ (MMP.Mori.PrimeDivisor.coheight_genericPoint P').le)
    exact ⟨P, hfl P P' hP⟩

/-- A proper curve has a point other than its generic point. -/
private theorem exists_mem_closure_ne_point {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (C : ProperCurve sX) : ∃ q ∈ closure ({C.point} : Set X), q ≠ C.point := by
  by_contra! h
  have hsub : Subsingleton C.scheme :=
    ⟨fun a b => (curveSubschemeAtι C.point).isEmbedding.injective <|
      (h _ (range_curveSubschemeAtι C.point ▸ ⟨a, rfl⟩)).trans
        (h _ (range_curveSubschemeAtι C.point ▸ ⟨b, rfl⟩)).symm⟩
  haveI : DiscreteTopology C.scheme := inferInstance
  have h0 := topologicalKrullDim_zero_of_discreteTopology C.scheme
  rw [C.dim_eq] at h0
  exact absurd h0 (by decide)

/-- The generic point of a proper curve contracted by `f` lies in the exceptional set of `f`. -/
private theorem point_mem_exceptionalSet {X W : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {f : X ⟶ W}
    (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) :
    Γ.point ∈ (MMP.Mori.exceptionalSet f : Set X) := by
  intro hp
  obtain ⟨q, hq, hne⟩ := exists_mem_closure_ne_point Γ
  have : IsIso (f ∣_ biregularLocus f) := MMP.Mori.isBiregular_biregularLocus f
  have hq' : q ∈ f ⁻¹ᵁ biregularLocus f := by
    change f q ∈ biregularLocus f
    rw [hΓ q hq]
    exact hp
  have hinj : Function.Injective ((f ⁻¹ᵁ biregularLocus f).ι ≫ f) := by
    rw [← morphismRestrict_ι]
    exact ((f ∣_ biregularLocus f) ≫ (biregularLocus f).ι).isOpenEmbedding.injective
  exact hne (congrArg Subtype.val (hinj (a₁ := ⟨q, hq'⟩) (a₂ := ⟨Γ.point, hp⟩)
    (by change f q = f Γ.point; exact hΓ q hq)))

/-- **The steps of a program with a floor identity are divisorial or small.** Let `f` be a
`(K + B)`-negative extremal contraction of a projective `ℚ`-factorial variety `M` over `Z`, and
suppose `α (K + B) ≡_Z C + N` with `α > 0` and `C, N ≥ 0`. Then `f` is not of fibre type: the
effective `C + N` is negative on every contracted curve, while contracted curves avoid its
support when the fibres are positive-dimensional. Being birational, `f` is small, or its
exceptional set is a prime divisor (FA 6.5). -/
private theorem divisorial_or_isSmall_of_isNumericallyEquivalentOver
    {M W Z : Scheme.{0}} [IsIntegral M] [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sM : M ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)} {πM : M ⟶ Z} {f : M ⟶ W} {h : W ⟶ Z}
    {K : Divisor M} {B C N : RDivisor M} {α : ℝ}
    (hproj : MMP.Mori.IsProjectiveVariety ℂ sM) (hQ : IsQFactorial sM)
    (hneg : IsNegativeExtremalContraction ℂ sM sW (logCanonicalDivisor K B) f)
    (hfh : f ≫ h = πM) (hC : ∀ P, 0 ≤ C.coeff P) (hN : ∀ P, 0 ≤ N.coeff P) (hα : 0 < α)
    (hnum : IsNumericallyEquivalentOver ℂ sM πM (α • logCanonicalDivisor K B) (C + N)) :
    (IsBirationalMorphism f ∧ ∃ E : MMP.Mori.PrimeDivisor M,
      (MMP.Mori.exceptionalSet f : Set M) = E.support) ∨ IsSmall ℂ sW sM f := by
  classical
  have hMn := hneg.isNormalVariety_source
  have hWn := hneg.isNormalVariety_target
  haveI := hMn.1
  haveI := hWn.1
  have hfs : f ≫ sW = sM := hneg.isContraction.comp_eq
  haveI : IsProper f := hneg.isContraction.isProper
  haveI : Surjective f := Scheme.Hom.surjective_of_isIso_app f hneg.isContraction.isIso_app
  haveI : IsProper sM := isProper_of_isProjectiveMorphism _ hproj.isProjective
  -- `f` is not of fibre type
  have hnlt : ¬ topologicalKrullDim W < topologicalKrullDim M := by
    intro hlt
    have hD0 : ∀ P, 0 ≤ (C + N).coeff P := fun P => by
      simp only [DivisorWithCoeffs.coeff_add]; exact add_nonneg (hC P) (hN P)
    obtain ⟨k, q, Mj, hq, hMc, hMe, hDeq, -⟩ := exists_eq_sum_smul_of_isQFactorial hQ hD0
    obtain ⟨Γ, hΓ, hΓD⟩ := MMP.Fourfold.exists_properCurve_isContractedBy_of_lt hMn.1 hWn.1 f hfs
      hlt (C + N).supp.isClosed (MMP.Fourfold.genericPoint_notMem_supp (C + N))
    have hΓπ : Γ.IsContractedBy πM := fun x hx => by
      rw [← hfh, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ x hx]
    have hDsum : C + N = ∑ j, q j • Divisor.toRDivisor (Mj j) := by
      refine Finsupp.ext fun P => ?_
      have := hDeq P
      simp only [DivisorWithCoeffs.coeff] at this
      rw [this, Finsupp.finset_sum_apply]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [Finsupp.smul_apply, smul_eq_mul]
      exact congrArg (q j * ·)
        (DivisorWithCoeffs.coeff_mapCoeffs (fun x : ℤ => (x : ℝ)) Int.cast_zero (Mj j) P)
    have eD := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ q Mj hMc
    rw [← hDsum] at eD
    have hnn : 0 ≤ ∑ j, q j * ((Mj j).degreeOn ℂ sM Γ.ι Γ.dim_le (hMc j) : ℝ) := by
      refine Finset.sum_nonneg fun j _ => mul_nonneg (hq j).le ?_
      obtain ⟨c, hc⟩ := MMP.Threefold.Mori.exists_ι_eq_point Γ.point
      have hnot : Γ.point ∉ (Mj j).supp := by
        intro hmem
        obtain ⟨E, hE, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
        apply hΓD
        refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hyE⟩
        have hpos : 0 < q j * ((Mj j).coeff E : ℝ) := mul_pos (hq j)
          (by exact_mod_cast lt_of_le_of_ne (hMe j E) (Ne.symm hE))
        have hle := Finset.single_le_sum (f := fun i => q i * ((Mj i).coeff E : ℝ))
          (fun i _ => mul_nonneg (hq i).le (by exact_mod_cast hMe i E)) (Finset.mem_univ j)
        rw [hDeq E]
        exact (lt_of_lt_of_le hpos hle).ne'
      exact_mod_cast (MMP.Threefold.Mori.degreeOn_nonneg_and_eq_zero_iff sM Γ.ι Γ.dim_le (Mj j)
        (hMc j) (DivisorWithCoeffs.isEffective_iff_nonneg.mp (hMe j))
        ⟨c, by change curveSubschemeAtι Γ.point c ∉ _; rw [hc]; exact hnot⟩).1
    obtain ⟨m, r, L, hL, hKB⟩ := hneg.isCartierCombination
    have e1 := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ r L hL
    rw [← show logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j) from hKB] at e1
    have hx := isRIntersectionNumber_neg_of_isRelativelyAntiAmple f hneg.isRelativelyAntiAmple Γ
      hΓ _ _ _ e1
    have e2 := (IsRIntersectionNumber.eq_and_linear ℂ sM Γ).2 _ _ _ _ _ _ _ _ α 0 e1 e1
    rw [zero_smul, add_zero, zero_mul, add_zero] at e2
    have := hnum.2.2 Γ hΓπ _ _ _ _ _ _ _ _ e2 eD
    nlinarith
  -- so `dim W = dim M`
  have hdim : topologicalKrullDim M = topologicalKrullDim W := by
    refine le_antisymm (not_lt.mp hnlt) ?_
    obtain ⟨-, ⟨V, hVd, hV⟩, -⟩ := MMP.topologicalKrullDim_fiber_of_isDominant ℂ sM sW f hfs
    obtain ⟨y, hyV⟩ := hVd.nonempty
    obtain ⟨x, hx⟩ := f.surjective y
    obtain ⟨Z₀, hZ₀, -⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      ({f.asFiber x} : Set (f.fiber (f x))) isIrreducible_singleton
    rw [← hx] at hyV
    have e := hV _ hyV Z₀ hZ₀
    have : Nonempty (TopologicalSpace.IrreducibleCloseds Z₀) := by
      obtain ⟨z, hz⟩ := hZ₀.1.nonempty
      exact ⟨⟨closure {⟨z, hz⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim Z₀ := Order.krullDim_nonneg
    rw [← e]
    exact le_add_of_nonneg_left h0
  have hbc : IsBirationalContraction ℂ sW sM f := ⟨hneg.isContraction, hdim⟩
  have hbir : IsBirationalMorphism f := hbc.surjective_and_isBirational.2
  by_cases hs : IsSmall ℂ sW sM f
  · exact .inr hs
  refine .inl ⟨hbir, ?_⟩
  haveI : IsSeparated sW := hWn.1.toIsSeparated
  have hfp : IsProjectiveMorphism f :=
    IsProjectiveMorphism.of_comp f sW (by rw [hfs]; exact hproj.isProjective)
  obtain ⟨F, hF⟩ := MMP.Flips.exists_primeDivisor_exceptionalSet_eq_support_of_not_isSmall sM sW
    hQ hWn f hbc hfp hneg.relativePicardNumber_eq_one hs
  refine ⟨F, ?_⟩
  rw [← hF]
  refine Set.Subset.antisymm ?_ (flips_exceptionalSet_subset f)
  haveI : JacobsonSpace M := LocallyOfFiniteType.jacobsonSpace sM
  rw [← closure_inter_closedPoints (MMP.Mori.isClosed_exceptionalSet f)]
  refine closure_minimal ?_ (MMP.Flips.isClosed_exceptionalSet f)
  rintro x ⟨hx, hxc⟩
  obtain ⟨Cs, hCc, hCi, hCd, hxC, y, hy⟩ :=
    MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hMn.1 hWn.1 f hfs
      hbir hneg.isContraction.isIso_app (mem_closedPoints_iff.mp hxc) hx
  rintro ⟨V, hxV, hVi⟩
  set η := hCi.genericPoint
  have hη : IsGenericPoint η Cs := by
    have := hCi.isGenericPoint_genericPoint_closure
    rwa [hCc.closure_eq] at this
  have hηx : η ⤳ x := hη.specializes hxC
  have hηV : η ∈ V := hηx.mem_open V.isOpen hxV
  have hne : η ≠ x := by
    intro e
    have hCx : Cs = {x} := by rw [← hη.def, e, (mem_closedPoints_iff.mp hxc).closure_eq]
    have : topologicalKrullDim Cs ≤ 0 := by
      subst hCx
      haveI : DiscreteTopology ({x} : Set M) := inferInstance
      exact topologicalKrullDim_zero_of_discreteTopology _
    rw [hCd] at this
    exact absurd this (by decide)
  have hfeq : f η = f x := by
    have h1 : f η ∈ f '' Cs := ⟨η, hη.mem, rfl⟩
    have h2 : f x ∈ f '' Cs := ⟨x, hxC, rfl⟩
    rw [hy] at h1 h2
    rw [h1, h2]
  have hinj : Function.Injective (V.ι ≫ f) := (V.ι ≫ f).isOpenEmbedding.injective
  have key := @hinj ⟨η, hηV⟩ ⟨x, hxV⟩ hfeq
  exact hne (congrArg V.ι key)

/-- An effective divisor on a `ℚ`-factorial variety has nonnegative degree on every proper curve
whose generic point is outside its support. -/
private theorem nonneg_of_isRIntersectionNumber_of_notMem_supp {M : Scheme.{0}} [IsIntegral M]
    [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M] {sM : M ⟶ Spec (.of ℂ)}
    (hQ : IsQFactorial sM) {N : RDivisor M} (hN : ∀ P, 0 ≤ N.coeff P) (Γ : ProperCurve sM)
    (hΓ : Γ.point ∉ (N.supp : Set M)) {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor M} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sM N r L Γ x) : 0 ≤ x := by
  haveI := hQ.1.1
  obtain ⟨k, q, Mj, hq, hMc, hMe, hDeq, -⟩ := exists_eq_sum_smul_of_isQFactorial hQ hN
  have hDsum : N = ∑ j, q j • Divisor.toRDivisor (Mj j) := by
    refine Finsupp.ext fun P => ?_
    have := hDeq P
    simp only [DivisorWithCoeffs.coeff] at this
    rw [this, Finsupp.finset_sum_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [Finsupp.smul_apply, smul_eq_mul]
    exact congrArg (q j * ·)
      (DivisorWithCoeffs.coeff_mapCoeffs (fun x : ℤ => (x : ℝ)) Int.cast_zero (Mj j) P)
  have eD := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ q Mj hMc
  rw [← hDsum] at eD
  rw [(IsRIntersectionNumber.eq_and_linear ℂ sM Γ).1 _ _ _ _ _ _ _ hx eD]
  refine Finset.sum_nonneg fun j _ => mul_nonneg (hq j).le ?_
  obtain ⟨c, hc⟩ := MMP.Threefold.Mori.exists_ι_eq_point Γ.point
  have hnot : Γ.point ∉ (Mj j).supp := by
    intro hmem
    obtain ⟨E, hE, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    apply hΓ
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hyE⟩
    have hpos : 0 < q j * ((Mj j).coeff E : ℝ) := mul_pos (hq j)
      (by exact_mod_cast lt_of_le_of_ne (hMe j E) (Ne.symm hE))
    have hle := Finset.single_le_sum (f := fun i => q i * ((Mj i).coeff E : ℝ))
      (fun i _ => mul_nonneg (hq i).le (by exact_mod_cast hMe i E)) (Finset.mem_univ j)
    rw [hDeq E]
    exact (lt_of_lt_of_le hpos hle).ne'
  exact_mod_cast (MMP.Threefold.Mori.degreeOn_nonneg_and_eq_zero_iff sM Γ.ι Γ.dim_le (Mj j)
    (hMc j) (DivisorWithCoeffs.isEffective_iff_nonneg.mp (hMe j))
    ⟨c, by change curveSubschemeAtι Γ.point c ∉ _; rw [hc]; exact hnot⟩).1

/-- **Every step of a floor program meets the floor.** Let `f` be a `(K + B)`-negative extremal
contraction over `Z` of a `ℚ`-factorial `M`, on which `K + B + l C` is numerically trivial for some
`l > 0`, and let `α (K + B) ≡_Z C + N` with `α > 0` and `N ≥ 0`. Then `C` is positive and `N`
negative on the contracted curves, so the exceptional set of `f` meets a component of `N`. -/
private theorem exists_coeff_ne_zero_inter_exceptionalSet {M W Z : Scheme.{0}} [IsIntegral M]
    [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M] {sM : M ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} {πM : M ⟶ Z} {f : M ⟶ W} {h : W ⟶ Z} {K : Divisor M}
    {B C N : RDivisor M} {α l : ℝ} (hQ : IsQFactorial sM)
    (hneg : IsNegativeExtremalContraction ℂ sM sW (logCanonicalDivisor K B) f)
    (hfh : f ≫ h = πM)
    (htriv : IsNumericallyTrivialOver ℂ sM f (logCanonicalDivisor K (B + l • C))) (hl : 0 < l)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P)
    (hnum : IsNumericallyEquivalentOver ℂ sM πM (α • logCanonicalDivisor K B) (C + N)) :
    ∃ G : MMP.Mori.PrimeDivisor M, N.coeff G ≠ 0 ∧
      ((MMP.Mori.exceptionalSet f : Set M) ∩ G.support).Nonempty := by
  haveI := hQ.1.1
  obtain ⟨Γ, hΓ⟩ :=
    exists_isContractedBy_of_relativePicardNumber_eq_one f hneg.relativePicardNumber_eq_one
  have hΓπ : Γ.IsContractedBy πM := fun x hx => by
    rw [← hfh, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ x hx]
  obtain ⟨m, r, L, hL, hKB⟩ := hneg.isCartierCombination
  have e1 := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ r L hL
  rw [← show logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j) from hKB] at e1
  have hx := isRIntersectionNumber_neg_of_isRelativelyAntiAmple f hneg.isRelativelyAntiAmple Γ
    hΓ _ _ _ e1
  obtain ⟨mC, rC, LC, hLC, hCeq⟩ :=
    isCartierCombination_of_isRCartier (MMP.Fourfold.IsQFactorial.isRCartier hQ C)
  have e2 := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ rC LC hLC
  rw [← show C = ∑ j, rC j • Divisor.toRDivisor (LC j) from hCeq] at e2
  obtain ⟨mN, rN, LN, hLN, hNeq⟩ :=
    isCartierCombination_of_isRCartier (MMP.Fourfold.IsQFactorial.isRCartier hQ N)
  have e3 := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sM Γ rN LN hLN
  rw [← show N = ∑ j, rN j • Divisor.toRDivisor (LN j) from hNeq] at e3
  set x₁ := ∑ j, r j * ((L j).degreeOn ℂ sM Γ.ι Γ.dim_le (hL j) : ℝ)
  set x₂ := ∑ j, rC j * ((LC j).degreeOn ℂ sM Γ.ι Γ.dim_le (hLC j) : ℝ)
  set x₃ := ∑ j, rN j * ((LN j).degreeOn ℂ sM Γ.ι Γ.dim_le (hLN j) : ℝ)
  -- the upper level is trivial on `Γ`
  have e12 := (IsRIntersectionNumber.eq_and_linear ℂ sM Γ).2 _ _ _ _ _ _ _ _ 1 l e1 e2
  rw [one_smul, show logCanonicalDivisor K B + l • C = logCanonicalDivisor K (B + l • C) by
    simp only [logCanonicalDivisor, add_assoc]] at e12
  have h12 := IsNumericallyTrivialOver.eq_zero htriv Γ hΓ _ _ _ e12
  -- the floor identity on `Γ`
  have eα := (IsRIntersectionNumber.eq_and_linear ℂ sM Γ).2 _ _ _ _ _ _ _ _ α 0 e1 e1
  rw [zero_smul, add_zero] at eα
  have e23 := (IsRIntersectionNumber.eq_and_linear ℂ sM Γ).2 _ _ _ _ _ _ _ _ 1 1 e2 e3
  rw [one_smul, one_smul] at e23
  have hfl := hnum.2.2 Γ hΓπ _ _ _ _ _ _ _ _ eα e23
  have hx₂ : 0 < x₂ := by
    by_contra hc
    push Not at hc
    nlinarith [mul_nonpos_of_nonneg_of_nonpos hl.le hc]
  have hmem : Γ.point ∈ (N.supp : Set M) := by
    by_contra hnot
    have := nonneg_of_isRIntersectionNumber_of_notMem_supp hQ hN Γ hnot e3
    nlinarith [mul_neg_of_pos_of_neg hα hx]
  obtain ⟨G, hG, hyG⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
  exact ⟨G, hG, Γ.point, point_mem_exceptionalSet Γ hΓ, hyG⟩

/-! ### The criterion for log minimal models reached by a negative program -/

namespace FSPCrit

section CartierCombination

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]

private theorem isCartierCombination_add {D E : RDivisor X} (hD : IsCartierCombination D)
    (hE : IsCartierCombination E) : IsCartierCombination (D + E) := by
  obtain ⟨m, r, L, hL, rfl⟩ := hD
  obtain ⟨m', r', L', hL', rfl⟩ := hE
  refine ⟨m + m', Fin.append r r', Fin.append L L', fun j => ?_, ?_⟩
  · refine Fin.addCases (motive := fun j => (Fin.append L L' j).IsCartier)
      (fun i => ?_) (fun i => ?_) j
    · simpa using hL i
    · simpa using hL' i
  · simp [Fin.sum_univ_add]

private theorem isCartierCombination_zero' : IsCartierCombination (0 : RDivisor X) :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => Fin.elim0 j, by simp⟩

/-- Every `ℝ`-divisor on a `ℚ`-factorial variety is a real combination of Cartier divisors. -/
private theorem isCartierCombination_of_isQFactorial {k : Type} [Field k] [IsIntegral X]
    {sX : X ⟶ Spec (.of k)} (hQ : IsQFactorial sX) (D : RDivisor X) : IsCartierCombination D := by
  induction D using Finsupp.induction_linear with
  | zero => exact isCartierCombination_zero'
  | add D E hD hE => exact isCartierCombination_add hD hE
  | single P r =>
    obtain ⟨m, hm, hc⟩ := hQ.2 (Finsupp.single P 1)
    refine ⟨1, ![r / m], ![(m : ℤ) • Finsupp.single P 1], fun j => by fin_cases j; exact hc, ?_⟩
    have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
    ext Q
    by_cases hPQ : P = Q
    · subst hPQ
      simp [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.mapCoeffs]
      field_simp
    · simp [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.mapCoeffs,
        Finsupp.single_apply, hPQ]

end CartierCombination

section Numerical

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X]

end Numerical

section NefCombination

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X]

