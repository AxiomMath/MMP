section ScalingHelpers

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)}

/-- **A curve of negative degree lies in a component.** On a normal `ℚ`-factorial variety, an
effective `ℝ`-divisor `E` of negative degree on a proper curve `C` has a component containing
`C`. -/
private theorem exists_coeff_ne_zero_of_isRIntersectionNumber_neg [QuasiCompact sX]
    (hQ : IsQFactorial sX) {E : RDivisor X} (hE : ∀ P, 0 ≤ E.coeff P) (C : ProperCurve sX)
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX E r L C x) (hneg : x < 0) :
    ∃ P : MMP.Mori.PrimeDivisor X, E.coeff P ≠ 0 ∧ C.point ∈ P.support := by
  classical
  by_contra hno
  push Not at hno
  choose mult hmult hcart using fun P : MMP.Mori.PrimeDivisor X =>
    hQ.2 (Finsupp.single P (1 : ℤ))
  let e := E.support.equivFin
  let P : Fin E.support.card → MMP.Mori.PrimeDivisor X := fun j => (e.symm j : _)
  let PD : Fin E.support.card → Divisor X := fun j =>
    ((mult (P j) : ℕ) : ℤ) • Finsupp.single (P j) (1 : ℤ)
  have hL : ∀ j, (PD j).IsCartier := fun j => hcart (P j)
  have hterm : ∀ Q : MMP.Mori.PrimeDivisor X,
      (E Q / (mult Q : ℝ)) • Divisor.toRDivisor (((mult Q : ℕ) : ℤ) • Finsupp.single Q (1 : ℤ)) =
        Finsupp.single Q (E Q) := by
    intro Q
    have hm : (mult Q : ℝ) ≠ 0 := by exact_mod_cast (hmult Q).ne'
    ext Q'
    simp only [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    by_cases hQ : Q = Q'
    · subst hQ
      simp [DivisorWithCoeffs.coeff_apply]
      field_simp
    · simp [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, hQ]
  have hEeq : E = ∑ j, (E (P j) / (mult (P j) : ℝ)) • Divisor.toRDivisor (PD j) := by
    rw [Equiv.sum_comp e.symm (fun Q : E.support => (E Q / (mult (Q : MMP.Mori.PrimeDivisor X) : ℝ)) •
      Divisor.toRDivisor (((mult (Q : MMP.Mori.PrimeDivisor X) : ℕ) : ℤ) •
        Finsupp.single (Q : MMP.Mori.PrimeDivisor X) (1 : ℤ) : Divisor X))]
    rw [Finset.sum_coe_sort E.support (fun Q => (E Q / (mult Q : ℝ)) •
      Divisor.toRDivisor (((mult Q : ℕ) : ℤ) • Finsupp.single Q (1 : ℤ) : Divisor X))]
    simp_rw [hterm]
    exact (Finsupp.sum_single E).symm
  have hx' := MMP.Flips.eq_sum_degreeOn_of_isRIntersectionNumber ℂ sX C _ _ hL hEeq hx
  have : 0 ≤ x := by
    rw [hx']
    refine Finset.sum_nonneg fun j _ => mul_nonneg (div_nonneg (hE _) (by positivity)) ?_
    have hne : ∃ c : C.scheme, C.ι c ∉ (PD j).supp := by
      refine ⟨genericPoint C.scheme, ?_⟩
      rw [MMP.Mori.ProperCurve.ι_genericPoint]
      intro hmem
      obtain ⟨F, hF, hxF⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
      have hFP : P j = F := by
        by_contra h
        apply hF
        simp [PD, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, h]
      subst hFP
      have hPE : E (P j) ≠ 0 := Finsupp.mem_support_iff.mp (e.symm j).2
      exact hno (P j) hPE hxF
    have h0 := (MMP.Threefold.Mori.degreeOn_nonneg_and_eq_zero_iff sX C.ι C.dim_le _ (hL j)
      (smul_nonneg (by positivity) (Finsupp.single_nonneg.mpr zero_le_one)) hne).1
    exact_mod_cast h0
  linarith

/-- **Curves contracted by a negative contraction lie in `E`.** If `D ≡_Z E` with `E ≥ 0` and
`-D` is ample over a contraction `f` over `Z`, every curve contracted by `f` lies in a component
of `E`: its degree against `E` is `D · C < 0`. -/
private theorem exists_coeff_ne_zero_of_isContractedBy [QuasiCompact sX] (hQ : IsQFactorial sX)
    {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)} {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z}
    (hfh : f ≫ h = π) {D E : RDivisor X} (hneg : IsNegativeExtremalContraction ℂ sX sW D f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P)
    (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) :
    ∃ P : MMP.Mori.PrimeDivisor X, E.coeff P ≠ 0 ∧ Γ.point ∈ P.support := by
  have hΓπ : Γ.IsContractedBy π := fun y hy => by
    rw [← hfh]
    change h (f y) = h (f Γ.point)
    rw [hΓ y hy]
  obtain ⟨_, rD, LD, x, hx⟩ := exists_isRIntersectionNumber (k := ℂ) hnum.1 Γ
  obtain ⟨_, rE, LE, y, hy⟩ := exists_isRIntersectionNumber (k := ℂ) hnum.2.1 Γ
  have hxy := hnum.2.2 Γ hΓπ _ _ _ _ _ _ _ _ hx hy
  have hxneg : x < 0 := by
    have h' := (IsRIntersectionNumber.eq_and_linear ℂ sX Γ).2 _ _ _ _ _ _ _ _ (-1) 0 hx hx
    rw [zero_smul, add_zero, neg_one_smul] at h'
    have := pos_of_isRelativelyAmple hneg.isRelativelyAntiAmple Γ hΓ h'
    linarith
  exact exists_coeff_ne_zero_of_isRIntersectionNumber_neg hQ hE0 Γ hy (hxy ▸ hxneg)

/-- **The exceptional divisor of a negative divisorial contraction is a component.** If
`D ≡_Z E` with `E ≥ 0` and `-D` is ample over a birational contraction `f` over `Z` whose
exceptional locus is the prime divisor `F`, then `F` is a component of `E`: through a closed point
of `F` off the other components of `E` passes a curve contracted by `f`, and every contracted
curve lies in a component of `E`. -/
private theorem coeff_ne_zero_of_exceptionalSet_eq [QuasiCompact sX] (hQ : IsQFactorial sX)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) {W Z : Scheme.{0}} {sW : W ⟶ Spec (.of ℂ)}
    {f : X ⟶ W} {h : W ⟶ Z} {π : X ⟶ Z} (hfh : f ≫ h = π) {D E : RDivisor X}
    (hneg : IsNegativeExtremalContraction ℂ sX sW D f) (hfb : IsBirationalMorphism f)
    (hnum : IsNumericallyEquivalentOver ℂ sX π D E) (hE0 : ∀ P, 0 ≤ E.coeff P)
    {F : MMP.Mori.PrimeDivisor X} (hF : (MMP.Mori.exceptionalSet f : Set X) = F.support) :
    E.coeff F ≠ 0 := by
  intro h0
  haveI : LocallyOfFiniteType sX := hQ.1.1.toLocallyOfFiniteType
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hXp.isProjective
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  have hPc : ∀ P : MMP.Mori.PrimeDivisor X, IsClosed P.support := fun P => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  set B : Set X := ⋃ P ∈ E.support, P.support with hB
  have hBc : IsClosed B := (E.support.finite_toSet).isClosed_biUnion fun P _ => hPc P
  have hFB : F.genericPoint ∉ B := by
    simp only [hB, Set.mem_iUnion]
    rintro ⟨P, hP, hFP⟩
    obtain rfl := eq_of_genericPoint_mem_support hFP
    exact (Finsupp.mem_support_iff.mp hP) h0
  have hFmem : F.genericPoint ∈ F.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  obtain ⟨y, ⟨hyF, hyB⟩, hyc⟩ := nonempty_inter_closedPoints (Z := F.support ∩ Bᶜ)
    ⟨F.genericPoint, hFmem, hFB⟩
    ((hPc F).isLocallyClosed.inter hBc.isOpen_compl.isLocallyClosed)
  have hyE : y ∈ (MMP.Mori.exceptionalSet f : Set X) := hF ▸ hyF
  haveI : IsProper f := hneg.isContraction.isProper
  obtain ⟨Cs, hCc, hCi, hCd, hyC, w, hw⟩ :=
    MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hQ.1.1
      hneg.isNormalVariety_target.1 f hneg.isContraction.comp_eq hfb
      hneg.isContraction.isIso_app (mem_closedPoints_iff.mp hyc) hyE
  have hgen := hCi.isGenericPoint_genericPoint_closure
  rw [hCc.closure_eq] at hgen
  have hη1 : topologicalKrullDim (MMP.Mori.curveSubschemeAt hCi.genericPoint) = 1 := by
    rw [MMP.Chow.topologicalKrullDim_curveSubschemeAt_eq, hgen.def, hCd]
  let Γ : ProperCurve sX := ⟨hCi.genericPoint, MMP.Mori.isProperCurve_of_isProper sX hη1⟩
  have hΓf : Γ.IsContractedBy f := by
    intro x hx
    change x ∈ closure {hCi.genericPoint} at hx
    rw [hgen.def] at hx
    have h1 : f x ∈ ({w} : Set W) := hw ▸ ⟨x, hx, rfl⟩
    have h2 : f hCi.genericPoint ∈ ({w} : Set W) := hw ▸ ⟨_, hgen.mem, rfl⟩
    exact h1.trans h2.symm
  obtain ⟨P, hP, hΓP⟩ := exists_coeff_ne_zero_of_isContractedBy hQ hfh hneg hnum hE0 Γ hΓf
  apply hyB
  simp only [hB, Set.mem_iUnion]
  exact ⟨P, Finsupp.mem_support_iff.mpr hP, (hgen.specializes hyC).mem_closed (hPc P) hΓP⟩

end ScalingHelpers

end FSPCne

/-- The inverse transform of a prime divisor under the identity is the prime divisor itself. -/
private theorem inverseTransformPrimeDivisor_id {W : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor W) :
    MMP.Mori.inverseTransformPrimeDivisor (𝟙 W) Q = some Q := by
  have h := MMP.Fourfold.inverseTransformDivisor_id (R := ℤ) (Finsupp.single Q 1)
  rw [MMP.Mori.inverseTransformDivisor_single] at h
  rcases h2 : MMP.Mori.inverseTransformPrimeDivisor (𝟙 W) Q with _ | Q'
  · rw [h2] at h
    exact absurd h.symm (by simp)
  · rw [h2] at h
    exact congrArg some ((Finsupp.single_left_inj one_ne_zero).mp h)

/-- **Strict transforms along a divisorial contraction.** For a proper birational morphism
`f : M ⟶ W` onto a normal variety whose exceptional set is a prime divisor, followed by the
identity of `W`: the strict transform `(𝟙)⁻¹_* f_*` is `f_*`, it preserves coefficients, every
prime divisor of `W` is a strict transform, and every prime divisor of `M` other than the
exceptional one has a strict transform. -/
private theorem flipTransform_fields_of_divisorial {M W : Scheme.{0}} [IsIntegral M]
    [IsLocallyNoetherian M] [IsNormal M] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    [IsSeparated (W ↘ ⊤_ Scheme)] (f : M ⟶ W) [IsProper f] (hf : IsBirationalMorphism f)
    {G : MMP.Mori.PrimeDivisor M} (hG : (MMP.Mori.exceptionalSet f : Set M) = G.support) :
    (∀ D : RDivisor M, flipTransform f (𝟙 W) D =
      MMP.Mori.RationalMap.transformDivisor (X := M) f.toRationalMap D) ∧
    (∀ (P : MMP.Mori.PrimeDivisor M) (P' : MMP.Mori.PrimeDivisor W),
      flipTransformPrimeDivisor f (𝟙 W) P = some P' →
        ∀ D : RDivisor M, (flipTransform f (𝟙 W) D).coeff P' = D.coeff P) ∧
    (∀ P' : MMP.Mori.PrimeDivisor W, ∃ P, flipTransformPrimeDivisor f (𝟙 W) P = some P') ∧
    (∀ P : MMP.Mori.PrimeDivisor M,
      (∃ P', flipTransformPrimeDivisor f (𝟙 W) P = some P') ∨
        (MMP.Mori.exceptionalSet f : Set M) = P.support) ∧
    (∀ P : MMP.Mori.PrimeDivisor M, (MMP.Mori.exceptionalSet f : Set M) = P.support →
      flipTransformPrimeDivisor f (𝟙 W) P = none) ∧
    ∀ P : MMP.Mori.PrimeDivisor M, flipTransformPrimeDivisor f (𝟙 W) P =
      MMP.Mori.RationalMap.transformPrimeDivisor (X := M) f.toRationalMap P := by
  haveI : IsDominant f := hf.isDominant
  have hD : ∀ D : RDivisor M, flipTransform f (𝟙 W) D =
      MMP.Mori.RationalMap.transformDivisor (X := M) f.toRationalMap D := fun D => by
    simp only [flipTransform, AddMonoidHom.coe_comp, Function.comp_apply,
      MMP.Fourfold.inverseTransformDivisor_id]
  have hP : ∀ P, flipTransformPrimeDivisor f (𝟙 W) P =
      MMP.Mori.RationalMap.transformPrimeDivisor (X := M) f.toRationalMap P := fun P => by
    unfold flipTransformPrimeDivisor
    rcases MMP.Mori.RationalMap.transformPrimeDivisor (X := M) f.toRationalMap P with _ | Q
    · rfl
    · exact inverseTransformPrimeDivisor_id Q
  have hiff := fun P P' => MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P P'
  refine ⟨hD, fun P P' hPP' D => ?_, fun P' => ?_, fun P => ?_, fun P hPE => ?_, hP⟩
  · rw [hP, hiff] at hPP'
    rw [hD]
    exact FSPCrit.coeff_transformDivisor_hom hf.functionFieldMap_bijective D hPP'
  · have hb := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hf
      (P'.coheight_genericPoint.le)
    obtain ⟨P, hPη, -⟩ :=
      FSPCrit.exists_primeDivisor_map_eq_of_mem_biregularLocus f hb P'.coheight_genericPoint
    exact ⟨P, by rw [hP, hiff]; exact hPη⟩
  · by_cases hPG : P = G
    · subst hPG; exact Or.inr hG
    · left
      have hη : P.genericPoint ∉ (MMP.Mori.exceptionalSet f : Set M) := by
        rw [hG]; exact FSPCrit.genericPoint_notMem_support_of_ne hPG
      have hb : f P.genericPoint ∈ MMP.Mori.biregularLocus f := by
        by_contra hb
        exact hη (MMP.Mori.mem_exceptionalSet.mpr hb)
      have h1 : Order.coheight (f P.genericPoint) = 1 := by
        rw [MMP.Positivity.coheight_map_of_mem_biregularLocus _ hb, P.coheight_genericPoint]
      refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1, ?_⟩
      rw [hP, hiff]
      exact (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1).symm
  · rcases h : flipTransformPrimeDivisor f (𝟙 W) P with _ | P'
    · rfl
    · exfalso
      rw [hP, hiff] at h
      have hb := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hf
        (P'.coheight_genericPoint.le)
      rw [← h] at hb
      have hη : P.genericPoint ∈ (MMP.Mori.exceptionalSet f : Set M) := by
        rw [hPE, AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      exact (MMP.Mori.mem_exceptionalSet.mp hη) hb

/-- The strict transform of divisors along the identity is the identity. -/
private theorem transformDivisor_id_toRationalMap {X : Scheme.{0}} [IsReduced X]
    [IsSeparated (X ↘ ⊤_ Scheme)] {R : Type*} [AddCommMonoid R] (D : DivisorWithCoeffs R X) :
    MMP.Mori.RationalMap.transformDivisor (X := X) (Scheme.Hom.toRationalMap (𝟙 X)) D = D := by
  have h : ∀ P, MMP.Mori.RationalMap.transformPrimeDivisor (X := X)
      (Scheme.Hom.toRationalMap (𝟙 X)) P = some P := fun P =>
    (MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff (𝟙 X) P P).mpr rfl
  refine Finsupp.ext fun Q => ?_
  exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq (h Q)
    (fun P hP => Option.some_injective _ ((h P).symm.trans hP)) D

section DivisorialSteps

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X]

/-- The negative of an anti-ample divisor is nef. -/
private theorem isRelativelyNef_neg_of_isRelativelyAntiAmple {W : Scheme.{0}} (f : X ⟶ W)
    {D : RDivisor X} (hD : IsRelativelyAntiAmple f D) : IsRelativelyNef ℂ sX f (-D) := by
  obtain ⟨m, a, A, -, -, hA, hDeq⟩ := id hD
  refine ⟨m, a, A, fun j => (hA j).1, hDeq, fun Γ hΓ x hx => ?_⟩
  obtain ⟨m', r', L', hx'⟩ := isRIntersectionNumber_neg hx
  rw [neg_neg] at hx'
  have := isRIntersectionNumber_neg_of_isRelativelyAntiAmple f hD Γ hΓ _ _ _ hx'
  linarith

/-- Numerical triviality over `f` passes to `f ≫ g` for an injective `g`. -/
private theorem IsNumericallyTrivialOver.comp_of_injective {W W' : Scheme.{0}} {f : X ⟶ W}
    {g : W ⟶ W'} (hg : Function.Injective g) {D : RDivisor X}
    (h : IsNumericallyTrivialOver ℂ sX f D) : IsNumericallyTrivialOver ℂ sX (f ≫ g) D :=
  ⟨h.1, h.2.1, fun Γ hΓ => h.2.2 Γ fun x hx => hg (by simpa using hΓ x hx)⟩

end DivisorialSteps

/-- A divisor over a normal variety is exceptional exactly when its centre has codimension at
least two. -/
private theorem DivisorOver.isExceptional_iff_two_le_coheight {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (D : DivisorOver ℂ sX) :
    D.IsExceptional ↔ 2 ≤ Order.coheight (D.f D.E.genericPoint) := by
  have := D.isLocallyNoetherian
  have := D.isNormal
  have : IsSeparated sX := hX.1.toIsSeparated
  have : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  unfold DivisorOver.IsExceptional
  rw [MMP.Positivity.isExceptional_toRationalMap_iff]
  have hcl : Closeds.closure (D.f '' (D.E.idealSheaf.support : Set D.Y)) =
      ⟨(D.center : Set X), D.center.isClosed⟩ := Closeds.ext rfl
  rw [hcl, closedsCodimension_coe, MMP.Positivity.DivisorOver.codimension_center]

/-- **Plt across a negative divisorial contraction.** Let `f : M ⟶ M'` be a birational
contraction of `ℚ`-factorial normal varieties whose exceptional set is the prime divisor `G`, and
`Γ` a boundary with coefficients at most one such that `-(K + Γ)` is `f`-nef and either
`-(K + Γ)` is `f`-ample or `Γ` has coefficient `< 1` along `G`. If `(M, Γ)` has positive log
discrepancies along exceptional divisors, so has `(M', f_* Γ)`: every divisor over `M'` is a
divisor over `M` with no smaller log discrepancy, the inequality being strict over `G` when
`-(K + Γ)` is `f`-ample, and `a(G; M, Γ) = 1 - mult_G Γ`. -/
private theorem pos_of_isLogDiscrepancy_of_divisorial {M M' : Scheme.{0}} [IsIntegral M]
    [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M] [IsIntegral M'] [CompactSpace M']
    [IsLocallyNoetherian M'] [IsNormal M'] {sM : M ⟶ Spec (.of ℂ)} {sM' : M' ⟶ Spec (.of ℂ)}
    (hM' : IsNormalVariety ℂ sM') (hQ : IsQFactorial sM) (hQ' : IsQFactorial sM')
    {f : M ⟶ M'} [IsProper f] (hfs : f ≫ sM' = sM) (hfc : IsBirationalContraction ℂ sM' sM f)
    {G : MMP.Mori.PrimeDivisor M} (hG : MMP.Flips.exceptionalSet f = G.support)
    {K : Divisor M} {K' : Divisor M'} {m m' : ℕ} (hK : K.IsCanonicalDivisor sM m)
    (hK' : K'.IsCanonicalDivisor sM' m') {Γ : RDivisor M}
    (hanti : IsRelativelyNef ℂ sM f (-logCanonicalDivisor K Γ))
    (hG1 : Γ.coeff G < 1 ∨ IsRelativelyAntiAmple f (logCanonicalDivisor K Γ))
    (hΓ1 : ∀ P, Γ.coeff P ≤ 1)
    (hplt : ∀ (n : ℕ) (D : DivisorOver ℂ sM) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sM n Γ D a → 0 < a) :
    ∀ (n : ℕ) (D' : DivisorOver ℂ sM') (a' : ℝ), D'.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy sM' n
        (MMP.Mori.RationalMap.transformDivisor (X := M) f.toRationalMap Γ) D' a' → 0 < a' := by
  classical
  intro n D' a' hD' ha'
  subst hfs
  have hM : IsNormalVariety ℂ (f ≫ sM') := hQ.1
  have hfb : IsBirationalMorphism f := hfc.surjective_and_isBirational.2
  haveI : IsDominant f := hfb.isDominant
  haveI : LocallyOfFiniteType sM' := hM'.1.toLocallyOfFiniteType
  haveI : QuasiCompact sM' := hM'.1.toQuasiCompact
  haveI : IsSeparated (M' ↘ ⊤_ Scheme) := by
    haveI : IsSeparated sM' := hM'.1.toIsSeparated
    rw [show (M' ↘ ⊤_ Scheme) = sM' ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  set Γ' := MMP.Mori.RationalMap.transformDivisor (X := M) f.toRationalMap Γ with hΓ'
  -- realize `D'` over `M`
  obtain ⟨D₁, -, hn, hb, hp, hv⟩ :=
    MMP.Flips.ProperDivisorOver.exists_comap_functionFieldMap_valuation_eq hM'.1 f hM.1 hfb
      ⟨D', ha'.2.1⟩
  haveI := D₁.isIntegral
  haveI := D₁.isNormal
  haveI := D₁.isLocallyNoetherian
  haveI := D₁.isProper
  haveI : CompactSpace D₁.Y := QuasiCompact.compactSpace_of_compactSpace D₁.f
  obtain ⟨a₁, ha₁⟩ := FSPRef.exists_isLogDiscrepancy_of_isQFactorial hM hQ hK Γ D₁.toDivisorOver
    D₁.isProper
  let D₂ : DivisorOver ℂ sM' := ⟨D₁.Y, D₁.f ≫ f, hn, hb, D₁.E⟩
  have hv₂ : D₂.valuation = D'.valuation := hv
  obtain ⟨a₂, ha₂⟩ := FSPRef.exists_isLogDiscrepancy_of_isQFactorial hM' hQ' hK' Γ' D₂ hp
  have ha₂' : a₂ = a' := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha₂ ha' hv₂
  have hKΓ := FSPRef.isCartierCombination_of_isQFactorial hQ (logCanonicalDivisor K Γ)
  have hKΓ' := FSPRef.isCartierCombination_of_isQFactorial hQ' (logCanonicalDivisor K' Γ')
  have hD₁n : IsNormalVariety ℂ (D₁.f ≫ f ≫ sM') := D₁.isNormalVariety
  -- the comparison over `M'`
  have hle : a₁ ≤ a₂ := by
    haveI : IsProper (D₁.f ≫ f) := hp
    exact FSPCrit.isLogDiscrepancy_le_of_step hM' (f := f) (g := 𝟙 M') rfl (Category.id_comp _)
      hM hM' hfb (MMP.Mori.isBirationalMorphism_of_isIso _) hK hK'
      (by rw [transformDivisor_id_toRationalMap]) hKΓ hKΓ' hanti
      (FSPCrit.isRelativelyNef_of_injective (Scheme.Hom.isOpenEmbedding (𝟙 M')).injective hKΓ')
      (r := D₁.f) (r' := D₁.f ≫ f) (Category.comp_id _).symm hD₁n hn D₁.isBirationalMorphism hb
      D₁.E ha₁ ha₂
  by_cases hex : D₁.toDivisorOver.IsExceptional
  · exact ha₂' ▸ (hplt _ _ _ hex ha₁).trans_le hle
  -- otherwise `D₁` is a prime divisor `P` of `M`, which must be `G`
  obtain ⟨P, hP⟩ := MMP.Fourfold.exists_valuation_eq_of_not_isExceptional hM hex
  have hD₁P : D₁.f D₁.E.genericPoint = P.genericPoint :=
    MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hM.1 hP
  have hKΓr := MMP.Fourfold.IsQFactorial.isRCartier hQ (Divisor.toRDivisor K + Γ)
  have hP1 : a₁ = 1 - Γ.coeff P := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha₁
    (isLogDiscrepancy_ofPrimeDivisor hM hK hKΓr P) hP
  by_cases hPG : P = G
  · subst hPG
    rcases hG1 with h1 | h1
    · have := hΓ1 P
      rw [← ha₂']
      linarith
    · have hlt : a₁ < a₂ := by
        haveI : IsProper (D₁.f ≫ f) := hp
        exact FSPCrit.isLogDiscrepancy_lt_of_isBirationalContraction hM' rfl hM hfc hG hK hK' rfl
          hKΓ hKΓ' h1 (r := D₁.f) (r' := D₁.f ≫ f) rfl hD₁n hn D₁.isBirationalMorphism hb D₁.E
          hD₁P ha₁ ha₂
      have := hΓ1 P
      rw [← ha₂']
      linarith
  · exfalso
    -- the centre of `D'` is the codimension-one point `f(η_P)`
    have hη : P.genericPoint ∉ MMP.Flips.exceptionalSet f := by
      rw [hG]; exact FSPCrit.genericPoint_notMem_support_of_ne hPG
    have hc1 : Order.coheight (f P.genericPoint) = 1 := by
      rw [MMP.Flips.coheight_map_of_notMem_exceptionalSet hη, P.coheight_genericPoint]
    have hcen : D'.f D'.E.genericPoint = f P.genericPoint := by
      rw [← MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hM'.1 hv₂]
      change f (D₁.f D₁.E.genericPoint) = _
      rw [hD₁P]
    have := (DivisorOver.isExceptional_iff_two_le_coheight hM' D').mp hD'
    rw [hcen, hc1] at this
    exact absurd this (by decide)

/-- **A birational morphism as a partial isomorphism**, defined on the preimage of its biregular
locus, whose target contains the points of codimension at most one when the target is normal. -/
private theorem exists_partialIso_of_isBirationalMorphism {M M' : Scheme.{0}} [IsIntegral M]
    [IsIntegral M'] [IsLocallyNoetherian M'] [IsNormal M'] {sM : M ⟶ Spec (.of ℂ)}
    {sM' : M' ⟶ Spec (.of ℂ)} (f : M ⟶ M') [IsProper f] (hf : IsBirationalMorphism f)
    (hfs : f ≫ sM' = sM) :
    ∃ ε : M.PartialIso M', ε.toRationalMap = f.toRationalMap ∧ ε.IsOver sM sM' ∧
      (∀ x : M', Order.coheight x ≤ 1 → x ∈ ε.target) ∧
      (∀ x : M, f x ∈ MMP.Mori.biregularLocus f → x ∈ ε.source) ∧
      ∀ (x : M) (hx : x ∈ ε.source), ε.toPartialMap.hom ⟨x, hx⟩ = f x := by
  set V := MMP.Mori.biregularLocus f with hV
  haveI : IsIso (f ∣_ V) := MMP.Mori.isBiregular_biregularLocus f
  have hVc : ∀ y : M', Order.coheight y ≤ 1 → y ∈ V := fun y hy =>
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f hf hy
  have hd' : Dense (V : Set M') := dense_of_forall_coheight_le_one V hVc
  haveI : IsDominant f := hf.isDominant
  have hg : Order.coheight (genericPoint M') ≤ 1 := by
    rw [Order.coheight_eq_zero.mpr]
    · exact zero_le_one
    · intro b _
      exact Scheme.le_iff_specializes.mpr ((genericPoint_spec M').specializes (Set.mem_univ b))
  have hd : Dense ((f ⁻¹ᵁ V : M.Opens) : Set M) := by
    obtain ⟨x, hx⟩ := f.denseRange.exists_mem_open V.isOpen ⟨_, hVc _ hg⟩
    exact (f ⁻¹ᵁ V).isOpen.dense ⟨x, hx⟩
  refine ⟨⟨f ⁻¹ᵁ V, hd, V, hd', asIso (f ∣_ V)⟩, ?_, ?_, hVc, fun x hx => hx, fun x hx => ?_⟩
  · rw [Scheme.PartialIso.toRationalMap]
    change _ = f.toPartialMap.toRationalMap
    rw [← Scheme.PartialMap.restrict_toRationalMap f.toPartialMap (f ⁻¹ᵁ V) hd le_top]
    congr 1
    refine Scheme.PartialMap.ext _ _ rfl ?_
    simp only [Scheme.PartialIso.toPartialMap_hom, Scheme.PartialMap.restrict_hom,
      Scheme.Hom.toPartialMap_hom, asIso_hom, morphismRestrict_ι]
    change (f ⁻¹ᵁ V).ι ≫ f = (M.isoOfEq _).hom ≫ (M.homOfLE le_top ≫ M.topIso.hom ≫ f)
    simp only [Scheme.topIso_hom, Scheme.homOfLE_ι_assoc]
    exact (Scheme.isoOfEq_hom_ι_assoc M _ f).symm
  · change (f ∣_ V) ≫ V.ι ≫ sM' = (f ⁻¹ᵁ V).ι ≫ sM
    rw [morphismRestrict_ι_assoc, hfs]
  · change ((f ∣_ V) ≫ V.ι) ⟨x, hx⟩ = f x
    rw [morphismRestrict_ι]
    rfl

/-- The inverse of a partial isomorphism undoes it. -/
private theorem PartialIso.symm_hom_hom {X Y : Scheme.{0}} (φ : X.PartialIso Y) (x : X)
    (hx : x ∈ φ.source) (hy : φ.toPartialMap.hom ⟨x, hx⟩ ∈ φ.target) :
    φ.symm.toPartialMap.hom ⟨φ.toPartialMap.hom ⟨x, hx⟩, hy⟩ = x := by
  change φ.source.ι (φ.iso.inv ⟨φ.target.ι (φ.iso.hom ⟨x, hx⟩), hy⟩) = x
  have e1 : (⟨φ.target.ι (φ.iso.hom ⟨x, hx⟩), hy⟩ : φ.target.toScheme) = φ.iso.hom ⟨x, hx⟩ :=
    Subtype.ext rfl
  rw [e1]
  change φ.source.ι ((φ.iso.hom ≫ φ.iso.inv) ⟨x, hx⟩) = x
  rw [Iso.hom_inv_id]
  rfl

/-- The coefficient of a strict transform along a composite of partial isomorphisms, at the
transform of a prime divisor in the source of the second one. -/
private theorem coeff_transformDivisor_trans_of_mem_source {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsIntegral Z] [IsSeparated (Y ↘ ⊤_ Scheme)] [IsSeparated (Z ↘ ⊤_ Scheme)]
    (e : X.PartialIso Y) (φ : Y.PartialIso Z) {Q : MMP.Mori.PrimeDivisor Y}
    {Q' : MMP.Mori.PrimeDivisor Z} (hQ : Q.genericPoint ∈ φ.source)
    (hval : Q'.genericPoint = φ.toPartialMap.hom ⟨Q.genericPoint, hQ⟩)
    (hQ't : Q'.genericPoint ∈ φ.target) (D : QDivisor X) :
    (MMP.Mori.RationalMap.transformDivisor (e.trans φ).toRationalMap D) Q' =
      (MMP.Mori.RationalMap.transformDivisor e.toRationalMap D) Q := by
  classical
  rw [apply_eq_sum_of_map_single _ _ (MMP.Mori.RationalMap.transformDivisor_single _) D Q',
    apply_eq_sum_of_map_single _ _ (MMP.Mori.RationalMap.transformDivisor_single _) D Q]
  refine Finset.sum_congr rfl fun P _ => ?_
  have hiff : MMP.Mori.RationalMap.transformPrimeDivisor (e.trans φ).toRationalMap P = some Q' ↔
      MMP.Mori.RationalMap.transformPrimeDivisor e.toRationalMap P = some Q := by
    refine ⟨fun h => ?_, fun h => FSPRef.transformPrimeDivisor_trans_eq_some e φ h hQ hval⟩
    have hQ1 : Q.genericPoint = φ.symm.toPartialMap.hom ⟨Q'.genericPoint, hQ't⟩ :=
      calc Q.genericPoint
          = φ.symm.toPartialMap.hom ⟨φ.toPartialMap.hom ⟨Q.genericPoint, hQ⟩, hval ▸ hQ't⟩ :=
            (PartialIso.symm_hom_hom φ _ hQ _).symm
        _ = φ.symm.toPartialMap.hom ⟨Q'.genericPoint, hQ't⟩ := by
            congr 1
            exact Subtype.ext hval.symm
    exact FSPRef.transformPrimeDivisor_eq_some_of_trans e φ h hQ't hQ1
  by_cases h : MMP.Mori.RationalMap.transformPrimeDivisor e.toRationalMap P = some Q
  · rw [if_pos (hiff.mpr h), if_pos h]
  · rw [if_neg (fun h' => h (hiff.mp h')), if_neg h]

/-- Relative nefness only depends on the structure morphism, not on its spelling. -/
private theorem IsRelativelyNef.congr_str {X W : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {s₁ s₂ : X ⟶ Spec (.of ℂ)} [QuasiCompact s₁] [QuasiCompact s₂] {f : X ⟶ W}
    {D : RDivisor X} (e : s₁ = s₂) (h : IsRelativelyNef ℂ s₁ f D) :
    IsRelativelyNef ℂ s₂ f D := by
  subst e
  exact h

/-- A positive real function on a finite set has a positive lower bound there. -/
private theorem exists_pos_forall_le_of_finite {α : Type*} {S : Set α} (hS : S.Finite)
    (g : α → ℝ) (hg : ∀ a ∈ S, 0 < g a) : ∃ ε > 0, ∀ a ∈ S, ε ≤ g a := by
  classical
  obtain ⟨T, rfl⟩ := hS.exists_finset_coe
  refine ⟨(insert 1 (T.image g)).min' (Finset.insert_nonempty _ _), ?_, fun a ha =>
    Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem g ha))⟩
  show 0 < _
  rw [Finset.lt_min'_iff]
  intro y hy
  rcases Finset.mem_insert.mp hy with rfl | hy
  · exact one_pos
  · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hy
    exact hg a ha

/-- The strict transform of an adjoint along a real flip step is the adjoint of the strict
transforms, and the strict transform commutes with real scalars. -/
private theorem IsRealFlipStep.flipTransform_logCanonicalDivisor {X Z X' : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X']
    [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {f : X ⟶ Z} {fp : X' ⟶ Z}
    (h : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    (∀ (K₀ : Divisor X) (D : RDivisor X), flipTransform f fp (logCanonicalDivisor K₀ D) =
      logCanonicalDivisor (flipTransform f fp K₀) (flipTransform f fp D)) ∧
    ∀ (c : ℝ) (D : RDivisor X), flipTransform f fp (c • D) = c • flipTransform f fp D := by
  obtain ⟨φ, -, -, -, -, hφtr, -⟩ := FSPRef.IsRealFlipStep.exists_partialIso h
  refine ⟨fun K₀ D => ?_, fun c D => ?_⟩
  · simp only [logCanonicalDivisor, map_add]
    rw [← hφtr ℝ, transformDivisor_toRDivisor, hφtr ℤ]
  · rw [← hφtr ℝ, ← hφtr ℝ]
    exact DivisorWithCoeffs.mapPrimeDivisors_smul _ c D

/-! ### Programs with scaling as sequences of models -/

section ScalingProgram

/-- A model of a program with scaling over `Z`: a scheme `M` over `ℂ` and over `Z`, with a
canonical divisor `K`, a boundary `B`, a scaling divisor `C` and its current upper level `λ`. -/
private structure ScalingModel (Z : Scheme.{0}) where
  M : Scheme.{0}
  [isIntegral : IsIntegral M]
  [compactSpace : CompactSpace M]
  [isLocallyNoetherian : IsLocallyNoetherian M]
  [isNormal : IsNormal M]
  s : M ⟶ Spec (.of ℂ)
  π : M ⟶ Z
  K : Divisor M
  B : RDivisor M
  C : RDivisor M
  lam : ℝ

attribute [local instance] ScalingModel.isIntegral ScalingModel.compactSpace
  ScalingModel.isLocallyNoetherian ScalingModel.isNormal

variable {Z : Scheme.{0}}

/-- The standing invariants of a model of the program: a projective `ℚ`-factorial fourfold over
`Z` with dlt lower pair `(M, B)`, effective `C`, a nef lc upper level `B + λ C` with
`0 ≤ λ ≤ 1`, and the floor identity `α (K + B) ≡_Z C + N` with `N ≥ 0` supported in `⌊B⌋`. -/
private structure ScalingModel.IsGood (sZ : Z ⟶ Spec (.of ℂ)) (m : ScalingModel Z) : Prop where
  isProjectiveVariety : MMP.Mori.IsProjectiveVariety ℂ m.s
  isQFactorial : IsQFactorial m.s
  dim_eq : topologicalKrullDim m.M = 4
  isCanonicalDivisor : m.K.IsCanonicalDivisor m.s 4
  comp_eq : m.π ≫ sZ = m.s
  isRealDltPair : IsRealDltPair m.s m.B
  coeff_C_nonneg : ∀ P, 0 ≤ m.C.coeff P
  lam_nonneg : 0 ≤ m.lam
  lam_le_one : m.lam ≤ 1
  isRelativelyNef_upper :
    IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K (m.B + m.lam • m.C))
  isRealLcPair_upper : IsRealLcPair m.s (m.B + m.lam • m.C)
  exists_floor : ∃ (α : ℝ) (N : RDivisor m.M), 0 < α ∧ (∀ P, 0 ≤ N.coeff P) ∧
    (∀ P, N.coeff P ≠ 0 → 1 ≤ m.B.coeff P) ∧
    IsNumericallyEquivalentOver ℂ m.s m.π (α • logCanonicalDivisor m.K m.B) (m.C + N)

/-- The data of a step `M ⟶ W ⟵ M'` of a program. -/
private structure ScalingStep (m m' : ScalingModel Z) where
  W : Scheme.{0}
  sW : W ⟶ Spec (.of ℂ)
  f : m.M ⟶ W
  g : W ⟶ Z
  fp : m'.M ⟶ W
  ψ : m.M.RationalMap m'.M

/-- A step of the `(K + B)`-program with scaling of `C`, at the threshold `λ' = m'.lam`: a
`(K + B)`-negative extremal contraction over `Z` on which `K + B + λ' C` is numerically trivial,
followed by its divisorial contraction or its flip, transporting `B` and `C`. -/
private structure ScalingStep.IsStep {m m' : ScalingModel Z} (st : ScalingStep m m') : Prop where
  comp_eq : st.f ≫ st.g = m.π
  comp_eq_plus : st.fp ≫ st.g = m'.π
  lam_le : m'.lam ≤ m.lam
  isRelativelyNef : IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K (m.B + m'.lam • m.C))
  isNegativeExtremalContraction :
    IsNegativeExtremalContraction ℂ m.s st.sW (logCanonicalDivisor m.K m.B) st.f
  isNumericallyTrivialOver :
    IsNumericallyTrivialOver ℂ m.s st.f (logCanonicalDivisor m.K (m.B + m'.lam • m.C))
  divisorial_or_flip :
    (IsBirationalMorphism st.f ∧
        (∃ E : MMP.Mori.PrimeDivisor m.M,
          (MMP.Mori.exceptionalSet st.f : Set m.M) = E.support) ∧
        IsIso st.fp ∧ IsModificationOf st.f st.fp st.ψ) ∨
      IsFlip ℂ m.s st.sW m'.s (logCanonicalDivisor m.K m.B) st.f st.fp st.ψ
  eq_transform_B : m'.B = MMP.Mori.RationalMap.transformDivisor st.ψ m.B
  eq_transform_C : m'.C = MMP.Mori.RationalMap.transformDivisor st.ψ m.C
  /-- A flip step is a real flip step along which the upper level descends crepantly. -/
  divisorial_or_realFlip :
    (IsBirationalMorphism st.f ∧
        (∃ E : MMP.Mori.PrimeDivisor m.M,
          (MMP.Mori.exceptionalSet st.f : Set m.M) = E.support) ∧ IsIso st.fp) ∨
      (IsRealFlipStep m.s st.sW m'.s m.K m.B m'.K m'.B st.f st.fp ∧
        (∃ (_ : IsLocallyNoetherian st.W) (_ : IsNormal st.W) (D : RDivisor st.W),
          IsRCartierPullback st.f D (logCanonicalDivisor m.K (m.B + m'.lam • m.C)) ∧
          IsRCartierPullback st.fp D
            (flipTransform st.f st.fp (logCanonicalDivisor m.K (m.B + m'.lam • m.C)))) ∧
        m'.C = flipTransform st.f st.fp m.C)
  /-- The thresholds of the program are positive. -/
  lam_pos : 0 < m'.lam
  /-- The boundaries are the strict transforms `(f⁺)⁻¹_* f_*`. -/
  eq_flipTransform_B : m'.B = flipTransform st.f st.fp m.B
  eq_flipTransform_C : m'.C = flipTransform st.f st.fp m.C
  /-- The strict transform of prime divisors preserves coefficients. -/
  coeff_flipTransform : ∀ (P : MMP.Mori.PrimeDivisor m.M) (P' : MMP.Mori.PrimeDivisor m'.M),
    flipTransformPrimeDivisor st.f st.fp P = some P' →
      ∀ D : RDivisor m.M, (flipTransform st.f st.fp D).coeff P' = D.coeff P
  /-- Every prime divisor of the next model is a strict transform. -/
  exists_preimage : ∀ P' : MMP.Mori.PrimeDivisor m'.M,
    ∃ P : MMP.Mori.PrimeDivisor m.M, flipTransformPrimeDivisor st.f st.fp P = some P'
  /-- Every prime divisor has a strict transform, except the exceptional divisor of a divisorial
  step. -/
  exists_image : ∀ P : MMP.Mori.PrimeDivisor m.M,
    (∃ P' : MMP.Mori.PrimeDivisor m'.M, flipTransformPrimeDivisor st.f st.fp P = some P') ∨
      (IsBirationalMorphism st.f ∧
        (MMP.Mori.exceptionalSet st.f : Set m.M) = P.support ∧ IsIso st.fp)
  /-- The exceptional divisor of a divisorial step has no strict transform. -/
  eq_none : IsIso st.fp → ∀ P : MMP.Mori.PrimeDivisor m.M,
    (MMP.Mori.exceptionalSet st.f : Set m.M) = P.support →
      flipTransformPrimeDivisor st.f st.fp P = none
  /-- Along a divisorial step the strict transform is the push-forward along `f ≫ (f⁺)⁻¹`. -/
  div_transform : ∀ [IsIso st.fp],
    (∀ D : RDivisor m.M, flipTransform st.f st.fp D =
      MMP.Mori.RationalMap.transformDivisor (X := m.M) (st.f ≫ inv st.fp).toRationalMap D) ∧
    ∀ P : MMP.Mori.PrimeDivisor m.M, flipTransformPrimeDivisor st.f st.fp P =
      MMP.Mori.RationalMap.transformPrimeDivisor (X := m.M) (st.f ≫ inv st.fp).toRationalMap P
  /-- Along a flip the canonical divisors are strict transforms. -/
  eq_flipTransform_K : (IsBirationalMorphism st.f ∧
      (∃ E : MMP.Mori.PrimeDivisor m.M,
        (MMP.Mori.exceptionalSet st.f : Set m.M) = E.support) ∧ IsIso st.fp) ∨
    m'.K = flipTransform st.f st.fp m.K

/-- The sequence `m₀, T 0, T 1, …` of models. -/
private def seqOf (m₀ : ScalingModel Z) (T : ℕ → ScalingModel Z) : ℕ → ScalingModel Z
  | 0 => m₀
  | i + 1 => T i

/-- **One step of the program.** A model whose lower adjoint `K + B` is not nef over `Z` has a
next model: the nef threshold `λ' ∈ (0, λ]` of `C` is attained on a `(K + B)`-negative
extremal ray, whose contraction is divisorial or small (not of fibre type, by the floor
identity), followed by its flip in the small case; the upper level `K + B + λ' C` descends and
stays nef and lc, and the floor identity is transported. -/
private theorem ScalingModel.exists_scalingStep {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {m : ScalingModel Z} (hm : m.IsGood sZ)
    (hnot : ¬ IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B)) :
    ∃ (m' : ScalingModel Z) (st : ScalingStep m m'), st.IsStep ∧ m'.IsGood sZ := by
  classical
  obtain ⟨hproj, hQ, hdimM, hK, hπ, hdlt, hC0, hlam0, hlam1, hnefU, hlcU, hfloor⟩ := hm
  have hB0 : ∀ P, 0 ≤ m.B.coeff P := hdlt.1.2.1
  -- the upper level lies strictly above the lower one
  have hlampos : 0 < m.lam := by
    rcases hlam0.lt_or_eq with h | h
    · exact h
    · exfalso
      apply hnot
      have e : m.B + m.lam • m.C = m.B := by rw [← h, zero_smul, add_zero]
      rwa [e] at hnefU
  -- the nef threshold `l` and the extremal ray `R` on which it is attained
  obtain ⟨l, hl0, hll, hnefl, ⟨mK, rK, LK, hLK, hKBcoeff⟩, hCc, R, hR, hR0, hRneg, hRpos⟩ :=
    exists_isExtremalRay_nef_threshold_of_isRealLcPair hproj hZ hπ hQ hK hB0 hC0 hlampos hlcU
      hnefU hnot
  have hKBeq : logCanonicalDivisor m.K m.B = ∑ j, rK j • Divisor.toRDivisor (LK j) := by
    refine Finsupp.ext fun Γ => ?_
    have := hKBcoeff Γ
    simp only [DivisorWithCoeffs.coeff] at this
    rw [logCanonicalDivisor, this, Finsupp.finset_sum_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [Finsupp.smul_apply, smul_eq_mul]
    exact congrArg (rK j * ·)
      (DivisorWithCoeffs.coeff_mapCoeffs (fun x : ℤ => (x : ℝ)) Int.cast_zero (LK j) Γ).symm
  -- the contraction of `R` and, in the small case, its flip
  obtain ⟨W, _, _, _, _, sW, f, h, hfR, hWp, hneg, hdesc, hdiv, hsmall⟩ :=
    IsRealDltPair.exists_isRelativeContractionOfFace_of_isExtremalRay hproj hZ hπ hQ hdimM
      ⟨4, hK⟩ hdlt hR ⟨mK, rK, LK, hLK, hKBeq, hRneg mK rK LK hLK hKBeq⟩
  -- the upper level at the threshold is numerically trivial over the contraction
  have hKBc : IsCartierCombination (logCanonicalDivisor m.K m.B) :=
    ⟨mK, rK, LK, hLK, hKBeq⟩
  have hKBlC : IsCartierCombination (logCanonicalDivisor m.K (m.B + l • m.C)) := by
    have := IsCartierCombination.add_smul' hKBc (isCartierCombination_of_isRCartier hCc) l
    rwa [logCanonicalDivisor, ← add_assoc]
  have htriv : IsNumericallyTrivialOver ℂ m.s f (logCanonicalDivisor m.K (m.B + l • m.C)) :=
    isNumericallyTrivialOver_of_isRelativeContractionOfFace hfR hKBlC
      fun n c M hM heq u hu => hR0 n c M hM heq u hu
  -- the contraction is birational: divisorial or small
  have htri : (IsBirationalMorphism f ∧ ∃ E : MMP.Mori.PrimeDivisor m.M,
      (MMP.Mori.exceptionalSet f : Set m.M) = E.support) ∨ IsSmall ℂ sW m.s f := by
    obtain ⟨α, N, hα, hN0, -, hnum⟩ := hfloor
    exact divisorial_or_isSmall_of_isNumericallyEquivalentOver hproj hQ hneg hfR.comp_eq hC0 hN0
      hα hnum
  -- the lc upper level at the threshold, and its degree zero on the ray
  have hlcl : IsRealLcPair m.s (m.B + l • m.C) := by
    rcases hll.lt_or_eq with h' | h'
    · exact (isRealDltPair_add_smul hQ hC0 hdlt hlcU hl0.le h').1
    · rw [h']; exact hlcU
  have hRl : ∀ (Γ : ProperCurve m.s) (hΓ : Γ.IsContractedBy m.π), Γ.relativeClass m.π hΓ ∈ R →
      ∀ (n : ℕ) (r : Fin n → ℝ) (L : Fin n → Divisor m.M) (x : ℝ),
        IsRIntersectionNumber ℂ m.s (logCanonicalDivisor m.K (m.B + l • m.C)) r L Γ x →
          x = 0 := fun Γ hΓ hR' n r L x hx =>
    IsNumericallyTrivialOver.eq_zero htriv Γ ((hfR.isContractedBy_iff Γ hΓ).mpr hR') r L x hx
  have hfs : f ≫ sW = m.s := hneg.isContraction.comp_eq
  rcases htri with hdivf | hsm
  · -- the divisorial contraction: the next model is `W`
    obtain ⟨hQW, hdltW, hlcnef⟩ := hdiv hdivf
    obtain ⟨hlcW, hnefW⟩ := hlcnef (m.B + l • m.C) hlcl hnefl hRl
    have : IsDominant f := hdivf.1.isDominant
    have hhs : h ≫ sZ = sW := by
      refine AlgebraicGeometry.ext_of_isDominant f ?_
      rw [← Category.assoc, hfR.comp_eq, hπ, hfs]
    have htrB : MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap
        (m.B + l • m.C) = MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.B +
          l • MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.C := by
      have e := (MMP.Mori.RationalMap.transformDivisorₗ ℝ (X := m.M) f.toRationalMap).map_add
        m.B (l • m.C)
      rw [(MMP.Mori.RationalMap.transformDivisorₗ ℝ _).map_smul] at e
      simpa only [MMP.Mori.RationalMap.transformDivisorₗ_apply] using e
    haveI : IsProper f := hneg.isContraction.isProper
    haveI : IsSeparated (W ↘ ⊤_ Scheme) := by
      haveI := hneg.isNormalVariety_target.1.toIsSeparated
      rw [show (W ↘ ⊤_ Scheme) = sW ≫ Limits.terminal.from (Spec (.of ℂ)) from
        Subsingleton.elim _ _]
      infer_instance
    obtain ⟨Gx, hGx⟩ := hdivf.2
    have hdf := flipTransform_fields_of_divisorial f hdivf.1 hGx
    let m' : ScalingModel Z := ⟨W, sW, h,
      MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.K,
      MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.B,
      MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.C, l⟩
    refine ⟨m', ⟨W, sW, f, h, 𝟙 W, f.toRationalMap⟩,
      { comp_eq := hfR.comp_eq
        comp_eq_plus := Category.id_comp h
        lam_le := hll
        isRelativelyNef := hnefl
        isNegativeExtremalContraction := hneg
        isNumericallyTrivialOver := htriv
        divisorial_or_flip := Or.inl ⟨hdivf.1, hdivf.2, inferInstance, hdivf.1, by
          change f.toPartialMap.toRationalMap.compHom (𝟙 W) = f.toPartialMap.toRationalMap
          rw [← Scheme.RationalMap.compHom_toRationalMap]
          congr 1⟩
        eq_transform_B := rfl
        eq_transform_C := rfl
        divisorial_or_realFlip := Or.inl ⟨hdivf.1, hdivf.2, inferInstance⟩
        lam_pos := hl0
        eq_flipTransform_B := (hdf.1 _).symm
        eq_flipTransform_C := (hdf.1 _).symm
        coeff_flipTransform := hdf.2.1
        exists_preimage := hdf.2.2.1
        exists_image := fun P => (hdf.2.2.2.1 P).imp id fun h => ⟨hdivf.1, h, inferInstance⟩
        eq_none := fun _ => hdf.2.2.2.2.1
        div_transform := ⟨fun D => by rw [IsIso.inv_id, Category.comp_id]; exact hdf.1 D,
          fun P => by rw [IsIso.inv_id, Category.comp_id]; exact hdf.2.2.2.2.2 P⟩
        eq_flipTransform_K := Or.inl ⟨hdivf.1, hdivf.2, inferInstance⟩ }, ?_⟩
    have hWn : IsNormalVariety ℂ sW := hneg.isNormalVariety_target
    have hMn : IsNormalVariety ℂ m.s := hneg.isNormalVariety_source
    have := hWn.1
    have := hMn.1
    have hdimW : topologicalKrullDim W = 4 := by
      rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW m.s hdivf.1, hdimM]
    have : IsProper f := hneg.isContraction.isProper
    have : LocallyOfFiniteType sW := hWn.1.toLocallyOfFiniteType
    have : LocallyOfFiniteType (f ≫ sW) := by rw [hfs]; exact hMn.1.toLocallyOfFiniteType
    have hKW : Divisor.IsCanonicalDivisor sW 4
        (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.K) := by
      obtain ⟨KW₀, hKW₀⟩ := MMP.Mori.exists_isCanonicalDivisor sW hWn (n := 4) hdimW
      have hMn' : IsNormalVariety ℂ (f ≫ sW) := by rw [hfs]; exact hMn
      have hK' : m.K.IsCanonicalDivisor (f ≫ sW) 4 := by rw [hfs]; exact hK
      exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hWn hMn' hdivf.1 hKW₀ hK'
    exact
        { isProjectiveVariety := hWp
          isQFactorial := hQW
          dim_eq := hdimW
          isCanonicalDivisor := hKW
          comp_eq := hhs
          isRealDltPair := hdltW
          coeff_C_nonneg := coeff_transformDivisor_nonneg _ hC0
          lam_nonneg := hl0.le
          lam_le_one := hll.trans hlam1
          isRelativelyNef_upper := by
            have := hnefW
            rwa [htrB] at this
          isRealLcPair_upper := by
            have := hlcW
            rwa [htrB] at this
          exists_floor := by
            obtain ⟨α, N, hα, hN0, hNB, hnum⟩ := hfloor
            have hD := IsNumericallyEquivalentOver.sub_isNumericallyTrivialOver hnum
            obtain ⟨Mw, hMw⟩ := hdesc hdivf.1 _ hD.1 fun Γ hΓ _ n r L x hx =>
              IsNumericallyTrivialOver.eq_zero hD Γ hΓ r L x hx
            haveI := hMn.1
            haveI := hWn.1
            have hMt : IsNumericallyTrivialOver ℂ sW h Mw :=
              IsNumericallyTrivialOver.of_isRCartierPullback_of_surjective f hfs h hMw
                (by rw [hfR.comp_eq]; exact hD)
            have hpush := transformDivisor_of_isRCartierPullback_hom hWn
              (by rw [hfs]; exact hMn) hdivf.1 hMw
            set T : RDivisor m.M →ₗ[ℝ] RDivisor W :=
              MMP.Mori.RationalMap.transformDivisorₗ ℝ (X := m.M) f.toRationalMap
            have hTK : T (Divisor.toRDivisor m.K) = Divisor.toRDivisor
                (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.K) :=
              transformDivisor_toRDivisor _ _
            have heq : T (α • logCanonicalDivisor m.K m.B - (m.C + N)) =
                α • logCanonicalDivisor
                  (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.K)
                  (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.B) -
                (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap m.C +
                  MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap N) := by
              simp only [logCanonicalDivisor, map_sub, map_smul, map_add, hTK]
              rfl
            refine ⟨α, MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap N, hα,
              coeff_transformDivisor_nonneg _ hN0, fun P hP => ?_, ?_⟩
            · exact one_le_apply_of_map_single
                (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap)
                (MMP.Mori.RationalMap.transformPrimeDivisor (X := m.M) f.toRationalMap)
                (MMP.Mori.RationalMap.transformDivisor_single _) hB0 hNB P hP
            · refine isNumericallyEquivalentOver_of_sub
                (isCartierCombination_of_isRCartier (MMP.Fourfold.IsQFactorial.isRCartier hQW _)) ?_
              change IsNumericallyTrivialOver ℂ sW h _
              rw [← heq]
              change IsNumericallyTrivialOver ℂ sW h
                (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap _)
              rw [hpush]
              exact hMt }
  · -- the flip of the small contraction: the next model is the flip `X'`
    obtain ⟨X', _, _, _, _, sX', fp, hflip, hX'p, hQ', hdim', hdlt', hdesc', hlcnef'⟩ := hsmall hsm
    obtain ⟨φ, hφf, hφs, -⟩ := IsRealFlipStep.exists_partialIso hflip
    obtain ⟨V, hfV, hfpV, hXV, hX'V⟩ := hflip.exists_opens_isIso
    have hWn : IsNormalVariety ℂ sW := hneg.isNormalVariety_target
    have hMn : IsNormalVariety ℂ m.s := hneg.isNormalVariety_source
    have hX'n : IsNormalVariety ℂ sX' := ⟨hX'p.toIsVariety, inferInstance⟩
    have : IsProper f := hneg.isContraction.isProper
    have : IsSeparated (X' ↘ ⊤_ Scheme) := by
      have := hX'n.1.toIsSeparated
      rw [show (X' ↘ ⊤_ Scheme) = sX' ≫ Limits.terminal.from (Spec (.of ℂ)) from
        Subsingleton.elim _ _]
      infer_instance
    have htr : ∀ D : RDivisor m.M,
        MMP.Mori.RationalMap.transformDivisor φ.toRationalMap D = flipTransform f fp D :=
      fun D => MMP.Mori.transformDivisor_eq_flipTransform_of_isIso_restrict hWn
        (by rw [hfs]; exact hMn) hflip.isBirationalMorphism V hXV hX'V hφf D
    have htrZ : ∀ D : Divisor m.M,
        MMP.Mori.RationalMap.transformDivisor φ.toRationalMap D = flipTransform f fp D :=
      fun D => MMP.Mori.transformDivisor_eq_flipTransform_of_isIso_restrict hWn
        (by rw [hfs]; exact hMn) hflip.isBirationalMorphism V hXV hX'V hφf D
    -- the strict transform is linear and commutes with `ℤ ⊆ ℝ`
    have hlin : ∀ (D₁ D₂ : RDivisor m.M) (c : ℝ), flipTransform f fp (D₁ + c • D₂) =
        flipTransform f fp D₁ + c • flipTransform f fp D₂ := fun D₁ D₂ c => by
      rw [← htr, ← htr, ← htr, map_add, ← MMP.Mori.RationalMap.transformDivisorₗ_apply ℝ,
        ← MMP.Mori.RationalMap.transformDivisorₗ_apply ℝ (D := c • D₂),
        (MMP.Mori.RationalMap.transformDivisorₗ ℝ _).map_smul,
        MMP.Mori.RationalMap.transformDivisorₗ_apply]
      rfl
    have hKtr : flipTransform f fp (logCanonicalDivisor m.K m.B) =
        logCanonicalDivisor (flipTransform f fp m.K) (flipTransform f fp m.B) := by
      rw [logCanonicalDivisor, logCanonicalDivisor, ← htr, map_add, transformDivisor_toRDivisor,
        htrZ, htr]
    obtain ⟨hlcX', hnefX'⟩ := hlcnef' (m.B + l • m.C) hlcl hnefl hRl
    have : IsDominant f := hflip.isBirationalMorphism.isDominant
    have hhs : h ≫ sZ = sW := by
      refine AlgebraicGeometry.ext_of_isDominant f ?_
      rw [← Category.assoc, hfR.comp_eq, hπ, hfs]
    have hbijF := IsRealFlipStep.forall_flipTransformPrimeDivisor hflip hMn.1.toIsSeparated
      hX'n.1.toIsSeparated
    let m' : ScalingModel Z := ⟨X', sX', fp ≫ h, flipTransform f fp m.K, flipTransform f fp m.B,
      flipTransform f fp m.C, l⟩
    have hamp : IsRelativelyAmple fp
        (MMP.Mori.RationalMap.transformDivisor φ.toRationalMap (logCanonicalDivisor m.K m.B)) := by
      rw [htr, hKtr]
      exact hflip.isRelativelyAmple_flip
    have hampc : IsCartierCombination
        (MMP.Mori.RationalMap.transformDivisor φ.toRationalMap (logCanonicalDivisor m.K m.B)) := by
      obtain ⟨n, r, L, -, -, hL, hD⟩ := hamp
      exact ⟨n, r, L, fun j => (hL j).1, hD⟩
    refine ⟨m', ⟨W, sW, f, h, fp, φ.toRationalMap⟩,
      { comp_eq := hfR.comp_eq
        comp_eq_plus := rfl
        lam_le := hll
        isRelativelyNef := hnefl
        isNegativeExtremalContraction := hneg
        isNumericallyTrivialOver := htriv
        divisorial_or_flip := Or.inr
          { isNormalVariety_source := hMn
            isNormalVariety_target := hWn
            isNormalVariety_flip := hX'n
            isContraction := hneg.isContraction
            isCartierCombination := hneg.isCartierCombination
            isRelativelyAntiAmple := hneg.isRelativelyAntiAmple
            isProper := isProper_of_isProjectiveMorphism fp hflip.isProjectiveMorphism_flip
            isModificationOf := ⟨MMP.Mori.RationalMap.isBirational_toRationalMap φ, hφf⟩
            isMorphismInCodimOne :=
              MMP.Flips.two_le_closedsCodimension_compl
                (MMP.Mori.RationalMap.dom (X := m.M) φ.toRationalMap).isOpen fun x hx =>
                  MMP.Mori.RationalMap.le_dom φ.toPartialMap (hφs x hx)
            isSmall := hflip.isSmall_flip
            isCartierCombination_transform := hampc
            isRelativelyAmple_transform := hamp
            isSmall_source := hsm }
        eq_transform_B := (htr m.B).symm
        eq_transform_C := (htr m.C).symm
        divisorial_or_realFlip := Or.inr ⟨hflip, by
          obtain ⟨Mw, hMw, hMw'⟩ := hdesc' _ hKBlC fun Γ hΓ hR' n r L x hx => hRl Γ hΓ hR' n r L x hx
          exact ⟨inferInstance, inferInstance, Mw, hMw, hMw'⟩, rfl⟩
        lam_pos := hl0
        eq_flipTransform_B := rfl
        eq_flipTransform_C := rfl
        coeff_flipTransform := hbijF.2.1
        exists_preimage := hbijF.2.2
        exists_image := fun P => Or.inl (hbijF.1 P)
        eq_none := fun hiso => absurd hiso hflip.not_isIso_flip
        div_transform := @fun hiso => absurd hiso hflip.not_isIso_flip
        eq_flipTransform_K := Or.inr rfl }, ?_⟩
    obtain ⟨nK, hKX'⟩ := hflip.isCanonicalDivisor_flip
    obtain rfl : nK = 4 := by
      have := hKX'.topologicalKrullDim_eq
      rw [hdim'] at this
      exact_mod_cast this.symm
    exact
      { isProjectiveVariety := hX'p
        isQFactorial := hQ'
        dim_eq := hdim'
        isCanonicalDivisor := hKX'
        comp_eq := by
          change (fp ≫ h) ≫ sZ = sX'
          rw [Category.assoc, hhs, hflip.isSmall_flip.comp_eq]
        isRealDltPair := hdlt'
        coeff_C_nonneg := fun P => by
          change 0 ≤ (flipTransform f fp m.C).coeff P
          rw [← htr]; exact coeff_transformDivisor_nonneg _ hC0 P
        lam_nonneg := hl0.le
        lam_le_one := hll.trans hlam1
        isRelativelyNef_upper := by
          have := hnefX'
          rwa [hlin] at this
        isRealLcPair_upper := by
          have := hlcX'
          rwa [hlin] at this
        exists_floor := by
          obtain ⟨α, N, hα, hN0, hNB, hnum⟩ := hfloor
          have hD := IsNumericallyEquivalentOver.sub_isNumericallyTrivialOver hnum
          obtain ⟨Mw, hMw, hMw'⟩ := hdesc' _ hD.1 fun Γ hΓ _ n r L x hx =>
            IsNumericallyTrivialOver.eq_zero hD Γ hΓ r L x hx
          haveI := hMn.1
          haveI := hWn.1
          haveI : IsProper fp := isProper_of_isProjectiveMorphism fp hflip.isProjectiveMorphism_flip
          have hMt : IsNumericallyTrivialOver ℂ sW h Mw :=
            IsNumericallyTrivialOver.of_isRCartierPullback_of_surjective f hfs h hMw
              (by rw [hfR.comp_eq]; exact hD)
          have hX't := IsNumericallyTrivialOver.isRCartierPullback' (𝟙 Z) h (fp ≫ h) fp
            (Category.comp_id _) hMt hMw'
          replace hX't := IsNumericallyTrivialOver.congr_str hflip.isSmall_flip.comp_eq hX't
          have hsub : ∀ D₁ D₂ : RDivisor m.M,
              flipTransform f fp (D₁ - D₂) = flipTransform f fp D₁ - flipTransform f fp D₂ :=
            fun D₁ D₂ => map_sub _ _ _
          have hsm' : ∀ (c : ℝ) (D : RDivisor m.M),
              flipTransform f fp (c • D) = c • flipTransform f fp D := fun c D => by
            simpa using hlin 0 D c
          have heq : flipTransform f fp (α • logCanonicalDivisor m.K m.B - (m.C + N)) =
              α • logCanonicalDivisor (flipTransform f fp m.K) (flipTransform f fp m.B) -
                (flipTransform f fp m.C + flipTransform f fp N) := by
            rw [hsub, hsm', hKtr, map_add]
          refine ⟨α, flipTransform f fp N, hα, fun P => ?_, fun P hP => ?_, ?_⟩
          · rw [← htr]; exact coeff_transformDivisor_nonneg _ hN0 P
          · have hB1 : ∀ Q, 0 ≤ (MMP.Mori.RationalMap.transformDivisor (X := m.M)
                f.toRationalMap m.B) Q := coeff_transformDivisor_nonneg _ hB0
            have hNB1 := fun Q => one_le_apply_of_map_single
              (MMP.Mori.RationalMap.transformDivisor (X := m.M) f.toRationalMap)
              (MMP.Mori.RationalMap.transformPrimeDivisor (X := m.M) f.toRationalMap)
              (MMP.Mori.RationalMap.transformDivisor_single _) hB0 hNB Q
            exact one_le_apply_of_map_single (MMP.Mori.inverseTransformDivisor fp)
              (MMP.Mori.inverseTransformPrimeDivisor fp)
              (MMP.Mori.inverseTransformDivisor_single fp) hB1 hNB1 P hP
          · refine isNumericallyEquivalentOver_of_sub
              (isCartierCombination_of_isRCartier (MMP.Fourfold.IsQFactorial.isRCartier hQ' _)) ?_
            change IsNumericallyTrivialOver ℂ sX' (fp ≫ h) _
            rw [← heq]
            exact hX't }

/-! ### Plt references along the program -/

/-- A *plt reference* for a prime divisor `E` of a model `m` of the program, at the level `c` and
below the level `top`: a partial isomorphism `e : X₀ ⤏ M` over `ℂ` from a reference variety `X₀`
sending `S₀` to `E`, whose extracted primes have generic points outside `Supp A₀`, and a boundary
`L ∼_ℚ B + c C` such that `L` and `L + (top - c) C` are plt, `L` has coefficient one along `E`,
`C` vanishes along `E`, and `e_* A₀ ≤ L - E`. -/
private structure RefCore {X₀ : Scheme.{0}} [IsIntegral X₀] [IsLocallyNoetherian X₀]
    [IsNormal X₀] (sX₀ : X₀ ⟶ Spec (.of ℂ)) (S₀ : MMP.Mori.PrimeDivisor X₀) (A₀ : QDivisor X₀)
    (m : ScalingModel Z) (E : MMP.Mori.PrimeDivisor m.M) (c top : ℝ) (e : X₀.PartialIso m.M)
    (L : RDivisor m.M) : Prop where
  isOver : e.IsOver sX₀ m.s
  transform_S₀ : MMP.Mori.RationalMap.transformPrimeDivisor e.toRationalMap S₀ = some E
  ord : ∀ F : MMP.Mori.PrimeDivisor m.M,
    MMP.Flips.RationalMap.IsInverseExceptional e.toRationalMap F →
    ∀ q : m.M.PartialMap X₀, q.toRationalMap = e.symm.toRationalMap →
      ∀ hF : F.genericPoint ∈ q.domain, q.hom ⟨F.genericPoint, hF⟩ ∉ (A₀.supp : Set X₀)
  linEquiv : ∃ (n : ℕ) (u : (RationalFunctions m.M)ˣ), 0 < n ∧
    (n : ℝ) • (L - (m.B + c • m.C)) = Divisor.toRDivisor (principalDivisor u)
  plt : (∀ P, 0 ≤ L.coeff P ∧ L.coeff P ≤ 1) ∧
    ∀ (n : ℕ) (D : DivisorOver ℂ m.s) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy m.s n L D a → 0 < a
  coeff_E : L.coeff E = 1
  coeff_lt_one : ∀ P, P ≠ E → L.coeff P < 1
  coeff_C_E : m.C.coeff E = 0
  le : QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor e.toRationalMap A₀) ≤
    L - Finsupp.single E 1
  plt_upper : (∀ P, 0 ≤ (L + (top - c) • m.C).coeff P ∧ (L + (top - c) • m.C).coeff P ≤ 1) ∧
    ∀ (n : ℕ) (D : DivisorOver ℂ m.s) (a : ℝ), D.IsExceptional →
      MMP.Intersection.IsLogDiscrepancy m.s n (L + (top - c) • m.C) D a → 0 < a

/-- A model of the program *has a plt reference* for `E` at the level `c` below `top`. -/
private def HasRef (m : ScalingModel Z) (E : MMP.Mori.PrimeDivisor m.M) (c top : ℝ) : Prop :=
  ∃ (X₀ : Scheme.{0}) (_ : IsIntegral X₀) (_ : IsLocallyNoetherian X₀) (_ : IsNormal X₀)
    (_ : CompactSpace X₀) (sX₀ : X₀ ⟶ Spec (.of ℂ)) (_ : IsNormalVariety ℂ sX₀)
    (_ : MMP.Mori.IsProjectiveVariety ℂ sX₀) (S₀ : MMP.Mori.PrimeDivisor X₀)
    (_ : IsNormal S₀.idealSheaf.subscheme) (A₀ : QDivisor X₀) (_ : 0 ≤ A₀) (_ : A₀.IsAmple)
    (_ : A₀.coeff S₀ = 0) (e : X₀.PartialIso m.M) (L : RDivisor m.M),
    RefCore sX₀ S₀ A₀ m E c top e L

/-- A program: good models `U k` and steps `U k ⤏ U (k + 1)`. -/
private structure IsProgram (sZ : Z ⟶ Spec (.of ℂ)) (U : ℕ → ScalingModel Z)
    (stp : ∀ k, ScalingStep (U k) (U (k + 1))) : Prop where
  isGood : ∀ k, (U k).IsGood sZ
  isStep : ∀ k, (stp k).IsStep

/-- The tail of a program from the `n`-th model on. -/
private theorem IsProgram.shift {sZ : Z ⟶ Spec (.of ℂ)} {U : ℕ → ScalingModel Z}
    {stp : ∀ k, ScalingStep (U k) (U (k + 1))} (h : IsProgram sZ U stp) (n : ℕ) :
    IsProgram sZ (fun k => U (n + k)) (fun k => stp (n + k)) :=
  ⟨fun k => h.isGood (n + k), fun k => h.isStep (n + k)⟩

/-- The strict transforms along a program of a prime divisor of its first model. -/
private noncomputable def trackPrime (U : ℕ → ScalingModel Z) (stp : ∀ k, ScalingStep (U k) (U (k + 1)))
    (E : MMP.Mori.PrimeDivisor (U 0).M) : ∀ k, Option (MMP.Mori.PrimeDivisor (U k).M)
  | 0 => some E
  | k + 1 => (trackPrime U stp E k).bind (flipTransformPrimeDivisor (stp k).f (stp k).fp)

/-- Tracking from the `n`-th model is tracking from the first model, shifted. -/
private theorem trackPrime_shift (U : ℕ → ScalingModel Z)
    (stp : ∀ k, ScalingStep (U k) (U (k + 1))) (E : MMP.Mori.PrimeDivisor (U 0).M) (n : ℕ)
    (E' : MMP.Mori.PrimeDivisor (U n).M) (hE' : trackPrime U stp E n = some E') :
    ∀ k, trackPrime (fun k => U (n + k)) (fun k => stp (n + k)) E' k = trackPrime U stp E (n + k)
  | 0 => hE'.symm
  | k + 1 => by
    change (trackPrime (fun k => U (n + k)) (fun k => stp (n + k)) E' k).bind _ =
      (trackPrime U stp E (n + k)).bind _
    rw [trackPrime_shift U stp E n E' hE' k]
    rfl

/-- **A divisorial step contracts a floor component.** If `α (K + B) ≡_Z C + N` with `N ≥ 0`
supported in `⌊B⌋`, then `α (K + B) - C ≡_Z N` is anti-ample over the contraction (as `C` is
positive and `K + B` negative on the contracted ray), so its exceptional prime divisor is a
component of `N`. -/
private theorem ScalingStep.IsStep.one_le_coeff_of_exceptionalSet_eq {sZ : Z ⟶ Spec (.of ℂ)}
    {m m' : ScalingModel Z} (hm : m.IsGood sZ) {st : ScalingStep m m'} (hst : st.IsStep)
    (hfb : IsBirationalMorphism st.f) {G : MMP.Mori.PrimeDivisor m.M}
    (hG : (MMP.Mori.exceptionalSet st.f : Set m.M) = G.support) : 1 ≤ m.B.coeff G := by
  obtain ⟨α, N, hα, hN0, hNB, hnum⟩ := hm.exists_floor
  have hneg := hst.isNegativeExtremalContraction
  have hMv := hneg.isNormalVariety_source
  haveI : QuasiCompact m.s := hMv.1.toQuasiCompact
  have hWv := hneg.isNormalVariety_target
  haveI : IsIntegral st.W := hWv.1.toIsIntegral
  haveI : IsNormal st.W := hWv.2
  haveI : LocallyOfFiniteType st.sW := hWv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian st.W := LocallyOfFiniteType.isLocallyNoetherian st.sW
  haveI : IsDominant st.f := hfb.isDominant
  have hfp : IsProjective st.f := by
    haveI : IsSeparated st.sW := hneg.isNormalVariety_target.1.toIsSeparated
    refine IsProjective.of_comp st.f st.sW ?_
    rw [hneg.isContraction.comp_eq]
    exact hm.isProjectiveVariety.isProjective.isProjective
  have hanti := isRelativelyAntiAmple_of_lt (u := -(1 / α)) hneg hfp hst.isNumericallyTrivialOver
    hst.lam_pos (by
      have h1 := hst.lam_pos
      have h2 : 0 < 1 / α := by positivity
      linarith)
  have hα' : α * (1 / α) = 1 := by field_simp
  have hD : α • logCanonicalDivisor m.K (m.B + (-(1 / α)) • m.C) =
      α • logCanonicalDivisor m.K m.B - m.C := by
    have e : α • ((-(1 / α)) • m.C) = -m.C := by rw [smul_smul, mul_neg, hα', neg_one_smul]
    simp only [logCanonicalDivisor, smul_add, e]
    abel
  have hantiD : IsRelativelyAntiAmple st.f (α • logCanonicalDivisor m.K m.B - m.C) := by
    unfold IsRelativelyAntiAmple at hanti ⊢
    rw [← hD, ← smul_neg]
    exact FSPRef.isRelativelyAmple_smul hanti hα
  have hnegD : IsNegativeExtremalContraction ℂ m.s st.sW
      (α • logCanonicalDivisor m.K m.B - m.C) st.f :=
    { hneg with
      isCartierCombination := FSPRef.isCartierCombination_of_isQFactorial hm.isQFactorial _
      isRelativelyAntiAmple := hantiD }
  have hnumD : IsNumericallyEquivalentOver ℂ m.s m.π
      (α • logCanonicalDivisor m.K m.B - m.C) N := by
    refine isNumericallyEquivalentOver_of_sub
      (FSPRef.isCartierCombination_of_isQFactorial hm.isQFactorial _) ?_
    have e : α • logCanonicalDivisor m.K m.B - m.C - N =
        α • logCanonicalDivisor m.K m.B - (m.C + N) := by abel
    rw [e]
    exact IsNumericallyEquivalentOver.sub_isNumericallyTrivialOver hnum
  exact hNB G (FSPCne.coeff_ne_zero_of_exceptionalSet_eq hm.isQFactorial hm.isProjectiveVariety
    hst.comp_eq hnegD hfb hnumD hN0 hG)

/-- **Finitely many divisorial steps.** Every divisorial step of a program contracts a component
of the floor of its boundary, and the floor components of later models are strict transforms of
those of earlier ones; so from some step on, every step is a flip. -/
private theorem IsProgram.exists_forall_not_divisorial {sZ : Z ⟶ Spec (.of ℂ)}
    {U : ℕ → ScalingModel Z} {stp : ∀ k, ScalingStep (U k) (U (k + 1))}
    (h : IsProgram sZ U stp) :
    ∃ K₀, ∀ k, K₀ ≤ k → ¬ (IsBirationalMorphism (stp k).f ∧
      (∃ E : MMP.Mori.PrimeDivisor (U k).M,
        (MMP.Mori.exceptionalSet (stp k).f : Set (U k).M) = E.support) ∧ IsIso (stp k).fp) := by
  classical
  -- the floor components of the models
  let Fl : ∀ k, Finset (MMP.Mori.PrimeDivisor (U k).M) := fun k =>
    (U k).B.support.filter fun P => 1 ≤ (U k).B.coeff P
  have hFl : ∀ k (P : MMP.Mori.PrimeDivisor (U k).M), P ∈ Fl k ↔ 1 ≤ (U k).B.coeff P := by
    intro k P
    simp only [Fl, Finset.mem_filter, Finsupp.mem_support_iff]
    refine ⟨fun h => h.2, fun h => ⟨fun h0 => ?_, h⟩⟩
    rw [DivisorWithCoeffs.coeff_apply, h0] at h
    linarith
  -- the preimage of a floor component is a floor component
  have hpre : ∀ k (P' : MMP.Mori.PrimeDivisor (U (k + 1)).M), ∃ P : MMP.Mori.PrimeDivisor (U k).M,
      flipTransformPrimeDivisor (stp k).f (stp k).fp P = some P' ∧
        (U (k + 1)).B.coeff P' = (U k).B.coeff P := by
    intro k P'
    obtain ⟨P, hP⟩ := (h.isStep k).exists_preimage P'
    exact ⟨P, hP, by
      rw [(h.isStep k).eq_flipTransform_B]
      exact (h.isStep k).coeff_flipTransform P P' hP _⟩
  choose pre hpre1 hpre2 using hpre
  have hinj : ∀ k, Set.InjOn (pre k) (Fl (k + 1) : Set _) := by
    intro k P₁ _ P₂ _ he
    have h1 := hpre1 k P₁
    have h2 := hpre1 k P₂
    rw [he] at h1
    exact Option.some_injective _ (h1.symm.trans h2)
  have hmaps : ∀ k, Set.MapsTo (pre k) (Fl (k + 1) : Set _) (Fl k : Set _) := by
    intro k P' hP'
    simp only [Finset.mem_coe, hFl] at hP' ⊢
    rw [← hpre2 k P']
    exact hP'
  have hle : ∀ k, (Fl (k + 1)).card ≤ (Fl k).card := fun k =>
    Finset.card_le_card_of_injOn (pre k) (hmaps k) (hinj k)
  -- a divisorial step contracts a floor component
  have hlt : ∀ k, (IsBirationalMorphism (stp k).f ∧ (∃ E : MMP.Mori.PrimeDivisor (U k).M,
      (MMP.Mori.exceptionalSet (stp k).f : Set (U k).M) = E.support) ∧ IsIso (stp k).fp) →
      (Fl (k + 1)).card < (Fl k).card := by
    rintro k ⟨hfb, ⟨G, hG⟩, hiso⟩
    have hGfl : G ∈ Fl k := (hFl k G).mpr
      ((h.isStep k).one_le_coeff_of_exceptionalSet_eq (h.isGood k) hfb hG)
    have hnone := (h.isStep k).eq_none hiso G hG
    have hmaps' : Set.MapsTo (pre k) (Fl (k + 1) : Set _) ((Fl k).erase G : Set _) := by
      intro P' hP'
      refine Finset.mem_coe.mpr (Finset.mem_erase.mpr ⟨fun hPG => ?_, hmaps k hP'⟩)
      have := hpre1 k P'
      rw [hPG, hnone] at this
      exact absurd this (by simp)
    have := Finset.card_le_card_of_injOn (pre k) hmaps' (hinj k)
    rw [Finset.card_erase_of_mem hGfl] at this
    have hpos : 0 < (Fl k).card := Finset.card_pos.mpr ⟨G, hGfl⟩
    omega
  -- an antitone sequence of natural numbers drops only finitely often
  by_contra hcon
  push Not at hcon
  have hanti : ∀ k k', k ≤ k' → (Fl k').card ≤ (Fl k).card := by
    intro k k' hkk'
    induction hkk' with
    | refl => exact le_rfl
    | step _ ih => exact (hle _).trans ih
  have key : ∀ n, ∃ k, (Fl k).card + n ≤ (Fl 0).card := by
    intro n
    induction n with
    | zero => exact ⟨0, le_rfl⟩
    | succ n ih =>
      obtain ⟨k, hk⟩ := ih
      obtain ⟨k', hkk', hdiv⟩ := hcon k
      refine ⟨k' + 1, ?_⟩
      have h1 := hlt k' hdiv
      have h2 := hanti k k' hkk'
      omega
  obtain ⟨k, hk⟩ := key ((Fl 0).card + 1)
  omega

/-- **The floor components of a model of a program are strict transforms of those of its first
model.** -/
private theorem IsProgram.exists_trackPrime_eq_some {sZ : Z ⟶ Spec (.of ℂ)}
    {U : ℕ → ScalingModel Z} {stp : ∀ k, ScalingStep (U k) (U (k + 1))}
    (h : IsProgram sZ U stp) (k : ℕ) (G : MMP.Mori.PrimeDivisor (U k).M)
    (hG : 1 ≤ (U k).B.coeff G) :
    ∃ E : MMP.Mori.PrimeDivisor (U 0).M, 1 ≤ (U 0).B.coeff E ∧ trackPrime U stp E k = some G := by
  induction k with
  | zero => exact ⟨G, hG, rfl⟩
  | succ k ih =>
    obtain ⟨P, hP⟩ := (h.isStep k).exists_preimage G
    have hc : (U (k + 1)).B.coeff G = (U k).B.coeff P := by
      rw [(h.isStep k).eq_flipTransform_B]
      exact (h.isStep k).coeff_flipTransform P G hP _
    obtain ⟨E, hE, hEP⟩ := ih P (hc ▸ hG)
    refine ⟨E, hE, ?_⟩
    change (trackPrime U stp E k).bind _ = _
    rw [hEP]
    exact hP

/-- **Plt between two plt levels.** On a `ℚ`-factorial variety with `C ≥ 0`, if `L` and `L + b C`
are plt, then so is `L + ν C` for `0 ≤ ν ≤ b`: log discrepancies are affine in `ν` and decrease
along `C`. -/
private theorem plt_add_smul_of_le {M : Scheme.{0}} [IsIntegral M] [CompactSpace M]
    [IsLocallyNoetherian M] [IsNormal M] {sM : M ⟶ Spec (.of ℂ)} (hQ : IsQFactorial sM)
    {L C : RDivisor M} (hC : 0 ≤ C) {b ν : ℝ} (hν0 : 0 ≤ ν) (hνb : ν ≤ b)
    (h0 : (∀ P, 0 ≤ L.coeff P ∧ L.coeff P ≤ 1) ∧ ∀ (n : ℕ) (D : DivisorOver ℂ sM) (a : ℝ),
      D.IsExceptional → MMP.Intersection.IsLogDiscrepancy sM n L D a → 0 < a)
    (hb : (∀ P, 0 ≤ (L + b • C).coeff P ∧ (L + b • C).coeff P ≤ 1) ∧
      ∀ (n : ℕ) (D : DivisorOver ℂ sM) (a : ℝ),
        D.IsExceptional → MMP.Intersection.IsLogDiscrepancy sM n (L + b • C) D a → 0 < a) :
    (∀ P, 0 ≤ (L + ν • C).coeff P ∧ (L + ν • C).coeff P ≤ 1) ∧
      ∀ (n : ℕ) (D : DivisorOver ℂ sM) (a : ℝ),
        D.IsExceptional → MMP.Intersection.IsLogDiscrepancy sM n (L + ν • C) D a → 0 < a := by
  have hCc : ∀ P, 0 ≤ C.coeff P := fun P => by rw [DivisorWithCoeffs.coeff_apply]; exact hC P
  refine ⟨fun P => ⟨?_, ?_⟩, fun n D a hD ha => ?_⟩
  · simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact add_nonneg (h0.1 P).1 (mul_nonneg hν0 (hCc P))
  · have := (hb.1 P).2
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at this ⊢
    nlinarith [hCc P]
  · obtain ⟨c', hc'0, hc'⟩ := FSPRef.exists_isLogDiscrepancy_add_smul hQ ha
    have h2 := hb.2 n D _ hD (hc' b)
    have h3 := hc'0 hC
    nlinarith

/-- **A plt reference across a flip.** Let `L ∼_ℚ B + c C` be a plt reference for `E` below
`top`, and let the step be a flip at the threshold `t ∈ (c, top]`, presented by the partial
isomorphism `φ`. Then the strict transform `L⁺` is a plt reference for the strict transform of
`E` below `t`, through `e.trans φ`; the diagram is a real flip for `(K, L)`, and the upper level
`K + L + (t - c) C` descends crepantly. -/
private theorem RefCore.flip {sZ : Z ⟶ Spec (.of ℂ)} {m m' : ScalingModel Z}
    (hm : m.IsGood sZ) (hm' : m'.IsGood sZ) {st : ScalingStep m m'} (hst : st.IsStep)
    [IsLocallyNoetherian st.W] [IsNormal st.W]
    (hfl : IsRealFlipStep m.s st.sW m'.s m.K m.B m'.K m'.B st.f st.fp)
    (hdesc : ∃ (_ : IsLocallyNoetherian st.W) (_ : IsNormal st.W) (D : RDivisor st.W),
      IsRCartierPullback st.f D (logCanonicalDivisor m.K (m.B + m'.lam • m.C)) ∧
      IsRCartierPullback st.fp D
        (flipTransform st.f st.fp (logCanonicalDivisor m.K (m.B + m'.lam • m.C))))
    (hK : m'.K = flipTransform st.f st.fp m.K) (φ : m.M.PartialIso m'.M)
    (hφs : ∀ Q : MMP.Mori.PrimeDivisor m.M, Q.genericPoint ∈ φ.source)
    (hφt : ∀ Q : MMP.Mori.PrimeDivisor m'.M, Q.genericPoint ∈ φ.target)
    (hφover : φ.IsOver m.s m'.s)
    (hφtr : ∀ (R : Type) [AddCommMonoid R] (D : DivisorWithCoeffs R m.M),
      MMP.Mori.RationalMap.transformDivisor φ.toRationalMap D = flipTransform st.f st.fp D)
    (hφpt : ∀ (x : m.M) (hx : x ∈ φ.source), st.fp (φ.toPartialMap.hom ⟨x, hx⟩) = st.f x)
    (hφbir : ∀ x ∈ φ.source, st.f x ∈ MMP.Mori.biregularLocus st.f)
    (hφbir' : ∀ x ∈ φ.target, st.fp x ∈ MMP.Mori.biregularLocus st.fp)
    {X₀ : Scheme.{0}} [IsIntegral X₀] [IsLocallyNoetherian X₀] [IsNormal X₀]
    [IsSeparated (X₀ ↘ ⊤_ Scheme)] {sX₀ : X₀ ⟶ Spec (.of ℂ)} {S₀ : MMP.Mori.PrimeDivisor X₀}
    {A₀ : QDivisor X₀} {E : MMP.Mori.PrimeDivisor m.M} {E' : MMP.Mori.PrimeDivisor m'.M}
    (hEE' : flipTransformPrimeDivisor st.f st.fp E = some E') {c top : ℝ} (hc0 : 0 ≤ c)
    (hc : c < m'.lam) (htop : m'.lam ≤ top) {e : X₀.PartialIso m.M} {L : RDivisor m.M}
    (hcore : RefCore sX₀ S₀ A₀ m E c top e L) :
    RefCore sX₀ S₀ A₀ m' E' c m'.lam (e.trans φ) (flipTransform st.f st.fp L) ∧
      IsRealFlipStep m.s st.sW m'.s m.K L m'.K (flipTransform st.f st.fp L) st.f st.fp ∧
      ∃ D : RDivisor st.W,
        IsRCartierPullback st.f D (logCanonicalDivisor m.K (L + (m'.lam - c) • m.C)) ∧
        IsRCartierPullback st.fp D
          (logCanonicalDivisor m'.K (flipTransform st.f st.fp L + (m'.lam - c) • m'.C)) := by
  classical
  obtain ⟨hW1, hW2, D, hD, hD'⟩ := hdesc
  set t := m'.lam with ht
  have hμ : 0 < t - c := sub_pos.mpr hc
  have ht0 : 0 < t := hst.lam_pos
  -- separatedness and instances
  have hsep : ∀ {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ)), MMP.Mori.IsProjectiveVariety ℂ sT →
      IsSeparated (T ↘ ⊤_ Scheme) := fun sT hT => by
    haveI : IsSeparated sT := hT.toIsVariety.toIsSeparated
    rw [show (_ ↘ ⊤_ Scheme) = sT ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  haveI := hsep m.s hm.isProjectiveVariety
  haveI := hsep m'.s hm'.isProjectiveVariety
  have hWv := hfl.isNegativeExtremalContraction.isNormalVariety_target
  haveI : IsIntegral st.W := hWv.1.toIsIntegral
  haveI : CompactSpace st.W := by
    haveI : QuasiCompact st.sW := hWv.1.toQuasiCompact
    exact QuasiCompact.compactSpace_of_compactSpace st.sW
  haveI : IsDominant st.f := hfl.isBirationalMorphism.isDominant
  haveI : IsDominant st.fp := hfl.isBirationalMorphism_flip.isDominant
  haveI : QuasiCompact st.f := by haveI := hfl.isSmall.isProper; infer_instance
  haveI : QuasiCompact st.fp := by haveI := hfl.isSmall_flip.isProper; infer_instance
  haveI : QuasiCompact m.s := hm.isProjectiveVariety.toIsVariety.toQuasiCompact
  haveI : QuasiCompact m'.s := hm'.isProjectiveVariety.toIsVariety.toQuasiCompact
  have hC0 : 0 ≤ m.C := fun P => by
    have := hm.coeff_C_nonneg P
    rwa [DivisorWithCoeffs.coeff_apply] at this
  -- linear algebra of the strict transform
  have hcoeffφ : ∀ (D : RDivisor m.M) {Q : MMP.Mori.PrimeDivisor m.M}
      {Q' : MMP.Mori.PrimeDivisor m'.M},
      MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q = some Q' →
        (flipTransform st.f st.fp D).coeff Q' = D.coeff Q := fun D _ _ h => by
    rw [← hφtr ℝ D]
    exact FSPRef.coeff_transformDivisor_of_eq_some φ hφs h D
  have hφZ : ∀ (D : Divisor m.M) {Q : MMP.Mori.PrimeDivisor m.M}
      {Q' : MMP.Mori.PrimeDivisor m'.M},
      MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap Q = some Q' →
        (flipTransform st.f st.fp D).coeff Q' = D.coeff Q := fun D _ _ h => by
    rw [← hφtr ℤ D]
    exact FSPRef.coeff_transformDivisor_of_eq_some φ hφs h D
  have htoR : ∀ D : Divisor m.M, flipTransform st.f st.fp (Divisor.toRDivisor D) =
      Divisor.toRDivisor (flipTransform st.f st.fp D) := by
    intro D
    ext Q'
    obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    change (flipTransform st.f st.fp (Divisor.toRDivisor D)).coeff Q' =
      (Divisor.toRDivisor (flipTransform st.f st.fp D)).coeff Q'
    rw [hcoeffφ _ hQQ', Divisor.coeff_toRDivisor, Divisor.coeff_toRDivisor, hφZ D hQQ']
  have hsmulT : ∀ (a : ℝ) (D : RDivisor m.M),
      flipTransform st.f st.fp (a • D) = a • flipTransform st.f st.fp D := by
    intro a D
    ext Q'
    obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    change (flipTransform st.f st.fp (a • D)).coeff Q' = (a • flipTransform st.f st.fp D).coeff Q'
    rw [hcoeffφ _ hQQ', DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul, hcoeffφ _ hQQ']
  have hB' : m'.B = flipTransform st.f st.fp m.B := hst.eq_flipTransform_B
  have hC' : m'.C = flipTransform st.f st.fp m.C := hst.eq_flipTransform_C
  have hlogT : ∀ D₁ : RDivisor m.M, flipTransform st.f st.fp (logCanonicalDivisor m.K D₁) =
      logCanonicalDivisor m'.K (flipTransform st.f st.fp D₁) := by
    intro D₁
    simp only [logCanonicalDivisor, map_add, htoR, hK]
  have hBtC : ∀ a : ℝ, flipTransform st.f st.fp (m.B + a • m.C) = m'.B + a • m'.C := fun a => by
    rw [map_add, hsmulT, ← hB', ← hC']
  -- `L ∼_ℚ B + c C` through a rational function of the base
  obtain ⟨n, v, hn, hv⟩ := hcore.linEquiv
  obtain ⟨u, hu, rfl⟩ := MMP.Fourfold.exists_pullbackRationalFunction_eq hfl.isBirationalMorphism v
  have hu' := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant st.fp
    (principalDivisor u)
  have hPT := FSPRef.IsRealFlipStep.flipTransform_principalDivisor_pullback hfl φ hφs hφt
    (hφtr ℤ) hφpt hφbir hφbir' u hu hu'
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hL : L = m.B + c • m.C + (1 / (n : ℝ)) •
      Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.f u hu)) := by
    rw [← hv, smul_smul, one_div_mul_cancel hn0, one_smul]
    abel
  have hL' : flipTransform st.f st.fp L = m'.B + c • m'.C + (1 / (n : ℝ)) •
      Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.fp u hu')) := by
    conv_lhs => rw [hL]
    rw [map_add, hBtC, hsmulT, htoR, hPT]
  have hPf : IsRCartierPullback st.f ((1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor u))
      ((1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.f u hu))) :=
    MMP.Fourfold.isRCartierPullback_smul _ (MMP.Fourfold.isRCartierPullback_toRDivisor
      (Divisor.isCartier_principalDivisor u) hu (Divisor.isPullback_principalDivisor u hu))
  have hPfp : IsRCartierPullback st.fp ((1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor u))
      ((1 / (n : ℝ)) •
        Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.fp u hu'))) :=
    MMP.Fourfold.isRCartierPullback_smul _ (MMP.Fourfold.isRCartierPullback_toRDivisor
      (Divisor.isCartier_principalDivisor u) hu' (Divisor.isPullback_principalDivisor u hu'))
  -- the upper level `K + L + (t - c) C` descends crepantly
  have hadj : logCanonicalDivisor m.K (L + (t - c) • m.C) =
      logCanonicalDivisor m.K (m.B + t • m.C) + (1 / (n : ℝ)) •
        Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.f u hu)) := by
    rw [hL]
    simp only [logCanonicalDivisor]
    module
  have hadj' : logCanonicalDivisor m'.K (flipTransform st.f st.fp L + (t - c) • m'.C) =
      flipTransform st.f st.fp (logCanonicalDivisor m.K (m.B + t • m.C)) + (1 / (n : ℝ)) •
        Divisor.toRDivisor (principalDivisor (pullbackRationalFunction st.fp u hu')) := by
    rw [hL', hlogT, hBtC]
    simp only [logCanonicalDivisor]
    module
  have hDD : IsRCartierPullback st.f (D + (1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor u))
      (logCanonicalDivisor m.K (L + (t - c) • m.C)) := by
    rw [hadj]
    exact MMP.Fourfold.isRCartierPullback_add hD hPf
  have hDD' : IsRCartierPullback st.fp
      (D + (1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor u))
      (logCanonicalDivisor m'.K (flipTransform st.f st.fp L + (t - c) • m'.C)) := by
    rw [hadj']
    exact MMP.Fourfold.isRCartierPullback_add hD' hPfp
  set D' := D + (1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor u) with hD'def
  -- every level `0 ≤ ν < t - c` of the reference is a real flip
  have hflipν : ∀ ν : ℝ, 0 ≤ ν → ν < t - c →
      IsRealFlipStep m.s st.sW m'.s m.K (L + ν • m.C) m'.K
        (flipTransform st.f st.fp L + ν • m'.C) st.f st.fp := by
    intro ν hν hνμ
    set a := (t - c - ν) / t with ha
    have ha0 : 0 < a := div_pos (by linarith) ht0
    have hν' : ν = t - c - a * t := by rw [ha, div_mul_cancel₀ _ ht0.ne']; ring
    have hneg : IsRelativelyAntiAmple st.f (logCanonicalDivisor m.K (L + ν • m.C)) := by
      have h1 := hfl.isNegativeExtremalContraction.isRelativelyAntiAmple
      have hP : IsRCartierPullback st.f (a • D + (-1 : ℝ) • D')
          (a • logCanonicalDivisor m.K (m.B + t • m.C) +
            (-1 : ℝ) • logCanonicalDivisor m.K (L + (t - c) • m.C)) :=
        MMP.Fourfold.isRCartierPullback_add (MMP.Fourfold.isRCartierPullback_smul _ hD)
          (MMP.Fourfold.isRCartierPullback_smul (-1) hDD)
      have := FSPRef.isRelativelyAmple_smul_add_of_isRCartierPullback h1 ha0 hP
      unfold IsRelativelyAntiAmple
      convert this using 1
      rw [hν']
      simp only [logCanonicalDivisor]
      module
    have hpos : IsRelativelyAmple st.fp
        (logCanonicalDivisor m'.K (flipTransform st.f st.fp L + ν • m'.C)) := by
      have h1 := hfl.isRelativelyAmple_flip
      have hP : IsRCartierPullback st.fp ((-a) • D + D')
          ((-a) • flipTransform st.f st.fp (logCanonicalDivisor m.K (m.B + t • m.C)) +
            logCanonicalDivisor m'.K (flipTransform st.f st.fp L + (t - c) • m'.C)) :=
        MMP.Fourfold.isRCartierPullback_add (MMP.Fourfold.isRCartierPullback_smul _ hD') hDD'
      have := FSPRef.isRelativelyAmple_smul_add_of_isRCartierPullback h1 ha0 hP
      convert this using 1
      rw [hlogT, hBtC, hν']
      simp only [logCanonicalDivisor]
      module
    exact
      { hfl with
        isNegativeExtremalContraction :=
          { hfl.isNegativeExtremalContraction with
            isCartierCombination := FSPRef.isCartierCombination_of_isQFactorial hm.isQFactorial _
            isRelativelyAntiAmple := hneg }
        isRelativelyAmple_flip := hpos
        eq_flipTransform := by rw [map_add, hsmulT, ← hC'] }
  have hflipL : IsRealFlipStep m.s st.sW m'.s m.K L m'.K (flipTransform st.f st.fp L)
      st.f st.fp := by
    simpa using hflipν 0 le_rfl hμ
  -- the strict transform of `E`
  have hφE : MMP.Mori.RationalMap.transformPrimeDivisor φ.toRationalMap E = some E' := by
    obtain ⟨Q', hQ', -⟩ := FSPRef.exists_transformPrimeDivisor_eq_some φ E (hφs _)
    have h1 := hφtr ℤ (Finsupp.single E 1)
    rw [MMP.Mori.RationalMap.transformDivisor_single_of_eq_some hQ',
      flipTransform_single_of_eq_some hEE'] at h1
    rw [hQ', Finsupp.single_left_injective one_ne_zero h1]
  -- the upper level at `t - c` on `m` is plt
  have hpltU := plt_add_smul_of_le hm.isQFactorial hC0 hμ.le (by linarith) hcore.plt
    hcore.plt_upper
  refine ⟨{ isOver := hcore.isOver.trans hφover
            transform_S₀ := ?_
            ord := FSPRef.forall_isInverseExceptional_trans e φ hφt _ hcore.ord
            linEquiv := ⟨n, pullbackRationalFunction st.fp u hu', hn, ?_⟩
            plt := ⟨fun Q' => ?_, ?_⟩
            coeff_E := by rw [hst.coeff_flipTransform E E' hEE' L]; exact hcore.coeff_E
            coeff_lt_one := fun Q' hQ' => ?_
            coeff_C_E := by
              rw [hC', hst.coeff_flipTransform E E' hEE' m.C]; exact hcore.coeff_C_E
            le := ?_
            plt_upper := ⟨fun Q' => ?_, ?_⟩ }, hflipL, D', hDD, hDD'⟩
  · obtain ⟨Q', hQ', hval⟩ := FSPRef.exists_transformPrimeDivisor_eq_some φ E (hφs _)
    rw [hφE, Option.some.injEq] at hQ'
    subst hQ'
    exact FSPRef.transformPrimeDivisor_trans_eq_some e φ hcore.transform_S₀ (hφs _) hval
  · rw [hL', add_sub_cancel_left, smul_smul, mul_one_div_cancel hn0, one_smul]
  · obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    rw [hcoeffφ L hQQ']
    exact hcore.plt.1 Q
  · have := FSPRef.IsRealFlipStep.pos_of_isLogDiscrepancy hflipL hm.isQFactorial
      hm.isCanonicalDivisor hcore.plt.2
    exact this
  · obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    rw [hcoeffφ L hQQ']
    refine hcore.coeff_lt_one Q fun hQE => hQ' ?_
    subst hQE
    exact Option.some_injective _ (hQQ'.symm.trans hφE)
  · intro Q'
    obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    have h1 : (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor
        (e.trans φ).toRationalMap A₀)) Q' =
        (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor e.toRationalMap A₀)) Q := by
      change ((MMP.Mori.RationalMap.transformDivisor (e.trans φ).toRationalMap A₀ Q' : ℚ) :
        ℝ) = ((MMP.Mori.RationalMap.transformDivisor e.toRationalMap A₀ Q : ℚ) : ℝ)
      rw [FSPRef.transformDivisor_trans e φ hφs hφt,
        FSPRef.coeff_transformDivisor_of_eq_some φ hφs hQQ']
    have h2 : (flipTransform st.f st.fp L - Finsupp.single E' 1 : RDivisor m'.M) Q' =
        (L - Finsupp.single E 1 : RDivisor m.M) Q := by
      rw [← hφtr ℝ, ← MMP.Mori.RationalMap.transformDivisor_single_of_eq_some hφE, ← map_sub]
      exact FSPRef.coeff_transformDivisor_of_eq_some φ hφs hQQ' _
    rw [h1, h2]
    exact hcore.le Q
  · obtain ⟨Q, -, hQQ', -⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target φ Q' (hφt Q')
    rw [hC', ← hsmulT, ← map_add, hcoeffφ _ hQQ']
    exact hpltU.1 Q
  · exact FSPRef.pos_of_isLogDiscrepancy_of_forall_lt hμ (fun ν hν hνμ => hflipν ν hν.le hνμ)
      hm.isQFactorial hm'.isQFactorial hm.isCanonicalDivisor hC0 hpltU.2

/-- **A plt reference across a divisorial step.** Let `L ∼_ℚ B + c C` be a plt reference for `E`
below `top`, and let the step contract the prime divisor `G ≠ E` at the threshold
`t ∈ (c, top]`. Then the push-forward `L' = f_* L` is a plt reference for the strict transform of
`E` below `t`: `K + L` is `f`-anti-ample, so log discrepancies only increase, strictly over `G`;
`K + L + (t - c) C` is `f`-trivial, so its log discrepancies are preserved, and `G` is not a
floor component of it. -/
private theorem RefCore.divisorial {sZ : Z ⟶ Spec (.of ℂ)} {m m' : ScalingModel Z}
    (hm : m.IsGood sZ) (hm' : m'.IsGood sZ) {st : ScalingStep m m'} (hst : st.IsStep)
    (hfb : IsBirationalMorphism st.f) {G : MMP.Mori.PrimeDivisor m.M}
    (hG : (MMP.Mori.exceptionalSet st.f : Set m.M) = G.support) [IsIso st.fp]
    {X₀ : Scheme.{0}} [IsIntegral X₀] [IsLocallyNoetherian X₀] [IsNormal X₀]
    [IsSeparated (X₀ ↘ ⊤_ Scheme)] {sX₀ : X₀ ⟶ Spec (.of ℂ)} {S₀ : MMP.Mori.PrimeDivisor X₀}
    {A₀ : QDivisor X₀} {E : MMP.Mori.PrimeDivisor m.M} {E' : MMP.Mori.PrimeDivisor m'.M}
    (hEE' : flipTransformPrimeDivisor st.f st.fp E = some E') {c top : ℝ} (hc0 : 0 ≤ c)
    (hc : c < m'.lam) (htop : m'.lam ≤ top) {e : X₀.PartialIso m.M} {L : RDivisor m.M}
    (hcore : RefCore sX₀ S₀ A₀ m E c top e L) :
    ∃ (e' : X₀.PartialIso m'.M) (L' : RDivisor m'.M), RefCore sX₀ S₀ A₀ m' E' c m'.lam e' L' := by
  classical
  set t := m'.lam with ht
  have hμ : 0 < t - c := sub_pos.mpr hc
  have ht0 : 0 < t := hst.lam_pos
  have hneg := hst.isNegativeExtremalContraction
  have hWv := hneg.isNormalVariety_target
  haveI : IsIntegral st.W := hWv.1.toIsIntegral
  have hsep : ∀ {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ)), MMP.Mori.IsProjectiveVariety ℂ sT →
      IsSeparated (T ↘ ⊤_ Scheme) := fun sT hT => by
    haveI : IsSeparated sT := hT.toIsVariety.toIsSeparated
    rw [show (_ ↘ ⊤_ Scheme) = sT ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  haveI := hsep m.s hm.isProjectiveVariety
  haveI := hsep m'.s hm'.isProjectiveVariety
  haveI : QuasiCompact m.s := hm.isProjectiveVariety.toIsVariety.toQuasiCompact
  haveI : QuasiCompact m'.s := hm'.isProjectiveVariety.toIsVariety.toQuasiCompact
  -- the contraction onto the next model
  set f' : m.M ⟶ m'.M := st.f ≫ inv st.fp with hf'def
  haveI : IsProper st.f := hneg.isContraction.isProper
  haveI : IsProper f' := by rw [hf'def]; infer_instance
  have hMv : IsNormalVariety ℂ m.s := hneg.isNormalVariety_source
  have hM'v : IsNormalVariety ℂ m'.s := hm'.isQFactorial.1
  haveI : MMP.Mori.IsVariety ℂ m'.s := hM'v.1
  haveI : IsNormal st.W := hWv.2
  haveI : IsLocallyNoetherian st.W := by
    haveI : LocallyOfFiniteType st.sW := hWv.1.toLocallyOfFiniteType
    exact LocallyOfFiniteType.isLocallyNoetherian st.sW
  have hfs : st.f ≫ st.sW = m.s := hneg.isContraction.comp_eq
  haveI : IsDominant st.f := hfb.isDominant
  have hgs : st.g ≫ sZ = st.sW := by
    refine AlgebraicGeometry.ext_of_isDominant st.f ?_
    rw [← Category.assoc, hst.comp_eq, hm.comp_eq, hfs]
  have hfps : st.fp ≫ st.sW = m'.s := by
    rw [← hgs, ← Category.assoc, hst.comp_eq_plus, hm'.comp_eq]
  have hf's : f' ≫ m'.s = m.s := by
    rw [hf'def, ← hfps, Category.assoc, IsIso.inv_hom_id_assoc, hfs]
  have hf'b : IsBirationalMorphism f' :=
    MMP.Fourfold.Oai4C1.CommonModel.isBirationalMorphism_comp hfb
      (MMP.Mori.isBirationalMorphism_of_isIso _)
  haveI : IsDominant f' := hf'b.isDominant
  have hf'c : IsBirationalContraction ℂ m'.s m.s f' :=
    { isVariety_target := hM'v.1
      isVariety_source := hMv.1
      comp_eq := hf's
      isProper := inferInstance
      isIso_app := fun U => by
        rw [hf'def, Scheme.Hom.comp_app]
        exact @IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance
          (hneg.isContraction.isIso_app ((inv st.fp) ⁻¹ᵁ U))
      dim_eq := by
        haveI : MMP.Mori.IsVariety ℂ (f' ≫ m'.s) := by rw [hf's]; exact hMv.1
        exact (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism m'.s
          (f' ≫ m'.s) hf'b).symm }
  have hG' : MMP.Flips.exceptionalSet f' = G.support := by
    rw [hf'def, FSPCrit.exceptionalSet_comp_iso,
      FSPCrit.exceptionalSet_eq_of_mori_exceptionalSet_eq hfb hG]
  obtain ⟨htr, hptr⟩ := hst.div_transform
  have hiffP := fun P P' => MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f' P P'
  have hEf' : f' E.genericPoint = E'.genericPoint := (hiffP E E').mp (by rw [← hptr]; exact hEE')
  have hEG : E ≠ G := fun h => by
    have := hst.eq_none inferInstance G hG
    rw [← h, hEE'] at this
    exact absurd this (by simp)
  -- `f'` as a partial isomorphism
  obtain ⟨ε, hεr, hεover, hεt, hεs, hεv⟩ := exists_partialIso_of_isBirationalMorphism f' hf'b hf's
  have hεt' : ∀ Q : MMP.Mori.PrimeDivisor m'.M, Q.genericPoint ∈ ε.target := fun Q =>
    hεt _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le
  have hbir : ∀ P : MMP.Mori.PrimeDivisor m.M, P ≠ G →
      f' P.genericPoint ∈ MMP.Mori.biregularLocus f' := fun P hP => by
    have hη : P.genericPoint ∉ MMP.Flips.exceptionalSet f' := by
      rw [hG']; exact FSPCrit.genericPoint_notMem_support_of_ne hP
    apply MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f' hf'b
    rw [MMP.Flips.coheight_map_of_notMem_exceptionalSet hη, P.coheight_genericPoint]
  have hεsP : ∀ P : MMP.Mori.PrimeDivisor m.M, P ≠ G → P.genericPoint ∈ ε.source := fun P hP =>
    hεs _ (hbir P hP)
  have hcoeff : ∀ (D : RDivisor m.M) {P : MMP.Mori.PrimeDivisor m.M}
      {P' : MMP.Mori.PrimeDivisor m'.M}, f' P.genericPoint = P'.genericPoint →
      (MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap D).coeff P' = D.coeff P :=
    fun D _ _ h => FSPCrit.coeff_transformDivisor_hom hf'b.functionFieldMap_bijective D h
  have hpre : ∀ P' : MMP.Mori.PrimeDivisor m'.M,
      ∃ P : MMP.Mori.PrimeDivisor m.M, P.genericPoint ∈ ε.source ∧
        f' P.genericPoint = P'.genericPoint := by
    intro P'
    have hb := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal f' hf'b
      (MMP.Mori.PrimeDivisor.coheight_genericPoint P').le
    obtain ⟨P, hPη, -⟩ :=
      FSPCrit.exists_primeDivisor_map_eq_of_mem_biregularLocus f' hb P'.coheight_genericPoint
    exact ⟨P, hεs _ (hPη ▸ hb), hPη⟩
  have hinj : ∀ {P₁ P₂ : MMP.Mori.PrimeDivisor m.M}, P₁.genericPoint ∈ ε.source →
      P₂.genericPoint ∈ ε.source → f' P₁.genericPoint = f' P₂.genericPoint → P₁ = P₂ := by
    intro P₁ P₂ h₁ h₂ h
    have hι : Function.Injective ε.toPartialMap.hom :=
      (ε.iso.hom ≫ ε.target.ι).isOpenEmbedding.injective
    rw [← hεv _ h₁, ← hεv _ h₂] at h
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (congrArg Subtype.val (hι h))
  -- linearity of the push-forward
  have hlin : ∀ (D₁ D₂ : RDivisor m.M) (a : ℝ),
      MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap (D₁ + a • D₂) =
        MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap D₁ +
          a • MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap D₂ := by
    intro D₁ D₂ a
    have e1 := (MMP.Mori.RationalMap.transformDivisorₗ ℝ (X := m.M) f'.toRationalMap).map_add
      D₁ (a • D₂)
    rw [(MMP.Mori.RationalMap.transformDivisorₗ ℝ _).map_smul] at e1
    simpa only [MMP.Mori.RationalMap.transformDivisorₗ_apply] using e1
  have hB' : m'.B = MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap m.B := by
    rw [hst.eq_flipTransform_B, htr]
  have hC' : m'.C = MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap m.C := by
    rw [hst.eq_flipTransform_C, htr]
  -- `L ∼_ℚ B + c C` through a rational function of the next model
  obtain ⟨n, v, hn, hv⟩ := hcore.linEquiv
  obtain ⟨w, hw, rfl⟩ := MMP.Fourfold.exists_pullbackRationalFunction_eq hf'b v
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  set Pv := Divisor.toRDivisor (principalDivisor (pullbackRationalFunction f' w hw)) with hPv
  have hL : L = m.B + c • m.C + (1 / (n : ℝ)) • Pv := by
    rw [← hv, smul_smul, one_div_mul_cancel hn0, one_smul]
    abel
  have hPvpush : MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap Pv =
      Divisor.toRDivisor (principalDivisor w) := by
    rw [hPv, transformDivisor_toRDivisor, MMP.Positivity.transformDivisor_of_isPullback_divisor
      hM'v (by rw [hf's]; exact hMv) hf'b (Divisor.isCartier_principalDivisor w)
      (Divisor.isPullback_principalDivisor w hw)]
  have hPvpb : ∀ a : ℝ, IsRCartierPullback f' (a • Divisor.toRDivisor (principalDivisor w))
      (a • Pv) := fun a =>
    MMP.Fourfold.isRCartierPullback_smul _ (MMP.Fourfold.isRCartierPullback_toRDivisor
      (Divisor.isCartier_principalDivisor w) hw (Divisor.isPullback_principalDivisor w hw))
  set L' := MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap L with hL'def
  have hL' : L' = m'.B + c • m'.C + (1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor w) := by
    rw [hL'def, hL, hlin, hlin, hPvpush, ← hB', ← hC']
  -- the lower adjoint `K + L` is anti-ample over `f'`
  have hfp : IsProjective st.f := by
    haveI : IsSeparated st.sW := hWv.1.toIsSeparated
    refine IsProjective.of_comp st.f st.sW ?_
    rw [hfs]
    exact hm.isProjectiveVariety.isProjective.isProjective
  have hantiL : IsRelativelyAntiAmple f' (logCanonicalDivisor m.K L) := by
    have h1 := isRelativelyAntiAmple_of_lt (u := c) hneg hfp hst.isNumericallyTrivialOver ht0 hc
    have h1' : IsRelativelyAntiAmple f' (logCanonicalDivisor m.K (m.B + c • m.C)) :=
      FSPCrit.isRelativelyAmple_comp h1
    have := FSPRef.isRelativelyAmple_smul_add_of_isRCartierPullback h1' one_pos
      (hPvpb (-(1 / (n : ℝ))))
    unfold IsRelativelyAntiAmple
    convert this using 1
    rw [hL]
    simp only [logCanonicalDivisor]
    module
  -- the upper level is plt on `m`, crepant over `f'`, and not reduced along `G`
  have hC0 : 0 ≤ m.C := fun P => by
    have := hm.coeff_C_nonneg P
    rwa [DivisorWithCoeffs.coeff_apply] at this
  have hpltU := plt_add_smul_of_le hm.isQFactorial hC0 hμ.le (by linarith) hcore.plt
    hcore.plt_upper
  have hantiU : IsRelativelyNef ℂ m.s f' (-logCanonicalDivisor m.K (L + (t - c) • m.C)) := by
    have h1 := IsNumericallyTrivialOver.comp_of_injective (inv st.fp).isOpenEmbedding.injective
      hst.isNumericallyTrivialOver
    have h2 := FSPRef.isRelativelyNef_add_smul_principalDivisor
      (IsNumericallyTrivialOver.isRelativelyNef (IsNumericallyTrivialOver.neg' h1))
      (-(1 / (n : ℝ))) (pullbackRationalFunction f' w hw)
    rw [← hf'def] at h2
    convert h2 using 1
    rw [hL]
    simp only [logCanonicalDivisor, hPv]
    module
  have hCG : m.C.coeff G = 0 := by
    have hBG := hst.one_le_coeff_of_exceptionalSet_eq hm hfb hG
    have h1 := IsRealLcPair.coeff_le_one hm.isRealLcPair_upper G
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h1
    have hlam : 0 < m.lam := ht0.trans_le hst.lam_le
    have := hm.coeff_C_nonneg G
    nlinarith
  have hUG : (L + (t - c) • m.C).coeff G < 1 := by
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul, hCG,
      mul_zero, add_zero]
    exact hcore.coeff_lt_one G (Ne.symm hEG)
  have hU' : MMP.Mori.RationalMap.transformDivisor (X := m.M) f'.toRationalMap
      (L + (t - c) • m.C) = L' + (t - c) • m'.C := by rw [hlin, hC']
  -- the reference along `f'`
  have hvalE : E'.genericPoint = ε.toPartialMap.hom ⟨E.genericPoint, hεsP E hEG⟩ := by
    rw [hεv]; exact hEf'.symm
  refine ⟨e.trans ε, L',
    { isOver := hcore.isOver.trans hεover
      transform_S₀ := FSPRef.transformPrimeDivisor_trans_eq_some e ε hcore.transform_S₀
        (hεsP E hEG) hvalE
      ord := FSPRef.forall_isInverseExceptional_trans e ε hεt' _ hcore.ord
      linEquiv := ⟨n, w, hn, ?_⟩
      plt := ⟨fun Q' => ?_, ?_⟩
      coeff_E := by rw [hL'def, hcoeff L hEf']; exact hcore.coeff_E
      coeff_lt_one := fun Q' hQ' => ?_
      coeff_C_E := by rw [hC', hcoeff m.C hEf']; exact hcore.coeff_C_E
      le := ?_
      plt_upper := ⟨fun Q' => ?_, ?_⟩ }⟩
  · rw [hL', add_sub_cancel_left, smul_smul, mul_one_div_cancel hn0, one_smul]
  · obtain ⟨Q, -, hQ⟩ := hpre Q'
    rw [hL'def, hcoeff L hQ]
    exact hcore.plt.1 Q
  · exact pos_of_isLogDiscrepancy_of_divisorial hM'v hm.isQFactorial hm'.isQFactorial hf's hf'c
      hG' hm.isCanonicalDivisor hm'.isCanonicalDivisor
      (isRelativelyNef_neg_of_isRelativelyAntiAmple f' hantiL) (Or.inr hantiL)
      (fun P => (hcore.plt.1 P).2) hcore.plt.2
  · obtain ⟨Q, hQs, hQ⟩ := hpre Q'
    rw [hL'def, hcoeff L hQ]
    refine hcore.coeff_lt_one Q fun hQE => hQ' ?_
    subst hQE
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hQ.symm.trans hEf')
  · intro Q'
    obtain ⟨Q, hQs, hQQ', hval⟩ :=
      FSPRef.exists_transformPrimeDivisor_eq_some_of_mem_target ε Q' (hεt' Q')
    have hQf : f' Q.genericPoint = Q'.genericPoint := by rw [hval, hεv]
    have h1 : (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor
        (e.trans ε).toRationalMap A₀)) Q' =
        (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor e.toRationalMap A₀)) Q := by
      change ((MMP.Mori.RationalMap.transformDivisor (e.trans ε).toRationalMap A₀ Q' : ℚ) :
        ℝ) = ((MMP.Mori.RationalMap.transformDivisor e.toRationalMap A₀ Q : ℚ) : ℝ)
      rw [coeff_transformDivisor_trans_of_mem_source e ε hQs hval (hεt' Q') A₀]
    have hiff : Q' = E' ↔ Q = E := by
      constructor
      · intro h
        subst h
        exact hinj hQs (hεsP E hEG) (hQf.trans hEf'.symm)
      · intro h
        subst h
        exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hQf.symm.trans hEf')
    have h2 : (L' - Finsupp.single E' 1 : RDivisor m'.M) Q' =
        (L - Finsupp.single E 1 : RDivisor m.M) Q := by
      change L'.coeff Q' - (Finsupp.single E' (1 : ℝ)) Q' =
        L.coeff Q - (Finsupp.single E (1 : ℝ)) Q
      rw [hL'def, hcoeff L hQf, Finsupp.single_apply, Finsupp.single_apply]
      by_cases hE : Q = E
      · rw [if_pos (hiff.mpr hE).symm, if_pos hE.symm]
      · rw [if_neg (fun h => hE (hiff.mp h.symm)), if_neg (fun h => hE h.symm)]
    rw [h1, h2]
    exact hcore.le Q
  · obtain ⟨Q, -, hQ⟩ := hpre Q'
    rw [← hU', hcoeff _ hQ]
    exact hpltU.1 Q
  · have := pos_of_isLogDiscrepancy_of_divisorial hM'v hm.isQFactorial hm'.isQFactorial hf's hf'c
      hG' hm.isCanonicalDivisor hm'.isCanonicalDivisor hantiU (Or.inl hUG)
      (fun P => (hpltU.1 P).2) hpltU.2
    rw [hU'] at this
    exact this

/-- **A plt reference survives a step of the program**, if its prime survives. -/
private theorem HasRef.step {sZ : Z ⟶ Spec (.of ℂ)} {m m' : ScalingModel Z}
    (hm : m.IsGood sZ) (hm' : m'.IsGood sZ) {st : ScalingStep m m'} (hst : st.IsStep)
    {E : MMP.Mori.PrimeDivisor m.M} {E' : MMP.Mori.PrimeDivisor m'.M}
    (hEE' : flipTransformPrimeDivisor st.f st.fp E = some E') {c top : ℝ} (hc0 : 0 ≤ c)
    (hc : c < m'.lam) (htop : m'.lam ≤ top) (hE : HasRef m E c top) :
    HasRef m' E' c m'.lam := by
  classical
  obtain ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e, L, hcore⟩ := hE
  haveI : IsSeparated (X₀ ↘ ⊤_ Scheme) := by
    haveI : IsSeparated sX₀ := hX₀.1.toIsSeparated
    rw [show (X₀ ↘ ⊤_ Scheme) = sX₀ ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  rcases hst.divisorial_or_realFlip with ⟨hfb, ⟨G, hG⟩, hiso⟩ | hfl
  · haveI := hiso
    obtain ⟨e', L', hcore'⟩ := RefCore.divisorial hm hm' hst hfb hG hEE' hc0 hc htop hcore
    exact ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e', L', hcore'⟩
  · have hK := hst.eq_flipTransform_K.resolve_left fun ⟨_, _, hiso⟩ => hfl.1.not_isIso_flip hiso
    obtain ⟨fl, -, hφover, hφs, hφt, hφtr, hφpt, hφbir, hφbir'⟩ :=
      FSPRef.IsRealFlipStep.exists_partialIso hfl.1
    have hWv := hfl.1.isNegativeExtremalContraction.isNormalVariety_target
    haveI : IsNormal st.W := hWv.2
    haveI : IsLocallyNoetherian st.W := by
      haveI : LocallyOfFiniteType st.sW := hWv.1.toLocallyOfFiniteType
      exact LocallyOfFiniteType.isLocallyNoetherian st.sW
    exact ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e.trans fl, _,
      (RefCore.flip hm hm' hst hfl.1 hfl.2.1 hK fl
        (fun Q => hφs _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le)
        (fun Q => hφt _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le) hφover hφtr hφpt
        hφbir hφbir' hEE' hc0 hc htop hcore).1⟩

/-- **Special termination along a plt reference, for a program of flips.** -/
private theorem IsProgram.eventually_disjoint_of_hasRef_of_flip {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {U : ℕ → ScalingModel Z}
    {stp : ∀ k, ScalingStep (U k) (U (k + 1))} (h : IsProgram sZ U stp)
    (hflip : ∀ k, ¬ (IsBirationalMorphism (stp k).f ∧
      (∃ E : MMP.Mori.PrimeDivisor (U k).M,
        (MMP.Mori.exceptionalSet (stp k).f : Set (U k).M) = E.support) ∧ IsIso (stp k).fp))
    {c top : ℝ} (hc0 : 0 ≤ c) (hc : ∀ k, c < (U (k + 1)).lam)
    (htop : ∀ k, (U (k + 1)).lam ≤ top) (E : MMP.Mori.PrimeDivisor (U 0).M)
    (hE : HasRef (U 0) E c top) :
    ∃ N, ∀ k, N ≤ k → ∀ Ek : MMP.Mori.PrimeDivisor (U k).M, trackPrime U stp E k = some Ek →
      Disjoint (MMP.Mori.exceptionalSet (stp k).f : Set (U k).M) (Ek.support : Set (U k).M) := by
  classical
  obtain ⟨X₀, _, _, _, _, sX₀, hX₀, hX₀p, S₀, _, A₀, hA₀, hAamp, hAS, e₀, L₀, hcore₀⟩ := hE
  haveI : IsSeparated (X₀ ↘ ⊤_ Scheme) := by
    haveI : IsSeparated sX₀ := hX₀.1.toIsSeparated
    rw [show (X₀ ↘ ⊤_ Scheme) = sX₀ ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  have hfl := fun k => ((h.isStep k).divisorial_or_realFlip).resolve_left (hflip k)
  have hK := fun k => ((h.isStep k).eq_flipTransform_K).resolve_left (hflip k)
  choose fl hφcomp hφover hφs hφt hφtr hφpt hφbir hφbir' using
    fun k => FSPRef.IsRealFlipStep.exists_partialIso (hfl k).1
  haveI : ∀ k, IsSeparated ((U k).M ↘ ⊤_ Scheme) := fun k => by
    haveI : IsSeparated (U k).s := (h.isGood k).isProjectiveVariety.toIsVariety.toIsSeparated
    rw [show ((U k).M ↘ ⊤_ Scheme) = (U k).s ≫ Limits.terminal.from (Spec (.of ℂ)) from
      Subsingleton.elim _ _]
    infer_instance
  have hφs' : ∀ k (Q : MMP.Mori.PrimeDivisor (U k).M), Q.genericPoint ∈ (fl k).source :=
    fun k Q => hφs k _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le
  have hφt' : ∀ k (Q : MMP.Mori.PrimeDivisor (U (k + 1)).M), Q.genericPoint ∈ (fl k).target :=
    fun k Q => hφt k _ (MMP.Mori.PrimeDivisor.coheight_genericPoint Q).le
  -- the strict transforms of `E` along the flips
  have himg : ∀ k (P : MMP.Mori.PrimeDivisor (U k).M),
      ∃ P', flipTransformPrimeDivisor (stp k).f (stp k).fp P = some P' := fun k P =>
    ((h.isStep k).exists_image P).resolve_right fun ⟨hb, hex, hiso⟩ => hflip k ⟨hb, ⟨P, hex⟩, hiso⟩
  choose nxt hnxt using himg
  let Ef : ∀ k, MMP.Mori.PrimeDivisor (U k).M := fun k =>
    Nat.rec (motive := fun k => MMP.Mori.PrimeDivisor (U k).M) E (fun k P => nxt k P) k
  have hEf : ∀ k, trackPrime U stp E k = some (Ef k) := by
    intro k
    induction k with
    | zero => rfl
    | succ k ih =>
      change (trackPrime U stp E k).bind _ = _
      rw [ih]
      exact hnxt k (Ef k)
  -- the instances on the bases of the flips
  have hWv : ∀ k, IsNormalVariety ℂ (stp k).sW := fun k =>
    (hfl k).1.isNegativeExtremalContraction.isNormalVariety_target
  haveI : ∀ k, IsNormal (stp k).W := fun k => (hWv k).2
  haveI : ∀ k, IsLocallyNoetherian (stp k).W := fun k => by
    haveI : LocallyOfFiniteType (stp k).sW := (hWv k).1.toLocallyOfFiniteType
    exact LocallyOfFiniteType.isLocallyNoetherian (stp k).sW
  -- the references along the flips
  let e : ∀ k, X₀.PartialIso (U k).M := fun k =>
    Nat.rec (motive := fun k => X₀.PartialIso (U k).M) e₀ (fun k ek => ek.trans (fl k)) k
  let Lf : ∀ k, RDivisor (U k).M := fun k =>
    Nat.rec (motive := fun k => RDivisor (U k).M) L₀
      (fun k L => flipTransform (stp k).f (stp k).fp L) k
  let topF : ℕ → ℝ := fun k => if k = 0 then top else (U k).lam
  have htopF : ∀ k, (U (k + 1)).lam ≤ topF k := fun k => by
    simp only [topF]
    split_ifs with hk
    · exact htop k
    · exact (h.isStep k).lam_le
  have hall : ∀ k, RefCore sX₀ S₀ A₀ (U k) (Ef k) c (topF k) (e k) (Lf k) := by
    intro k
    induction k with
    | zero =>
      have h0 : topF 0 = top := if_pos rfl
      rw [h0]
      exact hcore₀
    | succ k ih =>
      have := (RefCore.flip (h.isGood k) (h.isGood (k + 1)) (h.isStep k) (hfl k).1 (hfl k).2.1
        (hK k) (fl k) (hφs' k) (hφt' k) (hφover k) (hφtr k) (hφpt k) (hφbir k) (hφbir' k)
        (hnxt k (Ef k)) hc0 (hc k) (htopF k) ih).1
      have h1 : topF (k + 1) = (U (k + 1)).lam := if_neg (Nat.succ_ne_zero k)
      rw [h1]
      exact this
  have hstepF := fun k => (RefCore.flip (h.isGood k) (h.isGood (k + 1)) (h.isStep k) (hfl k).1
    (hfl k).2.1 (hK k) (fl k) (hφs' k) (hφt' k) (hφover k) (hφtr k) (hφpt k) (hφbir k)
    (hφbir' k) (hnxt k (Ef k)) hc0 (hc k) (htopF k) (hall k)).2
  have hC0 : ∀ k, 0 ≤ (U k).C := fun k P => by
    have := (h.isGood k).coeff_C_nonneg P
    rwa [DivisorWithCoeffs.coeff_apply] at this
  -- the levels `λ_k = t_k - c` of the reference
  have hlampos : ∀ k, 0 < (U (k + 1)).lam - c := fun k => sub_pos.mpr (hc k)
  have hlamanti : Antitone fun k => (U (k + 1)).lam - c :=
    antitone_nat_of_succ_le fun k => by linarith [(h.isStep (k + 1)).lam_le]
  have hpltup : ∀ k, (∀ P, 0 ≤ (Lf k + ((U (k + 1)).lam - c) • (U k).C).coeff P ∧
      (Lf k + ((U (k + 1)).lam - c) • (U k).C).coeff P ≤ 1) ∧
      ∀ (n : ℕ) (D : DivisorOver ℂ (U k).s) (a : ℝ), D.IsExceptional →
        MMP.Intersection.IsLogDiscrepancy (U k).s n (Lf k + ((U (k + 1)).lam - c) • (U k).C) D a →
          0 < a := fun k =>
    plt_add_smul_of_le (h.isGood k).isQFactorial (hC0 k) (hlampos k).le
      (by linarith [htopF k]) (hall k).plt (hall k).plt_upper
  have hnef' : ∀ k, IsRelativelyNef ℂ (U k).s (U k).π
      (logCanonicalDivisor (U k).K (Lf k + ((U (k + 1)).lam - c) • (U k).C)) := by
    intro k
    obtain ⟨n, v, hn, hv⟩ := (hall k).linEquiv
    have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
    have e1 : logCanonicalDivisor (U k).K (Lf k + ((U (k + 1)).lam - c) • (U k).C) =
        logCanonicalDivisor (U k).K ((U k).B + (U (k + 1)).lam • (U k).C) +
          (1 / (n : ℝ)) • Divisor.toRDivisor (principalDivisor v) := by
      have hL : Lf k = (U k).B + c • (U k).C + (1 / (n : ℝ)) •
          Divisor.toRDivisor (principalDivisor v) := by
        rw [← hv, smul_smul, one_div_mul_cancel hn0, one_smul]
        abel
      rw [hL]
      simp only [logCanonicalDivisor]
      module
    rw [e1]
    haveI : QuasiCompact (U k).s := (h.isGood k).isProjectiveVariety.toIsVariety.toQuasiCompact
    exact FSPRef.isRelativelyNef_add_smul_principalDivisor (h.isStep k).isRelativelyNef _ v
  obtain ⟨N, hN⟩ := eventually_disjoint_exceptionalSet_of_realPltFlip_scaling
    (fun k => (U k).M) (fun k => (U k).s) (fun k => (U k).K) Lf (fun k => (U k).C)
    (fun k => (stp k).W) (fun k => (stp k).sW) (fun k => (stp k).f) (fun k => (stp k).fp)
    Z sZ hZ (fun k => (U k).π) (fun k => (stp k).g) (fun k => (h.isGood k).comp_eq)
    (fun k => (h.isStep k).comp_eq) (fun k => (h.isStep k).comp_eq_plus)
    (fun k => ⟨4, (h.isGood k).isCanonicalDivisor⟩) (fun k => (h.isGood k).isProjectiveVariety)
    (fun k => (h.isGood k).isQFactorial) (fun k => (h.isGood k).dim_eq)
    (fun k => (hstepF k).1)
    (fun k => ⟨(hall k).plt.1, MMP.Fourfold.IsQFactorial.isRCartier (h.isGood k).isQFactorial _,
      (hall k).plt.2⟩)
    hC0 (fun k => (hfl k).2.2) (fun k => (U (k + 1)).lam - c) hlampos hlamanti hnef'
    (fun k => ⟨(hpltup k).1, MMP.Fourfold.IsQFactorial.isRCartier (h.isGood k).isQFactorial _,
      (hpltup k).2⟩)
    (fun k => (hstepF k).2) Ef (fun k => (hall k).coeff_E) (fun k => (hall k).coeff_C_E)
    (fun k => hnxt k (Ef k)) X₀ sX₀ hX₀ hX₀p S₀ A₀ hA₀ hAamp hAS
    (fun k => (e k).toRationalMap) (fun k => (e k).symm.toRationalMap)
    (fun k => ⟨e k, rfl, rfl⟩) (fun k => FSPRef.isOver_toRationalMap (e k) (hall k).isOver)
    (fun k => FSPRef.isOver_toRationalMap (e k).symm (hall k).isOver.symm)
    (fun k => (hall k).transform_S₀) (fun k => (hall k).ord) (fun k => (hall k).le)
  refine ⟨N, fun k hk Ek hEk => ?_⟩
  rw [hEf k] at hEk
  obtain rfl := Option.some_injective _ hEk
  exact (hN k hk).1

/-- **Special termination along a plt reference.** -/
private theorem IsProgram.eventually_disjoint_of_hasRef {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {U : ℕ → ScalingModel Z}
    {stp : ∀ k, ScalingStep (U k) (U (k + 1))} (h : IsProgram sZ U stp)
    {c top : ℝ} (hc0 : 0 ≤ c) (hc : ∀ k, c < (U (k + 1)).lam)
    (htop : ∀ k, (U (k + 1)).lam ≤ top)
    (E : MMP.Mori.PrimeDivisor (U 0).M) (hE : HasRef (U 0) E c top) :
    ∃ N, ∀ k, N ≤ k → ∀ Ek : MMP.Mori.PrimeDivisor (U k).M, trackPrime U stp E k = some Ek →
      Disjoint (MMP.Mori.exceptionalSet (stp k).f : Set (U k).M) (Ek.support : Set (U k).M) := by
  classical
  obtain ⟨K₀, hK₀⟩ := h.exists_forall_not_divisorial
  by_cases hnone : ∃ k₁, trackPrime U stp E k₁ = none
  · -- the prime is contracted at some step, and has no strict transform from then on
    obtain ⟨k₁, hk₁⟩ := hnone
    have hall : ∀ k, k₁ ≤ k → trackPrime U stp E k = none := by
      intro k hk
      induction hk with
      | refl => exact hk₁
      | step _ ih => change (trackPrime U stp E _).bind _ = none; rw [ih]; rfl
    exact ⟨k₁, fun k hk Ek hEk => by rw [hall k hk] at hEk; exact absurd hEk (by simp)⟩
  push Not at hnone
  have hsome : ∀ k, ∃ Ek, trackPrime U stp E k = some Ek := fun k =>
    Option.ne_none_iff_exists'.mp (hnone k)
  -- the reference survives the first `K₀` steps
  have href : ∀ k, ∀ Ek, trackPrime U stp E k = some Ek →
      HasRef (U k) Ek c (if k = 0 then top else (U k).lam) := by
    intro k
    induction k with
    | zero =>
      intro Ek hEk
      obtain rfl : E = Ek := Option.some_injective _ hEk
      simpa using hE
    | succ k ih =>
      intro Ek' hEk'
      obtain ⟨Ek, hEk⟩ := hsome k
      have hstep : flipTransformPrimeDivisor (stp k).f (stp k).fp Ek = some Ek' := by
        change (trackPrime U stp E k).bind _ = _ at hEk'
        rw [hEk] at hEk'
        exact hEk'
      have := HasRef.step (h.isGood k) (h.isGood (k + 1)) (h.isStep k) hstep hc0 (hc k)
        (by
          split_ifs with hk
          · subst hk; exact htop 0
          · exact (h.isStep k).lam_le) (ih Ek hEk)
      simpa using this
  obtain ⟨EK, hEK⟩ := hsome K₀
  have htop' : ∀ k, (U (K₀ + k + 1)).lam ≤ (if K₀ = 0 then top else (U K₀).lam) := by
    intro k
    split_ifs with hK
    · exact htop _
    · induction k with
      | zero => exact (h.isStep K₀).lam_le
      | succ k ih => exact ((h.isStep (K₀ + k + 1)).lam_le).trans ih
  obtain ⟨N, hN⟩ := (h.shift K₀).eventually_disjoint_of_hasRef_of_flip hZ
    (fun k => hK₀ (K₀ + k) (Nat.le_add_right _ _)) hc0 (fun k => hc (K₀ + k)) htop' EK
    (href K₀ EK hEK)
  refine ⟨K₀ + N, fun k hk Ek hEk => ?_⟩
  obtain ⟨k', rfl⟩ : ∃ k', k = K₀ + k' := ⟨k - K₀, by omega⟩
  exact hN k' (by omega) Ek (by rw [trackPrime_shift U stp E K₀ EK hEK k']; exact hEk)

/-- **No program has a plt reference for every floor component of its first model.** Every step
meets a component of the floor (by the transported floor identity), the floor components of every
model are strict transforms of the finitely many of the first model, and along each of them the
flips eventually avoid it. -/
private theorem IsProgram.false_of_forall_hasRef {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {U : ℕ → ScalingModel Z}
    {stp : ∀ k, ScalingStep (U k) (U (k + 1))} (h : IsProgram sZ U stp)
    {c top : ℝ} (hc0 : 0 ≤ c) (hc : ∀ k, c < (U (k + 1)).lam)
    (htop : ∀ k, (U (k + 1)).lam ≤ top)
    (href : ∀ E : MMP.Mori.PrimeDivisor (U 0).M, 1 ≤ (U 0).B.coeff E → HasRef (U 0) E c top) :
    False := by
  classical
  have hdisj := fun E (hE : 1 ≤ (U 0).B.coeff E) =>
    h.eventually_disjoint_of_hasRef hZ hc0 hc htop E (href E hE)
  choose! Nf hNf using hdisj
  set F := (U 0).B.support.filter fun E => 1 ≤ (U 0).B.coeff E
  set n := F.sup Nf
  obtain ⟨α', Nd, hα', hN0, hNB', hnum⟩ := (h.isGood n).exists_floor
  obtain ⟨G, hG, x, hxEx, hxG⟩ := exists_coeff_ne_zero_inter_exceptionalSet
    (h.isGood n).isQFactorial (h.isStep n).isNegativeExtremalContraction
    (h.isStep n).comp_eq (h.isStep n).isNumericallyTrivialOver (h.isStep n).lam_pos hα' hN0 hnum
  obtain ⟨E, hE, hEG⟩ := h.exists_trackPrime_eq_some n G (hNB' G hG)
  have hEF : E ∈ F := Finset.mem_filter.mpr ⟨Finsupp.mem_support_iff.mpr fun h0 => by
    rw [DivisorWithCoeffs.coeff_apply, h0] at hE; linarith, hE⟩
  have := hNf E hE n (Finset.le_sup hEF) G hEG
  exact Set.disjoint_left.mp this hxEx hxG

/-- **The level-one plt reference on the log minimal model.** -/
private theorem hasRef_levelOne
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C : RDivisor X} {A : QDivisor X}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + C) KY (BY + CY) φ)
    (hgood : (⟨Y, sY, πY, KY, BY, CY, 1⟩ : ScalingModel Z).IsGood sZ)
    (E : MMP.Mori.PrimeDivisor Y) (hE : 1 ≤ BY.coeff E) :
    HasRef (⟨Y, sY, πY, KY, BY, CY, 1⟩ : ScalingModel Z) E (1 / 2) 1 := by
  classical
  have hdlt := isRealDltPair_of_isSmoothScheme hXsm hlc hsnc
  have hE1 : BY.coeff E = 1 := le_antisymm (hgood.isRealDltPair.2.1 E) hE
  obtain ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e₀, Bt, he₀k, he₀S,
      hord₀, hAB₀, hprinc₀, hplt₀, hplt_up₀, hBtE₀, hBtlt₀⟩ :=
    FSPRef.exists_levelOne_pltReference hX hXsm hdim hZ hB hC hdlt hsnc hA hA0 hAB hAfl
      hgood.comp_eq hgood.isProjectiveVariety hgood.isQFactorial hgood.dim_eq hCY hBY hY E hE1
  have hCE : CY.coeff E = 0 := by
    have h1 := hY.isRealDltPair.2.1 E
    rw [DivisorWithCoeffs.coeff_add, hE1] at h1
    exact le_antisymm (by linarith) (hgood.coeff_C_nonneg E)
  refine ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e₀, Bt,
    { isOver := he₀k
      transform_S₀ := he₀S
      ord := hord₀
      linEquiv := ?_
      plt := hplt₀
      coeff_E := hBtE₀
      coeff_lt_one := hBtlt₀
      coeff_C_E := hCE
      le := hAB₀
      plt_upper := ?_ }⟩
  · obtain ⟨n, u, hn, hu⟩ := hprinc₀
    refine ⟨n, u, hn, ?_⟩
    rw [← hu]
    congr 1
    change Bt - (BY + (1 / 2 : ℝ) • CY) = Bt + (1 / 2 : ℝ) • CY - (BY + CY)
    module
  · have e : (1 : ℝ) - 1 / 2 = 1 / 2 := by norm_num
    change (∀ P, 0 ≤ (Bt + ((1 : ℝ) - 1 / 2) • CY).coeff P ∧
      (Bt + ((1 : ℝ) - 1 / 2) • CY).coeff P ≤ 1) ∧ ∀ (n : ℕ) (D : DivisorOver ℂ sY) (a : ℝ),
        D.IsExceptional → MMP.Intersection.IsLogDiscrepancy sY n (Bt + ((1 : ℝ) - 1 / 2) • CY) D a →
          0 < a
    rw [e]
    exact hplt_up₀

/-- **The plt reference on a log minimal model below level one.** -/
private theorem hasRef_of_isRealLogMinimalModel
    {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z}
    {KX : Divisor X} {B C : RDivisor X} {A : QDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (m : ScalingModel Z) (hm : m.IsGood sZ) {u : ℝ} (hu0 : 0 < u) (hu1 : u < 1)
    {χ : X.RationalMap m.M} {KM : Divisor m.M}
    (hLMM : IsRealLogMinimalModel sX m.s sZ π m.π KX (B + u • C) KM (m.B + u • m.C) χ)
    (hCχ : m.C = MMP.Mori.RationalMap.transformDivisor χ C)
    (E : MMP.Mori.PrimeDivisor m.M) (hE : 1 ≤ m.B.coeff E) :
    HasRef m E 0 u := by
  classical
  have hdlt := isRealDltPair_of_isSmoothScheme hXsm hlc hsnc
  have hE1 : m.B.coeff E = 1 := le_antisymm (hm.isRealDltPair.2.1 E) hE
  have hB1 : ∀ P, B.coeff P ≤ 1 := fun P => by
    have := IsRealLcPair.coeff_le_one hlc P
    simp only [DivisorWithCoeffs.coeff_add] at this
    linarith [hC P]
  have hCB' : ∀ P, C.coeff P ≠ 0 → B.coeff P < 1 := fun P hP =>
    lt_of_le_of_ne (hB1 P) fun h => hP (hCB P h.ge)
  have hBm : ∀ F : MMP.Mori.PrimeDivisor m.M, m.B.coeff F =
      (MMP.Mori.RationalMap.transformDivisor χ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional χ F then 1 else 0 := by
    intro F
    have h := hLMM.coeff_boundary F
    have htr : MMP.Mori.RationalMap.transformDivisor χ (B + u • C) =
        MMP.Mori.RationalMap.transformDivisor χ B + u • m.C := by
      rw [hCχ, map_add]
      congr 1
      exact DivisorWithCoeffs.mapPrimeDivisors_smul _ u C
    rw [htr] at h
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h
    linarith
  obtain ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e₀, Bt, he₀k, he₀S,
      hord₀, hAB₀, hprinc₀, hplt₀, hplt_up₀, hBtE₀, hBtlt₀⟩ :=
    FSPRef.exists_pltReference_below_one hX hXsm hB hC hdlt hsnc hCB' hA hA0 hAB hAfl
      hm.comp_eq hm.isProjectiveVariety hCχ hBm hu0 hu1 hLMM E hE1
  have hCE : m.C.coeff E = 0 := by
    have h1 := hLMM.isRealDltPair.2.1 E
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul, hE1] at h1
    have := hm.coeff_C_nonneg E
    nlinarith
  refine ⟨X₀, i1, i2, i3, i4, sX₀, hX₀, hX₀p, S₀, i5, A₀, hA₀, hAamp, hAS, e₀, Bt,
    { isOver := he₀k
      transform_S₀ := he₀S
      ord := hord₀
      linEquiv := ?_
      plt := hplt₀
      coeff_E := hBtE₀
      coeff_lt_one := hBtlt₀
      coeff_C_E := hCE
      le := hAB₀
      plt_upper := by simpa only [sub_zero] using hplt_up₀ }⟩
  obtain ⟨n, v, hn, hv⟩ := hprinc₀
  exact ⟨n, v, hn, by rw [zero_smul, add_zero]; exact hv⟩

/-- **The end of the level-one plateau is a log minimal model slightly below level one.** -/
private theorem exists_isRealLogMinimalModel_of_plateau
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C : RDivisor X}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C))
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + C) KY (BY + CY) φ)
    (T : ℕ → ScalingModel Z)
    {stp : ∀ k, ScalingStep (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T k)
      (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (k + 1))}
    (h : IsProgram sZ (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T) stp) (j : ℕ)
    (hj : ∀ i < j, (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).lam = 1)
    (hj' : (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (j + 1)).lam < 1) :
    ∃ u : ℝ, (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (j + 1)).lam < u ∧ u < 1 ∧
      ∃ (χ : X.RationalMap (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).M)
        (KM : Divisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).M),
        IsRealLogMinimalModel sX (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).s sZ π
          (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).π KX (B + u • C) KM
          ((seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).B +
            u • (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).C) χ ∧
        (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T j).C = MMP.Mori.RationalMap.transformDivisor χ C := by
  classical
  have hgood := h.isGood
  have hstp := h.isStep
  -- the source
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  haveI := hXn.1
  haveI : QuasiCompact sX := hXn.1.toQuasiCompact
  have hXQ : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hXn
  have hsepZ : IsSeparated (Z ↘ ⊤_ Scheme) := by
    have := hZ.toIsVariety
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  -- the level-one log minimal model and its resolution
  have hYn : IsNormalVariety ℂ sY := hY.isNormalVariety_model
  have hYQ : IsQFactorial sY := hY.isQFactorial
  haveI := hYn.1
  have := MMP.Fourfold.isSeparated_toTerminal_of_isNormalVariety hYn
  obtain ⟨W₀, _, _, _, sW₀, p₀, q₀, h₀, GX, GY, hres, hpos⟩ := hY.exists_resolution_pos
  have hp₀b := hres.isBirationalMorphism_left
  have hq₀b := hres.isBirationalMorphism_right
  haveI : IsProper p₀ := isProper_of_isProjectiveMorphism p₀ hres.isProjectiveMorphism_left
  haveI : IsProper q₀ := isProper_of_isProjectiveMorphism q₀ hres.isProjectiveMorphism_right
  haveI : IsDominant p₀ := hp₀b.isDominant
  haveI : IsDominant q₀ := hq₀b.isDominant
  have hW₀n : IsNormalVariety ℂ sW₀ := ⟨hres.isVariety, inferInstance⟩
  haveI : QuasiCompact sW₀ := hres.isVariety.toQuasiCompact
  haveI : CompactSpace W₀ := QuasiCompact.compactSpace_of_compactSpace sW₀
  haveI : MMP.Mori.IsVariety ℂ (q₀ ≫ sY) := by rw [hres.comp_eq_right]; exact hres.isVariety
