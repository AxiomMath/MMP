  obtain ⟨χ, KM, hLMM, hCj⟩ := FSPCrit.exists_isRealLogMinimalModel_of_program
    (Δ := B + u • C) (Ys := fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).M) (sYs := fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).s)
    (πYs := fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).π) (Ks := fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).K)
    (Γs := fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).B + u • (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).C) (W := fun i => (stp i).W)
    (sW := fun i => (stp i).sW) (f := fun i => (stp i).f) (g := fun i => (stp i).g)
    (fp := fun i => (stp i).fp) (ψ := fun i => (stp i).ψ)
    hX hXQ hZ hY.comp_eq hY.isCanonicalDivisor hlcu j
    (fun i _ => ⟨(hgood i).isProjectiveVariety, (hgood i).isQFactorial,
      ⟨4, (hgood i).isCanonicalDivisor⟩, (hgood i).comp_eq⟩)
    (fun i _ => (hstp i).isNegativeExtremalContraction.isNormalVariety_target)
    (fun i _ => (hstp i).isNegativeExtremalContraction.isContraction.comp_eq)
    (fun i _ => by
      change (stp i).fp ≫ (stp i).sW = (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).s
      rw [← hgs i, ← Category.assoc, (hstp i).comp_eq_plus, (hgood (i + 1)).comp_eq])
    (fun i _ => (hstp i).comp_eq) (fun i _ => (hstp i).comp_eq_plus)
    (fun i _ => (hstp i).isNegativeExtremalContraction.isContraction.isProper)
    (fun i _ => by
      rcases (hstp i).divisorial_or_realFlip with ⟨-, -, hiso⟩ | hfl
      · haveI := hiso
        change IsProper (stp i).fp
        infer_instance
      · exact hfl.1.isSmall_flip.isProper)
    (fun i _ => by
      rcases (hstp i).divisorial_or_realFlip with ⟨hb, -, -⟩ | hfl
      · exact hb
      · exact hfl.1.isBirationalMorphism)
    (fun i _ => by
      rcases (hstp i).divisorial_or_realFlip with ⟨-, -, hiso⟩ | hfl
      · haveI := hiso
        exact MMP.Mori.isBirationalMorphism_of_isIso (stp i).fp
      · exact hfl.1.isBirationalMorphism_flip)
    (fun i _ => by
      rcases (hstp i).divisorial_or_flip with ⟨-, -, -, hm⟩ | hflip
      · exact hm
      · exact hflip.isModificationOf)
    (fun i _ => by
      change (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B + u • (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).C = _
      rw [(hstp i).eq_transform_B, (hstp i).eq_transform_C, map_add]
