          rw [hN] at hD'
          have hWv := hflip.isNegativeExtremalContraction.isNormalVariety_target
          haveI : IsIntegral (stp i).W := hWv.1.toIsIntegral
          haveI : IsSeparated (stp i).sW := hWv.1.toIsSeparated
          haveI : LocallyOfFiniteType (stp i).sW := hWv.1.toLocallyOfFiniteType
          haveI : QuasiCompact (stp i).sW := hWv.1.toQuasiCompact
          haveI : CompactSpace (stp i).W := QuasiCompact.compactSpace_of_compactSpace (stp i).sW
          haveI : IsProper (stp i).fp := hflip.isSmall_flip.isProper
          haveI := hqc (i + 1)
          haveI : QuasiCompact ((stp i).fp ≫ (stp i).sW) := by
            rw [hflip.isSmall_flip.comp_eq]; exact hqc (i + 1)
          obtain ⟨mD, rD, LD, LD', hLD, hDeq, -, -⟩ := id hD'
          have hDnef : IsRelativelyNef ℂ (stp i).sW (𝟙 (stp i).W) D :=
            FSPCrit.isRelativelyNef_of_injective (Scheme.Hom.isOpenEmbedding (𝟙 _)).injective
              ⟨mD, rD, LD, hLD, hDeq⟩
          have h1 := isRelativelyNef_of_isRCartierPullback (𝟙 (stp i).W) (𝟙 (stp i).W)
            (stp i).fp (stp i).fp rfl hDnef hD'
          replace h1 := IsRelativelyNef.congr_str (s₁ := (stp i).fp ≫ (stp i).sW)
            (s₂ := (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).s) hflip.isSmall_flip.comp_eq h1
          have h2 : IsRelativelyNef ℂ (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).s (stp i).fp
              (logCanonicalDivisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).K (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B) := by
            have := isRelativelyNef_neg_of_isRelativelyAntiAmple
              (sX := (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).s) (stp i).fp
              (D := -logCanonicalDivisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).K (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B)
