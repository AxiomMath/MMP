              (1 - u) • logCanonicalDivisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).K (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B +
                u • logCanonicalDivisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).K ((seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B + (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).C) := by
            simp only [logCanonicalDivisor]
            module
          change IsRelativelyNef ℂ (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).s (stp i).fp
            (logCanonicalDivisor (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).K ((seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).B + u • (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)).C))
          rw [e]
          exact IsRelativelyNef.add' (IsRelativelyNef.smul' h2 (by linarith))
            (IsRelativelyNef.smul' h1 hu0.le))
    (by rw [hres.comp_eq_left]; exact hres.isVariety)
    (by rw [hres.comp_eq_left]; exact hres.isSmoothScheme)
    (hres.comp_eq_right.trans hres.comp_eq_left.symm) hres.isProjectiveMorphism_left
    hres.isProjectiveMorphism_right hp₀b hq₀b hres.isInverse hpq₀
    (fun F => by
      change (BY + u • CY).coeff F =
        (MMP.Mori.RationalMap.transformDivisor (h₀.compHom q₀) (B + u • C)).coeff F +
          if MMP.Flips.RationalMap.IsInverseExceptional (h₀.compHom q₀) F then 1 else 0
      rw [hres.compHom_eq, map_add,
        show MMP.Mori.RationalMap.transformDivisor φ (u • C) = u • CY by
          rw [hCY]; exact DivisorWithCoeffs.mapPrimeDivisors_smul _ u C]
      change BY.coeff F + u * CY.coeff F =
        (MMP.Mori.RationalMap.transformDivisor φ B).coeff F + u * CY.coeff F + _
      rw [hBY F]
      ring)
    (fun P hP PW hPW hn n a ha => by
      replace hP : MMP.Mori.RationalMap.IsExceptional φ P := by
        rw [← hres.compHom_eq]; exact hP
      have hPWeq : PW = PWf P := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (FSPCrit.eq_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective hPW (hPWf P).1)
      subst hPWeq
      have hδP := hδ P hP
      have hεP := hε₁S P hP
      have hGu : IsRCartierPullback q₀ (logCanonicalDivisor (divisorOfForm ωY) (BY + u • CY))
          (GY + (-(1 - u)) • CW) := by
        rw [hωY]
        have h1 := MMP.Fourfold.isRCartierPullback_add hres.isRCartierPullback_right
          (MMP.Fourfold.isRCartierPullback_smul (-(1 - u)) hCW)
        convert h1 using 1
        rw [logCanonicalDivisor, logCanonicalDivisor]
        module
      have ha₁ := FSPCrit.isLogDiscrepancy_of_isRCartierPullback hYn hW₀nq hq₀b hωY0
        (by rw [hωY]; exact hKY) hGu (PWf P)
      have hau := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha₁
      haveI := FSPCrit.isIso_stalkMap_of_map_eq_genericPoint p₀ hp₀b.functionFieldMap_bijective
        (hPWf P).1
      have hGX := FSPCrit.coeff_eq_of_isRCartierPullback hres.isRCartierPullback_left (PWf P) P
        (hPWf P).1
      have hKWP : (KW.coeff (PWf P) : ℝ) = KX.coeff P := by
        have := (hPWf P).2.2 KW
        rw [hpK] at this
        exact_mod_cast this.symm
      have hord : (((⟨W₀, q₀, hW₀nq, hq₀b, PWf P⟩ : DivisorOver ℂ sY).ordPullback ωY : ℤ) : ℝ) =
          KW.coeff (PWf P) := by
        rw [DivisorOver.ordPullback, ← coeff_divisorOfForm, hωYW]
      rw [hau, hord, hKWP]
      have hGXc : GX.coeff (PWf P) = KX.coeff P + B.coeff P + C.coeff P := by
        rw [hGX]
        change (KX.coeff P : ℝ) + (B.coeff P + C.coeff P) = _
        ring
      have hδ' : 0 < GX.coeff (PWf P) - GY.coeff (PWf P) := hδP
      have hε' : ε₁ ≤ (GX.coeff (PWf P) - GY.coeff (PWf P)) / (|σ P| + 1) := hεP
      have hd : ε₁ * (|σ P| + 1) ≤ GX.coeff (PWf P) - GY.coeff (PWf P) :=
