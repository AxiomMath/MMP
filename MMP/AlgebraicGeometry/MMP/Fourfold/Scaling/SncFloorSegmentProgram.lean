    change ((MMP.Mori.RationalMap.transformDivisor ψ A') E : ℝ) = 0
    rw [h1]
    change ((A'.coeff EW : ℚ) : ℝ) = 0
    rw [hA'EW, Rat.cast_zero]
  have hord' : ∀ F : MMP.Mori.PrimeDivisor Y,
      MMP.Flips.RationalMap.IsInverseExceptional e₀.toRationalMap F →
      ∀ q : Y.PartialMap W, q.toRationalMap = e₀.symm.toRationalMap →
        ∀ hF : F.genericPoint ∈ q.domain, q.hom ⟨F.genericPoint, hF⟩ ∉ (A'.supp : Set W) :=
    fun F hF q hq => hordq F (he₀ ▸ hF) q ⟨e₀, he₀, hq.symm⟩
  have hAle : QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ A') ≤ BY' := by
    rw [← transformDivisor_toRDivisor]
    exact hψA
  have hWn : IsNormalVariety ℂ sW := ⟨hWp.toIsVariety, inferInstance⟩
  refine ⟨W, inferInstance, inferInstance, inferInstance, inferInstance, sW, hWn, hWp, EW, hEWn,
    A', hA'0, hA'amp', hA'EW, e₀, BY', he₀k, he₀ ▸ hψE, hord', fun P => ?_, hprinc,
    ⟨fun P => ⟨hBY'lc.2.1 P, IsRealLcPair.coeff_le_one hBY'lc P⟩,
      fun n D a hD ha => hBY'plt n D hD a ha⟩, ⟨fun P => ?_, fun n D a hD ha => ?_⟩, hBY'E,
    hBY'lt⟩
  · change (QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor e₀.toRationalMap A')).coeff P
      ≤ (BY' - Finsupp.single E 1).coeff P
    rw [he₀, DivisorWithCoeffs.coeff_sub]
    by_cases hPE : P = E
    · subst hPE
      rw [hAE, hBY'E]
      simp [DivisorWithCoeffs.coeff_apply]
    · have : DivisorWithCoeffs.coeff (Finsupp.single E (1 : ℝ) : RDivisor Y) P = 0 := by
        simp [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply, Ne.symm hPE]
      rw [this, sub_zero]
      exact hAle P
  · rw [hCY]
    exact ⟨hup1.2.1 P, IsRealLcPair.coeff_le_one hup1 P⟩
  · rw [hCY] at ha
    exact hup2 n D hD a ha

end Reference

