  exact ⟨u, hlu, hu1, χ, KM, hLMM, hCj⟩

/-- **Termination of the program.** There is no infinite `(K_Y + B_Y)`-program with scaling of
`C_Y` from the level-one log minimal model `Y`. If every threshold is one, the level-one plt
reference on `Y` and special termination contradict floor negativity. Otherwise the first model
`Y'` reached with a threshold `λ' < 1` is a log minimal model of `(X, B + u C)` for some
`λ' < u < 1`, and the plt reference on `Y'` at level `u` gives the same contradiction. -/
private theorem false_of_infinite_scalingProgram
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C : RDivisor X} {A : QDivisor X}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + C) KY (BY + CY) φ)
    (T : ℕ → ScalingModel Z)
    (hgood : ∀ i, (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).IsGood sZ)
    (hstep : ∀ i, ∃ st : ScalingStep (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i)
      (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T (i + 1)), st.IsStep) : False := by
  classical
  set U := seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T with hU
  choose stp hstp using hstep
  have hprog : IsProgram sZ U stp := ⟨hgood, hstp⟩
  have hlam1 : ∀ k, (U k).lam ≤ 1 := fun k => (hgood k).lam_le_one
  by_cases hplat : ∀ k, (U (k + 1)).lam = 1
  · -- an infinite level-one plateau
    refine hprog.false_of_forall_hasRef hZ (c := 1 / 2) (top := 1) (by norm_num)
      (fun k => by rw [hplat k]; norm_num) (fun k => hlam1 _) fun E hE => ?_
    exact hasRef_levelOne hX hXsm hdim hZ hB hC hlc hsnc hA hA0 hAB hAfl hCY hBY hY (hgood 0) E hE
  · -- the plateau ends
    push Not at hplat
    have hex : ∃ k, (U (k + 1)).lam < 1 := by
      obtain ⟨k, hk⟩ := hplat
      exact ⟨k, lt_of_le_of_ne (hlam1 _) hk⟩
    set j := Nat.find hex with hjdef
    have hj : ∀ i < j, (U (i + 1)).lam = 1 := fun i hi =>
      le_antisymm (hlam1 _) (not_lt.mp (Nat.find_min hex hi))
    obtain ⟨u, hu, hu1, χ, KM, hLMM, hCχ⟩ :=
      exists_isRealLogMinimalModel_of_plateau hX hXsm hZ hB hC hlc hCY hBY hY T hprog j hj
        (Nat.find_spec hex)
    have hu0 : 0 < u := ((hstp j).lam_pos).trans hu
    -- the antitone thresholds after the plateau
    have hanti : ∀ k, (U (j + k + 1)).lam ≤ (U (j + 1)).lam := by
      intro k
      induction k with
      | zero => exact le_rfl
      | succ k ih => exact ((hstp (j + k + 1)).lam_le).trans ih
    refine (hprog.shift j).false_of_forall_hasRef hZ (c := 0) (top := u) le_rfl
      (fun k => (hstp (j + k)).lam_pos) (fun k => (hanti k).trans hu.le) fun E hE => ?_
    exact hasRef_of_isRealLogMinimalModel hX hXsm hdim hZ hB hC hlc hsnc hCB hA hA0 hAB hAfl
        (U j) (hgood j) hu0 hu1 hLMM hCχ E hE

/-- **The level-one scaling program.** At level one, the `(K_Y + B_Y)`-program with scaling of
`C_Y` exists and is finite, and after each step the upper level `K_{i+1} + B_{i+1} + λ_i C_{i+1}`
stays nef and lc. -/
private theorem exists_scalingProgram_with_upperLevels
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    -- the SNC fourfold setting
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N))
    -- the log minimal upper model
    (ht : 0 < t) (ht1 : t ≤ 1) (h1 : t = 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + t • C) KY (BY + t • CY) φ) :
    ∃ (n : ℕ) (M : ℕ → Scheme.{0}) (_ : ∀ i, IsIntegral (M i)) (_ : ∀ i, CompactSpace (M i))
      (_ : ∀ i, IsLocallyNoetherian (M i)) (_ : ∀ i, IsNormal (M i))
      (sM : ∀ i, M i ⟶ Spec (.of ℂ)) (πM : ∀ i, M i ⟶ Z) (KM : ∀ i, Divisor (M i))
      (BM CM : ∀ i, RDivisor (M i)) (lam : ℕ → ℝ)
      (W : ℕ → Scheme.{0}) (sW : ∀ i, W i ⟶ Spec (.of ℂ))
      (f : ∀ i, modelSeq Y M i ⟶ W i) (g : ∀ i, W i ⟶ Z) (fp : ∀ i, M i ⟶ W i)
      (ψ : ∀ i, (modelSeq Y M i).RationalMap (M i)),
      -- the models `Y_i`, `i ≤ n`, and their nef thresholds
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sM i) ∧ IsQFactorial (modelStr sY sM i) ∧
        (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sM i) m (divisorSeq KY KM i)) ∧
        modelMap πY πM i ≫ sZ = modelStr sY sM i ∧
        IsRealDltPair (modelStr sY sM i) (divisorSeq BY BM i) ∧
        0 ≤ lam i ∧ lam i ≤ t ∧
        IsRelativelyNef ℂ (modelStr sY sM i) (modelMap πY πM i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i))) ∧
      -- the steps `Y_i ⤏ Y_{i+1}`, `i < n`
      (∀ i < n,
        f i ≫ g i = modelMap πY πM i ∧ fp i ≫ g i = πM i ∧
        lam (i + 1) ≤ lam i ∧
        IsNegativeExtremalContraction ℂ (modelStr sY sM i) (sW i)
          (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) ∧
        IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i)) ∧
        ((IsBirationalMorphism (f i) ∧
            (∃ E : MMP.Mori.PrimeDivisor (modelSeq Y M i),
              (MMP.Mori.exceptionalSet (f i) : Set (modelSeq Y M i)) = E.support) ∧
            IsIso (fp i) ∧ IsModificationOf (f i) (fp i) (ψ i)) ∨
          IsFlip ℂ (modelStr sY sM i) (sW i) (sM i)
            (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) (fp i)
            (ψ i)) ∧
        BM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) ∧
        CM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i)) ∧
      -- the program ends with a nef lower adjoint
      lam n = 0 ∧
      IsRelativelyNef ℂ (modelStr sY sM n) (modelMap πY πM n)
        (logCanonicalDivisor (divisorSeq KY KM n) (divisorSeq BY BM n)) ∧
      -- the scaling divisors are effective, and the upper levels stay nef and lc after each step
      (∀ P, 0 ≤ CY.coeff P) ∧ (∀ i < n, ∀ P, 0 ≤ (CM i).coeff P) ∧
      (∀ i < n, IsRelativelyNef ℂ (sM i) (πM i)
        (logCanonicalDivisor (KM i) (BM i + lam i • CM i))) ∧
      ∀ i < n, IsRealLcPair (sM i) (BM i + lam i • CM i) := by
  classical
  set m₀ : ScalingModel Z := ⟨Y, sY, πY, KY, BY, CY, t⟩ with hm₀
  have hgood₀ : m₀.IsGood sZ := by
    have hXn : IsNormalVariety ℂ sX := hY.isRealLcPair.1
    have hYn := hY.isNormalVariety_model
    have hQY := hY.isQFactorial
    -- `Y` is birational to the fourfold `X`
    have hdimY : topologicalKrullDim Y = 4 := by
      obtain ⟨W, _, _, _, sW, p, q, h, GX, GY, hR⟩ := hY.exists_resolution
      have hWn : IsNormalVariety ℂ sW := ⟨hR.isVariety, inferInstance⟩
      have hWnp : IsNormalVariety ℂ (p ≫ sX) := by rw [hR.comp_eq_left]; exact hWn
      have hWnq : IsNormalVariety ℂ (q ≫ sY) := by rw [hR.comp_eq_right]; exact hWn
      have := hXn.1
      have := hYn.1
      have := hWnp.1
      have := hWnq.1
      have e₁ := MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX)
        hR.isBirationalMorphism_left
      have e₂ := MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY (q ≫ sY)
        hR.isBirationalMorphism_right
      rw [e₂, ← e₁, hdim]
    obtain ⟨nK, hKY⟩ := hY.isCanonicalDivisor_model
    obtain rfl : nK = 4 := by
      have := hKY.topologicalKrullDim_eq
      rw [hdimY] at this
      exact_mod_cast this.symm
    have hCY0 : ∀ P, 0 ≤ CY.coeff P := fun P => hCY ▸ coeff_transformDivisor_nonneg φ hC P
    have hBY0 : ∀ P, 0 ≤ BY.coeff P := fun P => by
      rw [hBY P]
      have := coeff_transformDivisor_nonneg φ hB P
      split_ifs <;> linarith
    have hQX : IsQFactorial sX := ⟨hXn, fun D => ⟨1, one_pos, by
      simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hXsm D⟩⟩
    have hB1 : ∀ P, B.coeff P ≤ 1 := fun P => by
      have := IsRealLcPair.coeff_le_one hlc P
      simp only [DivisorWithCoeffs.coeff_add] at this
      linarith [hC P]
    have hCB' : ∀ P, C.coeff P ≠ 0 → B.coeff P < 1 := fun P hP =>
      lt_of_le_of_ne (hB1 P) fun h => hP (hCB P h.ge)
    obtain ⟨NY, hNY0, hNYB, hnumY, -⟩ :=
      MMP.Fourfold.exists_isNumericallyEquivalentOver_logCanonicalDivisor_of_isRealLogMinimalModel
        hX hZ hlc hQX hB hC hCB' hα hN hNB hfloor ht ht1 hBY (by rw [← hCY]; exact hY)
    exact
      { isProjectiveVariety := hY.isProjectiveVariety_model
        isQFactorial := hQY
        dim_eq := hdimY
        isCanonicalDivisor := hKY
        comp_eq := hY.comp_eq_model
        isRealDltPair := isRealDltPair_of_add_smul hQY hBY0 hCY0 ht.le hY.isRealDltPair
        coeff_C_nonneg := hCY0
        lam_nonneg := ht.le
        lam_le_one := ht1
        isRelativelyNef_upper := hY.isRelativelyNef
        isRealLcPair_upper := hY.isRealDltPair.1
        exists_floor := ⟨α, NY, hα, hNY0, hNYB, by
          change IsNumericallyEquivalentOver ℂ sY πY (α • logCanonicalDivisor KY BY) (CY + NY)
          exact hCY ▸ hnumY⟩ }
  -- the models reachable from `m₀` by `n` steps, the sequence being constant from `n` on
  let Reach : ℕ → ScalingModel Z → Prop := fun n m =>
    ∃ T : ℕ → ScalingModel Z, seqOf m₀ T n = m ∧ (∀ i, n ≤ i → T i = m) ∧
      (∀ i, (seqOf m₀ T i).IsGood sZ) ∧
      ∀ i < n, ∃ st : ScalingStep (seqOf m₀ T i) (seqOf m₀ T (i + 1)), st.IsStep
  have hreach₀ : Reach 0 m₀ :=
    ⟨fun _ => m₀, rfl, fun _ _ => rfl, fun i => by cases i <;> exact hgood₀,
      fun i hi => absurd hi (Nat.not_lt_zero _)⟩
  have hgood_of_reach : ∀ n m, Reach n m → m.IsGood sZ := by
    rintro n m ⟨T, hTn, -, hT, -⟩
    exact hTn ▸ hT n
  -- a reachable model with a next model has a reachable next model
  have hsucc : ∀ n m, Reach n m → ∀ (m' : ScalingModel Z) (st : ScalingStep m m'), st.IsStep →
      m'.IsGood sZ → Reach (n + 1) m' := by
    rintro n m ⟨T, hTn, hTc, hT, hTst⟩ m' st hst hm'
    let T' : ℕ → ScalingModel Z := fun i => if i < n then T i else m'
    have hle : ∀ i ≤ n, seqOf m₀ T' i = seqOf m₀ T i := by
      intro i hi
      cases i with
      | zero => rfl
      | succ j => exact if_pos (by omega)
    have hn : seqOf m₀ T' (n + 1) = m' := if_neg (lt_irrefl n)
    refine ⟨T', hn, fun i hi => if_neg (by omega), fun i => ?_, fun i hi => ?_⟩
    · rcases Nat.lt_or_ge i (n + 1) with h | h
      · rw [hle i (by omega)]; exact hT i
      · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
        change (T' j).IsGood sZ
        rw [show T' j = m' from if_neg (by omega)]
        exact hm'
    · rcases Nat.lt_or_ge i n with h | h
      · rw [hle i h.le, hle (i + 1) h]
        exact hTst i h
      · obtain rfl : i = n := by omega
        rw [hle i le_rfl, hTn, hn]
        exact ⟨st, hst⟩
  -- the program reaches a model with nef lower adjoint
  have hnefex : ∃ n m, Reach n m ∧
      IsRelativelyNef ℂ m.s m.π (logCanonicalDivisor m.K m.B) := by
    by_contra hcon
    push Not at hcon
    have hnext : ∀ n m, Reach n m → ∃ m', Reach (n + 1) m' ∧
        ∃ st : ScalingStep m m', st.IsStep := by
      intro n m hm
      obtain ⟨m', st, hst, hm'⟩ := ScalingModel.exists_scalingStep hZ (hgood_of_reach n m hm)
        (hcon n m hm)
      exact ⟨m', hsucc n m hm m' st hst hm', st, hst⟩
    choose! nx hnxR hnxSt using hnext
    let V : ℕ → ScalingModel Z := fun i => Nat.rec m₀ (fun j m => nx j m) i
    have hV : ∀ i, Reach i (V i) := by
      intro i
      induction i with
      | zero => exact hreach₀
      | succ j ih => exact hnxR j (V j) ih
    subst h1
    refine false_of_infinite_scalingProgram hX hXsm hdim hZ hB hC hlc hsnc hCB hA hA0 hAB hAfl
      hCY hBY (by simpa only [one_smul] using hY) (fun i => V (i + 1)) (fun i => ?_)
      (fun i => ?_)
    · cases i with
      | zero => exact hgood₀
      | succ j => exact hgood_of_reach _ _ (hV (j + 1))
    · cases i with
      | zero => exact hnxSt 0 m₀ hreach₀
      | succ j => exact hnxSt (j + 1) (V (j + 1)) (hV (j + 1))
  obtain ⟨n, m, ⟨T, hTn, hTc, hgood, hsteps⟩, hnef⟩ := hnefex
  -- the steps, completed by trivial steps beyond `n`
  have hall : ∀ i, ∃ st : ScalingStep (seqOf m₀ T i) (seqOf m₀ T (i + 1)),
      i < n → st.IsStep := by
    intro i
    rcases Nat.lt_or_ge i n with h | h
    · obtain ⟨st, hst⟩ := hsteps i h
      exact ⟨st, fun _ => hst⟩
    · have e₁ : seqOf m₀ T (i + 1) = m := hTc i h
      have e₂ : seqOf m₀ T i = m := by
        rcases Nat.eq_or_lt_of_le h with rfl | h'
        · exact hTn
        · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
          exact hTc j (by omega)
      rw [e₁, e₂]
      exact ⟨⟨Z, sZ, m.π, 𝟙 Z, m.π, Scheme.Hom.toRationalMap (𝟙 m.M)⟩,
        fun h' => absurd h' (by omega)⟩
  choose st hst using hall
  have hnef' : ∀ i, n ≤ i → IsRelativelyNef ℂ (seqOf m₀ T i).s (seqOf m₀ T i).π
      (logCanonicalDivisor (seqOf m₀ T i).K (seqOf m₀ T i).B) := by
    intro i hi
    have e : seqOf m₀ T i = m := by
      rcases Nat.eq_or_lt_of_le hi with rfl | h
      · exact hTn
      · obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
        exact hTc j (by omega)
    rw [e]
    exact hnef
  have hlamle : ∀ i, (seqOf m₀ T i).lam ≤ t := fun i => h1 ▸ (hgood i).lam_le_one
  refine ⟨n, fun i => (T i).M, fun i => (T i).isIntegral, fun i => (T i).compactSpace,
    fun i => (T i).isLocallyNoetherian, fun i => (T i).isNormal, fun i => (T i).s,
    fun i => (T i).π, fun i => (T i).K, fun i => (T i).B, fun i => (T i).C,
    fun i => if i < n then (T i).lam else 0, fun i => (st i).W, fun i => (st i).sW,
    fun i => match i with
      | 0 => (st 0).f
      | j + 1 => (st (j + 1)).f,
    fun i => (st i).g, fun i => (st i).fp,
    fun i => match i with
      | 0 => (st 0).ψ
      | j + 1 => (st (j + 1)).ψ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i hi
    have g := hgood i
    have hlam0 : 0 ≤ if i < n then (T i).lam else 0 := by
      split_ifs
      · exact (hgood (i + 1)).lam_nonneg
      · exact le_rfl
    have hlamt : (if i < n then (T i).lam else 0) ≤ t := by
      split_ifs
      · exact hlamle (i + 1)
      · exact ht.le
    cases i with
    | zero =>
      refine ⟨g.isProjectiveVariety, g.isQFactorial, ⟨4, g.isCanonicalDivisor⟩, g.comp_eq,
        g.isRealDltPair, hlam0, hlamt, ?_⟩
      dsimp only
      split_ifs with h
      · exact (hst 0 h).isRelativelyNef
      · simp only [zero_smul, add_zero]
        exact hnef' 0 (by omega)
    | succ j =>
      refine ⟨g.isProjectiveVariety, g.isQFactorial, ⟨4, g.isCanonicalDivisor⟩, g.comp_eq,
        g.isRealDltPair, hlam0, hlamt, ?_⟩
      dsimp only
      split_ifs with h
      · exact (hst (j + 1) h).isRelativelyNef
      · simp only [zero_smul, add_zero]
        exact hnef' (j + 1) (by omega)
  · intro i hi
    have h := hst i hi
    have hle : (if i + 1 < n then (T (i + 1)).lam else 0) ≤ if i < n then (T i).lam else 0 := by
      rw [if_pos hi]
      split_ifs with h'
      · exact (hst (i + 1) h').lam_le
      · exact (hgood (i + 1)).lam_nonneg
    cases i with
    | zero =>
      refine ⟨h.comp_eq, h.comp_eq_plus, hle, h.isNegativeExtremalContraction, ?_,
        h.divisorial_or_flip, h.eq_transform_B, h.eq_transform_C⟩
      simp only [if_pos hi]
      exact h.isNumericallyTrivialOver
    | succ j =>
      refine ⟨h.comp_eq, h.comp_eq_plus, hle, h.isNegativeExtremalContraction, ?_,
        h.divisorial_or_flip, h.eq_transform_B, h.eq_transform_C⟩
      simp only [if_pos hi]
      exact h.isNumericallyTrivialOver
  · exact if_neg (lt_irrefl n)
  · cases n with
    | zero => exact hnef' 0 le_rfl
    | succ j => exact hnef' (j + 1) le_rfl
  · exact (hgood 0).coeff_C_nonneg
  · intro i _
    exact (hgood (i + 1)).coeff_C_nonneg
  · intro i hi
    simp only [if_pos hi]
    exact (hgood (i + 1)).isRelativelyNef_upper
  · intro i hi
    simp only [if_pos hi]
    exact (hgood (i + 1)).isRealLcPair_upper

end ScalingProgram

private theorem exists_finite_scalingProgram_of_eq_one
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    -- the SNC fourfold setting
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N))
    -- the log minimal upper model
    (ht : 0 < t) (ht1 : t ≤ 1) (h1 : t = 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + t • C) KY (BY + t • CY) φ) :
    ∃ (n : ℕ) (M : ℕ → Scheme.{0}) (_ : ∀ i, IsIntegral (M i)) (_ : ∀ i, CompactSpace (M i))
      (_ : ∀ i, IsLocallyNoetherian (M i)) (_ : ∀ i, IsNormal (M i))
      (sM : ∀ i, M i ⟶ Spec (.of ℂ)) (πM : ∀ i, M i ⟶ Z) (KM : ∀ i, Divisor (M i))
      (BM CM : ∀ i, RDivisor (M i)) (lam : ℕ → ℝ)
      (W : ℕ → Scheme.{0}) (sW : ∀ i, W i ⟶ Spec (.of ℂ))
      (f : ∀ i, modelSeq Y M i ⟶ W i) (g : ∀ i, W i ⟶ Z) (fp : ∀ i, M i ⟶ W i)
      (ψ : ∀ i, (modelSeq Y M i).RationalMap (M i)),
      -- the models `Y_i`, `i ≤ n`, and their nef thresholds
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sM i) ∧ IsQFactorial (modelStr sY sM i) ∧
        (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sM i) m (divisorSeq KY KM i)) ∧
        modelMap πY πM i ≫ sZ = modelStr sY sM i ∧
        IsRealDltPair (modelStr sY sM i) (divisorSeq BY BM i) ∧
        0 ≤ lam i ∧ lam i ≤ t ∧
        IsRelativelyNef ℂ (modelStr sY sM i) (modelMap πY πM i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i))) ∧
      -- the steps `Y_i ⤏ Y_{i+1}`, `i < n`
      (∀ i < n,
        f i ≫ g i = modelMap πY πM i ∧ fp i ≫ g i = πM i ∧
        lam (i + 1) ≤ lam i ∧
        IsNegativeExtremalContraction ℂ (modelStr sY sM i) (sW i)
          (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) ∧
        IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i)) ∧
        ((IsBirationalMorphism (f i) ∧
            (∃ E : MMP.Mori.PrimeDivisor (modelSeq Y M i),
              (MMP.Mori.exceptionalSet (f i) : Set (modelSeq Y M i)) = E.support) ∧
            IsIso (fp i) ∧ IsModificationOf (f i) (fp i) (ψ i)) ∨
          IsFlip ℂ (modelStr sY sM i) (sW i) (sM i)
            (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) (fp i)
            (ψ i)) ∧
        BM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) ∧
        CM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i)) ∧
      -- the program ends with a nef lower adjoint
      lam n = 0 ∧
      IsRelativelyNef ℂ (modelStr sY sM n) (modelMap πY πM n)
        (logCanonicalDivisor (divisorSeq KY KM n) (divisorSeq BY BM n)) ∧
      -- every lower level `u ∈ [0, t]` has a nef dlt model among the `Y_j`
      ∀ u ∈ Set.Icc (0 : ℝ) t, ∃ j ≤ n,
        IsRealDltPair (modelStr sY sM j) (divisorSeq BY BM j + u • divisorSeq CY CM j) ∧
        IsRelativelyNef ℂ (modelStr sY sM j) (modelMap πY πM j)
          (logCanonicalDivisor (divisorSeq KY KM j)
            (divisorSeq BY BM j + u • divisorSeq CY CM j)) ∧
        ∀ i < j,
          IsRelativelyAntiAmple (f i) (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + u • divisorSeq CY CM i)) ∨
          IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
            (logCanonicalDivisor (divisorSeq KY KM i)
              (divisorSeq BY BM i + u • divisorSeq CY CM i))  := by
  obtain ⟨n, M, i₁, i₂, i₃, i₄, sM, πM, KM, BM, CM, lam, W, sW, f, g, fp, ψ, hmod, hstep, hlamn,
      hnefn, hCY₀, hCM₀, hup, hlcup⟩ :=
    exists_scalingProgram_with_upperLevels hX hXsm hdim hZ hB hC hlc hsnc hCB hA hA0 hAB hAfl hα hN
      hNB hfloor ht ht1 h1 hCY hBY hY
  -- the levels between two consecutive thresholds are dlt
  have hdlt₀ : ∀ u ∈ Set.Icc (lam 0) t, IsRealDltPair sY (BY + u • CY) := by
    rintro u ⟨hu0, hut⟩
    rcases hut.lt_or_eq with hut | rfl
    · obtain ⟨-, hQ, -, -, hdltB, hlam0, -⟩ := hmod 0 (Nat.zero_le _)
      exact isRealDltPair_add_smul hQ hCY₀ hdltB hY.isRealDltPair.1 (hlam0.trans hu0) hut
    · exact hY.isRealDltPair
  have hdlt : ∀ i < n, ∀ u ∈ Set.Ico (lam (i + 1)) (lam i),
      IsRealDltPair (sM i) (BM i + u • CM i) := by
    rintro i hi u ⟨hu0, hul⟩
    obtain ⟨-, hQ, -, -, hdltB, hlam0, -⟩ := hmod (i + 1) hi
    exact isRealDltPair_add_smul hQ (hCM₀ i hi) hdltB (hlcup i hi) (hlam0.trans hu0) hul
  refine ⟨n, M, i₁, i₂, i₃, i₄, sM, πM, KM, BM, CM, lam, W, sW, f, g, fp, ψ, hmod, hstep, hlamn,
    hnefn, forall_mem_Icc_exists_nef_dltModel (fun i hi => (hmod i hi).2.2.2.2.2.2.2) hlamn
      hY.isRelativelyNef hdlt₀ hup hdlt fun i hi u hu0 hul => ?_⟩
  obtain ⟨-, -, -, hneg, htriv, -⟩ := hstep i hi
  -- a contraction of a projective model onto a separated base is projective
  have hfp : IsProjective (f i) := by
    haveI : IsSeparated (sW i) := hneg.isNormalVariety_target.1.toIsSeparated
    refine IsProjective.of_comp (f i) (sW i) ?_
    rw [hneg.isContraction.comp_eq]
    exact (hmod i hi.le).1.isProjective.isProjective
  exact isRelativelyAntiAmple_of_lt hneg hfp htriv (hu0.trans_lt hul) hul

private theorem solution
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    -- the SNC fourfold setting
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N))
    -- the log minimal upper model
    (ht : 0 < t) (ht1 : t ≤ 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + t • C) KY (BY + t • CY) φ) :
    ∃ (n : ℕ) (M : ℕ → Scheme.{0}) (_ : ∀ i, IsIntegral (M i)) (_ : ∀ i, CompactSpace (M i))
      (_ : ∀ i, IsLocallyNoetherian (M i)) (_ : ∀ i, IsNormal (M i))
      (sM : ∀ i, M i ⟶ Spec (.of ℂ)) (πM : ∀ i, M i ⟶ Z) (KM : ∀ i, Divisor (M i))
      (BM CM : ∀ i, RDivisor (M i)) (lam : ℕ → ℝ)
      (W : ℕ → Scheme.{0}) (sW : ∀ i, W i ⟶ Spec (.of ℂ))
      (f : ∀ i, modelSeq Y M i ⟶ W i) (g : ∀ i, W i ⟶ Z) (fp : ∀ i, M i ⟶ W i)
      (ψ : ∀ i, (modelSeq Y M i).RationalMap (M i)),
      -- the models `Y_i`, `i ≤ n`, and their nef thresholds
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sM i) ∧ IsQFactorial (modelStr sY sM i) ∧
        (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sM i) m (divisorSeq KY KM i)) ∧
        modelMap πY πM i ≫ sZ = modelStr sY sM i ∧
        IsRealDltPair (modelStr sY sM i) (divisorSeq BY BM i) ∧
        0 ≤ lam i ∧ lam i ≤ t ∧
        IsRelativelyNef ℂ (modelStr sY sM i) (modelMap πY πM i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i))) ∧
      -- the steps `Y_i ⤏ Y_{i+1}`, `i < n`
      (∀ i < n,
        f i ≫ g i = modelMap πY πM i ∧ fp i ≫ g i = πM i ∧
        lam (i + 1) ≤ lam i ∧
        IsNegativeExtremalContraction ℂ (modelStr sY sM i) (sW i)
          (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) ∧
        IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i)) ∧
        ((IsBirationalMorphism (f i) ∧
            (∃ E : MMP.Mori.PrimeDivisor (modelSeq Y M i),
              (MMP.Mori.exceptionalSet (f i) : Set (modelSeq Y M i)) = E.support) ∧
            IsIso (fp i) ∧ IsModificationOf (f i) (fp i) (ψ i)) ∨
          IsFlip ℂ (modelStr sY sM i) (sW i) (sM i)
            (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) (fp i)
            (ψ i)) ∧
        BM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) ∧
        CM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i)) ∧
      -- the program ends with a nef lower adjoint
      lam n = 0 ∧
      IsRelativelyNef ℂ (modelStr sY sM n) (modelMap πY πM n)
        (logCanonicalDivisor (divisorSeq KY KM n) (divisorSeq BY BM n)) ∧
      -- every lower level `u ∈ [0, t]` has a nef dlt model among the `Y_j`
      ∀ u ∈ Set.Icc (0 : ℝ) t, ∃ j ≤ n,
        IsRealDltPair (modelStr sY sM j) (divisorSeq BY BM j + u • divisorSeq CY CM j) ∧
        IsRelativelyNef ℂ (modelStr sY sM j) (modelMap πY πM j)
          (logCanonicalDivisor (divisorSeq KY KM j)
            (divisorSeq BY BM j + u • divisorSeq CY CM j)) ∧
        ∀ i < j,
          IsRelativelyAntiAmple (f i) (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + u • divisorSeq CY CM i)) ∨
          IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
            (logCanonicalDivisor (divisorSeq KY KM i)
              (divisorSeq BY BM i + u • divisorSeq CY CM i)) := by
  classical
  -- Rescale `C` by `t`: the level-`t` problem for `C` is the level-one problem for `t • C`.
  have ht0 : t ≠ 0 := ht.ne'
  have hle : ∀ P, (B + t • C).coeff P ≤ (B + C).coeff P := fun P => by
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.smul_apply,
      smul_eq_mul] at *
    nlinarith [hC P]
  have htr : ∀ D : RDivisor X, MMP.Mori.RationalMap.transformDivisor φ (t • D) =
      t • MMP.Mori.RationalMap.transformDivisor φ D := fun D =>
    (MMP.Mori.RationalMap.transformDivisorₗ ℝ φ).map_smul t D
  obtain ⟨n, M, i₁, i₂, i₃, i₄, sM, πM, KM, BM, CM', lam', W, sW, f, g, fp, ψ, hmod, hstep,
      hlamn, hnefn, hu⟩ :=
    exists_finite_scalingProgram_of_eq_one (C := t • C) (N := t • N) (α := t * α) (t := 1)
      (CY := t • CY) hX hXsm hdim hZ hB
      (fun P => by simpa [DivisorWithCoeffs.coeff_apply] using mul_nonneg ht.le (hC P))
      hY.isRealLcPair
      (hsnc.of_support_subset fun P hP => by
        simp only [Finsupp.mem_support_iff] at hP ⊢
        intro h0
        have h1 := hB P
        have h2 := hC P
        simp only [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.smul_apply,
          smul_eq_mul] at h0 h1 h2 hP
        apply hP
        nlinarith)
      (fun P hP => by
        have := hCB P hP
        simp only [DivisorWithCoeffs.coeff_apply] at this ⊢
        simp [this])
      hA hA0 hAB (fun P hP => (hle P).trans_lt (hAfl P hP)) (mul_pos ht hα)
      (fun P => by simpa [DivisorWithCoeffs.coeff_apply] using mul_nonneg ht.le (hN P))
      (fun P hP => hNB P (by
        intro h0
        apply hP
        simp only [DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, smul_eq_mul] at h0 ⊢
        rw [h0, mul_zero]))
      (by
        have := isNumericallyEquivalentOver_smul ht0 hfloor
        rwa [smul_smul, smul_add] at this)
      one_pos le_rfl rfl (by rw [hCY, htr]) hBY (by simpa only [one_smul] using hY)
  -- the scaling divisors of the rescaled program, divided by `t`
  have hsc : ∀ i (c : ℝ), c • divisorSeq CY (fun i => t⁻¹ • CM' i) i =
      (c * t⁻¹) • divisorSeq (t • CY) CM' i := by
    intro i c
    cases i with
    | zero =>
      change c • CY = (c * t⁻¹) • (t • CY)
      rw [smul_smul, mul_assoc, inv_mul_cancel₀ ht0, mul_one]
    | succ i =>
      change c • (t⁻¹ • CM' i) = (c * t⁻¹) • CM' i
      rw [smul_smul]
  have hlt : ∀ i, (lam' i * t) • divisorSeq CY (fun i => t⁻¹ • CM' i) i =
      lam' i • divisorSeq (t • CY) CM' i := fun i => by
    rw [hsc, mul_inv_cancel_right₀ ht0]
  refine ⟨n, M, i₁, i₂, i₃, i₄, sM, πM, KM, BM, fun i => t⁻¹ • CM' i, fun i => lam' i * t, W,
    sW, f, g, fp, ψ, fun i hi => ?_, fun i hi => ?_, by simp [hlamn], hnefn, fun u hu' => ?_⟩
  · obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆, h₇, h₈⟩ := hmod i hi
    have h₇' : lam' i * t ≤ t := by simpa using mul_le_mul_of_nonneg_right h₇ ht.le
    refine ⟨h₁, h₂, h₃, h₄, h₅, mul_nonneg h₆ ht.le, h₇', ?_⟩
    simpa only [hlt] using h₈
  · obtain ⟨h₁, h₂, h₃, h₄, h₅, h₆, h₇, h₈⟩ := hstep i hi
    refine ⟨h₁, h₂, mul_le_mul_of_nonneg_right h₃ ht.le, h₄, by simpa only [hlt] using h₅, h₆,
      h₇, ?_⟩
    have e := hsc i 1
    rw [one_smul, one_mul] at e
    change t⁻¹ • CM' i = _
    rw [e, ← MMP.Mori.RationalMap.transformDivisorₗ_apply ℝ,
      (MMP.Mori.RationalMap.transformDivisorₗ ℝ (ψ i)).map_smul,
      MMP.Mori.RationalMap.transformDivisorₗ_apply, ← h₈]
  · obtain ⟨hu0, hut⟩ := hu'
    obtain ⟨j, hj, h₁, h₂, h₃⟩ := hu (u * t⁻¹)
      ⟨mul_nonneg hu0 (inv_nonneg.mpr ht.le), by
        rw [mul_inv_le_iff₀ ht, one_mul]; exact hut⟩
    refine ⟨j, hj, by simpa only [hsc] using h₁, by simpa only [hsc] using h₂,
      fun i hi => ?_⟩
    simpa only [hsc] using h₃ i hi

end Proof_thm_fourfold_real_snc_floor_segment_program

end

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **A finite real floor program supplies every lower nef model.** Let `X` be a smooth
projective complex fourfold over a projective variety `Z`, `(X, B + C)` an lc pair with snc
support, `B, C ≥ 0`, `C` without component in `⌊B⌋`, `A ≤ B` an effective ample `ℚ`-divisor
with no component in `⌊B + C⌋`, and `α (K_X + B) ≡_Z C + N` with `α > 0`, `N ≥ 0` supported in
`⌊B⌋`. Let `0 < t ≤ 1` and let `(Y, B_Y + t C_Y)` be a log minimal model of `(X, B + t C)` over
`Z`, with `C_Y = φ_* C` and `B_Y = φ_* B + ∑ F` (`F` exceptional over `X`). Then there are a
number `n` of steps and models `Y_0 = Y, …, Y_n` of a `(K_Y + B_Y)`-program with scaling of
`C_Y`, with thresholds `t ≥ λ_0 ≥ ⋯ ≥ λ_n = 0`, ending with `K_{Y_n} + B_n` nef over `Z`, and for
every `u ∈ [0, t]` some `j ≤ n` such that `(Y_j, B_j + u C_j)` is dlt with adjoint nef over `Z`
and every step before `Y_j` is negative or crepant for `K + B + u C`. -/
@[mmp "thm_fourfold_real_snc_floor_segment_program"]
public theorem IsRealLogMinimalModel.exists_finite_scalingProgram_of_isSNC
    {X Y Z : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {π : X ⟶ Z} {πY : Y ⟶ Z}
    {KX : Divisor X} {B C N : RDivisor X} {A : QDivisor X} {α t : ℝ}
    {KY : Divisor Y} {BY CY : RDivisor Y} {φ : X.RationalMap Y}
    -- the SNC fourfold setting
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXsm : IsSmoothScheme sX)
    (hdim : topologicalKrullDim X = 4) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hB : ∀ P, 0 ≤ B.coeff P) (hC : ∀ P, 0 ≤ C.coeff P)
    (hlc : IsRealLcPair sX (B + C)) (hsnc : DivisorWithCoeffs.IsSNC sX (B + C))
    (hCB : ∀ P, 1 ≤ B.coeff P → C.coeff P = 0)
    (hA : A.IsAmple) (hA0 : ∀ P, 0 ≤ A.coeff P)
    (hAB : ∀ P, (QDivisor.toRDivisor A).coeff P ≤ B.coeff P)
    (hAfl : ∀ P, A.coeff P ≠ 0 → (B + C).coeff P < 1)
    (hα : 0 < α) (hN : ∀ P, 0 ≤ N.coeff P) (hNB : ∀ P, N.coeff P ≠ 0 → 1 ≤ B.coeff P)
    (hfloor : IsNumericallyEquivalentOver ℂ sX π (α • logCanonicalDivisor KX B) (C + N))
    -- the log minimal upper model
    (ht : 0 < t) (ht1 : t ≤ 1)
    (hCY : CY = MMP.Mori.RationalMap.transformDivisor φ C)
    (hBY : ∀ F : MMP.Mori.PrimeDivisor Y, BY.coeff F =
      (MMP.Mori.RationalMap.transformDivisor φ B).coeff F +
        open Classical in if MMP.Flips.RationalMap.IsInverseExceptional φ F then 1 else 0)
    (hY : IsRealLogMinimalModel sX sY sZ π πY KX (B + t • C) KY (BY + t • CY) φ) :
    ∃ (n : ℕ) (M : ℕ → Scheme.{0}) (_ : ∀ i, IsIntegral (M i)) (_ : ∀ i, CompactSpace (M i))
      (_ : ∀ i, IsLocallyNoetherian (M i)) (_ : ∀ i, IsNormal (M i))
      (sM : ∀ i, M i ⟶ Spec (.of ℂ)) (πM : ∀ i, M i ⟶ Z) (KM : ∀ i, Divisor (M i))
      (BM CM : ∀ i, RDivisor (M i)) (lam : ℕ → ℝ)
      (W : ℕ → Scheme.{0}) (sW : ∀ i, W i ⟶ Spec (.of ℂ))
      (f : ∀ i, modelSeq Y M i ⟶ W i) (g : ∀ i, W i ⟶ Z) (fp : ∀ i, M i ⟶ W i)
      (ψ : ∀ i, (modelSeq Y M i).RationalMap (M i)),
      -- the models `Y_i`, `i ≤ n`, and their nef thresholds
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sY sM i) ∧ IsQFactorial (modelStr sY sM i) ∧
        (∃ m : ℕ, Divisor.IsCanonicalDivisor (modelStr sY sM i) m (divisorSeq KY KM i)) ∧
        modelMap πY πM i ≫ sZ = modelStr sY sM i ∧
        IsRealDltPair (modelStr sY sM i) (divisorSeq BY BM i) ∧
        0 ≤ lam i ∧ lam i ≤ t ∧
        IsRelativelyNef ℂ (modelStr sY sM i) (modelMap πY πM i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i))) ∧
      -- the steps `Y_i ⤏ Y_{i+1}`, `i < n`
      (∀ i < n,
        f i ≫ g i = modelMap πY πM i ∧ fp i ≫ g i = πM i ∧
        lam (i + 1) ≤ lam i ∧
        IsNegativeExtremalContraction ℂ (modelStr sY sM i) (sW i)
          (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) ∧
        IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
          (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + lam i • divisorSeq CY CM i)) ∧
        ((IsBirationalMorphism (f i) ∧
            (∃ E : MMP.Mori.PrimeDivisor (modelSeq Y M i),
              (MMP.Mori.exceptionalSet (f i) : Set (modelSeq Y M i)) = E.support) ∧
            IsIso (fp i) ∧ IsModificationOf (f i) (fp i) (ψ i)) ∨
          IsFlip ℂ (modelStr sY sM i) (sW i) (sM i)
            (logCanonicalDivisor (divisorSeq KY KM i) (divisorSeq BY BM i)) (f i) (fp i)
            (ψ i)) ∧
        BM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq BY BM i) ∧
        CM i = MMP.Mori.RationalMap.transformDivisor (ψ i) (divisorSeq CY CM i)) ∧
      -- the program ends with a nef lower adjoint
      lam n = 0 ∧
      IsRelativelyNef ℂ (modelStr sY sM n) (modelMap πY πM n)
        (logCanonicalDivisor (divisorSeq KY KM n) (divisorSeq BY BM n)) ∧
      -- every lower level `u ∈ [0, t]` has a nef dlt model among the `Y_j`
      ∀ u ∈ Set.Icc (0 : ℝ) t, ∃ j ≤ n,
        IsRealDltPair (modelStr sY sM j) (divisorSeq BY BM j + u • divisorSeq CY CM j) ∧
        IsRelativelyNef ℂ (modelStr sY sM j) (modelMap πY πM j)
          (logCanonicalDivisor (divisorSeq KY KM j)
            (divisorSeq BY BM j + u • divisorSeq CY CM j)) ∧
        ∀ i < j,
          IsRelativelyAntiAmple (f i) (logCanonicalDivisor (divisorSeq KY KM i)
            (divisorSeq BY BM i + u • divisorSeq CY CM i)) ∨
          IsNumericallyTrivialOver ℂ (modelStr sY sM i) (f i)
            (logCanonicalDivisor (divisorSeq KY KM i)
              (divisorSeq BY BM i + u • divisorSeq CY CM i)) :=
                by revert X Y Z sX sY sZ π πY KX B C N A α t KY BY CY φ; first | exact Proof_thm_fourfold_real_snc_floor_segment_program.solution | exact Proof_thm_fourfold_real_snc_floor_segment_program.solution _ | exact Proof_thm_fourfold_real_snc_floor_segment_program.solution _ _ | exact Proof_thm_fourfold_real_snc_floor_segment_program.solution _ _ _ | exact Proof_thm_fourfold_real_snc_floor_segment_program.solution _ _ _ _

end MMP.Fourfold

