    haveI : IsSeparated sY := hproj.toIsVariety.toIsSeparated
    haveI : IsSeparated (Y ↘ ⊤_ Scheme) := by
      rw [show (Y ↘ ⊤_ Scheme) = sY ≫ Limits.terminal.from (Spec (.of ℂ)) from
        Subsingleton.elim _ _]
