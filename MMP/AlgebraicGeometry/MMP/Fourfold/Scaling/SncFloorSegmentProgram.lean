    (fun i => (seqOf ⟨Y, sY, πY, KY, BY, CY, 1⟩ T i).C) C (fun i _ => (hstp i).eq_transform_C)
    (hCY.trans (congrArg (fun χ => MMP.Mori.RationalMap.transformDivisor χ C)
