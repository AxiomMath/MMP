          simp only [Scheme.PartialMap.compHom, Category.assoc]
        rw [this, Scheme.RationalMap.compHom_toRationalMap, hov]
        change (π.toPartialMap.compHom sZ).toRationalMap = _
        rw [Scheme.Hom.toPartialMap_compHom]
