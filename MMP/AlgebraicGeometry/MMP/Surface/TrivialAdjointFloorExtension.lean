/-- **Admissible floor sections of a trivial surface adjoint extend.** Let `(S, B)` be a
`ℚ`-factorial projective dlt pair (`MMP.Fourfold.IsPair`, `MMP.Intersection.IsDltPair`) on a
complex surface with `K + B ∼_ℚ 0` for a canonical divisor `K`. For each prime divisor `P` of `S`
with `⌊coeff_P B⌋ ≠ 0` let `j_P : C_P ⟶ S` with the divisor `B_{C_P}` be the adjunction step onto
`P`. Then there is `m₀ > 0` such that for every even `m` divisible by `m₀`, every residue
restriction structure `R` on the collection `(C_P, B_{C_P})` in degree `m`, and every admissible
section system `t ∈ admissibleSections R`, there is `s ∈ H⁰(S, m(K_S + B))` whose Poincaré residue
along every `j_P` is `t_P`. -/
@[mmp "lem_mmp_surface_trivial_adjoint_admissible_floor_extension"]
public theorem exists_isPoincareResidue_of_mem_admissibleSections
    {S : Scheme.{0}} [IsIntegral S] [CompactSpace S] [IsLocallyNoetherian S] [IsNormal S]
    {sS : S ⟶ Spec (.of ℂ)} (hS : Mori.IsProjectiveVariety ℂ sS)
    (hdim : topologicalKrullDim S = 2)
    (hQ : IsQFactorial sS) {B : QDivisor S} (hB : IsPair sS B)
    (hdlt : MMP.Intersection.IsDltPair sS B) {K : Divisor S} (hK : K.IsCanonicalDivisor sS 2)
    (hK0 : (Divisor.toQDivisor K + B).QLinearlyEquivalent 0)
    (C : {P : Mori.PrimeDivisor S // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    (j : ∀ P, C P ⟶ S) (BC : ∀ P, QDivisor (C P))
    (hC : ∀ P, IsAdjunctionStep sS B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set S)) :
    ∃ m₀ : ℕ, 0 < m₀ ∧ ∀ m : ℕ, m₀ ∣ m → Even m →
      ∀ (R : ResidueRestriction (fun P => j P ≫ sS) BC 1 m), ∀ t ∈ admissibleSections R,
        ∃ s ∈ logPluricanonicalSections sS 2 m B, ∀ P,
          IsPoincareResidue sS (j P) 1 m s (t P : RationalPluriForms (j P ≫ sS) 1 m) :=
            by revert S sS hS hdim hQ B hB hdlt K hK hK0 C j BC hC; first | exact Proof_lem_mmp_surface_trivial_adjoint_admissible_floor_extension.solution | exact Proof_lem_mmp_surface_trivial_adjoint_admissible_floor_extension.solution _ | exact Proof_lem_mmp_surface_trivial_adjoint_admissible_floor_extension.solution _ _ | exact Proof_lem_mmp_surface_trivial_adjoint_admissible_floor_extension.solution _ _ _ | exact Proof_lem_mmp_surface_trivial_adjoint_admissible_floor_extension.solution _ _ _ _

end MMP.Fourfold

