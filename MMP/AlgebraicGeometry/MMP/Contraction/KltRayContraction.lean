module

public import MMP.AlgebraicGeometry.MMP.ConeTheorem.RayLength
public import MMP.AlgebraicGeometry.MMP.Contraction.LineBundleDescent

/-!
# Contractions of negative extremal rays of projective klt pairs

Let `(X, B)` be a projective klt pair over an algebraically closed field `k` of characteristic
zero, with `B` an effective `ℚ`-divisor, and let `K` be a canonical divisor of `X`. Every
`(K + B)`-negative extremal ray `R` of the closed cone of curves `NE̅(X) ⊆ N₁(X)_ℝ` is spanned by
the class of a rational curve `T ⊆ X`, and has a contraction: a projective surjective morphism
`f : X ⟶ Z` onto a normal projective variety with `f_* 𝒪_X = 𝒪_Z`, contracting exactly the
integral curves whose class lies in `R`, with `ρ(X/Z) = 1` and `-(K + B)` relatively ample
over `Z`.

The contraction comes from the cone and contraction theorem applied to the negative face `R`;
the rational curve comes from the length theorem for extremal rays; `ρ(X/Z) = 1` because the
vertical curve classes span the line `ℝ · [T]`.

## Main results

* `MMP.Fourfold.exists_isContractionOfRay_of_isKltPair`: the statement above.

## Implementation notes

* The klt condition is `MMP.Fourfold.IsKltPair`, which records that `k` is algebraically closed
  of characteristic zero and that `B ≥ 0`. The ray is `MMP.Fourfold.IsNegativeExtremalRayOf` for
  the `ℚ`-Cartier divisor `K + B`.
* "Generated by `T`" is `R = ℝ_{≥0} · [T]`, where `T` is a `MMP.Mori.ProperCurve` (recorded by
  its generic point) whose reduced closure is a rational curve in the sense of
  `MMP.Mori.IsRationalCurve`.
* The contraction is `MMP.Fourfold.IsContractionOfRay` (which contains projectivity of `f`,
  normality of `Z` and `f_* 𝒪_X = 𝒪_Z`), the target is projective
  (`MMP.Mori.IsProjectiveVariety`), the relative Picard number is
  `MMP.Fourfold.relativePicardNumberN1`, and relative ampleness of `-(K + B)` is
  `MMP.Mori.QDivisor.HasRelativelyAmpleMultiple`.
* `ρ(X/Z)` is computed in the convention `N¹(X)_ℝ / f^* N¹(Z)_ℝ` of
  `MMP.Fourfold.relativePicardNumberN1`. A Cartier divisor `H` with `a = deg_T 𝒪_X(H) ≠ 0` exists
  since `[T] ≠ 0`; then for each Cartier `E` with `e = deg_T 𝒪_X(E)` the divisor `aE - eH` has
  degree zero on `T`, hence on every curve of `R = ℝ_{≥0} [T]`, so it descends, and
  `a [D] - (D · T) [H]` lies in `f^* N¹(Z)_ℝ` for every `ℝ`-Cartier `D`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], Theorem 3.7
-/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP.Mori MMP.Fourfold

namespace MMP.FourfoldProofs.MmpProjectiveRationalKltRayContractionProof

section RelativePicardNumber

variable {k : Type} [Field k] {X Z : Scheme.{0}} {sX : X ⟶ Spec (.of k)}

/-- The degree along a proper curve is an isomorphism invariant of the invertible sheaf. -/
private theorem degree_eq_of_iso (C : ProperCurve sX) {L L' : X.Modules}
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L'] (e : L ≅ L') :
    C.degree k L = C.degree k L' :=
  degreeOn_eq_of_iso k sX C.ι C.dim_le e

/-- `deg_C 𝒪_X(E + E') = deg_C 𝒪_X(E) + deg_C 𝒪_X(E')` along a proper curve. -/
private theorem degree_cartierSheaf_add (C : ProperCurve sX) (E E' : X.CartierDivisor) :
    C.degree k (MMP.CartierDivisor.sheaf (E + E')) =
      C.degree k (MMP.CartierDivisor.sheaf E) +
        C.degree k (MMP.CartierDivisor.sheaf E') := by
  haveI : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.toRingedSpace.presheaf,
        X.toRingedSpace.IsSheaf⟩).obj (MMP.CartierDivisor.sheaf E)).obj
          (MMP.CartierDivisor.sheaf E')) :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf X.ringCatSheaf.2 _ _
  rw [ProperCurve.degree, ProperCurve.degree, ProperCurve.degree, ← degreeOn_tensorSheaf]
  exact degreeOn_eq_of_iso k sX C.ι C.dim_le (MMP.CartierDivisorSheaf.sheafMulIso E E').symm

/-- The degree `E ↦ deg_C 𝒪_X(E)` along a proper curve, as a homomorphism `Div(X) → ℤ`. -/
private noncomputable def cartierDegreeHom (C : ProperCurve sX) : X.CartierDivisor →+ ℤ :=
  AddMonoidHom.mk' (fun E => C.degree k (MMP.CartierDivisor.sheaf E))
    (degree_cartierSheaf_add C)

private theorem cartierDegreeHom_apply (C : ProperCurve sX) (E : X.CartierDivisor) :
    cartierDegreeHom C E = C.degree k (MMP.CartierDivisor.sheaf E) :=
  rfl

/-- `(C · E) = deg_C 𝒪_X(E)` for a Cartier divisor `E`, viewed as an `ℝ`-Cartier divisor. -/
private theorem intersectionNumber_ofCartier (C : ProperCurve sX) (E : X.CartierDivisor) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ E) = cartierDegreeHom C E := by
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]
  rfl

/-- The numerical class `E ↦ [E] ∈ N¹(X)_ℝ` of Cartier divisors, as an additive map. -/
private noncomputable def cartierClassHom : X.CartierDivisor →+ NumericalDivisorClasses sX :=
  AddMonoidHom.mk' (fun E => numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E))
    fun E E' => by
      rw [← map_add]
      refine (Submodule.Quotient.eq _).mpr (mem_numericallyTrivialDivisors.mpr fun C => ?_)
      have h := intersectionNumber_ofCartier C
      simp only [OneCycle.intersectionNumber] at h ⊢
      simp [h, map_add]

private theorem cartierClassHom_apply (E : X.CartierDivisor) :
    cartierClassHom E = numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E) :=
  rfl

/-- `([E] · T) = deg_T 𝒪_X(E)` for the class `[E] ∈ N¹(X)_ℝ` of a Cartier divisor `E`. -/
private theorem numericalPairing_flip_cartierClassHom (T : ProperCurve sX) (E : X.CartierDivisor) :
    (numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ)) (cartierClassHom E) =
      cartierDegreeHom T E :=
  intersectionNumber_ofCartier T E

variable (f : X ⟶ Z) {T : ProperCurve sX} {H : X.CartierDivisor}

/-- **Descent of numerical classes.** Let `H` be a Cartier divisor of degree `a` on a proper
curve `T`, and suppose every Cartier divisor of degree zero on `T` is a pull-back along `f`. Then
`a [D] - (D · T) [H] ∈ f^* N¹(Z)_ℝ` for every `ℝ`-Cartier divisor `D`. -/
private theorem smul_sub_mem_pullbackNumericalClasses
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (D : KCartierDivisor ℝ X) :
    (cartierDegreeHom T H : ℝ) • numericalDivisorClass sX D -
        (T.cycle ℝ).intersectionNumber D • cartierClassHom H ∈
      pullbackNumericalClasses sX f := by
  induction D using Finsupp.induction_linear with
  | zero => simp [OneCycle.intersectionNumber]
  | add D D' h h' =>
    convert add_mem h h' using 1
    simp only [OneCycle.intersectionNumber, map_add, LinearMap.add_apply, add_smul, smul_add]
    abel
  | single E r =>
    set a := cartierDegreeHom T H
    set e := cartierDegreeHom T E
    obtain ⟨M, hM, hiso⟩ := hdesc (a • E - e • H) (by
      rw [← cartierDegreeHom_apply, map_sub, map_zsmul, map_zsmul, smul_eq_mul, smul_eq_mul,
        mul_comm, sub_self])
    have hmem : cartierClassHom (a • E - e • H) ∈ pullbackNumericalClasses sX f :=
      Submodule.subset_span ⟨_, M, hM, hiso, rfl⟩
    rw [map_sub, map_zsmul, map_zsmul, ← Int.cast_smul_eq_zsmul ℝ,
      ← Int.cast_smul_eq_zsmul ℝ] at hmem
    have hs : Finsupp.single E r = r • KCartierDivisor.ofCartier ℝ E := by
      simp [KCartierDivisor.ofCartier, Finsupp.smul_single]
    have hTE : (T.cycle ℝ).intersectionNumber (Finsupp.single E r) = r * e := by
      rw [hs, OneCycle.intersectionNumber, map_smul, LinearMap.smul_apply,
        ← OneCycle.intersectionNumber, intersectionNumber_ofCartier, smul_eq_mul]
    convert Submodule.smul_mem _ r hmem using 1
    rw [hTE, hs, map_smul, ← cartierClassHom_apply]
    module

/-- `f^* N¹(Z)_ℝ` is the kernel of `d ↦ (d · T)` when a Cartier divisor descends along `f` exactly
when it has degree zero on `T`, and some Cartier divisor has nonzero degree on `T`. -/
private theorem pullbackNumericalClasses_eq_ker (hH : cartierDegreeHom T H ≠ 0)
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (hpull : ∀ (E : X.CartierDivisor) (M : Z.Modules)
      (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
      Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M) →
        T.degree k (MMP.CartierDivisor.sheaf E) = 0) :
    pullbackNumericalClasses sX f =
      LinearMap.ker ((numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ))) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun d hd => ?_
  · rintro _ ⟨E, M, hM, hiso, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, ← cartierClassHom_apply,
      numericalPairing_flip_cartierClassHom, cartierDegreeHom_apply, hpull E M hM hiso,
      Int.cast_zero]
  · obtain ⟨D, rfl⟩ := (numericallyTrivialDivisors sX).mkQ_surjective d
    have h := smul_sub_mem_pullbackNumericalClasses f (H := H) hdesc D
    rwa [show (T.cycle ℝ).intersectionNumber D = 0 from hd, zero_smul, sub_zero,
      Submodule.smul_mem_iff _ (by exact_mod_cast hH)] at h

/-- **`ρ(X/Z) = 1`.** Let `T ⊆ X` be a proper curve with nonzero class in `N₁(X)` and `f : X ⟶ Z`
a morphism such that a Cartier divisor `E` on `X` has `𝒪_X(E) ≅ f^* M` for an invertible `M`
on `Z` if and only if `deg_T 𝒪_X(E) = 0`. Then `N¹(X) / f^* N¹(Z)` is a line. -/
private theorem relativePicardNumberN1_eq_one [IsIntegral X] (T : ProperCurve sX)
    (hT : OneCycle.numericalClass sX (T.cycle ℝ) ≠ 0)
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (hpull : ∀ (E : X.CartierDivisor) (M : Z.Modules)
      (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
      Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M) →
        T.degree k (MMP.CartierDivisor.sheaf E) = 0) :
    relativePicardNumberN1 sX f = 1 := by
  obtain ⟨H, hH⟩ : ∃ H : X.CartierDivisor, cartierDegreeHom T H ≠ 0 := by
    by_contra! h
    refine hT ((Submodule.Quotient.mk_eq_zero _).mpr
      (OneCycle.mem_numericallyTrivial.mpr fun L _ => ?_))
    obtain ⟨E, ⟨e⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf L
    rw [OneCycle.degree_cycle, degree_eq_of_iso T e, ← cartierDegreeHom_apply, h E, Int.cast_zero]
  have hsurj : Function.Surjective
      ((numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ))) := fun r =>
    ⟨(r / cartierDegreeHom T H) • cartierClassHom H, by
      rw [map_smul, numericalPairing_flip_cartierClassHom, smul_eq_mul,
        div_mul_cancel₀ r (by exact_mod_cast hH)]⟩
  rw [relativePicardNumberN1, pullbackNumericalClasses_eq_ker f hH hdesc hpull,
    (LinearMap.quotKerEquivOfSurjective _ hsurj).rank_eq, Module.rank_self]
  simp

end RelativePicardNumber

end MMP.FourfoldProofs.MmpProjectiveRationalKltRayContractionProof

