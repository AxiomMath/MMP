@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP.Mori

namespace MMP.Fourfold

/-- **Contraction of a negative extremal ray of a projective klt pair.** Let `(X, B)` be a
projective klt pair over an algebraically closed field of characteristic zero, with `B ≥ 0` a
`ℚ`-divisor and `K` a canonical divisor. Every `(K + B)`-negative extremal ray `R` of `NE̅(X)` is
`ℝ_{≥0} · [T]` for a rational curve `T ⊆ X`, and there is a contraction `f : X ⟶ Z` of `R` onto a
normal projective variety `Z` with `ρ(X/Z) = 1` and `-(K + B)` `f`-ample. -/
@[mmp "thm_mmp_projective_rational_klt_ray_contraction"]
public theorem exists_isContractionOfRay_of_isKltPair
    {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (sX : X ⟶ Spec (.of k))
    (hX : MMP.Mori.IsProjectiveVariety k sX) {B : QDivisor X} (hklt : IsKltPair sX B)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsNegativeExtremalRayOf sX (Divisor.toQDivisor K + B) R) :
    (∃ T : ProperCurve sX,
      IsRationalCurve sX
          (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({T.point} : Set X))) ∧
        R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (T.cycle ℝ) = w}) ∧
      ∃ (Z : Scheme.{0}) (sZ : Z ⟶ Spec (.of k)) (f : X ⟶ Z),
        IsContractionOfRay sX sZ R f ∧ MMP.Mori.IsProjectiveVariety k sZ ∧
          relativePicardNumberN1 sX f = 1 ∧
          (-(Divisor.toQDivisor K + B)).HasRelativelyAmpleMultiple f := by
  have := hklt.1.isAlgClosed
  have := hklt.1.charZero
  have hkm : MMP.Mori.IsKltPair sX n K B :=
    (MMP.Fourfold.isKltPair_iff_mori_isKltPair sX hK hklt.1).mp hklt
  haveI : AlgebraicGeometry.IsProjectiveVariety k sX := hX
  have hBe : B.IsEffective := hklt.1.nonneg
  have hB0 : 0 ≤ B := DivisorWithCoeffs.isEffective_iff_nonneg.mp hBe
  obtain ⟨hQ, hray, hneg⟩ := hR
  have hF : IsNegativeExtremalFace ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
      (MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + B) hkm.1.2.2) R :=
    ⟨hray.1, hray.1.2.2.1, hneg⟩
  obtain ⟨T, hTrat, hRT, hTneg, -⟩ :=
    MMP.Fourfold.exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf_of_isAlgClosed sX hkm
      hB0 ⟨hQ, hray, hneg⟩
  obtain ⟨Z, sZ, ψ, hψ, hZn⟩ :=
    MMP.Mori.exists_isContractionOfFace_of_isNegativeExtremalFace hkm hBe hF
  have htR : OneCycle.numericalClass sX (T.cycle ℝ) ∈ R := by
    rw [hRT]
    exact ⟨1, zero_le_one, one_smul _ _⟩
  have hTc : T.IsContractedBy ψ := (hψ.isContractedBy_iff T).mpr htR
  haveI : AlgebraicGeometry.IsVariety k sZ := hZn.1
  have hproj : IsProjectiveMorphism ψ :=
    IsProjectiveMorphism.of_comp ψ sZ (by rw [hψ.comp_eq]; exact hX.isProjective)
  haveI : IsProper ψ := isProper_of_isProjectiveMorphism ψ hproj
  have hsurj : Surjective ψ := ψ.surjective_of_isIso_app hψ.isIso_app
  have hXn : IsNormalVariety k sX := ⟨hX.toIsVariety, inferInstance⟩
  refine ⟨⟨T, hTrat, hRT⟩, Z, sZ, ψ,
    ⟨⟨hXn, hZn, hψ.comp_eq, hproj, hsurj.surj, hψ.isIso_app⟩, hψ.isContractedBy_iff⟩,
    hψ.isProjectiveVariety_target, ?_, ?_⟩
  · refine
      MMP.FourfoldProofs.MmpProjectiveRationalKltRayContractionProof.relativePicardNumberN1_eq_one ψ T
        ?_ ?_ ?_
    · intro h
      simp [h] at hTneg
    · intro E hE
      refine (MMP.Mori.exists_isInvertible_iso_pullback_of_isContractionOfFace hkm hBe hF hψ
        (MMP.CartierDivisor.sheaf E) fun C hC => ?_).imp fun _ h => ⟨h.1, h.2⟩
      rw [hRT] at hC
      obtain ⟨c, -, hcC⟩ := hC
      have h := congrArg (NumericalCurveClasses.degree sX
        (MMP.CartierDivisor.sheaf E)) hcC
      rw [map_smul, NumericalCurveClasses.degree_numericalClass,
        NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
        OneCycle.degree_cycle, hE, Int.cast_zero, smul_zero] at h
      exact_mod_cast h.symm
    · rintro E M hM ⟨e⟩
      rw [MMP.FourfoldProofs.MmpProjectiveRationalKltRayContractionProof.degree_eq_of_iso T e]
      exact ProperCurve.degree_pullback_eq_zero_of_isContractedBy ψ hψ.comp_eq T hTc M
  · refine MMP.Mori.hasRelativelyAmpleMultiple_neg_of_isExtremalRay sX sZ hXn hX
      hψ.isProjectiveVariety_target ⟨n, hK⟩ hQ hray (fun v hv hv0 => ?_) ψ hψ.comp_eq
      fun C hC => (hψ.isContractedBy_iff C).mp hC
    have h := hneg v hv hv0
    simpa [MMP.Fourfold.QDivisor.curveForm, Finsupp.sum, LinearMap.sum_apply] using h

end MMP.Fourfold

end
