module

public import MMP.AlgebraicGeometry.MMP.MinimalModel.AmpleModelBirational
public import MMP.AlgebraicGeometry.Divisor.DivisorialPullback
public import StacksFrontier.AlgebraicGeometry.AmpleThickeningAscent.LocalGenerator

/-!
# The ample model carries an ample adjoint divisor

Let `(X, B)` be a projective lc fourfold pair over `ℂ` with rational boundary, `D = K_X + B`,
`f : X ⟶ Z` a birational contraction onto a normal projective variety with `-D` `f`-ample, and
`(M, B_M, q, V, B_V)` an ample-model datum for `f`, with structure morphism `p : V ⟶ Z`. Then for
every canonical divisor `K_V` of `V` (over `ℂ` through `V ⟶ Z ⟶ Spec ℂ`), the `ℚ`-divisor
`K_V + B_V` is `ℚ`-Cartier and ample over `Z`.

The datum gives `V ≅ Proj_Z 𝒜` over `Z` for `𝒜 = ⨁_n π_* 𝒪_M(nD)`, `D = k(K_M + B_M)`
Cartier and relatively free, and `q` is the morphism induced by `𝒜`. The section algebra is of
finite type, so for some `d > 0` the twisting sheaf `𝒪_V(d)` is invertible and ample over `Z`, and
`q^* 𝒪_V(d) ≅ 𝒪_M(dD)`. The morphism `q` is proper and birational onto the normal variety `V`. An
invertible sheaf `H` on `V` is `𝒪_V(E)` for a Cartier divisor `E`; then `𝒪_M(q^* E) ≅ q^* H`, so a
divisor `D'` on `M` with `𝒪_M(D') ≅ q^* H` is linearly equivalent to `q^* E`, and pushing forward
gives `q_* D' ∼ q_* q^* E = E`. Hence `q_*(dD)` is Cartier with `𝒪_V(q_*(dD)) ≅ 𝒪_V(d)`.

Writing the canonical divisors as divisors of rational top forms, `K_M = div(q^* τ)` for a form
`τ` on `V`, and `q_* K_M = div(τ)` because `q` is an isomorphism at the generic point of the
strict transform of every prime divisor of `V`; so `q_* K_M ∼ K_V`. Since `B_V = q_* B_M`,
`q_*(dD) = dk(q_* K_M + B_V) ∼ dk(K_V + B_V)`, and `K_V + B_V` is `ℚ`-Cartier and ample over `Z`.

## Main results

* `MMP.Fourfold.IsAmpleModelDatum.isQCartier_and_hasRelativelyAmpleMultiple`: `K_V + B_V` is
  `ℚ`-Cartier and `p`-ample.
* `MMP.Fourfold.IsAmpleModelDatum.isProper_and_isBirationalMorphism`: `V` is a normal variety
  and `q` is proper and birational.
* `MMP.Fourfold.DivisorialSectionAlgebra.exists_isRelativelyAmple_pullback_iso`: some invertible
  `H` on `V`, ample over `Z`, has `q^* H ≅ 𝒪_M(dD)`, `d > 0`.
* `MMP.Fourfold.isPullback_transformDivisor_of_iso`: if `q^* H ≅ 𝒪_M(D')` for an invertible `H`,
  then `q_* D'` is Cartier and `D' = q^*(q_* D')`.

## Implementation notes

* The canonical divisor `K_V` is the divisor of `V` regarded as a `ℂ`-scheme through
  `p ≫ sZ`; the statement holds for every canonical divisor (of any dimension index `n`, which
  `MMP.Mori.Divisor.IsCanonicalDivisor` forces to be `dim V`).
* Divisors on `V` are Weil divisors of a locally Noetherian normal scheme, so `V` is assumed
  normal, locally Noetherian and quasi-compact to speak of `K_V` and of relative ampleness;
  these properties of the relative ample model of a normal variety are not part of
  `MMP.Fourfold.IsAmpleModelDatum`.
* "Ample over `Z`" is `MMP.Mori.QDivisor.HasRelativelyAmpleMultiple` along `p`, the notion
  in which `MMP.Fourfold.IsAmpleModelDatum` states that `-(K_X + B)` is `f`-ample.
* Finite generation of the section ring over an affine open of the base is shown by proving it
  integral over the subalgebra generated by finitely many degree-one generators (valuative
  criterion) and using that `Γ(Z, U)` is a Nagata ring, rather than through Serre's graded-module
  finiteness.
* The file runs in stages: the section algebra and its `Proj`; finite generation; the relatively
  ample twist of the relative `Proj`; descent of invertible sheaves and canonical divisors along
  `q`; the comparison `q^* 𝒪(d) ≅ 𝒪_M(dD)`; and the main theorem.
-/

open CategoryTheory AlgebraicGeometry Opposite RingedSpaceModuleAdjunction

namespace MMP.Fourfold

open MMP.Mori

universe u

/-! ### The relative `Proj` of a divisorial section algebra

The graded ring `⨁_n 𝒜_n(U)` embeds in `𝒦_M(π⁻¹U)[T]` by `a ↦ a Tⁿ`, so it is reduced and so is
its relative `Proj`. A nonzero homogeneous section `a` generates `𝒪_M(nD)` off the support of
`div(a) + nD`, so its generating locus is nonempty; the ring map `𝒜(U)_(a) → 𝒪_M(M_a)` of the
induced morphism is then injective, and the induced morphism is dominant. -/

section SectionAlgebra

variable {M Z : Scheme.{u}} [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} {D : Divisor M}
  (A : DivisorialSectionAlgebra π D)

private theorem sectionEquiv_heq {i j : ℤ} (h : i = j) (hi : 0 ≤ i) (hj : 0 ≤ j) (U : Z.Opens)
    (a : (A.algebra.piece i).val.obj (op U)) (b : (A.algebra.piece j).val.obj (op U))
    (hab : HEq a b) :
    (A.sectionEquiv i hi U a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) =
      (A.sectionEquiv j hj U b : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) := by
  subst h; cases hab; rfl

/-- The degree-`n` piece of the section ring, embedded as monomials in `𝒦[T]`. -/
private noncomputable def pieceHom (U : Z.Opens) (n : ℕ) :
    A.situation.sectionPieces U n →+
      Polynomial ((rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) :=
  (Polynomial.monomial n).toAddMonoidHom.comp
    ((((n : ℤ) • D).divisorialSubmodule (π ⁻¹ᵁ U)).subtype.toAddMonoidHom.comp
      (A.sectionEquiv n (Int.natCast_nonneg n) U).toAddMonoidHom)

private theorem pieceHom_apply (U : Z.Opens) (n : ℕ) (a : A.situation.sectionPieces U n) :
    pieceHom A U n a = Polynomial.monomial n
      (A.sectionEquiv n (Int.natCast_nonneg n) U a :
        (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) := rfl

private noncomputable def toPoly (U : Z.Opens) :
    A.situation.sectionRing U →+*
      Polynomial ((rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) :=
  DirectSum.toSemiring (pieceHom A U) (by
      rw [pieceHom_apply]
      have h1 := (A.situation.sectionRingStructure.one_homogeneous U)
      change Polynomial.monomial 0 ((A.sectionEquiv 0 le_rfl U
        (GradedMonoid.GOne.one : A.situation.sectionPieces U 0) :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))) = 1
      rw [h1, A.sectionEquiv_one]
      simp)
    (by
      intro i j a b
      rw [pieceHom_apply, pieceHom_apply, pieceHom_apply, Polynomial.monomial_mul_monomial]
      congr 1
      rw [← A.sectionEquiv_mul i j (Int.natCast_nonneg i) (Int.natCast_nonneg j) U a b]
      exact sectionEquiv_heq A (by push_cast; rfl) _ _ U _ _
        (A.situation.sectionRingStructure.mul_homogeneous U i j a b))

private theorem coeff_toPoly (U : Z.Opens) (n : ℕ) (x : A.situation.sectionRing U) :
    (toPoly A U x).coeff n = (A.sectionEquiv n (Int.natCast_nonneg n) U (x n) :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) := by
  have : (Polynomial.lcoeff _ n).toAddMonoidHom.comp (toPoly A U).toAddMonoidHom =
      ((((n : ℤ) • D).divisorialSubmodule (π ⁻¹ᵁ U)).subtype.toAddMonoidHom.comp
        (A.sectionEquiv n (Int.natCast_nonneg n) U).toAddMonoidHom).comp
        (DirectSum.component ℤ ℕ (A.situation.sectionPieces U) n).toAddMonoidHom := by
    refine DirectSum.addHom_ext fun i a => ?_
    simp only [AddMonoidHom.comp_apply, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_coe,
      LinearMap.toAddMonoidHom_coe, Polynomial.lcoeff_apply, toPoly,
      DirectSum.toSemiring_of, pieceHom_apply, Polynomial.coeff_monomial]
    by_cases h : i = n
    · subst h
      simp only [ite_true]
      erw [DirectSum.component.of]
      simp
    · rw [ite_eq_right_iff.mpr (fun h' => absurd h' h)]
      erw [DirectSum.component.of, dite_eq_right_of_eq_false (eq_false h)]
      simp
  exact congrArg (fun F => F x) this

private theorem injective_toPoly (U : Z.Opens) : Function.Injective (toPoly A U) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  ext n
  have := coeff_toPoly A U n x
  rw [hx, Polynomial.coeff_zero] at this
  have h0 : A.sectionEquiv n (Int.natCast_nonneg n) U (x n) = 0 := Subtype.ext this.symm
  simpa using h0

private theorem isReduced_sectionRing (U : Z.Opens) :
    _root_.IsReduced (A.situation.sectionRing U) := by
  have : _root_.IsReduced ((rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) := by
    have : ∀ Y : {Y : irreducibleComponents M // componentGenericPoint M Y ∈ π ⁻¹ᵁ U},
        _root_.IsReduced (M.presheaf.stalk (componentGenericPoint M Y.1)) := fun _ => inferInstance
    exact (inferInstance : _root_.IsReduced (∀ Y : {Y : irreducibleComponents M //
      componentGenericPoint M Y ∈ π ⁻¹ᵁ U}, M.presheaf.stalk (componentGenericPoint M Y.1)))
  have : _root_.IsReduced (Polynomial ((rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))) :=
    ⟨fun p hp => Polynomial.ext fun i => by
      simpa using (Polynomial.isNilpotent_iff.mp hp i).eq_zero⟩
  exact isReduced_of_injective (toPoly A U) (injective_toPoly A U)

/-- `Proj` of a reduced graded ring is reduced. -/
private theorem isReduced_proj {σ R : Type*} [CommRing R] [SetLike σ R] [AddSubgroupClass σ R]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] [_root_.IsReduced R] : IsReduced (Proj 𝒜) := by
  suffices h : ∀ x : AlgebraicGeometry.Proj 𝒜,
      _root_.IsReduced ((AlgebraicGeometry.Proj 𝒜).presheaf.stalk x) from
    @isReduced_of_isReduced_stalk _ h
  intro x
  have : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
  have : _root_.IsReduced (HomogeneousLocalization.AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal) :=
    isReduced_of_injective
      (algebraMap (HomogeneousLocalization.AtPrime 𝒜 x.asHomogeneousIdeal.toIdeal)
        (Localization.AtPrime x.asHomogeneousIdeal.toIdeal))
      (HomogeneousLocalization.val_injective _)
  exact isReduced_of_injective (Proj.stalkIso' 𝒜 x) (Proj.stalkIso' 𝒜 x).injective

private theorem isReduced_model : IsReduced A.model := by
  suffices h : ∀ x : A.model, _root_.IsReduced (A.model.presheaf.stalk x) from
    @isReduced_of_isReduced_stalk _ h
  intro x
  obtain ⟨W, hW, hxW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
    (show A.toBase x ∈ (⊤ : Z.Opens) from trivial)
  have hx : x ∈ (A.situation.relativeProjChart ⟨W, hW⟩).opensRange :=
    (Stacks.RelativeProj.Situation.mem_opensRange_relativeProjChart _ _ x).mpr hxW
  obtain ⟨y, rfl⟩ := hx
  have : _root_.IsReduced (A.situation.sectionRing W) := isReduced_sectionRing A W
  have : IsReduced (AlgebraicGeometry.Proj (A.situation.sectionRingGrading W)) := isReduced_proj _
  have : IsIso ((A.situation.relativeProjChart ⟨W, hW⟩).stalkMap y) :=
    (IsOpenImmersion.iff_isIso_stalkMap.mp
      (Stacks.RelativeProj.Situation.isOpenImmersion_relativeProjChart _ _)).2 y
  exact isReduced_of_injective _
    (ConcreteCategory.bijective_of_isIso
      ((A.situation.relativeProjChart ⟨W, hW⟩).stalkMap y)).1

omit [IsLocallyNoetherian M] [IsNormal M] in
private theorem rationalFunctions_map_injective [IrreducibleSpace M] {U V : M.Opens} (h : V ≤ U)
    (hV : (V : Set M).Nonempty) :
    Function.Injective ((rationalFunctionsPresheaf M).map (homOfLE h).op) := by
  intro s s' hss
  funext Y
  have hY : componentGenericPoint M Y.1 ∈ V := by
    rw [genericPoint_mem_iff]
    have : Y.1.1 = Set.univ := (irreducibleComponents_eq_singleton (X := M)).le Y.1.2
    rwa [this, Set.inter_univ]
  exact congrFun hss ⟨Y.1, hY⟩

private theorem injective_of_factors [IrreducibleSpace M] (U : Z.affineOpens) (n : ℕ)
    (a : (A.algebra.piece (n : ℤ)).val.obj (op U.1))
    (hne : ((A.generatingLocus (Int.natCast_nonneg n) a : M.Opens) : Set M).Nonempty)
    (ψ : HomogeneousLocalization.Away (A.situation.sectionRingGrading U.1)
        (DirectSum.of (A.situation.sectionPieces U.1) n a) →+*
        Γ(M, A.generatingLocus (Int.natCast_nonneg n) a))
    (heq : ∀ (m : ℕ) (t : (A.algebra.piece ((m • n : ℕ) : ℤ)).val.obj (op U.1)),
          (toRationalFunctionsPresheaf M).app (op (A.generatingLocus (Int.natCast_nonneg n) a))
              (ψ (HomogeneousLocalization.Away.mk (A.situation.sectionRingGrading U.1) ⟨a, rfl⟩ m
                (DirectSum.of (A.situation.sectionPieces U.1) (m • n) t) ⟨t, rfl⟩)) *
              (rationalFunctionsPresheaf M).map
                (homOfLE (A.generatingLocus_le _ a)).op
                (A.sectionEquiv n (Int.natCast_nonneg n) U.1 a :
                  (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1))) ^ m =
            (rationalFunctionsPresheaf M).map (homOfLE (A.generatingLocus_le _ a)).op
              (A.sectionEquiv _ (Int.natCast_nonneg _) U.1 t :
                (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1)))) :
    Function.Injective ψ := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨m, y, hy, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
    (A.situation.sectionRingGrading U.1)
    (show DirectSum.of (A.situation.sectionPieces U.1) n a ∈ A.situation.sectionRingGrading U.1 n
      from ⟨a, rfl⟩) x
  obtain ⟨t, rfl⟩ := hy
  have h := heq m t
  rw [hx, map_zero, zero_mul] at h
  have h0 := rationalFunctions_map_injective (A.generatingLocus_le _ a) hne
    (h.symm.trans (map_zero _).symm)
  have ht : t = 0 := by
    have : A.sectionEquiv _ (Int.natCast_nonneg _) U.1 t = 0 := Subtype.ext h0
    simpa using this
  subst ht
  apply HomogeneousLocalization.val_injective
  simp [HomogeneousLocalization.Away.val_mk, Localization.mk_zero]

private theorem generatingLocus_nonempty [IsIntegral M] [CompactSpace M] {i : ℤ} (hi : 0 ≤ i)
    {U : Z.Opens}
    (a : (A.algebra.piece i).val.obj (op U)) (ha : a ≠ 0) :
    ((A.generatingLocus hi a : M.Opens) : Set M).Nonempty := by
  classical
  set φ : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)) := (A.sectionEquiv i hi U a :
    (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))
  have hφ : φ ≠ 0 := fun h => ha (by simpa using (Subtype.ext h : A.sectionEquiv i hi U a = 0))
  have hall : ∀ Y Y' : irreducibleComponents M, Y = Y' := fun Y Y' =>
    Subtype.ext (((irreducibleComponents_eq_singleton (X := M)).le Y.2).trans
      ((irreducibleComponents_eq_singleton (X := M)).le Y'.2).symm)
  obtain ⟨⟨Y0, hY0⟩⟩ : Nonempty {Y : irreducibleComponents M //
      componentGenericPoint M Y ∈ π ⁻¹ᵁ U} := by
    by_contra h
    exact hφ (funext fun Y => absurd ⟨Y⟩ h)
  have hmem : ∀ Y : irreducibleComponents M, componentGenericPoint M Y ∈ π ⁻¹ᵁ U := fun Y =>
    (hall Y Y0) ▸ hY0
  let val : RationalFunctions M := fun Y => φ ⟨Y, hmem Y⟩
  have hval : IsUnit val := by
    rw [Pi.isUnit_iff]
    intro Y
    let := (RationalFunctions.isField_stalk M Y).toField
    refine isUnit_iff_ne_zero.mpr fun h0 => hφ (funext fun Y' => ?_)
    obtain rfl : Y'.1 = Y := hall _ _
    exact h0
  let u : (RationalFunctions M)ˣ := hval.unit
  let E0 : Divisor M := MMP.Mori.principalDivisor u + i • D
  let W' : M.Opens := π ⁻¹ᵁ U ⊓ ⟨(E0.supp : Set M)ᶜ, E0.isClosed_supp.isOpen_compl⟩
  have hW' : componentGenericPoint M Y0 ∈ W' := by
    refine ⟨hY0, fun h => ?_⟩
    obtain ⟨E, -, hE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
    exact MMP.Flips.componentGenericPoint_notMem_support Y0 E hE
  refine ⟨_, (le_sSup ?_ : W' ≤ A.generatingLocus hi a) hW'⟩
  refine ⟨inf_le_left, fun Y => ((u⁻¹ : (RationalFunctions M)ˣ) : RationalFunctions M) Y.1,
    ?_, ?_⟩
  · intro E hE
    right
    have hE0 : E0.coeff E = 0 := by
      by_contra hne
      obtain ⟨x, hxE, hxW⟩ := hE
      exact hxW.2 (DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, hne, hxE⟩)
    have hcoeff : E.ord u + i * D.coeff E = 0 := by
      simpa [E0, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul] using hE0
    change WithZero.exp _ ≤ E.valuation (((u⁻¹ : (RationalFunctions M)ˣ) :
      RationalFunctions M) E.component)
    rw [PrimeDivisor.valuation_component, PrimeDivisor.ord_inv]
    apply le_of_eq
    congr 1
    simp only [DivisorWithCoeffs.coeff_neg, DivisorWithCoeffs.coeff_smul, neg_neg, smul_eq_mul]
    linarith
  · funext Y
    change val Y.1 * _ = 1
    rw [show val = (u : RationalFunctions M) from rfl, ← Pi.mul_apply, Units.mul_inv, Pi.one_apply]

private theorem mem_range_awayι {σ R : Type*} [CommRing R] [SetLike σ R] [AddSubgroupClass σ R]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] {f : R} {m : ℕ} (hf : f ∈ 𝒜 m) (hm : 0 < m)
    {y : AlgebraicGeometry.Proj 𝒜} (hy : y ∈ Proj.basicOpen 𝒜 f) :
    y ∈ Set.range (Proj.awayι 𝒜 f hf hm) := by
  rwa [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]

private theorem isDominant_of_isInducedMorphism [IsIntegral M] [CompactSpace M] {q : M ⟶ A.model}
    (hq : A.IsInducedMorphism q)
    (hne : ∀ (U : Z.affineOpens) (n : ℕ) (_ : 0 < n)
      (a : (A.algebra.piece (n : ℤ)).val.obj (op U.1)), a ≠ 0 →
        ((A.generatingLocus (Int.natCast_nonneg n) a : M.Opens) : Set M).Nonempty) :
    IsDominant q := by
  classical
  rw [isDominant_iff]
  refine dense_iff_inter_open.mpr fun O hO ⟨x, hx⟩ => ?_
  obtain ⟨W, hW, hxW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
    (show A.toBase x ∈ (⊤ : Z.Opens) from trivial)
  let U : Z.affineOpens := ⟨W, hW⟩
  obtain ⟨y, rfl⟩ :=
    (Stacks.RelativeProj.Situation.mem_opensRange_relativeProjChart A.situation U x).mpr hxW
  obtain ⟨r, hr, hry⟩ := SetLike.not_le_iff_exists.mp y.not_irrelevant_le
  obtain ⟨i, hi⟩ : ∃ i, ((DirectSum.decompose (A.situation.sectionRingGrading W) r i :
      A.situation.sectionRing W)) ∉ y.asHomogeneousIdeal := by
    by_contra! H
    apply hry
    rw [← DirectSum.sum_support_decompose (A.situation.sectionRingGrading W) r]
    exact Ideal.sum_mem _ fun j _ => H j
  have hi0 : 0 < i := by
    rcases Nat.eq_zero_or_pos i with rfl | h
    · exact absurd ((show ((DirectSum.decompose (A.situation.sectionRingGrading W) r 0 :
          A.situation.sectionRing W)) = 0 from hr) ▸ zero_mem _) hi
    · exact h
  obtain ⟨a, ha⟩ := (DirectSum.decompose (A.situation.sectionRingGrading W) r i).2
  have hya : y ∈ Proj.basicOpen _ (DirectSum.of (A.situation.sectionPieces W) i a) := by
    rwa [Proj.mem_basicOpen, ha]
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [Proj.mem_basicOpen, map_zero] at hya
    exact hya (zero_mem _)
  obtain ⟨z, rfl⟩ : y ∈ Set.range (Proj.awayι (A.situation.sectionRingGrading U.1)
      (DirectSum.of (A.situation.sectionPieces U.1) i a) ⟨a, rfl⟩ hi0) :=
    mem_range_awayι _ _ hi0 hya
  have hL := hne U i hi0 a ha0
  set L := A.generatingLocus (Int.natCast_nonneg i) a
  obtain ⟨ψ, hfac, heq⟩ := hq.factors U i hi0 a
  have hinj := injective_of_factors A U i a hL ψ heq
  have : Nonempty L := hL.to_subtype
  have : IsDomain (HomogeneousLocalization.Away (A.situation.sectionRingGrading U.1)
      (DirectSum.of (A.situation.sectionPieces U.1) i a)) := hinj.isDomain ψ
  have : IsDominant (Spec.map (CommRingCat.ofHom ψ)) :=
    isDominant_Spec_map_of_injective _ hinj
  have : IsNoetherian M := {}
  have : CompactSpace L :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact _)
  have : IsDominant L.toSpecΓ := by
    unfold Scheme.Opens.toSpecΓ
    infer_instance
  let g := L.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)
  let c := Proj.awayι (A.situation.sectionRingGrading U.1)
      (DirectSum.of (A.situation.sectionPieces U.1) i a) ⟨a, rfl⟩ hi0 ≫
    A.situation.relativeProjChart U
  obtain ⟨_, hw, ⟨m, rfl⟩⟩ := g.denseRange.inter_open_nonempty _ (hO.preimage c.continuous)
    ⟨z, hx⟩
  refine ⟨q (L.ι m), ?_, L.ι m, rfl⟩
  have := congrArg (fun h : L.toScheme ⟶ A.model => h m) hfac
  change (L.ι ≫ q) m ∈ O
  rw [this]
  exact hw

end SectionAlgebra

/-! ### The homogeneous pieces are the direct images `π_* 𝒪_M(nD)`

The identifications `𝒜_n(U) ≃ H⁰(π⁻¹U, 𝒪_M(nD))` commute with restriction and are
`𝒪_Z(U)`-linear, so they assemble into an isomorphism of `𝒪_Z`-modules
`𝒜_n ≅ π_* 𝒪_M(nD)`. For `D` Cartier, `𝒪_M(nD)` is invertible, hence coherent on the locally
Noetherian `M`, and for `π` proper over a locally Noetherian base its direct image is coherent
(Stacks 02O5); so every homogeneous piece is of finite type. -/

section Pieces

variable {M Z : Scheme.{u}} [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} {D : Divisor M}
  (A : DivisorialSectionAlgebra π D)

/-- The morphism `𝒜_n ⟶ π_* 𝒪_M(nD)` given by the identifications of sections. -/
private noncomputable def pieceHomPushforward (n : ℤ) (hn : 0 ≤ n) :
    A.algebra.piece n ⟶ (Scheme.Modules.pushforward π).obj (n • D).divisorialSheaf :=
  ⟨PresheafOfModules.homMk
    { app U := AddCommGrpCat.ofHom (A.sectionEquiv n hn U.unop).toAddMonoidHom
      naturality U V i := by
        ext a
        exact A.sectionEquiv_restrict n hn i.unop.le a }
    (fun U r a => A.sectionEquiv_smul n hn U.unop r a)⟩

/-- The morphism `π_* 𝒪_M(nD) ⟶ 𝒜_n` given by the inverse identifications of sections. -/
private noncomputable def pushforwardHomPiece (n : ℤ) (hn : 0 ≤ n) :
    (Scheme.Modules.pushforward π).obj (n • D).divisorialSheaf ⟶ A.algebra.piece n :=
  ⟨PresheafOfModules.homMk
    { app U := AddCommGrpCat.ofHom (A.sectionEquiv n hn U.unop).symm.toAddMonoidHom
      naturality U V i := by
        ext a
        refine (AddEquiv.symm_apply_eq _).mpr ?_
        have := A.sectionEquiv_restrict n hn i.unop.le ((A.sectionEquiv n hn U.unop).symm a)
        erw [this, AddEquiv.apply_symm_apply]
        rfl }
    (fun U r a => by
      refine (AddEquiv.symm_apply_eq _).mpr ?_
      have := A.sectionEquiv_smul n hn U.unop r ((A.sectionEquiv n hn U.unop).symm a)
      erw [this, AddEquiv.apply_symm_apply]
      rfl)⟩

/-- **The homogeneous piece `𝒜_n` is `π_* 𝒪_M(nD)`** as an `𝒪_Z`-module, for `n ≥ 0`. -/
private noncomputable def pieceIsoPushforward (n : ℤ) (hn : 0 ≤ n) :
    A.algebra.piece n ≅ (Scheme.Modules.pushforward π).obj (n • D).divisorialSheaf where
  hom := pieceHomPushforward A n hn
  inv := pushforwardHomPiece A n hn
  hom_inv_id := by
    ext U a
    exact (A.sectionEquiv n hn U.unop).symm_apply_apply a
  inv_hom_id := by
    ext U a
    exact (A.sectionEquiv n hn U.unop).apply_symm_apply a

/-- **Every homogeneous piece of the section algebra of a Cartier divisor along a proper
morphism to a locally Noetherian scheme is of finite type** (Stacks 02O5). -/
private theorem isFiniteType_piece [CompactSpace M] [IsLocallyNoetherian Z] (hπ : IsProper π)
    (hDC : D.IsCartier) (n : ℤ) (hn : 0 ≤ n) :
    SheafOfModules.IsFiniteType (A.algebra.piece n) := by
  have := (hDC.zsmul n).isInvertibleModule_divisorialSheaf
  have : (n • D).divisorialSheaf.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible M _
  have : ((Scheme.Modules.pushforward π).obj (n • D).divisorialSheaf).IsCoherent :=
    ProperCoherenceWitness.isCoherent_pushforward π _
  exact SheafOfModules.IsFiniteType.of_iso SheafOfModules.IsCoherent.isFiniteType
    (pieceIsoPushforward A n hn).symm

end Pieces

/-! ### Finite generation of the section algebra -/

/-- Linear independence over `F` of elements algebraic over `F` persists over the subalgebra
generated by an algebraically independent family. -/
private theorem linearIndependent_adjoin_of_algebraicIndependent {F L : Type*} [Field F] [Field L]
    [Algebra F L]
    {σ : Type*} {b : σ → L} (hb : AlgebraicIndependent (algebraicClosure F L) b)
    {ι : Type*} [Finite ι] {v : ι → algebraicClosure F L} (hv : LinearIndependent F v) :
    LinearIndependent (Algebra.adjoin F (Set.range b)) (fun i => (v i : L)) := by
  classical
  have := Fintype.ofFinite ι
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hpoly : ∀ i, ∃ P : MvPolynomial σ F, MvPolynomial.aeval b P = (g i : L) := by
    intro i
    obtain ⟨P, hP⟩ := (Algebra.adjoin_range_eq_range_aeval F b).le (g i).2
    exact ⟨P, hP⟩
  choose P hP using hpoly
  let Q : MvPolynomial σ (algebraicClosure F L) :=
    ∑ i, MvPolynomial.C (v i) * MvPolynomial.map (algebraMap F (algebraicClosure F L)) (P i)
  have hQ : MvPolynomial.aeval b Q = 0 := by
    simp only [Q, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_map_algebraMap]
    rw [← hg]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hP i, mul_comm]
    rfl
  have hQ0 : Q = 0 := hb.eq_zero_of_aeval_eq_zero Q hQ
  have hcoeff : ∀ α i, (P i).coeff α = 0 := by
    intro α
    have h := congrArg (fun p => p.coeff α) hQ0
    simp only [Q, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map,
      MvPolynomial.coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at h
    refine (Fintype.linearIndependent_iff.mp hv) (fun i => (P i).coeff α) ?_
    rw [← h]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Algebra.smul_def, mul_comm]
  intro i
  apply Subtype.ext
  rw [← hP i]
  have : P i = 0 := MvPolynomial.ext _ _ fun α => by rw [hcoeff α i, MvPolynomial.coeff_zero, Finsupp.coe_zero, Pi.zero_apply]
  rw [this, map_zero]
  rfl

open scoped IntermediateField.algebraAdjoinAdjoin in
/-- The algebraic closure of `F` in a field extension essentially of finite type is finite. -/
private theorem finiteDimensional_algebraicClosure {F L : Type*} [Field F] [Field L] [Algebra F L]
    [Algebra.EssFiniteType F L] : FiniteDimensional F (algebraicClosure F L) := by
  classical
  obtain ⟨s, hs⟩ := exists_finset_isTranscendenceBasis (K := F) (L := L)
  have hb : AlgebraicIndependent (algebraicClosure F L) ((↑) : s → L) :=
    hs.1.extendScalars (algebraicClosure F L)
  set L0 := IntermediateField.adjoin F (Set.range ((↑) : s → L))
  have : Algebra.IsAlgebraic L0 L := hs.isAlgebraic_field
  have : Algebra.EssFiniteType L0 L := Algebra.EssFiniteType.of_comp F L0 L
  have : Module.Finite L0 L := Algebra.finite_of_essFiniteType_of_isAlgebraic
  refine Module.rank_lt_aleph0_iff.mp <|
    lt_of_le_of_lt (_root_.rank_le (n := Module.finrank L0 L) fun t ht => ?_)
    (Cardinal.natCast_lt_aleph0)
  have h1 := linearIndependent_adjoin_of_algebraicIndependent hb ht
  have h2 : LinearIndependent L0 (fun i : t => ((i : algebraicClosure F L) : L)) :=
    (LinearIndependent.iff_fractionRing (Algebra.adjoin F (Set.range ((↑) : s → L))) L0).mp h1
  simpa using h2.fintype_card_le_finrank

private theorem finiteType_of_isIntegral_adjoin {R S L : Type*} [CommRing R] [CommRing S]
    [Algebra R S]
    [Field L] [Algebra R L] (hR : IsNagataRing R) [Algebra.EssFiniteType R L] (Ψ : S →ₐ[R] L)
    (hΨ : Function.Injective Ψ) (g : Finset S)
    (hint : ∀ s : S, _root_.IsIntegral (Algebra.adjoin R (g : Set S)) s) :
    Algebra.FiniteType R S := by
  classical
  set C := Algebra.adjoin R (g : Set S)
  have hCft : Algebra.FiniteType R C := Algebra.FiniteType.adjoin_of_finite g.finite_toSet
  have hCN : IsNagataRing C := IsNagataRing.of_finiteType hR
  have : IsDomain S := hΨ.isDomain Ψ.toRingHom
  let : Algebra C L := (Ψ.toRingHom.comp (algebraMap C S)).toAlgebra
  have hinj : Function.Injective (algebraMap C L) :=
    hΨ.comp (Subtype.val_injective)
  have : FaithfulSMul C L := (faithfulSMul_iff_algebraMap_injective C L).mpr hinj
  let : Algebra (FractionRing C) L := FractionRing.liftAlgebra C L
  have : IsScalarTower C (FractionRing C) L := FractionRing.isScalarTower_liftAlgebra C L
  have : IsScalarTower R (FractionRing C) L := by
    refine IsScalarTower.of_algebraMap_eq fun r => ?_
    rw [IsScalarTower.algebraMap_apply R C (FractionRing C),
      ← IsScalarTower.algebraMap_apply C (FractionRing C) L]
    change _ = Ψ (algebraMap C S (algebraMap R C r))
    rw [← IsScalarTower.algebraMap_apply R C S, Ψ.commutes]
  have : Algebra.EssFiniteType (FractionRing C) L := Algebra.EssFiniteType.of_comp R _ L
  have : FiniteDimensional (FractionRing C) (algebraicClosure (FractionRing C) L) :=
    finiteDimensional_algebraicClosure
  have hfin := module_finite_integralClosure_of_isNagataRing (A := C) (FractionRing C)
    (algebraicClosure (FractionRing C) L) hCN
  set E := algebraicClosure (FractionRing C) L
  have hmemE : ∀ s : S, Ψ s ∈ E := fun s => by
    rw [mem_algebraicClosure_iff]
    have h1 : _root_.IsIntegral C (Ψ s) := by
      let ΨC : S →ₐ[C] L := { Ψ.toRingHom with commutes' := fun _ => rfl }
      exact (hint s).map ΨC
    exact (h1.tower_top (A := FractionRing C)).isAlgebraic
  have hintE : ∀ s : S, IsIntegral C (⟨Ψ s, hmemE s⟩ : E) := fun s => by
    let ΨC : S →ₐ[C] E :=
      { toFun := fun s => ⟨Ψ s, hmemE s⟩
        map_one' := Subtype.ext (map_one Ψ)
        map_mul' := fun a b => Subtype.ext (map_mul Ψ a b)
        map_zero' := Subtype.ext (map_zero Ψ)
        map_add' := fun a b => Subtype.ext (map_add Ψ a b)
        commutes' := fun _ => rfl }
    exact (hint s).map ΨC
  let f : S →ₗ[C] integralClosure C E :=
    { toFun := fun s => ⟨⟨Ψ s, hmemE s⟩, hintE s⟩
      map_add' := fun a b => by ext; simp
      map_smul' := fun c a => by
        ext
        change Ψ (c • a) = (algebraMap C L c) * Ψ a
        rw [Algebra.smul_def, map_mul]
        rfl }
  have hf : Function.Injective f := fun a b h => hΨ (by
    simpa [f] using congrArg (fun z : integralClosure C E => ((z : E) : L)) h)
  have : Module.Finite C S := Module.Finite.of_injective f hf
  exact Algebra.FiniteType.trans hCft (Module.Finite.finiteType (R := C) S)

private theorem fromSpecResidueField_comp_eq {M Z : Scheme} (π : M ⟶ Z) {U : Z.Opens}
    (hU : IsAffineOpen U) (y : M) (hy : y ∈ π ⁻¹ᵁ U) :
    M.fromSpecResidueField y ≫ π = Spec.map (π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) y hy ≫
      M.residue y) ≫ hU.fromSpec := by
  rw [Scheme.fromSpecResidueField, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
    ← hU.fromSpecStalk_eq_fromSpecStalk (x := π y) hy]
  dsimp only [IsAffineOpen.fromSpecStalk]
  simp only [← Category.assoc, ← Spec.map_comp]
  congr 2
  exact congrArg (· ≫ M.residue y) (Scheme.Hom.germ_stalkMap π U y hy)

private theorem exists_center_of_valuationSubring {M Z : Scheme} (π : M ⟶ Z) [UniversallyClosed π]
    {U : Z.Opens} (hU : IsAffineOpen U) (y : M) (hy : y ∈ π ⁻¹ᵁ U)
    (V : ValuationSubring (M.residueField y))
    (hV : ∀ r : Γ(Z, U), M.residue y (M.presheaf.germ (π ⁻¹ᵁ U) y hy (π.app U r)) ∈ V) :
    ∃ (x : M) (h : y ⤳ x), x ∈ π ⁻¹ᵁ U ∧
      ∀ t : M.presheaf.stalk x, M.residue y (M.presheaf.stalkSpecializes h t) ∈ V := by
  let K := M.residueField y
  let ρ : Γ(Z, U) ⟶ K := π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) y hy ≫ M.residue y
  let φV : Γ(Z, U) ⟶ CommRingCat.of V :=
    CommRingCat.ofHom (ρ.hom.codRestrict V.toSubring hV)
  have hφ : φV ≫ CommRingCat.ofHom (algebraMap V K) = ρ := by
    ext; rfl
  have w : M.fromSpecResidueField y ≫ π =
      Spec.map (CommRingCat.ofHom (algebraMap V K)) ≫ (Spec.map φV ≫ hU.fromSpec) := by
    rw [fromSpecResidueField_comp_eq π hU y hy, ← Spec.map_comp_assoc, hφ]
  have H : ValuativeCriterion.Existence π :=
    (UniversallyClosed.eq_valuativeCriterion ▸ (inferInstance : UniversallyClosed π) :
      (ValuativeCriterion.Existence ⊓ @QuasiCompact) π).1
  obtain ⟨l, hl₁, hl₂⟩ :=
    (H (ValuativeCommSq.mk (R := V) (K := K) (M.fromSpecResidueField y)
      (Spec.map φV ≫ hU.fromSpec) ⟨w⟩)).exists_lift
  dsimp only at hl₁ hl₂
  let x := l (IsLocalRing.closedPoint V)
  have hyx : y ⤳ x := by
    simp_rw [x, ← Scheme.fromSpecResidueField_apply y (IsLocalRing.closedPoint K), ← hl₁]
    exact (IsLocalRing.specializes_closedPoint _).map l.continuous
  have hxU : x ∈ π ⁻¹ᵁ U := by
    have h2 := congrArg (fun h : Spec (CommRingCat.of V) ⟶ Z => h (IsLocalRing.closedPoint V)) hl₂
    change (l ≫ π) (IsLocalRing.closedPoint V) ∈ U
    rw [h2, ← SetLike.mem_coe, ← hU.range_fromSpec]
    exact ⟨_, rfl⟩
  refine ⟨x, hyx, hxU, fun t => ?_⟩
  let ψ : M.presheaf.stalk x ⟶ CommRingCat.of V := Scheme.stalkClosedPointTo l
  have hl : Spec.map ψ ≫ M.fromSpecStalk x = l := Scheme.Spec_stalkClosedPointTo_fromSpecStalk l
  have heq : ψ ≫ CommRingCat.ofHom (algebraMap V K) =
      M.presheaf.stalkSpecializes hyx ≫ M.residue y := by
    apply Spec.map_injective
    apply (cancel_mono (M.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, hl, hl₁, Spec.map_comp, Category.assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    rfl
  have hval : algebraMap V K (ψ t) = M.residue y (M.presheaf.stalkSpecializes hyx t) :=
    congrArg (fun g => g.hom t) heq
  rw [← hval]
  exact (ψ t).2

private theorem exists_pow_smul_eq_restrict {X : Scheme.{0}} (F : X.Modules) [F.IsQuasicoherent]
    {U : X.Opens} (hU : IsAffineOpen U) (g : Γ(X, U)) (σ : Γ(F, X.basicOpen g)) :
    ∃ (m : ℕ) (a : Γ(F, U)), F.presheaf.map (homOfLE (X.basicOpen_le g)).op a =
      (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) ^ m • σ := by
  let _ : Module Γ(X, U) Γ(F, X.basicOpen g) :=
    Module.compHom _ (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom
  have : IsScalarTower Γ(X, U) Γ(X, X.basicOpen g) Γ(F, X.basicOpen g) :=
    ⟨fun r s m => by
      change ((X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom r • s) • m = _
      rw [smul_assoc]
      rfl⟩
  let ρ : Γ(F, U) →ₗ[Γ(X, U)] Γ(F, X.basicOpen g) :=
    { toFun := fun a => F.presheaf.map (homOfLE (X.basicOpen_le g)).op a
      map_add' := fun a b => map_add _ a b
      map_smul' := fun r a => (Scheme.Modules.map_smul F (homOfLE (X.basicOpen_le g)) r a) }
  have hloc := isLocalizedModule_restrict_basicOpen F hU g ρ (fun _ => rfl)
  obtain ⟨⟨a, ⟨_, m, rfl⟩⟩, h⟩ := hloc.surj σ
  refine ⟨m, a, ?_⟩
  change ρ a = _
  rw [← h]
  change (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom (g ^ m) • σ = _
  rw [map_pow]

section Generation

variable {M Z : Scheme.{0}} [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} {D : Divisor M}
  (A : DivisorialSectionAlgebra π D)

private theorem ordGE_pow {E : MMP.Mori.PrimeDivisor M} {m : ℤ}
    {f : M.presheaf.stalk (componentGenericPoint M E.component)} (hf : E.OrdGE m f) (n : ℕ) :
    E.OrdGE (n * m) (f ^ n) := by
  induction n with
  | zero => exact Or.inr (by simp)
  | succ n ih =>
    rw [pow_succ]
    convert ih.mul hf using 2
    push_cast
    ring

private theorem exists_stalk_mul_pow_eq {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U))
    {x : M} (hx : x ∈ A.generatingLocus zero_le_one a) {Y : irreducibleComponents M}
    (hxY : x ∈ Y.1) (hY : componentGenericPoint M Y ∈ π ⁻¹ᵁ U) (n : ℕ)
    (t : (A.algebra.piece (n : ℤ)).val.obj (op U)) :
    ∃ r : M.presheaf.stalk x, (stalkToRationalFunctions M hxY).hom r *
        ((A.sectionEquiv 1 zero_le_one U a :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y, hY⟩) ^ n =
      (A.sectionEquiv n (Int.natCast_nonneg n) U t :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y, hY⟩ := by
  obtain ⟨W, ⟨hWU, b, hb, hab⟩, hxW⟩ := TopologicalSpace.Opens.mem_sSup.mp hx
  set tK := (A.sectionEquiv n (Int.natCast_nonneg n) U t :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))
  let φ : (rationalFunctionsPresheaf M).obj (op W) :=
    (rationalFunctionsPresheaf M).map (homOfLE hWU).op tK * b ^ n
  have hφ : (0 : Divisor M).IsDivisorialSection W φ := by
    intro E hE
    have h1 := (A.sectionEquiv n (Int.natCast_nonneg n) U t).2 E
      (hE.mono (Set.inter_subset_inter_right _ hWU))
    convert h1.mul (ordGE_pow (hb E hE) n) using 1
    · simp [DivisorWithCoeffs.coeff_smul]
    · rfl
  have hYW : componentGenericPoint M Y ∈ W := (genericPoint_mem_iff Y W).mpr ⟨x, hxW, hxY⟩
  obtain ⟨r, hr⟩ := hφ.exists_stalk_eq hxW hxY
  refine ⟨r, ?_⟩
  rw [hr]
  change tK ⟨Y, _⟩ * b ⟨Y, hYW⟩ ^ n * _ = tK ⟨Y, hY⟩
  have hab'' : (A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y, hY⟩ * b ⟨Y, hYW⟩ = 1 :=
    congrFun hab ⟨Y, hYW⟩
  calc tK ⟨Y, _⟩ * b ⟨Y, hYW⟩ ^ n * _ = tK ⟨Y, hY⟩ * ((A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y, hY⟩ * b ⟨Y, hYW⟩) ^ n := by ring
    _ = tK ⟨Y, hY⟩ := by rw [hab'', one_pow, mul_one]

private theorem exists_mem_generatingLocus [IsIntegral M] [CompactSpace M] (hDC : D.IsCartier)
    (hfree : IsRelativelyFreeDivisor π D) {U : Z.Opens} (hU : IsAffineOpen U) {x : M}
    (hx : x ∈ π ⁻¹ᵁ U) :
    ∃ a : (A.algebra.piece (1 : ℤ)).val.obj (op U), x ∈ A.generatingLocus zero_le_one a := by
  classical
  obtain ⟨U', hxU', ψ, hA, hB⟩ := exists_coeff_add_ord_eq_zero_of_isRelativelyFree π hDC hfree x
  obtain ⟨g, hgle, hxg⟩ := hU.exists_basicOpen_le (V := U ⊓ U') ⟨π x, hx, hxU'⟩ hx
  set Dg := Z.basicOpen g with hDg
  have hDgU : Dg ≤ U := Z.basicOpen_le g
  let ψK : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ Dg)) :=
    fun Y => (ψ : RationalFunctions M) Y.1
  have hψK : ψK ∈ ((1 : ℤ) • D).divisorialSubmodule (π ⁻¹ᵁ Dg) := by
    intro E hE
    refine Or.inr ?_
    change WithZero.exp _ ≤ E.valuation ((ψ : RationalFunctions M) E.component)
    rw [E.valuation_component, WithZero.exp_le_exp]
    have := hA E (hE.mono (Set.inter_subset_inter_right _
      (π.preimage_mono (hgle.trans inf_le_right))))
    simp only [one_smul]
    linarith
  let σ := (A.sectionEquiv 1 zero_le_one Dg).symm ⟨ψK, hψK⟩
  have := A.isQuasicoherent 1
  obtain ⟨m, a, ha⟩ := exists_pow_smul_eq_restrict (A.algebra.piece (1 : ℤ)) hU g σ
  refine ⟨a, ?_⟩
  have hres := A.sectionEquiv_restrict 1 zero_le_one hDgU a
  set gD := Z.presheaf.map (homOfLE (Z.basicOpen_le g)).op g
  have hkey : (rationalFunctionsPresheaf M).map (homOfLE (π.preimage_mono hDgU)).op
      (A.sectionEquiv 1 zero_le_one U a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) =
      π.app Dg (gD ^ m) • ψK := by
    have h1 := congrArg (fun z => (A.sectionEquiv 1 zero_le_one Dg z :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ Dg)))) ha
    simp only at h1
    calc _ = ((A.sectionEquiv 1 zero_le_one Dg
            ((A.algebra.piece 1).val.map (homOfLE hDgU).op a) :
            (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ Dg)))) := by rw [hres]; rfl
      _ = _ := h1
      _ = ((π.app Dg (gD ^ m) • A.sectionEquiv 1 zero_le_one Dg σ :
            ((1 : ℤ) • D).divisorialSubmodule (π ⁻¹ᵁ Dg)) :
            (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ Dg))) :=
            congrArg Subtype.val (A.sectionEquiv_smul 1 zero_le_one Dg (gD ^ m) σ)
      _ = _ := by simp only [σ, AddEquiv.apply_symm_apply]; rfl
  set v : Γ(M, π ⁻¹ᵁ Dg) := π.app Dg gD
  have hv : IsUnit v := (RingedSpace.isUnit_res_basicOpen Z.toRingedSpace g).map (π.app Dg).hom
  set w : Γ(M, π ⁻¹ᵁ Dg) := ((hv.unit⁻¹ : (Γ(M, π ⁻¹ᵁ Dg))ˣ) : Γ(M, π ⁻¹ᵁ Dg))
  have hvw : v * w = 1 := hv.mul_val_inv
  let E0 : Divisor M := principalDivisor ψ + (1 : ℤ) • D
  have hE0 : ∀ E, E0.coeff E = E.ord ψ + D.coeff E := fun E => by
    simp [E0, DivisorWithCoeffs.coeff_add]
  let W : M.Opens := π ⁻¹ᵁ Dg ⊓ ⟨(E0.supp : Set M)ᶜ, E0.isClosed_supp.isOpen_compl⟩
  have hWDg : W ≤ π ⁻¹ᵁ Dg := inf_le_left
  have hWU : W ≤ π ⁻¹ᵁ U := hWDg.trans (π.preimage_mono hDgU)
  have hxW : x ∈ W := by
    refine ⟨hxg, fun h => ?_⟩
    obtain ⟨E, hne, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
    apply hne
    rw [hE0, add_comm]
    exact hB E hxE
  let β : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ Dg)) :=
    fun Y => M.presheaf.germ (π ⁻¹ᵁ Dg) _ Y.2 (w ^ m) * ((ψ⁻¹ : (RationalFunctions M)ˣ) :
      RationalFunctions M) Y.1
  let b := (rationalFunctionsPresheaf M).map (homOfLE hWDg).op β
  have hb : b ∈ (-((1 : ℤ) • D)).divisorialSubmodule W := by
    intro E hE
    have hcoeff : E0.coeff E = 0 := by
      by_contra hne
      obtain ⟨y, hyE, hyW⟩ := hE
      exact hyW.2 (DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, hne, hyE⟩)
    rw [hE0] at hcoeff
    have h1 := Divisor.isDivisorialSection_algebraMap (D := 0) le_rfl (w ^ m) E
      (hE.mono (Set.inter_subset_inter_right _ hWDg))
    have h2 : E.OrdGE (D.coeff E) (((ψ⁻¹ : (RationalFunctions M)ˣ) : RationalFunctions M)
        E.component) := by
      refine Or.inr ?_
      rw [E.valuation_component, WithZero.exp_le_exp, PrimeDivisor.ord_inv]
      linarith
    convert h1.mul h2 using 1
    · simp
    · rfl
  refine (le_sSup ⟨hWU, b, hb, ?_⟩ : W ≤ A.generatingLocus zero_le_one a) hxW
  funext Y
  have hY : componentGenericPoint M Y.1 ∈ π ⁻¹ᵁ Dg := hWDg Y.2
  have hk := congrFun hkey ⟨Y.1, hY⟩
  change (A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y.1, _⟩ * β ⟨Y.1, hY⟩ = 1
  rw [MMP.Mori.rationalFunctions_smul_apply] at hk
  have hk' : (A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y.1, hWU Y.2⟩ =
      M.presheaf.germ (π ⁻¹ᵁ Dg) _ hY (v ^ m) * (ψ : RationalFunctions M) Y.1 := by
    rwa [map_pow] at hk
  rw [hk']
  change _ * (M.presheaf.germ (π ⁻¹ᵁ Dg) _ hY (w ^ m) * ((ψ⁻¹ : (RationalFunctions M)ˣ) :
      RationalFunctions M) Y.1) = 1
  calc _ = M.presheaf.germ (π ⁻¹ᵁ Dg) _ hY ((v * w) ^ m) *
        (((ψ * ψ⁻¹ : (RationalFunctions M)ˣ) : RationalFunctions M) Y.1) := by
          rw [mul_pow, map_mul, Units.val_mul, Pi.mul_apply]; ring
    _ = 1 := by rw [hvw, one_pow, map_one, mul_inv_cancel, Units.val_one, Pi.one_apply, one_mul]

end Generation

/-- The residue field at a point over an affine open `U` of the base of a morphism locally of
finite type is essentially of finite type over `Γ(Z, U)`. -/
private theorem essFiniteType_residueField_of_mem {M Z : Scheme.{0}} (π : M ⟶ Z)
    [LocallyOfFiniteType π] {U : Z.Opens} (hU : IsAffineOpen U) (y : M) (hy : y ∈ π ⁻¹ᵁ U) :
    letI : Algebra Γ(Z, U) (M.residueField y) :=
      (π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) y hy ≫ M.residue y).hom.toAlgebra
    Algebra.EssFiniteType Γ(Z, U) (M.residueField y) := by
  obtain ⟨V, hV, hyV, hVU⟩ := exists_isAffineOpen_mem_and_subset (X := M) (x := y)
    (U := π ⁻¹ᵁ U) hy
  have e : V ≤ π ⁻¹ᵁ U := hVU
  let : Algebra Γ(Z, U) Γ(M, V) := (π.appLE U V e).hom.toAlgebra
  let : Algebra Γ(Z, U) (M.presheaf.stalk y) :=
    (π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) y hy).hom.toAlgebra
  let : Algebra Γ(M, V) (M.presheaf.stalk y) := (M.presheaf.germ V y hyV).hom.toAlgebra
  let : Algebra Γ(Z, U) (M.residueField y) :=
    (π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) y hy ≫ M.residue y).hom.toAlgebra
  let : Algebra (M.presheaf.stalk y) (M.residueField y) := (M.residue y).hom.toAlgebra
  have : IsScalarTower Γ(Z, U) Γ(M, V) (M.presheaf.stalk y) := by
    refine IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a ↦ ?_)
    change M.presheaf.germ (π ⁻¹ᵁ U) y hy (π.app U a) =
      M.presheaf.germ V y hyV (π.appLE U V e a)
    rw [Scheme.Hom.appLE, CommRingCat.comp_apply, M.presheaf.germ_res_apply]
  have : IsScalarTower Γ(Z, U) (M.presheaf.stalk y) (M.residueField y) :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ ↦ rfl)
  have hft : Algebra.FiniteType Γ(Z, U) Γ(M, V) :=
    HasRingHomProperty.appLE @LocallyOfFiniteType π ‹_› ⟨U, hU⟩ ⟨V, hV⟩ e
  have : IsLocalization (hV.primeIdealOf ⟨y, hyV⟩).asIdeal.primeCompl
      (M.presheaf.stalk y) := hV.isLocalization_stalk ⟨y, hyV⟩
  have : Algebra.EssFiniteType Γ(M, V) (M.presheaf.stalk y) :=
    Algebra.EssFiniteType.of_isLocalization _ (hV.primeIdealOf ⟨y, hyV⟩).asIdeal.primeCompl
  have : Algebra.EssFiniteType Γ(Z, U) (M.presheaf.stalk y) :=
    Algebra.EssFiniteType.comp Γ(Z, U) Γ(M, V) (M.presheaf.stalk y)
  exact Algebra.EssFiniteType.of_surjective
    (IsScalarTower.toAlgHom Γ(Z, U) (M.presheaf.stalk y) (M.residueField y))
    (M.residue_surjective y)

/-- The sections of a variety over `ℂ` over an affine open form a Nagata ring. -/
private theorem isNagataRing_of_isVariety {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {U : Z.Opens} (hU : IsAffineOpen U) :
    IsNagataRing Γ(Z, U) := by
  have := hZ.toIsVariety
  let : Algebra ℂ Γ(Z, U) := ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sZ.appLE ⊤ U (by simp)).hom.toAlgebra
  have : Algebra.FiniteType ℂ Γ(Z, U) := by
    change RingHom.FiniteType ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sZ.appLE ⊤ U (by simp)).hom
    rw [CommRingCat.hom_comp]
    exact (HasRingHomProperty.appLE @LocallyOfFiniteType sZ inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ _).comp (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso _).symm.commRingCatIsoToRingEquiv.surjective)
  exact IsNagataRing.of_finiteType (A := ℂ) IsNagataRing.of_field

/-- **Over an affine open of the base, the section ring of a relatively free Cartier divisor
along a proper morphism is a finitely generated algebra.** -/
private theorem finiteType_sectionRingBaseMap {M Z : Scheme.{0}} [IsIntegral M] [CompactSpace M]
    [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} (hπ : IsProper π) {D : Divisor M}
    (hDC : D.IsCartier) (hfree : IsRelativelyFreeDivisor π D) (A : DivisorialSectionAlgebra π D)
    {U : Z.Opens} (hU : IsAffineOpen U) (hR : IsNagataRing Γ(Z, U)) :
    (show Γ(Z, U) →+* A.situation.sectionRing U from
      A.situation.sectionRingBaseMap U).FiniteType := by
  classical
  by_cases hne : ((π ⁻¹ᵁ U : M.Opens) : Set M).Nonempty
  swap
  · have hpiece : ∀ n (s : A.situation.sectionPieces U n), s = 0 := fun n s =>
      (A.sectionEquiv n (Int.natCast_nonneg n) U).injective (by
        rw [map_zero]
        exact Subtype.ext (funext fun Y => (hne ⟨_, Y.2⟩).elim))
    have : Subsingleton (A.situation.sectionRing U) :=
      ⟨fun x y => DFinsupp.ext fun n => (hpiece n _).trans (hpiece n _).symm⟩
    exact RingHom.FiniteType.of_surjective _ fun s => ⟨0, Subsingleton.elim _ _⟩
  obtain ⟨x0, hx0⟩ := hne
  obtain ⟨Y0, -⟩ := MMP.Mori.exists_mem_irreducibleComponents x0
  have hY0univ : ∀ x : M, x ∈ Y0.1 := fun x => by
    rw [(irreducibleComponents_eq_singleton (X := M)).le Y0.2]; trivial
  have hall : ∀ Y : irreducibleComponents M, Y = Y0 := fun Y =>
    Subtype.ext (((irreducibleComponents_eq_singleton (X := M)).le Y.2).trans
      ((irreducibleComponents_eq_singleton (X := M)).le Y0.2).symm)
  set η := componentGenericPoint M Y0
  have hη : η ∈ π ⁻¹ᵁ U := (genericPoint_mem_iff Y0 _).mpr ⟨x0, hx0, hY0univ x0⟩
  have hι : Function.Injective (M.residue η).hom := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    have h1 : c ∈ IsLocalRing.maximalIdeal _ := (IsLocalRing.residue_eq_zero_iff c).mp hc
    rwa [IsLocalRing.isField_iff_maximalIdeal_eq.mp (RationalFunctions.isField_stalk M Y0)] at h1
  let K := M.residueField η
  let evK : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)) →+* K :=
    (M.residue η).hom.comp (Pi.evalRingHom (fun Y : {Y : irreducibleComponents M //
      componentGenericPoint M Y ∈ π ⁻¹ᵁ U} => M.presheaf.stalk (componentGenericPoint M Y.1))
      ⟨Y0, hη⟩)
  have hevK : Function.Injective evK := by
    intro c d h
    funext Y
    obtain rfl : Y = ⟨Y0, hη⟩ := Subtype.ext (hall Y.1)
    exact hι h
  let L := FractionRing (Polynomial K)
  let Ψ0 : A.situation.sectionRing U →+* L :=
    (algebraMap (Polynomial K) L).comp ((Polynomial.mapRingHom evK).comp (toPoly A U))
  have hΨ0 : Function.Injective Ψ0 := (IsFractionRing.injective (Polynomial K) L).comp
    ((Polynomial.map_injective _ hevK).comp (injective_toPoly A U))
  have hΨof : ∀ n (s : A.situation.sectionPieces U n),
      Ψ0 (DirectSum.of _ n s) = algebraMap K L (evK (A.sectionEquiv n (Int.natCast_nonneg n) U s :
        (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))) *
        algebraMap (Polynomial K) L Polynomial.X ^ n := by
    intro n s
    change algebraMap (Polynomial K) L (Polynomial.map evK (toPoly A U (DirectSum.of _ n s))) = _
    rw [show toPoly A U (DirectSum.of _ n s) = pieceHom A U n s from
      DirectSum.toSemiring_of _ _ _ _ _, pieceHom_apply, Polynomial.map_monomial,
      ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
      IsScalarTower.algebraMap_apply K (Polynomial K) L]
    rfl
  let ρ : Γ(Z, U) →+* K := (π.app U ≫ M.presheaf.germ (π ⁻¹ᵁ U) η hη ≫ M.residue η).hom
  have hΨbase : ∀ r, Ψ0 (A.situation.sectionRingBaseMap U r) = algebraMap K L (ρ r) := by
    intro r
    rw [show A.situation.sectionRingBaseMap U r =
      DirectSum.of _ 0 (r • A.algebra.one.eval (op U)) from
        (A.situation.sectionRingStructure).baseMap_apply U r, hΨof, pow_zero, mul_one]
    congr 1
    have h1 := A.sectionEquiv_smul 0 le_rfl U r (A.algebra.one.eval (op U))
    have h2 := A.sectionEquiv_one U
    change M.residue η ((A.sectionEquiv 0 le_rfl U (r • A.algebra.one.eval (op U)) :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y0, hη⟩) = _
    rw [h1]
    change M.residue η ((π.app U r • (A.sectionEquiv 0 le_rfl U (A.algebra.one.eval (op U)) :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))) ⟨Y0, hη⟩) = _
    rw [MMP.Mori.rationalFunctions_smul_apply, h2]
    exact congrArg (M.residue η).hom (mul_one _)
  -- finitely many degree-one generators
  have hgen : ∀ x : (π ⁻¹ᵁ U : M.Opens), ∃ a : (A.algebra.piece (1 : ℤ)).val.obj (op U),
      x.1 ∈ A.generatingLocus zero_le_one a := fun x =>
    exists_mem_generatingLocus A hDC hfree hU x.2
  choose a ha using hgen
  have : IsNoetherian M := {}
  have hcomp : IsCompact ((π ⁻¹ᵁ U : M.Opens) : Set M) :=
    TopologicalSpace.NoetherianSpace.isCompact _
  obtain ⟨T, hT⟩ := hcomp.elim_finite_subcover
    (fun x : (π ⁻¹ᵁ U : M.Opens) => ((A.generatingLocus zero_le_one (a x) : M.Opens) : Set M))
    (fun x => (A.generatingLocus zero_le_one (a x)).isOpen)
    (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, ha ⟨x, hx⟩⟩)
  have hcov : ∀ x ∈ π ⁻¹ᵁ U, ∃ y ∈ T, x ∈ A.generatingLocus zero_le_one (a y) := by
    intro x hx
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hT hx)
    exact ⟨y, hy, hxy⟩
  let g : Finset (A.situation.sectionRing U) :=
    T.image (fun y => DirectSum.of (A.situation.sectionPieces U) 1 (a y))
  -- the algebra structures
  let : Algebra Γ(Z, U) (A.situation.sectionRing U) := (A.situation.sectionRingBaseMap U).toAlgebra
  let : Algebra Γ(Z, U) K := ρ.toAlgebra
  have hRL : ∀ r, algebraMap Γ(Z, U) L r = algebraMap K L (ρ r) := fun r =>
    IsScalarTower.algebraMap_apply Γ(Z, U) K L r
  have : Algebra.EssFiniteType Γ(Z, U) K := essFiniteType_residueField_of_mem π hU η hη
  have : Algebra.EssFiniteType K L := by
    have : Algebra.EssFiniteType (Polynomial K) L :=
      Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors (Polynomial K))
    exact Algebra.EssFiniteType.comp K (Polynomial K) L
  have : Algebra.EssFiniteType Γ(Z, U) L := Algebra.EssFiniteType.comp Γ(Z, U) K L
  let Ψ : A.situation.sectionRing U →ₐ[Γ(Z, U)] L :=
    { Ψ0 with commutes' := fun r => (hΨbase r).trans (hRL r).symm }
  have hint : ∀ s : A.situation.sectionRing U,
      _root_.IsIntegral (Algebra.adjoin Γ(Z, U) (g : Set (A.situation.sectionRing U))) s := by
    set C := Algebra.adjoin Γ(Z, U) (g : Set (A.situation.sectionRing U)) with hC
    let : Algebra C L := (Ψ0.comp (algebraMap C (A.situation.sectionRing U))).toAlgebra
    let ΨC : A.situation.sectionRing U →ₐ[C] L := { Ψ0 with commutes' := fun _ => rfl }
    let Xb := algebraMap (Polynomial K) L Polynomial.X
    have hXb : Xb ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (Polynomial K) L)).mpr Polynomial.X_ne_zero
    let e : (π ⁻¹ᵁ U : M.Opens) → K := fun y => evK (A.sectionEquiv 1 zero_le_one U (a y) :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)))
    have hΨa : ∀ y, Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a y)) =
        algebraMap K L (e y) * Xb := fun y => (hΨof 1 (a y)).trans (by rw [pow_one]; rfl)
    have he_ne : ∀ y (x : M), x ∈ A.generatingLocus zero_le_one (a y) → e y ≠ 0 := by
      intro y x hx he
      obtain ⟨W, ⟨hWU, b, hb, hab⟩, hxW⟩ := TopologicalSpace.Opens.mem_sSup.mp hx
      have hYW : η ∈ W := (genericPoint_mem_iff Y0 W).mpr ⟨x, hxW, hY0univ x⟩
      have h0 : (A.sectionEquiv 1 zero_le_one U (a y) :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y0, hη⟩ = 0 :=
        hι (he.trans (map_zero _).symm)
      have h1' : (A.sectionEquiv 1 zero_le_one U (a y) :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y0, hη⟩ * b ⟨Y0, hYW⟩ = 1 :=
        congrFun hab ⟨Y0, hYW⟩
      rw [h0, zero_mul] at h1'
      exact zero_ne_one h1'
    have hhom : ∀ n (s : A.situation.sectionPieces U n),
        _root_.IsIntegral C (DirectSum.of (A.situation.sectionPieces U) n s) := by
      intro n s
      rw [← isIntegral_algHom_iff ΨC hΨ0]
      refine AlgebraicGeometry.isIntegralElem_of_forall_valuationSubring (algebraMap C L)
        fun V hV => ?_
      have hVC : ∀ c : C, Ψ0 c ∈ V := fun c => hV ⟨c, rfl⟩
      have hVg : ∀ y ∈ T, Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a y)) ∈ V :=
        fun y hy => hVC ⟨_, Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hy))⟩
      have hVR : ∀ r, algebraMap K L (ρ r) ∈ V := fun r => by
        have h := hVC (algebraMap Γ(Z, U) C r)
        change Ψ0 (A.situation.sectionRingBaseMap U r) ∈ V at h
        exact (congrArg (· ∈ V) (hΨbase r)).mp h
      obtain ⟨y1, hy1T, hy1⟩ := hcov x0 hx0
      have hne : (T.filter (fun y => e y ≠ 0)).Nonempty :=
        ⟨y1, Finset.mem_filter.mpr ⟨hy1T, he_ne y1 x0 hy1⟩⟩
      obtain ⟨i0, hi0, hmax⟩ := Finset.exists_max_image _
        (fun y => V.valuation (Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a y)))) hne
      have hi0T := (Finset.mem_filter.mp hi0).1
      have he0 := (Finset.mem_filter.mp hi0).2
      let V0 := V.comap (algebraMap K L)
      have hratio : ∀ y ∈ T, e y / e i0 ∈ V0 := by
        intro y hy
        by_cases hey : e y = 0
        · rw [hey, zero_div]; exact V0.zero_mem
        change algebraMap K L (e y / e i0) ∈ V
        have hq : algebraMap K L (e y / e i0) =
            Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a y)) /
              Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a i0)) := by
          rw [hΨa, hΨa, map_div₀, mul_div_mul_right _ _ hXb]
        rw [hq, ← ValuationSubring.valuation_le_one_iff, map_div₀]
        have hden : V.valuation (Ψ0 (DirectSum.of (A.situation.sectionPieces U) 1 (a i0))) ≠ 0 := by
          rw [Valuation.ne_zero_iff, hΨa]
          exact mul_ne_zero ((map_ne_zero _).mpr he0) hXb
        exact (div_le_one₀ (zero_lt_iff.mpr hden)).mpr (hmax y (Finset.mem_filter.mpr ⟨hy, hey⟩))
      obtain ⟨x, hηx, hxU, hstalk⟩ :=
        exists_center_of_valuationSubring π hU η hη V0 hVR
      obtain ⟨i, hiT, hxi⟩ := hcov x hxU
      obtain ⟨r, hr⟩ := exists_stalk_mul_pow_eq A (a i) hxi (hY0univ x) hη n s
      have hs : evK (A.sectionEquiv n (Int.natCast_nonneg n) U s :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) =
          M.residue η ((stalkToRationalFunctions M (hY0univ x)).hom r) * e i ^ n := by
        change M.residue η ((A.sectionEquiv n (Int.natCast_nonneg n) U s :
          (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ⟨Y0, hη⟩) = _
        rw [← hr, map_mul, map_pow]
        rfl
      change Ψ0 (DirectSum.of (A.situation.sectionPieces U) n s) ∈ V
      rw [hΨof, hs]
      have hdec : algebraMap K L (M.residue η ((stalkToRationalFunctions M (hY0univ x)).hom r) *
          e i ^ n) * Xb ^ n =
          algebraMap K L (M.residue η ((stalkToRationalFunctions M (hY0univ x)).hom r)) *
            (algebraMap K L (e i / e i0)) ^ n * (algebraMap K L (e i0) * Xb) ^ n := by
        have h3 : algebraMap K L (e i / e i0) * (algebraMap K L (e i0) * Xb) =
            algebraMap K L (e i) * Xb := by
          rw [← mul_assoc, ← map_mul, div_mul_cancel₀ _ he0]
        rw [mul_assoc (algebraMap K L _), ← mul_pow, h3, mul_pow, map_mul, map_pow, mul_assoc]
      rw [hdec]
      have hu : algebraMap K L
          (M.residue η ((stalkToRationalFunctions M (hY0univ x)).hom r)) ∈ V := hstalk r
      have hr' : algebraMap K L (e i / e i0) ∈ V := hratio i hiT
      have h0' : algebraMap K L (e i0) * Xb ∈ V := (hΨa i0) ▸ hVg i0 hi0T
      exact mul_mem (mul_mem hu (pow_mem hr' n)) (pow_mem h0' n)
    intro s
    induction s using DirectSum.induction_on with
    | zero => exact isIntegral_zero
    | of n s => exact hhom n s
    | add x y hx hy => exact hx.add hy
  exact finiteType_of_isIntegral_adjoin hR Ψ hΨ0 g hint

/-- **The section algebra of a relatively free Cartier divisor along a projective morphism is of
finite type over the base.** -/
private theorem isFiniteTypeOverBase_situation {M Z : Scheme.{0}} [IsIntegral M] [CompactSpace M]
    [IsLocallyNoetherian M] [IsNormal M] {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {π : M ⟶ Z} (hπ : IsProjectiveMorphism π)
    {D : Divisor M} (hDC : D.IsCartier) (hfree : IsRelativelyFreeDivisor π D)
    (A : DivisorialSectionAlgebra π D) : A.situation.IsFiniteTypeOverBase := fun _ hU =>
  finiteType_sectionRingBaseMap (isProper_of_isProjectiveMorphism π hπ) hDC hfree A hU
    (isNagataRing_of_isVariety hZ hU)

section RelativeAmpleTwist

open TopologicalSpace AlgebraicGeometry.ProjectiveSpectrum.Proj

section Absolute

universe w

variable {A : Type w} {σ : Type w} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- On a quasi-compact `Proj 𝒜` some positive degree has its standard opens covering. -/
private theorem exists_pos_degreeOpen_eq_top_of_compactSpace
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)] :
    ∃ d : ℕ, 0 < d ∧ AlgebraicGeometry.Proj.degreeOpen 𝒜 d = ⊤ := by
  have hcompact : IsCompact ((⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) :
      Set (AlgebraicGeometry.Proj 𝒜)) := by
    rw [TopologicalSpace.Opens.coe_top]
    exact isCompact_univ
  obtain ⟨d, hd, s, hs, hcover⟩ :=
    AlgebraicGeometry.Proj.exists_common_degree_finite_basicOpen_cover 𝒜 ⊤ hcompact
  refine ⟨d, hd, top_le_iff.mp fun x _ => ?_⟩
  have hx : x ∈ ⨆ f ∈ s, AlgebraicGeometry.Proj.basicOpen 𝒜 f ⊓
      (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := by
    rw [← hcover]; trivial
  obtain ⟨f, hf⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨hfs, hxf⟩ := TopologicalSpace.Opens.mem_iSup.mp hf
  exact AlgebraicGeometry.Proj.basicOpen_le_degreeOpen 𝒜 (hs f hfs)
    (TopologicalSpace.Opens.mem_inf.mp hxf).1

private theorem ratioLocus_eq_top_of_degreeOpen_eq_top' {d : ℕ}
    (htop : AlgebraicGeometry.Proj.degreeOpen 𝒜 d = ⊤) :
    Stacks.AlgebraicGeometry.ProjShared.ratioLocus 𝒜 d = ⊤ :=
  top_le_iff.mp
    (htop ▸ Stacks.AlgebraicGeometry.ProjDegreeOpenSections.degreeOpen_le_ratioLocus 𝒜 d)

/-- `𝒪(d)` is invertible when the degree-`d` standard opens cover `Proj 𝒜`. -/
private theorem isInvertibleModule_twistingSheaf_of_degreeOpen {d : ℕ}
    (htop : AlgebraicGeometry.Proj.degreeOpen 𝒜 d = ⊤) :
    Stacks.Ample.IsInvertibleModule (AlgebraicGeometry.Proj 𝒜) (twistingSheaf 𝒜 (d : ℤ)) :=
  Stacks.AlgebraicGeometry.TwistMapsInvertible.isInvertibleModule_of_forall_exists_restrict_isoUnit
    _
    fun x => Stacks.AlgebraicGeometry.TwistMapsInvertible.exists_mem_restrict_isoUnit_twistingSheaf
      𝒜 (d := d) (n := 1) (c := (d : ℤ)) (one_mul _)
      ((ratioLocus_eq_top_of_degreeOpen_eq_top' 𝒜 htop).ge (TopologicalSpace.Opens.mem_top x))

private theorem isInvertible_twistingSheaf_of_degreeOpen {d : ℕ}
    (htop : AlgebraicGeometry.Proj.degreeOpen 𝒜 d = ⊤) :
    _root_.AlgebraicGeometry.SheafOfModules.IsInvertible
      (AlgebraicGeometry.Proj 𝒜).toRingedSpace.presheaf
      (structureSheafRing (AlgebraicGeometry.Proj 𝒜).toRingedSpace).property
      (twistingSheaf 𝒜 (d : ℤ)) := by
  have h :=
    Stacks.AlgebraicGeometry.ProjInvertibleLocus.isInvertible_twistingSheaf_of_ratioLocus_eq_top
      𝒜 (ratioLocus_eq_top_of_degreeOpen_eq_top' 𝒜 htop) 1
  rwa [mul_one] at h

private theorem mem_nonvanishingLocus_degreeSection_iff_of_eq' {d k : ℕ} (hk : k = 1 * d)
    (f : 𝒜 k) {x : ProjectiveSpectrum.top 𝒜}
    (hx : x ∈ Stacks.AlgebraicGeometry.ProjInvertibleLocus.whereInvertible 𝒜 d) :
    x ∈ Stacks.SheafOfModules.nonvanishingLocus
        (X := (AlgebraicGeometry.Proj 𝒜).toRingedSpace) (twistingSheaf 𝒜 (k : ℤ))
        (Stacks.SheafOfModules.sectionsOfTop _ (degreeSection 𝒜 k f)) ↔
      x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (f : A) := by
  subst hk
  exact Stacks.AlgebraicGeometry.ProjInvertibleLocus.mem_nonvanishingLocus_degreeSection_iff
    𝒜 d 1 f hx

/-- `𝒪(d)` is ample on a quasi-compact `Proj 𝒜` when `d > 0` and the degree-`d` standard opens
cover. -/
private theorem isAmple_twistingSheaf_of_degreeOpen [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    {d : ℕ} (hd : 0 < d) (htop : AlgebraicGeometry.Proj.degreeOpen 𝒜 d = ⊤) :
    letI := isInvertibleModule_twistingSheaf_of_degreeOpen 𝒜 htop
    Stacks.Ample.IsAmple (AlgebraicGeometry.Proj 𝒜) (twistingSheaf 𝒜 (d : ℤ)) := by
  let _ := isInvertibleModule_twistingSheaf_of_degreeOpen 𝒜 htop
  refine (Stacks.AmpleBridge.isAmple_iff_isAmple _
    (Stacks.ProjTwistSection.twistingModule 𝒜 (d : ℤ))).mpr ?_
  let _ := isInvertible_twistingSheaf_of_degreeOpen 𝒜 htop
  let _ : Stacks.SheafOfModules.IsInvertible
      (AlgebraicGeometry.Proj 𝒜).toRingedSpace.presheaf
      (structureSheafRing (AlgebraicGeometry.Proj 𝒜).toRingedSpace).property
      (twistingSheaf 𝒜 (d : ℤ)) :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry _ _ _).mpr inferInstance
  refine AlgebraicGeometry.Scheme.Modules.isAmple_of_forall_exists_affine_nonvanishingOpen
    _ _ inferInstance fun x => ?_
  obtain ⟨g, hxg⟩ := TopologicalSpace.Opens.mem_iSup.mp
    (htop ▸ TopologicalSpace.Opens.mem_top x :
      x ∈ AlgebraicGeometry.Proj.degreeOpen 𝒜 d)
  have key : Stacks.SheafOfModules.nonvanishingOpen
        (X := (AlgebraicGeometry.Proj 𝒜).toRingedSpace)
        (twistingSheaf 𝒜 (d : ℤ)) (Stacks.ProjTwistSection.homogeneousSection 𝒜 (g : A) g.2)
      = AlgebraicGeometry.Proj.basicOpen 𝒜 (g : A) := by
    ext y
    exact mem_nonvanishingLocus_degreeSection_iff_of_eq' 𝒜 (one_mul d).symm g
      (Stacks.AlgebraicGeometry.ProjDegreeOpenSections.degreeOpen_le_whereInvertible 𝒜 d
        (htop ▸ TopologicalSpace.Opens.mem_top y))
  exact ⟨Stacks.ProjTwistSection.homogeneousSection 𝒜 (g : A) g.2, key.ge hxg,
    Eq.mp (congrArg (IsAffineOpen (X := AlgebraicGeometry.Proj 𝒜)) key).symm
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 (g : A) g.2 hd)⟩

end Absolute

section Relative

open Stacks.RelativeProj Stacks.RelativeProj.Situation

/-- Each chart of a relative `Proj` of a finite type algebra is quasi-compact. -/
private theorem compactSpace_proj_sectionRingGrading (s : Stacks.RelativeProj.Situation.{0})
    (h₀ : SheafOfModules.IsFiniteType (s.algebra.piece 0)) (hb : s.IsFiniteTypeOverBase)
    (W : s.base.affineOpens) :
    CompactSpace (AlgebraicGeometry.Proj (s.sectionRingGrading W.1)) := by
  have hdz := ((isFiniteType_and_isFiniteTypeOverDegreeZero_iff (s := s)).mpr ⟨h₀, hb⟩).2
  have := hdz W.1 W.2
  exact (quasiCompact_iff_compactSpace (AlgebraicGeometry.Proj.toSpecZero _)).mp inferInstance

/-- Over a quasi-compact base there are a finite cover by affine opens and a common positive
degree whose standard opens cover every chart of the cover. -/
private theorem exists_finset_affineOpens_degreeOpen_eq_top
    (s : Stacks.RelativeProj.Situation.{0}) [CompactSpace s.base]
    (hc : ∀ W : s.base.affineOpens,
      CompactSpace (AlgebraicGeometry.Proj (s.sectionRingGrading W.1))) :
    ∃ d : ℕ, 0 < d ∧ ∃ ι : Finset s.base.affineOpens, (∀ x : s.base, ∃ W ∈ ι, x ∈ W.1) ∧
      ∀ W ∈ ι, AlgebraicGeometry.Proj.degreeOpen (s.sectionRingGrading W.1) d = ⊤ := by
  classical
  obtain ⟨ι, hι⟩ := isCompact_univ.elim_finite_subcover
    (fun W : s.base.affineOpens => ((W.1 : s.base.Opens) : Set s.base))
    (fun W => W.1.isOpen) (fun x _ => by
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset
        (X := s.base) (x := x) (U := ⊤) trivial
      exact Set.mem_iUnion.mpr ⟨⟨V, hV⟩, hxV⟩)
  have hd : ∀ W : s.base.affineOpens, ∃ d : ℕ, 0 < d ∧
      AlgebraicGeometry.Proj.degreeOpen (s.sectionRingGrading W.1) d = ⊤ := fun W => by
    have := hc W
    exact exists_pos_degreeOpen_eq_top_of_compactSpace _
  choose e he htop using hd
  refine ⟨∏ W ∈ ι, e W, Finset.prod_pos fun W _ => he W, ι, fun x => ?_, fun W hW => ?_⟩
  · obtain ⟨W, hW, hxW⟩ := Set.mem_iUnion₂.mp (hι (Set.mem_univ x))
    exact ⟨W, hW, hxW⟩
  · exact top_le_iff.mp (htop W ▸ AlgebraicGeometry.Proj.degreeOpen_le_of_dvd _
      (Finset.dvd_prod_of_mem e hW) (Finset.prod_pos fun W _ => he W))

open Stacks.AlgebraicGeometry in
/-- The twisting sheaf `𝒪(d)` of a relative `Proj` is invertible when the degree-`d` standard
opens cover the charts of an affine cover of the base. -/
private theorem isInvertibleModule_twistSheaf_of_cover (s : Stacks.RelativeProj.Situation.{0})
    {d : ℕ} {ι : Finset s.base.affineOpens} (hcov : ∀ x : s.base, ∃ W ∈ ι, x ∈ W.1)
    (htop : ∀ W ∈ ι, AlgebraicGeometry.Proj.degreeOpen (s.sectionRingGrading W.1) d = ⊤) :
    Stacks.Ample.IsInvertibleModule s.relativeProj (twistSheaf s (d : ℤ)) := by
  refine TwistMapsInvertible.isInvertibleModule_of_forall_exists_isoUnit_openImmersion _ fun x => ?_
  obtain ⟨W, hWι, hxW⟩ := hcov ((relativeProjToBase s).base x)
  have hmem : x ∈ (relativeProjChart s W).opensRange := by
    rw [← relativeProjToBase_preimage_eq_opensRange s W]
    exact hxW
  obtain ⟨y, hy⟩ := hmem
  obtain ⟨U, hyU, ⟨eU⟩⟩ :=
    Stacks.AlgebraicGeometry.TwistMapsInvertible.exists_mem_restrict_isoUnit_twistingSheaf
      (s.sectionRingGrading W.1) (d := d) (n := 1) (c := (d : ℤ)) (one_mul _)
      ((ratioLocus_eq_top_of_degreeOpen_eq_top' _ (htop W hWι)).ge
        (TopologicalSpace.Opens.mem_top y))
  refine ⟨U.toScheme, U.ι ≫ relativeProjChart s W, inferInstance, ⟨⟨y, hyU⟩, hy⟩, ⟨?_⟩⟩
  exact (Scheme.Modules.restrictFunctorComp U.ι (relativeProjChart s W)).app
      (twistSheaf s (d : ℤ)) ≪≫
    (Scheme.Modules.restrictFunctor U.ι).mapIso (twistSheafChartIso s (d : ℤ) W) ≪≫ eU
/-- **The relative `Proj` of a finite type quasi-coherent graded algebra over a quasi-compact
base has an invertible, relatively ample twisting sheaf `𝒪(d)`, `d > 0`.** -/
private theorem exists_pos_isRelativelyAmple_twistSheaf (s : Stacks.RelativeProj.Situation.{0})
    [CompactSpace s.base] (h₀ : SheafOfModules.IsFiniteType (s.algebra.piece 0))
    (hb : s.IsFiniteTypeOverBase) :
    ∃ d : ℕ, 0 < d ∧ ∃ hL : Stacks.Ample.IsInvertibleModule s.relativeProj (twistSheaf s (d : ℤ)),
      letI := hL
      Stacks.RelativeAmple.IsRelativelyAmple s.relativeProjToBase (twistSheaf s (d : ℤ)) := by
  have hc := compactSpace_proj_sectionRingGrading s h₀ hb
  obtain ⟨d, hd, ι, hcov, htop⟩ := exists_finset_affineOpens_degreeOpen_eq_top s hc
  have hL := isInvertibleModule_twistSheaf_of_cover s hcov htop
  refine ⟨d, hd, hL, ?_⟩
  refine Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple _ _
    (quasiCompact_relativeProjToBase s hc) fun x => ?_
  obtain ⟨W, hWι, hxW⟩ := hcov x
  refine ⟨W.1, W.2, hxW, ?_⟩
  set c := relativeProjChart s W with hc'
  set V := relativeProjToBase s ⁻¹ᵁ W.1 with hV
  have hrange : Set.range c.base = Set.range V.ι.base := by
    rw [Scheme.Opens.range_ι, hc']
    exact congrArg (fun U : s.relativeProj.Opens => (U : Set s.relativeProj))
      (relativeProjToBase_preimage_eq_opensRange s W).symm
  set φ := IsOpenImmersion.isoOfRangeEq c V.ι hrange with hφ
  have hfac : φ.hom ≫ V.ι = c := IsOpenImmersion.isoOfRangeEq_hom_fac c V.ι hrange
  have hfac' : φ.inv ≫ c = V.ι := (Iso.inv_comp_eq φ).mpr hfac.symm
  have := hc W
  have hinvC := isInvertibleModule_twistingSheaf_of_degreeOpen _ (htop W hWι)
  have hinvP : Stacks.Ample.IsInvertibleModule V.toScheme
      ((Scheme.Modules.pullback φ.inv).obj
        (twistingSheaf (s.sectionRingGrading W.1) (d : ℤ))) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback φ.inv.toLRSHom.toShHom _
  have hinvQ : Stacks.Ample.IsInvertibleModule V.toScheme
      ((Scheme.Modules.pullback V.ι).obj (twistSheaf s (d : ℤ))) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback V.ι.toLRSHom.toShHom _
  have hA := Stacks.AmplePullback.isAmple_modulePullback_of_isClosedImmersion φ.inv
    (twistingSheaf (s.sectionRingGrading W.1) (d : ℤ))
    (isAmple_twistingSheaf_of_degreeOpen _ hd (htop W hWι))
  have e₁ : (Scheme.Modules.pullback c).obj (twistSheaf s (d : ℤ)) ≅
      twistingSheaf (s.sectionRingGrading W.1) (d : ℤ) :=
    ((Scheme.Modules.restrictFunctorIsoPullback c).app (twistSheaf s (d : ℤ))).symm ≪≫
      twistSheafChartIso s (d : ℤ) W
  have e := (Scheme.Modules.pullback φ.inv).mapIso e₁.symm ≪≫
    (Scheme.Modules.pullbackComp φ.inv c).app (twistSheaf s (d : ℤ)) ≪≫
    (Scheme.Modules.pullbackCongr hfac').app (twistSheaf s (d : ℤ))
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mp hA

end Relative

end RelativeAmpleTwist

/-- If `u ≫ p` is an open immersion for a dominant `u : U ⟶ V` into a reduced scheme and `p` is
separated, then `p` is an isomorphism over the image `O` of `u ≫ p`. -/
private theorem isIso_morphismRestrict {U V Z : Scheme.{u}} [IsReduced V] (p : V ⟶ Z)
    [IsSeparated p] (u : U ⟶ V) [IsOpenImmersion (u ≫ p)] [IsDominant u] :
    IsIso (p ∣_ (u ≫ p).opensRange) := by
  set O := (u ≫ p).opensRange
  let σ := (u ≫ p).isoOpensRange
  have hu : Set.range u ⊆ Set.range (p ⁻¹ᵁ O).ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact ⟨x, rfl⟩
  let u' : U ⟶ p ⁻¹ᵁ O := IsOpenImmersion.lift (p ⁻¹ᵁ O).ι u hu
  have hu' : u' ≫ (p ⁻¹ᵁ O).ι = u := IsOpenImmersion.lift_fac _ _ _
  have h1 : u' ≫ p ∣_ O = σ.hom := by
    rw [← cancel_mono O.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hu']
    exact (Scheme.Hom.isoOpensRange_hom_ι _).symm
  have : IsDominant u' := by
    have : IsDominant (u' ≫ (p ⁻¹ᵁ O).ι) := by rw [hu']; infer_instance
    exact IsDominant.of_comp_of_isOpenImmersion u' (p ⁻¹ᵁ O).ι
  let s' := σ.inv ≫ u'
  have h2 : s' ≫ p ∣_ O = 𝟙 _ := by simp [s', h1]
  refine ⟨s', ?_, h2⟩
  refine ext_of_isDominant_of_isSeparated (p ∣_ O)
    (by rw [Category.assoc, h2, Category.comp_id, Category.id_comp]) u' ?_
  simp [s', reassoc_of% h1]

/-- If `f : X ⟶ Z` is birational and `φ : X ⤏ M` is a birational map with `π ∘ φ = f`, then some
nonempty open subscheme of `M` maps to `Z` by an open immersion. -/
private theorem exists_isOpenImmersion_comp {X M Z : Scheme.{u}} [IrreducibleSpace X]
    {f : X ⟶ Z} (hf : IsBirationalMorphism f) {φ : X.RationalMap M}
    (hφ : RationalMap.IsBirational φ) {π : M ⟶ Z} (hover : φ.compHom π = f.toRationalMap) :
    ∃ (T : Scheme.{u}) (g : T ⟶ M), Nonempty T ∧ IsOpenImmersion g ∧
      IsOpenImmersion (g ≫ π) := by
  have : Nonempty X := IrreducibleSpace.toNonempty
  obtain ⟨W₁, hW₁, hW₁f⟩ := hf.exists_isOpenImmersion
  obtain ⟨eφ, rfl⟩ := hφ
  rw [Scheme.PartialIso.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.Hom.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff] at hover
  obtain ⟨W, hW, hWe, _, hWf⟩ := hover
  simp only [Scheme.PartialMap.restrict_hom, Scheme.PartialMap.compHom_hom,
    Scheme.PartialIso.toPartialMap_hom, Scheme.Hom.toPartialMap_hom] at hWf
  have hne : ((W ⊓ W₁ : X.Opens) : Set X).Nonempty := by
    simpa [Set.inter_comm] using hW.inter_open_nonempty _ W₁.isOpen hW₁
  have hWe' : W ≤ eφ.source := hWe
  refine ⟨(W ⊓ W₁ : X.Opens), X.homOfLE (inf_le_left.trans hWe') ≫ eφ.iso.hom ≫ eφ.target.ι,
    ⟨⟨_, hne.some_mem⟩⟩, inferInstance, ?_⟩
  have : (X.homOfLE (inf_le_left.trans hWe') ≫ eφ.iso.hom ≫ eφ.target.ι) ≫ π =
      X.homOfLE (inf_le_right : W ⊓ W₁ ≤ W₁) ≫ W₁.ι ≫ f := by
    calc _ = X.homOfLE (inf_le_left : W ⊓ W₁ ≤ W) ≫ X.homOfLE hWe' ≫
          (eφ.iso.hom ≫ eφ.target.ι) ≫ π := by
            simp only [Category.assoc, Scheme.homOfLE_homOfLE_assoc]
      _ = X.homOfLE (inf_le_left : W ⊓ W₁ ≤ W) ≫ X.homOfLE (le_top : W ≤ ⊤) ≫
          X.topIso.hom ≫ f := by
            rw [← Category.assoc (X.homOfLE hWe')]; exact congrArg (X.homOfLE _ ≫ ·) hWf
      _ = _ := by
            rw [Scheme.topIso_hom, Scheme.homOfLE_homOfLE_assoc, Scheme.homOfLE_ι_assoc,
              Scheme.homOfLE_ι_assoc]
  rw [this]
  infer_instance

section Descent

open MMP.Positivity

/-! ### Descending invertible sheaves and canonical divisors along `q` -/

/-- An invertible module on an integral, locally Noetherian, normal, quasi-compact scheme is the
divisorial sheaf of a Cartier divisor. -/
private theorem exists_isCartier_divisorialSheaf_iso {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (L : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y L] :
    ∃ D : Divisor Y, D.IsCartier ∧ Nonempty (D.divisorialSheaf ≅ L) := by
  have := Stacks.SheafOfModules.isInvertible_of_tensorInvertible (X := Y.toRingedSpace) L
  have : ∀ z : Y.toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk Y.toRingedSpace z) :=
    Y.isLocalRing
  choose W hW a ha using fun y : Y =>
    Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible (X := Y.toRingedSpace) L y
  obtain ⟨y₀⟩ : Nonempty Y := inferInstance
  let F : LocalFrame L :=
    { W := W, mem := hW, a := a, isLocalGenerator := fun y V hV => ha y V hV, base := y₀ }
  exact ⟨F.divisor, fun y => ⟨F.W y, F.mem y, _, F.isLocalEquation_divisor y⟩,
    ⟨(@asIso _ _ _ _ F.toDivisorialSheaf F.isIso_toDivisorialSheaf).symm⟩⟩

/-- The common core of the descent of an invertible sheaf: writing `H ≅ 𝒪_V(E)` with `E`
Cartier, `D' = q^* E - div(q^* ψ)` for a rational function `ψ` on `V`, and `q_* D' = E - div ψ`. -/
private theorem exists_eq_pullback_sub_principalDivisor {k : Type} [Field k] {M V : Scheme.{0}}
    [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    {sV : V ⟶ Spec (.of k)} (hV : IsNormalVariety k sV) {q : M ⟶ V}
    (hM : IsNormalVariety k (q ≫ sV)) [IsProper q] (hq : IsBirationalMorphism q)
    (H : V.Modules) [Stacks.Ample.IsInvertibleModule V H] {D' : Divisor M}
    (e : (Scheme.Modules.pullback q).obj H ≅ D'.divisorialSheaf) :
    ∃ (E : Divisor V) (hEc : E.IsCartier)
      (hB : ∀ Z : irreducibleComponents M, q (componentGenericPoint M Z) ∉ E.supp)
      (ψ : (RationalFunctions V)ˣ) (hψ : ∀ Z : irreducibleComponents M,
        q (componentGenericPoint M Z) ∉ (principalDivisor ψ).supp),
      Nonempty (E.divisorialSheaf ≅ H) ∧
        D' = E.pullback hEc hB - principalDivisor (pullbackRationalFunction q ψ hψ) ∧
        RationalMap.transformDivisor (X := M) q.toRationalMap D' = E - principalDivisor ψ := by
  have : IsDominant q := hq.isDominant
  obtain ⟨E, hEc, ⟨eE⟩⟩ := exists_isCartier_divisorialSheaf_iso H
  have hB := map_componentGenericPoint_notMem_supp_of_isDominant q E
  obtain ⟨e₁⟩ := Divisor.nonempty_divisorialSheaf_pullback_iso hEc q hB
  obtain ⟨χ, hχ⟩ := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso
    (e₁ ≪≫ (Scheme.Modules.pullback q).mapIso eE ≪≫ e)
  obtain ⟨ψ, hψ, rfl⟩ := exists_pullbackRationalFunction_eq hq χ
  have hD' : D' = E.pullback hEc hB - principalDivisor (pullbackRationalFunction q ψ hψ) := by
    rw [← hχ]
    abel
  refine ⟨E, hEc, hB, ψ, hψ, ⟨eE⟩, hD', ?_⟩
  rw [hD', map_sub, transformDivisor_of_isPullback_divisor hV hM hq hEc
    (Divisor.isPullback_pullback hEc hB), transformDivisor_principalDivisor_pullback hV hM hq ψ hψ]

/-- **Descending an invertible sheaf along a proper birational morphism.** Let `q : M ⟶ V` be a
proper birational morphism of normal varieties, `H` invertible on `V` and `D'` a divisor on `M`
with `q^* H ≅ 𝒪_M(D')`. Then `q_* D'` is Cartier and `𝒪_V(q_* D') ≅ H`. -/
private theorem isCartier_transformDivisor_and_iso {k : Type} [Field k] {M V : Scheme.{0}}
    [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    {sV : V ⟶ Spec (.of k)} (hV : IsNormalVariety k sV) {q : M ⟶ V}
    (hM : IsNormalVariety k (q ≫ sV)) [IsProper q] (hq : IsBirationalMorphism q)
    (H : V.Modules) [Stacks.Ample.IsInvertibleModule V H] {D' : Divisor M}
    (e : (Scheme.Modules.pullback q).obj H ≅ D'.divisorialSheaf) :
    Divisor.IsCartier (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V) ∧
      Nonempty (Divisor.divisorialSheaf
        (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V) ≅ H) := by
  obtain ⟨E, hEc, -, ψ, -, ⟨eE⟩, -, hT⟩ := exists_eq_pullback_sub_principalDivisor hV hM hq H e
  have hle : Divisor.LinearlyEquivalent
      (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V) E :=
    ⟨ψ⁻¹, by rw [hT, MMP.Mori.principalDivisor_inv]; abel⟩
  exact ⟨Divisor.IsCartier.of_linearlyEquivalent hle hEc, ⟨hle.divisorialSheafIso ≪≫ eE⟩⟩

/-- **A divisor whose sheaf is pulled back from an invertible sheaf is a pull-back.** Let
`q : M ⟶ V` be a proper birational morphism of normal varieties, `H` invertible on `V` and `D'` a
divisor on `M` with `q^* H ≅ 𝒪_M(D')`. Then `q_* D'` is Cartier and `D' = q^*(q_* D')`. -/
public theorem isPullback_transformDivisor_of_iso {k : Type} [Field k] {M V : Scheme.{0}}
    [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    {sV : V ⟶ Spec (.of k)} (hV : IsNormalVariety k sV) {q : M ⟶ V}
    (hM : IsNormalVariety k (q ≫ sV)) [IsProper q] (hq : IsBirationalMorphism q)
    (H : V.Modules) [Stacks.Ample.IsInvertibleModule V H] {D' : Divisor M}
    (e : (Scheme.Modules.pullback q).obj H ≅ D'.divisorialSheaf) :
    Divisor.IsCartier (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V) ∧
      ∃ hB : ∀ Z : irreducibleComponents M, q (componentGenericPoint M Z) ∉
          (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V).supp,
        Divisor.IsPullback q
          (RationalMap.transformDivisor (X := M) q.toRationalMap D' : Divisor V) hB D' := by
  have : IsDominant q := hq.isDominant
  obtain ⟨E, hEc, hB, ψ, hψ, -, hD', hT⟩ := exists_eq_pullback_sub_principalDivisor hV hM hq H e
  set T : Divisor V := RationalMap.transformDivisor (X := M) q.toRationalMap D'
  have hTc : T.IsCartier := (isCartier_transformDivisor_and_iso hV hM hq H e).1
  have hBT := map_componentGenericPoint_notMem_supp_of_isDominant q T
  refine ⟨hTc, hBT, ?_⟩
  have hTp := Divisor.isPullback_pullback hTc hBT
  have hsum := (hTp.add hTc (Divisor.isCartier_principalDivisor ψ)
    (map_componentGenericPoint_notMem_supp_of_isDominant q _)
    (Divisor.isPullback_principalDivisor ψ hψ)).of_eq
      (show T + principalDivisor ψ = E by rw [hT]; abel) (hB₂ := hB)
  have heq := hsum.eq hEc (Divisor.isPullback_pullback hEc hB)
  have : Divisor.pullback T hTc hBT = D' := by
    rw [hD', ← heq]
    abel
  exact this ▸ hTp

/-- **The push-forward of a canonical divisor along a proper birational morphism is a canonical
divisor up to linear equivalence**: `q_* K_M ∼ K_V` for canonical divisors `K_M` of `M` and `K_V`
of `V`, over a perfect field. -/
private theorem linearlyEquivalent_transformDivisor {k : Type} [Field k] [PerfectField k]
    {M V : Scheme.{0}} [IsIntegral M] [IsLocallyNoetherian M] [IsNormal M] [CompactSpace M]
    [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    {sV : V ⟶ Spec (.of k)} (hV : IsNormalVariety k sV) {q : M ⟶ V}
    (hM : IsNormalVariety k (q ≫ sV)) [IsProper q] (hq : IsBirationalMorphism q)
    {n n' : ℕ} {KV : Divisor V} {KM : Divisor M} (hKV : KV.IsCanonicalDivisor sV n)
    (hKM : KM.IsCanonicalDivisor (q ≫ sV) n') :
    Divisor.LinearlyEquivalent
      (RationalMap.transformDivisor (X := M) q.toRationalMap KM : Divisor V) KV := by
  have : IsDominant q := hq.isDominant
  have hbij := hq.functionFieldMap_bijective
  have : LocallyOfFiniteType sV := hV.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (q ≫ sV) := hM.1.toLocallyOfFiniteType
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sV)
    hKV.topologicalKrullDim_eq
  have hd' := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := q ≫ sV)
    hKM.topologicalKrullDim_eq
  let := functionFieldAlgebra sV
  let := functionFieldAlgebra (q ≫ sV)
  let := functionFieldMapAlgebra q
  have := isScalarTower_functionFieldMap sV q
  obtain rfl : n' = n := by
    let e : V.functionField ≃ₐ[k] M.functionField :=
      AlgEquiv.ofBijective (IsScalarTower.toAlgHom k V.functionField M.functionField) hbij
    rw [← hd, ← hd', e.trdeg_eq]
  obtain ⟨ω₁, hω₁0, hω₁⟩ := IsCanonicalDivisor.exists_ordForm_eq hM hKM
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sV q hbij hd
  obtain ⟨g, hg⟩ := hbij.2
    ((ZTensorPower.basis (basisOfSpanSingleton hω.2.1 hω.2.2) 1).repr ω₁ ())
  let τ : RationalPluriForms sV _ 1 :=
    g • ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) 1 ()
  have hpull : pullbackRationalPluriForms sV q τ = ω₁ := by
    change pullbackForms (K := V.functionField) (K' := M.functionField) 1 τ = ω₁
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp only [map_smul, Module.Basis.repr_self, Finsupp.smul_apply,
      Finsupp.single_eq_same, smul_eq_mul, mul_one]
    change functionFieldMap q g • _ = ω₁
    rw [hg]
    exact basis_unit_repr_smul _ ω₁
  have hτ0 : τ ≠ 0 := fun h0 => hω₁0 (by
    rw [← hpull, h0]
    change pullbackForms (K := V.functionField) (K' := M.functionField) 1 0 = 0
    rw [pullbackForms_eq hω, pullbackFormsAlong]
    simp)
  have hτ : ∀ P : MMP.Mori.PrimeDivisor V, P.ordForm τ =
      (RationalMap.transformDivisor (X := M) q.toRationalMap KM : Divisor V) P := by
    intro P
    obtain ⟨E, heq, hiso, htr⟩ := exists_isIso_stalkMap_forall_transformDivisor_apply hV hM hq P
    rw [htr, ← ordForm_pullbackRationalPluriForms_of_isIso q hbij hd E P heq τ, hpull, hω₁]
    rfl
  obtain ⟨ωV, hωV0, hωV⟩ := IsCanonicalDivisor.exists_ordForm_eq hV hKV
  obtain ⟨b⟩ := exists_basis_topForms hV hKV.topologicalKrullDim_eq
  set c := (ZTensorPower.basis b 1).repr τ () with hc_def
  set cV := (ZTensorPower.basis b 1).repr ωV () with hcV_def
  have hc : c ≠ 0 := repr_ne_zero_of_ne_zero b hτ0
  have hcV : cV ≠ 0 := repr_ne_zero_of_ne_zero b hωV0
  have hωeq : ωV = (cV / c) • τ := by
    have h1 := basis_unit_repr_smul (ZTensorPower.basis b 1) ωV
    have h2 := basis_unit_repr_smul (ZTensorPower.basis b 1) τ
    rw [← hc_def] at h2
    rw [← hcV_def] at h1
    conv_lhs => rw [← h1]
    conv_rhs => rw [← h2]
    erw [smul_smul, div_mul_cancel₀ _ hc]
    rfl
  obtain ⟨φ, hφ⟩ := exists_units_of_ne_zero (div_ne_zero hcV hc)
  refine ⟨φ⁻¹, Finsupp.ext fun P => ?_⟩
  have h1 := P.ordForm_smul hd (div_ne_zero hcV hc) hτ0
  rw [← hωeq, hωV, hτ P, ← hφ P] at h1
  change _ = DivisorWithCoeffs.coeff (MMP.Mori.principalDivisor φ⁻¹) P
  rw [coeff_principalDivisor, PrimeDivisor.ord_inv, Finsupp.coe_sub, Pi.sub_apply]
  change _ = P.ord φ + _ at h1
  change _ - DivisorWithCoeffs.coeff KV P = _
  omega

end Descent

/-! ### The pulled-back twisting sheaf on the generating loci

On the chart image of `D₊(a)`, `a` of degree one, `𝒪(d)` is free on `aᵈ`; its pullback `q^*(aᵈ)`
freely generates `q^* 𝒪(d)` on the generating locus `M_a`, where `aᵈ` freely generates `𝒪_M(dD)`.
The local comparisons `s ↦ (s / q^*(aᵈ)) · aᵈ` agree on overlaps, because both transition functions
are `(b/a)ᵈ`, and glue to an isomorphism. -/

section TwistPullback

open TopologicalSpace Stacks.RelativeProj Stacks.RelativeProj.Situation

section ProjSections

variable {S : Type u} [CommRing S] {σ : Type u} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- Two restriction maps of a scheme compose to a restriction map. -/
private theorem presheaf_map_map_apply {X : Scheme.{u}} {U V W : X.Opens} (i : op U ⟶ op V)
    (j : op V ⟶ op W) (k : op U ⟶ op W) (x : Γ(X, U)) :
    X.presheaf.map j (X.presheaf.map i x) = X.presheaf.map k x := by
  rw [← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
  rfl

private theorem awayι_appLE_awayToSection {f : S} {m : ℕ} (hf : f ∈ 𝒮 m) (hm : 0 < m)
    (h : (⊤ : (Spec (.of (HomogeneousLocalization.Away 𝒮 f))).Opens) ≤
      AlgebraicGeometry.Proj.awayι 𝒮 f hf hm ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒮 f)
    (z : HomogeneousLocalization.Away 𝒮 f) :
    (AlgebraicGeometry.Proj.awayι 𝒮 f hf hm).appLE (AlgebraicGeometry.Proj.basicOpen 𝒮 f) ⊤ h
      ((AlgebraicGeometry.Proj.awayToSection 𝒮 f).hom z) = (Scheme.ΓSpecIso _).inv z := by
  set e := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒮 f hf hm
  have hinj : Function.Injective (e.hom.appLE ⊤ ⊤ le_rfl) := by
    have : IsIso (e.hom.appLE ⊤ ⊤ le_rfl) := by
      change IsIso (e.hom.app ⊤ ≫ _)
      have : IsIso ((AlgebraicGeometry.Proj.basicOpen 𝒮 f).toScheme.presheaf.map
          (homOfLE (le_rfl : (⊤ : (AlgebraicGeometry.Proj.basicOpen 𝒮 f).toScheme.Opens) ≤ e.hom
              ⁻¹ᵁ ⊤)).op) := by
        rw [show (homOfLE (le_rfl : (⊤ : (AlgebraicGeometry.Proj.basicOpen 𝒮 f).toScheme.Opens) ≤
            e.hom ⁻¹ᵁ ⊤)) =
          𝟙 _ from rfl, op_id, CategoryTheory.Functor.map_id]
        infer_instance
      have h0 : IsIso (e.hom.app ⊤) := inferInstance
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h0 this
    exact (ConcreteCategory.bijective_of_isIso _).1
  apply hinj
  have h1 : e.hom ≫ AlgebraicGeometry.Proj.awayι 𝒮 f hf hm = (AlgebraicGeometry.Proj.basicOpen 𝒮
      f).ι := by
    simp [e, AlgebraicGeometry.Proj.awayι]
  have h2 := Scheme.Hom.appLE_comp_appLE e.hom (AlgebraicGeometry.Proj.awayι 𝒮 f hf hm)
      (AlgebraicGeometry.Proj.basicOpen 𝒮 f) ⊤ ⊤ h
    le_rfl
  have h3 := ConcreteCategory.congr_hom h2 ((AlgebraicGeometry.Proj.awayToSection 𝒮 f).hom z)
  rw [ConcreteCategory.comp_apply] at h3
  rw [h3]
  have h4 : (e.hom ≫ AlgebraicGeometry.Proj.awayι 𝒮 f hf hm).appLE
      (AlgebraicGeometry.Proj.basicOpen 𝒮 f) ⊤ (by
      simp [h1]) =
      (AlgebraicGeometry.Proj.basicOpen 𝒮 f).ι.appLE (AlgebraicGeometry.Proj.basicOpen 𝒮 f) ⊤ (by
          simp) := by
    congr 1
  rw [h4, Scheme.Opens.ι_appLE]
  change _ = (AlgebraicGeometry.Proj.basicOpen 𝒮 f).toScheme.presheaf.map _ (e.hom.app ⊤ _)
  have h5 := AlgebraicGeometry.Proj.basicOpenToSpec_app_top 𝒮 f
  rw [show e.hom = AlgebraicGeometry.Proj.basicOpenToSpec 𝒮 f from rfl, h5]
  erw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, Iso.inv_hom_id_apply]
  change _ = (AlgebraicGeometry.Proj 𝒮).presheaf.map _ ((AlgebraicGeometry.Proj 𝒮).presheaf.map _ _)
  exact (presheaf_map_map_apply _ _ _ _).symm

/-- Two restriction maps of a module compose to a restriction map. -/
private theorem modules_map_map_apply {X : Scheme.{u}} (F : X.Modules) {U V W : X.Opens}
    (i : op U ⟶ op V) (j : op V ⟶ op W) (k : op U ⟶ op W) (x : Γ(F, U)) :
    F.presheaf.map j (F.presheaf.map i x) = F.presheaf.map k x := by
  rw [← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
  rfl

/-- `appLE` from `⊤` to `⊤` is `appTop`. -/
private theorem appLE_top_top_apply {X Y : Scheme.{u}} (f : X ⟶ Y) (h : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤)
    (x : Γ(Y, ⊤)) : f.appLE ⊤ ⊤ h x = f.appTop x := by
  change X.presheaf.map (homOfLE h).op (f.app ⊤ x) = f.app ⊤ x
  exact ConcreteCategory.congr_hom (X.presheaf.map_id (op ⊤)) _

private theorem appLE_congr_hom' {X Y : Scheme.{u}} {f f' : X ⟶ Y} (h : f = f') (D : Y.Opens)
    (W : X.Opens) (e : W ≤ f ⁻¹ᵁ D) (e' : W ≤ f' ⁻¹ᵁ D) : f.appLE D W e = f'.appLE D W e' := by
  subst h; rfl

/-- **The effect on sections of a morphism into `Proj` which factors through `D₊(f)` by a ring
map.** -/
private theorem appLE_eq_of_factors {X R : Scheme.{u}} {f : S} {m : ℕ} (hf : f ∈ 𝒮 m) (hm : 0 < m)
    (c : AlgebraicGeometry.Proj 𝒮 ⟶ R) [IsOpenImmersion c] (q : X ⟶ R) {L : X.Opens}
    (ψ : HomogeneousLocalization.Away 𝒮 f →+* Γ(X, L))
    (hfac : L.ι ≫ q = L.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ AlgebraicGeometry.Proj.awayι 𝒮
        f hf hm ≫ c)
    {V : R.Opens} (hV : c ⁻¹ᵁ V ≤ AlgebraicGeometry.Proj.basicOpen 𝒮 f) (hL : L ≤ q ⁻¹ᵁ V)
    (z : HomogeneousLocalization.Away 𝒮 f) (v : Γ(R, V))
    (hv : c.app V v = (AlgebraicGeometry.Proj 𝒮).presheaf.map (homOfLE hV).op
        ((AlgebraicGeometry.Proj.awayToSection 𝒮 f).hom z)) :
    q.appLE V L hL v = ψ z := by
  apply (ConcreteCategory.bijective_of_isIso L.topIso.inv).1
  have hι : L.ι.appLE L ⊤ (by intro x _; exact x.2) = L.topIso.inv := by
    erw [Scheme.Opens.ι_appLE]; rfl
  rw [← hι]
  have e1 := ConcreteCategory.congr_hom
    (Scheme.Hom.appLE_comp_appLE L.ι q V L ⊤ hL (by intro x _; exact x.2)) v
  rw [ConcreteCategory.comp_apply] at e1
  rw [e1]
  set g := L.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)
  have hfac' : L.ι ≫ q = (g ≫ AlgebraicGeometry.Proj.awayι 𝒮 f hf hm) ≫ c := by
    rw [hfac]
    simp only [g, Category.assoc]
  have htop : (⊤ : L.toScheme.Opens) ≤ ((g ≫ AlgebraicGeometry.Proj.awayι 𝒮 f hf hm) ≫ c) ⁻¹ᵁ V
      := by
    rw [← hfac']
    intro x _
    exact hL x.2
  rw [appLE_congr_hom' hfac' V ⊤ _ htop, Scheme.Hom.comp_appLE, ConcreteCategory.comp_apply, hv]
  have e3 := ConcreteCategory.congr_hom (Scheme.Hom.map_appLE (g ≫ AlgebraicGeometry.Proj.awayι 𝒮
      f hf hm)
    (U := c ⁻¹ᵁ V) (U' := AlgebraicGeometry.Proj.basicOpen 𝒮 f) (V := ⊤) (by
      intro x hx; exact htop hx) (homOfLE hV).op) ((AlgebraicGeometry.Proj.awayToSection 𝒮 f).hom z)
  rw [ConcreteCategory.comp_apply] at e3
  rw [e3]
  have hD : (⊤ : (Spec (.of (HomogeneousLocalization.Away 𝒮 f))).Opens) ≤
      AlgebraicGeometry.Proj.awayι 𝒮 f hf hm ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒮 f := by
    intro x _
    change AlgebraicGeometry.Proj.awayι 𝒮 f hf hm x ∈ AlgebraicGeometry.Proj.basicOpen 𝒮 f
    rw [← AlgebraicGeometry.Proj.opensRange_awayι 𝒮 f hf hm]
    exact ⟨x, rfl⟩
  have e4 := ConcreteCategory.congr_hom (Scheme.Hom.appLE_comp_appLE g
      (AlgebraicGeometry.Proj.awayι 𝒮 f hf hm)
    (AlgebraicGeometry.Proj.basicOpen 𝒮 f) ⊤ ⊤ hD le_top) ((AlgebraicGeometry.Proj.awayToSection
        𝒮 f).hom z)
  rw [ConcreteCategory.comp_apply] at e4
  rw [← e4, awayι_appLE_awayToSection]
  refine (appLE_top_top_apply g _ _).trans ?_
  rw [hι]
  have e5 := ConcreteCategory.congr_hom
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ)) z
  rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at e5
  change L.toSpecΓ.appTop ((Spec.map (CommRingCat.ofHom ψ)).appTop _) = _
  rw [← e5, Scheme.Opens.toSpecΓ_appTop, ConcreteCategory.comp_apply]
  erw [Iso.inv_hom_id_apply]
  rfl

end ProjSections

section ChartSections

open AlgebraicGeometry.ProjectiveSpectrum.Proj HomogeneousLocalization

section Chart

universe w

variable {S : Type u} [CommRing S] {σ : Type w} [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose
  Stacks.SheafOfModules.TensorSheafification.structureSheaf
attribute [local instance_reducible] ProjectiveSpectrum.top

/-- `fⁿ` is homogeneous of degree `n * d` when `f` is homogeneous of degree `d`. -/
private theorem pow_mem_graded_mul {f : S} {d : ℕ} (hf : f ∈ 𝒮 d) (n : ℕ) :
    f ^ n ∈ 𝒮 (n * d) := by
  simpa using SetLike.pow_mem_graded n hf

/-- At a nonnegative index the trivializing fraction of `𝒪(nd)` on `D₊(f)` is `fⁿ / 1`. -/
private theorem trivializingFun_natCast {f : S} (n : ℕ)
    {W : Opens (ProjectiveSpectrum.top 𝒮)} (hW : W ≤ ProjectiveSpectrum.basicOpen 𝒮 f) (x : W) :
    Stacks.AlgebraicGeometry.ProjTrivialization.trivializingFun 𝒮 (n : ℤ) hW x =
      LocalizedModule.mk (f ^ n) (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) :=
  LocalizedModule.mk_eq.mpr ⟨1, by simp⟩

/-- **`fⁿ` freely generates `𝒪(nd)` on every open of `D₊(f)`** (Stacks 01MS): the global section
of `fⁿ` agrees with the trivializing section `fⁿ / 1`. -/
private theorem bijective_smul_powSection {f : S} {d : ℕ} (hf : f ∈ 𝒮 d) (n : ℕ)
    {W : Opens (ProjectiveSpectrum.top 𝒮)} (hW : W ≤ ProjectiveSpectrum.basicOpen 𝒮 f) :
    Function.Bijective (fun r : (ProjectiveSpectrum.Proj.structureSheaf 𝒮).obj.obj (op W) =>
      r • (show moduleSections 𝒮
          (twistGrading (S := S) 𝒮
            ((n : ℤ) * ((d : ℕ) : ℤ))) W from
        (twistingSheaf 𝒮 ((n * d : ℕ) : ℤ)).val.map (homOfLE (le_top : W ≤ ⊤)).op
          (degreeSection 𝒮 (n * d) ⟨f ^ n, pow_mem_graded_mul 𝒮 hf n⟩))) := by
  have h : (show moduleSections 𝒮
          (twistGrading (S := S) 𝒮
            ((n : ℤ) * ((d : ℕ) : ℤ))) W from
        (twistingSheaf 𝒮 ((n * d : ℕ) : ℤ)).val.map (homOfLE (le_top : W ≤ ⊤)).op
          (degreeSection 𝒮 (n * d) ⟨f ^ n, pow_mem_graded_mul 𝒮 hf n⟩)) =
      Stacks.AlgebraicGeometry.ProjTrivialization.trivializingSection 𝒮 hf (n : ℤ) hW :=
    Subtype.ext (funext fun x =>
      (Stacks.AlgebraicGeometry.ProjTwistSections.degreeSection_apply 𝒮 (n * d)
        ⟨f ^ n, pow_mem_graded_mul 𝒮 hf n⟩ _).trans
        (trivializingFun_natCast 𝒮 n hW x).symm)
  exact h ▸ Stacks.AlgebraicGeometry.ProjTrivialization.bijective_trivializingHom 𝒮 hf (n : ℤ) hW

/-- `𝒪(n)` on `Proj 𝒮` as a module on the scheme. -/
private noncomputable abbrev twistModule (n : ℤ) : (AlgebraicGeometry.Proj 𝒮).Modules :=
  twistingSheaf 𝒮 n

/-- On `D₊(q)`, `deg q = 1`, the section of `p` of degree `d` is `p / qᵈ` times that of `qᵈ`. -/
private theorem degreeSection_res_eq_smul {d : ℕ} {p q : S} (hp : p ∈ 𝒮 (d * 1)) (hq : q ∈ 𝒮 1)
    {W : (AlgebraicGeometry.Proj 𝒮).Opens} (hW : W ≤ AlgebraicGeometry.Proj.basicOpen 𝒮 q) :
    (twistModule 𝒮 ((d * 1 : ℕ) : ℤ)).presheaf.map (homOfLE (le_top (a := W))).op
        (degreeSection 𝒮 (d * 1) ⟨p, hp⟩) =
      (AlgebraicGeometry.Proj 𝒮).presheaf.map (homOfLE hW).op
          ((AlgebraicGeometry.Proj.awayToSection 𝒮 q).hom (Away.mk 𝒮 hq d p hp)) •
        (twistModule 𝒮 ((d * 1 : ℕ) : ℤ)).presheaf.map (homOfLE (le_top (a := W))).op
          (degreeSection 𝒮 (d * 1) ⟨q ^ d,
            pow_mem_graded_mul 𝒮 hq d⟩) := by
  refine Subtype.ext (funext fun x => ?_)
  have hL := Stacks.AlgebraicGeometry.ProjTwistSections.degreeSection_apply 𝒮 (d * 1) ⟨p, hp⟩
    ⟨x.1, trivial⟩
  have hLq := Stacks.AlgebraicGeometry.ProjTwistSections.degreeSection_apply 𝒮 (d * 1)
    ⟨q ^ d, pow_mem_graded_mul 𝒮 hq d⟩ ⟨x.1, trivial⟩
  have hval : HomogeneousLocalization.val
      (((AlgebraicGeometry.Proj.awayToSection 𝒮 q).hom (Away.mk 𝒮 hq d p hp)).1 ⟨x.1, hW x.2⟩) =
      Localization.mk p ⟨q ^ d, _⟩ := rfl
  change (degreeSection 𝒮 (d * 1) ⟨p, hp⟩).1 ⟨x.1, trivial⟩ =
    HomogeneousLocalization.val
          (((AlgebraicGeometry.Proj.awayToSection 𝒮 q).hom (Away.mk 𝒮 hq d p hp)).1
            ⟨x.1, hW x.2⟩) *
     (degreeSection 𝒮 (d * 1) ⟨q ^ d, _⟩).1 ⟨x.1, trivial⟩
  rw [hL, hval, hLq]
  rw [show LocalizedModule.mk (q ^ d) (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) =
      Localization.mk (q ^ d) 1 from rfl,
    show LocalizedModule.mk p (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) =
      Localization.mk p 1 from rfl, Localization.mk_mul]
  exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp; ring))

/-- On `D₊(q)`, `deg q = 1`, the section of `qᵈ` freely generates `𝒪(d)`. -/
private theorem bijective_smul_degreeSection_pow {d : ℕ} {q : S} (hq : q ∈ 𝒮 1)
    {W : (AlgebraicGeometry.Proj 𝒮).Opens} (hW : W ≤ AlgebraicGeometry.Proj.basicOpen 𝒮 q) :
    Function.Bijective (fun r : Γ(AlgebraicGeometry.Proj 𝒮, W) =>
      r • (twistModule 𝒮 ((d * 1 : ℕ) : ℤ)).presheaf.map (homOfLE (le_top (a := W))).op
          (degreeSection 𝒮 (d * 1) ⟨q ^ d,
            pow_mem_graded_mul 𝒮 hq d⟩)) :=
  bijective_smul_powSection 𝒮 hq d hW

end Chart

section Relative

variable (s : Situation.{0})

/-- The section of `𝒪(n)` over the chart over `U` given by a homogeneous element of degree `n`. -/
private noncomputable def chartSection (U : s.base.affineOpens) (n : ℕ)
    (c : s.sectionRingGrading U.1 n) :
    Γ(twistSheaf s (n : ℤ), (relativeProjChart s U).opensRange) :=
  (twistSectionsIso (twistTransition s (n : ℤ)) U le_rfl).inv
    ((twistChart s (n : ℤ) U).presheaf.map (homOfLE le_top).op (degreeSection _ n c))

/-- The chart identification of sections is semilinear over the chart map. -/
private theorem twistSectionsIso_smul (U : s.base.affineOpens) {V : s.relativeProj.Opens}
    (hV : V ≤ (relativeProjChart s U).opensRange) (n : ℤ)
    (r : Γ(s.relativeProj, V)) (x : Γ(twistSheaf s n, V)) :
    (show Γ(twistChart s n U, relativeProjChart s U ⁻¹ᵁ V) from
      (twistSectionsIso (twistTransition s n) U hV).hom (r • x)) =
      (relativeProjChart s U).app V r •
        (show Γ(twistChart s n U, relativeProjChart s U ⁻¹ᵁ V) from
          (twistSectionsIso (twistTransition s n) U hV).hom x) :=
  ((twistSectionsIso (twistTransition s n) U hV).hom.hom.map_smul r x)

/-- Reading a restriction of `chartSection` on the chart. -/
private theorem twistSectionsIso_chartSection (U : s.base.affineOpens) (n : ℕ)
    (c : s.sectionRingGrading U.1 n) {V : s.relativeProj.Opens}
    (hV : V ≤ (relativeProjChart s U).opensRange) :
    (show Γ(twistChart s (n : ℤ) U, relativeProjChart s U ⁻¹ᵁ V) from
      (twistSectionsIso (twistTransition s (n : ℤ)) U hV).hom
        ((twistSheaf s (n : ℤ)).presheaf.map (homOfLE hV).op (chartSection s U n c))) =
      (twistChart s (n : ℤ) U).presheaf.map (homOfLE le_top).op (degreeSection _ n c) := by
  have h := twistSectionsIso_restrict (twistTransition s (n : ℤ)) U le_rfl hV
    (chartSection s U n c)
  refine h.trans ?_
  rw [chartSection]
  erw [Iso.inv_hom_id_apply]
  change ((twistChart s (n : ℤ) U).presheaf.map _ ≫ (twistChart s (n : ℤ) U).presheaf.map _) _ = _
  rw [← Functor.map_comp]
  rfl

private theorem preimage_le_of_le_image (U : s.base.affineOpens)
    {D : (AlgebraicGeometry.Proj (s.sectionRingGrading U.1)).Opens} {V : s.relativeProj.Opens}
    (hV : V ≤ relativeProjChart s U ''ᵁ D) : relativeProjChart s U ⁻¹ᵁ V ≤ D := by
  have := (relativeProjChart s U).preimage_mono hV
  rwa [Scheme.Hom.preimage_image_eq] at this

private theorem le_opensRange_of_le_image (U : s.base.affineOpens)
    {D : (AlgebraicGeometry.Proj (s.sectionRingGrading U.1)).Opens} {V : s.relativeProj.Opens}
    (hV : V ≤ relativeProjChart s U ''ᵁ D) : V ≤ (relativeProjChart s U).opensRange :=
  hV.trans (Scheme.Hom.image_le_opensRange _ _)

/-- **On the chart image of `D₊(q)`, `deg q = 1`, the section of `qᵈ` freely generates
`𝒪(d)`.** -/
private theorem bijective_smul_chartSection_pow (U : s.base.affineOpens) (d : ℕ)
    {q : s.sectionRing U.1} (hq : q ∈ s.sectionRingGrading U.1 1) {V : s.relativeProj.Opens}
    (hV : V ≤ relativeProjChart s U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ q) :
    Function.Bijective (fun r : Γ(s.relativeProj, V) =>
      r • (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_opensRange_of_le_image s U hV)).op
        (chartSection s U (d * 1) ⟨q ^ d,
          pow_mem_graded_mul _ hq d⟩)) := by
  set φ := twistSectionsIso (twistTransition s ((d * 1 : ℕ) : ℤ)) U
    (le_opensRange_of_le_image s U hV)
  have hφ : Function.Bijective φ.hom := ConcreteCategory.bijective_of_isIso φ.hom
  have := (relativeProjChart s U).isIso_app V (le_opensRange_of_le_image s U hV)
  have happ : Function.Bijective ((relativeProjChart s U).app V) :=
    ConcreteCategory.bijective_of_isIso _
  refine (Function.Bijective.of_comp_iff' hφ _).mp ?_
  have key : (fun r => φ.hom (r • (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_opensRange_of_le_image s U hV)).op
        (chartSection s U (d * 1) ⟨q ^ d,
          pow_mem_graded_mul _ hq d⟩))) =
      (fun r : Γ(AlgebraicGeometry.Proj (s.sectionRingGrading U.1), relativeProjChart s U ⁻¹ᵁ V) =>
        r • (twistModule _ ((d * 1 : ℕ) : ℤ)).presheaf.map (homOfLE le_top).op
          (degreeSection _ (d * 1) ⟨q ^ d,
            pow_mem_graded_mul _ hq d⟩)) ∘
        (relativeProjChart s U).app V := by
    funext r
    refine (twistSectionsIso_smul s U _ _ r _).trans ?_
    exact congrArg (fun z => (relativeProjChart s U).app V r • z)
      (twistSectionsIso_chartSection s U (d * 1) _ _)
  have hb := (bijective_smul_degreeSection_pow _ (d := d) hq
    (preimage_le_of_le_image s U hV)).comp happ
  rw [← key] at hb
  exact hb

/-- **On the chart image of `D₊(q)`, the section of `p` is `p / qᵈ` times that of `qᵈ`**, for
any function `v` on the open reading as `p / qᵈ` on the chart. -/
private theorem chartSection_res_eq_smul (U : s.base.affineOpens) (d : ℕ)
    {q p : s.sectionRing U.1} (hq : q ∈ s.sectionRingGrading U.1 1)
    (hp : p ∈ s.sectionRingGrading U.1 (d * 1)) {V : s.relativeProj.Opens}
    (hV : V ≤ relativeProjChart s U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ q)
    (v : Γ(s.relativeProj, V))
    (hv : (relativeProjChart s U).app V v =
      (AlgebraicGeometry.Proj (s.sectionRingGrading U.1)).presheaf.map
        (homOfLE (preimage_le_of_le_image s U hV)).op
        ((AlgebraicGeometry.Proj.awayToSection _ q).hom (Away.mk _ hq d p hp))) :
    (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_opensRange_of_le_image s U hV)).op (chartSection s U (d * 1) ⟨p, hp⟩) =
      v • (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_opensRange_of_le_image s U hV)).op
        (chartSection s U (d * 1) ⟨q ^ d,
          pow_mem_graded_mul _ hq d⟩) := by
  set φ := twistSectionsIso (twistTransition s ((d * 1 : ℕ) : ℤ)) U
    (le_opensRange_of_le_image s U hV)
  have hφ : Function.Bijective φ.hom := ConcreteCategory.bijective_of_isIso φ.hom
  refine hφ.1 ?_
  refine (twistSectionsIso_chartSection s U (d * 1) _ _).trans ?_
  refine Eq.trans ?_ (twistSectionsIso_smul s U _ _ v _).symm
  rw [hv]
  refine (degreeSection_res_eq_smul _ hp hq (preimage_le_of_le_image s U hV)).trans ?_
  exact congrArg (fun z => _ • z) (twistSectionsIso_chartSection s U (d * 1) _ _).symm

/-- The restriction of a homogeneous element to a smaller affine open of the base. -/
private noncomputable def restrictGrading {U U' : s.base.affineOpens} (h : U' ≤ U) {n : ℕ}
    (c : s.sectionRingGrading U.1 n) : s.sectionRingGrading U'.1 n :=
  ⟨gradedSectionRestriction s U'.1 U.1 h c, (gradedSectionRestriction s U'.1 U.1 h).map_mem c.2⟩

/-- **The chart sections are compatible with the restriction of the base.** -/
private theorem chartSection_restrict {U U' : s.base.affineOpens} (h : U' ≤ U) (n : ℕ)
    (c : s.sectionRingGrading U.1 n) :
    (twistSheaf s (n : ℤ)).presheaf.map (homOfLE (opensRange_relativeProjChart_mono s h)).op
        (chartSection s U n c) = chartSection s U' n (restrictGrading s h c) := by
  set φ := twistSectionsIso (twistTransition s (n : ℤ)) U' (le_refl _)
  have hφ : Function.Bijective φ.hom := ConcreteCategory.bijective_of_isIso φ.hom
  refine hφ.1 ?_
  rw [chartSection]
  erw [Iso.inv_hom_id_apply]
  have h1 := twistPushforwardMap_twistSectionsIso s (n : ℤ) h (le_refl _)
    ((twistSheaf s (n : ℤ)).presheaf.map (homOfLE (opensRange_relativeProjChart_mono s h)).op
        (chartSection s U n c))
  refine Eq.trans (b := ((twistPushforwardMap s (n : ℤ) h).val.app
      (op (relativeProjChart s U').opensRange)).hom
    ((twistSectionsIso (twistTransition s (n : ℤ)) U (opensRange_relativeProjChart_mono s h)).hom
      ((twistSheaf s (n : ℤ)).presheaf.map (homOfLE (opensRange_relativeProjChart_mono s h)).op
        (chartSection s U n c)))) h1.symm ?_
  have h2 := twistSectionsIso_chartSection s U n c (opensRange_relativeProjChart_mono s h)
  refine (congrArg (fun z => ((twistPushforwardMap s (n : ℤ) h).val.app
      (op (relativeProjChart s U').opensRange)).hom z) h2).trans ?_
  apply Subtype.ext
  funext x
  refine (twistPushforwardMap_val s (n : ℤ) h _ x).trans ?_
  change Stacks.ProjTwistComparison.fibreMap _ _ x.1 ((degreeSection _ n c).1 ⟨_, trivial⟩) =
    (degreeSection _ n (restrictGrading s h c)).1 ⟨x.1, trivial⟩
  have e1 := Stacks.AlgebraicGeometry.ProjTwistSections.degreeSection_apply _ n c
    ⟨(ProjectiveSpectrum.comapFun (gradedSectionRestriction s U'.1 U.1 h)
      (irrelevant_le_map_gradedSectionRestriction s U'.1 U.1 h U'.2 U.2) x.1), trivial⟩
  have e2 := Stacks.AlgebraicGeometry.ProjTwistSections.degreeSection_apply _ n
    (restrictGrading s h c) ⟨x.1, trivial⟩
  refine (congrArg (Stacks.ProjTwistComparison.fibreMap _ _ x.1) e1).trans (Eq.trans ?_ e2.symm)
  refine (Stacks.ProjTwistComparison.fibreMap_mk _ _ _ _ _).trans ?_
  congr 1
  exact Subtype.ext (map_one _)

end Relative

end ChartSections

section FreeGen

variable {X : Scheme.{u}}

/-- Multiplication by a freely generating section, as a linear equivalence. -/
private noncomputable def smulEquiv (F : X.Modules) {V : X.Opens} (σ : Γ(F, V))
    (h : ∀ (W : X.Opens) (hW : W ≤ V),
      Function.Bijective (fun r : Γ(X, W) => r • F.presheaf.map (homOfLE hW).op σ))
    (W : X.Opens) (hW : W ≤ V) : Γ(X, W) ≃ₗ[Γ(X, W)] Γ(F, W) :=
  LinearEquiv.ofBijective
    (LinearMap.toSpanSingleton Γ(X, W) Γ(F, W) (F.presheaf.map (homOfLE hW).op σ)) (h W hW)

private theorem smulEquiv_apply (F : X.Modules) {V : X.Opens} (σ : Γ(F, V))
    (h : ∀ (W : X.Opens) (hW : W ≤ V),
      Function.Bijective (fun r : Γ(X, W) => r • F.presheaf.map (homOfLE hW).op σ))
    (W : X.Opens) (hW : W ≤ V) (r : Γ(X, W)) :
    smulEquiv F σ h W hW r = r • F.presheaf.map (homOfLE hW).op σ := rfl

/-- A section which freely generates a module over every open inside `V` gives a sectionwise
trivialization over `V`. -/
private noncomputable def trivOfBijective (F : X.Modules) {V : X.Opens} (σ : Γ(F, V))
    (h : ∀ (W : X.Opens) (hW : W ≤ V),
      Function.Bijective (fun r : Γ(X, W) => r • F.presheaf.map (homOfLE hW).op σ)) :
    Stacks.SheafDescent.Trivialization X.presheaf F.val V where
  θ W i := (smulEquiv F σ h W i.le).symm
  θ_naturality {W W'} i i' m := by
    have hm := (smulEquiv F σ h W i.le).apply_symm_apply m
    apply (smulEquiv F σ h W' (i' ≫ i).le).injective
    refine ((smulEquiv F σ h W' (i' ≫ i).le).apply_symm_apply _).trans ?_
    change _ = X.presheaf.map i'.op ((smulEquiv F σ h W i.le).symm m) •
      F.presheaf.map (homOfLE (i' ≫ i).le).op σ
    conv_lhs => rw [← hm, smulEquiv_apply]
    change F.presheaf.map i'.op (_ • _) = _
    rw [Scheme.Modules.map_smul]
    congr 1
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl

/-- **A freely generating section vanishes nowhere.** -/
private theorem subset_nonvanishingLocusOn_of_bijective (F : X.Modules) {V : X.Opens} (σ : Γ(F, V))
    (h : ∀ (W : X.Opens) (hW : W ≤ V),
      Function.Bijective (fun r : Γ(X, W) => r • F.presheaf.map (homOfLE hW).op σ)) :
    (V : Set X) ⊆ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn F V σ := by
  have hb : Stacks.NonvanishingOpen.basis (trivOfBijective F σ h) = σ := by
    change smulEquiv F σ h V (le_refl V) (1 : Γ(X, V)) = σ
    rw [smulEquiv_apply, one_smul]
    exact (ConcreteCategory.congr_hom (F.presheaf.map_id (op V)) σ)
  have := Stacks.AmpleThickeningAscent.nonvanishingLocusOn_basis (trivOfBijective F σ h)
  rw [hb] at this
  exact this.ge

end FreeGen

section PullbackGen

variable {X Y : Scheme.{u}}

/-- **The pullback of a section vanishes exactly over where the section vanishes** (Stacks 0H78
over an open). -/
private theorem nonvanishingLocusOn_pullbackSectionOn (f : X ⟶ Y) (F : Y.Modules) {T : Y.Opens}
    (σ : Γ(F, T)) :
    Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn
        (Stacks.AmpleLocallyClosed.pullbackModule f F) (f ⁻¹ᵁ T)
        (Stacks.TwistPullbackPinned.pullbackSectionOn f F T σ) =
      f.base ⁻¹' Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn F T σ := by
  have key : ∀ (x : X) (hx : x ∈ f ⁻¹ᵁ T),
      (Stacks.AmpleLocallyClosed.pullbackModule f F).presheaf.germ (f ⁻¹ᵁ T) x hx
          (Stacks.TwistPullbackPinned.pullbackSectionOn f F T σ) ∈
          Stacks.ModuleStalk.maximalSmul (Stacks.AmpleLocallyClosed.pullbackModule f F) x ↔
        F.presheaf.germ T (f.base x) hx σ ∈ Stacks.ModuleStalk.maximalSmul F (f.base x) := by
    intro x hx
    refine Iff.symm ?_
    refine Iff.trans (Stacks.NonvanishingPullback.mem_maximalSmul_iff F (f.base x) _) ?_
    refine Iff.trans ?_ (Stacks.NonvanishingPullback.mem_maximalSmul_iff
      (Stacks.AmpleLocallyClosed.pullbackModule f F) x _).symm
    refine Iff.trans
      (Stacks.NonvanishingPullback.mem_maximalIdeal_smul_iff_one_tmul
        (instAlg := Stacks.PullbackTensorIso.commStalkAlgebra f.toLRSHom.toShHom x)
        (instLoc := Stacks.NonvanishingPullback.isLocalHom_commStalkRingMap f x)
        (instMod := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule Y.toRingedSpace
          F.val (f.base x))
        ((F.presheaf.germ T (f.base x) hx).hom σ)) ?_
    refine Iff.trans
      (Stacks.NonvanishingPullback.mem_ideal_smul_top_iff_of_linearEquiv _
        (Stacks.PullbackTensorIso.pullbackStalkEquiv f.toLRSHom.toShHom x F) _) ?_
    exact Iff.of_eq (congrArg (fun z => z ∈
      IsLocalRing.maximalIdeal (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk
        X.toRingedSpace x) • ⊤)
      (Stacks.PullbackTensorIso.pullbackStalkEquiv_one_tmul f.toLRSHom.toShHom x F T hx σ))
  ext x
  constructor
  · rintro ⟨hx, h⟩
    exact ⟨hx, fun h' => h ((key x hx).mpr h')⟩
  · rintro ⟨hx, h⟩
    exact ⟨hx, fun h' => h ((key x hx).mp h')⟩

/-- **The pullback of a nowhere vanishing section freely generates an invertible pullback.** -/
private theorem bijective_smul_pullbackSection (f : X ⟶ Y) (F : Y.Modules)
    [Stacks.Ample.IsInvertibleModule X ((Scheme.Modules.pullback f).obj F)] {T : Y.Opens}
    (σ : Γ(F, T)) (hσ : (T : Set Y) ⊆ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn F T σ)
    {W : X.Opens} (hW : W ≤ f ⁻¹ᵁ T) :
    Function.Bijective (fun r : Γ(X, W) => r • ((Scheme.Modules.pullback f).obj F).presheaf.map
      (homOfLE hW).op (Stacks.TwistPullbackPinned.pullbackSectionOn f F T σ)) := by
  refine Stacks.AmpleThickeningAscent.bijective_smul_of_nonvanishing _ _ fun y hy => ?_
  rw [Stacks.AmpleThickeningAscent.nonvanishingLocusOn_res]
  refine ⟨hy, ?_⟩
  change y ∈ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn
    (Stacks.AmpleLocallyClosed.pullbackModule f F) (f ⁻¹ᵁ T)
    (Stacks.TwistPullbackPinned.pullbackSectionOn f F T σ)
  rw [nonvanishingLocusOn_pullbackSectionOn]
  exact hσ (hW hy)

end PullbackGen

private theorem le_preimage_image_of_factors {S σ : Type} [CommRing S] [SetLike σ S]
    [AddSubgroupClass σ S] {𝒮 : ℕ → σ} [GradedRing 𝒮] {X R : Scheme.{0}} {f : S} {m : ℕ}
    (hf : f ∈ 𝒮 m) (hm : 0 < m) (c : AlgebraicGeometry.Proj 𝒮 ⟶ R) [IsOpenImmersion c]
    (q : X ⟶ R) {L : X.Opens} (ψ : HomogeneousLocalization.Away 𝒮 f →+* Γ(X, L))
    (hfac : L.ι ≫ q = L.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫
      AlgebraicGeometry.Proj.awayι 𝒮 f hf hm ≫ c) :
    L ≤ q ⁻¹ᵁ (c ''ᵁ AlgebraicGeometry.Proj.basicOpen 𝒮 f) := by
  intro x hx
  have h := congrArg (fun g => g.base ⟨x, hx⟩) hfac
  simp only [Scheme.Hom.comp_base] at h
  change q.base x ∈ c ''ᵁ AlgebraicGeometry.Proj.basicOpen 𝒮 f
  refine ⟨_, ?_, h.symm⟩
  change _ ∈ (AlgebraicGeometry.Proj.basicOpen 𝒮 f : Set (AlgebraicGeometry.Proj 𝒮))
  rw [← AlgebraicGeometry.Proj.opensRange_awayι 𝒮 f hf hm]
  exact ⟨_, rfl⟩

open Stacks.AlgebraicGeometry in
/-- **A twist pulled back along a morphism landing chartwise in the degree-one locus is
invertible.** -/
private theorem isInvertibleModule_pullback_twistSheaf (s : Situation.{0}) {X : Scheme.{0}}
    (q : X ⟶ s.relativeProj) (n : ℤ)
    (h : ∀ x : X, ∃ (U : s.base.affineOpens) (W : X.Opens)
      (g : W.toScheme ⟶ AlgebraicGeometry.Proj (s.sectionRingGrading U.1)),
      x ∈ W ∧ W.ι ≫ q = g ≫ s.relativeProjChart U ∧
        ∀ w, g.base w ∈ Stacks.AlgebraicGeometry.ProjShared.ratioLocus
          (s.sectionRingGrading U.1) 1) :
    Stacks.Ample.IsInvertibleModule X ((Scheme.Modules.pullback q).obj (twistSheaf s n)) := by
  refine TwistMapsInvertible.isInvertibleModule_of_forall_exists_isoUnit_openImmersion _ fun x => ?_
  obtain ⟨U, W, g, hxW, hfac, hg⟩ := h x
  obtain ⟨V, hyV, ⟨e⟩⟩ :=
    Stacks.AlgebraicGeometry.TwistMapsInvertible.exists_mem_restrict_isoUnit_twistingSheaf
      (s.sectionRingGrading U.1) (d := 1) (n := n) (c := n) (by simp) (hg ⟨x, hxW⟩)
  set W' : W.toScheme.Opens := g ⁻¹ᵁ V
  have hk : (W'.ι ≫ W.ι) ≫ q = (g ∣_ V) ≫ V.ι ≫ s.relativeProjChart U := by
    rw [Category.assoc, hfac, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  refine ⟨W'.toScheme, W'.ι ≫ W.ι, inferInstance, ⟨⟨⟨x, hxW⟩, hyV⟩, rfl⟩, ⟨?_⟩⟩
  exact (Scheme.Modules.restrictFunctorIsoPullback _).app _ ≪≫
    (Scheme.Modules.pullbackComp _ q).app _ ≪≫
    (Scheme.Modules.pullbackCongr hk).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback (g ∣_ V)).mapIso
      (twistSheafPullbackChartIso s n U V.ι rfl ≪≫
        ((Scheme.Modules.restrictFunctorIsoPullback V.ι).app _).symm ≪≫ e) ≪≫
    Stacks.AlgebraicGeometry.ProjTwistMono.pullbackObjUnitIso (g ∣_ V)

section GenSection

variable (s : Situation.{0})

/-- The generator `qᵈ` of `𝒪(d)` on the chart image of `D₊(q)`. -/
private noncomputable def genSection (U : s.base.affineOpens) (d : ℕ) {q : s.sectionRing U.1}
    (hq : q ∈ s.sectionRingGrading U.1 1) :
    Γ(twistSheaf s ((d * 1 : ℕ) : ℤ),
      relativeProjChart s U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ q) :=
  (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
    (homOfLE (le_opensRange_of_le_image s U le_rfl)).op
    (chartSection s U (d * 1) ⟨q ^ d,
      pow_mem_graded_mul _ hq d⟩)

private theorem genSection_res (U : s.base.affineOpens) (d : ℕ) {q : s.sectionRing U.1}
    (hq : q ∈ s.sectionRingGrading U.1 1) {V : s.relativeProj.Opens}
    (hV : V ≤ relativeProjChart s U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ q) :
    (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map (homOfLE hV).op (genSection s U d hq) =
      (twistSheaf s ((d * 1 : ℕ) : ℤ)).presheaf.map
        (homOfLE (le_opensRange_of_le_image s U hV)).op
        (chartSection s U (d * 1) ⟨q ^ d,
          pow_mem_graded_mul _ hq d⟩) := by
  rw [genSection, ← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
  rfl

/-- **The generator vanishes nowhere on the chart image of `D₊(q)`.** -/
private theorem subset_nonvanishingLocusOn_genSection (U : s.base.affineOpens) (d : ℕ)
    {q : s.sectionRing U.1} (hq : q ∈ s.sectionRingGrading U.1 1) :
    ((relativeProjChart s U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ q : s.relativeProj.Opens) :
        Set s.relativeProj) ⊆
      Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn (twistSheaf s ((d * 1 : ℕ) : ℤ))
        _ (genSection s U d hq) := by
  refine subset_nonvanishingLocusOn_of_bijective _ _ fun W hW => ?_
  rw [genSection_res]
  exact bijective_smul_chartSection_pow s U d hq hW

end GenSection

section LocalBijective

/-- **Multiplication by a section is bijective if it is so locally.** -/
private theorem bijective_smul_of_local {X : Scheme.{u}} (F : X.Modules) {W : X.Opens} (τ : Γ(F, W))
    (h : ∀ x ∈ W, ∃ V : X.Opens, x ∈ V ∧ ∃ hVW : V ≤ W, ∀ (P : X.Opens) (hP : P ≤ V),
      Function.Bijective fun a : Γ(X, P) => a • F.presheaf.map (homOfLE (hP.trans hVW)).op τ) :
    Function.Bijective fun a : Γ(X, W) => a • τ := by
  choose V hyT hTW hbij' using fun y : W => h y.1 y.2
  let iV : ∀ y, V y ⟶ W := fun y => homOfLE (hTW y)
  have hcover : W ≤ iSup V := fun x hx => Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hyT ⟨x, hx⟩⟩
  have hres : ∀ {P Q : X.Opens} (i : Q ⟶ P) (a : Γ(X, P)) (σ : Γ(F, P)),
      F.presheaf.map i.op (a • σ) = X.presheaf.map i.op a • F.presheaf.map i.op σ :=
    fun i a σ => Scheme.Modules.map_smul F i a σ
  have hbij : ∀ (y : W) (P : X.Opens) (hP : P ≤ V y), Function.Bijective
      fun a : Γ(X, P) => a • F.presheaf.map (homOfLE (hP.trans (hTW y))).op τ := hbij'
  have hresres : ∀ {P Q R : X.Opens} (h₁ : Q ≤ P) (h₂ : P ≤ R) (σ : Γ(F, R)),
      F.presheaf.map (homOfLE h₁).op (F.presheaf.map (homOfLE h₂).op σ) =
        F.presheaf.map (homOfLE (h₁.trans h₂)).op σ := by
    intro P Q R h₁ h₂ σ
    rw [← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
    rfl
  refine ⟨fun a b hab => ?_, fun l => ?_⟩
  · refine TopCat.Sheaf.eq_of_locally_eq' X.sheaf V W iV hcover a b fun y => ?_
    refine (hbij y (V y) le_rfl).1 ?_
    change X.presheaf.map (iV y).op a • F.presheaf.map (iV y).op τ =
      X.presheaf.map (iV y).op b • F.presheaf.map (iV y).op τ
    rw [← hres, ← hres]
    exact congrArg (F.presheaf.map (iV y).op) hab
  · choose a ha using fun y => (hbij y (V y) le_rfl).2 (F.presheaf.map (iV y).op l)
    have ha' : ∀ y, a y • F.presheaf.map (iV y).op τ = F.presheaf.map (iV y).op l := ha
    have hloc : ∀ (y : W) (P : X.Opens) (hP : P ≤ V y),
        X.presheaf.map (homOfLE hP).op (a y) •
            F.presheaf.map (homOfLE (hP.trans (hTW y))).op τ =
          F.presheaf.map (homOfLE (hP.trans (hTW y))).op l := by
      intro y P hP
      rw [← hresres hP (hTW y) τ, ← hres, ha' y]
      exact hresres hP (hTW y) l
    have hcompat : ∀ y y', X.presheaf.map (homOfLE (inf_le_left : V y ⊓ V y' ≤ V y)).op (a y) =
        X.presheaf.map (homOfLE (inf_le_right : V y ⊓ V y' ≤ V y')).op (a y') := by
      intro y y'
      refine (hbij y (V y ⊓ V y') inf_le_left).1 ?_
      change X.presheaf.map (homOfLE inf_le_left).op (a y) • _ =
        X.presheaf.map (homOfLE inf_le_right).op (a y') • _
      rw [hloc y _ inf_le_left]
      exact (hloc y' _ inf_le_right).symm
    obtain ⟨A, hA⟩ : ∃ A : Γ(X, W), ∀ y, X.presheaf.map (iV y).op A = a y := by
      obtain ⟨A, hA, -⟩ := X.sheaf.existsUnique_gluing' V W iV hcover a hcompat
      exact ⟨A, hA⟩
    refine ⟨A, Stacks.AmpleThickeningAscent.modules_eq_of_locally_eq F V W iV hcover _ l
      fun y => ?_⟩
    change F.presheaf.map (iV y).op (A • τ) = F.presheaf.map (iV y).op l
    rw [hres, ← ha' y, hA y]

end LocalBijective

section DivisorialFree

variable {M : Scheme.{0}} [IsLocallyNoetherian M] [IsNormal M]

/-- **A section of `𝒪(E)` with an inverse in `𝒪(-E)` freely generates `𝒪(E)`.** -/
private theorem bijective_smul_of_mul_eq_one {E : Divisor M} {P : M.Opens} (β :
    E.divisorialSubmodule P)
    (b : (rationalFunctionsPresheaf M).obj (op P)) (hb : (-E).IsDivisorialSection P b)
    (hβb : (β : (rationalFunctionsPresheaf M).obj (op P)) * b = 1) :
    Function.Bijective fun r : Γ(M, P) => r • β := by
  have hsmul : ∀ (r : Γ(M, P)), ((r • β : E.divisorialSubmodule P) :
      (rationalFunctionsPresheaf M).obj (op P)) =
      (toRationalFunctionsPresheaf M).app (op P) r * (β : _) := fun r => rfl
  refine ⟨fun r r' h => ?_, fun f => ?_⟩
  · apply toRationalFunctionsPresheaf_app_injective P
    have h1 := congrArg (fun z : E.divisorialSubmodule P =>
      (z : (rationalFunctionsPresheaf M).obj (op P)) * b) h
    simpa only [hsmul, mul_assoc, hβb, mul_one] using h1
  · have hφ : (0 : Divisor M).IsDivisorialSection P ((f : _) * b) := by
      intro E' hE'
      have := (f.2 E' hE').mul (hb E' hE')
      simp only [DivisorWithCoeffs.coeff_neg, neg_neg, neg_add_cancel] at this
      simp only [DivisorWithCoeffs.coeff_zero, neg_zero]
      exact this
    obtain ⟨r, hr⟩ := hφ.exists_eq
    refine ⟨r, Subtype.ext ?_⟩
    change (toRationalFunctionsPresheaf M).app (op P) r * (β : _) = _
    rw [hr, mul_assoc, mul_comm b, hβb, mul_one]

end DivisorialFree

section MLevel

variable {M Z : Scheme.{0}} [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} {D : Divisor M}
  (A : DivisorialSectionAlgebra π D)

/-- The degree-one element of the section ring given by a section of `𝒜_1(U)`. -/
private noncomputable abbrev f1 {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) :
    A.situation.sectionRing U :=
  DirectSum.of (A.situation.sectionPieces U) 1 a

private theorem f1_mem {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) :
    f1 A a ∈ A.situation.sectionRingGrading U 1 := ⟨a, rfl⟩

/-- The rational function of a degree-`n` component. -/
private noncomputable def kval (U : Z.Opens) (n : ℕ) (c : A.situation.sectionRing U) :
    (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U)) :=
  (toPoly A U c).coeff n

private theorem kval_eq (U : Z.Opens) (n : ℕ) (c : A.situation.sectionRing U) :
    kval A U n c = (A.sectionEquiv n (Int.natCast_nonneg n) U (c n) :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) :=
  coeff_toPoly A U n c

private theorem toPoly_f1 {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) :
    toPoly A U (f1 A a) = Polynomial.monomial 1 (A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) := by
  simp only [toPoly, DirectSum.toSemiring_of]
  rfl

private theorem kval_f1_pow {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) (d : ℕ) :
    kval A U (d * 1) (f1 A a ^ d) = (A.sectionEquiv 1 zero_le_one U a :
      (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ^ d := by
  rw [kval, map_pow, toPoly_f1, Polynomial.monomial_pow, Polynomial.coeff_monomial,
    ite_eq_left (by ring)]

/-- The induced morphism on the generating locus of a degree-one section, in the form used
below. -/
private theorem factors_one {q : M ⟶ A.model} (hq : A.IsInducedMorphism q) (U : Z.affineOpens)
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) :
    ∃ ψ : HomogeneousLocalization.Away (A.situation.sectionRingGrading U.1) (f1 A a) →+*
        Γ(M, A.generatingLocus zero_le_one a),
      (A.generatingLocus zero_le_one a).ι ≫ q =
          (A.generatingLocus zero_le_one a).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫
            AlgebraicGeometry.Proj.awayι (A.situation.sectionRingGrading U.1) (f1 A a)
              (f1_mem A a) one_pos ≫ A.situation.relativeProjChart U ∧
        ∀ (m : ℕ) (p : A.situation.sectionRing U.1)
          (hp : p ∈ A.situation.sectionRingGrading U.1 (m • 1)),
          (toRationalFunctionsPresheaf M).app (op (A.generatingLocus zero_le_one a))
              (ψ (HomogeneousLocalization.Away.mk _ (f1_mem A a) m p hp)) *
              (rationalFunctionsPresheaf M).map (homOfLE (A.generatingLocus_le _ a)).op
                (A.sectionEquiv 1 zero_le_one U.1 a :
                  (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1))) ^ m =
            (rationalFunctionsPresheaf M).map (homOfLE (A.generatingLocus_le _ a)).op
              (kval A U.1 (m • 1) p) := by
  obtain ⟨ψ, h1, h2⟩ := hq.factors U 1 one_pos a
  refine ⟨ψ, h1, fun m p hp => ?_⟩
  obtain ⟨t, rfl⟩ := hp
  rw [kval_eq, DirectSum.of_eq_same]
  exact h2 m t

variable {q : M ⟶ A.situation.relativeProj} (d : ℕ)

/-- The chart image of `D₊(a)` for a degree-one section `a`. -/
private noncomputable abbrev chartBasicOpen (U : Z.affineOpens)
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) :
    A.situation.relativeProj.Opens :=
  A.situation.relativeProjChart U ''ᵁ AlgebraicGeometry.Proj.basicOpen _ (f1 A a)

/-- The pulled-back generator `q^*(aᵈ)`. -/
private noncomputable def tau (q : M ⟶ A.situation.relativeProj) (U : Z.affineOpens)
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) :
    Γ((Scheme.Modules.pullback q).obj (twistSheaf A.situation ((d * 1 : ℕ) : ℤ)),
      q ⁻¹ᵁ chartBasicOpen A U a) :=
  Stacks.TwistPullbackPinned.pullbackSectionOn q _ _ (genSection A.situation U d (f1_mem A a))

private theorem generatingLocus_le_preimage (hq : A.IsInducedMorphism q) (U : Z.affineOpens)
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) :
    A.generatingLocus zero_le_one a ≤ q ⁻¹ᵁ chartBasicOpen A U a := by
  obtain ⟨ψ, h1, -⟩ := factors_one A hq U a
  exact le_preimage_image_of_factors _ _ _ q ψ h1

private theorem bijective_smul_tau
    [Stacks.Ample.IsInvertibleModule M
      ((Scheme.Modules.pullback q).obj (twistSheaf A.situation ((d * 1 : ℕ) : ℤ)))]
    (U : Z.affineOpens) (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ q ⁻¹ᵁ chartBasicOpen A U a) :
    Function.Bijective (fun r : Γ(M, W) => r •
      ((Scheme.Modules.pullback q).obj (twistSheaf A.situation ((d * 1 : ℕ) : ℤ))).presheaf.map
        (homOfLE hW).op (tau A d q U a)) :=
  bijective_smul_pullbackSection q _ _
    (subset_nonvanishingLocusOn_genSection A.situation U d (f1_mem A a)) hW

/-- The rational section `aᵈ` of `𝒪_M(dD)` over `π⁻¹U`. -/
private noncomputable def alpha (U : Z.Opens) (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) :
    (((d * 1 : ℕ) : ℤ) • D).divisorialSubmodule (π ⁻¹ᵁ U) :=
  A.sectionEquiv _ (Int.natCast_nonneg _) U ((f1 A a ^ d) (d * 1))

private theorem coe_alpha (U : Z.Opens) (a : (A.algebra.piece (1 : ℤ)).val.obj (op U)) :
    (alpha A d U a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) =
      (A.sectionEquiv 1 zero_le_one U a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) ^ d :=
  (kval_eq A U (d * 1) _).symm.trans (kval_f1_pow A a d)

/-- **`aᵈ` freely generates `𝒪_M(dD)` on the generating locus of `a`.** -/
private theorem bijective_smul_alpha {U : Z.Opens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U))
    {W : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) :
    Function.Bijective fun r : Γ(M, W) => r •
      (((d * 1 : ℕ) : ℤ) • D).divisorialRestrict
        (homOfLE (hW.trans (A.generatingLocus_le _ a))) (alpha A d U a) := by
  refine bijective_smul_of_local (((d * 1 : ℕ) : ℤ) • D).divisorialSheaf
    (W := W) ((((d * 1 : ℕ) : ℤ) • D).divisorialRestrict
        (homOfLE (hW.trans (A.generatingLocus_le _ a))) (alpha A d U a)) fun x hx => ?_
  obtain ⟨W', ⟨hW'U, b, hb, hab⟩, hxW'⟩ := TopologicalSpace.Opens.mem_sSup.mp (hW hx)
  refine ⟨W ⊓ W', ⟨hx, hxW'⟩, inf_le_left, fun P hP => ?_⟩
  have hPW' : P ≤ W' := hP.trans inf_le_right
  refine bijective_smul_of_mul_eq_one _
    ((rationalFunctionsPresheaf M).map (homOfLE hPW').op b ^ d) ?_ ?_
  · intro E hE
    have h1 := ordGE_pow (hb E (hE.mono (Set.inter_subset_inter_right _ hPW'))) d
    convert h1 using 1 <;> first | rfl | simp [DivisorWithCoeffs.coeff_smul]
  · have hab' := congrArg ((rationalFunctionsPresheaf M).map (homOfLE hPW').op) hab
    rw [map_mul, map_one] at hab'
    change (rationalFunctionsPresheaf M).map
      (homOfLE ((hP.trans inf_le_left).trans (hW.trans (A.generatingLocus_le _ a)))).op
      (alpha A d U a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U))) * _ = 1
    rw [coe_alpha, map_pow, ← mul_pow]
    refine Eq.trans ?_ ((congrArg (· ^ d) hab').trans (one_pow d))
    rfl

/-- The pulled-back twist. -/
private noncomputable abbrev pullbackTwist (q : M ⟶ A.situation.relativeProj) : M.Modules :=
  (Scheme.Modules.pullback q).obj (twistSheaf A.situation ((d * 1 : ℕ) : ℤ))

/-- The divisorial sheaf `𝒪_M(dD)`. -/
private noncomputable abbrev divisorialTwist : M.Modules := (((d * 1 : ℕ) : ℤ) • D).divisorialSheaf

/-- `q^*(aᵈ)` restricted to an open of the generating locus. -/
private noncomputable def tauW (hq : A.IsInducedMorphism q) {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) : Γ(pullbackTwist A d q, W) :=
  (pullbackTwist A d q).presheaf.map (homOfLE (hW.trans (generatingLocus_le_preimage A hq U a))).op
    (tau A d q U a)

/-- `aᵈ` restricted to an open of the generating locus. -/
private noncomputable def alphaW {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) : Γ(divisorialTwist (D := D) d, W) :=
  (((d * 1 : ℕ) : ℤ) • D).divisorialRestrict
    (homOfLE (hW.trans (A.generatingLocus_le _ a))) (alpha A d U.1 a)

/-- Division by `q^*(aᵈ)`. -/
private noncomputable def divEquiv (hq : A.IsInducedMorphism q)
    [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) : Γ(M, W) ≃ₗ[Γ(M, W)] Γ(pullbackTwist A d q, W) :=
  LinearEquiv.ofBijective
    (LinearMap.toSpanSingleton Γ(M, W) Γ(pullbackTwist A d q, W) (tauW A d hq a hW))
    (bijective_smul_tau A d U a _)

private theorem divEquiv_apply (hq : A.IsInducedMorphism q)
    [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) (r : Γ(M, W)) :
    divEquiv A d hq a hW r = r • tauW A d hq a hW := rfl

/-- The local comparison `q^* 𝒪(d) ⟶ 𝒪_M(dD)` on an open of the generating locus of `a`:
`s ↦ (s / q^*(aᵈ)) · aᵈ`. -/
private noncomputable def locMap (hq : A.IsInducedMorphism q)
    [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) :
    Γ(pullbackTwist A d q, W) ⟶ Γ(divisorialTwist (D := D) d, W) :=
  ConcreteCategory.ofHom (AddMonoidHom.mk'
    (fun x => (divEquiv A d hq a hW).symm x • alphaW A d a hW)
    (fun x y => by rw [map_add, add_smul]))

private theorem locMap_apply (hq : A.IsInducedMorphism q)
    [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] {U : Z.affineOpens}
    (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a) (x : Γ(pullbackTwist A d q, W)) :
    locMap A d hq a hW x = (divEquiv A d hq a hW).symm x • alphaW A d a hW := rfl

section LocMapProps

variable (hq : A.IsInducedMorphism q) [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)]
  {U : Z.affineOpens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1))

include hq in
private theorem locMap_smul {W : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) (r : Γ(M, W))
    (x : Γ(pullbackTwist A d q, W)) : locMap A d hq a hW (r • x) = r • locMap A d hq a hW x := by
  rw [locMap_apply, locMap_apply, map_smul, smul_eq_mul, mul_smul]

omit [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] in
private theorem tauW_res {W W' : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) (h : W' ≤ W) :
    (pullbackTwist A d q).presheaf.map (homOfLE h).op (tauW A d hq a hW) =
      tauW A d hq a (h.trans hW) := by
  rw [tauW, tauW, ← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
  rfl

private theorem alphaW_res {W W' : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) (h : W' ≤
    W) :
    (divisorialTwist (D := D) d).presheaf.map (homOfLE h).op (alphaW A d a hW) =
      alphaW A d a (h.trans hW) := rfl

private theorem divEquiv_symm_res {W W' : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a)
    (h : W' ≤ W) (x : Γ(pullbackTwist A d q, W)) :
    (divEquiv A d hq a (h.trans hW)).symm ((pullbackTwist A d q).presheaf.map (homOfLE h).op x) =
      M.presheaf.map (homOfLE h).op ((divEquiv A d hq a hW).symm x) := by
  rw [LinearEquiv.symm_apply_eq, divEquiv_apply, ← tauW_res A d hq a hW h,
    ← Scheme.Modules.map_smul]
  congr 1
  rw [← divEquiv_apply, LinearEquiv.apply_symm_apply]

private theorem locMap_res {W W' : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) (h : W' ≤ W)
    (x : Γ(pullbackTwist A d q, W)) :
    locMap A d hq a (h.trans hW) ((pullbackTwist A d q).presheaf.map (homOfLE h).op x) =
      (divisorialTwist (D := D) d).presheaf.map (homOfLE h).op (locMap A d hq a hW x) := by
  rw [locMap_apply, locMap_apply, Scheme.Modules.map_smul, alphaW_res, divEquiv_symm_res]

private theorem bijective_locMap {W : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a) :
    Function.Bijective (locMap A d hq a hW) :=
  (bijective_smul_alpha A d a hW).comp (divEquiv A d hq a hW).symm.bijective

end LocMapProps

section Ratio

variable (hq : A.IsInducedMorphism q) {U : Z.affineOpens}

/-- The pulled-back chart section over the whole chart. -/
private noncomputable def pbChart (p : A.situation.sectionRingGrading U.1 (d * 1)) :
    Γ(pullbackTwist A d q, q ⁻¹ᵁ (A.situation.relativeProjChart U).opensRange) :=
  Stacks.TwistPullbackPinned.pullbackSectionOn q _ _ (chartSection A.situation U (d * 1) p)

private theorem tauW_eq (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a)
    (hW' : W ≤ q ⁻¹ᵁ (A.situation.relativeProjChart U).opensRange) :
    tauW A d hq a hW = (pullbackTwist A d q).presheaf.map (homOfLE hW').op
      (pbChart A d (q := q) ⟨f1 A a ^ d,
        pow_mem_graded_mul _ (f1_mem A a) d⟩) := by
  rw [tauW, tau, genSection, Stacks.TwistPullbackPinned.pullbackSectionOn_res,
    ← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
  rfl

/-- **On `M_a ∩ M_b` the two generators differ by the ratio `(b/a)ᵈ`, on both sides.** -/
private theorem exists_ratio (a b : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hWa : W ≤ A.generatingLocus zero_le_one a) (hWb : W ≤ A.generatingLocus zero_le_one b) :
    ∃ ρ : Γ(M, W), tauW A d hq b hWb = ρ • tauW A d hq a hWa ∧
      ρ • alphaW A d a hWa = alphaW A d b hWb := by
  have hTa : chartBasicOpen A U a ≤ (A.situation.relativeProjChart U).opensRange :=
    le_opensRange_of_le_image A.situation U le_rfl
  have hpb := pow_mem_graded_mul _ (f1_mem A b) d
  set z := HomogeneousLocalization.Away.mk _ (f1_mem A a) d (f1 A b ^ d) hpb
  have := (A.situation.relativeProjChart U).isIso_app (chartBasicOpen A U a) hTa
  obtain ⟨v, hv⟩ := (ConcreteCategory.bijective_of_isIso ((A.situation.relativeProjChart U).app
      (chartBasicOpen A U a))).2
    ((AlgebraicGeometry.Proj (A.situation.sectionRingGrading U.1)).presheaf.map
      (homOfLE (preimage_le_of_le_image A.situation U (le_refl (chartBasicOpen A U a)))).op
      ((AlgebraicGeometry.Proj.awayToSection _ (f1 A a)).hom z))
  have hB2 := chartSection_res_eq_smul A.situation U d (f1_mem A a) hpb
    (le_refl (chartBasicOpen A U a)) v hv
  have hWT : W ≤ q ⁻¹ᵁ (chartBasicOpen A U a) := hWa.trans (generatingLocus_le_preimage A hq U a)
  have hWc : W ≤ q ⁻¹ᵁ (A.situation.relativeProjChart U).opensRange := hWT.trans (q.preimage_mono
      hTa)
  set ρ : Γ(M, W) := M.presheaf.map (homOfLE hWT).op (q.app (chartBasicOpen A U a) v)
  refine ⟨ρ, ?_, ?_⟩
  · rw [tauW_eq A d hq b hWb hWc, tauW_eq A d hq a hWa hWc]
    have h1 :=
      congrArg (Stacks.TwistPullbackPinned.pullbackSectionOn q _ (chartBasicOpen A U a)) hB2
    rw [Stacks.TwistPullbackPinned.pullbackSectionOn_smul,
      Stacks.TwistPullbackPinned.pullbackSectionOn_res,
      Stacks.TwistPullbackPinned.pullbackSectionOn_res] at h1
    have h2 := congrArg ((pullbackTwist A d q).presheaf.map (homOfLE hWT).op) h1
    rw [Scheme.Modules.map_smul, modules_map_map_apply, modules_map_map_apply] at h2
    exact h2
  · obtain ⟨ψ, hfac, hval⟩ := factors_one A hq U a
    have hρ : ρ = M.presheaf.map (homOfLE hWa).op (ψ z) := by
      have e1 := appLE_eq_of_factors (A.situation.sectionRingGrading U.1) (f1_mem A a) one_pos
        (A.situation.relativeProjChart U) q ψ hfac
        (preimage_le_of_le_image A.situation U (le_refl _))
        (generatingLocus_le_preimage A hq U a) z v hv
      rw [← e1, ← ConcreteCategory.comp_apply, Scheme.Hom.appLE_map,
        Stacks.TwistPullbackPinned.appLE_apply]
    apply Subtype.ext
    have hv2 := congrArg ((rationalFunctionsPresheaf M).map (homOfLE hWa).op)
      (hval d (f1 A b ^ d) hpb)
    rw [map_mul, map_pow] at hv2
    change (toRationalFunctionsPresheaf M).app (op W) ρ *
        (rationalFunctionsPresheaf M).map (homOfLE (hWa.trans (A.generatingLocus_le _ a))).op
          (alpha A d U.1 a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1))) =
      (rationalFunctionsPresheaf M).map (homOfLE (hWb.trans (A.generatingLocus_le _ b))).op
          (alpha A d U.1 b : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1)))
    rw [hρ, toRationalFunctionsPresheaf_app_map, coe_alpha, coe_alpha, map_pow, map_pow]
    have hk := kval_f1_pow A b d
    change _ = _ ^ d at hk
    rw [show kval A U.1 (d • 1) (f1 A b ^ d) = kval A U.1 (d * 1) (f1 A b ^ d) from rfl, hk,
      map_pow] at hv2
    exact hv2

private theorem locMap_eq_of_same [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)]
    (a b : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)) {W : M.Opens}
    (hWa : W ≤ A.generatingLocus zero_le_one a) (hWb : W ≤ A.generatingLocus zero_le_one b) :
    locMap A d hq a hWa = locMap A d hq b hWb := by
  obtain ⟨ρ, h1, h2⟩ := exists_ratio A d hq a b hWa hWb
  refine ConcreteCategory.hom_ext _ _ fun x => ?_
  have hx : (divEquiv A d hq a hWa).symm x = (divEquiv A d hq b hWb).symm x * ρ := by
    rw [LinearEquiv.symm_apply_eq, divEquiv_apply, mul_smul, ← h1, ← divEquiv_apply,
      LinearEquiv.apply_symm_apply]
  rw [locMap_apply, locMap_apply, hx, mul_smul, h2]

end Ratio

section Restrict

variable (hq : A.IsInducedMorphism q) {U U' : Z.affineOpens} (h : U' ≤ U)
  (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1))

/-- The restriction of a degree-one section to a smaller affine open. -/
private noncomputable abbrev resA : (A.algebra.piece (1 : ℤ)).val.obj (op U'.1) :=
  (A.algebra.piece (1 : ℤ)).val.map (homOfLE (show (U'.1 : Z.Opens) ≤ U.1 from h)).op a

private theorem coe_sectionEquiv_resA :
    (A.sectionEquiv 1 zero_le_one U'.1 (resA A h a) :
        (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U'.1))) =
      (rationalFunctionsPresheaf M).map
        (homOfLE (π.preimage_mono (show (U'.1 : Z.Opens) ≤ U.1 from h))).op
        (A.sectionEquiv 1 zero_le_one U.1 a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1))) :=
  congrArg Subtype.val (A.sectionEquiv_restrict 1 zero_le_one (show (U'.1 : Z.Opens) ≤ U.1 from
      h) a)

private theorem generatingLocus_inf_le :
    A.generatingLocus zero_le_one a ⊓ π ⁻¹ᵁ U'.1 ≤ A.generatingLocus zero_le_one (resA A h a) := by
  rintro x ⟨hx, hxU'⟩
  obtain ⟨W', ⟨hW'U, b, hb, hab⟩, hxW'⟩ := TopologicalSpace.Opens.mem_sSup.mp hx
  have hle : W' ⊓ π ⁻¹ᵁ U'.1 ≤ W' := inf_le_left
  refine TopologicalSpace.Opens.mem_sSup.mpr ⟨W' ⊓ π ⁻¹ᵁ U'.1, ⟨inf_le_right,
    (rationalFunctionsPresheaf M).map (homOfLE hle).op b, hb.map (homOfLE hle), ?_⟩,
    ⟨hxW', hxU'⟩⟩
  rw [coe_sectionEquiv_resA]
  have := congrArg ((rationalFunctionsPresheaf M).map (homOfLE hle).op) hab
  rw [map_mul, map_one] at this
  exact this

private theorem alphaW_resA {W : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a)
    (hW' : W ≤ A.generatingLocus zero_le_one (resA A h a)) :
    alphaW A d (resA A h a) hW' = alphaW A d a hW := by
  apply Subtype.ext
  change (rationalFunctionsPresheaf M).map _
      (alpha A d U'.1 (resA A h a) : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U'.1))) =
    (rationalFunctionsPresheaf M).map (homOfLE (hW.trans (A.generatingLocus_le _ a))).op
      (alpha A d U.1 a : (rationalFunctionsPresheaf M).obj (op (π ⁻¹ᵁ U.1)))
  rw [coe_alpha, coe_alpha, coe_sectionEquiv_resA, map_pow, map_pow]
  rfl

private theorem restrictGrading_pow :
    restrictGrading A.situation h ⟨f1 A a ^ d,
      pow_mem_graded_mul _ (f1_mem A a) d⟩ =
    ⟨f1 A (resA A h a) ^ d,
      pow_mem_graded_mul _ (f1_mem A _) d⟩ := by
  apply Subtype.ext
  change gradedSectionRestriction A.situation U'.1 U.1 h (f1 A a ^ d) = _
  rw [map_pow, gradedSectionRestriction_of]
  rfl

private theorem tauW_resA {W : M.Opens} (hW : W ≤ A.generatingLocus zero_le_one a)
    (hW' : W ≤ A.generatingLocus zero_le_one (resA A h a)) :
    tauW A d hq (resA A h a) hW' = tauW A d hq a hW := by
  have hc' : W ≤ q ⁻¹ᵁ (A.situation.relativeProjChart U').opensRange :=
    (hW'.trans (generatingLocus_le_preimage A hq U' _)).trans
      (q.preimage_mono (le_opensRange_of_le_image A.situation U' le_rfl))
  have hmono := opensRange_relativeProjChart_mono A.situation h
  rw [tauW_eq A d hq _ hW' hc', tauW_eq A d hq a hW (hc'.trans (q.preimage_mono hmono)), pbChart,
    pbChart, ← restrictGrading_pow, ← chartSection_restrict,
    Stacks.TwistPullbackPinned.pullbackSectionOn_res, modules_map_map_apply]

private theorem locMap_resA [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)] {W : M.Opens}
    (hW : W ≤ A.generatingLocus zero_le_one a)
    (hW' : W ≤ A.generatingLocus zero_le_one (resA A h a)) :
    locMap A d hq (resA A h a) hW' = locMap A d hq a hW := by
  refine ConcreteCategory.hom_ext _ _ fun x => ?_
  have hx : (divEquiv A d hq (resA A h a) hW').symm x = (divEquiv A d hq a hW).symm x := by
    rw [LinearEquiv.symm_apply_eq, divEquiv_apply, tauW_resA A d hq h a hW hW',
      ← divEquiv_apply, LinearEquiv.apply_symm_apply]
  rw [locMap_apply, locMap_apply, hx, alphaW_resA A d h a hW hW']

end Restrict

section Overlap

variable (hq : A.IsInducedMorphism q) [Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q)]

/-- **The local comparisons agree on overlaps.** -/
private theorem locMap_eq {U U' : Z.affineOpens} (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1))
    (b : (A.algebra.piece (1 : ℤ)).val.obj (op U'.1)) {V : M.Opens}
    (hVa : V ≤ A.generatingLocus zero_le_one a) (hVb : V ≤ A.generatingLocus zero_le_one b) :
    locMap A d hq a hVa = locMap A d hq b hVb := by
  refine ConcreteCategory.hom_ext _ _ fun x => ?_
  have hex : ∀ y : V, ∃ U'' : Z.affineOpens, π.base y.1 ∈ U''.1 ∧ U'' ≤ U ∧ U'' ≤ U' := by
    intro y
    have hy : π.base y.1 ∈ U.1 ⊓ U'.1 :=
      ⟨(A.generatingLocus_le _ a) (hVa y.2), (A.generatingLocus_le _ b) (hVb y.2)⟩
    obtain ⟨W, hW, hyW, hWle⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens hy
    exact ⟨⟨W, hW⟩, hyW, hWle.trans inf_le_left, hWle.trans inf_le_right⟩
  choose U'' hyU'' hU''U hU''U' using hex
  let P : V → M.Opens := fun y => V ⊓ π ⁻¹ᵁ (U'' y).1
  have hPV : ∀ y, P y ≤ V := fun y => inf_le_left
  refine Stacks.AmpleThickeningAscent.modules_eq_of_locally_eq (divisorialTwist (D := D) d) P V
    (fun y => homOfLE (hPV y)) (fun z hz => TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨z, hz⟩, hz, hyU'' ⟨z, hz⟩⟩) _ _ fun y => ?_
  have hPa : P y ≤ A.generatingLocus zero_le_one (resA A (hU''U y) a) :=
    (inf_le_inf_right _ hVa).trans (generatingLocus_inf_le A (hU''U y) a)
  have hPb : P y ≤ A.generatingLocus zero_le_one (resA A (hU''U' y) b) :=
    (inf_le_inf_right _ hVb).trans (generatingLocus_inf_le A (hU''U' y) b)
  rw [← locMap_res A d hq a hVa (hPV y), ← locMap_res A d hq b hVb (hPV y),
    ← locMap_resA A d hq (hU''U y) a _ hPa, ← locMap_resA A d hq (hU''U' y) b _ hPb,
    locMap_eq_of_same A d hq _ _ hPa hPb]

end Overlap

section Main

/-- **`q^* 𝒪(d) ≅ 𝒪_M(dD)`, at the degree `d * 1`.** -/
private theorem nonempty_iso_main [IsIntegral M] [CompactSpace M] (hDC : D.IsCartier)
    (hfree : IsRelativelyFreeDivisor π D) (hq : A.IsInducedMorphism q) :
    Nonempty ((Scheme.Modules.pullback q).obj (twistSheaf A.situation ((d * 1 : ℕ) : ℤ)) ≅
      (((d * 1 : ℕ) : ℤ) • D).divisorialSheaf) := by
  classical
  have hcov : ∀ x : M, ∃ (U : Z.affineOpens) (a : (A.algebra.piece (1 : ℤ)).val.obj (op U.1)),
      x ∈ A.generatingLocus zero_le_one a := by
    intro x
    obtain ⟨W, hW, hxW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
      (show π.base x ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨a, ha⟩ := exists_mem_generatingLocus A hDC hfree hW (x := x) hxW
    exact ⟨⟨W, hW⟩, a, ha⟩
  have hL : Stacks.Ample.IsInvertibleModule M (pullbackTwist A d q) := by
    refine isInvertibleModule_pullback_twistSheaf A.situation q _ fun x => ?_
    obtain ⟨U, a, ha⟩ := hcov x
    obtain ⟨ψ, hfac, -⟩ := factors_one A hq U a
    refine ⟨U, A.generatingLocus zero_le_one a,
      (A.generatingLocus zero_le_one a).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫
        AlgebraicGeometry.Proj.awayι _ (f1 A a) (f1_mem A a) one_pos, ha, ?_, fun w => ?_⟩
    · exact hfac.trans (by simp only [Category.assoc]; rfl)
    · refine Stacks.AlgebraicGeometry.ProjShared.basicOpen_le_ratioLocus _ (dvd_refl 1)
        (f1_mem A a) ?_
      rw [← AlgebraicGeometry.Proj.opensRange_awayι _ (f1 A a) (f1_mem A a) one_pos]
      exact ⟨_, rfl⟩
  let I := Σ U : Z.affineOpens, (A.algebra.piece (1 : ℤ)).val.obj (op U.1)
  let C : I → M.Opens := fun i => A.generatingLocus zero_le_one i.2
  have hU : ⨆ i, C i = ⊤ := by
    refine top_le_iff.mp fun x _ => ?_
    obtain ⟨U, a, ha⟩ := hcov x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, a⟩, ha⟩
  obtain ⟨φ, hφ, -⟩ := Stacks.AlgebraicGeometry.ModuleHomGlue.existsUnique_hom_of_cover_app
    (M := pullbackTwist A d q) (N := divisorialTwist (D := D) d) hU
    (fun i V hV => locMap A d hq i.2 hV)
    (fun i V hV r x => locMap_smul A d hq i.2 hV r x)
    (fun i V W hV hWV x => locMap_res A d hq i.2 hV hWV x)
    (fun i j V hVi hVj => locMap_eq A d hq i.2 j.2 hVi hVj)
  choose idx hidx using fun x : M => TopologicalSpace.Opens.mem_iSup.mp
    (show x ∈ ⨆ i, C i by rw [hU]; trivial)
  have hiso : IsIso φ := by
    refine Scheme.Modules.Hom.isIso_iff_isIso_app.mpr fun W =>
      (ConcreteCategory.isIso_iff_bijective _).mpr ?_
    refine Stacks.AlgebraicGeometry.ProjTwistMono.bijective_app_of_locally φ
      (fun x => C (idx x)) hidx (fun x W hW => ?_) W
    rw [hφ (idx x) W hW]
    exact bijective_locMap A d hq (idx x).2 hW
  exact ⟨asIso φ⟩

end Main

end MLevel

end TwistPullback

/-- **The induced morphism pulls the twisting sheaf back to the divisorial sheaf**:
`q^* 𝒪_{Proj_Z 𝒜}(d) ≅ 𝒪_M(dD)` for the morphism `q` induced by the section algebra of a relatively
free Cartier divisor `D`. -/
private theorem nonempty_pullback_twistSheaf_iso {M Z : Scheme.{0}} [IsIntegral M]
    [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M] {π : M ⟶ Z} {D : Divisor M}
    (hDC : D.IsCartier) (hfree : IsRelativelyFreeDivisor π D) (A : DivisorialSectionAlgebra π D)
    {q : M ⟶ A.model} (hq : A.IsInducedMorphism q) (d : ℕ) :
    Nonempty ((Scheme.Modules.pullback q).obj
        (Stacks.RelativeProj.Situation.twistSheaf A.situation (d : ℤ)) ≅
      ((d : ℤ) • D).divisorialSheaf) := by
  have h := nonempty_iso_main A d (q := q) hDC hfree hq
  rwa [Nat.mul_one] at h

/-- **The relative ample model carries a relatively ample invertible sheaf pulling back to a
multiple of `𝒪_M(D)`**: if `V ≅ Proj_Z 𝒜` over `Z` for the section algebra `𝒜` of a relatively
free Cartier divisor `D` along a projective `π : M ⟶ Z`, and `q : M ⟶ V` is the induced morphism,
then some invertible `H` on `V`, ample over `Z`, has `q^* H ≅ 𝒪_M(dD)` for some `d > 0`. -/
public theorem DivisorialSectionAlgebra.exists_isRelativelyAmple_pullback_iso
    {M Z V : Scheme.{0}} [IsIntegral M] [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M]
    {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {π : M ⟶ Z} (hπ : IsProjectiveMorphism π)
    {D : Divisor M} (hDC : D.IsCartier) (hfree : IsRelativelyFreeDivisor π D)
    (A : DivisorialSectionAlgebra π D) {p : V ⟶ Z} {q : M ⟶ V} (e : V ≅ A.model)
    (he : e.hom ≫ A.toBase = p) (hq : A.IsInducedMorphism (q ≫ e.hom)) :
    ∃ d : ℕ, 0 < d ∧ ∃ (H : V.Modules) (_ : Stacks.Ample.IsInvertibleModule V H),
      MMP.Mori.IsRelativelyAmple p H ∧
        Nonempty ((Scheme.Modules.pullback q).obj H ≅ ((d : ℤ) • D).divisorialSheaf) := by
  have : IsLocallyNoetherian Z := by
    have := hZ.toIsVariety
    exact LocallyOfFiniteType.isLocallyNoetherian sZ
  have hπ' : IsProper π := isProper_of_isProjectiveMorphism π hπ
  have : CompactSpace Z := by
    have := hZ.toIsVariety
    have : IsProper sZ := isProper_of_isProjectiveMorphism sZ hZ.isProjective
    exact (quasiCompact_iff_compactSpace sZ).mp inferInstance
  have hb := isFiniteTypeOverBase_situation hZ hπ hDC hfree A
  obtain ⟨d, hd, hL, hamp⟩ := exists_pos_isRelativelyAmple_twistSheaf A.situation
    (isFiniteType_piece A hπ' hDC 0 le_rfl) hb
  obtain ⟨eq⟩ := nonempty_pullback_twistSheaf_iso hDC hfree A hq d
  generalize Stacks.RelativeProj.Situation.twistSheaf A.situation (d : ℤ) = L at hL hamp eq
  have hH : Stacks.Ample.IsInvertibleModule V ((Scheme.Modules.pullback e.hom).obj L) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback (hL := hL)
      e.hom.toLRSHom.toShHom _
  refine ⟨d, hd, _, hH, ?_, ⟨(Scheme.Modules.pullbackComp q e.hom).app L ≪≫ eq⟩⟩
  subst he
  intro y
  obtain ⟨W, hW, hyW, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens
    (show y ∈ (⊤ : Z.Opens) from trivial)
  refine ⟨W, hW, hyW, ?_⟩
  have hA := hamp.2 W hW
  let φ := e.hom ∣_ (A.situation.relativeProjToBase ⁻¹ᵁ W)
  have hφ : φ ≫ (A.situation.relativeProjToBase ⁻¹ᵁ W).ι =
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).ι ≫ e.hom :=
    morphismRestrict_ι _ _
  have h1 : Stacks.Ample.IsInvertibleModule (A.situation.relativeProjToBase ⁻¹ᵁ W).toScheme
      ((modulePullback (A.situation.relativeProjToBase ⁻¹ᵁ W).ι.toLRSHom.toShHom).obj L) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback (hL := hL)
      (A.situation.relativeProjToBase ⁻¹ᵁ W).ι.toLRSHom.toShHom _
  have h3 : Stacks.Ample.IsInvertibleModule
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).toScheme
      (Stacks.AmpleLocallyClosed.pullbackModule φ
        ((modulePullback (A.situation.relativeProjToBase ⁻¹ᵁ W).ι.toLRSHom.toShHom).obj L)) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback (hL := h1) φ.toLRSHom.toShHom _
  have hA' := @Stacks.AmplePullback.isAmple_modulePullback_of_isClosedImmersion _ _ φ _ h1 _ hA
  have h2 : Stacks.Ample.IsInvertibleModule
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).toScheme
      ((modulePullback
        (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).ι.toLRSHom.toShHom).obj
        ((Scheme.Modules.pullback e.hom).obj L)) :=
    Stacks.RingedSpace.algebraicGeometryIsInvertible_modulePullback
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).ι.toLRSHom.toShHom _
  have h3' : Stacks.Ample.IsInvertibleModule ((e.hom ≫ A.toBase) ⁻¹ᵁ W).toScheme
      (Stacks.AmpleLocallyClosed.pullbackModule φ
        ((modulePullback (A.situation.relativeProjToBase ⁻¹ᵁ W).ι.toLRSHom.toShHom).obj L)) := h3
  have h2' : Stacks.Ample.IsInvertibleModule ((e.hom ≫ A.toBase) ⁻¹ᵁ W).toScheme
      ((modulePullback ((e.hom ≫ A.toBase) ⁻¹ᵁ W).ι.toLRSHom.toShHom).obj
        ((Scheme.Modules.pullback e.hom).obj L)) := h2
  refine (@Stacks.RelativeVeryAmple.isAmple_congr _ _ _ h3' h2' ?_).mp hA'
  exact (Scheme.Modules.pullback φ).mapIso
      ((AlgebraicGeometry.modulePullbackIsoSchemePullback
        (A.situation.relativeProjToBase ⁻¹ᵁ W).ι).app L) ≪≫
    (Scheme.Modules.pullbackComp φ (A.situation.relativeProjToBase ⁻¹ᵁ W).ι).app L ≪≫
    (Scheme.Modules.pullbackCongr hφ).app L ≪≫
    ((Scheme.Modules.pullbackComp
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).ι e.hom).app L).symm ≪≫
    ((AlgebraicGeometry.modulePullbackIsoSchemePullback
      (e.hom ⁻¹ᵁ (A.situation.relativeProjToBase ⁻¹ᵁ W)).ι).app _).symm

/-! ### The ample model as a normal variety birational to `M` -/

/-- **The ample model is a normal variety, and `q` is proper and birational**: for an ample-model
datum `(M, B_M, q, V, B_V)` of `f : X ⟶ Z` with structure morphism `p : V ⟶ Z`, `q ≫ p = π_M`, `V`
is integral, `V` and `M` are normal varieties over `ℂ` through `p`, and `q` is proper and
birational. -/
public theorem IsAmpleModelDatum.isProper_and_isBirationalMorphism {X Z M V : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral M]
    [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M] [IsNormal V]
    {sX : X ⟶ Spec (CommRingCat.of ℂ)} {sZ : Z ⟶ Spec (CommRingCat.of ℂ)}
    {sM : M ⟶ Spec (CommRingCat.of ℂ)} [QuasiCompact sM] {K : Divisor X}
    {B : QDivisor X} {f : X ⟶ Z} {KM : Divisor M} {BM : QDivisor M} {φ : X.RationalMap M}
    {πM : M ⟶ Z} {q : M ⟶ V} {p : V ⟶ Z} {BV : QDivisor V}
    (h : IsAmpleModelDatum sX sZ sM K B f KM BM φ πM q p BV) :
    q ≫ p = πM ∧ ∃ _ : IsIntegral V, IsNormalVariety ℂ (p ≫ sZ) ∧
      IsNormalVariety ℂ (q ≫ p ≫ sZ) ∧ IsProper q ∧ IsBirationalMorphism q := by
  obtain ⟨k, hk, D, hD, hDC, hfree, A, e, he, hind⟩ := h.isRelativeAmpleModel
  have hlm := h.isGoodLogMinimalModel
  have hqp : q ≫ p = πM := by
    have := hind.comp_toBase
    rwa [Category.assoc, he] at this
  obtain ⟨hproj, hbir⟩ := h.isProjectiveMorphism_and_isBirationalMorphism
  have : IsReduced A.model := isReduced_model A
  have : IsReduced V := isReduced_of_isOpenImmersion e.hom
  have : IsDominant (q ≫ e.hom) := isDominant_of_isInducedMorphism A hind
    fun _ _ _ a ha => generatingLocus_nonempty A _ a ha
  have : IsDominant q := by
    have : IsDominant ((q ≫ e.hom) ≫ e.inv) := inferInstance
    simpa using this
  have : IrreducibleSpace V := by
    have hirr : IsIrreducible (Set.range q) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ M).image _ q.continuous.continuousOn
    have h' := hirr.closure
    rw [q.denseRange.closure_range] at h'
    exact (irreducibleSpace_def V).mpr h'
  have : IsIntegral V := isIntegral_of_irreducibleSpace_of_isReduced V
  have hZv := h.isProjectiveVariety_target.toIsVariety
  have : IsProper p := isProper_of_isProjectiveMorphism p hproj
  have : IsProper πM := isProper_of_isProjectiveMorphism πM hlm.isProjectiveMorphism_model
  have : IsProper (q ≫ p) := by
    rw [hqp]
    infer_instance
  have : IsProper q := IsProper.of_comp q p
  have hV : IsNormalVariety ℂ (p ≫ sZ) := ⟨{}, inferInstance⟩
  refine ⟨hqp, ‹IsIntegral V›, hV, ⟨{}, inferInstance⟩, inferInstance, ?_⟩
  -- `q` is birational: it is an isomorphism from an open of `M` onto the part of `V` over `O`.
  have : IrreducibleSpace Z :=
    Function.Surjective.irreducibleSpace f.continuous h.isContraction.surjective
  obtain ⟨T, g, ⟨t⟩, hg, hgπ⟩ := exists_isOpenImmersion_comp h.isBirationalMorphism
    hlm.isBirational hlm.isOver
  have : IsOpenImmersion ((g ≫ q) ≫ p) := by simpa [hqp] using hgπ
  have : IsDominant g := ⟨g.isOpenEmbedding.isOpenMap.isOpen_range.dense ⟨g t, t, rfl⟩⟩
  have hiso := isIso_morphismRestrict p (g ≫ q)
  set O := ((g ≫ q) ≫ p).opensRange with hO
  have hle : g.opensRange ≤ q ⁻¹ᵁ (p ⁻¹ᵁ O) := by
    rintro _ ⟨x, rfl⟩
    exact ⟨x, rfl⟩
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE q g.opensRange (p ⁻¹ᵁ O)
    ⟨g t, t, rfl⟩ ⟨q (g t), t, rfl⟩ hle ?_
  have hcomp : q.resLE (p ⁻¹ᵁ O) g.opensRange hle ≫ p ∣_ O =
      g.isoOpensRange.inv ≫ ((g ≫ q) ≫ p).isoOpensRange.hom := by
    rw [← cancel_mono O.ι, Category.assoc, morphismRestrict_ι, Scheme.Hom.resLE_comp_ι_assoc,
      Category.assoc, Scheme.Hom.isoOpensRange_hom_ι, Iso.eq_inv_comp]
    simp only [← Category.assoc, Scheme.Hom.isoOpensRange_hom_ι]
  have : IsIso (q.resLE (p ⁻¹ᵁ O) g.opensRange hle ≫ p ∣_ O) := by
    rw [hcomp]
    infer_instance
  exact IsIso.of_isIso_comp_right _ (p ∣_ O)

/-! ### The adjoint divisor of the ample model -/

/-- **The relative ample model carries an ample twist which is a multiple of `K_V + B_V`.** -/
private theorem exists_ample_twist {X Z M V : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral M] [CompactSpace M] [IsLocallyNoetherian M]
    [IsNormal M] [CompactSpace V] [IsLocallyNoetherian V] [IsNormal V]
    {sX : X ⟶ Spec (CommRingCat.of ℂ)} {sZ : Z ⟶ Spec (CommRingCat.of ℂ)}
    {sM : M ⟶ Spec (CommRingCat.of ℂ)} [QuasiCompact sM] {K : Divisor X}
    {B : QDivisor X} {f : X ⟶ Z} {KM : Divisor M} {BM : QDivisor M} {φ : X.RationalMap M}
    {πM : M ⟶ Z} {q : M ⟶ V} {p : V ⟶ Z} {BV : QDivisor V}
    (h : IsAmpleModelDatum sX sZ sM K B f KM BM φ πM q p BV) {KV : Divisor V} {n : ℕ}
    (hKV : Divisor.IsCanonicalDivisor (p ≫ sZ) n KV) :
    ∃ k : ℕ, 0 < k ∧ ∃ (H : V.Modules) (_ : Stacks.Ample.IsInvertibleModule V H),
      MMP.Mori.IsRelativelyAmple p H ∧ ∃ E : Divisor V, E.IsCartier ∧
      Divisor.toQDivisor E = (k : ℤ) • (Divisor.toQDivisor KV + BV) ∧
      Nonempty (E.divisorialSheaf ≅ H) := by
  obtain ⟨hqp, hVi, hV, hM, hqprop, hqb⟩ := h.isProper_and_isBirationalMorphism
  obtain ⟨k, hk, D, hD, hDC, hfree, A, e, he, hind⟩ := h.isRelativeAmpleModel
  have hlm := h.isGoodLogMinimalModel
  obtain ⟨d, hd, H, hH, hamp, ⟨eH⟩⟩ :=
    DivisorialSectionAlgebra.exists_isRelativelyAmple_pullback_iso h.isProjectiveVariety_target
      hlm.isProjectiveMorphism_model hDC hfree A e he hind
  obtain ⟨hTc, ⟨eT⟩⟩ := isCartier_transformDivisor_and_iso hV hM hqb H eH
  obtain ⟨n', hKM⟩ := hlm.isCanonicalDivisor
  have hsM : sM = q ≫ p ≫ sZ := by rw [← hlm.comp_eq_model, ← hqp, Category.assoc]
  subst hsM
  obtain ⟨χ, hχ⟩ := linearlyEquivalent_transformDivisor hV hM hqb hKV hKM
  set T : Divisor V := RationalMap.transformDivisor (X := M) q.toRationalMap ((d : ℤ) • D)
    with hT
  refine ⟨d * k, Nat.mul_pos hd hk, H, hH, hamp, T - principalDivisor (χ ^ (d * k)),
    hTc.sub (Divisor.isCartier_principalDivisor _), ?_,
    ⟨Divisor.LinearlyEquivalent.divisorialSheafIso
      (⟨(χ ^ (d * k))⁻¹, by rw [MMP.Mori.principalDivisor_inv]; abel⟩ :
        Divisor.LinearlyEquivalent (T - principalDivisor (χ ^ (d * k))) T) ≪≫ eT⟩⟩
  refine Finsupp.ext fun P => ?_
  obtain ⟨E, -, -, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hV hM hqb P
  have htrZ := @htr ℤ _
  have htrQ := @htr ℚ _
  have hχP := congrArg (fun G : Divisor V => G P) hχ
  have hDE := congrArg (fun G : QDivisor M => G E) hD
  rw [h.boundary_eq]
  have hTP : T P = (d : ℤ) * D E := by rw [hT, htrZ, Finsupp.smul_apply, smul_eq_mul]
  have hχP' : P.ord χ = KM E - KV P := by
    rw [Finsupp.sub_apply, htrZ] at hχP
    rw [← coeff_principalDivisor]
    exact hχP.symm
  have hpow : (principalDivisor (χ ^ (d * k))) P = ((d * k : ℕ) : ℤ) * (KM E - KV P) := by
    change DivisorWithCoeffs.coeff _ P = _
    rw [coeff_principalDivisor, PrimeDivisor.ord_pow, hχP', nsmul_eq_mul]
  have hDE' : ((D E : ℤ) : ℚ) = (k : ℚ) * ((KM E : ℚ) + BM E) := hDE
  have hBV := htrQ BM
  change (((T - principalDivisor (χ ^ (d * k))) P : ℤ) : ℚ) =
    ((d * k : ℕ) : ℤ) • ((KV P : ℚ) + (RationalMap.transformDivisor (X := M) q.toRationalMap BM) P)
  rw [Finsupp.sub_apply, hTP, hpow, hBV, zsmul_eq_mul]
  push_cast
  rw [hDE']
  ring

/-- Relative ampleness of an invertible sheaf depends only on its isomorphism class. -/
private theorem isRelativelyAmple_of_iso {V Z : Scheme.{0}} (p : V ⟶ Z) {N N' : V.Modules}
    [Stacks.Ample.IsInvertibleModule V N] [Stacks.Ample.IsInvertibleModule V N'] (e : N ≅ N')
    (h : MMP.Mori.IsRelativelyAmple p N) : MMP.Mori.IsRelativelyAmple p N' := by
  intro y
  obtain ⟨W, hW, hy, hA⟩ := h y
  exact ⟨W, hW, hy, (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((modulePullback (p ⁻¹ᵁ W).ι.toLRSHom.toShHom).mapIso e)).mp hA⟩

variable {X Z M V : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] [IsIntegral M] [CompactSpace M] [IsLocallyNoetherian M] [IsNormal M]
  [CompactSpace V] [IsLocallyNoetherian V] [IsNormal V]

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral in
/-- For an ample-model datum `(M, B_M, q, V, B_V)` of a birational contraction `f : X ⟶ Z`, with
structure morphism `p : V ⟶ Z`, and any canonical divisor `K_V` of `V`, the `ℚ`-divisor
`K_V + B_V` is `ℚ`-Cartier and ample over `Z`. -/
@[mmp "lem_oai4_c3_ample_model_adjoint_ample"]
public theorem IsAmpleModelDatum.isQCartier_and_hasRelativelyAmpleMultiple
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sM : M ⟶ Spec (.of ℂ)} [QuasiCompact sM]
    {K : Divisor X} {B : QDivisor X} {f : X ⟶ Z} {KM : Divisor M} {BM : QDivisor M}
    {φ : X.RationalMap M} {πM : M ⟶ Z} {q : M ⟶ V} {p : V ⟶ Z} {BV : QDivisor V}
    (h : IsAmpleModelDatum sX sZ sM K B f KM BM φ πM q p BV)
    {KV : Divisor V} {n : ℕ} (hKV : KV.IsCanonicalDivisor (p ≫ sZ) n) :
    (Divisor.toQDivisor KV + BV).IsQCartier ∧
      (Divisor.toQDivisor KV + BV).HasRelativelyAmpleMultiple p := by
  obtain ⟨k, hk, H, hH, hamp, E, hEc, hE, ⟨eE⟩⟩ := exists_ample_twist h hKV
  refine ⟨⟨k, by exact_mod_cast hk.ne', E, hE, hEc⟩, k, hk, E, hEc, hE, ?_⟩
  have := hEc.isInvertibleModule_divisorialSheaf
  exact isRelativelyAmple_of_iso p eE.symm hamp

end MMP.Fourfold
