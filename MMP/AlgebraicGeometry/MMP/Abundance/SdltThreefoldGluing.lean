open CategoryTheory AlgebraicGeometry

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **Globally semiample normalized adjoints glue on an sdlt threefold.** Let `(T, Δ; L)` be a
projective sdlt adjoint pair of dimension three over `ℂ` (`MMP.Fourfold.IsSdltAdjointPair`), with
normalization components `νᵢ : Tᵢ ⟶ T` and boundaries `Θᵢ = Cᵢ + Δᵢ`. Suppose that each
normalized adjoint `K_{Tᵢ} + Θᵢ` is semiample (`MMP.Fourfold.QDivisor.IsRelativelySemiample`
over `Spec ℂ`). Then `L` is semiample: there is `m > 0` with `mΔ` integral such that for every
point `x ∈ T` there is a global section `t` of `𝒪_T(mL)` — a family of rational `m`-canonical
forms on the `Tᵢ` which near every point of `T` is `ν^*f · g` for a function `f` and a local
generator `g` (`MMP.Fourfold.IsAdjointGeneratorOn`) — that generates `𝒪_T(mL)` on a
neighbourhood of `x`. -/
@[mmp "thm_fourfold_projective_sdlt_threefold_normalized_generation"]
public theorem IsSdltAdjointPair.exists_isAdjointGeneratorOn_of_isRelativelySemiample
    {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {Δ : QWeilDivisor T}
    {Θ : ∀ i, QDivisor (N.X i)} (h : IsSdltAdjointPair N 3 Δ Θ)
    (hsemi : ∀ i, ∃ K : Divisor (N.X i), K.IsCanonicalDivisor (N.n i ≫ sT) 3 ∧
      QDivisor.IsRelativelySemiample (N.n i ≫ sT) (Divisor.toQDivisor K + Θ i)) :
    ∃ m : ℕ, 0 < m ∧ (∀ Γ, ((m : ℚ) * Δ Γ).den = 1) ∧
      ∀ x : T, ∃ t : ∀ i, RationalPluriForms (N.n i ≫ sT) 3 m,
        (∀ y : T, ∃ (U : T.Opens) (_ : y ∈ U) (g : ∀ i, RationalPluriForms (N.n i ≫ sT) 3 m)
          (f : Γ(T, U)), IsAdjointGeneratorOn N 3 m Θ U g ∧
            ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
              t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i) ∧
        ∃ (U : T.Opens) (_ : x ∈ U), IsAdjointGeneratorOn N 3 m Θ U t := by revert T sT hT N Δ Θ h hsemi; first | exact Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation.solution | exact Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation.solution _ | exact Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation.solution _ _ | exact Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation.solution _ _ _ | exact Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation.solution _ _ _ _

end MMP.Fourfold

