/-! ### Crepant models and floors -/

/-- The normalization of a projective sdlt pair has finitely many components. -/
private theorem finite_ι {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n : ℕ} {Δ : QWeilDivisor T}
    {Θ : ∀ i, QDivisor (N.X i)} (h : IsSdltAdjointPair N n Δ Θ) : Finite N.ι := by
  haveI : IsProper sT := isProper_of_isProjectiveMorphism sT h.isProjectiveMorphism
  haveI : CompactSpace T := (quasiCompact_iff_compactSpace sT).mp inferInstance
  haveI : LocallyOfFiniteType sT := h.isNFold.1.2.1
  obtain ⟨φ, -⟩ := N.exists_iso
  haveI : IsFinite (slcCurveNormalization T hT) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sT) hT
  haveI : CompactSpace (Stacks.AlgebraicGeometry.Normalization.normalizationScheme T hT) :=
    QuasiCompact.compactSpace_of_compactSpace (slcCurveNormalization T hT)
  haveI : CompactSpace ↥(∐ N.X : Scheme.{0}) := (Scheme.homeoOfIso φ).symm.compactSpace
  haveI : CompactSpace (Σ i, N.X i) := (sigmaMk N.X).symm.compactSpace
  have hcov : (Set.univ : Set (Σ i, N.X i)) ⊆
      ⋃ i, Set.range (@Sigma.mk N.ι (fun j => ↥(N.X j)) i) := by
    rintro ⟨i, y⟩ -
    exact Set.mem_iUnion.mpr ⟨i, y, rfl⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover _ (fun i => isOpen_range_sigmaMk) hcov
  refine Set.finite_univ_iff.mp (t.finite_toSet.subset fun i _ => ?_)
  obtain ⟨x⟩ : Nonempty (N.X i) := inferInstance
  obtain ⟨j, hj, y, hy⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ ⟨i, x⟩))
  have hji : j = i := congrArg Sigma.fst hy
  exact hji ▸ hj

/-- Each normalization component `νᵢ : Tᵢ ⟶ T` of a scheme of finite type over a field is a
finite morphism: a clopen summand followed by the finite normalization. -/
private theorem isFinite_n {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    [LocallyOfFiniteType sT] (N : NormalizationComponents sT hT) (i : N.ι) :
    IsFinite (N.n i) := by
  obtain ⟨φ, hφ⟩ := N.exists_iso
  have hi : IsClosedImmersion (Limits.Sigma.ι N.X i) := by
    refine IsClosedImmersion.of_isPreimmersion _ ?_
    have : Set.range (Limits.Sigma.ι N.X i) = sigmaMk N.X '' Set.range (Sigma.mk i) := by
      ext x; simp [← sigmaMk_mk]
    rw [this]
    exact (sigmaMk N.X).isClosedMap _ isClosed_range_sigmaMk
  haveI : IsFinite (slcCurveNormalization T hT) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field k sT) hT
  have h1 : N.n i = Limits.Sigma.ι N.X i ≫ φ.hom ≫ slcCurveNormalization T hT := by
    rw [hφ, Limits.Sigma.ι_desc]
  rw [h1]
  infer_instance

/-- A finite morphism is quasi-projective: the structure sheaf of its source is relatively ample,
the inverse image of an affine open being affine. -/
private theorem isQuasiProjective_of_isFinite {X S : Scheme.{0}} (f : X ⟶ S) [IsFinite f] :
    IsQuasiProjective f := by
  refine ⟨⟨inferInstance, inferInstance⟩, Stacks.Ample.unitModule X,
    Stacks.Ample.isInvertibleModule_unit X, ?_⟩
  refine (Stacks.AmpleBridge.isRelativelyAmple_iff_isRelativelyAmple f
    (Stacks.Ample.unitModule X)).mp ?_
  refine (Stacks.RelativeAmple.isRelativelyAmple_unitModule_iff f).mpr ?_
  intro V hV
  have : IsAffine (f ⁻¹ᵁ V).toScheme := hV.preimage f
  infer_instance

/-- A finite morphism into a scheme which is H-projective over a field is H-projective over that
field. -/
private theorem isProjectiveMorphism_comp_of_isFinite {k : Type} [Field k]
    {Y' Y : Scheme.{0}} (g : Y' ⟶ Y) [IsFinite g] (sY : Y ⟶ Spec (.of k))
    (hY : IsProjectiveMorphism sY) : IsProjectiveMorphism (g ≫ sY) := by
  obtain ⟨L, hL, hLa⟩ := exists_isAmple_of_isQuasiProjective sY
    (Stacks.Ample.unitModule (Spec (.of k)))
    (Stacks.Ample.isAmple_unitModule_of_isAffine _)
    (isQuasiProjective_of_isHQuasiProjective sY hY.isHQuasiProjective)
  have hg : IsProjectiveMorphism g :=
    isProjectiveMorphism_iff_isHQuasiProjective_and_isProper.mpr
      ⟨isHQuasiProjective_of_isQuasiProjective g L hLa (isQuasiProjective_of_isFinite g),
        inferInstance⟩
  exact hg.comp hY

/-- The normalization components of a projective sdlt pair of dimension `n` are projective
varieties of dimension `n`. -/
private theorem isProjectiveVariety_and_dim {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n : ℕ} {Δ : QWeilDivisor T}
    {Θ : ∀ i, QDivisor (N.X i)} (h : IsSdltAdjointPair N n Δ Θ) (i : N.ι) :
    Mori.IsProjectiveVariety ℂ (N.n i ≫ sT) ∧ topologicalKrullDim (N.X i) = n := by
  haveI : LocallyOfFiniteType sT := h.isNFold.1.2.1
  haveI := isFinite_n N i
  refine ⟨(AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr ⟨(N.isNormalVariety i).1,
    isProjectiveMorphism_comp_of_isFinite (N.n i) sT h.isProjectiveMorphism⟩, ?_⟩
  obtain ⟨K, hK⟩ := h.exists_isDltPair i
  exact hK.1.2.1.1

/-- An epimorphic counit of `f^* ⊣ f_*` stays epimorphic along an isomorphism of modules. -/
private theorem epi_counit_of_iso {X Z : Scheme.{0}} (f : X ⟶ Z) {M N : X.Modules} (e : N ≅ M)
    (h : Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app M)) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app N) := by
  set adj := Scheme.Modules.pullbackPushforwardAdjunction f
  have hnat := adj.counit.naturality e.hom
  have heq : adj.counit.app N =
      (Scheme.Modules.pushforward f ⋙ Scheme.Modules.pullback f).map e.hom ≫
        adj.counit.app M ≫ e.inv := by
    rw [← Category.assoc, hnat, Functor.id_map, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  rw [heq]
  infer_instance

/-- **Relative generation pulls back.** If `f^* f_* L → L` is an epimorphism, so is the counit of
`(p ≫ f)^* ⊣ (p ≫ f)_*` at `p^* L`. -/
private theorem epi_counit_comp_pullback {X Y Z : Scheme.{0}} (p : Y ⟶ X) (f : X ⟶ Z) (L : X.Modules)
    (h : Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app L)) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction (p ≫ f)).counit.app
      ((Scheme.Modules.pullback p).obj L)) := by
  set ap := Scheme.Modules.pullbackPushforwardAdjunction p
  set af := Scheme.Modules.pullbackPushforwardAdjunction f
  set A := af.comp ap
  set d := (Scheme.Modules.pullback p).obj L
  -- the composite counit is epi
  have h1 : Epi (A.counit.app d) := by
    have key : (Scheme.Modules.pullback p).map (af.counit.app L) =
        (Scheme.Modules.pullback p).map ((Scheme.Modules.pullback f).map
          ((Scheme.Modules.pushforward f).map (ap.unit.app L))) ≫ A.counit.app d := by
      rw [Adjunction.comp_counit_app, ← Category.assoc, ← Functor.map_comp]
      have hn := af.counit.naturality (ap.unit.app L)
      simp only [Functor.comp_map, Functor.id_map] at hn
      erw [hn]
      rw [Functor.map_comp, Category.assoc]
      erw [ap.left_triangle_components]
      rw [Category.comp_id]
      rfl
    have : Epi ((Scheme.Modules.pullback p).map (af.counit.app L)) := inferInstance
    rw [key] at this
    exact epi_of_epi ((Scheme.Modules.pullback p).map ((Scheme.Modules.pullback f).map
      ((Scheme.Modules.pushforward f).map (ap.unit.app L)))) (A.counit.app d)
  have h2 := conjugateEquiv_counit A (Scheme.Modules.pullbackPushforwardAdjunction (p ≫ f))
    (Scheme.Modules.pullbackComp p f).inv d
  rw [Scheme.Modules.conjugateEquiv_pullbackComp_inv] at h2
  have h3 : Epi ((Scheme.Modules.pullback (p ≫ f)).map ((Scheme.Modules.pushforwardComp p f).hom.app d) ≫
      (Scheme.Modules.pullbackPushforwardAdjunction (p ≫ f)).counit.app d) := by
    rw [h2]; exact epi_comp' (IsIso.epi_of_iso ((Scheme.Modules.pullbackComp p f).app _).inv) h1
  exact epi_of_epi ((Scheme.Modules.pullback (p ≫ f)).map ((Scheme.Modules.pushforwardComp p f).hom.app d)) _

/-- The pull-back of a relatively free Cartier divisor along a dominant morphism of integral
schemes is relatively free over the composite. -/
private theorem isRelativelyFreeCartier_comp_of_isPullback {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] (p : Y ⟶ X) [IsDominant p] (f : X ⟶ Z) {E : X.CartierDivisor}
    {E' : Y.CartierDivisor} (hE : MMP.Intersection.IsPullback p E E')
    (h : IsRelativelyFreeCartier f E) : IsRelativelyFreeCartier (p ≫ f) E' := by
  obtain ⟨e⟩ := MMP.ProgramBaseChange.nonempty_pullback_sheaf_iso p hE
  exact epi_counit_of_iso (p ≫ f) e.symm (epi_counit_comp_pullback p f _ h)

open MMP.Intersection in
/-- In the function field, a fraction representation of a local equation `f = a/b` reads
`f b = a`. -/
private theorem totalQuotientStalkToFunctionField_mul_eq {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] {x : X} {f : X.totalQuotientSheaf.presheaf.stalk x}
    {a b : X.presheaf.stalk x} (h : IsFraction f a b) :
    totalQuotientStalkToFunctionField x f * algebraMap _ X.functionField b =
      algebraMap _ X.functionField a := by
  have := congrArg (totalQuotientStalkToFunctionField x) h.2
  rw [map_mul, totalQuotientStalkToFunctionField_stalkToTotalQuotient,
    totalQuotientStalkToFunctionField_stalkToTotalQuotient] at this
  rw [mul_comm]
  exact this

open MMP.Intersection in
/-- The order of a Cartier divisor along a prime divisor `P` is the order of any local equation at
the generic point of `P`. -/
private theorem ord_eq_primeDivisorOrder {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    (G : X.CartierDivisor) (P : Mori.PrimeDivisor X)
    {f : X.totalQuotientSheaf.presheaf.stalk P.genericPoint}
    (hf : IsLocalEquationAt G P.genericPoint f) :
    X.ord (totalQuotientStalkToFunctionField P.genericPoint f) P.genericPoint =
      primeDivisorOrder P G := by
  rw [← cartierMultiplicity_eq_ord_of_isLocalEquationAt hf]
  have hGP := isOrderAlong_primeDivisorOrder G P
  unfold IsOrderAlong at hGP
  dsimp only [primeDivisorSubvariety_genericPoint] at hGP
  obtain ⟨a, b, ha, hb, ⟨g, hg, hgab⟩, la, lb, hla, hlb, hN⟩ := hGP
  rw [cartierMultiplicity_eq_ord_of_isLocalEquationAt hg, hN]
  have hcoh : Order.coheight P.genericPoint = 1 :=
    AlgebraicGeometry.PrimeDivisor.coheight_genericPoint P
  have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
  have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
  have hbK : algebraMap (X.presheaf.stalk _) X.functionField b ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  have key := totalQuotientStalkToFunctionField_mul_eq hgab
  have hTg := totalQuotientStalkToFunctionField_ne_zero_of_isLocalEquationAt hg
  have hord := X.ord_mul (x := P.genericPoint) hTg hbK
  rw [key, ord_algebraMap_stalk _ hcoh a ha0,
    ord_algebraMap_stalk _ hcoh b hb0] at hord
  erw [hla, hlb, ENat.toNat_coe, ENat.toNat_coe] at hord
  omega

open MMP.Intersection in
/-- A local equation at a point `x` gives the order along every prime divisor through `x`. -/
private theorem ord_eq_primeDivisorOrder_of_mem {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (G : X.CartierDivisor) {x : X}
    {f : X.totalQuotientSheaf.presheaf.stalk x} (hf : IsLocalEquationAt G x f)
    (P : Mori.PrimeDivisor X) (hP : x ∈ P.support) :
    X.ord (totalQuotientStalkToFunctionField x f) P.genericPoint = primeDivisorOrder P G := by
  have hspec : P.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hP
    exact specializes_iff_mem_closure.mpr hP
  obtain ⟨U, hx, g, hg, rfl⟩ := hf
  have hηU : P.genericPoint ∈ U := hspec.mem_open U.isOpen hx
  have hf' : IsLocalEquationAt G P.genericPoint
      (X.totalQuotientSheaf.presheaf.germ U P.genericPoint hηU (g : _)) := ⟨U, hηU, g, hg, rfl⟩
  rw [← ord_eq_primeDivisorOrder G P hf', ← totalQuotientStalkToFunctionField_stalkSpecializes
    hspec, TopCat.Presheaf.germ_stalkSpecializes_apply]

open MMP.Intersection in
/-- **Orders of pull-backs of Cartier divisors.** If `E'` is the pull-back of `E` along a dominant
morphism of integral schemes `p`, then along every prime divisor `F` of the source the order of
`E'` is the order of the pull-back of a local equation of `E` at `p(η_F)`. -/
private theorem exists_primeDivisorOrder_isPullback {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsIntegral Y] [IsLocallyNoetherian Y] (p : Y ⟶ X) [IsDominant p]
    {E : X.CartierDivisor} {E' : Y.CartierDivisor} (h : IsPullback p E E')
    (F : Mori.PrimeDivisor Y) :
    ∃ f : X.totalQuotientSheaf.presheaf.stalk (p.base F.genericPoint),
      IsLocalEquationAt E _ f ∧ primeDivisorOrder F E' =
        Y.ord (functionFieldMap p (totalQuotientStalkToFunctionField _ f)) F.genericPoint := by
  obtain ⟨-, hy⟩ := h
  obtain ⟨a, b, ⟨g, hg, hgab⟩, -, hb, g', hg', hg'ab⟩ := hy F.genericPoint
  refine ⟨g, hg, ?_⟩
  rw [← ord_eq_primeDivisorOrder E' F hg']
  congr 1
  have h1 := totalQuotientStalkToFunctionField_mul_eq hg'ab
  have h2 := congrArg (functionFieldMap p) (totalQuotientStalkToFunctionField_mul_eq hgab)
  rw [map_mul, functionFieldMap_algebraMap_stalk, functionFieldMap_algebraMap_stalk] at h2
  have hb0 : algebraMap (Y.presheaf.stalk F.genericPoint) Y.functionField
      ((p.stalkMap F.genericPoint).hom b) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
  exact mul_right_cancel₀ hb0 (h1.trans h2.symm)

open MMP.Intersection in
/-- The order of the realization of `q C` along a prime divisor is `q` times the order of `C`. -/
private theorem primeDivisorOrder_realization {X : Scheme.{0}} [IsLocallyNoetherian X]
    (C : KCartierDivisor ℚ X) (q : ℕ)
    (hint : ∀ E, ∃ n : ℤ, ((q : ℚ) • C) E = n) (P : Mori.PrimeDivisor X) :
    (primeDivisorOrder P (KCartierDivisor.realization ((q : ℚ) • C) hint) : ℚ) =
      q * C.sum fun E c => c * (primeDivisorOrder P E : ℚ) := by
  classical
  unfold KCartierDivisor.realization
  have hc : ∀ E, ((Classical.choose (hint E) : ℤ) : ℚ) = (q : ℚ) * C E := fun E =>
    (Classical.choose_spec (hint E)).symm.trans (by simp)
  rw [map_finsuppSum]
  unfold Finsupp.sum
  rw [Int.cast_sum, Finset.mul_sum]
  simp only [map_zsmul, smul_eq_mul, Int.cast_mul, hc]
  rcases Nat.eq_zero_or_pos q with rfl | hq
  · simp
  · rw [Finsupp.support_smul_eq (by exact_mod_cast hq.ne')]
    refine Finset.sum_congr rfl fun E _ => ?_
    ring

open MMP.Intersection in
/-- **Crepant pull-backs of Cartier representatives.** Let `C` be the crepant boundary of
`(X, Θ)` on `p : Y ⟶ X` for the canonical divisor `K = div ω`, and `E` a Cartier divisor with
`[E] = q(K + Θ)`. Then the pull-back `E'` of `E` has `[E'] = q(div(p^*ω) + C)`. -/
private theorem primeDivisorOrder_pullback_eq_of_isCrepantBoundary {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) {n : ℕ} (hn : topologicalKrullDim X = n) {K₀ : Divisor X}
    {Θ : QDivisor X} {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (p : Y ⟶ X) [IsDominant p] (hY : IsNormalVariety ℂ (p ≫ sX)) (hp : IsBirationalMorphism p)
    {C : QDivisor Y} (hC : IsCrepantBoundary sX n K₀ Θ p hY hp C)
    {ω : RationalPluriForms sX n 1} (hω0 : ω ≠ 0) (hω : ∀ Γ : Mori.PrimeDivisor X,
      Γ.ordForm ω = K₀.coeff Γ)
    {E : X.CartierDivisor} {q : ℕ}
    (hE : ∀ Γ : Mori.PrimeDivisor X,
      (primeDivisorOrder Γ E : ℚ) = q * (Divisor.toQDivisor K₀ + Θ).coeff Γ)
    {E' : Y.CartierDivisor} (hpb : IsPullback p E E') (F : Mori.PrimeDivisor Y) :
    (primeDivisorOrder F E' : ℚ) =
      q * ((F.ordForm (pullbackRationalPluriForms sX p ω) : ℚ) + C.coeff F) := by
  let := functionFieldAlgebra sX
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  obtain ⟨g, hg, hord⟩ := exists_primeDivisorOrder_isPullback p hpb F
  set φ := totalQuotientStalkToFunctionField (p.base F.genericPoint) g with hφ_def
  have hφ0 : φ ≠ 0 := totalQuotientStalkToFunctionField_ne_zero_of_isLocalEquationAt hg
  set D : DivisorOver ℂ sX := ⟨Y, p, hY, hp, F⟩ with hD
  obtain ⟨-, -, m, hm, -, U, hxU, τ, hτ, hτa⟩ := hC F
  obtain ⟨b, N, hN⟩ := D.exists_ordPullback_eq hX hn
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  set t := (ZTensorPower.basis b (m : ℤ)).repr τ () with ht_def
  set w := (ZTensorPower.basis b 1).repr ω () with hw_def
  have ht0 : t ≠ 0 := repr_ne_zero_of_ne_zero b hτ.1
  have hw0 : w ≠ 0 := repr_ne_zero_of_ne_zero b hω0
  set ρ := t ^ (q : ℤ) * φ ^ (m : ℤ) * w ^ (-((q : ℤ) * m)) with hρ_def
  have hρ0 : ρ ≠ 0 :=
    mul_ne_zero (mul_ne_zero (zpow_ne_zero _ ht0) (zpow_ne_zero _ hφ0)) (zpow_ne_zero _ hw0)
  -- `ρ` is a unit at `x`
  have hρord : ∀ Γ : Mori.PrimeDivisor X, p.base F.genericPoint ∈ Γ.support → X.ord ρ Γ.genericPoint = 0 := by
    intro Γ hΓ
    obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
    have e1 := hτ.2 Γ ⟨p.base F.genericPoint, hΓ, hxU⟩
    rw [hNΓ _ _ hτ.1, ← ht_def] at e1
    have e2 := hω Γ
    rw [hNΓ _ _ hω0, ← hw_def] at e2
    have e3 := hE Γ
    rw [← ord_eq_primeDivisorOrder_of_mem E hg Γ hΓ, ← hφ_def] at e3
    rw [hρ_def, Scheme.ord_mul (mul_ne_zero (zpow_ne_zero _ ht0) (zpow_ne_zero _ hφ0))
      (zpow_ne_zero _ hw0), Scheme.ord_mul (zpow_ne_zero _ ht0) (zpow_ne_zero _ hφ0),
      ord_zpow _ ht0, ord_zpow _ hφ0, ord_zpow _ hw0]
    simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor] at e3
    have : ((q : ℤ) * X.ord t Γ.genericPoint + m * X.ord φ Γ.genericPoint +
        -((q : ℤ) * m) * X.ord w Γ.genericPoint : ℚ) = 0 := by
      rw [one_mul] at e2
      rw [← e2] at e3
      push_cast at e1 e3 ⊢
      linear_combination (q : ℚ) * e1 + (m : ℚ) * e3
    exact_mod_cast this
  obtain ⟨u, hu, hu'⟩ := exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero (p.base F.genericPoint) hρ0 hρord
  have hYρ : Y.ord (functionFieldMap p ρ) F.genericPoint = 0 := by
    rw [← hu', functionFieldMap_algebraMap_stalk]
    exact F.ord_algebraMap_of_isUnit (hu.map _)
  -- the orders on `Y`
  have f1 : (D.ordPullback τ : ℤ) = Y.ord (functionFieldMap p t) F.genericPoint + m * N :=
    hN _ τ hτ.1
  have f2 : (D.ordPullback ω : ℤ) = Y.ord (functionFieldMap p w) F.genericPoint + 1 * N :=
    hN _ ω hω0
  have hft0 : functionFieldMap p t ≠ 0 := (map_ne_zero _).mpr ht0
  have hfφ0 : functionFieldMap p φ ≠ 0 := (map_ne_zero _).mpr hφ0
  have hfw0 : functionFieldMap p w ≠ 0 := (map_ne_zero _).mpr hw0
  rw [hρ_def, map_mul, map_mul, map_zpow₀, map_zpow₀, map_zpow₀,
    Scheme.ord_mul (mul_ne_zero (zpow_ne_zero _ hft0) (zpow_ne_zero _ hfφ0))
      (zpow_ne_zero _ hfw0), Scheme.ord_mul (zpow_ne_zero _ hft0) (zpow_ne_zero _ hfφ0),
    ord_zpow _ hft0, ord_zpow _ hfφ0, ord_zpow _ hfw0] at hYρ
  rw [← hord] at hYρ
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  have key : (m : ℚ) * ((primeDivisorOrder F E' : ℚ) -
      q * ((F.ordForm (pullbackRationalPluriForms sX p ω) : ℚ) + C.coeff F)) = 0 := by
    have hτa' : (m : ℚ) * -C.coeff F = D.ordPullback τ := hτa
    have hωD : F.ordForm (pullbackRationalPluriForms sX p ω) = D.ordPullback ω := rfl
    rw [hωD]
    have f1' : (D.ordPullback τ : ℚ) = Y.ord (functionFieldMap p t) F.genericPoint + m * N := by
      exact_mod_cast f1
    have f2' : (D.ordPullback ω : ℚ) = Y.ord (functionFieldMap p w) F.genericPoint + N := by
      rw [one_mul] at f2; exact_mod_cast f2
    have hY' : ((q : ℤ) * Y.ord (functionFieldMap p t) F.genericPoint +
        m * primeDivisorOrder F E' + -((q : ℤ) * m) * Y.ord (functionFieldMap p w) F.genericPoint
        : ℚ) = 0 := by exact_mod_cast hYρ
    push_cast at hY'
    linear_combination hY' + (q : ℚ) * f1' - (q : ℚ) * m * f2' + (q : ℚ) * hτa'
  exact sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_left hm0)

/-- Pull-back of rational pluriforms along a birational morphism is injective. -/
private theorem pullbackRationalPluriForms_injective {k : Type} [Field k] [PerfectField k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    {d : ℕ} (hd : topologicalKrullDim X = d) (g : Y ⟶ X) [IsIntegral Y] [IsDominant g]
    (hg : IsBirationalMorphism g) (m : ℤ) :
    Function.Injective (pullbackRationalPluriForms (d := d) (m := m) sX g) := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (g ≫ sX)
  let := functionFieldMapAlgebra g
  have := isScalarTower_functionFieldMap sX g
  have hbij := hg.functionFieldMap_bijective
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX g hbij
    (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hd)
  set b := ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) m
  set b' := ZTensorPower.basis (basisOfSpanSingleton hω.2.1 hω.2.2) m
  have key : ∀ τ : RationalPluriForms sX d m,
      b'.repr (pullbackRationalPluriForms sX g τ) () = functionFieldMap g (b.repr τ ()) :=
    fun τ => by
      rw [show pullbackRationalPluriForms sX g τ = pullbackFormsAlong hω m τ from
        pullbackForms_eq hω m τ]
      exact repr_pullbackFormsAlong hω m τ
  intro τ τ' he
  have h1 := congrArg (fun x => b'.repr x ()) he
  simp only [key] at h1
  rw [← basis_unit_repr_smul b τ, ← basis_unit_repr_smul b τ', hbij.1 h1]

/-- Pull-back of rational pluriforms is `k`-linear. -/
private theorem pullbackRationalPluriForms_add_smul {k : Type} [Field k] {X Y : Scheme.{0}}
    [IsIntegral X] [IsIntegral Y] (sX : X ⟶ Spec (.of k)) (p : Y ⟶ X) [IsDominant p] {d : ℕ}
    {m : ℤ} (τ τ' : RationalPluriForms sX d m) (c : k) :
    pullbackRationalPluriForms sX p (τ + c • τ') =
      pullbackRationalPluriForms sX p τ + c • pullbackRationalPluriForms sX p τ' := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (p ≫ sX)
  let := functionFieldMapAlgebra p
  have := isScalarTower_functionFieldMap sX p
  rw [RationalPluriForms.smul_def, RationalPluriForms.smul_def]
  unfold pullbackRationalPluriForms
  have h1 := pullbackForms_add (k := k) (K := X.functionField) (K' := Y.functionField) (d := d)
    (m := m) τ (algebraMap k X.functionField c • τ')
  have h2 := pullbackForms_smul (k := k) (K := X.functionField) (K' := Y.functionField) (d := d)
    (m := m) (algebraMap k X.functionField c) τ'
  rw [← IsScalarTower.algebraMap_apply] at h2
  exact h1.trans (congrArg _ h2)

/-- The realization of a `ℚ`-Cartier divisor depends only on the divisor. -/
private theorem realization_congr {X : Scheme.{0}} {c c' : KCartierDivisor ℚ X} (e : c = c')
    (h : ∀ D, ∃ n : ℤ, c D = n) (h' : ∀ D, ∃ n : ℤ, c' D = n) :
    KCartierDivisor.realization c h = KCartierDivisor.realization c' h' := by
  subst e; rfl

open MMP.Intersection in
/-- A `ℚ`-divisor `Q` is semiample over the base if `nQ` is the Weil divisor of an `f`-free
Cartier divisor `E`, read through the orders of `E` along prime divisors. -/
private theorem isRelativelySemiample_of_primeDivisorOrder_eq {X Z : Scheme.{0}}
    [IsLocallyNoetherian X] (f : X ⟶ Z) (Q : QDivisor X) {n : ℕ} (hn : 0 < n)
    {E : X.CartierDivisor} (hE : ∀ P, (primeDivisorOrder P E : ℚ) = n * Q.coeff P)
    (hfree : IsRelativelyFreeCartier f E) : QDivisor.IsRelativelySemiample f Q := by
  classical
  have hn' : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  refine ⟨Finsupp.single E ((n : ℚ)⁻¹), fun P => ?_, n, hn, ?_⟩
  · rw [Finsupp.sum_single_index (by simp), hE P]
    field_simp
  · have hc : (n : ℚ) • Finsupp.single E ((n : ℚ)⁻¹) =
        (Finsupp.single E (1 : ℤ)).mapRange (Int.cast : ℤ → ℚ) Int.cast_zero := by
      rw [Finsupp.smul_single, Finsupp.mapRange_single, smul_eq_mul, mul_inv_cancel₀ hn',
        Int.cast_one]
    refine ⟨fun D => ⟨(Finsupp.single E (1 : ℤ)) D, by rw [hc]; rfl⟩, ?_⟩
    rw [realization_congr hc _ (fun D => ⟨(Finsupp.single E (1 : ℤ)) D, rfl⟩),
      KCartierDivisor.realization_eq_sum, Finsupp.sum_single_index (by simp), one_smul]
    exact hfree

open MMP.Intersection in
/-- A dominant morphism of integral locally Noetherian schemes satisfies the pull-back condition
for every Cartier divisor. -/
private theorem pullbackCondition_of_isDominant {X X' : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsIntegral X'] [IsLocallyNoetherian X'] (μ : X' ⟶ X) [IsDominant μ]
    (A : X.CartierDivisor) : PullbackCondition μ A := by
  intro η hη hμη
  rw [AlgebraicGeometry.schemeAssociatedPoints_eq_singleton_genericPoint] at hη
  rw [Set.mem_singleton_iff.mp hη] at hμη
  have hsub : (Set.univ : Set X') ⊆ μ ⁻¹' cartierSupport A := by
    rw [← genericPoint_spec X']
    exact closure_minimal (Set.singleton_subset_iff.mpr hμη)
      ((isClosed_cartierSupport A).preimage μ.continuous)
  have hdense : closure (Set.range μ) ⊆ cartierSupport A :=
    closure_minimal (by rintro _ ⟨y, rfl⟩; exact hsub (Set.mem_univ y))
      (isClosed_cartierSupport A)
  rw [μ.denseRange.closure_range] at hdense
  haveI : IsArtinianRing (X.presheaf.stalk (genericPoint X)) :=
    (inferInstance : IsArtinianRing X.functionField)
  exact notMem_cartierSupport_of_isArtinianRing A (genericPoint X) (hdense (Set.mem_univ _))

/-- **Crepant pull-backs of semiample adjoints are semiample.** If `C` is the crepant boundary of
`(X, Θ)` on a projective birational model `p : Y ⟶ X` and `K_X + Θ` is semiample, then
`K_Y + C` is semiample for every canonical divisor `K_Y` of `Y`. -/
private theorem exists_isRelativelySemiample_of_isCrepantBoundary {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX) {n : ℕ}
    (hn : topologicalKrullDim X = n) {Θ : QDivisor X}
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (p : Y ⟶ X) [IsDominant p] (hY : IsNormalVariety ℂ (p ≫ sX))
    (hp : IsBirationalMorphism p) {C : QDivisor Y}
    (hC : ∀ K : Divisor X, K.IsCanonicalDivisor sX n → IsCrepantBoundary sX n K Θ p hY hp C)
    (hsemi : ∃ K : Divisor X, K.IsCanonicalDivisor sX n ∧
      QDivisor.IsRelativelySemiample sX (Divisor.toQDivisor K + Θ))
    {KY₁ : Divisor Y} (hKY₁ : KY₁.IsCanonicalDivisor (p ≫ sX) n) :
    ∃ KY : Divisor Y, KY.IsCanonicalDivisor (p ≫ sX) n ∧
      QDivisor.IsRelativelySemiample (p ≫ sX) (Divisor.toQDivisor KY + C) := by
  classical
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (p ≫ sX) := hY.1.toLocallyOfFiniteType
  obtain ⟨K₀, hK₀, C₀, hcoef, q, hq, hint, hfree⟩ := hsemi
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK₀
  set E := KCartierDivisor.realization ((q : ℚ) • C₀) hint with hE_def
  obtain ⟨E', hE'⟩ := MMP.Intersection.exists_isPullback (pullbackCondition_of_isDominant p E)
  have hpω0 : pullbackRationalPluriForms sX p ω ≠ 0 := by
    intro h0
    have hz : pullbackRationalPluriForms sX p (0 : RationalPluriForms sX n 1) = 0 := by
      have := pullbackRationalPluriForms_add_smul sX p (0 : RationalPluriForms sX n 1) 0 (1 : ℂ)
      rw [one_smul, add_zero, one_smul] at this
      exact left_eq_add.mp this
    exact hω0 (pullbackRationalPluriForms_injective sX hn p hp _ (h0.trans hz.symm))
  set KY := divisorOfForm (pullbackRationalPluriForms sX p ω) with hKY_def
  have hKY : KY.IsCanonicalDivisor (p ≫ sX) n := hKY₁.of_linearlyEquivalent (by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hY hKY₁ hpω0)
  have hEord : ∀ Γ : Mori.PrimeDivisor X, (MMP.Intersection.primeDivisorOrder Γ E : ℚ) =
      q * (Divisor.toQDivisor K₀ + Θ).coeff Γ := fun Γ => by
    rw [hE_def, primeDivisorOrder_realization, hcoef Γ]
  refine ⟨KY, hKY, isRelativelySemiample_of_primeDivisorOrder_eq (p ≫ sX) _ hq (fun F => ?_)
    (isRelativelyFreeCartier_comp_of_isPullback p sX hE' hfree)⟩
  rw [primeDivisorOrder_pullback_eq_of_isCrepantBoundary hX hn p hY hp (hC K₀ hK₀) hω0 hω hEord
    hE' F]
  simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, hKY_def, coeff_divisorOfForm]

/-- **Crepant `ℚ`-factorial dlt models.** A projective dlt threefold pair `(X, Θ)` over `ℂ` with
semiample adjoint has a crepant projective birational model `(Y, C)` which is a `ℚ`-factorial
projective dlt pair with semiample adjoint. -/
private theorem exists_crepantModel {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : Mori.IsProjectiveVariety ℂ sX)
    (hdim : topologicalKrullDim X = 3) {Θ : QDivisor X}
    (hdlt : ∃ K : Divisor X, Mori.IsDltPair sX 3 K Θ)
    (hsemi : ∃ K : Divisor X, K.IsCanonicalDivisor sX 3 ∧
      QDivisor.IsRelativelySemiample sX (Divisor.toQDivisor K + Θ)) :
    ∃ (Y : Scheme.{0}) (_ : IsIntegral Y) (_ : IsLocallyNoetherian Y) (_ : IsNormal Y)
      (p : Y ⟶ X) (_ : IsDominant p) (C : QDivisor Y),
      IsProjectiveMorphism p ∧
      (∃ (K : Divisor X) (hY : IsNormalVariety ℂ (p ≫ sX)) (hp : IsBirationalMorphism p),
        IsCrepantBoundary sX 3 K Θ p hY hp C) ∧
      Mori.IsProjectiveVariety ℂ (p ≫ sX) ∧ topologicalKrullDim Y = 3 ∧
      IsQFactorial (p ≫ sX) ∧ Fourfold.IsPair (p ≫ sX) C ∧
      MMP.Intersection.IsDltPair (p ≫ sX) C ∧
      ∃ KY : Divisor Y, KY.IsCanonicalDivisor (p ≫ sX) 3 ∧
        QDivisor.IsRelativelySemiample (p ≫ sX) (Divisor.toQDivisor KY + C) := by
  obtain ⟨K, hK⟩ := hdlt
  have hKc : K.IsCanonicalDivisor sX 3 := hK.1.2.1
  have hlc : MMP.Intersection.IsLogCanonicalPair sX Θ :=
    ((MMP.Threefold.Bridges.isDltPair_iff_isDltPair sX hKc Θ).mpr hK).1
  obtain ⟨Y, hYi, hYl, hYn, p, hp, hYQ, C, hproj, hCdlt, hcrep, -⟩ :=
    projectiveFloorProgramInputs_three.exists_crepant_dltModification sX hX hdim hlc
  haveI := hp.isDominant
  have hYv : IsNormalVariety ℂ (p ≫ sX) := hYQ.1
  haveI : LocallyOfFiniteType (p ≫ sX) := hYv.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  have hYdim : topologicalKrullDim Y = 3 := by
    rw [topologicalKrullDim_eq_toNat_trdeg (p ≫ sX),
      ← trdeg_functionField_eq_of_bijective sX p hp.functionFieldMap_bijective,
      toNat_trdeg_functionField_of_topologicalKrullDim_eq hdim]
    rfl
  obtain ⟨-, e, KY₁, hKY₁, -⟩ := hCdlt.1.1
  have he : e = 3 := by
    have := hKY₁.topologicalKrullDim_eq.symm.trans hYdim
    exact_mod_cast this
  subst he
  haveI : QuasiCompact sX := hX.toQuasiCompact
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : QuasiCompact (p ≫ sX) := hYv.1.toQuasiCompact
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  obtain ⟨KY, hKY, hKYs⟩ := exists_isRelativelySemiample_of_isCrepantBoundary ⟨hX.toIsVariety, inferInstance⟩
    hdim p hYv hp hcrep hsemi hKY₁
  refine ⟨Y, hYi, hYl, hYn, p, inferInstance, C, hproj, ⟨K, hYv, hp, hcrep K hKc⟩,
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr ⟨hYv.1, hproj.comp hX.isProjective⟩,
    hYdim, hYQ, ⟨inferInstance, inferInstance, hCdlt.1.1, hCdlt.1.2.1⟩, hCdlt, KY, hKY, hKYs⟩

/-! ### Weil divisors and relative freeness -/

section Conversion

open MMP.Intersection

/-- The order of a regular function at a point of coheight one is the length of its quotient. -/
private theorem scheme_ord_algebraMap {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    {z : X} (hz : Order.coheight z = 1) {a : X.presheaf.stalk z} (ha : a ≠ 0) :
    X.ord (algebraMap (X.presheaf.stalk z) X.functionField a) z = (Ring.ord _ a).toNat := by
  have : Ring.KrullDimLE 1 (X.presheaf.stalk z) := krullDimLE_of_coheight_le hz.le
  have hne : algebraMap (X.presheaf.stalk z) X.functionField a ≠ 0 := by
    rwa [Ne, IsFractionRing.to_map_eq_zero_iff]
  rw [Scheme.ord_eq_iff hz hne]
  unfold Scheme.ordHom
  rw [Ring.ordFrac_eq_ord _ ha]
  have hnzd : a ∈ nonZeroDivisors _ := mem_nonZeroDivisors_of_ne_zero ha
  exact Ring.ordMonoidWithZeroHom_eq_coe (R := X.presheaf.stalk z) hnzd
    (ENat.natCast_toNat (Ring.ord_ne_top hnzd)).symm

open MMP.Intersection in
/-- On an integral locally Noetherian scheme, a point of coheight zero lies in the support of no
Cartier divisor. -/
private theorem notMem_cartierSupport_of_coheight_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (A : X.CartierDivisor) {x : X} (hx : Order.coheight x = 0) :
    x ∉ cartierSupport A := by
  have : Ring.KrullDimLE 0 (X.presheaf.stalk x) := krullDimLE_of_coheight_le (by simp [hx])
  have : IsArtinianRing (X.presheaf.stalk x) := isArtinianRing_iff_krullDimLE_zero.mpr this
  exact notMem_cartierSupport_of_isArtinianRing A x

/-- Every Cartier divisor on a Noetherian integral scheme has a Weil divisor. -/
private theorem exists_isWeilDivisorOfCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [TopologicalSpace.NoetherianSpace X] (A : X.CartierDivisor) :
    ∃ w : Divisor X, IsWeilDivisorOfCartier A w := by
  have hfin := MMP.Mori.finite_setOf_genericPoint_mem (isClosed_cartierSupport A)
    (fun s hs h0 => notMem_cartierSupport_of_coheight_eq_zero A h0 hs)
  refine ⟨Finsupp.ofSupportFinite (fun P => primeDivisorOrder P A) (hfin.subset fun P hP => ?_),
    fun P => ?_⟩
  · by_contra h
    have hg : (primeDivisorSubvariety P).genericPoint = P.genericPoint := rfl
    refine hP ((isOrderAlong_primeDivisorOrder A P).eq_zero_of_not_subset fun h' => h ?_)
    show P.genericPoint ∈ cartierSupport A
    rw [← hg]
    exact genericPoint_mem_cartierSupport_iff.mpr h'
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.ofSupportFinite_coe]
    exact isOrderAlong_primeDivisorOrder A P

/-- The Weil divisor of the realization of `q • C`, for a `ℚ`-Cartier divisor `C` with Weil
`ℚ`-divisor `D`, is `q • D`. -/
private theorem coeff_eq_mul_of_isWeilDivisorOfCartier_realization {X : Scheme.{0}}
    [IsLocallyNoetherian X] {D : QDivisor X} {C : KCartierDivisor ℚ X}
    (hC : ∀ P : MMP.Mori.PrimeDivisor X,
      D.coeff P = C.sum fun E c => c * (primeDivisorOrder P E : ℚ)) {q : ℕ}
    (h : ∀ E, ∃ n : ℤ, ((q : ℚ) • C) E = n) {B : Divisor X}
    (hB : IsWeilDivisorOfCartier (KCartierDivisor.realization ((q : ℚ) • C) h) B)
    (P : MMP.Mori.PrimeDivisor X) : (B.coeff P : ℚ) = q * D.coeff P := by
  classical
  have hc : ∀ E, ((Classical.choose (h E) : ℤ) : ℚ) = ((q : ℚ) • C) E := fun E =>
    (Classical.choose_spec (h E)).symm
  rw [← (hB P).primeDivisorOrder_eq, KCartierDivisor.realization, Finsupp.sum, map_sum,
    Int.cast_sum, hC P, Finsupp.sum, Finset.mul_sum]
  have hz : ∀ E ∈ C.support, E ∉ ((q : ℚ) • C).support →
      (q : ℚ) * (C E * (primeDivisorOrder P E : ℚ)) = 0 := fun E _ hE => by
    rw [Finsupp.notMem_support_iff, Finsupp.smul_apply, smul_eq_mul] at hE
    rw [← mul_assoc, hE, zero_mul]
  rw [← Finset.sum_subset (Finsupp.support_smul (b := (q : ℚ)) (g := C)) hz]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [map_zsmul, smul_eq_mul, Int.cast_mul, hc, Finsupp.smul_apply, smul_eq_mul, mul_assoc]

/-- An integral scheme is its own unique irreducible component. -/
private theorem univ_mem_irreducibleComponents (X : Scheme.{0}) [IsIntegral X] :
    (Set.univ : Set X) ∈ irreducibleComponents X := by
  rw [irreducibleComponents_eq_singleton]; rfl

private theorem specializes_genericPoint {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : componentGenericPoint Y Z ⤳ genericPoint Y :=
  (Inseparable.of_eq (componentGenericPoint_eq_genericPoint Z)).specializes

private theorem genericPoint_specializes {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : genericPoint Y ⤳ componentGenericPoint Y Z :=
  (genericPoint_spec Y).specializes trivial

/-- A rational function `φ ∈ K(Y)`, read in every factor of `K(Y) = ∏_Z 𝒪_{Y,η_Z}`. -/
private noncomputable def toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y] :
    Y.functionField →+* RationalFunctions Y :=
  Pi.ringHom fun Z => (Y.presheaf.stalkSpecializes (specializes_genericPoint Z)).hom

private theorem stalkSpecializes_toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) (φ : Y.functionField) :
    (Y.presheaf.stalkSpecializes (genericPoint_specializes Z)).hom
      (toRationalFunctions φ Z) = φ := by
  change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom φ) = φ
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- `v_P` on the factor `𝒪_{Y,η}` of `K(Y)` is the inverse of the divisorial valuation of the
corresponding rational function. -/
private theorem valuation_eq_inv_divisorialValuation {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y)
    (s : Y.presheaf.stalk (componentGenericPoint Y P.component)) :
    P.valuation s = (P.divisorialValuation
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes P.component)).hom s))⁻¹ := by
  rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
  rfl

/-- The order along `P` of the unit of `K(Y)` defined by `φ ≠ 0` is `ord_{η_P}(φ)`. -/
private theorem ord_toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y) {φ : Y.functionField}
    (hφ : φ ≠ 0) (ψ : (RationalFunctions Y)ˣ) (hψ : (ψ : RationalFunctions Y) =
      toRationalFunctions φ) : P.ord ψ = Scheme.ord φ P.genericPoint := by
  have h2 := valuation_eq_inv_divisorialValuation P ((ψ : RationalFunctions Y) P.component)
  rw [hψ, stalkSpecializes_toRationalFunctions, ← hψ, P.valuation_component,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hφ, ← WithZero.exp_neg,
    neg_neg] at h2
  exact WithZero.exp_injective h2

/-- A Cartier Weil divisor on a normal integral Noetherian scheme is the Weil divisor of a
Cartier divisor. -/
private theorem exists_isWeilDivisorOfCartier_of_isCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {L : Divisor X} (hL : L.IsCartier) :
    ∃ E : X.CartierDivisor, IsWeilDivisorOfCartier E L := by
  classical
  haveI : IsNoetherian X := ⟨⟩
  haveI := hL.isInvertibleModule_divisorialSheaf
  obtain ⟨E₀, ⟨e₀⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf L.divisorialSheaf
  obtain ⟨w, hw⟩ := exists_isWeilDivisorOfCartier E₀
  obtain ⟨e₁⟩ := hw.nonempty_sheaf_iso_divisorialSheaf
  obtain ⟨φ, hφ⟩ := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso (e₀ ≪≫ e₁)
  -- `φ` as a rational function `r₀` on the integral scheme `X`
  obtain ⟨Z₀⟩ : Nonempty (irreducibleComponents X) :=
    ⟨⟨Set.univ, univ_mem_irreducibleComponents X⟩⟩
  set r₀ : X.functionField := (X.presheaf.stalkSpecializes (genericPoint_specializes Z₀)).hom
    ((φ : RationalFunctions X) Z₀) with hr₀
  have hr : toRationalFunctions r₀ = (φ : RationalFunctions X) := by
    funext Z
    have hmem : ∀ W : irreducibleComponents X, (W : Set X) = Set.univ := fun W => by
      have h1 : (W : Set X) ∈ ({Set.univ} : Set (Set X)) := by
        rw [← irreducibleComponents_eq_singleton]; exact W.2
      exact h1
    have hZ : Z₀ = Z := Subtype.ext ((hmem Z₀).trans (hmem Z).symm)
    subst hZ
    change (X.presheaf.stalkSpecializes _).hom ((X.presheaf.stalkSpecializes _).hom _) = _
    rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_refl]
    rfl
  have hr0 : r₀ ≠ 0 := by
    intro h0
    haveI : Nontrivial (RationalFunctions X) := Pi.nontrivial_at Z₀
    rw [h0, map_zero] at hr
    exact φ.ne_zero hr.symm
  have hordφ : ∀ Q : MMP.Mori.PrimeDivisor X, Q.ord φ = Scheme.ord r₀ Q.genericPoint :=
    fun Q => ord_toRationalFunctions Q hr0 φ hr.symm
  -- the principal Cartier divisor of `r₀`
  set c : (X.totalQuotientSheaf.obj.obj (Opposite.op ⊤))ˣ :=
    MMP.CartierDivisorPullback.ofFunctionField (X' := X) ⊤ (Units.mk0 r₀ hr0) with hc
  set Pc := MMP.Intersection.principalDivisor c with hPc
  have hPord : ∀ Q : MMP.Mori.PrimeDivisor X,
      primeDivisorOrder Q Pc = Scheme.ord r₀ Q.genericPoint := by
    intro Q
    obtain ⟨⟨a, b⟩, hab⟩ :=
      IsLocalization.surj (nonZeroDivisors (X.presheaf.stalk Q.genericPoint)) r₀
    have hbK : algebraMap _ X.functionField (b : X.presheaf.stalk Q.genericPoint) ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
    have hb0 : (b : X.presheaf.stalk Q.genericPoint) ≠ 0 := nonZeroDivisors.ne_zero b.2
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [map_zero] at hab
      exact mul_ne_zero hr0 hbK hab
    have hloc : IsLocalEquationAt Pc Q.genericPoint
        (X.totalQuotientSheaf.presheaf.germ ⊤ Q.genericPoint trivial (c : _)) :=
      ⟨⊤, trivial, c, isLocalEquationOn_principalDivisor c, rfl⟩
    have hfrac : IsFraction (X.totalQuotientSheaf.presheaf.germ ⊤ Q.genericPoint trivial (c : _))
        a b := by
      refine ⟨isUnit_stalkToTotalQuotient_of_mem_nonZeroDivisors b.2, ?_⟩
      apply (totalQuotientStalkToFunctionField_bijective Q.genericPoint).1
      rw [map_mul, totalQuotientStalkToFunctionField_stalkToTotalQuotient,
        totalQuotientStalkToFunctionField_stalkToTotalQuotient]
      erw [MMP.CartierDivisorSheaf.totalQuotientStalkToFunctionField_germ_top_ofFunctionField]
      rw [mul_comm]
      exact hab
    have : Ring.KrullDimLE 1 (X.presheaf.stalk (primeDivisorSubvariety Q).genericPoint) :=
      krullDimLE_of_coheight_le Q.coheight_genericPoint.le
    have hO := isOrderAlong_of_isFraction (V := primeDivisorSubvariety Q) hloc
      (mem_nonZeroDivisors_of_ne_zero ha0) b.2 hfrac
    rw [hO.primeDivisorOrder_eq]
    have h1 := Scheme.ord_mul (x := Q.genericPoint) hr0 hbK
    rw [hab, scheme_ord_algebraMap Q.coheight_genericPoint ha0,
      scheme_ord_algebraMap Q.coheight_genericPoint hb0] at h1
    change ((Ring.ord _ a).toNat : ℤ) -
      ((Ring.ord _ (b : X.presheaf.stalk Q.genericPoint)).toNat : ℤ) = _
    linarith
  refine ⟨E₀ + Pc, fun Q => ?_⟩
  have h := isOrderAlong_primeDivisorOrder (E₀ + Pc) Q
  have e : primeDivisorOrder Q (E₀ + Pc) = L.coeff Q := by
    have hLQ := congrArg (fun D : Divisor X => D.coeff Q) hφ
    simp only [DivisorWithCoeffs.coeff_sub, coeff_principalDivisor] at hLQ
    rw [map_add, (hw Q).primeDivisorOrder_eq, hPord, ← hordφ]
    omega
  rwa [e] at h

/-- A `ℚ`-divisor with a relatively free Cartier multiple is relatively semiample. -/
private theorem isRelativelySemiample_of_isRelativelyFreeDivisor {X Z : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z)
    (D : QDivisor X)
    (h : ∃ m : ℕ, 0 < m ∧ ∃ L : Divisor X, Divisor.toQDivisor L = (m : ℤ) • D ∧ L.IsCartier ∧
      IsRelativelyFreeDivisor f L) :
    QDivisor.IsRelativelySemiample f D := by
  obtain ⟨m, hm, L, hL, hLc, hfree⟩ := h
  obtain ⟨E, hE⟩ := exists_isWeilDivisorOfCartier_of_isCartier hLc
  obtain ⟨e⟩ := hE.nonempty_sheaf_iso_divisorialSheaf
  refine isRelativelySemiample_of_primeDivisorOrder_eq f D hm (fun P => ?_)
    (epi_counit_of_iso f e hfree)
  rw [(isOrderAlong_primeDivisorOrder E P).unique (hE P)]
  have := congrArg (fun Q : QDivisor X => Q.coeff P) hL
  simpa [zsmul_eq_mul] using this

/-- A relatively semiample `ℚ`-divisor has a relatively free Cartier multiple. -/
private theorem exists_isRelativelyFreeDivisor_of_isRelativelySemiample {X Z : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z)
    (D : QDivisor X) (h : QDivisor.IsRelativelySemiample f D) :
    ∃ m : ℕ, 0 < m ∧ ∃ L : Divisor X, Divisor.toQDivisor L = (m : ℤ) • D ∧ L.IsCartier ∧
      IsRelativelyFreeDivisor f L := by
  classical
  haveI : IsNoetherian X := ⟨⟩
  obtain ⟨C, hC, q, hq, hint, hfree⟩ := h
  obtain ⟨w, hw⟩ := exists_isWeilDivisorOfCartier
    (KCartierDivisor.realization ((q : ℚ) • C) hint)
  refine ⟨q, hq, w, ?_, hw.isCartier, ?_⟩
  · ext P
    rw [Divisor.coeff_toQDivisor, coeff_eq_mul_of_isWeilDivisorOfCartier_realization hC hint hw P]
    simp [DivisorWithCoeffs.coeff_apply, zsmul_eq_mul]
  · obtain ⟨e⟩ := hw.nonempty_sheaf_iso_divisorialSheaf
    exact epi_counit_of_iso f e.symm hfree

/-- A unit of `K(X)` which is regular at a point `x` of the prime divisor `E` has nonnegative
order along `E`, and order zero if it is a unit at `x`. -/
private theorem zero_le_ordUnit_of_eq_stalkToRationalFunctions {X : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] (E : Mori.PrimeDivisor X) {x : X}
    (hxE : x ∈ E.support) (t : X.presheaf.stalk x)
    (u : (X.presheaf.stalk (componentGenericPoint X E.component))ˣ)
    (hu : (stalkToRationalFunctions X (E.support_subset_component hxE)).hom t = u) :
    0 ≤ E.ordUnit u ∧ (IsUnit t → E.ordUnit u = 0) := by
  have hspec : E.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact specializes_iff_mem_closure.mpr hxE
  set b : E.localRing := (X.presheaf.stalkSpecializes hspec).hom t with hb
  have hbu : E.toComponent.hom b = u := by
    rw [hb, E.toComponent_stalkSpecializes hspec (E.support_subset_component hxE), hu]
  refine ⟨?_, fun ht => E.ordUnit_eq_zero_of_isUnit (ht.map _) hbu⟩
  have := E.isDiscreteValuationRing_localRing
  have hb0 : b ≠ 0 := fun h0 => u.ne_zero (by rw [← hbu, h0, map_zero])
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
  have h := E.valuation_eq_exp_ordUnit u
  rw [← hbu, hv, map_mul, map_pow, map_mul, map_pow, E.valuation_toComponent_of_isUnit v.isUnit,
    E.valuation_toComponent_of_irreducible hϖ, one_mul, ← WithZero.exp_nsmul] at h
  have := WithZero.exp_injective h
  simp only [nsmul_eq_mul, mul_one] at this
  omega

/-- **Pull-backs of effective divisors.** If `G` is a Cartier divisor on `Y`, `G'` its pull-back
along `j : X ⟶ Y` and `G` is effective, resp. zero, along the prime divisors through `j(x)`, then
`G'` is effective, resp. zero, along the prime divisors through `x`. -/
private theorem coeff_isPullback_of_forall {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (j : X ⟶ Y) {G : Divisor Y} (hGc : G.IsCartier)
    {hB : ∀ Z : irreducibleComponents X, j (componentGenericPoint X Z) ∉ G.supp}
    {G' : Divisor X} (h : G.IsPullback j hB G') (x : X) :
    ((∀ Γ : Mori.PrimeDivisor Y, j x ∈ Γ.support → 0 ≤ G.coeff Γ) →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support → 0 ≤ G'.coeff E) ∧
    ((∀ Γ : Mori.PrimeDivisor Y, j x ∈ Γ.support → G.coeff Γ = 0) →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support → G'.coeff E = 0) := by
  obtain ⟨U, hU, φ, hφ⟩ := hGc (j x)
  set W := pointComponent (j x)
  have key : ∀ (r : Y.presheaf.stalk (j x)),
      (stalkToRationalFunctions Y (mem_pointComponent (j x))).hom r = (φ : RationalFunctions Y) W →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support →
        0 ≤ G'.coeff E ∧ (IsUnit r → G'.coeff E = 0) := by
    intro r hr E hxE
    have hE : (E.support ∩ j ⁻¹ᵁ U).Nonempty := ⟨x, hxE, hU⟩
    rw [h U φ hφ E hE]
    set Z := E.component
    have hxZ : x ∈ Z.1 := E.support_subset_component hxE
    have hsZ : componentGenericPoint X Z ⤳ x :=
      (isGenericPoint_componentGenericPoint X Z).specializes hxZ
    have hsY : j (componentGenericPoint X Z) ⤳ j x := hsZ.map j.continuous
    have hW : j (componentGenericPoint X Z) ∈ W.1 := by
      have : (W.1 : Set Y) = Set.univ := by
        have h1 : (W.1 : Set Y) ∈ ({Set.univ} : Set (Set Y)) := by
          rw [← irreducibleComponents_eq_singleton]; exact W.2
        exact h1
      rw [this]; trivial
    obtain ⟨a, ha⟩ := hφ.exists_unit_stalk (E.map_componentGenericPoint_mem j hE) (hB Z) hW
    have har : (a : Y.presheaf.stalk _) = (Y.presheaf.stalkSpecializes hsY).hom r := by
      apply stalkToRationalFunctions_injective hW
      rw [ha]
      change _ = (Y.presheaf.stalkSpecializes hsY ≫ Y.presheaf.stalkSpecializes _).hom r
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact hr.symm
    rw [pullbackComponent_eq hB hφ (E.map_componentGenericPoint_mem j hE) hW a ha]
    have hval : (Units.map (j.stalkMap (componentGenericPoint X Z)).hom.toMonoidHom a :
        X.presheaf.stalk _) = (stalkToRationalFunctions X hxZ).hom ((j.stalkMap x).hom r) := by
      change (j.stalkMap (componentGenericPoint X Z)).hom
        (a : Y.presheaf.stalk (j (componentGenericPoint X Z))) = _
      rw [har]
      exact Scheme.Hom.stalkSpecializes_stalkMap_apply j _ x hsZ r
    obtain ⟨h1, h2⟩ := zero_le_ordUnit_of_eq_stalkToRationalFunctions E hxE
      ((j.stalkMap x).hom r) _ hval.symm
    exact ⟨h1, fun hru => h2 (hru.map _)⟩
  constructor
  · intro hG E hxE
    obtain ⟨r, hr⟩ := exists_stalk_eq_of_forall_zero_le_ord (mem_pointComponent (j x)) φ
      fun Γ hΓ => by rw [← hφ Γ ⟨j x, hΓ, hU⟩]; exact hG Γ hΓ
    exact (key r hr E hxE).1
  · intro hG E hxE
    obtain ⟨a, ha⟩ := exists_unit_stalk_of_forall_ord_eq_zero (mem_pointComponent (j x)) φ
      fun Γ hΓ => by rw [← hφ Γ ⟨j x, hΓ, hU⟩]; exact hG Γ hΓ
    exact (key a ha E hxE).2 a.isUnit

/-- The pull-back of a Cartier divisor is Cartier. -/
private theorem isCartier_of_isPullback {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] (j : X ⟶ Y) {G : Divisor Y} (hGc : G.IsCartier)
    {hB : ∀ Z : irreducibleComponents X, j (componentGenericPoint X Z) ∉ G.supp}
    {G' : Divisor X} (h : G.IsPullback j hB G') : G'.IsCartier := by
  classical
  intro s
  obtain ⟨U, hU, φ, hφ⟩ := hGc (j s)
  let ψ : (RationalFunctions X)ˣ := (RationalFunctions.unitsEquiv X).symm fun Z =>
    if hZ : j (componentGenericPoint X Z) ∈ U then pullbackComponent j hB hφ Z hZ else 1
  refine ⟨j ⁻¹ᵁ U, hU, ψ, fun E hE => ?_⟩
  rw [h U φ hφ E hE, PrimeDivisor.ord_eq_ordUnit]
  congr 1
  ext
  change _ = (if hZ : j (componentGenericPoint X E.component) ∈ U then
    pullbackComponent j hB hφ E.component hZ else 1).val
  rw [dite_eq_left (E.map_componentGenericPoint_mem j hE)]

end Conversion

/-- The coheight of a point is at most the dimension of the scheme. -/
private theorem coheight_le_of_topologicalKrullDim_eq {X : Scheme.{0}} {n : ℕ∞}
    (h : topologicalKrullDim X = n) (x : X) : Order.coheight x ≤ n := by
  have h2 : ringKrullDim (X.presheaf.stalk x) ≤ topologicalKrullDim X := by
    rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk X]
    exact le_iSup (fun y : X => ringKrullDim (X.presheaf.stalk y)) x
  rw [AlgebraicGeometry.ringKrullDim_stalk_eq_coheight, h] at h2
  exact_mod_cast h2

/-- **A normal variety over `ℂ` has a canonical divisor.** -/
private theorem exists_isCanonicalDivisor' {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) {n : ℕ} (hn : topologicalKrullDim X = n) :
    ∃ K : Divisor X, K.IsCanonicalDivisor sX n := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  let := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hn
  exact ⟨_, MMP.Spreading.CanonExist.isCanonicalDivisor_topFormDivisor hX hn
    (ω := (b () : RationalTopForms sX n)) (b.ne_zero ())⟩

/-- The generic point of a prime divisor lies on it. -/
private theorem genericPoint_mem_support {X : Scheme.{0}} (D : Mori.PrimeDivisor X) :
    D.genericPoint ∈ D.support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact subset_closure rfl

/-! ### Dlt surfaces are `ℚ`-factorial -/

/-- The singular points of a normal variety have codimension at least two. -/
private theorem two_le_coheight_of_notMem_smoothLocus {S : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)}
    (hSn : IsNormalVariety ℂ sS) (y : S) (hy : y ∉ smoothLocus sS) :
    2 ≤ Order.coheight y := by
  haveI : IsIntegral S := hSn.1.toIsIntegral
  haveI : LocallyOfFiniteType sS := hSn.1.toLocallyOfFiniteType
  by_contra h
  push Not at h
  have hc : Order.coheight y = 0 ∨ Order.coheight y = 1 := by
    generalize Order.coheight y = c at h ⊢
    induction c using ENat.recTopCoe with
    | top => simp at h
    | coe n => norm_cast at h ⊢; omega
  rcases hc with h0 | h1
  · rw [Order.coheight_eq_zero] at h0
    have hgen : y = genericPoint S := by
      have hgs : genericPoint S ⤳ y := (genericPoint_spec S).specializes trivial
      have h1 : y ≤ genericPoint S := by
        rw [Scheme.le_iff_specializes]; exact hgs
      have h2 := h0 h1
      rw [Scheme.le_iff_specializes] at h2
      exact (h2.antisymm hgs).eq
    apply hy
    rw [hgen, smoothLocus_eq_smoothLocus]
    exact Scheme.Hom.genericPoint_mem_smoothLocus_of_perfectField sS
  · apply hy
    have := MMP.Positivity.PrimeDivisor.genericPoint_mem_smoothLocus hSn
      (AlgebraicGeometry.PrimeDivisor.ofCoheightOne y h1)
    have e : Mori.PrimeDivisor.genericPoint (AlgebraicGeometry.PrimeDivisor.ofCoheightOne y h1)
        = y := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne y h1
    rwa [e] at this

/-- A singular point of a normal surface is closed. -/
private theorem isClosed_singleton_of_notMem_smoothLocus {S : Scheme.{0}} [IsIntegral S]
    {sS : S ⟶ Spec (.of ℂ)} (hS : IsNormalVariety ℂ sS) (hdim : topologicalKrullDim S = 2)
    {y : S} (hy : y ∉ smoothLocus sS) : IsClosed ({y} : Set S) := by
    have h2 := two_le_coheight_of_notMem_smoothLocus hS y hy
    refine isClosed_iff_clusterPt.mpr fun z hz => ?_
    have hyz : y ⤳ z := specializes_iff_mem_closure.mpr (mem_closure_iff_clusterPt.mpr hz)
    by_contra hne
    have hlt : z < y := by
      refine lt_of_le_not_ge (by rw [Scheme.le_iff_specializes]; exact hyz) fun h => ?_
      rw [Scheme.le_iff_specializes] at h
      exact hne (hyz.antisymm h).eq.symm
    have h3 := Order.coheight_add_one_le hlt
    have h4 := coheight_le_of_topologicalKrullDim_eq (n := 2) (by rw [hdim]; rfl) z
    have h5 : (2 : ℕ∞) + 1 ≤ Order.coheight y + 1 := by gcongr
    have : (2 : ℕ∞) + 1 ≤ 2 := h5.trans (h3.trans h4)
    exact absurd this (by decide)

/-- A normal surface over `ℂ` has finitely many singular points. -/
private theorem finite_setOf_notMem_smoothLocus {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] {sS : S ⟶ Spec (.of ℂ)}
    (hS : IsNormalVariety ℂ sS) (hdim : topologicalKrullDim S = 2) :
    {x : S | x ∉ smoothLocus sS}.Finite := by
  classical
  haveI : IsNoetherian S := {}
  -- singular points are closed
  have hcl : ∀ y : S, y ∉ smoothLocus sS → IsClosed ({y} : Set S) := fun y hy =>
    isClosed_singleton_of_notMem_smoothLocus hS hdim hy
  set Z : TopologicalSpace.Closeds S := ⟨{x | x ∉ smoothLocus sS},
    (smoothLocus sS).isOpen.isClosed_compl⟩ with hZ
  obtain ⟨T, hTf, hTirr, hTZ⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_closeds_irreducible Z
  have hsub : {x : S | x ∉ smoothLocus sS} ⊆ ⋃ t ∈ T, (t : Set S) := by
    intro x hx
    have : x ∈ (Z : Set S) := hx
    rw [hTZ, TopologicalSpace.Closeds.coe_sSup, Set.sUnion_image,
      (hTf.isClosed_biUnion fun t _ => t.isClosed).closure_eq] at this
    exact this
  refine (hTf.biUnion fun t ht => ?_).subset hsub
  obtain ⟨g, hg⟩ := QuasiSober.sober (hTirr t ht) t.isClosed
  have hgZ : g ∈ (Z : Set S) := by
    have hgt : g ∈ (t : Set S) := hg.mem
    rw [hTZ, TopologicalSpace.Closeds.coe_sSup, Set.sUnion_image,
      (hTf.isClosed_biUnion fun t _ => t.isClosed).closure_eq]
    exact Set.mem_biUnion ht hgt
  have : (t : Set S) = {g} := by
    rw [← hg.def, (hcl g hgZ).closure_eq]
  rw [this]
  exact Set.finite_singleton g

/-! ### The positive-cycle criterion for weighted graphs -/

section Graph

open Finset

variable {V : Type*} [Fintype V] [DecidableEq V] {Γ : WeightedGraph V}

open WeightedGraph

/-- The integer form `zᵀ M(Γ) z + ∑_j z_j (2p_j - 2 + n_j)`, which is `-2 χ(𝒪_Z)` for the cycle
`Z = ∑ z_j E_j`. -/
private def eulerForm (Γ : WeightedGraph V) (z : V → ℤ) : ℤ :=
  (∑ j, ∑ l, z j * Γ.matrix j l * z l) + ∑ j, z j * (2 * Γ.genus j - 2 + Γ.weight j)

/-- `M(Γ)` is symmetric, entrywise. -/
private lemma matrix_symm_apply (Γ : WeightedGraph V) (j l : V) :
    Γ.matrix j l = Γ.matrix l j :=
  Γ.matrix_isSymm.apply l j

/-- The diagonal entries of `M(Γ)` are `-n_j`. -/
private lemma matrix_self (Γ : WeightedGraph V) (j : V) : Γ.matrix j j = -Γ.weight j := by
  simp [matrix]

/-- The off-diagonal entries of `M(Γ)` are the edge weights. -/
private lemma matrix_of_ne (Γ : WeightedGraph V) {j l : V} (h : j ≠ l) :
    Γ.matrix j l = Γ.edgeWeight j l := by
  simp [matrix, h]

/-- Adding a vertex to a cycle: `Q(w + e_i) = Q(w) + 2 (M w)_i + M_ii + 2p_i - 2 + n_i`. -/
private lemma eulerForm_add_single (Γ : WeightedGraph V) (w : V → ℤ) (i : V) :
    eulerForm Γ (w + Pi.single i 1) = eulerForm Γ w + 2 * ∑ l, Γ.matrix i l * w l +
      Γ.matrix i i + (2 * Γ.genus i - 2 + Γ.weight i) := by
  have hs : ∑ j, w j * Γ.matrix j i = ∑ l, Γ.matrix i l * w l :=
    Finset.sum_congr rfl fun j _ => by rw [matrix_symm_apply, mul_comm]
  have h2 : (∑ x, ∑ x_1, if x = i then Γ.matrix x x_1 * w x_1 else 0) =
      ∑ l, Γ.matrix i l * w l := by
    rw [Finset.sum_comm]; simp
  simp only [eulerForm, Pi.add_apply, Pi.single_apply, add_mul, mul_add, Finset.sum_add_distrib,
    mul_ite, ite_mul, mul_one, one_mul, mul_zero, zero_mul, Finset.sum_ite_eq',
    Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [hs, h2]
  ring

/-- For a cycle `z` with `χ(𝒪_z) ≤ 0` such that `z - e_i`, if nonzero, has `χ ≥ 1`, and
`p_i = 0`: `(M z)_i ≥ 2 - n_i`. -/
private lemma two_sub_weight_le {i : V} (hp : Γ.genus i = 0) {z : V → ℤ}
    (hbad : -2 < eulerForm Γ z)
    (hmin : z - Pi.single i 1 ≠ 0 → eulerForm Γ (z - Pi.single i 1) ≤ -2) :
    2 - Γ.weight i ≤ ∑ l, Γ.matrix i l * z l := by
  set w := z - Pi.single i 1 with hw
  have hz : z = w + Pi.single i 1 := by rw [hw, sub_add_cancel]
  have hE := eulerForm_add_single Γ w i
  rw [← hz] at hE
  have hS : ∑ l, Γ.matrix i l * z l = ∑ l, Γ.matrix i l * w l + Γ.matrix i i := by
    rw [hz]; simp [mul_add, Finset.sum_add_distrib, Pi.single_apply]
  rw [hS, matrix_self]
  rw [matrix_self, hp] at hE
  by_cases hw0 : w = 0
  · have h0 : eulerForm Γ 0 = 0 := by simp [eulerForm]
    simp only [hw0, Pi.zero_apply, mul_zero, Finset.sum_const_zero, h0] at hE
    push_cast at hE
    omega
  · have := hmin hw0
    push_cast at hE
    omega

/-- No nonzero cycle `z ≥ 0` has `(M z)_i ≥ 2 - n_i` on its support, when `Γ` is negative
definite of genus zero with a log discrepancy vector `0 < α ≤ 1`: `x = (z + α - 1)|_{supp z}`
would be a nonzero vector with `xᵀ M x ≥ 0`. -/
private lemma false_of_two_sub_weight_le (hneg : Γ.IsNegDef) (hp : ∀ j, Γ.genus j = 0)
    {α : V → ℚ}
    (hα : Γ.IsLogDiscrepancyVector α) (hα0 : ∀ j, 0 < α j) (hα1 : ∀ j, α j ≤ 1)
    {z : V → ℤ} (hz0 : 0 ≤ z) (hzne : z ≠ 0)
    (hz : ∀ i, z i ≠ 0 → 2 - Γ.weight i ≤ ∑ l, Γ.matrix i l * z l) : False := by
  set x : V → ℚ := fun j => if z j = 0 then 0 else z j + α j - 1 with hx
  have hxi : ∀ i, z i ≠ 0 → 0 < x i := fun i hi => by
    have : (1 : ℚ) ≤ z i := by exact_mod_cast (lt_of_le_of_ne (hz0 i) (Ne.symm hi))
    simp only [hx, if_neg hi]; linarith [hα0 i]
  have hMx : ∀ i, z i ≠ 0 → 0 ≤ ∑ l, (Γ.matrix i l : ℚ) * x l := fun i hi => by
    have hsplit : ∑ l, (Γ.matrix i l : ℚ) * x l =
        ∑ l, (Γ.matrix i l : ℚ) * (z l + α l - 1) -
          ∑ l, (Γ.matrix i l : ℚ) * (if z l = 0 then α l - 1 else 0) := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      by_cases hl : z l = 0 <;> simp [hx, hl]
    have hneg2 : ∑ l, (Γ.matrix i l : ℚ) * (if z l = 0 then α l - 1 else 0) ≤ 0 :=
      Finset.sum_nonpos fun l _ => by
        by_cases hl : z l = 0
        · have hil : i ≠ l := fun h => hi (h ▸ hl)
          simp only [hl, if_true, matrix_of_ne Γ hil]
          exact mul_nonpos_of_nonneg_of_nonpos (by positivity) (by linarith [hα1 l])
        · simp [hl]
    have hαi := hα i
    have hsymm : ∑ l, (Γ.matrix i l : ℚ) * α l = ∑ l, α l * (Γ.matrix l i : ℚ) :=
      Finset.sum_congr rfl fun l _ => by rw [matrix_symm_apply, mul_comm]
    have hrow : ∑ l, (Γ.matrix i l : ℚ) = -Γ.weight i +
        ∑ l ∈ univ.erase i, (Γ.edgeWeight i l : ℚ) := by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
      congr 1
      · simp [matrix_self]
      · exact Finset.sum_congr rfl fun l hl => by
          rw [matrix_of_ne Γ (Finset.ne_of_mem_erase hl).symm]; push_cast; rfl
    have hzq : (2 - Γ.weight i : ℚ) ≤ ∑ l, (Γ.matrix i l : ℚ) * z l := by
      exact_mod_cast hz i hi
    have hfirst : ∑ l, (Γ.matrix i l : ℚ) * (z l + α l - 1) =
        ∑ l, (Γ.matrix i l : ℚ) * z l + ∑ l, (Γ.matrix i l : ℚ) * α l -
          ∑ l, (Γ.matrix i l : ℚ) := by
      simp only [mul_sub, mul_add, mul_one, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    rw [hsplit, hfirst, hsymm, hαi, hrow]
    simp only [c, hp i, Nat.cast_zero, mul_zero, sub_zero]
    linarith [Γ.boundary_nonneg i]
  obtain ⟨i₀, hi₀⟩ : ∃ i, z i ≠ 0 := by
    by_contra h; push Not at h; exact hzne (funext h)
  have hxne : x ≠ 0 := fun h => (hxi i₀ hi₀).ne' (congrFun h i₀)
  have hpos := hneg.dotProduct_mulVec_pos hxne
  have hle : 0 ≤ ∑ i, x i * ∑ l, (Γ.matrix i l : ℚ) * x l :=
    Finset.sum_nonneg fun i _ => by
      by_cases hi : z i = 0
      · simp [hx, hi]
      · exact mul_nonneg (hxi i hi).le (hMx i hi)
  simp only [star_trivial, Matrix.neg_mulVec, dotProduct_neg, dotProduct, Matrix.mulVec,
    Matrix.map_apply, Matrix.neg_apply, neg_mul, Finset.sum_neg_distrib, mul_neg] at hpos
  linarith

/-- **The positive-cycle criterion.** A negative definite weighted graph of genus zero with a log
discrepancy vector `α`, `0 < α ≤ 1`, is rational: a cycle with `χ ≤ 0` and minimal `∑ z_j`
satisfies `(M z)_i ≥ 2 - n_i` on its support, which `false_of_two_sub_weight_le` excludes. -/
private lemma isRational_of_isLogDiscrepancyVector (hneg : Γ.IsNegDef)
    (hp : ∀ j, Γ.genus j = 0)
    {α : V → ℚ} (hα : Γ.IsLogDiscrepancyVector α) (hα0 : ∀ j, 0 < α j)
    (hα1 : ∀ j, α j ≤ 1) : Γ.IsRational := by
  have key : ∀ N : ℕ, ∀ z : V → ℤ, 0 ≤ z → z ≠ 0 → ∑ j, z j = N →
      eulerForm Γ z ≤ -2 := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ih =>
    intro z hz0 hzne hN
    by_contra hbad
    push Not at hbad
    refine false_of_two_sub_weight_le hneg hp hα hα0 hα1 hz0 hzne fun i hi => ?_
    have hzi : 1 ≤ z i := lt_of_le_of_ne (hz0 i) (Ne.symm hi)
    have hle : z i ≤ ∑ j, z j := Finset.single_le_sum (fun j _ => hz0 j) (Finset.mem_univ i)
    refine two_sub_weight_le (hp i) hbad fun hw => ?_
    refine ih (N - 1) (by omega) _ (fun j => ?_) hw ?_
    · by_cases hj : j = i
      · subst hj; simp; omega
      · simpa [Pi.single_apply, hj] using hz0 j
    · simp only [Pi.sub_apply]
      rw [Finset.sum_sub_distrib, Finset.sum_pi_single']
      simp only [Finset.mem_univ, if_true]
      omega
  intro z hz
  have h := key (∑ j, z j) (fun j => (z j : ℤ)) (fun j => by simp)
    (fun h => hz (funext fun j => by simpa using congrFun h j)) (by push_cast; rfl)
  have hq : ((eulerForm Γ fun j => (z j : ℤ)) : ℚ) ≤ -2 := by exact_mod_cast h
  simp only [eulerForm] at hq
  push_cast at hq
  linarith

end Graph

/-- The exceptional curves of a resolution of a surface germ are finitely many: their supports are
irreducible components of the closed fibre `f⁻¹(P)` of the Noetherian scheme `Y`, and a prime
divisor is determined by its support. -/
private theorem exists_finset_isGermExceptionalCurve {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {P : X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y]
    (hf : IsGermResolution sX P f) :
    ∃ S : Finset (MMP.Mori.PrimeDivisor Y), ∀ C, C ∈ S ↔ IsGermExceptionalCurve f P C := by
  classical
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (f ≫ sX)
  have : IsNoetherian Y := {}
  obtain ⟨Z, hZf, hZc, hZirr, hZ⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
      (hf.isSurfaceGerm.2.2.1.preimage f.continuous)
  have key : ∀ C, IsGermExceptionalCurve f P C → C.support ∈ Z := by
    intro C hC
    have hsub : C.support ⊆ ⋃₀ (hZf.toFinset : Set (Set Y)) := by
      rw [hZf.coe_toFinset, ← hZ]; exact hC.1.prop.2
    obtain ⟨W, hW, hCW⟩ := (isIrreducible_iff_sUnion_isClosed.1 hC.1.prop.1) hZf.toFinset
      (fun W hW => hZc W (hZf.mem_toFinset.1 hW)) hsub
    have hW' := hZf.mem_toFinset.1 hW
    have hWF : W ⊆ f.base ⁻¹' {P} := by rw [hZ]; exact Set.subset_sUnion_of_mem hW'
    rw [hC.1.eq_of_le ⟨hZirr W hW', hWF⟩ hCW]
    exact hW'
  have hfin : {C | IsGermExceptionalCurve f P C}.Finite :=
    Set.Finite.of_finite_image (hZf.subset (by rintro _ ⟨C, hC, rfl⟩; exact key C hC))
      (fun C _ C' _ h => AlgebraicGeometry.PrimeDivisor.eq_of_support_eq h)
  exact ⟨hfin.toFinset, fun C => hfin.mem_toFinset⟩

/-- The exceptional curves of a resolution of a surface germ admit an enumeration. -/
private theorem exists_isExceptionalCurveEnumeration {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {P : X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y]
    (hf : IsGermResolution sX P f) :
    ∃ (n : ℕ) (E : Fin n → MMP.Mori.PrimeDivisor Y), IsExceptionalCurveEnumeration f P E := by
  classical
  obtain ⟨S, hS⟩ := exists_finset_isGermExceptionalCurve hf
  exact ⟨S.card, fun j => (S.equivFin.symm j).1,
    ⟨fun a b hab => S.equivFin.symm.injective (Subtype.ext hab),
      fun j => (hS _).1 (S.equivFin.symm j).2,
      fun C hC => ⟨S.equivFin ⟨C, (hS C).2 hC⟩, by simp⟩⟩⟩

/-- **Surface germs with positive log discrepancies are rational.** Let `f` be the minimal
resolution of a surface germ `(X, P)` over `ℂ`, and `a` the log discrepancy vector of a boundary
`T` on `f`. If `0 < a_j` for every exceptional curve, `(X, P)` is a rational singularity: for
`T ≠ 0` this is the positive-boundary criterion, and otherwise the weighted dual graph of
`(X, P; 0)` has genus zero and a log discrepancy vector in `(0, 1]`, so it is rational. -/
private theorem isRationalSurfaceSingularity_of_forall_pos {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of ℂ)} {P : X} [IsLocallyNoetherian X] [IsNormal X] {T : QDivisor X}
    {f : Y ⟶ X} [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y] [IsNormal Y] {n : ℕ}
    {E : Fin n → Mori.PrimeDivisor Y} {a : Fin n → ℚ}
    (hf : IsMinimalGermResolution sX P f) (hE : IsExceptionalCurveEnumeration f P E)
    (ha : IsGermLogDiscrepancyVector sX P T f E a) (hpos : ∀ j, 0 < a j) :
    IsRationalSurfaceSingularity sX P := by
  classical
  obtain ⟨hB, hg, -, -⟩ := id ha
  by_cases hTn : T ≠ 0 ∧ 0 < n
  · exact (hf.isRationalSurfaceSingularity_of_isGermLogDiscrepancyVector hTn.2 hTn.1 ha
      fun j => (hpos j).le).1
  have hB0 : IsSurfaceGermWithBoundary sX P 0 :=
    ⟨hB.1, fun C hC => by simp at hC, fun C => by simp⟩
  obtain ⟨a₀, ha₀, -⟩ := existsUnique_isGermLogDiscrepancyVector hB0 hg hE
  have hpos₀ : ∀ j, 0 < a₀ j := fun j => by
    by_cases hT : T = 0
    · subst hT
      rw [(existsUnique_isGermLogDiscrepancyVector hB0 hg hE).unique ha₀ ha]
      exact hpos j
    · have : n = 0 := by
        by_contra h
        exact hTn ⟨hT, Nat.pos_of_ne_zero h⟩
      subst this
      exact j.elim0
  obtain ⟨Γ, hΓ⟩ := hg.exists_isWeightedDualGraph hB0 hE
  have haΓ : Γ.IsLogDiscrepancyVector a₀ := (hΓ.isGermLogDiscrepancyVector_iff a₀).1 ha₀
  have hneg := hΓ.isNegDef
  have hp : ∀ j, Γ.genus j = 0 := by
    intro j
    by_contra h0
    have hj1 : Γ.genus j = 1 := by
      have := hf.genus_le_one_of_logDiscrepancy_nonneg hΓ haΓ (fun i => (hpos₀ i).le) j
      omega
    obtain ⟨rfl, hβ⟩ :=
      hf.eq_one_and_boundary_eq_zero_of_genus_eq_one hΓ haΓ (fun i => (hpos₀ i).le) hj1
    have h1 := haΓ j
    have hdiag := hneg.diag_pos (i := j)
    simp only [Matrix.neg_apply, Matrix.map_apply] at hdiag
    have hsum : ∑ k, a₀ k * (Γ.matrix k j : ℚ) = a₀ j * (Γ.matrix j j : ℚ) := by
      rw [Fin.sum_univ_one, Subsingleton.elim j 0]
    have hc : Γ.c j = 0 := by
      have he : (Finset.univ.erase j : Finset (Fin 1)) = ∅ := by
        ext i; simp [Subsingleton.elim i j]
      rw [WeightedGraph.c, he]
      simp [hj1, hβ]
    rw [hsum, hc, neg_zero] at h1
    rcases mul_eq_zero.mp h1 with h | h
    · exact (hpos₀ j).ne' h
    · rw [h] at hdiag; simp at hdiag
  have hα1 : ∀ j, a₀ j ≤ 1 := fun j => haΓ.le_one hneg (hf.d_nonpos hΓ) j
  exact (hΓ.isRationalSurfaceSingularity_iff_isRational hf).2
    (isRational_of_isLogDiscrepancyVector hneg hp haΓ hpos₀ hα1)

/-- The closure in `X` of a prime divisor of `U` meeting `U ∩ V` meets `V`. -/
private theorem primeDivisorMap_support_inter_nonempty {X : Scheme.{0}} (U : X.Opens)
    [Nonempty U] [IsDominant U.ι] {V : X.Opens} (W : Mori.PrimeDivisor U.toScheme)
    (hW : (W.support ∩ U.ι ⁻¹ᵁ V).Nonempty) :
    ((OpenWeilRestriction.primeDivisorMap U.ι W).support ∩ V).Nonempty := by
  rw [← Mori.PrimeDivisor.genericPoint_mem_iff]
  exact (congrArg (· ∈ V) (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι W)).mpr
    ((W.genericPoint_mem_iff _).2 hW)

/-- The restriction of a Cartier divisor to a dense open subscheme is Cartier. -/
private theorem isCartier_restrictOpen {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {D : Divisor X} (h : D.IsCartier) (U : X.Opens) [Nonempty U]
    [IsDominant U.ι] : Divisor.IsCartier (D.restrictOpen U) := by
  intro x
  obtain ⟨V, hxV, φ, hφ⟩ := h (U.ι x)
  obtain ⟨g, hg, hφg⟩ := MMP.Positivity.exists_ord_eq_of_units φ
  obtain ⟨φ', hφ'⟩ := MMP.Positivity.exists_units_of_ne_zero
    ((map_ne_zero (functionFieldMap U.ι)).2 hg)
  refine ⟨U.ι ⁻¹ᵁ V, hxV, φ', fun W hW => ?_⟩
  have hP := primeDivisorMap_support_inter_nonempty U W hW
  rw [DivisorWithCoeffs.coeff_restrictOpen, hφ _ hP, hφg, hφ',
    MMP.Positivity.ord_functionFieldMap_of_isIso U.ι W _
      (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm]

/-- A divisor over an open subscheme `V` is a divisor over `X`, with the same discrepancy. -/
private theorem isDiscrepancy_comp_ι {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (h : Mori.IsPairWith sX n K Δ) (V : X.Opens) [Nonempty V] (D : DivisorOver ℂ (V.ι ≫ sX))
    {a : ℚ} (ha : Mori.IsDiscrepancy (V.ι ≫ sX) n (K.restrictOpen V) (Δ.restrictOpen V) D a)
    (hY : IsNormalVariety ℂ ((D.f ≫ V.ι) ≫ sX)) (hbir : IsBirationalMorphism (D.f ≫ V.ι)) :
    Mori.IsDiscrepancy sX n K Δ ⟨D.Y, D.f ≫ V.ι, hY, hbir, D.E⟩ a := by
  have : IsDominant V.ι := Opens.isDominant_ι (V.isOpen.dense ⟨_, (Classical.arbitrary V).2⟩)
  have := D.isIntegral
  set D₁ : DivisorOver ℂ sX := ⟨D.Y, D.f ≫ V.ι, hY, hbir, D.E⟩ with hD₁
  have hcen : (D₁.center : Set X) = closure {V.ι (D.f D.E.genericPoint)} :=
    D₁.center_eq_closure_genericPoint
  obtain ⟨b, hb⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy h.isPair h.2.1 D₁
  obtain ⟨hY', hf, E', -, hval, hiff⟩ := DivisorOver.exists_restrict_isDiscrepancy_iff h D₁ V
    ⟨_, hcen ▸ subset_closure rfl, (D.f D.E.genericPoint).2⟩
  have hv : (⟨_, D₁.f ∣_ V, hY', hf, E'⟩ : DivisorOver ℂ (V.ι ≫ sX)).valuation =
      D.valuation := by
    have := D.isNormal
    have := D.isLocallyNoetherian
    have := D.isDominant
    ext t
    obtain ⟨s, rfl⟩ := (functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤
      ⟨Classical.arbitrary V, trivial⟩).2 t
    refine (congrArg (· s) hval).symm.trans ?_
    change D.E.divisorialValuation (functionFieldMap (D.f ≫ V.ι) s) =
      D.E.divisorialValuation (functionFieldMap D.f (functionFieldMap V.ι s))
    rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
  have hba := MMP.Threefold.Mori.ModelIndependence.isDiscrepancy_eq_of_center_eq hv
    (MMP.Threefold.Mori.ModelIndependence.center_eq_of_valuation_eq (h.restrictOpen V).1 hv)
    ((hiff b).1 hb) ha
  exact hba ▸ hb

/-- A birational morphism to an open subscheme `V` of an integral scheme is birational as a
morphism to `X`. -/
private theorem isBirationalMorphism_comp_ι {X Y : Scheme.{0}} [IsIntegral X] [IrreducibleSpace Y]
    (V : X.Opens) {g : Y ⟶ V} (hg : IsBirationalMorphism g) : IsBirationalMorphism (g ≫ V.ι) := by
  have : Nonempty Y := (IrreducibleSpace.isIrreducible_univ Y).nonempty.to_subtype.map Subtype.val
  obtain ⟨W, hWne, hW⟩ := hg.exists_isOpenImmersion
  have : Nonempty W := hWne.to_subtype
  have hd : Dense (((W.ι ≫ g) ≫ V.ι).opensRange : Set X) :=
    ((W.ι ≫ g) ≫ V.ι).isOpenEmbedding.isOpen_range.dense (Set.range_nonempty _)
  refine ⟨⟨W, W.isOpen.dense hWne, _, hd, ((W.ι ≫ g) ≫ V.ι).isoOpensRange⟩, ?_⟩
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨W, W.isOpen.dense hWne, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialIso.toPartialMap_hom,
    Scheme.Hom.toPartialMap_hom, Scheme.Hom.isoOpensRange_hom_ι, Scheme.topIso_hom,
    Category.assoc]
  exact (Scheme.homOfLE_ι_assoc _ _ _).trans (Scheme.homOfLE_ι_assoc _ _ _).symm

/-- The valuation of a proper divisor over `X` is a divisor of the function field. -/
private theorem isDivisorOfFunctionField_valuation {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [IsIntegral X] (E : ProperDivisorOver ℂ sX) :
    IsDivisorOfFunctionField ℂ sX E.valuation := by
  have := E.isIntegral
  have := E.isDominant
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (E.f ≫ sX)
  let := functionFieldMapAlgebra E.f
  have := isScalarTower_functionFieldMap sX E.f
  exact ⟨E.Y, E.f ≫ sX, E.isNormalVariety, E.E, AlgEquiv.ofBijective
    (IsScalarTower.toAlgHom ℂ X.functionField E.Y.functionField)
    E.isBirationalMorphism.functionFieldMap_bijective, rfl⟩

/-- The restriction of an `ℝ`-combination of Cartier divisors to a dense open is one. -/
private theorem isCartierCombination_restrictOpen {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {D : RDivisor X} (h : IsCartierCombination D)
    (U : X.Opens) [Nonempty U] [IsDominant U.ι] :
    IsCartierCombination (D.restrictOpen U) := by
  obtain ⟨m, r, L, hL, rfl⟩ := h
  refine ⟨m, r, fun j => (L j).restrictOpen U, fun j => isCartier_restrictOpen (hL j) U, ?_⟩
  ext W
  change (∑ j, r j • DivisorWithCoeffs.mapCoeffs (Int.cast : ℤ → ℝ) Int.cast_zero (L j))
    (OpenWeilRestriction.primeDivisorMap U.ι W) = _
  rw [DivisorWithCoeffs.coeff_apply]
  simp only [Finsupp.finsetSum_apply, Finsupp.smul_apply]
  rfl
/-- **Singular points of a dlt surface are rational singularities.** On a normal surface over `ℂ`
carrying a dlt pair `(S, B)`, every singular point `x` has an open neighbourhood `V` on which
`(V, x)` is a rational surface singularity. -/
private theorem exists_isRationalSurfaceSingularity_of_isDltPair {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] {sS : S ⟶ Spec (.of ℂ)}
    (hS : IsNormalVariety ℂ sS) (hdim : topologicalKrullDim S = 2) {B : QDivisor S}
    (hdlt : MMP.Intersection.IsDltPair sS B) {x : S} (hx : x ∉ smoothLocus sS) :
    ∃ (V : S.Opens) (hxV : x ∈ V), IsRationalSurfaceSingularity (V.ι ≫ sS) (⟨x, hxV⟩ : V) := by
  classical
  haveI : LocallyOfFiniteType sS := hS.1.toLocallyOfFiniteType
  obtain ⟨K, hK⟩ := exists_isCanonicalDivisor' hS (n := 2) (by rw [hdim]; rfl)
  obtain ⟨hpair, hcoeff, U₀, hU₀, -, hZ⟩ :=
    (MMP.Threefold.Bridges.isDltPair_iff_isDltPair sS hK B).mp hdlt
  -- a neighbourhood `V` of `x` which is a surface germ, met only by components through `x`
  obtain ⟨V, hxV, hgerm, hcomp⟩ : ∃ (V : S.Opens) (hxV : x ∈ V),
      IsSurfaceGerm (V.ι ≫ sS) (⟨x, hxV⟩ : V) ∧
        ∀ C ∈ (B.restrictOpen V).support, (⟨x, hxV⟩ : V) ∈ C.support := by
    have hxcl : IsClosed ({x} : Set S) := isClosed_singleton_of_notMem_smoothLocus hS hdim hx
    set F₁ : Set S := {y | y ∉ smoothLocus sS ∧ y ≠ x} with hF₁
    have hF₁f : F₁.Finite := (finite_setOf_notMem_smoothLocus hS hdim).subset fun y hy => hy.1
    have hF₁c : IsClosed F₁ := by
      have : F₁ = ⋃ y ∈ F₁, ({y} : Set S) := by simp
      rw [this]
      exact hF₁f.isClosed_biUnion fun y hy => isClosed_singleton_of_notMem_smoothLocus hS hdim hy.1
    set F₂ : Set S := ⋃ C ∈ B.support.filter (fun C => x ∉ C.support), (C.support : Set S)
      with hF₂
    have hF₂c : IsClosed F₂ :=
      (Finset.finite_toSet _).isClosed_biUnion fun C _ => C.idealSheaf.support.isClosed
    let V : S.Opens := ⟨(F₁ ∪ F₂)ᶜ, (hF₁c.union hF₂c).isOpen_compl⟩
    have hxV : x ∈ V := by
      show x ∉ F₁ ∪ F₂
      rintro (h | h)
      · exact h.2 rfl
      · obtain ⟨C, hC, hxC⟩ := Set.mem_iUnion₂.mp h
        exact (Finset.mem_filter.mp hC).2 hxC
    haveI : Nonempty V := ⟨⟨x, hxV⟩⟩
    haveI : IsDominant V.ι := Opens.isDominant_ι (V.isOpen.dense ⟨x, hxV⟩)
    have hpV := hpair.restrictOpen V
    refine ⟨V, hxV, ⟨hpV.1, ?_, ?_, fun y hy => ?_⟩, fun C hC => ?_⟩
    · have := hpV.2.1.topologicalKrullDim_eq
      exact_mod_cast this
    · convert hxcl.preimage V.ι.continuous using 1
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => by subst h; rfl, fun h => Subtype.ext h⟩
    · have hyS : V.ι y ∈ smoothLocus sS := by
        by_contra hns
        exact y.2 (Or.inl ⟨hns, fun h => hy (Subtype.ext h)⟩)
      rw [smoothLocus_eq_smoothLocus, ← Scheme.Hom.preimage_smoothLocus_eq,
        ← smoothLocus_eq_smoothLocus]
      exact hyS
    · have hC' : OpenWeilRestriction.primeDivisorMap V.ι C ∈ B.support := by
        rw [Finsupp.mem_support_iff] at hC ⊢
        exact hC
      have hxC : x ∈ (OpenWeilRestriction.primeDivisorMap V.ι C).support := by
        by_contra hxC
        have hgen : V.ι C.genericPoint ∈ (OpenWeilRestriction.primeDivisorMap V.ι C).support := by
          rw [← OpenWeilRestriction.genericPoint_primeDivisorMap]
          exact genericPoint_mem_support _
        exact C.genericPoint.2 (Or.inr (Set.mem_biUnion
          (Finset.mem_filter.mpr ⟨hC', hxC⟩) hgen))
      exact (MMP.Threefold.Mori.OpenRestriction.mem_support_primeDivisorMap_iff V.ι C
        ⟨x, hxV⟩).mp hxC
  haveI : Nonempty V := ⟨⟨x, hxV⟩⟩
  haveI : IsIntegral V := isIntegral_of_isOpenImmersion V.ι
  haveI : IsDominant V.ι := Opens.isDominant_ι (V.isOpen.dense ⟨x, hxV⟩)
  haveI : IsNoetherian S := {}
  haveI : CompactSpace V :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (V : Set S))
  obtain ⟨Y, f, hqc, hln, hnY, hmin⟩ := exists_isMinimalGermResolution (V.ι ≫ sS) hgerm
  obtain ⟨n, E, hE⟩ := exists_isExceptionalCurveEnumeration hmin.1
  have hT : IsSurfaceGermWithBoundary (V.ι ≫ sS) (⟨x, hxV⟩ : V) (B.restrictOpen V) :=
    ⟨hgerm, hcomp, fun C => hcoeff _⟩
  obtain ⟨a, ha, -⟩ := existsUnique_isGermLogDiscrepancyVector hT hmin.1 hE
  refine ⟨V, hxV, isRationalSurfaceSingularity_of_forall_pos hmin hE ha fun j => ?_⟩
  -- the divisor `(Y, f, E_j)` over `V`, and over `S`
  have hres := hmin.1.isSmoothResolution
  obtain ⟨hYv, -, -⟩ := hres.isNormalVariety hgerm.1
  haveI := hres.isProper
  haveI : IsIntegral Y := hmin.1.isIntegral (V.ι ≫ sS)
  set D : DivisorOver ℂ (V.ι ≫ sS) := ⟨Y, f, hYv, hres.isBirationalMorphism, E j⟩ with hD
  have hpairV := hpair.restrictOpen V
  obtain ⟨b, hb⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hpairV.isPair hpairV.2.1 D
  have hY₁ : IsNormalVariety ℂ ((f ≫ V.ι) ≫ sS) := by rw [Category.assoc]; exact hYv
  have hbir₁ := isBirationalMorphism_comp_ι V hres.isBirationalMorphism
  have hb₁ := isDiscrepancy_comp_ι hpair V D hb hY₁ hbir₁
  -- its centre on `S` is the singular point `x`
  have hfE : f (E j).genericPoint = ⟨x, hxV⟩ :=
    (hE.isGermExceptionalCurve j).1.prop.2 (genericPoint_mem_support (E j))
  have hxcl : IsClosed ({x} : Set S) := isClosed_singleton_of_notMem_smoothLocus hS hdim hx
  have hcen : (((⟨Y, f ≫ V.ι, hY₁, hbir₁, E j⟩ : DivisorOver ℂ sS).center : Set S)) ⊆
      (U₀ : Set S)ᶜ := by
    rw [DivisorOver.center_eq_closure_genericPoint]
    change closure {V.ι (f (E j).genericPoint)} ⊆ _
    rw [hfE, show V.ι ⟨x, hxV⟩ = x from rfl, hxcl.closure_eq, Set.singleton_subset_iff]
    exact fun hxU => hx (hU₀ hxU)
  have hb1 := hZ _ b hcen hb₁
  -- the log discrepancy of `E_j` over `V` is `1 + b`
  obtain ⟨hXv, -, ω, hω0, ⟨K₂, hK₂, hK₂ω⟩, m, r, C, C', hCc, hpres, hpb, hval⟩ :=
    (MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hb (1 + b)).2
      ⟨hres.isProper, rfl⟩
  have hdivω : divisorOfForm ω = K₂ := Finsupp.ext fun Γ => (hK₂ω Γ).symm
  have hpresR : Divisor.toRDivisor K₂ + QDivisor.toRDivisor (B.restrictOpen V) =
      ∑ i, r i • Divisor.toRDivisor (C i) := by
    refine DivisorWithCoeffs.ext' fun Γ => ?_
    rw [MMP.Flips.coeff_sum_smul_toRDivisor, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toRDivisor, hK₂ω]
    exact hpres Γ
  have hFb : MMP.Flips.IsDiscrepancy (V.ι ≫ sS) 2 K₂ (QDivisor.toRDivisor (B.restrictOpen V))
      (ProperDivisorOver.mk D hres.isProper).valuation b := by
    refine ⟨hK₂, ⟨m, r, C, hCc, ?_⟩, ⟨isDivisorOfFunctionField_valuation _, _, rfl⟩,
      ProperDivisorOver.mk D hres.isProper, ω, m, r, C, rfl, hdivω,
      hXv, hgerm.2.1, hω0, hCc, by rw [hdivω]; exact hpresR, C', hpb, ?_⟩
    · rw [hpresR]
      try simp only [← MMP.Flips.toRDivisor_eq_mapCoeffs]
    · change (b : ℝ) = (D.ordPullback ω : ℝ) - ∑ j, r j * ((C' j).coeff D.E : ℝ)
      linarith [hval]
  have hKB : HoldsOnGerm {(⟨x, hxV⟩ : V)} fun U : V.toScheme.Opens =>
      IsCartierCombination (DivisorWithCoeffs.restrictOpen U
        (Divisor.toRDivisor K₂ + QDivisor.toRDivisor (B.restrictOpen V))) := by
    let U₁ : V.toScheme.Opens := ⟨Set.univ, isOpen_univ⟩
    haveI : Nonempty U₁ := ⟨⟨⟨x, hxV⟩, trivial⟩⟩
    haveI : IsDominant U₁.ι := Opens.isDominant_ι (U₁.isOpen.dense ⟨⟨x, hxV⟩, trivial⟩)
    refine ⟨U₁, Set.subset_univ _, isCartierCombination_restrictOpen ?_ U₁⟩
    refine ⟨m, r, C, hCc, ?_⟩
    rw [hpresR]
    try simp only [← MMP.Flips.toRDivisor_eq_mapCoeffs]
  obtain ⟨a', ha', haj⟩ := MMP.Flips.IsGermLogDiscrepancyVector.isLogDiscrepancy ha hK₂ hKB j
    hYv hres.isBirationalMorphism hres.isProper
  have hab : a' = b := MMP.Flips.IsDiscrepancy.eq ha' hFb
  have : (0 : ℝ) < a j := by rw [haj, hab]; linarith [(by exact_mod_cast hb1 : (-1 : ℝ) < b)]
  exact_mod_cast this

/-- A divisor whose restriction to an open `V` is Cartier has a local equation near every point
of `V`: a local equation of `D|_V` on `W ⊆ V` is one of `D` on `W`, since the prime divisors of
`X` meeting `W` are the closures of those of `V` meeting `W`, with the same local rings. -/
private theorem exists_isLocalEquation_of_restrictOpen {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {D : Divisor X} {V : X.Opens} {x : X} (hx : x ∈ V)
    (h : ∃ W : V.toScheme.Opens, (⟨x, hx⟩ : V) ∈ W ∧ ∃ φ' : (RationalFunctions V)ˣ,
      Divisor.IsLocalEquation (D.restrictOpen V) W φ') :
    ∃ W : X.Opens, x ∈ W ∧ ∃ φ : (RationalFunctions X)ˣ, D.IsLocalEquation W φ := by
  have : Nonempty V := ⟨⟨x, hx⟩⟩
  have : IsDominant V.ι := Opens.isDominant_ι (V.isOpen.dense ⟨x, hx⟩)
  obtain ⟨W, hxW, φ', hφ'⟩ := h
  obtain ⟨g', hg', hφg'⟩ := MMP.Positivity.exists_ord_eq_of_units φ'
  obtain ⟨g, rfl⟩ := (functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤
    ⟨⟨x, hx⟩, trivial⟩).2 g'
  obtain ⟨φ, hφ⟩ := MMP.Positivity.exists_units_of_ne_zero (g := g)
    (fun h0 => hg' (by rw [h0, map_zero]))
  refine ⟨V.ι ''ᵁ W, ⟨⟨x, hx⟩, hxW, rfl⟩, φ, fun E hE => ?_⟩
  have hEW : E.genericPoint ∈ V.ι ''ᵁ W := (E.genericPoint_mem_iff _).2 hE
  obtain ⟨y, hyW, hy⟩ := hEW
  obtain ⟨E₀, rfl⟩ := (OpenWeilRestriction.mem_range_primeDivisorMap_iff V.ι E).2 ⟨y, hy⟩
  have hgp : V.ι E₀.genericPoint = V.ι y :=
    (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm.trans hy.symm
  have hE₀ : (E₀.support ∩ (W : Set V)).Nonempty := by
    rw [← PrimeDivisor.genericPoint_mem_iff]
    have : E₀.genericPoint = y := V.ι.isOpenEmbedding.injective hgp
    change E₀.genericPoint ∈ W
    rw [this]
    exact hyW
  have h1 := hφ' E₀ hE₀
  rw [DivisorWithCoeffs.coeff_restrictOpen] at h1
  rw [h1, hφg', hφ, MMP.Positivity.ord_functionFieldMap_of_isIso V.ι E₀ _
    (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm]

/-- Near a smooth point every divisor has a local equation. -/
private theorem exists_isLocalEquation_of_mem_smoothLocus {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sS]
    (D : Divisor S) {x : S} (hx : x ∈ smoothLocus sS) :
    ∃ U : S.Opens, x ∈ U ∧ ∃ φ : (RationalFunctions S)ˣ, D.IsLocalEquation U φ := by
  have hsm : IsSmoothScheme ((smoothLocus sS).ι ≫ sS) := by
    rw [isSmoothScheme_iff, ← Scheme.Hom.smoothLocus_eq_top_iff,
      ← Scheme.Hom.preimage_smoothLocus_eq, smoothLocus_eq_smoothLocus,
      Scheme.Opens.ι_preimage_self]
  exact exists_isLocalEquation_of_restrictOpen hx
    (MMP.Fourfold.isCartier_of_isSmoothScheme hsm _ ⟨x, hx⟩)

/-- Near a rational surface singularity every divisor has a multiple with a local equation. -/
private theorem exists_pos_isLocalEquation_of_isRationalSurfaceSingularity {S : Scheme.{0}}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)}
    {V : S.Opens} {x : V} (hx : IsRationalSurfaceSingularity (V.ι ≫ sS) x) (D : Divisor S) :
    ∃ m : ℕ, 0 < m ∧ ∃ U : S.Opens, (x : S) ∈ U ∧ ∃ φ : (RationalFunctions S)ˣ,
      ((m : ℤ) • D).IsLocalEquation U φ := by
  classical
  obtain ⟨W, hxW, n, r, L, hL, hE⟩ :=
    MMP.Flips.IsRationalSurfaceSingularity.exists_isCartierCombination_restrictOpen hx
      (Divisor.toQDivisor (D.restrictOpen V))
  set N : ℕ := ∏ j, (r j).den with hN
  have hN0 : 0 < N := Finset.prod_pos fun j _ => (r j).den_pos
  have hint : ∀ j, ∃ z : ℤ, (z : ℚ) = N * r j := fun j => by
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun j => (r j).den) (Finset.mem_univ j)
    refine ⟨c * (r j).num, ?_⟩
    rw [hN, hc]
    push_cast
    rw [mul_comm ((r j).den : ℚ), mul_assoc, Rat.den_mul_eq_num]
  choose z hz using hint
  have hcart : Divisor.IsCartier ((((N : ℤ) • D).restrictOpen V).restrictOpen W) := by
    have heq : (((N : ℤ) • D).restrictOpen V).restrictOpen W = ∑ j, z j • L j := by
      ext Γ
      have h1 := congrArg (fun E : QDivisor W => E Γ) hE
      have hm : ∀ M : Divisor W, (DivisorWithCoeffs.mapCoeffs (Int.cast : ℤ → ℚ) Int.cast_zero M) Γ =
          ((M Γ : ℤ) : ℚ) := fun M => rfl
      have hq : (DivisorWithCoeffs.restrictOpen W (Divisor.toQDivisor
          (DivisorWithCoeffs.restrictOpen V D))) Γ = ((D (OpenWeilRestriction.primeDivisorMap V.ι
            (OpenWeilRestriction.primeDivisorMap W.ι Γ)) : ℤ) : ℚ) := rfl
      simp only [Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul, hm, hq] at h1
      apply Int.cast_injective (α := ℚ)
      change ((((N : ℤ) • D) (OpenWeilRestriction.primeDivisorMap V.ι
        (OpenWeilRestriction.primeDivisorMap W.ι Γ)) : ℤ) : ℚ) = _
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.finsetSum_apply]
      simp only [Finsupp.smul_apply, smul_eq_mul]
      push_cast
      simp only [hz]
      rw [h1, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [heq]
    exact Finset.sum_induction _ Divisor.IsCartier (fun a b ha hb => ha.add hb)
      Divisor.isCartier_zero fun j _ => (hL j).zsmul (z j)
  haveI : Nonempty V := ⟨x⟩
  haveI : IsIntegral V := isIntegral_of_isOpenImmersion V.ι
  obtain ⟨W₁, hxW₁, φ₁, hφ₁⟩ := hcart ⟨x, hxW⟩
  obtain ⟨W₂, hxW₂, φ₂, hφ₂⟩ := exists_isLocalEquation_of_restrictOpen hxW ⟨W₁, hxW₁, φ₁, hφ₁⟩
  exact ⟨N, hN0, exists_isLocalEquation_of_restrictOpen x.2 ⟨W₂, hxW₂, φ₂, hφ₂⟩⟩

/-- **Dlt surfaces are `ℚ`-factorial** (Kollár–Mori, Proposition 4.11). A normal surface over `ℂ`
carrying a dlt pair is `ℚ`-factorial: its singular points are rational, and every divisor has a
Cartier multiple near a rational surface singularity (Lipman). -/
private theorem isQFactorial_of_isDltPair {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] {sS : S ⟶ Spec (.of ℂ)}
    (hS : IsNormalVariety ℂ sS) (hdim : topologicalKrullDim S = 2) {B : QDivisor S}
    (hdlt : MMP.Intersection.IsDltPair sS B) : IsQFactorial sS := by
  classical
  haveI : LocallyOfFiniteType sS := hS.1.toLocallyOfFiniteType
  refine ⟨hS, fun D => ?_⟩
  have hsing : ∀ x : S, x ∉ smoothLocus sS → ∃ m : ℕ, 0 < m ∧ ∃ U : S.Opens, x ∈ U ∧
      ∃ φ : (RationalFunctions S)ˣ, ((m : ℤ) • D).IsLocalEquation U φ := fun x hx => by
    obtain ⟨V, hxV, hrat⟩ := exists_isRationalSurfaceSingularity_of_isDltPair hS hdim hdlt hx
    exact exists_pos_isLocalEquation_of_isRationalSurfaceSingularity hrat D
  choose! m hm U hxU φ hφ using hsing
  set F := (finite_setOf_notMem_smoothLocus hS hdim).toFinset with hF
  refine ⟨∏ x ∈ F, m x, Finset.prod_pos fun x hx => hm x (by simpa [hF] using hx), fun x => ?_⟩
  by_cases hx : x ∈ smoothLocus sS
  · obtain ⟨U₀, hxU₀, φ₀, hφ₀⟩ := exists_isLocalEquation_of_mem_smoothLocus D hx
    exact ⟨U₀, hxU₀, φ₀ ^ ((∏ x ∈ F, m x : ℕ) : ℤ), hφ₀.zsmul _⟩
  · have hxF : x ∈ F := by simpa [hF] using hx
    obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem m hxF
    refine ⟨U x, hxU x hx, φ x ^ (c : ℤ), ?_⟩
    have := (hφ x hx).zsmul (c : ℤ)
    rwa [smul_smul, mul_comm, ← Nat.cast_mul, ← hc] at this

/-- A closed immersion of an integral scheme onto the support of a prime divisor sends the generic
point to the generic point of the divisor. -/
private theorem map_genericPoint_eq {Y T : Scheme.{0}} [IsIntegral T] (ι : T ⟶ Y)
    (P : Mori.PrimeDivisor Y) (hrange : Set.range ι.base = (P.support : Set Y)) :
    ι (genericPoint T) = P.genericPoint := by
  have h1 : closure ({ι (genericPoint T)} : Set Y) = Set.range ι.base := by
    apply le_antisymm
    · rw [hrange]
      exact (AlgebraicGeometry.PrimeDivisor.support_eq_closure P ▸
        isClosed_closure).closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr (hrange ▸ Set.mem_range_self _))
    · rintro _ ⟨z, rfl⟩
      have hz : genericPoint T ⤳ z := (genericPoint_spec T).specializes trivial
      exact specializes_iff_mem_closure.mp (hz.map ι.continuous)
  have h2 : closure ({ι (genericPoint T)} : Set Y) = closure {P.genericPoint} := by
    rw [h1, hrange, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact (inseparable_iff_closure_eq.mpr h2).eq

/-- The generic point of a prime divisor `P` lies in the support of a divisor only if `P` is a
component of it. -/
private theorem genericPoint_notMem_supp {Y : Scheme.{0}} {D : Divisor Y}
    (P : Mori.PrimeDivisor Y) (hP : D.coeff P = 0) : P.genericPoint ∉ D.supp := by
  rw [DivisorWithCoeffs.mem_supp_iff]
  rintro ⟨E, hE, hPE⟩
  obtain rfl := MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support hPE
  exact hE hP

/-- **Moving a Cartier multiple across a linear equivalence.** If `D₀ = m(K + B)` and
`K' - K = div φ`, then `D₀ + div(φ^m) = m(K' + B)`. -/
private theorem toQDivisor_add_principalDivisor_pow {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {D₀ K K' : Divisor X}
    {B : QDivisor X} {m : ℕ} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • (Divisor.toQDivisor K + B))
    {φ : (RationalFunctions X)ˣ} (hφ : K' - K = principalDivisor φ) :
    Divisor.toQDivisor (D₀ + principalDivisor (φ ^ m)) =
      (m : ℤ) • (Divisor.toQDivisor K' + B) := by
  ext Γ
  have h1 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
  have h2 := congrArg (fun G : Divisor X => G.coeff Γ) hφ
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_add, zsmul_eq_mul] at h1 ⊢
  simp only [DivisorWithCoeffs.coeff_sub, coeff_principalDivisor] at h2
  simp only [DivisorWithCoeffs.coeff_add, coeff_principalDivisor, PrimeDivisor.ord_pow]
  have h2' : (K'.coeff Γ : ℚ) - K.coeff Γ = Γ.ord φ := by exact_mod_cast h2
  push_cast
  rw [h1, nsmul_eq_mul]
  push_cast
  linear_combination (-(m : ℚ)) * h2'

/-- **Adjunction preserves semiampleness.** Let `(S, B_S)` be a floor component of a projective
`ℚ`-factorial dlt threefold pair `(Y, C)` with semiample adjoint `K_Y + C`. Then `K_S + B_S` is
semiample for the canonical divisor `K_S = div(Res_S σ)` of the residue of a top form `σ` with a
simple pole along `S`: `K_S + B_S = (div σ + C)|_S` and `div σ + C ∼ K_Y + C`. -/
private theorem exists_isRelativelySemiample_of_isAdjunctionStep {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] {sY : Y ⟶ Spec (.of ℂ)}
    (hY : Mori.IsProjectiveVariety ℂ sY) (hdim : topologicalKrullDim Y = 3)
    (hQ : IsQFactorial sY) {C : QDivisor Y}
    (hdlt : MMP.Intersection.IsDltPair sY C) {K : Divisor Y} (hK : K.IsCanonicalDivisor sY 3)
    (hsemi : QDivisor.IsRelativelySemiample sY (Divisor.toQDivisor K + C))
    {S : Scheme.{0}} [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S]
    {j : S ⟶ Y} {BS : QDivisor S} (hj : IsAdjunctionStep sY C j BS) {KS₁ : Divisor S}
    (hKS₁ : KS₁.IsCanonicalDivisor (j ≫ sY) 2) :
    ∃ KS : Divisor S, KS.IsCanonicalDivisor (j ≫ sY) 2 ∧
      QDivisor.IsRelativelySemiample (j ≫ sY) (Divisor.toQDivisor KS + BS) := by
  classical
  haveI : LocallyOfFiniteType sY := hY.toLocallyOfFiniteType
  have hYv : IsNormalVariety ℂ sY := ⟨hY.toIsVariety, inferInstance⟩
  obtain ⟨hSv, P, hP1, hrange, hci, -⟩ := id hj
  haveI := hci
  haveI : LocallyOfFiniteType (j ≫ sY) := hSv.1.toLocallyOfFiniteType
  have hCP : C.coeff P = 1 := le_antisymm (hdlt.2.1 P) hP1
  obtain ⟨σ, hσ0, hσP, ρ, hρ, hρ0⟩ :=
    exists_ordForm_eq_neg_one_isPoincareResidue_of_charZero sY (n := 2) hdim j P hrange
  have hD : (Divisor.toQDivisor (divisorOfForm σ) + C).IsQCartier :=
    isQCartier_of_isQFactorial sY hQ _
  obtain ⟨hgen, hpb⟩ := hj.isPullback_divisorOfForm_add_of_isPoincareResidue (n := 2) hdim P
    hrange σ hσ0 hσP ρ hρ hD
  obtain ⟨m, hm, L, hL, hLc, hfree⟩ :=
    exists_isRelativelyFreeDivisor_of_isRelativelySemiample sY _ hsemi
  obtain ⟨φ, hφ⟩ : (divisorOfForm σ).LinearlyEquivalent K := by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hYv hK (m := 1) hσ0
  set L' : Divisor Y := L + principalDivisor (φ ^ m) with hL'_def
  have hL' : Divisor.toQDivisor L' = (m : ℤ) • (Divisor.toQDivisor (divisorOfForm σ) + C) :=
    toQDivisor_add_principalDivisor_pow hL hφ
  have hL'c : L'.IsCartier := hLc.add (Divisor.isCartier_principalDivisor _)
  have hL'P : L'.coeff P = 0 := by
    have := congrArg (fun D : QDivisor Y => D.coeff P) hL'
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, hσP, hCP] at this
    exact_mod_cast (by simpa using this : (L'.coeff P : ℚ) = 0)
  obtain ⟨D', hD', hpbD⟩ := hpb m hm L' hL' hL'c
  have hjη : ∀ Z : irreducibleComponents S, j (componentGenericPoint S Z) = P.genericPoint :=
    fun Z => by rw [componentGenericPoint_eq_genericPoint Z]; exact map_genericPoint_eq j P hrange
  refine ⟨divisorOfForm ρ, hKS₁.of_linearlyEquivalent (by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hSv hKS₁ (m := 1) hρ0),
    isRelativelySemiample_of_isRelativelyFreeDivisor (j ≫ sY) _
      ⟨m, hm, D', hD', isCartier_of_isPullback j hL'c hpbD, ?_⟩⟩
  refine isRelativelyFreeDivisor_of_forall_exists (j ≫ sY) fun s => ?_
  obtain ⟨U₀, hU₀, ψ, hψ1, hψ2⟩ := exists_coeff_add_ord_eq_zero_of_isRelativelyFree sY hLc hfree (j s)
  set ψ' := ψ * (φ ^ m)⁻¹ with hψ'_def
  set G : Divisor Y := L' + principalDivisor ψ' with hG_def
  have hGcoeff : ∀ Γ, G.coeff Γ = L.coeff Γ + Γ.ord ψ := fun Γ => by
    simp only [hG_def, hL'_def, hψ'_def, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
      PrimeDivisor.ord_mul, PrimeDivisor.ord_inv]
    ring
  have hψ'P : (principalDivisor ψ').coeff P = 0 := by
    have h1 := hψ2 P (by rw [← hrange]; exact ⟨s, rfl⟩)
    have h2 := hGcoeff P
    rw [hG_def, DivisorWithCoeffs.coeff_add, hL'P, zero_add] at h2
    rw [h2, h1]
  have hGP : G.coeff P = 0 := by rw [hG_def, DivisorWithCoeffs.coeff_add, hL'P, hψ'P, add_zero]
  have hB₁ : ∀ Z : irreducibleComponents S, j (componentGenericPoint S Z) ∉ L'.supp :=
    fun Z => by rw [hjη]; exact genericPoint_notMem_supp P hL'P
  have hB₂ : ∀ Z : irreducibleComponents S,
      j (componentGenericPoint S Z) ∉ (principalDivisor ψ').supp :=
    fun Z => by rw [hjη]; exact genericPoint_notMem_supp P hψ'P
  have hB : ∀ Z : irreducibleComponents S, j (componentGenericPoint S Z) ∉ G.supp :=
    fun Z => by rw [hjη]; exact genericPoint_notMem_supp P hGP
  have hpbG := (hpbD.of_eq rfl (hB₂ := hB₁)).add hL'c (Divisor.isCartier_principalDivisor ψ') hB
    (Divisor.isPullback_principalDivisor ψ' hB₂)
  have hGc : G.IsCartier := hL'c.add (Divisor.isCartier_principalDivisor _)
  have hU₀top : ∀ Γ : Mori.PrimeDivisor Y, (Γ.support ∩ sY ⁻¹ᵁ U₀).Nonempty := by
    intro Γ
    obtain ⟨y⟩ : Nonempty Γ.support := ⟨⟨Γ.genericPoint, genericPoint_mem_support Γ⟩⟩
    refine ⟨y, y.2, ?_⟩
    have : sY.base y = sY.base (j s) := Subsingleton.elim _ _
    show sY.base y ∈ U₀
    rw [this]; exact hU₀
  refine ⟨U₀, hU₀, pullbackRationalFunction j ψ' hB₂, fun E _ => ?_, fun E hsE => ?_⟩
  · have := (coeff_isPullback_of_forall j hGc hpbG E.genericPoint).1 (fun Γ _ => by
      rw [hGcoeff]; exact hψ1 Γ (hU₀top Γ)) E (genericPoint_mem_support E)
    simpa [DivisorWithCoeffs.coeff_add, coeff_principalDivisor] using this
  · have := (coeff_isPullback_of_forall j hGc hpbG s).2 (fun Γ hΓ => by
      rw [hGcoeff]; exact hψ2 Γ hΓ) E hsE
    simpa [DivisorWithCoeffs.coeff_add, coeff_principalDivisor] using this

/-- A flag of iterated adjunction of length one is a single adjunction step. -/
private theorem isAdjunctionStep_of_length_eq_one {Y : Scheme.{0}} [IsLocallyNoetherian Y]
    [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} {C : QDivisor Y} {T : Scheme.{0}} {ι : T ⟶ Y}
    {BT : QDivisor T} (F : StratumAdjunctionData sY C ι BT) (h : F.length = 1) :
    IsAdjunctionStep sY C ι BT := by
  cases F with
  | refl _ => simp [StratumAdjunctionData.length] at h
  | step F' j BT' hj =>
    cases F' with
    | refl _ => simpa using hj
    | step F'' _ _ _ => simp [StratumAdjunctionData.length] at h

/-- **Floor components.** Every prime component `P` of the reduced boundary of a `ℚ`-factorial
projective dlt threefold pair `(Y, C)` over `ℂ` with semiample adjoint is the image of an
adjunction step `(S, B_S)` which is a `ℚ`-factorial projective dlt surface pair with semiample
adjoint. -/
private theorem exists_floorModel {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} (hY : Mori.IsProjectiveVariety ℂ sY)
    (hdim : topologicalKrullDim Y = 3) (hQ : IsQFactorial sY) {C : QDivisor Y}
    (hC : Fourfold.IsPair sY C) (hdlt : MMP.Intersection.IsDltPair sY C) {K : Divisor Y}
    (hK : K.IsCanonicalDivisor sY 3)
    (hsemi : QDivisor.IsRelativelySemiample sY (Divisor.toQDivisor K + C))
    (P : Mori.PrimeDivisor Y) (hP : ⌊C.coeff P⌋ ≠ 0) :
    ∃ (S : Scheme.{0}) (_ : IsIntegral S) (_ : CompactSpace S) (_ : IsLocallyNoetherian S)
      (_ : IsNormal S) (j : S ⟶ Y) (BS : QDivisor S),
      (IsAdjunctionStep sY C j BS ∧ Set.range j.base = (P.support : Set Y)) ∧
      Mori.IsProjectiveVariety ℂ (j ≫ sY) ∧ topologicalKrullDim S = 2 ∧
      IsQFactorial (j ≫ sY) ∧ Fourfold.IsPair (j ≫ sY) BS ∧
      MMP.Intersection.IsDltPair (j ≫ sY) BS ∧
      ∃ KS : Divisor S, KS.IsCanonicalDivisor (j ≫ sY) 2 ∧
        QDivisor.IsRelativelySemiample (j ≫ sY) (Divisor.toQDivisor KS + BS) := by
  haveI : LocallyOfFiniteType sY := hY.toLocallyOfFiniteType
  have hP1 : 1 ≤ C.coeff P := by
    by_contra hlt
    exact hP (Int.floor_eq_zero_iff.mpr ⟨hC.nonneg P, not_le.mp hlt⟩)
  have hstr : IsDltStratum sY C (P.support : Set Y) := by
    refine ⟨hdlt, {P}, Finset.singleton_nonempty _, by simpa using hP1,
      ⟨P.genericPoint, by simpa using genericPoint_mem_support P⟩, ⟨⟨?_, by simp⟩, ?_⟩⟩
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
    · intro T hT _
      simpa using hT.2
  obtain ⟨⟨⟨T, ι, BT, hrange, ⟨F⟩⟩, hdltF⟩, -⟩ :=
    IsDltStratum.exists_isStratumAdjunctionPair_and_isDltPair hstr
  have hdT := hdltF F hrange
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  haveI := F.isClosedImmersion
  haveI : LocallyOfFiniteType (ι ≫ sY) := F.isNormalVariety.1.toLocallyOfFiniteType
  -- `T` is a surface and the flag has length one
  have htr := trdeg_add_one_of_eq_genericPoint (sY := sY) (j := ι) P
    (map_genericPoint_eq ι P hrange)
  rw [toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) (d := 3) hdim] at htr
  have hTdim : topologicalKrullDim T = 2 := by
    rw [topologicalKrullDim_eq_toNat_trdeg (ι ≫ sY)]
    have h2 : (letI := functionFieldAlgebra (ι ≫ sY);
        (Algebra.trdeg ℂ T.functionField).toNat) = 2 := by omega
    rw [h2]
    rfl
  have hlen := F.dim_add_length (n := 3) hdim (e := 2) hTdim
  have hstep := isAdjunctionStep_of_length_eq_one F (by omega)
  haveI : QuasiCompact (ι ≫ sY) := F.isNormalVariety.1.toQuasiCompact
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace (ι ≫ sY)
  obtain ⟨-, e, KS₁, hKS₁, -⟩ := hdT.1.1
  have he : e = 2 := by
    have := hKS₁.topologicalKrullDim_eq.symm.trans hTdim
    exact_mod_cast this
  subst he
  haveI : QuasiCompact sY := hY.toQuasiCompact
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  obtain ⟨KS, hKS, hKSs⟩ :=
    exists_isRelativelySemiample_of_isAdjunctionStep hY hdim hQ hdlt hK hsemi hstep hKS₁
  exact ⟨T, inferInstance, inferInstance, inferInstance, inferInstance, ι, BT, ⟨hstep, hrange⟩,
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr
      ⟨F.isNormalVariety.1, isProjectiveMorphism_comp_of_isFinite ι sY hY.isProjective⟩,
    hTdim, isQFactorial_of_isDltPair F.isNormalVariety hTdim hdT,
    ⟨inferInstance, inferInstance, hdT.1.1, hdT.1.2.1⟩, hdT, KS, hKS, hKSs⟩

/-! ### Local generators -/

/-- **Powers of rational pluriforms on a line.** On an integral scheme of dimension `d`, there is
a `c`-th power map from rational `a`-canonical forms to rational `ac`-canonical forms sending
`f ω^{⊗a}` to `f^c ω^{⊗ac}` for every rational function `f` and every top form `ω`. -/
private theorem exists_powForm {X : Scheme.{0}} [IsIntegral X] {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] {d : ℕ} (hd : topologicalKrullDim X = d) (a c : ℕ) :
    letI := functionFieldAlgebra sX
    ∃ P : RationalPluriForms sX d a → RationalPluriForms sX d ((a * c : ℕ) : ℤ),
      ∀ (f : X.functionField) (ω : ⋀[X.functionField]^d Ω[X.functionField⁄ℂ]),
        P (f • formPow ω a) = f ^ c • formPow ω (a * c) := by
  let := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hd
  refine ⟨fun τ => ((ZTensorPower.basis b a).repr τ ()) ^ c • formPow (b ()) (a * c),
    fun f ω => ?_⟩
  have hpow : ∀ e : ℕ, formPow ω e = (b.repr ω ()) ^ e • formPow (b ()) e := fun e => by
    conv_lhs => rw [← basis_unit_repr_smul b ω]
    rw [formPow_smul]
  simp only
  rw [hpow a, smul_smul, repr_smul_formPow, hpow (a * c), smul_smul, mul_pow, ← pow_mul,
    mul_comm a c]

/-- A residue presentation of `s` along `P` gives one of the `c`-th power of `s`. -/
private theorem isLogResiduePresentation_powForm {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n a c : ℕ} {i : N.ι} {P : Mori.PrimeDivisor (N.X i)}
    {V : T.Opens} {hP : (N.n i).base P.genericPoint ∈ V} {α : Fin (n - 1) → Γ(T, V)}
    {g : Γ(T, V)} {ε : ℤ} {s : RationalPluriForms (N.n i ≫ sT) n a}
    (h : IsLogResiduePresentation N n a i P V hP α g ε s)
    (Pw : RationalPluriForms (N.n i ≫ sT) n a →
      RationalPluriForms (N.n i ≫ sT) n ((a * c : ℕ) : ℤ))
    (hPw : letI := functionFieldAlgebra (N.n i ≫ sT)
      ∀ (f : (N.X i).functionField) (ω : ⋀[(N.X i).functionField]^n Ω[(N.X i).functionField⁄ℂ]),
        Pw (f • formPow ω a) = f ^ c • formPow ω (a * c)) :
    IsLogResiduePresentation N n (a * c) i P V hP α (g ^ c) (ε ^ c) (Pw s) := by
  obtain ⟨z, h', hz, hs, hda, hres⟩ := h
  refine ⟨z, h' ^ c, hz, ?_, hda, ?_⟩
  · rw [hs, map_pow]
    exact hPw _ _
  · beta_reduce at hres ⊢
    simp only [map_pow, hres, mul_pow]
    push_cast
    rfl

/-- Local generators of `𝒪_T(m₁L)` with sign-one residue presentations give local generators of
the same kind in every degree divisible by `m₁`. -/
private theorem exists_generator_of_dvd {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n : ℕ} {Θ : ∀ i, QDivisor (N.X i)} {m₁ : ℕ}
    (hdim : ∀ i, topologicalKrullDim (N.X i) = n)
    (hgen : ∀ x : T, ∃ (U : T.Opens) (_ : x ∈ U) (s : ∀ i, RationalPluriForms (N.n i ≫ sT) n m₁),
      IsAdjointGeneratorOn N n m₁ Θ U s ∧
        ∀ i (P : Mori.PrimeDivisor (N.X i)), (N.n i).base P.genericPoint ∈ U →
          (N.n i).base P.genericPoint ∈ (doubleIntersectionLocus T : Set T) →
          ∃ (V : T.Opens) (hP : (N.n i).base P.genericPoint ∈ V) (a : Fin (n - 1) → Γ(T, V))
            (g : Γ(T, V)), IsLogResiduePresentation N n m₁ i P V hP a g 1 (s i))
    {m : ℕ} (hm : m₁ ∣ m) (hm0 : 0 < m) :
    ∀ x : T, ∃ (U : T.Opens) (_ : x ∈ U) (s : ∀ i, RationalPluriForms (N.n i ≫ sT) n m),
      IsAdjointGeneratorOn N n m Θ U s ∧
        ∀ i (P : Mori.PrimeDivisor (N.X i)), (N.n i).base P.genericPoint ∈ U →
          (N.n i).base P.genericPoint ∈ (doubleIntersectionLocus T : Set T) →
          ∃ (V : T.Opens) (hP : (N.n i).base P.genericPoint ∈ V) (a : Fin (n - 1) → Γ(T, V))
            (g : Γ(T, V)), IsLogResiduePresentation N n m i P V hP a g 1 (s i) := by
  obtain ⟨c, rfl⟩ := hm
  haveI : ∀ i, LocallyOfFiniteType (N.n i ≫ sT) := fun i =>
    (N.isNormalVariety i).1.toLocallyOfFiniteType
  choose Pw hPw using fun i => exists_powForm (sX := N.n i ≫ sT) (hdim i) m₁ c
  intro x
  obtain ⟨U, hxU, s, ⟨hgo, hres⟩, hself⟩ := hgen x
  refine ⟨U, hxU, fun i => Pw i (s i), ⟨fun i => ?_, fun i j P P' h₁ h₂ h₃ h₄ => ?_⟩,
    fun i P h₁ h₂ => ?_⟩
  · let := functionFieldAlgebra (N.n i ≫ sT)
    obtain ⟨b⟩ := exists_basis_topForms (sX := N.n i ≫ sT) (hdim i)
    have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := N.n i ≫ sT) (hdim i)
    set f := (ZTensorPower.basis b m₁).repr (s i) () with hf_def
    have hf0 : f ≠ 0 := repr_ne_zero_of_ne_zero b (hgo i).1
    have hsi : s i = f • formPow (b ()) m₁ := eq_repr_smul_formPow b (s i)
    have hP : Pw i (s i) = f ^ c • formPow (b ()) (m₁ * c) := by rw [hsi]; exact hPw i _ _
    have hP0 : Pw i (s i) ≠ 0 := by
      rw [hP, ← ZTensorPower.basis_natCast]
      exact smul_ne_zero (pow_ne_zero _ hf0) ((ZTensorPower.basis b _).ne_zero ())
    refine ⟨hP0, fun Γ hΓ => ?_⟩
    obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
    have e1 := (hgo i).2 Γ hΓ
    rw [hNΓ _ _ (hgo i).1, ← hf_def] at e1
    rw [hNΓ _ _ hP0, hP, repr_smul_formPow, ← zpow_natCast, ord_zpow _ hf0]
    push_cast at e1 ⊢
    linear_combination (c : ℚ) * e1
  · obtain ⟨V, hP, hP', a, g, hpr, hpr'⟩ := hres i j P P' h₁ h₂ h₃ h₄
    refine ⟨V, hP, hP', a, g ^ c, by
      have := isLogResiduePresentation_powForm hpr (Pw i) (hPw i)
      rwa [one_pow] at this, ?_⟩
    have := isLogResiduePresentation_powForm hpr' (Pw j) (hPw j)
    rwa [← pow_mul] at this
  · obtain ⟨V, hP, a, g, hpr⟩ := hself i P h₁ h₂
    have := isLogResiduePresentation_powForm hpr (Pw i) (hPw i)
    rw [one_pow] at this
    exact ⟨V, hP, a, g ^ c, this⟩

/-! ### Assembly -/

/-- The germ of the pull-back of a function does not change under restriction. -/
private theorem germ_app_res {X T : Scheme.{0}} (ν : X ⟶ T) {V V' : T.Opens} (h : V' ≤ V)
    (a : Γ(T, V)) (x : X) (hx : ν.base x ∈ V') :
    X.presheaf.germ (ν ⁻¹ᵁ V') x hx (ν.app V' (a |_ V')) =
      X.presheaf.germ (ν ⁻¹ᵁ V) x (h hx) (ν.app V a) := by
  rw [← Scheme.Hom.germ_stalkMap_apply, ← Scheme.Hom.germ_stalkMap_apply]
  congr 1
  exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

/-- A unit on `U` pulls back to a rational function of order zero along every prime divisor of
`X` meeting the preimage of `U`. -/
private theorem ord_germToFunctionField_eq_zero {X T : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (ν : X ⟶ T) {U : T.Opens} {f : Γ(T, U)} (hf : IsUnit f)
    [Nonempty (ν ⁻¹ᵁ U)] (Γ : Mori.PrimeDivisor X) (hΓ : (Γ.support ∩ (ν ⁻¹ᵁ U)).Nonempty) :
    X.ord ((X.germToFunctionField (ν ⁻¹ᵁ U)).hom (ν.app U f)) Γ.genericPoint = 0 := by
  obtain ⟨y, hyΓ, hyU⟩ := hΓ
  have hspec : Γ.genericPoint ⤳ y := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyΓ
    exact specializes_iff_mem_closure.mpr hyΓ
  have hgU : Γ.genericPoint ∈ ν ⁻¹ᵁ U := hspec.mem_open (ν ⁻¹ᵁ U).isOpen hyU
  rw [← Scheme.algebraMap_germ_eq_germToFunctionField X hgU]
  exact Γ.ord_algebraMap_of_isUnit ((hf.map (ν.app U).hom).map _)

/-- A residue presentation of `s` along `P` gives one of `ν^*f · s`, for a function `f` on `U`
with `νᵢ(P) ∈ U`, on the smaller open `V ⊓ U`. -/
private theorem isLogResiduePresentation_germ_smul {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n m : ℕ} {i : N.ι} {P : Mori.PrimeDivisor (N.X i)}
    {V U : T.Opens} {hP : (N.n i).base P.genericPoint ∈ V} (hPU : (N.n i).base P.genericPoint ∈ U)
    {a : Fin (n - 1) → Γ(T, V)} {g : Γ(T, V)} {ε : ℤ} {s : RationalPluriForms (N.n i ≫ sT) n m}
    (h : IsLogResiduePresentation N n m i P V hP a g ε s) (f : Γ(T, U))
    [Nonempty (N.n i ⁻¹ᵁ U)] :
    IsLogResiduePresentation N n m i P (V ⊓ U) ⟨hP, hPU⟩ (fun j => a j |_ (V ⊓ U))
      (g |_ (V ⊓ U) * f |_ (V ⊓ U))
      ε (((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • s) := by
  obtain ⟨z, h', hz, hs, hda, hres⟩ := h
  have hV : V ⊓ U ≤ V := inf_le_left
  have hU : V ⊓ U ≤ U := inf_le_right
  have hpull : ∀ b : Γ(T, V), (N.X i).presheaf.germ (N.n i ⁻¹ᵁ (V ⊓ U)) P.genericPoint
      ⟨hP, hPU⟩ ((N.n i).app (V ⊓ U) (b |_ (V ⊓ U))) =
      (N.X i).presheaf.germ (N.n i ⁻¹ᵁ V) P.genericPoint hP ((N.n i).app V b) :=
    fun b => germ_app_res (N.n i) hV b P.genericPoint ⟨hP, hPU⟩
  have hpullU : (N.X i).presheaf.germ (N.n i ⁻¹ᵁ (V ⊓ U)) P.genericPoint
      ⟨hP, hPU⟩ ((N.n i).app (V ⊓ U) (f |_ (V ⊓ U))) =
      (N.X i).presheaf.germ (N.n i ⁻¹ᵁ U) P.genericPoint hPU ((N.n i).app U f) :=
    germ_app_res (N.n i) hU f P.genericPoint ⟨hP, hPU⟩
  refine ⟨z, (N.X i).presheaf.germ (N.n i ⁻¹ᵁ U) P.genericPoint hPU ((N.n i).app U f) * h', hz,
    ?_, ?_, ?_⟩
  · simp only [hpull]
    rw [hs, map_mul, ← Scheme.algebraMap_germ_eq_germToFunctionField (N.X i) hPU]
    beta_reduce
    exact (mul_smul _ _ _).symm
  · simpa only [hpull] using hda
  · simp only [map_mul, hpull, hpullU, hres]
    ring

/-- A unit multiple `f • g` of a local generator `g` of `𝒪_T(mL)` on `U` is a local generator on
`U`, provided it is nonzero on every component. -/
private theorem isAdjointGeneratorOn_of_isUnit {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n m : ℕ} {Θ : ∀ i, QDivisor (N.X i)}
    (hdim : ∀ i, topologicalKrullDim (N.X i) = n) {U : T.Opens}
    {g t : ∀ i, RationalPluriForms (N.n i ≫ sT) n m} {f : Γ(T, U)} (hf : IsUnit f)
    (hg : IsAdjointGeneratorOn N n m Θ U g)
    (ht : ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
      t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i)
    (ht0 : ∀ i, t i ≠ 0) :
    IsAdjointGeneratorOn N n m Θ U t := by
  refine ⟨fun i => ⟨ht0 i, fun Γ hΓ => ?_⟩, fun i j P P' h₁ h₂ h₃ h₄ => ?_⟩
  · haveI : Nonempty (N.n i ⁻¹ᵁ U) := ⟨⟨hΓ.some, hΓ.some_mem.2⟩⟩
    haveI : LocallyOfFiniteType (N.n i ≫ sT) := (N.isNormalVariety i).1.toLocallyOfFiniteType
    have hφ := ord_germToFunctionField_eq_zero (N.n i) hf Γ hΓ
    have hφ0 : ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) ≠ 0 :=
      ((hf.map ((N.n i).app U).hom).map ((N.X i).germToFunctionField _).hom).ne_zero
    rw [ht i inferInstance, Γ.ordForm_smul_of_topologicalKrullDim_eq (hdim i) hφ0 (hg.1 i).1, hφ,
      zero_add]
    exact (hg.1 i).2 Γ hΓ
  · obtain ⟨V, hP, hP', a, g', hpr, hpr'⟩ := hg.2 i j P P' h₁ h₂ h₃ h₄
    haveI : Nonempty (N.n i ⁻¹ᵁ U) := ⟨⟨P.genericPoint, h₂⟩⟩
    have h₂' : (N.n j).base P'.genericPoint ∈ U := h₁ ▸ h₂
    haveI : Nonempty (N.n j ⁻¹ᵁ U) := ⟨⟨P'.genericPoint, h₂'⟩⟩
    refine ⟨V ⊓ U, ⟨hP, h₂⟩, ⟨hP', h₂'⟩, fun j => a j |_ (V ⊓ U), g' |_ (V ⊓ U) * f |_ (V ⊓ U),
      ?_, ?_⟩
    · rw [ht i inferInstance]
      exact isLogResiduePresentation_germ_smul h₂ hpr f
    · rw [ht j inferInstance]
      exact isLogResiduePresentation_germ_smul h₂' hpr' f

/-- Every point of `T` lies under a point of some normalization component. -/
private theorem exists_base_eq {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : NormalizationComponents sT hT) (x : T) : ∃ i z, (N.n i).base z = x := by
  obtain ⟨φ, hφ⟩ := N.exists_iso
  have hsurj : Surjective (slcCurveNormalization T hT) := Scheme.surjective_normalization T hT
  obtain ⟨w, rfl⟩ := hsurj.surj x
  obtain ⟨⟨i, z⟩, hz⟩ := (sigmaMk N.X).surjective (φ.inv.base w)
  refine ⟨i, z, ?_⟩
  have h1 : (Limits.Sigma.ι N.X i ≫ φ.hom ≫ slcCurveNormalization T hT).base z =
      (N.n i).base z := by
    rw [hφ, Limits.Sigma.ι_desc]
  have h2 : φ.hom.base (φ.inv.base w) = w := by
    rw [← Scheme.Hom.comp_apply φ.inv φ.hom, Iso.inv_hom_id]
    rfl
  rw [← h1, Scheme.Hom.comp_apply, ← sigmaMk_mk, hz, Scheme.Hom.comp_apply, h2]

/-- **The ratio of two local generators is a unit.** Two forms generating
`𝒪_X(m(K_X + Θ))` near a point `z` of a normal variety differ by a unit of `𝒪_{X,z}`. -/
private theorem exists_isUnit_smul_eq_of_generatesOn {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX]
    {d : ℕ} (hd : topologicalKrullDim X = d) {Θ : QDivisor X} {m : ℕ} {W W' : X.Opens}
    {g g' : RationalPluriForms sX d m} (hg : GeneratesOn Θ m W g) (hg' : GeneratesOn Θ m W' g')
    {z : X} (hz : z ∈ W) (hz' : z ∈ W') :
    ∃ u : X.presheaf.stalk z, IsUnit u ∧ g' = algebraMap _ X.functionField u • g := by
  let := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hd
  set B := ZTensorPower.basis b (m : ℤ)
  have hc : B.repr g () ≠ 0 := repr_ne_zero_of_ne_zero b hg.1
  set ψ := B.repr g' () / B.repr g ()
  have hψ : g' = ψ • g := by
    rw [← basis_unit_repr_smul B g, ← basis_unit_repr_smul B g']
    exact (by rw [← mul_smul, div_mul_cancel₀ _ hc] :
      (B.repr g' () • B () : ZTensorPower _ _ _) = ψ • B.repr g () • B ())
  have hψ0 : ψ ≠ 0 := div_ne_zero (repr_ne_zero_of_ne_zero b hg'.1) hc
  have hord : ∀ Γ : Mori.PrimeDivisor X, z ∈ Γ.support → X.ord ψ Γ.genericPoint = 0 := by
    intro Γ hΓ
    have e1 := hg.2 Γ ⟨z, hΓ, hz⟩
    have e2 := hg'.2 Γ ⟨z, hΓ, hz'⟩
    rw [hψ, Γ.ordForm_smul_of_topologicalKrullDim_eq hd hψ0 hg.1] at e2
    push_cast at e2
    have : (X.ord ψ Γ.genericPoint : ℚ) = 0 := by linarith
    exact_mod_cast this
  obtain ⟨u, hu, hu'⟩ := exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero z hψ0 hord
  exact ⟨u, hu, by rw [hu', ← hψ]⟩

/-- Restricting a local generator of `𝒪_T(mL)` to a smaller open keeps it a local generator. -/
private theorem isAdjointGeneratorOn_mono {k : Type} [Field k] {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {n m : ℕ} {Θ : ∀ i, QDivisor (N.X i)} {U U' : T.Opens}
    {g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m} (hg : IsAdjointGeneratorOn N n m Θ U g)
    (hU : U' ≤ U) : IsAdjointGeneratorOn N n m Θ U' g :=
  ⟨fun i => (hg.1 i).mono fun _ hx => hU hx,
    fun i j P P' h₁ h₂ h₃ h₄ => hg.2 i j P P' h₁ (hU h₂) h₃ h₄⟩

/-- The image of a section in the function field does not change under restriction. -/
private theorem germToFunctionField_app_res {k : Type} [Field k] {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : NormalizationComponents sT hT) (i : N.ι) {U U' : T.Opens} (hU : U' ≤ U) (f : Γ(T, U))
    [Nonempty (N.n i ⁻¹ᵁ U')] [Nonempty (N.n i ⁻¹ᵁ U)] :
    ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom ((N.n i).app U' (f |_ U')) =
      ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) := by
  have h := congrArg (fun φ => ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom (φ.hom f))
    ((N.n i).naturality (homOfLE hU).op)
  simp only [CommRingCat.comp_apply] at h
  change ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom
    ((N.n i).app U' (T.presheaf.map (homOfLE hU).op f)) = _
  rw [h]
  exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

/-- **Generation at a point by a descended section.** In the setting of preadmissible conductor
descent, suppose every preadmissible system descends to a unique section of `𝒪_T(mL)`, and every
point `x` has a preadmissible system whose descended section is a unit multiple of a local
generator near `x`. Then every point has a neighbourhood on which some descended section is
itself a local generator, nonzero on every component. -/
private theorem exists_isAdjointGeneratorOn_of_descent {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} [Finite N.ι] {n : ℕ} {Θ : ∀ i, QDivisor (N.X i)}
    {Y : N.ι → Scheme.{0}} [∀ i, IsIntegral (Y i)] [∀ i, IsLocallyNoetherian (Y i)]
    [∀ i, IsNormal (Y i)] (p : ∀ i, Y i ⟶ N.X i) [∀ i, IsDominant (p i)]
    (hproj : ∀ i, IsProjectiveMorphism (p i)) {C : ∀ i, QDivisor (Y i)}
    (hcrep : ∀ i, ∃ (K : Divisor (N.X i)) (hY : IsNormalVariety ℂ (p i ≫ N.n i ≫ sT))
      (hp : IsBirationalMorphism (p i)),
      IsCrepantBoundary (N.n i ≫ sT) n K (Θ i) (p i) hY hp (C i))
    (hdim : ∀ i, topologicalKrullDim (N.X i) = n)
    {m : ℕ} (R : ResidueRestriction (fun i => p i ≫ N.n i ≫ sT) C n m)
    (hdesc1 : ∀ s ∈ preadmissibleSections R,
      ∃ t : ∀ i, RationalPluriForms (N.n i ≫ sT) n m,
        (∀ x : T, ∃ (U : T.Opens) (_ : x ∈ U) (g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m)
          (f : Γ(T, U)), IsAdjointGeneratorOn N n m Θ U g ∧
            ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
              t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i) ∧
        ∀ i, pullbackRationalPluriForms (N.n i ≫ sT) (p i) (t i) = (s i : _))
    (hdesc2 : ∀ x : T, ∃ s ∈ preadmissibleSections R,
      ∃ (t : ∀ i, RationalPluriForms (N.n i ≫ sT) n m) (U : T.Opens) (_ : x ∈ U)
        (g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m) (f : Γ(T, U)),
        IsUnit f ∧ IsAdjointGeneratorOn N n m Θ U g ∧
        (∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
          t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i) ∧
        ∀ i, pullbackRationalPluriForms (N.n i ≫ sT) (p i) (t i) = (s i : _))
    (x : T) :
    ∃ t : ∀ i, RationalPluriForms (N.n i ≫ sT) n m,
      (∀ y : T, ∃ (U : T.Opens) (_ : y ∈ U) (g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m)
        (f : Γ(T, U)), IsAdjointGeneratorOn N n m Θ U g ∧
          ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
            t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i) ∧
      ∃ (U : T.Opens) (_ : x ∈ U), IsAdjointGeneratorOn N n m Θ U t := by
  classical
  haveI : ∀ i, LocallyOfFiniteType (N.n i ≫ sT) := fun i =>
    (N.isNormalVariety i).1.toLocallyOfFiniteType
  -- the descended sections
  let IsSec : (∀ i, RationalPluriForms (N.n i ≫ sT) n m) → Prop := fun t =>
    ∃ s ∈ preadmissibleSections R,
      ∀ i, pullbackRationalPluriForms (N.n i ≫ sT) (p i) (t i) = (s i : _)
  have hinj : ∀ i, Function.Injective
      (pullbackRationalPluriForms (d := n) (m := m) (N.n i ≫ sT) (p i)) := fun i => by
    obtain ⟨-, -, hp, -⟩ := hcrep i
    exact pullbackRationalPluriForms_injective _ (hdim i) (p i) hp _
  have hsec : ∀ t, IsSec t → ∀ y : T, ∃ (U : T.Opens) (_ : y ∈ U)
      (g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m) (f : Γ(T, U)),
      IsAdjointGeneratorOn N n m Θ U g ∧ ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
        t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i := by
    rintro t ⟨s, hs, hts⟩
    obtain ⟨t₀, ht₀, ht₀p⟩ := hdesc1 s hs
    have : t₀ = t := funext fun i => hinj i ((ht₀p i).trans (hts i).symm)
    exact this ▸ ht₀
  have hlin : ∀ t t', IsSec t → IsSec t' → ∀ c : ℂ, IsSec (t + c • t') := by
    rintro t t' ⟨s, hs, hts⟩ ⟨s', hs', hts'⟩ c
    refine ⟨s + c • s', add_mem hs (Submodule.smul_mem _ c hs'), fun i => ?_⟩
    rw [Pi.add_apply, Pi.smul_apply, pullbackRationalPluriForms_add_smul, hts, hts']
    rfl
  -- a unit multiple of a local generator near `x`
  let Good : (∀ i, RationalPluriForms (N.n i ≫ sT) n m) → Prop := fun t =>
    ∃ (U : T.Opens) (_ : x ∈ U) (g : ∀ i, RationalPluriForms (N.n i ≫ sT) n m) (f : Γ(T, U)),
      IsUnit f ∧ IsAdjointGeneratorOn N n m Θ U g ∧ ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
        t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i
  -- adding a multiple of a section keeps a unit multiple of a generator, but for one scalar
  have hKL : ∀ t t', IsSec t → IsSec t' → Good t →
      Set.Subsingleton {c : ℂ | ¬ Good (t + c • t')} := by
    rintro t t' htS ht'S ⟨U, hxU, g, f, hf, hg, htf⟩
    obtain ⟨i, z, hz⟩ := exists_base_eq N x
    let := stalkAlgebra (N.n i ≫ sT) z
    let := functionFieldAlgebra (N.n i ≫ sT)
    have := isScalarTower_stalk_functionField (N.n i ≫ sT) z
    have hzU : z ∈ N.n i ⁻¹ᵁ U := show (N.n i).base z ∈ U from hz ▸ hxU
    haveI : Nonempty (N.n i ⁻¹ᵁ U) := ⟨⟨z, hzU⟩⟩
    set a := (N.X i).presheaf.germ (N.n i ⁻¹ᵁ U) z hzU ((N.n i).app U f) with ha_def
    have ha : IsUnit a := (hf.map ((N.n i).app U).hom).map _
    have hta : t i = algebraMap _ (N.X i).functionField a • g i := by
      rw [htf i inferInstance, ha_def, Scheme.algebraMap_germ_eq_germToFunctionField]
    -- `t'ᵢ = φ gᵢ` with `φ` regular at `z`
    obtain ⟨U', hxU', g', f', hg', ht'f⟩ := hsec t' ht'S x
    have hzU' : z ∈ N.n i ⁻¹ᵁ U' := show (N.n i).base z ∈ U' from hz ▸ hxU'
    haveI : Nonempty (N.n i ⁻¹ᵁ U') := ⟨⟨z, hzU'⟩⟩
    obtain ⟨u', -, hgu'⟩ :=
      exists_isUnit_smul_eq_of_generatesOn (hdim i) (hg.1 i) (hg'.1 i) hzU hzU'
    set φ := (N.X i).presheaf.germ (N.n i ⁻¹ᵁ U') z hzU' ((N.n i).app U' f') * u' with hφ_def
    have ht'φ : t' i = algebraMap _ (N.X i).functionField φ • g i := by
      rw [ht'f i inferInstance, hgu', ← Scheme.algebraMap_germ_eq_germToFunctionField _ hzU',
        smul_smul, ← map_mul]
    -- a bad scalar makes `a + c φ` vanish at `z`
    have hbad : ∀ c : ℂ, ¬ Good (t + c • t') →
        a + algebraMap ℂ _ c * φ ∈ IsLocalRing.maximalIdeal ((N.X i).presheaf.stalk z) := by
      intro c hc
      obtain ⟨U₁, hxU₁, g₁, f₁, hg₁, ht₁⟩ := hsec _ (hlin t t' htS ht'S c) x
      have hzU₁ : z ∈ N.n i ⁻¹ᵁ U₁ := show (N.n i).base z ∈ U₁ from hz ▸ hxU₁
      haveI : Nonempty (N.n i ⁻¹ᵁ U₁) := ⟨⟨z, hzU₁⟩⟩
      by_contra hmem
      apply hc
      obtain ⟨u₁, hu₁, hgu₁⟩ :=
        exists_isUnit_smul_eq_of_generatesOn (hdim i) (hg.1 i) (hg₁.1 i) hzU hzU₁
      set b₁ := (N.X i).presheaf.germ (N.n i ⁻¹ᵁ U₁) z hzU₁ ((N.n i).app U₁ f₁) with hb₁_def
      have heq : algebraMap _ (N.X i).functionField (b₁ * u₁) • g i =
          algebraMap _ (N.X i).functionField (a + algebraMap ℂ _ c * φ) • g i := by
        have h1 := ht₁ i inferInstance
        rw [Pi.add_apply, Pi.smul_apply, hta, ht'φ, hgu₁,
          ← Scheme.algebraMap_germ_eq_germToFunctionField _ hzU₁, smul_smul, ← map_mul] at h1
        rw [← h1, RationalPluriForms.smul_def, smul_smul, ← add_smul]
        congr 1
        simp only [hφ_def, map_mul, map_add, ← IsScalarTower.algebraMap_apply]
      have hb : b₁ * u₁ = a + algebraMap ℂ _ c * φ :=
        IsFractionRing.injective _ (N.X i).functionField (smul_left_injective _ (hg.1 i).1 heq)
      have hunit : IsUnit b₁ := by
        have : IsUnit (b₁ * u₁) := hb ▸ (IsLocalRing.notMem_maximalIdeal.mp hmem)
        exact isUnit_of_mul_isUnit_left this
      have hx1 : IsUnit (T.presheaf.germ U₁ x hxU₁ f₁) := by
        subst hz
        have hunit' : IsUnit (((N.n i).stalkMap z).hom
            (T.presheaf.germ U₁ ((N.n i).base z) hxU₁ f₁)) := by
          rw [Scheme.Hom.germ_stalkMap_apply]
          exact hunit
        exact isUnit_of_map_unit _ _ hunit'
      have hxB : x ∈ T.basicOpen f₁ := (T.mem_basicOpen f₁ x hxU₁).mpr hx1
      refine ⟨T.basicOpen f₁, hxB, g₁, f₁ |_ T.basicOpen f₁,
        RingedSpace.isUnit_res_basicOpen _ f₁, isAdjointGeneratorOn_mono hg₁ (T.basicOpen_le f₁), fun j hj => ?_⟩
      haveI : Nonempty (N.n j ⁻¹ᵁ U₁) :=
        ⟨⟨hj.some.1, T.basicOpen_le f₁ hj.some.2⟩⟩
      rw [germToFunctionField_app_res N j (T.basicOpen_le f₁) f₁]
      exact ht₁ j inferInstance
    intro c₁ hc₁ c₂ hc₂
    by_contra hne
    have h1 := hbad c₁ hc₁
    have h2 := hbad c₂ hc₂
    have hu : IsUnit (algebraMap ℂ ((N.X i).presheaf.stalk z) c₁ - algebraMap ℂ _ c₂) := by
      rw [← map_sub]
      exact (IsUnit.mk0 _ (sub_ne_zero.mpr hne)).map _
    have hφm : φ ∈ IsLocalRing.maximalIdeal ((N.X i).presheaf.stalk z) := by
      have hsub := sub_mem h1 h2
      rw [show a + algebraMap ℂ _ c₁ * φ - (a + algebraMap ℂ _ c₂ * φ) =
        (algebraMap ℂ _ c₁ - algebraMap ℂ _ c₂) * φ by ring] at hsub
      exact (Ideal.unit_mul_mem_iff_mem _ hu).mp hsub
    have : a ∈ IsLocalRing.maximalIdeal ((N.X i).presheaf.stalk z) := by
      have := sub_mem h1 (Ideal.mul_mem_left _ (algebraMap ℂ _ c₁) hφm)
      simpa using this
    exact (IsLocalRing.notMem_maximalIdeal.mpr ha) this
  -- every component carries a nonzero descended section
  have hne : ∀ i, ∃ t', IsSec t' ∧ t' i ≠ 0 := by
    intro i
    obtain ⟨z⟩ : Nonempty (N.X i) := inferInstance
    obtain ⟨s, hs, t', U, hzU, g, f, hf, hg, htf, htp⟩ := hdesc2 ((N.n i).base z)
    haveI : Nonempty (N.n i ⁻¹ᵁ U) := ⟨⟨z, hzU⟩⟩
    refine ⟨t', ⟨s, hs, htp⟩, ?_⟩
    rw [htf i inferInstance]
    exact smul_ne_zero
      ((hf.map ((N.n i).app U).hom).map ((N.X i).germToFunctionField _).hom).ne_zero (hg.1 i).1
  -- the induction over the components
  have key : ∀ A : Finset N.ι, ∃ t, IsSec t ∧ Good t ∧ ∀ i ∈ A, t i ≠ 0 := by
    intro A
    induction A using Finset.induction_on with
    | empty =>
      obtain ⟨s, hs, t, U, hxU, g, f, hf, hg, htf, htp⟩ := hdesc2 x
      exact ⟨t, ⟨s, hs, htp⟩, ⟨U, hxU, g, f, hf, hg, htf⟩, by simp⟩
    | insert i A hiA ih =>
      obtain ⟨t, htS, htG, hA⟩ := ih
      by_cases hti : t i = 0
      · obtain ⟨t', ht'S, ht'i⟩ := hne i
        have hfin : ({c : ℂ | ¬ Good (t + c • t')} ∪ {0} ∪
            ⋃ j ∈ A, {c : ℂ | t j + c • t' j = 0}).Finite := by
          refine ((hKL t t' htS ht'S htG).finite.union (Set.finite_singleton 0)).union
            (Set.Finite.biUnion A.finite_toSet fun j hj => Set.Subsingleton.finite ?_)
          intro c₁ hc₁ c₂ hc₂
          by_contra hne'
          have h := congrArg₂ (· - ·) (show t j + c₁ • t' j = 0 from hc₁)
            (show t j + c₂ • t' j = 0 from hc₂)
          simp only [add_sub_add_left_eq_sub, sub_self, ← sub_smul] at h
          rw [RationalPluriForms.smul_def, smul_eq_zero] at h
          rcases h with h | h
          · exact hne' (sub_eq_zero.mp ((map_eq_zero _).mp h))
          · exact hA j hj (by simpa [h] using hc₁)
        obtain ⟨c, hc⟩ := hfin.infinite_compl.nonempty
        simp only [Set.mem_compl_iff, Set.mem_union, Set.mem_setOf_eq, Set.mem_singleton_iff,
          Set.mem_iUnion, not_or, not_exists, not_not] at hc
        obtain ⟨⟨hcG, hc0⟩, hcA⟩ := hc
        refine ⟨t + c • t', hlin t t' htS ht'S c, hcG, ?_⟩
        intro j hj
        rcases Finset.mem_insert.mp hj with rfl | hj
        · rw [Pi.add_apply, Pi.smul_apply, hti, zero_add, RationalPluriForms.smul_def]
          exact smul_ne_zero ((map_ne_zero _).mpr hc0) ht'i
        · exact hcA j hj
      · exact ⟨t, htS, htG, fun j hj => by
          rcases Finset.mem_insert.mp hj with rfl | hj
          · exact hti
          · exact hA j hj⟩
  haveI := Fintype.ofFinite N.ι
  obtain ⟨t, htS, ⟨U, hxU, g, f, hf, hg, htf⟩, hA⟩ := key Finset.univ
  exact ⟨t, hsec t htS, U, hxU,
    isAdjointGeneratorOn_of_isUnit hdim hf hg htf fun i => hA i (Finset.mem_univ i)⟩

private theorem solution
    {T : Scheme.{0}} {sT : T ⟶ Spec (.of ℂ)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : NormalizationComponents sT hT} {Δ : QWeilDivisor T}
    {Θ : ∀ i, QDivisor (N.X i)} (h : IsSdltAdjointPair N 3 Δ Θ)
    (hsemi : ∀ i, ∃ K : Divisor (N.X i), K.IsCanonicalDivisor (N.n i ≫ sT) 3 ∧
      QDivisor.IsRelativelySemiample (N.n i ≫ sT) (Divisor.toQDivisor K + Θ i)) :
    ∃ m : ℕ, 0 < m ∧ (∀ Γ, ((m : ℚ) * Δ Γ).den = 1) ∧
      ∀ x : T, ∃ t : ∀ i, RationalPluriForms (N.n i ≫ sT) 3 m,
        (∀ y : T, ∃ (U : T.Opens) (_ : y ∈ U) (g : ∀ i, RationalPluriForms (N.n i ≫ sT) 3 m)
          (f : Γ(T, U)), IsAdjointGeneratorOn N 3 m Θ U g ∧
            ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
              t i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) • g i) ∧
        ∃ (U : T.Opens) (_ : x ∈ U), IsAdjointGeneratorOn N 3 m Θ U t := by
  classical
  haveI : Finite N.ι := finite_ι h
  -- crepant `ℚ`-factorial dlt models `(Yᵢ, Cᵢ)`
  have hmod := fun i => exists_crepantModel (isProjectiveVariety_and_dim h i).1
    (isProjectiveVariety_and_dim h i).2 (h.exists_isDltPair i) (hsemi i)
  choose Y hYi hYl hYn p hpd C hproj hcrep hYproj hYdim hYQ hYpair hYdlt KY hKY hYsemi
    using hmod
  haveI := hYi; haveI := hYl; haveI := hYn; haveI := hpd
  -- the floor components of all the `Yᵢ`
  let J := Σ i, {P : Mori.PrimeDivisor (Y i) // ⌊(C i).coeff P⌋ ≠ 0}
  haveI : ∀ i, Finite {P : Mori.PrimeDivisor (Y i) // ⌊(C i).coeff P⌋ ≠ 0} := fun i =>
    Set.Finite.to_subtype ((C i).support.finite_toSet.subset fun P hP => by
      rw [Finset.mem_coe, Finsupp.mem_support_iff]
      intro h0
      exact hP (by rw [DivisorWithCoeffs.coeff_apply, h0, Int.floor_zero]))
  haveI : Finite J := inferInstance
  have hfl := fun j : J => exists_floorModel (hYproj j.1) (hYdim j.1) (hYQ j.1) (hYpair j.1)
    (hYdlt j.1) (hKY j.1) (hYsemi j.1) j.2.1 j.2.2
  choose Sf hSi hSc hSl hSn jf BSf hSf hSproj hSdim hSQ hSpair hSdlt KS hKS hSsemi using hfl
  haveI := hSi; haveI := hSc; haveI := hSl; haveI := hSn
  -- admissible generation on the floors
  obtain ⟨ms, hms, hsurf⟩ := exists_generatesOn_of_mem_admissibleSections hSproj hSdim hSQ hSpair
    hSdlt hKS hSsemi
  -- lifting through the floors
  obtain ⟨m3, hm3, hlift⟩ := exists_generatesOn_and_isPoincareResidue_pow_of_mem_admissibleSections
    (sX := fun i => p i ≫ N.n i ≫ sT) hYproj hYdim hYQ hYpair hYdlt hKY hYsemi Sf jf BSf hSf
  -- local generators of `𝒪_T(m₁L)`
  obtain ⟨m₁, hm₁, hm₁Δ, hgen₁⟩ := h.exists_isAdjointGeneratorOn
  -- the common even degree `M`, with residue restriction data on the floors
  set M := 2 * (ms * m3 * m₁) with hM
  have hM0 : 0 < M := by positivity
  have hMev : Even M := even_two_mul _
  obtain ⟨⟨Rf⟩, hlift⟩ := hlift M hM0 (Dvd.intro (2 * ms * m₁) (by rw [hM]; ring))
  have hgenf := hsurf M (Dvd.intro (2 * m3 * m₁) (by rw [hM]; ring)) hMev Rf
  -- preadmissible generation on the threefold models in degree `q * M`
  obtain ⟨q, hq, ⟨R⟩, hR⟩ := hlift Rf hgenf ∅ (by simp)
  have hqM0 : 0 < q * M := Nat.mul_pos hq hM0
  have hm : m₁ ∣ q * M := Dvd.intro (q * 2 * ms * m3) (by rw [hM]; ring)
  have hdesc := h.existsUnique_pullback_eq_of_mem_preadmissibleSections p hproj hcrep R
    (exists_generator_of_dvd (fun i => (isProjectiveVariety_and_dim h i).2) hgen₁ hm hqM0)
  refine ⟨q * M, hqM0, fun Γ => ?_, fun x => ?_⟩
  · obtain ⟨c, hc⟩ := hm
    rw [hc, Nat.cast_mul, mul_comm (m₁ : ℚ), mul_assoc,
      ← Rat.coe_int_num_of_den_eq_one (hm₁Δ Γ)]
    exact_mod_cast Rat.den_intCast ((c : ℤ) * (↑m₁ * Δ Γ).num)
  · exact exists_isAdjointGeneratorOn_of_descent p hproj hcrep
      (fun i => (isProjectiveVariety_and_dim h i).2) R
      (fun s hs => by
        obtain ⟨⟨t, ⟨ht, htp⟩, -⟩, -⟩ := hdesc.1 s hs
        exact ⟨t, fun y => by
          obtain ⟨U, hyU, g, f, ⟨hg, -⟩, htf⟩ := ht y
          exact ⟨U, hyU, g, f, hg, htf⟩, htp⟩)
      (fun y => by
        obtain ⟨s, hs, t, U, hyU, g, f, hfu, ⟨hg, -⟩, htf, htp⟩ := hdesc.2 (hR R).1 y
        exact ⟨s, hs, t, U, hyU, g, f, hfu, hg, htf, htp⟩) x

end

end Proof_thm_fourfold_projective_sdlt_threefold_normalized_generation

