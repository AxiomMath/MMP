    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  obtain ⟨-, -, -, -, -, -, -, -, hC1, -⟩ := hcurveQ
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmY
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  have hKBX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmX
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  haveI : IsNoetherian (CY Q) := {}
  haveI : IsNoetherian X := {}
  set vb : TZ.functionField := resZ v with hvb
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  set ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
      (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] with hωv
  set θv : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωv 1 with hθv
  set Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 + 1)
    ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
      (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
        (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
        (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
          (![z 0, z 1, v] a))) 1) with hΩv
  -- the normalized strict transform `N` of `Q`, and `H = π_N^*(div(dlog v̄) + B_Z)`
  obtain ⟨W, N, _, _, _, _, _, pW, qW, νN, αN, _, _, _, _, hαb, hNα, hα, hcompat, hqν, hpν,
