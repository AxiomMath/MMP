  have hθG : IsPoincareResidue (jY Q ≫ sY) j 1 1 θs ρG := by rw [hθs1]; exact hresG
  -- adjunction along `G`
  haveI : IsNormal G := hj'.1.2
  haveI : LocallyOfFiniteType (j ≫ jY Q ≫ sY) := hj'.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ jY Q ≫ sY)
  haveI : CompactSpace G := QuasiCompact.compactSpace_of_compactSpace j
  haveI : IsNoetherian G := {}
  obtain ⟨hgenG, hpbG⟩ := hj'.isPullback_divisorOfForm_add_of_isPoincareResidue (n := 1)
    (by exact_mod_cast hdT) Γ hrΓ θs hρs0 hordΓ ρG hθG hqT
  have hρG0 : ρG ≠ 0 := by
    intro h0
    have h1 := (CrepantModelAux.isPoincareResidue_eq_zero_iff (M := 0) (jY Q ≫ sY) hT hdT
