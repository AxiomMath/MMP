  obtain ⟨tG, htG⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Γ hΓ
    (f := tA) ((Γ.divisorialValuation_le_one_iff _).2 ⟨tΓ, rfl⟩)
  obtain ⟨u', hu'⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Γ hΓ
