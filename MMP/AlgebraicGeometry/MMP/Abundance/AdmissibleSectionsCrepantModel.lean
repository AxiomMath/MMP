  have hub0 : ub ≠ 0 := (hu'u.map (j.stalkMap (genericPoint G)).hom).ne_zero
  have hψG : ∀ E : Mori.PrimeDivisor G, (E.ordForm ρG : ℚ) + BG.coeff E = 0 := by
    intro E
