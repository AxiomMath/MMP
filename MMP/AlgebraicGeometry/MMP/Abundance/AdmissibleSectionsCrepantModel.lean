    intro a
    rw [hsU, valuation_prod_zpow_eq v zU (fun i => (α i : ℤ)) (fun i => hzv i), ← hMα, hαvec]
    rfl
  have hs0 : v (sU 0 : X.functionField) = WithZero.exp (-1) := by rw [hsv]; rfl
  have hs1 : ∀ a, a ≠ 0 → v (sU a : X.functionField) = 1 := by
    intro a ha
