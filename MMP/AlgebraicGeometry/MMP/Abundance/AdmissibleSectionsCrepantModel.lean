  have htP := hτres P hPU
  rw [hg] at htP
  have hρPex := hres12 g m
  obtain ⟨ρP, hρP1, hρP2⟩ := hρPex
  have htPρ := IsPoincareResidue.unique (St.hjX P).1 htP hρP1
  rw [← htPρ] at hρP2
