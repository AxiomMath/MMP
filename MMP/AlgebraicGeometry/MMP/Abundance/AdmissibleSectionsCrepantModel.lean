  haveI : IsNormal CN' := hCNv'.2
  have hαν : αN (νC (genericPoint CN')) = j (genericPoint G) := by rw [hνCη, hCN, hΓ]
  obtain ⟨β, hβ⟩ := CrepantModelAux.exists_comp_eq_of_range_subset j (νC ≫ αN)
    (CrepantModelAux.range_comp_subset_of_map_genericPoint νC αN j Γ hrΓ (by rw [hνCη, hCN]))
  have hβη : β (genericPoint CN') = genericPoint G := j.isClosedEmbedding.injective (by
    rw [← Scheme.Hom.comp_apply, hβ, Scheme.Hom.comp_apply, hαν])
  haveI : IsDominant β := ⟨Dense.mono (s₁ := {genericPoint G})
    (Set.singleton_subset_iff.mpr ⟨_, hβη⟩) (dense_iff_closure_eq.mpr (genericPoint_spec G))⟩
  have hαiso : IsIso (αN.stalkMap (νC (genericPoint CN'))) := by rw [hνCη]; exact hCNiso
  have hβs := CrepantModelAux.surjective_functionFieldMap_of_lift αN j νC β hβ hαν hαiso hνCsurj
  haveI : IsProper β := by
