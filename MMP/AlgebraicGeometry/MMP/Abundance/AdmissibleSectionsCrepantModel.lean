  have hsN' : β ≫ j ≫ jY Q ≫ sY = νC ≫ αN ≫ jY Q ≫ sY := by
    rw [← Category.assoc, hβ, Category.assoc]
  have hNβ : IsNormalVariety ℂ (β ≫ j ≫ jY Q ≫ sY) := hsN' ▸ hCNv'
  haveI : LocallyOfFiniteType (β ≫ j ≫ jY Q ≫ sY) := hNβ.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian CN' := LocallyOfFiniteType.isLocallyNoetherian (β ≫ j ≫ jY Q ≫ sY)
