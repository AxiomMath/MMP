/-! ### Flags of floor components as flags of the ambient pair -/

section FlagComp

variable {k : Type} [Field k] {Y C : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y]
  [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral C] [IsLocallyNoetherian C] [IsNormal C]
  {BY : QDivisor Y} {j : C ⟶ Y} {BC : QDivisor C}

end FlagComp

/-! ### The setting, floor sections and the pin relation -/

/-- The hypotheses of the theorem on the two pairs `(X, B)`, `(Y, C)` and the common model `W`.
The statement is symmetric in `X` and `Y`; see `Setting.swap`. -/
private structure Setting {X Y W : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (sX : X ⟶ Spec (.of ℂ)) (sY : Y ⟶ Spec (.of ℂ)) (n : ℕ) (B : QDivisor X) (C : QDivisor Y)
    (KX : Divisor X) (KY : Divisor Y)
    (p : W ⟶ X) (q : W ⟶ Y) [IsDominant p] [IsDominant q] [IsProper p] [IsProper q]
    (BW : QDivisor W) (m : ℕ)
    (CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    (jX : ∀ P, CX P ⟶ X) (BX : ∀ P, QDivisor (CX P))
    (CY : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0} → Scheme.{0})
    [∀ Q, IsIntegral (CY Q)] [∀ Q, IsLocallyNoetherian (CY Q)] [∀ Q, IsNormal (CY Q)]
    (jY : ∀ Q, CY Q ⟶ Y) (BY : ∀ Q, QDivisor (CY Q)) : Prop where
  hn : n + 1 ≤ 3
  hXp : Mori.IsProjectiveVariety ℂ sX
  hYp : Mori.IsProjectiveVariety ℂ sY
  hdimX : topologicalKrullDim X = (n + 1 : ℕ)
  hdimY : topologicalKrullDim Y = (n + 1 : ℕ)
  hQX : IsQFactorial sX
  hQY : IsQFactorial sY
  hBp : IsPair sX B
  hCp : IsPair sY C
  hB : MMP.Intersection.IsDltPair sX B ∨
    (MMP.Intersection.IsLogCanonicalPair sX B ∧
      ∃ δ : ℚ, 0 < δ ∧ IsKltPair sX (B - δ • Divisor.toQDivisor B.roundDown))
  hC : MMP.Intersection.IsDltPair sY C ∨
    (MMP.Intersection.IsLogCanonicalPair sY C ∧
      ∃ δ : ℚ, 0 < δ ∧ IsKltPair sY (C - δ • Divisor.toQDivisor C.roundDown))
  hKX : KX.IsCanonicalDivisor sX (n + 1)
  hKY : KY.IsCanonicalDivisor sY (n + 1)
  hpq : p ≫ sX = q ≫ sY
  hpb : IsBirationalMorphism p
  hqb : IsBirationalMorphism q
  hWX : IsNormalVariety ℂ (p ≫ sX)
  hWY : IsNormalVariety ℂ (q ≫ sY)
  hBWX : IsCrepantBoundary sX (n + 1) KX B p hWX hpb BW
  hBWY : IsCrepantBoundary sY (n + 1) KY C q hWY hqb BW
  hm : Even m
  hm0 : 0 < m
  hmX : ((m : ℤ) • (Divisor.toQDivisor KX + B)).IsCartierDivisor
  hmY : ((m : ℤ) • (Divisor.toQDivisor KY + C)).IsCartierDivisor
  hjX : ∀ P, IsAdjunctionStep sX B (jX P) (BX P) ∧ Set.range (jX P).base = (P.1.support : Set X)
  hjY : ∀ Q, IsAdjunctionStep sY C (jY Q) (BY Q) ∧ Set.range (jY Q).base = (Q.1.support : Set Y)

/-- A family `t_P ∈ H⁰(C_P, m(K_{C_P} + B_{C_P}))` on the normal floor components is a *floor
section* if near every point it is the family of Poincaré residues of a local section of
`𝒪_X(mK_X + ⌊mB⌋)`. -/
private def IsFloorSection {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) (n m : ℕ) (B : QDivisor X)
    {CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    (jX : ∀ P, CX P ⟶ X) (BX : ∀ P, QDivisor (CX P))
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) : Prop :=
  ∀ x : X, ∃ (U : X.Opens) (_ : x ∈ U) (τ : RationalPluriForms sX (n + 1) m),
    τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
    ∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
      IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)

/-- `τ` presents the family `t` on `U`. -/
private def Presents {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) (n m : ℕ) (B : QDivisor X)
    {CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    (jX : ∀ P, CX P ⟶ X) (BX : ∀ P, QDivisor (CX P))
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) (U : X.Opens)
    (τ : RationalPluriForms sX (n + 1) m) : Prop :=
  τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
    ∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
      IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)

/-- The pin relation between families on `X` and on `Y`: for local presentations `τ` of `t` and
`τ'` of `t'`, the pull-backs `p^*τ` and `q^*τ'` have the same Poincaré residue along every
coefficient-one prime divisor of `B_W` lying over both opens. -/
private def Pins {X Y W : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (sX : X ⟶ Spec (.of ℂ)) (sY : Y ⟶ Spec (.of ℂ)) (n : ℕ) (B : QDivisor X) (C : QDivisor Y)
    (p : W ⟶ X) (q : W ⟶ Y) [IsDominant p] [IsDominant q] (hpq : p ≫ sX = q ≫ sY)
    (BW : QDivisor W) (m : ℕ)
    {CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    (jX : ∀ P, CX P ⟶ X) (BX : ∀ P, QDivisor (CX P))
    {CY : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0} → Scheme.{0}}
    [∀ Q, IsIntegral (CY Q)] [∀ Q, IsLocallyNoetherian (CY Q)] [∀ Q, IsNormal (CY Q)]
    (jY : ∀ Q, CY Q ⟶ Y) (BY : ∀ Q, QDivisor (CY Q))
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P))
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)) : Prop :=
  ∀ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m), Presents sX n m B jX BX t U τ →
  ∀ (U' : Y.Opens) (τ' : RationalPluriForms sY (n + 1) m), Presents sY n m C jY BY t' U' τ' →
  ∀ (E : Mori.PrimeDivisor W), BW.coeff E = 1 →
  ∀ {E' : Scheme.{0}} [IsIntegral E'] (jE : E' ⟶ W), IsClosedImmersion jE →
    Set.range jE.base = (E.support : Set W) →
    p.base (jE.base (genericPoint E')) ∈ U → q.base (jE.base (genericPoint E')) ∈ U' →
    ∃ ρ : RationalPluriForms (jE ≫ p ≫ sX) n m,
      IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ) ρ ∧
      IsPoincareResidue (q ≫ sY) jE n m (pullbackRationalPluriForms sY q τ')
        (cast (by rw [hpq]) ρ)

section Steps

variable {X Y W : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {n : ℕ} {B : QDivisor X} {C : QDivisor Y}
    {KX : Divisor X} {KY : Divisor Y}
    {p : W ⟶ X} {q : W ⟶ Y} [IsDominant p] [IsDominant q] [IsProper p] [IsProper q]
    {BW : QDivisor W} {m : ℕ}
    {CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    {jX : ∀ P, CX P ⟶ X} {BX : ∀ P, QDivisor (CX P)}
    {CY : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0} → Scheme.{0}}
    [∀ Q, IsIntegral (CY Q)] [∀ Q, IsLocallyNoetherian (CY Q)] [∀ Q, IsNormal (CY Q)]
    {jY : ∀ Q, CY Q ⟶ Y} {BY : ∀ Q, QDivisor (CY Q)}

/-- The setting is symmetric in the two pairs. -/
private theorem Setting.swap
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    Setting sY sX n C B KY KX q p BW m CY jY BY CX jX BX where
  hn := S.hn
  hXp := S.hYp
  hYp := S.hXp
  hdimX := S.hdimY
  hdimY := S.hdimX
  hQX := S.hQY
  hQY := S.hQX
  hBp := S.hCp
  hCp := S.hBp
  hB := S.hC
  hC := S.hB
  hKX := S.hKY
  hKY := S.hKX
  hpq := S.hpq.symm
  hpb := S.hqb
  hqb := S.hpb
  hWX := S.hWY
  hWY := S.hWX
  hBWX := S.hBWY
  hBWY := S.hBWX
  hm := S.hm
  hm0 := S.hm0
  hmX := S.hmY
  hmY := S.hmX
  hjX := S.hjY
  hjY := S.hjX

/-- The pin relation is symmetric. -/
private theorem Pins.swap {hpq : p ≫ sX = q ≫ sY}
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (h : Pins sX sY n B C p q hpq BW m jX BX jY BY t t') :
    Pins sY sX n C B q p hpq.symm BW m jY BY jX BX t' t := by
  intro U' τ' hτ' U τ hτ E hE E' _ jE hjE hrange hU' hU
  obtain ⟨ρ, h₁, h₂⟩ := h U τ hτ U' τ' hτ' E hE jE hjE hrange hU hU'
  refine ⟨cast (by rw [hpq]) ρ, h₂, ?_⟩
  rwa [cast_cast, cast_eq]

/-! ### The steps of the proof -/

/-- Floor sections form a subspace. -/
private theorem isFloorSection_zero (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    IsFloorSection sX n m B jX BX 0 := by
  haveI := S.hXp.toLocallyOfFiniteType
  intro x
  refine ⟨⊤, trivial, 0, zero_mem _, fun P _ => ?_⟩
  obtain ⟨P', hP', _⟩ := (S.hjX P).1.exists_primeDivisor
  rw [Pi.zero_apply, Submodule.coe_zero]
  exact isPoincareResidue_zero_of_isClosedImmersion P' hP'

private theorem Presents.add (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t₁ t₂ : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U₁ U₂ : X.Opens}
    {τ₁ τ₂ : RationalPluriForms sX (n + 1) m} (h₁ : Presents sX n m B jX BX t₁ U₁ τ₁)
    (h₂ : Presents sX n m B jX BX t₂ U₂ τ₂) (hne : U₁ ⊓ U₂ ≠ ⊥) :
    Presents sX n m B jX BX (t₁ + t₂) (U₁ ⊓ U₂) (τ₁ + τ₂) := by
  haveI := S.hXp.toLocallyOfFiniteType
  refine ⟨add_mem (mem_pluricanonicalSections_of_le h₁.1 inf_le_left hne)
      (mem_pluricanonicalSections_of_le h₂.1 inf_le_right hne), fun P hP => ?_⟩
  obtain ⟨P', hP', _⟩ := (S.hjX P).1.exists_primeDivisor
  rw [Pi.add_apply, Submodule.coe_add]
  exact IsPoincareResidue.add_of_isClosedImmersion P' hP' (by exact_mod_cast S.hdimX)
    (h₁.2 P hP.1) (h₂.2 P hP.2)

private theorem Presents.smul (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (c : ℂ) {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U : X.Opens}
    {τ : RationalPluriForms sX (n + 1) m} (h : Presents sX n m B jX BX t U τ) :
    Presents sX n m B jX BX (c • t) U (c • τ) := by
  refine ⟨smul_mem_pluricanonicalSections h.1 c, fun P hP => ?_⟩
  haveI := (S.hjX P).1.exists_primeDivisor.choose_spec.2
  rw [Pi.smul_apply, Submodule.coe_smul]
  exact IsPoincareResidue.const_smul (h.2 P hP) c

/-- Two presentations of the same family differ by a presentation of zero. -/
private theorem Presents.sub (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U₁ U₂ : X.Opens}
    {τ₁ τ₂ : RationalPluriForms sX (n + 1) m} (h₁ : Presents sX n m B jX BX t U₁ τ₁)
    (h₂ : Presents sX n m B jX BX t U₂ τ₂) (hne : U₁ ⊓ U₂ ≠ ⊥) :
    Presents sX n m B jX BX 0 (U₁ ⊓ U₂) (τ₂ - τ₁) := by
  have h := Presents.add S (Presents.smul S (-1) h₁) h₂ hne
  rw [neg_one_smul, neg_one_smul, neg_add_cancel, neg_add_eq_sub] at h
  rwa [inf_comm] at h ⊢

private theorem IsFloorSection.add (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t₁ t₂ : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (h₁ : IsFloorSection sX n m B jX BX t₁) (h₂ : IsFloorSection sX n m B jX BX t₂) :
    IsFloorSection sX n m B jX BX (t₁ + t₂) := by
  intro x
  obtain ⟨U₁, hx₁, τ₁, hτ₁⟩ := h₁ x
  obtain ⟨U₂, hx₂, τ₂, hτ₂⟩ := h₂ x
  have hne : U₁ ⊓ U₂ ≠ ⊥ := fun h => by
    have : x ∈ U₁ ⊓ U₂ := ⟨hx₁, hx₂⟩
    rw [h] at this
    exact this
  exact ⟨U₁ ⊓ U₂, ⟨hx₁, hx₂⟩, τ₁ + τ₂, Presents.add S hτ₁ hτ₂ hne⟩

private theorem IsFloorSection.smul (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (c : ℂ) {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (h : IsFloorSection sX n m B jX BX t) : IsFloorSection sX n m B jX BX (c • t) := by
  intro x
  obtain ⟨U, hx, τ, hτ⟩ := h x
  exact ⟨U, hx, c • τ, Presents.smul S c hτ⟩

/-- **The centre of a coefficient-one divisor lies on the floor, klt case.** If the
floor-lowering pair `(X, B - δ⌊B⌋)` is klt, then the centre of a divisor `E` of log discrepancy
zero lies on `⌊B⌋`: off `⌊B⌋` the two boundaries agree, so `E` would have log discrepancy zero
for the klt pair. -/
private theorem exists_floor_mem_of_isKltPair
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) {δ : ℚ}
    (hklt : IsKltPair sX (B - δ • Divisor.toQDivisor B.roundDown)) :
    ∃ P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}, p E.genericPoint ∈ P.1.support := by
  classical
  by_contra hno
  push Not at hno
  haveI := S.hXp.toLocallyOfFiniteType
  obtain ⟨⟨-, -, hpair', -⟩, hpos⟩ := hklt
  obtain ⟨-, n', K', hK', hQC⟩ := hpair'
  obtain ⟨m', hm', hm'C⟩ := hQC.exists_pos
  have hn' : n' = n + 1 := by
    have h := hK'.topologicalKrullDim_eq
    rw [S.hdimX] at h
    exact_mod_cast h.symm
  subst hn'
  let D : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, E⟩
  have hD := S.hBWX E
  rw [hE] at hD
  obtain ⟨hXn, -, m₁, hm₁, -, U₁, hU₁, ω₁, hω₁, hω₁a⟩ := hD
  let := functionFieldAlgebra sX
  obtain ⟨b, N, hN⟩ := D.exists_ordPullback_eq hXn S.hdimX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) S.hdimX
  set c₁ := (ZTensorPower.basis b (m₁ : ℤ)).repr ω₁ () with hc₁_def
  have hc₁ : c₁ ≠ 0 := repr_ne_zero_of_ne_zero b hω₁.1
  set M : ℕ := m₁ * m' with hM
  set τ : RationalPluriForms sX (n + 1) M := c₁ ^ m' • formPow (b ()) M with hτdef
  have hrepr : (ZTensorPower.basis b (M : ℤ)).repr τ () = c₁ ^ m' := repr_smul_formPow b M _
  have hτ0 : τ ≠ 0 := by
    have h1 : (formPow (b ()) M : PluriForms ℂ X.functionField (n + 1) M) ≠ 0 := by
      rw [← ZTensorPower.basis_natCast]; exact Module.Basis.ne_zero _ _
    exact smul_ne_zero (M := PluriForms ℂ X.functionField (n + 1) M) (pow_ne_zero _ hc₁) h1
  -- the open set off the floor
  let F : Set X := ⋃ P ∈ (B.support.filter fun P => ⌊B.coeff P⌋ ≠ 0), (P.support : Set X)
  have hF : IsClosed F := (Finset.finite_toSet _).isClosed_biUnion fun P _ => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  let U₂ : X.Opens := U₁ ⊓ ⟨Fᶜ, hF.isOpen_compl⟩
  have hzU₂ : p E.genericPoint ∈ U₂ := by
    refine ⟨hU₁, fun hzF => ?_⟩
    simp only [F, Set.mem_iUnion] at hzF
    obtain ⟨P, hP, hzP⟩ := hzF
    exact hno ⟨P, (Finset.mem_filter.mp hP).2⟩ hzP
  have hfloor0 : ∀ Γ : Mori.PrimeDivisor X, (Γ.support ∩ U₂).Nonempty → ⌊B.coeff Γ⌋ = 0 := by
    intro Γ ⟨x, hxΓ, _, hxF⟩
    by_contra hΓ
    apply hxF
    simp only [F, Set.mem_iUnion]
    refine ⟨Γ, Finset.mem_filter.mpr ⟨?_, hΓ⟩, hxΓ⟩
    rw [Finsupp.mem_support_iff]
    intro h0
    exact hΓ (by change ⌊B.coeff Γ⌋ = 0; rw [show B.coeff Γ = 0 from h0, Int.floor_zero])
  -- the discrepancy of `E` for the floor-lowering pair is `-1`
  have hdisc : IsDiscrepancy sX (n + 1) K' (B - δ • Divisor.toQDivisor B.roundDown) D (-1) := by
    refine ⟨hXn, hK', M, Nat.mul_pos hm₁ hm', ?_, U₂, hzU₂, τ, ⟨hτ0, fun Γ hΓ => ?_⟩, ?_⟩
    · obtain ⟨D'', hD'', hD''C⟩ := hm'C
      refine ⟨(m₁ : ℤ) • D'', ?_, hD''C.zsmul _⟩
      rw [map_zsmul, hD'', smul_smul]
      push_cast
      rfl
    · obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
      have e2 := hω₁.2 Γ (hΓ.mono (Set.inter_subset_inter_right _ inf_le_left))
      have f1 : (Γ.ordForm τ : ℚ) = (X.ord (c₁ ^ m') Γ.genericPoint : ℚ) + M * NΓ := by
        have := hNΓ M τ hτ0
        rw [hrepr] at this
        exact_mod_cast this
      have f2 : (Γ.ordForm ω₁ : ℚ) = (X.ord c₁ Γ.genericPoint : ℚ) + m₁ * NΓ := by
        exact_mod_cast hNΓ m₁ ω₁ hω₁.1
      have hpow : (X.ord (c₁ ^ m') Γ.genericPoint : ℚ) = m' * X.ord c₁ Γ.genericPoint := by
        rw [← zpow_natCast, ord_zpow _ hc₁]
        push_cast
        ring
      have hcoeff : (B - δ • Divisor.toQDivisor B.roundDown).coeff Γ = B.coeff Γ := by
        rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul,
          Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_roundDown, hfloor0 Γ hΓ]
        simp
      rw [hcoeff, f1, hpow, hM]
      push_cast
      linear_combination (m' : ℚ) * e2 - (m' : ℚ) * f2
    · have h1 := hN M τ hτ0
      rw [hrepr, map_pow, ← zpow_natCast, ord_zpow _ ((map_ne_zero _).mpr hc₁)] at h1
      have h2 := hN m₁ ω₁ hω₁.1
      have h1' : (D.ordPullback τ : ℚ) = m' * (D.Y.ord (functionFieldMap D.f c₁)
          D.E.genericPoint : ℚ) + M * N := by exact_mod_cast h1
      have h2' : (D.ordPullback ω₁ : ℚ) = (D.Y.ord (functionFieldMap D.f c₁)
          D.E.genericPoint : ℚ) + m₁ * N := by exact_mod_cast h2
      rw [h1', hM]
      push_cast
      have := hω₁a
      push_cast at this
      linear_combination (m' : ℚ) * this + (m' : ℚ) * h2'
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hdisc
    (show IsProper D.f from inferInstanceAs (IsProper p))
  have := hpos _ _ _ hlog
  norm_num at this

/-- **The centre of a coefficient-one divisor lies on the floor, dlt case.** A `ℚ`-factorial
dlt pair `(X, B)` has klt floor-lowering pair `(X, B - ½⌊B⌋)`, so this is the klt case. -/
private theorem exists_floor_mem_of_isDltPair
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdlt : MMP.Intersection.IsDltPair sX B) (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) :
    ∃ P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}, p E.genericPoint ∈ P.1.support := by
  have hcoeff : ∀ P, (B - (1 / 2 : ℚ) • Divisor.toQDivisor (DivisorWithCoeffs.roundDown B)) P =
      B P - (1 / 2 : ℚ) * ⌊B P⌋ := fun P => by simp [← DivisorWithCoeffs.coeff_apply]
  have hmem : ∀ P, 0 ≤ B P - (1 / 2 : ℚ) * ⌊B P⌋ ∧ B P - (1 / 2 : ℚ) * ⌊B P⌋ ≤ B P ∧
      B P - (1 / 2 : ℚ) * ⌊B P⌋ < 1 := fun P => by
    have h0 : 0 ≤ B P := hdlt.1.2.1 P
    have h1 : B P ≤ 1 := hdlt.2.1 P
    rcases h1.lt_or_eq with h1 | h1
    · simp [Int.floor_eq_zero_iff.mpr ⟨h0, h1⟩, h0, h1]
    · rw [h1]
      norm_num
  have hdlt' := MMP.Intersection.IsDltPair.of_le sX hdlt
    (Δ' := B - (1 / 2 : ℚ) • Divisor.toQDivisor (DivisorWithCoeffs.roundDown B))
    (fun P => by rw [Finsupp.coe_zero, Pi.zero_apply, hcoeff]; exact (hmem P).1)
    (fun P => by rw [hcoeff]; exact (hmem P).2.1)
    (MMP.Fourfold.isQCartier_of_isQFactorial sX S.hQX _)
  have hklt := MMP.Intersection.IsDltPair.isKltPair_of_forall_coeff_lt_one hdlt'
    (fun P => by rw [DivisorWithCoeffs.coeff_apply, hcoeff]; exact (hmem P).2.2)
  exact exists_floor_mem_of_isKltPair S E hE hklt

/-- **The centre of a coefficient-one divisor lies on the floor.** If `E` has coefficient one in
the crepant boundary `B_W` (log discrepancy zero), then `p(η_E)` lies on a component of `⌊B⌋`. -/
private theorem exists_floor_mem_of_coeff_eq_one
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) :
    ∃ P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}, p E.genericPoint ∈ P.1.support := by
  rcases S.hB with hdlt | ⟨-, δ, -, hklt⟩
  · exact exists_floor_mem_of_isDltPair S hdlt E hE
  · exact exists_floor_mem_of_isKltPair S E hE hklt

/-- **The order estimate along a coefficient-one divisor.** Let `τ` be a local section of
`𝒪_X(mK_X + ⌊mB⌋)` near `z = p(η_E)`, of order at least `1 - m` along a floor component through
`z`. Then `p^*τ` has order at least `1 - m` along `E`. -/
private theorem le_ordForm_pullback_of_coeff_eq_one
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) {U : X.Opens}
    {τ : RationalPluriForms sX (n + 1) m}
    (hτ : τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U)
    (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) (hU : p E.genericPoint ∈ U)
    (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (hPz : p E.genericPoint ∈ P.1.support)
    (hP : 1 - (m : ℤ) ≤ P.1.ordForm τ) :
    1 - (m : ℤ) ≤ E.ordForm (pullbackRationalPluriForms sX p τ) := by
  haveI := S.hXp.toLocallyOfFiniteType
  have hm0 := S.hm0
  by_cases hτ0 : τ = 0
  · subst hτ0
    have h0 : pullbackRationalPluriForms sX p (0 : RationalPluriForms sX (n + 1) m) = 0 := by
      simpa using pullbackRationalPluriForms_smul p (0 : ℂ) (0 : RationalPluriForms sX (n + 1) m)
    rw [h0, PrimeDivisor.ordForm_zero]
    omega
  let D : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, E⟩
  have hD := S.hBWX E
  rw [hE] at hD
  obtain ⟨hXn, -, m₁, hm₁, -, U₁, hU₁, ω₁, hω₁, hω₁a⟩ := hD
  let := functionFieldAlgebra sX
  obtain ⟨b, N, hN⟩ := D.exists_ordPullback_eq hXn S.hdimX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) S.hdimX
  set c := (ZTensorPower.basis b (m : ℤ)).repr τ () with hc_def
  set c₁ := (ZTensorPower.basis b (m₁ : ℤ)).repr ω₁ () with hc₁_def
  have hc : c ≠ 0 := repr_ne_zero_of_ne_zero b hτ0
  have hc₁ : c₁ ≠ 0 := repr_ne_zero_of_ne_zero b hω₁.1
  set g : X.functionField := c ^ (m₁ : ℤ) * c₁ ^ (-(m : ℤ)) with hg_def
  have hg : g ≠ 0 := mul_ne_zero (zpow_ne_zero _ hc) (zpow_ne_zero _ hc₁)
  -- `mB` is integral
  obtain ⟨D', hD', -⟩ := S.hmX
  have hint : ∀ Γ : Mori.PrimeDivisor X,
      ((DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ : ℚ) = m * B.coeff Γ := by
    intro Γ
    have h1 := congrArg (fun F : QDivisor X => F.coeff Γ) hD'
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, zsmul_eq_mul] at h1
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
    have h2 : (m : ℚ) * B.coeff Γ = ((D'.coeff Γ - m * KX.coeff Γ : ℤ) : ℚ) := by
      push_cast
      push_cast at h1
      linarith
    rw [Int.cast_natCast, h2, Int.floor_intCast]
  -- the order of `g` along a prime divisor through `z`
  have hordΓ : ∀ Γ : Mori.PrimeDivisor X, p E.genericPoint ∈ Γ.support →
      (X.ord g Γ.genericPoint : ℚ) = m₁ * Γ.ordForm τ + m * m₁ * B.coeff Γ := by
    intro Γ hΓ
    obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd b
    have e2 := hω₁.2 Γ ⟨_, hΓ, hU₁⟩
    have f1 : (Γ.ordForm τ : ℚ) = (X.ord c Γ.genericPoint : ℚ) + m * NΓ := by
      exact_mod_cast hNΓ m τ hτ0
    have f2 : (Γ.ordForm ω₁ : ℚ) = (X.ord c₁ Γ.genericPoint : ℚ) + m₁ * NΓ := by
      exact_mod_cast hNΓ m₁ ω₁ hω₁.1
    rw [hg_def, Scheme.ord_mul (zpow_ne_zero _ hc) (zpow_ne_zero _ hc₁), ord_zpow _ hc,
      ord_zpow _ hc₁]
    push_cast
    linear_combination -(m₁ : ℚ) * f1 + (m : ℚ) * f2 - (m : ℚ) * e2
  have hord : ∀ Γ : Mori.PrimeDivisor X, p E.genericPoint ∈ Γ.support →
      0 ≤ X.ord g Γ.genericPoint := by
    intro Γ hΓ
    have e1 := hτ.2 Γ ⟨_, hΓ, hU⟩ hτ0
    have h := hordΓ Γ hΓ
    have : (0 : ℚ) ≤ X.ord g Γ.genericPoint := by
      rw [h]
      have e1' : (0 : ℚ) ≤ Γ.ordForm τ + m * B.coeff Γ := by
        rw [← hint]; exact_mod_cast e1
      have : (0 : ℚ) ≤ m₁ := by positivity
      nlinarith
    exact_mod_cast this
  have hBP : (1 : ℚ) ≤ B.coeff P.1 := by
    have h0 := S.hBp.nonneg P.1
    have h1 : 0 ≤ ⌊B.coeff P.1⌋ := Int.floor_nonneg.mpr h0
    have h2 : 1 ≤ ⌊B.coeff P.1⌋ := by have := P.2; omega
    exact_mod_cast (Int.le_floor.mp h2)
  have hordP : 1 ≤ X.ord g P.1.genericPoint := by
    have h := hordΓ P.1 hPz
    have : (1 : ℚ) ≤ X.ord g P.1.genericPoint := by
      rw [h]
      have hP' : (1 : ℚ) - m ≤ P.1.ordForm τ := by exact_mod_cast hP
      have hm₁' : (1 : ℚ) ≤ m₁ := by exact_mod_cast hm₁
      have hm' : (0 : ℚ) ≤ m := by positivity
      nlinarith [mul_le_mul_of_nonneg_left hP' (by linarith : (0 : ℚ) ≤ m₁),
        mul_nonneg (mul_nonneg hm' (by linarith : (0 : ℚ) ≤ m₁)) (by linarith : (0 : ℚ) ≤ B.coeff P.1 - 1)]
    exact_mod_cast this
  -- `g` lies in the maximal ideal of `𝒪_{X,z}`
  obtain ⟨r, hr⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg _ hg hord
  have hspec : P.1.genericPoint ⤳ p E.genericPoint := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hPz
    exact specializes_iff_mem_closure.mpr hPz
  have hrm : r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (p E.genericPoint)) := by
    rw [IsLocalRing.mem_maximalIdeal]
    intro hu
    have hu' := hu.map (X.presheaf.stalkSpecializes hspec).hom
    have h0 := P.1.ord_algebraMap_of_isUnit hu'
    rw [MMP.Mori.algebraMap_stalkSpecializes, hr] at h0
    omega
  -- its pull-back vanishes along `E`
  have hpg : functionFieldMap p g = algebraMap (W.presheaf.stalk E.genericPoint) W.functionField
      ((p.stalkMap E.genericPoint).hom r) := by
    rw [← hr, functionFieldMap_algebraMap_stalk]
  have hpg0 : functionFieldMap p g ≠ 0 := (map_ne_zero _).mpr hg
  have hordE : 1 ≤ W.ord (functionFieldMap p g) E.genericPoint := by
    rw [hpg] at hpg0 ⊢
    exact one_le_ord_algebraMap_of_mem_maximalIdeal E hpg0
      ((IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
        ((IsLocalRing.mem_maximalIdeal _).mp hrm) (isUnit_of_map_unit _ _ hu))
  -- comparison of orders along `E`
  have hfc : functionFieldMap p c ≠ 0 := (map_ne_zero _).mpr hc
  have hfc₁ : functionFieldMap p c₁ ≠ 0 := (map_ne_zero _).mpr hc₁
  rw [hg_def, map_mul, map_zpow₀, map_zpow₀,
    Scheme.ord_mul (zpow_ne_zero _ hfc) (zpow_ne_zero _ hfc₁), ord_zpow _ hfc, ord_zpow _ hfc₁]
    at hordE
  have h1 : (D.ordPullback τ : ℚ) =
      (W.ord (functionFieldMap p c) E.genericPoint : ℚ) + m * N := by
    exact_mod_cast hN m τ hτ0
  have h2 : (D.ordPullback ω₁ : ℚ) =
      (W.ord (functionFieldMap p c₁) E.genericPoint : ℚ) + m₁ * N := by
    exact_mod_cast hN m₁ ω₁ hω₁.1
  have hordE' : (1 : ℚ) ≤ (m₁ : ℚ) * W.ord (functionFieldMap p c) E.genericPoint +
      -(m : ℚ) * W.ord (functionFieldMap p c₁) E.genericPoint := by
    exact_mod_cast hordE
  have key : (1 : ℚ) - m * m₁ ≤ m₁ * D.ordPullback τ := by
    have := hω₁a
    push_cast at this
    have eq : (m₁ : ℚ) * D.ordPullback τ - (1 - m * m₁) =
        ((m₁ : ℚ) * W.ord (functionFieldMap p c) E.genericPoint +
          -(m : ℚ) * W.ord (functionFieldMap p c₁) E.genericPoint) - 1 := by
      linear_combination (m₁ : ℚ) * h1 - (m : ℚ) * h2 - (m : ℚ) * this
    linarith
  change 1 - (m : ℤ) ≤ D.ordPullback τ
  have hm₁' : (1 : ℚ) ≤ m₁ := by exact_mod_cast hm₁
  by_contra hlt
  have hlt' : (D.ordPullback τ : ℚ) ≤ -(m : ℚ) := by
    have : D.ordPullback τ ≤ -(m : ℤ) := by omega
    exact_mod_cast this
  nlinarith

/-- **Vanishing on the floor.** A local section of `𝒪_X(mK_X + ⌊mB⌋)` whose residues along all
floor components vanish has, after pull-back, residue zero along every coefficient-one prime
divisor of the crepant boundary lying over its domain. -/
private theorem isPoincareResidue_pullback_zero_of_presents_zero
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) {U : X.Opens}
    {τ : RationalPluriForms sX (n + 1) m} (hτ : Presents sX n m B jX BX 0 U τ)
    (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) {E' : Scheme.{0}} [IsIntegral E']
    (jE : E' ⟶ W) (hjE : IsClosedImmersion jE) (hrange : Set.range jE.base = (E.support : Set W))
    (hU : p.base (jE.base (genericPoint E')) ∈ U) :
    IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ) 0 := by
  haveI := hjE
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  have hEgen := map_genericPoint_eq_of_range_eq hrange
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  change p (jE (genericPoint E')) ∈ U at hU
  rw [hEgen] at hU
  by_cases hτ0 : τ = 0
  · subst hτ0
    have h0 : pullbackRationalPluriForms sX p (0 : RationalPluriForms sX (n + 1) m) = 0 := by
      simpa using pullbackRationalPluriForms_smul p (0 : ℂ) (0 : RationalPluriForms sX (n + 1) m)
    rw [h0]
    exact isPoincareResidue_zero_of_isClosedImmersion E hEgen
  obtain ⟨P, hPz⟩ := exists_floor_mem_of_coeff_eq_one S E hE
  obtain ⟨P', hP', hPci⟩ := (S.hjX P).1.exists_primeDivisor
  haveI := hPci
  have hPP' : P' = P.1 := by
    have h1 := map_genericPoint_eq_of_range_eq (P := P.1) (S.hjX P).2
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hP'.symm.trans h1)
  subst hPP'
  have hηU : (jX P).base (genericPoint (CX P)) ∈ U := by
    change (jX P) (genericPoint (CX P)) ∈ U
    rw [hP']
    have hsp : P.1.genericPoint ⤳ p E.genericPoint := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hPz
      exact specializes_iff_mem_closure.mpr hPz
    exact hsp.mem_open U.isOpen hU
  have hres := hτ.2 P hηU
  rw [Pi.zero_apply, Submodule.coe_zero] at hres
  have hord := le_ordForm_of_isPoincareResidue_zero P.1 hP' (by exact_mod_cast S.hdimX) hτ0 hres
  exact isPoincareResidue_zero_of_le_ordForm E hEgen hdimW
    (le_ordForm_pullback_of_coeff_eq_one S hτ.1 E hE hU P hPz hord)

/-- **Independence of the presentation.** Two local presentations of a floor section have the
same residue, after pull-back, along every coefficient-one prime divisor of `B_W` over both. -/
private theorem isPoincareResidue_pullback_of_presents
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U₁ U₂ : X.Opens}
    {τ₁ τ₂ : RationalPluriForms sX (n + 1) m} (h₁ : Presents sX n m B jX BX t U₁ τ₁)
    (h₂ : Presents sX n m B jX BX t U₂ τ₂)
    (E : Mori.PrimeDivisor W) (hE : BW.coeff E = 1) {E' : Scheme.{0}} [IsIntegral E']
    (jE : E' ⟶ W) (hjE : IsClosedImmersion jE) (hrange : Set.range jE.base = (E.support : Set W))
    (hU₁ : p.base (jE.base (genericPoint E')) ∈ U₁) (hU₂ : p.base (jE.base (genericPoint E')) ∈ U₂)
    {ρ : RationalPluriForms (jE ≫ p ≫ sX) n m}
    (hρ : IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ₁) ρ) :
    IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ₂) ρ := by
  have hne : U₁ ⊓ U₂ ≠ ⊥ := fun h => by
    have : p.base (jE.base (genericPoint E')) ∈ U₁ ⊓ U₂ := ⟨hU₁, hU₂⟩
    rw [h] at this
    exact this
  haveI := hjE
  have h0 := isPoincareResidue_pullback_zero_of_presents_zero S (Presents.sub S h₁ h₂ hne) E hE
    jE hjE hrange ⟨hU₁, hU₂⟩
  haveI := S.hWX.1.toLocallyOfFiniteType
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  have h := IsPoincareResidue.add_of_isClosedImmersion E (map_genericPoint_eq_of_range_eq hrange)
    hdimW h0 hρ
  rwa [← pullbackRationalPluriForms_add, sub_add_cancel, zero_add] at h

/-- The pin relation follows from matching residues for one pair of presentations over each
coefficient-one prime divisor of `B_W`. -/
private theorem Pins.of_exists (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (h : ∀ (E : Mori.PrimeDivisor W), BW.coeff E = 1 →
      ∀ {E' : Scheme.{0}} [IsIntegral E'] (jE : E' ⟶ W), IsClosedImmersion jE →
        Set.range jE.base = (E.support : Set W) →
        ∃ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m),
          Presents sX n m B jX BX t U τ ∧ p.base (jE.base (genericPoint E')) ∈ U ∧
        ∃ (U' : Y.Opens) (τ' : RationalPluriForms sY (n + 1) m),
          Presents sY n m C jY BY t' U' τ' ∧ q.base (jE.base (genericPoint E')) ∈ U' ∧
        ∃ ρ : RationalPluriForms (jE ≫ p ≫ sX) n m,
          IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ) ρ ∧
          IsPoincareResidue (q ≫ sY) jE n m (pullbackRationalPluriForms sY q τ')
            (cast (by rw [S.hpq]) ρ)) :
    Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t' := by
  intro U₂ τ₂ hτ₂ U₂' τ₂' hτ₂' E hE E' _ jE hjE hrange hU₂ hU₂'
  obtain ⟨U, τ, hτ, hU, U', τ', hτ', hU', ρ, h₁, h₂⟩ := h E hE jE hjE hrange
  exact ⟨ρ, isPoincareResidue_pullback_of_presents S hτ hτ₂ E hE jE hjE hrange hU hU₂ h₁,
    isPoincareResidue_pullback_of_presents S.swap hτ' hτ₂' E hE jE hjE hrange hU' hU₂'
      h₂⟩

/-- The pin relation is linear. -/
private theorem Pins.add (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t₁ t₂ : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t₁' t₂' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht₁ : IsFloorSection sX n m B jX BX t₁) (ht₂ : IsFloorSection sX n m B jX BX t₂)
    (ht₁' : IsFloorSection sY n m C jY BY t₁') (ht₂' : IsFloorSection sY n m C jY BY t₂')
    (h₁ : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t₁ t₁')
    (h₂ : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t₂ t₂') :
    Pins sX sY n B C p q S.hpq BW m jX BX jY BY (t₁ + t₂) (t₁' + t₂') := by
  refine Pins.of_exists S fun E hE E' _ jE hjE hrange => ?_
  haveI := hjE
  have hEgen := map_genericPoint_eq_of_range_eq hrange
  obtain ⟨U₁, hx₁, τ₁, hτ₁⟩ := ht₁ (p.base (jE.base (genericPoint E')))
  obtain ⟨U₂, hx₂, τ₂, hτ₂⟩ := ht₂ (p.base (jE.base (genericPoint E')))
  obtain ⟨U₁', hy₁, τ₁', hτ₁'⟩ := ht₁' (q.base (jE.base (genericPoint E')))
  obtain ⟨U₂', hy₂, τ₂', hτ₂'⟩ := ht₂' (q.base (jE.base (genericPoint E')))
  obtain ⟨ρ₁, hρ₁, hρ₁'⟩ := h₁ U₁ τ₁ hτ₁ U₁' τ₁' hτ₁' E hE jE hjE hrange hx₁ hy₁
  obtain ⟨ρ₂, hρ₂, hρ₂'⟩ := h₂ U₂ τ₂ hτ₂ U₂' τ₂' hτ₂' E hE jE hjE hrange hx₂ hy₂
  have hne : U₁ ⊓ U₂ ≠ ⊥ := fun h => by
    have : p.base (jE.base (genericPoint E')) ∈ U₁ ⊓ U₂ := ⟨hx₁, hx₂⟩
    rw [h] at this
    exact this
  have hne' : U₁' ⊓ U₂' ≠ ⊥ := fun h => by
    have : q.base (jE.base (genericPoint E')) ∈ U₁' ⊓ U₂' := ⟨hy₁, hy₂⟩
    rw [h] at this
    exact this
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  refine ⟨U₁ ⊓ U₂, τ₁ + τ₂, Presents.add S hτ₁ hτ₂ hne, ⟨hx₁, hx₂⟩, U₁' ⊓ U₂', τ₁' + τ₂',
    Presents.add S.swap hτ₁' hτ₂' hne', ⟨hy₁, hy₂⟩, ρ₁ + ρ₂, ?_, ?_⟩
  · rw [pullbackRationalPluriForms_add]
    exact IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW hρ₁ hρ₂
  · rw [pullbackRationalPluriForms_add, cast_add_rationalPluriForms (by rw [S.hpq])]
    exact IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW hρ₁' hρ₂'

private theorem Pins.smul (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (c : ℂ)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t') :
    Pins sX sY n B C p q S.hpq BW m jX BX jY BY (c • t) (c • t') := by
  refine Pins.of_exists S fun E hE E' _ jE hjE hrange => ?_
  haveI := hjE
  obtain ⟨U, hx, τ, hτ⟩ := ht (p.base (jE.base (genericPoint E')))
  obtain ⟨U', hy, τ', hτ'⟩ := ht' (q.base (jE.base (genericPoint E')))
  obtain ⟨ρ, hρ, hρ'⟩ := h U τ hτ U' τ' hτ' E hE jE hjE hrange hx hy
  refine ⟨U, c • τ, Presents.smul S c hτ, hx, U', c • τ', Presents.smul S.swap c hτ', hy,
    c • ρ, ?_, ?_⟩
  · rw [pullbackRationalPluriForms_smul]
    exact IsPoincareResidue.const_smul hρ c
  · rw [pullbackRationalPluriForms_smul, cast_smul_rationalPluriForms (by rw [S.hpq])]
    exact IsPoincareResidue.const_smul hρ' c

/-- **Coefficients of strict transforms of floor components.** A prime divisor `E` of `W` over
the generic point of a floor component `Q` of `Y`, at which `q` is a local isomorphism, has
coefficient one in `B_W`, as `Q` has in `C`. -/
private theorem coeff_eq_one_of_isIso_stalkMap
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (E : Mori.PrimeDivisor W)
    (hqE : q E.genericPoint = Q.1.genericPoint) [IsIso (q.stalkMap E.genericPoint)] :
    BW.coeff E = 1 ∧ C.coeff Q.1 = 1 := by
  haveI := S.hYp.toLocallyOfFiniteType
  suffices hc : BW.coeff E = C.coeff Q.1 ∧ C.coeff Q.1 = 1 from ⟨hc.1.trans hc.2, hc.2⟩
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hbij := S.hqb.functionFieldMap_bijective
  -- the coefficient of `E` is that of `Q`
  have hD := S.hBWY E
  obtain ⟨-, -, m₁, hm₁, -, U₁, hU₁, ω₁, hω₁, hω₁a⟩ := hD
  have hQU : (Q.1.support ∩ U₁).Nonempty := by
    refine ⟨Q.1.genericPoint, ?_, hqE ▸ hU₁⟩
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have e1 := hω₁.2 Q.1 hQU
  have e2 : (DivisorOver.ordPullback ⟨W, q, S.hWY, S.hqb, E⟩ ω₁ : ℤ) = Q.1.ordForm ω₁ :=
    MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso q hbij hd E Q.1 hqE ω₁
  have hcoeff : BW.coeff E = C.coeff Q.1 := by
    have hm₁' : (m₁ : ℚ) ≠ 0 := by positivity
    have := hω₁a
    rw [e2] at this
    apply mul_left_cancel₀ hm₁'
    linear_combination -this - e1
  refine ⟨hcoeff, ?_⟩
  have h0 := S.hCp.nonneg Q.1
  have h1 : 1 ≤ ⌊C.coeff Q.1⌋ := by
    have := Int.floor_nonneg.mpr h0
    have := Q.2
    omega
  have hge : (1 : ℚ) ≤ C.coeff Q.1 := by exact_mod_cast Int.le_floor.mp h1
  have hle : C.coeff Q.1 ≤ 1 := by
    rcases S.hC with hdlt | ⟨hlc, -⟩
    · exact hdlt.2.1 Q.1
    · have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (S.hBWY E)
        (show IsProper (DivisorOver.f ⟨W, q, S.hWY, S.hqb, E⟩) from inferInstanceAs (IsProper q))
      have := hlc.2.2 _ _ _ hlog
      rw [← hcoeff]
      push_cast at this
      have h' : ((BW.coeff E : ℚ) : ℝ) ≤ 1 := by linarith
      exact_mod_cast h'
  linarith

/-- **Strict transforms of floor components.** Every floor component `Q` of `Y` has a strict
transform `E` on `W`: `q(η_E) = η_Q`, `q` is a local isomorphism there, and `E` has coefficient
one in `B_W`, as `Q` has in `C`. -/
private theorem exists_strictTransform_floor
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) :
    ∃ E : Mori.PrimeDivisor W, q E.genericPoint = Q.1.genericPoint ∧
      IsIso (q.stalkMap E.genericPoint) ∧ BW.coeff E = 1 ∧ C.coeff Q.1 = 1 := by
  haveI := S.hYp.toLocallyOfFiniteType
  have hbir : Q.1.genericPoint ∈ Mori.biregularLocus q :=
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal q S.hqb
      Q.1.coheight_genericPoint.le
  obtain ⟨E, -, hqE⟩ := MMP.Flips.exists_inverseTransformPrimeDivisor_eq_some Q.1 hbir
  have hiso : IsIso (q.stalkMap E.genericPoint) :=
    MMP.isIso_stalkMap_of_mem_biregularLocus q (hqE ▸ hbir)
  exact ⟨E, hqE, hiso, coeff_eq_one_of_isIso_stalkMap S Q E hqE⟩

/-- **Uniqueness.** A floor section of `X` is pinned to at most one floor section of `Y`. -/
private theorem eq_of_pins (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (ht : IsFloorSection sX n m B jX BX t)
    {t₁ t₂ : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht₁ : IsFloorSection sY n m C jY BY t₁) (ht₂ : IsFloorSection sY n m C jY BY t₂)
    (h₁ : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t₁)
    (h₂ : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t₂) : t₁ = t₂ := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hm0 := S.hm0
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  have hdY : topologicalKrullDim Y = n + 1 := by exact_mod_cast S.hdimY
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  funext Q
  apply Subtype.ext
  obtain ⟨E, hqE, hiso, hE, -⟩ := exists_strictTransform_floor S Q
  -- the reduced closed subscheme on `E`
  let E' := E.idealSheaf.subscheme
  haveI : IsIntegral E' := E.integral
  let jE : E' ⟶ W := E.idealSheaf.subschemeι
  have hrange : Set.range jE.base = (E.support : Set W) := E.idealSheaf.range_subschemeι
  have hEgen : jE (genericPoint E') = E.genericPoint := map_genericPoint_eq_of_range_eq hrange
  -- presentations near the relevant points
  obtain ⟨U, hxU, τ, hτ⟩ := ht (p.base (jE.base (genericPoint E')))
  obtain ⟨U₁, hy₁, τ₁, hτ₁⟩ := ht₁ (q.base (jE.base (genericPoint E')))
  obtain ⟨U₂, hy₂, τ₂, hτ₂⟩ := ht₂ (q.base (jE.base (genericPoint E')))
  obtain ⟨ρ₁, hρ₁, hρ₁'⟩ := h₁ U τ hτ U₁ τ₁ hτ₁ E hE jE inferInstance hrange hxU hy₁
  obtain ⟨ρ₂, hρ₂, hρ₂'⟩ := h₂ U τ hτ U₂ τ₂ hτ₂ E hE jE inferInstance hrange hxU hy₂
  have hρ : ρ₁ = ρ₂ := IsPoincareResidue.unique_of_isClosedImmersion E hEgen hρ₁ hρ₂
  subst hρ
  -- the difference has zero residue along `E`, hence high order along `E`, hence along `Q`
  have hδE : IsPoincareResidue (q ≫ sY) jE n m
      (pullbackRationalPluriForms sY q (τ₁ - τ₂)) 0 := by
    have h := IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW hρ₁'
      (IsPoincareResidue.const_smul hρ₂' (-1))
    rw [neg_one_smul, neg_one_smul, add_neg_cancel, ← sub_eq_add_neg,
      ← pullbackRationalPluriForms_sub] at h
    exact h
  have hordE : 1 - (m : ℤ) ≤ E.ordForm (pullbackRationalPluriForms sY q (τ₁ - τ₂)) := by
    by_cases h0 : pullbackRationalPluriForms sY q (τ₁ - τ₂) = 0
    · rw [h0, PrimeDivisor.ordForm_zero]; omega
    exact le_ordForm_of_isPoincareResidue_zero E hEgen hdimW h0 hδE
  rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso q S.hqb.functionFieldMap_bijective
    hd E Q.1 hqE] at hordE
  obtain ⟨Q', hQ', hQci⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hQci
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans (map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2))
  subst hQQ'
  have hres0 := isPoincareResidue_zero_of_le_ordForm Q.1 hQ' hdY hordE
  -- the residue of the difference is `t₁ Q - t₂ Q`
  have hηU : ∀ {V : Y.Opens}, q.base (jE.base (genericPoint E')) ∈ V →
      (jY Q).base (genericPoint (CY Q)) ∈ V := fun {V} hV => by
    change (jY Q) (genericPoint (CY Q)) ∈ V
    rw [hQ']
    change q (jE (genericPoint E')) ∈ V at hV
    rwa [hEgen, hqE] at hV
  have hres := IsPoincareResidue.add_of_isClosedImmersion Q.1 hQ' hdY (hτ₁.2 Q (hηU hy₁))
    (IsPoincareResidue.const_smul (hτ₂.2 Q (hηU hy₂)) (-1))
  rw [neg_one_smul, neg_one_smul, ← sub_eq_add_neg, ← sub_eq_add_neg] at hres
  exact sub_eq_zero.mp (IsPoincareResidue.unique_of_isClosedImmersion Q.1 hQ' hres hres0)

/-! ### Descent of floor sections -/

/-- `τ'` is a *local descent* of the floor section `t` on `U' ⊆ Y`: along every coefficient-one
prime divisor `E` of `B_W` lying over `U'`, the pull-back `q^*τ'` has the residue of `p^*τ` for
some local presentation `τ` of `t` near `p(η_E)`. -/
private def IsLocalDescent (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) (U' : Y.Opens)
    (τ' : RationalPluriForms sY (n + 1) m) : Prop :=
  ∀ (E : Mori.PrimeDivisor W), BW.coeff E = 1 →
  ∀ {E' : Scheme.{0}} [IsIntegral E'] (jE : E' ⟶ W), IsClosedImmersion jE →
    Set.range jE.base = (E.support : Set W) → q.base (jE.base (genericPoint E')) ∈ U' →
    ∃ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m),
      Presents sX n m B jX BX t U τ ∧ p.base (jE.base (genericPoint E')) ∈ U ∧
      ∃ ρ : RationalPluriForms (jE ≫ p ≫ sX) n m,
        IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ) ρ ∧
        IsPoincareResidue (q ≫ sY) jE n m (pullbackRationalPluriForms sY q τ')
          (cast (by rw [S.hpq]) ρ)

/-- `mB` is integral: `⌊mB⌋ = mB`. -/
private theorem coeff_roundDown_eq (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Γ : Mori.PrimeDivisor X) :
    ((DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ : ℚ) = m * B.coeff Γ := by
  obtain ⟨D', hD', -⟩ := S.hmX
  have h1 := congrArg (fun F : QDivisor X => F.coeff Γ) hD'
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_add, zsmul_eq_mul] at h1
  rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
  have h2 : (m : ℚ) * B.coeff Γ = ((D'.coeff Γ - m * KX.coeff Γ : ℤ) : ℚ) := by
    push_cast
    push_cast at h1
    linarith
  rw [Int.cast_natCast, h2, Int.floor_intCast]

/-- Pull-back of forms is semilinear over the function field. -/
private theorem pullbackRationalPluriForms_smul_functionField {k : Type} [Field k]
    {X W : Scheme.{0}} [IsIntegral X] [IsIntegral W] {sX : X ⟶ Spec (.of k)} (p : W ⟶ X)
    [IsDominant p] {d : ℕ} {m : ℤ} (f : X.functionField) (a : RationalPluriForms sX d m) :
    pullbackRationalPluriForms sX p (f • a) =
      functionFieldMap p f • pullbackRationalPluriForms sX p a := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (p ≫ sX)
  letI := functionFieldMapAlgebra p
  haveI := isScalarTower_functionFieldMap sX p
  exact pullbackForms_smul (K := X.functionField) (K' := W.functionField) f a

/-- The pull-back of a nonzero form along a birational map is nonzero. -/
private theorem pullbackRationalPluriForms_ne_zero {k : Type} [Field k] [PerfectField k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [LocallyOfFiniteType sX]
    {Y : Scheme.{0}} [IsIntegral Y] (f : Y ⟶ X) [IsDominant f]
    (hbij : Function.Bijective (functionFieldMap f)) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d)
    {m : ℤ} {τ : RationalPluriForms sX d m} (hτ : τ ≠ 0) :
    pullbackRationalPluriForms sX f τ ≠ 0 := by
  let := functionFieldAlgebra sX
  obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_of_bijective sX f hbij hd
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldMapAlgebra f
  have := isScalarTower_functionFieldMap sX f
  have hpull : pullbackRationalPluriForms sX f τ = pullbackFormsAlong hω m τ :=
    pullbackForms_eq hω m τ
  have hrepr := repr_pullbackFormsAlong hω m τ
  intro h0
  have h0' : pullbackFormsAlong hω m τ = 0 := hpull ▸ h0
  have h1 : algebraMap X.functionField Y.functionField
      ((ZTensorPower.basis (basisOfSpanSingleton hω.1 hω.ne_zero) m).repr τ ()) = 0 := by
    rw [← hrepr, h0']
    simp
  exact repr_ne_zero_of_ne_zero _ hτ ((map_eq_zero_iff _ (algebraMap _ _).injective).mp h1)

/-- Pull-back of rational forms along a composite of birational morphisms. -/
private theorem pullbackRationalPluriForms_comp {k : Type} [Field k] [PerfectField k]
    {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y] [IsIntegral Z] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] (f : Y ⟶ X) (g : Z ⟶ Y) [IsDominant f] [IsDominant g]
    [LocallyOfFiniteType (f ≫ sX)] (hf : Function.Bijective (functionFieldMap f))
    (hg : Function.Bijective (functionFieldMap g)) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d)
    {m : ℤ} (τ : RationalPluriForms sX d m) :
    pullbackRationalPluriForms (f ≫ sX) g (pullbackRationalPluriForms sX f τ) =
      (pullbackRationalPluriForms sX (g ≫ f) τ : RationalPluriForms (g ≫ f ≫ sX) d m) := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldAlgebra (g ≫ f ≫ sX)
  let := functionFieldMapAlgebra f
  let := functionFieldMapAlgebra g
  let := functionFieldMapAlgebra (g ≫ f)
  have := isScalarTower_functionFieldMap sX f
  have := isScalarTower_functionFieldMap (f ≫ sX) g
  have : IsScalarTower k X.functionField Z.functionField :=
    isScalarTower_functionFieldMap sX (g ≫ f)
  have : IsScalarTower X.functionField Y.functionField Z.functionField :=
    IsScalarTower.of_algebraMap_eq fun a =>
      (MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply g f a).symm
  obtain ⟨ω0, hω0⟩ := exists_isPullbackGenerator_of_bijective sX f hf hd
  have hd' : (Algebra.trdeg k Y.functionField).toNat = d := by
    rw [← trdeg_functionField_eq_of_bijective sX f hf]
    exact hd
  obtain ⟨ω1, hω1⟩ := exists_isPullbackGenerator_of_bijective (f ≫ sX) g hg hd'
  have hω' : IsPullbackGenerator Z.functionField
      (topFormsMap k X.functionField Y.functionField d ω0) :=
    MMP.Threefold.Mori.Helpers.IsPullbackGenerator.of_span hω1 hω0.2.1 hω0.2.2
  exact MMP.Threefold.Mori.Helpers.pullbackForms_comp hω0 hω' τ

/-- Pull-back of forms is compatible with an equality of structure morphisms. -/
private theorem cast_pullbackRationalPluriForms {k : Type} [Field k] {W W' : Scheme.{0}}
    [IsIntegral W] [IsIntegral W'] {s s' : W ⟶ Spec (.of k)} (hs : s = s') (r : W' ⟶ W)
    [IsDominant r] {d : ℕ} {m : ℤ} (σ : RationalPluriForms s d m)
    (h₁ : RationalPluriForms s d m = RationalPluriForms s' d m)
    (h₂ : RationalPluriForms (r ≫ s) d m = RationalPluriForms (r ≫ s') d m) :
    cast h₂ (pullbackRationalPluriForms s r σ) = pullbackRationalPluriForms s' r (cast h₁ σ) := by
  subst hs
  rfl

/-- **Crepant pull-back of a local generator.** If `ω` generates `𝒪_X(m(K_X + B))` near
`p(η_F)`, then `ord_F(p^*ω) = -m b_F`, `b_F` the coefficient of `F` in the crepant boundary. -/
private theorem ordForm_pullback_of_generatesOn
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (F : Mori.PrimeDivisor W)
    {U : X.Opens} (hU : p F.genericPoint ∈ U) {ω : RationalPluriForms sX (n + 1) m}
    (hω : GeneratesOn B m U ω) :
    (F.ordForm (pullbackRationalPluriForms sX p ω) : ℚ) = -(m : ℚ) * BW.coeff F := by
  haveI := S.hXp.toLocallyOfFiniteType
  have hm : (m : ℚ) ≠ 0 := by have := S.hm0; positivity
  let D : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, F⟩
  have h1 : IsDiscrepancy sX (n + 1) KX B D ((D.ordPullback ω : ℚ) / m) := by
    refine ⟨S.hBp.isPair.1, S.hKX, m, S.hm0, S.hmX, U, hU, ω, hω, ?_⟩
    field_simp
  have h2 := (S.hBWX F).eq h1
  change (D.ordPullback ω : ℚ) = _
  rw [eq_div_iff hm] at h2
  linarith

/-- **Crepant pull-back of a local section.** A nonzero section `τ` of `𝒪_X(mK_X + ⌊mB⌋)` near
`p(η_F)` has `ord_F(p^*τ) ≥ -m b_F`. -/
private theorem le_ordForm_pullback_of_mem
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (F : Mori.PrimeDivisor W)
    {U : X.Opens} (hU : p F.genericPoint ∈ U) {τ : RationalPluriForms sX (n + 1) m}
    (hτ : τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U)
    (hτ0 : τ ≠ 0) :
    -(m : ℚ) * BW.coeff F ≤ F.ordForm (pullbackRationalPluriForms sX p τ) := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  let := functionFieldAlgebra sX
  have hdX : topologicalKrullDim X = n + 1 := by exact_mod_cast S.hdimX
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) S.hdimX
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  have hdW := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := p ≫ sX)
    (show topologicalKrullDim W = ((n + 1 : ℕ) : WithBot ℕ∞) by rw [hdimW]; norm_cast)
  obtain ⟨-, U₁, hU₁, ω, hω⟩ := MMP.Positivity.IsPair.exists_generatesOn S.hBp.isPair S.hKX
    S.hmX (p F.genericPoint)
  obtain ⟨h, rfl⟩ := exists_eq_smul_of_ne_zero hdX hω.1 τ
  have hh0 : h ≠ 0 := fun h0 => hτ0 (by rw [h0, zero_smul])
  have hhord : ∀ Γ : Mori.PrimeDivisor X, p F.genericPoint ∈ Γ.support →
      0 ≤ X.ord h Γ.genericPoint := by
    intro Γ hΓ
    have e1 := hτ.2 Γ ⟨_, hΓ, hU⟩ hτ0
    rw [Γ.ordForm_smul hd hh0 hω.1] at e1
    have e2 := hω.2 Γ ⟨_, hΓ, hU₁⟩
    have e1' : (0 : ℚ) ≤ (X.ord h Γ.genericPoint : ℚ) + (Γ.ordForm ω : ℚ) +
        ((DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ : ℚ) := by
      exact_mod_cast e1
    rw [coeff_roundDown_eq S] at e1'
    have : (0 : ℚ) ≤ X.ord h Γ.genericPoint := by linarith
    exact_mod_cast this
  obtain ⟨r, hr⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg (p F.genericPoint) hh0 hhord
  have hω0 : pullbackRationalPluriForms sX p ω ≠ 0 :=
    pullbackRationalPluriForms_ne_zero p S.hpb.functionFieldMap_bijective hd hω.1
  have hfh : functionFieldMap p h ≠ 0 := (map_ne_zero _).mpr hh0
  rw [pullbackRationalPluriForms_smul_functionField, F.ordForm_smul hdW hfh hω0]
  have hfr : 0 ≤ W.ord (functionFieldMap p h) F.genericPoint := by
    rw [← hr, functionFieldMap_algebraMap_stalk]
    exact ord_algebraMap_nonneg F _
  have := ordForm_pullback_of_generatesOn S F hU₁ hω
  push_cast
  have : (0 : ℚ) ≤ W.ord (functionFieldMap p h) F.genericPoint := by exact_mod_cast hfr
  linarith

/-- The order form of a local descent: along every coefficient-one prime divisor `E` of `B_W`
over `U'`, `q^*τ' - p^*τ` has order at least `1 - m` for some local presentation `τ` of `t` near
`p(η_E)`. -/
private def IsLocalDescentOrd (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) (U' : Y.Opens)
    (τ' : RationalPluriForms sY (n + 1) m) : Prop :=
  ∀ E : Mori.PrimeDivisor W, BW.coeff E = 1 → q E.genericPoint ∈ U' →
    ∃ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m),
      Presents sX n m B jX BX t U τ ∧ p E.genericPoint ∈ U ∧
      1 - (m : ℤ) ≤ E.ordForm (pullbackRationalPluriForms sY q τ' -
        cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p τ))

/-- The order form of a local descent is a local descent. -/
private theorem IsLocalDescentOrd.isLocalDescent
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U' : Y.Opens}
    {τ' : RationalPluriForms sY (n + 1) m} (h : IsLocalDescentOrd S t U' τ') :
    IsLocalDescent S t U' τ' := by
  intro E hE E' _ jE hjE hrange hq
  haveI := hjE
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  have hEgen := map_genericPoint_eq_of_range_eq hrange
  change q (jE (genericPoint E')) ∈ U' at hq
  rw [hEgen] at hq
  obtain ⟨U, τ, hτ, hU, hord⟩ := h E hE hq
  refine ⟨U, τ, hτ, by change p (jE (genericPoint E')) ∈ U; rw [hEgen]; exact hU, ?_⟩
  have hle : -(m : ℤ) ≤ E.ordForm (pullbackRationalPluriForms sX p τ) := by
    by_cases hτ0 : τ = 0
    · subst hτ0
      have h0 : pullbackRationalPluriForms sX p (0 : RationalPluriForms sX (n + 1) m) = 0 := by
        simpa using pullbackRationalPluriForms_smul p (0 : ℂ) (0 : RationalPluriForms sX (n + 1) m)
      rw [h0, PrimeDivisor.ordForm_zero]
      omega
    have h1 := le_ordForm_pullback_of_mem S E hU hτ.1 hτ0
    rw [hE, mul_one] at h1
    exact_mod_cast h1
  obtain ⟨ρ, hρ⟩ := exists_isPoincareResidue_of_le_ordForm (sY := p ≫ sX) E hEgen hdimW hle
  refine ⟨ρ, hρ, ?_⟩
  have h0 := isPoincareResidue_zero_of_le_ordForm (sY := q ≫ sY) E hEgen hdimW hord
  have hc := IsPoincareResidue.cast_structure S.hpq hρ (by rw [S.hpq]) (by rw [S.hpq])
  have := IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW h0 hc
  rwa [sub_add_cancel, zero_add] at this

/-- **Transfer of local descents** from a model `W'` dominating `W`: every coefficient-one prime
divisor of `B_W` has a strict transform on `W'`, of coefficient one, along which orders of forms
are those along `E`. -/
private theorem IsLocalDescentOrd.of_comp
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {W' : Scheme.{0}} [IsIntegral W'] [IsLocallyNoetherian W'] [IsNormal W'] (r : W' ⟶ W)
    [IsDominant r] [IsProper r] (hrb : IsBirationalMorphism r) {BW' : QDivisor W'}
    (S' : Setting sX sY n B C KX KY (r ≫ p) (r ≫ q) BW' m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)} {U' : Y.Opens}
    {τ' : RationalPluriForms sY (n + 1) m} (h : IsLocalDescentOrd S' t U' τ') :
    IsLocalDescentOrd S t U' τ' := by
  intro E hE hqE
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hm : (m : ℚ) ≠ 0 := by have := S.hm0; positivity
  have hdimW : topologicalKrullDim W = ((n + 1 : ℕ) : WithBot ℕ∞) := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact S.hdimX
  have hdWX := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := p ≫ sX) hdimW
  have hdWY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := q ≫ sY) hdimW
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) S.hdimX
  have hdY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hbir : E.genericPoint ∈ Mori.biregularLocus r :=
    MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal r hrb
      E.coheight_genericPoint.le
  obtain ⟨E', -, hrE⟩ := MMP.Flips.exists_inverseTransformPrimeDivisor_eq_some E hbir
  haveI hiso : IsIso (r.stalkMap E'.genericPoint) :=
    MMP.isIso_stalkMap_of_mem_biregularLocus r (hrE ▸ hbir)
  have hbr := hrb.functionFieldMap_bijective
  -- the coefficient of `E'`
  obtain ⟨-, U₁, hU₁, ω, hω⟩ := MMP.Positivity.IsPair.exists_generatesOn S.hBp.isPair S.hKX
    S.hmX (p E.genericPoint)
  have e1 := ordForm_pullback_of_generatesOn S E hU₁ hω
  have hU₁' : (r ≫ p) E'.genericPoint ∈ U₁ := by
    change p (r E'.genericPoint) ∈ U₁
    rw [hrE]
    exact hU₁
  have e2 : (E'.ordForm (sX := r ≫ p ≫ sX) (pullbackRationalPluriForms (p ≫ sX) r
      (pullbackRationalPluriForms sX p ω)) : ℚ) = -(m : ℚ) * BW'.coeff E' := by
    have := ordForm_pullback_of_generatesOn S' E' hU₁' hω
    rw [← pullbackRationalPluriForms_comp p r S.hpb.functionFieldMap_bijective hbr hd] at this
    exact this
  rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso r hbr hdWX E' E hrE, e1, hE]
    at e2
  have hE' : BW'.coeff E' = 1 := (mul_left_cancel₀ (neg_ne_zero.mpr hm) e2).symm
  have hqE' : (r ≫ q) E'.genericPoint ∈ U' := by
    change q (r E'.genericPoint) ∈ U'
    rw [hrE]
    exact hqE
  obtain ⟨U, τ, hτ, hU, hord⟩ := h E' hE' hqE'
  refine ⟨U, τ, hτ, by change p (r E'.genericPoint) ∈ U at hU; rwa [hrE] at hU, ?_⟩
  have key : pullbackRationalPluriForms sY (r ≫ q) τ' -
      cast (by rw [S'.hpq]) (pullbackRationalPluriForms sX (r ≫ p) τ) =
      (pullbackRationalPluriForms (q ≫ sY) r (pullbackRationalPluriForms sY q τ' -
        cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p τ)) :
          RationalPluriForms (r ≫ q ≫ sY) (n + 1) m) := by
    rw [pullbackRationalPluriForms_sub,
      ← cast_pullbackRationalPluriForms S.hpq r _ (by rw [S.hpq]) (by rw [S.hpq]),
      pullbackRationalPluriForms_comp q r S.hqb.functionFieldMap_bijective hbr hdY,
      pullbackRationalPluriForms_comp p r S.hpb.functionFieldMap_bijective hbr hd]
    rfl
  rw [key] at hord
  have hord' : 1 - (m : ℤ) ≤ E'.ordForm (sX := r ≫ q ≫ sY)
      (pullbackRationalPluriForms (q ≫ sY) r (pullbackRationalPluriForms sY q τ' -
        cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p τ))) := hord
  rwa [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso r hbr hdWY E' E hrE] at hord'

/-- The crepant boundary of a log canonical pair has coefficients at most one. -/
private theorem coeff_le_one_of_setting
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (F : Mori.PrimeDivisor W) :
    BW.coeff F ≤ 1 := by
  have hlc : MMP.Intersection.IsLogCanonicalPair sX B := by
    rcases S.hB with h | ⟨h, -⟩
    · exact h.1
    · exact h
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (S.hBWX F)
    (show IsProper (DivisorOver.f ⟨W, p, S.hWX, S.hpb, F⟩) from inferInstanceAs (IsProper p))
  have := hlc.2.2 _ _ _ hlog
  push_cast at this
  have h' : ((BW.coeff F : ℚ) : ℝ) ≤ 1 := by linarith
  exact_mod_cast h'

/-- **Crepancy on a model dominating `W`.** If `r : W' ⟶ W` is proper birational and `B_{W'}` is
the crepant boundary of `(Y, C)` along `r ≫ q`, it is also the crepant boundary of `(X, B)` along
`r ≫ p`: near the centre on `W`, local generators of `m(K_X + B)` and `m(K_Y + C)` pull back to
forms differing by a unit. -/
private theorem isCrepantBoundary_comp (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {W' : Scheme.{0}} [IsIntegral W'] [IsLocallyNoetherian W'] [IsNormal W'] (r : W' ⟶ W)
    [IsDominant r] (hrb : IsBirationalMorphism r) (hWX' : IsNormalVariety ℂ ((r ≫ p) ≫ sX))
    (hWY' : IsNormalVariety ℂ ((r ≫ q) ≫ sY)) (hpb' : IsBirationalMorphism (r ≫ p))
    (hqb' : IsBirationalMorphism (r ≫ q)) {BW' : QDivisor W'}
    (hBW' : IsCrepantBoundary sY (n + 1) KY C (r ≫ q) hWY' hqb' BW') :
    IsCrepantBoundary sX (n + 1) KX B (r ≫ p) hWX' hpb' BW' := by
  intro F
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType ((r ≫ q) ≫ sY) := hWY'.1.toLocallyOfFiniteType
  have hm : (m : ℚ) ≠ 0 := by have := S.hm0; positivity
  have hdimW : topologicalKrullDim W = ((n + 1 : ℕ) : WithBot ℕ∞) := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact S.hdimX
  have hdimW' : topologicalKrullDim W = n + 1 := by rw [hdimW]; norm_cast
  have hdWY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := q ≫ sY) hdimW
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) S.hdimX
  have hdY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hdW'Y := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := (r ≫ q) ≫ sY)
    (by
      haveI := S.hYp.toIsVariety
      haveI := hWY'.1
      rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sY ((r ≫ q) ≫ sY)
        hqb']
      exact S.hdimY)
  have hbr := hrb.functionFieldMap_bijective
  -- local generators near the centre
  set z := r F.genericPoint with hz
  obtain ⟨-, U₁, hU₁, ωX, hωX⟩ := MMP.Positivity.IsPair.exists_generatesOn S.hBp.isPair S.hKX
    S.hmX (p z)
  obtain ⟨-, V₁, hV₁, ωY, hωY⟩ := MMP.Positivity.IsPair.exists_generatesOn S.hCp.isPair S.hKY
    S.hmY (q z)
  -- the `Y`-side order along `F`
  let DY : DivisorOver ℂ sY := ⟨W', r ≫ q, hWY', hqb', F⟩
  have hY1 : IsDiscrepancy sY (n + 1) KY C DY ((DY.ordPullback ωY : ℚ) / m) := by
    refine ⟨S.hCp.isPair.1, S.hKY, m, S.hm0, S.hmY, V₁, hV₁, ωY, hωY, ?_⟩
    field_simp
  have hY2 := (hBW' F).eq hY1
  rw [eq_div_iff hm] at hY2
  -- the ratio of the two pull-backs on `W` is a unit at `z`
  set ωWY : RationalPluriForms (q ≫ sY) (n + 1) m := pullbackRationalPluriForms sY q ωY
  have hωWY0 : ωWY ≠ 0 :=
    pullbackRationalPluriForms_ne_zero q S.hqb.functionFieldMap_bijective hdY hωY.1
  obtain ⟨u, hu⟩ := exists_eq_smul_of_ne_zero hdimW' hωWY0
    (cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p ωX) :
      RationalPluriForms (q ≫ sY) (n + 1) m)
  have hωWX0 : pullbackRationalPluriForms sX p ωX ≠ 0 :=
    pullbackRationalPluriForms_ne_zero p S.hpb.functionFieldMap_bijective hd hωX.1
  have hu0 : u ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hu
    apply hωWX0
    have h' := congrArg (cast (show RationalPluriForms (q ≫ sY) (n + 1) m =
      RationalPluriForms (p ≫ sX) (n + 1) m by rw [S.hpq])) hu
    rw [cast_cast, cast_eq] at h'
    rw [h']
    simpa using cast_smul_rationalPluriForms S.hpq.symm (by rw [S.hpq]) (0 : ℂ)
      (0 : RationalPluriForms (q ≫ sY) (n + 1) m)
  have hord : ∀ G : Mori.PrimeDivisor W, z ∈ G.support → W.ord u G.genericPoint = 0 := by
    intro G hG
    have hsp : G.genericPoint ⤳ z := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hG
      exact specializes_iff_mem_closure.mpr hG
    have hGX : p G.genericPoint ∈ U₁ := (hsp.map p.continuous).mem_open U₁.isOpen hU₁
    have hGY : q G.genericPoint ∈ V₁ := (hsp.map q.continuous).mem_open V₁.isOpen hV₁
    have e1 := ordForm_pullback_of_generatesOn S G hGX hωX
    have e2 := ordForm_pullback_of_generatesOn S.swap G hGY hωY
    have e3 := ordForm_cast S.hpq G (pullbackRationalPluriForms sX p ωX) (by rw [S.hpq])
    rw [hu, G.ordForm_smul hdWY hu0 hωWY0] at e3
    have : ((W.ord u G.genericPoint + G.ordForm ωWY : ℤ) : ℚ) =
        (G.ordForm (pullbackRationalPluriForms sX p ωX) : ℚ) := by exact_mod_cast e3
    push_cast at this
    have : (W.ord u G.genericPoint : ℚ) = 0 := by linarith
    exact_mod_cast this
  obtain ⟨v, hv, hvu⟩ := exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero z hu0 hord
  have hru : W'.ord (functionFieldMap r u) F.genericPoint = 0 := by
    rw [← hvu, functionFieldMap_algebraMap_stalk]
    exact F.ord_algebraMap_of_isUnit (hv.map _)
  have hru0 : functionFieldMap r u ≠ 0 := (map_ne_zero _).mpr hu0
  -- comparison of the pull-backs to `W'`
  have hcomp : (cast (by simp only [Category.assoc, S.hpq])
      (pullbackRationalPluriForms sX (r ≫ p) ωX) : RationalPluriForms (r ≫ q ≫ sY) (n + 1) m) =
      functionFieldMap r u • pullbackRationalPluriForms (q ≫ sY) r ωWY := by
    rw [← pullbackRationalPluriForms_smul_functionField, ← hu,
      ← cast_pullbackRationalPluriForms S.hpq r _ (by rw [S.hpq]) (by rw [S.hpq]),
      pullbackRationalPluriForms_comp p r S.hpb.functionFieldMap_bijective hbr hd]
    rfl
  haveI : LocallyOfFiniteType (r ≫ q ≫ sY) := by
    rw [← Category.assoc]; exact hWY'.1.toLocallyOfFiniteType
  have hdW'Y' : (letI := functionFieldAlgebra (r ≫ q ≫ sY);
      (Algebra.trdeg ℂ W'.functionField).toNat) = n + 1 := hdW'Y
  have hpb0 : pullbackRationalPluriForms (q ≫ sY) r ωWY ≠ 0 :=
    pullbackRationalPluriForms_ne_zero r hbr hdWY hωWY0
  have hY3 : F.ordForm (sX := r ≫ q ≫ sY) (pullbackRationalPluriForms (q ≫ sY) r ωWY) =
      DY.ordPullback ωY := by
    change F.ordForm (sX := r ≫ q ≫ sY) (pullbackRationalPluriForms (q ≫ sY) r
      (pullbackRationalPluriForms sY q ωY)) = F.ordForm (pullbackRationalPluriForms sY (r ≫ q) ωY)
    rw [pullbackRationalPluriForms_comp q r S.hqb.functionFieldMap_bijective hbr hdY]
    rfl
  have e4 := ordForm_cast (show (r ≫ p) ≫ sX = r ≫ q ≫ sY by simp only [Category.assoc, S.hpq])
    F (pullbackRationalPluriForms sX (r ≫ p) ωX) (by simp only [Category.assoc, S.hpq])
  rw [hcomp, F.ordForm_smul hdW'Y' hru0 hpb0, hru, zero_add, hY3] at e4
  refine ⟨S.hBp.isPair.1, S.hKX, m, S.hm0, S.hmX, U₁, hU₁, ωX, hωX, ?_⟩
  change (m : ℚ) * -BW'.coeff F = (F.ordForm (pullbackRationalPluriForms sX (r ≫ p) ωX) : ℚ)
  rw [← e4, ← hY2]
  ring

/-- **A log resolution dominating the common model.** There is a proper birational morphism
`r : W' ⟶ W` from a normal variety such that `q ∘ r` is a log resolution of `(Y, C)`, together
with the crepant boundary on `W'`. By Chow's lemma over `Y`, `W` is dominated by a projective
model `W₁` of `Y`, a blow-up `Bl_J Y`; a log resolution of `(Y, C)` principalizing `J` factors
through it. -/
private theorem exists_isLogResolution_comp
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    ∃ (W' : Scheme.{0}) (_ : IsIntegral W') (_ : IsLocallyNoetherian W') (_ : IsNormal W')
      (r : W' ⟶ W) (_ : IsDominant r) (_ : IsProper r) (_ : IsBirationalMorphism r)
      (BW' : QDivisor W')
      (_ : Setting sX sY n B C KX KY (r ≫ p) (r ≫ q) BW' m CX jX BX CY jY BY),
      IsLogResolution sY C (r ≫ q) := by
  classical
  haveI hYv : AlgebraicGeometry.IsVariety ℂ sY := S.hYp.toIsVariety
  haveI : LocallyOfFiniteType sY := hYv.toLocallyOfFiniteType
  haveI : IsSeparated sY := hYv.toIsSeparated
  haveI : QuasiCompact sY := hYv.toQuasiCompact
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsNoetherian Y := ⟨⟩
  haveI : LocallyOfFiniteType (q ≫ sY) := S.hWY.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType q := LocallyOfFiniteType.of_comp (f := q) (g := sY) inferInstance
  have hYn : IsNormalVariety ℂ sY := S.hCp.isPair.1
  -- Chow's lemma over `Y`
  obtain ⟨W₁, π, U, hW₁, hπ, hUne, hπU, hqp⟩ := exists_isHQuasiProjective_comp q
  haveI := hW₁
  haveI := hπ
  haveI := hπU
  have ha : IsProjectiveMorphism (π ≫ q) :=
    isProjectiveMorphism_iff_isHQuasiProjective_and_isProper.mpr ⟨hqp, inferInstance⟩
  have hab : IsBirationalMorphism (π ≫ q) :=
    MMP.Mori.isBirationalMorphism_comp (isBirationalMorphism_of_isIso_morphismRestrict π U hUne)
      S.hqb
  haveI : IsQuasiProjectiveVariety ℂ sY := by
    rw [isQuasiProjectiveVariety_iff_isHQuasiProjective]
    refine ⟨hYv, ?_⟩
    obtain ⟨N, ιV, hιV, hιVs⟩ := S.hYp.isProjective
    exact ⟨N, ιV, inferInstance, inferInstance, hιVs⟩
  obtain ⟨J, hJ0, -, e, he⟩ := MMP.exists_blowUp_iso_of_isProjective_of_isBirational sY (π ≫ q)
    ha.isProjective (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hab)
  -- a log resolution of `(Y, C)` principalizing `J`, and its lift to `W`
  obtain ⟨W', f, hW'v, hfproj, hflog, hfJ⟩ :=
    exists_isLogResolution_isEffectiveCartierDivisor_comap sY hYv (QDivisor.toRDivisor C) J hJ0
  let h : W' ⟶ blowUp J := blowUpLift J f hfJ
  have hh : h ≫ blowUpToBase J = f := blowUpLift_comp J f hfJ
  set r : W' ⟶ W := h ≫ e.inv ≫ π with hrdef
  have hrq : r ≫ q = f := by
    rw [hrdef, Category.assoc, Category.assoc, ← hh, ← he, Iso.inv_hom_id_assoc]
  have hres : IsSmoothResolution sY f := hflog.toIsSmoothResolution
  obtain ⟨hW'n, -, -⟩ := hres.isNormalVariety hYn
  haveI : IsIntegral W' := hW'v.toIsIntegral
  haveI : LocallyOfFiniteType (f ≫ sY) := hW'v.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W' := LocallyOfFiniteType.isLocallyNoetherian (f ≫ sY)
  haveI : IsNormal W' := hW'n.2
  haveI : IsProper f := hres.isProper
  haveI : IsProper (r ≫ q) := by rw [hrq]; infer_instance
  haveI : LocallyOfFiniteType r := LocallyOfFiniteType.of_comp (f := r) (g := q) inferInstance
  haveI : IsProper r := IsProper.of_comp r q
  have hrb : IsBirationalMorphism r :=
    isBirationalMorphism_of_comp r q S.hqb (hrq ▸ hres.isBirationalMorphism)
  haveI : IsDominant r := hrb.isDominant
  have hfH : IsProjectiveMorphism f := by
    have h1 : IsProjective (f ≫ sY) := hfproj.comp S.hYp.isProjective.isProjective
    exact IsProjectiveMorphism.of_comp f sY (isProjectiveMorphism_of_isProjective_of_isAffine _ h1)
  have hlog : IsLogResolution sY C (r ≫ q) := by rw [hrq]; exact ⟨hflog, hfH⟩
  -- the setting on `W'`
  have hpq' : (r ≫ p) ≫ sX = (r ≫ q) ≫ sY := by
    simp only [Category.assoc, S.hpq]
  have hWY' : IsNormalVariety ℂ ((r ≫ q) ≫ sY) := by rw [hrq]; exact hW'n
  have hWX' : IsNormalVariety ℂ ((r ≫ p) ≫ sX) := by rw [hpq']; exact hWY'
  have hpb' : IsBirationalMorphism (r ≫ p) := MMP.Mori.isBirationalMorphism_comp hrb S.hpb
  have hqb' : IsBirationalMorphism (r ≫ q) := MMP.Mori.isBirationalMorphism_comp hrb S.hqb
  obtain ⟨BW', hBWY'⟩ :=
    (S.hCp.isPair.existsUnique_isCrepantBoundary S.hKY (r ≫ q) hWY' hqb').1.exists
  have hBWX' := isCrepantBoundary_comp S r hrb hWX' hWY' hpb' hqb' hBWY'
  exact ⟨W', inferInstance, inferInstance, inferInstance, r, inferInstance, inferInstance, hrb,
    BW', ⟨S.hn, S.hXp, S.hYp, S.hdimX, S.hdimY, S.hQX, S.hQY, S.hBp, S.hCp, S.hB, S.hC, S.hKX,
      S.hKY, hpq', hpb', hqb', hWX', hWY', hBWX', hBWY', S.hm, S.hm0, S.hmX, S.hmY, S.hjX,
      S.hjY⟩, hlog⟩

/-- **Local descent on a log resolution.** If `q` is a log resolution of `(Y, C)`, a floor
section of `X` has a local descent near every point of `Y`: the functions `τ_x / q^*ω_y` on the
coefficient-one locus `T` of `B_W` glue, descend to the floor of `Y` (`q_* 𝒪_T = 𝒪_{⌊C⌋}`), and
lift to a function `f` near `y`; `τ' = f ω_y`. -/
private theorem exists_isLocalDescentOrd_of_isLogResolution
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (hlog : IsLogResolution sY C q)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (ht : IsFloorSection sX n m B jX BX t) (y : Y) :
    ∃ (U' : Y.Opens) (_ : y ∈ U') (τ' : RationalPluriForms sY (n + 1) m),
      τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U' ∧
      IsLocalDescentOrd S t U' τ' := by
  classical
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hm0 := S.hm0
  have hdimW : topologicalKrullDim W = ((n + 1 : ℕ) : WithBot ℕ∞) := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact S.hdimX
  have hdimW' : topologicalKrullDim W = n + 1 := by rw [hdimW]; norm_cast
  have hdY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hdWY := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := q ≫ sY) hdimW
  -- a local generator `ω` of `𝒪_Y(m(K_Y + C))` on an affine open `V ∋ y`
  obtain ⟨-, V₀, hyV₀, ω, hω₀⟩ := MMP.Positivity.IsPair.exists_generatesOn S.hCp.isPair S.hKY
    S.hmY y
  obtain ⟨_, ⟨V, hVaff, rfl⟩, hyV, hVV₀⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open hyV₀ V₀.isOpen
  have hω : GeneratesOn C m V ω := hω₀.mono hVV₀
  set ωW : RationalPluriForms (q ≫ sY) (n + 1) m := pullbackRationalPluriForms sY q ω with hωWdef
  have hωW0 : ωW ≠ 0 :=
    pullbackRationalPluriForms_ne_zero q S.hqb.functionFieldMap_bijective hdY hω.1
  have hωWord : ∀ F : Mori.PrimeDivisor W, q F.genericPoint ∈ V →
      (F.ordForm ωW : ℚ) = -(m : ℚ) * BW.coeff F :=
    fun F hF => ordForm_pullback_of_generatesOn S.swap F hF hω
  -- local presentations of `t` and their ratios to `q^*ω`
  choose U hxU τ hτ using ht
  have hratio : ∀ x, ∃ c : W.functionField,
      (cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p (τ x)) :
        RationalPluriForms (q ≫ sY) (n + 1) m) = c • ωW :=
    fun x => exists_eq_smul_of_ne_zero hdimW' hωW0 _
  choose h hh using hratio
  let O : X → W.Opens := fun x => p ⁻¹ᵁ U x ⊓ q ⁻¹ᵁ V
  -- `h x` is regular on `O x`
  have hreg : ∀ x, ∀ Γ : Mori.PrimeDivisor W, (Γ.support ∩ (O x : Set W)).Nonempty →
      0 ≤ W.ord (h x) Γ.genericPoint := by
    intro x Γ hΓ
    have hηΓ : Γ.genericPoint ∈ O x := (Γ.genericPoint_mem_iff (O x)).mpr hΓ
    by_cases h0 : h x = 0
    · rw [h0, Scheme.ord_zero]; rfl
    have hτ0 : τ x ≠ 0 := by
      rintro hτ0
      apply h0
      have e := hh x
      rw [hτ0] at e
      have hp0 : pullbackRationalPluriForms sX p (0 : RationalPluriForms sX (n + 1) m) = 0 := by
        simpa using pullbackRationalPluriForms_smul p (0 : ℂ) (0 : RationalPluriForms sX (n + 1) m)
      rw [hp0] at e
      have e' : (cast (by rw [S.hpq]) (0 : RationalPluriForms (p ≫ sX) (n + 1) m) :
          RationalPluriForms (q ≫ sY) (n + 1) m) = 0 := by
        have := cast_smul_rationalPluriForms S.hpq (by rw [S.hpq]) (0 : ℂ)
          (0 : RationalPluriForms (p ≫ sX) (n + 1) m)
        simpa using this
      rw [e'] at e
      exact (smul_eq_zero.mp e.symm).resolve_right hωW0
    have e1 := le_ordForm_pullback_of_mem S Γ hηΓ.1 (hτ x).1 hτ0
    have e2 := hωWord Γ hηΓ.2
    have e3 := ordForm_cast S.hpq Γ (pullbackRationalPluriForms sX p (τ x)) (by rw [S.hpq])
    rw [hh x, Γ.ordForm_smul hdWY h0 hωW0] at e3
    have : (0 : ℚ) ≤ W.ord (h x) Γ.genericPoint := by
      have e3' : ((W.ord (h x) Γ.genericPoint + Γ.ordForm ωW : ℤ) : ℚ) =
          (Γ.ordForm (pullbackRationalPluriForms sX p (τ x)) : ℚ) := by exact_mod_cast e3
      push_cast at e3'
      linarith
    exact_mod_cast this
  -- sections `s x` of `𝒪_W` on `O x` with `s x = h x`
  have hsec : ∀ x, ∃ g : Γ(W, O x), ∀ (z : W) (hz : z ∈ O x),
      algebraMap (W.presheaf.stalk z) W.functionField (W.presheaf.germ (O x) z hz g) = h x := by
    intro x
    by_cases hne : Nonempty (O x)
    · obtain ⟨g, hg⟩ :=
        MMP.Threefold.Bridges.exists_germToFunctionField_eq_of_forall_zero_le_ord (O x) (h x)
          (hreg x)
      exact ⟨g, fun z hz => by rw [Scheme.algebraMap_germ_eq_germToFunctionField W hz g, hg]⟩
    · exact ⟨0, fun z hz => (hne ⟨⟨z, hz⟩⟩).elim⟩
  choose sx hsx using hsec
  -- the reduced floor of `Y` and the reduced coefficient-one locus of `B_W`
  set Tdiv : Divisor W := coeffOnePart BW with hTdiv
  have hT : ∀ F, Tdiv.coeff F = if BW.coeff F = 1 then 1 else 0 := coeff_coeffOnePart BW
  have hTmem : ∀ F, F ∈ Tdiv.support ↔ BW.coeff F = 1 := by
    intro F
    rw [Finsupp.mem_support_iff]
    change Tdiv.coeff F ≠ 0 ↔ _
    rw [hT]
    split_ifs with h1 <;> simp [h1]
  have hΓ : ∀ F, (BW - Divisor.toQDivisor Tdiv).coeff F < 1 := by
    intro F
    rw [DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, hT]
    have hle := coeff_le_one_of_setting S.swap F
    split_ifs with h1
    · rw [h1]; norm_num
    · push_cast
      exact lt_of_le_of_ne (by linarith) (by simpa using h1)
  let ZS : TopologicalSpace.Closeds Y := ⟨⋃ P ∈ C.roundDown.support, (P.support : Set Y),
    (Finset.finite_toSet _).isClosed_biUnion fun P _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure⟩
  let ZT : TopologicalSpace.Closeds W := ⟨⋃ F ∈ Tdiv.support, (F.support : Set W),
    (Finset.finite_toSet _).isClosed_biUnion fun F _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure⟩
  let ιS := (Scheme.IdealSheafData.vanishingIdeal ZS).subschemeι
  let ιT := (Scheme.IdealSheafData.vanishingIdeal ZT).subschemeι
  have hSr : Set.range ιS.base = ⋃ P ∈ C.roundDown.support, (P.support : Set Y) := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hTr : Set.range ιT.base = ⋃ F ∈ Tdiv.support, (F.support : Set W) := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hTr' : Set.range ιT.base = ⋃ F ∈ {F : Mori.PrimeDivisor W | BW.coeff F = 1},
      (F.support : Set W) := by
    rw [hTr]
    ext w
    simp only [Set.mem_iUnion, Finset.mem_coe, Set.mem_setOf_eq, hTmem]
  obtain ⟨-, -, ⟨q', hq'⟩, hiso⟩ :=
    hlog.bijOn_idealSheaf_divisorialSubmodule_and_pushforward_floor S.hdimY S.hKY S.hYp S.hQY
      S.hC ⟨S.hWY, S.hBWY⟩ hT hΓ ιS ιT hSr hTr
  have happ := (hiso q' hq').1
  -- two presentations differ along the coefficient-one primes by a function of order `≥ 1`
  have hdiff : ∀ x x' (F : Mori.PrimeDivisor W), BW.coeff F = 1 →
      F.genericPoint ∈ O x ⊓ O x' → h x - h x' = 0 ∨ 1 ≤ W.ord (h x - h x') F.genericPoint := by
    intro x x' F hF hFO
    by_cases h0 : h x - h x' = 0
    · exact Or.inl h0
    right
    have hne : U x' ⊓ U x ≠ ⊥ := fun hb => by
      have : p F.genericPoint ∈ U x' ⊓ U x := ⟨hFO.2.1, hFO.1.1⟩
      rw [hb] at this
      exact this
    have hP := Presents.sub S (hτ x') (hτ x) hne
    let F' := F.idealSheaf.subscheme
    haveI : IsIntegral F' := F.integral
    let jF : F' ⟶ W := F.idealSheaf.subschemeι
    have hrangeF : Set.range jF.base = (F.support : Set W) := F.idealSheaf.range_subschemeι
    have hFgen : jF (genericPoint F') = F.genericPoint := map_genericPoint_eq_of_range_eq hrangeF
    have hres := isPoincareResidue_pullback_zero_of_presents_zero S hP F hF jF inferInstance
      hrangeF (by change p (jF (genericPoint F')) ∈ U x' ⊓ U x; rw [hFgen]; exact ⟨hFO.2.1, hFO.1.1⟩)
    have e : (cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p (τ x - τ x')) :
        RationalPluriForms (q ≫ sY) (n + 1) m) = (h x - h x') • ωW := by
      rw [pullbackRationalPluriForms_sub, cast_sub_rationalPluriForms S.hpq, hh, hh, sub_smul]
    have hτd0 : pullbackRationalPluriForms sX p (τ x - τ x') ≠ 0 := by
      intro hz
      have e' := e
      rw [hz] at e'
      have : (cast (by rw [S.hpq]) (0 : RationalPluriForms (p ≫ sX) (n + 1) m) :
          RationalPluriForms (q ≫ sY) (n + 1) m) = 0 := by
        simpa using cast_smul_rationalPluriForms S.hpq (by rw [S.hpq]) (0 : ℂ)
          (0 : RationalPluriForms (p ≫ sX) (n + 1) m)
      rw [this] at e'
      exact h0 ((smul_eq_zero.mp e'.symm).resolve_right hωW0)
    have hord := le_ordForm_of_isPoincareResidue_zero F hFgen hdimW' hτd0 hres
    have e3 := ordForm_cast S.hpq F (pullbackRationalPluriForms sX p (τ x - τ x')) (by rw [S.hpq])
    rw [e, F.ordForm_smul hdWY h0 hωW0] at e3
    have e2 := hωWord F hFO.1.2
    rw [hF, mul_one] at e2
    have e2' : F.ordForm ωW = -(m : ℤ) := by exact_mod_cast e2
    omega
  -- hence the germ of `s x - s x'` along a coefficient-one prime is not a unit
  have hnonunit : ∀ {Oo : W.Opens} (g : Γ(W, Oo)) (c : W.functionField)
      (hg : ∀ (z : W) (hz : z ∈ Oo),
        algebraMap (W.presheaf.stalk z) W.functionField (W.presheaf.germ Oo z hz g) = c)
      (F : Mori.PrimeDivisor W) (hFO : F.genericPoint ∈ Oo),
      (c = 0 ∨ 1 ≤ W.ord c F.genericPoint) → ¬ IsUnit (W.presheaf.germ Oo F.genericPoint hFO g) := by
    intro Oo g c hg F hFO hc hu
    have h1 := ord_algebraMap_eq_zero_of_isUnit' F rfl hu
    rw [hg] at h1
    rcases hc with hc | hc
    · have := hu.map (algebraMap (W.presheaf.stalk F.genericPoint) W.functionField)
      rw [hg, hc] at this
      exact not_isUnit_zero this
    · omega
  -- the local functions `s x|_T` glue on `T ∩ q⁻¹(V)`
  let Ut : X → (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.Opens := fun x => ιT ⁻¹ᵁ O x
  let Vt := q' ⁻¹ᵁ (ιS ⁻¹ᵁ V)
  have hVt : ∀ w, w ∈ Vt ↔ q (ιT w) ∈ V := fun w => by
    change (q' ≫ ιS) w ∈ V ↔ (ιT ≫ q) w ∈ V
    rw [hq']
  have iUV : ∀ x, Ut x ⟶ Vt := fun x => homOfLE fun w hw => (hVt w).mpr hw.2
  have hcover : Vt ≤ iSup Ut := fun w hw =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨p (ιT w), hxU _, (hVt w).mp hw⟩
  have hcompat : TopCat.Presheaf.IsCompatible
      (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.sheaf.obj Ut fun x => ιT.app (O x) (sx x) := by
    intro x x'
    have hA : Ut x ⊓ Ut x' = ιT ⁻¹ᵁ (O x ⊓ O x') := TopologicalSpace.Opens.ext rfl
    change (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.presheaf.map
        (TopologicalSpace.Opens.infLELeft (Ut x) (Ut x')).op (ιT.app (O x) (sx x)) =
      (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.presheaf.map
        (TopologicalSpace.Opens.infLERight (Ut x) (Ut x')).op (ιT.app (O x') (sx x'))
    rw [app_map_eq ιT inf_le_left _ hA, app_map_eq ιT inf_le_right _ hA, ← sub_eq_zero,
      ← map_sub, ← map_sub]
    convert map_zero ((Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.presheaf.map
      (eqToHom hA).op).hom
    refine (app_eq_zero_iff_of_range ιT hTr' _).mpr fun F hF hFO => ?_
    refine hnonunit _ (h x - h x') (fun z hz => ?_) F hFO (hdiff x x' F hF hFO)
    rw [map_sub, map_sub, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
      hsx, hsx]
  obtain ⟨φ, hφ, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.sheaf Ut Vt iUV hcover _ hcompat
  -- descent to the floor of `Y` and lift to `Y`
  haveI := happ (ιS ⁻¹ᵁ V)
  set ψ := (inv (q'.app (ιS ⁻¹ᵁ V))) φ with hψdef
  have hψ : q'.app (ιS ⁻¹ᵁ V) ψ = φ := by
    rw [hψdef]
    exact CategoryTheory.IsIso.inv_hom_id_apply (q'.app (ιS ⁻¹ᵁ V)) φ
  obtain ⟨f, hf⟩ := ιS.app_surjective V hVaff ψ
  -- `q^*f` restricts on `T ∩ O x` to `s x|_T`
  have hkey : ∀ x, ιT.app (O x) (W.presheaf.map
      (homOfLE (inf_le_right : O x ≤ q ⁻¹ᵁ V)).op (q.app V f)) = ιT.app (O x) (sx x) := by
    intro x
    have hpre : (q' ≫ ιS) ⁻¹ᵁ V = (ιT ≫ q) ⁻¹ᵁ V := by rw [hq']
    have e : q'.app (ιS ⁻¹ᵁ V) (ιS.app V f) =
        (Scheme.IdealSheafData.vanishingIdeal ZT).subscheme.presheaf.map (eqToHom hpre).op
          (ιT.app (q ⁻¹ᵁ V) (q.app V f)) :=
      ConcreteCategory.congr_hom (Scheme.Hom.congr_app hq' V) f
    rw [← hφ x, ← hψ, ← hf, e]
    exact (app_map_map_eq ιT (inf_le_right : O x ≤ q ⁻¹ᵁ V) (iUV x) (eqToHom hpre)
      (q.app V f)).symm
  haveI : Nonempty V := ⟨⟨y, hyV⟩⟩
  set c := Y.germToFunctionField V f with hcdef
  have hVne : V ≠ ⊥ := fun hb => by
    have : y ∈ V := hyV
    rw [hb] at this
    exact this
  refine ⟨V, hyV, c • ω, ?_, ?_⟩
  · rw [mem_pluricanonicalSections_of_ne_bot hVne]
    intro Γ hΓ hτ0
    have hc0 : c ≠ 0 := fun h0 => hτ0 (by rw [h0, zero_smul])
    rw [Γ.ordForm_smul hdY hc0 hω.1]
    have e1 := hω.2 Γ hΓ
    have hηΓ : Γ.genericPoint ∈ V := (Γ.genericPoint_mem_iff V).mpr hΓ
    have hcord : 0 ≤ Y.ord c Γ.genericPoint := by
      rw [hcdef, ← Scheme.algebraMap_germ_eq_germToFunctionField Y hηΓ f]
      exact ord_algebraMap_nonneg Γ _
    have e2 := coeff_roundDown_eq S.swap Γ
    have : (0 : ℚ) ≤ (Y.ord c Γ.genericPoint : ℚ) + (Γ.ordForm ω : ℚ) +
        ((DivisorWithCoeffs.roundDown ((m : ℤ) • C)).coeff Γ : ℚ) := by
      rw [e2]
      have : (0 : ℚ) ≤ Y.ord c Γ.genericPoint := by exact_mod_cast hcord
      linarith
    exact_mod_cast this
  · intro E hE hqE
    refine ⟨U (p E.genericPoint), τ (p E.genericPoint), hτ _, hxU _, ?_⟩
    have hEO : E.genericPoint ∈ O (p E.genericPoint) := ⟨hxU _, hqE⟩
    rw [pullbackRationalPluriForms_smul_functionField, hh (p E.genericPoint), ← sub_smul]
    by_cases hc' : functionFieldMap q c - h (p E.genericPoint) = 0
    · rw [hc', zero_smul, PrimeDivisor.ordForm_zero]
      omega
    rw [E.ordForm_smul hdWY hc' hωW0]
    have e2 := hωWord E hqE
    rw [hE, mul_one] at e2
    have e2' : E.ordForm ωW = -(m : ℤ) := by exact_mod_cast e2
    set g : Γ(W, O (p E.genericPoint)) := W.presheaf.map
      (homOfLE (inf_le_right : O (p E.genericPoint) ≤ q ⁻¹ᵁ V)).op (q.app V f) -
        sx (p E.genericPoint) with hgdef
    have hg0 : ιT.app (O (p E.genericPoint)) g = 0 := by
      rw [hgdef, map_sub, hkey, sub_self]
    have hgerm : algebraMap _ W.functionField
        (W.presheaf.germ (O (p E.genericPoint)) E.genericPoint hEO g) =
          functionFieldMap q c - h (p E.genericPoint) := by
      have hst : W.presheaf.germ (q ⁻¹ᵁ V) E.genericPoint hqE (q.app V f) =
          q.stalkMap E.genericPoint (Y.presheaf.germ V (q E.genericPoint) hqE f) :=
        (q.germ_stalkMap_apply V E.genericPoint hqE f).symm
      rw [hgdef, map_sub, map_sub, TopCat.Presheaf.germ_res_apply, hsx, hst,
        ← functionFieldMap_algebraMap_stalk, Scheme.algebraMap_germ_eq_germToFunctionField Y]
    have hnu := (app_eq_zero_iff_of_range ιT hTr' g).mp hg0 E hE hEO
    have hmem : W.presheaf.germ (O (p E.genericPoint)) E.genericPoint hEO g ∈
        IsLocalRing.maximalIdeal _ := (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have h1 := one_le_ord_algebraMap_of_mem_maximalIdeal E (by rw [hgerm]; exact hc') hmem
    rw [hgerm] at h1
    omega

/-- **Local descent.** A floor section of `X` has a local descent near every point of `Y`. -/
private theorem exists_isLocalDescent (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (ht : IsFloorSection sX n m B jX BX t) (y : Y) :
    ∃ (U' : Y.Opens) (_ : y ∈ U') (τ' : RationalPluriForms sY (n + 1) m),
      τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U' ∧
      IsLocalDescent S t U' τ' := by
  obtain ⟨W', _, _, _, r, _, _, hrb, BW', S', hlog⟩ := exists_isLogResolution_comp S
  obtain ⟨U', hy, τ', hτ', hd⟩ := exists_isLocalDescentOrd_of_isLogResolution S' hlog ht y
  exact ⟨U', hy, τ', hτ', (hd.of_comp S r hrb S').isLocalDescent S⟩

/-- A local section of `𝒪_Y(mK_Y + ⌊mC⌋)` has a Poincaré residue along every floor component
of `Y` meeting its domain. -/
private theorem exists_isPoincareResidue_of_mem
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {U' : Y.Opens}
    {τ' : RationalPluriForms sY (n + 1) m}
    (hτ' : τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U')
    (hQ : (jY Q).base (genericPoint (CY Q)) ∈ U') :
    ∃ ρ : RationalPluriForms (jY Q ≫ sY) n m, IsPoincareResidue sY (jY Q) n m τ' ρ := by
  haveI := S.hYp.toLocallyOfFiniteType
  obtain ⟨Q', hQ', hQci⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hQci
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans (map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2))
  subst hQQ'
  by_cases hτ0 : τ' = 0
  · subst hτ0
    exact ⟨0, isPoincareResidue_zero_of_isClosedImmersion Q.1 hQ'⟩
  have hdY : topologicalKrullDim Y = n + 1 := by exact_mod_cast S.hdimY
  let := functionFieldAlgebra sY
  obtain ⟨ϖ, y, hϖ, hfr⟩ := exists_logFrame_of_eq_genericPoint (sY := sY) Q.1 hQ' hdY
  obtain ⟨hord, hne, -⟩ := hfr m
  obtain ⟨c, rfl⟩ := exists_eq_smul_of_ne_zero hdY hne τ'
  have hc0 : c ≠ 0 := fun h0 => hτ0 (by rw [h0, zero_smul])
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hC1 : C.coeff Q.1 = 1 := (exists_strictTransform_floor S Q).choose_spec.2.2.2
  have hmem : (Q.1.support ∩ U').Nonempty := by
    refine ⟨Q.1.genericPoint, ?_, ?_⟩
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    · change (jY Q) (genericPoint (CY Q)) ∈ U' at hQ
      rwa [hQ'] at hQ
  have hb := hτ'.2 Q.1 hmem hτ0
  rw [Q.1.ordForm_smul hd hc0 hne, hord, DivisorWithCoeffs.coeff_roundDown,
    DivisorWithCoeffs.coeff_smul, hC1] at hb
  simp only [zsmul_eq_mul, Int.cast_natCast, mul_one, Int.floor_natCast] at hb
  have hcord : 0 ≤ Y.ord c ((jY Q) (genericPoint (CY Q))) := by rw [hQ']; omega
  obtain ⟨a, rfl⟩ := exists_algebraMap_eq_of_ord_nonneg' Q.1 hQ' hc0 hcord
  exact ⟨_, IsPoincareResidue.algebraMap_smul'
    (isPoincareResidue_logFrame (sY := sY) (j := jY Q) hϖ y m) a⟩

/-- **Consistency of local descents.** Two local descents of the same floor section have the same
residue along every floor component of `Y` meeting both domains. -/
private theorem eq_of_isLocalDescent (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {U₁ U₂ : Y.Opens}
    {τ₁ τ₂ : RationalPluriForms sY (n + 1) m} (h₁ : IsLocalDescent S t U₁ τ₁)
    (h₂ : IsLocalDescent S t U₂ τ₂) (hy₁ : (jY Q).base (genericPoint (CY Q)) ∈ U₁)
    (hy₂ : (jY Q).base (genericPoint (CY Q)) ∈ U₂) {ρ₁ ρ₂ : RationalPluriForms (jY Q ≫ sY) n m}
    (hρ₁ : IsPoincareResidue sY (jY Q) n m τ₁ ρ₁) (hρ₂ : IsPoincareResidue sY (jY Q) n m τ₂ ρ₂) :
    ρ₁ = ρ₂ := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hm0 := S.hm0
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  have hdY : topologicalKrullDim Y = n + 1 := by exact_mod_cast S.hdimY
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  obtain ⟨E, hqE, hiso, hE, -⟩ := exists_strictTransform_floor S Q
  let E' := E.idealSheaf.subscheme
  haveI : IsIntegral E' := E.integral
  let jE : E' ⟶ W := E.idealSheaf.subschemeι
  have hrange : Set.range jE.base = (E.support : Set W) := E.idealSheaf.range_subschemeι
  have hEgen : jE (genericPoint E') = E.genericPoint := map_genericPoint_eq_of_range_eq hrange
  have hQgen : (jY Q) (genericPoint (CY Q)) = Q.1.genericPoint :=
    map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2
  have hqη : q.base (jE.base (genericPoint E')) = (jY Q).base (genericPoint (CY Q)) := by
    change q (jE (genericPoint E')) = (jY Q) (genericPoint (CY Q))
    rw [hEgen, hqE, hQgen]
  obtain ⟨Ua, τa, hτa, hxa, ρa, hρa, hρa'⟩ :=
    h₁ E hE jE inferInstance hrange (hqη ▸ hy₁)
  obtain ⟨Ub, τb, hτb, hxb, ρb, hρb, hρb'⟩ :=
    h₂ E hE jE inferInstance hrange (hqη ▸ hy₂)
  have hρab := isPoincareResidue_pullback_of_presents S hτa hτb E hE jE inferInstance hrange
    hxa hxb hρa
  have hρ : ρa = ρb := IsPoincareResidue.unique_of_isClosedImmersion E hEgen hρab hρb
  subst hρ
  have hδE : IsPoincareResidue (q ≫ sY) jE n m
      (pullbackRationalPluriForms sY q (τ₁ - τ₂)) 0 := by
    have h := IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW hρa'
      (IsPoincareResidue.const_smul hρb' (-1))
    rw [neg_one_smul, neg_one_smul, add_neg_cancel, ← sub_eq_add_neg,
      ← pullbackRationalPluriForms_sub] at h
    exact h
  have hordE : 1 - (m : ℤ) ≤ E.ordForm (pullbackRationalPluriForms sY q (τ₁ - τ₂)) := by
    by_cases h0 : pullbackRationalPluriForms sY q (τ₁ - τ₂) = 0
    · rw [h0, PrimeDivisor.ordForm_zero]; omega
    exact le_ordForm_of_isPoincareResidue_zero E hEgen hdimW h0 hδE
  rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso q S.hqb.functionFieldMap_bijective
    hd E Q.1 hqE] at hordE
  obtain ⟨Q', hQ', hQci⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hQci
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans hQgen)
  subst hQQ'
  have hres0 := isPoincareResidue_zero_of_le_ordForm Q.1 hQ' hdY hordE
  have hres := IsPoincareResidue.add_of_isClosedImmersion Q.1 hQ' hdY hρ₁
    (IsPoincareResidue.const_smul hρ₂ (-1))
  rw [neg_one_smul, neg_one_smul, ← sub_eq_add_neg, ← sub_eq_add_neg] at hres
  exact sub_eq_zero.mp (IsPoincareResidue.unique_of_isClosedImmersion Q.1 hQ' hres hres0)

/-- **Adjunction for residues.** A rational form on a floor component `Q` of `Y` which near every
point of `Q` is the Poincaré residue of a local section of `𝒪_Y(mK_Y + ⌊mC⌋)` is a section of
`m(K_Q + C_Q)`. -/
private theorem mem_logPluricanonicalSections_of_isPoincareResidue
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {ρ : RationalPluriForms (jY Q ≫ sY) n m}
    (h : ∀ y ∈ Set.range (jY Q).base, ∃ (U' : Y.Opens) (_ : y ∈ U')
      (τ' : RationalPluriForms sY (n + 1) m),
      τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U' ∧
      IsPoincareResidue sY (jY Q) n m τ' ρ) :
    ρ ∈ logPluricanonicalSections (jY Q ≫ sY) n m (BY Q) := by
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  obtain ⟨-, -, hci⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hci
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q)
  obtain ⟨M, rfl⟩ : ∃ M, m = M + 1 := ⟨m - 1, by have := S.hm0; omega⟩
  have hne : (⊤ : (CY Q).Opens) ≠ ⊥ := by
    intro h0
    have : genericPoint (CY Q) ∈ (⊤ : (CY Q).Opens) := trivial
    rw [h0] at this
    exact this
  rw [mem_logPluricanonicalSections, mem_pluricanonicalSections_of_ne_bot hne]
  intro Γ _ hρ0
  obtain ⟨U', hyU', τ', hτ', hres⟩ := h ((jY Q).base Γ.genericPoint) ⟨_, rfl⟩
  exact le_ordForm_add_roundDown_of_isPoincareResidue S.hCp.isPair.1 S.hdimY S.hKY S.hmY
    (S.hjY Q).1 Q.1 (S.hjY Q).2 Γ hyU' hτ' hres hρ0

/-- **Existence.** Every floor section of `X` is pinned to a floor section of `Y`. -/
private theorem exists_pins (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    (ht : IsFloorSection sX n m B jX BX t) :
    ∃ t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q),
      IsFloorSection sY n m C jY BY t' ∧ Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t' := by
  choose U' hyU' τ' hτ' hdesc using exists_isLocalDescent S ht
  choose ρ hρ using fun Q => exists_isPoincareResidue_of_mem S Q
    (hτ' ((jY Q).base (genericPoint (CY Q)))) (hyU' _)
  have hcons : ∀ Q {V : Y.Opens} {σ' : RationalPluriForms sY (n + 1) m},
      σ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) V →
      IsLocalDescent S t V σ' → (jY Q).base (genericPoint (CY Q)) ∈ V →
      IsPoincareResidue sY (jY Q) n m σ' (ρ Q) := by
    intro Q V σ' hσ' hd hV
    obtain ⟨ρ', hρ'⟩ := exists_isPoincareResidue_of_mem S Q hσ' hV
    rwa [eq_of_isLocalDescent S Q hd (hdesc _) hV (hyU' _) hρ' (hρ Q)] at hρ'
  have hmem : ∀ Q, ρ Q ∈ logPluricanonicalSections (jY Q ≫ sY) n m (BY Q) := by
    intro Q
    refine mem_logPluricanonicalSections_of_isPoincareResidue S Q fun y hy => ?_
    obtain ⟨z, rfl⟩ := hy
    refine ⟨U' _, hyU' _, τ' _, hτ' _, hcons Q (hτ' _) (hdesc _) ?_⟩
    have hz : genericPoint (CY Q) ⤳ z := (genericPoint_spec (CY Q)).specializes trivial
    exact (hz.map (jY Q).continuous).mem_open (U' _).isOpen (hyU' _)
  refine ⟨fun Q => ⟨ρ Q, hmem Q⟩, fun y => ⟨U' y, hyU' y, τ' y, hτ' y,
    fun Q hQ => hcons Q (hτ' y) (hdesc y) hQ⟩, Pins.of_exists S fun E hE E' _ jE hjE hrange => ?_⟩
  obtain ⟨U, τ, hτ, hU, ρE, h₁, h₂⟩ :=
    hdesc (q.base (jE.base (genericPoint E'))) E hE jE hjE hrange (hyU' _)
  exact ⟨U, τ, hτ, hU, U' _, τ' _, ⟨hτ' _, fun Q hQ => hcons Q (hτ' _) (hdesc _) hQ⟩, hyU' _,
    ρE, h₁, h₂⟩

/-- **Pinned sections are local descents.** If the floor sections `t` of `X` and `t'` of `Y` are
pinned, every local presentation of `t'` is a local descent of `t`. -/
private theorem Pins.isLocalDescentOrd (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    {U' : Y.Opens} {τ' : RationalPluriForms sY (n + 1) m}
    (hτ' : Presents sY n m C jY BY t' U' τ') : IsLocalDescentOrd S t U' τ' := by
  intro E hE hqE
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hm0 := S.hm0
  have hdimW : topologicalKrullDim W = n + 1 := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact_mod_cast S.hdimX
  let E' := E.idealSheaf.subscheme
  haveI : IsIntegral E' := E.integral
  let jE : E' ⟶ W := E.idealSheaf.subschemeι
  have hrange : Set.range jE.base = (E.support : Set W) := E.idealSheaf.range_subschemeι
  have hEgen : jE (genericPoint E') = E.genericPoint := map_genericPoint_eq_of_range_eq hrange
  obtain ⟨U, hxU, τ, hτ⟩ := ht (p E.genericPoint)
  have hxU' : p.base (jE.base (genericPoint E')) ∈ U := by
    change p (jE (genericPoint E')) ∈ U
    rw [hEgen]
    exact hxU
  have hyU' : q.base (jE.base (genericPoint E')) ∈ U' := by
    change q (jE (genericPoint E')) ∈ U'
    rw [hEgen]
    exact hqE
  obtain ⟨ρ, h₁, h₂⟩ := h U τ hτ U' τ' hτ' E hE jE inferInstance hrange hxU' hyU'
  refine ⟨U, τ, hτ, hxU, ?_⟩
  have hc := IsPoincareResidue.cast_structure S.hpq h₁ (by rw [S.hpq]) (by rw [S.hpq])
  have h0 := IsPoincareResidue.add_of_isClosedImmersion E hEgen hdimW h₂
    (IsPoincareResidue.const_smul hc (-1))
  rw [neg_one_smul, neg_one_smul, add_neg_cancel, ← sub_eq_add_neg] at h0
  by_cases hδ : pullbackRationalPluriForms sY q τ' -
      cast (by rw [S.hpq]) (pullbackRationalPluriForms sX p τ) = 0
  · rw [hδ, PrimeDivisor.ordForm_zero]
    omega
  exact le_ordForm_of_isPoincareResidue_zero E hEgen hdimW hδ h0

/-- **Pins on a model dominating the common model.** If `r : W' ⟶ W` is proper birational and the
setting holds on `W'`, floor sections pinned through `W` are pinned through `W'`. -/
private theorem Pins.of_comp (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {W' : Scheme.{0}} [IsIntegral W'] [IsLocallyNoetherian W'] [IsNormal W'] (r : W' ⟶ W)
    [IsDominant r] [IsProper r] (hrb : IsBirationalMorphism r) {BW' : QDivisor W'}
    (S' : Setting sX sY n B C KX KY (r ≫ p) (r ≫ q) BW' m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t') :
    Pins sX sY n B C (r ≫ p) (r ≫ q) S'.hpq BW' m jX BX jY BY t t' := by
  obtain ⟨t'', ht'', h''⟩ := exists_pins S' ht
  have hdown : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t'' := by
    refine Pins.of_exists S fun E hE E' _ jE hjE hrange => ?_
    obtain ⟨U', hy, τ'', hτ''⟩ := ht'' (q.base (jE.base (genericPoint E')))
    have hd := ((Pins.isLocalDescentOrd S' ht h'' hτ'').of_comp S r hrb S').isLocalDescent S
    obtain ⟨U, τ, hτ, hU, ρ, h₁, h₂⟩ := hd E hE jE hjE hrange hy
    exact ⟨U, τ, hτ, hU, U', τ'', hτ'', hy, ρ, h₁, h₂⟩
  obtain rfl := eq_of_pins S ht ht'' ht' hdown h
  exact h''

/-- **A crepant model is a crepant birational map.** If `p : W ⟶ X` is a proper birational
morphism from a normal variety and `B_W` is the crepant boundary of the pair `(X, B)` on `W`, then
`p^* : k(X) ≅ k(W)` is a crepant birational map `(W, B_W) ⇢ (X, B)`. -/
private theorem exists_isCrepantBirationalMap_of_isCrepantBoundary {X W : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] {sX : X ⟶ Spec (.of ℂ)} (hXp : Mori.IsProjectiveVariety ℂ sX) {n : ℕ}
    {B : QDivisor X} (hP : MMP.Mori.IsPair sX B) {KX : Divisor X}
    (hKX : KX.IsCanonicalDivisor sX n) (p : W ⟶ X) [IsDominant p] [IsProper p]
    (hpb : IsBirationalMorphism p) (hWX : IsNormalVariety ℂ (p ≫ sX)) {BW : QDivisor W}
    (hBW : IsCrepantBoundary sX n KX B p hWX hpb BW)
    (hq : (Divisor.toQDivisor KX + B).IsQCartier) {sW : W ⟶ Spec (.of ℂ)}
    (hsW : p ≫ sX = sW) :
    ∃ e : FunctionFieldEquiv sW sX, IsCrepantBirationalMap sW sX BW B e ∧
      ∀ a, e a = functionFieldMap p a := by
  haveI := hXp.toLocallyOfFiniteType
  haveI := hWX.1.toLocallyOfFiniteType
  haveI := hXp.toIsVariety
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  have hX : IsNormalVariety ℂ sX := hP.1
  have hn := hKX.topologicalKrullDim_eq
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hKX
  have hωK : divisorOfForm ω = KX := Finsupp.ext fun Γ => hω Γ
  have hpω : pullbackRationalPluriForms sX p ω ≠ 0 :=
    pullbackRationalPluriForms_ne_zero p hpb.functionFieldMap_bijective hd hω0
  have hdW : topologicalKrullDim W = n := by
    haveI := hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hpb]
    exact hn
  have hKW := CrepantModelAux.isCanonicalDivisor_divisorOfForm hWX hdW hpω
  obtain ⟨-, -, hgen, hpull⟩ := hP.isPullback_of_isCrepantBoundary p hWX hpb hKX hKW
    (Or.inl ⟨ω, hω0, hωK, rfl⟩) hBW
  subst hωK hsW
  refine ⟨functionFieldAlgEquiv sX p hpb.functionFieldMap_bijective, ?_, fun a => rfl⟩
  exact CrepantModelAux.isCrepantBirationalMap_of_isPullback hX p hpb hWX hω0 hKX hpω hKW hq
    hpull

/-- **The two pairs are crepant birational.** The common crepant model `W` gives a crepant
birational map `σ : (Y, C) ⇢ (X, B)` with `q^* ∘ σ = p^*`. -/
private theorem Setting.exists_isCrepantBirationalMap
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    ∃ σ : FunctionFieldEquiv sY sX, IsCrepantBirationalMap sY sX C B σ ∧
      ∀ a, functionFieldMap q (σ a) = functionFieldMap p a := by
  have hqX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := S.hmX
    exact ⟨m, by exact_mod_cast S.hm0.ne', D, hD, hDc⟩
  have hqY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := S.hmY
    exact ⟨m, by exact_mod_cast S.hm0.ne', D, hD, hDc⟩
  obtain ⟨ep, hep, hepa⟩ := exists_isCrepantBirationalMap_of_isCrepantBoundary S.hXp
    S.hBp.isPair S.hKX p S.hpb S.hWX S.hBWX hqX rfl
  obtain ⟨eq', heq, heqa⟩ := exists_isCrepantBirationalMap_of_isCrepantBoundary S.hYp
    S.hCp.isPair S.hKY q S.hqb S.hWY S.hBWY hqY S.hpq.symm
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (p ≫ sX)
  refine ⟨ep.trans eq'.symm, IsCrepantBirationalMap.trans heq.symm hep, fun a => ?_⟩
  rw [← heqa, ← hepa]
  exact eq'.apply_symm_apply (ep a)

/-- **Valuations of a common strict transform.** If a prime divisor `E` of `W` is the strict
transform both of a prime divisor `P` of `X` and of a prime divisor `Q` of `Y`, the crepant map
`σ` carries the valuation of `Q` to that of `P`. -/
private theorem divisorialValuation_eq_of_isIso_stalkMap
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) {σ : FunctionFieldEquiv sY sX}
    (hσ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a) (E : Mori.PrimeDivisor W)
    (P : Mori.PrimeDivisor X) (Q : Mori.PrimeDivisor Y) (hpE : p E.genericPoint = P.genericPoint)
    (hqE : q E.genericPoint = Q.genericPoint) [IsIso (p.stalkMap E.genericPoint)]
    [IsIso (q.stalkMap E.genericPoint)] (g : X.functionField) :
    P.divisorialValuation g = Q.divisorialValuation (σ g) := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  by_cases hg : g = 0
  · subst hg
    rw [map_zero, map_zero, map_zero]
  have hσg : σ g ≠ 0 := by
    intro h
    exact hg (σ.injective (h.trans (map_zero σ).symm))
  rw [P.divisorialValuation_eq_exp_neg_ord hg, Q.divisorialValuation_eq_exp_neg_ord hσg,
    ← ord_functionFieldMap_of_isIso' p E P hpE, ← ord_functionFieldMap_of_isIso' q E Q hqE, hσ]

/-- **Non-exceptional floor components are crepant birational.** If a floor component `Q` of
`Y` and a floor component `P` of `X` have a common strict transform `E` on `W`, the crepant map
`σ : (Y, C) ⇢ (X, B)` induces a crepant birational map `(C_Q, B_Q) ⇢ (C_P, B_P)`, compatible with
the restrictions of germs along the identification `𝒪_{X,P} ≅ 𝒪_{Y,Q}`. -/
private theorem exists_isCrepantBirationalMap_floor
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) {σ : FunctionFieldEquiv sY sX}
    (hσc : IsCrepantBirationalMap sY sX C B σ)
    (hσ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a)
    (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0})
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (E : Mori.PrimeDivisor W)
    (hpE : p E.genericPoint = P.1.genericPoint) (hqE : q E.genericPoint = Q.1.genericPoint)
    [IsIso (p.stalkMap E.genericPoint)] [IsIso (q.stalkMap E.genericPoint)] :
    ∃ (ψ : X.presheaf.stalk ((jX P) (genericPoint (CX P))) ≃+*
        Y.presheaf.stalk ((jY Q) (genericPoint (CY Q))))
      (σT : FunctionFieldEquiv (jY Q ≫ sY) (jX P ≫ sX)),
      (∀ a, algebraMap _ Y.functionField (ψ a) = σ (algebraMap _ X.functionField a)) ∧
      (∀ a, Y.ord (algebraMap _ Y.functionField (ψ a)) ((jY Q) (genericPoint (CY Q))) =
        X.ord (algebraMap _ X.functionField a) ((jX P) (genericPoint (CX P)))) ∧
      IsCrepantBirationalMap (jY Q ≫ sY) (jX P ≫ sX) (BY Q) (BX P) σT ∧
      ∀ a, σT (((jX P).stalkMap (genericPoint (CX P))).hom a) =
        ((jY Q).stalkMap (genericPoint (CY Q))).hom (ψ a) := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hXp.toIsVariety
  haveI := S.hYp.toIsVariety
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  obtain ⟨P', hP', hciP⟩ := (S.hjX P).1.exists_primeDivisor
  obtain ⟨Q', hQ', hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hciP
  haveI := hciQ
  have hPP' : P' = P.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hP'.symm.trans (map_genericPoint_eq_of_range_eq (P := P.1) (S.hjX P).2))
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans (map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2))
  subst hPP' hQQ'
  haveI : CompactSpace (CX P) := QuasiCompact.compactSpace_of_compactSpace (jX P ≫ sX)
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hval : ∀ g, P.1.divisorialValuation g = Q.1.divisorialValuation (σ g) :=
    divisorialValuation_eq_of_isIso_stalkMap S hσ E P.1 Q.1 hpE hqE
  obtain ⟨ψ, hψ, hord⟩ := CrepantModelAux.exists_stalk_ringEquiv_of_divisorialValuation_eq σ
    Q.1 P.1 hval hQ' hP'
  obtain ⟨σT, hσT⟩ := CrepantModelAux.exists_functionFieldEquiv_of_stalk_ringEquiv σ
    (S.hjY Q).1 (S.hjX P).1 ψ hψ
  have hqX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := S.hmX
    exact ⟨m, by exact_mod_cast S.hm0.ne', D, hD, hDc⟩
  have hqY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := S.hmY
    exact ⟨m, by exact_mod_cast S.hm0.ne', D, hD, hDc⟩
  refine ⟨ψ, σT, hψ, hord, ?_, hσT⟩
  exact CrepantModelAux.isCrepantBirationalMap_of_isAdjunctionStep S.hCp.isPair.1
    S.hBp.isPair.1 S.hdimY S.hdimX S.hKY S.hKX hqY hqX σ hσc (S.hjY Q).1 (S.hjX P).1 Q.1 P.1
    (S.hjY Q).2 (S.hjX P).2 hval ψ hψ hord σT hσT

/-- **Pinned sections agree on non-exceptional floor components.** If the floor component `Q`
of `Y` and the floor component `P` of `X` correspond under `σ`, as in
`exists_isCrepantBirationalMap_floor`, then `t'_Q = σ_T^* t_P` for pinned floor sections. -/
private theorem pluriformPullback_floor_eq
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t') {σ : FunctionFieldEquiv sY sX}
    (hσ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a)
    (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0})
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    (ψ : X.presheaf.stalk ((jX P) (genericPoint (CX P))) ≃+*
        Y.presheaf.stalk ((jY Q) (genericPoint (CY Q))))
    (σT : FunctionFieldEquiv (jY Q ≫ sY) (jX P ≫ sX))
    (hψ : ∀ a, algebraMap _ Y.functionField (ψ a) = σ (algebraMap _ X.functionField a))
    (hord : ∀ a, Y.ord (algebraMap _ Y.functionField (ψ a)) ((jY Q) (genericPoint (CY Q))) =
      X.ord (algebraMap _ X.functionField a) ((jX P) (genericPoint (CX P))))
    (hσT : ∀ a, σT (((jX P).stalkMap (genericPoint (CX P))).hom a) =
      ((jY Q).stalkMap (genericPoint (CY Q))).hom (ψ a))
    (hdC : topologicalKrullDim (CY Q) = n) (hdC' : topologicalKrullDim (CX P) = n)
    (hcorr : ∀ E : Mori.PrimeDivisor W, q E.genericPoint = Q.1.genericPoint →
      p E.genericPoint = P.1.genericPoint) :
    pluriformPullback (jY Q ≫ sY) (jX P ≫ sX) σT.toHom n m (t P : RationalPluriForms _ n m) =
      (t' Q : RationalPluriForms _ n m) := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hdW : topologicalKrullDim W = (n + 1 : ℕ) := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact S.hdimX
  obtain ⟨Q', hQ', hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans (map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2))
  subst hQQ'
  obtain ⟨P', hP', hciP⟩ := (S.hjX P).1.exists_primeDivisor
  haveI := hciP
  have hPP' : P' = P.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hP'.symm.trans (map_genericPoint_eq_of_range_eq (P := P.1) (S.hjX P).2))
  subst hPP'
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := (S.hjY Q).1.1.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (jX P ≫ sX) := (S.hjX P).1.1.1.toLocallyOfFiniteType
  -- the strict transform of `Q` on `W`
  obtain ⟨T', _, j', _, g₁, _, _, E', hg₁, hcomm, hj'η, hgE', hiso, hrange'⟩ :=
    exists_strictTransform_primeDivisor q S.hqb (jY Q) Q.1 hQ'
  haveI := hiso
  obtain ⟨hE'1, -⟩ := coeff_eq_one_of_isIso_stalkMap S Q E' hgE'
  haveI : LocallyOfFiniteType (g₁ ≫ jY Q ≫ sY) := by
    rw [← Category.assoc, hcomm, Category.assoc]; infer_instance
  have hdT' : topologicalKrullDim T' = n := by
    rw [topologicalKrullDim_eq_of_functionFieldMap_bijective (jY Q ≫ sY) g₁
      hg₁.functionFieldMap_bijective, hdC]
  -- presentations
  obtain ⟨U', hyU', τ', hτ'⟩ := ht' (q.base (j'.base (genericPoint T')))
  obtain ⟨U, hxU, τ, hτ⟩ := ht (p.base (j'.base (genericPoint T')))
  obtain ⟨ρE, h₁, h₂⟩ := h U τ hτ U' τ' hτ' E' hE'1 j' inferInstance hrange' hxU hyU'
  have hQU' : (jY Q).base (genericPoint (CY Q)) ∈ U' := by
    change jY Q (genericPoint (CY Q)) ∈ U'
    rw [hQ', ← hgE', ← hj'η]
    exact hyU'
  have hPU : (jX P).base (genericPoint (CX P)) ∈ U := by
    change jX P (genericPoint (CX P)) ∈ U
    rw [hP', ← hcorr E' hgE', ← hj'η]
    exact hxU
  have hresP := hτ.2 P hPU
  have hresQ := hτ'.2 Q hQU'
  -- the transported form `σ^* τ` has residue `σ_T^* t_P` along `Q`
  have h1 := CrepantModelAux.isPoincareResidue_pluriformPullback (sX := sY) (sX' := sX)
    (jY Q) (jX P) S.hdimY S.hdimX hdC hdC' σ.toHom σT.toHom ψ.toRingHom hψ
    (fun a => (hσT a).symm) hord hresP
  -- both residues transported to `E'`
  have hA := IsPoincareResidue.pullback_of_isIso_stalkMap q g₁ hcomm S.hdimY hdW hdC hdT' Q.1 E'
    hQ' hj'η hgE' h1
  have hB := IsPoincareResidue.pullback_of_isIso_stalkMap q g₁ hcomm S.hdimY hdW hdC hdT' Q.1 E'
    hQ' hj'η hgE' hresQ
  have hid := pullback_pluriformPullback_eq p q S.hpq S.hdimX S.hdimY hdW σ.toHom hσ τ
  rw [hid] at hA
  have hEgen := hj'η
  have hc := IsPoincareResidue.cast_structure S.hpq h₁ (by rw [S.hpq]) (by rw [S.hpq])
  have u1 := IsPoincareResidue.unique_of_isClosedImmersion E' hEgen hA hc
  have u2 := IsPoincareResidue.unique_of_isClosedImmersion E' hEgen hB h₂
  have u3 : pullbackRationalPluriForms (jY Q ≫ sY) g₁
      (pluriformPullback (jY Q ≫ sY) (jX P ≫ sX) σT.toHom n m (t P : RationalPluriForms _ n m)) =
      pullbackRationalPluriForms (jY Q ≫ sY) g₁ (t' Q : RationalPluriForms _ n m) := by
    have := u1.trans u2.symm
    exact eq_of_heq ((cast_heq _ _).symm.trans ((heq_of_eq this).trans (cast_heq _ _)))
  -- injectivity of the pull-back along the birational `g₁`
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := jY Q ≫ sY)
    (show topologicalKrullDim (CY Q) = ((n : ℕ) : WithBot ℕ∞) from hdC)
  by_contra hne
  have hne' := sub_ne_zero.mpr hne
  apply pullbackRationalPluriForms_ne_zero g₁ hg₁.functionFieldMap_bijective hd hne'
  rw [pullbackRationalPluriForms_sub, u3, sub_self]

/-- The residue restriction along the flag of length zero is the section itself. -/
private theorem ResidueRestriction.toFun_refl {k : Type} [Field k] [CharZero k] {I : Type*}
    {Z : I → Scheme.{0}} {sZ : ∀ i, Z i ⟶ Spec (.of k)} [∀ i, IsIntegral (Z i)]
    [∀ i, IsLocallyNoetherian (Z i)] [∀ i, IsNormal (Z i)] {BZ : ∀ i, QDivisor (Z i)} {d m : ℕ}
    (R : ResidueRestriction sZ BZ d m) (i : I) (h : MMP.Mori.IsPair (sZ i) (BZ i))
    (s : logPluricanonicalSections (sZ i) d m (BZ i)) :
    HEq (R.toFun i (.refl h) d s) (s : RationalPluriForms (sZ i) d m) := by
  have := (R.isIteratedResidue i (.refl h) d s (R.setting.topologicalKrullDim_eq i)).rec'
  exact this.2

/-- **Whole floor components that are not exceptional.** If `σ_T : (C_Q, B_Q) ⇢ (C_P, B_P)` and
`σ_T' : (C_{Q'}, B_{Q'}) ⇢ (C_{P'}, B_{P'})` are crepant with `t'_Q = σ_T^* t_P` and
`t'_{Q'} = σ_T'^* t_{P'}`, and `t` is admissible, then every crepant birational map
`σ_V : (C_Q, B_Q) ⇢ (C_{Q'}, B_{Q'})` satisfies `σ_V^* t'_{Q'} = t'_Q`. -/
private theorem pluriformPullback_floor_eq_of_admissible
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m) (hadm : t ∈ admissibleSections R)
    {P P' : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}}
    {Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}}
    (σT : FunctionFieldEquiv (jY Q ≫ sY) (jX P ≫ sX))
    (σT' : FunctionFieldEquiv (jY Q' ≫ sY) (jX P' ≫ sX))
    (hσT : IsCrepantBirationalMap (jY Q ≫ sY) (jX P ≫ sX) (BY Q) (BX P) σT)
    (hσT' : IsCrepantBirationalMap (jY Q' ≫ sY) (jX P' ≫ sX) (BY Q') (BX P') σT')
    (ht : pluriformPullback (jY Q ≫ sY) (jX P ≫ sX) σT.toHom n m (t P : RationalPluriForms _ n m) =
      (t' Q : RationalPluriForms _ n m))
    (ht' : pluriformPullback (jY Q' ≫ sY) (jX P' ≫ sX) σT'.toHom n m
      (t P' : RationalPluriForms _ n m) = (t' Q' : RationalPluriForms _ n m))
    (hdQ : topologicalKrullDim (CY Q) = n) (hdQ' : topologicalKrullDim (CY Q') = n)
    (σV : FunctionFieldEquiv (jY Q ≫ sY) (jY Q' ≫ sY))
    (hσV : IsCrepantBirationalMap (jY Q ≫ sY) (jY Q' ≫ sY) (BY Q) (BY Q') σV) :
    pluriformPullback (jY Q ≫ sY) (jY Q' ≫ sY) σV.toHom n m (t' Q' : RationalPluriForms _ n m) =
      (t' Q : RationalPluriForms _ n m) := by
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := (S.hjY Q).1.1.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (jY Q' ≫ sY) := (S.hjY Q').1.1.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (jX P ≫ sX) := (S.hjX P).1.1.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (jX P' ≫ sX) := (S.hjX P').1.1.1.toLocallyOfFiniteType
  have hdP : topologicalKrullDim (CX P) = n := R.setting.topologicalKrullDim_eq P
  have hdP' : topologicalKrullDim (CX P') = n := R.setting.topologicalKrullDim_eq P'
  letI := functionFieldAlgebra (jY Q ≫ sY)
  letI := functionFieldAlgebra (jY Q' ≫ sY)
  letI := functionFieldAlgebra (jX P ≫ sX)
  letI := functionFieldAlgebra (jX P' ≫ sX)
  -- the induced crepant map between the floor components of `X`
  set σX : FunctionFieldEquiv (jX P ≫ sX) (jX P' ≫ sX) := (σT'.trans σV).trans σT.symm
  have hσX : IsCrepantBirationalMap (jX P ≫ sX) (jX P' ≫ sX) (BX P) (BX P') σX :=
    IsCrepantBirationalMap.trans hσT.symm (IsCrepantBirationalMap.trans hσV hσT')
  have hP := (R.setting.isPair P).isPair
  have hP' := (R.setting.isPair P').isPair
  have hadm' := hadm P P' (.refl hP) (.refl hP') n le_rfl le_rfl hdP hdP' σX hσX
  have e1 := eq_of_heq (ResidueRestriction.toFun_refl R P hP (t P))
  have e2 := eq_of_heq (ResidueRestriction.toFun_refl R P' hP' (t P'))
  have hXeq : pluriformPullback (jX P ≫ sX) (jX P' ≫ sX) σX.toHom n m
      (t P' : RationalPluriForms _ n m) = (t P : RationalPluriForms _ n m) := by
    rw [← e1, ← e2]
    exact hadm'
  have hcomp : σV.toHom.comp σT'.toHom = σT.toHom.comp σX.toHom := by
    ext a
    change σV (σT' a) = σT (σT.symm (σV (σT' a)))
    rw [AlgEquiv.apply_symm_apply]
  rw [← ht', ← ht, pluriformPullback_comp hdQ hdQ' hdP' m σV.toHom σT'.toHom, ← hXeq,
    pluriformPullback_comp hdQ hdP hdP' m σT.toHom σX.toHom, hcomp]

/-- **Transfer of admissibility along crepant copies of strata.** Let `V`, `V'` be the final
strata of flags `F`, `F'` of floor components `Q`, `Q'` of `Y`, and `U`, `U'` those of flags
`G`, `G'` of floor components `P`, `P'` of `X`, all of dimension `e`. If
`ψ : (V, B_V) ⇢ (U, B_U)` and `ψ' : (V', B_{V'}) ⇢ (U', B_{U'})` are crepant and carry the
residue restrictions of `t` to those of `t'`, and `t` is admissible, then every crepant
birational map `φ : (V, B_V) ⇢ (V', B_{V'})` carries the residue restriction of `t'_{Q'}` along
`F'` to that of `t'_Q` along `F`. -/
private theorem pluriformPullback_toFun_eq_of_admissible
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m) (hadm : t ∈ admissibleSections R)
    {P P' : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}}
    {Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}}
    {U U' V V' : Scheme.{0}} [IsIntegral U] [IsLocallyNoetherian U] [IsNormal U]
    [IsIntegral U'] [IsLocallyNoetherian U'] [IsNormal U'] [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] [IsIntegral V'] [IsLocallyNoetherian V'] [IsNormal V']
    {ιU : U ⟶ CX P} {ιU' : U' ⟶ CX P'} {ιV : V ⟶ CY Q} {ιV' : V' ⟶ CY Q'}
    {BU : QDivisor U} {BU' : QDivisor U'} {BV : QDivisor V} {BV' : QDivisor V'}
    (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU)
    (G' : StratumAdjunctionData (jX P' ≫ sX) (BX P') ιU' BU')
    (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV') {e : ℕ}
    (hU : topologicalKrullDim U = e) (hU' : topologicalKrullDim U' = e)
    (hV : topologicalKrullDim V = e) (hV' : topologicalKrullDim V' = e)
    (ψ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX))
    (ψ' : FunctionFieldEquiv (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX))
    (hψ : IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) BV BU ψ)
    (hψ' : IsCrepantBirationalMap (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX) BV' BU' ψ')
    (h₁ : R'.toFun Q F e (t' Q) =
      pluriformPullback (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) ψ.toHom e m (R.toFun P G e (t P)))
    (h₂ : R'.toFun Q' F' e (t' Q') =
      pluriformPullback (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX) ψ'.toHom e m
        (R.toFun P' G' e (t P')))
    (φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY))
    (hφ : IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ) :
    pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom e m (R'.toFun Q' F' e (t' Q')) =
      R'.toFun Q F e (t' Q) := by
  letI := functionFieldAlgebra (ιV ≫ jY Q ≫ sY)
  letI := functionFieldAlgebra (ιV' ≫ jY Q' ≫ sY)
  letI := functionFieldAlgebra (ιU ≫ jX P ≫ sX)
  letI := functionFieldAlgebra (ιU' ≫ jX P' ≫ sX)
  haveI : LocallyOfFiniteType (ιU ≫ jX P ≫ sX) := G.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ιU' ≫ jX P' ≫ sX) := G'.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ιV ≫ jY Q ≫ sY) := F.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ιV' ≫ jY Q' ≫ sY) := F'.isNormalVariety.1.toLocallyOfFiniteType
  set σX : FunctionFieldEquiv (ιU ≫ jX P ≫ sX) (ιU' ≫ jX P' ≫ sX) := (ψ'.trans φ).trans ψ.symm
  have hσX : IsCrepantBirationalMap (ιU ≫ jX P ≫ sX) (ιU' ≫ jX P' ≫ sX) BU BU' σX :=
    IsCrepantBirationalMap.trans hψ.symm (IsCrepantBirationalMap.trans hφ hψ')
  have hadm' := hadm P P' G G' e (Nat.zero_le _) (Nat.zero_le _) hU hU' σX hσX
  have hcomp : φ.toHom.comp ψ'.toHom = ψ.toHom.comp σX.toHom := by
    ext a
    change φ (ψ' a) = ψ (ψ.symm (φ (ψ' a)))
    rw [AlgEquiv.apply_symm_apply]
  rw [h₁, h₂, pluriformPullback_comp hV hV' hU' m φ.toHom ψ'.toHom, ← hadm',
    pluriformPullback_comp hV hU hU' m ψ.toHom σX.toHom, hcomp]

/-- **Uniqueness of strict transforms.** Two prime divisors of `W` over the generic point of a
prime divisor `Q` of `Y` coincide. -/
private theorem primeDivisor_eq_of_map_genericPoint_eq
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (Q : Mori.PrimeDivisor Y)
    {E E' : Mori.PrimeDivisor W} (hE : q E.genericPoint = Q.genericPoint)
    (hE' : q E'.genericPoint = Q.genericPoint) : E = E' := by
  have hbir := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal q S.hqb
    Q.coheight_genericPoint.le
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_map_eq_of_mem_biregularLocus q (hE.trans hE'.symm) (hE ▸ hbir))

/-- The coefficient of `B_W` along a prime divisor `E` of `W` at which `q` is a local isomorphism
onto the generic point of a prime divisor `Q` of `Y` is the coefficient of `C` along `Q`. -/
private theorem coeff_eq_of_isIso_stalkMap
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) (Q : Mori.PrimeDivisor Y)
    (E : Mori.PrimeDivisor W) (hqE : q E.genericPoint = Q.genericPoint)
    [IsIso (q.stalkMap E.genericPoint)] : BW.coeff E = C.coeff Q := by
  haveI := S.hYp.toLocallyOfFiniteType
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) S.hdimY
  have hbij := S.hqb.functionFieldMap_bijective
  obtain ⟨-, -, m₁, hm₁, -, U₁, hU₁, ω₁, hω₁, hω₁a⟩ := S.hBWY E
  have hQU : (Q.support ∩ U₁).Nonempty := by
    refine ⟨Q.genericPoint, ?_, hqE ▸ hU₁⟩
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have e1 := hω₁.2 Q hQU
  have e2 : (DivisorOver.ordPullback ⟨W, q, S.hWY, S.hqb, E⟩ ω₁ : ℤ) = Q.ordForm ω₁ :=
    MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso q hbij hd E Q hqE ω₁
  have hm₁' : (m₁ : ℚ) ≠ 0 := by positivity
  have := hω₁a
  rw [e2] at this
  apply mul_left_cancel₀ hm₁'
  linear_combination -this - e1

/-- **Whole floor components with common strict transforms.** If the floor components `Q`, `Q'`
of `Y` have strict transforms `E`, `E'` on `W` which are also strict transforms of floor
components `P`, `P'` of `X`, and `t` is admissible, then every crepant birational map
`σ_V : (C_Q, B_Q) ⇢ (C_{Q'}, B_{Q'})` satisfies `σ_V^* t'_{Q'} = t'_Q`. -/
private theorem pluriformPullback_floor_eq_of_strictTransform
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m) (hadm : t ∈ admissibleSections R)
    {P P' : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}}
    {Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}} {E E' : Mori.PrimeDivisor W}
    (hpE : p E.genericPoint = P.1.genericPoint) (hqE : q E.genericPoint = Q.1.genericPoint)
    [IsIso (p.stalkMap E.genericPoint)] [IsIso (q.stalkMap E.genericPoint)]
    (hpE' : p E'.genericPoint = P'.1.genericPoint) (hqE' : q E'.genericPoint = Q'.1.genericPoint)
    [IsIso (p.stalkMap E'.genericPoint)] [IsIso (q.stalkMap E'.genericPoint)]
    (σV : FunctionFieldEquiv (jY Q ≫ sY) (jY Q' ≫ sY))
    (hσV : IsCrepantBirationalMap (jY Q ≫ sY) (jY Q' ≫ sY) (BY Q) (BY Q') σV) :
    pluriformPullback (jY Q ≫ sY) (jY Q' ≫ sY) σV.toHom n m (t' Q' : RationalPluriForms _ n m) =
      (t' Q : RationalPluriForms _ n m) := by
  obtain ⟨σ, hσc, hσ⟩ := S.exists_isCrepantBirationalMap
  obtain ⟨ψ, σT, hψ, hord, hσTc, hσT⟩ :=
    exists_isCrepantBirationalMap_floor S hσc hσ P Q E hpE hqE
  obtain ⟨ψ', σT', hψ', hord', hσTc', hσT'⟩ :=
    exists_isCrepantBirationalMap_floor S hσc hσ P' Q' E' hpE' hqE'
  have hdQ : topologicalKrullDim (CY Q) = n := R'.setting.topologicalKrullDim_eq Q
  have hdQ' : topologicalKrullDim (CY Q') = n := R'.setting.topologicalKrullDim_eq Q'
  have hdP : topologicalKrullDim (CX P) = n := R.setting.topologicalKrullDim_eq P
  have hdP' : topologicalKrullDim (CX P') = n := R.setting.topologicalKrullDim_eq P'
  have e1 := pluriformPullback_floor_eq S ht ht' h hσ P Q ψ σT hψ hord hσT hdQ hdP
    (fun E₁ h₁ => by rw [primeDivisor_eq_of_map_genericPoint_eq S Q.1 h₁ hqE]; exact hpE)
  have e2 := pluriformPullback_floor_eq S ht ht' h hσ P' Q' ψ' σT' hψ' hord' hσT' hdQ' hdP'
    (fun E₁ h₁ => by rw [primeDivisor_eq_of_map_genericPoint_eq S Q'.1 h₁ hqE']; exact hpE')
  exact pluriformPullback_floor_eq_of_admissible S R hadm σT σT' hσTc hσTc' e1 e2 hdQ hdQ' σV hσV

/-- **Floor points of curves.** For curves, the strict transform on `W` of every floor point of
`Y` is the strict transform of a floor point of `X`. -/
private theorem exists_floor_strictTransform_of_eq_zero
    (S : Setting sX sY 0 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) :
    ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint) := by
  obtain ⟨E, hqE, hiso, hE, -⟩ := exists_strictTransform_floor S Q
  have hxle : Order.coheight (p E.genericPoint) ≤ 1 := by
    have h1 := AlgebraicGeometry.coheight_le_topologicalKrullDim (p E.genericPoint)
    rw [S.hdimX] at h1
    exact_mod_cast h1
  have hbir := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal p S.hpb hxle
  have hx1 : Order.coheight (p E.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus p hbir]
    exact E.coheight_genericPoint
  set P₀ : Mori.PrimeDivisor X := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hx1
  have hP₀ : MMP.Mori.PrimeDivisor.genericPoint P₀ = p E.genericPoint :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hx1
  haveI hpi : IsIso (p.stalkMap E.genericPoint) := MMP.isIso_stalkMap_of_mem_biregularLocus p hbir
  have hcoeff := coeff_eq_of_isIso_stalkMap S.swap P₀ E hP₀.symm
  rw [hE] at hcoeff
  refine ⟨⟨P₀, by rw [← hcoeff]; norm_num⟩, E, hP₀.symm, hqE, hpi, hiso⟩

/-- **Strata of dlt pairs are dlt.** The final pair of a flag of iterated adjunction of a dlt
pair is dlt. -/
private theorem isDltPair_of_stratumAdjunctionData {Z : Scheme.{0}} [IsIntegral Z]
    [IsLocallyNoetherian Z] [IsNormal Z] {sZ : Z ⟶ Spec (.of ℂ)} {BZ : QDivisor Z}
    (hZ : MMP.Intersection.IsDltPair sZ BZ) {S : Scheme.{0}} {ι : S ⟶ Z} {BS : QDivisor S}
    (F : StratumAdjunctionData sZ BZ ι BS) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    MMP.Intersection.IsDltPair (ι ≫ sZ) BS := by
  induction F with
  | refl h => exact hZ
  | @step S T ι BS F j BT hj ih =>
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    have hj' := hj
    obtain ⟨-, P, hP1, hrange, -⟩ := hj'
    have hstr : IsDltStratum (ι ≫ sZ) BS (P.support : Set S) := by
      refine ⟨ih, {P}, Finset.singleton_nonempty _, by simpa using hP1, ?_, ?_⟩
      · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
        exact ⟨P.genericPoint, by
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
      · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
        refine ⟨⟨?_, le_rfl⟩, fun T hT _ => hT.2⟩
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact isIrreducible_singleton.closure
    have := (hstr.exists_isStratumAdjunctionPair_and_isDltPair).1.2
      (StratumAdjunctionData.step (.refl ih.1.1) j BT hj) hrange
    exact this

/-- **Residues along a non-exceptional floor divisor under a crepant map.** Let
`φ : (V, B_V) ⇢ (V', B_{V'})` be a crepant birational map of projective dlt pairs of dimension
`d + 1`, `j : G ⟶ V` an adjunction step onto a prime divisor `P` whose valuation `φ` carries to
that of a prime divisor `P'` of `V'`. Then `P'` carries an adjunction step `j' : G' ⟶ V'` and `φ`
induces a crepant birational map `σ_G : (G, B_G) ⇢ (G', B_{G'})` with
`Res_G(φ^* τ') = σ_G^* Res_{G'}(τ')` for every form `τ'` on `V'`. -/
private theorem exists_isAdjunctionStep_isPoincareResidue_pluriformPullback
    {V V' : Scheme.{0}} [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [IsIntegral V']
    [IsLocallyNoetherian V'] [IsNormal V'] {sV : V ⟶ Spec (.of ℂ)} {sV' : V' ⟶ Spec (.of ℂ)}
    [IsProper sV] [IsProper sV'] {BV : QDivisor V} {BV' : QDivisor V'}
    (hV : MMP.Intersection.IsDltPair sV BV) (hV' : MMP.Intersection.IsDltPair sV' BV') {d : ℕ}
    (hd : topologicalKrullDim V = (d + 1 : ℕ)) (hd' : topologicalKrullDim V' = (d + 1 : ℕ))
    {K : Divisor V} {K' : Divisor V'} (hK : K.IsCanonicalDivisor sV (d + 1))
    (hK' : K'.IsCanonicalDivisor sV' (d + 1)) (hKB : (Divisor.toQDivisor K + BV).IsQCartier)
    (hKB' : (Divisor.toQDivisor K' + BV').IsQCartier) (φ : FunctionFieldEquiv sV sV')
    (hφ : IsCrepantBirationalMap sV sV' BV BV' φ) {G : Scheme.{0}} [IsIntegral G]
    [IsLocallyNoetherian G] [IsNormal G] {j : G ⟶ V} {BG : QDivisor G}
    (hj : IsAdjunctionStep sV BV j BG) (P : Mori.PrimeDivisor V)
    (hrP : Set.range j.base = (P.support : Set V)) (P' : Mori.PrimeDivisor V')
    (hP' : ∀ g, P'.divisorialValuation g = P.divisorialValuation ((φ.toHom) g)) :
    ∃ (G' : Scheme.{0}) (j' : G' ⟶ V') (BG' : QDivisor G') (_ : IsIntegral G')
      (_ : IsLocallyNoetherian G') (_ : IsNormal G') (_ : IsAdjunctionStep sV' BV' j' BG')
      (σT : FunctionFieldEquiv (j ≫ sV) (j' ≫ sV')),
      IsCrepantBirationalMap (j ≫ sV) (j' ≫ sV') BG BG' σT ∧
      ∀ {m : ℕ} (τ' : RationalPluriForms sV' (d + 1) m) (ρ' : RationalPluriForms (j' ≫ sV') d m),
        IsPoincareResidue sV' j' d m τ' ρ' →
        IsPoincareResidue sV j d m (pluriformPullback sV sV' φ.toHom (d + 1) m τ')
          (pluriformPullback (j ≫ sV) (j' ≫ sV') σT.toHom d m ρ') := by
  have hX := hV.1.1.1
  have hX' := hV'.1.1.1
  haveI : LocallyOfFiniteType sV := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sV' := hX'.1.toLocallyOfFiniteType
  haveI := hX.1
  haveI := hX'.1
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace sV
  haveI : CompactSpace V' := QuasiCompact.compactSpace_of_compactSpace sV'
  obtain ⟨-, P₀, hP1, hrange₀, hci, -⟩ := id hj
  haveI := hci
  have hPP : P₀ = P := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    ((map_genericPoint_eq_of_range_eq hrange₀).symm.trans (map_genericPoint_eq_of_range_eq hrP))
  subst hPP
  -- the coefficient of `P'`
  have hcoeff : BV'.coeff P' = BV.coeff P₀ := by
    set DΓ := DivisorOver.ofPrimeDivisor ℂ hX P₀
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hV.1.1 hK DΓ
    have hc' : c = -BV.coeff P₀ := hc.eq_neg_coeff_of_ofPrimeDivisor hX
    have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 V) by infer_instance)
    obtain ⟨n', D, hDv, hDlog⟩ := (hφ DΓ.valuation (1 + c)).mp ⟨d + 1, DΓ, rfl, hlog⟩
    set DΓ' := DivisorOver.ofPrimeDivisor ℂ hX' P'
    obtain ⟨c2, hc2⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hV'.1.1 hK' DΓ'
    have hc2' : c2 = -BV'.coeff P' := hc2.eq_neg_coeff_of_ofPrimeDivisor hX'
    have hlog2 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc2
      (show IsProper (𝟙 V') by infer_instance)
    have hval : D.valuation = DΓ'.valuation := by
      ext g
      rw [hDv]
      change P₀.divisorialValuation (functionFieldMap (𝟙 V) ((φ.toHom) g)) =
        P'.divisorialValuation (functionFieldMap (𝟙 V') g)
      rw [functionFieldMap_id_apply, functionFieldMap_id_apply, hP']
    have h1 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq_of_isPair hV'.1.1
      hDlog hlog2 hval
    have h2 : c = c2 := by exact_mod_cast (by linarith : (c : ℝ) = c2)
    linarith
  have hP1' : 1 ≤ BV'.coeff P' := hcoeff ▸ hP1
  have hstr : IsDltStratum sV' BV' (P'.support : Set V') := by
    refine ⟨hV', {P'}, Finset.singleton_nonempty _, by simpa using hP1', ?_, ?_⟩
    · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
      exact ⟨P'.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
    · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
      refine ⟨⟨?_, le_rfl⟩, fun T hT _ => hT.2⟩
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
  obtain ⟨⟨⟨T', ι', BT', hr', ⟨F'⟩⟩, -⟩, -⟩ := hstr.exists_isStratumAdjunctionPair_and_isDltPair
  haveI := F'.isIntegral_stratum
  haveI := F'.isClosedImmersion
  have hdimT' : topologicalKrullDim T' = d :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sV' ι' P' hr' hd'
  have hlen := F'.dim_add_length hd' hdimT'
  cases F' with
  | refl h' => simp [StratumAdjunctionData.length] at hlen
  | step F'' j'' BT'' hj'' =>
    cases F'' with
    | step F3 _ _ _ => simp [StratumAdjunctionData.length] at hlen <;> omega
    | refl h' =>
      have hj2 : IsAdjunctionStep sV' BV' j'' BT' := hj''
      obtain ⟨-, -, -, -, hci'', -⟩ := id hj2
      haveI := hci''
      haveI : IsIntegral T' := hj2.1.1.toIsIntegral
      haveI : IsNormal T' := hj2.1.2
      haveI : LocallyOfFiniteType (j'' ≫ sV') := hj2.1.1.toLocallyOfFiniteType
      haveI : IsLocallyNoetherian T' := LocallyOfFiniteType.isLocallyNoetherian (j'' ≫ sV')
      haveI : LocallyOfFiniteType (j ≫ sV) := hj.1.1.toLocallyOfFiniteType
      haveI := hj.1.1
      haveI := hj2.1.1
      haveI : CompactSpace G := QuasiCompact.compactSpace_of_compactSpace (j ≫ sV)
      haveI : CompactSpace T' := QuasiCompact.compactSpace_of_compactSpace (j'' ≫ sV')
      have hr2 : Set.range j''.base = (P'.support : Set V') := hr'
      have hdimG : topologicalKrullDim G = d :=
        CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sV j P₀ hrange₀ hd
      obtain ⟨ψ, hψ, hord⟩ := CrepantModelAux.exists_stalk_ringEquiv_of_divisorialValuation_eq φ
        P₀ P' hP' (map_genericPoint_eq_of_range_eq hrange₀) (map_genericPoint_eq_of_range_eq hr2)
      obtain ⟨σT, hσT⟩ :=
        CrepantModelAux.exists_functionFieldEquiv_of_stalk_ringEquiv φ hj hj2 ψ hψ
      have hcrep := CrepantModelAux.isCrepantBirationalMap_of_isAdjunctionStep hX hX' hd hd' hK
        hK' hKB hKB' φ hφ hj hj2 P₀ P' hrange₀ hr2 hP' ψ.toRingHom hψ hord σT hσT
      refine ⟨T', j'', BT', inferInstance, inferInstance, inferInstance, hj2, σT, hcrep,
        fun τ' ρ' hρ' => ?_⟩
      exact CrepantModelAux.isPoincareResidue_pluriformPullback j j'' hd hd' hdimG hdimT'
        φ.toHom σT.toHom ψ.toRingHom hψ (fun a => (hσT a).symm) hord hρ'

/-- The admissibility condition of `t'` for strata of dimension `e`. -/
private def IsCompatibleInDim (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)) (e : ℕ) : Prop :=
  ∀ (Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V V' : Scheme.{0}} {ιV : V ⟶ CY Q}
    {ιV' : V' ⟶ CY Q'} {BV : QDivisor V} {BV' : QDivisor V'}
    (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV'),
    topologicalKrullDim V = e → topologicalKrullDim V' = e →
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    ∀ φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY),
      IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ →
      pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom e m
        (R'.toFun Q' F' e (t' Q')) = R'.toFun Q F e (t' Q)

/-- **Residues of sections are sections.** The Poincaré residue along an adjunction step
`j : T ⟶ Y` of a section of `m(K_Y + C)` on a normal projective variety of dimension `e + 1`, with
`m(K_Y + C)` Cartier, is a section of `m(K_T + B_T)`. -/
private theorem mem_logPluricanonicalSections_of_isPoincareResidue_of_isAdjunctionStep
    {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] (hY : IsNormalVariety ℂ sY) {e m : ℕ}
    (hm : 0 < m) (hdim : topologicalKrullDim Y = ((e + 1 : ℕ) : WithBot ℕ∞)) {C : QDivisor Y}
    {K : Divisor Y} (hK : K.IsCanonicalDivisor sY (e + 1))
    (hmC : ((m : ℤ) • (Divisor.toQDivisor K + C)).IsCartierDivisor) {j : T ⟶ Y} {BT : QDivisor T}
    (hj : IsAdjunctionStep sY C j BT) {τ : RationalPluriForms sY (e + 1) m}
    (hτ : τ ∈ logPluricanonicalSections sY (e + 1) m C) {ρ : RationalPluriForms (j ≫ sY) e m}
    (hρ : IsPoincareResidue sY j e m τ ρ) : ρ ∈ logPluricanonicalSections (j ≫ sY) e m BT := by
  haveI : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  haveI := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  obtain ⟨P, -, hrange, hci, -⟩ := hj.2
  haveI := hci
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace j
  obtain ⟨M, rfl⟩ : ∃ M, m = M + 1 := ⟨m - 1, by omega⟩
  have hne : (⊤ : T.Opens) ≠ ⊥ := by
    intro h0
    have : genericPoint T ∈ (⊤ : T.Opens) := trivial
    rw [h0] at this
    exact this
  rw [mem_logPluricanonicalSections, mem_pluricanonicalSections_of_ne_bot hne]
  intro Γ _ hρ0
  exact le_ordForm_add_roundDown_of_isPoincareResidue hY hdim hK hmC hj P hrange Γ
    (U := ⊤) trivial hτ hρ hρ0

/-- **Iterated residues of sections are sections.** An iterated residue, along a flag of a floor
component of `Y`, of a section of `m(K + B_Q)` is a section of `m(K_V + B_V)` on the final
stratum. -/
private theorem mem_logPluricanonicalSections_of_isIteratedResidueRec
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {τ : RationalPluriForms (jY Q ≫ sY) n m}
    (hτ : τ ∈ logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)) {V : Scheme.{0}}
    {ιV : V ⟶ CY Q} {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    ∀ {e : ℕ} {ρ : RationalPluriForms (ιV ≫ jY Q ≫ sY) e m},
      topologicalKrullDim V = e → IsIteratedResidueRec τ F e ρ →
      ρ ∈ logPluricanonicalSections (ιV ≫ jY Q ≫ sY) e m BV := by
  induction F with
  | refl hP =>
    rintro e ρ - ⟨rfl, hρ⟩
    have : ρ = τ := eq_of_heq hρ
    subst this
    exact hτ
  | @step S T ι BS F j BT hj ih =>
    rintro e ρ hT ⟨ρ₀, h₀, ρ', hr, hρ⟩
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI : IsIntegral T := hj.1.1.toIsIntegral
    haveI : IsNormal T := hj.1.2
    haveI : LocallyOfFiniteType (j ≫ ι ≫ jY Q ≫ sY) := hj.1.1.toLocallyOfFiniteType
    haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ι ≫ jY Q ≫ sY)
    have hdl := (StratumAdjunctionData.step F j BT hj).dim_add_length
      (R'.setting.topologicalKrullDim_eq Q) hT
    have hS : topologicalKrullDim S = ((e + 1 : ℕ) : WithBot ℕ∞) := by
      have h1 := F.dim_add_length (R'.setting.topologicalKrullDim_eq Q)
        (e := (letI := functionFieldAlgebra (ι ≫ jY Q ≫ sY)
          (Algebra.trdeg ℂ S.functionField).toNat))
        (by
          haveI : LocallyOfFiniteType (ι ≫ jY Q ≫ sY) :=
            F.isNormalVariety.1.toLocallyOfFiniteType
          exact topologicalKrullDim_eq_toNat_trdeg (ι ≫ jY Q ≫ sY))
      haveI : LocallyOfFiniteType (ι ≫ jY Q ≫ sY) := F.isNormalVariety.1.toLocallyOfFiniteType
      rw [topologicalKrullDim_eq_toNat_trdeg (ι ≫ jY Q ≫ sY)]
      simp only [StratumAdjunctionData.length] at hdl
      congr 1
      omega
    have h₀' := ih hS h₀
    obtain ⟨d₀, K, hK, hmK⟩ := R'.setting.isCartierDivisor Q F
    have hd₀ : d₀ = e + 1 := by
      have := hK.topologicalKrullDim_eq.symm.trans hS
      exact_mod_cast this
    subst hd₀
    have := mem_logPluricanonicalSections_of_isPoincareResidue_of_isAdjunctionStep
      F.isNormalVariety R'.setting.pos hS hK hmK hj h₀' hr
    have hρρ : ρ = ρ' := eq_of_heq hρ
    subst hρρ
    exact this

/-- A flag of a floor component of `Y` ends at a stratum carrying a canonical divisor `K` of its
dimension with `m(K + B_V)` Cartier. -/
private theorem exists_canonical_cartier_flag
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) {e : ℕ}
    (hV : topologicalKrullDim V = e) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    ∃ K : Divisor V, K.IsCanonicalDivisor (ιV ≫ jY Q ≫ sY) e ∧
      ((m : ℤ) • (Divisor.toQDivisor K + BV)).IsCartierDivisor := by
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  obtain ⟨d₀, K, hK, hmK⟩ := R'.setting.isCartierDivisor Q F
  have hd : d₀ = e := by
    have := hK.topologicalKrullDim_eq.symm.trans hV
    exact_mod_cast this
  subst hd
  exact ⟨K, hK, hmK⟩

/-- **Residue restrictions are sections.** The residue restriction of a section along a flag of
a floor component is a section of `m(K_V + B_V)` on the final stratum. -/
private theorem toFun_mem_logPluricanonicalSections
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q))
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) {e : ℕ}
    (hV : topologicalKrullDim V = e) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    R'.toFun Q F e (t' Q) ∈ logPluricanonicalSections (ιV ≫ jY Q ≫ sY) e m BV := by
  haveI := F.isIntegral_stratum
  exact mem_logPluricanonicalSections_of_isIteratedResidueRec R' Q (t' Q).2 F hV
    (R'.isIteratedResidue Q F e (t' Q) hV).rec'

/-- **Stratum residues of a crepant pull-back, for floor surfaces.** If `Y` is a threefold and
the proper strata of its floor surfaces are compatible, then for floor surfaces `C_Q`, `C_{Q'}`
and a crepant birational map `φ`, `φ^* t'_{Q'} - t'_Q` has zero residue along every adjunction
step of `C_Q`. -/
private theorem isPoincareResidue_pluriformPullback_sub_toFun_of_surface
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q))
    (hlow : ∀ e ≤ 1, IsCompatibleInDim R' t' e)
    (Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V V' : Scheme.{0}} {ιV : V ⟶ CY Q}
    {ιV' : V' ⟶ CY Q'} {BV : QDivisor V} {BV' : QDivisor V'}
    (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV')
    (hl : F.length = 0) (hl' : F'.length = 0) (hn : n = 2)
    (hV : topologicalKrullDim V = (1 + 1 : ℕ)) (hV' : topologicalKrullDim V' = (1 + 1 : ℕ)) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    ∀ φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY),
      IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ →
      ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ V} {BG : QDivisor G},
        IsAdjunctionStep (ιV ≫ jY Q ≫ sY) BV j BG →
        IsPoincareResidue (ιV ≫ jY Q ≫ sY) j 1 m
          (pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom (1 + 1) m
            (R'.toFun Q' F' (1 + 1) (t' Q')) - R'.toFun Q F (1 + 1) (t' Q)) 0 := by
  subst hn
  cases F with
  | step => simp [StratumAdjunctionData.length] at hl
  | refl hQ =>
  cases F' with
  | step => simp [StratumAdjunctionData.length] at hl'
  | refl hQ' =>
  intro φ hφ G _ j BG hj
  have e1 := eq_of_heq (ResidueRestriction.toFun_refl R' Q hQ (t' Q))
  have e2 := eq_of_heq (ResidueRestriction.toFun_refl R' Q' hQ' (t' Q'))
  rw [e1, e2]
  -- `t'` is preadmissible
  have hs : t' ∈ preadmissibleSections R' := by
    intro Q₁ Q₂ S₁ S₂ ι₁ ι₂ B₁ B₂ F₁ F₂ e h₁ h₂ hS₁ hS₂ σ hσ
    have k₁ := F₁.dim_add_length (R'.setting.topologicalKrullDim_eq Q₁) hS₁
    exact hlow e (by omega) Q₁ Q₂ F₁ F₂ hS₁ hS₂ σ hσ
  have hB : ∀ Q₁, 0 ≤ BY Q₁ := fun Q₁ P => (R'.setting.isDltPair Q₁).1.2.1 P
  obtain ⟨K, hK, hmK⟩ := exists_canonical_cartier_flag R' Q (.refl hQ) hV
  obtain ⟨K', hK', hmK'⟩ := exists_canonical_cartier_flag R' Q' (.refl hQ') hV'
  let u : logPluricanonicalSections (jY Q ≫ sY) 2 m (BY Q) :=
    ⟨_, pluriformPullback_mem_logPluricanonicalSections' (StratumAdjunctionData.refl
      (sX := jY Q ≫ sY) hQ).isNormalVariety (StratumAdjunctionData.refl
      (sX := jY Q' ≫ sY) hQ').isNormalVariety hK hK' R'.setting.pos hmK hmK' hφ (t' Q').2⟩
  have hG : topologicalKrullDim G = (1 : ℕ) := by
    obtain ⟨-, P, -, hrange, hci, -⟩ := id hj
    haveI := hci
    haveI : LocallyOfFiniteType (jY Q ≫ sY) := hQ.1.1.toLocallyOfFiniteType
    exact CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support (jY Q ≫ sY) j P hrange hV
  have hfix := (MMP.Fourfold.ResidueRestriction.exists_preadmissible_pluriformPullback_and_toFun_eq
    R' hB φ hφ hs).2 u rfl (.step (.refl hQ) j BG hj) 1 (by simp [StratumAdjunctionData.length])
    hG
  obtain ⟨ρ₀, ⟨-, hρ₀⟩, ρ, hr, hρ⟩ := (R'.isIteratedResidue Q (.step (.refl hQ) j BG hj) 1 u hG).rec'
  obtain ⟨ρ₀', ⟨-, hρ₀'⟩, ρ', hr', hρ'⟩ :=
    (R'.isIteratedResidue Q (.step (.refl hQ) j BG hj) 1 (t' Q) hG).rec'
  have f0 : ρ₀ = (u : RationalPluriForms (jY Q ≫ sY) 2 m) := eq_of_heq hρ₀
  have f0' : ρ₀' = (t' Q : RationalPluriForms (jY Q ≫ sY) 2 m) := eq_of_heq hρ₀'
  have f1 : R'.toFun Q (.step (.refl hQ) j BG hj) 1 u = ρ := eq_of_heq hρ
  have f2 : R'.toFun Q (.step (.refl hQ) j BG hj) 1 (t' Q) = ρ' := eq_of_heq hρ'
  rw [f1, f2] at hfix
  subst hfix
  rw [f0] at hr
  rw [f0'] at hr'
  obtain ⟨-, P, -, hrange, hci, -⟩ := id hj
  haveI := hci
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hQ.1.1.toLocallyOfFiniteType
  have hsub := IsPoincareResidue.add_of_isClosedImmersion P (map_genericPoint_eq_of_range_eq hrange)
    (by exact_mod_cast hV) hr (IsPoincareResidue.const_smul hr' (-1))
  convert hsub using 1
  · change _ = (u : RationalPluriForms (jY Q ≫ sY) 2 m) + (-1 : ℂ) • _
    rw [neg_one_smul, ← sub_eq_add_neg]
    rfl
  · rw [neg_one_smul, add_neg_cancel]

/-- **Stratum residues of a crepant pull-back.** If the strata of dimension at most `d` are
compatible,
then for strata `V`, `V'` of dimension `d + 1` and a crepant birational map `φ : V ⇢ V'`, the
difference `φ^* R'_{F'}(t'_{Q'}) - R'_F(t'_Q)` has zero residue along every adjunction step of
`V`. -/
private theorem isPoincareResidue_pluriformPullback_sub_toFun
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)) {d : ℕ}
    (hlow : ∀ e ≤ d, IsCompatibleInDim R' t' e)
    (Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V V' : Scheme.{0}} {ιV : V ⟶ CY Q}
    {ιV' : V' ⟶ CY Q'} {BV : QDivisor V} {BV' : QDivisor V'}
    (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV')
    (hV : topologicalKrullDim V = (d + 1 : ℕ)) (hV' : topologicalKrullDim V' = (d + 1 : ℕ)) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    ∀ φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY),
      IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ →
      ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ V} {BG : QDivisor G},
        IsAdjunctionStep (ιV ≫ jY Q ≫ sY) BV j BG →
        IsPoincareResidue (ιV ≫ jY Q ≫ sY) j d m
          (pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom (d + 1) m
            (R'.toFun Q' F' (d + 1) (t' Q')) - R'.toFun Q F (d + 1) (t' Q)) 0 := by
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  haveI := F'.isIntegral_stratum
  haveI := F'.isNormal_stratum
  haveI := F'.isLocallyNoetherian_stratum
  intro φ hφ G _ j BG hj
  have hX := F.isNormalVariety
  have hX' := F'.isNormalVariety
  haveI : LocallyOfFiniteType (ιV ≫ jY Q ≫ sY) := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ιV' ≫ jY Q' ≫ sY) := hX'.1.toLocallyOfFiniteType
  haveI := F.isClosedImmersion
  haveI := F'.isClosedImmersion
  haveI := (S.hjY Q).1.exists_primeDivisor.choose_spec.2
  haveI := (S.hjY Q').1.exists_primeDivisor.choose_spec.2
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  obtain ⟨-, P, hP1, hrange, hci, -⟩ := id hj
  haveI := hci
  haveI : IsNormal G := hj.1.2
  haveI : LocallyOfFiniteType (j ≫ ιV ≫ jY Q ≫ sY) := hj.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ιV ≫ jY Q ≫ sY)
  have hdl := isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q) F
  have hdl' := isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q') F'
  obtain ⟨K, hK, hmK⟩ := exists_canonical_cartier_flag R' Q F hV
  obtain ⟨K', hK', hmK'⟩ := exists_canonical_cartier_flag R' Q' F' hV'
  have hKB : (Divisor.toQDivisor K + BV).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := hmK
    exact ⟨m, by exact_mod_cast R'.setting.pos.ne', D, hD, hDc⟩
  have hKB' : (Divisor.toQDivisor K' + BV').IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := hmK'
    exact ⟨m, by exact_mod_cast R'.setting.pos.ne', D, hD, hDc⟩
  have hG : topologicalKrullDim G = d :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support (ιV ≫ jY Q ≫ sY) j P hrange hV
  -- the divisor over `V'` corresponding to `P`
  set DΓ := DivisorOver.ofPrimeDivisor ℂ hX P
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hdl.1.1 hK DΓ
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 V) by infer_instance)
  obtain ⟨n', D, hDv, hDlog⟩ := (hφ DΓ.valuation (1 + c)).mp ⟨d + 1, DΓ, rfl, hlog⟩
  have hv : ∀ g, D.valuation g = P.divisorialValuation ((φ.toHom) g) := by
    intro g
    rw [hDv]
    change P.divisorialValuation (functionFieldMap (𝟙 V) _) = _
    rw [functionFieldMap_id_apply]
    rfl
  by_cases hex : ∃ P' : Mori.PrimeDivisor V',
      D.valuation = (DivisorOver.ofPrimeDivisor ℂ hX' P').valuation
  swap
  · -- the centre of `D` has codimension two, so `V`, `V'` are floor surfaces
    have h2 : 2 ≤ Order.coheight (D.f D.E.genericPoint) := by
      rw [← MMP.Positivity.DivisorOver.codimension_center]
      exact (MMP.Positivity.DivisorOver.two_le_codimension_center_iff hX' D).mpr
        fun P' h => hex ⟨P', h⟩
    have hle := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
    rw [hV'] at hle
    have h4 : 2 ≤ d + 1 := by
      have : ((2 : ℕ∞) : WithBot ℕ∞) ≤ ((d + 1 : ℕ) : WithBot ℕ∞) :=
        le_trans (by exact_mod_cast h2) hle
      exact_mod_cast this
    have hl := F.dim_add_length (R'.setting.topologicalKrullDim_eq Q) hV
    have hl' := F'.dim_add_length (R'.setting.topologicalKrullDim_eq Q') hV'
    have hn := S.hn
    obtain rfl : d = 1 := by omega
    exact isPoincareResidue_pluriformPullback_sub_toFun_of_surface S R' t' hlow Q Q' F F'
      (by omega) (by omega) (by omega) hV hV' φ hφ hj
  obtain ⟨P', hP'⟩ := hex
  have hP'v : ∀ g, P'.divisorialValuation g = P.divisorialValuation ((φ.toHom) g) := by
    intro g
    rw [← hv, hP']
    change _ = P'.divisorialValuation (functionFieldMap (𝟙 V') g)
    rw [functionFieldMap_id_apply]
  obtain ⟨G', j', BG', _, _, _, hj', σT, hcrep, hres⟩ :=
    exists_isAdjunctionStep_isPoincareResidue_pluriformPullback hdl hdl' hV hV' hK hK' hKB hKB' φ
      hφ hj P hrange P' hP'v
  obtain ⟨-, P'', -, hrange', hci', -⟩ := id hj'
  haveI := hci'
  have hG' : topologicalKrullDim G' = d :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support (ιV' ≫ jY Q' ≫ sY) j' P'' hrange'
      hV'
  -- the residues along the two adjunction steps
  obtain ⟨ρ₀, h₀, ρ, hr, hρ⟩ := (R'.isIteratedResidue Q (F.step j BG hj) d (t' Q) hG).rec'
  have e₀ := IsIteratedResidueRec.unique F h₀ (R'.isIteratedResidue Q F (d + 1) (t' Q) hV).rec'
  obtain ⟨ρ₀', h₀', ρ'', hr', hρ'⟩ :=
    (R'.isIteratedResidue Q' (F'.step j' BG' hj') d (t' Q') hG').rec'
  have e₀' :=
    IsIteratedResidueRec.unique F' h₀' (R'.isIteratedResidue Q' F' (d + 1) (t' Q') hV').rec'
  rw [e₀] at hr
  rw [e₀'] at hr'
  have hA := hres _ _ hr'
  have hlowapp := hlow d le_rfl Q Q' (F.step j BG hj) (F'.step j' BG' hj') hG hG' σT hcrep
  have e1 : R'.toFun Q (F.step j BG hj) d (t' Q) = ρ := eq_of_heq hρ
  have e2 : R'.toFun Q' (F'.step j' BG' hj') d (t' Q') = ρ'' := eq_of_heq hρ'
  rw [e1, e2] at hlowapp
  have hl2 : pluriformPullback (j ≫ ιV ≫ jY Q ≫ sY) (j' ≫ ιV' ≫ jY Q' ≫ sY) σT.toHom d m ρ'' =
      ρ := hlowapp
  rw [hl2] at hA
  have hsub := IsPoincareResidue.add_of_isClosedImmersion P (map_genericPoint_eq_of_range_eq hrange)
    (by exact_mod_cast hV) hA (IsPoincareResidue.const_smul hr (-1))
  rwa [neg_one_smul, neg_one_smul, ← sub_eq_add_neg, ← sub_eq_add_neg, sub_self] at hsub

/-- **Sections against a global log generator.** On a normal variety `T` of dimension `d + 1`,
proper over `ℂ`, let `ω` be a top form with `div ω + B_T = 0`. Then every section of
`m(K_T + B_T)` is a constant multiple of `ω^{⊗m}`. -/
private theorem exists_eq_smul_formPow_of_divisorOfForm_add_eq_zero {T : Scheme.{0}}
    (sT : T ⟶ Spec (.of ℂ)) [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    [LocallyOfFiniteType sT] [IsProper sT] {d : ℕ} (hd : topologicalKrullDim T = (d + 1 : ℕ))
    {ω : letI := functionFieldAlgebra sT; ⋀[T.functionField]^(d + 1) Ω[T.functionField⁄ℂ]}
    (hω0 : ω ≠ 0) {BT : QDivisor T}
    (hω : letI := functionFieldAlgebra sT; ∀ Γ : Mori.PrimeDivisor T,
      (Γ.ordForm (show RationalPluriForms sT (d + 1) ((1 : ℕ) : ℤ) from formPow ω 1) : ℚ) +
        BT.coeff Γ = 0)
    {m : ℕ} {δ : RationalPluriForms sT (d + 1) m}
    (hδ : δ ∈ logPluricanonicalSections sT (d + 1) m BT) :
    letI := functionFieldAlgebra sT
    ∃ c : ℂ, δ = c • (show RationalPluriForms sT (d + 1) m from formPow ω m) := by
  letI := functionFieldAlgebra sT
  by_cases hδ0 : δ = 0
  · exact ⟨0, by rw [hδ0, zero_smul]⟩
  have hne : (show RationalPluriForms sT (d + 1) m from formPow ω m) ≠ 0 := by
    have := CrepantModelAux.smul_formPow_ne_zero (sX := sT) hd hω0 (one_ne_zero) m
    rwa [one_smul] at this
  obtain ⟨f, hf'⟩ := exists_eq_smul_of_ne_zero (sY := sT) (by exact_mod_cast hd) hne δ
  have hf : δ = (show RationalPluriForms sT (d + 1) m from f • formPow ω m) := hf'
  have hf0 : f ≠ 0 := fun h0 => hδ0 (by rw [hf, h0, zero_smul]; rfl)
  have hord : ∀ Γ : Mori.PrimeDivisor T, 0 ≤ T.ord f Γ.genericPoint := by
    intro Γ
    have h1 := hδ
    rw [mem_logPluricanonicalSections, mem_pluricanonicalSections_of_ne_bot top_ne_bot] at h1
    have h2 := h1 Γ ⟨Γ.genericPoint, by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl, trivial⟩ hδ0
    rw [hf, CrepantModelAux.ordForm_smul_formPow hd Γ hω0 hf0 m,
      DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul] at h2
    have h3 := hω Γ
    set o := Γ.ordForm (show RationalPluriForms sT (d + 1) ((1 : ℕ) : ℤ) from formPow ω 1)
    have h4 : BT.coeff Γ = -((o : ℤ) : ℚ) := by linarith
    rw [h4, zsmul_eq_mul] at h2
    have h5 : ((m : ℤ) : ℚ) * -((o : ℤ) : ℚ) = ((-(m * o) : ℤ) : ℚ) := by push_cast; ring
    rw [h5, Int.floor_intCast] at h2
    linarith
  obtain ⟨c, hc⟩ := CrepantModelAux.exists_eq_algebraMap_of_forall_zero_le_ord sT f hord
  exact ⟨c, by rw [RationalPluriForms.smul_def, hf, hc]; rfl⟩

/-- **Detection on a floor curve contracted to a point.** Let `σ : (S, B) ⇢ (S', B')` be a
crepant birational map of normal surfaces proper over `ℂ`, with `(S', B')` dlt and
`m'(K_{S'} + B')` Cartier, and let `T ⟶ S` be an adjunction step onto a curve `P` of coefficient
one, with `(T, B_T)` dlt, whose valuation is that of an exceptional divisor `D` of discrepancy `-1`
over `S'`. Then a section of `m(K_T + B_T)` with zero residue at every adjunction step of `T` is
zero: `T` carries the global log generator `dlog ē`, the residue of `σ^*(dlog z₁ ∧ dlog z₂)` for
snc coordinates at the centre of `D`, every section is a constant multiple of `(dlog ē)^{⊗m}`, and
the residue of `(dlog ē)^{⊗m}` at a zero of `ē` is `1`. -/
private theorem eq_zero_of_isPoincareResidue_zero_of_isExceptional_curve
    {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] [LocallyOfFiniteType sS]
    [IsProper sS] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S'] [CompactSpace S']
    [LocallyOfFiniteType sS'] [IsProper sS']
    (hS : IsNormalVariety ℂ sS) (hS' : IsNormalVariety ℂ sS')
    (hdS : topologicalKrullDim S = (1 + 1 : ℕ)) (hdS' : topologicalKrullDim S' = (1 + 1 : ℕ))
    {B : QDivisor S} {B' : QDivisor S'} {K : Divisor S} {K' : Divisor S'}
    (hK : K.IsCanonicalDivisor sS (1 + 1)) (hK' : K'.IsCanonicalDivisor sS' (1 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) {m' : ℕ} (hm' : 0 < m')
    (hmK' : ((m' : ℤ) • (Divisor.toQDivisor K' + B')).IsCartierDivisor)
    (hdlt' : MMP.Intersection.IsDltPair sS' B')
    (σ : FunctionFieldEquiv sS sS') (hσ : IsCrepantBirationalMap sS sS' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ S} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sS B ι BT)
    (hdltT : MMP.Intersection.IsDltPair (ι ≫ sS) BT)
    (P : Mori.PrimeDivisor S) (hrP : Set.range ι.base = (P.support : Set S)) (hP1 : B.coeff P = 1)
    (D : DivisorOver ℂ sS') (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    (hD : D.IsExceptional) (hDp : IsProper D.f)
    (hDdisc : MMP.Mori.IsDiscrepancy sS' (1 + 1) K' B' D (-1))
    {m : ℕ} (hm : 0 < m) {δ : RationalPluriForms (ι ≫ sS) 1 m}
    (hδ : δ ∈ logPluricanonicalSections (ι ≫ sS) 1 m BT)
    (hres : ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ T} {BG : QDivisor G},
      IsAdjunctionStep (ι ≫ sS) BT j BG → IsPoincareResidue (ι ≫ sS) j 0 m δ 0) : δ = 0 := by
  classical
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  have hm0' : (m' : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hKB' : (Divisor.toQDivisor K' + B').IsQCartier := ⟨_, hm0', hmK'⟩
  -- snc coordinates at the centre, a closed point
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt'
      ⟨hS', hK', hKB'⟩ D hDp hDdisc
  have hcoh : Order.coheight (D.f D.E.genericPoint) = cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    exact WithBot.coe_injective h2
  have hcc : cc = 2 := by
    have h3 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight
      hS' D).mp hD
    have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
    rw [hdS', hcoh] at h5
    rw [hcoh] at h3
    have h7 : cc ≤ 1 + 1 := by exact_mod_cast (WithBot.coe_le_coe.mp h5)
    have h8 : 2 ≤ cc := by exact_mod_cast h3
    omega
  subst hcc
  have hxcl : IsClosed ({D.f D.E.genericPoint} : Set S') :=
    CrepantModelAux.isClosed_singleton_of_le_coheight (d := 2) hdS'.le (by rw [hcoh])
  have hresk := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sS' (D.f D.E.genericPoint) hxcl
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sS'
    (D.f D.E.genericPoint) hxcl
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  letI := stalkAlgebra sS' (D.f D.E.genericPoint)
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sS' hsm
  haveI : Module.Finite (S'.presheaf.stalk (D.f D.E.genericPoint))
      Ω[S'.presheaf.stalk (D.f D.E.genericPoint)⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  -- the snc log generator `τ'` and an open on which it generates
  obtain ⟨U, hxU, hU⟩ := CrepantModelAux.exists_open_coeff_divisorOfForm_add_eq_zero hdS' z hz hsm
    hres' L hL hLx hLz hBL hL1
  set τ' : RationalPluriForms sS' (1 + 1) ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
    S'.functionField (1 + 1) fun a => (algebraMap _ S'.functionField (z a))⁻¹ •
      KaehlerDifferential.D ℂ _ (algebraMap _ S'.functionField (z a))) 1 with hτ'
  have hτ'0 : τ' ≠ 0 := by
    intro h0
    have := CrepantModelAux.ordForm_formPow_dlog_eq hdS' 1 z hz0 hw L hL hLx hLz (L 0) (hLx 0)
    rw [if_pos ⟨0, rfl⟩] at this
    change (L 0).ordForm τ' = _ at this
    rw [h0, Mori.PrimeDivisor.ordForm_zero] at this
    exact absurd this (by decide)
  have hDU : (D.center : Set S') ⊆ U := by
    rw [D.center_eq_closure_genericPoint, hxcl.closure_eq, Set.singleton_subset_iff]
    exact hxU
  obtain ⟨-, hθall⟩ := CrepantModelAux.divisorOfForm_add_eq_zero_of_center_subset (n := 1) hS hS'
    hdS hdS' one_pos hK hK' hKB hKB' σ hσ hι P hrP hP1 D hDv hτ'0 U hDU hU
  -- the monomial frame along `P`
  have hP : ι (genericPoint T) = P.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq ι P hrP
  have hvD : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      D.valuation (algebraMap _ S'.functionField r) ≤ 1 := by
    intro r
    by_cases hr : r = 0
    · rw [hr, map_zero, map_zero]; exact zero_le'
    obtain ⟨M, -, hM⟩ := hmono r hr
    rw [hM, ← WithZero.exp_zero, WithZero.exp_le_exp]
    omega
  have hle : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) ≤ 1 :=
    fun r => by rw [← hDv]; exact hvD r
  have hlt : ∀ r ∈ IsLocalRing.maximalIdeal (S'.presheaf.stalk (D.f D.E.genericPoint)),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) < 1 := by
    intro r hr
    rw [← hDv]
    have h1 : r ∈ weightedMonomialIdeal z α 1 := by
      have := CrepantModelAux.span_range_le_weightedMonomialIdeal_one z α hα
      rw [hz.1] at this
      exact this hr
    have h2 := CrepantModelAux.valuation_le_of_mem_weightedMonomialIdeal z α D.valuation hvD hzv h1
    refine h2.trans_lt ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  obtain ⟨t, e', he', ht, hfr, hgen⟩ := CrepantModelAux.exists_monomialFrame_two ι P hP σ z α hz0
    hle hlt (fun a => by rw [← hDv]; exact hzv a)
    (fun f hf => by
      obtain ⟨M, hM, hMv⟩ := hmono f hf
      exact ⟨M, hM, by rw [← hDv]; exact hMv⟩) hresk
  have hpull1 : pluriformPullback sS sS' σ.toHom (1 + 1) 1 τ' =
      formPow (exteriorPower.ιMulti S.functionField (1 + 1)
        (Fin.cons ((algebraMap _ S.functionField t)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField t))
          fun b => (algebraMap _ S.functionField (e' b))⁻¹ •
            KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField (e' b)))) 1 := by
    have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
      (fun a => algebraMap _ _ (z a)) 1 1
    rw [one_smul, map_one, one_smul, hfr] at h1
    exact h1
  have hres1 := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι 1 t e' he' ht
  have hθ0 := hθall _ (by rw [hpull1]; exact hres1)
  -- the global log generator `dlog ē` of `(T, B_T)`
  letI := functionFieldAlgebra (ι ≫ sS)
  set w : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 0) with hwdef
  have hθfun : (fun i : Fin 1 => ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ •
      KaehlerDifferential.D ℂ T.functionField ((ι.stalkMap (genericPoint T)).hom (e' i))) =
      ![w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
    funext i; fin_cases i; rfl
  have hψ : ∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 1
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 1
        ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) + BT.coeff Γ = 0 := by
    intro Γ
    have := congrArg (fun G : QDivisor T => G.coeff Γ) hθ0
    simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm,
      DivisorWithCoeffs.coeff_zero] at this
    rw [← hθfun]
    exact this
  have hw0 : w ≠ 0 := ((he' 0).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hgen' : IntermediateField.adjoin ℂ ({w} : Set T.functionField) = ⊤ := by
    rw [← hgen]
    congr 1
    ext y
    simp [hwdef, eq_comm]
  have hdT : topologicalKrullDim T = (1 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sS ι P hrP hdS
  obtain ⟨Tq, ιq, Bq, hq, _, -, hresq⟩ :=
    CrepantModelAux.exists_isAdjunctionStep_residue_dlog_of_curve hι.1 hdT hdltT w hw0 hgen' hψ
  obtain ⟨Pq, hPq, hciq⟩ := hq.exists_primeDivisor
  haveI := hciq
  letI := functionFieldAlgebra (ιq ≫ ι ≫ sS)
  -- every section is a constant multiple of `(dlog ē)^{⊗m}`
  have hω0 : exteriorPower.ιMulti T.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w] ≠ 0 := by
    intro h0
    have h1 := hresq 1
    rw [h0] at h1
    have h2 : (formPow (0 : ⋀[T.functionField]^1 Ω[T.functionField⁄ℂ]) 1 :
        RationalPluriForms (ι ≫ sS) 1 ((1 : ℕ) : ℤ)) = 0 := by
      unfold formPow
      exact (PiTensorProduct.tprod _).map_coord_zero (0 : Fin 1) rfl
    rw [h2] at h1
    exact CrepantModelAux.formPow_ιMulti_zero_ne_zero (k := ℂ) (K := Tq.functionField) 1
      (IsPoincareResidue.unique hq h1 (isPoincareResidue_zero_of_isClosedImmersion
        Pq hPq (n := 0) (m := 1)))
  obtain ⟨c, hc⟩ := exists_eq_smul_formPow_of_divisorOfForm_add_eq_zero (ι ≫ sS) (d := 0) hdT hω0
    hψ hδ
  have h1 := CrepantModelAux.IsPoincareResidue.smul_const (hresq m) c
  rw [← hc] at h1
  have h2 := IsPoincareResidue.unique hq h1 (hres hq)
  have hc0 : c = 0 := by
    by_contra hc0
    exact CrepantModelAux.formPow_ιMulti_zero_ne_zero (k := ℂ) (K := Tq.functionField) m
      ((smul_eq_zero.mp h2).resolve_left hc0)
  rw [hc, hc0, zero_smul]

/-- **Adjunction to a coefficient-one prime divisor of a dlt pair.** Every prime divisor `L` with
`coeff_L B ≥ 1` of a dlt pair `(Z, B)` of dimension `e + 1` is the image of an adjunction step
`T ⟶ Z` with `dim T = e`. -/
private theorem exists_isAdjunctionStep_of_isDltPair_of_one_le_coeff {Z : Scheme.{0}}
    {sZ : Z ⟶ Spec (.of ℂ)} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {BZ : QDivisor Z} (hdlt : MMP.Intersection.IsDltPair sZ BZ) {e : ℕ}
    (hdim : topologicalKrullDim Z = (e + 1 : ℕ)) (L : MMP.Mori.PrimeDivisor Z)
    (hL : 1 ≤ BZ.coeff L) :
    ∃ (T : Scheme.{0}) (ι : T ⟶ Z) (BT : QDivisor T) (_ : IsAdjunctionStep sZ BZ ι BT)
      (_ : IsIntegral T), Set.range ι.base = (L.support : Set Z) ∧ topologicalKrullDim T = e := by
  have hX := hdlt.1.1.1
  haveI : LocallyOfFiniteType sZ := hX.1.toLocallyOfFiniteType
  have hstr : IsDltStratum sZ BZ (L.support : Set Z) := by
    refine ⟨hdlt, {L}, Finset.singleton_nonempty _, by simpa using hL, ?_, ?_⟩
    · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
      exact ⟨L.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
    · simp only [Finset.mem_singleton, Set.iInter_iInter_eq_left]
      refine ⟨⟨?_, le_rfl⟩, fun T hT _ => hT.2⟩
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
  obtain ⟨⟨⟨T', ι', BT', hr', ⟨F'⟩⟩, -⟩, -⟩ := hstr.exists_isStratumAdjunctionPair_and_isDltPair
  haveI := F'.isIntegral_stratum
  haveI := F'.isClosedImmersion
  have hdimT' : topologicalKrullDim T' = e :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sZ ι' L hr' hdim
  have hlen := F'.dim_add_length hdim hdimT'
  cases F' with
  | refl h' => simp [StratumAdjunctionData.length] at hlen
  | step F'' j'' BT'' hj'' =>
    cases F'' with
    | step F3 _ _ _ => simp [StratumAdjunctionData.length] at hlen <;> omega
    | refl h' =>
      have hj : IsAdjunctionStep sZ BZ j'' BT' := by simpa only [Category.id_comp] using hj''
      exact ⟨T', j'', BT', hj, inferInstance, hr', hdimT'⟩

/-- **Detection on a floor surface contracted to a point.** Let `σ : (S, B) ⇢ (S', B')` be a
crepant birational map of normal threefolds proper over `ℂ`, with `(S', B')` dlt and
`m'(K_{S'} + B')` Cartier, and let `T ⟶ S` be an adjunction step onto a surface `P` of coefficient
one, with `(T, B_T)` dlt, whose valuation is that of a divisor `D` of discrepancy `-1` over `S'`
centred at a closed point. Then a section of `m(K_T + B_T)` with zero residue along every
adjunction step of `T` is zero: `T` carries the global log generator `dlog ē₁ ∧ dlog ē₂`, the
residue of `σ^*(dlog z₁ ∧ dlog z₂ ∧ dlog z₃)`, every section is a constant multiple of its `m`-th
power, which has a pole of order `m` along a floor curve of `(T, B_T)`. -/
private theorem eq_zero_of_isPoincareResidue_zero_of_isExceptional_surface_point
    {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] [LocallyOfFiniteType sS]
    [IsProper sS] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S'] [CompactSpace S']
    [LocallyOfFiniteType sS'] [IsProper sS']
    (hS : IsNormalVariety ℂ sS) (hS' : IsNormalVariety ℂ sS')
    (hdS : topologicalKrullDim S = (2 + 1 : ℕ)) (hdS' : topologicalKrullDim S' = (2 + 1 : ℕ))
    {B : QDivisor S} {B' : QDivisor S'} {K : Divisor S} {K' : Divisor S'}
    (hK : K.IsCanonicalDivisor sS (2 + 1)) (hK' : K'.IsCanonicalDivisor sS' (2 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) {m' : ℕ} (hm' : 0 < m')
    (hmK' : ((m' : ℤ) • (Divisor.toQDivisor K' + B')).IsCartierDivisor)
    (hdlt' : MMP.Intersection.IsDltPair sS' B')
    (σ : FunctionFieldEquiv sS sS') (hσ : IsCrepantBirationalMap sS sS' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ S} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sS B ι BT)
    (hdltT : MMP.Intersection.IsDltPair (ι ≫ sS) BT)
    (P : Mori.PrimeDivisor S) (hrP : Set.range ι.base = (P.support : Set S)) (hP1 : B.coeff P = 1)
    (D : DivisorOver ℂ sS') (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    (hDp : IsProper D.f) (hDdisc : MMP.Mori.IsDiscrepancy sS' (2 + 1) K' B' D (-1))
    (hpt : Order.coheight (D.f D.E.genericPoint) = 3)
    {m : ℕ} (hm : 0 < m) {δ : RationalPluriForms (ι ≫ sS) 2 m}
    (hδ : δ ∈ logPluricanonicalSections (ι ≫ sS) 2 m BT)
    (hres : ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ T} {BG : QDivisor G},
      IsAdjunctionStep (ι ≫ sS) BT j BG → IsPoincareResidue (ι ≫ sS) j 1 m δ 0) : δ = 0 := by
  classical
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  have hm0' : (m' : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hKB' : (Divisor.toQDivisor K' + B').IsQCartier := ⟨_, hm0', hmK'⟩
  -- snc coordinates at the centre, a closed point
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt'
      ⟨hS', hK', hKB'⟩ D hDp hDdisc
  have hcoh : Order.coheight (D.f D.E.genericPoint) = cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    exact WithBot.coe_injective h2
  have hcc : cc = 3 := by
    rw [hpt] at hcoh
    exact_mod_cast hcoh.symm
  subst hcc
  have hxcl : IsClosed ({D.f D.E.genericPoint} : Set S') :=
    CrepantModelAux.isClosed_singleton_of_le_coheight (d := 3) hdS'.le (by rw [hcoh])
  have hresk := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sS' (D.f D.E.genericPoint) hxcl
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sS'
    (D.f D.E.genericPoint) hxcl
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  letI := stalkAlgebra sS' (D.f D.E.genericPoint)
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sS' hsm
  haveI : Module.Finite (S'.presheaf.stalk (D.f D.E.genericPoint))
      Ω[S'.presheaf.stalk (D.f D.E.genericPoint)⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  obtain ⟨U, hxU, hU⟩ := CrepantModelAux.exists_open_coeff_divisorOfForm_add_eq_zero hdS' z hz hsm
    hres' L hL hLx hLz hBL hL1
  set τ' : RationalPluriForms sS' (2 + 1) ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
    S'.functionField (2 + 1) fun a => (algebraMap _ S'.functionField (z a))⁻¹ •
      KaehlerDifferential.D ℂ _ (algebraMap _ S'.functionField (z a))) 1 with hτ'
  have hτ'0 : τ' ≠ 0 := by
    intro h0
    have := CrepantModelAux.ordForm_formPow_dlog_eq hdS' 1 z hz0 hw L hL hLx hLz (L 0) (hLx 0)
    rw [if_pos ⟨0, rfl⟩] at this
    change (L 0).ordForm τ' = _ at this
    rw [h0, Mori.PrimeDivisor.ordForm_zero] at this
    exact absurd this (by decide)
  have hDU : (D.center : Set S') ⊆ U := by
    rw [D.center_eq_closure_genericPoint, hxcl.closure_eq, Set.singleton_subset_iff]
    exact hxU
  obtain ⟨-, hθall⟩ := CrepantModelAux.divisorOfForm_add_eq_zero_of_center_subset (n := 2) hS hS'
    hdS hdS' (by norm_num) hK hK' hKB hKB' σ hσ hι P hrP hP1 D hDv hτ'0 U hDU hU
  have hP : ι (genericPoint T) = P.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq ι P hrP
  have hvD : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      D.valuation (algebraMap _ S'.functionField r) ≤ 1 := by
    intro r
    by_cases hr : r = 0
    · rw [hr, map_zero, map_zero]; exact zero_le'
    obtain ⟨M, -, hM⟩ := hmono r hr
    rw [hM, ← WithZero.exp_zero, WithZero.exp_le_exp]
    omega
  have hle : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) ≤ 1 :=
    fun r => by rw [← hDv]; exact hvD r
  have hlt : ∀ r ∈ IsLocalRing.maximalIdeal (S'.presheaf.stalk (D.f D.E.genericPoint)),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) < 1 := by
    intro r hr
    rw [← hDv]
    have h1 : r ∈ weightedMonomialIdeal z α 1 := by
      have := CrepantModelAux.span_range_le_weightedMonomialIdeal_one z α hα
      rw [hz.1] at this
      exact this hr
    have h2 := CrepantModelAux.valuation_le_of_mem_weightedMonomialIdeal z α D.valuation hvD hzv h1
    refine h2.trans_lt ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  obtain ⟨t, e', he', ht, hfr, hgen⟩ := CrepantModelAux.exists_monomialFrame ι P hP σ z α hz0
    hle hlt (fun a => by rw [← hDv]; exact hzv a)
    (fun f hf => by
      obtain ⟨M, hM, hMv⟩ := hmono f hf
      exact ⟨M, hM, by rw [← hDv]; exact hMv⟩) hresk
  have hpull1 : pluriformPullback sS sS' σ.toHom (2 + 1) 1 τ' =
      formPow (exteriorPower.ιMulti S.functionField (2 + 1)
        (Fin.cons ((algebraMap _ S.functionField t)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField t))
          fun b => (algebraMap _ S.functionField (e' b))⁻¹ •
            KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField (e' b)))) 1 := by
    have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
      (fun a => algebraMap _ _ (z a)) 1 1
    rw [one_smul, map_one, one_smul, hfr] at h1
    exact h1
  have hres1 := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι 1 t e' he' ht
  have hθ0 := hθall _ (by rw [hpull1]; exact hres1)
  -- the global log generator `dlog ē₁ ∧ dlog ē₂` of `(T, B_T)`
  letI := functionFieldAlgebra (ι ≫ sS)
  set u : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 0) with hudef
  set w : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 1) with hwdef
  have hθfun : (fun i : Fin 2 => ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ •
      KaehlerDifferential.D ℂ T.functionField ((ι.stalkMap (genericPoint T)).hom (e' i))) =
      ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
    funext i; fin_cases i <;> rfl
  have hψ : ∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 2
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 2
        ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) +
        BT.coeff Γ = 0 := by
    intro Γ
    have := congrArg (fun G : QDivisor T => G.coeff Γ) hθ0
    simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm,
      DivisorWithCoeffs.coeff_zero] at this
    rw [← hθfun]
    exact this
  have hu0 : u ≠ 0 := ((he' 0).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hw0 : w ≠ 0 := ((he' 1).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hgen' : IntermediateField.adjoin ℂ ({u, w} : Set T.functionField) = ⊤ := by
    rw [← hgen]
    congr 1
    ext y
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range, Fin.exists_fin_two,
      hudef, hwdef]
    tauto
  have hdT : topologicalKrullDim T = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sS ι P hrP hdS
  have hT : IsNormalVariety ℂ (ι ≫ sS) := hι.1
  -- a floor curve along which the generator has a pole
  obtain ⟨Cc, hCc, hCc1⟩ :=
    CrepantModelAux.exists_primeDivisor_ordForm_dlog_eq_neg_one hT hdT hdltT u w hu0 hw0 hgen' hψ
  obtain ⟨Gc, jc, BGc, hjc, _, hrc, hdGc⟩ :=
    exists_isAdjunctionStep_of_isDltPair_of_one_le_coeff hdltT (e := 1) hdT Cc hCc1.ge
  obtain ⟨Pc, hPc, hcic⟩ := hjc.exists_primeDivisor
  haveI := hcic
  have hPcC : Pc = Cc := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hPc.symm.trans (CrepantModelAux.map_genericPoint_eq_of_range_eq jc Cc hrc))
  subst hPcC
  haveI : LocallyOfFiniteType (ι ≫ sS) := hT.1.toLocallyOfFiniteType
  -- every section is a constant multiple of the `m`-th power of the generator
  have hω0 : exteriorPower.ιMulti T.functionField 2
      ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w] ≠ 0 := by
    intro h0
    rw [h0] at hCc
    have h2 : (formPow (0 : ⋀[T.functionField]^2 Ω[T.functionField⁄ℂ]) 1 :
        RationalPluriForms (ι ≫ sS) 2 ((1 : ℕ) : ℤ)) = 0 := by
      unfold formPow
      exact (PiTensorProduct.tprod _).map_coord_zero (0 : Fin 1) rfl
    rw [h2] at hCc
    change Pc.ordForm (0 : RationalPluriForms (ι ≫ sS) 2 ((1 : ℕ) : ℤ)) = -1 at hCc
    rw [Mori.PrimeDivisor.ordForm_zero] at hCc
    exact absurd hCc (by decide)
  obtain ⟨c, hc⟩ := exists_eq_smul_formPow_of_divisorOfForm_add_eq_zero (ι ≫ sS) (d := 1) hdT hω0
    hψ hδ
  by_contra hδ0
  have hc0 : c ≠ 0 := fun h0 => hδ0 (by rw [hc, h0, zero_smul])
  -- the order of `δ` along the floor curve is `-m`
  have hord : Pc.ordForm δ = -(m : ℤ) := by
    rw [hc, ordForm_const_smul Pc hc0]
    have h1 := CrepantModelAux.ordForm_smul_formPow (sX := ι ≫ sS) hdT Pc hω0 one_ne_zero m
    rw [one_smul, Scheme.ord_one, zero_add] at h1
    change Pc.ordForm (show RationalPluriForms (ι ≫ sS) 2 m from formPow _ m) = _
    rw [h1, hCc]
    ring
  have hzero := hres hjc
  have := le_ordForm_of_isPoincareResidue_zero (sY := ι ≫ sS) Pc hPc (n := 1) (by exact_mod_cast hdT)
    hδ0 hzero
  rw [hord] at this
  omega

/-- **Detection on a rational log curve.** Let `(T, B_T)` be a dlt curve proper over `ℂ` whose
function field is generated by `w`, with `div(dlog w) + B_T = 0`. Then a section of `m(K_T + B_T)`
with zero residue at every adjunction point of `T` is zero: it is a constant multiple of
`(dlog w)^{⊗m}`, whose residue at a zero of `w` is `1`. -/
private theorem eq_zero_of_isPoincareResidue_zero_of_dlog_curve {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of ℂ)} [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    (hT : IsNormalVariety ℂ sT) [IsProper sT] (hdT : topologicalKrullDim T = (1 : ℕ))
    {BT : QDivisor T} (hdltT : MMP.Intersection.IsDltPair sT BT) (w : T.functionField)
    (hw0 : w ≠ 0)
    (hgen : letI := functionFieldAlgebra sT
      IntermediateField.adjoin ℂ ({w} : Set T.functionField) = ⊤)
    (hψ : letI := functionFieldAlgebra sT
      ∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms sT 1 ((1 : ℕ) : ℤ) from
        formPow (exteriorPower.ιMulti T.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ)
        + BT.coeff Γ = 0)
    {m : ℕ} {δ : RationalPluriForms sT 1 m}
    (hδ : δ ∈ logPluricanonicalSections sT 1 m BT)
    (hres : ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ T} {BG : QDivisor G},
      IsAdjunctionStep sT BT j BG → IsPoincareResidue sT j 0 m δ 0) : δ = 0 := by
  classical
  letI := functionFieldAlgebra sT
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  obtain ⟨Tq, ιq, Bq, hq, _, -, hresq⟩ :=
    CrepantModelAux.exists_isAdjunctionStep_residue_dlog_of_curve hT hdT hdltT w hw0 hgen hψ
  obtain ⟨Pq, hPq, hciq⟩ := hq.exists_primeDivisor
  haveI := hciq
  letI := functionFieldAlgebra (ιq ≫ sT)
  -- every section is a constant multiple of `(dlog ē)^{⊗m}`
  have hω0 : exteriorPower.ιMulti T.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w] ≠ 0 := by
    intro h0
    have h1 := hresq 1
    rw [h0] at h1
    have h2 : (formPow (0 : ⋀[T.functionField]^1 Ω[T.functionField⁄ℂ]) 1 :
        RationalPluriForms sT 1 ((1 : ℕ) : ℤ)) = 0 := by
      unfold formPow
      exact (PiTensorProduct.tprod _).map_coord_zero (0 : Fin 1) rfl
    rw [h2] at h1
    exact CrepantModelAux.formPow_ιMulti_zero_ne_zero (k := ℂ) (K := Tq.functionField) 1
      (IsPoincareResidue.unique hq h1 (isPoincareResidue_zero_of_isClosedImmersion
        Pq hPq (n := 0) (m := 1)))
  obtain ⟨c, hc⟩ := exists_eq_smul_formPow_of_divisorOfForm_add_eq_zero sT (d := 0) hdT hω0
    hψ hδ
  have h1 := CrepantModelAux.IsPoincareResidue.smul_const (hresq m) c
  rw [← hc] at h1
  have h2 := IsPoincareResidue.unique hq h1 (hres hq)
  have hc0 : c = 0 := by
    by_contra hc0
    exact CrepantModelAux.formPow_ιMulti_zero_ne_zero (k := ℂ) (K := Tq.functionField) m
      ((smul_eq_zero.mp h2).resolve_left hc0)
  rw [hc, hc0, zero_smul]

/-- **The residue along a floor curve contracted to a point.** Let `σ : (S, B) ⇢ (S', B')` be a
crepant birational map of normal surfaces proper over `ℂ`, with `(S', B')` dlt and
`m'(K_{S'} + B')` Cartier, and let `T ⟶ S` be an adjunction step onto a curve `P` of coefficient
one whose valuation is that of an exceptional divisor `D` of discrepancy `-1` over `S'`. Then the
centre `x` of `D` is a closed point at which `(S', B')` has snc coordinates `z₁, z₂` for its
reduced boundary, the curve `T` carries the global log generator `dlog ē`, `k(T) = ℂ(ē)`, and for
every `g` regular at `x` with value `c` there, the residue of `σ^*(g · (dlog z₁ ∧ dlog z₂)^{⊗m})`
along `T` is `c · (dlog ē)^{⊗m}`. -/
private theorem exists_sncCoordinates_isPoincareResidue_of_isExceptional_curve
    {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] [LocallyOfFiniteType sS]
    [IsProper sS] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S'] [CompactSpace S']
    [LocallyOfFiniteType sS'] [IsProper sS']
    (hS : IsNormalVariety ℂ sS) (hS' : IsNormalVariety ℂ sS')
    (hdS : topologicalKrullDim S = (1 + 1 : ℕ)) (hdS' : topologicalKrullDim S' = (1 + 1 : ℕ))
    {B : QDivisor S} {B' : QDivisor S'} {K : Divisor S} {K' : Divisor S'}
    (hK : K.IsCanonicalDivisor sS (1 + 1)) (hK' : K'.IsCanonicalDivisor sS' (1 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) {m' : ℕ} (hm' : 0 < m')
    (hmK' : ((m' : ℤ) • (Divisor.toQDivisor K' + B')).IsCartierDivisor)
    (hdlt' : MMP.Intersection.IsDltPair sS' B')
    (σ : FunctionFieldEquiv sS sS') (hσ : IsCrepantBirationalMap sS sS' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ S} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sS B ι BT)
    (P : Mori.PrimeDivisor S) (hrP : Set.range ι.base = (P.support : Set S)) (hP1 : B.coeff P = 1)
    (D : DivisorOver ℂ sS') (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    (hD : D.IsExceptional) (hDp : IsProper D.f)
    (hDdisc : MMP.Mori.IsDiscrepancy sS' (1 + 1) K' B' D (-1)) :
    letI := functionFieldAlgebra sS
    letI := functionFieldAlgebra sS'
    letI := functionFieldAlgebra (ι ≫ sS)
    ∃ (x : S') (_ : x = D.f D.E.genericPoint) (_ : IsClosed ({x} : Set S'))
      (z : Fin (1 + 1) → S'.presheaf.stalk x)
      (_ : IsRegularSystemOfParameters z) (_ : x ∈ Mori.smoothLocus sS')
      (L : Fin (1 + 1) → Mori.PrimeDivisor S') (_ : Function.Injective L)
      (_ : ∀ a, x ∈ (L a).support)
      (_ : ∀ a, IdealSheafData.stalk (L a).idealSheaf x = Ideal.span {z a})
      (_ : ∀ E : Mori.PrimeDivisor S', x ∈ E.support → B'.coeff E ≠ 0 → E ∈ Set.range L)
      (_ : ∀ a, B'.coeff (L a) = 1)
      (_ : (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sS' (1 + 1) ((1 : ℕ) : ℤ)
          from formPow (exteriorPower.ιMulti S'.functionField (1 + 1) fun a =>
            (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))⁻¹ • KaehlerDifferential.D ℂ
              S'.functionField (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))) 1)) +
          B').IsQCartier)
      (w : T.functionField), w ≠ 0 ∧
      IntermediateField.adjoin ℂ ({w} : Set T.functionField) = ⊤ ∧
      (∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 1
        ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 1
          ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) + BT.coeff Γ = 0) ∧
      ∀ (g : S'.presheaf.stalk x) (c : ℂ),
        (letI := stalkAlgebra sS' x; g - algebraMap ℂ _ c ∈ IsLocalRing.maximalIdeal _) →
        ∀ m : ℕ, IsPoincareResidue sS ι 1 m
          (pluriformPullback sS sS' σ.toHom (1 + 1) m (algebraMap _ S'.functionField g •
            formPow (exteriorPower.ιMulti S'.functionField (1 + 1) fun a =>
              (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))⁻¹ • KaehlerDifferential.D ℂ
                S'.functionField (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))) m))
          (c • (show RationalPluriForms (ι ≫ sS) 1 m from formPow (exteriorPower.ιMulti
            T.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) m)) := by
  classical
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  have hm0' : (m' : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hKB' : (Divisor.toQDivisor K' + B').IsQCartier := ⟨_, hm0', hmK'⟩
  -- snc coordinates at the centre, a closed point
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt'
      ⟨hS', hK', hKB'⟩ D hDp hDdisc
  have hcoh : Order.coheight (D.f D.E.genericPoint) = cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    exact WithBot.coe_injective h2
  have hcc : cc = 2 := by
    have h3 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight
      hS' D).mp hD
    have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
    rw [hdS', hcoh] at h5
    rw [hcoh] at h3
    have h7 : cc ≤ 1 + 1 := by exact_mod_cast (WithBot.coe_le_coe.mp h5)
    have h8 : 2 ≤ cc := by exact_mod_cast h3
    omega
  subst hcc
  have hxcl : IsClosed ({D.f D.E.genericPoint} : Set S') :=
    CrepantModelAux.isClosed_singleton_of_le_coheight (d := 2) hdS'.le (by rw [hcoh])
  have hresk := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sS' (D.f D.E.genericPoint) hxcl
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sS'
    (D.f D.E.genericPoint) hxcl
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  letI := stalkAlgebra sS' (D.f D.E.genericPoint)
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sS' hsm
  haveI : Module.Finite (S'.presheaf.stalk (D.f D.E.genericPoint))
      Ω[S'.presheaf.stalk (D.f D.E.genericPoint)⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  -- the snc log generator `τ'` and an open on which it generates
  obtain ⟨U, hxU, hU⟩ := CrepantModelAux.exists_open_coeff_divisorOfForm_add_eq_zero hdS' z hz hsm
    hres' L hL hLx hLz hBL hL1
  set τ' : RationalPluriForms sS' (1 + 1) ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
    S'.functionField (1 + 1) fun a => (algebraMap _ S'.functionField (z a))⁻¹ •
      KaehlerDifferential.D ℂ _ (algebraMap _ S'.functionField (z a))) 1 with hτ'
  have hτ'0 : τ' ≠ 0 := by
    intro h0
    have := CrepantModelAux.ordForm_formPow_dlog_eq hdS' 1 z hz0 hw L hL hLx hLz (L 0) (hLx 0)
    rw [if_pos ⟨0, rfl⟩] at this
    change (L 0).ordForm τ' = _ at this
    rw [h0, Mori.PrimeDivisor.ordForm_zero] at this
    exact absurd this (by decide)
  have hDU : (D.center : Set S') ⊆ U := by
    rw [D.center_eq_closure_genericPoint, hxcl.closure_eq, Set.singleton_subset_iff]
    exact hxU
  obtain ⟨-, hθall⟩ := CrepantModelAux.divisorOfForm_add_eq_zero_of_center_subset (n := 1) hS hS'
    hdS hdS' one_pos hK hK' hKB hKB' σ hσ hι P hrP hP1 D hDv hτ'0 U hDU hU
  -- the monomial frame along `P`
  have hP : ι (genericPoint T) = P.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq ι P hrP
  have hvD : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      D.valuation (algebraMap _ S'.functionField r) ≤ 1 := by
    intro r
    by_cases hr : r = 0
    · rw [hr, map_zero, map_zero]; exact zero_le'
    obtain ⟨M, -, hM⟩ := hmono r hr
    rw [hM, ← WithZero.exp_zero, WithZero.exp_le_exp]
    omega
  have hle : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) ≤ 1 :=
    fun r => by rw [← hDv]; exact hvD r
  have hlt : ∀ r ∈ IsLocalRing.maximalIdeal (S'.presheaf.stalk (D.f D.E.genericPoint)),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) < 1 := by
    intro r hr
    rw [← hDv]
    have h1 : r ∈ weightedMonomialIdeal z α 1 := by
      have := CrepantModelAux.span_range_le_weightedMonomialIdeal_one z α hα
      rw [hz.1] at this
      exact this hr
    have h2 := CrepantModelAux.valuation_le_of_mem_weightedMonomialIdeal z α D.valuation hvD hzv h1
    refine h2.trans_lt ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  obtain ⟨t, e', he', ht, hfr, hgen⟩ := CrepantModelAux.exists_monomialFrame_two ι P hP σ z α hz0
    hle hlt (fun a => by rw [← hDv]; exact hzv a)
    (fun f hf => by
      obtain ⟨M, hM, hMv⟩ := hmono f hf
      exact ⟨M, hM, by rw [← hDv]; exact hMv⟩) hresk
  have hpull1 : pluriformPullback sS sS' σ.toHom (1 + 1) 1 τ' =
      formPow (exteriorPower.ιMulti S.functionField (1 + 1)
        (Fin.cons ((algebraMap _ S.functionField t)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField t))
          fun b => (algebraMap _ S.functionField (e' b))⁻¹ •
            KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField (e' b)))) 1 := by
    have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
      (fun a => algebraMap _ _ (z a)) 1 1
    rw [one_smul, map_one, one_smul, hfr] at h1
    exact h1
  have hres1 := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι 1 t e' he' ht
  have hθ0 := hθall _ (by rw [hpull1]; exact hres1)
  -- the global log generator `dlog ē` of `(T, B_T)`
  letI := functionFieldAlgebra (ι ≫ sS)
  set w : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 0) with hwdef
  have hθfun : (fun i : Fin 1 => ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ •
      KaehlerDifferential.D ℂ T.functionField ((ι.stalkMap (genericPoint T)).hom (e' i))) =
      ![w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
    funext i; fin_cases i; rfl
  have hψ : ∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 1
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 1
        ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) + BT.coeff Γ = 0 := by
    intro Γ
    have := congrArg (fun G : QDivisor T => G.coeff Γ) hθ0
    simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm,
      DivisorWithCoeffs.coeff_zero] at this
    rw [← hθfun]
    exact this
  have hw0 : w ≠ 0 := ((he' 0).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hgen' : IntermediateField.adjoin ℂ ({w} : Set T.functionField) = ⊤ := by
    rw [← hgen]
    congr 1
    ext y
    simp [hwdef, eq_comm]
  have hdT : topologicalKrullDim T = (1 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sS ι P hrP hdS
  -- the residue formula
  haveI := isScalarTower_stalk_functionField sS' (D.f D.E.genericPoint)
  letI := stalkAlgebra sS (ι (genericPoint T))
  haveI := isScalarTower_stalk_functionField sS (ι (genericPoint T))
  have hker : RingHom.ker (ι.stalkMap (genericPoint T)).hom =
      IsLocalRing.maximalIdeal (S.presheaf.stalk (ι (genericPoint T))) := by
    have hkerP : ∀ (y : S) (hy : y = P.genericPoint),
        IdealSheafData.stalk P.idealSheaf y = IsLocalRing.maximalIdeal (S.presheaf.stalk y) := by
      rintro y rfl; exact MMP.Resolution.Aux.stalk_idealSheaf_genericPoint P
    rw [CrepantModelAux.ker_stalkMap_eq_stalk_idealSheaf ι P hrP (genericPoint T), hkerP _ hP]
  have hQ' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsQCartier :=
    hKB'.add_of_linearlyEquivalent
      (by simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hS' hK' hτ'0).symm)
  refine ⟨D.f D.E.genericPoint, rfl, hxcl, z, hz, hsm, L, hL, hLx, hLz, hBL, hL1, hQ', w, hw0, hgen',
    hψ, fun g c hgc m => ?_⟩
  obtain ⟨gP, hgP⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one P hP
    (hle g)
  have hmem : gP - algebraMap ℂ _ c ∈
      IsLocalRing.maximalIdeal (S.presheaf.stalk (ι (genericPoint T))) := by
    rw [CrepantModelAux.mem_maximalIdeal_iff_divisorialValuation_lt_one P hP]
    have h1 := hlt _ hgc
    rw [map_sub, map_sub, ← IsScalarTower.algebraMap_apply, AlgHom.commutes] at h1
    rw [map_sub, hgP, ← IsScalarTower.algebraMap_apply]
    exact h1
  have h0 : (ι.stalkMap (genericPoint T)).hom (gP - algebraMap ℂ _ c) = 0 := by
    rw [← RingHom.mem_ker, hker]; exact hmem
  rw [map_sub, sub_eq_zero, CrepantModelAux.stalkMap_algebraMap_const sS ι (genericPoint T) c] at h0
  have hpullm := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
    (fun a => algebraMap _ _ (z a)) m (algebraMap _ _ g)
  rw [hfr, ← hgP] at hpullm
  have hres_m := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι m t e' he' ht
  have h1 := CrepantModelAux.IsPoincareResidue.smul_stalk hres_m gP
  rw [h0] at h1
  rw [hpullm]
  have e3 : (formPow (exteriorPower.ιMulti T.functionField 1 fun i =>
      ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ • KaehlerDifferential.D ℂ T.functionField
        ((ι.stalkMap (genericPoint T)).hom (e' i))) m : RationalPluriForms (ι ≫ sS) 1 m) =
      formPow (exteriorPower.ιMulti T.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) m := by
    rw [hθfun]
  rw [e3] at h1
  exact h1

/-- **The residue along a floor surface contracted to a point.** Let `σ : (S, B) ⇢ (S', B')` be
a crepant birational map of normal threefolds proper over `ℂ`, with `(S', B')` dlt and
`m'(K_{S'} + B')` Cartier, and let `T ⟶ S` be an adjunction step onto a surface `P` of coefficient
one whose valuation is that of a divisor `D` of discrepancy `-1` over `S'` centred at a closed
point `x`. Then `(S', B')` has snc coordinates `z₁, z₂, z₃` at `x` for its reduced boundary, the
surface `T` carries the global log generator `dlog ē₁ ∧ dlog ē₂`, `k(T) = ℂ(ē₁, ē₂)`, and for every
`g` regular at `x` with value `c` there, the residue of
`σ^*(g · (dlog z₁ ∧ dlog z₂ ∧ dlog z₃)^{⊗m})` along `T` is `c · (dlog ē₁ ∧ dlog ē₂)^{⊗m}`. -/
private theorem exists_sncCoordinates_isPoincareResidue_of_isExceptional_surface_point
    {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] [LocallyOfFiniteType sS]
    [IsProper sS] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S'] [CompactSpace S']
    [LocallyOfFiniteType sS'] [IsProper sS']
    (hS : IsNormalVariety ℂ sS) (hS' : IsNormalVariety ℂ sS')
    (hdS : topologicalKrullDim S = (2 + 1 : ℕ)) (hdS' : topologicalKrullDim S' = (2 + 1 : ℕ))
    {B : QDivisor S} {B' : QDivisor S'} {K : Divisor S} {K' : Divisor S'}
    (hK : K.IsCanonicalDivisor sS (2 + 1)) (hK' : K'.IsCanonicalDivisor sS' (2 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) {m' : ℕ} (hm' : 0 < m')
    (hmK' : ((m' : ℤ) • (Divisor.toQDivisor K' + B')).IsCartierDivisor)
    (hdlt' : MMP.Intersection.IsDltPair sS' B')
    (σ : FunctionFieldEquiv sS sS') (hσ : IsCrepantBirationalMap sS sS' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ S} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sS B ι BT)
    (P : Mori.PrimeDivisor S) (hrP : Set.range ι.base = (P.support : Set S)) (hP1 : B.coeff P = 1)
    (D : DivisorOver ℂ sS') (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    (hDp : IsProper D.f) (hDdisc : MMP.Mori.IsDiscrepancy sS' (2 + 1) K' B' D (-1))
    (hpt : Order.coheight (D.f D.E.genericPoint) = 3) :
    letI := functionFieldAlgebra sS
    letI := functionFieldAlgebra sS'
    letI := functionFieldAlgebra (ι ≫ sS)
    ∃ (x : S') (_ : x = D.f D.E.genericPoint) (_ : IsClosed ({x} : Set S'))
      (z : Fin (2 + 1) → S'.presheaf.stalk x)
      (_ : IsRegularSystemOfParameters z) (_ : x ∈ Mori.smoothLocus sS')
      (L : Fin (2 + 1) → Mori.PrimeDivisor S') (_ : Function.Injective L)
      (_ : ∀ a, x ∈ (L a).support)
      (_ : ∀ a, IdealSheafData.stalk (L a).idealSheaf x = Ideal.span {z a})
      (_ : ∀ E : Mori.PrimeDivisor S', x ∈ E.support → B'.coeff E ≠ 0 → E ∈ Set.range L)
      (_ : ∀ a, B'.coeff (L a) = 1)
      (_ : (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sS' (2 + 1) ((1 : ℕ) : ℤ)
          from formPow (exteriorPower.ιMulti S'.functionField (2 + 1) fun a =>
            (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))⁻¹ • KaehlerDifferential.D ℂ
              S'.functionField (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))) 1)) +
          B').IsQCartier)
      (u w : T.functionField), u ≠ 0 ∧ w ≠ 0 ∧
      IntermediateField.adjoin ℂ ({u, w} : Set T.functionField) = ⊤ ∧
      (∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 2
        ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 2
          ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) +
          BT.coeff Γ = 0) ∧
      ∀ (g : S'.presheaf.stalk x) (c : ℂ),
        (letI := stalkAlgebra sS' x; g - algebraMap ℂ _ c ∈ IsLocalRing.maximalIdeal _) →
        ∀ m : ℕ, IsPoincareResidue sS ι 2 m
          (pluriformPullback sS sS' σ.toHom (2 + 1) m (algebraMap _ S'.functionField g •
            formPow (exteriorPower.ιMulti S'.functionField (2 + 1) fun a =>
              (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))⁻¹ • KaehlerDifferential.D ℂ
                S'.functionField (algebraMap (S'.presheaf.stalk x) S'.functionField (z a))) m))
          (c • (show RationalPluriForms (ι ≫ sS) 2 m from formPow (exteriorPower.ιMulti
            T.functionField 2 ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w])
              m)) := by
  classical
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  have hm0' : (m' : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hKB' : (Divisor.toQDivisor K' + B').IsQCartier := ⟨_, hm0', hmK'⟩
  -- snc coordinates at the centre, a closed point
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt'
      ⟨hS', hK', hKB'⟩ D hDp hDdisc
  have hcoh : Order.coheight (D.f D.E.genericPoint) = cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    exact WithBot.coe_injective h2
  have hcc : cc = 3 := by
    rw [hpt] at hcoh
    exact_mod_cast hcoh.symm
  subst hcc
  have hxcl : IsClosed ({D.f D.E.genericPoint} : Set S') :=
    CrepantModelAux.isClosed_singleton_of_le_coheight (d := 3) hdS'.le (by rw [hcoh])
  have hresk := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sS' (D.f D.E.genericPoint) hxcl
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sS'
    (D.f D.E.genericPoint) hxcl
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  letI := stalkAlgebra sS' (D.f D.E.genericPoint)
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sS' hsm
  haveI : Module.Finite (S'.presheaf.stalk (D.f D.E.genericPoint))
      Ω[S'.presheaf.stalk (D.f D.E.genericPoint)⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  obtain ⟨U, hxU, hU⟩ := CrepantModelAux.exists_open_coeff_divisorOfForm_add_eq_zero hdS' z hz hsm
    hres' L hL hLx hLz hBL hL1
  set τ' : RationalPluriForms sS' (2 + 1) ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
    S'.functionField (2 + 1) fun a => (algebraMap _ S'.functionField (z a))⁻¹ •
      KaehlerDifferential.D ℂ _ (algebraMap _ S'.functionField (z a))) 1 with hτ'
  have hτ'0 : τ' ≠ 0 := by
    intro h0
    have := CrepantModelAux.ordForm_formPow_dlog_eq hdS' 1 z hz0 hw L hL hLx hLz (L 0) (hLx 0)
    rw [if_pos ⟨0, rfl⟩] at this
    change (L 0).ordForm τ' = _ at this
    rw [h0, Mori.PrimeDivisor.ordForm_zero] at this
    exact absurd this (by decide)
  have hDU : (D.center : Set S') ⊆ U := by
    rw [D.center_eq_closure_genericPoint, hxcl.closure_eq, Set.singleton_subset_iff]
    exact hxU
  obtain ⟨-, hθall⟩ := CrepantModelAux.divisorOfForm_add_eq_zero_of_center_subset (n := 2) hS hS'
    hdS hdS' (by norm_num) hK hK' hKB hKB' σ hσ hι P hrP hP1 D hDv hτ'0 U hDU hU
  have hP : ι (genericPoint T) = P.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq ι P hrP
  have hvD : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      D.valuation (algebraMap _ S'.functionField r) ≤ 1 := by
    intro r
    by_cases hr : r = 0
    · rw [hr, map_zero, map_zero]; exact zero_le'
    obtain ⟨M, -, hM⟩ := hmono r hr
    rw [hM, ← WithZero.exp_zero, WithZero.exp_le_exp]
    omega
  have hle : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) ≤ 1 :=
    fun r => by rw [← hDv]; exact hvD r
  have hlt : ∀ r ∈ IsLocalRing.maximalIdeal (S'.presheaf.stalk (D.f D.E.genericPoint)),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) < 1 := by
    intro r hr
    rw [← hDv]
    have h1 : r ∈ weightedMonomialIdeal z α 1 := by
      have := CrepantModelAux.span_range_le_weightedMonomialIdeal_one z α hα
      rw [hz.1] at this
      exact this hr
    have h2 := CrepantModelAux.valuation_le_of_mem_weightedMonomialIdeal z α D.valuation hvD hzv h1
    refine h2.trans_lt ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  obtain ⟨t, e', he', ht, hfr, hgen⟩ := CrepantModelAux.exists_monomialFrame ι P hP σ z α hz0
    hle hlt (fun a => by rw [← hDv]; exact hzv a)
    (fun f hf => by
      obtain ⟨M, hM, hMv⟩ := hmono f hf
      exact ⟨M, hM, by rw [← hDv]; exact hMv⟩) hresk
  have hpull1 : pluriformPullback sS sS' σ.toHom (2 + 1) 1 τ' =
      formPow (exteriorPower.ιMulti S.functionField (2 + 1)
        (Fin.cons ((algebraMap _ S.functionField t)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField t))
          fun b => (algebraMap _ S.functionField (e' b))⁻¹ •
            KaehlerDifferential.D ℂ _ (algebraMap _ S.functionField (e' b)))) 1 := by
    have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
      (fun a => algebraMap _ _ (z a)) 1 1
    rw [one_smul, map_one, one_smul, hfr] at h1
    exact h1
  have hres1 := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι 1 t e' he' ht
  have hθ0 := hθall _ (by rw [hpull1]; exact hres1)
  -- the global log generator `dlog ē₁ ∧ dlog ē₂` of `(T, B_T)`
  letI := functionFieldAlgebra (ι ≫ sS)
  set u : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 0) with hudef
  set w : T.functionField := (ι.stalkMap (genericPoint T)).hom (e' 1) with hwdef
  have hθfun : (fun i : Fin 2 => ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ •
      KaehlerDifferential.D ℂ T.functionField ((ι.stalkMap (genericPoint T)).hom (e' i))) =
      ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
    funext i; fin_cases i <;> rfl
  have hψ : ∀ Γ : Mori.PrimeDivisor T, (Γ.ordForm (show RationalPluriForms (ι ≫ sS) 2
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti T.functionField 2
        ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) +
        BT.coeff Γ = 0 := by
    intro Γ
    have := congrArg (fun G : QDivisor T => G.coeff Γ) hθ0
    simp only [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm,
      DivisorWithCoeffs.coeff_zero] at this
    rw [← hθfun]
    exact this
  have hu0 : u ≠ 0 := ((he' 0).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hw0 : w ≠ 0 := ((he' 1).map (ι.stalkMap (genericPoint T)).hom).ne_zero
  have hgen' : IntermediateField.adjoin ℂ ({u, w} : Set T.functionField) = ⊤ := by
    rw [← hgen]
    congr 1
    ext y
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range, Fin.exists_fin_two,
      hudef, hwdef]
    tauto  -- the residue formula
  haveI := isScalarTower_stalk_functionField sS' (D.f D.E.genericPoint)
  letI := stalkAlgebra sS (ι (genericPoint T))
  haveI := isScalarTower_stalk_functionField sS (ι (genericPoint T))
  have hker : RingHom.ker (ι.stalkMap (genericPoint T)).hom =
      IsLocalRing.maximalIdeal (S.presheaf.stalk (ι (genericPoint T))) := by
    have hkerP : ∀ (y : S) (hy : y = P.genericPoint),
        IdealSheafData.stalk P.idealSheaf y = IsLocalRing.maximalIdeal (S.presheaf.stalk y) := by
      rintro y rfl; exact MMP.Resolution.Aux.stalk_idealSheaf_genericPoint P
    rw [CrepantModelAux.ker_stalkMap_eq_stalk_idealSheaf ι P hrP (genericPoint T), hkerP _ hP]
  have hQ' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsQCartier :=
    hKB'.add_of_linearlyEquivalent
      (by simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hS' hK' hτ'0).symm)
  refine ⟨D.f D.E.genericPoint, rfl, hxcl, z, hz, hsm, L, hL, hLx, hLz, hBL, hL1, hQ', u, w, hu0, hw0,
    hgen', hψ, fun g c hgc m => ?_⟩
  obtain ⟨gP, hgP⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one P hP
    (hle g)
  have hmem : gP - algebraMap ℂ _ c ∈
      IsLocalRing.maximalIdeal (S.presheaf.stalk (ι (genericPoint T))) := by
    rw [CrepantModelAux.mem_maximalIdeal_iff_divisorialValuation_lt_one P hP]
    have h1 := hlt _ hgc
    rw [map_sub, map_sub, ← IsScalarTower.algebraMap_apply, AlgHom.commutes] at h1
    rw [map_sub, hgP, ← IsScalarTower.algebraMap_apply]
    exact h1
  have h0 : (ι.stalkMap (genericPoint T)).hom (gP - algebraMap ℂ _ c) = 0 := by
    rw [← RingHom.mem_ker, hker]; exact hmem
  rw [map_sub, sub_eq_zero, CrepantModelAux.stalkMap_algebraMap_const sS ι (genericPoint T) c] at h0
  have hpullm := CrepantModelAux.pluriformPullback_smul_formPow_dlog hdS hdS' σ.toHom
    (fun a => algebraMap _ _ (z a)) m (algebraMap _ _ g)
  rw [hfr, ← hgP] at hpullm
  have hres_m := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι m t e' he' ht
  have h1 := CrepantModelAux.IsPoincareResidue.smul_stalk hres_m gP
  rw [h0] at h1
  rw [hpullm]
  have e3 : (formPow (exteriorPower.ιMulti T.functionField 2 fun i =>
      ((ι.stalkMap (genericPoint T)).hom (e' i))⁻¹ • KaehlerDifferential.D ℂ T.functionField
        ((ι.stalkMap (genericPoint T)).hom (e' i))) m : RationalPluriForms (ι ≫ sS) 2 m) =
      formPow (exteriorPower.ιMulti T.functionField 2
        ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) m := by
    rw [hθfun]
  rw [e3] at h1
  exact h1

/-- **Orders of pluriforms along a divisor over a variety.** For a divisor `D` over a normal
variety `X` of dimension `d`, a nonzero top form `ω` and `f ≠ 0`,
`ord_D(f · ω^{⊗a}) = ord_D f + a · ord_D ω`. -/
private theorem DivisorOver.ordPullback_smul_formPow {k : Type} [Field k] [PerfectField k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hX : IsNormalVariety k sX) {d : ℕ} (hd : topologicalKrullDim X = d) (D : DivisorOver k sX)
    {ω : letI := functionFieldAlgebra sX; ⋀[X.functionField]^d Ω[X.functionField⁄k]} (hω : ω ≠ 0)
    {f : X.functionField} (hf : f ≠ 0) (a : ℕ) :
    letI := functionFieldAlgebra sX
    haveI := D.isIntegral
    haveI := D.isDominant
    haveI := D.isLocallyNoetherian
    D.ordPullback (show RationalPluriForms sX d a from f • formPow ω a) =
      D.Y.ord (functionFieldMap D.f f) D.E.genericPoint +
        a * D.ordPullback (show RationalPluriForms sX d 1 from formPow ω 1) := by
  letI := functionFieldAlgebra sX
  haveI := D.isIntegral
  haveI := D.isDominant
  haveI := D.isLocallyNoetherian
  obtain ⟨b, N, hN⟩ := D.exists_ordPullback_eq hX hd
  set c := b.repr ω () with hc
  have hωb : ω = c • b () := (basis_unit_repr_smul b ω).symm
  have hc0 : c ≠ 0 := fun h0 => hω (by rw [hωb, h0, zero_smul])
  have hpow : ∀ k : ℕ, (formPow ω k : RationalPluriForms sX d k) = c ^ k • formPow (b ()) k :=
    fun k => by rw [hωb, formPow_smul]
  have e1 : (f • formPow ω a : RationalPluriForms sX d a) = (f * c ^ a) • formPow (b ()) a := by
    rw [hpow, smul_smul]
  have e2 : (formPow ω 1 : RationalPluriForms sX d 1) = c • formPow (b ()) 1 := by
    rw [hpow, pow_one]
  have h1 : (f * c ^ a) • formPow (b ()) a ≠ (0 : RationalPluriForms sX d a) := by
    rw [← ZTensorPower.basis_natCast]
    exact smul_ne_zero (mul_ne_zero hf (pow_ne_zero _ hc0)) ((ZTensorPower.basis b _).ne_zero ())
  have h2 : c • formPow (b ()) 1 ≠ (0 : RationalPluriForms sX d 1) := by
    rw [← ZTensorPower.basis_natCast]
    exact smul_ne_zero hc0 ((ZTensorPower.basis b _).ne_zero ())
  have r1 : (ZTensorPower.basis b a).repr ((f * c ^ a) • formPow (b ()) a :
      RationalPluriForms sX d a) () = f * c ^ a := repr_smul_formPow b a _
  have r2 : (ZTensorPower.basis b 1).repr (c • formPow (b ()) 1 :
      RationalPluriForms sX d 1) () = c := repr_smul_formPow b 1 _
  have hfm : functionFieldMap D.f f ≠ 0 := (map_ne_zero _).mpr hf
  have hcm : functionFieldMap D.f c ≠ 0 := (map_ne_zero _).mpr hc0
  have e1' : (show RationalPluriForms sX d a from f • formPow ω a) =
      (show RationalPluriForms sX d a from (f * c ^ a) • formPow (b ()) a) := e1
  have e2' : (show RationalPluriForms sX d 1 from formPow ω 1) =
      (show RationalPluriForms sX d 1 from c • formPow (b ()) 1) := e2
  rw [e1', e2', hN _ _ h1, hN _ _ h2]
  erw [r1, r2]
  rw [map_mul, map_pow, Scheme.ord_mul hfm (pow_ne_zero _ hcm), ← zpow_natCast, ord_zpow _ hcm]
  push_cast
  ring

/-- **Zero residues give log canonical vanishing.** Let `(T, B_T)` be a dlt pair of dimension `2`
with `m(K_T + B_T)` Cartier and `D` a proper divisor over `T` of discrepancy `-1` whose centre is
not the generic point. If a nonzero section `δ` of `m(K_T + B_T)` has zero residue along every
adjunction step of `T`, then `ord_D δ ≥ 1 - m`: some coefficient-one curve passes through the
centre of `D`, along which `ord δ ≥ 1 - m`, and this passes to `D`. -/
private theorem one_sub_le_ordPullback_of_isPoincareResidue_zero {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of ℂ)} [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    (hT : IsNormalVariety ℂ sT) (hdT : topologicalKrullDim T = (2 : ℕ)) {BT : QDivisor T}
    (hdlt : MMP.Intersection.IsDltPair sT BT) {KT : Divisor T} (hKT : KT.IsCanonicalDivisor sT 2)
    {m : ℕ} (hm : 0 < m) (hmK : ((m : ℤ) • (Divisor.toQDivisor KT + BT)).IsCartierDivisor)
    (D : DivisorOver ℂ sT) (hDp : IsProper D.f) (hD : MMP.Mori.IsDiscrepancy sT 2 KT BT D (-1))
    (hc : 1 ≤ Order.coheight (D.f D.E.genericPoint))
    {δ : RationalPluriForms sT 2 m} (hδ : δ ∈ logPluricanonicalSections sT 2 m BT) (hδ0 : δ ≠ 0)
    (hres : ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ T} {BG : QDivisor G},
      IsAdjunctionStep sT BT j BG → IsPoincareResidue sT j 1 m δ 0) :
    1 - (m : ℤ) ≤ D.ordPullback δ := by
  have hm0 : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  haveI : LocallyOfFiniteType sT := hT.1.toLocallyOfFiniteType
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt
      ⟨hT, hKT, ⟨_, hm0, hmK⟩⟩ D hDp hD
  have hcc : 1 ≤ cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    have h3 := WithBot.coe_injective h2
    rw [h3] at hc
    exact_mod_cast hc
  set L0 := L ⟨0, hcc⟩
  obtain ⟨G, j, BG, hj, _, hrj, -⟩ :=
    exists_isAdjunctionStep_of_isDltPair_of_one_le_coeff hdlt (e := 1) hdT L0 (by rw [hL1])
  obtain ⟨P', hP', hci⟩ := hj.exists_primeDivisor
  haveI := hci
  have hP'L : P' = L0 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hP'.symm.trans (CrepantModelAux.map_genericPoint_eq_of_range_eq j L0 hrj))
  subst hP'L
  have hzero := hres hj
  have hL0 := le_ordForm_of_isPoincareResidue_zero (sY := sT) L0 hP' (n := 1)
    (by exact_mod_cast hdT) hδ0 hzero
  exact CrepantModelAux.one_sub_le_ordPullback_of_one_sub_le_ordForm hT hKT hm hmK D hD hδ hδ0
    L0 (hL1 _) (hLx _) (by exact_mod_cast hL0)

/-- Monomials in two coordinates are monomials in three, the third of weight zero. -/
private theorem weightedMonomialIdeal_le_snoc {R : Type*} [CommRing R] (z : Fin 2 → R)
    (α : Fin 2 → ℕ) (v : R) (M : ℕ) :
    weightedMonomialIdeal z α M ≤ weightedMonomialIdeal ![z 0, z 1, v] ![α 0, α 1, 0] M := by
  unfold weightedMonomialIdeal
  rw [Ideal.span_le]
  rintro _ ⟨β, hβ, rfl⟩
  refine Ideal.subset_span ⟨![β 0, β 1, 0], ?_, ?_⟩
  · simpa [Fin.sum_univ_three, Fin.sum_univ_two] using hβ
  · simp [Fin.prod_univ_three, Fin.prod_univ_two]

open Polynomial IsDedekindDomain in
open scoped WithZero in
/-- **Elements regular at every place of a rational function field are constants.** Let
`L = K(x)` with `x` transcendental over `K`. An element `f ∈ L` with `μ(f) ≤ 1` for every
nontrivial valuation `μ` of `L` trivial on `K` lies in `K`: on `K(X) ≅ L` it is integral at every
finite place, so a polynomial, and of degree zero by the place at infinity. -/
private theorem mem_range_algebraMap_of_forall_valuation_le_one {K L : Type} [Field K] [Field L]
    [Algebra K L] {x : L} (hx : Transcendental K x) (hgen : IntermediateField.adjoin K {x} = ⊤)
    (f : L) (hf : ∀ μ : Valuation L ℤᵐ⁰, (∀ a : K, a ≠ 0 → μ (algebraMap K L a) = 1) →
      (∃ a, a ≠ 0 ∧ μ a < 1) → μ f ≤ 1) :
    f ∈ (algebraMap K L).range := by
  classical
  let e : RatFunc K ≃ₐ[K] L := (RatFunc.algEquivOfTranscendental x hx).trans
    ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv)
  have hC : ∀ a : K, algebraMap K (RatFunc K) a = algebraMap K[X] (RatFunc K) (C a) := fun a =>
    (IsScalarTower.algebraMap_apply K K[X] (RatFunc K) a).trans (by rw [Polynomial.algebraMap_eq])
  have hval : ∀ ν : Valuation (RatFunc K) ℤᵐ⁰, (∀ a : K, a ≠ 0 → ν (algebraMap K _ a) = 1) →
      (∃ a, a ≠ 0 ∧ ν a < 1) → ν (e.symm f) ≤ 1 := by
    intro ν h1 h2
    have := hf (ν.comap e.symm.toRingEquiv.toRingHom) (fun a ha => by
        simp only [Valuation.comap_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          AlgEquiv.toRingEquiv_eq_coe, AlgEquiv.coe_ringEquiv, AlgEquiv.commutes]
        exact h1 a ha)
      (by
        obtain ⟨a, ha, h⟩ := h2
        exact ⟨e a, by simpa using ha, by simpa using h⟩)
    simpa using this
  have hunit : ∀ (v : HeightOneSpectrum K[X]) (a : K), a ≠ 0 →
      v.valuation (RatFunc K) (algebraMap K _ a) = 1 := by
    intro v a ha
    have h1 := v.valuation_le_one (K := RatFunc K) (C a)
    have h2 := v.valuation_le_one (K := RatFunc K) (C a⁻¹)
    have h3 : v.valuation (RatFunc K) (algebraMap K _ a) *
        v.valuation (RatFunc K) (algebraMap K _ a⁻¹) = 1 := by
      rw [← map_mul, ← map_mul, mul_inv_cancel₀ ha, map_one, map_one]
    rw [hC a] at h3 ⊢
    rw [hC a⁻¹] at h3
    refine le_antisymm h1 ?_
    calc (1 : ℤᵐ⁰) = _ := h3.symm
      _ ≤ v.valuation (RatFunc K) (algebraMap K[X] (RatFunc K) (C a)) * 1 := mul_le_mul' le_rfl h2
      _ = _ := mul_one _
  have hint : e.symm f ∈ (algebraMap K[X] (RatFunc K)).range :=
    HeightOneSpectrum.mem_integers_of_valuation_le_one _ _ fun v => hval _ (hunit v) (by
      obtain ⟨π, hπ⟩ := v.valuation_exists_uniformizer (RatFunc K)
      refine ⟨π, fun h0 => by rw [h0, map_zero] at hπ; exact WithZero.exp_ne_zero hπ.symm, ?_⟩
      rw [hπ, ← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num)
  obtain ⟨p, hp⟩ := hint
  by_cases hp0 : p = 0
  · rw [hp0, map_zero] at hp
    exact ⟨0, by rw [map_zero, ← e.apply_symm_apply f, ← hp, map_zero]⟩
  have hinf := hval (RatFunc.inftyValuation K) (fun a ha => by
      rw [RatFunc.inftyValuation_apply, hC a, RatFunc.inftyValuation.polynomial K (C_ne_zero.2 ha),
        natDegree_C]; rfl)
    ⟨(algebraMap K[X] (RatFunc K) X)⁻¹, by simp [RatFunc.X_ne_zero], by
      rw [map_inv₀, RatFunc.inftyValuation_apply, RatFunc.inftyValuation.polynomial K X_ne_zero,
        natDegree_X, ← WithZero.exp_neg, ← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num⟩
  rw [← hp, RatFunc.inftyValuation_apply, RatFunc.inftyValuation.polynomial K hp0,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at hinf
  have hdeg : p.natDegree = 0 := by omega
  refine ⟨p.coeff 0, ?_⟩
  rw [← e.apply_symm_apply f, ← hp, eq_C_of_natDegree_eq_zero hdeg, ← AlgEquiv.commutes e, hC,
    coeff_C_zero]

/-- The residue along `T` of the image under `σ` of a constant of `𝒪_{S',x}` is that constant. -/
private theorem residueAlong_toHom_algebraMap_const {S S' T : Scheme.{0}}
    {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)} [IsIntegral S] [IsLocallyNoetherian S]
    [IsNormal S] [IsIntegral S'] [IsIntegral T] (σ : FunctionFieldEquiv sS sS') (ι : T ⟶ S)
    (P : Mori.PrimeDivisor S) (hP : ι (genericPoint T) = P.genericPoint) (x : S') (c : ℂ) :
    letI := stalkAlgebra sS' x
    letI := functionFieldAlgebra (ι ≫ sS)
    CrepantModelAux.residueAlong ι P hP ((σ.toHom) (algebraMap _ S'.functionField
      (algebraMap ℂ (S'.presheaf.stalk x) c))) = algebraMap ℂ T.functionField c := by
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  letI := stalkAlgebra sS' x
  haveI := isScalarTower_stalk_functionField sS' x
  letI := stalkAlgebra sS (ι (genericPoint T))
  haveI := isScalarTower_stalk_functionField sS (ι (genericPoint T))
  letI := functionFieldAlgebra (ι ≫ sS)
  rw [← IsScalarTower.algebraMap_apply, AlgHom.commutes,
    IsScalarTower.algebraMap_apply ℂ (S.presheaf.stalk (ι (genericPoint T)))
      S.functionField c, CrepantModelAux.residueAlong_algebraMap]
  exact CrepantModelAux.stalkMap_algebraMap_const sS ι (genericPoint T) c

open scoped WithZero in
/-- **Detection on a floor surface contracted to a curve.** Let `σ : (S, B) ⇢ (S', B')` be a
crepant birational map of normal threefolds proper over `ℂ`, with `(S', B')` dlt and
`m'(K_{S'} + B')` Cartier, and let `T ⟶ S` be an adjunction step onto a surface `P` of coefficient
one, with `(T, B_T)` dlt and `m(K_T + B_T)` Cartier, whose valuation is that of a divisor `D` of
discrepancy `-1` over `S'` centred at the generic point `x` of a curve `Z`. Then a section `δ` of
`m(K_T + B_T)` with zero residue along every adjunction step of `T` is zero.

Write `θ = dlog ē ∧ dlog v̄` for the residue along `T` of `σ^*(dlog z₁ ∧ dlog z₂ ∧ dlog v)`, with
`z₁, z₂` snc coordinates and `v` a unit at `x`, so that `k(T) = K(ē)` with `K = k(Z)`, and
`δ = f θ^m`. Every nontrivial place `μ` of `k(T)` trivial on `K` is dominated by a divisor `E` over
`T` of log discrepancy `1 + ord_E θ`, so `ord_E f ≥ 0`, and `f ∈ K`. The `ē`-adic place is then a
log canonical place along which `δ` has order `-m`, while zero residues force order at least
`1 - m` there. -/
private theorem eq_zero_of_isPoincareResidue_zero_of_isExceptional_surface_curve
    {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of ℂ)} {sS' : S' ⟶ Spec (.of ℂ)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S] [LocallyOfFiniteType sS]
    [IsProper sS] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S'] [CompactSpace S']
    [LocallyOfFiniteType sS'] [IsProper sS']
    (hS : IsNormalVariety ℂ sS) (hS' : IsNormalVariety ℂ sS')
    (hdS : topologicalKrullDim S = (2 + 1 : ℕ)) (hdS' : topologicalKrullDim S' = (2 + 1 : ℕ))
    {B : QDivisor S} {B' : QDivisor S'} {K : Divisor S} {K' : Divisor S'}
    (hK : K.IsCanonicalDivisor sS (2 + 1)) (hK' : K'.IsCanonicalDivisor sS' (2 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) {m' : ℕ} (hm' : 0 < m')
    (hmK' : ((m' : ℤ) • (Divisor.toQDivisor K' + B')).IsCartierDivisor)
    (hdlt' : MMP.Intersection.IsDltPair sS' B')
    (σ : FunctionFieldEquiv sS sS') (hσ : IsCrepantBirationalMap sS sS' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ S} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sS B ι BT)
    (hdltT : MMP.Intersection.IsDltPair (ι ≫ sS) BT)
    (P : Mori.PrimeDivisor S) (hrP : Set.range ι.base = (P.support : Set S)) (hP1 : B.coeff P = 1)
    (D : DivisorOver ℂ sS') (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    (hDp : IsProper D.f) (hDdisc : MMP.Mori.IsDiscrepancy sS' (2 + 1) K' B' D (-1))
    (hcurve : Order.coheight (D.f D.E.genericPoint) = 2)
    {m : ℕ} (hm : 0 < m) {KT : Divisor T} (hKT : KT.IsCanonicalDivisor (ι ≫ sS) 2)
    (hmKT : ((m : ℤ) • (Divisor.toQDivisor KT + BT)).IsCartierDivisor)
    {δ : RationalPluriForms (ι ≫ sS) 2 m}
    (hδ : δ ∈ logPluricanonicalSections (ι ≫ sS) 2 m BT)
    (hres : ∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ T} {BG : QDivisor G},
      IsAdjunctionStep (ι ≫ sS) BT j BG → IsPoincareResidue (ι ≫ sS) j 1 m δ 0) : δ = 0 := by
  classical
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  have hm0' : (m' : ℤ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hm0 : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  have hKB' : (Divisor.toQDivisor K' + B').IsQCartier := ⟨_, hm0', hmK'⟩
  have hdS'3 : topologicalKrullDim S' = ((3 : ℕ) : WithBot ℕ∞) := hdS'
  have hT : IsNormalVariety ℂ (ι ≫ sS) := hι.1
  haveI : LocallyOfFiniteType (ι ≫ sS) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim T = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sS ι P hrP hdS
  have hP : ι (genericPoint T) = P.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq ι P hrP
  letI := functionFieldAlgebra (ι ≫ sS)
  -- snc coordinates at the generic point `x` of the centre, a curve
  obtain ⟨cc, z, L, α, hz, hL, hLx, hLz, hBL, hL1, hsm, hα, hzv, hmono⟩ :=
    CrepantModelAux.exists_sncCoordinates_of_isDiscrepancy_neg_one hdlt'
      ⟨hS', hK', hKB'⟩ D hDp hDdisc
  have hcoh : Order.coheight (D.f D.E.genericPoint) = cc := by
    have h1 := hz.2
    rw [ringKrullDim_stalk_eq_coheight] at h1
    have h2 : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) =
      ((cc : ℕ∞) : WithBot ℕ∞) := h1
    exact WithBot.coe_injective h2
  have hcc : cc = 2 := by
    rw [hcurve] at hcoh
    exact_mod_cast hcoh.symm
  subst hcc
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  -- the frame `Ω = dlog z₁ ∧ dlog z₂ ∧ dlog v` at `x`
  obtain ⟨v, hvu, hw⟩ := CrepantModelAux.exists_isUnit_span_D_eq_top_of_mem_smoothLocus
    (sX := sS') hdS'3 hsm z hz
  let z3 : Fin 3 → S'.presheaf.stalk (D.f D.E.genericPoint) := ![z 0, z 1, v]
  have hz30 : ∀ a, z3 a ≠ 0 := by
    intro a; fin_cases a
    · exact hz0 0
    · exact hz0 1
    · exact hvu.ne_zero
  let S3 : Set (Fin 3) := {0, 1}
  let L3 : Fin 3 → Mori.PrimeDivisor S' := ![L 0, L 1, L 0]
  have hS3a : ∀ a ∈ S3, ∃ b : Fin 2, L3 a = L b ∧ z3 a = z b := by
    intro a ha
    rcases ha with rfl | rfl
    · exact ⟨0, rfl, rfl⟩
    · exact ⟨1, rfl, rfl⟩
  have hL3 : Set.InjOn L3 S3 := by
    intro a ha a' ha' haa
    rcases ha with rfl | rfl <;> rcases ha' with rfl | rfl
    · rfl
    · exact absurd (hL haa) (by decide)
    · exact absurd (hL haa) (by decide)
    · rfl
  have hL3x : ∀ a ∈ S3, D.f D.E.genericPoint ∈ (L3 a).support := fun a ha => by
    obtain ⟨b, hb, -⟩ := hS3a a ha; rw [hb]; exact hLx b
  have hL3z : ∀ a ∈ S3, IdealSheafData.stalk (L3 a).idealSheaf (D.f D.E.genericPoint) = Ideal.span {z3 a} :=
    fun a ha => by obtain ⟨b, hb, hb'⟩ := hS3a a ha; rw [hb, hb']; exact hLz b
  have hu3 : ∀ a ∉ S3, IsUnit (z3 a) := by
    intro a ha
    fin_cases a
    · exact absurd (Or.inl rfl) ha
    · exact absurd (Or.inr rfl) ha
    · exact hvu
  have hBL3 : ∀ E : Mori.PrimeDivisor S', D.f D.E.genericPoint ∈ E.support → B'.coeff E ≠ 0 → E ∈ L3 '' S3 := by
    intro E hE h0
    obtain ⟨b, rfl⟩ := hBL E hE h0
    fin_cases b
    · exact ⟨0, Or.inl rfl, rfl⟩
    · exact ⟨1, Or.inr rfl, rfl⟩
  have hL13 : ∀ a ∈ S3, B'.coeff (L3 a) = 1 := fun a ha => by
    obtain ⟨b, hb, -⟩ := hS3a a ha; rw [hb]; exact hL1 b
  obtain ⟨U, hxU, hU⟩ := CrepantModelAux.exists_open_coeff_divisorOfForm_add_eq_zero_of_isUnit hdS'3 z3 hz30 hw S3
    L3 hL3 hL3x hL3z hu3 hBL3 hL13
  -- the monomial frame along `P`
  have hvD : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      D.valuation (algebraMap _ S'.functionField r) ≤ 1 := by
    intro r
    by_cases hr : r = 0
    · subst hr
      have h0 : algebraMap _ S'.functionField
          (0 : S'.presheaf.stalk (D.f D.E.genericPoint)) = 0 := map_zero _
      have h1 : D.valuation (algebraMap _ S'.functionField
          (0 : S'.presheaf.stalk (D.f D.E.genericPoint))) = 0 :=
        (congrArg D.valuation h0).trans D.valuation.map_zero
      exact h1.trans_le zero_le'
    obtain ⟨M, -, hM⟩ := hmono r hr
    have hM0 : WithZero.exp (-(M : ℤ)) ≤ 1 :=
      (WithZero.exp_le_exp.2 (by omega : -(M : ℤ) ≤ 0)).trans_eq WithZero.exp_zero
    exact hM.trans_le hM0
  have hle : ∀ r : S'.presheaf.stalk (D.f D.E.genericPoint),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) ≤ 1 :=
    fun r => (hDv _).symm.trans_le (hvD r)
  have hlt : ∀ r ∈ IsLocalRing.maximalIdeal (S'.presheaf.stalk (D.f D.E.genericPoint)),
      P.divisorialValuation ((σ.toHom) (algebraMap _ S'.functionField r)) < 1 := by
    intro r hr
    refine (hDv _).symm.trans_lt ?_
    have h1 : r ∈ weightedMonomialIdeal z α 1 :=
      CrepantModelAux.span_range_le_weightedMonomialIdeal_one z α hα (hz.1 ▸ hr)
    have h2 := CrepantModelAux.valuation_le_of_mem_weightedMonomialIdeal z α D.valuation hvD hzv h1
    refine h2.trans_lt ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
