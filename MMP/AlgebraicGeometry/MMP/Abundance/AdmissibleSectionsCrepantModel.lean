  have hDΓ : (Divisor.toQDivisor (divisorOfForm θs) + BY Q).coeff Γ = 0 := by
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hordΓ, hBΓ]
