      (algebraMap (X'.presheaf.stalk x) X'.functionField)).toAlgebra
  have halgR : ∀ r : (X'.presheaf.stalk x), algebraMap (X'.presheaf.stalk x) X.functionField r =
      (σ.toHom) (algebraMap (X'.presheaf.stalk x) X'.functionField r) := fun _ => rfl
