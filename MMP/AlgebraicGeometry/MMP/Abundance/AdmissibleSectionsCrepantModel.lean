    hdX3 z3 hz30 hw S3 L3 hL3 hL3x hL3z hu3 ⟨0, Or.inl rfl⟩ hBL3 hL13 St.hm0 τ hxUt hτmem
  obtain ⟨g, hg⟩ := hgex
