    rw [h1]
    unfold formPow
    exact (PiTensorProduct.tprod _).map_coord_zero (0 : Fin 1) rfl
  have htrG : Transcendental ℂ ub := CrepantModelAux.transcendental_of_dlog_ne_zero ub hDub
  have hresu' := CrepantModelAux.forall_isUnit_approx_of_eq (jY Q ≫ sY) hΓ u u'
    (hu'.trans hau) hresu
  have hadj := CrepantModelAux.adjoin_stalkMap_eq_top_of_forall_isUnit (jY Q ≫ sY) j u' hresu'
    htrG
  exact ⟨tG, u', htG, hu', hψG, hadj⟩

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
value `c₀` at `z₀` of the coefficient `ḡ k'^{-m}` is the point value of `t` at the point
stratum `z₀` of `T_Z`. -/
private theorem isPointValue_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) 2 m (BX P)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX 2 m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (ι₂ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (_ : IsAdjunctionStep (jX P ≫ sX) (BX P) ι₂ BZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀ (_ : ιZ = ι₂ ≫ jX P ≫ 𝟙 X) (_ : topologicalKrullDim TZ = (1 : ℕ))
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v g : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : IsUnit v)
          (_ : letI := functionFieldAlgebra (ι₂ ≫ jX P ≫ sX);
            IsPoincareResidue (jX P ≫ sX) ι₂ 1 m (t P : RationalPluriForms (jX P ≫ sX) 2 m)
              (show RationalPluriForms (ι₂ ≫ jX P ≫ sX) 1 m from resZ g •
                formPow (exteriorPower.ιMulti TZ.functionField 1
                  fun _ => (resZ v)⁻¹ • KaehlerDifferential.D ℂ TZ.functionField (resZ v)) m))
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens)
          (_ : MMP.Intersection.IsDltPair (ιZ ≫ sX) BZ)
          (Γ : Mori.PrimeDivisor (CY Q))
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1)
          (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing)
          (_ : ∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1)
          (_ : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1)
          (_ : IsClosed ({Z₀.genericPoint} : Set TZ))
          (_ : Irreducible s)
          (_ : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s})
          (_ : letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint))))
          (_ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX))
          (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
          (U'' : X.Opens),
          let sK : TZ.functionField := algebraMap Z₀.localRing TZ.functionField s
          let vb : TZ.functionField := resZ v
          let Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 +
              1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)
          let τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) :=
            algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • Ωv
          let ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)]
          let ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)]
          let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
          ∀ (_ : k' ≠ 0)
            (_ : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
              k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb))
            (_ : resZ hh = k')
            (_ : IsUnit hh)
            (_ : D.f D.E.genericPoint ∈ U'')
            (_ : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0)
            (_ : ωs = lam k' • ωv)
            (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
                θs)
            (_ : BZ.coeff Z₀ = 1)
            (c0 : ℂ)
