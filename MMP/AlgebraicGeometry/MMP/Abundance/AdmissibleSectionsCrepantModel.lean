    exact hE (hHZV E ⟨_, hzE, hrangeV ⟨_, rfl⟩⟩)
  have hpbZ0 : HZ.IsPullback (νC ≫ πN) hgenνC 0 :=
    CrepantModelAux.qDivisor_isPullback_zero_of_forall V0 hHZV hrangeV
  have hHCN : H.coeff CN = 0 := by rw [hcoeffCN, hordΓ]; norm_num
  have hgenH0 : ∀ Z : irreducibleComponents CN', νC (componentGenericPoint CN' Z) ∉ H.supp := by
    intro Z
