  have hdom1 : ∀ a : TZ.presheaf.stalk (πN CN.genericPoint),
      ν (algebraMap _ TZ.functionField a) ≤ 1 := by
    intro a
    rw [hν, Valuation.comap_apply, hμ, ← hCNv, ← hFF, MMP.Mori.functionFieldMap_algebraMap_stalk]
