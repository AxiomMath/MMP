      rw [TopCat.Presheaf.stalkCongr_hom] at this
      exact this
    obtain ⟨r', hr'⟩ := (ConcreteCategory.bijective_of_isIso (X'.presheaf.stalkSpecializes hxy)).2 r0
    letI := stalkAlgebra (α ≫ ι ≫ sX) c
    obtain ⟨c0, hc0⟩ := exists_sub_mem_maximalIdeal_of_isClosed (α ≫ ι ≫ sX) c hccl
      ((ν.stalkMap c).hom ((q.stalkMap (ν c)).hom r'))
    letI := stalkAlgebra sX' (q (ν c))
    letI := stalkAlgebra sX' (D.f D.E.genericPoint)
    have hstr : ν ≫ q ≫ sX' = α ≫ ι ≫ sX := by
      rw [hsN, ← hpq]
    have hconst : (ν.stalkMap c).hom ((q.stalkMap (ν c)).hom (algebraMap k _ c0)) =
        algebraMap k (N.presheaf.stalk c) c0 := by
      have e6 := stalkMap_algebraMap_const sX' q (ν c) c0
      have e7 := stalkMap_algebraMap_const (q ≫ sX') ν c c0
      have key : ∀ (s : N ⟶ Spec (.of k)) (hs : ν ≫ q ≫ sX' = s),
          (letI := stalkAlgebra (ν ≫ q ≫ sX') c; algebraMap k (N.presheaf.stalk c) c0) =
            (letI := stalkAlgebra s c; algebraMap k (N.presheaf.stalk c) c0) := by
        rintro s rfl; rfl
      rw [e6, e7]
      exact key _ hstr
    set r'' := r' - algebraMap k _ c0
    obtain ⟨g, hg, hμg⟩ := hres r''
    have hu : IsUnit ((X'.presheaf.stalkSpecializes hxy).hom r'') := by
      letI := (X'.presheaf.stalkSpecializes hxy).hom.toAlgebra
      haveI hTow := isScalarTower_stalkSpecializes sX' hxy
      rw [map_sub, hr']
      have e8 : (X'.presheaf.stalkSpecializes hxy).hom (algebraMap k _ c0) =
          algebraMap k (X'.presheaf.stalk (D.f D.E.genericPoint)) c0 :=
        (IsScalarTower.algebraMap_apply k (X'.presheaf.stalk (q (ν c)))
          (X'.presheaf.stalk (D.f D.E.genericPoint)) c0).symm
      rw [e8]
      exact hr0 c0
    have h1 := hμunit _ g hu hg
    have h2 := hclt _ (show (ν.stalkMap c).hom ((q.stalkMap (ν c)).hom r'') ∈
        IsLocalRing.maximalIdeal _ by rw [map_sub, map_sub, hconst]; exact hc0)
    rw [hμg, h1] at h2
    exact lt_irrefl _ h2
  -- the curve `E_N` with generic point `c`
  set EN : Mori.PrimeDivisor N := AlgebraicGeometry.PrimeDivisor.ofCoheightOne c hc1 with hEN
  have hENη : EN.genericPoint = c := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hc1
  have hH0 : (QDivisor.pullback _ hqT hgenα).coeff EN = 0 := by
    rw [← hHα]
    refine coeff_eq_zero_of_isPullback_of_forall hD' hH' U hU EN ⟨c, ?_, ?_⟩
    · rw [← hENη, AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
    · change q (ν c) ∈ U
      rw [hyx]; exact hxU
  have hlog := isLogDiscrepancy_of_isPullback hT α hαB hNα hρ0
    (isCanonicalDivisor_divisorOfForm hT hdT hρ0) hqT hEα EN
  rw [hH0] at hlog
  refine ⟨⟨N, α, hNα, hαB, EN⟩, fun a ha => ?_, ?_⟩
  swap
  · simp only [Rat.cast_zero, sub_zero] at hlog
    exact hlog
  change EN.divisorialValuation (functionFieldMap α a) ≤ 1 at ha
  obtain ⟨s, hs⟩ := exists_algebraMap_eq_of_divisorialValuation_le_one EN hENη.symm ha
  rw [← hμNa, ← hs]
  exact hcle s

/-- **The normalized strict transform of a floor divisor contracted to a curve.** In the
situation of `exists_divisorOver_isLogDiscrepancy_of_valuation`: on the normalization `N` of the
strict transform of `P` on a common model `W` of `σ`, with its morphism `α : N ⟶ T`, the
pull-back of `div ρ + B_T` along `α` and the pull-back of `div τ' + B'` along `N ⟶ W ⟶ X'`
coincide. -/
private theorem exists_normalization_isPullback_of_isAdjunctionStep {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k]
    {X X' T : Scheme.{0}} {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    [IsProper sX] [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X'] [CompactSpace X']
    [LocallyOfFiniteType sX'] [IsProper sX']
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX')
    (hn : topologicalKrullDim X = (2 + 1 : ℕ)) (hn' : topologicalKrullDim X' = (2 + 1 : ℕ))
    {B : QDivisor X} {B' : QDivisor X'} {K : Divisor X} {K' : Divisor X'}
    (hK : K.IsCanonicalDivisor sX (2 + 1)) (hK' : K'.IsCanonicalDivisor sX' (2 + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) (hKB' : (Divisor.toQDivisor K' + B').IsQCartier)
    (σ : FunctionFieldEquiv sX sX') (hσ : IsCrepantBirationalMap sX sX' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ X} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sX B ι BT)
    (P : Mori.PrimeDivisor X) (hrP : Set.range ι.base = (P.support : Set X))
    (hP1 : B.coeff P = 1) (D : DivisorOver k sX')
    (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    {τ' : RationalPluriForms sX' (2 + 1) 1} (hτ'0 : τ' ≠ 0) (U : X'.Opens)
    (hxU : D.f D.E.genericPoint ∈ U)
    (hU : ∀ E : Mori.PrimeDivisor X', (E.support ∩ (U : Set X')).Nonempty →
      (Divisor.toQDivisor (divisorOfForm τ') + B').coeff E = 0)
    {ρ : RationalPluriForms (ι ≫ sX) 2 1}
    (hρres : IsPoincareResidue sX ι 2 1 (pluriformPullback sX sX' σ.toHom (2 + 1) 1 τ') ρ) :
    ∃ (W N : Scheme.{0}) (_ : IsIntegral W) (_ : IsIntegral N) (_ : IsLocallyNoetherian N)
      (_ : IsNormal N) (_ : CompactSpace N) (p : W ⟶ X) (q : W ⟶ X') (ν : N ⟶ W) (α : N ⟶ T)
      (_ : IsDominant p) (_ : IsDominant q) (_ : IsDominant α) (_ : IsProper α),
      IsBirational α ∧ IsNormalVariety k (α ≫ ι ≫ sX) ∧ α ≫ ι = ν ≫ p ∧
      (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra sX'
        ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a)) ∧
      q (ν (genericPoint N)) = D.f D.E.genericPoint ∧
      p (ν (genericPoint N)) = ι (genericPoint T) ∧ ρ ≠ 0 ∧
      (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsQCartier ∧
      ∃ (H : QDivisor N)
        (hgen₁ : ∀ Z : irreducibleComponents N, α (componentGenericPoint N Z) ∉
          (Divisor.toQDivisor (divisorOfForm ρ) + BT).supp)
        (hgen₂ : ∀ Z : irreducibleComponents N, (ν ≫ q) (componentGenericPoint N Z) ∉
          (Divisor.toQDivisor (divisorOfForm τ') + B').supp),
        (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsPullback α hgen₁ H ∧
        (Divisor.toQDivisor (divisorOfForm τ') + B').IsPullback (ν ≫ q) hgen₂ H := by
  have hT := hι.1
  haveI : LocallyOfFiniteType (ι ≫ sX) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim T = (2 : ℕ) :=
    topologicalKrullDim_eq_of_range_eq_support sX ι P hrP hn
  set τ := pluriformPullback sX sX' σ.toHom (2 + 1) 1 τ' with hτdef
  have hτ0 : τ ≠ 0 := by
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sX'
    intro h0
    apply hτ'0
    have e := pluriformPullback_comp (sX := sX') (sX' := sX) (sX'' := sX') hn' hn hn' 1
      (FunctionFieldEquiv.toHom sX' sX σ.symm) σ.toHom τ'
    have h1 : (FunctionFieldEquiv.toHom sX' sX σ.symm).comp σ.toHom =
        FunctionFieldEquiv.toHom sX' sX' 1 := by
      ext a
      exact σ.symm_apply_apply a
    rw [← hτdef, h0, map_zero, h1, pluriformPullback_one hn'] at e
    exact e.symm
  have hD : (Divisor.toQDivisor (divisorOfForm τ) + B).IsQCartier :=
    hKB.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX hK hτ0).symm)
  have hD' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsQCartier :=
    hKB'.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX' hK' hτ'0).symm)
  -- a common model `W` and the common pull-back `G = G'`
  obtain ⟨W, _, _, p, q, _, _, hpP, hqP, hpb, hqb, hpq, hcompat⟩ :=
    exists_model_of_functionFieldEquiv σ
  have hWp : IsNormalVariety k (p ≫ sX) := isNormalVariety_comp_of_isProper hX p
  have hWq : IsNormalVariety k (q ≫ sX') := isNormalVariety_comp_of_isProper hX' q
  haveI : LocallyOfFiniteType (p ≫ sX) := hWp.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q ≫ sX') := hWq.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (p ≫ sX)
  haveI : CompactSpace W := by
    have := hWp.1
    exact QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  haveI : IsNoetherian X := {}
  haveI : IsNoetherian X' := {}
  have hpB : IsBirationalMorphism p := isBirationalMorphism_of_isBirational' p hpb
  have hqB : IsBirationalMorphism q := isBirationalMorphism_of_isBirational' q hqb
  have hcompat' : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a) := fun a => by
    rw [hcompat]
    rfl
  have hgenG := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' p
    (Divisor.toQDivisor (divisorOfForm τ) + B)
  have hgenG' := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' q
    (Divisor.toQDivisor (divisorOfForm τ') + B')
  set G := QDivisor.pullback _ hD hgenG
  have hG := QDivisor.isPullback_pullback hD hgenG
  have hG' := QDivisor.isPullback_pullback hD' hgenG'
  have hGG' := pullback_eq_pullback_of_isCrepantBirationalMap hX hX' σ hσ p q hpB hqB hWp hWq
    hcompat' hτ'0 (isCanonicalDivisor_divisorOfForm hX' hn' hτ'0) hτ0
    (isCanonicalDivisor_divisorOfForm hX hn hτ0) hD hD' hG hG'
  -- the strict transform `Q` of `P` on `W` lies over the centre of `D`
  obtain ⟨Q, V, hQP, hPV, hViso, hQv⟩ := exists_primeDivisor_map_genericPoint_eq hX p hpb hWp P
  have hqQ : q Q.genericPoint = D.f D.E.genericPoint := by
    let D1 : DivisorOver k sX' := ⟨W, q, hWq, hqB, Q⟩
    have hv : D1.valuation = D.valuation := by
      ext g
      change Q.divisorialValuation (functionFieldMap q g) = _
      rw [hcompat', hQv, hDv]
    exact MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX'.1 hv
  have hcU : D.f D.E.genericPoint ∈ U := hxU
  -- `G` vanishes along `Q`, so `τ` has a simple pole along `P`
  have hGQ : G.coeff Q = 0 := by
    rw [show G = QDivisor.pullback _ hD' hgenG' from hGG']
    exact coeff_eq_zero_of_isPullback_of_forall hD' hG' U hU Q
      ⟨Q.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl,
        show q Q.genericPoint ∈ U by rw [hqQ]; exact hcU⟩
  have hpiso : IsIso (p.stalkMap Q.genericPoint) :=
    MMP.isIso_stalkMap_of_mem_biregularLocus p
      (le_biregularLocus (f := p) (V := V) hViso (by rw [hQP]; exact hPV))
  have hτP : P.ordForm τ = -1 := by
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy
      (⟨hX, 2 + 1, K, hK, hKB⟩ : Mori.IsPair sX B) (isCanonicalDivisor_divisorOfForm hX hn hτ0)
      (DivisorOver.ofPrimeDivisor k hX P)
    have hc' : c = -B.coeff P := hc.eq_neg_coeff_of_ofPrimeDivisor hX
    have hlogP := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 X) by infer_instance)
    have hlogQ := isLogDiscrepancy_of_isPullback hX p hpB hWp hτ0
      (isCanonicalDivisor_divisorOfForm hX hn hτ0) hD hG Q
    have hval : (⟨W, p, hWp, hpB, Q⟩ : DivisorOver k sX).valuation =
        (DivisorOver.ofPrimeDivisor k hX P).valuation := by
      ext g
      change Q.divisorialValuation (functionFieldMap p g) =
        P.divisorialValuation (functionFieldMap (𝟙 X) g)
      rw [MMP.Mori.functionFieldMap_id_apply, hQv]
    have he := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hlogQ hlogP hval
    have hordQ : Q.ordForm (pullbackRationalPluriForms sX p τ) = P.ordForm τ :=
      MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso p hpB.functionFieldMap_bijective
        (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn) Q P hQP τ
    rw [hordQ, hc', hGQ, hP1] at he
    have : ((P.ordForm τ : ℤ) : ℝ) = -1 := by push_cast at he ⊢; linarith
    exact_mod_cast this
  obtain ⟨hgenT, hpbT⟩ := hι.isPullback_divisorOfForm_add_of_isPoincareResidue
    (by exact_mod_cast hn) P hrP τ hτ0 hτP ρ hρres hD
  have hρ0 : ρ ≠ 0 := by
    intro h0
    have key := isPoincareResidue_eq_zero_iff (M := 0) sX hX hn (by norm_num) ι hT P hrP hτ0
      (by rw [hτP]; norm_num) hρres
    have := key.mp h0
    rw [hτP] at this
    norm_num at this
  -- the normalization `ν : N ⟶ W` of `Q` and the lift `α : N ⟶ T`
  obtain ⟨N, _, ν, hNv, hνP, hνη, hνsurj⟩ := exists_normalization_primeDivisor' hWp Q
  haveI := hνP
  haveI : IsNormal N := hNv.2
  have hιη := map_genericPoint_eq_of_range_eq ι P hrP
  have hpν : p (ν (genericPoint N)) = ι (genericPoint T) := by rw [hνη, hQP, hιη]
  obtain ⟨α, hα⟩ := exists_comp_eq_of_range_subset ι (ν ≫ p)
    (range_comp_subset_of_map_genericPoint ν p ι P hrP (by rw [hpν, hιη]))
  have hαη : α (genericPoint N) = genericPoint T := ι.isClosedEmbedding.injective (by
    rw [← Scheme.Hom.comp_apply, hα, Scheme.Hom.comp_apply, hpν])
  haveI : IsDominant α := ⟨Dense.mono (s₁ := {genericPoint T})
    (Set.singleton_subset_iff.mpr ⟨_, hαη⟩) (dense_iff_closure_eq.mpr (genericPoint_spec T))⟩
  haveI : IsNoetherian T := {}
  have hpiso' : IsIso (p.stalkMap (ν (genericPoint N))) := by rw [hνη]; exact hpiso
  have hαs := surjective_functionFieldMap_of_lift p ι ν α hα hpν hpiso' hνsurj
  haveI : IsProper α := by
    have : IsProper (α ≫ ι) := by rw [hα]; infer_instance
    exact IsProper.of_comp α ι
  have hαb : IsBirational α := isBirational_of_surjective_functionFieldMap α hαs
  have hsN : α ≫ ι ≫ sX = ν ≫ p ≫ sX := by rw [← Category.assoc, hα, Category.assoc]
  have hNα : IsNormalVariety k (α ≫ ι ≫ sX) := hsN ▸ hNv
  haveI : LocallyOfFiniteType (α ≫ ι ≫ sX) := hNα.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian N := LocallyOfFiniteType.isLocallyNoetherian (α ≫ ι ≫ sX)
  haveI : CompactSpace N := by
    have := hNα.1
    exact QuasiCompact.compactSpace_of_compactSpace (α ≫ ι ≫ sX)
  -- `H = (ν ≫ p)^*(div τ + B)`, computed through `T` and through `W`
  have hDP : (Divisor.toQDivisor (divisorOfForm τ) + B).coeff P = 0 := by
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hτP, hP1]
    norm_num
  have hgenH : ∀ Z : irreducibleComponents N,
      (ν ≫ p) (componentGenericPoint N Z) ∉ (Divisor.toQDivisor (divisorOfForm τ) + B).supp := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply, hpν, hιη]
    exact genericPoint_notMem_supp_of_coeff_eq_zero hDP
  have hH := QDivisor.isPullback_pullback hD hgenH
  set H := QDivisor.pullback _ hD hgenH
  have hqT := isQCartier_of_isPullback hD hpbT
  have hgenα := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' α
    (Divisor.toQDivisor (divisorOfForm ρ) + BT)
  have hEα := QDivisor.isPullback_pullback hqT hgenα
  have hHα : H = QDivisor.pullback _ hqT hgenα :=
    (QDivisor.IsQCartier.existsUnique_isPullback hD hgenH).unique hH
      (isPullback_of_hom_eq hα (qDivisor_isPullback_comp' ι α hpbT hEα (by rw [hα]; exact hgenH)))
  have hgenν : ∀ Z : irreducibleComponents N, ν (componentGenericPoint N Z) ∉ G.supp := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint, hνη]
    exact genericPoint_notMem_supp_of_coeff_eq_zero hGQ
  have hqG := isQCartier_of_isPullback hD hG
  have hHν := QDivisor.isPullback_pullback hqG hgenν
  have hHHν : H = QDivisor.pullback _ hqG hgenν :=
    (QDivisor.IsQCartier.existsUnique_isPullback hD hgenH).unique hH
      (qDivisor_isPullback_comp' p ν hG hHν hgenH)
  have hgenν' : ∀ Z : irreducibleComponents N,
      ν (componentGenericPoint N Z) ∉ (QDivisor.pullback _ hD' hgenG').supp := by
    rw [← hGG']; exact hgenν
  have hgenH' : ∀ Z : irreducibleComponents N,
      (ν ≫ q) (componentGenericPoint N Z) ∉ (Divisor.toQDivisor (divisorOfForm τ') + B').supp := by
    intro Z hZ
    obtain ⟨E, hE, hzE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hZ
    refine hE (hU E ⟨_, hzE, ?_⟩)
    rw [componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply, hνη, hqQ]
    exact hcU
  have hH' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsPullback (ν ≫ q) hgenH' H := by
    rw [hHHν]
    exact qDivisor_isPullback_comp' q ν hG' (isPullback_of_eq_source (h₂ := hgenν') hGG' hHν)
      hgenH'
  refine ⟨W, N, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, p, q,
    ν, α, inferInstance, inferInstance, inferInstance, inferInstance, hαb, hNα, hα, hcompat',
    by rw [hνη, hqQ], hpν, hρ0, hqT, H, hgenα, hgenH', ?_, hH'⟩
  rw [hHα]
  exact hEα

/-- **Vertical curves of a surface fibred over a curve.** Let `Γ` be a prime divisor of a normal
surface `X` over `ℂ` whose function field is `K(ē)`, `K = λ(k(Z))` the function field of a curve
`Z`, and suppose the valuation of `Γ` is centred on `Z` at a closed point `z₀`, with uniformizer
`s`. If `dlog ē ∧ dlog λ(s)` has a pole along `Γ`, then it is `dlog t ∧ dlog u` for a uniformizer
`t` and a unit `u` of `𝒪_{X,Γ}`, and the residue field of `Γ` is generated by `ū`. -/
private theorem exists_irreducible_isUnit_dlog_eq_of_center {X TZ : Scheme.{0}}
    {sX : X ⟶ Spec (.of ℂ)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (hd : topologicalKrullDim X = (2 : ℕ)) (Γ : Mori.PrimeDivisor X)
    {sZ : TZ ⟶ Spec (.of ℂ)} [IsIntegral TZ] [LocallyOfFiniteType sZ] (z₀ : TZ)
    (hz₀ : IsClosed ({z₀} : Set TZ)) (s : TZ.presheaf.stalk z₀) (hs0 : s ≠ 0)
    (hs : IsLocalRing.maximalIdeal (TZ.presheaf.stalk z₀) = Ideal.span {s})
    (lam : TZ.functionField →+* X.functionField)
    (hlamk : letI := functionFieldAlgebra sX; letI := functionFieldAlgebra sZ
      ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
    (eb : X.functionField) (heb0 : eb ≠ 0)
    (heb : letI : Algebra TZ.functionField X.functionField := lam.toAlgebra
      IntermediateField.adjoin TZ.functionField {eb} = ⊤)
    (hμO : ∀ c : TZ.presheaf.stalk z₀,
      Γ.divisorialValuation (lam (algebraMap _ TZ.functionField c)) ≤ 1)
    (hμs : Γ.divisorialValuation (lam (algebraMap _ TZ.functionField s)) < 1)
    (hpole : letI := functionFieldAlgebra sX
      Γ.ordForm (show RationalPluriForms sX 2 ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
        X.functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
          (lam (algebraMap _ TZ.functionField s))⁻¹ •
            KaehlerDifferential.D ℂ _ (lam (algebraMap _ TZ.functionField s))]) 1) < 0) :
    letI := functionFieldAlgebra sX
    letI := stalkAlgebra sX Γ.genericPoint
    ∃ t u : Γ.localRing, Irreducible t ∧ IsUnit u ∧
      exteriorPower.ιMulti X.functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
          (lam (algebraMap _ TZ.functionField s))⁻¹ •
            KaehlerDifferential.D ℂ _ (lam (algebraMap _ TZ.functionField s))] =
        exteriorPower.ιMulti X.functionField 2 ![(algebraMap _ X.functionField t)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField t),
          (algebraMap _ X.functionField u)⁻¹ •
            KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField u)] ∧
      ∀ x : Γ.localRing, IsUnit x → ∃ p q : Polynomial ℂ, q ≠ 0 ∧
        x * (Polynomial.aeval u).toRingHom q - (Polynomial.aeval u).toRingHom p ∈
          IsLocalRing.maximalIdeal Γ.localRing := by
  classical
  letI := functionFieldAlgebra sX
  letI := stalkAlgebra sX Γ.genericPoint
  haveI := isScalarTower_stalk_functionField sX Γ.genericPoint
  haveI := Γ.isDiscreteValuationRing_localRing
  letI := functionFieldAlgebra sZ
  letI := stalkAlgebra sZ z₀
  haveI := isScalarTower_stalk_functionField sZ z₀
  letI : Algebra TZ.functionField X.functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField X.functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  set μ := Γ.divisorialValuation with hμ
  set σ := lam (algebraMap _ TZ.functionField s) with hσ
  have hinjZ : Function.Injective (algebraMap (TZ.presheaf.stalk z₀) TZ.functionField) :=
    IsFractionRing.injective _ _
  have hinjΓ : Function.Injective (algebraMap Γ.localRing X.functionField) :=
    IsFractionRing.injective _ _
  have hσ0 : σ ≠ 0 := (map_ne_zero lam).2 ((map_ne_zero_iff _ hinjZ).2 hs0)
  -- the orders `a = ord ē`, `e = ord λ(s) ≥ 1`
  set a := X.ord eb Γ.genericPoint with ha
  set e := X.ord σ Γ.genericPoint with he
  have hμeb : μ eb = WithZero.exp (-a) := Γ.divisorialValuation_eq_exp_neg_ord heb0
  have hμσ : μ σ = WithZero.exp (-e) := Γ.divisorialValuation_eq_exp_neg_ord hσ0
  have he1 : 1 ≤ e := by
    have h := hμs
    rw [hμσ, ← WithZero.exp_zero, WithZero.exp_lt_exp] at h
    omega
  -- the unimodular change of monomials
  obtain ⟨M, hMdet, hMv⟩ := exists_det_eq_one_mulVec_eq a e
  set zU : Fin 2 → X.functionFieldˣ := ![Units.mk0 eb heb0, Units.mk0 σ hσ0] with hzU
  have hval : ∀ i, μ ((∏ b, zU b ^ M i b : X.functionFieldˣ) : X.functionField) =
      WithZero.exp (-(M.mulVec ![a, e]) i) := by
    intro i
    rw [Units.coe_prod, map_prod, Fin.prod_univ_two]
    simp only [Units.val_zpow_eq_zpow_val, map_zpow₀, hzU, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons, Units.val_mk0, hμeb, hμσ]
    rw [← WithZero.exp_zsmul, ← WithZero.exp_zsmul, ← WithZero.exp_add]
    congr 1
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons, smul_eq_mul]
    ring

  set π' : X.functionField := ((∏ b, zU b ^ M 0 b : X.functionFieldˣ) : X.functionField) with hπ'
  set u0 : X.functionField := ((∏ b, zU b ^ M 1 b : X.functionFieldˣ) : X.functionField) with hu0
  have hd0 : (0 : ℤ) < (Int.gcd a e : ℤ) := by
    have : Int.gcd a e ≠ 0 := by
      intro h0; have := (Int.gcd_eq_zero_iff.1 h0).2; omega
    exact_mod_cast Nat.pos_of_ne_zero this
  have hμπ : μ π' = WithZero.exp (-(Int.gcd a e : ℤ)) := by
    rw [hval 0, hMv]; rfl
  have hμu : μ u0 = 1 := by
    rw [hval 1, hMv]; simp
  have hπle : μ π' ≤ 1 := by
    rw [hμπ, ← WithZero.exp_zero, WithZero.exp_le_exp]; omega
  obtain ⟨t, ht⟩ := (Γ.divisorialValuation_le_one_iff π').1 hπle
  obtain ⟨u, hu⟩ := (Γ.divisorialValuation_le_one_iff u0).1 hμu.le
  have hut : IsUnit u := by
    by_contra hnu
    have h1 := (Γ.divisorialValuation_algebraMap_lt_one_iff u).2
      ((IsLocalRing.mem_maximalIdeal _).2 hnu)
    rw [hu, hμu] at h1
    exact lt_irrefl _ h1
  have htm : t ∈ IsLocalRing.maximalIdeal Γ.localRing := by
    refine (Γ.divisorialValuation_algebraMap_lt_one_iff t).1 ?_
    rw [ht, hμπ, ← WithZero.exp_zero, WithZero.exp_lt_exp]; omega
  have hπ0 : π' ≠ 0 := Units.ne_zero _
  have ht0 : t ≠ 0 := by rintro rfl; rw [map_zero] at ht; exact hπ0 ht.symm
  -- the `dlog`-forms agree, `det M = 1`
  have hdl := ιMulti_dlogHom_monomial ℂ X.functionField zU M
  rw [hMdet, Int.cast_one, one_smul] at hdl
  have hL : (![eb⁻¹ • KaehlerDifferential.D ℂ _ eb, σ⁻¹ • KaehlerDifferential.D ℂ _ σ] :
      Fin 2 → Ω[X.functionField⁄ℂ]) =
      fun b => Multiplicative.toAdd (dlogHom ℂ X.functionField (zU b)) := by
    funext b; fin_cases b <;> rfl
  have hR : (![(algebraMap _ X.functionField t)⁻¹ •
        KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField t),
        (algebraMap _ X.functionField u)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField u)] :
      Fin 2 → Ω[X.functionField⁄ℂ]) =
      fun a => Multiplicative.toAdd (dlogHom ℂ X.functionField (∏ b, zU b ^ M a b)) := by
    funext a; fin_cases a
    · show (algebraMap _ X.functionField t)⁻¹ • _ = _; rw [ht]; rfl
    · show (algebraMap _ X.functionField u)⁻¹ • _ = _; rw [hu]; rfl
  have hθ : exteriorPower.ιMulti X.functionField 2
      ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb, σ⁻¹ • KaehlerDifferential.D ℂ _ σ] =
      exteriorPower.ιMulti X.functionField 2 ![(algebraMap _ X.functionField t)⁻¹ •
        KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField t),
        (algebraMap _ X.functionField u)⁻¹ •
          KaehlerDifferential.D ℂ _ (algebraMap _ X.functionField u)] := by
    rw [hL, hR]; exact hdl.symm
  -- the residue of `u` is transcendental
  have hw : ∀ p : Polynomial ℂ, p ≠ 0 → IsUnit ((Polynomial.aeval u).toRingHom p) := by
    rcases forall_isUnit_aeval_or_exists_sub_mem (k := ℂ) u with h | ⟨r, hr⟩
    · exact h
    · exfalso
      have hπ0' : algebraMap Γ.localRing X.functionField t ≠ 0 := by rw [ht]; exact hπ0
      have h0 := zero_le_ordForm_formPow_dlogWedge Γ hd 1 u hut r hr _ hπ0'
      have hθ' : exteriorPower.ιMulti X.functionField 2
          ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb, σ⁻¹ • KaehlerDifferential.D ℂ _ σ] =
          dlogWedge (k := ℂ) (K := X.functionField) u (algebraMap Γ.localRing _ t) := hθ
      rw [hθ'] at hpole
      exact absurd hpole (not_lt.2 h0)
  -- approximation of `k(X) = K(ē)` by `ℂ(λ(s), ē)`
  have hres : ∀ c : TZ.presheaf.stalk z₀, ∃ a : ℂ, ∃ r : TZ.presheaf.stalk z₀,
      c - algebraMap ℂ _ a = s * r := by
    intro c
    obtain ⟨a, ha⟩ := exists_sub_mem_maximalIdeal_of_isClosed sZ z₀ hz₀ c
    rw [hs, Ideal.mem_span_singleton'] at ha
    obtain ⟨r, hr⟩ := ha
    exact ⟨a, r, by rw [← hr, mul_comm]⟩
  have happ := exists_mem_adjoin_valuation_sub_lt (k := ℂ) (O := TZ.presheaf.stalk z₀)
    (K := TZ.functionField) (L := X.functionField) s hres eb heb μ (fun c => hμO c) hμs
  have hsub : IntermediateField.adjoin ℂ ({σ, eb} : Set X.functionField) ≤
      IntermediateField.adjoin ℂ ({algebraMap _ X.functionField t,
        algebraMap _ X.functionField u} : Set X.functionField) := by
    rw [IntermediateField.adjoin_le_iff]
    have hmono : ∀ v : Fin 2 → ℤ, ((∏ b, zU b ^ v b : X.functionFieldˣ) : X.functionField) ∈
        IntermediateField.adjoin ℂ ({algebraMap _ X.functionField t,
          algebraMap _ X.functionField u} : Set X.functionField) := by
      intro v
      rw [prod_zpow_eq_prod_monomial_zpow zU M (by rw [hMdet]; exact isUnit_one) v,
        Units.coe_prod]
      refine IntermediateField.prod_mem _ fun i _ => ?_
      rw [Units.val_zpow_eq_zpow_val]
      refine IntermediateField.pow_mem _ ?_ _
      fin_cases i
      · show ((∏ b, zU b ^ M 0 b : X.functionFieldˣ) : X.functionField) ∈ _
        rw [← hπ', ← ht]
        exact IntermediateField.subset_adjoin _ _ (Set.mem_insert _ _)
      · show ((∏ b, zU b ^ M 1 b : X.functionFieldˣ) : X.functionField) ∈ _
        rw [← hu0, ← hu]
        exact IntermediateField.subset_adjoin _ _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    rintro x (rfl | rfl)
    · have := hmono ![0, 1]
      simpa [Fin.prod_univ_two, hzU] using this
    · have := hmono ![1, 0]
      simpa [Fin.prod_univ_two, hzU] using this
  have hA2 := irreducible_and_residue_of_forall_exists_valuation_sub_lt (k := ℂ)
    (O := Γ.localRing) (K := X.functionField) μ
    (fun r => (Γ.divisorialValuation_le_one_iff _).2 ⟨r, rfl⟩)
    (fun r => Γ.divisorialValuation_algebraMap_lt_one_iff r) t u htm ht0 hw
    (fun x hx => by
      obtain ⟨g, hg, hgl⟩ := happ x hx
      exact ⟨g, hsub hg, hgl⟩)
  exact ⟨t, u, hA2.1, hut, hθ, hA2.2⟩

end ExceptionalCentres

end

section VerticalCurveHelpers

open scoped WithZero
open exteriorPower

/-- A unit of `𝒪_{X,x}` has order zero along every prime divisor meeting some neighbourhood of
`x`, namely the non-vanishing locus of a section representing it. -/
private theorem exists_open_ord_eq_zero {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    {x : X} {a : X.presheaf.stalk x} (ha : IsUnit a) :
    ∃ U' : X.Opens, x ∈ U' ∧ ∀ Γ : Mori.PrimeDivisor X, (Γ.support ∩ U').Nonempty →
      X.ord (algebraMap (X.presheaf.stalk x) X.functionField a) Γ.genericPoint = 0 := by
  obtain ⟨V, hxV, f, rfl⟩ := X.presheaf.exists_germ_eq a
  refine ⟨X.basicOpen f, (X.mem_basicOpen f x hxV).mpr ha, fun Γ ⟨y, hyΓ, hyU⟩ => ?_⟩
  have hη : Γ.genericPoint ∈ X.basicOpen f := by
    have hsp : Γ.genericPoint ⤳ y := by
      rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hyΓ
    exact hsp.mem_open (X.basicOpen f).isOpen hyU
  have hηV : Γ.genericPoint ∈ V := X.basicOpen_le f hη
  have : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hu := (X.mem_basicOpen f Γ.genericPoint hηV).mp hη
  rw [Scheme.algebraMap_germ_eq_germToFunctionField,
    ← Scheme.algebraMap_germ_eq_germToFunctionField X hηV f]
  exact Γ.ord_algebraMap_of_isUnit hu

/-- **A uniformizer at a smooth closed point generates the differentials of the function field.**
If `s` generates the maximal ideal of `𝒪_{Z,z}` at a smooth point `z` with residue field `k`, then
`ds` spans `Ω_{k(Z)/k}`. -/
private theorem span_D_algebraMap_eq_top_of_span_eq_maximalIdeal {k : Type} [Field k]
    {Z : Scheme.{0}} {sZ : Z ⟶ Spec (.of k)} [IsIntegral Z] (z₀ : Z)
    (hres : letI := stalkAlgebra sZ z₀
      Function.Surjective (algebraMap k (IsLocalRing.ResidueField (Z.presheaf.stalk z₀))))
    (s : Z.presheaf.stalk z₀) (hs : IsLocalRing.maximalIdeal (Z.presheaf.stalk z₀) = Ideal.span {s})
    (hsm : z₀ ∈ Mori.smoothLocus sZ) :
    letI := functionFieldAlgebra sZ
    Submodule.span Z.functionField
      {KaehlerDifferential.D k Z.functionField (algebraMap _ Z.functionField s)} = ⊤ := by
  letI := stalkAlgebra sZ z₀
  letI := functionFieldAlgebra sZ
  haveI := isScalarTower_stalk_functionField sZ z₀
  obtain ⟨r0, ⟨b0⟩⟩ := exists_basis_kaehler_stalk_of_mem_smoothLocus sZ hsm
  haveI : Module.Finite (Z.presheaf.stalk z₀) Ω[Z.presheaf.stalk z₀⁄k] := Module.Finite.of_basis b0
  have hO := span_D_eq_top_of_span_eq_maximalIdeal hres ![s] (by
    rw [hs]; congr 1; ext y; simp)
  have hK := KaehlerDifferential.span_range_map_derivation_of_isLocalization (R := k)
    (S := Z.presheaf.stalk z₀) (T := Z.functionField) (nonZeroDivisors _)
  rw [eq_top_iff, ← hK, Submodule.span_le]
  rintro _ ⟨r, rfl⟩
  have hr : KaehlerDifferential.D k _ r ∈ Submodule.span (Z.presheaf.stalk z₀)
      {KaehlerDifferential.D k (Z.presheaf.stalk z₀) s} := by
    have : (Set.range fun i : Fin 1 => KaehlerDifferential.D k (Z.presheaf.stalk z₀) (![s] i)) =
        {KaehlerDifferential.D k (Z.presheaf.stalk z₀) s} := by
      ext y; simp
    rw [← this, hO]; trivial
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hr
  simp only [Function.comp_apply, ← hc, map_smul, KaehlerDifferential.map_D]
  exact Submodule.smul_of_tower_mem _ c (Submodule.subset_span rfl)

/-- Pluriform pull-back is semilinear along the homomorphism of function fields. -/
private theorem pluriformPullback_smul_left {k : Type} [Field k] {X X' : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral X']
    (φ : FunctionFieldHom sX sX') {d : ℕ} {m : ℤ}
    (c : X'.functionField) (τ : RationalPluriForms sX' d m) :
    pluriformPullback sX sX' φ d m (c • τ) = φ c • pluriformPullback sX sX' φ d m τ := by
  let := functionFieldAlgebra sX'
  let := functionFieldAlgebra sX
  let : Algebra X'.functionField X.functionField := φ.toRingHom.toAlgebra
  have : IsScalarTower k X'.functionField X.functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  exact pullbackForms_smul (K := X'.functionField) (K' := X.functionField) c τ

/-- The approximation property of a unit `u` of `𝒪_{Y,P}` by quotients of polynomials in `u`
modulo the maximal ideal only depends on the point `x = η_P` and the germ of `u`. -/
private theorem forall_isUnit_approx_of_eq {k : Type} [Field k] {Y : Scheme.{0}} [IsIntegral Y]
    (sY : Y ⟶ Spec (.of k)) {x y : Y} (hxy : x = y) (u : Y.presheaf.stalk y)
    (u' : Y.presheaf.stalk x)
    (h : algebraMap _ Y.functionField u' = algebraMap _ Y.functionField u)
    (H : letI := stalkAlgebra sY y
      ∀ a : Y.presheaf.stalk y, IsUnit a → ∃ p q : Polynomial k, q ≠ 0 ∧
        a * (Polynomial.aeval u).toRingHom q - (Polynomial.aeval u).toRingHom p ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) :
    letI := stalkAlgebra sY x
    ∀ a : Y.presheaf.stalk x, IsUnit a → ∃ p q : Polynomial k, q ≠ 0 ∧
      a * (Polynomial.aeval u').toRingHom q - (Polynomial.aeval u').toRingHom p ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
  subst hxy
  obtain rfl : u' = u := IsFractionRing.injective _ _ h
  exact H

/-- **Residue fields generated by one residue.** Let `j : T ⟶ Y` be a closed immersion of
integral schemes over `k` and `u` a germ at `j η_T` such that every unit of `𝒪_{Y, j η_T}` is
congruent to a quotient `p(u)/q(u)`, `q ≠ 0`, modulo the maximal ideal. If the residue `ū` is
transcendental over `k`, then it generates the function field of `T`. -/
private theorem adjoin_stalkMap_eq_top_of_forall_isUnit {k : Type} [Field k] {Y T : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral T] (j : T ⟶ Y) [IsClosedImmersion j]
    (u : Y.presheaf.stalk (j (genericPoint T)))
    (H : letI := stalkAlgebra sY (j (genericPoint T))
      ∀ a : Y.presheaf.stalk (j (genericPoint T)), IsUnit a → ∃ p q : Polynomial k, q ≠ 0 ∧
        a * (Polynomial.aeval u).toRingHom q - (Polynomial.aeval u).toRingHom p ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk (j (genericPoint T))))
    (htr : letI := functionFieldAlgebra (j ≫ sY)
      Transcendental k ((j.stalkMap (genericPoint T)).hom u)) :
    letI := functionFieldAlgebra (j ≫ sY)
    IntermediateField.adjoin k ({(j.stalkMap (genericPoint T)).hom u} : Set T.functionField) =
      ⊤ := by
  letI := stalkAlgebra sY (j (genericPoint T))
  letI := functionFieldAlgebra (j ≫ sY)
  set φ := (j.stalkMap (genericPoint T)).hom with hφ
  have hφk : ∀ c : k, φ (algebraMap k _ c) = algebraMap k T.functionField c :=
    fun c => stalkMap_algebraMap_const sY j (genericPoint T) c
  have hφp : ∀ p : Polynomial k, φ ((Polynomial.aeval u).toRingHom p) =
      Polynomial.aeval (φ u) p := by
    intro p
    change φ (Polynomial.eval₂ (algebraMap k _) u p) = Polynomial.eval₂ (algebraMap k _) (φ u) p
    rw [Polynomial.hom_eval₂]
    congr 1
    ext c
    exact hφk c
  have hsurj : Function.Surjective φ := SurjectiveOnStalks.stalkMap_surjective j _
  rw [eq_top_iff]
  intro y _
  obtain ⟨a, rfl⟩ := hsurj y
  by_cases ha : IsUnit a
  · obtain ⟨p, q, hq, hpq⟩ := H a ha
    have h0 := (stalkMap_eq_zero_iff j _).2 hpq
    rw [← hφ, map_sub, map_mul, hφp, hφp, sub_eq_zero] at h0
    have hq0 : Polynomial.aeval (φ u) q ≠ 0 := fun h => hq ((transcendental_iff.1 htr) q h)
    have ha' : φ a = Polynomial.aeval (φ u) p / Polynomial.aeval (φ u) q := by
      rw [eq_div_iff hq0, h0]
    rw [ha']
    have hmem : ∀ r : Polynomial k, Polynomial.aeval (φ u) r ∈
        IntermediateField.adjoin k ({φ u} : Set T.functionField) := fun r =>
      IntermediateField.algebra_adjoin_le_adjoin k _ (Polynomial.aeval_mem_adjoin_singleton k _)
    exact div_mem (hmem p) (hmem q)
  · have : φ a = 0 := (stalkMap_eq_zero_iff j _).2 ((IsLocalRing.mem_maximalIdeal _).2 ha)
    rw [this]
    exact zero_mem _

/-- An element of a field over an algebraically closed field `k` whose logarithmic differential
is nonzero is transcendental over `k`. -/
private theorem transcendental_of_dlog_ne_zero {k K : Type*} [Field k] [IsAlgClosed k] [Field K]
    [Algebra k K] (x : K) (hx : KaehlerDifferential.D k K x ≠ 0) : Transcendental k x := by
  intro halg
  have hint : IsIntegral k x := halg.isIntegral
  obtain ⟨c, rfl⟩ := minpoly.mem_range_of_degree_eq_one k x
    (IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible hint))
  exact hx ((KaehlerDifferential.D k K).map_algebraMap c)

open Polynomial in
/-- Over a field `K`, a valuation trivial on `K` with `w e ≤ 1` is at most one on `K[e]`. -/
private theorem valuation_aeval_le_one {K L : Type*} [Field K] [Field L] [Algebra K L] {e : L}
    {w : Valuation L ℤᵐ⁰} (hK : ∀ c : K, c ≠ 0 → w (algebraMap K L c) = 1) (he : w e ≤ 1)
    (r : K[X]) : w (aeval e r) ≤ 1 := by
  induction r using Polynomial.induction_on with
  | C a =>
    rw [aeval_C]
    by_cases ha : a = 0
    · rw [ha, map_zero, map_zero]; exact zero_le'
    · exact (hK a ha).le
  | add p q hp hq =>
    rw [map_add]; exact (w.map_add _ _).trans (max_le hp hq)
  | monomial n a h =>
    rw [pow_succ, ← mul_assoc, map_mul, map_mul, aeval_X]
    calc w (aeval e (Polynomial.C a * Polynomial.X ^ n)) * w e ≤ 1 * 1 := mul_le_mul' h he
      _ = 1 := one_mul 1

open Polynomial in
/-- The `e`-adic order: a valuation trivial on `K` with `w e < 1` takes the value
`w e ^ ord_X p` at `p(e)`. -/
private theorem valuation_aeval_eq_pow_rootMultiplicity {K L : Type*} [Field K] [Field L] [Algebra K L]
    {e : L} {w : Valuation L ℤᵐ⁰} (hK : ∀ c : K, c ≠ 0 → w (algebraMap K L c) = 1)
    (he : w e < 1) (p : K[X]) (hp : p ≠ 0) :
    w (aeval e p) = w e ^ (rootMultiplicity 0 p) := by
  obtain ⟨q, hpq, hq⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd p hp 0
  simp only [map_zero, sub_zero] at hpq hq
  rw [X_dvd_iff] at hq
  have hq1 : w (aeval e q) = 1 := by
    have h1 : aeval e q = e * aeval e (divX q) + algebraMap K L (q.coeff 0) := by
      conv_lhs => rw [← X_mul_divX_add q]
      rw [map_add, map_mul, aeval_X, aeval_C]
    have h2 : w (e * aeval e (divX q)) < w (algebraMap K L (q.coeff 0)) := by
      rw [hK _ hq, map_mul]
      calc w e * w (aeval e (divX q)) ≤ w e * 1 :=
            mul_le_mul' le_rfl (valuation_aeval_le_one hK he.le _)
        _ = w e := mul_one _
        _ < 1 := he
    rw [h1, Valuation.map_add_eq_of_lt_right _ h2, hK _ hq]
  conv_lhs => rw [hpq]
  rw [map_mul, map_pow, aeval_X, map_mul, map_pow, hq1, mul_one]

open Polynomial in
/-- Two valuations of `K(e)` trivial on `K` and `< 1` at `e` are equivalent. -/
private theorem valuation_isEquiv_of_transcendental {K L : Type*} [Field K] [Field L] [Algebra K L] {e : L}
    (htr : Transcendental K e) (hgen : IntermediateField.adjoin K {e} = ⊤)
    {w₁ w₂ : Valuation L ℤᵐ⁰} (h₁ : ∀ c : K, c ≠ 0 → w₁ (algebraMap K L c) = 1)
    (h₂ : ∀ c : K, c ≠ 0 → w₂ (algebraMap K L c) = 1) (he₁ : w₁ e < 1) (he₂ : w₂ e < 1) :
    w₁.IsEquiv w₂ := by
  have he0 : e ≠ 0 := fun h0 => htr (h0 ▸ isAlgebraic_zero)
  have hcrit : ∀ (w : Valuation L ℤᵐ⁰), (∀ c : K, c ≠ 0 → w (algebraMap K L c) = 1) →
      w e < 1 → ∀ r s : K[X], r ≠ 0 → s ≠ 0 →
      (w (aeval e r / aeval e s) ≤ 1 ↔ rootMultiplicity 0 s ≤ rootMultiplicity 0 r) := by
    intro w hK hw r s hr hs
    have hw0 : 0 < w e := by
      rw [zero_lt_iff]; exact (Valuation.ne_zero_iff _).2 he0
    have hs0 : w (aeval e s) ≠ 0 := by
      rw [valuation_aeval_eq_pow_rootMultiplicity hK hw s hs]; exact pow_ne_zero _ hw0.ne'
    rw [map_div₀, div_le_one₀ (zero_lt_iff.2 hs0), valuation_aeval_eq_pow_rootMultiplicity hK hw r hr,
      valuation_aeval_eq_pow_rootMultiplicity hK hw s hs]
    exact pow_le_pow_iff_right_of_lt_one₀ hw0 hw
  refine Valuation.isEquiv_of_val_le_one fun x => ?_
  have hx : x ∈ IntermediateField.adjoin K {e} := by rw [hgen]; trivial
  obtain ⟨r, s, rfl⟩ := (IntermediateField.mem_adjoin_simple_iff K x).1 hx
  by_cases hr : r = 0
  · simp [hr]
  by_cases hs : s = 0
  · simp [hs]
  rw [hcrit w₁ h₁ he₁ r s hr hs, hcrit w₂ h₂ he₂ r s hr hs]

/-- `K(e⁻¹) = K(e)`. -/
private theorem adjoin_simple_inv_eq {K L : Type*} [Field K] [Field L] [Algebra K L] (e : L) :
    IntermediateField.adjoin K {e⁻¹} = IntermediateField.adjoin K {e} := by
  apply le_antisymm
  · rw [IntermediateField.adjoin_simple_le_iff]
    exact inv_mem (IntermediateField.mem_adjoin_simple_self K e)
  · rw [IntermediateField.adjoin_simple_le_iff]
    simpa using inv_mem (IntermediateField.mem_adjoin_simple_self K e⁻¹)

/-- A nonzero constant multiple of a rational form has the same divisor. -/
private theorem divisorOfForm_const_smul {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX]
    {d : ℕ} {m : ℤ} {c : k} (hc : c ≠ 0) (τ : RationalPluriForms sX d m) :
    divisorOfForm (c • τ) = divisorOfForm τ :=
  DivisorWithCoeffs.ext' fun E => by
    rw [coeff_divisorOfForm, coeff_divisorOfForm, MMP.Fourfold.ordForm_const_smul E hc]

/-- Crepancy of a birational map only depends on the structure morphisms up to equality. -/
private theorem isCrepantBirationalMap_congr_right {k : Type} [Field k] {V U : Scheme.{0}}
    [IsIntegral V] [IsIntegral U] [IsLocallyNoetherian V] [IsNormal V] [IsLocallyNoetherian U]
    [IsNormal U] {s₁ : V ⟶ Spec (.of k)} {s₂ s₂' : U ⟶ Spec (.of k)} (h : s₂ = s₂')
    {BV : QDivisor V} {BU : QDivisor U} {φ : FunctionFieldEquiv s₁ s₂}
    {ψ : FunctionFieldEquiv s₁ s₂'} (hφψ : ∀ c, φ c = ψ c)
    (hc : IsCrepantBirationalMap s₁ s₂ BV BU φ) : IsCrepantBirationalMap s₁ s₂' BV BU ψ := by
  subst h
  obtain rfl : φ = ψ := by
    letI := functionFieldAlgebra s₂; letI := functionFieldAlgebra s₁
    exact AlgEquiv.ext hφψ
  exact hc

end VerticalCurveHelpers

end CrepantModelAux

/-! ### Uniqueness of strict transforms -/

/-- Two points over the same point of the biregular locus of a morphism agree. -/
private theorem eq_of_map_eq_of_mem_biregularLocus {X Y : Scheme.{0}} (g : X ⟶ Y) {x x' : X}
    (h : g x = g x') (hx : g x ∈ Mori.biregularLocus g) : x = x' := by
  set V := Mori.biregularLocus g
  haveI : IsIso (g ∣_ V) := Mori.isBiregular_biregularLocus g
  have hx' : g x' ∈ V := h ▸ hx
  have hinj := (ConcreteCategory.bijective_of_isIso (g ∣_ V).base).1
  have e : (g ∣_ V).base ⟨x, hx⟩ = (g ∣_ V).base ⟨x', hx'⟩ := by
    apply Subtype.ext
    change (g ∣_ V ≫ V.ι).base _ = (g ∣_ V ≫ V.ι).base _
    rw [morphismRestrict_ι]
    exact h
  exact congrArg Subtype.val (hinj e)

/-! ### Composition of crepant birational maps -/

section CrepantComp

variable {k : Type} [Field k] {X X' X'' : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X'] [IsIntegral X'']
  [IsLocallyNoetherian X''] [IsNormal X''] {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)}
  {sX'' : X'' ⟶ Spec (.of k)} {B : QDivisor X} {B' : QDivisor X'} {B'' : QDivisor X''}

/-- Crepant birational maps compose. -/
private theorem IsCrepantBirationalMap.trans {σ₁ : FunctionFieldEquiv sX sX'}
    {σ₂ : FunctionFieldEquiv sX' sX''} (h₁ : IsCrepantBirationalMap sX sX' B B' σ₁)
    (h₂ : IsCrepantBirationalMap sX' sX'' B' B'' σ₂) :
    IsCrepantBirationalMap sX sX'' B B''
      (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra sX';
        letI := functionFieldAlgebra sX''; σ₂.trans σ₁) := by
  intro v a
  exact (h₁ v a).trans (h₂ _ a)

/-- The inverse of a crepant birational map is crepant. -/
private theorem IsCrepantBirationalMap.symm {σ : FunctionFieldEquiv sX sX'}
    (h : IsCrepantBirationalMap sX sX' B B' σ) :
    IsCrepantBirationalMap sX' sX B' B
      (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra sX'; σ.symm) := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sX'
  intro v a
  have h1 := h (v.comap σ.symm.toRingEquiv.toRingHom) a
  have hv : (v.comap σ.symm.toRingEquiv.toRingHom).comap σ.toRingEquiv.toRingHom = v := by
    ext x
    change v (σ.symm (σ x)) = v x
    rw [AlgEquiv.symm_apply_apply]
  rw [hv] at h1
  exact h1.symm

end CrepantComp

/-! ### Strict transforms of strata -/

section StrictTransform

/-- A morphism from a reduced scheme whose image lies in a closed subscheme factors through it. -/
private theorem exists_comp_eq_of_range_subset {N Y Z : Scheme.{0}} [IsReduced N] (ι : Y ⟶ Z)
    [IsClosedImmersion ι] (g : N ⟶ Z) [QuasiCompact g] (h : Set.range g ⊆ Set.range ι) :
    ∃ α : N ⟶ Y, α ≫ ι = g := by
  have H : ι.ker ≤ g.ker := Stacks.Chow.ker_le_of_support_subset_range ι g.ker (by
    rw [Scheme.Hom.support_ker]
    exact closure_minimal h ι.isClosedEmbedding.isClosed_range)
  exact ⟨IsClosedImmersion.lift ι g H, IsClosedImmersion.lift_fac _ _ _⟩

/-- **The strict transform of a prime divisor.** Let `g₀ : S' ⟶ S` be a proper birational morphism
from an integral scheme to a normal locally Noetherian one, and `j : T ⟶ S` a closed immersion of
an integral scheme onto a prime divisor `P`. The strict transform `P'` of `P` carries an integral
closed subscheme `j' : T' ⟶ S'` and a proper birational morphism `g₁ : T' ⟶ T` with
`g₁ ≫ j = j' ≫ g₀`, and `g₀` is a local isomorphism at the generic point of `P'`. -/
private theorem exists_strictTransform_primeDivisor {S S' T : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] [IsIntegral S'] [IsIntegral T] (g₀ : S' ⟶ S)
    [IsProper g₀] (hg₀ : IsBirationalMorphism g₀) (j : T ⟶ S) [IsClosedImmersion j]
    (P : Mori.PrimeDivisor S) (hP : j (genericPoint T) = P.genericPoint) :
    ∃ (T' : Scheme.{0}) (_ : IsIntegral T') (j' : T' ⟶ S') (_ : IsClosedImmersion j')
      (g₁ : T' ⟶ T) (_ : IsDominant g₁) (_ : IsProper g₁) (P' : Mori.PrimeDivisor S'),
      IsBirationalMorphism g₁ ∧ g₁ ≫ j = j' ≫ g₀ ∧ j' (genericPoint T') = P'.genericPoint ∧
        g₀ P'.genericPoint = P.genericPoint ∧ IsIso (g₀.stalkMap P'.genericPoint) ∧
        Set.range j'.base = (P'.support : Set S') := by
  haveI : IsDominant g₀ := hg₀.isDominant
  have hbir := MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal g₀ hg₀
    P.coheight_genericPoint.le
  obtain ⟨P', -, hgP'⟩ := MMP.Flips.exists_inverseTransformPrimeDivisor_eq_some P hbir
  have hiso : IsIso (g₀.stalkMap P'.genericPoint) :=
    MMP.isIso_stalkMap_of_mem_biregularLocus g₀ (hgP' ▸ hbir)
  let T' := P'.idealSheaf.subscheme
  haveI : IsIntegral T' := P'.integral
  let j' : T' ⟶ S' := P'.idealSheaf.subschemeι
  have hrange' : Set.range j'.base = (P'.support : Set S') := P'.idealSheaf.range_subschemeι
  have hj'η : j' (genericPoint T') = P'.genericPoint := map_genericPoint_eq_of_range_eq hrange'
  have hrangej : Set.range j.base = (P.support : Set S) := by
    apply le_antisymm
    · rintro _ ⟨x, rfl⟩
      have hx : genericPoint T ⤳ x := (genericPoint_spec T).specializes trivial
      have := hx.map j.continuous
      rw [hP] at this
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact specializes_iff_mem_closure.mp this
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      refine closure_minimal ?_ j.isClosedEmbedding.isClosed_range
      rw [Set.singleton_subset_iff]
      exact ⟨genericPoint T, hP⟩
  have hsub : Set.range (j' ≫ g₀).base ⊆ Set.range j.base := by
    rintro _ ⟨x, rfl⟩
    rw [hrangej, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    have hx : genericPoint T' ⤳ x := (genericPoint_spec T').specializes trivial
    have h1 := (hx.map j'.continuous).map g₀.continuous
    change g₀ (j' (genericPoint T')) ⤳ g₀ (j' x) at h1
    rw [hj'η, hgP'] at h1
    exact specializes_iff_mem_closure.mp h1
  obtain ⟨g₁, hg₁⟩ := exists_comp_eq_of_range_subset j (j' ≫ g₀) hsub
  have hg₁η : g₁ (genericPoint T') = genericPoint T := by
    apply j.isClosedEmbedding.injective
    change (g₁ ≫ j) (genericPoint T') = j (genericPoint T)
    rw [hg₁, Scheme.Hom.comp_apply, hj'η, hgP', hP]
  haveI : IsDominant g₁ := ⟨by
    refine dense_iff_closure_eq.mpr (Set.eq_univ_of_univ_subset ?_)
    rw [← (genericPoint_spec T).def]
    exact closure_mono (Set.singleton_subset_iff.mpr ⟨genericPoint T', hg₁η⟩)⟩
  haveI : IsProper (g₁ ≫ j) := by rw [hg₁]; infer_instance
  haveI : IsProper g₁ := IsProper.of_comp g₁ j
  haveI : LocallyOfFiniteType g₁ := inferInstance
  have hsp : g₀ (j' (genericPoint T')) ⤳ j (genericPoint T) := by rw [hj'η, hgP', hP]
  have hsurj : Function.Surjective (functionFieldMap g₁) := by
    intro b
    have hiso' : IsIso (g₀.stalkMap (j' (genericPoint T'))) := by rw [hj'η]; exact hiso
    have hsS : IsIso (S.presheaf.stalkSpecializes hsp) := by
      rw [show S.presheaf.stalkSpecializes hsp = (S.presheaf.stalkCongr (Inseparable.of_eq
        (show g₀ (j' (genericPoint T')) = j (genericPoint T) by rw [hj'η, hgP', hP]))).inv
        from rfl]
      infer_instance
    obtain ⟨c, rfl⟩ := j'.stalkMap_surjective (genericPoint T') b
    have hθ := ConcreteCategory.bijective_of_isIso
      (S.presheaf.stalkSpecializes hsp ≫ g₀.stalkMap (j' (genericPoint T')))
    obtain ⟨a, ha⟩ := hθ.2 c
    refine ⟨(j.stalkMap (genericPoint T)).hom a, ?_⟩
    rw [← stalkMap_apply_eq_functionFieldMap_apply g₀ j j' g₁ hg₁ hsp a, ← ha]
    rfl
  have hbir₁ : IsBirationalMorphism g₁ := isBirationalMorphism_of_isBirational g₁
    (AlgebraicGeometry.isBirational_of_surjective_functionFieldMap g₁ hsurj)
  exact ⟨T', inferInstance, j', inferInstance, g₁, inferInstance, inferInstance, P', hbir₁, hg₁,
    hj'η, hgP', hiso, hrange'⟩

/-- Birational morphisms preserve the dimension of integral schemes of finite type. -/
private theorem topologicalKrullDim_eq_of_functionFieldMap_bijective {k : Type} [Field k]
    {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y] (sX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType sX] (f : Y ⟶ X) [IsDominant f] [LocallyOfFiniteType (f ≫ sX)]
    (hb : Function.Bijective (functionFieldMap f)) :
    topologicalKrullDim Y = topologicalKrullDim X := by
  rw [topologicalKrullDim_eq_toNat_trdeg sX, topologicalKrullDim_eq_toNat_trdeg (f ≫ sX),
    trdeg_functionField_eq_of_bijective sX f hb]

/-- `ρ` is obtained from `τ` by successive Poincaré residues along a chain of integral schemes
`X ← S₁ ← ⋯ ← S_l = S`, the composite being `ι : S ⟶ X`. -/
private inductive IsChainResidue {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    (sX : X ⟶ Spec (.of k)) {n m : ℕ} (τ : RationalPluriForms sX n m) :
    ∀ {S : Scheme.{0}} [IsIntegral S] (ι : S ⟶ X) (e : ℕ), RationalPluriForms (ι ≫ sX) e m → Prop
  | refl : IsChainResidue sX τ (𝟙 X) n (cast (by rw [Category.id_comp]) τ)
  | step {S T : Scheme.{0}} [IsIntegral S] [IsLocallyNoetherian S] [IsIntegral T] {ι : S ⟶ X}
      {e : ℕ} {ρ : RationalPluriForms (ι ≫ sX) (e + 1) m} (j : T ⟶ S)
      {ρ' : RationalPluriForms (j ≫ ι ≫ sX) e m} (h : IsChainResidue sX τ ι (e + 1) ρ)
      (hr : IsPoincareResidue (ι ≫ sX) j e m ρ ρ') :
      IsChainResidue sX τ (j ≫ ι) e (cast (by rw [Category.assoc]) ρ')

/-- Chain residues along equal composites agree up to `HEq`. -/
private theorem IsChainResidue.congr {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    {sX : X ⟶ Spec (.of k)} {n m : ℕ} {τ : RationalPluriForms sX n m} {S : Scheme.{0}}
    [IsIntegral S] {ι ι' : S ⟶ X} (hι : ι = ι') {e : ℕ} {ρ : RationalPluriForms (ι ≫ sX) e m}
    {ρ' : RationalPluriForms (ι' ≫ sX) e m} (hρ : HEq ρ ρ') (h : IsChainResidue sX τ ι e ρ) :
    IsChainResidue sX τ ι' e ρ' := by
  subst hι
  obtain rfl := eq_of_heq hρ
  exact h

/-- Chain residues are compatible with an equality of structure morphisms. -/
private theorem IsChainResidue.cast_structure {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    {s s' : X ⟶ Spec (.of k)} (hs : s = s') {n m : ℕ} {τ : RationalPluriForms s n m}
    {S : Scheme.{0}} [IsIntegral S] {ι : S ⟶ X} {e : ℕ} {ρ : RationalPluriForms (ι ≫ s) e m}
    (h : IsChainResidue s τ ι e ρ) (h₁ : RationalPluriForms s n m = RationalPluriForms s' n m)
    (h₂ : RationalPluriForms (ι ≫ s) e m = RationalPluriForms (ι ≫ s') e m) :
    IsChainResidue s' (cast h₁ τ) ι e (cast h₂ ρ) := by
  subst hs
  exact h

/-- **Pull-back of a transported form to a common model.** If `p : W ⟶ X`, `q : W ⟶ Y` are
dominant with `q^* ∘ φ = p^*` on function fields, then `q^*(φ^* τ) = p^* τ`. -/
private theorem pullback_pluriformPullback_eq {k : Type} [Field k] [CharZero k]
    {X Y W : Scheme.{0}} [IsIntegral X] [IsIntegral Y] [IsIntegral W] {sX : X ⟶ Spec (.of k)}
    {sY : Y ⟶ Spec (.of k)} [LocallyOfFiniteType sX] [LocallyOfFiniteType sY] (p : W ⟶ X)
    (q : W ⟶ Y) [IsDominant p] [IsDominant q] [LocallyOfFiniteType (q ≫ sY)]
    (hpq : p ≫ sX = q ≫ sY) {d : ℕ} (hX : topologicalKrullDim X = d)
    (hY : topologicalKrullDim Y = d) (hW : topologicalKrullDim W = d)
    (φ : FunctionFieldHom sY sX) (hφ : ∀ a, functionFieldMap q (φ a) = functionFieldMap p a)
    {m : ℤ} (τ : RationalPluriForms sX d m) :
    pullbackRationalPluriForms sY q (pluriformPullback sY sX φ d m τ) =
      cast (by rw [hpq]) (pullbackRationalPluriForms sX p τ) := by
  obtain ⟨ψq, hψq, hψqp⟩ := exists_functionFieldHom_pluriformPullback sY q
  have key : ∀ (s : W ⟶ Spec (.of k)) (hs : p ≫ sX = s), ∃ ψ : FunctionFieldHom s sX,
      (∀ a, ψ a = functionFieldMap p a) ∧
        pluriformPullback s sX ψ d m τ = cast (by rw [hs]) (pullbackRationalPluriForms sX p τ) := by
    rintro s rfl
    obtain ⟨ψ, hψ, hψp⟩ := exists_functionFieldHom_pluriformPullback sX p
    exact ⟨ψ, hψ, hψp d m τ⟩
  obtain ⟨ψp, hψp, hψpp⟩ := key (q ≫ sY) hpq
  rw [← hψqp d m, pluriformPullback_comp hW hY hX m ψq φ τ]
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (q ≫ sY)
  have : ψq.comp φ = ψp := by
    ext a
    rw [AlgHom.comp_apply, hψq, hφ, hψp]
  rw [this, hψpp]

end StrictTransform

