    conv_lhs => rw [e1, ← stalkMap_apply_eq_functionFieldMap_apply qW ιZ νN πN hπN hp]
    have e2 : (X.presheaf.stalkSpecializes hp).hom ((X.presheaf.stalkSpecializes h1).hom r) =
