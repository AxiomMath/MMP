      WithZero.exp_le_exp]
    omega
  -- the `ē`-adic place is a log canonical place along which `δ` has order `-m`
  obtain ⟨c, hc⟩ := hfK
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero] at hc
    exact hf0 hc.symm
  obtain ⟨D₀, hD₀p, hD₀x, hD₀disc, hD₀ord⟩ :=
    CrepantModelAux.exists_divisorOver_isDiscrepancy_neg_one_of_transcendental hT hdT hdltT hKT
      hm hmKT FZ.isNormalVariety hdimZ lam hlamk ν₀ hν₀k eb hν₀e hν₀res hSν y₀ hy₀le hy₀lt
      (resZ v) hwZ' c δ hδ (by rw [hf, ← hc]; rfl) hc0
  have hcen : 1 ≤ Order.coheight (D₀.f D₀.E.genericPoint) := by rw [hD₀x]; exact hcoh1
  have hlb := one_sub_le_ordPullback_of_isPoincareResidue_zero hT hdT hdltT hKT hm hmKT D₀ hD₀p
    hD₀disc hcen hδ hδ0 hres
  rw [hD₀ord] at hlb
  omega

/-- **Point residues of a rational log generator on a curve.** Let `(C, B_C)` be a curve whose
function field is generated by `w`, with `div(dlog w) + B_C = 0`. In even degree `m` the residue
of `(dlog w)^{⊗m}` at every adjunction point `q` of `C` is `1`: `w` or `w⁻¹` is a uniformizer at
`q`. -/
private theorem isPoincareResidue_formPow_dlog_of_isAdjunctionStep {C : Scheme.{0}}
    {sC : C ⟶ Spec (.of ℂ)} [IsIntegral C] [IsLocallyNoetherian C] [IsNormal C]
    [LocallyOfFiniteType sC] (hd : topologicalKrullDim C = (1 : ℕ)) {BC : QDivisor C}
    (w : C.functionField) (hw : w ≠ 0)
    (hgen : letI := functionFieldAlgebra sC
      IntermediateField.adjoin ℂ ({w} : Set C.functionField) = ⊤)
    (hψ : letI := functionFieldAlgebra sC
      ∀ Γ : Mori.PrimeDivisor C, (Γ.ordForm (show RationalPluriForms sC 1 ((1 : ℕ) : ℤ) from
        formPow (exteriorPower.ιMulti C.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ)
        + BC.coeff Γ = 0)
    {Tq : Scheme.{0}} [IsIntegral Tq] {ιq : Tq ⟶ C} {Bq : QDivisor Tq}
    (hιq : IsAdjunctionStep sC BC ιq Bq) {m : ℕ} (hm : Even m) :
    letI := functionFieldAlgebra sC
    letI := functionFieldAlgebra (ιq ≫ sC)
    IsPoincareResidue sC ιq 0 m
      (formPow (exteriorPower.ιMulti C.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) m)
      (formPow (exteriorPower.ιMulti Tq.functionField 0 ![]) m) := by
  letI := functionFieldAlgebra sC
  letI := functionFieldAlgebra (ιq ≫ sC)
  obtain ⟨-, q, hq1, hrq, hciq, -⟩ := id hιq
  haveI := hciq
  have hP := CrepantModelAux.map_genericPoint_eq_of_range_eq ιq q hrq
  -- the residue of `(dlog u)^{⊗m}` for a uniformizer `u` at `q`
  have key : ∀ u : C.functionField, C.ord u q.genericPoint = 1 →
      IsPoincareResidue sC ιq 0 m
        (formPow (exteriorPower.ιMulti C.functionField 1 ![u⁻¹ • KaehlerDifferential.D ℂ _ u]) m)
        (formPow (exteriorPower.ιMulti Tq.functionField 0 ![]) m) := by
    intro u hu
    have hu0 : u ≠ 0 := fun h0 => by rw [h0] at hu; simp [Scheme.ord_zero] at hu
    obtain ⟨t, ht⟩ := CrepantModelAux.exists_algebraMap_eq_of_zero_le_ord q hP hu0
      (by rw [hP]; exact hu.symm ▸ zero_le_one)
    set f0 : Fin 0 → C.presheaf.stalk (ιq (genericPoint Tq)) := Fin.elim0 with hf0
    have hres := CrepantModelAux.isPoincareResidue_formPow_dlog sC ιq m t (n := 0) f0
      (fun i => i.elim0) (by rw [ht, hP]; exact hu)
    have e1 : (formPow (exteriorPower.ιMulti C.functionField 1
        ![u⁻¹ • KaehlerDifferential.D ℂ _ u]) m : RationalPluriForms sC (0 + 1) m) =
        formPow (exteriorPower.ιMulti C.functionField (0 + 1)
          (Fin.cons ((algebraMap _ C.functionField t)⁻¹ •
              KaehlerDifferential.D ℂ C.functionField (algebraMap _ _ t))
            fun i => (algebraMap _ C.functionField (f0 i))⁻¹ •
              KaehlerDifferential.D ℂ C.functionField (algebraMap _ C.functionField (f0 i)))) m := by
      congr 2
      funext a; fin_cases a; simp [ht]
    have e2 : (formPow (exteriorPower.ιMulti Tq.functionField 0 ![]) m :
        RationalPluriForms (ιq ≫ sC) 0 m) = formPow (exteriorPower.ιMulti Tq.functionField 0
          fun i => ((ιq.stalkMap (genericPoint Tq)).hom (f0 i))⁻¹ •
            KaehlerDifferential.D ℂ Tq.functionField ((ιq.stalkMap (genericPoint Tq)).hom
              (f0 i))) m := by
      congr 2
      funext a; exact a.elim0
    rw [e1, e2]
    exact hres
  -- the order of `w` at `q` is `±1`
  have hord : (q.ordForm (show RationalPluriForms sC 1 ((1 : ℕ) : ℤ) from formPow
      (exteriorPower.ιMulti C.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) ≤ -1 := by
    have := hψ q
    linarith
  rcases lt_trichotomy (C.ord w q.genericPoint) 0 with hneg | hzero | hpos
  · -- `w⁻¹` is a uniformizer
    have hgen' : IntermediateField.adjoin ℂ ({w⁻¹} : Set C.functionField) = ⊤ := by
      rw [eq_top_iff, ← hgen, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      have hmem : w⁻¹⁻¹ ∈ IntermediateField.adjoin ℂ ({w⁻¹} : Set C.functionField) :=
        inv_mem (IntermediateField.subset_adjoin _ _ (Set.mem_singleton _))
      rwa [inv_inv] at hmem
    have hpos' : 0 < C.ord w⁻¹ q.genericPoint := by
      rw [← zpow_neg_one, ord_zpow _ hw]; omega
    have h1 := CrepantModelAux.ord_eq_one_of_adjoin_simple_eq_top sC q (inv_ne_zero hw) hgen' hpos'
    have h2 := key w⁻¹ h1
    have e : (exteriorPower.ιMulti C.functionField 1 ![(w⁻¹)⁻¹ • KaehlerDifferential.D ℂ _ w⁻¹]) =
        (-1 : C.functionField) • exteriorPower.ιMulti C.functionField 1
          ![w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
      have hD : (w⁻¹)⁻¹ • KaehlerDifferential.D ℂ C.functionField w⁻¹ =
          (-1 : C.functionField) • (w⁻¹ • KaehlerDifferential.D ℂ _ w) := by
        rw [inv_inv, (KaehlerDifferential.D ℂ C.functionField).leibniz_inv, smul_smul, smul_smul]
        congr 1
        field_simp
      have hv : (![(w⁻¹)⁻¹ • KaehlerDifferential.D ℂ C.functionField w⁻¹] :
          Fin 1 → Ω[C.functionField⁄ℂ]) = Function.update
            ![w⁻¹ • KaehlerDifferential.D ℂ C.functionField w] 0
            ((-1 : C.functionField) • (![w⁻¹ • KaehlerDifferential.D ℂ C.functionField w] 0)) := by
        funext i; fin_cases i
        simp only [Fin.zero_eta, Matrix.cons_val_zero, Function.update_self]
        exact hD
      rw [hv, AlternatingMap.map_update_smul, Function.update_eq_self]
    rw [e, CrepantModelAux.formPow_smul', hm.neg_one_pow, one_smul] at h2
    exact h2
  · exfalso
    obtain ⟨u, hu⟩ := CrepantModelAux.exists_algebraMap_eq_of_zero_le_ord q rfl hw hzero.ge
    have hd' := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sC) hd
    have h1 := CrepantModelAux.formPow_ιMulti_dlog_eq_smul (k := ℂ) (K := C.functionField)
      (d := 1) ![w] 1
    have e1 : (fun i : Fin 1 => ((![w] : Fin 1 → C.functionField) i)⁻¹ •
        KaehlerDifferential.D ℂ C.functionField ((![w] : Fin 1 → C.functionField) i)) =
        ![w⁻¹ • KaehlerDifferential.D ℂ _ w] := by
      funext i; fin_cases i; rfl
    rw [e1] at h1
    set ωD : RationalPluriForms sC 1 ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
      C.functionField 1 fun i => KaehlerDifferential.D ℂ C.functionField
        ((![w] : Fin 1 → C.functionField) i)) 1 with hωD
    have hprod : (∏ i, (![w] : Fin 1 → C.functionField) i)⁻¹ ^ 1 = w⁻¹ := by simp
    rw [hprod] at h1
    have hge : 0 ≤ q.ordForm ωD := by
      have h2 := CrepantModelAux.zero_le_ordForm_formPow_ιMulti_D (sX := sC) q hd 1 ![u]
      have e2 : (fun i : Fin 1 => KaehlerDifferential.D ℂ C.functionField
          ((![w] : Fin 1 → C.functionField) i)) = fun i => KaehlerDifferential.D ℂ
            C.functionField (algebraMap q.localRing C.functionField ((![u] : Fin 1 → _) i)) := by
        funext i; fin_cases i; simp [hu]
      rw [hωD, e2]
      exact h2
    by_cases hω0 : ωD = 0
    · have h3 : (formPow (exteriorPower.ιMulti C.functionField 1
          ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1 : RationalPluriForms sC 1 ((1 : ℕ) : ℤ)) = 0 := by
        rw [h1]; change w⁻¹ • ωD = 0; rw [hω0, smul_zero]
      rw [h3] at hord
      change ((q.ordForm (0 : RationalPluriForms sC 1 ((1 : ℕ) : ℤ)) : ℤ) : ℚ) ≤ -1 at hord
      rw [Mori.PrimeDivisor.ordForm_zero] at hord
      norm_num at hord
    have h4 : q.ordForm (show RationalPluriForms sC 1 ((1 : ℕ) : ℤ) from formPow
        (exteriorPower.ιMulti C.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) =
        C.ord w⁻¹ q.genericPoint + q.ordForm ωD := by
      rw [show (show RationalPluriForms sC 1 ((1 : ℕ) : ℤ) from formPow
        (exteriorPower.ιMulti C.functionField 1 ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) =
        w⁻¹ • ωD from h1]
      exact q.ordForm_smul hd' (inv_ne_zero hw) hω0
    have h5 : C.ord w⁻¹ q.genericPoint = 0 := by
      rw [← zpow_neg_one, ord_zpow _ hw, hzero, mul_zero]
    rw [h4, h5, zero_add] at hord
    have : (0 : ℚ) ≤ q.ordForm ωD := by exact_mod_cast hge
    linarith
  · have h1 := CrepantModelAux.ord_eq_one_of_adjoin_simple_eq_top sC q hw hgen hpos
    exact key w h1

/-- **Floor components of `Y` exceptional over `X`.** If no prime divisor of `W` is the strict
transform both of the floor component `Q` of `Y` and of a floor component of `X`, then, for the
crepant map `σ : (Y, C) ⇢ (X, B)` of the common model, the valuation of `Q` is that of an
exceptional divisor `D` over `X` of discrepancy `-1`. -/
private theorem exists_isDiscrepancy_neg_one_of_not_exists
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    (hne : ¬ ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint)) :
    ∃ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
      (_ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a) (D : DivisorOver ℂ sX),
      (∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g)) ∧ D.IsExceptional ∧
        IsProper D.f ∧ MMP.Mori.IsDiscrepancy sX (n + 1) KX B D (-1) ∧ C.coeff Q.1 = 1 := by
  obtain ⟨E, hqE, hqiso, hE1, hC1⟩ := exists_strictTransform_floor S Q
  haveI := hqiso
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hXp.toIsVariety
  haveI := S.hYp.toIsVariety
  have hXn : IsNormalVariety ℂ sX := S.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := S.hCp.isPair.1
  obtain ⟨σ, hσc, hσ⟩ := S.exists_isCrepantBirationalMap
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  set DΓ := DivisorOver.ofPrimeDivisor ℂ hYn Q.1
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy S.hCp.isPair S.hKY DΓ
  have hc' : c = -C.coeff Q.1 := hc.eq_neg_coeff_of_ofPrimeDivisor hYn
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 Y) by infer_instance)
  obtain ⟨n', D, hDv, hDlog⟩ := (hσc DΓ.valuation (1 + c)).mp ⟨n + 1, DΓ, rfl, hlog⟩
  have hv : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g) := by
    intro g
    rw [hDv]
    change Q.1.divisorialValuation (functionFieldMap (𝟙 Y) _) = _
    rw [functionFieldMap_id_apply]
    rfl
  have hD : D.IsExceptional := by
    by_contra hD
    obtain ⟨P', hP'⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hXn D hD
    have hvE : ∀ g, E.divisorialValuation (functionFieldMap p g) = P'.divisorialValuation g := by
      intro g
      have h2 : P'.divisorialValuation g = D.valuation g := by
        rw [hP']
        change _ = P'.divisorialValuation (functionFieldMap (𝟙 X) g)
        rw [functionFieldMap_id_apply]
      rw [h2, hv, ← hσ]
      change E.divisorialValuation (functionFieldMap q ((σ.toHom) g)) = _
      by_cases hg : (σ.toHom) g = 0
      · rw [hg, map_zero, map_zero, map_zero]
      have hg' : functionFieldMap q ((σ.toHom) g) ≠ 0 := (map_ne_zero _).mpr hg
      rw [E.divisorialValuation_eq_exp_neg_ord hg', Q.1.divisorialValuation_eq_exp_neg_ord hg,
        ord_functionFieldMap_of_isIso' q E Q.1 hqE]
    have hpE : p E.genericPoint = P'.genericPoint := by
      let D1 : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, E⟩
      have hv1 : D1.valuation = (DivisorOver.ofPrimeDivisor ℂ hXn P').valuation := by
        ext g
        change E.divisorialValuation (functionFieldMap p g) =
          P'.divisorialValuation (functionFieldMap (𝟙 X) g)
        rw [functionFieldMap_id_apply, hvE]
      exact MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hXn.1 hv1
    have hbir : P'.genericPoint ∈ Mori.biregularLocus p :=
      MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal p S.hpb
        P'.coheight_genericPoint.le
    haveI hpiso : IsIso (p.stalkMap E.genericPoint) :=
      MMP.isIso_stalkMap_of_mem_biregularLocus p (hpE ▸ hbir)
    have hcoeff := coeff_eq_of_isIso_stalkMap S.swap P' E hpE
    rw [hE1] at hcoeff
    exact hne ⟨⟨P', by rw [← hcoeff]; norm_num⟩, E, hpE, hqE, hpiso, hqiso⟩
  have hnn : n' = n + 1 := by
    have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDlog).symm.trans
      S.hdimX
    exact_mod_cast this
  subst hnn
  obtain ⟨a, ha⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy S.hBp.isPair S.hKX D
  have h1 := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy ha hDlog
  have hac : a = -1 := by
    have : a = c := by exact_mod_cast (by linarith : (a : ℝ) = c)
    rw [this, hc', hC1]
  rw [hac] at ha
  exact ⟨σ, hσc, hσ, D, hv, hD, hDlog.2.1, ha, hC1⟩

/-- **Pinned residues of transported presentations.** Let `σ : (Y, C) ⇢ (X, B)` be the crepant
map of the common model, `Q` a floor component of `Y` and `D` the divisor over `X` with the
valuation of `Q`. There is a presentation `τ` of `t` on a neighbourhood of the centre of `D` such
that every residue of `σ^*τ` along `Q` is `t'_Q`: on the strict transform of `Q` on `W`, the
residue of `q^*σ^*τ = p^*τ` is pinned to that of a presentation of `t'`. -/
private theorem exists_presentation_isPoincareResidue_pluriformPullback_eq
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t') {σ : FunctionFieldEquiv sY sX}
    (hσ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (D : DivisorOver ℂ sX)
    (hv : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g)) :
    ∃ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m), D.f D.E.genericPoint ∈ U ∧
      τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
      (∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
        IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)) ∧
      ∀ ρ : RationalPluriForms (jY Q ≫ sY) n m,
        IsPoincareResidue sY (jY Q) n m (pluriformPullback sY sX σ.toHom (n + 1) m τ) ρ →
        ρ = (t' Q : RationalPluriForms (jY Q ≫ sY) n m) := by
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hWX.1.toLocallyOfFiniteType
  haveI := S.hWY.1.toLocallyOfFiniteType
  have hXn : IsNormalVariety ℂ sX := S.hBp.isPair.1
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  have hdW : topologicalKrullDim W = (n + 1 : ℕ) := by
    haveI := S.hXp.toIsVariety
    haveI := S.hWX.1
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) S.hpb]
    exact S.hdimX
  obtain ⟨Q', hQ', hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  have hQQ' : Q' = Q.1 := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (hQ'.symm.trans (map_genericPoint_eq_of_range_eq (P := Q.1) (S.hjY Q).2))
  subst hQQ'
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := (S.hjY Q).1.1.1.toLocallyOfFiniteType
  have hdC : topologicalKrullDim (CY Q) = n :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (S.hjY Q).2
      S.hdimY
  -- the strict transform of `Q` on `W`
  obtain ⟨T', _, j', _, g₁, _, _, E', hg₁, hcomm, hj'η, hgE', hiso, hrange'⟩ :=
    exists_strictTransform_primeDivisor q S.hqb (jY Q) Q.1 hQ'
  haveI := hiso
  obtain ⟨hE'1, -⟩ := coeff_eq_one_of_isIso_stalkMap S Q E' hgE'
  haveI : LocallyOfFiniteType (g₁ ≫ jY Q ≫ sY) := by
    rw [← Category.assoc, hcomm, Category.assoc]; infer_instance
  have hdT' : topologicalKrullDim T' = n := by
    rw [topologicalKrullDim_eq_of_functionFieldMap_bijective (jY Q ≫ sY) g₁
      hg₁.functionFieldMap_bijective, hdC]
  -- `E'` lies over the centre of `D`
  have hpE : p E'.genericPoint = D.f D.E.genericPoint := by
    let D1 : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, E'⟩
    have hv1 : D1.valuation = D.valuation := by
      ext g
      change E'.divisorialValuation (functionFieldMap p g) = _
      rw [hv, ← hσ]
      change E'.divisorialValuation (functionFieldMap q ((σ.toHom) g)) = _
      by_cases hg : (σ.toHom) g = 0
      · rw [hg, map_zero, map_zero, map_zero]
      have hg' : functionFieldMap q ((σ.toHom) g) ≠ 0 := (map_ne_zero _).mpr hg
      rw [E'.divisorialValuation_eq_exp_neg_ord hg', Q.1.divisorialValuation_eq_exp_neg_ord hg,
        ord_functionFieldMap_of_isIso' q E' Q.1 hgE']
    exact MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hXn.1 hv1
  -- presentations
  obtain ⟨U', hyU', τ', hτ'⟩ := ht' (q.base (j'.base (genericPoint T')))
  obtain ⟨U, hxU, τ, hτ⟩ := ht (p.base (j'.base (genericPoint T')))
  have hxU' : D.f D.E.genericPoint ∈ U := by
    rw [← hpE, ← hj'η]; exact hxU
  refine ⟨U, τ, hxU', hτ.1, hτ.2, fun ρ h1 => ?_⟩
  obtain ⟨ρE, h₁, h₂⟩ := h U τ hτ U' τ' hτ' E' hE'1 j' inferInstance hrange' hxU hyU'
  have hQU' : (jY Q).base (genericPoint (CY Q)) ∈ U' := by
    change jY Q (genericPoint (CY Q)) ∈ U'
    rw [hQ', ← hgE', ← hj'η]
    exact hyU'
  have hresQ := hτ'.2 Q hQU'
  -- both residues transported to `E'`
  have hA := IsPoincareResidue.pullback_of_isIso_stalkMap q g₁ hcomm S.hdimY hdW hdC hdT' Q.1 E'
    hQ' hj'η hgE' h1
  have hB := IsPoincareResidue.pullback_of_isIso_stalkMap q g₁ hcomm S.hdimY hdW hdC hdT' Q.1 E'
    hQ' hj'η hgE' hresQ
  have hid := pullback_pluriformPullback_eq p q S.hpq S.hdimX S.hdimY hdW σ.toHom hσ τ
  rw [hid] at hA
  have hc := IsPoincareResidue.cast_structure S.hpq h₁ (by rw [S.hpq]) (by rw [S.hpq])
  have u1 := IsPoincareResidue.unique_of_isClosedImmersion E' hj'η hA hc
  have u2 := IsPoincareResidue.unique_of_isClosedImmersion E' hj'η hB h₂
  have u3 : pullbackRationalPluriForms (jY Q ≫ sY) g₁ ρ =
      pullbackRationalPluriForms (jY Q ≫ sY) g₁ (t' Q : RationalPluriForms _ n m) := by
    have := u1.trans u2.symm
    exact eq_of_heq ((cast_heq _ _).symm.trans ((heq_of_eq this).trans (cast_heq _ _)))
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := jY Q ≫ sY)
    (show topologicalKrullDim (CY Q) = ((n : ℕ) : WithBot ℕ∞) from hdC)
  by_contra hne
  have hne' := sub_ne_zero.mpr hne
  apply pullbackRationalPluriForms_ne_zero g₁ hg₁.functionFieldMap_bijective hd hne'
  rw [pullbackRationalPluriForms_sub, u3, sub_self]

/-- The residue restriction of `t'_Q` along a flag `F` of `(C_Q, B_Q)` ending at `V` is, in degree
`e = dim V`, the crepant transport of the residue restriction of `t_P` along a flag of a floor
component `(C_P, B_P)` of `X`. -/
private abbrev IsCopyAlong
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P))
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q))
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) (e : ℕ) : Prop :=
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (U : Scheme.{0}) (ιU : U ⟶ CX P)
      (BU : QDivisor U) (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU),
      topologicalKrullDim U = e ∧
      haveI := G.isIntegral_stratum
      haveI := G.isNormal_stratum
      haveI := G.isLocallyNoetherian_stratum
      ∃ ψ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX),
        IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) BV BU ψ ∧
        R'.toFun Q F e (t' Q) =
          pluriformPullback (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) ψ.toHom e m (R.toFun P G e (t P))

/-- The final pair `(V, B_V)` of a flag `F` of `(C_Q, B_Q)` has positive dimension `e = d + 1`,
and every section of `m(K_V + B_V)` with zero residue along every adjunction step of `V` is
zero. -/
private abbrev IsDetecting (m : ℕ) (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}}
    {ιV : V ⟶ CY Q} {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (e : ℕ) : Prop :=
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  ∃ d : ℕ, e = d + 1 ∧
    ∀ δ : RationalPluriForms (ιV ≫ jY Q ≫ sY) (d + 1) m,
      δ ∈ logPluricanonicalSections (ιV ≫ jY Q ≫ sY) (d + 1) m BV →
      (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ V} {BG : QDivisor G},
        IsAdjunctionStep (ιV ≫ jY Q ≫ sY) BV j BG →
        IsPoincareResidue (ιV ≫ jY Q ≫ sY) j d m δ 0) → δ = 0

/-- Strata of the floor components of `Y` are proper over `ℂ`. -/
private theorem isProper_stratum_Y
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) :
    IsProper (ιV ≫ jY Q ≫ sY) := by
  haveI := F.isClosedImmersion
  haveI := (S.hjY Q).1.exists_primeDivisor.choose_spec.2
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  infer_instance

/-- Strata of the floor components of `X` are proper over `ℂ`. -/
private theorem isProper_stratum_X
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) {U : Scheme.{0}} {ιU : U ⟶ CX P}
    {BU : QDivisor U} (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU) :
    IsProper (ιU ≫ jX P ≫ sX) := by
  haveI := G.isClosedImmersion
  haveI := (S.hjX P).1.exists_primeDivisor.choose_spec.2
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
  infer_instance

/-- The constant `m`-canonical forms of degree zero on a point. -/
private noncomputable abbrev constPointForm {Z : Scheme.{0}} [IsIntegral Z]
    (s : Z ⟶ Spec (.of ℂ)) (m : ℕ)
    (c : ℂ) : RationalPluriForms s 0 m :=
  letI := functionFieldAlgebra s
  c • (show RationalPluriForms s 0 m from formPow (exteriorPower.ιMulti Z.functionField 0 ![]) m)

/-- The `m`-th power of `c · dlog w` on a curve. -/
private noncomputable abbrev dlogCurveForm {Z : Scheme.{0}} [IsIntegral Z]
    (s : Z ⟶ Spec (.of ℂ)) (m : ℕ)
    (c : ℂ) (w : Z.functionField) : RationalPluriForms s 1 m :=
  letI := functionFieldAlgebra s
  c • (show RationalPluriForms s 1 m from formPow (exteriorPower.ιMulti Z.functionField 1
    ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) m)

/-- The `m`-th power of `c · dlog u ∧ dlog w` on a surface. -/
private noncomputable abbrev dlogSurfaceForm {Z : Scheme.{0}} [IsIntegral Z]
    (s : Z ⟶ Spec (.of ℂ)) (m : ℕ)
    (c : ℂ) (u w : Z.functionField) : RationalPluriForms s 2 m :=
  letI := functionFieldAlgebra s
  c • (show RationalPluriForms s 2 m from formPow (exteriorPower.ιMulti Z.functionField 2
    ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) m)

private theorem heq_constPointForm {Z : Scheme.{0}} [IsIntegral Z] {s s' : Z ⟶ Spec (.of ℂ)}
    (hs : s = s') (m : ℕ) (c : ℂ) : HEq (constPointForm s m c) (constPointForm s' m c) := by
  subst hs; rfl

private theorem heq_dlogCurveForm {Z : Scheme.{0}} [IsIntegral Z] {s s' : Z ⟶ Spec (.of ℂ)}
    (hs : s = s') (m : ℕ) (c : ℂ) (w : Z.functionField) :
    HEq (dlogCurveForm s m c w) (dlogCurveForm s' m c w) := by
  subst hs; rfl

/-- The residue restriction of `t` takes the value `c` at a point stratum of a floor component of
`X`. -/
private abbrev IsPointValue (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P))
    (c : ℂ) : Prop :=
  ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (U : Scheme.{0}) (ιU : U ⟶ CX P)
      (BU : QDivisor U) (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU),
      topologicalKrullDim U = (0 : ℕ) ∧
      haveI := G.isIntegral_stratum
      IsIteratedResidueRec (t P : RationalPluriForms (jX P ≫ sX) n m) G 0
        (constPointForm (ιU ≫ jX P ≫ sX) m c)

/-- A curve stratum of a floor component of `Y` reached by `F` is a rational log curve
`(V, B_V)`, `k(V) = ℂ(w)` with `div(dlog w) + B_V = 0`, on which the residue restriction of `t'`
is `c (dlog w)^{⊗m}` for a value `c` of `t` at a point stratum of `X`. -/
private abbrev IsDlogCurve (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P))
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q))
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) : Prop :=
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  letI := functionFieldAlgebra (ιV ≫ jY Q ≫ sY)
  ∃ (c : ℂ) (w : V.functionField), w ≠ 0 ∧
    IntermediateField.adjoin ℂ ({w} : Set V.functionField) = ⊤ ∧
    (∀ Γ : Mori.PrimeDivisor V, (Γ.ordForm (show RationalPluriForms (ιV ≫ jY Q ≫ sY) 1
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti V.functionField 1
        ![w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) + BV.coeff Γ = 0) ∧
    IsIteratedResidueRec (t' Q : RationalPluriForms (jY Q ≫ sY) n m) F 1
      (dlogCurveForm (ιV ≫ jY Q ≫ sY) m c w) ∧
    IsPointValue t c

/-- A surface stratum of a floor component of `Y` reached by `F` is a rational log surface
`(V, B_V)`, `k(V) = ℂ(u, w)` with `div(dlog u ∧ dlog w) + B_V = 0`, on which the residue
restriction of `t'` is `c (dlog u ∧ dlog w)^{⊗m}` for a value `c` of `t` at a point stratum of
`X`. -/
private abbrev IsDlogSurface (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P))
    (t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q))
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) : Prop :=
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  letI := functionFieldAlgebra (ιV ≫ jY Q ≫ sY)
  ∃ (c : ℂ) (u w : V.functionField), u ≠ 0 ∧ w ≠ 0 ∧
    IntermediateField.adjoin ℂ ({u, w} : Set V.functionField) = ⊤ ∧
    (∀ Γ : Mori.PrimeDivisor V, (Γ.ordForm (show RationalPluriForms (ιV ≫ jY Q ≫ sY) 2
      ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti V.functionField 2
        ![u⁻¹ • KaehlerDifferential.D ℂ _ u, w⁻¹ • KaehlerDifferential.D ℂ _ w]) 1) : ℚ) +
          BV.coeff Γ = 0) ∧
    IsIteratedResidueRec (t' Q : RationalPluriForms (jY Q ≫ sY) n m) F 2
      (dlogSurfaceForm (ιV ≫ jY Q ≫ sY) m c u w) ∧
    IsPointValue t c

/-- **Point strata with a value of `t` are crepant copies.** A point stratum `V` of a floor
component of `Y` at which `t'` has the residue `c`, a value of `t` at a point stratum `U` of `X`,
is a crepant copy of `U`: points are crepant birational to each other, and the constant `c`
pulls back to itself. -/
private theorem isCopyAlong_of_isPointValue
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (hV : topologicalKrullDim V = (0 : ℕ)) {c : ℂ}
    (hrec : haveI := F.isIntegral_stratum
      IsIteratedResidueRec (t' Q : RationalPluriForms (jY Q ≫ sY) n m) F 0
        (constPointForm (ιV ≫ jY Q ≫ sY) m c))
    (hc : IsPointValue t c) : IsCopyAlong R R' t t' Q F 0 := by
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  obtain ⟨P, U, ιU, BU, G, hU, hrecU⟩ := hc
  haveI := G.isIntegral_stratum
  haveI := G.isNormal_stratum
  haveI := G.isLocallyNoetherian_stratum
  haveI : LocallyOfFiniteType (ιV ≫ jY Q ≫ sY) := F.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ιU ≫ jX P ≫ sX) := G.isNormalVariety.1.toLocallyOfFiniteType
  haveI := isProper_stratum_Y S Q F
  haveI := isProper_stratum_X S P G
  haveI : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace (ιV ≫ jY Q ≫ sY)
  haveI : CompactSpace U := QuasiCompact.compactSpace_of_compactSpace (ιU ≫ jX P ≫ sX)
  obtain ⟨ψ⟩ := CrepantModelAux.nonempty_functionFieldEquiv_of_topologicalKrullDim_eq_zero
    (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) hV hU
  have hψ := CrepantModelAux.isCrepantBirationalMap_of_topologicalKrullDim_eq_zero (k := ℂ)
    (by exact_mod_cast hV) (by exact_mod_cast hU) BV BU ψ
  refine ⟨P, U, ιU, BU, G, by exact_mod_cast hU, ψ, hψ, ?_⟩
  rw [IsIteratedResidueRec.unique F (R'.isIteratedResidue Q F 0 (t' Q) (by exact_mod_cast hV)).rec'
    hrec, IsIteratedResidueRec.unique G (R.isIteratedResidue P G 0 (t P)
      (by exact_mod_cast hU)).rec' hrecU]
  exact (CrepantModelAux.pluriformPullback_smul_formPow_ιMulti_zero hV hU ψ.toHom c m).symm

/-- **Point strata of rational log curves.** If `t'` restricts to `c (dlog w)^{⊗m}` on a rational
log curve `V`, with `c` a value of `t` at a point stratum of `X`, then every adjunction point of
`V` is a crepant copy of that point stratum: the residue of `(dlog w)^{⊗m}` there is `1`. -/
private theorem isCopyAlong_step_of_isDlogCurve
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {S₀ G : Scheme.{0}} {ι₀ : S₀ ⟶ CY Q}
    {BS₀ : QDivisor S₀} (F₀ : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ι₀ BS₀) {j : G ⟶ S₀}
    {BG : QDivisor G}
    (hj : haveI := F₀.isIntegral_stratum; haveI := F₀.isNormal_stratum;
      haveI := F₀.isLocallyNoetherian_stratum; IsAdjunctionStep (ι₀ ≫ jY Q ≫ sY) BS₀ j BG)
    (hS₀ : topologicalKrullDim S₀ = (1 : ℕ)) (hV : topologicalKrullDim G = (0 : ℕ))
    (h : IsDlogCurve t t' Q F₀) : IsCopyAlong R R' t t' Q (F₀.step j BG hj) 0 := by
  haveI := F₀.isIntegral_stratum
  haveI := F₀.isNormal_stratum
  haveI := F₀.isLocallyNoetherian_stratum
  haveI : IsIntegral G := hj.1.1.toIsIntegral
  haveI : LocallyOfFiniteType (ι₀ ≫ jY Q ≫ sY) := F₀.isNormalVariety.1.toLocallyOfFiniteType
  obtain ⟨c, w, hw0, hgen, hψ, hrec, hc⟩ := h
  letI := functionFieldAlgebra (ι₀ ≫ jY Q ≫ sY)
  have hr := isPoincareResidue_formPow_dlog_of_isAdjunctionStep hS₀ w hw0 hgen hψ hj S.hm
  have hr' := CrepantModelAux.IsPoincareResidue.smul_const hr c
  refine isCopyAlong_of_isPointValue S R R' Q (F₀.step j BG hj) hV ?_ hc
  exact ⟨_, hrec, _, hr', heq_constPointForm (Category.assoc _ _ _) m c⟩

/-- Rational log curves detect their sections by residues. -/
private theorem isDetecting_of_isDlogCurve
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
    (hV : topologicalKrullDim V = (1 : ℕ)) (h : IsDlogCurve t t' Q F) :
    IsDetecting m Q F 1 := by
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  haveI := isProper_stratum_Y S Q F
  obtain ⟨c, w, hw0, hgen, hψ, -, -⟩ := h
  exact ⟨0, rfl, fun δ hδ hres => eq_zero_of_isPoincareResidue_zero_of_dlog_curve
    F.isNormalVariety hV (isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q) F) w hw0
    hgen hψ hδ hres⟩

/-- **Floor curves of rational log surfaces are rational log curves.** -/
private theorem isDlogCurve_step_of_isDlogSurface
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {S₀ G : Scheme.{0}} {ι₀ : S₀ ⟶ CY Q}
    {BS₀ : QDivisor S₀} (F₀ : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ι₀ BS₀) {j : G ⟶ S₀}
    {BG : QDivisor G}
    (hj : haveI := F₀.isIntegral_stratum; haveI := F₀.isNormal_stratum;
      haveI := F₀.isLocallyNoetherian_stratum; IsAdjunctionStep (ι₀ ≫ jY Q ≫ sY) BS₀ j BG)
    (hS₀ : topologicalKrullDim S₀ = (2 : ℕ)) (h : IsDlogSurface t t' Q F₀) :
    IsDlogCurve t t' Q (F₀.step j BG hj) := by
  haveI := F₀.isIntegral_stratum
  haveI := F₀.isNormal_stratum
  haveI := F₀.isLocallyNoetherian_stratum
  haveI : IsIntegral G := hj.1.1.toIsIntegral
  haveI : IsNormal G := hj.1.2
  haveI : LocallyOfFiniteType (j ≫ ι₀ ≫ jY Q ≫ sY) := hj.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ι₀ ≫ jY Q ≫ sY)
  have hX := F₀.isNormalVariety
  haveI := isProper_stratum_Y S Q F₀
  obtain ⟨c, u, w, hu0, hw0, hgen, hψ, hrec, hc⟩ := h
  letI := functionFieldAlgebra (ι₀ ≫ jY Q ≫ sY)
  letI := functionFieldAlgebra (j ≫ ι₀ ≫ jY Q ≫ sY)
  obtain ⟨wC, hwC0, hadj, hres, hψC⟩ :=
    CrepantModelAux.isPoincareResidue_formPow_dlog_of_isAdjunctionStep_of_surface hX hS₀
      (isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q) F₀) u w hu0 hw0 hgen hψ hj
  refine ⟨c, wC, hwC0, hadj, ?_, ⟨_, hrec, _, CrepantModelAux.IsPoincareResidue.smul_const (hres m) c,
    heq_dlogCurveForm (Category.assoc _ _ _) m c wC⟩, hc⟩
  intro Γ
  have h1 := hψC Γ
  exact h1

/-- **Exceptional floor curves of `Y` are rational log curves.** For surfaces (`n = 1`), a floor
curve `Q` of `Y` that is not the strict transform of a floor curve of `X` is a rational log curve
on which `t'_Q = c (dlog ē)^{⊗m}`, where `c` is the value of `t` at the point stratum of `X`
below `Q`. -/
private theorem isDlogCurve_refl_of_not_exists
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hQ : MMP.Mori.IsPair (jY Q ≫ sY) (BY Q))
    (hne : ¬ ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint))
    (hn : n = 1) : IsDlogCurve t t' Q (.refl hQ) := by
  subst hn
  obtain ⟨σ, hσc, hσ, D, hv, hD, hDp, ha, hC1⟩ := exists_isDiscrepancy_neg_one_of_not_exists S Q hne
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hXp.toIsVariety
  haveI := S.hYp.toIsVariety
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := S.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := S.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := S.hmY
    exact ⟨m, by exact_mod_cast S.hm0.ne', D', hD', hD'c⟩
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  obtain ⟨x, hxD, hxcl, z, hz, hsm, L, hL, hLx, hLz, hBL, hL1, hQx, w, hw0, hgen, hψw, hresf⟩ :=
    exists_sncCoordinates_isPoincareResidue_of_isExceptional_curve hYn hXn S.hdimY S.hdimX S.hKY
      S.hKX hKBY S.hm0 S.hmX hdltX σ hσc (S.hjY Q).1 Q.1 (S.hjY Q).2 hC1 D hv hD hDp ha
  obtain ⟨U, τ, hxU, hτmem, hτres, huniq⟩ :=
    exists_presentation_isPoincareResidue_pluriformPullback_eq S ht ht' h hσ Q D hv
  rw [← hxD] at hxU
  letI := stalkAlgebra sX x
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sX x hxcl
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sX hsm
  haveI : Module.Finite (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  obtain ⟨g, hg⟩ := CrepantModelAux.exists_algebraMap_smul_of_mem_pluricanonicalSections S.hdimX
    (by norm_num) z hz0 hw L hL hLx hLz hBL hL1 S.hm0 τ hxU hτmem
  obtain ⟨c, hgc⟩ := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sX x hxcl g
  have hr : IsPoincareResidue sY (jY Q) 1 m (pluriformPullback sY sX σ.toHom (1 + 1) m τ)
      (dlogCurveForm (jY Q ≫ sY) m c w) := by
    rw [hg]; exact hresf g c hgc m
  have hQt := huniq _ hr
  -- the floor component of `X` through the centre, and the point value there
  have hL0 : ⌊B.coeff (L 0)⌋ ≠ 0 := by rw [hL1 0]; norm_num
  set P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} := ⟨L 0, hL0⟩
  have hPU : (jX P).base (genericPoint (CX P)) ∈ U := by
    change jX P (genericPoint (CX P)) ∈ U
    rw [map_genericPoint_eq_of_range_eq (P := L 0) (S.hjX P).2]
    have hsp : (L 0).genericPoint ⤳ x := by
      rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hLx 0
    exact hsp.mem_open U.isOpen hxU
  have hρ := hτres P hPU
  rw [hg] at hρ
  obtain ⟨S', ιS', BS', F', hdim', hfin⟩ :=
    CrepantModelAux.exists_flag_isIteratedResidueRec_of_sncPoint_of_isAdjunctionStep
      S.hBp.isPair hdltX S.hdimX x hxcl z hz hsm L hL hLx hLz hBL hL1 hQx g c hgc (S.hjX P).1
      (S.hjX P).2 (R.setting.isPair P).isPair hρ
  exact ⟨c, w, hw0, hgen, hψw, ⟨rfl, (heq_dlogCurveForm (Category.id_comp _) m c w).trans
    (heq_of_eq hQt)⟩, P, S', ιS', BS', F', hdim', hfin⟩

/-- A floor surface of `Y` exceptional over a curve of `X`: the valuation of `Q` is that of a
divisor of discrepancy `-1` over `X` centred at a curve. -/
private abbrev IsExceptionalOverCurve
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) : Prop :=
  ∃ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
    (_ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a) (D : DivisorOver ℂ sX),
    (∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g)) ∧ D.IsExceptional ∧
      IsProper D.f ∧ MMP.Mori.IsDiscrepancy sX (n + 1) KX B D (-1) ∧ C.coeff Q.1 = 1 ∧
      Order.coheight (D.f D.E.genericPoint) = 2

/-- **Exceptional floor surfaces of `Y` over points are rational log surfaces.** For threefolds
(`n = 2`), a floor surface `Q` of `Y` that is not the strict transform of a floor surface of `X` is
centred on `X` at a closed point, and then is a rational log surface on which
`t'_Q = c (dlog ē₁ ∧ dlog ē₂)^{⊗m}` with `c` the value of `t` there, or at a curve. -/
private theorem isDlogSurface_refl_or_isExceptionalOverCurve_of_not_exists
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hQ : MMP.Mori.IsPair (jY Q ≫ sY) (BY Q))
    (hne : ¬ ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint))
    (hn : n = 2) : IsDlogSurface t t' Q (.refl hQ) ∨ IsExceptionalOverCurve S Q := by
  subst hn
  obtain ⟨σ, hσc, hσ, D, hv, hD, hDp, ha, hC1⟩ := exists_isDiscrepancy_neg_one_of_not_exists S Q hne
  haveI := S.hXp.toLocallyOfFiniteType
  haveI := S.hYp.toLocallyOfFiniteType
  haveI := S.hXp.toIsVariety
  haveI := S.hYp.toIsVariety
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := S.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := S.hCp.isPair.1
  have h3 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight
    hXn D).mp hD
  have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
  rw [S.hdimX] at h5
  have h7 : Order.coheight (D.f D.E.genericPoint) ≤ ((2 + 1 : ℕ) : ℕ∞) :=
    WithBot.coe_le_coe.mp h5
  obtain ⟨cd, hcd⟩ : ∃ cd : ℕ, Order.coheight (D.f D.E.genericPoint) = cd :=
    ⟨(Order.coheight (D.f D.E.genericPoint)).toNat,
      (ENat.coe_toNat (ne_top_of_le_ne_top (ENat.coe_ne_top _) h7)).symm⟩
  rw [hcd] at h3 h7
  have h8 : 2 ≤ cd := by exact_mod_cast h3
  have h9 : cd ≤ 3 := by exact_mod_cast h7
  rcases (show cd = 3 ∨ cd = 2 by omega) with rfl | rfl
  swap
  · exact Or.inr ⟨σ, hσc, hσ, D, hv, hD, hDp, ha, hC1, hcd⟩
  left
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := S.hmY
    exact ⟨m, by exact_mod_cast S.hm0.ne', D', hD', hD'c⟩
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  obtain ⟨x, hxD, hxcl, z, hz, hsm, L, hL, hLx, hLz, hBL, hL1, hQx, u, w, hu0, hw0, hgen, hψw,
    hresf⟩ :=
    exists_sncCoordinates_isPoincareResidue_of_isExceptional_surface_point hYn hXn S.hdimY
      S.hdimX S.hKY S.hKX hKBY S.hm0 S.hmX hdltX σ hσc (S.hjY Q).1 Q.1 (S.hjY Q).2 hC1 D hv hDp
      ha hcd
  obtain ⟨U, τ, hxU, hτmem, hτres, huniq⟩ :=
    exists_presentation_isPoincareResidue_pluriformPullback_eq S ht ht' h hσ Q D hv
  rw [← hxD] at hxU
  letI := stalkAlgebra sX x
  have hz0 : ∀ a, z a ≠ 0 := by
    haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
    exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
  have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed sX x hxcl
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus sX hsm
  haveI : Module.Finite (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄ℂ] := Module.Finite.of_basis b0
  have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
  obtain ⟨g, hg⟩ := CrepantModelAux.exists_algebraMap_smul_of_mem_pluricanonicalSections S.hdimX
    (by norm_num) z hz0 hw L hL hLx hLz hBL hL1 S.hm0 τ hxU hτmem
  obtain ⟨c, hgc⟩ := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed sX x hxcl g
  have hr : IsPoincareResidue sY (jY Q) 2 m (pluriformPullback sY sX σ.toHom (2 + 1) m τ)
      (dlogSurfaceForm (jY Q ≫ sY) m c u w) := by
    rw [hg]; exact hresf g c hgc m
  have hQt := huniq _ hr
  have hL0 : ⌊B.coeff (L 0)⌋ ≠ 0 := by rw [hL1 0]; norm_num
  set P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} := ⟨L 0, hL0⟩
  have hPU : (jX P).base (genericPoint (CX P)) ∈ U := by
    change jX P (genericPoint (CX P)) ∈ U
    rw [map_genericPoint_eq_of_range_eq (P := L 0) (S.hjX P).2]
    have hsp : (L 0).genericPoint ⤳ x := by
      rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hLx 0
    exact hsp.mem_open U.isOpen hxU
  have hρ := hτres P hPU
  rw [hg] at hρ
  obtain ⟨S', ιS', BS', F', hdim', hfin⟩ :=
    CrepantModelAux.exists_flag_isIteratedResidueRec_of_sncPoint_of_isAdjunctionStep
      S.hBp.isPair hdltX S.hdimX x hxcl z hz hsm L hL hLx hLz hBL hL1 hQx g c hgc (S.hjX P).1
      (S.hjX P).2 (R.setting.isPair P).isPair hρ
  refine ⟨c, u, w, hu0, hw0, hgen, hψw, ⟨rfl, ?_⟩, P, S', ιS', BS', F', hdim', hfin⟩
  have e1 : HEq (dlogSurfaceForm (𝟙 (CY Q) ≫ jY Q ≫ sY) m c u w)
      (dlogSurfaceForm (jY Q ≫ sY) m c u w) := by
    have key : ∀ (s : CY Q ⟶ Spec (.of ℂ)) (hs : 𝟙 (CY Q) ≫ jY Q ≫ sY = s),
        HEq (dlogSurfaceForm (𝟙 (CY Q) ≫ jY Q ≫ sY) m c u w) (dlogSurfaceForm s m c u w) := by
      rintro s rfl; rfl
    exact key _ (Category.id_comp _)
  exact e1.trans (heq_of_eq hQt)

/-- **Floor components with a common strict transform are crepant copies.** If the floor
component `Q` of `Y` and a floor component `P` of `X` have a common strict transform on `W`, then
`(C_Q, B_Q)` is a crepant copy of `(C_P, B_P)` carrying `t_P` to `t'_Q`. -/
private theorem isCopyAlong_refl_of_exists
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hQ : MMP.Mori.IsPair (jY Q ≫ sY) (BY Q))
    {e : ℕ} (he : n = e)
    (hne : ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint)) :
    IsCopyAlong R R' t t' Q (.refl hQ) e := by
  subst he
  obtain ⟨P, E, hpE, hqE, hpi, hqi⟩ := hne
  have hdQ : topologicalKrullDim (CY Q) = n := R'.setting.topologicalKrullDim_eq Q
  have hdP : topologicalKrullDim (CX P) = n := R.setting.topologicalKrullDim_eq P
  obtain ⟨σ, hσc, hσ⟩ := S.exists_isCrepantBirationalMap
  obtain ⟨ψ, σT, hψ, hord, hσTc, hσT⟩ :=
    exists_isCrepantBirationalMap_floor S hσc hσ P Q E hpE hqE
  have e1 := pluriformPullback_floor_eq S ht ht' h hσ P Q ψ σT hψ hord hσT hdQ hdP
    (fun E₁ h₁ => by rw [primeDivisor_eq_of_map_genericPoint_eq S Q.1 h₁ hqE]; exact hpE)
  have hP := (R.setting.isPair P).isPair
  refine ⟨P, CX P, 𝟙 _, BX P, .refl hP, hdP, σT, hσTc, ?_⟩
  have f1 := eq_of_heq (ResidueRestriction.toFun_refl R' Q hQ (t' Q))
  have f2 := eq_of_heq (ResidueRestriction.toFun_refl R P hP (t P))
  rw [f1, f2]
  exact e1.symm

/-- **Adjunction steps of crepant copies.** If the stratum `S₀` of a flag `F₀` of `(C_Q, B_Q)`
is a crepant copy of a stratum `U` of a floor component of `X` carrying the residue restriction,
then each adjunction step `G ⊂ S₀` is again a crepant copy, when its valuation is that of a prime
divisor of `U`, and is detecting otherwise. -/
private theorem isCopyAlong_step_or_isDetecting_of_isCopyAlong
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {S₀ G : Scheme.{0}} {ι₀ : S₀ ⟶ CY Q}
    {BS₀ : QDivisor S₀} (F₀ : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ι₀ BS₀) {j : G ⟶ S₀}
    {BG : QDivisor G}
    (hj : haveI := F₀.isIntegral_stratum; haveI := F₀.isNormal_stratum;
      haveI := F₀.isLocallyNoetherian_stratum; IsAdjunctionStep (ι₀ ≫ jY Q ≫ sY) BS₀ j BG)
    {e : ℕ} (hV : topologicalKrullDim G = e)
    (hcopy : IsCopyAlong R R' t t' Q F₀ (e + 1)) :
    IsCopyAlong R R' t t' Q (F₀.step j BG hj) e ∨ (e = 1 ∧ IsDlogCurve t t' Q (F₀.step j BG hj)) := by
  haveI := F₀.isIntegral_stratum
  haveI := F₀.isNormal_stratum
  haveI := F₀.isLocallyNoetherian_stratum
  haveI : IsIntegral G := hj.1.1.toIsIntegral
  haveI : IsNormal G := hj.1.2
  haveI : LocallyOfFiniteType (j ≫ ι₀ ≫ jY Q ≫ sY) := hj.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ι₀ ≫ jY Q ≫ sY)
  haveI : LocallyOfFiniteType (ι₀ ≫ jY Q ≫ sY) := F₀.isNormalVariety.1.toLocallyOfFiniteType
  obtain ⟨-, PG, hP1G, hrangeG, hciG, -⟩ := id hj
  haveI := hciG
  have hS₀ : topologicalKrullDim S₀ = ((e + 1 : ℕ) : WithBot ℕ∞) := by
    have hdl := (StratumAdjunctionData.step F₀ j BG hj).dim_add_length
      (R'.setting.topologicalKrullDim_eq Q) hV
    have h1 := F₀.dim_add_length (R'.setting.topologicalKrullDim_eq Q)
      (topologicalKrullDim_eq_toNat_trdeg (ι₀ ≫ jY Q ≫ sY))
    rw [topologicalKrullDim_eq_toNat_trdeg (ι₀ ≫ jY Q ≫ sY)]
    simp only [StratumAdjunctionData.length] at hdl
    congr 1
    omega
  obtain ⟨P, U, ιU, BU, GU, hU, hGU⟩ := hcopy
  haveI := GU.isIntegral_stratum
  haveI := GU.isNormal_stratum
  haveI := GU.isLocallyNoetherian_stratum
  obtain ⟨ψ, hψ, hres⟩ := hGU
  have hXS := F₀.isNormalVariety
  have hXU := GU.isNormalVariety
  haveI := F₀.isClosedImmersion
  haveI := GU.isClosedImmersion
  haveI := (S.hjY Q).1.exists_primeDivisor.choose_spec.2
  haveI := (S.hjX P).1.exists_primeDivisor.choose_spec.2
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
  have hdlS := isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q) F₀
  have hdlU := isDltPair_of_stratumAdjunctionData (R.setting.isDltPair P) GU
  obtain ⟨K, hK, hmK⟩ := exists_canonical_cartier_flag R' Q F₀ hS₀
  obtain ⟨d₀, KU, hKU, hmKU⟩ := R.setting.isCartierDivisor P GU
  have hd₀ : d₀ = e + 1 := by
    have := hKU.topologicalKrullDim_eq.symm.trans hU
    exact_mod_cast this
  subst hd₀
  have hKB : (Divisor.toQDivisor K + BS₀).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := hmK
    exact ⟨m, by exact_mod_cast R'.setting.pos.ne', D, hD, hDc⟩
  have hKBU : (Divisor.toQDivisor KU + BU).IsQCartier := by
    obtain ⟨D, hD, hDc⟩ := hmKU
    exact ⟨m, by exact_mod_cast R.setting.pos.ne', D, hD, hDc⟩
  -- the divisor over `U` corresponding to `G`
  set DΓ := DivisorOver.ofPrimeDivisor ℂ hXS PG
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hdlS.1.1 hK DΓ
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 S₀) by infer_instance)
  obtain ⟨n', D, hDv, hDlog⟩ := (hψ DΓ.valuation (1 + c)).mp ⟨e + 1, DΓ, rfl, hlog⟩
  have hv : ∀ g, D.valuation g = PG.divisorialValuation ((ψ.toHom) g) := by
    intro g
    rw [hDv]
    change PG.divisorialValuation (functionFieldMap (𝟙 S₀) _) = _
    rw [functionFieldMap_id_apply]
    rfl
  by_cases hex : ∃ P' : Mori.PrimeDivisor U,
      D.valuation = (DivisorOver.ofPrimeDivisor ℂ hXU P').valuation
  swap
  · -- the divisor `G` is exceptional over the surface `U`: it is a curve over a point
    have hD : D.IsExceptional := by
      by_contra hD
      exact hex (MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hXU D hD)
    have hnn : n' = e + 1 := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDlog).symm.trans hU
      exact_mod_cast this
    subst hnn
    have hc' : c = -BS₀.coeff PG := hc.eq_neg_coeff_of_ofPrimeDivisor hXS
    have hPG1 : BS₀.coeff PG = 1 := le_antisymm (hdlS.2.1 PG) hP1G
    obtain ⟨a, ha⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hdlU.1.1 hKU D
    have h1 := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy ha hDlog
    have hac : a = -1 := by
      have : a = c := by exact_mod_cast (by linarith : (a : ℝ) = c)
      rw [this, hc', hPG1]
    rw [hac] at ha
    have he1 : e = 1 := by
      have h3 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight
        hXU D).mp hD
      have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
      rw [hU] at h5
      have h7 : Order.coheight (D.f D.E.genericPoint) ≤ ((e + 1 : ℕ) : ℕ∞) :=
        WithBot.coe_le_coe.mp h5
      have h9 : 2 ≤ e + 1 := by exact_mod_cast h3.trans h7
      have hl := F₀.dim_add_length (R'.setting.topologicalKrullDim_eq Q) hS₀
      have hn := S.hn
      omega
    subst he1
    have hdlG : MMP.Intersection.IsDltPair (j ≫ ι₀ ≫ jY Q ≫ sY) BG := by
      have := isDltPair_of_stratumAdjunctionData (R'.setting.isDltPair Q) (F₀.step j BG hj)
      simpa only [Category.assoc] using this
    haveI : CompactSpace S₀ := QuasiCompact.compactSpace_of_compactSpace (ι₀ ≫ jY Q ≫ sY)
    haveI : CompactSpace U := QuasiCompact.compactSpace_of_compactSpace (ιU ≫ jX P ≫ sX)
    haveI : CompactSpace G := QuasiCompact.compactSpace_of_compactSpace (j ≫ ι₀ ≫ jY Q ≫ sY)
    right
    refine ⟨rfl, ?_⟩
    obtain ⟨x, -, hxcl, z, hz, hsm, L, hL, hLx, hLz, hBL, hL1, hQx, w, hw0, hgen, hψw, hresf⟩ :=
      exists_sncCoordinates_isPoincareResidue_of_isExceptional_curve hXS hXU hS₀ hU hK hKU hKB
        R.setting.pos hmKU hdlU ψ hψ hj PG hrangeG hPG1 D hv hD hDlog.2.1 ha
    letI := functionFieldAlgebra (ιU ≫ jX P ≫ sX)
    letI := functionFieldAlgebra (ι₀ ≫ jY Q ≫ sY)
    letI := stalkAlgebra (ιU ≫ jX P ≫ sX) x
    have hz0 : ∀ a, z a ≠ 0 := by
      haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
      exact fun a => MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hz a
    have hres' := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed
      (ιU ≫ jX P ≫ sX) x hxcl
    obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus
      (ιU ≫ jX P ≫ sX) hsm
    haveI : Module.Finite (U.presheaf.stalk x) Ω[U.presheaf.stalk x⁄ℂ] := Module.Finite.of_basis b0
    have hw := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres' z hz.1
    have hτ := toFun_mem_logPluricanonicalSections R t P GU hU
    obtain ⟨g, hg⟩ := CrepantModelAux.exists_algebraMap_smul_of_mem_logPluricanonicalSections hU
      (by norm_num) z hz0 hw L hL hLx hLz hBL hL1 R.setting.pos _ hτ
    obtain ⟨c, hgc⟩ := CrepantModelAux.exists_sub_mem_maximalIdeal_of_isClosed
      (ιU ≫ jX P ≫ sX) x hxcl g
    have hr : IsPoincareResidue (ι₀ ≫ jY Q ≫ sY) j 1 m (R'.toFun Q F₀ (1 + 1) (t' Q))
        (dlogCurveForm (j ≫ ι₀ ≫ jY Q ≫ sY) m c w) := by
      rw [hres, hg]
      exact hresf g c hgc m
    obtain ⟨S', ιS', BS', F', -, hdim', hrec'⟩ :=
      CrepantModelAux.exists_flag_isIteratedResidueRec_of_sncPoint
        (t P : RationalPluriForms (jX P ≫ sX) n m) (1 + 1) GU (ιU ≫ jX P ≫ sX) rfl hXU hdlU hU x
        hxcl z hz hsm L hL hLx hLz hBL hL1 hQx g c hgc
        ⟨_, (R.isIteratedResidue P GU (1 + 1) (t P) hU).rec', heq_of_eq hg⟩
    exact ⟨c, w, hw0, hgen, hψw, ⟨_, (R'.isIteratedResidue Q F₀ (1 + 1) (t' Q) hS₀).rec', _, hr,
      heq_dlogCurveForm (Category.assoc _ _ _) m c w⟩, P, S', ιS', BS', F', hdim', hrec'⟩
  obtain ⟨P', hP'⟩ := hex
  have hP'v : ∀ g, P'.divisorialValuation g = PG.divisorialValuation ((ψ.toHom) g) := by
    intro g
    rw [← hv, hP']
    change _ = P'.divisorialValuation (functionFieldMap (𝟙 U) g)
    rw [functionFieldMap_id_apply]
  obtain ⟨G', j', BG', _, _, _, hj', σG, hcrepG, hresG⟩ :=
    exists_isAdjunctionStep_isPoincareResidue_pluriformPullback hdlS hdlU hS₀ hU hK hKU hKB
      hKBU ψ hψ hj PG hrangeG P' hP'v
  obtain ⟨-, P'', -, hrange', hci', -⟩ := id hj'
  haveI := hci'
  haveI : LocallyOfFiniteType (ιU ≫ jX P ≫ sX) := hXU.1.toLocallyOfFiniteType
  have hG' : topologicalKrullDim G' = e :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support (ιU ≫ jX P ≫ sX) j' P'' hrange'
      hU
  left
  refine ⟨P, G', j' ≫ ιU, BG', GU.step j' BG' hj', hG', σG, hcrepG, ?_⟩
  obtain ⟨ρ₀, h₀, ρ, hr, hρ⟩ := (R'.isIteratedResidue Q (F₀.step j BG hj) e (t' Q) hV).rec'
  have e₀ := IsIteratedResidueRec.unique F₀ h₀
    (R'.isIteratedResidue Q F₀ (e + 1) (t' Q) hS₀).rec'
  obtain ⟨ρ₀', h₀', ρ', hr', hρ'⟩ :=
    (R.isIteratedResidue P (GU.step j' BG' hj') e (t P) hG').rec'
  have e₀' := IsIteratedResidueRec.unique GU h₀' (R.isIteratedResidue P GU (e + 1) (t P) hU).rec'
  rw [e₀] at hr
  rw [e₀'] at hr'
  have hA := hresG _ _ hr'
  rw [← hres] at hA
  have hu := IsPoincareResidue.unique_of_isClosedImmersion PG
    (map_genericPoint_eq_of_range_eq hrangeG) hr hA
  rw [eq_of_heq hρ, eq_of_heq hρ', hu]
  rfl

/-- **A generator of transcendence degree one is transcendental.** If `L = K(e)` over `ℂ`, with
`trdeg_ℂ K = 1` and `trdeg_ℂ L = 2`, then `e` is transcendental over `K`. -/
private theorem transcendental_of_adjoin_eq_top_of_toNat_trdeg {K L : Type} [Field K] [Field L]
    [Algebra ℂ K] [Algebra ℂ L] [Algebra K L] [IsScalarTower ℂ K L] {e : L}
    (hgen : IntermediateField.adjoin K {e} = ⊤) (hK : (Algebra.trdeg ℂ K).toNat = 1)
    (hL : (Algebra.trdeg ℂ L).toNat = 2) : Transcendental K e := by
  intro halg
  have hint : IsIntegral K e := halg.isIntegral
  haveI := IntermediateField.adjoin.finiteDimensional hint
  have hfin : FiniteDimensional K L := by
    have e1 := (IntermediateField.equivOfEq hgen).trans
      (IntermediateField.topEquiv (F := K) (E := L))
    exact LinearEquiv.finiteDimensional e1.toLinearEquiv
  haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite _ _
  have h1 := trdeg_add_eq (R := ℂ) (S := K) (A := L)
  rw [trdeg_eq_zero (R := K) (A := L), add_zero] at h1
  rw [h1] at hK
  omega

/-- **A spanning differential on a quotient.** If `dz₁, dz₂, dv` span `Ω_{A/k}` and the
surjection `φ : A → B` of `k`-algebras kills `z₁` and `z₂`, then `d φ(v)` spans `Ω_{B/k}`. -/
private theorem span_D_singleton_eq_top_of_surjective {k A B : Type*} [CommRing k] [CommRing A]
    [CommRing B] [Algebra k A] [Algebra k B] (φ : A →+* B) (hφ : Function.Surjective φ)
    (hφk : ∀ c : k, φ (algebraMap k A c) = algebraMap k B c) (a : Fin 3 → A)
    (h : Submodule.span A (Set.range fun i => KaehlerDifferential.D k A (a i)) = ⊤)
    (h0 : φ (a 0) = 0) (h1 : φ (a 1) = 0) :
    Submodule.span B {KaehlerDifferential.D k B (φ (a 2))} = ⊤ := by
  let φk : A →ₐ[k] B := { φ with commutes' := hφk }
  have hw := CrepantModelAux.span_D_eq_top_of_surjective φk hφ a h
  rw [eq_top_iff, ← hw, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · change KaehlerDifferential.D k B (φ (a 0)) ∈ _
    rw [h0, map_zero]; exact Submodule.zero_mem _
  · change KaehlerDifferential.D k B (φ (a 1)) ∈ _
    rw [h1, map_zero]; exact Submodule.zero_mem _
  · exact Submodule.subset_span rfl

/-- **The residue of a pulled-back monomial log frame.** Let `φ : k(S') → k(S)`, and `T ⊂ S` a
prime divisor with a uniformizer `t` and units `e₁, e₂` of `𝒪_{S,T}` such that
`φ^*(dlog z₁ ∧ dlog z₂ ∧ dlog z₃) = dlog t ∧ dlog e₁ ∧ dlog e₂`. Then the residue along `T` of
`φ^*(dlog z₁ ∧ dlog z₂ ∧ dlog z₃)^{⊗a}` is `(dlog ē₁ ∧ dlog ē₂)^{⊗a}`. -/
private theorem isPoincareResidue_pluriformPullback_formPow_dlog {k : Type} [Field k]
    [CharZero k] {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of k)} {sS' : S' ⟶ Spec (.of k)}
    [IsIntegral S] [IsLocallyNoetherian S] [IsIntegral S'] [IsIntegral T]
    [LocallyOfFiniteType sS] [LocallyOfFiniteType sS']
    (hS : topologicalKrullDim S = ((2 + 1 : ℕ) : WithBot ℕ∞))
    (hS' : topologicalKrullDim S' = ((2 + 1 : ℕ) : WithBot ℕ∞)) (ι : T ⟶ S)
    (φ : FunctionFieldHom sS sS') {x : S'} (z : Fin 3 → S'.presheaf.stalk x)
    (t : S.presheaf.stalk (ι (genericPoint T)))
    (e : Fin 2 → S.presheaf.stalk (ι (genericPoint T))) (he : ∀ i, IsUnit (e i))
    (ht : (letI := functionFieldAlgebra sS
      S.ord (algebraMap _ S.functionField t) (ι (genericPoint T))) = 1)
    (hfr : letI := functionFieldAlgebra sS
      exteriorPower.ιMulti S.functionField 3 (fun i =>
          (φ (algebraMap _ S'.functionField (z i)))⁻¹ •
            KaehlerDifferential.D k S.functionField (φ (algebraMap _ S'.functionField (z i)))) =
        exteriorPower.ιMulti S.functionField 3 (Fin.cons
          ((algebraMap _ S.functionField t)⁻¹ • KaehlerDifferential.D k _ (algebraMap _ _ t))
          fun i => (algebraMap _ S.functionField (e i))⁻¹ •
            KaehlerDifferential.D k _ (algebraMap _ _ (e i))))
    (a : ℕ) (u₀ u₁ : T.functionField)
    (hu₀ : (ι.stalkMap (genericPoint T)).hom (e 0) = u₀)
    (hu₁ : (ι.stalkMap (genericPoint T)).hom (e 1) = u₁) :
    letI := functionFieldAlgebra sS'
    letI := functionFieldAlgebra (ι ≫ sS)
    IsPoincareResidue sS ι 2 a (pluriformPullback sS sS' φ (2 + 1) a
        (formPow (exteriorPower.ιMulti S'.functionField 3 fun i =>
          (algebraMap _ S'.functionField (z i))⁻¹ •
            KaehlerDifferential.D k _ (algebraMap _ S'.functionField (z i))) a))
      (formPow (exteriorPower.ιMulti T.functionField 2
        ![u₀⁻¹ • KaehlerDifferential.D k _ u₀, u₁⁻¹ • KaehlerDifferential.D k _ u₁]) a) := by
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  letI := functionFieldAlgebra (ι ≫ sS)
  subst hu₀ hu₁
  have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hS hS' φ
    (fun i => algebraMap _ S'.functionField (z i)) a 1
  rw [one_smul, map_one, one_smul, hfr] at h1
  have h2 := CrepantModelAux.isPoincareResidue_formPow_dlog sS ι a t e he ht
  have hfun : (fun i : Fin 2 => ((ι.stalkMap (genericPoint T)).hom (e i))⁻¹ •
      KaehlerDifferential.D k T.functionField ((ι.stalkMap (genericPoint T)).hom (e i))) =
      ![((ι.stalkMap (genericPoint T)).hom (e 0))⁻¹ •
          KaehlerDifferential.D k _ ((ι.stalkMap (genericPoint T)).hom (e 0)),
        ((ι.stalkMap (genericPoint T)).hom (e 1))⁻¹ •
          KaehlerDifferential.D k _ ((ι.stalkMap (genericPoint T)).hom (e 1))] := by
    funext i; fin_cases i <;> rfl
  rw [hfun] at h2
  exact (congrArg (IsPoincareResidue sS ι 2 a · _) h1).mpr h2

/-- **The residue of a pulled-back monomial log frame, with a coefficient.** In the situation of
`isPoincareResidue_pluriformPullback_formPow_dlog`, if `τ = c (dlog z₁ ∧ dlog z₂ ∧ dlog z₃)^{⊗a}`
and `φ(c) = b` with `b ∈ 𝒪_{S,T}`, then the residue of `φ^*τ` along `T` is
`b̄ (dlog ē₁ ∧ dlog ē₂)^{⊗a}`. -/
private theorem isPoincareResidue_pluriformPullback_of_eq_smul_formPow_dlog {k : Type}
    [Field k] [CharZero k] {S S' T : Scheme.{0}} {sS : S ⟶ Spec (.of k)}
    {sS' : S' ⟶ Spec (.of k)} [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S]
    [IsIntegral S'] [IsIntegral T] [LocallyOfFiniteType sS] [LocallyOfFiniteType sS']
    (hS : topologicalKrullDim S = ((2 + 1 : ℕ) : WithBot ℕ∞))
    (hS' : topologicalKrullDim S' = ((2 + 1 : ℕ) : WithBot ℕ∞)) (ι : T ⟶ S)
    (φ : FunctionFieldHom sS sS') {x : S'} (z : Fin 3 → S'.presheaf.stalk x)
    (t : S.presheaf.stalk (ι (genericPoint T)))
    (e : Fin 2 → S.presheaf.stalk (ι (genericPoint T))) (he : ∀ i, IsUnit (e i))
    (ht : (letI := functionFieldAlgebra sS
      S.ord (algebraMap _ S.functionField t) (ι (genericPoint T))) = 1)
    (hfr : letI := functionFieldAlgebra sS
      exteriorPower.ιMulti S.functionField 3 (fun i =>
          (φ (algebraMap _ S'.functionField (z i)))⁻¹ •
            KaehlerDifferential.D k S.functionField (φ (algebraMap _ S'.functionField (z i)))) =
        exteriorPower.ιMulti S.functionField 3 (Fin.cons
          ((algebraMap _ S.functionField t)⁻¹ • KaehlerDifferential.D k _ (algebraMap _ _ t))
          fun i => (algebraMap _ S.functionField (e i))⁻¹ •
            KaehlerDifferential.D k _ (algebraMap _ _ (e i))))
    (a : ℕ) (c : S'.presheaf.stalk x) (b : S.presheaf.stalk (ι (genericPoint T)))
    (hb : algebraMap _ S.functionField b = φ (algebraMap _ S'.functionField c))
    (b' u₀ u₁ : T.functionField) (hb' : (ι.stalkMap (genericPoint T)).hom b = b')
    (hu₀ : (ι.stalkMap (genericPoint T)).hom (e 0) = u₀)
    (hu₁ : (ι.stalkMap (genericPoint T)).hom (e 1) = u₁)
    (τ : RationalPluriForms sS' (2 + 1) a)
    (hτ : letI := functionFieldAlgebra sS'
      τ = algebraMap _ S'.functionField c • formPow (exteriorPower.ιMulti S'.functionField 3
        fun i => (algebraMap _ S'.functionField (z i))⁻¹ •
          KaehlerDifferential.D k _ (algebraMap _ S'.functionField (z i))) a) :
    letI := functionFieldAlgebra (ι ≫ sS)
    IsPoincareResidue sS ι 2 a (pluriformPullback sS sS' φ (2 + 1) a τ)
      (b' • formPow (exteriorPower.ιMulti T.functionField 2
        ![u₀⁻¹ • KaehlerDifferential.D k _ u₀, u₁⁻¹ • KaehlerDifferential.D k _ u₁]) a) := by
  letI := functionFieldAlgebra sS
  letI := functionFieldAlgebra sS'
  letI := functionFieldAlgebra (ι ≫ sS)
  have hτ' : τ = _ := hτ
  subst hτ' hb' hu₀ hu₁
  have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hS hS' φ
    (fun i => algebraMap _ S'.functionField (z i)) a (algebraMap _ _ c)
  rw [hfr, ← hb] at h1
  have h2 := IsPoincareResidue.algebraMap_smul'
    (CrepantModelAux.isPoincareResidue_formPow_dlog sS ι a t e he ht) b
  have hfun : (fun i : Fin 2 => ((ι.stalkMap (genericPoint T)).hom (e i))⁻¹ •
      KaehlerDifferential.D k T.functionField ((ι.stalkMap (genericPoint T)).hom (e i))) =
      ![((ι.stalkMap (genericPoint T)).hom (e 0))⁻¹ •
          KaehlerDifferential.D k _ ((ι.stalkMap (genericPoint T)).hom (e 0)),
        ((ι.stalkMap (genericPoint T)).hom (e 1))⁻¹ •
          KaehlerDifferential.D k _ ((ι.stalkMap (genericPoint T)).hom (e 1))] := by
    funext i; fin_cases i <;> rfl
  rw [hfun] at h2
  exact (congrArg (IsPoincareResidue sS ι 2 a · _) h1).mpr h2

open scoped WithZero in
/-- **The local data of a floor surface contracted to a curve.** Let `Q` be a floor surface of `Y`
whose valuation is that of a divisor `D` of discrepancy `-1` over `X` centred at the generic point
`x` of a curve `Z = L₀ ∩ L₁`, with snc coordinates `z₁, z₂` and a unit `v` at `x`. Then:
* `Z` is reached from the floor component `C_P = L₀` of `X` by an adjunction step `T_Z ⟶ C_P`,
  with residue map `𝒪_{X,x} ↠ k(T_Z)`, and `t_P` restricts along it to `ḡ (dlog v̄)^{⊗m}`, where
  `g Ω^{⊗m}`, `Ω = dlog z₁ ∧ dlog z₂ ∧ dlog v`, presents the floor section near `x`;
* `k(C_Q) = K(ē)` with `K = λ(k(T_Z))` and `ē` transcendental, and
  `t'_Q = λ(ḡ) (dlog ē ∧ dlog λ(v̄))^{⊗m}`, the residue of `σ^*(g Ω^{⊗m})`;
* `Ω` is a log generator near `x`, its pull-back to `T_Z` is `div(dlog v̄) + B_{T_Z}`, and
  `(T_Z, B_{T_Z})` is dlt. -/
private theorem exists_data_of_isExceptionalOverCurve
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) 2 m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) 2 m (BY Q)}
    (hfX : IsFloorSection sX 2 m B jX BX t) (hfY : IsFloorSection sY 2 m C jY BY t')
    (hpins : Pins sX sY 2 B C p q St.hpq BW m jX BX jY BY t t')
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q) :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∃ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
      (_ : ∀ a, functionFieldMap q (σ a) = functionFieldMap p a) (D : DivisorOver ℂ sX)
      (_ : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g))
      (_ : IsProper D.f) (_ : MMP.Mori.IsDiscrepancy sX (2 + 1) KX B D (-1))
      (_ : Order.coheight (D.f D.E.genericPoint) = 2),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (ι₂ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (h₂ : IsAdjunctionStep (jX P ≫ sX) (BX P) ι₂ BZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ιZ = ι₂ ≫ jX P ≫ 𝟙 X ∧ topologicalKrullDim TZ = (1 : ℕ) ∧
        ιZ (genericPoint TZ) = D.f D.E.genericPoint ∧
        ∃ (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v g : X.presheaf.stalk (D.f D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField),
          Function.Surjective resZ ∧
          (∀ r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (D.f D.E.genericPoint)), resZ r = 0) ∧
          (∀ c : ℂ, resZ (algebraMap ℂ _ c) = algebraMap ℂ _ c) ∧
          (∀ (h : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ))
            (a : X.presheaf.stalk (ιZ (genericPoint TZ))),
            resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιZ.stalkMap (genericPoint TZ)).hom a) ∧
          (∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c) ∧
          (letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb) ∧
          (∀ (r : X.presheaf.stalk (D.f D.E.genericPoint))
            (gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q)))),
            algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField r) →
            ((jY Q).stalkMap (genericPoint (CY Q))).hom gT = lam (resZ r)) ∧
          IsUnit v ∧
          Submodule.span TZ.functionField {KaehlerDifferential.D ℂ TZ.functionField (resZ v)} = ⊤ ∧
          (letI := functionFieldAlgebra (ι₂ ≫ jX P ≫ sX);
            IsPoincareResidue (jX P ≫ sX) ι₂ 1 m (t P : RationalPluriForms (jX P ≫ sX) 2 m)
