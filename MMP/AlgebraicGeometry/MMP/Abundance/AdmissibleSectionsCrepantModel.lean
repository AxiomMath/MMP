  exact ⟨Z₁, hZη, hZz, hB1Z, hord1, hτ1L, hτ10, ⟨U, hxU, hU⟩, ⟨hgenT, hpbT⟩, hzu⟩

/-- A Poincaré residue of the form `c · (dlog f₁ ∧ ⋯ ∧ dlog f_n)^{⊗m}` is also one of
`c' · (dlog f'₁ ∧ ⋯ ∧ dlog f'_n)^{⊗m}` when `c = c'` and `f = f'` pointwise. -/
private theorem isPoincareResidue_smul_formPow_dlog_congr {k : Type} [Field k]
    {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsIntegral T] {j : T ⟶ Y} {n m : ℕ} {τ : RationalPluriForms sY (n + 1) m}
    {c c' : T.functionField} {f f' : Fin n → T.functionField}
    (h : letI := functionFieldAlgebra (j ≫ sY)
      IsPoincareResidue sY j n m τ (c • formPow (exteriorPower.ιMulti T.functionField n
        fun i => (f i)⁻¹ • KaehlerDifferential.D k T.functionField (f i)) m))
    (hc : c = c') (hf : ∀ i, f i = f' i) :
    letI := functionFieldAlgebra (j ≫ sY)
    IsPoincareResidue sY j n m τ (c' • formPow (exteriorPower.ιMulti T.functionField n
      fun i => (f' i)⁻¹ • KaehlerDifferential.D k T.functionField (f' i)) m) := by
  subst hc
  obtain rfl : f = f' := funext hf
  exact h

/-- The pull-back predicate only depends on the pulled-back divisor. -/
private theorem isPullback_of_eq_target {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : X ⟶ Y} {D : QDivisor Y}
    {hf : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D.supp}
    {D₁ D₂ : QDivisor X} (h : D₁ = D₂) (H : D.IsPullback f hf D₁) : D.IsPullback f hf D₂ := by
  subst h
  exact H

/-- **Pull-back along a flag of length two.** Let `T₂ ⟶ T₁ ⟶ X` be two adjunction steps onto
`L₀ ⊂ X` and `Z₁ ⊂ T₁`. If `τ` has order `-1` along `L₀`, residue `ρ` along `T₁`, `ρ` has order
`-1` along `Z₁` and residue `σ` along `T₂`, `div τ + B` is `ℚ`-Cartier and has no component
through the image of the generic point of `T₂`, then `div τ + B` pulls back to `div σ + B₂`. -/
private theorem exists_isPullback_comp_of_isPoincareResidue {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX] {B : QDivisor X}
    (hd : topologicalKrullDim X = (3 : ℕ))
    {T₁ : Scheme.{0}} [IsIntegral T₁] [IsLocallyNoetherian T₁] [IsNormal T₁] [CompactSpace T₁]
    (ι₁ : T₁ ⟶ X) [IsClosedImmersion ι₁] [LocallyOfFiniteType (ι₁ ≫ sX)] {B₁ : QDivisor T₁}
    (h₁' : IsAdjunctionStep sX B ι₁ B₁) (L0 : Mori.PrimeDivisor X)
    (hr₁ : Set.range ι₁.base = (L0.support : Set X)) (hd₁ : topologicalKrullDim T₁ = (2 : ℕ))
    {T₂ : Scheme.{0}} [IsIntegral T₂] [IsLocallyNoetherian T₂] [IsNormal T₂] [CompactSpace T₂]
    (ι₂ : T₂ ⟶ T₁) [IsClosedImmersion ι₂] [LocallyOfFiniteType (ι₂ ≫ ι₁ ≫ sX)]
    [LocallyOfFiniteType ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX)] {B₂ : QDivisor T₂}
    (h₂' : IsAdjunctionStep (ι₁ ≫ sX) B₁ ι₂ B₂) (Z₁ : Mori.PrimeDivisor T₁)
    (hr₂ : Set.range ι₂.base = (Z₁.support : Set T₁))
    {τ : RationalPluriForms sX 3 ((1 : ℕ) : ℤ)} (hτ0 : τ ≠ 0) (hτL : L0.ordForm τ = -1)
    (hQ : (Divisor.toQDivisor (divisorOfForm τ) + B).IsQCartier)
    (hτU : ∀ E : Mori.PrimeDivisor X, ι₁ (ι₂ (genericPoint T₂)) ∈ E.support →
      (Divisor.toQDivisor (divisorOfForm τ) + B).coeff E = 0)
    {ρ : RationalPluriForms (ι₁ ≫ sX) 2 ((1 : ℕ) : ℤ)} (hρ0 : ρ ≠ 0) (hρZ : Z₁.ordForm ρ = -1)
    {σ : RationalPluriForms (ι₂ ≫ ι₁ ≫ sX) 1 ((1 : ℕ) : ℤ)}
    {σ' : RationalPluriForms ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX) 1 ((1 : ℕ) : ℤ)} (hσ : HEq σ' σ)
    (h1 : IsPoincareResidue sX ι₁ 2 1 τ ρ) (h2 : IsPoincareResidue (ι₁ ≫ sX) ι₂ 1 1 ρ σ) :
    ∃ hgen, (Divisor.toQDivisor (divisorOfForm τ) + B).IsPullback (ι₂ ≫ ι₁ ≫ 𝟙 X) hgen
      (Divisor.toQDivisor (divisorOfForm σ') + B₂) := by
  have hsT : (ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX = ι₂ ≫ ι₁ ≫ sX := by simp
  obtain ⟨hg1, hpb1⟩ := h₁'.isPullback_divisorOfForm_add_of_isPoincareResidue (n := 2)
    (by rw [hd]; norm_cast) L0 hr₁ τ hτ0 hτL ρ h1 hQ
  have hq := isQCartier_of_isPullback hQ hpb1
  obtain ⟨hg2, hpb2⟩ := h₂'.isPullback_divisorOfForm_add_of_isPoincareResidue (n := 1)
    (by rw [hd₁]; norm_cast) Z₁ hr₂ ρ hρ0 hρZ σ h2 hq
  have hgen12 : ∀ C : irreducibleComponents T₂, (ι₂ ≫ ι₁) (componentGenericPoint T₂ C) ∉
      (Divisor.toQDivisor (divisorOfForm τ) + B).supp := by
    intro C hC
    obtain ⟨E, hE, hzE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hC
    rw [componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply] at hzE
    exact hE (hτU E hzE)
  have hpb12 := qDivisor_isPullback_comp' ι₁ ι₂ hpb1 hpb2 hgen12
  exact ⟨_, isPullback_of_eq_target
    (congrArg (fun D => Divisor.toQDivisor D + B₂) (divisorOfForm_heq hsT hσ).symm)
    (isPullback_of_hom_eq (hg := fun C => by simpa using hgen12 C)
      (show ι₂ ≫ ι₁ = ι₂ ≫ ι₁ ≫ 𝟙 X by simp) hpb12)⟩

/-- **Unit multiples along a flag to a curve stratum.** In the situation of
`exists_isPullback_comp_of_isPoincareResidue`, with residues `ḡ ρ₁` of `g τ₁` and `ḡ σ` of
`ḡ ρ₁` for every `g`, every unit `g₀` at the image of the generic point of `T₂` gives a
pull-back of `div(g₀ τ₁) + B` to `div(ḡ₀ σ) + B₂`. -/
private theorem exists_isPullback_unit_smul_of_curve_flag {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX) [LocallyOfFiniteType sX]
    {B : QDivisor X} (hpair : Mori.IsPair sX B) (hd : topologicalKrullDim X = (3 : ℕ))
    {T₁ : Scheme.{0}} [IsIntegral T₁] [IsLocallyNoetherian T₁] [IsNormal T₁] [CompactSpace T₁]
    (ι₁ : T₁ ⟶ X) [IsClosedImmersion ι₁] [LocallyOfFiniteType (ι₁ ≫ sX)] {B₁ : QDivisor T₁}
    (h₁' : IsAdjunctionStep sX B ι₁ B₁) (L0 : Mori.PrimeDivisor X)
    (hr₁ : Set.range ι₁.base = (L0.support : Set X)) (hd₁ : topologicalKrullDim T₁ = (2 : ℕ))
    {T₂ : Scheme.{0}} [IsIntegral T₂] [IsLocallyNoetherian T₂] [IsNormal T₂] [CompactSpace T₂]
    (ι₂ : T₂ ⟶ T₁) [IsClosedImmersion ι₂] [LocallyOfFiniteType (ι₂ ≫ ι₁ ≫ sX)]
    [LocallyOfFiniteType ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX)] {B₂ : QDivisor T₂}
    (h₂' : IsAdjunctionStep (ι₁ ≫ sX) B₁ ι₂ B₂) (Z₁ : Mori.PrimeDivisor T₁)
    (hr₂ : Set.range ι₂.base = (Z₁.support : Set T₁))
    (hZη : Z₁.genericPoint = ι₂ (genericPoint T₂)) (hLx : ι₁ (ι₂ (genericPoint T₂)) ∈ L0.support)
    {τ1 : RationalPluriForms sX 3 ((1 : ℕ) : ℤ)}
    {ρ1 : RationalPluriForms (ι₁ ≫ sX) 2 ((1 : ℕ) : ℤ)}
    (hτU : ∀ E : Mori.PrimeDivisor X, ι₁ (ι₂ (genericPoint T₂)) ∈ E.support →
      (Divisor.toQDivisor (divisorOfForm τ1) + B).coeff E = 0)
    (hτ10 : τ1 ≠ 0) (hτ1L : L0.ordForm τ1 = -1) (hρ10 : ρ1 ≠ 0) (hord1 : Z₁.ordForm ρ1 = -1)
    (resZ : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))) →+* T₂.functionField)
    (v : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))))
    (hres1 : ∀ g : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))),
      letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ι₁ ≫ sX)
      IsPoincareResidue sX ι₁ 2 1 (algebraMap _ X.functionField g • τ1)
        (algebraMap _ T₁.functionField ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom g) • ρ1))
    (hres2 : ∀ g : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))),
      letI := functionFieldAlgebra (ι₁ ≫ sX); letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
      IsPoincareResidue (ι₁ ≫ sX) ι₂ 1 1
        (algebraMap _ T₁.functionField ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom g) • ρ1)
        (resZ g • formPow (exteriorPower.ιMulti T₂.functionField 1
          fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) 1)) :
    letI := functionFieldAlgebra sX; letI := functionFieldAlgebra ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX)
    ∀ g₀ : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))), IsUnit g₀ →
      ∃ hgen, (Divisor.toQDivisor (divisorOfForm (algebraMap _ X.functionField g₀ • τ1)) +
        B).IsPullback (ι₂ ≫ ι₁ ≫ 𝟙 X) hgen
        (Divisor.toQDivisor (divisorOfForm
          (show RationalPluriForms ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ g₀ •
            formPow (exteriorPower.ιMulti T₂.functionField 1
              fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) 1)) +
          B₂) := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (ι₁ ≫ sX)
  letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
  have hsT : (ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX = ι₂ ≫ ι₁ ≫ sX := by simp
  intro g₀ hg₀
  have hg0K : algebraMap _ X.functionField g₀ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hg₀.ne_zero
  have hτg0 : (algebraMap _ X.functionField g₀ • τ1 : RationalPluriForms sX 3 ((1 : ℕ) : ℤ)) ≠ 0 :=
    smul_ne_zero hg0K hτ10
  have hordg : ∀ E : Mori.PrimeDivisor X, ι₁ (ι₂ (genericPoint T₂)) ∈ E.support →
      X.ord (algebraMap _ X.functionField g₀) E.genericPoint = 0 := by
    intro E hE
    have h := MMP.Resolution.Aux.genericPoint_specializes_of_mem_support E hE
    rw [← Mori.algebraMap_stalkSpecializes h]
    exact E.ord_algebraMap_of_isUnit (hg₀.map _)
  have hτgL : L0.ordForm (algebraMap _ X.functionField g₀ • τ1) = -1 := by
    rw [L0.ordForm_smul_of_topologicalKrullDim_eq hd hg0K hτ10, hτ1L, hordg _ hLx]; rfl
  have hQg : (Divisor.toQDivisor (divisorOfForm (algebraMap _ X.functionField g₀ • τ1)) +
      B).IsQCartier := by
    obtain ⟨-, n0, K0, hK0, hKB0⟩ := hpair
    have hn0 : n0 = 3 := by
      have := hK0.topologicalKrullDim_eq; rw [hd] at this; exact_mod_cast this.symm
    subst hn0
    exact hKB0.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX hK0 hτg0).symm)
  set g₁ := (ι₁.stalkMap (ι₂ (genericPoint T₂))).hom g₀ with hg₁
  have hg₁u : IsUnit g₁ := hg₀.map _
  have hg1K : algebraMap _ T₁.functionField g₁ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hg₁u.ne_zero
  have hρg0 : (algebraMap _ T₁.functionField g₁ • ρ1 :
      RationalPluriForms (ι₁ ≫ sX) 2 ((1 : ℕ) : ℤ)) ≠ 0 := smul_ne_zero hg1K hρ10
  have hρgZ : Z₁.ordForm (algebraMap _ T₁.functionField g₁ • ρ1) = -1 := by
    rw [Z₁.ordForm_smul_of_topologicalKrullDim_eq hd₁ hg1K hρ10, hord1, hZη,
      ord_algebraMap_eq_zero_of_isUnit' Z₁ hZη.symm hg₁u]
    rfl
  have hτgU : ∀ E : Mori.PrimeDivisor X, ι₁ (ι₂ (genericPoint T₂)) ∈ E.support →
      (Divisor.toQDivisor (divisorOfForm (algebraMap _ X.functionField g₀ • τ1)) + B).coeff E =
        0 := by
    intro E hzE
    have h1 := hτU E hzE
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm] at h1 ⊢
    rw [E.ordForm_smul_of_topologicalKrullDim_eq hd hg0K hτ10, hordg E hzE, zero_add]
    exact h1
  exact exists_isPullback_comp_of_isPoincareResidue hd ι₁ h₁' L0 hr₁ hd₁ ι₂ h₂' Z₁ hr₂ hτg0 hτgL
    hQg hτgU hρg0 hρgZ (heq_smul_formPow_ιMulti_dlog hsT (resZ g₀) (fun _ => resZ v) 1)
    (hres1 g₀) (hres2 g₀)

/-- **Log pluricanonical sections along a flag to a curve stratum.** In the situation of
`exists_isPullback_comp_of_isPoincareResidue`, a log pluricanonical section `g τ^m` of `(X, B)`
restricts to the log pluricanonical section `ḡ σ^m` of `(T₂, B₂)`, as soon as the relevant
pluricanonical divisors are Cartier. -/
private theorem smul_formPow_mem_logPluricanonicalSections_of_curve_flag {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX)
    [LocallyOfFiniteType sX] {B : QDivisor X} (hpair : Mori.IsPair sX B)
    (hdlt : MMP.Intersection.IsDltPair sX B) (hd : topologicalKrullDim X = (3 : ℕ))
    {T₁ : Scheme.{0}} [IsIntegral T₁] [IsLocallyNoetherian T₁] [IsNormal T₁] [CompactSpace T₁]
    (ι₁ : T₁ ⟶ X) [LocallyOfFiniteType (ι₁ ≫ sX)] {B₁ : QDivisor T₁}
    (h₁ : IsAdjunctionStep (𝟙 X ≫ sX) B ι₁ B₁) (h₁' : IsAdjunctionStep sX B ι₁ B₁)
    (hT₁nv : IsNormalVariety k (ι₁ ≫ sX)) (hdlt₁ : MMP.Intersection.IsDltPair (ι₁ ≫ sX) B₁)
    (hd₁ : topologicalKrullDim T₁ = (2 : ℕ))
    {T₂ : Scheme.{0}} [IsIntegral T₂] [IsLocallyNoetherian T₂] [IsNormal T₂]
    (ι₂ : T₂ ⟶ T₁) {B₂ : QDivisor T₂} (h₂' : IsAdjunctionStep (ι₁ ≫ sX) B₁ ι₂ B₂)
    {y : X} (resZ : X.presheaf.stalk y →+* T₂.functionField) (v : X.presheaf.stalk y)
    {F3 : Fin 3 → (letI := functionFieldAlgebra sX; Ω[X.functionField⁄k])}
    {F2 : Fin 2 → (letI := functionFieldAlgebra (ι₁ ≫ sX); Ω[T₁.functionField⁄k])}
    (φ : X.presheaf.stalk y → T₁.functionField)
    (hres1 : ∀ (g : X.presheaf.stalk y) (m : ℕ),
      letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ι₁ ≫ sX)
      IsPoincareResidue sX ι₁ 2 m
        (algebraMap _ X.functionField g • formPow (exteriorPower.ιMulti X.functionField 3 F3) m)
        (φ g • formPow (exteriorPower.ιMulti T₁.functionField 2 F2) m))
    (hres2 : ∀ (g : X.presheaf.stalk y) (m : ℕ),
      letI := functionFieldAlgebra (ι₁ ≫ sX); letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
      IsPoincareResidue (ι₁ ≫ sX) ι₂ 1 m
        (φ g • formPow (exteriorPower.ιMulti T₁.functionField 2 F2) m)
        (resZ g • formPow (exteriorPower.ιMulti T₂.functionField 1
          fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m)) :
    ∀ m : ℕ, 0 < m → ∀ K : Divisor X, K.IsCanonicalDivisor sX 3 →
      ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor →
      (∀ {S : Scheme.{0}} {ιS : S ⟶ X} {BS : QDivisor S}
        (F' : StratumAdjunctionData sX B ιS BS),
        haveI := F'.isIntegral_stratum
        haveI := F'.isNormal_stratum
        haveI := F'.isLocallyNoetherian_stratum
        ∃ (d : ℕ) (KS : Divisor S), KS.IsCanonicalDivisor (ιS ≫ sX) d ∧
          ((m : ℤ) • (Divisor.toQDivisor KS + BS)).IsCartierDivisor) →
      letI := functionFieldAlgebra sX; letI := functionFieldAlgebra ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX)
      ∀ ω : RationalPluriForms sX 3 m, ω ∈ logPluricanonicalSections sX 3 m B →
      ∀ g : X.presheaf.stalk y, ω = algebraMap _ X.functionField g •
        (show RationalPluriForms sX 3 m from
          formPow (exteriorPower.ιMulti X.functionField 3 F3) m) →
      (show RationalPluriForms ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX) 1 m from resZ g •
        formPow (exteriorPower.ιMulti T₂.functionField 1
          fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m) ∈
        logPluricanonicalSections ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX) 1 m B₂ := by
  intro m hm K hK hKc hcart
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (ι₁ ≫ sX)
  letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
  intro ω hω g hωg
  have hsT : (ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX = ι₂ ≫ ι₁ ≫ sX := by simp
  have hm0 : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  obtain ⟨ρa, hρa, hρamem⟩ := exists_isPoincareResidue_mem_logPluricanonicalSections hX
    (d := 2) (by rw [hd]) (fun P => hdlt.2.1 P) hK ⟨_, hm0, hKc⟩ h₁' (by norm_num) hm hω
  rw [hωg] at hρa
  have e1 := IsPoincareResidue.unique h₁' hρa (hres1 g m)
  obtain ⟨d₁, K₁, hK₁, hK₁c⟩ := hcart (.step (.refl hpair) ι₁ B₁ h₁)
  have hK₁' : K₁.IsCanonicalDivisor (ι₁ ≫ sX) d₁ := by simpa using hK₁
  have hd₁' : d₁ = 2 := by
    have := hK₁'.topologicalKrullDim_eq
    rw [hd₁] at this
    exact_mod_cast this.symm
  subst hd₁'
  obtain ⟨ρb, hρb, hρbmem⟩ := exists_isPoincareResidue_mem_logPluricanonicalSections hT₁nv
    (d := 1) (by rw [hd₁]) (fun P => hdlt₁.2.1 P) hK₁' ⟨_, hm0, hK₁c⟩ h₂' (by norm_num) hm
    hρamem
  rw [e1] at hρb
  have e2 := IsPoincareResidue.unique h₂' hρb (hres2 g m)
  rw [e2] at hρbmem
  exact mem_logPluricanonicalSections_of_heq hsT.symm
    (heq_smul_formPow_ιMulti_dlog hsT (resZ g) (fun _ => resZ v) m).symm hρbmem

/-- **The flag to a curve stratum, through a given floor divisor.** Let `(X, B)` be a dlt threefold
and `x` a point with snc coordinates `z₁, z₂` (local equations of the coefficient-one divisors
`L₁, L₂` through `x`, the only components of `Supp B` through `x`), completed by a unit `v` to a
frame of `Ω_{𝒪_{X,x}}`. There is a flag `X ⊃ L₁ ⊃ Z` of length two ending at the closure `Z` of
`x`, along which the iterated residue of `g (dlog z₁ ∧ dlog z₂ ∧ dlog v)^m` is `ḡ (dlog v̄)^m`, the
bars denoting restriction to `k(Z)`; moreover `div(dlog v̄) + B_Z` is the pull-back of
`div(dlog z₁ ∧ dlog z₂ ∧ dlog v) + B`. Unit multiples `g₀ Ω` restrict to `ḡ₀ dlog v̄` in the same
way. The first step of the flag is a given adjunction step `T₁ ⟶ X` onto `L₁`, and the second step
`T₂ ⟶ T₁` carries the residue of the form along `T₁` to its residue along the curve. -/
private theorem exists_flag_isIteratedResidueRec_of_curve_of_isAdjunctionStep {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX) [LocallyOfFiniteType sX]
    {B : QDivisor X} (hpair : Mori.IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B)
    (hd : topologicalKrullDim X = (3 : ℕ)) {x : X}
    (z : Fin 2 → X.presheaf.stalk x) (hz : IsRegularSystemOfParameters z)
    (v : X.presheaf.stalk x) (hvu : IsUnit v)
    (hw : letI := stalkAlgebra sX x
      Submodule.span (X.presheaf.stalk x) (Set.range fun a : Fin 3 =>
        KaehlerDifferential.D k (X.presheaf.stalk x) (![z 0, z 1, v] a)) = ⊤)
    (L : Fin 2 → Mori.PrimeDivisor X) (hL : Function.Injective L) (hLx : ∀ a, x ∈ (L a).support)
    (hLz : ∀ a, IdealSheafData.stalk (L a).idealSheaf x = Ideal.span {z a})
    (hBL : ∀ E : Mori.PrimeDivisor X, x ∈ E.support → B.coeff E ≠ 0 → E ∈ Set.range L)
    (hL1 : ∀ a, B.coeff (L a) = 1)
    (hQ : letI := functionFieldAlgebra sX
      (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
        formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
          (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
            KaehlerDifferential.D k X.functionField
              (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) 1)) +
        B).IsQCartier)
    {T₁ : Scheme.{0}} [IsIntegral T₁] [IsLocallyNoetherian T₁] (ι₁ : T₁ ⟶ X) {B₁ : QDivisor T₁}
    (h₁ : IsAdjunctionStep (𝟙 X ≫ sX) B ι₁ B₁) (hr₁ : Set.range ι₁.base = ((L 0).support : Set X))
    (hd₁ : topologicalKrullDim T₁ = (2 : ℕ)) :
    ∃ (T₂ : Scheme.{0}) (ιT : T₂ ⟶ X) (B₂ : QDivisor T₂) (F : StratumAdjunctionData sX B ιT B₂),
      F.length = 2 ∧ topologicalKrullDim T₂ = (1 : ℕ) ∧
      haveI := F.isIntegral_stratum
      ιT (genericPoint T₂) = x ∧ ∃ resZ : X.presheaf.stalk x →+* T₂.functionField,
        Function.Surjective resZ ∧
        (∀ r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x), resZ r = 0) ∧
        (letI := stalkAlgebra sX x; letI := functionFieldAlgebra (ιT ≫ sX)
          ∀ c : k, resZ (algebraMap k _ c) = algebraMap k _ c) ∧
        (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          ∀ (g : X.presheaf.stalk x) (m : ℕ), IsIteratedResidueRec
            (show RationalPluriForms sX 3 m from algebraMap _ X.functionField g •
              formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
                (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                  KaehlerDifferential.D k X.functionField
                    (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) m)
            F 1 (resZ g • (show RationalPluriForms (ιT ≫ sX) 1 m from
              formPow (exteriorPower.ιMulti T₂.functionField 1
                fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m))) ∧
        (∀ (h : x ⤳ ιT (genericPoint T₂)) (a : X.presheaf.stalk (ιT (genericPoint T₂))),
          resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιT.stalkMap (genericPoint T₂)).hom a) ∧
        (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          haveI : LocallyOfFiniteType (ιT ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
          haveI := F.isClosedImmersion
          haveI : CompactSpace T₂ := QuasiCompact.compactSpace_of_compactSpace ιT
          ∃ hgen, (Divisor.toQDivisor (divisorOfForm
            (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
              formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
                (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                  KaehlerDifferential.D k X.functionField
                    (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) 1)) +
            B).IsPullback ιT hgen (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms (ιT ≫ sX) 1 ((1 : ℕ) : ℤ) from
                formPow (exteriorPower.ιMulti T₂.functionField 1
                  fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) 1)) +
              B₂)) ∧
        (haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          MMP.Intersection.IsDltPair (ιT ≫ sX) B₂) ∧
        (∀ m : ℕ, 0 < m → ∀ K : Divisor X, K.IsCanonicalDivisor sX 3 →
          ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor →
          (∀ {S : Scheme.{0}} {ιS : S ⟶ X} {BS : QDivisor S}
            (F' : StratumAdjunctionData sX B ιS BS),
            haveI := F'.isIntegral_stratum
            haveI := F'.isNormal_stratum
            haveI := F'.isLocallyNoetherian_stratum
            ∃ (d : ℕ) (KS : Divisor S), KS.IsCanonicalDivisor (ιS ≫ sX) d ∧
              ((m : ℤ) • (Divisor.toQDivisor KS + BS)).IsCartierDivisor) →
          letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          ∀ ω : RationalPluriForms sX 3 m, ω ∈ logPluricanonicalSections sX 3 m B →
          ∀ g : X.presheaf.stalk x, ω = algebraMap _ X.functionField g •
            (show RationalPluriForms sX 3 m from formPow (exteriorPower.ιMulti X.functionField 3
              fun a => (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                KaehlerDifferential.D k X.functionField
                  (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) m) →
          (show RationalPluriForms (ιT ≫ sX) 1 m from resZ g •
            formPow (exteriorPower.ιMulti T₂.functionField 1
              fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m) ∈
            logPluricanonicalSections (ιT ≫ sX) 1 m B₂) ∧
        (∃ (ι₂ : T₂ ⟶ T₁) (_ : IsAdjunctionStep (ι₁ ≫ sX) B₁ ι₂ B₂), ιT = ι₂ ≫ ι₁ ≫ 𝟙 X ∧
          (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ι₁ ≫ sX)
            letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
            ∀ (g : X.presheaf.stalk x) (m : ℕ), ∃ ρ : RationalPluriForms (ι₁ ≫ sX) 2 m,
              IsPoincareResidue sX ι₁ 2 m (show RationalPluriForms sX 3 m from
                algebraMap _ X.functionField g • formPow (exteriorPower.ιMulti X.functionField 3
                  fun a => (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                    KaehlerDifferential.D k X.functionField
                      (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) m) ρ ∧
              IsPoincareResidue (ι₁ ≫ sX) ι₂ 1 m ρ
                (show RationalPluriForms (ι₂ ≫ ι₁ ≫ sX) 1 m from resZ g •
                  formPow (exteriorPower.ιMulti T₂.functionField 1
                    fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m))) ∧
        (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          haveI : LocallyOfFiniteType (ιT ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
          haveI := F.isClosedImmersion
          haveI : CompactSpace T₂ := QuasiCompact.compactSpace_of_compactSpace ιT
          ∀ g₀ : X.presheaf.stalk x, IsUnit g₀ →
          ∃ hgen, (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
              algebraMap _ X.functionField g₀ • formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
                (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                  KaehlerDifferential.D k X.functionField
                    (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) 1)) + B).IsPullback ιT hgen
            (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms (ιT ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ g₀ •
                formPow (exteriorPower.ιMulti T₂.functionField 1
                  fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) 1)) +
              B₂)) := by
  classical
  letI := functionFieldAlgebra sX
  have h₁' : IsAdjunctionStep sX B ι₁ B₁ := by have := h₁; rwa [Category.id_comp] at this
  have hT₁nv : IsNormalVariety k (ι₁ ≫ sX) := h₁'.1
  haveI : IsNormal T₁ := hT₁nv.2
  haveI : LocallyOfFiniteType (ι₁ ≫ sX) := hT₁nv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T₁ := LocallyOfFiniteType.isLocallyNoetherian (ι₁ ≫ sX)
  obtain ⟨-, -, -, -, hci₁, -⟩ := id h₁'
  haveI := hci₁
  haveI : CompactSpace T₁ := QuasiCompact.compactSpace_of_compactSpace ι₁
  have hdlt₁ := isDltPair_of_isAdjunctionStep hdlt hpair h₁ (L 0) (by rw [hL1 0]) hr₁
  obtain ⟨y₁, rfl⟩ : ∃ y, ι₁ y = x := by
    have : x ∈ Set.range ι₁.base := by rw [hr₁]; exact hLx 0
    exact this
  letI := functionFieldAlgebra (ι₁ ≫ sX)
  let τ1 : RationalPluriForms sX 3 ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti X.functionField 3
    fun a => (algebraMap (X.presheaf.stalk (ι₁ y₁)) X.functionField (![z 0, z 1, v] a))⁻¹ •
      KaehlerDifferential.D k X.functionField
        (algebraMap (X.presheaf.stalk (ι₁ y₁)) X.functionField (![z 0, z 1, v] a))) 1
  let ρ1 : RationalPluriForms (ι₁ ≫ sX) 2 ((1 : ℕ) : ℤ) := formPow (exteriorPower.ιMulti
    T₁.functionField 2 fun a =>
      (algebraMap (T₁.presheaf.stalk y₁) T₁.functionField
        (![(ι₁.stalkMap y₁).hom (z 1), (ι₁.stalkMap y₁).hom v] a))⁻¹ •
        KaehlerDifferential.D k T₁.functionField (algebraMap (T₁.presheaf.stalk y₁)
          T₁.functionField (![(ι₁.stalkMap y₁).hom (z 1), (ι₁.stalkMap y₁).hom v] a))) 1
  -- the first step: the curve `Z₁ ⊂ L₁` through `y₁`
  obtain ⟨Z₁, hZη, hZz, hB1Z, hord1, hτ1L, hτ10, ⟨U, hxU, hU⟩, ⟨hgenT, hpbT⟩, hzu⟩ :=
    exists_primeDivisor_curve_of_isAdjunctionStep hd ι₁ h₁' hd₁ z hz v hvu hw L hL hLx hLz hBL
      hL1 hr₁ τ1 rfl ρ1 rfl hQ
  have hy₁Z : y₁ ∈ Z₁.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← hZη]; exact subset_closure rfl
  have hkerZ : ∀ (y : T₁) (hy : y = Z₁.genericPoint), IdealSheafData.stalk Z₁.idealSheaf y =
      IsLocalRing.maximalIdeal (T₁.presheaf.stalk y) := by
    rintro y rfl; exact MMP.Resolution.Aux.stalk_idealSheaf_genericPoint Z₁
  have hv1u : IsUnit ((ι₁.stalkMap y₁).hom v) := hvu.map _
  have hres1 := fun (g : X.presheaf.stalk (ι₁ y₁)) (m : ℕ) =>
    isPoincareResidue_formPow_dlog_coordinate_of_notMem sX ι₁ (L 0) hr₁ y₁ ![z 0, z 1, v]
      (hLx 0) (hLz 0) hzu g m
  have hfun : ∀ (f : T₁.presheaf.stalk y₁ → T₁.functionField),
      (fun i : Fin 2 => (f ((ι₁.stalkMap y₁).hom (![z 0, z 1, v] i.succ)))⁻¹ •
        KaehlerDifferential.D k T₁.functionField
          (f ((ι₁.stalkMap y₁).hom (![z 0, z 1, v] i.succ)))) =
      fun a => (f (![(ι₁.stalkMap y₁).hom (z 1), (ι₁.stalkMap y₁).hom v] a))⁻¹ •
        KaehlerDifferential.D k T₁.functionField
          (f (![(ι₁.stalkMap y₁).hom (z 1), (ι₁.stalkMap y₁).hom v] a)) := by
    intro f; funext i; fin_cases i <;> rfl
  rw [hfun] at hres1
  -- the second step, onto the curve `Z₁`
  obtain ⟨T₂, ι₂, B₂, hpair2, h₂, hT₂i, hr₂, hd₂⟩ :=
    exists_isAdjunctionStep_of_isDltPair hT₁nv hdlt₁ (e := 1) hd₁ Z₁ (by rw [hB1Z])
  have h₂' : IsAdjunctionStep (ι₁ ≫ sX) B₁ ι₂ B₂ := by have := h₂; rwa [Category.id_comp] at this
  have h₂'' : IsAdjunctionStep ((ι₁ ≫ 𝟙 X) ≫ sX) B₁ ι₂ B₂ := by
    rw [Category.comp_id]; exact h₂'
  have hT₂nv : IsNormalVariety k (ι₂ ≫ ι₁ ≫ sX) := h₂'.1
  haveI : IsNormal T₂ := hT₂nv.2
  haveI : LocallyOfFiniteType (ι₂ ≫ ι₁ ≫ sX) := hT₂nv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T₂ := LocallyOfFiniteType.isLocallyNoetherian (ι₂ ≫ ι₁ ≫ sX)
  obtain ⟨-, -, -, -, hci₂, -⟩ := id h₂'
  haveI := hci₂
  have hy₂ : ι₂ (genericPoint T₂) = y₁ := by
    rw [map_genericPoint_eq_of_range_eq ι₂ Z₁ hr₂, hZη]
  subst hy₂
  -- the residue along `Z₁`
  have hzu₂ : ∀ i : Fin 1, (![(ι₁.stalkMap (ι₂ (genericPoint T₂))).hom (z 1),
      (ι₁.stalkMap (ι₂ (genericPoint T₂))).hom v] i.succ) ∉
      IdealSheafData.stalk Z₁.idealSheaf (ι₂ (genericPoint T₂)) := by
    intro i; fin_cases i
    rw [hkerZ _ hZη.symm]
    exact fun h => (IsLocalRing.mem_maximalIdeal _).1 h hv1u
  have hres2 := fun (g : T₁.presheaf.stalk (ι₂ (genericPoint T₂))) (m : ℕ) =>
    isPoincareResidue_formPow_dlog_coordinate_of_notMem (ι₁ ≫ sX) ι₂ Z₁ hr₂ (genericPoint T₂)
      (d := 1) ![(ι₁.stalkMap (ι₂ (genericPoint T₂))).hom (z 1),
        (ι₁.stalkMap (ι₂ (genericPoint T₂))).hom v] hy₁Z hZz hzu₂ g m
  letI : Algebra (T₂.presheaf.stalk (genericPoint T₂)) T₂.functionField :=
    AlgebraicGeometry.stalkFunctionFieldAlgebra T₂ (genericPoint T₂)
  let resZ : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂))) →+* T₂.functionField :=
    (algebraMap (T₂.presheaf.stalk (genericPoint T₂)) T₂.functionField).comp
      ((ι₂.stalkMap (genericPoint T₂)).hom.comp (ι₁.stalkMap (ι₂ (genericPoint T₂))).hom)
  have hres2c := fun (g : X.presheaf.stalk (ι₁ (ι₂ (genericPoint T₂)))) (m : ℕ) =>
    isPoincareResidue_smul_formPow_dlog_congr
      (hres2 ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom g) m) (c' := resZ g) rfl
      (f' := fun _ => resZ v) (fun i => by fin_cases i; rfl)
  have hfield : IsField (T₂.presheaf.stalk (genericPoint T₂)) := Field.toIsField T₂.functionField
  have hsT : (ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX = ι₂ ≫ ι₁ ≫ sX := by simp
  haveI : CompactSpace T₂ := QuasiCompact.compactSpace_of_compactSpace ι₂
  haveI : LocallyOfFiniteType ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX) := by rw [hsT]; infer_instance
  have hρ10 : ρ1 ≠ 0 := by
    intro h0; rw [h0, Mori.PrimeDivisor.ordForm_zero] at hord1; exact absurd hord1 (by decide)
  have hτU : ∀ E : Mori.PrimeDivisor X, ι₁ (ι₂ (genericPoint T₂)) ∈ E.support →
      (Divisor.toQDivisor (divisorOfForm τ1) + B).coeff E = 0 :=
    fun E hE => hU E ⟨_, hE, hxU⟩
  refine ⟨T₂, ι₂ ≫ ι₁ ≫ 𝟙 X, B₂, .step (.step (.refl hpair) ι₁ B₁ h₁) ι₂ B₂ h₂'', rfl, hd₂,
    by simp, resZ, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact ((IsFractionRing.surjective_iff_isField).2 hfield).comp
      ((ι₂.stalkMap_surjective _).comp (ι₁.stalkMap_surjective _))
  · intro r hr
    have h1 : ¬ IsUnit r := (IsLocalRing.mem_maximalIdeal _).1 hr
    have h2 : ¬ IsUnit ((ι₂.stalkMap (genericPoint T₂)).hom
        ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom r)) := fun hu =>
      h1 (isUnit_of_map_unit (ι₁.stalkMap (ι₂ (genericPoint T₂))).hom r
        (isUnit_of_map_unit (ι₂.stalkMap (genericPoint T₂)).hom _ hu))
    have h3 : (ι₂.stalkMap (genericPoint T₂)).hom
        ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom r) = 0 := by
      by_contra h0
      exact h2 (IsUnit.mk0 (show T₂.functionField from _) h0)
    simp only [resZ, RingHom.comp_apply, h3, map_zero]
  · intro c
    simp only [resZ, RingHom.comp_apply]
    rw [stalkMap_algebraMap_const sX ι₁ _ c, stalkMap_algebraMap_const (ι₁ ≫ sX) ι₂ _ c]
    letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
    haveI := isScalarTower_stalk_functionField (ι₂ ≫ ι₁ ≫ sX) (genericPoint T₂)
    rw [← IsScalarTower.algebraMap_apply]
    change (((Scheme.ΓSpecIso (.of k)).inv ≫ (ι₂ ≫ ι₁ ≫ sX).appTop ≫
      T₂.presheaf.germ ⊤ _ (TopologicalSpace.Opens.mem_top _)).hom c) =
      (((Scheme.ΓSpecIso (.of k)).inv ≫ ((ι₂ ≫ ι₁ ≫ 𝟙 X) ≫ sX).appTop ≫
        T₂.presheaf.germ ⊤ _ (TopologicalSpace.Opens.mem_top _)).hom c)
    rw [hsT]
  · intro g m
    letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
    exact isIteratedResidueRec_step_step hpair h₁ h₂'' (hres1 g m) (hres2c g m) _
      (heq_smul_formPow_ιMulti_dlog hsT (resZ g) (fun _ => resZ v) m)
  · intro h a
    simp only [resZ, RingHom.comp_apply]
    rw [stalkMap_stalkMap_stalkSpecializes ι₂ ι₁ _ h a]
    exact algebraMap_stalk_genericPoint_apply T₂ _
  · letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
    have h1 := hres1 1 1
    simp only [map_one, one_smul] at h1
    have h2 := hres2c 1 1
    simp only [map_one, one_smul] at h2
    exact exists_isPullback_comp_of_isPoincareResidue hd ι₁ h₁' (L 0) hr₁ hd₁ ι₂ h₂' Z₁ hr₂ hτ10
      hτ1L hQ hτU hρ10 hord1
      (heq_formPow_ιMulti_dlog_of_eq hsT (fun _ => resZ v) (fun _ => resZ v) (fun _ => rfl) 1)
      h1 h2
  · have hdlt₂ := isDltPair_of_isAdjunctionStep hdlt₁ hpair2 h₂ Z₁ (by rw [hB1Z]) hr₂
    rw [hsT]; exact hdlt₂
  · exact smul_formPow_mem_logPluricanonicalSections_of_curve_flag hX hpair hdlt hd ι₁ h₁ h₁'
      hT₁nv hdlt₁ hd₁ ι₂ h₂' resZ v
      (fun g => algebraMap _ T₁.functionField ((ι₁.stalkMap (ι₂ (genericPoint T₂))).hom g))
      hres1 hres2c
  · letI := functionFieldAlgebra (ι₂ ≫ ι₁ ≫ sX)
    exact ⟨ι₂, h₂', rfl, fun g m => ⟨_, hres1 g m, hres2c g m⟩⟩
  · exact exists_isPullback_unit_smul_of_curve_flag hX hpair hd ι₁ h₁' (L 0) hr₁ hd₁ ι₂ h₂' Z₁
      hr₂ hZη (hLx 0) hτU hτ10 hτ1L hρ10 hord1 resZ v (fun g => hres1 g 1) (fun g => hres2c g 1)

/-- **The flag to a curve stratum.** Let `(X, B)` be a dlt threefold and `x` a point with snc
coordinates `z₁, z₂` (local equations of the coefficient-one divisors `L₁, L₂` through `x`, the
only components of `Supp B` through `x`), completed by a unit `v` to a frame of `Ω_{𝒪_{X,x}}`.
There is a flag `X ⊃ L₁ ⊃ Z` of length two ending at the closure `Z` of `x`, along which the
iterated residue of `g (dlog z₁ ∧ dlog z₂ ∧ dlog v)^m` is `ḡ (dlog v̄)^m`, the bars denoting
restriction to `k(Z)`; moreover `div(dlog v̄) + B_Z` is the pull-back of
`div(dlog z₁ ∧ dlog z₂ ∧ dlog v) + B`. -/
private theorem exists_flag_isIteratedResidueRec_of_curve {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX) [LocallyOfFiniteType sX]
    {B : QDivisor X} (hpair : Mori.IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B)
    (hd : topologicalKrullDim X = (3 : ℕ)) {x : X}
    (z : Fin 2 → X.presheaf.stalk x) (hz : IsRegularSystemOfParameters z)
    (v : X.presheaf.stalk x) (hvu : IsUnit v)
    (hw : letI := stalkAlgebra sX x
      Submodule.span (X.presheaf.stalk x) (Set.range fun a : Fin 3 =>
        KaehlerDifferential.D k (X.presheaf.stalk x) (![z 0, z 1, v] a)) = ⊤)
    (L : Fin 2 → Mori.PrimeDivisor X) (hL : Function.Injective L) (hLx : ∀ a, x ∈ (L a).support)
    (hLz : ∀ a, IdealSheafData.stalk (L a).idealSheaf x = Ideal.span {z a})
    (hBL : ∀ E : Mori.PrimeDivisor X, x ∈ E.support → B.coeff E ≠ 0 → E ∈ Set.range L)
    (hL1 : ∀ a, B.coeff (L a) = 1)
    (hQ : letI := functionFieldAlgebra sX
      (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
        formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
          (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
            KaehlerDifferential.D k X.functionField
              (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) 1)) +
        B).IsQCartier) :
    ∃ (T₂ : Scheme.{0}) (ιT : T₂ ⟶ X) (B₂ : QDivisor T₂) (F : StratumAdjunctionData sX B ιT B₂),
      F.length = 2 ∧ topologicalKrullDim T₂ = (1 : ℕ) ∧
      haveI := F.isIntegral_stratum
      ιT (genericPoint T₂) = x ∧ ∃ resZ : X.presheaf.stalk x →+* T₂.functionField,
        Function.Surjective resZ ∧
        (∀ r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x), resZ r = 0) ∧
        (letI := stalkAlgebra sX x; letI := functionFieldAlgebra (ιT ≫ sX)
          ∀ c : k, resZ (algebraMap k _ c) = algebraMap k _ c) ∧
        (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          ∀ (g : X.presheaf.stalk x) (m : ℕ), IsIteratedResidueRec
            (show RationalPluriForms sX 3 m from algebraMap _ X.functionField g •
              formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
                (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                  KaehlerDifferential.D k X.functionField
                    (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) m)
            F 1 (resZ g • (show RationalPluriForms (ιT ≫ sX) 1 m from
              formPow (exteriorPower.ιMulti T₂.functionField 1
                fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m))) ∧
        (∀ (h : x ⤳ ιT (genericPoint T₂)) (a : X.presheaf.stalk (ιT (genericPoint T₂))),
          resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιT.stalkMap (genericPoint T₂)).hom a) ∧
        (letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          haveI : LocallyOfFiniteType (ιT ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
          haveI := F.isClosedImmersion
          haveI : CompactSpace T₂ := QuasiCompact.compactSpace_of_compactSpace ιT
          ∃ hgen, (Divisor.toQDivisor (divisorOfForm
            (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
              formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
                (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                  KaehlerDifferential.D k X.functionField
                    (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) 1)) +
            B).IsPullback ιT hgen (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms (ιT ≫ sX) 1 ((1 : ℕ) : ℤ) from
                formPow (exteriorPower.ιMulti T₂.functionField 1
                  fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) 1)) +
              B₂)) ∧
        (haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          MMP.Intersection.IsDltPair (ιT ≫ sX) B₂) ∧
        (∀ m : ℕ, 0 < m → ∀ K : Divisor X, K.IsCanonicalDivisor sX 3 →
          ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor →
          (∀ {S : Scheme.{0}} {ιS : S ⟶ X} {BS : QDivisor S}
            (F' : StratumAdjunctionData sX B ιS BS),
            haveI := F'.isIntegral_stratum
            haveI := F'.isNormal_stratum
            haveI := F'.isLocallyNoetherian_stratum
            ∃ (d : ℕ) (KS : Divisor S), KS.IsCanonicalDivisor (ιS ≫ sX) d ∧
              ((m : ℤ) • (Divisor.toQDivisor KS + BS)).IsCartierDivisor) →
          letI := functionFieldAlgebra sX; letI := functionFieldAlgebra (ιT ≫ sX)
          haveI := F.isLocallyNoetherian_stratum; haveI := F.isNormal_stratum
          ∀ ω : RationalPluriForms sX 3 m, ω ∈ logPluricanonicalSections sX 3 m B →
          ∀ g : X.presheaf.stalk x, ω = algebraMap _ X.functionField g •
            (show RationalPluriForms sX 3 m from formPow (exteriorPower.ιMulti X.functionField 3
              fun a => (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))⁻¹ •
                KaehlerDifferential.D k X.functionField
                  (algebraMap (X.presheaf.stalk x) X.functionField (![z 0, z 1, v] a))) m) →
          (show RationalPluriForms (ιT ≫ sX) 1 m from resZ g •
            formPow (exteriorPower.ιMulti T₂.functionField 1
              fun _ => (resZ v)⁻¹ • KaehlerDifferential.D k T₂.functionField (resZ v)) m) ∈
            logPluricanonicalSections (ιT ≫ sX) 1 m B₂) := by
  obtain ⟨T₁, ι₁, B₁, -, h₁, hT₁i, hr₁, hd₁⟩ :=
    exists_isAdjunctionStep_of_isDltPair hX hdlt (e := 2) hd (L 0) (by rw [hL1 0])
  haveI := hT₁i
  have h₁' : IsAdjunctionStep sX B ι₁ B₁ := by have := h₁; rwa [Category.id_comp] at this
  have hT₁nv : IsNormalVariety k (ι₁ ≫ sX) := h₁'.1
  haveI : LocallyOfFiniteType (ι₁ ≫ sX) := hT₁nv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian T₁ := LocallyOfFiniteType.isLocallyNoetherian (ι₁ ≫ sX)
  obtain ⟨T₂, ιT, B₂, F, h1, h2, h3, resZ, h4, h5, h6, h7, h8, h9, h10, h11, -, -⟩ :=
    exists_flag_isIteratedResidueRec_of_curve_of_isAdjunctionStep hX hpair hdlt hd z hz v hvu hw L
      hL hLx hLz hBL hL1 hQ ι₁ h₁ hr₁ hd₁
  exact ⟨T₂, ιT, B₂, F, h1, h2, h3, resZ, h4, h5, h6, h7, h8, h9, h10, h11⟩

/-- A point of an integral scheme whose stalk is a field is the generic point. -/
private theorem eq_genericPoint_of_isField_stalk {Y : Scheme.{0}} [IsIntegral Y] {y : Y}
    (h : IsField (Y.presheaf.stalk y)) : y = genericPoint Y := by
  letI := h.toField
  have h0 : ringKrullDim (Y.presheaf.stalk y) = 0 := ringKrullDim_eq_zero_of_field _
  rw [ringKrullDim_stalk_eq_coheight] at h0
  have h1 : Order.coheight y = 0 := by exact_mod_cast h0
  rw [Order.coheight_eq_zero] at h1
  have h2 : y ≤ genericPoint Y :=
    (Scheme.le_iff_specializes).2 ((genericPoint_spec Y).specializes trivial)
  exact ((Scheme.le_iff_specializes).1 (h1 h2)).antisymm
    ((Scheme.le_iff_specializes).1 h2) |>.eq

/-- **Crepancy of the identification of a curve stratum with the centre of an lc place.** Let
`σ : (X, B) ⇢ (X', B')` be a crepant birational map of normal threefolds proper over `k`, `T ⊂ X`
a floor divisor `P` whose valuation is that of a divisor `D` over `X'` with centre the generic
point `x` of a curve, and `τ'` a rational top form on `X'` with `div τ' + B' = 0` near `x`. Let
`ρ` be the residue of `σ^*τ'` along `T`, `T_C ⊂ T` a floor curve `C` along which `ρ` has a simple
pole with residue `θ_C`, and `T_Z ⟶ X'` a closed stratum through `x` on which `div τ' + B'`
restricts to `div θ_Z + B_Z`. If `λ : k(T_Z) → k(T)` is induced by `σ`, lands in `𝒪_{T,C}^×`, and
`φ : k(T_Z) ≅ k(T_C)` is `λ` followed by restriction to `C`, with `φ^*θ_Z = θ_C`, then `φ` is a
crepant birational map `(T_C, B_C) ⇢ (T_Z, B_Z)`: on the normalization `N` of the strict
transform of `C` on the normalization of the strict transform of `T` on a common model `W`, both
adjoint divisors pull back to the restriction of `p^*(K_X + B) = q^*(K_{X'} + B')`. -/
private theorem isCrepantBirationalMap_of_residue_curve {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k]
    {X X' T TC TZ : Scheme.{0}} {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    [IsProper sX] [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X'] [CompactSpace X']
    [LocallyOfFiniteType sX'] [IsProper sX']
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX')
    (hn : topologicalKrullDim X = (3 : ℕ)) (hn' : topologicalKrullDim X' = (3 : ℕ))
    {B : QDivisor X} {B' : QDivisor X'} {K : Divisor X} {K' : Divisor X'}
    (hK : K.IsCanonicalDivisor sX 3) (hK' : K'.IsCanonicalDivisor sX' 3)
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) (hKB' : (Divisor.toQDivisor K' + B').IsQCartier)
    (σ : FunctionFieldEquiv sX sX') (hσ : IsCrepantBirationalMap sX sX' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    {ι : T ⟶ X} [IsClosedImmersion ι] {BT : QDivisor T} (hι : IsAdjunctionStep sX B ι BT)
    (P : Mori.PrimeDivisor X) (hrP : Set.range ι.base = (P.support : Set X))
    (hP1 : B.coeff P = 1) (D : DivisorOver k sX')
    (hDv : ∀ g, D.valuation g = P.divisorialValuation ((σ.toHom) g))
    {τ' : RationalPluriForms sX' 3 1} (hτ'0 : τ' ≠ 0) (U : X'.Opens)
    (hxU : D.f D.E.genericPoint ∈ U)
    (hU : ∀ E : Mori.PrimeDivisor X', (E.support ∩ (U : Set X')).Nonempty →
      (Divisor.toQDivisor (divisorOfForm τ') + B').coeff E = 0)
    {ρ : RationalPluriForms (ι ≫ sX) 2 1}
    (hρres : IsPoincareResidue sX ι 2 1 (pluriformPullback sX sX' σ.toHom 3 1 τ') ρ)
    [IsIntegral TC] [IsLocallyNoetherian TC] [IsNormal TC] [CompactSpace TC]
    {jC : TC ⟶ T} [IsClosedImmersion jC] {BC : QDivisor TC}
    (hjC : IsAdjunctionStep (ι ≫ sX) BT jC BC) (C : Mori.PrimeDivisor T)
    (hrC : Set.range jC.base = (C.support : Set T)) (hρC : C.ordForm ρ = -1)
    {θC : RationalPluriForms (jC ≫ ι ≫ sX) 1 1} (hθC : IsPoincareResidue (ι ≫ sX) jC 1 1 ρ θC)
    [IsIntegral TZ] [IsLocallyNoetherian TZ] [IsNormal TZ] [CompactSpace TZ]
    {ιZ : TZ ⟶ X'} [IsClosedImmersion ιZ] {BZ : QDivisor TZ}
    (hZ : IsNormalVariety k (ιZ ≫ sX')) (hdZ : topologicalKrullDim TZ = (1 : ℕ))
    (hZη : ιZ (genericPoint TZ) = D.f D.E.genericPoint)
    {θZ : RationalPluriForms (ιZ ≫ sX') 1 1} (hθZ0 : θZ ≠ 0)
    (hpbZ : ∃ hgen, (Divisor.toQDivisor (divisorOfForm τ') + B').IsPullback ιZ hgen
      (Divisor.toQDivisor (divisorOfForm θZ) + BZ))
    (lam : TZ.functionField →+* T.functionField)
    (ψ : X'.presheaf.stalk (ιZ (genericPoint TZ)) →+* X.presheaf.stalk (ι (genericPoint T)))
    (hψ : ∀ a, algebraMap _ X.functionField (ψ a) = (σ.toHom) (algebraMap _ X'.functionField a))
    (hlam : ∀ a, lam ((ιZ.stalkMap (genericPoint TZ)).hom a) =
      (ι.stalkMap (genericPoint T)).hom (ψ a))
    (hlamC : ∀ c, c ≠ 0 → C.divisorialValuation (lam c) = 1)
    (μ3 : TZ.functionField →+* T.presheaf.stalk (jC (genericPoint TC)))
    (hμ3 : ∀ c, algebraMap _ T.functionField (μ3 c) = lam c)
    {sC : TC ⟶ Spec (.of k)} (hsC : jC ≫ ι ≫ sX = sC)
    (φ : FunctionFieldEquiv sC (ιZ ≫ sX'))
    (hφ : ∀ c, φ c = (jC.stalkMap (genericPoint TC)).hom (μ3 c))
    (hθ : HEq θC (pluriformPullback sC (ιZ ≫ sX') φ.toHom 1 1 θZ)) :
    IsCrepantBirationalMap sC (ιZ ≫ sX') BC BZ φ := by
  classical
  subst hsC
  have hθ' := eq_of_heq hθ
  have hT := hι.1
  haveI : LocallyOfFiniteType (ι ≫ sX) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim T = (2 : ℕ) :=
    topologicalKrullDim_eq_of_range_eq_support sX ι P hrP hn
