  have hpsp : pW (νN (genericPoint N)) ⤳ jY Q (genericPoint (CY Q)) := by rw [hpν]
  have hFF : ∀ a : TZ.functionField, functionFieldMap πN a = functionFieldMap αN (lam a) := by
    intro a
    obtain ⟨r, rfl⟩ := hresZs a
    have h1 : ιZ (genericPoint TZ) ⤳ D.f D.E.genericPoint := by rw [hgenZ]
    have h2 : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ) := by rw [hgenZ]
    have h3 : qW (νN (genericPoint N)) ⤳ D.f D.E.genericPoint := by rw [hqν]
    have hp : qW (νN (genericPoint N)) ⤳ ιZ (genericPoint TZ) := by rw [hqν, hgenZ]
    have e0 : (X.presheaf.stalkSpecializes h2).hom ((X.presheaf.stalkSpecializes h1).hom r) = r := by
