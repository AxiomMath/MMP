  let V0 : TZ.Opens := ⟨(⋃ E ∈ Sbad, (E.support : Set TZ))ᶜ, hScl.isOpen_compl⟩
  have hV0 : V0 = ⟨(⋃ E ∈ Sbad, (E.support : Set TZ))ᶜ, hScl.isOpen_compl⟩ := rfl
