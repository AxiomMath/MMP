  have hqG := CrepantModelAux.isQCartier_of_isPullback hqT hpbG
  -- the normalization `C_N'` of `Γ_N`, and the lift `β : C_N' ⟶ G`
  obtain ⟨CN', _, νC, hCNv', hνCP, hνCη, hνCsurj⟩ :=
    CrepantModelAux.exists_normalization_primeDivisor' hNα CN
