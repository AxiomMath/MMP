  obtain ⟨gT, hgT⟩ := hgTex
  have hres_t := isPoincareResidue_pluriformPullback_of_eq_smul_formPow_dlog St.hdimY St.hdimX
    (jY Q) σ.toHom z3 t e' he' ht hfr m g gT hgT _ _ _ (hresid g gT hgT) he'0 he'1' τ hg
  have ht'Q := huniq _ hres_t
  refine ⟨σ, hσc, hσ, D, hv, hDp, ha, hcd, P, TZ, ι₂, BZ, h₂, ιZ, FZ, hιZ, hdimZ, hgenZ, z, v, g,
    resZ, lam, eb, hresZs, hresZm, hresZk, hstalkZ, hlamk, ⟨hgen', htr⟩, hresid, hvu, hwZ', hρP2,
    ht'Q, hτ'0, ⟨U, hxU, hU⟩, hρres, hpbZu, hdltZ⟩

open scoped WithZero in
