  obtain ⟨hgenZs, hpbZs⟩ := hpbZu 1 isUnit_one
  have hΩ1 : (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
