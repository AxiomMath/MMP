      hpsp (genericPoint N) ((X.presheaf.stalkSpecializes h3).hom r) gP hgP'
    rw [hresid r gP hgP] at hc
    rw [← hc, CrepantModelAux.algebraMap_stalk_genericPoint_apply]
  -- the strict transform `Γ_N` of `Γ`: `coeff_{Γ_N} H = ord_Γ θ_s + 1`
