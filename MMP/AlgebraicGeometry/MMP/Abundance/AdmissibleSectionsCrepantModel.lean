  obtain ⟨D₀', hD₀', hpb₀⟩ := hHπ _ hm₀ D₀ hD₀ hD₀c
  obtain ⟨U₁, hzU₁, φ₁, hφ₁⟩ := hD₀c (πN CN.genericPoint)
  have hcCN := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hpb₀ hφ₁ CN hzU₁
    ⟨_, CrepantModelAux.univ_mem_irreducibleComponents TZ⟩
  set f₁ := MMP.Threefold.Mori.Helpers.evalFF ⟨_, CrepantModelAux.univ_mem_irreducibleComponents TZ⟩
    (φ₁ : RationalFunctions TZ) with hf₁
  have hf₁0 : f₁ ≠ 0 := (φ₁.isUnit.map _).ne_zero
  have hlf₁ : lam f₁ ≠ 0 := (map_ne_zero lam).2 hf₁0
  have hcoeff0 : D₀'.coeff CN = 0 := by
    rw [hcCN, hFF]
    have h1 := CN.divisorialValuation_eq_exp_neg_ord ((map_ne_zero (functionFieldMap αN)).2 hlf₁)
    rw [hCNv, ← hμ, hhor f₁ hf₁0, ← WithZero.exp_zero] at h1
    have := WithZero.exp_injective h1
    omega
  have hHCN : H.coeff CN = 0 := by
    have h := congrArg (fun F : QDivisor N => F.coeff CN) hD₀'
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul, hcoeff0,
      Int.cast_zero] at h
    rw [hHeq]
    have hm₀q : (HZ.cartierIndex hqZ : ℚ) ≠ 0 := by exact_mod_cast hm₀.ne'
    exact (mul_eq_zero.1 h.symm).resolve_left hm₀q
  have hordθ : Γ.ordForm θv = -1 := by
    rw [hHCN] at hcoeffCN
    have : ((Γ.ordForm θv : ℤ) : ℚ) = -1 := by linarith only [hcoeffCN]
    exact_mod_cast this
  exact ⟨hρs0, hordθ⟩

open scoped WithZero in
open exteriorPower in
/-- In the horizontal case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
valuation of `Γ` is the `ẽ`-adic valuation of `k(C_Q) = K(ẽ)` for `ẽ = ē^{±1}`, with residue
field `λ(k(T_Z))`. -/
private theorem exists_uniformizer_of_isExceptionalOverCurve_of_horizontal
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (_ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX)
      (_ : MMP.Mori.IsDiscrepancy sX (2 + 1) KX B D (-1)),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (_ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀
          (_ : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : IsUnit v)
          (_ : X.Opens)
          (Γ : Mori.PrimeDivisor (CY Q))
          (_ : ∀ c : TZ.functionField, c ≠ 0 → Γ.divisorialValuation (lam c) = 1)
          (_ : (show RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
              (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) 1) ≠ 0)
          (_ : Γ.ordForm (show RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
              (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) 1) = -1),
          ∃ et : (CY Q).functionField, (et = eb ∨ et = eb⁻¹) ∧ Γ.divisorialValuation et < 1 ∧
            Γ.divisorialValuation et = WithZero.exp (-1) ∧ ∀ f, Γ.divisorialValuation f ≤ 1 →
              ∃ c : TZ.functionField, Γ.divisorialValuation (f - lam c) < 1 := by
  intro σ D ha P TZ ι₂ BZ ιZ FZ z v g resZ lam eb hlamk hgentr hvu U Γ hhor hρs0 hordθ
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  set vb : TZ.functionField := resZ v with hvb
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  set ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
      (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] with hωv
  set θv : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωv 1 with hθv
  have hord_of : ∀ f : (CY Q).functionField, f ≠ 0 → μ f = 1 →
      (CY Q).ord f Γ.genericPoint = 0 := by
    intro f hf h1
    rw [hμ, Γ.divisorialValuation_eq_exp_neg_ord hf, ← WithZero.exp_zero] at h1
    have := WithZero.exp_injective h1
    omega
  -- `ē` is not a unit along `Γ`
  have heb0 : eb ≠ 0 := fun h0 => htr (h0 ▸ isAlgebraic_zero)
  have hlv0 : lam vb ≠ 0 := (map_ne_zero lam).2 hvb0
  have hlv : μ (lam vb) = 1 := hhor vb hvb0
  have hnotunit : μ eb ≠ 1 := by
    intro he1
    obtain ⟨a, ha⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Γ rfl
      (f := eb) he1.le
    obtain ⟨b, hb⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Γ rfl
      (f := lam vb) hlv.le
    have hsplit := CrepantModelAux.formPow_ιMulti_dlog_eq_smul (k := ℂ)
      (K := (CY Q).functionField) (d := 2) ![eb, lam vb] 1
    have hvecfun : (fun i => ((![eb, lam vb] : Fin 2 → (CY Q).functionField) i)⁻¹ •
        KaehlerDifferential.D ℂ (CY Q).functionField
          ((![eb, lam vb] : Fin 2 → (CY Q).functionField) i)) =
        ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
          (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] := by
      funext i; fin_cases i <;> rfl
    rw [hvecfun] at hsplit
    have hreg0 := CrepantModelAux.zero_le_ordForm_formPow_ιMulti_D (sX := jY Q ≫ sY) Γ hdT 1
      ![a, b]
    have hfunD : (fun i => KaehlerDifferential.D ℂ (CY Q).functionField
        (algebraMap Γ.localRing (CY Q).functionField ((![a, b] : Fin 2 → Γ.localRing) i))) =
        fun i => KaehlerDifferential.D ℂ (CY Q).functionField
          ((![eb, lam vb] : Fin 2 → (CY Q).functionField) i) := by
      funext i; fin_cases i
      · exact congrArg _ ha
      · exact congrArg _ hb
    rw [hfunD] at hreg0
    let δD : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) :=
      formPow (exteriorPower.ιMulti (CY Q).functionField 2 fun i =>
        KaehlerDifferential.D ℂ (CY Q).functionField
          ((![eb, lam vb] : Fin 2 → (CY Q).functionField) i)) 1
    have hδD : δD = 
      formPow (exteriorPower.ιMulti (CY Q).functionField 2 fun i =>
        KaehlerDifferential.D ℂ (CY Q).functionField
          ((![eb, lam vb] : Fin 2 → (CY Q).functionField) i)) 1 := rfl
    have hsplit' : θv = ((∏ i, (![eb, lam vb] : Fin 2 → (CY Q).functionField) i)⁻¹) ^ 1 • δD :=
      hsplit
    have hD0 : δD ≠ 0 := by
      intro h0; apply hρs0; rw [hsplit', h0, smul_zero]
    have hprod0 : ((∏ i, (![eb, lam vb] : Fin 2 → (CY Q).functionField) i)⁻¹) ^ 1 ≠ 0 := by
      rw [Fin.prod_univ_two]
      exact pow_ne_zero _ (inv_ne_zero (mul_ne_zero heb0 hlv0))
    have hge : 0 ≤ Γ.ordForm θv := by
      rw [hsplit', Γ.ordForm_smul_of_topologicalKrullDim_eq hdT hprod0 hD0, Fin.prod_univ_two,
        pow_one, ← zpow_neg_one]
      have e0 : (![eb, lam vb] : Fin 2 → (CY Q).functionField) 0 *
          (![eb, lam vb] : Fin 2 → (CY Q).functionField) 1 = eb * lam vb := rfl
      rw [e0, ord_zpow _ (mul_ne_zero heb0 hlv0), Scheme.ord_mul heb0 hlv0,
        hord_of eb heb0 he1, hord_of _ hlv0 hlv]
      have h0 : 0 ≤ Γ.ordForm δD := hreg0
      omega
    rw [hordθ] at hge
    omega
  -- `Γ` is the `ẽ`-adic place for `ẽ = ē^{±1}`
  obtain ⟨et, het, hetlt⟩ : ∃ e' : (CY Q).functionField, (e' = eb ∨ e' = eb⁻¹) ∧ μ e' < 1 := by
    rcases lt_or_gt_of_ne hnotunit with h | h
    · exact ⟨eb, Or.inl rfl, h⟩
    · refine ⟨eb⁻¹, Or.inr rfl, ?_⟩
      rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ h
  have htret : Transcendental TZ.functionField et := by
    rcases het with rfl | rfl
    · exact htr
    · exact fun halg => htr (IsAlgebraic.inv_iff.1 halg)
  have hgenet : IntermediateField.adjoin TZ.functionField {et} = ⊤ := by
    rcases het with rfl | rfl
    · exact hgen'
    · rw [CrepantModelAux.adjoin_simple_inv_eq]; exact hgen'
  haveI : Algebra.EssFiniteType ℂ TZ.functionField := essFiniteType_functionField (sX := ιZ ≫ sX)
  obtain ⟨ν₀, hν₀k, hν₀e, hν₀res, -⟩ :=
    CrepantModelAux.exists_valuation_of_transcendental (k := ℂ) htret hgenet
  have hequiv := CrepantModelAux.valuation_isEquiv_of_transcendental htret hgenet (w₁ := μ)
    (w₂ := ν₀) (fun c hc => hhor c hc) hν₀k hetlt
    (by rw [hν₀e, ← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num)
  haveI := Γ.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible Γ.localRing
  have hμν : μ = ν₀ := CrepantModelAux.eq_of_isEquiv_of_exp_neg_one' hequiv
    ⟨_, Γ.divisorialValuation_algebraMap_of_irreducible hϖ⟩ ⟨et, hν₀e⟩
  have hμet : μ et = WithZero.exp (-1) := by rw [hμν]; exact hν₀e
  have hμres : ∀ f, μ f ≤ 1 → ∃ c : TZ.functionField, μ (f - lam c) < 1 := by
    rw [hμν]; exact hν₀res
  exact ⟨et, het, hetlt, hμet, hμres⟩

open scoped WithZero in
open exteriorPower in
/-- In the horizontal case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
residue field of `Γ` is `k(T_Z)` through a lift `μ₃` of `λ` to the stalk, and the residue of
`(dlog ẽ ∧ dlog λ(v̄))^{⊗a}` along `G` is `(dlog φ₀(v̄))^{⊗a}`. -/
private theorem exists_residue_field_equiv_of_isExceptionalOverCurve_of_horizontal
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q)
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (_ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (ι₂ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀ (_ : ιZ = ι₂ ≫ jX P ≫ 𝟙 X)
          (_ : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : IsUnit v)
          (_ : X.Opens)
          (Γ : Mori.PrimeDivisor (CY Q)) (_ : j (genericPoint G) = Γ.genericPoint)
          (_ : ∀ c : TZ.functionField, c ≠ 0 → Γ.divisorialValuation (lam c) = 1)
          (et : (CY Q).functionField)
          (_ : et = eb ∨ et = eb⁻¹)
          (_ : Γ.divisorialValuation et < 1)
          (_ : Γ.divisorialValuation et = WithZero.exp (-1))
          (_ : ∀ f, Γ.divisorialValuation f ≤ 1 →
            ∃ c : TZ.functionField, Γ.divisorialValuation (f - lam c) < 1),
          ∃ (μ3 : TZ.functionField →+* (CY Q).presheaf.stalk (j (genericPoint G)))
            (φ : FunctionFieldEquiv ((j ≫ 𝟙 (CY Q)) ≫ jY Q ≫ sY) (ιZ ≫ sX))
            (ψ : FunctionFieldEquiv ((j ≫ 𝟙 (CY Q)) ≫ jY Q ≫ sY) ((ι₂ ≫ 𝟙 (CX P)) ≫ jX P ≫ sX)) (εc
                : ℂ),
            (∀ c, algebraMap _ (CY Q).functionField (μ3 c) = lam c) ∧
            (∀ c, φ c = (j.stalkMap (genericPoint G)).hom (μ3 c)) ∧
            (∀ c, ψ c = (j.stalkMap (genericPoint G)).hom (μ3 c)) ∧
            (εc = 1 ∨ εc = -1) ∧
            (exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))] =
              algebraMap ℂ (CY Q).functionField εc • exteriorPower.ιMulti (CY Q).functionField 2
              ![et⁻¹ • KaehlerDifferential.D ℂ _ et,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) ∧
            (letI := functionFieldAlgebra (j ≫ jY Q ≫ sY); ∀ a : ℕ,
              IsPoincareResidue (jY Q ≫ sY) j 1 a (formPow (exteriorPower.ιMulti (CY
                  Q).functionField 2
              ![et⁻¹ • KaehlerDifferential.D ℂ _ et,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) a)
                (formPow (exteriorPower.ιMulti G.functionField 1 fun _ =>
                  ((j.stalkMap (genericPoint G)).hom (μ3 (resZ v)))⁻¹ •
                    KaehlerDifferential.D ℂ G.functionField ((j.stalkMap (genericPoint G)).hom (μ3
                        (resZ v)))) a)) := by
  intro σ D P TZ ι₂ BZ ιZ FZ hιZ z v g resZ lam eb hlamk hgentr hvu U Γ hΓ hhor et het hetlt hμet
    hμres
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  obtain ⟨-, -, -, -, -, -, -, -, hC1, -⟩ := hcurveQ
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmY
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  have hKBX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmX
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  haveI : IsNoetherian (CY Q) := {}
  haveI : IsNoetherian X := {}
  set vb : TZ.functionField := resZ v with hvb
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  set ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
      (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] with hωv
  have heb0 : eb ≠ 0 := fun h0 => htr (h0 ▸ isAlgebraic_zero)
  have hlv : μ (lam vb) = 1 := hhor vb hvb0
  -- the stalk of `C_Q` along `Γ`: the lift `μ₃` of `λ`, the uniformizer `ẽ`
  have hrΓ : Set.range j.base = (Γ.support : Set (CY Q)) := by
