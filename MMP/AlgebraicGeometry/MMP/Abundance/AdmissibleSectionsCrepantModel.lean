open CategoryTheory AlgebraicGeometry

namespace MMP.Fourfold

open MMP.Mori

open Proof_lem_fourfold_admissible_boundary_crepant_model_independence in
/-- **Floor sections are independent of the crepant model.** Let `(X, B)` and `(Y, C)` be rational
(`MMP.Fourfold.IsPair`) `ℚ`-factorial projective complex pairs of dimension `n + 1 ≤ 3`. Each is
dlt (`MMP.Intersection.IsDltPair`), or log canonical with `(·, B - δ⌊B⌋)` klt for some `δ > 0`.
Suppose they are crepant birational through a normal variety `W` with proper birational
`p : W ⟶ X`, `q : W ⟶ Y` and a common crepant boundary `B_W` (`MMP.Mori.IsCrepantBoundary`).
Let `m` be even with `m(K_X + B)` and `m(K_Y + C)` Cartier. Let `j_P : C_P ⟶ X`, with `B_{C_P}`,
be the adjunction steps onto the floor components of `X`, and likewise `j'_Q : C'_Q ⟶ Y` for `Y`.
Call a family `t_P ∈ H⁰(C_P, m(K_{C_P} + B_{C_P}))` a *floor section* if near every point it is
the family of Poincaré residues of a local section of `𝒪_X(mK_X + ⌊mB⌋)`; these are the sections
of `m(K_X + B)|_{⌊B⌋}`. Then there is a `ℂ`-linear map `e` such that
* `e` maps the floor sections of `X` bijectively onto those of `Y`;
* `e` is the canonical identification. Let `t` be a floor section, `τ` a local section on `U`
  presenting `t`, and `τ'` a local section on `U'` presenting `e t`. Then for every prime divisor
  `E` of `W` with coefficient one in `B_W` whose generic point lies over `U` and `U'`, the
  pull-backs `p^*τ` and `q^*τ'` have the same Poincaré residue along `E`;
* when both pairs are dlt, for all residue restriction structures `R`, `R'` on the floor
  collections in degree `m`, a floor section `t` is admissible (`MMP.Fourfold.admissibleSections`)
  if and only if `e t` is. -/
@[mmp "lem_fourfold_admissible_boundary_crepant_model_independence"]
public theorem exists_linearMap_bijOn_floorSections_of_isCrepantBoundary
    {X Y W : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {n : ℕ} (hn : n + 1 ≤ 3)
    (hXp : Mori.IsProjectiveVariety ℂ sX) (hYp : Mori.IsProjectiveVariety ℂ sY)
    (hdimX : topologicalKrullDim X = (n + 1 : ℕ)) (hdimY : topologicalKrullDim Y = (n + 1 : ℕ))
    (hQX : IsQFactorial sX) (hQY : IsQFactorial sY)
    {B : QDivisor X} {C : QDivisor Y} (hBp : IsPair sX B) (hCp : IsPair sY C)
    (hB : MMP.Intersection.IsDltPair sX B ∨
      (MMP.Intersection.IsLogCanonicalPair sX B ∧
        ∃ δ : ℚ, 0 < δ ∧ IsKltPair sX (B - δ • Divisor.toQDivisor B.roundDown)))
    (hC : MMP.Intersection.IsDltPair sY C ∨
      (MMP.Intersection.IsLogCanonicalPair sY C ∧
        ∃ δ : ℚ, 0 < δ ∧ IsKltPair sY (C - δ • Divisor.toQDivisor C.roundDown)))
    {KX : Divisor X} {KY : Divisor Y} (hKX : KX.IsCanonicalDivisor sX (n + 1))
    (hKY : KY.IsCanonicalDivisor sY (n + 1))
    (p : W ⟶ X) (q : W ⟶ Y) [IsDominant p] [IsDominant q] (hpq : p ≫ sX = q ≫ sY)
    [IsProper p] [IsProper q] (hpb : IsBirationalMorphism p) (hqb : IsBirationalMorphism q)
    (hWX : IsNormalVariety ℂ (p ≫ sX)) (hWY : IsNormalVariety ℂ (q ≫ sY)) {BW : QDivisor W}
    (hBWX : IsCrepantBoundary sX (n + 1) KX B p hWX hpb BW)
    (hBWY : IsCrepantBoundary sY (n + 1) KY C q hWY hqb BW)
    {m : ℕ} (hm : Even m) (hm0 : 0 < m)
    (hmX : ((m : ℤ) • (Divisor.toQDivisor KX + B)).IsCartierDivisor)
    (hmY : ((m : ℤ) • (Divisor.toQDivisor KY + C)).IsCartierDivisor)
    (CX : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (CX P)] [∀ P, IsLocallyNoetherian (CX P)] [∀ P, IsNormal (CX P)]
    (jX : ∀ P, CX P ⟶ X) (BX : ∀ P, QDivisor (CX P))
    (hjX : ∀ P, IsAdjunctionStep sX B (jX P) (BX P) ∧
      Set.range (jX P).base = (P.1.support : Set X))
    (CY : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0} → Scheme.{0})
    [∀ Q, IsIntegral (CY Q)] [∀ Q, IsLocallyNoetherian (CY Q)] [∀ Q, IsNormal (CY Q)]
    (jY : ∀ Q, CY Q ⟶ Y) (BY : ∀ Q, QDivisor (CY Q))
    (hjY : ∀ Q, IsAdjunctionStep sY C (jY Q) (BY Q) ∧
      Set.range (jY Q).base = (Q.1.support : Set Y)) :
    ∃ e : (∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) →ₗ[ℂ]
        (∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)),
      Set.BijOn e
        {t | ∀ x : X, ∃ (U : X.Opens) (_ : x ∈ U) (τ : RationalPluriForms sX (n + 1) m),
          τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
          ∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
            IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)}
        {t' | ∀ y : Y, ∃ (U' : Y.Opens) (_ : y ∈ U') (τ' : RationalPluriForms sY (n + 1) m),
          τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U' ∧
          ∀ Q, (jY Q).base (genericPoint (CY Q)) ∈ U' →
            IsPoincareResidue sY (jY Q) n m τ' (t' Q : RationalPluriForms (jY Q ≫ sY) n m)} ∧
      (∀ t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P),
        (∀ x : X, ∃ (U : X.Opens) (_ : x ∈ U) (τ : RationalPluriForms sX (n + 1) m),
          τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
          ∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
            IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)) →
        ∀ (U : X.Opens) (τ : RationalPluriForms sX (n + 1) m),
          τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U →
          (∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
            IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)) →
        ∀ (U' : Y.Opens) (τ' : RationalPluriForms sY (n + 1) m),
          τ' ∈ pluricanonicalSections sY (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • C)) U' →
          (∀ Q, (jY Q).base (genericPoint (CY Q)) ∈ U' →
            IsPoincareResidue sY (jY Q) n m τ' (e t Q : RationalPluriForms (jY Q ≫ sY) n m)) →
        ∀ (E : Mori.PrimeDivisor W), BW.coeff E = 1 →
        ∀ {E' : Scheme.{0}} [IsIntegral E'] (jE : E' ⟶ W), IsClosedImmersion jE →
          Set.range jE.base = (E.support : Set W) →
          p.base (jE.base (genericPoint E')) ∈ U → q.base (jE.base (genericPoint E')) ∈ U' →
          ∃ ρ : RationalPluriForms (jE ≫ p ≫ sX) n m,
            IsPoincareResidue (p ≫ sX) jE n m (pullbackRationalPluriForms sX p τ) ρ ∧
            IsPoincareResidue (q ≫ sY) jE n m (pullbackRationalPluriForms sY q τ')
              (cast (by rw [hpq]) ρ)) ∧
      (MMP.Intersection.IsDltPair sX B → MMP.Intersection.IsDltPair sY C →
      ∀ (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
        (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
        (t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)),
        (∀ x : X, ∃ (U : X.Opens) (_ : x ∈ U) (τ : RationalPluriForms sX (n + 1) m),
          τ ∈ pluricanonicalSections sX (n + 1) m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) U ∧
          ∀ P, (jX P).base (genericPoint (CX P)) ∈ U →
            IsPoincareResidue sX (jX P) n m τ (t P : RationalPluriForms (jX P ≫ sX) n m)) →
        (t ∈ admissibleSections R ↔ e t ∈ admissibleSections R')) := by
  let S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY :=
    { hn, hXp, hYp, hdimX, hdimY, hQX, hQY, hBp, hCp, hB, hC, hKX, hKY, hpq, hpb, hqb, hWX, hWY,
      hBWX, hBWY, hm, hm0, hmX, hmY, hjX, hjY }
  obtain ⟨e, he⟩ := LinearMap.exists_extend (floorMap S)
  have he' : ∀ t : floorSubmodule S, e t = floorMap S t := fun t => LinearMap.congr_fun he t
  have hspec : ∀ t, IsFloorSection sX n m B jX BX t →
      IsFloorSection sY n m C jY BY (e t) ∧ Pins sX sY n B C p q hpq BW m jX BX jY BY t (e t) :=
    fun t ht => he' ⟨t, ht⟩ ▸ floorMap_spec S ⟨t, ht⟩
  refine ⟨e, ⟨fun t ht => (hspec t ht).1, fun t₁ ht₁ t₂ ht₂ h12 => ?_, fun t' ht' => ?_⟩,
    fun t ht U τ hτ hres U' τ' hτ' hres' => (hspec t ht).2 U τ ⟨hτ, hres⟩ U' τ' ⟨hτ', hres'⟩,
    fun hdltX hdltY R R' t ht => ⟨fun h => mem_admissibleSections_of_pins S hdltX ht
      (hspec t ht).1 (hspec t ht).2 R R' h, fun h => mem_admissibleSections_of_pins S.swap hdltY
      (hspec t ht).1 ht (hspec t ht).2.swap R' R h⟩⟩
  · have h₁ := (hspec t₁ ht₁).2.swap
    have h₂ := (hspec t₂ ht₂).2.swap
    rw [h12] at h₁
    exact eq_of_pins S.swap (hspec t₂ ht₂).1 ht₁ ht₂ h₁ h₂
  · obtain ⟨t, ht, h⟩ := exists_pins S.swap ht'
    exact ⟨t, ht, eq_of_pins S ht (hspec t ht).1 ht' (hspec t ht).2 h.swap⟩

end MMP.Fourfold
