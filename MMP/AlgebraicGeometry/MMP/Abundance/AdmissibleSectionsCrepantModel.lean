    (Scheme.ord_eq_iff Γ.coheight_genericPoint hat0).mpr (Ring.ordFrac_irreducible ht)
  have hordu : (CY Q).ord au Γ.genericPoint = 0 := Γ.ord_algebraMap_of_isUnit hu
  -- `H_Z` vanishes near `z₀`
  let Sbad : Finset (Mori.PrimeDivisor TZ) := HZ.support.filter (fun E => E ≠ Z₀)
