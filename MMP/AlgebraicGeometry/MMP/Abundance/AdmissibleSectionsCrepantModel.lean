  -- the range of `G` and the residue `ρ_G = (dlog ū)` of `θ_s` along `G`
  have hrΓ : Set.range j.base = (Γ.support : Set (CY Q)) := by
    obtain ⟨-, P', -, hP'r, -⟩ := hj'
    have hP'Γ : P' = Γ := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((CrepantModelAux.map_genericPoint_eq_of_range_eq j P' hP'r).symm.trans hΓ)
