    hKBX.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hXn St.hKX hτs0).symm)
  obtain ⟨hgenZs, hpbZs⟩ := hpbZu hh hhu
  set HZ : QDivisor TZ := Divisor.toQDivisor (divisorOfForm
    (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ hh •
      formPow (exteriorPower.ιMulti TZ.functionField 1
