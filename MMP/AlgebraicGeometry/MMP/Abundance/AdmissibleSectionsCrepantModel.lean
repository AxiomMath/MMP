    have := (CrepantModelAux.mem_maximalIdeal_iff_divisorialValuation_lt_one Γ hΓ u').1
      ((IsLocalRing.mem_maximalIdeal _).2 hnu)
    rw [hu', Γ.divisorialValuation_eq_exp_neg_ord hau0, hordu, neg_zero, WithZero.exp_zero] at this
    exact lt_irrefl _ this
  have htG1 : (CY Q).ord (algebraMap _ (CY Q).functionField tG) (j (genericPoint G)) = 1 := by
    rw [htG, hΓ]; exact hordt
  have hresG := CrepantModelAux.isPoincareResidue_formPow_dlog (jY Q ≫ sY) j (n := 1) 1 tG ![u']
    (fun i => by fin_cases i; exact hu'u) htG1
  letI := functionFieldAlgebra (j ≫ jY Q ≫ sY)
