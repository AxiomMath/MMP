      (map_nonunit (πN.stalkMap CN.genericPoint).hom a ha)
  have hπZ : πN CN.genericPoint = Z₀.genericPoint :=
    MMP.Positivity.DivisorOver.eq_of_dominates (ιZ ≫ sX) ν hdom1 hdom2 hz₀le hz₀lt
  have hsm : s ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) := by
    rw [hs_span]; exact Ideal.mem_span_singleton_self s
  set tA : (CY Q).functionField := algebraMap Γ.localRing (CY Q).functionField tΓ with htA
  set au : (CY Q).functionField := algebraMap Γ.localRing (CY Q).functionField u with hau
  have hat0 : tA ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 ht.ne_zero
  have hau0 : au ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hu.ne_zero
  haveI := Γ.isDiscreteValuationRing_localRing
