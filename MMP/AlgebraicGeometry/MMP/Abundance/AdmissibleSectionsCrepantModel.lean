    exact h1.mem_closed ιZ.isClosedEmbedding.isClosed_range ⟨_, hgenZ⟩
  obtain ⟨πN, hπN⟩ := CrepantModelAux.exists_comp_eq_of_range_subset ιZ (νN ≫ qW) hrange
  have hπη : πN (genericPoint N) = genericPoint TZ := by
