open scoped WithZero in
open exteriorPower in
/-- **Boundary curves of a floor surface exceptional over a curve.** Let `Q` be a floor component
of `Y` exceptional over a curve `Z` of `X`, and `G` an adjunction curve of `(C_Q, B_Q)`. If `G`
dominates `Z`, it is a crepant copy of the curve stratum `Z` of a floor component of `X`, carrying
the residue restriction of `t` to that of `t'`. Otherwise `G` lies over a point stratum `z₀` of
`Z` and is a rational log curve on which `t'` restricts to `t(z₀) (dlog ū)^{⊗m}`. -/
private theorem isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) 2 m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) 2 m (BY Q)}
    (hfX : IsFloorSection sX 2 m B jX BX t) (hfY : IsFloorSection sY 2 m C jY BY t')
    (hpins : Pins sX sY 2 B C p q St.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX 2 m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY 2 m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q)
    (hQ : MMP.Mori.IsPair (jY Q ≫ sY) (BY Q)) {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    (hG : topologicalKrullDim G = (1 : ℕ)) :
    IsCopyAlong R R' t t' Q ((StratumAdjunctionData.refl hQ).step j BG hj) 1 ∨
      IsDlogCurve t t' Q ((StratumAdjunctionData.refl hQ).step j BG hj) := by
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  have hdata := exists_data_of_isExceptionalOverCurve St hdltX hfX hfY hpins Q hcurveQ
  obtain ⟨σ, hσc, hσ, D, hv, hDp, ha, hcd, h1⟩ := hdata
  obtain ⟨P, TZ, ι₂, BZ, h₂, ιZ, FZ, h2⟩ := h1
  obtain ⟨hιZ, hdimZ, hgenZ, h3⟩ := h2
  obtain ⟨z, v, g, resZ, lam, eb, h4⟩ := h3
  obtain ⟨hresZs, hresZm, hresZk, hstalkZ, hlamk, hgentr, hresid, hvu, hwZ', hρP2,
    ht'Q, hτ'0, ⟨U, hxU, hU⟩, hρres, hpbZu, hdltZ⟩ := h4
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  haveI : IsIntegral G := hj'.1.1.toIsIntegral
  obtain ⟨Γ, hΓ, hciG⟩ := hj'.exists_primeDivisor
  haveI := hciG
  haveI : IsNormal G := hj'.1.2
  haveI : LocallyOfFiniteType (j ≫ jY Q ≫ sY) := hj'.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ jY Q ≫ sY)
  by_cases hhor : ∀ c : TZ.functionField, c ≠ 0 → Γ.divisorialValuation (lam c) = 1
  · left
    obtain ⟨hρs0, hordθ⟩ :=
      ordForm_eq_neg_one_of_isExceptionalOverCurve_of_horizontal St R' Q hcurveQ hj σ hσc D hv P TZ
        ι₂ BZ h₂ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr hresid hvu hτ'0 U hxU hU
        hρres hpbZu Γ hΓ hhor
    obtain ⟨et, het, hetlt, hμet, hμres⟩ :=
      exists_uniformizer_of_isExceptionalOverCurve_of_horizontal St Q hj σ D ha P TZ ι₂ BZ ιZ FZ z v
        g resZ lam eb hlamk hgentr hvu U Γ hhor hρs0 hordθ
    obtain ⟨μ3, φ, ψ, εc, hμ3, hφdef, hψdef, hεc, hωε, hresω⟩ :=
      exists_residue_field_equiv_of_isExceptionalOverCurve_of_horizontal St Q hcurveQ hj σ D P TZ ι₂
        BZ ιZ FZ hιZ z v g resZ lam eb hlamk hgentr hvu U Γ hΓ hhor et het hetlt hμet hμres
    have hφcr :=
      isCrepantBirationalMap_of_isExceptionalOverCurve_of_horizontal St Q hcurveQ hj hG σ hσc D hv P
        TZ ι₂ BZ h₂ ιZ FZ hιZ hdimZ hgenZ z v g resZ lam eb hstalkZ hlamk hgentr hresid hvu hwZ'
        hτ'0 U hxU hU hρres hpbZu Γ hΓ hhor hordθ et μ3 φ εc hμ3 hφdef hεc hωε hresω
    exact
      isCopyAlong_step_of_isExceptionalOverCurve_of_horizontal St (t' := t') (t := t) R R' Q hcurveQ
        hQ hj hG σ D P TZ ι₂ BZ h₂ ιZ FZ hιZ hdimZ z v g resZ lam eb hlamk hgentr hvu hρP2 ht'Q U Γ
        et μ3 φ ψ εc hμ3 hφdef hψdef hεc hωε hresω hφcr
  · right
    push Not at hhor
    obtain ⟨c₁, hc₁0, hc₁⟩ := hhor
    obtain ⟨Z₀, s, hz₀le, hz₀lt, hz₀cl, hs, hs_span, hres₀, hsm₀, k', hh, U'', hk'0, hdlogs, hhh,
      hhu, hxU'', hU', hωsv, hρs⟩ :=
      exists_center_of_isExceptionalOverCurve_of_vertical St Q hj σ D hv ha P TZ ι₂ BZ ιZ FZ hdimZ
        z v g resZ lam eb hresZs hresZm hlamk hgentr hresid hvu hwZ' hτ'0 U hU hρres Γ c₁ hc₁0 hc₁
    have hHZ₀ :=
      coeff_eq_of_isExceptionalOverCurve_of_vertical St Q hj σ D P TZ ι₂ BZ ιZ FZ hdimZ z v g resZ
        lam eb hlamk hgentr hvu hτ'0 U Γ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k'
        hh U'' hk'0 hdlogs hhh hhu hxU'' hU' hωsv hρs
    obtain ⟨hρs0, e, he1, hkey'⟩ :=
      exists_coeff_eq_of_isExceptionalOverCurve_of_vertical St R' Q hcurveQ hj σ hσc D hv ha P TZ ι₂
        BZ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr hresid hvu hτ'0 U hxU hpbZu Γ
        hΓ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U'' hk'0 hdlogs hhh hhu
        hxU'' hU' hωsv hρs hHZ₀
    obtain ⟨hordΓ, hBZ1, tΓ, u, ht, hu, hωtu, hresu⟩ :=
      ordForm_eq_neg_one_of_isExceptionalOverCurve_of_vertical St Q hj σ D P TZ ι₂ BZ ιZ FZ
        z v g resZ lam eb hlamk hgentr hvu hτ'0 U hdltZ Γ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs
        hs_span hres₀ hsm₀ k' hh U'' hk'0 hdlogs hhh hhu hxU'' hU' hωsv hρs hρs0 e he1 hkey'
    obtain ⟨tG, u', htG, hu', hψG, hadj⟩ :=
      exists_dlog_curve_of_isExceptionalOverCurve_of_vertical St R' Q hcurveQ hj hG σ hσc D hv ha P
        TZ ι₂ BZ h₂ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr hresid hvu hτ'0 U hxU
        hpbZu Γ hΓ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U'' hk'0 hdlogs
        hhh hhu hxU'' hU' hωsv hρs hordΓ hBZ1 hHZ₀ tΓ u ht hu hωtu hresu
    exact
      isDlogCurve_step_of_isExceptionalOverCurve_of_vertical St (t' := t') (t := t) R R' Q hQ hj σ D
        ha P TZ ι₂ BZ h₂ ιZ FZ hιZ hdimZ z v g resZ lam eb hlamk hgentr hvu hρP2 ht'Q hτ'0 U hdltZ Γ
        hΓ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U'' hk'0 hdlogs hhh hhu
        hxU'' hU' hωsv hρs hρs0 hordΓ hBZ1 tΓ u ht hu hωtu tG u' htG hu' hψG hadj

/-- **Adjunction steps of detecting strata.** The geometry of a detecting stratum is recomputed
from its flag: its floor component is a crepant copy of a floor component of `X`, or exceptional
over `X`. -/
private theorem isCopyAlong_step_or_isDetecting_of_isDetecting
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {S₀ G : Scheme.{0}} {ι₀ : S₀ ⟶ CY Q}
    {BS₀ : QDivisor S₀} (F₀ : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ι₀ BS₀) {j : G ⟶ S₀}
    {BG : QDivisor G}
    (hj : haveI := F₀.isIntegral_stratum; haveI := F₀.isNormal_stratum;
      haveI := F₀.isLocallyNoetherian_stratum; IsAdjunctionStep (ι₀ ≫ jY Q ≫ sY) BS₀ j BG)
    {e : ℕ} (hV : topologicalKrullDim G = e) (hS₀ : topologicalKrullDim S₀ = (e + 1 : ℕ)) :
    IsCopyAlong R R' t t' Q (F₀.step j BG hj) e ∨ IsDetecting m Q (F₀.step j BG hj) e := by
  have hn := S.hn
  have hl₀ := F₀.dim_add_length (R'.setting.topologicalKrullDim_eq Q) hS₀
  cases F₀ with
  | refl hQ =>
    simp only [StratumAdjunctionData.length] at hl₀
    by_cases hne : ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
        p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
        IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint)
    · have hcopy := isCopyAlong_refl_of_exists S ht ht' h R R' Q hQ hl₀.symm hne
      rcases isCopyAlong_step_or_isDetecting_of_isCopyAlong S R R' Q (.refl hQ) hj hV hcopy with
        h1 | ⟨rfl, h1⟩
      · exact Or.inl h1
      · exact Or.inr (isDetecting_of_isDlogCurve S R' Q _ hV h1)
    · -- the floor component `Q` is exceptional over `X`
      rcases Nat.lt_or_ge n 2 with hn2 | hn2
      · have hn1 : n = 1 := by omega
        left
        obtain rfl : e = 0 := by omega
        exact isCopyAlong_step_of_isDlogCurve S R R' Q (.refl hQ) hj (by simpa using hS₀) hV
          (isDlogCurve_refl_of_not_exists S hdltX ht ht' h R Q hQ hne hn1)
      · have hn2' : n = 2 := by omega
        rcases isDlogSurface_refl_or_isExceptionalOverCurve_of_not_exists S hdltX ht ht' h R Q hQ
          hne hn2' with hs | hcurve
        · right
          obtain rfl : e = 1 := by omega
          exact isDetecting_of_isDlogCurve S R' Q _ hV
            (isDlogCurve_step_of_isDlogSurface S R' Q (.refl hQ) hj (by simpa using hS₀) hs)
        · -- the floor surface `Q` is exceptional over a curve of `X`
          subst hn2'
          obtain rfl : e = 1 := by omega
          haveI := S.hXp.toLocallyOfFiniteType
          haveI := S.hXp.toIsVariety
          haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
          rcases isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve S hdltX ht ht' h R R' Q
            hcurve hQ hj (by exact_mod_cast hV) with h1 | h1
          · exact Or.inl h1
          · exact Or.inr (isDetecting_of_isDlogCurve S R' Q _ hV h1)
  | step F₁ j₁ BT₁ hj₁ =>
    cases F₁ with
    | step F₂ j₂ BT₂ hj₂ =>
      simp only [StratumAdjunctionData.length] at hl₀
      omega
    | refl hQ =>
      simp only [StratumAdjunctionData.length] at hl₀
      haveI : IsIntegral S₀ := hj₁.1.1.toIsIntegral
      by_cases hne : ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0})
          (E : Mori.PrimeDivisor W),
          p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
          IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint)
      · have hcopy := isCopyAlong_refl_of_exists S ht ht' h R R' Q hQ
          (show n = e + 1 + 1 by omega) hne
        rcases isCopyAlong_step_or_isDetecting_of_isCopyAlong S R R' Q (.refl hQ) hj₁ hS₀ hcopy
          with hcopy₁ | ⟨he1, hdc⟩
        · rcases isCopyAlong_step_or_isDetecting_of_isCopyAlong S R R' Q _ hj hV hcopy₁ with
            h1 | ⟨rfl, h1⟩
          · exact Or.inl h1
          · exact Or.inr (isDetecting_of_isDlogCurve S R' Q _ hV h1)
        · -- the curve `S₀` is exceptional over the floor surface of `X`
          left
          obtain rfl : e = 0 := by omega
          exact isCopyAlong_step_of_isDlogCurve S R R' Q _ hj (by simpa using hS₀) hV hdc
      · -- the floor component `Q` is exceptional over `X`
        have hn2' : n = 2 := by omega
        rcases isDlogSurface_refl_or_isExceptionalOverCurve_of_not_exists S hdltX ht ht' h R Q hQ
          hne hn2' with hs | hcurve
        · left
          obtain rfl : e = 0 := by omega
          have hdS : topologicalKrullDim (CY Q) = ((2 : ℕ) : WithBot ℕ∞) := by
            rw [R'.setting.topologicalKrullDim_eq Q, hn2']
          exact isCopyAlong_step_of_isDlogCurve S R R' Q _ hj (by simpa using hS₀) hV
            (isDlogCurve_step_of_isDlogSurface S R' Q (.refl hQ) hj₁ hdS hs)
        · -- the floor surface `Q` is exceptional over a curve of `X`
          subst hn2'
          obtain rfl : e = 0 := by omega
          haveI := S.hXp.toLocallyOfFiniteType
          haveI := S.hXp.toIsVariety
          haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
          rcases isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve S hdltX ht ht' h R R' Q
            hcurve hQ hj₁ (by simpa using hS₀) with hcopy₁ | hdc
          · rcases isCopyAlong_step_or_isDetecting_of_isCopyAlong S R R' Q _ hj hV hcopy₁ with
              h1 | ⟨h01, -⟩
            · exact Or.inl h1
            · exact absurd h01 (by norm_num)
          · left
            exact isCopyAlong_step_of_isDlogCurve S R R' Q _ hj (by simpa using hS₀) hV hdc

/-- **Strata of `Y` are crepant copies of strata of `X`, or detect their sections by
residues.** Every stratum `V` of a floor component of `Y` reached by a flag `F` either is a
crepant copy `ψ : (V, B_V) ⇢ (U, B_U)` of a stratum of a floor component of `X` carrying the
residue restriction of `t` to that of `t'`, or has positive dimension and every section of
`m(K_V + B_V)` with zero residues along all adjunction steps of `V` vanishes. -/
private theorem toFun_eq_pluriformPullback_or_detects
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V : Scheme.{0}} {ιV : V ⟶ CY Q}
    {BV : QDivisor V} (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV) {e : ℕ}
    (hV : topologicalKrullDim V = e) :
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    (∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (U : Scheme.{0}) (ιU : U ⟶ CX P)
        (BU : QDivisor U) (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU),
        topologicalKrullDim U = e ∧
        haveI := G.isIntegral_stratum
        haveI := G.isNormal_stratum
        haveI := G.isLocallyNoetherian_stratum
        ∃ ψ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX),
          IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) BV BU ψ ∧
          R'.toFun Q F e (t' Q) =
            pluriformPullback (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) ψ.toHom e m (R.toFun P G e (t P))) ∨
    (∃ d : ℕ, e = d + 1 ∧
      ∀ δ : RationalPluriForms (ιV ≫ jY Q ≫ sY) (d + 1) m,
        δ ∈ logPluricanonicalSections (ιV ≫ jY Q ≫ sY) (d + 1) m BV →
        (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ V} {BG : QDivisor G},
          IsAdjunctionStep (ιV ≫ jY Q ≫ sY) BV j BG →
          IsPoincareResidue (ιV ≫ jY Q ≫ sY) j d m δ 0) → δ = 0) := by
  induction F generalizing e with
  | @step S₀ G ι₀ BS₀ F₀ j BG hj ih =>
    haveI := F₀.isIntegral_stratum
    haveI := F₀.isNormal_stratum
    haveI := F₀.isLocallyNoetherian_stratum
    haveI : IsIntegral G := hj.1.1.toIsIntegral
    haveI : LocallyOfFiniteType (ι₀ ≫ jY Q ≫ sY) := F₀.isNormalVariety.1.toLocallyOfFiniteType
    have hS₀ : topologicalKrullDim S₀ = ((e + 1 : ℕ) : WithBot ℕ∞) := by
      have hdl := (StratumAdjunctionData.step F₀ j BG hj).dim_add_length
        (R'.setting.topologicalKrullDim_eq Q) hV
      have h1 := F₀.dim_add_length (R'.setting.topologicalKrullDim_eq Q)
        (topologicalKrullDim_eq_toNat_trdeg (ι₀ ≫ jY Q ≫ sY))
      rw [topologicalKrullDim_eq_toNat_trdeg (ι₀ ≫ jY Q ≫ sY)]
      simp only [StratumAdjunctionData.length] at hdl
      congr 1
      omega
    rcases ih hS₀ with hcopy | -
    · rcases isCopyAlong_step_or_isDetecting_of_isCopyAlong S R R' Q F₀ hj hV hcopy with
        h1 | ⟨rfl, h1⟩
      · exact Or.inl h1
      · exact Or.inr (isDetecting_of_isDlogCurve S R' Q _ hV h1)
    · exact isCopyAlong_step_or_isDetecting_of_isDetecting S hdltX ht ht' h R R' Q F₀ hj hV hS₀
  | refl hQ =>
  by_cases hne : ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (E : Mori.PrimeDivisor W),
      p E.genericPoint = P.1.genericPoint ∧ q E.genericPoint = Q.1.genericPoint ∧
      IsIso (p.stalkMap E.genericPoint) ∧ IsIso (q.stalkMap E.genericPoint)
  swap
  · -- `Q` is exceptional over `X`: it is detecting
    obtain ⟨E, hqE, hqiso, hE1, hC1⟩ := exists_strictTransform_floor S Q
    haveI := hqiso
    haveI := S.hXp.toLocallyOfFiniteType
    haveI := S.hYp.toLocallyOfFiniteType
    haveI := S.hXp.toIsVariety
    haveI := S.hYp.toIsVariety
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
    haveI : IsProper sX := isProper_of_isProjectiveMorphism _ S.hXp.isProjective
    haveI : IsProper sY := isProper_of_isProjectiveMorphism _ S.hYp.isProjective
    have hXn : IsNormalVariety ℂ sX := S.hBp.isPair.1
    have hYn : IsNormalVariety ℂ sY := S.hCp.isPair.1
    obtain ⟨σ, hσc, hσ⟩ := S.exists_isCrepantBirationalMap
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    -- the divisor `D` over `X` with the valuation of `Q`
    set DΓ := DivisorOver.ofPrimeDivisor ℂ hYn Q.1
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy S.hCp.isPair S.hKY DΓ
    have hc' : c = -C.coeff Q.1 := hc.eq_neg_coeff_of_ofPrimeDivisor hYn
    have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 Y) by infer_instance)
    obtain ⟨n', D, hDv, hDlog⟩ := (hσc DΓ.valuation (1 + c)).mp ⟨n + 1, DΓ, rfl, hlog⟩
    have hv : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g) := by
      intro g
      rw [hDv]
      change Q.1.divisorialValuation (functionFieldMap (𝟙 Y) _) = _
      rw [functionFieldMap_id_apply]
      rfl
    have hD : D.IsExceptional := by
      by_contra hD
      obtain ⟨P', hP'⟩ :=
        MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hXn D hD
      have hvE : ∀ g, E.divisorialValuation (functionFieldMap p g) = P'.divisorialValuation g := by
        intro g
        have h2 : P'.divisorialValuation g = D.valuation g := by
          rw [hP']
          change _ = P'.divisorialValuation (functionFieldMap (𝟙 X) g)
          rw [functionFieldMap_id_apply]
        rw [h2, hv, ← hσ]
        change E.divisorialValuation (functionFieldMap q ((σ.toHom) g)) = _
        by_cases hg : (σ.toHom) g = 0
        · rw [hg, map_zero, map_zero, map_zero]
        have hg' : functionFieldMap q ((σ.toHom) g) ≠ 0 := (map_ne_zero _).mpr hg
        rw [E.divisorialValuation_eq_exp_neg_ord hg', Q.1.divisorialValuation_eq_exp_neg_ord hg,
          ord_functionFieldMap_of_isIso' q E Q.1 hqE]
      have hpE : p E.genericPoint = P'.genericPoint := by
        let D1 : DivisorOver ℂ sX := ⟨W, p, S.hWX, S.hpb, E⟩
        have hv1 : D1.valuation = (DivisorOver.ofPrimeDivisor ℂ hXn P').valuation := by
          ext g
          change E.divisorialValuation (functionFieldMap p g) =
            P'.divisorialValuation (functionFieldMap (𝟙 X) g)
          rw [functionFieldMap_id_apply, hvE]
        exact MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hXn.1 hv1
      have hbir : P'.genericPoint ∈ Mori.biregularLocus p :=
        MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal p S.hpb
          P'.coheight_genericPoint.le
      haveI hpiso : IsIso (p.stalkMap E.genericPoint) :=
        MMP.isIso_stalkMap_of_mem_biregularLocus p (hpE ▸ hbir)
      have hcoeff := coeff_eq_of_isIso_stalkMap S.swap P' E hpE
      rw [hE1] at hcoeff
      exact hne ⟨⟨P', by rw [← hcoeff]; norm_num⟩, E, hpE, hqE, hpiso, hqiso⟩
    have hnn : n' = n + 1 := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDlog).symm.trans
        S.hdimX
      exact_mod_cast this
    subst hnn
    obtain ⟨a, ha⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy S.hBp.isPair S.hKX D
    have h1 := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy ha hDlog
    have hac : a = -1 := by
      have : a = c := by exact_mod_cast (by linarith : (a : ℝ) = c)
      rw [this, hc', hC1]
    rw [hac] at ha
    have hen : e = n := by
      have := hV.symm.trans (R'.setting.topologicalKrullDim_eq Q)
      exact_mod_cast this
    subst hen
    -- dimension `0` has no exceptional floor; dimension `1` is the curve case
    rcases Nat.lt_or_ge e 2 with he2 | he2
    · rcases Nat.lt_or_ge e 1 with he1 | he1
      · obtain rfl : e = 0 := by omega
        exact absurd (exists_floor_strictTransform_of_eq_zero S Q) hne
      obtain rfl : e = 1 := by omega
      obtain ⟨Q₀, hQ₀, hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
      haveI := hciQ
      haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
      have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
        obtain ⟨D', hD', hD'c⟩ := S.hmY
        exact ⟨m, by exact_mod_cast S.hm0.ne', D', hD', hD'c⟩
      have key : ∀ (s' : CY Q ⟶ Spec (.of ℂ)) (hs : jY Q ≫ sY = s')
          (δ : RationalPluriForms s' 1 m), δ ∈ logPluricanonicalSections s' 1 m (BY Q) →
          (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ CY Q} {BG : QDivisor G},
            IsAdjunctionStep s' (BY Q) j BG → IsPoincareResidue s' j 0 m δ 0) → δ = 0 := by
        rintro s' rfl δ hδ hres
        exact eq_zero_of_isPoincareResidue_zero_of_isExceptional_curve hYn hXn S.hdimY S.hdimX
          S.hKY S.hKX hKBY S.hm0 S.hmX hdltX σ hσc (S.hjY Q).1 (R'.setting.isDltPair Q) Q.1
          (S.hjY Q).2 hC1 D hv hD hDlog.2.1 ha S.hm0 hδ hres
      right
      exact ⟨0, rfl, fun δ hδ hres => key _ (Category.id_comp _).symm δ hδ hres⟩
    · obtain rfl : e = 2 := by have := S.hn; omega
      have h3 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight
        hXn D).mp hD
      have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim (D.f D.E.genericPoint)
      rw [S.hdimX] at h5
      have h7 : Order.coheight (D.f D.E.genericPoint) ≤ ((2 + 1 : ℕ) : ℕ∞) :=
        WithBot.coe_le_coe.mp h5
      obtain ⟨cd, hcd⟩ : ∃ cd : ℕ, Order.coheight (D.f D.E.genericPoint) = cd :=
        ⟨(Order.coheight (D.f D.E.genericPoint)).toNat,
          (ENat.coe_toNat (ne_top_of_le_ne_top (ENat.coe_ne_top _) h7)).symm⟩
      rw [hcd] at h3 h7
      have h8 : 2 ≤ cd := by exact_mod_cast h3
      have h9 : cd ≤ 3 := by exact_mod_cast h7
      obtain ⟨Q₀, hQ₀, hciQ⟩ := (S.hjY Q).1.exists_primeDivisor
      haveI := hciQ
      haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
      have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
        obtain ⟨D', hD', hD'c⟩ := S.hmY
        exact ⟨m, by exact_mod_cast S.hm0.ne', D', hD', hD'c⟩
      rcases (show cd = 3 ∨ cd = 2 by omega) with rfl | rfl
      · -- the centre is a closed point
        have key : ∀ (s' : CY Q ⟶ Spec (.of ℂ)) (hs : jY Q ≫ sY = s')
            (δ : RationalPluriForms s' 2 m), δ ∈ logPluricanonicalSections s' 2 m (BY Q) →
            (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ CY Q} {BG : QDivisor G},
              IsAdjunctionStep s' (BY Q) j BG → IsPoincareResidue s' j 1 m δ 0) → δ = 0 := by
          rintro s' rfl δ hδ hres
          exact eq_zero_of_isPoincareResidue_zero_of_isExceptional_surface_point hYn hXn S.hdimY
            S.hdimX S.hKY S.hKX hKBY S.hm0 S.hmX hdltX σ hσc (S.hjY Q).1 (R'.setting.isDltPair Q)
            Q.1 (S.hjY Q).2 hC1 D hv hDlog.2.1 ha hcd S.hm0 hδ hres
        right
        exact ⟨1, rfl, fun δ hδ hres => key _ (Category.id_comp _).symm δ hδ hres⟩
      · -- the centre is a curve
        obtain ⟨KT, hKT, hmKT⟩ := exists_canonical_cartier_flag R' Q (.refl hQ) hV
        have hKT' : KT.IsCanonicalDivisor (jY Q ≫ sY) 2 := by
          simpa only [Category.id_comp] using hKT
        have key : ∀ (s' : CY Q ⟶ Spec (.of ℂ)) (hs : jY Q ≫ sY = s')
            (δ : RationalPluriForms s' 2 m), δ ∈ logPluricanonicalSections s' 2 m (BY Q) →
            (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ CY Q} {BG : QDivisor G},
              IsAdjunctionStep s' (BY Q) j BG → IsPoincareResidue s' j 1 m δ 0) → δ = 0 := by
          rintro s' rfl δ hδ hres
          exact eq_zero_of_isPoincareResidue_zero_of_isExceptional_surface_curve hYn hXn S.hdimY
            S.hdimX S.hKY S.hKX hKBY S.hm0 S.hmX hdltX σ hσc (S.hjY Q).1 (R'.setting.isDltPair Q)
            Q.1 (S.hjY Q).2 hC1 D hv hDlog.2.1 ha hcd S.hm0 hKT' hmKT hδ hres
        right
        exact ⟨1, rfl, fun δ hδ hres => key _ (Category.id_comp _).symm δ hδ hres⟩
  left
  have hen : e = n := by
    have := hV.symm.trans (R'.setting.topologicalKrullDim_eq Q)
    exact_mod_cast this
  subst hen
  exact isCopyAlong_refl_of_exists S ht ht' h R R' Q hQ rfl hne

/-- **Compatibility in every dimension**, by induction on the dimension of the strata. -/
private theorem isCompatibleInDim_of_admissible
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m) (hadm : t ∈ admissibleSections R) :
    ∀ e, IsCompatibleInDim R' t' e := by
  -- the two crepant copies case
  have hcopy : ∀ e : ℕ, ∀ (Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V V' : Scheme.{0}}
      {ιV : V ⟶ CY Q} {ιV' : V' ⟶ CY Q'} {BV : QDivisor V} {BV' : QDivisor V'}
      (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
      (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV')
      (hV : topologicalKrullDim V = e) (hV' : topologicalKrullDim V' = e),
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      haveI := F'.isIntegral_stratum
      haveI := F'.isNormal_stratum
      haveI := F'.isLocallyNoetherian_stratum
      ∀ (P P' : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (U U' : Scheme.{0})
        (ιU : U ⟶ CX P) (ιU' : U' ⟶ CX P') (BU : QDivisor U) (BU' : QDivisor U')
        (G : StratumAdjunctionData (jX P ≫ sX) (BX P) ιU BU)
        (G' : StratumAdjunctionData (jX P' ≫ sX) (BX P') ιU' BU'),
        topologicalKrullDim U = e → topologicalKrullDim U' = e →
        haveI := G.isIntegral_stratum
        haveI := G.isNormal_stratum
        haveI := G.isLocallyNoetherian_stratum
        haveI := G'.isIntegral_stratum
        haveI := G'.isNormal_stratum
        haveI := G'.isLocallyNoetherian_stratum
        ∀ (ψ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX))
          (ψ' : FunctionFieldEquiv (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX)),
          IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) BV BU ψ →
          IsCrepantBirationalMap (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX) BV' BU' ψ' →
          R'.toFun Q F e (t' Q) =
            pluriformPullback (ιV ≫ jY Q ≫ sY) (ιU ≫ jX P ≫ sX) ψ.toHom e m
              (R.toFun P G e (t P)) →
          R'.toFun Q' F' e (t' Q') =
            pluriformPullback (ιV' ≫ jY Q' ≫ sY) (ιU' ≫ jX P' ≫ sX) ψ'.toHom e m
              (R.toFun P' G' e (t P')) →
          ∀ φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY),
            IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ →
            pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom e m
              (R'.toFun Q' F' e (t' Q')) = R'.toFun Q F e (t' Q) := by
    intro e Q Q' V V' ιV ιV' BV BV' F F' hV hV' P P' U U' ιU ιU' BU BU' G G' hU hU'
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    haveI := G.isIntegral_stratum
    haveI := G.isNormal_stratum
    haveI := G.isLocallyNoetherian_stratum
    haveI := G'.isIntegral_stratum
    haveI := G'.isNormal_stratum
    haveI := G'.isLocallyNoetherian_stratum
    intro ψ ψ' hψ hψ' h₁ h₂ φ hφ
    exact pluriformPullback_toFun_eq_of_admissible R R' hadm G G' F F' hU hU' hV hV' ψ ψ' hψ hψ'
      h₁ h₂ φ hφ
  -- the detecting case
  have hdet : ∀ d, (∀ e ≤ d, IsCompatibleInDim R' t' e) →
      ∀ (Q Q' : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) {V V' : Scheme.{0}}
      {ιV : V ⟶ CY Q} {ιV' : V' ⟶ CY Q'} {BV : QDivisor V} {BV' : QDivisor V'}
      (F : StratumAdjunctionData (jY Q ≫ sY) (BY Q) ιV BV)
      (F' : StratumAdjunctionData (jY Q' ≫ sY) (BY Q') ιV' BV')
      (hV : topologicalKrullDim V = (d + 1 : ℕ)) (hV' : topologicalKrullDim V' = (d + 1 : ℕ)),
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      haveI := F'.isIntegral_stratum
      haveI := F'.isNormal_stratum
      haveI := F'.isLocallyNoetherian_stratum
      (∀ δ : RationalPluriForms (ιV ≫ jY Q ≫ sY) (d + 1) m,
        δ ∈ logPluricanonicalSections (ιV ≫ jY Q ≫ sY) (d + 1) m BV →
        (∀ {G : Scheme.{0}} [IsIntegral G] {j : G ⟶ V} {BG : QDivisor G},
          IsAdjunctionStep (ιV ≫ jY Q ≫ sY) BV j BG →
          IsPoincareResidue (ιV ≫ jY Q ≫ sY) j d m δ 0) → δ = 0) →
      ∀ φ : FunctionFieldEquiv (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY),
        IsCrepantBirationalMap (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) BV BV' φ →
        pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom (d + 1) m
          (R'.toFun Q' F' (d + 1) (t' Q')) = R'.toFun Q F (d + 1) (t' Q) := by
    intro d hlow Q Q' V V' ιV ιV' BV BV' F F' hV hV'
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    intro hD φ hφ
    have hmem : pluriformPullback (ιV ≫ jY Q ≫ sY) (ιV' ≫ jY Q' ≫ sY) φ.toHom (d + 1) m
        (R'.toFun Q' F' (d + 1) (t' Q')) - R'.toFun Q F (d + 1) (t' Q) ∈
        logPluricanonicalSections (ιV ≫ jY Q ≫ sY) (d + 1) m BV := by
      refine sub_mem ?_ (toFun_mem_logPluricanonicalSections R' t' Q F hV)
      obtain ⟨K, hK, hmK⟩ := exists_canonical_cartier_flag R' Q F hV
      obtain ⟨K', hK', hmK'⟩ := exists_canonical_cartier_flag R' Q' F' hV'
      exact pluriformPullback_mem_logPluricanonicalSections' F.isNormalVariety F'.isNormalVariety
        hK hK' R'.setting.pos hmK hmK' hφ (toFun_mem_logPluricanonicalSections R' t' Q' F' hV')
    have := hD _ hmem (isPoincareResidue_pluriformPullback_sub_toFun S R' t' hlow Q Q' F F' hV hV'
      φ hφ)
    exact sub_eq_zero.mp this
  suffices H : ∀ e, ∀ e' ≤ e, IsCompatibleInDim R' t' e' from fun e => H e e le_rfl
  intro e
  induction e with
  | zero =>
    intro e' he'
    obtain rfl : e' = 0 := by omega
    intro Q Q' V V' ιV ιV' BV BV' F F' hV hV'
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    intro φ hφ
    rcases toFun_eq_pluriformPullback_or_detects S hdltX ht ht' h R R' Q F hV with
      ⟨P, U, ιU, BU, G, hU, hG⟩ | ⟨d, hd, -⟩
    · rcases toFun_eq_pluriformPullback_or_detects S hdltX ht ht' h R R' Q' F' hV' with
        ⟨P', U', ιU', BU', G', hU', hG'⟩ | ⟨d, hd, -⟩
      · haveI := G.isIntegral_stratum
        haveI := G.isNormal_stratum
        haveI := G.isLocallyNoetherian_stratum
        haveI := G'.isIntegral_stratum
        haveI := G'.isNormal_stratum
        haveI := G'.isLocallyNoetherian_stratum
        obtain ⟨ψ, hψ, h₁⟩ := hG
        obtain ⟨ψ', hψ', h₂⟩ := hG'
        exact hcopy 0 Q Q' F F' hV hV' P P' U U' ιU ιU' BU BU' G G' hU hU' ψ ψ' hψ hψ' h₁ h₂ φ hφ
      · omega
    · omega
  | succ d ih =>
    intro e' he'
    rcases Nat.lt_or_ge e' (d + 1) with hlt | hge
    · exact ih e' (by omega)
    obtain rfl : e' = d + 1 := by omega
    intro Q Q' V V' ιV ιV' BV BV' F F' hV hV'
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI := F'.isIntegral_stratum
    haveI := F'.isNormal_stratum
    haveI := F'.isLocallyNoetherian_stratum
    haveI : LocallyOfFiniteType (ιV ≫ jY Q ≫ sY) := F.isNormalVariety.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (ιV' ≫ jY Q' ≫ sY) := F'.isNormalVariety.1.toLocallyOfFiniteType
    intro φ hφ
    rcases toFun_eq_pluriformPullback_or_detects S hdltX ht ht' h R R' Q F hV with
      ⟨P, U, ιU, BU, G, hU, hG⟩ | ⟨d', hd', hD⟩
    · rcases toFun_eq_pluriformPullback_or_detects S hdltX ht ht' h R R' Q' F' hV' with
        ⟨P', U', ιU', BU', G', hU', hG'⟩ | ⟨d'', hd'', hD'⟩
      · haveI := G.isIntegral_stratum
        haveI := G.isNormal_stratum
        haveI := G.isLocallyNoetherian_stratum
        haveI := G'.isIntegral_stratum
        haveI := G'.isNormal_stratum
        haveI := G'.isLocallyNoetherian_stratum
        obtain ⟨ψ, hψ, h₁⟩ := hG
        obtain ⟨ψ', hψ', h₂⟩ := hG'
        exact hcopy _ Q Q' F F' hV hV' P P' U U' ιU ιU' BU BU' G G' hU hU' ψ ψ' hψ hψ' h₁ h₂ φ hφ
      · obtain rfl : d = d'' := by omega
        letI := functionFieldAlgebra (ιV ≫ jY Q ≫ sY)
        letI := functionFieldAlgebra (ιV' ≫ jY Q' ≫ sY)
        have key := hdet d ih Q' Q F' F hV' hV hD' φ.symm (IsCrepantBirationalMap.symm hφ)
        rw [← key, pluriformPullback_comp hV hV' hV _ φ.toHom
          (FunctionFieldEquiv.toHom _ _ φ.symm)]
        have hc : φ.toHom.comp (FunctionFieldEquiv.toHom _ _ φ.symm) =
            FunctionFieldEquiv.toHom (ιV ≫ jY Q ≫ sY) (ιV ≫ jY Q ≫ sY) 1 := by
          ext a
          exact φ.apply_symm_apply a
        rw [hc, pluriformPullback_one hV]
    · obtain rfl : d = d' := by omega
      exact hdet d ih Q Q' F F' hV hV' hD φ hφ

/-- **Admissibility.** Pinned floor sections are admissible together. -/
private theorem mem_admissibleSections_of_pins
    (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (hdltX : MMP.Intersection.IsDltPair sX B)
    {t : ∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)}
    {t' : ∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)}
    (ht : IsFloorSection sX n m B jX BX t) (ht' : IsFloorSection sY n m C jY BY t')
    (h : Pins sX sY n B C p q S.hpq BW m jX BX jY BY t t')
    (R : ResidueRestriction (fun P => jX P ≫ sX) BX n m)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY n m) :
    t ∈ admissibleSections R → t' ∈ admissibleSections R' := by
  intro hadm
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · intro Q Q' V V' ι ι' BV BV' F F' e _ _ hV hV' σ hσ
    have hl := F.dim_add_length (R'.setting.topologicalKrullDim_eq Q) hV
    have hl' := F'.dim_add_length (R'.setting.topologicalKrullDim_eq Q') hV'
    cases F with
    | step => simp [StratumAdjunctionData.length] at hl
    | refl hQ =>
    cases F' with
    | step => simp [StratumAdjunctionData.length] at hl'
    | refl hQ' =>
    obtain rfl : e = 0 := by simpa [StratumAdjunctionData.length] using hl
    obtain ⟨P, E, hpE, hqE, hpi, hqi⟩ := exists_floor_strictTransform_of_eq_zero S Q
    obtain ⟨P', E', hpE', hqE', hpi', hqi'⟩ := exists_floor_strictTransform_of_eq_zero S Q'
    have e1 := eq_of_heq (ResidueRestriction.toFun_refl R' Q hQ (t' Q))
    have e2 := eq_of_heq (ResidueRestriction.toFun_refl R' Q' hQ' (t' Q'))
    rw [e1, e2]
    exact pluriformPullback_floor_eq_of_strictTransform S ht ht' h R R' hadm hpE hqE hpE' hqE'
      σ hσ
  · intro Q Q' V V' ι ι' BV BV' F F' e _ _ hV hV' σ hσ
    exact isCompatibleInDim_of_admissible S hdltX ht ht' h R R' hadm e Q Q' F F' hV hV' σ hσ

/-! ### Assembly -/

/-- The floor sections of `X`, as a subspace. -/
private def floorSubmodule (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    Submodule ℂ (∀ P, logPluricanonicalSections (jX P ≫ sX) n m (BX P)) where
  carrier := {t | IsFloorSection sX n m B jX BX t}
  zero_mem' := isFloorSection_zero S
  add_mem' h₁ h₂ := IsFloorSection.add S h₁ h₂
  smul_mem' c _ h := IsFloorSection.smul S c h

/-- The identification on floor sections. -/
private noncomputable def floorMap (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY) :
    floorSubmodule S →ₗ[ℂ] (∀ Q, logPluricanonicalSections (jY Q ≫ sY) n m (BY Q)) where
  toFun t := (exists_pins S t.2).choose
  map_add' t₁ t₂ := by
    have h₁ := (exists_pins S t₁.2).choose_spec
    have h₂ := (exists_pins S t₂.2).choose_spec
    have h := (exists_pins S (t₁ + t₂).2).choose_spec
    exact eq_of_pins S (t₁ + t₂).2 h.1
      (IsFloorSection.add S.swap h₁.1 h₂.1) h.2 (Pins.add S t₁.2 t₂.2 h₁.1 h₂.1 h₁.2 h₂.2)
  map_smul' c t := by
    have h₁ := (exists_pins S t.2).choose_spec
    have h := (exists_pins S (c • t).2).choose_spec
    exact eq_of_pins S (c • t).2 h.1 (IsFloorSection.smul S.swap c h₁.1) h.2
      (Pins.smul S c t.2 h₁.1 h₁.2)

private theorem floorMap_spec (S : Setting sX sY n B C KX KY p q BW m CX jX BX CY jY BY)
    (t : floorSubmodule S) :
    IsFloorSection sY n m C jY BY (floorMap S t) ∧
      Pins sX sY n B C p q S.hpq BW m jX BX jY BY t (floorMap S t) :=
  (exists_pins S t.2).choose_spec

end Steps

end Proof_lem_fourfold_admissible_boundary_crepant_model_independence

