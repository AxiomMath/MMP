    exact CrepantModelAux.genericPoint_notMem_supp_of_coeff_eq_zero hDΓ
  have hcompN : (Divisor.toQDivisor (divisorOfForm θs) + BY Q).IsPullback (νC ≫ αN) hgenNa 0 := by
    have := CrepantModelAux.qDivisor_isPullback_comp' αN νC hH₁ hHν hgenNa
    rwa [hX0] at this
  have hgenβ := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' β
