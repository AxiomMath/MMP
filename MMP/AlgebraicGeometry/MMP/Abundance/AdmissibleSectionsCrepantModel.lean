private theorem ordForm_eq_neg_one_of_isExceptionalOverCurve_of_horizontal
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY 2 m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q)
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
      (D : DivisorOver ℂ sX)
      (_ : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g)),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (ι₂ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (_ : IsAdjunctionStep (jX P ≫ sX) (BX P) ι₂ BZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀
          (_ : ιZ (genericPoint TZ) = D.f D.E.genericPoint)
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : Function.Surjective resZ)
          (_ : ∀ (h : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ))
            (a : X.presheaf.stalk (ιZ (genericPoint TZ))),
            resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιZ.stalkMap (genericPoint TZ)).hom a)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : ∀ (r : X.presheaf.stalk (D.f D.E.genericPoint))
            (gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q)))),
            algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField r) →
            ((jY Q).stalkMap (genericPoint (CY Q))).hom gT = lam (resZ r))
          (_ : IsUnit v)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens) (_ : D.f D.E.genericPoint ∈ U)
          (_ : ∀ E : Mori.PrimeDivisor X,
            (E.support ∩ (U : Set X)).Nonempty →
            (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ)
                from formPow (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)) + B).coeff E = 0)
          (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 (show
              RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1))
            (formPow (exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) 1))
          (_ : ∀ g₀ : X.presheaf.stalk (D.f D.E.genericPoint), IsUnit g₀ →
            ∃ hgen, (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
                algebraMap _ X.functionField g₀ • formPow (exteriorPower.ιMulti X.functionField 3
                  fun a => (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                    (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                      (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                        (![z 0, z 1, v] a))) 1)) + B).IsPullback ιZ hgen
              (Divisor.toQDivisor (divisorOfForm
                (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ g₀ •
                  formPow (exteriorPower.ιMulti TZ.functionField 1
                    fun _ => (resZ v)⁻¹ • KaehlerDifferential.D ℂ TZ.functionField (resZ v)) 1)) +
                BZ))
          (Γ : Mori.PrimeDivisor (CY Q)) (_ : j (genericPoint G) = Γ.genericPoint)
          (_ : ∀ c : TZ.functionField, c ≠ 0 → Γ.divisorialValuation (lam c) = 1),
          (show RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
            (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
