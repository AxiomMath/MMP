  intro σ hσc D hv P TZ ι₂ BZ h₂ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr hresid
    hvu hτ'0 U hxU hU hρres hpbZu Γ hΓ hhor
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
