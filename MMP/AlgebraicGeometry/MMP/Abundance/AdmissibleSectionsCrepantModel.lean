  let sC : G ⟶ Spec (.of ℂ) := (j ≫ 𝟙 (CY Q)) ≫ jY Q ≫ sY
  have hsCdef : sC = (j ≫ 𝟙 (CY Q)) ≫ jY Q ≫ sY := rfl
  have hsC : j ≫ jY Q ≫ sY = sC := by rw [hsCdef]; simp
  have hsZ : ιZ ≫ sX = (ι₂ ≫ 𝟙 (CX P)) ≫ jX P ≫ sX := by rw [hιZ]; simp
  set ωt : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![et⁻¹ • KaehlerDifferential.D ℂ _ et,
      (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] with hωt
  have hεm : (algebraMap ℂ (CY Q).functionField εc) ^ m = 1 := by
    rcases hεc with rfl | rfl
    · rw [map_one, one_pow]
    · rw [map_neg, map_one]; exact St.hm.neg_one_pow
  letI := functionFieldAlgebra (j ≫ jY Q ≫ sY)
  have hψh : ∀ c, (FunctionFieldEquiv.toHom _ _ ψ) c = φ0 c := fun c => hψdef c
  haveI : IsNormal G := hj'.1.2
  haveI : LocallyOfFiniteType (j ≫ jY Q ≫ sY) := hj'.1.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian G := LocallyOfFiniteType.isLocallyNoetherian (j ≫ jY Q ≫ sY)
  haveI : CompactSpace G := QuasiCompact.compactSpace_of_compactSpace j
  haveI : LocallyOfFiniteType sC := by rw [← hsC]; infer_instance
  haveI : LocallyOfFiniteType ((ι₂ ≫ 𝟙 (CX P)) ≫ jX P ≫ sX) := by rw [← hsZ]; infer_instance
  have hψcr := CrepantModelAux.isCrepantBirationalMap_congr_right hsZ
    (fun c => (hφdef c).trans (hψdef c).symm) hφcr
  -- the residue restriction of `t` along `C_P ⊃ T_Z`
  have hpairP := (R.setting.isPair P).isPair
  have h₂' : IsAdjunctionStep (𝟙 (CX P) ≫ jX P ≫ sX) (BX P) ι₂ BZ := by
    rw [Category.id_comp]; exact h₂
  obtain ⟨ρX0, hρX0⟩ := CrepantModelAux.exists_heq_rationalPluriForms
    (Category.id_comp (jX P ≫ sX)).symm (t P : RationalPluriForms (jX P ≫ sX) 2 m)
  obtain ⟨ρX1, hρX1⟩ := CrepantModelAux.exists_heq_rationalPluriForms
    (s := ι₂ ≫ jX P ≫ sX) (s' := ι₂ ≫ 𝟙 (CX P) ≫ jX P ≫ sX) (by rw [Category.id_comp])
    (letI := functionFieldAlgebra (ι₂ ≫ jX P ≫ sX);
      resZ g • (show RationalPluriForms (ι₂ ≫ jX P ≫ sX) 1 m from
        formPow (exteriorPower.ιMulti TZ.functionField 1
          fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) m))
  have hrecX : IsIteratedResidueRec (t P : RationalPluriForms (jX P ≫ sX) 2 m)
      ((StratumAdjunctionData.refl hpairP).step ι₂ BZ h₂') 1
      (letI := functionFieldAlgebra ((ι₂ ≫ 𝟙 (CX P)) ≫ jX P ≫ sX);
        resZ g • (show RationalPluriForms ((ι₂ ≫ 𝟙 (CX P)) ≫ jX P ≫ sX) 1 m from
          formPow (exteriorPower.ιMulti TZ.functionField 1
            fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) m)) :=
    ⟨ρX0, ⟨rfl, hρX0.symm⟩, ρX1, CrepantModelAux.IsPoincareResidue.congr_structure
      (Category.id_comp _).symm hρP2 hρX0 hρX1,
      (CrepantModelAux.heq_smul_formPow_ιMulti_dlog (by simp) (resZ g) (fun _ => vb) m).trans
        hρX1⟩
  have hRX := IsIteratedResidueRec.unique _
    (R.isIteratedResidue P ((StratumAdjunctionData.refl hpairP).step ι₂ BZ h₂') 1 (t P)
      (by exact_mod_cast hdimZ)).rec' hrecX
  -- the residue restriction of `t'` along `G`
  let Θt : RationalPluriForms (jY Q ≫ sY) 2 m := formPow ωt m
  have hΘt : Θt = formPow ωt m := rfl
  have htQt : (t' Q : RationalPluriForms (jY Q ≫ sY) 2 m) = lam (resZ g) • Θt := by
    rw [← ht'Q, hΘt]
    change lam (resZ g) • formPow ωv m = lam (resZ g) • formPow ωt m
    rw [hωε, formPow_smul, hεm, one_smul]
  have hresY : IsPoincareResidue (jY Q ≫ sY) j 1 m (t' Q : RationalPluriForms (jY Q ≫ sY) 2 m)
      (φ0 (resZ g) • (show RationalPluriForms (j ≫ jY Q ≫ sY) 1 m from
        formPow (exteriorPower.ιMulti G.functionField 1
          fun _ => (φ0 vb)⁻¹ • KaehlerDifferential.D ℂ G.functionField (φ0 vb)) m)) := by
    have h1 := CrepantModelAux.IsPoincareResidue.smul_stalk (hresω m) (μ3 (resZ g))
    rw [hμ3] at h1
    rw [htQt, hΘt]
    exact h1
  obtain ⟨ρY0, hρY0⟩ := CrepantModelAux.exists_heq_rationalPluriForms (s := jY Q ≫ sY)
    (s' := 𝟙 (CY Q) ≫ jY Q ≫ sY) (Category.id_comp _).symm
    (t' Q : RationalPluriForms (jY Q ≫ sY) 2 m)
  obtain ⟨ρY1, hρY1⟩ := CrepantModelAux.exists_heq_rationalPluriForms (s := j ≫ jY Q ≫ sY)
    (s' := j ≫ 𝟙 (CY Q) ≫ jY Q ≫ sY) (by rw [Category.id_comp])
    (φ0 (resZ g) • (show RationalPluriForms (j ≫ jY Q ≫ sY) 1 m from
        formPow (exteriorPower.ιMulti G.functionField 1
          fun _ => (φ0 vb)⁻¹ • KaehlerDifferential.D ℂ G.functionField (φ0 vb)) m))
  have hrecY : IsIteratedResidueRec (t' Q : RationalPluriForms (jY Q ≫ sY) 2 m)
      ((StratumAdjunctionData.refl hQ).step j BG hj) 1
      (letI := functionFieldAlgebra sC;
        φ0 (resZ g) • (show RationalPluriForms sC 1 m from
          formPow (exteriorPower.ιMulti G.functionField 1
            fun _ => (φ0 vb)⁻¹ • KaehlerDifferential.D ℂ G.functionField (φ0 vb)) m)) :=
    ⟨ρY0, ⟨rfl, hρY0.symm⟩, ρY1, CrepantModelAux.IsPoincareResidue.congr_structure
      (Category.id_comp _).symm hresY hρY0 hρY1,
      (CrepantModelAux.heq_smul_formPow_ιMulti_dlog hsC.symm (φ0 (resZ g)) (fun _ => φ0 vb)
        m).trans hρY1⟩
  have hRY := IsIteratedResidueRec.unique _
    (R'.isIteratedResidue Q ((StratumAdjunctionData.refl hQ).step j BG hj) 1 (t' Q)
      (by exact_mod_cast hG)).rec' hrecY
  -- assembling: `G` is a crepant copy of `T_Z`
  refine ⟨P, TZ, ι₂ ≫ 𝟙 (CX P), BZ, (StratumAdjunctionData.refl hpairP).step ι₂ BZ h₂',
    by exact_mod_cast hdimZ, ψ, hψcr, ?_⟩
  rw [hRY, hRX]
  have h1 := CrepantModelAux.pluriformPullback_smul_formPow_dlog hG hdimZ ψ.toHom
    (fun _ => vb) m (resZ g)
  simp only [hψh] at h1
  exact h1.symm

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
valuation of `Γ` is centred at a closed point `z₀` of `T_Z` with uniformizer `s`, and
`τ_s = ĥ Ω` with `ĥ` a unit lifting `k' = dlog s̄ / dlog v̄` has residue
`θ_s = dlog ē ∧ dlog λ(s̄)` along `C_Q`. -/
private theorem exists_center_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX)
      (_ : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g))
      (_ : MMP.Mori.IsDiscrepancy sX (2 + 1) KX B D (-1)),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (_ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀ (_ : topologicalKrullDim TZ = (1 : ℕ))
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : Function.Surjective resZ)
          (_ : ∀ r ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (D.f D.E.genericPoint)), resZ r
              = 0)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : ∀ (r : X.presheaf.stalk (D.f D.E.genericPoint))
            (gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q)))),
            algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField r) →
            ((jY Q).stalkMap (genericPoint (CY Q))).hom gT = lam (resZ r))
          (_ : IsUnit v)
          (_ : Submodule.span TZ.functionField {KaehlerDifferential.D ℂ TZ.functionField (resZ
              v)} = ⊤)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens)
          (_ : ∀ E : Mori.PrimeDivisor X,
            (E.support ∩ (U : Set X)).Nonempty →
            (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ)
                from formPow (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)) + B).coeff E = 0)
          (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 (show
              RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1))
            (formPow (exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) 1))
          (Γ : Mori.PrimeDivisor (CY Q))
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1),
          ∃ (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing),
            (∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1) ∧
            (∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1) ∧
            (IsClosed ({Z₀.genericPoint} : Set TZ)) ∧
            (Irreducible s) ∧
            (IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s}) ∧
            (letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint)))) ∧
            (Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX)) ∧
            ∃ (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
              (U'' : X.Opens),
            (k' ≠ 0) ∧
            ((algebraMap Z₀.localRing TZ.functionField s)⁻¹ • KaehlerDifferential.D ℂ
                TZ.functionField (algebraMap Z₀.localRing TZ.functionField s) =
              k' • ((resZ v)⁻¹ • KaehlerDifferential.D ℂ TZ.functionField (resZ v))) ∧
            (resZ hh = k') ∧
            (IsUnit hh) ∧
            (D.f D.E.genericPoint ∈ U'') ∧
            (∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ)
                  from
              algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • (show
                  RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
                      X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1))) + B).coeff E = 0) ∧
            (exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (algebraMap Z₀.localRing TZ.functionField s))⁻¹ • KaehlerDifferential.D ℂ _
                    (lam (algebraMap Z₀.localRing TZ.functionField s))] =
              lam k' • exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (resZ v))⁻¹ • KaehlerDifferential.D ℂ _ (lam (resZ v))]) ∧
            (IsPoincareResidue sY (jY Q) 2 1
              (pluriformPullback sY sX σ.toHom (2 + 1) 1 (show RationalPluriForms sX (2 + 1) ((1 :
                  ℕ) : ℤ) from
              algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • (show
                  RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
                      X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)))
              (show RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) from
              formPow (exteriorPower.ιMulti (CY Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam (algebraMap Z₀.localRing TZ.functionField s))⁻¹ • KaehlerDifferential.D ℂ _
                    (lam (algebraMap Z₀.localRing TZ.functionField s))]) 1)) := by
  intro σ D hv ha P TZ ι₂ BZ ιZ FZ hdimZ z v g resZ lam eb hresZs hresZm hlamk hgentr hresid hvu
    hwZ' hτ'0 U hU hρres Γ c₁ hc₁0 hc₁
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  -- the centre `z₀` of `μ ∘ λ` on `T_Z`, a closed point
  set ν : Valuation TZ.functionField ℤᵐ⁰ := μ.comap lam with hν
  haveI : IsProper (ιZ ≫ sX) := inferInstance
  obtain ⟨z₀, hz₀le, hz₀lt⟩ := CrepantModelAux.exists_dominates_of_isProper_of_trivial
    (sX := ιZ ≫ sX) inferInstance ν (fun c hc => by
      have e1 : (((Scheme.ΓSpecIso (.of ℂ)).inv ≫ (ιZ ≫ sX).appTop ≫
          TZ.presheaf.germ ⊤ (genericPoint TZ) trivial).hom) c = algebraMap ℂ TZ.functionField c :=
        rfl
      rw [e1, hν, Valuation.comap_apply, hlamk]
      letI := stalkAlgebra (jY Q ≫ sY) Γ.genericPoint
      haveI := isScalarTower_stalk_functionField (jY Q ≫ sY) Γ.genericPoint
      have hc0 : algebraMap ℂ (CY Q).functionField c ≠ 0 := (map_ne_zero _).2 hc
      rw [hμ, Γ.divisorialValuation_eq_exp_neg_ord hc0,
        IsScalarTower.algebraMap_apply ℂ ((CY Q).presheaf.stalk Γ.genericPoint) (CY Q).functionField c,
        ord_algebraMap_eq_zero_of_isUnit' Γ rfl
          ((isUnit_iff_ne_zero.2 hc).map _)]
      rfl)
  -- `z₀` is a closed point of `T_Z`, with uniformizer `s`
  have hz₀ne : z₀ ≠ genericPoint TZ := by
    rintro rfl
    letI : Algebra (TZ.presheaf.stalk (genericPoint TZ)) TZ.functionField :=
      AlgebraicGeometry.stalkFunctionFieldAlgebra TZ (genericPoint TZ)
    have hfield : IsField (TZ.presheaf.stalk (genericPoint TZ)) := Field.toIsField TZ.functionField
    have hsurj := (IsFractionRing.surjective_iff_isField (R := TZ.presheaf.stalk (genericPoint TZ))
      (K := TZ.functionField)).2 hfield
    obtain ⟨a, ha⟩ := hsurj c₁
    obtain ⟨b, hb⟩ := hsurj c₁⁻¹
    have h1 := hz₀le a
    have h2 := hz₀le b
    rw [ha] at h1
    rw [hb] at h2
    apply hc₁
    have h3 : ν c₁ * ν c₁⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel₀ hc₁0, map_one]
    change ν c₁ = 1
    refine le_antisymm h1 ?_
    calc (1 : ℤᵐ⁰) = ν c₁ * ν c₁⁻¹ := h3.symm
      _ ≤ ν c₁ * 1 := mul_le_mul' le_rfl h2
      _ = ν c₁ := mul_one _
  have hcoh1 : 1 ≤ Order.coheight z₀ := by
    by_contra hlt
    push Not at hlt
    have h0 : Order.coheight z₀ = 0 := ENat.lt_one_iff_eq_zero.1 hlt
    rw [Order.coheight_eq_zero] at h0
    apply hz₀ne
    have h1 : z₀ ≤ genericPoint TZ :=
      (Scheme.le_iff_specializes).2 ((genericPoint_spec TZ).specializes trivial)
    exact ((Scheme.le_iff_specializes).1 (h0 h1)).antisymm
      ((Scheme.le_iff_specializes).1 h1) |>.eq
  have hcohle : Order.coheight z₀ ≤ 1 := by
    have h5 := AlgebraicGeometry.coheight_le_topologicalKrullDim z₀
    rw [hdimZ] at h5
    exact_mod_cast WithBot.coe_le_coe.mp h5
  have hcoh : Order.coheight z₀ = 1 := le_antisymm hcohle hcoh1
  obtain ⟨Z₀, hZ₀⟩ : ∃ Z : Mori.PrimeDivisor TZ, Z.genericPoint = z₀ :=
    ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh,
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hcoh⟩
  subst hZ₀
  have hz₀cl : IsClosed ({Z₀.genericPoint} : Set TZ) :=
    CrepantModelAux.isClosed_singleton_of_le_coheight (d := 1) hdimZ.le (by rw [hcoh]; rfl)
  haveI := Z₀.isDiscreteValuationRing_localRing
  obtain ⟨s, hs⟩ := IsDiscreteValuationRing.exists_irreducible Z₀.localRing
  have hs_span : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer s).1 hs
  letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint
  haveI := isScalarTower_stalk_functionField (ιZ ≫ sX) Z₀.genericPoint
  have hres₀ := CrepantModelAux.surjective_algebraMap_residueField_of_isClosed (ιZ ≫ sX) _ hz₀cl
  have hreg : IsRegularSystemOfParameters (![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) := by
    refine ⟨by rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]; exact hs_span.symm, ?_⟩
    rw [ringKrullDim_stalk_eq_coheight, Z₀.coheight_genericPoint]; rfl
  haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hreg
  have hsm₀ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX) :=
    CrepantModelAux.mem_smoothLocus_of_isRegularLocalRing _ Z₀.genericPoint
  have hspan_s := CrepantModelAux.span_D_algebraMap_eq_top_of_span_eq_maximalIdeal
    (sZ := ιZ ≫ sX) Z₀.genericPoint hres₀ s hs_span hsm₀
  -- `dlog s̄ = k' dlog v̄`
  set sK : TZ.functionField := algebraMap _ TZ.functionField s with hsK
  set vb : TZ.functionField := resZ v with hvb
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  have hsK0 : sK ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hs.ne_zero
  have hnt : Nontrivial Ω[TZ.functionField⁄ℂ] := by
    obtain ⟨b⟩ := exists_basis_topForms (sX := ιZ ≫ sX) hdimZ
    have : Nontrivial (⋀[TZ.functionField]^1 Ω[TZ.functionField⁄ℂ]) :=
      nontrivial_of_ne _ _ (b.ne_zero ())
    exact (exteriorPower.oneEquiv TZ.functionField Ω[TZ.functionField⁄ℂ]).symm.toEquiv.nontrivial
  obtain ⟨k₀, hk₀⟩ := Submodule.mem_span_singleton.1
    (show KaehlerDifferential.D ℂ TZ.functionField sK ∈
      Submodule.span TZ.functionField {KaehlerDifferential.D ℂ TZ.functionField vb} by
        rw [hwZ']; trivial)
  have hk₀0 : k₀ ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hk₀
    rw [← hk₀, Submodule.span_singleton_eq_bot.2 rfl] at hspan_s
    exact bot_ne_top hspan_s
  set k' : TZ.functionField := k₀ * vb / sK with hk'
  have hk'0 : k' ≠ 0 := div_ne_zero (mul_ne_zero hk₀0 hvb0) hsK0
  have hdlogs : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
      k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) := by
    rw [← hk₀, smul_smul, smul_smul, hk']
    congr 1
    field_simp
  -- the unit `ĥ` lifting `k'`, and `τ_s = ĥ Ω`
  obtain ⟨hh, hhh⟩ := hresZs k'
  have hhu : IsUnit hh := by
    by_contra hnu
    exact hk'0 (by rw [← hhh]; exact hresZm _ ((IsLocalRing.mem_maximalIdeal _).2 hnu))
  set Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) with hΩv
  have hhK0 : algebraMap _ X.functionField hh ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hhu.ne_zero
  set τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := algebraMap _ X.functionField hh • Ωv
    with hτs
  have hτs0 : τs ≠ 0 := smul_ne_zero hhK0 hτ'0
  obtain ⟨U'', hxU'', hU''⟩ := CrepantModelAux.exists_open_ord_eq_zero hhu
  have hU' : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
      (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0 := by
    rintro E ⟨y, hyE, hyU, hyU''⟩
    have h1 := hU E ⟨y, hyE, hyU⟩
    have h2 := hU'' E ⟨y, hyE, hyU''⟩
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm] at h1 ⊢
    rw [hτs, E.ordForm_smul_of_topologicalKrullDim_eq St.hdimX hhK0 hτ'0, h2, zero_add]
    exact h1
  -- the residue `θ_s = dlog ē ∧ dlog λ(s̄)` of `σ^*τ_s`
  set ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
      (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] with hωv
  set ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti
    (CY Q).functionField 2 ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
      (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)] with hωs
  let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
  have hθs : θs = formPow ωs 1 := rfl
  have hmapD : ∀ a : TZ.functionField, KaehlerDifferential.map ℂ ℂ TZ.functionField
      (CY Q).functionField (KaehlerDifferential.D ℂ TZ.functionField a) =
      KaehlerDifferential.D ℂ (CY Q).functionField (lam a) := fun a =>
    KaehlerDifferential.map_D ℂ ℂ TZ.functionField (CY Q).functionField a
  have hdlogs' : (lam sK)⁻¹ • KaehlerDifferential.D ℂ (CY Q).functionField (lam sK) =
      lam k' • ((lam vb)⁻¹ • KaehlerDifferential.D ℂ (CY Q).functionField (lam vb)) := by
    have h1 := congrArg (KaehlerDifferential.map ℂ ℂ TZ.functionField (CY Q).functionField) hdlogs
    rw [LinearMap.map_smul, LinearMap.map_smul, LinearMap.map_smul, hmapD, hmapD] at h1
    rw [← map_inv₀ lam sK, ← map_inv₀ lam vb]
    change algebraMap TZ.functionField (CY Q).functionField sK⁻¹ • _ =
      algebraMap TZ.functionField (CY Q).functionField k' •
        (algebraMap TZ.functionField (CY Q).functionField vb⁻¹ • _)
    rw [algebraMap_smul, algebraMap_smul, algebraMap_smul]
    exact h1
  have hωsv : ωs = lam k' • ωv := by
    rw [hωs, hωv, hdlogs']
    have hupd : ∀ w : Ω[(CY Q).functionField⁄ℂ], (![eb⁻¹ • KaehlerDifferential.D ℂ _ eb, w] :
        Fin 2 → Ω[(CY Q).functionField⁄ℂ]) =
        Function.update ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
          (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)] 1 w := by
      intro w; funext i; fin_cases i <;> rfl
    rw [hupd, (exteriorPower.ιMulti (CY Q).functionField 2).map_update_smul, ← hupd]
  obtain ⟨gT, hgT⟩ : ∃ gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q))),
      algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField hh) := by
    apply CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Q.1 hP
    rw [← hv]
    exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D _ rfl hh
  have hρs : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
      θs := by
    have h1 := IsPoincareResidue.algebraMap_smul' hρres gT
    rw [hgT, ← CrepantModelAux.pluriformPullback_smul_left, hresid hh gT hgT, hhh] at h1
    rw [hθs, hωsv, formPow_smul, pow_one]
    exact h1
  exact ⟨Z₀, s, hz₀le, hz₀lt, hz₀cl, hs, hs_span, hres₀, hsm₀, k', hh, U'', hk'0, hdlogs, hhh,
    hhu, hxU'', hU', hωsv, hρs⟩

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
divisor `div(dlog s̄) + B_Z` has coefficient `B_Z(z₀) - 1` at `z₀`. -/
private theorem coeff_eq_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (_ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀ (_ : topologicalKrullDim TZ = (1 : ℕ))
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : IsUnit v)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens)
          (Γ : Mori.PrimeDivisor (CY Q))
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1)
          (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing)
          (_ : ∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1)
          (_ : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1)
          (_ : IsClosed ({Z₀.genericPoint} : Set TZ))
          (_ : Irreducible s)
          (_ : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s})
          (_ : letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint))))
          (_ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX))
          (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
          (U'' : X.Opens),
          let sK : TZ.functionField := algebraMap Z₀.localRing TZ.functionField s
          let vb : TZ.functionField := resZ v
          let Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 +
              1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)
          let τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) :=
            algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • Ωv
          let ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)]
          let ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)]
          let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
          ∀ (_ : k' ≠ 0)
            (_ : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
              k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb))
            (_ : resZ hh = k')
            (_ : IsUnit hh)
            (_ : D.f D.E.genericPoint ∈ U'')
            (_ : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0)
            (_ : ωs = lam k' • ωv)
            (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
                θs),
          (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from
              resZ hh • formPow (exteriorPower.ιMulti TZ.functionField 1
                fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ).coeff Z₀ =
                    (BZ.coeff Z₀ : ℚ) - 1 := by
  intro σ D P TZ ι₂ BZ ιZ FZ hdimZ z v g resZ lam eb hlamk hgentr hvu hτ'0 U Γ c₁ hc₁0 hc₁ Z₀ s
    hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U'' sK vb Ωv τs ωv ωs θs hk'0 hdlogs hhh hhu
    hxU'' hU' hωsv hρs
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  -- the centre `z₀` of `μ ∘ λ` on `T_Z`, a closed point
  set ν : Valuation TZ.functionField ℤᵐ⁰ := μ.comap lam with hν
  haveI := Z₀.isDiscreteValuationRing_localRing
  letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint
  haveI := isScalarTower_stalk_functionField (ιZ ≫ sX) Z₀.genericPoint
  have hreg : IsRegularSystemOfParameters (![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) := by
    refine ⟨by rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]; exact hs_span.symm, ?_⟩
    rw [ringKrullDim_stalk_eq_coheight, Z₀.coheight_genericPoint]; rfl
  haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hreg
  have hsK : sK = algebraMap _ TZ.functionField s := rfl
  have hvb : vb = resZ v := rfl
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  have hsK0 : sK ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hs.ne_zero
  have hhK0 : algebraMap _ X.functionField hh ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hhu.ne_zero
  have hτs : τs = algebraMap _ X.functionField hh • Ωv := rfl
  have hτs0 : τs ≠ 0 := smul_ne_zero hhK0 hτ'0
  have hθs : θs = formPow ωs 1 := rfl
  let HZ : QDivisor TZ := Divisor.toQDivisor (divisorOfForm
    (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ hh •
      formPow (exteriorPower.ιMulti TZ.functionField 1
        fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ
  have hHZ : HZ = Divisor.toQDivisor (divisorOfForm
    (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ hh •
      formPow (exteriorPower.ιMulti TZ.functionField 1
        fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ := rfl
  have hformZ : (resZ hh • (formPow (exteriorPower.ιMulti TZ.functionField 1
      fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1 :
        RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ))) =
      formPow (exteriorPower.ιMulti TZ.functionField 1
        fun _ => sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK) 1 := by
    have h1 : (fun _ : Fin 1 => sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK) =
        fun _ => k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) := funext fun _ => hdlogs
    have h2 := (exteriorPower.ιMulti TZ.functionField 1).map_smul_univ (fun _ : Fin 1 => k')
      (fun _ : Fin 1 => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb)
    simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin, pow_one] at h2
    rw [h1, h2, formPow_smul, pow_one, hhh]
  -- the coefficient of `H_Z` at `z₀` is `B_Z(z₀) - 1`
  obtain ⟨r0, ⟨b0⟩⟩ := CrepantModelAux.exists_basis_kaehler_stalk_of_mem_smoothLocus (ιZ ≫ sX) hsm₀
  haveI : Module.Finite (TZ.presheaf.stalk Z₀.genericPoint)
      Ω[TZ.presheaf.stalk Z₀.genericPoint⁄ℂ] := Module.Finite.of_basis b0
  have hwZ₀ := CrepantModelAux.span_D_eq_top_of_span_eq_maximalIdeal hres₀ ![s] (by
    rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty, hs_span])
  have hmemZ₀ : Z₀.genericPoint ∈ Z₀.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hLzZ₀ : IdealSheafData.stalk Z₀.idealSheaf Z₀.genericPoint =
      Ideal.span {(![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) 0} := by
    rw [MMP.Resolution.Aux.stalk_idealSheaf_genericPoint]; exact hs_span
  have hordZ₀ := CrepantModelAux.ordForm_formPow_dlog_eq (sX := ιZ ≫ sX) hdimZ 1 ![s]
    (fun a => by fin_cases a; exact hs.ne_zero) hwZ₀ ![Z₀] (fun a b _ => Subsingleton.elim a b)
    (fun a => by fin_cases a; exact hmemZ₀) (fun a => by fin_cases a; exact hLzZ₀) Z₀ hmemZ₀
  rw [if_pos ⟨0, rfl⟩] at hordZ₀
  have hfunZ : (fun a : Fin 1 => (algebraMap (TZ.presheaf.stalk Z₀.genericPoint) TZ.functionField
      ((![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) a))⁻¹ •
        KaehlerDifferential.D ℂ TZ.functionField
        (algebraMap (TZ.presheaf.stalk Z₀.genericPoint) TZ.functionField
          ((![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) a))) =
      fun _ => sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK := by
    funext a; fin_cases a; rfl
  rw [hfunZ] at hordZ₀
  have hHZ₀ : HZ.coeff Z₀ = (BZ.coeff Z₀ : ℚ) - 1 := by
    rw [hHZ, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hformZ,
      hordZ₀]
    push_cast; ring
  exact hHZ₀

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
pull-back of `div(dlog s̄) + B_Z` to the strict transform `Γ_N` of `Γ` has coefficient
`ord_Γ θ_s + 1 = (B_Z(z₀) - 1) e` with `e ≥ 1`. -/
private theorem exists_coeff_eq_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY 2 m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q)
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
      (D : DivisorOver ℂ sX)
      (_ : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g))
      (_ : MMP.Mori.IsDiscrepancy sX (2 + 1) KX B D (-1)),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (_ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀
          (_ : ιZ (genericPoint TZ) = D.f D.E.genericPoint)
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : Function.Surjective resZ)
          (_ : ∀ (h : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ))
            (a : X.presheaf.stalk (ιZ (genericPoint TZ))),
            resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιZ.stalkMap (genericPoint TZ)).hom a)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : ∀ (r : X.presheaf.stalk (D.f D.E.genericPoint))
            (gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q)))),
            algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField r) →
            ((jY Q).stalkMap (genericPoint (CY Q))).hom gT = lam (resZ r))
          (_ : IsUnit v)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens) (_ : D.f D.E.genericPoint ∈ U)
          (_ : ∀ g₀ : X.presheaf.stalk (D.f D.E.genericPoint), IsUnit g₀ →
            ∃ hgen, (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
                algebraMap _ X.functionField g₀ • formPow (exteriorPower.ιMulti X.functionField 3
                  fun a => (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                    (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                      (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                        (![z 0, z 1, v] a))) 1)) + B).IsPullback ιZ hgen
              (Divisor.toQDivisor (divisorOfForm
                (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ g₀ •
                  formPow (exteriorPower.ιMulti TZ.functionField 1
                    fun _ => (resZ v)⁻¹ • KaehlerDifferential.D ℂ TZ.functionField (resZ v)) 1)) +
                BZ))
          (Γ : Mori.PrimeDivisor (CY Q)) (_ : j (genericPoint G) = Γ.genericPoint)
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1)
          (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing)
          (_ : ∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1)
          (_ : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1)
          (_ : IsClosed ({Z₀.genericPoint} : Set TZ))
          (_ : Irreducible s)
          (_ : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s})
          (_ : letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint))))
          (_ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX))
          (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
          (U'' : X.Opens),
          let sK : TZ.functionField := algebraMap Z₀.localRing TZ.functionField s
          let vb : TZ.functionField := resZ v
          let Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 +
              1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)
          let τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) :=
            algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • Ωv
          let ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)]
          let ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)]
          let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
          ∀ (_ : k' ≠ 0)
            (_ : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
              k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb))
            (_ : resZ hh = k')
            (_ : IsUnit hh)
            (_ : D.f D.E.genericPoint ∈ U'')
            (_ : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0)
            (_ : ωs = lam k' • ωv)
            (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
                θs)
            (_ : (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ)
                : ℤ) from
              resZ hh • formPow (exteriorPower.ιMulti TZ.functionField 1
                fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ).coeff Z₀ =
                    (BZ.coeff Z₀ : ℚ) - 1),
          θs ≠ 0 ∧
            ∃ e : ℤ, 1 ≤ e ∧ ((Γ.ordForm θs : ℤ) : ℚ) + 1 = ((BZ.coeff Z₀ : ℚ) - 1) * e := by
  intro σ hσc D hv ha P TZ ι₂ BZ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr hresid
    hvu hτ'0 U hxU hpbZu Γ hΓ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U''
    sK vb Ωv τs ωv ωs θs hk'0 hdlogs hhh hhu hxU'' hU' hωsv hρs hHZ₀
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  -- the centre `z₀` of `μ ∘ λ` on `T_Z`, a closed point
  set ν : Valuation TZ.functionField ℤᵐ⁰ := μ.comap lam with hν
  haveI := Z₀.isDiscreteValuationRing_localRing
  letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint
  haveI := isScalarTower_stalk_functionField (ιZ ≫ sX) Z₀.genericPoint
  have hreg : IsRegularSystemOfParameters (![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) := by
    refine ⟨by rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]; exact hs_span.symm, ?_⟩
    rw [ringKrullDim_stalk_eq_coheight, Z₀.coheight_genericPoint]; rfl
  haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hreg
  have hsK : sK = algebraMap _ TZ.functionField s := rfl
  have hvb : vb = resZ v := rfl
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  have hsK0 : sK ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hs.ne_zero
  have hhK0 : algebraMap _ X.functionField hh ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hhu.ne_zero
  have hτs : τs = algebraMap _ X.functionField hh • Ωv := rfl
  have hτs0 : τs ≠ 0 := smul_ne_zero hhK0 hτ'0
  have hθs : θs = formPow ωs 1 := rfl
  -- the normalized strict transform `N` of `Q` and the factorization through `T_Z`
  obtain ⟨-, -, -, -, -, -, -, -, hC1, -⟩ := hcurveQ
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmY
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  have hKBX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmX
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  haveI : IsNoetherian (CY Q) := {}
  haveI : IsNoetherian X := {}
  obtain ⟨W, N, _, _, _, _, _, pW, qW, νN, αN, _, _, _, _, hN₁⟩ :=
    CrepantModelAux.exists_normalization_isPullback_of_isAdjunctionStep hYn hXn St.hdimY St.hdimX
      St.hKY St.hKX hKBY hKBX σ hσc (St.hjY Q).1 Q.1 (St.hjY Q).2 hC1 D hv hτs0 (U ⊓ U'')
      ⟨hxU, hxU''⟩ hU' hρs
  obtain ⟨hαb, hNα, hα, hcompat, hqν, hpν, hρs0, hqT, hN₂⟩ := hN₁
  obtain ⟨H, hgen₁, hgen₂, hH₁, hH₂⟩ := hN₂
  haveI : QuasiCompact (νN ≫ qW) := quasiCompact_of_compactSpace _
  have hrange : Set.range (νN ≫ qW).base ⊆ Set.range ιZ.base := by
    rintro _ ⟨n, rfl⟩
    have h0 : genericPoint N ⤳ n := (genericPoint_spec N).specializes trivial
    have h1 : D.f D.E.genericPoint ⤳ (νN ≫ qW) n := by
      rw [← hqν]
      exact h0.map (νN ≫ qW).base.hom.continuous
    exact h1.mem_closed ιZ.isClosedEmbedding.isClosed_range ⟨_, hgenZ⟩
  obtain ⟨πN, hπN⟩ := CrepantModelAux.exists_comp_eq_of_range_subset ιZ (νN ≫ qW) hrange
  have hπη : πN (genericPoint N) = genericPoint TZ := by
    apply ιZ.isClosedEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hπN, hgenZ]
    exact hqν
  haveI : IsDominant πN := ⟨Dense.mono (s₁ := {genericPoint TZ})
    (Set.singleton_subset_iff.mpr ⟨_, hπη⟩) (dense_iff_closure_eq.mpr (genericPoint_spec TZ))⟩
  -- `H = π_N^*(div(dlog s̄) + B_Z)`
  have hQτs : (Divisor.toQDivisor (divisorOfForm τs) + B).IsQCartier :=
    hKBX.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hXn St.hKX hτs0).symm)
  obtain ⟨hgenZs, hpbZs⟩ := hpbZu hh hhu
  set HZ : QDivisor TZ := Divisor.toQDivisor (divisorOfForm
    (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ hh •
      formPow (exteriorPower.ιMulti TZ.functionField 1
        fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ with hHZ
  have hqZ : HZ.IsQCartier := CrepantModelAux.isQCartier_of_isPullback hQτs hpbZs
  have hgenπ := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' πN HZ
  have hHπ := QDivisor.isPullback_pullback hqZ hgenπ
  have hHeq : H = QDivisor.pullback _ hqZ hgenπ :=
    (QDivisor.IsQCartier.existsUnique_isPullback hQτs hgen₂).unique hH₂
      (CrepantModelAux.isPullback_of_hom_eq hπN
        (CrepantModelAux.qDivisor_isPullback_comp' ιZ πN hpbZs hHπ (by rw [hπN]; exact hgen₂)))
  -- `π_N^* = α_N^* ∘ λ` on `k(T_Z)`
  have hpsp : pW (νN (genericPoint N)) ⤳ jY Q (genericPoint (CY Q)) := by rw [hpν]
  have hFF : ∀ a : TZ.functionField, functionFieldMap πN a = functionFieldMap αN (lam a) := by
    intro a
    obtain ⟨r, rfl⟩ := hresZs a
    have h1 : ιZ (genericPoint TZ) ⤳ D.f D.E.genericPoint := by rw [hgenZ]
    have h2 : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ) := by rw [hgenZ]
    have h3 : qW (νN (genericPoint N)) ⤳ D.f D.E.genericPoint := by rw [hqν]
    have hp : qW (νN (genericPoint N)) ⤳ ιZ (genericPoint TZ) := by rw [hqν, hgenZ]
    have e0 : (X.presheaf.stalkSpecializes h2).hom ((X.presheaf.stalkSpecializes h1).hom r) = r := by
      rw [← CommRingCat.comp_apply, TopCat.Presheaf.stalkSpecializes_comp,
        TopCat.Presheaf.stalkSpecializes_refl]
      rfl
    have e1 : resZ r = (ιZ.stalkMap (genericPoint TZ)).hom ((X.presheaf.stalkSpecializes h1).hom r) := by
      conv_lhs => rw [← e0]
      exact hstalkZ h2 _
    conv_lhs => rw [e1, ← stalkMap_apply_eq_functionFieldMap_apply qW ιZ νN πN hπN hp]
    have e2 : (X.presheaf.stalkSpecializes hp).hom ((X.presheaf.stalkSpecializes h1).hom r) =
        (X.presheaf.stalkSpecializes h3).hom r := by
      rw [← CommRingCat.comp_apply, TopCat.Presheaf.stalkSpecializes_comp]
    rw [e2]
    obtain ⟨gP, hgP⟩ : ∃ gP : Y.presheaf.stalk (jY Q (genericPoint (CY Q))),
        algebraMap _ Y.functionField gP = (σ.toHom) (algebraMap _ X.functionField r) := by
      apply CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Q.1 hP
      rw [← hv]
      exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D _ rfl r
    have hgP' : algebraMap _ Y.functionField gP = (σ.toHom) (algebraMap _ X.functionField
        ((X.presheaf.stalkSpecializes h3).hom r)) := by
      rw [hgP, Mori.algebraMap_stalkSpecializes]
    have hc := CrepantModelAux.algebraMap_stalkMap_stalkMap_eq_functionFieldMap
      (σ.toHom : X.functionField →ₐ[ℂ] Y.functionField).toRingHom pW qW hcompat (jY Q) νN αN hα
      hpsp (genericPoint N) ((X.presheaf.stalkSpecializes h3).hom r) gP hgP'
    rw [hresid r gP hgP] at hc
    rw [← hc, CrepantModelAux.algebraMap_stalk_genericPoint_apply]
  -- the strict transform `Γ_N` of `Γ`: `coeff_{Γ_N} H = ord_Γ θ_s + 1`
  have hBΓ : (BY Q).coeff Γ = 1 := by
    obtain ⟨-, P', hP'1, hP'r, -⟩ := hj'
    have hP'Γ : P' = Γ := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((CrepantModelAux.map_genericPoint_eq_of_range_eq j P' hP'r).symm.trans hΓ)
    subst hP'Γ
    exact le_antisymm ((R'.setting.isDltPair Q).2.1 P') hP'1
  haveI : LocallyOfFiniteType (αN ≫ jY Q ≫ sY) := hNα.1.toLocallyOfFiniteType
  obtain ⟨CN, hCN, hCNiso, hCNv, hcoeffCN⟩ :=
    CrepantModelAux.exists_primeDivisor_coeff_isPullback_eq hT αN hαb hNα hdT hρs0 hqT hH₁ Γ
  rw [hBΓ] at hcoeffCN
  -- `Γ_N` lies over `z₀`
  have hdom1 : ∀ a : TZ.presheaf.stalk (πN CN.genericPoint),
      ν (algebraMap _ TZ.functionField a) ≤ 1 := by
    intro a
    rw [hν, Valuation.comap_apply, hμ, ← hCNv, ← hFF, MMP.Mori.functionFieldMap_algebraMap_stalk]
    exact (CN.divisorialValuation_le_one_iff _).2 ⟨_, rfl⟩
  have hdom2 : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk (πN CN.genericPoint)),
      ν (algebraMap _ TZ.functionField a) < 1 := by
    intro a ha
    rw [hν, Valuation.comap_apply, hμ, ← hCNv, ← hFF, MMP.Mori.functionFieldMap_algebraMap_stalk]
    exact (CN.divisorialValuation_algebraMap_lt_one_iff _).2
      (map_nonunit (πN.stalkMap CN.genericPoint).hom a ha)
  have hπZ : πN CN.genericPoint = Z₀.genericPoint :=
    MMP.Positivity.DivisorOver.eq_of_dominates (ιZ ≫ sX) ν hdom1 hdom2 hz₀le hz₀lt
  -- the coefficient of `π_N^*H_Z` at `Γ_N`: `(B_Z(z₀) - 1) e` with `e = ord_{Γ_N} π_N^* s̄`
  have hsm : s ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) := by
    rw [hs_span]; exact Ideal.mem_span_singleton_self s
  obtain ⟨s', hs'⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Z₀ hπZ
    (f := sK) ((Z₀.divisorialValuation_le_one_iff _).2 ⟨s, rfl⟩)
  have hs'm : s' ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk (πN CN.genericPoint)) := by
    rw [CrepantModelAux.mem_maximalIdeal_iff_divisorialValuation_lt_one Z₀ hπZ, hs']
    exact (Z₀.divisorialValuation_algebraMap_lt_one_iff s).2 hsm
  have hs'0 : s' ≠ 0 := by
    rintro rfl; rw [map_zero] at hs'; exact hsK0 hs'.symm
  set e : ℤ := N.ord (functionFieldMap πN sK) CN.genericPoint with he
  have hπs : functionFieldMap πN sK = algebraMap _ N.functionField ((πN.stalkMap CN.genericPoint).hom s') := by
    rw [← hs', MMP.Mori.functionFieldMap_algebraMap_stalk]
  have hπs0 : (πN.stalkMap CN.genericPoint).hom s' ≠ 0 := by
    intro h0; rw [h0, map_zero, map_eq_zero] at hπs; exact hsK0 hπs
  have he1 : 1 ≤ e := by
    rw [he, hπs]
    exact (CrepantModelAux.one_le_ord_iff_mem_maximalIdeal CN rfl hπs0).2
      (map_nonunit (πN.stalkMap CN.genericPoint).hom s' hs'm)
  have hm₀ := QDivisor.cartierIndex_pos hqZ
  obtain ⟨D₀, hD₀, hD₀c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hqZ
  obtain ⟨D₀', hD₀', hpb₀⟩ := hHπ _ hm₀ D₀ hD₀ hD₀c
  obtain ⟨U₁, hzU₁, φ₁, hφ₁⟩ := hD₀c Z₀.genericPoint
  have hcCN := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hpb₀ hφ₁ CN
    (by rw [hπZ]; exact hzU₁) Z₀.component
  have hcZ := hφ₁ Z₀ ⟨Z₀.genericPoint, by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl, hzU₁⟩
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord] at hcZ
  set f₁ := MMP.Threefold.Mori.Helpers.evalFF Z₀.component (φ₁ : RationalFunctions TZ) with hf₁
  have hf₁0 : f₁ ≠ 0 := (φ₁.isUnit.map _).ne_zero
  -- `f₁ = s̄^N w` with `w` a unit at `z₀`
  set Nc : ℤ := TZ.ord f₁ Z₀.genericPoint with hNc
  set w : TZ.functionField := f₁ * sK ^ (-Nc) with hw
  have hw0 : w ≠ 0 := mul_ne_zero hf₁0 (zpow_ne_zero _ hsK0)
  have hsK1 : TZ.ord sK Z₀.genericPoint = 1 := by
    have h := Z₀.divisorialValuation_algebraMap_of_irreducible hs
    rw [← hsK, Z₀.divisorialValuation_eq_exp_neg_ord hsK0] at h
    have := WithZero.exp_injective h
    omega
  have hwZ : TZ.ord w Z₀.genericPoint = 0 := by
    rw [hw, Scheme.ord_mul hf₁0 (zpow_ne_zero _ hsK0), ord_zpow _ hsK0, hsK1, ← hNc]; ring
  obtain ⟨wu, hwu⟩ := CrepantModelAux.exists_algebraMap_eq_of_divisorialValuation_le_one Z₀ hπZ
    (f := w) (by rw [Z₀.divisorialValuation_eq_exp_neg_ord hw0, hwZ]; rfl)
  have hwuu : IsUnit wu := by
    by_contra hnu
    have := (CrepantModelAux.mem_maximalIdeal_iff_divisorialValuation_lt_one Z₀ hπZ wu).1
      ((IsLocalRing.mem_maximalIdeal _).2 hnu)
    rw [hwu, Z₀.divisorialValuation_eq_exp_neg_ord hw0, hwZ] at this
    exact lt_irrefl _ this
  have hordw : N.ord (functionFieldMap πN w) CN.genericPoint = 0 := by
    rw [← hwu, MMP.Mori.functionFieldMap_algebraMap_stalk]
    exact ord_algebraMap_eq_zero_of_isUnit' CN rfl (hwuu.map _)
  have hf₁eq : f₁ = sK ^ Nc * w := by
    rw [hw, mul_comm f₁, ← mul_assoc, ← zpow_add₀ hsK0, add_neg_cancel, zpow_zero, one_mul]
  have hcoeffπ : (D₀'.coeff CN : ℤ) = Nc * e := by
    rw [hcCN, hf₁eq, map_mul, map_zpow₀,
      Scheme.ord_mul (zpow_ne_zero _ ((map_ne_zero _).2 hsK0)) ((map_ne_zero _).2 hw0),
      ord_zpow _ ((map_ne_zero _).2 hsK0), hordw, add_zero]
  have hcZ' : D₀.coeff Z₀ = Nc := by first | exact hcZ | exact hcZ.trans hNc.symm
  have hD₀Z : (Nc : ℚ) = (HZ.cartierIndex hqZ : ℚ) * HZ.coeff Z₀ := by
    have h := congrArg (fun F : QDivisor TZ => F.coeff Z₀) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] at h
    rw [← hcZ']; exact_mod_cast h
  have hD₀CN : ((D₀'.coeff CN : ℤ) : ℚ) = (HZ.cartierIndex hqZ : ℚ) * H.coeff CN := by
    have h := congrArg (fun F : QDivisor N => F.coeff CN) hD₀'
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] at h
    rw [hHeq]; exact_mod_cast h
  have hm₀q : (0 : ℚ) < (HZ.cartierIndex hqZ : ℚ) := by exact_mod_cast hm₀
  have hkey : (HZ.cartierIndex hqZ : ℚ) * (((Γ.ordForm θs : ℤ) : ℚ) + 1 -
        ((BZ.coeff Z₀ : ℚ) - 1) * e) = 0 := by
    have h1 : ((D₀'.coeff CN : ℤ) : ℚ) = (Nc : ℚ) * e := by exact_mod_cast hcoeffπ
    rw [hD₀CN, hcoeffCN, hD₀Z, hHZ₀] at h1
    linear_combination h1
  have hkey' : ((Γ.ordForm θs : ℤ) : ℚ) + 1 =
        ((BZ.coeff Z₀ : ℚ) - 1) * e := by
    have := (mul_eq_zero.1 hkey).resolve_left hm₀q.ne'
    linarith
  exact ⟨hρs0, e, he1, hkey'⟩

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
residue `θ_s` has a simple pole along `Γ`, where `θ_s = dlog t ∧ dlog u` with `t` a
uniformizer and `u` a unit, and `B_Z` has coefficient one at `z₀`. -/
private theorem ordForm_eq_neg_one_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0})
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    [IsIntegral G] [IsClosedImmersion j] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX)
      (D : DivisorOver ℂ sX),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (_ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : IsUnit v)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens)
          (_ : MMP.Intersection.IsDltPair (ιZ ≫ sX) BZ)
          (Γ : Mori.PrimeDivisor (CY Q))
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1)
          (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing)
          (_ : ∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1)
          (_ : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1)
          (_ : IsClosed ({Z₀.genericPoint} : Set TZ))
          (_ : Irreducible s)
          (_ : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s})
          (_ : letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint))))
          (_ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX))
          (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
          (U'' : X.Opens),
          let sK : TZ.functionField := algebraMap Z₀.localRing TZ.functionField s
          let vb : TZ.functionField := resZ v
          let Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 +
              1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)
          let τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) :=
            algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • Ωv
          let ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)]
          let ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)]
          let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
          ∀ (_ : k' ≠ 0)
            (_ : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
              k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb))
            (_ : resZ hh = k')
            (_ : IsUnit hh)
            (_ : D.f D.E.genericPoint ∈ U'')
            (_ : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0)
            (_ : ωs = lam k' • ωv)
            (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
                θs)
            (_ : θs ≠ 0)
            (e : ℤ)
            (_ : 1 ≤ e)
            (_ : ((Γ.ordForm θs : ℤ) : ℚ) + 1 = ((BZ.coeff Z₀ : ℚ) - 1) * e),
          Γ.ordForm θs = -1 ∧ BZ.coeff Z₀ = 1 ∧
            (letI := stalkAlgebra (jY Q ≫ sY) Γ.genericPoint
            ∃ tΓ u : Γ.localRing, Irreducible tΓ ∧ IsUnit u ∧
            (ωs = exteriorPower.ιMulti (CY Q).functionField 2
              ![(algebraMap Γ.localRing (CY Q).functionField tΓ)⁻¹ • KaehlerDifferential.D ℂ _
                  (algebraMap Γ.localRing (CY Q).functionField tΓ),
                (algebraMap Γ.localRing (CY Q).functionField u)⁻¹ • KaehlerDifferential.D ℂ _
                    (algebraMap Γ.localRing (CY Q).functionField u)]) ∧
            (∀ x : Γ.localRing, IsUnit x → ∃ p q : Polynomial ℂ, q ≠ 0 ∧
                x * (Polynomial.aeval u).toRingHom q - (Polynomial.aeval u).toRingHom p ∈
                  IsLocalRing.maximalIdeal Γ.localRing)) := by
  intro σ D P TZ ι₂ BZ ιZ FZ z v g resZ lam eb hlamk hgentr hvu hτ'0 U hdltZ Γ c₁ hc₁0 hc₁ Z₀ s
    hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k' hh U'' sK vb Ωv τs ωv ωs θs hk'0 hdlogs hhh hhu
    hxU'' hU' hωsv hρs hρs0 e he1 hkey'
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  -- the centre `z₀` of `μ ∘ λ` on `T_Z`, a closed point
  set ν : Valuation TZ.functionField ℤᵐ⁰ := μ.comap lam with hν
  haveI := Z₀.isDiscreteValuationRing_localRing
  letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint
  haveI := isScalarTower_stalk_functionField (ιZ ≫ sX) Z₀.genericPoint
  have hreg : IsRegularSystemOfParameters (![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) := by
    refine ⟨by rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]; exact hs_span.symm, ?_⟩
    rw [ringKrullDim_stalk_eq_coheight, Z₀.coheight_genericPoint]; rfl
  haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hreg
  have hsK : sK = algebraMap _ TZ.functionField s := rfl
  have hvb : vb = resZ v := rfl
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  have hsK0 : sK ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hs.ne_zero
  have hhK0 : algebraMap _ X.functionField hh ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hhu.ne_zero
  have hτs : τs = algebraMap _ X.functionField hh • Ωv := rfl
  have hτs0 : τs ≠ 0 := smul_ne_zero hhK0 hτ'0
  have hθs : θs = formPow ωs 1 := rfl
  have hsm : s ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) := by
    rw [hs_span]; exact Ideal.mem_span_singleton_self s
  have he' : (1 : ℚ) ≤ e := by exact_mod_cast he1
  have hBZle : (BZ.coeff Z₀ : ℚ) ≤ 1 := hdltZ.2.1 Z₀
  have hle1 : Γ.ordForm θs ≤ -1 := by
    have : ((Γ.ordForm θs : ℤ) : ℚ) ≤ -1 := by
      have h0 : ((BZ.coeff Z₀ : ℚ) - 1) * e ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg (by linarith only [hBZle]) (by linarith only [he'])
      linarith only [hkey', h0]
    exact_mod_cast this
  -- `θ_s = dlog t ∧ dlog u` with `t` a uniformizer and `u` a unit along `Γ`
  obtain ⟨tΓ, u, ht, hu, hωtu, hresu⟩ := CrepantModelAux.exists_irreducible_isUnit_dlog_eq_of_center
    (sX := jY Q ≫ sY) hdT Γ (sZ := ιZ ≫ sX) Z₀.genericPoint hz₀cl s hs.ne_zero hs_span lam hlamk
    eb (fun h0 => htr (h0 ▸ isAlgebraic_zero)) hgen' (fun c => hz₀le c) (hz₀lt s hsm)
    (lt_of_le_of_lt hle1 (by norm_num))
  set tA : (CY Q).functionField := algebraMap Γ.localRing (CY Q).functionField tΓ with htA
  set au : (CY Q).functionField := algebraMap Γ.localRing (CY Q).functionField u with hau
  have hat0 : tA ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 ht.ne_zero
  have hau0 : au ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hu.ne_zero
  haveI := Γ.isDiscreteValuationRing_localRing
  have hordt : (CY Q).ord tA Γ.genericPoint = 1 :=
    (Scheme.ord_eq_iff Γ.coheight_genericPoint hat0).mpr (Ring.ordFrac_irreducible ht)
  have hordu : (CY Q).ord au Γ.genericPoint = 0 := Γ.ord_algebraMap_of_isUnit hu
  have hsplit := CrepantModelAux.formPow_ιMulti_dlog_eq_smul (k := ℂ) (K := (CY Q).functionField)
    (d := 2) ![tA, au] 1
  have hvecfun : (fun i => ((![tA, au] : Fin 2 → (CY Q).functionField) i)⁻¹ •
      KaehlerDifferential.D ℂ (CY Q).functionField ((![tA, au] : Fin 2 → (CY Q).functionField) i)) =
      ![tA⁻¹ • KaehlerDifferential.D ℂ _ tA, au⁻¹ • KaehlerDifferential.D ℂ _ au] := by
    funext i; fin_cases i <;> rfl
  rw [hvecfun, ← hωtu] at hsplit
  have hreg0 := CrepantModelAux.zero_le_ordForm_formPow_ιMulti_D (sX := jY Q ≫ sY) Γ hdT 1 ![tΓ, u]
  have hfunD : (fun i => KaehlerDifferential.D ℂ (CY Q).functionField
      (algebraMap Γ.localRing (CY Q).functionField ((![tΓ, u] : Fin 2 → Γ.localRing) i))) =
      fun i => KaehlerDifferential.D ℂ (CY Q).functionField
        ((![tA, au] : Fin 2 → (CY Q).functionField) i) := by
    funext i; fin_cases i <;> rfl
  rw [hfunD] at hreg0
  let δD : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) :=
    formPow (exteriorPower.ιMulti (CY Q).functionField 2 fun i =>
      KaehlerDifferential.D ℂ (CY Q).functionField ((![tA, au] : Fin 2 → (CY Q).functionField) i))
        1
  have hδD : δD = 
    formPow (exteriorPower.ιMulti (CY Q).functionField 2 fun i =>
      KaehlerDifferential.D ℂ (CY Q).functionField ((![tA, au] : Fin 2 → (CY Q).functionField) i))
        1 := rfl
  have hsplit' : θs = ((∏ i, (![tA, au] : Fin 2 → (CY Q).functionField) i)⁻¹) ^ 1 • δD := hsplit
  have hD0 : δD ≠ 0 := by
    intro h0; apply hρs0; rw [hsplit', h0, smul_zero]
  have hprod0 : ((∏ i, (![tA, au] : Fin 2 → (CY Q).functionField) i)⁻¹) ^ 1 ≠ 0 := by
    rw [Fin.prod_univ_two]
    exact pow_ne_zero _ (inv_ne_zero (mul_ne_zero hat0 hau0))
  have hge : -1 ≤ Γ.ordForm θs := by
    rw [hsplit', Γ.ordForm_smul_of_topologicalKrullDim_eq hdT hprod0 hD0, Fin.prod_univ_two,
      pow_one, ← zpow_neg_one]
    have e0 : (![tA, au] : Fin 2 → (CY Q).functionField) 0 *
        (![tA, au] : Fin 2 → (CY Q).functionField) 1 = tA * au := rfl
    rw [e0, ord_zpow _ (mul_ne_zero hat0 hau0), Scheme.ord_mul hat0 hau0, hordt, hordu]
    have h0 : 0 ≤ Γ.ordForm δD := hreg0
    omega
  have hordΓ : Γ.ordForm θs = -1 :=
    le_antisymm hle1 hge
  have hBZ1 : BZ.coeff Z₀ = 1 := by
    rw [hordΓ] at hkey'
    have h0 : ((BZ.coeff Z₀ : ℚ) - 1) * e = 0 := by push_cast at hkey'; linarith only [hkey']
    have := (mul_eq_zero.1 h0).resolve_right (by linarith only [he'])
    linarith only [this]
  exact ⟨hordΓ, hBZ1, tΓ, u, ht, hu, hωtu, hresu⟩

open scoped WithZero in
open exteriorPower in
/-- In the vertical case of `isCopyAlong_or_isDlogCurve_step_of_isExceptionalOverCurve`, the
residue `dlog ū` of `θ_s` along `G` satisfies `div(dlog ū) + B_G = 0`, and `ū` generates
`k(G)`. -/
private theorem exists_dlog_curve_of_isExceptionalOverCurve_of_vertical
    [CompactSpace X] [LocallyOfFiniteType sX]
    (St : Setting sX sY 2 B C KX KY p q BW m CX jX BX CY jY BY)
    (R' : ResidueRestriction (fun Q => jY Q ≫ sY) BY 2 m)
    (Q : {Q : Mori.PrimeDivisor Y // ⌊C.coeff Q⌋ ≠ 0}) (hcurveQ : IsExceptionalOverCurve St Q)
    {G : Scheme.{0}} {j : G ⟶ CY Q} {BG : QDivisor G}
    (hj : IsAdjunctionStep (𝟙 (CY Q) ≫ jY Q ≫ sY) (BY Q) j BG)
    (hG : topologicalKrullDim G = (1 : ℕ)) [IsIntegral G] [IsClosedImmersion j] [IsNormal G]
        [IsLocallyNoetherian G] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (jY Q ≫ sY)
    ∀ (σ : FunctionFieldEquiv sY sX) (_ : IsCrepantBirationalMap sY sX C B σ)
      (D : DivisorOver ℂ sX)
      (_ : ∀ g, D.valuation g = Q.1.divisorialValuation ((σ.toHom) g))
      (_ : MMP.Mori.IsDiscrepancy sX (2 + 1) KX B D (-1)),
      letI := stalkAlgebra sX (D.f D.E.genericPoint)
      ∀ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (TZ : Scheme.{0}) (ι₂ : TZ ⟶ CX P)
        (BZ : QDivisor TZ) (_ : IsAdjunctionStep (jX P ≫ sX) (BX P) ι₂ BZ) (ιZ : TZ ⟶ X)
        (FZ : StratumAdjunctionData sX B ιZ BZ),
        haveI := FZ.isIntegral_stratum
        haveI := FZ.isNormal_stratum
        haveI := FZ.isLocallyNoetherian_stratum
        haveI := FZ.isClosedImmersion
        haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
        haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (ιZ ≫ sX)
        ∀
          (_ : ιZ (genericPoint TZ) = D.f D.E.genericPoint)
          (z : Fin 2 → X.presheaf.stalk (D.f D.E.genericPoint)) (v _ : X.presheaf.stalk (D.f
              D.E.genericPoint))
          (resZ : X.presheaf.stalk (D.f D.E.genericPoint) →+* TZ.functionField)
          (lam : TZ.functionField →+* (CY Q).functionField) (eb : (CY Q).functionField)
          (_ : Function.Surjective resZ)
          (_ : ∀ (h : D.f D.E.genericPoint ⤳ ιZ (genericPoint TZ))
            (a : X.presheaf.stalk (ιZ (genericPoint TZ))),
            resZ ((X.presheaf.stalkSpecializes h).hom a) = (ιZ.stalkMap (genericPoint TZ)).hom a)
          (_ : ∀ c : ℂ, lam (algebraMap ℂ _ c) = algebraMap ℂ _ c)
          (_ : letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra;
            IntermediateField.adjoin TZ.functionField {eb} = ⊤ ∧ Transcendental TZ.functionField eb)
          (_ : ∀ (r : X.presheaf.stalk (D.f D.E.genericPoint))
            (gT : Y.presheaf.stalk (jY Q (genericPoint (CY Q)))),
            algebraMap _ Y.functionField gT = (σ.toHom) (algebraMap _ X.functionField r) →
            ((jY Q).stalkMap (genericPoint (CY Q))).hom gT = lam (resZ r))
          (_ : IsUnit v)
          (_ : (show RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) from formPow
              (exteriorPower.ιMulti
            X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1) ≠ 0)
          (U : X.Opens) (_ : D.f D.E.genericPoint ∈ U)
          (_ : ∀ g₀ : X.presheaf.stalk (D.f D.E.genericPoint), IsUnit g₀ →
            ∃ hgen, (Divisor.toQDivisor (divisorOfForm
              (show RationalPluriForms sX 3 ((1 : ℕ) : ℤ) from
                algebraMap _ X.functionField g₀ • formPow (exteriorPower.ιMulti X.functionField 3
                  fun a => (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                    (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                      (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                        (![z 0, z 1, v] a))) 1)) + B).IsPullback ιZ hgen
              (Divisor.toQDivisor (divisorOfForm
                (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ) : ℤ) from resZ g₀ •
                  formPow (exteriorPower.ιMulti TZ.functionField 1
                    fun _ => (resZ v)⁻¹ • KaehlerDifferential.D ℂ TZ.functionField (resZ v)) 1)) +
                BZ))
          (Γ : Mori.PrimeDivisor (CY Q)) (_ : j (genericPoint G) = Γ.genericPoint)
          (c₁ : TZ.functionField) (_ : c₁ ≠ 0) (_ : Γ.divisorialValuation (lam c₁) ≠ 1)
          (Z₀ : Mori.PrimeDivisor TZ) (s : Z₀.localRing)
          (_ : ∀ a : TZ.presheaf.stalk Z₀.genericPoint,
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) ≤ 1)
          (_ : ∀ a ∈ IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint),
              (Γ.divisorialValuation.comap lam) (algebraMap _ TZ.functionField a) < 1)
          (_ : IsClosed ({Z₀.genericPoint} : Set TZ))
          (_ : Irreducible s)
          (_ : IsLocalRing.maximalIdeal (TZ.presheaf.stalk Z₀.genericPoint) = Ideal.span {s})
          (_ : letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint;
              Function.Surjective
                (algebraMap ℂ (IsLocalRing.ResidueField (TZ.presheaf.stalk Z₀.genericPoint))))
          (_ : Z₀.genericPoint ∈ Mori.smoothLocus (ιZ ≫ sX))
          (k' : TZ.functionField) (hh : X.presheaf.stalk (D.f D.E.genericPoint))
          (U'' : X.Opens),
          let sK : TZ.functionField := algebraMap Z₀.localRing TZ.functionField s
          let vb : TZ.functionField := resZ v
          let Ωv : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) := (show RationalPluriForms sX (2 +
              1) ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti X.functionField 3 fun a =>
              (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                (![z 0, z 1, v] a))⁻¹ • KaehlerDifferential.D ℂ X.functionField
                (algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField
                  (![z 0, z 1, v] a))) 1)
          let τs : RationalPluriForms sX (2 + 1) ((1 : ℕ) : ℤ) :=
            algebraMap (X.presheaf.stalk (D.f D.E.genericPoint)) X.functionField hh • Ωv
          let ωv : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam vb)⁻¹ • KaehlerDifferential.D ℂ _ (lam vb)]
          let ωs : ⋀[(CY Q).functionField]^2 Ω[(CY Q).functionField⁄ℂ] := exteriorPower.ιMulti (CY
              Q).functionField 2
              ![eb⁻¹ • KaehlerDifferential.D ℂ _ eb,
                (lam sK)⁻¹ • KaehlerDifferential.D ℂ _ (lam sK)]
          let θs : RationalPluriForms (jY Q ≫ sY) 2 ((1 : ℕ) : ℤ) := formPow ωs 1
          ∀ (_ : k' ≠ 0)
            (_ : sK⁻¹ • KaehlerDifferential.D ℂ TZ.functionField sK =
              k' • (vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb))
            (_ : resZ hh = k')
            (_ : IsUnit hh)
            (_ : D.f D.E.genericPoint ∈ U'')
            (_ : ∀ E : Mori.PrimeDivisor X, (E.support ∩ ((U ⊓ U'' : X.Opens) : Set X)).Nonempty →
              (Divisor.toQDivisor (divisorOfForm τs) + B).coeff E = 0)
            (_ : ωs = lam k' • ωv)
            (_ : IsPoincareResidue sY (jY Q) 2 1 (pluriformPullback sY sX σ.toHom (2 + 1) 1 τs)
                θs)
            (_ : Γ.ordForm θs = -1)
            (_ : BZ.coeff Z₀ = 1)
            (_ : (Divisor.toQDivisor (divisorOfForm (show RationalPluriForms (ιZ ≫ sX) 1 ((1 : ℕ)
                : ℤ) from
              resZ hh • formPow (exteriorPower.ιMulti TZ.functionField 1
                fun _ => vb⁻¹ • KaehlerDifferential.D ℂ TZ.functionField vb) 1)) + BZ).coeff Z₀ =
                    (BZ.coeff Z₀ : ℚ) - 1)
            (tΓ : Γ.localRing)
            (u : Γ.localRing)
            (_ : Irreducible tΓ)
            (_ : IsUnit u)
            (_ : ωs = exteriorPower.ιMulti (CY Q).functionField 2
              ![(algebraMap Γ.localRing (CY Q).functionField tΓ)⁻¹ • KaehlerDifferential.D ℂ _
                  (algebraMap Γ.localRing (CY Q).functionField tΓ),
                (algebraMap Γ.localRing (CY Q).functionField u)⁻¹ • KaehlerDifferential.D ℂ _
                    (algebraMap Γ.localRing (CY Q).functionField u)])
            (_ : letI := stalkAlgebra (jY Q ≫ sY) Γ.genericPoint;
              ∀ x : Γ.localRing, IsUnit x → ∃ p q : Polynomial ℂ, q ≠ 0 ∧
                x * (Polynomial.aeval u).toRingHom q - (Polynomial.aeval u).toRingHom p ∈
                  IsLocalRing.maximalIdeal Γ.localRing),
          ∃ tG u' : (CY Q).presheaf.stalk (j (genericPoint G)), (algebraMap _ (CY Q).functionField
              tG = algebraMap Γ.localRing (CY Q).functionField tΓ) ∧
            (algebraMap _ (CY Q).functionField u' = algebraMap Γ.localRing (CY Q).functionField u) ∧
            (letI := functionFieldAlgebra (j ≫ jY Q ≫ sY);
              ∀ E : Mori.PrimeDivisor G, (E.ordForm (show RationalPluriForms (j ≫ jY Q ≫ sY) 1
                ((1 : ℕ) : ℤ) from formPow (exteriorPower.ιMulti G.functionField 1
                  ![((j.stalkMap (genericPoint G)).hom u')⁻¹ • KaehlerDifferential.D ℂ _
                    ((j.stalkMap (genericPoint G)).hom u')]) 1) : ℚ) + BG.coeff E = 0) ∧
            (letI := functionFieldAlgebra (j ≫ jY Q ≫ sY);
              IntermediateField.adjoin ℂ ({(j.stalkMap (genericPoint G)).hom u'} :
                Set G.functionField) = ⊤) := by
  intro σ hσc D hv ha P TZ ι₂ BZ h₂ ιZ FZ hgenZ z v g resZ lam eb hresZs hstalkZ hlamk hgentr
    hresid hvu hτ'0 U hxU hpbZu Γ hΓ c₁ hc₁0 hc₁ Z₀ s hz₀le hz₀lt hz₀cl hs hs_span hres₀ hsm₀ k'
    hh U'' sK vb Ωv τs ωv ωs θs hk'0 hdlogs hhh hhu hxU'' hU' hωsv hρs hordΓ hBZ1 hHZ₀ tΓ u ht hu
    hωtu hresu
  obtain ⟨hgen', htr⟩ := hgentr
  classical
  haveI := St.hXp.toIsVariety
  haveI := St.hYp.toLocallyOfFiniteType
  haveI := St.hYp.toIsVariety
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ St.hXp.isProjective
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ St.hYp.isProjective
  have hXn : IsNormalVariety ℂ sX := St.hBp.isPair.1
  have hYn : IsNormalVariety ℂ sY := St.hCp.isPair.1
  obtain ⟨Q₀, hQ₀, hciQ⟩ := (St.hjY Q).1.exists_primeDivisor
  haveI := hciQ
  haveI : CompactSpace (CY Q) := QuasiCompact.compactSpace_of_compactSpace (jY Q ≫ sY)
  have hT : IsNormalVariety ℂ (jY Q ≫ sY) := (St.hjY Q).1.1
  haveI : LocallyOfFiniteType (jY Q ≫ sY) := hT.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim (CY Q) = (2 : ℕ) :=
    CrepantModelAux.topologicalKrullDim_eq_of_range_eq_support sY (jY Q) Q.1 (St.hjY Q).2
      St.hdimY
  have hP : jY Q (genericPoint (CY Q)) = Q.1.genericPoint :=
    CrepantModelAux.map_genericPoint_eq_of_range_eq (jY Q) Q.1 (St.hjY Q).2
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (jY Q ≫ sY)
  haveI := FZ.isIntegral_stratum
  haveI := FZ.isNormal_stratum
  haveI := FZ.isLocallyNoetherian_stratum
  haveI := FZ.isClosedImmersion
  haveI : CompactSpace TZ := QuasiCompact.compactSpace_of_compactSpace ιZ
  haveI : LocallyOfFiniteType (ιZ ≫ sX) := FZ.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ιZ ≫ sX)
  letI : Algebra TZ.functionField (CY Q).functionField := lam.toAlgebra
  haveI : IsScalarTower ℂ TZ.functionField (CY Q).functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (hlamk c).symm
  have hj' : IsAdjunctionStep (jY Q ≫ sY) (BY Q) j BG := by rwa [Category.id_comp] at hj
  set μ := Γ.divisorialValuation with hμ
  -- the centre `z₀` of `μ ∘ λ` on `T_Z`, a closed point
  set ν : Valuation TZ.functionField ℤᵐ⁰ := μ.comap lam with hν
  haveI := Z₀.isDiscreteValuationRing_localRing
  letI := stalkAlgebra (ιZ ≫ sX) Z₀.genericPoint
  haveI := isScalarTower_stalk_functionField (ιZ ≫ sX) Z₀.genericPoint
  have hreg : IsRegularSystemOfParameters (![s] : Fin 1 → TZ.presheaf.stalk Z₀.genericPoint) := by
    refine ⟨by rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]; exact hs_span.symm, ?_⟩
    rw [ringKrullDim_stalk_eq_coheight, Z₀.coheight_genericPoint]; rfl
  haveI := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hreg
  have hsK : sK = algebraMap _ TZ.functionField s := rfl
  have hvb : vb = resZ v := rfl
  have hvb0 : vb ≠ 0 := (hvu.map resZ).ne_zero
  have hsK0 : sK ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hs.ne_zero
  have hhK0 : algebraMap _ X.functionField hh ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hhu.ne_zero
  have hτs : τs = algebraMap _ X.functionField hh • Ωv := rfl
  have hτs0 : τs ≠ 0 := smul_ne_zero hhK0 hτ'0
  have hθs : θs = formPow ωs 1 := rfl
  -- the normalized strict transform `N` of `Q` and the factorization through `T_Z`
  obtain ⟨-, -, -, -, -, -, -, -, hC1, -⟩ := hcurveQ
  have hKBY : (Divisor.toQDivisor KY + C).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmY
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  have hKBX : (Divisor.toQDivisor KX + B).IsQCartier := by
    obtain ⟨D', hD', hD'c⟩ := St.hmX
    exact ⟨m, by exact_mod_cast St.hm0.ne', D', hD', hD'c⟩
  haveI : IsNoetherian (CY Q) := {}
  haveI : IsNoetherian X := {}
  obtain ⟨W, N, _, _, _, _, _, pW, qW, νN, αN, _, _, _, _, hN₁⟩ :=
    CrepantModelAux.exists_normalization_isPullback_of_isAdjunctionStep hYn hXn St.hdimY St.hdimX
      St.hKY St.hKX hKBY hKBX σ hσc (St.hjY Q).1 Q.1 (St.hjY Q).2 hC1 D hv hτs0 (U ⊓ U'')
      ⟨hxU, hxU''⟩ hU' hρs
  obtain ⟨hαb, hNα, hα, hcompat, hqν, hpν, hρs0, hqT, hN₂⟩ := hN₁
  obtain ⟨H, hgen₁, hgen₂, hH₁, hH₂⟩ := hN₂
  haveI : QuasiCompact (νN ≫ qW) := quasiCompact_of_compactSpace _
  have hrange : Set.range (νN ≫ qW).base ⊆ Set.range ιZ.base := by
    rintro _ ⟨n, rfl⟩
    have h0 : genericPoint N ⤳ n := (genericPoint_spec N).specializes trivial
    have h1 : D.f D.E.genericPoint ⤳ (νN ≫ qW) n := by
