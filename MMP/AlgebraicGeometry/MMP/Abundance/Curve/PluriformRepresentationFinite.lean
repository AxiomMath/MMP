open CategoryTheory AlgebraicGeometry MMP MMP.Fourfold MMP.Mori
open Topology TopologicalSpace Opposite

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

section Semiample

variable {k : Type u} [Field k] [IsAlgClosed k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

private theorem isIso_ι_of_eq_top {X : Scheme.{u}} {U : X.Opens} (hU : U = ⊤) : IsIso U.ι := by
  subst hU; rw [← Scheme.topIso_hom]; infer_instance

private theorem isCurve_and_smooth_and_isIso_globalSections
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) :
    AlgebraicGeometry.IsCurve k sX ∧ Smooth sX ∧
      IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop) := by
  have : Smooth sX := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  have hc : AlgebraicGeometry.IsCurve k sX := (AlgebraicGeometry.isCurve_iff k sX).2 ⟨hvar.1, hdim⟩
  exact ⟨hc, this, GenusOne.isIso_globalSections_of_isAlgClosed _⟩

private theorem genus_eq_h0_canonical (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 1) :
    genus sX = K.h0 k sX := by
  rw [MMP.Flips.h0_canonical_eq_genus hvar hsm hprop hK]
  have : IsIso (smoothLocus sX).ι := isIso_ι_of_eq_top hsm
  have hs : Spec.map (CommRingCat.ofHom (algebraMap k k)) = 𝟙 (Spec (.of k)) := by simp
  refine (genus_baseChange k k (smoothLocus sX).ι _ sX ?_).symm
  rw [hs]
  exact IsPullback.of_horiz_isIso ⟨by simp⟩

private theorem invertibleCurveDegree_divisorialSheaf_eq_sum
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) (D : Divisor X) :
    haveI := QuasiCompact.compactSpace_of_compactSpace sX
    haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
    invertibleCurveDegree k sX hdim.le D.divisorialSheaf = D.sum fun _ a => a := by
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
  have : IsIso (smoothLocus sX).ι := isIso_ι_of_eq_top hsm
  have hdU : topologicalKrullDim (smoothLocus sX).toScheme ≤ 1 := by
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (Scheme.homeoOfIso (asIso (smoothLocus sX).ι)).isHomeomorph, hdim]
  have h1 := MMP.Flips.degreeOn_smoothLocus_eq_sum hvar hsm hprop hdim hdU D
  rw [← h1]
  change _ = invertibleCurveDegree k ((smoothLocus sX).ι ≫ sX) hdU
    ((Scheme.Modules.pullback (smoothLocus sX).ι).obj D.divisorialSheaf)
  rw [invertibleCurveDegree_pullback_of_isIso (smoothLocus sX).ι sX hdU hdim.le]

private theorem isGeneratedByGlobalSections_of_two_mul_h0_le
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX 1) (D : Divisor X)
    (hD : 2 * (K.h0 k sX : ℤ) ≤ D.sum fun _ a => a) :
    SheafOfModules.IsGeneratedByGlobalSections D.divisorialSheaf := by
  obtain ⟨hc, hs, hiso⟩ := isCurve_and_smooth_and_isIso_globalSections hvar hsm hprop hdim
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
  let S : CohenMacaulayCurveSituation.{u} :=
    { k := k, X := X, f := sX, dimension_one := hdim }
  exact S.isGeneratedByGlobalSections_of_two_mul_genus_le (L := D.divisorialSheaf) (by
    change 2 * (genus sX : ℤ) ≤ invertibleCurveDegree k sX hdim.le D.divisorialSheaf
    rw [invertibleCurveDegree_divisorialSheaf_eq_sum hvar hsm hprop hdim D,
      genus_eq_h0_canonical hvar hsm hprop hK]
    exact hD)

private theorem isGeneratedByGlobalSections_of_sum_eq_zero_of_section
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) (D : Divisor X)
    (hD : (D.sum fun _ a => a) = 0)
    (s : D.divisorialSheaf.sections) (hs : s.eval (Opposite.op ⊤) ≠ 0) :
    SheafOfModules.IsGeneratedByGlobalSections D.divisorialSheaf := by
  obtain ⟨hc, hs', hiso⟩ := isCurve_and_smooth_and_isIso_globalSections hvar hsm hprop hdim
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := isTrivial_of_invertibleCurveDegree_nonpos (k := k) (f := sX) hdim.le
    D.divisorialSheaf s hs
    (by rw [invertibleCurveDegree_divisorialSheaf_eq_sum hvar hsm hprop hdim D, hD])
  exact Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso e.symm
      ⟨Stacks.AlgebraicGeometry.CoherenceCriteria.unitGeneratingSections⟩

private theorem isGeneratedByGlobalSections_of_sum_eq_zero_of_h0_eq_zero
    (hvar : Mori.IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX 1) (hg : K.h0 k sX = 0) (D : Divisor X)
    (hD : (D.sum fun _ a => a) = 0) :
    SheafOfModules.IsGeneratedByGlobalSections D.divisorialSheaf := by
  obtain ⟨hc, hs', hiso⟩ := isCurve_and_smooth_and_isIso_globalSections hvar hsm hprop hdim
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := isTrivial_of_genus_eq_zero_of_invertibleCurveDegree_eq_zero (k := k) (f := sX)
    D.divisorialSheaf (by rw [genus_eq_h0_canonical hvar hsm hprop hK, hg])
    (by rw [invertibleCurveDegree_divisorialSheaf_eq_sum hvar hsm hprop hdim D, hD])
  exact Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso e.symm
      ⟨Stacks.AlgebraicGeometry.CoherenceCriteria.unitGeneratingSections⟩

private theorem isGeneratedByGlobalSections_of_sum_eq_zero_of_h0_pos
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) (D : Divisor X)
    (hD : (D.sum fun _ a => a) = 0) (h0 : 0 < D.h0 k sX) :
    SheafOfModules.IsGeneratedByGlobalSections D.divisorialSheaf := by
  letI : Module k (D.divisorialSubmodule ⊤) := Module.compHom _ (scalarsToGlobalSections k sX)
  have : Nontrivial (D.divisorialSubmodule ⊤) := Module.nontrivial_of_finrank_pos h0
  obtain ⟨φ, hφ⟩ := exists_ne (0 : D.divisorialSubmodule ⊤)
  exact isGeneratedByGlobalSections_of_sum_eq_zero_of_section hvar hsm hprop hdim D hD
    (sectionOfGlobalValue D.divisorialSheaf φ)
    (by
      have h := sectionOfGlobalValue_eval_top D.divisorialSheaf φ
      intro h'
      exact hφ (h.symm.trans h'))

private theorem isLocalEquationAt_zero_one (Z : Scheme.{u}) (x : Z) :
    MMP.Intersection.IsLocalEquationAt (0 : Z.CartierDivisor) x 1 :=
  ⟨⊤, trivial, 1, MMP.Intersection.isLocalEquationOn_one _, by simp⟩

/-- The zero Cartier divisor pulls back to the zero Cartier divisor along any morphism. -/
public theorem _root_.MMP.Intersection.isPullback_zero {X Y : Scheme.{u}} (g : Y ⟶ X) :
    MMP.Intersection.IsPullback g (0 : X.CartierDivisor) 0 := by
  open MMP.Intersection in
  refine ⟨fun η _ => ?_, fun y => ⟨1, 1,
    ⟨1, isLocalEquationAt_zero_one _ _, isFraction_one_one_one _⟩,
    ?_, ?_, 1, isLocalEquationAt_zero_one _ _, ?_⟩⟩
  · simp [MMP.Intersection.cartierSupport]
  · simp
  · simp
  · simpa only [map_one] using MMP.Intersection.isFraction_one_one_one y

/-- On a proper normal variety over `k`, a Cartier divisor whose sheaf is generated by its
global sections is relatively free over `Spec k`. -/
public theorem isRelativelyFreeCartier_of_isGeneratedByGlobalSections
    (hvar : Mori.IsNormalVariety k sX) (hprop : IsProper sX) (E : X.CartierDivisor)
    (hgg : SheafOfModules.IsGeneratedByGlobalSections.{u, u, u}
      (MMP.CartierDivisor.sheaf E)) :
    IsRelativelyFreeCartier sX E := by
  have : AlgebraicGeometry.IsVariety k sX := hvar.1
  have : AlgebraicGeometry.IsVariety k (𝟙 (Spec (.of k))) := ⟨⟩
  exact MMP.Mori.isRelativelyFreeCartier_of_isGeneratedByGlobalSections_add_pullback
    (sY := 𝟙 (Spec (.of k))) (f := sX) (Category.comp_id sX) E (B := 0) (B' := 0)
    (MMP.Intersection.isPullback_zero sX) (by rwa [add_zero])

private theorem exists_isWeilDivisorOfCartier (hsm : IsSmoothScheme sX) (D : Divisor X) :
    ∃ E : X.CartierDivisor, MMP.Intersection.IsWeilDivisorOfCartier E D :=
  (MMP.Resolution.Bridges.uniqueFactorization_and_exists_isWeilDivisorOfCartier).2 X
    (MMP.Threefold.Resolution.isRegular_of_isSmoothScheme hsm) D

private theorem realization_congr {c c' : KCartierDivisor ℚ X}
    (e : c = c') (h : ∀ D, ∃ n : ℤ, c D = n)
    (h' : ∀ D, ∃ n : ℤ, c' D = n) :
    KCartierDivisor.realization c h = KCartierDivisor.realization c' h' := by
  subst e; rfl

/-- If `n • Q` is the Weil divisor of a Cartier divisor `E` (`n > 0`) and `E` is relatively free
over `Z`, then `Q` is relatively semiample over `Z`. -/
private theorem QDivisor.isRelativelySemiample_of_isRelativelyFreeCartier
    (Q : QDivisor X) (n : ℕ) (hn : 0 < n) (D' : Divisor X)
    (hQ : ∀ P, (D'.coeff P : ℚ) = n * Q.coeff P) (E : X.CartierDivisor)
    (hE : MMP.Intersection.IsWeilDivisorOfCartier E D') (hfree : IsRelativelyFreeCartier sX E) :
    QDivisor.IsRelativelySemiample sX Q := by
  classical
  have hn' : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  refine ⟨Finsupp.single E ((n : ℚ)⁻¹), fun P => ?_, n, hn, ?_⟩
  · rw [Finsupp.sum_single_index (by simp),
      (MMP.Intersection.isOrderAlong_primeDivisorOrder E P).unique (hE P), hQ P]
    field_simp
  · have hc : (n : ℚ) • Finsupp.single E ((n : ℚ)⁻¹) =
        (Finsupp.single E (1 : ℤ)).mapRange (Int.cast : ℤ → ℚ) Int.cast_zero := by
      rw [Finsupp.smul_single, Finsupp.mapRange_single, smul_eq_mul, mul_inv_cancel₀ hn',
        Int.cast_one]
    refine ⟨fun D => ⟨(Finsupp.single E (1 : ℤ)) D, by rw [hc]; rfl⟩, ?_⟩
    rw [realization_congr hc _ (fun D => ⟨(Finsupp.single E (1 : ℤ)) D, rfl⟩),
      KCartierDivisor.realization_eq_sum, Finsupp.sum_single_index (by simp), one_smul]
    exact hfree

/-- On a smooth proper normal variety over `k`, a `ℚ`-divisor `Q` is semiample over `Spec k` as
soon as some positive multiple `n • Q` is a Weil divisor whose divisorial sheaf is generated by
its global sections. -/
public theorem QDivisor.isRelativelySemiample_of_isGeneratedByGlobalSections
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hprop : IsProper sX)
    (Q : QDivisor X) (n : ℕ) (hn : 0 < n) (D' : Divisor X)
    (hQ : ∀ P, (D'.coeff P : ℚ) = n * Q.coeff P)
    (hgg : SheafOfModules.IsGeneratedByGlobalSections D'.divisorialSheaf) :
    QDivisor.IsRelativelySemiample sX Q := by
  obtain ⟨E, hE⟩ := exists_isWeilDivisorOfCartier hsm D'
  obtain ⟨e⟩ := hE.nonempty_sheaf_iso_divisorialSheaf
  exact QDivisor.isRelativelySemiample_of_isRelativelyFreeCartier Q n hn D' hQ E hE
    (isRelativelyFreeCartier_of_isGeneratedByGlobalSections hvar hprop E
    (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso e.symm hgg))

private theorem exists_pos_nat_mul_eq_intCast (B : QDivisor X) :
    ∃ N : ℕ, 0 < N ∧ ∀ P, ∃ z : ℤ, (N : ℚ) * B P = z := by
  classical
  refine ⟨∏ P ∈ B.support, (B P).den, Finset.prod_pos (fun P _ => (B P).den_pos), fun P => ?_⟩
  by_cases hP : P ∈ B.support
  · obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun P => (B P).den) hP
    refine ⟨c * (B P).num, ?_⟩
    rw [hc]
    push_cast
    rw [mul_comm ((B P).den : ℚ) c, mul_assoc, Rat.den_mul_eq_num]
  · rw [Finsupp.notMem_support_iff.1 hP]
    exact ⟨0, by simp⟩

private theorem intCast_sum (D : Divisor X) :
    ((D.sum fun _ a => a : ℤ) : ℚ) = D.sum fun _ a => (a : ℚ) := by
  simp [Finsupp.sum]

private theorem isRelativelySemiample_of_curve
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P ∧ B.coeff P ≤ 1)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 1)
    (hdeg : 0 ≤ (K.sum fun _ a => (a : ℚ)) + B.sum fun _ a => a) :
    QDivisor.IsRelativelySemiample sX (Divisor.toQDivisor K + B) := by
  classical
  set Q := Divisor.toQDivisor K + B with hQdef
  have hKs := MMP.Flips.sum_coeff_canonical_eq hvar hsm hprop hK
  set g := K.h0 k sX with hg
  have hQsum : (Q.sum fun _ a => a) = (K.sum fun _ a => (a : ℚ)) + B.sum fun _ a => a := by
    rw [hQdef, Finsupp.sum_add_index' (by simp) (by intros; rfl)]
    congr 1
    exact Finsupp.sum_mapRange_index (hf := map_zero _) (fun _ => rfl)
  obtain ⟨N, hN, hNB⟩ := exists_pos_nat_mul_eq_intCast B
  have hint : ∀ P, ∃ z : ℤ, (N : ℚ) * Q P = z := fun P => by
    obtain ⟨z, hz⟩ := hNB P
    refine ⟨N * K P + z, ?_⟩
    rw [hQdef, Finsupp.add_apply, mul_add, hz]
    push_cast
    rfl
  let D : Divisor X := ((N : ℚ) • Q).mapRange Int.floor (by simp)
  have hD : ∀ P, (D.coeff P : ℚ) = N * Q.coeff P := fun P => by
    obtain ⟨z, hz⟩ := hint P
    change ((Int.floor (((N : ℚ) • Q) P) : ℤ) : ℚ) = _
    rw [Finsupp.smul_apply, smul_eq_mul, hz, Int.floor_intCast]
    exact hz.symm
  have hDQ : Divisor.toQDivisor D = (N : ℚ) • Q := by
    ext P
    exact hD P
  have hDsum : ((D.sum fun _ a => a : ℤ) : ℚ) = N * Q.sum fun _ a => a := by
    rw [intCast_sum]
    have : (D.sum fun _ a => (a : ℚ)) = (Divisor.toQDivisor D).sum fun _ a => a :=
      by
      symm
      exact Finsupp.sum_mapRange_index (hf := map_zero _) (fun _ => rfl)
    rw [this, hDQ, Finsupp.sum_smul_index (by simp), Finsupp.mul_sum]
  have hdeg' : 0 ≤ Q.sum fun _ a => a := hQsum ▸ hdeg
  rcases hdeg'.lt_or_eq with hpos | hzero
  · have hDpos : 0 < (D.sum fun _ a => a) := by
      have : (0 : ℚ) < ((D.sum fun _ a => a : ℤ) : ℚ) := by
        rw [hDsum]; exact mul_pos (by exact_mod_cast hN) hpos
      exact_mod_cast this
    refine QDivisor.isRelativelySemiample_of_isGeneratedByGlobalSections hvar hsm hprop Q
      (N * (2 * g + 1)) (by positivity)
      (((2 * g + 1 : ℕ) : ℤ) • D) (fun P => ?_)
      (isGeneratedByGlobalSections_of_two_mul_h0_le hvar hsm hprop hdim hK _ ?_)
    · change ((((2 * g + 1 : ℕ) : ℤ) • D) P : ℚ) = _
      rw [Finsupp.smul_apply, smul_eq_mul, Int.cast_mul]
      change _ * (D.coeff P : ℚ) = _
      rw [hD P]
      push_cast
      ring
    · rw [Finsupp.sum_smul_index (by simp), ← Finsupp.mul_sum]
      have h1 : (1 : ℤ) ≤ D.sum fun _ a => a := hDpos
      push_cast
      nlinarith
  · have hBnn : 0 ≤ B.sum fun _ a => a := Finsupp.sum_nonneg (fun P _ => (hB P).1)
    have hQ0 : (Q.sum fun _ a => a) = 0 := hzero.symm
    rw [hQsum, hKs] at hQ0
    have hg1 : g ≤ 1 := by
      have : (g : ℚ) ≤ 1 := by linarith
      exact_mod_cast this
    rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hg1 with hg0 | hg1
    · refine QDivisor.isRelativelySemiample_of_isGeneratedByGlobalSections hvar hsm hprop Q N hN
        D hD
        (isGeneratedByGlobalSections_of_sum_eq_zero_of_h0_eq_zero hvar hsm hprop hdim hK hg0 D ?_)
      have : ((D.sum fun _ a => a : ℤ) : ℚ) = 0 := by rw [hDsum, hzero.symm, mul_zero]
      exact_mod_cast this
    · have hB0 : ∀ P, B P = 0 := by
        have hBs : (B.sum fun _ a => a) = 0 := by rw [hg1] at hQ0; push_cast at hQ0; linarith
        intro P
        by_cases hP : P ∈ B.support
        · exact (Finset.sum_eq_zero_iff_of_nonneg (fun P _ => (hB P).1)).1 hBs P hP
        · exact Finsupp.notMem_support_iff.1 hP
      refine QDivisor.isRelativelySemiample_of_isGeneratedByGlobalSections hvar hsm hprop Q 1
        one_pos K
        (fun P => ?_)
        (isGeneratedByGlobalSections_of_sum_eq_zero_of_h0_pos hvar hsm hprop hdim K ?_
          (by rw [← hg, hg1]; exact one_pos))
      · change (K.coeff P : ℚ) = 1 * (Divisor.toQDivisor K P + B P)
        rw [hB0 P, add_zero, one_mul]
        rfl
      · have : ((K.sum fun _ a => a : ℤ) : ℚ) = 0 := by
          rw [intCast_sum, hKs, hg1]; norm_num
        exact_mod_cast this

end Semiample

section Bridge

open MMP.Intersection (componentGenericPoint_specializes_genericPoint
    functionFieldToRationalFunctions evalFF_functionFieldToRationalFunctions
        valuation_component_eq_exp_ord)

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The generic point of a prime divisor of the curve is a closed point. -/
private theorem isClosed_singleton_genericPoint (hdim : topologicalKrullDim X = 1)
    (P : Mori.PrimeDivisor X) : IsClosed ({P.genericPoint} : Set X) := by
  refine Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint X hdim
    fun h => ?_
  have h1 := P.coheight_genericPoint
  rw [h, show genericPoint X = (⊤ : X) from rfl, Order.coheight_top] at h1
  exact zero_ne_one h1

private theorem fromSpecStalk_comp_eq_specMap (x : X) :
    X.fromSpecStalk x ≫ sX =
      Spec.map ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ x trivial) := by
  have key : (Scheme.ΓSpecIso (.of k)).inv ≫ (X.fromSpecStalk x ≫ sX).appTop ≫
      (Scheme.ΓSpecIso (X.presheaf.stalk x)).hom =
      (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    simp only [Scheme.Hom.comp_appTop, Category.assoc, Scheme.fromSpecStalk_appTop]
    have : (homOfLE le_top : (⊤ : (Spec (X.presheaf.stalk x)).Opens) ⟶ ⊤) = 𝟙 _ := rfl
    rw [this, op_id, CategoryTheory.Functor.map_id, Category.id_comp, Iso.inv_hom_id,
      Category.comp_id]
  have hpre : Spec.preimage (X.fromSpecStalk x ≫ sX) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    rw [← key]
    have := Scheme.ΓSpecIso_naturality (Spec.preimage (X.fromSpecStalk x ≫ sX))
    rw [Spec.map_preimage] at this
    rw [this, Iso.inv_hom_id_assoc]
  rw [← hpre, Spec.map_preimage]

/-- At a closed point of the curve, every element of the local ring is congruent to a scalar
modulo the maximal ideal: the residue field is `k`. -/
private theorem exists_sub_algebraMap_mem_maximalIdeal (hvar : Mori.IsNormalVariety k sX)
    {x : X} (hx : IsClosed ({x} : Set X)) (a : X.presheaf.stalk x) :
    letI := stalkAlgebra sX x
    ∃ c : k, a - algebraMap k (X.presheaf.stalk x) c ∈ IsLocalRing.maximalIdeal _ := by
  letI := stalkAlgebra sX x
  haveI : LocallyOfFiniteType sX := hvar.1.toLocallyOfFiniteType
  set e := residueFieldIsoBase sX x hx
  set ψ : CommRingCat.of k ⟶ X.presheaf.stalk x :=
    (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ x trivial
  have hφ : ψ ≫ X.residue x = e.inv := by
    apply Spec.map_injective
    rw [Spec.map_comp, ← fromSpecStalk_comp_eq_specMap, SpecMap_residueFieldIsoBase_inv]
    rfl
  have hsurj : Function.Surjective (ψ ≫ X.residue x) := by
    rw [hφ]; exact (ConcreteCategory.bijective_of_isIso e.inv).2
  obtain ⟨c, hc⟩ := hsurj (X.residue x a)
  refine ⟨c, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero]
  exact hc.symm

/-- Every point of the curve other than the generic point is the generic point of a prime
divisor. -/
private theorem exists_primeDivisor_of_ne_genericPoint (hdim : topologicalKrullDim X = 1) {x : X}
    (hx : x ≠ genericPoint X) : ∃ P : Mori.PrimeDivisor X, P.genericPoint = x := by
  have hn' : Order.krullDim X = 1 := by
    rw [← hdim]
    exact (Order.krullDim_eq_of_orderIso (irreducibleSetEquivPoints (α := X))).symm
  have h1 : Order.coheight x ≤ 1 := by
    have := Order.coheight_le_krullDim x
    rw [hn'] at this
    exact_mod_cast this
  have h0 : Order.coheight x ≠ 0 := by
    intro h
    have hmax : IsMax x := Order.coheight_eq_zero.mp h
    have hgen : genericPoint X ⤳ x := (genericPoint_spec X).specializes trivial
    have hx' : x ⤳ genericPoint X := hmax (show x ≤ genericPoint X from hgen)
    exact hx (hgen.antisymm hx').eq.symm
  have hx1 : Order.coheight x = 1 := by
    generalize Order.coheight x = c at h0 h1 ⊢
    induction c using ENat.recTopCoe with
    | top => exact absurd h1 (by simp)
    | coe n => norm_cast at h0 h1 ⊢; omega
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne x hx1,
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne x hx1⟩

private theorem ord_algebraMap_eq_zero (P : Mori.PrimeDivisor X) {c : k} (hc : c ≠ 0) :
    letI := functionFieldAlgebra sX
    X.ord (algebraMap k X.functionField c) P.genericPoint = 0 := by
  letI := functionFieldAlgebra sX
  have hu : IsUnit (((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop).hom c) :=
    (IsUnit.mk0 c hc).map _
  exact Scheme.ord_of_isUnit (U := ⊤) hu trivial

private theorem ord_nonneg_iff_mem_range (P : Mori.PrimeDivisor X) {f : X.functionField}
    (hf : f ≠ 0) :
    0 ≤ X.ord f P.genericPoint ↔ f ∈ (algebraMap P.localRing X.functionField).range := by
  rw [← MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff,
    P.divisorialValuation_eq_exp_neg_ord hf,
    ← WithZero.exp_zero, WithZero.exp_le_exp]
  omega

private theorem one_le_ord_iff (P : Mori.PrimeDivisor X) (r : P.localRing)
    (hr : algebraMap P.localRing X.functionField r ≠ 0) :
    1 ≤ X.ord (algebraMap P.localRing X.functionField r) P.genericPoint ↔
      r ∈ IsLocalRing.maximalIdeal P.localRing := by
  rw [← MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff,
    P.divisorialValuation_eq_exp_neg_ord hr, ← WithZero.exp_zero, WithZero.exp_lt_exp]
  omega

open CurveAlg in
/-- The local layer: orders of vanishing, residues and uniformizers at the prime divisors. -/
private noncomputable def curveFF (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) :
    @CurveFF k X.functionField (Mori.PrimeDivisor X) _ _ (functionFieldAlgebra sX) :=
  letI := functionFieldAlgebra sX
  { ord := fun P f => X.ord f P.genericPoint
    ord_zero := fun P => by simp
    ord_mul := fun P f g hf hg => Scheme.ord_mul hf hg
    ord_add := fun P f g h => by
      haveI := P.isDiscreteValuationRing_localRing
      exact Scheme.ord_add h
    ord_algebraMap := fun P c hc => ord_algebraMap_eq_zero P hc
    residue := fun P f hf => by
      by_cases hf0 : f = 0
      · exact ⟨0, Or.inl (by rw [hf0, map_zero])⟩
      obtain ⟨a, rfl⟩ := (ord_nonneg_iff_mem_range P hf0).mp hf
      letI := stalkAlgebra sX P.genericPoint
      haveI := isScalarTower_stalk_functionField sX P.genericPoint
      obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem_maximalIdeal hvar
        (isClosed_singleton_genericPoint hdim P) a
      refine ⟨c, ?_⟩
      have e : algebraMap P.localRing X.functionField a - algebraMap k X.functionField c =
          algebraMap P.localRing X.functionField (a - algebraMap k P.localRing c) := by
        rw [map_sub, ← IsScalarTower.algebraMap_apply]
      by_cases h0 : algebraMap P.localRing X.functionField (a - algebraMap k P.localRing c) = 0
      · left; rw [← sub_eq_zero, e, h0]
      · right; rw [e]; exact (one_le_ord_iff P _ h0).mpr hc
    exists_uniformizer := fun P => by
      haveI := P.isDiscreteValuationRing_localRing
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P.localRing
      have hv := P.divisorialValuation_algebraMap_of_irreducible hϖ
      have h0 : algebraMap P.localRing X.functionField ϖ ≠ 0 := fun h => by
        rw [h, map_zero] at hv; exact WithZero.zero_ne_coe hv
      refine ⟨algebraMap P.localRing X.functionField ϖ, ?_⟩
      rw [P.divisorialValuation_eq_exp_neg_ord h0] at hv
      have := WithZero.exp_injective hv
      omega }

/-- A rational function lying in every stalk of the integral scheme `X` is a global section:
the local representatives agree on overlaps, the germ map at the generic point being injective,
so they glue. -/
private theorem exists_globalSection_of_forall_mem_stalk (Y : Scheme.{u}) [IsIntegral Y]
    [Nonempty (⊤ : Y.Opens)] (a : Y.functionField)
    (ha : ∀ y : Y, ∃ b : Y.presheaf.stalk y,
      algebraMap (Y.presheaf.stalk y) Y.functionField b = a) :
    ∃ b : Γ(Y, ⊤), Y.germToFunctionField ⊤ b = a := by
  classical
  have hlocal (y : Y) : ∃ (U : Y.Opens) (hy : y ∈ U) (b : Γ(Y, U)),
      ∃ hU : Nonempty U, @Scheme.germToFunctionField Y _ U hU b = a := by
    obtain ⟨b, hb⟩ := ha y
    obtain ⟨U, hy, c, hc⟩ := Y.presheaf.exists_germ_eq b
    let : Nonempty U := ⟨⟨y, hy⟩⟩
    exact ⟨U, hy, c, inferInstance, by
      rw [← Y.algebraMap_germ_eq_germToFunctionField hy c, hc, hb]⟩
  choose U hy b hU hb using hlocal
  let (y : Y) : Nonempty (U y) := hU y
  have hgen (y : Y) : genericPoint Y ∈ U y :=
    ((genericPoint_spec Y).mem_open_set_iff (U y).isOpen).mpr ⟨y, trivial, hy y⟩
  have hcompat : TopCat.Presheaf.IsCompatible Y.presheaf U b := by
    intro i j
    have hmem : genericPoint Y ∈ U i ⊓ U j := ⟨hgen i, hgen j⟩
    apply germ_injective_of_isIntegral Y (U := U i ⊓ U j) (genericPoint Y) hmem
    rw [Y.presheaf.germ_res_apply, Y.presheaf.germ_res_apply]
    exact (hb i).trans (hb j).symm
  obtain ⟨c, hc, -⟩ := Y.sheaf.existsUnique_gluing' U ⊤
    (fun i ↦ homOfLE le_top) (by
      intro y _
      exact Opens.mem_iSup.mpr ⟨y, hy y⟩) b hcompat
  refine ⟨c, ?_⟩
  rw [← hb (genericPoint Y), ← hc (genericPoint Y)]
  exact (Y.presheaf.germ_res_apply (homOfLE le_top) (genericPoint Y)
    (hgen (genericPoint Y)) c).symm

private theorem ord_unit_functionFieldToRationalFunctions (P : Mori.PrimeDivisor X)
    {f : X.functionField} (hf : f ≠ 0) :
    P.ord (Units.map (functionFieldToRationalFunctions (S := X)).toMonoidHom (Units.mk0 f hf)) =
      X.ord f P.genericPoint := by
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
  change X.ord (MMP.Threefold.Mori.Helpers.evalFF _ (functionFieldToRationalFunctions f)) _ = _
  rw [evalFF_functionFieldToRationalFunctions]

open CurveAlg in
/-- The global layer: points exist, principal divisors have degree zero, and the regular
functions are the constants. -/
private noncomputable def properCurveFF (hvar : Mori.IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) :
    @ProperCurveFF k X.functionField (Mori.PrimeDivisor X) _ _ (functionFieldAlgebra sX) :=
  letI := functionFieldAlgebra sX
  { curveFF hvar hdim with
    nonempty := MMP.Positivity.nonempty_primeDivisor_of_topologicalKrullDim_eq hdim one_ne_zero
    finite_support := fun f hf => by
      haveI := QuasiCompact.compactSpace_of_compactSpace sX
      have := MMP.Mori.finite_ord_ne_zero
        (Units.map (functionFieldToRationalFunctions (S := X)).toMonoidHom (Units.mk0 f hf))
      simp only [ord_unit_functionFieldToRationalFunctions _ hf] at this
      exact this
    deg_div := fun f hf => by
      haveI := QuasiCompact.compactSpace_of_compactSpace sX
      have h := MMP.Flips.sum_principalDivisor_eq_zero hvar hsm hprop hdim
        (Units.map (functionFieldToRationalFunctions (S := X)).toMonoidHom (Units.mk0 f hf))
      convert h using 2
      ext P
      change X.ord f P.genericPoint = (MMP.Mori.principalDivisor _).coeff P
      rw [MMP.Mori.coeff_principalDivisor, ord_unit_functionFieldToRationalFunctions _ hf]
    const := fun f hf => by
      obtain ⟨-, -, hiso⟩ := isCurve_and_smooth_and_isIso_globalSections hvar hsm hprop hdim
      have ha : ∀ x : X, ∃ b : X.presheaf.stalk x,
          algebraMap (X.presheaf.stalk x) X.functionField b = f := by
        intro x
        by_cases hx : x = genericPoint X
        · exact MMP.Positivity.DivisorOver.algebraMap_stalk_surjective_of_eq_genericPoint x hx f
        obtain ⟨P, rfl⟩ := exists_primeDivisor_of_ne_genericPoint hdim hx
        by_cases hf0 : f = 0
        · exact ⟨0, by rw [hf0, map_zero]⟩
        obtain ⟨b, hb⟩ := (ord_nonneg_iff_mem_range P hf0).mp (hf P)
        exact ⟨b, hb⟩
      obtain ⟨b, hb⟩ := exists_globalSection_of_forall_mem_stalk X f ha
      obtain ⟨c, hc⟩ := (ConcreteCategory.bijective_of_isIso
        ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop)).2 b
      exact ⟨c, by rw [← hb, ← hc]; rfl⟩ }

/-- **Riemann–Roch inequality.** `h⁰(D) ≥ deg D + 1 - g`, with `g = h⁰(K)`. -/
private theorem sum_add_one_sub_le_h0 [IsAlgClosed k] (hvar : Mori.IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    {K₀ : Divisor X} (hK : K₀.IsCanonicalDivisor sX 1) (D : Divisor X) :
    (D.sum fun _ a => a) + 1 - (K₀.h0 k sX : ℤ) ≤ D.h0 k sX := by
  obtain ⟨hc, hs, hiso⟩ := isCurve_and_smooth_and_isIso_globalSections hvar hsm hprop hdim
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm D).isInvertibleModule_divisorialSheaf
  have hRR := finrank_sub_finrank_eq_invertibleCurveDegree_add_genus k sX hdim.le
    D.divisorialSheaf
  rw [invertibleCurveDegree_divisorialSheaf_eq_sum hvar hsm hprop hdim D,
    genus_eq_h0_canonical hvar hsm hprop hK] at hRR
  have h0 : Module.finrank k (cohomologyOverField k sX D.divisorialSheaf 0) = D.h0 k sX :=
    (cohomologyOverFieldZeroLinearEquivGlobalSectionsOver sX _).finrank_eq
  rw [h0] at hRR
  have : (0 : ℤ) ≤ Module.finrank k (cohomologyOverField k sX D.divisorialSheaf 1) := by
    positivity
  linarith

/-- A rational function, as a global section of the sheaf of rational functions. -/
private noncomputable def toRationalFunctionsTop (f : X.functionField) :
    ToType ((Mori.rationalFunctionsPresheaf X).obj (op ⊤)) :=
  fun Z => X.presheaf.stalkSpecializes (componentGenericPoint_specializes_genericPoint Z.1) f

private theorem isDivisorialSection_toRationalFunctionsTop_iff (D : Divisor X)
    (f : X.functionField) :
    D.IsDivisorialSection ⊤ (toRationalFunctionsTop f) ↔
      f = 0 ∨ ∀ P : Mori.PrimeDivisor X, 0 ≤ X.ord f P.genericPoint + D P := by
  by_cases hf : f = 0
  · subst hf
    simp only [true_or, iff_true]
    intro E _
    left
    simp [toRationalFunctionsTop]
  simp only [hf, false_or]
  have key : ∀ E : Mori.PrimeDivisor X, ∀ h : (E.support ∩ (⊤ : X.Opens)).Nonempty,
      (E.OrdGE (-D.coeff E) (toRationalFunctionsTop f
        ⟨E.component, E.componentGenericPoint_mem_of_nonempty h⟩) ↔
        0 ≤ X.ord f E.genericPoint + D E) := by
    intro E h
    set ψ := Units.map (functionFieldToRationalFunctions (S := X)).toMonoidHom (Units.mk0 f hf)
    have hcomp : toRationalFunctionsTop f ⟨E.component, E.componentGenericPoint_mem_of_nonempty h⟩ =
        MMP.Mori.RationalFunctions.component X E.component ψ := rfl
    have hne : MMP.Mori.RationalFunctions.component X E.component ψ ≠ 0 :=
      (ψ.isUnit.map (MMP.Mori.RationalFunctions.component X E.component)).ne_zero
    rw [hcomp]
    unfold MMP.Mori.PrimeDivisor.OrdGE
    rw [valuation_component_eq_exp_ord E ψ, ord_unit_functionFieldToRationalFunctions E hf,
      WithZero.exp_le_exp]
    simp only [hne, false_or]
    change -D E ≤ _ ↔ _
    omega
  constructor
  · intro h P
    have hP : (P.support ∩ (⊤ : X.Opens)).Nonempty := ⟨P.genericPoint, by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact ⟨subset_closure rfl, trivial⟩⟩
    exact (key P hP).mp (h P hP)
  · intro h E hE
    exact (key E hE).mpr (h E)

private theorem finrank_lin_eq_h0 (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) (D : Divisor X) :
    letI := functionFieldAlgebra sX
    Module.finrank k ((properCurveFF hvar hsm hprop hdim).lin D) = D.h0 k sX := by
  classical
  letI := functionFieldAlgebra sX
  set C := properCurveFF hvar hsm hprop hdim
  letI : Module k (D.divisorialSubmodule ⊤) := Module.compHom _ (scalarsToGlobalSections k sX)
  have hmem : ∀ f : X.functionField, f ∈ C.lin D ↔
      D.IsDivisorialSection ⊤ (toRationalFunctionsTop f) := fun f =>
    (isDivisorialSection_toRationalFunctionsTop_iff D f).symm
  let Θ : C.lin D →ₗ[k] D.divisorialSubmodule ⊤ :=
    { toFun := fun f => ⟨toRationalFunctionsTop (f : X.functionField), (hmem f).mp f.2⟩
      map_add' := fun f g => Subtype.ext (funext fun Z => by
        simp [toRationalFunctionsTop, map_add]; rfl)
      map_smul' := fun c f => Subtype.ext (funext fun Z => by
        change toRationalFunctionsTop (c • (f : X.functionField)) Z =
          ((scalarsToGlobalSections k sX c) • toRationalFunctionsTop (f : X.functionField)) Z
        rw [MMP.Mori.rationalFunctions_smul_apply, Algebra.smul_def]
        simp only [toRationalFunctionsTop, map_mul]
        congr 1
        change X.presheaf.stalkSpecializes (componentGenericPoint_specializes_genericPoint Z.1)
          (X.presheaf.germ ⊤ (genericPoint X) (Opens.mem_top _)
            (scalarsToGlobalSections k sX c)) = _
        exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf (Opens.mem_top _)
          (componentGenericPoint_specializes_genericPoint Z.1) _) }
  have hsub : Subsingleton (irreducibleComponents X) :=
    MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents
  have hbij : Function.Bijective Θ := by
    constructor
    · intro f g hfg
      have h1 := congrArg (fun φ : D.divisorialSubmodule ⊤ =>
        MMP.Threefold.Mori.Helpers.evalFF
          (MMP.Mori.exists_mem_irreducibleComponents (genericPoint X)).choose
          ((MMP.Mori.rationalFunctionsPresheafTopEquiv X) φ.1)) hfg
      simp only [Θ, LinearMap.coe_mk, AddHom.coe_mk] at h1
      exact Subtype.ext (by
        have e1 := evalFF_functionFieldToRationalFunctions
          (MMP.Mori.exists_mem_irreducibleComponents (genericPoint X)).choose (f : X.functionField)
        have e2 := evalFF_functionFieldToRationalFunctions
          (MMP.Mori.exists_mem_irreducibleComponents (genericPoint X)).choose (g : X.functionField)
        rw [← e1, ← e2]; exact h1)
    · intro φ
      obtain ⟨Z₀, -⟩ := MMP.Mori.exists_mem_irreducibleComponents (genericPoint X)
      set f : X.functionField := MMP.Threefold.Mori.Helpers.evalFF Z₀
        ((MMP.Mori.rationalFunctionsPresheafTopEquiv X) φ.1)
      have hf : toRationalFunctionsTop f = φ.1 := by
        funext Z
        obtain ⟨Z, hZ⟩ := Z
        obtain rfl : Z = Z₀ := Subsingleton.elim _ _
        simp only [toRationalFunctionsTop, f, MMP.Threefold.Mori.Helpers.evalFF,
          RingHom.coe_comp, Function.comp_apply]
        rw [← CategoryTheory.comp_apply, TopCat.Presheaf.stalkSpecializes_comp,
          TopCat.Presheaf.stalkSpecializes_refl]
        rfl
      exact ⟨⟨f, (hmem f).mpr (hf ▸ φ.2)⟩, Subtype.ext hf⟩
  exact (LinearEquiv.ofBijective Θ hbij).finrank_eq

open CurveAlg in
/-- The genus layer: the Riemann–Roch inequality, with genus `h⁰(K)`. -/
private noncomputable def curveFFRR (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) {K₀ : Divisor X}
    (hK : K₀.IsCanonicalDivisor sX 1) :
    @CurveFFRR k X.functionField (Mori.PrimeDivisor X) _ _ (functionFieldAlgebra sX) :=
  letI := functionFieldAlgebra sX
  { properCurveFF hvar hsm hprop hdim with
    genus := K₀.h0 k sX
    rr := fun D => by
      have h1 := sum_add_one_sub_le_h0 hvar hsm hprop hdim hK D
      have h2 := finrank_lin_eq_h0 hvar hsm hprop hdim D
      change (D.sum fun _ a => a) + 1 - (K₀.h0 k sX : ℤ) ≤
        (Module.finrank k ((properCurveFF hvar hsm hprop hdim).lin D) : ℤ)
      rw [h2]; exact h1 }

/-- A basis of the line of rational differentials of the curve. -/
private noncomputable def formBasis (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra sX
    Module.Basis Unit X.functionField (⋀[X.functionField]^1 Ω[X.functionField⁄k]) :=
  letI := functionFieldAlgebra sX
  Module.basisUnique Unit (MMP.Positivity.finrank_topForms_functionField_eq_one hvar
    (fun Γ => MMP.Positivity.PrimeDivisor.genericPoint_mem_smoothLocus hvar Γ)
    (by rw [hdim]; rfl))

/-- The derivation dual to the basis `formBasis`: `d f = D(f) · b`. -/
private noncomputable def formDer (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) :
    letI := functionFieldAlgebra sX
    Derivation k X.functionField X.functionField :=
  letI := functionFieldAlgebra sX
  (((formBasis hvar hdim).coord ()).comp
    (exteriorPower.oneEquiv X.functionField Ω[X.functionField⁄k]).symm.toLinearMap).compDer
    (KaehlerDifferential.D k X.functionField)

private theorem formDer_apply (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) (f : X.functionField) :
    letI := functionFieldAlgebra sX
    formDer hvar hdim f • formBasis hvar hdim () =
      exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField f) := by
  letI := functionFieldAlgebra sX
  have := MMP.Mori.basis_unit_repr_smul (formBasis hvar hdim)
    (exteriorPower.ιMulti X.functionField 1 (fun _ => KaehlerDifferential.D k X.functionField f))
  convert this using 2
  simp [formDer, exteriorPower.oneEquiv_symm_apply, Module.Basis.coord_apply]

/-- **The differential of a uniformizer generates the differentials of the local ring.** -/
private theorem exists_kaehler_uniformizer (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) (P : Mori.PrimeDivisor X) {ϖ : P.localRing}
    (hϖ : Irreducible ϖ) :
    letI := stalkAlgebra sX P.genericPoint
    ∀ ω : Ω[P.localRing⁄k], ∃ c : P.localRing, ω = c • KaehlerDifferential.D k P.localRing ϖ := by
  letI := stalkAlgebra sX P.genericPoint
  haveI : LocallyOfFiniteType sX := hvar.1.toLocallyOfFiniteType
  haveI := P.isDiscreteValuationRing_localRing
  obtain ⟨hfree, hfin⟩ := P.free_kaehlerDifferential_localRing (sX := sX)
  letI : Algebra k (IsLocalRing.ResidueField P.localRing) :=
    ((algebraMap P.localRing (IsLocalRing.ResidueField P.localRing)).comp
      (algebraMap k P.localRing)).toAlgebra
  haveI : IsScalarTower k P.localRing (IsLocalRing.ResidueField P.localRing) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hbij : Function.Bijective (algebraMap k (IsLocalRing.ResidueField P.localRing)) := by
    refine ⟨(algebraMap k _).injective, fun r => ?_⟩
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
    obtain ⟨c, hc⟩ := exists_sub_algebraMap_mem_maximalIdeal hvar
      (isClosed_singleton_genericPoint hdim P) a
    refine ⟨c, ?_⟩
    change IsLocalRing.residue _ (algebraMap k P.localRing c) = _
    rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hc
  haveI : Algebra.FormallyEtale k (IsLocalRing.ResidueField P.localRing) :=
    Algebra.FormallyEtale.of_equiv (AlgEquiv.ofBijective (Algebra.ofId k _) hbij)
  have hs := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hd : ringKrullDim P.localRing = 1 := by
    rw [ringKrullDim_stalk_eq_coheight, P.coheight_genericPoint]; rfl
  obtain ⟨e, he⟩ := differential_uniformizer_linearEquiv k P.localRing ϖ hs hd
  intro ω
  refine ⟨e.symm ω, ?_⟩
  conv_lhs => rw [← e.apply_symm_apply ω]
  rw [← he, ← LinearEquiv.map_smul, smul_eq_mul, mul_one]

/-- The `m`-th power of the basis `formBasis`, as a rational `m`-canonical form. -/
private noncomputable def formBasisPow (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) (m : ℤ) :
    letI := functionFieldAlgebra sX
    RationalPluriForms sX 1 m :=
  letI := functionFieldAlgebra sX
  ZTensorPower.basis (formBasis hvar hdim) m ()

/-- **The derivation at a point.** For a uniformizer `t` at `P`, `D t ≠ 0`,
`ord_P (D t) = -ord_P b` and `D 𝒪_P ⊆ (D t) 𝒪_P`. -/
private theorem exists_formDer_loc (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) (P : Mori.PrimeDivisor X) :
    letI := functionFieldAlgebra sX
    ∃ t : X.functionField, X.ord t P.genericPoint = 1 ∧ formDer hvar hdim t ≠ 0 ∧
      X.ord (formDer hvar hdim t) P.genericPoint =
        -P.ordForm (formBasisPow hvar hdim 1) ∧
      ∀ u : X.functionField, (u = 0 ∨ 0 ≤ X.ord u P.genericPoint) →
        formDer hvar hdim u = 0 ∨
          X.ord (formDer hvar hdim t) P.genericPoint ≤
            X.ord (formDer hvar hdim u) P.genericPoint := by
  letI := functionFieldAlgebra sX
  letI := stalkAlgebra sX P.genericPoint
  haveI := isScalarTower_stalk_functionField sX P.genericPoint
  haveI := P.isDiscreteValuationRing_localRing
  haveI : IsFractionRing P.localRing X.functionField :=
    inferInstanceAs (IsFractionRing (X.presheaf.stalk P.genericPoint) X.functionField)
  set b := formBasis hvar hdim
  set D := formDer hvar hdim
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P.localRing
  set t := algebraMap P.localRing X.functionField ϖ
  have ht0 : t ≠ 0 := fun h => by
    have hv := P.divisorialValuation_algebraMap_of_irreducible hϖ
    change P.divisorialValuation t = _ at hv
    rw [h, map_zero] at hv; exact WithZero.zero_ne_coe hv
  have ht : X.ord t P.genericPoint = 1 := by
    have hv := P.divisorialValuation_algebraMap_of_irreducible hϖ
    change P.divisorialValuation t = _ at hv
    rw [P.divisorialValuation_eq_exp_neg_ord ht0] at hv
    have := WithZero.exp_injective hv
    omega
  have hΩ := exists_kaehler_uniformizer hvar hdim P hϖ
  have hι : ∀ x : Ω[X.functionField⁄k],
      exteriorPower.ιMulti X.functionField 1 (fun _ => x) =
        (exteriorPower.oneEquiv X.functionField Ω[X.functionField⁄k]).symm x := fun x => by
    rw [exteriorPower.oneEquiv_symm_apply]
  have hb0 : b () ≠ 0 := b.ne_zero ()
  have key : ∀ a : P.localRing, ∃ c : P.localRing,
      D (algebraMap P.localRing X.functionField a) = algebraMap P.localRing _ c * D t := by
    intro a
    obtain ⟨c, hc⟩ := hΩ (KaehlerDifferential.D k P.localRing a)
    refine ⟨c, smul_left_injective X.functionField hb0 ?_⟩
    simp only [smul_eq_mul]
    change D _ • b () = (algebraMap P.localRing X.functionField c * D t) • b ()
    rw [formDer_apply, mul_smul, formDer_apply, hι, hι, ← LinearEquiv.map_smul]
    congr 1
    rw [← KaehlerDifferential.map_D k k P.localRing X.functionField, hc,
      LinearMap.map_smul_of_tower,
      KaehlerDifferential.map_D, algebraMap_smul]
  set σ := exteriorPower.ιMulti P.localRing 1 (fun _ => KaehlerDifferential.D k P.localRing ϖ)
  have hσ : Submodule.span P.localRing {σ} = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨c, hc⟩ := hΩ (exteriorPower.oneEquiv P.localRing _ y)
    rw [Submodule.mem_span_singleton]
    refine ⟨c, ?_⟩
    apply (exteriorPower.oneEquiv P.localRing Ω[P.localRing⁄k]).injective
    rw [LinearEquiv.map_smul, hc]
    simp [σ]
  have hσmap : topFormsMap k P.localRing X.functionField 1 σ = D t • b () := by
    rw [formDer_apply, topFormsMap_ιMulti]
    simp only [KaehlerDifferential.map_D]
    rfl
  have hspan := span_singleton_topFormsMap (nonZeroDivisors P.localRing) hσ (K := X.functionField)
  have h0 : topFormsMap k P.localRing X.functionField 1 σ ≠ 0 := by
    intro h
    rw [h, Submodule.span_singleton_eq_bot.mpr rfl] at hspan
    exact hb0 (by
      have : b () ∈ (⊥ : Submodule X.functionField _) := hspan ▸ Submodule.mem_top
      simpa using this)
  have hDt : D t ≠ 0 := fun h => h0 (by rw [hσmap, h, zero_smul])
  refine ⟨t, ht, hDt, ?_, fun u hu => ?_⟩
  · have hord := P.ordForm_eq (formBasisPow hvar hdim 1) hσ h0
    have hrepr : formCoeff (k := k) (m := 1) P.localRing hσ h0 (formBasisPow hvar hdim 1) =
        (D t)⁻¹ := by
      unfold formCoeff formBasisPow
      rw [ZTensorPower.basis_repr_of_eq_smul (b := b) (c := D t) (by
        rw [topFormsBasis_apply]; exact hσmap) 1]
      change (D t ^ (1 : ℤ))⁻¹ * ((ZTensorPower.basis b 1).repr (ZTensorPower.basis b 1 ())) () = _
      rw [Module.Basis.repr_self, Finsupp.single_eq_same, mul_one, zpow_one]
    rw [hord, hrepr]
    have h := (curveFF hvar hdim).ord_inv P hDt
    change X.ord (D t)⁻¹ P.genericPoint = -X.ord (D t) P.genericPoint at h
    omega
  · rcases hu with hu | hu
    · left; rw [hu, map_zero]
    by_cases hu0 : u = 0
    · left; rw [hu0, map_zero]
    obtain ⟨a, rfl⟩ := (ord_nonneg_iff_mem_range P hu0).mp hu
    obtain ⟨c, hc⟩ := key a
    rw [hc]
    by_cases hc0 : algebraMap P.localRing X.functionField c = 0
    · left; rw [hc0, zero_mul]
    right
    rw [Scheme.ord_mul hc0 hDt]
    have := (ord_nonneg_iff_mem_range P hc0).mpr ⟨c, rfl⟩
    omega

/-- **Centers of valuations on a proper curve.** A discrete valuation of the function field,
trivial on `k` and taking the value `exp (-1)`, is the valuation of a point. -/
private theorem exists_primeDivisor_eq_divisorialValuation (hvar : Mori.IsNormalVariety k sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    (w : Valuation X.functionField (WithZero (Multiplicative ℤ)))
    (hk : ∀ c : k, c ≠ 0 → w ((((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial).hom) c) = 1)
    (h1 : ∃ g, w g = WithZero.exp (-1)) :
    ∃ Q : Mori.PrimeDivisor X, w = Q.divisorialValuation := by
  classical
  set ψ := (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial
  let R := w.valuationSubring
  let ιk : k →+* R := ψ.hom.codRestrict R fun c => by
    by_cases hc : c = 0
    · rw [hc, map_zero]; exact R.zero_mem
    · exact (w.mem_valuationSubring_iff _).2 (hk c hc).le
  have hιk : (algebraMap R X.functionField).comp ιk = ψ.hom := rfl
  have hsq : X.fromSpecStalk (genericPoint X) ≫ sX =
      Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫
        Spec.map (CommRingCat.ofHom ιk) := by
    rw [fromSpecStalk_comp_eq_specMap, ← Spec.map_comp]
    congr 1
  let S : ValuativeCommSq sX :=
    { R := R
      K := X.functionField
      i₁ := X.fromSpecStalk (genericPoint X)
      i₂ := Spec.map (CommRingCat.ofHom ιk)
      commSq := ⟨hsq⟩ }
  have hex : ValuativeCriterion.Existence sX := by
    have h : @IsProper _ _ sX := hprop
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  change Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫ l =
    X.fromSpecStalk (genericPoint X) at hl₁
  set x := l (IsLocalRing.closedPoint R)
  set φ := Scheme.stalkClosedPointTo l
  have hgen : genericPoint X ⤳ x := (genericPoint_spec X).specializes trivial
  have hext : φ ≫ CommRingCat.ofHom (algebraMap R X.functionField) =
      X.presheaf.stalkSpecializes hgen := by
    apply Spec.map_injective
    rw [← cancel_mono (X.fromSpecStalk x), Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
      Spec.map_comp, Category.assoc]
    change _ ≫ Spec.map (Scheme.stalkClosedPointTo l) ≫ X.fromSpecStalk _ = _
    rw [Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
    exact hl₁
  have hcompat : ∀ a : X.presheaf.stalk x,
      algebraMap R X.functionField (φ.hom a) = algebraMap (X.presheaf.stalk x) X.functionField a :=
    fun a => congrArg (fun f => f.hom a) hext
  have hle : ∀ a : X.presheaf.stalk x, w (algebraMap _ X.functionField a) ≤ 1 := fun a => by
    rw [← hcompat]; exact (w.mem_valuationSubring_iff _).1 (φ.hom a).2
  have hlt : ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x),
      w (algebraMap _ X.functionField a) < 1 := by
    intro a ha
    rw [← hcompat]
    have hnu : ¬ IsUnit (φ.hom a) := fun hu =>
      (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit φ.hom a hu)
    set r := φ.hom a
    have hr1 : w (r : X.functionField) ≤ 1 := (w.mem_valuationSubring_iff _).1 r.2
    refine lt_of_le_of_ne hr1 fun heq => hnu ?_
    change w (r : X.functionField) = 1 at heq
    have hr0 : (r : X.functionField) ≠ 0 := fun h0 => by
      rw [h0, map_zero] at heq; exact zero_ne_one heq
    have hinv : (r : X.functionField)⁻¹ ∈ R := (w.mem_valuationSubring_iff _).2 (by
      rw [map_inv₀, heq, inv_one])
    exact isUnit_iff_exists_inv.mpr ⟨⟨_, hinv⟩, Subtype.ext
      (show (r : X.functionField) * (r : X.functionField)⁻¹ = 1 from mul_inv_cancel₀ hr0)⟩
  have hx : x ≠ genericPoint X := by
    intro hxη
    obtain ⟨g, hg⟩ := h1
    have hg0 : g ≠ 0 := fun h0 => by rw [h0, map_zero] at hg; exact WithZero.zero_ne_coe hg
    obtain ⟨a, ha⟩ := MMP.Positivity.DivisorOver.algebraMap_stalk_surjective_of_eq_genericPoint
      x hxη g⁻¹
    have := hle a
    rw [ha, map_inv₀, hg, ← WithZero.exp_neg, neg_neg] at this
    exact absurd this (by decide)
  have hle' : ∀ (y : X) (_ : y = x) (a : X.presheaf.stalk y),
      w (algebraMap _ X.functionField a) ≤ 1 := by
    intro y hy; subst hy; exact hle
  have hlt' : ∀ (y : X) (_ : y = x), ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y),
      w (algebraMap _ X.functionField a) < 1 := by
    intro y hy; subst hy; exact hlt
  obtain ⟨Q, hQ⟩ := exists_primeDivisor_of_ne_genericPoint hdim hx
  refine ⟨Q, ?_⟩
  haveI := Q.isDiscreteValuationRing_localRing
  have hQx : Q.genericPoint = x := hQ
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible Q.localRing
  refine MMP.Positivity.DivisorOver.valuation_eq_of_isDiscreteValuationRing (R := Q.localRing)
    (fun r => ?_) (fun r hr => ?_) h1 (fun r => ?_) (fun r hr => ?_)
    ⟨_, Q.divisorialValuation_algebraMap_of_irreducible hϖ⟩
  · exact hle' _ hQx r
  · exact hlt' _ hQx r hr
  · rw [MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]; exact ⟨r, rfl⟩
  · exact (Q.divisorialValuation_algebraMap_lt_one_iff r).2 hr

/-- **Pull-back of the basis differential.** For a `k`-automorphism `σ` of the function field,
`σ^* b = h_σ b` with `h_σ ≠ 0`; then `D (σ g) = h_σ σ (D g)`, and the pluriform pull-back
multiplies coordinates along `b^{⊗m}` by `h_σ^m` after applying `σ`. -/
private theorem exists_pullback_formBasis (hvar : Mori.IsNormalVariety k sX)
    (hdim : topologicalKrullDim X = 1) (σ : FunctionFieldEquiv sX sX) :
    letI := functionFieldAlgebra sX
    ∃ h : X.functionField, h ≠ 0 ∧
      (∀ g, formDer hvar hdim (σ g) = h * σ (formDer hvar hdim g)) ∧
      ∀ (m : ℕ) (τ : RationalPluriForms sX 1 m),
        (ZTensorPower.basis (formBasis hvar hdim) m).repr
          (pluriformPullback sX sX σ.toHom 1 m τ) () =
          σ ((ZTensorPower.basis (formBasis hvar hdim) m).repr τ ()) * h ^ m := by
  letI := functionFieldAlgebra sX
  haveI : LocallyOfFiniteType sX := hvar.1.toLocallyOfFiniteType
  set b := formBasis hvar hdim
  set D := formDer hvar hdim
  have hb0 : b () ≠ 0 := b.ne_zero ()
  have hspan : Submodule.span X.functionField {b ()} = ⊤ := by
    rw [eq_top_iff]; intro y _
    rw [Submodule.mem_span_singleton]
    exact ⟨_, MMP.Mori.basis_unit_repr_smul b y⟩
  have hω := isPullbackGenerator_functionFieldHom (sX := sX) (sX' := sX) hdim hdim σ.toHom
    hspan hb0
  set b'' := basisOfSpanSingleton hω.2.1 hω.2.2
  set h := b.repr (b'' ()) ()
  have hb'' : b'' () = h • b () := (MMP.Mori.basis_unit_repr_smul b _).symm
  have hh0 : h ≠ 0 := fun h0 => (b''.ne_zero ()) (by rw [hb'', h0, zero_smul])
  have hpb := fun (a : ℕ) (ρ : RationalPluriForms sX 1 a) =>
    pluriformPullback_eq_repr_smul_formPow σ.toHom b hω b'' (basisOfSpanSingleton_apply _ _ _) a ρ
  have hformPow1 : ∀ c : X.functionField, c ≠ 0 →
      formPow (c • b ()) 1 ≠ (0 : RationalPluriForms sX 1 1) := fun c hc => by
    rw [formPow_smul]
    refine smul_ne_zero (pow_ne_zero _ hc) ?_
    rw [← ZTensorPower.basis_natCast]
    exact (ZTensorPower.basis b ((1 : ℕ) : ℤ)).ne_zero ()
  have hgen : ∀ g, D g ≠ 0 → D (σ g) = h * σ (D g) := by
    intro g hg
    have hdg : exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField g) = D g • b () :=
      (formDer_apply hvar hdim g).symm
    have hspan' : Submodule.span X.functionField
        {exteriorPower.ιMulti X.functionField 1
          (fun _ => KaehlerDifferential.D k X.functionField g)} = ⊤ := by
      rw [hdg, eq_top_iff]; intro y _
      rw [Submodule.mem_span_singleton]
      exact ⟨b.repr y () * (D g)⁻¹, by
        rw [smul_smul, mul_assoc, inv_mul_cancel₀ hg, mul_one]
        exact MMP.Mori.basis_unit_repr_smul b y⟩
    have hne : exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField g) ≠ 0 := by
      rw [hdg]; exact smul_ne_zero hg hb0
    have hω' := isPullbackGenerator_functionFieldHom (sX := sX) (sX' := sX) hdim hdim σ.toHom
      hspan' hne
    have e1 := pluriformPullback_smul_formPow σ.toHom hω' 1 1
    simp only [topFormsMap_ιMulti, KaehlerDifferential.map_D, one_smul, map_one] at e1
    have e2 := hpb 1 (formPow (exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField g)) 1)
    rw [e1, hb'', formPow_smul, smul_smul] at e2
    have e3 : (ZTensorPower.basis b ((1 : ℕ) : ℤ)).repr (formPow (exteriorPower.ιMulti
        X.functionField 1 (fun _ => KaehlerDifferential.D k X.functionField g)) 1) () = D g := by
      rw [hdg, formPow_smul, ← ZTensorPower.basis_natCast, LinearEquiv.map_smul,
        Finsupp.smul_apply, Module.Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul,
        mul_one, pow_one]
    rw [e3] at e2
    have e4 : exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField (σ g)) = D (σ g) • b () :=
      (formDer_apply hvar hdim (σ g)).symm
    change formPow (exteriorPower.ιMulti X.functionField 1
        (fun _ => KaehlerDifferential.D k X.functionField (σ g))) 1 =
      (σ (D g) * h ^ 1) • formPow (b ()) 1 at e2
    rw [e4, formPow_smul] at e2
    have hne1 : formPow (b ()) 1 ≠ (0 : RationalPluriForms sX 1 1) := by
      have := hformPow1 1 one_ne_zero; rwa [one_smul] at this
    have := smul_left_injective X.functionField hne1 e2
    simp only [pow_one] at this
    rw [this, mul_comm]
  obtain ⟨t₀, ht₀⟩ : ∃ t₀, D t₀ ≠ 0 := by
    obtain ⟨P⟩ := MMP.Positivity.nonempty_primeDivisor_of_topologicalKrullDim_eq hdim one_ne_zero
    obtain ⟨t, -, hD, -⟩ := exists_formDer_loc hvar hdim P
    exact ⟨t, hD⟩
  refine ⟨h, hh0, fun g => ?_, fun a ρ => ?_⟩
  · by_cases hg : D g = 0
    · have h1 : D (g + t₀) ≠ 0 := by rw [map_add, hg, zero_add]; exact ht₀
      have e1 := hgen _ h1
      have e2 := hgen _ ht₀
      rw [map_add, map_add, map_add, e2, hg, zero_add] at e1
      rw [hg, map_zero, mul_zero]
      linear_combination e1
    · exact hgen g hg
  · rw [hpb a ρ, hb'', formPow_smul, smul_smul]
    change (ZTensorPower.basis b a).repr ((σ ((ZTensorPower.basis b a).repr ρ ()) * h ^ a) •
      formPow (b ()) a) () = _
    rw [← ZTensorPower.basis_natCast, LinearEquiv.map_smul, Finsupp.smul_apply,
      Module.Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one]

open CurveAlg in
/-- Multiplication by `f` identifies `L(D)` with `L(D - div f)`. -/
private theorem finrank_lin_sub_div {K' Pt : Type*} [Field K'] [Algebra k K']
    (C : ProperCurveFF k K' Pt) (D : Pt →₀ ℤ) {f : K'} (hf : f ≠ 0) :
    Module.finrank k (C.lin (D - C.div f hf)) = Module.finrank k (C.lin D) := by
  have hmem : ∀ g ∈ C.lin D, g * f ∈ C.lin (D - C.div f hf) := fun g hg => by
    rcases hg with hg | hg
    · left; rw [hg, zero_mul]
    by_cases hg0 : g = 0
    · left; rw [hg0, zero_mul]
    right; intro P
    have := hg P
    rw [C.ord_mul P _ _ hg0 hf]
    simp only [Finsupp.sub_apply, ProperCurveFF.div_apply]
    omega
  let φ : C.lin D →ₗ[k] C.lin (D - C.div f hf) :=
    { toFun := fun g => ⟨g * f, hmem g g.2⟩
      map_add' := fun g h => Subtype.ext (add_mul _ _ _)
      map_smul' := fun c g => Subtype.ext (by simp [Algebra.smul_def, mul_assoc]) }
  have hbij : Function.Bijective φ := by
    constructor
    · intro g h hgh
      exact Subtype.ext (mul_right_cancel₀ hf (congrArg Subtype.val hgh))
    · intro g
      refine ⟨⟨g * f⁻¹, ?_⟩, Subtype.ext (by simp [φ, hf])⟩
      rcases g.2 with hg | hg
      · left; rw [hg, zero_mul]
      by_cases hg0 : (g : K') = 0
      · left; rw [hg0, zero_mul]
      right; intro P
      have := hg P
      rw [C.ord_mul P _ _ hg0 (inv_ne_zero hf), C.ord_inv P hf]
      simp only [Finsupp.sub_apply, ProperCurveFF.div_apply] at this
      omega
  exact ((LinearEquiv.ofBijective φ hbij).finrank_eq).symm

open CurveAlg in
/-- The function field of the curve as an abstract curve function field, with a basis `b` of the
rational differentials, the orders of the rational pluriforms read off along `b`, and the
pluriform pull-back along `b`. -/
private theorem exists_curveFFAut (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1) {K₀ : Divisor X}
    (hK : K₀.IsCanonicalDivisor sX 1) :
    letI := functionFieldAlgebra sX
    ∃ (C : CurveFFAut k X.functionField (Mori.PrimeDivisor X))
      (b : Module.Basis Unit X.functionField (⋀[X.functionField]^1 Ω[X.functionField⁄k])),
      (∀ P f, C.ord P f = X.ord f P.genericPoint) ∧
      (ProperCurveFF.deg C.canon = K₀.sum fun _ a => a) ∧
      (∀ (m : ℤ) (τ : RationalPluriForms sX 1 m) (P : Mori.PrimeDivisor X), τ ≠ 0 →
        P.ordForm τ = C.ord P ((ZTensorPower.basis b m).repr τ ()) + m * C.canon P) ∧
      (∀ (σ : FunctionFieldEquiv sX sX) (m : ℕ) (τ : RationalPluriForms sX 1 m),
        (ZTensorPower.basis b m).repr (pluriformPullback sX sX σ.toHom 1 m τ) () =
          σ ((ZTensorPower.basis b m).repr τ ()) * C.mult σ ^ m) := by
  classical
  letI := functionFieldAlgebra sX
  haveI : LocallyOfFiniteType sX := hvar.1.toLocallyOfFiniteType
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  set C₃ := curveFFRR hvar hsm hprop hdim hK
  set b := formBasis hvar hdim
  set κ : Divisor X := divisorOfForm (formBasisPow hvar hdim 1)
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hdim
  -- orders of forms along `b`
  have hform : ∀ (m : ℤ) (τ : RationalPluriForms sX 1 m) (P : Mori.PrimeDivisor X), τ ≠ 0 →
      P.ordForm τ = X.ord ((ZTensorPower.basis b m).repr τ ()) P.genericPoint + m * κ P := by
    intro m τ P hτ
    obtain ⟨N, hN⟩ := P.exists_ordForm_eq_ord_add_mul hd b
    have hN1 := hN 1 (formBasisPow hvar hdim 1) (by
      unfold formBasisPow; exact (ZTensorPower.basis b 1).ne_zero ())
    have hrepr1 : (ZTensorPower.basis b 1).repr (formBasisPow hvar hdim 1) () = 1 := by
      unfold formBasisPow
      change ((ZTensorPower.basis b 1).repr (ZTensorPower.basis b 1 ())) () = 1
      rw [Module.Basis.repr_self, Finsupp.single_eq_same]
    rw [hrepr1, Scheme.ord_one] at hN1
    have hκ : κ P = N := by
      change (divisorOfForm (formBasisPow hvar hdim 1)).coeff P = N
      rw [coeff_divisorOfForm, hN1]; simp
    rw [hN m τ hτ, hκ]
  -- the canonical divisor `κ = div b` has the degree of `K₀`
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hvar hK
  set c := (ZTensorPower.basis b 1).repr ω ()
  have hc0 : c ≠ 0 := MMP.Mori.repr_ne_zero_of_ne_zero b hω0
  have hK₀ : K₀ = C₃.div c hc0 + κ := by
    ext P
    have h1 := hform 1 ω P hω0
    rw [hω P] at h1
    change K₀.coeff P = X.ord c P.genericPoint + κ P
    rw [h1]; ring
  have hdegκ : ProperCurveFF.deg κ = K₀.sum fun _ a => a := by
    change _ = ProperCurveFF.deg K₀
    rw [hK₀, ProperCurveFF.deg_add, C₃.deg_div_eq_zero, zero_add]
  have hKs := MMP.Flips.sum_coeff_canonical_eq hvar hsm hprop hK
  let C₄ : CurveFFDer k X.functionField (Mori.PrimeDivisor X) :=
    { C₃ with
      canon := κ
      deg_canon := by
        rw [hdegκ]
        have : ((K₀.sum fun _ a => a : ℤ) : ℚ) = 2 * (K₀.h0 k sX : ℚ) - 2 := by
          rw [← hKs]; simp [Finsupp.sum]
        change _ = 2 * (K₀.h0 k sX : ℤ) - 2
        exact_mod_cast this
      der := formDer hvar hdim
      der_loc := fun P => by
        obtain ⟨t, ht, hD, hDt, hDO⟩ := exists_formDer_loc hvar hdim P
        refine ⟨t, ht, hD, ?_, hDO⟩
        change X.ord _ P.genericPoint = -(divisorOfForm (formBasisPow hvar hdim 1)).coeff P
        rw [coeff_divisorOfForm]; exact hDt }
  have hrrκ : (C₄.genus : ℤ) ≤ Module.finrank k (C₄.lin C₄.canon) := by
    change (K₀.h0 k sX : ℤ) ≤ Module.finrank k (C₃.lin κ)
    have h1 : κ = K₀ - C₃.div c hc0 := by rw [hK₀]; abel
    rw [h1, finrank_lin_sub_div C₃.toProperCurveFF K₀ hc0]
    exact_mod_cast (finrank_lin_eq_h0 hvar hsm hprop hdim K₀).ge
  have hperm : ∀ σ : X.functionField ≃ₐ[k] X.functionField, ∃ π : Mori.PrimeDivisor X →
      Mori.PrimeDivisor X, ∀ P (f : X.functionField),
        X.ord (σ f) P.genericPoint = X.ord f (π P).genericPoint := by
    intro σ
    have hc : ∀ P : Mori.PrimeDivisor X, ∃ Q : Mori.PrimeDivisor X, ∀ f : X.functionField,
        X.ord (σ f) P.genericPoint = X.ord f Q.genericPoint := by
      intro P
      let w := P.divisorialValuation.comap σ.toRingEquiv.toRingHom
      have hw : ∀ f, w f = P.divisorialValuation (σ f) := fun f => rfl
      obtain ⟨t, ht⟩ := C₃.exists_uniformizer P
      have ht0 : t ≠ 0 := C₃.ne_zero_of_ord_eq_one ht
      obtain ⟨Q, hQ⟩ := exists_primeDivisor_eq_divisorialValuation hvar hprop hdim w
        (fun c hc => by
          rw [hw]
          change P.divisorialValuation (σ (algebraMap k X.functionField c)) = 1
          rw [AlgEquiv.commutes]
          have h0 : algebraMap k X.functionField c ≠ 0 := by simpa using hc
          rw [P.divisorialValuation_eq_exp_neg_ord h0, ord_algebraMap_eq_zero P hc, neg_zero,
            WithZero.exp_zero])
        ⟨σ.symm t, by
          rw [hw, AlgEquiv.apply_symm_apply, P.divisorialValuation_eq_exp_neg_ord ht0]
          change WithZero.exp (-(C₃.ord P t)) = _
          rw [ht]⟩
      refine ⟨Q, fun f => ?_⟩
      by_cases hf : f = 0
      · simp [hf]
      have hσf : σ f ≠ 0 := by simpa using hf
      have := congrArg (fun v => v f) hQ
      simp only [hw] at this
      rw [P.divisorialValuation_eq_exp_neg_ord hσf, Q.divisorialValuation_eq_exp_neg_ord hf] at this
      have := WithZero.exp_injective this
      omega
    choose π hπ using hc
    exact ⟨π, hπ⟩
  let C : CurveFFAut k X.functionField (Mori.PrimeDivisor X) :=
    { C₄ with
      perm := hperm
      equiv := fun σ => by
        obtain ⟨h, hh0, he, -⟩ := exists_pullback_formBasis hvar hdim σ
        exact ⟨h, hh0, he⟩
      rr_canon := hrrκ }
  refine ⟨C, b, fun P f => rfl, hdegκ, hform, fun σ m τ => ?_⟩
  obtain ⟨h, hh0, he, hp⟩ := exists_pullback_formBasis hvar hdim σ
  rw [C.mult_unique he]
  exact hp m τ

/-- On a smooth curve, `K + B` is `ℚ`-Cartier for every `ℚ`-divisor `B`. -/
private theorem isQCartier_add_of_isSmoothScheme (hsm : IsSmoothScheme sX) (K₀ : Divisor X)
    (B : QDivisor X) : (Divisor.toQDivisor K₀ + B).IsQCartier := by
  classical
  obtain ⟨N, hN, hNB⟩ := exists_pos_nat_mul_eq_intCast (X := X) B
  let M : Divisor X := (N : ℤ) • K₀ + DivisorWithCoeffs.roundDown ((N : ℤ) • B)
  refine ⟨N, by exact_mod_cast hN.ne', M, ?_, MMP.Fourfold.isCartier_of_isSmoothScheme hsm M⟩
  ext P
  obtain ⟨z, hz⟩ := hNB P
  have h1 : (DivisorWithCoeffs.roundDown ((N : ℤ) • B)) P = z := by
    change (DivisorWithCoeffs.roundDown ((N : ℤ) • B)).coeff P = z
    rw [DivisorWithCoeffs.coeff_roundDown]
    change ⌊((N : ℤ) • B) P⌋ = z
    rw [Finsupp.smul_apply, zsmul_eq_mul]
    push_cast; rw [hz, Int.floor_intCast]
  change ((M P : ℤ) : ℚ) = ((N : ℤ) • (Divisor.toQDivisor K₀ + B)) P
  rw [Finsupp.smul_apply, Finsupp.add_apply]
  change _ = (N : ℤ) • ((K₀ P : ℚ) + B P)
  simp only [M, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, h1, zsmul_eq_mul]
  push_cast
  rw [mul_add, hz]

/-- The log discrepancy of a prime divisor `P` of the curve, on the identity model, is
`1 - coeff_P B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor (hvar : Mori.IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hprop : IsProper sX) {K₀ : Divisor X}
    (hK : K₀.IsCanonicalDivisor sX 1) (B : QDivisor X) (P : Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX 1 (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hvar P) (1 - (B.coeff P : ℝ)) := by
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hvar hK
  obtain ⟨m, hm, M, hM, hMc⟩ := (isQCartier_add_of_isSmoothScheme hsm K₀ B).exists_pos
  have hn := hK.topologicalKrullDim_eq
  obtain ⟨M', hM'⟩ := MMP.Threefold.Bridges.exists_isPullback_of_isDominant (𝟙 X) hMc
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hMΓ : ∀ Γ, (M.coeff Γ : ℝ) = m * (K₀.coeff Γ + B.coeff Γ) := by
    intro Γ
    have := congrArg (fun G : QDivisor X => G.coeff Γ) hM
    have h' : (M.coeff Γ : ℚ) = m * (K₀.coeff Γ + B.coeff Γ) := by
      simp at this
      linear_combination this
    exact_mod_cast h'
  have hM'P : M'.coeff P = M.coeff P :=
    MMP.Positivity.coeff_eq_of_isPullback (f := 𝟙 X) P P rfl hMc hM'
  have hord : (DivisorOver.ofPrimeDivisor k hvar P).ordPullback ω = P.ordForm ω :=
    DivisorOver.ordPullback_ofPrimeDivisor hvar hn P ω
  refine ⟨hvar, (inferInstance : IsProper (𝟙 X)), ω, hω0, ⟨K₀, hK, fun Γ => (hω Γ).symm⟩, 1,
    fun _ => 1 / (m : ℝ), fun _ => M, fun _ => M', fun _ => hMc, fun Γ => ?_,
    fun _ => ⟨_, hM'⟩, ?_⟩
  · rw [QDivisor.coeff_toRDivisor, Fin.sum_univ_one, hMΓ, hω Γ]
    field_simp
  · rw [Fin.sum_univ_one, hord]
    change 1 - (B.coeff P : ℝ) = 1 + (P.ordForm ω : ℝ) - 1 / (m : ℝ) * (M'.coeff P : ℝ)
    rw [hM'P, hMΓ, hω P]
    field_simp
    ring

/-- **Crepant self-maps of a curve preserve the boundary.** If a crepant birational self-map
`σ` of `(C, B)` carries the valuation of `P` to that of `Q`, then `B` has the same coefficient
at `P` and at `Q`. -/
private theorem coeff_eq_of_mem_crepantBirationalAutomorphisms (hvar : Mori.IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    {K₀ : Divisor X} (hK : K₀.IsCanonicalDivisor sX 1) {B : QDivisor X}
    {σ : FunctionFieldEquiv sX sX} (hσ : σ ∈ crepantBirationalAutomorphisms sX B)
    {P Q : Mori.PrimeDivisor X}
    (hPQ : ∀ f, X.ord (σ f) P.genericPoint = X.ord f Q.genericPoint) :
    B.coeff Q = B.coeff P := by
  letI := functionFieldAlgebra sX
  have hval : ∀ R : Mori.PrimeDivisor X,
      (DivisorOver.ofPrimeDivisor k hvar R).valuation = R.divisorialValuation := fun R => by
    ext g
    change R.divisorialValuation (functionFieldMap (𝟙 X) g) = _
    rw [MMP.Mori.functionFieldMap_id_apply]
  have hP : HasLogDiscrepancy sX B (DivisorOver.ofPrimeDivisor k hvar P).valuation
      (1 - (B.coeff P : ℝ)) :=
    ⟨1, _, rfl, isLogDiscrepancy_ofPrimeDivisor hvar hsm hprop hK B P⟩
  have hcomap : ((DivisorOver.ofPrimeDivisor k hvar P).valuation.comap
      σ.toRingEquiv.toRingHom) = (DivisorOver.ofPrimeDivisor k hvar Q).valuation := by
    rw [hval, hval]
    ext g
    change P.divisorialValuation (σ g) = Q.divisorialValuation g
    by_cases hg : g = 0
    · simp [hg]
    have hσg : σ g ≠ 0 := by simpa using hg
    rw [P.divisorialValuation_eq_exp_neg_ord hσg, Q.divisorialValuation_eq_exp_neg_ord hg,
      hPQ g]
  have h1 := (hσ _ _).mp hP
  rw [hcomap] at h1
  obtain ⟨n, D, hD, hDa⟩ := h1
  have h2 := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hDa
    (isLogDiscrepancy_ofPrimeDivisor hvar hsm hprop hK B Q) hD
  have : (B.coeff P : ℝ) = B.coeff Q := by linarith
  exact_mod_cast this.symm

open CurveAlg in
private theorem finite_range_pluriformPullback_of_curve
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P ∧ B.coeff P ≤ 1)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 1)
    (hdeg : 0 ≤ (K.sum fun _ a => (a : ℚ)) + B.sum fun _ a => a)
    (m : ℕ) (hm : 0 < m) (hmB : ∀ P, ∃ z : ℤ, (m : ℚ) * B.coeff P = z) :
    (Set.range fun (σ : crepantBirationalAutomorphisms sX B)
        (s : logPluricanonicalSections sX 1 m B) =>
          pluriformPullback sX sX (σ : FunctionFieldEquiv sX sX).toHom 1 m
            (s : RationalPluriForms sX 1 m)).Finite := by
  classical
  letI := functionFieldAlgebra sX
  obtain ⟨C, b, hord, hdegc, hform, hpull⟩ := exists_curveFFAut hvar hsm hprop hdim hK
  set G : Set (FunctionFieldEquiv sX sX) := {σ | σ ∈ crepantBirationalAutomorphisms sX B}
  have hG : ∀ σ ∈ G, ∀ P, B (C.ptMap σ P) = B P := fun σ hσ P =>
    coeff_eq_of_mem_crepantBirationalAutomorphisms hvar hsm hprop hdim hK hσ (P := P)
      (Q := C.ptMap σ P) fun f => by rw [← hord, ← hord]; exact C.isPointMap_ptMap σ P f
  set Dv : Divisor X := (m : ℤ) • C.canon + DivisorWithCoeffs.roundDown ((m : ℤ) • B)
  have hDv : ∀ P, (Dv P : ℚ) = m * C.canon P + m * B P := fun P => by
    obtain ⟨z, hz⟩ := hmB P
    have h1 : (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) P = z := by
      change (DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff P = z
      rw [DivisorWithCoeffs.coeff_roundDown]
      change ⌊((m : ℤ) • B) P⌋ = z
      rw [Finsupp.smul_apply, zsmul_eq_mul]
      change ⌊((m : ℤ) : ℚ) * B.coeff P⌋ = z
      push_cast; rw [hz, Int.floor_intCast]
    simp only [Dv, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, h1]
    push_cast
    rw [← hz]; rfl
  have hB' : ∀ P, 0 ≤ B P ∧ B P ≤ 1 := hB
  have hdeg' : 0 ≤ (ProperCurveFF.deg C.canon : ℚ) + B.sum fun _ a => a := by
    rw [hdegc]; simpa [Finsupp.sum] using hdeg
  have hfin := C.finite_range_twisted hB' hdeg' hm hDv G hG
  -- transfer
  set β := ZTensorPower.basis b (m : ℤ)
  have hmem : ∀ s : logPluricanonicalSections sX 1 m B,
      β.repr (s : RationalPluriForms sX 1 m) () ∈ C.lin Dv := by
    intro s
    by_cases hs : (s : RationalPluriForms sX 1 m) = 0
    · left; rw [hs]
      change (β.repr (0 : ZTensorPower X.functionField
        (⋀[X.functionField]^1 Ω[X.functionField⁄k]) (m : ℤ))) () = 0
      simp
    right; intro P
    have hsP := ((mem_logPluricanonicalSections (sX := sX)).mp s.2).2 P
      ⟨P.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact ⟨subset_closure rfl, trivial⟩⟩ hs
    rw [hform (m : ℤ) _ P hs] at hsP
    simp only [Dv, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul]
    change 0 ≤ C.ord P (β.repr (s : RationalPluriForms sX 1 m) ()) +
      ((m : ℤ) * C.canon P + (DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff P)
    linarith
  let Ψ : (C.lin Dv → X.functionField) →
      (logPluricanonicalSections sX 1 m B → RationalPluriForms sX 1 m) :=
    fun T s => T ⟨_, hmem s⟩ • β ()
  refine (hfin.image Ψ).subset ?_
  rintro _ ⟨σ, rfl⟩
  refine ⟨_, ⟨σ, rfl⟩, funext fun s => ?_⟩
  simp only [Ψ]
  rw [← hpull σ m s]
  exact MMP.Mori.basis_unit_repr_smul β _

end Bridge

/-- **Finite pluriform representations for nef log curves.** Let `C` be a smooth connected
proper curve over an algebraically closed field `k` of characteristic zero, `B` a `ℚ`-divisor
with `0 ≤ B ≤ 1`, and `K` a canonical divisor with `deg(K + B) ≥ 0`. For every `m > 0` with
`m • B` integral, the pluriform pull-backs `MMP.Fourfold.pluriformPullback σ` by the crepant
birational self-maps `σ ∈ MMP.Fourfold.crepantBirationalAutomorphisms sX B` induce only finitely
many maps on `H⁰(C, m(K + B)) = MMP.Fourfold.logPluricanonicalSections sX 1 m B`. Moreover
`K + B` is semiample (`MMP.Fourfold.QDivisor.IsRelativelySemiample`). -/
@[mmp "thm_mmp_curve_nef_pluriform_representation_finite"]
public theorem finite_range_pluriformPullback_and_isRelativelySemiample_of_curve
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hvar : Mori.IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hprop : IsProper sX) (hdim : topologicalKrullDim X = 1)
    {B : QDivisor X} (hB : ∀ P, 0 ≤ B.coeff P ∧ B.coeff P ≤ 1)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 1)
    (hdeg : 0 ≤ (K.sum fun _ a => (a : ℚ)) + B.sum fun _ a => a) :
    (∀ m : ℕ, 0 < m → (∀ P, ∃ z : ℤ, (m : ℚ) * B.coeff P = z) →
      (Set.range fun (σ : crepantBirationalAutomorphisms sX B)
        (s : logPluricanonicalSections sX 1 m B) =>
          pluriformPullback sX sX (σ : FunctionFieldEquiv sX sX).toHom 1 m
            (s : RationalPluriForms sX 1 m)).Finite) ∧
      QDivisor.IsRelativelySemiample sX (Divisor.toQDivisor K + B) :=
  ⟨finite_range_pluriformPullback_of_curve hvar hsm hprop hdim hB hK hdeg,
    isRelativelySemiample_of_curve hvar hsm hprop hdim hB hK hdeg⟩

end MMP.Fourfold
