/-- **The lifting on one component with nonempty floor.** The statement of
`exists_liftsPow_of_component` for a component `X_i` with at least one floor divisor. -/
private theorem exists_liftsPow_of_component_of_nonempty (i : I)
    (hfl : Nonempty {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) :
    ∃ k : ℕ, 0 < k ∧ ∀ m : ℕ, k ∣ m →
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
      ∀ {A : Type*} [Finite A]
        (t : A → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
        (∀ α, t α ∈ admissibleSections Rf) →
        (∀ P (y : Sf ⟨i, P⟩), ∃ α, ∃ V : (Sf ⟨i, P⟩).Opens, y ∈ V ∧
          GeneratesOn (BSf ⟨i, P⟩) m V
            ((t α ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
              RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m)) →
        ∃ a : ℕ, 0 < a ∧
          (∀ α, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            LiftsPow sX B jf BSf i m a (a * m) σ (t α)) ∧
          ∀ x : X i, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            ∃ V : (X i).Opens, x ∈ V ∧ GeneratesOn (B i) (a * m) V σ ∧
              (LiftsPow sX B jf BSf i m a (a * m) σ 0 ∨
                ∃ α, LiftsPow sX B jf BSf i m a (a * m) σ (t α)) := by
  haveI : CompactSpace (X i) := by
    haveI := (hX i).toIsVariety
    exact QuasiCompact.compactSpace_of_compactSpace (sX i)
  obtain ⟨R, _, _, _, _, sR, hRn, hRp, f, hf, hfp, hfO, k, hk, H, hH, hHamp, M, hM, hMeq⟩ :=
    exists_semiampleContraction hX hdim hK hsemi i
  have hS0 : (B i).roundDown ≠ 0 := by
    obtain ⟨P, hP⟩ := hfl
    intro h0
    apply hP
    have := congrArg (fun D : Divisor (X i) => D.coeff P) h0
    simpa using this
  by_cases himg : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ
  · exact exists_liftsPow_of_image_eq_univ hX hdim hQ hB hdlt hK hsemi hSf i hRn hRp f hf hfp hfO
      hk hH hHamp hM hMeq hS0 himg
  · obtain ⟨S, ιS, _, _, hS, V, ιV, _, _, hV, fS, hfS, hfSO⟩ :=
      exists_isIso_app_floor_of_ne_univ hX hdim hQ hB hdlt hK i hRn hRp f hf hfp hfO hk hH hHamp
        hM hMeq himg
    exact exists_liftsPow_of_isIso_app_floor hX hdim hQ hB hdlt hK hsemi hSf i hRn hRp f hf hfp
      hfO hk hH hHamp hM hMeq hS0 ιS hS ιV hV fS hfS hfSO

