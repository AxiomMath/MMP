private theorem exists_liftsPow_of_image_eq_univ (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    (heq : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ) :
    ∃ k : ℕ, 0 < k ∧ ∀ m : ℕ, k ∣ m →
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
      ∀ {A : Type*} [Finite A]
