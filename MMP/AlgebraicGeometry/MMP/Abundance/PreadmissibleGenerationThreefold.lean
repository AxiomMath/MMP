        (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) (hq _) u < 0 := by
    intro u hu hu0
    rw [hR₀] at hu
    obtain ⟨c, hc, rfl⟩ := hu
    have hc0 : 0 < c := lt_of_le_of_ne hc (fun h => hu0 (by rw [← h, zero_smul]))
    rw [map_smul, smul_eq_mul, MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
    exact mul_neg_of_pos_of_neg hc0 (by exact_mod_cast hDneg C₀ hC₀)
  have hR : IsNegativeExtremalRayOf (modelStr (sX i) P.sY P.n.toNat)
      (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT))
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') :=
    ⟨hq _, hray, hcf⟩
