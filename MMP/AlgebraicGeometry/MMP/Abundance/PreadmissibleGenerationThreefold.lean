      (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • Divisor.toQDivisor (DivisorWithCoeffs.roundDown BB)))
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') := by
    rw [hfl]; exact hR
