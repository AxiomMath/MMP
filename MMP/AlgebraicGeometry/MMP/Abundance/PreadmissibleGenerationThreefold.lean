      Set (NumericalCurveClasses (modelStr (sX i) P.sY P.n.toNat)))
      (MMP.Fourfold.QDivisor.curveForm (modelStr (sX i) P.sY P.n.toNat)
        (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) hkltM.1.2.2)
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') :=
    ⟨hray.1, hray.1.2.2.1, fun u hu hu0 => hcf u hu hu0⟩
  have hne : OneCycle.numericalClass (modelStr (sX i) P.sY P.n.toNat) (C₀.cycle ℝ) ≠ 0 := by
    intro h0
