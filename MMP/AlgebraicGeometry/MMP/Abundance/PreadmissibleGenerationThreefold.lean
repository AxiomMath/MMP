  have hkltM : MMP.Mori.IsKltPair (modelStr (sX i) P.sY P.n.toNat) 3 KK (BB - (1 / 2 : ℚ) • TT) :=
    (isKltPair_iff_mori_isKltPair _ hKK hΓklt.1).1 hΓklt
  have hΓeff : (BB - (1 / 2 : ℚ) • TT).IsEffective := hΓklt.1.nonneg
