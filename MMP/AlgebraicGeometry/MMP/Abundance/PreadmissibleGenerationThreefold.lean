  obtain ⟨m, hm, hmD⟩ :=
    (isQCartier_of_isQFactorial (sX i) (hQ i) (Divisor.toQDivisor (K i) + B i)).exists_pos
  have h0 := floorInv_zero (g := f) (t₀ := 1 / 2) (hQ i) (hK i) (hdlt i) hmD hD hD'
