/-- A flag of positive length of `X i` reaching a stratum of dimension `e` is matched by a flag of
a floor of `X i`, reaching a stratum of dimension `e`, with a crepant identification carrying
iterated residues. -/
private theorem memPreadm_exists_flagMatch {m N : ℕ}
    (Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m) (R : ResidueRestriction sX B 3 N)
    (i : I) {S : Scheme.{0}} {ι : S ⟶ X i} {BS : QDivisor S}
    (F : StratumAdjunctionData (sX i) (B i) ι BS) (h₁ : 1 ≤ F.length) (e : ℕ)
    (hdS : topologicalKrullDim S = e) [IsIntegral S] [IsNormal S] [IsLocallyNoetherian S] :
    ∃ (P : {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) (S₁ : Scheme.{0})
      (ι₁ : S₁ ⟶ Sf ⟨i, P⟩) (BS₁ : QDivisor S₁)
      (F₁ : StratumAdjunctionData (jf ⟨i, P⟩ ≫ sX i) (BSf ⟨i, P⟩) ι₁ BS₁),
      topologicalKrullDim S₁ = e ∧
      haveI := F₁.isIntegral_stratum
      haveI := F₁.isNormal_stratum
      haveI := F₁.isLocallyNoetherian_stratum
      ∃ σψ : FunctionFieldEquiv (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i),
        IsCrepantBirationalMap (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) BS BS₁ σψ ∧
        ∀ (N' : ℕ) (ζ : RationalPluriForms (sX i) (2 + 1) N')
          (ρQ : RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 N'),
          IsPoincareResidue (sX i) (jf ⟨i, P⟩) 2 N' ζ ρQ → ∀ (e' : ℕ),
          topologicalKrullDim S = e' →
          ∀ ρ' : RationalPluriForms (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) e' N',
            IsIteratedResidueRec ρQ F₁ e' ρ' →
            IsIteratedResidueRec ζ F e'
              (pluriformPullback (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) σψ.toHom e' N' ρ') := by
  have hXi : Mori.IsProjectiveVariety ℂ (sX i) := R.setting.isProjectiveVariety i
  haveI : CompactSpace (X i) := by
    haveI := hXi.toIsVariety
    exact QuasiCompact.compactSpace_of_compactSpace (sX i)
  refine (exists_flagMatch (X := X i) (sX := sX i) (n := 2) (B := B i)
    (C := fun P => Sf ⟨i, P⟩) (j := fun P => jf ⟨i, P⟩) (BC := fun P => BSf ⟨i, P⟩) (m := m)
    hXi (memPreadm_topologicalKrullDim hdim i) (fun P => hSf ⟨i, P⟩)
    (memPreadm_isStratifiedSectionSetting Rf i)
    (fun F => memPreadm_exists_isQCartier R i F) F h₁).elim
    fun P h => h.elim fun S₁ h => h.elim fun ι₁ h => h.elim fun BS₁ h => h.elim fun F₁ h =>
      h.elim fun _ h => ⟨P, S₁, ι₁, BS₁, F₁,
        memPreadm_topologicalKrullDim_eq hdim Rf e i P F₁ F h.1 hdS, ?_⟩
  obtain ⟨-, -, -, σψ, -, hσψc, hres⟩ := h
  exact ⟨σψ, hσψc, hres⟩

/-- The two residue restrictions of a lift of the `c`-th power of an admissible floor system to
matched strata correspond under a crepant birational map. -/
private theorem memPreadm_pullback_eq {m c : ℕ}
    (Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m)
    {u : ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)}
    (hu : u ∈ admissibleSections Rf) (R : ResidueRestriction sX B 3 (c * m))
    (s : ∀ i, logPluricanonicalSections (sX i) 3 (c * m) (B i))
    (hs : ∀ i, LiftsPow sX B jf BSf i m c (c * m)
      (s i : RationalPluriForms (sX i) 3 ((c * m : ℕ) : ℤ)) u) (hc0 : 0 < c)
    {i i' : I} {S S' : Scheme.{0}} {ι : S ⟶ X i} {ι' : S' ⟶ X i'}
    {BS : QDivisor S} {BS' : QDivisor S'} (F : StratumAdjunctionData (sX i) (B i) ι BS)
    (F' : StratumAdjunctionData (sX i') (B i') ι' BS') (e : ℕ)
    (hdS : topologicalKrullDim S = e) (hdS' : topologicalKrullDim S' = e)
    [IsIntegral S] [IsNormal S] [IsLocallyNoetherian S]
    [IsIntegral S'] [IsNormal S'] [IsLocallyNoetherian S']
    {P : {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}} {S₁ : Scheme.{0}}
    {ι₁ : S₁ ⟶ Sf ⟨i, P⟩} {BS₁ : QDivisor S₁}
    (F₁ : StratumAdjunctionData (jf ⟨i, P⟩ ≫ sX i) (BSf ⟨i, P⟩) ι₁ BS₁)
    (hdS₁ : topologicalKrullDim S₁ = e)
    [IsIntegral S₁] [IsNormal S₁] [IsLocallyNoetherian S₁]
    {P' : {P : Mori.PrimeDivisor (X i') // ⌊(B i').coeff P⌋ ≠ 0}} {S₂ : Scheme.{0}}
    {ι₂ : S₂ ⟶ Sf ⟨i', P'⟩} {BS₂ : QDivisor S₂}
    (F₂ : StratumAdjunctionData (jf ⟨i', P'⟩ ≫ sX i') (BSf ⟨i', P'⟩) ι₂ BS₂)
    (hdS₂ : topologicalKrullDim S₂ = e)
    [IsIntegral S₂] [IsNormal S₂] [IsLocallyNoetherian S₂]
    (σψ : FunctionFieldEquiv (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i))
    (hσψc : IsCrepantBirationalMap (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) BS BS₁ σψ)
    (hres : ∀ (N' : ℕ) (ζ : RationalPluriForms (sX i) (2 + 1) N')
      (ρQ : RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 N'),
      IsPoincareResidue (sX i) (jf ⟨i, P⟩) 2 N' ζ ρQ → ∀ (e' : ℕ),
      topologicalKrullDim S = e' →
      ∀ ρ' : RationalPluriForms (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) e' N',
        IsIteratedResidueRec ρQ F₁ e' ρ' →
        IsIteratedResidueRec ζ F e'
          (pluriformPullback (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) σψ.toHom e' N' ρ'))
    (σψ' : FunctionFieldEquiv (ι' ≫ sX i') (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i'))
    (hσψc' : IsCrepantBirationalMap (ι' ≫ sX i') (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') BS' BS₂ σψ')
    (hres' : ∀ (N' : ℕ) (ζ : RationalPluriForms (sX i') (2 + 1) N')
      (ρQ : RationalPluriForms (jf ⟨i', P'⟩ ≫ sX i') 2 N'),
      IsPoincareResidue (sX i') (jf ⟨i', P'⟩) 2 N' ζ ρQ → ∀ (e' : ℕ),
      topologicalKrullDim S' = e' →
      ∀ ρ' : RationalPluriForms (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') e' N',
        IsIteratedResidueRec ρQ F₂ e' ρ' →
        IsIteratedResidueRec ζ F' e'
          (pluriformPullback (ι' ≫ sX i') (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') σψ'.toHom e' N' ρ'))
    (σ : FunctionFieldEquiv (ι ≫ sX i) (ι' ≫ sX i'))
    (hσ : IsCrepantBirationalMap (ι ≫ sX i) (ι' ≫ sX i') BS BS' σ) :
    pluriformPullback (ι ≫ sX i) (ι' ≫ sX i') σ.toHom e ((c * m : ℕ) : ℤ)
      (R.toFun i' F' e (s i')) = R.toFun i F e (s i) := by
  haveI : LocallyOfFiniteType (ι ≫ sX i) := F.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι' ≫ sX i') := F'.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) :=
    F₁.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') :=
    F₂.isNormalVariety.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i)
  letI := functionFieldAlgebra (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i')
  refine (exists_basis_topForms (sX := ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) hdS₁).elim fun b₁ => ?_
  refine (exists_basis_topForms (sX := ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') hdS₂).elim fun b₂ => ?_
  obtain ⟨c₁, hc₁⟩ : ∃ c₁ : S₁.functionField, Rf.toFun ⟨i, P⟩ F₁ e (u ⟨i, P⟩) =
      c₁ • (formPow (b₁ ()) m : RationalPluriForms (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) e m) :=
    ⟨_, eq_repr_smul_formPow b₁ _⟩
  obtain ⟨c₂, hc₂⟩ : ∃ c₂ : S₂.functionField, Rf.toFun ⟨i', P'⟩ F₂ e (u ⟨i', P'⟩) =
      c₂ • (formPow (b₂ ()) m : RationalPluriForms (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') e m) :=
    ⟨_, eq_repr_smul_formPow b₂ _⟩
  have hr₁ := memPreadm_residue_eq Rf R s hs hc0 i P F₁ F e hdS₁ hdS σψ hres b₁ c₁ hc₁
  have hr₂ := memPreadm_residue_eq Rf R s hs hc0 i' P' F₂ F' e hdS₂ hdS' σψ' hres' b₂ c₂ hc₂
  -- the crepant map `σ̃ = σψ⁻¹ ∘ σ ∘ σψ'` between the matched strata
  letI := functionFieldAlgebra (ι ≫ sX i)
  letI := functionFieldAlgebra (ι' ≫ sX i')
  obtain ⟨σt, hσtdef⟩ : ∃ σt : FunctionFieldEquiv (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i)
      (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i'), σt = σψ'.trans (σ.trans σψ.symm) := ⟨_, rfl⟩
  have hσt : IsCrepantBirationalMap (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i')
      BS₁ BS₂ σt := by
    rw [hσtdef]
    exact (hσψc.symm.trans hσ).trans hσψc'
  have hadm := hu ⟨i, P⟩ ⟨i', P'⟩ F₁ F₂ e (Nat.zero_le _) (Nat.zero_le _) hdS₁ hdS₂ σt hσt
  beta_reduce at hadm
  rw [hc₁, hc₂, pluriformPullback_smul_formPow' hdS₁ hdS₂ σt.toHom (b₂ ()) m c₂] at hadm
  have hpw : (c₁ ^ c • (formPow (b₁ ()) (c * m) :
      RationalPluriForms (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) e ((c * m : ℕ) : ℤ))) =
      pluriformPullback (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') σt.toHom e
        ((c * m : ℕ) : ℤ)
        (c₂ ^ c • (formPow (b₂ ()) (c * m) :
          RationalPluriForms (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') e ((c * m : ℕ) : ℤ))) := by
    rw [pluriformPullback_smul_formPow' hdS₁ hdS₂ σt.toHom (b₂ ()) (c * m) (c₂ ^ c),
      map_pow (σt.toHom) c₂ c]
    exact (smul_formPow_pow_eq b₁ hadm c).symm
  have hh : (σ.toHom).comp (σψ'.toHom) = (σψ.toHom).comp (σt.toHom) := by
    ext x
    rw [hσtdef]
    change σ (σψ' x) = σψ (σψ.symm (σ (σψ' x)))
    rw [AlgEquiv.apply_symm_apply]
  have key : ∀ y : RationalPluriForms (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') e ((c * m : ℕ) : ℤ),
      pluriformPullback (ι ≫ sX i) (ι' ≫ sX i') σ.toHom e ((c * m : ℕ) : ℤ)
        (pluriformPullback (ι' ≫ sX i') (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') σψ'.toHom e
          ((c * m : ℕ) : ℤ) y) =
      pluriformPullback (ι ≫ sX i) (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) σψ.toHom e ((c * m : ℕ) : ℤ)
        (pluriformPullback (ι₁ ≫ jf ⟨i, P⟩ ≫ sX i) (ι₂ ≫ jf ⟨i', P'⟩ ≫ sX i') σt.toHom e
          ((c * m : ℕ) : ℤ) y) := by
    intro y
    rw [pluriformPullback_comp hdS hdS' hdS₂, pluriformPullback_comp hdS hdS₁ hdS₂, hh]
  rw [hr₁, hr₂, hpw]
  exact key _

include hdim hSf in
/-- **Lifts of an admissible floor system are preadmissible.** A system whose every component
lifts the `c`-th power of one admissible floor system is preadmissible. -/
private theorem mem_preadmissibleSections_of_liftsPow {m c : ℕ}
    (Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m)
    {u : ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)}
    (hu : u ∈ admissibleSections Rf) (R : ResidueRestriction sX B 3 (c * m))
    (s : ∀ i, logPluricanonicalSections (sX i) 3 (c * m) (B i))
    (hs : ∀ i, LiftsPow sX B jf BSf i m c (c * m) (s i : RationalPluriForms (sX i) 3 ((c * m : ℕ) : ℤ)) u) :
    s ∈ preadmissibleSections R := by
  have hc0 : 0 < c := Nat.pos_of_mul_pos_right R.setting.pos
  intro i i' S S' ι ι' BS BS' F F' e h₁ h₂ hdS hdS' σ hσ
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  haveI := F'.isIntegral_stratum
  haveI := F'.isNormal_stratum
  haveI := F'.isLocallyNoetherian_stratum
  refine (memPreadm_exists_flagMatch hdim hSf Rf R i F h₁ e hdS).elim
    fun P h => h.elim fun S₁ h => h.elim fun ι₁ h => h.elim fun BS₁ h => h.elim fun F₁ h => ?_
  refine (memPreadm_exists_flagMatch hdim hSf Rf R i' F' h₂ e hdS').elim
    fun P' h' => h'.elim fun S₂ h' => h'.elim fun ι₂ h' => h'.elim fun BS₂ h' =>
      h'.elim fun F₂ h' => ?_
  haveI := F₁.isIntegral_stratum
  haveI := F₁.isNormal_stratum
  haveI := F₁.isLocallyNoetherian_stratum
  haveI := F₂.isIntegral_stratum
  haveI := F₂.isNormal_stratum
  haveI := F₂.isLocallyNoetherian_stratum
  obtain ⟨hdS₁, σψ, hσψc, hres⟩ := h
  obtain ⟨hdS₂, σψ', hσψc', hres'⟩ := h'
  exact memPreadm_pullback_eq Rf hu R s hs hc0 F F' e hdS hdS' F₁ hdS₁ F₂ hdS₂
    σψ hσψc hres σψ' hσψc' hres' σ hσ

end Steps

private theorem solution
    {I : Type*} [Finite I] {X : I → Scheme.{0}} [∀ i, IsIntegral (X i)]
    [∀ i, IsLocallyNoetherian (X i)] [∀ i, IsNormal (X i)]
    {sX : ∀ i, X i ⟶ Spec (.of ℂ)} (hX : ∀ i, Mori.IsProjectiveVariety ℂ (sX i))
    (hdim : ∀ i, topologicalKrullDim (X i) = 3) (hQ : ∀ i, IsQFactorial (sX i))
    {B : ∀ i, QDivisor (X i)} (hB : ∀ i, IsPair (sX i) (B i))
    (hdlt : ∀ i, MMP.Intersection.IsDltPair (sX i) (B i)) {K : ∀ i, Divisor (X i)}
    (hK : ∀ i, (K i).IsCanonicalDivisor (sX i) 3)
    (hsemi : ∀ i, QDivisor.IsRelativelySemiample (sX i) (Divisor.toQDivisor (K i) + B i))
    (Sf : (Σ i, {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) → Scheme.{0})
    [∀ j, IsIntegral (Sf j)] [∀ j, IsLocallyNoetherian (Sf j)] [∀ j, IsNormal (Sf j)]
    (jf : ∀ j, Sf j ⟶ X j.1) (BSf : ∀ j, QDivisor (Sf j))
    (hSf : ∀ j, IsAdjunctionStep (sX j.1) (B j.1) (jf j) (BSf j) ∧
      Set.range (jf j).base = (j.2.1.support : Set (X j.1))) :
    ∃ m₀ : ℕ, 0 < m₀ ∧ ∀ m : ℕ, 0 < m → m₀ ∣ m →
      Nonempty (ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m) ∧
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
        (∀ j (y : Sf j), ∃ t ∈ admissibleSections Rf, ∃ V : (Sf j).Opens, y ∈ V ∧
          GeneratesOn (BSf j) m V
            ((t j : logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)) :
              RationalPluriForms (jf j ≫ sX j.1) 2 m)) →
        ∀ T : Finset (∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
          (∀ t ∈ T, t ∈ admissibleSections Rf) →
          ∃ q : ℕ, 0 < q ∧ Nonempty (ResidueRestriction sX B 3 (q * m)) ∧
            ∀ R : ResidueRestriction sX B 3 (q * m),
              (∀ (i : I) (x : X i), ∃ s ∈ preadmissibleSections R, ∃ V : (X i).Opens, x ∈ V ∧
                GeneratesOn (B i) (q * m) V
                  ((s i : logPluricanonicalSections (sX i) 3 (q * m) (B i)) :
                    RationalPluriForms (sX i) 3 ((q * m : ℕ) : ℤ))) ∧
              ∀ t ∈ T, ∃ s ∈ preadmissibleSections R, ∀ j,
                letI := functionFieldAlgebra (jf j ≫ sX j.1)
                ∀ (ω : ⋀[(Sf j).functionField]^2 Ω[(Sf j).functionField⁄ℂ])
                  (f : (Sf j).functionField),
                ((t j : logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)) :
                    RationalPluriForms (jf j ≫ sX j.1) 2 m) =
                    f • (formPow ω m : RationalPluriForms (jf j ≫ sX j.1) 2 m) →
                  IsPoincareResidue (sX j.1) (jf j) 2 (q * m)
                    ((s j.1 : logPluricanonicalSections (sX j.1) 3 (q * m) (B j.1)) :
                      RationalPluriForms (sX j.1) 3 ((q * m : ℕ) : ℤ))
                    (f ^ q • (formPow ω (q * m) :
                      RationalPluriForms (jf j ≫ sX j.1) 2 ((q * m : ℕ) : ℤ))) := by
  classical
  haveI := Fintype.ofFinite I
  choose k hk0 hk using fun i => exists_liftsPow_of_component hX hdim hQ hB hdlt hK hsemi hSf i
  haveI : Finite (Σ i, {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) := by
    haveI := fun i => finite_floor (B i)
    infer_instance
  have hfl := fun j : (Σ i, {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) =>
    floor_isProjectiveVariety_and_isDltPair (hX j.1) (hdim j.1) (hB j.1) (hdlt j.1) (hSf j).1
      j.2.1 (hSf j).2
  obtain ⟨cf, hcf0, hcf⟩ := exists_residueRestriction (fun j => (hfl j).1) (fun j => (hfl j).2.1)
    (fun j => (hfl j).2.2.1) (fun j => (hfl j).2.2.2)
  obtain ⟨cX, hcX0, hcX⟩ := exists_residueRestriction hX hdim hB hdlt
  refine ⟨2 * cf * cX * ∏ i, k i,
    Nat.mul_pos (Nat.mul_pos (Nat.mul_pos two_pos hcf0) hcX0) (Finset.prod_pos fun i _ => hk0 i),
    ?_⟩
  intro m hm0 hm₀
  have hm2 : 2 ∣ m := (Dvd.intro (cf * cX * ∏ i, k i) (by ring)).trans hm₀
  have hmcf : cf ∣ m := (Dvd.intro_left (2 * cX * ∏ i, k i) (by ring)).trans hm₀
  have hmcX : cX ∣ m := (Dvd.intro_left (2 * cf * ∏ i, k i) (by ring)).trans hm₀
  have hm : (∏ i, k i) ∣ m := (Dvd.intro_left (2 * cf * cX) rfl).trans hm₀
  refine ⟨hcf m hm0 hmcf (even_iff_two_dvd.2 hm2), fun Rf hgen T hT => ?_⟩
  obtain ⟨G, hGfin, tG, htGadm, htGgen⟩ := exists_finite_generating_family Rf hgen
  let t : Option (G ⊕ T) → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j) :=
    fun α => α.elim 0 (Sum.elim tG fun τ => τ.1)
  have htadm : ∀ α, t α ∈ admissibleSections Rf := by
    rintro (_ | α | ⟨τ, hτ⟩)
    exacts [zero_mem _, htGadm α, hT τ hτ]
  have hkm : ∀ i, k i ∣ m := fun i => (Finset.dvd_prod_of_mem k (Finset.mem_univ i)).trans hm
  have htgen : ∀ i P (y : Sf ⟨i, P⟩), ∃ α, ∃ V : (Sf ⟨i, P⟩).Opens, y ∈ V ∧
      GeneratesOn (BSf ⟨i, P⟩) m V
        ((t α ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
          RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m) := fun i P y => by
    obtain ⟨α, V, hy, hV⟩ := htGgen ⟨i, P⟩ y
    exact ⟨some (Sum.inl α), V, hy, hV⟩
  have hcomp := fun i => hk i m (hkm i) Rf t htadm (htgen i)
  choose a ha0 hlift hgenx using hcomp
  refine ⟨∏ i, a i, Finset.prod_pos fun i _ => ha0 i,
    hcX _ (Nat.mul_pos (Finset.prod_pos fun i _ => ha0 i) hm0) (hmcX.mul_left _)
      (even_iff_two_dvd.2 (hm2.mul_left _)), ?_⟩
  intro R
  have haq : ∀ i, a i ∣ ∏ i, a i := fun i => Finset.dvd_prod_of_mem a (Finset.mem_univ i)
  have hq0 : 0 < ∏ i, a i := Finset.prod_pos fun i _ => ha0 i
  have hL : ∀ α i, ∃ σ ∈ logPluricanonicalSections (sX i) 3 ((∏ i, a i) * m) (B i),
      LiftsPow sX B jf BSf i m (∏ i, a i) ((∏ i, a i) * m) σ (t α) := by
    intro α i
    obtain ⟨σ, hσ, hσl⟩ := hlift i α
    obtain ⟨σ', hσ', h1, -⟩ := exists_pow_of_dvd hX hdim hSf i (ha0 i) (haq i) hq0 hσ
    exact ⟨σ', hσ', h1 _ hσl⟩
  choose σL hσLmem hσL using hL
  refine ⟨?_, ?_⟩
  · intro i x
    obtain ⟨σ, hσ, V, hxV, hgV, hcase⟩ := hgenx i x
    obtain ⟨σ', hσ', h1, h2⟩ := exists_pow_of_dvd hX hdim hSf i (ha0 i) (haq i) hq0 hσ
    obtain ⟨α, hα⟩ : ∃ α, LiftsPow sX B jf BSf i m (a i) (a i * m) σ (t α) :=
      hcase.elim (fun hz => ⟨none, hz⟩) id
    · refine ⟨Function.update (fun i' => ⟨σL α i', hσLmem α i'⟩) i ⟨σ', hσ'⟩,
        mem_preadmissibleSections_of_liftsPow hdim hSf Rf (htadm α) R _ fun i' => ?_,
        V, hxV, ?_⟩
      · by_cases h : i' = i
        · subst h
          simpa using h1 _ hα
        · simpa [h] using hσL α i'
      · simpa using h2 V hgV
  · intro τ hτ
    refine ⟨fun i => ⟨σL (some (Sum.inr ⟨τ, hτ⟩)) i, hσLmem _ i⟩,
      mem_preadmissibleSections_of_liftsPow hdim hSf Rf (htadm _) R _ fun i => hσL _ i, ?_⟩
    intro j ω f h
    exact hσL (some (Sum.inr ⟨τ, hτ⟩)) j.1 j.2 ω f h

end Proof_thm_fourfold_semiample_dlt_preadmissible_generation

