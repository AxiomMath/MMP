    apply (ConcreteCategory.bijective_of_isIso (fS.app (ιV ⁻¹ᵁ U'))).1
    rw [map_zero]
    refine eq_zero_of_forall_germToFunctionField_eq_zero N _ fun i hi => ?_
    obtain ⟨z, hz⟩ := hi
    have hzz : (pp i).hom ((pp i).inv z) = z := by
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl
    have hgen0 : N.n i ((pp i).hom (genericPoint (C (π i)))) ∈ fS ⁻¹ᵁ (ιV ⁻¹ᵁ U') := by
      have hsp := ((genericPoint_spec (C (π i))).specializes (trivial : (pp i).inv z ∈ _)).map
        ((pp i).hom ≫ N.n i).continuous
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hzz] at hsp
      exact hsp.mem_open (fS ⁻¹ᵁ (ιV ⁻¹ᵁ U')).isOpen hz
    have hPV : gV (π i) (genericPoint (C (π i))) ∈ ιV ⁻¹ᵁ U' := by
      rw [hgVeq]; exact hgen0
    have h := hb (π i) hPV
    have hx' : ((pp i).hom ≫ N.n i ≫ fS) (genericPoint (C (π i))) ∈ ιV ⁻¹ᵁ U' := hgen0
    rw [stalkMap_germ_eq_of_eq (hgVeq i) (ιV ⁻¹ᵁ U') _ hPV hx',
      Scheme.Hom.germ_stalkMap_apply] at h
    haveI : Nonempty ((pp i).hom ⁻¹ᵁ (N.n i ⁻¹ᵁ (fS ⁻¹ᵁ (ιV ⁻¹ᵁ U')))) := ⟨⟨_, hgen0⟩⟩
    haveI : Nonempty (N.n i ⁻¹ᵁ (fS ⁻¹ᵁ (ιV ⁻¹ᵁ U'))) := ⟨⟨_, hgen0⟩⟩
    apply RingHom.injective (functionFieldMap (pp i).hom)
    rw [map_zero, MMP.Spreading.functionFieldMap_germToFunctionField (pp i).hom
      (N.n i ⁻¹ᵁ (fS ⁻¹ᵁ (ιV ⁻¹ᵁ U'))) _ le_rfl, Scheme.Hom.appLE_eq_app]
    exact h
  -- the glued section of `ι_V^* 𝒪_R(arH)`
  obtain ⟨σ, hσ⟩ := exists_section_glue_of_isPoincareResidue hX f hH ιV C j BC
    (fun P => (hC P).1) w gV hgV (t := t) (a := a) G hρex
    (fun U e he P hPV ρ hρ => (hG U e he P hPV ρ hρ).1) hinj
  refine ⟨σ, fun U e he P hP => ?_⟩
  have hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U := by
    show ιV (gV P (genericPoint (C P))) ∈ U
    rw [← Scheme.Hom.comp_apply, hgV P, Scheme.Hom.comp_apply]
    exact hP
  obtain ⟨ρ, hρ, -⟩ := hρex U e he P hP
  obtain ⟨htG, hunit⟩ := hG U e he P hPV ρ hρ
  letI := functionFieldAlgebra (j P ≫ sX)
  haveI : LocallyOfFiniteType (j P ≫ sX) :=
    (RS.setting.isPair P).isPair.isNormalVariety.1.toLocallyOfFiniteType
  obtain ⟨b⟩ := exists_basis_topForms (sX := j P ≫ sX) (d := n)
    (RS.setting.topologicalKrullDim_eq P)
  set c₁ := (ZTensorPower.basis b (k * r)).repr ρ () with hc₁
  have hρeq : ρ = c₁ • formPowR (j P ≫ sX) (b ()) (k * r) :=
    eq_repr_smul_formPow b ρ
  refine ⟨b (), c₁, ((gV P).stalkMap (genericPoint (C P))).hom
    (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV (G U e he)), G U e he ^ a, hPV, hρeq ▸ hρ, ?_, hσ U e he,
    by rw [map_pow, map_pow], fun y hy hyV => by rw [map_pow]; exact (hunit y hy hyV).pow a⟩
  rw [htG, hρeq]

/-- **The pull-back of an effective `ℚ`-Cartier `ℚ`-divisor is effective.** With `m` the Cartier
index of `A`, `m f^*A` is the pull-back of the effective Cartier divisor `mA`, whose local
equations are regular (algebraic Hartogs), so their pull-backs have nonnegative order. -/
private theorem nonneg_of_isPullback {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : Y ⟶ X} {A : QDivisor X} (hA : 0 ≤ A)
    (hAq : A.IsQCartier)
    {hB : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ A.supp}
    {B : QDivisor Y} (h : A.IsPullback f hB B) : 0 ≤ B := by
  have hm := QDivisor.cartierIndex_pos hAq
  obtain ⟨D₀, hD₀, hD₀c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hAq
  obtain ⟨D', hD', hp⟩ := h _ hm D₀ hD₀ hD₀c
  have hmq : (0 : ℚ) < (A.cartierIndex hAq : ℚ) := by exact_mod_cast hm
  have hD₀n : ∀ P : MMP.Mori.PrimeDivisor X, (P.support ∩ (⊤ : X.Opens)).Nonempty →
      0 ≤ D₀.coeff P := by
    intro P _
    have h2 : (D₀ P : ℚ) = A.cartierIndex hAq * A P :=
      (by simpa using congrArg (· P) hD₀ :
        Divisor.toQDivisor D₀ P = A.cartierIndex hAq * A P)
    exact_mod_cast h2 ▸ mul_nonneg hmq.le (hA P)
  intro E
  have hE : (E.support ∩ f ⁻¹ᵁ (⊤ : X.Opens)).Nonempty :=
    ⟨E.genericPoint, MMP.Flips.primeDivisor_genericPoint_mem_support E, trivial⟩
  have h0 := MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn hD₀c hD₀n hp E hE
  have h1 : (D' E : ℚ) = A.cartierIndex hAq * B E :=
    (by simpa using congrArg (· E) hD' :
      Divisor.toQDivisor D' E = A.cartierIndex hAq * B E)
  have h0' : (0 : ℚ) ≤ (D' E : ℚ) := by exact_mod_cast h0
  exact nonneg_of_mul_nonneg_right (h1 ▸ h0') hmq

/-- Pull-back of `ℚ`-Cartier `ℚ`-divisors is additive. -/
private theorem qDivisor_isPullback_add {X Y : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] [IsLocallyNoetherian Y] [IsNormal Y] {f : X ⟶ Y} {G₁ G₂ : QDivisor Y}
    (hG₁ : G₁.IsQCartier) (hG₂ : G₂.IsQCartier)
    {h₁ : ∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ G₁.supp}
    {h₂ : ∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ G₂.supp}
    {R₁ R₂ : QDivisor X} (p₁ : G₁.IsPullback f h₁ R₁) (p₂ : G₂.IsPullback f h₂ R₂)
    (h : ∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ (G₁ + G₂).supp) :
    (G₁ + G₂).IsPullback f h (R₁ + R₂) := by
  intro m hm D hD hDc
  have hm' : (m : ℤ) ≠ 0 := by exact_mod_cast hm.ne'
  obtain ⟨m₁, hm₁, A₁, hA₁, hA₁c⟩ := hG₁.exists_pos
  obtain ⟨m₂, hm₂, A₂, hA₂, hA₂c⟩ := hG₂.exists_pos
  have hm₁' : (m₁ : ℤ) ≠ 0 := by exact_mod_cast hm₁.ne'
  have hm₂' : (m₂ : ℤ) ≠ 0 := by exact_mod_cast hm₂.ne'
  obtain ⟨A₁', hA₁', p₁'⟩ := p₁ m₁ hm₁ A₁ hA₁ hA₁c
  obtain ⟨A₂', hA₂', p₂'⟩ := p₂ m₂ hm₂ A₂ hA₂ hA₂c
  have hsuppD : ∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ D.supp :=
    fun W hW => h W (by rwa [QDivisor.supp_eq_of_toQDivisor_eq hm' hD] at hW)
  -- the supports of the auxiliary divisors
  have hsupp : ∀ {G : QDivisor Y} (A : Divisor Y) (c : ℤ), c ≠ 0 →
      Divisor.toQDivisor A = c • G →
      (∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ G.supp) →
      ∀ W : irreducibleComponents X, f (componentGenericPoint X W) ∉ A.supp :=
    fun A c hc hA hG W hW => hG W (by rwa [QDivisor.supp_eq_of_toQDivisor_eq hc hA] at hW)
  set N : ℤ := (m₁ : ℤ) * m₂
  have hN : N ≠ 0 := mul_ne_zero hm₁' hm₂'
  set A : Divisor Y := (m : ℤ) • ((m₂ : ℤ) • A₁ + (m₁ : ℤ) • A₂)
  have hAD : A = N • D := by
    apply Divisor.toQDivisor_injective
    simp only [A, N, map_zsmul, map_add, hA₁, hA₂, hD, smul_add, smul_smul]
    congr 1 <;> congr 1 <;> ring
  have hAc : A.IsCartier := ((hA₁c.zsmul _).add (hA₂c.zsmul _)).zsmul _
  have hA₁N : Divisor.toQDivisor ((m₂ : ℤ) • A₁) = N • G₁ := by
    simp only [map_zsmul, hA₁, smul_smul, N]; congr 1; ring
  have hA₂N : Divisor.toQDivisor ((m₁ : ℤ) • A₂) = N • G₂ := by
    simp only [map_zsmul, hA₂, smul_smul, N]
  have hsum : Divisor.toQDivisor ((m₂ : ℤ) • A₁ + (m₁ : ℤ) • A₂) = N • (G₁ + G₂) := by
    rw [map_add, hA₁N, hA₂N, smul_add]
  have hAq : Divisor.toQDivisor A = ((m : ℤ) * N) • (G₁ + G₂) := by
    simp only [A, map_zsmul, hsum, smul_smul]
  have pA := ((p₁'.zsmul hA₁c (m₂ : ℤ) (hsupp _ _ hN hA₁N h₁)).add (hA₁c.zsmul _)
    (hA₂c.zsmul _) (hsupp _ _ hN hsum h) (p₂'.zsmul hA₂c (m₁ : ℤ) (hsupp _ _ hN hA₂N h₂))).zsmul
    ((hA₁c.zsmul _).add (hA₂c.zsmul _)) (m : ℤ)
    (hsupp _ _ (mul_ne_zero hm' hN) hAq h)
  obtain ⟨D', hD'⟩ := hDc.exists_isPullback hsuppD
  refine ⟨D', ?_, hD'⟩
  have pND := hD'.zsmul hDc N (hsupp _ _ (mul_ne_zero hN hm') (by
    rw [map_zsmul, hD, smul_smul]) h)
  have heq := pA.eq hAc (pND.of_eq hAD.symm)
  have heqQ := congrArg Divisor.toQDivisor heq
  simp only [map_zsmul, map_add, hA₁', hA₂', smul_smul] at heqQ
  ext E
  have := congrArg (fun G : QDivisor X => G.coeff E) heqQ
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, zsmul_eq_mul,
    Divisor.coeff_toQDivisor, N] at this ⊢
  have hNq : ((m₁ : ℚ) * m₂) ≠ 0 := by positivity
  apply mul_left_cancel₀ hNq
  push_cast at this ⊢
  linear_combination -this

/-- Integral multiples of `ℚ`-Cartier `ℚ`-divisors are `ℚ`-Cartier. -/
private theorem isQCartier_zsmul {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    {G : QDivisor X} (hG : G.IsQCartier) (c : ℤ) : (c • G).IsQCartier := by
  obtain ⟨m, hm, D, hD, hDc⟩ := hG
  refine ⟨m, hm, c • D, ?_, hDc.zsmul c⟩
  rw [map_zsmul, hD, smul_smul, smul_smul, mul_comm]

/-- A `ℚ`-divisor with coefficient zero along a prime divisor `P` is pulled back along a morphism
from an irreducible scheme whose generic point maps to the generic point of `P`. -/
private theorem forall_notMem_supp_of_coeff_eq_zero {T Y : Scheme.{0}} [IsIntegral T]
    (j : T ⟶ Y) {P : Mori.PrimeDivisor Y} (hP : j (genericPoint T) = P.genericPoint)
    {G : QDivisor Y} (hG : G.coeff P = 0) :
    ∀ W : irreducibleComponents T, j (componentGenericPoint T W) ∉ G.supp := by
  intro W
  rw [componentGenericPoint_eq_genericPoint, hP]
  exact genericPoint_notMem_supp_of_coeff_eq_zero hG

/-- The pull-back of `G' + cG` is `R' + cR`. -/
private theorem qDivisor_isPullback_add_zsmul {X Y : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [IsIntegral X] [IsLocallyNoetherian Y] [IsNormal Y]
    {f : X ⟶ Y} {P : Mori.PrimeDivisor Y} (hfP : f (genericPoint X) = P.genericPoint)
    {G G' : QDivisor Y} (hG : G.IsQCartier) (hG' : G'.IsQCartier) (hGP : G.coeff P = 0)
    (hG'P : G'.coeff P = 0) {R R' : QDivisor X}
    (p : G.IsPullback f (forall_notMem_supp_of_coeff_eq_zero f hfP hGP) R)
    (p' : G'.IsPullback f (forall_notMem_supp_of_coeff_eq_zero f hfP hG'P) R') (c : ℕ)
    (hc : (G' + (c : ℤ) • G).coeff P = 0) :
    (G' + (c : ℤ) • G).IsPullback f (forall_notMem_supp_of_coeff_eq_zero f hfP hc)
      (R' + (c : ℤ) • R) := by
  induction c with
  | zero =>
    have e1 : G' = G' + ((0 : ℕ) : ℤ) • G := by simp
    have e2 : R' = R' + ((0 : ℕ) : ℤ) • R := by simp
    rw [← e2]
    exact isPullback_of_eq_source e1 p'
  | succ c ih =>
    have hcP : (G' + (c : ℤ) • G).coeff P = 0 := by
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, hGP, hG'P,
        smul_zero, add_zero]
    have hq : (G' + (c : ℤ) • G).IsQCartier := hG'.add (isQCartier_zsmul hG _)
    have e1 : G' + (c : ℤ) • G + G = G' + ((c + 1 : ℕ) : ℤ) • G := by
      rw [add_assoc]; congr 1; push_cast; rw [add_smul, one_smul]
    have e2 : R' + (c : ℤ) • R + R = R' + ((c + 1 : ℕ) : ℤ) • R := by
      rw [add_assoc]; congr 1; push_cast; rw [add_smul, one_smul]
    rw [← e2]
    refine isPullback_of_eq_source e1 (qDivisor_isPullback_add hq hG (ih hcP) p ?_)
    exact forall_notMem_supp_of_coeff_eq_zero f hfP (by
      rw [e1]; exact hc)

/-- `formPow 0 N = 0` for `N > 0`. -/
private theorem formPow_zero_of_pos {K : Type} [Field K] [Algebra ℂ K] {d N : ℕ} (hN : 0 < N) :
    (formPow (0 : ⋀[K]^d Ω[K⁄ℂ]) N : PluriForms ℂ K d N) = 0 := by
  unfold formPow
  exact (PiTensorProduct.tprod K).map_coord_zero ⟨0, hN⟩ rfl

/-- **Residues of log pluricanonical sections are log pluricanonical sections.** Let `(Y, B_Y)` be
a pair on a normal variety of dimension `d + 1` with `B_Y ≤ 1` and `K_Y + B_Y` `ℚ`-Cartier, and
`j : T ⟶ Y` an adjunction step with different `B_T`. Every section `τ` of `N(K_Y + B_Y)` has a
Poincaré residue along `T`, and it is a section of `N(K_T + B_T)`: writing `τ = h ω^{⊗N}` in a
logarithmic frame `ω` along `T`, the divisor
`div τ + N B_Y = (div(hω) + B_Y) + (N - 1)(div ω + B_Y)` is effective and `ℚ`-Cartier, and by
adjunction for the forms `hω` and `ω` its restriction to `T` is `div(Res τ) + N B_T`. -/
private theorem exists_isPoincareResidue_mem_logPluricanonicalSections
    {Y T : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] (hYn : IsNormalVariety ℂ sY) {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) {BY : QDivisor Y} (hle : ∀ P, BY.coeff P ≤ 1)
    {K : Divisor Y} (hK : K.IsCanonicalDivisor sY (d + 1))
    (hKB : (Divisor.toQDivisor K + BY).IsQCartier)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] {j : T ⟶ Y} {BT : QDivisor T}
    (hj : IsAdjunctionStep sY BY j BT) {N : ℕ} (hN : 0 < N) {τ : RationalPluriForms sY (d + 1) N}
    (hτ : τ ∈ logPluricanonicalSections sY (d + 1) N BY) :
    ∃ ρ : RationalPluriForms (j ≫ sY) d N, IsPoincareResidue sY j d N τ ρ ∧
      ρ ∈ logPluricanonicalSections (j ≫ sY) d N BT := by
  classical
  obtain ⟨hTn, P, hP1, hPr, hci, -⟩ := id hj
  haveI := hci
  haveI : LocallyOfFiniteType (j ≫ sY) := hTn.1.toLocallyOfFiniteType
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace j
  have hBP : BY.coeff P = 1 := le_antisymm (hle P) hP1
  have hjgen : j (genericPoint T) = P.genericPoint :=
    MMP.CyclicChartDifferent.Aux.map_genericPoint_eq j P hPr
  have hdT : topologicalKrullDim T = d := topologicalKrullDim_eq_of_range_eq_support sY j P hPr hd
  have hPmem : (P.support ∩ ((⊤ : Y.Opens) : Set Y)).Nonempty :=
    ⟨P.genericPoint, by rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl, trivial⟩
  have hpole : τ ≠ 0 → -(N : ℤ) ≤ P.ordForm τ := by
    intro hτ0
    have h1 := hτ.2 P hPmem hτ0
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, hBP, zsmul_eq_mul,
      mul_one, Int.floor_intCast] at h1
    omega
  have htop : (⊤ : T.Opens) ≠ ⊥ := fun h =>
    (show genericPoint T ∈ (⊥ : T.Opens) from h ▸ trivial).elim
  rcases Nat.eq_zero_or_pos d with rfl | hdpos
  · -- `T` is a point
    obtain ⟨ρ, hρ⟩ := exists_isPoincareResidue_of_curve hYn (by rw [hd]; rfl) hj τ
      fun P' hP' h0 => by
        obtain rfl : P' = P :=
          AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hP'.symm.trans hjgen)
        exact hpole h0
    refine ⟨ρ, hρ, fun h => absurd h htop, fun Γ _ _ => ?_⟩
    exfalso
    have h1 := AlgebraicGeometry.coheight_le_topologicalKrullDim Γ.genericPoint
    rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint, hdT] at h1
    exact absurd h1 (by decide)
  obtain ⟨σ, hσ0, hσP, ρσ, hρσ, hρσ0⟩ := exists_simplePole_isPoincareResidue_ne_zero sY hYn
    hdpos (by rw [hd]; norm_cast) j hTn hdT P hPr
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (j ≫ sY)
  obtain ⟨t, g₀, x, ht, hg₀u, hσeq, -, hall⟩ := exists_logFrame hd P hjgen hσ0 hσP hρσ hρσ0
  obtain ⟨h, hh⟩ := hall N τ hpole
  set ω₀ := logFrame sY j t x with hω₀def
  set ω₁ := resFrame sY j x with hω₁def
  set ρN : RationalPluriForms (j ≫ sY) d N := (j.stalkMap (genericPoint T)).hom h • formPow ω₁ N
    with hρN
  set r₁ : RationalPluriForms (j ≫ sY) d 1 := (j.stalkMap (genericPoint T)).hom h • formPow ω₁ 1
    with hr₁
  set r₀ : RationalPluriForms (j ≫ sY) d 1 := (1 : T.functionField) • formPow ω₁ 1 with hr₀
  set w₁ : RationalPluriForms (j ≫ sY) d 1 := formPow ω₁ 1 with hw₁
  refine ⟨ρN, hh ▸ isPoincareResidue_smul_formPow_logFrame sY j ht x h, ?_⟩
  by_cases hρ0 : ρN = 0
  · rw [hρ0]; exact zero_mem _
  refine ⟨fun h' => absurd h' htop, fun Γ _ hne => ?_⟩
  have hhb : (j.stalkMap (genericPoint T)).hom h ≠ 0 := fun h0 => hρ0 (by rw [hρN, h0, zero_smul]; rfl)
  have hω₁ : ω₁ ≠ 0 := fun h0 => hρ0 (by rw [hρN, h0, formPow_zero_of_pos hN, smul_zero]; rfl)
  have hω₀ : ω₀ ≠ 0 := fun h0 => hσ0 (by rw [hσeq, h0, formPow_zero_of_pos one_pos, smul_zero]; rfl)
  have hunit_ord : ∀ u : Y.presheaf.stalk (j (genericPoint T)), IsUnit u →
      Y.ord (algebraMap _ Y.functionField u) P.genericPoint = 0 :=
    fun _ hu => ord_algebraMap_stalk_eq_zero_of_isUnit P hjgen hu
  have hhu : IsUnit h := isUnit_of_stalkMap_genericPoint_ne_zero j hhb
  have hhK : algebraMap _ Y.functionField h ≠ 0 := (hhu.map _).ne_zero
  have hg₀K : algebraMap _ Y.functionField g₀ ≠ 0 := (hg₀u.map _).ne_zero
  have hdY : topologicalKrullDim Y = (d + 1 : ℕ) := hd
  -- orders along `P`
  have hω₀P : P.ordForm (show RationalPluriForms sY (d + 1) 1 from formPow ω₀ 1) = -1 := by
    have h1 := ordForm_smul_formPow hdY P hω₀ hg₀K 1
    rw [← hσeq, hσP, hunit_ord g₀ hg₀u] at h1
    simp only [Nat.cast_one, one_mul, zero_add] at h1
    exact h1.symm
  -- the two top forms `ω₀` and `h ω₀`, their residues and their divisors
  set α : RationalPluriForms sY (d + 1) 1 := (1 : Y.functionField) • formPow ω₀ 1 with hαdef
  set α' : RationalPluriForms sY (d + 1) 1 := algebraMap _ Y.functionField h • formPow ω₀ 1
    with hα'def
  have hα0 : α ≠ 0 := smul_formPow_ne_zero hdY hω₀ one_ne_zero 1
  have hα'0 : α' ≠ 0 := smul_formPow_ne_zero hdY hω₀ hhK 1
  have hordα : ∀ Γ : Mori.PrimeDivisor Y, Γ.ordForm α =
      Γ.ordForm (show RationalPluriForms sY (d + 1) 1 from formPow ω₀ 1) := fun Γ => by
    rw [hαdef, ordForm_smul_formPow hdY Γ hω₀ one_ne_zero 1, Scheme.ord_one]; push_cast; ring
  have hordα' : ∀ Γ : Mori.PrimeDivisor Y, Γ.ordForm α' = Y.ord (algebraMap _ Y.functionField h)
      Γ.genericPoint + Γ.ordForm (show RationalPluriForms sY (d + 1) 1 from formPow ω₀ 1) :=
    fun Γ => by rw [hα'def, ordForm_smul_formPow hdY Γ hω₀ hhK 1]; push_cast; ring
  have hordτ : ∀ Γ : Mori.PrimeDivisor Y, Γ.ordForm τ = Y.ord (algebraMap _ Y.functionField h)
      Γ.genericPoint + N * Γ.ordForm (show RationalPluriForms sY (d + 1) 1 from formPow ω₀ 1) :=
    fun Γ => by rw [hh, ordForm_smul_formPow hdY Γ hω₀ hhK N]
  have hresα : IsPoincareResidue sY j d 1 α r₀ := by
    have := isPoincareResidue_smul_formPow_logFrame (m := 1) sY j ht x 1
    rwa [map_one, map_one] at this
  have hresα' : IsPoincareResidue sY j d 1 α' r₁ :=
    isPoincareResidue_smul_formPow_logFrame (m := 1) sY j ht x h
  have hαP : P.ordForm α = -1 := by rw [hordα, hω₀P]
  have hα'P : P.ordForm α' = -1 := by rw [hordα', hω₀P, hunit_ord h hhu, zero_add]
  have hQC : ∀ β : RationalPluriForms sY (d + 1) 1, β ≠ 0 →
      (Divisor.toQDivisor (divisorOfForm β) + BY).IsQCartier := fun β hβ =>
    hKB.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hYn hK hβ).symm)
  set A := Divisor.toQDivisor (divisorOfForm α) + BY with hAdef
  set A' := Divisor.toQDivisor (divisorOfForm α') + BY with hA'def
  have hAP : A.coeff P = 0 := by
    rw [hAdef, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hαP,
      hBP]; norm_num
  have hA'P : A'.coeff P = 0 := by
    rw [hA'def, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hα'P,
      hBP]; norm_num
  obtain ⟨hgA, hpA⟩ := hj.isPullback_divisorOfForm_add_of_isPoincareResidue (by rw [hd]; norm_cast)
    P hPr α hα0 hαP _ hresα (hQC α hα0)
  obtain ⟨hgA', hpA'⟩ := hj.isPullback_divisorOfForm_add_of_isPoincareResidue (by rw [hd]; norm_cast)
    P hPr α' hα'0 hα'P _ hresα' (hQC α' hα'0)
  have hEP : (A' + ((N - 1 : ℕ) : ℤ) • A).coeff P = 0 := by
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, hAP, hA'P, smul_zero,
      add_zero]
  have hpE := qDivisor_isPullback_add_zsmul (f := j) hjgen (hQC α hα0) (hQC α' hα'0) hAP hA'P hpA hpA'
    (N - 1) hEP
  -- the coefficients of `E = div τ + N B_Y`
  have hEcoeff : ∀ Γ : Mori.PrimeDivisor Y, (A' + ((N - 1 : ℕ) : ℤ) • A).coeff Γ =
      (Γ.ordForm τ : ℚ) + N * BY.coeff Γ := by
    intro Γ
    simp only [hAdef, hA'def, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
      Divisor.coeff_toQDivisor, coeff_divisorOfForm, zsmul_eq_mul, hordα, hordα', hordτ]
    have : ((N - 1 : ℕ) : ℚ) = (N : ℚ) - 1 := by
      rw [Nat.cast_sub hN]; push_cast; ring
    push_cast [this]
    ring
  have hE0 : 0 ≤ A' + ((N - 1 : ℕ) : ℤ) • A := by
    intro Γ
    change 0 ≤ (A' + ((N - 1 : ℕ) : ℤ) • A).coeff Γ
    rw [hEcoeff]
    by_cases hτ0 : τ = 0
    · exfalso
      apply hρ0
      have : (algebraMap _ Y.functionField h • formPow ω₀ N : RationalPluriForms sY (d + 1) N) ≠ 0 :=
        smul_formPow_ne_zero hdY hω₀ hhK N
      exact absurd (hh.symm.trans hτ0) this
    have h1 := hτ.2 Γ ⟨Γ.genericPoint, by
      rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl, trivial⟩ hτ0
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] at h1
    have h2 := Int.floor_le (((N : ℤ) : ℚ) * BY.coeff Γ)
    have h1' : (0 : ℚ) ≤ (Γ.ordForm τ : ℚ) + ⌊((N : ℤ) : ℚ) * BY.coeff Γ⌋ := by exact_mod_cast h1
    push_cast at h2 h1' ⊢
    linarith
  have hEq : (A' + ((N - 1 : ℕ) : ℤ) • A).IsQCartier :=
    (hQC α' hα'0).add (isQCartier_zsmul (hQC α hα0) _)
  have hE'0 := nonneg_of_isPullback hE0 hEq hpE Γ
  -- the coefficient of the restriction along `Γ`
  have hρord : Γ.ordForm ρN = T.ord ((j.stalkMap (genericPoint T)).hom h) Γ.genericPoint +
      N * Γ.ordForm w₁ := ordForm_smul_formPow hdT Γ hω₁ hhb N
  have e1 : (divisorOfForm r₁).coeff Γ = T.ord ((j.stalkMap (genericPoint T)).hom h)
      Γ.genericPoint + Γ.ordForm w₁ := by
    rw [coeff_divisorOfForm]
    have := ordForm_smul_formPow hdT Γ hω₁ hhb 1
    simp only [Nat.cast_one, one_mul] at this
    exact this
  have e2 : (divisorOfForm r₀).coeff Γ = Γ.ordForm w₁ := by
    rw [coeff_divisorOfForm]
    have := ordForm_smul_formPow hdT Γ hω₁ one_ne_zero 1
    simp only [Nat.cast_one, one_mul, Scheme.ord_one, zero_add] at this
    exact this
  have hcast : ((N - 1 : ℕ) : ℚ) = (N : ℚ) - 1 := by
    rw [Nat.cast_sub hN]; push_cast; ring
  have key : (0 : ℚ) ≤ (T.ord ((j.stalkMap (genericPoint T)).hom h) Γ.genericPoint : ℚ) +
      N * (Γ.ordForm w₁ : ℚ) + N * BT.coeff Γ := by
    have h0 : (0 : ℚ) ≤ (Divisor.toQDivisor (divisorOfForm r₁) + BT + ((N - 1 : ℕ) : ℤ) •
        (Divisor.toQDivisor (divisorOfForm r₀) + BT)).coeff Γ := hE'0
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
      Divisor.coeff_toQDivisor, zsmul_eq_mul, e1, e2] at h0
    push_cast [hcast] at h0
    linarith
  rw [hρord, DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
  have hfl : -((T.ord ((j.stalkMap (genericPoint T)).hom h) Γ.genericPoint : ℤ) +
      N * Γ.ordForm w₁) ≤ ⌊((N : ℤ) : ℚ) * BT.coeff Γ⌋ := by
    rw [Int.le_floor]
    push_cast
    linarith
  omega

/-! ### Passing to a multiple of the degree -/

/-- **An admissible floor system is a function on the floor against the base forms.** The first
half of `exists_section_of_mem_admissibleSections`, for any `fS : S ⟶ V` over `R` with
`fS_* 𝒪_S = 𝒪_V` (for instance `V = S`): near the image of every floor component, `t_P` is the
value of one function `G` on `V` times the residue of `f^*e^{-r} w^{⊗kr}`, and `G` is a unit
where `t` generates. -/
private theorem exists_floorFunction_of_mem_admissibleSections
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} (hX : Mori.IsProjectiveVariety ℂ sX) {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ)) (hQ : IsQFactorial sX)
    {B : QDivisor X} (hB : IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (n + 1))
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X ⟶ R) [IsDominant f] (hf : f ≫ sR = sX) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier)
    {M : Divisor X} {u : X.functionField} (hu0 : u ≠ 0)
    (hMu : ∀ Γ : Mori.PrimeDivisor X,
      (X.ord u Γ.genericPoint : ℚ) = M.coeff Γ - k * (K.coeff Γ + B.coeff Γ))
    (hM : ∃ hfH, H.IsPullback f hfH M)
    (hS0 : B.roundDown ≠ 0)
    {S : Scheme.{0}} (ιS : S ⟶ X) [IsClosedImmersion ιS] [IsReduced S]
    (hS : Set.range ιS.base = ⋃ E ∈ B.roundDown.support, (E.support : Set X))
    {V : Scheme.{0}} (ιV : V ⟶ R)
    (fS : S ⟶ V) (hfS : fS ≫ ιV = ιS ≫ f) (hfSO : ∀ U : V.Opens, IsIso (fS.app U))
    (C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    (j : ∀ P, C P ⟶ X) (BC : ∀ P, QDivisor (C P))
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set X))
    {r : ℕ} (hm : Even (k * r))
    (hCartKB : (((k * r : ℕ) : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor)
    (RS : ResidueRestriction (fun P => j P ≫ sX) BC n (k * r))
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (hw : ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
      ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ)
    (gV : ∀ P, C P ⟶ V) (hgV : ∀ P, gV P ≫ ιV = j P ≫ f) (cP : ∀ P, C P ⟶ S)
    (hcP : ∀ P, cP P ≫ ιS = j P) (hgVc : ∀ P, gV P = cP P ≫ fS)
    {t : ∀ P, logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)}
    (ht : t ∈ admissibleSections RS) :
    ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∃ G : Γ(V, ιV ⁻¹ᵁ U), ∀ P, ∀ hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U,
        ∀ ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ),
          IsPoincareResidue sX (j P) n (k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)) ρ →
          ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
              RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ)) =
            ((gV P).stalkMap (genericPoint (C P))).hom
              (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV G) • ρ ∧
          ∀ y : C P, (∃ W : (C P).Opens, y ∈ W ∧ GeneratesOn (BC P) (k * r) W
              ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
                RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ))) →
            ∀ hy : gV P y ∈ ιV ⁻¹ᵁ U, IsUnit (V.presheaf.germ (ιV ⁻¹ᵁ U) (gV P y) hy G) := by
  classical
  -- the base forms `f^*e^{-r} w^{⊗kr}` near the floor
  let τ : R.Opens → (RationalFunctions R)ˣ → RationalPluriForms sX (n + 1) ((k * r : ℕ) : ℤ) :=
    fun _ e => ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
      (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)
  -- their residues along the floor components
  have hρex : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∀ P, f (j P (genericPoint (C P))) ∈ U →
        ∃ ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ),
          IsPoincareResidue sX (j P) n (k * r) (τ U e) ρ ∧ ρ ≠ 0 := by
    intro U e he P hP
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    haveI : CompactSpace (C P) := by
      haveI := (RS.setting.isProjectiveVariety P).toIsVariety
      exact QuasiCompact.compactSpace_of_compactSpace (j P ≫ sX)
    obtain ⟨hfH, hpb⟩ := hM
    exact exists_isPoincareResidue_ne_zero_of_generatesOn hXn hdim hdlt.2.1 (hC P).1
      (RS.setting.topologicalKrullDim_eq P)
      (generatesOn_base hdim f hpb hu0 hMu w hw RS.setting.pos he) hP
  -- the floor as an sdlt adjoint pair, its components indexed by the floor primes
  obtain ⟨-, hfin, N, Δ, Θ, hsdlt, hadj, hbij, hres⟩ :=
    isCMScheme_and_exists_isSdltAdjointPair_of_isDltPair (k := ℂ) hdim hK hX hQ hB hdlt hS0 ιS hS
  obtain ⟨π, hπ⟩ := exists_equiv_iso_floorComponents ιS N hadj hbij C j BC hC
  choose hπr pp hpp using hπ
  haveI : ∀ i, IsDominant (pp i).hom := fun i => inferInstance
  have hproj : ∀ i, IsProjectiveMorphism (pp i).hom := by
    intro i
    obtain ⟨d, j0, hj0, h0⟩ := AlgebraicGeometry.isProjectiveMorphism_id (N.X i)
    haveI := hj0
    exact ⟨d, (pp i).hom ≫ j0, inferInstance, by rw [Category.assoc, h0, Category.comp_id]⟩
  have hfam : (fun i => (pp i).hom ≫ N.n i ≫ ιS ≫ sX) = (fun i => j (π i) ≫ sX) :=
    funext fun i => by rw [← hpp i]; simp only [Category.assoc]
  obtain ⟨R', s', hs', hss'⟩ := exists_residueRestriction_congr hfam
    (residueRestrictionReindex RS π) (fun i => t (π i)) (mem_admissibleSections_reindex RS π ht)
  have hcoefAll : ∀ i (F : Mori.PrimeDivisor (C (π i))) (F' : Mori.PrimeDivisor (N.X i)),
      F'.genericPoint = (pp i).hom F.genericPoint → (BC (π i)).coeff F = (Θ i).coeff F' := by
    intro i F F' hF'
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    obtain ⟨K', hdltK⟩ := hsdlt.exists_isDltPair i
    have hPW := hdltK.1
    haveI : IsProper sX := (IsProjectiveMorphism.isProjective
      (IsProjectiveVariety.isProjective (k := ℂ) (f := sX))).isProper
    obtain ⟨-, d, K₀, hK₀, hKB⟩ := hB.isPair
    have hd : d = n + 1 := by
      have := hK₀.topologicalKrullDim_eq
      rw [hdim] at this
      exact_mod_cast this.symm
    subst hd
    have hσ0 : ∀ a, (1 : FunctionFieldEquiv sX sX) a = functionFieldMap (Iso.refl X).hom a :=
      fun a => (functionFieldMap_id_apply a).symm
    have hσc0 : IsCrepantBirationalMap sX sX B B 1 :=
      (crepantBirationalAutomorphisms sX B).one_mem
    have hψX : (pp i).hom ≫ (N.n i ≫ ιS) = j (π i) ≫ (Iso.refl X).hom := by
      rw [hpp i]; rfl
    have hsT : (pp i).hom ≫ (N.n i ≫ ιS) ≫ sX = j (π i) ≫ sX := by
      rw [← Category.assoc, hpp i]
    obtain ⟨σT, hσT⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) (pp i).hom
      (functionFieldMap_bijective_of_isIso (pp i)) hsT
    haveI : CompactSpace (C (π i)) := by
      haveI := (RS.setting.isProjectiveVariety (π i)).toIsVariety
      exact QuasiCompact.compactSpace_of_compactSpace (j (π i) ≫ sX)
    haveI : CompactSpace (N.X i) := (Scheme.homeoOfIso (pp i)).compactSpace
    haveI : IsNoetherian (C (π i)) := {}
    have hcr := isCrepantBirationalMap_of_isAdjunctionStep_of_iso hXn hXn hdim hdim hK₀ hK₀ hKB
      hKB (Iso.refl X) (Category.id_comp sX) 1 hσ0 hσc0 (hC (π i)).1 (hadj i) (pp i) hψX σT hσT
    have hPC : MMP.Mori.IsPair (j (π i) ≫ sX) (BC (π i)) := (RS.setting.isPair (π i)).isPair
    obtain ⟨-, dC, KC, hKC, -⟩ := id hPC
    have hPN : MMP.Mori.IsPair ((N.n i ≫ ιS) ≫ sX) (Θ i) := by
      rw [Category.assoc]; exact hPW.isPair
    have hK'N : K'.IsCanonicalDivisor ((N.n i ≫ ιS) ≫ sX) n := by
      rw [Category.assoc]; exact hPW.2.1
    have hinvj : (pp i).inv ≫ j (π i) = N.n i ≫ ιS := by
      rw [← hpp i, Iso.inv_hom_id_assoc]
    have hZn : IsNormalVariety ℂ ((pp i).inv ≫ j (π i) ≫ sX) := by
      rw [← Category.assoc, hinvj, Category.assoc]; exact N.isNormalVariety i
    have hval : ∀ g, F'.divisorialValuation g = F.divisorialValuation ((σT.toHom) g) := by
      intro g
      change F'.divisorialValuation g = F.divisorialValuation (σT g)
      rw [hσT]
      exact divisorialValuation_eq_of_iso (hC (π i)).1.1 (pp i) hZn F F' hF'.symm g
    exact (coeff_eq_of_isCrepantBirationalMap hPC hPN hKC hK'N σT hcr F F' hval).symm
  have hcrep : ∀ i, ∃ (K' : Divisor (N.X i))
      (hY : IsNormalVariety ℂ ((pp i).hom ≫ N.n i ≫ ιS ≫ sX))
      (hp : IsBirationalMorphism (pp i).hom),
      IsCrepantBoundary (N.n i ≫ ιS ≫ sX) n K' (Θ i) (pp i).hom hY hp (BC (π i)) := by
    intro i
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    obtain ⟨K', hdltK⟩ := hsdlt.exists_isDltPair i
    have hPW := hdltK.1
    have hYeq : (pp i).hom ≫ N.n i ≫ ιS ≫ sX = j (π i) ≫ sX := by
      rw [← hpp i]; simp only [Category.assoc]
    have hY : IsNormalVariety ℂ ((pp i).hom ≫ N.n i ≫ ιS ≫ sX) := hYeq ▸ (hC (π i)).1.1
    have hp : IsBirationalMorphism (pp i).hom := isBirationalMorphism_of_isIso _
    refine ⟨K', hY, hp, fun F => ?_⟩
    -- the image of `F` on `Tᵢ`
    obtain ⟨F', hF'⟩ := exists_primeDivisor_genericPoint_eq_of_iso (pp i) F
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hPW.2.1
      (⟨C (π i), (pp i).hom, hY, hp, F⟩ : DivisorOver ℂ (N.n i ≫ ιS ≫ sX))
    have hc' := isDiscrepancy_eq_neg_coeff_of_map_genericPoint_eq hPW.1 (P := F') hF'.symm hc
    -- the crepancy of `(C_P, B_{C_P}) ≅ (Tᵢ, Θᵢ)`
    have hcoef : (BC (π i)).coeff F = (Θ i).coeff F' := hcoefAll i F F' hF'
    rw [hc', ← hcoef] at hc
    exact hc
  -- the residues of the base forms are local generators on the floor
  have hdimN : ∀ i, topologicalKrullDim (N.X i) = n := fun i =>
    topologicalKrullDim_floorComponent ιS hdim hK hX hQ hB hdlt hS0 hS N Θ hadj hbij i
  have hgenU : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∃ ρ : ∀ i, RationalPluriForms (N.n i ≫ ιS ≫ sX) n ((k * r : ℕ) : ℤ),
        ((∀ i, ((N.n i ≫ ιS) ⁻¹ᵁ (f ⁻¹ᵁ U) : Set (N.X i)).Nonempty →
          IsPoincareResidue sX (N.n i ≫ ιS) n (k * r) (τ U e) (ρ i)) ∧ ∀ i, ρ i ≠ 0) ∧
        IsAdjointGeneratorOn N n (k * r) Θ (ιS ⁻¹ᵁ (f ⁻¹ᵁ U)) ρ ∧
        ∀ U' : S.Opens, U' ≤ ιS ⁻¹ᵁ (f ⁻¹ᵁ U) →
          ∀ g : ∀ i, RationalPluriForms (N.n i ≫ ιS ≫ sX) n ((k * r : ℕ) : ℤ),
            IsAdjointGeneratorOn N n (k * r) Θ U' g →
            ∃ ε : Γ(S, U')ˣ, ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U')),
              g i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom
                ((N.n i).app U' (ε : Γ(S, U'))) • ρ i := by
    intro U e he
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    obtain ⟨hfH, hpb⟩ := id hM
    have hgenτ := generatesOn_base hdim f hpb hu0 hMu w hw RS.setting.pos he
    have hCart := hCartKB
    obtain ⟨⟨ρ₀, hρ₀⟩, hρall⟩ := hres (k * r) RS.setting.pos hCart (f ⁻¹ᵁ U) (τ U e) hgenτ
    have hcpt : ∀ i, CompactSpace (N.X i) := fun i => by
      haveI : CompactSpace (C (π i)) := by
        haveI := (RS.setting.isProjectiveVariety (π i)).toIsVariety
        exact QuasiCompact.compactSpace_of_compactSpace (j (π i) ≫ sX)
      exact (Scheme.homeoOfIso (pp i)).compactSpace
    have hρ₁ : ∀ i, ∃ ρ₁ : RationalPluriForms (N.n i ≫ ιS ≫ sX) n ((k * r : ℕ) : ℤ),
        (((N.n i ≫ ιS) ⁻¹ᵁ (f ⁻¹ᵁ U) : Set (N.X i)).Nonempty →
          IsPoincareResidue sX (N.n i ≫ ιS) n (k * r) (τ U e) ρ₁) ∧ ρ₁ ≠ 0 := by
      intro i
      haveI := hcpt i
      by_cases hi : ((N.n i ≫ ιS) ⁻¹ᵁ (f ⁻¹ᵁ U) : Set (N.X i)).Nonempty
      · have hgi : (N.n i ≫ ιS) (genericPoint (N.X i)) ∈ f ⁻¹ᵁ U := by
          obtain ⟨z, hz⟩ := hi
          exact ((genericPoint_spec (N.X i)).specializes trivial |>.map
            (N.n i ≫ ιS).continuous).mem_open (f ⁻¹ᵁ U).isOpen hz
        obtain ⟨ρ', hρ', hρ'0⟩ := exists_isPoincareResidue_ne_zero_of_generatesOn hXn hdim
          hdlt.2.1 (hadj i) (hdimN i) hgenτ hgi
        exact ⟨ρ', fun _ => hρ', hρ'0⟩
      · haveI : LocallyOfFiniteType (N.n i ≫ ιS ≫ sX) := (N.isNormalVariety i).1.toLocallyOfFiniteType
        letI := functionFieldAlgebra (N.n i ≫ ιS ≫ sX)
        obtain ⟨b⟩ := exists_basis_topForms (sX := N.n i ≫ ιS ≫ sX) (d := n) (by rw [hdimN i])
        refine ⟨(ZTensorPower.basis b ((k * r : ℕ) : ℤ)) (), fun h => absurd h hi, ?_⟩
        exact (ZTensorPower.basis b _).ne_zero ()
    choose ρ hρres hρne using hρ₁
    obtain ⟨hgen, huniq⟩ := hρall ρ hρres hρne
    exact ⟨ρ, ⟨hρres, hρne⟩, hgen, huniq⟩
  have hm' : ∀ x : S, ∃ (U : S.Opens) (_ : x ∈ U)
      (g : ∀ i, RationalPluriForms (N.n i ≫ ιS ≫ sX) n ((k * r : ℕ) : ℤ)),
      IsAdjointGeneratorOn N n (k * r) Θ U g ∧
        ∀ i (P : Mori.PrimeDivisor (N.X i)), (N.n i).base P.genericPoint ∈ U →
          (N.n i).base P.genericPoint ∈ (MMP.Flips.doubleIntersectionLocus S : Set S) →
          ∃ (V : S.Opens) (hP : (N.n i).base P.genericPoint ∈ V) (a : Fin (n - 1) → Γ(S, V))
            (g' : Γ(S, V)), IsLogResiduePresentation N n (k * r) i P V hP a g' 1 (g i) := by
    intro x
    obtain ⟨U, hU, e, he⟩ := hH (f (ιS x))
    obtain ⟨ρ, ⟨hρres, hρne⟩, hgen, -⟩ := hgenU U e he
    refine ⟨ιS ⁻¹ᵁ (f ⁻¹ᵁ U), hU, ρ, hgen, fun i P hPU hPD => ?_⟩
    obtain ⟨j', P', heq, hne⟩ := exists_other_branch ιS hdim hK hX hQ hB hdlt hS0 hS N Θ hadj
      hbij i P hPD
    obtain ⟨V', hP, -, a', g', h1, -⟩ := hgen.2 i j' P P' heq hPU hPD hne
    exact ⟨V', hP, a', g', h1⟩
  obtain ⟨t', ⟨htloc, htpull⟩, -⟩ :=
    ((IsSdltAdjointPair.existsUnique_pullback_eq_of_mem_preadmissibleSections hsdlt
      (fun i => (pp i).hom) hproj hcrep R' hm').1 s'
      (admissibleSections_le_preadmissibleSections R' hs')).1
  -- the descended functions on `V`
  have hdescG : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∃ G : Γ(V, ιV ⁻¹ᵁ U), ∀ P, ∀ hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U,
        ∀ ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ),
          IsPoincareResidue sX (j P) n (k * r) (τ U e) ρ →
          ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
              RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ)) =
            ((gV P).stalkMap (genericPoint (C P))).hom
              (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV G) • ρ ∧
          ∀ y : C P, (∃ W : (C P).Opens, y ∈ W ∧ GeneratesOn (BC P) (k * r) W
              ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
                RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ))) →
            ∀ hy : gV P y ∈ ιV ⁻¹ᵁ U, IsUnit (V.presheaf.germ (ιV ⁻¹ᵁ U) (gV P y) hy G) := by
    intro U e he
    obtain ⟨ρN, ⟨hρNres, hρN0⟩, hgenρ, huniqρ⟩ := hgenU U e he
    set W : S.Opens := fS ⁻¹ᵁ (ιV ⁻¹ᵁ U) with hWdef
    have hWfS : ιS ⁻¹ᵁ (f ⁻¹ᵁ U) = W := by
      rw [hWdef, ← Scheme.Hom.comp_preimage, ← hfS, Scheme.Hom.comp_preimage]
    have hlftN : ∀ i, LocallyOfFiniteType (N.n i ≫ ιS ≫ sX) := fun i =>
      (N.isNormalVariety i).1.toLocallyOfFiniteType
    -- the coefficients of `t'` against the residue generators
    have hcoef : ∀ i, ∃ c : (N.X i).functionField, t' i = c • ρN i := fun i => by
      haveI := hlftN i
      exact exists_eq_smul_of_ne_zero (hdimN i) (hρN0 i) (t' i)
    choose φ hφ using hcoef
    -- they descend locally
    have hloc : ∀ x : W, ∃ V' : S.Opens, x.1 ∈ V' ∧ V' ≤ W ∧ DescendsOn N φ V' := by
      intro x
      obtain ⟨U', hxU', g, f', ⟨hg, -⟩, htf⟩ := htloc x.1
      have hgV : IsAdjointGeneratorOn N n (k * r) Θ (U' ⊓ W) g :=
        ⟨fun i => (hg.1 i).mono ((N.n i).preimage_mono inf_le_left),
          fun i j P P' h1 h2 h3 h4 => hg.2 i j P P' h1 h2.1 h3 h4⟩
      obtain ⟨ε, hε⟩ := huniqρ (U' ⊓ W) (inf_le_right.trans hWfS.ge) g hgV
      refine ⟨U' ⊓ W, ⟨hxU', x.2⟩, inf_le_right, (f' |_ (U' ⊓ W)) * (ε : Γ(S, U' ⊓ W)),
        fun i hi => ?_⟩
      haveI : Nonempty (N.n i ⁻¹ᵁ U') := ⟨⟨hi.some.1, hi.some.2.1⟩⟩
      have e1 := htf i inferInstance
      rw [hε i hi, ← germToFunctionField_app_res N i (inf_le_left : U' ⊓ W ≤ U') f', hφ i,
        smul_smul] at e1
      rw [smul_left_injective _ (hρN0 i) e1, map_mul, map_mul]
    choose Vx hxVx hVxW hVxD using hloc
    have hWeq : W = ⨆ x : W, Vx x := le_antisymm
      (fun x hx => TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxVx ⟨x, hx⟩⟩)
      (iSup_le hVxW)
    obtain ⟨Fs, hFs⟩ : DescendsOn N φ W := by
      rw [hWeq]; exact descendsOn_iSup Vx hVxD
    -- push down to `V` through `fS_* 𝒪_S = 𝒪_V`
    haveI := hfSO (ιV ⁻¹ᵁ U)
    set G : Γ(V, ιV ⁻¹ᵁ U) := (inv (fS.app (ιV ⁻¹ᵁ U))).hom Fs with hGdef
    have hGFs : fS.app (ιV ⁻¹ᵁ U) G = Fs := by
      rw [hGdef, ← ConcreteCategory.comp_apply, IsIso.inv_hom_id]
      rfl
    refine ⟨G, fun P hPV ρ hρ => ?_⟩
    obtain ⟨i, rfl⟩ := π.surjective P
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    haveI := hlftN i
    have hpt : ∀ x, ιS (N.n i ((pp i).hom x)) = j (π i) x := fun x => by
      rw [← hpp i]; rfl
    -- the map `C_P ⟶ V` factors through `Tᵢ` and `S`
    have hgVeq : gV (π i) = (pp i).hom ≫ N.n i ≫ fS := by
      rw [hgVc, ← Category.assoc]
      congr 1
      rw [← cancel_mono ιS, hcP, Category.assoc, hpp i]
    have hgen0 : N.n i ((pp i).hom (genericPoint (C (π i)))) ∈ W := by
      have h1 : ιV (gV (π i) (genericPoint (C (π i)))) ∈ U := hPV
      rw [hgVeq] at h1
      exact h1
    haveI hiW : Nonempty (N.n i ⁻¹ᵁ W) := ⟨⟨_, hgen0⟩⟩
    have hiWne : ((N.n i ≫ ιS) ⁻¹ᵁ (f ⁻¹ᵁ U) : Set (N.X i)).Nonempty := by
      refine ⟨(pp i).hom (genericPoint (C (π i))), ?_⟩
      have : N.n i ((pp i).hom (genericPoint (C (π i)))) ∈ ιS ⁻¹ᵁ (f ⁻¹ᵁ U) := hWfS ▸ hgen0
      exact this
    -- the residue `ρ` is the pull-back of `ρN i`
    have hsT : (pp i).hom ≫ (N.n i ≫ ιS) ≫ sX = j (π i) ≫ sX := by
      rw [← Category.assoc, hpp i]
    obtain ⟨σT, hσT⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) (pp i).hom
      (functionFieldMap_bijective_of_isIso (pp i)) hsT
    have hσ0 : ∀ a, (1 : FunctionFieldEquiv sX sX) a = functionFieldMap (Iso.refl X).hom a :=
      fun a => (functionFieldMap_id_apply a).symm
    have hψX : (pp i).hom ≫ (N.n i ≫ ιS) = j (π i) ≫ (Iso.refl X).hom := by
      rw [hpp i]; rfl
    obtain ⟨-, Q, -, hQr, hciQ, -⟩ := (hC (π i)).1
    obtain ⟨-, Q', -, hQ'r, hciQ', -⟩ := hadj i
    haveI := hciQ
    haveI := hciQ'
    haveI : LocallyOfFiniteType (j (π i) ≫ sX) := (hC (π i)).1.1.1.toLocallyOfFiniteType
    have hclean := isPoincareResidue_pluriformPullback_of_iso hXn hXn hdim hdim (Iso.refl X)
      (Category.id_comp sX) 1 hσ0 Q Q' hQr hQ'r (pp i) hψX σT hσT (hρNres i hiWne)
    rw [pluriformPullback_one (by exact_mod_cast hdim)] at hclean
    have hρeq := IsPoincareResidue.unique (hC (π i)).1 hρ hclean
    obtain ⟨σ₀, hσ₀⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) (pp i).hom
      (functionFieldMap_bijective_of_isIso (pp i))
      (rfl : (pp i).hom ≫ (N.n i ≫ ιS ≫ sX) = (pp i).hom ≫ N.n i ≫ ιS ≫ sX)
    have hheq : HEq (pullbackRationalPluriForms (N.n i ≫ ιS ≫ sX) (pp i).hom (ρN i)) ρ := by
      rw [pullbackRationalPluriForms_eq_pluriformPullback (pp i).hom σ₀ hσ₀ (ρN i), hρeq]
      exact pluriformPullback_heq (congrFun hfam i) (Category.assoc _ _ _).symm σ₀ σT
        (fun a => by
          change σT a = σ₀ a
          rw [hσT, hσ₀]) HEq.rfl
    have hs'eq : ((s' i : logPluricanonicalSections _ n (k * r) _) :
        RationalPluriForms ((pp i).hom ≫ N.n i ≫ ιS ≫ sX) n ((k * r : ℕ) : ℤ)) =
        functionFieldMap (pp i).hom (φ i) •
          pullbackRationalPluriForms (N.n i ≫ ιS ≫ sX) (pp i).hom (ρN i) := by
      rw [← htpull i, hφ i, pullbackRationalPluriForms_smul']
    haveI : Nonempty ((pp i).hom ⁻¹ᵁ (N.n i ⁻¹ᵁ W)) := ⟨⟨genericPoint (C (π i)), hgen0⟩⟩
    -- the value of `G` at the generic point of `C_P`
    have hval : ((gV (π i)).stalkMap (genericPoint (C (π i)))).hom
        (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV G) = functionFieldMap (pp i).hom (φ i) := by
      have hx' : ((pp i).hom ≫ N.n i ≫ fS) (genericPoint (C (π i))) ∈ ιV ⁻¹ᵁ U := by
        rw [← hgVeq]; exact hPV
      rw [stalkMap_germ_eq_of_eq hgVeq (ιV ⁻¹ᵁ U) _ hPV hx', Scheme.Hom.germ_stalkMap_apply,
        hFs i hiW, MMP.Spreading.functionFieldMap_germToFunctionField (pp i).hom (N.n i ⁻¹ᵁ W)
          _ le_rfl, Scheme.Hom.appLE_eq_app]
      change _ = (C (π i)).presheaf.germ _ _ _ _
      rw [← hGFs]
      rfl
    have ht1 : ((t (π i) : logPluricanonicalSections (j (π i) ≫ sX) n (k * r) (BC (π i))) :
        RationalPluriForms (j (π i) ≫ sX) n ((k * r : ℕ) : ℤ)) =
        functionFieldMap (pp i).hom (φ i) • ρ :=
      eq_smul_of_heq (congrFun hfam i).symm (hss' i).symm hheq.symm _ hs'eq
    refine ⟨by rw [hval]; exact ht1, ?_⟩
    rintro y ⟨Wy, hyW, hgenW⟩ hy
    haveI : CompactSpace (C (π i)) := by
      haveI := (RS.setting.isProjectiveVariety (π i)).toIsVariety
      exact QuasiCompact.compactSpace_of_compactSpace (j (π i) ≫ sX)
    have hdimC : topologicalKrullDim (C (π i)) = n := RS.setting.topologicalKrullDim_eq (π i)
    have hY : IsNormalVariety ℂ ((pp i).hom ≫ N.n i ≫ ιS ≫ sX) := by
      rw [congrFun hfam i]; exact (hC (π i)).1.1
    have ht0 : ((t (π i) : logPluricanonicalSections (j (π i) ≫ sX) n (k * r) (BC (π i))) :
        RationalPluriForms (j (π i) ≫ sX) n ((k * r : ℕ) : ℤ)) ≠ 0 := hgenW.1
    have hρ0 : ρ ≠ 0 := by
      rintro rfl; rw [smul_zero] at ht1; exact ht0 ht1
    have hc0 : functionFieldMap (pp i).hom (φ i) ≠ 0 := by
      rintro h0; rw [h0, zero_smul] at ht1; exact ht0 ht1
    -- the coefficient has no zero or pole along the prime divisors through `y`
    have hord : ∀ Γ : Mori.PrimeDivisor (C (π i)), y ∈ Γ.support →
        (C (π i)).ord (functionFieldMap (pp i).hom (φ i)) Γ.genericPoint = 0 := by
      intro Γ hΓ
      obtain ⟨Γ', hΓ'⟩ := exists_primeDivisor_genericPoint_eq_of_iso (pp i) Γ
      have hgΓ : Γ.genericPoint ∈ (gV (π i)) ⁻¹ᵁ (ιV ⁻¹ᵁ U) :=
        Mori.PrimeDivisor.genericPoint_mem_of_nonempty (E := Γ) ⟨y, hΓ, hy⟩
      have hΓ'W : (Γ'.support ∩ ((N.n i) ⁻¹ᵁ (ιS ⁻¹ᵁ (f ⁻¹ᵁ U)) : Set (N.X i))).Nonempty := by
        refine ⟨Γ'.genericPoint, ?_, ?_⟩
        · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
        · rw [hΓ', hWfS]
          have h1 : ιV (gV (π i) Γ.genericPoint) ∈ U := hgΓ
          rw [hgVeq] at h1
          exact h1
      have e1 := (hgenρ.1 i).2 Γ' hΓ'W
      have e2 := hgenW.2 Γ ⟨y, hΓ, hyW⟩
      have e3 : Γ.ordForm ρ = Γ'.ordForm (ρN i) := by
        rw [← ordForm_pullback_eq_of_iso (N.isNormalVariety i) (hdimN i) (pp i) hY Γ Γ' hΓ' (ρN i)]
        exact ordForm_congr_heq (congrFun hfam i).symm hheq.symm Γ
      have e4 := hcoefAll i Γ Γ' hΓ'
      rw [ht1, Γ.ordForm_smul_of_topologicalKrullDim_eq hdimC hc0 hρ0, e3, e4] at e2
      push_cast at e1 e2
      have : ((C (π i)).ord (functionFieldMap (pp i).hom (φ i)) Γ.genericPoint : ℚ) = 0 := by
        linarith
      exact_mod_cast this
    obtain ⟨u, hu, hue⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero y hc0
      hord
    have hst := Scheme.Hom.germ_stalkMap_apply (gV (π i)) (ιV ⁻¹ᵁ U) y hy G
    have hgen1 := Scheme.Hom.germ_stalkMap_apply (gV (π i)) (ιV ⁻¹ᵁ U) _ hPV G
    haveI : Nonempty ((gV (π i)) ⁻¹ᵁ (ιV ⁻¹ᵁ U)) := ⟨⟨y, hy⟩⟩
    have e5 := Scheme.algebraMap_germ_eq_germToFunctionField (X := C (π i))
      (U := (gV (π i)) ⁻¹ᵁ (ιV ⁻¹ᵁ U)) hy ((gV (π i)).app (ιV ⁻¹ᵁ U) G)
    have e6 : ((C (π i)).germToFunctionField ((gV (π i)) ⁻¹ᵁ (ιV ⁻¹ᵁ U))).hom
        ((gV (π i)).app (ιV ⁻¹ᵁ U) G) = functionFieldMap (pp i).hom (φ i) := by
      rw [← hval, hgen1]
    have hgerm : (C (π i)).presheaf.germ ((gV (π i)) ⁻¹ᵁ (ιV ⁻¹ᵁ U)) y hy
        ((gV (π i)).app (ιV ⁻¹ᵁ U) G) = u := by
      apply IsFractionRing.injective ((C (π i)).presheaf.stalk y) (C (π i)).functionField
      rw [e5, e6, hue]
    rw [hgerm] at hst
    exact isUnit_of_map_unit _ _ (hst ▸ hu)
  exact hdescG

end SteinCopy

section TwoFloorTransport

open MMP.Mori

/-- **Orders of a local generator along a crepant model.** If `B_W` is the crepant boundary of
`(X, B)` on `p : W ⟶ X` and `τ` generates `𝒪_X(m(K + B))` near `p(η_E)`, then
`ord_E(p^*τ) = -m · coeff_E B_W`. -/
private theorem ordForm_pullback_eq_of_isCrepantBoundary {X W : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} {K : Divisor X}
    {B : QDivisor X} (p : W ⟶ X) (hW : IsNormalVariety ℂ (p ≫ sX)) (hp : IsBirationalMorphism p)
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsDominant p]
    {BW : QDivisor W} (hBW : IsCrepantBoundary sX n K B p hW hp BW) {m : ℕ} (hm : 0 < m)
    (hmC : ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor) {U : X.Opens}
    {τ : RationalPluriForms sX n m} (hτ : GeneratesOn B m U τ) (E : Mori.PrimeDivisor W)
    (hE : p E.genericPoint ∈ U) :
    (E.ordForm (pullbackRationalPluriForms sX p τ) : ℚ) = -(m : ℚ) * BW.coeff E := by
  obtain ⟨hX, hK, -⟩ := hBW E
  have h1 : IsDiscrepancy sX n K B ⟨W, p, hW, hp, E⟩
      ((E.ordForm (pullbackRationalPluriForms sX p τ) : ℚ) / m) := by
    refine ⟨hX, hK, m, hm, hmC, U, hE, τ, hτ, ?_⟩
    have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
    field_simp
    rfl
  have h2 := (hBW E).eq h1
  have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  field_simp at h2
  linarith

/-- **The crepant boundary along a strict transform.** If `q : W ⟶ Y` is proper birational and
the prime divisor `E` of `W` has the valuation of the prime divisor `Γ` of `Y`, the crepant
boundary of `(Y, C)` on `W` has the coefficient of `C` along `Γ` at `E`. -/
private theorem coeff_eq_of_isCrepantBoundary_of_valuation {Y W : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} {n : ℕ} {K : Divisor Y}
    {C : QDivisor Y} (hPY : MMP.Mori.IsPair sY C) (hK : K.IsCanonicalDivisor sY n)
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] (q : W ⟶ Y) [IsProper q]
    (hW : IsNormalVariety ℂ (q ≫ sY)) (hq : IsBirationalMorphism q) {BW : QDivisor W}
    (hBW : IsCrepantBoundary sY n K C q hW hq BW) (Γ : Mori.PrimeDivisor Y)
    (E : Mori.PrimeDivisor W)
    (hv : haveI := hq.isDominant
      ∀ g, E.divisorialValuation (functionFieldMap q g) = Γ.divisorialValuation g) :
    BW.coeff E = C.coeff Γ := by
  haveI := hq.isDominant
  have hY := hPY.isNormalVariety
  set DΓ := DivisorOver.ofPrimeDivisor ℂ hY Γ
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPY hK DΓ
  have hc' : c = -C.coeff Γ := hc.eq_neg_coeff_of_ofPrimeDivisor hY
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 Y) by infer_instance)
  have hlog' := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hBW E)
    (show IsProper q from inferInstance)
  have hval : (⟨W, q, hW, hq, E⟩ : DivisorOver ℂ sY).valuation = DΓ.valuation := by
    ext g
    change E.divisorialValuation (functionFieldMap q g) =
      Γ.divisorialValuation (functionFieldMap (𝟙 Y) g)
    rw [functionFieldMap_id_apply, hv]
  have := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hlog' hlog hval
  have h2 : ((-BW.coeff E : ℚ) : ℝ) = ((c : ℚ) : ℝ) := by linarith
  have h3 : -BW.coeff E = c := by exact_mod_cast h2
  rw [hc'] at h3
  linarith

/-- **Local generators move across a crepant birational map.** Let `σ : k(Y) ≅ k(X)` be a
birational identification with a common model `p : W ⟶ X`, `q : W ⟶ Y` (`q^* = p^* ∘ σ`) on which
`B_W` is the crepant boundary of both `(X, B)` and `(Y, C)`. If `τ` generates `𝒪_X(m(K_X + B))`
on `U_X`, then its transport `(σ⁻¹)^*τ` generates `𝒪_Y(m(K_Y + C))` on every open `U_Y` whose
preimage in `W` lies over `U_X`. -/
private theorem generatesOn_pluriformPullback_of_isCrepantBoundary {X Y W : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsNoetherian Y] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (hY : IsNormalVariety ℂ sY) {n : ℕ} (hn : topologicalKrullDim X = n)
    (hn' : topologicalKrullDim Y = n) {K : Divisor X} {B : QDivisor X} {KY : Divisor Y}
    {C : QDivisor Y} (hPY : MMP.Mori.IsPair sY C) (hKY : KY.IsCanonicalDivisor sY n)
    (σ : FunctionFieldEquiv sX sY) (σ' : FunctionFieldEquiv sY sX)
    (hσσ' : ∀ a, (σ.toHom) ((σ'.toHom) a) = a) (p : W ⟶ X) (q : W ⟶ Y) [IsProper p] [IsProper q]
    [IsDominant p] [IsDominant q] (hWp : IsNormalVariety ℂ (p ≫ sX))
    (hWq : IsNormalVariety ℂ (q ≫ sY)) (hpb : IsBirationalMorphism p)
    (hqb : IsBirationalMorphism q)
    (hcompat : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a)) {BW : QDivisor W}
    (hBWX : IsCrepantBoundary sX n K B p hWp hpb BW)
    (hBWY : IsCrepantBoundary sY n KY C q hWq hqb BW)
    {m : ℕ} (hm : 0 < m) (hmC : ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor)
    {UX : X.Opens} {UY : Y.Opens} (hU : ∀ w, q w ∈ UY → p w ∈ UX)
    {τ : RationalPluriForms sX n m} (hτ : GeneratesOn B m UX τ) :
    GeneratesOn C m UY (pluriformPullback sY sX σ'.toHom n m τ) := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sY
  refine ⟨fun h0 => hτ.1 ?_, fun Γ hΓ => ?_⟩
  · have e := pluriformPullback_comp hn hn' hn (m : ℤ) σ.toHom σ'.toHom τ
    have e1 : (σ.toHom.comp σ'.toHom) = (1 : FunctionFieldEquiv sX sX).toHom := by
      ext a
      exact hσσ' a
    rw [e1, pluriformPullback_one hn, h0, map_zero] at e
    exact e.symm
  · obtain ⟨E, U, hEΓ, -, -, hEv⟩ := exists_primeDivisor_map_genericPoint_eq hY q
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hqb) hWq Γ
    have hΓU : Γ.genericPoint ∈ UY := Mori.PrimeDivisor.genericPoint_mem_of_nonempty (E := Γ) hΓ
    have hpE : p E.genericPoint ∈ UX := hU _ (by rw [hEΓ]; exact hΓU)
    have e1 := ordForm_pluriformPullback_eq_ordPullback hY hX hn' hn σ' Γ
      ⟨W, p, hWp, hpb, E⟩ (fun g => by
        change E.divisorialValuation (functionFieldMap p g) = Γ.divisorialValuation (σ' g)
        rw [← hEv, hcompat]
        congr 2
        exact (hσσ' g).symm) τ
    have e2 := ordForm_pullback_eq_of_isCrepantBoundary p hWp hpb hBWX hm hmC hτ E hpE
    have e3 := coeff_eq_of_isCrepantBoundary_of_valuation hPY hKY q hWq hqb hBWY Γ E hEv
    change (Γ.ordForm (pluriformPullback sY sX σ'.toHom n m τ) : ℚ) + m * C.coeff Γ = 0
    rw [e1]
    change (E.ordForm (pullbackRationalPluriForms sX p τ) : ℚ) + m * C.coeff Γ = 0
    rw [e2, e3]
    ring

/-- **Poincaré residues pull back along a morphism matching the divisors.** Let `g : Y ⟶ Z` be a
dominant morphism of normal varieties of the same dimension over `ℂ` with `σ = g^*` on function
fields, carrying the generic point of the prime divisor `Q = j_T(T)` of `Y` to that of
`Q' = j_{T'}(T')` with `v_{Q'} = v_Q ∘ σ`, and `g_T : T ⟶ T'` over `g` with `σ_T = g_T^*`. Then
`Res_T(σ^*τ) = σ_T^* Res_{T'}(τ)`. -/
private theorem isPoincareResidue_pluriformPullback_of_map
    {Y Z T T' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    [LocallyOfFiniteType sZ] {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (hdZ : topologicalKrullDim Z = (d + 1 : ℕ))
    (g : Y ⟶ Z) [IsDominant g]
    (σ : FunctionFieldEquiv sY sZ) (hσ : ∀ a, σ a = functionFieldMap g a)
    [IsIntegral T] [IsIntegral T'] {jT : T ⟶ Y} {jT' : T' ⟶ Z} [IsClosedImmersion jT]
    [IsClosedImmersion jT'] [LocallyOfFiniteType (jT ≫ sY)] [LocallyOfFiniteType (jT' ≫ sZ)]
    (Q : Mori.PrimeDivisor Y) (Q' : Mori.PrimeDivisor Z)
    (hQr : Set.range jT.base = (Q.support : Set Y)) (hQ'r : Set.range jT'.base = (Q'.support : Set Z))
    (hgen : g Q.genericPoint = Q'.genericPoint)
    (hvQ : ∀ x, Q'.divisorialValuation x = Q.divisorialValuation ((σ.toHom) x))
    (gT : T ⟶ T') [IsDominant gT] (hgT : gT ≫ jT' = jT ≫ g)
    (σT : FunctionFieldEquiv (jT ≫ sY) (jT' ≫ sZ)) (hσT : ∀ a, σT a = functionFieldMap gT a)
    {N : ℕ} {τ : RationalPluriForms sZ (d + 1) N} {ρ : RationalPluriForms (jT' ≫ sZ) d N}
    (h : IsPoincareResidue sZ jT' d N τ ρ) :
    IsPoincareResidue sY jT d N (pluriformPullback sY sZ σ.toHom (d + 1) N τ)
      (pluriformPullback (jT ≫ sY) (jT' ≫ sZ) σT.toHom d N ρ) := by
  classical
  have e1 : jT (genericPoint T) = Q.genericPoint := map_genericPoint_eq_of_range_eq jT Q hQr
  have e2 : jT' (genericPoint T') = Q'.genericPoint := map_genericPoint_eq_of_range_eq jT' Q' hQ'r
  have hsp : g (jT (genericPoint T)) ⤳ jT' (genericPoint T') := by
    rw [e1, e2, hgen]
  let ψs := (Z.presheaf.stalkSpecializes hsp ≫ g.stalkMap (jT (genericPoint T))).hom
  have hψs' : ∀ a, algebraMap _ Y.functionField (ψs a) =
      (σ.toHom) (algebraMap _ Z.functionField a) := by
    intro a
    have h := congrArg (fun φ => φ.hom a)
      (stalkSpecializes_stalkMap_algebraMap g (jT (genericPoint T)) _ hsp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    change _ = σ _
    rw [hσ]
    exact h
  have hdT : topologicalKrullDim T = d := topologicalKrullDim_eq_of_range_eq_support sY jT Q hQr hd
  have hdT' : topologicalKrullDim T' = d :=
    topologicalKrullDim_eq_of_range_eq_support sZ jT' Q' hQ'r hdZ
  refine isPoincareResidue_pluriformPullback jT jT' hd hdZ hdT hdT' σ.toHom σT.toHom ψs hψs'
    (fun a => ?_) (fun a => ?_) h
  · have h := stalkMap_apply_eq_functionFieldMap_apply g jT' jT gT hgT hsp a
    change _ = σT _
    rw [hσT]
    exact h
  · rw [hψs']
    generalize algebraMap _ Z.functionField a = x
    rw [e1, e2]
    by_cases hx : x = 0
    · rw [hx, map_zero, Scheme.ord_zero, Scheme.ord_zero]
      rfl
    have hσx : (σ.toHom) x ≠ 0 := (map_ne_zero _).mpr hx
    have h1 := hvQ x
    rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hx,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hσx] at h1
    have h2 := WithZero.exp_injective h1
    omega

/-- **Transport of functions on floors.** If `a : T_W ⟶ S` and `b : T_W ⟶ T` lie over a common
map to `R` and `b_* 𝒪_{T_W} = 𝒪_T`, every function `G` on `S` over an open `U ⊆ R` is matched by a
function `Ψ` on `T` over `U` with the same germs on `T_W`. -/
private theorem exists_transport_of_isIso_app {S T Tw R : Scheme.{0}} (hS : S ⟶ R) (hT : T ⟶ R)
    (a : Tw ⟶ S) (b : Tw ⟶ T) (e : a ≫ hS = b ≫ hT) (hb : ∀ V : T.Opens, IsIso (b.app V))
    (U : R.Opens) (G : Γ(S, hS ⁻¹ᵁ U)) :
    ∃ Ψ : Γ(T, hT ⁻¹ᵁ U), ∀ (w : Tw) (hwa : a w ∈ hS ⁻¹ᵁ U) (hwb : b w ∈ hT ⁻¹ᵁ U),
      (a.stalkMap w).hom (S.presheaf.germ _ (a w) hwa G) =
        (b.stalkMap w).hom (T.presheaf.germ _ (b w) hwb Ψ) := by
  have hopen : b ⁻¹ᵁ (hT ⁻¹ᵁ U) = a ⁻¹ᵁ (hS ⁻¹ᵁ U) := by
    ext w
    change hT (b w) ∈ U ↔ hS (a w) ∈ U
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, e]
  haveI := hb (hT ⁻¹ᵁ U)
  set G' : Γ(Tw, b ⁻¹ᵁ (hT ⁻¹ᵁ U)) :=
    Tw.presheaf.map (eqToHom hopen).op (a.app (hS ⁻¹ᵁ U) G) with hG'
  refine ⟨(inv (b.app (hT ⁻¹ᵁ U))).hom G', fun w hwa hwb => ?_⟩
  rw [Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply]
  have h1 : b.app (hT ⁻¹ᵁ U) ((inv (b.app (hT ⁻¹ᵁ U))).hom G') = G' := by
    rw [← CommRingCat.comp_apply, IsIso.inv_hom_id]
    rfl
  rw [h1, hG']
  exact (TopCat.Presheaf.germ_res_apply Tw.presheaf (eqToHom hopen) w hwb _).symm

/-- **A function times a local generator is a section.** If `ω` generates `𝒪_X(m(K + B))` on `U`
and `h` is a function on a nonempty open `V ⊆ U`, then `h ω` is a section of `𝒪_X(mK + ⌊mB⌋)`
over `V`. -/
private theorem germToFunctionField_smul_mem_pluricanonicalSections {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] {d : ℕ} (hd : topologicalKrullDim X = d) {B : QDivisor X} {m : ℕ}
    {U V : X.Opens} [Nonempty V] (hVU : V ≤ U) {ω : RationalPluriForms sX d m}
    (hω : GeneratesOn B m U ω) (h : Γ(X, V)) :
    (X.germToFunctionField V h • ω) ∈
      pluricanonicalSections sX d m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) V := by
  refine ⟨fun hV0 => ?_, fun Γ hΓ hne => ?_⟩
  · exfalso
    obtain ⟨⟨y, hy⟩⟩ := (inferInstance : Nonempty V)
    rw [hV0] at hy
    exact hy
  have hc0 : X.germToFunctionField V h ≠ 0 := fun h0 => hne (by rw [h0, zero_smul])
  have hω0 := hω.1
  rw [Mori.PrimeDivisor.ordForm_smul_of_topologicalKrullDim_eq Γ hd hc0 hω0]
  have hΓV : Γ.genericPoint ∈ V := Mori.PrimeDivisor.genericPoint_mem_of_nonempty (E := Γ) hΓ
  have h1 := ord_germToFunctionField_nonneg Γ hΓV h
  obtain ⟨y, hyΓ, hyV⟩ := hΓ
  have h2 := hω.2 Γ ⟨y, hyΓ, hVU hyV⟩
  have h3 : ((DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ : ℚ) = -(Γ.ordForm ω : ℚ) := by
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
    have : ((m : ℤ) : ℚ) * B.coeff Γ = -(Γ.ordForm ω : ℚ) := by push_cast; linarith
    rw [this]
    exact_mod_cast Int.floor_intCast (-(Γ.ordForm ω))
  have h4 : (DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ = -(Γ.ordForm ω) := by
    exact_mod_cast h3
  omega

/-- **Sections of a reduced scheme are detected at the generic points of its components.** If the
integral schemes `c_i : F_i ⟶ T` reach every generic point of an irreducible component of the
reduced scheme `T` with their generic points, two sections over `V` with the same values at those
points agree. -/
private theorem eq_of_stalkMap_germ_eq {T : Scheme.{0}} [IsReduced T] {ι : Type*}
    {F : ι → Scheme.{0}} [∀ i, IsIntegral (F i)] (c : ∀ i, F i ⟶ T)
    (hc : ∀ y ∈ genericPoints T, ∃ i, c i (genericPoint (F i)) = y)
    {V : T.Opens} (s₁ s₂ : Γ(T, V))
    (h : ∀ i (hi : c i (genericPoint (F i)) ∈ V),
      ((c i).stalkMap (genericPoint (F i))).hom (T.presheaf.germ V _ hi s₁) =
        ((c i).stalkMap (genericPoint (F i))).hom (T.presheaf.germ V _ hi s₂)) :
    s₁ = s₂ := by
  by_contra hne
  obtain ⟨y, hyV, hyg, hy0⟩ := SteinCopy.exists_mem_genericPoints_germ_ne_zero' (s₁ - s₂)
    (sub_ne_zero.mpr hne)
  obtain ⟨i, rfl⟩ := hc y hyg
  have hfield := AlgebraicGeometry.isField_stalk_of_closure_mem_irreducibleComponents (X := T)
    (x := c i (genericPoint (F i))) (hx := hyg)
  letI := hfield.toField
  have hinj := ((c i).stalkMap (genericPoint (F i))).hom.injective
  apply hy0
  apply hinj
  rw [map_sub, map_sub, h i hyV, sub_self, map_zero]

/-- **Pull-back along an isomorphism of function fields is injective**, on varieties of the same
dimension over `ℂ`. -/
private theorem pluriformPullback_injective {S S' : Scheme.{0}} [IsIntegral S] [IsIntegral S']
    {s : S ⟶ Spec (.of ℂ)} {s' : S' ⟶ Spec (.of ℂ)} [LocallyOfFiniteType s]
    [LocallyOfFiniteType s'] {d : ℕ} (hS : topologicalKrullDim S = d)
    (hS' : topologicalKrullDim S' = d) (σ : FunctionFieldEquiv s s') (m : ℤ) :
    Function.Injective (pluriformPullback s s' σ.toHom d m) := by
  letI := functionFieldAlgebra s
  letI := functionFieldAlgebra s'
  set σi : FunctionFieldEquiv s' s := σ.symm with hσi
  have key : ∀ c, pluriformPullback s' s σi.toHom d m (pluriformPullback s s' σ.toHom d m c) = c := by
    intro c
    rw [pluriformPullback_comp hS' hS hS' m σi.toHom σ.toHom c]
    have e1 : (σi.toHom.comp σ.toHom) = (1 : FunctionFieldEquiv s' s').toHom := by
      ext x
      exact σ.symm_apply_apply x
    rw [e1, pluriformPullback_one hS' m c]
  intro a b hab
  rw [← key a, ← key b, hab]

/-- Pluriform pull-back is semilinear along the homomorphism of function fields. -/
private theorem pluriformPullback_smul_left {S S' : Scheme.{0}} [IsIntegral S] [IsIntegral S']
    {s : S ⟶ Spec (.of ℂ)} {s' : S' ⟶ Spec (.of ℂ)} (φ : FunctionFieldHom s s') {d : ℕ} {m : ℤ}
    (c : S'.functionField) (τ : RationalPluriForms s' d m) :
    pluriformPullback s s' φ d m (c • τ) = φ c • pluriformPullback s s' φ d m τ := by
  let := functionFieldAlgebra s'
  let := functionFieldAlgebra s
  let : Algebra S'.functionField S.functionField := φ.toRingHom.toAlgebra
  have : IsScalarTower ℂ S'.functionField S.functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  exact pullbackForms_smul (K := S'.functionField) (K' := S.functionField) c τ

/-- **Poincaré residues across a morphism that is a local isomorphism at the divisor.** Let
`g : Z ⟶ Y` be a dominant morphism of normal varieties of the same dimension over `ℂ`, an
isomorphism of local rings at the generic point of the prime divisor `Q' = j_{T'}(T')` of `Z`,
which it carries to the generic point of `Q = j_T(T)`, with `σ = (g^*)⁻¹` on function fields
carrying `v_{Q'}` to `v_Q`, and `g_T : T' ⟶ T` over `g` with `σ_T = (g_T^*)⁻¹`. Then
`Res_T(σ^*τ) = σ_T^* Res_{T'}(τ)`. -/
private theorem isPoincareResidue_pluriformPullback_of_isIso_stalkMap
    {Y Z T T' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    [LocallyOfFiniteType sZ] {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (hdZ : topologicalKrullDim Z = (d + 1 : ℕ))
    (g : Z ⟶ Y) [IsDominant g]
    (σ : FunctionFieldEquiv sY sZ) (hσ : ∀ a, functionFieldMap g (σ a) = a)
    [IsIntegral T] [IsIntegral T'] {jT : T ⟶ Y} {jT' : T' ⟶ Z} [IsClosedImmersion jT]
    [IsClosedImmersion jT'] [LocallyOfFiniteType (jT ≫ sY)] [LocallyOfFiniteType (jT' ≫ sZ)]
    (Q : Mori.PrimeDivisor Y) (Q' : Mori.PrimeDivisor Z)
    (hQr : Set.range jT.base = (Q.support : Set Y))
    (hQ'r : Set.range jT'.base = (Q'.support : Set Z))
    (hgen : g Q'.genericPoint = Q.genericPoint) (hiso : IsIso (g.stalkMap Q'.genericPoint))
    (hvQ : ∀ x, Q'.divisorialValuation x = Q.divisorialValuation ((σ.toHom) x))
    (gT : T' ⟶ T) [IsDominant gT] (hgT : gT ≫ jT = jT' ≫ g)
    (σT : FunctionFieldEquiv (jT ≫ sY) (jT' ≫ sZ)) (hσT : ∀ a, functionFieldMap gT (σT a) = a)
    {N : ℕ} {τ : RationalPluriForms sZ (d + 1) N} {ρ : RationalPluriForms (jT' ≫ sZ) d N}
    (h : IsPoincareResidue sZ jT' d N τ ρ) :
    IsPoincareResidue sY jT d N (pluriformPullback sY sZ σ.toHom (d + 1) N τ)
      (pluriformPullback (jT ≫ sY) (jT' ≫ sZ) σT.toHom d N ρ) := by
  classical
  have e1 : jT (genericPoint T) = Q.genericPoint := map_genericPoint_eq_of_range_eq jT Q hQr
  have e2 : jT' (genericPoint T') = Q'.genericPoint := map_genericPoint_eq_of_range_eq jT' Q' hQ'r
  have hgx : g (jT' (genericPoint T')) = jT (genericPoint T) := by rw [e1, e2, hgen]
  have hsp : jT (genericPoint T) ⤳ g (jT' (genericPoint T')) := by rw [hgx]
  have hsp' : g (jT' (genericPoint T')) ⤳ jT (genericPoint T) := by rw [hgx]
  haveI : IsIso (g.stalkMap (jT' (genericPoint T'))) := by rw [e2]; exact hiso
  let ψ : Z.presheaf.stalk (jT' (genericPoint T')) →+* Y.presheaf.stalk (jT (genericPoint T)) :=
    (inv (g.stalkMap (jT' (genericPoint T'))) ≫ Y.presheaf.stalkSpecializes hsp).hom
  have hψinv : ∀ a, (g.stalkMap _).hom ((Y.presheaf.stalkSpecializes hsp').hom (ψ a)) = a := by
    intro a
    change (inv (g.stalkMap _) ≫ Y.presheaf.stalkSpecializes hsp ≫
      Y.presheaf.stalkSpecializes hsp' ≫ g.stalkMap _).hom a = a
    rw [TopCat.Presheaf.stalkSpecializes_comp_assoc, TopCat.Presheaf.stalkSpecializes_refl,
      Category.id_comp, IsIso.inv_hom_id]
    rfl
  have hψ : ∀ a, algebraMap _ Y.functionField (ψ a) = (σ.toHom) (algebraMap _ Z.functionField a) := by
    intro a
    apply (functionFieldMap g).injective
    change _ = functionFieldMap g (σ _)
    rw [hσ]
    have h : algebraMap _ Z.functionField
        ((g.stalkMap _).hom ((Y.presheaf.stalkSpecializes hsp').hom (ψ a))) =
        functionFieldMap g (algebraMap _ Y.functionField (ψ a)) := congrArg (fun φ => φ.hom (ψ a))
      (stalkSpecializes_stalkMap_algebraMap g (jT' (genericPoint T')) _ hsp')
    rw [← h, hψinv]
  have hdT : topologicalKrullDim T = d := topologicalKrullDim_eq_of_range_eq_support sY jT Q hQr hd
  have hdT' : topologicalKrullDim T' = d :=
    topologicalKrullDim_eq_of_range_eq_support sZ jT' Q' hQ'r hdZ
  refine isPoincareResidue_pluriformPullback jT jT' hd hdZ hdT hdT' σ.toHom σT.toHom ψ hψ
    (fun a => ?_) (fun a => ?_) h
  · apply (functionFieldMap gT).injective
    change _ = functionFieldMap gT (σT _)
    rw [hσT]
    have h := stalkMap_apply_eq_functionFieldMap_apply g jT jT' gT hgT hsp' (ψ a)
    rw [← h, hψinv]
  · rw [hψ]
    generalize algebraMap _ Z.functionField a = x
    rw [e1, e2]
    exact SteinCopy.ord_eq_of_divisorialValuation_eq (σ.toHom : Z.functionField →+* Y.functionField)
      hvQ x

/-- **Residues compared through a common model.** Let `p : W ⟶ X` and `q : W ⟶ Y` be dominant
over `ℂ`, `E = j_E(E')` a prime divisor of `W` carried by `q` onto the prime divisor
`P' = j_P(C)` of `Y` (with `v_E ∘ q^* = v_{P'}`), and `g_T : E' ⟶ C` over `q`, inducing
`σ_T = g_T^*`. Suppose the residues of `p^*τ_X` and `q^*τ'` along `E` agree, that `p^*ω` and
`q^*Ω` coincide, that `p^*τ_X = g_X · p^*ω` with `ḡ_X = σ_T(ḡ_Y)` on `E'`, and that
`Res_{P'}(τ') = v`, `Res_{P'}(Ω) = λ`. Then `v = ḡ_Y λ`. -/
private theorem eq_smul_of_isPoincareResidue_pullback
    {X Y W E' C : Scheme.{0}} [IsIntegral X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsIntegral E'] [IsIntegral C]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] {d : ℕ}
    (hdY : topologicalKrullDim Y = (d + 1 : ℕ)) (hdW : topologicalKrullDim W = (d + 1 : ℕ))
    (p : W ⟶ X) (q : W ⟶ Y) [IsDominant p] [IsDominant q] (hpq : p ≫ sX = q ≫ sY)
    [LocallyOfFiniteType (q ≫ sY)]
    (σq : FunctionFieldEquiv (q ≫ sY) sY) (hσq : ∀ a, σq a = functionFieldMap q a)
    (E : Mori.PrimeDivisor W) (P' : Mori.PrimeDivisor Y)
    {jE : E' ⟶ W} {jP : C ⟶ Y} [IsClosedImmersion jE] [IsClosedImmersion jP]
    [LocallyOfFiniteType (jE ≫ q ≫ sY)] [LocallyOfFiniteType (jP ≫ sY)]
    (hEr : Set.range jE.base = (E.support : Set W))
    (hPr : Set.range jP.base = (P'.support : Set Y))
    (hgen : q E.genericPoint = P'.genericPoint)
    (hvQ : ∀ x, P'.divisorialValuation x = E.divisorialValuation ((σq.toHom) x))
    (gT : E' ⟶ C) [IsDominant gT] (hgT : gT ≫ jP = jE ≫ q)
    (σT : FunctionFieldEquiv (jE ≫ q ≫ sY) (jP ≫ sY)) (hσT : ∀ a, σT a = functionFieldMap gT a)
    {m : ℕ} {τX ω : RationalPluriForms sX (d + 1) m} {τ' Ω : RationalPluriForms sY (d + 1) m}
    {ρ : RationalPluriForms (jE ≫ p ≫ sX) d m} {v lam : RationalPluriForms (jP ≫ sY) d m}
    (gX : W.presheaf.stalk (jE (genericPoint E'))) (gY : Y.presheaf.stalk (jP (genericPoint C)))
    (hρ : IsPoincareResidue (p ≫ sX) jE d m (pullbackRationalPluriForms sX p τX) ρ)
    (hρ' : IsPoincareResidue (q ≫ sY) jE d m (pullbackRationalPluriForms sY q τ')
      (cast (by rw [hpq]) ρ))
    (hω : HEq (pullbackRationalPluriForms sX p ω) (pullbackRationalPluriForms sY q Ω))
    (hτX : pullbackRationalPluriForms sX p τX =
      algebraMap _ W.functionField gX • pullbackRationalPluriForms sX p ω)
    (hv : IsPoincareResidue sY jP d m τ' v) (hlam : IsPoincareResidue sY jP d m Ω lam)
    (hg : (jE.stalkMap (genericPoint E')).hom gX = σT ((jP.stalkMap (genericPoint C)).hom gY)) :
    v = (jP.stalkMap (genericPoint C)).hom gY • lam := by
  classical
  haveI : LocallyOfFiniteType (p ≫ sX) := by rw [hpq]; infer_instance
  have e1 : jE (genericPoint E') = E.genericPoint := map_genericPoint_eq_of_range_eq jE E hEr
  have hdE : topologicalKrullDim E' = d :=
    topologicalKrullDim_eq_of_range_eq_support (q ≫ sY) jE E hEr hdW
  have hdC : topologicalKrullDim C = d := topologicalKrullDim_eq_of_range_eq_support sY jP P' hPr hdY
  have hμ : IsPoincareResidue (q ≫ sY) jE d m (pullbackRationalPluriForms sY q Ω)
      (pluriformPullback (jE ≫ q ≫ sY) (jP ≫ sY) σT.toHom d m lam) := by
    rw [SteinCopy.pullbackRationalPluriForms_eq_pluriformPullback q σq hσq]
    exact isPoincareResidue_pluriformPullback_of_map hdW hdY q σq hσq E P' hEr hPr hgen hvQ gT
      hgT σT hσT hlam
  have hv' : IsPoincareResidue (q ≫ sY) jE d m (pullbackRationalPluriForms sY q τ')
      (pluriformPullback (jE ≫ q ≫ sY) (jP ≫ sY) σT.toHom d m v) := by
    rw [SteinCopy.pullbackRationalPluriForms_eq_pluriformPullback q σq hσq]
    exact isPoincareResidue_pluriformPullback_of_map hdW hdY q σq hσq E P' hEr hPr hgen hvQ gT
      hgT σT hσT hv
  have hss : jE ≫ q ≫ sY = jE ≫ p ≫ sX := by rw [hpq]
  have hμ' : IsPoincareResidue (p ≫ sX) jE d m (pullbackRationalPluriForms sX p ω)
      (cast (congrArg (fun s => RationalPluriForms s d (m : ℤ)) hss)
        (pluriformPullback (jE ≫ q ≫ sY) (jP ≫ sY) σT.toHom d m lam)) :=
    isPoincareResidue_congr jE hpq.symm hω.symm (cast_heq _ _).symm hμ
  have h1 := MMP.CyclicChartDifferent.Aux.IsPoincareResidue.algebraMap_smul hμ' gX
  rw [← hτX] at h1
  have hρeq := IsPoincareResidue.unique_of_isClosedImmersion E e1 hρ h1
  have hcast : cast (by rw [hpq]) ρ = (jE.stalkMap (genericPoint E')).hom gX •
      pluriformPullback (jE ≫ q ≫ sY) (jP ≫ sY) σT.toHom d m lam :=
    SteinCopy.eq_smul_of_heq hss (cast_heq _ _) (cast_heq _ _).symm _ hρeq
  have hv'' := IsPoincareResidue.unique_of_isClosedImmersion E e1 hv' hρ'
  apply pluriformPullback_injective hdE hdC σT (m : ℤ)
  rw [hv'', hcast, pluriformPullback_smul_left, hg]
  rfl

/-- **Germs along a factorization through a closed subscheme.** If `c ≫ a ≫ ι = j ≫ g` and the
function `h` on `V ⊆ X` restricts along `ι` to the function `G` on `O ⊆ S`, then pulling `h` back
along `g` and `j` gives at `x` the germ of `G` pulled back along `a` and `c`. -/
private theorem stalkMap_stalkMap_germ_eq_of_app_eq {A W X S Tw : Scheme.{0}} (j : A ⟶ W)
    (g : W ⟶ X) (c : A ⟶ Tw) (a : Tw ⟶ S) (ι : S ⟶ X) (hfac : c ≫ a ≫ ι = j ≫ g)
    {V : X.Opens} {O : S.Opens} (hO : ι ⁻¹ᵁ V ≤ O) (h : Γ(X, V)) (G : Γ(S, O))
    (hG : ι.app V h = S.presheaf.map (homOfLE hO).op G) (x : A) (hx : g (j x) ∈ V)
    (hx' : a (c x) ∈ O) :
    (j.stalkMap x).hom ((g.stalkMap (j x)).hom (X.presheaf.germ V _ hx h)) =
      (c.stalkMap x).hom ((a.stalkMap (c x)).hom (S.presheaf.germ O _ hx' G)) := by
  have hxe : (c ≫ a ≫ ι) x = (j ≫ g) x := by rw [hfac]
  simp only [Scheme.Hom.comp_apply] at hxe
  have e := stalkMap_germ_app_eq (c ≫ a) ι j g (by rw [Category.assoc, hfac]) V x
    (show (c ≫ a) x ∈ ι ⁻¹ᵁ V by change ι (a (c x)) ∈ V; rw [hxe]; exact hx) hx h
  rw [Scheme.Hom.germ_stalkMap_apply, ← e, hG, TopCat.Presheaf.germ_res_apply,
    Scheme.Hom.stalkMap_comp]
  rfl

/-- **The components of a reduced union of prime divisors.** If the closed subscheme
`ι : T ⟶ Y` lies in the union of prime divisors `Q_i`, each reached by `c_i : F_i ⟶ T` sending
the generic point of `F_i` to that of `Q_i`, every generic point of `T` is the image of the
generic point of some `F_i`. -/
private theorem exists_eq_of_mem_genericPoints {Y T : Scheme.{0}} (ι : T ⟶ Y)
    [IsClosedImmersion ι] {J : Type*} {F : J → Scheme.{0}} [∀ i, IrreducibleSpace (F i)]
    (c : ∀ i, F i ⟶ T) (Qs : J → Mori.PrimeDivisor Y)
    (hcov : Set.range ι.base ⊆ ⋃ i, ((Qs i).support : Set Y))
    (hc : ∀ i, ι (c i (genericPoint (F i))) = (Qs i).genericPoint) :
    ∀ y ∈ genericPoints T, ∃ i, c i (genericPoint (F i)) = y := by
  intro y hy
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov ⟨y, rfl⟩)
  refine ⟨i, ?_⟩
  have h1 : (Qs i).genericPoint ⤳ ι y := by
    rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hi
  rw [← hc i] at h1
  have h2 : c i (genericPoint (F i)) ⤳ y := ι.isClosedEmbedding.toIsInducing.specializes_iff.mp h1
  have hmax : IsMax y := Stacks.Chow.isMax_of_mem_genericPoints ⟨y, hy⟩
  have h3 : y ≤ c i (genericPoint (F i)) := Scheme.le_iff_specializes.mpr h2
  have h4 : y ⤳ c i (genericPoint (F i)) := Scheme.le_iff_specializes.mp (hmax h3)
  exact (h2.antisymm h4).eq

/-- A morphism of integral schemes sending the generic point to the generic point is dominant. -/
private theorem isDominant_of_map_genericPoint {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : X ⟶ Y) (h : f (genericPoint X) = genericPoint Y) : IsDominant f := by
  refine ⟨?_⟩
  rw [DenseRange, dense_iff_closure_eq]
  refine Set.eq_univ_of_univ_subset ?_
  have hc : closure ({genericPoint Y} : Set Y) = Set.univ := genericPoint_spec Y
  rw [← hc]
  exact closure_mono (by rintro _ rfl; exact ⟨_, h⟩)

/-- **The strict transform of a divisor maps birationally onto it.** If `g : W ⟶ Y` sends the
generic point of the prime divisor `E = j_E(E')` to that of `P = j_P(C)` and is an isomorphism of
local rings there, then `g` restricts to a dominant `E' ⟶ C` inducing an isomorphism of function
fields. -/
private theorem exists_lift_bijective_functionFieldMap {W Y E' C : Scheme.{0}} [IsIntegral E']
    [IsIntegral C] (g : W ⟶ Y) [QuasiCompact g] (E : Mori.PrimeDivisor W) (P : Mori.PrimeDivisor Y)
    (jE : E' ⟶ W) (jP : C ⟶ Y) [IsClosedImmersion jE] [IsClosedImmersion jP]
    (hEr : Set.range jE.base = (E.support : Set W))
    (hPr : Set.range jP.base = (P.support : Set Y))
    (hgen : g E.genericPoint = P.genericPoint) (hiso : IsIso (g.stalkMap E.genericPoint)) :
    ∃ gT : E' ⟶ C, ∃ _ : IsDominant gT, gT ≫ jP = jE ≫ g ∧
      Function.Bijective (functionFieldMap gT) := by
  have e1 := map_genericPoint_eq_of_range_eq jE E hEr
  have e2 := map_genericPoint_eq_of_range_eq jP P hPr
  have hsub : Set.range (jE ≫ g).base ⊆ Set.range jP.base := by
    rintro _ ⟨z₀, rfl⟩
    rw [hPr]
    have hz : jE z₀ ∈ (E.support : Set W) := hEr ▸ ⟨z₀, rfl⟩
    change g (jE z₀) ∈ (P.support : Set Y)
    generalize jE z₀ = z at hz
    have hz' : E.genericPoint ⤳ z := by
      rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hz
    have h2 := hz'.map g.continuous
    rw [hgen] at h2
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact specializes_iff_mem_closure.mp h2
  obtain ⟨gT, hgT⟩ := exists_comp_eq_of_range_subset jP (jE ≫ g) hsub
  have hgη : gT (genericPoint E') = genericPoint C := by
    apply jP.isClosedEmbedding.injective
    change (gT ≫ jP) (genericPoint E') = _
    rw [hgT, Scheme.Hom.comp_apply, e1, hgen, e2]
  haveI : IsDominant gT := isDominant_of_map_genericPoint gT hgη
  refine ⟨gT, inferInstance, hgT, (functionFieldMap gT).injective, ?_⟩
  haveI : IsIso (g.stalkMap (jE (genericPoint E'))) := by rw [e1]; exact hiso
  exact surjective_functionFieldMap_of_lift g jP jE gT hgT (by rw [e1, hgen, e2]) inferInstance
    (jE.stalkMap_surjective _)

/-- The pull-back of a regular function to the function field is the image of its pulled-back
germ. -/
private theorem functionFieldMap_germToFunctionField_eq {A B : Scheme.{0}} [IsIntegral A]
    [IsIntegral B] (g : A ⟶ B) [IsDominant g] {V : B.Opens} [Nonempty V] (h : Γ(B, V)) (x : A)
    (hx : g x ∈ V) :
    functionFieldMap g (B.germToFunctionField V h) =
      algebraMap _ A.functionField ((g.stalkMap x).hom (B.presheaf.germ V (g x) hx h)) := by
  have e : algebraMap _ A.functionField ((g.stalkMap x).hom
      ((B.presheaf.stalkSpecializes (specializes_refl (g x))).hom (B.presheaf.germ V (g x) hx h))) =
      functionFieldMap g (algebraMap _ B.functionField (B.presheaf.germ V (g x) hx h)) :=
    congrArg (fun φ => φ.hom (B.presheaf.germ V (g x) hx h))
      (stalkSpecializes_stalkMap_algebraMap g x (g x) (specializes_refl _))
  rw [TopCat.Presheaf.stalkSpecializes_refl] at e
  rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := B) hx h, ← e]
  rfl

/-- **Sections are multiples of a local generator.** If `ω` generates `𝒪_X(m(K + B))` on `U`,
every section `τ` of `𝒪_X(mK + ⌊mB⌋)` over a nonempty open `V ⊆ U` is `g ω` for a regular
function `g` on `V` (algebraic Hartogs). -/
private theorem exists_eq_germToFunctionField_smul {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {d : ℕ}
    (hd : topologicalKrullDim X = d) {B : QDivisor X} {m : ℕ} {U V : X.Opens} [Nonempty V]
    (hVU : V ≤ U) {ω : RationalPluriForms sX d m} (hω : GeneratesOn B m U ω)
    {τ : RationalPluriForms sX d m}
    (hτ : τ ∈ pluricanonicalSections sX d m (DivisorWithCoeffs.roundDown ((m : ℤ) • B)) V) :
    ∃ g : Γ(X, V), τ = X.germToFunctionField V g • ω := by
  obtain ⟨c, rfl⟩ := SteinCopy.exists_eq_smul_of_ne_zero hd hω.1 τ
  by_cases hc0 : c = 0
  · exact ⟨0, by rw [hc0, map_zero]⟩
  have hord : ∀ Γ : Mori.PrimeDivisor X, (Γ.support ∩ V).Nonempty →
      0 ≤ X.ord c Γ.genericPoint := by
    intro Γ hΓ
    have hne : c • ω ≠ 0 := smul_ne_zero hc0 hω.1
    have h1 := hτ.2 Γ hΓ hne
    rw [Mori.PrimeDivisor.ordForm_smul_of_topologicalKrullDim_eq Γ hd hc0 hω.1] at h1
    obtain ⟨y, hyΓ, hyV⟩ := hΓ
    have h2 := hω.2 Γ ⟨y, hyΓ, hVU hyV⟩
    have h3 : ((DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ : ℚ) = -(Γ.ordForm ω : ℚ) := by
      rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
      have : ((m : ℤ) : ℚ) * B.coeff Γ = -(Γ.ordForm ω : ℚ) := by push_cast; linarith
      rw [this]
      exact_mod_cast Int.floor_intCast (-(Γ.ordForm ω))
    have h4 : (DivisorWithCoeffs.roundDown ((m : ℤ) • B)).coeff Γ = -(Γ.ordForm ω) := by
      exact_mod_cast h3
    omega
  obtain ⟨g, hg⟩ := MMP.Threefold.Bridges.exists_germToFunctionField_eq_of_forall_zero_le_ord V c hord
  exact ⟨g, by rw [hg]⟩

/-- The pull-back of the image of a section in the function field is the image of its pull-back. -/
private theorem functionFieldMap_germToFunctionField_app {A B : Scheme.{0}} [IsIntegral A]
    [IsIntegral B] (g : A ⟶ B) [IsDominant g] {V : B.Opens} [Nonempty V] [Nonempty (g ⁻¹ᵁ V)]
    (h : Γ(B, V)) :
    functionFieldMap g (B.germToFunctionField V h) = A.germToFunctionField (g ⁻¹ᵁ V) (g.app V h) := by
  obtain ⟨⟨x, hx⟩⟩ := (inferInstance : Nonempty (g ⁻¹ᵁ V))
  rw [functionFieldMap_germToFunctionField_eq g h x hx, Scheme.Hom.germ_stalkMap_apply g V x hx h,
    Scheme.algebraMap_germ_eq_germToFunctionField]

/-- The image of a section in the function field does not change under restriction. -/
private theorem germToFunctionField_map_homOfLE {X : Scheme.{0}} [IsIntegral X] {U V : X.Opens}
    [Nonempty U] [Nonempty V] (hVU : V ≤ U) (s : Γ(X, U)) :
    X.germToFunctionField V (X.presheaf.map (homOfLE hVU).op s) = X.germToFunctionField U s := by
  obtain ⟨⟨x, hx⟩⟩ := (inferInstance : Nonempty V)
  rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hx
    (X.presheaf.map (homOfLE hVU).op s), TopCat.Presheaf.germ_res_apply,
    Scheme.algebraMap_germ_eq_germToFunctionField]

/-- **A function without zeros along prime divisors is a unit** on a normal integral locally
Noetherian scheme (algebraic Hartogs). -/
private theorem isUnit_germ_of_ord_eq_zero {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {V : X.Opens} [Nonempty V] (g : Γ(X, V)) (hg0 : X.germToFunctionField V g ≠ 0)
    (hord : ∀ Γ : Mori.PrimeDivisor X, (Γ.support ∩ V).Nonempty →
      X.ord (X.germToFunctionField V g) Γ.genericPoint = 0) (y : X) (hy : y ∈ V) :
    IsUnit (X.presheaf.germ V y hy g) := by
  obtain ⟨k, hk⟩ := MMP.Threefold.Bridges.exists_germToFunctionField_eq_of_forall_zero_le_ord V
    (X.germToFunctionField V g)⁻¹ fun Γ hΓ => by
      have h1 := Scheme.ord_mul (x := Γ.genericPoint) hg0 (inv_ne_zero hg0)
      rw [mul_inv_cancel₀ hg0, AlgebraicGeometry.ord_one', hord Γ hΓ] at h1
      omega
  have hgk : g * k = 1 := by
    apply Scheme.germToFunctionField_injective X V
    rw [map_mul, hk, mul_inv_cancel₀ hg0, map_one]
  exact (IsUnit.of_mul_eq_one k hgk).map _

/-- Cancellation of a nonzero vector in a vector space. -/
private theorem smul_left_cancel_of_ne_zero {K M : Type*} [Field K] [AddCommGroup M] [Module K M]
    {x : M} (hx : x ≠ 0) {a b : K} (h : a • x = b • x) : a = b := by
  by_contra hab
  apply hx
  have h2 : (a - b) • x = 0 := by rw [sub_smul, h, sub_self]
  have h3 := congrArg (fun y => (a - b)⁻¹ • y) h2
  simpa [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hab)] using h3

end TwoFloorTransport

section Steps

variable {I : Type u} {X : I → Scheme.{0}} [∀ i, IsIntegral (X i)]
    [∀ i, IsLocallyNoetherian (X i)] [∀ i, IsNormal (X i)]
    {sX : ∀ i, X i ⟶ Spec (.of ℂ)} {B : ∀ i, QDivisor (X i)}
    {Sf : (Σ i, {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}) → Scheme.{0}}
    [∀ j, IsIntegral (Sf j)] [∀ j, IsLocallyNoetherian (Sf j)] [∀ j, IsNormal (Sf j)]
    {jf : ∀ j, Sf j ⟶ X j.1} {BSf : ∀ j, QDivisor (Sf j)}

variable (sX B jf BSf) in
/-- `σ`, a section of `N(K_{X_i} + B_i)`, lifts the `c`-th power of the floor system `u`
(in degree `m`): along every floor `j_{i,P}`, if `u_{i,P} = f · ω^{⊗m}` then the Poincaré
residue of `σ` is `f^c · ω^{⊗N}`; this is meant for `N = cm`. -/
private def LiftsPow (i : I) (m c N : ℕ) (σ : RationalPluriForms (sX i) 3 (N : ℤ))
    (u : ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)) : Prop :=
  ∀ P : {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0},
    letI := functionFieldAlgebra (jf ⟨i, P⟩ ≫ sX i)
    ∀ (ω : ⋀[(Sf ⟨i, P⟩).functionField]^2 Ω[(Sf ⟨i, P⟩).functionField⁄ℂ])
      (f : (Sf ⟨i, P⟩).functionField),
      ((u ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
          RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m) =
          f • (formPow ω m : RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m) →
        IsPoincareResidue (sX i) (jf ⟨i, P⟩) 2 N σ
          (f ^ c • (formPow ω N : RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 (N : ℤ)))

variable [Finite I]
    (hX : ∀ i, Mori.IsProjectiveVariety ℂ (sX i))
    (hdim : ∀ i, topologicalKrullDim (X i) = 3) (hQ : ∀ i, IsQFactorial (sX i))
    (hB : ∀ i, IsPair (sX i) (B i))
    (hdlt : ∀ i, MMP.Intersection.IsDltPair (sX i) (B i)) {K : ∀ i, Divisor (X i)}
    (hK : ∀ i, (K i).IsCanonicalDivisor (sX i) 3)
    (hsemi : ∀ i, QDivisor.IsRelativelySemiample (sX i) (Divisor.toQDivisor (K i) + B i))
    (hSf : ∀ j, IsAdjunctionStep (sX j.1) (B j.1) (jf j) (BSf j) ∧
      Set.range (jf j).base = (j.2.1.support : Set (X j.1)))

/-- **A finite generating family.** If admissible floor systems generate every floor at every
point, finitely many of them do. -/
private theorem exists_finite_generating_family {m : ℕ}
    (Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m)
    (hgen : ∀ j (y : Sf j), ∃ t ∈ admissibleSections Rf, ∃ V : (Sf j).Opens, y ∈ V ∧
      GeneratesOn (BSf j) m V
        ((t j : logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)) :
          RationalPluriForms (jf j ≫ sX j.1) 2 m)) :
    ∃ (A : Type u) (_ : Finite A)
      (t : A → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
      (∀ α, t α ∈ admissibleSections Rf) ∧
      ∀ j (y : Sf j), ∃ α, ∃ V : (Sf j).Opens, y ∈ V ∧
        GeneratesOn (BSf j) m V
          ((t α j : logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)) :
            RationalPluriForms (jf j ≫ sX j.1) 2 m) := by
  classical
  haveI := Rf.setting.finite
  have hcpt : ∀ j, CompactSpace (Sf j) := fun j => by
    haveI := (Rf.setting.isProjectiveVariety j).toIsVariety
    exact QuasiCompact.compactSpace_of_compactSpace (jf j ≫ sX j.1)
  choose t ht V hyV hV using hgen
  have hfin : ∀ j, ∃ F : Finset (Sf j),
      ⋃ y ∈ F, ((V j y : (Sf j).Opens) : Set (Sf j)) = Set.univ := fun j =>
    CompactSpace.elim_nhds_subcover _ fun y => (V j y).isOpen.mem_nhds (hyV j y)
  choose F hF using hfin
  refine ⟨Σ j, F j, inferInstance, fun α => t α.1 α.2, fun α => ht _ _, fun j y => ?_⟩
  have hy : y ∈ ⋃ y ∈ F j, ((V j y : (Sf j).Opens) : Set (Sf j)) := (hF j).symm ▸ Set.mem_univ y
  obtain ⟨y₀, hy₀, hy⟩ := Set.mem_iUnion₂.1 hy
  exact ⟨⟨j, ⟨y₀, hy₀⟩⟩, V j y₀, hy, hV j y₀⟩

include hX hdim hSf in
/-- **Powers of lifts.** For `σ ∈ H⁰(N(K_{X_i} + B_i))` and `b > 0`, the power
`σ^b ∈ H⁰(bN(K_{X_i} + B_i))` lifts `u^{bc}` whenever `σ` lifts `u^c`, generates wherever `σ`
does, and has zero floor residues if `σ` does. -/
private theorem exists_pow (i : I) {N : ℕ} {σ : RationalPluriForms (sX i) 3 (N : ℤ)}
    (hσ : σ ∈ logPluricanonicalSections (sX i) 3 N (B i)) {b : ℕ} (hb : 0 < b) :
    ∃ σ' ∈ logPluricanonicalSections (sX i) 3 (b * N) (B i),
      (∀ m c u, LiftsPow sX B jf BSf i m c N σ u → LiftsPow sX B jf BSf i m (b * c) (b * N) σ' u) ∧
      (∀ V : (X i).Opens, GeneratesOn (B i) N V σ → GeneratesOn (B i) (b * N) V σ') := by
  haveI : LocallyOfFiniteType (sX i) := (hX i).1.toLocallyOfFiniteType
  have hY : topologicalKrullDim (X i) = ((2 + 1 : ℕ) : WithBot ℕ∞) := by rw [hdim i]; rfl
  induction b, hb using Nat.le_induction with
  | base =>
    rw [show Nat.succ 0 * N = N by simp]
    exact ⟨σ, hσ, fun _ _ _ h => by simpa using h, fun _ h => h⟩
  | succ b hb ih =>
    obtain ⟨σ', hσ', h1, h2⟩ := ih
    rw [Nat.succ_mul]
    refine ⟨RationalPluriForms.mul (sX i) 3 (b * N) N σ' σ,
      mul_mem_logPluricanonicalSections hσ' hσ, ?_, fun V hV => GeneratesOn.mul (hdim i) (h2 V hV) hV⟩
    intro m c u hu P ω f hf
    rw [Nat.succ_mul]
    have := IsPoincareResidue.mul (hSf ⟨i, P⟩).1 hY (h1 m c u hu P ω f hf) (hu P ω f hf)
    rwa [RationalPluriForms.mul_smul_formPow, ← pow_add] at this

include hX hdim hSf in
/-- **Powers of lifts, in degree `cm`.** If `σ ∈ H⁰(am(K_{X_i} + B_i))` and `a ∣ c`, some
`σ' ∈ H⁰(cm(K_{X_i} + B_i))` lifts `u^c` whenever `σ` lifts `u^a`, generates wherever `σ` does,
and has zero residues if `σ` does. -/
private theorem exists_pow_of_dvd (i : I) {m a c : ℕ} (ha : 0 < a) (hac : a ∣ c)
    (hc : 0 < c) {σ : RationalPluriForms (sX i) 3 ((a * m : ℕ) : ℤ)}
    (hσ : σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i)) :
    ∃ σ' ∈ logPluricanonicalSections (sX i) 3 (c * m) (B i),
      (∀ u, LiftsPow sX B jf BSf i m a (a * m) σ u → LiftsPow sX B jf BSf i m c (c * m) σ' u) ∧
      (∀ V : (X i).Opens, GeneratesOn (B i) (a * m) V σ → GeneratesOn (B i) (c * m) V σ') := by
  obtain ⟨b, rfl⟩ := hac
  have hb : 0 < b := Nat.pos_of_mul_pos_left hc
  obtain ⟨σ', hσ', h1, h2⟩ := exists_pow hX hdim hSf i hσ hb
  have e : b * (a * m) = a * b * m := by ring
  revert σ'
  rw [e]
  intro σ' hσ' h1 h2
  exact ⟨σ', hσ', fun u hu => by simpa only [mul_comm b a] using h1 m a u hu, h2⟩

omit [∀ j, IsLocallyNoetherian (Sf j)] [∀ j, IsNormal (Sf j)] in
/-- A tensor power `ω^{⊗m}` of a vector `ω` vanishes only if `ω` does. -/
private theorem eq_zero_of_formPow_eq_zero {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    {ω : V} {m : ℕ} (h : (PiTensorProduct.tprod K fun _ : Fin m => ω) = 0) : ω = 0 := by
  by_contra hω
  obtain ⟨φ, hφ⟩ := Module.Projective.exists_dual_eq_one K hω
  have := congrArg (PiTensorProduct.lift
    ((MultilinearMap.mkPiAlgebra K (Fin m) K).compLinearMap fun _ => φ)) h
  simp [hφ] at this

/-- The residue restriction structure of the floors of all components, restricted to the floors
of the component `X_i`. -/
private def restrictFloor {m : ℕ} (Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m)
    (i : I) :
    ResidueRestriction
      (fun P : {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0} => jf ⟨i, P⟩ ≫ sX i)
      (fun P => BSf ⟨i, P⟩) 2 m where
  setting :=
    { finite := by
        haveI := Rf.setting.finite
        exact Finite.of_injective
          (fun P : {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0} =>
            (⟨i, P⟩ : Σ i, {P : Mori.PrimeDivisor (X i) // ⌊(B i).coeff P⌋ ≠ 0}))
          fun _ _ h => eq_of_heq (Sigma.mk.inj h).2
      isProjectiveVariety := fun P => Rf.setting.isProjectiveVariety ⟨i, P⟩
      isPair := fun P => Rf.setting.isPair ⟨i, P⟩
      isDltPair := fun P => Rf.setting.isDltPair ⟨i, P⟩
      topologicalKrullDim_eq := fun P => Rf.setting.topologicalKrullDim_eq ⟨i, P⟩
      even := Rf.setting.even
      pos := Rf.setting.pos
      isCartierDivisor := fun P => Rf.setting.isCartierDivisor ⟨i, P⟩ }
  toFun P := Rf.toFun ⟨i, P⟩
  isIteratedResidue P := Rf.isIteratedResidue ⟨i, P⟩

/-- Admissible floor systems restrict to admissible systems on the floors of one component. -/
private theorem mem_admissibleSections_restrictFloor {m : ℕ}
    {Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m}
    {t : ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)}
    (ht : t ∈ admissibleSections Rf) (i : I) :
    (fun P => t ⟨i, P⟩) ∈ admissibleSections (restrictFloor Rf i) :=
  fun P P' _ _ _ _ _ _ F F' e h₁ h₂ h₃ h₄ σ hσ => ht ⟨i, P⟩ ⟨i, P'⟩ F F' e h₁ h₂ h₃ h₄ σ hσ

include hX hdim hQ hB hdlt hK hsemi hSf in
/-- **Lifting through a floor with the structure-sheaf property.** Let `f : X_i ⟶ R` be the
semiample contraction of `K_{X_i} + B_i`, and suppose the reduced floor `S` of `X_i` satisfies
`f_* 𝒪_S = 𝒪_V` for its reduced image `V`. Then the lifting and generation statement holds on
`X_i`, by `MMP.Fourfold.exists_isPoincareResidue_pow_of_mem_admissibleSections`. -/
private theorem exists_liftsPow_of_isIso_app_floor (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    {S : Scheme.{0}} (ιS : S ⟶ X i) [IsClosedImmersion ιS] [IsReduced S]
    (hS : Set.range ιS.base = ⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i)))
    {V : Scheme.{0}} (ιV : V ⟶ R) [IsClosedImmersion ιV] [IsReduced V]
    (hV : Set.range ιV.base = f.base '' Set.range ιS.base)
    (fS : S ⟶ V) (hfS : fS ≫ ιV = ιS ≫ f) (hfSO : ∀ U : V.Opens, IsIso (fS.app U)) :
    ∃ k : ℕ, 0 < k ∧ ∀ m : ℕ, k ∣ m →
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
      ∀ {A : Type*} [Finite A]
        (t : A → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
        (∀ α, t α ∈ admissibleSections Rf) →
        (∀ P (y : Sf ⟨i, P⟩), ∃ α, ∃ V : (Sf ⟨i, P⟩).Opens, y ∈ V ∧
          GeneratesOn (BSf ⟨i, P⟩) m V
            ((t α ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
              RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m)) →
        ∃ a : ℕ, 0 < a ∧
          (∀ α, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            LiftsPow sX B jf BSf i m a (a * m) σ (t α)) ∧
          ∀ x : X i, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            ∃ V : (X i).Opens, x ∈ V ∧ GeneratesOn (B i) (a * m) V σ ∧
              (LiftsPow sX B jf BSf i m a (a * m) σ 0 ∨
                ∃ α, LiftsPow sX B jf BSf i m a (a * m) σ (t α)) := by
  classical
  obtain ⟨cX, hcX0, hcX⟩ := exists_residueRestriction (I := Unit) (X := fun _ => X i)
    (sX := fun _ => sX i) (fun _ => hX i) (fun _ => hdim i) (fun _ => hB i) (fun _ => hdlt i)
  refine ⟨k * cX, Nat.mul_pos hk hcX0, fun m hm Rf A _ t ht hgen => ?_⟩
  have hm0 : 0 < m := Rf.setting.pos
  have hev : Even m := Rf.setting.even
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin A
  let t' : Fin n → ∀ P, logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩) :=
    fun β P => t (e.symm β) ⟨i, P⟩
  have ht' : ∀ β, t' β ∈ admissibleSections (restrictFloor Rf i) := fun β =>
    mem_admissibleSections_restrictFloor (ht (e.symm β)) i
  have hd : topologicalKrullDim (X i) = ((2 + 1 : ℕ) : WithBot ℕ∞) := by rw [hdim i]; rfl
  obtain ⟨a, ha, h1, h2⟩ := exists_isPoincareResidue_pow_of_mem_admissibleSections (hX i) hd
    (hQ i) (hB i) (hdlt i) (hK i) (hsemi i) hRn hRp f hf hfp hfO hk hH hHamp hM hMeq hS0 ιS hS
    ιV hV fS hfS hfSO (fun P => Sf ⟨i, P⟩) (fun P => jf ⟨i, P⟩) (fun P => BSf ⟨i, P⟩)
    (fun P => hSf ⟨i, P⟩) hev ((dvd_mul_right k cX).trans hm) (restrictFloor Rf i) t' ht'
  obtain ⟨RX⟩ := hcX (a * m) (Nat.mul_pos ha hm0)
    (Dvd.dvd.mul_left ((dvd_mul_left cX k).trans hm) a) (hev.mul_left a)
  refine ⟨a, ha, fun α => ?_, fun x => ?_⟩
  · obtain ⟨s, -, hres⟩ := h1 RX (e α)
    refine ⟨s (), (s ()).2, fun P ω c hc => hres P ω c ?_⟩
    simpa [t'] using hc
  · obtain ⟨σ, hσ, U, hxU, hgU, hcase⟩ := h2 (fun P y => by
      obtain ⟨α, W, hyW, hW⟩ := hgen P y
      exact ⟨e α, W, hyW, by simpa [t'] using hW⟩) x
    refine ⟨σ, hσ, U, hxU, hgU, ?_⟩
    rcases hcase with hz | ⟨β, hβ⟩
    · left
      intro P
      letI := functionFieldAlgebra (jf ⟨i, P⟩ ≫ sX i)
      intro ω c hc
      have h0 : c ^ a • (formPow ω (a * m) :
          RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 ((a * m : ℕ) : ℤ)) = 0 := by
        have hc' : c • (formPow ω m : RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m) = 0 := by
          rw [← hc]; rfl
        rcases smul_eq_zero.1 hc' with hc0 | hω
        · rw [hc0, zero_pow ha.ne', zero_smul]
        · have hω0 : ω = 0 := eq_zero_of_formPow_eq_zero hω
          subst hω0
          haveI : Nonempty (Fin (a * m)) := ⟨⟨0, Nat.mul_pos ha hm0⟩⟩
          rw [show (formPow (0 : ⋀[(Sf ⟨i, P⟩).functionField]^2
              Ω[(Sf ⟨i, P⟩).functionField⁄ℂ]) (a * m) :
                RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 ((a * m : ℕ) : ℤ)) = 0 from
            (PiTensorProduct.tprod _).map_coord_zero (⟨0, Nat.mul_pos ha hm0⟩ : Fin (a * m)) rfl,
            smul_zero]
      rw [h0]
      exact hz P
    · exact Or.inr ⟨e.symm β, fun P ω c hc => hβ P ω c (by simpa [t'] using hc)⟩

include hX hdim hK hsemi in
/-- **The semiample contraction.** The semiample adjoint `D = K_{X_i} + B_i` defines a contraction
`f : X_i ⟶ R` onto a normal projective variety, `f_* 𝒪_{X_i} = 𝒪_R`, with `kD ∼_ℚ f^*H` for an
ample Cartier divisor `H` on `R`. -/
private theorem exists_semiampleContraction (i : I) [CompactSpace (X i)] :
    ∃ (R : Scheme.{0}) (_ : IsIntegral R) (_ : CompactSpace R) (_ : IsLocallyNoetherian R)
      (_ : IsNormal R) (sR : R ⟶ Spec (.of ℂ)), IsNormalVariety ℂ sR ∧
      Mori.IsProjectiveVariety ℂ sR ∧ ∃ f : X i ⟶ R, f ≫ sR = sX i ∧ IsProjectiveMorphism f ∧
      (∀ U : R.Opens, IsIso (f.app U)) ∧ ∃ k : ℕ, 0 < k ∧ ∃ (H : Divisor R) (hH : H.IsCartier),
      H.IsRelativelyAmple sR hH ∧ ∃ M : Divisor (X i), (∃ hfH, H.IsPullback f hfH M) ∧
      (Divisor.toQDivisor M).QLinearlyEquivalent ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)) := by
  classical
  haveI : LocallyOfFiniteType (sX i) := (hX i).toLocallyOfFiniteType
  haveI : IsNoetherian (X i) := ⟨⟩
  have hXn : IsNormalVariety ℂ (sX i) := ⟨(hX i).toIsVariety, inferInstance⟩
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ (sX i) := hX i
  haveI : AlgebraicGeometry.IsVariety ℂ (sX i) := (hX i).toIsVariety
  haveI : IsProper (sX i) := isProper_of_isProjectiveMorphism _ (hX i).isProjective
  obtain ⟨C, hC, q, hq, hint, hfree⟩ := hsemi i
  set Lc : (X i).CartierDivisor := KCartierDivisor.realization ((q : ℚ) • C) hint
  obtain ⟨w, hw⟩ := exists_isWeilDivisorOfCartier Lc
  have hwq : Divisor.toQDivisor w = (q : ℚ) • (Divisor.toQDivisor (K i) + B i) := by
    ext P
    rw [Divisor.coeff_toQDivisor, coeff_eq_mul_of_isWeilDivisorOfCartier_realization hC hint hw P]
    simp [DivisorWithCoeffs.coeff_apply]
    ring
  haveI : AlgebraicGeometry.IsVariety ℂ (𝟙 (Spec (.of ℂ))) := ⟨⟩
  have key := IsRelativelyFreeCartier.steinFactor_isRelativelyAmpleCartier (sX i) (𝟙 _) hXn
    (inferInstance : AlgebraicGeometry.IsVariety ℂ (𝟙 (Spec (.of ℂ)))) (sX i)
    (Category.comp_id (sX i)) Lc hfree
  dsimp only at key
  obtain ⟨⟨Φ, hΦ, e, hdef⟩, hall⟩ := key
  obtain ⟨hΦp, hall⟩ := hall Φ hΦ e hdef
  haveI : ((Scheme.Modules.pushforward (sX i)).obj
      (MMP.CartierDivisor.sheaf Lc)).IsQuasicoherent :=
    ProperCoherentFiniteType.isQuasicoherent_pushforward (sX i) _ inferInstance
  haveI : ((Scheme.Modules.pushforward (sX i)).obj
      (MMP.CartierDivisor.sheaf Lc)).IsFiniteType :=
    (AlgebraicGeometry.ProperCoherenceWitness.isCoherent_pushforward (sX i)
      (MMP.CartierDivisor.sheaf Lc)).isFiniteType
  obtain ⟨Z, sZ, c, hZ, hcomp, _, _, _, _, _, _, hcapp, A, hA, ⟨eM⟩⟩ :=
    exists_steinFactor (sX i) Lc _ (isProper_relativeProj_toBase _) Φ hΦ fun YL ρ τ hS => by
      obtain ⟨h1, h2, h3, i1, i2, i3, A, hA, -, hM⟩ := hall YL ρ τ hS
      exact ⟨h1, h2, h3, i1, i2, i3, A, hA, hM⟩
  haveI : IsQuasiProjectiveVariety ℂ (sX i) := IsProjectiveVariety.isQuasiProjectiveVariety ℂ (sX i)
  haveI : AlgebraicGeometry.IsVariety ℂ sZ := hZ.1
  haveI : IsIntegral Z := hZ.1.toIsIntegral
  have hcproj : IsProjectiveMorphism c :=
    MMP.isProjectiveMorphism_of_isProper_of_isQuasiProjectiveVariety (sX i) sZ c hcomp
  haveI := hA.1.isInvertibleModule_divisorialSheaf
  have hAamp := isRelativelyAmple_of_isRelativelyAmpleCartier hA
  have hZproj : IsProjective sZ :=
    MMP.isProjective_of_isProper_of_isRelativelyAmple sZ A.divisorialSheaf hAamp
  have hZp : Mori.IsProjectiveVariety ℂ sZ :=
    (isProjectiveVariety_iff_isProjective' ℂ sZ).mpr ⟨inferInstance, hZproj⟩
  -- the generic point of `X_i` maps outside the support of `A`
  have hgen : ∀ Zc : irreducibleComponents (X i), c (componentGenericPoint (X i) Zc) ∉ A.supp :=
    MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant c A
  obtain ⟨M, hM⟩ := hA.1.exists_isPullback hgen
  refine ⟨Z, inferInstance, inferInstance, inferInstance, inferInstance, sZ, hZ, hZp, c, hcomp,
    hcproj, hcapp, q, hq, A, hA.1, hAamp, M, ⟨hgen, hM⟩, ?_⟩
  obtain ⟨ew⟩ := hw.nonempty_sheaf_iso_divisorialSheaf
  have e1 : w.divisorialSheaf ≅ M.divisorialSheaf :=
    ew.symm ≪≫ eM ≪≫ (Divisor.IsPullback.divisorialSheafIso (hBc := hA.1) hM).symm
  have hlin : w.LinearlyEquivalent M := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso e1
  rw [← hwq]
  exact hlin.symm.qLinearlyEquivalent

include hX hdim hQ hB hdlt hK in
/-- **The vertical floor.** If the floor of `X_i` does not map onto the base `R` of the semiample
contraction, then its reduced image `V` satisfies `f_* 𝒪_S = 𝒪_V`
(`MMP.Fourfold.isIso_app_toImage_suppScheme_of_isDltPair_of_qLinearlyEquivalent`). -/
private theorem exists_isIso_app_floor_of_ne_univ (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hne : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) ≠ Set.univ) :
    ∃ (S : Scheme.{0}) (ιS : S ⟶ X i) (_ : IsClosedImmersion ιS) (_ : IsReduced S),
      Set.range ιS.base = ⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i)) ∧
      ∃ (V : Scheme.{0}) (ιV : V ⟶ R) (_ : IsClosedImmersion ιV) (_ : IsReduced V),
        Set.range ιV.base = f.base '' Set.range ιS.base ∧
        ∃ fS : S ⟶ V, fS ≫ ιV = ιS ≫ f ∧ ∀ U : V.Opens, IsIso (fS.app U) := by
  classical
  haveI : LocallyOfFiniteType (sX i) := (hX i).toLocallyOfFiniteType
  haveI : Mori.IsProjectiveVariety ℂ (sX i) := hX i
  haveI : Mori.IsProjectiveVariety ℂ sR := hRp
  haveI : IsProper f := isProper_of_isProjectiveMorphism _ hfp
  have hdltM : MMP.Mori.IsDltPair (sX i) 3 (K i) (B i) :=
    (MMP.Threefold.Bridges.isDltPair_iff_isDltPair (sX i) (hK i) (B i)).1 (hdlt i)
  obtain ⟨hfH, hMH⟩ := hM
  set H' : QDivisor R := (k : ℚ)⁻¹ • Divisor.toQDivisor H with hH'def
  have hk0 : (k : ℚ) ≠ 0 := by exact_mod_cast hk.ne'
  have hHk : Divisor.toQDivisor H = ((k : ℕ) : ℤ) • H' := by
    ext P
    simp only [hH'def, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul, smul_eq_mul]
    field_simp
    push_cast
    ring
  have hH'q : H'.IsQCartier := ⟨(k : ℤ), by exact_mod_cast hk.ne', H, hHk, hH⟩
  have hB' : ∀ Z : irreducibleComponents (X i), f (componentGenericPoint (X i) Z) ∉ H'.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hk.ne') hHk]
    exact hfH Z
  obtain ⟨HX, hHX, -⟩ := hH'q.existsUnique_isPullback hB'
  have hMHX : Divisor.toQDivisor M = (k : ℚ) • HX := by
    obtain ⟨D', hD', hD'p⟩ := hHX k hk H hHk hH
    have : D' = M := Divisor.IsPullback.eq hH hD'p hMH
    rw [← this, hD']
    ext P
    simp [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul, nsmul_eq_mul]
  have hKB : (Divisor.toQDivisor (K i) + B i).QLinearlyEquivalent HX := by
    refine qLinearlyEquivalent_of_smul hk ?_
    rw [← hMHX]
    exact hMeq.symm
  set ιS := (B i).roundDown.suppIdeal.subschemeι with hιS
  have hrS : Set.range ιS.base = ⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i)) := by
    rw [hιS, Scheme.IdealSheafData.range_subschemeι, DivisorWithCoeffs.coe_support_suppIdeal,
      DivisorWithCoeffs.coe_supp]
  have hrange : Set.range (ιS ≫ f).base = f.base '' Set.range ιS.base := by
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp]
  have hV : Set.range (ιS ≫ f).base ≠ Set.univ := by
    rw [hrange, hrS]
    exact hne
  have key := isIso_app_toImage_suppScheme_of_isDltPair_of_qLinearlyEquivalent (sX i) sR f hf hfp
    hfO (K i) (B i) hdltM (hQ i) H' hH'q HX ⟨hB', hHX⟩ hKB hV
  have hclosed : IsClosed (f.base '' Set.range ιS.base) := by
    rw [hrS, ← DivisorWithCoeffs.coe_supp]
    exact f.isClosedMap _ (DivisorWithCoeffs.isClosed_supp _)
  haveI hSred : IsReduced (B i).roundDown.suppIdeal.subscheme := by
    unfold DivisorWithCoeffs.suppIdeal
    exact Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal _
  refine ⟨_, ιS, inferInstance, hSred, hrS,
    _, (ιS ≫ f).imageι, inferInstance, Scheme.Hom.isReduced_image _, ?_, (ιS ≫ f).toImage,
    Scheme.Hom.toImage_imageι _, key⟩
  rw [Scheme.Hom.range_imageι, hrange, hclosed.closure_eq]

include hX hdim hQ hdlt in
/-- **Lowering the floor.** For a `ℚ`-factorial dlt pair `(X_i, B_i)` the lowered pair
`(X_i, B_i - ½⌊B_i⌋)` is dlt. -/
private theorem isDltPair_sub_half_roundDown (i : I) :
    MMP.Intersection.IsDltPair (sX i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown) := by
  have hc : ∀ P, 0 ≤ (B i).coeff P ∧ (B i).coeff P ≤ 1 := fun P => ⟨(hdlt i).1.2.1 P, (hdlt i).2.1 P⟩
  refine MMP.Intersection.IsDltPair.of_le (sX i) (hdlt i) (fun P => ?_) (fun P => ?_) ?_
  · obtain ⟨h0, h1⟩ := hc P
    change (0 : ℚ) ≤ (B i).coeff P - (1 / 2 : ℚ) * ((⌊(B i).coeff P⌋ : ℤ) : ℚ)
    rcases eq_or_lt_of_le h1 with h | h
    · rw [h]; norm_num
    · rw [Int.floor_eq_zero_iff.2 ⟨h0, h⟩]; simpa using h0
  · obtain ⟨h0, -⟩ := hc P
    change (B i).coeff P - (1 / 2 : ℚ) * ((⌊(B i).coeff P⌋ : ℤ) : ℚ) ≤ (B i).coeff P
    have : (0 : ℤ) ≤ ⌊(B i).coeff P⌋ := Int.floor_nonneg.2 h0
    have : (0 : ℚ) ≤ ((⌊(B i).coeff P⌋ : ℤ) : ℚ) := by exact_mod_cast this
    linarith
  · obtain ⟨m, hm, hmc⟩ := (hQ i).2 (B i).roundDown
    refine ⟨2 * m, by positivity, (m : ℤ) • (B i).roundDown, ?_, hmc⟩
    ext P
    simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor,
      zsmul_eq_mul, smul_eq_mul]
    push_cast
    ring

include hX hdim hQ hB hdlt hK hsemi hSf in
/-- **No nef endpoint.** When the floor of `X_i` maps onto the base `R` of the semiample
contraction, a projective program over `R` for the lowered pair `(X_i, B_i - ½⌊B_i⌋)` does not
end with a model whose lowered adjoint is nef over `R`: since `K + B` is pulled back from `R`,
that would make `-⌊B_n⌋` nef over `R`, impossible on the generic fibre, which meets the floor in a
nonzero effective divisor. -/
private theorem not_isRelativelyNef_of_image_eq_univ (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    (heq : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ)
    (P : RelativeDltProgram (sX i) sR f (K i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown)) (hPp : P.IsProjective) (hPn : P.n ≠ ⊤) :
    ¬ MMP.Flips.IsRelativelyNef ℂ (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat)
      (QDivisor.toRDivisor (Divisor.toQDivisor (divisorSeq (K i) P.KY P.n.toNat) +
        divisorSeq (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown) P.BY P.n.toNat)) := by
  have hEη : ∃ E : MMP.Mori.PrimeDivisor (X i),
      0 < (Divisor.toQDivisor (B i).roundDown).coeff E ∧ f E.genericPoint = genericPoint R := by
    have hη : genericPoint R ∈
        f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) := by
      rw [heq]; trivial
    obtain ⟨x, hx, hxη⟩ := hη
    simp only [Set.mem_iUnion] at hx
    obtain ⟨E, hE, hxE⟩ := hx
    refine ⟨E, ?_, ?_⟩
    · have h1 : (B i).roundDown.coeff E ≠ 0 := by
        rw [MMP.Mori.DivisorWithCoeffs.coeff_apply]; exact Finsupp.mem_support_iff.mp hE
      have h2 : 0 ≤ (B i).roundDown.coeff E := by
        rw [DivisorWithCoeffs.coeff_roundDown]; exact Int.floor_nonneg.mpr ((hdlt i).1.2.1 E)
      rw [Divisor.coeff_toQDivisor]
      exact_mod_cast lt_of_le_of_ne h2 (Ne.symm h1)
    · have hsp : E.genericPoint ⤳ x := by
        rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact hxE
      have h3 := hsp.map f.continuous
      change f E.genericPoint ⤳ f.base x at h3
      rw [hxη] at h3
      have h4 : IsGenericPoint (f E.genericPoint) (⊤ : Set R) :=
        isGenericPoint_iff_specializes.mpr fun y =>
          ⟨fun _ => trivial, fun _ => h3.trans ((genericPoint_spec R).specializes trivial)⟩
      exact h4.eq (genericPoint_spec R)
  haveI : IsDominant f := isDominant_of_forall_isIso_app f hfO
  exact not_isRelativelyNef_endpoint (hX i) (hQ i) (hK i) (hdlt i) hRp f hf hk hH hM hMeq hEη P
    hPp hPn

include hX hdim hQ hB hdlt hK hsemi hSf in
/-- **The floor structure sheaf is a crepant invariant.** Along a projective program over `R` for
`(X_i, B_i - ½⌊B_i⌋)`, if the reduced floor `T` of the final model `Y` satisfies
`(π_Y)_* 𝒪_T = 𝒪_R`, then the reduced floor `S` of `X_i` satisfies `f_* 𝒪_S = 𝒪_R`: on a common
log resolution with the common crepant boundary, the reduced coefficient-one part has structure
sheaf pushing forward to both `𝒪_S` and `𝒪_T`. -/
private theorem isIso_app_floor_of_isIso_app_endpoint (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    (heq : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ)
    (P : RelativeDltProgram (sX i) sR f (K i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown)) (hPp : P.IsProjective) (hPn : P.n ≠ ⊤)
    (hY : ∀ U : R.Opens, IsIso (((DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).suppIdeal.subschemeι ≫
        modelMap f P.πY P.n.toNat).app U)) :
    ∀ U : R.Opens, IsIso (((B i).roundDown.suppIdeal.subschemeι ≫ f).app U) := by
  classical
  haveI : QuasiCompact (sX i) := (hX i).toIsVariety.toQuasiCompact
  haveI : QuasiCompact sR := hRp.toIsVariety.toQuasiCompact
  haveI : IsSeparated sR := hRp.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sR := hRp.toIsVariety.toLocallyOfFiniteType
  haveI : IsDominant f := isDominant_of_forall_isIso_app f hfO
  -- the invariants at the end of the program
  obtain ⟨hD, hD'⟩ := isRelativelyNef_of_qLinearlyEquivalent_isPullback (hQ i) f hf hH hM hk hMeq
  obtain ⟨m, hm, hmD⟩ :=
    (isQCartier_of_isQFactorial (sX i) (hQ i) (Divisor.toQDivisor (K i) + B i)).exists_pos
  have h0 := floorInv_zero (g := f) (t₀ := 1 / 2) (hQ i) (hK i) (hdlt i) hmD hD hD'
  have hjn : ((P.n.toNat : ℕ) : ℕ∞) ≤ P.n := by rw [ENat.coe_toNat hPn]
  have hz : ∀ y : R, y ⤳ genericPoint R → y = genericPoint R :=
    fun y hy => eq_genericPoint_of_specializes hy
  have hEη := exists_coeff_pos_genericPoint_of_image_eq_univ (hdlt i).1.2.1 f heq
  obtain ⟨hinv, -⟩ := floorInv_program hRp hm h0 P hPp hz hEη P.n.toNat hjn
  obtain ⟨hdn, Sg, hSgc, hSgr⟩ :=
    exists_isCrepantBirationalMap_program hRp hm h0 P hPp hz hEη P.n.toNat hjn
  have hYp := hPp.2 P.n.toNat hjn
  have hmod := P.isRelativeDltModel P.n.toNat hjn
  have hKK := hinv.isCanonicalDivisor
  have hdimY := hKK.topologicalKrullDim_eq
  have hYn := hmod.isQFactorial.1
  have hXn : IsNormalVariety ℂ (sX i) := (hQ i).1
  set BB := iterTransform P.φ (B i) P.n.toNat with hBBdef
  set TT := iterTransform P.φ (Divisor.toQDivisor (B i).roundDown) P.n.toNat with hTTdef
  set KK := iterTransform P.φ (K i) P.n.toNat with hKKdef
  have hfl : Divisor.toQDivisor (DivisorWithCoeffs.roundDown BB) = TT := by
    ext Q
    have h1 := hinv.coeff_bounds Q
    simp only [DivisorWithCoeffs.coeff_sub] at h1
    rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_roundDown]
    rcases hinv.floor_int Q with h | h
    · rw [h] at h1 ⊢
      rw [Int.floor_eq_zero_iff.mpr ⟨by linarith [h1.1], by linarith [h1.2.1]⟩]
      simp
    · rw [h] at h1 ⊢
      have hb : BB.coeff Q = 1 := le_antisymm h1.2.2 (by linarith [h1.1])
      rw [hb]; simp
  -- a common log resolution of `(X_i, B_i)` and `(Y, B_Y)`
  obtain ⟨W, _, _, _, p, q, _, _, hlp, hlq, hpq, hcompat⟩ :=
    exists_isLogResolution_of_functionFieldEquiv (hX i) hYp (hQ i) hmod.isQFactorial (B i) BB
      Sg
  haveI : IsProper p := hlp.isProper
  haveI : IsProper q := hlq.isProper
  have hpb := hlp.isBirationalMorphism
  have hqb := hlq.isBirationalMorphism
  obtain ⟨hWp, -, -⟩ := hlp.toIsSmoothResolution.isNormalVariety hXn
  obtain ⟨hWq, -, -⟩ := hlq.toIsSmoothResolution.isNormalVariety hYn
  -- `p` and `q` commute over `R`
  have hπnR : (modelMap f P.πY P.n.toNat) ≫ sR = (modelStr (sX i) P.sY P.n.toNat) := hmod.comp_eq
  have hpf : p ≫ f = q ≫ (modelMap f P.πY P.n.toNat) := by
    refine eq_of_functionFieldMap_eq (p ≫ f) (q ≫ (modelMap f P.πY P.n.toNat)) sR
      (by rw [Category.assoc, Category.assoc, hf, hπnR, hpq]) fun a => ?_
    rw [← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      ← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply, hcompat, hSgr]
  -- the common crepant boundary
  have hPX : MMP.Mori.IsPair (sX i) (B i) := ⟨hXn, 3, K i, hK i,
    isQCartier_of_isQFactorial (sX i) (hQ i) _⟩
  have hPY : MMP.Mori.IsPair (modelStr (sX i) P.sY P.n.toNat) BB := ⟨hYn, 3, KK, hKK,
    isQCartier_of_isQFactorial (modelStr (sX i) P.sY P.n.toNat) hmod.isQFactorial _⟩
  obtain ⟨BW, hBWX⟩ := (hPX.existsUnique_isCrepantBoundary (hK i) p hWp hpb).1.exists
  have hBWY := isCrepantBoundary_of_isCrepantBirationalMap hPY hKK Sg hSgc p q hWp hWq hpb hqb
    hcompat hBWX
  -- the reduced coefficient-one part `T_W` of `B_W`
  have hBW1 : ∀ F, BW.coeff F ≤ 1 := by
    intro F
    have h0 := (hdlt i).1.2.2 3 _ _ (MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
      (hBWX F) (show IsProper p from inferInstance))
    have : ((BW.coeff F : ℚ) : ℝ) ≤ 1 := by push_cast at h0; linarith
    exact_mod_cast this
  set TW : Divisor W := ∑ F ∈ BW.support.filter (fun F => BW.coeff F = 1), Finsupp.single F 1
    with hTWdef
  have hTW : ∀ F, TW.coeff F = if BW.coeff F = 1 then 1 else 0 := by
    intro F
    change (∑ F' ∈ BW.support.filter (fun F => BW.coeff F = 1), Finsupp.single F' (1 : ℤ)) F = _
    rw [Finsupp.finset_sum_apply]
    simp only [Finsupp.single_apply]
    rw [Finset.sum_ite_eq']
    by_cases h1 : BW.coeff F = 1
    · have hm : F ∈ BW.support.filter (fun F => BW.coeff F = 1) :=
        Finset.mem_filter.mpr ⟨Finsupp.mem_support_iff.mpr (by
          rw [show BW F = BW.coeff F from rfl, h1]; exact one_ne_zero), h1⟩
      rw [if_pos hm, if_pos h1]
    · have hm : F ∉ BW.support.filter (fun F => BW.coeff F = 1) :=
        fun hm => h1 (Finset.mem_filter.mp hm).2
      rw [if_neg hm, if_neg h1]
  have hΓ : ∀ F, (BW - Divisor.toQDivisor TW).coeff F < 1 := by
    intro F
    rw [DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, hTW]
    by_cases h1 : BW.coeff F = 1
    · rw [if_pos h1, h1]; norm_num
    · rw [if_neg h1]
      simpa using lt_of_le_of_ne (hBW1 F) h1
  set ZW : TopologicalSpace.Closeds W := ⟨⋃ F ∈ TW.support, (F.support : Set W),
    TW.support.finite_toSet.isClosed_biUnion fun F _ => F.idealSheaf.support.isClosed⟩
  set ιT := (Scheme.IdealSheafData.vanishingIdeal ZW).subschemeι
  have hTWr : Set.range ιT.base = ⋃ F ∈ TW.support, (F.support : Set W) := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  -- the floors of `X_i` and of `Y`
  set ιS := (B i).roundDown.suppIdeal.subschemeι with hιS
  haveI hSred : IsReduced (B i).roundDown.suppIdeal.subscheme := by
    unfold DivisorWithCoeffs.suppIdeal
    exact Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal _
  have hrS : Set.range ιS.base = ⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i)) := by
    rw [hιS, Scheme.IdealSheafData.range_subschemeι, DivisorWithCoeffs.coe_support_suppIdeal,
      DivisorWithCoeffs.coe_supp]
  set ιY := (DivisorWithCoeffs.roundDown BB).suppIdeal.subschemeι with hιY
  haveI hYred : IsReduced (DivisorWithCoeffs.roundDown BB).suppIdeal.subscheme := by
    unfold DivisorWithCoeffs.suppIdeal
    exact Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal _
  have hrY : Set.range ιY.base = ⋃ E ∈ (DivisorWithCoeffs.roundDown BB).support,
      (E.support : Set (modelSeq (X i) P.Y P.n.toNat)) := by
    rw [hιY, Scheme.IdealSheafData.range_subschemeι, DivisorWithCoeffs.coe_support_suppIdeal,
      DivisorWithCoeffs.coe_supp]
  -- the all-zero-floor push-forward on both sides
  have hBYk : MMP.Intersection.IsLogCanonicalPair (modelStr (sX i) P.sY P.n.toNat) BB ∧ ∃ δ : ℚ, 0 < δ ∧
      IsKltPair (modelStr (sX i) P.sY P.n.toNat) (BB - δ • Divisor.toQDivisor (DivisorWithCoeffs.roundDown BB)) :=
    ⟨hinv.isLogCanonicalPair, 1, one_pos, by rw [one_smul, hfl]; exact hinv.isKltPair_sub⟩
  obtain ⟨-, -, ⟨a, ha⟩, ha'⟩ :=
    MMP.Fourfold.IsLogResolution.bijOn_idealSheaf_divisorialSubmodule_and_pushforward_floor
      (hdim i) (hK i) (hX i) (hQ i) (Or.inl (hdlt i)) hlp ⟨hWp, hBWX⟩ hTW hΓ ιS ιT hrS hTWr
  obtain ⟨-, -, ⟨b, hb⟩, hb'⟩ :=
    MMP.Fourfold.IsLogResolution.bijOn_idealSheaf_divisorialSubmodule_and_pushforward_floor
      hdimY hKK hYp hmod.isQFactorial (Or.inr hBYk) hlq ⟨hWq, hBWY⟩ hTW hΓ ιY ιT hrY hTWr
  obtain ⟨haiso, -⟩ := ha' a ha
  obtain ⟨hbiso, -⟩ := hb' b hb
  intro U
  have e : a ≫ (ιS ≫ f) = b ≫ (ιY ≫ (modelMap f P.πY P.n.toNat)) := by
    rw [← Category.assoc, ha, Category.assoc, hpf, ← Category.assoc, ← hb, Category.assoc]
  have h1 : IsIso ((b ≫ (ιY ≫ (modelMap f P.πY P.n.toNat))).app U) := by
    rw [Scheme.Hom.comp_app]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ (hY U) (hbiso _)
  rw [← e, Scheme.Hom.comp_app] at h1
  haveI := haiso ((ιS ≫ f) ⁻¹ᵁ U)
  exact @IsIso.of_isIso_comp_right _ _ _ _ _ ((ιS ≫ f).app U) (a.app _) _ h1

include hX hdim hQ hB hdlt hK hsemi hSf in
/-- **The connected case of the Mori endpoint.** If the final contraction `r : Y ⟶ V` of a
projective program over `R` for `(X_i, B_i - ½⌊B_i⌋)` has `dim V ≤ 1`, or `dim V = 2` and the
horizontal floor of `Y` has degree one over `V`, then the reduced floor `T` of `Y` satisfies
`(π_Y)_* 𝒪_T = 𝒪_R`: `r_* 𝒪_T = 𝒪_V` by the connected-floor Mori lemma, and
`v_* 𝒪_V = 𝒪_R` for `v : V ⟶ R` by the Stein equalities. -/
private theorem isIso_app_floor_endpoint_of_connected (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
