/-- **The Mori endpoint.** When the floor of `X_i` maps onto the base `R`, a projective program
over `R` for `(X_i, B_i - ½⌊B_i⌋)` ending with a Mori fibre space `r : Y ⟶ V` gives the lifting
and generation statement on `X_i`: either the floor `T` of `Y` satisfies `r_* 𝒪_T = 𝒪_V`, whence
`f_* 𝒪_S = 𝒪_R` on `X_i` through a common resolution, or `dim V = 2` and the horizontal floor has
degree two, where the admissible floor sections descend to `V`. -/
private theorem exists_liftsPow_of_hasFinal (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    (heq : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ)
    (P : RelativeDltProgram (sX i) sR f (K i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown)) (hPp : P.IsProjective) (hPn : P.n ≠ ⊤)
    (hfin : P.hasFinal) :
    ∃ k : ℕ, 0 < k ∧ ∀ m : ℕ, k ∣ m →
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
      ∀ {A : Type*} [Finite A]
        (t : A → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
        (∀ α, t α ∈ admissibleSections Rf) →
        (∀ P (y : Sf ⟨i, P⟩), ∃ α, ∃ V : (Sf ⟨i, P⟩).Opens, y ∈ V ∧
          GeneratesOn (BSf ⟨i, P⟩) m V
            ((t α ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
              RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m)) →
        ∃ a : ℕ, 0 < a ∧
          (∀ α, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            LiftsPow sX B jf BSf i m a (a * m) σ (t α)) ∧
          ∀ x : X i, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            ∃ V : (X i).Opens, x ∈ V ∧ GeneratesOn (B i) (a * m) V σ ∧
              (LiftsPow sX B jf BSf i m a (a * m) σ 0 ∨
                ∃ α, LiftsPow sX B jf BSf i m a (a * m) σ (t α)) := by
  obtain ⟨-, hfinal, -⟩ := P.final_spec hfin
