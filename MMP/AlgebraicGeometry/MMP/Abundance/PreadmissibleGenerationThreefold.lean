    (hfin : P.hasFinal) [IsIntegral P.T]
    (hcase : topologicalKrullDim P.T ≤ 1 ∨ (topologicalKrullDim P.T = 2 ∧
        open scoped Classical in ∑ Q ∈ (DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).support with
            P.g.base Q.genericPoint = genericPoint P.T,
          (DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).coeff Q *
            (letI := (P.g.residueFieldMap Q.genericPoint).hom.toAlgebra
             (Module.finrank (P.T.residueField (P.g.base Q.genericPoint))
              ((modelSeq (X i) P.Y P.n.toNat).residueField Q.genericPoint) : ℤ)) = 1)) :
    ∀ U : R.Opens, IsIso (((DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).suppIdeal.subschemeι ≫
        modelMap f P.πY P.n.toNat).app U) := by
  classical
  obtain ⟨-, hfinal, -⟩ := P.final_spec hfin
