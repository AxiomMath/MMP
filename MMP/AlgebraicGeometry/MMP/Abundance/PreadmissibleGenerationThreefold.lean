open MMP.Threefold.Mori.Helpers MMP.Threefold.Mori.ModelIndependence in
/-- **Orders of pulled-back forms along a valuation.** Let `σ : k(X') ≅ k(X)`, `Γ` a prime
divisor of `X` and `(Y, f, E)` a divisor over `X'` whose valuation is `v_Γ ∘ σ`. Then
`ord_Γ(σ^* τ) = ord_E(f^* τ)`: the isomorphism `φ = σ ∘ (f^*)⁻¹ : k(Y) → k(X)` carries `v_E` to
`v_Γ`, hence `𝒪_{Y,E}` onto `𝒪_{X,Γ}`, and `σ^* = φ^* ∘ f^*`. -/
private theorem ordForm_pluriformPullback_eq_ordPullback {k : Type u} [Field k] [CharZero k]
    {X X' : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X']
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)} (hX : IsNormalVariety k sX)
    (hX' : IsNormalVariety k sX') {n : ℕ} (hn : topologicalKrullDim X = n)
    (hn' : topologicalKrullDim X' = n)
    (σ : FunctionFieldEquiv sX sX') (Γ : MMP.Mori.PrimeDivisor X) (D : DivisorOver k sX')
    (hv : ∀ g : X'.functionField, D.valuation g = Γ.divisorialValuation ((σ.toHom) g))
    {m : ℤ} (τ : RationalPluriForms sX' n m) :
    Γ.ordForm (pluriformPullback sX sX' σ.toHom n m τ) = D.ordPullback τ := by
  have := D.isIntegral
  have := D.isNormal
  have := D.isLocallyNoetherian
  have := D.isDominant
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType sX' := hX'.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (D.f ≫ sX') := D.isNormalVariety.1.toLocallyOfFiniteType
  let A := functionFieldAlgebra sX
  let A' := functionFieldAlgebra sX'
  let AY := functionFieldAlgebra (D.f ≫ sX')
  let Af := functionFieldMapAlgebra D.f
  have hT1 := isScalarTower_functionFieldMap sX' D.f
  have hb := D.isBirationalMorphism.functionFieldMap_bijective
  let F := RingEquiv.ofBijective _ hb
  let φ : D.Y.functionField →+* X.functionField := (σ.toHom).toRingHom.comp F.symm.toRingHom
  have hφ : ∀ g, φ (functionFieldMap D.f g) = (σ.toHom) g := fun g => by
    change (σ.toHom) (F.symm (F g)) = _
    rw [F.symm_apply_apply]
  have hφs : Function.Surjective φ := by
    intro z
    obtain ⟨g, rfl⟩ := σ.surjective z
    exact ⟨functionFieldMap D.f g, hφ g⟩
  have hval : ∀ y : D.Y.functionField,
      Γ.divisorialValuation (φ y) = D.E.divisorialValuation y := by
    intro y
    obtain ⟨g, rfl⟩ := hb.2 y
    rw [hφ g, ← hv g]
    rfl
  have hord : ∀ y : D.Y.functionField,
      X.ord (φ y) Γ.genericPoint = D.Y.ord y D.E.genericPoint := by
    intro y
    by_cases hy : y = 0
    · subst hy; simp [Scheme.ord_zero]
    · have hey : φ y ≠ 0 := (map_ne_zero φ).mpr hy
      have h1 := hval y
      rw [Γ.divisorialValuation_eq_exp_neg_ord hey, D.E.divisorialValuation_eq_exp_neg_ord hy,
        WithZero.exp_inj] at h1
      omega
  have h12 : ∀ a1 : D.E.localRing, ∃ a2 : Γ.localRing,
      algebraMap Γ.localRing X.functionField a2 =
        φ (algebraMap D.E.localRing D.Y.functionField a1) := by
    intro a1
    have : D.E.divisorialValuation (algebraMap D.E.localRing D.Y.functionField a1) ≤ 1 :=
      (D.E.divisorialValuation_le_one_iff _).mpr ⟨a1, rfl⟩
    rw [← hval] at this
    obtain ⟨a2, ha2⟩ := (Γ.divisorialValuation_le_one_iff _).mp this
    exact ⟨a2, ha2⟩
  have h21 : ∀ a2 : Γ.localRing, ∃ a1 : D.E.localRing,
      φ (algebraMap D.E.localRing D.Y.functionField a1) =
        algebraMap Γ.localRing X.functionField a2 := by
    intro a2
    obtain ⟨y, hy⟩ := hφs (algebraMap Γ.localRing X.functionField a2)
    have : D.E.divisorialValuation y ≤ 1 := by
      rw [← hval, hy]
      exact (Γ.divisorialValuation_le_one_iff _).mpr ⟨a2, rfl⟩
    obtain ⟨a1, ha1⟩ := (D.E.divisorialValuation_le_one_iff _).mp this
    exact ⟨a1, by rw [ha1]; exact hy⟩
  obtain ⟨ψ, hψb, hψ⟩ := exists_ringHom_bijective_of_range φ h12 h21
  have hd' : (Algebra.trdeg k X'.functionField).toNat = n :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX') hn'
  have htr : Algebra.trdeg k X'.functionField = Algebra.trdeg k D.Y.functionField :=
    trdeg_functionField_eq_of_bijective sX' D.f hb
  have htrX : Algebra.trdeg k X.functionField = Algebra.trdeg k X'.functionField :=
    trdeg_functionField_eq (sX := sX) (sX' := sX') hn hn'
  have hd1 : (Algebra.trdeg k D.Y.functionField).toNat = n := by rw [← htr]; exact hd'
  letI := stalkAlgebra (D.f ≫ sX') D.E.genericPoint
  letI := stalkAlgebra sX Γ.genericPoint
  haveI := isScalarTower_stalk_functionField (D.f ≫ sX') D.E.genericPoint
  haveI := isScalarTower_stalk_functionField sX Γ.genericPoint
  letI Aφ : Algebra D.Y.functionField X.functionField := φ.toAlgebra
  have hTφ : IsScalarTower k D.Y.functionField X.functionField := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    change algebraMap k X.functionField c = φ (algebraMap k D.Y.functionField c)
    rw [IsScalarTower.algebraMap_apply k X'.functionField D.Y.functionField c]
    change _ = φ (functionFieldMap D.f (algebraMap k X'.functionField c))
    rw [hφ]
    exact ((σ.toHom).commutes c).symm
  letI : Algebra D.E.localRing Γ.localRing := ψ.toAlgebra
  letI : Algebra D.E.localRing X.functionField :=
    ((algebraMap Γ.localRing X.functionField).comp ψ).toAlgebra
  have hS1 : IsScalarTower k D.E.localRing Γ.localRing := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    apply IsFractionRing.injective Γ.localRing X.functionField
    change _ = algebraMap Γ.localRing X.functionField (ψ (algebraMap k D.E.localRing c))
    rw [hψ, ← IsScalarTower.algebraMap_apply k D.E.localRing D.Y.functionField c,
      ← IsScalarTower.algebraMap_apply k Γ.localRing X.functionField c]
    exact IsScalarTower.algebraMap_apply k D.Y.functionField X.functionField c
  have hS2 : IsScalarTower D.E.localRing Γ.localRing X.functionField :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hS3 : IsScalarTower D.E.localRing D.Y.functionField X.functionField :=
    IsScalarTower.of_algebraMap_eq fun a => hψ a
  have hS4 : IsScalarTower k D.E.localRing X.functionField := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    change _ = algebraMap Γ.localRing X.functionField (ψ (algebraMap k D.E.localRing c))
    rw [IsScalarTower.algebraMap_apply k Γ.localRing X.functionField c,
      IsScalarTower.algebraMap_apply k D.E.localRing Γ.localRing c]
    rfl
  have : Algebra.EssFiniteType k D.Y.functionField :=
    essFiniteType_functionField (sX := D.f ≫ sX')
  obtain ⟨ω0, hω0⟩ := exists_isPullbackGenerator_of_bijective sX' D.f hb hd'
  obtain ⟨ω1, hω1⟩ := exists_isPullbackGenerator (k := k) (K := D.Y.functionField)
    (K' := X.functionField) (htr.symm.trans htrX.symm) hd1
  have hω0φ : IsPullbackGenerator X.functionField
      (topFormsMap k X'.functionField D.Y.functionField n ω0) :=
    IsPullbackGenerator.of_span hω1 hω0.2.1 hω0.2.2
  obtain ⟨σE, hσE, h0σE⟩ := D.E.exists_topForms_generator (sX := D.f ≫ sX') hd1
  have hωT : IsPullbackGenerator X.functionField
      (topFormsMap k D.E.localRing D.Y.functionField n σE) :=
    IsPullbackGenerator.of_span hω1 (span_singleton_topFormsMap (nonZeroDivisors _) hσE) h0σE
  have key := ordAt_pullbackForms_eq (k := k) (K := D.Y.functionField) (K' := X.functionField)
    (A := D.E.localRing) (A' := Γ.localRing) (d := n) (m := m) hψb
    (v := fun y => D.Y.ord y D.E.genericPoint) (v' := fun y => X.ord y Γ.genericPoint)
    (fun x y hx hy => D.E.ord_mul_of_ne_zero x y hx hy)
    (fun a ha => D.E.ord_algebraMap_of_isUnit ha)
    (fun x y hx hy => Γ.ord_mul_of_ne_zero x y hx hy)
    (fun a ha => Γ.ord_algebraMap_of_isUnit ha)
    (fun x => hord x) hσE hωT (pullbackForms (K' := D.Y.functionField) m τ)
  let Aσ : Algebra X'.functionField X.functionField := (σ.toHom).toRingHom.toAlgebra
  have tσ : @IsScalarTower k X'.functionField X.functionField _ Aσ.toSMul _ := by
    letI := Aσ; exact IsScalarTower.of_algebraMap_eq fun c => ((σ.toHom).commutes c).symm
  have t3 : @IsScalarTower X'.functionField D.Y.functionField X.functionField Af.toSMul
      Aφ.toSMul Aσ.toSMul :=
    @IsScalarTower.of_algebraMap_eq _ _ _ _ _ _ Af Aφ Aσ fun g => (hφ g).symm
  have hcomp := @pullbackForms_comp k _ n m X'.functionField D.Y.functionField
    X.functionField _ _ _ A' AY A Af Aφ Aσ hT1 hTφ tσ t3 ω0 hω0 hω0φ τ
  calc Γ.ordForm (pluriformPullback sX sX' σ.toHom n m τ)
      = ordAt Γ.localRing (fun y => X.ord y Γ.genericPoint)
          (@pullbackForms k _ X'.functionField X.functionField _ _ A' A Aσ tσ n m τ) := rfl
    _ = ordAt Γ.localRing (fun y => X.ord y Γ.genericPoint)
          (pullbackForms (K' := X.functionField) m
            (pullbackForms (K' := D.Y.functionField) m τ)) := by rw [hcomp]
    _ = D.ordPullback τ := key

section ResidueFunctoriality

variable {k : Type u} [Field k] {X X' : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  {sX' : X' ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral X']

/-- `φ^*(c w^{⊗a}) = φ(c) (φ^*w)^{⊗a}` for every `d`-form `w`, on varieties of dimension `d`. -/
private theorem pluriformPullback_smul_formPow' [CharZero k] [LocallyOfFiniteType sX]
    [LocallyOfFiniteType sX'] {d : ℕ} (hX : topologicalKrullDim X = d)
    (hX' : topologicalKrullDim X' = d) (φ : FunctionFieldHom sX sX')
    (w : letI := functionFieldAlgebra sX'; ⋀[X'.functionField]^d Ω[X'.functionField⁄k])
    (a : ℕ) (c : X'.functionField) :
    letI := functionFieldAlgebra sX'; letI := functionFieldAlgebra sX
    letI : Algebra X'.functionField X.functionField := φ.toRingHom.toAlgebra
    haveI : IsScalarTower k X'.functionField X.functionField :=
      IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
    pluriformPullback sX sX' φ d a (c • formPow w a) =
      φ c • formPow (topFormsMap k X'.functionField X.functionField d w) a := by
  let := functionFieldAlgebra sX'
  let := functionFieldAlgebra sX
  let : Algebra X'.functionField X.functionField := φ.toRingHom.toAlgebra
  have : IsScalarTower k X'.functionField X.functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · obtain ⟨ω, hω⟩ := exists_isPullbackGenerator_functionFieldHom hX hX' φ
    have e1 : (formPow w 0 : PluriForms k X'.functionField d (0 : ℕ)) = formPow ω 0 := by
      unfold formPow; congr 1; funext i; exact i.elim0
    have e2 : (formPow (topFormsMap k X'.functionField X.functionField d w) 0 :
        PluriForms k X.functionField d (0 : ℕ)) =
        formPow (topFormsMap k X'.functionField X.functionField d ω) 0 := by
      unfold formPow; congr 1; funext i; exact i.elim0
    rw [e1, e2]
    exact pluriformPullback_smul_formPow φ hω 0 c
  by_cases hw : w = 0
  · have h0 : ∀ {K : Type u} [Field K] [Algebra k K],
        (formPow (0 : ⋀[K]^d Ω[K⁄k]) a : PluriForms k K d a) = 0 := by
      intro K _ _
      unfold formPow
      exact (PiTensorProduct.tprod K).map_coord_zero ⟨0, ha⟩ rfl
    subst hw
    rw [map_zero (topFormsMap k X'.functionField X.functionField d), h0, h0, smul_zero, smul_zero]
    exact map_zero (pluriformPullback sX sX' φ d a)
  · obtain ⟨b⟩ := exists_basis_topForms (sX := sX') hX'
    have hspan : Submodule.span X'.functionField {w} = ⊤ := by
      have hc : b.repr w () ≠ 0 := by
        intro h
        apply hw
        rw [← b.sum_repr w]
        simp [h]
      obtain ⟨r, hr⟩ : ∃ r, r = b.repr w () := ⟨_, rfl⟩
      rw [← hr] at hc
      refine Submodule.eq_top_iff'.mpr fun x => Submodule.mem_span_singleton.mpr
        ⟨b.repr x () / r, ?_⟩
      have hx : x = b.repr x () • b () := by
        conv_lhs => rw [← b.sum_repr x]
        simp
      have hw' : w = r • b () := by
        conv_lhs => rw [← b.sum_repr w]
        simp [hr]
      rw [hw', smul_smul, div_mul_cancel₀ _ hc, ← hx]
    exact pluriformPullback_smul_formPow φ
      (isPullbackGenerator_functionFieldHom hX hX' φ hspan hw) a c

/-- The image of `c • ιMulti (D ∘ v)` under `φ^*`. -/
private theorem topFormsMap_smul_ιMulti_D (φ : FunctionFieldHom sX sX') {d : ℕ}
    (c : X'.functionField) (v : Fin d → X'.functionField) :
    letI := functionFieldAlgebra sX'; letI := functionFieldAlgebra sX
    letI : Algebra X'.functionField X.functionField := φ.toRingHom.toAlgebra
    haveI : IsScalarTower k X'.functionField X.functionField :=
      IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
    topFormsMap k X'.functionField X.functionField d
        (c • exteriorPower.ιMulti X'.functionField d
          fun i => KaehlerDifferential.D k X'.functionField (v i)) =
      φ c • exteriorPower.ιMulti X.functionField d
          fun i => KaehlerDifferential.D k X.functionField (φ (v i)) := by
  let := functionFieldAlgebra sX'
  let := functionFieldAlgebra sX
  let : Algebra X'.functionField X.functionField := φ.toRingHom.toAlgebra
  have : IsScalarTower k X'.functionField X.functionField :=
    IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
  rw [LinearMap.map_smul, topFormsMap_ιMulti, algebra_compatible_smul X.functionField c]
  simp only [KaehlerDifferential.map_D]
  rfl

/-- **Poincaré residues are functorial under isomorphisms of the local rings.** Let
`σ : k(Y') → k(Y)` and `σ_T : k(T') → k(T)` be `k`-homomorphisms of function fields, and
`ψ : 𝒪_{Y',T'} → 𝒪_{Y,T}` a ring homomorphism of the local rings along the divisors, compatible
with `σ` and `σ_T` and preserving orders. Then `Res_T(σ^*τ) = σ_T^* Res_{T'}(τ)`. -/
private theorem isPoincareResidue_pluriformPullback [CharZero k] {T T' : Scheme.{u}} [IsIntegral T]
    [IsIntegral T'] [IsLocallyNoetherian X] [IsLocallyNoetherian X'] (j : T ⟶ X) (j' : T' ⟶ X')
    [LocallyOfFiniteType sX]
    [LocallyOfFiniteType sX'] [LocallyOfFiniteType (j ≫ sX)] [LocallyOfFiniteType (j' ≫ sX')]
    {n : ℕ} (hX : topologicalKrullDim X = (n + 1 : ℕ))
    (hX' : topologicalKrullDim X' = (n + 1 : ℕ)) (hT : topologicalKrullDim T = n)
    (hT' : topologicalKrullDim T' = n) (σ : FunctionFieldHom sX sX')
    (σT : FunctionFieldHom (j ≫ sX) (j' ≫ sX'))
    (ψ : X'.presheaf.stalk (j' (genericPoint T')) →+* X.presheaf.stalk (j (genericPoint T)))
    (hψ : ∀ a, algebraMap _ X.functionField (ψ a) = σ (algebraMap _ X'.functionField a))
    (hψT : ∀ a, (j.stalkMap (genericPoint T)).hom (ψ a) =
      σT ((j'.stalkMap (genericPoint T')).hom a))
    (hord : ∀ a, X.ord (algebraMap _ X.functionField (ψ a)) (j (genericPoint T)) =
      X'.ord (algebraMap _ X'.functionField a) (j' (genericPoint T')))
    {m : ℕ} {τ : RationalPluriForms sX' (n + 1) m} {ρ : RationalPluriForms (j' ≫ sX') n m}
    (h : IsPoincareResidue sX' j' n m τ ρ) :
    IsPoincareResidue sX j n m (pluriformPullback sX sX' σ (n + 1) m τ)
      (pluriformPullback (j ≫ sX) (j' ≫ sX') σT n m ρ) := by
  let := functionFieldAlgebra sX'
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (j' ≫ sX')
  let := functionFieldAlgebra (j ≫ sX)
  obtain ⟨t, g, x, ht, rfl, rfl⟩ := h
  refine ⟨ψ t, ψ g, fun i => ψ (x i), by rw [hord]; exact ht, ?_, ?_⟩
  · have e := pluriformPullback_smul_formPow' hX hX' σ
      ((algebraMap _ X'.functionField t)⁻¹ • exteriorPower.ιMulti X'.functionField (n + 1)
        (Fin.cons (KaehlerDifferential.D k X'.functionField (algebraMap _ _ t))
          fun i => KaehlerDifferential.D k X'.functionField (algebraMap _ _ (x i)))) m
      (algebraMap _ X'.functionField g)
    have e2 := topFormsMap_smul_ιMulti_D σ (algebraMap _ X'.functionField t)⁻¹
      (Fin.cons (algebraMap _ X'.functionField t) fun i => algebraMap _ X'.functionField (x i) :
        Fin (n + 1) → X'.functionField)
    have hc : ∀ {K : Type u} [Field K] [Algebra k K] (a : K) (b : Fin n → K),
        (Fin.cons (KaehlerDifferential.D k K a) (fun i => KaehlerDifferential.D k K (b i)) :
          Fin (n + 1) → Ω[K⁄k]) = fun i => KaehlerDifferential.D k K ((Fin.cons a b : Fin (n + 1) → K) i) := by
      intro K _ _ a b
      funext i
      refine Fin.cases ?_ (fun i => ?_) i <;> simp
    refine e.trans ?_
    rw [hc, e2, hc]
    simp only [hψ, map_inv₀, formPow]
    congr 4
    funext _
    congr 2
    funext i
    refine Fin.cases ?_ (fun i => ?_) i <;> simp
  · have e := pluriformPullback_smul_formPow' hT hT' σT
      (exteriorPower.ιMulti T'.functionField n
        fun i => KaehlerDifferential.D k T'.functionField ((j'.stalkMap (genericPoint T')).hom (x i)))
      m ((j'.stalkMap (genericPoint T')).hom g)
    refine e.trans ?_
    have e2 := topFormsMap_smul_ιMulti_D σT 1
      (fun i => (j'.stalkMap (genericPoint T')).hom (x i))
    rw [one_smul, map_one, one_smul] at e2
    rw [e2]
    simp only [hψT, formPow]
    rfl

end ResidueFunctoriality

/-- A closed subscheme whose underlying set is a prime divisor of a variety of dimension `e + 1`
has dimension `e`. -/
private theorem topologicalKrullDim_eq_of_range_eq_support {k : Type u} [Field k] {Y T : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [IsLocallyNoetherian Y] [LocallyOfFiniteType sY]
    (j : T ⟶ Y) [IsClosedImmersion j]
    (P : MMP.Mori.PrimeDivisor Y) (h : Set.range j.base = (P.support : Set Y)) {e : ℕ}
    (hY : topologicalKrullDim Y = (e + 1 : ℕ)) : topologicalKrullDim T = e := by
  have hemb := j.isClosedEmbedding.isEmbedding
  let φ := hemb.toHomeomorph
  have h1 : topologicalKrullDim T = topologicalKrullDim (Set.range j.base) :=
    le_antisymm φ.isInducing.topologicalKrullDim_le φ.symm.isInducing.topologicalKrullDim_le
  rw [h1, h, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  have h2 := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sY P.genericPoint
  rw [P.coheight_genericPoint, hY] at h2
  generalize topologicalKrullDim (closure {P.genericPoint} : Set Y) = a at h2 ⊢
  rcases a with _ | _ | a
  · exfalso
    change (⊥ : WithBot ℕ∞) + 1 = _ at h2
    rw [WithBot.bot_add] at h2
    exact WithBot.bot_ne_coe (h2.trans (by push_cast; rfl))
  · exfalso
    change ((⊤ : ℕ∞) : WithBot ℕ∞) + ((1 : ℕ∞) : WithBot ℕ∞) = (((e + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) at h2
    rw [← WithBot.coe_add, WithBot.coe_inj, top_add] at h2
    exact ENat.top_ne_coe _ h2
  · have : ((a + 1 : ℕ) : WithBot ℕ∞) = ((e + 1 : ℕ) : WithBot ℕ∞) := by
      rw [← h2]; push_cast; rfl
    have : a + 1 = e + 1 := by exact_mod_cast this
    have : a = e := by omega
    subst this; rfl

/-- The generic point of a closed subscheme with underlying set a prime divisor `P` is the generic
point of `P`. -/
private theorem map_genericPoint_eq_of_range_eq {Y T : Scheme.{u}} [IrreducibleSpace T]
    (j : T ⟶ Y) (P : MMP.Mori.PrimeDivisor Y) (hrange : Set.range j.base = (P.support : Set Y)) :
    j (genericPoint T) = P.genericPoint := by
  have h1 : closure ({j (genericPoint T)} : Set Y) = Set.range j.base := by
    apply le_antisymm
    · rw [hrange]
      exact (AlgebraicGeometry.PrimeDivisor.support_eq_closure P ▸
        isClosed_closure).closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr (hrange ▸ Set.mem_range_self _))
    · rintro _ ⟨z, rfl⟩
      have hz : genericPoint T ⤳ z := (genericPoint_spec T).specializes trivial
      exact specializes_iff_mem_closure.mp (hz.map j.continuous)
  have h2 : closure ({j (genericPoint T)} : Set Y) = closure {P.genericPoint} := by
    rw [h1, hrange, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact (inseparable_iff_closure_eq.mpr h2).eq

section CrepantModel

variable {k : Type} [Field k]

/-- Pull-back of rational forms along a composite of birational morphisms. -/
private theorem pullbackRationalPluriForms_comp' [PerfectField k] {X Y Z : Scheme.{0}}
    [IsIntegral X] [IsIntegral Y] [IsIntegral Z] {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX]
    (f : Y ⟶ X) (g : Z ⟶ Y) [IsDominant f] [IsDominant g] [LocallyOfFiniteType (f ≫ sX)]
    (hf : Function.Bijective (functionFieldMap f)) (hg : Function.Bijective (functionFieldMap g))
    {d : ℕ} (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d)
    {m : ℤ} (τ : RationalPluriForms sX d m) :
    pullbackRationalPluriForms (f ≫ sX) g (pullbackRationalPluriForms sX f τ) =
      (pullbackRationalPluriForms sX (g ≫ f) τ : RationalPluriForms (g ≫ f ≫ sX) d m) := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  let := functionFieldAlgebra (g ≫ f ≫ sX)
  let := functionFieldMapAlgebra f
  let := functionFieldMapAlgebra g
  let := functionFieldMapAlgebra (g ≫ f)
  have := isScalarTower_functionFieldMap sX f
  have := isScalarTower_functionFieldMap (f ≫ sX) g
  have : IsScalarTower k X.functionField Z.functionField :=
    isScalarTower_functionFieldMap sX (g ≫ f)
  have : IsScalarTower X.functionField Y.functionField Z.functionField :=
    IsScalarTower.of_algebraMap_eq fun a =>
      (MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply g f a).symm
  obtain ⟨ω0, hω0⟩ := exists_isPullbackGenerator_of_bijective sX f hf hd
  have hd' : (Algebra.trdeg k Y.functionField).toNat = d := by
    rw [← trdeg_functionField_eq_of_bijective sX f hf]
    exact hd
  obtain ⟨ω1, hω1⟩ := exists_isPullbackGenerator_of_bijective (f ≫ sX) g hg hd'
  have hω' : IsPullbackGenerator Z.functionField
      (topFormsMap k X.functionField Y.functionField d ω0) :=
    MMP.Threefold.Mori.Helpers.IsPullbackGenerator.of_span hω1 hω0.2.1 hω0.2.2
  exact MMP.Threefold.Mori.Helpers.pullbackForms_comp hω0 hω' τ

/-- **Log discrepancies along a crepant model.** Let `g : V ⟶ T` be a proper birational
morphism of normal varieties, `ρ ≠ 0` a rational top form on `T` with `div ρ` canonical, and
`C` the crepant boundary on `V`: `g^*(div ρ + B_T) = div(g^*ρ) + C`. Then every divisor `E`
proper over `V` has the same log discrepancy over `(V, C)` as over `(T, B_T)`. -/
private theorem exists_isLogDiscrepancy_compDivisorOver [PerfectField k] {T V : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)} [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    [LocallyOfFiniteType sT] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    (hT : IsNormalVariety k sT) (g : V ⟶ T) [IsProper g] (hg : IsBirationalMorphism g)
    (hV : IsNormalVariety k (g ≫ sT)) [IsDominant g] [LocallyOfFiniteType (g ≫ sT)] {d : ℕ}
    {ρ : RationalPluriForms sT d 1} (hρ : ρ ≠ 0) (hK : (divisorOfForm ρ).IsCanonicalDivisor sT d)
    (hρV : pullbackRationalPluriForms sT g ρ ≠ 0)
    (hKV : (divisorOfForm (pullbackRationalPluriForms sT g ρ)).IsCanonicalDivisor (g ≫ sT) d)
    {BT : QDivisor T} {C : QDivisor V} (hq : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsQCartier)
    {hgen : ∀ Z : irreducibleComponents V,
      g (componentGenericPoint V Z) ∉ (Divisor.toQDivisor (divisorOfForm ρ) + BT).supp}
    (hpb : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsPullback g hgen
      (Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms sT g ρ)) + C))
    (E : DivisorOver k (g ≫ sT)) (hE : IsProper E.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy (g ≫ sT) d (QDivisor.toRDivisor C) E a ∧
      MMP.Intersection.IsLogDiscrepancy sT d (QDivisor.toRDivisor BT)
        (compDivisorOver g hV hg E) a := by
  set m := (Divisor.toQDivisor (divisorOfForm ρ) + BT).cartierIndex hq
  have hm : 0 < m := QDivisor.cartierIndex_pos hq
  obtain ⟨D0, hD0, hD0c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hq
  obtain ⟨D0V, hD0V, hpbV⟩ := hpb m hm D0 hD0 hD0c
  have hD0Vc : D0V.IsCartier := hpbV.isCartier hD0c
  have := E.isIntegral
  have := E.isNormal
  have := E.isLocallyNoetherian
  have := E.isDominant
  have : LocallyOfFiniteType (E.f ≫ g ≫ sT) := E.isNormalVariety.1.toLocallyOfFiniteType
  have : CompactSpace E.Y := by
    have := E.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (E.f ≫ g ≫ sT)
  have hgenY := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant E.f D0V
  set D0Y := D0V.pullback hD0Vc hgenY
  have hY : D0V.IsPullback E.f hgenY D0Y := Divisor.isPullback_pullback hD0Vc hgenY
  have hcomp : D0.IsPullback (E.f ≫ g)
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant (E.f ≫ g) D0) D0Y :=
    MMP.ProgramBaseChange.divisor_isPullback_comp rfl hpbV hY _
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  refine ⟨1 + (E.ordPullback (pullbackRationalPluriForms sT g ρ) : ℝ) -
    ∑ _i : Fin 1, (1 / (m : ℝ)) * (D0Y.coeff E.E : ℝ), ⟨hV, hE, _, hρV,
      ⟨_, hKV, fun Γ => coeff_divisorOfForm _ Γ⟩, 1, fun _ => 1 / (m : ℝ), fun _ => D0V,
      fun _ => D0Y, fun _ => hD0Vc, fun Γ => ?_, fun _ => ⟨hgenY, hY⟩, rfl⟩,
    ⟨hT, ?_, ρ, hρ, ⟨_, hK, fun Γ => coeff_divisorOfForm _ Γ⟩, 1, fun _ => 1 / (m : ℝ),
      fun _ => D0, fun _ => D0Y, fun _ => hD0c, fun Γ => ?_, fun _ => ⟨_, hcomp⟩, ?_⟩⟩
  · have h := congrArg (fun D : QDivisor V => D.coeff Γ) hD0V
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      coeff_divisorOfForm] at h
    have h' : ((D0V.coeff Γ : ℚ) : ℝ) = (m : ℝ) * (((Γ.ordForm (pullbackRationalPluriForms sT g ρ) :
        ℚ) : ℝ) + ((C.coeff Γ : ℚ) : ℝ)) := by
      rw [h, zsmul_eq_mul]; push_cast; ring
    rw [Fin.sum_univ_one, QDivisor.coeff_toRDivisor]
    push_cast at h' ⊢
    rw [h']
    field_simp
  · haveI := hE
    exact (inferInstance : IsProper (E.f ≫ g))
  · have h := congrArg (fun D : QDivisor T => D.coeff Γ) hD0
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      coeff_divisorOfForm] at h
    have h' : ((D0.coeff Γ : ℚ) : ℝ) = (m : ℝ) * (((Γ.ordForm ρ : ℚ) : ℝ) +
        ((BT.coeff Γ : ℚ) : ℝ)) := by
      rw [h, zsmul_eq_mul]; push_cast; ring
    rw [Fin.sum_univ_one, QDivisor.coeff_toRDivisor]
    push_cast at h' ⊢
    rw [h']
    field_simp
  · have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sT)
      hK.topologicalKrullDim_eq
    have hc := pullbackRationalPluriForms_comp' g E.f hg.functionFieldMap_bijective
      E.isBirationalMorphism.functionFieldMap_bijective hd ρ
    have : (compDivisorOver g hV hg E).ordPullback ρ =
        E.ordPullback (pullbackRationalPluriForms sT g ρ) := by
      change E.E.ordForm (pullbackRationalPluriForms sT (E.f ≫ g) ρ) =
        E.E.ordForm (pullbackRationalPluriForms (g ≫ sT) E.f (pullbackRationalPluriForms sT g ρ))
      rw [hc]
      rfl
    rw [this]
    rfl

/-- **A crepant proper birational morphism is a crepant birational map.** If `g : V ⟶ T` is a
proper birational morphism of normal varieties and `g^*(div ρ + B_T) = div(g^*ρ) + C`, then
`g^* : k(T) ≅ k(V)` identifies the divisorial log discrepancies of `(V, C)` and `(T, B_T)`. -/
private theorem isCrepantBirationalMap_of_isPullback [PerfectField k] {T V : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)} [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    [LocallyOfFiniteType sT] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    (hT : IsNormalVariety k sT) (g : V ⟶ T) [IsProper g] (hg : IsBirationalMorphism g)
    (hV : IsNormalVariety k (g ≫ sT)) [IsDominant g] [LocallyOfFiniteType (g ≫ sT)] {d : ℕ}
    {ρ : RationalPluriForms sT d 1} (hρ : ρ ≠ 0) (hK : (divisorOfForm ρ).IsCanonicalDivisor sT d)
    (hρV : pullbackRationalPluriForms sT g ρ ≠ 0)
    (hKV : (divisorOfForm (pullbackRationalPluriForms sT g ρ)).IsCanonicalDivisor (g ≫ sT) d)
    {BT : QDivisor T} {C : QDivisor V} (hq : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsQCartier)
    {hgen : ∀ Z : irreducibleComponents V,
      g (componentGenericPoint V Z) ∉ (Divisor.toQDivisor (divisorOfForm ρ) + BT).supp}
    (hpb : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsPullback g hgen
      (Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms sT g ρ)) + C)) :
    IsCrepantBirationalMap (g ≫ sT) sT C BT
      (functionFieldAlgEquiv sT g hg.functionFieldMap_bijective) := by
  have hdT : topologicalKrullDim T = d := hK.topologicalKrullDim_eq
  have hdV : topologicalKrullDim V = d := hKV.topologicalKrullDim_eq
  intro v a
  constructor
  · rintro ⟨n', E, hEv, hEa⟩
    obtain rfl : n' = d := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hEa).symm.trans hdV
      exact_mod_cast this
    obtain ⟨a0, h1, h2⟩ := exists_isLogDiscrepancy_compDivisorOver hT g hg hV hρ hK hρV hKV hq hpb
      E hEa.2.1
    obtain rfl := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hEa h1 rfl
    refine ⟨n', compDivisorOver g hV hg E, ?_, h2⟩
    rw [valuation_compDivisorOver, hEv]
    rfl
  · rintro ⟨n', D, hDv, hDa⟩
    obtain rfl : n' = d := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDa).symm.trans hdT
      exact_mod_cast this
    obtain ⟨E, hE⟩ := exists_divisorOver_comap_eq hV hg D
    obtain ⟨E', hE'⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hV E
    obtain ⟨a0, h1, h2⟩ := exists_isLogDiscrepancy_compDivisorOver hT g hg hV hρ hK hρV hKV hq hpb
      E'.toDivisorOver E'.isProper
    have hval : (compDivisorOver g hV hg E'.toDivisorOver).valuation = D.valuation := by
      rw [valuation_compDivisorOver, hE]
      change (E'.valuation).comap _ = _
      rw [hE']
    obtain rfl := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hDa h2 hval.symm
    refine ⟨n', E'.toDivisorOver, ?_, h1⟩
    change E'.valuation = v
    rw [hE']
    ext x
    obtain ⟨y, rfl⟩ := hg.functionFieldMap_bijective.2 x
    have h3 := congrArg (fun w : Valuation T.functionField ℤᵐ⁰ => w y) (hE.symm.trans hDv)
    exact h3

/-- Two ring homomorphisms out of the function field of an integral scheme agree once the
induced morphisms of spectra agree after `Spec 𝒪_{X,η} ⟶ X`. -/
private theorem ringHom_ext_of_specMap_fromSpecStalk {X : Scheme.{0}} [IsIntegral X]
    {R : CommRingCat.{0}} {α β : X.functionField ⟶ R}
    (h : Spec.map α ≫ X.fromSpecStalk (genericPoint X) =
      Spec.map β ≫ X.fromSpecStalk (genericPoint X)) : α = β :=
  Spec.map_injective ((cancel_mono _).mp h)

/-- **The normalized graph of a birational map.** For a `k`-isomorphism `σ : k(X') ≅ k(X)` of
function fields of integral schemes proper over `k`, the normalization `W` of `X' ×_k X` in the
graph point `Spec k(X) ⟶ X' ×_k X` of `σ` is a normal integral scheme with proper birational
projections `p : W ⟶ X`, `q : W ⟶ X'` over `k` such that `q^* = p^* ∘ σ`. -/
private theorem exists_model_of_functionFieldEquiv {X X' : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral X']
    [IsProper sX] [IsProper sX'] (σ : FunctionFieldEquiv sX sX') :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsNormal W) (p : W ⟶ X) (q : W ⟶ X')
      (_ : IsDominant p) (_ : IsDominant q),
      IsProper p ∧ IsProper q ∧ IsBirational p ∧ IsBirational q ∧ p ≫ sX = q ≫ sX' ∧
      (letI := functionFieldAlgebra sX
       letI := functionFieldAlgebra sX'
       functionFieldMap q = (functionFieldMap p).comp σ.toRingEquiv.toRingHom) ∧
      ∃ g : W ⟶ Limits.pullback sX' sX, IsFinite g ∧ g ≫ Limits.pullback.snd sX' sX = p := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sX'
  set θ : X'.functionField →+* X.functionField := σ.toRingEquiv.toRingHom with hθ
  set F := X.fromSpecStalk (genericPoint X) with hF
  set F' := X'.fromSpecStalk (genericPoint X') with hF'
  have hα : (Spec.map (CommRingCat.ofHom θ) ≫ F') ≫ sX' = F ≫ sX := by
    rw [Category.assoc, hF', hF, MMP.fromSpecStalk_comp_eq,
      MMP.fromSpecStalk_comp_eq, ← Spec.map_comp]
    congr 1
    ext c
    exact σ.commutes c
  set γ : Spec X.functionField ⟶ Limits.pullback sX' sX :=
    Limits.pullback.lift (Spec.map (CommRingCat.ofHom θ) ≫ F') F hα with hγ
  haveI : QuasiCompact γ := quasiCompact_of_isField (by exact Field.toIsField _) _
  haveI : QuasiSeparated γ := QuasiSeparated.of_quasiSeparatedSpace _
  have hγs : γ ≫ Limits.pullback.snd sX' sX = F := Limits.pullback.lift_snd _ _ _
  have hγf : γ ≫ Limits.pullback.fst sX' sX = Spec.map (CommRingCat.ofHom θ) ≫ F' :=
    Limits.pullback.lift_fst _ _ _
  -- finiteness of the normalization
  haveI : LocallyOfFiniteType (Limits.pullback.snd sX' sX ≫ sX) := inferInstance
  have hP : IsNagataScheme (Limits.pullback sX' sX) :=
    isNagataScheme_of_locallyOfFiniteType (Limits.pullback.snd sX' sX ≫ sX)
      (isNagataScheme_spec_of_isNagataRing _ IsNagataRing.of_field)
  have : Finite (Spec X.functionField) :=
    inferInstanceAs (Finite (PrimeSpectrum X.functionField))
  haveI hfin : IsFinite γ.fromNormalization := by
    refine isFinite_fromNormalization γ hP
      (fun U _ => have : Finite U := Subtype.finite
        TopologicalSpace.NoetherianSpace.finite_irreducibleComponents) fun x => ?_
    let := (γ.residueFieldMap x.1).hom.toAlgebra
    have hsurj : Function.Surjective (γ.residueFieldMap x.1).hom := by
      have h := surjective_residueFieldMap_of_surjectiveOnStalks F x.1
      rw [Scheme.Hom.residueFieldMap_congr hγs.symm, Scheme.residueFieldMap_comp] at h
      exact fun z => ⟨_, (h z).choose_spec⟩
    have : Algebra.EssFiniteType (Limits.pullback sX' sX |>.residueField (γ x.1))
        ((Spec X.functionField).residueField x.1) := by
      rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
      exact (RingHom.FiniteType.of_surjective _ hsurj).essFiniteType
    exact IntermediateField.fg_top _ _
  haveI : IsNormal γ.normalization := isNormal_normalization_of_isField (by exact Field.toIsField _) _
  haveI : IsIntegral γ.normalization := inferInstance
  set u := γ.fromNormalization ≫ Limits.pullback.snd sX' sX with hu
  set v := γ.fromNormalization ≫ Limits.pullback.fst sX' sX with hv
  set j := γ.toNormalization with hj
  have hjγ : j ≫ γ.fromNormalization = γ := Scheme.Hom.toNormalization_fromNormalization γ
  have hju : j ≫ u = F := by rw [hu, ← Category.assoc, hjγ, hγs]
  have hjv : j ≫ v = Spec.map (CommRingCat.ofHom θ) ≫ F' := by
    rw [hv, ← Category.assoc, hjγ, hγf]
  letI := isDominant_fromSpecStalk_genericPoint X
  letI := isDominant_fromSpecStalk_genericPoint X'
  have : IsDominant (j ≫ u) := by rw [hju]; infer_instance
  haveI hud : IsDominant u := IsDominant.of_comp j _
  have : IsDominant (j ≫ v) := by
    rw [hjv]
    haveI : Surjective (Spec.map (CommRingCat.ofHom θ)) := surjective_specMap_of_field θ
    infer_instance
  haveI hvd : IsDominant v := IsDominant.of_comp j _
  haveI hjd : IsDominant j := inferInstance
  set E := (Spec X.functionField).fromSpecStalk (genericPoint (Spec X.functionField)) with hE
  have hFE : Spec.map (CommRingCat.ofHom (functionFieldMap F)) = E :=
    (cancel_mono F).mp (functionFieldMap_fromSpecStalk F)
  have h2 : (functionFieldMap j).comp (functionFieldMap u) = functionFieldMap F := by
    have : CommRingCat.ofHom ((functionFieldMap j).comp (functionFieldMap u)) =
        CommRingCat.ofHom (functionFieldMap F) := by
      refine ringHom_ext_of_specMap_fromSpecStalk ?_
      rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, functionFieldMap_fromSpecStalk u,
        ← Category.assoc, functionFieldMap_fromSpecStalk j, Category.assoc, hju, hFE]
    exact congrArg CommRingCat.Hom.hom this
  have h1 : (functionFieldMap j).comp (functionFieldMap v) = (functionFieldMap F).comp θ := by
    have : CommRingCat.ofHom ((functionFieldMap j).comp (functionFieldMap v)) =
        CommRingCat.ofHom ((functionFieldMap F).comp θ) := by
      refine ringHom_ext_of_specMap_fromSpecStalk ?_
      rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, functionFieldMap_fromSpecStalk v,
        ← Category.assoc, functionFieldMap_fromSpecStalk j, Category.assoc, hjv,
        CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hFE]
    exact congrArg CommRingCat.Hom.hom this
  have hFb := bijective_functionFieldMap_fromSpecStalk_genericPoint X
  have hcompat : functionFieldMap v = (functionFieldMap u).comp θ := by
    ext a
    apply (functionFieldMap j).injective
    have e1 := congrArg (fun φ => φ a) h1
    have e2 := congrArg (fun φ => φ (θ a)) h2
    simp only [RingHom.comp_apply] at e1 e2
    rw [e1, ← e2]
    rfl
  refine ⟨γ.normalization, inferInstance, inferInstance, u, v, hud, hvd, inferInstance,
    inferInstance, ?_, ?_, ?_, hcompat, γ.fromNormalization, hfin, rfl⟩
  · refine isBirational_of_surjective_functionFieldMap u fun w => ?_
    obtain ⟨a, ha⟩ := hFb.2 (functionFieldMap j w)
    refine ⟨a, (functionFieldMap j).injective ?_⟩
    have e2 := congrArg (fun φ => φ a) h2
    simp only [RingHom.comp_apply] at e2
    rw [e2, ha]
  · refine isBirational_of_surjective_functionFieldMap v fun w => ?_
    obtain ⟨a, ha⟩ := hFb.2 (functionFieldMap j w)
    obtain ⟨b, rfl⟩ := σ.surjective a
    refine ⟨b, (functionFieldMap j).injective ?_⟩
    have e1 := congrArg (fun φ => φ b) h1
    simp only [RingHom.comp_apply] at e1
    rw [e1, ← ha]
    rfl
  · rw [hu, hv, Category.assoc, Category.assoc, Limits.pullback.condition]

/-- **Log discrepancies of the prime divisors of a model.** If `p : W ⟶ X` is a proper birational
morphism of normal varieties and `G = p^*(div τ + B)`, the prime divisor `F` of `W` has log
discrepancy `1 + ord_F(p^*τ) - coeff_F G` over `(X, B)`. -/
private theorem isLogDiscrepancy_of_isPullback {X W : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]
    (hX : IsNormalVariety k sX) (p : W ⟶ X) [IsProper p] (hp : IsBirationalMorphism p)
    (hW : IsNormalVariety k (p ≫ sX)) [IsDominant p] [LocallyOfFiniteType (p ≫ sX)] {n : ℕ}
    {τ : RationalPluriForms sX n 1} (hτ : τ ≠ 0) (hK : (divisorOfForm τ).IsCanonicalDivisor sX n)
    {B : QDivisor X} {G : QDivisor W} (hq : (Divisor.toQDivisor (divisorOfForm τ) + B).IsQCartier)
    {hgen : ∀ Z : irreducibleComponents W,
      p (componentGenericPoint W Z) ∉ (Divisor.toQDivisor (divisorOfForm τ) + B).supp}
    (hpb : (Divisor.toQDivisor (divisorOfForm τ) + B).IsPullback p hgen G) (F : Mori.PrimeDivisor W) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨W, p, hW, hp, F⟩
      (1 + ((F.ordForm (pullbackRationalPluriForms sX p τ) : ℤ) : ℝ) - ((G.coeff F : ℚ) : ℝ)) := by
  set m := (Divisor.toQDivisor (divisorOfForm τ) + B).cartierIndex hq
  have hm : 0 < m := QDivisor.cartierIndex_pos hq
  obtain ⟨D0, hD0, hD0c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hq
  obtain ⟨D0W, hD0W, hpbW⟩ := hpb m hm D0 hD0 hD0c
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  refine ⟨hX, inferInstance, τ, hτ, ⟨_, hK, fun Γ => coeff_divisorOfForm _ Γ⟩, 1,
    fun _ => 1 / (m : ℝ), fun _ => D0, fun _ => D0W, fun _ => hD0c, fun Γ => ?_,
    fun _ => ⟨_, hpbW⟩, ?_⟩
  · have h := congrArg (fun D : QDivisor X => D.coeff Γ) hD0
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      coeff_divisorOfForm] at h
    have h' : ((D0.coeff Γ : ℚ) : ℝ) = (m : ℝ) * (((Γ.ordForm τ : ℚ) : ℝ) +
        ((B.coeff Γ : ℚ) : ℝ)) := by
      rw [h, zsmul_eq_mul]; push_cast; ring
    rw [Fin.sum_univ_one, QDivisor.coeff_toRDivisor]
    push_cast at h' ⊢
    rw [h']
    field_simp
  · have h := congrArg (fun D : QDivisor W => D.coeff F) hD0W
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul] at h
    have h' : ((D0W.coeff F : ℚ) : ℝ) = (m : ℝ) * ((G.coeff F : ℚ) : ℝ) := by
      rw [h, zsmul_eq_mul]; push_cast; ring
    rw [Fin.sum_univ_one]
    push_cast at h' ⊢
    rw [h']
    field_simp
    rfl

/-- **Pull-back of a transported form to a common model.** If `p : W ⟶ X` and `q : W ⟶ X'` are
birational with `q^* = p^* ∘ σ`, then along every prime divisor `F` of `W` the forms `p^*(σ^*τ)`
and `q^*τ` have the same order. -/
private theorem ordForm_pullback_pluriformPullback_eq [CharZero k] {X X' W : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral X']
    [IsLocallyNoetherian X'] [IsNormal X'] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX') {n : ℕ}
    (hn : topologicalKrullDim X = n) (hn' : topologicalKrullDim X' = n)
    (σ : FunctionFieldEquiv sX sX') (p : W ⟶ X) (q : W ⟶ X') (hp : IsBirationalMorphism p)
    (hq : IsBirationalMorphism q) (hWp : IsNormalVariety k (p ≫ sX))
    (hWq : IsNormalVariety k (q ≫ sX')) [IsDominant p] [IsDominant q]
    (hcompat : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a))
    (F : Mori.PrimeDivisor W) {m : ℤ} (τ : RationalPluriForms sX' n m) :
    F.ordForm (pullbackRationalPluriForms sX p (pluriformPullback sX sX' σ.toHom n m τ)) =
      F.ordForm (pullbackRationalPluriForms sX' q τ) := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType sX' := hX'.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (p ≫ sX) := hWp.1.toLocallyOfFiniteType
  haveI := hX.1
  haveI := hWp.1
  have hnW : topologicalKrullDim W = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hp).symm.trans hn
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sX'
  letI := functionFieldAlgebra (p ≫ sX)
  let ep : FunctionFieldEquiv (p ≫ sX) sX := functionFieldAlgEquiv sX p hp.functionFieldMap_bijective
  let σ' : FunctionFieldEquiv (p ≫ sX) sX' := σ.trans ep
  have h1 : pullbackRationalPluriForms sX p (pluriformPullback sX sX' σ.toHom n m τ) =
      pluriformPullback (p ≫ sX) sX' σ'.toHom n m τ := by
    have := pluriformPullback_comp (sX := p ≫ sX) (sX' := sX) (sX'' := sX') hnW hn hn' m
      ep.toHom σ.toHom τ
    exact this
  rw [h1]
  let D : DivisorOver k sX' := ⟨W, q, hWq, hq, F⟩
  have hv : ∀ g, D.valuation g = F.divisorialValuation ((σ'.toHom) g) := by
    intro g
    change F.divisorialValuation (functionFieldMap q g) = _
    rw [hcompat]
    rfl
  exact ordForm_pluriformPullback_eq_ordPullback hWp hX' hnW hn' σ' F D hv τ

/-- **Crepant birational maps have equal pull-backs on a common model.** If
`σ : (X, B) ⇢ (X', B')` is crepant, `p : W ⟶ X`, `q : W ⟶ X'` proper birational with
`q^* = p^* ∘ σ`, and `τ = σ^*τ'`, then `p^*(div τ + B) = q^*(div τ' + B')`. -/
private theorem pullback_eq_pullback_of_isCrepantBirationalMap [CharZero k] {X X' W : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX] [IsIntegral X']
    [IsLocallyNoetherian X'] [IsNormal X'] [CompactSpace X'] [LocallyOfFiniteType sX']
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX') {B : QDivisor X} {B' : QDivisor X'}
    (σ : FunctionFieldEquiv sX sX') (hσ : IsCrepantBirationalMap sX sX' B B' σ)
    (p : W ⟶ X) (q : W ⟶ X') [IsProper p] [IsProper q] (hp : IsBirationalMorphism p)
    (hq : IsBirationalMorphism q) (hWp : IsNormalVariety k (p ≫ sX))
    (hWq : IsNormalVariety k (q ≫ sX')) [IsDominant p] [IsDominant q]
    [LocallyOfFiniteType (p ≫ sX)] [LocallyOfFiniteType (q ≫ sX')]
    (hcompat : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a)) {n : ℕ}
    {τ' : RationalPluriForms sX' n 1} (hτ' : τ' ≠ 0)
    (hK' : (divisorOfForm τ').IsCanonicalDivisor sX' n)
    (hτ : pluriformPullback sX sX' σ.toHom n 1 τ' ≠ 0)
    (hK : (divisorOfForm (pluriformPullback sX sX' σ.toHom n 1 τ')).IsCanonicalDivisor sX n)
    (hQ : (Divisor.toQDivisor (divisorOfForm (pluriformPullback sX sX' σ.toHom n 1 τ')) +
      B).IsQCartier) (hQ' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsQCartier)
    {G G' : QDivisor W}
    {hgen : ∀ Z : irreducibleComponents W, p (componentGenericPoint W Z) ∉
      (Divisor.toQDivisor (divisorOfForm (pluriformPullback sX sX' σ.toHom n 1 τ')) + B).supp}
    {hgen' : ∀ Z : irreducibleComponents W, q (componentGenericPoint W Z) ∉
      (Divisor.toQDivisor (divisorOfForm τ') + B').supp}
    (hG : (Divisor.toQDivisor (divisorOfForm (pluriformPullback sX sX' σ.toHom n 1 τ')) +
      B).IsPullback p hgen G)
    (hG' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsPullback q hgen' G') : G = G' := by
  have hn : topologicalKrullDim X = n := hK.topologicalKrullDim_eq
  have hn' : topologicalKrullDim X' = n := hK'.topologicalKrullDim_eq
  refine Finsupp.ext fun F => ?_
  have h1 := isLogDiscrepancy_of_isPullback hX p hp hWp hτ hK hQ hG F
  have h2 := isLogDiscrepancy_of_isPullback hX' q hq hWq hτ' hK' hQ' hG' F
  obtain ⟨n'', D'', hD''v, hD''⟩ := (hσ _ _).mp ⟨n, _, rfl, h1⟩
  have hv : D''.valuation = (⟨W, q, hWq, hq, F⟩ : DivisorOver k sX').valuation := by
    rw [hD''v]
    ext g
    change F.divisorialValuation (functionFieldMap p ((σ.toHom) g)) =
      F.divisorialValuation (functionFieldMap q g)
    rw [hcompat]
  have he := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hD'' h2 hv
  have hord := ordForm_pullback_pluriformPullback_eq hX hX' hn hn' σ p q hp hq hWp hWq hcompat F τ'
  rw [hord] at he
  have : ((G.coeff F : ℚ) : ℝ) = ((G'.coeff F : ℚ) : ℝ) := by linarith
  exact_mod_cast this

/-- **The divisor of a nonzero rational top form on a normal variety is canonical.** -/
private theorem isCanonicalDivisor_divisorOfForm [PerfectField k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    [LocallyOfFiniteType sX] (hX : IsNormalVariety k sX) {n : ℕ} (hn : topologicalKrullDim X = n)
    {τ : RationalPluriForms sX n 1} (hτ : τ ≠ 0) : (divisorOfForm τ).IsCanonicalDivisor sX n := by
  letI := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hn
  have hb : (b () : RationalTopForms sX n) ≠ 0 := b.ne_zero ()
  have hK := MMP.Spreading.CanonExist.isCanonicalDivisor_topFormDivisor hX hn hb
  exact hK.of_linearlyEquivalent (by
    simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX hK hτ)

/-- A separated birational morphism of finite type onto a Noetherian integral scheme is a
birational morphism in the sense of rational maps. -/
private theorem isBirationalMorphism_of_isBirational' {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsNoetherian X] (f : Y ⟶ X) [IsSeparated f] [LocallyOfFiniteType f]
    (hf : IsBirational f) : IsBirationalMorphism f := by
  haveI := hf.isDominant
  obtain ⟨V, hV, hiso⟩ := exists_isIso_restrict_of_mem_genericPoints f hf (genericPoint X)
    (Stacks.Chow.genericPoint_mem_genericPoints X)
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE f (f ⁻¹ᵁ V) V
    ⟨genericPoint Y, show f (genericPoint Y) ∈ V by
      rwa [MMP.Positivity.map_genericPoint_eq_of_isDominant]⟩ ⟨_, hV⟩ le_rfl ?_
  simpa [Scheme.Hom.resLE] using hiso

/-- **The strict transform of a prime divisor.** If `p : W ⟶ X` is a proper birational morphism
onto a normal Noetherian integral scheme, every prime divisor `P` of `X` is the image of a prime
divisor `Q` of `W` over which `p` is an isomorphism near `η_P`; its valuation is that of `P`. -/
private theorem exists_primeDivisor_map_genericPoint_eq {X W : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsNoetherian X] [IsNormal X] [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] (hX : IsNormalVariety k sX) (p : W ⟶ X) [IsProper p]
    (hp : IsBirational p)
    (hW : IsNormalVariety k (p ≫ sX)) (P : Mori.PrimeDivisor X) :
    ∃ (Q : Mori.PrimeDivisor W) (U : X.Opens), p Q.genericPoint = P.genericPoint ∧
      P.genericPoint ∈ U ∧ IsIso (p ∣_ U) ∧
      haveI := hp.isDominant
      ∀ g, Q.divisorialValuation (functionFieldMap p g) = P.divisorialValuation g := by
  haveI := hp.isDominant
  haveI := Stacks.AlgebraicGeometry.UnitsNormalProper.isDiscreteValuationRing_stalk
    P.coheight_genericPoint
  obtain ⟨U, hPU, hUiso⟩ := exists_isIso_restrict_of_isDiscreteValuationRing p hp P.genericPoint
  obtain ⟨x, hx⟩ : P.genericPoint ∈ Set.range p := by
    rw [← p.isClosedMap.isClosed_range.closure_eq, p.denseRange.closure_range]; trivial
  have hxb : p x ∈ biregularLocus p := le_biregularLocus (f := p) (V := U) hUiso (hx ▸ hPU)
  have hx1 : Order.coheight x = 1 := by
    rw [← MMP.Positivity.coheight_map_of_mem_biregularLocus p hxb, hx]
    exact P.coheight_genericPoint
  set Q : Mori.PrimeDivisor W := AlgebraicGeometry.PrimeDivisor.ofCoheightOne x hx1
  have hQ : MMP.Mori.PrimeDivisor.genericPoint Q = x :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hx1
  haveI : LocallyOfFiniteType p := by
    have := hW.1.toLocallyOfFiniteType
    exact locallyOfFiniteType_of_comp p sX
  let D : DivisorOver k sX := ⟨W, p, hW, isBirationalMorphism_of_isBirational' p hp, Q⟩
  have hD := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX D P
    (by change p _ = _; rw [hQ, hx])
  refine ⟨Q, U, by rw [hQ, hx], hPU, hUiso, fun g => ?_⟩
  have h := congrArg (fun w => w g) hD
  change MMP.Mori.PrimeDivisor.divisorialValuation Q (functionFieldMap p g) =
    P.divisorialValuation (functionFieldMap (𝟙 X) g) at h
  rw [h, MMP.Mori.functionFieldMap_id_apply]

/-- **The normalization of a prime divisor.** A prime divisor `Q` of a normal variety `W` has a
normalization: a normal variety `N` with a proper morphism `ν : N ⟶ W` sending the generic point
of `N` to that of `Q`, whose stalk map there is surjective. -/
private theorem exists_normalization_primeDivisor' {W : Scheme.{0}} {sW : W ⟶ Spec (.of k)}
    [IsIntegral W] (hW : IsNormalVariety k sW) (Q : Mori.PrimeDivisor W) :
    ∃ (N : Scheme.{0}) (_ : IsIntegral N) (ν : N ⟶ W), IsNormalVariety k (ν ≫ sW) ∧ IsProper ν ∧
      ν (genericPoint N) = Q.genericPoint ∧ Function.Surjective (ν.stalkMap (genericPoint N)).hom := by
  have := Q.integral
  have := hW.1
  have : AlgebraicGeometry.IsVariety k (Q.idealSheaf.subschemeι ≫ sW) :=
    (MMP.Mori.isVariety_iff k _).mpr ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩
  obtain ⟨⟨hvar, hnorm, hfin, -, -⟩, -, -, -, -⟩ :=
    MMP.Threefold.normalization_spec (Q.idealSheaf.subschemeι ≫ sW)
  set Z := Q.idealSheaf.subscheme
  set hZ := MMP.finite_irreducibleComponents_of_isIntegral Z
  set ν₀ := Z.normalization hZ
  have hbir : IsBirational ν₀ := Scheme.isBirational_normalization _ _
  haveI : IsIntegral (Z.normalizationScheme hZ) := hvar.toIsIntegral
  haveI := hbir.isDominant
  have hgen : ν₀ (genericPoint _) = genericPoint Z := map_genericPoint_of_isDominant ν₀
  refine ⟨_, inferInstance, ν₀ ≫ Q.idealSheaf.subschemeι, ⟨by rw [Category.assoc]; exact hvar,
    hnorm⟩, inferInstance, ?_, ?_⟩
  · rw [Scheme.Hom.comp_apply, hgen]
    rfl
  · rw [Scheme.Hom.stalkMap_comp]
    have h1 : IsIso (ν₀.stalkMap (genericPoint _)) :=
      hbir.2 _ (by rw [genericPoints_eq_singleton]; rfl)
    have hA := Q.idealSheaf.subschemeι.stalkMap_surjective (ν₀ (genericPoint _))
    have hB := (ConcreteCategory.bijective_of_isIso (ν₀.stalkMap (genericPoint _))).2
    intro z
    obtain ⟨y, rfl⟩ := hB z
    obtain ⟨w, rfl⟩ := hA y
    exact ⟨w, rfl⟩

/-- A quasi-compact morphism from a reduced scheme whose image lies in the image of a closed
immersion `ι` factors through `ι`. -/
private theorem exists_comp_eq_of_range_subset {N Y Z : Scheme.{0}} [IsReduced N] (ι : Y ⟶ Z)
    [IsClosedImmersion ι] (g : N ⟶ Z) [QuasiCompact g] (h : Set.range g ⊆ Set.range ι) :
    ∃ α : N ⟶ Y, α ≫ ι = g := by
  have H : ι.ker ≤ g.ker := Stacks.Chow.ker_le_of_support_subset_range ι g.ker (by
    rw [Scheme.Hom.support_ker]
    exact closure_minimal h ι.isClosedEmbedding.isClosed_range)
  exact ⟨IsClosedImmersion.lift ι g H, IsClosedImmersion.lift_fac _ _ _⟩

/-- **Stalk maps and function field maps.** For a dominant morphism `f : W ⟶ X` of integral
schemes, a point `y` of `W` and a specialization `z` of `f y`, restricting from `z` to `f y`,
pulling back to `y` and passing to `k(W)` is `𝒪_{X,z} → k(X) → k(W)`. -/
private theorem stalkSpecializes_stalkMap_algebraMap {W X : Scheme.{0}} [IsIntegral W]
    [IsIntegral X] (f : W ⟶ X) [IsDominant f] (y : W) (z : X) (h : f y ⤳ z) :
    X.presheaf.stalkSpecializes h ≫ f.stalkMap y ≫
        CommRingCat.ofHom (algebraMap (W.presheaf.stalk y) W.functionField) =
      CommRingCat.ofHom (algebraMap (X.presheaf.stalk z) X.functionField) ≫
        CommRingCat.ofHom (functionFieldMap f) := by
  have h0 : genericPoint W ⤳ y := (genericPoint_spec W).specializes trivial
  have h1 : genericPoint X ⤳ z := (genericPoint_spec X).specializes trivial
  change X.presheaf.stalkSpecializes h ≫ f.stalkMap y ≫ W.presheaf.stalkSpecializes h0 =
    X.presheaf.stalkSpecializes h1 ≫ ((X.presheaf.stalkCongr (Inseparable.of_eq
      (map_genericPoint_of_isDominant f).symm)).hom ≫ f.stalkMap (genericPoint W))
  rw [← Scheme.Hom.stalkSpecializes_stalkMap, TopCat.Presheaf.stalkCongr_hom, ← Category.assoc,
    ← Category.assoc, TopCat.Presheaf.stalkSpecializes_comp]
  congr 1
  exact (TopCat.Presheaf.stalkSpecializes_comp _ _ _).symm

/-- **Stalk maps along a lift through a closed immersion.** If `α : N ⟶ T` lifts `ν ≫ p` through
`ι : T ⟶ X`, then for a germ `a` at the generic point of `T`, pulling back along `p` and `ν` gives
`α^*(a|_T)`. -/
private theorem stalkMap_apply_eq_functionFieldMap_apply {X T W N : Scheme.{0}} [IsIntegral T]
    [IsIntegral N] (p : W ⟶ X) (ι : T ⟶ X) (ν : N ⟶ W) (α : N ⟶ T) [IsDominant α]
    (hα : α ≫ ι = ν ≫ p) (hp : p (ν (genericPoint N)) ⤳ ι (genericPoint T))
    (a : X.presheaf.stalk (ι (genericPoint T))) :
    (ν.stalkMap (genericPoint N)).hom ((p.stalkMap _).hom ((X.presheaf.stalkSpecializes hp).hom a)) =
      functionFieldMap α ((ι.stalkMap (genericPoint T)).hom a) := by
  have hα0 : α (genericPoint N) ⤳ genericPoint T := by rw [map_genericPoint_of_isDominant α]
  have hαf : functionFieldMap α = (T.presheaf.stalkSpecializes hα0 ≫ α.stalkMap _).hom := by
    unfold functionFieldMap
    rw [TopCat.Presheaf.stalkCongr_hom]
  have key : X.presheaf.stalkSpecializes hp ≫ p.stalkMap _ ≫ ν.stalkMap (genericPoint N) =
      ι.stalkMap (genericPoint T) ≫ T.presheaf.stalkSpecializes hα0 ≫
        α.stalkMap (genericPoint N) := by
    apply Spec.map_injective
    apply (cancel_mono (X.fromSpecStalk (ι (genericPoint T)))).1
    rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.SpecMap_stalkMap_fromSpecStalk,
      ← Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk, Category.assoc, ← hα,
      Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
    simp only [Category.assoc]
    rw [← Category.assoc (Spec.map (T.presheaf.stalkSpecializes hα0)),
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    simp only [Category.assoc]
    rw [← Category.assoc (Spec.map (α.stalkMap (genericPoint N))),
      Scheme.SpecMap_stalkMap_fromSpecStalk, Category.assoc]
  rw [hαf]
  exact congrArg (fun φ => φ.hom a) key

/-- **Function field maps through a common model.** Let `p : W ⟶ X`, `q : W ⟶ X'` be dominant with
`q^* = p^* ∘ σ`, let `ι : T ⟶ X`, `ι' : T' ⟶ X'` be integral closed subschemes, and `ψ` a map of
local rings at their generic points compatible with `σ`, inducing `σ_T : k(T') → k(T)`. If
`ν : N ⟶ W` sends the generic point of `N` to a point over `T` and `T'`, and `α : N ⟶ T`,
`β : N ⟶ T'` lift `ν ≫ p` and `ν ≫ q`, then `β^* = α^* ∘ σ_T`. -/
private theorem functionFieldMap_eq_comp_of_stalkMap {X X' T T' W N : Scheme.{0}} [IsIntegral X]
    [IsIntegral X'] [IsIntegral T] [IsIntegral T'] [IsIntegral W] [IsIntegral N]
    (σ : X'.functionField →+* X.functionField) (p : W ⟶ X) (q : W ⟶ X') [IsDominant p]
    [IsDominant q] (hcompat : functionFieldMap q = (functionFieldMap p).comp σ)
    (ι : T ⟶ X) (ι' : T' ⟶ X') [IsClosedImmersion ι']
    (ψ : X'.presheaf.stalk (ι' (genericPoint T')) →+* X.presheaf.stalk (ι (genericPoint T)))
    (hψ : ∀ a, algebraMap _ X.functionField (ψ a) = σ (algebraMap _ X'.functionField a))
    (σT : T'.functionField →+* T.functionField)
    (hσT : ∀ a, σT ((ι'.stalkMap (genericPoint T')).hom a) =
      (ι.stalkMap (genericPoint T)).hom (ψ a))
    (ν : N ⟶ W) (α : N ⟶ T) (β : N ⟶ T') [IsDominant α] [IsDominant β]
    (hα : α ≫ ι = ν ≫ p) (hβ : β ≫ ι' = ν ≫ q)
    (hp : p (ν (genericPoint N)) ⤳ ι (genericPoint T))
    (hq : q (ν (genericPoint N)) ⤳ ι' (genericPoint T')) :
    functionFieldMap β = (functionFieldMap α).comp σT := by
  set y := ν (genericPoint N)
  have key3 : ∀ a, (X'.presheaf.stalkSpecializes hq ≫ q.stalkMap y).hom a =
      (X.presheaf.stalkSpecializes hp ≫ p.stalkMap y).hom (ψ a) := by
    intro a
    apply IsFractionRing.injective (W.presheaf.stalk y) W.functionField
    have e1 := congrArg (fun φ => φ.hom a) (stalkSpecializes_stalkMap_algebraMap q y _ hq)
    have e2 := congrArg (fun φ => φ.hom (ψ a)) (stalkSpecializes_stalkMap_algebraMap p y _ hp)
    refine e1.trans (Eq.trans ?_ e2.symm)
    change functionFieldMap q (algebraMap _ _ a) = functionFieldMap p (algebraMap _ _ (ψ a))
    rw [hcompat, RingHom.comp_apply, hψ]
  ext b
  obtain ⟨a, rfl⟩ := ι'.stalkMap_surjective (genericPoint T') b
  rw [RingHom.comp_apply, hσT, ← stalkMap_apply_eq_functionFieldMap_apply q ι' ν β hβ hq,
    ← stalkMap_apply_eq_functionFieldMap_apply p ι ν α hα hp]
  exact congrArg (ν.stalkMap (genericPoint N)).hom (key3 a)

/-- **Birationality of a lift.** If `α : N ⟶ T` lifts `ν ≫ p` through `ι : T ⟶ X`, `p` is an
isomorphism of stalks at `ν(η_N)`, `ν(η_N)` lies over `ι(η_T)` and the stalk map of `ν` at the
generic point is surjective, then `α^* : k(T) → k(N)` is surjective. -/
private theorem surjective_functionFieldMap_of_lift {X T W N : Scheme.{0}} [IsIntegral T]
    [IsIntegral N] (p : W ⟶ X) (ι : T ⟶ X) (ν : N ⟶ W) (α : N ⟶ T) [IsDominant α]
    (hα : α ≫ ι = ν ≫ p) (hpν : p (ν (genericPoint N)) = ι (genericPoint T))
    (hiso : IsIso (p.stalkMap (ν (genericPoint N))))
    (hν : Function.Surjective (ν.stalkMap (genericPoint N)).hom) :
    Function.Surjective (functionFieldMap α) := by
  have hp : p (ν (genericPoint N)) ⤳ ι (genericPoint T) := by rw [hpν]
  have hsp : IsIso (X.presheaf.stalkSpecializes hp) := by
    have := (X.presheaf.stalkCongr (Inseparable.of_eq hpν.symm)).isIso_hom
    rw [TopCat.Presheaf.stalkCongr_hom] at this
    exact this
  intro z
  obtain ⟨w, rfl⟩ := hν z
  obtain ⟨b, rfl⟩ := (ConcreteCategory.bijective_of_isIso (p.stalkMap _)).2 w
  obtain ⟨a, rfl⟩ := (ConcreteCategory.bijective_of_isIso (X.presheaf.stalkSpecializes hp)).2 b
  exact ⟨_, (stalkMap_apply_eq_functionFieldMap_apply p ι ν α hα hp a).symm⟩

/-- `MMP.Fourfold.IsCrepantBirationalMap` for a crepant proper birational morphism
`g : V ⟶ T`, for any structure morphism `s_V = g ≫ s_T` of `V` and any `k`-isomorphism
`e : k(T) ≅ k(V)` acting as `g^*`. -/
private theorem isCrepantBirationalMap_of_isPullback' [PerfectField k] {T V : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)} [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    [LocallyOfFiniteType sT] [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] [CompactSpace V]
    (hT : IsNormalVariety k sT) (g : V ⟶ T) [IsProper g] (hg : IsBirationalMorphism g)
    (hV : IsNormalVariety k (g ≫ sT)) [IsDominant g] [LocallyOfFiniteType (g ≫ sT)] {d : ℕ}
    {ρ : RationalPluriForms sT d 1} (hρ : ρ ≠ 0) (hK : (divisorOfForm ρ).IsCanonicalDivisor sT d)
    (hρV : pullbackRationalPluriForms sT g ρ ≠ 0)
    (hKV : (divisorOfForm (pullbackRationalPluriForms sT g ρ)).IsCanonicalDivisor (g ≫ sT) d)
    {BT : QDivisor T} {C : QDivisor V} (hq : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsQCartier)
    {hgen : ∀ Z : irreducibleComponents V,
      g (componentGenericPoint V Z) ∉ (Divisor.toQDivisor (divisorOfForm ρ) + BT).supp}
    (hpb : (Divisor.toQDivisor (divisorOfForm ρ) + BT).IsPullback g hgen
      (Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms sT g ρ)) + C))
    {sV : V ⟶ Spec (.of k)} (hsV : g ≫ sT = sV) (e : FunctionFieldEquiv sV sT)
    (he : ∀ a, e a = functionFieldMap g a) :
    IsCrepantBirationalMap sV sT C BT e := by
  subst hsV
  have : e = functionFieldAlgEquiv sT g hg.functionFieldMap_bijective := by
    letI := functionFieldAlgebra sT
    letI := functionFieldAlgebra (g ≫ sT)
    exact AlgEquiv.ext he
  subst this
  exact isCrepantBirationalMap_of_isPullback hT g hg hV hρ hK hρV hKV hq hpb

/-- A normal integral scheme proper over a normal variety is a normal variety. -/
private theorem isNormalVariety_comp_of_isProper {X Y : Scheme.{0}} [IsIntegral Y] [IsNormal Y]
    {s : X ⟶ Spec (.of k)} (hs : IsNormalVariety k s) (f : Y ⟶ X) [IsProper f] :
    IsNormalVariety k (f ≫ s) := by
  obtain ⟨-, h1, h2, h3⟩ := (MMP.Mori.isVariety_iff k s).mp hs.1
  exact ⟨(MMP.Mori.isVariety_iff k (f ≫ s)).mpr
    ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩, inferInstance⟩

/-- **Crepancy between points.** A normal variety of dimension zero carries no divisors over it,
so every isomorphism of function fields of two such varieties is crepant. -/
private theorem isCrepantBirationalMap_of_topologicalKrullDim_eq_zero {T T' : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)} {sT' : T' ⟶ Spec (.of k)} [IsIntegral T] [IsLocallyNoetherian T]
    [IsNormal T] [IsIntegral T'] [IsLocallyNoetherian T'] [IsNormal T']
    (hT : topologicalKrullDim T = 0) (hT' : topologicalKrullDim T' = 0) (B : QDivisor T)
    (B' : QDivisor T') (σ : FunctionFieldEquiv sT sT') :
    IsCrepantBirationalMap sT sT' B B' σ := by
  have key : ∀ {S : Scheme.{0}} {s : S ⟶ Spec (.of k)} [IsIntegral S] [IsLocallyNoetherian S]
      [IsNormal S], topologicalKrullDim S = 0 → ∀ (C : QDivisor S) v a,
      ¬ HasLogDiscrepancy s C v a := by
    intro S s _ _ _ hS C v a h
    obtain ⟨n, D, -, hD⟩ := h
    obtain ⟨hSv, -⟩ := hD
    have := D.isIntegral
    haveI := hSv.1
    haveI := D.isNormalVariety.1
    have hY : topologicalKrullDim D.Y = 0 :=
      (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism s (D.f ≫ s)
        D.isBirationalMorphism).symm.trans hS
    have h1 := AlgebraicGeometry.coheight_le_topologicalKrullDim D.E.genericPoint
    rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint, hY] at h1
    exact absurd h1 (by decide)
  intro v a
  exact ⟨fun h => absurd h (key hT B v a), fun h => absurd h (key hT' B' _ a)⟩

/-- A birational morphism `g : V ⟶ T` gives a `k`-isomorphism `k(T) ≅ k(V)` acting as `g^*` for
every structure morphism `s_V = g ≫ s_T` of `V`. -/
private theorem exists_functionFieldEquiv_of_comp_eq {V T : Scheme.{0}} [IsIntegral V]
    [IsIntegral T] {sT : T ⟶ Spec (.of k)} {sV : V ⟶ Spec (.of k)} (g : V ⟶ T) [IsDominant g]
    (hg : Function.Bijective (functionFieldMap g)) (h : g ≫ sT = sV) :
    ∃ e : FunctionFieldEquiv sV sT, ∀ a, e a = functionFieldMap g a := by
  subst h
  exact ⟨functionFieldAlgEquiv sT g hg, fun _ => rfl⟩

/-- The generic point of a prime divisor along which a `ℚ`-divisor has coefficient zero is not in
its support. -/
private theorem genericPoint_notMem_supp_of_coeff_eq_zero {Y : Scheme.{0}} {R : Type*} [Zero R]
    {D : DivisorWithCoeffs R Y}
    {P : Mori.PrimeDivisor Y} (h : D.coeff P = 0) : P.genericPoint ∉ D.supp := by
  intro hm
  obtain ⟨E, hE, hPE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hm
  obtain rfl := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE
  exact hE h

/-- The pull-back predicate only depends on the morphism, not on how it is written. -/
private theorem isPullback_of_hom_eq {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f g : X ⟶ Y} (h : f = g) {D : QDivisor Y}
    {hf : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D.supp}
    {hg : ∀ Z : irreducibleComponents X, g (componentGenericPoint X Z) ∉ D.supp} {D' : QDivisor X}
    (H : D.IsPullback f hf D') : D.IsPullback g hg D' := by
  subst h
  exact H

/-- The pull-back predicate only depends on the divisor pulled back. -/
private theorem isPullback_of_eq_source {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : X ⟶ Y} {D₁ D₂ : QDivisor Y} (h : D₁ = D₂)
    {h₁ : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D₁.supp}
    {h₂ : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D₂.supp} {D' : QDivisor X}
    (H : D₁.IsPullback f h₁ D') : D₂.IsPullback f h₂ D' := by
  subst h
  exact H

/-- The pull-back of a `ℚ`-Cartier `ℚ`-divisor is `ℚ`-Cartier. -/
private theorem isQCartier_of_isPullback {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] {f : X ⟶ Y} {D : QDivisor Y} (hD : D.IsQCartier)
    {hf : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D.supp} {D' : QDivisor X}
    (H : D.IsPullback f hf D') : D'.IsQCartier := by
  obtain ⟨C, hC, hCc⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hD
  obtain ⟨C', hC', hpb⟩ := H _ (QDivisor.cartierIndex_pos hD) C hC hCc
  exact ⟨_, by exact_mod_cast (QDivisor.cartierIndex_pos hD).ne', C', hC', hpb.isCartier hCc⟩

/-- Pull-backs of `ℚ`-divisors compose. -/
private theorem qDivisor_isPullback_comp' {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsLocallyNoetherian Z] [IsNormal Z] (p : Y ⟶ X) (q : Z ⟶ Y) {M : QDivisor X}
    {MY : QDivisor Y} {MZ : QDivisor Z}
    {hM : ∀ C : irreducibleComponents Y, p (componentGenericPoint Y C) ∉ M.supp}
    {hMY : ∀ C : irreducibleComponents Z, q (componentGenericPoint Z C) ∉ MY.supp}
    (h₁ : M.IsPullback p hM MY) (h₂ : MY.IsPullback q hMY MZ)
    (hM' : ∀ C : irreducibleComponents Z, (q ≫ p) (componentGenericPoint Z C) ∉ M.supp) :
    M.IsPullback (q ≫ p) hM' MZ := fun m hm D hD hDc => by
  obtain ⟨D', hD', hpb⟩ := h₁ m hm D hD hDc
  obtain ⟨D'', hD'', hpb'⟩ := h₂ m hm D' hD' (hpb.isCartier hDc)
  exact ⟨D'', hD'', MMP.ProgramBaseChange.divisor_isPullback_comp rfl hpb hpb' _⟩

/-- A morphism out of an irreducible scheme whose generic point maps to the generic point of a
prime divisor `P_f` lands in the image of any closed immersion onto `P_f`. -/
private theorem range_comp_subset_of_map_genericPoint {N W Y Z : Scheme.{0}} [IrreducibleSpace N]
    (ν : N ⟶ W) (f : W ⟶ Y) (ιf : Z ⟶ Y) (Pf : Mori.PrimeDivisor Y)
    (hr : Set.range ιf.base = (Pf.support : Set Y))
    (h : f (ν (genericPoint N)) = Pf.genericPoint) :
    Set.range (ν ≫ f).base ⊆ Set.range ιf.base := by
  rintro _ ⟨z, rfl⟩
  rw [hr, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  have hz : genericPoint N ⤳ z := (genericPoint_spec N).specializes trivial
  have h2 := hz.map (ν ≫ f).base.hom.continuous
  change (ν ≫ f) (genericPoint N) ⤳ (ν ≫ f) z at h2
  rw [Scheme.Hom.comp_apply, h] at h2
  exact specializes_iff_mem_closure.mp h2

/-- **Crepant maps induce crepant maps on floor divisors.** Let `σ : (X, B) ⇢ (X', B')` be a
crepant birational map of normal varieties proper over `k`, and `T ⊂ X`, `T' ⊂ X'` normal floor
divisors with their differents `B_T`, `B_{T'}`, such that `σ` identifies the local rings
`𝒪_{X',T'} ≅ 𝒪_{X,T}` and so induces `σ_T : k(T') ≅ k(T)`. Then `σ_T` is a crepant birational map
`(T, B_T) ⇢ (T', B_{T'})`: on the normalization `N` of the strict transform of `T` on a common
model `W`, both adjunction pairs pull back to the restriction of the common pull-back
`p^*(K_X + B) = q^*(K_{X'} + B')`. -/
private theorem isCrepantBirationalMap_of_isAdjunctionStep [IsAlgClosed k] [CharZero k]
    {X X' T T' : Scheme.{0}} {sX : X ⟶ Spec (.of k)} {sX' : X' ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    [IsProper sX] [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X'] [CompactSpace X']
    [LocallyOfFiniteType sX'] [IsProper sX']
    (hX : IsNormalVariety k sX) (hX' : IsNormalVariety k sX') {n : ℕ}
    (hn : topologicalKrullDim X = (n + 1 : ℕ)) (hn' : topologicalKrullDim X' = (n + 1 : ℕ))
    {B : QDivisor X} {B' : QDivisor X'} {K : Divisor X} {K' : Divisor X'}
    (hK : K.IsCanonicalDivisor sX (n + 1)) (hK' : K'.IsCanonicalDivisor sX' (n + 1))
    (hKB : (Divisor.toQDivisor K + B).IsQCartier) (hKB' : (Divisor.toQDivisor K' + B').IsQCartier)
    (σ : FunctionFieldEquiv sX sX') (hσ : IsCrepantBirationalMap sX sX' B B' σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [CompactSpace T]
    [IsIntegral T'] [IsLocallyNoetherian T'] [IsNormal T'] [CompactSpace T']
    {ι : T ⟶ X} {ι' : T' ⟶ X'} [IsClosedImmersion ι] [IsClosedImmersion ι']
    {BT : QDivisor T} {BT' : QDivisor T'}
    (hι : IsAdjunctionStep sX B ι BT) (hι' : IsAdjunctionStep sX' B' ι' BT')
    (P : Mori.PrimeDivisor X) (P' : Mori.PrimeDivisor X')
    (hrP : Set.range ι.base = (P.support : Set X)) (hrP' : Set.range ι'.base = (P'.support : Set X'))
    (hP' : ∀ g, P'.divisorialValuation g = P.divisorialValuation ((σ.toHom) g))
    (ψ : X'.presheaf.stalk (ι' (genericPoint T')) →+* X.presheaf.stalk (ι (genericPoint T)))
    (hψ : ∀ a, algebraMap _ X.functionField (ψ a) = (σ.toHom) (algebraMap _ X'.functionField a))
    (hord : ∀ a, X.ord (algebraMap _ X.functionField (ψ a)) (ι (genericPoint T)) =
      X'.ord (algebraMap _ X'.functionField a) (ι' (genericPoint T')))
    (σT : FunctionFieldEquiv (ι ≫ sX) (ι' ≫ sX'))
    (hσT : ∀ a, (σT.toHom) ((ι'.stalkMap (genericPoint T')).hom a) =
      (ι.stalkMap (genericPoint T)).hom (ψ a)) :
    IsCrepantBirationalMap (ι ≫ sX) (ι' ≫ sX') BT BT' σT := by
  have hT := hι.1
  have hT' := hι'.1
  haveI : LocallyOfFiniteType (ι ≫ sX) := hT.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι' ≫ sX') := hT'.1.toLocallyOfFiniteType
  have hdT : topologicalKrullDim T = n := topologicalKrullDim_eq_of_range_eq_support sX ι P hrP hn
  have hdT' : topologicalKrullDim T' = n :=
    topologicalKrullDim_eq_of_range_eq_support sX' ι' P' hrP' hn'
  rcases Nat.eq_zero_or_pos n with rfl | hnpos
  · exact isCrepantBirationalMap_of_topologicalKrullDim_eq_zero (by exact_mod_cast hdT)
      (by exact_mod_cast hdT') BT BT' σT
  obtain ⟨Q'⟩ := MMP.Positivity.nonempty_primeDivisor_of_topologicalKrullDim_eq hdT' hnpos.ne'
  -- a form `τ'` with a simple pole along `T'` and its residue `ρ'`
  obtain ⟨τ', hτ'0, hτ'P, -, ρ', hρ', hρ'0, -⟩ :=
    MMP.Fourfold.exists_form_of_residue_order sX' hX' (by exact_mod_cast hn') ι' hT'
      P' hrP' Q'
  -- its transport `τ = σ^*τ'`, with residue `ρ = σ_T^*ρ'`
  set τ := pluriformPullback sX sX' σ.toHom (n + 1) 1 τ' with hτdef
  set ρ := pluriformPullback (ι ≫ sX) (ι' ≫ sX') σT.toHom n 1 ρ' with hρdef
  have hρres : IsPoincareResidue sX ι n 1 τ ρ :=
    isPoincareResidue_pluriformPullback ι ι' hn hn' hdT hdT' σ.toHom σT.toHom ψ hψ
      (fun a => (hσT a).symm) hord hρ'
  have hτP : P.ordForm τ = -1 := by
    have hv : ∀ g, (DivisorOver.ofPrimeDivisor k hX' P').valuation g =
        P.divisorialValuation ((σ.toHom) g) := by
      intro g
      change P'.divisorialValuation (functionFieldMap (𝟙 X') g) = _
      rw [MMP.Mori.functionFieldMap_id_apply, hP']
    rw [hτdef, ordForm_pluriformPullback_eq_ordPullback hX hX' hn hn' σ P _ hv τ',
      DivisorOver.ordPullback_ofPrimeDivisor hX' hn' P' τ', hτ'P]
  have hτ0 : τ ≠ 0 := by
    intro h
    rw [h, Mori.PrimeDivisor.ordForm_zero] at hτP
    exact absurd hτP (by decide)
  have hD : (Divisor.toQDivisor (divisorOfForm τ) + B).IsQCartier :=
    hKB.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX hK hτ0).symm)
  have hD' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsQCartier :=
    hKB'.add_of_linearlyEquivalent (by
      simpa using (MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hX' hK' hτ'0).symm)
  -- adjunction on both sides
  obtain ⟨hgenT, hpbT⟩ := hι.isPullback_divisorOfForm_add_of_isPoincareResidue
    (by exact_mod_cast hn) P hrP τ hτ0 hτP ρ hρres hD
  obtain ⟨hgenT', hpbT'⟩ := hι'.isPullback_divisorOfForm_add_of_isPoincareResidue
    (by exact_mod_cast hn') P' hrP' τ' hτ'0 hτ'P ρ' hρ' hD'
  -- a common model `W` and the common pull-back `G = G'`
  obtain ⟨W, _, _, p, q, _, _, hpP, hqP, hpb, hqb, hpq, hcompat, -⟩ :=
    exists_model_of_functionFieldEquiv σ
  have hWp : IsNormalVariety k (p ≫ sX) := isNormalVariety_comp_of_isProper hX p
  have hWq : IsNormalVariety k (q ≫ sX') := isNormalVariety_comp_of_isProper hX' q
  haveI : LocallyOfFiniteType (p ≫ sX) := hWp.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (q ≫ sX') := hWq.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (p ≫ sX)
  haveI : CompactSpace W := by
    have := hWp.1
    exact QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  haveI : IsNoetherian X := {}
  haveI : IsNoetherian X' := {}
  have hpB : IsBirationalMorphism p := isBirationalMorphism_of_isBirational' p hpb
  have hqB : IsBirationalMorphism q := isBirationalMorphism_of_isBirational' q hqb
  have hcompat' : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a) := fun a => by
    rw [hcompat]
    rfl
  have hgenG := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' p
    (Divisor.toQDivisor (divisorOfForm τ) + B)
  have hgenG' := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' q
    (Divisor.toQDivisor (divisorOfForm τ') + B')
  set G := QDivisor.pullback _ hD hgenG
  have hG := QDivisor.isPullback_pullback hD hgenG
  have hG' := QDivisor.isPullback_pullback hD' hgenG'
  have hGG' := pullback_eq_pullback_of_isCrepantBirationalMap hX hX' σ hσ p q hpB hqB hWp hWq
    hcompat' hτ'0 (isCanonicalDivisor_divisorOfForm hX' hn' hτ'0) hτ0
    (isCanonicalDivisor_divisorOfForm hX hn hτ0) hD hD' hG hG'
  -- the strict transform `Q` of `T` on `W`, over both `T` and `T'`
  obtain ⟨Q, U, hQP, hPU, hUiso, hQv⟩ := exists_primeDivisor_map_genericPoint_eq hX p hpb hWp P
  have hqQ : q Q.genericPoint = P'.genericPoint := by
    let D1 : DivisorOver k sX' := ⟨W, q, hWq, hqB, Q⟩
    have hv : D1.valuation = (DivisorOver.ofPrimeDivisor k hX' P').valuation := by
      ext g
      change Q.divisorialValuation (functionFieldMap q g) =
        P'.divisorialValuation (functionFieldMap (𝟙 X') g)
      rw [MMP.Mori.functionFieldMap_id_apply, hcompat', hQv, hP']
    exact MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX'.1 hv
  -- the normalization `ν : N ⟶ W` of `Q` and the lifts `α : N ⟶ T`, `β : N ⟶ T'`
  obtain ⟨N, _, ν, hNv, hνP, hνη, hνsurj⟩ := exists_normalization_primeDivisor' hWp Q
  haveI := hνP
  haveI : IsNormal N := hNv.2
  have hιη := map_genericPoint_eq_of_range_eq ι P hrP
  have hι'η := map_genericPoint_eq_of_range_eq ι' P' hrP'
  have hpν : p (ν (genericPoint N)) = ι (genericPoint T) := by rw [hνη, hQP, hιη]
  have hqν : q (ν (genericPoint N)) = ι' (genericPoint T') := by rw [hνη, hqQ, hι'η]
  obtain ⟨α, hα⟩ := exists_comp_eq_of_range_subset ι (ν ≫ p)
    (range_comp_subset_of_map_genericPoint ν p ι P hrP (by rw [hpν, hιη]))
  obtain ⟨β, hβ⟩ := exists_comp_eq_of_range_subset ι' (ν ≫ q)
    (range_comp_subset_of_map_genericPoint ν q ι' P' hrP' (by rw [hqν, hι'η]))
  have hαη : α (genericPoint N) = genericPoint T := ι.isClosedEmbedding.injective (by
    rw [← Scheme.Hom.comp_apply, hα, Scheme.Hom.comp_apply, hpν])
  have hβη : β (genericPoint N) = genericPoint T' := ι'.isClosedEmbedding.injective (by
    rw [← Scheme.Hom.comp_apply, hβ, Scheme.Hom.comp_apply, hqν])
  haveI : IsDominant α := ⟨Dense.mono (s₁ := {genericPoint T})
    (Set.singleton_subset_iff.mpr ⟨_, hαη⟩) (dense_iff_closure_eq.mpr (genericPoint_spec T))⟩
  haveI : IsDominant β := ⟨Dense.mono (s₁ := {genericPoint T'})
    (Set.singleton_subset_iff.mpr ⟨_, hβη⟩) (dense_iff_closure_eq.mpr (genericPoint_spec T'))⟩
  -- `β^* = α^* ∘ σ_T`, and `α`, `β` are birational
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sX'
  letI := functionFieldAlgebra (ι ≫ sX)
  letI := functionFieldAlgebra (ι' ≫ sX')
  have hαβ : functionFieldMap β = (functionFieldMap α).comp (σT.toHom).toRingHom :=
    functionFieldMap_eq_comp_of_stalkMap (σ.toHom).toRingHom p q hcompat ι ι' ψ hψ
      (σT.toHom).toRingHom hσT ν α β hα hβ (by rw [hpν]) (by rw [hqν])
  haveI : IsNoetherian T := {}
  haveI : IsNoetherian T' := {}
  have hpiso : IsIso (p.stalkMap (ν (genericPoint N))) :=
    MMP.isIso_stalkMap_of_mem_biregularLocus p
      (le_biregularLocus (f := p) (V := U) hUiso (by rw [hpν, hιη]; exact hPU))
  have hαs := surjective_functionFieldMap_of_lift p ι ν α hα hpν hpiso hνsurj
  have hαbij : Function.Bijective (functionFieldMap α) := ⟨(functionFieldMap α).injective, hαs⟩
  have hβbij : Function.Bijective (functionFieldMap β) := by
    rw [hαβ]
    exact hαbij.comp σT.bijective
  haveI : IsProper α := by
    have : IsProper (α ≫ ι) := by rw [hα]; infer_instance
    exact IsProper.of_comp α ι
  haveI : IsProper β := by
    have : IsProper (β ≫ ι') := by rw [hβ]; infer_instance
    exact IsProper.of_comp β ι'
  have hαB : IsBirationalMorphism α :=
    isBirationalMorphism_of_isBirational' α (isBirational_of_surjective_functionFieldMap α hαs)
  have hβB : IsBirationalMorphism β :=
    isBirationalMorphism_of_isBirational' β (isBirational_of_surjective_functionFieldMap β hβbij.2)
  -- `N` as a normal variety over `k`
  have hsN : α ≫ ι ≫ sX = ν ≫ p ≫ sX := by rw [← Category.assoc, hα, Category.assoc]
  have hsβ : β ≫ ι' ≫ sX' = α ≫ ι ≫ sX := by
    rw [← Category.assoc, hβ, Category.assoc, ← hpq, hsN]
  have hNα : IsNormalVariety k (α ≫ ι ≫ sX) := hsN ▸ hNv
  have hNβ : IsNormalVariety k (β ≫ ι' ≫ sX') := hsβ ▸ hNα
  haveI : LocallyOfFiniteType (α ≫ ι ≫ sX) := hNα.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (β ≫ ι' ≫ sX') := hNβ.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian N := LocallyOfFiniteType.isLocallyNoetherian (α ≫ ι ≫ sX)
  haveI : CompactSpace N := by
    have := hNα.1
    exact QuasiCompact.compactSpace_of_compactSpace (α ≫ ι ≫ sX)
  -- the common pull-back `G` vanishes along `Q`
  have hBP := hι.coeff_eq_one hrP
  have hDP : (Divisor.toQDivisor (divisorOfForm τ) + B).coeff P = 0 := by
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hτP, hBP]
    norm_num
  have hGQ : G.coeff Q = 0 := by
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy
      (⟨hX, n + 1, K, hK, hKB⟩ : Mori.IsPair sX B) (isCanonicalDivisor_divisorOfForm hX hn hτ0)
      (DivisorOver.ofPrimeDivisor k hX P)
    have hc' : c = -B.coeff P := hc.eq_neg_coeff_of_ofPrimeDivisor hX
    have hlogP := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (show IsProper (𝟙 X) by infer_instance)
    have hlogQ := isLogDiscrepancy_of_isPullback hX p hpB hWp hτ0
      (isCanonicalDivisor_divisorOfForm hX hn hτ0) hD hG Q
    have hval : (⟨W, p, hWp, hpB, Q⟩ : DivisorOver k sX).valuation =
        (DivisorOver.ofPrimeDivisor k hX P).valuation := by
      ext g
      change Q.divisorialValuation (functionFieldMap p g) =
        P.divisorialValuation (functionFieldMap (𝟙 X) g)
      rw [MMP.Mori.functionFieldMap_id_apply, hQv]
    have he := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hlogQ hlogP hval
    haveI : IsIso (p.stalkMap Q.genericPoint) := by rw [← hνη]; exact hpiso
    have hordQ : Q.ordForm (pullbackRationalPluriForms sX p τ) = P.ordForm τ :=
      MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso p hpB.functionFieldMap_bijective
        (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn) Q P hQP τ
    rw [hordQ, hτP, hc', hBP] at he
    have : ((G.coeff Q : ℚ) : ℝ) = 0 := by push_cast at he ⊢; linarith
    exact_mod_cast this
  -- `H = (ν ≫ p)^*(div τ + B)`, computed through `T` and through `W`
  have hgenH : ∀ Z : irreducibleComponents N,
      (ν ≫ p) (componentGenericPoint N Z) ∉ (Divisor.toQDivisor (divisorOfForm τ) + B).supp := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply, hpν, hιη]
    exact genericPoint_notMem_supp_of_coeff_eq_zero hDP
  have hH := QDivisor.isPullback_pullback hD hgenH
  set H := QDivisor.pullback _ hD hgenH
  have hqT := isQCartier_of_isPullback hD hpbT
  have hqT' := isQCartier_of_isPullback hD' hpbT'
  have hgenα := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' α
    (Divisor.toQDivisor (divisorOfForm ρ) + BT)
  have hgenβ := MMP.Threefold.Resolution.map_componentGenericPoint_notMem_supp_of_isDominant' β
    (Divisor.toQDivisor (divisorOfForm ρ') + BT')
  have hEα := QDivisor.isPullback_pullback hqT hgenα
  have hEβ := QDivisor.isPullback_pullback hqT' hgenβ
  have hHα : H = QDivisor.pullback _ hqT hgenα :=
    (QDivisor.IsQCartier.existsUnique_isPullback hD hgenH).unique hH
      (isPullback_of_hom_eq hα (qDivisor_isPullback_comp' ι α hpbT hEα (by rw [hα]; exact hgenH)))
  have hgenν : ∀ Z : irreducibleComponents N, ν (componentGenericPoint N Z) ∉ G.supp := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint, hνη]
    exact genericPoint_notMem_supp_of_coeff_eq_zero hGQ
  have hqG := isQCartier_of_isPullback hD hG
  have hHν := QDivisor.isPullback_pullback hqG hgenν
  have hHHν : H = QDivisor.pullback _ hqG hgenν :=
    (QDivisor.IsQCartier.existsUnique_isPullback hD hgenH).unique hH
      (qDivisor_isPullback_comp' p ν hG hHν hgenH)
  have hgenν' : ∀ Z : irreducibleComponents N,
      ν (componentGenericPoint N Z) ∉ (QDivisor.pullback _ hD' hgenG').supp := by
    rw [← hGG']; exact hgenν
  have hgenH' : ∀ Z : irreducibleComponents N,
      (ν ≫ q) (componentGenericPoint N Z) ∉ (Divisor.toQDivisor (divisorOfForm τ') + B').supp := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply, hqν, hι'η]
    have hBP' := hι'.coeff_eq_one hrP'
    refine genericPoint_notMem_supp_of_coeff_eq_zero ?_
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_divisorOfForm, hτ'P, hBP']
    norm_num
  have hH' : (Divisor.toQDivisor (divisorOfForm τ') + B').IsPullback (ν ≫ q) hgenH' H := by
    rw [hHHν]
    exact qDivisor_isPullback_comp' q ν hG' (isPullback_of_eq_source (h₂ := hgenν') hGG' hHν)
      hgenH'
  have hHβ : H = QDivisor.pullback _ hqT' hgenβ :=
    (QDivisor.IsQCartier.existsUnique_isPullback hD' hgenH').unique hH'
      (isPullback_of_hom_eq hβ (qDivisor_isPullback_comp' ι' β hpbT' hEβ
        (by rw [hβ]; exact hgenH')))
  -- the forms `α^*ρ` and `β^*ρ'` on `N` have the same divisor
  have hcompatN : ∀ a, functionFieldMap β a = functionFieldMap α ((σT.toHom) a) := fun a => by
    rw [hαβ]
    rfl
  have hρ0 : ρ ≠ 0 := by
    intro h0
    apply hρ'0
    have e := pluriformPullback_comp (sX := ι' ≫ sX') (sX' := ι ≫ sX) (sX'' := ι' ≫ sX') hdT' hdT
      hdT' 1 (FunctionFieldEquiv.toHom (ι' ≫ sX') (ι ≫ sX) σT.symm) σT.toHom ρ'
    have h1 : (FunctionFieldEquiv.toHom (ι' ≫ sX') (ι ≫ sX) σT.symm).comp σT.toHom =
        FunctionFieldEquiv.toHom (ι' ≫ sX') (ι' ≫ sX') 1 := by
      ext a
      exact σT.symm_apply_apply a
    rw [← hρdef, h0, map_zero, h1, pluriformPullback_one hdT'] at e
    exact e.symm
  haveI := hT.1
  haveI := hT'.1
  haveI := hNα.1
  haveI := hNβ.1
  have hdN : topologicalKrullDim N = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (ι ≫ sX) (α ≫ ι ≫ sX)
      hαB).symm.trans hdT
  have hdNβ : topologicalKrullDim N = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (ι' ≫ sX') (β ≫ ι' ≫ sX')
      hβB).symm.trans hdT'
  have hρα0 : pullbackRationalPluriForms (ι ≫ sX) α ρ ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' α hαbij
      (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := ι ≫ sX) hdT) hρ0
  have hρβ0 : pullbackRationalPluriForms (ι' ≫ sX') β ρ' ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' β hβbij
      (toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := ι' ≫ sX') hdT') hρ'0
  have hdivαβ : divisorOfForm (pullbackRationalPluriForms (ι ≫ sX) α ρ) =
      divisorOfForm (pullbackRationalPluriForms (ι' ≫ sX') β ρ') := by
    refine Finsupp.ext fun F => ?_
    change (divisorOfForm _).coeff F = (divisorOfForm _).coeff F
    rw [coeff_divisorOfForm, coeff_divisorOfForm, hρdef]
    exact ordForm_pullback_pluriformPullback_eq hT hT' hdT hdT' σT α β hαB hβB hNα hNβ hcompatN F ρ'
  -- the crepant boundary `C` on `N`, and crepancy of `N ⟶ T` and of `N ⟶ T'`
  set C : QDivisor N := H - Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms (ι ≫ sX) α ρ))
  have hCα : Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms (ι ≫ sX) α ρ)) + C = H :=
    add_sub_cancel _ _
  have hCβ : Divisor.toQDivisor (divisorOfForm (pullbackRationalPluriForms (ι' ≫ sX') β ρ')) + C =
      H := by
    rw [← hdivαβ]
    exact hCα
  obtain ⟨eα, heα⟩ := exists_functionFieldEquiv_of_comp_eq (sT := ι ≫ sX) α hαbij rfl
  obtain ⟨eβ, heβ⟩ := exists_functionFieldEquiv_of_comp_eq (sT := ι' ≫ sX') β hβbij hsβ
  have crepA : IsCrepantBirationalMap (α ≫ ι ≫ sX) (ι ≫ sX) C BT eα :=
    isCrepantBirationalMap_of_isPullback' hT α hαB hNα hρ0 (isCanonicalDivisor_divisorOfForm hT hdT hρ0)
      hρα0 (isCanonicalDivisor_divisorOfForm hNα hdN hρα0) hqT (by rw [hCα, hHα]; exact hEα) rfl eα
      heα
  have crepB : IsCrepantBirationalMap (α ≫ ι ≫ sX) (ι' ≫ sX') C BT' eβ :=
    isCrepantBirationalMap_of_isPullback' hT' β hβB hNβ hρ'0
      (isCanonicalDivisor_divisorOfForm hT' hdT' hρ'0) hρβ0
      (isCanonicalDivisor_divisorOfForm hNβ hdNβ hρβ0) hqT' (by rw [hCβ, hHβ]; exact hEβ) hsβ eβ heβ
  letI := functionFieldAlgebra (α ≫ ι ≫ sX)
  have hσT' : eβ.trans eα.symm = σT := by
    ext a
    change eα.symm (eβ a) = σT a
    rw [AlgEquiv.symm_apply_eq, heα, heβ, hcompatN]
    rfl
  rw [← hσT']
  exact crepA.symm.trans crepB

end CrepantModel

/-! ### Floor models and single adjunction steps -/

/-- Two reduced closed subschemes with the same underlying set are isomorphic over the ambient
scheme. -/
private theorem exists_iso_comp_eq_of_range_eq {T₁ T₂ Z : Scheme.{0}} [IsReduced T₁]
    [IsReduced T₂] (i₁ : T₁ ⟶ Z) (i₂ : T₂ ⟶ Z) [IsClosedImmersion i₁] [IsClosedImmersion i₂]
    (h : Set.range i₁.base = Set.range i₂.base) : ∃ ψ : T₁ ≅ T₂, ψ.hom ≫ i₂ = i₁ := by
  obtain ⟨α, hα⟩ := exists_comp_eq_of_range_subset i₂ i₁ h.le
  obtain ⟨β, hβ⟩ := exists_comp_eq_of_range_subset i₁ i₂ h.ge
  refine ⟨⟨α, β, ?_, ?_⟩, hα⟩
  · rw [← cancel_mono i₁, Category.assoc, hβ, hα, Category.id_comp]
  · rw [← cancel_mono i₂, Category.assoc, hα, hβ, Category.id_comp]

/-- **An adjunction step onto a floor component.** On a dlt pair `(Y, B_Y)` of dimension `d + 1`
over `ℂ`, every prime divisor `Q` with `coeff_Q B_Y ≥ 1` is the image of an adjunction step
`T ⟶ Y` with its different `B_T`, and `(T, B_T)` is dlt. -/
private theorem exists_isAdjunctionStep_of_one_le_coeff {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    {BY : QDivisor Y} (hdlt : MMP.Intersection.IsDltPair sY BY) {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (Q : Mori.PrimeDivisor Y)
    (hQ : 1 ≤ BY.coeff Q) :
    ∃ (T : Scheme.{0}) (jT : T ⟶ Y) (BT : QDivisor T) (hj : IsAdjunctionStep sY BY jT BT),
      Set.range jT.base = (Q.support : Set Y) ∧
        haveI : IsIntegral T := hj.1.1.toIsIntegral
        haveI : IsNormal T := hj.1.2
        haveI : IsLocallyNoetherian T := by
          have := hj.1.1
          exact LocallyOfFiniteType.isLocallyNoetherian (jT ≫ sY)
        MMP.Intersection.IsDltPair (jT ≫ sY) BT := by
  have hinter : (⋂ P ∈ ({Q} : Finset (Mori.PrimeDivisor Y)), (P.support : Set Y)) =
      Q.support := by simp
  have hS : IsDltStratum sY BY (Q.support : Set Y) := by
    refine ⟨hdlt, {Q}, Finset.singleton_nonempty _, by simpa using hQ, ?_, ?_⟩
    · rw [hinter]
      exact ⟨Q.genericPoint, by
        rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
    · rw [hinter]
      refine ⟨⟨?_, le_rfl⟩, fun T hT _ => hT.2⟩
      rw [PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
  obtain ⟨⟨⟨T, ι, BT, hrange, ⟨F⟩⟩, hdltF⟩, -⟩ := hS.exists_isStratumAdjunctionPair_and_isDltPair
  have hdltT := hdltF F hrange
  cases F with
  | refl h =>
    exfalso
    have h1 : genericPoint Y ∈ Set.range (𝟙 Y : Y ⟶ Y).base := ⟨_, rfl⟩
    rw [hrange] at h1
    exact MMP.Threefold.Mori.OpenRestriction.genericPoint_notMem_support Q h1
  | @step S T ι₀ BS F₀ jT BT hj =>
    cases F₀ with
    | refl h =>
      have hj' : IsAdjunctionStep sY BY jT BT := by
        simpa only [Category.id_comp] using hj
      refine ⟨T, jT, BT, hj', by simpa using hrange, ?_⟩
      simpa only [Category.comp_id] using hdltT
    | step F₁ j₁ BT₁ hj₁ =>
      exfalso
      haveI : IsIntegral T := hj.1.1.toIsIntegral
      haveI := (StratumAdjunctionData.step (.step F₁ j₁ BS hj₁) jT BT hj).isClosedImmersion
      have hdT : topologicalKrullDim T = d :=
        topologicalKrullDim_eq_of_range_eq_support sY _ Q hrange hd
      have hlen := StratumAdjunctionData.dim_add_length (sX := sY) hd
        (StratumAdjunctionData.step (.step F₁ j₁ BS hj₁) jT BT hj) hdT
      simp only [StratumAdjunctionData.length] at hlen
      omega

/-- An isomorphism of integral schemes induces a bijection of function fields. -/
private theorem functionFieldMap_bijective_of_isIso {A A' : Scheme.{0}} [IsIntegral A]
    [IsIntegral A'] (e : A ≅ A') : Function.Bijective (functionFieldMap e.hom) := by
  refine Function.bijective_iff_has_inverse.mpr ⟨functionFieldMap e.inv, fun t => ?_, fun t => ?_⟩
  · rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_congr (Iso.inv_hom_id e), functionFieldMap_id_apply]
  · rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
      MMP.Positivity.DivisorOver.functionFieldMap_congr (Iso.hom_inv_id e), functionFieldMap_id_apply]

/-- **A crepant birational map matching two prime divisors matches their coefficients.** -/
private theorem coeff_eq_of_isCrepantBirationalMap {Y Y' : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    {sY : Y ⟶ Spec (.of ℂ)} {sY' : Y' ⟶ Spec (.of ℂ)} {BY : QDivisor Y} {BY' : QDivisor Y'}
    (hP : MMP.Mori.IsPair sY BY) (hP' : MMP.Mori.IsPair sY' BY') {d d' : ℕ} {K : Divisor Y}
    {K' : Divisor Y'} (hK : K.IsCanonicalDivisor sY d) (hK' : K'.IsCanonicalDivisor sY' d')
    (σ : FunctionFieldEquiv sY sY') (hσ : IsCrepantBirationalMap sY sY' BY BY' σ)
    (P : Mori.PrimeDivisor Y) (P' : Mori.PrimeDivisor Y')
    (hPP : ∀ g, P'.divisorialValuation g = P.divisorialValuation ((σ.toHom) g)) :
    BY'.coeff P' = BY.coeff P := by
  have hX := hP.isNormalVariety
  have hXj := hP'.isNormalVariety
  set DΓ := DivisorOver.ofPrimeDivisor ℂ hX P
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK DΓ
  have hc' : c = -BY.coeff P := hc.eq_neg_coeff_of_ofPrimeDivisor hX
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 Y) by infer_instance)
  obtain ⟨n', D, hDv, hDlog⟩ := (hσ DΓ.valuation (1 + c)).mp ⟨d, DΓ, rfl, hlog⟩
  set DΓ' := DivisorOver.ofPrimeDivisor ℂ hXj P'
  obtain ⟨c₂, hc₂⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP' hK' DΓ'
  have hc₂' : c₂ = -BY'.coeff P' := hc₂.eq_neg_coeff_of_ofPrimeDivisor hXj
  have hlog' := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc₂
    (show IsProper (𝟙 Y') by infer_instance)
  have hv : D.valuation = DΓ'.valuation := by
    ext g
    rw [hDv]
    change P.divisorialValuation (functionFieldMap (𝟙 Y) _) =
      P'.divisorialValuation (functionFieldMap (𝟙 Y') g)
    rw [functionFieldMap_id_apply, functionFieldMap_id_apply, hPP]
    rfl
  have := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hDlog hlog' hv
  have h2 : ((c : ℚ) : ℝ) = ((c₂ : ℚ) : ℝ) := by linarith
  have h3 : c = c₂ := by exact_mod_cast h2
  rw [hc', hc₂'] at h3
  linarith

/-- The divisorial valuation of a prime divisor depends only on its generic point. -/
private theorem divisorialValuation_eq_of_genericPoint_eq {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {E E' : Mori.PrimeDivisor Y}
    (h : E.genericPoint = E'.genericPoint) (g : Y.functionField) :
    E.divisorialValuation g = E'.divisorialValuation g := by
  by_cases hg : g = 0
  · rw [hg, map_zero, map_zero]
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg, h]

/-- **Divisorial valuations under an isomorphism.** If `ψ : Y ≅ Z` carries the generic point of
`Q` to that of `Q'`, then `v_{Q'} = v_Q ∘ ψ^*`. -/
private theorem divisorialValuation_eq_of_iso {Y Z : Scheme.{0}} [IsIntegral Y] [IsNoetherian Y]
    [IsNormal Y] [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] {sY : Y ⟶ Spec (.of ℂ)}
    (hYn : IsNormalVariety ℂ sY) (ψ : Y ≅ Z) (hZn : IsNormalVariety ℂ (ψ.inv ≫ sY))
    (Q : Mori.PrimeDivisor Y) (Q' : Mori.PrimeDivisor Z) (h : ψ.hom Q.genericPoint = Q'.genericPoint)
    (g : Z.functionField) :
    Q'.divisorialValuation g = Q.divisorialValuation (functionFieldMap ψ.hom g) := by
  have hbir : IsBirational ψ.inv := by
    have : IsIso (ψ.inv.stalkMap (genericPoint Z)) :=
      ((isIso_iff_isIso_stalkMap ψ.inv).mp inferInstance).2 _
    exact isBirational_of_isIso_stalkMap_genericPoint ψ.inv
  obtain ⟨Q'', -, hQ''g, -, -, hQ''v⟩ :=
    exists_primeDivisor_map_genericPoint_eq (k := ℂ) hYn ψ.inv hbir hZn Q
  have hgen : Q''.genericPoint = Q'.genericPoint := by
    rw [← h, ← hQ''g, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have h1 := hQ''v (functionFieldMap ψ.hom g)
  rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
    MMP.Positivity.DivisorOver.functionFieldMap_congr (Iso.inv_hom_id ψ),
    functionFieldMap_id_apply, divisorialValuation_eq_of_genericPoint_eq hgen] at h1
  exact h1

/-- **An isomorphism of adjunction steps over a crepant isomorphism is crepant.** Let
`ψ : Y ≅ Z` be an isomorphism of normal projective varieties over `ℂ` identifying `(Y, B_Y)`
and `(Z, B_Z)` crepantly, and `T ⟶ Y`, `T' ⟶ Z` adjunction steps identified by an isomorphism
`ψ_T : T ≅ T'` over `ψ`. Then `ψ_T` identifies the adjunction pairs `(T, B_T)` and `(T', B_T')`
crepantly. -/
private theorem isCrepantBirationalMap_of_isAdjunctionStep_of_iso
    {Y Z T T' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] [IsProper sY]
    [LocallyOfFiniteType sZ] [IsProper sZ]
    (hYn : IsNormalVariety ℂ sY) (hZn : IsNormalVariety ℂ sZ) {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (hdZ : topologicalKrullDim Z = (d + 1 : ℕ))
    {BY : QDivisor Y} {BZ : QDivisor Z} {K : Divisor Y} {KZ : Divisor Z}
    (hK : K.IsCanonicalDivisor sY (d + 1)) (hKZ : KZ.IsCanonicalDivisor sZ (d + 1))
    (hKB : (Divisor.toQDivisor K + BY).IsQCartier)
    (hKBZ : (Divisor.toQDivisor KZ + BZ).IsQCartier)
    (ψ : Y ≅ Z) (hψs : ψ.hom ≫ sZ = sY)
    (σ : FunctionFieldEquiv sY sZ) (hσ : ∀ a, σ a = functionFieldMap ψ.hom a)
    (hσc : IsCrepantBirationalMap sY sZ BY BZ σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [IsIntegral T'] [IsLocallyNoetherian T']
    [IsNormal T'] {jT : T ⟶ Y} {jT' : T' ⟶ Z} {BT : QDivisor T} {BT' : QDivisor T'}
    (hj : IsAdjunctionStep sY BY jT BT) (hjT' : IsAdjunctionStep sZ BZ jT' BT')
    (ψT : T ≅ T') (hψT : ψT.hom ≫ jT' = jT ≫ ψ.hom)
    (σT : FunctionFieldEquiv (jT ≫ sY) (jT' ≫ sZ)) (hσT : ∀ a, σT a = functionFieldMap ψT.hom a) :
    IsCrepantBirationalMap (jT ≫ sY) (jT' ≫ sZ) BT BT' σT := by
  classical
  obtain ⟨-, Q, -, hQr, hci, -⟩ := id hj
  obtain ⟨-, Q', -, hQ'r, hci', -⟩ := id hjT'
  haveI := hci
  haveI := hci'
  haveI : IsNoetherian Y := {}
  have hsZ : ψ.inv ≫ sY = sZ := by rw [← hψs, Iso.inv_hom_id_assoc]
  have hr : Set.range (jT ≫ ψ.hom).base = (Q'.support : Set Z) := by
    rw [← hψT, ← hQ'r, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      (ConcreteCategory.bijective_of_isIso ψT.hom.base).2.range_eq, Set.image_univ]
  have e1 : jT (genericPoint T) = Q.genericPoint := map_genericPoint_eq_of_range_eq jT Q hQr
  have e2 : jT' (genericPoint T') = Q'.genericPoint := map_genericPoint_eq_of_range_eq jT' Q' hQ'r
  have hgen : ψ.hom Q.genericPoint = Q'.genericPoint := by
    rw [← e1]
    exact map_genericPoint_eq_of_range_eq (jT ≫ ψ.hom) Q' hr
  have hvQ : ∀ g, Q'.divisorialValuation g = Q.divisorialValuation ((σ.toHom) g) := by
    intro g
    rw [divisorialValuation_eq_of_iso hYn ψ (by rw [hsZ]; exact hZn) Q Q' hgen g]
    exact congrArg _ (hσ g).symm
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace jT
  haveI : CompactSpace T' := QuasiCompact.compactSpace_of_compactSpace jT'
  have hsp : ψ.hom (jT (genericPoint T)) ⤳ jT' (genericPoint T') := by
    rw [e1, e2, hgen]
  let ψs := (Z.presheaf.stalkSpecializes hsp ≫ ψ.hom.stalkMap (jT (genericPoint T))).hom
  have hψs' : ∀ a, algebraMap _ Y.functionField (ψs a) =
      (σ.toHom) (algebraMap _ Z.functionField a) := by
    intro a
    have h := congrArg (fun φ => φ.hom a)
      (stalkSpecializes_stalkMap_algebraMap ψ.hom (jT (genericPoint T)) _ hsp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    change _ = σ _
    rw [hσ]
    exact h
  refine isCrepantBirationalMap_of_isAdjunctionStep (k := ℂ) hYn hZn hd hdZ hK hKZ hKB hKBZ σ hσc
    hj hjT' Q Q' hQr hQ'r hvQ ψs hψs' (fun a => ?_) σT (fun a => ?_)
  · rw [hψs']
    generalize algebraMap _ Z.functionField a = x
    rw [e1, e2]
    by_cases hx : x = 0
    · rw [hx, map_zero, Scheme.ord_zero, Scheme.ord_zero]
      rfl
    have hσx : (σ.toHom) x ≠ 0 := (map_ne_zero _).mpr hx
    have h1 := hvQ x
    rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hx,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hσx] at h1
    have h2 := WithZero.exp_injective h1
    omega
  · have h := stalkMap_apply_eq_functionFieldMap_apply ψ.hom jT' jT ψT.hom hψT hsp a
    change σT _ = _
    rw [hσT]
    exact h.symm

/-- **Poincaré residues under an isomorphism of adjunction steps.** If `ψ_T : T ≅ T'` lies over
`ψ : Y ≅ Z` and `T ⟶ Y`, `T' ⟶ Z` are closed immersions onto prime divisors, then
`Res_T(ψ^*τ) = ψ_T^* Res_{T'}(τ)`. -/
private theorem isPoincareResidue_pluriformPullback_of_iso
    {Y Z T T' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    [LocallyOfFiniteType sZ] (hYn : IsNormalVariety ℂ sY) (hZn' : IsNormalVariety ℂ sZ) {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (hdZ : topologicalKrullDim Z = (d + 1 : ℕ))
    (ψ : Y ≅ Z) (hψs : ψ.hom ≫ sZ = sY)
    (σ : FunctionFieldEquiv sY sZ) (hσ : ∀ a, σ a = functionFieldMap ψ.hom a)
    [IsIntegral T] [IsIntegral T'] {jT : T ⟶ Y} {jT' : T' ⟶ Z} [IsClosedImmersion jT]
    [IsClosedImmersion jT'] [LocallyOfFiniteType (jT ≫ sY)] [LocallyOfFiniteType (jT' ≫ sZ)]
    (Q : Mori.PrimeDivisor Y) (Q' : Mori.PrimeDivisor Z)
    (hQr : Set.range jT.base = (Q.support : Set Y)) (hQ'r : Set.range jT'.base = (Q'.support : Set Z))
    (ψT : T ≅ T') (hψT : ψT.hom ≫ jT' = jT ≫ ψ.hom)
    (σT : FunctionFieldEquiv (jT ≫ sY) (jT' ≫ sZ)) (hσT : ∀ a, σT a = functionFieldMap ψT.hom a)
    {N : ℕ} {τ : RationalPluriForms sZ (d + 1) N} {ρ : RationalPluriForms (jT' ≫ sZ) d N}
    (h : IsPoincareResidue sZ jT' d N τ ρ) :
    IsPoincareResidue sY jT d N (pluriformPullback sY sZ σ.toHom (d + 1) N τ)
      (pluriformPullback (jT ≫ sY) (jT' ≫ sZ) σT.toHom d N ρ) := by
  classical
  haveI : IsNoetherian Y := {}
  have hsZ : ψ.inv ≫ sY = sZ := by rw [← hψs, Iso.inv_hom_id_assoc]
  have hZn : IsNormalVariety ℂ (ψ.inv ≫ sY) := by rw [hsZ]; exact hZn'
  have hr : Set.range (jT ≫ ψ.hom).base = (Q'.support : Set Z) := by
    rw [← hψT, ← hQ'r, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      (ConcreteCategory.bijective_of_isIso ψT.hom.base).2.range_eq, Set.image_univ]
  have e1 : jT (genericPoint T) = Q.genericPoint := map_genericPoint_eq_of_range_eq jT Q hQr
  have e2 : jT' (genericPoint T') = Q'.genericPoint := map_genericPoint_eq_of_range_eq jT' Q' hQ'r
  have hgen : ψ.hom Q.genericPoint = Q'.genericPoint := by
    rw [← e1]
    exact map_genericPoint_eq_of_range_eq (jT ≫ ψ.hom) Q' hr
  have hvQ : ∀ g, Q'.divisorialValuation g = Q.divisorialValuation ((σ.toHom) g) := by
    intro g
    rw [divisorialValuation_eq_of_iso hYn ψ hZn Q Q' hgen g]
    exact congrArg _ (hσ g).symm
  have hsp : ψ.hom (jT (genericPoint T)) ⤳ jT' (genericPoint T') := by
    rw [e1, e2, hgen]
  let ψs := (Z.presheaf.stalkSpecializes hsp ≫ ψ.hom.stalkMap (jT (genericPoint T))).hom
  have hψs' : ∀ a, algebraMap _ Y.functionField (ψs a) =
      (σ.toHom) (algebraMap _ Z.functionField a) := by
    intro a
    have h := congrArg (fun φ => φ.hom a)
      (stalkSpecializes_stalkMap_algebraMap ψ.hom (jT (genericPoint T)) _ hsp)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    change _ = σ _
    rw [hσ]
    exact h
  have hdT : topologicalKrullDim T = d := topologicalKrullDim_eq_of_range_eq_support sY jT Q hQr hd
  have hdT' : topologicalKrullDim T' = d :=
    topologicalKrullDim_eq_of_range_eq_support sZ jT' Q' hQ'r hdZ
  refine isPoincareResidue_pluriformPullback jT jT' hd hdZ hdT hdT' σ.toHom σT.toHom ψs hψs'
    (fun a => ?_) (fun a => ?_) h
  · have h := stalkMap_apply_eq_functionFieldMap_apply ψ.hom jT' jT ψT.hom hψT hsp a
    change _ = σT _
    rw [hσT]
    exact h
  · rw [hψs']
    generalize algebraMap _ Z.functionField a = x
    rw [e1, e2]
    by_cases hx : x = 0
    · rw [hx, map_zero, Scheme.ord_zero, Scheme.ord_zero]
      rfl
    have hσx : (σ.toHom) x ≠ 0 := (map_ne_zero _).mpr hx
    have h1 := hvQ x
    rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hx,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hσx] at h1
    have h2 := WithZero.exp_injective h1
    omega

/-- **One adjunction step, carried across a crepant isomorphism.** Let `ψ : Y ≅ Z` be an
isomorphism of normal projective varieties over `ℂ` identifying the pairs `(Y, B_Y)` and
`(Z, B_Z)` crepantly, with `(Z, B_Z)` dlt. For an adjunction step `T ⟶ Y` onto `Q` there is an
adjunction step `T' ⟶ Z` onto `ψ(Q)` with `(T', B_T')` dlt, and an isomorphism `T ≅ T'` over `ψ`
identifying `(T, B_T)` and `(T', B_T')` crepantly. -/
private theorem exists_isAdjunctionStep_iso_of_isAdjunctionStep
    {Y Z T : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] [IsProper sY]
    [LocallyOfFiniteType sZ] [IsProper sZ]
    (hYn : IsNormalVariety ℂ sY) (hZn : IsNormalVariety ℂ sZ) {d : ℕ}
    (hd : topologicalKrullDim Y = (d + 1 : ℕ)) (hdZ : topologicalKrullDim Z = (d + 1 : ℕ))
    {BY : QDivisor Y} {BZ : QDivisor Z} {K : Divisor Y} {KZ : Divisor Z}
    (hK : K.IsCanonicalDivisor sY (d + 1)) (hKZ : KZ.IsCanonicalDivisor sZ (d + 1))
    (hKB : (Divisor.toQDivisor K + BY).IsQCartier)
    (hKBZ : (Divisor.toQDivisor KZ + BZ).IsQCartier)
    (hPY : MMP.Mori.IsPair sY BY) (hPZ : MMP.Mori.IsPair sZ BZ)
    (hdltZ : MMP.Intersection.IsDltPair sZ BZ)
    (ψ : Y ≅ Z) (hψs : ψ.hom ≫ sZ = sY)
    (σ : FunctionFieldEquiv sY sZ) (hσ : ∀ a, σ a = functionFieldMap ψ.hom a)
    (hσc : IsCrepantBirationalMap sY sZ BY BZ σ)
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] {jT : T ⟶ Y} {BT : QDivisor T}
    (hj : IsAdjunctionStep sY BY jT BT) :
    ∃ (T' : Scheme.{0}) (jT' : T' ⟶ Z) (BT' : QDivisor T') (hjT' : IsAdjunctionStep sZ BZ jT' BT')
      (ψT : T ≅ T'), ψT.hom ≫ jT' = jT ≫ ψ.hom ∧
      haveI : IsIntegral T' := hjT'.1.1.toIsIntegral
      haveI : IsNormal T' := hjT'.1.2
      haveI : IsLocallyNoetherian T' := by
        have := hjT'.1.1
        exact LocallyOfFiniteType.isLocallyNoetherian (jT' ≫ sZ)
      MMP.Intersection.IsDltPair (jT' ≫ sZ) BT' ∧
      ∃ σT : FunctionFieldEquiv (jT ≫ sY) (jT' ≫ sZ),
        (∀ a, σT a = functionFieldMap ψT.hom a) ∧
        IsCrepantBirationalMap (jT ≫ sY) (jT' ≫ sZ) BT BT' σT := by
  classical
  obtain ⟨-, Q, hQ1, hQr, hci, -⟩ := id hj
  haveI := hci
  haveI : IsNoetherian Y := {}
  have hsZ : ψ.inv ≫ sY = sZ := by rw [← hψs, Iso.inv_hom_id_assoc]
  have hbir : IsBirational ψ.inv := by
    have : IsIso (ψ.inv.stalkMap (genericPoint Z)) :=
      ((isIso_iff_isIso_stalkMap ψ.inv).mp inferInstance).2 _
    exact isBirational_of_isIso_stalkMap_genericPoint ψ.inv
  obtain ⟨Q', -, hQ'g, -, -, -⟩ := exists_primeDivisor_map_genericPoint_eq (k := ℂ) hYn ψ.inv
    hbir (by rw [hsZ]; exact hZn) Q
  have hgen : ψ.hom Q.genericPoint = Q'.genericPoint := by
    rw [← hQ'g, ← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have hvQ : ∀ g, Q'.divisorialValuation g = Q.divisorialValuation ((σ.toHom) g) := by
    intro g
    rw [divisorialValuation_eq_of_iso hYn ψ (by rw [hsZ]; exact hZn) Q Q' hgen g]
    exact congrArg _ (hσ g).symm
  have hcoef : BZ.coeff Q' = BY.coeff Q :=
    coeff_eq_of_isCrepantBirationalMap hPY hPZ hK hKZ σ hσc Q Q' hvQ
  obtain ⟨T', jT', BT', hjT', hrT', hdltT'⟩ :=
    exists_isAdjunctionStep_of_one_le_coeff hdltZ hdZ Q' (hcoef ▸ hQ1)
  haveI : IsIntegral T' := hjT'.1.1.toIsIntegral
  haveI : IsNormal T' := hjT'.1.2
  haveI : IsLocallyNoetherian T' := by
    have := hjT'.1.1
    exact LocallyOfFiniteType.isLocallyNoetherian (jT' ≫ sZ)
  obtain ⟨-, -, -, -, hci', -⟩ := id hjT'
  haveI := hci'
  have hrange : Set.range (jT ≫ ψ.hom).base = Set.range jT'.base := by
    rw [hrT', Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, hQr,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    have h := (Scheme.homeoOfIso ψ).image_closure {Q.genericPoint}
    rw [Set.image_singleton] at h
    change ψ.hom.base '' _ = _
    erw [h]
    change closure {ψ.hom Q.genericPoint} = _
    rw [hgen]
  obtain ⟨ψT, hψT⟩ := exists_iso_comp_eq_of_range_eq (jT ≫ ψ.hom) jT' hrange
  have hsT : ψT.hom ≫ jT' ≫ sZ = jT ≫ sY := by
    rw [← Category.assoc, hψT, Category.assoc, hψs]
  obtain ⟨σT, hσT⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) ψT.hom
    (functionFieldMap_bijective_of_isIso ψT) hsT
  exact ⟨T', jT', BT', hjT', ψT, hψT, hdltT', σT, hσT,
    isCrepantBirationalMap_of_isAdjunctionStep_of_iso hYn hZn hd hdZ hK hKZ hKB hKBZ ψ hψs σ hσ
      hσc hj hjT' ψT hψT σT hσT⟩

/-! ### Changing the structure morphism by an equality -/

/-- A crepant birational map along equal structure morphisms. -/
private theorem exists_isCrepantBirationalMap_congr {S S' : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] [IsIntegral S'] [IsLocallyNoetherian S'] [IsNormal S']
    {s₁ s₁' : S ⟶ Spec (.of ℂ)} {s₂ s₂' : S' ⟶ Spec (.of ℂ)} (h₁ : s₁ = s₁') (h₂ : s₂ = s₂')
    {B : QDivisor S} {B' : QDivisor S'} (σ : FunctionFieldEquiv s₁ s₂)
    (hσ : IsCrepantBirationalMap s₁ s₂ B B' σ) :
    ∃ σ' : FunctionFieldEquiv s₁' s₂', (∀ a, (σ'.toHom) a = (σ.toHom) a) ∧
      IsCrepantBirationalMap s₁' s₂' B B' σ' := by
  subst h₁ h₂
  exact ⟨σ, fun _ => rfl, hσ⟩

/-- Pull-backs of forms along equal structure morphisms agree. -/
private theorem pluriformPullback_heq {S S' : Scheme.{0}} [IsIntegral S] [IsIntegral S']
    {s₁ s₁' : S ⟶ Spec (.of ℂ)} {s₂ s₂' : S' ⟶ Spec (.of ℂ)} (h₁ : s₁ = s₁') (h₂ : s₂ = s₂')
    (σ : FunctionFieldEquiv s₁ s₂) (σ' : FunctionFieldEquiv s₁' s₂')
    (hσ : ∀ a, (σ'.toHom) a = (σ.toHom) a)
    {e : ℕ} {N : ℤ} {ρ : RationalPluriForms s₂ e N} {ρ' : RationalPluriForms s₂' e N}
    (hρ : HEq ρ ρ') :
    HEq (pluriformPullback s₁ s₂ σ.toHom e N ρ) (pluriformPullback s₁' s₂' σ'.toHom e N ρ') := by
  subst h₁ h₂
  letI := functionFieldAlgebra s₁
  letI := functionFieldAlgebra s₂
  have : σ' = σ := AlgEquiv.ext fun a => hσ a
  subst this
  rw [eq_of_heq hρ]

/-- Poincaré residues along equal structure morphisms. -/
private theorem isPoincareResidue_congr {Y T : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsIntegral T] (jT : T ⟶ Y) {s s' : Y ⟶ Spec (.of ℂ)} (h : s = s') {e N : ℕ}
    {τ : RationalPluriForms s (e + 1) N} {τ' : RationalPluriForms s' (e + 1) N}
    {ρ : RationalPluriForms (jT ≫ s) e N} {ρ' : RationalPluriForms (jT ≫ s') e N}
    (hτ : HEq τ τ') (hρ : HEq ρ ρ') (hr : IsPoincareResidue s jT e N τ ρ) :
    IsPoincareResidue s' jT e N τ' ρ' := by
  subst h
  rw [← eq_of_heq hτ, ← eq_of_heq hρ]
  exact hr

/-- Dlt pairs along equal structure morphisms. -/
private theorem isDltPair_congr {S : Scheme.{0}} [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S]
    {s s' : S ⟶ Spec (.of ℂ)} (h : s = s') {B : QDivisor S} (hB : MMP.Intersection.IsDltPair s B) :
    MMP.Intersection.IsDltPair s' B := h ▸ hB

/-! ### Powers of forms on a line -/

/-- **Equal forms have equal powers.** On a line `Ω^d_{K/ℂ}`, if `c ω^{⊗m} = c' ω'^{⊗m}` with
`m > 0`, then `c^a ω^{⊗am} = c'^a ω'^{⊗am}`. -/
private theorem smul_formPow_pow_eq {K : Type*} [Field K] [Algebra ℂ K] {d : ℕ}
    (b : Module.Basis Unit K (⋀[K]^d Ω[K⁄ℂ])) {m : ℕ} {w w' : ⋀[K]^d Ω[K⁄ℂ]} {c c' : K}
    (h : (c • formPow w m : PluriForms ℂ K d m) = c' • formPow w' m) (a : ℕ) :
    (c ^ a • formPow w (a * m) : PluriForms ℂ K d ((a * m : ℕ) : ℤ)) =
      c' ^ a • formPow w' (a * m) := by
  rw [← basis_unit_repr_smul b w, ← basis_unit_repr_smul b w'] at h ⊢
  simp only [formPow_smul, smul_smul] at h ⊢
  have h1 := congrArg (fun τ => (ZTensorPower.basis b m).repr τ ()) h
  simp only [repr_smul_formPow] at h1
  have key : ∀ x y : K, x ^ a * y ^ (a * m) = (x * y ^ m) ^ a := fun x y => by ring
  rw [key, key, h1]

/-- **Powers of iterated residues.** Along a flag ending at a stratum of dimension `e`, if
`c ω^{⊗m}` has iterated residue `c₁ ω₁^{⊗m}`, then `c^a ω^{⊗am}` has iterated residue
`c₁^a ω₁^{⊗am}` for every `a > 0`. -/
private theorem isIteratedResidueRec_pow {Y : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {BY : QDivisor Y} {n m : ℕ}
    (ω : letI := functionFieldAlgebra sY; ⋀[Y.functionField]^n Ω[Y.functionField⁄ℂ])
    (c : Y.functionField) {S : Scheme.{0}} [IsIntegral S] {ι : S ⟶ Y} {BS : QDivisor S}
    (G : StratumAdjunctionData sY BY ι BS) {e : ℕ} (he : topologicalKrullDim S = e)
    (ω₁ : letI := functionFieldAlgebra (ι ≫ sY); ⋀[S.functionField]^e Ω[S.functionField⁄ℂ])
    (c₁ : S.functionField)
    (h : letI := functionFieldAlgebra sY; letI := functionFieldAlgebra (ι ≫ sY)
      IsIteratedResidueRec (c • (formPow ω m : RationalPluriForms sY n m)) G e
      (c₁ • (formPow ω₁ m : RationalPluriForms (ι ≫ sY) e m))) :
    letI := functionFieldAlgebra sY; letI := functionFieldAlgebra (ι ≫ sY)
    ∀ a, 0 < a → IsIteratedResidueRec
      (c ^ a • (formPow ω (a * m) : RationalPluriForms sY n ((a * m : ℕ) : ℤ))) G e
      (c₁ ^ a • (formPow ω₁ (a * m) : RationalPluriForms (ι ≫ sY) e ((a * m : ℕ) : ℤ))) := by
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (ι ≫ sY)
  intro a ha
  suffices H : ∀ N : ℕ, N = a * m → IsIteratedResidueRec
      (c ^ a • (formPow ω N : RationalPluriForms sY n N)) G e
      (c₁ ^ a • (formPow ω₁ N : RationalPluriForms (ι ≫ sY) e N)) from H _ rfl
  induction a, ha using Nat.le_induction with
  | base =>
    intro N hN
    rw [Nat.succ_eq_add_one, zero_add, one_mul] at hN
    subst hN
    simpa only [pow_one] using h
  | succ a ha ih =>
    intro N hN
    have hmul := IsIteratedResidueRec.mul G he (ih _ rfl) h
    rw [RationalPluriForms.mul_smul_formPow, RationalPluriForms.mul_smul_formPow, ← pow_succ,
      ← pow_succ] at hmul
    rw [Nat.succ_mul] at hN
    subst hN
    exact hmul

/-! ### Matching flags of `(X, B)` with flags of the floor components -/

/-- **Every flag of positive length of `(X, B)` is a flag of a floor component.** A flag
`X ⊃ T₁ ⊃ ⋯ ⊃ S` of iterated adjunction of `(X, B)` starts at a model `T₁` of a floor component
`P`; it is matched by a flag `C_P ⊃ ⋯ ⊃ S'` of `(C_P, B_{C_P})`, one step shorter, with an
isomorphism `S ≅ S'` over `X` which identifies the adjunction pairs crepantly and carries the
iterated residues of a form `τ` along `X ⊃ ⋯ ⊃ S` to those of its residue along `C_P`. -/
private theorem exists_flagMatch
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hX : Mori.IsProjectiveVariety ℂ sX) {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ)) {B : QDivisor X}
    {C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    {j : ∀ P, C P ⟶ X} {BC : ∀ P, QDivisor (C P)} {m : ℕ}
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set X))
    (hset : IsStratifiedSectionSetting (fun P => j P ≫ sX) BC n m)
    (hcanX : ∀ {S : Scheme.{0}} {ι : S ⟶ X} {BS : QDivisor S}
      (F : StratumAdjunctionData sX B ι BS),
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      ∃ (d : ℕ) (K : Divisor S), K.IsCanonicalDivisor (ι ≫ sX) d ∧
        (Divisor.toQDivisor K + BS).IsQCartier) :
    ∀ {S : Scheme.{0}} {ι : S ⟶ X} {BS : QDivisor S} (F : StratumAdjunctionData sX B ι BS),
      1 ≤ F.length →
      ∃ (P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) (S' : Scheme.{0}) (ι' : S' ⟶ C P)
        (BS' : QDivisor S') (F' : StratumAdjunctionData (j P ≫ sX) (BC P) ι' BS') (ψ : S ≅ S'),
        F'.length + 1 = F.length ∧ ψ.hom ≫ ι' ≫ j P = ι ∧
        (haveI := F'.isIntegral_stratum
         haveI := F'.isNormal_stratum
         haveI := F'.isLocallyNoetherian_stratum
         MMP.Intersection.IsDltPair (ι' ≫ j P ≫ sX) BS') ∧
        haveI := F.isIntegral_stratum
        haveI := F.isNormal_stratum
        haveI := F.isLocallyNoetherian_stratum
        haveI := F'.isIntegral_stratum
        haveI := F'.isNormal_stratum
        haveI := F'.isLocallyNoetherian_stratum
        ∃ σ : FunctionFieldEquiv (ι ≫ sX) (ι' ≫ j P ≫ sX),
          (∀ a, (σ.toHom) a = functionFieldMap ψ.hom a) ∧
          IsCrepantBirationalMap (ι ≫ sX) (ι' ≫ j P ≫ sX) BS BS' σ ∧
          ∀ (N : ℕ) (τ : RationalPluriForms sX (n + 1) N)
            (ρP : RationalPluriForms (j P ≫ sX) n N), IsPoincareResidue sX (j P) n N τ ρP →
            ∀ (e : ℕ), topologicalKrullDim S = e →
            ∀ ρ' : RationalPluriForms (ι' ≫ j P ≫ sX) e N, IsIteratedResidueRec ρP F' e ρ' →
              IsIteratedResidueRec τ F e
                (pluriformPullback (ι ≫ sX) (ι' ≫ j P ≫ sX) σ.toHom e N ρ') := by
  classical
  haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
  have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
  have hCproper : ∀ P, IsProper (j P ≫ sX) := fun P =>
    isProper_of_isProjectiveMorphism _ (hset.isProjectiveVariety P).isProjective
  intro S ι BS F
  induction F with
  | refl h => intro hF; simp [StratumAdjunctionData.length] at hF
  | @step S₀ T ι₀ BS₀ F₀ jT BT hj ih =>
    intro _
    haveI := F₀.isIntegral_stratum
    haveI := F₀.isNormal_stratum
    haveI := F₀.isLocallyNoetherian_stratum
    haveI := F₀.isClosedImmersion
    haveI : IsIntegral T := hj.1.1.toIsIntegral
    haveI : IsNormal T := hj.1.2
    haveI : IsLocallyNoetherian T := by
      have := hj.1.1
      exact LocallyOfFiniteType.isLocallyNoetherian (jT ≫ ι₀ ≫ sX)
    by_cases h0 : F₀.length = 0
    · -- the first step `X ⊃ T`, matched with `C_P` itself
      cases F₀ with
      | step F₁ j₁ BT₁ hj₁ => simp [StratumAdjunctionData.length] at h0
      | refl hp =>
        have hj' : IsAdjunctionStep sX B jT BT := by simpa only [Category.id_comp] using hj
        obtain ⟨-, Q, hQ1, hQr, hci, -⟩ := id hj'
        haveI := hci
        have hfl : ⌊B.coeff Q⌋ ≠ 0 := by
          have : (1 : ℤ) ≤ ⌊B.coeff Q⌋ := Int.le_floor.mpr (by exact_mod_cast hQ1)
          omega
        let P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} := ⟨Q, hfl⟩
        have hPr : Set.range (j P).base = (Q.support : Set X) := (hC P).2
        obtain ⟨-, -, -, -, hciP, -⟩ := id (hC P).1
        haveI := hciP
        obtain ⟨ψ, hψ⟩ := exists_iso_comp_eq_of_range_eq jT (j P) (hQr.trans hPr.symm)
        obtain ⟨-, d, K, hK, hKB⟩ := hp
        have hd : d = n + 1 := by
          have := hK.topologicalKrullDim_eq
          rw [hdim] at this
          exact_mod_cast this.symm
        subst hd
        have hσ0 : ∀ a, (1 : FunctionFieldEquiv sX sX) a = functionFieldMap (Iso.refl X).hom a :=
          fun a => (functionFieldMap_id_apply a).symm
        have hσc0 : IsCrepantBirationalMap sX sX B B 1 := (crepantBirationalAutomorphisms sX B).one_mem
        have hψX : ψ.hom ≫ j P = jT ≫ (Iso.refl X).hom := by rw [hψ]; rfl
        have hsT : ψ.hom ≫ j P ≫ sX = jT ≫ sX := by rw [← Category.assoc, hψ]
        obtain ⟨σT, hσT⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) ψ.hom
          (functionFieldMap_bijective_of_isIso ψ) hsT
        have hcrep := isCrepantBirationalMap_of_isAdjunctionStep_of_iso hXn hXn hdim hdim hK hK hKB
          hKB (Iso.refl X) (Category.id_comp sX) 1 hσ0 hσc0 hj' (hC P).1 ψ hψX σT hσT
        obtain ⟨σ, hσσ, hσcrep⟩ := exists_isCrepantBirationalMap_congr
          (show jT ≫ sX = (jT ≫ 𝟙 X) ≫ sX by simp)
          (show j P ≫ sX = 𝟙 (C P) ≫ j P ≫ sX by simp) σT hcrep
        refine ⟨P, C P, 𝟙 _, BC P, .refl (hset.isPair P).isPair, ψ,
          by simp [StratumAdjunctionData.length], by simp [hψ],
          isDltPair_congr (Category.id_comp _).symm (hset.isDltPair P),
          σ, fun a => (hσσ a).trans (hσT a), hσcrep, ?_⟩
        intro N τ ρP hres e he ρ' hiter
        obtain ⟨rfl, hρ⟩ := hiter
        have hclean := isPoincareResidue_pluriformPullback_of_iso hXn hXn hdim hdim (Iso.refl X)
          (Category.id_comp sX) 1 hσ0 Q Q hQr hPr ψ hψX σT hσT hres
        rw [pluriformPullback_one (by exact_mod_cast hdim)] at hclean
        have h₁ : (jT ≫ 𝟙 X) ≫ sX = jT ≫ sX := by rw [Category.comp_id]
        have h₂ : 𝟙 (C P) ≫ j P ≫ sX = j P ≫ sX := Category.id_comp _
        have hpb := pluriformPullback_heq h₁ h₂ σ σT (fun a => (hσσ a).symm) hρ
        refine ⟨cast (by rw [Category.id_comp]) τ, ⟨rfl, cast_heq _ _⟩,
          cast (by rw [Category.id_comp])
            (pluriformPullback (jT ≫ sX) (j P ≫ sX) σT.toHom n N ρP), ?_, ?_⟩
        · exact isPoincareResidue_congr jT (Category.id_comp sX).symm (cast_heq _ _).symm
            (cast_heq _ _).symm hclean
        · exact hpb.trans (cast_heq _ _).symm
    · obtain ⟨P, S', ι', BS', F', ψ, hlen, hcomp, hdlt', hrest⟩ := ih (by omega)
      haveI := F'.isIntegral_stratum
      haveI := F'.isNormal_stratum
      haveI := F'.isLocallyNoetherian_stratum
      haveI := F'.isClosedImmersion
      obtain ⟨σ, hσ, hσc, hres⟩ := hrest
      haveI := hCproper P
      haveI : CompactSpace (C P) := QuasiCompact.compactSpace_of_compactSpace (j P ≫ sX)
      haveI : CompactSpace S₀ := QuasiCompact.compactSpace_of_compactSpace ι₀
      haveI : CompactSpace S' := QuasiCompact.compactSpace_of_compactSpace ι'
      have hS₀n : IsNormalVariety ℂ (ι₀ ≫ sX) := F₀.isNormalVariety
      have hS'n : IsNormalVariety ℂ (ι' ≫ j P ≫ sX) := F'.isNormalVariety
      haveI : LocallyOfFiniteType (ι₀ ≫ sX) := hS₀n.1.toLocallyOfFiniteType
      haveI : LocallyOfFiniteType (ι' ≫ j P ≫ sX) := hS'n.1.toLocallyOfFiniteType
      haveI : LocallyOfFiniteType (jT ≫ ι₀ ≫ sX) := hj.1.1.toLocallyOfFiniteType
      obtain ⟨-, Q, hQ1, hQr, hci, -⟩ := id hj
      haveI := hci
      -- dimensions: `T` has dimension `d`, the ambient strata `S₀ ≅ S'` dimension `d + 1`
      set d := (letI := functionFieldAlgebra (jT ≫ ι₀ ≫ sX)
        (Algebra.trdeg ℂ T.functionField).toNat) with hd
      have hdT : topologicalKrullDim T = d := topologicalKrullDim_eq_toNat_trdeg (jT ≫ ι₀ ≫ sX)
      have hdS₀ : topologicalKrullDim S₀ = (d + 1 : ℕ) := by
        rw [topologicalKrullDim_eq_toNat_trdeg (ι₀ ≫ sX), ← hj.trdeg_add_one]
      have hdS' : topologicalKrullDim S' = (d + 1 : ℕ) := by
        have h1 := StratumAdjunctionData.dim_add_length (sX := sX) hdim F₀ hdS₀
        have h2 := StratumAdjunctionData.dim_add_length (sX := j P ≫ sX)
          (hset.topologicalKrullDim_eq P) F'
          (topologicalKrullDim_eq_toNat_trdeg (ι' ≫ j P ≫ sX))
        rw [topologicalKrullDim_eq_toNat_trdeg (ι' ≫ j P ≫ sX)]
        congr 1
        norm_cast
        omega
      -- canonical divisors and `ℚ`-Cartier adjoints on both sides
      obtain ⟨d₁, K, hK, hKB⟩ := hcanX F₀
      obtain ⟨d₂, K', hK', hK'C⟩ := hset.isCartierDivisor P F'
      have hd₁ : d₁ = d + 1 := by
        have := hK.topologicalKrullDim_eq
        rw [hdS₀] at this
        exact_mod_cast this.symm
      have hd₂ : d₂ = d + 1 := by
        have := hK'.topologicalKrullDim_eq
        rw [hdS'] at this
        exact_mod_cast this.symm
      subst hd₁ hd₂
      have hKB' : (Divisor.toQDivisor K' + BS').IsQCartier :=
        ⟨m, by exact_mod_cast hset.pos.ne', hK'C⟩
      have hψs : ψ.hom ≫ ι' ≫ j P ≫ sX = ι₀ ≫ sX := by
        rw [← hcomp]
        simp only [Category.assoc]
      have hσ' : ∀ a, σ a = functionFieldMap ψ.hom a := hσ
      obtain ⟨T', jT', BT', hjT', ψT, hψT, hdltT', σT, hσT, hσTc⟩ :=
        exists_isAdjunctionStep_iso_of_isAdjunctionStep hS₀n hS'n hdS₀ hdS' hK hK' hKB hKB'
          ⟨hS₀n, _, K, hK, hKB⟩ ⟨hS'n, _, K', hK', hKB'⟩ hdlt' ψ hψs σ hσ' hσc hj
      haveI : IsIntegral T' := hjT'.1.1.toIsIntegral
      haveI : IsNormal T' := hjT'.1.2
      haveI : IsLocallyNoetherian T' := by
        have := hjT'.1.1
        exact LocallyOfFiniteType.isLocallyNoetherian (jT' ≫ ι' ≫ j P ≫ sX)
      haveI : LocallyOfFiniteType (jT' ≫ ι' ≫ j P ≫ sX) := hjT'.1.1.toLocallyOfFiniteType
      obtain ⟨-, Q', -, hQ'r, hci', -⟩ := id hjT'
      haveI := hci'
      obtain ⟨σn, hσn, hσnc⟩ := exists_isCrepantBirationalMap_congr
        (show jT ≫ ι₀ ≫ sX = (jT ≫ ι₀) ≫ sX by rw [Category.assoc])
        (show jT' ≫ ι' ≫ j P ≫ sX = (jT' ≫ ι') ≫ j P ≫ sX by rw [Category.assoc]) σT hσTc
      refine ⟨P, T', jT' ≫ ι', BT', F'.step jT' BT' hjT', ψT,
        by simp only [StratumAdjunctionData.length]; omega, ?_,
        isDltPair_congr (by rw [Category.assoc]) hdltT', σn, fun a => (hσn a).trans (hσT a),
        hσnc, ?_⟩
      · rw [Category.assoc, ← Category.assoc ψT.hom, hψT, Category.assoc, hcomp]
      intro N τ ρP hresP e he ρ' hiter
      obtain ⟨ρ₀', hρ₀', ρ'', hr'', hρ''⟩ := hiter
      have he' : e = d := by
        rw [hdT] at he
        exact_mod_cast he.symm
      subst he'
      have IH := hres N τ ρP hresP (d + 1) hdS₀ ρ₀' hρ₀'
      have hfun := isPoincareResidue_pluriformPullback_of_iso hS₀n hS'n hdS₀ hdS' ψ hψs σ hσ' Q Q'
        hQr hQ'r ψT hψT σT hσT hr''
      refine ⟨_, IH, _, hfun, ?_⟩
      exact pluriformPullback_heq (by rw [Category.assoc]) (by rw [Category.assoc]) σn σT
        (fun a => (hσn a).symm) hρ''

/-! ### Sections pulled back from the base of the contraction -/

/-- A function regular near the generic point of a prime divisor has non-negative order along
it. -/
private theorem ord_germToFunctionField_nonneg {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : Mori.PrimeDivisor Y) {U : Y.Opens} [Nonempty U]
    (hU : E.genericPoint ∈ U) (s : Γ(Y, U)) :
    0 ≤ Y.ord (Y.germToFunctionField U s) E.genericPoint := by
  by_cases hs : Y.germToFunctionField U s = 0
  · rw [hs, Scheme.ord_zero]
    rfl
  have h1 : E.divisorialValuation (Y.germToFunctionField U s) ≤ 1 := by
    rw [MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
    exact ⟨Y.presheaf.germ U E.genericPoint hU s,
      Scheme.algebraMap_germ_eq_germToFunctionField (X := Y) hU s⟩
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hs] at h1
  have h2 : -Y.ord (Y.germToFunctionField U s) E.genericPoint ≤ 0 := by
    have := WithZero.exp_le_exp.mp (h1.trans_eq WithZero.exp_zero.symm)
    exact this
  omega

/-- A local equation of `D` on `U` gives one of `n • D` on `U`. -/
private theorem isLocalEquation_pow {Y : Scheme.{0}} [IsLocallyNoetherian Y] [IsNormal Y]
    {D : Divisor Y} {U : Y.Opens} {φ : (RationalFunctions Y)ˣ} (h : D.IsLocalEquation U φ)
    (n : ℕ) : (n • D).IsLocalEquation U (φ ^ n) := by
  induction n with
  | zero => simpa using Divisor.isLocalEquation_zero U
  | succ n ih => simpa [succ_nsmul, pow_succ] using ih.add h

/-- The unique irreducible component of an integral scheme. -/
private def univComponent (Y : Scheme.{0}) [IsIntegral Y] : irreducibleComponents Y :=
  ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩

/-- A global divisorial section of `𝒪_Y(D)`, read in the function field. -/
private noncomputable def divisorialSectionValue {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {D : Divisor Y} (φ : Γ(D.divisorialSheaf, ⊤)) : Y.functionField :=
  MMP.Threefold.Mori.Helpers.evalFF (univComponent Y)
    (rationalFunctionsPresheafTopEquiv Y (show D.divisorialSubmodule ⊤ from φ).1)

/-- **A divisorial section is a regular function times a local generator.** If `e` is a local
equation of `D` on `U`, a global section `φ` of `𝒪_Y(n D)` is `h · e^{-n}` on `U` for a
function `h` on `U`. -/
private theorem exists_divisorialSectionValue_eq {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {D : Divisor Y} {U : Y.Opens} [Nonempty U]
    {e : (RationalFunctions Y)ˣ} (he : D.IsLocalEquation U e) (n : ℕ)
    (φ : Γ((n • D).divisorialSheaf, ⊤)) :
    ∃ h : Γ(Y, U), h • (n • D).divisorialSheaf.presheaf.map (homOfLE le_rfl).op
        (isLocalEquation_pow he n).invSection =
        (n • D).divisorialSheaf.presheaf.map (homOfLE le_top).op φ ∧
      divisorialSectionValue φ = Y.germToFunctionField U h *
      MMP.Threefold.Mori.Helpers.evalFF (univComponent Y) (((e ^ n)⁻¹ : (RationalFunctions Y)ˣ) :
        RationalFunctions Y) := by
  have hZU : componentGenericPoint Y (univComponent Y) ∈ U :=
    LocalFrame.componentGenericPoint_mem_of_isIntegral (univComponent Y)
      (⟨(Classical.arbitrary U).1, (Classical.arbitrary U).2⟩)
  obtain ⟨c, hc⟩ := ((isLocalEquation_pow he n).isLocalGenerator_invSection U le_rfl).2
    ((n • D).divisorialSheaf.presheaf.map (homOfLE le_top).op φ)
  refine ⟨c, hc, ?_⟩
  have h1 := congrFun (congrArg Subtype.val hc) ⟨univComponent Y, hZU⟩
  change Y.presheaf.germ U _ hZU c *
      (((e ^ n)⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) (univComponent Y) =
    (show (n • D).divisorialSubmodule ⊤ from φ).1 ⟨univComponent Y, trivial⟩ at h1
  change (Y.presheaf.stalkSpecializes _).hom
      ((show (n • D).divisorialSubmodule ⊤ from φ).1 ⟨univComponent Y, trivial⟩) = _
  rw [← h1, map_mul]
  congr 1
  exact TopCat.Presheaf.germ_stalkSpecializes_apply Y.presheaf hZU _ c

/-- The tensor power `w^{⊗N}` of a rational top form, as a rational `N`-canonical form. -/
private noncomputable def formPowR {Y : Scheme.{0}} [IsIntegral Y] (sY : Y ⟶ Spec (.of ℂ))
    {d : ℕ} (w : letI := functionFieldAlgebra sY; ⋀[Y.functionField]^d Ω[Y.functionField⁄ℂ])
    (N : ℕ) : RationalPluriForms sY d N :=
  letI := functionFieldAlgebra sY
  formPow w N

/-- `(f w^{⊗a}) · (g w^{⊗b}) = (f g) w^{⊗(a+b)}`. -/
private theorem mul_smul_formPowR {Y : Scheme.{0}} [IsIntegral Y] {sY : Y ⟶ Spec (.of ℂ)}
    {d : ℕ} (w : letI := functionFieldAlgebra sY; ⋀[Y.functionField]^d Ω[Y.functionField⁄ℂ])
    (a b : ℕ) (f g : Y.functionField) :
    RationalPluriForms.mul sY d a b (f • formPowR sY w a) (g • formPowR sY w b) =
      (f * g) • formPowR sY w (a + b) :=
  RationalPluriForms.mul_smul_formPow w a b f g

/-- **A rational top form whose divisor is the canonical divisor**, with its tensor powers:
`w^{⊗N} ≠ 0` and `div(w^{⊗N}) = N K_X` for `N > 0`. -/
private theorem exists_formPowR_ordForm_eq {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    {n : ℕ} (hdim : topologicalKrullDim X = (n + 1 : ℕ)) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX (n + 1)) :
    ∃ w : (letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ]),
      ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
        ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ := by
  letI := functionFieldAlgebra sX
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) (d := n + 1) (by rw [hdim])
  set c := (ZTensorPower.basis b 1).repr (ω : RationalPluriForms sX (n + 1) ((1 : ℕ) : ℤ)) ()
  have hω : ω = formPowR sX (c • b ()) 1 := by
    change ω = formPow (c • b ()) 1
    rw [formPow_smul, pow_one]
    exact eq_repr_smul_formPow b (ω : RationalPluriForms sX (n + 1) ((1 : ℕ) : ℤ))
  refine ⟨c • b (), fun N hN => ?_⟩
  induction N, hN using Nat.le_induction with
  | base => exact ⟨hω ▸ hω0, fun Γ => by rw [← hω, hωK]; simp⟩
  | succ N hN ih =>
    have hmul := mul_smul_formPowR (sY := sX) (c • b ()) N 1 1 1
    rw [one_smul, one_smul, one_mul, one_smul] at hmul
    have h1 : formPowR sX (c • b ()) 1 ≠ 0 := hω ▸ hω0
    have hd : topologicalKrullDim X = (n + 1 : ℕ) := hdim
    refine ⟨hmul ▸ RationalPluriForms.mul_ne_zero hd ih.1 h1, fun Γ => ?_⟩
    rw [← hmul, ordForm_mul Γ ih.1 h1, ih.2 Γ, ← hω, hωK]
    push_cast
    ring

/-- **Pull-backs of sections of `qH`.** Let `f : X ⟶ R` be dominant, `M = f^*H` for a Cartier
divisor `H`, `k(K_X + B) = M`, and `w` a top form with `div w = K_X`. For a global section `φ`
of `𝒪_R(acH)`, the form `f^*φ · w^{⊗ akc}` is a section of `akc(K_X + B)`. -/
private theorem pullback_smul_formPow_mem_logPluricanonicalSections
    {X R : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R]
    (f : X ⟶ R) [IsDominant f] {H : Divisor R} (hH : H.IsCartier)
    {hfH : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ H.supp}
    {M : Divisor X} (hM : H.IsPullback f hfH M) {K : Divisor X} {B : QDivisor X} {k c a : ℕ}
    (hMeq : Divisor.toQDivisor M = (k : ℚ) • (Divisor.toQDivisor K + B))
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (hw : ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
      ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ)
    (hN : 0 < a * (k * c)) (φ : Γ(((a * c) • H).divisorialSheaf, ⊤)) :
    letI := functionFieldAlgebra sX
    (functionFieldMap f (divisorialSectionValue φ)) • formPowR sX w (a * (k * c)) ∈
      logPluricanonicalSections sX (n + 1) (a * (k * c)) B := by
  letI := functionFieldAlgebra sX
  refine ⟨fun h => absurd h (by simp), fun Γ _ hne => ?_⟩
  set g := functionFieldMap f (divisorialSectionValue φ) with hg
  have hg0 : g ≠ 0 := by
    rintro h0
    exact hne (by simp [h0])
  rw [Γ.ordForm_smul_of_topologicalKrullDim_eq hdim hg0 (hw _ hN).1, (hw _ hN).2 Γ]
  -- the coefficient of `⌊akc B⌋`
  have hB : (DivisorWithCoeffs.roundDown (((a * (k * c) : ℕ) : ℤ) • B)).coeff Γ =
      ((a * c : ℕ) : ℤ) * M.coeff Γ - ((a * (k * c) : ℕ) : ℤ) * K.coeff Γ := by
    have h1 := congrArg (fun D : QDivisor X => D.coeff Γ) hMeq
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add] at h1
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, Int.floor_eq_iff]
    simp only [smul_eq_mul, zsmul_eq_mul] at h1 ⊢
    push_cast
    have hE : ((a : ℚ) * ((k : ℚ) * (c : ℚ))) * B.coeff Γ =
        (a : ℚ) * (c : ℚ) * (M.coeff Γ : ℚ) - (a : ℚ) * ((k : ℚ) * (c : ℚ)) * (K.coeff Γ : ℚ) := by
      linear_combination (-((a : ℚ) * (c : ℚ))) * h1
    constructor <;> linarith
  rw [hB]
  -- a local equation of `H` at the image of the generic point of `Γ`
  obtain ⟨U, hU, e, he⟩ := hH (f Γ.genericPoint)
  haveI : Nonempty U := ⟨⟨_, hU⟩⟩
  obtain ⟨h, -, hh⟩ := exists_divisorialSectionValue_eq he (a * c) φ
  have hMΓ := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hM he Γ hU (univComponent R)
  set u := MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
    ((e : RationalFunctions R)) with hu
  have hu0 : u ≠ 0 := (e.isUnit.map _).ne_zero
  have hinv : MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
      (((e ^ (a * c))⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) = u⁻¹ ^ (a * c) := by
    have h1 : MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (((e ^ (a * c))⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) * u ^ (a * c) = 1 := by
      rw [hu, ← map_pow, ← map_mul, ← Units.val_pow_eq_pow_val, ← Units.val_mul, inv_mul_cancel,
        Units.val_one, map_one]
    rw [inv_pow]
    exact eq_inv_of_mul_eq_one_left h1
  rw [hinv] at hh
  haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨Γ.genericPoint, hU⟩⟩
  have hgh : g = X.germToFunctionField (f ⁻¹ᵁ U) (f.appLE U (f ⁻¹ᵁ U) le_rfl h) *
      (functionFieldMap f u)⁻¹ ^ (a * c) := by
    rw [hg, hh, map_mul, MMP.Spreading.functionFieldMap_germToFunctionField f U (f ⁻¹ᵁ U) le_rfl, map_pow,
      map_inv₀]
  have hfu0 : functionFieldMap f u ≠ 0 := (map_ne_zero _).mpr hu0
  have hh0 : X.germToFunctionField (f ⁻¹ᵁ U) (f.appLE U (f ⁻¹ᵁ U) le_rfl h) ≠ 0 := by
    intro h0
    apply hg0
    rw [hgh, h0, zero_mul]
  rw [hgh, Scheme.ord_mul hh0 (pow_ne_zero _ (inv_ne_zero hfu0)),
    MMP.Flips.ord_inv_pow hfu0, ← hMΓ]
  have := ord_germToFunctionField_nonneg Γ hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h)
  push_cast
  linarith

/-- **Powers of Poincaré residues**, in coordinates: if `c w^{⊗m}` has residue `c₁ ω^{⊗m}` along
an adjunction step, then `c^a w^{⊗am}` has residue `c₁^a ω^{⊗am}` for every `a > 0`. -/
private theorem isPoincareResidue_smul_formPowR_pow {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [LocallyOfFiniteType sY] [IsIntegral T]
    {j : T ⟶ Y} {BY : QDivisor Y} {BT : QDivisor T} (hj : IsAdjunctionStep sY BY j BT) {n m : ℕ}
    (hY : topologicalKrullDim Y = n + 1)
    (w : letI := functionFieldAlgebra sY; ⋀[Y.functionField]^(n + 1) Ω[Y.functionField⁄ℂ])
    (c : Y.functionField)
    (ω : letI := functionFieldAlgebra (j ≫ sY); ⋀[T.functionField]^n Ω[T.functionField⁄ℂ])
    (c₁ : T.functionField)
    (h : IsPoincareResidue sY j n m (c • formPowR sY w m) (c₁ • formPowR (j ≫ sY) ω m)) :
    ∀ a, 0 < a → IsPoincareResidue sY j n (a * m) (c ^ a • formPowR sY w (a * m))
      (c₁ ^ a • formPowR (j ≫ sY) ω (a * m)) := by
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (j ≫ sY)
  intro a ha
  suffices H : ∀ N : ℕ, N = a * m → IsPoincareResidue sY j n N (c ^ a • formPowR sY w N)
      (c₁ ^ a • formPowR (j ≫ sY) ω N) from H _ rfl
  induction a, ha using Nat.le_induction with
  | base =>
    intro N hN
    rw [Nat.succ_eq_add_one, zero_add, one_mul] at hN
    subst hN
    simpa only [pow_one] using h
  | succ a ha ih =>
    intro N hN
    have hmul := IsPoincareResidue.mul hj hY (ih _ rfl) h
    rw [mul_smul_formPowR, mul_smul_formPowR, ← pow_succ, ← pow_succ] at hmul
    rw [Nat.succ_mul] at hN
    subst hN
    exact hmul

/-- **The residue of a pulled-back section.** Let `φ = h e^{-ar}` on `U` be a global section of
`𝒪_R(arH)`, `e` a local equation of `H` on `U`, and `T ⟶ X` an adjunction step whose generic
point lies over `U`. If the generator `f^*e^{-r} w^{⊗kr}` has residue `c₁ ω^{⊗kr}` along `T`,
then `f^*φ · w^{⊗akr}` has residue `h|_T · c₁^a ω^{⊗akr}`. -/
private theorem isPoincareResidue_pullback_smul_formPowR
    {X R : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R] (f : X ⟶ R) [IsDominant f]
    {B : QDivisor X} {T : Scheme.{0}} [IsIntegral T] {jT : T ⟶ X} {BT : QDivisor T}
    (hj : IsAdjunctionStep sX B jT BT) {D : Divisor R} {U : R.Opens} [Nonempty U]
    (hU : f (jT (genericPoint T)) ∈ U) {e : (RationalFunctions R)ˣ} {r a k : ℕ} (ha : 0 < a)
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (φ : Γ(D.divisorialSheaf, ⊤)) (h : Γ(R, U))
    (hφ : divisorialSectionValue φ = R.germToFunctionField U h *
      (MMP.Threefold.Mori.Helpers.evalFF (univComponent R) (e : RationalFunctions R))⁻¹ ^ (a * r))
    (ω : letI := functionFieldAlgebra (jT ≫ sX); ⋀[T.functionField]^n Ω[T.functionField⁄ℂ])
    (c₁ : T.functionField)
    (hρ : IsPoincareResidue sX jT n (k * r)
      ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (e : RationalFunctions R)))⁻¹ ^ r • formPowR sX w (k * r))
      (c₁ • formPowR (jT ≫ sX) ω (k * r))) :
    haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hU⟩⟩
    IsPoincareResidue sX jT n (a * (k * r))
      (functionFieldMap f (divisorialSectionValue φ) • formPowR sX w (a * (k * r)))
      (((jT.stalkMap (genericPoint T)).hom (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU
        (f.appLE U (f ⁻¹ᵁ U) le_rfl h)) * c₁ ^ a) • formPowR (jT ≫ sX) ω (a * (k * r))) := by
  haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hU⟩⟩
  letI := functionFieldAlgebra sX
  have hY : topologicalKrullDim X = n + 1 := by rw [hdim]; norm_cast
  have hpow := isPoincareResidue_smul_formPowR_pow hj hY w _ ω c₁ hρ a ha
  have hres := MMP.CyclicChartDifferent.Aux.IsPoincareResidue.algebraMap_smul hpow
    (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h))
  have hg : functionFieldMap f (divisorialSectionValue φ) =
      algebraMap (X.presheaf.stalk (jT (genericPoint T))) X.functionField
        (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h)) *
      ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (e : RationalFunctions R)))⁻¹ ^ r) ^ a := by
    rw [hφ, map_mul, MMP.Spreading.functionFieldMap_germToFunctionField f U (f ⁻¹ᵁ U) le_rfl,
      map_pow, map_inv₀, ← pow_mul, mul_comm r a]
    congr 1
    exact (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hU _).symm
  rw [hg, mul_smul, mul_smul]
  exact hres

/-! ### Small facts about the contraction -/

/-- A morphism inducing isomorphisms on all rings of sections is dominant: an open set missing
the image would have no sections upstairs. -/
private theorem isDominant_of_forall_isIso_app {X Y : Scheme.{u}} (f : X ⟶ Y)
    (hf : ∀ U : Y.Opens, IsIso (f.app U)) : IsDominant f := by
  refine ⟨?_⟩
  rw [DenseRange, dense_iff_closure_eq]
  by_contra hne
  set U : Y.Opens := ⟨(closure (Set.range f.base))ᶜ, isClosed_closure.isOpen_compl⟩
  have hU : (U : Set Y).Nonempty := Set.nonempty_compl.mpr hne
  haveI : Nonempty U := hU.to_subtype
  have hpre : f ⁻¹ᵁ U = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    exact hx (subset_closure (Set.mem_range_self x))
  haveI : Subsingleton Γ(X, f ⁻¹ᵁ U) :=
    CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty hpre)
  haveI : Subsingleton Γ(Y, U) :=
    (asIso (f.app U)).commRingCatIsoToRingEquiv.injective.subsingleton
  exact not_subsingleton Γ(Y, U) inferInstance

/-- Two equal morphisms have the same stalk maps on germs. -/
private theorem stalkMap_germ_eq_of_eq {A C : Scheme.{0}} {g g' : A ⟶ C} (hgg : g = g')
    (U : C.Opens) (x : A) (hx : g x ∈ U) (hx' : g' x ∈ U) (h : Γ(C, U)) :
    (g.stalkMap x).hom (C.presheaf.germ U (g x) hx h) =
      (g'.stalkMap x).hom (C.presheaf.germ U (g' x) hx' h) := by
  subst hgg
  rfl

/-- **The value of a pulled-back function at a point does not depend on the factorization.** -/
private theorem stalkMap_germ_app_eq {A B B' C : Scheme.{0}} (α : A ⟶ B) (β : B ⟶ C)
    (α' : A ⟶ B') (β' : B' ⟶ C) (hαβ : α ≫ β = α' ≫ β') (U : C.Opens) (x : A)
    (hx : α x ∈ β ⁻¹ᵁ U) (hx' : α' x ∈ β' ⁻¹ᵁ U) (h : Γ(C, U)) :
    (α.stalkMap x).hom (B.presheaf.germ (β ⁻¹ᵁ U) (α x) hx (β.app U h)) =
      (α'.stalkMap x).hom (B'.presheaf.germ (β' ⁻¹ᵁ U) (α' x) hx' (β'.app U h)) := by
  have l1 := (Scheme.Hom.germ_stalkMap_apply α (β ⁻¹ᵁ U) x hx (β.app U h)).trans
    (Scheme.Hom.germ_stalkMap_apply (α ≫ β) U x hx h).symm
  have l2 := (Scheme.Hom.germ_stalkMap_apply α' (β' ⁻¹ᵁ U) x hx' (β'.app U h)).trans
    (Scheme.Hom.germ_stalkMap_apply (α' ≫ β') U x hx' h).symm
  exact l1.trans ((stalkMap_germ_eq_of_eq hαβ U x hx hx' h).trans l2.symm)

/-- `ev((e^n)⁻¹) = ev(e)⁻¹ ^ n` for a unit `e` of `K(Y)`. -/
private theorem evalFF_inv_pow {Y : Scheme.{0}} [IsIntegral Y] (e : (RationalFunctions Y)ˣ)
    (n : ℕ) :
    MMP.Threefold.Mori.Helpers.evalFF (univComponent Y)
        (((e ^ n)⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) =
      (MMP.Threefold.Mori.Helpers.evalFF (univComponent Y) (e : RationalFunctions Y))⁻¹ ^ n := by
  have h1 : MMP.Threefold.Mori.Helpers.evalFF (univComponent Y)
      (((e ^ n)⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) *
        (MMP.Threefold.Mori.Helpers.evalFF (univComponent Y) (e : RationalFunctions Y)) ^ n =
      1 := by
    rw [← map_pow, ← map_mul, ← Units.val_pow_eq_pow_val, ← Units.val_mul, inv_mul_cancel,
      Units.val_one, map_one]
  rw [inv_pow]
  exact eq_inv_of_mul_eq_one_left h1

/-! ### Local generators of a semiample adjoint -/

/-- An epimorphic counit of `f^* ⊣ f_*` stays epimorphic along an isomorphism of modules. -/
private theorem epi_counit_of_iso {X Z : Scheme.{0}} (f : X ⟶ Z) {M N : X.Modules} (e : N ≅ M)
    (h : Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app M)) :
    Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app N) := by
  set adj := Scheme.Modules.pullbackPushforwardAdjunction f
  have hnat := adj.counit.naturality e.hom
  have heq : adj.counit.app N =
      (Scheme.Modules.pushforward f ⋙ Scheme.Modules.pullback f).map e.hom ≫
        adj.counit.app M ≫ e.inv := by
    rw [← Category.assoc, hnat, Functor.id_map, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  rw [heq]
  infer_instance

section Conversion

open MMP.Intersection

open MMP.Intersection in
/-- On an integral locally Noetherian scheme, a point of coheight zero lies in the support of no
Cartier divisor. -/
private theorem notMem_cartierSupport_of_coheight_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (A : X.CartierDivisor) {x : X} (hx : Order.coheight x = 0) :
    x ∉ cartierSupport A := by
  have : Ring.KrullDimLE 0 (X.presheaf.stalk x) := krullDimLE_of_coheight_le (by simp [hx])
  have : IsArtinianRing (X.presheaf.stalk x) := isArtinianRing_iff_krullDimLE_zero.mpr this
  exact notMem_cartierSupport_of_isArtinianRing A x

/-- Every Cartier divisor on a Noetherian integral scheme has a Weil divisor. -/
private theorem exists_isWeilDivisorOfCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [TopologicalSpace.NoetherianSpace X] (A : X.CartierDivisor) :
    ∃ w : Divisor X, IsWeilDivisorOfCartier A w := by
  have hfin := MMP.Mori.finite_setOf_genericPoint_mem (isClosed_cartierSupport A)
    (fun s hs h0 => notMem_cartierSupport_of_coheight_eq_zero A h0 hs)
  refine ⟨Finsupp.ofSupportFinite (fun P => primeDivisorOrder P A) (hfin.subset fun P hP => ?_),
    fun P => ?_⟩
  · by_contra h
    have hg : (primeDivisorSubvariety P).genericPoint = P.genericPoint := rfl
    refine hP ((isOrderAlong_primeDivisorOrder A P).eq_zero_of_not_subset fun h' => h ?_)
    show P.genericPoint ∈ cartierSupport A
    rw [← hg]
    exact genericPoint_mem_cartierSupport_iff.mpr h'
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.ofSupportFinite_coe]
    exact isOrderAlong_primeDivisorOrder A P

/-- The Weil divisor of the realization of `q • C`, for a `ℚ`-Cartier divisor `C` with Weil
`ℚ`-divisor `D`, is `q • D`. -/
private theorem coeff_eq_mul_of_isWeilDivisorOfCartier_realization {X : Scheme.{0}}
    [IsLocallyNoetherian X] {D : QDivisor X} {C : KCartierDivisor ℚ X}
    (hC : ∀ P : MMP.Mori.PrimeDivisor X,
      D.coeff P = C.sum fun E c => c * (primeDivisorOrder P E : ℚ)) {q : ℕ}
    (h : ∀ E, ∃ n : ℤ, ((q : ℚ) • C) E = n) {B : Divisor X}
    (hB : IsWeilDivisorOfCartier (KCartierDivisor.realization ((q : ℚ) • C) h) B)
    (P : MMP.Mori.PrimeDivisor X) : (B.coeff P : ℚ) = q * D.coeff P := by
  classical
  have hc : ∀ E, ((Classical.choose (h E) : ℤ) : ℚ) = ((q : ℚ) • C) E := fun E =>
    (Classical.choose_spec (h E)).symm
  rw [← (hB P).primeDivisorOrder_eq, KCartierDivisor.realization, Finsupp.sum, map_sum,
    Int.cast_sum, hC P, Finsupp.sum, Finset.mul_sum]
  have hz : ∀ E ∈ C.support, E ∉ ((q : ℚ) • C).support →
      (q : ℚ) * (C E * (primeDivisorOrder P E : ℚ)) = 0 := fun E _ hE => by
    rw [Finsupp.notMem_support_iff, Finsupp.smul_apply, smul_eq_mul] at hE
    rw [← mul_assoc, hE, zero_mul]
  rw [← Finset.sum_subset (Finsupp.support_smul (b := (q : ℚ)) (g := C)) hz]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [map_zsmul, smul_eq_mul, Int.cast_mul, hc, Finsupp.smul_apply, smul_eq_mul, mul_assoc]

/-- An integral scheme is its own unique irreducible component. -/
private theorem univ_mem_irreducibleComponents (X : Scheme.{0}) [IsIntegral X] :
    (Set.univ : Set X) ∈ irreducibleComponents X := by
  rw [irreducibleComponents_eq_singleton]; rfl

private theorem specializes_genericPoint {Y : Scheme.{u}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : componentGenericPoint Y Z ⤳ genericPoint Y :=
  (Inseparable.of_eq (componentGenericPoint_eq_genericPoint Z)).specializes

private theorem genericPoint_specializes {Y : Scheme.{u}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : genericPoint Y ⤳ componentGenericPoint Y Z :=
  (genericPoint_spec Y).specializes trivial

/-- A rational function `φ ∈ K(Y)`, read in every factor of `K(Y) = ∏_Z 𝒪_{Y,η_Z}`. -/
private noncomputable def toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y] :
    Y.functionField →+* RationalFunctions Y :=
  Pi.ringHom fun Z => (Y.presheaf.stalkSpecializes (specializes_genericPoint Z)).hom

private theorem stalkSpecializes_toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) (φ : Y.functionField) :
    (Y.presheaf.stalkSpecializes (genericPoint_specializes Z)).hom
      (toRationalFunctions φ Z) = φ := by
  change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom φ) = φ
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- `v_P` on the factor `𝒪_{Y,η}` of `K(Y)` is the inverse of the divisorial valuation of the
corresponding rational function. -/
private theorem valuation_eq_inv_divisorialValuation {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y)
    (s : Y.presheaf.stalk (componentGenericPoint Y P.component)) :
    P.valuation s = (P.divisorialValuation
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes P.component)).hom s))⁻¹ := by
  rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
  rfl

/-- The order along `P` of the unit of `K(Y)` defined by `φ ≠ 0` is `ord_{η_P}(φ)`. -/
private theorem ord_toRationalFunctions {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y) {φ : Y.functionField}
    (hφ : φ ≠ 0) (ψ : (RationalFunctions Y)ˣ) (hψ : (ψ : RationalFunctions Y) =
      toRationalFunctions φ) : P.ord ψ = Scheme.ord φ P.genericPoint := by
  have h2 := valuation_eq_inv_divisorialValuation P ((ψ : RationalFunctions Y) P.component)
  rw [hψ, stalkSpecializes_toRationalFunctions, ← hψ, P.valuation_component,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hφ, ← WithZero.exp_neg,
    neg_neg] at h2
  exact WithZero.exp_injective h2

/-- A relatively semiample `ℚ`-divisor has a relatively free Cartier multiple. -/
private theorem exists_isRelativelyFreeDivisor_of_isRelativelySemiample {X Z : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z)
    (D : QDivisor X) (h : QDivisor.IsRelativelySemiample f D) :
    ∃ m : ℕ, 0 < m ∧ ∃ L : Divisor X, Divisor.toQDivisor L = (m : ℤ) • D ∧ L.IsCartier ∧
      IsRelativelyFreeDivisor f L := by
  classical
  haveI : IsNoetherian X := ⟨⟩
  obtain ⟨C, hC, q, hq, hint, hfree⟩ := h
  obtain ⟨w, hw⟩ := exists_isWeilDivisorOfCartier
    (KCartierDivisor.realization ((q : ℚ) • C) hint)
  refine ⟨q, hq, w, ?_, hw.isCartier, ?_⟩
  · ext P
    rw [Divisor.coeff_toQDivisor, coeff_eq_mul_of_isWeilDivisorOfCartier_realization hC hint hw P]
    simp [DivisorWithCoeffs.coeff_apply, zsmul_eq_mul]
  · obtain ⟨e⟩ := hw.nonempty_sheaf_iso_divisorialSheaf
    exact epi_counit_of_iso f e.symm hfree

/-! ### The normalization components -/

/-- A unit of `K(X)` which is regular at a point `x` of the prime divisor `E` has nonnegative
order along `E`, and order zero if it is a unit at `x`. -/
private theorem zero_le_ordUnit_of_eq_stalkToRationalFunctions {X : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] (E : Mori.PrimeDivisor X) {x : X}
    (hxE : x ∈ E.support) (t : X.presheaf.stalk x)
    (u : (X.presheaf.stalk (componentGenericPoint X E.component))ˣ)
    (hu : (stalkToRationalFunctions X (E.support_subset_component hxE)).hom t = u) :
    0 ≤ E.ordUnit u ∧ (IsUnit t → E.ordUnit u = 0) := by
  have hspec : E.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact specializes_iff_mem_closure.mpr hxE
  set b : E.localRing := (X.presheaf.stalkSpecializes hspec).hom t with hb
  have hbu : E.toComponent.hom b = u := by
    rw [hb, E.toComponent_stalkSpecializes hspec (E.support_subset_component hxE), hu]
  refine ⟨?_, fun ht => E.ordUnit_eq_zero_of_isUnit (ht.map _) hbu⟩
  have := E.isDiscreteValuationRing_localRing
  have hb0 : b ≠ 0 := fun h0 => u.ne_zero (by rw [← hbu, h0, map_zero])
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
  have h := E.valuation_eq_exp_ordUnit u
  rw [← hbu, hv, map_mul, map_pow, map_mul, map_pow, E.valuation_toComponent_of_isUnit v.isUnit,
    E.valuation_toComponent_of_irreducible hϖ, one_mul, ← WithZero.exp_nsmul] at h
  have := WithZero.exp_injective h
  simp only [nsmul_eq_mul, mul_one] at this
  omega

/-- **Pull-backs of effective divisors.** If `G` is a Cartier divisor on `Y`, `G'` its pull-back
along `j : X ⟶ Y` and `G` is effective, resp. zero, along the prime divisors through `j(x)`, then
`G'` is effective, resp. zero, along the prime divisors through `x`. -/
private theorem coeff_isPullback_of_forall {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (j : X ⟶ Y) {G : Divisor Y} (hGc : G.IsCartier)
    {hB : ∀ Z : irreducibleComponents X, j (componentGenericPoint X Z) ∉ G.supp}
    {G' : Divisor X} (h : G.IsPullback j hB G') (x : X) :
    ((∀ Γ : Mori.PrimeDivisor Y, j x ∈ Γ.support → 0 ≤ G.coeff Γ) →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support → 0 ≤ G'.coeff E) ∧
    ((∀ Γ : Mori.PrimeDivisor Y, j x ∈ Γ.support → G.coeff Γ = 0) →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support → G'.coeff E = 0) := by
  obtain ⟨U, hU, φ, hφ⟩ := hGc (j x)
  set W := pointComponent (j x)
  have key : ∀ (r : Y.presheaf.stalk (j x)),
      (stalkToRationalFunctions Y (mem_pointComponent (j x))).hom r = (φ : RationalFunctions Y) W →
      ∀ E : Mori.PrimeDivisor X, x ∈ E.support →
        0 ≤ G'.coeff E ∧ (IsUnit r → G'.coeff E = 0) := by
    intro r hr E hxE
    have hE : (E.support ∩ j ⁻¹ᵁ U).Nonempty := ⟨x, hxE, hU⟩
    rw [h U φ hφ E hE]
    set Z := E.component
    have hxZ : x ∈ Z.1 := E.support_subset_component hxE
    have hsZ : componentGenericPoint X Z ⤳ x :=
      (isGenericPoint_componentGenericPoint X Z).specializes hxZ
    have hsY : j (componentGenericPoint X Z) ⤳ j x := hsZ.map j.continuous
    have hW : j (componentGenericPoint X Z) ∈ W.1 := by
      have : (W.1 : Set Y) = Set.univ := by
        have h1 : (W.1 : Set Y) ∈ ({Set.univ} : Set (Set Y)) := by
          rw [← irreducibleComponents_eq_singleton]; exact W.2
        exact h1
      rw [this]; trivial
    obtain ⟨a, ha⟩ := hφ.exists_unit_stalk (E.map_componentGenericPoint_mem j hE) (hB Z) hW
    have har : (a : Y.presheaf.stalk _) = (Y.presheaf.stalkSpecializes hsY).hom r := by
      apply stalkToRationalFunctions_injective hW
      rw [ha]
      change _ = (Y.presheaf.stalkSpecializes hsY ≫ Y.presheaf.stalkSpecializes _).hom r
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact hr.symm
    rw [pullbackComponent_eq hB hφ (E.map_componentGenericPoint_mem j hE) hW a ha]
    have hval : (Units.map (j.stalkMap (componentGenericPoint X Z)).hom.toMonoidHom a :
        X.presheaf.stalk _) = (stalkToRationalFunctions X hxZ).hom ((j.stalkMap x).hom r) := by
      change (j.stalkMap (componentGenericPoint X Z)).hom
        (a : Y.presheaf.stalk (j (componentGenericPoint X Z))) = _
      rw [har]
      exact Scheme.Hom.stalkSpecializes_stalkMap_apply j _ x hsZ r
    obtain ⟨h1, h2⟩ := zero_le_ordUnit_of_eq_stalkToRationalFunctions E hxE
      ((j.stalkMap x).hom r) _ hval.symm
    exact ⟨h1, fun hru => h2 (hru.map _)⟩
  constructor
  · intro hG E hxE
    obtain ⟨r, hr⟩ := exists_stalk_eq_of_forall_zero_le_ord (mem_pointComponent (j x)) φ
      fun Γ hΓ => by rw [← hφ Γ ⟨j x, hΓ, hU⟩]; exact hG Γ hΓ
    exact (key r hr E hxE).1
  · intro hG E hxE
    obtain ⟨a, ha⟩ := exists_unit_stalk_of_forall_ord_eq_zero (mem_pointComponent (j x)) φ
      fun Γ hΓ => by rw [← hφ Γ ⟨j x, hΓ, hU⟩]; exact hG Γ hΓ
    exact (key a ha E hxE).2 a.isUnit

/-- The pull-back of a Cartier divisor is Cartier. -/
private theorem isCartier_of_isPullback {X Y : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] (j : X ⟶ Y) {G : Divisor Y} (hGc : G.IsCartier)
    {hB : ∀ Z : irreducibleComponents X, j (componentGenericPoint X Z) ∉ G.supp}
    {G' : Divisor X} (h : G.IsPullback j hB G') : G'.IsCartier := by
  classical
  intro s
  obtain ⟨U, hU, φ, hφ⟩ := hGc (j s)
  let ψ : (RationalFunctions X)ˣ := (RationalFunctions.unitsEquiv X).symm fun Z =>
    if hZ : j (componentGenericPoint X Z) ∈ U then pullbackComponent j hB hφ Z hZ else 1
  refine ⟨j ⁻¹ᵁ U, hU, ψ, fun E hE => ?_⟩
  rw [h U φ hφ E hE, PrimeDivisor.ord_eq_ordUnit]
  congr 1
  ext
  change _ = (if hZ : j (componentGenericPoint X E.component) ∈ U then
    pullbackComponent j hB hφ E.component hZ else 1).val
  rw [dite_eq_left (E.map_componentGenericPoint_mem j hE)]

/-- The unit of `K(Y)` defined by a nonzero rational function. -/
private noncomputable def unitOfFunction {Y : Scheme.{0}} [IsIntegral Y] {g : Y.functionField}
    (hg : g ≠ 0) : (RationalFunctions Y)ˣ :=
  Units.map toRationalFunctions.toMonoidHom (Units.mk0 g hg)

private theorem coe_unitOfFunction {Y : Scheme.{0}} [IsIntegral Y] {g : Y.functionField}
    (hg : g ≠ 0) : (unitOfFunction hg : RationalFunctions Y) = toRationalFunctions g := rfl

/-- **Pull-backs of principal divisors of units along a closed immersion.** If `a` is a unit of
`𝒪_{Y,j(η_X)}`, the pull-back of `div(a)` along `j` is `div(j^♯ a)`. -/
private theorem isPullback_principalDivisor_unitOfFunction {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y]
    (j : X ⟶ Y) {a : Y.presheaf.stalk (j (genericPoint X))} (ha : IsUnit a)
    (hg : algebraMap _ Y.functionField a ≠ 0) (hg' : (j.stalkMap (genericPoint X)).hom a ≠ 0)
    (hB : ∀ Z : irreducibleComponents X,
      j (componentGenericPoint X Z) ∉ (Mori.principalDivisor (unitOfFunction hg)).supp) :
    (Mori.principalDivisor (unitOfFunction hg)).IsPullback j hB
      (Mori.principalDivisor (unitOfFunction (Y := X) hg')) := by
  refine Divisor.IsPullback.of_forall_exists fun E => ⟨⊤, unitOfFunction hg,
    Divisor.isLocalEquation_principalDivisor _ ⊤, (E.genericPoint_mem_iff _).mp trivial, ?_⟩
  set Z := E.component
  have hcZ : componentGenericPoint X Z ⤳ genericPoint X := specializes_genericPoint Z
  have hcY : j (componentGenericPoint X Z) ⤳ j (genericPoint X) := hcZ.map j.continuous
  set W := pointComponent (j (componentGenericPoint X Z))
  have hW : j (componentGenericPoint X Z) ∈ W.1 := mem_pointComponent _
  let a' : (Y.presheaf.stalk (j (componentGenericPoint X Z)))ˣ :=
    (ha.map (Y.presheaf.stalkSpecializes hcY).hom).unit
  have ha' : (stalkToRationalFunctions Y hW).hom a' =
      (unitOfFunction hg : RationalFunctions Y) W := by
    rw [coe_unitOfFunction]
    change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes hcY).hom a) =
      (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom a)
    rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_comp_apply]
  rw [coeff_principalDivisor, PrimeDivisor.ord_eq_ordUnit,
    pullbackComponent_eq hB (Divisor.isLocalEquation_principalDivisor _ ⊤)
      (show j (componentGenericPoint X Z) ∈ (⊤ : Y.Opens) from trivial) hW a' ha']
  congr 1
  ext
  change toRationalFunctions ((j.stalkMap (genericPoint X)).hom a) Z =
    (j.stalkMap (componentGenericPoint X Z)).hom ((Y.presheaf.stalkSpecializes hcY).hom a)
  rw [Scheme.Hom.stalkSpecializes_stalkMap_apply j _ _ hcZ a]
  rfl

end Conversion

/-- The generic point of a prime divisor lies on it. -/
private theorem genericPoint_mem_support {X : Scheme.{0}} (D : Mori.PrimeDivisor X) :
    D.genericPoint ∈ D.support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact subset_closure rfl

/-- **Local generators of a semiample adjoint.** If `K + B` is semiample on a projective normal
variety, there is `N > 0` such that every point has a section of `N(K + B)` generating it on a
neighbourhood: for a free multiple `L` of `K + B`, a member `L + div ψ` avoiding the point gives
the section `ψ · ω^{⊗N}`, `div ω = K`. -/
private theorem exists_generatesOn_of_isRelativelySemiample {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)}
    (hS : Mori.IsProjectiveVariety ℂ sS) {n : ℕ} (hdim : topologicalKrullDim S = n) {B : QDivisor S}
    {K : Divisor S} (hK : K.IsCanonicalDivisor sS n)
    (hsemi : QDivisor.IsRelativelySemiample sS (Divisor.toQDivisor K + B)) :
    ∃ N : ℕ, 0 < N ∧ ∀ x : S, ∃ σ ∈ logPluricanonicalSections sS n N B,
      ∃ V : S.Opens, x ∈ V ∧ GeneratesOn B N V σ := by
  classical
  haveI : LocallyOfFiniteType sS := hS.toLocallyOfFiniteType
  haveI : QuasiCompact sS := hS.toQuasiCompact
  haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace sS
  have hX : IsNormalVariety ℂ sS := ⟨hS.toIsVariety, inferInstance⟩
  have hdim2 : topologicalKrullDim S = ((n : ℕ) : WithBot ℕ∞) := hdim
  obtain ⟨N, hN, L, hL, hLc, hfree⟩ :=
    exists_isRelativelyFreeDivisor_of_isRelativelySemiample sS _ hsemi
  obtain ⟨ω₀, hω₀0, hω₀K⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
  set τ := MMP.CyclicChartDifferent.Aux.pluriPow ω₀ M with hτdef
  have hτ0 : τ ≠ 0 := MMP.CyclicChartDifferent.Aux.pluriPow_ne_zero hdim2 hω₀0 M
  have hLcoeff : ∀ Γ, (L.coeff Γ : ℚ) = ((M + 1 : ℕ) : ℚ) * (K.coeff Γ + B.coeff Γ) := by
    intro Γ
    have h1 := congrArg (fun D : QDivisor S => D.coeff Γ) hL
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      nsmul_eq_mul] at h1
    exact h1
  refine ⟨M + 1, by omega, fun x => ?_⟩
  obtain ⟨U₀, hU₀, ψ, hψ1, hψ2⟩ := exists_coeff_add_ord_eq_zero_of_isRelativelyFree sS hLc hfree x
  have hU₀top : ∀ Γ : Mori.PrimeDivisor S, (Γ.support ∩ sS ⁻¹ᵁ U₀).Nonempty := by
    intro Γ
    obtain ⟨y⟩ : Nonempty Γ.support := ⟨⟨Γ.genericPoint, genericPoint_mem_support Γ⟩⟩
    refine ⟨y, y.2, ?_⟩
    have : sS.base y = sS.base x := Subsingleton.elim _ _
    show sS.base y ∈ U₀
    rw [this]; exact hU₀
  set Z₀ := MMP.Mori.pointComponent (genericPoint S)
  set g : S.functionField := (MMP.Positivity.componentToFunctionField Z₀).hom (ψ.val Z₀) with hgdef
  have hg0 : g ≠ 0 := ((ψ.isUnit.map (Pi.evalRingHom _ Z₀)).map _).ne_zero
  have hordg : ∀ Γ : Mori.PrimeDivisor S, S.ord g Γ.genericPoint = Γ.ord ψ := by
    intro Γ
    have h1 := MMP.Positivity.ord_eq_ord_componentToFunctionField Γ ψ
    have hZ : Γ.component = Z₀ := Subsingleton.elim
      (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := S)) _ _
    rw [hZ, ← hgdef] at h1
    exact h1.symm
  have hσ0 : g • τ ≠ 0 := smul_ne_zero hg0 hτ0
  -- `ord_Γ σ + N b_Γ = (L + div ψ)_Γ`
  have hkey : ∀ Γ : Mori.PrimeDivisor S,
      ((Γ.ordForm (g • τ) : ℤ) : ℚ) + ((M + 1 : ℕ) : ℚ) * B.coeff Γ =
        ((L.coeff Γ + Γ.ord ψ : ℤ) : ℚ) := by
    intro Γ
    rw [Γ.ordForm_smul_of_topologicalKrullDim_eq hdim2 hg0 hτ0, hτdef,
      MMP.CyclicChartDifferent.Aux.ordForm_pluriPow hdim2 hω₀0 Γ M, hω₀K Γ, hordg Γ]
    push_cast
    rw [hLcoeff Γ]
    push_cast
    ring
  -- `N B` is integral
  have hint : ∀ Γ : Mori.PrimeDivisor S, ⌊((M + 1 : ℕ) : ℤ) • B.coeff Γ⌋ =
      L.coeff Γ - ((M + 1 : ℕ) : ℤ) * K.coeff Γ := by
    intro Γ
    rw [Int.floor_eq_iff]
    have := hLcoeff Γ
    rw [zsmul_eq_mul]
    push_cast at this ⊢
    constructor <;> nlinarith
  have hmem : g • τ ∈ logPluricanonicalSections sS n (M + 1) B := by
    refine (mem_pluricanonicalSections_of_ne_bot (by simp)).2 fun Γ _ _ => ?_
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, hint Γ]
    have h1 := hkey Γ
    have h2 : (0 : ℚ) ≤ ((L.coeff Γ + Γ.ord ψ : ℤ) : ℚ) := by exact_mod_cast hψ1 Γ (hU₀top Γ)
    have h3 := hLcoeff Γ
    have h4 : ((Γ.ordForm (g • τ) : ℤ) : ℚ) + ((L.coeff Γ - ((M + 1 : ℕ) : ℤ) * K.coeff Γ : ℤ) : ℚ)
        ≥ 0 := by
      push_cast at h1 h2 h3 ⊢
      linarith
    exact_mod_cast h4
  set E : Divisor S := L + principalDivisor ψ with hEdef
  have hEcoeff : ∀ Γ, E.coeff Γ = L.coeff Γ + Γ.ord ψ := fun Γ => by
    simp [hEdef, DivisorWithCoeffs.coeff_add, coeff_principalDivisor]
  have hzero : ∀ Γ : Mori.PrimeDivisor S, (Γ.support ∩ (E.supp.compl : Set S)).Nonempty →
      E.coeff Γ = 0 := by
    rintro Γ ⟨y, hyΓ, hyV⟩
    by_contra hne
    exact hyV (DivisorWithCoeffs.mem_supp_iff.2 ⟨Γ, hne, hyΓ⟩)
  refine ⟨g • τ, hmem, E.supp.compl, ?_, hσ0, fun Γ hΓ => ?_⟩
  · intro hx
    obtain ⟨Γ, hΓ, hxΓ⟩ := DivisorWithCoeffs.mem_supp_iff.1 hx
    exact hΓ (by rw [hEcoeff]; exact hψ2 Γ hxΓ)
  · have h1 := hkey Γ
    rw [← hEcoeff, hzero Γ hΓ] at h1
    push_cast at h1 ⊢
    exact h1

/-! ### Residue restrictions exist -/

/-- The coheight of a point is at most the dimension of the scheme. -/
private theorem coheight_le_of_topologicalKrullDim_eq {X : Scheme.{0}} {n : ℕ∞}
    (h : topologicalKrullDim X = n) (x : X) : Order.coheight x ≤ n := by
  have h2 : ringKrullDim (X.presheaf.stalk x) ≤ topologicalKrullDim X := by
    rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk X]
    exact le_iSup (fun y : X => ringKrullDim (X.presheaf.stalk y)) x
  rw [AlgebraicGeometry.ringKrullDim_stalk_eq_coheight, h] at h2
  exact_mod_cast h2

/-- **A normal variety over `ℂ` has a canonical divisor.** -/
private theorem exists_isCanonicalDivisor' {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) {n : ℕ} (hn : topologicalKrullDim X = n) :
    ∃ K : Divisor X, K.IsCanonicalDivisor sX n := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  let := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hn
  exact ⟨_, MMP.Spreading.CanonExist.isCanonicalDivisor_topFormDivisor hX hn
    (ω := (b () : RationalTopForms sX n)) (b.ne_zero ())⟩

/-- **Moving a Cartier multiple across a linear equivalence.** If `D₀ = m(K + B)` and
`K' - K = div φ`, then `D₀ + div(φ^m) = m(K' + B)`. -/
private theorem toQDivisor_add_principalDivisor_pow {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {D₀ K K' : Divisor X}
    {B : QDivisor X} {m : ℕ} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • (Divisor.toQDivisor K + B))
    {φ : (RationalFunctions X)ˣ} (hφ : K' - K = principalDivisor φ) :
    Divisor.toQDivisor (D₀ + principalDivisor (φ ^ m)) =
      (m : ℤ) • (Divisor.toQDivisor K' + B) := by
  ext Γ
  have h1 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
  have h2 := congrArg (fun G : Divisor X => G.coeff Γ) hφ
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_add, zsmul_eq_mul] at h1 ⊢
  simp only [DivisorWithCoeffs.coeff_sub, coeff_principalDivisor] at h2
  simp only [DivisorWithCoeffs.coeff_add, coeff_principalDivisor, PrimeDivisor.ord_pow]
  have h2' : (K'.coeff Γ : ℚ) - K.coeff Γ = Γ.ord φ := by exact_mod_cast h2
  push_cast
  rw [h1, nsmul_eq_mul]
  push_cast
  linear_combination (-(m : ℚ)) * h2'

/-- A scheme of dimension zero has no prime divisors. -/
private theorem isEmpty_primeDivisor_of_topologicalKrullDim_eq_zero {S : Scheme.{0}}
    (hS : topologicalKrullDim S = 0) : IsEmpty (Mori.PrimeDivisor S) := by
  refine ⟨fun P => ?_⟩
  have h := coheight_le_of_topologicalKrullDim_eq hS P.genericPoint
  rw [P.coheight_genericPoint] at h
  exact absurd h (by decide)

/-- **Stratum adjoints are Cartier.** If `m(K_X + B)` is Cartier, then along every flag of iterated
adjunction the final adjoint `m(K_T + B_T)` is Cartier for some canonical divisor `K_T`. -/
private theorem exists_isCartierDivisor_of_stratumAdjunctionData {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X}
    {m : ℕ} (hm : 0 < m)
    (hX : ∃ (d : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX d ∧
      ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor) :
    ∀ {T : Scheme.{0}} {ι : T ⟶ X} {BT : QDivisor T} (F : StratumAdjunctionData sX B ι BT),
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      ∃ (d : ℕ) (K : Divisor T), K.IsCanonicalDivisor (ι ≫ sX) d ∧
        ((m : ℤ) • (Divisor.toQDivisor K + BT)).IsCartierDivisor := by
  intro T ι BT F
  induction F with
  | refl h =>
    obtain ⟨d, K, hK, hc⟩ := hX
    exact ⟨d, K, by rw [Category.id_comp]; exact hK, hc⟩
  | @step S T ι BS F j BT hj ih =>
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    obtain ⟨d, KS, hKS, hc⟩ := ih
    rw [Category.assoc]
    haveI : IsIntegral T := hj.1.1.toIsIntegral
    haveI : IsNormal T := hj.1.2
    haveI : LocallyOfFiniteType (ι ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (j ≫ ι ≫ sX) := hj.1.1.toLocallyOfFiniteType
    haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ι ≫ sX)
    haveI : QuasiCompact (ι ≫ sX) := F.isNormalVariety.1.toQuasiCompact
    haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace (ι ≫ sX)
    haveI : QuasiCompact (j ≫ ι ≫ sX) := hj.1.1.toQuasiCompact
    haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace (j ≫ ι ≫ sX)
    obtain ⟨-, P, -, hrange, hci, -⟩ := id hj
    haveI := hci
    set e := (letI := functionFieldAlgebra (j ≫ ι ≫ sX);
      (Algebra.trdeg ℂ T.functionField).toNat) with he_def
    have he : topologicalKrullDim T = e := topologicalKrullDim_eq_toNat_trdeg (j ≫ ι ≫ sX)
    have hdS : topologicalKrullDim S = e + 1 := by
      rw [topologicalKrullDim_eq_toNat_trdeg (ι ≫ sX), ← hj.trdeg_add_one, ← he_def]
      push_cast
      rfl
    have hd : (d : WithBot ℕ∞) = ((e + 1 : ℕ) : WithBot ℕ∞) := by
      rw [← hKS.topologicalKrullDim_eq, hdS]; push_cast; rfl
    have hd' : d = e + 1 := by exact_mod_cast hd
    subst hd'
    obtain ⟨KT₀, hKT₀⟩ := exists_isCanonicalDivisor' hj.1 he
    rcases Nat.eq_zero_or_pos e with he0 | he0
    · haveI := isEmpty_primeDivisor_of_topologicalKrullDim_eq_zero (S := T) (by rw [he, he0]; rfl)
      exact ⟨e, KT₀, hKT₀, 0, Subsingleton.elim _ _, Divisor.isCartier_zero⟩
    · obtain ⟨Q⟩ := MMP.Positivity.nonempty_primeDivisor_of_topologicalKrullDim_eq he he0.ne'
      obtain ⟨σ, hσ0, hσP, -, ρ, hρ, hρ0, -⟩ :=
        exists_form_of_residue_order (ι ≫ sX) F.isNormalVariety (n := e) hdS j
          hj.1 P hrange Q
      obtain ⟨φ, hφ⟩ : (divisorOfForm σ).LinearlyEquivalent KS := by
        simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul F.isNormalVariety hKS
          (m := 1) hσ0
      obtain ⟨D₀, hD₀, hD₀c⟩ := hc
      set D : Divisor S := D₀ + principalDivisor (φ ^ m) with hD_def
      have hD : Divisor.toQDivisor D = (m : ℤ) • (Divisor.toQDivisor (divisorOfForm σ) + BS) :=
        toQDivisor_add_principalDivisor_pow hD₀ hφ
      have hDc : D.IsCartier := hD₀c.add (Divisor.isCartier_principalDivisor _)
      have hQc : (Divisor.toQDivisor (divisorOfForm σ) + BS).IsQCartier :=
        ⟨(m : ℤ), by exact_mod_cast hm.ne', D, hD, hDc⟩
      obtain ⟨hgen, hpb⟩ := hj.isPullback_divisorOfForm_add_of_isPoincareResidue (n := e) hdS P
        hrange σ hσ0 hσP ρ hρ hQc
      obtain ⟨D', hD', hD'p⟩ := hpb m hm D hD hDc
      exact ⟨e, divisorOfForm ρ, hKT₀.of_linearlyEquivalent (by
        simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hj.1 hKT₀ (m := 1) hρ0),
        D', hD', isCartier_of_isPullback j hDc hD'p⟩

/-- The logarithmic frame `dt/t ∧ dx₁ ∧ ⋯ ∧ dx_e` of top forms along a prime divisor. -/
private noncomputable def logFrame {Y T : Scheme.{0}} [IsIntegral Y] [IsIntegral T] (sY : Y ⟶ Spec (.of ℂ))
    (j : T ⟶ Y) {e : ℕ} (t : Y.presheaf.stalk (j (genericPoint T)))
    (x : Fin e → Y.presheaf.stalk (j (genericPoint T))) :
    letI := functionFieldAlgebra sY
    ⋀[Y.functionField]^(e + 1) Ω[Y.functionField⁄ℂ] :=
  letI := functionFieldAlgebra sY
  (algebraMap _ Y.functionField t)⁻¹ • exteriorPower.ιMulti Y.functionField (e + 1)
    (Fin.cons (KaehlerDifferential.D ℂ Y.functionField (algebraMap _ _ t))
      fun i => KaehlerDifferential.D ℂ Y.functionField (algebraMap _ _ (x i)))

/-- The restricted frame `dx̄₁ ∧ ⋯ ∧ dx̄_e` of top forms on the divisor. -/
private noncomputable def resFrame {Y T : Scheme.{0}} [IsIntegral T] (sY : Y ⟶ Spec (.of ℂ))
    (j : T ⟶ Y) {e : ℕ} (x : Fin e → Y.presheaf.stalk (j (genericPoint T))) :
    letI := functionFieldAlgebra (j ≫ sY)
    ⋀[T.functionField]^e Ω[T.functionField⁄ℂ] :=
  letI := functionFieldAlgebra (j ≫ sY)
  exteriorPower.ιMulti T.functionField e fun i =>
    KaehlerDifferential.D ℂ T.functionField ((j.stalkMap (genericPoint T)).hom (x i))

/-- The residue of a form written in the logarithmic frame. -/
private theorem isPoincareResidue_smul_formPow_logFrame {Y T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsIntegral T] (sY : Y ⟶ Spec (.of ℂ)) (j : T ⟶ Y) {e m : ℕ}
    {t : Y.presheaf.stalk (j (genericPoint T))} (ht : Y.ord (algebraMap _ Y.functionField t)
      (j (genericPoint T)) = 1) (x : Fin e → Y.presheaf.stalk (j (genericPoint T)))
    (h : Y.presheaf.stalk (j (genericPoint T))) :
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (j ≫ sY)
    IsPoincareResidue sY j e m
      (algebraMap _ Y.functionField h • formPow (logFrame sY j t x) m)
      ((j.stalkMap (genericPoint T)).hom h • formPow (resFrame sY j x) m) :=
  ⟨t, h, x, ht, rfl, rfl⟩

/-- A nonzero element of the stalk at `j(η_T)` whose restriction to `T` is nonzero is a unit. -/
private theorem isUnit_of_stalkMap_ne_zero {Y T : Scheme.{0}} [IsIntegral T] (j : T ⟶ Y)
    {h : Y.presheaf.stalk (j (genericPoint T))} (hh : (j.stalkMap (genericPoint T)).hom h ≠ 0) :
    IsUnit h := by
  have hfield : IsField (T.presheaf.stalk (genericPoint T)) := by
    have := RationalFunctions.isField_stalk T ⟨Set.univ, univ_mem_irreducibleComponents T⟩
    rwa [componentGenericPoint_eq_genericPoint] at this
  letI := hfield.toField
  exact isUnit_of_map_unit (j.stalkMap (genericPoint T)).hom h (isUnit_iff_ne_zero.mpr hh)

/-- **The logarithmic frame of a residue.** Let `σ` be a rational top form on `Y` with a simple
pole along the prime divisor `P = j(T)` and a nonzero Poincaré residue `ρσ`. Then `σ = g₀ ω₀` and
`ρσ = ḡ₀ ω̄₀` for a logarithmic frame `ω₀ = dt/t ∧ dx` and a unit `g₀`, and every rational
`m`-canonical form with `ord_P τ ≥ -m` is `h ω₀^{⊗m}` with `h` regular along `P`. -/
private theorem exists_logFrame {Y T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    {e : ℕ} (hd : topologicalKrullDim Y = (e + 1 : ℕ)) [IsIntegral T] {j : T ⟶ Y}
    (P : Mori.PrimeDivisor Y) (hP : j (genericPoint T) = P.genericPoint)
    {σ : RationalPluriForms sY (e + 1) 1} (hσ0 : σ ≠ 0) (hσP : P.ordForm σ = -1)
    {ρσ : RationalPluriForms (j ≫ sY) e 1} (hρσ : IsPoincareResidue sY j e 1 σ ρσ)
    (hρσ0 : ρσ ≠ 0) :
    letI := functionFieldAlgebra sY
    letI := functionFieldAlgebra (j ≫ sY)
    ∃ (t g₀ : Y.presheaf.stalk (j (genericPoint T)))
      (x : Fin e → Y.presheaf.stalk (j (genericPoint T))),
      Y.ord (algebraMap _ Y.functionField t) (j (genericPoint T)) = 1 ∧ IsUnit g₀ ∧
      σ = algebraMap _ Y.functionField g₀ • formPow (logFrame sY j t x) 1 ∧
      ρσ = (j.stalkMap (genericPoint T)).hom g₀ • formPow (resFrame sY j x) 1 ∧
      ∀ (m : ℕ) (τ : RationalPluriForms sY (e + 1) m), (τ ≠ 0 → -(m : ℤ) ≤ P.ordForm τ) →
        ∃ h : Y.presheaf.stalk (j (genericPoint T)),
          τ = algebraMap _ Y.functionField h • formPow (logFrame sY j t x) m := by
  classical
  let := functionFieldAlgebra sY
  let := functionFieldAlgebra (j ≫ sY)
  obtain ⟨t, g₀, x, ht, hσ, hρσ'⟩ := hρσ
  set ω₀ := logFrame sY j t x with hω₀
  have hg₀ : (j.stalkMap (genericPoint T)).hom g₀ ≠ 0 := by
    intro h0
    apply hρσ0
    rw [hρσ', h0, zero_smul]
    rfl
  have hd' := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) hd
  obtain ⟨b⟩ := exists_basis_topForms (sX := sY) hd
  obtain ⟨N, hN⟩ := P.exists_ordForm_eq_ord_add_mul hd' b
  set c := b.repr ω₀ () with hc
  have hω₀b : ω₀ = c • b () := (basis_unit_repr_smul b ω₀).symm
  have hpow : ∀ a : ℕ, (formPow ω₀ a : RationalPluriForms sY (e + 1) a) = c ^ a • formPow (b ()) a :=
    fun a => by rw [hω₀b, formPow_smul]
  have hσω : σ = algebraMap _ Y.functionField g₀ • formPow ω₀ 1 := hσ
  have hσ' : σ = (algebraMap _ Y.functionField g₀ * c) • formPow (b ()) 1 := by
    rw [hσω, mul_smul, ← pow_one c, ← hpow]
  have hc0 : c ≠ 0 := by
    intro h0; apply hσ0
    rw [hσ', h0, mul_zero, zero_smul]
    rfl
  have hcoh : Order.coheight (j (genericPoint T)) = 1 := by
    rw [hP]; exact P.coheight_genericPoint
  have hg₀u : IsUnit g₀ := isUnit_of_stalkMap_ne_zero j hg₀
  have hg₀ord : Y.ord (algebraMap _ Y.functionField g₀) P.genericPoint = 0 := by
    have hne : algebraMap (Y.presheaf.stalk (j (genericPoint T))) Y.functionField g₀ ≠ 0 :=
      (hg₀u.map _).ne_zero
    rw [← hP, Scheme.ord_eq_iff hcoh hne, ofAdd_zero]
    have : Ring.KrullDimLE 1 (Y.presheaf.stalk (j (genericPoint T))) :=
      krullDimLE_of_coheight_le hcoh.le
    exact Ring.ordFrac_of_isUnit hg₀u
  have hσN := hN 1 σ hσ0
  have hr1 : (ZTensorPower.basis b 1).repr
      ((algebraMap _ Y.functionField g₀ * c) • formPow (b ()) 1 : RationalPluriForms sY (e + 1) 1)
      () = algebraMap _ Y.functionField g₀ * c := repr_smul_formPow b 1 _
  rw [hσ', hr1, ← hσ', hσP, Scheme.ord_mul ((hg₀u.map _).ne_zero) hc0, hg₀ord] at hσN
  refine ⟨t, g₀, x, ht, hg₀u, hσω, hρσ', fun m τ hτ => ?_⟩
  by_cases hτ0 : τ = 0
  · exact ⟨0, by rw [hτ0, map_zero, zero_smul]; rfl⟩
  set fτ := (ZTensorPower.basis b m).repr τ () / c ^ m with hfτ
  have hτf : τ = fτ • formPow ω₀ m := by
    rw [hpow, smul_smul, hfτ, div_mul_cancel₀ _ (pow_ne_zero _ hc0)]
    exact eq_repr_smul_formPow b τ
  have hrepr0 : (ZTensorPower.basis b m).repr τ () ≠ 0 := repr_ne_zero_of_ne_zero b hτ0
  have hf0 : fτ ≠ 0 := div_ne_zero hrepr0 (pow_ne_zero _ hc0)
  have hford : 0 ≤ Y.ord fτ (j (genericPoint T)) := by
    have h1 := hτ hτ0
    rw [hN m τ hτ0] at h1
    rw [hP, hfτ, div_eq_mul_inv, Scheme.ord_mul hrepr0 (inv_ne_zero (pow_ne_zero _ hc0)),
      ← zpow_natCast, ← zpow_neg, ord_zpow _ hc0]
    push_cast
    nlinarith
  obtain ⟨h, hh⟩ := (Scheme.mem_range_algebraMap_stalk_iff_zero_le_ord hcoh hf0).mpr hford
  exact ⟨h, by rw [hτf, ← hh]⟩

/-- A nonzero multiple of a power of a nonzero top form is nonzero. -/
private theorem smul_formPow_ne_zero {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {d : ℕ}
    (hd : topologicalKrullDim X = d)
    {ω : letI := functionFieldAlgebra sX; ⋀[X.functionField]^d Ω[X.functionField⁄ℂ]}
    (hω : ω ≠ 0) {f : X.functionField} (hf : f ≠ 0) (a : ℕ) :
    letI := functionFieldAlgebra sX
    (show RationalPluriForms sX d a from f • formPow ω a) ≠ 0 := by
  let := functionFieldAlgebra sX
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hd
  set c := b.repr ω () with hc
  have hωb : ω = c • b () := (basis_unit_repr_smul b ω).symm
  have hc0 : c ≠ 0 := fun h0 => hω (by rw [hωb, h0, zero_smul])
  have e1 : (f • formPow ω a : RationalPluriForms sX d a) = (f * c ^ a) • formPow (b ()) a := by
    rw [hωb, formPow_smul, smul_smul]
  change (f • formPow ω a : RationalPluriForms sX d a) ≠ 0
  rw [e1, ← ZTensorPower.basis_natCast]
  exact smul_ne_zero (mul_ne_zero hf (pow_ne_zero _ hc0)) ((ZTensorPower.basis b _).ne_zero ())

/-- A rational `m`-canonical form lies in `H⁰(X, m(K_X + B))` if and only if
`ord_Γ(τ) + ⌊m b_Γ⌋ ≥ 0` along every prime divisor `Γ`, when `τ ≠ 0`. -/
private theorem mem_logPluricanonicalSections_iff {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {d m : ℕ} {B : QDivisor X}
    {τ : RationalPluriForms sX d m} :
    τ ∈ logPluricanonicalSections sX d m B ↔
      ∀ Γ : Mori.PrimeDivisor X, τ ≠ 0 → 0 ≤ Γ.ordForm τ + ⌊(m : ℚ) * B.coeff Γ⌋ := by
  have hU : (⊤ : X.Opens) ≠ ⊥ := fun h => by
    have := congrArg (fun U : X.Opens => genericPoint X ∈ U) h
    simp at this
  rw [mem_logPluricanonicalSections, mem_pluricanonicalSections_of_ne_bot hU]
  refine forall_congr' fun Γ => ?_
  have hΓ : (Γ.support ∩ (⊤ : X.Opens)).Nonempty :=
    (Γ.genericPoint_mem_iff ⊤).mp trivial
  rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
    Int.cast_natCast]
  exact ⟨fun h => h hΓ, fun h _ => h⟩

/-- The order of `f ω^{⊗a}` along a prime divisor is `ord f + a ord ω`. -/
private theorem ordForm_smul_formPow {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {d : ℕ}
    (hd : topologicalKrullDim X = d) (Γ : Mori.PrimeDivisor X)
    {ω : letI := functionFieldAlgebra sX; ⋀[X.functionField]^d Ω[X.functionField⁄ℂ]}
    (hω : ω ≠ 0) {f : X.functionField} (hf : f ≠ 0) (a : ℕ) :
    letI := functionFieldAlgebra sX
    Γ.ordForm (show RationalPluriForms sX d a from f • formPow ω a) =
      X.ord f Γ.genericPoint + a * Γ.ordForm (show RationalPluriForms sX d 1 from formPow ω 1) := by
  let := functionFieldAlgebra sX
  have hd' := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hd
  obtain ⟨b⟩ := exists_basis_topForms (sX := sX) hd
  obtain ⟨N, hN⟩ := Γ.exists_ordForm_eq_ord_add_mul hd' b
  set c := b.repr ω () with hc
  have hωb : ω = c • b () := (basis_unit_repr_smul b ω).symm
  have hc0 : c ≠ 0 := fun h0 => hω (by rw [hωb, h0, zero_smul])
  have hpow : ∀ k : ℕ, (formPow ω k : RationalPluriForms sX d k) = c ^ k • formPow (b ()) k :=
    fun k => by rw [hωb, formPow_smul]
  have e1 : (f • formPow ω a : RationalPluriForms sX d a) = (f * c ^ a) • formPow (b ()) a := by
    rw [hpow, smul_smul]
  have e2 : (formPow ω 1 : RationalPluriForms sX d 1) = c • formPow (b ()) 1 := by
    rw [hpow, pow_one]
  have h1 : (f * c ^ a) • formPow (b ()) a ≠ (0 : RationalPluriForms sX d a) := by
    rw [← ZTensorPower.basis_natCast]
    exact smul_ne_zero (mul_ne_zero hf (pow_ne_zero _ hc0)) ((ZTensorPower.basis b _).ne_zero ())
  have h2 : c • formPow (b ()) 1 ≠ (0 : RationalPluriForms sX d 1) := by
    rw [← ZTensorPower.basis_natCast]
    exact smul_ne_zero hc0 ((ZTensorPower.basis b _).ne_zero ())
  have r1 : (ZTensorPower.basis b a).repr ((f * c ^ a) • formPow (b ()) a :
      RationalPluriForms sX d a) () = f * c ^ a := repr_smul_formPow b a _
  have r2 : (ZTensorPower.basis b 1).repr (c • formPow (b ()) 1 :
      RationalPluriForms sX d 1) () = c := repr_smul_formPow b 1 _
  rw [e1, e2, hN _ _ h1, hN _ _ h2, r1, r2, Scheme.ord_mul hf (pow_ne_zero _ hc0),
    ← zpow_natCast, ord_zpow _ hc0]
  push_cast
  ring

/-- **Residues of log sections are log sections.** Let `j : T ⟶ S` be an adjunction step onto
the prime divisor `P` with a top form `σ` with a simple pole along `P` and a nonzero residue `ρσ`,
`m(div σ + B_S)` a Cartier divisor `D` with pull-back `m(div ρσ + B_T)`. Then the residue of every
section of `𝒪_S(m(K_S + B_S))` exists and is a section of `𝒪_T(m(K_T + B_T))`. -/
private theorem exists_isPoincareResidue_mem_logPluricanonicalSections {S T : Scheme.{0}}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] [CompactSpace S]
    {sS : S ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sS] {e : ℕ}
    (hd : topologicalKrullDim S = (e + 1 : ℕ)) [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    [CompactSpace T] {j : T ⟶ S} [LocallyOfFiniteType (j ≫ sS)] {BS : QDivisor S}
    {BT : QDivisor T} (hj : IsAdjunctionStep sS BS j BT) (hdT : topologicalKrullDim T = e)
    (P : Mori.PrimeDivisor S) (hrange : Set.range j.base = (P.support : Set S))
    {σ : RationalPluriForms sS (e + 1) 1} (hσ0 : σ ≠ 0) (hσP : P.ordForm σ = -1)
    {ρσ : RationalPluriForms (j ≫ sS) e 1} (hρσ : IsPoincareResidue sS j e 1 σ ρσ)
    (hρσ0 : ρσ ≠ 0) {m : ℕ} (hm : 0 < m) {D : Divisor S}
    (hD : Divisor.toQDivisor D = (m : ℤ) • (Divisor.toQDivisor (divisorOfForm σ) + BS))
    (hDc : D.IsCartier)
    {hB : ∀ Z : irreducibleComponents T, j (componentGenericPoint T Z) ∉ D.supp}
    {D' : Divisor T} (hpbD : D.IsPullback j hB D')
    (hD' : Divisor.toQDivisor D' = (m : ℤ) • (Divisor.toQDivisor (divisorOfForm ρσ) + BT))
    (ρ : RationalPluriForms sS (e + 1) m) (hρ : ρ ∈ logPluricanonicalSections sS (e + 1) m BS) :
    ∃ ρ' : RationalPluriForms (j ≫ sS) e m, IsPoincareResidue sS j e m ρ ρ' ∧
      ρ' ∈ logPluricanonicalSections (j ≫ sS) e m BT := by
  classical
  let := functionFieldAlgebra sS
  let := functionFieldAlgebra (j ≫ sS)
  obtain ⟨-, -, -, -, hci, -⟩ := id hj
  haveI := hci
  have hP := map_genericPoint_eq_of_range_eq j P hrange
  obtain ⟨t, g₀, x, ht, hg₀u, hσω, hρσω, hfr⟩ := exists_logFrame hd P hP hσ0 hσP hρσ hρσ0
  have hBP := hj.coeff_eq_one hrange
  have hlog := hρ
  rw [mem_logPluricanonicalSections] at hlog
  have hρP : ρ ≠ 0 → -(m : ℤ) ≤ P.ordForm ρ := fun hρ0 => by
    have := hlog.2 P ⟨P.genericPoint, genericPoint_mem_support P, trivial⟩ hρ0
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, hBP] at this
    simp at this
    linarith
  obtain ⟨h, hρh⟩ := hfr m ρ hρP
  refine ⟨_, hρh ▸ isPoincareResidue_smul_formPow_logFrame sS j ht x h, ?_⟩
  by_cases hh : (j.stalkMap (genericPoint T)).hom h = 0
  · rw [hh, zero_smul]; exact zero_mem _
  have hu : IsUnit h := isUnit_of_stalkMap_ne_zero j hh
  set a : S.presheaf.stalk (j (genericPoint T)) := h * ((hg₀u.unit⁻¹ : _ˣ) : _) ^ m with ha_def
  have ha : IsUnit a := hu.mul ((Units.isUnit _).pow _)
  have hga : algebraMap _ S.functionField a ≠ 0 := (ha.map _).ne_zero
  have hga' : (j.stalkMap (genericPoint T)).hom a ≠ 0 := (ha.map _).ne_zero
  have hcoh : Order.coheight (j (genericPoint T)) = 1 := by
    rw [hP]; exact P.coheight_genericPoint
  -- orders of units of the stalk along `P` vanish
  have hunitP : ∀ {c : S.presheaf.stalk (j (genericPoint T))}, IsUnit c →
      S.ord (algebraMap _ S.functionField c) P.genericPoint = 0 := fun {c} hc => by
    rw [← hP, Scheme.ord_eq_iff hcoh (hc.map _).ne_zero, ofAdd_zero]
    have : Ring.KrullDimLE 1 (S.presheaf.stalk (j (genericPoint T))) :=
      krullDimLE_of_coheight_le hcoh.le
    exact Ring.ordFrac_of_isUnit hc
  -- the frames are nonzero
  have hω₀ : logFrame sS j t x ≠ 0 := by
    intro h0; apply hσ0
    rw [hσω, h0]
    unfold formPow
    rw [MultilinearMap.map_coord_zero _ (0 : Fin 1) rfl]
    exact smul_zero (A := TensorPower S.functionField 1
      (⋀[S.functionField]^(e + 1) Ω[S.functionField⁄ℂ])) _
  have hωT : resFrame sS j x ≠ 0 := by
    intro h0; apply hρσ0
    rw [hρσω, h0]
    unfold formPow
    rw [MultilinearMap.map_coord_zero _ (0 : Fin 1) rfl]
    exact smul_zero (A := TensorPower T.functionField 1
      (⋀[T.functionField]^e Ω[T.functionField⁄ℂ])) _
  have hgS : algebraMap _ S.functionField g₀ ≠ 0 := (hg₀u.map _).ne_zero
  have hgT : (j.stalkMap (genericPoint T)).hom g₀ ≠ 0 := (hg₀u.map _).ne_zero
  have hhS : algebraMap _ S.functionField h ≠ 0 := (hu.map _).ne_zero
  have hσF : ∀ Γ : Mori.PrimeDivisor S, Γ.ordForm σ =
      S.ord (algebraMap _ S.functionField g₀) Γ.genericPoint +
        Γ.ordForm (show RationalPluriForms sS (e + 1) 1 from formPow (logFrame sS j t x) 1) :=
    fun Γ => by
      rw [hσω, ordForm_smul_formPow hd Γ hω₀ hgS 1]; push_cast; ring
  have hρF : ∀ Γ : Mori.PrimeDivisor S, Γ.ordForm ρ =
      S.ord (algebraMap _ S.functionField h) Γ.genericPoint +
        m * Γ.ordForm (show RationalPluriForms sS (e + 1) 1 from formPow (logFrame sS j t x) 1) :=
    fun Γ => by rw [hρh, ordForm_smul_formPow hd Γ hω₀ hhS m]
  have hordA : ∀ Γ : Mori.PrimeDivisor S, S.ord (algebraMap _ S.functionField a) Γ.genericPoint =
      S.ord (algebraMap _ S.functionField h) Γ.genericPoint -
        m * S.ord (algebraMap _ S.functionField g₀) Γ.genericPoint := fun Γ => by
    have hinv : algebraMap (S.presheaf.stalk (j (genericPoint T))) S.functionField
        (((hg₀u.unit⁻¹ : (S.presheaf.stalk (j (genericPoint T)))ˣ)) :
          S.presheaf.stalk (j (genericPoint T))) =
        (algebraMap _ S.functionField g₀)⁻¹ := by
      rw [map_units_inv (algebraMap _ S.functionField) hg₀u.unit, IsUnit.unit_spec]
    have e1 : algebraMap _ S.functionField a =
        algebraMap _ S.functionField h * ((algebraMap _ S.functionField g₀)⁻¹) ^ m := by
      rw [ha_def, map_mul, map_pow, hinv]
    rw [e1, Scheme.ord_mul hhS (pow_ne_zero _ (inv_ne_zero hgS)),
      ← zpow_natCast, ord_zpow _ (inv_ne_zero hgS), ← zpow_neg_one, ord_zpow _ hgS]
    ring
  have hρ0 : ρ ≠ 0 := by rw [hρh]; exact smul_formPow_ne_zero hd hω₀ hhS m
  have hlog' := (mem_logPluricanonicalSections_iff (sX := sS)).mp hρ
  -- the effective Cartier divisor `G = D + div(a)` with `G = div ρ + m B_S`
  set G : Divisor S := D + Mori.principalDivisor (unitOfFunction hga) with hG_def
  have hGc : ∀ Γ : Mori.PrimeDivisor S,
      (G.coeff Γ : ℚ) = Γ.ordForm ρ + m * BS.coeff Γ := fun Γ => by
    have h1 := congrArg (fun B : QDivisor S => B.coeff Γ) hD
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, zsmul_eq_mul, Int.cast_natCast] at h1
    rw [hG_def, DivisorWithCoeffs.coeff_add, Mori.coeff_principalDivisor,
      ord_toRationalFunctions Γ hga _ (coe_unitOfFunction hga), hordA, hρF, Int.cast_add, h1,
      hσF Γ]
    push_cast; ring
  have hG0 : ∀ Γ : Mori.PrimeDivisor S, 0 ≤ G.coeff Γ := fun Γ => by
    have h2 := hlog' Γ hρ0
    have e : (m : ℚ) * BS.coeff Γ = ((G.coeff Γ - Γ.ordForm ρ : ℤ) : ℚ) := by
      push_cast; rw [hGc Γ]; ring
    rw [e, Int.floor_intCast] at h2
    linarith
  have hGP : G.coeff P = 0 := by
    have h3 := hσF P
    rw [hσP, hunitP hg₀u] at h3
    have h4 : P.ordForm (show RationalPluriForms sS (e + 1) 1 from
        formPow (logFrame sS j t x) 1) = -1 := by linarith
    have h5 := hGc P
    rw [hρF P, hunitP hu, hBP, h4] at h5
    have : (G.coeff P : ℚ) = 0 := by rw [h5]; push_cast; ring
    exact_mod_cast this
  have haP : (Mori.principalDivisor (unitOfFunction hga)).coeff P = 0 := by
    rw [Mori.coeff_principalDivisor, ord_toRationalFunctions P hga _ (coe_unitOfFunction hga),
      hunitP ha]
  have hBG : ∀ Z : irreducibleComponents T, j (componentGenericPoint T Z) ∉ G.supp := fun Z => by
    rw [componentGenericPoint_eq_genericPoint, hP]; exact genericPoint_notMem_supp_of_coeff_eq_zero hGP
  have hBa : ∀ Z : irreducibleComponents T,
      j (componentGenericPoint T Z) ∉ (Mori.principalDivisor (unitOfFunction hga)).supp :=
    fun Z => by
      rw [componentGenericPoint_eq_genericPoint, DivisorWithCoeffs.mem_supp_iff]
      rintro ⟨E, hE, hxE⟩
      rw [hP] at hxE
      obtain rfl := MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support hxE
      exact hE haP
  have hGcart : G.IsCartier := hDc.add (Divisor.isCartier_principalDivisor _)
  have hpbG : G.IsPullback j hBG (D' + Mori.principalDivisor (unitOfFunction (Y := T) hga')) :=
    Divisor.IsPullback.add hDc (Divisor.isCartier_principalDivisor _) hBG hpbD
      (isPullback_principalDivisor_unitOfFunction j ha hga hga' hBa)
  have hG'0 : ∀ Q : Mori.PrimeDivisor T,
      0 ≤ (D' + Mori.principalDivisor (unitOfFunction (Y := T) hga')).coeff Q := fun Q =>
    (coeff_isPullback_of_forall j hGcart hpbG Q.genericPoint).1 (fun Γ _ => hG0 Γ) Q
      (genericPoint_mem_support Q)
  -- the same computation on `T`
  have hρσF : ∀ Q : Mori.PrimeDivisor T, Q.ordForm ρσ =
      T.ord ((j.stalkMap (genericPoint T)).hom g₀) Q.genericPoint +
        Q.ordForm (show RationalPluriForms (j ≫ sS) e 1 from formPow (resFrame sS j x) 1) :=
    fun Q => by rw [hρσω, ordForm_smul_formPow hdT Q hωT hgT 1]; push_cast; ring
  have hρ'F : ∀ Q : Mori.PrimeDivisor T,
      Q.ordForm (show RationalPluriForms (j ≫ sS) e m from
        (j.stalkMap (genericPoint T)).hom h • formPow (resFrame sS j x) m) =
      T.ord ((j.stalkMap (genericPoint T)).hom h) Q.genericPoint +
        m * Q.ordForm (show RationalPluriForms (j ≫ sS) e 1 from formPow (resFrame sS j x) 1) :=
    fun Q => ordForm_smul_formPow hdT Q hωT hh m
  have hordA' : ∀ Q : Mori.PrimeDivisor T,
      T.ord ((j.stalkMap (genericPoint T)).hom a) Q.genericPoint =
      T.ord ((j.stalkMap (genericPoint T)).hom h) Q.genericPoint -
        m * T.ord ((j.stalkMap (genericPoint T)).hom g₀) Q.genericPoint := fun Q => by
    have hinv : ((j.stalkMap (genericPoint T)).hom
        (((hg₀u.unit⁻¹ : (S.presheaf.stalk (j (genericPoint T)))ˣ)) :
          S.presheaf.stalk (j (genericPoint T))) : T.functionField) =
        ((j.stalkMap (genericPoint T)).hom g₀ : T.functionField)⁻¹ := by
      rw [map_units_inv (j.stalkMap (genericPoint T)).hom hg₀u.unit, IsUnit.unit_spec]
    have e1 : ((j.stalkMap (genericPoint T)).hom a : T.functionField) =
        ((j.stalkMap (genericPoint T)).hom h : T.functionField) *
          (((j.stalkMap (genericPoint T)).hom g₀ : T.functionField)⁻¹) ^ m := by
      rw [ha_def, map_mul, map_pow, hinv]
    rw [e1, Scheme.ord_mul hh (pow_ne_zero _ (inv_ne_zero hgT)),
      ← zpow_natCast, ord_zpow _ (inv_ne_zero hgT), ← zpow_neg_one, ord_zpow _ hgT]
    ring
  refine (mem_logPluricanonicalSections_iff (sX := j ≫ sS) (τ := (show
    RationalPluriForms (j ≫ sS) e m from
      (j.stalkMap (genericPoint T)).hom h • formPow (resFrame sS j x) m))).mpr ?_
  intro Q _
  have hG'c : ((D' + Mori.principalDivisor (unitOfFunction (Y := T) hga')).coeff Q : ℚ) =
      Q.ordForm (show RationalPluriForms (j ≫ sS) e m from
        (j.stalkMap (genericPoint T)).hom h • formPow (resFrame sS j x) m) +
        m * BT.coeff Q := by
    have h1 := congrArg (fun B : QDivisor T => B.coeff Q) hD'
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, zsmul_eq_mul, Int.cast_natCast] at h1
    rw [DivisorWithCoeffs.coeff_add, Mori.coeff_principalDivisor,
      ord_toRationalFunctions Q hga' _ (coe_unitOfFunction hga'), hordA', hρ'F, Int.cast_add, h1,
      hρσF Q]
    push_cast; ring
  have e : (m : ℚ) * BT.coeff Q = (((D' + Mori.principalDivisor
      (unitOfFunction (Y := T) hga')).coeff Q - Q.ordForm (show RationalPluriForms (j ≫ sS) e m from
        (j.stalkMap (genericPoint T)).hom h • formPow (resFrame sS j x) m) : ℤ) : ℚ) := by
    push_cast; rw [hG'c]; ring
  rw [e, Int.floor_intCast]
  have := hG'0 Q
  omega

/-- **Residues at a point of a normal curve exist.** Along an adjunction step `j : Q ⟶ C` onto a
point of a normal curve, every rational `m`-canonical form with a pole of order at most `m`
there has a Poincaré residue. -/
private theorem exists_isPoincareResidue_of_curve {C Q : Scheme.{0}} [IsIntegral C]
    [IsLocallyNoetherian C] [IsNormal C] {s : C ⟶ Spec (.of ℂ)}
    (hC : IsNormalVariety ℂ s) (hdim : topologicalKrullDim C = 1) {BC : QDivisor C}
    {j : Q ⟶ C} {BQ : QDivisor Q} (hj : IsAdjunctionStep s BC j BQ) [IsIntegral Q] {m : ℕ}
    (ρ : RationalPluriForms s 1 m)
    (hρ : ∀ P : Mori.PrimeDivisor C, j (genericPoint Q) = P.genericPoint → ρ ≠ 0 →
      -(m : ℤ) ≤ P.ordForm ρ) :
    ∃ ρ' : RationalPluriForms (j ≫ s) 0 m, IsPoincareResidue s j 0 m ρ ρ' := by
  classical
  haveI : LocallyOfFiniteType s := hC.1.toLocallyOfFiniteType
  obtain ⟨P, hP, hci⟩ := hj.exists_primeDivisor
  let O := C.presheaf.stalk (j (genericPoint Q))
  let := stalkAlgebra s (j (genericPoint Q))
  let := functionFieldAlgebra s
  let := functionFieldAlgebra (j ≫ s)
  let : Algebra O Q.functionField := (j.stalkMap (genericPoint Q)).hom.toAlgebra
  have := isScalarTower_stalk_functionField s (j (genericPoint Q))
  obtain ⟨hdvr, hfree, hfin, -, hcoh, hrank⟩ := hj.stalk_facts
  obtain ⟨-, hsurj⟩ := hj.stalkMap_facts
  obtain ⟨ϖ, r, -, hr, hker, -, -⟩ := hj.exists_uniformizer
  have htr : (Algebra.trdeg ℂ C.functionField).toNat = 1 :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq (by exact_mod_cast hdim)
  -- `ϖ` is a uniformizer
  have hmax : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} :=
    (IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ hsurj)).symm.trans hker
  have hϖirr : Irreducible ϖ := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mpr hmax
  have hϖ0 : algebraMap O C.functionField ϖ ≠ 0 := by
    rw [Ne, IsFractionRing.to_map_eq_zero_iff]; exact hϖirr.ne_zero
  have hord : C.ord (algebraMap O C.functionField ϖ) (j (genericPoint Q)) = 1 :=
    (Scheme.ord_eq_iff hcoh hϖ0).mpr (Ring.ordFrac_irreducible hϖirr)
  -- `dϖ` generates `Ω_{𝒪/ℂ}`
  have hspan : Submodule.span O (Set.range ![KaehlerDifferential.D ℂ O ϖ]) = ⊤ := by
    haveI := hfree
    haveI := hfin
    have hrk : Module.finrank O Ω[O⁄ℂ] = 1 := hrank.trans htr
    let b₀ := Module.finBasisOfFinrankEq O Ω[O⁄ℂ] hrk
    set c := b₀.repr (KaehlerDifferential.D ℂ O ϖ) 0 with hc_def
    have hD : KaehlerDifferential.D ℂ O ϖ = c • b₀ 0 := by
      conv_lhs => rw [← b₀.sum_repr (KaehlerDifferential.D ℂ O ϖ)]
      simp [Fin.sum_univ_one, hc_def]
    have hc : IsUnit c := IsUnit.of_mul_eq_one (r (b₀ 0)) (by
      rw [← smul_eq_mul, ← map_smul, ← hD, hr])
    refine eq_top_iff.mpr ?_
    rw [← b₀.span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    obtain rfl : i = 0 := Subsingleton.elim _ _
    have : b₀ 0 = ((hc.unit⁻¹ : Oˣ) : O) • KaehlerDifferential.D ℂ O ϖ := by
      conv_rhs => rw [hD]
      rw [smul_smul, hc.val_inv_mul, one_smul]
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩)
  -- the frame `dϖ` of `Ω_{k(C)/ℂ}`
  have := essFiniteType_functionField (sX := s)
  have hK1 : Module.finrank C.functionField Ω[C.functionField⁄ℂ] = 1 :=
    (finrank_kaehlerDifferential_eq_trdeg ℂ C.functionField).trans htr
  have : FiniteDimensional C.functionField Ω[C.functionField⁄ℂ] :=
    (trdeg_eq_finrank_kaehlerDifferential_sub_finrank_h1Cotangent ℂ C.functionField).1
  haveI := nontrivial_exteriorPower_of_finrank_eq ℂ C.functionField hK1
  have hσ := MMP.Fourfold.span_singleton_ιMulti_eq_top _ hspan
  have h0 := topFormsMap_ne_zero_of_span_eq_top (k := ℂ) (K := C.functionField) hσ
  set F0 := topFormsMap ℂ O C.functionField 1 (exteriorPower.ιMulti O 1
    ![KaehlerDifferential.D ℂ O ϖ]) with hF0_def
  have hfr1 : Module.finrank C.functionField (⋀[C.functionField]^1 Ω[C.functionField⁄ℂ]) = 1 := by
    rw [exteriorPower.finrank_eq, hK1, Nat.choose_self]
  have hspanK : Submodule.span C.functionField {F0} = ⊤ :=
    (finrank_eq_one_iff_of_nonzero F0 h0).mp hfr1
  let bK := basisOfSpanSingleton hspanK h0
  set c := (ZTensorPower.basis bK (m : ℤ)).repr ρ () with hc_def
  have hρeq : ρ = c • (PiTensorProduct.tprod C.functionField (fun _ : Fin m => F0) :
      TensorPower C.functionField m (⋀[C.functionField]^1 Ω[C.functionField⁄ℂ])) := by
    have h1 := basis_unit_repr_smul (ZTensorPower.basis bK (m : ℤ)) ρ
    have h2 := ZTensorPower.basis_ofNat bK m
    rw [basisOfSpanSingleton_apply] at h2
    rw [← hc_def] at h1
    rw [← h2]
    exact h1.symm
  by_cases hρ0 : ρ = 0
  · refine ⟨0, ϖ, 0, Fin.elim0, hord, ?_, ?_⟩
    · rw [hρ0, map_zero]
      exact (zero_smul _ _).symm
    · rw [map_zero]
      exact (zero_smul _ _).symm
  have hc0 : c ≠ 0 := fun h => hρ0 (by rw [hρeq, h]; exact zero_smul _ _)
  have hordc : C.ord c P.genericPoint ≥ -(m : ℤ) := by
    have := MMP.CyclicChartDifferent.ordForm_eq_of_frame (sX := s) P hP ![KaehlerDifferential.D ℂ O ϖ]
      hspan h0 c ρ hρeq
    rw [← this]
    exact hρ P hP hρ0
  -- the coefficient along the frame `(dϖ/ϖ)^m` is regular
  have hgK : c * algebraMap O C.functionField ϖ ^ m ≠ 0 := mul_ne_zero hc0 (pow_ne_zero _ hϖ0)
  obtain ⟨g, hg⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg
    (j (genericPoint Q)) hgK fun Γ hΓ => by
      have hΓP : Γ.genericPoint = P.genericPoint := by
        have hsp : Γ.genericPoint ⤳ j (genericPoint Q) := by
          rw [specializes_iff_mem_closure, ← PrimeDivisor.support_eq_closure]; exact hΓ
        rw [hP] at hsp
        exact MMP.ProgramBaseChange.eq_of_specializes_of_coheight_eq_one hsp
          Γ.coheight_genericPoint P.coheight_genericPoint
      rw [hΓP, Scheme.ord_mul hc0 (pow_ne_zero _ hϖ0), Scheme.ord_pow hϖ0, ← hP, hord]
      rw [hP]
      omega
  refine ⟨_, ϖ, g, Fin.elim0, hord, ?_, rfl⟩
  have hF0' : exteriorPower.ιMulti C.functionField (0 + 1)
      (Fin.cons (KaehlerDifferential.D ℂ C.functionField (algebraMap O C.functionField ϖ))
        fun i : Fin 0 => KaehlerDifferential.D ℂ C.functionField
          (algebraMap O C.functionField (Fin.elim0 i))) = F0 := by
    rw [hF0_def, topFormsMap_ιMulti]
    congr 1
    funext i
    fin_cases i
    simp [KaehlerDifferential.map_D]
  rw [hρeq, hg, hF0', tprod_const_smul, smul_smul]
  congr 1
  have h1 : algebraMap O C.functionField ϖ * (algebraMap O C.functionField ϖ)⁻¹ = 1 :=
    mul_inv_cancel₀ hϖ0
  rw [mul_assoc, ← mul_pow]
  erw [h1]
  rw [one_pow, mul_one]

section ResidueAdd

open exteriorPower

variable {k : Type*} [Field k] {O : Type*} [CommRing O] [IsDomain O] [Algebra k O]
  {K : Type*} [Field K] [Algebra k K] [Algebra O K] [IsScalarTower k O K] [IsFractionRing O K]
  {L : Type*} [Field L] [Algebra k L] [Algebra O L] [IsScalarTower k O L]

/-- **Sums of logarithmic pluriforms and of their residues.** On a line `Ω^{e+1}_{K/k}`, the sum
of two logarithmic pluriforms is a logarithmic pluriform along one of the two frames, and its
residue is the sum of the residues. -/
private theorem exists_logPluriForm_add [Module.Free O Ω[O⁄k]] [ValuationRing O] {e : ℕ}
    (hline : Module.finrank K (⋀[K]^(e + 1) Ω[K⁄k]) = 1)
    (hπ : Function.Surjective (algebraMap O L)) {t₀ : O} (ht₀ : algebraMap O L t₀ = 0)
    {r : Ω[O⁄k] →ₗ[O] O} (hr : r (KaehlerDifferential.D k O t₀) = 1) (m : ℕ) (g₁ g₂ : O)
    {u₁ u₂ : O} (hu₁ : IsUnit u₁) (hu₂ : IsUnit u₂) (x₁ x₂ : Fin e → O) :
    ∃ (g u : O) (x : Fin e → O), (u = u₁ ∨ u = u₂) ∧
      logPluriForm (O := O) k K m e g₁ (u₁ * t₀) x₁ +
          logPluriForm (O := O) k K m e g₂ (u₂ * t₀) x₂ =
        logPluriForm (O := O) k K m e g (u * t₀) x ∧
      logPluriResidue (O := O) k L m e g₁ x₁ + logPluriResidue (O := O) k L m e g₂ x₂ =
        logPluriResidue (O := O) k L m e g x := by
  have hω : ∀ (g t : O) (x : Fin e → O), logPluriForm (O := O) k K m e g t x =
      algebraMap O K g • formPow ((algebraMap O K t)⁻¹ • ιMulti K (e + 1)
        (Fin.cons (KaehlerDifferential.D k K (algebraMap O K t))
          fun i => KaehlerDifferential.D k K (algebraMap O K (x i)))) m := fun _ _ _ => rfl
  have hv : ∀ (g : O) (x : Fin e → O), logPluriResidue (O := O) k L m e g x =
      algebraMap O L g • formPow (ιMulti L e
        fun i => KaehlerDifferential.D k L (algebraMap O L (x i))) m := fun _ _ => rfl
  rcases exists_frame_comparison (L := L) hline hπ ht₀ hr hu₁ hu₂ x₁ x₂ with
    ⟨c, hcK, hcL⟩ | ⟨c, hcK, hcL⟩
  · beta_reduce at hcK hcL
    refine ⟨g₁ + g₂ * c ^ m, u₁, x₁, Or.inl rfl, ?_, ?_⟩
    · rw [hω, hω, hω, hcK, formPow_smul (algebraMap O K c)]
      simp only [map_add, map_mul, map_pow, add_smul, mul_smul]
      try rfl
    · rw [hv, hv, hv, hcL, formPow_smul (algebraMap O L c)]
      simp only [map_add, map_mul, map_pow, add_smul, mul_smul]
      try rfl
  · beta_reduce at hcK hcL
    refine ⟨g₁ * c ^ m + g₂, u₂, x₂, Or.inr rfl, ?_, ?_⟩
    · rw [hω, hω, hω, hcK, formPow_smul (algebraMap O K c)]
      simp only [map_add, map_mul, map_pow, add_smul, mul_smul]
      try rfl
    · rw [hv, hv, hv, hcL, formPow_smul (algebraMap O L c)]
      simp only [map_add, map_mul, map_pow, add_smul, mul_smul]
      try rfl

end ResidueAdd

section PoincareAdd

variable {Y T : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)} [IsIntegral Y] [IsLocallyNoetherian Y]
  [IsNormal Y] [IsIntegral T] {j : T ⟶ Y}

/-- **Additivity of the Poincaré residue** along an adjunction step of a variety of dimension
`n + 1`: `Res(τ₁ + τ₂) = Res(τ₁) + Res(τ₂)`. -/
private theorem IsPoincareResidue.add [LocallyOfFiniteType sY] {BY : QDivisor Y}
    {BT : QDivisor T} (hj : IsAdjunctionStep sY BY j BT) {n m : ℕ}
    (hY : topologicalKrullDim Y = n + 1)
    {τ₁ τ₂ : RationalPluriForms sY (n + 1) m} {ρ₁ ρ₂ : RationalPluriForms (j ≫ sY) n m}
    (h₁ : IsPoincareResidue sY j n m τ₁ ρ₁) (h₂ : IsPoincareResidue sY j n m τ₂ ρ₂) :
    IsPoincareResidue sY j n m (τ₁ + τ₂) (ρ₁ + ρ₂) := by
  obtain ⟨P, hP, hci⟩ := hj.exists_primeDivisor
  let := stalkAlgebra sY (j (genericPoint T))
  let := functionFieldAlgebra sY
  let := functionFieldAlgebra (j ≫ sY)
  let : Algebra (Y.presheaf.stalk (j (genericPoint T))) T.functionField :=
    (j.stalkMap (genericPoint T)).hom.toAlgebra
  have := isScalarTower_stalk_functionField sY (j (genericPoint T))
  obtain ⟨hdvr, hfree, -, -, -, -⟩ := stalk_facts_of_eq_genericPoint (sY := sY) P hP
  obtain ⟨htow, hsurj⟩ := stalkMap_facts_of_isClosedImmersion (sY := sY) (j := j)
  obtain ⟨ϖ, r, hϖ0, hr, -, -, hunif⟩ := exists_uniformizer_of_eq_genericPoint (sY := sY) P hP
  obtain ⟨b₀⟩ := MMP.Fourfold.exists_basis_topForms (sX := sY) (by exact_mod_cast hY)
  have hline : Module.finrank Y.functionField (⋀[Y.functionField]^(n + 1) Ω[Y.functionField⁄ℂ]) =
      1 := by rw [Module.finrank_eq_card_basis b₀, Fintype.card_unit]
  obtain ⟨t₁, g₁, x₁, ht₁, hτ₁, rfl⟩ := h₁
  obtain ⟨t₂, g₂, x₂, ht₂, hτ₂, rfl⟩ := h₂
  obtain ⟨u₁, hu₁, rfl⟩ := hunif t₁ ht₁
  obtain ⟨u₂, hu₂, rfl⟩ := hunif t₂ ht₂
  obtain ⟨g, u, x, hu, hK, hL⟩ := exists_logPluriForm_add (L := T.functionField) hline hsurj hϖ0
    hr m g₁ g₂ hu₁ hu₂ x₁ x₂
  refine ⟨u * ϖ, g, x, ?_, hτ₁ ▸ hτ₂ ▸ hK, hL.symm ▸ rfl⟩
  rcases hu with rfl | rfl
  · exact ht₁
  · exact ht₂

/-- **`ℂ`-linearity of the Poincaré residue**: `Res(c τ) = c Res(τ)`. -/
private theorem IsPoincareResidue.smul {BY : QDivisor Y} {BT : QDivisor T}
    (hj : IsAdjunctionStep sY BY j BT) {n m : ℕ} {τ : RationalPluriForms sY (n + 1) m}
    {ρ : RationalPluriForms (j ≫ sY) n m} (h : IsPoincareResidue sY j n m τ ρ) (c : ℂ) :
    IsPoincareResidue sY j n m (c • τ) (c • ρ) := by
  let := stalkAlgebra sY (j (genericPoint T))
  let := functionFieldAlgebra sY
  let := functionFieldAlgebra (j ≫ sY)
  let : Algebra (Y.presheaf.stalk (j (genericPoint T))) T.functionField :=
    (j.stalkMap (genericPoint T)).hom.toAlgebra
  have := isScalarTower_stalk_functionField sY (j (genericPoint T))
  obtain ⟨htow, -⟩ := hj.stalkMap_facts
  obtain ⟨t, g, x, ht, hτ, hρ⟩ := h
  refine ⟨t, algebraMap ℂ _ c * g, x, ht, ?_, ?_⟩
  · rw [hτ, map_mul, ← IsScalarTower.algebraMap_apply, mul_smul]
    rfl
  · rw [hρ, map_mul]
    have e : (j.stalkMap (genericPoint T)).hom (algebraMap ℂ _ c) =
        algebraMap ℂ T.functionField c :=
      (IsScalarTower.algebraMap_apply ℂ (Y.presheaf.stalk (j (genericPoint T)))
        T.functionField c).symm
    rw [e, mul_smul]
    rfl

end PoincareAdd

/-- Sums of rational pluriforms do not depend on the structure morphism beyond equality. -/
private theorem add_heq {X : Scheme.{0}} [IsIntegral X] {s s' : X ⟶ Spec (.of ℂ)} (h : s = s')
    {d : ℕ} {m : ℤ} {x₁ x₂ : RationalPluriForms s d m} {y₁ y₂ : RationalPluriForms s' d m}
    (h₁ : HEq x₁ y₁) (h₂ : HEq x₂ y₂) : HEq (x₁ + x₂) (y₁ + y₂) := by
  subst h
  rw [eq_of_heq h₁, eq_of_heq h₂]

/-- Scalar multiples of rational pluriforms do not depend on the structure morphism beyond
equality. -/
private theorem smul_heq {X : Scheme.{0}} [IsIntegral X] {s s' : X ⟶ Spec (.of ℂ)} (h : s = s')
    {d : ℕ} {m : ℤ} (c : ℂ) {x : RationalPluriForms s d m} {y : RationalPluriForms s' d m}
    (h₁ : HEq x y) : HEq (c • x) (c • y) := by
  subst h
  rw [eq_of_heq h₁]

/-- An adjunction step lowers the dimension by one. -/
private theorem topologicalKrullDim_eq_add_one_of_isAdjunctionStep {Y T : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sY] {BY : QDivisor Y} {j : T ⟶ Y} {BT : QDivisor T}
    (hj : IsAdjunctionStep sY BY j BT) {e : ℕ} (he : topologicalKrullDim T = e) :
    topologicalKrullDim Y = (e + 1 : ℕ) := by
  haveI : IsIntegral T := hj.1.1.toIsIntegral
  haveI : LocallyOfFiniteType (j ≫ sY) := hj.1.1.toLocallyOfFiniteType
  have h1 := hj.trdeg_add_one
  have h2 := topologicalKrullDim_eq_toNat_trdeg (j ≫ sY)
  have h3 := topologicalKrullDim_eq_toNat_trdeg sY
  rw [he] at h2
  rw [h3]
  have : e = (letI := functionFieldAlgebra (j ≫ sY)
      (Algebra.trdeg ℂ T.functionField).toNat) := by exact_mod_cast h2
  congr 1
  omega

/-- Iterated residues, in the unfolded form, are additive and `ℂ`-linear along a flag whose final
stratum has dimension `e`. -/
private theorem isIteratedResidueRec_add_smul {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)} {B : QDivisor S} {n m : ℕ}
    {T : Scheme.{0}} {ι : T ⟶ S} {BT : QDivisor T} (F : StratumAdjunctionData sS B ι BT) :
    ∀ {e : ℕ}, topologicalKrullDim T = e →
      (∀ (τ₁ τ₂ : RationalPluriForms sS n m)
        (ρ₁ ρ₂ : @RationalPluriForms ℂ _ T (ι ≫ sS) F.isIntegral_stratum e m),
        IsIteratedResidueRec τ₁ F e ρ₁ → IsIteratedResidueRec τ₂ F e ρ₂ →
          IsIteratedResidueRec (τ₁ + τ₂) F e (ρ₁ + ρ₂)) ∧
      ∀ (c : ℂ) (τ : RationalPluriForms sS n m)
        (ρ : @RationalPluriForms ℂ _ T (ι ≫ sS) F.isIntegral_stratum e m),
        IsIteratedResidueRec τ F e ρ → IsIteratedResidueRec (c • τ) F e (c • ρ) := by
  induction F with
  | refl h =>
    intro e _
    refine ⟨?_, ?_⟩
    · rintro τ₁ τ₂ ρ₁ ρ₂ ⟨rfl, h₁⟩ ⟨-, h₂⟩
      exact ⟨rfl, add_heq (Category.id_comp sS) h₁ h₂⟩
    · rintro c τ ρ ⟨rfl, h₁⟩
      exact ⟨rfl, smul_heq (Category.id_comp sS) c h₁⟩
  | @step S' T ι BS F j BT hj ih =>
    intro e he
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI : IsIntegral T := hj.1.1.toIsIntegral
    haveI : LocallyOfFiniteType (ι ≫ sS) := F.isNormalVariety.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (j ≫ ι ≫ sS) := hj.1.1.toLocallyOfFiniteType
    have hS' := topologicalKrullDim_eq_add_one_of_isAdjunctionStep hj he
    obtain ⟨ihadd, ihsmul⟩ := ih hS'
    refine ⟨?_, ?_⟩
    · rintro τ₁ τ₂ ρ₁ ρ₂ ⟨ρ₀₁, h₀₁, ρ'₁, hr₁, hh₁⟩ ⟨ρ₀₂, h₀₂, ρ'₂, hr₂, hh₂⟩
      exact ⟨ρ₀₁ + ρ₀₂, ihadd _ _ _ _ h₀₁ h₀₂, ρ'₁ + ρ'₂,
        IsPoincareResidue.add hj (by exact_mod_cast hS') hr₁ hr₂,
        add_heq (Category.assoc j ι sS) hh₁ hh₂⟩
    · rintro c τ ρ ⟨ρ₀, h₀, ρ', hr, hh⟩
      exact ⟨c • ρ₀, ihsmul c _ _ h₀, c • ρ', IsPoincareResidue.smul hj hr c,
        smul_heq (Category.assoc j ι sS) c hh⟩

/-- **Iterated residues are additive and `ℂ`-linear** along every flag of strata whose final
stratum has dimension `e`. -/
private theorem isIteratedResidue_add_smul {S : Scheme.{0}} [IsIntegral S]
    [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)} {B : QDivisor S} {n m : ℕ}
    {T : Scheme.{0}} {ι : T ⟶ S} {BT : QDivisor T} (F : StratumAdjunctionData sS B ι BT) (e : ℕ)
    (he : topologicalKrullDim T = e) :
    haveI := F.isIntegral_stratum
    (∀ (τ₁ τ₂ : RationalPluriForms sS n m) (ρ₁ ρ₂ : RationalPluriForms (ι ≫ sS) e m),
      IsIteratedResidue sS B τ₁ F e ρ₁ → IsIteratedResidue sS B τ₂ F e ρ₂ →
        IsIteratedResidue sS B (τ₁ + τ₂) F e (ρ₁ + ρ₂)) ∧
    ∀ (c : ℂ) (τ : RationalPluriForms sS n m) (ρ : RationalPluriForms (ι ≫ sS) e m),
      IsIteratedResidue sS B τ F e ρ → IsIteratedResidue sS B (c • τ) F e (c • ρ) := by
  haveI := F.isIntegral_stratum
  obtain ⟨hadd, hsmul⟩ := isIteratedResidueRec_add_smul (n := n) (m := m) F he
  exact ⟨fun τ₁ τ₂ ρ₁ ρ₂ h₁ h₂ => IsIteratedResidue.of_rec F (hadd _ _ _ _ h₁.rec' h₂.rec'),
    fun c τ ρ h => IsIteratedResidue.of_rec F (hsmul c _ _ h.rec')⟩

/-- Membership in `H⁰(X, m(K_X + B))` does not see a rewriting of the structure morphism. -/
private theorem mem_logPluricanonicalSections_of_heq {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {s s' : X ⟶ Spec (.of ℂ)} (h : s = s') {d m : ℕ}
    {B : QDivisor X} {x : RationalPluriForms s d m} {y : RationalPluriForms s' d m}
    (hxy : HEq x y) (hx : x ∈ logPluricanonicalSections s d m B) :
    y ∈ logPluricanonicalSections s' d m B := by
  subst h
  exact eq_of_heq hxy ▸ hx

/-- **Residues along one adjunction step.** Let `(T, B_T)` be obtained from the normal variety
`(S, B_S)` by one adjunction step, with `m(K_S + B_S)` Cartier. Then every section of
`𝒪_S(m(K_S + B_S))` has a Poincaré residue along `T`, and it is a section of
`𝒪_T(m(K_T + B_T))`. -/
private theorem exists_isPoincareResidue_mem_of_isAdjunctionStep {S T : Scheme.{0}}
    [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S] {sS : S ⟶ Spec (.of ℂ)}
    (hS : IsNormalVariety ℂ sS) {BS : QDivisor S} {BT : QDivisor T} {j : T ⟶ S}
    [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] (hj : IsAdjunctionStep sS BS j BT)
    {e : ℕ} (hdT : topologicalKrullDim T = e) {m : ℕ} (hm : 0 < m)
    (hc : ∃ (d : ℕ) (K : Divisor S), K.IsCanonicalDivisor sS d ∧
      ((m : ℤ) • (Divisor.toQDivisor K + BS)).IsCartierDivisor)
    (ρ : RationalPluriForms sS (e + 1) m) (hρ : ρ ∈ logPluricanonicalSections sS (e + 1) m BS) :
    ∃ ρ' : RationalPluriForms (j ≫ sS) e m, IsPoincareResidue sS j e m ρ ρ' ∧
      ρ' ∈ logPluricanonicalSections (j ≫ sS) e m BT := by
  classical
  haveI : LocallyOfFiniteType sS := hS.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (j ≫ sS) := hj.1.1.toLocallyOfFiniteType
  haveI : QuasiCompact sS := hS.1.toQuasiCompact
  haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace sS
  haveI : QuasiCompact (j ≫ sS) := hj.1.1.toQuasiCompact
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace (j ≫ sS)
  obtain ⟨-, P, -, hrange, hci, -⟩ := id hj
  haveI := hci
  have hdS : topologicalKrullDim S = (e + 1 : ℕ) :=
    topologicalKrullDim_eq_add_one_of_isAdjunctionStep hj hdT
  have hP' := map_genericPoint_eq_of_range_eq j P hrange
  obtain ⟨d, KS, hKS, hc⟩ := hc
  have hd : (d : WithBot ℕ∞) = ((e + 1 : ℕ) : WithBot ℕ∞) := by
    rw [← hKS.topologicalKrullDim_eq, hdS]
  have hd' : d = e + 1 := by exact_mod_cast hd
  subst hd'
  have hlog := (mem_logPluricanonicalSections_iff (sX := sS)).mp hρ
  have heqP : ∀ P' : Mori.PrimeDivisor S, j (genericPoint T) = P'.genericPoint → P' = P :=
    fun P' hP'' => by
      have : P'.genericPoint ∈ P.support := by rw [← hP'', hP']; exact genericPoint_mem_support P
      exact MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support this
  rcases Nat.eq_zero_or_pos e with rfl | he0
  · -- `S` is a curve and `T` a point
    let O := S.presheaf.stalk (j (genericPoint T))
    let := stalkAlgebra sS (j (genericPoint T))
    let := functionFieldAlgebra sS
    let := functionFieldAlgebra (j ≫ sS)
    let : Algebra O T.functionField := (j.stalkMap (genericPoint T)).hom.toAlgebra
    obtain ⟨hdvr, -, -, -, hcoh, -⟩ := hj.stalk_facts
    obtain ⟨-, hsurj⟩ := hj.stalkMap_facts
    obtain ⟨ϖ, r, -, hr, hker, -, -⟩ := hj.exists_uniformizer
    have hmax : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} :=
      (IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ hsurj)).symm.trans hker
    have hϖirr : Irreducible ϖ :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mpr hmax
    have hϖ0 : algebraMap O S.functionField ϖ ≠ 0 := by
      rw [Ne, IsFractionRing.to_map_eq_zero_iff]; exact hϖirr.ne_zero
    have hord : S.ord (algebraMap O S.functionField ϖ) (j (genericPoint T)) = 1 :=
      (Scheme.ord_eq_iff hcoh hϖ0).mpr (Ring.ordFrac_irreducible hϖirr)
    -- a form `σ` with a simple pole along `P`
    obtain ⟨b⟩ := exists_basis_topForms (sX := sS) hdS
    set N := P.ordForm (show RationalPluriForms sS (0 + 1) 1 from formPow (b ()) 1) with hN
    set f : S.functionField := (algebraMap O S.functionField ϖ) ^ (-1 - N) with hf_def
    have hf : f ≠ 0 := zpow_ne_zero _ hϖ0
    set σ : RationalPluriForms sS (0 + 1) 1 := f • formPow (b ()) 1 with hσ_def
    have hσ0 : σ ≠ 0 := smul_formPow_ne_zero hdS (b.ne_zero ()) hf 1
    have hσP : P.ordForm σ = -1 := by
      rw [hσ_def, ordForm_smul_formPow hdS P (b.ne_zero ()) hf 1, hf_def, ord_zpow _ hϖ0, ← hP',
        hord, ← hN]
      push_cast; ring
    obtain ⟨ρσ, hρσ⟩ := exists_isPoincareResidue_of_curve hS (by exact_mod_cast hdS) hj σ
      fun P' hP'' _ => by
        obtain rfl := heqP P' hP''
        rw [hσP]; norm_num
    have hBP := hj.coeff_eq_one hrange
    obtain ⟨ρ', hρ'⟩ := exists_isPoincareResidue_of_curve hS (by exact_mod_cast hdS) hj ρ
      fun P' hP'' hρ0 => by
        obtain rfl := heqP P' hP''
        have := hlog P' hρ0
        rw [hBP, mul_one, Int.floor_natCast] at this
        omega
    refine ⟨ρ', hρ', ?_⟩
    haveI := isEmpty_primeDivisor_of_topologicalKrullDim_eq_zero (S := T) (by rw [hdT]; rfl)
    exact (mem_logPluricanonicalSections_iff (sX := j ≫ sS)).mpr fun Γ => isEmptyElim Γ
  · obtain ⟨Q⟩ := MMP.Positivity.nonempty_primeDivisor_of_topologicalKrullDim_eq hdT he0.ne'
    obtain ⟨σ, hσ0, hσP, -, ρσ, hρσ, hρσ0, -⟩ :=
      exists_form_of_residue_order sS hS (n := e) hdS j hj.1 P hrange Q
    obtain ⟨φ, hφ⟩ : (divisorOfForm σ).LinearlyEquivalent KS := by
      simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hS hKS (m := 1) hσ0
    obtain ⟨D₀, hD₀, hD₀c⟩ := hc
    set D : Divisor S := D₀ + principalDivisor (φ ^ m) with hD_def
    have hD : Divisor.toQDivisor D = (m : ℤ) • (Divisor.toQDivisor (divisorOfForm σ) + BS) :=
      toQDivisor_add_principalDivisor_pow hD₀ hφ
    have hDc : D.IsCartier := hD₀c.add (Divisor.isCartier_principalDivisor _)
    have hQc : (Divisor.toQDivisor (divisorOfForm σ) + BS).IsQCartier :=
      ⟨(m : ℤ), by exact_mod_cast hm.ne', D, hD, hDc⟩
    obtain ⟨hgen, hpb⟩ := hj.isPullback_divisorOfForm_add_of_isPoincareResidue (n := e) hdS P
      hrange σ hσ0 hσP ρσ hρσ hQc
    obtain ⟨D', hD', hD'p⟩ := hpb m hm D hD hDc
    exact exists_isPoincareResidue_mem_logPluricanonicalSections hdS hj hdT P hrange hσ0 hσP hρσ
      hρσ0 hm hD hDc hD'p hD' ρ hρ

/-- **Iterated residues of log sections exist and are log sections** along every flag of
iterated adjunction of a pair `(X, B)` with `m(K_X + B)` Cartier. -/
private theorem exists_isIteratedResidueRec_mem {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X} {n m : ℕ}
    (hm : 0 < m) (hX : ∃ (d : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX d ∧
      ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor)
    (hn : topologicalKrullDim X = n) (τ : RationalPluriForms sX n m)
    (hτ : τ ∈ logPluricanonicalSections sX n m B) :
    ∀ {T : Scheme.{0}} {ι : T ⟶ X} {BT : QDivisor T} (F : StratumAdjunctionData sX B ι BT)
      (e : ℕ), topologicalKrullDim T = e →
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      ∃ ρ : RationalPluriForms (ι ≫ sX) e m, IsIteratedResidueRec τ F e ρ ∧
        ρ ∈ logPluricanonicalSections (ι ≫ sX) e m BT := by
  intro T ι BT F
  induction F with
  | refl h =>
    intro e he
    obtain rfl : n = e := by
      have := hn.symm.trans he
      exact_mod_cast this
    exact ⟨cast (by rw [Category.id_comp]) τ, ⟨rfl, cast_heq _ _⟩,
      mem_logPluricanonicalSections_of_heq (Category.id_comp sX).symm (cast_heq _ _).symm hτ⟩
  | @step S T ι BS F j BT hj ih =>
    intro e he
    haveI := F.isIntegral_stratum
    haveI := F.isNormal_stratum
    haveI := F.isLocallyNoetherian_stratum
    haveI : IsIntegral T := hj.1.1.toIsIntegral
    haveI : IsNormal T := hj.1.2
    haveI : LocallyOfFiniteType (ι ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (j ≫ ι ≫ sX) := hj.1.1.toLocallyOfFiniteType
    haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian (j ≫ ι ≫ sX)
    have hdS := topologicalKrullDim_eq_add_one_of_isAdjunctionStep hj he
    obtain ⟨ρ₀, hρ₀, hmem⟩ := ih (e + 1) hdS
    obtain ⟨ρ', hρ', hmem'⟩ := exists_isPoincareResidue_mem_of_isAdjunctionStep
      F.isNormalVariety hj he hm (exists_isCartierDivisor_of_stratumAdjunctionData hm hX F) ρ₀
      hmem
    exact ⟨cast (by rw [Category.assoc]) ρ', ⟨ρ₀, hρ₀, ρ', hρ', cast_heq _ _⟩,
      mem_logPluricanonicalSections_of_heq (Category.assoc j ι sX).symm (cast_heq _ _).symm
        hmem'⟩

/-- The floor of a `ℚ`-divisor has finitely many components. -/
private theorem finite_floor {Y : Scheme.{0}} (BY : QDivisor Y) :
    Finite {P : Mori.PrimeDivisor Y // ⌊BY.coeff P⌋ ≠ 0} := by
  refine Finite.Set.subset (BY.support : Set (Mori.PrimeDivisor Y)) fun P hP => ?_
  simp only [Finset.mem_coe, Finsupp.mem_support_iff]
  intro h0
  exact hP (by rw [DivisorWithCoeffs.coeff] at *; simp [h0])

/-- The projection of `ℙ(G) = Proj_Z(Sym G)` is proper when `G` is quasi-coherent of finite
type. -/
private theorem isProper_relativeProj_toBase {Z : Scheme.{0}} (G : Z.Modules) [G.IsQuasicoherent]
    [G.IsFiniteType] :
    IsProper (Stacks.AlgebraicGeometry.RelativeProj.relativeProj
      (Stacks.SymGraded.schemeSheafGradedAlgebra G
        (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent G))).toBase := by
  have h := Stacks.RelativeProj.isProper_projectiveBundleToBase_of_isFiniteType Z G
  rw [← Stacks.RelativeProj.bundlePresentationIso_inv_comp_toBase G] at h
  exact (MorphismProperty.cancel_left_of_respectsIso @IsProper _ _).mp h

/-- An `f`-ample Cartier divisor is ample over an affine neighbourhood of every point. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] {f : Y ⟶ X} {W : Divisor Y}
    (hW : MMP.Flips.IsRelativelyAmpleCartier f W) : W.IsRelativelyAmple f hW.1 := by
  obtain ⟨hWc, hamp⟩ := hW
  have := hWc.isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- **The Stein factor.** A Stein factorization `X ⟶ Z ⟶ P` of a proper morphism `Φ` to a
proper `k`-scheme, together with the properties of every such factorization, gives a proper
surjective `c : X ⟶ Z` onto a normal variety with `c_* 𝒪_X = 𝒪_Z` and an ample divisor `A` on `Z`
with `𝒪_X(M) ≅ c^* 𝒪_Z(A)`. -/
private theorem exists_steinFactor {k : Type} [Field k] {X P : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sX] (M : X.CartierDivisor)
    (πP : P ⟶ Spec (.of k)) (hπ : IsProper πP) (Φ : X ⟶ P) [IsProper Φ] (hΦ : Φ ≫ πP = sX)
    (hall : ∀ (YL : Scheme.{0}) (ρ : X ⟶ YL) (τ : YL ⟶ P),
      Stacks.SteinFactorization.IsSteinFactorization Φ ρ τ →
        MMP.Mori.IsNormalVariety k (τ ≫ πP ≫ 𝟙 (Spec (.of k))) ∧
          (∀ U : YL.Opens, IsIso (ρ.app U)) ∧ IsFinite τ ∧
          ∃ (_ : IsLocallyNoetherian YL) (_ : IsNormal YL) (_ : CompactSpace YL)
            (A : Divisor YL), MMP.Flips.IsRelativelyAmpleCartier (τ ≫ πP) A ∧
            Nonempty (MMP.CartierDivisor.sheaf M ≅
              (Scheme.Modules.pullback ρ).obj A.divisorialSheaf)) :
    ∃ (Z : Scheme.{0}) (sZ : Z ⟶ Spec (.of k)) (c : X ⟶ Z) (_ : MMP.Mori.IsNormalVariety k sZ)
      (_ : c ≫ sZ = sX) (_ : IsProper c) (_ : Surjective c) (_ : IsProper sZ)
      (_ : IsLocallyNoetherian Z) (_ : IsNormal Z) (_ : CompactSpace Z)
      (_ : ∀ U : Z.Opens, IsIso (c.app U)) (A : Divisor Z),
      MMP.Flips.IsRelativelyAmpleCartier sZ A ∧
        Nonempty (MMP.CartierDivisor.sheaf M ≅
          (Scheme.Modules.pullback c).obj A.divisorialSheaf) := by
  haveI := hπ
  obtain ⟨Z, c, τ, ⟨hSt⟩, hcp, hcs, hcapp, -, hτ, -, -, -, -, -⟩ :=
    MMP.Resolution.Bridges.exists_steinFactorization_of_isVariety sX (πP ≫ 𝟙 _) Φ
      (by rw [Category.comp_id, hΦ])
  obtain ⟨hZn, -, -, i1, i2, i3, A, hA, hMA⟩ := hall Z c τ hSt
  have hZn' : MMP.Mori.IsNormalVariety k (τ ≫ πP) := by
    simpa only [Category.comp_id] using hZn
  exact ⟨Z, τ ≫ πP, c, hZn', by rw [← Category.assoc, hSt.comp, hΦ], hcp, hcs,
    inferInstance, i1, i2, i3, hcapp, A, hA, hMA⟩

/-- `ℚ`-linear equivalence can be divided by a positive integer: `kD₁ ∼_ℚ kD₂` gives
`D₁ ∼_ℚ D₂`. -/
private theorem qLinearlyEquivalent_of_smul {X : Scheme.{0}} [IsLocallyNoetherian X]
    [CompactSpace X] [IsNormal X] {D₁ D₂ : QDivisor X} {k : ℕ} (hk : 0 < k)
    (h : ((k : ℚ) • D₁).QLinearlyEquivalent ((k : ℚ) • D₂)) : D₁.QLinearlyEquivalent D₂ := by
  obtain ⟨m, hm, φ, hφ⟩ := h
  refine ⟨m * k, Nat.mul_pos hm hk, φ, ?_⟩
  rw [← hφ]
  ext E
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub, zsmul_eq_mul, smul_eq_mul]
  push_cast
  ring

/-- **Residue restrictions exist.** For a finite collection of projective dlt pairs of dimension
`n` over `ℂ`, residue restriction data exist in every positive even degree divisible by some
`c > 0`. -/
private theorem exists_residueRestriction {I : Type*} [Finite I] {X : I → Scheme.{0}}
    [∀ i, IsIntegral (X i)] [∀ i, IsLocallyNoetherian (X i)] [∀ i, IsNormal (X i)]
    {sX : ∀ i, X i ⟶ Spec (.of ℂ)} {n : ℕ} (hX : ∀ i, Mori.IsProjectiveVariety ℂ (sX i))
    (hdim : ∀ i, topologicalKrullDim (X i) = n) {B : ∀ i, QDivisor (X i)}
    (hB : ∀ i, Fourfold.IsPair (sX i) (B i)) (hdlt : ∀ i, MMP.Intersection.IsDltPair (sX i) (B i)) :
    ∃ c : ℕ, 0 < c ∧ ∀ m : ℕ, 0 < m → c ∣ m → Even m →
      Nonempty (ResidueRestriction sX B n m) := by
  classical
  haveI := Fintype.ofFinite I
  -- the index of `K_{X_i} + B_i`
  have hidx : ∀ i, ∃ N : ℕ, 0 < N ∧ ∀ m : ℕ, N ∣ m → ∃ (d : ℕ) (K : Divisor (X i)),
      K.IsCanonicalDivisor (sX i) d ∧
        ((m : ℤ) • (Divisor.toQDivisor K + B i)).IsCartierDivisor := fun i => by
    obtain ⟨-, n₀, K, hK, N, hN0, hNC⟩ := (hB i).isPair
    obtain ⟨D₀, hD₀, hD₀c⟩ := hNC
    refine ⟨N.natAbs, Int.natAbs_pos.mpr hN0, fun m hmd => ?_⟩
    obtain ⟨z, hz⟩ : N ∣ (m : ℤ) := Int.natAbs_dvd.mp (by exact_mod_cast hmd)
    exact ⟨n₀, K, hK, z • D₀, by rw [map_zsmul, hD₀, smul_smul, mul_comm, ← hz], hD₀c.zsmul z⟩
  choose N hN0 hNC using hidx
  refine ⟨∏ i, N i, Finset.prod_pos fun i _ => hN0 i, fun m hmpos hm hev => ?_⟩
  have hdvd : ∀ i, N i ∣ m := fun i =>
    (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)).trans hm
  have hex : ∀ (i : I) {T : Scheme.{0}} {ι : T ⟶ X i} {BT : QDivisor T}
      (F : StratumAdjunctionData (sX i) (B i) ι BT) (e : ℕ), topologicalKrullDim T = e →
      ∀ τ ∈ logPluricanonicalSections (sX i) n m (B i),
        haveI := F.isIntegral_stratum
        ∃ ρ : RationalPluriForms (ι ≫ sX i) e m, IsIteratedResidue (sX i) (B i) τ F e ρ :=
    fun i _ _ _ F e he τ hτ => by
      obtain ⟨ρ, hρ, -⟩ := exists_isIteratedResidueRec_mem hmpos (hNC i m (hdvd i)) (hdim i) τ hτ
        F e he
      exact ⟨ρ, IsIteratedResidue.of_rec F hρ⟩
  refine ⟨{ setting := ⟨inferInstance, hX, hB, hdlt, hdim, hev, hmpos,
      fun i _ _ _ F => exists_isCartierDivisor_of_stratumAdjunctionData hmpos (hNC i m (hdvd i)) F⟩
            toFun := fun i T ι BT F e =>
              haveI := F.isIntegral_stratum
              if he : topologicalKrullDim T = e then
                { toFun := fun τ => (hex i F e he τ τ.2).choose
                  map_add' := fun τ₁ τ₂ => IsIteratedResidue.unique
                    (hex i F e he (τ₁ + τ₂) (τ₁ + τ₂).2).choose_spec
                    ((isIteratedResidue_add_smul F e he).1 _ _ _ _
                      (hex i F e he τ₁ τ₁.2).choose_spec
                      (hex i F e he τ₂ τ₂.2).choose_spec)
                  map_smul' := fun c τ => IsIteratedResidue.unique
                    (hex i F e he (c • τ) (c • τ).2).choose_spec
                    ((isIteratedResidue_add_smul F e he).2 c _ _
                      (hex i F e he τ τ.2).choose_spec) }
              else 0
            isIteratedResidue := fun i T ι BT F e τ he => by
              haveI := F.isIntegral_stratum
              simp only [dif_pos he]
              exact (hex i F e he τ τ.2).choose_spec }⟩

/-- A finite morphism into a scheme which is H-projective over a field is H-projective over that
field. -/
private theorem isProjectiveMorphism_comp_of_isFinite {k : Type} [Field k]
    {Y' Y : Scheme.{0}} (g : Y' ⟶ Y) [IsFinite g] (sY : Y ⟶ Spec (.of k))
    (hY : IsProjectiveMorphism sY) : IsProjectiveMorphism (g ≫ sY) := by
  obtain ⟨L, hL, hLa⟩ := exists_isAmple_of_isQuasiProjective sY
    (Stacks.Ample.unitModule (Spec (.of k)))
    (Stacks.Ample.isAmple_unitModule_of_isAffine _)
    (isQuasiProjective_of_isHQuasiProjective sY hY.isHQuasiProjective)
  have hg : IsProjectiveMorphism g :=
    isProjectiveMorphism_iff_isHQuasiProjective_and_isProper.mpr
      ⟨isHQuasiProjective_of_isQuasiProjective g L hLa (isQuasiProjective_of_isFinite g),
        inferInstance⟩
  exact hg.comp hY

/-- **The floor models are projective dlt surface pairs.** An adjunction step `T ⟶ X` onto a
prime divisor `P` of a projective dlt threefold pair `(X, B)` over `ℂ` is a projective surface,
and its adjunction pair `(T, B_T)` is a dlt pair. -/
private theorem floor_isProjectiveVariety_and_isDltPair {X T : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    (hX : Mori.IsProjectiveVariety ℂ sX) (hdim : topologicalKrullDim X = 3) {B : QDivisor X}
    (hB : IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B) [IsIntegral T]
    [IsLocallyNoetherian T] [IsNormal T] {j : T ⟶ X} {BT : QDivisor T}
    (hj : IsAdjunctionStep sX B j BT) (P : Mori.PrimeDivisor X)
    (hP : Set.range j.base = (P.support : Set X)) :
    Mori.IsProjectiveVariety ℂ (j ≫ sX) ∧ topologicalKrullDim T = 2 ∧ IsPair (j ≫ sX) BT ∧
      MMP.Intersection.IsDltPair (j ≫ sX) BT := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  obtain ⟨-, Q, hQ1, hQr, hci, -⟩ := id hj
  haveI := hci
  have hPQ : P = Q := by
    have h1 := map_genericPoint_eq_of_range_eq j P hP
    have h2 := map_genericPoint_eq_of_range_eq j Q hQr
    exact MMP.Threefold.Resolution.eq_of_genericPoint_mem_support
      (h2 ▸ h1 ▸ genericPoint_mem_support P :
        Q.genericPoint ∈ (P.support : Set X))
  subst hPQ
  have hdT : topologicalKrullDim T = 2 :=
    topologicalKrullDim_eq_of_range_eq_support sX j P hP (e := 2) (by rw [hdim]; rfl)
  have hj' : IsAdjunctionStep (𝟙 X ≫ sX) B j BT := by simpa only [Category.id_comp] using hj
  let F : StratumAdjunctionData sX B (j ≫ 𝟙 X) BT :=
    .step (.refl hB.isPair) j BT hj'
  have hstr : IsDltStratum sX B (P.support : Set X) := by
    have hinter : (⋂ P' ∈ ({P} : Finset (Mori.PrimeDivisor X)), (P'.support : Set X)) =
        P.support := by simp
    refine ⟨hdlt, {P}, Finset.singleton_nonempty _, by simpa using hQ1, ?_, ?_⟩
    · rw [hinter]
      exact ⟨P.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
    · rw [hinter]
      refine ⟨⟨?_, le_rfl⟩, fun T hT _ => hT.2⟩
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
  have hdltF := hstr.exists_isStratumAdjunctionPair_and_isDltPair.1.2 F (by simpa using hP)
  have hdltT : MMP.Intersection.IsDltPair (j ≫ sX) BT :=
    isDltPair_congr (by simp) hdltF
  refine ⟨(AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr
      ⟨hj.1.1, isProjectiveMorphism_comp_of_isFinite j sX hX.isProjective⟩, hdT,
    ⟨inferInstance, inferInstance, hdltT.1.1, hdltT.1.2.1⟩, hdltT⟩

/-! ### The relative Picard number of the contraction of a ray -/

section RelativePicardNumber

variable {k : Type} [Field k] {X Z : Scheme.{0}} {sX : X ⟶ Spec (.of k)}

/-- The degree along a proper curve is an isomorphism invariant of the invertible sheaf. -/
private theorem degree_eq_of_iso (C : ProperCurve sX) {L L' : X.Modules}
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L'] (e : L ≅ L') :
    C.degree k L = C.degree k L' :=
  degreeOn_eq_of_iso k sX C.ι C.dim_le e

/-- `deg_C 𝒪_X(E + E') = deg_C 𝒪_X(E) + deg_C 𝒪_X(E')` along a proper curve. -/
private theorem degree_cartierSheaf_add (C : ProperCurve sX) (E E' : X.CartierDivisor) :
    C.degree k (MMP.CartierDivisor.sheaf (E + E')) =
      C.degree k (MMP.CartierDivisor.sheaf E) +
        C.degree k (MMP.CartierDivisor.sheaf E') := by
  haveI : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.toRingedSpace.presheaf,
        X.toRingedSpace.IsSheaf⟩).obj (MMP.CartierDivisor.sheaf E)).obj
          (MMP.CartierDivisor.sheaf E')) :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf X.ringCatSheaf.2 _ _
  rw [ProperCurve.degree, ProperCurve.degree, ProperCurve.degree, ← degreeOn_tensorSheaf]
  exact degreeOn_eq_of_iso k sX C.ι C.dim_le (MMP.CartierDivisorSheaf.sheafMulIso E E').symm

/-- The degree `E ↦ deg_C 𝒪_X(E)` along a proper curve, as a homomorphism `Div(X) → ℤ`. -/
private noncomputable def cartierDegreeHom (C : ProperCurve sX) : X.CartierDivisor →+ ℤ :=
  AddMonoidHom.mk' (fun E => C.degree k (MMP.CartierDivisor.sheaf E))
    (degree_cartierSheaf_add C)

private theorem cartierDegreeHom_apply (C : ProperCurve sX) (E : X.CartierDivisor) :
    cartierDegreeHom C E = C.degree k (MMP.CartierDivisor.sheaf E) :=
  rfl

/-- `(C · E) = deg_C 𝒪_X(E)` for a Cartier divisor `E`, viewed as an `ℝ`-Cartier divisor. -/
private theorem intersectionNumber_ofCartier (C : ProperCurve sX) (E : X.CartierDivisor) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ E) = cartierDegreeHom C E := by
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]
  rfl

/-- The numerical class `E ↦ [E] ∈ N¹(X)_ℝ` of Cartier divisors, additive since
`deg_C 𝒪_X(E + E') = deg_C 𝒪_X(E) + deg_C 𝒪_X(E')` on every proper curve `C`. -/
private noncomputable def cartierClassHom : X.CartierDivisor →+ NumericalDivisorClasses sX :=
  AddMonoidHom.mk' (fun E => numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E))
    fun E E' => by
      rw [← map_add]
      refine (Submodule.Quotient.eq _).mpr (mem_numericallyTrivialDivisors.mpr fun C => ?_)
      have h := intersectionNumber_ofCartier C
      simp only [OneCycle.intersectionNumber] at h ⊢
      simp [h, map_add]

private theorem cartierClassHom_apply (E : X.CartierDivisor) :
    cartierClassHom E = numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E) :=
  rfl

/-- `([E] · T) = deg_T 𝒪_X(E)` for the class `[E] ∈ N¹(X)_ℝ` of a Cartier divisor `E`. -/
private theorem numericalPairing_flip_cartierClassHom (T : ProperCurve sX) (E : X.CartierDivisor) :
    (numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ)) (cartierClassHom E) =
      cartierDegreeHom T E :=
  intersectionNumber_ofCartier T E

variable (f : X ⟶ Z) {T : ProperCurve sX} {H : X.CartierDivisor}

/-- **Descent of numerical classes.** Let `H` be a Cartier divisor of degree `a ≠ 0` on a proper
curve `T`, and suppose every Cartier divisor of degree zero on `T` is a pull-back along `f`. Then
`a [D] - (D · T) [H] ∈ f^* N¹(Z)_ℝ` for every `ℝ`-Cartier divisor `D`. -/
private theorem smul_sub_mem_pullbackNumericalClasses
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (D : KCartierDivisor ℝ X) :
    (cartierDegreeHom T H : ℝ) • numericalDivisorClass sX D -
        (T.cycle ℝ).intersectionNumber D • cartierClassHom H ∈
      pullbackNumericalClasses sX f := by
  induction D using Finsupp.induction_linear with
  | zero => simp [OneCycle.intersectionNumber]
  | add D D' h h' =>
    convert add_mem h h' using 1
    simp only [OneCycle.intersectionNumber, map_add, LinearMap.add_apply, add_smul, smul_add]
    abel
  | single E r =>
    set a := cartierDegreeHom T H
    set e := cartierDegreeHom T E
    obtain ⟨M, hM, hiso⟩ := hdesc (a • E - e • H) (by
      rw [← cartierDegreeHom_apply, map_sub, map_zsmul, map_zsmul, smul_eq_mul, smul_eq_mul,
        mul_comm, sub_self])
    have hmem : cartierClassHom (a • E - e • H) ∈ pullbackNumericalClasses sX f :=
      Submodule.subset_span ⟨_, M, hM, hiso, rfl⟩
    rw [map_sub, map_zsmul, map_zsmul, ← Int.cast_smul_eq_zsmul ℝ,
      ← Int.cast_smul_eq_zsmul ℝ] at hmem
    have hs : Finsupp.single E r = r • KCartierDivisor.ofCartier ℝ E := by
      simp [KCartierDivisor.ofCartier, Finsupp.smul_single]
    have hTE : (T.cycle ℝ).intersectionNumber (Finsupp.single E r) = r * e := by
      rw [hs, OneCycle.intersectionNumber, map_smul, LinearMap.smul_apply,
        ← OneCycle.intersectionNumber, intersectionNumber_ofCartier, smul_eq_mul]
    convert Submodule.smul_mem _ r hmem using 1
    rw [hTE, hs, map_smul, ← cartierClassHom_apply]
    module

/-- `f^* N¹(Z)_ℝ` is the kernel of `d ↦ (d · T)` when a Cartier divisor descends along `f` exactly
when it has degree zero on `T`, and some Cartier divisor has nonzero degree on `T`. -/
private theorem pullbackNumericalClasses_eq_ker (hH : cartierDegreeHom T H ≠ 0)
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (hpull : ∀ (E : X.CartierDivisor) (M : Z.Modules)
      (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
      Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M) →
        T.degree k (MMP.CartierDivisor.sheaf E) = 0) :
    pullbackNumericalClasses sX f =
      LinearMap.ker ((numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ))) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun d hd => ?_
  · rintro _ ⟨E, M, hM, hiso, rfl⟩
    rw [SetLike.mem_coe, LinearMap.mem_ker, ← cartierClassHom_apply,
      numericalPairing_flip_cartierClassHom, cartierDegreeHom_apply, hpull E M hM hiso,
      Int.cast_zero]
  · obtain ⟨D, rfl⟩ := (numericallyTrivialDivisors sX).mkQ_surjective d
    have h := smul_sub_mem_pullbackNumericalClasses f (H := H) hdesc D
    rwa [show (T.cycle ℝ).intersectionNumber D = 0 from hd, zero_smul, sub_zero,
      Submodule.smul_mem_iff _ (by exact_mod_cast hH)] at h

/-- **`ρ(X/Z) = 1`.** Let `T ⊆ X` be a proper curve with nonzero class in `N₁(X)` and `f : X ⟶ Z`
a morphism such that a Cartier divisor `E` on `X` has `𝒪_X(E) ≅ f^* M` for an invertible `M`
on `Z` if and only if `deg_T 𝒪_X(E) = 0`. Then `N¹(X) / f^* N¹(Z)` is a line. -/
private theorem relativePicardNumberN1_eq_one [IsIntegral X] (T : ProperCurve sX)
    (hT : OneCycle.numericalClass sX (T.cycle ℝ) ≠ 0)
    (hdesc : ∀ E : X.CartierDivisor, T.degree k (MMP.CartierDivisor.sheaf E) = 0 →
      ∃ (M : Z.Modules) (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
        Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M))
    (hpull : ∀ (E : X.CartierDivisor) (M : Z.Modules)
      (_ : SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2 M),
      Nonempty (MMP.CartierDivisor.sheaf E ≅ (Scheme.Modules.pullback f).obj M) →
        T.degree k (MMP.CartierDivisor.sheaf E) = 0) :
    relativePicardNumberN1 sX f = 1 := by
  obtain ⟨H, hH⟩ : ∃ H : X.CartierDivisor, cartierDegreeHom T H ≠ 0 := by
    by_contra! h
    refine hT ((Submodule.Quotient.mk_eq_zero _).mpr
      (OneCycle.mem_numericallyTrivial.mpr fun L _ => ?_))
    obtain ⟨E, ⟨e⟩⟩ := exists_nonempty_iso_cartierDivisor_sheaf L
    rw [OneCycle.degree_cycle, degree_eq_of_iso T e, ← cartierDegreeHom_apply, h E, Int.cast_zero]
  have hsurj : Function.Surjective
      ((numericalPairing sX).flip (OneCycle.numericalClass sX (T.cycle ℝ))) := fun r =>
    ⟨(r / cartierDegreeHom T H) • cartierClassHom H, by
      rw [map_smul, numericalPairing_flip_cartierClassHom, smul_eq_mul,
        div_mul_cancel₀ r (by exact_mod_cast hH)]⟩
  rw [relativePicardNumberN1, pullbackNumericalClasses_eq_ker f hH hdesc hpull,
    (LinearMap.quotKerEquivOfSurjective _ hsurj).rank_eq, Module.rank_self]
  simp

end RelativePicardNumber

/-! ### The relative program over the base of the contraction -/

section ProgramInvariants

open MMP.Flips TopologicalSpace

private theorem isKltPair_sub_smul_roundDown {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hQ : IsQFactorial sX)
    {B : QDivisor X} (hB : MMP.Intersection.IsDltPair sX B) {t : ℚ} (ht0 : 0 < t)
    (ht1 : t ≤ 1) :
    IsKltPair sX (B - t • Divisor.toQDivisor B.roundDown) := by
  have hcoeff : ∀ P, (B - t • Divisor.toQDivisor B.roundDown).coeff P =
      B.coeff P - t * ⌊B.coeff P⌋ := by
    intro P
    simp
  have h0 : ∀ P, 0 ≤ B.coeff P := hB.1.2.1
  have h1 : ∀ P, B.coeff P ≤ 1 := hB.2.1
  have hfl : ∀ P, (⌊B.coeff P⌋ : ℚ) = if B.coeff P = 1 then 1 else 0 := by
    intro P
    split_ifs with h
    · simp [h]
    · have : B.coeff P < 1 := lt_of_le_of_ne (h1 P) h
      rw [Int.floor_eq_zero_iff.mpr ⟨h0 P, this⟩]
      simp
  refine MMP.Intersection.IsDltPair.isKltPair_of_forall_coeff_lt_one
    (MMP.Intersection.IsDltPair.of_le sX hB (fun P => ?_) (fun P => ?_)
      (isQCartier_of_isQFactorial sX hQ _)) (fun P => ?_)
  · change (0 : ℚ) ≤ (B - t • Divisor.toQDivisor B.roundDown).coeff P
    rw [hcoeff, hfl]
    split_ifs with h
    · rw [h]; linarith
    · simpa using h0 P
  · change (B - t • Divisor.toQDivisor B.roundDown).coeff P ≤ B.coeff P
    rw [hcoeff, hfl]
    split_ifs <;> simp; linarith
  · rw [hcoeff, hfl]
    split_ifs with h
    · rw [h]; linarith
    · simpa using lt_of_le_of_ne (h1 P) h

/-- The iterated birational transforms `D₀ = D`, `D_{i+1} = (φ_i)_* D_i` of a divisor along a
sequence of rational maps `φ_i : X_i ⤏ X_{i+1}`. -/
private noncomputable def iterTransform {R : Type*} [AddCommMonoid R] {X : Scheme.{0}}
    {Y : ℕ → Scheme.{0}} (φ : ∀ i, (modelSeq X Y i).RationalMap (Y i))
    (D : DivisorWithCoeffs R X) : ∀ i, DivisorWithCoeffs R (modelSeq X Y i)
  | 0 => D
  | i + 1 => MMP.Mori.RationalMap.transformDivisor (φ i) (iterTransform φ D i)

/-- The invariants carried along the floor-lowering program on a model `X₁` over `Z`, for the
transforms `K₁`, `B₁`, `T₁` of `K`, `B`, `⌊B⌋` and the real boundary `Δ₁` of the scaling
program: `m D₁` is Cartier for `D₁ = K₁ + B₁`, `K₁` is canonical, `D₁` is nef over `Z`,
`(X₁, B₁ - T₁)` is klt, `(X₁, B₁)` is lc, `0 ≤ T₁ ≤ B₁`, the coefficients of `B₁ - T₁` are
less than one and `Δ₁ = B₁ - t₀ T₁`. -/
private structure FloorInv {X₁ Z : Scheme.{0}} [IsIntegral X₁] [CompactSpace X₁]
    [IsLocallyNoetherian X₁] [IsNormal X₁] (s₁ : X₁ ⟶ Spec (.of ℂ)) (π₁ : X₁ ⟶ Z) (m : ℕ)
    (t₀ : ℚ) (K₁ : Divisor X₁) (B₁ T₁ : QDivisor X₁) (Δ₁ : RDivisor X₁) : Prop where
  exists_cartier : ∃ Dm : Divisor X₁, Dm.IsCartier ∧
    Divisor.toQDivisor Dm = (m : ℤ) • (Divisor.toQDivisor K₁ + B₁)
  isCanonicalDivisor : K₁.IsCanonicalDivisor s₁ 3
  isRelativelyNef : QDivisor.IsRelativelyNef s₁ π₁ (Divisor.toQDivisor K₁ + B₁)
  isRelativelyNef_neg : QDivisor.IsRelativelyNef s₁ π₁ (-(Divisor.toQDivisor K₁ + B₁))
  isKltPair_sub : IsKltPair s₁ (B₁ - T₁)
  isLogCanonicalPair : MMP.Intersection.IsLogCanonicalPair s₁ B₁
  floor_nonneg : ∀ P, 0 ≤ T₁.coeff P
  coeff_bounds : ∀ P, 0 ≤ (B₁ - T₁).coeff P ∧ (B₁ - T₁).coeff P < 1 ∧ B₁.coeff P ≤ 1
  floor_int : ∀ P, T₁.coeff P = 0 ∨ T₁.coeff P = 1
  toRDivisor_eq : QDivisor.toRDivisor (B₁ - t₀ • T₁) = Δ₁

/-- The birational transform of divisors commutes with regarding a `ℚ`-divisor as an
`ℝ`-divisor. -/
private theorem transformDivisor_toRDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (D : QDivisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (QDivisor.toRDivisor D) =
      QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor φ D) := by
  classical
  have hs : ∀ {Z : Scheme.{0}} (Q : MMP.Mori.PrimeDivisor Z) (r : ℚ),
      QDivisor.toRDivisor (Finsupp.single Q r) = Finsupp.single Q (r : ℝ) :=
    fun Q r => Finsupp.mapRange_single (hf := map_zero (Rat.castHom ℝ).toAddMonoidHom)
  induction D using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add D D' h h' => simp only [map_add, h, h']
  | single P r =>
    rw [hs, MMP.Mori.RationalMap.transformDivisor_single,
      MMP.Mori.RationalMap.transformDivisor_single]
    cases MMP.Mori.RationalMap.transformPrimeDivisor φ P with
    | none => exact (map_zero _).symm
    | some E => exact (hs E r).symm

/-- The adjoint `K + Δ` of a `ℚ`-boundary, regarded as an `ℝ`-divisor. -/
private theorem logCanonicalDivisor_toRDivisor {X : Scheme.{0}} (K : Divisor X) (Δ : QDivisor X) :
    logCanonicalDivisor K (QDivisor.toRDivisor Δ) =
      QDivisor.toRDivisor (Divisor.toQDivisor K + Δ) := by
  rw [logCanonicalDivisor, map_add, QDivisor.toRDivisor_toQDivisor]

/-- A morphism of projective complex varieties is projective. -/
private theorem isProjectiveMorphism_of_isProjectiveVariety {W V : Scheme.{0}}
    {sW : W ⟶ Spec (.of ℂ)} {sV : V ⟶ Spec (.of ℂ)} (hW : MMP.Mori.IsProjectiveVariety ℂ sW)
    (hV : MMP.Mori.IsProjectiveVariety ℂ sV) (q : W ⟶ V) (hq : q ≫ sV = sW) :
    IsProjectiveMorphism q :=
  haveI : IsSeparated sV := hV.toIsSeparated
  IsProjectiveMorphism.of_comp q sV (hq ▸ hW.isProjective)

/-- Under the invariants, the lowered boundary `B₁ - t T₁` is effective for `t ≤ 1`. -/
private theorem FloorInv.coeff_sub_smul_nonneg {X₁ Z : Scheme.{0}} [IsIntegral X₁]
    [CompactSpace X₁] [IsLocallyNoetherian X₁] [IsNormal X₁] {s₁ : X₁ ⟶ Spec (.of ℂ)}
    {π₁ : X₁ ⟶ Z} {m : ℕ} {t₀ : ℚ} {K₁ : Divisor X₁} {B₁ T₁ : QDivisor X₁} {Δ₁ : RDivisor X₁}
    (h : FloorInv s₁ π₁ m t₀ K₁ B₁ T₁ Δ₁) {t : ℚ} (ht : t ≤ 1) (P : MMP.Mori.PrimeDivisor X₁) :
    0 ≤ (B₁ - t • T₁).coeff P := by
  have h1 := h.floor_nonneg P
  have h2 := (h.coeff_bounds P).1
  simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2 ⊢
  nlinarith

section KltConvex

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- For a pair `(X, Δ)`, a canonical divisor `K = div(ω)` and a divisor `(Y, f, E)` over `X`,
`m(K + Δ)` is a Cartier divisor `M` with a pull-back `M'` to `Y`, for some `m > 0`. -/
private theorem exists_cartier_presentation [PerfectField k] {Δ : QDivisor X}
    (hP : MMP.Mori.IsPair sX Δ) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    (D : DivisorOver k sX) :
    haveI := D.isLocallyNoetherian
    haveI := D.isNormal
    ∃ (m : ℕ) (M : Divisor X) (M' : Divisor D.Y), 0 < m ∧ M.IsCartier ∧
      (∀ Γ, (M.coeff Γ : ℝ) = m * (K.coeff Γ + Δ.coeff Γ)) ∧
      ∃ hC, M.IsPullback D.f hC M' := by
  obtain ⟨-, -, -, m, hm, ⟨M, hM, hMc⟩, -⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have : CompactSpace D.Y := by
    have := D.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (D.f ≫ sX)
  obtain ⟨M', hM'⟩ := MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f hMc
  refine ⟨m, M, M', hm, hMc, fun Γ => ?_, _, hM'⟩
  have := congrArg (fun G : QDivisor X => G.coeff Γ) hM
  simp only [Divisor.coeff_toQDivisor, smul_add, natCast_zsmul, DivisorWithCoeffs.coeff_add,
    DivisorWithCoeffs.coeff_smul, nsmul_eq_mul] at this
  exact_mod_cast (by linear_combination this : (M.coeff Γ : ℚ) = m * (K.coeff Γ + Δ.coeff Γ))

/-- **The log discrepancy is affine in the boundary.** Fix a nonzero rational top form `ω`
with `K = div(ω)` and a divisor `E` over `X`. If `K + Bᵢ = (1 / mᵢ) Mᵢ` with `Mᵢ` Cartier, pulled
back to `M'ᵢ`, and `B = ∑ᵢ wᵢ Bᵢ` with `∑ᵢ wᵢ = 1`, then
`a(E, X, B) = ∑ᵢ wᵢ (1 + ord_E(f^*ω) - (1 / mᵢ) coeff_E(M'ᵢ))`, computed with the presentation
`K + B = ∑ᵢ (wᵢ / mᵢ) Mᵢ`. -/
private theorem isLogDiscrepancy_sum {n : ℕ} {D : DivisorOver k sX}
    (hX : MMP.Mori.IsNormalVariety k sX) (hf : IsProper D.f)
    {ω : MMP.Mori.RationalPluriForms sX n 1} (hω0 : ω ≠ 0) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (hKω : ∀ Γ, K.coeff Γ = Γ.ordForm ω)
    {ι : Type*} [Fintype ι] {w : ι → ℝ} (hw : ∑ i, w i = 1) {Bi : ι → RDivisor X}
    {B : RDivisor X} (hB : ∀ Γ, B.coeff Γ = ∑ i, w i * (Bi i).coeff Γ)
    {m : ι → ℕ} (hm : ∀ i, 0 < m i) {M : ι → Divisor X}
    {M' : haveI := D.isLocallyNoetherian; haveI := D.isNormal; ι → Divisor D.Y}
    (hMc : ∀ i, (M i).IsCartier)
    (hM : ∀ i Γ, ((M i).coeff Γ : ℝ) = m i * (K.coeff Γ + (Bi i).coeff Γ))
    (hpb : haveI := D.isLocallyNoetherian; haveI := D.isNormal;
      ∀ i, ∃ hC, (M i).IsPullback D.f hC (M' i)) :
    haveI := D.isLocallyNoetherian
    haveI := D.isNormal
    MMP.Intersection.IsLogDiscrepancy sX n B D
      (∑ i, w i * (1 + (D.ordPullback ω : ℝ) - (1 / (m i : ℝ)) * (M' i).coeff D.E)) := by
  have hm0 i : (m i : ℝ) ≠ 0 := by exact_mod_cast (hm i).ne'
  let e := Fintype.equivFin ι
  refine ⟨hX, hf, ω, hω0, ⟨K, hK, hKω⟩, Fintype.card ι, fun j => w (e.symm j) / m (e.symm j),
    fun j => M (e.symm j), fun j => M' (e.symm j), fun _ => hMc _, fun Γ => ?_, fun _ => hpb _, ?_⟩
  · dsimp only
    rw [Equiv.sum_comp e.symm (fun i => w i / m i * ((M i).coeff Γ : ℝ)), hB, ← hKω]
    have h i : w i / m i * ((M i).coeff Γ : ℝ) = w i * K.coeff Γ + w i * (Bi i).coeff Γ := by
      rw [hM]; field_simp [hm0 i]
    simp [h, Finset.sum_add_distrib, ← Finset.sum_mul, hw]
  · dsimp only
    rw [Equiv.sum_comp e.symm (fun i => w i / m i * ((M' i).coeff D.E : ℝ))]
    simp_rw [mul_sub, mul_add, Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.sum_mul,
      hw, mul_one, one_mul, ← mul_assoc, mul_one_div]

end KltConvex

/-- The invariants hold on the starting model. -/
private theorem floorInv_zero {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {g : X ⟶ Z}
    (hQ : IsQFactorial sX) {K : Divisor X} (hK : K.IsCanonicalDivisor sX 3) {B : QDivisor X}
    (hB : MMP.Intersection.IsDltPair sX B) {m : ℕ}
    (hmD : ((m : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor) {t₀ : ℚ}
    (hD : QDivisor.IsRelativelyNef sX g (Divisor.toQDivisor K + B))
    (hD' : QDivisor.IsRelativelyNef sX g (-(Divisor.toQDivisor K + B))) :
    FloorInv sX g m t₀ K B (Divisor.toQDivisor B.roundDown)
      (QDivisor.toRDivisor (B - t₀ • Divisor.toQDivisor B.roundDown)) := by
  obtain ⟨Dm, hDm, hDmc⟩ := hmD
  have hcoeff : ∀ P, (Divisor.toQDivisor B.roundDown).coeff P = ⌊B.coeff P⌋ := fun P => by simp
  refine ⟨⟨Dm, hDmc, hDm⟩, hK, hD, hD', ?_, hB.1, fun P => ?_, fun P => ?_, fun P => ?_, rfl⟩
  · simpa using isKltPair_sub_smul_roundDown hQ hB one_pos le_rfl
  · rw [hcoeff]; exact_mod_cast Int.floor_nonneg.mpr (hB.1.2.1 P)
  · simp only [DivisorWithCoeffs.coeff_sub, hcoeff]
    exact ⟨sub_nonneg.mpr (Int.floor_le _), Int.fract_lt_one (B.coeff P), hB.2.1 P⟩
  · rw [hcoeff]
    rcases eq_or_lt_of_le (hB.2.1 P) with h | h
    · right; rw [h]; simp
    · left; rw [Int.floor_eq_zero_iff.mpr ⟨hB.1.2.1 P, h⟩]; simp

/-! ### The ray of a negative extremal contraction -/

/-- Numerical classes of curves are separated by the degrees of invertible sheaves. -/
private theorem numericalCurveClasses_ext {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) {z z' : NumericalCurveClasses sX}
    (h : ∀ (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L],
      NumericalCurveClasses.degree sX L z = NumericalCurveClasses.degree sX L z') : z = z' := by
  obtain ⟨Z, rfl⟩ := OneCycle.numericalClass_surjective sX z
  obtain ⟨Z', rfl⟩ := OneCycle.numericalClass_surjective sX z'
  rw [← sub_eq_zero, ← map_sub]
  refine (Submodule.Quotient.mk_eq_zero _).mpr (OneCycle.mem_numericallyTrivial.mpr fun L _ => ?_)
  have := h L
  simp only [NumericalCurveClasses.degree_numericalClass] at this
  rw [map_sub, this, sub_self]

/-- An `f`-ample Cartier divisor has an `f`-ample divisorial sheaf. -/
private theorem isRelativelyAmple_divisorialSheaf {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ W} {L : Divisor X}
    (hL : MMP.Flips.IsRelativelyAmpleCartier f L) :
    haveI := hL.1.isInvertibleModule_divisorialSheaf
    MMP.Mori.IsRelativelyAmple f L.divisorialSheaf := by
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
  exact ⟨V, hV, hyV, hL.2 V hV⟩

/-- An `f`-ample Cartier divisor has positive degree on every curve contracted by `f`. -/
private theorem degreeOn_pos_of_isRelativelyAmpleCartier {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {f : X ⟶ W} {L : Divisor X} (hL : MMP.Flips.IsRelativelyAmpleCartier f L)
    (C : ProperCurve sX) (hC : C.IsContractedBy f) : 0 < L.degreeOn ℂ sX C.ι C.dim_le hL.1 :=
  haveI := hL.1.isInvertibleModule_divisorialSheaf
  MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy f _
    (isRelativelyAmple_divisorialSheaf hL) C hC

/-- **The curves contracted by a negative extremal contraction span one ray.** If `f : X ⟶ W` is
an `E`-negative extremal contraction (`ρ(X/W) = 1`, `-E` `f`-ample), then some curve `C₀`
contracted by `f` has nonzero class, and the class of every curve contracted by `f` is a positive
multiple of `[C₀]`. -/
private theorem exists_ray_of_isNegativeExtremalContraction {X W : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)} {E : RDivisor X} {f : X ⟶ W}
    (hneg : IsNegativeExtremalContraction ℂ sX sW E f) :
    ∃ C₀ : ProperCurve sX, C₀.IsContractedBy f ∧
      OneCycle.numericalClass sX (C₀.cycle ℝ) ≠ 0 ∧
      ∀ C : ProperCurve sX, C.IsContractedBy f →
        ∃ c : ℝ, 0 < c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) =
          OneCycle.numericalClass sX (C.cycle ℝ) := by
  classical
  obtain ⟨m, r, L, hm1, -, hL, -⟩ := hneg.isRelativelyAntiAmple
  haveI := (hL ⟨0, hm1⟩).1.isInvertibleModule_divisorialSheaf
  obtain ⟨A', ⟨eA⟩⟩ :=
    MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf (L ⟨0, hm1⟩).divisorialSheaf
  -- `A'` has positive degree on every contracted curve
  have hpos : ∀ C : ProperCurve sX, C.IsContractedBy f →
      0 < C.degree ℂ (MMP.CartierDivisor.sheaf A') := by
    intro C hC
    have := degreeOn_pos_of_isRelativelyAmpleCartier (hL ⟨0, hm1⟩) C hC
    rwa [Divisor.degreeOn, degreeOn_eq_of_iso ℂ sX C.ι C.dim_le eA] at this
  -- `(Z · 1 · E) = deg_Z 𝒪_X(E)` on the cycle of a curve
  have hdeg : ∀ (C : ProperCurve sX) (D : X.CartierDivisor),
      (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ D) =
        (C.degree ℂ (MMP.CartierDivisor.sheaf D) : ℝ) := by
    intro C D
    rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]
  -- the relative Néron–Severi space `N¹(X/W)` is a line
  set V := MMP.Flips.RelativeNumericalDivisorClasses sX f
  have hrank : Module.rank ℝ V = 1 := by
    have h := hneg.relativePicardNumber_eq_one
    rw [MMP.Flips.relativePicardNumber] at h
    exact Cardinal.toENat_eq_one.mp h
  have hfin : Module.finrank ℝ V = 1 := Module.finrank_eq_of_rank_eq (by rw [hrank]; rfl)
  haveI : Nontrivial V := Module.nontrivial_of_finrank_eq_succ hfin
  -- a contracted curve on which some Cartier divisor is nonzero
  obtain ⟨b, hb⟩ := exists_ne (0 : V)
  obtain ⟨D, rfl⟩ := Submodule.Quotient.mk_surjective _ b
  have hD : D ∉ MMP.Flips.relativeNumericallyTrivialDivisors sX f := fun h =>
    hb ((Submodule.Quotient.mk_eq_zero _).mpr h)
  rw [MMP.Flips.mem_relativeNumericallyTrivialDivisors] at hD
  push Not at hD
  obtain ⟨C₀, hC₀, -⟩ := hD
  -- the class of `A'` spans `N¹(X/W)`
  set a : V := Submodule.Quotient.mk (KCartierDivisor.ofCartier ℝ A')
  have ha : a ≠ 0 := by
    intro h
    have h' := (MMP.Flips.mem_relativeNumericallyTrivialDivisors sX f).mp
      ((Submodule.Quotient.mk_eq_zero _).mp h) C₀ hC₀
    rw [hdeg] at h'
    exact (hpos C₀ hC₀).ne' (by exact_mod_cast h')
  have hspan := (finrank_eq_one_iff_of_nonzero' a ha).mp hfin
  -- every Cartier divisor is numerically a multiple of `A'` over `W`
  have hmul : ∀ D : X.CartierDivisor, ∃ μ : ℝ, ∀ C : ProperCurve sX, C.IsContractedBy f →
      (C.degree ℂ (MMP.CartierDivisor.sheaf D) : ℝ) =
        μ * C.degree ℂ (MMP.CartierDivisor.sheaf A') := by
    intro D
    obtain ⟨μ, hμ⟩ := hspan (Submodule.Quotient.mk (KCartierDivisor.ofCartier ℝ D))
    refine ⟨μ, fun C hC => ?_⟩
    have hmem : KCartierDivisor.ofCartier ℝ D - μ • KCartierDivisor.ofCartier ℝ A' ∈
        MMP.Flips.relativeNumericallyTrivialDivisors sX f := by
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub,
        Submodule.Quotient.mk_smul, ← hμ, sub_self]
    have h := (MMP.Flips.mem_relativeNumericallyTrivialDivisors sX f).mp hmem C hC
    rw [OneCycle.intersectionNumber, map_sub, map_smul, LinearMap.sub_apply,
      LinearMap.smul_apply, ← OneCycle.intersectionNumber, ← OneCycle.intersectionNumber,
      hdeg, hdeg, smul_eq_mul, sub_eq_zero] at h
    exact h
  have hC₀pos := hpos C₀ hC₀
  refine ⟨C₀, hC₀, fun h0 => ?_, fun C hC => ?_⟩
  · have := congrArg (NumericalCurveClasses.degree sX (MMP.CartierDivisor.sheaf A'))
      h0
    rw [map_zero, NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle] at this
    exact hC₀pos.ne' (by exact_mod_cast this)
  · have hCpos := hpos C hC
    refine ⟨(C.degree ℂ (MMP.CartierDivisor.sheaf A') : ℝ) /
      C₀.degree ℂ (MMP.CartierDivisor.sheaf A'), by positivity, ?_⟩
    refine numericalCurveClasses_ext sX fun M _ => ?_
    obtain ⟨D, ⟨e⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf M
    obtain ⟨μ, hμ⟩ := hmul D
    rw [map_smul, NumericalCurveClasses.degree_numericalClass,
      NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
      OneCycle.degree_cycle, smul_eq_mul]
    have e₀ : C₀.degree ℂ M = C₀.degree ℂ (MMP.CartierDivisor.sheaf D) :=
      degreeOn_eq_of_iso ℂ sX C₀.ι C₀.dim_le e
    have e₁ : C.degree ℂ M = C.degree ℂ (MMP.CartierDivisor.sheaf D) :=
      degreeOn_eq_of_iso ℂ sX C.ι C.dim_le e
    rw [e₀, e₁, hμ C₀ hC₀, hμ C hC]
    have : (C₀.degree ℂ (MMP.CartierDivisor.sheaf A') : ℝ) ≠ 0 := by
      exact_mod_cast hC₀pos.ne'
    field_simp

/-! ### Relative and absolute classes -/

section Natural

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} {f : X ⟶ Y}

private theorem degree_relativeToAbsolute (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (z : RelativeNumericalCurveClasses sX f) :
    NumericalCurveClasses.degree sX L (relativeToAbsolute sX f z) =
      RelativeNumericalCurveClasses.degree sX f L z := by
  obtain ⟨Z, rfl⟩ := relativeNumericalClass_surjective sX f z
  rfl

private theorem continuous_relativeToAbsolute : Continuous (relativeToAbsolute sX f) :=
  continuous_iInf_rng.2 fun L => continuous_iInf_rng.2 fun h => continuous_induced_rng.2 <| by
    have := h
    have he : ⇑(NumericalCurveClasses.degree sX L) ∘ ⇑(relativeToAbsolute sX f) =
        RelativeNumericalCurveClasses.degree sX f L :=
      funext (degree_relativeToAbsolute L)
    rw [he]
    exact RelativeNumericalCurveClasses.continuous_degree sX f L

private theorem relativeToAbsolute_mem_coneOfCurves {z : RelativeNumericalCurveClasses sX f}
    (hz : z ∈ relativeConeOfCurves sX f) : relativeToAbsolute sX f z ∈ coneOfCurves sX := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨C, hC⟩, rfl⟩ := hx
    exact numericalClass_cycle_mem_coneOfCurves sX C
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x _ hx =>
    rw [show a • x = (a : ℝ) • x from rfl, map_smul]
    exact (coneOfCurves sX).smul_mem a.2 hx

private theorem relativeToAbsolute_mem_closedConeOfCurves {z : RelativeNumericalCurveClasses sX f}
    (hz : z ∈ relativeClosedConeOfCurves sX f) :
    relativeToAbsolute sX f z ∈ closedConeOfCurves sX :=
  closure_mono (Set.image_subset_iff.2 fun _ hw => relativeToAbsolute_mem_coneOfCurves hw)
    (image_closure_subset_closure_image continuous_relativeToAbsolute ⟨z, hz, rfl⟩)

/-- The natural map `N₁(X/Y) → N₁(X)` is injective. -/
private theorem relativeToAbsolute_injective : Function.Injective (relativeToAbsolute sX f) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro z hz
  obtain ⟨Z, rfl⟩ := relativeNumericalClass_surjective sX f z
  exact (Submodule.Quotient.mk_eq_zero _).mpr
    (mem_relativeNumericallyTrivial.mpr ((Submodule.Quotient.mk_eq_zero _).mp hz))

end Natural

variable {k : Type} [Field k] {X : Scheme.{0}} in
/-- A ray `ℝ_{≥0} · v`, `v ≠ 0`, is closed in `N₁(X)` for the numerical topology. -/
private theorem isClosed_ray (sX : X ⟶ Spec (.of k)) {v : NumericalCurveClasses sX}
    (hv : v ≠ 0) : IsClosed {w : NumericalCurveClasses sX | ∃ c : ℝ, 0 ≤ c ∧ c • v = w} := by
  obtain ⟨L₀, hL₀, hv₀⟩ : ∃ (L₀ : X.Modules) (_ : SheafOfModules.IsInvertible X.presheaf
      X.ringCatSheaf.2 L₀), NumericalCurveClasses.degree sX L₀ v ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hv (numericalCurveClasses_ext sX fun L _ => by rw [hcon L, map_zero])
  set a := NumericalCurveClasses.degree sX L₀ v
  have hS : {w : NumericalCurveClasses sX | ∃ c : ℝ, 0 ≤ c ∧ c • v = w} =
      {w | 0 ≤ NumericalCurveClasses.degree sX L₀ w / a} ∩
        ⋂ (L : X.Modules) (h : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L),
          {w | NumericalCurveClasses.degree sX L w =
            NumericalCurveClasses.degree sX L₀ w / a * NumericalCurveClasses.degree sX L v} := by
    ext w
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
    constructor
    · rintro ⟨c, hc, rfl⟩
      have hca : NumericalCurveClasses.degree sX L₀ (c • v) / a = c := by
        rw [map_smul, smul_eq_mul, mul_div_assoc, div_self hv₀, mul_one]
      refine ⟨by rw [hca]; exact hc, fun L _ => ?_⟩
      rw [hca, map_smul, smul_eq_mul]
    · rintro ⟨hc, hL⟩
      refine ⟨_, hc, numericalCurveClasses_ext sX fun L _ => ?_⟩
      rw [map_smul, smul_eq_mul, hL L]
  rw [hS]
  have hc₀ := NumericalCurveClasses.continuous_degree sX L₀
  refine (isClosed_le continuous_const (hc₀.div_const a)).inter
    (isClosed_iInter fun L => isClosed_iInter fun h => ?_)
  have hc := NumericalCurveClasses.continuous_degree sX L
  exact isClosed_eq hc ((hc₀.div_const a).mul continuous_const)

variable {k : Type} [Field k] {X Y : Scheme.{0}} in
/-- If every curve contracted by `f` has its class on the ray `ℝ≥0 · v`, then so does the image
in `N₁(X)` of every class of the closed relative cone `NE̅(X/Y)`. -/
private theorem relativeToAbsolute_mem_ray (sX : X ⟶ Spec (.of k)) (f : X ⟶ Y)
    {v : NumericalCurveClasses sX} (hv : v ≠ 0)
    (hcontr : ∀ C : ProperCurve sX, C.IsContractedBy f →
      ∃ c : ℝ, 0 ≤ c ∧ c • v = OneCycle.numericalClass sX (C.cycle ℝ))
    {z : RelativeNumericalCurveClasses sX f} (hz : z ∈ relativeClosedConeOfCurves sX f) :
    ∃ c : ℝ, 0 ≤ c ∧ c • v = relativeToAbsolute sX f z := by
  set ι := relativeToAbsolute sX f
  have hsub : (relativeConeOfCurves sX f : Set _) ⊆ ι ⁻¹' {w | ∃ c : ℝ, 0 ≤ c ∧ c • v = w} := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨C, hC⟩, rfl⟩ := hx
      exact hcontr C hC
    | zero => exact ⟨0, le_rfl, by rw [zero_smul, map_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨c, hc, hcx⟩ := hx
      obtain ⟨c', hc', hcy⟩ := hy
      exact ⟨c + c', add_nonneg hc hc', by rw [add_smul, hcx, hcy, map_add]⟩
    | smul a x _ hx =>
      obtain ⟨c, hc, hcx⟩ := hx
      exact ⟨a * c, mul_nonneg a.2 hc, by rw [mul_smul, hcx]; exact (map_smul ι (a : ℝ) x).symm⟩
  exact closure_minimal hsub
    ((isClosed_ray sX hv).preimage continuous_relativeToAbsolute) hz

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} in
/-- Every proper curve has a normalization, a curve of dimension at most one. -/
private theorem exists_curveNormalization (C : ProperCurve sX) :
    ∃ (N : Scheme.{0}) (ν : N ⟶ C.scheme) (_ : IsCurveNormalization ν),
      topologicalKrullDim N ≤ 1 := by
  let p := C.ι ≫ sX
  haveI : AlgebraicGeometry.IsCurve k p := C.isCurve
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k p
  haveI hvar : AlgebraicGeometry.IsVariety k (normalizationOverField k p ≫ p) :=
    isVariety_normalizationOverField k p
  haveI : IsIntegral (normalizationSchemeOverField k p) := hvar.toIsIntegral
  haveI : IsFinite (normalizationOverField k p) := isFinite_normalizationOverField k p
  have hν : IsCurveNormalization (normalizationOverField k p) :=
    { isIntegral := inferInstance
      isNormal := Scheme.isNormal_normalizationScheme C.scheme hX
      isFinite := inferInstance
      isBirationalMorphism := by
        haveI : Finite (irreducibleComponents (normalizationSchemeOverField k p)) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        haveI : Finite (irreducibleComponents C.scheme) := by
          rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
        obtain ⟨U, V, hUV, hU, hV, hiso⟩ := exists_dense_opens_isIso_resLE_of_isBirational
          (normalizationOverField k p) (Scheme.isBirational_normalization C.scheme hX)
          (Or.inl ⟨inferInstance, inferInstance⟩)
        exact isBirationalMorphism_of_isIso_resLE _ U V hU.nonempty hV.nonempty hUV hiso }
  exact ⟨_, _, hν, (topologicalKrullDim_normalizationSchemeOverField k p).le.trans C.dim_le⟩

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X] in
/-- `L · C` is the degree of `𝒪_X(L)` along `C`. -/
private theorem isCartierIntersectionNumber_degreeOn (C : ProperCurve sX) (L : Divisor X)
    (hL : L.IsCartier) :
    MMP.Flips.IsCartierIntersectionNumber k sX C L hL (L.degreeOn k sX C.ι C.dim_le hL) := by
  obtain ⟨N, ν, hν, hdim⟩ := exists_curveNormalization C
  refine ⟨N, ν, hν, hdim, ?_⟩
  have := hν.isFinite
  haveI : IsProper ((ν ≫ C.ι) ≫ sX) := by rw [Category.assoc]; infer_instance
  have := QuasiCompact.compactSpace_of_compactSpace sX
  have := hL.isInvertibleModule_divisorialSheaf
  exact (MMP.Fourfold.Oai4C1.Negativity.degreeOn_normalization C hν hdim _).symm

/-- A `ℚ`-divisor `D` with `Dm = m D` is `(1 / m) Dm` as an `ℝ`-divisor. -/
private theorem toRDivisor_eq_sum_of_toQDivisor_eq {X : Scheme.{0}} {D : QDivisor X}
    {Dm : Divisor X} {m : ℕ} (hm : 0 < m) (h : Divisor.toQDivisor Dm = (m : ℤ) • D) :
    QDivisor.toRDivisor D = ∑ _j : Fin 1, ((m : ℝ)⁻¹) • Divisor.toRDivisor Dm := by
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  rw [Fin.sum_univ_one]
  ext P
  have := congrArg (fun T : QDivisor X => T.coeff P) h
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
    Int.cast_natCast] at this
  simp only [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor,
    smul_eq_mul]
  rw [show ((Dm.coeff P : ℤ) : ℝ) = (((Dm.coeff P : ℤ) : ℚ) : ℝ) by push_cast; rfl, this]
  push_cast
  field_simp

/-- The intersection number of a `ℚ`-Cartier divisor `D` with `-toRDivisor D` `f`-ample is
negative on every curve contracted by `f`. -/
private theorem intersectionNumber_neg_of_isRelativelyAntiAmple {X W : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX] {f : X ⟶ W} {D : QDivisor X} (hD : D.IsQCartier)
    (hamp : MMP.Flips.IsRelativelyAntiAmple f (QDivisor.toRDivisor D)) (C : ProperCurve sX)
    (hC : C.IsContractedBy f) : D.intersectionNumber ℂ sX C.ι C.dim_le hD < 0 := by
  obtain ⟨m, r, L, hm1, hr, hL, hE⟩ := hamp
  have hLc : ∀ j, (L j).IsCartier := fun j => (hL j).1
  -- the value `∑ rⱼ deg_C Lⱼ` of `(-D) · C` is positive
  have hpos : ∀ j, 0 < (L j).degreeOn ℂ sX C.ι C.dim_le (hLc j) := fun j =>
    degreeOn_pos_of_isRelativelyAmpleCartier (hL j) C hC
  have hsum : 0 < ∑ j, r j * ((L j).degreeOn ℂ sX C.ι C.dim_le (hLc j) : ℝ) := by
    haveI : Nonempty (Fin m) := ⟨⟨0, hm1⟩⟩
    exact Finset.sum_pos (fun j _ => mul_pos (hr j) (by exact_mod_cast hpos j))
      Finset.univ_nonempty
  -- two presentations of `-D`
  set hF := QDivisor.isCartierDivisor_cartierIndex_smul hD
  set N := D.cartierIndex hD
  have hpres : -QDivisor.toRDivisor D =
      ∑ _j : Fin 1, (-(N : ℝ)⁻¹) • Divisor.toRDivisor hF.toDivisor := by
    rw [toRDivisor_eq_sum_of_toQDivisor_eq (QDivisor.cartierIndex_pos hD) hF.toQDivisor_toDivisor]
    simp only [Fin.sum_univ_one, neg_smul]
    rfl
  have h1 : MMP.Flips.IsRIntersectionNumber ℂ sX (-QDivisor.toRDivisor D) r L C
      (∑ j, r j * ((L j).degreeOn ℂ sX C.ι C.dim_le (hLc j) : ℝ)) :=
    ⟨hLc, fun j => (L j).degreeOn ℂ sX C.ι C.dim_le (hLc j), hE,
      fun j => isCartierIntersectionNumber_degreeOn C (L j) (hLc j), rfl⟩
  have h2 : MMP.Flips.IsRIntersectionNumber ℂ sX (-QDivisor.toRDivisor D)
      (fun _ : Fin 1 => -(N : ℝ)⁻¹) (fun _ : Fin 1 => hF.toDivisor) C
      (-(D.intersectionNumber ℂ sX C.ι C.dim_le hD : ℝ)) := by
    refine ⟨fun _ => hF.isCartier_toDivisor, fun _ => hF.toDivisor.degreeOn ℂ sX C.ι C.dim_le
      hF.isCartier_toDivisor, hpres,
      fun _ => isCartierIntersectionNumber_degreeOn C _ hF.isCartier_toDivisor, ?_⟩
    simp only [Fin.sum_univ_one, QDivisor.intersectionNumber]
    push_cast
    ring
  have := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ sX C).1 _ r L _ _ _ _ h1 h2
  have h3 : (D.intersectionNumber ℂ sX C.ι C.dim_le hD : ℝ) < 0 := by linarith
  exact_mod_cast h3

variable {X : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} in
/-- On `N₁(X/S)` the curve form is the absolute one composed with the natural map
`N₁(X/S) → N₁(X)`. -/
private theorem relativeCurveForm_eq_comp {S : Scheme.{0}} (f : X ⟶ S) (D : QDivisor X)
    (h : D.IsQCartier) :
    QDivisor.relativeCurveForm sX f D h =
      QDivisor.curveForm sX D h ∘ₗ relativeToAbsolute sX f := by
  refine Submodule.linearMap_qext _ (LinearMap.ext fun Z => ?_)
  simp only [QDivisor.relativeCurveForm, QDivisor.curveForm, Finsupp.sum, LinearMap.comp_apply,
    LinearMap.sum_apply, LinearMap.smul_apply]
  exact Finset.sum_congr rfl fun _ _ => rfl

/-- **The contraction of a negative extremal contraction over `Z` is the contraction of a
negative extremal ray of `NE̅(X/Z)`.** Let `f : X ⟶ W` be a `D`-negative extremal contraction of
projective varieties, with `W ⟶ Z` and `X` `ℚ`-factorial. Then the classes of the curves
contracted by `f` span an extremal ray `R` of `NE̅(X/Z)` which is `D`-negative, `f` is its
contraction over `Z`, and the image of `R` in `N₁(X)` is an extremal ray of `NE̅(X)` whose
contraction is `f`. -/
private theorem exists_isNegativeRelativeRayContraction {X W Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hW : MMP.Mori.IsProjectiveVariety ℂ sW) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (hQ : IsQFactorial sX) {f : X ⟶ W} {gW : W ⟶ Z} {π : X ⟶ Z} (hfg : f ≫ gW = π)
    (hgW : gW ≫ sZ = sW) {D : QDivisor X}
    (hneg : IsNegativeExtremalContraction ℂ sX sW (QDivisor.toRDivisor D) f) :
    ∃ R : Set (RelativeNumericalCurveClasses sX π),
      IsNegativeRelativeRayContraction sX π sW D R f gW ∧
      IsContractionOfFace ℂ sX sW (relativeToAbsolute sX π '' R) f ∧
      IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
        (relativeToAbsolute sX π '' R) ∧
      ∃ C₀ : ProperCurve sX, C₀.IsContractedBy f ∧ relativeToAbsolute sX π '' R =
        {w | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) = w} := by
  classical
  have hfW : f ≫ sW = sX := hneg.isContraction.comp_eq
  obtain ⟨C₀, hC₀, hne, hray⟩ := exists_ray_of_isNegativeExtremalContraction hneg
  set v₀ := OneCycle.numericalClass sX (C₀.cycle ℝ) with hv₀
  have hC₀π : C₀.IsContractedBy π := fun x hx => by
    rw [← hfg, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC₀ x hx]
  -- an ample invertible sheaf on `W`, whose pull-back detects the curves contracted by `f`
  obtain ⟨H, _, hH⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety hW
  haveI : IsSeparated sW := hW.toIsSeparated
  haveI : LocallyOfFiniteType sW := hW.toIsVariety.toLocallyOfFiniteType
  have hkey : ∀ C : ProperCurve sX, C.IsContractedBy f ↔
      ∃ c : ℝ, 0 ≤ c ∧ c • v₀ = OneCycle.numericalClass sX (C.cycle ℝ) := by
    intro C
    refine ⟨fun hC => (hray C hC).imp fun c hc => ⟨hc.1.le, hc.2⟩, fun ⟨c, _, hc⟩ => ?_⟩
    refine MMP.ProgramBaseChange.isContractedBy_of_degree_pullback_eq_zero f hfW H hH C ?_
    have h0 := MMP.Mori.ProperCurve.degree_pullback_eq_zero_of_isContractedBy f hfW C₀ hC₀ H
    have := congrArg (NumericalCurveClasses.degree sX ((Scheme.Modules.pullback f).obj H)) hc
    rw [map_smul, NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
      NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle, h0] at this
    simp only [Int.cast_zero, smul_zero] at this
    exact_mod_cast this.symm
  -- the closed relative cone of `f` is the ray of `[C₀]`
  set vW := C₀.relativeClass f hC₀
  have hvW : relativeToAbsolute sX f vW = v₀ := rfl
  set RW := {w : RelativeNumericalCurveClasses sX f | ∃ c : ℝ, 0 ≤ c ∧ c • vW = w}
  have hNEW : (relativeClosedConeOfCurves sX f : Set _) = RW := by
    ext z
    refine ⟨fun hz => ?_, ?_⟩
    · obtain ⟨c, hc, hcz⟩ := relativeToAbsolute_mem_ray sX f hne (fun C hC => (hkey C).mp hC) hz
      exact ⟨c, hc, relativeToAbsolute_injective (by rw [map_smul, hvW, hcz])⟩
    · rintro ⟨c, hc, rfl⟩
      exact (relativeClosedConeOfCurves sX f).smul_mem hc
        (subset_closure (relativeClass_mem_relativeConeOfCurves hC₀))
  have hvW0 : vW ≠ 0 := fun h => hne (by rw [← hvW, h, map_zero])
  have hrayW : IsExtremalRay ℝ (relativeClosedConeOfCurves sX f : Set _) RW := by
    rw [hNEW]
    refine ⟨⟨subset_rfl, ⟨⟨0, le_rfl, zero_smul _ _⟩, ?_⟩, ?_, fun u hu w hw _ => ⟨hu, hw⟩⟩,
      vW, hvW0, rfl⟩
    · rintro _ ⟨c, hc, rfl⟩ a ha
      exact ⟨a * c, mul_nonneg ha.le hc, mul_smul _ _ _⟩
    · rintro _ ⟨c, hc, rfl⟩ _ ⟨c', hc', rfl⟩
      exact ⟨c + c', add_nonneg hc hc', add_smul _ _ _⟩
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sW := hW
  have hrayX := isExtremalRay_image_relativeToAbsolute sX sW f hfW hrayW
  set ray := {w : NumericalCurveClasses sX | ∃ c : ℝ, 0 ≤ c ∧ c • v₀ = w}
  have himW : relativeToAbsolute sX f '' RW = ray := by
    ext w
    constructor
    · rintro ⟨_, ⟨c, hc, rfl⟩, rfl⟩
      exact ⟨c, hc, by rw [map_smul, hvW]⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨c • vW, ⟨c, hc, rfl⟩, by rw [map_smul, hvW]⟩
  rw [himW] at hrayX
  -- the ray over `Z`
  set v := C₀.relativeClass π hC₀π
  have hv : relativeToAbsolute sX π v = v₀ := rfl
  set R := {w : RelativeNumericalCurveClasses sX π | ∃ c : ℝ, 0 ≤ c ∧ c • v = w}
  have hmemR : ∀ w, w ∈ R ↔ relativeToAbsolute sX π w ∈ ray := by
    intro w
    constructor
    · rintro ⟨c, hc, rfl⟩
      exact ⟨c, hc, by rw [map_smul, hv]⟩
    · rintro ⟨c, hc, hcw⟩
      exact ⟨c, hc, relativeToAbsolute_injective (by rw [map_smul, hv, hcw])⟩
  have himR : relativeToAbsolute sX π '' R = ray := by
    ext w
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact (hmemR u).mp hu
    · rintro ⟨c, hc, rfl⟩
      exact ⟨c • v, ⟨c, hc, rfl⟩, by rw [map_smul, hv]⟩
  have hv0 : v ≠ 0 := fun h => hne (by rw [← hv, h, map_zero])
  have hRray : IsExtremalRay ℝ (relativeClosedConeOfCurves sX π : Set _) R := by
    refine ⟨⟨?_, ⟨⟨0, le_rfl, zero_smul _ _⟩, ?_⟩, ?_, ?_⟩, v, hv0, rfl⟩
    · rintro _ ⟨c, hc, rfl⟩
      exact (relativeClosedConeOfCurves sX π).smul_mem hc
        (subset_closure (relativeClass_mem_relativeConeOfCurves hC₀π))
    · rintro _ ⟨c, hc, rfl⟩ a ha
      exact ⟨a * c, mul_nonneg ha.le hc, mul_smul _ _ _⟩
    · rintro _ ⟨c, hc, rfl⟩ _ ⟨c', hc', rfl⟩
      exact ⟨c + c', add_nonneg hc hc', add_smul _ _ _⟩
    · intro u hu w hw huw
      rw [hmemR, map_add] at huw
      obtain ⟨h1, h2⟩ := hrayX.1.2.2.2 _ (relativeToAbsolute_mem_closedConeOfCurves hu) _
        (relativeToAbsolute_mem_closedConeOfCurves hw) huw
      exact ⟨(hmemR u).mpr h1, (hmemR w).mpr h2⟩
  refine ⟨R, ⟨⟨isQCartier_of_isQFactorial sX hQ D, hRray, fun u hu hu0 => ?_⟩,
    ⟨hRray.1, isProjectiveMorphism_of_isProjectiveVariety hW hZ gW hgW, hfg,
      hneg.isContraction.isIso_app, fun C hC => ?_⟩, hneg⟩,
    ⟨hX, hW, hfW, ?_, fun C => ?_, hneg.isContraction.isIso_app⟩, himR ▸ hrayX, C₀, hC₀, himR⟩
  · obtain ⟨c, hc, rfl⟩ := hu
    have hc0 : 0 < c := lt_of_le_of_ne hc (fun h => hu0 (by rw [← h, zero_smul]))
    rw [map_smul, smul_eq_mul, relativeCurveForm_eq_comp, LinearMap.comp_apply, hv,
      MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
    have := intersectionNumber_neg_of_isRelativelyAntiAmple (isQCartier_of_isQFactorial sX hQ D)
      hneg.isRelativelyAntiAmple C₀ hC₀
    exact mul_neg_of_pos_of_neg hc0 (by exact_mod_cast this)
  · rw [hmemR]
    exact hkey C
  · rw [himR]
    exact hrayX.1
  · rw [himR]
    exact hkey C

variable {k : Type} [Field k] {X : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] in
/-- Intersection numbers of adjoints `K + Δ` only depend on the linear equivalence class of
`K`. -/
private theorem intersectionNumber_add_eq_of_linearlyEquivalent {C : Scheme.{0}} (i : C ⟶ X)
    [IsProper (i ≫ sX)] (hdim : topologicalKrullDim C ≤ 1) {K₁ K₂ : Divisor X}
    (h : K₁.LinearlyEquivalent K₂) (Δ : QDivisor X) (h₁ : (Divisor.toQDivisor K₁ + Δ).IsQCartier)
    (h₂ : (Divisor.toQDivisor K₂ + Δ).IsQCartier) :
    (Divisor.toQDivisor K₁ + Δ).intersectionNumber k sX i hdim h₁ =
      (Divisor.toQDivisor K₂ + Δ).intersectionNumber k sX i hdim h₂ := by
  obtain ⟨D', hD', hD'c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul h₂
  set m := (Divisor.toQDivisor K₂ + Δ).cartierIndex h₂
  have hm := QDivisor.cartierIndex_pos h₂
  obtain ⟨φ, hφ⟩ := h
  set a : Additive (RationalFunctions X)ˣ := (m : ℤ) • Additive.ofMul φ with ha
  set G := D' + principalDivisorHom a with hG_def
  have hGc : G.IsCartier := hD'c.add (Divisor.isCartier_principalDivisor _)
  have hG : Divisor.toQDivisor G = (m : ℤ) • (Divisor.toQDivisor K₁ + Δ) := by
    have e : principalDivisorHom a = (m : ℤ) • (K₁ - K₂) := by
      rw [ha, map_zsmul, principalDivisorHom_apply, toMul_ofMul, hφ]
    rw [hG_def, e, map_add, hD', map_zsmul, map_sub, ← smul_add]
    congr 1
    abel
  have hGD : G.LinearlyEquivalent D' := ⟨a.toMul, by
    rw [hG_def, add_sub_cancel_left, principalDivisorHom_apply]⟩
  rw [QDivisor.intersectionNumber_eq_of_smul k sX i hdim _ h₁ hm G hGc hG,
    QDivisor.intersectionNumber_eq_of_smul k sX i hdim _ h₂ hm D' hD'c hD']
  congr 2
  have := hGc.isInvertibleModule_divisorialSheaf
  have := hD'c.isInvertibleModule_divisorialSheaf
  exact degreeOn_eq_of_iso k sX i hdim hGD.divisorialSheafIso

/-- **The steps are `D`-null.** Let `R` be the extremal ray of `NE̅(X/Z)` contracted by a
`(K + B - t₀ T)`-negative extremal contraction `f` of a `ℚ`-factorial projective threefold, where
`D = K + B` is numerically trivial over `Z` (`D` and `-D` are nef over `Z`) and `t₀ > 0`. Then
`D` is null on `R`, and `R` is `(K + B - T)`-negative. -/
private theorem exists_forall_relativeCurveForm_eq_zero {X W Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ : IsQFactorial sX)
    {f : X ⟶ W} {gW : W ⟶ Z} {π : X ⟶ Z} (hfg : f ≫ gW = π) {K KS : Divisor X}
    (hK : K.IsCanonicalDivisor sX 3) (hKS : ∃ n, KS.IsCanonicalDivisor sX n) {B T : QDivisor X}
    {t₀ : ℚ} (ht₀ : 0 < t₀)
    (hnef : QDivisor.IsRelativelyNef sX π (Divisor.toQDivisor K + B))
    (hnef' : QDivisor.IsRelativelyNef sX π (-(Divisor.toQDivisor K + B)))
    (hneg : IsNegativeExtremalContraction ℂ sX sW
      (QDivisor.toRDivisor (Divisor.toQDivisor KS + (B - t₀ • T))) f)
    {R : Set (RelativeNumericalCurveClasses sX π)}
    (hray : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
      (relativeToAbsolute sX π '' R))
    {C₀ : ProperCurve sX} (hC₀ : C₀.IsContractedBy f)
    (hR₀ : relativeToAbsolute sX π '' R =
      {w | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (C₀.cycle ℝ) = w}) :
    (∃ h : (Divisor.toQDivisor KS + B).IsQCartier,
      ∀ u ∈ R, QDivisor.relativeCurveForm sX π (Divisor.toQDivisor KS + B) h u = 0) ∧
    IsNegativeExtremalRayOf sX (Divisor.toQDivisor KS + (B - T)) (relativeToAbsolute sX π '' R) ∧
    ∀ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ relativeToAbsolute sX π '' R →
      haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
      (Divisor.toQDivisor K + B).intersectionNumber ℂ sX C.ι C.dim_le
        (isQCartier_of_isQFactorial sX hQ _) = 0 := by
  classical
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  have hXn : IsNormalVariety ℂ sX := hQ.1
  obtain ⟨n, hKSn⟩ := hKS
  have hn : n = 3 := by
    have h1 := hKSn.topologicalKrullDim_eq
    rw [hK.topologicalKrullDim_eq] at h1
    exact_mod_cast h1.symm
  subst hn
  have hlin : KS.LinearlyEquivalent K :=
    MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sX hXn hKSn hK
  have hq : ∀ D : QDivisor X, D.IsQCartier := isQCartier_of_isQFactorial sX hQ
  -- intersection numbers with curves
  set ι := fun (D : QDivisor X) (C : ProperCurve sX) =>
    (D.intersectionNumber ℂ sX C.ι C.dim_le (hq D) : ℝ) with hι
  have hι_add : ∀ D D' C, ι (D + D') C = ι D C + ι D' C := fun D D' C => by
    simp only [hι]
    rw [QDivisor.intersectionNumber_add' ℂ sX C.ι C.dim_le D D' (hq D) (hq D') (hq _)]
    push_cast; ring
  have hι_smul : ∀ (q : ℚ) D C, ι (q • D) C = q * ι D C := fun q D C => by
    simp only [hι]
    rw [MMP.Fourfold.intersectionNumber_smul sX C.ι C.dim_le D (hq D) q (hq _)]
    push_cast; ring
  have hι_neg : ∀ D C, ι (-D) C = -ι D C := fun D C => by
    have := hι_smul (-1) D C
    rw [neg_one_smul] at this
    rw [this]; push_cast; ring
  set Dt := Divisor.toQDivisor KS + (B - t₀ • T)
  set D' := Divisor.toQDivisor KS + B
  set E := Divisor.toQDivisor KS + (B - T)
  have hdecomp : Dt = (1 - t₀) • D' + t₀ • E := by
    simp only [Dt, D', E, sub_smul, one_smul, smul_add, smul_sub]
    abel
  have hDtC : ∀ C : ProperCurve sX, C.IsContractedBy f → ι Dt C < 0 := fun C hC => by
    have := intersectionNumber_neg_of_isRelativelyAntiAmple (hq Dt)
      hneg.isRelativelyAntiAmple C hC
    simp only [hι]
    exact_mod_cast this
  have hπC : ∀ C : ProperCurve sX, C.IsContractedBy f → C.IsContractedBy π := fun C hC x hx => by
    rw [← hfg, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC x hx]
  have hD'eq : ∀ C : ProperCurve sX, ι D' C = ι (Divisor.toQDivisor K + B) C := fun C => by
    have h2 := intersectionNumber_add_eq_of_linearlyEquivalent (sX := sX) C.ι C.dim_le hlin B
      (hq D') (hq _)
    simp only [hι]
    rw [h2]
  have hD'C : ∀ C : ProperCurve sX, C.IsContractedBy f → ι D' C = 0 := fun C hC => by
    have h1 := MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg sX hnef
      (hq _) C (hπC C hC)
    have h1' := MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg sX hnef'
      (hq _) C (hπC C hC)
    have e1 : (0 : ℝ) ≤ ι (Divisor.toQDivisor K + B) C := by simp only [hι]; exact_mod_cast h1
    have e2 : (0 : ℝ) ≤ ι (-(Divisor.toQDivisor K + B)) C := by
      simp only [hι]; exact_mod_cast h1'
    rw [hι_neg] at e2
    rw [hD'eq]
    linarith
  have hEC : ∀ C : ProperCurve sX, C.IsContractedBy f → ι E C < 0 := fun C hC => by
    have h := hDtC C hC
    rw [hdecomp, hι_add, hι_smul, hι_smul, hD'C C hC] at h
    have : (0 : ℝ) < t₀ := by exact_mod_cast ht₀
    push_cast at h
    nlinarith
  -- the ray `F` is `E`-negative
  set F := relativeToAbsolute sX π '' R
  have hEneg : IsNegativeExtremalRayOf sX E F := by
    refine ⟨hq E, hray, fun u hu hu0 => ?_⟩
    rw [hR₀] at hu
    obtain ⟨c, hc, rfl⟩ := hu
    have hc0 : 0 < c := lt_of_le_of_ne hc (fun h => hu0 (by rw [← h, zero_smul]))
    rw [map_smul, smul_eq_mul, MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
    exact mul_neg_of_pos_of_neg hc0 (hEC C₀ hC₀)
  have hD'T : ι D' C₀ = 0 := hD'C C₀ hC₀
  refine ⟨⟨hq D', fun u hu => ?_⟩, hEneg, fun C hC => ?_⟩
  · have hu' : relativeToAbsolute sX π u ∈ F := ⟨u, hu, rfl⟩
    rw [hR₀] at hu'
    obtain ⟨c, -, hc⟩ := hu'
    rw [relativeCurveForm_eq_comp, LinearMap.comp_apply, ← hc, map_smul,
      MMP.ProgramBaseChange.curveForm_numericalClass_cycle, smul_eq_mul]
    simp only [hι] at hD'T
    rw [hD'T, mul_zero]
  · have hC' := hC
    rw [hR₀] at hC'
    obtain ⟨c, -, hc⟩ := hC'
    have h1 := MMP.ProgramBaseChange.curveForm_numericalClass_cycle sX D' (hq D') C
    rw [← hc, map_smul, MMP.ProgramBaseChange.curveForm_numericalClass_cycle, smul_eq_mul] at h1
    simp only [hι] at hD'T
    rw [hD'T, mul_zero] at h1
    have h2 := intersectionNumber_add_eq_of_linearlyEquivalent (sX := sX) C.ι C.dim_le hlin B
      (hq D') (isQCartier_of_isQFactorial sX hQ _)
    rw [← h2]
    exact_mod_cast h1.symm

private theorem eq_of_comp_eq_of_isIso_app_top {X W Y : Scheme.{0}} [IsAffine Y] (f : X ⟶ W)
    (hf : IsIso (f.app ⊤)) {a b : W ⟶ Y} (h : f ≫ a = f ≫ b) : a = b := by
  apply ext_of_isAffine
  have := congrArg Scheme.Hom.appTop h
  simp only [Scheme.Hom.comp_appTop] at this
  exact (cancel_mono (f.app ⊤)).mp this

/-! ### Transforms of divisors along the steps -/

/-- If `g'` represents `φ` at the generic point of `P` and sends it to the generic point of `E`,
then the transform of `P` under `φ` is `E`. -/
private theorem transformPrimeDivisor_eq_some_of_genericPoint_eq' {X Y : Scheme.{0}}
    [IsReduced X] [IsSeparated (Y ↘ ⊤_ Scheme)] {φ : X.RationalMap Y}
    {P : MMP.Mori.PrimeDivisor X} {E : MMP.Mori.PrimeDivisor Y}
    (g' : X.PartialMap Y) (hg' : g'.toRationalMap = φ)
    (hP : P.genericPoint ∈ g'.domain) (hE : E.genericPoint = g'.hom ⟨P.genericPoint, hP⟩) :
    MMP.Mori.RationalMap.transformPrimeDivisor φ P = some E := by
  refine MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mpr
    ⟨MMP.Mori.RationalMap.definedAt_iff.mpr ⟨g', hP, hg'⟩, ?_⟩
  have h1 : MMP.Mori.RationalMap.transform φ P.idealSheaf.support = E.idealSheaf.support := by
    apply SetLike.coe_injective
    rw [MMP.Flips.coe_transform_eq_closure_singleton g' hg' P hP, ← hE]
    exact (AlgebraicGeometry.PrimeDivisor.support_eq_closure E).symm
  have := E.integral
  rw [MMP.Mori.RationalMap.transformIdeal, h1, MMP.Positivity.vanishingIdeal_support_of_isReduced]

/-- A representative of a rational map `ψ` with `fp ∘ ψ = f` satisfies `fp ∘ g' = f` pointwise on
its domain. -/
private theorem apply_hom_eq_of_compHom_eq {X Y W : Scheme.{0}} [IsReduced X]
    [IsSeparated (W ↘ ⊤_ Scheme)] {ψ : X.RationalMap Y} {fp : Y ⟶ W} {f : X ⟶ W}
    (h : ψ.compHom fp = f.toRationalMap) (g' : X.PartialMap Y) (hg' : g'.toRationalMap = ψ)
    (x : g'.domain) : fp (g'.hom x) = f x := by
  have h1 : (g'.compHom fp).equiv f.toPartialMap := by
    rw [← Scheme.PartialMap.toRationalMap_eq_iff, Scheme.RationalMap.compHom_toRationalMap, hg',
      h]
  have h2 := (Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp h1
  have h3 := congrArg (fun φ => φ.base x) h2
  simp only [Scheme.PartialMap.compHom] at h3
  exact h3

/-- The coefficient of a transform at `Q` is the coefficient at the unique prime sent to `Q`. -/
private theorem transformDivisor_apply_of_forall_iff {X Y : Scheme.{0}} {ψ : X.RationalMap Y}
    {Q : MMP.Mori.PrimeDivisor Y} {E : MMP.Mori.PrimeDivisor X}
    (h : ∀ E' : MMP.Mori.PrimeDivisor X,
      MMP.Mori.RationalMap.transformPrimeDivisor ψ E' = some Q ↔ E' = E)
    {R : Type*} [AddCommMonoid R] (D : DivisorWithCoeffs R X) :
    MMP.Mori.RationalMap.transformDivisor ψ D Q = D E := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' hD hD' => rw [map_add, Finsupp.add_apply, Finsupp.add_apply, hD, hD']
  | single P r =>
    rw [MMP.Mori.RationalMap.transformDivisor_single]
    by_cases hP : P = E
    · subst hP
      rw [(h P).mpr rfl]
      simp
    · rw [Finsupp.single_apply, if_neg hP]
      rcases hψ : MMP.Mori.RationalMap.transformPrimeDivisor ψ P with _ | Q'
      · rfl
      · have hQ' : Q' ≠ Q := fun e => hP ((h P).mp (by rw [hψ, e]))
        simp [Finsupp.single_apply, hQ']

/-- Over the generic point of a prime divisor of a normal scheme, a separated birational morphism
has at most one point. -/
private theorem eq_of_apply_eq_genericPoint {X₂ W : Scheme.{0}} [IsIntegral X₂] [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] (fp : X₂ ⟶ W) [IsSeparated fp] [IsDominant fp]
    (hfp : IsBirationalMorphism fp) (P' : MMP.Mori.PrimeDivisor W) {x y : X₂}
    (hx : fp x = P'.genericPoint) (hy : fp y = P'.genericPoint) : x = y := by
  have := P'.isDiscreteValuationRing_localRing
  haveI : ValuationRing (W.presheaf.stalk (fp x)) := by rw [hx]; infer_instance
  haveI : ValuationRing (W.presheaf.stalk (fp y)) := by rw [hy]; infer_instance
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing fp hfp.functionFieldMap_bijective x
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing fp hfp.functionFieldMap_bijective y
  exact MMP.Positivity.eq_of_isIso_stalkMap fp hfp.functionFieldMap_bijective (hy.trans hx.symm)

/-- A separated variety is separated over the terminal scheme. -/
private theorem isSeparated_terminal {k : Type} [Field k] {X : Scheme.{0}}
    {s : X ⟶ Spec (.of k)} (h : IsNormalVariety k s) : IsSeparated (X ↘ ⊤_ Scheme) := by
  haveI := h.1
  rw [show (X ↘ ⊤_ Scheme) = s ≫ (Spec (.of k) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
  infer_instance

section StepTransforms

variable {k : Type} [Field k] {X₁ X₂ W : Scheme.{0}} [IsIntegral X₁] [CompactSpace X₁]
  [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral X₂] [CompactSpace X₂]
  [IsLocallyNoetherian X₂] [IsNormal X₂] [IsIntegral W] [CompactSpace W]
  [IsLocallyNoetherian W] [IsNormal W] {s₁ : X₁ ⟶ Spec (.of k)} {s₂ : X₂ ⟶ Spec (.of k)}
  {sW : W ⟶ Spec (.of k)}

/-- **Coefficients of transforms along a step.** Let `f : X₁ ⟶ W` and `fp : X₂ ⟶ W` be proper
birational morphisms of normal varieties and `ψ : X₁ ⤏ X₂` a rational map with `fp ∘ ψ = f`. If
`fp` maps the generic point of a prime divisor `Q` of `X₂` to the generic point of a prime divisor
`P'` of `W`, the coefficient of `ψ_* D` along `Q` is the coefficient of `D` along the prime
divisor of `X₁` over `P'`. -/
private theorem exists_transformDivisor_apply_eq_of_compHom_eq (hX₁ : IsNormalVariety k s₁)
    (hX₂ : IsNormalVariety k s₂) (hW : IsNormalVariety k sW) {f : X₁ ⟶ W} {fp : X₂ ⟶ W}
    (hfW : f ≫ sW = s₁) (hfpW : fp ≫ sW = s₂) [IsProper f] [IsProper fp]
    (hf : IsBirationalMorphism f) (hfp : IsBirationalMorphism fp) {ψ : X₁.RationalMap X₂}
    (hψ : ψ.compHom fp = f.toRationalMap) (P' : MMP.Mori.PrimeDivisor W)
    (Q : MMP.Mori.PrimeDivisor X₂) (hQ : fp Q.genericPoint = P'.genericPoint) :
    ∃ E : MMP.Mori.PrimeDivisor X₁, f E.genericPoint = P'.genericPoint ∧
      ∀ {R : Type*} [AddCommMonoid R] (D : DivisorWithCoeffs R X₁),
        MMP.Mori.RationalMap.transformDivisor ψ D Q = D E := by
  classical
  haveI := hW.1
  haveI := isSeparated_terminal hX₂
  haveI := isSeparated_terminal hW
  haveI : IsSeparated f := IsSeparated.of_comp f sW
  haveI : IsSeparated fp := IsSeparated.of_comp fp sW
  haveI : IsDominant f := hf.isDominant
  haveI : IsDominant fp := hfp.isDominant
  obtain ⟨E, hE, -, -⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hW (hfW ▸ hX₁) hf P'
  refine ⟨E, hE, fun D => transformDivisor_apply_of_forall_iff (fun E' => ⟨fun h => ?_, ?_⟩) D⟩
  · obtain ⟨hdef, -⟩ := MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp h
    obtain ⟨g', hP, hg'⟩ := MMP.Mori.RationalMap.definedAt_iff.mp hdef
    have h1 := MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some h g' hg' hP
    have h2 := apply_hom_eq_of_compHom_eq hψ g' hg' ⟨E'.genericPoint, hP⟩
    rw [← h1, hQ] at h2
    exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (eq_of_apply_eq_genericPoint f hf P' h2.symm hE)
  · intro hE'
    rw [hE']
    have hdom : E.genericPoint ∈ ψ.domain := MMP.Flips.RationalMap.mem_domain_of_coheight_le_one
      f fp ψ hψ E.coheight_genericPoint.le
    obtain ⟨g', hP, hg'⟩ := Scheme.RationalMap.mem_domain.mp hdom
    refine transformPrimeDivisor_eq_some_of_genericPoint_eq' g' hg' hP ?_
    have h2 := apply_hom_eq_of_compHom_eq hψ g' hg' ⟨E.genericPoint, hP⟩
    rw [hE] at h2
    exact eq_of_apply_eq_genericPoint fp hfp P' hQ h2

/-- **Transforms along a step over the base of its contraction.** In the setting of
`exists_transformDivisor_apply_eq_of_compHom_eq`, `fp_* ψ_* D = f_* D` for every divisor `D` on
`X₁`. -/
private theorem transformDivisor_transformDivisor_of_compHom_eq (hX₁ : IsNormalVariety k s₁)
    (hX₂ : IsNormalVariety k s₂) (hW : IsNormalVariety k sW) {f : X₁ ⟶ W} {fp : X₂ ⟶ W}
    (hfW : f ≫ sW = s₁) (hfpW : fp ≫ sW = s₂) [IsProper f] [IsProper fp]
    (hf : IsBirationalMorphism f) (hfp : IsBirationalMorphism fp) {ψ : X₁.RationalMap X₂}
    (hψ : ψ.compHom fp = f.toRationalMap) {R : Type*} [AddCommMonoid R]
    (D : DivisorWithCoeffs R X₁) :
    MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap
        (MMP.Mori.RationalMap.transformDivisor ψ D) =
      MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap D := by
  haveI := hW.1
  haveI : IsSeparated f := IsSeparated.of_comp f sW
  haveI : IsSeparated fp := IsSeparated.of_comp fp sW
  haveI : IsDominant f := hf.isDominant
  haveI : IsDominant fp := hfp.isDominant
  refine Finsupp.ext fun P' => ?_
  obtain ⟨E, hE, -, htrE⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hW (hfW ▸ hX₁) hf P'
  obtain ⟨Q, hQ, -, htrQ⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hW (hfpW ▸ hX₂) hfp P'
  obtain ⟨E', hE', htr⟩ :=
    exists_transformDivisor_apply_eq_of_compHom_eq hX₁ hX₂ hW hfW hfpW hf hfp hψ P' Q hQ
  rw [htrE, htrQ, htr, AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_apply_eq_genericPoint f hf P' hE' hE)]

end StepTransforms

variable {k : Type} [Field k] {X₂ W : Scheme.{0}} [IsIntegral X₂] [CompactSpace X₂]
  [IsLocallyNoetherian X₂] [IsNormal X₂] [IsIntegral W] [CompactSpace W]
  [IsLocallyNoetherian W] [IsNormal W] {s₂ : X₂ ⟶ Spec (.of k)} {sW : W ⟶ Spec (.of k)} in
/-- Push-forward along a proper birational morphism mapping the generic point of every prime
divisor to the generic point of a prime divisor is injective on divisors. -/
private theorem transformDivisor_injective_of_forall_exists (hX₂ : IsNormalVariety k s₂)
    (hW : IsNormalVariety k sW) {fp : X₂ ⟶ W} (hfpW : fp ≫ sW = s₂) [IsProper fp]
    (hfp : IsBirationalMorphism fp)
    (hfpQ : ∀ Q : MMP.Mori.PrimeDivisor X₂, ∃ P' : MMP.Mori.PrimeDivisor W,
      fp Q.genericPoint = P'.genericPoint)
    {R : Type*} [AddCommMonoid R] {D₁ D₂ : DivisorWithCoeffs R X₂}
    (h : MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap D₁ =
      MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap D₂) : D₁ = D₂ := by
  haveI := hW.1
  haveI : IsSeparated fp := IsSeparated.of_comp fp sW
  haveI : IsDominant fp := hfp.isDominant
  refine Finsupp.ext fun Q => ?_
  obtain ⟨P', hP'⟩ := hfpQ Q
  obtain ⟨Q', hQ', -, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hW (hfpW ▸ hX₂) hfp P'
  have hQQ : Q' = Q := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    (eq_of_apply_eq_genericPoint fp hfp P' hQ' hP')
  subst hQQ
  have := congrArg (fun D => D P') h
  rw [htr, htr] at this
  exact this

/-- If `fp` is an open immersion off a closed subset `V` of codimension at least two, it maps the
generic point of every prime divisor to the generic point of a prime divisor. -/
private theorem exists_genericPoint_eq_of_isOpenImmersion {X₂ W : Scheme.{0}} (fp : X₂ ⟶ W)
    (V : TopologicalSpace.Closeds X₂) (hV : 2 ≤ closedsCodimension V)
    (hU : IsOpenImmersion (Scheme.Opens.ι (V.compl : X₂.Opens) ≫ fp))
    (Q : MMP.Mori.PrimeDivisor X₂) :
    ∃ P' : MMP.Mori.PrimeDivisor W, fp Q.genericPoint = P'.genericPoint := by
  have hQV : Q.genericPoint ∈ (V.compl : X₂.Opens) := by
    by_contra hnd
    have h2 := le_closedsCodimension_iff.mp hV
      (IrreducibleCloseds.closureSingleton Q.genericPoint)
      (closure_minimal (Set.singleton_subset_iff.mpr (by by_contra h; exact hnd h)) V.isClosed)
    rw [codimension_eq_coheight, show IrreducibleCloseds.closureSingleton Q.genericPoint =
      (irreducibleSetEquivPoints (α := X₂)).symm Q.genericPoint from rfl,
      Order.coheight_orderIso, Q.coheight_genericPoint] at h2
    exact absurd h2 (by decide)
  set u : (V.compl : X₂.Opens) := ⟨Q.genericPoint, hQV⟩
  have h1 : Order.coheight ((Scheme.Opens.ι (V.compl : X₂.Opens) ≫ fp) u) = 1 := by
    have e1 := coheight_eq_of_isOpenImmersion (x := u) (Scheme.Opens.ι (V.compl : X₂.Opens) ≫ fp)
    have e2 := coheight_eq_of_isOpenImmersion (x := u) (Scheme.Opens.ι (V.compl : X₂.Opens))
    exact e1.trans (e2.symm.trans Q.coheight_genericPoint)
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1,
    (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1).symm⟩

section ResidueDegree

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  {sY : Y ⟶ Spec (.of k)} [IsSeparated sY] [LocallyOfFiniteType sY]

/-- A proper curve which is not contracted by `g` does not have a point as image. -/
private theorem not_exists_range_eq_singleton' (g : X ⟶ Y) (Γ : ProperCurve sX)
    (h : ¬ Γ.IsContractedBy g) : ¬ ∃ y : Y, Set.range (Γ.ι ≫ g) = {y} := by
  rintro ⟨y, hy⟩
  refine h fun x hx => ?_
  rw [← Γ.range_ι] at hx
  obtain ⟨c, rfl⟩ := hx
  have h1 : (Γ.ι ≫ g) c ∈ Set.range (Γ.ι ≫ g) := ⟨c, rfl⟩
  have h2 : (Γ.ι ≫ g) (genericPoint Γ.scheme) ∈ Set.range (Γ.ι ≫ g) := ⟨_, rfl⟩
  rw [hy] at h1 h2
  rw [Scheme.Hom.comp_apply] at h1 h2
  rw [Γ.ι_genericPoint] at h2
  exact h1.trans h2.symm

/-- A morphism over `k` which does not contract a proper curve has positive residue degree at
its generic point: `k(C)` is a finite extension of the function field of the image curve. -/
private theorem residueFieldDegree_pos_of_not_isContractedBy' (g : X ⟶ Y) (hg : g ≫ sY = sX)
    (Γ : ProperCurve sX) (h : ¬ Γ.IsContractedBy g) : 0 < residueFieldDegree g Γ.point := by
  have hnc := not_exists_range_eq_singleton' g Γ h
  set φ := Γ.ι ≫ g with hφdef
  have hφ : φ ≫ sY = Γ.ι ≫ sX := by rw [hφdef, Category.assoc, hg]
  have : IsProper (φ ≫ sY) := hφ ▸ inferInstance
  have : IsProper φ := IsProper.of_comp _ sY
  have := Γ.isCurve
  have : AlgebraicGeometry.IsCurve k (φ ≫ sY) := hφ ▸ inferInstance
  have hdeg : residueFieldDegree g Γ.point = degreeOver φ.toImage := by
    have h1 := residueDegree_comp Γ.ι g (genericPoint Γ.scheme)
    rw [Γ.ι_genericPoint, Stacks.Chow.residueDegree_eq_one_of_isClosedImmersion Γ.ι, mul_one]
      at h1
    have h2 := residueDegree_comp φ.toImage φ.imageι (genericPoint Γ.scheme)
    rw [Scheme.Hom.toImage_imageι,
      Stacks.Chow.residueDegree_eq_one_of_isClosedImmersion φ.imageι,
      one_mul, residueDegree_genericPoint_eq_degreeOver φ.toImage] at h2
    exact h1.symm.trans h2
  rw [hdeg]
  letI := (functionFieldMap φ.toImage).toAlgebra
  have hfin : Module.Finite φ.image.functionField Γ.scheme.functionField :=
    finite_functionField_image sY φ hnc
  have heq : functionFieldMap φ.toImage = dominantFunctionFieldMap φ.toImage :=
    (congrArg CommRingCat.Hom.hom
      (stalkMap_cast_target φ.toImage (genericPoint Γ.scheme)
        (map_genericPoint_of_isDominant φ.toImage))).symm
  rw [degreeOver_eq_finrank φ.toImage heq]
  exact Module.finrank_pos

end ResidueDegree

/-! ### Cartier descent along the contraction -/

/-- A dominant morphism of integral schemes maps the generic point outside every divisor. -/
private theorem forall_map_componentGenericPoint_notMem_supp {X W : Scheme.{0}} [IsIntegral X]
    [IsIntegral W] {f : X ⟶ W} [IsDominant f] {R : Type*} [Zero R]
    (G : DivisorWithCoeffs R W) :
    ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ G.supp := fun Z => by
  rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant f]
  exact MMP.Fourfold.genericPoint_notMem_supp G

/-- **Cartier descent along a contraction of a negative face.** Let `f` be the contraction of a
`(K + Δ)`-negative extremal face `F` of a klt pair on a projective variety, `f` birational, and
let `D` be a Cartier divisor of degree zero on every curve with class in `F`. Then `D = f^* G` for
a Cartier divisor `G` on the target. -/
private theorem exists_isPullback_of_isContractionOfFace {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W] [CompactSpace W]
    [IsLocallyNoetherian W] [IsNormal W] {sX : X ⟶ Spec (.of ℂ)} {sW : W ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (hklt : MMP.Mori.IsKltPair sX n K Δ) (hΔ : Δ.IsEffective)
    {F : Set (NumericalCurveClasses sX)}
    (hF : IsNegativeExtremalFace ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
      (MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2) F)
    {f : X ⟶ W} (hface : IsContractionOfFace ℂ sX sW F f) (hfb : IsBirationalMorphism f)
    {Dm : Divisor X} (hDmc : Dm.IsCartier)
    (hdeg : ∀ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ F →
      haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
      Dm.degreeOn ℂ sX C.ι C.dim_le hDmc = 0) :
    ∃ (G : Divisor W) (_ : G.IsCartier) (hB : ∀ Z : irreducibleComponents X,
      f (componentGenericPoint X Z) ∉ G.supp), G.IsPullback f hB Dm := by
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : IsDominant f := hfb.isDominant
  haveI := hDmc.isInvertibleModule_divisorialSheaf
  obtain ⟨LZ, hLZ, ⟨e⟩⟩ := MMP.Mori.exists_isInvertible_iso_pullback_of_isContractionOfFace hklt
    hΔ hF hface Dm.divisorialSheaf (fun C hC => hdeg C hC)
  haveI := hLZ
  obtain ⟨EW, ⟨eW⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf LZ
  haveI : IsNoetherian W := ⟨⟩
  obtain ⟨w, hw⟩ := exists_isWeilDivisorOfCartier EW
  have hwc : w.IsCartier := hw.isCartier
  obtain ⟨eW'⟩ := hw.nonempty_sheaf_iso_divisorialSheaf
  have hBw := forall_map_componentGenericPoint_notMem_supp (f := f) w
  obtain ⟨ep⟩ := MMP.Mori.Divisor.nonempty_divisorialSheaf_pullback_iso hwc f hBw
  have α : Dm.divisorialSheaf ≅ (w.pullback hwc hBw).divisorialSheaf :=
    e ≪≫ (Scheme.Modules.pullback f).mapIso (eW ≪≫ eW') ≪≫ ep.symm
  obtain ⟨φ, hφ⟩ := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso α
  obtain ⟨φW, hφW, hpb⟩ := MMP.Fourfold.exists_pullbackRationalFunction_eq hfb φ
  have hGc : (w + principalDivisor φW).IsCartier :=
    hwc.add (Divisor.isCartier_principalDivisor _)
  refine ⟨w + principalDivisor φW, hGc,
    forall_map_componentGenericPoint_notMem_supp (f := f) _, ?_⟩
  have h1 := Divisor.isPullback_pullback hwc hBw
  have h2 := Divisor.isPullback_principalDivisor φW hφW
  have h3 := Divisor.IsPullback.add hwc (Divisor.isCartier_principalDivisor _)
    (forall_map_componentGenericPoint_notMem_supp (f := f) _) h1 h2
  rw [hpb, ← hφ] at h3
  convert h3 using 1
  abel

/-- The birational transform of divisors commutes with regarding a divisor as a `ℚ`-divisor. -/
private theorem transformDivisor_toQDivisor {X Y : Scheme.{0}} (φ : X.RationalMap Y)
    (D : Divisor X) :
    MMP.Mori.RationalMap.transformDivisor φ (Divisor.toQDivisor D) =
      Divisor.toQDivisor (MMP.Mori.RationalMap.transformDivisor φ D) := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' h h' => rw [map_add, map_add, h, h', map_add, map_add]
  | single P n =>
    have hP : Divisor.toQDivisor (Finsupp.single P n) = Finsupp.single P (n : ℚ) := by
      ext E
      change ((Finsupp.single P n E : ℤ) : ℚ) = Finsupp.single P (n : ℚ) E
      rw [Finsupp.single_apply, Finsupp.single_apply]
      split_ifs <;> simp
    rw [hP, MMP.Mori.RationalMap.transformDivisor_single,
      MMP.Mori.RationalMap.transformDivisor_single]
    cases MMP.Mori.RationalMap.transformPrimeDivisor φ P with
    | none => simp
    | some E =>
      ext F
      change Finsupp.single E (n : ℚ) F = ((Finsupp.single E n F : ℤ) : ℚ)
      rw [Finsupp.single_apply, Finsupp.single_apply]
      split_ifs <;> simp

variable {k : Type} [Field k] {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [QuasiCompact sX]
  [IsLocallyNoetherian X] [IsNormal X] in
/-- A `ℚ`-Cartier `ℚ`-divisor with nonnegative intersection number on every curve contracted by
`f` is `f`-nef. -/
private theorem isRelativelyNef_of_intersectionNumber_nonneg {f : X ⟶ Y} {D : QDivisor X}
    (hD : D.IsQCartier)
    (h : ∀ C : ProperCurve sX, C.IsContractedBy f →
      0 ≤ D.intersectionNumber k sX C.ι C.dim_le hD) :
    D.IsRelativelyNef sX f := by
  refine ⟨hD, fun C hC => ?_⟩
  have key := h C hC
  rw [QDivisor.intersectionNumber_eq_of_toQDivisor_eq k sX C.ι C.dim_le D hD _
    (D.cartierIndexSMul hD).2 (QDivisor.toQDivisor_cartierIndexSMul D hD)] at key
  have hm : (0 : ℚ) < D.cartierIndex hD := by exact_mod_cast QDivisor.cartierIndex_pos hD
  have hdeg : (0 : ℚ) ≤ ((D.cartierIndexSMul hD : Divisor X).degreeOn k sX C.ι C.dim_le
      (D.cartierIndexSMul hD).2 : ℚ) := by
    have := mul_nonneg key hm.le
    rwa [div_mul_cancel₀ _ hm.ne'] at this
  rw [QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier, Finsupp.smul_single,
    Finsupp.sum_single_index (by simp)]
  have hdeg' : (0 : ℝ) ≤ ((D.cartierIndexSMul hD : Divisor X).degreeOn k sX C.ι C.dim_le
      (D.cartierIndexSMul hD).2 : ℝ) := by exact_mod_cast hdeg
  have hm' : (0 : ℝ) ≤ (((1 / (D.cartierIndex hD : ℚ)) • (1 : ℚ) : ℚ) : ℝ) := by
    simp only [smul_eq_mul, mul_one, Rat.cast_div, Rat.cast_one, Rat.cast_natCast]
    positivity
  exact mul_nonneg hm' hdeg'

/-- **Nefness passes to the next model.** Let `f : X₁ ⟶ W` and `fp : X₂ ⟶ W` be proper morphisms
over `Z` (by `gW`), `f` surjective, and `G` a Cartier divisor on `W` with pull-backs `m D₁` and
`m D₂`. If `D₁` is nef over `Z`, so is `D₂`: a curve of `X₂` over a point of `Z` either is
contracted by `fp`, or maps onto a curve of `W` over a point of `Z`, which lifts to `X₁`. -/
private theorem isRelativelyNef_of_isPullback {X₁ X₂ W Z : Scheme.{0}} [IsIntegral X₁]
    [CompactSpace X₁] [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral X₂] [CompactSpace X₂]
    [IsLocallyNoetherian X₂] [IsNormal X₂] [IsIntegral W] [CompactSpace W]
    [IsLocallyNoetherian W] [IsNormal W] {s₁ : X₁ ⟶ Spec (.of ℂ)} {s₂ : X₂ ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} (hW : IsNormalVariety ℂ sW) (hX₁ : IsNormalVariety ℂ s₁)
    (hX₂ : IsNormalVariety ℂ s₂) {f : X₁ ⟶ W} {fp : X₂ ⟶ W} {gW : W ⟶ Z}
    (hfW : f ≫ sW = s₁) (hfpW : fp ≫ sW = s₂) [IsProper f] [IsProper fp] [Surjective f]
    {G : Divisor W} (hGc : G.IsCartier) {Dm₁ : Divisor X₁}
    {hB₁ : ∀ Z' : irreducibleComponents X₁, f (componentGenericPoint X₁ Z') ∉ G.supp}
    (h₁ : G.IsPullback f hB₁ Dm₁) {Dm₂ : Divisor X₂}
    {hB₂ : ∀ Z' : irreducibleComponents X₂, fp (componentGenericPoint X₂ Z') ∉ G.supp}
    (h₂ : G.IsPullback fp hB₂ Dm₂) {m : ℕ} (hm : 0 < m) {D₁ : QDivisor X₁}
    {D₂ : QDivisor X₂} (hD₁ : Divisor.toQDivisor Dm₁ = (m : ℤ) • D₁)
    (hD₂ : Divisor.toQDivisor Dm₂ = (m : ℤ) • D₂)
    (hnef : QDivisor.IsRelativelyNef s₁ (f ≫ gW) D₁) :
    QDivisor.IsRelativelyNef s₂ (fp ≫ gW) D₂ := by
  subst hfW
  haveI : QuasiCompact (f ≫ sW) := hX₁.1.toQuasiCompact
  haveI : QuasiCompact s₂ := hX₂.1.toQuasiCompact
  haveI := hW.1
  haveI : IsSeparated sW := hW.1.toIsSeparated
  haveI : LocallyOfFiniteType sW := hW.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (f ≫ sW) := hX₁.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType s₂ := hX₂.1.toLocallyOfFiniteType
  have hDm₁c : Dm₁.IsCartier := h₁.pullback_eq hGc ▸ hGc.isCartier_pullback f hB₁
  have hDm₂c : Dm₂.IsCartier := h₂.pullback_eq hGc ▸ hGc.isCartier_pullback fp hB₂
  have hq₁ : D₁.IsQCartier := ⟨m, by exact_mod_cast hm.ne', Dm₁, hD₁, hDm₁c⟩
  have hq₂ : D₂.IsQCartier := ⟨m, by exact_mod_cast hm.ne', Dm₂, hD₂, hDm₂c⟩
  haveI := hGc.isInvertibleModule_divisorialSheaf
  haveI := hDm₁c.isInvertibleModule_divisorialSheaf
  haveI := hDm₂c.isInvertibleModule_divisorialSheaf
  obtain ⟨e₁⟩ := MMP.Mori.Divisor.nonempty_divisorialSheaf_pullback_iso hGc f hB₁
  obtain ⟨e₂⟩ := MMP.Mori.Divisor.nonempty_divisorialSheaf_pullback_iso hGc fp hB₂
  rw [h₁.pullback_eq hGc] at e₁
  rw [h₂.pullback_eq hGc] at e₂
  refine isRelativelyNef_of_intersectionNumber_nonneg s₂ hq₂ fun Γ hΓ => ?_
  rw [QDivisor.intersectionNumber_eq_of_smul ℂ s₂ Γ.ι Γ.dim_le _ hq₂ hm Dm₂ hDm₂c hD₂]
  refine div_nonneg ?_ (by positivity)
  have hΓdeg : Dm₂.degreeOn ℂ s₂ Γ.ι Γ.dim_le hDm₂c =
      Γ.degree ℂ ((Scheme.Modules.pullback fp).obj G.divisorialSheaf) :=
    degreeOn_eq_of_iso ℂ s₂ Γ.ι Γ.dim_le e₂
  rw [hΓdeg, MMP.Mori.ProperCurve.degree_pullback fp hfpW Γ G.divisorialSheaf]
  split_ifs with hcurve
  swap
  · simp
  obtain ⟨C₁, hC₁, hC₁img⟩ := MMP.Mori.ProperCurve.exists_map_eq (f ≫ sW) sW f rfl
    (⟨fp Γ.point, hcurve⟩ : ProperCurve sW)
  -- `C₁` lies over a point of `Z`
  have hC₁Z : C₁.IsContractedBy (f ≫ gW) := by
    have hcl : closure ({fp Γ.point} : Set W) ⊆ fp.base '' closure {Γ.point} :=
      closure_minimal (Set.singleton_subset_iff.mpr ⟨Γ.point, subset_closure rfl, rfl⟩)
        (fp.isClosedMap _ isClosed_closure)
    intro x hx
    have hfx : f x ∈ closure ({fp Γ.point} : Set W) := by
      rw [← hC₁img]; exact ⟨x, hx, rfl⟩
    obtain ⟨x', hx', hx'e⟩ := hcl hfx
    have hpt : f C₁.point ∈ closure ({fp Γ.point} : Set W) := by
      rw [hC₁]; exact subset_closure rfl
    obtain ⟨y', hy', hy'e⟩ := hcl hpt
    simp only [Scheme.Hom.comp_apply]
    rw [← hx'e, ← hy'e]
    exact (hΓ x' hx').trans (hΓ y' hy').symm
  have hn₁ := MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg (f ≫ sW) hnef hq₁
    C₁ hC₁Z
  rw [QDivisor.intersectionNumber_eq_of_smul ℂ (f ≫ sW) C₁.ι C₁.dim_le _ hq₁ hm Dm₁ hDm₁c hD₁]
    at hn₁
  have hmq : (0 : ℚ) < m := by exact_mod_cast hm
  have hd₁ : (0 : ℤ) ≤ Dm₁.degreeOn ℂ (f ≫ sW) C₁.ι C₁.dim_le hDm₁c := by
    have := (div_nonneg_iff.mp hn₁).elim (fun h => h.1) (fun h => absurd h.2 (not_le.mpr hmq))
    exact_mod_cast this
  have hC₁deg : Dm₁.degreeOn ℂ (f ≫ sW) C₁.ι C₁.dim_le hDm₁c =
      C₁.degree ℂ ((Scheme.Modules.pullback f).obj G.divisorialSheaf) :=
    degreeOn_eq_of_iso ℂ (f ≫ sW) C₁.ι C₁.dim_le e₁
  rw [hC₁deg, MMP.Mori.ProperCurve.degree_pullback f rfl C₁ G.divisorialSheaf] at hd₁
  have hcurve₁ : IsProperCurve sW (f C₁.point) := by rw [hC₁]; exact hcurve
  rw [dif_pos hcurve₁] at hd₁
  have hCW : (⟨f C₁.point, hcurve₁⟩ : ProperCurve sW) = ⟨fp Γ.point, hcurve⟩ := by
    congr 1
  rw [hCW] at hd₁
  have hnc : ¬ C₁.IsContractedBy f := by
    intro h
    refine MMP.Mori.ProperCurve.not_isProperCurve_of_forall_eq f C₁ (y := f C₁.point)
      (fun z => ?_) hcurve₁
    rw [Scheme.Hom.comp_apply]
    exact h _ (by rw [← C₁.range_ι]; exact ⟨z, rfl⟩)
  have hres := residueFieldDegree_pos_of_not_isContractedBy' f rfl C₁ hnc
  have hdW : (0 : ℤ) ≤ (⟨fp Γ.point, hcurve⟩ : ProperCurve sW).degree ℂ G.divisorialSheaf := by
    by_contra hneg
    push Not at hneg
    have : (residueFieldDegree f C₁.point : ℤ) *
        (⟨fp Γ.point, hcurve⟩ : ProperCurve sW).degree ℂ G.divisorialSheaf < 0 :=
      mul_neg_of_pos_of_neg (by exact_mod_cast hres) hneg
    omega
  have : (0 : ℤ) ≤ (residueFieldDegree fp Γ.point : ℤ) *
      (⟨fp Γ.point, hcurve⟩ : ProperCurve sW).degree ℂ G.divisorialSheaf :=
    mul_nonneg (by positivity) hdW
  exact_mod_cast this

/-- A pull-back `m D = f^* G` of one Cartier multiple `G = m D_W` is a pull-back of `ℚ`-divisors
`D = f^* D_W`: any Cartier multiple `D''` of `D_W` has `m D'' = m' G`, and pull-backs are
additive. -/
private theorem qDivisor_isPullback_of_isPullback {X W : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsLocallyNoetherian W] [IsNormal W]
    [CompactSpace W] {f : X ⟶ W} {G : Divisor W} (hGc : G.IsCartier)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ G.supp} {Dm : Divisor X}
    (h : G.IsPullback f hB Dm) {m : ℕ} (hm : 0 < m) {DW : QDivisor W} {D : QDivisor X}
    (hDW : Divisor.toQDivisor G = (m : ℤ) • DW) (hD : Divisor.toQDivisor Dm = (m : ℤ) • D)
    (hB' : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ DW.supp) :
    DW.IsPullback f hB' D := by
  intro m' hm' D'' hD'' hD''c
  have hB'' : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ D''.supp :=
    fun Z hZ => hB' Z (by
      rwa [QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm'.ne') hD''] at hZ)
  refine ⟨D''.pullback hD''c hB'', ?_, Divisor.isPullback_pullback hD''c hB''⟩
  have hmm : (m : ℤ) • D'' = (m' : ℤ) • G := by
    apply Divisor.toQDivisor_injective
    rw [map_zsmul, map_zsmul, hD'', hDW, smul_smul, smul_smul, mul_comm]
  have hsupp : ((m : ℤ) • D'').supp = D''.supp := by
    rw [← Divisor.supp_toQDivisor, map_zsmul, QDivisor.supp_zsmul (by exact_mod_cast hm.ne'),
      Divisor.supp_toQDivisor]
  have hBm : ∀ Z : irreducibleComponents X,
      f (componentGenericPoint X Z) ∉ ((m : ℤ) • D'').supp := fun Z => by
    rw [hsupp]; exact hB'' Z
  have h1 := (Divisor.isPullback_pullback hD''c hB'').zsmul hD''c (m : ℤ) hBm
  have h2 := h.zsmul hGc (m' : ℤ) (by rw [← hmm]; exact hBm)
  have h3 : (m : ℤ) • D''.pullback hD''c hB'' = (m' : ℤ) • Dm :=
    (Divisor.IsPullback.of_eq hmm h1).eq (hGc.zsmul _) h2
  have h4 := congrArg Divisor.toQDivisor h3
  rw [map_zsmul, map_zsmul, hD, smul_smul, mul_comm, ← smul_smul] at h4
  exact smul_right_injective _ (by exact_mod_cast hm.ne' : ((m : ℤ) : ℚ) ≠ 0)
    (by simpa only [Int.cast_smul_eq_zsmul] using h4)

/-- **Log canonicity passes along a crepant step.** Let `f : X₁ ⟶ W` and `fp : X₂ ⟶ W` be proper
birational morphisms of normal varieties with `K₁ + B₁ = f^*(K_W + B_W)` and
`K₂ + B₂ = fp^*(K_W + B_W)` for compatible canonical divisors. If `(X₁, B₁)` is lc, so is
`(X₂, B₂)`: a divisor over `X₂` is read as a divisor over `W`, whose discrepancy is that of a
divisor over `X₁` with the same valuation. -/
private theorem isLogCanonicalPair_of_isPullback_of_isPullback {X₁ X₂ W : Scheme.{0}}
    [IsIntegral X₁] [CompactSpace X₁] [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral X₂]
    [CompactSpace X₂] [IsLocallyNoetherian X₂] [IsNormal X₂] [IsIntegral W] [CompactSpace W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)} {f : X₁ ⟶ W} {fp : X₂ ⟶ W}
    (hX₁ : IsNormalVariety ℂ (f ≫ sW)) (hX₂ : IsNormalVariety ℂ (fp ≫ sW)) [IsProper f]
    [IsProper fp] (hfb : IsBirationalMorphism f) (hfpb : IsBirationalMorphism fp)
    {d : ℕ} {K₁ : Divisor X₁} {K₂ : Divisor X₂} {KW : Divisor W}
    (hK₁ : K₁.IsCanonicalDivisor (f ≫ sW) d)
    (hK₂ : K₂.IsCanonicalDivisor (fp ≫ sW) d) (hKW : KW.IsCanonicalDivisor sW d)
    (hfK : MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap K₁ = KW)
    (hfpK : MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap K₂ = KW)
    {B₁ : QDivisor X₁} {B₂ : QDivisor X₂} {BW : QDivisor W} (hpair : MMP.Mori.IsPair sW BW)
    (hpb₁ : ∃ hB, (Divisor.toQDivisor KW + BW).IsPullback f hB (Divisor.toQDivisor K₁ + B₁))
    (hpb₂ : ∃ hB, (Divisor.toQDivisor KW + BW).IsPullback fp hB (Divisor.toQDivisor K₂ + B₂))
    (hlc : MMP.Intersection.IsLogCanonicalPair (f ≫ sW) B₁) (hB₂ : ∀ P, 0 ≤ B₂.coeff P) :
    MMP.Intersection.IsLogCanonicalPair (fp ≫ sW) B₂ := by
  haveI : LocallyOfFiniteType (f ≫ sW) := hX₁.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (fp ≫ sW) := hX₂.1.toLocallyOfFiniteType
  haveI : IsDominant f := hfb.isDominant
  haveI : IsDominant fp := hfpb.isDominant
  obtain ⟨-, hc₁⟩ := hpair.isDiscrepancy_iff_of_crepant f hX₁ hfb hKW hK₁
    (Or.inr ⟨inferInstance, hfK, hpb₁⟩)
  obtain ⟨hP₂, hc₂⟩ := hpair.isDiscrepancy_iff_of_crepant fp hX₂ hfpb hKW hK₂
    (Or.inr ⟨inferInstance, hfpK, hpb₂⟩)
  refine ⟨hP₂, hB₂, fun n' D a ha => ?_⟩
  have hn' : n' = d := by
    have h1 := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
    rw [hK₂.topologicalKrullDim_eq] at h1
    exact_mod_cast h1.symm
  subst hn'
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP₂ hK₂ D
  have ha' := ((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hc a).mp ha).2
  have hcW := (hc₂ D (MMP.Mori.compDivisorOver fp hX₂ hfpb D)
    (MMP.Mori.valuation_compDivisorOver fp hX₂ hfpb D) c).mp hc
  obtain ⟨D₁, hD₁⟩ := MMP.Mori.exists_divisorOver_comap_eq hX₁ hfb
    (MMP.Mori.compDivisorOver fp hX₂ hfpb D)
  obtain ⟨E₁, hE₁⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hX₁ D₁
  have hc₁' := (hc₁ E₁.toDivisorOver (MMP.Mori.compDivisorOver fp hX₂ hfpb D)
    (by rw [hD₁]; exact congrArg (fun v => v.comap (functionFieldMap f)) hE₁.symm) c).mpr hcW
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc₁' E₁.isProper
  rw [ha']
  exact hlc.2.2 n' E₁.toDivisorOver (1 + c) hl

/-- **Log canonical centres lie in the lowered part.** Let `(X, B)` and `(X, B - T)` be pairs,
`T ≥ 0`, and `(X, B - tT)` klt for some `0 < t ≤ 1`. If a divisor `E` over `X` has log
discrepancy `0` over `(X, B)`, its centre lies on a component of `T`: otherwise `m T` is trivial
near the centre, so `E` has the same log discrepancy over `(X, B)`, `(X, B - T)` and, by
affinity, `(X, B - tT)`. -/
private theorem exists_coeff_pos_of_isLogDiscrepancy_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {s : X ⟶ Spec (.of ℂ)} {B T : QDivisor X}
    (hP : MMP.Mori.IsPair s B) (hPT : MMP.Mori.IsPair s (B - T)) (hT0 : ∀ P, 0 ≤ T.coeff P)
    {t : ℚ} (ht0 : 0 < t) (ht1 : t ≤ 1) (hklt : IsKltPair s (B - t • T)) {n : ℕ}
    {E : DivisorOver ℂ s}
    (hE : MMP.Intersection.IsLogDiscrepancy s n (QDivisor.toRDivisor B) E 0) :
    ∃ Γ : MMP.Mori.PrimeDivisor X, 0 < T.coeff Γ ∧ E.f E.E.genericPoint ∈ Γ.support := by
  by_contra hcon
  push Not at hcon
  obtain ⟨hX, hf, ω, hω0, ⟨K, hK, hKω⟩, -⟩ := id hE
  have := E.isIntegral
  have := E.isLocallyNoetherian
  have := E.isNormal
  have := E.isDominant
  obtain ⟨m₀, M₀, M₀', hm₀, hM₀c, hM₀, hpb₀⟩ := exists_cartier_presentation hP hK E
  obtain ⟨m₁, M₁, M₁', hm₁, hM₁c, hM₁, hpb₁⟩ := exists_cartier_presentation hPT hK E
  obtain ⟨hC₀, hpb₀⟩ := hpb₀
  obtain ⟨hC₁, hpb₁⟩ := hpb₁
  -- `G = m₁ M₀ - m₀ M₁ = m₀ m₁ T` is trivial near the centre of `E`
  set G : Divisor X := (m₁ : ℤ) • M₀ + (-(m₀ : ℤ)) • M₁ with hG
  have hGc : G.IsCartier := (hM₀c.zsmul _).add (hM₁c.zsmul _)
  have hGcoeff : ∀ Γ, (G.coeff Γ : ℝ) = m₀ * m₁ * T.coeff Γ := fun Γ => by
    have h0 := hM₀ Γ
    have h1 := hM₁ Γ
    simp only [hG, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    simp only [DivisorWithCoeffs.coeff_sub, QDivisor.coeff_toRDivisor] at h1
    push_cast at h0 h1 ⊢
    rw [h0, h1]
    ring
  have hB₀ := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant E.f ((m₁ : ℤ) • M₀)
  have hB₁ := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant E.f
    ((-(m₀ : ℤ)) • M₁)
  have hBG := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant E.f G
  have hpbG := Divisor.IsPullback.add (hM₀c.zsmul _) (hM₁c.zsmul _) hBG
    (Divisor.IsPullback.zsmul hM₀c hpb₀ _ hB₀) (Divisor.IsPullback.zsmul hM₁c hpb₁ _ hB₁)
  have hzero := (coeff_isPullback_of_forall E.f hGc hpbG E.E.genericPoint).2 (fun Γ hΓ => by
    have hT : T.coeff Γ = 0 := by
      by_contra hne
      exact hcon Γ (lt_of_le_of_ne (hT0 Γ) (Ne.symm hne)) hΓ
    have := hGcoeff Γ
    rw [hT] at this
    exact_mod_cast (by simpa using this : (G.coeff Γ : ℝ) = 0)) E.E
    (genericPoint_mem_support E.E)
  have hEeq : (m₁ : ℝ) * M₀'.coeff E.E = m₀ * M₁'.coeff E.E := by
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at hzero
    have : ((m₁ : ℤ) * M₀'.coeff E.E + (-(m₀ : ℤ)) * M₁'.coeff E.E : ℝ) = 0 := by
      exact_mod_cast hzero
    push_cast at this
    linarith
  have hm₀R : (0 : ℝ) < m₀ := by exact_mod_cast hm₀
  have hm₁R : (0 : ℝ) < m₁ := by exact_mod_cast hm₁
  have hEeq' : (1 / (m₁ : ℝ)) * M₁'.coeff E.E = (1 / (m₀ : ℝ)) * M₀'.coeff E.E := by
    field_simp
    linarith
  -- the log discrepancy over `(X, B)`
  have ha₀ := isLogDiscrepancy_sum (ι := Unit) hX hf hω0 hK hKω
    (w := 1) (by simp) (Bi := fun _ => QDivisor.toRDivisor B) (B := QDivisor.toRDivisor B)
    (by simp) (fun _ => hm₀)
    (fun _ => hM₀c) (fun _ Γ => by rw [QDivisor.coeff_toRDivisor, hM₀]) fun _ => ⟨hC₀, hpb₀⟩
  have h0 := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hE ha₀
  simp only [Pi.one_apply, one_mul, Finset.univ_unique, Finset.sum_singleton] at h0
  -- the log discrepancy over `(X, B - tT)`
  have hsum := isLogDiscrepancy_sum hX hf hω0 hK hKω (ι := Fin 2) (w := ![1 - (t : ℝ), t])
    (by simp) (Bi := ![QDivisor.toRDivisor B, QDivisor.toRDivisor (B - T)])
    (B := QDivisor.toRDivisor (B - t • T))
    (fun Γ => by
      simp [Fin.sum_univ_two, QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_sub,
        DivisorWithCoeffs.coeff_smul]
      ring)
    (m := ![m₀, m₁])
    (fun i => match i with | ⟨0, _⟩ => hm₀ | ⟨1, _⟩ => hm₁) (M := ![M₀, M₁])
    (M' := ![M₀', M₁'])
    (fun i => match i with | ⟨0, _⟩ => hM₀c | ⟨1, _⟩ => hM₁c)
    (fun i Γ => match i with
      | ⟨0, _⟩ => by simpa [QDivisor.coeff_toRDivisor] using hM₀ Γ
      | ⟨1, _⟩ => by simpa [QDivisor.coeff_toRDivisor] using hM₁ Γ)
    (fun i => match i with | ⟨0, _⟩ => ⟨hC₀, hpb₀⟩ | ⟨1, _⟩ => ⟨hC₁, hpb₁⟩)
  have hpos := hklt.2 n E _ hsum
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    hEeq'] at hpos
  nlinarith

/-- **Floor components over a point persist along a crepant step.** Let `f : X₁ ⟶ W` and
`fp : X₂ ⟶ W` be proper birational morphisms with `K₁ + B₁ = f^*(K_W + B_W)` and
`K₂ + B₂ = fp^*(K_W + B_W)`, and `(X₂, B₂ - t T₂)` klt with `T₂ ≥ 0`. If `Q₁` has coefficient one
in `B₁` and lies over a maximal point `z` of `Z` (through `gW : W ⟶ Z`), some component of `T₂`
lies over `z`: the divisor `Q₁` has log discrepancy zero over `(X₂, B₂)`, so its centre on `X₂`
lies on a component of `T₂`, and that centre lies over `f(Q₁)`. -/
private theorem exists_coeff_pos_map_genericPoint_eq_of_isPullback {X₁ X₂ W Z : Scheme.{0}}
    [IsIntegral X₁] [CompactSpace X₁] [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral X₂]
    [CompactSpace X₂] [IsLocallyNoetherian X₂] [IsNormal X₂] [IsIntegral W] [CompactSpace W]
    [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)} {f : X₁ ⟶ W} {fp : X₂ ⟶ W}
    (hX₁ : IsNormalVariety ℂ (f ≫ sW)) (hX₂ : IsNormalVariety ℂ (fp ≫ sW))
    (hWn : IsNormalVariety ℂ sW) [IsProper f] [IsProper fp] (hfb : IsBirationalMorphism f)
    (hfpb : IsBirationalMorphism fp) {d : ℕ} {K₁ : Divisor X₁} {K₂ : Divisor X₂}
    {KW : Divisor W} (hK₁ : K₁.IsCanonicalDivisor (f ≫ sW) d)
    (hK₂ : K₂.IsCanonicalDivisor (fp ≫ sW) d) (hKW : KW.IsCanonicalDivisor sW d)
    (hfK : MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap K₁ = KW)
    (hfpK : MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap K₂ = KW)
    {B₁ : QDivisor X₁} {B₂ T₂ : QDivisor X₂} {BW : QDivisor W} (hpair : MMP.Mori.IsPair sW BW)
    (hpb₁ : ∃ hB, (Divisor.toQDivisor KW + BW).IsPullback f hB (Divisor.toQDivisor K₁ + B₁))
    (hpb₂ : ∃ hB, (Divisor.toQDivisor KW + BW).IsPullback fp hB (Divisor.toQDivisor K₂ + B₂))
    (hP₂ : MMP.Mori.IsPair (fp ≫ sW) B₂) (hPT₂ : MMP.Mori.IsPair (fp ≫ sW) (B₂ - T₂))
    (hT₂0 : ∀ P, 0 ≤ T₂.coeff P) {t : ℚ} (ht0 : 0 < t) (ht1 : t ≤ 1)
    (hklt₂ : IsKltPair (fp ≫ sW) (B₂ - t • T₂)) {gW : W ⟶ Z} {z : Z}
    (hz : ∀ y : Z, y ⤳ z → y = z) (Q₁ : MMP.Mori.PrimeDivisor X₁) (hQ₁ : B₁.coeff Q₁ = 1)
    (hQz : gW (f Q₁.genericPoint) = z) :
    ∃ Γ : MMP.Mori.PrimeDivisor X₂, 0 < T₂.coeff Γ ∧ gW (fp Γ.genericPoint) = z := by
  haveI : LocallyOfFiniteType (f ≫ sW) := hX₁.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (fp ≫ sW) := hX₂.1.toLocallyOfFiniteType
  haveI : IsDominant f := hfb.isDominant
  haveI : IsDominant fp := hfpb.isDominant
  obtain ⟨hP₁, hc₁⟩ := hpair.isDiscrepancy_iff_of_crepant f hX₁ hfb hKW hK₁
    (Or.inr ⟨inferInstance, hfK, hpb₁⟩)
  obtain ⟨-, hc₂⟩ := hpair.isDiscrepancy_iff_of_crepant fp hX₂ hfpb hKW hK₂
    (Or.inr ⟨inferInstance, hfpK, hpb₂⟩)
  set D₁ := DivisorOver.ofPrimeDivisor ℂ hX₁ Q₁ with hD₁def
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP₁ hK₁ D₁
  have hc' : c = -1 := by rw [hc.eq_neg_coeff_of_ofPrimeDivisor hX₁, hQ₁]
  subst hc'
  set DW := MMP.Mori.compDivisorOver f hX₁ hfb D₁ with hDWdef
  have hcW := (hc₁ D₁ DW (MMP.Mori.valuation_compDivisorOver f hX₁ hfb D₁) _).mp hc
  obtain ⟨D₂, hD₂⟩ := MMP.Mori.exists_divisorOver_comap_eq hX₂ hfpb DW
  obtain ⟨E₂, hE₂⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hX₂ D₂
  have hvW : DW.valuation = E₂.toDivisorOver.valuation.comap (functionFieldMap fp) := by
    rw [hD₂]; exact congrArg (fun v => v.comap (functionFieldMap fp)) hE₂.symm
  have hc₂' := (hc₂ E₂.toDivisorOver DW hvW _).mpr hcW
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc₂' E₂.isProper
  have hl0 : MMP.Intersection.IsLogDiscrepancy (fp ≫ sW) d (QDivisor.toRDivisor B₂)
      E₂.toDivisorOver 0 := by
    convert hl using 1; push_cast; ring
  obtain ⟨Γ, hΓ, hcen⟩ :=
    exists_coeff_pos_of_isLogDiscrepancy_eq_zero hP₂ hPT₂ hT₂0 ht0 ht1 hklt₂ hl0
  refine ⟨Γ, hΓ, ?_⟩
  -- the centre of `E₂` lies over `f Q₁`
  have hcenW : fp (E₂.toDivisorOver.f E₂.toDivisorOver.E.genericPoint) = f Q₁.genericPoint := by
    have h := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hWn.1
      (D := MMP.Mori.compDivisorOver fp hX₂ hfpb E₂.toDivisorOver) (D' := DW)
      (by rw [MMP.Mori.valuation_compDivisorOver]; exact hvW.symm)
    change (E₂.toDivisorOver.f ≫ fp) E₂.toDivisorOver.E.genericPoint =
      (𝟙 X₁ ≫ f) Q₁.genericPoint at h
    rwa [Scheme.Hom.comp_apply, Category.id_comp] at h
  have hsp : Γ.genericPoint ⤳ E₂.toDivisorOver.f E₂.toDivisorOver.E.genericPoint := by
    rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hcen
  have h2 := (hsp.map fp.continuous).map gW.continuous
  apply hz
  rw [← hQz, ← hcenW]
  exact h2

/-- **A crepant proper birational morphism is a crepant birational map.** If `f : X₁ ⟶ W` is a
proper birational morphism of normal varieties and `B₁` is the crepant boundary of `(W, B_W)`, or
`K₁ + B₁ = f^*(K_W + B_W)` for compatible canonical divisors, then `f^* : k(W) ≅ k(X₁)` identifies
the divisorial log discrepancies of `(X₁, B₁)` and `(W, B_W)`: discrepancies of divisors with
corresponding valuations agree. -/
private theorem isCrepantBirationalMap_of_crepant {X₁ W : Scheme.{0}}
    [IsIntegral X₁] [CompactSpace X₁] [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral W]
    [CompactSpace W] [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)} {f : X₁ ⟶ W}
    (hX₁ : IsNormalVariety ℂ (f ≫ sW)) [IsProper f] (hfb : IsBirationalMorphism f) {d : ℕ}
    {K₁ : Divisor X₁} {KW : Divisor W} (hK₁ : K₁.IsCanonicalDivisor (f ≫ sW) d)
    (hKW : KW.IsCanonicalDivisor sW d) {B₁ : QDivisor X₁} {BW : QDivisor W}
    (hpair : MMP.Mori.IsPair sW BW)
    (hcr : IsCrepantBoundary sW d KW BW f hX₁ hfb B₁ ∨
      (IsProper f ∧ MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap K₁ = KW ∧
        ∃ hB, (Divisor.toQDivisor KW + BW).IsPullback f hB (Divisor.toQDivisor K₁ + B₁))) :
    haveI : IsDominant f := hfb.isDominant
    IsCrepantBirationalMap (f ≫ sW) sW B₁ BW
      (functionFieldAlgEquiv sW f hfb.functionFieldMap_bijective) := by
  haveI : LocallyOfFiniteType (f ≫ sW) := hX₁.1.toLocallyOfFiniteType
  haveI : IsDominant f := hfb.isDominant
  obtain ⟨hP₁, hc⟩ := hpair.isDiscrepancy_iff_of_crepant f hX₁ hfb hKW hK₁ hcr
  have hdX : topologicalKrullDim X₁ = d := hK₁.topologicalKrullDim_eq
  have hdW : topologicalKrullDim W = d := hKW.topologicalKrullDim_eq
  intro v a
  constructor
  · rintro ⟨n', E, hEv, hEa⟩
    obtain rfl : n' = d := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hEa).symm.trans hdX
      exact_mod_cast this
    obtain ⟨c, hcE⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP₁ hK₁ E
    obtain ⟨hEp, rfl⟩ := (MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hcE a).mp hEa
    have hcW := (hc E (MMP.Mori.compDivisorOver f hX₁ hfb E)
      (MMP.Mori.valuation_compDivisorOver f hX₁ hfb E) c).mp hcE
    refine ⟨n', MMP.Mori.compDivisorOver f hX₁ hfb E, ?_, ?_⟩
    · rw [MMP.Mori.valuation_compDivisorOver, hEv]
      rfl
    · haveI := hEp
      exact MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcW
        (show IsProper (E.f ≫ f) by infer_instance)
  · rintro ⟨n', D, hDv, hDa⟩
    obtain rfl : n' = d := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDa).symm.trans hdW
      exact_mod_cast this
    obtain ⟨E, hE⟩ := MMP.Mori.exists_divisorOver_comap_eq hX₁ hfb D
    obtain ⟨E', hE'⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hX₁ E
    obtain ⟨c, hcW⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hpair hKW D
    obtain ⟨-, rfl⟩ := (MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hcW a).mp hDa
    have hcE := (hc E'.toDivisorOver D (by
      rw [hE]; exact congrArg (fun w => w.comap (functionFieldMap f)) hE'.symm) c).mpr hcW
    have hv : E'.toDivisorOver.valuation = v := by
      change E'.valuation = v
      rw [hE']
      ext x
      obtain ⟨y, rfl⟩ := hfb.functionFieldMap_bijective.2 x
      have h3 := congrArg (fun w : Valuation W.functionField ℤᵐ⁰ => w y) (hE.symm.trans hDv)
      exact h3
    exact ⟨n', E'.toDivisorOver, hv,
      MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcE E'.isProper⟩

/-- **One step of the floor-lowering program.** A step of the klt program with scaling for
`B₁ - t₀ T₁`, from a model satisfying `FloorInv`, contracts a `(K₁ + B₁)`-null negative extremal
ray of `NE̅(X₁/Z)`, and the invariants pass to the next model with the transformed divisors; the
Cartier divisor `m D₁` and its transform `m D₂` are pull-backs of one Cartier divisor on the
base of the contraction. -/
private theorem step {X₁ X₂ W Z : Scheme.{0}} [IsIntegral X₁] [CompactSpace X₁]
    [IsLocallyNoetherian X₁] [IsNormal X₁] [IsIntegral X₂] [CompactSpace X₂]
    [IsLocallyNoetherian X₂] [IsNormal X₂] {s₁ : X₁ ⟶ Spec (.of ℂ)} {s₂ : X₂ ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {π₁ : X₁ ⟶ Z} {π₂ : X₂ ⟶ Z}
    {f : X₁ ⟶ W} {gW : W ⟶ Z} {fp : X₂ ⟶ W} {ψ : X₁.RationalMap X₂}
    {KS₁ K₁ : Divisor X₁} {B₁ T₁ : QDivisor X₁} {Δ₁ : RDivisor X₁} {Δ₂ : RDivisor X₂} {m : ℕ}
    {t₀ : ℚ} (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    (h1 : π₁ ≫ sZ = s₁) (hp1 : MMP.Mori.IsProjectiveVariety ℂ s₁) (hq1 : IsQFactorial s₁)
    (hKS₁ : ∃ n, KS₁.IsCanonicalDivisor s₁ n)
    (h2 : π₂ ≫ sZ = s₂) (hp2 : MMP.Mori.IsProjectiveVariety ℂ s₂) (hq2 : IsQFactorial s₂)
    (hdlt2 : MMP.Intersection.IsDltPair s₂ (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      t₀ • MMP.Mori.RationalMap.transformDivisor ψ T₁))
    (hW : MMP.Mori.IsProjectiveVariety ℂ sW) (hfg : f ≫ gW = π₁) (hfpg : fp ≫ gW = π₂)
    (hneg : IsNegativeExtremalContraction ℂ s₁ sW (logCanonicalDivisor KS₁ Δ₁) f)
    (hdf : (IsBirationalMorphism f ∧
        (∃ E : MMP.Mori.PrimeDivisor X₁, (MMP.Mori.exceptionalSet f : Set X₁) = E.support) ∧
        IsIso fp ∧ IsModificationOf f fp ψ) ∨
      MMP.Flips.IsFlip ℂ s₁ sW s₂ (logCanonicalDivisor KS₁ Δ₁) f fp ψ)
    (hΔ₂ : Δ₂ = MMP.Mori.RationalMap.transformDivisor ψ Δ₁)
    (hm : 0 < m) (ht₀ : 0 < t₀) (ht₀1 : t₀ ≤ 1)
    (hinv : FloorInv s₁ π₁ m t₀ K₁ B₁ T₁ Δ₁) :
    (∃ R : Set (RelativeNumericalCurveClasses s₁ π₁),
      IsNegativeRelativeRayContraction s₁ π₁ sW (Divisor.toQDivisor KS₁ + (B₁ - t₀ • T₁)) R f gW ∧
      ∃ h : (Divisor.toQDivisor KS₁ + B₁).IsQCartier,
        ∀ u ∈ R, QDivisor.relativeCurveForm s₁ π₁ (Divisor.toQDivisor KS₁ + B₁) h u = 0) ∧
    FloorInv s₂ π₂ m t₀ (MMP.Mori.RationalMap.transformDivisor ψ K₁)
      (MMP.Mori.RationalMap.transformDivisor ψ B₁) (MMP.Mori.RationalMap.transformDivisor ψ T₁)
      Δ₂ ∧
    (IsBirationalMorphism f ∧ IsBirationalMorphism fp ∧ IsProper fp ∧ IsProper f ∧
      ψ.compHom fp = f.toRationalMap ∧ gW ≫ sZ = sW ∧ IsNormalVariety ℂ sW ∧
      (∀ Q : MMP.Mori.PrimeDivisor X₂, ∃ P' : MMP.Mori.PrimeDivisor W,
        fp Q.genericPoint = P'.genericPoint) ∧
      ∃ (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W) (_ : CompactSpace W),
      ∀ Dm₁ : Divisor X₁, Dm₁.IsCartier →
        Divisor.toQDivisor Dm₁ = (m : ℤ) • (Divisor.toQDivisor K₁ + B₁) →
        ∃ (G : Divisor W) (_ : G.IsCartier)
          (hB₁ : ∀ Z' : irreducibleComponents X₁, f (componentGenericPoint X₁ Z') ∉ G.supp)
          (hB₂ : ∀ Z' : irreducibleComponents X₂, fp (componentGenericPoint X₂ Z') ∉ G.supp)
          (Dm₂ : Divisor X₂), Divisor.toQDivisor Dm₂ = (m : ℤ) •
            (Divisor.toQDivisor (MMP.Mori.RationalMap.transformDivisor ψ K₁) +
              MMP.Mori.RationalMap.transformDivisor ψ B₁) ∧
          G.IsPullback f hB₁ Dm₁ ∧ G.IsPullback fp hB₂ Dm₂) ∧
    (∀ z : Z, (∀ y : Z, y ⤳ z → y = z) → ∀ Q₁ : MMP.Mori.PrimeDivisor X₁, 0 < T₁.coeff Q₁ →
      π₁ Q₁.genericPoint = z → ∃ Q₂ : MMP.Mori.PrimeDivisor X₂,
        0 < (MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q₂ ∧ π₂ Q₂.genericPoint = z) ∧
    ∃ (_ : IsIntegral W) (_ : IsDominant f) (_ : IsDominant fp) (σ : FunctionFieldEquiv s₁ s₂),
      IsCrepantBirationalMap s₁ s₂ B₁ (MMP.Mori.RationalMap.transformDivisor ψ B₁) σ ∧
      ∀ a, (σ.toHom) (functionFieldMap fp a) = functionFieldMap f a := by
  obtain rfl := hinv.toRDivisor_eq
  obtain ⟨hDm, hK₁, hnef, hnef', hklt, hlc, hT0, hBT0, hTint, -⟩ := id hinv
  have hfW : f ≫ sW = s₁ := hneg.isContraction.comp_eq
  have hgW : gW ≫ sZ = sW := eq_of_comp_eq_of_isIso_app_top f (hneg.isContraction.isIso_app ⊤)
    (by rw [← Category.assoc, hfg, h1, hfW])
  rw [logCanonicalDivisor_toRDivisor] at hneg hdf
  obtain ⟨R, hRc, hface, hray, C₀, hC₀, hR₀⟩ :=
    exists_isNegativeRelativeRayContraction hp1 hW hZ hq1 hfg hgW hneg
  obtain ⟨⟨hDq, hnull⟩, hEneg, hD0⟩ := exists_forall_relativeCurveForm_eq_zero hp1 hq1 hfg hK₁
    hKS₁ ht₀ hnef hnef' hneg hray hC₀ hR₀
  refine ⟨⟨R, hRc, hDq, hnull⟩, ?_⟩
  subst hfW
  have hfpW : fp ≫ sW = s₂ := by rw [← h2, ← hfpg, Category.assoc, hgW]
  subst hfpW
  -- the setting of the step
  have hX₁n : IsNormalVariety ℂ (f ≫ sW) := hq1.1
  have hX₂n : IsNormalVariety ℂ (fp ≫ sW) := hq2.1
  have hWn : IsNormalVariety ℂ sW := hneg.isNormalVariety_target
  haveI : IsIntegral W := hWn.1.toIsIntegral
  haveI : IsNormal W := hWn.2
  haveI : LocallyOfFiniteType sW := hWn.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian sW
  haveI : QuasiCompact sW := hWn.1.toQuasiCompact
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace sW
  haveI : IsProper f := hneg.isContraction.isProper
  have hcase : IsBirationalMorphism f ∧ IsBirationalMorphism fp ∧ IsProper fp ∧
      ψ.compHom fp = f.toRationalMap ∧ ∃ V : TopologicalSpace.Closeds X₂,
        2 ≤ closedsCodimension V ∧ IsOpenImmersion (Scheme.Opens.ι (V.compl : X₂.Opens) ≫ fp) := by
    rcases hdf with ⟨hfb, -, hiso, hmod⟩ | hflip
    · refine ⟨hfb, isBirationalMorphism_of_isIso fp, inferInstance, hmod.2, ⊥,
        le_closedsCodimension_iff.mpr fun W' hW' => ?_, inferInstance⟩
      obtain ⟨x, hx⟩ := W'.isIrreducible.nonempty
      exact absurd (hW' hx) (by simp)
    · refine ⟨hflip.isSmall_source.isBirationalMorphism, hflip.isSmall.isBirationalMorphism,
        hflip.isProper, hflip.isModificationOf.2, ?_⟩
      obtain ⟨V, W', hV, -, hle, hiso⟩ := hflip.isSmall.exists_isIso
      refine ⟨V, hV, ?_⟩
      rw [← Scheme.Hom.resLE_comp_ι fp hle]
      infer_instance
  obtain ⟨hfb, hfpb, hfpP, hψ, V, hV, hVimm⟩ := hcase
  haveI := hfpP
  haveI : IsDominant f := hfb.isDominant
  haveI : IsDominant fp := hfpb.isDominant
  have hfpQ := exists_genericPoint_eq_of_isOpenImmersion fp V hV hVimm
  have hT1 : ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X₁),
      MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap
          (MMP.Mori.RationalMap.transformDivisor ψ D) =
        MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap D := fun D =>
    transformDivisor_transformDivisor_of_compHom_eq hX₁n hX₂n hWn rfl rfl hfb hfpb hψ D
  have hcoef : ∀ Q : MMP.Mori.PrimeDivisor X₂, ∃ E : MMP.Mori.PrimeDivisor X₁,
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R X₁),
        MMP.Mori.RationalMap.transformDivisor ψ D Q = D E := fun Q => by
    obtain ⟨P', hP'⟩ := hfpQ Q
    obtain ⟨E, -, hE⟩ := exists_transformDivisor_apply_eq_of_compHom_eq hX₁n hX₂n hWn rfl rfl
      hfb hfpb hψ P' Q hP'
    exact ⟨E, hE⟩
  -- dimensions and canonical divisors
  have hdim₁ : topologicalKrullDim X₁ = 3 := hK₁.topologicalKrullDim_eq
  haveI : AlgebraicGeometry.IsVariety ℂ sW := hWn.1
  haveI : AlgebraicGeometry.IsVariety ℂ (f ≫ sW) := hX₁n.1
  haveI : AlgebraicGeometry.IsVariety ℂ (fp ≫ sW) := hX₂n.1
  have hdimW : topologicalKrullDim W = 3 :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW (f ≫ sW) hfb).trans hdim₁
  have hdim₂ : topologicalKrullDim X₂ = 3 :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sW (fp ≫ sW) hfpb).symm.trans
      hdimW
  obtain ⟨KW₀, hKW₀⟩ := MMP.Mori.exists_isCanonicalDivisor sW hWn (n := 3) (by exact_mod_cast hdimW)
  have hKW : Divisor.IsCanonicalDivisor sW 3
      (MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap K₁) :=
    MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hWn hX₁n hfb hKW₀ hK₁
  obtain ⟨K₂₀, hK₂₀⟩ := MMP.Mori.exists_isCanonicalDivisor (fp ≫ sW) hX₂n (n := 3)
    (by exact_mod_cast hdim₂)
  obtain ⟨K'', hK'', hK''eq⟩ :=
    MMP.Fourfold.Oai4C1.Main.exists_isCanonicalDivisor_transformDivisor_eq
      hWn hX₂n hfpb hKW hK₂₀
  have hK₂eq : MMP.Mori.RationalMap.transformDivisor ψ K₁ = K'' :=
    transformDivisor_injective_of_forall_exists hX₂n hWn rfl hfpb hfpQ (by rw [hT1, hK''eq])
  have hK₂ : Divisor.IsCanonicalDivisor (fp ≫ sW) 3 (MMP.Mori.RationalMap.transformDivisor ψ K₁) :=
    hK₂eq ▸ hK''
  -- Cartier descent of `m D₁`
  obtain ⟨n₁, hKSn⟩ := hKS₁
  have hn₁ : n₁ = 3 := by
    have h1 := hKSn.topologicalKrullDim_eq
    rw [hdim₁] at h1
    exact_mod_cast h1.symm
  subst hn₁
  have hkltM : MMP.Mori.IsKltPair (f ≫ sW) 3 KS₁ (B₁ - T₁) :=
    (isKltPair_iff_mori_isKltPair (f ≫ sW) hKSn hklt.1).1 hklt
  obtain ⟨hEq, hEray, hEneg'⟩ := hEneg
  have hFneg : IsNegativeExtremalFace ℝ (closedConeOfCurves (f ≫ sW) :
      Set (NumericalCurveClasses (f ≫ sW)))
      (MMP.Fourfold.QDivisor.curveForm (f ≫ sW) (Divisor.toQDivisor KS₁ + (B₁ - T₁))
        hkltM.1.2.2) (relativeToAbsolute (f ≫ sW) π₁ '' R) :=
    ⟨hEray.1, hEray.1.2.2.1, fun z hz hz0 => hEneg' z hz hz0⟩
  haveI : QuasiCompact (f ≫ sW) := hX₁n.1.toQuasiCompact
  have hdesc : ∀ Dm₁ : Divisor X₁, Dm₁.IsCartier →
      Divisor.toQDivisor Dm₁ = (m : ℤ) • (Divisor.toQDivisor K₁ + B₁) →
      ∃ (G : Divisor W) (_ : G.IsCartier)
        (hB₁ : ∀ Z' : irreducibleComponents X₁, f (componentGenericPoint X₁ Z') ∉ G.supp)
        (hB₂ : ∀ Z' : irreducibleComponents X₂, fp (componentGenericPoint X₂ Z') ∉ G.supp)
        (Dm₂ : Divisor X₂), Divisor.toQDivisor Dm₂ = (m : ℤ) •
          (Divisor.toQDivisor (MMP.Mori.RationalMap.transformDivisor ψ K₁) +
            MMP.Mori.RationalMap.transformDivisor ψ B₁) ∧
        G.IsPullback f hB₁ Dm₁ ∧ G.IsPullback fp hB₂ Dm₂ := by
    intro Dm₁ hDm₁c hDm₁
    have hdeg : ∀ C : ProperCurve (f ≫ sW), OneCycle.numericalClass (f ≫ sW) (C.cycle ℝ) ∈
        relativeToAbsolute (f ≫ sW) π₁ '' R → Dm₁.degreeOn ℂ (f ≫ sW) C.ι C.dim_le hDm₁c = 0 := by
      intro C hC
      have h0 := hD0 C hC
      rw [QDivisor.intersectionNumber_eq_of_smul ℂ (f ≫ sW) C.ι C.dim_le _ _ hm Dm₁ hDm₁c hDm₁,
        div_eq_zero_iff] at h0
      rcases h0 with h0 | h0
      · exact_mod_cast h0
      · exact absurd h0 (by exact_mod_cast hm.ne')
    obtain ⟨G, hGc, hB₁, hpb₁⟩ := exists_isPullback_of_isContractionOfFace hp1 hkltM
      (fun P => (hBT0 P).1) hFneg hface hfb hDm₁c hdeg
    have hB₂ := forall_map_componentGenericPoint_notMem_supp (f := fp) G
    have hpb₂ := Divisor.isPullback_pullback hGc hB₂
    have hfG : MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap Dm₁ = G :=
      MMP.Positivity.transformDivisor_of_isPullback_divisor hWn hX₁n hfb hGc hpb₁
    have hfpG : MMP.Mori.RationalMap.transformDivisor (X := X₂) fp.toRationalMap
        (G.pullback hGc hB₂) = G :=
      MMP.Positivity.transformDivisor_of_isPullback_divisor hWn hX₂n hfpb hGc hpb₂
    have hDm₂eq : MMP.Mori.RationalMap.transformDivisor ψ Dm₁ = G.pullback hGc hB₂ :=
      transformDivisor_injective_of_forall_exists hX₂n hWn rfl hfpb hfpQ (by rw [hT1, hfG, hfpG])
    refine ⟨G, hGc, hB₁, hB₂, G.pullback hGc hB₂, ?_, hpb₁, hpb₂⟩
    rw [← hDm₂eq, ← transformDivisor_toQDivisor, hDm₁, map_zsmul, map_add,
      transformDivisor_toQDivisor]
  obtain ⟨Dm₁, hDm₁c, hDm₁⟩ := hDm
  obtain ⟨G, hGc, hB₁, hB₂, Dm₂, hDm₂, hpb₁, hpb₂⟩ := hdesc Dm₁ hDm₁c hDm₁
  have hDm₂c : Dm₂.IsCartier := hpb₂.pullback_eq hGc ▸ hGc.isCartier_pullback fp hB₂
  have hfG : MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap Dm₁ = G :=
    MMP.Positivity.transformDivisor_of_isPullback_divisor hWn hX₁n hfb hGc hpb₁
  -- coefficients of the transformed boundaries
  have hBT₂ : ∀ Q, 0 ≤ (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q ∧
      (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
        MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q < 1 ∧
      (MMP.Mori.RationalMap.transformDivisor ψ B₁).coeff Q ≤ 1 := fun Q => by
    obtain ⟨E, hE⟩ := hcoef Q
    rw [← map_sub]
    change (0 : ℚ) ≤ MMP.Mori.RationalMap.transformDivisor ψ (B₁ - T₁) Q ∧
      MMP.Mori.RationalMap.transformDivisor ψ (B₁ - T₁) Q < 1 ∧
      MMP.Mori.RationalMap.transformDivisor ψ B₁ Q ≤ 1
    rw [hE, hE]
    exact hBT0 E
  have hT₂ : ∀ Q, 0 ≤ (MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q := fun Q => by
    obtain ⟨E, hE⟩ := hcoef Q
    change (0 : ℚ) ≤ MMP.Mori.RationalMap.transformDivisor ψ T₁ Q
    rw [hE]
    exact hT0 E
  have hBt₂ : ∀ Q, 0 ≤ (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      t₀ • MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q := fun Q => by
    obtain ⟨E, hE⟩ := hcoef Q
    have hsm := (MMP.Mori.RationalMap.transformDivisorₗ ℚ ψ).map_smul t₀ T₁
    simp only [MMP.Mori.RationalMap.transformDivisorₗ_apply] at hsm
    rw [← hsm, ← map_sub]
    change (0 : ℚ) ≤ MMP.Mori.RationalMap.transformDivisor ψ (B₁ - t₀ • T₁) Q
    rw [hE]
    exact hinv.coeff_sub_smul_nonneg ht₀1 E
  have hB₂0 : ∀ Q, 0 ≤ (MMP.Mori.RationalMap.transformDivisor ψ B₁).coeff Q := fun Q => by
    obtain ⟨E, hE⟩ := hcoef Q
    change (0 : ℚ) ≤ MMP.Mori.RationalMap.transformDivisor ψ B₁ Q
    rw [hE]
    exact hlc.2.1 E
  have hΔ₂' : QDivisor.toRDivisor (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      t₀ • MMP.Mori.RationalMap.transformDivisor ψ T₁) = Δ₂ := by
    have hsm := (MMP.Mori.RationalMap.transformDivisorₗ ℚ ψ).map_smul t₀ T₁
    simp only [MMP.Mori.RationalMap.transformDivisorₗ_apply] at hsm
    rw [hΔ₂, transformDivisor_toRDivisor]
    congr 1
    rw [map_sub, hsm]
  -- klt, by lowering the klt boundary `B₂ - t₀ T₂`
  have hklt₂ : IsKltPair (fp ≫ sW) (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      MMP.Mori.RationalMap.transformDivisor ψ T₁) := by
    refine MMP.Intersection.IsDltPair.isKltPair_of_forall_coeff_lt_one
      (MMP.Intersection.IsDltPair.of_le (fp ≫ sW) hdlt2 (fun P => (hBT₂ P).1) (fun P => ?_)
        (isQCartier_of_isQFactorial (fp ≫ sW) hq2 _)) (fun P => (hBT₂ P).2.1)
    change (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff P ≤
        (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
          t₀ • MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff P
    have := hT₂ P
    have ht1 : t₀ ≤ 1 := ht₀1
    simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    nlinarith
  -- lc, by crepant invariance through `W`
  have hGq : Divisor.toQDivisor G = (m : ℤ) •
      (Divisor.toQDivisor (MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap K₁) +
        MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap B₁) := by
    rw [← hfG, ← transformDivisor_toQDivisor, hDm₁, map_zsmul, map_add,
      transformDivisor_toQDivisor]
  have hpairW : MMP.Mori.IsPair sW
      (MMP.Mori.RationalMap.transformDivisor (X := X₁) f.toRationalMap B₁) :=
    ⟨hWn, 3, _, hKW, ⟨m, by exact_mod_cast hm.ne', G, hGq, hGc⟩⟩
  have hlc₂ : MMP.Intersection.IsLogCanonicalPair (fp ≫ sW)
      (MMP.Mori.RationalMap.transformDivisor ψ B₁) :=
    isLogCanonicalPair_of_isPullback_of_isPullback hX₁n hX₂n hfb hfpb hK₁ hK₂ hKW rfl
      (hT1 K₁) hpairW
      ⟨_, qDivisor_isPullback_of_isPullback hGc hpb₁ hm hGq hDm₁
        (forall_map_componentGenericPoint_notMem_supp (f := f) _)⟩
      ⟨_, qDivisor_isPullback_of_isPullback hGc hpb₂ hm hGq hDm₂
        (forall_map_componentGenericPoint_notMem_supp (f := fp) _)⟩ hlc hB₂0
  -- nef
  haveI : Surjective f := by
    refine ⟨Set.range_eq_univ.mp ?_⟩
    rw [← f.isClosedMap.isClosed_range.closure_eq]
    exact f.denseRange.closure_range
  have hnef₂ := isRelativelyNef_of_isPullback (gW := gW) hWn hX₁n hX₂n rfl rfl hGc hpb₁ hpb₂ hm
    hDm₁ hDm₂ (by rw [hfg]; exact hnef)
  rw [hfpg] at hnef₂
  have hpb₁' := Divisor.IsPullback.zsmul hGc hpb₁ (-1)
    (forall_map_componentGenericPoint_notMem_supp (f := f) _)
  have hpb₂' := Divisor.IsPullback.zsmul hGc hpb₂ (-1)
    (forall_map_componentGenericPoint_notMem_supp (f := fp) _)
  have hneg1 : ∀ {Y : Scheme.{0}} (D : Divisor Y) (D' : QDivisor Y),
      Divisor.toQDivisor D = (m : ℤ) • D' →
      Divisor.toQDivisor ((-1 : ℤ) • D) = (m : ℤ) • (-D') := fun D D' h => by
    rw [map_zsmul, h, smul_smul, mul_comm, ← smul_smul, neg_one_zsmul, smul_neg]
  have hnef₂' := isRelativelyNef_of_isPullback (gW := gW) hWn hX₁n hX₂n rfl rfl
    (hGc.zsmul (-1)) hpb₁' hpb₂' hm (hneg1 _ _ hDm₁) (hneg1 _ _ hDm₂)
    (by rw [hfg]; exact hnef')
  rw [hfpg] at hnef₂'
  have hTint₂ : ∀ Q, (MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q = 0 ∨
      (MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q = 1 := fun Q => by
    obtain ⟨E, hE⟩ := hcoef Q
    change MMP.Mori.RationalMap.transformDivisor ψ T₁ Q = 0 ∨
      MMP.Mori.RationalMap.transformDivisor ψ T₁ Q = 1
    rw [hE]
    exact hTint E
  have hk₂t : IsKltPair (fp ≫ sW) (MMP.Mori.RationalMap.transformDivisor ψ B₁ -
      t₀ • MMP.Mori.RationalMap.transformDivisor ψ T₁) :=
    MMP.Intersection.IsDltPair.isKltPair_of_forall_coeff_lt_one hdlt2 (fun Q => by
      obtain ⟨E, hE⟩ := hcoef Q
      have hsm := (MMP.Mori.RationalMap.transformDivisorₗ ℚ ψ).map_smul t₀ T₁
      simp only [MMP.Mori.RationalMap.transformDivisorₗ_apply] at hsm
      rw [← hsm, ← map_sub]
      change MMP.Mori.RationalMap.transformDivisor ψ (B₁ - t₀ • T₁) Q < 1
      rw [hE]
      have h1 := hBT0 E
      have h2 := hT0 E
      simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h1 ⊢
      change B₁.coeff E - t₀ * T₁.coeff E < 1
      rcases h2.eq_or_lt with h | h
      · rw [← h] at h1 ⊢; linarith [h1.2.1]
      · nlinarith [h1.2.2])
  have hhor : ∀ z : Z, (∀ y : Z, y ⤳ z → y = z) → ∀ Q₁ : MMP.Mori.PrimeDivisor X₁,
      0 < T₁.coeff Q₁ → π₁ Q₁.genericPoint = z → ∃ Q₂ : MMP.Mori.PrimeDivisor X₂,
        0 < (MMP.Mori.RationalMap.transformDivisor ψ T₁).coeff Q₂ ∧ π₂ Q₂.genericPoint = z := by
    intro z hz Q₁ hQ₁ hQz
    have hQ₁1 : B₁.coeff Q₁ = 1 := by
      have h1 := hBT0 Q₁
      simp only [DivisorWithCoeffs.coeff_sub] at h1
      rcases hTint Q₁ with h | h
      · rw [h] at hQ₁; exact absurd hQ₁ (lt_irrefl 0)
      · rw [h] at h1; linarith [h1.1, h1.2.2]
    obtain ⟨Γ, hΓ, hΓz⟩ := exists_coeff_pos_map_genericPoint_eq_of_isPullback hX₁n hX₂n hWn hfb
      hfpb hK₁ hK₂ hKW rfl (hT1 K₁) hpairW
      ⟨_, qDivisor_isPullback_of_isPullback hGc hpb₁ hm hGq hDm₁
        (forall_map_componentGenericPoint_notMem_supp (f := f) _)⟩
      ⟨_, qDivisor_isPullback_of_isPullback hGc hpb₂ hm hGq hDm₂
        (forall_map_componentGenericPoint_notMem_supp (f := fp) _)⟩ hlc₂.1 hklt₂.1.isPair hT₂
      ht₀ ht₀1 hk₂t hz Q₁ hQ₁1 (by rw [← hQz, ← hfg]; rfl)
    exact ⟨Γ, hΓ, by rw [← hfpg]; exact hΓz⟩
  have crepA := isCrepantBirationalMap_of_crepant hX₁n hfb hK₁ hKW hpairW
    (Or.inr ⟨inferInstance, rfl, _, qDivisor_isPullback_of_isPullback hGc hpb₁ hm hGq hDm₁
      (forall_map_componentGenericPoint_notMem_supp (f := f) _)⟩)
  have crepB := isCrepantBirationalMap_of_crepant hX₂n hfpb hK₂ hKW hpairW
    (Or.inr ⟨inferInstance, hT1 K₁, _, qDivisor_isPullback_of_isPullback hGc hpb₂ hm hGq hDm₂
      (forall_map_componentGenericPoint_notMem_supp (f := fp) _)⟩)
  refine ⟨⟨⟨Dm₂, hDm₂c, hDm₂⟩, hK₂, hnef₂, hnef₂', hklt₂, hlc₂, hT₂, hBT₂, hTint₂, hΔ₂'⟩,
    ⟨hfb, hfpb, hfpP, inferInstance, hψ, hgW, hWn, hfpQ, inferInstance, inferInstance,
      inferInstance, inferInstance, hdesc⟩, hhor, inferInstance, inferInstance, inferInstance, _,
      crepA.trans crepB.symm, fun a => ?_⟩
  letI := functionFieldAlgebra sW
  letI := functionFieldAlgebra (f ≫ sW)
  letI := functionFieldAlgebra (fp ≫ sW)
  change (functionFieldAlgEquiv sW f hfb.functionFieldMap_bijective)
    ((functionFieldAlgEquiv sW fp hfpb.functionFieldMap_bijective).symm
      ((functionFieldAlgEquiv sW fp hfpb.functionFieldMap_bijective) a)) = _
  rw [AlgEquiv.symm_apply_apply]
  rfl

/-- **One step of a program.** Let `P` be a projective relative dlt program over a projective
base `Z` for `(X, B - ½⌊B⌋)`. If the model `X_i`, `i < n`, satisfies the invariants `FloorInv`
for the transforms of `K`, `B`, `⌊B⌋`, so does `X_{i+1}`, and every component of the transform of
`⌊B⌋` on `X_i` over a maximal point `z` of `Z` gives one on `X_{i+1}`. -/
private theorem floorInv_succ {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z] {sX : X ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {π : X ⟶ Z} {K : Divisor X} {B : QDivisor X}
    {m : ℕ} (hm : 0 < m)
    (P : RelativeDltProgram sX sZ π K (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown))
    (hPp : P.IsProjective) (i : ℕ) (hi : ((i + 1 : ℕ) : ℕ∞) ≤ P.n)
    (hinv : FloorInv (modelStr sX P.sY i) (modelMap π P.πY i) m (1 / 2) (iterTransform P.φ K i)
        (iterTransform P.φ B i) (iterTransform P.φ (Divisor.toQDivisor B.roundDown) i)
        (QDivisor.toRDivisor
          (divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY i))) :
    FloorInv (modelStr sX P.sY (i + 1)) (modelMap π P.πY (i + 1)) m (1 / 2)
        (iterTransform P.φ K (i + 1)) (iterTransform P.φ B (i + 1))
        (iterTransform P.φ (Divisor.toQDivisor B.roundDown) (i + 1))
        (QDivisor.toRDivisor
          (divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY (i + 1))) ∧
      (∀ z : Z, (∀ y : Z, y ⤳ z → y = z) →
        ∀ Q₁ : MMP.Mori.PrimeDivisor (modelSeq X P.Y i),
          0 < (iterTransform P.φ (Divisor.toQDivisor B.roundDown) i).coeff Q₁ →
          modelMap π P.πY i Q₁.genericPoint = z →
          ∃ Q₂ : MMP.Mori.PrimeDivisor (modelSeq X P.Y (i + 1)),
            0 < (iterTransform P.φ (Divisor.toQDivisor B.roundDown) (i + 1)).coeff Q₂ ∧
            modelMap π P.πY (i + 1) Q₂.genericPoint = z) ∧
      ∀ _ : IsDominant (modelMap π P.πY i), ∃ (_ : IsDominant (modelMap π P.πY (i + 1)))
        (σ : FunctionFieldEquiv (modelStr sX P.sY i) (modelStr sX P.sY (i + 1))),
        IsCrepantBirationalMap (modelStr sX P.sY i) (modelStr sX P.sY (i + 1))
          (iterTransform P.φ B i) (iterTransform P.φ B (i + 1)) σ ∧
        ∀ a : Z.functionField, (σ.toHom) (functionFieldMap (modelMap π P.πY (i + 1)) a) =
          functionFieldMap (modelMap π P.πY i) a := by
  have hi' : (i : ℕ∞) < P.n :=
    lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self i) hi
  obtain ⟨-, hPm⟩ := hPp
  have hm1 := P.isRelativeDltModel i hi'.le
  have hm2 := P.isRelativeDltModel (i + 1) hi
  have hst := P.isElementaryDltStep i hi'
  have hBY := P.BY_eq i hi'
  have hneg := hst.isNegativeRelativeRayContraction.isNegativeExtremalContraction
  have hface := hst.isNegativeRelativeRayContraction.isRelativeContractionOfFace
  have hWn := hneg.isNormalVariety_target
  have hgW : P.gZ i ≫ sZ = P.sZ i := by
    haveI : IsAffine (Spec (.of ℂ)) := inferInstance
    exact eq_of_comp_eq_of_isIso_app_top (P.f i) (hneg.isContraction.isIso_app ⊤)
      (by rw [← Category.assoc, hface.comp_eq, hm1.comp_eq, hneg.isContraction.comp_eq])
  have hW : MMP.Mori.IsProjectiveVariety ℂ (P.sZ i) :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr
      ⟨hWn.1, hgW ▸ hface.isProjectiveMorphism.comp hZ.isProjective⟩
  have hBi : divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY i =
      iterTransform P.φ B i - (1 / 2 : ℚ) •
        iterTransform P.φ (Divisor.toQDivisor B.roundDown) i :=
    QDivisor.toRDivisor_injective hinv.toRDivisor_eq.symm
  have hsm := (MMP.Mori.RationalMap.transformDivisorₗ ℚ (P.φ i)).map_smul (1 / 2 : ℚ)
    (iterTransform P.φ (Divisor.toQDivisor B.roundDown) i)
  simp only [MMP.Mori.RationalMap.transformDivisorₗ_apply] at hsm
  have hBY' : P.BY i = MMP.Mori.RationalMap.transformDivisor (P.φ i) (iterTransform P.φ B i) -
      (1 / 2 : ℚ) • MMP.Mori.RationalMap.transformDivisor (P.φ i)
        (iterTransform P.φ (Divisor.toQDivisor B.roundDown) i) := by
    rw [hBY, hBi, map_sub, hsm]
  have hdlt2 : MMP.Intersection.IsDltPair (P.sY i)
      (MMP.Mori.RationalMap.transformDivisor (P.φ i) (iterTransform P.φ B i) -
        (1 / 2 : ℚ) • MMP.Mori.RationalMap.transformDivisor (P.φ i)
          (iterTransform P.φ (Divisor.toQDivisor B.roundDown) i)) := by
    rw [← hBY']; exact hm2.isDltPair
  have hneg' : IsNegativeExtremalContraction ℂ (modelStr sX P.sY i) (P.sZ i)
      (logCanonicalDivisor (divisorSeq K P.KY i) (QDivisor.toRDivisor
        (divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY i))) (P.f i) := by
    rw [logCanonicalDivisor_toRDivisor]; exact hneg
  have hdf := hst.divisorial_or_flip
  rw [← logCanonicalDivisor_toRDivisor] at hdf
  have hΔ₂ : QDivisor.toRDivisor (P.BY i) = MMP.Mori.RationalMap.transformDivisor (P.φ i)
      (QDivisor.toRDivisor
        (divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY i)) := by
    rw [transformDivisor_toRDivisor, ← hBY]
  have h := step (X₂ := P.Y i) hZ hm1.comp_eq (hPm i hi'.le) hm1.isQFactorial
    hm1.isCanonicalDivisor hm2.comp_eq (hPm (i + 1) hi) hm2.isQFactorial hdlt2 hW
    hface.comp_eq hst.comp_eq hneg' hdf hΔ₂ hm (by norm_num) (by norm_num) hinv
  obtain ⟨hWi, hfd, hfpd, σ, hσc, hσr⟩ := h.2.2.2.2
  haveI := hWi
  haveI := hfd
  haveI := hfpd
  refine ⟨h.2.1, h.2.2.2.1, fun hπi => ?_⟩
  haveI : IsDominant (P.f i ≫ P.gZ i) := by rw [hface.comp_eq]; exact hπi
  haveI : IsDominant (P.gZ i) := IsDominant.of_comp (P.f i) (P.gZ i)
  haveI hd2 : IsDominant (P.fp i ≫ P.gZ i) :=
    (IsDominant.comp_iff (f := P.fp i) (g := P.gZ i)).mpr this
  have hd2' : IsDominant (modelMap π P.πY (i + 1)) := by
    change IsDominant (P.πY i); rw [← hst.comp_eq]; exact hd2
  refine ⟨hd2', σ, hσc, fun a => ?_⟩
  have e1 : functionFieldMap (modelMap π P.πY (i + 1)) a =
      functionFieldMap (P.fp i) (functionFieldMap (P.gZ i) a) := by
    have h1 := congrArg (fun φ => φ a)
      (@MMP.Positivity.DivisorOver.functionFieldMap_congr _ _ _ _ (P.πY i) (P.fp i ≫ P.gZ i) hd2'
        hd2 hst.comp_eq.symm)
    rw [← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply] at h1
    exact h1
  have e2 : functionFieldMap (modelMap π P.πY i) a =
      functionFieldMap (P.f i) (functionFieldMap (P.gZ i) a) := by
    have h1 := congrArg (fun φ => φ a)
      (@MMP.Positivity.DivisorOver.functionFieldMap_congr _ _ _ _ (modelMap π P.πY i)
        (P.f i ≫ P.gZ i) hπi inferInstance hface.comp_eq.symm)
    rw [← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply] at h1
    exact h1
  rw [e1]
  exact (hσr (functionFieldMap (P.gZ i) a)).trans e2.symm

/-- **The invariants along a program.** Let `P` be a projective relative dlt program over a
projective base `Z` for the lowered pair `(X, B - ½⌊B⌋)`, where `(X, B)` satisfies the invariants
`FloorInv` for `T = ⌊B⌋` and `t₀ = ½` (in particular `K + B` is numerically trivial over `Z`).
Then every model `X_j`, `j ≤ n`, satisfies the invariants for the transforms of `K`, `B` and
`⌊B⌋`, with the program's boundary as lowered boundary, and a component of `⌊B⌋` over a maximal
point `z` of `Z` leaves a component of the transform of `⌊B⌋` over `z` on every model. -/
private theorem floorInv_program {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z] {sX : X ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)}
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {π : X ⟶ Z} {K : Divisor X} {B : QDivisor X}
    {m : ℕ} (hm : 0 < m)
    (h0 : FloorInv sX π m (1 / 2) K B (Divisor.toQDivisor B.roundDown)
      (QDivisor.toRDivisor (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown)))
    (P : RelativeDltProgram sX sZ π K (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown))
    (hPp : P.IsProjective) {z : Z} (hz : ∀ y : Z, y ⤳ z → y = z)
    (hQ : ∃ Q : MMP.Mori.PrimeDivisor X, 0 < (Divisor.toQDivisor B.roundDown).coeff Q ∧
      π Q.genericPoint = z) :
    ∀ j : ℕ, (j : ℕ∞) ≤ P.n →
      FloorInv (modelStr sX P.sY j) (modelMap π P.πY j) m (1 / 2) (iterTransform P.φ K j)
        (iterTransform P.φ B j) (iterTransform P.φ (Divisor.toQDivisor B.roundDown) j)
        (QDivisor.toRDivisor
          (divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY j)) ∧
      ∃ Q : MMP.Mori.PrimeDivisor (modelSeq X P.Y j),
        0 < (iterTransform P.φ (Divisor.toQDivisor B.roundDown) j).coeff Q ∧
        modelMap π P.πY j Q.genericPoint = z := by
  intro j
  induction j with
  | zero => intro _; exact ⟨h0, hQ⟩
  | succ i ih =>
    intro hi
    obtain ⟨hinv, Q, hQ0, hQz⟩ := ih (le_trans (by exact_mod_cast Nat.le_succ i) hi)
    obtain ⟨h1, h2, -⟩ := floorInv_succ hZ hm P hPp i hi hinv
    exact ⟨h1, h2 z hz Q hQ0 hQz⟩

/-- **A program over `Z` is crepant for `K + B`.** Under the hypotheses of `floorInv_program`,
the composite of the steps is a crepant birational map `(X, B) ⇢ (X_j, B_j)`, compatible with
the morphisms to `Z`. -/
private theorem exists_isCrepantBirationalMap_program {X Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z] {sX : X ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ) {π : X ⟶ Z}
    [IsDominant π] {K : Divisor X} {B : QDivisor X} {m : ℕ} (hm : 0 < m)
    (h0 : FloorInv sX π m (1 / 2) K B (Divisor.toQDivisor B.roundDown)
      (QDivisor.toRDivisor (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown)))
    (P : RelativeDltProgram sX sZ π K (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown))
    (hPp : P.IsProjective) {z : Z} (hz : ∀ y : Z, y ⤳ z → y = z)
    (hQ : ∃ Q : MMP.Mori.PrimeDivisor X, 0 < (Divisor.toQDivisor B.roundDown).coeff Q ∧
      π Q.genericPoint = z) :
    ∀ j : ℕ, (j : ℕ∞) ≤ P.n → ∃ (_ : IsDominant (modelMap π P.πY j))
      (Sg : FunctionFieldEquiv sX (modelStr sX P.sY j)),
      IsCrepantBirationalMap sX (modelStr sX P.sY j) B (iterTransform P.φ B j) Sg ∧
      ∀ a : Z.functionField, (Sg.toHom) (functionFieldMap (modelMap π P.πY j) a) =
        functionFieldMap π a := by
  intro j
  induction j with
  | zero =>
    intro _
    exact ⟨inferInstanceAs (IsDominant π), (1 : FunctionFieldEquiv sX sX),
      (crepantBirationalAutomorphisms sX B).one_mem, fun a => rfl⟩
  | succ i ih =>
    intro hi
    have hi' : (i : ℕ∞) ≤ P.n := le_trans (by exact_mod_cast Nat.le_succ i) hi
    obtain ⟨hd, Sg, hSgc, hSgr⟩ := ih hi'
    obtain ⟨hinv, -⟩ := floorInv_program hZ hm h0 P hPp hz hQ i hi'
    obtain ⟨-, -, h3⟩ := floorInv_succ hZ hm P hPp i hi hinv
    obtain ⟨hd', σ, hσc, hσr⟩ := h3 hd
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra (modelStr sX P.sY i)
    letI := functionFieldAlgebra (modelStr sX P.sY (i + 1))
    refine ⟨hd', σ.trans Sg, hSgc.trans hσc, fun a => ?_⟩
    exact (congrArg (Sg.toHom) (hσr a)).trans (hSgr a)

/-- **Pull-backs are numerically trivial over the base.** If `M = f^*H` for a Cartier divisor `H`
and `M ∼_ℚ k D` with `k > 0`, then `D` and `-D` are nef over the base: a multiple of `k D` is
linearly equivalent to the pull-back of a multiple of `H`, which has degree zero on every curve
contracted by `f`. -/
private theorem isRelativelyNef_of_qLinearlyEquivalent_isPullback {X R : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral R]
    [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R] {sX : X ⟶ Spec (.of ℂ)}
    {sR : R ⟶ Spec (.of ℂ)} [QuasiCompact sX] [QuasiCompact sR] [IsSeparated sR] [LocallyOfFiniteType sR] (hQ : IsQFactorial sX)
    (f : X ⟶ R) [IsDominant f] (hf : f ≫ sR = sX) {H : Divisor R} (hH : H.IsCartier)
    {M : Divisor X} (hM : ∃ hfH, H.IsPullback f hfH M) {k : ℕ} (hk : 0 < k) {D : QDivisor X}
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent ((k : ℚ) • D)) :
    D.IsRelativelyNef sX f ∧ (-D).IsRelativelyNef sX f := by
  obtain ⟨hfH, hpb⟩ := hM
  obtain ⟨c, hc, φ, hφ⟩ := hMeq
  set N : Divisor X := (c : ℤ) • M - principalDivisor φ with hN
  have hMc : M.IsCartier := hpb.isCartier hH
  have hcM : ((c : ℤ) • M).IsCartier := hMc.zsmul c
  have hNc : N.IsCartier := hcM.sub (Divisor.isCartier_principalDivisor φ)
  have hNq : Divisor.toQDivisor N = ((c * k : ℕ) : ℤ) • D := by
    have h1 : Divisor.toQDivisor N = (c : ℤ) • Divisor.toQDivisor M -
        Divisor.toQDivisor (principalDivisor φ) := by
      rw [hN, map_sub, map_zsmul]
    rw [h1, ← hφ, smul_sub, sub_sub_cancel, Nat.cast_mul, mul_smul]
    ext P
    simp [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
  have hlin : ((c : ℤ) • M).LinearlyEquivalent N := ⟨φ, by rw [hN, sub_sub_cancel]⟩
  have hBc := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant f ((c : ℤ) • H)
  have hpbc := Divisor.IsPullback.zsmul hH hpb (c : ℤ) hBc
  have hdeg : ∀ C : ProperCurve sX, C.IsContractedBy f →
      N.degreeOn ℂ sX C.ι C.dim_le hNc = 0 := by
    intro C hC
    haveI := hNc.isInvertibleModule_divisorialSheaf
    haveI := hcM.isInvertibleModule_divisorialSheaf
    have h0 := MMP.Fourfold.Oai4C1.degreeOn_isPullback_eq_zero f hf (hH.zsmul c) hpbc C hC
    have e : ((c : ℤ) • M).degreeOn ℂ sX C.ι C.dim_le hcM =
        N.degreeOn ℂ sX C.ι C.dim_le hNc :=
      degreeOn_eq_of_iso ℂ sX C.ι C.dim_le hlin.divisorialSheafIso
    rw [← e]
    exact h0
  have hck : 0 < c * k := Nat.mul_pos hc hk
  have hq : ∀ E : QDivisor X, E.IsQCartier := isQCartier_of_isQFactorial sX hQ
  have hint : ∀ C : ProperCurve sX, C.IsContractedBy f →
      D.intersectionNumber ℂ sX C.ι C.dim_le (hq D) = 0 := by
    intro C hC
    rw [QDivisor.intersectionNumber_eq_of_smul ℂ sX C.ι C.dim_le D (hq D) hck N hNc hNq,
      hdeg C hC]
    simp
  have hNq' : Divisor.toQDivisor (-N) = ((c * k : ℕ) : ℤ) • (-D) := by
    rw [map_neg, hNq, smul_neg]
  refine ⟨isRelativelyNef_of_intersectionNumber_nonneg sX (hq D) fun C hC => (hint C hC).ge,
    isRelativelyNef_of_intersectionNumber_nonneg sX (hq (-D)) fun C hC => ?_⟩
  rw [QDivisor.intersectionNumber_eq_of_smul ℂ sX C.ι C.dim_le (-D) (hq _) hck (-N) hNc.neg hNq']
  have : (-N).degreeOn ℂ sX C.ι C.dim_le hNc.neg = 0 := by
    have h := MMP.Fourfold.degreeOn_zsmul (k := ℂ) (sX := sX) C.ι C.dim_le N hNc (-1)
    rw [Divisor.degreeOn_congr (neg_one_zsmul N).symm hNc.neg (hNc.zsmul (-1)),
      h, hdeg C hC]
    simp
  rw [this]
  simp

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An `ℚ`-Cartier `ℚ`-divisor which is nef over `Y` as an `ℝ`-divisor has nonnegative
intersection number with every proper curve contracted to a point of `Y`. -/
private theorem intersectionNumber_nonneg_of_isRelativelyNef_toRDivisor {f : X ⟶ Y}
    {D : QDivisor X} (hD : D.IsQCartier)
    (h : MMP.Flips.IsRelativelyNef k sX f (QDivisor.toRDivisor D)) (C : ProperCurve sX)
    (hC : C.IsContractedBy f) : 0 ≤ D.intersectionNumber k sX C.ι C.dim_le hD := by
  obtain ⟨m, r, L, hL, hpres, hnn⟩ := h
  have hx : MMP.Flips.IsRIntersectionNumber k sX (QDivisor.toRDivisor D) r L C
      (∑ j, r j * ((L j).degreeOn k sX C.ι C.dim_le (hL j) : ℝ)) :=
    ⟨hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), hpres,
      fun j => isCartierIntersectionNumber_degreeOn C (L j) (hL j), rfl⟩
  have h0 := hnn C hC _ hx
  set N := D.cartierIndex hD
  set Lc : Divisor X := (D.cartierIndexSMul hD : Divisor X)
  have hLc : Lc.IsCartier := (D.cartierIndexSMul hD).2
  have hpres1 : QDivisor.toRDivisor D =
      ∑ _j : Fin 1, ((1 / N : ℚ) : ℝ) • Divisor.toRDivisor Lc := by
    rw [toRDivisor_eq_sum_of_toQDivisor_eq (QDivisor.cartierIndex_pos hD)
      (QDivisor.toQDivisor_cartierIndexSMul D hD)]
    simp only [Rat.cast_div, Rat.cast_one, Rat.cast_natCast, Rat.cast_inv, one_div]
    rfl
  have h1 : MMP.Flips.IsRIntersectionNumber k sX (QDivisor.toRDivisor D)
      (fun _ : Fin 1 => ((1 / N : ℚ) : ℝ)) (fun _ => Lc) C
      (∑ _j : Fin 1, ((1 / N : ℚ) : ℝ) * (Lc.degreeOn k sX C.ι C.dim_le hLc : ℝ)) :=
    ⟨fun _ => hLc, fun _ => Lc.degreeOn k sX C.ι C.dim_le hLc, hpres1,
      fun _ => isCartierIntersectionNumber_degreeOn C Lc hLc, rfl⟩
  have heq := (MMP.Flips.IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h1
  rw [heq, Fin.sum_univ_one] at h0
  rw [QDivisor.intersectionNumber_eq_of_toQDivisor_eq k sX C.ι C.dim_le D hD _ hLc
    (QDivisor.toQDivisor_cartierIndexSMul D hD)]
  have h2 : (0 : ℚ) ≤ (1 / N) * (Lc.degreeOn k sX C.ι C.dim_le hLc : ℚ) := by exact_mod_cast h0
  rw [div_eq_mul_one_div, mul_comm]
  exact h2

section FibreCurve

open Topology

open TopologicalSpace.IrreducibleCloseds (closureSingleton coe_closureSingleton)
open Stacks.Algebraization.CurveThroughPoints in
/-- **Two closed points of an irreducible closed set lie on a curve inside it.** For `Y` of
finite type over a field, two distinct closed points of an irreducible closed subset `W ⊆ Y` lie
on an irreducible closed subset `C ⊆ W` of dimension one: `W` is cut down, keeping both points,
until its dimension is one. -/
private theorem exists_irreducibleCloseds_le_dim_one {k : Type} [Field k] {Y : Scheme.{0}}
    (f : Y ⟶ Spec (.of k)) [LocallyOfFiniteType f] [QuasiCompact f] (W : IrreducibleCloseds Y)
    {p q : Y} (hpW : p ∈ (W : Set Y)) (hqW : q ∈ (W : Set Y)) (hp : IsClosed ({p} : Set Y))
    (hq : IsClosed ({q} : Set Y)) (hpq : p ≠ q) :
    ∃ C : IrreducibleCloseds Y, C ≤ W ∧ topologicalKrullDim (C : Set Y) = 1 ∧
      p ∈ (C : Set Y) ∧ q ∈ (C : Set Y) := by
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have hfin : Order.height W ≠ ⊤ := by
    have h1 := Order.height_le_krullDim W
    have h2 := topologicalKrullDim_ne_top_of_locallyOfFiniteType k f
    intro h
    rw [h] at h1
    exact h2 (top_le_iff.mp h1)
  obtain ⟨N, hN⟩ : ∃ N : ℕ, Order.height W ≤ N := ⟨(Order.height W).toNat, by
    rw [ENat.coe_toNat hfin]⟩
  induction N generalizing W with
  | zero =>
    exfalso
    have hW0 : Order.height W = 0 := nonpos_iff_eq_zero.mp (by exact_mod_cast hN)
    have hmin : ∀ C : IrreducibleCloseds Y, C ≤ W → C = W := fun C hC => by
      by_contra hne
      have := Order.height_strictMono (lt_of_le_of_ne hC hne) (by
        exact (Order.height_mono hC).trans_lt (lt_top_iff_ne_top.mpr (by simp [hW0])))
      rw [hW0] at this
      exact not_lt_zero this
    have hp' := hmin (closureSingleton p) (by
      rw [← SetLike.coe_subset_coe, coe_closureSingleton]
      exact closure_minimal (Set.singleton_subset_iff.mpr hpW) W.isClosed')
    have hq' := hmin (closureSingleton q) (by
      rw [← SetLike.coe_subset_coe, coe_closureSingleton]
      exact closure_minimal (Set.singleton_subset_iff.mpr hqW) W.isClosed')
    have : closure ({p} : Set Y) = closure {q} := by
      rw [← coe_closureSingleton, ← coe_closureSingleton, hp', hq']
    rw [hp.closure_eq, hq.closure_eq, Set.singleton_eq_singleton_iff] at this
    exact hpq this
  | succ N ih =>
    by_cases h2 : 2 ≤ topologicalKrullDim (W : Set Y)
    · obtain ⟨t, htW, hne, htp, htq⟩ := exists_specializes_specializes f W h2 hpW hqW hp hq
      have hTW : closureSingleton t < W := by
        refine lt_of_le_of_ne ?_ ?_
        · rw [← SetLike.coe_subset_coe, coe_closureSingleton]
          exact closure_minimal (Set.singleton_subset_iff.mpr htW) W.isClosed'
        · intro h
          apply hne
          rw [← coe_closureSingleton, h]
      have hlt := Order.height_strictMono hTW (lt_of_le_of_lt (Order.height_mono hTW.le)
        (lt_top_iff_ne_top.mpr hfin))
      have hfinT : Order.height (closureSingleton t) ≠ ⊤ :=
        ne_top_of_lt hlt
      obtain ⟨C, hCle, hC⟩ := ih (closureSingleton t)
        (by rw [coe_closureSingleton]; exact specializes_iff_mem_closure.mp htp)
        (by rw [coe_closureSingleton]; exact specializes_iff_mem_closure.mp htq) hfinT
        (by
          have := lt_of_lt_of_le hlt hN
          exact Order.le_of_lt_succ (by simpa using this))
      exact ⟨C, hCle.trans hTW.le, hC⟩
    · refine ⟨W, le_rfl, ?_, hpW, hqW⟩
      push Not at h2
      rw [topologicalKrullDim_eq_height] at h2 ⊢
      have hlt : closureSingleton p < W := by
        refine lt_of_le_of_ne ?_ ?_
        · rw [← SetLike.coe_subset_coe, coe_closureSingleton]
          exact closure_minimal (Set.singleton_subset_iff.mpr hpW) W.isClosed'
        · intro h
          have hqp : q ∈ (closureSingleton p : Set Y) := h ▸ hqW
          rw [coe_closureSingleton, hp.closure_eq] at hqp
          exact hpq hqp.symm
      have h1 : 1 ≤ Order.height W := by
        have := Order.height_strictMono hlt (lt_of_le_of_lt (Order.height_mono hlt.le)
          (lt_top_iff_ne_top.mpr hfin))
        exact Order.one_le_iff_pos.mpr (lt_of_le_of_lt bot_le this)
      have h2' : Order.height W ≤ 1 := by
        have : ((Order.height W : ℕ∞) : WithBot ℕ∞) < ((2 : ℕ∞) : WithBot ℕ∞) := h2
        have h3 : Order.height W < 2 := WithBot.coe_lt_coe.mp this
        exact Order.le_of_lt_succ (by simpa [one_add_one_eq_two] using h3)
      exact_mod_cast le_antisymm h2' h1

/-- Homeomorphic spaces have the same dimension. -/
private theorem topologicalKrullDim_eq_of_homeomorph {A B : Type*} [TopologicalSpace A]
    [TopologicalSpace B] (e : A ≃ₜ B) : topologicalKrullDim A = topologicalKrullDim B :=
  le_antisymm e.isInducing.topologicalKrullDim_le e.symm.isInducing.topologicalKrullDim_le

/-- Irreducibility is preserved by homeomorphisms of subspaces. -/
private theorem isIrreducible_of_homeomorph {A B : Type*} [TopologicalSpace A]
    [TopologicalSpace B] {s : Set A} {t : Set B} (e : s ≃ₜ t) (hs : IsIrreducible s) :
    IsIrreducible t := by
  rw [isIrreducible_iff_irreducibleSpace] at hs ⊢
  exact Function.Surjective.irreducibleSpace e.continuous e.surjective

/-- A point specializing to the generic point of an irreducible scheme is the generic point. -/
private theorem eq_genericPoint_of_specializes {R : Scheme.{0}} [IrreducibleSpace R] {y : R}
    (hy : y ⤳ genericPoint R) : y = genericPoint R := by
  have h1 : IsGenericPoint y (⊤ : Set R) := isGenericPoint_iff_specializes.mpr fun x =>
    ⟨fun _ => trivial, fun _ => hy.trans ((genericPoint_spec R).specializes trivial)⟩
  exact h1.eq (genericPoint_spec R)

/-- The generic point of an irreducible scheme lies in every nonempty open subset. -/
private theorem genericPoint_mem_of_isOpen {R : Scheme.{0}} [IrreducibleSpace R] {U : Set R}
    (hU : IsOpen U) (hne : U.Nonempty) : genericPoint R ∈ U := by
  obtain ⟨u, hu⟩ := hne
  exact ((genericPoint_spec R).specializes trivial).mem_open hU hu

/-- **Fibres of a prime divisor over a general point.** Let `π : Y ⟶ R` be a closed morphism of
varieties with `dim Y = e + 1` and `P` a prime divisor of `Y`. Over a dense open subset of `R`,
every irreducible subset `Z` of `P` in a fibre of `π` has `dim Z + dim R ≤ e`. -/
private theorem exists_isOpen_dim_add_le {Y R : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral R] {sY : Y ⟶ Spec (.of ℂ)}
    {sR : R ⟶ Spec (.of ℂ)} (hYv : AlgebraicGeometry.IsVariety ℂ sY)
    (hRv : AlgebraicGeometry.IsVariety ℂ sR) (π : Y ⟶ R) (hπ : π ≫ sR = sY)
    (hπc : IsClosedMap π.base) (P : MMP.Mori.PrimeDivisor Y) {e : ℕ}
    (hdim : topologicalKrullDim Y = (e + 1 : ℕ)) :
    ∃ U : Set R, IsOpen U ∧ U.Nonempty ∧ ∀ r ∈ U, ∀ Z : Set Y, IsIrreducible Z →
      Z ⊆ (P.support : Set Y) → Z ⊆ π.base ⁻¹' {r} →
      topologicalKrullDim Z + topologicalKrullDim R ≤ e := by
  have hPc : IsClosed (P.support : Set Y) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  by_cases hdom : π P.genericPoint = genericPoint R
  · have := P.integral
    haveI : LocallyOfFiniteType sY := hYv.toLocallyOfFiniteType
    set j := P.idealSheaf.subschemeι with hjdef
    set g := j ≫ π with hgdef
    have hrange : Set.range j.base = (P.support : Set Y) := by
      rw [hjdef, Scheme.IdealSheafData.range_subschemeι]
    have hjη : j (genericPoint _) = P.genericPoint := map_genericPoint_eq_of_range_eq j P hrange
    haveI : IsDominant g := ⟨by
      rw [DenseRange, dense_iff_closure_eq]
      refine Set.eq_univ_of_univ_subset ?_
      rw [← (genericPoint_spec R).def]
      refine closure_mono (Set.singleton_subset_iff.mpr ⟨genericPoint _, ?_⟩)
      change π (j (genericPoint _)) = _
      rw [hjη, hdom]⟩
    have hAv : AlgebraicGeometry.IsVariety ℂ (j ≫ sY) :=
      (MMP.Mori.isVariety_iff ℂ _).mpr ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩
    obtain ⟨U, hU, hUd, -, hfib⟩ := MMP.Foundations.exists_dense_isOpen_forall_irreducibleComponents_fiber_dim
      (j ≫ sY) sR hAv hRv g (by rw [hgdef, Category.assoc, hπ])
    have hdimA : topologicalKrullDim P.idealSheaf.subscheme = e :=
      topologicalKrullDim_eq_of_range_eq_support sY j P hrange hdim
    refine ⟨U, hU, hUd.nonempty, fun r hr Z hZ hZP hZr => ?_⟩
    have hj := j.isClosedEmbedding.isEmbedding
    have hZsub : Z ⊆ Set.range j.base := hrange ▸ hZP
    let e1 := hj.homeomorphOfSubsetRange hZsub
    have hZ' : IsIrreducible (j.base ⁻¹' Z) := isIrreducible_of_homeomorph e1.symm hZ
    have hZ'r : j.base ⁻¹' Z ⊆ g.base ⁻¹' {r} := fun a ha => by
      have := hZr ha
      simpa [hgdef] using this
    set Z'' : Set (g.base ⁻¹' {r}) := Subtype.val ⁻¹' (j.base ⁻¹' Z) with hZ''def
    let e2 := IsEmbedding.subtypeVal.homeomorphOfSubsetRange
      (show j.base ⁻¹' Z ⊆ Set.range (Subtype.val : g.base ⁻¹' {r} → _) by
        rw [Subtype.range_coe]; exact hZ'r)
    have hZ'' : IsIrreducible Z'' := isIrreducible_of_homeomorph e2.symm hZ'
    obtain ⟨K, hK, hZK⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible Z'' hZ''
    have hK' := hfib r hr K hK
    rw [hdimA] at hK'
    have hle : topologicalKrullDim Z'' ≤ topologicalKrullDim K :=
      (IsEmbedding.inclusion hZK).isInducing.topologicalKrullDim_le
    have h1 : topologicalKrullDim Z = topologicalKrullDim Z'' :=
      (topologicalKrullDim_eq_of_homeomorph e1).symm.trans (topologicalKrullDim_eq_of_homeomorph e2).symm
    rw [h1, ← hK']
    exact add_le_add_left hle _
  · refine ⟨(π.base '' (P.support : Set Y))ᶜ, (hπc _ hPc).isOpen_compl, ⟨genericPoint R, ?_⟩,
      fun r hr Z hZ hZP hZr => ?_⟩
    · rintro ⟨x, hx, hxη⟩
      have hsp : P.genericPoint ⤳ x := by
        rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact hx
      have h2 := hsp.map π.continuous
      change π P.genericPoint ⤳ π.base x at h2
      rw [hxη] at h2
      exact hdom (eq_genericPoint_of_specializes h2)
    · obtain ⟨z, hz⟩ := hZ.nonempty
      exact absurd ⟨z, hZP hz, hZr hz⟩ hr

/-- **A fibre curve meeting the floor.** Let `π : Y ⟶ R` be a morphism of projective complex
varieties, `Y` a `ℚ`-factorial threefold, and `T ≥ 0` a `ℚ`-divisor with a component `Q` over
the generic point of `R`. Some proper curve contracted by `π` has `T · C > 0`: over a general
closed point `r` of `R` no component of the fibre lies in `Supp T`, and the component through a
point of `Q` contains a curve through that point and a point off `Supp T`. -/
private theorem exists_properCurve_intersectionNumber_pos {Y R : Scheme.{0}} [IsIntegral Y]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)}
    {sR : R ⟶ Spec (.of ℂ)} (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (hQf : IsQFactorial sY)
    (hdim : topologicalKrullDim Y = 3) [IsIntegral R] (hR : MMP.Mori.IsProjectiveVariety ℂ sR)
    (π : Y ⟶ R) (hπ : π ≫ sR = sY) {T : QDivisor Y} (hT0 : ∀ P, 0 ≤ T.coeff P)
    (Q : MMP.Mori.PrimeDivisor Y) (hQ : 0 < T.coeff Q) (hQη : π Q.genericPoint = genericPoint R) :
    haveI : QuasiCompact sY := hY.toIsVariety.toQuasiCompact
    ∃ C : ProperCurve sY, C.IsContractedBy π ∧
      0 < T.intersectionNumber ℂ sY C.ι C.dim_le (isQCartier_of_isQFactorial sY hQf T) := by
  classical
  haveI : QuasiCompact sY := hY.toIsVariety.toQuasiCompact
  haveI : LocallyOfFiniteType sY := hY.toIsVariety.toLocallyOfFiniteType
  haveI : IsProper sY := isProper_of_isProjectiveMorphism sY hY.isProjective
  haveI : IsSeparated sR := hR.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sR := hR.toIsVariety.toLocallyOfFiniteType
  haveI : IsProper π := by
    haveI : IsProper (π ≫ sR) := by rw [hπ]; infer_instance
    exact IsProper.of_comp π sR
  haveI : JacobsonSpace R := LocallyOfFiniteType.jacobsonSpace sR
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace sY
  have hπc : IsClosedMap π.base := π.isClosedMap
  haveI : IsDominant π := ⟨by
    rw [DenseRange, dense_iff_closure_eq]
    refine Set.eq_univ_of_univ_subset ?_
    rw [← (genericPoint_spec R).def]
    exact closure_mono (Set.singleton_subset_iff.mpr ⟨_, hQη⟩)⟩
  have hQc : IsClosed (Q.support : Set Y) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  have hQsurj : π.base '' (Q.support : Set Y) = Set.univ := by
    refine Set.eq_univ_of_univ_subset ?_
    rw [← (genericPoint_spec R).def, ← (hπc _ hQc).closure_eq]
    refine closure_mono (Set.singleton_subset_iff.mpr ⟨Q.genericPoint, ?_, hQη⟩)
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  -- the fibres of `π` and of the components of `T` over a general point
  obtain ⟨U₀, hU₀, hU₀d, -, hfib₀⟩ :=
    MMP.Foundations.exists_dense_isOpen_forall_irreducibleComponents_fiber_dim sY sR hY.toIsVariety
      hR.toIsVariety π hπ
  have hdimY' : topologicalKrullDim Y = ((2 + 1 : ℕ) : WithBot ℕ∞) := by rw [hdim]; rfl
  choose U hUo hUne hUdim using fun P : T.support =>
    exists_isOpen_dim_add_le hY.toIsVariety hR.toIsVariety π hπ hπc P.1 hdimY'
  set V := U₀ ∩ ⋂ P : T.support, U P with hVdef
  have hVo : IsOpen V := hU₀.inter (isOpen_iInter_of_finite hUo)
  have hηV : genericPoint R ∈ V :=
    ⟨genericPoint_mem_of_isOpen hU₀ hU₀d.nonempty,
      Set.mem_iInter.mpr fun P => genericPoint_mem_of_isOpen (hUo P) (hUne P)⟩
  obtain ⟨r, hrV, hrc⟩ := nonempty_inter_closedPoints ⟨_, hηV⟩ hVo.isLocallyClosed
  -- a closed point `y` of `Q` over `r`
  have hrc' : IsClosed ({r} : Set R) := hrc
  have hF : IsClosed (π.base ⁻¹' {r}) := hrc'.preimage π.continuous
  obtain ⟨y, ⟨hyQ, hyr⟩, hyc⟩ := nonempty_inter_closedPoints
    (show ((Q.support : Set Y) ∩ π.base ⁻¹' {r}).Nonempty by
      obtain ⟨x, hx, hxr⟩ := (hQsurj.symm ▸ Set.mem_univ r : r ∈ π.base '' (Q.support : Set Y))
      exact ⟨x, hx, hxr⟩)
    (hQc.inter hF).isLocallyClosed
  have hyc' : IsClosed ({y} : Set Y) := hyc
  -- the component `Φ` of the fibre through `y`
  obtain ⟨C, hC, hyC⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
    ({⟨y, hyr⟩} : Set (π.base ⁻¹' {r})) isIrreducible_singleton
  have hCdim := hfib₀ r hrV.1 C hC
  rw [hdim] at hCdim
  set Φ : Set Y := Subtype.val '' C with hΦdef
  have hΦirr : IsIrreducible Φ :=
    hC.1.image _ continuous_subtype_val.continuousOn
  have hΦc : IsClosed Φ :=
    hF.isClosedMap_subtype_val C (isClosed_of_mem_irreducibleComponents C hC)
  have hΦdim : topologicalKrullDim Φ = topologicalKrullDim C :=
    (topologicalKrullDim_eq_of_homeomorph (IsEmbedding.subtypeVal.homeomorphImage C)).symm
  have hΦF : Φ ⊆ π.base ⁻¹' {r} := by rintro _ ⟨c, -, rfl⟩; exact c.2
  have hyΦ : y ∈ Φ := ⟨⟨y, hyr⟩, hyC rfl, rfl⟩
  -- `Φ` is not contained in `Supp T`
  set S : Set Y := ⋃ P ∈ T.support, (P.support : Set Y) with hSdef
  have hSc : IsClosed S := by
    refine Set.Finite.isClosed_biUnion T.support.finite_toSet fun P _ => ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  have hΦS : ¬ Φ ⊆ S := by
    intro hsub
    obtain ⟨z, hz, hΦz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hΦirr)
      (T.support.image fun P => (P.support : Set Y))
      (fun z hz => by
        obtain ⟨P, -, rfl⟩ := Finset.mem_image.mp hz
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure)
      (by
        intro x hx
        obtain ⟨P, hP, hxP⟩ := Set.mem_iUnion₂.mp (hsub hx)
        exact Set.mem_sUnion.mpr ⟨_, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hP), hxP⟩)
    obtain ⟨P, hP, rfl⟩ := Finset.mem_image.mp hz
    have h := hUdim ⟨P, hP⟩ r (Set.mem_iInter.mp hrV.2 ⟨P, hP⟩) Φ hΦirr hΦz hΦF
    rw [hΦdim, hCdim] at h
    exact absurd h (by decide)
  -- a closed point `y'` of `Φ` off `Supp T`
  obtain ⟨y', ⟨hy'Φ, hy'S⟩, hy'c⟩ := nonempty_inter_closedPoints
    (show (Φ ∩ Sᶜ).Nonempty from Set.not_subset.mp hΦS |>.imp fun x hx => ⟨hx.1, hx.2⟩)
    (hΦc.isLocallyClosed.inter hSc.isOpen_compl.isLocallyClosed)
  have hy'c' : IsClosed ({y'} : Set Y) := hy'c
  have hQT : Q ∈ T.support := by
    rw [Finsupp.mem_support_iff]
    intro h0
    rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, h0] at hQ
    exact lt_irrefl 0 hQ
  have hyS : y ∈ S := Set.mem_iUnion₂.mpr ⟨Q, hQT, hyQ⟩
  have hyy' : y ≠ y' := fun h => hy'S (h ▸ hyS)
  -- a curve through `y` and `y'` inside `Φ`
  obtain ⟨C', hC'Φ, hC'1, hyC', hy'C'⟩ := exists_irreducibleCloseds_le_dim_one sY
    ⟨Φ, hΦirr, hΦc⟩ hyΦ hy'Φ hyc' hy'c' hyy'
  obtain ⟨ξ, hξ⟩ := QuasiSober.sober C'.isIrreducible C'.isClosed
  have hξcl : closure ({ξ} : Set Y) = (C' : Set Y) := hξ
  have hdimξ : topologicalKrullDim (curveSubschemeAt ξ) = 1 := by
    rw [topologicalKrullDim_eq_of_homeomorph
      (curveSubschemeAtι ξ).isClosedEmbedding.isEmbedding.toHomeomorph]
    rw [range_curveSubschemeAtι, hξcl]
    exact hC'1
  let Cv : ProperCurve sY := ⟨ξ, isProperCurve_of_isProper sY hdimξ⟩
  have hCvr : ∀ x ∈ closure ({ξ} : Set Y), π x = r := fun x hx => by
    rw [hξcl] at hx
    exact hΦF (hC'Φ hx)
  refine ⟨Cv, fun x hx => (hCvr x hx).trans (hCvr ξ (subset_closure rfl)).symm, ?_⟩
  -- positivity of `T · C`
  have hq := isQCartier_of_isQFactorial sY hQf T
  obtain ⟨N, hN, hNc⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hq
  have hidx : 0 < T.cartierIndex hq := QDivisor.cartierIndex_pos hq
  have hNcoeff : ∀ P, (N.coeff P : ℚ) = (T.cartierIndex hq : ℚ) * T.coeff P := fun P => by
    have := congrArg (fun D : QDivisor Y => D.coeff P) hN
    simpa [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] using this
  have hN0 : 0 ≤ N := fun P => by
    have h := hNcoeff P
    have : (0 : ℚ) ≤ N.coeff P := by rw [h]; exact mul_nonneg (by positivity) (hT0 P)
    exact_mod_cast this
  have hNsupp : ∀ x, x ∈ N.supp ↔ x ∈ S := fun x => by
    rw [DivisorWithCoeffs.mem_supp_iff, hSdef, Set.mem_iUnion₂]
    refine exists_congr fun P => ?_
    have hiff : N.coeff P ≠ 0 ↔ P ∈ T.support := by
      rw [Finsupp.mem_support_iff, ← MMP.Mori.DivisorWithCoeffs.coeff_apply]
      have h := hNcoeff P
      have hi : (T.cartierIndex hq : ℚ) ≠ 0 := by exact_mod_cast hidx.ne'
      constructor
      · intro hN0' hT0'
        apply hN0'
        have : (N.coeff P : ℚ) = 0 := by rw [h, hT0', mul_zero]
        exact_mod_cast this
      · intro hT0' hN0'
        apply hT0'
        have : (T.cartierIndex hq : ℚ) * T.coeff P = 0 := by rw [← h, hN0']; simp
        exact (mul_eq_zero.mp this).resolve_left hi
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨hiff.mp h1, h2⟩
    · rintro ⟨h1, h2⟩; exact ⟨hiff.mpr h1, h2⟩
  have hrangeCv : Set.range Cv.ι = closure ({ξ} : Set Y) := Cv.range_ι
  obtain ⟨c', hc'⟩ : y' ∈ Set.range Cv.ι := by rw [hrangeCv, hξcl]; exact hy'C'
  obtain ⟨c, hc⟩ : y ∈ Set.range Cv.ι := by rw [hrangeCv, hξcl]; exact hyC'
  haveI : IsIntegral Cv.scheme := by
    change IsIntegral (curveSubschemeAt ξ)
    infer_instance
  obtain ⟨hdeg0, hdeg⟩ := MMP.Threefold.Mori.degreeOn_nonneg_and_eq_zero_iff (k := ℂ) sY Cv.ι
    Cv.dim_le N hNc hN0 ⟨c', by rw [hc', hNsupp]; exact hy'S⟩
  have hdegpos : 0 < N.degreeOn ℂ sY Cv.ι Cv.dim_le hNc := by
    refine lt_of_le_of_ne hdeg0 (Ne.symm fun h0 => ?_)
    exact (hdeg.mp h0 c) (by rw [hc, hNsupp]; exact hyS)
  rw [QDivisor.intersectionNumber_eq_of_smul ℂ sY Cv.ι Cv.dim_le T hq hidx N hNc hN]
  have : (0 : ℚ) < N.degreeOn ℂ sY Cv.ι Cv.dim_le hNc := by exact_mod_cast hdegpos
  positivity

end FibreCurve

/-- **No nef endpoint.** Let `(X, B)` be a `ℚ`-factorial projective dlt threefold, `f : X ⟶ R` a
morphism to a projective variety with `k(K + B) ∼_ℚ f^*H` for a Cartier divisor `H`, and suppose
a component of `⌊B⌋` lies over the generic point of `R`. A projective program over `R` for
`(X, B - ½⌊B⌋)` does not end with a lowered adjoint nef over `R`: along the program `K + B` stays
numerically trivial over `R` and a component of the floor stays over the generic point of `R`, so
`-⌊B_n⌋` would be nef over `R`, while a curve in a fibre meets the floor positively. -/
private theorem not_isRelativelyNef_endpoint {X R : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sR : R ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ : IsQFactorial sX) {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX 3) {B : QDivisor X} (hdlt : MMP.Intersection.IsDltPair sX B)
    [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    (hRp : MMP.Mori.IsProjectiveVariety ℂ sR) (f : X ⟶ R) [IsDominant f] (hf : f ≫ sR = sX)
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) {M : Divisor X}
    (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent ((k : ℚ) • (Divisor.toQDivisor K + B)))
    (hEη : ∃ E : MMP.Mori.PrimeDivisor X, 0 < (Divisor.toQDivisor B.roundDown).coeff E ∧
      f E.genericPoint = genericPoint R)
    (P : RelativeDltProgram sX sR f K (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown))
    (hPp : P.IsProjective) (hPn : P.n ≠ ⊤) :
    ¬ MMP.Flips.IsRelativelyNef ℂ (modelStr sX P.sY P.n.toNat) (modelMap f P.πY P.n.toNat)
      (QDivisor.toRDivisor (Divisor.toQDivisor (divisorSeq K P.KY P.n.toNat) +
        divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY P.n.toNat)) := by
  intro hnefR
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : QuasiCompact sR := hRp.toIsVariety.toQuasiCompact
  haveI : IsSeparated sR := hRp.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sR := hRp.toIsVariety.toLocallyOfFiniteType
  obtain ⟨hD, hD'⟩ := isRelativelyNef_of_qLinearlyEquivalent_isPullback hQ f hf hH hM hk hMeq
  obtain ⟨m, hm, hmD⟩ := (isQCartier_of_isQFactorial sX hQ (Divisor.toQDivisor K + B)).exists_pos
  have h0 := floorInv_zero (g := f) (t₀ := 1 / 2) hQ hK hdlt hmD hD hD'
  have hz : ∀ y : R, y ⤳ genericPoint R → y = genericPoint R := fun y hy => by
    have h1 : IsGenericPoint y (⊤ : Set R) := isGenericPoint_iff_specializes.mpr fun x =>
      ⟨fun _ => trivial, fun _ => hy.trans ((genericPoint_spec R).specializes trivial)⟩
    exact h1.eq (genericPoint_spec R)
  have hjn : ((P.n.toNat : ℕ) : ℕ∞) ≤ P.n := by rw [ENat.coe_toNat hPn]
  obtain ⟨hinv, Qn, hQn0, hQnη⟩ := floorInv_program hRp hm h0 P hPp hz hEη P.n.toNat hjn
  obtain ⟨-, hPm⟩ := hPp
  have hmod := P.isRelativeDltModel P.n.toNat hjn
  have hdimn := hinv.isCanonicalDivisor.topologicalKrullDim_eq
  set s := modelStr sX P.sY P.n.toNat
  obtain ⟨C, hCπ, hCpos⟩ := exists_properCurve_intersectionNumber_pos (hPm _ hjn)
    hmod.isQFactorial (by rw [hdimn]; rfl) hRp (modelMap f P.πY P.n.toNat) hmod.comp_eq
    hinv.floor_nonneg Qn hQn0 hQnη
  haveI : QuasiCompact s := (hPm _ hjn).toIsVariety.toQuasiCompact
  have hq : ∀ D : QDivisor (modelSeq X P.Y P.n.toNat), D.IsQCartier :=
    isQCartier_of_isQFactorial s hmod.isQFactorial
  set ι := fun D : QDivisor (modelSeq X P.Y P.n.toNat) =>
    (D.intersectionNumber ℂ s C.ι C.dim_le (hq D) : ℚ) with hι
  have hι_add : ∀ D D', ι (D + D') = ι D + ι D' := fun D D' => by
    simp only [hι]
    rw [QDivisor.intersectionNumber_add' ℂ s C.ι C.dim_le D D' (hq D) (hq D') (hq _)]
  have hι_smul : ∀ (q : ℚ) D, ι (q • D) = q * ι D := fun q D => by
    simp only [hι]
    rw [MMP.Fourfold.intersectionNumber_smul s C.ι C.dim_le D (hq D) q (hq _)]
  -- the program's adjoint
  have h1 : 0 ≤ ι (Divisor.toQDivisor (divisorSeq K P.KY P.n.toNat) +
      divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY P.n.toNat) :=
    intersectionNumber_nonneg_of_isRelativelyNef_toRDivisor (hq _) hnefR C hCπ
  -- `K + B` is numerically trivial over `R`
  set KK := iterTransform P.φ K P.n.toNat
  set BB := iterTransform P.φ B P.n.toNat
  set TT := iterTransform P.φ (Divisor.toQDivisor B.roundDown) P.n.toNat
  have h2 : 0 ≤ ι (Divisor.toQDivisor KK + BB) :=
    MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg s hinv.isRelativelyNef
      (hq _) C hCπ
  have h3 : 0 ≤ ι (-(Divisor.toQDivisor KK + BB)) :=
    MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg s hinv.isRelativelyNef_neg
      (hq _) C hCπ
  have hneg : ι (-(Divisor.toQDivisor KK + BB)) = -ι (Divisor.toQDivisor KK + BB) := by
    have := hι_smul (-1) (Divisor.toQDivisor KK + BB)
    rw [neg_one_smul] at this
    rw [this]; ring
  -- the program's boundary is `B_n - ½ T_n` and its canonical divisor is linearly equivalent to
  -- `K_n`
  have hBY : divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY P.n.toNat =
      BB - (1 / 2 : ℚ) • TT := QDivisor.toRDivisor_injective hinv.toRDivisor_eq.symm
  obtain ⟨d, hKd⟩ := hmod.isCanonicalDivisor
  have hd : d = 3 := by
    have := hKd.topologicalKrullDim_eq
    rw [hdimn] at this
    exact_mod_cast this.symm
  subst hd
  have hlin := MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor s
    hmod.isQFactorial.1 hKd hinv.isCanonicalDivisor
  have h4 := intersectionNumber_add_eq_of_linearlyEquivalent (sX := s) C.ι C.dim_le hlin
    (BB - (1 / 2 : ℚ) • TT) (hq _) (hq _)
  have hsplit : Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT) =
      (Divisor.toQDivisor KK + BB) + (-(1 / 2 : ℚ)) • TT := by
    rw [neg_smul]; abel
  have h5' : ι (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) =
      ι (Divisor.toQDivisor KK + BB) - (1 / 2) * ι TT := by
    rw [hsplit, hι_add, hι_smul]; ring
  have e : Divisor.toQDivisor (divisorSeq K P.KY P.n.toNat) +
      divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY P.n.toNat =
      Divisor.toQDivisor (divisorSeq K P.KY P.n.toNat) + (BB - (1 / 2 : ℚ) • TT) := by
    rw [hBY]
  have h5 : ι (Divisor.toQDivisor (divisorSeq K P.KY P.n.toNat) +
      divisorSeq (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown) P.BY P.n.toNat) =
      ι (Divisor.toQDivisor KK + BB) - (1 / 2) * ι TT := by
    rw [e, ← h5']
    simp only [hι]
    exact h4
  have hpos : 0 < ι TT := hCpos
  rw [h5] at h1
  rw [hneg] at h3
  linarith

/-- **The Stein equalities along a program.** If `π_* 𝒪_X = 𝒪_Z`, then `(π_j)_* 𝒪_{X_j} = 𝒪_Z`
on every model of a projective relative dlt program over `Z`: the contraction `f_i` of each step
has `(f_i)_* 𝒪 = 𝒪`, so `(g_i)_* 𝒪_{W_i} = 𝒪_Z` for the base `W_i` of the step, and the morphism
`f_i⁺` onto the normal `W_i` is proper and birational, so `(f_i⁺)_* 𝒪 = 𝒪`. -/
private theorem isIso_app_modelMap {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    {π : X ⟶ Z} {K : Divisor X} {B : QDivisor X} (P : RelativeDltProgram sX sZ π K B)
    (hPp : P.IsProjective) (hπ : ∀ U : Z.Opens, IsIso (π.app U)) :
    ∀ j : ℕ, (j : ℕ∞) ≤ P.n → ∀ U : Z.Opens, IsIso ((modelMap π P.πY j).app U) := by
  intro j
  induction j with
  | zero => intro _; exact hπ
  | succ i ih =>
    intro hi U
    have hi' : (i : ℕ∞) < P.n := lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self i) hi
    have hst := P.isElementaryDltStep i hi'
    have hneg := hst.isNegativeRelativeRayContraction.isNegativeExtremalContraction
    have hface := hst.isNegativeRelativeRayContraction.isRelativeContractionOfFace
    have hWn := hneg.isNormalVariety_target
    -- `(g_i)_* 𝒪_{W_i} = 𝒪_Z`
    have h1 : IsIso ((P.f i ≫ P.gZ i).app U) := by rw [hface.comp_eq]; exact ih hi'.le U
    rw [Scheme.Hom.comp_app] at h1
    have hgZ : IsIso ((P.gZ i).app U) :=
      @IsIso.of_isIso_comp_right _ _ _ _ _ ((P.gZ i).app U) ((P.f i).app (P.gZ i ⁻¹ᵁ U))
        (hface.isIso_app (P.gZ i ⁻¹ᵁ U)) h1
    -- `(f_i⁺)_* 𝒪 = 𝒪`
    have hfpI : IsIso ((P.fp i).app (P.gZ i ⁻¹ᵁ U)) := by
      rcases hst.divisorial_or_flip with ⟨-, -, hiso, -⟩ | hflip
      · infer_instance
      · haveI := hflip.isProper
        exact MMP.Mori.isIso_app_of_isProper_of_isBirationalMorphism (P.sY i) (P.sZ i)
          (hPp.2 (i + 1) hi).toIsVariety hWn (P.fp i) hflip.isSmall.isBirationalMorphism _
    change IsIso ((P.πY i).app U)
    rw [← hst.comp_eq, Scheme.Hom.comp_app]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ hgZ hfpI

/-- **The Stein equality at the end of a program.** If `π_* 𝒪_X = 𝒪_Z` and the program ends with
a fibre-type contraction `g : X_n ⟶ T` over `Z` (by `g_T : T ⟶ Z`), then `(g_T)_* 𝒪_T = 𝒪_Z`. -/
private theorem isIso_app_finalBase {X Z : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    {π : X ⟶ Z} {K : Divisor X} {B : QDivisor X} (P : RelativeDltProgram sX sZ π K B)
    (hPp : P.IsProjective) (hπ : ∀ U : Z.Opens, IsIso (π.app U)) (hfin : P.hasFinal) :
    ∀ U : Z.Opens, IsIso (P.gT.app U) := by
  intro U
  obtain ⟨hPn, hfinal, -⟩ := P.final_spec hfin
  have hface := hfinal.isRelativeContractionOfFace
  have hn : ((P.n.toNat : ℕ) : ℕ∞) ≤ P.n := by rw [ENat.coe_toNat hPn]
  have h1 : IsIso ((P.g ≫ P.gT).app U) := by
    rw [hface.comp_eq]; exact isIso_app_modelMap P hPp hπ _ hn U
  rw [Scheme.Hom.comp_app] at h1
  exact @IsIso.of_isIso_comp_right _ _ _ _ _ (P.gT.app U) (P.g.app (P.gT ⁻¹ᵁ U))
    (hface.isIso_app (P.gT ⁻¹ᵁ U)) h1

/-- **A floor component over the generic point.** If `f : X ⟶ R` is a morphism onto an integral
scheme whose image of the floor `⌊B⌋` is all of `R`, and `B ≥ 0`, some component of `⌊B⌋` lies
over the generic point of `R`. -/
private theorem exists_coeff_pos_genericPoint_of_image_eq_univ {X R : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral R] {B : QDivisor X} (hB0 : ∀ P, 0 ≤ B.coeff P)
    (f : X ⟶ R)
    (heq : f.base '' (⋃ E ∈ B.roundDown.support, (E.support : Set X)) = Set.univ) :
    ∃ E : MMP.Mori.PrimeDivisor X,
      0 < (Divisor.toQDivisor B.roundDown).coeff E ∧ f E.genericPoint = genericPoint R := by
  have hη : genericPoint R ∈ f.base '' (⋃ E ∈ B.roundDown.support, (E.support : Set X)) := by
    rw [heq]; trivial
  obtain ⟨x, hx, hxη⟩ := hη
  simp only [Set.mem_iUnion] at hx
  obtain ⟨E, hE, hxE⟩ := hx
  refine ⟨E, ?_, ?_⟩
  · have h1 : B.roundDown.coeff E ≠ 0 := by
      rw [MMP.Mori.DivisorWithCoeffs.coeff_apply]; exact Finsupp.mem_support_iff.mp hE
    have h2 : 0 ≤ B.roundDown.coeff E := by
      rw [DivisorWithCoeffs.coeff_roundDown]; exact Int.floor_nonneg.mpr (hB0 E)
    rw [Divisor.coeff_toQDivisor]
    exact_mod_cast lt_of_le_of_ne h2 (Ne.symm h1)
  · have hsp : E.genericPoint ⤳ x := by
      rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hxE
    have h3 := hsp.map f.continuous
    change f E.genericPoint ⤳ f.base x at h3
    rw [hxη] at h3
    have h4 : IsGenericPoint (f E.genericPoint) (⊤ : Set R) :=
      isGenericPoint_iff_specializes.mpr fun y =>
        ⟨fun _ => trivial, fun _ => h3.trans ((genericPoint_spec R).specializes trivial)⟩
    exact h4.eq (genericPoint_spec R)

section RIntersection

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
  [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]

/-- A `ℚ`-Cartier `ℚ`-divisor, as an `ℝ`-divisor, is a real combination of Cartier divisors. -/
private theorem isCartierCombination_toRDivisor {D : QDivisor X} (hD : D.IsQCartier) :
    MMP.Flips.IsCartierCombination (QDivisor.toRDivisor D) := by
  set N := D.cartierIndex hD
  set Lc : Divisor X := (D.cartierIndexSMul hD : Divisor X)
  have hLc : Lc.IsCartier := (D.cartierIndexSMul hD).2
  refine ⟨1, fun _ => ((1 / N : ℚ) : ℝ), fun _ => Lc, fun _ => hLc, ?_⟩
  rw [toRDivisor_eq_sum_of_toQDivisor_eq (QDivisor.cartierIndex_pos hD)
    (QDivisor.toQDivisor_cartierIndexSMul D hD)]
  simp only [Rat.cast_div, Rat.cast_one, Rat.cast_natCast, Rat.cast_inv, one_div]
  rfl

/-- The real intersection number of a `ℚ`-Cartier `ℚ`-divisor, through any presentation, is its
intersection number. -/
private theorem eq_intersectionNumber_of_isRIntersectionNumber {D : QDivisor X}
    (hD : D.IsQCartier) (C : ProperCurve sX) {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X}
    {x : ℝ} (hx : MMP.Flips.IsRIntersectionNumber k sX (QDivisor.toRDivisor D) r L C x) :
    x = (D.intersectionNumber k sX C.ι C.dim_le hD : ℝ) := by
  set N := D.cartierIndex hD
  set Lc : Divisor X := (D.cartierIndexSMul hD : Divisor X)
  have hLc : Lc.IsCartier := (D.cartierIndexSMul hD).2
  have hpres1 : QDivisor.toRDivisor D =
      ∑ _j : Fin 1, ((1 / N : ℚ) : ℝ) • Divisor.toRDivisor Lc := by
    rw [toRDivisor_eq_sum_of_toQDivisor_eq (QDivisor.cartierIndex_pos hD)
      (QDivisor.toQDivisor_cartierIndexSMul D hD)]
    simp only [Rat.cast_div, Rat.cast_one, Rat.cast_natCast, Rat.cast_inv, one_div]
    rfl
  have h1 : MMP.Flips.IsRIntersectionNumber k sX (QDivisor.toRDivisor D)
      (fun _ : Fin 1 => ((1 / N : ℚ) : ℝ)) (fun _ => Lc) C
      (∑ _j : Fin 1, ((1 / N : ℚ) : ℝ) * (Lc.degreeOn k sX C.ι C.dim_le hLc : ℝ)) :=
    ⟨fun _ => hLc, fun _ => Lc.degreeOn k sX C.ι C.dim_le hLc, hpres1,
      fun _ => isCartierIntersectionNumber_degreeOn C Lc hLc, rfl⟩
  have heq := (MMP.Flips.IsRIntersectionNumber.eq_and_linear k sX C).1 _ _ _ _ _ _ _ hx h1
  rw [heq, Fin.sum_univ_one, QDivisor.intersectionNumber_eq_of_toQDivisor_eq k sX C.ι C.dim_le D hD
    _ hLc (QDivisor.toQDivisor_cartierIndexSMul D hD)]
  push_cast
  ring

end RIntersection

end ProgramInvariants

section CommonLogResolution

open TopologicalSpace

namespace LogRes

open Topology

section Topology

variable {A T : Type*} [TopologicalSpace A] [TopologicalSpace T] {ψ : A → T}

/-- The closure of the image of an irreducible closed subset under an open embedding. -/
private def closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    IrreducibleCloseds T :=
  ⟨closure (ψ '' Z), (Z.isIrreducible.image ψ hψ.continuous.continuousOn).closure,
    isClosed_closure⟩

/-- The preimage of an irreducible closed subset meeting the image of an open embedding. -/
private def preimageIrr (hψ : IsOpenEmbedding ψ) (B : IrreducibleCloseds T)
    (hne : ((B : Set T) ∩ Set.range ψ).Nonempty) : IrreducibleCloseds A :=
  ⟨ψ ⁻¹' B, B.isIrreducible.preimage hψ hne, B.isClosed.preimage hψ.continuous⟩

private lemma preimage_closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    ψ ⁻¹' (closureImage hψ Z : Set T) = Z := by
  change ψ ⁻¹' closure (ψ '' Z) = Z
  rw [← hψ.isInducing.closure_eq_preimage_closure_image, Z.isClosed.closure_eq]

private lemma closureImage_preimageIrr (hψ : IsOpenEmbedding ψ) (B : IrreducibleCloseds T)
    (hne : ((B : Set T) ∩ Set.range ψ).Nonempty) :
    closureImage hψ (preimageIrr hψ B hne) = B := by
  have hne' : (ψ ⁻¹' B).Nonempty := by obtain ⟨_, hb, x, rfl⟩ := hne; exact ⟨x, hb⟩
  exact SetLike.coe_injective <| closure_image_preimage_of_isPreirreducible ψ hψ.isOpenMap B
    hne' B.isIrreducible.isPreirreducible B.isClosed

/-- Taking closures of images along an open embedding preserves codimension. -/
private lemma codimension_closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    codimension (closureImage hψ Z) = codimension Z := by
  rw [codimension_eq_coheight, codimension_eq_coheight]
  have hmono : StrictMono (closureImage hψ) := fun a b hab ↦
    lt_of_le_of_ne (closure_mono (Set.image_mono hab.le)) fun h ↦ hab.ne <|
      SetLike.coe_injective <| by
        simpa only [preimage_closureImage] using
          congrArg (fun W : IrreducibleCloseds T ↦ ψ ⁻¹' (W : Set T)) h
  refine (Order.coheight_eq_of_strictMono _ hmono (fun a B hab ↦ ?_) Z).symm
  have hne : ((B : Set T) ∩ Set.range ψ).Nonempty := by
    obtain ⟨x, hx⟩ := a.isIrreducible.nonempty
    exact ⟨ψ x, hab.le (subset_closure ⟨x, hx, rfl⟩), x, rfl⟩
  refine ⟨preimageIrr hψ B hne, lt_of_le_of_ne (fun x hx ↦ hab.le (subset_closure ⟨x, hx, rfl⟩))
    ?_, closureImage_preimageIrr hψ B hne⟩
  rintro rfl
  exact hab.ne (closureImage_preimageIrr hψ B hne)

end Topology

private lemma isPreirreducible_preimage_val {Y : Type*} [TopologicalSpace Y] {C W : Set Y}
    (hW : IsPreirreducible W) (hWC : W ⊆ C) : IsPreirreducible (Subtype.val ⁻¹' W : Set C) := by
  rintro u v hu hv ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  obtain ⟨u', hu', rfl⟩ := isOpen_induced_iff.mp hu
  obtain ⟨v', hv', rfl⟩ := isOpen_induced_iff.mp hv
  obtain ⟨y, hyW, hyu, hyv⟩ := hW u' v' hu' hv' ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  exact ⟨⟨y, hWC hyW⟩, hyW, hyu, hyv⟩

/-- An irreducible closed set contained in a closed set lies in an irreducible closed subset
maximal in it. -/
private lemma exists_maximal_ge {Y : Type*} [TopologicalSpace Y] {C : Set Y} (hC : IsClosed C)
    (Z : IrreducibleCloseds Y) (hZ : (Z : Set Y) ⊆ C) :
    ∃ W : IrreducibleCloseds Y, Maximal (fun W' : IrreducibleCloseds Y ↦ (W' : Set Y) ⊆ C) W ∧
      Z ≤ W := by
  obtain ⟨t, ht, hxt, hmax⟩ := exists_preirreducible (Subtype.val ⁻¹' (Z : Set Y) : Set C)
    (isPreirreducible_preimage_val Z.isIrreducible.isPreirreducible hZ)
  obtain ⟨z, hz⟩ := Z.isIrreducible.nonempty
  let W : IrreducibleCloseds Y := ⟨closure (Subtype.val '' t),
    (IsIrreducible.closure ⟨⟨z, ⟨z, hZ hz⟩, hxt hz, rfl⟩,
      ht.image _ continuous_subtype_val.continuousOn⟩), isClosed_closure⟩
  have hWC : (W : Set Y) ⊆ C := closure_minimal (by rintro _ ⟨y, -, rfl⟩; exact y.2) hC
  refine ⟨W, ⟨hWC, fun W' hW'C hWW' y hy ↦ ?_⟩, fun y hy ↦ subset_closure ⟨⟨y, hZ hy⟩, hxt hy, rfl⟩⟩
  have := hmax _ (isPreirreducible_preimage_val W'.isIrreducible.isPreirreducible hW'C)
    fun y hy ↦ hWW' (subset_closure ⟨y, hy, rfl⟩)
  have : (⟨y, hW'C hy⟩ : C) ∈ t := by rw [← this]; exact hy
  exact subset_closure ⟨_, this, rfl⟩

/-- If `C₁ ⊆ Y` is closed of pure codimension one, `h` is an open embedding on the complement
`U` of `C₁`, and `T` is closed of pure codimension one, then so is `C₁ ∪ h⁻¹(T)`. -/
private lemma isPureCodimOne_sup_preimage {Y X' : Type*} [TopologicalSpace Y]
    [TopologicalSpace X'] {h : Y → X'} (hh : Continuous h) {U : Set Y} (hU : IsOpen U)
    (hψ : IsOpenEmbedding (U.restrict h)) {C₁ : Closeds Y} (hUC : Uᶜ ⊆ C₁)
    (hC₁ : IsPureCodimOne C₁) {T : Closeds X'} (hT : IsPureCodimOne T) :
    IsPureCodimOne (C₁ ⊔ T.preimage hh) := by
  intro W hW
  have hWsub : (W : Set Y) ⊆ (C₁ : Set Y) ∪ h ⁻¹' T := hW.1
  by_cases hWC : (W : Set Y) ⊆ C₁
  · exact hC₁ W ⟨hWC, fun W' hW' hle ↦ hW.2 (hW'.trans fun y hy ↦ Or.inl hy) hle⟩
  obtain ⟨w, hwW, hwC⟩ := Set.not_subset.mp hWC
  have hwU : w ∈ U := by by_contra hw; exact hwC (hUC hw)
  have hWT : (W : Set Y) ⊆ h ⁻¹' T :=
    ((isPreirreducible_iff_isClosed_union_isClosed.mp W.isIrreducible.isPreirreducible)
      _ _ C₁.isClosed (T.isClosed.preimage hh) hWsub).resolve_left hWC
  have hι : IsOpenEmbedding (Subtype.val : U → Y) := hU.isOpenEmbedding_subtypeVal
  let WU := preimageIrr hι W ⟨w, hwW, ⟨w, hwU⟩, rfl⟩
  have hWU : closureImage hι WU = W := closureImage_preimageIrr hι W _
  let Z := closureImage hψ WU
  have hZmax : Maximal (fun Z' : IrreducibleCloseds X' ↦ (Z' : Set X') ⊆ T) Z := by
    refine ⟨closure_minimal (by rintro _ ⟨u, hu, rfl⟩; exact hWT hu) T.isClosed,
      fun Z' hZ'T hZZ' ↦ ?_⟩
    let ZU := preimageIrr hψ Z'
      ⟨h w, hZZ' (subset_closure ⟨⟨w, hwU⟩, hwW, rfl⟩), ⟨w, hwU⟩, rfl⟩
    have hW'sub : (closureImage hι ZU : Set Y) ⊆ (C₁ : Set Y) ∪ h ⁻¹' T :=
      (closure_minimal (by rintro _ ⟨u, hu, rfl⟩; exact hZ'T hu)
        (T.isClosed.preimage hh)).trans fun y hy ↦ Or.inr hy
    have hle : W ≤ closureImage hι ZU := by
      rw [← hWU]
      exact closure_mono (Set.image_mono fun u hu ↦ hZZ' (subset_closure ⟨u, hu, rfl⟩))
    have hle' := hW.2 hW'sub hle
    rw [← closureImage_preimageIrr hψ Z' _]
    refine closure_mono (Set.image_mono fun u hu ↦ hle' ?_)
    change u ∈ Subtype.val ⁻¹' (closureImage hι ZU : Set Y)
    rw [preimage_closureImage]; exact hu
  rw [← hWU, codimension_closureImage hι WU, ← codimension_closureImage hψ WU]
  exact hT Z hZmax

section SNC

/-- The support of a prime divisor, as an irreducible closed subset. -/
private noncomputable def primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    IrreducibleCloseds X :=
  IrreducibleCloseds.closureSingleton E.genericPoint

private lemma coe_primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    (primeIrr E : Set X) = E.support := by
  rw [E.support_eq_closure]; rfl

private lemma codimension_primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    codimension (primeIrr E) = 1 := E.codimension_one

private lemma exists_mem_of_subset_iUnion {X : Scheme.{u}}
    {s : Finset (AlgebraicGeometry.PrimeDivisor X)}
    (W : IrreducibleCloseds X) (hW : (W : Set X) ⊆ ⋃ E ∈ s, E.support) :
    ∃ E ∈ s, W ≤ primeIrr E := by
  classical
  obtain ⟨z, hz, hWz⟩ := (isIrreducible_iff_sUnion_isClosed.mp W.isIrreducible)
    (s.image AlgebraicGeometry.PrimeDivisor.support)
    (by
      intro z hz
      obtain ⟨E, -, rfl⟩ := Finset.mem_image.mp hz
      rw [← coe_primeIrr]; exact (primeIrr E).isClosed)
    (by
      intro x hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.mp (hW hx)
      exact ⟨E.support, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hE), hxE⟩)
  obtain ⟨E, hE, rfl⟩ := Finset.mem_image.mp hz
  exact ⟨E, hE, fun x hx ↦ by
    change x ∈ (primeIrr E : Set X); rw [coe_primeIrr]; exact hWz hx⟩

variable {k : Type u} [Field k]

/-- A closed subset of pure codimension one of an snc divisor is an snc divisor. -/
private lemma isSNCSubset_of_le {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {S C : Closeds X}
    (hS : IsSNCSubset sX S) (hC : IsPureCodimOne C) (hCS : C ≤ S) : IsSNCSubset sX C := by
  classical
  rcases hS with rfl | ⟨s, hs, hsnc⟩
  · exact Or.inl (le_bot_iff.mp hCS)
  right
  refine ⟨s.filter (fun E ↦ E.support ⊆ C), ?_, ?_⟩
  · apply subset_antisymm
    · intro x hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.mp hx
      exact (Finset.mem_filter.mp hE).2 hxE
    · intro x hx
      obtain ⟨W, hW, hxW⟩ := exists_maximal_ge C.isClosed
        (IrreducibleCloseds.closureSingleton x) (by
          change closure {x} ⊆ (C : Set X)
          exact closure_minimal (by simpa using hx) C.isClosed)
      have hxW' : x ∈ (W : Set X) := hxW (subset_closure rfl)
      obtain ⟨E, hE, hWE⟩ := exists_mem_of_subset_iUnion W (hs ▸ hW.1.trans hCS)
      have hWE' : W = primeIrr E := by
        by_contra hne
        have hlt : W < primeIrr E := lt_of_le_of_ne hWE hne
        have := Order.coheight_add_one_le hlt
        rw [← codimension_eq_coheight, ← codimension_eq_coheight, codimension_primeIrr,
          hC W hW] at this
        exact absurd this (by decide)
      refine Set.mem_iUnion₂.mpr ⟨E, Finset.mem_filter.mpr ⟨hE, ?_⟩, ?_⟩
      · rw [← coe_primeIrr, ← hWE']; exact hW.1
      · rw [← coe_primeIrr, ← hWE']; exact hxW'
  · refine hsnc.of_support_subset ?_
    intro E hE
    rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply] at hE ⊢
    simp only [Finsupp.single_apply] at hE ⊢
    rw [Finset.sum_ite_eq'] at hE ⊢
    split_ifs at hE with h1
    · rw [if_pos (Finset.mem_filter.mp h1).1]; exact one_ne_zero
    · exact absurd rfl hE

end SNC

section Exceptional

/-- If `a ≫ b` is an isomorphism, `a` is dominant, the source of `b` is reduced and `b` is
separated, then `b` is an isomorphism. -/
private lemma isIso_of_isIso_comp {A B V : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ V) [IsIso (a ≫ b)]
    [IsDominant a] [IsReduced B] [IsSeparated b] : IsIso b := by
  refine ⟨⟨inv (a ≫ b) ≫ a, ?_, by simp⟩⟩
  refine ext_of_isDominant_of_isSeparated b ?_ a ?_
  · simp
  · rw [← Category.assoc, IsIso.hom_inv_id_assoc, Category.comp_id]

/-- If `h ≫ g` is an isomorphism over `V`, with `h` dominant, `X'` reduced and `g` separated,
then `g` is an isomorphism over `V` and `h` over `g⁻¹(V)`. -/
private lemma isBiregular_of_isBiregular_comp {Y X' X : Scheme.{u}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsDominant h] [IsReduced X'] [IsSeparated g] {V : X.Opens}
    (hV : IsBiregular (h ≫ g) V) : IsBiregular g V ∧ IsBiregular h (g ⁻¹ᵁ V) := by
  unfold IsBiregular at hV ⊢
  rw [morphismRestrict_comp] at hV
  have : IsDominant (h ∣_ g ⁻¹ᵁ V) := IsZariskiLocalAtTarget.restrict ‹IsDominant h› _
  have : IsSeparated (g ∣_ V) := IsZariskiLocalAtTarget.restrict ‹IsSeparated g› _
  have := @isIso_of_isIso_comp _ _ _ (h ∣_ g ⁻¹ᵁ V) (g ∣_ V) hV _ _ _
  exact ⟨this, @IsIso.of_isIso_comp_right _ _ _ _ _ _ (g ∣_ V) this hV⟩

/-- The exceptional set of a composite. -/
private lemma exceptionalSet_comp {Y X' X : Scheme.{u}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsDominant h] [IsReduced X'] [IsSeparated g] [UniversallyClosed g] :
    MMP.Mori.exceptionalSet (h ≫ g) = MMP.Mori.exceptionalSet h ⊔ (MMP.Mori.exceptionalSet g).preimage h.continuous := by
  apply SetLike.coe_injective
  ext y
  change y ∈ MMP.Mori.exceptionalSet (h ≫ g) ↔ y ∈ MMP.Mori.exceptionalSet h ∨ h y ∈ MMP.Mori.exceptionalSet g
  simp only [mem_exceptionalSet]
  constructor
  · intro hy
    by_contra hne
    push Not at hne
    obtain ⟨hyh, hyg⟩ := hne
    apply hy
    have hcl : IsClosed (g '' (biregularLocus h : Set X')ᶜ) :=
      g.isClosedMap _ (biregularLocus h).isOpen.isClosed_compl
    let W : X.Opens := biregularLocus g ⊓ ⟨_, hcl.isOpen_compl⟩
    have hWg : IsBiregular g W :=
      isBiregular_iff_le_biregularLocus.mpr inf_le_left
    have hWh : IsBiregular h (g ⁻¹ᵁ W) := by
      refine isBiregular_iff_le_biregularLocus.mpr ?_
      intro x hx
      by_contra hxU
      exact hx.2 ⟨x, hxU, rfl⟩
    have hiso : IsBiregular (h ≫ g) W := by
      unfold IsBiregular at *
      rw [morphismRestrict_comp]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ hWh hWg
    refine le_biregularLocus hiso ⟨hyg, ?_⟩
    rintro ⟨x, hx, hxy⟩
    have : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
    have hxy' : g x = g (h y) := hxy.trans (Scheme.Hom.comp_apply h g y)
    have hx' : g x ∈ biregularLocus g := hxy' ▸ hyg
    have hinj := (g ∣_ biregularLocus g).isOpenEmbedding.injective
      (a₁ := (⟨x, hx'⟩ : g ⁻¹ᵁ biregularLocus g)) (a₂ := ⟨h y, hyg⟩)
    have : x = h y := congrArg Subtype.val (hinj (Subtype.ext
      ((morphismRestrict_base_coe g _ _).trans (hxy'.trans
        (morphismRestrict_base_coe g (biregularLocus g) ⟨h y, hyg⟩).symm))))
    exact hx (this ▸ hyh)
  · intro hy hmem
    have hb := isBiregular_of_isBiregular_comp h g (isBiregular_biregularLocus (h ≫ g))
    rcases hy with hy | hy
    · exact hy (le_biregularLocus hb.2 hmem)
    · exact hy (le_biregularLocus hb.1 hmem)

end Exceptional

section Main

private lemma isOpenEmbedding_restrict_biregularLocus {Y X' : Scheme.{u}} (h : Y ⟶ X') :
    Topology.IsOpenEmbedding ((h ⁻¹ᵁ biregularLocus h : Set Y).restrict h) := by
  have : IsIso (h ∣_ biregularLocus h) := isBiregular_biregularLocus h
  have e1 := (h ∣_ biregularLocus h).isOpenEmbedding
  have e2 : Topology.IsOpenEmbedding (Subtype.val : biregularLocus h → X') :=
    (biregularLocus h).isOpen.isOpenEmbedding_subtypeVal
  have heq : (h ⁻¹ᵁ biregularLocus h : Set Y).restrict h =
      Subtype.val ∘ (h ∣_ biregularLocus h) :=
    funext fun x ↦ (morphismRestrict_base_coe h (biregularLocus h) x).symm
  rw [heq]
  exact e2.comp e1

end Main

end LogRes

/-- The support of a divisor is of pure codimension one. -/
private theorem isPureCodimOne_supp {X : Scheme.{0}} {R : Type*} [Zero R]
    (D : DivisorWithCoeffs R X) : MMP.Mori.IsPureCodimOne D.supp := by
  intro W hW
  have hsub : (W : Set X) ⊆ ⋃ E ∈ D.support, E.support := fun x hx => by
    obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp (hW.1 hx)
    exact Set.mem_iUnion₂.mpr ⟨E, Finsupp.mem_support_iff.mpr hE, hxE⟩
  obtain ⟨E, hE, hWE⟩ := LogRes.exists_mem_of_subset_iUnion W hsub
  have hEW : LogRes.primeIrr E ≤ W := hW.2 (by
    intro x hx
    rw [LogRes.coe_primeIrr] at hx
    exact DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, Finsupp.mem_support_iff.mp hE, hx⟩) hWE
  rw [le_antisymm hWE hEW, LogRes.codimension_primeIrr]

/-- The generic point of an integral scheme lies on no prime divisor. -/
private theorem genericPoint_notMem_supp' {X : Scheme.{0}} [IsIntegral X] {R : Type*} [Zero R]
    (D : DivisorWithCoeffs R X) : genericPoint X ∉ D.supp := by
  intro h
  obtain ⟨E, -, hE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
  have h1 : E.genericPoint ⤳ genericPoint X := specializes_iff_mem_closure.mpr hE
  have h2 : genericPoint X ⤳ E.genericPoint := (genericPoint_spec X).specializes trivial
  have heq : E.genericPoint = genericPoint X := (h1.antisymm h2).eq
  have hmax : Order.coheight (genericPoint X) = 0 :=
    Order.coheight_eq_zero.mpr fun b _ => (genericPoint_spec X).specializes trivial
  have := E.coheight_genericPoint
  rw [heq, hmax] at this
  exact zero_ne_one this

/-- A proper birational morphism onto a normal variety is biregular over the generic point. -/
private theorem genericPoint_mem_biregularLocus' {k : Type} [Field k] {X Y : Scheme.{0}}
    [IsIntegral X] {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX) (f : Y ⟶ X)
    (hY : MMP.Mori.IsVariety k (f ≫ sX)) [IsProper f] (hf : IsBirationalMorphism f) :
    genericPoint X ∈ biregularLocus f := by
  haveI : IsNormal X := hX.2
  have h := MMP.Mori.two_le_closedsCodimension_compl_biregularLocus sX f (hY := hX.1) (hX := hY) hf
  by_contra hη
  have h2 := (MMP.Flips.le_closedsCodimension_iff_le_coheight.mp h) (genericPoint X) hη
  have h0 : Order.coheight (genericPoint X) = 0 := Order.coheight_eq_zero.mpr fun y _ =>
    (Scheme.le_iff_specializes).mpr ((genericPoint_spec X).specializes (Set.mem_univ y))
  rw [h0] at h2
  exact absurd h2 (by decide)

/-- An open contained in the smooth locus is smooth. -/
private theorem isSmoothScheme_ι_of_le_smoothLocus {k : Type} [Field k] {X : Scheme.{0}}
    (f : X ⟶ Spec (.of k)) [LocallyOfFinitePresentation f] {U : X.Opens}
    (hU : U ≤ f.smoothLocus) : MMP.Mori.IsSmoothScheme (U.ι ≫ f) := by
  rw [MMP.Mori.isSmoothScheme_iff, ← Scheme.Hom.smoothLocus_eq_top_iff,
    ← Scheme.Hom.preimage_smoothLocus_eq]
  exact eq_top_iff.mpr fun x _ => hU x.2

/-- **One side of a common log resolution.** Let `p₀ : W₀ ⟶ X` be a projective birational
morphism onto a `ℚ`-factorial variety and `U ⊆ W₀` an open missing `Ex(p₀)` and `p₀⁻¹ Supp B`.
A resolution `h : W ⟶ W₀` which is an isomorphism over `U` and has snc complement of `h⁻¹ U`
makes `h ≫ p₀` a projective log resolution of `(X, B)`. -/
private theorem isLogResolution_comp_of_isIso_restrict {X W₀ W : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral W₀] {sX : X ⟶ Spec (.of ℂ)}
    (hQX : IsQFactorial sX) (B : QDivisor X) (p₀ : W₀ ⟶ X) [IsProper p₀]
    (hp₀H : IsProjectiveMorphism (p₀ ≫ sX)) (hp₀B : IsBirationalMorphism p₀) (U : W₀.Opens)
    (hU : ∀ w ∈ U, w ∉ exceptionalSet p₀ ∧ p₀ w ∉ (QDivisor.toRDivisor B).supp) (h : W ⟶ W₀)
    (hres : MMP.Resolution.IsResolutionOfVariety (p₀ ≫ sX) h) (hhU : IsIso (h ∣_ U))
    (hsnc : MMP.Resolution.IsSNCClosedSubset (h ≫ p₀ ≫ sX) (h ⁻¹' (U : Set W₀))ᶜ) :
    MMP.Fourfold.IsLogResolution sX B (h ≫ p₀) := by
  haveI : IsIntegral W := hres.isVariety_source.toIsIntegral
  haveI : LocallyOfFiniteType (h ≫ p₀ ≫ sX) := hres.isVariety_source.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (h ≫ p₀ ≫ sX)
  haveI : QuasiCompact (h ≫ p₀ ≫ sX) := hres.isVariety_source.toQuasiCompact
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (h ≫ p₀ ≫ sX)
  haveI : IsNoetherian W := {}
  haveI : IsProper h := hres.isProjective.isProper
  have hhb := hres.isBirationalMorphism
  haveI : IsDominant h := hhb.isDominant
  haveI : IsSeparated sX := hQX.1.1.toIsSeparated
  have hpB : IsBirationalMorphism (h ≫ p₀) := MMP.Mori.isBirationalMorphism_comp hhb hp₀B
  have hpH : IsProjectiveMorphism (h ≫ p₀) := by
    have h1 : IsProjective ((h ≫ p₀) ≫ sX) := by
      rw [Category.assoc]; exact hres.isProjective.comp hp₀H.isProjective
    exact IsProjectiveMorphism.of_comp _ sX (isProjectiveMorphism_of_isProjective_of_isAffine _ h1)
  have hExc : IsPureCodimOne (exceptionalSet (h ≫ p₀)) :=
    MMP.Mori.isPureCodimOne_exceptionalSet_of_isQFactorial sX (h ≫ p₀ ≫ sX) hQX
      hres.isVariety_source (h ≫ p₀) (Category.assoc _ _ _) hpH hpB
  have hS : IsSNCSubset ((h ≫ p₀) ≫ sX) (h ⁻¹ᵁ U).compl := by
    rw [Category.assoc]
    exact MMP.ProgramBaseChange.isSNCSubset_of_isSNCClosedSubset hres.isSmoothScheme hsnc
  have hle : exceptionalSet (h ≫ p₀) ⊔ (QDivisor.toRDivisor B).supp.preimage (h ≫ p₀).continuous ≤
      (h ⁻¹ᵁ U).compl := by
    rw [LogRes.exceptionalSet_comp h p₀]
    rintro w ((hw | hw) | hw) hwU
    · exact hw (le_biregularLocus (f := h) (V := U) hhU hwU)
    · exact (hU _ hwU).1 hw
    · exact (hU _ hwU).2 hw
  have hpure : IsPureCodimOne (exceptionalSet (h ≫ p₀) ⊔
      (QDivisor.toRDivisor B).supp.preimage (h ≫ p₀).continuous) :=
    LogRes.isPureCodimOne_sup_preimage (h ≫ p₀).continuous
      ((h ≫ p₀) ⁻¹ᵁ biregularLocus (h ≫ p₀)).isOpen
      (LogRes.isOpenEmbedding_restrict_biregularLocus _) (fun _ hy => hy) hExc
      (isPureCodimOne_supp _)
  exact ⟨⟨⟨inferInstance, hpB, by rw [Category.assoc]; exact hres.isSmoothScheme⟩, hExc,
    LogRes.isSNCSubset_of_le hS hpure hle⟩, hpH⟩

/-- **A common log resolution of a birational map.** For a birational identification
`σ : k(Y) ≅ k(X)` of `ℚ`-factorial projective complex varieties and `ℚ`-divisors `B` on `X`, `C`
on `Y`, there is a smooth `W` with projective log resolutions `p : W ⟶ X` of `(X, B)` and
`q : W ⟶ Y` of `(Y, C)` over `ℂ` such that `q^* = p^* ∘ σ`. -/
private theorem exists_isLogResolution_of_functionFieldEquiv {X Y : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)}
    (hXp : Mori.IsProjectiveVariety ℂ sX) (hYp : Mori.IsProjectiveVariety ℂ sY)
    (hQX : IsQFactorial sX) (hQY : IsQFactorial sY) (B : QDivisor X) (C : QDivisor Y)
    (σ : FunctionFieldEquiv sX sY) :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (p : W ⟶ X) (q : W ⟶ Y) (_ : IsDominant p) (_ : IsDominant q),
      MMP.Fourfold.IsLogResolution sX B p ∧ MMP.Fourfold.IsLogResolution sY C q ∧
      p ≫ sX = q ≫ sY ∧ ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a) := by
  classical
  have hXn : IsNormalVariety ℂ sX := hQX.1
  have hYn : IsNormalVariety ℂ sY := hQY.1
  have hXH : IsProjectiveMorphism sX := ((MMP.Mori.isProjectiveVariety_iff ℂ _).mp hXp).2
  have hYH : IsProjectiveMorphism sY := ((MMP.Mori.isProjectiveVariety_iff ℂ _).mp hYp).2
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ hXH
  haveI : IsProper sY := isProper_of_isProjectiveMorphism _ hYH
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsNoetherian X := {}
  haveI : IsNoetherian Y := {}
  obtain ⟨W₀, _, _, p₀, q₀, _, _, hp₀P, hq₀P, hp₀b, hq₀b, hpq₀, hcompat₀, g, hgfin, hg⟩ :=
    exists_model_of_functionFieldEquiv σ
  haveI := hp₀P
  haveI := hq₀P
  haveI := hgfin
  have hW₀n : IsNormalVariety ℂ (p₀ ≫ sX) := isNormalVariety_comp_of_isProper hXn p₀
  have hW₀n' : IsNormalVariety ℂ (q₀ ≫ sY) := isNormalVariety_comp_of_isProper hYn q₀
  haveI : LocallyOfFiniteType (p₀ ≫ sX) := hW₀n.1.toLocallyOfFiniteType
  have hp₀B := isBirationalMorphism_of_isBirational' p₀ hp₀b
  have hq₀B := isBirationalMorphism_of_isBirational' q₀ hq₀b
  -- projectivity of the two projections
  have hpX : IsProjectiveMorphism (p₀ ≫ sX) := by
    rw [← hg, Category.assoc]
    exact isProjectiveMorphism_comp_of_isFinite g _ ((hYH.baseChange sX).comp hXH)
  have hqY : IsProjectiveMorphism (q₀ ≫ sY) := hpq₀ ▸ hpX
  -- the open `U` of smooth points off the exceptional sets and the boundaries
  set Z : TopologicalSpace.Closeds W₀ := exceptionalSet p₀ ⊔ exceptionalSet q₀ ⊔
    (QDivisor.toRDivisor B).supp.preimage p₀.continuous ⊔
    (QDivisor.toRDivisor C).supp.preimage q₀.continuous with hZ
  set U : W₀.Opens := (p₀ ≫ sX).smoothLocus ⊓ ⟨(Z : Set W₀)ᶜ, Z.isClosed.isOpen_compl⟩ with hU
  have hpη : p₀ (genericPoint W₀) = genericPoint X := MMP.Positivity.map_genericPoint_eq_of_isDominant p₀
  have hqη : q₀ (genericPoint W₀) = genericPoint Y := MMP.Positivity.map_genericPoint_eq_of_isDominant q₀
  have hηU : genericPoint W₀ ∈ U := by
    refine ⟨(p₀ ≫ sX).genericPoint_mem_smoothLocus_of_perfectField, ?_⟩
    rintro (((h1 | h2) | h3) | h4)
    · apply h1
      change p₀ (genericPoint W₀) ∈ biregularLocus p₀
      rw [hpη]
      exact genericPoint_mem_biregularLocus' hXn p₀ hW₀n.1 hp₀B
    · apply h2
      change q₀ (genericPoint W₀) ∈ biregularLocus q₀
      rw [hqη]
      exact genericPoint_mem_biregularLocus' hYn q₀ hW₀n'.1 hq₀B
    · have h3' : p₀ (genericPoint W₀) ∈ (QDivisor.toRDivisor B).supp := h3
      rw [hpη] at h3'
      exact genericPoint_notMem_supp' _ h3'
    · have h4' : q₀ (genericPoint W₀) ∈ (QDivisor.toRDivisor C).supp := h4
      rw [hqη] at h4'
      exact genericPoint_notMem_supp' _ h4'
  obtain ⟨W, h, hres, hhU, hsnc⟩ :=
    MMP.Resolution.exists_isResolutionOfVariety_isIso_restrict_isSNCClosedSubset_compl (p₀ ≫ sX)
      hW₀n.1 U ⟨_, hηU⟩ (isSmoothScheme_ι_of_le_smoothLocus _ inf_le_left)
  have hres' : MMP.Resolution.IsResolutionOfVariety (q₀ ≫ sY) h := hpq₀ ▸ hres
  have hsnc' : MMP.Resolution.IsSNCClosedSubset (h ≫ q₀ ≫ sY) (h ⁻¹' (U : Set W₀))ᶜ :=
    hpq₀ ▸ hsnc
  have hlp := isLogResolution_comp_of_isIso_restrict hQX B p₀ hpX hp₀B U
    (fun w hw => ⟨fun h1 => hw.2 (Or.inl (Or.inl (Or.inl h1))),
      fun h3 => hw.2 (Or.inl (Or.inr h3))⟩) h hres hhU hsnc
  have hlq := isLogResolution_comp_of_isIso_restrict hQY C q₀ hqY hq₀B U
    (fun w hw => ⟨fun h2 => hw.2 (Or.inl (Or.inl (Or.inr h2))),
      fun h4 => hw.2 (Or.inr h4)⟩) h hres' hhU hsnc'
  haveI : IsIntegral W := hres.isVariety_source.toIsIntegral
  haveI : LocallyOfFiniteType (h ≫ p₀ ≫ sX) := hres.isVariety_source.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (h ≫ p₀ ≫ sX)
  obtain ⟨hWn, -, -⟩ := hlp.toIsSmoothResolution.isNormalVariety hXn
  haveI : IsNormal W := hWn.2
  haveI : IsDominant h := hres.isBirationalMorphism.isDominant
  refine ⟨W, inferInstance, inferInstance, inferInstance, h ≫ p₀, h ≫ q₀, inferInstance,
    inferInstance, hlp, hlq, by rw [Category.assoc, Category.assoc, hpq₀], fun a => ?_⟩
  rw [← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
    ← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply, hcompat₀]
  rfl

/-- **A common log resolution through a modification.** As
`exists_isLogResolution_of_functionFieldEquiv`, for `σ : k(Y) ≅ k(X)` and a projective
birational `g : Y ⟶ Z` onto a third `ℚ`-factorial variety: `p` is a log resolution of `(X, B)`
and `q ≫ g` one of `(Z, D)`. -/
private theorem exists_isLogResolution_of_functionFieldEquiv_comp {X Y : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {Z : Scheme.{0}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} (g : Y ⟶ Z)
    (hXp : Mori.IsProjectiveVariety ℂ sX) (hYp : Mori.IsProjectiveVariety ℂ (g ≫ sZ))
    (hQX : IsQFactorial sX) (hQY : IsQFactorial (g ≫ sZ)) (hQZ : IsQFactorial sZ)
    (hgP : IsProjectiveMorphism g) (hgb : IsBirationalMorphism g) (B : QDivisor X)
    (D : QDivisor Z) (σ : FunctionFieldEquiv sX (g ≫ sZ)) :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (p : W ⟶ X) (q : W ⟶ Y) (_ : IsDominant p) (_ : IsDominant q),
      MMP.Fourfold.IsLogResolution sX B p ∧ MMP.Fourfold.IsLogResolution sZ D (q ≫ g) ∧
      IsProper q ∧ IsBirationalMorphism q ∧
      p ≫ sX = q ≫ g ≫ sZ ∧ ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a) := by
  classical
  have hXn : IsNormalVariety ℂ sX := hQX.1
  have hYn : IsNormalVariety ℂ (g ≫ sZ) := hQY.1
  have hZn : IsNormalVariety ℂ sZ := hQZ.1
  have hXH : IsProjectiveMorphism sX := ((MMP.Mori.isProjectiveVariety_iff ℂ _).mp hXp).2
  have hYH : IsProjectiveMorphism (g ≫ sZ) := ((MMP.Mori.isProjectiveVariety_iff ℂ _).mp hYp).2
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _ hXH
  haveI : IsProper (g ≫ sZ) := isProper_of_isProjectiveMorphism _ hYH
  haveI : IsProper g := isProper_of_isProjectiveMorphism _ hgP
  haveI : IsSeparated sZ := hZn.1.toIsSeparated
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (g ≫ sZ)
  haveI : IsNoetherian X := {}
  haveI : IsNoetherian Y := {}
  obtain ⟨W₀, _, _, p₀, q₀, _, _, hp₀P, hq₀P, hp₀b, hq₀b, hpq₀, hcompat₀, gf, hgfin, hgf⟩ :=
    exists_model_of_functionFieldEquiv σ
  haveI := hp₀P
  haveI := hq₀P
  haveI := hgfin
  haveI : IsDominant g := hgb.isDominant
  have hW₀n : IsNormalVariety ℂ (p₀ ≫ sX) := isNormalVariety_comp_of_isProper hXn p₀
  have hW₀n' : IsNormalVariety ℂ ((q₀ ≫ g) ≫ sZ) := isNormalVariety_comp_of_isProper hZn (q₀ ≫ g)
  haveI : LocallyOfFiniteType (p₀ ≫ sX) := hW₀n.1.toLocallyOfFiniteType
  have hp₀B := isBirationalMorphism_of_isBirational' p₀ hp₀b
  have hq₀B := isBirationalMorphism_of_isBirational' q₀ hq₀b
  have hqgB : IsBirationalMorphism (q₀ ≫ g) := MMP.Mori.isBirationalMorphism_comp hq₀B hgb
  -- projectivity of the two projections
  have hpX : IsProjectiveMorphism (p₀ ≫ sX) := by
    rw [← hgf, Category.assoc]
    exact isProjectiveMorphism_comp_of_isFinite gf _ ((hYH.baseChange sX).comp hXH)
  have hqY : IsProjectiveMorphism ((q₀ ≫ g) ≫ sZ) := by
    rw [Category.assoc, ← hpq₀]; exact hpX
  -- the open `U` of smooth points off the exceptional sets and the boundaries
  set Zc : TopologicalSpace.Closeds W₀ := exceptionalSet p₀ ⊔ exceptionalSet (q₀ ≫ g) ⊔
    (QDivisor.toRDivisor B).supp.preimage p₀.continuous ⊔
    (QDivisor.toRDivisor D).supp.preimage (q₀ ≫ g).continuous with hZc
  set U : W₀.Opens := (p₀ ≫ sX).smoothLocus ⊓ ⟨(Zc : Set W₀)ᶜ, Zc.isClosed.isOpen_compl⟩ with hU
  have hpη : p₀ (genericPoint W₀) = genericPoint X :=
    MMP.Positivity.map_genericPoint_eq_of_isDominant p₀
  have hqη : (q₀ ≫ g) (genericPoint W₀) = genericPoint Z :=
    MMP.Positivity.map_genericPoint_eq_of_isDominant (q₀ ≫ g)
  have hηU : genericPoint W₀ ∈ U := by
    refine ⟨(p₀ ≫ sX).genericPoint_mem_smoothLocus_of_perfectField, ?_⟩
    rintro (((h1 | h2) | h3) | h4)
    · apply h1
      change p₀ (genericPoint W₀) ∈ biregularLocus p₀
      rw [hpη]
      exact genericPoint_mem_biregularLocus' hXn p₀ hW₀n.1 hp₀B
    · apply h2
      change (q₀ ≫ g) (genericPoint W₀) ∈ biregularLocus (q₀ ≫ g)
      rw [hqη]
      exact genericPoint_mem_biregularLocus' hZn (q₀ ≫ g) hW₀n'.1 hqgB
    · have h3' : p₀ (genericPoint W₀) ∈ (QDivisor.toRDivisor B).supp := h3
      rw [hpη] at h3'
      exact genericPoint_notMem_supp' _ h3'
    · have h4' : (q₀ ≫ g) (genericPoint W₀) ∈ (QDivisor.toRDivisor D).supp := h4
      rw [hqη] at h4'
      exact genericPoint_notMem_supp' _ h4'
  obtain ⟨W, h, hres, hhU, hsnc⟩ :=
    MMP.Resolution.exists_isResolutionOfVariety_isIso_restrict_isSNCClosedSubset_compl (p₀ ≫ sX)
      hW₀n.1 U ⟨_, hηU⟩ (isSmoothScheme_ι_of_le_smoothLocus _ inf_le_left)
  have hpq₀' : p₀ ≫ sX = (q₀ ≫ g) ≫ sZ := by rw [hpq₀, Category.assoc]
  have hres' : MMP.Resolution.IsResolutionOfVariety ((q₀ ≫ g) ≫ sZ) h := hpq₀' ▸ hres
  have hsnc' : MMP.Resolution.IsSNCClosedSubset (h ≫ (q₀ ≫ g) ≫ sZ) (h ⁻¹' (U : Set W₀))ᶜ :=
    hpq₀' ▸ hsnc
  have hlp := isLogResolution_comp_of_isIso_restrict hQX B p₀ hpX hp₀B U
    (fun w hw => ⟨fun h1 => hw.2 (Or.inl (Or.inl (Or.inl h1))),
      fun h3 => hw.2 (Or.inl (Or.inr h3))⟩) h hres hhU hsnc
  have hlq := isLogResolution_comp_of_isIso_restrict hQZ D (q₀ ≫ g) hqY hqgB U
    (fun w hw => ⟨fun h2 => hw.2 (Or.inl (Or.inl (Or.inr h2))),
      fun h4 => hw.2 (Or.inr h4)⟩) h hres' hhU hsnc'
  haveI : IsIntegral W := hres.isVariety_source.toIsIntegral
  haveI : LocallyOfFiniteType (h ≫ p₀ ≫ sX) := hres.isVariety_source.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (h ≫ p₀ ≫ sX)
  obtain ⟨hWn, -, -⟩ := hlp.toIsSmoothResolution.isNormalVariety hXn
  haveI : IsNormal W := hWn.2
  haveI : IsDominant h := hres.isBirationalMorphism.isDominant
  haveI : IsProper h := hres.isProjective.isProper
  refine ⟨W, inferInstance, inferInstance, inferInstance, h ≫ p₀, h ≫ q₀, inferInstance,
    inferInstance, hlp, by rw [Category.assoc]; exact hlq, inferInstance,
    MMP.Mori.isBirationalMorphism_comp hres.isBirationalMorphism hq₀B,
    by rw [Category.assoc, Category.assoc, hpq₀], fun a => ?_⟩
  rw [← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply,
    ← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply, hcompat₀]
  rfl

/-- **Crepant boundaries agree along a crepant birational map.** If `σ : (X, B) ⇢ (Y, C)` is
crepant and `p : W ⟶ X`, `q : W ⟶ Y` are proper birational with `q^* = p^* ∘ σ`, the crepant
boundary of `(X, B)` on `W` is also the crepant boundary of `(Y, C)`. -/
private theorem isCrepantBoundary_of_isCrepantBirationalMap {X Y W : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sX : X ⟶ Spec (.of ℂ)} {sY : Y ⟶ Spec (.of ℂ)} {B : QDivisor X} {C : QDivisor Y}
    (hPY : MMP.Mori.IsPair sY C) {d : ℕ} {K : Divisor X} {K' : Divisor Y}
    (hK' : K'.IsCanonicalDivisor sY d)
    (σ : FunctionFieldEquiv sX sY) (hσ : IsCrepantBirationalMap sX sY B C σ)
    (p : W ⟶ X) (q : W ⟶ Y) [IsProper p] [IsProper q] [IsDominant p] [IsDominant q]
    (hWp : IsNormalVariety ℂ (p ≫ sX)) (hWq : IsNormalVariety ℂ (q ≫ sY))
    (hpb : IsBirationalMorphism p) (hqb : IsBirationalMorphism q)
    (hcompat : ∀ a, functionFieldMap q a = functionFieldMap p ((σ.toHom) a)) {BW : QDivisor W}
    (hBW : IsCrepantBoundary sX d K B p hWp hpb BW) :
    IsCrepantBoundary sY d K' C q hWq hqb BW := by
  intro F
  let DX : DivisorOver ℂ sX := ⟨W, p, hWp, hpb, F⟩
  let DY : DivisorOver ℂ sY := ⟨W, q, hWq, hqb, F⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPY hK' DY
  have hlogX := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hBW F)
    (show IsProper p from inferInstance)
  have hlogY := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper q from inferInstance)
  obtain ⟨n', D, hDv, hDlog⟩ := (hσ DX.valuation _).mp ⟨d, DX, rfl, hlogX⟩
  have hv : D.valuation = DY.valuation := by
    rw [hDv]
    ext g
    change F.divisorialValuation (functionFieldMap p ((σ.toHom) g)) =
      F.divisorialValuation (functionFieldMap q g)
    rw [hcompat]
  have he := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hDlog hlogY hv
  have : ((-BW.coeff F : ℚ) : ℝ) = ((c : ℚ) : ℝ) := by linarith
  have hc' : c = -BW.coeff F := by exact_mod_cast this.symm
  exact hc' ▸ hc

/-- Two dominant morphisms of integral schemes into a scheme separated over a base agree when
they agree over the base and pull back rational functions in the same way. -/
private theorem eq_of_functionFieldMap_eq {W R S : Scheme.{0}} [IsIntegral W] [IsIntegral R]
    (u v : W ⟶ R) [IsDominant u] [IsDominant v] (s : R ⟶ S) [IsSeparated s]
    (hs : u ≫ s = v ≫ s) (h : ∀ a, functionFieldMap u a = functionFieldMap v a) : u = v := by
  haveI : IsDominant (W.fromSpecStalk (genericPoint W)) :=
    ⟨Dense.mono (Set.singleton_subset_iff.mpr ⟨_, Scheme.fromSpecStalk_closedPoint⟩)
      (by rw [dense_iff_closure_eq, (genericPoint_spec W).def])⟩
  refine ext_of_isDominant_of_isSeparated s hs (W.fromSpecStalk (genericPoint W)) ?_
  rw [← functionFieldMap_fromSpecStalk u, ← functionFieldMap_fromSpecStalk v]
  congr 2
  ext a
  exact h a

end CommonLogResolution

namespace GenusFibre

open MMP.Flips

section GenericFiberTorsion

open MMP.Mori MonoidalCategory

/-- The generic fibre of a morphism from a normal scheme to an integral scheme is normal: its
local rings are local rings of the source. -/
private theorem isNormal_genericFiber {V W : Scheme.{u}} (g : V ⟶ W) [IsNormal V]
    [IsIntegral W] : IsNormal (g.fiber (genericPoint W)) where
  stalk_isDomain p := by
    have := isIso_stalkMap_fiberι_genericPoint' g p
    exact Function.Injective.isDomain _
      (asIso ((g.fiberι _).stalkMap p)).commRingCatIsoToRingEquiv.symm.injective
  stalk_normal p := by
    have := isIso_stalkMap_fiberι_genericPoint' g p
    have := IsNormal.stalk_normal (X := V) ((g.fiberι _) p)
    exact IsIntegrallyClosed.of_equiv
      (asIso ((g.fiberι _).stalkMap p)).commRingCatIsoToRingEquiv

/-! ### Differentials along a morphism with bijective stalk maps -/

open Stacks.RelativeDifferentialStalkMap in
/-- For `f : X ⟶ Y` over `S` whose stalk maps are all isomorphisms (for instance the inclusion
of a generic fibre), the canonical map `f^* Ω_{Y/S} ⟶ Ω_{X/S}` is an isomorphism: on stalks it is
`𝒪_{X,x} ⊗_{𝒪_{Y,f x}} Ω_{𝒪_{Y,f x}/𝒪_S} ⟶ Ω_{𝒪_{X,x}/𝒪_S}`, which is bijective when
`𝒪_{Y,f x} ⟶ 𝒪_{X,x}` is. -/
private theorem isIso_relativeDifferentialsMap_of_isIso_stalkMap {X Y S : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ S) (hf : ∀ x, IsIso (f.stalkMap x)) :
    IsIso (Scheme.Hom.relativeDifferentialsMap f g (f ≫ g) (𝟙 S)
      (Category.comp_id (f ≫ g)).symm) := by
  classical
  set φ := Scheme.Hom.relativeDifferentialsMap f g (f ≫ g) (𝟙 S) (Category.comp_id (f ≫ g)).symm
  have key : ∀ x : X, Function.Bijective (Stacks.Sheafify.ModuleStalkTensor.stalkLinearMapOfHom
      X.sheaf.presheaf x φ.val) := by
    intro x
    let R : Type u := ToType (S.presheaf.stalk (g.base (f.base x)))
    let A : Type u := ToType (Y.sheaf.presheaf.stalk (f.base x))
    let B : Type u := ToType (X.sheaf.presheaf.stalk x)
    let : Algebra R A := Scheme.Hom.algebraStalkMap g (f.base x)
    let : Algebra A B := (f.stalkMap x).hom.toAlgebra
    let : Algebra R B := Scheme.Hom.algebraStalkMap (f ≫ g) x
    let : IsScalarTower R A B := Scheme.Hom.isScalarTower_stalkMap f g x
    have hbij : Function.Bijective (algebraMap A B) :=
      (ConcreteCategory.isIso_iff_bijective (f.stalkMap x)).mp (hf x)
    let eAB : A ≃ₐ[A] B := AlgEquiv.ofBijective (Algebra.ofId A B) hbij
    let : Algebra.FormallySmooth A B := Algebra.FormallySmooth.of_equiv eAB
    obtain ⟨e, -, hbridge⟩ := Scheme.Hom.exists_relativeDifferentialsPullbackStalkEquiv f g x
    have hinj := KaehlerDifferential.mapBaseChange_injective R A B
    have hsurj : Function.Surjective (KaehlerDifferential.mapBaseChange R A B) := by
      rw [← LinearMap.range_eq_top, eq_top_iff, ← KaehlerDifferential.span_range_derivation,
        Submodule.span_le]
      rintro _ ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ := hbij.2 b
      exact ⟨1 ⊗ₜ KaehlerDifferential.D R A a, by
        rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]⟩
    let eK := relativeDifferentialsStalkKaehlerEquiv (f ≫ g) x
    refine ⟨fun z₁ z₂ hz => e.injective (hinj ?_), fun w => ?_⟩
    · rw [hbridge, hbridge]
      exact congrArg eK hz
    · obtain ⟨t, ht⟩ := hsurj (eK w)
      refine ⟨e.symm t, eK.injective ?_⟩
      rw [← hbridge, e.apply_symm_apply, ht]
  have : IsIso ((SheafOfModules.toSheaf X.ringCatSheaf).map φ) := by
    have : ∀ x : X, IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        ((SheafOfModules.toSheaf X.ringCatSheaf).map φ).hom) := fun x =>
      (ConcreteCategory.isIso_iff_bijective _).mpr (key x)
    exact TopCat.Presheaf.isIso_of_stalkFunctor_map_iso _
  exact @isIso_of_reflects_iso _ _ _ _ _ _ _ (SheafOfModules.toSheaf X.ringCatSheaf) this
    (PresheafOfModules.instReflectsIsomorphismsSheafOfModulesSheafAddCommGrpCatToSheaf_1
      (R := X.ringCatSheaf))

/-- The same, for a structure morphism `q` of `X` equal to `f ≫ g`. -/
private theorem isIso_relativeDifferentialsMap_of_isIso_stalkMap' {X Y S : Scheme.{u}}
    (f : X ⟶ Y) (g : Y ⟶ S) (q : X ⟶ S) (hq : f ≫ g = q ≫ 𝟙 S)
    (hf : ∀ x, IsIso (f.stalkMap x)) :
    IsIso (Scheme.Hom.relativeDifferentialsMap f g q (𝟙 S) hq) := by
  obtain rfl : q = f ≫ g := by simpa using hq.symm
  exact isIso_relativeDifferentialsMap_of_isIso_stalkMap f g hf

/-! ### Regular points over a perfect field are smooth -/

open MMP.Mori in
/-- A point of a scheme locally of finite type over a perfect field `k` whose local ring is
regular lies in the smooth locus: the local ring is formally smooth over `k`. -/
private theorem mem_smoothLocus_of_isRegularLocalRing {k : Type u} [Field k] [PerfectField k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (x : X)
    [IsRegularLocalRing (X.presheaf.stalk x)] : x ∈ smoothLocus sX := by
  have : LocallyOfFinitePresentation sX :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  have hfs : letI := stalkAlgebra sX x; Algebra.FormallySmooth k (X.presheaf.stalk x) := by
    let := stalkAlgebra sX x
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    have hU' : IsAffineOpen U := hU
    let x' : U := ⟨x, hxU⟩
    let := sectionAlgebra sX U
    have := finiteType_sectionAlgebra sX hU'
    let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf x'
    have := isScalarTower_section_stalk sX U x'
    have := hU'.isLocalization_stalk x'
    set q := (hU'.primeIdealOf x').asIdeal
    have := Algebra.isSeparableExtension_of_perfectField k q.ResidueField
    have hs : Algebra.IsSmoothAt k q :=
      (Algebra.isSmoothAt_iff_isRegularLocalRing q (X.presheaf.stalk x)).mpr inferInstance
    exact Algebra.FormallySmooth.of_equiv
      ((IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q)
        (X.presheaf.stalk x)).restrictScalars k)
  rw [smoothLocus_eq_smoothLocus, Scheme.Hom.mem_smoothLocus]
  let f : CommRingCat.of k ⟶ (Spec (.of k)).presheaf.stalk (sX x) :=
    (Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).presheaf.germ ⊤ _ (TopologicalSpace.Opens.mem_top _)
  have hiso : IsIso f := by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact ⟨RingHom.injective _, fieldBaseStalkAlgebraMap_surjective (Subsingleton.elim _ _)⟩
  have hcomp : f ≫ sX.stalkMap x =
      (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
        X.presheaf.germ ⊤ x (TopologicalSpace.Opens.mem_top _) := by
    have hg := Scheme.Hom.germ_stalkMap sX ⊤ x (TopologicalSpace.Opens.mem_top _)
    erw [Category.assoc, hg]
    rfl
  rw [← RingHom.FormallySmooth.respectsIso.cancel_left_isIso f, ← CommRingCat.hom_comp, hcomp]
  exact hfs

open MMP.Mori in
/-- The smooth locus of a morphism locally of finite presentation is smooth. -/
private theorem smooth_smoothLocus_ι {X Y : Scheme.{u}} (f : X ⟶ Y)
    [LocallyOfFinitePresentation f] : Smooth ((smoothLocus f).ι ≫ f) := by
  rw [smoothLocus_eq_smoothLocus, ← Scheme.Hom.smoothLocus_eq_top_iff,
    ← Scheme.Hom.preimage_smoothLocus_eq, Scheme.Opens.ι_preimage_self]

/-! ### The canonical sheaf of a generic fibre -/

section Canonical

private theorem nonempty_iso_unit_of_subsingleton {X : Scheme.{u}} [Subsingleton X]
    [Nonempty X] (L : X.Modules) (hL : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} L 1) :
    Nonempty (L ≅ SheafOfModules.unit X.ringCatSheaf) := by
  obtain ⟨x⟩ := ‹Nonempty X›
  have hinv : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L :=
    (Stacks.ModuleDescent.isInvertible_iff_isFiniteLocallyFreeOfRank_one X L).mpr hL
  obtain ⟨U, hxU, ⟨e⟩⟩ := (isInvertible_iff_exists_restrict_iso_unit X L).mp hinv x
  have hU : U = ⊤ := eq_top_iff.mpr fun y _ => (Subsingleton.elim y x) ▸ hxU
  subst hU
  haveI : IsIso (⊤ : X.Opens).ι := by rw [← Scheme.topIso_hom]; infer_instance
  have hj : inv (⊤ : X.Opens).ι ≫ (⊤ : X.Opens).ι = 𝟙 X := IsIso.inv_hom_id _
  refine ⟨(Scheme.Modules.pullbackId X).symm.app L ≪≫
    (Scheme.Modules.pullbackCongr hj).symm.app L ≪≫
    (Scheme.Modules.pullbackComp (inv (⊤ : X.Opens).ι) (⊤ : X.Opens).ι).symm.app L ≪≫
    (Scheme.Modules.pullback (inv (⊤ : X.Opens).ι)).mapIso
      ((Scheme.Modules.restrictFunctorIsoPullback (⊤ : X.Opens).ι).symm.app L ≪≫ e) ≪≫ ?_⟩
  exact @asIso _ _ _ _ _ (SheafOfModules.instIsIsoPullbackObjUnitToUnitOfFinal.{u}
    (inv (⊤ : X.Opens).ι).toRingCatSheafHom)

open Stacks.SheafOfModules in
private theorem nonempty_pullback_relativeDifferentialForms_iso
    {k κ : Type u} [Field k] [Field κ] {E U : Scheme.{u}} [Nonempty E]
    (p : E ⟶ Spec (.of κ)) [Smooth p] [SmoothOfRelativeDimension 1 p]
    (c : Spec (.of κ) ⟶ Spec (.of k))
    (hc : ∃ d, SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials c) d)
    (sU : U ⟶ Spec (.of k)) (n : ℕ) [SmoothOfRelativeDimension n sU]
    (ι : E ⟶ U) (hι : ∀ x, IsIso (ι.stalkMap x)) (hcomm : ι ≫ sU = p ≫ c) :
    Nonempty ((Scheme.Modules.pullback ι).obj (Scheme.Hom.relativeDifferentialForms sU n) ≅
      Scheme.Hom.relativeDifferentials p) := by
  obtain ⟨x₀⟩ := ‹Nonempty E›
  have hc' : ι ≫ sU = (p ≫ c) ≫ 𝟙 _ := by rw [hcomm, Category.comp_id]
  haveI h1 : IsIso (Scheme.Hom.relativeDifferentialsMap ι sU (p ≫ c) (𝟙 _) hc') :=
    isIso_relativeDifferentialsMap_of_isIso_stalkMap' ι sU (p ≫ c) hc' hι
  have h2 := Scheme.Hom.isIso_relativeDifferentialFormsMap ι sU (p ≫ c) (𝟙 _) hc' h1 n
  let e1 := asIso (Scheme.Hom.relativeDifferentialFormsMap ι sU (p ≫ c) (𝟙 _) hc' n)
  obtain ⟨hz, hS⟩ := Scheme.Hom.toRelativeDifferentials_shortExact p c
    (Stacks.Smooth.formallySmoothScheme_of_smooth p)
  haveI h3 : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials p) 1 :=
    Stacks.Discriminant.isFiniteLocallyFreeOfRank_relativeDifferentials p 1
  haveI : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials sU) n :=
    Stacks.Discriminant.isFiniteLocallyFreeOfRank_relativeDifferentials sU n
  haveI h2r : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials (p ≫ c)) n :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
      (@asIso _ _ _ _ _ h1)
      (Stacks.Chow.isFiniteLocallyFreeOfRank_pullback_obj ι _ n)
  obtain ⟨d, hd⟩ := hc
  haveI h1r : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback p).obj (Scheme.Hom.relativeDifferentials c)) d :=
    Stacks.Chow.isFiniteLocallyFreeOfRank_pullback_obj p _ d
  have hn : n = d + 1 := SheafOfModules.rank_add_of_shortExact _ hS d n 1 x₀
  subst hn
  have hdet := @Stacks.SheafOfModules.TopWedge.isIso_detComparison _ E.sheaf
    ((Scheme.Modules.pullback p).obj (Scheme.Hom.relativeDifferentials c))
    (Scheme.Hom.relativeDifferentials (p ≫ c)) (Scheme.Hom.relativeDifferentials p)
    (_root_.SheafOfModules.algebras _
      ((Scheme.Modules.pullback p).obj (Scheme.Hom.relativeDifferentials c)))
    (_root_.SheafOfModules.algebras _ (Scheme.Hom.relativeDifferentials (p ≫ c)))
    (_root_.SheafOfModules.algebras _ (Scheme.Hom.relativeDifferentials p)) _ _ hz hS.exact
    hS.mono_f hS.epi_g d 0 h1r h3
  haveI : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Hom.relativeDifferentials c).exteriorPower d) 1 := by
    simpa only [Nat.choose_self] using
      Scheme.Modules.isFiniteLocallyFreeOfRank_exteriorPower _ d d
  obtain ⟨eN⟩ := nonempty_iso_unit_of_subsingleton _ this
  let eT : ((Scheme.Modules.pullback p).obj (Scheme.Hom.relativeDifferentials c)).exteriorPower d
      ≅ SheafOfModules.unit E.ringCatSheaf :=
    (Scheme.Modules.exteriorPowerPullbackIso p _ d).symm ≪≫
      (Scheme.Modules.pullback p).mapIso eN ≪≫
      @asIso _ _ _ _ _ (SheafOfModules.instIsIsoPullbackObjUnitToUnitOfFinal.{u}
        p.toRingCatSheafHom)
  exact ⟨e1 ≪≫ eqToIso (by push_cast; rfl) ≪≫ (@asIso _ _ _ _ _ hdet).symm ≪≫
    whiskerRightIso eT _ ≪≫ λ_ _ ≪≫ eqToIso (by norm_num <;> rfl) ≪≫
    (_root_.SheafOfModules.algebras _
      (Scheme.Hom.relativeDifferentials p)).exteriorPowerOneIso⟩

end Canonical

/-! ### The degree of a divisor on a smooth proper curve -/

section CurveDegree

private theorem isIso_ι_of_eq_top {X : Scheme.{u}} {U : X.Opens} (hU : U = ⊤) : IsIso U.ι := by
  subst hU; rw [← Scheme.topIso_hom]; infer_instance

private theorem topologicalKrullDim_opens_eq_of_eq_top {X : Scheme.{u}} {U : X.Opens} (hU : U = ⊤) :
    topologicalKrullDim U.toScheme = topologicalKrullDim X := by
  have := isIso_ι_of_eq_top hU
  exact IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso (asIso U.ι)).isHomeomorph

private theorem isClosed_singleton_genericPoint_of_isCurve' {k : Type u} [Field k]
    {X : Scheme.{u}} (g : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsCurve k g]
    (Z : MMP.Mori.PrimeDivisor X) :
    IsClosed ({Z.genericPoint} : Set X) := by
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsCurve k g).toIsVariety.toIsIntegral
  refine Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint X
    (AlgebraicGeometry.IsCurve.topologicalKrullDim_eq_one (k := k) (f := g)) fun h => ?_
  have h1 := Z.coheight_genericPoint
  rw [h, show genericPoint X = (⊤ : X) from rfl, Order.coheight_top] at h1
  exact zero_ne_one h1

open MMP.Mori DivisorWithCoeffs in
/-- **Local equations of a prime divisor with an invertible ideal sheaf.** Near every point, the
ideal of `P` on an affine open `W` is generated by `f`, and the unit `φ` of `K(Y)` which is `f` on
the components meeting `W` and `1` elsewhere is a local equation of `P` on `W`. (Reproved from
`MMP.Threefold.Mori.isCartier_single_of_isSmoothScheme`, whose local equation is not exported.) -/
private theorem exists_localEquation_of_isEffectiveCartierDivisor' {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y)
    (hcart : Stacks.Divisors.IsEffectiveCartierDivisor P.idealSheaf) (x : Y) :
    ∃ (W : Y.affineOpens) (_ : x ∈ (W : Y.Opens)) (f : Γ(Y, (W : Y.Opens)))
      (φ : (RationalFunctions Y)ˣ),
      P.idealSheaf.ideal W = Ideal.span {f} ∧
      Divisor.IsLocalEquation (Finsupp.single P 1 : Divisor Y) W φ ∧
      ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ (W : Y.Opens)),
        (φ : RationalFunctions Y) Z = (Y.presheaf.germ W _ hZ).hom f := by
  classical
  haveI := P.integral
  have hsame : ∀ E : MMP.Mori.PrimeDivisor Y, E.genericPoint ∈ P.support → P = E := by
    intro E hE
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
    have hle : E.genericPoint ≤ P.genericPoint := specializes_iff_mem_closure.mpr hE
    by_contra hne
    have hlt : E.genericPoint < P.genericPoint := lt_of_le_not_ge hle fun h =>
      hne (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (Specializes.antisymm (show E.genericPoint ⤳ P.genericPoint from h)
          (show P.genericPoint ⤳ E.genericPoint from hle)).eq.symm)
    have h2 := Order.coheight_add_one_le hlt
    rw [MMP.Mori.PrimeDivisor.coheight_genericPoint,
      MMP.Mori.PrimeDivisor.coheight_genericPoint] at h2
    exact absurd h2 (by decide)

  obtain ⟨W, hW, hxW, f, hf, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor
      P.idealSheaf hcart x
  have hgerm : ∀ y (hy : y ∈ W), IdealSheafData.stalk P.idealSheaf y =
      Ideal.span {(Y.presheaf.germ W y hy).hom f} := by
    intro y hy
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ P.idealSheaf y ⟨W, hW⟩ hy, hspan,
      Ideal.map_span, Set.image_singleton]
  have hnzd : ∀ y (hy : y ∈ W), (Y.presheaf.germ W y hy).hom f ∈
      nonZeroDivisors (Y.presheaf.stalk y) := fun y hy =>
    Stacks.Divisors.germ_mem_nonZeroDivisors hW hf y hy
  have hfield : ∀ Z : irreducibleComponents Y,
      IsField (Y.presheaf.stalk (componentGenericPoint Y Z)) :=
    fun Z => RationalFunctions.isField_stalk Y Z
  let u : ∀ Z : irreducibleComponents Y, (Y.presheaf.stalk (componentGenericPoint Y Z))ˣ :=
    fun Z => if h : componentGenericPoint Y Z ∈ W then
      (by
        letI := (hfield Z).toField
        exact (isUnit_iff_ne_zero.2 (nonZeroDivisors.ne_zero (hnzd _ h))).unit)
      else 1
  let φ : (RationalFunctions Y)ˣ := (RationalFunctions.unitsEquiv Y).symm u
  have hφall : ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ W),
      (φ : RationalFunctions Y) Z = (Y.presheaf.germ W _ hZ).hom f := by
    intro Z hZ
    change ((u Z : (Y.presheaf.stalk (componentGenericPoint Y Z))ˣ) :
      Y.presheaf.stalk (componentGenericPoint Y Z)) = _
    simp only [u]
    rw [dif_pos hZ]
    rfl
  refine ⟨⟨W, hW⟩, hxW, f, φ, hspan, ?_, hφall⟩
  rintro E ⟨y, hyE, hyW⟩
  have hηW : E.genericPoint ∈ W := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyE
    exact (specializes_iff_mem_closure.mpr hyE).mem_open W.isOpen hyW
  have hZW : componentGenericPoint Y E.component ∈ W :=
    E.specializes_genericPoint.mem_open W.isOpen hηW
  have hφ : (φ : RationalFunctions Y) E.component =
      (Y.presheaf.germ W _ hZW).hom f := by
    change ((u E.component : (Y.presheaf.stalk (componentGenericPoint Y E.component))ˣ) :
      Y.presheaf.stalk (componentGenericPoint Y E.component)) = _
    simp only [u]
    rw [dif_pos hZW]
    rfl
  have key : E.toComponent.hom ((Y.presheaf.germ W _ hηW).hom f) =
      (φ : RationalFunctions Y) E.component := by
    rw [hφ]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  by_cases hEP : P = E
  · subst hEP
    rw [coeff_single_self]
    have hmem : P.genericPoint ∈ P.support := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
    have hg0 := nonZeroDivisors.ne_zero (hnzd _ hηW)
    have hprime : Prime ((Y.presheaf.germ W _ hηW).hom f) := by
      rw [← Ideal.span_singleton_prime hg0, ← hgerm _ hηW]
      have hxr : P.genericPoint ∈ Set.range P.idealSheaf.subschemeι := by
        rw [Scheme.IdealSheafData.range_subschemeι]; exact hmem
      obtain ⟨y', hy'⟩ := hxr
      rw [← hy']
      rw [← Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk]
      exact RingHom.ker_isPrime _
    exact (P.ord_eq_one_of_irreducible hprime.irreducible key).symm
  · rw [coeff_single_of_ne hEP]
    have hnm : E.genericPoint ∉ P.support := fun h => hEP (hsame E h)
    have htop := (AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_notMem_support
      P.idealSheaf _).2 hnm
    rw [hgerm _ hηW, Ideal.span_singleton_eq_top] at htop
    exact (E.ord_eq_zero_of_isUnit htop key).symm

open MMP.Mori DivisorWithCoeffs Stacks.AlgebraicGeometry.ReflexiveModules in
/-- On an open `V` carrying a rank-one dual basis of `𝒪_Y(P)` and a local equation `φ`, equal to
`f` there, the coordinate of the section `1` generates the same ideal as `f`. -/
private theorem span_evalAt_eq_span_of_isLocalEquation' {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y)
    (hD0 : 0 ≤ (Finsupp.single P 1 : Divisor Y)) (V : Y.Opens)
    (b : Stacks.SheafOfModules.DualBasisOne Y.sheaf.obj
      (structureSheafRing Y.toRingedSpace).property
      (Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y)) V)
    (f : Γ(Y, V)) (φ : (RationalFunctions Y)ˣ)
    (hloc : Divisor.IsLocalEquation (Finsupp.single P 1 : Divisor Y) V φ)
    (hφ : ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ V),
      (φ : RationalFunctions Y) Z = (Y.presheaf.germ V _ hZ).hom f) :
    Ideal.span ({(evalAt (Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y))
      (dualBasisCoord (Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y)) b)
      ((Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y)).presheaf.map
        (homOfLE le_top).op ((Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤))))} :
        Set Γ(Y, V)) =
      Ideal.span {f} := by
  set c := evalAt _ (dualBasisCoord _ b)
      ((Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y)).presheaf.map (homOfLE le_top).op
        ((Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤))) with hc
  have h1 := smul_dualBasisSection b
    ((Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y)).presheaf.map (homOfLE le_top).op
      ((Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤)))
  have inj : ∀ x y : Γ(Y, V),
      (∀ Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ V},
        (Y.presheaf.germ V _ Z.2).hom x = (Y.presheaf.germ V _ Z.2).hom y) → x = y :=
    fun x y h => toRationalFunctionsPresheaf_app_injective V (funext h)
  have E1 : ∀ Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ V},
      (Y.presheaf.germ V _ Z.2).hom c * (dualBasisSection _ b).1 Z = 1 := by
    intro Z
    exact congrArg
      (fun m : Γ(Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y), V) => m.1 Z) h1
  -- the section `φ⁻¹` of `𝒪_Y(P)` over `V`
  have hgsec : (Divisor.IsDivisorialSection (Finsupp.single P 1 : Divisor Y) V
      (fun Z => ((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) Z.1)) := by
    intro E hE
    have h0 : E.OrdGE (E.ord φ⁻¹) (((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y)
        E.component) := Or.inr (E.valuation_component φ⁻¹).ge
    refine h0.mono (le_of_eq ?_)
    rw [PrimeDivisor.ord_inv, ← hloc E hE]
  let g : Γ(Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y), V) :=
    ⟨fun Z => ((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) Z.1, hgsec⟩
  have h2 := smul_dualBasisSection b g
  have E2 : ∀ Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ V},
      ((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) Z.1 =
        (Y.presheaf.germ V _ Z.2).hom (evalAt _ (dualBasisCoord _ b) g) *
          (dualBasisSection _ b).1 Z := by
    intro Z
    exact (congrArg
      (fun m : Γ(Divisor.divisorialSheaf (Finsupp.single P 1 : Divisor Y), V) => m.1 Z) h2).symm
  have E3 : ∀ Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ V},
      ((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) Z.1 *
        (φ : RationalFunctions Y) Z.1 = 1 := by
    intro Z
    rw [← Pi.mul_apply, ← Units.val_mul, inv_mul_cancel, Units.val_one, Pi.one_apply]
  -- the section `φ · e` of `𝒪_Y(0)` over `V`
  have hhsec : (Divisor.IsDivisorialSection (0 : Divisor Y) V
      (fun Z => (φ : RationalFunctions Y) Z.1 * (dualBasisSection _ b).1 Z)) := by
    intro E hE
    have hψ : E.OrdGE (E.ord φ) ((φ : RationalFunctions Y) E.component) :=
      Or.inr (E.valuation_component φ).ge
    refine (hψ.mul ((dualBasisSection _ b).2 E hE)).mono (le_of_eq ?_)
    rw [← hloc E hE]
    simp
  obtain ⟨s', hs'⟩ := Divisor.IsDivisorialSection.exists_eq hhsec
  apply le_antisymm
  · -- `c ∈ (f)`
    rw [Ideal.span_singleton_le_span_singleton]
    refine ⟨evalAt _ (dualBasisCoord _ b) g, inj _ _ fun Z => ?_⟩
    rw [map_mul, ← hφ Z.1 Z.2]
    have e1 := E1 Z
    have e2 := E2 Z
    have e3 := E3 Z
    linear_combination (-(Y.presheaf.germ V _ Z.2).hom c) * e3 +
      ((Y.presheaf.germ V _ Z.2).hom c * (φ : RationalFunctions Y) Z.1) * e2 +
      ((φ : RationalFunctions Y) Z.1 *
        (Y.presheaf.germ V _ Z.2).hom (evalAt _ (dualBasisCoord _ b) g)) * e1
  · rw [Ideal.span_singleton_le_span_singleton]
    refine ⟨s', inj _ _ fun Z => ?_⟩
    have hs'Z : (Y.presheaf.germ V _ Z.2).hom s' =
        (φ : RationalFunctions Y) Z.1 * (dualBasisSection _ b).1 Z := congrFun hs' Z
    rw [map_mul, hs'Z, ← hφ Z.1 Z.2]
    have e1 := E1 Z
    linear_combination (-(φ : RationalFunctions Y) Z.1) * e1

open MMP.Mori DivisorWithCoeffs in
/-- **The degree of a closed point of a smooth proper curve**: for a prime divisor `P` of a smooth
proper curve `C` over a field `κ`, `deg 𝒪_C(P) = [κ(P) : κ]`. The zero scheme of the section `1`
of `𝒪_C(P)` is the reduced point `P`, whose ring of functions is `κ(P)`. -/
private theorem invertibleCurveDegree_divisorialSheaf_single_eq_finrank {k : Type u} [Field k]
    {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) [AlgebraicGeometry.IsCurve k sY]
    [IsProper sY] [IsLocallyNoetherian Y] [IsNormal Y] (C : MMP.Mori.PrimeDivisor Y)
    (hD : MMP.Mori.Divisor.IsCartier (Finsupp.single C 1 : MMP.Mori.Divisor Y))
    (hdim : topologicalKrullDim Y ≤ 1)
    [hL : AlgebraicGeometry.SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2
      (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y))] :
    letI : Algebra k (Y.residueField C.genericPoint) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫ Y.Γevaluation C.genericPoint).hom.toAlgebra
    invertibleCurveDegree k sY hdim
      (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y)) =
      Module.finrank k (Y.residueField C.genericPoint) := by
  classical
  have : IsIntegral Y := (inferInstance : AlgebraicGeometry.IsCurve k sY).toIsVariety.toIsIntegral
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  have hD0 : 0 ≤ (Finsupp.single C 1 : MMP.Mori.Divisor Y) :=
    Finsupp.single_nonneg.2 zero_le_one
  have hx : IsClosed ({C.genericPoint} : Set Y) :=
    isClosed_singleton_genericPoint_of_isCurve' sY C
  have hsupp : C.idealSheaf.support = TopologicalSpace.Closeds.closure ({C.genericPoint} : Set Y) :=
    SetLike.coe_injective (C.support_eq_closure)
  have : IsReduced C.idealSheaf.subscheme := by
    haveI := C.integral; infer_instance
  have hcl : (⟨{C.genericPoint}, hx⟩ : TopologicalSpace.Closeds Y) =
      TopologicalSpace.Closeds.closure ({C.genericPoint} : Set Y) :=
    TopologicalSpace.Closeds.ext hx.closure_eq.symm
  have hPI : C.idealSheaf = Scheme.IdealSheafData.vanishingIdeal
      (⟨{C.genericPoint}, hx⟩ : TopologicalSpace.Closeds Y) := by
    rw [hcl]
    exact Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ hsupp
  have : IsDiscreteValuationRing (Y.presheaf.stalk C.genericPoint) :=
    C.isDiscreteValuationRing_localRing
  have hcart : Stacks.Divisors.IsEffectiveCartierDivisor C.idealSheaf := by
    rw [hPI]; exact isEffectiveCartierDivisor_vanishingIdeal_of_isDiscreteValuationRing hx
  have hinv := hD.isInvertibleModule_divisorialSheaf
  have hinv' : AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj
      Y.ringCatSheaf.property
      (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y)) := hinv
  have hZ : AlgebraicGeometry.zeroScheme Y
      (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y))
      ((MMP.Mori.Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤)) =
      C.idealSheaf := by
    have hloc : ∀ x : Y, ∃ V : Y.affineOpens, x ∈ (V : Y.Opens) ∧
        (AlgebraicGeometry.zeroScheme Y
          (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y))
          ((MMP.Mori.Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤))).ideal V =
          C.idealSheaf.ideal V := by
      intro x
      obtain ⟨W, hxW, f, φ, hspan, hlocW, hφ⟩ :=
        exists_localEquation_of_isEffectiveCartierDivisor' C hcart x
      obtain ⟨V, hxV, hVW, ⟨b⟩⟩ := AlgebraicGeometry.exists_affineOpen_dualBasisOne_of_isInvertible
        (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y)) x hxW
      refine ⟨V, hxV, ?_⟩
      rw [AlgebraicGeometry.zeroScheme_ideal_eq_span_evalAt
        (MMP.Mori.Divisor.divisorialSheaf (Finsupp.single C 1 : MMP.Mori.Divisor Y))
        ((MMP.Mori.Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤)) V b,
        ← C.idealSheaf.map_ideal hVW, hspan, Ideal.map_span, Set.image_singleton]
      exact span_evalAt_eq_span_of_isLocalEquation' C hD0 (V : Y.Opens) b
        (Y.presheaf.map (homOfLE hVW).op f) φ (hlocW.mono hVW) fun Z hZ => by
          rw [hφ Z (hVW hZ)]
          exact (TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hVW) _ hZ f).symm
    choose U hxU hU using hloc
    exact Scheme.IdealSheafData.ext_of_iSup_eq_top U
      (eq_top_iff.2 fun x _ => TopologicalSpace.Opens.mem_iSup.2 ⟨x, hxU x⟩) hU
  have hs : (MMP.Mori.Divisor.divisorialSheafOneSection hD0).eval (Opposite.op ⊤) ≠ 0 := by
    intro h
    obtain ⟨y⟩ := (inferInstance : Nonempty Y)
    let Z : irreducibleComponents Y :=
      ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
    have h1 := congrArg (fun m : Γ(MMP.Mori.Divisor.divisorialSheaf
      (Finsupp.single C 1 : MMP.Mori.Divisor Y), ⊤) =>
        m.1 (⟨Z, trivial⟩ :
          {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ (⊤ : Y.Opens)})) h
    change (1 : Y.presheaf.stalk (componentGenericPoint Y Z)) = 0 at h1
    exact one_ne_zero h1
  rw [invertibleCurveDegree_eq_finrank_globalSections_zeroScheme_of_dim_le_one k sY hdim _
    (MMP.Mori.Divisor.divisorialSheafOneSection hD0) hs _ (hZ.trans hPI)]
  exact_mod_cast finrank_globalSections_vanishingIdeal_singleton sY hx

open MMP.Mori DivisorWithCoeffs in
/-- On a smooth proper curve `C` over a field `κ`, the degree of `𝒪_C(D)` is
`∑ dᵢ [κ(Pᵢ) : κ]` for `D = ∑ dᵢ Pᵢ`. -/
private theorem invertibleCurveDegree_divisorialSheaf_eq_sum {k : Type u} [Field k]
    {C : Scheme.{u}} (sC : C ⟶ Spec (.of k)) [AlgebraicGeometry.IsCurve k sC] [Smooth sC]
    [IsProper sC] [IsLocallyNoetherian C] [IsNormal C] (D : Divisor C)
    (hdim : topologicalKrullDim C ≤ 1)
    [SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 D.divisorialSheaf] :
    invertibleCurveDegree k sC hdim D.divisorialSheaf = D.sum fun P a => a *
      letI : Algebra k (C.residueField P.genericPoint) :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ sC.appTop ≫ C.Γevaluation P.genericPoint).hom.toAlgebra
      (Module.finrank k (C.residueField P.genericPoint) : ℤ) := by
  classical
  have : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace sC
  have hsm : IsSmoothScheme sC := (isSmoothScheme_iff sC).mpr inferInstance
  have : QuasiCompact sC := inferInstance
  have := isIso_ι_of_eq_top hsm
  have hdim' : topologicalKrullDim (smoothLocus sC).toScheme ≤ 1 := by
    rw [topologicalKrullDim_opens_eq_of_eq_top hsm]; exact hdim
  have : IsProper ((smoothLocus sC).ι ≫ sC) := inferInstance
  let F : Divisor C →+ ℤ :=
    { toFun := fun E => E.degreeOn k sC (smoothLocus sC).ι hdim'
        (MMP.Fourfold.isCartier_of_isSmoothScheme hsm E)
      map_zero' := Divisor.degreeOn_zero' k sC (smoothLocus sC).ι hdim'
      map_add' := fun E E' => Divisor.degreeOn_add k sC (smoothLocus sC).ι hdim' E E' _ _ }
  have hF : ∀ (E : Divisor C)
      [SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 E.divisorialSheaf],
      F E = invertibleCurveDegree k sC hdim E.divisorialSheaf := by
    intro E _
    change invertibleCurveDegree k ((smoothLocus sC).ι ≫ sC) hdim'
      ((Scheme.Modules.pullback (smoothLocus sC).ι).obj E.divisorialSheaf) = _
    exact invertibleCurveDegree_pullback_of_isIso (smoothLocus sC).ι sC hdim' hdim _
  rw [← hF]
  conv_lhs => rw [← Finsupp.sum_single D]
  rw [map_finsuppSum]
  refine Finsupp.sum_congr fun P _ => ?_
  have hc := MMP.Fourfold.isCartier_of_isSmoothScheme hsm (Finsupp.single P 1 : Divisor C)
  have := hc.isInvertibleModule_divisorialSheaf
  rw [← Finsupp.smul_single_one, map_zsmul, smul_eq_mul, hF,
    invertibleCurveDegree_divisorialSheaf_single_eq_finrank sC P hc hdim]

end CurveDegree

/-! ### Coefficients of a pulled-back divisor -/

section Coeff

open Opposite MMP.Positivity

variable {Y' Y : Scheme.{u}} [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

private theorem ordUnit_eq_ord (E : MMP.Mori.PrimeDivisor Y')
    (u : (Y'.presheaf.stalk (componentGenericPoint Y' E.component))ˣ) :
    E.ordUnit u = Y'.ord ((componentToFunctionField E.component).hom u)
      E.genericPoint := by
  have hsub : Subsingleton (irreducibleComponents Y') := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  let ψ : (RationalFunctions Y')ˣ := (RationalFunctions.unitsEquiv Y').symm
    fun Z => (Subsingleton.elim E.component Z) ▸ u
  have h1 : Units.map (RationalFunctions.component Y' E.component).toMonoidHom ψ = u := by
    have h := congrFun ((RationalFunctions.unitsEquiv Y').apply_symm_apply
      (fun Z => (Subsingleton.elim E.component Z) ▸ u)) E.component
    exact h
  rw [← h1, ← PrimeDivisor.ord_eq_ordUnit, ord_eq_ord_componentToFunctionField]
  rfl

private theorem key_stalk (g : Y' ⟶ Y) [IsDominant g] (Z : irreducibleComponents Y')
    (W : irreducibleComponents Y)
    (hW : g (componentGenericPoint Y' Z) ∈ W.1)
    (a : Y.presheaf.stalk (g (componentGenericPoint Y' Z))) :
    (componentToFunctionField Z).hom ((g.stalkMap (componentGenericPoint Y' Z)).hom a) =
      functionFieldMap g ((componentToFunctionField W).hom
        ((stalkToRationalFunctions Y hW).hom a)) := by
  unfold functionFieldMap
  rw [CommRingCat.hom_comp, RingHom.comp_apply]
  rw [show (componentToFunctionField Z) = Y'.presheaf.stalkSpecializes _ from rfl,
    ← Scheme.Hom.stalkSpecializes_stalkMap_apply]
  congr 1
  simp only [TopCat.Presheaf.stalkCongr_hom, stalkToRationalFunctions]
  change _ = (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom
    ((Y.presheaf.stalkSpecializes _).hom a))
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply]
  erw [TopCat.Presheaf.stalkSpecializes_comp_apply]

private theorem coeff_eq_of_isPullback {g : Y' ⟶ Y} [IsDominant g] {B : Divisor Y}
    (hBc : B.IsCartier)
    {hB : ∀ Z : irreducibleComponents Y', g (componentGenericPoint Y' Z) ∉ B.supp}
    {B' : Divisor Y'} (h : B.IsPullback g hB B') (E : MMP.Mori.PrimeDivisor Y')
    (P : MMP.Mori.PrimeDivisor Y) (heq : g E.genericPoint = P.genericPoint)
    [IsIso (g.stalkMap E.genericPoint)] : B'.coeff E = B.coeff P := by
  obtain ⟨U, hyU, φ, hφ⟩ := hBc P.genericPoint
  have hPU : (P.support ∩ (U : Set Y)).Nonempty :=
    ⟨P.genericPoint, PrimeDivisor.genericPoint_mem_support' P, hyU⟩
  have hE : (E.support ∩ ((g ⁻¹ᵁ U : Y'.Opens) : Set Y')).Nonempty :=
    ⟨E.genericPoint, PrimeDivisor.genericPoint_mem_support' E, by
      change g E.genericPoint ∈ U
      rw [heq]; exact hyU⟩
  rw [h U φ hφ E hE, hφ P hPU]
  have hZ := E.map_componentGenericPoint_mem g hE
  have hW := mem_pointComponent (g (componentGenericPoint Y' E.component))
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hZ (hB _) hW
  rw [pullbackComponent_eq hB hφ hZ hW a ha, ordUnit_eq_ord,
    ord_eq_ord_componentToFunctionField]
  have hsub : Subsingleton (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hPW : P.component = pointComponent (g (componentGenericPoint Y' E.component)) :=
    Subsingleton.elim _ _
  rw [hPW, ← ha]
  change Scheme.ord ((componentToFunctionField E.component).hom
    ((g.stalkMap (componentGenericPoint Y' E.component)).hom ↑a)) E.genericPoint = _
  rw [key_stalk g E.component _ hW]
  exact ord_functionFieldMap_of_isIso g E P heq _

end Coeff

/-! ### The divisorial sheaf on an open subscheme -/

section OpenRestriction

open Opposite TopologicalSpace MMP.Fourfold

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- A nonempty open subscheme of an integral scheme has the same function field. -/
private theorem functionFieldMap_opens_ι_bijective {Y : Scheme.{u}} [IsIntegral Y] (V : Y.Opens)
    [Nonempty V] [IsDominant V.ι] : Function.Bijective (functionFieldMap V.ι) :=
  functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤ ⟨Classical.arbitrary V, trivial⟩

/-- A nonempty open subscheme of a normal variety is a normal variety. -/
private theorem isNormalVariety_ι {Y : Scheme.{u}} {s : Y ⟶ Spec (.of k)}
    (h : IsNormalVariety k s) (V : Y.Opens) [Nonempty V] : IsNormalVariety k (V.ι ≫ s) := by
  have := h.1
  have := h.2
  have : IsIntegral Y := h.1.toIsIntegral
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian s
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace s
  have : IsNoetherian Y := {}
  exact ⟨⟨⟩, inferInstance⟩

/-- The divisorial valuation of a prime divisor `E'` of an open subscheme `V ⊆ Y` is that of its
closure `E` in `Y`, through the identification `k(Y) ≅ k(V)`. -/
private theorem divisorialValuation_primeDivisorMap {Y V : Scheme.{u}} [IsIntegral Y]
    [IsIntegral V] [IsLocallyNoetherian Y] [IsLocallyNoetherian V] [IsNormal Y] [IsNormal V]
    (j : V ⟶ Y) [IsOpenImmersion j] [IsDominant j] (E' : MMP.Mori.PrimeDivisor V) :
    MMP.Mori.PrimeDivisor.divisorialValuation (OpenWeilRestriction.primeDivisorMap j E') =
      E'.divisorialValuation.comap (functionFieldMap j) := by
  ext g
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  have hg' : functionFieldMap j g ≠ 0 := (map_ne_zero _).2 hg
  rw [Valuation.comap_apply, MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg',
    MMP.Positivity.ord_functionFieldMap_of_isIso j E' _
      (OpenWeilRestriction.genericPoint_primeDivisorMap j E').symm]

/-- A nonempty open subscheme of a variety has the dimension of the variety: both are the
transcendence degree of the common function field. -/
private theorem topologicalKrullDim_opens_eq (hX : IsNormalVariety k sX) (U : X.Opens)
    [Nonempty U] [IsDominant U.ι] : topologicalKrullDim U = topologicalKrullDim X := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have hbij := functionFieldMap_opens_ι_bijective U
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (U.ι ≫ sX)
  rw [← toENat_trdeg_functionField (sX := U.ι ≫ sX),
    ← trdeg_functionField_eq_of_bijective sX U.ι hbij, toENat_trdeg_functionField (sX := sX)]

/-! ### The divisorial sheaf on an open subscheme -/

section DivisorialRestrict

/-- On an irreducible scheme every irreducible component is the whole space. -/
private theorem eq_univ_of_irreducibleComponents {Y : Scheme.{u}} [IrreducibleSpace Y]
    (Z : irreducibleComponents Y) : Z.1 = Set.univ :=
  Set.eq_univ_of_univ_subset
    (Z.2.2 (IrreducibleSpace.isIrreducible_univ Y) (Set.subset_univ _))

private theorem index_eq {Y : Scheme.{u}} [IrreducibleSpace Y] {W : Y.Opens}
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Z = Z' :=
  Subtype.ext (Subtype.ext ((eq_univ_of_irreducibleComponents _).trans
    (eq_univ_of_irreducibleComponents _).symm))

private theorem stalkSpecializes_stalkSpecializes_apply {Y : Scheme.{u}} {x y z : Y}
    (h : x ⤳ y) (h' : y ⤳ z) (h'' : x ⤳ z) (s : Y.presheaf.stalk z) :
    (Y.presheaf.stalkSpecializes h).hom ((Y.presheaf.stalkSpecializes h').hom s) =
      (Y.presheaf.stalkSpecializes h'').hom s :=
  TopCat.Presheaf.stalkSpecializes_comp_apply _ h h' s

private theorem stalkSpecializes_self_apply {Y : Scheme.{u}} {x : Y} (h : x ⤳ x)
    (s : Y.presheaf.stalk x) : (Y.presheaf.stalkSpecializes h).hom s = s := by
  rw [TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- The value in the function field of a section of `𝒦_Y` over an open set, read at the generic
point of an irreducible component meeting it. -/
private noncomputable def evFF {Y : Scheme.{u}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Y.functionField :=
  (Y.presheaf.stalkSpecializes (genericPoint_specializes Z.1)).hom (φ Z)

private theorem evFF_eq {Y : Scheme.{u}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF φ Z = evFF φ Z' := by
  obtain rfl := index_eq Z Z'
  rfl

private theorem stalkSpecializes_injective {Y : Scheme.{u}} [IsIntegral Y]
    (Z : irreducibleComponents Y) :
    Function.Injective (Y.presheaf.stalkSpecializes (genericPoint_specializes Z)).hom := by
  intro a b h
  have := congrArg (Y.presheaf.stalkSpecializes (specializes_genericPoint Z)).hom h
  rwa [stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl,
    stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply,
    stalkSpecializes_self_apply] at this

private theorem ordGE_iff {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (E : MMP.Mori.PrimeDivisor Y) (n : ℤ)
    (s : Y.presheaf.stalk (componentGenericPoint Y E.component)) :
    E.OrdGE n s ↔
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes E.component)).hom s = 0 ∨
        WithZero.exp n ≤ (E.divisorialValuation
          ((Y.presheaf.stalkSpecializes (genericPoint_specializes E.component)).hom s))⁻¹) := by
  rw [MMP.Mori.PrimeDivisor.OrdGE, valuation_eq_inv_divisorialValuation,
    (injective_iff_map_eq_zero' _).1 (stalkSpecializes_injective E.component)]

private theorem ordGE_iff_evFF {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y) (n : ℤ) {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (h : componentGenericPoint Y E.component ∈ W) :
    E.OrdGE n (φ ⟨E.component, h⟩) ↔
      (evFF φ ⟨E.component, h⟩ = 0 ∨
        WithZero.exp n ≤ (E.divisorialValuation (evFF φ ⟨E.component, h⟩))⁻¹) :=
  ordGE_iff E n _

variable (U : X.Opens) [Nonempty U] [IsDominant U.ι]

private theorem genericPoint_mem_of_index {V : U.toScheme.Opens}
    (Z : {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V}) :
    genericPoint U.toScheme ∈ V := by
  have := Z.2
  rwa [componentGenericPoint_eq_genericPoint] at this

private theorem genericPoint_mem_of_indexX {V : U.toScheme.Opens}
    (Z : {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V}) :
    genericPoint U.toScheme ∈ V := by
  have h := Z.2
  rw [componentGenericPoint_eq_genericPoint] at h
  obtain ⟨x, hx, hxe⟩ := h
  have hsp : genericPoint U.toScheme ⤳ x := (genericPoint_spec U.toScheme).specializes trivial
  exact hsp.mem_open V.isOpen hx

/-- The irreducible component `X` of the integral scheme `X`. -/
private def topComponent (Y : Scheme.{u}) [IrreducibleSpace Y] : irreducibleComponents Y :=
  ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩

private def indexX {V : U.toScheme.Opens} (h : genericPoint U.toScheme ∈ V) :
    {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V} :=
  ⟨topComponent X, by
    rw [componentGenericPoint_eq_genericPoint, ← map_genericPoint_of_isDominant U.ι]
    exact ⟨_, h, rfl⟩⟩

private def indexU {V : U.toScheme.Opens} (h : genericPoint U.toScheme ∈ V) :
    {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V} :=
  ⟨topComponent U.toScheme, by rw [componentGenericPoint_eq_genericPoint]; exact h⟩

/-- The restriction `𝒦_X(U ∩ -) → 𝒦_U` of rational functions to an open subscheme, through the
identification `k(X) ≅ k(U)`. -/
private noncomputable def restrictRF (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    ToType ((rationalFunctionsPresheaf U.toScheme).obj (op V)) :=
  fun Z => (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (functionFieldMap U.ι (evFF ψ (indexX U (genericPoint_mem_of_index U Z))))

private theorem evFF_restrictRF (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V))))
    (Z : {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V})
    (Z' : {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V}) :
    evFF (restrictRF U V ψ) Z = functionFieldMap U.ι (evFF ψ Z') := by
  rw [evFF, restrictRF, stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl,
    stalkSpecializes_self_apply, evFF_eq ψ _ Z']

private theorem restrictRF_injective (V : U.toScheme.Opens) :
    Function.Injective (restrictRF U V) := by
  intro ψ₁ ψ₂ h
  funext Z'
  have hV := genericPoint_mem_of_indexX U Z'
  have h1 := congrArg (fun φ => evFF φ (indexU U hV)) h
  simp only [evFF_restrictRF U V _ _ Z'] at h1
  exact stalkSpecializes_injective Z'.1 ((functionFieldMap U.ι).injective h1)

private theorem restrictRF_surjective (V : U.toScheme.Opens) :
    Function.Surjective (restrictRF U V) := by
  intro φ
  let e := RingEquiv.ofBijective (functionFieldMap U.ι) (functionFieldMap_opens_ι_bijective U)
  refine ⟨fun Z' => (X.presheaf.stalkSpecializes (specializes_genericPoint Z'.1)).hom
    (e.symm (evFF φ (indexU U (genericPoint_mem_of_indexX U Z')))), ?_⟩
  funext Z
  change (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (functionFieldMap U.ι ((X.presheaf.stalkSpecializes (genericPoint_specializes _)).hom
      ((X.presheaf.stalkSpecializes (specializes_genericPoint _)).hom (e.symm _)))) = _
  rw [stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply]
  change (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (e (e.symm _)) = _
  rw [RingEquiv.apply_symm_apply, evFF_eq φ _ Z, evFF,
    stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply]

/-- A section of `𝒦_X` over `U ∩ -` is a section of `𝒪_X(D)` exactly when its restriction is a
section of `𝒪_U(D|_U)`: the prime divisors of `U` meeting `V` are the restrictions of those of
`X` meeting `V`, with the same valuations and coefficients. -/
private theorem isDivisorialSection_restrictRF_iff (D : Divisor X) (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    Divisor.IsDivisorialSection (D.restrictOpen U) V (restrictRF U V ψ) ↔
      D.IsDivisorialSection (U.ι ''ᵁ V) ψ := by
  have key : ∀ (E' : MMP.Mori.PrimeDivisor U.toScheme) (hE' : (E'.support ∩ V).Nonempty)
      (hP : ((OpenWeilRestriction.primeDivisorMap U.ι E').support ∩ U.ι ''ᵁ V).Nonempty),
      E'.OrdGE (-(D.restrictOpen U).coeff E')
          (restrictRF U V ψ ⟨E'.component, E'.componentGenericPoint_mem_of_nonempty hE'⟩) ↔
        MMP.Mori.PrimeDivisor.OrdGE (OpenWeilRestriction.primeDivisorMap U.ι E')
          (-D.coeff (OpenWeilRestriction.primeDivisorMap U.ι E'))
          (ψ ⟨_, MMP.Mori.PrimeDivisor.componentGenericPoint_mem_of_nonempty
            (OpenWeilRestriction.primeDivisorMap U.ι E') hP⟩) := by
    intro E' hE' hP
    rw [ordGE_iff_evFF, ordGE_iff_evFF]
    rw [evFF_restrictRF U V ψ _ ⟨_, MMP.Mori.PrimeDivisor.componentGenericPoint_mem_of_nonempty
        (OpenWeilRestriction.primeDivisorMap U.ι E') hP⟩,
      divisorialValuation_primeDivisorMap, map_eq_zero_iff _ (functionFieldMap U.ι).injective,
      DivisorWithCoeffs.coeff_restrictOpen]
    rfl
  have hmem : ∀ E' : MMP.Mori.PrimeDivisor U.toScheme, (E'.support ∩ V).Nonempty ↔
      ((OpenWeilRestriction.primeDivisorMap U.ι E').support ∩ U.ι ''ᵁ V).Nonempty := by
    intro E'
    rw [← MMP.Mori.PrimeDivisor.genericPoint_mem_iff, ← MMP.Mori.PrimeDivisor.genericPoint_mem_iff,
      show MMP.Mori.PrimeDivisor.genericPoint (OpenWeilRestriction.primeDivisorMap U.ι E') =
        U.ι E'.genericPoint from OpenWeilRestriction.genericPoint_primeDivisorMap _ _]
    constructor
    · intro h
      exact ⟨_, h, rfl⟩
    · rintro ⟨x, hx, hxe⟩
      rwa [U.ι.isOpenEmbedding.injective hxe] at hx
  constructor
  · intro h P hP
    have hPU : P.genericPoint ∈ Set.range U.ι.base := by
      rw [Scheme.Opens.range_ι]
      obtain ⟨x, -, hx⟩ := (MMP.Mori.PrimeDivisor.genericPoint_mem_iff P _).2 hP
      rw [← hx]
      exact x.2
    obtain ⟨E', rfl⟩ := (OpenWeilRestriction.mem_range_primeDivisorMap_iff _ P).2 hPU
    exact (key E' ((hmem E').2 hP) hP).1 (h E' ((hmem E').2 hP))
  · intro h E' hE'
    exact (key E' hE' ((hmem E').1 hE')).2 (h _ ((hmem E').1 hE'))

private theorem functionFieldMap_germ_appIso_inv (V : U.toScheme.Opens) (r : Γ(U.toScheme, V))
    (h₁ : genericPoint X ∈ U.ι ''ᵁ V) (h₂ : genericPoint U.toScheme ∈ V) :
    functionFieldMap U.ι (X.presheaf.germ (U.ι ''ᵁ V) (genericPoint X) h₁
      ((U.ι.appIso V).inv r)) = U.toScheme.presheaf.germ V (genericPoint U.toScheme) h₂ r := by
  have h₃ : U.ι (genericPoint U.toScheme) ∈ U.ι ''ᵁ V := ⟨_, h₂, rfl⟩
  rw [functionFieldMap, CommRingCat.comp_apply, TopCat.Presheaf.stalkCongr_hom]
  erw [TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf h₁ _]
  erw [Scheme.Hom.germ_stalkMap_apply, ← CommRingCat.comp_apply (U.ι.appIso V).inv,
    Scheme.Hom.appIso_inv_app, TopCat.Presheaf.germ_res_apply]

private theorem restrictRF_smul (V : U.toScheme.Opens) (r : Γ(U.toScheme, V))
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    restrictRF U V ((U.ι.appIso V).inv r • ψ) = r • restrictRF U V ψ := by
  funext Z
  rw [rationalFunctions_smul_apply]
  simp only [restrictRF, evFF, rationalFunctions_smul_apply, map_mul]
  congr 1
  rw [TopCat.Presheaf.germ_stalkSpecializes_apply, functionFieldMap_germ_appIso_inv U V r _
    (genericPoint_mem_of_index U Z), TopCat.Presheaf.germ_stalkSpecializes_apply]

private theorem restrictRF_zero (V : U.toScheme.Opens) : restrictRF U V 0 = 0 := by
  funext Z
  simp only [restrictRF, evFF]
  erw [Pi.zero_apply, map_zero, map_zero, map_zero]
  rfl

private theorem restrictRF_add (V : U.toScheme.Opens)
    (ψ₁ ψ₂ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    restrictRF U V (ψ₁ + ψ₂) = restrictRF U V ψ₁ + restrictRF U V ψ₂ := by
  funext Z
  simp only [restrictRF, evFF]
  erw [Pi.add_apply, map_add, map_add, map_add]
  rfl

/-- The restriction `𝒪_X(D)|_U ⟶ 𝒪_U(D|_U)` of divisorial sections to an open subscheme. -/
private noncomputable def divisorialSheafRestrictHom (D : Divisor X) :
    D.divisorialSheaf.restrict U.ι ⟶ Divisor.divisorialSheaf (D.restrictOpen U) :=
  ⟨PresheafOfModules.homMk
    { app V := AddCommGrpCat.ofHom
        { toFun ψ := (⟨restrictRF U V.unop (ψ : D.divisorialSubmodule (U.ι ''ᵁ V.unop)).1,
            (isDivisorialSection_restrictRF_iff U D V.unop _).2
              (ψ : D.divisorialSubmodule (U.ι ''ᵁ V.unop)).2⟩ :
              Divisor.divisorialSubmodule (D.restrictOpen U) V.unop)
          map_zero' := Subtype.ext (restrictRF_zero U V.unop)
          map_add' ψ₁ ψ₂ := Subtype.ext (restrictRF_add U V.unop _ _) }
      naturality V V' i := by ext ψ; rfl }
    fun V r ψ => Subtype.ext (restrictRF_smul U V.unop r _)⟩

private theorem isIso_divisorialSheafRestrictHom (D : Divisor X) :
    IsIso (divisorialSheafRestrictHom U D) := by
  rw [Scheme.Modules.Hom.isIso_iff_isIso_app]
  intro V
  rw [ConcreteCategory.isIso_iff_bijective]
  refine ⟨fun (ψ₁ ψ₂ : D.divisorialSubmodule (U.ι ''ᵁ V)) h => ?_, fun φ => ?_⟩
  · have h' : restrictRF U V ψ₁.1 = restrictRF U V ψ₂.1 := congrArg Subtype.val h
    exact Subtype.ext (restrictRF_injective U V h')
  · obtain ⟨ψ, hψ⟩ :=
      restrictRF_surjective U V (φ : Divisor.divisorialSubmodule (D.restrictOpen U) V).1
    refine ⟨(⟨ψ, (isDivisorialSection_restrictRF_iff U D V ψ).1
      (hψ ▸ (φ : Divisor.divisorialSubmodule (D.restrictOpen U) V).2)⟩ :
        D.divisorialSubmodule (U.ι ''ᵁ V)), Subtype.ext hψ⟩

end DivisorialRestrict

/-- The divisorial sheaf of the restriction `D|_U` of a divisor to an open subscheme is the
restriction `𝒪_X(D)|_U` of its divisorial sheaf. -/
private theorem nonempty_divisorialSheaf_restrictOpen_iso (D : Divisor X) (U : X.Opens)
    [Nonempty U] [IsDominant U.ι] :
    Nonempty (Divisor.divisorialSheaf (D.restrictOpen U) ≅ D.divisorialSheaf.restrict U.ι) :=
  ⟨(@asIso _ _ _ _ _ (isIso_divisorialSheafRestrictHom U D)).symm⟩

end OpenRestriction

section

variable {k : Type u} [Field k] [CharZero k] {V W : Scheme.{u}} {sV : V ⟶ Spec (.of k)}
    {sW : W ⟶ Spec (.of k)} [IsLocallyNoetherian V] [IsNormal V] {n : ℕ} {K : Divisor V}
    {Δ : QDivisor V} {g : V ⟶ W} (h : IsLogEllipticFiberSpace k sV sW n K Δ g)
    {M : Divisor V} (hMc : M.IsCartier)

include h

/-- The generic fibre of a log elliptic fiber space is a curve over `k(W)`. -/
private theorem isCurve_fiberToSpecResidueField :
    haveI := h.isContraction.isVariety_target.toIsIntegral
    AlgebraicGeometry.IsCurve (W.residueField (genericPoint W))
      (g.fiberToSpecResidueField (genericPoint W)) := by
  haveI := h.isContraction.isVariety_target.toIsIntegral
  haveI := h.isContraction.isVariety_source.toIsIntegral
  haveI := h.isContraction.isProper
  haveI : IsDominant g := isDominant_of_forall_isIso_app g h.isContraction.isIso_app
  haveI := AlgebraicGeometry.isProper_fiberToSpecResidueField g (genericPoint W)
  rw [AlgebraicGeometry.isCurve_iff]
  refine ⟨{ }, ?_⟩
  rw [(g.fiberHomeo (genericPoint W)).isHomeomorph.topologicalKrullDim_eq]
  exact h.dim_genericFiber

/-- In characteristic zero, the generic fibre of a log elliptic fiber space is smooth over
`k(W)` (generic smoothness). -/
private theorem smooth_fiberToSpecResidueField :
    haveI := h.isContraction.isVariety_target.toIsIntegral
    Smooth (g.fiberToSpecResidueField (genericPoint W)) := by
  haveI := h.isContraction.isVariety_target.toIsIntegral
  haveI := isCurve_fiberToSpecResidueField h
  haveI := isNormal_genericFiber g
  let φ : CommRingCat.of k ⟶ W.residueField (genericPoint W) :=
    (Scheme.ΓSpecIso (.of k)).inv ≫ sW.appTop ≫ W.presheaf.germ ⊤ (genericPoint W) trivial ≫
      W.residue (genericPoint W)
  haveI : CharZero (W.residueField (genericPoint W)) :=
    (RingHom.charZero_iff φ.hom.injective).mp inferInstance
  haveI : PerfectField (W.residueField (genericPoint W)) := PerfectField.ofCharZero
  haveI : IsLocallyNoetherian (g.fiber (genericPoint W)) :=
    LocallyOfFiniteType.isLocallyNoetherian (g.fiberToSpecResidueField (genericPoint W))
  exact smooth_of_isRegular_of_perfectField (W.residueField (genericPoint W)) _
    (isRegular_of_isNormal_of_topologicalKrullDim_le_one _
      (AlgebraicGeometry.IsCurve.topologicalKrullDim_eq_one (k := W.residueField (genericPoint W))
        (f := g.fiberToSpecResidueField (genericPoint W))).le)

/-- The generic fibre of a log elliptic fiber space is geometrically connected over `k(W)`,
as `g_* 𝒪_V = 𝒪_W`. -/
private theorem geometricallyConnected_fiberToSpecResidueField :
    haveI := h.isContraction.isVariety_target.toIsIntegral
    GeometricallyConnected (g.fiberToSpecResidueField (genericPoint W)) := by
  haveI := h.isContraction.isVariety_target.toIsIntegral
  haveI := h.isContraction.isProper
  haveI := isIso_residue_genericPoint W
  have : IsIso g.c := by
    have := h.isContraction.isIso_app
    exact NatIso.isIso_of_isIso_app _
  exact Stacks.AlgebraicGeometry.geometricallyConnected_fiberToSpecResidueField_of_isIso_residue
    g _ this

include hMc in

end

/-! ### The generic fibre -/

section GenericFiber

variable {k : Type u} [Field k] {V W : Scheme.{u}} {sV : V ⟶ Spec (.of k)}
  {sW : W ⟶ Spec (.of k)} {g : V ⟶ W} [IsIntegral W]

/-- The prime divisor of `V` whose generic point is the image of the generic point of a prime
divisor of the generic fibre `V_η`: the inclusion `V_η ⟶ V` preserves codimension. -/
private noncomputable def fiberPrimeDivisor (g : V ⟶ W) [IsIntegral W]
    (Q : MMP.Mori.PrimeDivisor (g.fiber (genericPoint W))) : MMP.Mori.PrimeDivisor V :=
  AlgebraicGeometry.PrimeDivisor.ofCoheightOne (g.fiberι _ Q.genericPoint)
    ((coheight_fiberι_genericPoint g _).trans Q.coheight_genericPoint)

private theorem genericPoint_fiberPrimeDivisor
    (Q : MMP.Mori.PrimeDivisor (g.fiber (genericPoint W))) :
    (fiberPrimeDivisor g Q).genericPoint = g.fiberι _ Q.genericPoint :=
  AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _

private theorem genericPoint_fiberPrimeDivisor'
    (Q : MMP.Mori.PrimeDivisor (g.fiber (genericPoint W))) :
    AlgebraicGeometry.PrimeDivisor.genericPoint (fiberPrimeDivisor g Q) =
      g.fiberι _ (AlgebraicGeometry.PrimeDivisor.genericPoint Q) :=
  AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _

private theorem fiberPrimeDivisor_injective : Function.Injective (fiberPrimeDivisor g) := by
  intro Q Q' hQ
  apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
  have := congrArg MMP.Mori.PrimeDivisor.genericPoint hQ
  rw [genericPoint_fiberPrimeDivisor, genericPoint_fiberPrimeDivisor] at this
  exact (g.fiberι _).isEmbedding.injective this

/-- The horizontal prime divisors, those whose generic point lies over `η`, are exactly those
coming from the generic fibre. -/
private theorem mem_range_fiberPrimeDivisor {P : MMP.Mori.PrimeDivisor V}
    (hP : g P.genericPoint = genericPoint W) : P ∈ Set.range (fiberPrimeDivisor g) := by
  have hmem : P.genericPoint ∈ Set.range (g.fiberι (genericPoint W)) := by
    rw [Scheme.Hom.range_fiberι]; exact hP
  obtain ⟨q, hq⟩ := hmem
  have hc : Order.coheight q = 1 := by
    rw [← coheight_fiberι_genericPoint g q, hq]; exact P.coheight_genericPoint
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne q hc, ?_⟩
  apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
  rw [genericPoint_fiberPrimeDivisor', AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]
  exact hq

private theorem map_genericPoint_fiberPrimeDivisor
    (Q : MMP.Mori.PrimeDivisor (g.fiber (genericPoint W))) :
    g (fiberPrimeDivisor g Q).genericPoint = genericPoint W := by
  rw [genericPoint_fiberPrimeDivisor, ← Scheme.Hom.comp_apply, Scheme.Hom.fiber_fac,
    Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]

/-- A morphism to an affine scheme, precomposed with `Spec κ(x) ⟶ X`, is the spectrum of
evaluation of global sections at `x`. -/
private theorem fromSpecResidueField_comp' {X : Scheme.{u}} (x : X) {R : CommRingCat.{u}}
    (f : X ⟶ Spec R) :
    X.fromSpecResidueField x ≫ f =
      Spec.map ((Scheme.ΓSpecIso R).inv ≫ f.appTop ≫ X.Γevaluation x) := by
  rw [← cancel_mono (Spec R).isoSpec.hom]
  change _ ≫ (Spec _).toSpecΓ = _ ≫ (Spec _).toSpecΓ
  conv_lhs => rw [Category.assoc, Scheme.toSpecΓ_naturality]
  simp only [Scheme.fromSpecResidueField, Category.assoc,
    Scheme.fromSpecStalk_toSpecΓ_assoc, ← AlgebraicGeometry.Spec.map_comp]
  rw [← SpecMap_ΓSpecIso_hom, ← AlgebraicGeometry.Spec.map_comp, Spec.map_inj,
    Iso.hom_inv_id_assoc]
  rfl

/-- The residue field extension `κ(ξ)/κ(η)` at a point `ξ` of `V` over the generic point `η` of
`W` is the residue field extension of the generic fibre over `k(W)` at the corresponding point. -/
private theorem finrank_residueField_fiber {x : V} {q : g.fiber (genericPoint W)}
    (hx : x = g.fiberι _ q) (hgx : g x = genericPoint W) :
    (letI := (g.residueFieldMap x).hom.toAlgebra;
      Module.finrank (W.residueField (g x)) (V.residueField x)) =
      letI : Algebra (W.residueField (genericPoint W))
          ((g.fiber (genericPoint W)).residueField q) :=
        ((Scheme.ΓSpecIso (.of (W.residueField (genericPoint W)))).inv ≫
          (g.fiberToSpecResidueField (genericPoint W)).appTop ≫
          (g.fiber (genericPoint W)).Γevaluation q).hom.toAlgebra
      Module.finrank (W.residueField (genericPoint W))
        ((g.fiber (genericPoint W)).residueField q) := by
  subst hx
  haveI := AlgebraicGeometry.isIso_residueFieldMap_of_isPreimmersion (g.fiberι (genericPoint W)) q
  letI : Algebra (W.residueField (genericPoint W)) ((g.fiber (genericPoint W)).residueField q) :=
    ((Scheme.ΓSpecIso (.of (W.residueField (genericPoint W)))).inv ≫
      (g.fiberToSpecResidueField (genericPoint W)).appTop ≫
      (g.fiber (genericPoint W)).Γevaluation q).hom.toAlgebra
  letI := (g.residueFieldMap (g.fiberι _ q)).hom.toAlgebra
  have key : (W.residueFieldCongr hgx).hom ≫ ((Scheme.ΓSpecIso
      (.of (W.residueField (genericPoint W)))).inv ≫
      (g.fiberToSpecResidueField (genericPoint W)).appTop ≫
      (g.fiber (genericPoint W)).Γevaluation q) =
      g.residueFieldMap (g.fiberι _ q) ≫ (g.fiberι _).residueFieldMap q := by
    apply Spec.map_injective
    rw [← cancel_mono (W.fromSpecResidueField (g (g.fiberι _ q)))]
    rw [Spec.map_comp (W.residueFieldCongr hgx).hom]
    erw [← fromSpecResidueField_comp' q (g.fiberToSpecResidueField (genericPoint W))]
    rw [Spec.map_comp (g.residueFieldMap _)]
    simp only [Category.assoc]
    rw [Scheme.residueFieldCongr_fromSpecResidueField,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField_assoc, Scheme.Hom.fiber_fac]
  refine Algebra.finrank_eq_of_equiv_equiv (W.residueFieldCongr hgx).commRingCatIsoToRingEquiv
    (asIso ((g.fiberι _).residueFieldMap q)).commRingCatIsoToRingEquiv ?_
  ext z
  exact congrArg (fun φ => φ.hom z) key

/-- The residue degree of a closed point of the generic fibre over `k(W)` is the degree
`[κ(ξ) : k(W)]` of the corresponding horizontal prime divisor. -/
private theorem genericFiberPointDegree_fiberPrimeDivisor
    (Q : MMP.Mori.PrimeDivisor (g.fiber (genericPoint W))) :
    letI : Algebra (W.residueField (genericPoint W))
        ((g.fiber (genericPoint W)).residueField Q.genericPoint) :=
      ((Scheme.ΓSpecIso (.of (W.residueField (genericPoint W)))).inv ≫
        (g.fiberToSpecResidueField (genericPoint W)).appTop ≫
        (g.fiber (genericPoint W)).Γevaluation Q.genericPoint).hom.toAlgebra
    genericFiberPointDegree g (fiberPrimeDivisor g Q) =
      Module.finrank (W.residueField (genericPoint W))
        ((g.fiber (genericPoint W)).residueField Q.genericPoint) := by
  rw [genericFiberPointDegree, if_pos (map_genericPoint_fiberPrimeDivisor Q)]
  exact finrank_residueField_fiber (genericPoint_fiberPrimeDivisor Q)
    (map_genericPoint_fiberPrimeDivisor Q)

end GenericFiber

/-! ### The degree on the generic fibre -/

section Degree

variable {V W : Scheme.{u}} {g : V ⟶ W} [IsIntegral W]

private theorem genericFiberDegree_eq_sum (D : QDivisor V) :
    genericFiberDegree g D = D.sum fun P c => c * genericFiberPointDegree g P := rfl

private theorem genericFiberDegree_add (D D' : QDivisor V) :
    genericFiberDegree g (D + D') = genericFiberDegree g D + genericFiberDegree g D' := by
  simp only [genericFiberDegree_eq_sum]
  exact Finsupp.sum_add_index' (fun _ => zero_mul _) (fun _ _ _ => add_mul _ _ _)

private theorem genericFiberDegree_nonneg {D : QDivisor V} (hD : ∀ P, 0 ≤ D.coeff P) :
    0 ≤ genericFiberDegree g D :=
  Finset.sum_nonneg fun P _ => mul_nonneg (hD P) (Nat.cast_nonneg _)

variable [IsLocallyNoetherian V] [IsNormal V]
  [IsLocallyNoetherian (g.fiber (genericPoint W))] [IsNormal (g.fiber (genericPoint W))]
  [AlgebraicGeometry.IsCurve (W.residueField (genericPoint W))
    (g.fiberToSpecResidueField (genericPoint W))]
  [Smooth (g.fiberToSpecResidueField (genericPoint W))]
  [IsProper (g.fiberToSpecResidueField (genericPoint W))]

/-- **The degree of the restriction of a divisor to the generic fibre.** If `D'` on `V_η` has the
coefficients of `D` along the horizontal prime divisors, `deg_{k(W)} 𝒪_{V_η}(D') = D · E_g`. -/
private theorem invertibleCurveDegree_eq_genericFiberDegree (D : Divisor V)
    (D' : Divisor (g.fiber (genericPoint W)))
    (hD' : ∀ Q, D'.coeff Q = D.coeff (fiberPrimeDivisor g Q))
    (hdim : topologicalKrullDim (g.fiber (genericPoint W)) ≤ 1)
    [SheafOfModules.IsInvertible (g.fiber (genericPoint W)).presheaf
      (g.fiber (genericPoint W)).ringCatSheaf.2 D'.divisorialSheaf] :
    (invertibleCurveDegree (W.residueField (genericPoint W))
      (g.fiberToSpecResidueField (genericPoint W)) hdim D'.divisorialSheaf : ℚ) =
      genericFiberDegree g (Divisor.toQDivisor D) := by
  classical
  rw [invertibleCurveDegree_divisorialSheaf_eq_sum _ D' hdim, Finsupp.sum, Int.cast_sum,
    genericFiberDegree]
  have hsupp : D'.support = (Divisor.toQDivisor D).support.preimage (fiberPrimeDivisor g)
      fiberPrimeDivisor_injective.injOn := by
    ext Q
    rw [Finset.mem_preimage, Finsupp.mem_support_iff, Finsupp.mem_support_iff]
    change D'.coeff Q ≠ 0 ↔ (Divisor.toQDivisor D).coeff _ ≠ 0
    rw [hD' Q, Divisor.coeff_toQDivisor, Int.cast_ne_zero]
  rw [hsupp, ← Finset.sum_preimage (fiberPrimeDivisor g) _ fiberPrimeDivisor_injective.injOn _
    fun P _ hP => ?_]
  · refine Finset.sum_congr rfl fun Q _ => ?_
    rw [genericFiberPointDegree_fiberPrimeDivisor Q, Divisor.coeff_toQDivisor, ← hD' Q]
    push_cast
    rfl
  · rw [genericFiberPointDegree, if_neg (fun h => hP (mem_range_fiberPrimeDivisor h)),
      Nat.cast_zero, mul_zero]

end Degree

/-! ### Restricting divisors of a log elliptic fiber space to the generic fibre -/

section LogElliptic

variable {k : Type u} [Field k] [CharZero k] {V W : Scheme.{u}} {sV : V ⟶ Spec (.of k)}
    {sW : W ⟶ Spec (.of k)} [IsLocallyNoetherian V] [IsNormal V] {n : ℕ} {K : Divisor V}
    {Δ : QDivisor V} {g : V ⟶ W} [IsIntegral W] (h : IsLogEllipticFiberSpace k sV sW n K Δ g)
    [IsLocallyNoetherian (g.fiber (genericPoint W))] [IsNormal (g.fiber (genericPoint W))]
    [IsIntegral (g.fiber (genericPoint W))]
    [AlgebraicGeometry.IsCurve (W.residueField (genericPoint W))
      (g.fiberToSpecResidueField (genericPoint W))]
    [Smooth (g.fiberToSpecResidueField (genericPoint W))]
    [IsProper (g.fiberToSpecResidueField (genericPoint W))]

include h

/-- The generic fibre lies in the smooth locus of `V`: its local rings are regular, being local
rings of the regular curve `V_η`. -/
private theorem fiberι_mem_smoothLocus (q : g.fiber (genericPoint W)) :
    g.fiberι _ q ∈ smoothLocus sV := by
  haveI := isRegularLocalRing_stalk_of_isNormal (g.fiber (genericPoint W))
    (AlgebraicGeometry.IsCurve.topologicalKrullDim_eq_one (k := W.residueField (genericPoint W))
      (f := g.fiberToSpecResidueField (genericPoint W))).le q
  haveI := isIso_stalkMap_fiberι_genericPoint' g q
  haveI : IsRegularLocalRing (V.presheaf.stalk (g.fiberι _ q)) := IsRegularLocalRing.of_ringEquiv
    (asIso ((g.fiberι _).stalkMap q)).commRingCatIsoToRingEquiv.symm
  haveI : PerfectField k := PerfectField.ofCharZero
  haveI := h.isContraction.isVariety_source.toLocallyOfFiniteType
  exact mem_smoothLocus_of_isRegularLocalRing sV _

/-- The inclusion of the generic fibre into the smooth locus of `V`. -/
private noncomputable def fiberToSmoothLocus :
    g.fiber (genericPoint W) ⟶ (smoothLocus sV).toScheme :=
  IsOpenImmersion.lift (smoothLocus sV).ι (g.fiberι (genericPoint W)) (by
    rintro _ ⟨q, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact fiberι_mem_smoothLocus h q)

private theorem fiberToSmoothLocus_ι :
    fiberToSmoothLocus h ≫ (smoothLocus sV).ι = g.fiberι (genericPoint W) :=
  IsOpenImmersion.lift_fac _ _ _

private theorem isIso_stalkMap_fiberToSmoothLocus (q : g.fiber (genericPoint W)) :
    IsIso ((fiberToSmoothLocus h).stalkMap q) := by
  haveI h1 : IsIso ((fiberToSmoothLocus h ≫ (smoothLocus sV).ι).stalkMap q) := by
    rw [fiberToSmoothLocus_ι h]; exact isIso_stalkMap_fiberι_genericPoint' g q
  rw [Scheme.Hom.stalkMap_comp] at h1
  exact @IsIso.of_isIso_comp_left _ _ _ _ _ _ _
    (IsOpenImmersion.instIsIsoCommRingCatStalkMap (smoothLocus sV).ι _) h1

private theorem nonempty_smoothLocus : Nonempty (smoothLocus sV) := by
  obtain ⟨q⟩ := (inferInstance : Nonempty (g.fiber (genericPoint W)))
  exact ⟨⟨_, fiberι_mem_smoothLocus h q⟩⟩

/-- The smooth locus of the normal variety `V` of dimension `n` is smooth of relative
dimension `n` over `k`. -/
private theorem smoothOfRelativeDimension_smoothLocus :
    SmoothOfRelativeDimension n ((smoothLocus sV).ι ≫ sV) := by
  haveI := h.isContraction.isVariety_source.toIsIntegral
  haveI := h.isContraction.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sV :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  haveI := smooth_smoothLocus_ι sV
  haveI := nonempty_smoothLocus h
  haveI := MMP.Fourfold.isDominant_ι_of_nonempty (smoothLocus sV)
  have hX := h.isLogVariety.isNormalVariety
  haveI : MMP.Mori.IsVariety k ((smoothLocus sV).ι ≫ sV) := (isNormalVariety_ι hX _).1
  exact MMP.Intersection.smoothOfRelativeDimension_of_isVariety _ n
    ((topologicalKrullDim_opens_eq hX _).trans h.isCanonicalDivisor.1)

omit [IsLocallyNoetherian (g.fiber (genericPoint W))]
  [IsNormal (g.fiber (genericPoint W))] [IsIntegral (g.fiber (genericPoint W))]
  [AlgebraicGeometry.IsCurve (W.residueField (genericPoint W))
    (g.fiberToSpecResidueField (genericPoint W))]
  [Smooth (g.fiberToSpecResidueField (genericPoint W))]
  [IsProper (g.fiberToSpecResidueField (genericPoint W))] in
/-- The differentials of the function field `k(W)` over `k` form a finite free module: `W` is
smooth over `k` at its generic point. -/
private theorem exists_isFiniteLocallyFreeOfRank_relativeDifferentials_residueField :
    ∃ d, SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials (W.fromSpecResidueField (genericPoint W) ≫ sW)) d := by
  haveI := h.isContraction.isVariety_target.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sW :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  haveI : PerfectField k := PerfectField.ofCharZero
  have hη : genericPoint W ∈ smoothLocus sW := mem_smoothLocus_of_isRegularLocalRing sW _
  haveI := smooth_smoothLocus_ι sW
  obtain ⟨V', hV', r, hr⟩ :=
    Stacks.ProjectiveBundleSplitting.exists_isFiniteLocallyFreeOfRank_restrict
      (Scheme.Hom.relativeDifferentials ((smoothLocus sW).ι ≫ sW))
      (Scheme.Hom.isFiniteLocallyFree_relativeDifferentials _) ⟨_, hη⟩
  have hrange : Set.range (W.fromSpecResidueField (genericPoint W)) ⊆
      Set.range (V'.ι ≫ (smoothLocus sW).ι) := by
    rw [Scheme.range_fromSpecResidueField]
    rintro _ rfl
    exact ⟨⟨⟨genericPoint W, hη⟩, hV'⟩, rfl⟩
  let j := IsOpenImmersion.lift (V'.ι ≫ (smoothLocus sW).ι)
    (W.fromSpecResidueField (genericPoint W)) hrange
  have hj : j ≫ V'.ι ≫ (smoothLocus sW).ι = W.fromSpecResidueField (genericPoint W) :=
    IsOpenImmersion.lift_fac _ _ _
  have hjs : ∀ s, IsIso (j.stalkMap s) := by
    intro s
    haveI h1 : IsIso ((j ≫ V'.ι ≫ (smoothLocus sW).ι).stalkMap s) := by
      rw [hj]
      haveI := isIso_residue_genericPoint W
      change IsIso ((Spec.map (W.residue (genericPoint W)) ≫
        W.fromSpecStalk (genericPoint W)).stalkMap s)
      rw [Scheme.Hom.stalkMap_comp]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _
        (isIso_stalkMap_fromSpecStalk (genericPoint W) _)
        (IsOpenImmersion.instIsIsoCommRingCatStalkMap (Spec.map (W.residue (genericPoint W))) s)
    rw [Scheme.Hom.stalkMap_comp] at h1
    exact @IsIso.of_isIso_comp_left _ _ _ _ _ _ _
      (IsOpenImmersion.instIsIsoCommRingCatStalkMap (V'.ι ≫ (smoothLocus sW).ι) _) h1
  have hc : j ≫ (V'.ι ≫ (smoothLocus sW).ι ≫ sW) =
      (W.fromSpecResidueField (genericPoint W) ≫ sW) ≫ 𝟙 _ := by
    rw [Category.comp_id, ← hj]; simp only [Category.assoc]
  haveI e1 := isIso_relativeDifferentialsMap_of_isIso_stalkMap' j
    (V'.ι ≫ (smoothLocus sW).ι ≫ sW) _ hc hjs
  have hc2 : V'.ι ≫ ((smoothLocus sW).ι ≫ sW) = (V'.ι ≫ (smoothLocus sW).ι ≫ sW) ≫ 𝟙 _ := by
    simp
  haveI e2 := isIso_relativeDifferentialsMap_of_isIso_stalkMap' V'.ι
    ((smoothLocus sW).ι ≫ sW) _ hc2 (fun _ => inferInstance)
  have hr' : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials (V'.ι ≫ (smoothLocus sW).ι ≫ sW)) r :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
      ((Scheme.Modules.restrictFunctorIsoPullback V'.ι).app _ ≪≫ @asIso _ _ _ _ _ e2) hr
  exact ⟨r, SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso (@asIso _ _ _ _ _ e1)
    (Stacks.Chow.isFiniteLocallyFreeOfRank_pullback_obj j _ r)⟩

/-- **The canonical divisor restricts to a canonical divisor of the generic fibre.** There is a
divisor on `V_η`, with the coefficients of `K_V` along the horizontal prime divisors, whose sheaf
is `Ω¹_{V_η/k(W)}`. -/
private theorem exists_divisor_fiber_canonical :
    ∃ DK : Divisor (g.fiber (genericPoint W)),
      (∀ Q, DK.coeff Q = K.coeff (fiberPrimeDivisor g Q)) ∧
      Nonempty (DK.divisorialSheaf ≅
        Scheme.Hom.relativeDifferentials (g.fiberToSpecResidueField (genericPoint W))) := by
  haveI := h.isContraction.isVariety_source.toIsIntegral
  haveI := h.isContraction.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sV :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  haveI : IsDominant g := isDominant_of_forall_isIso_app g h.isContraction.isIso_app
  haveI := nonempty_smoothLocus h
  haveI := MMP.Fourfold.isDominant_ι_of_nonempty (smoothLocus sV)
  haveI := smooth_smoothLocus_ι sV
  haveI := smoothOfRelativeDimension_smoothLocus h
  have hsm : IsSmoothScheme ((smoothLocus sV).ι ≫ sV) := (isSmoothScheme_iff _).mpr inferInstance
  haveI : CompactSpace V := by
    have := h.isContraction.isVariety_source.toQuasiCompact
    exact QuasiCompact.compactSpace_of_compactSpace sV
  haveI : IsNoetherian V := {}
  haveI : CompactSpace (smoothLocus sV) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact _)
  haveI : CompactSpace (g.fiber (genericPoint W)) :=
    QuasiCompact.compactSpace_of_compactSpace (g.fiberToSpecResidueField (genericPoint W))
  haveI : IsDominant (fiberToSmoothLocus h) := by
    have : IsDominant (fiberToSmoothLocus h ≫ (smoothLocus sV).ι) := by
      rw [fiberToSmoothLocus_ι h]; infer_instance
    exact IsDominant.of_comp_of_isOpenImmersion _ (smoothLocus sV).ι
  have hKU : Divisor.IsCartier (K.restrictOpen (smoothLocus sV)) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hB : ∀ Z, fiberToSmoothLocus h (componentGenericPoint _ Z) ∉
      (K.restrictOpen (smoothLocus sV)).supp :=
    fun Z => MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant _ _ Z
  refine ⟨Divisor.pullback (K.restrictOpen (smoothLocus sV)) hKU hB, fun Q => ?_, ?_⟩
  · haveI := isIso_stalkMap_fiberToSmoothLocus h Q.genericPoint
    have hc : Order.coheight (fiberToSmoothLocus h Q.genericPoint) = 1 := by
      rw [← coheight_eq_of_isOpenImmersion (smoothLocus sV).ι, ← Scheme.Hom.comp_apply,
        fiberToSmoothLocus_ι h, coheight_fiberι_genericPoint]
      exact Q.coheight_genericPoint
    rw [coeff_eq_of_isPullback hKU (Divisor.isPullback_pullback hKU hB) Q
      (AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hc)
      (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _).symm,
      DivisorWithCoeffs.coeff_restrictOpen]
    congr 1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [OpenWeilRestriction.genericPoint_primeDivisorMap, genericPoint_fiberPrimeDivisor',
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne, ← Scheme.Hom.comp_apply,
      fiberToSmoothLocus_ι h]
  · have hcomm : fiberToSmoothLocus h ≫ (smoothLocus sV).ι ≫ sV =
        g.fiberToSpecResidueField (genericPoint W) ≫
          (W.fromSpecResidueField (genericPoint W) ≫ sW) := by
      rw [← Category.assoc, fiberToSmoothLocus_ι h, ← h.isContraction.comp_eq,
        ← Category.assoc, Scheme.Hom.fiber_fac, Category.assoc]
    obtain ⟨e1⟩ := MMP.Mori.Divisor.nonempty_divisorialSheaf_pullback_iso hKU
      (fiberToSmoothLocus h) hB
    obtain ⟨e2⟩ := nonempty_divisorialSheaf_restrictOpen_iso K (smoothLocus sV)
    haveI : MMP.Mori.IsVariety (W.residueField (genericPoint W))
        (g.fiberToSpecResidueField (genericPoint W)) :=
      (inferInstance : AlgebraicGeometry.IsCurve (W.residueField (genericPoint W))
        (g.fiberToSpecResidueField (genericPoint W))).toIsVariety
    haveI : SmoothOfRelativeDimension 1 (g.fiberToSpecResidueField (genericPoint W)) :=
      MMP.Intersection.smoothOfRelativeDimension_of_isVariety
        (k := W.residueField (genericPoint W)) _ 1
        (by rw [AlgebraicGeometry.IsCurve.topologicalKrullDim_eq_one
          (k := W.residueField (genericPoint W)) (f := g.fiberToSpecResidueField _)]; rfl)
    obtain ⟨e3⟩ := nonempty_pullback_relativeDifferentialForms_iso
      (κ := W.residueField (genericPoint W))
      (g.fiberToSpecResidueField (genericPoint W)) _
      (exists_isFiniteLocallyFreeOfRank_relativeDifferentials_residueField h) _ n
      (fiberToSmoothLocus h) (isIso_stalkMap_fiberToSmoothLocus h) hcomm
    exact ⟨e1 ≪≫ (Scheme.Modules.pullback (fiberToSmoothLocus h)).mapIso
      (e2 ≪≫ h.isCanonicalDivisor.iso) ≪≫ e3⟩

/-- **The canonical divisor has degree `2g - 2` on the generic fibre**: `K_V · E_g = 2g - 2`,
`K_V` restricting to a divisor of `E_g` whose sheaf is `Ω¹_{E_g/k(W)}`. -/
private theorem two_mul_genus_sub_two_eq_genericFiberDegree
    [GeometricallyConnected (g.fiberToSpecResidueField (genericPoint W))]
    (DK : Divisor (g.fiber (genericPoint W)))
    (hDK : ∀ Q, DK.coeff Q = K.coeff (fiberPrimeDivisor g Q))
    (eK : DK.divisorialSheaf ≅
      Scheme.Hom.relativeDifferentials (g.fiberToSpecResidueField (genericPoint W))) :
    2 * (genus (g.fiberToSpecResidueField (genericPoint W)) : ℚ) - 2 =
      genericFiberDegree g (Divisor.toQDivisor K) := by
  have hdim := (AlgebraicGeometry.IsCurve.topologicalKrullDim_eq_one
    (k := W.residueField (genericPoint W)) (f := g.fiberToSpecResidueField (genericPoint W))).le
  haveI : CompactSpace (g.fiber (genericPoint W)) :=
    QuasiCompact.compactSpace_of_compactSpace (g.fiberToSpecResidueField (genericPoint W))
  haveI := (MMP.Fourfold.isCartier_of_isSmoothScheme ((isSmoothScheme_iff
    (g.fiberToSpecResidueField (genericPoint W))).mpr inferInstance)
      DK).isInvertibleModule_divisorialSheaf
  haveI : IsIso ((Scheme.ΓSpecIso (.of (W.residueField (genericPoint W)))).inv ≫
      (g.fiberToSpecResidueField (genericPoint W)).appTop) := by
    have hh := (isIso_globalSections_tfae_geometricallyConnected_irreducible_integral
      (W.residueField (genericPoint W)) (g.fiberToSpecResidueField (genericPoint W))
      (isGeometricallyNormal_of_smooth (k := W.residueField (genericPoint W))
        (g.fiberToSpecResidueField (genericPoint W)))).out 1 2
    exact hh.mpr inferInstance
  rw [← invertibleCurveDegree_eq_genericFiberDegree K DK hDK hdim,
    invertibleCurveDegree_eq_of_iso _ _ hdim eK,
    invertibleCurveDegree_relativeDifferentials_eq_two_mul_genus_sub_two]
  push_cast
  rfl

end LogElliptic

/-- **The boundary of a log elliptic fiber space has degree at most two on the generic fibre**:
`2g - 2 + Δ · E_g = 0` and `g ≥ 0`. -/
private theorem genericFiberDegree_le_two {k : Type u} [Field k] [CharZero k] {V W : Scheme.{u}}
    {sV : V ⟶ Spec (.of k)} {sW : W ⟶ Spec (.of k)} [IsLocallyNoetherian V] [IsNormal V] {n : ℕ}
    {K : Divisor V} {Δ : QDivisor V} {g : V ⟶ W} (h : IsLogEllipticFiberSpace k sV sW n K Δ g) :
    haveI := h.isContraction.isVariety_target.toIsIntegral
    genericFiberDegree g Δ ≤ 2 := by
  haveI := h.isContraction.isVariety_target.toIsIntegral
  haveI := h.isContraction.isVariety_source.toIsIntegral
  haveI : IsDominant g := isDominant_of_forall_isIso_app g h.isContraction.isIso_app
  haveI := isCurve_fiberToSpecResidueField h
  haveI := smooth_fiberToSpecResidueField h
  haveI := geometricallyConnected_fiberToSpecResidueField h
  haveI := h.isContraction.isProper
  haveI : IsProper (g.fiberToSpecResidueField (genericPoint W)) :=
    AlgebraicGeometry.isProper_fiberToSpecResidueField g _
  haveI := isNormal_genericFiber g
  haveI : IsLocallyNoetherian (g.fiber (genericPoint W)) :=
    LocallyOfFiniteType.isLocallyNoetherian (g.fiberToSpecResidueField (genericPoint W))
  haveI := AlgebraicGeometry.isIntegral_fiber_genericPoint g
  haveI : CompactSpace (g.fiber (genericPoint W)) :=
    QuasiCompact.compactSpace_of_compactSpace (g.fiberToSpecResidueField (genericPoint W))
  obtain ⟨DK, hDK, ⟨eK⟩⟩ := exists_divisor_fiber_canonical h
  have h0 : genericFiberDegree g (Divisor.toQDivisor K) + genericFiberDegree g Δ = 0 := by
    rw [← genericFiberDegree_add]; exact h.genericFiberDegree_eq_zero
  have hK := two_mul_genus_sub_two_eq_genericFiberDegree h DK hDK eK
  have : (0 : ℚ) ≤ genus (g.fiberToSpecResidueField (genericPoint W)) := Nat.cast_nonneg _
  linarith

end GenericFiberTorsion

/-- The dimension formula for a dominant morphism onto the closure of its image: `X` has the
dimension of `closure f(X)` plus that of the generic fibre. -/
private theorem topologicalKrullDim_eq_add_fiber {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (sY : Y ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    [LocallyOfFiniteType sY] (f : X ⟶ Y) (hf : f ≫ sY = sX) [QuasiCompact f] :
    topologicalKrullDim X = topologicalKrullDim (closure (Set.range f.base)) +
      topologicalKrullDim (f.fiber (f (genericPoint X))) := by
  have hLY : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have hLX : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have hfact : f.toImage ≫ f.imageι = f := Scheme.Hom.toImage_imageι f
  have hLS : LocallyOfFiniteType (f.imageι ≫ sY) := by infer_instance
  haveI : LocallyOfFiniteType (f.toImage ≫ f.imageι ≫ sY) := by
    rw [← Category.assoc, hfact, hf]; infer_instance
  haveI : LocallyOfFiniteType f.toImage := LocallyOfFiniteType.of_comp (g := f.imageι ≫ sY)
      inferInstance
  haveI : IsLocallyNoetherian f.image := LocallyOfFiniteType.isLocallyNoetherian (f.imageι ≫ sY)
  haveI : IrreducibleSpace f.image := (irreducibleSpace_def _).2 (by
      have h := ((IrreducibleSpace.isIrreducible_univ X).image _
          f.toImage.continuous.continuousOn).closure
      rwa [Set.image_univ, (IsDominant.denseRange (f := f.toImage)).closure_eq] at h)
  obtain ⟨O, hO, hne, hform⟩ :=
      exists_isOpen_nonempty_topologicalKrullDimAt_eq_add_fiber_of_irreducibleSpace f.toImage
  have hξ : genericPoint X ∈ O := by
    obtain ⟨w, hw⟩ := hne
    exact ((genericPoint_spec X).mem_open_set_iff hO).2 ⟨w, ⟨trivial, hw⟩⟩
  have h1 := hform _ hξ
  have e1 : topologicalKrullDim X = topologicalKrullDimAt X (genericPoint X) :=
    topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible k X sX _
  have e2 : topologicalKrullDim f.image =
      topologicalKrullDimAt f.image (f.toImage (genericPoint X)) :=
    topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible k f.image (f.imageι ≫ sY) _
  have e3 : topologicalKrullDim f.image = topologicalKrullDim (closure (Set.range f.base)) := by
    let e := f.imageι.isEmbedding.toHomeomorph.trans
      (Homeomorph.setCongr (Scheme.Hom.range_imageι f))
    exact IsHomeomorph.topologicalKrullDim_eq e e.isHomeomorph
  have hset : (f.toImage ⁻¹' {f.toImage (genericPoint X)} : Set X) = f ⁻¹' {f (genericPoint X)} :=
      by
    ext x
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro h; rw [← hfact]; simp only [Scheme.Hom.comp_apply]; rw [h]
    · intro h
      rw [← hfact] at h
      simp only [Scheme.Hom.comp_apply] at h
      exact f.imageι.injective h
  have hirr : IsIrreducible (f.toImage ⁻¹' {f.toImage (genericPoint X)} : Set X) := by
    rw [← isIrreducible_iff_closure]
    have : closure (f.toImage ⁻¹' {f.toImage (genericPoint X)} : Set X) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      rw [← (genericPoint_spec X).def]
      exact closure_mono (by simp)
    rw [this]; exact IrreducibleSpace.isIrreducible_univ X
  haveI : IrreducibleSpace (f.toImage.fiber (f.toImage (genericPoint X))) := by
    refine (irreducibleSpace_def _).2 ?_
    haveI : IrreducibleSpace ↥(f.toImage ⁻¹' {f.toImage (genericPoint X)} : Set X) :=
      Subtype.irreducibleSpace hirr
    let φ := f.toImage.fiberHomeo (f.toImage (genericPoint X))
    have h := (IrreducibleSpace.isIrreducible_univ
      ↥(f.toImage ⁻¹' {f.toImage (genericPoint X)} : Set X)).image φ.symm
      φ.symm.continuous.continuousOn
    rwa [Set.image_univ, φ.symm.surjective.range_eq] at h
  have e4 : topologicalKrullDim (f.toImage.fiber (f.toImage (genericPoint X))) =
      topologicalKrullDimAt (f.toImage.fiber (f.toImage (genericPoint X)))
        (f.toImage.asFiber (genericPoint X)) :=
    have := Scheme.Hom.locallyOfFiniteType_fiberToSpecResidueField f.toImage
      (f.toImage (genericPoint X))
    topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible
      (f.image.residueField (f.toImage (genericPoint X)))
      (f.toImage.fiber (f.toImage (genericPoint X)))
      (f.toImage.fiberToSpecResidueField _) _
  have e5 : topologicalKrullDim (f.toImage.fiber (f.toImage (genericPoint X))) =
      topologicalKrullDim (f.fiber (f (genericPoint X))) := by
    let e := (f.toImage.fiberHomeo (f.toImage (genericPoint X))).trans
      ((Homeomorph.setCongr hset).trans (f.fiberHomeo (f (genericPoint X))).symm)
    exact IsHomeomorph.topologicalKrullDim_eq e e.isHomeomorph
  rw [e1, h1, ← e4, ← e2, e3, e5]

/-- The dimension formula in natural numbers: with `a = dim X` and `b = dim closure f(X)`, we have
`b ≤ a` and the generic fibre has dimension `a - b`. -/
private theorem exists_dim_generic_fibre {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (sY : Y ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    [LocallyOfFiniteType sY] (f : X ⟶ Y) (hf : f ≫ sY = sX) [QuasiCompact f] [CompactSpace X] :
    ∃ a b : ℕ, topologicalKrullDim X = a ∧ topologicalKrullDim (closure (Set.range f.base)) = b ∧
      b ≤ a ∧ topologicalKrullDim (f.fiber (f (genericPoint X))) = ((a - b : ℕ) : ℕ∞) := by
  have h := topologicalKrullDim_eq_add_fiber sX sY f hf
  have h1 := topologicalKrullDim_ne_top_of_locallyOfFiniteType k sX
  have hbot : topologicalKrullDim X ≠ ⊥ := fun hb =>
    ((Order.krullDim_eq_bot_iff.mp hb).false (TopologicalSpace.IrreducibleCloseds.closureSingleton
        (genericPoint X))).elim
  induction hX : topologicalKrullDim X using WithBot.recBotCoe with
  | bot => exact absurd hX hbot
  | coe a' =>
    induction hB : topologicalKrullDim (closure (Set.range f.base)) using WithBot.recBotCoe with
    | bot => rw [hX, hB] at h; simp at h
    | coe B =>
      induction hD : topologicalKrullDim (f.fiber (f (genericPoint X))) using WithBot.recBotCoe with
      | bot => rw [hX, hB, hD] at h; simp at h
      | coe D =>
        rw [hX, hB, hD, ← WithBot.coe_add, WithBot.coe_inj] at h
        have ha : a' ≠ ⊤ := by rintro rfl; exact h1 hX
        have hB' : B ≠ ⊤ := by rintro rfl; rw [top_add] at h; exact ha h
        have hD' : D ≠ ⊤ := by rintro rfl; rw [add_top] at h; exact ha h
        lift a' to ℕ using ha
        lift B to ℕ using hB'
        lift D to ℕ using hD'
        have h' : a' = B + D := by exact_mod_cast h
        refine ⟨a', B, rfl, rfl, by omega, ?_⟩
        have : D = a' - B := by omega
        rw [this]

section Fibration

open MMP.Mori

/-- The fibre over the generic point of the target of a dominant morphism of integral schemes is
irreducible: it contains the generic point of the source, which specializes to all its points. -/
private theorem isIrreducible_preimage_genericPoint {Y V : Scheme.{0}} [IsIntegral Y]
    [IsIntegral V] (r : Y ⟶ V) [IsDominant r] :
    IsIrreducible (r.base ⁻¹' {genericPoint V}) := by
  have hη : genericPoint Y ∈ r.base ⁻¹' {genericPoint V} :=
    MMP.Positivity.map_genericPoint_eq_of_isDominant r
  refine ⟨⟨_, hη⟩, fun u v hu hv hu' hv' => ?_⟩
  obtain ⟨x, -, hxu⟩ := hu'
  obtain ⟨y, -, hyv⟩ := hv'
  exact ⟨genericPoint Y, hη, ((genericPoint_spec Y).specializes trivial).mem_open hu hxu,
    ((genericPoint_spec Y).specializes trivial).mem_open hv hyv⟩

/-- A nonempty closed subset of a Noetherian quasi-sober space has a point with no proper
generization in it. -/
private theorem exists_maximal_mem_of_isClosed {T : Type*} [TopologicalSpace T] [QuasiSober T]
    [TopologicalSpace.NoetherianSpace T] [T0Space T] {Z : Set T} (hZ : IsClosed Z) {y : T}
    (hy : y ∈ Z) : ∃ x ∈ Z, ∀ z ∈ Z, z ⤳ x → z = x := by
  obtain ⟨W, hW, hyW⟩ := LogRes.exists_maximal_ge hZ (TopologicalSpace.IrreducibleCloseds.closureSingleton y)
    (by
      change closure {y} ⊆ Z
      exact closure_minimal (Set.singleton_subset_iff.mpr hy) hZ)
  obtain ⟨x, hx⟩ := QuasiSober.sober W.isIrreducible W.isClosed
  refine ⟨x, hW.1 hx.mem, fun z hz hzx => ?_⟩
  have hle : W ≤ TopologicalSpace.IrreducibleCloseds.closureSingleton z := by
    intro t ht
    change t ∈ closure {z}
    have ht' : t ∈ (W : Set T) := ht
    rw [← hx.def] at ht'
    exact closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hzx))
      isClosed_closure ht'
  have hsub : ((TopologicalSpace.IrreducibleCloseds.closureSingleton z :
      TopologicalSpace.IrreducibleCloseds T) : Set T) ⊆ Z := by
    change closure {z} ⊆ Z
    exact closure_minimal (Set.singleton_subset_iff.mpr hz) hZ
  have heq := le_antisymm (hW.2 hsub hle) hle
  have hz' : IsGenericPoint z (W : Set T) := by
    rw [← heq]; exact isGenericPoint_closure
  exact hz'.eq hx

/-- **Generic fibre degrees as sums over a fibre.** For a proper surjective morphism `r : Y ⟶ V`
of complex varieties with `Y` normal and `dim Y = dim V + 1`, the generic fibre degree of a
`ℚ`-Cartier divisor `L` is the sum of its degrees on the components of a closed fibre, a nonempty
finite set of curves contracted by `r`. -/
private theorem exists_finset_genericFiberDegree_eq_sum {Y V : Scheme.{0}} [IsIntegral Y]
    [IsNormal Y] [IsLocallyNoetherian Y] [IsIntegral V] {sY : Y ⟶ Spec (.of ℂ)}
    {sV : V ⟶ Spec (.of ℂ)} [IsSeparated sY] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsSeparated sV] [LocallyOfFiniteType sV] [QuasiCompact sV] (r : Y ⟶ V) (hr : r ≫ sV = sY)
    [IsProper r] [Surjective r] (hdim : topologicalKrullDim Y = topologicalKrullDim V + 1)
    (L : QDivisor Y) (hL : L.IsQCartier) :
    ∃ S : Finset (ProperCurve sY), S.Nonempty ∧ (∀ C ∈ S, C.IsContractedBy r) ∧
      genericFiberDegree r L = ∑ C ∈ S, L.intersectionNumber ℂ sY C.ι C.dim_le hL := by
  obtain ⟨U, hUd, hU⟩ :=
    MMP.Flips.exists_dense_open_genericFiberDegree_eq_sum_intersectionNumber sY sV r hr hdim L hL
  haveI : JacobsonSpace V := LocallyOfFiniteType.jacobsonSpace sV
  obtain ⟨w, hwU, hwc⟩ := nonempty_inter_closedPoints hUd.nonempty U.isOpen.isLocallyClosed
  have hwc' : IsClosed ({w} : Set V) := mem_closedPoints_iff.mp hwc
  obtain ⟨-, hS⟩ := hU w hwU
  obtain ⟨S, hSpts, hdeg⟩ := hS hwc'
  refine ⟨S, ?_, fun C hC => ?_, hdeg⟩
  · obtain ⟨y, hy⟩ := r.surjective w
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
    haveI : IsNoetherian Y := {}
    haveI : TopologicalSpace.NoetherianSpace Y := inferInstance
    obtain ⟨x, hxZ, hxmax⟩ := exists_maximal_mem_of_isClosed (hwc'.preimage r.continuous)
      (show y ∈ r.base ⁻¹' {w} from hy)
    have hx : x ∈ ProperCurve.point '' (S : Set (ProperCurve sY)) := by
      rw [hSpts]; exact ⟨hxZ, fun z hz hzx => hxmax z hz hzx⟩
    obtain ⟨C, hC, -⟩ := hx
    exact ⟨C, hC⟩
  · have hCw : r C.point = w := by
      have : C.point ∈ ProperCurve.point '' (S : Set (ProperCurve sY)) := ⟨C, hC, rfl⟩
      rw [hSpts] at this
      exact this.1
    intro x hx
    have h1 : r x ∈ closure ({r C.point} : Set V) :=
      (specializes_iff_mem_closure.mpr hx).map r.continuous |> specializes_iff_mem_closure.mp
    rw [hCw, hwc'.closure_eq] at h1
    rw [hCw]; exact h1

/-- **A contraction of a threefold onto a surface with numerically trivial adjoint is a log
elliptic fiber space.** -/
private theorem isLogEllipticFiberSpace_of_intersectionNumber_eq_zero {Y V : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [QuasiCompact sY]
    {sV : V ⟶ Spec (.of ℂ)} {r : Y ⟶ V} (hr : MMP.Flips.IsContraction ℂ sV sY r)
    (hdY : topologicalKrullDim Y = 3) (hdV : topologicalKrullDim V = 2) {K : Divisor Y}
    (hK : K.IsCanonicalDivisor sY 3) {B : QDivisor Y} (hB : ∀ P, 0 ≤ B.coeff P ∧ B.coeff P ≤ 1)
    (hq : (Divisor.toQDivisor K + B).IsQCartier)
    (hnum : ∀ C : ProperCurve sY, C.IsContractedBy r →
      (Divisor.toQDivisor K + B).intersectionNumber ℂ sY C.ι C.dim_le hq = 0) :
    IsLogEllipticFiberSpace ℂ sY sV 3 K B r := by
  haveI := hr.isVariety_target.toIsIntegral
  haveI := hr.isProper
  haveI : LocallyOfFiniteType sY := hr.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sV := hr.isVariety_target.toLocallyOfFiniteType
  haveI : QuasiCompact sV := hr.isVariety_target.toQuasiCompact
  haveI : IsSeparated sY := hr.isVariety_source.toIsSeparated
  haveI : IsSeparated sV := hr.isVariety_target.toIsSeparated
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsDominant r := isDominant_of_forall_isIso_app r hr.isIso_app
  haveI : Surjective r := r.surjective_of_isIso_app hr.isIso_app
  have hdim : topologicalKrullDim Y = topologicalKrullDim V + 1 := by
    rw [hdY, hdV]; rfl
  refine ⟨⟨⟨hr.isVariety_source, inferInstance⟩, fun E => ?_⟩, hK, hq, hr, ?_, ?_, ?_⟩
  · rw [QDivisor.coeff_toRDivisor]
    exact ⟨by exact_mod_cast (hB E).1, by exact_mod_cast (hB E).2⟩
  · exact isIrreducible_preimage_genericPoint r
  · obtain ⟨a, b, ha, hb, -, hfib⟩ := exists_dim_generic_fibre sY sV r hr.comp_eq
    have hη : r (genericPoint Y) = genericPoint V :=
      MMP.Positivity.map_genericPoint_eq_of_isDominant r
    have hclos : closure (Set.range r.base) = Set.univ := r.denseRange.closure_eq
    rw [hclos, IsHomeomorph.topologicalKrullDim_eq (Homeomorph.Set.univ V)
      (Homeomorph.Set.univ V).isHomeomorph, hdV] at hb
    rw [hdY] at ha
    have ha3 : a = 3 := by exact_mod_cast ha.symm
    have hb2 : b = 2 := by exact_mod_cast hb.symm
    rw [← (r.fiberHomeo (genericPoint V)).isHomeomorph.topologicalKrullDim_eq, ← hη, hfib, ha3, hb2]
    rfl
  · obtain ⟨S, -, hSc, hsum⟩ := exists_finset_genericFiberDegree_eq_sum r hr.comp_eq hdim
      (Divisor.toQDivisor K + B) hq
    rw [hsum]
    exact Finset.sum_eq_zero fun C hC => hnum C (hSc C hC)

/-- **The floor of a two-floor Mori curve fibration has degree two on the generic fibre.** Let
`r : Y ⟶ V` be a contraction of a threefold onto a surface, `B` a boundary with `K + B`
numerically trivial over `V` and `K + B - ½⌊B⌋` negative on the curves contracted by `r`. If the
reduced floor `⌊B⌋` does not have degree one on the generic fibre, it has degree two. -/
private theorem genericFiberDegree_roundDown_eq_two {Y V : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [QuasiCompact sY]
    {sV : V ⟶ Spec (.of ℂ)} {r : Y ⟶ V} (hr : MMP.Flips.IsContraction ℂ sV sY r)
    (hdY : topologicalKrullDim Y = 3) (hdV : topologicalKrullDim V = 2) {K : Divisor Y}
    (hK : K.IsCanonicalDivisor sY 3) {B : QDivisor Y} (hB : ∀ P, 0 ≤ B.coeff P ∧ B.coeff P ≤ 1)
    (hq : ∀ D : QDivisor Y, D.IsQCartier)
    (hnum : ∀ C : ProperCurve sY, C.IsContractedBy r →
      (Divisor.toQDivisor K + B).intersectionNumber ℂ sY C.ι C.dim_le (hq _) = 0)
    (hneg : ∀ C : ProperCurve sY, C.IsContractedBy r →
      (Divisor.toQDivisor K + (B - (1 / 2 : ℚ) • Divisor.toQDivisor B.roundDown)).intersectionNumber
        ℂ sY C.ι C.dim_le (hq _) < 0)
    (hne : (haveI := hr.isVariety_target.toIsIntegral
      genericFiberDegree r (Divisor.toQDivisor B.roundDown)) ≠ 1) :
    haveI := hr.isVariety_target.toIsIntegral
    genericFiberDegree r (Divisor.toQDivisor B.roundDown) = 2 := by
  haveI := hr.isVariety_target.toIsIntegral
  haveI := hr.isProper
  haveI : LocallyOfFiniteType sY := hr.isVariety_source.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sV := hr.isVariety_target.toLocallyOfFiniteType
  haveI : QuasiCompact sV := hr.isVariety_target.toQuasiCompact
  haveI : IsSeparated sY := hr.isVariety_source.toIsSeparated
  haveI : IsSeparated sV := hr.isVariety_target.toIsSeparated
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsDominant r := isDominant_of_forall_isIso_app r hr.isIso_app
  haveI : Surjective r := r.surjective_of_isIso_app hr.isIso_app
  have hdim : topologicalKrullDim Y = topologicalKrullDim V + 1 := by
    rw [hdY, hdV]; rfl
  set T : QDivisor Y := Divisor.toQDivisor B.roundDown with hTdef
  -- `deg B ≤ 2`
  have h := isLogEllipticFiberSpace_of_intersectionNumber_eq_zero hr hdY hdV hK hB (hq _) hnum
  have hB2 := genericFiberDegree_le_two h
  -- `deg T ≤ deg B`
  have hTB : genericFiberDegree r T ≤ genericFiberDegree r B := by
    have e : B = T + (B - T) := by abel
    have h0 : ∀ P, 0 ≤ (B - T).coeff P := fun P => by
      rw [DivisorWithCoeffs.coeff_sub, hTdef, Divisor.coeff_toQDivisor,
        DivisorWithCoeffs.coeff_roundDown]
      have := Int.floor_le (B.coeff P)
      linarith
    have := genericFiberDegree_nonneg (g := r) h0
    calc genericFiberDegree r T ≤ genericFiberDegree r T + genericFiberDegree r (B - T) := by
          linarith
      _ = genericFiberDegree r B := by rw [← genericFiberDegree_add, ← e]
  -- `deg T > 0`
  have hTpos : 0 < genericFiberDegree r T := by
    obtain ⟨S, hSne, hSc, hsum⟩ := exists_finset_genericFiberDegree_eq_sum r hr.comp_eq hdim T (hq _)
    rw [hsum]
    refine Finset.sum_pos (fun C hC => ?_) hSne
    have hTe : T = (2 : ℚ) • ((Divisor.toQDivisor K + B) +
        (-1 : ℚ) • (Divisor.toQDivisor K + (B - (1 / 2 : ℚ) • T))) := by
      ext P
      simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
        DivisorWithCoeffs.coeff_sub, smul_eq_mul]
      ring
    have e1 : T.intersectionNumber ℂ sY C.ι C.dim_le (hq _) =
        ((2 : ℚ) • ((Divisor.toQDivisor K + B) +
          (-1 : ℚ) • (Divisor.toQDivisor K + (B - (1 / 2 : ℚ) • T)))).intersectionNumber ℂ sY
          C.ι C.dim_le (hq _) := by
      congr 1
    rw [e1, MMP.Fourfold.intersectionNumber_smul sY C.ι C.dim_le _ (hq _) 2 (hq _),
      MMP.Mori.QDivisor.intersectionNumber_add' ℂ sY C.ι C.dim_le _ _ (hq _) (hq _) (hq _),
      MMP.Fourfold.intersectionNumber_smul sY C.ι C.dim_le _ (hq _) (-1) (hq _),
      hnum C (hSc C hC)]
    have := hneg C (hSc C hC)
    nlinarith
  -- `deg T` is an integer
  obtain ⟨z, hz⟩ : ∃ z : ℤ, genericFiberDegree r T = z := by
    refine ⟨∑ E ∈ T.support, B.roundDown.coeff E * genericFiberPointDegree r E, ?_⟩
    rw [genericFiberDegree]
    push_cast
    refine Finset.sum_congr rfl fun E _ => ?_
    rw [hTdef, Divisor.coeff_toQDivisor]
  rw [hz] at hTpos hTB hne ⊢
  have h1 : (z : ℚ) ≤ 2 := le_trans hTB hB2
  have h2 : z ≤ 2 := by exact_mod_cast h1
  have h3 : 0 < z := by exact_mod_cast hTpos
  have h4 : z ≠ 1 := fun h => hne (by rw [h]; norm_num)
  have : z = 2 := by omega
  rw [this]; norm_num

end Fibration

section FloorDegree

open MMP.Mori

/-- The generic fibre degree of an integral divisor, as a sum over its components dominating the
base. -/
private theorem genericFiberDegree_toQDivisor {Y V : Scheme.{0}} [IrreducibleSpace V]
    (r : Y ⟶ V) (D : Divisor Y) :
    genericFiberDegree r (Divisor.toQDivisor D) =
      ((open scoped Classical in ∑ Q ∈ D.support with r.base Q.genericPoint = genericPoint V,
        D.coeff Q * (letI := (r.residueFieldMap Q.genericPoint).hom.toAlgebra
          (Module.finrank (V.residueField (r.base Q.genericPoint))
            (Y.residueField Q.genericPoint) : ℤ)) : ℤ) : ℚ) := by
  classical
  have hsupp : (Divisor.toQDivisor D).support = D.support := by
    ext Q
    simp only [Finsupp.mem_support_iff, ne_eq]
    have := Divisor.coeff_toQDivisor D Q
    rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply] at this
    rw [this]
    exact_mod_cast Iff.rfl
  rw [genericFiberDegree, hsupp, Finset.sum_filter]
  push_cast
  refine Finset.sum_congr rfl fun Q _ => ?_
  rw [Divisor.coeff_toQDivisor, genericFiberPointDegree]
  split_ifs <;> simp

/-- The degree of a dominant integral closed subscheme `F ⟶ Y` of a prime divisor `P` over the
base is the residue degree of `r` at the generic point of `P`. -/
private theorem finrank_functionField_eq_residueDegree_floor {Y V F : Scheme.{0}} [IsIntegral Y]
    [IsIntegral V] [IsIntegral F] (r : Y ⟶ V) (j : F ⟶ Y) [IsClosedImmersion j]
    [IsDominant (j ≫ r)] (P : Mori.PrimeDivisor Y)
    (hP : Set.range j.base = (P.support : Set Y)) :
    (letI := functionFieldMapAlgebra (j ≫ r)
     Module.finrank V.functionField F.functionField) = r.residueDegree P.genericPoint := by
  have h1 : (letI := functionFieldMapAlgebra (j ≫ r)
      Module.finrank V.functionField F.functionField) =
        (j ≫ r).residueDegree (genericPoint F) := by
    letI := functionFieldMapAlgebra (j ≫ r)
    letI := ((j ≫ r).residueFieldMap (genericPoint F)).hom.toAlgebra
    exact Algebra.finrank_eq_of_equiv_equiv (genericResidueEquivOfDominant (j ≫ r))
      (genericResidueEquiv F) (residueFieldMap_comp_genericResidueEquivOfDominant (j ≫ r))
  rw [h1, residueDegree_comp, Stacks.Chow.residueDegree_eq_one_of_isClosedImmersion j, mul_one,
    map_genericPoint_eq_of_range_eq j P hP]

/-- The degree of the horizontal floor written over integral closed subschemes on the floor
primes is the sum of the residue degrees at the floor primes dominating the base. -/
private theorem finsum_finrank_eq_sum_residueDegree {Y V : Scheme.{0}} [IsIntegral Y]
    [IsIntegral V] (r : Y ⟶ V) {B : QDivisor Y} (D : Divisor Y)
    (hBD : ∀ Q, B.coeff Q = 1 ↔ Q ∈ D.support)
    {F : {P : Mori.PrimeDivisor Y // B.coeff P = 1} → Scheme.{0}} [∀ P, IsIntegral (F P)]
    (j : ∀ P, F P ⟶ Y) [∀ P, IsClosedImmersion (j P)]
    (hj : ∀ P, Set.range (j P).base = (P.1.support : Set Y)) :
    (∑ᶠ (P : {P : Mori.PrimeDivisor Y // B.coeff P = 1}) (_ : IsDominant (j P ≫ r)),
      (letI : IsDominant (j P ≫ r) := ‹_›
       letI := functionFieldMapAlgebra (j P ≫ r)
       Module.finrank V.functionField (F P).functionField)) =
      (open scoped Classical in ∑ Q ∈ D.support with r.base Q.genericPoint = genericPoint V,
        (letI := (r.residueFieldMap Q.genericPoint).hom.toAlgebra;
          Module.finrank (V.residueField (r.base Q.genericPoint)) (Y.residueField Q.genericPoint))) := by
  classical
  let g : Mori.PrimeDivisor Y → ℕ := fun Q =>
    if r.base Q.genericPoint = genericPoint V then r.residueDegree Q.genericPoint else 0
  have hdom : ∀ P : {P : Mori.PrimeDivisor Y // B.coeff P = 1},
      IsDominant (j P ≫ r) ↔ r.base P.1.genericPoint = genericPoint V := by
    intro P
    have he : (j P ≫ r) (genericPoint (F P)) = r P.1.genericPoint := by
      rw [Scheme.Hom.comp_apply, map_genericPoint_eq_of_range_eq (j P) P.1 (hj P)]
    constructor
    · intro h
      rw [← he]
      exact MMP.Positivity.map_genericPoint_eq_of_isDominant _
    · intro h
      exact ⟨Dense.mono (Set.singleton_subset_iff.mpr ⟨_, he.trans h⟩)
        (dense_iff_closure_eq.mpr (genericPoint_spec V))⟩
  have key : ∀ P : {P : Mori.PrimeDivisor Y // B.coeff P = 1},
      (∑ᶠ (_ : IsDominant (j P ≫ r)),
        (letI : IsDominant (j P ≫ r) := ‹_›
         letI := functionFieldMapAlgebra (j P ≫ r)
         Module.finrank V.functionField (F P).functionField)) = g P.1 := by
    intro P
    rw [finsum_eq_dif]
    by_cases hd : IsDominant (j P ≫ r)
    · rw [dif_pos hd]
      simp only [g, if_pos ((hdom P).mp hd)]
      exact finrank_functionField_eq_residueDegree_floor r (j P) P.1 (hj P)
    · rw [dif_neg hd]
      simp only [g, if_neg (fun h => hd ((hdom P).mpr h))]
  rw [finsum_congr key]
  have hset : {Q : Mori.PrimeDivisor Y | B.coeff Q = 1} = (D.support : Set (Mori.PrimeDivisor Y)) := by
    ext Q
    exact hBD Q
  have h2 : (∑ᶠ P : {P : Mori.PrimeDivisor Y // B.coeff P = 1}, g P.1) =
      ∑ Q ∈ D.support, g Q := by
    rw [← finsum_mem_coe_finset, ← hset]
    exact finsum_set_coe_eq_finsum_mem {Q : Mori.PrimeDivisor Y | B.coeff Q = 1}
  rw [h2, Finset.sum_filter]
  rfl

end FloorDegree

end GenusFibre

namespace SteinCopy

open scoped WithZero

/-! ### Floor models and single adjunction steps -/

/-- **Orders under a valuation-preserving map of function fields.** If `φ : k(Z) → k(Y)` carries
`v_Q` to `v_{Q'}`, i.e. `v_{Q'} = v_Q ∘ φ`, then `ord_Q(φ x) = ord_{Q'}(x)`. -/
private theorem ord_eq_of_divisorialValuation_eq {Y Z : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    {Q : Mori.PrimeDivisor Y} {Q' : Mori.PrimeDivisor Z} (φ : Z.functionField →+* Y.functionField)
    (hv : ∀ g, Q'.divisorialValuation g = Q.divisorialValuation (φ g)) (x : Z.functionField) :
    Y.ord (φ x) Q.genericPoint = Z.ord x Q'.genericPoint := by
  by_cases hx : x = 0
  · rw [hx, map_zero, Scheme.ord_zero, Scheme.ord_zero]
    rfl
  have h1 := hv x
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hx,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero φ).mpr hx)] at h1
  have h2 := WithZero.exp_injective h1
  omega

/-! ### Sections pulled back from the base of the contraction -/

/-- **Pull-backs of sections of `qH`.** Let `f : X ⟶ R` be dominant, `M = f^*H` for a Cartier
divisor `H`, `k(K_X + B) = M`, and `w` a top form with `div w = K_X`. For a global section `φ`
of `𝒪_R(acH)`, the form `f^*φ · w^{⊗ akc}` is a section of `akc(K_X + B)`. -/
private theorem pullback_smul_formPow_mem_logPluricanonicalSections
    {X R : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R]
    (f : X ⟶ R) [IsDominant f] {H : Divisor R} (hH : H.IsCartier)
    {hfH : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ H.supp}
    {M : Divisor X} (hM : H.IsPullback f hfH M) {K : Divisor X} {B : QDivisor X} {k c a : ℕ}
    {u : X.functionField} (hu0 : u ≠ 0)
    (hMu : ∀ Γ : Mori.PrimeDivisor X,
      (X.ord u Γ.genericPoint : ℚ) = M.coeff Γ - k * (K.coeff Γ + B.coeff Γ))
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (hw : ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
      ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ)
    (hN : 0 < a * (k * c)) (φ : Γ(((a * c) • H).divisorialSheaf, ⊤)) :
    letI := functionFieldAlgebra sX
    (functionFieldMap f (divisorialSectionValue φ) * u ^ (a * c)) • formPowR sX w (a * (k * c)) ∈
      logPluricanonicalSections sX (n + 1) (a * (k * c)) B := by
  letI := functionFieldAlgebra sX
  refine ⟨fun h => absurd h (by simp), fun Γ _ hne => ?_⟩
  set g := functionFieldMap f (divisorialSectionValue φ) with hg
  have hgu0 : g * u ^ (a * c) ≠ 0 := by
    rintro h0
    exact hne (by simp [h0])
  have hg0 : g ≠ 0 := left_ne_zero_of_mul hgu0
  rw [Γ.ordForm_smul_of_topologicalKrullDim_eq hdim hgu0 (hw _ hN).1, (hw _ hN).2 Γ,
    Scheme.ord_mul hg0 (pow_ne_zero _ hu0), Scheme.ord_pow hu0]
  -- the coefficient of `⌊akc B⌋`
  have hB : (DivisorWithCoeffs.roundDown (((a * (k * c) : ℕ) : ℤ) • B)).coeff Γ =
      ((a * c : ℕ) : ℤ) * M.coeff Γ - ((a * (k * c) : ℕ) : ℤ) * K.coeff Γ -
        ((a * c : ℕ) : ℤ) * X.ord u Γ.genericPoint := by
    have h1 := hMu Γ
    rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul, Int.floor_eq_iff]
    simp only [zsmul_eq_mul]
    push_cast
    have hE : ((a : ℚ) * ((k : ℚ) * (c : ℚ))) * B.coeff Γ =
        (a : ℚ) * (c : ℚ) * (M.coeff Γ : ℚ) - (a : ℚ) * ((k : ℚ) * (c : ℚ)) * (K.coeff Γ : ℚ) -
          (a : ℚ) * (c : ℚ) * (X.ord u Γ.genericPoint : ℚ) := by
      linear_combination ((a : ℚ) * (c : ℚ)) * h1
    constructor <;> linarith
  rw [hB]
  -- a local equation of `H` at the image of the generic point of `Γ`
  obtain ⟨U, hU, e, he⟩ := hH (f Γ.genericPoint)
  haveI : Nonempty U := ⟨⟨_, hU⟩⟩
  obtain ⟨h, -, hh⟩ := exists_divisorialSectionValue_eq he (a * c) φ
  have hMΓ := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hM he Γ hU (univComponent R)
  set v := MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
    ((e : RationalFunctions R)) with hv
  have hv0 : v ≠ 0 := (e.isUnit.map _).ne_zero
  have hinv : _ = v⁻¹ ^ (a * c) := evalFF_inv_pow e (a * c)
  rw [hinv] at hh
  haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨Γ.genericPoint, hU⟩⟩
  have hgh : g = X.germToFunctionField (f ⁻¹ᵁ U) (f.appLE U (f ⁻¹ᵁ U) le_rfl h) *
      (functionFieldMap f v)⁻¹ ^ (a * c) := by
    rw [hg, hh, map_mul, MMP.Spreading.functionFieldMap_germToFunctionField f U (f ⁻¹ᵁ U) le_rfl, map_pow,
      map_inv₀]
  have hfu0 : functionFieldMap f v ≠ 0 := (map_ne_zero _).mpr hv0
  have hh0 : X.germToFunctionField (f ⁻¹ᵁ U) (f.appLE U (f ⁻¹ᵁ U) le_rfl h) ≠ 0 := by
    intro h0
    apply hg0
    rw [hgh, h0, zero_mul]
  rw [hgh, Scheme.ord_mul hh0 (pow_ne_zero _ (inv_ne_zero hfu0)),
    MMP.Flips.ord_inv_pow hfu0, ← hMΓ]
  have := ord_germToFunctionField_nonneg Γ hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h)
  push_cast
  nlinarith

/-- A function on `U` invertible on its basic open has order zero along every prime divisor
meeting that basic open. -/
private theorem ord_germToFunctionField_eq_zero {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : Mori.PrimeDivisor Y) {U : Y.Opens} [Nonempty U]
    (s : Γ(Y, U)) (hE : (E.support ∩ (Y.basicOpen s : Set Y)).Nonempty) :
    Y.ord (Y.germToFunctionField U s) E.genericPoint = 0 := by
  obtain ⟨y, hyE, hys⟩ := hE
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyE
  have hgen : E.genericPoint ∈ Y.basicOpen s :=
    ((Y.basicOpen s).isOpen.stableUnderGeneralization)
      (specializes_iff_mem_closure.mpr hyE) hys
  have hgU : E.genericPoint ∈ U := Y.basicOpen_le s hgen
  have hu : IsUnit (Y.presheaf.germ U E.genericPoint hgU s) :=
    (Y.mem_basicOpen s E.genericPoint hgU).mp hgen
  rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := Y) hgU s]
  exact Mori.PrimeDivisor.ord_algebraMap_of_isUnit E hu

/-- **The residue of a pulled-back section.** Let `φ = h e^{-ar}` on `U` be a global section of
`𝒪_R(arH)`, `e` a local equation of `H` on `U`, and `T ⟶ X` an adjunction step whose generic
point lies over `U`. If the generator `f^*e^{-r} w^{⊗kr}` has residue `c₁ ω^{⊗kr}` along `T`,
then `f^*φ · w^{⊗akr}` has residue `h|_T · c₁^a ω^{⊗akr}`. -/
private theorem isPoincareResidue_pullback_smul_formPowR
    {X R : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R] (f : X ⟶ R) [IsDominant f]
    {B : QDivisor X} {T : Scheme.{0}} [IsIntegral T] {jT : T ⟶ X} {BT : QDivisor T}
    (hj : IsAdjunctionStep sX B jT BT) {D : Divisor R} {U : R.Opens} [Nonempty U]
    (hU : f (jT (genericPoint T)) ∈ U) {e : (RationalFunctions R)ˣ} {r a k : ℕ} (ha : 0 < a)
    (u : X.functionField)
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (φ : Γ(D.divisorialSheaf, ⊤)) (h : Γ(R, U))
    (hφ : divisorialSectionValue φ = R.germToFunctionField U h *
      (MMP.Threefold.Mori.Helpers.evalFF (univComponent R) (e : RationalFunctions R))⁻¹ ^ (a * r))
    (ω : letI := functionFieldAlgebra (jT ≫ sX); ⋀[T.functionField]^n Ω[T.functionField⁄ℂ])
    (c₁ : T.functionField)
    (hρ : IsPoincareResidue sX jT n (k * r)
      (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r))
      (c₁ • formPowR (jT ≫ sX) ω (k * r))) :
    haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hU⟩⟩
    IsPoincareResidue sX jT n (a * (k * r))
      ((functionFieldMap f (divisorialSectionValue φ) * u ^ (a * r)) • formPowR sX w (a * (k * r)))
      (((jT.stalkMap (genericPoint T)).hom (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU
        (f.appLE U (f ⁻¹ᵁ U) le_rfl h)) * c₁ ^ a) • formPowR (jT ≫ sX) ω (a * (k * r))) := by
  haveI : Nonempty (f ⁻¹ᵁ U) := ⟨⟨_, hU⟩⟩
  letI := functionFieldAlgebra sX
  have hY : topologicalKrullDim X = n + 1 := by rw [hdim]; norm_cast
  have hpow := isPoincareResidue_smul_formPowR_pow hj hY w _ ω c₁ hρ a ha
  have hres := MMP.CyclicChartDifferent.Aux.IsPoincareResidue.algebraMap_smul hpow
    (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h))
  have hg : functionFieldMap f (divisorialSectionValue φ) * u ^ (a * r) =
      algebraMap (X.presheaf.stalk (jT (genericPoint T))) X.functionField
        (X.presheaf.germ (f ⁻¹ᵁ U) (jT (genericPoint T)) hU (f.appLE U (f ⁻¹ᵁ U) le_rfl h)) *
      (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (e : RationalFunctions R)))⁻¹ * u) ^ r) ^ a := by
    rw [hφ, map_mul, MMP.Spreading.functionFieldMap_germToFunctionField f U (f ⁻¹ᵁ U) le_rfl,
      map_pow, map_inv₀, ← pow_mul, mul_comm r a, mul_pow, mul_assoc]
    congr 1
    exact (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hU _).symm
  rw [hg, mul_smul, mul_smul]
  exact hres

/-! ### Small facts about the contraction -/

section Setup

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} {B : QDivisor X}
  {C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0}}
  [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
  {j : ∀ P, C P ⟶ X} {BC : ∀ P, QDivisor (C P)} {m : ℕ}

variable (sX j BC) in
/-- `s`, a rational `am`-canonical form on `X`, lifts the `a`-th power of the floor system `t`
(in degree `m`): along every floor `j_P`, if `t_P = c · ω^{⊗m}` then the Poincaré residue of `s` is
`c^a · ω^{⊗am}`. -/
private def LiftsPow (t : ∀ P, logPluricanonicalSections (j P ≫ sX) n m (BC P)) (a : ℕ)
    (s : RationalPluriForms sX (n + 1) ((a * m : ℕ) : ℤ)) : Prop :=
  ∀ P, letI := functionFieldAlgebra (j P ≫ sX)
    ∀ (ω : ⋀[(C P).functionField]^n Ω[(C P).functionField⁄ℂ]) (c : (C P).functionField),
      (t P : RationalPluriForms (j P ≫ sX) n m) =
          c • (formPow ω m : RationalPluriForms (j P ≫ sX) n m) →
        IsPoincareResidue sX (j P) n (a * m) s
          (c ^ a • (formPow ω (a * m) : RationalPluriForms (j P ≫ sX) n ((a * m : ℕ) : ℤ)))

/-- **Lifts of an admissible floor system are preadmissible.** A section of `am(K_X + B)` whose
Poincaré residue along every floor component is the `a`-th power of one admissible floor system is
preadmissible. -/
private theorem mem_preadmissibleSections_of_liftsPow [CompactSpace X]
    (hX : Mori.IsProjectiveVariety ℂ sX) (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set X))
    (RS : ResidueRestriction (fun P => j P ≫ sX) BC n m)
    {t : ∀ P, logPluricanonicalSections (j P ≫ sX) n m (BC P)} (ht : t ∈ admissibleSections RS)
    {a : ℕ} (RX : ResidueRestriction (fun _ : Unit => sX) (fun _ => B) (n + 1) (a * m))
    (s : ∀ _ : Unit, logPluricanonicalSections sX (n + 1) (a * m) B)
    (hs : LiftsPow sX j BC t a (s () : RationalPluriForms sX (n + 1) ((a * m : ℕ) : ℤ))) :
    s ∈ preadmissibleSections RX := by
  classical
  haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
  have ha0 : 0 < a := Nat.pos_of_mul_pos_right RX.setting.pos
  have hcanX : ∀ {S : Scheme.{0}} {ι : S ⟶ X} {BS : QDivisor S}
      (F : StratumAdjunctionData sX B ι BS),
      haveI := F.isIntegral_stratum
      haveI := F.isNormal_stratum
      haveI := F.isLocallyNoetherian_stratum
      ∃ (d : ℕ) (K : Divisor S), K.IsCanonicalDivisor (ι ≫ sX) d ∧
        (Divisor.toQDivisor K + BS).IsQCartier := by
    intro S ι BS F
    obtain ⟨d, K, hK, hKC⟩ := RX.setting.isCartierDivisor () F
    exact ⟨d, K, hK, ⟨((a * m : ℕ) : ℤ), by exact_mod_cast RX.setting.pos.ne', hKC⟩⟩
  intro i i' S S' ι ι' BS BS' F F' e h₁ h₂ hdS hdS' σ hσ
  cases i
  cases i'
  change StratumAdjunctionData sX B ι BS at F
  change StratumAdjunctionData sX B ι' BS' at F'
  haveI := F.isIntegral_stratum
  haveI := F.isNormal_stratum
  haveI := F.isLocallyNoetherian_stratum
  haveI := F'.isIntegral_stratum
  haveI := F'.isNormal_stratum
  haveI := F'.isLocallyNoetherian_stratum
  haveI : LocallyOfFiniteType (ι ≫ sX) := F.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι' ≫ sX) := F'.isNormalVariety.1.toLocallyOfFiniteType
  obtain ⟨P, S₁, ι₁, BS₁, F₁, ψ, hl₁, -, -, hrest₁⟩ :=
    exists_flagMatch hX hdim hC RS.setting hcanX F h₁
  obtain ⟨P', S₂, ι₂, BS₂, F₂, ψ', hl₂, -, -, hrest₂⟩ :=
    exists_flagMatch hX hdim hC RS.setting hcanX F' h₂
  haveI := F₁.isIntegral_stratum
  haveI := F₁.isNormal_stratum
  haveI := F₁.isLocallyNoetherian_stratum
  haveI := F₂.isIntegral_stratum
  haveI := F₂.isNormal_stratum
  haveI := F₂.isLocallyNoetherian_stratum
  haveI : LocallyOfFiniteType (ι₁ ≫ j P ≫ sX) := F₁.isNormalVariety.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (ι₂ ≫ j P' ≫ sX) := F₂.isNormalVariety.1.toLocallyOfFiniteType
  obtain ⟨σψ, -, hσψc, hres⟩ := hrest₁
  obtain ⟨σψ', -, hσψc', hres'⟩ := hrest₂
  -- the matched strata have dimension `e`
  have hdim₁ : ∀ (Q : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) {T : Scheme.{0}}
      {ιT : T ⟶ C Q} {BT : QDivisor T} (G : StratumAdjunctionData (j Q ≫ sX) (BC Q) ιT BT)
      {T₀ : Scheme.{0}} {ι₀ : T₀ ⟶ X} {B₀ : QDivisor T₀} (G₀ : StratumAdjunctionData sX B ι₀ B₀),
      G.length + 1 = G₀.length → topologicalKrullDim T₀ = e →
      haveI := G.isIntegral_stratum
      topologicalKrullDim T = e := by
    intro Q T ιT BT G T₀ ι₀ B₀ G₀ hl hT₀
    haveI := G.isIntegral_stratum
    haveI : LocallyOfFiniteType (ιT ≫ j Q ≫ sX) := G.isNormalVariety.1.toLocallyOfFiniteType
    have e1 := StratumAdjunctionData.dim_add_length (sX := sX) hdim G₀ hT₀
    have e2 := StratumAdjunctionData.dim_add_length (sX := j Q ≫ sX)
      (RS.setting.topologicalKrullDim_eq Q) G (topologicalKrullDim_eq_toNat_trdeg (ιT ≫ j Q ≫ sX))
    rw [topologicalKrullDim_eq_toNat_trdeg (ιT ≫ j Q ≫ sX)]
    congr 1
    norm_cast
    omega
  have hdS₁ : topologicalKrullDim S₁ = e := hdim₁ P F₁ F hl₁ hdS
  have hdS₂ : topologicalKrullDim S₂ = e := hdim₁ P' F₂ F' hl₂ hdS'
  -- the residue of `s` along `F` is read off the residue of `t_P` along `F₁`
  have hread : ∀ (Q : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}) {T : Scheme.{0}}
      {ιT : T ⟶ C Q} {BT : QDivisor T} (G : StratumAdjunctionData (j Q ≫ sX) (BC Q) ιT BT)
      {T₀ : Scheme.{0}} {ι₀ : T₀ ⟶ X} {B₀ : QDivisor T₀} (G₀ : StratumAdjunctionData sX B ι₀ B₀),
      haveI := G.isIntegral_stratum
      haveI := G₀.isIntegral_stratum
      topologicalKrullDim T = e → topologicalKrullDim T₀ = e →
      ∀ (τ : FunctionFieldEquiv (ι₀ ≫ sX) (ιT ≫ j Q ≫ sX)),
      (∀ (N : ℕ) (ζ : RationalPluriForms sX (n + 1) N) (ρQ : RationalPluriForms (j Q ≫ sX) n N),
        IsPoincareResidue sX (j Q) n N ζ ρQ → ∀ (e' : ℕ), topologicalKrullDim T₀ = e' →
        ∀ ρ' : RationalPluriForms (ιT ≫ j Q ≫ sX) e' N, IsIteratedResidueRec ρQ G e' ρ' →
          IsIteratedResidueRec ζ G₀ e' (pluriformPullback (ι₀ ≫ sX) (ιT ≫ j Q ≫ sX) τ.toHom e' N ρ')) →
      letI := functionFieldAlgebra (ιT ≫ j Q ≫ sX)
      ∀ (b : Module.Basis Unit T.functionField (⋀[T.functionField]^e Ω[T.functionField⁄ℂ]))
        (c₁ : T.functionField),
        RS.toFun Q G e (t Q) = c₁ • (formPow (b ()) m : RationalPluriForms (ιT ≫ j Q ≫ sX) e m) →
        RX.toFun () G₀ e (s ()) = pluriformPullback (ι₀ ≫ sX) (ιT ≫ j Q ≫ sX) τ.toHom e
          ((a * m : ℕ) : ℤ) (c₁ ^ a • (formPow (b ()) (a * m) :
            RationalPluriForms (ιT ≫ j Q ≫ sX) e ((a * m : ℕ) : ℤ))) := by
    intro Q T ιT BT G T₀ ι₀ B₀ G₀ hT hT₀ τ hresG b c₁ hc₁
    haveI := G.isIntegral_stratum
    haveI := G₀.isIntegral_stratum
    letI := functionFieldAlgebra (j Q ≫ sX)
    letI := functionFieldAlgebra (ιT ≫ j Q ≫ sX)
    haveI : LocallyOfFiniteType (j Q ≫ sX) :=
      (RS.setting.isPair Q).isPair.isNormalVariety.1.toLocallyOfFiniteType
    obtain ⟨b₀⟩ := exists_basis_topForms (sX := j Q ≫ sX) (RS.setting.topologicalKrullDim_eq Q)
    set c := (ZTensorPower.basis b₀ m).repr (t Q : RationalPluriForms (j Q ≫ sX) n m) ()
    have htQ : (t Q : RationalPluriForms (j Q ≫ sX) n m) = c • formPow (b₀ ()) m :=
      eq_repr_smul_formPow b₀ _
    have hIt := (RS.isIteratedResidue Q G e (t Q) hT).rec'
    rw [hc₁, htQ] at hIt
    have hpow := isIteratedResidueRec_pow (b₀ ()) c G hT (b ()) c₁ hIt a ha0
    have hsQ := hs Q (b₀ ()) c htQ
    have h1 := hresG (a * m) (s ()) _ hsQ e hT₀ _ hpow
    exact IsIteratedResidueRec.unique G₀ (RX.isIteratedResidue () G₀ e (s ()) hT₀).rec' h1
  letI := functionFieldAlgebra (ι₁ ≫ j P ≫ sX)
  letI := functionFieldAlgebra (ι₂ ≫ j P' ≫ sX)
  obtain ⟨b₁⟩ := exists_basis_topForms (sX := ι₁ ≫ j P ≫ sX) hdS₁
  obtain ⟨b₂⟩ := exists_basis_topForms (sX := ι₂ ≫ j P' ≫ sX) hdS₂
  set c₁ := (ZTensorPower.basis b₁ m).repr (RS.toFun P F₁ e (t P)) ()
  set c₂ := (ZTensorPower.basis b₂ m).repr (RS.toFun P' F₂ e (t P')) ()
  have hc₁ : RS.toFun P F₁ e (t P) =
      c₁ • (formPow (b₁ ()) m : RationalPluriForms (ι₁ ≫ j P ≫ sX) e m) :=
    eq_repr_smul_formPow b₁ _
  have hc₂ : RS.toFun P' F₂ e (t P') =
      c₂ • (formPow (b₂ ()) m : RationalPluriForms (ι₂ ≫ j P' ≫ sX) e m) :=
    eq_repr_smul_formPow b₂ _
  beta_reduce
  rw [hread P F₁ F hdS₁ hdS σψ hres b₁ c₁ hc₁, hread P' F₂ F' hdS₂ hdS' σψ' hres' b₂ c₂ hc₂]
  -- the crepant map `σ̃ = σψ⁻¹ ∘ σ ∘ σψ'` between the matched strata
  letI := functionFieldAlgebra (ι ≫ sX)
  letI := functionFieldAlgebra (ι' ≫ sX)
  set σt : FunctionFieldEquiv (ι₁ ≫ j P ≫ sX) (ι₂ ≫ j P' ≫ sX) := σψ'.trans (σ.trans σψ.symm)
  have hσt : IsCrepantBirationalMap (ι₁ ≫ j P ≫ sX) (ι₂ ≫ j P' ≫ sX) BS₁ BS₂ σt :=
    (hσψc.symm.trans hσ).trans hσψc'
  have hadm := ht P P' F₁ F₂ e (Nat.zero_le _) (Nat.zero_le _) hdS₁ hdS₂ σt hσt
  beta_reduce at hadm
  rw [hc₁, hc₂, pluriformPullback_smul_formPow' hdS₁ hdS₂ σt.toHom (b₂ ()) m c₂] at hadm
  have hpw : (c₁ ^ a • (formPow (b₁ ()) (a * m) :
      RationalPluriForms (ι₁ ≫ j P ≫ sX) e ((a * m : ℕ) : ℤ))) =
      pluriformPullback (ι₁ ≫ j P ≫ sX) (ι₂ ≫ j P' ≫ sX) σt.toHom e ((a * m : ℕ) : ℤ)
        (c₂ ^ a • (formPow (b₂ ()) (a * m) :
          RationalPluriForms (ι₂ ≫ j P' ≫ sX) e ((a * m : ℕ) : ℤ))) := by
    rw [pluriformPullback_smul_formPow' hdS₁ hdS₂ σt.toHom (b₂ ()) (a * m) (c₂ ^ a),
      map_pow (σt.toHom) c₂ a]
    exact (smul_formPow_pow_eq b₁ hadm a).symm
  have key : ∀ y : RationalPluriForms (ι₂ ≫ j P' ≫ sX) e ((a * m : ℕ) : ℤ),
      pluriformPullback (ι ≫ sX) (ι' ≫ sX) σ.toHom e ((a * m : ℕ) : ℤ)
        (pluriformPullback (ι' ≫ sX) (ι₂ ≫ j P' ≫ sX) σψ'.toHom e ((a * m : ℕ) : ℤ) y) =
      pluriformPullback (ι ≫ sX) (ι₁ ≫ j P ≫ sX) σψ.toHom e ((a * m : ℕ) : ℤ)
        (pluriformPullback (ι₁ ≫ j P ≫ sX) (ι₂ ≫ j P' ≫ sX) σt.toHom e ((a * m : ℕ) : ℤ) y) := by
    intro y
    have hh : (σ.toHom).comp (σψ'.toHom) = (σψ.toHom).comp (σt.toHom) := by
      ext x
      change σ (σψ' x) = σψ (σψ.symm (σ (σψ' x)))
      rw [AlgEquiv.apply_symm_apply]
    rw [pluriformPullback_comp hdS hdS' hdS₂, pluriformPullback_comp hdS hdS₁ hdS₂, hh]
  rw [hpw]
  exact key _

end Setup

open CategoryTheory.Limits in

open Opposite in

open CategoryTheory.Limits Opposite in

/-- A prime divisor is determined by its support. -/
private theorem primeDivisor_eq_of_support_eq {X : Scheme.{0}} {P Q : Mori.PrimeDivisor X}
    (h : (P.support : Set X) = Q.support) : P = Q := by
  refine AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
    AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
  exact (inseparable_iff_closure_eq.2 h).eq

/-- **The normalization components of the floor are the floor components.** If the components
`νᵢ : Tᵢ ⟶ S` of a normalization of the reduced floor `S = ⌊B⌋` are adjunction steps onto the
floor primes, each floor prime being the image of exactly one of them, then they are indexed by the
floor primes and each `Tᵢ` is isomorphic over `X` to the given normal model `C_P`. -/
private theorem exists_equiv_iso_floorComponents {k : Type} [Field k] {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} {B : QDivisor X}
    {S : Scheme.{0}} (ιS : S ⟶ X)
    {hfin : ∀ U : S.Opens, IsCompact (U : Set S) → (irreducibleComponents U).Finite}
    (N : MMP.Flips.NormalizationComponents (ιS ≫ sX) hfin) {Θ : ∀ i, QDivisor (N.X i)}
    (hadj : ∀ i, IsAdjunctionStep sX B (N.n i ≫ ιS) (Θ i))
    (hbij : ∀ P ∈ B.roundDown.support, ∃! i, Set.range (N.n i ≫ ιS).base = (P.support : Set X))
    (C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    (j : ∀ P, C P ⟶ X) (BC : ∀ P, QDivisor (C P))
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set X)) :
    ∃ π : N.ι ≃ {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0},
      ∀ i, Set.range (N.n i ≫ ιS).base = ((π i).1.support : Set X) ∧
        ∃ p : C (π i) ≅ N.X i, p.hom ≫ N.n i ≫ ιS = j (π i) := by
  classical
  have hP : ∀ i, ∃ P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0},
      Set.range (N.n i ≫ ιS).base = (P.1.support : Set X) := by
    intro i
    obtain ⟨-, P, hP1, hPr, -⟩ := hadj i
    refine ⟨⟨P, ?_⟩, hPr⟩
    have : (1 : ℤ) ≤ ⌊B.coeff P⌋ := Int.le_floor.mpr (by exact_mod_cast hP1)
    omega
  choose π₀ hπ₀ using hP
  have hmem : ∀ P : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0}, P.1 ∈ B.roundDown.support := by
    intro P
    rw [Finsupp.mem_support_iff]
    have := P.2
    rwa [← DivisorWithCoeffs.coeff_roundDown] at this
  have hinj : Function.Injective π₀ := by
    intro i i' h
    obtain ⟨i₀, -, hu⟩ := hbij (π₀ i).1 (hmem _)
    have h1 := hu i (hπ₀ i)
    have h2 := hu i' (show Set.range (N.n i' ≫ ιS).base = ((π₀ i).1.support : Set X) by
      rw [hπ₀ i', h])
    rw [h1, h2]
  have hsurj : Function.Surjective π₀ := by
    intro P
    obtain ⟨i, hi, -⟩ := hbij P.1 (hmem P)
    refine ⟨i, Subtype.ext (primeDivisor_eq_of_support_eq ?_)⟩
    rw [← hπ₀ i, hi]
  refine ⟨Equiv.ofBijective π₀ ⟨hinj, hsurj⟩, fun i => ⟨hπ₀ i, ?_⟩⟩
  change ∃ p : C (π₀ i) ≅ N.X i, p.hom ≫ N.n i ≫ ιS = j (π₀ i)
  obtain ⟨-, -, -, -, hci, -⟩ := hadj i
  obtain ⟨-, -, -, -, hcj, -⟩ := (hC (π₀ i)).1
  haveI := hci
  haveI := hcj
  obtain ⟨ψ, hψ⟩ := exists_iso_comp_eq_of_range_eq (j (π₀ i)) (N.n i ≫ ιS)
    (by rw [(hC (π₀ i)).2, hπ₀ i])
  exact ⟨ψ, hψ⟩

/-- **Reindexing a residue-restriction system** along an equivalence of index types. -/
private def residueRestrictionReindex {k : Type u} [Field k] {I J : Type*} {X : I → Scheme.{u}}
    {sX : ∀ i, X i ⟶ Spec (.of k)} [∀ i, IsIntegral (X i)] [∀ i, IsLocallyNoetherian (X i)]
    [∀ i, IsNormal (X i)] {B : ∀ i, QDivisor (X i)} {n m : ℕ} (R : ResidueRestriction sX B n m)
    (π : J ≃ I) : ResidueRestriction (fun j => sX (π j)) (fun j => B (π j)) n m where
  setting :=
    { finite := by haveI := R.setting.finite; exact Finite.of_equiv I π.symm
      isProjectiveVariety := fun j => R.setting.isProjectiveVariety (π j)
      isPair := fun j => R.setting.isPair (π j)
      isDltPair := fun j => R.setting.isDltPair (π j)
      topologicalKrullDim_eq := fun j => R.setting.topologicalKrullDim_eq (π j)
      even := R.setting.even
      pos := R.setting.pos
      isCartierDivisor := fun j => R.setting.isCartierDivisor (π j) }
  toFun j := R.toFun (π j)
  isIteratedResidue j := R.isIteratedResidue (π j)

/-- Reindexing preserves admissibility. -/
private theorem mem_admissibleSections_reindex {k : Type u} [Field k] {I J : Type*}
    {X : I → Scheme.{u}} {sX : ∀ i, X i ⟶ Spec (.of k)} [∀ i, IsIntegral (X i)]
    [∀ i, IsLocallyNoetherian (X i)] [∀ i, IsNormal (X i)] {B : ∀ i, QDivisor (X i)} {n m : ℕ}
    (R : ResidueRestriction sX B n m) (π : J ≃ I)
    {s : ∀ i, logPluricanonicalSections (sX i) n m (B i)} (hs : s ∈ admissibleSections R) :
    (fun j => s (π j)) ∈ admissibleSections (residueRestrictionReindex R π) :=
  fun j j' _ _ _ _ _ _ F F' e h₁ h₂ h₃ h₄ σ hσ => hs (π j) (π j') F F' e h₁ h₂ h₃ h₄ σ hσ

/-- **Residue-restriction systems along equal structure morphisms.** -/
private theorem exists_residueRestriction_congr {k : Type u} [Field k] {I : Type*}
    {X : I → Scheme.{u}} [∀ i, IsIntegral (X i)] [∀ i, IsLocallyNoetherian (X i)]
    [∀ i, IsNormal (X i)] {sX sX' : ∀ i, X i ⟶ Spec (.of k)} (h : sX = sX')
    {B : ∀ i, QDivisor (X i)} {n m : ℕ} (R : ResidueRestriction sX' B n m)
    (s : ∀ i, logPluricanonicalSections (sX' i) n m (B i)) (hs : s ∈ admissibleSections R) :
    ∃ (R' : ResidueRestriction sX B n m) (s' : ∀ i, logPluricanonicalSections (sX i) n m (B i)),
      s' ∈ admissibleSections R' ∧ ∀ i, HEq (s' i : RationalPluriForms (sX i) n m)
        (s i : RationalPluriForms (sX' i) n m) := by
  subst h
  exact ⟨R, s, hs, fun _ => HEq.rfl⟩

/-- A unit of the local ring at the generic point of a prime divisor has order zero along it,
for any spelling `x = η_P` of that point. -/
private theorem ord_algebraMap_stalk_eq_zero_of_isUnit {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (P : Mori.PrimeDivisor Y) {x : Y}
    (hx : x = P.genericPoint) {u : Y.presheaf.stalk x} (hu : IsUnit u) :
    Y.ord (algebraMap _ Y.functionField u) P.genericPoint = 0 := by
  subst hx
  exact P.ord_algebraMap_of_isUnit hu

/-- A germ at the image of the generic point of an integral closed subscheme `j : T ⟶ Y` whose
restriction to `T` is nonzero is a unit: the stalk of `T` at its generic point is a field. -/
private theorem isUnit_of_stalkMap_genericPoint_ne_zero {Y T : Scheme.{0}} [IsIntegral T]
    (j : T ⟶ Y) {g : Y.presheaf.stalk (j (genericPoint T))}
    (hg : (j.stalkMap (genericPoint T)).hom g ≠ 0) : IsUnit g := by
  have hfield : IsField (T.presheaf.stalk (genericPoint T)) := by
    have := RationalFunctions.isField_stalk T ⟨Set.univ, univ_mem_irreducibleComponents T⟩
    rwa [componentGenericPoint_eq_genericPoint] at this
  letI := hfield.toField
  exact isUnit_of_map_unit (j.stalkMap (genericPoint T)).hom g (isUnit_iff_ne_zero.mpr hg)

/-- **Residues of forms with a pole of full order are nonzero.** Let `j : T ⟶ Y` be a closed
immersion of integral schemes onto a prime divisor `P` of the normal variety `Y` of dimension
`e + 1`, and `σ` a top form with a simple pole along `P` and a nonzero residue. Every
rational `m`-canonical form `τ ≠ 0` with `ord_P τ = -m` has a Poincaré residue along `P`, and
that residue is nonzero. -/
private theorem exists_isPoincareResidue_ne_zero_of_ordForm_eq {Y T : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    {e : ℕ} (hd : topologicalKrullDim Y = (e + 1 : ℕ)) [IsIntegral T] [IsLocallyNoetherian T]
    [IsNormal T] {j : T ⟶ Y} [LocallyOfFiniteType (j ≫ sY)]
    (hdT : topologicalKrullDim T = e)
    (P : Mori.PrimeDivisor Y) (hP : j (genericPoint T) = P.genericPoint)
    {σ : RationalPluriForms sY (e + 1) 1} (hσ0 : σ ≠ 0) (hσP : P.ordForm σ = -1)
    {ρσ : RationalPluriForms (j ≫ sY) e 1} (hρσ : IsPoincareResidue sY j e 1 σ ρσ)
    (hρσ0 : ρσ ≠ 0) {m : ℕ} (τ : RationalPluriForms sY (e + 1) m) (hτ0 : τ ≠ 0)
    (hτP : P.ordForm τ = -(m : ℤ)) :
    ∃ ρ : RationalPluriForms (j ≫ sY) e m, IsPoincareResidue sY j e m τ ρ ∧ ρ ≠ 0 := by
  classical
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra (j ≫ sY)
  obtain ⟨t, g₀, x, ht, hg₀u, hσeq, hρσeq, hall⟩ := exists_logFrame hd P hP hσ0 hσP hρσ hρσ0
  obtain ⟨h, hh⟩ := hall m τ (fun _ => hτP.ge)
  set ω₀ := logFrame sY j t x with hω₀def
  have hpow0 : ∀ (ω : ⋀[Y.functionField]^(e + 1) Ω[Y.functionField⁄ℂ]) (a : ℕ), 0 < a →
      ω = 0 → (formPow ω a : RationalPluriForms sY (e + 1) a) = 0 := by
    intro ω a ha hω
    rw [show ω = (0 : Y.functionField) • ω by rw [hω, smul_zero], formPow_smul,
      zero_pow ha.ne', zero_smul]
  have hω₀ : ω₀ ≠ 0 := by
    intro h0
    apply hσ0
    rw [hσeq, hpow0 ω₀ 1 one_pos h0, smul_zero]
    rfl
  have hunit_ord : ∀ u : Y.presheaf.stalk (j (genericPoint T)), IsUnit u →
      Y.ord (algebraMap _ Y.functionField u) P.genericPoint = 0 :=
    fun _ hu => ord_algebraMap_stalk_eq_zero_of_isUnit P hP hu
  have hg₀ne : algebraMap _ Y.functionField g₀ ≠ 0 := (hg₀u.map _).ne_zero
  have hσord := ordForm_smul_formPow hd P hω₀ hg₀ne 1
  rw [← hσeq, hσP, hunit_ord g₀ hg₀u] at hσord
  have hω₀ord : P.ordForm (show RationalPluriForms sY (e + 1) 1 from formPow ω₀ 1) = -1 := by
    have h1 := hσord
    simp only [Nat.cast_one, one_mul, zero_add] at h1
    exact h1.symm
  have hh0 : algebraMap _ Y.functionField h ≠ 0 := by
    intro h0
    apply hτ0
    rw [hh, h0, zero_smul]
    rfl
  have hτord := ordForm_smul_formPow hd P hω₀ hh0 m
  rw [← hh, hτP, hω₀ord] at hτord
  have hhord : Y.ord (algebraMap _ Y.functionField h) P.genericPoint = 0 := by omega
  obtain ⟨v, hv, hvh⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero
    (j (genericPoint T)) hh0 fun Γ hΓ => by
      rw [hP] at hΓ
      obtain rfl := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ
      exact hhord
  have hvh' : v = h := IsFractionRing.injective _ Y.functionField hvh
  subst hvh'
  refine ⟨(j.stalkMap (genericPoint T)).hom v • formPow (resFrame sY j x) m,
    hh ▸ isPoincareResidue_smul_formPow_logFrame sY j ht x v, ?_⟩
  have hres0 : resFrame sY j x ≠ 0 := by
    intro h0
    apply hρσ0
    rw [hρσeq]
    have : (formPow (resFrame sY j x) 1 : RationalPluriForms (j ≫ sY) e 1) = 0 := by
      rw [show resFrame sY j x = (0 : T.functionField) • resFrame sY j x by rw [h0, smul_zero],
        formPow_smul, zero_pow one_ne_zero, zero_smul]
    rw [this, smul_zero]
    rfl
  exact smul_formPow_ne_zero hdT hres0 ((hv.map _).ne_zero) m

/-- An integral locally Noetherian normal scheme with a point other than its generic point has a
prime divisor: a minimal prime over a nonzero element of the maximal ideal of the local ring at
that point has height one by Krull's principal ideal theorem. -/
private theorem nonempty_primeDivisor_of_ne_genericPoint {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {x : X} (hx : x ≠ genericPoint X) :
    Nonempty (MMP.Mori.PrimeDivisor X) := by
  set R := X.presheaf.stalk x
  have hm : IsLocalRing.maximalIdeal R ≠ ⊥ := by
    intro h0
    have hη : genericPoint X ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]
      exact (genericPoint_spec X).specializes trivial
    have hx' : x ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]
      exact specializes_rfl
    obtain ⟨p₁, hp₁⟩ := hη
    obtain ⟨p₂, hp₂⟩ := hx'
    have hall : ∀ p : PrimeSpectrum R, p.asIdeal = ⊥ := fun p =>
      le_bot_iff.mp (h0 ▸ IsLocalRing.le_maximalIdeal p.2.ne_top)
    have : p₁ = p₂ := PrimeSpectrum.ext ((hall p₁).trans (hall p₂).symm)
    exact hx (by rw [← hp₂, ← this, hp₁])
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
  have hle : Ideal.span {a} ≤ IsLocalRing.maximalIdeal R :=
    (Ideal.span_singleton_le_iff_mem _).mpr ha
  obtain ⟨q, hq, -⟩ := Ideal.exists_minimalPrimes_le hle
  haveI : q.IsPrime := hq.1.1
  have h1 : q.height ≤ 1 := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ q hq
  have h0 : q.height ≠ 0 := by
    rw [Ne, Ideal.height_eq_zero_iff_eq_bot]
    intro hq0
    exact ha0 (by
      have : a ∈ q := hq.1.2 (Ideal.mem_span_singleton_self a)
      rwa [hq0, Ideal.mem_bot] at this)
  have hq1 : q.height = 1 := le_antisymm h1 (ENat.one_le_iff_ne_zero.mpr h0)
  obtain ⟨E, -, -⟩ := MMP.Mori.exists_primeDivisor_isLocalization (x := x) ⟨q, inferInstance⟩ hq1
  exact ⟨E⟩

/-- A scheme of positive dimension has a point other than a given one. -/
private theorem exists_ne_of_topologicalKrullDim_pos {X : Scheme.{0}} {n : ℕ} (hn : 0 < n)
    (hdim : topologicalKrullDim X = n) (y : X) : ∃ x : X, x ≠ y := by
  by_contra h
  push Not at h
  haveI : Subsingleton X := ⟨fun a b => (h a).trans (h b).symm⟩
  haveI : DiscreteTopology X := Subsingleton.discreteTopology
  have h0 := topologicalKrullDim_zero_of_discreteTopology X
  rw [hdim] at h0
  norm_cast at h0
  omega

/-- **A top form with a simple pole along a prime divisor and nonzero residue**, on a normal
variety of dimension `n + 1 ≥ 2`. -/
private theorem exists_simplePole_isPoincareResidue_ne_zero {X T : Scheme.{0}}
    (sX : X ⟶ Spec (.of ℂ)) [IsIntegral X] [IsNormal X] [IsLocallyNoetherian X] [CompactSpace X]
    [LocallyOfFiniteType sX] (hX : IsNormalVariety ℂ sX) {n : ℕ} (hn : 0 < n)
    (hdim : topologicalKrullDim X = n + 1) (j : T ⟶ X) [IsClosedImmersion j] [IsIntegral T]
    [IsNormal T] [IsLocallyNoetherian T] [CompactSpace T] (hT : IsNormalVariety ℂ (j ≫ sX))
    (hdimT : topologicalKrullDim T = n) (P : Mori.PrimeDivisor X)
    (hP : Set.range j.base = (P.support : Set X)) :
    ∃ σ : RationalPluriForms sX (n + 1) 1, σ ≠ 0 ∧ P.ordForm σ = -1 ∧
      ∃ ρσ : RationalPluriForms (j ≫ sX) n 1, IsPoincareResidue sX j n 1 σ ρσ ∧ ρσ ≠ 0 := by
  obtain ⟨x, hx⟩ := exists_ne_of_topologicalKrullDim_pos hn hdimT (genericPoint T)
  obtain ⟨Q⟩ := nonempty_primeDivisor_of_ne_genericPoint hx
  obtain ⟨σ, hσ0, hσP, -, ρσ, hρσ, hρσ0, -⟩ :=
    MMP.Fourfold.exists_form_of_residue_order sX hX hdim j hT P hP Q
  exact ⟨σ, hσ0, hσP, ρσ, hρσ, hρσ0⟩

/-- **The base forms generate.** If `e` is a local equation of `H` on `U`, then
`f^*e^{-r} · w^{⊗kr}` generates `𝒪_X(kr(K_X + B))` over `f⁻¹(U)`. -/
private theorem generatesOn_base
    {X R : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ))
    [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R]
    (f : X ⟶ R) [IsDominant f] {H : Divisor R}
    {hfH : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ H.supp}
    {M : Divisor X} (hM : H.IsPullback f hfH M) {K : Divisor X} {B : QDivisor X} {k r : ℕ}
    {u : X.functionField} (hu0 : u ≠ 0)
    (hMu : ∀ Γ : Mori.PrimeDivisor X,
      (X.ord u Γ.genericPoint : ℚ) = M.coeff Γ - k * (K.coeff Γ + B.coeff Γ))
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (hw : ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
      ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ)
    (hm0 : 0 < k * r) {U : R.Opens} {e : (RationalFunctions R)ˣ} (he : H.IsLocalEquation U e) :
    letI := functionFieldAlgebra sX
    GeneratesOn B (k * r) (f ⁻¹ᵁ U)
      (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
        (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)) := by
  letI := functionFieldAlgebra sX
  set v := MMP.Threefold.Mori.Helpers.evalFF (univComponent R) (e : RationalFunctions R)
    with hv
  have hv0 : v ≠ 0 := (e.isUnit.map _).ne_zero
  have hfu0 : functionFieldMap f v ≠ 0 := (map_ne_zero _).mpr hv0
  have hc0 : ((functionFieldMap f v)⁻¹ * u) ^ r ≠ 0 :=
    pow_ne_zero _ (mul_ne_zero (inv_ne_zero hfu0) hu0)
  refine ⟨smul_ne_zero hc0 (hw _ hm0).1, fun Γ hΓ => ?_⟩
  have hΓU : Γ.genericPoint ∈ f ⁻¹ᵁ U := Mori.PrimeDivisor.genericPoint_mem_of_nonempty (E := Γ) hΓ
  have hMΓ := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hM he Γ hΓU (univComponent R)
  rw [Γ.ordForm_smul_of_topologicalKrullDim_eq hdim hc0 (hw _ hm0).1, (hw _ hm0).2 Γ, mul_pow,
    Scheme.ord_mul (pow_ne_zero _ (inv_ne_zero hfu0)) (pow_ne_zero _ hu0),
    MMP.Flips.ord_inv_pow hfu0, Scheme.ord_pow hu0, ← hMΓ]
  have h1 := hMu Γ
  push_cast
  linear_combination (r : ℚ) * h1

/-- In degree `0`, the `m`-th tensor power of the generator `1 ∈ ⋀⁰ M` is nonzero. -/
private theorem tprod_ιMulti_zero_ne_zero {K : Type} [Field K] {M : Type} [AddCommGroup M]
    [Module K M] (m : ℕ) (v : Fin 0 → M) :
    (PiTensorProduct.tprod K (fun _ : Fin m => exteriorPower.ιMulti K 0 v) :
      TensorPower K m (⋀[K]^0 M)) ≠ 0 := by
  let b : Module.Basis Unit K (⋀[K]^0 M) :=
    (Module.Basis.singleton Unit K).map (exteriorPower.zeroEquiv K M).symm
  have hb : b () = exteriorPower.ιMulti K 0 v := by
    apply (exteriorPower.zeroEquiv K M).injective
    rw [exteriorPower.zeroEquiv_ιMulti]
    simp [b]
  have h := (Basis.piTensorProduct (fun _ : Fin m => b)).ne_zero (fun _ => ())
  rw [Basis.piTensorProduct_apply] at h
  simpa only [hb] using h

/-- **Residues at a point of a normal curve.** Along an adjunction step `j : Q ⟶ C` onto a
point of a normal curve, a rational `m`-canonical form with a pole of order exactly `m` there
has a nonzero Poincaré residue. -/
private theorem exists_isPoincareResidue_ne_zero_of_curve {C Q : Scheme.{0}} [IsIntegral C]
    [IsLocallyNoetherian C] [IsNormal C] {s : C ⟶ Spec (.of ℂ)}
    (hC : IsNormalVariety ℂ s) (hdim : topologicalKrullDim C = 1) {BC : QDivisor C}
    {j : Q ⟶ C} {BQ : QDivisor Q} (hj : IsAdjunctionStep s BC j BQ) [IsIntegral Q] {m : ℕ}
    (ρ : RationalPluriForms s 1 m) (hρ0 : ρ ≠ 0)
    (hρ : ∀ P : Mori.PrimeDivisor C, j (genericPoint Q) = P.genericPoint →
      P.ordForm ρ = -(m : ℤ)) :
    ∃ ρ' : RationalPluriForms (j ≫ s) 0 m, IsPoincareResidue s j 0 m ρ ρ' ∧ ρ' ≠ 0 := by
  classical
  haveI : LocallyOfFiniteType s := hC.1.toLocallyOfFiniteType
  obtain ⟨P, hP, hci⟩ := hj.exists_primeDivisor
  let O := C.presheaf.stalk (j (genericPoint Q))
  let := stalkAlgebra s (j (genericPoint Q))
  let := functionFieldAlgebra s
  let := functionFieldAlgebra (j ≫ s)
  let : Algebra O Q.functionField := (j.stalkMap (genericPoint Q)).hom.toAlgebra
  have := isScalarTower_stalk_functionField s (j (genericPoint Q))
  obtain ⟨hdvr, hfree, hfin, -, hcoh, hrank⟩ := hj.stalk_facts
  obtain ⟨-, hsurj⟩ := hj.stalkMap_facts
  obtain ⟨ϖ, r, -, hr, hker, -, -⟩ := hj.exists_uniformizer
  have htr : (Algebra.trdeg ℂ C.functionField).toNat = 1 :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq (by exact_mod_cast hdim)
  -- `ϖ` is a uniformizer
  have hmax : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} :=
    (IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ hsurj)).symm.trans hker
  have hϖirr : Irreducible ϖ := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mpr hmax
  have hϖ0 : algebraMap O C.functionField ϖ ≠ 0 := by
    rw [Ne, IsFractionRing.to_map_eq_zero_iff]; exact hϖirr.ne_zero
  have hord : C.ord (algebraMap O C.functionField ϖ) (j (genericPoint Q)) = 1 :=
    (Scheme.ord_eq_iff hcoh hϖ0).mpr (Ring.ordFrac_irreducible hϖirr)
  -- `dϖ` generates `Ω_{𝒪/ℂ}`
  have hspan : Submodule.span O (Set.range ![KaehlerDifferential.D ℂ O ϖ]) = ⊤ := by
    haveI := hfree
    haveI := hfin
    have hrk : Module.finrank O Ω[O⁄ℂ] = 1 := hrank.trans htr
    let b₀ := Module.finBasisOfFinrankEq O Ω[O⁄ℂ] hrk
    set c := b₀.repr (KaehlerDifferential.D ℂ O ϖ) 0 with hc_def
    have hD : KaehlerDifferential.D ℂ O ϖ = c • b₀ 0 := by
      conv_lhs => rw [← b₀.sum_repr (KaehlerDifferential.D ℂ O ϖ)]
      simp [Fin.sum_univ_one, hc_def]
    have hc : IsUnit c := IsUnit.of_mul_eq_one (r (b₀ 0)) (by
      rw [← smul_eq_mul, ← map_smul, ← hD, hr])
    refine eq_top_iff.mpr ?_
    rw [← b₀.span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    obtain rfl : i = 0 := Subsingleton.elim _ _
    have : b₀ 0 = ((hc.unit⁻¹ : Oˣ) : O) • KaehlerDifferential.D ℂ O ϖ := by
      conv_rhs => rw [hD]
      rw [smul_smul, hc.val_inv_mul, one_smul]
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩)
  -- the frame `dϖ` of `Ω_{k(C)/ℂ}`
  have := essFiniteType_functionField (sX := s)
  have hK1 : Module.finrank C.functionField Ω[C.functionField⁄ℂ] = 1 :=
    (finrank_kaehlerDifferential_eq_trdeg ℂ C.functionField).trans htr
  have : FiniteDimensional C.functionField Ω[C.functionField⁄ℂ] :=
    (trdeg_eq_finrank_kaehlerDifferential_sub_finrank_h1Cotangent ℂ C.functionField).1
  haveI := nontrivial_exteriorPower_of_finrank_eq ℂ C.functionField hK1
  have hσ := MMP.Fourfold.span_singleton_ιMulti_eq_top _ hspan
  have h0 := topFormsMap_ne_zero_of_span_eq_top (k := ℂ) (K := C.functionField) hσ
  set F0 := topFormsMap ℂ O C.functionField 1 (exteriorPower.ιMulti O 1
    ![KaehlerDifferential.D ℂ O ϖ]) with hF0_def
  have hfr1 : Module.finrank C.functionField (⋀[C.functionField]^1 Ω[C.functionField⁄ℂ]) = 1 := by
    rw [exteriorPower.finrank_eq, hK1, Nat.choose_self]
  have hspanK : Submodule.span C.functionField {F0} = ⊤ :=
    (finrank_eq_one_iff_of_nonzero F0 h0).mp hfr1
  let bK := basisOfSpanSingleton hspanK h0
  set c := (ZTensorPower.basis bK (m : ℤ)).repr ρ () with hc_def
  have hρeq : ρ = c • (PiTensorProduct.tprod C.functionField (fun _ : Fin m => F0) :
      TensorPower C.functionField m (⋀[C.functionField]^1 Ω[C.functionField⁄ℂ])) := by
    have h1 := basis_unit_repr_smul (ZTensorPower.basis bK (m : ℤ)) ρ
    have h2 := ZTensorPower.basis_ofNat bK m
    rw [basisOfSpanSingleton_apply] at h2
    rw [← hc_def] at h1
    rw [← h2]
    exact h1.symm
  have hc0 : c ≠ 0 := fun h => hρ0 (by rw [hρeq, h]; exact zero_smul _ _)
  have hordc : C.ord c P.genericPoint = -(m : ℤ) := by
    have := MMP.CyclicChartDifferent.ordForm_eq_of_frame (sX := s) P hP ![KaehlerDifferential.D ℂ O ϖ]
      hspan h0 c ρ hρeq
    rw [← this]
    exact hρ P hP
  -- the coefficient along the frame `(dϖ/ϖ)^m` is regular
  have hgK : c * algebraMap O C.functionField ϖ ^ m ≠ 0 := mul_ne_zero hc0 (pow_ne_zero _ hϖ0)
  obtain ⟨g, hgu, hg⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero
    (j (genericPoint Q)) hgK fun Γ hΓ => by
      have hΓP : Γ.genericPoint = P.genericPoint := by
        have hsp : Γ.genericPoint ⤳ j (genericPoint Q) := by
          rw [specializes_iff_mem_closure, ← PrimeDivisor.support_eq_closure]; exact hΓ
        rw [hP] at hsp
        exact MMP.ProgramBaseChange.eq_of_specializes_of_coheight_eq_one hsp
          Γ.coheight_genericPoint P.coheight_genericPoint
      rw [hΓP, Scheme.ord_mul hc0 (pow_ne_zero _ hϖ0), Scheme.ord_pow hϖ0, ← hP, hord]
      rw [hP]
      omega
  refine ⟨_, ⟨ϖ, g, Fin.elim0, hord, ?_, rfl⟩, ?_⟩
  swap
  · exact smul_ne_zero ((hgu.map (j.stalkMap (genericPoint Q)).hom).ne_zero)
      (tprod_ιMulti_zero_ne_zero m _)
  have hF0' : exteriorPower.ιMulti C.functionField (0 + 1)
      (Fin.cons (KaehlerDifferential.D ℂ C.functionField (algebraMap O C.functionField ϖ))
        fun i : Fin 0 => KaehlerDifferential.D ℂ C.functionField
          (algebraMap O C.functionField (Fin.elim0 i))) = F0 := by
    rw [hF0_def, topFormsMap_ιMulti]
    congr 1
    funext i
    fin_cases i
    simp [KaehlerDifferential.map_D]
  rw [hρeq, hg, hF0', tprod_const_smul, smul_smul]
  congr 1
  have h1 : algebraMap O C.functionField ϖ * (algebraMap O C.functionField ϖ)⁻¹ = 1 :=
    mul_inv_cancel₀ hϖ0
  rw [mul_assoc, ← mul_pow]
  erw [h1]
  rw [one_pow, mul_one]

/-- **Residues of local generators along a floor component exist and are nonzero.** Let
`jT : T ⟶ X` be an adjunction step of the dlt-type pair `(X, B)` (`B ≤ 1`), `T` of dimension
`n`, and `τ` a local generator of `𝒪_X(m(K_X + B))` on an open meeting `jT(T)`. Then `τ` has a
nonzero Poincaré residue along `T`. -/
private theorem exists_isPoincareResidue_ne_zero_of_generatesOn {X T : Scheme.{0}}
    {sX : X ⟶ Spec (.of ℂ)} [IsIntegral X] [IsNormal X] [IsLocallyNoetherian X] [CompactSpace X]
    [LocallyOfFiniteType sX] (hXn : IsNormalVariety ℂ sX) {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ)) {B : QDivisor X} (hle : ∀ P, B.coeff P ≤ 1)
    [IsIntegral T] [IsNormal T] [IsLocallyNoetherian T] [CompactSpace T] {jT : T ⟶ X}
    {BT : QDivisor T} (hj : IsAdjunctionStep sX B jT BT) (hdimT : topologicalKrullDim T = n)
    {m : ℕ} {W : X.Opens} {τ : RationalPluriForms sX (n + 1) m} (hτ : GeneratesOn B m W τ)
    (hW : jT (genericPoint T) ∈ W) :
    ∃ ρ : RationalPluriForms (jT ≫ sX) n m, IsPoincareResidue sX jT n m τ ρ ∧ ρ ≠ 0 := by
  obtain ⟨hTn, P, hP1, hPr, hci, -⟩ := id hj
  haveI := hci
  haveI : LocallyOfFiniteType (jT ≫ sX) := hTn.1.toLocallyOfFiniteType
  have hBP : B.coeff P = 1 := le_antisymm (hle P) hP1
  have hjgen : jT (genericPoint T) = P.genericPoint :=
    MMP.CyclicChartDifferent.Aux.map_genericPoint_eq jT P hPr
  have hPW : (P.support ∩ (W : Set X)).Nonempty := by
    refine ⟨P.genericPoint, ?_, hjgen ▸ hW⟩
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have hτP : P.ordForm τ = -(m : ℤ) := by
    have := hτ.2 P hPW
    rw [hBP, mul_one] at this
    have h2 : (P.ordForm τ : ℚ) = -(m : ℚ) := by linarith
    exact_mod_cast h2
  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · subst hn0
    refine exists_isPoincareResidue_ne_zero_of_curve hXn (by rw [hdim]; rfl) hj τ hτ.1
      fun P' hP' => ?_
    obtain rfl : P' = P := MMP.Flips.eq_of_genericPoint_mem_primeDivisor_support
      (by
        rw [← hP', hjgen, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl)
    exact hτP
  · obtain ⟨σ, hσ0, hσP, ρσ, hρσ, hρσ0⟩ := exists_simplePole_isPoincareResidue_ne_zero sX hXn
      hnpos (by rw [hdim]; norm_cast) jT hTn hdimT P hPr
    exact exists_isPoincareResidue_ne_zero_of_ordForm_eq hdim hdimT P hjgen hσ0 hσP hρσ
      hρσ0 τ hτ.1 hτP

/-- The stalk map of a closed immersion into a reduced scheme is injective at a point whose image
has a neighbourhood contained in the image. -/
private theorem stalkMap_injective_of_subset_range {A Y : Scheme.{0}} [IsReduced Y] (f : A ⟶ Y)
    [IsClosedImmersion f] (t : A) (V : Y.Opens) (htV : f.base t ∈ V)
    (hV : (V : Set Y) ⊆ Set.range f.base) : Function.Injective (f.stalkMap t).hom := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  obtain ⟨W, hxW, r, rfl⟩ := TopCat.Presheaf.exists_germ_eq Y.presheaf a
  rw [Scheme.Hom.germ_stalkMap_apply,
    ← map_zero (ConcreteCategory.hom (A.presheaf.germ (f ⁻¹ᵁ W) t hxW))] at ha
  obtain ⟨V', htV', iV, iV', hV'⟩ := TopCat.Presheaf.germ_eq A.presheaf t hxW hxW _ 0 ha
  rw [map_zero] at hV'
  obtain ⟨W₁, hW₁, hW₁V⟩ := f.isClosedEmbedding.isInducing.isOpen_iff.mp V'.isOpen
  let W₂ : Y.Opens := W ⊓ ⟨W₁, hW₁⟩ ⊓ V
  have hxW₂ : f.base t ∈ W₂ := ⟨⟨hxW, show t ∈ f.base ⁻¹' W₁ by rw [hW₁V]; exact htV'⟩, htV⟩
  let r₂ := (ConcreteCategory.hom (Y.presheaf.map
    (homOfLE (inf_le_left.trans inf_le_left) : W₂ ⟶ W).op)) r
  have hle : f ⁻¹ᵁ W₂ ≤ V' := fun z hz => by
    have : z ∈ f.base ⁻¹' W₁ := hz.1.2
    rwa [hW₁V] at this
  have hz : (ConcreteCategory.hom (f.app W₂)) r₂ = 0 := by
    change (ConcreteCategory.hom (Y.presheaf.map
      (homOfLE (inf_le_left.trans inf_le_left) : W₂ ⟶ W).op ≫ f.app W₂)) r = 0
    rw [Scheme.Hom.naturality, ConcreteCategory.comp_apply]
    have : ((TopologicalSpace.Opens.map f.base).map
        (homOfLE (inf_le_left.trans inf_le_left) : W₂ ⟶ W).op.unop).op =
        iV.op ≫ (homOfLE hle).op :=
      congrArg Quiver.Hom.op (Subsingleton.elim _ _)
    rw [this, Functor.map_comp, ConcreteCategory.comp_apply, hV', map_zero]
  have hr₂ : r₂ = 0 := by
    apply eq_zero_of_basicOpen_eq_bot
    refine eq_bot_iff.mpr fun y hy => ?_
    obtain ⟨a', rfl⟩ := hV (Y.basicOpen_le r₂ hy).2
    have : a' ∈ f ⁻¹ᵁ Y.basicOpen r₂ := hy
    rw [Scheme.Hom.preimage_basicOpen, hz, Scheme.basicOpen_zero] at this
    exact this
  rw [← TopCat.Presheaf.germ_res_apply Y.presheaf
    (homOfLE (inf_le_left.trans inf_le_left) : W₂ ⟶ W) (f.base t) hxW₂ r]
  change (ConcreteCategory.hom (Y.presheaf.germ W₂ (f.base t) hxW₂)) r₂ = 0
  rw [hr₂, map_zero]

/-- A strict generization in the specialization order of a scheme. -/
private theorem lt_of_specializes_of_ne {Y : Scheme.{0}} {a b : Y} (h : b ⤳ a) (hne : a ≠ b) :
    a < b :=
  lt_of_le_not_ge h fun h' => hne (Specializes.antisymm (h' : a ⤳ b) h).eq

/-- `d + 1 = n + 1` in `WithBot ℕ∞` forces `d = n`. -/
private theorem eq_natCast_of_add_one_eq_natCast_succ {d : WithBot ℕ∞} {n : ℕ}
    (h : d + 1 = ((n + 1 : ℕ) : WithBot ℕ∞)) : d = (n : ℕ) := by
  induction d using WithBot.recBotCoe with
  | bot => exact absurd h (by rw [WithBot.bot_add]; exact WithBot.bot_ne_coe)
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      exfalso
      have : ((⊤ + 1 : ℕ∞) : WithBot ℕ∞) = ((n + 1 : ℕ) : ℕ∞) := by exact_mod_cast h
      exact ENat.top_ne_coe (n + 1) (by simpa using WithBot.coe_injective this)
    | coe e =>
      have : ((e + 1 : ℕ) : WithBot ℕ∞) = ((n + 1 : ℕ) : WithBot ℕ∞) := by rw [← h]; norm_cast
      have : e + 1 = n + 1 := by exact_mod_cast this
      norm_cast; omega

/-- On an integral scheme locally of finite type over a field, a prime divisor has codimension
one: its dimension plus one is the dimension of the scheme. -/
private theorem topologicalKrullDim_support_add_one {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [LocallyOfFiniteType sX]
    (P : MMP.Mori.PrimeDivisor X) :
    topologicalKrullDim (P.support : Set X) + 1 = topologicalKrullDim X := by
  let _ : X.Over (Spec (.of k)) := ⟨sX⟩
  have : LocallyOfFiniteType (X ↘ Spec (.of k)) := inferInstanceAs (LocallyOfFiniteType sX)
  have h := MMP.Intersection.Scheme.Subvariety.dim_add_codim k
    (MMP.Intersection.Scheme.Subvariety.ofPoint P.genericPoint)
  rw [MMP.Intersection.Scheme.Subvariety.dim_eq_topologicalKrullDim_support,
    MMP.Intersection.Scheme.Subvariety.support_ofPoint,
    MMP.Intersection.Scheme.Subvariety.codim_eq_coheight_genericPoint,
    MMP.Intersection.Scheme.Subvariety.genericPoint_ofPoint, P.coheight_genericPoint] at h
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact_mod_cast h

/-- The images of the floor components are the irreducible components of the floor. -/
private theorem range_mem_irreducibleComponents_of_floor {X T : Scheme.{0}} (ι : T ⟶ X)
    [IsClosedImmersion ι] {B : QDivisor X}
    (hT : Set.range ι.base = ⋃ P ∈ B.roundDown.support, (P.support : Set X))
    {I : Type} (S : I → Scheme.{0}) (n : ∀ i, S i ⟶ T) (P : I → MMP.Mori.PrimeDivisor X)
    (hP : ∀ i, P i ∈ B.roundDown.support) (hPinj : Function.Injective P)
    (hPsurj : ∀ Q ∈ B.roundDown.support, ∃ i, P i = Q)
    (hn : ∀ i, Set.range (n i ≫ ι) = ((P i).support : Set X)) :
    (∀ i, Set.range (n i) ∈ irreducibleComponents T) ∧
      ∀ Z ∈ irreducibleComponents T, ∃! i, Set.range (n i) = Z := by
  have hinj : Function.Injective ι.base := ι.isClosedEmbedding.injective
  have himg : ∀ i, ι.base '' Set.range (n i) = ((P i).support : Set X) := fun i => by
    rw [← hn i, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp]
  -- an irreducible subset of `T` maps into one component of the floor
  have hsub : ∀ Z : Set T, IsIrreducible Z → ∃ i, ι.base '' Z ⊆ ((P i).support : Set X) := by
    intro Z hZ
    have hZ' : IsIrreducible (ι.base '' Z) := hZ.image _ ι.base.hom.continuous.continuousOn
    have hcl := isIrreducible_iff_sUnion_isClosed.mp hZ'
    obtain ⟨W, hW, hZW⟩ := hcl (B.roundDown.support.image fun Q => (Q.support : Set X))
      (by
        intro W hW
        obtain ⟨Q, -, rfl⟩ := Finset.mem_image.mp hW
        exact Q.idealSheaf.support.isClosed)
      (by
        rintro _ ⟨z, -, rfl⟩
        have : ι.base z ∈ Set.range ι.base := ⟨z, rfl⟩
        rw [hT] at this
        obtain ⟨_, ⟨Q, rfl⟩, hz⟩ := this
        obtain ⟨hQ, hz⟩ := Set.mem_iUnion.mp hz
        exact ⟨_, Finset.mem_image.mpr ⟨Q, hQ, rfl⟩, hz⟩)
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.mp hW
    obtain ⟨i, rfl⟩ := hPsurj Q hQ
    exact ⟨i, hZW⟩
  have hirr : ∀ i, IsIrreducible (Set.range (n i)) := fun i => by
    have hgen : (P i).genericPoint ∈ ι.base '' Set.range (n i) := by
      rw [himg i, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    obtain ⟨η, -, hη⟩ := hgen
    have : Set.range (n i) = closure {η} := by
      apply (Set.image_injective.mpr hinj)
      rw [himg i, ← ι.isClosedEmbedding.closure_image_eq, Set.image_singleton, hη,
        AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    rw [this]
    exact isIrreducible_singleton.closure
  have hmax : ∀ i, Set.range (n i) ∈ irreducibleComponents T := fun i => by
    refine ⟨hirr i, fun Z hZ hiZ => ?_⟩
    obtain ⟨j, hj⟩ := hsub Z hZ
    have hij : ((P i).support : Set X) ⊆ (P j).support := by
      rw [← himg i]; exact (Set.image_mono hiZ).trans hj
    have hgen : (P i).genericPoint ∈ ((P j).support : Set X) := by
      apply hij
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    have hji := MMP.Intersection.primeDivisor_eq_of_genericPoint_mem_support hgen
    rw [hji, ← himg i] at hj
    exact (Set.image_subset_image_iff hinj).mp hj
  refine ⟨hmax, fun Z hZ => ?_⟩
  obtain ⟨i, hi⟩ := hsub Z hZ.1
  rw [← himg i] at hi
  have hZi : Z = Set.range (n i) :=
    ((Set.image_subset_image_iff hinj).mp hi).antisymm
      (hZ.2 (hirr i) ((Set.image_subset_image_iff hinj).mp hi))
  refine ⟨i, hZi.symm, fun i' hi' => hPinj ?_⟩
  apply primeDivisor_eq_of_support_eq
  rw [← himg i, ← himg i', hi', hZi]

section FloorBranches

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {n : ℕ} {K : Divisor X} {B : QDivisor X}
  {T : Scheme.{0}} (ι : T ⟶ X) [IsClosedImmersion ι] [IsReduced T]
variable (hdim : topologicalKrullDim X = (n + 1 : ℕ)) (hK : K.IsCanonicalDivisor sX (n + 1))
  (hproj : MMP.Mori.IsProjectiveVariety k sX) (hQ : IsQFactorial sX)
  (hB : MMP.Fourfold.IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B)
  (hB0 : B.roundDown ≠ 0)
  (hT : Set.range ι.base = ⋃ P ∈ B.roundDown.support, (P.support : Set X))

include hdim hK hproj hQ hB hdlt hB0 hT

variable {hfin : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
  (N : MMP.Flips.NormalizationComponents (ι ≫ sX) hfin) (Θ : ∀ i, QDivisor (N.X i))
  (hΘ : ∀ i, IsAdjunctionStep sX B (N.n i ≫ ι) (Θ i))
  (huniq : ∀ P ∈ B.roundDown.support,
    ∃! i, Set.range (N.n i ≫ ι).base = (P.support : Set X))

include hΘ huniq

/-- The floor components are indexed by the prime components of `⌊B⌋`. -/
private theorem exists_primeDivisor_floorComponent :
    ∃ P : N.ι → MMP.Mori.PrimeDivisor X,
      (∀ i, Set.range (N.n i ≫ ι).base = ((P i).support : Set X)) ∧
      (∀ i, P i ∈ B.roundDown.support) ∧ Function.Injective P ∧
      ∀ Q ∈ B.roundDown.support, ∃ i, P i = Q := by
  choose P hP using fun i => (hΘ i).2
  have hPrange : ∀ i, Set.range (N.n i ≫ ι) = ((P i).support : Set X) := fun i => (hP i).2.1
  have hPmem : ∀ i, P i ∈ B.roundDown.support := fun i => by
    rw [Finsupp.mem_support_iff]
    change B.roundDown.coeff (P i) ≠ 0
    rw [DivisorWithCoeffs.coeff_roundDown]
    have h1 : (1 : ℤ) ≤ ⌊B.coeff (P i)⌋ := Int.le_floor.mpr (by exact_mod_cast (hP i).1)
    omega
  have hPinj : Function.Injective P := fun i j hij => by
    obtain ⟨l, -, hl⟩ := huniq (P i) (hPmem i)
    rw [hl i (hPrange i), hl j (show _ = _ by rw [hPrange j, hij])]
  have hPsurj : ∀ Q ∈ B.roundDown.support, ∃ i, P i = Q := fun Q hQ => by
    obtain ⟨i, hi, -⟩ := huniq Q hQ
    exact ⟨i, primeDivisor_eq_of_support_eq (by rw [← hPrange i]; exact hi)⟩
  exact ⟨P, hPrange, hPmem, hPinj, hPsurj⟩

/-- Every point of the floor lies on a floor component. -/
private theorem exists_mem_range_floorComponent (t : T) : ∃ i, t ∈ Set.range (N.n i).base := by
  obtain ⟨P, hPr, -, -, hPs⟩ :=
    exists_primeDivisor_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  have ht : ι.base t ∈ Set.range ι.base := ⟨t, rfl⟩
  rw [hT] at ht
  obtain ⟨_, ⟨Q, rfl⟩, ht⟩ := ht
  obtain ⟨hQ, htQ⟩ := Set.mem_iUnion.mp ht
  obtain ⟨i, rfl⟩ := hPs Q hQ
  rw [← hPr i] at htQ
  obtain ⟨y, hy⟩ := htQ
  exact ⟨i, y, ι.isClosedEmbedding.injective (by rw [← hy]; rfl)⟩

/-- Each floor component has dimension `n`. -/
private theorem topologicalKrullDim_floorComponent (i : N.ι) :
    topologicalKrullDim (N.X i) = (n : ℕ) := by
  obtain ⟨P, hPr, -, -, -⟩ :=
    exists_primeDivisor_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  haveI : IsClosedImmersion (N.n i ≫ ι) := (hΘ i).2.choose_spec.2.2.1
  have e2 : topologicalKrullDim (N.X i) = topologicalKrullDim (Set.range (N.n i ≫ ι)) :=
    (N.n i ≫ ι).isClosedEmbedding.toIsEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq
  rw [e2, hPr i]
  have hlft : LocallyOfFiniteType sX := hB.isPair.1.1.toLocallyOfFiniteType
  have h1 := topologicalKrullDim_support_add_one sX (P i)
  rw [hdim] at h1
  exact eq_natCast_of_add_one_eq_natCast_succ h1

/-- **A prime divisor of a floor component has codimension one in the floor.** -/
private theorem coheight_floorComponent_primeDivisor (i : N.ι)
    (Q : MMP.Mori.PrimeDivisor (N.X i)) :
    Order.coheight ((N.n i).base Q.genericPoint) = 1 := by
  haveI : IsClosedImmersion (N.n i ≫ ι) := (hΘ i).2.choose_spec.2.2.1
  haveI : ∀ j, IsClosedImmersion (N.n j) := fun j =>
    haveI : IsClosedImmersion (N.n j ≫ ι) := (hΘ j).2.choose_spec.2.2.1
    IsClosedImmersion.of_comp (N.n j) ι
  have hlft : ∀ j, LocallyOfFiniteType (N.n j ≫ ι ≫ sX) := fun j =>
    (N.isNormalVariety j).1.toLocallyOfFiniteType
  have hdimj := topologicalKrullDim_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  set y := (N.n i).base Q.genericPoint with hy
  -- the dimension of the closure of `y`
  have hdy : topologicalKrullDim (closure {y} : Set T) + 1 = (n : WithBot ℕ∞) := by
    have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight (N.n i ≫ ι ≫ sX)
      Q.genericPoint
    rw [Q.coheight_genericPoint, hdimj i] at h
    have himg : (N.n i).base '' closure {Q.genericPoint} = closure {y} := by
      rw [← (N.n i).isClosedEmbedding.closure_image_eq, Set.image_singleton]
    rw [← himg, ← ((N.n i).isClosedEmbedding.isEmbedding.homeomorphImage
      (closure {Q.genericPoint})).isHomeomorph.topologicalKrullDim_eq]
    exact_mod_cast h
  refine le_antisymm ?_ ?_
  · by_contra hlt
    have h2 : ((2 : ℕ) : ℕ∞) ≤ Order.coheight y := by
      rw [not_le] at hlt
      exact Order.add_one_le_of_lt hlt
    obtain ⟨p, hp0, hplen⟩ := Order.exists_series_of_le_coheight y h2
    have h01 : p ⟨0, by omega⟩ < p ⟨1, by omega⟩ := p.strictMono (by simp [Fin.lt_def])
    have h12 : p ⟨1, by omega⟩ < p ⟨2, by omega⟩ := p.strictMono (by simp [Fin.lt_def])
    obtain ⟨j, q2, hq2⟩ := exists_mem_range_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ
      hΘ huniq (p ⟨2, by omega⟩)
    have hcl : ∀ z : T, p ⟨2, by omega⟩ ⤳ z → z ∈ Set.range (N.n j).base := fun z hz =>
      (N.n j).isClosedEmbedding.isClosed_range.closure_subset_iff.mpr
        (Set.singleton_subset_iff.mpr ⟨q2, hq2⟩) (specializes_iff_mem_closure.mp hz)
    obtain ⟨q1, hq1⟩ := hcl _ h12.le
    obtain ⟨q0, hq0⟩ := hcl _ (h01.le.trans h12.le)
    have hsp : ∀ {a b : N.X j}, (N.n j).base a ⤳ (N.n j).base b → a ⤳ b := fun h =>
      ((N.n j).isClosedEmbedding.isInducing.specializes_iff).mp h
    have hl01 : q0 < q1 := lt_of_specializes_of_ne (hsp (by rw [hq0, hq1]; exact h01.le))
      (fun h => h01.ne (by rw [← hq0, ← hq1, h]))
    have hl12 : q1 < q2 := lt_of_specializes_of_ne (hsp (by rw [hq1, hq2]; exact h12.le))
      (fun h => h12.ne (by rw [← hq1, ← hq2, h]))
    have hc0 : (2 : ℕ∞) ≤ Order.coheight q0 := by
      have a := Order.coheight_add_one_le hl12
      have b := Order.coheight_add_one_le hl01
      calc (2 : ℕ∞) = 0 + 1 + 1 := by norm_num
        _ ≤ Order.coheight q2 + 1 + 1 := by gcongr; exact bot_le
        _ ≤ Order.coheight q1 + 1 := by gcongr
        _ ≤ Order.coheight q0 := b
    have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight (N.n j ≫ ι ≫ sX) q0
    rw [hdimj j] at h
    have himg : (N.n j).base '' closure {q0} = closure {y} := by
      rw [← (N.n j).isClosedEmbedding.closure_image_eq, Set.image_singleton, hq0, ← hp0]
      rfl
    rw [((N.n j).isClosedEmbedding.isEmbedding.homeomorphImage
      (closure {q0})).isHomeomorph.topologicalKrullDim_eq, himg] at h
    -- `dim closure {y} = n - 1` and `coheight q0 ≥ 2` contradict `dim + coheight = n`
    induction hd : topologicalKrullDim (closure {y} : Set T) using WithBot.recBotCoe with
    | bot => rw [hd, WithBot.bot_add] at hdy; exact WithBot.bot_ne_coe hdy
    | coe d =>
      rw [hd] at hdy h
      have h' : d + Order.coheight q0 = n := by exact_mod_cast h
      have hdy' : d + 1 = n := by exact_mod_cast hdy
      have : d + 2 ≤ d + 1 := by
        calc d + 2 ≤ d + Order.coheight q0 := by gcongr
          _ = d + 1 := by rw [h', hdy']
      induction d using ENat.recTopCoe with
      | top => simp at hdy'
      | coe d => norm_cast at this; omega
  · -- the generic point of the component strictly generizes `y`
    have hne : Q.genericPoint ≠ genericPoint (N.X i) := by
      intro h
      apply MMP.Threefold.Mori.CanonUniq.genericPoint_notMem_support Q
      rw [← h, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    have hlt : y < (N.n i).base (genericPoint (N.X i)) :=
      lt_of_specializes_of_ne
        ((_root_.genericPoint_specializes Q.genericPoint).map (N.n i).base.hom.continuous)
        (fun h => hne ((N.n i).isClosedEmbedding.injective h))
    have := Order.coheight_add_one_le hlt
    calc (1 : ℕ∞) = 0 + 1 := by simp
      _ ≤ _ := by gcongr; exact bot_le
      _ ≤ _ := this

/-- At a point lying on a single floor component, the stalk of the floor is the stalk of the
component. -/
private theorem bijective_stalkMap_floorComponent (i : N.ι) (t : N.X i)
    (ht : ∀ j, j ≠ i → (N.n i).base t ∉ Set.range (N.n j).base) :
    Function.Bijective ((N.n i).stalkMap t).hom := by
  classical
  obtain ⟨P, -, hPmem, hPinj, -⟩ :=
    exists_primeDivisor_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  haveI : Finite N.ι := Finite.of_injective
    (fun i => (⟨P i, hPmem i⟩ : {Q // Q ∈ B.roundDown.support}))
    fun a b h => hPinj (congrArg Subtype.val h)
  haveI : ∀ j, IsClosedImmersion (N.n j) := fun j =>
    haveI : IsClosedImmersion (N.n j ≫ ι) := (hΘ j).2.choose_spec.2.2.1
    IsClosedImmersion.of_comp (N.n j) ι
  let V : T.Opens := ⟨(⋃ j ∈ ({i}ᶜ : Set N.ι), Set.range (N.n j).base)ᶜ, by
    refine (Set.Finite.isClosed_biUnion (Set.toFinite _) fun j _ =>
      (N.n j).isClosedEmbedding.isClosed_range).isOpen_compl⟩
  have htV : (N.n i).base t ∈ V := by
    simp only [V, TopologicalSpace.Opens.mem_mk, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    exact fun j hj => ht j hj
  have hV : (V : Set T) ⊆ Set.range (N.n i).base := by
    intro z hz
    obtain ⟨j, hj⟩ := exists_mem_range_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ
      hΘ huniq z
    by_cases hji : j = i
    · exact hji ▸ hj
    · exact absurd (Set.mem_iUnion₂.mpr ⟨j, hji, hj⟩) hz
  exact ⟨stalkMap_injective_of_subset_range (N.n i) t V htV hV, (N.n i).stalkMap_surjective t⟩

/-- The image of the generic point of a floor component is the generic point of an irreducible
component of the floor. -/
private theorem closure_mem_irreducibleComponents_floorComponent (i : N.ι) :
    closure {(N.n i).base (genericPoint (N.X i))} ∈ irreducibleComponents T := by
  obtain ⟨P, hPr, hPmem, hPinj, hPs⟩ :=
    exists_primeDivisor_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  haveI : ∀ j, IsClosedImmersion (N.n j) := fun j =>
    haveI : IsClosedImmersion (N.n j ≫ ι) := (hΘ j).2.choose_spec.2.2.1
    IsClosedImmersion.of_comp (N.n j) ι
  have h := (range_mem_irreducibleComponents_of_floor ι hT N.X N.n P hPmem hPinj hPs hPr).1 i
  rwa [← Set.image_singleton, (N.n i).isClosedEmbedding.closure_image_eq,
    (genericPoint_spec (N.X i)).def, Set.image_univ]

/-- The generic point of a floor component has codimension zero in the floor. -/
private theorem coheight_genericPoint_floorComponent (i : N.ι) :
    Order.coheight ((N.n i).base (genericPoint (N.X i))) = 0 := by
  rw [Order.coheight_eq_zero]
  intro z hz
  have hc := closure_mem_irreducibleComponents_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT
    N Θ hΘ huniq i
  have hsub : closure {(N.n i).base (genericPoint (N.X i))} ⊆ closure {z} :=
    closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hz))
      isClosed_closure
  have := hc.2 isIrreducible_singleton.closure hsub
  exact specializes_iff_mem_closure.mpr (this (subset_closure rfl))

/-- A codimension-one point on a single floor component is a regular point of the floor. -/
private theorem isRegularLocalRing_stalk_of_single (i : N.ι) (t : N.X i)
    (ht1 : Order.coheight t = 1)
    (ht : ∀ j, j ≠ i → (N.n i).base t ∉ Set.range (N.n j).base) :
    IsRegularLocalRing (T.presheaf.stalk ((N.n i).base t)) := by
  set E := AlgebraicGeometry.PrimeDivisor.ofCoheightOne t ht1
  have hE : E.genericPoint = t := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _
  have hdvr := MMP.Mori.PrimeDivisor.isDiscreteValuationRing_localRing (X := N.X i) E
  have hreg : IsRegularLocalRing ((N.X i).presheaf.stalk t) := by
    rw [← hE]
    infer_instance
  have hbij := bijective_stalkMap_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
    i t ht
  exact IsRegularLocalRing.of_ringEquiv (RingEquiv.ofBijective _ hbij).symm

/-- A point on a single floor component is not in the double locus. -/
private theorem notMem_doubleIntersectionLocus_of_single (i : N.ι) (t : N.X i)
    (ht : ∀ j, j ≠ i → (N.n i).base t ∉ Set.range (N.n j).base) :
    (N.n i).base t ∉ (MMP.Flips.doubleIntersectionLocus T : Set T) := by
  classical
  obtain ⟨P, -, hPmem, hPinj, -⟩ :=
    exists_primeDivisor_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
  haveI : Finite N.ι := Finite.of_injective
    (fun i => (⟨P i, hPmem i⟩ : {Q // Q ∈ B.roundDown.support}))
    fun a b h => hPinj (congrArg Subtype.val h)
  haveI : ∀ j, IsClosedImmersion (N.n j) := fun j =>
    haveI : IsClosedImmersion (N.n j ≫ ι) := (hΘ j).2.choose_spec.2.2.1
    IsClosedImmersion.of_comp (N.n j) ι
  let V : Set T := (⋃ j ∈ ({i}ᶜ : Set N.ι), Set.range (N.n j).base)ᶜ
  have hVo : IsOpen V := (Set.Finite.isClosed_biUnion (Set.toFinite _) fun j _ =>
      (N.n j).isClosedEmbedding.isClosed_range).isOpen_compl
  have htV : (N.n i).base t ∈ V := by
    simp only [V, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
    exact fun j hj => ht j hj
  intro hmem
  obtain ⟨s, hsV, hsS⟩ := mem_closure_iff.mp hmem V hVo htV
  obtain ⟨hs1, hsreg⟩ := hsS
  obtain ⟨j, s', rfl⟩ := exists_mem_range_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ
    hΘ huniq s
  have hji : j = i := by
    by_contra h
    exact hsV (Set.mem_iUnion₂.mpr ⟨j, h, s', rfl⟩)
  subst hji
  have hsingle : ∀ l, l ≠ j → (N.n j).base s' ∉ Set.range (N.n l).base := fun l hl h =>
    hsV (Set.mem_iUnion₂.mpr ⟨l, hl, h⟩)
  -- the codimension of `s'` in its component is one
  have hmono : StrictMono (N.n j).base := fun a b hab =>
    lt_of_specializes_of_ne (hab.le.map (N.n j).base.hom.continuous)
      (fun h => hab.ne ((N.n j).isClosedEmbedding.injective h))
  have hle := Order.coheight_le_coheight_apply_of_strictMono _ hmono s'
  rw [hs1] at hle
  have hne : s' ≠ genericPoint (N.X j) := by
    rintro rfl
    rw [coheight_genericPoint_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq j]
      at hs1
    exact zero_ne_one hs1
  have hge : 1 ≤ Order.coheight s' := by
    have hlt : s' < genericPoint (N.X j) :=
      lt_of_specializes_of_ne (_root_.genericPoint_specializes s') hne
    have := Order.coheight_add_one_le hlt
    calc (1 : ℕ∞) = 0 + 1 := by simp
      _ ≤ _ := by gcongr; exact bot_le
      _ ≤ _ := this
  exact hsreg (isRegularLocalRing_stalk_of_single ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
    j s' (le_antisymm hle hge) hsingle)

/-- **A conductor component of the dlt floor has a second branch.** If a prime divisor `P` of a
floor component `Tᵢ` lies over the double locus of the floor, then the point `νᵢ(P)` is also the
image of the generic point of a prime divisor `P'` of a different floor component `Tⱼ`. -/
private theorem exists_other_branch (i : N.ι) (P : MMP.Mori.PrimeDivisor (N.X i))
    (hD : (N.n i).base P.genericPoint ∈ (MMP.Flips.doubleIntersectionLocus T : Set T)) :
    ∃ (j : N.ι) (P' : MMP.Mori.PrimeDivisor (N.X j)),
      (N.n i).base P.genericPoint = (N.n j).base P'.genericPoint ∧
      (⟨i, P.genericPoint⟩ : Σ i, N.X i) ≠ ⟨j, P'.genericPoint⟩ := by
  classical
  by_contra hno
  refine notMem_doubleIntersectionLocus_of_single ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ huniq
    i P.genericPoint (fun j hji hmem => hno ?_) hD
  obtain ⟨y, hy⟩ := hmem
  haveI : ∀ j, IsClosedImmersion (N.n j) := fun j =>
    haveI : IsClosedImmersion (N.n j ≫ ι) := (hΘ j).2.choose_spec.2.2.1
    IsClosedImmersion.of_comp (N.n j) ι
  have hcoh := coheight_floorComponent_primeDivisor ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ
    huniq i P
  have hmono : StrictMono (N.n j).base := fun a b hab =>
    lt_of_specializes_of_ne (hab.le.map (N.n j).base.hom.continuous)
      (fun h => hab.ne ((N.n j).isClosedEmbedding.injective h))
  have hle := Order.coheight_le_coheight_apply_of_strictMono _ hmono y
  rw [hy, hcoh] at hle
  have hne : y ≠ genericPoint (N.X j) := by
    rintro rfl
    have h0 := coheight_genericPoint_floorComponent ι hdim hK hproj hQ hB hdlt hB0 hT N Θ hΘ
      huniq j
    rw [hy, hcoh] at h0
    exact one_ne_zero h0
  have hge : 1 ≤ Order.coheight y := by
    have hlt : y < genericPoint (N.X j) :=
      lt_of_specializes_of_ne ((genericPoint_spec (N.X j)).specializes trivial) hne
    have := Order.coheight_add_one_le hlt
    calc (1 : ℕ∞) = 0 + 1 := by simp
      _ ≤ _ := by gcongr; exact bot_le
      _ ≤ _ := this
  have hE : (AlgebraicGeometry.PrimeDivisor.ofCoheightOne y (le_antisymm hle hge)).genericPoint =
      y := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _
  refine ⟨j, AlgebraicGeometry.PrimeDivisor.ofCoheightOne y (le_antisymm hle hge), ?_, ?_⟩
  · exact hy.symm.trans (congrArg _ hE.symm)
  · intro h
    exact hji (congrArg Sigma.fst h).symm

end FloorBranches

/-- A discrepancy `a(E, X, Δ)` of a divisor `(Y, f, E)` over `X` whose centre is the generic point
of a prime divisor `P` of `X` is `-coeff_P(Δ)`. -/
private theorem isDiscrepancy_eq_neg_coeff_of_map_genericPoint_eq {k : Type u} [Field k]
    [PerfectField k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] (hX : MMP.Mori.IsNormalVariety k sX)
    {n : ℕ} {K : Divisor X} {Δ : QDivisor X} {D : MMP.Mori.DivisorOver k sX}
    {P : MMP.Mori.PrimeDivisor X} (hP : D.f D.E.genericPoint = P.genericPoint) {a : ℚ}
    (h : MMP.Mori.IsDiscrepancy sX n K Δ D a) : a = -Δ.coeff P := by
  obtain ⟨hX', hK, m, hm, hC, U, hU, τ, hτ, hτa⟩ := h
  refine MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX (P := P)
    ⟨hX', hK, m, hm, hC, U, ?_, τ, hτ, ?_⟩
  · convert hU using 2
    exact hP.symm
  · rw [hτa, MMP.Threefold.Mori.ModelIndependence.ordPullback_eq_of_valuation_eq hX
      hK.topologicalKrullDim_eq
      (MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX D P hP)]

/-- The image of a section in the function field does not change under restriction. -/
private theorem germToFunctionField_app_res {k : Type} [Field k] {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : MMP.Flips.NormalizationComponents sT hT) (i : N.ι) {U U' : T.Opens} (hU : U' ≤ U) (f : Γ(T, U))
    [Nonempty (N.n i ⁻¹ᵁ U')] [Nonempty (N.n i ⁻¹ᵁ U)] :
    ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom ((N.n i).app U' (f |_ U')) =
      ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U f) := by
  have h := congrArg (fun φ => ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom (φ.hom f))
    ((N.n i).naturality (homOfLE hU).op)
  simp only [CommRingCat.comp_apply] at h
  change ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U')).hom
    ((N.n i).app U' (T.presheaf.map (homOfLE hU).op f)) = _
  rw [h]
  exact TopCat.Presheaf.germ_res_apply _ _ _ _ _

/-- A family `φ` of rational functions on the normalization components *descends on* `V` if it
is the pull-back of a function on `V`. -/
private def DescendsOn {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : MMP.Flips.NormalizationComponents sT hT) (φ : ∀ i, (N.X i).functionField) (V : T.Opens) : Prop :=
  ∃ b : Γ(T, V), ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ V)),
    φ i = ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ V)).hom ((N.n i).app V b)

/-- Descent is inherited by smaller opens. -/
private theorem DescendsOn.mono {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : MMP.Flips.NormalizationComponents sT hT} {φ : ∀ i, (N.X i).functionField} {V V' : T.Opens}
    (h : DescendsOn N φ V) (hV : V' ≤ V) : DescendsOn N φ V' := by
  obtain ⟨b, hb⟩ := h
  refine ⟨b |_ V', fun i hi => ?_⟩
  have : Nonempty (N.n i ⁻¹ᵁ V) := ⟨⟨hi.some.1, hV hi.some.2⟩⟩
  rw [germToFunctionField_app_res N i hV b]
  exact hb i this

/-- On a reduced scheme a nonzero section has a nonzero germ at a generic point of an
irreducible component. -/
private theorem exists_mem_genericPoints_germ_ne_zero' {Y : Scheme.{0}} [IsReduced Y]
    {V : Y.Opens} (t : Γ(Y, V)) (ht : t ≠ 0) :
    ∃ (y : Y) (hy : y ∈ V), y ∈ genericPoints Y ∧ Y.presheaf.germ V y hy t ≠ 0 := by
  have hb : Y.basicOpen t ≠ ⊥ := fun h => ht ((basicOpen_eq_bot_iff t).mp h)
  obtain ⟨z, hz⟩ : ∃ z, z ∈ Y.basicOpen t := by
    by_contra! h
    exact hb (eq_bot_iff.2 fun x hx => (h x hx).elim)
  let C : irreducibleComponents Y :=
    ⟨irreducibleComponent z, irreducibleComponent_mem_irreducibleComponents z⟩
  have hηz : (genericPoints.ofComponent C).1 ⤳ z := specializes_iff_mem_closure.mpr <|
    (genericPoints.isGenericPoint_ofComponent C).symm ▸ mem_irreducibleComponent
  have hηb : (genericPoints.ofComponent C).1 ∈ Y.basicOpen t :=
    hηz.mem_open (Y.basicOpen t).isOpen hz
  have hηV : (genericPoints.ofComponent C).1 ∈ V := Y.basicOpen_le t hηb
  refine ⟨_, hηV, (genericPoints.ofComponent C).2, ?_⟩
  exact ((Y.mem_basicOpen t _ hηV).mp hηb).ne_zero

/-- **Generic points of `T` come from the normalization components.** Every generic point `η` of
an irreducible component of the reduced scheme `T` is the image `νᵢ(ηᵢ)` of the generic point of a
normalization component, and `νᵢ` is an isomorphism of local rings there. -/
private theorem exists_base_genericPoint_eq {k : Type} [Field k] {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    [IsReduced T] (N : MMP.Flips.NormalizationComponents sT hT) {η : T} (hη : η ∈ genericPoints T) :
    ∃ i, (N.n i).base (genericPoint (N.X i)) = η ∧
      IsIso ((N.n i).stalkMap (genericPoint (N.X i))) := by
  obtain ⟨φ, hφ⟩ := N.exists_iso
  have hbir : IsBirational (MMP.Flips.slcCurveNormalization T hT) := Scheme.isBirational_normalization T hT
  obtain ⟨w, hw, hwη⟩ := hbir.1.surjOn hη
  obtain ⟨⟨i, u⟩, hu⟩ := (sigmaMk N.X).surjective (φ.inv.base w)
  set e := Limits.Sigma.ι N.X i ≫ φ.hom with he
  have heu : e.base u = w := by
    have h2 : φ.hom.base (φ.inv.base w) = w := by
      rw [← Scheme.Hom.comp_apply φ.inv φ.hom, Iso.inv_hom_id]
      rfl
    rw [he, Scheme.Hom.comp_apply, ← sigmaMk_mk, hu, h2]
  have hne : e ≫ MMP.Flips.slcCurveNormalization T hT = N.n i := by
    rw [he, Category.assoc, hφ, Limits.Sigma.ι_desc]
  have hu0 : u = genericPoint (N.X i) := by
    have hmax : IsMax w := Stacks.Chow.isMax_of_mem_genericPoints ⟨w, hw⟩
    have h1 : genericPoint (N.X i) ⤳ u :=
      (genericPoint_spec (N.X i)).specializes (Set.mem_univ u)
    have h2 : e.base u ≤ e.base (genericPoint (N.X i)) :=
      Scheme.le_iff_specializes.mpr (h1.map e.continuous)
    rw [heu] at h2
    have h3 := hmax h2
    rw [← heu, Scheme.le_iff_specializes] at h3
    have h4 : u ⤳ genericPoint (N.X i) := e.isOpenEmbedding.toIsInducing.specializes_iff.mp h3
    exact (h4.antisymm h1).eq
  subst hu0
  refine ⟨i, ?_, ?_⟩
  · rw [← hne]
    change (MMP.Flips.slcCurveNormalization T hT).base (e.base _) = η
    rw [heu, hwη]
  · have key : ∀ g : N.X i ⟶ T, g = e ≫ MMP.Flips.slcCurveNormalization T hT →
        IsIso (g.stalkMap (genericPoint (N.X i))) := by
      intro g hg
      subst hg
      rw [Scheme.Hom.stalkMap_comp]
      haveI h1 : IsIso ((MMP.Flips.slcCurveNormalization T hT).stalkMap
          (e.base (genericPoint (N.X i)))) := by
        rw [heu]; exact hbir.2 w hw
      have h2 : IsIso (e.stalkMap (genericPoint (N.X i))) :=
        IsOpenImmersion.instIsIsoCommRingCatStalkMap _ _
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ h1 h2
    exact key _ hne.symm

/-- **A function on `T` is detected on the normalization.** A nonzero function on an open `V` of
the reduced scheme `T` has a nonzero pull-back to the function field of some normalization
component meeting `V`: it has a nonzero germ at a generic point of `T`, where the normalization
is an isomorphism of local rings. -/
private theorem exists_germToFunctionField_ne_zero {k : Type} [Field k] {T : Scheme.{0}}
    {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    [IsReduced T] (N : MMP.Flips.NormalizationComponents sT hT) {V : T.Opens} (c : Γ(T, V))
    (hc : c ≠ 0) : ∃ i, ∃ _ : Nonempty (N.n i ⁻¹ᵁ V),
      ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ V)).hom ((N.n i).app V c) ≠ 0 := by
  obtain ⟨η, hηV, hη, hgerm⟩ := exists_mem_genericPoints_germ_ne_zero' c hc
  obtain ⟨i, hηeq, hiso⟩ := exists_base_genericPoint_eq N hη
  subst hηeq
  haveI : Nonempty (N.n i ⁻¹ᵁ V) := ⟨⟨_, hηV⟩⟩
  refine ⟨i, inferInstance, ?_⟩
  intro h0
  apply hgerm
  have h1 := Scheme.Hom.germ_stalkMap_apply (N.n i) V (genericPoint (N.X i)) hηV c
  apply (ConcreteCategory.bijective_of_isIso ((N.n i).stalkMap (genericPoint (N.X i)))).1
  rw [h1, map_zero]
  exact h0

/-- **Descents glue.** On the reduced scheme `T`, a function is determined by its pull-backs to
the normalization components, so descents over the members of a family of opens glue to a descent
over their union. -/
private theorem descendsOn_iSup {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    {N : MMP.Flips.NormalizationComponents sT hT} [IsReduced T] {φ : ∀ i, (N.X i).functionField}
    {ι : Type} (V : ι → T.Opens) (hV : ∀ j, DescendsOn N φ (V j)) :
    DescendsOn N φ (⨆ j, V j) := by
  choose b hb using hV
  have hcompat : TopCat.Presheaf.IsCompatible T.presheaf V b := by
    intro j j'
    by_contra hne
    obtain ⟨i, hi, hi0⟩ := exists_germToFunctionField_ne_zero N _ (sub_ne_zero.mpr hne)
    apply hi0
    have hj : Nonempty (N.n i ⁻¹ᵁ V j) := ⟨⟨hi.some.1, hi.some.2.1⟩⟩
    have hj' : Nonempty (N.n i ⁻¹ᵁ V j') := ⟨⟨hi.some.1, hi.some.2.2⟩⟩
    rw [map_sub, map_sub, sub_eq_zero]
    have e1 := germToFunctionField_app_res N i (inf_le_left : V j ⊓ V j' ≤ V j) (b j)
    have e2 := germToFunctionField_app_res N i (inf_le_right : V j ⊓ V j' ≤ V j') (b j')
    exact e1.trans ((hb j i hj).symm.trans ((hb j' i hj').trans e2.symm))
  obtain ⟨t, ht, -⟩ := T.sheaf.existsUnique_gluing V b hcompat
  refine ⟨t, fun i hi => ?_⟩
  obtain ⟨x, hx⟩ := hi.some
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have hne : Nonempty (N.n i ⁻¹ᵁ V j) := ⟨⟨x, hj⟩⟩
  have hle : V j ≤ iSup V := le_iSup V j
  have e1 := germToFunctionField_app_res N i hle t
  have e2 : t |_ V j = b j := ht j
  exact (hb j i hne).trans ((congrArg (fun s => ((N.X i).germToFunctionField
    (N.n i ⁻¹ᵁ V j)).hom ((N.n i).app (V j) s)) e2).symm.trans e1)

/-- In the one-dimensional space of rational `m`-canonical top forms, every form is a multiple
of a given nonzero one. -/
private theorem exists_eq_smul_of_ne_zero {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY] {d : ℕ}
    (hd : topologicalKrullDim Y = d) {m : ℤ} {ρ : RationalPluriForms sY d m} (hρ : ρ ≠ 0)
    (τ : RationalPluriForms sY d m) : ∃ c : Y.functionField, τ = c • ρ := by
  letI := functionFieldAlgebra sY
  obtain ⟨b⟩ := exists_basis_topForms (sX := sY) hd
  let bb : Module.Basis Unit Y.functionField (RationalPluriForms sY d m) := ZTensorPower.basis b m
  have hrank : Module.finrank Y.functionField (RationalPluriForms sY d m) = 1 := by
    rw [Module.finrank_eq_card_basis bb, Fintype.card_unit]
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' ρ hρ).mp hrank τ
  exact ⟨c, hc.symm⟩

/-- The `k`-homomorphism of function fields `k(X) → k(T)` of a dominant morphism `h : T ⟶ X`
over `k`. -/
private noncomputable def ffHom {k : Type u} [Field k] {X T : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    {sT : T ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral T] (h : T ⟶ X) [IsDominant h]
    (hT : h ≫ sX = sT) : FunctionFieldHom sT sX :=
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra sT
  { toRingHom := functionFieldMap h
    commutes' := fun c => by
      subst hT
      letI := functionFieldMapAlgebra h
      have := isScalarTower_functionFieldMap sX h
      exact (IsScalarTower.algebraMap_apply k X.functionField T.functionField c).symm }

/-- The pull-back of forms along a dominant morphism is the pluriform pull-back along any
function field equivalence inducing `functionFieldMap`. -/
private theorem pullbackRationalPluriForms_eq_pluriformPullback {k : Type u} [Field k]
    {X T : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsIntegral T] (h : T ⟶ X)
    [IsDominant h] (σ : FunctionFieldEquiv (h ≫ sX) sX) (hσ : ∀ a, σ a = functionFieldMap h a)
    {d : ℕ} {m : ℤ} (τ : RationalPluriForms sX d m) :
    pullbackRationalPluriForms sX h τ = pluriformPullback (h ≫ sX) sX σ.toHom d m τ := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (h ≫ sX)
  have e : σ.toHom = ffHom h rfl := AlgHom.ext fun a => hσ a
  rw [e]
  rfl

/-- The pull-back of rational forms is `k(W)`-semilinear along `g^* : k(W) → k(V)`. -/
private theorem pullbackRationalPluriForms_smul' {k : Type u} [Field k] {V W : Scheme.{u}}
    {sW : W ⟶ Spec (.of k)} [IsIntegral W] [IsIntegral V] (g : V ⟶ W) [IsDominant g] {d : ℕ}
    {m : ℤ} (a : W.functionField) (τ : RationalPluriForms sW d m) :
    pullbackRationalPluriForms sW g (a • τ) =
      functionFieldMap g a • pullbackRationalPluriForms sW g τ := by
  let := functionFieldAlgebra sW
  let := functionFieldAlgebra (g ≫ sW)
  let := functionFieldMapAlgebra g
  have := isScalarTower_functionFieldMap sW g
  exact pullbackForms_smul (K := W.functionField) (K' := V.functionField) (m := m) a τ

/-- Transport of an equation `a = c • b` along equal structure morphisms. -/
private theorem eq_smul_of_heq {Y : Scheme.{0}} [IsIntegral Y] {s s' : Y ⟶ Spec (.of ℂ)}
    (h : s = s') {d : ℕ} {m : ℤ} {a b : RationalPluriForms s d m}
    {a' b' : RationalPluriForms s' d m} (ha : HEq a a') (hb : HEq b b') (c : Y.functionField)
    (h' : a' = c • b') : a = c • b := by
  subst h
  cases ha
  cases hb
  exact h'

/-- The order of a form along a prime divisor does not depend on the spelling of the structure
morphism. -/
private theorem ordForm_congr_heq {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {s s' : Y ⟶ Spec (.of ℂ)} (h : s = s') {d : ℕ} {m : ℤ}
    {a : RationalPluriForms s d m} {a' : RationalPluriForms s' d m} (ha : HEq a a')
    (Γ : Mori.PrimeDivisor Y) : Γ.ordForm a = Γ.ordForm a' := by
  subst h
  cases ha
  rfl

/-- The image of a prime divisor under an isomorphism. -/
private theorem exists_primeDivisor_genericPoint_eq_of_iso {C T : Scheme.{0}} (p : C ≅ T)
    (Γ : Mori.PrimeDivisor C) :
    ∃ Γ' : Mori.PrimeDivisor T, Γ'.genericPoint = p.hom Γ.genericPoint := by
  have hmono : ∀ {A A' : Scheme.{0}} (g : A ⟶ A') [IsIso g], StrictMono g.base := by
    intro A A' g _
    exact fun a b hab => lt_of_specializes_of_ne (hab.le.map g.base.hom.continuous)
      (fun h => hab.ne (g.isClosedEmbedding.injective h))
  have hcoh : Order.coheight (p.hom Γ.genericPoint) = 1 := by
    refine le_antisymm ?_ ?_
    · have h1 := Order.coheight_le_coheight_apply_of_strictMono _ (hmono p.inv)
        (p.hom Γ.genericPoint)
      have hinv : p.inv (p.hom Γ.genericPoint) = Γ.genericPoint := by
        rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
      rw [hinv, Γ.coheight_genericPoint] at h1
      exact h1
    · have h1 := Order.coheight_le_coheight_apply_of_strictMono _ (hmono p.hom) Γ.genericPoint
      rw [Γ.coheight_genericPoint] at h1
      exact h1
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh,
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _⟩

/-- **Orders along an isomorphism.** The order of the pull-back of a form along an isomorphism
`p : C ≅ T` along a prime divisor `Γ` is the order of the form along `p(Γ)`. -/
private theorem ordForm_pullback_eq_of_iso {C T : Scheme.{0}} [IsIntegral C]
    [IsLocallyNoetherian C] [IsNormal C] [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T]
    {sT : T ⟶ Spec (.of ℂ)} (hT : IsNormalVariety ℂ sT) {d : ℕ} (hdT : topologicalKrullDim T = d)
    (p : C ≅ T) (hCn : IsNormalVariety ℂ (p.hom ≫ sT)) (Γ : Mori.PrimeDivisor C)
    (Γ' : Mori.PrimeDivisor T) (hΓ : Γ'.genericPoint = p.hom Γ.genericPoint) {m : ℤ}
    (τ : RationalPluriForms sT d m) :
    Γ.ordForm (pullbackRationalPluriForms sT p.hom τ) = Γ'.ordForm τ := by
  set D : DivisorOver ℂ sT := ⟨C, p.hom, hCn, isBirationalMorphism_of_isIso _, Γ⟩
  have hv := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hT D Γ' hΓ.symm
  have h1 := MMP.Threefold.Mori.ModelIndependence.ordPullback_eq_of_valuation_eq hT hdT hv τ
  rw [DivisorOver.ordPullback_ofPrimeDivisor hT hdT Γ' τ] at h1
  exact h1

/-- Every point of a scheme lies on a normalization component. -/
private theorem exists_base_eq' {k : Type} [Field k] {T : Scheme.{0}} {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : MMP.Flips.NormalizationComponents sT hT) (x : T) : ∃ i z, (N.n i).base z = x := by
  obtain ⟨φ, hφ⟩ := N.exists_iso
  have hsurj : Surjective (MMP.Flips.slcCurveNormalization T hT) := Scheme.surjective_normalization T hT
  obtain ⟨w, rfl⟩ := hsurj.surj x
  obtain ⟨⟨i, z⟩, hz⟩ := (sigmaMk N.X).surjective (φ.inv.base w)
  refine ⟨i, z, ?_⟩
  have h1 : (Limits.Sigma.ι N.X i ≫ φ.hom ≫ MMP.Flips.slcCurveNormalization T hT).base z =
      (N.n i).base z := by
    rw [hφ, Limits.Sigma.ι_desc]
  have h2 : φ.hom.base (φ.inv.base w) = w := by
    rw [← Scheme.Hom.comp_apply φ.inv φ.hom, Iso.inv_hom_id]
    rfl
  rw [← h1, Scheme.Hom.comp_apply, ← sigmaMk_mk, hz, Scheme.Hom.comp_apply, h2]

/-- **Functions on a reduced scheme are detected on its normalization.** A function on an open
`U` of the reduced scheme `T` whose pull-back to every normalization component meeting `U`
vanishes in the function field is zero. -/
private theorem eq_zero_of_forall_germToFunctionField_eq_zero {k : Type} [Field k]
    {T : Scheme.{0}} [IsReduced T] {sT : T ⟶ Spec (.of k)}
    {hT : ∀ U : T.Opens, IsCompact (U : Set T) → (irreducibleComponents U).Finite}
    (N : MMP.Flips.NormalizationComponents sT hT) {U : T.Opens} (b : Γ(T, U))
    (h : ∀ i (_ : Nonempty (N.n i ⁻¹ᵁ U)),
      ((N.X i).germToFunctionField (N.n i ⁻¹ᵁ U)).hom ((N.n i).app U b) = 0) : b = 0 := by
  rw [← basicOpen_eq_bot_iff]
  refine eq_bot_iff.mpr fun x hx => ?_
  obtain ⟨i, z, rfl⟩ := exists_base_eq' N x
  have hzU : z ∈ N.n i ⁻¹ᵁ U := T.basicOpen_le b hx
  haveI : Nonempty (N.n i ⁻¹ᵁ U) := ⟨⟨z, hzU⟩⟩
  have hz : z ∈ (N.X i).basicOpen ((N.n i).app U b) := by
    rw [← Scheme.preimage_basicOpen]
    exact hx
  have h0 : (N.n i).app U b = 0 :=
    (N.X i).germToFunctionField_injective (N.n i ⁻¹ᵁ U) ((h i inferInstance).trans (map_zero _).symm)
  rw [h0, Scheme.basicOpen_zero] at hz
  exact hz

/-- **Residues of unit multiples.** If `τ = r τ'` for a function `r` on an open `V` containing
the generic point of the floor component `S`, then `Res_S τ = (r|_S) Res_S τ'`. -/
private theorem isPoincareResidue_eq_germ_smul {Y S : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sY]
    [IsIntegral S] {j : S ⟶ Y} {BY : QDivisor Y} {BS : QDivisor S}
    (hS : IsAdjunctionStep sY BY j BS) {n m : ℕ} {V : Y.Opens} [Nonempty V]
    [Nonempty (j ⁻¹ᵁ V)] (hV : j (genericPoint S) ∈ V) (r : Γ(Y, V))
    {τ τ' : RationalPluriForms sY (n + 1) m} (hτ : τ = (Y.germToFunctionField V).hom r • τ')
    {ρ ρ' : RationalPluriForms (j ≫ sY) n m} (hρ : IsPoincareResidue sY j n m τ ρ)
    (hρ' : IsPoincareResidue sY j n m τ' ρ') :
    ρ = (S.germToFunctionField (j ⁻¹ᵁ V)).hom (j.app V r) • ρ' := by
  have h1 := MMP.CyclicChartDifferent.Aux.IsPoincareResidue.algebraMap_smul hρ'
    (Y.presheaf.germ V _ hV r)
  rw [Scheme.algebraMap_germ_eq_germToFunctionField, ← hτ, Scheme.Hom.germ_stalkMap_apply] at h1
  exact IsPoincareResidue.unique hS hρ h1

/-- **Gluing the local sections `G_e^a · e^{-ar}`.** Functions `G_e` on `V ∩ U`, one for each local
equation `e` of `H` on `U`, whose residue values along the floor components have the
transition behaviour of the base forms `f^*e^{-r} w^{⊗kr}`, glue to a global section of
`ι_V^* 𝒪_R(arH)` restricting to `G_e^a · e^{-ar}` on each `U`. -/
private theorem exists_section_glue_of_isPoincareResidue
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} (hX : Mori.IsProjectiveVariety ℂ sX) {n : ℕ} {B : QDivisor X}
    {R : Scheme.{0}} [IsIntegral R] [IsLocallyNoetherian R] [IsNormal R]
    (f : X ⟶ R) [IsDominant f] {k : ℕ} {H : Divisor R} (hH : H.IsCartier)
    {u : X.functionField}
    {V : Scheme.{0}} (ιV : V ⟶ R) [IsClosedImmersion ιV] [IsReduced V]
    (C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    (j : ∀ P, C P ⟶ X) (BC : ∀ P, QDivisor (C P))
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P)) {r : ℕ}
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (gV : ∀ P, C P ⟶ V) (hgV : ∀ P, gV P ≫ ιV = j P ≫ f)
    {t : ∀ P, logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)} {a : ℕ}
    (G : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e → Γ(V, ιV ⁻¹ᵁ U))
    (hρex : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∀ P, f (j P (genericPoint (C P))) ∈ U →
        ∃ ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ),
          IsPoincareResidue sX (j P) n (k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)) ρ ∧ ρ ≠ 0)
    (hG : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ) (he : H.IsLocalEquation U e) (P)
      (hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U)
      (ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ)),
        IsPoincareResidue sX (j P) n (k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)) ρ →
          ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
              RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ)) =
            ((gV P).stalkMap (genericPoint (C P))).hom
              (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV (G U e he)) • ρ)
    (hinj : ∀ (U' : R.Opens) (b : Γ(V, ιV ⁻¹ᵁ U')),
      (∀ P (hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U'),
        ((gV P).stalkMap (genericPoint (C P))).hom (V.presheaf.germ (ιV ⁻¹ᵁ U') _ hPV b) = 0) →
      b = 0) :
    ∃ σ : Γ((Scheme.Modules.pullback ιV ⋙ Scheme.Modules.pushforward ιV).obj
        ((a * r) • H).divisorialSheaf, ⊤), ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ)
        (he : H.IsLocalEquation U e),
      ((Scheme.Modules.pullback ιV ⋙ Scheme.Modules.pushforward ιV).obj
          ((a * r) • H).divisorialSheaf).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op σ =
        (show Γ((Scheme.Modules.pullback ιV).obj ((a * r) • H).divisorialSheaf, ιV ⁻¹ᵁ U) from
          (G U e he ^ a) • (show Γ((Scheme.Modules.pullback ιV).obj ((a * r) • H).divisorialSheaf,
              ιV ⁻¹ᵁ U) from
            ((Scheme.Modules.pullbackPushforwardAdjunction ιV).unit.app
              ((a * r) • H).divisorialSheaf).app U (isLocalEquation_pow he (a * r)).invSection)) := by
  classical
  let τ : R.Opens → (RationalFunctions R)ˣ → RationalPluriForms sX (n + 1) ((k * r : ℕ) : ℤ) :=
    fun _ e => ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
      (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)
  set D := ((a * r) • H).divisorialSheaf with hD
  set E := (Scheme.Modules.pullback ιV ⋙ Scheme.Modules.pushforward ιV).obj D with hE
  set η := (Scheme.Modules.pullbackPushforwardAdjunction ιV).unit.app D with hη
  let ι := Σ U : R.Opens, {e : (RationalFunctions R)ˣ // H.IsLocalEquation U e}
  let Uc : ι → R.Opens := fun c => c.1
  let sc : ∀ c : ι, Γ(E, Uc c) := fun c =>
    (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ c.1) from
      (G c.1 c.2.1 c.2.2 ^ a) • (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ c.1) from
        η.app c.1 (isLocalEquation_pow c.2.2 (a * r)).invSection))
  have hnatη : ∀ {V₁ V₂ : R.Opens} (i : V₁ ⟶ V₂) (x : Γ(D, V₂)),
      η.app V₁ (D.presheaf.map i.op x) = E.presheaf.map i.op (η.app V₂ x) := fun i x =>
    congrArg (fun F => F x) (η.mapPresheaf.naturality i.op)
  have hcompat : TopCat.Presheaf.IsCompatible E.presheaf Uc sc := by
    rintro ⟨U₁, e₁, he₁⟩ ⟨U₂, e₂, he₂⟩
    -- the transition function between the two local equations
    obtain ⟨d, hd⟩ := (he₂.isLocalGenerator_invSection (U₁ ⊓ U₂) inf_le_right).2
      (H.divisorialSheaf.presheaf.map (homOfLE inf_le_left).op he₁.invSection)
    have hdpow : D.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op
        (isLocalEquation_pow he₁ (a * r)).invSection = d ^ (a * r) •
        D.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op
          (isLocalEquation_pow he₂ (a * r)).invSection := by
      refine Subtype.ext (funext fun Z => ?_)
      have hZ := congrFun (congrArg Subtype.val hd) Z
      change R.presheaf.germ (U₁ ⊓ U₂) (componentGenericPoint R Z.1) Z.2 d *
          (((e₂⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) Z.1) =
        (((e₁⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) Z.1) at hZ
      change (((e₁ ^ (a * r))⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) Z.1 =
        R.presheaf.germ (U₁ ⊓ U₂) (componentGenericPoint R Z.1) Z.2 (d ^ (a * r)) *
          (((e₂ ^ (a * r))⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) Z.1
      rw [← inv_pow, ← inv_pow, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val,
        Pi.pow_apply, Pi.pow_apply, map_pow, ← hZ, mul_pow]
    have hG12 : (V.presheaf.map (homOfLE (ιV.preimage_mono (inf_le_left : U₁ ⊓ U₂ ≤ U₁))).op
        (G U₁ e₁ he₁)) ^ a * ιV.app (U₁ ⊓ U₂) (d ^ (a * r)) =
        (V.presheaf.map (homOfLE (ιV.preimage_mono (inf_le_right : U₁ ⊓ U₂ ≤ U₂))).op
          (G U₂ e₂ he₂)) ^ a := by
      have hG12' : V.presheaf.map (homOfLE (ιV.preimage_mono (inf_le_left : U₁ ⊓ U₂ ≤ U₁))).op
            (G U₁ e₁ he₁) * ιV.app (U₁ ⊓ U₂) (d ^ r) =
          V.presheaf.map (homOfLE (ιV.preimage_mono (inf_le_right : U₁ ⊓ U₂ ≤ U₂))).op
            (G U₂ e₂ he₂) := by
        rw [← sub_eq_zero]
        symm
        rw [eq_comm]
        apply hinj (U₁ ⊓ U₂)
        intro P hPV
        rw [map_sub, map_sub, map_mul, map_mul, TopCat.Presheaf.germ_res_apply,
          TopCat.Presheaf.germ_res_apply, sub_eq_zero]
        have hP12 : f (j P (genericPoint (C P))) ∈ U₁ ⊓ U₂ := by
          have h := hPV
          change ιV (gV P (genericPoint (C P))) ∈ U₁ ⊓ U₂ at h
          rwa [← Scheme.Hom.comp_apply, hgV P, Scheme.Hom.comp_apply] at h
        have hPV₁ : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U₁ := hPV.1
        have hPV₂ : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U₂ := hPV.2
        obtain ⟨ρ₁, hρ₁, -⟩ := hρex U₁ e₁ he₁ P hP12.1
        obtain ⟨ρ₂, hρ₂, hρ₂0⟩ := hρex U₂ e₂ he₂ P hP12.2
        have ht₁ := hG U₁ e₁ he₁ P hPV₁ ρ₁ hρ₁
        have ht₂ := hG U₂ e₂ he₂ P hPV₂ ρ₂ hρ₂
        haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
        haveI : Nonempty (U₁ ⊓ U₂ : R.Opens) := ⟨⟨_, hP12⟩⟩
        haveI : Nonempty (f ⁻¹ᵁ (U₁ ⊓ U₂)) := ⟨⟨_, hP12⟩⟩
        haveI : Nonempty (j P ⁻¹ᵁ (f ⁻¹ᵁ (U₁ ⊓ U₂))) := ⟨⟨_, hP12⟩⟩
        -- the transition function at the generic point of `R`
        have hZ : componentGenericPoint R (univComponent R) ∈ U₁ ⊓ U₂ :=
          LocalFrame.componentGenericPoint_mem_of_isIntegral (univComponent R) ⟨_, hP12⟩
        have hZ0 := congrFun (congrArg Subtype.val hd) ⟨univComponent R, hZ⟩
        change R.presheaf.germ (U₁ ⊓ U₂) (componentGenericPoint R (univComponent R)) hZ d *
            (((e₂⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) (univComponent R)) =
          (((e₁⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) (univComponent R)) at hZ0
        have hkey0 : (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e₁ : RationalFunctions R))⁻¹ =
            R.germToFunctionField (U₁ ⊓ U₂) d *
              (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
                (e₂ : RationalFunctions R))⁻¹ := by
          have i1 := evalFF_inv_pow e₁ 1
          have i2 := evalFF_inv_pow e₂ 1
          rw [pow_one, pow_one] at i1 i2
          rw [← i1, ← i2]
          change (R.presheaf.stalkSpecializes _).hom
              (((e₁⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) (univComponent R)) =
            _ * (R.presheaf.stalkSpecializes _).hom
              (((e₂⁻¹ : (RationalFunctions R)ˣ) : RationalFunctions R) (univComponent R))
          rw [← hZ0, map_mul]
          congr 1
          exact TopCat.Presheaf.germ_stalkSpecializes_apply R.presheaf hZ _ d
        have hkey : (functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e₁ : RationalFunctions R)))⁻¹ =
            X.germToFunctionField (f ⁻¹ᵁ (U₁ ⊓ U₂)) (f.app (U₁ ⊓ U₂) d) *
              (functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
                (e₂ : RationalFunctions R)))⁻¹ := by
          rw [← map_inv₀, hkey0, map_mul, map_inv₀,
            MMP.Spreading.functionFieldMap_germToFunctionField f (U₁ ⊓ U₂) (f ⁻¹ᵁ (U₁ ⊓ U₂))
              le_rfl, Scheme.Hom.appLE_eq_app]
        have hτ : τ U₁ e₁ = (X.germToFunctionField (f ⁻¹ᵁ (U₁ ⊓ U₂))).hom
            (f.app (U₁ ⊓ U₂) (d ^ r)) • τ U₂ e₂ := by
          change ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e₁ : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r) =
            _ • (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e₂ : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r))
          rw [hkey, mul_assoc, mul_pow, mul_smul, map_pow, map_pow]
        have hρ₁₂ := isPoincareResidue_eq_germ_smul (hC P) hP12 _ hτ hρ₁ hρ₂
        have hc := stalkMap_germ_app_eq (gV P) ιV (j P) f (hgV P) (U₁ ⊓ U₂)
          (genericPoint (C P)) hPV hP12 (d ^ r)
        rw [hρ₁₂, smul_smul] at ht₁
        have hcc : ((j P).stalkMap (genericPoint (C P))).hom
            (X.presheaf.germ (f ⁻¹ᵁ (U₁ ⊓ U₂)) _ hP12 (f.app (U₁ ⊓ U₂) (d ^ r))) =
            ((C P).germToFunctionField (j P ⁻¹ᵁ (f ⁻¹ᵁ (U₁ ⊓ U₂)))).hom
              ((j P).app _ (f.app (U₁ ⊓ U₂) (d ^ r))) :=
          Scheme.Hom.germ_stalkMap_apply (j P) _ _ _ _
        rw [hc, hcc]
        exact smul_left_injective _ hρ₂0 (ht₁.symm.trans ht₂)
      rw [← hG12', mul_pow]
      congr 1
      rw [← map_pow, ← pow_mul, mul_comm r a]
    change ((Scheme.Modules.pullback ιV).obj D).presheaf.map
        (homOfLE (ιV.preimage_mono (inf_le_left : U₁ ⊓ U₂ ≤ U₁))).op
          ((G U₁ e₁ he₁ ^ a) • (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ U₁) from
            η.app U₁ (isLocalEquation_pow he₁ (a * r)).invSection)) =
      ((Scheme.Modules.pullback ιV).obj D).presheaf.map
        (homOfLE (ιV.preimage_mono (inf_le_right : U₁ ⊓ U₂ ≤ U₂))).op
          ((G U₂ e₂ he₂ ^ a) • (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ U₂) from
            η.app U₂ (isLocalEquation_pow he₂ (a * r)).invSection))
    rw [Scheme.Modules.map_smul, Scheme.Modules.map_smul, map_pow, map_pow]
    have h1 : ((Scheme.Modules.pullback ιV).obj D).presheaf.map
        (homOfLE (ιV.preimage_mono (inf_le_left : U₁ ⊓ U₂ ≤ U₁))).op
          (η.app U₁ (isLocalEquation_pow he₁ (a * r)).invSection) =
        η.app (U₁ ⊓ U₂) (D.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op
          (isLocalEquation_pow he₁ (a * r)).invSection) :=
      (hnatη (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)) _).symm
    have h2 : ((Scheme.Modules.pullback ιV).obj D).presheaf.map
        (homOfLE (ιV.preimage_mono (inf_le_right : U₁ ⊓ U₂ ≤ U₂))).op
          (η.app U₂ (isLocalEquation_pow he₂ (a * r)).invSection) =
        η.app (U₁ ⊓ U₂) (D.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op
          (isLocalEquation_pow he₂ (a * r)).invSection) :=
      (hnatη (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)) _).symm
    erw [h1, h2, hdpow, Scheme.Modules.Hom.app_smul]
    have h3 : ∀ y : Γ(E, U₁ ⊓ U₂), d ^ (a * r) • y =
        (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ (U₁ ⊓ U₂)) from
          ιV.app (U₁ ⊓ U₂) (d ^ (a * r)) •
            (show Γ((Scheme.Modules.pullback ιV).obj D, ιV ⁻¹ᵁ (U₁ ⊓ U₂)) from y)) :=
      fun _ => rfl
    rw [h3]
    exact (smul_smul _ _ _).trans (congrArg (· • _) hG12)
  obtain ⟨σ', hσ', -⟩ := TopCat.Sheaf.existsUnique_gluing
    (⟨E.presheaf, Scheme.Modules.isSheaf E⟩ : TopCat.Sheaf Ab R) Uc sc hcompat
  have hcover : (⊤ : R.Opens) ≤ ⨆ c, Uc c := fun x _ => by
    obtain ⟨U, hx, e, he⟩ := hH x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, e, he⟩, hx⟩
  refine ⟨E.presheaf.map (homOfLE hcover).op σ', fun U e he => ?_⟩
  have h1 := hσ' ⟨U, e, he⟩
  have h2 : E.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
      (E.presheaf.map (homOfLE hcover).op σ') =
      E.presheaf.map (TopologicalSpace.Opens.leSupr Uc ⟨U, e, he⟩).op σ' := by
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  exact h2.trans h1

/-- **An admissible floor system is a section of `M|_V`.** An admissible system `t` of sections of
`m(K_{C_P} + B_{C_P})`, `m = kr`, descends to the floor `S` and, through `f_* 𝒪_S = 𝒪_V`, to
`V = f(S)`: for every `a > 0` there is a global section `σ` of `ι_V^* 𝒪_R(arH)` such that, near
the image of the generic point of every floor component `C_P`, `σ = g · e^{-ar}` for a local
equation `e` of `H` and a function `g` on `V` whose value along `C_P` is `γ^a`, where
`t_P = γ · Res_{C_P}(f^*e^{-r} w^{⊗kr})`. -/
private theorem exists_section_of_mem_admissibleSections
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} (hX : Mori.IsProjectiveVariety ℂ sX) {n : ℕ}
    (hdim : topologicalKrullDim X = (n + 1 : ℕ)) (hQ : IsQFactorial sX)
    {B : QDivisor X} (hB : IsPair sX B) (hdlt : MMP.Intersection.IsDltPair sX B)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (n + 1))
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X ⟶ R) [IsDominant f] (hf : f ≫ sR = sX) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier)
    {M : Divisor X} {u : X.functionField} (hu0 : u ≠ 0)
    (hMu : ∀ Γ : Mori.PrimeDivisor X,
      (X.ord u Γ.genericPoint : ℚ) = M.coeff Γ - k * (K.coeff Γ + B.coeff Γ))
    (hM : ∃ hfH, H.IsPullback f hfH M)
    (hS0 : B.roundDown ≠ 0)
    {S : Scheme.{0}} (ιS : S ⟶ X) [IsClosedImmersion ιS] [IsReduced S]
    (hS : Set.range ιS.base = ⋃ E ∈ B.roundDown.support, (E.support : Set X))
    {V : Scheme.{0}} (ιV : V ⟶ R) [IsClosedImmersion ιV] [IsReduced V]
    (hV : Set.range ιV.base = f.base '' Set.range ιS.base)
    (fS : S ⟶ V) (hfS : fS ≫ ιV = ιS ≫ f) (hfSO : ∀ U : V.Opens, IsIso (fS.app U))
    (C : {P : Mori.PrimeDivisor X // ⌊B.coeff P⌋ ≠ 0} → Scheme.{0})
    [∀ P, IsIntegral (C P)] [∀ P, IsLocallyNoetherian (C P)] [∀ P, IsNormal (C P)]
    (j : ∀ P, C P ⟶ X) (BC : ∀ P, QDivisor (C P))
    (hC : ∀ P, IsAdjunctionStep sX B (j P) (BC P) ∧
      Set.range (j P).base = (P.1.support : Set X))
    {r : ℕ} (hm : Even (k * r))
    (hCartKB : (((k * r : ℕ) : ℤ) • (Divisor.toQDivisor K + B)).IsCartierDivisor)
    (RS : ResidueRestriction (fun P => j P ≫ sX) BC n (k * r))
    (w : letI := functionFieldAlgebra sX; ⋀[X.functionField]^(n + 1) Ω[X.functionField⁄ℂ])
    (hw : ∀ N : ℕ, 0 < N → formPowR sX w N ≠ 0 ∧
      ∀ Γ : Mori.PrimeDivisor X, Γ.ordForm (formPowR sX w N) = N * K.coeff Γ)
    (gV : ∀ P, C P ⟶ V) (hgV : ∀ P, gV P ≫ ιV = j P ≫ f)
    {t : ∀ P, logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)}
    (ht : t ∈ admissibleSections RS) {a : ℕ} (ha : 0 < a) :
    ∃ σ : Γ((Scheme.Modules.pullback ιV ⋙ Scheme.Modules.pushforward ιV).obj
        ((a * r) • H).divisorialSheaf, ⊤),
      ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ) (he : H.IsLocalEquation U e) (P)
        (hP : f (j P (genericPoint (C P))) ∈ U),
        ∃ (ω₁ : letI := functionFieldAlgebra (j P ≫ sX);
            ⋀[(C P).functionField]^n Ω[(C P).functionField⁄ℂ])
          (c₁ γ : (C P).functionField) (g : Γ(V, ιV ⁻¹ᵁ U))
          (hPV : gV P (genericPoint (C P)) ∈ ιV ⁻¹ᵁ U),
          IsPoincareResidue sX (j P) n (k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r))
            (c₁ • formPowR (j P ≫ sX) ω₁ (k * r)) ∧
          ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
              RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ)) =
            γ • (c₁ • formPowR (j P ≫ sX) ω₁ (k * r)) ∧
          ((Scheme.Modules.pullback ιV ⋙ Scheme.Modules.pushforward ιV).obj
              ((a * r) • H).divisorialSheaf).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op σ =
            (show Γ((Scheme.Modules.pullback ιV).obj ((a * r) • H).divisorialSheaf, ιV ⁻¹ᵁ U) from
              g • (show Γ((Scheme.Modules.pullback ιV).obj ((a * r) • H).divisorialSheaf,
                  ιV ⁻¹ᵁ U) from
                ((Scheme.Modules.pullbackPushforwardAdjunction ιV).unit.app
                  ((a * r) • H).divisorialSheaf).app U
                  (isLocalEquation_pow he (a * r)).invSection)) ∧
          ((gV P).stalkMap (genericPoint (C P))).hom (V.presheaf.germ (ιV ⁻¹ᵁ U) _ hPV g) =
            γ ^ a ∧
          ∀ y : C P, (∃ W : (C P).Opens, y ∈ W ∧ GeneratesOn (BC P) (k * r) W
              ((t P : logPluricanonicalSections (j P ≫ sX) n (k * r) (BC P)) :
                RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ))) →
            ∀ hy : gV P y ∈ ιV ⁻¹ᵁ U, IsUnit (V.presheaf.germ (ιV ⁻¹ᵁ U) (gV P y) hy g) := by
  classical
  -- the base forms `f^*e^{-r} w^{⊗kr}` near the floor
  let τ : R.Opens → (RationalFunctions R)ˣ → RationalPluriForms sX (n + 1) ((k * r : ℕ) : ℤ) :=
    fun _ e => ((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
      (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR sX w (k * r)
  -- their residues along the floor components
  have hρex : ∀ (U : R.Opens) (e : (RationalFunctions R)ˣ), H.IsLocalEquation U e →
      ∀ P, f (j P (genericPoint (C P))) ∈ U →
        ∃ ρ : RationalPluriForms (j P ≫ sX) n ((k * r : ℕ) : ℤ),
          IsPoincareResidue sX (j P) n (k * r) (τ U e) ρ ∧ ρ ≠ 0 := by
    intro U e he P hP
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    haveI : CompactSpace (C P) := by
      haveI := (RS.setting.isProjectiveVariety P).toIsVariety
      exact QuasiCompact.compactSpace_of_compactSpace (j P ≫ sX)
    obtain ⟨hfH, hpb⟩ := hM
    exact exists_isPoincareResidue_ne_zero_of_generatesOn hXn hdim hdlt.2.1 (hC P).1
      (RS.setting.topologicalKrullDim_eq P)
      (generatesOn_base hdim f hpb hu0 hMu w hw RS.setting.pos he) hP
  -- the floor as an sdlt adjoint pair, its components indexed by the floor primes
  obtain ⟨-, hfin, N, Δ, Θ, hsdlt, hadj, hbij, hres⟩ :=
    isCMScheme_and_exists_isSdltAdjointPair_of_isDltPair (k := ℂ) hdim hK hX hQ hB hdlt hS0 ιS hS
  obtain ⟨π, hπ⟩ := exists_equiv_iso_floorComponents ιS N hadj hbij C j BC hC
  choose hπr pp hpp using hπ
  haveI : ∀ i, IsDominant (pp i).hom := fun i => inferInstance
  have hproj : ∀ i, IsProjectiveMorphism (pp i).hom := by
    intro i
    obtain ⟨d, j0, hj0, h0⟩ := AlgebraicGeometry.isProjectiveMorphism_id (N.X i)
    haveI := hj0
    exact ⟨d, (pp i).hom ≫ j0, inferInstance, by rw [Category.assoc, h0, Category.comp_id]⟩
  have hfam : (fun i => (pp i).hom ≫ N.n i ≫ ιS ≫ sX) = (fun i => j (π i) ≫ sX) :=
    funext fun i => by rw [← hpp i]; simp only [Category.assoc]
  obtain ⟨R', s', hs', hss'⟩ := exists_residueRestriction_congr hfam
    (residueRestrictionReindex RS π) (fun i => t (π i)) (mem_admissibleSections_reindex RS π ht)
  have hcoefAll : ∀ i (F : Mori.PrimeDivisor (C (π i))) (F' : Mori.PrimeDivisor (N.X i)),
      F'.genericPoint = (pp i).hom F.genericPoint → (BC (π i)).coeff F = (Θ i).coeff F' := by
    intro i F F' hF'
    haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
    have hXn : IsNormalVariety ℂ sX := ⟨hX.toIsVariety, inferInstance⟩
    obtain ⟨K', hdltK⟩ := hsdlt.exists_isDltPair i
    have hPW := hdltK.1
    haveI : IsProper sX := (IsProjectiveMorphism.isProjective
      (IsProjectiveVariety.isProjective (k := ℂ) (f := sX))).isProper
    obtain ⟨-, d, K₀, hK₀, hKB⟩ := hB.isPair
    have hd : d = n + 1 := by
      have := hK₀.topologicalKrullDim_eq
      rw [hdim] at this
      exact_mod_cast this.symm
    subst hd
    have hσ0 : ∀ a, (1 : FunctionFieldEquiv sX sX) a = functionFieldMap (Iso.refl X).hom a :=
      fun a => (functionFieldMap_id_apply a).symm
    have hσc0 : IsCrepantBirationalMap sX sX B B 1 :=
      (crepantBirationalAutomorphisms sX B).one_mem
    have hψX : (pp i).hom ≫ (N.n i ≫ ιS) = j (π i) ≫ (Iso.refl X).hom := by
      rw [hpp i]; rfl
    have hsT : (pp i).hom ≫ (N.n i ≫ ιS) ≫ sX = j (π i) ≫ sX := by
      rw [← Category.assoc, hpp i]
    obtain ⟨σT, hσT⟩ := exists_functionFieldEquiv_of_comp_eq (k := ℂ) (pp i).hom
      (functionFieldMap_bijective_of_isIso (pp i)) hsT
    haveI : CompactSpace (C (π i)) := by
      haveI := (RS.setting.isProjectiveVariety (π i)).toIsVariety
      exact QuasiCompact.compactSpace_of_compactSpace (j (π i) ≫ sX)
    haveI : CompactSpace (N.X i) := (Scheme.homeoOfIso (pp i)).compactSpace
    haveI : IsNoetherian (C (π i)) := {}
    have hcr := isCrepantBirationalMap_of_isAdjunctionStep_of_iso hXn hXn hdim hdim hK₀ hK₀ hKB
      hKB (Iso.refl X) (Category.id_comp sX) 1 hσ0 hσc0 (hC (π i)).1 (hadj i) (pp i) hψX σT hσT
    have hPC : MMP.Mori.IsPair (j (π i) ≫ sX) (BC (π i)) := (RS.setting.isPair (π i)).isPair
    obtain ⟨-, dC, KC, hKC, -⟩ := id hPC
    have hPN : MMP.Mori.IsPair ((N.n i ≫ ιS) ≫ sX) (Θ i) := by
      rw [Category.assoc]; exact hPW.isPair
    have hK'N : K'.IsCanonicalDivisor ((N.n i ≫ ιS) ≫ sX) n := by
      rw [Category.assoc]; exact hPW.2.1
    have hinvj : (pp i).inv ≫ j (π i) = N.n i ≫ ιS := by
      rw [← hpp i, Iso.inv_hom_id_assoc]
    have hZn : IsNormalVariety ℂ ((pp i).inv ≫ j (π i) ≫ sX) := by
      rw [← Category.assoc, hinvj, Category.assoc]; exact N.isNormalVariety i
    have hval : ∀ g, F'.divisorialValuation g = F.divisorialValuation ((σT.toHom) g) := by
      intro g
      change F'.divisorialValuation g = F.divisorialValuation (σT g)
      rw [hσT]
      exact divisorialValuation_eq_of_iso (hC (π i)).1.1 (pp i) hZn F F' hF'.symm g
    exact (coeff_eq_of_isCrepantBirationalMap hPC hPN hKC hK'N σT hcr F F' hval).symm
  have hcrep : ∀ i, ∃ (K' : Divisor (N.X i))
      (hY : IsNormalVariety ℂ ((pp i).hom ≫ N.n i ≫ ιS ≫ sX))
      (hp : IsBirationalMorphism (pp i).hom),
      IsCrepantBoundary (N.n i ≫ ιS ≫ sX) n K' (Θ i) (pp i).hom hY hp (BC (π i)) := by
    intro i
