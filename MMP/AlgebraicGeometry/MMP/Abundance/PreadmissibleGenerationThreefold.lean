                ∃ α, LiftsPow sX B jf BSf i m a (a * m) σ (t α)) := by
  obtain ⟨-, hP3⟩ := projectiveLowerLogMMP_three
  obtain ⟨-, -, P, hPp, hPn, hend⟩ := hP3 (X i) R (sX i) sR f (K i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown) (hX i) hRp hf
    (by rw [hdim i]; exact_mod_cast le_rfl) (hQ i) ⟨3, hK i⟩ (isDltPair_sub_half_roundDown hX hdim hQ hdlt i)
  rcases hend with hnef | hfin
  · exact absurd hnef (not_isRelativelyNef_of_image_eq_univ hX hdim hQ hB hdlt hK hsemi hSf i hRn
      hRp f hf hfp hfO hk hH hHamp hM hMeq hS0 heq P hPp hPn)
  · exact exists_liftsPow_of_hasFinal hX hdim hQ hB hdlt hK hsemi hSf i hRn hRp f hf hfp hfO hk
      hH hHamp hM hMeq hS0 heq P hPp hPn hfin

