  have hYp := hPp.2 P.n.toNat hjn
  have hmod := P.isRelativeDltModel P.n.toNat hjn
  have hKK := hinv.isCanonicalDivisor
  have hdimY := hKK.topologicalKrullDim_eq
  have hneg := hfinal.isNegativeExtremalContraction
  have hface := hfinal.isRelativeContractionOfFace
  have hYn := hmod.isQFactorial.1
  have hTn := hneg.isNormalVariety_target
  haveI : QuasiCompact (modelStr (sX i) P.sY P.n.toNat) := hYp.toIsVariety.toQuasiCompact
  have hgT : P.gT ≫ sR = P.sT := by
    haveI : IsAffine (Spec (.of ℂ)) := inferInstance
    exact eq_of_comp_eq_of_isIso_app_top P.g (hneg.isContraction.isIso_app ⊤)
      (by rw [← Category.assoc, hface.comp_eq, hmod.comp_eq, hneg.isContraction.comp_eq])
  have hTp : MMP.Mori.IsProjectiveVariety ℂ P.sT :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr
      ⟨hTn.1, hgT ▸ hface.isProjectiveMorphism.comp hRp.isProjective⟩
  obtain ⟨R', -, hfaceA, hray, C₀, hC₀, hR₀⟩ :=
    exists_isNegativeRelativeRayContraction hYp hTp hRp hmod.isQFactorial hface.comp_eq hgT hneg
  -- the floor and the lowered boundary
  set BB := iterTransform P.φ (B i) P.n.toNat with hBBdef
  set TT := iterTransform P.φ (Divisor.toQDivisor (B i).roundDown) P.n.toNat with hTTdef
  set KK := iterTransform P.φ (K i) P.n.toNat with hKKdef
  have hq : ∀ D : QDivisor (modelSeq (X i) P.Y P.n.toNat), D.IsQCartier :=
    isQCartier_of_isQFactorial _ hmod.isQFactorial
  have hfl : Divisor.toQDivisor (DivisorWithCoeffs.roundDown BB) = TT := by
    ext Q
    have h1 := hinv.coeff_bounds Q
    simp only [DivisorWithCoeffs.coeff_sub] at h1
    rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_roundDown]
    rcases hinv.floor_int Q with h | h
    · rw [h] at h1 ⊢
      rw [Int.floor_eq_zero_iff.mpr ⟨by linarith [h1.1], by linarith [h1.2.1]⟩]
      simp
    · rw [h] at h1 ⊢
      have hb : BB.coeff Q = 1 := le_antisymm h1.2.2 (by linarith [h1.1])
      rw [hb]; simp
  -- the lowered boundary `Γ = B_n - ½ ⌊B_n⌋` is klt
  have hBY : divisorSeq (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown) P.BY P.n.toNat =
      BB - (1 / 2 : ℚ) • TT := QDivisor.toRDivisor_injective hinv.toRDivisor_eq.symm
  have hΓklt : IsKltPair (modelStr (sX i) P.sY P.n.toNat) (BB - (1 / 2 : ℚ) • TT) := by
    have hd := hmod.isDltPair
    rw [hBY] at hd
    refine MMP.Intersection.IsDltPair.isKltPair_of_forall_coeff_lt_one hd fun Q => ?_
    have h1 := hinv.coeff_bounds Q
    have h2 := hinv.floor_nonneg Q
    simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h1 ⊢
