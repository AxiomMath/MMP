  have hgproj : IsProjectiveMorphism P.g :=
    IsProjectiveMorphism.of_comp P.g P.sT (by rw [hneg.isContraction.comp_eq]; exact hYp.isProjective)
  haveI : IsProper P.g := isProper_of_isProjectiveMorphism _ hgproj
  have hsurj : Surjective P.g := P.g.surjective_of_isIso_app hface.isIso_app
  have hr : IsContractionOfRay (modelStr (sX i) P.sY P.n.toNat) P.sT
