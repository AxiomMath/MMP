    refine ⟨⟨genericPoint (modelSeq (X i) P.Y P.n.toNat), ?_⟩⟩
    change (modelMap f P.πY P.n.toNat) (genericPoint _) ∈ U
    rw [MMP.Positivity.map_genericPoint_eq_of_isDominant]
    exact genericPoint_mem_of_isOpen U.isOpen ⟨_, hx₀⟩
  have hSgSgi : Sg.toHom.comp Sgi.toHom = (1 : FunctionFieldEquiv (sX i) (sX i)).toHom := by
    ext a
    exact hSgi a
  -- near the floor image, the extension is a function on `R` times the base form
  have hσrel : ∀ α (U : R.Opens) (e : (RationalFunctions R)ˣ)
      (he : (m₀' • H).IsLocalEquation U e) [Nonempty (f ⁻¹ᵁ U)]
      [Nonempty (modelMap f P.πY P.n.toNat ⁻¹ᵁ U)],
      ∃ h : Γ(R, U),
        τY α = (modelSeq (X i) P.Y P.n.toNat).germToFunctionField
            (modelMap f P.πY P.n.toNat ⁻¹ᵁ U) ((modelMap f P.πY P.n.toNat).app U h) •
          (pluriformPullback (modelStr (sX i) P.sY P.n.toNat) (sX i) Sgi.toHom 3 (m₀' * k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR (sX i) w (m₀' * k * r))) ∧
        pluriformPullback (sX i) (modelStr (sX i) P.sY P.n.toNat) Sg.toHom 3 (m₀' * k * r)
            (τY α) =
          (X i).germToFunctionField (f ⁻¹ᵁ U) (f.app U h) •
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR (sX i) w (m₀' * k * r)) :=
    liftsPow_twoFloor_hσrel hdim i R sR f k H P m h0 hdimY C₀ hne Sg hSgr m₀' φ w Y' Δ' A r hπ hΩgen s τY hτY hπO hSgSgi
  -- on the floor of `X_i`, that function restricts to the floor function `GX`
  have hGXeq : ∀ α (U : R.Opens) (e : (RationalFunctions R)ˣ)
      (he : (m₀' • H).IsLocalEquation U e) [Nonempty (modelMap f P.πY P.n.toNat ⁻¹ᵁ U)]
      (h : Γ(R, U)),
      τY α = (modelSeq (X i) P.Y P.n.toNat).germToFunctionField
            (modelMap f P.πY P.n.toNat ⁻¹ᵁ U) ((modelMap f P.πY P.n.toNat).app U h) •
          (pluriformPullback (modelStr (sX i) P.sY P.n.toNat) (sX i) Sgi.toHom 3 (m₀' * k * r)
            (((functionFieldMap f (MMP.Threefold.Mori.Helpers.evalFF (univComponent R)
              (e : RationalFunctions R)))⁻¹ * u) ^ r • formPowR (sX i) w (m₀' * k * r))) →
      (ιS ≫ f).app U h = GX α U e he :=
    liftsPow_twoFloor_hGXeq i R sR f k H P Sg m₀' φ w hw Y' Δ' A r W BW fa fb hfaiso hfab hπ GX Ψ hΨ s hagree τY hτY
  -- the transports lift the floor systems
  have hlift : ∀ α, LiftsPow sX B jf BSf i (m₀' * k * r) 1 (m₀' * k * r)
      (pluriformPullback (sX i) (modelStr (sX i) P.sY P.n.toNat) Sg.toHom 3 (m₀' * k * r)
        (τY α)) (t α) :=
    liftsPow_twoFloor_hlift i R sR f k H P Sg m₀' φ w Y' Δ' A r t hH₁ hπ GX hlocX τY hneπ hσrel hGXeq
  -- the transports are global sections
  have hσmem : ∀ α, pluriformPullback (sX i) (modelStr (sX i) P.sY P.n.toNat) Sg.toHom 3
      (m₀' * k * r) (τY α) ∈ logPluricanonicalSections (sX i) 3 (m₀' * k * r) (B i) :=
    liftsPow_twoFloor_hσmem hdim i R sR f k H P m h0 C₀ hne m₀ Sg m₀' φ w Y' Δ' cY cR mC A r hm hH₁ hgenX hπ τY hneπ hσrel
  -- the transports generate
  have hπs : Surjective (modelMap f P.πY P.n.toNat) := by
    haveI : IsProper (modelStr (sX i) P.sY P.n.toNat) :=
      isProper_of_isProjectiveMorphism _ hYp.isProjective
    haveI : IsProper (modelMap f P.πY P.n.toNat ≫ sR) := by rw [hπnR]; infer_instance
    haveI : IsProper (modelMap f P.πY P.n.toNat) := IsProper.of_comp _ sR
    exact (modelMap f P.πY P.n.toNat).surjective_of_isIso_app hπO
  have hgenσ : ∀ x : X i, ∃ α, ∃ V : (X i).Opens, x ∈ V ∧ GeneratesOn (B i) (m₀' * k * r) V
      (pluriformPullback (sX i) (modelStr (sX i) P.sY P.n.toNat) Sg.toHom 3 (m₀' * k * r)
        (τY α)) :=
    liftsPow_twoFloor_hgenσ hdim i R sR f k H P m h0 hdimY Sg m₀' φ w Y' Δ' A r hH₁ hgenX hπ hΩgen s hU1 hgenY' τY hτY hneπ hσrel hπs
  refine ⟨1, one_pos, ?_⟩
  rw [one_mul]
  refine ⟨fun α => ⟨_, hσmem α, hlift α⟩, fun x => ?_⟩
  obtain ⟨α, V, hxV, hgV⟩ := hgenσ x
  exact ⟨_, hσmem α, V, hxV, hgV, Or.inr ⟨α, hlift α⟩⟩

include hX hdim hQ hB hdlt hK hsemi hSf in
/-- **The two-floor case of the Mori endpoint.** If the final contraction `r : Y ⟶ V` of a
projective program over `R` for `(X_i, B_i - ½⌊B_i⌋)` has `dim V = 2` and the horizontal floor
of `Y` does not have degree one over `V` (so it has degree two: the generic fibre is a conic with
boundary of degree two), the admissible floor sections, transported to the floors of `Y` and to a
crepant dlt model, descend to `V` and give generating lifts on `Y`, which are carried back to
`X_i` through a common resolution. -/
private theorem exists_liftsPow_of_hasFinal_twoFloor (i : I) [CompactSpace (X i)]
    {R : Scheme.{0}} [IsIntegral R] [CompactSpace R] [IsLocallyNoetherian R] [IsNormal R]
    {sR : R ⟶ Spec (.of ℂ)} (hRn : IsNormalVariety ℂ sR) (hRp : Mori.IsProjectiveVariety ℂ sR)
    (f : X i ⟶ R) (hf : f ≫ sR = sX i) (hfp : IsProjectiveMorphism f)
    (hfO : ∀ U : R.Opens, IsIso (f.app U))
    {k : ℕ} (hk : 0 < k) {H : Divisor R} (hH : H.IsCartier) (hHamp : H.IsRelativelyAmple sR hH)
    {M : Divisor (X i)} (hM : ∃ hfH, H.IsPullback f hfH M)
    (hMeq : (Divisor.toQDivisor M).QLinearlyEquivalent
      ((k : ℚ) • (Divisor.toQDivisor (K i) + B i)))
    (hS0 : (B i).roundDown ≠ 0)
    (heq : f.base '' (⋃ E ∈ (B i).roundDown.support, (E.support : Set (X i))) = Set.univ)
    (P : RelativeDltProgram (sX i) sR f (K i) (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown)) (hPp : P.IsProjective) (hPn : P.n ≠ ⊤)
    (hfin : P.hasFinal) [IsIntegral P.T]
    (hcase : ¬ (topologicalKrullDim P.T ≤ 1 ∨ (topologicalKrullDim P.T = 2 ∧
        open scoped Classical in ∑ Q ∈ (DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).support with
            P.g.base Q.genericPoint = genericPoint P.T,
          (DivisorWithCoeffs.roundDown (iterTransform P.φ (B i) P.n.toNat)).coeff Q *
            (letI := (P.g.residueFieldMap Q.genericPoint).hom.toAlgebra
             (Module.finrank (P.T.residueField (P.g.base Q.genericPoint))
              ((modelSeq (X i) P.Y P.n.toNat).residueField Q.genericPoint) : ℤ)) = 1))) :
    ∃ k : ℕ, 0 < k ∧ ∀ m : ℕ, k ∣ m →
      ∀ Rf : ResidueRestriction (fun j => jf j ≫ sX j.1) BSf 2 m,
      ∀ {A : Type*} [Finite A]
        (t : A → ∀ j, logPluricanonicalSections (jf j ≫ sX j.1) 2 m (BSf j)),
        (∀ α, t α ∈ admissibleSections Rf) →
        (∀ P (y : Sf ⟨i, P⟩), ∃ α, ∃ V : (Sf ⟨i, P⟩).Opens, y ∈ V ∧
          GeneratesOn (BSf ⟨i, P⟩) m V
            ((t α ⟨i, P⟩ : logPluricanonicalSections (jf ⟨i, P⟩ ≫ sX i) 2 m (BSf ⟨i, P⟩)) :
              RationalPluriForms (jf ⟨i, P⟩ ≫ sX i) 2 m)) →
        ∃ a : ℕ, 0 < a ∧
          (∀ α, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            LiftsPow sX B jf BSf i m a (a * m) σ (t α)) ∧
          ∀ x : X i, ∃ σ ∈ logPluricanonicalSections (sX i) 3 (a * m) (B i),
            ∃ V : (X i).Opens, x ∈ V ∧ GeneratesOn (B i) (a * m) V σ ∧
              (LiftsPow sX B jf BSf i m a (a * m) σ 0 ∨
                ∃ α, LiftsPow sX B jf BSf i m a (a * m) σ (t α)) := by
  classical
  obtain ⟨-, hfinal, hdimlt⟩ := P.final_spec hfin
  haveI : QuasiCompact (sX i) := (hX i).toIsVariety.toQuasiCompact
  haveI : QuasiCompact sR := hRp.toIsVariety.toQuasiCompact
  haveI : IsSeparated sR := hRp.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sR := hRp.toIsVariety.toLocallyOfFiniteType
  haveI : IsDominant f := isDominant_of_forall_isIso_app f hfO
  -- the invariants at the end of the program
  obtain ⟨hD, hD'⟩ := isRelativelyNef_of_qLinearlyEquivalent_isPullback (hQ i) f hf hH hM hk hMeq
  obtain ⟨m, hm, hmD⟩ :=
    (isQCartier_of_isQFactorial (sX i) (hQ i) (Divisor.toQDivisor (K i) + B i)).exists_pos
  have h0 := floorInv_zero (g := f) (t₀ := 1 / 2) (hQ i) (hK i) (hdlt i) hmD hD hD'
  have hjn : ((P.n.toNat : ℕ) : ℕ∞) ≤ P.n := by rw [ENat.coe_toNat hPn]
  obtain ⟨hinv, -⟩ := floorInv_program hRp hm h0 P hPp (fun y hy => eq_genericPoint_of_specializes hy)
    (exists_coeff_pos_genericPoint_of_image_eq_univ (hdlt i).1.2.1 f heq) P.n.toNat hjn
  have hYp := hPp.2 P.n.toNat hjn
  have hmod := P.isRelativeDltModel P.n.toNat hjn
  have hKK := hinv.isCanonicalDivisor
  have hdimY := hKK.topologicalKrullDim_eq
  have hneg := hfinal.isNegativeExtremalContraction
  have hface := hfinal.isRelativeContractionOfFace
  have hYn := hmod.isQFactorial.1
  have hTn := hneg.isNormalVariety_target
  haveI : QuasiCompact (modelStr (sX i) P.sY P.n.toNat) := hYp.toIsVariety.toQuasiCompact
  have hgT : P.gT ≫ sR = P.sT := by
    haveI : IsAffine (Spec (.of ℂ)) := inferInstance
    exact eq_of_comp_eq_of_isIso_app_top P.g (hneg.isContraction.isIso_app ⊤)
      (by rw [← Category.assoc, hface.comp_eq, hmod.comp_eq, hneg.isContraction.comp_eq])
  have hTp : MMP.Mori.IsProjectiveVariety ℂ P.sT :=
    (AlgebraicGeometry.isProjectiveVariety_iff ℂ _).mpr
      ⟨hTn.1, hgT ▸ hface.isProjectiveMorphism.comp hRp.isProjective⟩
  obtain ⟨R', -, hfaceA, hray, C₀, hC₀, hR₀⟩ :=
    exists_isNegativeRelativeRayContraction hYp hTp hRp hmod.isQFactorial hface.comp_eq hgT hneg
  -- the floor and the lowered boundary
  set BB := iterTransform P.φ (B i) P.n.toNat with hBBdef
  set TT := iterTransform P.φ (Divisor.toQDivisor (B i).roundDown) P.n.toNat with hTTdef
  set KK := iterTransform P.φ (K i) P.n.toNat with hKKdef
  have hq : ∀ D : QDivisor (modelSeq (X i) P.Y P.n.toNat), D.IsQCartier :=
    isQCartier_of_isQFactorial _ hmod.isQFactorial
  have hfl : Divisor.toQDivisor (DivisorWithCoeffs.roundDown BB) = TT :=
    liftsPow_twoFloor_hfl i R sR f P m hinv
  -- the lowered boundary `Γ = B_n - ½ ⌊B_n⌋` is klt
  have hBY : divisorSeq (B i - (1 / 2 : ℚ) • Divisor.toQDivisor (B i).roundDown) P.BY P.n.toNat =
      BB - (1 / 2 : ℚ) • TT := QDivisor.toRDivisor_injective hinv.toRDivisor_eq.symm
  have hΓklt : IsKltPair (modelStr (sX i) P.sY P.n.toNat) (BB - (1 / 2 : ℚ) • TT) :=
    liftsPow_twoFloor_hΓklt i R sR f P m hmod hinv hBY
  -- the program's canonical divisor is linearly equivalent to `K_n`
  obtain ⟨d, hKd⟩ := hmod.isCanonicalDivisor
  have hd3 : d = 3 := by
    have := hKd.topologicalKrullDim_eq
    rw [hdimY] at this
    exact_mod_cast this.symm
  subst hd3
  have hlin := MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor _ hYn hKd hKK
  rw [hBY] at hneg
  -- the final ray is `(K_n + Γ)`-negative
  have hDneg : ∀ C : ProperCurve (modelStr (sX i) P.sY P.n.toNat), C.IsContractedBy P.g →
      (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)).intersectionNumber ℂ (modelStr (sX i) P.sY P.n.toNat) C.ι C.dim_le
        (hq _) < 0 := by
    intro C hC
    have h1 := intersectionNumber_neg_of_isRelativelyAntiAmple (hq _) hneg.isRelativelyAntiAmple C hC
    have h2 := intersectionNumber_add_eq_of_linearlyEquivalent (sX := modelStr (sX i) P.sY P.n.toNat)
      C.ι C.dim_le hlin (BB - (1 / 2 : ℚ) • TT) (hq _) (hq _)
    rw [← h2]
    exact h1
  have hcf : ∀ u ∈ relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R',
      u ≠ 0 → QDivisor.curveForm (modelStr (sX i) P.sY P.n.toNat)
        (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) (hq _) u < 0 := by
    intro u hu hu0
    rw [hR₀] at hu
    obtain ⟨c, hc, rfl⟩ := hu
    have hc0 : 0 < c := lt_of_le_of_ne hc (fun h => hu0 (by rw [← h, zero_smul]))
    rw [map_smul, smul_eq_mul, MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
    exact mul_neg_of_pos_of_neg hc0 (by exact_mod_cast hDneg C₀ hC₀)
  have hR : IsNegativeExtremalRayOf (modelStr (sX i) P.sY P.n.toNat)
      (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT))
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') :=
    ⟨hq _, hray, hcf⟩
  -- `g` is the contraction of the ray
  haveI : IsSeparated P.sT := hTn.1.toIsSeparated
  have hgproj : IsProjectiveMorphism P.g :=
    IsProjectiveMorphism.of_comp P.g P.sT (by rw [hneg.isContraction.comp_eq]; exact hYp.isProjective)
  haveI : IsProper P.g := isProper_of_isProjectiveMorphism _ hgproj
  have hsurj : Surjective P.g := P.g.surjective_of_isIso_app hface.isIso_app
  have hr : IsContractionOfRay (modelStr (sX i) P.sY P.n.toNat) P.sT
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') P.g :=
    ⟨⟨hYn, hTn, hneg.isContraction.comp_eq, hgproj, hsurj.surj, hface.isIso_app⟩,
      hfaceA.isContractedBy_iff⟩
  -- `ρ(Y/V) = 1`
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ (modelStr (sX i) P.sY P.n.toNat) := hYp
  have hkltM : MMP.Mori.IsKltPair (modelStr (sX i) P.sY P.n.toNat) 3 KK (BB - (1 / 2 : ℚ) • TT) :=
    (isKltPair_iff_mori_isKltPair _ hKK hΓklt.1).1 hΓklt
  have hΓeff : (BB - (1 / 2 : ℚ) • TT).IsEffective := hΓklt.1.nonneg
  have hF : IsNegativeExtremalFace ℝ (closedConeOfCurves (modelStr (sX i) P.sY P.n.toNat) :
      Set (NumericalCurveClasses (modelStr (sX i) P.sY P.n.toNat)))
      (MMP.Fourfold.QDivisor.curveForm (modelStr (sX i) P.sY P.n.toNat)
        (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) hkltM.1.2.2)
      (relativeToAbsolute (modelStr (sX i) P.sY P.n.toNat) (modelMap f P.πY P.n.toNat) '' R') :=
    ⟨hray.1, hray.1.2.2.1, fun u hu hu0 => hcf u hu hu0⟩
  have hne : OneCycle.numericalClass (modelStr (sX i) P.sY P.n.toNat) (C₀.cycle ℝ) ≠ 0 := by
    intro h0
    have h := MMP.ProgramBaseChange.curveForm_numericalClass_cycle (modelStr (sX i) P.sY P.n.toNat)
      (Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)) (hq _) C₀
    rw [h0, map_zero] at h
    have := hDneg C₀ hC₀
    have h' : ((Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)).intersectionNumber ℂ (modelStr (sX i) P.sY P.n.toNat) C₀.ι
      C₀.dim_le (hq _) : ℝ) = 0 := h.symm
    have : ((Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT)).intersectionNumber ℂ (modelStr (sX i) P.sY P.n.toNat) C₀.ι
      C₀.dim_le (hq _) : ℝ) < 0 := by exact_mod_cast this
    linarith only [h', this]
  have hρ : relativePicardNumberN1 (modelStr (sX i) P.sY P.n.toNat) P.g = 1 := by
    refine relativePicardNumberN1_eq_one P.g C₀ hne ?_ ?_
    · intro E hE
      refine (MMP.Mori.exists_isInvertible_iso_pullback_of_isContractionOfFace hkltM hΓeff hF hfaceA
        (MMP.CartierDivisor.sheaf E) fun C hC => ?_).imp fun _ h => ⟨h.1, h.2⟩
      rw [hR₀] at hC
      obtain ⟨c, -, hcC⟩ := hC
      have h := congrArg (NumericalCurveClasses.degree (modelStr (sX i) P.sY P.n.toNat)
        (MMP.CartierDivisor.sheaf E)) hcC
      rw [map_smul, NumericalCurveClasses.degree_numericalClass,
        NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
        OneCycle.degree_cycle, hE, Int.cast_zero, smul_zero] at h
      exact_mod_cast h.symm
    · rintro E M hM ⟨e⟩
      rw [degree_eq_of_iso C₀ e]
      exact ProperCurve.degree_pullback_eq_zero_of_isContractedBy P.g hneg.isContraction.comp_eq
        C₀ hC₀ M
  -- `-(K_n + Γ)` is relatively ample over `V`
  have hamp : (-(Divisor.toQDivisor KK + (BB - (1 / 2 : ℚ) • TT))).HasRelativelyAmpleMultiple P.g :=
    MMP.Mori.hasRelativelyAmpleMultiple_neg_of_isExtremalRay (Δ := BB - (1 / 2 : ℚ) • TT)
    (modelStr (sX i) P.sY P.n.toNat) P.sT hYn hYp hTp ⟨3, hKK⟩ (hq _) hray
    (fun v hv hv0 => by
      simpa [MMP.Fourfold.QDivisor.curveForm, Finsupp.sum, LinearMap.sum_apply] using
        hcf v hv hv0) P.g hneg.isContraction.comp_eq fun C hC => (hfaceA.isContractedBy_iff C).mp hC
  -- `K_n + B_n` is numerically trivial over `V`
  have hnum : MMP.Flips.IsNumericallyTrivialOver ℂ (modelStr (sX i) P.sY P.n.toNat) P.g
      (QDivisor.toRDivisor (Divisor.toQDivisor KK + BB)) := by
    refine ⟨isCartierCombination_toRDivisor (hq _),
      ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
      fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ hx₁ hx₂ => ?_⟩
    have hCπ : C.IsContractedBy (modelMap f P.πY P.n.toNat) := fun x hx => by
      rw [← hface.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC x hx]
    have e1 := eq_intersectionNumber_of_isRIntersectionNumber (hq _) C hx₁
    have hx0 : MMP.Flips.IsRIntersectionNumber ℂ (modelStr (sX i) P.sY P.n.toNat) 0
        (Fin.elim0 : Fin 0 → ℝ) (Fin.elim0 : Fin 0 → Divisor (modelSeq (X i) P.Y P.n.toNat)) C 0 :=
      ⟨fun j => j.elim0, fun j => j.elim0, by simp, fun j => j.elim0, by simp⟩
    have e2 := (MMP.Flips.IsRIntersectionNumber.eq_and_linear ℂ (modelStr (sX i) P.sY P.n.toNat) C).1 _ _ _ _ _ _ _ hx₂ hx0
    have h2 := MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg (modelStr (sX i) P.sY P.n.toNat)
      hinv.isRelativelyNef (hq _) C hCπ
    have h3 := MMP.Fourfold.QDivisor.IsRelativelyNef.intersectionNumber_nonneg (modelStr (sX i) P.sY P.n.toNat)
      hinv.isRelativelyNef_neg (hq _) C hCπ
    have hn := MMP.Fourfold.intersectionNumber_smul (modelStr (sX i) P.sY P.n.toNat) C.ι C.dim_le
      (Divisor.toQDivisor KK + BB) (hq _) (-1) (hq _)
    rw [neg_one_smul] at hn
    rw [hn] at h3
    rw [e1, e2]
    have : (Divisor.toQDivisor KK + BB).intersectionNumber ℂ (modelStr (sX i) P.sY P.n.toNat) C.ι C.dim_le (hq _) = 0 := by
      linarith only [h2, h3]
    rw [this]; simp
