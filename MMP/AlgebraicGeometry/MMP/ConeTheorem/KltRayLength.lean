module
public import MMP.AlgebraicGeometry.MMP.ConeTheorem.RayLength

/-!
# Lengths of negative extremal rays of projective complex klt pairs

Let `(X, B)` be a klt pair with `B` an effective `ℚ`-divisor and `X` a projective complex
variety of dimension `n`. Every `(K_X + B)`-negative extremal ray `R` of the closed cone of
curves `NE̅(X) ⊆ N₁(X)_ℝ` is spanned by the class of a rational curve `T ⊆ X` with
`0 < -(K_X + B) · T ≤ 2n`.

The contraction theorem gives the contraction `f : X ⟶ Z` of `R`; it is nontrivial since `R`
contains the class of a curve, its relative closed cone of curves is `R`, and relative Kleiman
makes `-(K_X + B)` relatively ample. Bend-and-break along the fibres of `f` then produces the
rational curve. It is the case `k = ℂ` of
`MMP.Fourfold.exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf_of_isAlgClosed`, which
holds over any algebraically closed field of characteristic zero.

## Main results

* `MMP.Fourfold.exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf`: the statement above.

## Implementation notes

* The klt condition is `MMP.Mori.IsKltPair` with a canonical divisor `K` of dimension `n`; this
  pins `n = dim X`. Effectivity of `B` is `0 ≤ B`.
* The ray is `MMP.Fourfold.IsNegativeExtremalRayOf` for the `ℚ`-Cartier divisor `K + B`, and
  `(K + B) · T` is `MMP.Fourfold.QDivisor.curveForm` evaluated on the class of `T` in
  `N₁(X)_ℝ`.
* The curve `T` is a `MMP.Mori.ProperCurve`, recorded by its generic point, whose reduced closed
  subscheme is a rational curve in the sense of `MMP.Mori.IsRationalCurve`. "Generated by" means
  `R = ℝ_{≥0} · [T]`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP.Mori

namespace MMP.Fourfold

/-- **Lengths of negative extremal rays.** Let `(X, B)` be a klt pair, with `B ≥ 0` a
`ℚ`-divisor, `K` a canonical divisor of dimension `n` and `X` a projective complex variety. Every
`(K + B)`-negative extremal ray `R` of `NE̅(X)` is `ℝ_{≥0} · [T]` for a rational curve `T ⊆ X`
with `0 < -(K + B) · T ≤ 2n`. -/
@[mmp "thm_fourfold_projective_complex_klt_ray_length"]
public theorem exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) [AlgebraicGeometry.IsProjectiveVariety ℂ sX] [CompactSpace X]
    {n : ℕ} {K : Divisor X} {B : QDivisor X} (hklt : MMP.Mori.IsKltPair sX n K B) (hB : 0 ≤ B)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsNegativeExtremalRayOf sX (Divisor.toQDivisor K + B) R) :
    ∃ T : ProperCurve sX,
      IsRationalCurve sX
          (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({T.point} : Set X))) ∧
        R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • OneCycle.numericalClass sX (T.cycle ℝ) = w} ∧
        0 < -QDivisor.curveForm sX (Divisor.toQDivisor K + B) hklt.1.2.2
            (OneCycle.numericalClass sX (T.cycle ℝ)) ∧
        -QDivisor.curveForm sX (Divisor.toQDivisor K + B) hklt.1.2.2
            (OneCycle.numericalClass sX (T.cycle ℝ)) ≤ 2 * n :=
  exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf_of_isAlgClosed sX hklt hB hR

end MMP.Fourfold

end
