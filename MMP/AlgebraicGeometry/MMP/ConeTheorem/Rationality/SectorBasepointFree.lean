module

public import MMP.AlgebraicGeometry.MMP.BasepointFree.Basic
public import MMP.AlgebraicGeometry.MMP.ConeTheorem.BelowNefThreshold
public import MMP.AlgebraicGeometry.Positivity.BaseLocusSum

/-!
# Basepoint freeness in a sector strictly inside the nef cone

Let `(X, Δ, a, H)` be a rationality datum with nef threshold `r > 0` of `H` with respect to
`K_X + Δ`, and let `0 < δ < r / 2`. Then there is `N` such that the complete linear system
`|xH + ya(K_X + Δ)|` is basepoint free for every `(x, y) ∈ ℤ²` with `x ≥ N` and
`δx ≤ ay ≤ (r - δ)x`. The lattice points of a slightly larger rational cone form a finitely
generated monoid; each generator `G_i` is nef with `G_i - (K_X + Δ)` nef and big, so the
basepoint-free theorem makes `|bG_i|` free for `b ≫ 0`, and a sum of divisors with free complete
linear systems has a free complete linear system.

## Main results

* `MMP.Mori.IsRationalityDatum.exists_isBasepointFree_stripDivisor`

## Implementation notes

The divisor `xH + ya(K_X + Δ)` is `MMP.Mori.stripDivisor K Δ a H x y`, the integral divisor
`a(K_X + Δ)` being read as `⌊a(K_X + Δ)⌋`; basepoint freeness of its complete linear system is
`MMP.Mori.Divisor.IsBasepointFree`, i.e. the strip base locus `L(x, y)` is empty. The
inequalities `δx ≤ ay ≤ (r - δ)x` are read in `ℝ`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], Claim 3.20
-/

@[expose] public section

/-!
## Gordan's lemma for the sector and auxiliary divisor lemmas

The lattice points of the rational cone `δ'x ≤ ay ≤ ρx` (`0 < δ' < δ`, `r - δ < ρ < r`) form a
finitely generated monoid (Gordan's lemma); each generator `g_i` gives a divisor `G_i` with `|bG_i|`
free for `b ≥ b_i` by the basepoint-free theorem, and every lattice point of the sector far enough
out is `∑ (b_i + m_i) g_i` with `m_i ≥ 0`.
-/

open CategoryTheory AlgebraicGeometry MMP.Mori

namespace MMP.FourfoldProofs.Km3bSectorBasepointFreeProof

/-- The lattice points of the cone spanned by `(a, δ)` and `(a, ρ)` are those with
`δx ≤ ay ≤ ρx`. -/
private theorem mem_hull_iff {a δ ρ : ℚ} (ha : 0 < a) (hδρ : δ < ρ) (u : Fin 2 → ℝ) :
    u ∈ PointedCone.hull ℝ ((fun q : Fin 2 → ℚ => fun i => (q i : ℝ)) ''
      (({![a, δ], ![a, ρ]} : Finset (Fin 2 → ℚ)) : Set (Fin 2 → ℚ))) ↔
      (δ : ℝ) * u 0 ≤ a * u 1 ∧ (a : ℝ) * u 1 ≤ ρ * u 0 := by
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hδρ' : (δ : ℝ) < ρ := by exact_mod_cast hδρ
  constructor
  · intro hu
    let C : PointedCone ℝ (Fin 2 → ℝ) :=
      { carrier := {u | (δ : ℝ) * u 0 ≤ a * u 1 ∧ (a : ℝ) * u 1 ≤ ρ * u 0}
        add_mem' := by
          rintro u v ⟨h1, h2⟩ ⟨h3, h4⟩
          refine ⟨?_, ?_⟩ <;> simp only [Pi.add_apply] <;> linarith
        zero_mem' := by simp
        smul_mem' := by
          rintro ⟨c, hc⟩ u ⟨h1, h2⟩
          simp only [Set.mem_ofPred_eq, Nonneg.mk_smul, Pi.smul_apply, smul_eq_mul]
          constructor <;>
            nlinarith [mul_le_mul_of_nonneg_left h1 hc, mul_le_mul_of_nonneg_left h2 hc] }
    have : PointedCone.hull ℝ ((fun q : Fin 2 → ℚ => fun i => (q i : ℝ)) ''
      (({![a, δ], ![a, ρ]} : Finset (Fin 2 → ℚ)) : Set (Fin 2 → ℚ))) ≤ C := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨q, hq, rfl⟩
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hq
      rcases hq with rfl | rfl
      · show (δ : ℝ) * a ≤ a * δ ∧ (a : ℝ) * δ ≤ ρ * a
        constructor <;> nlinarith
      · show (δ : ℝ) * a ≤ a * ρ ∧ (a : ℝ) * ρ ≤ ρ * a
        constructor <;> nlinarith
    exact this hu
  · rintro ⟨h1, h2⟩
    have hd : (0 : ℝ) < a * (ρ - δ) := by nlinarith
    have hne : (ρ : ℝ) - δ ≠ 0 := by linarith
    have ha0 : (a : ℝ) ≠ 0 := ha'.ne'
    set c₁ : ℝ := (ρ * u 0 - a * u 1) / (a * (ρ - δ))
    set c₂ : ℝ := (a * u 1 - δ * u 0) / (a * (ρ - δ))
    have hc₁ : 0 ≤ c₁ := div_nonneg (by linarith) hd.le
    have hc₂ : 0 ≤ c₂ := div_nonneg (by linarith) hd.le
    have hmem : ∀ q ∈ (({![a, δ], ![a, ρ]} : Finset (Fin 2 → ℚ))),
        (fun i => (q i : ℝ)) ∈ PointedCone.hull ℝ ((fun q : Fin 2 → ℚ => fun i => (q i : ℝ)) ''
      (({![a, δ], ![a, ρ]} : Finset (Fin 2 → ℚ)) : Set (Fin 2 → ℚ))) :=
      fun q hq => PointedCone.subset_hull ⟨q, hq, rfl⟩
    convert add_mem
      (Submodule.smul_mem _ (⟨c₁, hc₁⟩ : Nonneg ℝ) (hmem ![a, δ] (by simp)))
      (Submodule.smul_mem _ (⟨c₂, hc₂⟩ : Nonneg ℝ) (hmem ![a, ρ] (by simp))) using 1
    funext i
    fin_cases i <;> simp [c₁, c₂] <;> field_simp <;> ring

/-- Gordan's lemma for the sector `δx ≤ ay ≤ ρx`: its lattice points form the additive monoid
generated by finitely many nonzero lattice points. -/
private theorem exists_finset_closure_eq_sector {a δ ρ : ℚ} (ha : 0 < a) (hδρ : δ < ρ) :
    ∃ g : Finset (Fin 2 → ℤ), 0 ∉ g ∧ ∀ v : Fin 2 → ℤ,
      v ∈ AddSubmonoid.closure (g : Set (Fin 2 → ℤ)) ↔
        (δ : ℝ) * v 0 ≤ a * v 1 ∧ (a : ℝ) * v 1 ≤ ρ * v 0 := by
  classical
  obtain ⟨g, hg⟩ := MMP.Resolution.Bridges.exists_finset_lattice_points_eq_closure
    ({![a, δ], ![a, ρ]} : Finset (Fin 2 → ℚ))
  refine ⟨g.erase 0, by simp, fun v => ?_⟩
  rw [Finset.coe_erase, AddSubmonoid.closure_sdiff_singleton_zero, ← hg, mem_hull_iff ha hδρ]

/-- A nonzero lattice point of the sector `δx ≤ ay ≤ ρx` (`0 < δ < ρ`, `0 < a`) has `0 < x` and
`ay ≥ 1`. -/
private theorem pos_of_mem_sector {a : ℤ} (ha : 0 < a) {δ ρ : ℝ} (hδ : 0 < δ) (hδρ : δ < ρ)
    {v : Fin 2 → ℤ} (hv : v ≠ 0) (h₁ : δ * v 0 ≤ a * v 1) (h₂ : (a : ℝ) * v 1 ≤ ρ * v 0) :
    0 < v 0 ∧ 1 ≤ a * v 1 := by
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hx : 0 < v 0 := by
    by_contra hle
    have hle' : (v 0 : ℝ) ≤ 0 := by exact_mod_cast not_lt.1 hle
    have h0 : v 0 = 0 := by exact_mod_cast (show (v 0 : ℝ) = 0 by nlinarith)
    rw [h0, Int.cast_zero, mul_zero] at h₁ h₂
    have h1 : v 1 = 0 := by exact_mod_cast (show (v 1 : ℝ) = 0 by nlinarith)
    exact hv (funext fun i => by fin_cases i <;> simp [h0, h1])
  have hx' : (0 : ℝ) < v 0 := by exact_mod_cast hx
  have : (0 : ℝ) < a * v 1 := by nlinarith
  exact ⟨hx, by exact_mod_cast this⟩

/-- Far enough out, the sector `δx ≤ ay ≤ θx` translated by `-w` lies in the wider sector
`δ'x ≤ ay ≤ ρx` (`δ' < δ`, `θ < ρ`). -/
private theorem exists_sub_mem_sector {a δ δ' θ ρ : ℝ} (hδ : δ' < δ) (hρ : θ < ρ) (w₀ w₁ : ℝ) :
    ∃ N : ℝ, ∀ x y : ℝ, N ≤ x → δ * x ≤ a * y → a * y ≤ θ * x →
      δ' * (x - w₀) ≤ a * (y - w₁) ∧ a * (y - w₁) ≤ ρ * (x - w₀) := by
  refine ⟨max ((a * w₁ - δ' * w₀) / (δ - δ')) ((ρ * w₀ - a * w₁) / (ρ - θ)),
    fun x y hN h₁ h₂ => ?_⟩
  rw [max_le_iff, div_le_iff₀ (by linarith), div_le_iff₀ (by linarith)] at hN
  constructor <;> nlinarith

/-- If `P` is closed under addition and holds at `b • v` for every generator `v` and `b ≥ B v`,
then it holds at every nonzero point of `∑ B v • v + ⟨g⟩`. -/
private theorem sum_nsmul_add_of_mem_closure {M : Type*} [AddCommMonoid M] {P : M → Prop}
    (hP : ∀ x y, P x → P y → P (x + y)) {g : Finset M} {B : M → ℕ}
    (hB : ∀ v ∈ g, ∀ b, B v ≤ b → P (b • v)) {u : M}
    (hu : u ∈ AddSubmonoid.closure (g : Set M)) (h0 : ∑ v ∈ g, B v • v + u ≠ 0) :
    P (∑ v ∈ g, B v • v + u) := by
  obtain ⟨m, -, rfl⟩ := AddSubmonoid.mem_closure_finset.1 hu
  simp_rw [← Finset.sum_add_distrib, ← add_smul] at h0 ⊢
  have hne : g.Nonempty := Finset.nonempty_iff_ne_empty.2 fun h => h0 (by simp [h])
  exact Finset.sum_induction_nonempty _ _ hP hne fun v hv => hB v hv _ (Nat.le_add_right _ _)

/-- The round-down of a `ℚ`-divisor with integral coefficients is the divisor itself. -/
private theorem roundDown_toQDivisor {X : Scheme} (D : Divisor X) :
    (Divisor.toQDivisor D).roundDown = D := by
  ext E
  rw [DivisorWithCoeffs.coeff_roundDown, Divisor.coeff_toQDivisor, Int.floor_intCast]

section Geometry

variable {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]

/-- The sum of two basepoint-free divisors is basepoint free. -/
private theorem isBasepointFree_add {M₁ M₂ : Divisor X} (h₁ : M₁.IsBasepointFree)
    (h₂ : M₂.IsBasepointFree) : (M₁ + M₂).IsBasepointFree := by
  have h := MMP.Positivity.baseLocus_add_le M₁ M₂
  rw [show M₁.baseLocus = ⊥ from h₁, show M₂.baseLocus = ⊥ from h₂, bot_sup_eq] at h
  exact eq_bot_iff.mpr h

/-- `(p, q) ↦ pH + qa(K_X + Δ)` as an additive map on `ℤ²`. -/
private noncomputable def stripHom (K : Divisor X) (Δ : QDivisor X) (a : ℤ) (H : Divisor X) :
    (Fin 2 → ℤ) →+ Divisor X where
  toFun v := stripDivisor K Δ a H (v 0) (v 1)
  map_zero' := by simp [stripDivisor]
  map_add' v w := by
    simp only [stripDivisor, Pi.add_apply, add_smul]
    abel

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
@[simp]
private theorem stripHom_apply (K : Divisor X) (Δ : QDivisor X) (a : ℤ) (H : Divisor X)
    (v : Fin 2 → ℤ) : stripHom K Δ a H v = stripDivisor K Δ a H (v 0) (v 1) := rfl

omit [CompactSpace X] in
/-- For a rationality datum, the strip divisor is Cartier and equals
`pH + (qa)(K_X + Δ)` as a `ℚ`-divisor. -/
private theorem toQDivisor_stripDivisor {n : ℕ} {K : Divisor X} {Δ : QDivisor X} {a : ℤ}
    {H : Divisor X} (hD : IsRationalityDatum sX n K Δ a H) (p q : ℤ) :
    (stripDivisor K Δ a H p q).IsCartier ∧
      Divisor.toQDivisor (stripDivisor K Δ a H p q) =
        (p : ℚ) • Divisor.toQDivisor H + ((a * q : ℤ) : ℚ) • (Divisor.toQDivisor K + Δ) := by
  obtain ⟨D₀, hD₀, hD₀c⟩ := hD.isCartierDivisor
  have hr0 : (a • (Divisor.toQDivisor K + Δ)).roundDown = D₀ := by
    rw [← hD₀, roundDown_toQDivisor]
  refine ⟨?_, ?_⟩
  · rw [stripDivisor, hr0]
    exact (hD.isCartier_H.zsmul p).add (hD₀c.zsmul q)
  · rw [stripDivisor, hr0, map_add, map_zsmul, map_zsmul, hD₀, smul_smul,
      Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul, mul_comm]

/-- A lattice point `(p, q)` with `p > 0` and `1 ≤ aq < rp` gives a divisor
`G = pH + qa(K_X + Δ)` with `|bG|` basepoint free for all `b ≫ 0`. -/
private theorem exists_isBasepointFree_nsmul_stripDivisor [IsAlgClosed k] [CharZero k]
    {n : ℕ} {K : Divisor X} {Δ : QDivisor X} {a : ℤ} {H : Divisor X}
    (hD : IsRationalityDatum sX n K Δ a H) {r : ℝ}
    (hr : QDivisor.IsNefThreshold k sX (Divisor.toQDivisor H) (Divisor.toQDivisor K + Δ) r)
    {p q : ℤ} (hp : 0 < p) (hq : 1 ≤ a * q) (hqr : (a * q : ℝ) < r * p) :
    ∃ b₀ : ℕ, ∀ b : ℕ, b₀ ≤ b → (b • stripDivisor K Δ a H p q).IsBasepointFree := by
  obtain ⟨hGc, hGQ⟩ := toQDivisor_stripDivisor hD p q
  have hp' : (0 : ℚ) < p := by exact_mod_cast hp
  have hq' : (1 : ℚ) ≤ ((a * q : ℤ) : ℚ) := by exact_mod_cast hq
  have hnef := MMP.Positivity.IsRationalityDatum.isNef_and_isBig_of_lt hD hr hp'
    (t := ((a * q : ℤ) : ℚ)) (by linarith) (by push_cast; exact_mod_cast hqr)
  have hsub := MMP.Positivity.IsRationalityDatum.isNef_and_isBig_of_lt hD hr hp'
    (t := ((a * q : ℤ) : ℚ) - 1) (by linarith)
    (by push_cast; linarith)
  have heq : (1 : ℚ) • Divisor.toQDivisor (stripDivisor K Δ a H p q) - Divisor.toQDivisor K - Δ =
      (p : ℚ) • Divisor.toQDivisor H + (((a * q : ℤ) : ℚ) - 1) • (Divisor.toQDivisor K + Δ) := by
    rw [hGQ]
    module
  rw [← heq] at hsub
  have hdat : IsBasepointFreeDatum sX n K Δ (stripDivisor K Δ a H p q) 1 :=
    { isProperVariety := hD.isProperVariety
      isKltPair := hD.isKltPair
      isEffective := hD.isEffective
      isCartier := hGc
      isNef := (QDivisor.isNef_toQDivisor_iff _ hGc).1 (hGQ ▸ hnef.1)
      pos := one_pos
      isQCartier_sub := hsub.1.1
      isNef_sub := hsub.1
      isBig_sub := hsub.2 }
  exact hdat.exists_isBasepointFree_nsmul

end Geometry

end MMP.FourfoldProofs.Km3bSectorBasepointFreeProof

open MMP.FourfoldProofs.Km3bSectorBasepointFreeProof

namespace MMP.Mori

/-- **Basepoint freeness in a sector** (implicit in Kollár–Mori, Claim 3.20). Let
`(X, Δ, a, H)` be a rationality datum with nef threshold `r > 0` of `H` with respect to
`K_X + Δ`, and let `0 < δ < r / 2`. Then there is `N` such that `|xH + ya(K_X + Δ)|` is
basepoint free for all integers `x ≥ N` and `y` with `δx ≤ ay ≤ (r - δ)x`. -/
@[mmp "lem_km3b_sector_basepoint_free"]
public theorem IsRationalityDatum.exists_isBasepointFree_stripDivisor {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] {n : ℕ}
    {K : Divisor X} {Δ : QDivisor X} {a : ℤ} {H : Divisor X}
    (hD : IsRationalityDatum sX n K Δ a H) {r : ℝ}
    (hr : QDivisor.IsNefThreshold k sX (Divisor.toQDivisor H) (Divisor.toQDivisor K + Δ) r)
    (_hr0 : 0 < r) {δ : ℝ} (hδ : 0 < δ) (hδr : δ < r / 2) :
    ∃ N : ℤ, ∀ x y : ℤ, N ≤ x → δ * x ≤ (a * y : ℝ) → (a * y : ℝ) ≤ (r - δ) * x →
      (stripDivisor K Δ a H x y).IsBasepointFree := by
  classical
  have ha : 0 < a := hD.pos
  obtain ⟨δ', hδ'0, hδ'δ⟩ := exists_rat_btwn hδ
  obtain ⟨ρ, hρ1, hρ2⟩ := exists_rat_btwn (show r - δ < r by linarith)
  have hδ'ρ : (δ' : ℝ) < ρ := by linarith
  obtain ⟨g, hg0, hg⟩ := exists_finset_closure_eq_sector (a := (a : ℚ)) (by exact_mod_cast ha)
    (by exact_mod_cast hδ'ρ)
  simp only [Rat.cast_intCast] at hg
  -- each generator gives a divisor whose large multiples are basepoint free
  have hgen : ∀ v ∈ g, ∃ b₀ : ℕ, ∀ b : ℕ, b₀ ≤ b →
      (stripHom K Δ a H (b • v)).IsBasepointFree := by
    intro v hv
    obtain ⟨h₁, h₂⟩ := (hg v).1 (AddSubmonoid.subset_closure hv)
    obtain ⟨hx, hay⟩ := pos_of_mem_sector ha (by exact_mod_cast hδ'0) hδ'ρ
      (ne_of_mem_of_not_mem hv hg0) h₁ h₂
    have hx' : (0 : ℝ) < v 0 := by exact_mod_cast hx
    simp only [map_nsmul, stripHom_apply]
    exact exists_isBasepointFree_nsmul_stripDivisor hD hr hx hay (by nlinarith)
  choose! B hB using hgen
  obtain ⟨N, hN⟩ := exists_sub_mem_sector (a := (a : ℝ)) hδ'δ hρ1
    ((∑ v ∈ g, B v • v) 0 : ℝ) ((∑ v ∈ g, B v • v) 1 : ℝ)
  refine ⟨max 1 ⌈N⌉, fun x y hx h₁ h₂ => ?_⟩
  obtain ⟨h₁', h₂'⟩ := hN x y (Int.ceil_le.1 (le_of_max_le_right hx)) h₁ h₂
  have hxy : ![x, y] = ∑ v ∈ g, B v • v + (![x, y] - ∑ v ∈ g, B v • v) := by abel
  rw [show stripDivisor K Δ a H x y = stripHom K Δ a H ![x, y] from rfl, hxy]
  refine sum_nsmul_add_of_mem_closure (P := fun v => (stripHom K Δ a H v).IsBasepointFree)
    (fun _ _ h h' => by simpa only [map_add] using isBasepointFree_add h h') hB
    ((hg _).2 ⟨?_, ?_⟩) ?_
  · simpa using h₁'
  · simpa using h₂'
  · rw [← hxy]
    intro h
    have := congrFun h 0
    simp at this
    omega

end MMP.Mori
