module

public import MMP.AlgebraicGeometry.MMP.ConeTheorem.RayLength
public import MMP.AlgebraicGeometry.MMP.ConeTheorem.ConeDatumFiniteDecomposition

/-!
# The cone theorem: negative part spanned by rational curves

Let `X` be a projective variety over an algebraically closed field `k` of characteristic zero
and `(X, Δ)` a klt pair with `Δ` effective, of dimension `n`. Then there is a countable family of
rational curves `C_j ⊆ X` with `0 < -((K_X + Δ) · C_j) ≤ 2n` such that
`NE̅(X) = NE̅(X)_{(K_X + Δ) ≥ 0} + ∑_j ℝ_{≥0} [C_j]`.

## Main results

* `MMP.Mori.exists_countable_isRationalCurve_closedConeOfCurves_eq`: the statement above.

## Implementation notes

The family of curves is a countable set `S` of `MMP.Mori.ProperCurve`s; the rational curve
attached to `C ∈ S` is the reduced closure of its generic point, and its class is
`OneCycle.numericalClass sX (C.cycle ℝ)`. The sum `∑_j ℝ_{≥0} [C_j]` of rays is the convex cone
`PointedCone.hull ℝ` of these classes (finite nonnegative combinations), and the sum with
`NE̅(X)_{(K_X + Δ) ≥ 0} = NE̅(X) ∩ {z | ((K_X + Δ) · z) ≥ 0}` is the pointwise sum of sets.
The form `z ↦ ((K_X + Δ) · z)` is `MMP.Fourfold.QDivisor.curveForm` of `K_X + Δ`.

If `K_X + Δ` is nef, no curve is needed. Otherwise the cone of curves, carried to
`ℝ ⊗ N₁(X)_ℤ` by the canonical isomorphism, is the cone of a cone datum with form `K_X + Δ`;
each of its negative rational rays is spanned by a lattice point, so there are countably many,
and each is a `(K_X + Δ)`-negative extremal ray, hence spanned by a rational curve.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], Theorem 3.7(1)
-/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace TensorProduct Pointwise MMP.Mori
  MMP.Positivity

namespace MMP.FourfoldProofs.Km3bConeTheoremRationalCurvesProof

/-- The curve form of a nef `ℚ`-Cartier `ℚ`-divisor is nonnegative on `NE̅(X)`. -/
private theorem curveForm_nonneg_of_isNef {k : Type} [Field k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [QuasiCompact sX] {D : QDivisor X} (hD : D.IsNef k sX) (h : D.IsQCartier) :
    ∀ z ∈ closedConeOfCurves sX, 0 ≤ MMP.Fourfold.QDivisor.curveForm sX D h z := by
  have hcont : Continuous (MMP.Fourfold.QDivisor.curveForm sX D h) := by
    unfold MMP.Fourfold.QDivisor.curveForm Finsupp.sum
    rw [LinearMap.coe_sum, Finset.sum_fn]
    refine continuous_finset_sum _ fun E _ => ?_
    haveI := (Divisor.mem_cartierSubgroup.mp E.2).isInvertibleModule_divisorialSheaf
    exact (NumericalCurveClasses.continuous_degree sX _).const_smul _
  intro z hz
  replace hz : z ∈ closure (coneOfCurves sX : Set (NumericalCurveClasses sX)) := hz
  refine closure_minimal (s := (coneOfCurves sX : Set (NumericalCurveClasses sX)))
    (t := ((PointedCone.positive ℝ ℝ).comap (MMP.Fourfold.QDivisor.curveForm sX D h) :
      Set (NumericalCurveClasses sX))) (Submodule.span_le.2 ?_)
    (isClosed_Ici.preimage hcont) hz
  rintro _ ⟨C, rfl⟩
  obtain ⟨hq, hC⟩ := hD
  change 0 ≤ MMP.Fourfold.QDivisor.curveForm sX D h _
  rw [MMP.ProgramBaseChange.curveForm_numericalClass_cycle]
  exact_mod_cast hC C.scheme C.ι C.dim_eq

/-- The pointed cone generated by classes of curves lies in `NE̅(X)`. -/
private theorem hull_le_closedConeOfCurves {k : Type} [Field k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} (S : Set (ProperCurve sX)) :
    PointedCone.hull ℝ ((fun C : ProperCurve sX => OneCycle.numericalClass sX (C.cycle ℝ)) '' S)
      ≤ closedConeOfCurves sX :=
  Submodule.span_le.2 <| by
    rintro _ ⟨C, -, rfl⟩
    exact coneOfCurves_le_closedConeOfCurves sX (Submodule.subset_span ⟨C, rfl⟩)

/-- A part of `NE̅(X)` plus the pointed cone generated by classes of curves lies in `NE̅(X)`. -/
private theorem inter_add_hull_subset_closedConeOfCurves {k : Type} [Field k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} (P : Set (NumericalCurveClasses sX)) (S : Set (ProperCurve sX)) :
    ((closedConeOfCurves sX : Set (NumericalCurveClasses sX)) ∩ P) +
        (PointedCone.hull ℝ
          ((fun C : ProperCurve sX => OneCycle.numericalClass sX (C.cycle ℝ)) '' S) :
          Set (NumericalCurveClasses sX)) ⊆
      closedConeOfCurves sX := by
  rintro _ ⟨c, hc, h, hh, rfl⟩
  exact (closedConeOfCurves sX).add_mem hc.1 (hull_le_closedConeOfCurves S hh)

/-- If `D` is nef, then `NE̅(X) = NE̅(X)_{D ≥ 0}`, with no curve needed. -/
private theorem closedConeOfCurves_eq_inter_add_hull_empty_of_isNef {k : Type} [Field k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [QuasiCompact sX] {D : QDivisor X} (hD : D.IsNef k sX) (h : D.IsQCartier) :
    (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) =
      ((closedConeOfCurves sX : Set (NumericalCurveClasses sX)) ∩
          {z | 0 ≤ MMP.Fourfold.QDivisor.curveForm sX D h z}) +
        (PointedCone.hull ℝ
            ((fun C : ProperCurve sX => OneCycle.numericalClass sX (C.cycle ℝ)) '' ∅) :
          Set (NumericalCurveClasses sX)) :=
  Set.Subset.antisymm (fun x hx => ⟨x, ⟨hx, curveForm_nonneg_of_isNef hD h x hx⟩, 0,
    (PointedCone.hull ℝ _).zero_mem, add_zero x⟩) (inter_add_hull_subset_closedConeOfCurves _ ∅)

/-- The set `𝓡(NE̅, K)` of negative rational rays of a cone datum is countable. -/
theorem countable_negativeRationalRays {N : Type*} [AddCommGroup N] [Module.Free ℤ N]
    [Module.Finite ℤ N] (D : ConeDatum N) : D.negativeRationalRays.Countable := by
  haveI : Countable N := (Module.Free.chooseBasis ℤ N).repr.injective.countable
  refine (Set.countable_range fun ξ : N =>
    {w : ℝ ⊗[ℤ] N | ∃ c : ℝ, 0 ≤ c ∧ c • ((1 : ℝ) ⊗ₜ[ℤ] ξ) = w}).mono fun R hR => ?_
  obtain ⟨ξ, -, h⟩ := MMP.Positivity.ConeDatum.exists_integral_generator D hR
  exact ⟨ξ, h.symm⟩

/-- If a linear isomorphism `ψ : N_ℝ ≃ N₁(X)` carries the cone of a cone datum onto `NE̅(X)` and
its form onto `(E · -)`, then it carries each ray of `𝓡(NE̅, K)` to an `E`-negative extremal
ray. -/
theorem isNegativeExtremalRayOf_image_of_mem_negativeRationalRays {k : Type} [Field k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [CompactSpace X] [IsLocallyNoetherian X]
    [IsNormal X] {N : Type*} [AddCommGroup N] [Module.Free ℤ N] [Module.Finite ℤ N]
    {D : ConeDatum N} {E : QDivisor X} (hE : E.IsQCartier)
    (ψ : ℝ ⊗[ℤ] N ≃ₗ[ℝ] NumericalCurveClasses sX)
    (hψK : ∀ w, realOfRatForm _ D.form w = MMP.Fourfold.QDivisor.curveForm sX E hE (ψ w))
    (hDc : ∀ w, w ∈ D.cone ↔ ψ w ∈ closedConeOfCurves sX) {R : Set (ℝ ⊗[ℤ] N)}
    (hR : R ∈ D.negativeRationalRays) :
    MMP.Fourfold.IsNegativeExtremalRayOf sX E (ψ '' R) := by
  obtain ⟨ξ, hξ, hRξ, L, hL, hRL⟩ := hR
  have hface : ψ '' R = faceOfNefForm (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
      (realOfRatForm _ L ∘ₗ ψ.symm.toLinearMap) := by
    ext x
    rw [hRL]
    constructor
    · rintro ⟨w, ⟨hw, hL0⟩, rfl⟩
      exact ⟨(hDc w).1 hw, by simpa using hL0⟩
    · rintro ⟨hx, h0⟩
      exact ⟨ψ.symm x, ⟨(hDc _).2 (by simpa using hx), by simpa using h0⟩, by simp⟩
  refine ⟨hE, ⟨?_, ψ ξ, ?_, ?_⟩, ?_⟩
  · rw [hface]
    exact isExtremalFace_faceOfNefForm (isCone_coe _) (fun u hu v hv => add_mem hu hv)
      fun z hz => by simpa using hL (ψ.symm z) ((hDc _).2 (by simpa using hz))
  · intro h
    have := hψK ξ
    rw [h, map_zero] at this
    linarith
  · rw [hRξ]
    ext x
    constructor
    · rintro ⟨w, ⟨c, hc, rfl⟩, rfl⟩
      exact ⟨c, hc, by rw [map_smul]⟩
    · rintro ⟨c, hc, rfl⟩
      exact ⟨c • ξ, ⟨c, hc, rfl⟩, by rw [map_smul]⟩
  · rintro u ⟨w, hw, rfl⟩ hu0
    rw [hRξ] at hw
    obtain ⟨c, hc, rfl⟩ := hw
    have hc0 : 0 < c := lt_of_le_of_ne hc fun h => hu0 (by rw [← h, zero_smul, map_zero])
    rw [← hψK, map_smul, smul_eq_mul]
    exact mul_neg_of_pos_of_neg hc0 hξ

end MMP.FourfoldProofs.Km3bConeTheoremRationalCurvesProof

end

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise

namespace MMP.Mori

open MMP.FourfoldProofs.Km3bConeTheoremRationalCurvesProof MMP.Positivity TensorProduct in
/-- **Cone theorem** (Kollár–Mori 3.7(1)). Let `X` be a projective variety over an algebraically
closed field `k` of characteristic zero, and `(X, Δ)` a klt pair of dimension `n` with canonical
divisor `K` and `Δ` effective. Then there is a countable set `S` of curves on `X`, each a rational
curve `C` with `0 < -((K + Δ) · C) ≤ 2n`, such that
`NE̅(X) = NE̅(X)_{(K + Δ) ≥ 0} + ∑_{C ∈ S} ℝ_{≥0} [C]`. -/
@[mmp "thm_km3b_cone_theorem_rational_curves"]
public theorem exists_countable_isRationalCurve_closedConeOfCurves_eq {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]
    [AlgebraicGeometry.IsProjectiveVariety k sX] {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (hklt : IsKltPair sX n K Δ) (hΔ : Δ.IsEffective) :
    ∃ S : Set (ProperCurve sX), S.Countable ∧
      (∀ C ∈ S,
        IsRationalCurve sX
            (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({C.point} : Set X))) ∧
          0 < -MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2
            (OneCycle.numericalClass sX (C.cycle ℝ)) ∧
          -MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2
            (OneCycle.numericalClass sX (C.cycle ℝ)) ≤ 2 * n) ∧
      (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) =
        ((closedConeOfCurves sX : Set (NumericalCurveClasses sX)) ∩
            {z | 0 ≤ MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2 z}) +
          (PointedCone.hull ℝ
              ((fun C : ProperCurve sX => OneCycle.numericalClass sX (C.cycle ℝ)) '' S) :
            Set (NumericalCurveClasses sX)) := by
  set κ := MMP.Fourfold.QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2
  set cl : ProperCurve sX → NumericalCurveClasses sX :=
    fun C => OneCycle.numericalClass sX (C.cycle ℝ)
  by_cases hnef : QDivisor.IsNef k sX (Divisor.toQDivisor K + Δ)
  · exact ⟨∅, Set.countable_empty, by simp,
      closedConeOfCurves_eq_inter_add_hull_empty_of_isNef hnef hklt.1.2.2⟩
  obtain ⟨m, hm, hCart⟩ := hklt.1.2.2.exists_pos
  obtain ⟨_, _, hbij, -, D, hDcone, hDform, -⟩ :=
    exists_coneDatum_numericalCurveLattice_of_isKltPair hklt hΔ hnef (a := (m : ℤ))
      (by exact_mod_cast hm) hCart
  set ψ := LinearEquiv.ofBijective _ hbij
  have hψK : ∀ w, realOfRatForm _ D.form w = κ (ψ w) := fun w => by
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul r z =>
      simp [ψ, realOfRatForm_tmul, LinearEquiv.ofBijective_apply, LinearMap.liftBaseChange_tmul,
        hDform, κ]
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  have hDc : ∀ w, w ∈ D.cone ↔ ψ w ∈ closedConeOfCurves sX := fun w => by
    rw [← SetLike.mem_coe, hDcone]
    rfl
  have hT : ∀ R : D.negativeRationalRays, ∃ T : ProperCurve sX,
      IsRationalCurve sX
          (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({T.point} : Set X))) ∧
        ψ '' R = {w | ∃ c : ℝ, 0 ≤ c ∧ c • cl T = w} ∧ 0 < -κ (cl T) ∧ -κ (cl T) ≤ 2 * n :=
    fun R => MMP.Fourfold.exists_isRationalCurve_eq_ray_of_isNegativeExtremalRayOf_of_isAlgClosed
      sX hklt (DivisorWithCoeffs.isEffective_iff_nonneg.1 hΔ)
      (isNegativeExtremalRayOf_image_of_mem_negativeRationalRays hklt.1.2.2 ψ hψK hDc R.2)
  choose T hTrat hTray hTpos hTle using hT
  haveI := (countable_negativeRationalRays D).to_subtype
  refine ⟨Set.range T, Set.countable_range T, ?_, Set.Subset.antisymm (fun x hx => ?_)
    (inter_add_hull_subset_closedConeOfCurves _ _)⟩
  · rintro _ ⟨R, rfl⟩
    exact ⟨hTrat R, hTpos R, hTle R⟩
  have hx' : ψ.symm x ∈ (D.cone : Set (ℝ ⊗[ℤ] numericalCurveLattice sX)) :=
    (hDc _).2 (by simpa using hx)
  rw [MMP.Positivity.ConeDatum.cone_eq_nonneg_add_sum_negativeRationalRays D] at hx'
  obtain ⟨c, hc, hc0, F, r, hr, hxr⟩ := hx'
  refine ⟨ψ c, ⟨(hDc c).1 hc, show 0 ≤ κ (ψ c) by rwa [← hψK]⟩, ψ (∑ R ∈ F, r R), ?_, ?_⟩
  · rw [map_sum]
    refine Submodule.sum_mem _ fun R hRF => ?_
    have hRR := (hr R hRF).1
    have hmem : ψ (r R) ∈ ψ '' R := ⟨_, (hr R hRF).2, rfl⟩
    rw [hTray ⟨R, hRR⟩] at hmem
    obtain ⟨t, ht, hteq⟩ := hmem
    exact hteq ▸ (PointedCone.hull ℝ _).smul_mem ht
      (PointedCone.subset_hull ⟨T ⟨R, hRR⟩, ⟨_, rfl⟩, rfl⟩)
  · change ψ c + ψ (∑ R ∈ F, r R) = x
    rw [← map_add, ← hxr, LinearEquiv.apply_symm_apply]

end MMP.Mori

end
