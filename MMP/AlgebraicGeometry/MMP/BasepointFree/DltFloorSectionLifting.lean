            exact hasFreeSections_of_generatingSections (hcart _) τ
          obtain ⟨A', eA'⟩ := hΛ e₀
          have hfA' := hfree e₀ A' le_rfl eA'
          -- the snc divisor `S₀ ⊇ Supp (Θ₀ + P_W + S)`
          let S₀ : Finset (MMP.Mori.PrimeDivisor W) := Θ₀.support ∪ PNW.support ∪ S.support
          have hS₀ : DivisorWithCoeffs.IsSNC (p ≫ sX)
              (∑ E ∈ S₀, Finsupp.single E (1 : ℤ) : MMP.Mori.Divisor W) := by
            have hQ := hsnc (Divisor.toQDivisor (∑ E ∈ S₀, Finsupp.single E (1 : ℤ)))
              fun F hF => by
                rw [Divisor.coeff_toQDivisor, coeff_sum_single_one] at hF
                have hFS : F ∈ S₀ := by
                  by_contra h
                  simp [h] at hF
                simp only [S₀, Finset.mem_union, Finsupp.mem_support_iff] at hFS
                rcases hFS with (h | h) | h
                · exact Or.inr (Or.inl h)
                · rcases hPNWe F h with h' | h'
                  · exact Or.inl h'
                  · exact Or.inr (Or.inr h')
                · exact Or.inl h
            refine hQ.of_support_subset fun F hF => ?_
            rw [Finsupp.mem_support_iff] at hF ⊢
            intro h
            apply hF
            have := (Divisor.coeff_toQDivisor _ F).symm.trans h
            exact_mod_cast this
          refine ⟨m * e₀, fun d hd A hA => ?_⟩
          -- the twist `A''` with `(m - 2) A' + A'' ∼ m₁ A`
          set a := m₁ * d - (m - 2) * e₀ with ha
          obtain ⟨A'', eA''⟩ := hΛ a
          have hmd : (m - 2) * e₀ + e₀ ≤ m₁ * d := by
            have h1 : d ≤ m₁ * d := Nat.le_mul_of_pos_left d hm₁
            obtain ⟨k, hk⟩ : ∃ k, m = k + 2 := ⟨m - 2, by omega⟩
            subst hk
            have : (k + 2) * e₀ = k * e₀ + 2 * e₀ := by ring
            rw [Nat.add_sub_cancel]
            omega
          have hfA'' := hfree a A'' (by rw [ha]; omega) eA''
          have hG₀ := hasFreeSections_nsmul_add hfA' hfA'' (m - 2)
          obtain ⟨T, φ, hTφ, hTS, hTsnc⟩ := exists_reduced_member_isSNC (p ≫ sX) hW.1 hsm
            (hcart _) hG₀ S₀ hS₀
          obtain ⟨χ, hχ⟩ : ∃ χ : (RationalFunctions W)ˣ,
              (m - 2) • A' + A'' = principalDivisor χ + m₁ • A := by
            obtain ⟨e₁⟩ := nonempty_divisorialSheaf_nsmul_add_iso_pullback_pullback f p H
              (hcart A') (hcart A'') eA' eA'' (m - 2)
            obtain ⟨e₂⟩ := nonempty_divisorialSheaf_nsmul_add_iso_pullback_pullback f p H
              (hcart A) (hcart A) hA hA (m₁ - 1)
            have hexp : (m - 2) * e₀ + a = (m₁ - 1) * d + d := by
              have : (m₁ - 1) * d + d = m₁ * d := by
                rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hm₁]
              rw [this, ha]
              omega
            have hA1 : (m₁ - 1) • A + A = m₁ • A := by
              rw [← succ_nsmul, Nat.sub_add_cancel hm₁]
            obtain ⟨φ', hφ'⟩ := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso
              (e₁ ≪≫ eqToIso (by rw [hexp]) ≪≫ e₂.symm ≪≫ eqToIso (by rw [hA1]))
            exact ⟨φ', by rw [← hφ', sub_add_cancel]⟩
          set c : ℚ := ((m : ℚ) - 1) / (q * NP) with hc
          set Δ : MMP.Mori.QDivisor W := Θ₀ + c • Divisor.toQDivisor PNW +
            ((m₁ : ℚ)⁻¹) • Divisor.toQDivisor (∑ E ∈ T, Finsupp.single E (1 : ℤ)) with hΔdef
          have hΔc : ∀ F, Δ.coeff F = Θ₀.coeff F + c * PNW.coeff F +
              (m₁ : ℚ)⁻¹ * (if F ∈ T then 1 else 0) := by
            intro F
            simp only [hΔdef, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
              Divisor.coeff_toQDivisor, coeff_sum_single_one, smul_eq_mul]
            split_ifs <;> simp
          have hc0 : 0 < c := by
            have : (2 : ℚ) ≤ m := by exact_mod_cast hm
            have hq0 : (0 : ℚ) < q := by exact_mod_cast hq
            have hNP0 : (0 : ℚ) < NP := by exact_mod_cast hNP
            rw [hc]
            apply div_pos <;> [linarith; positivity]
          have hT0 : ∀ F ∈ T, Θ₀.coeff F = 0 ∧ PNW.coeff F = 0 ∧ S.coeff F = 0 := by
            intro F hF
            have : F ∉ S₀ := Finset.disjoint_left.1 hTS hF
            simp only [S₀, Finset.mem_union, Finsupp.mem_support_iff, not_or, not_not] at this
            exact ⟨this.1.1, this.1.2, this.2⟩
          refine ⟨KW, Δ, hKW, ?_, ?_, ?_, ?_, ?_⟩
          · -- simple normal crossings, inside `T ∪ S₀`
            refine hTsnc.of_support_subset fun F hF => ?_
            rw [Finsupp.mem_support_iff] at hF ⊢
            have hmem : F ∈ T ∪ S₀ := by
              by_contra hn
              simp only [Finset.mem_union, not_or] at hn
              apply hF
              have hS₀F := hn.2
              simp only [S₀, Finset.mem_union, Finsupp.mem_support_iff, not_or, not_not]
                at hS₀F
              show Δ.coeff F = 0
              rw [hΔc F, (show Θ₀.coeff F = 0 from hS₀F.1.1),
                (show PNW.coeff F = 0 from hS₀F.1.2), if_neg hn.1]
              simp
            change (∑ E ∈ T ∪ S₀, Finsupp.single E (1 : ℤ) : MMP.Mori.Divisor W).coeff F ≠ 0
            rw [coeff_sum_single_one, if_pos hmem]
            exact one_ne_zero
          · -- coefficients at least zero
            intro F
            rw [hΔc F]
            have h1 := hΘ0 F
            have h2 : (0 : ℚ) ≤ PNW.coeff F := by exact_mod_cast hPNW0 F
            have h3 : (0 : ℚ) ≤ (m₁ : ℚ)⁻¹ := by positivity
            split_ifs <;> positivity
          · -- coefficients at most one
            intro F
            rw [hΔc F]
            by_cases hF : F ∈ T
            · obtain ⟨h1, h2, -⟩ := hT0 F hF
              rw [h1, h2, if_pos hF]
              simp only [Int.cast_zero, mul_zero, zero_add, mul_one]
              exact inv_le_one_of_one_le₀ (by exact_mod_cast hm₁)
            · rw [if_neg hF, mul_zero, add_zero]
              exact (hqc F).le
          · -- the `ℚ`-linear equivalence `M₁ + A ∼_ℚ K_W + Δ`
            refine ⟨m₁, hm₁, (φ * χ)⁻¹, ?_⟩
            ext F
            have e3 := congrArg (fun G : MMP.Mori.Divisor W => G.coeff F) hTφ
            have e4 := congrArg (fun G : MMP.Mori.Divisor W => G.coeff F) hχ
            simp only [coeff_sum_single_one, DivisorWithCoeffs.coeff_add,
              DivisorWithCoeffs.coeff_smul, MMP.Mori.coeff_principalDivisor, nsmul_eq_mul,
              Nat.cast_one, one_mul] at e3 e4
            have hθ : Θ₀.coeff F = ΔW.coeff F - S.coeff F + E.coeff F := by
              rw [hΘ₀, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
                Divisor.coeff_toQDivisor, Divisor.coeff_toQDivisor]
            have e1 := hDmWq F
            have e2 := hLWq F
            have hΔF := hΔc F
            change ((m₁ : ℤ) • (Divisor.toQDivisor (M₁ + A) -
                (Divisor.toQDivisor KW + Δ))).coeff F =
              (Divisor.toQDivisor (MMP.Mori.principalDivisor (φ * χ)⁻¹)).coeff F
            rw [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub,
              DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, Divisor.coeff_toQDivisor,
              Divisor.coeff_toQDivisor, hΔF, MMP.Mori.principalDivisor_inv,
              MMP.Mori.principalDivisor_mul, hM₁]
            simp only [DivisorWithCoeffs.coeff_neg, DivisorWithCoeffs.coeff_add,
              DivisorWithCoeffs.coeff_sub, MMP.Mori.coeff_principalDivisor, zsmul_eq_mul]
            have hm2 : ((m - 2 : ℕ) : ℚ) = (m : ℚ) - 2 := by
              rw [Nat.cast_sub hm]; norm_num
            have e3' : ((if F ∈ T then 1 else 0 : ℤ) : ℚ) = (F.ord φ : ℚ) +
                (((m - 2 : ℕ) : ℚ) * ((A'.coeff F : ℚ) + LW.coeff F) +
                ((A''.coeff F : ℚ) + LW.coeff F)) := by exact_mod_cast e3
            have e4' : ((m - 2 : ℕ) : ℚ) * (A'.coeff F : ℚ) + A''.coeff F =
                (F.ord χ : ℚ) + (m₁ : ℚ) * A.coeff F := by exact_mod_cast e4
            rw [hm2] at e3' e4'
            have hite : ((if F ∈ T then 1 else 0 : ℤ) : ℚ) = (if F ∈ T then 1 else 0 : ℚ) := by
              split_ifs <;> simp
            rw [hite] at e3'
            have hm₁' : (m₁ : ℚ) * (m₁ : ℚ)⁻¹ = 1 := mul_inv_cancel₀ (by exact_mod_cast hm₁.ne')
            push_cast
            rw [hc]
            linear_combination (m₁ : ℚ) * e1 - (m₁ : ℚ) * hθ - e3' - e4' -
              ((m : ℚ) - 1) * e2 - (if F ∈ T then (1 : ℚ) else 0) * hm₁'
          · -- the components of `S` have fractional coefficients
            intro F hF
            rw [Finsupp.mem_support_iff] at hF ⊢
            have hSF : S.coeff F ≠ 0 := hF
            have hFT : F ∉ T := fun h => hSF (hT0 F h).2.2
            show Δ.fract.coeff F ≠ 0
            rw [DivisorWithCoeffs.coeff_fract, hΔc F, hSΘ F hSF, if_neg hFT]
            simp only [zero_add, mul_zero, add_zero]
            have hpos : 0 < c * PNW.coeff F :=
              mul_pos hc0 (by exact_mod_cast hPNWS F hSF)
            have hlt : c * PNW.coeff F < 1 := by
              have := hqc F
              rw [hSΘ F hSF] at this
              simpa using this
            rw [Int.fract_eq_self.2 ⟨hpos.le, hlt⟩]
            exact hpos.ne'
        refine ⟨d₀, fun d hd A hA => ?_⟩
        obtain ⟨KW', Δ, hK', hΔs, hΔ0', hΔ1', hlin, hsupp⟩ := hB₁ d hd A hA
        haveI : MMP.Mori.IsProjectiveVariety ℂ (p ≫ sX) := by
          have hXp := (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sX)
          rw [MMP.Mori.isProjectiveVariety_iff] at hXp ⊢
          exact ⟨hW.1, hproj.comp hXp.2⟩
        have hinj := MMP.Mori.injective_derivedCohomologyOverField_map_divisorialSheafInclusion
          (p ≫ sX) hsm hK' Δ hΔs hΔ0' hΔ1' (M₁ + A) hlin S hS0 hsupp 1
        have hm := mono_Hfunctor_of_injective_derivedCohomology (p ≫ sX) _ 1 hinj
        have heq : M₁ + A + S = M₁ + S + A := add_right_comm _ _ _
        have hsplit : MMP.Mori.Divisor.divisorialSheafInclusion
              (add_le_add (le_add_of_nonneg_right hS0) le_rfl : M₁ + A ≤ M₁ + S + A) =
            MMP.Mori.Divisor.divisorialSheafInclusion (le_add_of_nonneg_right hS0 :
              M₁ + A ≤ M₁ + A + S) ≫ MMP.Mori.Divisor.divisorialSheafInclusion heq.le := by
          rw [MMP.Mori.Divisor.divisorialSheafInclusion_comp]
        have hiso : IsIso (MMP.Mori.Divisor.divisorialSheafInclusion heq.le) :=
          ⟨⟨MMP.Mori.Divisor.divisorialSheafInclusion heq.ge, by
            rw [MMP.Mori.Divisor.divisorialSheafInclusion_comp]
            exact MMP.Mori.Divisor.divisorialSheafInclusion_refl, by
            rw [MMP.Mori.Divisor.divisorialSheafInclusion_comp]
            exact MMP.Mori.Divisor.divisorialSheafInclusion_refl⟩⟩
        rw [hsplit]
        have hc := @mono_comp _ _ _ _ _ _ hm
          ((Hfunctor W.ringCatSheaf ⊤ 1).map (MMP.Mori.Divisor.divisorialSheafInclusion heq.le))
          (@IsIso.mono_of_iso _ _ _ _ _
            ((Hfunctor W.ringCatSheaf ⊤ 1).mapIso (@asIso _ _ _ _ _ hiso)).isIso_hom)
        convert hc using 1
        exact Functor.map_comp _ _ _
      refine ⟨d₀, fun d hd => ?_⟩
      set N : W.Modules := (Scheme.Modules.pullback p).obj
        ((Scheme.Modules.pullback f).obj (Stacks.Ample.tensorPowModule Z H d)) with hN
      haveI : Stacks.Ample.IsInvertibleModule X
          ((Scheme.Modules.pullback f).obj (Stacks.Ample.tensorPowModule Z H d)) :=
        Stacks.InvertiblePullback.isInvertibleModule_pullback f _
      haveI hNinv : Stacks.Ample.IsInvertibleModule W N :=
        Stacks.InvertiblePullback.isInvertibleModule_pullback p _
      haveI : AlgebraicGeometry.SheafOfModules.IsInvertible W.sheaf.obj W.ringCatSheaf.property N :=
        hNinv
      obtain ⟨A, ⟨ιA⟩⟩ := MMP.Mori.exists_divisorialSheaf_iso_of_isInvertible N
      have hmono := hd₀ d hd A ⟨ιA⟩
      have hAc := hcart A
      let mul₁ := (hcart M₁).divisorialSheafTensorIso hAc
      let mul₂ := (hcart (M₁ + S)).divisorialSheafTensorIso hAc
      let tA := fun G : MMP.Mori.Divisor W =>
        ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨W.toRingedSpace.presheaf,
          W.toRingedSpace.IsSheaf⟩).obj G.divisorialSheaf).mapIso ιA.symm
      have hw : (tensorRightModules W N).map (MMP.Mori.Divisor.divisorialSheafInclusion
            (le_add_of_nonneg_right hS0 : M₁ ≤ M₁ + S)) ≫ ((tA (M₁ + S)).hom ≫ mul₂.hom) =
          ((tA M₁).hom ≫ mul₁.hom) ≫ MMP.Mori.Divisor.divisorialSheafInclusion
            (add_le_add (le_add_of_nonneg_right hS0) le_rfl : M₁ + A ≤ M₁ + S + A) := by
        have h1 := ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨W.toRingedSpace.presheaf,
          W.toRingedSpace.IsSheaf⟩).map (MMP.Mori.Divisor.divisorialSheafInclusion
            (le_add_of_nonneg_right hS0 : M₁ ≤ M₁ + S))).naturality ιA.inv
        have h2 := MMP.Mori.Divisor.map_divisorialSheafInclusion_comp_divisorialSheafTensorMul
          (le_add_of_nonneg_right hS0 : M₁ ≤ M₁ + S) A
        show ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨W.toRingedSpace.presheaf,
            W.toRingedSpace.IsSheaf⟩).map (MMP.Mori.Divisor.divisorialSheafInclusion
              (le_add_of_nonneg_right hS0 : M₁ ≤ M₁ + S))).app N ≫
            (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨W.toRingedSpace.presheaf,
              W.toRingedSpace.IsSheaf⟩).obj (M₁ + S).divisorialSheaf).map ιA.inv ≫
              MMP.Mori.Divisor.divisorialSheafTensorMul (M₁ + S) A) =
          (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨W.toRingedSpace.presheaf,
              W.toRingedSpace.IsSheaf⟩).obj M₁.divisorialSheaf).map ιA.inv ≫
              MMP.Mori.Divisor.divisorialSheafTensorMul M₁ A) ≫
            MMP.Mori.Divisor.divisorialSheafInclusion
              (add_le_add (le_add_of_nonneg_right hS0) le_rfl : M₁ + A ≤ M₁ + S + A)
        exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) h1.symm).trans
          ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·) h2).trans
            (Category.assoc _ _ _).symm)))
      have i₁ : IsIso ((tA M₁).hom ≫ mul₁.hom) := (tA M₁ ≪≫ mul₁).isIso_hom
      have i₂ : IsIso ((tA (M₁ + S)).hom ≫ mul₂.hom) := (tA (M₁ + S) ≪≫ mul₂).isIso_hom
      exact (@mono_map_iff_of_comm_sq _ _ _ _ (Hfunctor W.ringCatSheaf ⊤ 1) _ _ _ _ _ _ _ _ i₁ i₂
        hw).2 hmono
  refine ⟨d₀, fun d hd => ?_⟩
  set N : X.Modules := (Scheme.Modules.pullback f).obj (Stacks.Ample.tensorPowModule Z H d)
  haveI : Stacks.Ample.IsInvertibleModule X N :=
    Stacks.InvertiblePullback.isInvertibleModule_pullback f _
  -- the projection formula identifies the direct image of the twisted inclusion
  let η := MMP.SemiampleSections.projectionFormulaNatTrans p N
  have iη₁ : IsIso (η.app G₁) := inferInstance
  have iη₂ : IsIso (η.app G₂) := inferInstance
  have hw : (tensorRightModules X N).map ((Scheme.Modules.pushforward p).map j) ≫ η.app G₂ =
      η.app G₁ ≫ (Scheme.Modules.pushforward p).map
        ((tensorRightModules W ((Scheme.Modules.pullback p).obj N)).map j) := η.naturality j
  have hTw : Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map
      ((tensorRightModules X N).map ((Scheme.Modules.pushforward p).map j))) :=
    (@mono_map_iff_of_comm_sq _ _ _ _ (Hfunctor X.ringCatSheaf ⊤ 1) _ _ _ _ _ _ (η.app G₁)
      (η.app G₂) iη₁ iη₂ hw).2
      (mono_Hfunctor_one_pushforward_map p _
        (fun i hi => isZero_rightDerived_pushforward_tensorRight_pullback p N G₁ i (h₁ i hi))
        (fun i hi => isZero_rightDerived_pushforward_tensorRight_pullback p N G₂ i (h₂ i hi))
        (hd₀ d hd))
  -- transport along `e₀`, twisted by `N`
  have we : (Scheme.Modules.pushforward p).map j ≫ e₀.hom.right =
      e₀.hom.left ≫ Limits.kernel.ι u := (Arrow.w e₀.hom).symm
  have wT : (tensorRightModules X N).map ((Scheme.Modules.pushforward p).map j) ≫
      (tensorRightModules X N).map e₀.hom.right =
      (tensorRightModules X N).map e₀.hom.left ≫
        (tensorRightModules X N).map (Limits.kernel.ι u) := by
    rw [← Functor.map_comp, ← Functor.map_comp, we]
  have iL : IsIso ((tensorRightModules X N).map e₀.hom.left) := inferInstance
  have iR : IsIso ((tensorRightModules X N).map e₀.hom.right) := inferInstance
  exact (@mono_map_iff_of_comm_sq _ _ _ _ (Hfunctor X.ringCatSheaf ⊤ 1) _ _ _ _ _ _ _ _ iL iR
    wT).1 hTw

open Stacks.Coherent (tensorRightModules) in
/-- **The cohomological core.** In the setting of `epi_pushforward_map_unit_suppScheme_of_isRelativelySemiample`, let `u : 𝒪_X(mD) ⟶ ι_* ι^* 𝒪_X(mD)`
be the restriction to the reduced floor `T` and `H` an ample invertible module on `Z`. Then for all
large `d`, the map `H¹(X, 𝓘_T 𝒪_X(mD) ⊗ f^* H^{⊗ d}) ⟶ H¹(X, 𝒪_X(mD) ⊗ f^* H^{⊗ d})` induced by
the kernel `𝓘_T 𝒪_X(mD) = ker u` of the restriction is a monomorphism. -/
private theorem exists_mono_Hfunctor_one_kernel_unit
    {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ sZ]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (f : X ⟶ Z) (hf : f ≫ sZ = sX) (hfp : IsProjectiveMorphism f)
    {n : ℕ} (K : MMP.Mori.Divisor X) (B : MMP.Mori.QDivisor X)
    (hdlt : MMP.Mori.IsDltPair sX n K B) (hQ : MMP.Fourfold.IsQFactorial sX)
    (P : MMP.Mori.QDivisor X) (hP0 : 0 ≤ P) (hPQ : P.IsQCartier)
    (hPsupp : P.supp = B.roundDown.supp)
    (hsemi : ∃ ε₀ : ℚ, 0 < ε₀ ∧ ∀ ε : ℚ, 0 < ε → ε < ε₀ →
      QDivisor.IsRelativelySemiample f (Divisor.toQDivisor K + B - ε • P))
    (m : ℕ) (hm : 2 ≤ m) (Dm : MMP.Mori.Divisor X)
    (hDm : Divisor.toQDivisor Dm = (m : ℚ) • (Divisor.toQDivisor K + B)) (hDmC : Dm.IsCartier)
    (H : Z.Modules) [Stacks.Ample.IsInvertibleModule Z H] (hH : Stacks.Ample.IsAmple Z H) :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d →
      Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map
        ((tensorRightModules X ((Scheme.Modules.pullback f).obj
            (Stacks.Ample.tensorPowModule Z H d))).map
          (Limits.kernel.ι ((Scheme.Modules.pullbackPushforwardAdjunction
            B.roundDown.suppIdeal.subschemeι).unit.app Dm.divisorialSheaf)))) := by
  have hZproj := (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sZ)
  haveI : MMP.Mori.IsProjectiveVariety ℂ sX := by
    rw [← hf]
    rw [MMP.Mori.isProjectiveVariety_iff] at hZproj ⊢
    exact ⟨hf ▸ hdlt.isPairWith.1.1, hfp.comp hZproj.2⟩
  obtain ⟨W, _, _, _, p, _, hres, hW, ΔW, hΔ, hΔ1⟩ :=
    exists_isLogResolution_coeff_lt_one sX K B hdlt
  exact exists_mono_Hfunctor_one_kernel_unit_of_resolution sX sZ f hf hfp K B hdlt hQ P hP0 hPQ
    hPsupp hsemi m hm Dm hDm hDmC H hH p hres hW ΔW hΔ hΔ1

/-! ### Finiteness and ampleness on `Z` -/

/-- A projective complex variety carries an ample invertible module. -/
private theorem exists_isAmple_isInvertibleModule {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ sZ] :
    ∃ (H : Z.Modules) (_ : Stacks.Ample.IsInvertibleModule Z H), Stacks.Ample.IsAmple Z H := by
  obtain ⟨H, hH, hHa⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety
    (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sZ)
  haveI : Stacks.Ample.IsInvertibleModule Z H := hH
  exact ⟨H, inferInstance, (Stacks.AmpleBridge.isAmple_iff_isAmple Z H).mpr hHa⟩

/-- The direct images `f_* 𝒪_X(D)` and `f_*(ι_* ι^* 𝒪_X(D))` of a Cartier divisor `D` along the
projective `f` are coherent. -/
private theorem isCoherent_pushforward_divisorialSheaf_and_restriction
    {X Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ)) [MMP.Mori.IsProjectiveVariety ℂ sZ]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (f : X ⟶ Z) (hfp : IsProjectiveMorphism f)
    (T : MMP.Mori.Divisor X) (Dm : MMP.Mori.Divisor X) (hDmC : Dm.IsCartier) :
    SheafOfModules.IsCoherent ((Scheme.Modules.pushforward f).obj Dm.divisorialSheaf) ∧
      SheafOfModules.IsCoherent ((Scheme.Modules.pushforward f).obj
        ((Scheme.Modules.pushforward T.suppIdeal.subschemeι).obj
          ((Scheme.Modules.pullback T.suppIdeal.subschemeι).obj Dm.divisorialSheaf))) := by
  have hZproj := (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sZ)
  haveI : IsProper sZ := isProper_of_isProjectiveMorphism sZ hZproj.isProjective
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hfp
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  haveI : Stacks.Ample.IsInvertibleModule X Dm.divisorialSheaf :=
    hDmC.isInvertibleModule_divisorialSheaf
  haveI : Dm.divisorialSheaf.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible X _
  set ι := T.suppIdeal.subschemeι
  haveI : Stacks.Ample.IsInvertibleModule _ ((Scheme.Modules.pullback ι).obj Dm.divisorialSheaf) :=
    Stacks.InvertiblePullback.isInvertibleModule_pullback ι _
  haveI : ((Scheme.Modules.pullback ι).obj Dm.divisorialSheaf).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible _ _
  haveI : ((Scheme.Modules.pushforward ι).obj
      ((Scheme.Modules.pullback ι).obj Dm.divisorialSheaf)).IsCoherent :=
    ProperCoherenceWitness.isCoherent_pushforward ι _
  exact ⟨ProperCoherenceWitness.isCoherent_pushforward f _,
    ProperCoherenceWitness.isCoherent_pushforward f _⟩

end MMP.Fourfold.DltFloorSectionLifting

open CategoryTheory AlgebraicGeometry MMP.Mori

namespace MMP.Fourfold

open DltFloorSectionLifting MonoidalCategory in
/-- **Lifting sections from the whole floor of a dlt pair.** Let `(X, B)` be a `ℚ`-factorial dlt
pair (canonical divisor `K`, dimension `n`) over `ℂ`, with `f : X ⟶ Z` projective over a
projective variety `Z`. Put `D = K + B` and `T = ⌊B⌋`. Suppose `P ≥ 0` is `ℚ`-Cartier with
`Supp P = Supp T` and `D - εP` is semiample over `Z` for all sufficiently small rational `ε > 0`.
If `m ≥ 2` and `D_m = mD` is Cartier, then the restriction `f_* 𝒪_X(D_m) ⟶ f_* ι_* ι^* 𝒪_X(D_m)` to
the reduced subscheme `ι : T ⟶ X` is an epimorphism. -/
@[mmp "lem_fourfold_lift_from_whole_dlt_floor"]
public theorem epi_pushforward_map_unit_suppScheme_of_isRelativelySemiample
    {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ sZ]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (f : X ⟶ Z) (hf : f ≫ sZ = sX) (hfp : IsProjectiveMorphism f)
    {n : ℕ} (K : MMP.Mori.Divisor X) (B : MMP.Mori.QDivisor X)
    (hdlt : MMP.Mori.IsDltPair sX n K B) (hQ : MMP.Fourfold.IsQFactorial sX)
    (P : MMP.Mori.QDivisor X) (hP0 : 0 ≤ P) (hPQ : P.IsQCartier)
    (hPsupp : P.supp = B.roundDown.supp)
    (hsemi : ∃ ε₀ : ℚ, 0 < ε₀ ∧ ∀ ε : ℚ, 0 < ε → ε < ε₀ →
      QDivisor.IsRelativelySemiample f (Divisor.toQDivisor K + B - ε • P))
    (m : ℕ) (hm : 2 ≤ m) (Dm : MMP.Mori.Divisor X)
    (hDm : Divisor.toQDivisor Dm = (m : ℚ) • (Divisor.toQDivisor K + B)) (hDmC : Dm.IsCartier) :
    Epi ((Scheme.Modules.pushforward f).map
      ((Scheme.Modules.pullbackPushforwardAdjunction B.roundDown.suppIdeal.subschemeι).unit.app
        Dm.divisorialSheaf)) := by
  classical
  have hZproj := (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sZ)
  haveI : IsProper sZ := isProper_of_isProjectiveMorphism sZ hZproj.isProjective
  obtain ⟨H, hHinv, hH⟩ := exists_isAmple_isInvertibleModule sZ
  set ι := B.roundDown.suppIdeal.subschemeι with hι
  set u := (Scheme.Modules.pullbackPushforwardAdjunction ι).unit.app Dm.divisorialSheaf with hu
  obtain ⟨hc₁, hc₂⟩ := isCoherent_pushforward_divisorialSheaf_and_restriction sZ f hfp
    B.roundDown Dm hDmC
  obtain ⟨d₀, hd₀⟩ := exists_mono_Hfunctor_one_kernel_unit sX sZ f hf hfp K B hdlt hQ P hP0 hPQ
    hPsupp hsemi m hm Dm hDm hDmC H hH
  haveI : Epi u := Stacks.ClosedImmersion.epi_unit_app ι _
  let S : ShortComplex X.Modules :=
    ShortComplex.mk (Limits.kernel.ι u) u (Limits.kernel.condition u)
  have hS : S.ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel u) }
  refine @epi_of_eventually_surjective_twist Z sZ _ H hHinv hH _ _ hc₁ hc₂
    ((Scheme.Modules.pushforward f).map u) ⟨d₀, fun d hd => ?_⟩
  exact surjective_app_tensorRight_pushforward_map f _ u
    (surjective_app_tensorRight_g_of_mono hS _ (hd₀ d hd))

end MMP.Fourfold
