/-!
# Lifting adjoint sections from the whole floor of a dlt pair

Let `(X, B)` be a `ℚ`-factorial dlt pair, with `B` a `ℚ`-divisor, on a normal complex variety,
and let `f : X ⟶ Z` be a projective
morphism to a projective variety `Z`. Put `D = K_X + B` and let `T = ⌊B⌋`, regarded as the
reduced closed subscheme `ι : T ⟶ X` supported on `Supp ⌊B⌋` (the whole reduced union of the
components of coefficient one). Suppose that there is an effective `ℚ`-Cartier divisor `P` with
`Supp P = T` such that `D - εP` is semiample over `Z` for every sufficiently small rational
`ε > 0`. Then for every integer `m ≥ 2` such that `mD` is Cartier, the restriction map
`f_* 𝒪_X(mD) ⟶ f_* ι_* ι^* 𝒪_X(mD) = f_* 𝒪_T(mD)` is surjective.

## Main results

* `MMP.Fourfold.epi_pushforward_map_unit_suppScheme_of_isRelativelySemiample`

## Implementation notes

* `𝒪_X(mD)` is `MMP.Mori.Divisor.divisorialSheaf` of the integral divisor `D_m` whose
  `ℚ`-divisor is `m (K_X + B)`, assumed Cartier; `D_m` is determined by `m`, `K` and `B`.
* The restriction `𝒪_X(mD) ⟶ ι_* ι^* 𝒪_X(mD)` is the unit of the adjunction `ι^* ⊣ ι_*`, for
  `ι` the closed immersion of the reduced subscheme `MMP.Mori.DivisorWithCoeffs.suppScheme` of
  `⌊B⌋`; the relative restriction map is its image under `f_*`, and surjectivity is being an
  epimorphism of sheaves of `𝒪_Z`-modules.
* "Semiample over `Z`" is `MMP.Fourfold.QDivisor.IsRelativelySemiample f`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori]
-/

@[expose] public section

namespace MMP.Fourfold.DltFloorSectionLifting

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Fourfold MonoidalCategory

/-! ### Detecting epimorphisms on a projective base by twisted global sections -/

open Stacks.Coherent (tensorRightModules) in
/-- A module generated by its global sections, all of whose global sections vanish, is zero. -/
private theorem isZero_of_generatingSections {Z : Scheme.{0}} (M : Z.Modules)
    (σ : M.GeneratingSections) (h0 : ∀ s : Γ(M, ⊤), s = 0) : Limits.IsZero M := by
  let A : Z.Modules := SheafOfModules.free σ.I
  let f : A ⟶ M := M.freeHomEquiv.symm σ.s
  have hf : f = 0 := by
    apply M.freeHomEquiv.injective
    funext i
    simp only [f, Equiv.apply_symm_apply]
    apply Subtype.ext
    funext U
    have h1 : (σ.s i).1 U = M.val.presheaf.map (homOfLE le_top).op ((σ.s i).1 (Opposite.op ⊤)) :=
      ((σ.s i).2 (homOfLE (le_top : U.unop ≤ ⊤)).op).symm
    rw [h1, show (σ.s i).1 (Opposite.op ⊤) = 0 from h0 _, map_zero]
    show _ = (SheafOfModules.sectionsMap (0 : A ⟶ M) (SheafOfModules.freeSection i)).1 U
    rfl
  have he : Epi f := σ.epi
  rw [hf] at he
  exact @Limits.IsZero.of_epi_zero _ _ _ A M he

open Stacks.Coherent (tensorRightModules) in
/-- On a scheme proper over `ℂ` with an ample invertible module `H`, a morphism `ψ` of coherent
modules is an epimorphism as soon as the maps it induces on the global sections of the twists by
`H^{⊗ d}` are surjective for all large `d`. -/
private theorem epi_of_eventually_surjective_twist {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ))
    [IsProper sZ] (H : Z.Modules) [Stacks.Ample.IsInvertibleModule Z H]
    (hH : Stacks.Ample.IsAmple Z H) {𝓕 𝓖 : Z.Modules} [SheafOfModules.IsCoherent 𝓕]
    [SheafOfModules.IsCoherent 𝓖] (ψ : 𝓕 ⟶ 𝓖)
    (h : ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → Function.Surjective
      (((tensorRightModules Z (Stacks.Ample.tensorPowModule Z H d)).map ψ).app ⊤)) :
    Epi ψ := by
  classical
  obtain ⟨d₀, hd₀⟩ := h
  let π := Limits.cokernel.π ψ
  let S : ShortComplex Z.Modules :=
    ShortComplex.mk (Limits.kernel.ι π) π (Limits.kernel.condition π)
  have hS : S.ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel π) }
  have hQc : (Limits.cokernel ψ).IsCoherent := CoherentAbelian.isCoherent_cokernel ψ
  have hKc : (Limits.kernel π).IsCoherent := @CoherentAbelian.isCoherent_kernel _ _ _ _ _ _ hQc π
  obtain ⟨d₁, hd₁⟩ :=
    @Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_isZero_Hgroup_tensorPowTwist Z ℂ _ _ sZ
      _ (Limits.kernel π) H hKc _ hH
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple
      H hH).2 (Limits.cokernel ψ) (@_root_.isQuasicoherent_of_isCoherent _ _ _ _ hQc)
      (@SheafOfModules.IsCoherent.isFiniteType _ _ _ _ hQc)
  set d : ℕ := max d₀ (max d₁ n₀.toNat) with hd
  set N : Z.Modules := Stacks.Ample.tensorPowModule Z H d with hN
  have hepi := Stacks.Coherent.epi_secF_map_tensorRight_g_of_isZero_Hgroup ⊤ hS N
    (hd₁ d 1 (by omega) one_pos)
  have hsurjQ : Function.Surjective (((tensorRightModules Z N).map π).app ⊤) :=
    (AddCommGrpCat.epi_iff_surjective _).1 hepi
  have hzero : ∀ t : Γ((tensorRightModules Z N).obj (Limits.cokernel ψ), ⊤), t = 0 := by
    intro t
    obtain ⟨s, rfl⟩ := hsurjQ t
    obtain ⟨r, rfl⟩ := hd₀ d (by omega) s
    have h0 : (tensorRightModules Z N).map ψ ≫ (tensorRightModules Z N).map π = 0 := by
      rw [← Functor.map_comp, Limits.cokernel.condition, Functor.map_zero]
    rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, h0,
      Scheme.Modules.Hom.zero_app]
    rfl
  have hgen : SheafOfModules.IsGeneratedByGlobalSections.{0, 0, 0}
      (Stacks.RelativeVeryAmple.tensorModules Z (Limits.cokernel ψ) N) :=
    Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
      (Stacks.AmplePullbackPart1.tensorIsoTensorModules Z _ _) (hn₀ d (by omega))
  obtain ⟨σ⟩ := hgen
  have hQN : Limits.IsZero ((tensorRightModules Z N).obj (Limits.cokernel ψ)) :=
    isZero_of_generatingSections _ σ hzero
  have hQ : Limits.IsZero (Limits.cokernel ψ) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (tensorRightModules Z N).map_injective
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
    exact hQN.eq_of_src _ _
  exact epi_of_isZero_cokernel ψ hQ

/-! ### Transfer along the projection formula -/

open Stacks.Coherent (tensorRightModules) in
/-- If `u : F ⟶ G` on `X` is surjective on global sections after twisting by `f^* N`, for `N`
invertible on `Z`, then `f_* u` is surjective on global sections after twisting by `N`: the two
maps are related by the projection formula `f_* F ⊗ N ≅ f_*(F ⊗ f^* N)`. -/
private theorem surjective_app_tensorRight_pushforward_map {X Z : Scheme.{0}} (f : X ⟶ Z)
    (N : Z.Modules) [Stacks.Ample.IsInvertibleModule Z N] {F G : X.Modules} (u : F ⟶ G)
    (h : Function.Surjective
      (((tensorRightModules X ((Scheme.Modules.pullback f).obj N)).map u).app ⊤)) :
    Function.Surjective
      (((tensorRightModules Z N).map ((Scheme.Modules.pushforward f).map u)).app ⊤) := by
  let η := MMP.SemiampleSections.projectionFormulaNatTrans f N
  have hnat := η.naturality u
  haveI : IsIso (η.app G) := inferInstance
  haveI : IsIso (η.app F) := inferInstance
  have hsurjF : Function.Surjective ((η.app F).app ⊤) := fun y =>
    ⟨(inv (η.app F)).app ⊤ y, by
      rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, IsIso.inv_hom_id]; rfl⟩
  have key : Function.Surjective
      (((MMP.SemiampleSections.sheafTensorRight N).map ((Scheme.Modules.pushforward f).map u) ≫
        η.app G).app ⊤) := by
    have hnat' : (MMP.SemiampleSections.sheafTensorRight N).map
        ((Scheme.Modules.pushforward f).map u) ≫ η.app G =
        η.app F ≫ (Scheme.Modules.pushforward f).map
          ((MMP.SemiampleSections.sheafTensorRight ((Scheme.Modules.pullback f).obj N)).map u) :=
      hnat
    rw [hnat', Scheme.Modules.Hom.comp_app]
    exact h.comp hsurjF
  intro y
  obtain ⟨x, hx⟩ := key (((η.app G)).app ⊤ y)
  refine ⟨x, ?_⟩
  have hinj : Function.Injective ((η.app G).app ⊤) := fun a b hab => by
    have := congrArg ((inv (η.app G)).app ⊤) hab
    simpa only [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app,
      IsIso.hom_inv_id, Scheme.Modules.Hom.id_app, CategoryTheory.id_apply] using this
  rw [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply] at hx
  exact hinj hx

/-! ### The long exact sequence on `X` -/

section StandardDerived

attribute [local instance] HasDerivedCategory.standard

/-- For a short exact sequence `0 ⟶ S₁ ⟶ S₂ ⟶ S₃ ⟶ 0`, if `H¹(X, S₁) ⟶ H¹(X, S₂)` is a
monomorphism then `Γ(X, S₂) ⟶ Γ(X, S₃)` is surjective: the connecting map
`Γ(X, S₃) ⟶ H¹(X, S₁)` vanishes. -/
private theorem surjective_app_g_of_mono {X : Scheme.{0}} {S : ShortComplex X.Modules}
    (hS : S.ShortExact) (h : Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map S.f)) :
    Function.Surjective (S.g.app ⊤) := by
  let D := Stacks.SerreAffinenessCriterion.cohomologyDeltaFunctor X ⊤
  have hδ : D.δ hS 0 = 0 := by
    haveI : Mono ((D.functor (0 + 1)).map S.f) := h
    exact (cancel_mono _).1 ((D.δ_map_f hS 0).trans (Limits.zero_comp).symm)
  have hD := Stacks.CohomologyVanishing.isCohomologyDeltaFunctor_rightDerived X.ringCatSheaf ⊤
  have hepi : Epi ((D.functor 0).map S.g) :=
    (ShortComplex.exact_iff_epi (D.scδ₁ hS 0) hδ).1 (D.exact_δ₁ hS 0)
  have hnat := hD.isoZero.hom.naturality S.g
  have : IsIso (hD.isoZero.hom.app S.X₃) := inferInstanceAs (IsIso (hD.isoZero.app S.X₃).hom)
  have hcomp : Epi ((D.functor 0).map S.g ≫ hD.isoZero.hom.app S.X₃) := epi_comp _ _
  rw [hnat] at hcomp
  have : Epi ((secF X.ringCatSheaf ⊤).map S.g) := epi_of_epi (hD.isoZero.hom.app S.X₂) _
  exact (AddCommGrpCat.epi_iff_surjective _).1 this

open Stacks.Coherent (tensorRightModules) in
/-- `surjective_app_g_of_mono` after twisting by an invertible `N`, which preserves short exact
sequences. -/
private theorem surjective_app_tensorRight_g_of_mono {X : Scheme.{0}} {S : ShortComplex X.Modules}
    (hS : S.ShortExact) (N : X.Modules) [Stacks.Ample.IsInvertibleModule X N]
    (h : Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map ((tensorRightModules X N).map S.f))) :
    Function.Surjective (((tensorRightModules X N).map S.g).app ⊤) :=
  surjective_app_g_of_mono (S := S.map (tensorRightModules X N)) (hS.map_of_exact _) h

/-! ### Leray for direct images without higher direct images -/

attribute [local instance 2000] HomotopyCategory.Plus.instHasPointwiseRightDerivedFunctorQuasiIso

/-- In a commutative square `a ≫ φ₂ = φ₁ ≫ b` whose vertical sides `φ₁`, `φ₂` are isomorphisms,
`a` is a monomorphism exactly when `b` is. -/
private theorem mono_iff_of_comm_sq {C : Type*} [Category C] {A B A' B' : C} {a : A ⟶ B}
    {b : A' ⟶ B'} (φ₁ : A ⟶ A') (φ₂ : B ⟶ B') [IsIso φ₁] [IsIso φ₂] (w : a ≫ φ₂ = φ₁ ≫ b) :
    Mono a ↔ Mono b := by
  rw [← mono_comp_iff_of_isIso φ₁ b, ← w, mono_comp_iff_of_mono]

/-- `mono_iff_of_comm_sq` after applying a functor `Φ`. -/
private theorem mono_map_iff_of_comm_sq {C D : Type*} [Category C] [Category D] (Φ : C ⥤ D)
    {A B A' B' : C} {a : A ⟶ B} {b : A' ⟶ B'} (φ₁ : A ⟶ A') (φ₂ : B ⟶ B') [IsIso φ₁] [IsIso φ₂]
    (w : a ≫ φ₂ = φ₁ ≫ b) : Mono (Φ.map a) ↔ Mono (Φ.map b) :=
  mono_iff_of_comm_sq (Φ.map φ₁) (Φ.map φ₂) (by rw [← Φ.map_comp, w, Φ.map_comp])

/-- **Leray in the absence of higher direct images, on maps.** Let `p : W ⟶ X` and `φ : G ⟶ G'` a
map of `𝒪_W`-modules with no higher direct images along `p`. If `H¹(W, φ)` is a monomorphism, so
is `H¹(X, p_* φ)`: the comparison `H¹(X, p_* -) ⟶ H¹(W, -)` is natural and invertible at
`p_*`-acyclic modules. -/
private theorem mono_Hfunctor_one_pushforward_map {W X : Scheme.{0}} (p : W ⟶ X)
    {G G' : W.Modules} (φ : G ⟶ G')
    (hG : ∀ i : ℕ, 0 < i → Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj G))
    (hG' : ∀ i : ℕ, 0 < i →
      Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj G'))
    (h : Mono ((Hfunctor W.ringCatSheaf ⊤ 1).map φ)) :
    Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map ((Scheme.Modules.pushforward p).map φ)) := by
  have hac : ∀ F : W.Modules,
      (∀ i : ℕ, 0 < i → Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj F)) →
      (RingedSpaceModuleAdjunction.modulePushforward
        (Stacks.SchemeCohomology.hom p)).rightAcyclic F := by
    intro F hF
    exact (Stacks.DerivedIndexing.rightAcyclic_iff_forall_nat _ _).2 fun n hn => hF n hn
  let τ := Stacks.AffineCohomologyPushforward.schemeDerivedPlusNatTrans p ((1 : ℕ) : ℤ)
  haveI : IsIso (τ.app G) :=
    Stacks.AffineCohomologyPushforward.isIso_derivedPlusPushforwardNatTrans_app _ _ (hac G hG)
  haveI : IsIso (τ.app G') :=
    Stacks.AffineCohomologyPushforward.isIso_derivedPlusPushforwardNatTrans_app _ _ (hac G' hG')
  let eX := Stacks.DerivedIndexing.rightDerivedIso (secF X.ringCatSheaf ⊤) 1
  let eW := Stacks.DerivedIndexing.rightDerivedIso (secF W.ringCatSheaf ⊤) 1
  haveI : IsIso (eW.hom.app G) := inferInstanceAs (IsIso (eW.app G).hom)
  haveI : IsIso (eW.hom.app G') := inferInstanceAs (IsIso (eW.app G').hom)
  haveI : IsIso (eX.hom.app ((Scheme.Modules.pushforward p).obj G)) :=
    inferInstanceAs (IsIso (eX.app _).hom)
  haveI : IsIso (eX.hom.app ((Scheme.Modules.pushforward p).obj G')) :=
    inferInstanceAs (IsIso (eX.app _).hom)
  -- `H¹(W, φ)` in the `ℤ`-indexed spelling, transported along the comparison `τ`, and back to
  -- the `ℕ`-indexed spelling
  have hW : Mono (((secF W.ringCatSheaf ⊤).rightDerivedPlus ((1 : ℕ) : ℤ)).map φ) :=
    (mono_iff_of_comm_sq (eW.hom.app G) (eW.hom.app G') (eW.hom.naturality φ)).1 h
  have hX : Mono (((secF X.ringCatSheaf ⊤).rightDerivedPlus ((1 : ℕ) : ℤ)).map
      ((Scheme.Modules.pushforward p).map φ)) :=
    (mono_iff_of_comm_sq (τ.app G) (τ.app G') (τ.naturality φ)).2 hW
  exact (mono_iff_of_comm_sq (eX.hom.app _) (eX.hom.app _)
    (eX.hom.naturality ((Scheme.Modules.pushforward p).map φ))).2 hX

end StandardDerived

section StandardDerivedTwist

open scoped Stacks.SmallDerivedModel

/-- **Twisting by a pulled-back invertible module keeps higher direct images zero.** By the
projection formula `R^i p_*(G ⊗ p^* N) ≅ R^i p_* G ⊗ N` for `N` invertible. -/
private theorem isZero_rightDerived_pushforward_tensorRight_pullback {W X : Scheme.{0}}
    (p : W ⟶ X) (N : X.Modules) [Stacks.Ample.IsInvertibleModule X N] (G : W.Modules) (i : ℕ)
    (h : Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj G)) :
    Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj
      ((Stacks.Coherent.tensorRightModules W ((Scheme.Modules.pullback p).obj N)).obj G)) := by
  haveI : Stacks.SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N :=
    Stacks.ProjectionFormula.isInvertible_of_isInvertibleModule X N
  have h' : Limits.IsZero (((Scheme.Modules.pushforward p).rightDerivedPlus (i : ℤ)).obj G) :=
    h.of_iso ((Stacks.DerivedIndexing.rightDerivedIso (Scheme.Modules.pushforward p) i).app G).symm
  have hT : Limits.IsZero ((Stacks.ProjectionFormula.tensorRightInvertible X N).obj
      (((Scheme.Modules.pushforward p).rightDerivedPlus (i : ℤ)).obj G)) :=
    (Stacks.ProjectionFormula.tensorRightInvertible X N).map_isZero h'
  exact (hT.of_iso (Stacks.ProjectionFormula.higherDirectImageProjectionFormulaIso p N G i)).of_iso
    ((Stacks.DerivedIndexing.rightDerivedIso (Scheme.Modules.pushforward p) i).app _)

end StandardDerivedTwist

/-! ### Sheaf cohomology and hypercohomology -/

open scoped Stacks.SmallDerivedModel in
/-- **Injectivity in hypercohomology gives a monomorphism in sheaf cohomology.** For `V` over `ℂ`
and `φ : F ⟶ G`, if `H^n(V, φ[0])` on hypercohomology over `ℂ` is injective then
`Hⁿ(V, φ)` is a monomorphism of abelian groups: the two cohomologies are identified naturally
(`Stacks.Duality.cohomologyOverFieldFunctorIsoDerivedCohomology`), and forgetting the module
structure commutes with right derived functors. -/
private theorem mono_Hfunctor_of_injective_derivedCohomology {V : Scheme.{0}}
    (f : V ⟶ Spec (.of ℂ)) {F G : V.Modules} (φ : F ⟶ G) (n : ℕ)
    (h : Function.Injective ((DerivedCategory.homologyFunctor (ModuleCat.{0} ℂ) (n : ℤ)).map
      ((derivedGlobalSectionsOver f).map
        ((DerivedCategory.singleFunctor V.Modules 0).map φ))).hom) :
    Mono ((Hfunctor V.ringCatSheaf ⊤ n).map φ) := by
  let e := Stacks.Duality.cohomologyOverFieldFunctorIsoDerivedCohomology ℂ f n
  -- a monomorphism on hypercohomology
  have hD : Mono ((DerivedCategory.singleFunctor V.Modules 0 ⋙ derivedGlobalSectionsOver f ⋙
      DerivedCategory.homologyFunctor (ModuleCat.{0} ℂ) (n : ℤ)).map φ) :=
    (ModuleCat.mono_iff_injective _).2 h
  haveI : IsIso (e.hom.app F) := inferInstanceAs (IsIso (e.app F).hom)
  haveI : IsIso (e.hom.app G) := inferInstanceAs (IsIso (e.app G).hom)
  -- a monomorphism on the classical cohomology over `ℂ`
  have h1 : Mono ((cohomologyOverFieldFunctor ℂ f n).map φ) :=
    (mono_iff_of_comm_sq (e.hom.app F) (e.hom.app G) (e.hom.naturality φ)).2 hD
  -- injectivity on `Rⁿ Γ(V, -)` valued in `Γ(V, 𝒪_V)`-modules
  have h2 : Function.Injective
      (((SheafOfModules.evaluation V.ringCatSheaf (Opposite.op (⊤ : V.Opens))).rightDerived n).map
        φ).hom := by
    have := (ModuleCat.mono_iff_injective _).1 h1
    exact this
  -- forgetting the module structure
  let ι := CategoryTheory.Functor.rightDerivedCompIso
    (SheafOfModules.evaluation V.ringCatSheaf (Opposite.op (⊤ : V.Opens)))
    (forget₂ (ModuleCat.{0} (V.ringCatSheaf.obj.obj (Opposite.op ⊤))) AddCommGrpCat.{0}) n
  have h3 : Mono ((forget₂ (ModuleCat.{0} (V.ringCatSheaf.obj.obj (Opposite.op ⊤)))
      AddCommGrpCat.{0}).map
        (((SheafOfModules.evaluation V.ringCatSheaf (Opposite.op (⊤ : V.Opens))).rightDerived
          n).map φ)) :=
    (AddCommGrpCat.mono_iff_injective _).2 h2
  haveI : IsIso (ι.hom.app F) := inferInstanceAs (IsIso (ι.app F).hom)
  haveI : IsIso (ι.hom.app G) := inferInstanceAs (IsIso (ι.app G).hom)
  exact (mono_iff_of_comm_sq (ι.hom.app F) (ι.hom.app G) (ι.hom.naturality φ)).2 h3

section FloorVanishingToolkit

open CategoryTheory.Limits TopologicalSpace Opposite

/-! ### Serre's theorem for relatively ample Cartier divisors -/

section SerreTwist

open Stacks.Ample Stacks.RelativeVeryAmple MMP.Flips

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{0}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{0}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{0}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{0, 0, 0} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

/-- The pull-back of `𝒪_Y(nH + F)` along `f : X ⟶ Y` is `f^*𝒪_Y(F) ⊗ (f^*𝒪_Y(H))^{⊗ n}`, for
Cartier divisors `H` and `F`. -/
private theorem nonempty_modulePullback_divisorialSheaf_nsmul_add_iso {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (f : X ⟶ Y) {H F : Divisor Y}
    (hH : H.IsCartier) (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
        (n • H + F).divisorialSheaf ≅
      tensorModules X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          F.divisorialSheaf)
        (tensorPowModule X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          H.divisorialSheaf) (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  set P := RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      P.mapIso (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      pullbackTensorModulesIso f _ _ ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- If `H` is an `g`-ample Cartier divisor and `F` is any Cartier divisor, then `mH + F` is
`g`-ample for `m ≫ 0`, provided the base is quasi-compact. -/
private theorem eventually_isRelativelyAmpleCartier_nsmul_add {Y Z : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [CompactSpace Z] (g : Y ⟶ Z)
    [QuasiCompact g] {H F : Divisor Y} (hH : IsRelativelyAmpleCartier g H) (hF : F.IsCartier) :
    ∀ᶠ m : ℕ in Filter.atTop, IsRelativelyAmpleCartier g (m • H + F) := by
  obtain ⟨hHc, hHa⟩ := hH
  haveI := hHc.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  choose V' hVa hzV _ using fun z : Z =>
    exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun z : Z ↦ ((V' z : Z.Opens) : Set Z))
    (fun z ↦ (V' z).isOpen) (fun z _ ↦ Set.mem_iUnion.2 ⟨z, hzV z⟩)
  have hev : ∀ v ∈ T, ∀ᶠ m : ℕ in Filter.atTop,
      haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
      IsAmple (g ⁻¹ᵁ V' v).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback
          (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom).obj (m • H + F).divisorialSheaf) := by
    intro v _
    let W := (g ⁻¹ᵁ V' v).toScheme
    let P := RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom
    haveI hPF : IsInvertibleModule W (P.obj F.divisorialSheaf) := inferInstance
    haveI hPH : IsInvertibleModule W (P.obj H.divisorialSheaf) := inferInstance
    filter_upwards [eventually_isAmple_tensorModules_tensorPowModule (P.obj H.divisorialSheaf)
      (P.obj F.divisorialSheaf) (hHa _ (hVa v))]
      with m hm
    haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := nonempty_modulePullback_divisorialSheaf_nsmul_add_iso (g ⁻¹ᵁ V' v).ι hHc hF m
    exact (@isAmple_congr _ _ _ inferInstance
      (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
        (isInvertibleModule_tensorPowModule _ _ _)) e).2 hm
  filter_upwards [(Filter.eventually_all_finset T).2 hev] with m hm
  have hc := (hHc.nsmul m).add hF
  haveI := hc.isInvertibleModule_divisorialSheaf
  refine ⟨hc, ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover
    g _ inferInstance).2 fun z => ?_).2⟩
  obtain ⟨v, hvT, hzv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ z))
  exact ⟨V' v, hVa v, hzv, hm v hvT⟩

end SerreTwist

/-! ### Bridges between the notions of relative ampleness -/

section AmpleBridges

open Stacks.Ample

/-- `f`-ampleness of a Cartier divisor gives ampleness over every affine open of the base. -/
private theorem isRelativelyAmpleCartier_of_isRelativelyAmple {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) [QuasiCompact f]
    {L : Divisor X} (hL : L.IsCartier) (h : L.IsRelativelyAmple f hL) :
    MMP.Flips.IsRelativelyAmpleCartier f L := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  exact ⟨hL,
    (Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple f _ inferInstance
      h).2⟩

/-- Ampleness over every affine open of the base gives `f`-ampleness. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) {L : Divisor X}
    (h : MMP.Flips.IsRelativelyAmpleCartier f L) : L.IsRelativelyAmple f h.choose := by
  obtain ⟨hL, hamp⟩ := h
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
  exact ⟨V, hV, hyV, hamp V hV⟩

end AmpleBridges

/-! ### Kawamata–Viehweg vanishing for a boundary with a reduced part -/

section Vanishing

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Relative vanishing for a boundary `S' + Θ₀` with `S'` reduced.** Let `p : W ⟶ X` be a
projective birational morphism from a smooth variety onto a `ℚ`-factorial normal variety, `K_W` a
canonical divisor, `S'` a reduced divisor without `p`-exceptional components and `Θ₀` a
`ℚ`-divisor with coefficients in `[0, 1)` and no component in common with `S'`, such that every
`ℚ`-divisor supported on `S' + Θ₀ + Ex(p)` is snc. If `M - (K_W + S' + Θ₀)` is the pull-back of a
`ℚ`-Cartier divisor `C/m` of `X`, then `R^i p_* 𝒪_W(M) = 0` for `i > 0`. -/
private theorem isZero_rightDerived_of_reducedBoundary (hQ : IsQFactorial sX)
    {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]
    (p : W ⟶ X) [IsDominant p] (hW : IsNormalVariety k (p ≫ sX))
    (hsm : IsSmoothScheme (p ≫ sX)) (hproj : IsProjectiveMorphism p)
    (hb : IsBirationalMorphism p) {n : ℕ} {KW : Divisor W}
    (hKW : KW.IsCanonicalDivisor (p ≫ sX) n) (M S' : Divisor W) (Θ₀ : QDivisor W)
    (hS'01 : ∀ P, S'.coeff P = 0 ∨ S'.coeff P = 1)
    (hS'ex : ∀ P, S'.coeff P ≠ 0 → ¬ RationalMap.IsExceptional (X := W) p.toRationalMap P)
    (hΘ0 : ∀ P, 0 ≤ Θ₀.coeff P) (hΘ1 : ∀ P, Θ₀.coeff P < 1)
    (hS'Θ : ∀ P, S'.coeff P ≠ 0 → Θ₀.coeff P = 0)
    (hsnc : ∀ G : QDivisor W, (∀ P, G.coeff P ≠ 0 → S'.coeff P ≠ 0 ∨ Θ₀.coeff P ≠ 0 ∨
      RationalMap.IsExceptional (X := W) p.toRationalMap P) →
        DivisorWithCoeffs.IsSNC (p ≫ sX) G)
    (m : ℕ) (hm : 0 < m) (C : Divisor X) (hC : C.IsCartier)
    (hCs : ∀ Z : irreducibleComponents W, p (componentGenericPoint W Z) ∉ C.supp)
    (Cμ : Divisor W) (hCμ : C.IsPullback p hCs Cμ)
    (hCeq : Divisor.toQDivisor Cμ = (m : ℤ) • (Divisor.toQDivisor M -
      (Divisor.toQDivisor KW + Divisor.toQDivisor S' + Θ₀)))
    (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj M.divisorialSheaf) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hQ.1.1
  haveI : MMP.Mori.IsVariety k (p ≫ sX) := hW.1
  have hp : IsProper p := isProper_of_isProjectiveMorphism p hproj
  haveI : UniversallyClosed p := hp.toUniversallyClosed
  haveI : QuasiCompact p := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hcart : ∀ G : Divisor W, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm
  obtain ⟨Fexc, e, he, hFexc0, hFexcEx, Dexc, hDexc, hDexceq, hDexcamp⟩ :=
    MMP.Mori.exists_isRelativelyAmple_neg_smul_of_isExceptional sX (p ≫ sX) hQ hW p rfl hproj hb
  obtain ⟨r, hr, hr0⟩ := ((eventually_isRelativelyAmpleCartier_nsmul_add p
    (isRelativelyAmpleCartier_of_isRelativelyAmple p hDexc.neg hDexcamp) (hcart S')).and
      (Filter.eventually_gt_atTop 0)).exists
  have hAc : (r • (-Dexc) + S').IsCartier := hr.choose
  have hAamp : (r • (-Dexc) + S').IsRelativelyAmple p hAc :=
    isRelativelyAmple_of_isRelativelyAmpleCartier p hr
  -- the numbers
  set t : ℚ := ∑ P ∈ Fexc.support, Fexc.coeff P / (1 - Θ₀.coeff P) with ht
  have ht0 : ∀ P ∈ Fexc.support, Fexc.coeff P / (1 - Θ₀.coeff P) ≤ t := fun P hP =>
    Finset.single_le_sum (f := fun P => Fexc.coeff P / (1 - Θ₀.coeff P))
      (fun Q _ => div_nonneg (hFexc0 Q) (by linarith [hΘ1 Q])) hP
  set N : ℕ := ⌈(r * e : ℚ) * t⌉₊ + 1 with hN
  set c : ℕ := m * N with hc
  have hc0 : 0 < c := Nat.mul_pos hm (by omega)
  have hcq : (0 : ℚ) < c := by exact_mod_cast hc0
  have hct : (r * e : ℚ) * t < c := by
    have h1 := Nat.le_ceil ((r * e : ℚ) * t)
    have h2 : (N : ℚ) ≤ c := by
      rw [hc]; push_cast
      have : (1 : ℚ) ≤ m := by exact_mod_cast hm
      nlinarith [Nat.cast_nonneg (α := ℚ) N]
    have h3 : ((⌈(r * e : ℚ) * t⌉₊ : ℕ) : ℚ) + 1 = N := by rw [hN]; push_cast; ring
    linarith
  set ε : ℚ := 1 / c with hε
  set δ : ℚ := (r * e : ℚ) / c with hδ
  have hε0 : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [hε, div_le_one hcq]; exact_mod_cast hc0
  have hδ0 : 0 ≤ δ := by positivity
  set Θ : QDivisor W := Θ₀ + (1 - ε) • Divisor.toQDivisor S' + δ • Fexc with hΘdef
  have hΘc : ∀ P, Θ.coeff P = Θ₀.coeff P + (1 - ε) * S'.coeff P + δ * Fexc.coeff P :=
    fun P => by simp [hΘdef, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul]
  have hFS : ∀ P, S'.coeff P ≠ 0 → Fexc.coeff P = 0 := fun P hP => by
    by_contra h
    exact hS'ex P hP (hFexcEx P h)
  -- the boundary
  have hB0 : Θ.IsEffective := fun P => by
    rw [hΘc]
    have h1 : (0 : ℚ) ≤ (1 - ε) * S'.coeff P := by
      rcases hS'01 P with h | h <;> rw [h] <;> push_cast <;> nlinarith
    have h3 : 0 ≤ δ * Fexc.coeff P := mul_nonneg hδ0 (hFexc0 P)
    linarith [hΘ0 P]
  have hB1 : ∀ P, Θ.coeff P < 1 := fun P => by
    rw [hΘc]
    rcases hS'01 P with hP | hP
    · rw [hP]
      by_cases hF : Fexc.coeff P = 0
      · rw [hF]; simp only [Int.cast_zero, mul_zero, add_zero]; exact hΘ1 P
      · have hmem : P ∈ Fexc.support := Finsupp.mem_support_iff.2 hF
        have h1 := ht0 P hmem
        have hpos : 0 < 1 - Θ₀.coeff P := by linarith [hΘ1 P]
        have h2 : Fexc.coeff P ≤ t * (1 - Θ₀.coeff P) := by rwa [div_le_iff₀ hpos] at h1
        have h3 : δ * Fexc.coeff P ≤ δ * t * (1 - Θ₀.coeff P) := by
          rw [mul_assoc]; exact mul_le_mul_of_nonneg_left h2 hδ0
        have h4 : δ * t < 1 := by
          rw [hδ, div_mul_eq_mul_div, div_lt_one hcq]; exact hct
        have h5 : δ * t * (1 - Θ₀.coeff P) < 1 - Θ₀.coeff P := by nlinarith
        simp only [Int.cast_zero, mul_zero, add_zero]
        linarith
    · have hne : S'.coeff P ≠ 0 := by rw [hP]; exact one_ne_zero
      rw [hP, hS'Θ P hne, hFS P hne]
      simp only [Int.cast_one, mul_one, mul_zero, add_zero, zero_add]
      linarith
  have hBsnc : DivisorWithCoeffs.IsSNC (p ≫ sX) Θ := hsnc Θ fun P hP => by
    by_contra hcon
    push Not at hcon
    obtain ⟨hS, hΘ, hEx⟩ := hcon
    apply hP
    have : Fexc.coeff P = 0 := by
      by_contra h
      exact hEx (hFexcEx P h)
    rw [hΘc, hS, hΘ, this]; simp
  -- the gap
  have hCn := hCμ.zsmul hC (N : ℤ)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp p _)
  have hLc : (r • (-Dexc) + S' + (N : ℤ) • Cμ).IsCartier := hcart _
  have hLamp : (r • (-Dexc) + S' + (N : ℤ) • Cμ).IsRelativelyAmple p hLc :=
    MMP.Threefold.Resolution.isRelativelyAmple_add_of_isPullback p hAc hAamp (hC.zsmul _) hCn
      (hcart _)
  have heq : Divisor.toQDivisor (r • (-Dexc) + S' + (N : ℤ) • Cμ) =
      ((c : ℕ) : ℤ) • (Divisor.toQDivisor M - (Divisor.toQDivisor KW + Θ)) := by
    ext P
    have hC' : (Cμ.coeff P : ℚ) = m * (M.coeff P - (KW.coeff P + S'.coeff P + Θ₀.coeff P)) := by
      have := congrArg (fun G : QDivisor W => G.coeff P) hCeq
      simpa [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub,
        DivisorWithCoeffs.coeff_add] using this
    have hD' : (Dexc.coeff P : ℚ) = e * Fexc.coeff P := by
      have := congrArg (fun G : QDivisor W => G.coeff P) hDexceq
      simpa [DivisorWithCoeffs.coeff_smul] using this
    have hΘP := hΘc P
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
      DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_neg, nsmul_eq_mul, zsmul_eq_mul,
      Int.cast_add, Int.cast_sub, Int.cast_mul, Int.cast_neg, Int.cast_natCast, smul_eq_mul]
      at hC' hD' hΘP ⊢
    have hNq : (N : ℚ) ≠ 0 := by positivity
    have hmq : (m : ℚ) ≠ 0 := by positivity
    rw [hΘP, hC', hD', hε, hδ, hc]
    push_cast
    field_simp
    ring
  exact MMP.Mori.isZero_rightDerived_pushforward_divisorialSheaf_of_hasRelativelyAmpleMultiple
    (p ≫ sX) sX hsm p rfl hproj hKW hB0 hBsnc hB1 (hcart M) ⟨c, hc0, _, hLc, heq, hLamp⟩ i hi

/-- **A compatible canonical divisor on a smooth model.** For a birational morphism `p : W ⟶ X`
from a smooth variety and a canonical divisor `K = div(ω)` of `X`, `div(p^*ω)` is a canonical
divisor of `W`. -/
private theorem exists_divisorOfForm_pullback_isCanonicalDivisor {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] (hX : IsNormalVariety k sX)
    {p : W ⟶ X} [IsDominant p] (hW : IsNormalVariety k (p ≫ sX)) (hsm : IsSmoothScheme (p ≫ sX))
    (hb : IsBirationalMorphism p) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) :
    haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (p ≫ sX) := hW.1.toLocallyOfFiniteType
    ∃ ω : RationalPluriForms sX n 1, ω ≠ 0 ∧ divisorOfForm ω = K ∧
      (divisorOfForm (pullbackRationalPluriForms sX p ω)).IsCanonicalDivisor (p ≫ sX) n := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (p ≫ sX) := hW.1.toLocallyOfFiniteType
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (p ≫ sX) := hW.1
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX)
    hK.topologicalKrullDim_eq
  have hτ0 := MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' p
    hb.functionFieldMap_bijective hd hω0
  have hdim : topologicalKrullDim W = n := by
    rw [← hK.topologicalKrullDim_eq]
    exact (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (p ≫ sX) hb).symm
  obtain ⟨K₀, hK₀⟩ := @exists_isCanonicalDivisor_of_isSmoothScheme _ _ _ _ _ k _ _ hW.1 hsm n hdim
  refine ⟨ω, hω0, Finsupp.ext hω, hK₀.of_linearlyEquivalent ?_⟩
  simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hW hK₀ hτ0

end Vanishing

section FloorModelToolkit

open MMP.Intersection

section Geometry

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- The generic point of a prime divisor has codimension one, so not at least two. -/
private theorem not_two_le_coheight_genericPoint (Q : MMP.Mori.PrimeDivisor X) :
    ¬ 2 ≤ Order.coheight Q.genericPoint := by
  rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint]
  decide

/-- No valuation of `K(X)` that is `≤ 1` on the stalk at the generic point takes the value
`exp (-1)`. -/
private theorem false_of_forall_valuation_le_one (x : X) (hx : x = genericPoint X)
    (v : Valuation X.functionField (WithZero (Multiplicative ℤ)))
    (h1 : ∀ a : X.presheaf.stalk x, v (algebraMap _ X.functionField a) ≤ 1)
    {g : X.functionField} (hg : v g = WithZero.exp (-1)) : False := by
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := X.presheaf.stalk x) g⁻¹
  have hu : IsUnit b := by
    subst hx
    exact isUnit_iff_ne_zero.2 (nonZeroDivisors.ne_zero hb)
  obtain ⟨c, rfl⟩ := hu
  have hb1 : v (algebraMap _ X.functionField (c : X.presheaf.stalk x)) = 1 := by
    refine le_antisymm (h1 _) ?_
    by_contra hlt
    push Not at hlt
    have hm : v (algebraMap _ X.functionField (c : X.presheaf.stalk x)) *
        v (algebraMap _ X.functionField (↑c⁻¹ : X.presheaf.stalk x)) = 1 := by
      rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
    have h2 := mul_le_of_le_one_right' (a := v (algebraMap _ X.functionField
      (c : X.presheaf.stalk x))) (h1 (↑c⁻¹ : X.presheaf.stalk x))
    rw [hm] at h2
    exact absurd (h2.trans_lt hlt) (lt_irrefl _)
  have hle : v g⁻¹ ≤ 1 := by
    rw [← hab, map_div₀, hb1, div_one]
    exact h1 a
  rw [map_inv₀, hg] at hle
  exact absurd hle (by decide)

/-- A dominant morphism of integral schemes inducing a surjection of function fields does not map
the generic point of a prime divisor to the generic point. -/
private theorem map_genericPoint_ne_genericPoint (f : Y ⟶ X) [IsDominant f]
    (hf : Function.Surjective (functionFieldMap f)) (E : MMP.Mori.PrimeDivisor Y) :
    f E.genericPoint ≠ genericPoint X := by
  intro h
  have h1 : ∀ a : X.presheaf.stalk (f E.genericPoint),
      E.valuationOver f (algebraMap _ X.functionField a) ≤ 1 := by
    intro a
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, functionFieldMap_algebraMap_stalk,
      MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
    exact ⟨_, rfl⟩
  have := E.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  obtain ⟨g, hg⟩ := hf (algebraMap E.localRing Y.functionField ϖ)
  have hgv : E.valuationOver f g = WithZero.exp (-1) := by
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, hg,
      MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_of_irreducible _ hϖ]
  exact false_of_forall_valuation_le_one _ h _ h1 hgv

/-- Under a dominant morphism inducing a surjection of function fields, the generic point of a
prime divisor maps either to the generic point of a prime divisor or to a point of codimension
at least two. -/
private theorem exists_map_genericPoint_eq_or_two_le_coheight (f : Y ⟶ X) [IsDominant f]
    (hf : Function.Surjective (functionFieldMap f)) (E : MMP.Mori.PrimeDivisor Y) :
    (∃ Q : MMP.Mori.PrimeDivisor X, f E.genericPoint = Q.genericPoint) ∨
      2 ≤ Order.coheight (f E.genericPoint) := by
  by_cases h2 : 2 ≤ Order.coheight (f E.genericPoint)
  · exact Or.inr h2
  left
  have hne := map_genericPoint_ne_genericPoint f hf E
  have h0 : Order.coheight (f E.genericPoint) ≠ 0 := by
    intro h0
    have hmax : IsMax (f E.genericPoint) := Order.coheight_eq_zero.mp h0
    exact hne (Specializes.antisymm (hmax (genericPoint_specializes _))
      (genericPoint_specializes _)).eq
  have h1 : Order.coheight (f E.genericPoint) = 1 := by
    rw [not_le] at h2
    generalize Order.coheight (f E.genericPoint) = c at h0 h2 ⊢
    induction c using ENat.recTopCoe with
    | top => exact absurd h2 (by simp)
    | coe c =>
      norm_cast at h0 h2 ⊢
      omega
  exact ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1,
    (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1).symm⟩

/-- The coefficient of the strict transform `p⁻¹_* D` along a prime divisor `P` of `Y` lying over
the prime divisor `Q` of `X` is the coefficient of `D` along `Q`. -/
private theorem coeff_inverseTransformDivisor_of_map_genericPoint {R : Type*} [AddCommMonoid R]
    (p : Y ⟶ X) [IsProper p] (hb : IsBirationalMorphism p) (D : DivisorWithCoeffs R X)
    {P : MMP.Mori.PrimeDivisor Y} {Q : MMP.Mori.PrimeDivisor X}
    (h : p P.genericPoint = Q.genericPoint) :
    (inverseTransformDivisor p D).coeff P = D.coeff Q := by
  have hQ : inverseTransformPrimeDivisor p Q = some P :=
    (MMP.ProgramBaseChange.inverseTransformPrimeDivisor_eq_some_iff' p Q P).2
      ⟨MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus p hb Q, h⟩
  exact MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hQ (fun Q' hQ' =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (((MMP.ProgramBaseChange.inverseTransformPrimeDivisor_eq_some_iff' p Q' P).1
        hQ').2.symm.trans h)) D

/-- The strict transform `p⁻¹_* D` has no component over a point of codimension at least two. -/
private theorem coeff_inverseTransformDivisor_of_two_le_coheight {R : Type*} [AddCommMonoid R]
    (p : Y ⟶ X) (D : DivisorWithCoeffs R X) {P : MMP.Mori.PrimeDivisor Y}
    (h : 2 ≤ Order.coheight (p P.genericPoint)) :
    (inverseTransformDivisor p D).coeff P = 0 :=
  MMP.Flips.mapPrimeDivisors_apply_eq_zero_of_forall_ne (fun Q hQ => by
    rw [((MMP.ProgramBaseChange.inverseTransformPrimeDivisor_eq_some_iff' p Q P).1 hQ).2] at h
    exact not_two_le_coheight_genericPoint Q h) D

/-- Over an open `V` above which `p` is an isomorphism, `p` preserves codimensions of points. -/
private theorem coheight_map_eq_of_isIso_restrict (p : Y ⟶ X) (V : X.Opens) [IsIso (p ∣_ V)]
    (y : Y) (hy : p y ∈ V) : Order.coheight (p y) = Order.coheight y := by
  have hst : IsIso (p.stalkMap y) :=
    ((MorphismProperty.isomorphisms _).arrow_mk_iso_iff (morphismRestrictStalkMap p V ⟨y, hy⟩)).mp
      (((isIso_iff_isIso_stalkMap (p ∣_ V)).mp inferInstance).2 ⟨y, hy⟩)
  have h1 : ringKrullDim (Y.presheaf.stalk y) = ringKrullDim (X.presheaf.stalk (p y)) :=
    (ringKrullDim_eq_of_ringEquiv (asIso (p.stalkMap y)).commRingCatIsoToRingEquiv).symm
  rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight] at h1
  exact_mod_cast h1.symm

/-- A prime divisor whose generic point lies on a prime divisor `E` is `E`. -/
private theorem eq_of_genericPoint_mem_support {P E : MMP.Mori.PrimeDivisor Y}
    (h : P.genericPoint ∈ E.support) : P = E := by
  have hsp : E.genericPoint ⤳ P.genericPoint := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
    exact specializes_iff_mem_closure.mpr h
  by_contra hne
  have hne' : P.genericPoint ≠ E.genericPoint := fun h' =>
    hne (AlgebraicGeometry.PrimeDivisor.genericPoint_injective h')
  have hle : P.genericPoint ≤ E.genericPoint := hsp
  have hlt : P.genericPoint < E.genericPoint :=
    lt_of_le_not_ge hle fun h => hne' (Specializes.antisymm h hsp).eq
  have := Order.coheight_add_one_le hlt
  rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint,
    AlgebraicGeometry.PrimeDivisor.coheight_genericPoint] at this
  exact absurd this (by decide)

end Geometry

section Model

variable {k : Type} [Field k] {X W : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]

/-- A prime divisor `P` of a model `p : W ⟶ X` is `p`-exceptional exactly when its image
`p(η_P)` has codimension at least two. -/
private theorem isExceptional_iff_two_le_coheight (hX : IsNormalVariety k sX) {p : W ⟶ X}
    (hW : IsNormalVariety k (p ≫ sX)) (hb : IsBirationalMorphism p)
    (P : MMP.Mori.PrimeDivisor W) :
    RationalMap.IsExceptional (X := W) p.toRationalMap P ↔
      2 ≤ Order.coheight (p P.genericPoint) :=
  MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight hX ⟨W, p, hW, hb, P⟩

/-- The crepant boundary along a prime divisor `P` of `W` lying over a prime divisor `Q` of `X` has
the coefficient of the boundary along `Q`. -/
private theorem coeff_crepantBoundary_of_map_genericPoint {n : ℕ} {K : Divisor X}
    {B : QDivisor X} (hP : MMP.Mori.IsPair sX B) {p : W ⟶ X} [IsProper p]
    {hW : IsNormalVariety k (p ≫ sX)} {hb : IsBirationalMorphism p} {ΔW : QDivisor W}
    (hΔ : IsCrepantBoundary sX n K B p hW hb ΔW) {P : MMP.Mori.PrimeDivisor W}
    {Q : MMP.Mori.PrimeDivisor X} (h : p P.genericPoint = Q.genericPoint) :
    ΔW.coeff P = B.coeff Q := by
  classical
  have hnex : ¬ RationalMap.IsExceptional (X := W) p.toRationalMap P := by
    rw [isExceptional_iff_two_le_coheight hP.1 hW hb, h,
      AlgebraicGeometry.PrimeDivisor.coheight_genericPoint]
    decide
  have heq := (hΔ.eq_inverseTransformDivisor_add_exceptional hP).1
  have h1 := congrArg (fun G : QDivisor W => G P) heq
  simp only [Finsupp.add_apply, Finsupp.filter_apply, if_neg hnex, add_zero] at h1
  rw [DivisorWithCoeffs.coeff_apply, h1, ← DivisorWithCoeffs.coeff_apply,
    coeff_inverseTransformDivisor_of_map_genericPoint p hb B h]

/-- **Divisors on a log resolution are snc.** On a log resolution `p : W ⟶ X` of `(X, B)`, a
`ℚ`-divisor each of whose components lies over a point of codimension at least two or over a
component of `B` is snc: its support lies in the snc divisor `Ex(p) ∪ p⁻¹(Supp B)`. -/
private theorem isSNC_of_forall_two_le_coheight_or_coeff_ne_zero {B : QDivisor X} {p : W ⟶ X}
    [LocallyOfFiniteType (p ≫ sX)]
    (hres : MMP.Mori.IsLogResolution sX (QDivisor.toRDivisor B) p) (G : QDivisor W)
    (hG : ∀ P, G.coeff P ≠ 0 → 2 ≤ Order.coheight (p P.genericPoint) ∨
      ∃ Q : MMP.Mori.PrimeDivisor X, p P.genericPoint = Q.genericPoint ∧ B.coeff Q ≠ 0) :
    DivisorWithCoeffs.IsSNC (p ≫ sX) G := by
  classical
  have hmem : ∀ P, G.coeff P ≠ 0 → P.genericPoint ∈
      ((exceptionalSet p ⊔ (QDivisor.toRDivisor B).supp.preimage p.continuous :
        TopologicalSpace.Closeds W) : Set W) := by
    intro P hGP
    rw [TopologicalSpace.Closeds.coe_sup]
    rcases hG P hGP with h2 | ⟨Q, h, hBQ⟩
    · left
      intro hP
      haveI : IsIso (p ∣_ biregularLocus p) := isBiregular_biregularLocus p
      rw [coheight_map_eq_of_isIso_restrict p (biregularLocus p) _
        (show p P.genericPoint ∈ _ from hP)] at h2
      exact not_two_le_coheight_genericPoint P h2
    · right
      change p P.genericPoint ∈ (QDivisor.toRDivisor B).supp
      rw [h]
      refine DivisorWithCoeffs.mem_supp_iff.2 ⟨Q, by simpa using hBQ, ?_⟩
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
  rcases hres.isSNCSubset with hbot | ⟨s, hs, hsncs⟩
  · have hG0 : G = 0 := by
      ext P
      by_contra hP
      have := hmem P hP
      rw [hbot] at this
      exact this
    rw [hG0]
    exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme _ hres.isSmoothScheme
  · refine hsncs.of_support_subset fun P hP => ?_
    have hP' := hmem P (Finsupp.mem_support_iff.1 hP)
    rw [← hs] at hP'
    obtain ⟨F, hFs, hF⟩ := Set.mem_iUnion₂.1 hP'
    rw [eq_of_genericPoint_mem_support hF, Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
    simp [Finsupp.single_apply, hFs]

end Model

end FloorModelToolkit

end FloorVanishingToolkit

/-! ### The kernel of the restriction to a reduced subscheme -/

section KernelOfRestriction

open Limits TopologicalSpace Opposite

/-- A regular function on an affine open `U` lies in the ideal of the reduced closed subscheme
`W` exactly when it vanishes at every point of `W ∩ U`. -/
private theorem mem_vanishingIdeal_ideal_iff' {X : Scheme.{0}} (W : Closeds X)
    (U : X.affineOpens) (a : Γ(X, U)) :
    a ∈ (Scheme.IdealSheafData.vanishingIdeal W).ideal U ↔
      ∀ x ∈ (W : Set X), x ∈ (U : X.Opens) → x ∉ X.basicOpen a := by
  have hmem : ∀ p, U.2.fromSpec p ∈ X.basicOpen a ↔ a ∉ p.asIdeal := fun p => by
    change p ∈ U.2.fromSpec ⁻¹ᵁ X.basicOpen a ↔ _
    rw [U.2.fromSpec_preimage_basicOpen]
    rfl
  rw [Scheme.IdealSheafData.vanishingIdeal_ideal, PrimeSpectrum.mem_vanishingIdeal]
  constructor
  · intro h x hxW hxU hxa
    obtain ⟨p, rfl⟩ : x ∈ Set.range U.2.fromSpec := by rw [U.2.range_fromSpec]; exact hxU
    exact (hmem p).1 hxa (h p hxW)
  · intro h p hp
    by_contra hpa
    have hU : U.2.fromSpec p ∈ (U : X.Opens) := by
      have := Set.mem_range_self (f := U.2.fromSpec) p
      rwa [U.2.range_fromSpec] at this
    exact h _ hp hU ((hmem p).2 hpa)

/-- An element of the maximal ideal of the discrete valuation ring `𝒪_{X,E}` vanishes to order at
least one along `E`. -/
private theorem ordGE_one_toComponent_of_mem_maximalIdeal {X : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] (E : MMP.Mori.PrimeDivisor X) {a : E.localRing}
    (ha : a ∈ IsLocalRing.maximalIdeal E.localRing) : E.OrdGE 1 (E.toComponent.hom a) := by
  by_cases h0 : a = 0
  · left; rw [h0, map_zero]
  right
  let := E.toComponent.hom.toAlgebra
  have := isFractionRing_stalkToRationalFunctions E.genericPoint_mem_component
  have : Ring.KrullDimLE 1 E.localRing := krullDimLE_of_coheight_le E.coheight_genericPoint.le
  have := E.isDiscreteValuationRing_localRing
  change WithZero.exp 1 ≤ Ring.ordFrac E.localRing (IsLocalization.algEquiv
    (nonZeroDivisors E.localRing) _ (FractionRing E.localRing) (algebraMap E.localRing _ a))
  rw [AlgEquiv.commutes]
  set v := Ring.ordFrac E.localRing (algebraMap E.localRing (FractionRing E.localRing) a)
  have h1 : 1 ≤ v := Ring.ordFrac_ge_one_of_ne_zero h0
  have h2 : v ≠ 1 := fun h =>
    (IsLocalRing.mem_maximalIdeal _).mp ha
      (Ring.isUnit_iff_ordFrac_one_of_isDiscreteValuationRing.2 h)
  have hv0 : v ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one h1)
  rw [← WithZero.exp_log hv0] at h1 h2 ⊢
  rw [← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  rw [← WithZero.exp_zero, Ne, WithZero.exp_inj] at h2
  rw [WithZero.exp_le_exp]
  omega

/-- The germ of a regular function along a prime divisor, read in the function field of its
component, is the image of its germ in the local ring of the divisor. -/
private theorem germ_component_eq_toComponent {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] (P : MMP.Mori.PrimeDivisor V) {U' : V.Opens} (b : Γ(V, U'))
    (hP : P.genericPoint ∈ U') (hc : componentGenericPoint V P.component ∈ U') :
    V.presheaf.germ U' _ hc b = P.toComponent.hom (V.presheaf.germ U' _ hP b) :=
  (TopCat.Presheaf.germ_stalkSpecializes_apply V.presheaf hP _ b).symm

/-- A regular function vanishing at the generic point of a prime divisor `P` vanishes to order at
least one along `P`. -/
private theorem ordGE_one_germ_of_notMem_basicOpen {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] (P : MMP.Mori.PrimeDivisor V) {U' : V.Opens} (b : Γ(V, U'))
    (hP : P.genericPoint ∈ U') (hb : P.genericPoint ∉ V.basicOpen b)
    (hc : componentGenericPoint V P.component ∈ U') :
    P.OrdGE 1 (V.presheaf.germ U' _ hc b) := by
  rw [germ_component_eq_toComponent P b hP hc]
  refine ordGE_one_toComponent_of_mem_maximalIdeal P ?_
  rw [IsLocalRing.mem_maximalIdeal]
  exact fun hu => hb ((Scheme.mem_basicOpen V b _ hP).2 hu)

/-- A regular function has nonnegative order along every prime divisor. -/
private theorem ordGE_zero_germ' {V : Scheme.{0}} [IsLocallyNoetherian V] [IsNormal V]
    (P : MMP.Mori.PrimeDivisor V) {U' : V.Opens} (b : Γ(V, U')) (hP : P.genericPoint ∈ U')
    (hc : componentGenericPoint V P.component ∈ U') :
    P.OrdGE 0 (V.presheaf.germ U' _ hc b) := by
  rw [germ_component_eq_toComponent P b hP hc]
  by_cases h0 : V.presheaf.germ U' _ hP b = 0
  · left; rw [h0, map_zero]
  · right; rw [WithZero.exp_zero]; exact P.one_le_valuation_toComponent h0

/-- A regular function invertible at the generic point of a prime divisor has order zero along
it. -/
private theorem valuation_germ_of_mem_basicOpen {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] (P : MMP.Mori.PrimeDivisor V) {U' : V.Opens} (b : Γ(V, U'))
    (hP : P.genericPoint ∈ U') (hb : P.genericPoint ∈ V.basicOpen b)
    (hc : componentGenericPoint V P.component ∈ U') :
    P.valuation (V.presheaf.germ U' _ hc b) = 1 := by
  rw [germ_component_eq_toComponent P b hP hc]
  exact P.valuation_toComponent_of_isUnit ((Scheme.mem_basicOpen V b _ hP).1 hb)

/-- An identity in the function field of `V` between a component value and the pull-back of a
component value on `X` is the corresponding identity for the extension `fieldMap` of the local
rings at the generic points. -/
private theorem fieldMap_eq_of_stalkSpecializes {X V : Scheme.{0}} [IsIntegral X] [IsIntegral V]
    (g : V ⟶ X) [IsDominant g] (ZX : irreducibleComponents X) (ZY : irreducibleComponents V)
    (x : X.presheaf.stalk (componentGenericPoint X ZX))
    (y : V.presheaf.stalk (componentGenericPoint V ZY))
    (h : (V.presheaf.stalkSpecializes (genericPoint_specializes _)).hom y =
      functionFieldMap g ((X.presheaf.stalkSpecializes (genericPoint_specializes _)).hom x)) :
    MMP.Fourfold.fieldMap g ZX ZY x = y := by
  rw [MMP.Fourfold.fieldMap_eq, RingHom.comp_apply, RingHom.comp_apply]
  change (V.presheaf.stalkSpecializes
      (specializes_of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint ZY))).hom
    (functionFieldMap g ((X.presheaf.stalkSpecializes (genericPoint_specializes _)).hom x)) = y
  rw [← h, ← ConcreteCategory.comp_apply, TopCat.Presheaf.stalkSpecializes_comp,
    TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- Transport of the inclusion of a submodule along an equality of submodules. -/
private theorem eqToHom_comp_subι {X : Scheme.{0}} {F : X.Modules} {N N' : F.Submodule}
    (h : N = N') :
    eqToHom (congrArg (fun K : F.Submodule => (K.toSheafOfModules : X.Modules)) h) ≫
      subι N' = subι N := by
  subst h
  exact Category.id_comp _

/-- **The direct image of an adjoint sheaf is an ideal times `𝒪_X(M)`.** Let `g : V ⟶ X` be a
proper birational morphism of normal complex varieties, `M` a Cartier divisor on `X` with
pull-back `M_V`, `A ≥ 0` a Cartier divisor on `V` all of whose components are `g`-exceptional,
and `T` a reduced divisor on `V`, off the support of `A`, whose components map into the closed
set `W` and whose images cover `W`. Then `g_* 𝒪_V(M_V + A - T) ⊆ g_* 𝒪_V(M_V + A) = 𝒪_X(M)` is
the kernel of the restriction `𝒪_X(M) ⟶ ι_* ι^* 𝒪_X(M)` to the reduced subscheme `W`. -/
private theorem exists_pushforward_iso_kernel_comp
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (sX : X ⟶ Spec (.of ℂ)) (hX : MMP.Mori.IsVariety ℂ sX) (W : Closeds X)
    {M : Divisor X} (hM : M.IsCartier)
    {V : Scheme.{0}} [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V] (g : V ⟶ X)
    [IsDominant g] (hV : MMP.Mori.IsVariety ℂ (g ≫ sX)) [IsProper g]
    (hg : IsBirationalMorphism g) (MV : Divisor V)
    (hMV : M.IsPullback g (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant g M)
      MV)
    (A : Divisor V) (hAc : A.IsCartier) (hA : 0 ≤ A)
    (hAexc : ∀ P, A P ≠ 0 → RationalMap.IsExceptional g.toRationalMap P)
    (TD : Divisor V) (hT01 : ∀ P, TD P = 0 ∨ TD P = 1) (hAT : ∀ P, TD P = 1 → A P = 0)
    (hTW : ∀ P, TD P = 1 → g.base '' P.support ⊆ W)
    (hWT : (W : Set X) ⊆ ⋃ (P) (_ : TD P = 1), g.base '' P.support)
    (hFle : MV + A - TD ≤ MV + A) :
    ∃ (e : M.divisorialSheaf ≅ (Scheme.Modules.pushforward g).obj (MV + A).divisorialSheaf)
      (L : (Scheme.Modules.pushforward g).obj (MV + A - TD).divisorialSheaf ≅
        kernel ((Scheme.Modules.pullbackPushforwardAdjunction
          (Scheme.IdealSheafData.vanishingIdeal W).subschemeι).unit.app M.divisorialSheaf)),
      L.hom ≫ kernel.ι ((Scheme.Modules.pullbackPushforwardAdjunction
          (Scheme.IdealSheafData.vanishingIdeal W).subschemeι).unit.app M.divisorialSheaf) =
        (Scheme.Modules.pushforward g).map (Divisor.divisorialSheafInclusion hFle) ≫ e.inv := by
  classical
  set η := (Scheme.Modules.pullbackPushforwardAdjunction
    (Scheme.IdealSheafData.vanishingIdeal W).subschemeι).unit.app M.divisorialSheaf with hη
  obtain ⟨e, he⟩ := Divisor.exists_iso_pushforward_divisorialSheaf_add_of_isExceptional sX g hX hV
    hg M hM _ MV hMV A hAc hA (fun P hP => hAexc P hP)
  set φ := (Scheme.Modules.pushforward g).map (Divisor.divisorialSheafInclusion hFle) ≫ e.inv
    with hφ
  haveI : Mono φ := by
    haveI : Mono ((Scheme.Modules.pushforward g).map (Divisor.divisorialSheafInclusion hFle)) :=
      inferInstance
    exact mono_comp _ _
  haveI : M.divisorialSheaf.IsQuasicoherent := Divisor.isQuasicoherent_divisorialSheaf M
  have hKη : Stacks.Algebraization.kernelSubmodule η =
      Stacks.Algebraization.idealPowerMultiple (Scheme.IdealSheafData.vanishingIdeal W) 1
        M.divisorialSheaf := by
    rw [hη, Stacks.Algebraization.kernelSubmodule_unit_app_eq_idealMultiple,
      Scheme.IdealSheafData.ker_subschemeι]
  have hKaff := (Stacks.Algebraization.idealPowerMultiple_le_iff
    (Scheme.IdealSheafData.vanishingIdeal W) 1 M.divisorialSheaf _).1 le_rfl
  -- the sections of `g_* 𝒪_V(M_V + A - T)` land in `ℐ_W · 𝒪_X(M)` over small affine opens
  have key : ∀ (V' : X.affineOpens) (V₀ : X.Opens) (_ : (V'.1 : X.Opens) ≤ V₀)
      (ψ : (RationalFunctions X)ˣ) (_ : M.IsLocalEquation V₀ ψ)
      (t : Γ((Scheme.Modules.pushforward g).obj (MV + A - TD).divisorialSheaf, V'.1)),
      (φ.app V'.1).hom t ∈ (Stacks.Algebraization.kernelSubmodule η).obj (op V'.1) := by
    intro V' V₀ hV'₀ ψ hψ t
    rw [hKη]
    refine hKaff V' ?_
    rw [pow_one]
    set σ := (φ.app V'.1).hom t with hσdef
    have hσt : (Scheme.Modules.Hom.app e.hom V'.1).hom σ =
        Submodule.inclusion (Divisor.divisorialSubmodule_mono hFle _) t := by
      rw [hσdef, hφ, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
        ← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, e.inv_hom_id]
      rfl
    have := MMP.Fourfold.subsingleton_irreducibleComponents (X := X)
    let ZX : irreducibleComponents X := pointComponent (genericPoint X)
    by_cases hU : componentGenericPoint X ZX ∈ (V'.1 : X.Opens)
    swap
    · have hσ0 : σ = 0 := by
        refine Subtype.ext (funext fun Z => absurd ?_ hU)
        rw [← Subsingleton.elim Z.1 ZX]
        exact Z.2
      rw [hσ0]
      exact Submodule.zero_mem _
    -- the local generator `ψ⁻¹` of `𝒪_X(M)` on `V'`
    have hψinv : M.IsDivisorialSection V'.1
        (fun Z => ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) Z.1) := by
      intro P hP
      right
      rw [P.valuation_component, P.ord_inv,
        ← hψ P (hP.mono (Set.inter_subset_inter_right _ hV'₀))]
    let e' : Γ(M.divisorialSheaf, V'.1) :=
      (⟨_, Divisor.mem_divisorialSubmodule.2 hψinv⟩ : M.divisorialSubmodule V'.1)
    -- `ψ σ` is a regular function `a` on `V'`
    have hsec : (0 : Divisor X).IsDivisorialSection V'.1
        (fun Z => (ψ : RationalFunctions X) Z.1 * σ.1 Z) := by
      intro P hP
      have hPV₀ : (P.support ∩ V₀).Nonempty := hP.mono (Set.inter_subset_inter_right _ hV'₀)
      have h1 : P.OrdGE (M.coeff P) ((ψ : RationalFunctions X) P.component) :=
        Or.inr (le_of_eq (by rw [P.valuation_component, hψ P hPV₀]))
      have h2 := h1.mul (σ.2 P hP)
      rw [add_neg_cancel] at h2
      rw [DivisorWithCoeffs.coeff_zero, neg_zero]
      exact h2
    obtain ⟨a, ha⟩ := hsec.exists_eq
    have hσ : σ = a • e' := by
      refine Subtype.ext (funext fun Z => ?_)
      change σ.1 Z = X.presheaf.germ _ _ Z.2 a *
        ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) Z.1
      have hZ : X.presheaf.germ _ _ Z.2 a = (ψ : RationalFunctions X) Z.1 * σ.1 Z :=
        congrFun ha Z
      rw [hZ, mul_comm ((ψ : RationalFunctions X) Z.1), mul_assoc, ← Pi.mul_apply,
        ← Units.val_mul, mul_inv_cancel, Units.val_one, Pi.one_apply, mul_one]
    rw [hσ]
    refine Submodule.smul_mem_smul ?_ Submodule.mem_top
    -- `a` vanishes along `W`, since `g^*a` vanishes along every component of `T`
    rw [mem_vanishingIdeal_ideal_iff']
    intro w hwW hwV' hwa
    obtain ⟨P, hPT, y, hyP, rfl⟩ : ∃ P, TD P = 1 ∧ ∃ y ∈ P.support, g y = w := by
      simpa using hWT hwW
    have hy : y ∈ V.basicOpen (g.app V'.1 a) := by rw [← Scheme.preimage_basicOpen]; exact hwa
    have hηP : P.genericPoint ∈ V.basicOpen (g.app V'.1 a) := by
      have hsp : P.genericPoint ⤳ y := by
        rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact hyP
      exact hsp.mem_open (V.basicOpen _).isOpen hy
    have hPV' : (P.support ∩ (g ⁻¹ᵁ V'.1 : V.Opens)).Nonempty := ⟨y, hyP, V.basicOpen_le _ hy⟩
    have hc := P.componentGenericPoint_mem_of_nonempty hPV'
    have hgP := P.genericPoint_mem_of_nonempty hPV'
    have hv1 := valuation_germ_of_mem_basicOpen P (g.app V'.1 a) hgP hηP hc
    rw [← MMP.Fourfold.fieldMap_germ g ZX P.component hU a] at hv1
    have hga : X.presheaf.germ _ _ hU a = (ψ : RationalFunctions X) ZX * σ.1 ⟨ZX, hU⟩ :=
      congrFun ha ⟨ZX, hU⟩
    rw [hga, map_mul, map_mul] at hv1
    have hPV₀ : (P.support ∩ (g ⁻¹ᵁ V₀ : V.Opens)).Nonempty :=
      hPV'.mono (Set.inter_subset_inter_right _ fun x hx => hV'₀ hx)
    rw [MMP.Fourfold.valuation_fieldMap_of_isPullback g hMV hψ P hPV₀ ZX] at hv1
    have hft : MMP.Fourfold.fieldMap g ZX P.component (σ.1 ⟨ZX, hU⟩) =
        t.1 ⟨P.component, hc⟩ := by
      apply fieldMap_eq_of_stalkSpecializes
      have h := (he V'.1 σ ZX hU P.component hc).1
      rw [hσt] at h
      exact h
    rw [hft] at hv1
    have ht := t.2 P hPV'
    have hFP : -(MV + A - TD).coeff P = 1 - MV.coeff P := by
      simp only [DivisorWithCoeffs.coeff_apply, Finsupp.coe_sub, Finsupp.coe_add, Pi.sub_apply,
        Pi.add_apply, hAT P hPT, hPT]
      ring
    rw [hFP] at ht
    rcases ht with h0 | hge
    · rw [h0, map_zero, mul_zero] at hv1
      exact zero_ne_one hv1
    · have h3 : WithZero.exp (MV.coeff P) * WithZero.exp (1 - MV.coeff P) ≤
          WithZero.exp (MV.coeff P) * P.valuation (t.1 ⟨P.component, hc⟩) := by gcongr
      rw [← WithZero.exp_add, add_sub_cancel, hv1, ← WithZero.exp_zero,
        WithZero.exp_le_exp] at h3
      omega
  have hφη : φ ≫ η = 0 := by
    have hK : ∀ (U : X.Opens)
        (t : Γ((Scheme.Modules.pushforward g).obj (MV + A - TD).divisorialSheaf, U)),
        (φ.app U).hom t ∈ (Stacks.Algebraization.kernelSubmodule η).obj (op U) := by
      intro U t
      apply (Stacks.Algebraization.kernelSubmodule η).isSheaf
      rw [Opens.mem_grothendieckTopology]
      intro x hx
      obtain ⟨V₀, hxV₀, ψ, hψ⟩ := hM x
      obtain ⟨_, ⟨V', hV', rfl⟩, hxV', hV'U⟩ :=
        X.isBasis_affineOpens.exists_subset_of_mem_open (⟨hx, hxV₀⟩ : x ∈ U ⊓ V₀) (U ⊓ V₀).2
      refine ⟨V', homOfLE (hV'U.trans inf_le_left), ?_, hxV'⟩
      have h1 := key ⟨V', hV'⟩ V₀ (hV'U.trans inf_le_right) ψ hψ
        ((((Scheme.Modules.pushforward g).obj (MV + A - TD).divisorialSheaf).presheaf.map
          (homOfLE (hV'U.trans inf_le_left)).op).hom t)
      have h2 := (ConcreteCategory.congr_hom (φ.mapPresheaf.naturality
        (homOfLE (hV'U.trans inf_le_left)).op) t).symm
      have h3 : (M.divisorialSheaf.presheaf.map (homOfLE (hV'U.trans inf_le_left)).op).hom
          ((φ.app U).hom t) = (φ.app V').hom
            ((((Scheme.Modules.pushforward g).obj (MV + A - TD).divisorialSheaf).presheaf.map
              (homOfLE (hV'U.trans inf_le_left)).op).hom t) := h2
      change (M.divisorialSheaf.presheaf.map (homOfLE (hV'U.trans inf_le_left)).op).hom
        ((φ.app U).hom t) ∈ (Stacks.Algebraization.kernelSubmodule η).obj (op V')
      rw [h3]
      exact h1
    ext U t
    have := hK U t
    rw [Stacks.Algebraization.kernelSubmodule_toSubmodule_obj] at this
    exact this
  have hle : Stacks.Algebraization.kernelSubmodule η ≤ imageSubmodule φ := by
    rw [hη, Stacks.Algebraization.kernelSubmodule_unit_app_eq_idealMultiple,
      Scheme.IdealSheafData.ker_subschemeι, Stacks.Algebraization.idealPowerMultiple_le_iff]
    intro U
    rw [pow_one]
    change _ ≤ (imageSubmodule φ).toSubmodule.obj _
    rw [imageSubmodule_obj φ inferInstance]
    refine Submodule.smul_le.2 fun a ha s _ => ?_
    have := MMP.Fourfold.subsingleton_irreducibleComponents (X := X)
    let ZX : irreducibleComponents X := pointComponent (genericPoint X)
    let ZY : irreducibleComponents V := pointComponent (genericPoint V)
    by_cases hU : componentGenericPoint X ZX ∈ (U : X.Opens)
    swap
    · refine ⟨0, ?_⟩
      rw [map_zero]
      refine Subtype.ext (funext fun Z => absurd ?_ hU)
      rw [← Subsingleton.elim Z.1 ZX]
      exact Z.2
    have hZY : componentGenericPoint V ZY ∈ g ⁻¹ᵁ (U : X.Opens) := by
      change g _ ∈ (U : X.Opens)
      rw [MMP.Fourfold.map_componentGenericPoint g ZY ZX]; exact hU
    obtain ⟨-, τs, -, hτs⟩ := he U s ZX hU ZY hZY
    set τ := (Scheme.Modules.Hom.app e.hom U).hom (a • s) with hτdef
    have hτ : τ = a • (Scheme.Modules.Hom.app e.hom U).hom s := Scheme.Modules.Hom.app_smul _ a s
    have hmem : (MV + A - TD).IsDivisorialSection (g ⁻¹ᵁ U) τ.1 := by
      intro P hP
      have hc := P.componentGenericPoint_mem_of_nonempty hP
      have hgP : P.genericPoint ∈ g ⁻¹ᵁ (U : X.Opens) := P.genericPoint_mem_of_nonempty hP
      have hval : τ.1 ⟨P.component, hc⟩ =
          V.presheaf.germ _ _ hc (g.app U a) * τs.1 ⟨P.component, hc⟩ := by
        rw [hτ, hτs]; rfl
      rw [hval]
      have hs := τs.2 P hP
      have ha' : P.OrdGE (TD P) (V.presheaf.germ _ _ hc (g.app U a)) := by
        rcases hT01 P with hPT | hPT
        · rw [hPT]; exact ordGE_zero_germ' P _ hgP hc
        · rw [hPT]
          refine ordGE_one_germ_of_notMem_basicOpen P _ hgP ?_ hc
          rw [← Scheme.preimage_basicOpen]
          intro h
          refine (mem_vanishingIdeal_ideal_iff' W U a).1 ha _
            (hTW P hPT ⟨P.genericPoint, ?_, rfl⟩) hgP h
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
          exact subset_closure rfl
      refine (ha'.mul hs).mono ?_
      have hA' : 0 ≤ A P := hA P
      simp only [DivisorWithCoeffs.coeff_apply, Finsupp.coe_sub, Finsupp.coe_add, Pi.sub_apply,
        Pi.add_apply]
      omega
    refine ⟨⟨τ.1, hmem⟩, ?_⟩
    have hinv : (Scheme.Modules.Hom.app e.inv U).hom τ = a • s := by
      rw [hτdef, ← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, e.hom_inv_id]
      rfl
    rw [← hinv]
    rfl
  have heq : imageSubmodule φ = Stacks.Algebraization.kernelSubmodule η :=
    le_antisymm (imageSubmodule_le_kernelSubmodule φ η hφη) hle
  refine ⟨e, imageSubmoduleIso φ inferInstance ≪≫ eqToIso (congrArg
    (fun K : M.divisorialSheaf.Submodule =>
      (K.toSheafOfModules : X.Modules)) heq) ≪≫ Stacks.Algebraization.kernelSubmoduleIso η, ?_⟩
  have h1 : (Stacks.Algebraization.kernelSubmoduleIso η).hom ≫ kernel.ι η =
      subι (Stacks.Algebraization.kernelSubmodule η) :=
    kernel.lift_ι (C := X.Modules) η _ _
  refine (Category.assoc _ _ _).trans
    ((congrArg (fun t => (imageSubmoduleIso φ inferInstance).hom ≫ t)
    ((Category.assoc _ _ _).trans ((congrArg (fun t => eqToHom _ ≫ t) h1).trans
      (eqToHom_comp_subι heq)))).trans (imageSubmoduleIso_hom_comp_subι φ inferInstance))

end KernelOfRestriction

/-! ### Global generation after a large twist -/

section TwistGeneration

open Stacks.Ample Stacks.RelativeVeryAmple RingedSpaceModuleAdjunction

/-- Finitely many generating sections of a module give as many generating sections of its
pull-back. -/
private theorem exists_generatingSections_pullback {Y Z : Scheme.{0}} (g : Y ⟶ Z)
    {M : Z.Modules} (σ : M.GeneratingSections) [Finite σ.I] :
    ∃ τ : ((modulePullback g.toLRSHom.toShHom).obj M).GeneratingSections, Finite τ.I := by
  let p : SheafOfModules.free σ.I ⟶ (Scheme.Modules.pullback g).obj M :=
    (SheafOfModules.pullbackObjFreeIso _ σ.I).inv ≫ (Scheme.Modules.pullback g).map σ.π
  have hm : Epi ((Scheme.Modules.pullback g).map σ.π) :=
    @Functor.map_epi _ _ _ _ _
      (Functor.preservesEpimorphisms_of_adjunction (Scheme.Modules.pullbackPushforwardAdjunction g))
      _ _ σ.π σ.epi
  haveI : Epi p := @epi_comp _ _ _ _ _ _ inferInstance _ hm
  have hp : Epi ((SheafOfModules.freeHomEquiv ((Scheme.Modules.pullback g).obj M)).symm
      ((SheafOfModules.freeHomEquiv ((Scheme.Modules.pullback g).obj M)) p)) := by
    rw [Equiv.symm_apply_apply]; infer_instance
  let τ : ((Scheme.Modules.pullback g).obj M).GeneratingSections :=
    ⟨σ.I, ((Scheme.Modules.pullback g).obj M).freeHomEquiv p, hp⟩
  haveI : Finite τ.I := inferInstanceAs (Finite σ.I)
  let e := ((AlgebraicGeometry.modulePullbackIsoSchemePullback g).app M).inv
  haveI : @Epi (SheafOfModules.{0} Y.ringCatSheaf) _ _ _ e :=
    @IsIso.epi_of_iso _ _ _ _ e inferInstance
  exact ⟨τ.ofEpi e, inferInstanceAs (Finite σ.I)⟩

/-- **A relatively generated sheaf is globally generated after a large twist.** Let `f : X ⟶ Z`
be a projective morphism to a projective complex variety with an ample invertible `H`, and `F` a
coherent module on `X` with `f^* f_* F ⟶ F` surjective. Then `f^* H^{⊗ e} ⊗ F` is generated by
finitely many global sections for all large `e`. -/
private theorem exists_generatingSections_tensor_pullback {X Z : Scheme.{0}}
    (sZ : Z ⟶ Spec (.of ℂ)) [MMP.Mori.IsProjectiveVariety ℂ sZ] [IsLocallyNoetherian X]
    (f : X ⟶ Z) (hfp : IsProjectiveMorphism f) (H : Z.Modules) [IsInvertibleModule Z H]
    (hH : IsAmple Z H) (F : X.Modules) [F.IsCoherent]
    (hfree : Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app F)) :
    ∃ e₀ : ℕ, ∀ e : ℕ, e₀ ≤ e →
      ∃ σ : (tensorModules X ((modulePullback f.toLRSHom.toShHom).obj (tensorPowModule Z H e))
        F).GeneratingSections, Finite σ.I := by
  have hZproj := (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sZ)
  haveI : IsProper sZ := isProper_of_isProjectiveMorphism sZ hZproj.isProjective
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hfp
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
  set G := (Scheme.Modules.pushforward f).obj F
  haveI : G.IsCoherent := ProperCoherenceWitness.isCoherent_pushforward f _
  have hqc := Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent G
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hH).2 G hqc.1 hqc.2
  refine ⟨n₀.toNat, fun e he => ?_⟩
  set N := tensorPowModule Z H (e : ℤ) with hN
  obtain ⟨σ, hσ⟩ := hn₀ (e : ℤ) (by omega)
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory Z
  let i₁ := Stacks.TensorSheafSpellingIso.monoidalTensorIso Z G N
  let i₂ : tensorModules Z N G ≅ tensorModules Z G N :=
    (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight Z N).app G
  let j₁ := i₁.hom ≫ i₂.inv
  haveI : @Epi (SheafOfModules.{0} Z.ringCatSheaf) _ _ _ j₁ :=
    @IsIso.epi_of_iso _ _ _ _ j₁ inferInstance
  haveI : Finite (σ.ofEpi j₁).I := hσ
  obtain ⟨τ, hτ⟩ := exists_generatingSections_pullback f (σ.ofEpi j₁)
  let P := modulePullback f.toLRSHom.toShHom
  let c' : P.obj G ⟶ F := ((AlgebraicGeometry.modulePullbackIsoSchemePullback f).app G).hom ≫
    (Scheme.Modules.pullbackPushforwardAdjunction f).counit.app F
  have hc' : Epi c' :=
    @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)) _ hfree
  haveI : ((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj (P.obj N)).IsEquivalence :=
    Stacks.Cohomology.AmpleH1.tensorLeft_isEquivalence X _
  have hc : Epi (((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj (P.obj N)).map c') :=
    @Functor.map_epi _ _ _ _ _ (Functor.preservesEpimorphisms_of_adjunction
      ((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj
        (P.obj N)).asEquivalence.toAdjunction) _ _ c' hc'
  let j₂ := (pullbackTensorModulesIso f N G).hom ≫
    ((Stacks.SheafOfModules.Tensor.sheafTensor X.sheaf).obj (P.obj N)).map c'
  have hj₂ : Epi j₂ := @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)) _ hc
  exact ⟨@SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _ τ j₂ hj₂, hτ⟩

/-- `𝒪_W(nA + B) ≅ 𝒪_W(B) ⊗ 𝒪_W(A)^{⊗ n}` for Cartier divisors `A` and `B`. -/
private theorem nonempty_divisorialSheaf_nsmul_add_iso {W : Scheme.{0}} [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] {A B : Divisor W} (hA : A.IsCartier) (hB : B.IsCartier) (n : ℕ) :
    haveI := hA.isInvertibleModule_divisorialSheaf
    Nonempty ((n • A + B).divisorialSheaf ≅
      tensorModules W B.divisorialSheaf (tensorPowModule W A.divisorialSheaf (n : ℤ))) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor W _).symm ≪≫
      tensorModulesMapIso W (Iso.refl _) (tensorPowModuleZeroIso W _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      (((hA.nsmul n).add hB).divisorialSheafTensorIso hA).symm ≪≫
      tensorModulesMapIso W e (tensorPowModuleOneIso W _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator W _ _ _ ≪≫
      tensorModulesMapIso W (Iso.refl _)
        (tensorPowModuleAddIso W _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr W _ (by push_cast; ring))⟩

/-- **Generation on the resolution.** Pulling generating sections of `f^* H^{⊗ dm} ⊗ F` back
along `p : W ⟶ X` gives finitely many generating sections of `𝒪_W(mA + L_W)`, for divisors `A`
and `L_W` on `W` with `𝒪_W(A) ≅ (f ∘ p)^* H^{⊗ d}` and `𝒪_W(L_W) ≅ p^* F`. -/
private theorem exists_generatingSections_nsmul_add {X Z W : Scheme.{0}} [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] (f : X ⟶ Z) (p : W ⟶ X) (H : Z.Modules)
    [IsInvertibleModule Z H] (F : X.Modules) {A LW : Divisor W} (hA : A.IsCartier)
    (hLW : LW.IsCartier) (eLW : Nonempty (LW.divisorialSheaf ≅ (Scheme.Modules.pullback p).obj F))
    (d m : ℕ) (eA : Nonempty (A.divisorialSheaf ≅ (Scheme.Modules.pullback p).obj
      ((Scheme.Modules.pullback f).obj (tensorPowModule Z H d))))
    (σ : (tensorModules X ((modulePullback f.toLRSHom.toShHom).obj
      (tensorPowModule Z H ((d * m : ℕ) : ℤ))) F).GeneratingSections) [Finite σ.I] :
    ∃ τ : (m • A + LW).divisorialSheaf.GeneratingSections, Finite τ.I := by
  obtain ⟨eLW⟩ := eLW
  obtain ⟨eA⟩ := eA
  haveI := hA.isInvertibleModule_divisorialSheaf
  obtain ⟨τ₀, hτ₀⟩ := exists_generatingSections_pullback p σ
  let Pf := modulePullback f.toLRSHom.toShHom
  let Pp := modulePullback p.toLRSHom.toShHom
  let eAA : Pp.obj (Pf.obj (tensorPowModule Z H d)) ≅ A.divisorialSheaf :=
    Pp.mapIso ((AlgebraicGeometry.modulePullbackIsoSchemePullback f).app _) ≪≫
      (AlgebraicGeometry.modulePullbackIsoSchemePullback p).app _ ≪≫ eA.symm
  let iH : Pp.obj (Pf.obj (tensorPowModule Z H ((d * m : ℕ) : ℤ))) ≅
      tensorPowModule W A.divisorialSheaf (m : ℤ) :=
    Pp.mapIso (Pf.mapIso (tensorPowModuleCongr Z H (by push_cast; ring) ≪≫
        (tensorPowModulePowIso Z H d m).symm) ≪≫
      pullbackTensorPowModuleIso f (tensorPowModule Z H d) m) ≪≫
      pullbackTensorPowModuleIso p (Pf.obj (tensorPowModule Z H d)) m ≪≫
      tensorPowModuleIsoOfIso W _ _ eAA m
  let iF : Pp.obj F ≅ LW.divisorialSheaf :=
    (AlgebraicGeometry.modulePullbackIsoSchemePullback p).app F ≪≫ eLW.symm
  obtain ⟨i₃⟩ := nonempty_divisorialSheaf_nsmul_add_iso hA hLW m
  let Φ := pullbackTensorModulesIso p _ _ ≪≫ tensorModulesMapIso W iH iF ≪≫
    (Stacks.Cohomology.AmpleH1.tensorLeftIsoRight W _).app _ ≪≫ i₃.symm
  have hΦ : Epi Φ.hom := @IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)
  exact ⟨@SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _ τ₀ Φ.hom hΦ, hτ₀⟩

/-- `(fp)^* H^{⊗ a} ⊗ (fp)^* H^{⊗ b} ≅ (fp)^* H^{⊗ (a + b)}`. -/
private theorem nonempty_tensorModules_pullback_pullback_tensorPowModule_iso {X Z W : Scheme.{0}}
    (f : X ⟶ Z) (p : W ⟶ X) (H : Z.Modules) [IsInvertibleModule Z H] (a b : ℕ) :
    Nonempty (tensorModules W
        ((Scheme.Modules.pullback p).obj ((Scheme.Modules.pullback f).obj (tensorPowModule Z H a)))
        ((Scheme.Modules.pullback p).obj
          ((Scheme.Modules.pullback f).obj (tensorPowModule Z H b))) ≅
      (Scheme.Modules.pullback p).obj ((Scheme.Modules.pullback f).obj
        (tensorPowModule Z H ((a + b : ℕ) : ℤ)))) := by
  let Pf := modulePullback f.toLRSHom.toShHom
  let Pp := modulePullback p.toLRSHom.toShHom
  let i : ∀ e : ℕ, (Scheme.Modules.pullback p).obj ((Scheme.Modules.pullback f).obj
      (tensorPowModule Z H e)) ≅ Pp.obj (Pf.obj (tensorPowModule Z H e)) := fun e =>
    (Scheme.Modules.pullback p).mapIso
        ((AlgebraicGeometry.modulePullbackIsoSchemePullback f).app _).symm ≪≫
      ((AlgebraicGeometry.modulePullbackIsoSchemePullback p).app _).symm
  exact ⟨tensorModulesMapIso W (i a) (i b) ≪≫ (pullbackTensorModulesIso p _ _).symm ≪≫
    Pp.mapIso ((pullbackTensorModulesIso f _ _).symm ≪≫
      Pf.mapIso (tensorPowModuleAddIso Z H (a : ℤ) (b : ℤ) ≪≫
        tensorPowModuleCongr Z H (by push_cast; ring))) ≪≫ (i (a + b)).symm⟩

/-- `𝒪_W(kA + B) ≅ (fp)^* H^{⊗ (k a + b)}` when `𝒪_W(A) ≅ (fp)^* H^{⊗ a}` and
`𝒪_W(B) ≅ (fp)^* H^{⊗ b}`, for Cartier divisors `A` and `B`. -/
private theorem nonempty_divisorialSheaf_nsmul_add_iso_pullback_pullback {X Z W : Scheme.{0}}
    [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] (f : X ⟶ Z) (p : W ⟶ X)
    (H : Z.Modules) [IsInvertibleModule Z H] {A B : Divisor W} (hA : A.IsCartier)
    (hB : B.IsCartier) {a b : ℕ}
    (eA : Nonempty (A.divisorialSheaf ≅ (Scheme.Modules.pullback p).obj
      ((Scheme.Modules.pullback f).obj (tensorPowModule Z H a))))
    (eB : Nonempty (B.divisorialSheaf ≅ (Scheme.Modules.pullback p).obj
      ((Scheme.Modules.pullback f).obj (tensorPowModule Z H b)))) (k : ℕ) :
    Nonempty ((k • A + B).divisorialSheaf ≅ (Scheme.Modules.pullback p).obj
      ((Scheme.Modules.pullback f).obj (tensorPowModule Z H ((k * a + b : ℕ) : ℤ)))) := by
  obtain ⟨eA⟩ := eA
  induction k with
  | zero =>
    obtain ⟨eB⟩ := eB
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫ eB ≪≫ eqToIso (by rw [zero_mul, zero_add])⟩
  | succ k ih =>
    obtain ⟨e⟩ := ih
    obtain ⟨j⟩ := nonempty_tensorModules_pullback_pullback_tensorPowModule_iso f p H
      (k * a + b) a
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      (((hA.nsmul k).add hB).divisorialSheafTensorIso hA).symm ≪≫
      tensorModulesMapIso W e eA ≪≫ j ≪≫ eqToIso (by congr 3; push_cast; ring)⟩

end TwistGeneration

/-! ### A general member of a free linear system -/

section GeneralMember

/-- A general linear combination of finitely many sections, one of them nonzero, is nonzero:
the coefficient vectors `c` with `∑ cᵢ sᵢ = 0` form a proper subspace of `kⁱ`, contained in the
kernel of a linear form `ℓ` with `ℓ(e_j) ≠ 0`. -/
private theorem exists_polynomial_sum_smul_ne_zero {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {H : Divisor X} {ι : Type*} [Fintype ι] (s : ι → H.divisorialSubmodule ⊤) (j : ι)
    (hj : s j ≠ 0) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      (∑ i, scalarsToGlobalSections k sX (c i) • s i) ≠ 0 := by
  classical
  let p : Submodule k (ι → k) :=
    { carrier := {c | ∑ i, scalarsToGlobalSections k sX (c i) • s i = 0}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq, Pi.add_apply, map_add, add_smul,
          Finset.sum_add_distrib] at *
        rw [ha, hb, add_zero]
      zero_mem' := by simp
      smul_mem' := by
        intro a c hc
        simp only [Set.mem_setOf_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_smul] at *
        rw [← Finset.smul_sum, hc, smul_zero] }
  have hjp : (Pi.single j 1 : ι → k) ∉ p := by
    intro h
    apply hj
    have : ∑ i, scalarsToGlobalSections k sX ((Pi.single j 1 : ι → k) i) • s i = 0 := h
    rwa [Finset.sum_eq_single j (fun i _ hi => by simp [Pi.single_apply, hi]) (by simp),
      Pi.single_eq_same, map_one, one_smul] at this
  obtain ⟨ℓ, hℓ, hp⟩ := Submodule.exists_le_ker_of_notMem hjp
  let Q : MvPolynomial ι k :=
    ∑ i, MvPolynomial.C (ℓ (fun j => if i = j then 1 else 0)) * MvPolynomial.X i
  have heval : ∀ c, MvPolynomial.eval c Q = ℓ c := by
    intro c
    rw [LinearMap.pi_apply_eq_sum_univ ℓ c]
    simp [Q, MvPolynomial.eval_sum, mul_comm]
  refine ⟨Q, fun h => hℓ (by rw [← heval, h, map_zero]), fun c hc h0 => hc ?_⟩
  rw [heval]
  exact hp (show c ∈ p from h0)

/-- `𝒪_W(G)` has finitely many global sections without common zero. -/
private abbrev HasFreeSections {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] (G : Divisor W) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (t : ι → G.divisorialSubmodule ⊤),
    ∀ y : W, ∃ (i : ι) (hi : t i ≠ 0), y ∉ (G.zeroDivisor (t i) hi).supp

/-- Finitely many generating sections of `𝒪_W(G)`, `G` Cartier, have no common zero. -/
private theorem hasFreeSections_of_generatingSections {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] {G : Divisor W} (hG : G.IsCartier)
    (σ : G.divisorialSheaf.GeneratingSections) [Finite σ.I] : HasFreeSections G := by
  haveI := hG.isInvertibleModule_divisorialSheaf
  haveI : Fintype σ.I := Fintype.ofFinite _
  let t : σ.I → G.divisorialSubmodule ⊤ := fun i => (σ.s i).eval (Opposite.op ⊤)
  refine ⟨σ.I, inferInstance, t, fun y => ?_⟩
  obtain ⟨i, hi⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing _ σ y
  have hy : y ∈ Stacks.Ample.nonvanishingLocus G.divisorialSheaf (t i) := by
    rwa [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
  have hti : t i ≠ 0 := by
    intro h0
    have h0' : ((σ.s i).eval (Opposite.op ⊤) : Γ(G.divisorialSheaf, ⊤)) = 0 := h0
    refine (Stacks.Ample.mem_nonvanishingLocus_iff G.divisorialSheaf
      ((σ.s i).eval (Opposite.op ⊤)) y).1 hy ?_
    rw [h0']
    convert zero_mem (Stacks.ModuleStalk.maximalSmul G.divisorialSheaf y) using 1
    exact map_zero _
  refine ⟨i, hti, ?_⟩
  have := MMP.Mori.Divisor.nonvanishingLocus_eq_compl_supp_zeroDivisor hG (t i) hti
  rw [this] at hy
  exact hy

/-- Products of sections without common zero have no common zero. -/
private theorem hasFreeSections_add {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] {G₁ G₂ : Divisor W} (h₁ : HasFreeSections G₁)
    (h₂ : HasFreeSections G₂) : HasFreeSections (G₁ + G₂) := by
  obtain ⟨ι₁, _, t₁, ht₁⟩ := h₁
  obtain ⟨ι₂, _, t₂, ht₂⟩ := h₂
  refine ⟨ι₁ × ι₂, inferInstance, fun i => MMP.Positivity.Divisor.sectionMul (t₁ i.1) (t₂ i.2),
    fun y => ?_⟩
  obtain ⟨i₁, hi₁, hy₁⟩ := ht₁ y
  obtain ⟨i₂, hi₂, hy₂⟩ := ht₂ y
  refine ⟨(i₁, i₂), MMP.Positivity.Divisor.sectionMul_ne_zero hi₁ hi₂, fun hy => ?_⟩
  rw [MMP.Positivity.Divisor.zeroDivisor_sectionMul hi₁ hi₂] at hy
  rcases DivisorWithCoeffs.supp_add_le _ _ hy with h | h
  · exact hy₁ h
  · exact hy₂ h

private theorem hasFreeSections_nsmul_add {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] {G₁ G₂ : Divisor W}
    (h₁ : HasFreeSections G₁) (h₂ : HasFreeSections G₂) (k : ℕ) :
    HasFreeSections (k • G₁ + G₂) := by
  induction k with
  | zero => rw [zero_smul, zero_add]; exact h₂
  | succ k ih =>
    rw [succ_nsmul, add_right_comm]
    exact hasFreeSections_add ih h₁

open Classical in
/-- **A reduced general member of a free linear system.** On a smooth complex variety `W`, let
`𝒪_W(G)` have finitely many global sections without common zero, and `∑_{E ∈ S} E` be snc. Then
`G` is linearly equivalent to a reduced divisor `∑_{E ∈ T} E` with `T` disjoint from `S` and
`∑_{E ∈ T ∪ S} E` snc. -/
private theorem exists_reduced_member_isSNC {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] (sW : W ⟶ Spec (.of ℂ))
    (hV : AlgebraicGeometry.IsVariety ℂ sW) (hsm : IsSmoothScheme sW) {G : Divisor W}
    (hG : G.IsCartier) (hfs : HasFreeSections G)
    (S : Finset (MMP.Mori.PrimeDivisor W))
    (hS : DivisorWithCoeffs.IsSNC sW (∑ E ∈ S, Finsupp.single E (1 : ℤ))) :
    ∃ (T : Finset (MMP.Mori.PrimeDivisor W)) (φ : (RationalFunctions W)ˣ),
      (∑ E ∈ T, Finsupp.single E (1 : ℤ) : Divisor W) = principalDivisor φ + G ∧
        Disjoint T S ∧ DivisorWithCoeffs.IsSNC sW (∑ E ∈ T ∪ S, Finsupp.single E (1 : ℤ)) := by
  obtain ⟨ι, _, t, ht⟩ := hfs
  haveI := hV
  haveI : LocallyOfFiniteType sW := hV.toLocallyOfFiniteType
  haveI : Smooth sW := Scheme.Hom.smoothLocus_eq_top_iff.mp (by
    rw [← smoothLocus_eq_smoothLocus]; exact hsm)
  letI : W.Over (Spec (.of ℂ)) := ⟨sW⟩
  haveI : IsSmoothVariety ℂ (W ↘ Spec (.of ℂ)) :=
    { toIsVariety := (inferInstance : AlgebraicGeometry.IsVariety ℂ sW),
      toSmooth := (inferInstance : Smooth sW) }
  obtain ⟨Q, hQ, hQT⟩ := MMP.Mori.exists_polynomial_zeroDivisor_eq_sum_isSNC
    (k := ℂ) G hG t ht S hS
  obtain ⟨x⟩ : Nonempty W := inferInstance
  obtain ⟨j, hj, -⟩ := ht x
  obtain ⟨Q₁, hQ₁, hσ⟩ := exists_polynomial_sum_smul_ne_zero (k := ℂ) (W ↘ Spec (.of ℂ)) t j hj
  obtain ⟨c, hc⟩ : ∃ c : ι → ℂ, MvPolynomial.eval c (Q * Q₁) ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact mul_ne_zero hQ hQ₁ (MvPolynomial.funext fun c => by rw [h c, map_zero])
  rw [map_mul] at hc
  have hτ := hσ c (right_ne_zero_of_mul hc)
  obtain ⟨T, hT, hTS, hsnc, -⟩ := hQT c (left_ne_zero_of_mul hc) hτ
  exact ⟨T, _, hT.symm.trans (MMP.Mori.Divisor.zeroDivisor_eq _ _ _), hTS, hsnc⟩

open Classical in
/-- The coefficients of a reduced divisor `∑_{E ∈ s} E`. -/
private theorem coeff_sum_single_one {W : Scheme.{0}} (s : Finset (MMP.Mori.PrimeDivisor W))
    (F : MMP.Mori.PrimeDivisor W) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : MMP.Mori.Divisor W).coeff F = if F ∈ s then 1 else 0 := by
  change (∑ E ∈ s, Finsupp.single E (1 : ℤ)) F = _
  rw [Finsupp.finset_sum_apply]
  simp [Finsupp.single_apply]

/-- The generic point of a prime divisor `Q` lies on `Supp D` exactly when `Q` is a component of
`D`. -/
private theorem genericPoint_mem_supp_iff {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y]
    {R : Type*} [Zero R] (D : MMP.Mori.DivisorWithCoeffs R Y) (Q : MMP.Mori.PrimeDivisor Y) :
    Q.genericPoint ∈ D.supp ↔ D.coeff Q ≠ 0 := by
  rw [DivisorWithCoeffs.mem_supp_iff]
  constructor
  · rintro ⟨E, hE, hQE⟩
    rwa [eq_of_genericPoint_mem_support hQE]
  · intro h
    exact ⟨Q, h, by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩

end GeneralMember

/-! ### A relatively free multiple of a relatively semiample divisor -/

section RelativelyFreeMultiple

open MMP.Intersection

/-- On an integral locally Noetherian scheme, a point of coheight zero lies in the support of no
Cartier divisor. -/
private theorem notMem_cartierSupport_of_coheight_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (A : X.CartierDivisor) {x : X} (hx : Order.coheight x = 0) :
    x ∉ cartierSupport A := by
  have : Ring.KrullDimLE 0 (X.presheaf.stalk x) := krullDimLE_of_coheight_le (by simp [hx])
  have : IsArtinianRing (X.presheaf.stalk x) := isArtinianRing_iff_krullDimLE_zero.mpr this
  exact notMem_cartierSupport_of_isArtinianRing A x

/-- Every Cartier divisor on a Noetherian integral scheme has a Weil divisor. -/
private theorem exists_isWeilDivisorOfCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [TopologicalSpace.NoetherianSpace X] (A : X.CartierDivisor) :
    ∃ w : Divisor X, IsWeilDivisorOfCartier A w := by
  have hfin := MMP.Mori.finite_setOf_genericPoint_mem (isClosed_cartierSupport A)
    (fun s hs h0 => notMem_cartierSupport_of_coheight_eq_zero A h0 hs)
  refine ⟨Finsupp.ofSupportFinite (fun P => primeDivisorOrder P A) (hfin.subset fun P hP => ?_),
    fun P => ?_⟩
  · by_contra h
    have hg : (primeDivisorSubvariety P).genericPoint = P.genericPoint := rfl
    refine hP ((isOrderAlong_primeDivisorOrder A P).eq_zero_of_not_subset fun h' => h ?_)
    show P.genericPoint ∈ cartierSupport A
    rw [← hg]
    exact genericPoint_mem_cartierSupport_iff.mpr h'
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.ofSupportFinite_coe]
    exact isOrderAlong_primeDivisorOrder A P

/-- The Weil divisor of the realization of `q • C`, for a `ℚ`-Cartier divisor `C` with Weil
`ℚ`-divisor `D`, is `q • D`. -/
private theorem coeff_eq_mul_of_isWeilDivisorOfCartier_realization {X : Scheme.{0}}
    [IsLocallyNoetherian X] {D : QDivisor X} {C : KCartierDivisor ℚ X}
    (hC : ∀ P : MMP.Mori.PrimeDivisor X,
      D.coeff P = C.sum fun E c => c * (primeDivisorOrder P E : ℚ)) {q : ℕ}
    (h : ∀ E, ∃ n : ℤ, ((q : ℚ) • C) E = n) {B : Divisor X}
    (hB : IsWeilDivisorOfCartier (KCartierDivisor.realization ((q : ℚ) • C) h) B)
    (P : MMP.Mori.PrimeDivisor X) : (B.coeff P : ℚ) = q * D.coeff P := by
  classical
  have hc : ∀ E, ((Classical.choose (h E) : ℤ) : ℚ) = ((q : ℚ) • C) E := fun E =>
    (Classical.choose_spec (h E)).symm
  rw [← (hB P).primeDivisorOrder_eq, KCartierDivisor.realization, Finsupp.sum, map_sum,
    Int.cast_sum, hC P, Finsupp.sum, Finset.mul_sum]
  have hz : ∀ E ∈ C.support, E ∉ ((q : ℚ) • C).support →
      (q : ℚ) * (C E * (primeDivisorOrder P E : ℚ)) = 0 := fun E _ hE => by
    rw [Finsupp.notMem_support_iff, Finsupp.smul_apply, smul_eq_mul] at hE
    rw [← mul_assoc, hE, zero_mul]
  rw [← Finset.sum_subset (Finsupp.support_smul (b := (q : ℚ)) (g := C)) hz]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [map_zsmul, smul_eq_mul, Int.cast_mul, hc, Finsupp.smul_apply, smul_eq_mul, mul_assoc]

/-- **A relatively free multiple.** A `ℚ`-divisor `D` semiample over `Z` has a multiple `m D`,
`m > 0`, which is a Cartier divisor `L` with `f^* f_* 𝒪_X(L) ⟶ 𝒪_X(L)` surjective. -/
private theorem exists_nsmul_eq_epi_counit {X Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z) {D : QDivisor X}
    (hD : QDivisor.IsRelativelySemiample f D) :
    ∃ m : ℕ, 0 < m ∧ ∃ L : Divisor X, Divisor.toQDivisor L = (m : ℚ) • D ∧ L.IsCartier ∧
      Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app L.divisorialSheaf) := by
  haveI : IsNoetherian X := ⟨⟩
  obtain ⟨C, hC, q, hq, hint, hfree⟩ := hD
  obtain ⟨L, hL⟩ := exists_isWeilDivisorOfCartier (KCartierDivisor.realization ((q : ℚ) • C) hint)
  refine ⟨q, hq, L, ?_, MMP.Intersection.IsWeilDivisorOfCartier.isCartier hL, ?_⟩
  · ext P
    rw [Divisor.coeff_toQDivisor, coeff_eq_mul_of_isWeilDivisorOfCartier_realization hC hint hL P]
    rfl
  · set adj := Scheme.Modules.pullbackPushforwardAdjunction f
    let e := MMP.Intersection.IsWeilDivisorOfCartier.sheafIsoDivisorialSheaf hL
    have hR : Epi (adj.counit.app (MMP.CartierDivisor.sheaf
        (KCartierDivisor.realization ((q : ℚ) • C) hint))) := hfree
    have hnat := adj.counit.naturality e.hom
    have heq : adj.counit.app L.divisorialSheaf =
        (Scheme.Modules.pushforward f ⋙ Scheme.Modules.pullback f).map e.inv ≫
          adj.counit.app _ ≫ e.hom := by
      rw [← Category.assoc, adj.counit.naturality e.inv, Functor.id_map, Category.assoc,
        Iso.inv_hom_id, Category.comp_id]
    rw [heq]
    infer_instance

end RelativelyFreeMultiple

/-! ### The resolution of the floor -/

/-- **A log resolution of a dlt pair whose exceptional crepant coefficients are `< 1`.** A dlt
pair `(X, B)` on a normal projective complex variety has a projective log resolution
`p : W ⟶ X`, isomorphic over the open set of the dlt condition, with crepant boundary
`K_W + Δ_W = p^*(K_X + B)`; every prime divisor of `W` contracted by `p` lies over the closed
complement of that open set, so it has discrepancy `> -1`, that is coefficient `< 1` in
`Δ_W`. -/
private theorem exists_isLogResolution_coeff_lt_one
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) [MMP.Mori.IsProjectiveVariety ℂ sX]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {n : ℕ} (K : MMP.Mori.Divisor X) (B : MMP.Mori.QDivisor X)
    (hdlt : MMP.Mori.IsDltPair sX n K B) :
    ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (p : W ⟶ X) (_ : IsDominant p) (hres : MMP.Fourfold.IsLogResolution sX B p)
      (hW : MMP.Mori.IsNormalVariety ℂ (p ≫ sX)) (ΔW : MMP.Mori.QDivisor W),
      MMP.Mori.IsCrepantBoundary sX n K B p hW
        hres.toIsLogResolution.isBirationalMorphism ΔW ∧
      ∀ P : MMP.Mori.PrimeDivisor W, 2 ≤ Order.coheight (p P.genericPoint) →
        ΔW.coeff P < 1 := by
  classical
  have hPW := hdlt.isPairWith
  have hX : MMP.Mori.IsNormalVariety ℂ sX := hPW.1
  have hK := hPW.2.1
  have hP : MMP.Mori.IsPair sX B := hdlt.isPair
  obtain ⟨-, -, U, hUsm, hUsnc, hUdisc⟩ := hdlt
  haveI : MMP.Mori.IsVariety ℂ sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  obtain ⟨W, p, hres0, hpure, hsnc, hiso⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX B.support
  haveI : IsProper p := hres0.isProjective.isProper
  have hfres : MMP.Mori.IsSmoothResolution sX p :=
    ⟨inferInstance, hres0.isBirationalMorphism, hres0.isSmoothScheme⟩
  obtain ⟨hW, -, -⟩ := hfres.isNormalVariety hX
  haveI : IsIntegral W := hW.1.toIsIntegral
  haveI : LocallyOfFiniteType (p ≫ sX) := hW.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (p ≫ sX)
  haveI : IsNormal W := hW.2
  haveI : IsDominant p := hres0.isBirationalMorphism.isDominant
  obtain ⟨M, hMinv, hMa⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety
    (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sX)
  haveI : Stacks.Ample.IsInvertibleModule X M := hMinv
  have hres : MMP.Fourfold.IsLogResolution sX B p := by
    refine ⟨⟨⟨inferInstance, hres0.isBirationalMorphism, hres0.isSmoothScheme⟩, hpure, ?_⟩,
      AlgebraicGeometry.isProjectiveMorphism_of_isProjective p M
        ((Stacks.AmpleBridge.isAmple_iff_isAmple X M).mpr hMa) hres0.isProjective⟩
    haveI : QuasiCompact (p ≫ sX) := hW.1.toQuasiCompact
    haveI : AlgebraicGeometry.IsNoetherian W := isNoetherian_of_locallyOfFiniteType (p ≫ sX)
    refine MMP.ProgramBaseChange.isSNCSubset_of_isSNCClosedSubset hres0.isSmoothScheme ?_
    convert hsnc using 1
    rw [TopologicalSpace.Closeds.coe_sup, MMP.Mori.QDivisor.supp_toRDivisor]
    congr 1
    change p ⁻¹' (B.supp : Set X) = _
    simp [MMP.Mori.DivisorWithCoeffs.supp, TopologicalSpace.Closeds.coe_finset_sup]
  obtain ⟨⟨ΔW, hΔ, -⟩, -⟩ :=
    MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP hK p hW
      hres.toIsLogResolution.isBirationalMorphism
  refine ⟨W, inferInstance, inferInstance, inferInstance, p, inferInstance, hres, hW, ΔW, hΔ,
    fun P hP2 => ?_⟩
  -- `p` is an isomorphism over the open `U` of the dlt condition
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : LocallyOfFinitePresentation (U.ι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := U.ι ≫ sX)).mpr inferInstance
  have hUsm' : MMP.Mori.IsSmoothScheme (U.ι ≫ sX) := by
    rw [MMP.Mori.isSmoothScheme_iff, ← Scheme.Hom.smoothLocus_eq_top_iff,
      ← Scheme.Hom.preimage_smoothLocus_eq]
    rw [MMP.Mori.smoothLocus_eq_smoothLocus] at hUsm
    exact top_unique fun x _ => hUsm x.2
  have hUsnc' : MMP.Resolution.IsSNCClosedSubset (U.ι ≫ sX)
      (U.ι ⁻¹' (B.support.sup fun E => (E.idealSheaf.support : Set X))) :=
    MMP.Intersection.isSNCClosedSubset_preimage_of_isSNC_restrictOpen sX U B hUsnc
  have hUb : U ≤ MMP.Mori.biregularLocus p := MMP.Mori.le_biregularLocus (hiso U hUsm' hUsnc')
  -- an exceptional prime of `W` lies over the complement of `U`
  have hnot : p P.genericPoint ∉ U := fun hU => by
    have h := MMP.Positivity.coheight_map_of_mem_biregularLocus p (hUb hU)
    rw [h, MMP.Mori.PrimeDivisor.coheight_genericPoint] at hP2
    exact absurd hP2 (by decide)
  let D : MMP.Mori.DivisorOver ℂ sX :=
    ⟨W, p, hW, hres.toIsLogResolution.isBirationalMorphism, P⟩
  have hc : (D.center : Set X) ⊆ (U : Set X)ᶜ := by
    rw [MMP.Mori.DivisorOver.center_eq_closure_genericPoint]
    exact closure_minimal (Set.singleton_subset_iff.mpr hnot) U.isOpen.isClosed_compl
  have := hUdisc D _ hc (hΔ P)
  linarith

/-! ### The injectivity on `X` -/

open Stacks.Coherent (tensorRightModules) in
/-- **The cohomological core on a chosen resolution.** In the setting of
`exists_mono_Hfunctor_one_kernel_unit`, let `p : W ⟶ X` be a log resolution with crepant boundary
`Δ_W` whose exceptional coefficients are `< 1`. Put `S = p⁻¹_* T`, `Γ = Δ_W - S`, `E = -⌊Γ⌋` and
`M_W = p^*(mD) + E - S`. For `d ≫ 0` the inclusion
`𝒪_W(M_W + d(fp)^*H) ⟶ 𝒪_W(M_W + S + d(fp)^*H)` has no higher direct images on either side
(Reid–Fukuda vanishing, the boundaries being `Γ + E` and `S + Γ + E`), is injective on `H¹` by
the fundamental injectivity theorem (after writing `M_W + d(fp)^*H ∼_ℚ K_W + B₁` for a general
snc boundary `B₁` whose fractional part contains `S`), and its direct image is the twisted
kernel inclusion on `X`; Leray (`mono_Hfunctor_one_pushforward_map`) then concludes. -/
private theorem exists_mono_Hfunctor_one_kernel_unit_of_resolution
    {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) (sZ : Z ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ sZ]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (f : X ⟶ Z) (hf : f ≫ sZ = sX) (hfp : IsProjectiveMorphism f)
    {n : ℕ} (K : MMP.Mori.Divisor X) (B : MMP.Mori.QDivisor X)
    (hdlt : MMP.Mori.IsDltPair sX n K B) (hQ : MMP.Fourfold.IsQFactorial sX)
    (P : MMP.Mori.QDivisor X) (hP0 : 0 ≤ P) (hPQ : P.IsQCartier)
    (hPsupp : P.supp = B.roundDown.supp)
    (hsemi : ∃ ε₀ : ℚ, 0 < ε₀ ∧ ∀ ε : ℚ, 0 < ε → ε < ε₀ →
      QDivisor.IsRelativelySemiample f (Divisor.toQDivisor K + B - ε • P))
    (m : ℕ) (hm : 2 ≤ m) (Dm : MMP.Mori.Divisor X)
    (hDm : Divisor.toQDivisor Dm = (m : ℚ) • (Divisor.toQDivisor K + B)) (hDmC : Dm.IsCartier)
    (H : Z.Modules) [Stacks.Ample.IsInvertibleModule Z H] (hH : Stacks.Ample.IsAmple Z H)
    [MMP.Mori.IsProjectiveVariety ℂ sX]
    {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (p : W ⟶ X) [IsDominant p] (hres : MMP.Fourfold.IsLogResolution sX B p)
    (hW : MMP.Mori.IsNormalVariety ℂ (p ≫ sX)) (ΔW : MMP.Mori.QDivisor W)
    (hΔ : MMP.Mori.IsCrepantBoundary sX n K B p hW
      hres.toIsLogResolution.isBirationalMorphism ΔW)
    (hΔ1 : ∀ P : MMP.Mori.PrimeDivisor W, 2 ≤ Order.coheight (p P.genericPoint) →
      ΔW.coeff P < 1) :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d →
      Mono ((Hfunctor X.ringCatSheaf ⊤ 1).map
        ((tensorRightModules X ((Scheme.Modules.pullback f).obj
            (Stacks.Ample.tensorPowModule Z H d))).map
          (Limits.kernel.ι ((Scheme.Modules.pullbackPushforwardAdjunction
            B.roundDown.suppIdeal.subschemeι).unit.app Dm.divisorialSheaf)))) := by
  set u := (Scheme.Modules.pullbackPushforwardAdjunction
    B.roundDown.suppIdeal.subschemeι).unit.app Dm.divisorialSheaf with hu
  -- The untwisted data: the inclusion `j : 𝒪_W(M_W) ⟶ 𝒪_W(M_W + S)`, `M_W = p^*(mD) + E - S`,
  -- has no higher direct images on either side, its direct image is the kernel inclusion of the
  -- restriction `u` to the floor, and after a large twist by `(fp)^* H` it is injective on `H¹`.
  obtain ⟨G₁, G₂, j, h₁, h₂, ⟨e₀⟩, d₀, hd₀⟩ : ∃ (G₁ G₂ : W.Modules) (j : G₁ ⟶ G₂),
      (∀ i : ℕ, 0 < i →
        Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj G₁)) ∧
      (∀ i : ℕ, 0 < i →
        Limits.IsZero (((Scheme.Modules.pushforward p).rightDerived i).obj G₂)) ∧
      Nonempty (Arrow.mk ((Scheme.Modules.pushforward p).map j) ≅ Arrow.mk (Limits.kernel.ι u)) ∧
      ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → Mono ((Hfunctor W.ringCatSheaf ⊤ 1).map
        ((tensorRightModules W ((Scheme.Modules.pullback p).obj ((Scheme.Modules.pullback f).obj
          (Stacks.Ample.tensorPowModule Z H d)))).map j)) := by
    haveI : IsProper p := hres.toIsLogResolution.isProper
    haveI : IsProper sX := isProper_of_isProjectiveMorphism sX
      (inferInstance : MMP.Mori.IsProjectiveVariety ℂ sX).isProjective
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
    haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace p
    -- the divisors on `W`: `S = p⁻¹_* ⌊B⌋`, `E = -⌊Δ_W - S⌋`, `D_m^W = p^* D_m`
    set S : MMP.Mori.Divisor W := MMP.Mori.inverseTransformDivisor p B.roundDown with hS
    set E : MMP.Mori.Divisor W :=
      -(ΔW - MMP.Mori.Divisor.toQDivisor S).roundDown with hE
    obtain ⟨DmW, hDmW⟩ := hDmC.exists_isPullback (f := p)
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant p Dm)
    have hS0 : 0 ≤ S := by
      refine MMP.Mori.DivisorWithCoeffs.mapPrimeDivisors_nonneg _ fun Q => ?_
      have h := (hdlt.2.1 Q).1
      show (0 : ℤ) ≤ ⌊B.coeff Q⌋
      exact Int.floor_nonneg.2 h
    set M₁ : MMP.Mori.Divisor W := DmW + E - S with hM₁
    -- the coefficients of `T`, `S`, `Δ_W`, `E` and of the fractional boundary `Θ₀ = {Δ_W - S}`
    set T : MMP.Mori.Divisor X := B.roundDown with hT
    have hPW : IsPairWith sX n K B := hdlt.isPairWith
    have hX : IsNormalVariety ℂ sX := hPW.1
    have hP : MMP.Mori.IsPair sX B := hdlt.isPair
    have hb := hres.toIsLogResolution.isBirationalMorphism
    have hbij := hb.functionFieldMap_bijective
    have hB01 : ∀ Q, 0 ≤ B.coeff Q ∧ B.coeff Q ≤ 1 := hdlt.2.1
    have hT01 : ∀ Q, T.coeff Q = 0 ∨ T.coeff Q = 1 := by
      intro Q
      have h := hB01 Q
      simp only [T, DivisorWithCoeffs.coeff_roundDown]
      rcases h.2.lt_or_eq with h1 | h1
      · left
        exact Int.floor_eq_iff.2 ⟨by simpa using h.1, by simpa using h1⟩
      · right
        rw [h1]
        simp
    have hTB : ∀ Q, T.coeff Q = 1 → B.coeff Q = 1 := by
      intro Q hQ
      simp only [T, DivisorWithCoeffs.coeff_roundDown, Int.floor_eq_iff] at hQ
      push_cast at hQ
      linarith [(hB01 Q).2]
    have hSc : ∀ (P : MMP.Mori.PrimeDivisor W) (Q : MMP.Mori.PrimeDivisor X),
        p P.genericPoint = Q.genericPoint → S.coeff P = T.coeff Q := fun P Q h =>
      coeff_inverseTransformDivisor_of_map_genericPoint p hb T h
    have hS2 : ∀ P : MMP.Mori.PrimeDivisor W, 2 ≤ Order.coheight (p P.genericPoint) →
        S.coeff P = 0 := fun P h => coeff_inverseTransformDivisor_of_two_le_coheight p T h
    have hΔc : ∀ (P : MMP.Mori.PrimeDivisor W) (Q : MMP.Mori.PrimeDivisor X),
        p P.genericPoint = Q.genericPoint → ΔW.coeff P = B.coeff Q := fun P Q h =>
      coeff_crepantBoundary_of_map_genericPoint hP hΔ h
    have hEc : ∀ P, E.coeff P = -⌊ΔW.coeff P - S.coeff P⌋ := fun P => by
      simp [E, DivisorWithCoeffs.coeff_neg, DivisorWithCoeffs.coeff_roundDown,
        DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor]
    haveI : MMP.Mori.IsVariety ℂ sX := hX.1
    haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
    haveI : LocallyOfFiniteType (p ≫ sX) := hW.1.toLocallyOfFiniteType
    have hsm : IsSmoothScheme (p ≫ sX) := hres.toIsLogResolution.isSmoothScheme
    have hproj := hres.isProjectiveMorphism
    obtain ⟨ω, hω0, hωK, hKW⟩ := exists_divisorOfForm_pullback_isCanonicalDivisor sX hX hW hsm hb
      hPW.2.1
    set KW := divisorOfForm (pullbackRationalPluriForms sX p ω) with hKWdef
    obtain ⟨m', hm', D, hD, hDc⟩ := hPW.2.2.exists_pos
    obtain ⟨hpb, -, -⟩ := MMP.Mori.IsPair.isPullback_of_isCrepantBoundary hP p hW hb hPW.2.1 hKW
      (Or.inl ⟨ω, hω0, hωK, rfl⟩) hΔ
    obtain ⟨DY, hDY, -, hB, hDYpb⟩ := hpb m' hm' D hD hDc
    -- the Cartier gap `C = m' D_m - D` on `X` and its pull-back `m' D_m^W - D_Y`
    have hCs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp p
      ((m' : ℤ) • Dm + (-1 : ℤ) • D)
    have hCμ := (hDmW.zsmul hDmC (m' : ℤ)
        (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp p _)).add
      (hDmC.zsmul _) (hDc.zsmul (-1)) hCs
      (hDYpb.zsmul hDc (-1) (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp p _))
    have hCc : ((m' : ℤ) • Dm + (-1 : ℤ) • D).IsCartier := (hDmC.zsmul _).add (hDc.zsmul (-1))
    set Θ₀ : QDivisor W := ΔW - Divisor.toQDivisor S + Divisor.toQDivisor E with hΘ₀
    have hΘc : ∀ P, Θ₀.coeff P = Int.fract (ΔW.coeff P - S.coeff P) := by
      intro P
      rw [hΘ₀, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor,
        Divisor.coeff_toQDivisor, hEc P, Int.fract]
      push_cast
      ring
    have hΘ0 : ∀ P, 0 ≤ Θ₀.coeff P := fun P => by rw [hΘc]; exact Int.fract_nonneg _
    have hΘ1 : ∀ P, Θ₀.coeff P < 1 := fun P => by rw [hΘc]; exact Int.fract_lt_one _
    have hexc := isExceptional_iff_two_le_coheight hX hW hb
    have hS01 : ∀ P, S.coeff P = 0 ∨ S.coeff P = 1 := by
      intro P
      rcases exists_map_genericPoint_eq_or_two_le_coheight p hbij.2 P with ⟨Q, h⟩ | h
      · rw [hSc P Q h]
        exact hT01 Q
      · exact Or.inl (hS2 P h)
    have hSex : ∀ P, S.coeff P ≠ 0 → ¬ RationalMap.IsExceptional (X := W) p.toRationalMap P :=
      fun P hP hE => hP (hS2 P ((hexc P).1 hE))
    have hSΘ : ∀ P, S.coeff P ≠ 0 → Θ₀.coeff P = 0 := by
      intro P hP
      rcases exists_map_genericPoint_eq_or_two_le_coheight p hbij.2 P with ⟨Q, h⟩ | h
