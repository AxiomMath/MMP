module

public import MMP.AlgebraicGeometry.MMP.BasepointFree.ProofData
public import MMP.AlgebraicGeometry.Intersection.ConeOfCurves.Relative
import MMP.AlgebraicGeometry.Resolution.BlowupSequence.PushforwardSmooth
import MMP.AlgebraicGeometry.Positivity.BaseLocusSum
import MMP.AlgebraicGeometry.MMP.Threefold.Canonical

/-!
# Log resolutions, base loci and round-ups in the proofs of the basepoint-free and rationality
theorems

This file collects auxiliary results from Chapters 2 and 3 of Kollár–Mori.

* **Composites of log resolutions.** If `g : X' ⟶ X` is a log resolution of `(X, Δ)`, `Δ'` is an
  `ℝ`-divisor on `X'` with `Ex(g) ∪ g⁻¹(Supp Δ) ⊆ Supp Δ'`, and `h : Y ⟶ X'` is a log resolution
  of `(X', Δ')`, then `h ≫ g` is a log resolution of `(X, Δ)`. The proof rests on
  `Ex(h ≫ g) = Ex(h) ∪ h⁻¹(Ex(g))`, on the fact that the union of a pure codimension one closed
  set `C₁` with the preimage of a pure codimension one closed set, under a map which is an open
  embedding off `C₁`, is again of pure codimension one, and on the fact that a closed subset of
  pure codimension one of an snc divisor is an snc divisor.
* **Stabilization of base loci.** For a divisor `D` on a Noetherian normal integral scheme,
  `Bs|n M| ⊆ Bs|M|` for `n ≥ 1`, so `u ↦ B(sᵘ) = Bs|sᵘ D|` is a decreasing chain of closed
  subsets of a Noetherian space; it is eventually equal to `B_s = ⋂_{u ≥ 1} B(sᵘ)`.
* **Coprime stable base loci.** If `s, s'` are coprime and `B_s = B_{s'} = ∅`, then
  `Bs|α D| = Bs|β D| = ∅` for powers `α = sᵘ`, `β = s'ᵛ`, which are coprime; every large `m` lies
  in the additive monoid generated by `α` and `β`, and `Bs|M₁ + M₂| ⊆ Bs|M₁| ∪ Bs|M₂|`, so `|m D|`
  is basepoint free for all large `m`.
* **Round-up of a klt boundary.** If `(X, -G)` is klt then `⌊-G⌋ ≤ 0`, so every coefficient of
  `G` is `> -1` and `⌈G⌉` is effective.
* **Relative freeness.** If `f : X ⟶ Y` is a proper morphism of varieties, `D` a Cartier divisor
  on `X` and `B'` a pull-back of a Cartier divisor `B` on `Y` with `𝒪_X(D + B')` globally
  generated, then `D` is `f`-free: the counit `f^* f_* 𝒪_X(D) ⟶ 𝒪_X(D)` is an epimorphism.
* **The test boundary of the rationality theorem.** For a tie-breaker `(j₀, c)` of a
  `(p, q)`-adapted resolution of a rationality datum, every coefficient `-c r_j + a_j - p_j` of
  the test boundary `A'` is `> -1`, and for a non-exceptional `F_j` the discrepancy `a_j` is minus
  a coefficient of the effective `Δ`; so `⌈A'⌉` is effective with `f`-exceptional components.

## Main results

* `MMP.Mori.IsLogResolution.comp`: the composite of log resolutions is a log resolution.
* `MMP.Mori.Divisor.exists_baseLocusOfMultiple_pow_eq_stableBaseLocusOfPowers`: there is
  `u₀ ≥ 1` with `B(sᵘ) = B_s` for all `u ≥ u₀`.
* `MMP.Mori.Divisor.exists_isBasepointFree_nsmul_of_coprime`: if `s` and `s'` are coprime and
  `B_s = B_{s'} = ∅`, then `|m D|` is basepoint free for every large `m`.
* `MMP.Mori.IsKltPair.neg_one_lt_coeff_and_isEffective_roundUp`: if `(X, -G)` is klt, the
  coefficients of `G` are `> -1` and `⌈G⌉` is effective.
* `MMP.Mori.isRelativelyFreeCartier_of_isGeneratedByGlobalSections_add_pullback`: if
  `𝒪_X(D + B')` is globally generated for a pull-back `B'` of `B` along `f`, then `D` is `f`-free.
* `MMP.Mori.IsStripTieBreaker.isEffective_roundUp_tieBreakerBoundary`: `⌈A'⌉` is effective and
  every prime divisor in its support is `f`-exceptional.

## Implementation notes

* In `IsLogResolution.comp`, `X` is a `k`-scheme with structure morphism `s_X`, and `X'`, `Y`
  carry the structure morphisms `g ≫ s_X` and `h ≫ g ≫ s_X`. The source assumes `X` normal; the
  statement holds without it, since the snc conditions are conditions on the smooth `X'` and `Y`.
* The base-locus results are stated for Weil divisors on Noetherian normal integral schemes and
  any `s, s' : ℕ`: the arguments use neither Cartierness nor properness beyond
  quasi-compactness.
* The pull-back `f^* B` is a Cartier divisor `B'` on `X` with `MMP.Intersection.IsPullback f B B'`.
  Instead of the projection formula `f_*(𝒪_X(D) ⊗ f^* 𝒪_Y(B)) ≅ f_* 𝒪_X(D) ⊗ 𝒪_Y(B)`, the
  argument is carried out on sections: a morphism `g : 𝒪_X(D) ⟶ Q` killed by the counit kills
  every section over a preimage `f⁻¹ V`; the sections `t` of `𝒪_X(D + B')` with `g(t φ) = 0` for
  every local equation `φ` of `B'` form a sub-sheaf of modules containing the global sections,
  hence everything, and so `g = 0`.
* The discrepancy of a non-exceptional divisor `(Y, f, E)` over `X` is computed with no
  hypothesis on the base field: the valuation of `E` is that of a prime divisor `P` of `X`, the
  local rings `𝒪_{X,P}` and `𝒪_{Y,E}` are then isomorphic compatibly with `k(X) ≅ k(Y)`, and
  the order of a pluri-canonical form is invariant under such an isomorphism.

## References

* [KollarMori] J. Kollár, S. Mori, *Birational geometry of algebraic varieties*, Chapter 2;
  3.2 (Step 2), 3.5 (Steps 1, 8 and 10), 3.26.
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace Topology

universe u

namespace MMP.Mori

/-! ### Composites of log resolutions -/

section CompositeLogResolution

section Topology

variable {A T : Type*} [TopologicalSpace A] [TopologicalSpace T] {ψ : A → T}

/-- The closure of the image of an irreducible closed subset under an open embedding. -/
private def closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    IrreducibleCloseds T :=
  ⟨closure (ψ '' Z), (Z.isIrreducible.image ψ hψ.continuous.continuousOn).closure,
    isClosed_closure⟩

/-- The preimage of an irreducible closed subset meeting the image of an open embedding. -/
private def preimageIrr (hψ : IsOpenEmbedding ψ) (B : IrreducibleCloseds T)
    (hne : ((B : Set T) ∩ Set.range ψ).Nonempty) : IrreducibleCloseds A :=
  ⟨ψ ⁻¹' B, B.isIrreducible.preimage hψ hne, B.isClosed.preimage hψ.continuous⟩

private lemma preimage_closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    ψ ⁻¹' (closureImage hψ Z : Set T) = Z := by
  change ψ ⁻¹' closure (ψ '' Z) = Z
  rw [← hψ.isInducing.closure_eq_preimage_closure_image, Z.isClosed.closure_eq]

private lemma closureImage_preimageIrr (hψ : IsOpenEmbedding ψ) (B : IrreducibleCloseds T)
    (hne : ((B : Set T) ∩ Set.range ψ).Nonempty) :
    closureImage hψ (preimageIrr hψ B hne) = B := by
  have hne' : (ψ ⁻¹' B).Nonempty := by obtain ⟨_, hb, x, rfl⟩ := hne; exact ⟨x, hb⟩
  exact SetLike.coe_injective <| closure_image_preimage_of_isPreirreducible ψ hψ.isOpenMap B
    hne' B.isIrreducible.isPreirreducible B.isClosed

/-- Taking closures of images along an open embedding preserves codimension. -/
private lemma codimension_closureImage (hψ : IsOpenEmbedding ψ) (Z : IrreducibleCloseds A) :
    codimension (closureImage hψ Z) = codimension Z := by
  rw [codimension_eq_coheight, codimension_eq_coheight]
  have hmono : StrictMono (closureImage hψ) := fun a b hab ↦
    lt_of_le_of_ne (closure_mono (Set.image_mono hab.le)) fun h ↦ hab.ne <|
      SetLike.coe_injective <| by
        simpa only [preimage_closureImage] using
          congrArg (fun W : IrreducibleCloseds T ↦ ψ ⁻¹' (W : Set T)) h
  refine (Order.coheight_eq_of_strictMono _ hmono (fun a B hab ↦ ?_) Z).symm
  have hne : ((B : Set T) ∩ Set.range ψ).Nonempty := by
    obtain ⟨x, hx⟩ := a.isIrreducible.nonempty
    exact ⟨ψ x, hab.le (subset_closure ⟨x, hx, rfl⟩), x, rfl⟩
  refine ⟨preimageIrr hψ B hne, lt_of_le_of_ne (fun x hx ↦ hab.le (subset_closure ⟨x, hx, rfl⟩))
    ?_, closureImage_preimageIrr hψ B hne⟩
  rintro rfl
  exact hab.ne (closureImage_preimageIrr hψ B hne)

end Topology

private lemma isPreirreducible_preimage_val {Y : Type*} [TopologicalSpace Y] {C W : Set Y}
    (hW : IsPreirreducible W) (hWC : W ⊆ C) : IsPreirreducible (Subtype.val ⁻¹' W : Set C) := by
  rintro u v hu hv ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  obtain ⟨u', hu', rfl⟩ := isOpen_induced_iff.mp hu
  obtain ⟨v', hv', rfl⟩ := isOpen_induced_iff.mp hv
  obtain ⟨y, hyW, hyu, hyv⟩ := hW u' v' hu' hv' ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  exact ⟨⟨y, hWC hyW⟩, hyW, hyu, hyv⟩

/-- An irreducible closed set contained in a closed set lies in an irreducible closed subset
maximal in it. -/
private lemma exists_maximal_ge {Y : Type*} [TopologicalSpace Y] {C : Set Y} (hC : IsClosed C)
    (Z : IrreducibleCloseds Y) (hZ : (Z : Set Y) ⊆ C) :
    ∃ W : IrreducibleCloseds Y, Maximal (fun W' : IrreducibleCloseds Y ↦ (W' : Set Y) ⊆ C) W ∧
      Z ≤ W := by
  obtain ⟨t, ht, hxt, hmax⟩ := exists_preirreducible (Subtype.val ⁻¹' (Z : Set Y) : Set C)
    (isPreirreducible_preimage_val Z.isIrreducible.isPreirreducible hZ)
  obtain ⟨z, hz⟩ := Z.isIrreducible.nonempty
  let W : IrreducibleCloseds Y := ⟨closure (Subtype.val '' t),
    (IsIrreducible.closure ⟨⟨z, ⟨z, hZ hz⟩, hxt hz, rfl⟩,
      ht.image _ continuous_subtype_val.continuousOn⟩), isClosed_closure⟩
  have hWC : (W : Set Y) ⊆ C := closure_minimal (Set.image_subset_iff.mpr fun y _ ↦ y.2) hC
  refine ⟨W, ⟨hWC, fun W' hW'C hWW' y hy ↦ ?_⟩, fun y hy ↦ subset_closure ⟨⟨y, hZ hy⟩, hxt hy, rfl⟩⟩
  have := hmax _ (isPreirreducible_preimage_val W'.isIrreducible.isPreirreducible hW'C)
    fun y hy ↦ hWW' (subset_closure ⟨y, hy, rfl⟩)
  have : (⟨y, hW'C hy⟩ : C) ∈ t := by rwa [← this]
  exact subset_closure ⟨_, this, rfl⟩

/-- If `C₁ ⊆ Y` is closed of pure codimension one, `h` is an open embedding on the complement
`U` of `C₁`, and `T` is closed of pure codimension one, then so is `C₁ ∪ h⁻¹(T)`. -/
private lemma isPureCodimOne_sup_preimage {Y X' : Type*} [TopologicalSpace Y]
    [TopologicalSpace X'] {h : Y → X'} (hh : Continuous h) {U : Set Y} (hU : IsOpen U)
    (hψ : IsOpenEmbedding (U.restrict h)) {C₁ : Closeds Y} (hUC : Uᶜ ⊆ C₁)
    (hC₁ : IsPureCodimOne C₁) {T : Closeds X'} (hT : IsPureCodimOne T) :
    IsPureCodimOne (C₁ ⊔ T.preimage hh) := by
  intro W hW
  have hWsub : (W : Set Y) ⊆ (C₁ : Set Y) ∪ h ⁻¹' T := hW.1
  by_cases hWC : (W : Set Y) ⊆ C₁
  · exact hC₁ W ⟨hWC, fun W' hW' hle ↦ hW.2 (hW'.trans fun y hy ↦ Or.inl hy) hle⟩
  obtain ⟨w, hwW, hwC⟩ := Set.not_subset.mp hWC
  have hwU : w ∈ U := of_not_not fun hw ↦ hwC (hUC hw)
  have hWT : (W : Set Y) ⊆ h ⁻¹' T :=
    ((isPreirreducible_iff_isClosed_union_isClosed.mp W.isIrreducible.isPreirreducible)
      _ _ C₁.isClosed (T.isClosed.preimage hh) hWsub).resolve_left hWC
  have hι : IsOpenEmbedding (Subtype.val : U → Y) := hU.isOpenEmbedding_subtypeVal
  let WU := preimageIrr hι W ⟨w, hwW, ⟨w, hwU⟩, rfl⟩
  have hWU : closureImage hι WU = W := closureImage_preimageIrr hι W _
  let Z := closureImage hψ WU
  have hZmax : Maximal (fun Z' : IrreducibleCloseds X' ↦ (Z' : Set X') ⊆ T) Z := by
    refine ⟨closure_minimal (Set.image_subset_iff.mpr fun _ hu ↦ hWT hu) T.isClosed,
      fun Z' hZ'T hZZ' ↦ ?_⟩
    let ZU := preimageIrr hψ Z'
      ⟨h w, hZZ' (subset_closure ⟨⟨w, hwU⟩, hwW, rfl⟩), ⟨w, hwU⟩, rfl⟩
    have hW'sub : (closureImage hι ZU : Set Y) ⊆ (C₁ : Set Y) ∪ h ⁻¹' T :=
      (closure_minimal (by rintro _ ⟨u, hu, rfl⟩; exact hZ'T hu)
        (T.isClosed.preimage hh)).trans fun y hy ↦ Or.inr hy
    have hle : W ≤ closureImage hι ZU := by
      rw [← hWU]
      exact closure_mono (Set.image_mono fun u hu ↦ hZZ' (subset_closure ⟨u, hu, rfl⟩))
    rw [← closureImage_preimageIrr hψ Z' _]
    refine closure_mono (Set.image_mono fun u hu ↦ hW.2 hW'sub hle ?_)
    change u ∈ Subtype.val ⁻¹' (closureImage hι ZU : Set Y)
    rwa [preimage_closureImage]
  rw [← hWU, codimension_closureImage hι WU, ← codimension_closureImage hψ WU]
  exact hT Z hZmax

section SNC

/-- The support of a prime divisor, as an irreducible closed subset. -/
private noncomputable def primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    IrreducibleCloseds X :=
  IrreducibleCloseds.closureSingleton E.genericPoint

private lemma coe_primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    (primeIrr E : Set X) = E.support := by
  rw [E.support_eq_closure]; rfl

private lemma codimension_primeIrr {X : Scheme.{u}} (E : AlgebraicGeometry.PrimeDivisor X) :
    codimension (primeIrr E) = 1 := E.codimension_one

private lemma exists_mem_of_subset_iUnion {X : Scheme.{u}}
    {s : Finset (AlgebraicGeometry.PrimeDivisor X)}
    (W : IrreducibleCloseds X) (hW : (W : Set X) ⊆ ⋃ E ∈ s, E.support) :
    ∃ E ∈ s, W ≤ primeIrr E := by
  classical
  obtain ⟨z, hz, hWz⟩ := (isIrreducible_iff_sUnion_isClosed.mp W.isIrreducible)
    (s.image AlgebraicGeometry.PrimeDivisor.support)
    (by
      intro z hz
      obtain ⟨E, -, rfl⟩ := Finset.mem_image.mp hz
      rw [← coe_primeIrr]; exact (primeIrr E).isClosed)
    (by
      intro x hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.mp (hW hx)
      exact ⟨E.support, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hE), hxE⟩)
  obtain ⟨E, hE, rfl⟩ := Finset.mem_image.mp hz
  exact ⟨E, hE, fun x hx ↦ by
    change x ∈ (primeIrr E : Set X); rw [coe_primeIrr]; exact hWz hx⟩

variable {k : Type u} [Field k]

/-- An snc divisor is of pure codimension one. -/
private lemma isPureCodimOne_of_isSNCSubset {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {S : Closeds X}
    (hS : IsSNCSubset sX S) : IsPureCodimOne S := by
  intro W hW
  rcases hS with rfl | ⟨s, hs, -⟩
  · obtain ⟨x, hx⟩ := W.isIrreducible.nonempty
    exact absurd (hW.1 hx) (by simp)
  obtain ⟨E, hE, hWE⟩ := exists_mem_of_subset_iUnion W (hs ▸ hW.1)
  have hEW : primeIrr E ≤ W := hW.2 (by
    intro x hx
    rw [← hs]
    rw [coe_primeIrr] at hx
    exact Set.mem_iUnion₂.mpr ⟨E, hE, hx⟩) hWE
  rw [le_antisymm hWE hEW, codimension_primeIrr]

/-- A closed subset of pure codimension one of an snc divisor is an snc divisor. -/
private lemma isSNCSubset_of_le {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {S C : Closeds X}
    (hS : IsSNCSubset sX S) (hC : IsPureCodimOne C) (hCS : C ≤ S) : IsSNCSubset sX C := by
  classical
  rcases hS with rfl | ⟨s, hs, hsnc⟩
  · exact Or.inl (le_bot_iff.mp hCS)
  right
  refine ⟨s.filter (fun E ↦ E.support ⊆ C), ?_, ?_⟩
  · apply subset_antisymm
    · exact Set.iUnion₂_subset fun E hE ↦ (Finset.mem_filter.mp hE).2
    · intro x hx
      obtain ⟨W, hW, hxW⟩ := exists_maximal_ge C.isClosed
        (IrreducibleCloseds.closureSingleton x) (by
          change closure {x} ⊆ (C : Set X)
          exact closure_minimal (by simpa using hx) C.isClosed)
      have hxW' : x ∈ (W : Set X) := hxW (subset_closure rfl)
      obtain ⟨E, hE, hWE⟩ := exists_mem_of_subset_iUnion W (hs ▸ hW.1.trans hCS)
      have hWE' : W = primeIrr E := by
        by_contra hne
        have hlt : W < primeIrr E := lt_of_le_of_ne hWE hne
        have := Order.coheight_add_one_le hlt
        rw [← codimension_eq_coheight, ← codimension_eq_coheight, codimension_primeIrr,
          hC W hW] at this
        exact absurd this (by decide)
      refine Set.mem_iUnion₂.mpr ⟨E, Finset.mem_filter.mpr ⟨hE, ?_⟩, ?_⟩
      · rw [← coe_primeIrr, ← hWE']
        exact hW.1
      · rwa [← coe_primeIrr, ← hWE']
  · refine hsnc.of_support_subset ?_
    intro E hE
    rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply] at hE ⊢
    simp only [Finsupp.single_apply] at hE ⊢
    rw [Finset.sum_ite_eq'] at hE ⊢
    split_ifs at hE with h1
    · rw [if_pos (Finset.mem_filter.mp h1).1]; exact one_ne_zero
    · exact absurd rfl hE

end SNC

section Exceptional

/-- If `a ≫ b` is an isomorphism, `a` is dominant, the source of `b` is reduced and `b` is
separated, then `b` is an isomorphism. -/
private lemma isIso_of_isIso_comp {A B V : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ V) [IsIso (a ≫ b)]
    [IsDominant a] [IsReduced B] [IsSeparated b] : IsIso b := by
  refine ⟨⟨inv (a ≫ b) ≫ a, ?_, by simp⟩⟩
  refine ext_of_isDominant_of_isSeparated b ?_ a ?_
  · simp
  · rw [← Category.assoc, IsIso.hom_inv_id_assoc, Category.comp_id]

/-- If `h ≫ g` is an isomorphism over `V`, with `h` dominant, `X'` reduced and `g` separated,
then `g` is an isomorphism over `V` and `h` over `g⁻¹(V)`. -/
private lemma isBiregular_of_isBiregular_comp {Y X' X : Scheme.{u}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsDominant h] [IsReduced X'] [IsSeparated g] {V : X.Opens}
    (hV : IsBiregular (h ≫ g) V) : IsBiregular g V ∧ IsBiregular h (g ⁻¹ᵁ V) := by
  unfold IsBiregular at hV ⊢
  rw [morphismRestrict_comp] at hV
  have : IsDominant (h ∣_ g ⁻¹ᵁ V) := IsZariskiLocalAtTarget.restrict ‹IsDominant h› _
  have : IsSeparated (g ∣_ V) := IsZariskiLocalAtTarget.restrict ‹IsSeparated g› _
  have := @isIso_of_isIso_comp _ _ _ (h ∣_ g ⁻¹ᵁ V) (g ∣_ V) hV _ _ _
  exact ⟨this, @IsIso.of_isIso_comp_right _ _ _ _ _ _ (g ∣_ V) this hV⟩

/-- The exceptional set of a composite. -/
private lemma exceptionalSet_comp {Y X' X : Scheme.{u}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsDominant h] [IsReduced X'] [IsSeparated g] [UniversallyClosed g] :
    exceptionalSet (h ≫ g) = exceptionalSet h ⊔ (exceptionalSet g).preimage h.continuous := by
  apply SetLike.coe_injective
  ext y
  change y ∈ exceptionalSet (h ≫ g) ↔ y ∈ exceptionalSet h ∨ h y ∈ exceptionalSet g
  simp only [mem_exceptionalSet]
  constructor
  · intro hy
    by_contra hne
    push Not at hne
    obtain ⟨hyh, hyg⟩ := hne
    apply hy
    have hcl : IsClosed (g '' (biregularLocus h : Set X')ᶜ) :=
      g.isClosedMap _ (biregularLocus h).isOpen.isClosed_compl
    let W : X.Opens := biregularLocus g ⊓ ⟨_, hcl.isOpen_compl⟩
    have hWg : IsBiregular g W :=
      isBiregular_iff_le_biregularLocus.mpr inf_le_left
    have hWh : IsBiregular h (g ⁻¹ᵁ W) := by
      refine isBiregular_iff_le_biregularLocus.mpr ?_
      intro x hx
      by_contra hxU
      exact hx.2 ⟨x, hxU, rfl⟩
    have hiso : IsBiregular (h ≫ g) W := by
      unfold IsBiregular at *
      rw [morphismRestrict_comp]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ hWh hWg
    refine le_biregularLocus hiso ⟨hyg, ?_⟩
    rintro ⟨x, hx, hxy⟩
    have : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
    have hxy' : g x = g (h y) := hxy.trans (Scheme.Hom.comp_apply h g y)
    have hx' : g x ∈ biregularLocus g := hxy' ▸ hyg
    have hinj := (g ∣_ biregularLocus g).isOpenEmbedding.injective
      (a₁ := (⟨x, hx'⟩ : g ⁻¹ᵁ biregularLocus g)) (a₂ := ⟨h y, hyg⟩)
    have : x = h y := congrArg Subtype.val (hinj (Subtype.ext
      ((morphismRestrict_base_coe g _ _).trans (hxy'.trans
        (morphismRestrict_base_coe g (biregularLocus g) ⟨h y, hyg⟩).symm))))
    exact hx (this ▸ hyh)
  · intro hy hmem
    have hb := isBiregular_of_isBiregular_comp h g (isBiregular_biregularLocus (h ≫ g))
    rcases hy with hy | hy
    · exact hy (le_biregularLocus hb.2 hmem)
    · exact hy (le_biregularLocus hb.1 hmem)

end Exceptional

section Birational

/-- A birational morphism is an open immersion with dense image on a dense open subset. -/
private lemma exists_of_isBirationalMorphism {X Y : Scheme.{u}} {f : X ⟶ Y}
    (hf : IsBirationalMorphism f) :
    ∃ S : X.Opens, Dense (S : Set X) ∧ IsOpenImmersion (S.ι ≫ f) ∧ IsDominant (S.ι ≫ f) := by
  obtain ⟨e, he⟩ := hf
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff] at he
  obtain ⟨W, hW, hWe, hWf, h⟩ := he
  have hWe' : W ≤ e.source := hWe
  have heq : W.ι ≫ f = X.homOfLE hWe' ≫ e.iso.hom ≫ e.target.ι := by
    simp only [Scheme.PartialMap.restrict, Scheme.PartialMap.mk.injEq, heq_eq_eq, true_and,
      Scheme.PartialIso.toPartialMap_hom, Scheme.Hom.toPartialMap_hom] at h
    rw [Scheme.topIso_hom] at h
    exact (Scheme.homOfLE_ι_assoc X (le_top : W ≤ ⊤) f).symm.trans h.symm
  have h₁ : IsDominant (X.homOfLE hWe') := by
    have : IsDominant (X.homOfLE hWe' ≫ e.source.ι) := by
      rw [Scheme.homOfLE_ι]; exact Opens.isDominant_ι hW
    exact IsDominant.of_comp_of_isOpenImmersion (X.homOfLE hWe') e.source.ι
  refine ⟨W, hW, ?_, ?_⟩
  · rw [heq]; infer_instance
  · rw [heq]
    have := Opens.isDominant_ι e.dense_target
    infer_instance

/-- A morphism which is an open immersion with dense image on a dense open is birational. -/
private lemma isBirationalMorphism_of_exists {X Y : Scheme.{u}} (f : X ⟶ Y) (S : X.Opens)
    (hS : Dense (S : Set X)) [IsOpenImmersion (S.ι ≫ f)] (hd : IsDominant (S.ι ≫ f)) :
    IsBirationalMorphism f := by
  let e : X.PartialIso Y :=
    { source := S
      dense_source := hS
      target := (S.ι ≫ f).opensRange
      dense_target := by
        rw [Scheme.Hom.coe_opensRange]
        exact (hd.denseRange : _)
      iso := (S.ι ≫ f).isoOpensRange }
  refine ⟨e, ?_⟩
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨S, hS, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialIso.toPartialMap_hom,
    Scheme.Hom.toPartialMap_hom, e, Scheme.Hom.isoOpensRange_hom_ι]
  rw [Scheme.topIso_hom]
  exact (Scheme.homOfLE_ι_assoc _ _ _).trans (Scheme.homOfLE_ι_assoc _ _ _).symm

/-- A composite of birational morphisms is birational. -/
private lemma isBirationalMorphism_comp {Y X' X : Scheme.{u}} {h : Y ⟶ X'} {g : X' ⟶ X}
    (hh : IsBirationalMorphism h) (hg : IsBirationalMorphism g) :
    IsBirationalMorphism (h ≫ g) := by
  obtain ⟨Sh, hSh, hoh, hdh⟩ := exists_of_isBirationalMorphism hh
  obtain ⟨Sg, hSg, hog, hdg⟩ := exists_of_isBirationalMorphism hg
  let S : Y.Opens := Sh ⊓ h ⁻¹ᵁ Sg
  have hSS : S ≤ Sh := inf_le_left
  have hle : S ≤ h ⁻¹ᵁ Sg := inf_le_right
  have hres : h.resLE Sg S hle ≫ Sg.ι = Y.homOfLE hSS ≫ Sh.ι ≫ h := by
    rw [Scheme.Hom.resLE_comp_ι, Scheme.homOfLE_ι_assoc]
  have : IsOpenImmersion (h.resLE Sg S hle ≫ Sg.ι) := by rw [hres]; infer_instance
  have : IsOpenImmersion (h.resLE Sg S hle) := IsOpenImmersion.of_comp _ Sg.ι
  let R : Set X' := Set.range (Sh.ι ≫ h)
  have hRo : IsOpen R := (Sh.ι ≫ h).isOpenEmbedding.isOpenMap.isOpen_range
  have hRd : Dense R := hdh.denseRange
  have hdres : IsDominant (h.resLE Sg S hle) := by
    have : IsDominant (h.resLE Sg S hle ≫ Sg.ι) := by
      refine ⟨(hRd.inter_of_isOpen_left hSg hRo).mono ?_⟩
      rintro x ⟨⟨y, rfl⟩, hx⟩
      refine ⟨⟨(Sh.ι y), y.2, ?_⟩, ?_⟩
      · exact hx
      · rw [Scheme.Hom.resLE_comp_ι]
        rfl
    exact IsDominant.of_comp_of_isOpenImmersion _ Sg.ι
  have hcomp : S.ι ≫ h ≫ g = h.resLE Sg S hle ≫ Sg.ι ≫ g := by
    rw [← Category.assoc, ← Scheme.Hom.resLE_comp_ι, Category.assoc]
  have hSd : Dense (S : Set Y) := by
    have h1 : Dense ((Sh.ι ≫ h) ⁻¹' (Sg : Set X')) := hSg.preimage
      (Sh.ι ≫ h).isOpenEmbedding.isOpenMap
    have h2 := (Opens.isDominant_ι hSh).denseRange.dense_image Sh.ι.continuous h1
    refine h2.mono ?_
    rintro _ ⟨y, hy, rfl⟩
    exact ⟨y.2, hy⟩
  have : IsOpenImmersion (S.ι ≫ h ≫ g) := by rw [hcomp]; infer_instance
  exact isBirationalMorphism_of_exists (h ≫ g) S hSd (by rw [hcomp]; infer_instance)

end Birational

section Main

private lemma isReduced_of_isSmoothScheme {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} (hX : IsSmoothScheme sX) : IsReduced X := by
  have : Smooth sX := hX.smooth
  have stalk_isReduced (x : X) : _root_.IsReduced (X.presheaf.stalk x) := by
    have := isRegularLocalRing_stalk_of_smooth_over_field sX x
    have : IsDomain (X.presheaf.stalk x) := IsRegularLocalRing.isDomain _
    exact @isReduced_of_noZeroDivisors _ _ (IsDomain.to_noZeroDivisors _)
  exact isReduced_of_isReduced_stalk X

private lemma isOpenEmbedding_restrict_biregularLocus {Y X' : Scheme.{u}} (h : Y ⟶ X') :
    Topology.IsOpenEmbedding ((h ⁻¹ᵁ biregularLocus h : Set Y).restrict h) := by
  have : IsIso (h ∣_ biregularLocus h) := isBiregular_biregularLocus h
  have heq : (h ⁻¹ᵁ biregularLocus h : Set Y).restrict h =
      Subtype.val ∘ (h ∣_ biregularLocus h) :=
    funext fun x ↦ (morphismRestrict_base_coe h (biregularLocus h) x).symm
  rw [heq]
  exact (biregularLocus h).isOpen.isOpenEmbedding_subtypeVal.comp
    (h ∣_ biregularLocus h).isOpenEmbedding

end Main

/-- Let `g : X' ⟶ X` be a log resolution of `(X, Δ)`, `Δ'` an `ℝ`-divisor on `X'` with
`Ex(g) ∪ g⁻¹(Supp Δ) ⊆ Supp Δ'`, and `h : Y ⟶ X'` a log resolution of `(X', Δ')`. Then
`g ∘ h` is a log resolution of `(X, Δ)`. -/
@[mmp "lem_km2c_composite_log_resolution"]
public theorem IsLogResolution.comp {k : Type u} [Field k] {X X' Y : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} {Δ : RDivisor X} {g : X' ⟶ X} (hg : IsLogResolution sX Δ g)
    {Δ' : RDivisor X'}
    (hΔ' : exceptionalSet g ⊔ Δ.supp.preimage g.continuous ≤ Δ'.supp)
    {h : Y ⟶ X'} (hh : IsLogResolution (g ≫ sX) Δ' h) :
    IsLogResolution sX Δ (h ≫ g) := by
  have : IsProper g := hg.isProper
  have : IsProper h := hh.isProper
  have : IsReduced X' := isReduced_of_isSmoothScheme hg.isSmoothScheme
  have : IsDominant h := by
    obtain ⟨S, -, -, hd⟩ := exists_of_isBirationalMorphism hh.isBirationalMorphism
    exact IsDominant.of_comp S.ι h
  have key {T : Closeds X'} (hT : IsPureCodimOne T) :
      IsPureCodimOne (exceptionalSet h ⊔ T.preimage h.continuous) :=
    isPureCodimOne_sup_preimage h.continuous (h ⁻¹ᵁ biregularLocus h).isOpen
      (isOpenEmbedding_restrict_biregularLocus h) (fun _ hy ↦ hy)
      hh.isPureCodimOne_exceptionalSet hT
  refine ⟨⟨inferInstance, isBirationalMorphism_comp hh.isBirationalMorphism
    hg.isBirationalMorphism, by rw [Category.assoc]; exact hh.isSmoothScheme⟩, ?_, ?_⟩
  · rw [exceptionalSet_comp]
    exact key hg.isPureCodimOne_exceptionalSet
  · have heq : exceptionalSet (h ≫ g) ⊔ Δ.supp.preimage (h ≫ g).continuous =
        exceptionalSet h ⊔
          (exceptionalSet g ⊔ Δ.supp.preimage g.continuous).preimage h.continuous := by
      rw [exceptionalSet_comp]
      apply SetLike.coe_injective
      ext y
      change (y ∈ exceptionalSet h ∨ h y ∈ exceptionalSet g) ∨ (h ≫ g) y ∈ Δ.supp ↔
        y ∈ exceptionalSet h ∨ (h y ∈ exceptionalSet g ∨ g (h y) ∈ Δ.supp)
      rw [Scheme.Hom.comp_apply, or_assoc]
    rw [heq, Category.assoc]
    exact isSNCSubset_of_le hh.isSNCSubset
      (key (isPureCodimOne_of_isSNCSubset hg.isSNCSubset))
      (sup_le_sup_left (fun y hy ↦ hΔ' hy) _)

end CompositeLogResolution

/-! ### Stabilization of base loci and freeness of large multiples -/

section BaseLoci

/-- `Bs|n M| ⊆ Bs|M|` for `n ≥ 1`. -/
private theorem baseLocus_nsmul_le {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] [IsIntegral X] (M : MMP.Mori.Divisor X) :
    ∀ n : ℕ, 1 ≤ n → MMP.Mori.Divisor.baseLocus (n • M) ≤ MMP.Mori.Divisor.baseLocus M := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => simp
  | succ n _ ih =>
    rw [succ_nsmul]
    exact (MMP.Positivity.baseLocus_add_le _ _).trans (sup_le ih le_rfl)

/-- The base loci `Bs|s^(n+1) D|` form a decreasing chain in `n`. -/
private theorem antitone_baseLocusOfMultiple_pow_succ {X : Scheme.{u}} [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [IsIntegral X] (D : MMP.Mori.Divisor X) (s : ℕ) :
    Antitone fun n : ℕ => MMP.Mori.Divisor.baseLocusOfMultiple D (s ^ (n + 1)) := by
  refine antitone_nat_of_succ_le fun n => ?_
  rcases Nat.eq_zero_or_pos s with rfl | hs
  · simp [MMP.Mori.Divisor.baseLocusOfMultiple]
  · simpa only [MMP.Mori.Divisor.baseLocusOfMultiple, pow_succ' s (n + 1), mul_smul] using
      baseLocus_nsmul_le _ s hs

namespace Divisor

/-- **KM 3.2, Step 2.** For a divisor `D` on a Noetherian normal integral scheme and `s : ℕ`, the
base loci `B(sᵘ)` stabilize: there is `u₀ ≥ 1` with `B(sᵘ) = B_s` for every `u ≥ u₀`. -/
@[mmp "lem_km3a_bpf_base_loci_stabilize"]
public theorem exists_baseLocusOfMultiple_pow_eq_stableBaseLocusOfPowers
    {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral X]
    (D : Divisor X) (s : ℕ) :
    ∃ u₀ : ℕ, 1 ≤ u₀ ∧ ∀ u : ℕ, u₀ ≤ u →
      D.baseLocusOfMultiple (s ^ u) = D.stableBaseLocusOfPowers s := by
  have : IsNoetherian X := ⟨⟩
  have hf := antitone_baseLocusOfMultiple_pow_succ D s
  obtain ⟨N, hN⟩ := WellFoundedLT.antitone_chain_condition hf
  have hstab : MMP.Mori.Divisor.stableBaseLocusOfPowers D s =
      MMP.Mori.Divisor.baseLocusOfMultiple D (s ^ (N + 1)) := by
    refine le_antisymm (MMP.Mori.Divisor.stableBaseLocusOfPowers_le D s (by omega)) ?_
    refine le_iInf₂ fun v hv => ?_
    obtain ⟨m, rfl⟩ : ∃ m, v = m + 1 := ⟨v - 1, by omega⟩
    rcases le_total N m with h | h
    · exact (hN m h).le
    · exact hf h
  refine ⟨N + 1, by omega, fun v hv => ?_⟩
  obtain ⟨m, rfl⟩ : ∃ m, v = m + 1 := ⟨v - 1, by omega⟩
  exact hstab ▸ (hN m (by omega)).symm

end Divisor

/-- The submonoid of `ℕ` generated by two coprime numbers contains all large integers. -/
private theorem eventually_mem_closure_pair {a b : ℕ} (hab : a.Coprime b) :
    ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m → m ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
  have one_mem {c : ℕ} (hc : c = 1) (h : c ∈ ({a, b} : Set ℕ)) :
      ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m → m ∈ AddSubmonoid.closure ({a, b} : Set ℕ) := by
    subst hc
    refine ⟨0, fun m _ => ?_⟩
    simpa using nsmul_mem (AddSubmonoid.subset_closure h) m
  rcases Nat.lt_or_ge 1 a with ha | ha
  · rcases Nat.lt_or_ge 1 b with hb | hb
    · refine ⟨a * b - a - b + 1, fun m hm => ?_⟩
      by_contra hc
      have := (frobeniusNumber_pair hab ha hb).2 hc
      omega
    · interval_cases b
      · exact absurd (Nat.coprime_zero_right a |>.mp hab) (by omega)
      · exact one_mem rfl (by simp)
  · interval_cases a
    · exact one_mem ((Nat.coprime_zero_left b).mp hab) (by simp)
    · exact one_mem rfl (by simp)

/-- The multiples `n` with `n = 0` or `|n D|` free form an additive submonoid. -/
private theorem free_of_mem_closure {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] [IsIntegral X] (D : MMP.Mori.Divisor X) (S : Set ℕ)
    (hS : ∀ a ∈ S, (a • D).baseLocus = ⊥) {n : ℕ} (hn : n ∈ AddSubmonoid.closure S) :
    n = 0 ∨ (n • D).baseLocus = ⊥ := by
  induction hn using AddSubmonoid.closure_induction with
  | mem a ha => exact .inr (hS a ha)
  | zero => exact .inl rfl
  | add a b _ _ ha hb =>
    rcases ha with rfl | ha
    · simpa using hb
    rcases hb with rfl | hb
    · simpa using Or.inr ha
    refine .inr (eq_bot_iff.mpr ?_)
    rw [add_smul]
    exact (MMP.Positivity.baseLocus_add_le _ _).trans (by rw [ha, hb, sup_bot_eq])

/-- An empty stable base locus `B_s` is attained by a single power: `Bs|sᵘ D| = ∅`. -/
private theorem free_pow {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] [IsIntegral X] (D : MMP.Mori.Divisor X) {s : ℕ}
    (hs : D.stableBaseLocusOfPowers s = ⊥) : ∃ u : ℕ, ((s ^ u) • D).baseLocus = ⊥ := by
  obtain ⟨u₀, -, h⟩ :=
    MMP.Mori.Divisor.exists_baseLocusOfMultiple_pow_eq_stableBaseLocusOfPowers D s
  exact ⟨u₀, (h u₀ le_rfl).trans hs⟩

namespace Divisor

/-- **KM 3.2, Step 2.** If `s` and `s'` are coprime and the stable base loci `B_s` and `B_{s'}`
of a divisor `D` on a Noetherian normal integral scheme are empty, then `|m D|` is basepoint
free for every sufficiently large `m`. -/
@[mmp "lem_km3a_bpf_coprime_free"]
public theorem exists_isBasepointFree_nsmul_of_coprime
    {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral X]
    (D : Divisor X) {s s' : ℕ} (hss' : s.Coprime s')
    (hs : D.stableBaseLocusOfPowers s = ⊥) (hs' : D.stableBaseLocusOfPowers s' = ⊥) :
    ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m → (m • D).IsBasepointFree := by
  obtain ⟨u, hα⟩ := free_pow D hs
  obtain ⟨v, hβ⟩ := free_pow D hs'
  obtain ⟨m₀, hm₀⟩ := eventually_mem_closure_pair (hss'.pow u v)
  refine ⟨m₀ + 1, fun m hm => (free_of_mem_closure D _ ?_ (hm₀ m (by omega))).resolve_left
    (by omega)⟩
  rintro a (rfl | rfl)
  exacts [hα, hβ]

end Divisor

end BaseLoci

/-! ### Round-up of the negative of a klt boundary -/

section KltRoundUp

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] {sX : X ⟶ Spec (.of k)} {n : ℕ} {K : Divisor X} {G : QDivisor X}

/-- If `(X, -G)` is a klt pair, then every coefficient of `G` is `> -1`, and consequently the
round-up `⌈G⌉` is effective. -/
@[mmp "lem_km3a_nonvanishing_roundup_effective"]
public theorem IsKltPair.neg_one_lt_coeff_and_isEffective_roundUp
    (h : IsKltPair sX n K (-G)) :
    (∀ P : PrimeDivisor X, -1 < G.coeff P) ∧ G.roundUp.IsEffective := by
  have hc : ∀ P : PrimeDivisor X, -1 < G.coeff P := fun P => by
    have := roundDown_nonpos_iff.mp h.2.2 P
    rw [DivisorWithCoeffs.coeff_neg] at this
    linarith
  refine ⟨hc, fun P => ?_⟩
  rw [DivisorWithCoeffs.coeff_roundUp, Int.le_ceil_iff]
  simpa using hc P

end KltRoundUp

/-! ### Relative freeness after a twist from the base -/

section RelativelyFree

open Opposite MMP.Intersection

variable {X : Scheme.{u}}

/-- Multiplying a section of `𝒪_X(E + F)` by a function whose germs are local equations of `F`
gives a section of `𝒪_X(E)`. -/
private theorem mul_mem_lineBundleSections {E F : X.CartierDivisor} {V : X.Opens}
    {σ φ : X.totalQuotientSheaf.obj.obj (op V)} (hσ : σ ∈ lineBundleSections (E + F) V)
    (hφ : ∀ (x : X) (hx : x ∈ V),
      IsLocalEquationAt F x (X.totalQuotientSheaf.presheaf.germ V x hx φ)) :
    σ * φ ∈ lineBundleSections E V := by
  intro x hx e he
  have := hσ x hx _ (he.add (hφ x hx))
  rwa [map_mul, mul_assoc, mul_comm (X.totalQuotientSheaf.presheaf.germ V x hx φ)]

/-- Dividing a section of `𝒪_X(E)` by a unit whose germs are local equations of `F` gives a
section of `𝒪_X(E + F)`. -/
private theorem mul_inv_mem_lineBundleSections_of_isLocalEquationAt {E F : X.CartierDivisor}
    {V : X.Opens}
    {s : X.totalQuotientSheaf.obj.obj (op V)} (hs : s ∈ lineBundleSections E V)
    (φ : (X.totalQuotientSheaf.obj.obj (op V))ˣ)
    (hφ : ∀ (x : X) (hx : x ∈ V),
      IsLocalEquationAt F x (X.totalQuotientSheaf.presheaf.germ V x hx (φ : _))) :
    s * ↑φ⁻¹ ∈ lineBundleSections (E + F) V := by
  intro x hx e he
  obtain ⟨U, hxU, g, hg⟩ := MMP.Intersection.exists_isLocalEquationOn E x
  have hE : IsLocalEquationAt E x (X.totalQuotientSheaf.presheaf.germ U x hxU (g : _)) :=
    ⟨U, hxU, g, hg, rfl⟩
  obtain ⟨w, rfl⟩ := (hE.add (hφ x hx)).exists_eq_mul_units he
  obtain ⟨r, hr⟩ := hs x hx _ hE
  refine ⟨r * w, ?_⟩
  have h1 : X.totalQuotientSheaf.presheaf.germ V x hx (↑φ⁻¹ : _) *
      X.totalQuotientSheaf.presheaf.germ V x hx (φ : _) = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  rw [map_mul, map_mul, hr]
  linear_combination -(X.totalQuotientSheaf.presheaf.germ V x hx s *
    X.totalQuotientSheaf.presheaf.germ U x hxU (g : _) * stalkToTotalQuotient x w) * h1

/-- On an integral, locally Noetherian scheme, a section of `𝒪_X` with a non-zero germ is a unit
of `𝓜_X`. -/
private theorem isUnit_toTotalQuotient [IsIntegral X] [IsLocallyNoetherian X] {U : X.Opens}
    {s : Γ(X, U)} {x : X} (hx : x ∈ U) (hs : X.presheaf.germ U x hx s ≠ 0) :
    IsUnit (toTotalQuotient U s) := by
  apply isUnit_of_locally
  intro y hy
  have hy0 : X.presheaf.germ U y hy s ≠ 0 := by
    intro h
    apply hs
    have : s = 0 := germ_injective_of_isIntegral X y hy (by rw [h, map_zero])
    rw [this, map_zero]
  have hu : IsUnit (X.totalQuotientSheaf.presheaf.germ U y hy (toTotalQuotient U s)) := by
    rw [germ_toTotalQuotient]
    exact isUnit_stalkToTotalQuotient_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hy0)
  obtain ⟨W, hWU, hyW, hW⟩ := exists_isUnit_map_of_isUnit_germ _ hy _ hu
  exact ⟨W, homOfLE hWU, hyW, hW⟩

/-- A fraction of two sections of `𝒪_X` which are units of `𝓜_X` is, germwise, the fraction of
their germs. -/
private theorem isFraction_germ_mul_inv {U : X.Opens} {A B : Γ(X, U)}
    (hA : IsUnit (toTotalQuotient U A)) (hB : IsUnit (toTotalQuotient U B)) (x : X) (hx : x ∈ U) :
    IsFraction (X.totalQuotientSheaf.presheaf.germ U x hx ((hA.unit * hB.unit⁻¹ : _ˣ) : _))
      (X.presheaf.germ U x hx A) (X.presheaf.germ U x hx B) := by
  refine ⟨?_, ?_⟩
  · rw [← germ_toTotalQuotient]; exact hB.map _
  · rw [← germ_toTotalQuotient, ← germ_toTotalQuotient, ← map_mul]
    congr 1
    simp only [Units.val_mul, IsUnit.unit_spec]
    rw [mul_left_comm, IsUnit.mul_val_inv, mul_one]

/-- **The pull-back of a local equation.** If `B'` is a pull-back of `B` along `f` and `X` is
integral, then every point of `X` has the preimage `f⁻¹ V` of an open `V ∋ f x` as a
neighbourhood on which `B'` has a local equation, given at each point by a local equation of `B`
on `V` pulled back. -/
private theorem exists_isLocalEquationAt_preimage {Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] {f : X ⟶ Y} {B : Y.CartierDivisor} {B' : X.CartierDivisor}
    (hB : IsPullback f B B') (x : X) :
    ∃ (V : Y.Opens) (_ : f x ∈ V) (φ : (X.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ V)))ˣ),
      ∀ (x' : X) (hx' : x' ∈ f ⁻¹ᵁ V),
        IsLocalEquationAt B' x' (X.totalQuotientSheaf.presheaf.germ _ x' hx' (φ : _)) := by
  obtain ⟨-, hB⟩ := hB
  obtain ⟨a, b, ⟨g0, hg0, hfr⟩, ha, hb, -⟩ := hB x
  obtain ⟨V₀, hx₀, G, sa, sb, hG, rfl, rfl, V, hV, hxV, hfrV⟩ := exists_fraction_nhds hg0 hfr
  let A : Γ(X, f ⁻¹ᵁ V) := X.presheaf.map (homOfLE (f.preimage_mono hV)).op (f.app V₀ sa)
  let B0 : Γ(X, f ⁻¹ᵁ V) := X.presheaf.map (homOfLE (f.preimage_mono hV)).op (f.app V₀ sb)
  have hgerm : ∀ (s : Γ(Y, V₀)) (x' : X) (hx' : x' ∈ f ⁻¹ᵁ V),
      X.presheaf.germ (f ⁻¹ᵁ V) x' hx'
          (X.presheaf.map (homOfLE (f.preimage_mono hV)).op (f.app V₀ s)) =
        f.stalkMap x' (Y.presheaf.germ V₀ (f x') (hV hx') s) := by
    intro s x' hx'
    rw [TopCat.Presheaf.germ_res_apply, Scheme.Hom.germ_stalkMap_apply]
  have hxV' : x ∈ f ⁻¹ᵁ V := hxV
  have hA : IsUnit (toTotalQuotient _ A) := isUnit_toTotalQuotient hxV' (by
    rw [hgerm]; exact nonZeroDivisors.ne_zero ha)
  have hB0 : IsUnit (toTotalQuotient _ B0) := isUnit_toTotalQuotient hxV' (by
    rw [hgerm]; exact nonZeroDivisors.ne_zero hb)
  refine ⟨V, hxV, hA.unit * hB0.unit⁻¹, fun x' hx' => ?_⟩
  have hφ := isFraction_germ_mul_inv hA hB0 x' hx'
  rw [hgerm, hgerm] at hφ
  obtain ⟨a', b', ⟨g0', hg0', hfr'⟩, -, -, g'', hg'', hfr''⟩ := hB x'
  have hGp : IsLocalEquationAt B (f x')
      (Y.totalQuotientSheaf.presheaf.germ V₀ (f x') (hV hx') (G : _)) :=
    ⟨V₀, hV hx', G, hG, rfl⟩
  obtain ⟨w, hw⟩ := hGp.exists_eq_mul_units hg0'
  have e := (hfrV (f x') hx').mul_eq_of_eq_mul hfr' hw
  have e' := congrArg (f.stalkMap x') e
  simp only [map_mul] at e'
  have key := hfr''.eq_mul_of_mul_eq hφ (c := f.stalkMap x' (↑w⁻¹ : Y.presheaf.stalk (f x'))) (by
    have hw1 : f.stalkMap x' (↑w : Y.presheaf.stalk (f x')) *
        f.stalkMap x' (↑w⁻¹ : Y.presheaf.stalk (f x')) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    linear_combination -(f.stalkMap x' (↑w⁻¹ : Y.presheaf.stalk (f x'))) * e' -
      (f.stalkMap x' (Y.presheaf.germ V₀ (f x') (hV hx') sa) * f.stalkMap x' b') * hw1)
  rw [key]
  exact hg''.mul_units (Units.map (f.stalkMap x').hom.toMonoidHom w⁻¹)

/-- A section of a sheaf of modules which vanishes near every point is zero. -/
private theorem eq_zero_of_locally (Q : X.Modules) {U : X.Opens} (q : Γ(Q, U))
    (h : ∀ x ∈ U, ∃ (W : X.Opens) (hW : W ≤ U), x ∈ W ∧ Q.presheaf.map (homOfLE hW).op q = 0) :
    q = 0 := by
  refine TopCat.Presheaf.section_ext ⟨Q.presheaf, Q.isSheaf⟩ U _ _ fun x hx => ?_
  obtain ⟨W, hW, hxW, h0⟩ := h x hx
  rw [← TopCat.Presheaf.germ_res_apply Q.presheaf (homOfLE hW) x hxW q, h0, map_zero, map_zero]

/-- A morphism out of `𝒪_X(D)`, for any sheaf of modules `M`, which is killed by the counit
`f^* f_* M ⟶ M` kills every section of `M` over a preimage `f⁻¹ V`. -/
private theorem app_preimage_eq_zero_of_counit_comp {Y : Scheme.{u}} (f : X ⟶ Y) {M Q : X.Modules}
    (g : M ⟶ Q) (hg : (Scheme.Modules.pullbackPushforwardAdjunction f).counit.app M ≫ g = 0)
    (V : Y.Opens) (u : Γ(M, f ⁻¹ᵁ V)) : g.app (f ⁻¹ᵁ V) u = 0 := by
  set adj := Scheme.Modules.pullbackPushforwardAdjunction f
  have h2 : ((adj.unit.app ((Scheme.Modules.pushforward f).obj M) ≫
      (Scheme.Modules.pushforward f).map (adj.counit.app M)).app V) u = u := by
    rw [adj.right_triangle_components M]; rfl
  rw [← h2]
  change ((adj.counit.app M ≫ g).app (f ⁻¹ᵁ V)) _ = 0
  rw [hg]; rfl

/-- A sub-sheaf of modules of a globally generated sheaf of modules which contains every global
section contains every section. -/
private theorem mem_of_forall_sections_mem {M : X.Modules}
    (hgg : SheafOfModules.IsGeneratedByGlobalSections.{u, u, u} M) (N : M.Submodule)
    (hN : ∀ (σ : M.sections) (W : X.Opens), σ.1 (op W) ∈ N.obj (op W)) (W : X.Opens)
    (t : Γ(M, W)) : t ∈ N.obj (op W) := by
  obtain ⟨σ⟩ := hgg
  have hπ : σ.π ≫ Limits.cokernel.π N.ι = 0 := by
    apply (SheafOfModules.freeHomEquiv _).injective
    funext i
    erw [SheafOfModules.freeHomEquiv_comp_apply, Equiv.apply_symm_apply]
    apply Subtype.ext
    funext W
    change (Limits.cokernel.π N.ι).val.app W (N.ι.val.app W ⟨(σ.s i).1 W, hN (σ.s i) W.unop⟩) = 0
    exact congrArg (fun φ => φ.val.app W ⟨(σ.s i).1 W, hN (σ.s i) W.unop⟩)
      (Limits.cokernel.condition N.ι)
  have : Epi σ.π := σ.epi
  have := Abelian.epi_of_cokernel_π_eq_zero N.ι
    ((cancel_epi σ.π).1 (hπ.trans Limits.comp_zero.symm))
  have := isIso_of_mono_of_epi N.ι
  have e : (N.ι.val.app (op W)) ((inv N.ι).val.app (op W) t) = t :=
    congrArg (fun φ => φ.val.app (op W) t) (IsIso.inv_hom_id N.ι)
  rw [← e]
  exact ((inv N.ι).val.app (op W) t).2

/-- **KM 3.26.** Let `f : X ⟶ Y` be a proper morphism of `k`-varieties, `D` a Cartier divisor on
`X`, and `B'` a pull-back along `f` of a Cartier divisor `B` on `Y`. If `𝒪_X(D + B')` is
generated by its global sections, then `D` is `f`-free. -/
@[mmp "lem_km3b_free_twist_relatively_free"]
public theorem isRelativelyFreeCartier_of_isGeneratedByGlobalSections_add_pullback
    {k : Type u} [Field k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} {sY : Y ⟶ Spec (.of k)}
    [IsVariety k sX] [IsVariety k sY] {f : X ⟶ Y} (hf : f ≫ sY = sX) [IsProper f]
    (D : X.CartierDivisor) {B : Y.CartierDivisor} {B' : X.CartierDivisor}
    (hB : MMP.Intersection.IsPullback f B B')
    (hgg : SheafOfModules.IsGeneratedByGlobalSections.{u, u, u}
      (MMP.CartierDivisor.sheaf (D + B'))) :
    IsRelativelyFreeCartier f D := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  set M := MMP.CartierDivisor.sheaf D
  set M' := MMP.CartierDivisor.sheaf (D + B')
  change Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app M)
  refine Preadditive.epi_of_cancel_zero _ (fun {Q} g hg => ?_)
  have gnat : ∀ {W W' : X.Opens} (h : W' ≤ W) (m : Γ(M, W)),
      g.app W' (M.presheaf.map (homOfLE h).op m) = Q.presheaf.map (homOfLE h).op (g.app W m) :=
    fun h m => ConcreteCategory.congr_hom (g.mapPresheaf.naturality (homOfLE h).op) m
  let P : ∀ W : X.Opens, Γ(M', W) → Prop := fun W t => ∀ (W' : X.Opens) (h : W' ≤ W)
      (φ : X.totalQuotientSheaf.obj.obj (op W')) (m : Γ(M, W')),
      (∀ (x : X) (hx : x ∈ W'),
        IsLocalEquationAt B' x (X.totalQuotientSheaf.presheaf.germ W' x hx φ)) →
      (show X.totalQuotientSheaf.obj.obj (op W') from m.1) =
        X.totalQuotientSheaf.obj.map (homOfLE h).op
          (show X.totalQuotientSheaf.obj.obj (op W) from t.1) * φ → g.app W' m = 0
  have extM : ∀ {W : X.Opens} (m m' : Γ(M, W)), (show X.totalQuotientSheaf.obj.obj (op W) from m.1)
      = (show X.totalQuotientSheaf.obj.obj (op W) from m'.1) → m = m' :=
    fun m m' h => Subtype.ext h
  have mulmem : ∀ {W W' : X.Opens} (h : W' ≤ W) (t : Γ(M', W))
      (φ : X.totalQuotientSheaf.obj.obj (op W')), (∀ (x : X) (hx : x ∈ W'),
        IsLocalEquationAt B' x (X.totalQuotientSheaf.presheaf.germ W' x hx φ)) →
      MMP.CartierDivisorSheaf.Mem D W'
        (X.totalQuotientSheaf.obj.map (homOfLE h).op
          (show X.totalQuotientSheaf.obj.obj (op W) from t.1) * φ) := fun h t φ hφ =>
    (mem_lineBundleSections_iff_mem _ _ _).1 (mul_mem_lineBundleSections
      (res_mem _ h ((mem_lineBundleSections_iff_mem _ _ _).2 t.2)) hφ)
  have P_zero : ∀ W, P W 0 := by
    intro W W' h φ m hφ hm
    rw [extM m 0 (hm.trans (by
      change X.totalQuotientSheaf.obj.map (homOfLE h).op 0 * φ = 0
      rw [map_zero, zero_mul])), map_zero]
  have P_add : ∀ W (t₁ t₂ : Γ(M', W)), P W t₁ → P W t₂ → P W (t₁ + t₂) := by
    intro W t₁ t₂ h₁ h₂ W' h φ m hφ hm
    let m₁ : Γ(M, W') := ⟨_, mulmem h t₁ φ hφ⟩
    let m₂ : Γ(M, W') := ⟨_, mulmem h t₂ φ hφ⟩
    rw [extM m (m₁ + m₂) (hm.trans (by
      change X.totalQuotientSheaf.obj.map (homOfLE h).op
        ((show X.totalQuotientSheaf.obj.obj (op W) from t₁.1) +
          (show X.totalQuotientSheaf.obj.obj (op W) from t₂.1)) * φ = _
      rw [map_add, add_mul]; rfl)), map_add, h₁ W' h φ m₁ hφ rfl, h₂ W' h φ m₂ hφ rfl,
      add_zero]
  have P_smul : ∀ W (r : Γ(X, W)) (t : Γ(M', W)), P W t → P W (r • t) := by
    intro W r t ht W' h φ m hφ hm
    let m₁ : Γ(M, W') := ⟨_, mulmem h t φ hφ⟩
    rw [extM m (X.presheaf.map (homOfLE h).op r • m₁) (hm.trans (by
      change X.totalQuotientSheaf.obj.map (homOfLE h).op
        (toTotalQuotient W r * (show X.totalQuotientSheaf.obj.obj (op W) from t.1)) * φ =
          toTotalQuotient W' (X.presheaf.map (homOfLE h).op r) *
            (X.totalQuotientSheaf.obj.map (homOfLE h).op
              (show X.totalQuotientSheaf.obj.obj (op W) from t.1) * φ)
      rw [map_mul, toTotalQuotient_map, mul_assoc])), Scheme.Modules.Hom.app_smul,
      ht W' h φ m₁ hφ rfl, smul_zero]
  have P_res : ∀ W W₂ (i : W₂ ≤ W) (t : Γ(M', W)), P W t →
      P W₂ (M'.presheaf.map (homOfLE i).op t) := by
    intro W W₂ i t ht W' h φ m hφ hm
    refine ht W' (h.trans i) φ m hφ (hm.trans ?_)
    change X.totalQuotientSheaf.obj.map (homOfLE h).op
      (X.totalQuotientSheaf.obj.map (homOfLE i).op
        (show X.totalQuotientSheaf.obj.obj (op W) from t.1)) * φ = _
    rw [totalQuotient_map_map]; rfl
  have P_loc : ∀ W (t : Γ(M', W)), (∀ x ∈ W, ∃ (W₂ : X.Opens) (i : W₂ ≤ W), x ∈ W₂ ∧
      P W₂ (M'.presheaf.map (homOfLE i).op t)) → P W t := by
    intro W t ht W' h φ m hφ hm
    refine eq_zero_of_locally Q _ (fun x hx => ?_)
    obtain ⟨W₂, i, hxW₂, hP⟩ := ht x (h hx)
    refine ⟨W' ⊓ W₂, inf_le_left, ⟨hx, hxW₂⟩, ?_⟩
    rw [← gnat]
    refine hP (W' ⊓ W₂) inf_le_right (X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op φ)
      _ (fun y hy => ?_) ?_
    · rw [TopCat.Presheaf.germ_res_apply]; exact hφ y hy.1
    · change X.totalQuotientSheaf.obj.map (homOfLE inf_le_left).op
        (show X.totalQuotientSheaf.obj.obj (op W') from m.1) = _
      rw [hm, map_mul]
      change _ = X.totalQuotientSheaf.obj.map (homOfLE inf_le_right).op
        (X.totalQuotientSheaf.obj.map (homOfLE i).op
          (show X.totalQuotientSheaf.obj.obj (op W) from t.1)) * _
      rw [totalQuotient_map_map, totalQuotient_map_map]; rfl
  have P_glob : ∀ (σ : M'.sections) (W : X.Opens), P W (σ.1 (op W)) := by
    intro σ W W' h φ m hφ hm
    refine eq_zero_of_locally Q _ (fun x hx => ?_)
    obtain ⟨V, hxV, ψ, hψ⟩ := exists_isLocalEquationAt_preimage hB x
    have h₁ : W' ⊓ f ⁻¹ᵁ V ≤ W' := inf_le_left
    have h₂ : W' ⊓ f ⁻¹ᵁ V ≤ f ⁻¹ᵁ V := inf_le_right
    let u : Γ(M, f ⁻¹ᵁ V) := ⟨_, mulmem le_rfl (σ.1 (op (f ⁻¹ᵁ V))) ψ hψ⟩
    have hψ₂ : IsUnit (X.totalQuotientSheaf.obj.map (homOfLE h₂).op (ψ : _)) := ψ.isUnit.map _
    obtain ⟨c, hc⟩ : ∃ c : Γ(X, W' ⊓ f ⁻¹ᵁ V), toTotalQuotient _ c =
        X.totalQuotientSheaf.obj.map (homOfLE h₁).op φ * ↑hψ₂.unit⁻¹ := by
      refine exists_toTotalQuotient_eq_of_germ_mem _ (fun y hy => ?_)
      obtain ⟨w, hw⟩ := (hψ y hy.2).exists_eq_mul_units (hφ y hy.1)
      refine ⟨w, ?_⟩
      have hinv : X.totalQuotientSheaf.presheaf.germ _ y hy
          (X.totalQuotientSheaf.obj.map (homOfLE h₂).op (ψ : _)) *
          X.totalQuotientSheaf.presheaf.germ _ y hy (↑hψ₂.unit⁻¹) = 1 := by
        rw [← map_mul, hψ₂.mul_val_inv, map_one]
      rw [map_mul, TopCat.Presheaf.germ_res_apply, hw]
      rw [TopCat.Presheaf.germ_res_apply] at hinv
      linear_combination (-(stalkToTotalQuotient y w)) * hinv
    refine ⟨W' ⊓ f ⁻¹ᵁ V, h₁, ⟨hx, hxV⟩, ?_⟩
    have hσ : X.totalQuotientSheaf.obj.map (homOfLE (h₁.trans h)).op
        (show X.totalQuotientSheaf.obj.obj (op W) from (σ.1 (op W)).1) =
        X.totalQuotientSheaf.obj.map (homOfLE h₂).op
          (show X.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ V)) from (σ.1 (op (f ⁻¹ᵁ V))).1) :=
      (congrArg Subtype.val (σ.2 (homOfLE (h₁.trans h)).op)).trans
        (congrArg Subtype.val (σ.2 (homOfLE h₂).op)).symm
    rw [← gnat, extM (M.presheaf.map (homOfLE h₁).op m)
      (c • M.presheaf.map (homOfLE h₂).op u) ?_, Scheme.Modules.Hom.app_smul, gnat,
      app_preimage_eq_zero_of_counit_comp f g hg,
      map_zero, smul_zero]
    change X.totalQuotientSheaf.obj.map (homOfLE h₁).op
        (show X.totalQuotientSheaf.obj.obj (op W') from m.1) =
      toTotalQuotient _ c * X.totalQuotientSheaf.obj.map (homOfLE h₂).op
        (X.totalQuotientSheaf.obj.map (homOfLE le_rfl).op
          (show X.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ V)) from (σ.1 (op (f ⁻¹ᵁ V))).1) * ψ)
    rw [hm, map_mul, map_mul, totalQuotient_map_map, totalQuotient_map_id, hc]
    erw [hσ]
    have hinv : X.totalQuotientSheaf.obj.map (homOfLE h₂).op (ψ : _) * ↑hψ₂.unit⁻¹ = 1 :=
      hψ₂.mul_val_inv
    linear_combination (-(X.totalQuotientSheaf.obj.map (homOfLE h₁).op φ *
      X.totalQuotientSheaf.obj.map (homOfLE h₂).op
        (show X.totalQuotientSheaf.obj.obj (op (f ⁻¹ᵁ V)) from (σ.1 (op (f ⁻¹ᵁ V))).1))) * hinv
  have hall : ∀ (W : X.Opens) (t : Γ(M', W)), P W t := by
    let N : M'.Submodule :=
      { obj := fun W =>
          { carrier := {t | P W.unop t}
            add_mem' := fun {a b} ha hb => P_add _ a b ha hb
            zero_mem' := P_zero _
            smul_mem' := fun r t ht => P_smul _ r t ht }
        map := fun {W W₂} i t ht => P_res W.unop W₂.unop (leOfHom i.unop) t ht
        isSheaf := fun W t ht => P_loc W.unop t (fun x hx => by
          obtain ⟨V, i, hi, hxV⟩ := ht x hx
          exact ⟨V, leOfHom i, hxV, hi⟩) }
    exact mem_of_forall_sections_mem hgg N P_glob
  refine Scheme.Modules.hom_ext _ _ fun U => ?_
  ext s
  change g.app U s = 0
  refine eq_zero_of_locally Q _ (fun x hx => ?_)
  obtain ⟨V, hxV, φ, hφ⟩ := exists_isLocalEquationAt_preimage hB x
  have hWV : U ⊓ f ⁻¹ᵁ V ≤ f ⁻¹ᵁ V := inf_le_right
  let φW : (X.totalQuotientSheaf.obj.obj (op (U ⊓ f ⁻¹ᵁ V)))ˣ :=
    Units.map (X.totalQuotientSheaf.obj.map (homOfLE hWV).op).hom.toMonoidHom φ
  have hφW : ∀ (x : X) (hx : x ∈ U ⊓ f ⁻¹ᵁ V), IsLocalEquationAt B' x
      (X.totalQuotientSheaf.presheaf.germ _ x hx (φW : _)) := fun x hx => by
    have := hφ x hx.2
    rwa [← TopCat.Presheaf.germ_res_apply _ (homOfLE hWV) x hx] at this
  refine ⟨U ⊓ f ⁻¹ᵁ V, inf_le_left, ⟨hx, hxV⟩, ?_⟩
  let sW := M.presheaf.map (homOfLE (inf_le_left : U ⊓ f ⁻¹ᵁ V ≤ U)).op s
  have hmem := mul_inv_mem_lineBundleSections_of_isLocalEquationAt
    ((mem_lineBundleSections_iff_mem _ _ _).2 sW.2) φW hφW
  let t : Γ(M', U ⊓ f ⁻¹ᵁ V) := ⟨_, (mem_lineBundleSections_iff_mem _ _ _).1 hmem⟩
  rw [← gnat]
  refine hall _ t _ le_rfl _ sW hφW ?_
  rw [totalQuotient_map_id]
  exact (Units.inv_mul_cancel_right _ _).symm

end RelativelyFree

/-! ### The round-up of the test boundary of the rationality theorem -/

section TestBoundary

open MMP.Threefold.Mori.Helpers

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

section TopForms

variable {k : Type*} [CommRing k] {d : ℕ}

private lemma kaehlerMap_self {K : Type*} [CommRing K] [Algebra k K] (w : Ω[K⁄k]) :
    KaehlerDifferential.map k k K K w = w := by
  have hw : w ∈ Submodule.span K (Set.range (KaehlerDifferential.D k K)) := by
    rw [KaehlerDifferential.span_range_derivation]; trivial
  induction hw using Submodule.span_induction with
  | mem w hw => obtain ⟨x, rfl⟩ := hw; simp [KaehlerDifferential.map_D]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | smul a x _ hx => rw [map_smul, hx]

private lemma topFormsMap_self {K : Type*} [CommRing K] [Algebra k K]
    (x : ⋀[K]^d Ω[K⁄k]) : topFormsMap k K K d x = x := by
  have hx : x ∈ Submodule.span K (Set.range (exteriorPower.ιMulti K d (M := Ω[K⁄k]))) := by
    rw [exteriorPower.ιMulti_span]; trivial
  induction hx using Submodule.span_induction with
  | mem w hw => obtain ⟨v, rfl⟩ := hw; simp only [topFormsMap_ιMulti, kaehlerMap_self]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | smul a x _ hx => rw [map_smul, hx]

/-- Along an isomorphism of `k`-algebras, the induced map on top forms is injective. -/
private lemma topFormsMap_injective {K K' : Type*} [CommRing K] [CommRing K'] [Algebra k K]
    [Algebra k K'] [Algebra K K'] [IsScalarTower k K K']
    (h : Function.Bijective (algebraMap K K')) :
    Function.Injective (topFormsMap k K K' d) := by
  let e := RingEquiv.ofBijective (algebraMap K K') h
  letI : Algebra K' K := e.symm.toRingHom.toAlgebra
  have he : ∀ x, e.symm (algebraMap K K' x) = x := e.symm_apply_apply
  have : IsScalarTower k K' K := IsScalarTower.of_algebraMap_eq fun c => by
    change _ = e.symm (algebraMap k K' c)
    rw [IsScalarTower.algebraMap_apply k K K' c, he]
  have : IsScalarTower K K' K := IsScalarTower.of_algebraMap_eq fun x => by
    change x = e.symm (algebraMap K K' x)
    rw [he]
  intro x y hxy
  have := congrArg (topFormsMap k K' K d) hxy
  rwa [topFormsMap_comp, topFormsMap_comp, topFormsMap_self, topFormsMap_self] at this

end TopForms

section Transport

variable {k : Type*} [CommRing k] {d : ℕ} {m : ℤ}
  {K K' : Type*} [Field K] [Field K'] [Algebra k K] [Algebra k K'] [Algebra K K']
  [IsScalarTower k K K']
  {A A' : Type*} [CommRing A] [CommRing A'] [Algebra k A] [Algebra k A'] [Algebra A K]
  [IsScalarTower k A K] [IsFractionRing A K] [Algebra A' K'] [IsScalarTower k A' K']
  [IsFractionRing A' K'] [Algebra A A'] [IsScalarTower k A A'] [Algebra A K']
  [IsScalarTower A A' K'] [IsScalarTower A K K'] [IsScalarTower k A K']

/-- A generator of `Ω^d_{A/k}` with nonzero image in `Ω^d_{K/k}` is carried, along a bijection
`A → A'` compatible with a bijection `K → K'`, to a generator of `Ω^d_{A'/k}` with nonzero image
in `Ω^d_{K'/k}`. -/
private lemma generator_transport (hbij : Function.Bijective (algebraMap A A'))
    (hK : Function.Bijective (algebraMap K K')) {σ : ⋀[A]^d Ω[A⁄k]}
    (hσ : Submodule.span A {σ} = ⊤) (h0 : topFormsMap k A K d σ ≠ 0) :
    Submodule.span A' {topFormsMap k A A' d σ} = ⊤ ∧
      topFormsMap k A' K' d (topFormsMap k A A' d σ) ≠ 0 := by
  letI := IsLocalization.of_le_isUnit_of_bijective (M := ⊥)
    (by rintro _ ⟨_, rfl, rfl⟩; simp) hbij
  refine ⟨span_singleton_topFormsMap (⊥ : Submonoid A) hσ, ?_⟩
  rw [topFormsMap_comp, ← topFormsMap_comp (B := K) (C := K')]
  exact fun h => h0 (topFormsMap_injective hK (h.trans (map_zero _).symm))

/-- Along a bijection `K → K'`, the image of a generator of `Ω^d_{A/k}` with nonzero image is a
pull-back generator. -/
private lemma isPullbackGenerator_of_bijective (hK : Function.Bijective (algebraMap K K'))
    {σ : ⋀[A]^d Ω[A⁄k]} (hσ : Submodule.span A {σ} = ⊤) (h0 : topFormsMap k A K d σ ≠ 0) :
    IsPullbackGenerator K' (topFormsMap k A K d σ) := by
  letI := IsLocalization.of_le_isUnit_of_bijective (M := ⊥)
    (by rintro _ ⟨_, rfl, rfl⟩; simp) hK
  have h1 : Submodule.span K {topFormsMap k A K d σ} = ⊤ :=
    span_singleton_topFormsMap (nonZeroDivisors A) hσ
  exact ⟨h1, span_singleton_topFormsMap (⊥ : Submonoid K) h1,
    fun h => h0 (topFormsMap_injective hK (h.trans (map_zero _).symm))⟩

/-- **The order of a form is invariant under an isomorphism of the local data**: for a bijection
`A → A'` compatible with a bijection `K → K'` and with the valuations,
`ord_{A'}(u^*τ) = ord_A(τ)`, with no hypothesis on the existence of generators. -/
private lemma ordAt_pullbackForms_eq_of_bijective (hbij : Function.Bijective (algebraMap A A'))
    (hK : Function.Bijective (algebraMap K K')) {v : K → ℤ} {v' : K' → ℤ}
    (hmul : ∀ x y : K, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y)
    (hunit : ∀ a : A, IsUnit a → v (algebraMap A K a) = 0)
    (hmul' : ∀ x y : K', x ≠ 0 → y ≠ 0 → v' (x * y) = v' x + v' y)
    (hunit' : ∀ a : A', IsUnit a → v' (algebraMap A' K' a) = 0)
    (hvv : ∀ x, v' (algebraMap K K' x) = v x) (τ : PluriForms k K d m) :
    ordAt A' v' (pullbackForms (K' := K') m τ) = ordAt A v τ := by
  by_cases hA : ∃ σ : ⋀[A]^d Ω[A⁄k], Submodule.span A {σ} = ⊤ ∧ topFormsMap k A K d σ ≠ 0
  · obtain ⟨σ, hσ, h0⟩ := hA
    exact ordAt_pullbackForms_eq hbij hmul hunit hmul' hunit' hvv hσ
      (isPullbackGenerator_of_bijective hK hσ h0) τ
  · have hA' : ¬ ∃ σ' : ⋀[A']^d Ω[A'⁄k], Submodule.span A' {σ'} = ⊤ ∧
        topFormsMap k A' K' d σ' ≠ 0 := by
      rintro ⟨σ', hσ', h0'⟩
      apply hA
      let ψ := RingEquiv.ofBijective (algebraMap A A') hbij
      let e := RingEquiv.ofBijective (algebraMap K K') hK
      letI : Algebra A' A := ψ.symm.toRingHom.toAlgebra
      letI : Algebra K' K := e.symm.toRingHom.toAlgebra
      letI : Algebra A' K := ((algebraMap A K).comp ψ.symm.toRingHom).toAlgebra
      have hψ : ∀ a, ψ.symm (algebraMap A A' a) = a := ψ.symm_apply_apply
      have he : ∀ x, e.symm (algebraMap K K' x) = x := e.symm_apply_apply
      have : IsScalarTower k K' K := IsScalarTower.of_algebraMap_eq fun c => by
        change _ = e.symm (algebraMap k K' c)
        rw [IsScalarTower.algebraMap_apply k K K' c, he]
      have : IsScalarTower k A' A := IsScalarTower.of_algebraMap_eq fun c => by
        change _ = ψ.symm (algebraMap k A' c)
        rw [IsScalarTower.algebraMap_apply k A A' c, hψ]
      have : IsScalarTower A' A K := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have : IsScalarTower k A' K := IsScalarTower.of_algebraMap_eq fun c => by
        change _ = algebraMap A K (ψ.symm (algebraMap k A' c))
        rw [IsScalarTower.algebraMap_apply k A A' c, hψ, ← IsScalarTower.algebraMap_apply]
      have : IsScalarTower A' K' K := IsScalarTower.of_algebraMap_eq fun a' => by
        change algebraMap A K (ψ.symm a') = e.symm (algebraMap A' K' a')
        obtain ⟨a, rfl⟩ := hbij.2 a'
        change _ = e.symm (algebraMap A' K' (algebraMap A A' a))
        rw [hψ, ← IsScalarTower.algebraMap_apply A A' K', IsScalarTower.algebraMap_apply A K K',
          he]
      exact ⟨_, generator_transport ψ.symm.bijective e.symm.bijective hσ' h0'⟩
    rw [ordAt, dif_neg hA', ordAt, dif_neg hA]

end Transport

section Geometry

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] {sX : X ⟶ Spec (.of k)}

private lemma ord_functionFieldMap_eq_of_valuation_eq (D : DivisorOver k sX)
    [IsIntegral D.Y] [IsNormal D.Y] [IsLocallyNoetherian D.Y] [IsDominant D.f]
    (P : MMP.Mori.PrimeDivisor X)
    (hv : ∀ g, D.E.divisorialValuation (functionFieldMap D.f g) = P.divisorialValuation g)
    (g : X.functionField) :
    D.Y.ord (functionFieldMap D.f g) D.E.genericPoint = X.ord g P.genericPoint := by
  let e : X.functionField →+* D.Y.functionField := functionFieldMap D.f
  change D.Y.ord (e g) _ = _
  by_cases hg : g = 0
  · subst hg
    simp [e, Scheme.ord_zero]
  · have h1 := hv g
    rw [D.E.divisorialValuation_eq_exp_neg_ord ((map_ne_zero e).mpr hg),
      P.divisorialValuation_eq_exp_neg_ord hg, WithZero.exp_inj] at h1
    omega

/-- For a divisor `(Y, f, E)` over `X` whose valuation is that of a prime divisor `P` of `X`,
`ord_E(f^*τ) = ord_P(τ)` for every rational pluri-canonical form `τ` on `X`. Unlike the
model-independence of orders of forms, this needs no hypothesis on the base field: the local
rings `𝒪_{X,P}` and `𝒪_{Y,E}` are isomorphic compatibly with `k(X) ≅ k(Y)` and with the
valuations, and the order of a form is invariant under such an isomorphism. -/
public lemma DivisorOver.ordPullback_eq_ordForm_of_valuation_eq {n : ℕ} {m : ℤ}
    (D : DivisorOver k sX)
    (P : MMP.Mori.PrimeDivisor X)
    (hv : ∀ g, D.valuation g = P.divisorialValuation g)
    (τ : RationalPluriForms sX n m) : D.ordPullback τ = P.ordForm τ := by
  have := D.isIntegral
  have := D.isNormal
  have := D.isLocallyNoetherian
  have := D.isDominant
  replace hv : ∀ g, D.E.divisorialValuation (functionFieldMap D.f g) = P.divisorialValuation g :=
    hv
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (D.f ≫ sX)
  let := functionFieldMapAlgebra D.f
  have := isScalarTower_functionFieldMap sX D.f
  have hb := D.isBirationalMorphism.functionFieldMap_bijective
  let e : X.functionField →+* D.Y.functionField := functionFieldMap D.f
  have h12 : ∀ a : P.localRing, ∃ a' : D.E.localRing,
      algebraMap D.E.localRing D.Y.functionField a' =
        e (algebraMap P.localRing X.functionField a) := by
    intro a
    have : P.divisorialValuation (algebraMap P.localRing X.functionField a) ≤ 1 :=
      (P.divisorialValuation_le_one_iff _).mpr ⟨a, rfl⟩
    rw [← hv] at this
    exact (D.E.divisorialValuation_le_one_iff _).mp this
  have h21 : ∀ a' : D.E.localRing, ∃ a : P.localRing,
      e (algebraMap P.localRing X.functionField a) =
        algebraMap D.E.localRing D.Y.functionField a' := by
    intro a'
    obtain ⟨g, hg⟩ := hb.2 (algebraMap D.E.localRing D.Y.functionField a')
    have : P.divisorialValuation g ≤ 1 := by
      rw [← hv]
      exact (D.E.divisorialValuation_le_one_iff _).mpr ⟨a', hg.symm⟩
    obtain ⟨a, ha⟩ := (P.divisorialValuation_le_one_iff _).mp this
    exact ⟨a, by rwa [ha]⟩
  obtain ⟨ψ, hψb, hψ⟩ :=
    MMP.Threefold.Mori.ModelIndependence.exists_ringHom_bijective_of_range e h12 h21
  let := stalkAlgebra sX P.genericPoint
  let := stalkAlgebra (D.f ≫ sX) D.E.genericPoint
  have := isScalarTower_stalk_functionField sX P.genericPoint
  have := isScalarTower_stalk_functionField (D.f ≫ sX) D.E.genericPoint
  let : Algebra P.localRing D.E.localRing := ψ.toAlgebra
  let : Algebra P.localRing D.Y.functionField :=
    ((algebraMap D.E.localRing D.Y.functionField).comp ψ).toAlgebra
  have hS1 : IsScalarTower k P.localRing D.E.localRing := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    apply IsFractionRing.injective D.E.localRing D.Y.functionField
    change _ = algebraMap D.E.localRing D.Y.functionField (ψ (algebraMap k P.localRing c))
    rw [hψ, ← IsScalarTower.algebraMap_apply k P.localRing X.functionField c,
      ← IsScalarTower.algebraMap_apply k D.E.localRing D.Y.functionField c]
    exact IsScalarTower.algebraMap_apply k X.functionField D.Y.functionField c
  have hS2 : IsScalarTower P.localRing D.E.localRing D.Y.functionField :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hS3 : IsScalarTower P.localRing X.functionField D.Y.functionField :=
    IsScalarTower.of_algebraMap_eq hψ
  have hS4 : IsScalarTower k P.localRing D.Y.functionField := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    change _ = algebraMap D.E.localRing D.Y.functionField (ψ (algebraMap k P.localRing c))
    rw [IsScalarTower.algebraMap_apply k D.E.localRing D.Y.functionField c,
      IsScalarTower.algebraMap_apply k P.localRing D.E.localRing c]
    rfl
  exact ordAt_pullbackForms_eq_of_bijective (A := P.localRing) (A' := D.E.localRing)
    (v := fun g => X.ord g P.genericPoint) (v' := fun y => D.Y.ord y D.E.genericPoint) hψb hb
    P.ord_mul_of_ne_zero
    (fun a ha => P.ord_algebraMap_of_isUnit ha)
    D.E.ord_mul_of_ne_zero
    (fun a ha => D.E.ord_algebraMap_of_isUnit ha)
    (ord_functionFieldMap_eq_of_valuation_eq D P hv) τ

/-- The discrepancy `a(E, X, Δ)` of a divisor `(Y, f, E)` over `X` with `f(η_E) = η_P` for a prime
divisor `P` of `X` is `-coeff_P(Δ)`, over any base field. -/
public lemma IsDiscrepancy.eq_neg_coeff_of_map_genericPoint_eq {n : ℕ} {K : Divisor X}
    {Δ : QDivisor X} {D : DivisorOver k sX} {P : MMP.Mori.PrimeDivisor X}
    (hP : D.f D.E.genericPoint = P.genericPoint) {a : ℚ} (h : IsDiscrepancy sX n K Δ D a) :
    a = -Δ.coeff P := by
  obtain ⟨hX, hK, m, hm, -, U, hU, τ, hτ, hmτ⟩ := h
  have hv := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX D P hP
  have hv' : ∀ g, D.valuation g = P.divisorialValuation g := fun g => by
    rw [hv]
    change P.divisorialValuation (functionFieldMap (𝟙 X) g) = _
    rw [MMP.Mori.functionFieldMap_id_apply]
  rw [D.ordPullback_eq_ordForm_of_valuation_eq P hv' τ] at hmτ
  have hPU : (P.support ∩ (U : Set X)).Nonempty := by
    refine ⟨P.genericPoint, ?_, hP ▸ hU⟩
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  have e := hτ.2 P hPU
  exact mul_left_cancel₀ (by positivity : (m : ℚ) ≠ 0) (by linear_combination hmτ + e)

/-- **The discrepancy of a non-exceptional divisor.** If `(Y, f, E)` is a divisor over a normal
variety `X` that is not exceptional, then its discrepancy `a(E, X, Δ)` is `-coeff_P(Δ)` for a
prime divisor `P` of `X` (the image of `E`). No hypothesis on the base field is needed. -/
private lemma IsDiscrepancy.exists_eq_neg_coeff_of_not_isExceptional {n : ℕ} {K : Divisor X}
    {Δ : QDivisor X} {D : DivisorOver k sX} {a : ℚ} (h : IsDiscrepancy sX n K Δ D a)
    (hE : ¬ D.IsExceptional) : ∃ P : MMP.Mori.PrimeDivisor X, a = -Δ.coeff P := by
  obtain ⟨P, hv⟩ :=
    MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional h.1 D hE
  exact ⟨P, h.eq_neg_coeff_of_map_genericPoint_eq
    (MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq h.1.1 hv)⟩

end Geometry

section Coefficients

variable {Y : Scheme.{u}} {ι : Type*} [Fintype ι] [DecidableEq ι] {F : ι → MMP.Mori.PrimeDivisor Y}

/-- A coefficient of the test boundary is either `0` or `-c r_j + a_j - p_j` at `F_j`, `j ≠ j₀`. -/
public lemma coeff_tieBreakerBoundary (hF : Function.Injective F) (r a p : ι → ℚ) (j₀ : ι)
    (c : ℚ) (E : MMP.Mori.PrimeDivisor Y) :
    (tieBreakerBoundary F r a p j₀ c).coeff E = 0 ∨
      ∃ j, j ≠ j₀ ∧ F j = E ∧ (tieBreakerBoundary F r a p j₀ c).coeff E = -c * r j + a j - p j := by
  unfold tieBreakerBoundary
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.finsetSum_apply]
  by_cases hE : ∃ j, j ≠ j₀ ∧ F j = E
  · obtain ⟨j, hj, rfl⟩ := hE
    refine Or.inr ⟨j, hj, rfl, ?_⟩
    rw [Finset.sum_eq_single j]
    · simp
    · intro i _ hij
      exact Finsupp.single_eq_of_ne' (hF.ne hij)
    · intro hj'
      exact absurd (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ j⟩) hj'
  · refine Or.inl (Finset.sum_eq_zero fun i hi => ?_)
    exact Finsupp.single_eq_of_ne' fun h => hE ⟨i, Finset.ne_of_mem_erase hi, h⟩

end Coefficients

section TieBreaker

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX] {n : ℕ}
  {K : Divisor X} {Δ : QDivisor X} {a : ℤ} {H : Divisor X} {p q : ℤ} {Y : Scheme.{u}}
  [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] {f : Y ⟶ X} {s : ℕ}
  {F : Fin s → MMP.Mori.PrimeDivisor Y} {aj pj : Fin s → ℚ} {rj : Fin s → ℕ} {j₀ : Fin s} {c : ℚ}

/-- The tie-breaking threshold `c = (1 + a_{j₀} - p_{j₀}) / r_{j₀}` is positive. -/
private lemma tieBreaker_pos (h : IsStripTieBreaker sX n K Δ a H p q f F aj pj rj j₀ c) :
    0 < c := by
  rw [h.eq_div]
  exact div_pos (by linarith [h.lt_one_add j₀]) (by exact_mod_cast h.pos_r)

/-- Every coefficient `-c r_j + a_j - p_j`, `j ≠ j₀`, of the test boundary is `> -1`. -/
private lemma neg_one_lt_tieBreakerCoeff
    (h : IsStripTieBreaker sX n K Δ a H p q f F aj pj rj j₀ c) {j : Fin s} (hj : j ≠ j₀) :
    -1 < -c * (rj j : ℚ) + aj j - pj j := by
  have h1 := h.lt_one_add j
  rcases Nat.eq_zero_or_pos (rj j) with h0 | h0
  · simp only [h0, Nat.cast_zero, mul_zero]; linarith
  · have hr : (0 : ℚ) < rj j := by exact_mod_cast h0
    linarith [(lt_div_iff₀ hr).mp (h.lt_div j hj h0)]

end TieBreaker

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of k)} [QuasiCompact sX]

/-- For a tie-breaker `(j₀, c)` of a `(p, q)`-adapted resolution `(f; F_•; a_•; p_•; r_•)` of a
rationality datum `(X, Δ, a, H)`, the round-up `⌈A'⌉` of the test boundary
`A' = ∑_{j ≠ j₀} (-c r_j + a_j - p_j) F_j` is effective, and every prime divisor of `Y` occurring
in `⌈A'⌉` is `f`-exceptional. -/
@[mmp "lem_km3b_strip_test_boundary_roundup"]
public theorem IsStripTieBreaker.isEffective_roundUp_tieBreakerBoundary {n : ℕ} {K : Divisor X}
    {Δ : QDivisor X} {a : ℤ} {H : Divisor X} {p q : ℤ} {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] {f : Y ⟶ X} {s : ℕ} {F : Fin s → PrimeDivisor Y}
    {aj pj : Fin s → ℚ} {rj : Fin s → ℕ} {j₀ : Fin s} {c : ℚ}
    (h : IsStripTieBreaker sX n K Δ a H p q f F aj pj rj j₀ c) :
    (tieBreakerBoundary F (fun j => (rj j : ℚ)) aj pj j₀ c).roundUp.IsEffective ∧
      ∀ E : PrimeDivisor Y,
        (tieBreakerBoundary F (fun j => (rj j : ℚ)) aj pj j₀ c).roundUp.coeff E ≠ 0 →
          RationalMap.IsExceptional f.toRationalMap E := by
  refine ⟨fun E => ?_, fun E hE => ?_⟩
  · rw [DivisorWithCoeffs.coeff_roundUp]
    rcases coeff_tieBreakerBoundary h.injective (fun j => (rj j : ℚ)) aj pj j₀ c E with
      h0 | ⟨j, hj, -, hcoeff⟩
    · rw [h0, Int.ceil_zero]
    · rw [hcoeff]
      exact Int.ceil_nonneg_of_neg_one_lt (neg_one_lt_tieBreakerCoeff h hj)
  · rw [DivisorWithCoeffs.coeff_roundUp] at hE
    rcases coeff_tieBreakerBoundary h.injective (fun j => (rj j : ℚ)) aj pj j₀ c E with
      h0 | ⟨j, hj, rfl, hcoeff⟩
    · exact absurd (by rw [h0, Int.ceil_zero]) hE
    · refine by_contra fun hnex => hE ?_
      -- a non-exceptional `F_j` has `a_j = -coeff_P(Δ) ≤ 0`, so `e_j ∈ (-1, 0]`
      obtain ⟨P, hP⟩ := IsDiscrepancy.exists_eq_neg_coeff_of_not_isExceptional
        (h.isCrepantBoundary.2 (F j)) hnex
      rw [DivisorWithCoeffs.coeff_neg, neg_neg, DivisorWithCoeffs.coeff_apply,
        Finsupp.finsetSum_apply, Finset.sum_eq_single_of_mem j (Finset.mem_univ j)
          fun i _ hij => Finsupp.single_eq_of_ne' (h.injective.ne hij),
        Finsupp.single_eq_same] at hP
      rw [hcoeff, Int.ceil_eq_zero_iff]
      refine ⟨neg_one_lt_tieBreakerCoeff h hj, ?_⟩
      have := mul_nonneg (tieBreaker_pos h).le (Nat.cast_nonneg (α := ℚ) (rj j))
      linarith [h.isEffective P, h.pos_p' j]

end TestBoundary

end MMP.Mori
