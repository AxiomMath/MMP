/-! ### Snc closed subsets and their components -/

namespace MMP.Resolution.AmpleFloorLowering

open MMP MMP.Mori MMP.Resolution

/-- A prime divisor is determined by its support. -/
private theorem primeDivisor_eq_of_support_eq {X : Scheme.{0}} {P Q : Mori.PrimeDivisor X}
    (h : (P.support : Set X) = Q.support) : P = Q := by
  refine AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
    AlgebraicGeometry.PrimeDivisor.support_eq_closure] at h
  exact (inseparable_iff_closure_eq.2 h).eq

/-- The ideal sheaf of a prime divisor is the vanishing ideal of its support. -/
private theorem idealSheaf_eq_vanishingIdeal {X : Scheme.{0}} (P : Mori.PrimeDivisor X)
    {T : Closeds X} (hT : (T : Set X) = P.support) :
    P.idealSheaf = Scheme.IdealSheafData.vanishingIdeal T := by
  have := P.integral
  exact Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ (Closeds.ext hT.symm)

/-- The reduced divisor with components a finite set `s` of prime divisors has support `s`. -/
private theorem support_sum_single {X : Scheme.{0}} (s : Finset (Mori.PrimeDivisor X)) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor X).support = s := by
  classical
  ext E
  simp [Finsupp.finsetSum_apply, Finsupp.single_apply]

section SNC

variable {k : Type} [Field k] {Y : Scheme.{0}} {sY : Y ⟶ Spec (.of k)}

/-- The support of a prime divisor contained in an snc closed subset `S` is an irreducible
component of `S`. -/
private theorem support_mem_componentsOf [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) {P : Mori.PrimeDivisor Y} (hP : (P.support : Set Y) ⊆ S) :
    (P.support : Set Y) ∈ componentsOf S := by
  obtain ⟨hSc, hempty | ⟨hpure, -, -⟩⟩ := hS
  · simpa [hempty] using hP (MMP.Positivity.PrimeDivisor.genericPoint_mem_support' P)
  · obtain ⟨-, hcov⟩ := Aux.finite_and_cover_componentsOf hSc
    obtain ⟨W, hW, hηW⟩ := hcov (hP (MMP.Positivity.PrimeDivisor.genericPoint_mem_support' P))
    obtain ⟨ξ, hWξ, hξ1⟩ :=
      MMP.ProgramBaseChange.exists_coheight_eq_one_of_mem_componentsOf hSc hpure hW
    have hsp : ξ ⤳ P.genericPoint := specializes_iff_mem_closure.mpr (hWξ ▸ hηW)
    have hξη : ξ = P.genericPoint := by
      by_contra hne
      have hlt : P.genericPoint < ξ := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hsp)
        fun hle => hne (hsp.antisymm (Scheme.le_iff_specializes.mp hle)).eq
      have := Order.coheight_strictAnti hlt
      rw [hξ1, P.coheight_genericPoint] at this
      exact lt_irrefl _ (this (by simp))
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    change closure {P.genericPoint} ∈ _
    rw [← hξη, ← hWξ]
    exact hW

/-- Only finitely many prime divisors are contained in an snc closed subset. -/
private theorem finite_setOf_support_subset [NoetherianSpace Y] {S : Set Y}
    (hS : IsSNCClosedSubset sY S) :
    {P : Mori.PrimeDivisor Y | (P.support : Set Y) ⊆ S}.Finite := by
  refine Set.Finite.of_finite_image ((Aux.finite_and_cover_componentsOf hS.1).1.subset ?_)
    fun P _ Q _ h => primeDivisor_eq_of_support_eq h
  rintro - ⟨P, hP, rfl⟩
  exact support_mem_componentsOf hS hP

/-- **A reduced divisor whose components lie in an snc closed subset is snc.** -/
private theorem isSNC_sum_single_of_support_subset [LocallyOfFiniteType sY] [NoetherianSpace Y]
    [IsLocallyNoetherian Y] (hsm : IsSmoothScheme sY) {S : Set Y} (hS : IsSNCClosedSubset sY S)
    (s : Finset (Mori.PrimeDivisor Y)) (hs : ∀ P ∈ s, (P.support : Set Y) ⊆ S) :
    (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).IsSNC sY := by
  classical
  have hc : ∀ P ∈ s, (P.support : Set Y) ∈ componentsOf S := fun P hP =>
    support_mem_componentsOf hS (hs P hP)
  obtain ⟨hSc, hempty | ⟨-, -, hfam⟩⟩ := id hS
  · have hs0 : s = ∅ := Finset.eq_empty_of_forall_notMem fun P hP => by
      simpa [hempty] using hs P hP (MMP.Positivity.PrimeDivisor.genericPoint_mem_support' P)
    subst hs0
    rw [Finset.sum_empty]
    exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sY hsm
  have hG := support_sum_single s
  have hideal : ∀ P (hP : P ∈ s),
      P.idealSheaf = componentsFamily S ⟨(P.support : Set Y), hc P hP⟩ := fun P hP =>
    idealSheaf_eq_vanishingIdeal P (by
      rw [Closeds.coe_closure, (Aux.isClosed_of_mem_componentsOf hSc (hc P hP)).closure_eq])
  refine ⟨fun P hP => ?_, fun x => ?_⟩
  · rw [hG] at hP
    rw [hideal P hP]
    exact (hfam.1 _).2.2
  · obtain ⟨m, z, c, hz, hcI, hcinj⟩ := hfam.2 x
    have hs' : ∀ P : {P : Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        P.1 ∈ s := fun P => hG.subset P.2.1
    have hmem : ∀ P : {P : Mori.PrimeDivisor Y //
        P ∈ (∑ P ∈ s, Finsupp.single P (1 : ℤ) : Divisor Y).support ∧ x ∈ P.support},
        x ∈ (componentsFamily S ⟨(P.1.support : Set Y), hc P.1 (hs' P)⟩).support := fun P => by
      rw [← SetLike.mem_coe, coe_support_componentsFamily hSc]
      exact P.2.2
    refine ⟨m, z, fun P => c ⟨_, hmem P⟩, hz, fun P Q h => ?_, fun P => ?_⟩
    · exact Subtype.ext
        (primeDivisor_eq_of_support_eq (congrArg (fun V => (V.1.1 : Set Y)) (hcinj h)))
    · rw [hideal P.1 (hs' P)]
      exact hcI ⟨_, hmem P⟩

end SNC

end MMP.Resolution.AmpleFloorLowering

/-! ### Bertini's theorem on a smooth resolution -/

namespace MMP.Mori.AmpleFloorLowering

open Classical in
/-- The coefficient of the reduced divisor `∑_{E ∈ S} E` at `F` is `1` or `0`. -/
private theorem coeff_sum_single {Y : Scheme.{0}} (S : Finset (PrimeDivisor Y))
    (F : PrimeDivisor Y) :
    DivisorWithCoeffs.coeff (∑ E ∈ S, Finsupp.single E (1 : ℤ) : Divisor Y) F =
      if F ∈ S then 1 else 0 := by
  change (∑ E ∈ S, Finsupp.single E (1 : ℤ)) F = _
  rw [Finsupp.finsetSum_apply]
  simp [Finsupp.single_apply]

/-- **Avoiding a proper subspace by a polynomial condition.** If `v ∉ p` for a subspace
`p ⊆ kⁱ`, a nonzero polynomial `Q` (a linear form vanishing on `p` but not at `v`) has
`c ∉ p` whenever `Q(c) ≠ 0`. -/
private theorem exists_polynomial_notMem_of_eval_ne_zero {k : Type*} [Field k] {ι : Type*}
    [Fintype ι] {p : Submodule k (ι → k)} {v : ι → k} (hv : v ∉ p) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c, MvPolynomial.eval c Q ≠ 0 → c ∉ p := by
  classical
  obtain ⟨ℓ, hℓ, hp⟩ := Submodule.exists_le_ker_of_notMem hv
  let Q : MvPolynomial ι k :=
    ∑ i, MvPolynomial.C (ℓ (fun j => if i = j then 1 else 0)) * MvPolynomial.X i
  have heval : ∀ c, MvPolynomial.eval c Q = ℓ c := fun c => by
    rw [LinearMap.pi_apply_eq_sum_univ ℓ c]
    simp [Q, mul_comm]
  exact ⟨Q, fun h => hℓ (by rw [← heval, h, map_zero]), fun c hc hcp => hc (heval c ▸ hp hcp)⟩

/-- A general linear combination of finitely many sections, one of them nonzero, is nonzero:
the coefficient vectors `c` with `∑ cᵢ sᵢ = 0` form a proper subspace of `kⁱ`, contained in the
kernel of a linear form `ℓ` with `ℓ(e_j) ≠ 0`. -/
private theorem exists_polynomial_sum_smul_ne_zero {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {H : Divisor X} {ι : Type*} [Fintype ι] (s : ι → H.divisorialSubmodule ⊤) (j : ι)
    (hj : s j ≠ 0) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      (∑ i, scalarsToGlobalSections k sX (c i) • s i) ≠ 0 := by
  classical
  let p : Submodule k (ι → k) :=
    { carrier := {c | ∑ i, scalarsToGlobalSections k sX (c i) • s i = 0}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq, Pi.add_apply, map_add, add_smul,
          Finset.sum_add_distrib] at *
        rw [ha, hb, add_zero]
      zero_mem' := by simp
      smul_mem' := by
        intro a c hc
        simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_smul] at *
        rw [← Finset.smul_sum, hc, smul_zero] }
  have hjp : (Pi.single j 1 : ι → k) ∉ p := by
    intro h
    apply hj
    have : ∑ i, scalarsToGlobalSections k sX ((Pi.single j 1 : ι → k) i) • s i = 0 := h
    rwa [Finset.sum_eq_single j (fun i _ hi => by simp [hi]) (by simp),
      Pi.single_eq_same, map_one, one_smul] at this
  exact exists_polynomial_notMem_of_eval_ne_zero hjp

/-! ### The zero scheme of a section of a divisorial sheaf -/

/-- The invertibility of `L` in the spelling the zero scheme takes. -/
private local instance isInvertible_of_isInvertibleModule {Y : Scheme.{0}} (L : Y.Modules)
    [h : Stacks.Ample.IsInvertibleModule Y L] :
    SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L := h

section ZeroScheme

/-- A frame `b` of `𝒪_Y(D)` over `V`, on which `D` has the local equation `φ`, has order
`-d_E` along every prime divisor `E` with generic point in `V`. -/
private theorem valuation_frame_eq {Y : Scheme.{0}} [IsLocallyNoetherian Y] [IsNormal Y]
    {D : Divisor Y} {V : Y.Opens} {φ : (RationalFunctions Y)ˣ} (hφ : D.IsLocalEquation V φ)
    (b : D.divisorialSubmodule V) (r : Γ(Y, V)) (E : PrimeDivisor Y)
    (hE : E.genericPoint ∈ V) (hZ : componentGenericPoint Y E.component ∈ V)
    (hr : ((φ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y) E.component =
      (Y.presheaf.germ V _ hZ).hom r * b.1 ⟨E.component, hZ⟩) :
    E.valuation (b.1 ⟨E.component, hZ⟩) = WithZero.exp (-D.coeff E) := by
  have hEV : (E.support ∩ V).Nonempty :=
    ⟨E.genericPoint, MMP.Positivity.PrimeDivisor.genericPoint_mem_support' E, hE⟩
  have hv := congrArg E.valuation hr
  rw [PrimeDivisor.valuation_component, PrimeDivisor.ord_inv, ← hφ E hEV, map_mul] at hv
  have hne : (Y.presheaf.germ V _ hZ).hom r ≠ 0 := by
    intro h0
    rw [h0, map_zero, zero_mul] at hv
    exact WithZero.coe_ne_zero hv
  have hgerm : (Y.presheaf.germ V _ hZ).hom r =
      E.toComponent.hom ((Y.presheaf.germ V _ hE).hom r) := by
    rw [← TopCat.Presheaf.germ_stalkSpecializes_apply Y.presheaf hE E.specializes_genericPoint]
    rfl
  have hne' : (Y.presheaf.germ V _ hE).hom r ≠ 0 := fun h0 => hne (by rw [hgerm, h0, map_zero])
  have h1 : 1 ≤ E.valuation ((Y.presheaf.germ V _ hZ).hom r) := by
    rw [hgerm]
    exact E.one_le_valuation_toComponent hne'
  have hb0 : b.1 ⟨E.component, hZ⟩ ≠ 0 := by
    intro h0
    rw [h0, map_zero, mul_zero] at hv
    exact WithZero.coe_ne_zero hv
  refine le_antisymm ?_ ?_
  · rw [hv]
    exact le_mul_of_one_le_left' h1
  · exact (b.2 E hEV).resolve_left hb0

/-- **The zero scheme of a section of `𝒪_Y(D)` near a point.** Around every point there is an
affine open `V` on which the ideal of `Z(t)` is generated by a function `a`, and the coefficient
of every prime divisor `E` with generic point in `V` in the divisor of zeros `(t)₀` is the order
of `a` along `E`. -/
private theorem exists_affine_zeroScheme_ideal_eq_span {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (D : Divisor Y) (hD : D.IsCartier)
    [Stacks.Ample.IsInvertibleModule Y D.divisorialSheaf]
    (t : D.divisorialSubmodule ⊤) (ht : t ≠ 0) (x : Y) :
    ∃ (V : Y.affineOpens) (_ : x ∈ (V : Y.Opens)) (a : Γ(Y, V))
      (ha : ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ (V : Y.Opens)),
        (Y.presheaf.germ V _ hZ).hom a ≠ 0),
      (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).ideal V = Ideal.span {a} ∧
      ∀ E : PrimeDivisor Y, E.genericPoint ∈ (V : Y.Opens) →
        (D.zeroDivisor t ht).coeff E =
          E.ord (MMP.Threefold.Resolution.sectionUnit a ha) := by
  obtain ⟨W, hxW, φ, hφ⟩ := hD x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUW⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open hxW W.isOpen
  obtain ⟨g, hxg, hgU, ⟨e⟩⟩ := exists_basicOpen_linearEquiv D.divisorialSheaf ⟨U, hU⟩ x hxU
  let V : Y.affineOpens := ⟨Y.basicOpen g, hU.basicOpen g⟩
  have hVW : (V : Y.Opens) ≤ W := hgU.trans hUW
  set tV := D.divisorialSheaf.presheaf.map (homOfLE (le_top : (V : Y.Opens) ≤ ⊤)).op t
  set a : Γ(Y, V) := e tV with ha_def
  set b : D.divisorialSubmodule V := e.symm 1
  have htV : (tV : D.divisorialSubmodule V) = a • b := by
    change tV = a • e.symm 1
    rw [← map_smul e.symm a 1, smul_eq_mul, mul_one, ha_def, e.symm_apply_apply]
  set u := (Divisor.isUnit_sectionToRationalFunctions ht).unit
  -- the value of `t` at a component through `V`
  have hval : ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ (V : Y.Opens)),
      (u : RationalFunctions Y) Z = (Y.presheaf.germ V _ hZ).hom a * b.1 ⟨Z, hZ⟩ := by
    intro Z hZ
    have := congrArg (fun m : D.divisorialSubmodule V => m.1 ⟨Z, hZ⟩) htV
    simp only [Submodule.coe_smul, rationalFunctions_smul_apply] at this
    exact this
  have ha : ∀ (Z : irreducibleComponents Y) (hZ : componentGenericPoint Y Z ∈ (V : Y.Opens)),
      (Y.presheaf.germ V _ hZ).hom a ≠ 0 := by
    intro Z hZ h0
    have hu := (Pi.isUnit_iff.mp u.isUnit) Z
    rw [hval Z hZ, h0, zero_mul] at hu
    exact not_isUnit_zero hu
  refine ⟨V, hxg, a, ha, zeroScheme_ideal_of_trivialization Y D.divisorialSheaf t V e a rfl,
    fun E hE => ?_⟩
  set hZ := E.specializes_genericPoint.mem_open (V : Y.Opens).isOpen hE
  -- the frame `b` has order `-d_E`
  have hr : (hφ.mono hVW).invSection = e (hφ.mono hVW).invSection • e.symm 1 := by
    rw [← map_smul e.symm _ 1, smul_eq_mul, mul_one, e.symm_apply_apply]
  have hr' := congrArg (fun m : D.divisorialSubmodule V => m.1 ⟨E.component, hZ⟩) hr
  simp only [Divisor.IsLocalEquation.invSection_apply] at hr'
  have hb := valuation_frame_eq (hφ.mono hVW) b _ E hE hZ hr'
  have hv := congrArg E.valuation (hval E.component hZ)
  rw [PrimeDivisor.valuation_component, map_mul, hb,
    ← MMP.Threefold.Resolution.sectionUnit_apply a ha E.component hZ,
    PrimeDivisor.valuation_component, ← WithZero.exp_add] at hv
  have hv' := WithZero.exp_injective hv
  rw [Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor]
  change E.ord u + _ = _
  omega

/-- The nonvanishing open of a nonzero section `t` of `𝒪_Y(D)` is the complement of the
support of its zero scheme. -/
private theorem mem_nonvanishingOpen_iff_notMem_supportSet {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (D : Divisor Y)
    [Stacks.Ample.IsInvertibleModule Y D.divisorialSheaf]
    {t : D.divisorialSubmodule ⊤} (ht : t ≠ 0) (y : Y) :
    y ∈ Stacks.NonvanishingOpen.nonvanishingOpen Y D.divisorialSheaf t ↔
      y ∉ (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).supportSet := by
  set s' := (Stacks.NonvanishingSpelling.sectionsEquiv Y D.divisorialSheaf).symm t
  have hev : PresheafOfModules.sections.eval s' (Opposite.op ⊤) = t :=
    (Stacks.NonvanishingSpelling.sectionsEquiv Y D.divisorialSheaf).apply_symm_apply t
  have h := AlgebraicGeometry.nonvanishingLocus_eq_compl_supportSet_zeroScheme
    D.divisorialSheaf s' (fun h0 => ht (hev.symm.trans h0))
  have h2 := Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq Y D.divisorialSheaf s'
  have e := (Stacks.NonvanishingSpelling.sectionsEquiv Y D.divisorialSheaf).apply_symm_apply t
  constructor
  · intro hy
    have h3 : y ∈ Stacks.SheafOfModules.nonvanishingLocus D.divisorialSheaf s' := by
      rw [h2, e]
      exact hy
    rw [h] at h3
    rw [← hev]
    exact h3
  · intro hyZ
    have h3 : y ∈ Stacks.SheafOfModules.nonvanishingLocus D.divisorialSheaf s' := by
      rw [h]
      exact fun hm => hyZ (hev ▸ hm)
    rw [h2] at h3
    change y ∈ Stacks.Ample.nonvanishingLocus D.divisorialSheaf t
    exact e ▸ h3

/-- On the nonvanishing open of a nonzero section `t` of `𝒪_Y(D)`, `D` Cartier, the divisor of
zeros `(t)₀` vanishes: such a point is off the zero scheme of `t`, hence so is the generic point of
every prime divisor through it. -/
private theorem notMem_supp_of_mem_nonvanishingOpen {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (D : Divisor Y) (hD : D.IsCartier)
    [Stacks.Ample.IsInvertibleModule Y D.divisorialSheaf]
    (t : D.divisorialSubmodule ⊤) (ht : t ≠ 0) (y : Y)
    (hy : y ∈ Stacks.NonvanishingOpen.nonvanishingOpen Y D.divisorialSheaf t) :
    y ∉ (D.zeroDivisor t ht).supp := by
  have hyZ := (mem_nonvanishingOpen_iff_notMem_supportSet D ht y).1 hy
  intro hmem
  obtain ⟨E, hE, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
  have hEZ : E.genericPoint ∉ (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).supportSet := by
    intro hη
    apply hyZ
    have hcl : IsClosed (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).supportSet :=
      (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).support.isClosed
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyE
    exact hcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη) hyE
  exact hE (coeff_zeroDivisor_eq_zero_of_notMem D hD t ht E hEZ)

end ZeroScheme

end MMP.Mori.AmpleFloorLowering

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold.AmpleFloorLowering

open MMP.Mori

/-! ### Log discrepancies of prime divisors -/

section PrimeDivisorLogDiscrepancy

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The log discrepancy of a prime divisor `P` of `X` with respect to an `ℝ`-divisor `B` with
`K + B` `ℝ`-Cartier is `1 - coeff_P B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [CompactSpace X] (hX : IsNormalVariety k sX)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) {B : RDivisor X}
    (hKB : RDivisor.IsRCartier (Divisor.toRDivisor K + B)) (P : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n B (DivisorOver.ofPrimeDivisor k hX P)
      (1 - B.coeff P) := by
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, r, C, hC, hsum⟩ := hKB
  choose C' hC' using fun i => MMP.Threefold.Bridges.exists_isPullback_of_isDominant (𝟙 X) (hC i)
  have hC'P : ∀ i, (C' i).coeff P = (C i).coeff P := fun i =>
    MMP.Positivity.coeff_eq_of_isPullback (f := 𝟙 X) P P rfl (hC i) (hC' i)
  have hord : (DivisorOver.ofPrimeDivisor k hX P).ordPullback ω = P.ordForm ω :=
    DivisorOver.ordPullback_ofPrimeDivisor hX hK.topologicalKrullDim_eq P ω
  have hsumΓ : ∀ Γ, (Γ.ordForm ω : ℝ) + B.coeff Γ = ∑ i, r i * (C i).coeff Γ := fun Γ => by
    rw [← hsum Γ, hω Γ, DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor]
  refine ⟨hX, (inferInstance : IsProper (𝟙 X)), ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, m, r, C,
    C', hC, hsumΓ, fun i => ⟨_, hC' i⟩, ?_⟩
  change 1 - B.coeff P = 1 + ((DivisorOver.ofPrimeDivisor k hX P).ordPullback ω : ℝ) -
    ∑ i, r i * ((C' i).coeff P : ℝ)
  simp_rw [hC'P, hord]
  rw [← hsumΓ P]
  ring

end PrimeDivisorLogDiscrepancy

/-! ### Serre generation -/

section GlobalGeneration

open Stacks.Ample Stacks.RelativeVeryAmple

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- `𝒪_X(n H + F) ≅ 𝒪_X(F) ⊗ 𝒪_X(H)^{⊗ n}` for Cartier divisors `H` and `F`. -/
private theorem nonempty_divisorialSheaf_nsmul_add_iso {H F : Divisor X} (hH : H.IsCartier)
    (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((n • H + F).divisorialSheaf ≅
      tensorModules X F.divisorialSheaf (tensorPowModule X H.divisorialSheaf (n : ℤ))) := by
  have := hH.isInvertibleModule_divisorialSheaf
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

end GlobalGeneration

/-! ### Log discrepancies with respect to real boundaries -/

section LogDiscrepancy

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- Every divisor over `X` with proper model has a log discrepancy with respect to `B`, once
`K_X + B` is `ℝ`-Cartier. -/
private theorem exists_isLogDiscrepancy [PerfectField k] [CompactSpace X]
    (hX : IsNormalVariety k sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {B : RDivisor X} (hKB : RDivisor.IsRCartier (Divisor.toRDivisor K + B))
    (D : DivisorOver k sX) (hD : IsProper D.f) :
    ∃ a, MMP.Intersection.IsLogDiscrepancy sX n B D a := by
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, r, C, hC, hsum⟩ := hKB
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have : CompactSpace D.Y := QuasiCompact.compactSpace_of_compactSpace D.f
  choose C' hC' using fun i => MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f (hC i)
  exact ⟨_, hX, hD, ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, m, r, C, C', hC, fun Γ => by
    rw [← hsum Γ, hω Γ, DivisorWithCoeffs.coeff_add, Divisor.coeff_toRDivisor],
    fun i => ⟨_, hC' i⟩, rfl⟩

/-- **Log discrepancies are affine in the boundary.** Adding `t L` to the boundary, `L` Cartier,
lowers a log discrepancy by `t` times the coefficient of the pull-back of `L`. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {D : DivisorOver k sX}
    {a : ℝ} (ha : MMP.Intersection.IsLogDiscrepancy sX n B D a) (t : ℝ) {L : Divisor X}
    (hL : L.IsCartier) {L' : Divisor D.Y}
    (hL' : haveI := D.isLocallyNoetherian
      haveI := D.isNormal
      ∃ hB, L.IsPullback D.f hB L') :
    MMP.Intersection.IsLogDiscrepancy sX n (B + t • Divisor.toRDivisor L) D
      (a - t * L'.coeff D.E) := by
  obtain ⟨hX, hp, ω, hω, hK, m, r, C, C', hC, hsum, hpb, rfl⟩ := ha
  refine ⟨hX, hp, ω, hω, hK, m + 1, Fin.cons t r, Fin.cons L C, Fin.cons L' C', fun i => ?_,
    fun Γ => ?_, fun i => ?_, ?_⟩
  · refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hL
    · simpa using hC j
  · rw [Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    rw [← hsum Γ]
    ring
  · refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hL'
    · simpa using hpb j
  · rw [Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ]
    ring

omit [IsIntegral X] in
/-- Adding a real multiple of a Cartier divisor keeps a divisor `ℝ`-Cartier. -/
private theorem isRCartier_add_smul {D : RDivisor X} (hD : RDivisor.IsRCartier D) (t : ℝ)
    {L : Divisor X} (hL : L.IsCartier) : RDivisor.IsRCartier (D + t • Divisor.toRDivisor L) := by
  obtain ⟨m, r, C, hC, hsum⟩ := hD
  refine ⟨m + 1, Fin.cons t r, Fin.cons L C, fun i => ?_, fun Γ => ?_⟩
  · refine Fin.cases ?_ (fun j => ?_) i
    · simpa using hL
    · simpa using hC j
  · rw [Fin.sum_univ_succ]
    simp only [Fin.cons_zero, Fin.cons_succ, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul, hsum Γ]
    ring

end LogDiscrepancy

end MMP.Fourfold.AmpleFloorLowering

/-! ### Very ample systems -/

namespace MMP.Fourfold.IndependentScalingBoundary

open MMP.Intersection MMP.Threefold.Bridges
open Stacks.Ample Stacks.ProjectiveFromSections Stacks.AmpleProjectiveImmersion
open Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections (globalSectionsModule baseRingHom
  morphismOfGeneratingSections)
open Stacks.NonvanishingOpen (nonvanishingOpen)

attribute [local instance] globalSectionsModule

/-- A morphism `i : X ⟶ ℙʳ_S` over `S` with `M ≅ i^*𝒪(1)` is the morphism of a generating family
of sections of `M` (the uniqueness half of [Stacks, Tag 01NE]). -/
private theorem exists_generatesStalks_eq_toProjectiveSpaceOver {X S : Scheme.{0}} (f : X ⟶ S)
    {r : ℕ} (M : X.Modules) [IsInvertibleModule X M] (i : X ⟶ projectiveSpaceOver r S)
    (hi : i ≫ (projectiveSpaceOver r S ↘ S) = f)
    (e : M ≅ (Scheme.Modules.pullback i).obj (projectiveSpaceTwistingSheaf r S)) :
    ∃ (t : Fin (r + 1) → Γ(M, ⊤)) (ht : GeneratesStalks t),
      toProjectiveSpaceOver t ht f = i := by
  have hlift : liftOver f (i ≫ projectiveSpaceOver.toIntegralAtUniverse r S) = i :=
    liftOver_eq f i hi
  let g : X ⟶ projectiveSpaceAtUniverse.{0} r := i ≫ projectiveSpaceOver.toIntegralAtUniverse r S
  let β : (Scheme.Modules.pullback g).obj (twistingSheafAtUniverse.{0} r) ≅ M :=
    (liftOverTwistIso f g).symm ≪≫
      Stacks.RelativeAmpleBaseChange.pullbackModuleCongr hlift
        (projectiveSpaceTwistingSheaf r S) ≪≫ e.symm
  have ht : GeneratesStalks (fun j => Scheme.Modules.Hom.app β.hom ⊤
      (Stacks.TwistPullbackPinned.pullbackCoordSection g j)) :=
    Stacks.ProductFamilyTwist.generatesStalks_congr β
      (Stacks.ProjectiveSpaceModuli.taut_generates g)
  refine ⟨_, ht, ?_⟩
  have hgt : g = toProjectiveSpaceAtUniverse _ ht :=
    Stacks.ProjectiveSpaceModuli.eq_of_pin _ ht g _
      (fun j => Stacks.ProjectiveSpaceModuli.pin_of_iso _ _ β (fun _ => rfl) g
        (Stacks.ProjectiveSpaceModuli.taut_pin g) j)
      (fun j => ι_toProjectiveSpaceAtUniverse _ ht j)
  rw [toProjectiveSpaceOver, ← hgt]
  exact hlift

/-- The morphism of a generating family depends only on the family. -/
private theorem toProjectiveSpaceOver_congr' {X S : Scheme.{0}} {M : X.Modules}
    [IsInvertibleModule X M] {r : ℕ} (f : X ⟶ S) {t t' : Fin (r + 1) → Γ(M, ⊤)}
    (h : t = t') (ht : GeneratesStalks t) (ht' : GeneratesStalks t') :
    toProjectiveSpaceOver t ht f = toProjectiveSpaceOver t' ht' f := by
  subst h
  rfl

open Stacks.AlgebraicGeometry.ProjectiveSpaceCoordinateSquare in
/-- A very ample invertible sheaf carries finitely many sections, each point lying off the zeros
of one of them, whose morphism to projective space is an immersion. -/
private theorem exists_family_isImmersion (k : Type) [Field k] {X : Scheme.{0}}
    [X.Over (Spec (.of k))] (L : X.Modules) [IsInvertibleModule X L]
    (hL : MMP.Intersection.IsVeryAmple k L) :
    ∃ (N : ℕ) (s : Fin (N + 1) → Γ(L, ⊤)) (_ : ∀ x : X, ∃ j, x ∈ nonvanishingOpen X L (s j))
      (hs : ⨆ c : Fin (N + 1) → k, nonvanishingOpen X L (systemSection s c) = ⊤),
      IsImmersion (morphismOfGeneratingSections k (Fin (N + 1) → k) L
        (systemSection s) hs) := by
  obtain ⟨n, i, hi, hover, ⟨e⟩⟩ :=
    MMP.Resolution.Bridges.hasImmersionTwistOver_of_isVeryAmple k L L hL (Iso.refl _)
  obtain ⟨t, ht, hti⟩ := exists_generatesStalks_eq_toProjectiveSpaceOver _ _ i hover e
  have hsingle : ∀ j, systemSection (k := k) t (Pi.single j 1) = t j := fun j => by
    simp [systemSection, Fintype.linearCombination_apply_single]
  have hs : ⨆ c : Fin (n + 1) → k, nonvanishingOpen X L (systemSection t c) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨j, hj⟩ := exists_mem_nvCover_of_generatesStalks t ht x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨Pi.single j 1, by rwa [hsingle]⟩
  refine ⟨n, t, fun x => exists_mem_nvCover_of_generatesStalks t ht x, hs, ?_⟩
  let b := Pi.basisFun k (Fin (n + 1))
  have h := morphismOfGeneratingSections_comp_basisProjectiveSpaceOfModuleIso b
    (systemSection t) hs
  have hb : Stacks.AlgebraicGeometry.ProjectiveSpaceCoordinateSquare.basisSections b
      (systemSection t) = t := funext fun j => by
    rw [← hsingle j]
    simp [Stacks.AlgebraicGeometry.ProjectiveSpaceCoordinateSquare.basisSections, b]
  rw [toProjectiveSpaceOver_congr' _ hb _ ht, hti] at h
  let E := (Over.forget _).mapIso (AlgebraicGeometry.basisProjectiveSpaceOfModuleIso b)
  rw [(Iso.eq_comp_inv E).mpr h]
  have hE : IsImmersion E.inv := inferInstance
  exact @IsImmersion.comp _ _ _ i E.inv hi hE

/-- A dense open of the coefficient space `𝔸ᴺ⁺¹_k` over an infinite field contains a `k`-point
`c` at which a given nonzero polynomial does not vanish. -/
private theorem exists_coefficientPoint_mem_and_eval_ne_zero {k : Type} [Field k] [Infinite k]
    {N : ℕ} (U : (coefficientSpace k N).Opens) (hU : Dense (U : Set (coefficientSpace k N)))
    {g : MvPolynomial (Fin (N + 1)) k} (hg : g ≠ 0) :
    ∃ c : Fin (N + 1) → k, coefficientPoint c ∈ U ∧ MvPolynomial.eval c g ≠ 0 := by
  haveI : Nonempty (coefficientSpace k N) := ⟨coefficientPoint 0⟩
  obtain ⟨p, hp⟩ := hU.nonempty
  obtain ⟨_, ⟨f, rfl⟩, hpf, hfU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp U.2
  have hf : f ≠ 0 := by
    rintro rfl
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hpf (Submodule.zero_mem _)
  obtain ⟨c, hc⟩ : ∃ c, MvPolynomial.eval c (f * g) ≠ 0 := by
    by_contra h
    push Not at h
    exact mul_ne_zero hf hg (MvPolynomial.funext fun c => by simpa using h c)
  rw [map_mul] at hc
  refine ⟨c, hfU ?_, right_ne_zero_of_mul hc⟩
  exact (PrimeSpectrum.mem_basicOpen _ _).mpr fun h => left_ne_zero_of_mul hc h

/-! ### Integral coefficients as real coefficients -/

/-- The real divisor `Finsupp.mapRange Int.cast K` is `Divisor.toRDivisor K`. -/
private theorem mapRange_intCast_eq_toRDivisor {X : Scheme.{0}} (K : MMP.Mori.Divisor X) :
    Finsupp.mapRange (Int.cast : ℤ → ℝ) Int.cast_zero K = MMP.Mori.Divisor.toRDivisor K :=
  Finsupp.ext fun P => by
    rw [Finsupp.mapRange_apply, ← MMP.Mori.DivisorWithCoeffs.coeff_apply,
      ← MMP.Mori.DivisorWithCoeffs.coeff_apply (MMP.Mori.Divisor.toRDivisor K),
      MMP.Mori.Divisor.coeff_toRDivisor]

/-! ### Integral members are prime divisors -/

section PrimeMember

open MMP.Mori MMP.Mori.AmpleFloorLowering

/-- **A section with integral zero scheme vanishes along one prime divisor.** If the zero scheme
of a nonzero section `t` of `𝒪_Y(D)`, `D` Cartier, is integral, its divisor of zeros is a prime
divisor `P`: the support of the zero scheme is the closure of one point `ξ`, every prime divisor
along which `t` vanishes has its generic point in it, a generic point of codimension one is not a
strict specialization of a point other than the generic point of `Y`, and the generic point of `Y`
is off the zeros of `t`; reducedness gives multiplicity one. -/
private theorem exists_zeroDivisor_eq_single {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (D : Divisor Y) (hD : D.IsCartier)
    [Stacks.Ample.IsInvertibleModule Y D.divisorialSheaf]
    (t : D.divisorialSubmodule ⊤) (ht : t ≠ 0)
    (hZ : IsIntegral (AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t).subscheme) :
    ∃ P : MMP.Mori.PrimeDivisor Y, D.zeroDivisor t ht = Finsupp.single P 1 := by
  classical
  set Z := AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t with hZdef
  have hS : Z.supportSet = Set.range Z.subschemeι :=
    (Scheme.IdealSheafData.range_subschemeι Z).symm
  have hSirr : IsIrreducible Z.supportSet := by
    rw [hS, ← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ Z.subscheme).image _
      Z.subschemeι.continuous.continuousOn
  have hScl : IsClosed Z.supportSet := Z.support.isClosed
  set ξ := hSirr.genericPoint
  have hξ : closure {ξ} = Z.supportSet := (hSirr.isGenericPoint_genericPoint_closure).trans
    hScl.closure_eq
  -- a point of the zero scheme, and a prime divisor through it
  obtain ⟨y, hy⟩ : Z.supportSet.Nonempty := hSirr.nonempty
  have hysupp : y ∈ (D.zeroDivisor t ht).supp := by
    by_contra h
    exact (mem_nonvanishingOpen_iff_notMem_supportSet D ht y).1
      (mem_nonvanishingOpen_of_notMem_supp D hD t ht y h) hy
  obtain ⟨E, hE, -⟩ := DivisorWithCoeffs.mem_supp_iff.mp hysupp
  have hEZ : E.genericPoint ∈ Z.supportSet := by
    by_contra h
    exact hE (coeff_zeroDivisor_eq_zero_of_notMem D hD t ht E h)
  -- every prime divisor with generic point in the zero scheme has generic point `ξ`
  have huniq : ∀ F : MMP.Mori.PrimeDivisor Y, F.genericPoint ∈ Z.supportSet →
      F.genericPoint = ξ := by
    intro F hF
    have hsp : ξ ⤳ F.genericPoint := specializes_iff_mem_closure.mpr (hξ ▸ hF)
    by_contra hne
    have hlt : F.genericPoint < ξ := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hsp)
      fun hle => hne (hsp.antisymm (Scheme.le_iff_specializes.mp hle)).eq.symm
    have h0 : Order.coheight ξ = 0 := by
      have := Order.coheight_strictAnti hlt
        ((Order.coheight_anti hlt.le).trans_lt (by simp [F.coheight_genericPoint]))
      rw [F.coheight_genericPoint] at this
      exact ENat.lt_one_iff_eq_zero.mp this
    set g := componentGenericPoint Y (pointComponent ξ)
    have hg : g ⤳ ξ := (isGenericPoint_componentGenericPoint Y _).specializes (mem_pointComponent ξ)
    have hgξ : g = ξ := by
      by_contra hne'
      have hlt' : ξ < g := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hg)
        fun hle => hne' (hg.antisymm (Scheme.le_iff_specializes.mp hle)).eq
      have := Order.coheight_strictAnti hlt'
        ((Order.coheight_anti hlt'.le).trans_lt (by simp [h0]))
      rw [h0] at this
      exact not_lt_zero this
    have hgS : g ∈ Z.supportSet := by
      rw [hgξ, ← hξ]
      exact subset_closure rfl
    have hgn : (𝟙 Y) g ∉ (D.zeroDivisor t ht).supp :=
      MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant (𝟙 Y) _ _
    exact (mem_nonvanishingOpen_iff_notMem_supportSet D ht g).1
      (mem_nonvanishingOpen_of_notMem_supp D hD t ht g hgn) hgS
  refine ⟨E, Finsupp.ext fun F => ?_⟩
  rw [← DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
  by_cases hF : F.genericPoint ∈ Z.supportSet
  · have hFE : E = F := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((huniq E hEZ).trans (huniq F hF).symm)
    rw [if_pos hFE]
    exact coeff_zeroDivisor_eq_one_of_isReduced D hD t ht F hF
  · have hFE : E ≠ F := fun h => hF (h ▸ hEZ)
    rw [if_neg hFE]
    exact coeff_zeroDivisor_eq_zero_of_notMem D hD t ht F hF

end PrimeMember

/-! ### The Cartier divisor of a divisor of zeros -/

section CartierOfZeros

open MMP.Mori

/-- On a locally Noetherian normal scheme, the valuation along a prime divisor `Q` of a nonzero
element `t` of `𝒪_{X,Q}` is its order of vanishing `ord(t)`. -/
private theorem valuation_toComponent_eq_ord {Y : Scheme.{0}} [IsLocallyNoetherian Y]
    [IsNormal Y] (Q : MMP.Mori.PrimeDivisor Y) {t : Q.localRing} (ht : t ≠ 0) :
    Q.valuation (Q.toComponent.hom t) =
      WithZero.exp ((Ring.ord Q.localRing t).toNat : ℤ) := by
  let := Q.toComponent.hom.toAlgebra
  have := isFractionRing_stalkToRationalFunctions Q.genericPoint_mem_component
  have : Ring.KrullDimLE 1 Q.localRing := krullDimLE_of_coheight_le Q.coheight_genericPoint.le
  have := Q.isDiscreteValuationRing_localRing
  change Ring.ordFrac Q.localRing (IsLocalization.algEquiv (nonZeroDivisors Q.localRing) _
    (FractionRing Q.localRing) (algebraMap Q.localRing _ t)) = _
  rw [AlgEquiv.commutes, Ring.ordFrac_eq_ord _ ht]
  have hnz : t ∈ nonZeroDivisors Q.localRing := mem_nonZeroDivisors_of_ne_zero ht
  rw [Ring.ordMonoidWithZeroHom_eq_coe _ hnz (n := (Ring.ord Q.localRing t).toNat)
    (ENat.coe_toNat (Ring.ord_ne_top hnz)).symm]
  rfl

/-- **The divisor of zeros of a section is the Weil divisor of a Cartier divisor.** For a nonzero
section `t` of `𝒪_Y(D)`, `D` Cartier, the local generators of the ideal of the zero scheme of `t`
glue to a Cartier divisor whose order along every prime divisor `E` is the coefficient of `E` in
`(t)₀`: two local generators generate the same ideal of each local ring, so they differ by a
unit. -/
private theorem exists_isWeilDivisorOfCartier_zeroDivisor {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (D : Divisor Y) (hD : D.IsCartier)
    [Stacks.Ample.IsInvertibleModule Y D.divisorialSheaf]
    (t : D.divisorialSubmodule ⊤) (ht : t ≠ 0) :
    ∃ E : Y.CartierDivisor, MMP.Intersection.IsWeilDivisorOfCartier E (D.zeroDivisor t ht) := by
  classical
  choose V hxV a ha hI hc using fun x =>
    MMP.Mori.AmpleFloorLowering.exists_affine_zeroScheme_ideal_eq_span D hD t ht x
  set I := AlgebraicGeometry.zeroScheme Y D.divisorialSheaf t
  have hg0 : ∀ (x y : Y) (hy : y ∈ (V x : Y.Opens)), Y.presheaf.germ (V x) y hy (a x) ≠ 0 := by
    intro x y hy h0
    have hz : a x = 0 := germ_injective_of_isIntegral Y y hy (by rw [h0, map_zero])
    have hZ : componentGenericPoint Y (pointComponent y) ∈ (V x : Y.Opens) :=
      ((isGenericPoint_componentGenericPoint Y _).specializes
        (mem_pointComponent y)).mem_open (V x).1.isOpen hy
    exact ha x _ hZ (by rw [hz, map_zero])
  have hu : ∀ x, IsUnit (MMP.Intersection.toTotalQuotient (V x : Y.Opens) (a x)) := fun x =>
    AlgebraicGeometry.isUnit_toTotalQuotientSheaf_app Y.sheaf (V x : Y.Opens) (a x)
      (fun y hy => show Y.presheaf.germ (V x) y hy (a x) ∈ nonZeroDivisors (Y.presheaf.stalk y)
        from mem_nonZeroDivisors_of_ne_zero (hg0 x y hy))
  have hst : ∀ (x p : Y) (hp : p ∈ (V x : Y.Opens)),
      I.stalkIdeal p = Ideal.span {(Y.presheaf.germ (V x) p hp).hom (a x)} := by
    intro x p hp
    rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk,
      AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ p (V x) hp, hI x, Ideal.map_span,
      Set.image_singleton]
  have hU : iSup (fun x => (V x : Y.Opens)) = ⊤ :=
    eq_top_iff.2 fun x _ => TopologicalSpace.Opens.mem_iSup.2 ⟨x, hxV x⟩
  obtain ⟨C, hC⟩ := MMP.Intersection.exists_isLocalEquationOn_of_germ_eq_mul
    (fun x => (V x : Y.Opens)) hU (fun x => (hu x).unit) (by
    intro i j p hi hj
    have hassoc : Associated (Y.presheaf.germ (V i) p hi (a i))
        (Y.presheaf.germ (V j) p hj (a j)) :=
      Ideal.span_singleton_eq_span_singleton.mp ((hst i p hi).symm.trans (hst j p hj))
    obtain ⟨w, hw⟩ := hassoc
    refine ⟨w, ?_⟩
    simp only [IsUnit.unit_spec]
    rw [MMP.Intersection.germ_toTotalQuotient, MMP.Intersection.germ_toTotalQuotient, ← hw,
      map_mul])
  refine ⟨C, fun Q => ?_⟩
  have hxQ := hxV Q.genericPoint
  have : Ring.KrullDimLE 1
      (Y.presheaf.stalk (MMP.Intersection.primeDivisorSubvariety Q).genericPoint) :=
    krullDimLE_of_coheight_le Q.coheight_genericPoint.le
  have hne := hg0 Q.genericPoint Q.genericPoint hxQ
  have hfr : MMP.Intersection.IsFraction (Y.totalQuotientSheaf.presheaf.germ
      (V Q.genericPoint : Y.Opens) Q.genericPoint hxQ ((hu Q.genericPoint).unit : _))
      (Y.presheaf.germ (V Q.genericPoint) Q.genericPoint hxQ (a Q.genericPoint)) 1 := by
    refine ⟨by rw [map_one]; exact isUnit_one, ?_⟩
    rw [map_one, one_mul, IsUnit.unit_spec, MMP.Intersection.germ_toTotalQuotient]
  have h := MMP.Intersection.isOrderAlong_of_isFraction (D := C)
    (V := MMP.Intersection.primeDivisorSubvariety Q)
    ⟨V Q.genericPoint, hxQ, (hu Q.genericPoint).unit, hC Q.genericPoint, rfl⟩
    (mem_nonZeroDivisors_of_ne_zero hne) (one_mem _) hfr
  convert h using 1
  rw [hc Q.genericPoint Q hxQ]
  have hv := Q.valuation_component
    (MMP.Threefold.Resolution.sectionUnit (a Q.genericPoint) (ha Q.genericPoint))
  rw [← MMP.Threefold.Resolution.toComponent_germ_eq_sectionUnit (a Q.genericPoint)
    (ha Q.genericPoint) Q hxQ, valuation_toComponent_eq_ord Q hne] at hv
  have hv' := WithZero.exp_injective hv
  rw [Ring.ord_one]
  simp only [ENat.toNat_zero, Nat.cast_zero, sub_zero]
  exact hv'.symm

end CartierOfZeros

/-! ### One general member of a very ample system -/

section OneMember

open MMP.Mori MMP.Fourfold.AmpleFloorLowering

attribute [local instance] AlgebraicGeometry.IsVariety.toIsIntegral

/-- **A general member of a very ample system keeps a klt pair klt.** Let `(X, Γ)` be a klt pair
with real boundary on a variety of dimension at least two over an algebraically closed field of
characteristic zero, and `M` a Cartier divisor with `𝒪_X(M)` very ample. A general section `σ` of
`𝒪_X(M)` vanishes along one prime divisor `P` with multiplicity one, `P` is not a component of
`Γ`, and `(X, Γ + hP)` is klt for every `0 ≤ h < 1`.

On a log resolution `π : W ⟶ X` of `(X, Γ)` the pull-back of the general member is reduced, has
no component in the snc divisor `S_W = Ex(π) ∪ π⁻¹(Supp Γ)` and crosses it normally (Bertini);
the general member is integral (Bertini's irreducibility theorem, the system being an embedding
of a variety of dimension at least two). The crepant boundary of `(X, Γ + hP)` is then snc with
coefficients less than one. -/
private theorem exists_primeDivisor_isRealKltPair_add_smul {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} [X.Over (Spec (.of k))] [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (hdim : 2 ≤ topologicalKrullDim X)
    {Γ : RDivisor X} (hΓ : IsRealKltPair (X ↘ Spec (.of k)) Γ)
    {M : Divisor X} (hMc : M.IsCartier) (hva : MMP.Intersection.IsVeryAmple k M.divisorialSheaf)
    {h : ℝ} (h0 : 0 ≤ h) (h1 : h < 1) :
    ∃ P : MMP.Mori.PrimeDivisor X,
      (∃ u : (RationalFunctions X)ˣ, Finsupp.single P 1 = principalDivisor u + M) ∧
      (∃ E : X.CartierDivisor, MMP.Intersection.IsWeilDivisorOfCartier E (Finsupp.single P 1)) ∧
      Γ.coeff P = 0 ∧
      IsRealKltPair (X ↘ Spec (.of k)) (Γ + h • Divisor.toRDivisor (Finsupp.single P 1)) := by
  classical
  set sX := X ↘ Spec (.of k) with hsX
  obtain ⟨hX, hΓ1, ⟨n, K, hK, hKΓ⟩, hΓpos⟩ := hΓ
  rw [mapRange_intCast_eq_toRDivisor] at hKΓ
  have : AlgebraicGeometry.IsVariety k sX := hX.1
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  -- a log resolution of `(X, Γ)`
  obtain ⟨W, π, hres, -, hSNC, -⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX Γ.support
  have hWv : AlgebraicGeometry.IsVariety k (π ≫ sX) := hres.isVariety_source
  have := hWv
  have : IsIntegral W := hWv.toIsIntegral
  have : LocallyOfFiniteType (π ≫ sX) := hWv.toLocallyOfFiniteType
  have : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (π ≫ sX)
  have : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (π ≫ sX)
  have : AlgebraicGeometry.IsNoetherian W := {}
  have : IsProper π := hres.isProjective.isProper
  have hπb : IsBirationalMorphism π := hres.isBirationalMorphism
  have : IsDominant π := hπb.isDominant
  have hπs : IsSmoothResolution sX π := ⟨inferInstance, hπb, hres.isSmoothScheme⟩
  obtain ⟨hW, -, -⟩ := hπs.isNormalVariety hX
  have : IsNormal W := hW.2
  -- the snc divisor `S_W` of all prime divisors in `Ex(π) ∪ π⁻¹(Supp Γ)`
  set C : Set W := (exceptionalSet π : Set W) ∪
    π ⁻¹' (Γ.support.sup fun E => (E.idealSheaf.support : Set X)) with hC
  have hfin := MMP.Resolution.AmpleFloorLowering.finite_setOf_support_subset hSNC
  set SW : Finset (MMP.Mori.PrimeDivisor W) := hfin.toFinset with hSW
  have hmemSW : ∀ F : MMP.Mori.PrimeDivisor W, F ∈ SW ↔ (F.support : Set W) ⊆ C := fun F => by
    rw [hSW, Set.Finite.mem_toFinset]
    rfl
  have hSWsnc : DivisorWithCoeffs.IsSNC (π ≫ sX) (∑ E ∈ SW, Finsupp.single E (1 : ℤ)) :=
    MMP.Resolution.AmpleFloorLowering.isSNC_sum_single_of_support_subset
      hres.isSmoothScheme hSNC SW fun P hP => (hmemSW P).1 hP
  -- the very ample system and the general member
  have := hMc.isInvertibleModule_divisorialSheaf
  obtain ⟨N, s, hs1, hs, himm⟩ := exists_family_isImmersion k M.divisorialSheaf hva
  have := himm
  obtain ⟨⟨U, hUd, hU⟩, -⟩ :=
    MMP.Threefold.Bridges.exists_dense_open_geometricallyIrreducible_zeroScheme s hs
      (hdim.trans_eq (Scheme.Hom.isEmbedding _).toHomeomorph.isHomeomorph.topologicalKrullDim_eq)
  let s' : Fin (N + 1) → M.divisorialSubmodule ⊤ := s
  have hs' : ∀ x : X, ∃ (i : Fin (N + 1)) (hi : s' i ≠ 0),
      x ∉ (M.zeroDivisor (s' i) hi).supp := fun x => by
    obtain ⟨j, hj⟩ := hs1 x
    have hj0 : s' j ≠ 0 := fun h0 => by
      have hx : x ∈ Stacks.Ample.nonvanishingLocus M.divisorialSheaf (s j) := hj
      rw [show s j = 0 from h0, Stacks.Ample.nonvanishingLocus_zero] at hx
      exact hx
    exact ⟨j, hj0,
      MMP.Mori.AmpleFloorLowering.notMem_supp_of_mem_nonvanishingOpen M hMc (s' j) hj0 x hj⟩
  obtain ⟨Q₁, hQ₁0, hQ₁⟩ :=
    MMP.Mori.exists_polynomial_pullback_zeroDivisor_eq_sum_isSNC hX.1
      hπs s' hs' SW hSWsnc
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  obtain ⟨j₀, hj₀, -⟩ := hs' x₀
  obtain ⟨Q₂, hQ₂0, hQ₂⟩ :=
    MMP.Mori.AmpleFloorLowering.exists_polynomial_sum_smul_ne_zero sX s' j₀ hj₀
  have : Infinite k := IsAlgClosed.instInfinite
  obtain ⟨c, hcU, hc⟩ := exists_coefficientPoint_mem_and_eval_ne_zero U hUd (mul_ne_zero hQ₁0 hQ₂0)
  rw [map_mul] at hc
  have hc₁ : MvPolynomial.eval c Q₁ ≠ 0 := left_ne_zero_of_mul hc
  have hc₂ : MvPolynomial.eval c Q₂ ≠ 0 := right_ne_zero_of_mul hc
  set σ : M.divisorialSubmodule ⊤ := ∑ i, scalarsToGlobalSections k sX (c i) • s' i with hσdef
  have hσ : σ ≠ 0 := hQ₂ c hc₂
  have hσsys : MMP.Threefold.Bridges.systemSection (k := k) s c = σ := by
    rw [MMP.Threefold.Bridges.systemSection_apply]
    rfl
  have hint : IsIntegral (AlgebraicGeometry.zeroScheme X M.divisorialSheaf σ).subscheme := by
    have h' := (hU c hcU).2.2
    rwa [hσsys] at h'
  obtain ⟨P, hP⟩ := exists_zeroDivisor_eq_single M hMc σ hσ hint
  set Zσ := M.zeroDivisor σ hσ with hZσ
  have hBσ : ∀ Z' : irreducibleComponents W, π (componentGenericPoint W Z') ∉ Zσ.supp :=
    fun Z' => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant π _ Z'
  have hZc : Zσ.IsCartier := by
    rw [hZσ, Divisor.zeroDivisor_eq]
    exact (Divisor.isCartier_principalDivisor _).add hMc
  obtain ⟨H', hH'⟩ := hZc.exists_isPullback hBσ
  obtain ⟨T, hT, hTSW, hTsnc, -⟩ := hQ₁ c hc₁ hσ hBσ H' hH'
  have hH'c : ∀ E, H'.coeff E = if E ∈ T then 1 else 0 := fun E => by
    rw [hT]
    exact MMP.Mori.AmpleFloorLowering.coeff_sum_single T E
  -- strict transforms of the prime divisors of `X`
  have hstrict : ∀ P : MMP.Mori.PrimeDivisor X, ∃ E : MMP.Mori.PrimeDivisor W,
      π E.genericPoint = P.genericPoint ∧ Zσ.coeff P = H'.coeff E := fun P => by
    obtain ⟨E, heq, hisoE, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hW hπb P
    have := hisoE
    exact ⟨E, heq, (MMP.Positivity.coeff_eq_of_isPullback E P heq hZc hH').symm⟩
  have hZle : ∀ P, Zσ.coeff P ≤ 1 := fun P => by
    obtain ⟨E, -, hE⟩ := hstrict P
    rw [hE, hH'c]
    split_ifs <;> norm_num
  have hsuppΓW : ∀ (P : MMP.Mori.PrimeDivisor X) (F : MMP.Mori.PrimeDivisor W), Γ.coeff P ≠ 0 →
      π F.genericPoint = P.genericPoint → F ∈ SW := by
    intro P F hP hF
    rw [hmemSW, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    refine hSNC.1.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr (Or.inr ?_))
    change π F.genericPoint ∈ (Γ.support.sup fun E => (E.idealSheaf.support : Set X))
    rw [hF]
    have hPΓ : P ∈ Γ.support := Finsupp.mem_support_iff.mpr (by
      rwa [← DivisorWithCoeffs.coeff_apply])
    exact (Finset.le_sup (f := fun E => (E.idealSheaf.support : Set X)) hPΓ)
      (MMP.Positivity.PrimeDivisor.genericPoint_mem_support' P)
  have hZΓ : ∀ P, Γ.coeff P ≠ 0 → Zσ.coeff P = 0 := fun P hP => by
    obtain ⟨E, hE, hZE⟩ := hstrict P
    rw [hZE, hH'c, ite_eq_right]
    exact fun hET => Finset.disjoint_left.mp hTSW hET (hsuppΓW P E hP hE)
  have hZ0 : ∀ P, 0 ≤ Zσ.coeff P := fun P => Divisor.zeroDivisor_nonneg M σ hσ P
  have hΓP : Γ.coeff P = 0 := by
    by_contra hne
    have h1' := hZΓ P hne
    rw [hP, DivisorWithCoeffs.coeff_apply] at h1'
    simp at h1'
  -- the new boundary
  set B : RDivisor X := Γ + h • Divisor.toRDivisor Zσ with hBdef
  have hBc : ∀ Q, B.coeff Q = Γ.coeff Q + h * (Zσ.coeff Q : ℝ) := fun Q => by
    simp only [hBdef, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
      Divisor.coeff_toRDivisor, smul_eq_mul]
  have hB1 : ∀ Q, B.coeff Q < 1 := fun Q => by
    rw [hBc]
    by_cases hQ : Γ.coeff Q = 0
    · have hZ1 : (Zσ.coeff Q : ℝ) ≤ 1 := by exact_mod_cast hZle Q
      have hZ0' : (0 : ℝ) ≤ Zσ.coeff Q := by exact_mod_cast hZ0 Q
      rw [hQ, zero_add]
      nlinarith
    · rw [hZΓ Q hQ]
      push_cast
      linarith [hΓ1 Q]
  have hKB : RDivisor.IsRCartier (Divisor.toRDivisor K + B) := by
    have h' := isRCartier_add_smul hKΓ h hZc
    simpa only [hBdef, add_assoc] using h'
  -- log discrepancies of the prime divisors of `W`
  have hlogF : ∀ (F : MMP.Mori.PrimeDivisor W) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n B ⟨W, π, hW, hπs.isBirationalMorphism, F⟩ a →
        0 < a ∧ (F ∉ SW ∪ T → a = 1) := by
    intro F a ha
    by_cases hFe : (⟨W, π, hW, hπs.isBirationalMorphism, F⟩ : DivisorOver k sX).IsExceptional
    · have hFsupp : (F.support : Set W) ⊆ (exceptionalSet π : Set W) :=
        MMP.Positivity.support_subset_exceptionalSet F hFe
      have hFSW : F ∈ SW := (hmemSW F).2 (hFsupp.trans Set.subset_union_left)
      refine ⟨?_, fun h' => absurd (Finset.mem_union_left _ hFSW) h'⟩
      obtain ⟨aΓ, haΓ⟩ := exists_isLogDiscrepancy hX hK hKΓ
        (⟨W, π, hW, hπs.isBirationalMorphism, F⟩ : DivisorOver k sX) (inferInstance : IsProper π)
      have h2 := isLogDiscrepancy_add_smul haΓ h hZc ⟨_, hH'⟩
      have heq := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h2
      have haΓpos := hΓpos n _ aΓ haΓ
      have hH'F : H'.coeff F = 0 := by
        rw [hH'c, ite_eq_right]
        exact fun hFT => Finset.disjoint_left.mp hTSW hFT hFSW
      rw [heq]
      change 0 < aΓ - h * (H'.coeff F : ℝ)
      rw [hH'F]
      push_cast
      linarith
    · obtain ⟨Q, hv⟩ :=
        MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX _ hFe
      have hb := isLogDiscrepancy_ofPrimeDivisor hX hK hKB Q
      rw [MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hb hv]
      refine ⟨by linarith [hB1 Q], fun hF => ?_⟩
      have hηF : π F.genericPoint = Q.genericPoint :=
        MMP.Threefold.Mori.ModelIndependence.center_eq_of_valuation_eq hX hv
      have hΓQ : Γ.coeff Q = 0 := by
        by_contra h'
        exact hF (Finset.mem_union_left _ (hsuppΓW Q F h' hηF))
      have hZQ : Zσ.coeff Q = 0 := by
        by_contra h'
        apply hF
        refine Finset.mem_union_right _ ?_
        have hmem : Q.genericPoint ∈ (Zσ.supp : Set X) :=
          DivisorWithCoeffs.support_subset_supp h'
            (MMP.Positivity.PrimeDivisor.genericPoint_mem_support' Q)
        have hsupp := MMP.Flips.supp_eq_preimage_supp_of_isPullback hZc
          (Divisor.zeroDivisor_nonneg M σ hσ) hH'
        have hmem' : F.genericPoint ∈ (H'.supp : Set W) := by
          rw [hsupp]
          change π F.genericPoint ∈ (Zσ.supp : Set X)
          rw [hηF]
          exact hmem
        obtain ⟨E, hE, hFE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem'
        have hFE' := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hFE
        rw [hH'c] at hE
        split_ifs at hE with hET
        · rwa [← hFE']
        · exact absurd rfl hE
      rw [hBc, hΓQ, hZQ]
      push_cast
      ring
  have hpos := logDiscrepancy_pos_of_isSmoothResolution hX hK hKB hπs hW (SW ∪ T)
    (by rw [Finset.union_comm]; exact hTsnc) (fun F a ha => (hlogF F a ha).1)
    (fun F hF a ha => (hlogF F a ha).2 hF)
  obtain ⟨E, hE⟩ := exists_isWeilDivisorOfCartier_zeroDivisor M hMc σ hσ
  refine ⟨P, ⟨_, hP.symm.trans (Divisor.zeroDivisor_eq M σ hσ)⟩, ⟨E, hP ▸ hE⟩, hΓP, ?_⟩
  rw [← hP]
  exact ⟨hX, hB1, ⟨n, K, hK, by rw [mapRange_intCast_eq_toRDivisor]; exact hKB⟩, hpos⟩

end OneMember

/-! ### Several general members -/

section Members

open MMP.Mori

open Classical in
/-- The coefficient of `∑ⱼ hⱼ Pⱼ` along `Q`. -/
private theorem coeff_sum_smul_single {X : Scheme.{0}} {l : ℕ} (h : Fin l → ℝ)
    (P : Fin l → MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor X) :
    (∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ))).coeff Q =
      ∑ j, if P j = Q then h j else 0 := by
  rw [MMP.Flips.coeff_sum_smul_toRDivisor]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
  split_ifs <;> simp

/-- The coefficient of `∑ⱼ hⱼ Pⱼ` along `Pᵢ`, for distinct `Pⱼ`, is `hᵢ`. -/
private theorem coeff_sum_smul_single_self {X : Scheme.{0}} {l : ℕ} (h : Fin l → ℝ)
    {P : Fin l → MMP.Mori.PrimeDivisor X} (hP : Function.Injective P) (i : Fin l) :
    (∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ))).coeff (P i) = h i := by
  classical
  rw [coeff_sum_smul_single]
  simp_rw [hP.eq_iff]
  simp

/-- The coefficient of `∑ⱼ hⱼ Pⱼ` along a prime divisor other than the `Pⱼ` is zero. -/
private theorem coeff_sum_smul_single_of_forall_ne {X : Scheme.{0}} {l : ℕ} (h : Fin l → ℝ)
    {P : Fin l → MMP.Mori.PrimeDivisor X} {Q : MMP.Mori.PrimeDivisor X} (hQ : ∀ j, P j ≠ Q) :
    (∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ))).coeff Q = 0 := by
  classical
  rw [coeff_sum_smul_single]
  exact Finset.sum_eq_zero fun j _ => if_neg (hQ j)

/-- **General members of finitely many very ample systems.** For a klt pair `(X, B)` on a variety
of dimension at least two, Cartier divisors `M₀, …, M_{l-1}` with very ample sheaves and real
`0 < hⱼ < 1`, there are distinct prime divisors `Pⱼ ∼ Mⱼ`, each the Weil divisor of a Cartier
divisor and none a component of `B`, with `(X, B + ∑ⱼ hⱼ Pⱼ)` klt. The members are chosen one at a
time, each general for the pair built so far. -/
private theorem exists_primeDivisors_isRealKltPair_add_sum {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} [X.Over (Spec (.of k))] [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (hdim : 2 ≤ topologicalKrullDim X)
    {B : RDivisor X} (hB : IsRealKltPair (X ↘ Spec (.of k)) B) :
    ∀ {l : ℕ} (M : Fin l → Divisor X), (∀ j, (M j).IsCartier) →
      (∀ j, MMP.Intersection.IsVeryAmple k (M j).divisorialSheaf) →
      ∀ h : Fin l → ℝ, (∀ j, 0 < h j) → (∀ j, h j < 1) →
      ∃ P : Fin l → MMP.Mori.PrimeDivisor X,
        (∀ j, ∃ u : (RationalFunctions X)ˣ, Finsupp.single (P j) 1 = principalDivisor u + M j) ∧
        (∀ j, ∃ E : X.CartierDivisor,
          MMP.Intersection.IsWeilDivisorOfCartier E (Finsupp.single (P j) 1)) ∧
        Function.Injective P ∧ (∀ j, B.coeff (P j) = 0) ∧
        IsRealKltPair (X ↘ Spec (.of k))
          (B + ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1))
  | 0, M, _, _, h, _, _ => ⟨Fin.elim0, fun j => j.elim0, fun j => j.elim0,
      fun j => j.elim0, fun j => j.elim0, by simpa using hB⟩
  | l + 1, M, hMc, hva, h, h0, h1 => by
    obtain ⟨P, hPu, hPE, hPinj, hBP, hklt⟩ := exists_primeDivisors_isRealKltPair_add_sum hdim hB
      (fun j => M (Fin.castSucc j)) (fun j => hMc _) (fun j => hva _)
      (fun j => h (Fin.castSucc j)) (fun j => h0 _) (fun j => h1 _)
    obtain ⟨Q, hQu, hQE, hΓQ, hklt'⟩ := exists_primeDivisor_isRealKltPair_add_smul hdim hklt
      (hMc (Fin.last l)) (hva (Fin.last l)) (h0 (Fin.last l)).le (h1 (Fin.last l))
    rw [DivisorWithCoeffs.coeff_add] at hΓQ
    have hQP : ∀ j, P j ≠ Q := fun j hj => by
      rw [← hj, coeff_sum_smul_single_self _ hPinj, hBP] at hΓQ
      have := h0 (Fin.castSucc j)
      linarith
    have hBQ : B.coeff Q = 0 := by
      rwa [coeff_sum_smul_single_of_forall_ne _ hQP, add_zero] at hΓQ
    refine ⟨Fin.snoc P Q, fun j => ?_, fun j => ?_, ?_, fun j => ?_, ?_⟩
    · refine Fin.lastCases ?_ (fun i => ?_) j
      · simpa using hQu
      · simpa using hPu i
    · refine Fin.lastCases ?_ (fun i => ?_) j
      · simpa using hQE
      · simpa using hPE i
    · intro i j
      refine Fin.lastCases ?_ (fun i' => ?_) i <;> refine Fin.lastCases ?_ (fun j' => ?_) j <;>
        intro hij <;> simp only [Fin.snoc_last, Fin.snoc_castSucc] at hij
      · rfl
      · exact absurd hij.symm (hQP j')
      · exact absurd hij (hQP i')
      · rw [hPinj hij]
    · refine Fin.lastCases ?_ (fun i => ?_) j
      · simpa using hBQ
      · simpa using hBP i
    · convert hklt' using 1
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.snoc_last, Fin.snoc_castSucc]
      abel

/-- **`l` reals in an interval, independent over a countable field.** The span over a countable
field of finitely many reals is countable, while a nonempty open interval is not. -/
private theorem exists_linearIndependent_forall_mem_Ioo (K : Type*) [Field K] [Countable K]
    [Module K ℝ] {a b : ℝ} (hab : a < b) (l : ℕ) :
    ∃ h : Fin l → ℝ, (∀ j, h j ∈ Set.Ioo a b) ∧ LinearIndependent K h := by
  induction l with
  | zero => exact ⟨Fin.elim0, fun j => j.elim0, linearIndependent_empty_type⟩
  | succ l ih =>
    obtain ⟨h, hI, hli⟩ := ih
    have hcount : (Submodule.span K (Set.range h) : Set ℝ).Countable := by
      rw [← Fintype.range_linearCombination]
      exact Set.countable_range _
    obtain ⟨x, hxI, hx⟩ : ∃ x ∈ Set.Ioo a b, x ∉ (Submodule.span K (Set.range h) : Set ℝ) := by
      by_contra hcon
      push Not at hcon
      have h1 := hcount.mono hcon
      rw [← Cardinal.le_aleph0_iff_set_countable, Cardinal.mk_Ioo_real hab] at h1
      exact absurd h1 (not_le.mpr Cardinal.aleph0_lt_continuum)
    refine ⟨Fin.snoc h x, fun j => ?_, linearIndependent_fin_snoc.mpr ⟨hli, hx⟩⟩
    refine Fin.lastCases ?_ (fun i => ?_) j <;> simp [hxI, hI]

/-- The subfield of `ℝ` generated over `ℚ` by countably many reals is countable. -/
private theorem countable_adjoin_of_countable {S : Set ℝ} (hS : S.Countable) :
    Countable (IntermediateField.adjoin ℚ S) := by
  rw [← Cardinal.mk_le_aleph0_iff]
  refine (IntermediateField.cardinalMk_adjoin_le (F := ℚ) S).trans (max_le (max_le ?_ ?_) le_rfl)
  · exact Cardinal.mk_le_aleph0
  · exact Cardinal.le_aleph0_iff_set_countable.mpr hS

end Members

/-! ### Ampleness of Cartier divisors -/

section Ampleness

open MMP.Mori Stacks.Ample Stacks.RelativeVeryAmple

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{0}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{0}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{0}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{0, 0, 0} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Ampleness over a field is ampleness.** A Cartier divisor on a scheme of finite type over a
field `k` is ample over `Spec k` exactly when `𝒪_X(L)` is ample. -/
private theorem isRelativelyAmpleCartier_iff_isAmple {k : Type} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] {L : Divisor X}
    (hL : L.IsCartier) : MMP.Flips.IsRelativelyAmpleCartier sX L ↔ L.IsAmple hL := by
  have := hL.isInvertibleModule_divisorialSheaf
  have h := (Stacks.AmpleRelativeFiniteType.tfae_six sX L.divisorialSheaf).out 1 2
  constructor
  · rintro ⟨hL', hU⟩
    exact h.2 ⟨inferInstance, hU⟩
  · intro hA
    exact ⟨hL, (h.1 hA).2⟩

/-- Ampleness of a Cartier divisor depends only on its linear equivalence class. -/
private theorem isAmple_of_linearlyEquivalent {L L' : Divisor X} {hL : L.IsCartier}
    (h : L.IsAmple hL) (hL' : L'.IsCartier) (he : L'.LinearlyEquivalent L) : L'.IsAmple hL' := by
  have := hL.isInvertibleModule_divisorialSheaf
  have := hL'.isInvertibleModule_divisorialSheaf
  exact (isAmple_congr _ _ he.divisorialSheafIso).2 h

/-- `𝒪_X(nH) ≅ 𝒪_X(H)^{⊗ n}` for a Cartier divisor `H` and `n ≥ 1`. -/
private theorem nonempty_divisorialSheaf_nsmul_iso {H : Divisor X} (hH : H.IsCartier) {n : ℕ}
    (hn : 1 ≤ n) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((n • H).divisorialSheaf ≅ tensorPowModule X H.divisorialSheaf (n : ℤ)) := by
  have := hH.isInvertibleModule_divisorialSheaf
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨e⟩ := MMP.Fourfold.AmpleFloorLowering.nonempty_divisorialSheaf_nsmul_add_iso hH hH m
  exact ⟨eqToIso (by rw [succ_nsmul]) ≪≫ e ≪≫
    tensorModulesMapIso X (tensorPowModuleOneIso X _).symm (Iso.refl _) ≪≫
    tensorPowModuleAddIso X _ 1 (m : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring)⟩

/-- A positive multiple of an ample Cartier divisor is ample. -/
private theorem isAmple_nsmul {H : Divisor X} {hH : H.IsCartier} (h : H.IsAmple hH) {n : ℕ}
    (hn : 1 ≤ n) : (n • H).IsAmple (hH.nsmul n) := by
  have := hH.isInvertibleModule_divisorialSheaf
  have := (hH.nsmul n).isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_iso hH hn
  exact (isAmple_congr _ _ e).2 (Stacks.AmplePowers.isAmple_tensorPowModule_of_isAmple _ n hn h)

/-- **Serre's twist.** If `H` is ample and `F` is Cartier, `nH + F` is ample for `n ≫ 0`. -/
private theorem eventually_isAmple_nsmul_add {H F : Divisor X} {hH : H.IsCartier}
    (h : H.IsAmple hH) (hF : F.IsCartier) :
    ∀ᶠ n : ℕ in Filter.atTop, (n • H + F).IsAmple ((hH.nsmul n).add hF) := by
  have := hH.isInvertibleModule_divisorialSheaf
  have := hF.isInvertibleModule_divisorialSheaf
  filter_upwards [eventually_isAmple_tensorModules_tensorPowModule H.divisorialSheaf
    F.divisorialSheaf h] with n hn
  have := ((hH.nsmul n).add hF).isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := MMP.Fourfold.AmpleFloorLowering.nonempty_divisorialSheaf_nsmul_add_iso hH hF n
  exact (@isAmple_congr _ _ _ inferInstance
    (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
      (isInvertibleModule_tensorPowModule _ _ _)) e).2 hn

/-- **Very ample multiples.** On a proper scheme over a field `k`, the multiples `νH` of an ample
Cartier divisor `H` have very ample sheaf `𝒪_X(νH)` for `ν ≫ 0`. -/
private theorem eventually_isVeryAmple_nsmul {k : Type} [Field k] [X.Over (Spec (.of k))]
    [IsProper (X ↘ Spec (.of k))] {H : Divisor X} {hH : H.IsCartier} (h : H.IsAmple hH) :
    ∀ᶠ ν : ℕ in Filter.atTop, MMP.Intersection.IsVeryAmple k (ν • H).divisorialSheaf := by
  have := hH.isInvertibleModule_divisorialSheaf
  have htfae := Stacks.AmpleRelativeFiniteType.tfae_six (X ↘ Spec (.of k)) H.divisorialSheaf
  obtain ⟨d₀, hd₀1, hd₀⟩ := (htfae.out 1 6).1 h
  rw [Filter.eventually_atTop]
  refine ⟨d₀, fun ν hν => ?_⟩
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_iso hH (n := ν) (by omega)
  exact MMP.Resolution.Bridges.isVeryAmple_of_hasImmersionTwistOver k _ _ e (hd₀ ν hν)

end Ampleness

/-! ### Ample real divisors -/

section RealAmple

open MMP.Mori

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- A sum of two ample `ℝ`-divisors is ample. -/
private theorem isRelativelyAmple_add {Z : Scheme.{0}} {g : X ⟶ Z} {A A' : RDivisor X}
    (hA : MMP.Flips.IsRelativelyAmple g A) (hA' : MMP.Flips.IsRelativelyAmple g A') :
    MMP.Flips.IsRelativelyAmple g (A + A') := by
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  obtain ⟨m', r', L', -, hr', hL', rfl⟩ := hA'
  refine ⟨m + m', Fin.append r r', Fin.append L L', by omega, fun j => ?_, fun j => ?_, ?_⟩
  · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hr j
    · simpa using hr' j
  · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hL j
    · simpa using hL' j
  · rw [Fin.sum_univ_add]; simp

/-- A positive multiple of an ample `ℝ`-divisor is ample. -/
private theorem isRelativelyAmple_smul {Z : Scheme.{0}} {g : X ⟶ Z} {A : RDivisor X}
    (hA : MMP.Flips.IsRelativelyAmple g A) {c : ℝ} (hc : 0 < c) :
    MMP.Flips.IsRelativelyAmple g (c • A) := by
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  exact ⟨m, fun j => c * r j, L, hm, fun j => mul_pos hc (hr j), hL, by
    rw [Finset.smul_sum]
    simp_rw [smul_smul]⟩

/-- **Ample `ℝ`-divisors are stable under real linear equivalence.** Adding a real multiple
`t div(φ)` of a principal divisor to an ample `ℝ`-divisor `∑ rᵢ Lᵢ` keeps it ample: for `t > 0`
and an integer `q` with `t/q < r₀`, it is `(r₀ - t/q) L₀ + ∑_{i ≠ 0} rᵢ Lᵢ + (t/q)(L₀ + q div φ)`
with `L₀ + q div φ ∼ L₀`. -/
private theorem isRelativelyAmple_add_smul_principalDivisor [IsIntegral X] {k : Type} [Field k]
    {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX] [QuasiCompact sX] {A : RDivisor X}
    (hA : MMP.Flips.IsRelativelyAmple sX A) (t : ℝ) (φ : (RationalFunctions X)ˣ) :
    MMP.Flips.IsRelativelyAmple sX (A + t • Divisor.toRDivisor (principalDivisor φ)) := by
  -- reduce to `t > 0`
  wlog ht : 0 < t generalizing t φ
  · rcases (not_lt.mp ht).lt_or_eq with ht' | rfl
    · have h := this (-t) φ⁻¹ (by linarith)
      rwa [MMP.Mori.principalDivisor_inv, map_neg, smul_neg, neg_smul, neg_neg] at h
    · simpa using hA
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  set i₀ : Fin m := ⟨0, hm⟩
  obtain ⟨q, hq⟩ := exists_nat_gt (t / r i₀)
  have hq0 : (0 : ℝ) < q := lt_of_le_of_lt (div_nonneg ht.le (hr i₀).le) hq
  have htq : t / q < r i₀ := by
    rw [div_lt_iff₀ hq0]
    rw [div_lt_iff₀ (hr i₀)] at hq
    linarith
  set r' : Fin m → ℝ := fun i => r i - if i = i₀ then t / q else 0
  have hr' : ∀ i, 0 < r' i := fun i => by
    simp only [r']
    split_ifs with h
    · subst h; linarith
    · simpa using hr i
  have hL₀ := (hL i₀).1
  have hc : (L i₀ + principalDivisor (φ ^ q)).IsCartier :=
    hL₀.add (Divisor.isCartier_principalDivisor _)
  have hamp : MMP.Flips.IsRelativelyAmpleCartier sX (L i₀ + principalDivisor (φ ^ q)) := by
    rw [isRelativelyAmpleCartier_iff_isAmple sX hc]
    exact isAmple_of_linearlyEquivalent ((isRelativelyAmpleCartier_iff_isAmple sX hL₀).1 (hL i₀))
      hc ⟨φ ^ q, by abel⟩
  have heq : ∑ j, r j • Divisor.toRDivisor (L j) + t • Divisor.toRDivisor (principalDivisor φ) =
      ∑ j, r' j • Divisor.toRDivisor (L j) +
        (t / q) • Divisor.toRDivisor (L i₀ + principalDivisor (φ ^ q)) := by
    have hpow : principalDivisor (φ ^ q) = q • principalDivisor φ := by
      have := map_nsmul (principalDivisorHom (X := X)) q (Additive.ofMul φ)
      simpa [principalDivisorHom_apply] using this
    simp only [r', sub_smul, Finset.sum_sub_distrib, ite_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, hpow, map_add, map_nsmul, smul_add, smul_smul]
    rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul, div_mul_cancel₀ _ hq0.ne']
    abel
  rw [heq]
  exact isRelativelyAmple_add ⟨m, r', L, hm, hr', hL, rfl⟩
    ⟨1, fun _ => t / q, fun _ => L i₀ + principalDivisor (φ ^ q), le_rfl,
      fun _ => div_pos ht hq0, fun _ => hamp, by simp⟩

/-- Adding finitely many real multiples of principal divisors keeps an `ℝ`-divisor ample. -/
private theorem isRelativelyAmple_add_sum_smul_principalDivisor [IsIntegral X] {k : Type}
    [Field k] {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX] [QuasiCompact sX]
    {A : RDivisor X} (hA : MMP.Flips.IsRelativelyAmple sX A) {ι : Type*} (s : Finset ι)
    (t : ι → ℝ) (φ : ι → (RationalFunctions X)ˣ) :
    MMP.Flips.IsRelativelyAmple sX
      (A + ∑ j ∈ s, t j • Divisor.toRDivisor (principalDivisor (φ j))) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hA
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, add_comm (t j • _), ← add_assoc]
    exact isRelativelyAmple_add_smul_principalDivisor ih _ _

/-- An `ℝ`-Cartier divisor is a real combination of Cartier divisors. -/
private theorem isCartierCombination_of_isRCartier [IsIntegral X] {D : RDivisor X}
    (h : RDivisor.IsRCartier D) : MMP.Flips.IsCartierCombination D := by
  obtain ⟨m, r, C, hC, hD⟩ := h
  refine ⟨m, r, C, hC, Finsupp.ext fun Γ => ?_⟩
  simp only [← MMP.Flips.toRDivisor_eq_mapCoeffs]
  rw [← DivisorWithCoeffs.coeff_apply, hD, ← DivisorWithCoeffs.coeff_apply,
    MMP.Flips.coeff_sum_smul_toRDivisor]

end RealAmple

/-- The spectrum of a field `k` is a normal variety over `k`. -/
private theorem isNormalVariety_id_spec (k : Type) [Field k] :
    MMP.Mori.IsNormalVariety k (𝟙 (Spec (.of k))) :=
  ⟨{ toIsIntegral := inferInstance, toIsSeparated := inferInstance,
      toLocallyOfFiniteType := inferInstance, toQuasiCompact := inferInstance },
    AlgebraicGeometry.isNormal_spec_of_isIntegrallyClosed k⟩

/-! ### Numerical classes of Cartier divisors -/

section Numerical

open MMP.Mori

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [QuasiCompact sX]

/-- A finite integral combination of Cartier divisors is Cartier. -/
private theorem isCartier_finset_sum_zsmul {ι : Type*} (s : Finset ι) {w : ι → Divisor X}
    (hw : ∀ j, (w j).IsCartier) (c : ι → ℤ) : (∑ j ∈ s, c j • w j).IsCartier := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using Divisor.isCartier_zero
  | insert j s hj ih => rw [Finset.sum_insert hj]; exact ((hw j).zsmul _).add ih

/-- The degree along a curve of a finite integral combination of Cartier divisors. -/
private theorem degreeOn_sum_zsmul {C : Scheme.{0}} (i : C ⟶ X) [IsProper (i ≫ sX)]
    (hdim : topologicalKrullDim C ≤ 1) {ι : Type*} (s : Finset ι) {w : ι → Divisor X}
    (hw : ∀ j, (w j).IsCartier) (c : ι → ℤ) (h : (∑ j ∈ s, c j • w j).IsCartier) :
    (∑ j ∈ s, c j • w j).degreeOn k sX i hdim h =
      ∑ j ∈ s, c j * (w j).degreeOn k sX i hdim (hw j) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Divisor.degreeOn_congr Finset.sum_empty h Divisor.isCartier_zero,
      Divisor.degreeOn_zero', Finset.sum_empty]
  | insert j s hj ih =>
    rw [Divisor.degreeOn_congr (Finset.sum_insert hj) h
      (((hw j).zsmul _).add (isCartier_finset_sum_zsmul s hw c)),
      Divisor.degreeOn_add k sX i hdim _ _ ((hw j).zsmul _) (isCartier_finset_sum_zsmul s hw c),
      Divisor.degreeOn_zsmul' k sX i hdim (w j) (hw j), ih (isCartier_finset_sum_zsmul s hw c),
      Finset.sum_insert hj]

/-- The degree along a curve depends only on the linear equivalence class. -/
private theorem degreeOn_eq_of_linearlyEquivalent {C : Scheme.{0}} (i : C ⟶ X)
    [IsProper (i ≫ sX)] (hdim : topologicalKrullDim C ≤ 1) {w w' : Divisor X}
    (hw : w.IsCartier) (hw' : w'.IsCartier) (h : w.LinearlyEquivalent w') :
    w.degreeOn k sX i hdim hw = w'.degreeOn k sX i hdim hw' := by
  have := hw.isInvertibleModule_divisorialSheaf
  have := hw'.isInvertibleModule_divisorialSheaf
  exact degreeOn_eq_of_iso k sX i hdim h.divisorialSheafIso

/-- The intersection number of the class of a Cartier divisor `E` with a proper curve is the
degree along the curve of the Weil divisor of `E`. -/
private theorem intersectionNumber_ofCartier_eq_degreeOn {E : X.CartierDivisor} {w : Divisor X}
    (hE : MMP.Intersection.IsWeilDivisorOfCartier E w) (C : ProperCurve sX) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ E) =
      (w.degreeOn k sX C.ι C.dim_le hE.isCartier : ℝ) := by
  have := hE.isCartier.isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := hE.nonempty_sheaf_iso_divisorialSheaf
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]
  exact_mod_cast degreeOn_eq_of_iso k sX C.ι C.dim_le e

/-- **The class of a Cartier divisor through its Weil divisor.** If the Weil divisor `w` of `E`
is linearly equivalent to `∑ⱼ cⱼ w'ⱼ`, with `w'ⱼ` the Weil divisors of `E'ⱼ`, then
`[E] = ∑ⱼ cⱼ [E'ⱼ]` in `N¹(X)_ℝ`: both sides have the same degree on every curve. -/
private theorem numericalDivisorClass_ofCartier_eq_sum {E : X.CartierDivisor} {w : Divisor X}
    (hE : MMP.Intersection.IsWeilDivisorOfCartier E w) {m : ℕ}
    {E' : Fin m → X.CartierDivisor} {w' : Fin m → Divisor X}
    (hE' : ∀ j, MMP.Intersection.IsWeilDivisorOfCartier (E' j) (w' j)) (c : Fin m → ℤ)
    (hw : w.LinearlyEquivalent (∑ j, c j • w' j)) :
    numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E) =
      ∑ j, (c j : ℝ) • numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (E' j)) := by
  simp_rw [← map_smul, ← map_sum]
  refine (Submodule.Quotient.eq _).2 (mem_numericallyTrivialDivisors.2 fun C => ?_)
  change OneCycle.intersectionPairing (sX := sX) (_ - _) (C.cycle ℝ) = 0
  rw [map_sub, map_sum, LinearMap.sub_apply, LinearMap.sum_apply]
  simp only [map_smul, LinearMap.smul_apply, smul_eq_mul]
  change (C.cycle ℝ).intersectionNumber _ -
    ∑ j, (c j : ℝ) * (C.cycle ℝ).intersectionNumber _ = 0
  rw [intersectionNumber_ofCartier_eq_degreeOn hE]
  simp_rw [intersectionNumber_ofCartier_eq_degreeOn (hE' _)]
  have hc := isCartier_finset_sum_zsmul Finset.univ (fun j => (hE' j).isCartier) c
  rw [degreeOn_eq_of_linearlyEquivalent C.ι C.dim_le hE.isCartier hc hw,
    degreeOn_sum_zsmul C.ι C.dim_le Finset.univ (fun j => (hE' j).isCartier) c hc]
  push_cast
  ring

end Numerical

/-! ### An ample basis of `N¹(X)_ℝ` -/

section Spanning

open MMP.Mori MMP.Intersection

/-- On an integral locally Noetherian scheme, a point of coheight zero lies in the support of no
Cartier divisor. -/
private theorem notMem_cartierSupport_of_coheight_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (A : X.CartierDivisor) {x : X} (hx : Order.coheight x = 0) :
    x ∉ cartierSupport A := by
  have : Ring.KrullDimLE 0 (X.presheaf.stalk x) := krullDimLE_of_coheight_le (by simp [hx])
  have : IsArtinianRing (X.presheaf.stalk x) := isArtinianRing_iff_krullDimLE_zero.mpr this
  exact notMem_cartierSupport_of_isArtinianRing A x

/-- Every Cartier divisor on a Noetherian integral scheme has a Weil divisor. -/
private theorem exists_isWeilDivisorOfCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [TopologicalSpace.NoetherianSpace X] (A : X.CartierDivisor) :
    ∃ w : Divisor X, IsWeilDivisorOfCartier A w := by
  have hfin := MMP.Mori.finite_setOf_genericPoint_mem (isClosed_cartierSupport A)
    (fun s hs h0 => notMem_cartierSupport_of_coheight_eq_zero A h0 hs)
  refine ⟨Finsupp.ofSupportFinite (fun P => primeDivisorOrder P A) (hfin.subset fun P hP => ?_),
    fun P => ?_⟩
  · by_contra h
    have hg : (primeDivisorSubvariety P).genericPoint = P.genericPoint := rfl
    refine hP ((isOrderAlong_primeDivisorOrder A P).eq_zero_of_not_subset fun h' => h ?_)
    change P.genericPoint ∈ cartierSupport A
    rw [← hg]
    exact genericPoint_mem_cartierSupport_iff.mpr h'
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.ofSupportFinite_coe]
    exact isOrderAlong_primeDivisorOrder A P

/-- The Weil divisor of a sum of Cartier divisors is the sum of their Weil divisors. -/
private theorem isWeilDivisorOfCartier_add {X : Scheme.{0}} {A A' : X.CartierDivisor}
    {w w' : Divisor X} (h : IsWeilDivisorOfCartier A w) (h' : IsWeilDivisorOfCartier A' w') :
    IsWeilDivisorOfCartier (A + A') (w + w') := fun P => by
  rw [DivisorWithCoeffs.coeff_add]
  exact (h P).add (h' P)

/-- The Weil divisor of a multiple of a Cartier divisor is the multiple of its Weil divisor. -/
private theorem isWeilDivisorOfCartier_nsmul {X : Scheme.{0}} {A : X.CartierDivisor}
    {w : Divisor X} (h : IsWeilDivisorOfCartier A w) (n : ℕ) :
    IsWeilDivisorOfCartier (n • A) (n • w) := by
  induction n with
  | zero => exact fun P => by simpa using isOrderAlong_zero _
  | succ n ih => rw [succ_nsmul, succ_nsmul]; exact isWeilDivisorOfCartier_add ih h

/-- A projective variety carries a Cartier divisor whose invertible sheaf is ample. -/
private theorem exists_isAmple_cartierSheaf {k : Type} [Field k] {X : Scheme.{0}}
    [IsIntegral X] {sX : X ⟶ Spec (.of k)} [h : AlgebraicGeometry.IsProjectiveVariety k sX] :
    ∃ D : X.CartierDivisor, Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf D) := by
  obtain ⟨⟨L, hL, hrel, hA⟩, -⟩ :=
    MMP.Foundations.IsProjective.exists_isRelativelyAmple h.isProjective.isProjective
  obtain ⟨A, ⟨e⟩⟩ := hA inferInstance
  exact ⟨A, (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mpr
    (Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine sX L hrel)⟩

/-- The real numerical classes are spanned by the classes of integral Cartier divisors. -/
private theorem span_numericalDivisorClass_ofCartier {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) :
    Submodule.span ℝ (Set.range fun E : X.CartierDivisor =>
      MMP.Fourfold.numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E)) = ⊤ := by
  refine Submodule.eq_top_iff'.2 fun x => ?_
  obtain ⟨D, rfl⟩ := Submodule.mkQ_surjective _ x
  change MMP.Fourfold.numericalDivisorClass sX D ∈ _
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' h h' => rw [map_add]; exact add_mem h h'
  | single E c =>
    rw [← mul_one c, ← smul_eq_mul, ← Finsupp.smul_single, map_smul]
    exact Submodule.smul_mem _ c (Submodule.subset_span ⟨E, rfl⟩)

/-- **An ample basis of `N¹(X)_ℝ`.** On a normal projective variety over an algebraically closed
field of characteristic zero there are finitely many Cartier divisors `Gⱼ` whose Weil divisors
`Dⱼ` are ample and whose classes span `N¹(X)_ℝ`. Finitely many Cartier divisors `Fᵢ` span, as
`N¹(X)_ℝ` is finite-dimensional; with `G₀` ample, the divisors `G₀` and `nG₀ + Fᵢ`, `n ≫ 0`, are
ample, and `[Fᵢ] = [nG₀ + Fᵢ] - n[G₀]`. -/
private theorem exists_isAmple_span_numericalDivisorClass_eq_top {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    (hXproj : MMP.Mori.IsProjectiveVariety k sX) :
    ∃ (l : ℕ) (G : Fin l → X.CartierDivisor) (D : Fin l → Divisor X), 0 < l ∧
      (∀ j, IsWeilDivisorOfCartier (G j) (D j)) ∧
      (∀ j, ∃ hc : (D j).IsCartier, (D j).IsAmple hc) ∧
      Submodule.span ℝ (Set.range fun j =>
        MMP.Fourfold.numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (G j))) = ⊤ := by
  classical
  haveI : AlgebraicGeometry.IsProjectiveVariety k sX := hXproj
  have : IsProper sX := hXproj.isProjective.isProjective.isProper
  haveI : AlgebraicGeometry.IsProperVariety k sX :=
    (AlgebraicGeometry.isProperVariety_iff k sX).2 ⟨inferInstance, inferInstance⟩
  have : AlgebraicGeometry.IsNoetherian X := {}
  -- an ample Cartier divisor `G₀` and its Weil divisor `A₀`
  obtain ⟨G₀, hG₀⟩ := exists_isAmple_cartierSheaf (sX := sX)
  obtain ⟨A₀, hA₀⟩ := exists_isWeilDivisorOfCartier G₀
  have hA₀c := hA₀.isCartier
  have hA₀amp : A₀.IsAmple hA₀c := by
    have := hA₀c.isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := hA₀.nonempty_sheaf_iso_divisorialSheaf
    exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).1 hG₀
  -- `N¹(X)_ℝ` is finite-dimensional, so finitely many Cartier classes span it
  have : FiniteDimensional ℝ (NumericalCurveClasses sX) :=
    (MMP.Mori.NumericalCurveClasses.exists_cartier_coordinates_of_isProperVariety.{0} sX).1
  have : FiniteDimensional ℝ (MMP.Fourfold.NumericalDivisorClasses sX) :=
    Module.Finite.of_injective _ (MMP.Fourfold.numericalPairing_injective sX)
  set f : X.CartierDivisor → MMP.Fourfold.NumericalDivisorClasses sX := fun E =>
    MMP.Fourfold.numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ E) with hf
  obtain ⟨T, hTs, hT⟩ := (Submodule.fg_span_iff_fg_span_finset_subset (R := ℝ)
    (Set.range f)).1 (by rw [span_numericalDivisorClass_ofCartier]; exact Module.Finite.fg_top)
  rw [← Set.image_univ] at hTs
  obtain ⟨S, -, rfl⟩ := Finset.subset_set_image_iff.1 hTs
  rw [span_numericalDivisorClass_ofCartier] at hT
  set F : Fin S.card → X.CartierDivisor := fun i => S.equivFin.symm i with hF
  choose w hw using fun i => exists_isWeilDivisorOfCartier (F i)
  obtain ⟨n, hn⟩ := (Filter.eventually_all.2 fun i =>
    eventually_isAmple_nsmul_add hA₀amp (hw i).isCartier).exists
  have hWn : ∀ i, IsWeilDivisorOfCartier (n • G₀ + F i) (n • A₀ + w i) := fun i =>
    isWeilDivisorOfCartier_add (isWeilDivisorOfCartier_nsmul hA₀ n) (hw i)
  refine ⟨S.card + 1, Fin.cons G₀ fun i => n • G₀ + F i, Fin.cons A₀ fun i => n • A₀ + w i,
    Nat.succ_pos _, fun j => ?_, fun j => ?_, ?_⟩
  · refine Fin.cases ?_ (fun i => ?_) j
    · simpa using hA₀
    · simpa using hWn i
  · refine Fin.cases ?_ (fun i => ?_) j
    · exact ⟨hA₀c, hA₀amp⟩
    · exact ⟨_, hn i⟩
  · rw [eq_top_iff, hT, Submodule.span_le]
    intro x hx
    obtain ⟨E, hE, rfl⟩ := Finset.mem_image.1 hx
    set i := S.equivFin ⟨E, hE⟩
    have hFi : F i = E := by simp [hF, i]
    have hrel := numericalDivisorClass_ofCartier_eq_sum (sX := sX) (hWn i) (m := 2)
      (E' := ![F i, G₀]) (w' := ![w i, A₀])
      (fun j => by fin_cases j; exacts [hw i, hA₀]) ![1, (n : ℤ)] (by
        rw [Fin.sum_univ_two]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, one_smul, natCast_zsmul]
        rw [add_comm])
    rw [Fin.sum_univ_two] at hrel
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Int.cast_one, one_smul,
      Int.cast_natCast] at hrel
    have hmem : ∀ j, MMP.Fourfold.numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ
        ((Fin.cons G₀ fun i => n • G₀ + F i : Fin (S.card + 1) → X.CartierDivisor) j)) ∈
        Submodule.span ℝ (Set.range fun j => MMP.Fourfold.numericalDivisorClass sX
          (KCartierDivisor.ofCartier ℝ
            ((Fin.cons G₀ fun i => n • G₀ + F i : Fin (S.card + 1) → X.CartierDivisor) j))) :=
      fun j => Submodule.subset_span ⟨j, rfl⟩
    have h0 := hmem 0
    have hs := hmem i.succ
    simp only [Fin.cons_zero, Fin.cons_succ] at h0 hs
    rw [hrel] at hs
    have : f E = (f E + (n : ℝ) • f G₀) - (n : ℝ) • f G₀ := by abel
    rw [this, ← hFi]
    exact sub_mem hs (Submodule.smul_mem _ _ h0)

end Spanning

end MMP.Fourfold.IndependentScalingBoundary

namespace MMP.Fourfold

open MMP.Mori MMP.Fourfold.IndependentScalingBoundary

/-- **An ample scaling boundary with independent coefficients.** Let `X` be a normal
`ℚ`-factorial projective variety of dimension at least two over an algebraically closed field `k`
of characteristic zero and `(X, B)` a klt pair with effective real boundary `B`. There are distinct
prime divisors `P₁, …, P_l` not in the support of `B`, each the Weil divisor of a Cartier divisor
`Eⱼ` and ample, whose classes `[Eⱼ]` span `N¹(X)_ℝ`, and real numbers `0 < hⱼ < 1` linearly
independent over the field generated over `ℚ` by the coefficients of `B`, such that for
`H = ∑ⱼ hⱼ Pⱼ` the pair `(X, B + H)` is klt and `K_X + B + H` is ample for every canonical
divisor `K_X`. -/
@[mmp "lem_fourfold_independent_scaling_boundary"]
public theorem IsRealKltPair.exists_isRelativelyAmple_add_linearIndependent
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    (hXq : IsQFactorial sX) (hXproj : MMP.Mori.IsProjectiveVariety k sX)
    (hdim : 2 ≤ topologicalKrullDim X)
    {B : RDivisor X} (hB0 : ∀ P, 0 ≤ B.coeff P) (hB : IsRealKltPair sX B) :
    ∃ (l : ℕ) (P : Fin l → MMP.Mori.PrimeDivisor X) (E : Fin l → X.CartierDivisor)
      (h : Fin l → ℝ),
      Function.Injective P ∧
      (∀ j, B.coeff (P j) = 0) ∧
      (∀ j, MMP.Intersection.IsWeilDivisorOfCartier (E j) (Finsupp.single (P j) 1)) ∧
      (∀ j, ∃ hc : Divisor.IsCartier (X := X) (Finsupp.single (P j) 1),
        Divisor.IsAmple (Finsupp.single (P j) 1) hc) ∧
      Submodule.span ℝ (Set.range fun j =>
        numericalDivisorClass sX (MMP.Mori.KCartierDivisor.ofCartier ℝ (E j))) = ⊤ ∧
      (∀ j, 0 < h j ∧ h j < 1) ∧
      LinearIndependent (IntermediateField.adjoin ℚ (Set.range B.coeff)) h ∧
      IsRealKltPair sX (B + ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1)) ∧
      ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
        MMP.Flips.IsRelativelyAmple sX (Divisor.toRDivisor K + B +
          ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1)) := by
  classical
  letI : X.Over (Spec (.of k)) := ⟨sX⟩
  have hX : IsNormalVariety k sX := hB.1
  haveI : AlgebraicGeometry.IsProjectiveVariety k sX := hXproj
  have : IsProper sX := hXproj.isProjective.isProjective.isProper
  have : IsProper (X ↘ Spec (.of k)) := ‹IsProper sX›
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  -- an ample basis `D₀, …, D_{l-1}` of `N¹(X)_ℝ`
  obtain ⟨l, G, D, hl, hGD, hDamp, hspan⟩ :=
    exists_isAmple_span_numericalDivisorClass_eq_top hXproj
  choose hDc hDa using hDamp
  have hDrel : ∀ j, MMP.Flips.IsRelativelyAmpleCartier sX (D j) := fun j =>
    (isRelativelyAmpleCartier_iff_isAmple sX (hDc j)).2 (hDa j)
  set A : RDivisor X := ∑ j, (1 : ℝ) • Divisor.toRDivisor (D j) with hAdef
  have hA : MMP.Flips.IsRelativelyAmple sX A := ⟨l, fun _ => 1, D, hl, fun _ => one_pos, hDrel, rfl⟩
  -- a canonical divisor and openness of the ample cone in the direction `K + B`
  obtain ⟨-, -, ⟨n₀, K, hK, hKB⟩, -⟩ := id hB
  rw [mapRange_intCast_eq_toRDivisor] at hKB
  obtain ⟨δ, hδ, hpert⟩ := MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul k sX
    (𝟙 (Spec (.of k))) hX (isNormalVariety_id_spec k) sX (Category.comp_id sX) hA
    (fun _ : Fin 1 => Divisor.toRDivisor K + B) fun _ => isCartierCombination_of_isRCartier hKB
  -- the multiple `ν`
  obtain ⟨ν, hν4, hνva⟩ := ((Filter.eventually_gt_atTop ⌈4 / δ⌉₊).and
    (Filter.eventually_all.2 fun j => eventually_isVeryAmple_nsmul (k := k) (hDa j))).exists
  have hν1 : 1 ≤ ν := by
    have : 0 < ⌈4 / δ⌉₊ := Nat.ceil_pos.mpr (by positivity)
    omega
  have hν0 : (0 : ℝ) < ν := by exact_mod_cast hν1
  have hνδ : 4 / (ν : ℝ) < δ := by
    have h1 : 4 / δ < ν := (Nat.le_ceil _).trans_lt (by exact_mod_cast hν4)
    rw [div_lt_iff₀ hν0]
    rw [div_lt_iff₀ hδ] at h1
    linarith
  have hY : MMP.Flips.IsRelativelyAmple sX
      ((ν / 4 : ℝ) • (A + (4 / ν : ℝ) • (Divisor.toRDivisor K + B))) := by
    have h' := hpert (fun _ => 4 / ν) fun _ => by
      rw [abs_of_pos (by positivity)]
      exact hνδ
    rw [Fin.sum_univ_one] at h'
    exact isRelativelyAmple_smul h' (by positivity)
  -- the coefficients
  haveI := countable_adjoin_of_countable (S := Set.range B.coeff)
    (Finsupp.finite_range B).countable
  obtain ⟨h, hhI, hhli⟩ := exists_linearIndependent_forall_mem_Ioo
    (IntermediateField.adjoin ℚ (Set.range B.coeff)) (a := 1 / 4) (b := 1 / 2) (by norm_num) l
  -- the general members
  obtain ⟨P, hPu, hPE, hPinj, hBP, hklt⟩ := exists_primeDivisors_isRealKltPair_add_sum hdim hB
    (fun j => ν • D j) (fun j => (hDc j).nsmul ν) hνva h
    (fun j => by linarith [(hhI j).1]) (fun j => by linarith [(hhI j).2])
  choose u hu using hPu
  choose E hE using hPE
  have hPc : ∀ j, Divisor.IsCartier (X := X) (Finsupp.single (P j) 1) := fun j => by
    rw [hu j]
    exact (Divisor.isCartier_principalDivisor _).add ((hDc j).nsmul ν)
  have hPamp : ∀ j, Divisor.IsAmple (Finsupp.single (P j) 1) (hPc j) := fun j =>
    isAmple_of_linearlyEquivalent (isAmple_nsmul (hDa j) hν1) (hPc j) ⟨u j, by rw [hu j]; abel⟩
  refine ⟨l, P, E, h, hPinj, hBP, hE, fun j => ⟨hPc j, hPamp j⟩, ?_,
    fun j => ⟨by linarith [(hhI j).1], by linarith [(hhI j).2]⟩, hhli, hklt, ?_⟩
  · -- the classes `[Eⱼ] = ν [Gⱼ]` span
    have hcl : ∀ j, numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (E j)) =
        (ν : ℝ) • numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (G j)) := fun j => by
      have := numericalDivisorClass_ofCartier_eq_sum (sX := sX) (hE j) (m := 1)
        (E' := fun _ => G j) (w' := fun _ => D j) (fun _ => hGD j) (fun _ => (ν : ℤ))
        ⟨u j, by rw [Fin.sum_univ_one, hu j, natCast_zsmul]; abel⟩
      rw [Fin.sum_univ_one] at this
      simpa using this
    rw [eq_top_iff, ← hspan, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    have : numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (G j)) =
        (ν : ℝ)⁻¹ • numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (E j)) := by
      rw [hcl j, smul_smul, inv_mul_cancel₀ hν0.ne', one_smul]
    dsimp only
    rw [SetLike.mem_coe, this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · -- ampleness of `K' + B + H`
    intro n K' hK'
    obtain ⟨φ, hφ⟩ := MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sX hX hK' hK
    have hP : MMP.Flips.IsRelativelyAmple sX
        (∑ j, (h j - 1 / 4) • Divisor.toRDivisor (Finsupp.single (P j) 1)) :=
      ⟨l, fun j => h j - 1 / 4, fun j => Finsupp.single (P j) 1, hl,
        fun j => by linarith [(hhI j).1],
        fun j => (isRelativelyAmpleCartier_iff_isAmple sX (hPc j)).2 (hPamp j), rfl⟩
    have h2 := isRelativelyAmple_add_sum_smul_principalDivisor (isRelativelyAmple_add hY hP)
      (Finset.univ : Finset (Option (Fin l)))
      (fun o => o.elim 1 fun _ => 1 / 4) (fun o => o.elim φ u)
    convert h2 using 1
    have hS : ∀ j, Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ)) =
        Divisor.toRDivisor (principalDivisor (u j)) + (ν : ℝ) • Divisor.toRDivisor (D j) :=
      fun j => by rw [hu j, map_add, map_nsmul, ← Nat.cast_smul_eq_nsmul ℝ]
    have e1 : (ν / 4 : ℝ) • (A + (4 / ν : ℝ) • (Divisor.toRDivisor K + B)) =
        (ν / 4 : ℝ) • A + (Divisor.toRDivisor K + B) := by
      rw [smul_add, smul_smul, show (ν / 4 : ℝ) * (4 / ν) = 1 by field_simp, one_smul]
    have e2 : ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ)) =
        ∑ j, (h j - 1 / 4) • Divisor.toRDivisor (Finsupp.single (P j) (1 : ℤ)) +
          ∑ j, (1 / 4 : ℝ) • Divisor.toRDivisor (principalDivisor (u j)) + (ν / 4 : ℝ) • A := by
      rw [hAdef, Finset.smul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hS j]
      module
    have e3 : Divisor.toRDivisor K' =
        Divisor.toRDivisor K + Divisor.toRDivisor (principalDivisor φ) := by
      rw [show K' = K + principalDivisor φ by rw [← hφ]; abel, map_add]
    rw [e3, e1, e2, Fintype.sum_option]
    simp only [Option.elim, one_smul]
    abel

end MMP.Fourfold
