namespace Proof_lem_fourfold_independent_level_single_ray

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

section Forms

variable {k : Type} [Field k] {X : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] (sX : X ⟶ Spec (.of k)) [QuasiCompact sX]

/-- The degree form of a Cartier divisor on `N₁(X)`. -/
private noncomputable def degForm (L : Divisor.cartierSubgroup (X := X)) :
    NumericalCurveClasses sX →ₗ[ℝ] ℝ :=
  haveI := (Divisor.mem_cartierSubgroup.mp L.2).isInvertibleModule_divisorialSheaf
  NumericalCurveClasses.degree sX (L : Divisor X).divisorialSheaf

private theorem degForm_numericalClass_cycle (L : Divisor.cartierSubgroup (X := X))
    (C : ProperCurve sX) :
    degForm sX L (OneCycle.numericalClass sX (C.cycle ℝ)) =
      ((L : Divisor X).degreeOn k sX C.ι C.dim_le (Divisor.mem_cartierSubgroup.mp L.2) : ℝ) := by
  unfold degForm
  rw [NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
    ProperCurve.degree_divisorialSheaf]

/-- `L ↦ (z ↦ deg_z 𝒪_X(L))` is additive. -/
private noncomputable def degHom :
    Divisor.cartierSubgroup (X := X) →+ (NumericalCurveClasses sX →ₗ[ℝ] ℝ) where
  toFun := degForm sX
  map_zero' := by
    refine MMP.ProgramBaseChange.linearMap_ext_numericalClass_cycle sX fun C => ?_
    rw [degForm_numericalClass_cycle]
    simp only [LinearMap.zero_apply, Int.cast_eq_zero]
    exact Divisor.degreeOn_zero' k sX C.ι C.dim_le
  map_add' L₁ L₂ := by
    refine MMP.ProgramBaseChange.linearMap_ext_numericalClass_cycle sX fun C => ?_
    rw [LinearMap.add_apply, degForm_numericalClass_cycle, degForm_numericalClass_cycle,
      degForm_numericalClass_cycle]
    have := Divisor.degreeOn_add k sX C.ι C.dim_le (L₁ : Divisor X) (L₂ : Divisor X)
      (Divisor.mem_cartierSubgroup.mp L₁.2) (Divisor.mem_cartierSubgroup.mp L₂.2)
    rw [← Int.cast_add, ← this]
    rfl

/-- The tensor extension `Ca(X) ⊗ ℝ → N₁(X)^*`, `L ⊗ r ↦ r • deg 𝒪_X(L)`. -/
private noncomputable def degTensor :
    Divisor.cartierSubgroup (X := X) ⊗[ℤ] ℝ →+ (NumericalCurveClasses sX →ₗ[ℝ] ℝ) :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun L => AddMonoidHom.mk' (fun r : ℝ => r • degHom sX L)
      fun r s => add_smul r s _) fun L₁ L₂ => by
        ext r : 1
        simp [map_add, smul_add])
    fun n L r => by
      simp [map_zsmul, smul_smul, mul_comm]
      rw [← Int.cast_smul_eq_zsmul ℝ n, smul_smul, mul_comm]

private theorem degTensor_tmul (L : Divisor.cartierSubgroup (X := X)) (r : ℝ) :
    degTensor sX (L ⊗ₜ r) = r • degHom sX L := by
  simp [degTensor]

/-- The value `∑ r_j deg_u 𝒪_X(L_j)` of a presentation. -/
private noncomputable def pval (u : NumericalCurveClasses sX) {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier) : ℝ :=
  ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
    NumericalCurveClasses.degree sX (L j).divisorialSheaf u)

private theorem pval_eq_degTensor (u : NumericalCurveClasses sX) {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier) :
    pval sX u r L hL = degTensor sX (∑ j, (⟨L j, Divisor.mem_cartierSubgroup.mpr (hL j)⟩ :
      Divisor.cartierSubgroup (X := X)) ⊗ₜ[ℤ] r j) u := by
  rw [map_sum, LinearMap.sum_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [degTensor_tmul, LinearMap.smul_apply, smul_eq_mul]
  rfl

/-- **The value of a presentation depends only on the divisor.** -/
private theorem pval_eq (u : NumericalCurveClasses sX) {m m' : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier) {r' : Fin m' → ℝ}
    {L' : Fin m' → Divisor X} (hL' : ∀ j, (L' j).IsCartier)
    (h : ∑ j, r j • Divisor.toRDivisor (L j) = ∑ j, r' j • Divisor.toRDivisor (L' j)) :
    pval sX u r L hL = pval sX u r' L' hL' := by
  rw [pval_eq_degTensor, pval_eq_degTensor,
    sum_tmul_eq_of_sum_smul_eq (fun j => ⟨L j, Divisor.mem_cartierSubgroup.mpr (hL j)⟩) r
      (fun j => ⟨L' j, Divisor.mem_cartierSubgroup.mpr (hL' j)⟩) r' h]

/-- `D` has a presentation by Cartier divisors whose value at `u` is `v`. -/
private def HasVal (D : RDivisor X) (u : NumericalCurveClasses sX) (v : ℝ) : Prop :=
  ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
    D = ∑ j, r j • Divisor.toRDivisor (L j) ∧ pval sX u r L hL = v

variable {sX}

private theorem HasVal.unique {D : RDivisor X} {u : NumericalCurveClasses sX} {v v' : ℝ}
    (h : HasVal sX D u v) (h' : HasVal sX D u v') : v = v' := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  obtain ⟨m', r', L', hL', hD, rfl⟩ := h'
  exact pval_eq sX u hL hL' hD

private theorem hasVal_of_eq {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X)
    (hL : ∀ j, (L j).IsCartier) (u : NumericalCurveClasses sX) :
    HasVal sX (∑ j, r j • Divisor.toRDivisor (L j)) u (pval sX u r L hL) :=
  ⟨m, r, L, hL, rfl, rfl⟩

private theorem hasVal_cartier {L : Divisor X} (hL : L.IsCartier) (u : NumericalCurveClasses sX) :
    HasVal sX (Divisor.toRDivisor L) u
      (haveI := hL.isInvertibleModule_divisorialSheaf;
        NumericalCurveClasses.degree sX L.divisorialSheaf u) :=
  ⟨1, fun _ => 1, fun _ => L, fun _ => hL, (by simp), (by simp [pval])⟩

private theorem hasVal_zero (u : NumericalCurveClasses sX) : HasVal sX 0 u 0 :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, (by simp), (by simp [pval])⟩

private theorem HasVal.add {D₁ D₂ : RDivisor X} {u : NumericalCurveClasses sX} {v₁ v₂ : ℝ}
    (h₁ : HasVal sX D₁ u v₁) (h₂ : HasVal sX D₂ u v₂) : HasVal sX (D₁ + D₂) u (v₁ + v₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, rfl, rfl⟩ := h₁
  obtain ⟨m₂, r₂, L₂, hL₂, rfl, rfl⟩ := h₂
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier := fun j =>
    Fin.addCases (motive := fun j => (Fin.append L₁ L₂ j).IsCartier)
      (fun i => by simpa using hL₁ i) (fun i => by simpa using hL₂ i) j
  refine ⟨m₁ + m₂, Fin.append r₁ r₂, Fin.append L₁ L₂, hL, ?_, ?_⟩
  · simp [Fin.sum_univ_add]
  · simp only [pval, Fin.sum_univ_add, Fin.append_left, Fin.append_right]

private theorem HasVal.smul {D : RDivisor X} {u : NumericalCurveClasses sX} {v : ℝ}
    (h : HasVal sX D u v) (c : ℝ) : HasVal sX (c • D) u (c * v) := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  refine ⟨m, c • r, L, hL, ?_, ?_⟩
  · simp [Finset.smul_sum, smul_smul]
  · simp [pval, Finset.mul_sum, mul_assoc]

private theorem HasVal.sum {n : ℕ} {D : Fin n → RDivisor X} {u : NumericalCurveClasses sX}
    {v : Fin n → ℝ} (h : ∀ i, HasVal sX (D i) u (v i)) : HasVal sX (∑ i, D i) u (∑ i, v i) := by
  induction n with
  | zero => simpa using hasVal_zero u
  | succ n ih =>
    rw [Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
    exact (ih fun i => h _).add (h _)

private theorem HasVal.finsetSum {ι : Type*} (s : Finset ι) {D : ι → RDivisor X}
    {u : NumericalCurveClasses sX} {v : ι → ℝ} (h : ∀ i ∈ s, HasVal sX (D i) u (v i)) :
    HasVal sX (∑ i ∈ s, D i) u (∑ i ∈ s, v i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hasVal_zero u
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact (h a (Finset.mem_insert_self a s)).add (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- The degree form of a Cartier divisor on the class of a proper curve is its degree. -/
private theorem degree_numericalClass_cycle {L : Divisor X} (hL : L.IsCartier)
    (C : ProperCurve sX) :
    (haveI := hL.isInvertibleModule_divisorialSheaf;
      NumericalCurveClasses.degree sX L.divisorialSheaf (OneCycle.numericalClass sX (C.cycle ℝ))) =
      (L.degreeOn k sX C.ι C.dim_le hL : ℝ) := by
  rw [NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
    ProperCurve.degree_divisorialSheaf]

private theorem HasVal.smul_left {D : RDivisor X} {u : NumericalCurveClasses sX} {v : ℝ}
    (h : HasVal sX D u v) (c : ℝ) : HasVal sX D (c • u) (c * v) := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  refine ⟨m, r, L, hL, rfl, ?_⟩
  simp only [pval, map_smul, smul_eq_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- An intersection number is a presentation value on the class of the curve. -/
private theorem IsRIntersectionNumber.hasVal {D : RDivisor X} {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {C : ProperCurve sX} {x : ℝ}
    (h : IsRIntersectionNumber k sX D r L C x) :
    HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ)) x := by
  obtain ⟨hL, d, hD, hd, rfl⟩ := h
  refine ⟨m, r, L, hL, hD, Finset.sum_congr rfl fun j _ => ?_⟩
  rw [degree_numericalClass_cycle (hL j),
    ← MMP.Fourfold.Oai4C1.Negativity.eq_degreeOn_of_isCartierIntersectionNumber (hd j)]

/-- A presentation value on the class of a curve is an intersection number. -/
private theorem HasVal.isRIntersectionNumber {D : RDivisor X} {C : ProperCurve sX} {v : ℝ}
    (h : HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ)) v) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X), IsRIntersectionNumber k sX D r L C v := by
  obtain ⟨m, r, L, hL, hD, rfl⟩ := h
  refine ⟨m, r, L, hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), hD,
    fun j => MMP.Flips.isCartierIntersectionNumber_degreeOn k sX C (L j) (hL j), ?_⟩
  exact Finset.sum_congr rfl fun j _ => by rw [degree_numericalClass_cycle]

/-- Numerically equivalent divisors over `f` have the same value on every curve contracted by
`f`. -/
private theorem HasVal.eq_of_isNumericallyEquivalentOver {Y : Scheme.{0}} {f : X ⟶ Y}
    {E F : RDivisor X} (hEF : IsNumericallyEquivalentOver k sX f E F) {C : ProperCurve sX}
    (hC : C.IsContractedBy f) {v w : ℝ}
    (hE : HasVal sX E (OneCycle.numericalClass sX (C.cycle ℝ)) v)
    (hF : HasVal sX F (OneCycle.numericalClass sX (C.cycle ℝ)) w) : v = w := by
  obtain ⟨m, r, L, hv⟩ := hE.isRIntersectionNumber
  obtain ⟨m', r', L', hw⟩ := hF.isRIntersectionNumber
  exact hEF.2.2 C hC m r L v m' r' L' w hv hw

end Forms

section Sheaves

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]

/-- **An invertible sheaf is the sheaf of a Cartier divisor.** -/
private theorem exists_isCartier_iso (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    ∃ D : Divisor X, D.IsCartier ∧ Nonempty (D.divisorialSheaf ≅ L) := by
  have := Stacks.SheafOfModules.isInvertible_of_tensorInvertible (X := X.toRingedSpace) L
  have : ∀ z : X.toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X.toRingedSpace z) :=
    X.isLocalRing
  choose W hW a ha using fun y : X =>
    Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible (X := X.toRingedSpace) L y
  obtain ⟨y₀⟩ : Nonempty X := inferInstance
  let F : MMP.Mori.LocalFrame L :=
    { W := W, mem := hW, a := a, isLocalGenerator := ha, base := y₀ }
  exact ⟨F.divisor, fun y => ⟨F.W y, F.mem y, (F.unit y)⁻¹, F.isLocalEquation_divisor y⟩,
    ⟨(@asIso _ _ _ _ F.toDivisorialSheaf F.isIso_toDivisorialSheaf).symm⟩⟩

variable {sX : X ⟶ Spec (.of ℂ)}

/-- On a projective variety some invertible sheaf has positive degree on every proper curve. -/
private theorem exists_pos_degree (hX : MMP.Mori.IsProjectiveVariety ℂ sX) :
    ∃ (H : X.Modules) (_ : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 H),
      ∀ C : ProperCurve sX, 0 < C.degree ℂ H := by
  obtain ⟨H, hH, hHa⟩ := MMP.ProgramBaseChange.exists_isAmple_of_isProjectiveVariety hX
  refine ⟨H, hH, fun C => ?_⟩
  haveI : AlgebraicGeometry.IsCurve ℂ (C.ι ≫ sX) := C.isCurve
  exact invertibleCurveDegree_pos_of_isAmple_of_isCurve ℂ (C.ι ≫ sX) C.dim_le _
    (isAmple_pullback_of_isFinite C.ι _ hHa)

end Sheaves

section SingleRay

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

private theorem toRDivisor_apply (D : Divisor X) (E : MMP.Mori.PrimeDivisor X) :
    Divisor.toRDivisor D E = (D E : ℝ) := rfl

/-- Every divisor is the sum of its coefficients times its prime components. -/
private theorem eq_sum_smul_single (D : RDivisor X) :
    D = ∑ P ∈ D.support, D P • Divisor.toRDivisor (Finsupp.single P (1 : ℤ)) := by
  classical
  refine Finsupp.ext fun E => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, toRDivisor_apply, Finsupp.single_apply, smul_eq_mul]
  rw [Finset.sum_eq_single E]
  · simp
  · intro P _ hPE
    simp [hPE]
  · intro hE
    simp [Finsupp.notMem_support_iff.mp hE]

/-- A divisor is the sum of its components, indexed by an enumeration of its support. -/
private theorem eq_sum_single_equivFin (B : RDivisor X) :
    B = ∑ i, Finsupp.single (B.support.equivFin.symm i).1 (B (B.support.equivFin.symm i).1) := by
  classical
  conv_lhs => rw [← Finsupp.sum_single B]
  rw [Finsupp.sum, ← Finset.sum_coe_sort B.support]
  exact (Fintype.sum_equiv B.support.equivFin.symm _ _ fun _ => rfl).symm

private theorem toRDivisor_sum_single {ι : Type*} (s : Finset ι) (P : ι → MMP.Mori.PrimeDivisor X)
    (c : ι → ℚ) : QDivisor.toRDivisor (∑ i ∈ s, Finsupp.single (P i) (c i)) =
      ∑ i ∈ s, Finsupp.single (P i) (c i : ℝ) := by
  simp only [map_sum]
  exact Finset.sum_congr rfl fun i _ => by
    simp [QDivisor.toRDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom, Finsupp.mapRange_single]

/-- On a `ℚ`-factorial variety every `ℝ`-divisor with coefficients in a subfield `S` has, on
every curve, a presentation value in `S`. -/
private theorem exists_hasVal_mem (hXQ : IsQFactorial sX) (D : RDivisor X) (S : Subfield ℝ)
    (hS : ∀ P, D P ∈ S) (C : ProperCurve sX) :
    ∃ v ∈ S, HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ)) v := by
  have hP : ∀ P : MMP.Mori.PrimeDivisor X, ∃ q : ℚ,
      HasVal sX (Divisor.toRDivisor (Finsupp.single P (1 : ℤ)))
        (OneCycle.numericalClass sX (C.cycle ℝ)) q := by
    intro P
    obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
    set E : Divisor X := (m : ℤ) • Finsupp.single P (1 : ℤ) with hE
    refine ⟨((E.degreeOn ℂ sX C.ι C.dim_le hc : ℤ) : ℚ) / m, ?_⟩
    have h := (hasVal_cartier hc (OneCycle.numericalClass sX (C.cycle ℝ))).smul ((m : ℝ)⁻¹)
    rw [degree_numericalClass_cycle hc] at h
    have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
    convert h using 1
    · rw [hE, map_zsmul, ← Int.cast_smul_eq_zsmul ℝ, smul_smul]
      simp [hm']
    · push_cast
      field_simp
  choose q hq using hP
  refine ⟨∑ P ∈ D.support, D P * q P, ?_, ?_⟩
  · exact sum_mem fun P _ => mul_mem (hS P) (SubfieldClass.ratCast_mem S _)
  · have := HasVal.finsetSum D.support fun P _ => (hq P).smul (D P)
    rwa [← eq_sum_smul_single D] at this

/-- **All null curves of `K + B + λ ∑ hⱼ Hⱼ` lie on one ray.** -/
private theorem single_ray {K : Divisor X} {B : RDivisor X} {l : ℕ} {H : Fin l → QDivisor X}
    {h : Fin l → ℝ} {lam : ℝ}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hspan : ∀ E : RDivisor X, IsCartierCombination E →
      ∃ a : Fin l → ℝ,
        IsNumericallyEquivalentOver ℂ sX sX E (∑ j, a j • QDivisor.toRDivisor (H j)))
    (hind : LinearIndependent (Subfield.closure (Set.range B.coeff)) h) (hlam : 0 < lam)
    (C C' : ProperCurve sX)
    (hC : HasVal sX (logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)))
      (OneCycle.numericalClass sX (C.cycle ℝ)) 0)
    (hC' : HasVal sX (logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)))
      (OneCycle.numericalClass sX (C'.cycle ℝ)) 0) :
    ∃ t : ℝ, 0 < t ∧
      OneCycle.numericalClass sX (C.cycle ℝ) = t • OneCycle.numericalClass sX (C'.cycle ℝ) := by
  set k₀ := Subfield.closure (Set.range B.coeff) with hk₀
  set cls : ProperCurve sX → NumericalCurveClasses sX :=
    fun C => OneCycle.numericalClass sX (C.cycle ℝ) with hcls
  -- the values of `K + B` (in `k₀`) and of the `Hⱼ` (rational) on curves
  have hA : ∀ C : ProperCurve sX, ∃ v ∈ k₀, HasVal sX (Divisor.toRDivisor K + B) (cls C) v :=
    fun C => exists_hasVal_mem hXQ _ k₀ (fun P => by
      rw [Finsupp.add_apply]
      exact add_mem (show ((K P : ℤ) : ℝ) ∈ k₀ from intCast_mem k₀ _)
        (Subfield.subset_closure ⟨P, rfl⟩)) C
  have hQ : ∀ (C : ProperCurve sX) (j : Fin l), ∃ q : ℚ,
      HasVal sX (QDivisor.toRDivisor (H j)) (cls C) q := by
    intro C j
    obtain ⟨v, hv, hval⟩ := exists_hasVal_mem hXQ (QDivisor.toRDivisor (H j))
      (Rat.castHom ℝ).fieldRange (fun P => ⟨H j P, rfl⟩) C
    obtain ⟨q, rfl⟩ := hv
    exact ⟨q, hval⟩
  choose a ha hav using hA
  choose q hq using hQ
  -- the value of the level divisor
  have hlev : ∀ C : ProperCurve sX,
      HasVal sX (logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j))) (cls C)
        (a C + lam * ∑ j, h j * q C j) := by
    intro C
    have e : logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
        (Divisor.toRDivisor K + B) + lam • ∑ j, h j • QDivisor.toRDivisor (H j) := by
      rw [logCanonicalDivisor, add_assoc]
    rw [e]
    exact (hav C).add ((HasVal.sum fun j => (hq C j).smul (h j)).smul lam)
  have hnull : ∀ C : ProperCurve sX,
      HasVal sX (logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j))) (cls C) 0 →
        a C + lam * ∑ j, h j * q C j = 0 :=
    fun C hC => (hlev C).unique hC
  -- independence
  have hindep : ∀ g : Fin l → k₀, ∑ j, (g j : ℝ) * h j = 0 → ∀ j, g j = 0 := by
    intro g hg j
    exact Fintype.linearIndependent_iff.mp hind g (by simpa [Subfield.smul_def] using hg) j
  -- degrees of Cartier divisors through the spanning hypothesis
  have hdeg : ∀ (D : Divisor X) (hD : D.IsCartier), ∃ α : Fin l → ℝ, ∀ C : ProperCurve sX,
      (D.degreeOn ℂ sX C.ι C.dim_le hD : ℝ) = ∑ j, α j * q C j := by
    intro D hD
    obtain ⟨α, hα⟩ := hspan (Divisor.toRDivisor D)
      ⟨1, fun _ => 1, fun _ => D, fun _ => hD, by
        ext E; simp [toRDivisor_eq_mapCoeffs]⟩
    refine ⟨α, fun C => ?_⟩
    have h1 := hasVal_cartier hD (cls C)
    rw [degree_numericalClass_cycle] at h1
    have h2 : HasVal sX (∑ j, α j • QDivisor.toRDivisor (H j)) (cls C) (∑ j, α j * q C j) :=
      HasVal.sum fun j => (hq C j).smul (α j)
    exact h1.eq_of_isNumericallyEquivalentOver hα (fun _ _ => Subsingleton.elim _ _) h2
  -- the degree of an invertible sheaf, through a Cartier divisor
  have hdegL : ∀ (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L],
      ∃ α : Fin l → ℝ, ∀ C : ProperCurve sX, (C.degree ℂ L : ℝ) = ∑ j, α j * q C j := by
    intro L _
    obtain ⟨D, hD, ⟨e⟩⟩ := exists_isCartier_iso L
    obtain ⟨α, hα⟩ := hdeg D hD
    refine ⟨α, fun C => ?_⟩
    have := hD.isInvertibleModule_divisorialSheaf
    rw [← MMP.ProgramBaseChange.degree_congr C e, ProperCurve.degree_divisorialSheaf C D hD, hα C]
  obtain ⟨A, hAi, hApos⟩ := exists_pos_degree hX
  obtain ⟨αA, hαA⟩ := hdegL A
  -- `K + B` does not vanish on a null curve
  have ha0 : ∀ C : ProperCurve sX,
      HasVal sX (logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j))) (cls C) 0 →
        a C ≠ 0 := by
    intro C hC ha0
    have hs : ∑ j, ((q C j : ℝ)) * h j = 0 := by
      have := hnull C hC
      rw [ha0, zero_add] at this
      have h' : ∑ j, h j * q C j = 0 :=
        (mul_eq_zero.mp this).resolve_left hlam.ne'
      simpa [mul_comm] using h'
    have hq0 : ∀ j, (q C j : ℝ) = 0 := fun j => by
      have := hindep (fun j => ⟨(q C j : ℝ), SubfieldClass.ratCast_mem k₀ _⟩) hs j
      simpa using congrArg Subtype.val this
    have := hApos C
    have h2 := hαA C
    simp [hq0] at h2
    exact absurd h2 (by exact_mod_cast this.ne')
  have haC := ha0 C hC
  have haC' := ha0 C' hC'
  -- elimination of `λ`
  have hrel : ∀ j, a C' * q C j = a C * q C' j := by
    have hs : ∑ j, ((⟨a C' * q C j - a C * q C' j,
        sub_mem (mul_mem (ha C') (SubfieldClass.ratCast_mem k₀ _))
          (mul_mem (ha C) (SubfieldClass.ratCast_mem k₀ _))⟩ : k₀) : ℝ) * h j = 0 := by
      have e1 := hnull C hC
      have e2 := hnull C' hC'
      have : ∑ j, (a C' * q C j - a C * q C' j) * h j =
          a C' * ∑ j, h j * q C j - a C * ∑ j, h j * q C' j := by
        simp only [sub_mul, Finset.sum_sub_distrib, Finset.mul_sum]
        congr 1 <;> exact Finset.sum_congr rfl fun j _ => by ring
      simp only
      rw [this]
      have hl : lam ≠ 0 := hlam.ne'
      have s1 : ∑ j, h j * q C j = -a C / lam := by field_simp; linarith
      have s2 : ∑ j, h j * q C' j = -a C' / lam := by field_simp; linarith
      rw [s1, s2]; ring
    intro j
    have := hindep _ hs j
    have := congrArg Subtype.val this
    simp only [ZeroMemClass.coe_zero] at this
    linarith
  have hrelL : ∀ (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L],
      a C' * (C.degree ℂ L : ℝ) = a C * (C'.degree ℂ L : ℝ) := by
    intro L _
    obtain ⟨α, hα⟩ := hdegL L
    rw [hα C, hα C', Finset.mul_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by rw [mul_left_comm, hrel j]; ring
  refine ⟨a C / a C', ?_, ?_⟩
  · have h1 := hrelL A
    have p1 : (0 : ℝ) < C.degree ℂ A := by exact_mod_cast hApos C
    have p2 : (0 : ℝ) < C'.degree ℂ A := by exact_mod_cast hApos C'
    have : a C / a C' = C.degree ℂ A / C'.degree ℂ A := by
      field_simp
      linarith
    rw [this]
    exact div_pos p1 p2
  · have key : a C' • cls C = a C • cls C' := by
      simp only [hcls, ← map_smul]
      rw [OneCycle.numericalClass_eq_iff]
      intro L _
      rw [map_smul, map_smul, OneCycle.degree_cycle, OneCycle.degree_cycle, smul_eq_mul,
        smul_eq_mul]
      exact hrelL L
    have : cls C = (a C')⁻¹ • (a C' • cls C) := by
      rw [smul_smul, inv_mul_cancel₀ haC', one_smul]
    change cls C = _ • cls C'
    rw [this, key, smul_smul, div_eq_inv_mul]

end SingleRay

section Transform

/-- Partial maps on prime divisors commute with changes of coefficients. -/
private theorem mapPrimeDivisors_mapRange {Y Y' : Scheme.{0}} {R S : Type*} [AddCommMonoid R]
    [AddCommMonoid S] (g : R →+ S)
    (φ : MMP.Mori.PrimeDivisor Y → Option (MMP.Mori.PrimeDivisor Y'))
    (D : DivisorWithCoeffs R Y) :
    DivisorWithCoeffs.mapPrimeDivisors φ (Finsupp.mapRange.addMonoidHom g D) =
      Finsupp.mapRange.addMonoidHom g (DivisorWithCoeffs.mapPrimeDivisors φ D) := by
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' h h' => simp only [map_add, h, h']
  | single P r =>
    rw [Finsupp.mapRange.addMonoidHom_apply, Finsupp.mapRange_single,
      DivisorWithCoeffs.mapPrimeDivisors_single, DivisorWithCoeffs.mapPrimeDivisors_single]
    cases φ P <;> simp

/-- The coefficients of the image of a divisor under a partial map on prime divisors lie in any
additive submonoid containing its coefficients. -/
private theorem mapPrimeDivisors_apply_mem {Y Y' : Scheme.{0}} {R : Type*} [AddCommMonoid R]
    (S : AddSubmonoid R) (φ : MMP.Mori.PrimeDivisor Y → Option (MMP.Mori.PrimeDivisor Y'))
    (D : DivisorWithCoeffs R Y) (hD : ∀ P, D P ∈ S) (E : MMP.Mori.PrimeDivisor Y') :
    DivisorWithCoeffs.mapPrimeDivisors φ D E ∈ S := by
  classical
  revert hD
  induction D using Finsupp.induction with
  | zero => intro _; simpa using S.zero_mem
  | single_add a b g ha hb ih =>
    intro hD
    have hga : g a = 0 := Finsupp.notMem_support_iff.mp ha
    have hb' : b ∈ S := by simpa [hga] using hD a
    have hg : ∀ P, g P ∈ S := fun P => by
      by_cases hP : P = a
      · subst hP; simpa [hga] using S.zero_mem
      · simpa [Finsupp.single_apply, Ne.symm hP] using hD P
    rw [map_add, Finsupp.add_apply]
    refine S.add_mem ?_ (ih hg)
    rw [DivisorWithCoeffs.mapPrimeDivisors_single]
    cases φ a with
    | none => simpa using S.zero_mem
    | some E' =>
      change Finsupp.single E' b E ∈ S
      rw [Finsupp.single_apply]
      split_ifs
      exacts [hb', S.zero_mem]

variable {X X' Z : Scheme.{0}} (f : X ⟶ Z) (fp : X' ⟶ Z)

private theorem flipTransform_toRDivisor (D : QDivisor X) :
    flipTransform f fp (QDivisor.toRDivisor D) = QDivisor.toRDivisor (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, QDivisor.toRDivisor,
    DivisorWithCoeffs.mapCoeffsAddMonoidHom]
  rw [mapPrimeDivisors_mapRange, mapPrimeDivisors_mapRange]

private theorem flipTransform_toRDivisor_int (D : Divisor X) :
    flipTransform f fp (Divisor.toRDivisor D) = Divisor.toRDivisor (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, Divisor.toRDivisor,
    DivisorWithCoeffs.mapCoeffsAddMonoidHom]
  rw [mapPrimeDivisors_mapRange, mapPrimeDivisors_mapRange]

private theorem flipTransform_toQDivisor_int (D : Divisor X) :
    flipTransform f fp (Divisor.toQDivisor D) = Divisor.toQDivisor (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, Divisor.toQDivisor,
    DivisorWithCoeffs.mapCoeffsAddMonoidHom]
  rw [mapPrimeDivisors_mapRange, mapPrimeDivisors_mapRange]

private theorem flipTransform_smul' (c : ℝ) (D : RDivisor X) :
    flipTransform f fp (c • D) = c • flipTransform f fp D := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, DivisorWithCoeffs.mapPrimeDivisors_smul]

private theorem flipTransform_apply_mem (S : AddSubmonoid ℝ) (D : RDivisor X) (hD : ∀ P, D P ∈ S)
    (E : MMP.Mori.PrimeDivisor X') : flipTransform f fp D E ∈ S :=
  mapPrimeDivisors_apply_mem S _ _ (mapPrimeDivisors_apply_mem S _ D hD) E

end Transform

section Cone

/-- A finite sum of vectors of a convex cone lying in an extremal face has all its summands in
the face. -/
private theorem mem_of_sum_mem_isExtremalFace {V : Type*} [AddCommGroup V] [Module ℝ V]
    {N R : Set V} (hR : IsExtremalFace ℝ N R) (hN0 : (0 : V) ∈ N)
    (hNadd : ∀ u ∈ N, ∀ v ∈ N, u + v ∈ N) {ι : Type*} (s : Finset ι) (z : ι → V)
    (hz : ∀ i ∈ s, z i ∈ N) (hs : ∑ i ∈ s, z i ∈ R) : ∀ i ∈ s, z i ∈ R := by
  classical
  revert hz hs
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    intro hz hs
    rw [Finset.sum_insert ha] at hs
    have hsN : ∑ i ∈ s, z i ∈ N :=
      Finset.sum_induction _ (· ∈ N) (fun a b ha hb => hNadd a ha b hb) hN0 fun i hi =>
        hz i (Finset.mem_insert_of_mem hi)
    obtain ⟨h1, h2⟩ := hR.2.2.2 _ (hz a (Finset.mem_insert_self a s)) _ hsN hs
    intro i hi
    rcases Finset.mem_insert.mp hi with rfl | hi
    · exact h1
    · exact ih (fun i hi => hz i (Finset.mem_insert_of_mem hi)) h2 i hi

/-- **Negative extremal rays of a klt pair are spanned by curves.** -/
private theorem exists_properCurve_mem_of_isExtremalRay {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] [AlgebraicGeometry.IsProjectiveVariety ℂ sX] {n : ℕ} {K : Divisor X}
    {Δ : QDivisor X} (hklt : MMP.Mori.IsKltPair sX n K Δ) (hΔ : Δ.IsEffective)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    (hneg : ∀ u ∈ R, u ≠ 0 →
      QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hklt.1.2.2 u < 0) :
    ∃ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ R ∧
      OneCycle.numericalClass sX (C.cycle ℝ) ≠ 0 := by
  obtain ⟨S, -, -, hNE⟩ := MMP.Mori.exists_countable_isRationalCurve_closedConeOfCurves_eq hklt hΔ
  obtain ⟨hface, v, hv0, hRv⟩ := hR
  have hvR : v ∈ R := hRv ▸ ⟨1, zero_le_one, one_smul _ _⟩
  have hvN : v ∈ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) := hface.1 hvR
  rw [hNE] at hvN
  obtain ⟨w, hw, y, hy, hwy⟩ := Set.mem_add.mp hvN
  have hcl : ∀ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ closedConeOfCurves sX :=
    fun C => coneOfCurves_le_closedConeOfCurves sX (numericalClass_cycle_mem_coneOfCurves sX C)
  have hhull : PointedCone.hull ℝ
      ((fun C : ProperCurve sX => OneCycle.numericalClass sX (C.cycle ℝ)) '' S) ≤
        closedConeOfCurves sX := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨C, -, rfl⟩
    exact hcl C
  have hyN : y ∈ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) := hhull hy
  obtain ⟨hwR, hyR⟩ := hface.2.2.2 w hw.1 y hyN (hwy ▸ hvR)
  have hw0 : w = 0 := by
    by_contra h
    exact absurd hw.2 (not_le.mpr (hneg w hwR h))
  rw [hw0, zero_add] at hwy
  subst hwy
  obtain ⟨m, c, g, hsum⟩ := Submodule.mem_span_set'.mp hy
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero (hsum ▸ hv0)
  have hmem := mem_of_sum_mem_isExtremalFace hface (closedConeOfCurves sX).zero_mem
    (fun u hu v hv => (closedConeOfCurves sX).add_mem hu hv) Finset.univ
    (fun i => c i • (g i : NumericalCurveClasses sX))
    (fun i _ => Submodule.smul_mem (closedConeOfCurves sX) (c i)
      (hhull (Submodule.subset_span (g i).2)))
    (hsum ▸ hyR) i (Finset.mem_univ i)
  obtain ⟨C, -, hC⟩ := (g i).2
  replace hC : OneCycle.numericalClass sX (C.cycle ℝ) = g i := hC
  have hc0 : (c i : ℝ) ≠ 0 := by
    intro h0
    apply hi
    rw [show c i = 0 from NNReal.coe_eq_zero.mp h0, zero_smul]
  refine ⟨C, ?_, ?_⟩
  · rw [hC]
    have h := hface.2.1.2 _ hmem ((c i : ℝ))⁻¹ (inv_pos.mpr (lt_of_le_of_ne (c i).2 (Ne.symm hc0)))
    rwa [show c i • (g i : NumericalCurveClasses sX) =
      ((c i : ℝ)) • (g i : NumericalCurveClasses sX) from rfl, smul_smul, inv_mul_cancel₀ hc0, one_smul] at h
  · rw [hC]
    intro h0
    apply hi
    rw [h0, smul_zero]

end Cone

section QFactorial

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- On a `ℚ`-factorial variety a prime divisor has a presentation by a Cartier divisor. -/
private theorem exists_hasVal_single (hXQ : IsQFactorial sX) (P : MMP.Mori.PrimeDivisor X)
    (u : NumericalCurveClasses sX) :
    ∃ v, HasVal sX (Divisor.toRDivisor (Finsupp.single P (1 : ℤ))) u v := by
  obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
  set E : Divisor X := (m : ℤ) • Finsupp.single P (1 : ℤ) with hE
  have h := (hasVal_cartier hc u).smul ((m : ℝ)⁻¹)
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : Divisor.toRDivisor (Finsupp.single P (1 : ℤ)) = (m : ℝ)⁻¹ • Divisor.toRDivisor E := by
    rw [hE, map_zsmul, ← Int.cast_smul_eq_zsmul ℝ, smul_smul]
    simp [hm']
  rw [← e] at h
  exact ⟨_, h⟩

/-- On a `ℚ`-factorial variety every `ℝ`-divisor has a presentation by Cartier divisors. -/
private theorem exists_hasVal (hXQ : IsQFactorial sX) (D : RDivisor X)
    (u : NumericalCurveClasses sX) : ∃ v, HasVal sX D u v := by
  choose v hv using fun P => exists_hasVal_single hXQ P u
  have := HasVal.finsetSum D.support fun P _ => (hv P).smul (D P)
  rw [← eq_sum_smul_single D] at this
  exact ⟨_, this⟩

private theorem HasVal.isCartierCombination {D : RDivisor X} {u : NumericalCurveClasses sX}
    {v : ℝ} (h : HasVal sX D u v) : IsCartierCombination D := by
  obtain ⟨m, r, L, hL, rfl, -⟩ := h
  exact ⟨m, r, L, hL, by simp [toRDivisor_eq_mapCoeffs]⟩

/-- The curve form of a `ℚ`-Cartier `ℚ`-divisor is the value of its presentations. -/
private theorem hasVal_curveForm (D : QDivisor X) (hD : D.IsQCartier)
    (u : NumericalCurveClasses sX) :
    HasVal sX (QDivisor.toRDivisor D) u (QDivisor.curveForm sX D hD u) := by
  have hEc := Divisor.mem_cartierSubgroup.mp (D.cartierIndexSMul hD).2
  have hm := QDivisor.cartierIndex_pos hD
  have hm' : (D.cartierIndex hD : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hE := QDivisor.toQDivisor_cartierIndexSMul D hD
  have hrel : QDivisor.toRDivisor D = ((D.cartierIndex hD : ℝ))⁻¹ •
      Divisor.toRDivisor (D.cartierIndexSMul hD : Divisor X) := by
    refine Finsupp.ext fun P => ?_
    have h1 := congrArg (fun G : QDivisor X => G P) hE
    simp only [Finsupp.smul_apply, zsmul_eq_mul] at h1
    change ((D P : ℚ) : ℝ) = ((D.cartierIndex hD : ℝ))⁻¹ *
      (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℝ)
    have h2 : (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℚ) =
        ((D.cartierIndex hD : ℤ) : ℚ) * D P := h1
    have h3 : (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℝ) =
        (D.cartierIndex hD : ℝ) * ((D P : ℚ) : ℝ) := by
      have := congrArg (fun q : ℚ => (q : ℝ)) h2
      push_cast at this
      exact this
    rw [h3, ← mul_assoc, inv_mul_cancel₀ hm', one_mul]
  have key := (hasVal_cartier hEc u).smul ((D.cartierIndex hD : ℝ))⁻¹
  rw [← hrel] at key
  convert key using 1
  rw [QDivisor.curveForm, QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier,
    Finsupp.smul_single, Finsupp.sum_single_index (by simp)]
  simp [div_eq_inv_mul]

/-- **A rational klt witness for a negative ray.** If `(X, B)` is a real klt pair and `R` a
`(K + B)`-negative extremal ray, then `R` is `(K + Δ)`-negative for a klt pair `(X, Δ)` with
rational boundary. -/
private theorem exists_isKltPair_neg_of_isRealKltPair (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hXQ : IsQFactorial sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {B : RDivisor X} (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {hL : ∀ j, (L j).IsCartier}
    (hKB : logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j))
    (hneg : ∀ u ∈ R, u ≠ 0 → pval sX u r L hL < 0) :
    ∃ Δ : QDivisor X, IsKltPair sX Δ ∧ ∃ hQ : (Divisor.toQDivisor K + Δ).IsQCartier,
      ∀ u ∈ R, u ≠ 0 → QDivisor.curveForm sX (Divisor.toQDivisor K + Δ) hQ u < 0 := by
  classical
  -- coordinates on the support of `B`
  set T := B.support
  let e : Fin T.card ≃ T := T.equivFin.symm
  let p : Fin T.card → MMP.Mori.PrimeDivisor X := fun i => (e i).1
  have hp : Function.Injective p := fun i j hij => e.injective (Subtype.ext hij)
  have hBp : ∀ P, B.coeff P ≠ 0 → P ∈ Set.range p := fun P hP =>
    ⟨e.symm ⟨P, Finsupp.mem_support_iff.mpr hP⟩, by simp [p]⟩
  have hBsum : B = ∑ i, Finsupp.single (p i) (B (p i)) := eq_sum_single_equivFin B
  -- a rational klt polytope around `B`
  obtain ⟨V, -, hint, -, hkltV⟩ := exists_rationalPolytope_isKltPair_of_isRealKltPair sX hX hXQ
    B hB0 hB 0 le_rfl (by simpa using hB0) p hp hBp (fun P hP => absurd rfl hP)
  set δ : Fin T.card → ℝ := fun i => B (p i) with hδdef
  set V' : Finset (Fin T.card → ℝ) := V.image fun v i => (v i : ℝ) with hV'
  have hδ : δ ∈ convexHull ℝ (V' : Set (Fin T.card → ℝ)) := by
    rw [hV', Finset.coe_image]
    exact intrinsicInterior_subset hint
  obtain ⟨w, hw0, hw1, hwδ⟩ := Finset.mem_convexHull'.mp hδ
  obtain ⟨v, hv0, hRv⟩ := hR.2
  have hvR : v ∈ R := hRv ▸ ⟨1, zero_le_one, one_smul _ _⟩
  have hpre : ∀ y ∈ V', ∃ q ∈ V, (fun i => (q i : ℝ)) = y := fun y hy => Finset.mem_image.mp hy
  choose! q hqV hqy using hpre
  let Δ : (Fin T.card → ℝ) → QDivisor X := fun y => ∑ i, Finsupp.single (p i) (q y i)
  have hΔklt : ∀ y ∈ V', IsKltPair sX (Δ y) := fun y hy => hkltV _ (hqV y hy)
  have hmk : ∀ y ∈ V', MMP.Mori.IsKltPair sX n K (Δ y) := fun y hy =>
    (isKltPair_iff_mori_isKltPair sX hK (hΔklt y hy).1).mp (hΔklt y hy)
  choose a ha using fun y => exists_hasVal hXQ (Divisor.toRDivisor K + QDivisor.toRDivisor (Δ y)) v
  have hD : ∀ y, QDivisor.toRDivisor (Δ y) = ∑ i, Finsupp.single (p i) ((q y i : ℝ)) :=
    fun y => toRDivisor_sum_single _ _ _
  have hδi : ∀ i, ∑ y ∈ V', w y * (q y i : ℝ) = δ i := by
    intro i
    have := congrFun hwδ i
    rw [Finset.sum_apply] at this
    rw [← this]
    refine Finset.sum_congr rfl fun y hy => ?_
    rw [Pi.smul_apply, smul_eq_mul]
    congr 1
    exact congrFun (hqy y hy) i
  have hid : logCanonicalDivisor K B =
      ∑ y ∈ V', w y • (Divisor.toRDivisor K + QDivisor.toRDivisor (Δ y)) := by
    rw [logCanonicalDivisor]
    simp only [smul_add, Finset.sum_add_distrib, ← Finset.sum_smul, hw1, one_smul, hD,
      Finset.smul_sum, Finsupp.smul_single, smul_eq_mul]
    congr 1
    rw [Finset.sum_comm]
    conv_lhs => rw [hBsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finsupp.single_finset_sum, hδi i]
  have hval : HasVal sX (logCanonicalDivisor K B) v (∑ y ∈ V', w y * a y) := by
    rw [hid]
    exact HasVal.finsetSum _ fun y _ => (ha y).smul (w y)
  have hpv := hasVal_of_eq r L hL v
  rw [← hKB] at hpv
  have hlt : ∑ y ∈ V', w y * a y < 0 := by
    rw [← hpv.unique hval]
    exact hneg v hvR hv0
  obtain ⟨y, hy, hay⟩ : ∃ y ∈ V', a y < 0 := by
    by_contra hcon
    push Not at hcon
    have : 0 ≤ ∑ y ∈ V', w y * a y :=
      Finset.sum_nonneg fun y hy => mul_nonneg (hw0 y hy) (hcon y hy)
    linarith
  have hcf : QDivisor.curveForm sX (Divisor.toQDivisor K + Δ y) (hmk y hy).1.2.2 v = a y := by
    have h1 := hasVal_curveForm (sX := sX) (Divisor.toQDivisor K + Δ y) (hmk y hy).1.2.2 v
    rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
    exact h1.unique (ha y)
  refine ⟨Δ y, hΔklt y hy, (hmk y hy).1.2.2, ?_⟩
  intro u hu hu0
  rw [hRv] at hu
  obtain ⟨c, hc, rfl⟩ := hu
  have hc0 : 0 < c := hc.lt_of_ne' fun h => hu0 (by rw [h, zero_smul])
  rw [map_smul, smul_eq_mul, hcf]
  exact mul_neg_of_pos_of_neg hc0 hay

/-- **The cone theorem for real klt pairs**: every negative extremal ray of `NE̅(X)` contains the
class of a curve. -/
private theorem exists_properCurve_mem_of_isRealKltPair (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hXQ : IsQFactorial sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {B : RDivisor X} (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B)
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {hL : ∀ j, (L j).IsCartier}
    (hKB : logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j))
    (hneg : ∀ u ∈ R, u ≠ 0 → pval sX u r L hL < 0) :
    ∃ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ R ∧
      OneCycle.numericalClass sX (C.cycle ℝ) ≠ 0 := by
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  obtain ⟨Δ, hΔ, hQ, hnegΔ⟩ := exists_isKltPair_neg_of_isRealKltPair hX hXQ hK hB0 hB hR hKB hneg
  exact exists_properCurve_mem_of_isExtremalRay ((isKltPair_iff_mori_isKltPair sX hK hΔ.1).mp hΔ)
    (fun P => hΔ.1.nonneg P) hR hnegΔ

end QFactorial

/-- On a `ℚ`-factorial variety every `ℚ`-divisor is `ℚ`-Cartier. -/
private theorem isQCartier_of_isQFactorial {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXQ : IsQFactorial sX)
    (D : QDivisor X) : D.IsQCartier := by
  classical
  have hD : D = ∑ P ∈ D.support, D P • Divisor.toQDivisor (Finsupp.single P (1 : ℤ)) := by
    refine Finsupp.ext fun E => ?_
    rw [Finsupp.finset_sum_apply]
    simp only [Finsupp.smul_apply, smul_eq_mul]
    rw [Finset.sum_eq_single E]
    · simp [Divisor.toQDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom]
    · intro P _ hPE
      simp [Divisor.toQDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom, Finsupp.single_apply, hPE]
    · intro hE
      simp [Finsupp.notMem_support_iff.mp hE]
  rw [hD]
  refine MMP.Flips.QDivisor.isQCartier_sum _ _ fun P _ =>
    MMP.Flips.QDivisor.IsQCartier.qsmul ?_ _
  obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
  have h1 := MMP.Mori.QDivisor.isQCartier_toQDivisor hc
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : Divisor.toQDivisor (Finsupp.single P (1 : ℤ)) =
      ((m : ℚ))⁻¹ • Divisor.toQDivisor ((m : ℤ) • Finsupp.single P (1 : ℤ)) := by
    rw [map_zsmul, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
    simp [hm']
  rw [e]
  exact MMP.Flips.QDivisor.IsQCartier.qsmul h1 _

section Ample

open Stacks.Ample Stacks.RelativeVeryAmple in
/-- **The tensor product of two ample invertible sheaves is ample.** -/
private theorem isAmple_tensorModules' {W : Scheme.{0}} (L M : W.Modules)
    [IsInvertibleModule W L] [IsInvertibleModule W M] (hL : IsAmple W L) (hM : IsAmple W M) :
    haveI := Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules W L M
    IsAmple W (Stacks.RelativeVeryAmple.tensorModules W L M) := by
  haveI := Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules W L M
  haveI : CompactSpace W := hL.1
  refine ⟨inferInstance, fun x => ?_⟩
  obtain ⟨n, hn, s, U, hU, hxU, hUaff⟩ := hL.2 x
  obtain ⟨m, hm, t, V, hV, hxV, -⟩ := hM.2 x
  obtain ⟨s', hs'⟩ :=
    Stacks.AmpleExternalTensor.exists_globalSection_tensorPowModule_mul W L n s m hm
  obtain ⟨t₀, ht₀⟩ :=
    Stacks.AmpleExternalTensor.exists_globalSection_tensorPowModule_mul W M m t n hn
  set t' := (tensorPowModuleCongr W M
    (show ((m * n : ℕ) : ℤ) = ((n * m : ℕ) : ℤ) by push_cast; ring)).hom.app ⊤ t₀ with ht'def
  have ht' : nonvanishingLocus (tensorPowModule W M ((n * m : ℕ) : ℤ)) t' =
      nonvanishingLocus (tensorPowModule W M (m : ℤ)) t := by
    rw [ht'def, nonvanishingLocus_congr, ht₀]
  obtain ⟨c, hc⟩ := Stacks.AmpleExternalTensor.exists_tensorGlobalSection W
    (tensorPowModule W L ((n * m : ℕ) : ℤ)) (tensorPowModule W M ((n * m : ℕ) : ℤ)) s' t'
  have hVo : V = Stacks.NonvanishingOpen.nonvanishingOpen W (tensorPowModule W M (m : ℤ)) t :=
    TopologicalSpace.Opens.ext hV
  refine ⟨n * m, by simpa using Nat.mul_le_mul hn hm,
    (Stacks.AmplePullbackPart1.tensorPowModuleTensorIso W L M (n * m)).symm.hom.app ⊤ c,
    U ⊓ V, ?_, ⟨hxU, hxV⟩, ?_⟩
  · rw [nonvanishingLocus_congr, hc, hs', ht', ← hU, ← hV]
    rfl
  · rw [hVo]
    exact Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen _ t hUaff

variable {X Y : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {g : X ⟶ Y}

/-- The sum of two relatively ample Cartier divisors is relatively ample. -/
private theorem isRelativelyAmpleCartier_add {L L' : Divisor X}
    (h : IsRelativelyAmpleCartier g L) (h' : IsRelativelyAmpleCartier g L') :
    IsRelativelyAmpleCartier g (L + L') := by
  obtain ⟨hL, hamp⟩ := h
  obtain ⟨hL', hamp'⟩ := h'
  refine ⟨hL.add hL', fun U hU => ?_⟩
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := hL'.isInvertibleModule_divisorialSheaf
  haveI := (hL.add hL').isInvertibleModule_divisorialSheaf
  have h1 := hamp U hU
  have h2 := hamp' U hU
  let ι := (g ⁻¹ᵁ U).ι
  let e : (RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).obj
        (L + L').divisorialSheaf ≅
      Stacks.RelativeVeryAmple.tensorModules (g ⁻¹ᵁ U).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).obj L.divisorialSheaf)
        ((RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).obj
          L'.divisorialSheaf) :=
    (RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).mapIso
        (hL.divisorialSheafTensorIso hL').symm ≪≫
      Stacks.RelativeVeryAmple.pullbackTensorModulesIso ι L.divisorialSheaf L'.divisorialSheaf
  haveI := Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules (g ⁻¹ᵁ U).toScheme
    ((RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).obj L.divisorialSheaf)
    ((RingedSpaceModuleAdjunction.modulePullback ι.toLRSHom.toShHom).obj L'.divisorialSheaf)
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mpr (isAmple_tensorModules' _ _ h1 h2)

private theorem isRelativelyAmpleCartier_nsmul {L : Divisor X} (h : IsRelativelyAmpleCartier g L) :
    ∀ n : ℕ, 1 ≤ n → IsRelativelyAmpleCartier g (n • L)
  | 0, h0 => absurd h0 (by norm_num)
  | 1, _ => by simpa using h
  | n + 2, _ => by
    rw [succ_nsmul]
    exact isRelativelyAmpleCartier_add (isRelativelyAmpleCartier_nsmul h (n + 1) (by omega)) h

private theorem isRelativelyAmpleCartier_sum {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    {A : ι → Divisor X} (h : ∀ i ∈ s, IsRelativelyAmpleCartier g (A i)) :
    IsRelativelyAmpleCartier g (∑ i ∈ s, A i) := by
  classical
  induction hs using Finset.Nonempty.cons_induction with
  | singleton a => simpa using h a (Finset.mem_singleton_self a)
  | cons a s ha hs ih =>
    rw [Finset.sum_cons]
    exact isRelativelyAmpleCartier_add (h a (Finset.mem_cons_self a s))
      (ih fun i hi => h i (Finset.mem_cons_of_mem hi))

/-- A Cartier divisor ample over every affine open is relatively ample. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {L : Divisor X}
    (h : IsRelativelyAmpleCartier g L) : L.IsRelativelyAmple g h.1 := by
  obtain ⟨hL, hamp⟩ := h
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- A rational polyhedron with a real point has a rational point. -/
private theorem exists_rat_mem_of_isRationalPolyhedron {r : ℕ} {N : Set (Fin r → ℝ)}
    (hN : MMP.Fourfold.IsRationalPolyhedron N) {δ : Fin r → ℝ} (hδ : δ ∈ N) :
    ∃ q : Fin r → ℚ, (fun j => (q j : ℝ)) ∈ N := by
  obtain ⟨Q, ⟨d, p, e, a, b, -, hab, rfl⟩, hQN, -⟩ :=
    MMP.Fourfold.exists_rationalParallelotope hN hδ
  refine ⟨fun j => p j + ∑ i, a i * e i j, (hQN ⟨fun i => (a i : ℝ),
    fun i => ⟨le_rfl, show ((a i : ℚ) : ℝ) ≤ b i by exact_mod_cast (hab i).le⟩, ?_⟩).1⟩
  funext j
  push_cast
  rfl

/-- **A `ℚ`-divisor which is relatively ample as an `ℝ`-divisor has a relatively ample Cartier
multiple.** -/
private theorem hasRelativelyAmpleMultiple_of_isRelativelyAmple {D : QDivisor X}
    (hD : IsRelativelyAmple g (QDivisor.toRDivisor D)) : D.HasRelativelyAmpleMultiple g := by
  classical
  obtain ⟨M, s, A, hM, hs, hA, heq⟩ := hD
  choose c hc0 hcs using fun k => exists_rat_btwn (hs k)
  set S : Finset (MMP.Mori.PrimeDivisor X) :=
    D.support ∪ Finset.univ.biUnion fun k => (A k).support with hS
  -- the rational polyhedron of positive presentations of `D`
  set E : Finset ((Fin M → ℚ) × ℚ) :=
    S.image fun P => ((fun k => ((A k P : ℤ) : ℚ)), -D P) with hE
  set I : Finset ((Fin M → ℚ) × ℚ) :=
    Finset.univ.image fun k => ((Pi.single k (1 : ℚ)), -c k) with hI
  set N : Set (Fin M → ℝ) := {x | (∀ f ∈ E, MMP.Fourfold.ratAffineForm f x = 0) ∧
    ∀ f ∈ I, 0 ≤ MMP.Fourfold.ratAffineForm f x} with hN
  have hcoef : ∀ (P : MMP.Mori.PrimeDivisor X) (x : Fin M → ℝ),
      MMP.Fourfold.ratAffineForm ((fun k => ((A k P : ℤ) : ℚ)), -D P) x =
        ∑ k, ((A k P : ℤ) : ℝ) * x k - (D P : ℝ) := by
    intro P x
    simp [MMP.Fourfold.ratAffineForm, sub_eq_add_neg]
  have hineq : ∀ (k : Fin M) (x : Fin M → ℝ),
      MMP.Fourfold.ratAffineForm ((Pi.single k (1 : ℚ)), -c k) x = x k - (c k : ℝ) := by
    intro k x
    simp only [MMP.Fourfold.ratAffineForm]
    rw [Finset.sum_eq_single k (fun j _ hjk => by simp [Pi.single_apply, hjk]) (by simp)]
    simp [sub_eq_add_neg]
  have hDP : ∀ P, (D P : ℝ) = ∑ k, s k * ((A k P : ℤ) : ℝ) := by
    intro P
    have := congrArg (fun G : RDivisor X => G P) heq
    simp only [Finsupp.finset_sum_apply, Finsupp.smul_apply, smul_eq_mul] at this
    exact this
  have hsN : s ∈ N := by
    refine ⟨fun f hf => ?_, fun f hf => ?_⟩
    · obtain ⟨P, -, rfl⟩ := Finset.mem_image.mp hf
      rw [hcoef, hDP]
      simp [mul_comm]
    · obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hf
      rw [hineq]
      linarith [hcs k]
  obtain ⟨q, hqE, hqI⟩ := exists_rat_mem_of_isRationalPolyhedron ⟨E, I, rfl⟩ hsN
  have hq0 : ∀ k, 0 < q k := by
    intro k
    have := hqI _ (Finset.mem_image.mpr ⟨k, Finset.mem_univ k, rfl⟩)
    rw [hineq] at this
    have h1 : (c k : ℝ) ≤ q k := by linarith
    have h2 : (0 : ℝ) < q k := (hc0 k).trans_le h1
    exact_mod_cast h2
  have hDq : ∀ P, D P = ∑ k, q k * ((A k P : ℤ) : ℚ) := by
    intro P
    by_cases hP : P ∈ S
    · have := hqE _ (Finset.mem_image.mpr ⟨P, hP, rfl⟩)
      rw [hcoef] at this
      have h' : ((D P : ℚ) : ℝ) = ((∑ k, q k * ((A k P : ℤ) : ℚ) : ℚ) : ℝ) := by
        push_cast
        linarith [show ∑ k, ((A k P : ℤ) : ℝ) * (q k : ℝ) = ∑ k, (q k : ℝ) * ((A k P : ℤ) : ℝ)
          from Finset.sum_congr rfl fun k _ => mul_comm _ _]
      exact_mod_cast h'
    · have hD0 : D P = 0 := by
        by_contra h
        exact hP (Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr h))
      have hA0 : ∀ k, A k P = 0 := fun k => by
        by_contra h
        exact hP (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
          ⟨k, Finset.mem_univ k, Finsupp.mem_support_iff.mpr h⟩))
      simp [hD0, hA0]
  -- clear denominators
  set Nn : ℕ := ∏ k, (q k).den with hNn
  have hNn0 : 0 < Nn := Finset.prod_pos fun k _ => (q k).den_pos
  have hdvd : ∀ k, (q k).den ∣ Nn := fun k => Finset.dvd_prod_of_mem _ (Finset.mem_univ k)
  set n : Fin M → ℕ := fun k => (Nn / (q k).den) * (q k).num.toNat with hn
  have hnq : ∀ k, ((n k : ℕ) : ℚ) = (Nn : ℚ) * q k := by
    intro k
    have hnum : (((q k).num.toNat : ℕ) : ℚ) = ((q k).num : ℚ) := by
      have : 0 ≤ (q k).num := (Rat.num_pos.mpr (hq0 k)).le
      exact_mod_cast Int.toNat_of_nonneg this
    have h1 : ((Nn / (q k).den : ℕ) : ℚ) * ((q k).den : ℚ) = Nn := by
      exact_mod_cast Nat.div_mul_cancel (hdvd k)
    have h2 : ((q k).den : ℚ) * q k = (q k).num := by
      rw [mul_comm]; exact Rat.mul_den_eq_num (q k)
    show (((Nn / (q k).den) * (q k).num.toNat : ℕ) : ℚ) = (Nn : ℚ) * q k
    rw [Nat.cast_mul, hnum, ← h2, ← mul_assoc, h1]
  have hn1 : ∀ k, 1 ≤ n k := by
    intro k
    have h : (0 : ℚ) < (n k : ℚ) := by rw [hnq]; exact mul_pos (by exact_mod_cast hNn0) (hq0 k)
    exact_mod_cast h
  set L : Divisor X := ∑ k, n k • A k with hLdef
  have hLamp : IsRelativelyAmpleCartier g L := by
    haveI : Nonempty (Fin M) := ⟨⟨0, hM⟩⟩
    exact isRelativelyAmpleCartier_sum _ Finset.univ_nonempty fun k _ =>
      isRelativelyAmpleCartier_nsmul (hA k) (n k) (hn1 k)
  refine ⟨Nn, hNn0, L, hLamp.1, ?_, isRelativelyAmple_of_isRelativelyAmpleCartier hLamp⟩
  refine Finsupp.ext fun P => ?_
  rw [hLdef, map_sum, Finsupp.finset_sum_apply]
  simp only [map_nsmul, Finsupp.smul_apply, Divisor.coeff_toQDivisor, zsmul_eq_mul, nsmul_eq_mul]
  change ∑ k, (n k : ℚ) * ((A k P : ℤ) : ℚ) = ((Nn : ℤ) : ℚ) * D P
  rw [hDq P, Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hnq]
  push_cast
  ring

/-- Relative ampleness of a Cartier divisor depends only on its linear equivalence class. -/
private theorem hasRelativelyAmpleMultiple_add_of_linearlyEquivalent {D : QDivisor X}
    (hD : D.HasRelativelyAmpleMultiple g) {G : Divisor X} (hG : G.LinearlyEquivalent 0) :
    (D + Divisor.toQDivisor G).HasRelativelyAmpleMultiple g := by
  obtain ⟨m, hm, L, hL, hLD, hamp⟩ := hD
  obtain ⟨φ, hφ⟩ := hG
  rw [sub_zero] at hφ
  have hGc : G.IsCartier := hφ ▸ Divisor.isCartier_principalDivisor φ
  have hL' : (L + (m : ℤ) • G).IsCartier := hL.add (hGc.zsmul _)
  have hlin : (L + (m : ℤ) • G).LinearlyEquivalent L := by
    refine ⟨(Additive.toMul ((m : ℤ) • Additive.ofMul φ)), ?_⟩
    rw [add_sub_cancel_left, hφ]
    have := map_zsmul (principalDivisorHom (X := X)) (m : ℤ) (Additive.ofMul φ)
    simpa using this.symm
  refine ⟨m, hm, L + (m : ℤ) • G, hL', ?_, ?_⟩
  · rw [map_add, hLD, map_zsmul, smul_add]
  · haveI := hL.isInvertibleModule_divisorialSheaf
    haveI := hL'.isInvertibleModule_divisorialSheaf
    intro y
    obtain ⟨V, hV, hyV, hA⟩ := hamp y
    refine ⟨V, hV, hyV, (Stacks.RelativeVeryAmple.isAmple_congr _ _
      ((RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso
        hlin.divisorialSheafIso)).mpr hA⟩

end Ample

section Flip

/-- A birational projective morphism onto a normal variety which is not an isomorphism
contracts a proper curve. -/
private theorem exists_properCurve_isContractedBy_of_not_isIso {X' Z : Scheme.{0}}
    [IsIntegral X'] [IsLocallyNoetherian X'] {sX' : X' ⟶ Spec (.of ℂ)} [IsProper sX']
    {fp : X' ⟶ Z} [IsProper fp] [IsIntegral Z] [IsNormal Z] (hb : IsBirationalMorphism fp)
    (hni : ¬ IsIso fp) : ∃ C : ProperCurve sX', C.IsContractedBy fp := by
  by_contra hno
  haveI : LocallyQuasiFinite fp := by
    by_contra h
    exact hno (MMP.Mori.exists_properCurve_isContractedBy_of_not_locallyQuasiFinite h)
  haveI : IsFinite fp := IsFinite.of_isProper_of_locallyQuasiFinite fp
  exact hni ((MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso fp
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hb)).2 inferInstance)

/-- A relatively ample `ℝ`-divisor is positive on contracted curves. -/
private theorem exists_hasVal_pos_of_isRelativelyAmple {X Y : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {g : X ⟶ Y} {A : RDivisor X} (hA : IsRelativelyAmple g A)
    (C : ProperCurve sX) (hC : C.IsContractedBy g) :
    ∃ v, 0 < v ∧ HasVal sX A (OneCycle.numericalClass sX (C.cycle ℝ)) v := by
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  refine ⟨_, ?_, hasVal_of_eq r L (fun j => (hL j).1) _⟩
  haveI : Nonempty (Fin m) := ⟨⟨0, hm⟩⟩
  refine Finset.sum_pos (fun j _ => mul_pos (hr j) ?_) Finset.univ_nonempty
  obtain ⟨hLc, hamp⟩ := hL j
  rw [degree_numericalClass_cycle (hL j).1]
  have := hLc.isInvertibleModule_divisorialSheaf
  have hamp' : MMP.Mori.IsRelativelyAmple g (L j).divisorialSheaf := by
    intro y
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    exact ⟨V, hV, hyV, hamp V hV⟩
  exact_mod_cast MMP.Threefold.Resolution.degreeOn_pos_of_isRelativelyAmple_of_isContractedBy
    g _ hamp' C hC

/-- A proper birational morphism onto a normal variety is an isomorphism over every point of
coheight at most one. -/
private theorem mem_biregularLocus_of_coheight_le_one' {Y Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ))
    (g : Y ⟶ Z) (hZ : AlgebraicGeometry.IsVariety ℂ sZ)
    (hY : AlgebraicGeometry.IsVariety ℂ (g ≫ sZ))
    [IsNormal Z] [IsProper g] (hg : IsBirationalMorphism g) {z : Z}
    (hz : Order.coheight z ≤ 1) : z ∈ biregularLocus g := by
  have h := MMP.Mori.two_le_closedsCodimension_compl_biregularLocus sZ g (hY := hZ) (hX := hY) hg
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h
  by_contra hz'
  exact absurd ((h z hz').trans hz) (by norm_num)

/-- A small contraction preserves points of coheight at most one. -/
private theorem coheight_map_le_one_of_isSmall {Y Z : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {g : Y ⟶ Z} [IsNormal Z] (hg : MMP.Flips.IsSmall ℂ sZ sY g) {y : Y}
    (hy : Order.coheight y ≤ 1) : Order.coheight (g y) ≤ 1 := by
  have h := (MMP.Flips.isSmall_iff_two_le_closedsCodimension_exceptionalSet
    hg.toIsBirationalContraction).mp hg
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight] at h
  have hy' : y ∉ MMP.Flips.exceptionalSet g := fun hyE => absurd ((h y hyE).trans hy) (by norm_num)
  rw [MMP.Flips.coheight_map_of_notMem_exceptionalSet hy']
  exact hy

/-- A small contraction is an isomorphism over the images of the points of coheight at most
one. -/
private theorem map_mem_biregularLocus_of_isSmall {Y Z : Scheme.{0}} {sY : Y ⟶ Spec (.of ℂ)}
    {sZ : Z ⟶ Spec (.of ℂ)} {g : Y ⟶ Z} [IsNormal Z] (hg : MMP.Flips.IsSmall ℂ sZ sY g) {y : Y}
    (hy : Order.coheight y ≤ 1) : g y ∈ biregularLocus g := by
  haveI : IsProper g := hg.isProper
  exact mem_biregularLocus_of_coheight_le_one' sZ g hg.isVariety_target
    (hg.comp_eq ▸ hg.isVariety_source) hg.isBirationalMorphism
    (coheight_map_le_one_of_isSmall hg hy)

/-- A small contraction of normal varieties is a small morphism in the fourfold sense. -/
private theorem isSmallMorphism_of_isSmall {Y Z : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    {g : Y ⟶ Z} (hg : MMP.Flips.IsSmall ℂ sZ sY g) (hY : IsNormalVariety ℂ sY)
    (hZ : IsNormalVariety ℂ sZ) : IsSmallMorphism sY sZ g := by
  haveI : IsNormal Z := hZ.2
  refine ⟨hY, hZ, hg.comp_eq, hg.isProper, hg.isBirationalMorphism, ?_⟩
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight]
  intro y hy
  by_contra h
  exact hy (map_mem_biregularLocus_of_isSmall hg (Order.le_of_lt_succ (not_le.mp h)))

end Flip

/-- Linear independence over a subfield passes to every smaller subfield. -/
private theorem linearIndependent_of_le {ι : Type*} [Fintype ι] {S T : Subfield ℝ} (hle : S ≤ T)
    {h : ι → ℝ} (hind : LinearIndependent T h) : LinearIndependent S h := by
  refine Fintype.linearIndependent_iff.mpr fun g hg j => Subtype.ext ?_
  have := Fintype.linearIndependent_iff.mp hind (fun i => Subfield.inclusion hle (g i))
    (by simp only [Subfield.smul_def] at hg ⊢; exact hg) j
  simpa using congrArg Subtype.val this

/-- Linearly equivalent divisors have the same degree on every curve. -/
private theorem hasVal_sub_of_linearlyEquivalent {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    {G G' : Divisor X} (hG : G.LinearlyEquivalent G') (C : ProperCurve sX) :
    HasVal sX (Divisor.toRDivisor G - Divisor.toRDivisor G')
      (OneCycle.numericalClass sX (C.cycle ℝ)) 0 := by
  obtain ⟨φ, hφ⟩ := hG
  have e : Divisor.toRDivisor G - Divisor.toRDivisor G' =
      Divisor.toRDivisor (principalDivisor φ) := by
    rw [← hφ, map_sub]
  rw [e]
  have hc := Divisor.isCartier_principalDivisor (X := X) φ
  have h1 := hasVal_cartier hc (OneCycle.numericalClass sX (C.cycle ℝ))
  rw [degree_numericalClass_cycle hc,
    MMP.Flips.Divisor.degreeOn_eq_zero_of_linearlyEquivalent sX C.ι C.dim_le hc
      (Divisor.linearlyEquivalent_principalDivisor_zero φ)] at h1
  simpa using h1

section FlipStep

variable {X Z X' : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X'] [IsIntegral X']
  [IsIntegral Z] [IsNormal Z] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
  {sX' : X' ⟶ Spec (.of ℂ)} [QuasiCompact sX] [QuasiCompact sX'] {K : Divisor X}
  {B : RDivisor X} {K' : Divisor X'} {B' : RDivisor X'} {f : X ⟶ Z} {fp : X' ⟶ Z}
  [IsProper f] [IsProper fp]

/-- The base of the contraction of a ray of a projective variety is projective. -/
private theorem isProjectiveVariety_target {R : Set (NumericalCurveClasses sX)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hf : IsContractionOfRay sX sZ R f)
    (hstep : IsRealFlipStep sX sZ sX' K B K' B' f fp) : MMP.Mori.IsProjectiveVariety ℂ sZ := by
  haveI := hstep.isQuasiProjectiveVariety_target
  haveI : Surjective f := ⟨hf.surjective⟩
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
  haveI : UniversallyClosed (f ≫ sZ) := by rw [hf.comp_eq]; infer_instance
  haveI : UniversallyClosed sZ := UniversallyClosed.of_comp_surjective f sZ
  haveI : IsProper sZ := {}
  haveI : AlgebraicGeometry.IsVariety ℂ (𝟙 (Spec (.of ℂ))) := {}
  exact ⟨MMP.isProjectiveMorphism_of_isProper_of_isQuasiProjectiveVariety sZ (𝟙 _) sZ
    (Category.comp_id sZ)⟩

/-- **The canonical divisor of the flip is the strict transform of `K`**, up to linear
equivalence: both models are isomorphic over the points of `Z` of coheight at most one. -/
private theorem linearlyEquivalent_flipTransform (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hstep : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    K'.LinearlyEquivalent (flipTransform f fp K) := by
  obtain ⟨n₀, hK₀⟩ := hK
  have hZv := hstep.isNegativeExtremalContraction.isNormalVariety_target
  have hXv := hstep.isNegativeExtremalContraction.isNormalVariety_source
  have hX'v : IsNormalVariety ℂ sX' := ⟨hstep.isSmall_flip.isVariety_source, inferInstance⟩
  have hsm := hstep.isSmall
  have hsm' := hstep.isSmall_flip
  set V : Z.Opens := biregularLocus f ⊓ biregularLocus fp
  haveI : IsIso (f ∣_ V) := isBiregular_iff_le_biregularLocus.mpr inf_le_left
  haveI : IsIso (fp ∣_ V) := isBiregular_iff_le_biregularLocus.mpr inf_le_right
  have hXV : ∀ x : X, Order.coheight x ≤ 1 → f x ∈ V := fun x hx =>
    ⟨map_mem_biregularLocus_of_isSmall hsm hx,
      mem_biregularLocus_of_coheight_le_one' sZ fp hsm'.isVariety_target
        (hsm'.comp_eq ▸ hsm'.isVariety_source) hsm'.isBirationalMorphism
        (coheight_map_le_one_of_isSmall hsm hx)⟩
  have hX'V : ∀ x : X', Order.coheight x ≤ 1 → fp x ∈ V := fun x hx =>
    ⟨mem_biregularLocus_of_coheight_le_one' sZ f hsm.isVariety_target
        (hsm.comp_eq ▸ hsm.isVariety_source) hsm.isBirationalMorphism
        (coheight_map_le_one_of_isSmall hsm' hx),
      map_mem_biregularLocus_of_isSmall hsm' hx⟩
  have hK₀' : K.IsCanonicalDivisor (f ≫ sZ) n₀ := by rwa [hsm.comp_eq]
  have hTK := MMP.Mori.isCanonicalDivisor_flipTransform_of_isIso_restrict hZv
    (by rwa [hsm.comp_eq]) (by rwa [hsm'.comp_eq])
    hsm.isBirationalMorphism hsm'.isBirationalMorphism V hXV hX'V hK₀'
  rw [hsm'.comp_eq] at hTK
  obtain ⟨n', hK'⟩ := hstep.isCanonicalDivisor_flip
  exact MMP.Threefold.Mori.linearlyEquivalent_of_isCanonicalDivisor sX' hX'v hK' hTK

/-- **A real flip step is a flip of a rational pair.** Perturbing the coefficients of `B` to
nearby rationals keeps the ray `(K + Γ)`-negative and `K⁺ + Γ⁺` `f⁺`-ample. -/
private theorem exists_isFlipOf (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n) (hX'Q : IsQFactorial sX')
    {R : Set (NumericalCurveClasses sX)}
    (hR : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X} {hL : ∀ j, (L j).IsCartier}
    (hKB : logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j))
    (hneg : ∀ u ∈ R, u ≠ 0 → pval sX u r L hL < 0) (hf : IsContractionOfRay sX sZ R f)
    (hstep : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    ∃ D : QDivisor X, IsFlipOf sX sZ sX' D f fp := by
  classical
  have hZp := isProjectiveVariety_target hX hf hstep
  have hZv := hstep.isNegativeExtremalContraction.isNormalVariety_target
  have hXv := hstep.isNegativeExtremalContraction.isNormalVariety_source
  have hX'v : IsNormalVariety ℂ sX' := ⟨hstep.isSmall_flip.isVariety_source, inferInstance⟩
  obtain ⟨v, hv0, hRv⟩ := hR.2
  have hvR : v ∈ R := hRv ▸ ⟨1, zero_le_one, one_smul _ _⟩
  set T := B.support
  let p : Fin T.card → MMP.Mori.PrimeDivisor X := fun i => (T.equivFin.symm i).1
  have hBsum : B = ∑ i, Finsupp.single (p i) (B (p i)) := eq_sum_single_equivFin B
  set b : Fin T.card → ℝ := fun i => B (p i) with hb
  set E₁ : Fin T.card → RDivisor X :=
    fun i => Divisor.toRDivisor (Finsupp.single (p i) (1 : ℤ)) with hE₁
  have hsingle : ∀ (i : Fin T.card) (c : ℝ), Finsupp.single (p i) c = c • E₁ i := by
    intro i c
    simp [hE₁, Divisor.toRDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom,
      Finsupp.mapRange_single, Finsupp.smul_single]
  -- the value at `v` of `K + ∑ yᵢ Pᵢ`
  obtain ⟨aK, haK⟩ := exists_hasVal hXQ (Divisor.toRDivisor K) v
  choose a ha using fun i => exists_hasVal_single hXQ (p i) v
  have hval : ∀ y : Fin T.card → ℝ, HasVal sX
      (Divisor.toRDivisor K + ∑ i, Finsupp.single (p i) (y i)) v (aK + ∑ i, y i * a i) := by
    intro y
    simpa only [hsingle] using haK.add (HasVal.sum fun i => (ha i).smul (y i))
  have hneg0 : aK + ∑ i, b i * a i < 0 := by
    have h1 := hasVal_of_eq r L hL v
    rw [← hKB] at h1
    have h2 := hval b
    rw [hb, ← hBsum] at h2
    rw [← h1.unique h2]
    exact hneg v hvR hv0
  -- relative ampleness near `B` on `X⁺`
  obtain ⟨δ', hδ', hamp⟩ := MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul ℂ sX' sZ hX'v
    hZv fp hstep.isSmall_flip.comp_eq hstep.isRelativelyAmple_flip
    (fun i => flipTransform f fp (E₁ i))
    (fun i => (exists_hasVal hX'Q _ 0).choose_spec.isCartierCombination)
  -- a rational point near `b`
  have hev : ∀ᶠ y in nhds b, (aK + ∑ i, y i * a i < 0) ∧ ∀ i, |y i - b i| < δ' := by
    refine Filter.Eventually.and ?_ (Filter.eventually_all.2 fun i => ?_)
    · have hc : Continuous fun y : Fin T.card → ℝ => aK + ∑ i, y i * a i := by fun_prop
      exact (hc.tendsto b).eventually (Iio_mem_nhds hneg0)
    · have := ((continuous_apply i).tendsto b).eventually (Metric.ball_mem_nhds (b i) hδ')
      filter_upwards [this] with y hy
      rwa [Real.dist_eq] at hy
  obtain ⟨U, hU, hUo, hbU⟩ := eventually_nhds_iff.1 hev
  obtain ⟨_, hmem, q, rfl⟩ :=
    (DenseRange.piMap (fun _ => Rat.denseRange_cast (𝕜 := ℝ))).inter_open_nonempty U hUo
      ⟨b, hbU⟩
  obtain ⟨hqneg, hqamp⟩ := hU _ hmem
  set Γ₁ : QDivisor X := ∑ i, Finsupp.single (p i) (q i)
  have hΓ₁R : QDivisor.toRDivisor Γ₁ = ∑ i, Finsupp.single (p i) ((q i : ℝ)) :=
    toRDivisor_sum_single _ _ _
  have hQ₁ : (Divisor.toQDivisor K + Γ₁).IsQCartier := isQCartier_of_isQFactorial hXQ _
  have hcfv : QDivisor.curveForm sX (Divisor.toQDivisor K + Γ₁) hQ₁ v =
      aK + ∑ i, (q i : ℝ) * a i := by
    have h1 := hasVal_curveForm (sX := sX) (Divisor.toQDivisor K + Γ₁) hQ₁ v
    rw [map_add, QDivisor.toRDivisor_toQDivisor, hΓ₁R] at h1
    exact h1.unique (hval fun i => (q i : ℝ))
  have hnegR : ∀ u ∈ R, u ≠ 0 →
      QDivisor.curveForm sX (Divisor.toQDivisor K + Γ₁) hQ₁ u < 0 := by
    intro u hu hu0
    rw [hRv] at hu
    obtain ⟨c, hc, rfl⟩ := hu
    have hc0 : 0 < c := hc.lt_of_ne' fun h => hu0 (by rw [h, zero_smul])
    rw [map_smul, smul_eq_mul, hcfv]
    exact mul_neg_of_pos_of_neg hc0 hqneg
  -- `-(K + Γ₁)` is `f`-ample
  have hantiamp : (-(Divisor.toQDivisor K + Γ₁)).HasRelativelyAmpleMultiple f := by
    refine MMP.Mori.hasRelativelyAmpleMultiple_neg_of_isExtremalRay sX sZ hXv hX hZp hK hQ₁ hR
      (fun u hu hu0 => ?_) f hf.comp_eq (fun C hC => (hf.isContractedBy_iff C).mp hC)
    simpa [QDivisor.curveForm, Finsupp.sum, LinearMap.sum_apply, smul_eq_mul] using
      hnegR u hu hu0
  -- `(f⁺)⁻¹_* f_* (K + Γ₁)` is `f⁺`-ample
  have hT₁ : flipTransform f fp (QDivisor.toRDivisor Γ₁) =
      ∑ i, (q i : ℝ) • flipTransform f fp (E₁ i) := by
    rw [hΓ₁R, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [hsingle, flipTransform_smul']
  have hTB : B' = ∑ i, b i • flipTransform f fp (E₁ i) := by
    rw [hstep.eq_flipTransform, hBsum, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [hsingle, flipTransform_smul']
  have hreal : IsRelativelyAmple fp
      (QDivisor.toRDivisor (Divisor.toQDivisor K' + flipTransform f fp Γ₁)) := by
    convert hamp (fun i => (q i : ℝ) - b i) hqamp using 1
    rw [map_add, QDivisor.toRDivisor_toQDivisor, ← flipTransform_toRDivisor, hT₁,
      logCanonicalDivisor, hTB]
    simp only [sub_smul, Finset.sum_sub_distrib]
    abel
  obtain ⟨φ, hφ⟩ := linearlyEquivalent_flipTransform hK hstep
  have hG : Divisor.LinearlyEquivalent (flipTransform f fp K - K') 0 :=
    ⟨φ⁻¹, by rw [sub_zero, MMP.Mori.principalDivisor_inv, ← hφ, neg_sub]⟩
  have hTK : flipTransform f fp (Divisor.toQDivisor K + Γ₁) =
      (Divisor.toQDivisor K' + flipTransform f fp Γ₁) +
        Divisor.toQDivisor (flipTransform f fp K - K') := by
    rw [map_add, flipTransform_toQDivisor_int, map_sub]
    abel
  refine ⟨Divisor.toQDivisor K + Γ₁, hQ₁, hf.toIsContraction,
    isSmallMorphism_of_isSmall hstep.isSmall hXv hZv, hantiamp,
    isSmallMorphism_of_isSmall hstep.isSmall_flip hX'v hZv,
    hstep.isProjectiveMorphism_flip, isQCartier_of_isQFactorial hX'Q _, ?_⟩
  rw [hTK]
  exact hasRelativelyAmpleMultiple_add_of_linearlyEquivalent
    (hasRelativelyAmpleMultiple_of_isRelativelyAmple hreal) hG

/-- **The flip of a real klt pair is a real klt pair**: log discrepancies only go up along the
flip, and `K⁺ + B⁺` is `ℝ`-Cartier, being `f⁺`-ample. -/
private theorem isRealKltPair_flip (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B) (hstep : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    0 ≤ B' ∧ IsRealKltPair sX' B' := by
  refine ⟨Finsupp.le_def.mpr fun P => ?_, ?_⟩
  · rw [hstep.eq_flipTransform]
    exact flipTransform_apply_mem f fp (AddSubmonoid.nonneg ℝ) B (Finsupp.le_def.mp hB0) P
  obtain ⟨n₀, hK₀⟩ := hK
  have hXv := hstep.isNegativeExtremalContraction.isNormalVariety_source
  have hX'v : IsNormalVariety ℂ sX' := ⟨hstep.isSmall_flip.isVariety_source, inferInstance⟩
  haveI : LocallyOfFiniteType sX := hXv.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sX' := hX'v.1.toLocallyOfFiniteType
  obtain ⟨n', hK'⟩ := hstep.isCanonicalDivisor_flip
  have hpos : ∀ (n : ℕ) (E' : DivisorOver ℂ sX') (a' : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX' n B' E' a' → 0 < a' := by
    intro n E' a' ha'
    obtain ⟨E, hEp, -, -, hle⟩ := hstep.exists_isLogDiscrepancy_le ⟨n₀, hK₀⟩ E' ha'.2.1
    obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hXv hK₀
    have hdiv : divisorOfForm ω = K := DivisorWithCoeffs.ext' hωK
    obtain ⟨a, ha⟩ := MMP.Fourfold.exists_isLogDiscrepancy hXv hω0 (hdiv ▸ hK₀)
      (by rw [hdiv]; exact hstep.isNegativeExtremalContraction.isCartierCombination) E hEp
    exact lt_of_lt_of_le (hB.2.2.2 n₀ E a ha) (hle n₀ n a a' ha ha').1
  obtain ⟨M, s, A, -, -, hA, hKB'⟩ := hstep.isRelativelyAmple_flip
  have hRC : RDivisor.IsRCartier (Divisor.toRDivisor K' + B') := by
    refine ⟨M, s, A, fun j => (hA j).1, fun Γ => ?_⟩
    have := congrArg (fun D : RDivisor X' => D Γ) hKB'
    simp only [logCanonicalDivisor, Finsupp.add_apply, Finsupp.finset_sum_apply,
      Finsupp.smul_apply, smul_eq_mul, toRDivisor_apply] at this
    simpa [DivisorWithCoeffs.coeff_apply, toRDivisor_apply] using this
  refine ⟨hX'v, fun P => ?_, ⟨n', K', hK', hRC⟩, hpos⟩
  have := hpos _ _ _ (MMP.Fourfold.PltReference.isLogDiscrepancy_ofPrimeDivisor hX'v hK' hRC P)
  linarith

/-- The coefficients of `B⁺` lie in the field generated by the coefficients of `B`. -/
private theorem closure_range_coeff_flip_le (hstep : IsRealFlipStep sX sZ sX' K B K' B' f fp) :
    Subfield.closure (Set.range B'.coeff) ≤ Subfield.closure (Set.range B.coeff) := by
  rw [Subfield.closure_le]
  rintro _ ⟨P, rfl⟩
  rw [hstep.eq_flipTransform]
  exact flipTransform_apply_mem f fp (Subfield.closure (Set.range B.coeff)).toAddSubmonoid B
    (fun Q => Subfield.subset_closure ⟨Q, rfl⟩) P

end FlipStep

private theorem solution
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X} {l : ℕ} {H : Fin l → QDivisor X}
    {h : Fin l → ℝ} {lam : ℝ}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hH : ∀ j, IsCartierCombination (H j))
    (hspan : ∀ E : RDivisor X, IsCartierCombination E →
      ∃ a : Fin l → ℝ,
        IsNumericallyEquivalentOver ℂ sX sX E (∑ j, a j • QDivisor.toRDivisor (H j)))
    (hind : LinearIndependent (Subfield.closure (Set.range B.coeff)) h)
    (hlam : 0 < lam) :
    (∀ C C' : ProperCurve sX,
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
        logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
            ∑ j, r j • Divisor.toRDivisor (L j) ∧
          ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf
              (OneCycle.numericalClass sX (C.cycle ℝ))) = 0) →
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
        logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
            ∑ j, r j • Divisor.toRDivisor (L j) ∧
          ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf
              (OneCycle.numericalClass sX (C'.cycle ℝ))) = 0) →
      ∃ t : ℝ, 0 < t ∧
        OneCycle.numericalClass sX (C.cycle ℝ) = t • OneCycle.numericalClass sX (C'.cycle ℝ)) ∧
    (0 ≤ B → IsRealKltPair sX B →
      ∀ {Z X' : Scheme.{0}} [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
        {sZ : Z ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {K' : Divisor X'} {B' : RDivisor X'}
        {f : X ⟶ Z} {fp : X' ⟶ Z} {R : Set (NumericalCurveClasses sX)},
        IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R →
        (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
          logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j) ∧
            ∀ u ∈ R, u ≠ 0 → ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
              NumericalCurveClasses.degree sX (L j).divisorialSheaf u) < 0) →
        (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
          logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
              ∑ j, r j • Divisor.toRDivisor (L j) ∧
            ∀ u ∈ R, ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
              NumericalCurveClasses.degree sX (L j).divisorialSheaf u) = 0) →
        IsContractionOfRay sX sZ R f →
        IsRealFlipStep sX sZ sX' K B K' B' f fp →
        MMP.Mori.IsProjectiveVariety ℂ sX' → IsQFactorial sX' →
        ∀ R' : Set (NumericalCurveClasses sX'),
          IsExtremalRay ℝ (closedConeOfCurves sX' : Set (NumericalCurveClasses sX')) R' →
          (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X') (hL : ∀ j, (L j).IsCartier),
            logCanonicalDivisor K' B' = ∑ j, r j • Divisor.toRDivisor (L j) ∧
              ∀ u ∈ R', u ≠ 0 → ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
                NumericalCurveClasses.degree sX' (L j).divisorialSheaf u) < 0) →
          ¬ ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X') (hL : ∀ j, (L j).IsCartier),
            logCanonicalDivisor K'
                (B' + lam • flipTransform f fp (∑ j, h j • QDivisor.toRDivisor (H j))) =
                ∑ j, r j • Divisor.toRDivisor (L j) ∧
              ∀ u ∈ R', ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
                NumericalCurveClasses.degree sX' (L j).divisorialSheaf u) = 0) := by
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  refine ⟨fun C C' hC hC' => single_ray hX hXQ hspan hind hlam C C' hC hC', ?_⟩
  intro hB0 hBk Z X' _ _ _ sZ sX' K' B' f fp R hR hRneg hRnull hf hstep hX' hX'Q R' hR' hR'neg
    ⟨m, r, L, hL, hEq, hnul⟩
  haveI : IsIntegral X' := hX'.toIsVariety.toIsIntegral
  haveI : QuasiCompact sX' := hX'.toIsVariety.toQuasiCompact
  haveI : IsProper sX' := isProper_of_isProjectiveMorphism sX' hX'.isProjective
  haveI : IsProper fp := isProper_of_isProjectiveMorphism fp hstep.isProjectiveMorphism_flip
  haveI : IsProper f := hstep.isSmall.isProper
  have hZv := hstep.isNegativeExtremalContraction.isNormalVariety_target
  haveI : IsIntegral Z := hZv.1.toIsIntegral
  haveI : IsNormal Z := hZv.2
  set H' : Fin l → QDivisor X' := fun j => flipTransform f fp (H j)
  have hT : flipTransform f fp (∑ j, h j • QDivisor.toRDivisor (H j)) =
      ∑ j, h j • QDivisor.toRDivisor (H' j) := by
    rw [map_sum]
    exact Finset.sum_congr rfl fun j _ => by rw [flipTransform_smul', flipTransform_toRDivisor]
  -- numerical classes transport along the flip
  obtain ⟨m₁, r₁, L₁, hL₁, hEq₁, hneg₁⟩ := hRneg
  obtain ⟨n₀, hK₀⟩ := id hK
  obtain ⟨Γ, hΓ, hQΓ, hnegΓ⟩ := exists_isKltPair_neg_of_isRealKltPair hX hXQ hK₀ hB0 hBk hR
    (hL := hL₁) hEq₁ hneg₁
  obtain ⟨-, -, htriv, -, hspanT⟩ :=
    IsKltPair.isNumericallyTrivialOver_flipTransform_of_isContractionOfRay (h := 𝟙 Z) hΓ hK hX
      hXQ hX' hX'Q ⟨hQΓ, hR, hnegΓ⟩ hf
      (Or.inr (exists_isFlipOf hX hXQ hK hX'Q hR (hL := hL₁) hEq₁ hneg₁ hf hstep))
      (isProjectiveVariety_target hX hf hstep) (Category.id_comp sZ)
  -- a flipped curve, positive for `K⁺ + B⁺` and null at the level
  obtain ⟨Cp, hCp⟩ := exists_properCurve_isContractedBy_of_not_isIso (sX' := sX')
    hstep.isBirationalMorphism_flip hstep.not_isIso_flip
  obtain ⟨v, hv, hvC⟩ := exists_hasVal_pos_of_isRelativelyAmple hstep.isRelativelyAmple_flip Cp hCp
  have hcrep : HasVal sX' (logCanonicalDivisor K' (B' + lam •
      ∑ j, h j • QDivisor.toRDivisor (H' j))) (OneCycle.numericalClass sX' (Cp.cycle ℝ)) 0 := by
    set N := logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) with hN
    obtain ⟨m₀, r₀, L₀, hL₀, hEq₀, hnul₀⟩ := hRnull
    have hNtriv : IsNumericallyTrivialOver ℂ sX (f ≫ 𝟙 Z) N := by
      refine ⟨(show HasVal sX N 0 _ from ⟨m₀, r₀, L₀, hL₀, hEq₀, rfl⟩).isCartierCombination,
        ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩,
        fun C hC m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h1 h2 => ?_⟩
      have hCR : OneCycle.numericalClass sX (C.cycle ℝ) ∈ R :=
        (hf.isContractedBy_iff C).mp (by simpa using hC)
      rw [(IsRIntersectionNumber.hasVal h1).unique ⟨m₀, r₀, L₀, hL₀, hEq₀, hnul₀ _ hCR⟩,
        (IsRIntersectionNumber.hasVal h2).unique (hasVal_zero _)]
    obtain ⟨x, hx⟩ := exists_hasVal hX'Q (flipTransform f fp N)
      (OneCycle.numericalClass sX' (Cp.cycle ℝ))
    obtain rfl : x = 0 := hx.eq_of_isNumericallyEquivalentOver (htriv N hNtriv)
      (by simpa using hCp) (hasVal_zero _)
    have hKK' := hasVal_sub_of_linearlyEquivalent (linearlyEquivalent_flipTransform hK hstep) Cp
    rw [← flipTransform_toRDivisor_int] at hKK'
    have e : logCanonicalDivisor K' (B' + lam • ∑ j, h j • QDivisor.toRDivisor (H' j)) =
        flipTransform f fp N +
          (Divisor.toRDivisor K' - flipTransform f fp (Divisor.toRDivisor K)) := by
      rw [hN, logCanonicalDivisor, logCanonicalDivisor, map_add, map_add, flipTransform_smul',
        hT, ← hstep.eq_flipTransform]
      abel
    rw [e]
    simpa using hx.add hKK'
  -- a curve on the ray `R'`, by the cone theorem for the klt pair `(X⁺, B⁺)`
  obtain ⟨m₂, r₂, L₂, hL₂, hEq₂, hneg₂⟩ := hR'neg
  obtain ⟨hB'0, hB'klt⟩ := isRealKltPair_flip hK hB0 hBk hstep
  obtain ⟨n', hK'⟩ := hstep.isCanonicalDivisor_flip
  obtain ⟨C', hC'R, hC'0⟩ :=
    exists_properCurve_mem_of_isRealKltPair hX' hX'Q hK' hB'0 hB'klt hR' (hL := hL₂) hEq₂ hneg₂
  -- the hypotheses of the first part on `X⁺`
  have hspan' : ∀ E : RDivisor X', IsCartierCombination E →
      ∃ a : Fin l → ℝ,
        IsNumericallyEquivalentOver ℂ sX' sX' E (∑ j, a j • QDivisor.toRDivisor (H' j)) := by
    intro E hE
    obtain ⟨a, -, ha⟩ := hspanT l (fun j => QDivisor.toRDivisor (H j))
      (fun j => (exists_hasVal hXQ (QDivisor.toRDivisor (H j)) 0).choose_spec.isCartierCombination)
      hspan E hE
    exact ⟨a, by simpa only [flipTransform_toRDivisor] using ha⟩
  obtain ⟨t, ht, hCt⟩ := single_ray hX' hX'Q hspan'
    (linearIndependent_of_le (closure_range_coeff_flip_le hstep) hind) hlam C' Cp
    ⟨m, r, L, hL, by rwa [← hT], hnul _ hC'R⟩ hcrep
  -- `K⁺ + B⁺` is negative on `C'` and positive on `t⁻¹ C' = Cp`
  have h2 := hasVal_of_eq r₂ L₂ hL₂ (OneCycle.numericalClass sX' (C'.cycle ℝ))
  rw [← hEq₂] at h2
  have h1 : HasVal sX' (logCanonicalDivisor K' B') (OneCycle.numericalClass sX' (C'.cycle ℝ))
      (t * v) := hCt ▸ hvC.smul_left t
  have h3 := h2.unique h1
  have h4 : pval sX' (OneCycle.numericalClass sX' (C'.cycle ℝ)) r₂ L₂ hL₂ < 0 :=
    hneg₂ _ hC'R hC'0
  nlinarith

end Proof_lem_fourfold_independent_level_single_ray

end

open CategoryTheory AlgebraicGeometry

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **Independent scaling coefficients give a single null ray.** Let `X` be a projective
`ℚ`-factorial normal complex variety with canonical divisor `K`, `(X, B)` a klt pair with
effective real boundary, `H₁, …, Hₗ` `ℚ`-Cartier `ℚ`-divisors whose classes span `N¹(X)_ℝ`, and
`h₁, …, hₗ ∈ ℝ` linearly independent over the subfield of `ℝ` generated by the coefficients of
`B`; put `H = ∑ⱼ hⱼ Hⱼ` and let `λ > 0`.

* Any two curves `C`, `C'` with `(K + B + λ H) · C = (K + B + λ H) · C' = 0` have positively
  proportional numerical classes.
* Let `R` be a `(K + B)`-negative extremal ray of `NE̅(X)` on which `K + B + λ H` vanishes, with
  contraction `f : X ⟶ Z`, and `X ⟶ Z ⟵ X⁺` a real flip of `f` with `X⁺` projective and
  `ℚ`-factorial, canonical divisor `K⁺` and `B⁺ = (f⁺)⁻¹_* f_* B`. Then no
  `(K⁺ + B⁺)`-negative extremal ray of `NE̅(X⁺)` is null for `K⁺ + B⁺ + λ (f⁺)⁻¹_* f_* H`. -/
@[mmp "lem_fourfold_independent_level_single_ray"]
public theorem exists_pos_smul_numericalClass_eq_of_linearIndependent
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X} {l : ℕ} {H : Fin l → QDivisor X}
    {h : Fin l → ℝ} {lam : ℝ}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hH : ∀ j, IsCartierCombination (H j))
    (hspan : ∀ E : RDivisor X, IsCartierCombination E →
      ∃ a : Fin l → ℝ,
        IsNumericallyEquivalentOver ℂ sX sX E (∑ j, a j • QDivisor.toRDivisor (H j)))
    (hind : LinearIndependent (Subfield.closure (Set.range B.coeff)) h)
    (hlam : 0 < lam) :
    (∀ C C' : ProperCurve sX,
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
        logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
            ∑ j, r j • Divisor.toRDivisor (L j) ∧
          ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf
              (OneCycle.numericalClass sX (C.cycle ℝ))) = 0) →
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
        logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
            ∑ j, r j • Divisor.toRDivisor (L j) ∧
          ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf
              (OneCycle.numericalClass sX (C'.cycle ℝ))) = 0) →
      ∃ t : ℝ, 0 < t ∧
        OneCycle.numericalClass sX (C.cycle ℝ) = t • OneCycle.numericalClass sX (C'.cycle ℝ)) ∧
    (0 ≤ B → IsRealKltPair sX B →
      ∀ {Z X' : Scheme.{0}} [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
        {sZ : Z ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {K' : Divisor X'} {B' : RDivisor X'}
        {f : X ⟶ Z} {fp : X' ⟶ Z} {R : Set (NumericalCurveClasses sX)},
        IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R →
        (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
          logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j) ∧
            ∀ u ∈ R, u ≠ 0 → ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
              NumericalCurveClasses.degree sX (L j).divisorialSheaf u) < 0) →
        (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
          logCanonicalDivisor K (B + lam • ∑ j, h j • QDivisor.toRDivisor (H j)) =
              ∑ j, r j • Divisor.toRDivisor (L j) ∧
            ∀ u ∈ R, ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
              NumericalCurveClasses.degree sX (L j).divisorialSheaf u) = 0) →
        IsContractionOfRay sX sZ R f →
        IsRealFlipStep sX sZ sX' K B K' B' f fp →
        MMP.Mori.IsProjectiveVariety ℂ sX' → IsQFactorial sX' →
        ∀ R' : Set (NumericalCurveClasses sX'),
          IsExtremalRay ℝ (closedConeOfCurves sX' : Set (NumericalCurveClasses sX')) R' →
          (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X') (hL : ∀ j, (L j).IsCartier),
            logCanonicalDivisor K' B' = ∑ j, r j • Divisor.toRDivisor (L j) ∧
              ∀ u ∈ R', u ≠ 0 → ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
                NumericalCurveClasses.degree sX' (L j).divisorialSheaf u) < 0) →
          ¬ ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X') (hL : ∀ j, (L j).IsCartier),
            logCanonicalDivisor K'
                (B' + lam • flipTransform f fp (∑ j, h j • QDivisor.toRDivisor (H j))) =
                ∑ j, r j • Divisor.toRDivisor (L j) ∧
              ∀ u ∈ R', ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
                NumericalCurveClasses.degree sX' (L j).divisorialSheaf u) = 0) :=
                  by revert X sX K B l H h lam hX hXQ hK hH hspan hind hlam; exact Proof_lem_fourfold_independent_level_single_ray.solution

end MMP.Fourfold
