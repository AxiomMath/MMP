module

public import MMP.AlgebraicGeometry.MMP.Flip.RestrictedAlgebraLifting

/-!
# Finite generation of a prepared restricted adjoint algebra

Let `A₀` be a finitely generated normal complex domain and `π : X ⟶ Spec A₀` a projective
morphism from a smooth complex variety `X` of dimension `d + 1`, `d ≥ 2`. Let
`Δ = S + A + B` be a plt `ℚ`-divisor with `⌊Δ⌋ = S` a smooth prime divisor, `B ≥ 0` and
`A = H/a`, `a ≥ 3`, for an effective `π`-ample divisor `H` in general position, and put
`Ω = (Δ - S)|_S`. Suppose that `(S, Ω + A|_S)` is canonical and that `S` maps projectively and
birationally to a normal affine variety `T` finite over `Spec A₀`. If the birational
finite-generation property `F(d)` holds, then for every `q > 0` with `qΔ` integral and with a
section of `𝒪_X(q(K_X + Δ))` not vanishing on `S`, the restricted algebra
`R_S(X, q(K_X + Δ)) = ⊕_{j ≥ 0} im(H⁰(X, 𝒪_X(jq(K_X + Δ))) → H⁰(S, 𝒪_S(jq(K_S + Ω))))`
is a finitely generated `A₀`-algebra.

## Main results

* `MMP.Fourfold.restrictedImageAlgebra_fg_of_birationalFiniteGenerationProperty`: the restricted
  algebra is finitely generated over `A₀`.

## Implementation notes

The canonical divisor `K` of `X` is normalized to have coefficient `-1` along `S` (every
canonical class contains such a divisor: `K_X = div ω` for a rational top form `ω` with a simple
pole along `S`). Then `q(K + Δ)` has no component along `S`, a section `g` of
`𝒪_X(jq(K + Δ))` is regular at the generic point of `S`, and its restriction to `S` along the
Poincaré residue `Res ω` of `ω` is the residue `ḡ ∈ k(S)` (`MMP.Fourfold.IsRestrictionAlong`);
the target `H⁰(S, 𝒪_S(jq(K_S + Ω)))` is taken with `K_S = (K + S)|_S = div(Res ω)`. So the
degree-`j` piece of the restricted algebra is `MMP.Fourfold.imageSeries` of `q(K + Δ)` in
degree `j`, and the algebra is the set of polynomials in `k(S)[t]` with these coefficients.
Finite generation over `A₀` is the equality of that set with the subring generated by the image
of `A₀ → Γ(S, 𝒪_S) → k(S)` and finitely many polynomials.

The general position of `H` is expressed by the two properties of a general member of a
relatively very ample system that the proof uses: `(X, Δ + A) = (X, S + B + (2/a)H)` is plt (a
general member meets a log resolution of `(X, S + B)` transversely, and `2/a < 1`), and no prime
component `Q` of `H|_S` lies in the asymptotic restricted fixed divisor
`F = lim Fix(|mq(K + Δ)|_S)/(mq)`, that is, for every `n > 0` some nonzero restricted section
of `𝒪_S(jq(K_S + Ω))` vanishes along `Q` to order less than `j/n`. Only the `π`-ampleness of `H`
is assumed, not its very ampleness. The asymptotic fixed divisor is computed on the multiples
of `q`, which gives the same infimum (`MMP.Fourfold.factorial_base_limit`).

## References

* The fourfold source, *Restricted rationality*, the theorem on finite generation for a
  prepared restricted adjoint algebra.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Polynomial

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori

/-! ### The Veronese reindexing of a graded family -/

section Veronese

variable {M L : Type*} [CommRing M] [CommRing L] (R : Subring M) (e : M ≃+* L) (q : ℕ)
  (W : ℕ → AddSubgroup L) (hsmul : ∀ r ∈ R, ∀ j, ∀ h ∈ W j, e r * h ∈ W j)

/-- The `R`-submodules `V_m = e⁻¹ W_{m/q}` for `q ∣ m` and `V_m = 0` otherwise, of a family `W_j`
of additive subgroups of `L` stable under multiplication by `e(R)`. -/
private def veroneseSeries (m : ℕ) : Submodule R M where
  carrier := {s | if q ∣ m then e s ∈ W (m / q) else s = 0}
  add_mem' {a b} ha hb := by
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    split_ifs at ha hb ⊢
    · rw [map_add]; exact add_mem ha hb
    · rw [ha, hb, add_zero]
  zero_mem' := by
    simp only [Set.mem_setOf_eq, map_zero]
    split_ifs <;> simp
  smul_mem' := by
    rintro ⟨r, hr⟩ a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    split_ifs at ha ⊢
    · rw [Subring.smul_def, smul_eq_mul, map_mul]; exact hsmul r hr _ _ ha
    · rw [ha, smul_zero]

variable {R e q W hsmul}

private theorem mem_veroneseSeries {m : ℕ} {s : M} :
    s ∈ veroneseSeries R e q W hsmul m ↔ if q ∣ m then e s ∈ W (m / q) else s = 0 :=
  Iff.rfl

private theorem mem_veroneseSeries_mul (hq : 0 < q) (j : ℕ) {s : M} :
    s ∈ veroneseSeries R e q W hsmul (q * j) ↔ e s ∈ W j := by
  rw [mem_veroneseSeries, if_pos (dvd_mul_right q j), Nat.mul_div_cancel_left _ hq]

private theorem veroneseSeries_eq_bot {m : ℕ} (hm : ¬ q ∣ m) :
    veroneseSeries R e q W hsmul m = ⊥ := by
  ext s
  rw [mem_veroneseSeries, if_neg hm, Submodule.mem_bot]

private theorem one_mem_veroneseSeries (h1 : (1 : L) ∈ W 0) :
    (1 : M) ∈ veroneseSeries R e q W hsmul 0 := by
  rwa [mem_veroneseSeries, if_pos (dvd_zero q), map_one, Nat.zero_div]

private theorem mul_mem_veroneseSeries
    (hW : ∀ {i j : ℕ} {x y : L}, x ∈ W i → y ∈ W j → x * y ∈ W (i + j)) (m n : ℕ) :
    ∀ s ∈ veroneseSeries R e q W hsmul m, ∀ t ∈ veroneseSeries R e q W hsmul n,
      s * t ∈ veroneseSeries R e q W hsmul (m + n) := by
  intro s hs t ht
  rw [mem_veroneseSeries] at hs ht ⊢
  by_cases hm : q ∣ m
  · by_cases hn : q ∣ n
    · rw [if_pos hm] at hs
      rw [if_pos hn] at ht
      rw [if_pos (dvd_add hm hn), map_mul, Nat.add_div_of_dvd_right hm]
      exact hW hs ht
    · rw [if_neg hn] at ht
      split_ifs <;> simp [ht]
  · rw [if_neg hm] at hs
    split_ifs <;> simp [hs]

private theorem veroneseSeries_ne_bot (hq : 0 < q) (hne : W 1 ≠ ⊥) :
    veroneseSeries R e q W hsmul q ≠ ⊥ := by
  intro hbot
  refine hne ((AddSubgroup.eq_bot_iff_forall _).mpr fun h hh => ?_)
  have := (mem_veroneseSeries_mul (hsmul := hsmul) hq 1 (s := e.symm h)).mpr (by simpa using hh)
  rw [mul_one, hbot, Submodule.mem_bot] at this
  simpa using congrArg e this

private theorem coeff_expand_comp_map_symm (hq : 0 < q) (p : L[X]) (m : ℕ) :
    ((expand M q : M[X] →+* M[X]).comp (mapRingHom e.symm.toRingHom) p).coeff m =
      if q ∣ m then e.symm (p.coeff (m / q)) else 0 := by
  simp [coeff_expand hq, coeff_map]

private theorem image_expand_comp_map_symm (hq : 0 < q) :
    (expand M q : M[X] →+* M[X]).comp (mapRingHom e.symm.toRingHom) ''
        {p : L[X] | ∀ j, p.coeff j ∈ W j} =
      {P : M[X] | ∀ m, P.coeff m ∈ veroneseSeries R e q W hsmul m} := by
  ext P
  constructor
  · rintro ⟨p, hp, rfl⟩ m
    rw [mem_veroneseSeries, coeff_expand_comp_map_symm hq]
    split_ifs
    · simpa using hp (m / q)
    · rfl
  · intro hP
    refine ⟨map e.toRingHom (contract q P), fun j => ?_, ?_⟩
    · simpa [coeff_map, coeff_contract hq.ne', mul_comm] using
        (mem_veroneseSeries_mul hq j).mp (hP (q * j))
    · ext m
      rw [coeff_expand_comp_map_symm hq]
      split_ifs with h
      · obtain ⟨k, rfl⟩ := h
        simp [coeff_map, coeff_contract hq.ne', Nat.mul_div_cancel_left _ hq, mul_comm]
      · have := hP m
        rw [mem_veroneseSeries, if_neg h] at this
        exact this.symm

/-- **Veronese descent of finite generation.** If the algebra of polynomials in `M[t]` with
coefficients in the Veronese reindexing `V_m` of `W` is generated by the constants `φ(A)` and
finitely many elements, then so is the algebra of polynomials in `L[t]` with coefficients in
`W_j`, over `e ∘ φ`: the substitution `t ↦ t^q` is an injective ring map from the second onto the
first. -/
private theorem exists_finset_eq_closure_of_expand {A : Type*} [CommRing A] (φ : A →+* M)
    (hq : 0 < q) (G' : Finset M[X])
    (hG' : {P : M[X] | ∀ m, P.coeff m ∈ veroneseSeries R e q W hsmul m} =
      (Subring.closure (Set.range (C.comp φ) ∪ ↑G') : Set M[X])) :
    ∃ G : Finset L[X], {p : L[X] | ∀ j, p.coeff j ∈ W j} =
      (Subring.closure (Set.range (C.comp (e.toRingHom.comp φ)) ∪ ↑G) : Set L[X]) := by
  classical
  let Θ : L[X] →+* M[X] := (expand M q : M[X] →+* M[X]).comp (mapRingHom e.symm.toRingHom)
  have hΘc : ∀ p : L[X], ∀ m, (Θ p).coeff m = if q ∣ m then e.symm (p.coeff (m / q)) else 0 :=
    coeff_expand_comp_map_symm hq
  have hΘinj : Function.Injective Θ := by
    intro p p' h
    ext j
    have := congrArg (fun P => P.coeff (j * q)) h
    simp only [hΘc, dvd_mul_left, if_true, Nat.mul_div_cancel _ hq] at this
    exact e.symm.injective this
  have hImg : Θ '' {p : L[X] | ∀ j, p.coeff j ∈ W j} =
      {P : M[X] | ∀ m, P.coeff m ∈ veroneseSeries R e q W hsmul m} :=
    image_expand_comp_map_symm hq
  have hmem : ∀ g ∈ G', ∃ p : L[X], Θ p = g := by
    intro g hg
    obtain ⟨p, -, hp⟩ : g ∈ Θ '' {p : L[X] | ∀ j, p.coeff j ∈ W j} := by
      rw [hImg, hG']
      exact Subring.subset_closure (Or.inr hg)
    exact ⟨p, hp⟩
  choose! pre hpre using hmem
  refine ⟨G'.image pre, ?_⟩
  apply hΘinj.image_injective
  rw [hImg, hG', ← Subring.coe_map, RingHom.map_closure, Set.image_union]
  congr 3
  · ext P
    simp only [Set.mem_image, Set.mem_range, RingHom.coe_comp, Function.comp_apply]
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨_, ⟨a, rfl⟩, by simp [Θ]⟩
    · rintro ⟨_, ⟨a, rfl⟩, rfl⟩
      exact ⟨a, by simp [Θ]⟩
  · rw [Finset.coe_image, ← Set.image_comp, Set.image_congr (f := ⇑Θ ∘ pre) (g := id) hpre,
      Set.image_id]

end Veronese

/-! ### Restriction to `S` -/

/-- A section of `𝒪_X(E)`, `S` not a component of `E`, has a restriction to `S`. -/
private theorem exists_isRestrictionAlong {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    {E : Divisor X} (hES : E.coeff S = 0) {g : X.functionField} (hg : g ∈ sectionsIn E) :
    ∃ h, IsRestrictionAlong S g h := by
  have h1 : S.divisorialValuation g ≤ 1 := by
    have := hg S; rwa [hES, WithZero.exp_zero] at this
  obtain ⟨r, hr⟩ := (MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff S g).mp h1
  exact ⟨(S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom r,
    r, hr, rfl⟩

/-- The restriction to `S` is unique. -/
private theorem isRestrictionAlong_eq {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {S : MMP.Mori.PrimeDivisor X} [IsIntegral S.idealSheaf.subscheme]
    {g : X.functionField} {h h' : S.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong S g h) (hh' : IsRestrictionAlong S g h') : h = h' := by
  obtain ⟨a, ha1, ha2⟩ := hh
  obtain ⟨a', ha1', ha2'⟩ := hh'
  have : a = a' := by
    apply IsFractionRing.injective _ X.functionField
    change (X.presheaf.stalkSpecializes _).hom a = (X.presheaf.stalkSpecializes _).hom a'
    rw [ha1, ha1']
  rw [← ha2, ← ha2', this]

/-- Restriction to `S` is additive. -/
private theorem isRestrictionAlong_add {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {S : MMP.Mori.PrimeDivisor X} [IsIntegral S.idealSheaf.subscheme]
    {g g' : X.functionField} {h h' : S.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong S g h) (hh' : IsRestrictionAlong S g' h') :
    IsRestrictionAlong S (g + g') (h + h') := by
  obtain ⟨a, ha1, ha2⟩ := hh
  obtain ⟨a', ha1', ha2'⟩ := hh'
  exact ⟨a + a', by rw [map_add, ha1, ha1'], by rw [map_add, ha2, ha2']⟩

/-- The restriction of `0` is `0`. -/
private theorem isRestrictionAlong_zero {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {S : MMP.Mori.PrimeDivisor X} [IsIntegral S.idealSheaf.subscheme] :
    IsRestrictionAlong S 0 0 :=
  ⟨0, map_zero _, map_zero _⟩

/-- Restriction to `S` is linear over the global functions of `X`. -/
private theorem isRestrictionAlong_germ_mul {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {S : MMP.Mori.PrimeDivisor X} [IsIntegral S.idealSheaf.subscheme]
    {g : X.functionField} {h : S.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong S g h) (s : Γ(X, ⊤)) :
    IsRestrictionAlong S (X.presheaf.germ ⊤ (genericPoint X) trivial s * g)
      (S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint _) trivial
        (S.idealSheaf.subschemeι.appTop s) * h) := by
  obtain ⟨a, ha1, ha2⟩ := hh
  refine ⟨X.presheaf.germ ⊤ _ trivial s * a, ?_, ?_⟩
  · rw [map_mul, ha1]
    congr 1
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  · rw [map_mul, ha2]
    congr 1
    exact Scheme.Hom.germ_stalkMap_apply S.idealSheaf.subschemeι ⊤ _ trivial s

/-- The base map `A → Γ(T) → Γ(S) → K(S)` of a restricted series, read in the function field, is
the germ at the generic point of the pullback of `a` along `f ≫ g`. -/
private theorem rationalFunctionsEquivFunctionField_restrictedSeriesBaseMap {A : Type} [CommRing A]
    {S T : Scheme.{0}} [IsIntegral S]
    (g : T ⟶ Spec (.of A)) (f : S ⟶ T) (a : A) :
    rationalFunctionsEquivFunctionField S (restrictedSeriesBaseMap g f a) =
      S.presheaf.germ ⊤ (genericPoint S) trivial
        ((f ≫ g).appTop ((Scheme.ΓSpecIso (.of A)).inv a)) := by
  haveI : Nonempty (⊤ : S.Opens) := ⟨⟨genericPoint S, trivial⟩⟩
  rw [restrictedSeriesBaseMap, RingHom.comp_apply, globalSectionsToRationalFunctions_apply,
    MMP.FourfoldProofs.FractionalLogComplexProof.rationalFunctionsEquivFunctionField_eq_germ (U := ⊤) _
      (f.appTop (g.appTop ((Scheme.ΓSpecIso (.of A)).inv a)))]
  · simp only [Scheme.germToFunctionField, Scheme.Hom.comp_appTop]; rfl
  · simp

/-- A global function of `X` has no pole along any prime divisor. -/
private theorem divisorialValuation_germ_le_one {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (P : MMP.Mori.PrimeDivisor X) (s : Γ(X, ⊤)) :
    P.divisorialValuation (X.presheaf.germ ⊤ (genericPoint X) trivial s) ≤ 1 := by
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨P.genericPoint, trivial⟩⟩
  refine ⟨X.presheaf.stalkSpecializes (specializes_refl _)
    (X.presheaf.germ ⊤ P.genericPoint trivial s), ?_⟩
  rw [MMP.Mori.algebraMap_stalkSpecializes]
  exact Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ⊤) trivial s

/-- The sections of `𝒪_X(E)` are a module over the global functions of `X`. -/
private theorem germ_mul_mem_sectionsIn {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {E : Divisor X} (s : Γ(X, ⊤)) {g : X.functionField} (hg : g ∈ sectionsIn E) :
    X.presheaf.germ ⊤ (genericPoint X) trivial s * g ∈ sectionsIn E := fun P => by
  rw [map_mul]
  simpa using mul_le_mul' (divisorialValuation_germ_le_one P s) (hg P)

/-- An additive map sends the image series into an additive subgroup as soon as it sends the
restriction of every section there. -/
private theorem map_mem_of_mem_imageSeries {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {D : Divisor X} {S : MMP.Mori.PrimeDivisor X}
    [IsIntegral S.idealSheaf.subscheme] {G : Type*} [AddCommGroup G]
    (φ : S.idealSheaf.subscheme.functionField →+ G) (K : AddSubgroup G) {j : ℕ}
    (hφ : ∀ g ∈ sectionsIn ((j : ℤ) • D), ∀ h, IsRestrictionAlong S g h → φ h ∈ K)
    {h : S.idealSheaf.subscheme.functionField} (hh : h ∈ imageSeries D S j) : φ h ∈ K :=
  (AddSubgroup.closure_le (K := K.comap φ)).mpr (by rintro _ ⟨g, hg, hres⟩; exact hφ g hg _ hres) hh

/-- The image series of `D` on `S` is a module over the global functions of `X`. -/
private theorem germ_appTop_mul_mem_imageSeries {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (D : Divisor X) (S : MMP.Mori.PrimeDivisor X)
    [IsIntegral S.idealSheaf.subscheme] (s : Γ(X, ⊤)) (j : ℕ)
    {h : S.idealSheaf.subscheme.functionField} (hh : h ∈ imageSeries D S j) :
    S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint _) trivial
        (S.idealSheaf.subschemeι.appTop s) * h ∈ imageSeries D S j :=
  map_mem_of_mem_imageSeries (AddMonoidHom.mulLeft _) (imageSeries D S j) (fun _ hg _ hres =>
    AddSubgroup.subset_closure
      ⟨_, germ_mul_mem_sectionsIn s hg, isRestrictionAlong_germ_mul hres s⟩)
    hh

/-- The image series of `D` on `S` is a module over the base ring of a restricted series on `S`
through `X ⟶ Spec A₀`. -/
private theorem restrictedSeriesBaseMap_mul_mem_imageSeries {A₀ : Type} [CommRing A₀]
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (π : X ⟶ Spec (.of A₀)) (D : Divisor X) (S : MMP.Mori.PrimeDivisor X)
    [IsIntegral S.idealSheaf.subscheme] {T : Scheme.{0}} {g : T ⟶ Spec (.of A₀)}
    {f : S.idealSheaf.subscheme ⟶ T} (hfg : f ≫ g = S.idealSheaf.subschemeι ≫ π) :
    ∀ r ∈ (restrictedSeriesBaseMap g f).range, ∀ j, ∀ h ∈ imageSeries D S j,
      rationalFunctionsEquivFunctionField _ r * h ∈ imageSeries D S j := by
  rintro r ⟨a, rfl⟩ j h hh
  rw [rationalFunctionsEquivFunctionField_restrictedSeriesBaseMap, hfg, Scheme.Hom.comp_appTop]
  exact germ_appTop_mul_mem_imageSeries D S _ j hh

/-- A global function, read in the function field, is its germ at the generic point. -/
private theorem rationalFunctionsEquivFunctionField_globalSections {X : Scheme.{0}} [IsIntegral X]
    (r : Γ(X, ⊤)) :
    rationalFunctionsEquivFunctionField X (globalSectionsToRationalFunctions r) =
      X.presheaf.germ ⊤ (genericPoint X) trivial r := by
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨genericPoint X, trivial⟩⟩
  rw [globalSectionsToRationalFunctions_apply,
    MMP.FourfoldProofs.FractionalLogComplexProof.rationalFunctionsEquivFunctionField_eq_germ
      (U := ⊤) _ r]
  simp

/-- **The sections of a Cartier divisor are finite over the base.** For `π : X ⟶ Spec A₀`
proper with `A₀` Noetherian and `E` Cartier, finitely many sections `yᵢ` of `𝒪_X(E)` span all
sections over `A₀`: `𝒪_X(E)` is invertible, hence coherent, and its global sections are finite
over `A₀` ([Stacks, Tag 02O6]). -/
private theorem exists_sum_eq_of_mem_sectionsIn {A₀ : Type} [CommRing A₀] [IsNoetherianRing A₀]
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (π : X ⟶ Spec (.of A₀)) [IsProper π] (E : Divisor X) (hE : E.IsCartier) :
    ∃ (n : ℕ) (y : Fin n → X.functionField), (∀ i, y i ∈ sectionsIn E) ∧
      ∀ g ∈ sectionsIn E, ∃ c : Fin n → A₀, g = ∑ i,
        X.presheaf.germ ⊤ (genericPoint X) trivial
          (π.appTop ((Scheme.ΓSpecIso (.of A₀)).inv (c i))) * y i := by
  classical
  haveI := hE.isInvertibleModule_divisorialSheaf
  haveI : E.divisorialSheaf.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible X E.divisorialSheaf
  obtain ⟨t, ht⟩ :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_finset_eq_sum_base (R := A₀) π
      E.divisorialSheaf
  let L := Stacks.SectionRingZero.schemeGlobalSectionsLinearEquiv X E.divisorialSheaf
  let toFF : Γ(E.divisorialSheaf, ⊤) → X.functionField := fun φ =>
    rationalFunctionsEquivFunctionField X
      (rationalFunctionsPresheafTopEquiv X (show E.divisorialSubmodule ⊤ from φ).1)
  have htoFF_add : ∀ a b, toFF (a + b) = toFF a + toFF b := fun a b =>
    (congrArg (fun x =>
        rationalFunctionsEquivFunctionField X (rationalFunctionsPresheafTopEquiv X x))
      (Submodule.coe_add (show E.divisorialSubmodule ⊤ from a)
        (show E.divisorialSubmodule ⊤ from b))).trans
      (by simp only [map_add]; rfl)
  have htoFF_smul : ∀ (r : Γ(X, ⊤)) a, toFF (r • a) =
      X.presheaf.germ ⊤ (genericPoint X) trivial r * toFF a := fun r a => by
    refine (congrArg (fun x => rationalFunctionsEquivFunctionField X
      (rationalFunctionsPresheafTopEquiv X x))
      (Submodule.coe_smul r (show E.divisorialSubmodule ⊤ from a))).trans ?_
    simp only [Algebra.smul_def, map_mul]
    rw [← rationalFunctionsEquivFunctionField_globalSections]
    rfl
  let e := t.equivFin
  refine ⟨t.card, fun i => toFF (L (e.symm i)), fun i => ?_, fun g hg => ?_⟩
  · exact mem_sectionsIn_of_mem_divisorialSections E
      (show E.divisorialSubmodule ⊤ from L (e.symm i)).2
  · let φ : Γ(E.divisorialSheaf, ⊤) := (⟨(rationalFunctionsPresheafTopEquiv X).symm
      ((rationalFunctionsEquivFunctionField X).symm g), symm_mem_divisorialSections E hg⟩ :
        E.divisorialSubmodule ⊤)
    obtain ⟨c, hc⟩ := ht (L.symm φ)
    refine ⟨fun i => c (e.symm i), ?_⟩
    have hφ : toFF φ = g := by
      change rationalFunctionsEquivFunctionField X (rationalFunctionsPresheafTopEquiv X
        ((rationalFunctionsPresheafTopEquiv X).symm
          ((rationalFunctionsEquivFunctionField X).symm g))) = g
      simp
    let toFF' : Γ(E.divisorialSheaf, ⊤) →+ X.functionField :=
      { toFun := toFF
        map_zero' := by
          change rationalFunctionsEquivFunctionField X (rationalFunctionsPresheafTopEquiv X 0) = 0
          simp
        map_add' := htoFF_add }
    have hφ' : toFF' φ = g := hφ
    rw [← hφ', ← L.apply_symm_apply φ, hc, map_sum, map_sum]
    simp only [map_smul]
    rw [← Finset.sum_coe_sort t, ← e.symm.sum_comp]
    refine Finset.sum_congr rfl fun i _ => ?_
    exact htoFF_smul _ _

/-! ### The boundary along `S` -/

/-- `A = H/a` is effective when `H` is. -/
private theorem coeff_nonneg_of_eq_inv_smul {X : Scheme.{0}} {H : Divisor X} (hH : 0 ≤ H)
    {a : ℕ} {A : QDivisor X} (hA : A = (a : ℚ)⁻¹ • Divisor.toQDivisor H)
    (P : MMP.Mori.PrimeDivisor X) : 0 ≤ A.coeff P := by
  rw [hA]
  change 0 ≤ (a : ℚ)⁻¹ * ((H.coeff P : ℤ) : ℚ)
  have : (0 : ℚ) ≤ (H.coeff P : ℚ) := by exact_mod_cast hH P
  positivity

/-- `S` is not a component of `A + B`: the plt boundary `Δ = S + A + B`, `A, B ≥ 0`, has
coefficient at most `1` along `S`. -/
private theorem coeff_add_eq_zero_of_isPltPair {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {d : ℕ} (hd : 2 ≤ d)
    {K : Divisor X} {S : MMP.Mori.PrimeDivisor X} {A B Δ : QDivisor X}
    (hA : ∀ P, 0 ≤ A.coeff P) (hB : 0 ≤ B)
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B)
    (hplt : IsPltPair sX (d + 1) K Δ) : (A + B).coeff S = 0 := by
  have h1 := hplt.isLcPair.coeff_le_one (by omega) S
  have h2 : Δ.coeff S = 1 + A.coeff S + B.coeff S := by
    rw [hΔ]
    change ((Finsupp.single S (1 : ℤ)) S : ℚ) + A.coeff S + B.coeff S = _
    rw [Finsupp.single_eq_same]; push_cast; rfl
  have h3 : 0 ≤ B.coeff S := hB S
  change A.coeff S + B.coeff S = 0
  linarith [hA S]

/-- `S` is not a component of `qK + ⌊qΔ⌋` when `K` has coefficient `-1` along `S`. -/
private theorem coeff_qDivisor_eq_zero {X : Scheme.{0}} {K : Divisor X}
    {S : MMP.Mori.PrimeDivisor X} {A B Δ : QDivisor X}
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B) (hKS : K.coeff S = -1)
    (hABS : (A + B).coeff S = 0) {q : ℕ} {D' : Divisor X}
    (hD' : Divisor.toQDivisor D' = (q : ℚ) • Δ) :
    ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown).coeff S = 0 := by
  have h1 := congrArg (fun G : QDivisor X => G.coeff S) hD'
  have h2 : ((q : ℚ) • Δ).coeff S = q := by
    change (q : ℚ) * Δ.coeff S = q
    rw [hΔ]
    change (q : ℚ) * (((Finsupp.single S (1 : ℤ)) S : ℚ) + A.coeff S + B.coeff S) = q
    have : A.coeff S + B.coeff S = 0 := hABS
    rw [Finsupp.single_eq_same, add_assoc, this]; push_cast; ring
  simp only [Divisor.coeff_toQDivisor, h2] at h1
  have h3 : D'.coeff S = q := by exact_mod_cast h1
  rw [← hD', roundDown_toQDivisor', DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
    hKS, h3]
  simp

/-- With `qΔ` integral, `q(A + B)|_S` is an integral Cartier divisor on the smooth `S`. -/
private theorem isCartierDivisor_zsmul_restrictPrimeDivisor {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    {S : MMP.Mori.PrimeDivisor X}
    [IsIntegral S.idealSheaf.subscheme] [IsLocallyNoetherian S.idealSheaf.subscheme]
    [IsNormal S.idealSheaf.subscheme] (hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    {A B Δ : QDivisor X} (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B)
    (hABS : (A + B).coeff S = 0) {q : ℕ} (hqΔ : ((q : ℚ) • Δ).IsCartierDivisor) :
    QDivisor.IsCartierDivisor ((q : ℤ) • (A + B).restrictPrimeDivisor S) := by
  obtain ⟨D', hD', -⟩ := hqΔ
  have hE : Divisor.toQDivisor (D' - (q : ℤ) • Finsupp.single S 1) = (q : ℤ) • (A + B) := by
    refine Finsupp.ext fun P => ?_
    have := congrArg (fun G : QDivisor X => G.coeff P) hD'
    change ((DivisorWithCoeffs.coeff (D' - (q : ℤ) • Finsupp.single S (1 : ℤ)) P : ℤ) : ℚ) =
      DivisorWithCoeffs.coeff ((q : ℤ) • (A + B)) P
    simp only [Divisor.coeff_toQDivisor, hΔ, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub] at this ⊢
    push_cast
    rw [this]
    simp only [smul_eq_mul, zsmul_eq_mul, Int.cast_natCast]
    by_cases hPS : P = S
    · subst hPS
      simp [DivisorWithCoeffs.coeff_single_self]
      ring
    · simp [DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hPS)]
  have hES : (D' - (q : ℤ) • Finsupp.single S 1).coeff S = 0 := by
    have := congrArg (fun G : QDivisor X => G.coeff S) hE
    simp only [Divisor.coeff_toQDivisor] at this
    have h2 : ((q : ℤ) • (A + B)).coeff S = 0 := by
      change (q : ℤ) • (A + B).coeff S = 0
      rw [hABS, smul_zero]
    rw [h2] at this
    exact_mod_cast this
  rw [← MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_zsmul _ _ hABS, ← hE,
    MMP.Mori.Divisor.restrictPrimeDivisor_toQDivisor _ _ hES]
  exact QDivisor.isCartierDivisor_toQDivisor.mpr (isCartier_of_isSmoothScheme hSsm _)

/-- **A klt criterion through Kollár–Mori discrepancies.** A pair with effective boundary whose
Kollár–Mori discrepancies along all exceptional and prime divisors exceed `-1` is klt: its log
discrepancies are `1 + a` (`MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy`), and a
non-exceptional divisor has the valuation of a prime divisor. -/
private theorem isKltPair_of_forall_neg_one_lt {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y]
    [IsNormal Y] {sY : Y ⟶ Spec (.of ℂ)} (hY : IsNormalVariety ℂ sY) {n : ℕ} {KY : Divisor Y}
    (hKY : KY.IsCanonicalDivisor sY n) {Θ : QDivisor Y} (hP : MMP.Mori.IsPair sY Θ)
    (hΘ : ∀ P, 0 ≤ Θ.coeff P)
    (hall : ∀ (D : DivisorOver ℂ sY) (a : ℚ), D.IsExceptionalOrPrimeDivisor →
      MMP.Mori.IsDiscrepancy sY n KY Θ D a → -1 < a) :
    MMP.Fourfold.IsKltPair sY Θ := by
  refine ⟨⟨inferInstance, inferInstance, hP, hΘ⟩, fun n' D a ha => ?_⟩
  have hn : n' = n := by
    have e := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha).symm.trans
      hKY.topologicalKrullDim_eq
    exact_mod_cast e
  subst hn
  by_cases hD : D.IsExceptional
  · obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hKY D
    obtain ⟨-, rfl⟩ := (MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hc a).mp ha
    have := hall D c (Or.inl hD) hc
    have : (-1 : ℝ) < c := by exact_mod_cast this
    linarith
  · obtain ⟨P, hv⟩ := MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional
      hY D hD
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hKY
      (DivisorOver.ofPrimeDivisor ℂ hY P)
    have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
      (by change IsProper (𝟙 Y); infer_instance)
    have heq := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hlog hv
    have := hall _ c (Or.inr ⟨hY, P, rfl⟩) hc
    have : (-1 : ℝ) < c := by exact_mod_cast this
    linarith

private theorem isReducedEffective_single_one {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (S : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsReducedEffective (Finsupp.single S (1 : ℤ) : Divisor X) := by
  intro P
  by_cases hPS : P = S
  · subst hPS
    exact Or.inr Finsupp.single_eq_same
  · exact Or.inl (Finsupp.single_eq_of_ne' (Ne.symm hPS))

/-- The pair on the single normal component `S`, with canonical divisor `(K + S)|_S` and boundary
`Θ|_S`. -/
private noncomputable def singleComponentPair {d : ℕ} {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {K : Divisor X}
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hSn : IsNormalVariety ℂ (S.idealSheaf.subschemeι ≫ sX)) (Θ : QDivisor X)
    (hKScan : Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) d
      ((K + Finsupp.single S 1).restrictPrimeDivisor S))
    (hqC : (Divisor.toQDivisor ((K + Finsupp.single S 1).restrictPrimeDivisor S) +
      Θ.restrictPrimeDivisor S).IsQCartier) :
    PairOnNormalDivisor sX :=
  have hsupp : (Finsupp.single S (1 : ℤ)).support = {S} :=
    Finsupp.support_single_ne_zero _ one_ne_zero
  have hcomp : ∀ E : (Finsupp.single S (1 : ℤ)).support, E.1 = S := fun ⟨E, hE⟩ => by
    rw [hsupp] at hE
    exact Finset.mem_singleton.mp hE
  { components := (Finsupp.single S (1 : ℤ)).support
    pairwise_disjoint := by
      rw [hsupp, Finset.coe_singleton]
      exact Set.pairwise_singleton _ _
    isNormalVariety := fun E => by
      rw [hcomp E]
      exact hSn
    dim := d
    K := fun E => (K + Finsupp.single E.1 1).restrictPrimeDivisor E.1
    Θ := fun E => Θ.restrictPrimeDivisor E.1
    isCanonicalDivisor := fun E => by
      obtain ⟨E, hE⟩ := E
      obtain rfl : S = E := (hcomp ⟨E, hE⟩).symm
      exact hKScan
    isQCartier := fun E => by
      obtain ⟨E, hE⟩ := E
      obtain rfl : S = E := (hcomp ⟨E, hE⟩).symm
      exact hqC }

/-- The total discrepancy of `(S, (K + S)|_S, (A + B)|_S)` exceeds `-1` when `(X, S + A + B)` is
plt: it dominates the total discrepancy of `(X, S + A + B)` along `S`. -/
private theorem neg_one_lt_totalDiscrep_restrictPrimeDivisor {d : ℕ}
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hXn : IsNormalVariety ℂ sX) (hsm : IsSmoothScheme sX)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (d + 1))
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hSn : IsNormalVariety ℂ (S.idealSheaf.subschemeι ≫ sX)) {A B Δ : QDivisor X}
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B) (hABS : (A + B).coeff S = 0)
    (hplt : IsPltPair sX (d + 1) K Δ) {q : ℕ} (hq : 0 < q)
    (hqΔ : ((q : ℚ) • Δ).IsCartierDivisor)
    (hKScan : Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) d
      ((K + Finsupp.single S 1).restrictPrimeDivisor S))
    (hqC : (Divisor.toQDivisor ((K + Finsupp.single S 1).restrictPrimeDivisor S) +
      (A + B).restrictPrimeDivisor S).IsQCartier) :
    -1 < MMP.Mori.totalDiscrep (S.idealSheaf.subschemeι ≫ sX) d
      ((K + Finsupp.single S 1).restrictPrimeDivisor S) ((A + B).restrictPrimeDivisor S) := by
  have hsupp : (Finsupp.single S (1 : ℤ)).support = {S} :=
    Finsupp.support_single_ne_zero _ one_ne_zero
  have hBsupp : ∀ P ∈ (Finsupp.single S (1 : ℤ)).support, (A + B).coeff P = 0 := by
    intro P hP
    rw [hsupp, Finset.mem_singleton] at hP
    rwa [hP]
  obtain ⟨D', hD', -⟩ := hqΔ
  have hKSB : (Divisor.toQDivisor K + Divisor.toQDivisor (Finsupp.single S 1) +
      (A + B)).IsQCartier := by
    rw [show Divisor.toQDivisor K + Divisor.toQDivisor (Finsupp.single S 1) + (A + B) =
      Divisor.toQDivisor K + Δ by rw [hΔ]; abel]
    refine ⟨q, by exact_mod_cast hq.ne', (q : ℤ) • K + D', ?_, isCartier_of_isSmoothScheme hsm _⟩
    rw [map_add, map_zsmul, hD', smul_add]
    congr 1
  let P := singleComponentPair (d := d) S hSn (A + B) hKScan hqC
  have hineq := MMP.Mori.discrepCenterIn_le_totalDiscrepCenterIn_of_components_eq hXn hK
    (Finsupp.single S 1) (isReducedEffective_single_one S)
    (fun x _ _ => let ⟨_, hxU, _, hφ⟩ := isCartier_of_isSmoothScheme hsm _ x
      MMP.Flips.isCartierAt_of_isLocalEquation hxU hφ) Set.univ hBsupp hKSB P rfl rfl
    (fun _ => rfl)
  have hΔ'' : Divisor.toQDivisor (Finsupp.single S 1) + (A + B) = Δ := by rw [hΔ]; abel
  rw [MMP.Mori.discrepCenterIn_univ, hΔ''] at hineq
  have hlt := hplt.2.trans_le hineq
  have hE0 : S ∈ P.components := by
    change S ∈ (Finsupp.single S (1 : ℤ)).support
    rw [hsupp]
    exact Finset.mem_singleton_self S
  unfold MMP.Mori.PairOnNormalDivisor.totalDiscrepCenterIn at hlt
  have hlt' := hlt.trans_le (iInf_le _ (⟨S, hE0⟩ : P.components))
  simp only [Set.preimage_univ, MMP.Mori.totalDiscrepCenterIn_univ] at hlt'
  exact hlt'

/-- **Inversion of adjunction for the restricted boundary.** If `(X, S + A + B)` is plt, with
`X` smooth, `S` a smooth prime divisor not a component of `A + B ≥ 0` and `q(S + A + B)`
integral, then `(S, (A + B)|_S)` is klt: the discrepancies of `(S, (A + B)|_S)` dominate the
total discrepancy of `(X, S + A + B)` along `S`
(`MMP.Mori.discrepCenterIn_le_totalDiscrepCenterIn_of_components_eq`). -/
private theorem isKltPair_restrictPrimeDivisor {d : ℕ}
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hXn : IsNormalVariety ℂ sX) (hsm : IsSmoothScheme sX)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (d + 1))
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hKS : K.coeff S = -1) (hSn : IsNormalVariety ℂ (S.idealSheaf.subschemeι ≫ sX))
    (hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    {A B Δ : QDivisor X} (hA : ∀ P, 0 ≤ A.coeff P) (hB : 0 ≤ B)
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B) (hABS : (A + B).coeff S = 0)
    (hplt : IsPltPair sX (d + 1) K Δ) {q : ℕ} (hq : 0 < q)
    (hqΔ : ((q : ℚ) • Δ).IsCartierDivisor) :
    MMP.Fourfold.IsKltPair (S.idealSheaf.subschemeι ≫ sX) ((A + B).restrictPrimeDivisor S) := by
  have hKScan := isCanonicalDivisor_restrictPrimeDivisor_add_single hXn hsm hK S hKS
  obtain ⟨D'', hD'', -⟩ := isCartierDivisor_zsmul_restrictPrimeDivisor hSsm hΔ hABS hqΔ
  have hqC : (Divisor.toQDivisor ((K + Finsupp.single S 1).restrictPrimeDivisor S) +
      (A + B).restrictPrimeDivisor S).IsQCartier :=
    ⟨q, by exact_mod_cast hq.ne', (q : ℤ) • (K + Finsupp.single S 1).restrictPrimeDivisor S + D'',
      by rw [map_add, map_zsmul, hD'', smul_add], isCartier_of_isSmoothScheme hSsm _⟩
  have hlt' := neg_one_lt_totalDiscrep_restrictPrimeDivisor hXn hsm hK S hSn hΔ hABS hplt hq hqΔ
    hKScan hqC
  haveI : IsNoetherian X := {}
  refine isKltPair_of_forall_neg_one_lt hSn hKScan ⟨hSn, d, _, hKScan, hqC⟩ (fun Q => ?_)
    fun D₀ a₀ hD₀ ha₀ => ?_
  · rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor _ _ hABS]
    exact Finset.sum_nonneg fun E _ => nsmul_nonneg (add_nonneg (hA E) (hB E)) _
  · have h1 := hlt'.trans_le (MMP.Mori.totalDiscrep_le hD₀ ha₀)
    have h2 : ((-1 : ℝ) : EReal) < ((a₀ : ℝ) : EReal) := by simpa using h1
    exact_mod_cast EReal.coe_lt_coe_iff.mp h2

/-! ### The reindexed image series -/

/-- The Veronese reindexing of the image series of `D` on `S`, over the base ring of the
restricted series `S ⟶ T ⟶ Spec A₀`. -/
private noncomputable abbrev imageVeronese {A₀ : Type} [CommRing A₀] {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (π : X ⟶ Spec (.of A₀)) (D : Divisor X)
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme] {T : Scheme.{0}}
    (g : T ⟶ Spec (.of A₀)) (f : S.idealSheaf.subscheme ⟶ T)
    (hfg : f ≫ g = S.idealSheaf.subschemeι ≫ π) (q : ℕ) :
    ℕ → Submodule (restrictedSeriesBaseMap g f).range (RationalFunctions S.idealSheaf.subscheme) :=
  veroneseSeries _ (rationalFunctionsEquivFunctionField _) q (imageSeries D S)
    (restrictedSeriesBaseMap_mul_mem_imageSeries π D S hfg)

/-- Restricted sections of `𝒪_X(j(qK + ⌊qΔ⌋))` are sections of `𝒪_S(qj(K_S + (A + B)|_S))`. -/
private theorem mem_divisorialSections_of_mem_imageSeries
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hsm : IsSmoothScheme sX) {K : Divisor X}
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX)) {A B Δ : QDivisor X}
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B) (hKS : K.coeff S = -1)
    (hABS : (A + B).coeff S = 0) {q : ℕ} {D' : Divisor X}
    (hD' : Divisor.toQDivisor D' = (q : ℚ) • Δ) (j : ℕ)
    {s : RationalFunctions S.idealSheaf.subscheme}
    (hs : rationalFunctionsEquivFunctionField _ s ∈
      imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S j) :
    s ∈ divisorialSections ((q * j) • (K + Finsupp.single S 1).restrictPrimeDivisor S +
        (((q * j : ℕ) : ℚ) • (A + B).restrictPrimeDivisor S).roundDown) := by
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  rw [← restrictPrimeDivisor_smul_eq K S A B Δ hΔ hKS hABS q j (q * j) (mul_comm _ _) D' hD',
    ← (rationalFunctionsEquivFunctionField _).symm_apply_apply s]
  refine map_mem_of_mem_imageSeries (rationalFunctionsEquivFunctionField _).symm.toAddMonoidHom
    _ (fun g hg h hres => symm_mem_divisorialSections _
      (mem_sectionsIn_restrictPrimeDivisor sX S _ ?_ hg hres)) hs
  rw [DivisorWithCoeffs.coeff_smul, coeff_qDivisor_eq_zero hΔ hKS hABS hD', smul_zero]

/-- **Each degree of the image series is finite over `A₀`.** For `X ⟶ Spec A₀` proper and `X`
smooth, the restrictions to `S` of the sections of `𝒪_X(jD)`, `S` not a component of `D`, are
spanned over `A₀` by the restrictions of finitely many sections
(`exists_sum_eq_of_mem_sectionsIn`). -/
private theorem fg_imageVeronese {A₀ : Type} [CommRing A₀] [IsNoetherianRing A₀]
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} (hsm : IsSmoothScheme sX) (π : X ⟶ Spec (.of A₀)) [IsProper π]
    (D : Divisor X) (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    (hDS : D.coeff S = 0) {T : Scheme.{0}} (g : T ⟶ Spec (.of A₀))
    (f : S.idealSheaf.subscheme ⟶ T) (hfg : f ≫ g = S.idealSheaf.subschemeι ≫ π) {q : ℕ}
    (hq : 0 < q) (m : ℕ) : (imageVeronese π D S g f hfg q m).FG := by
  by_cases hm : q ∣ m
  swap
  · rw [imageVeronese, veroneseSeries_eq_bot hm]
    exact Submodule.fg_bot
  obtain ⟨j, rfl⟩ := hm
  set e := rationalFunctionsEquivFunctionField S.idealSheaf.subscheme
  have hjD : ((j : ℤ) • D).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_smul, hDS, smul_zero]
  obtain ⟨n, y, hy, hspan⟩ := exists_sum_eq_of_mem_sectionsIn π _
    (isCartier_of_isSmoothScheme hsm ((j : ℤ) • D))
  choose hr hhr using fun i => exists_isRestrictionAlong S hjD (hy i)
  have hW : ∀ (c : Fin n → A₀) (t : Finset (Fin n)), IsRestrictionAlong S
      (∑ i ∈ t, X.presheaf.germ ⊤ (genericPoint X) trivial
        (π.appTop ((Scheme.ΓSpecIso (.of A₀)).inv (c i))) * y i)
      (∑ i ∈ t, e (restrictedSeriesBaseMap g f (c i)) * hr i) := by
    intro c t
    classical
    induction t using Finset.induction_on with
    | empty => simpa using isRestrictionAlong_zero (S := S)
    | insert i t hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi,
        rationalFunctionsEquivFunctionField_restrictedSeriesBaseMap, hfg, Scheme.Hom.comp_appTop]
      exact isRestrictionAlong_add (isRestrictionAlong_germ_mul (hhr i) _) ih
  let R := (restrictedSeriesBaseMap g f).range
  suffices imageVeronese π D S g f hfg q (q * j) =
      Submodule.span R (Set.range fun i => e.symm (hr i)) by
    rw [this]; exact Submodule.fg_span (Set.finite_range _)
  refine le_antisymm (fun s hs => ?_) ((Submodule.span_le).mpr ?_)
  · rw [imageVeronese, mem_veroneseSeries_mul hq] at hs
    rw [← e.symm_apply_apply s]
    refine map_mem_of_mem_imageSeries e.symm.toAddMonoidHom (Submodule.span R _).toAddSubgroup
      (fun g₀ hg₀ x hgx => ?_) hs
    obtain ⟨c, rfl⟩ := hspan g₀ hg₀
    change e.symm x ∈ Submodule.span R (Set.range fun i => e.symm (hr i))
    rw [isRestrictionAlong_eq hgx (hW c Finset.univ), map_sum]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [map_mul, RingEquiv.symm_apply_apply]
    have := Submodule.smul_mem (Submodule.span R (Set.range fun i => e.symm (hr i)))
      (⟨restrictedSeriesBaseMap g f (c i), c i, rfl⟩ : R) (Submodule.subset_span ⟨i, rfl⟩)
    rwa [Subring.smul_def, smul_eq_mul] at this
  · rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, imageVeronese, mem_veroneseSeries_mul hq, RingEquiv.apply_symm_apply]
    exact AddSubgroup.subset_closure ⟨y i, hy i, hhr i⟩

/-! ### The lifting property and finite generation -/

/-- **The reindexed restricted algebra is a graded restricted series with the lifting
property.** The series `V_{qj} = R_S(X, q(K_X + Δ))_j` on `S`, over `K_S = (K + S)|_S` and
`Ω = (A + B)|_S`, satisfies every axiom of a graded restricted series (with `(S, Ω)` klt by
`isKltPair_restrictPrimeDivisor` and each degree finite by `fg_imageVeronese`), and the
section-lifting theorem `MMP.Fourfold.exists_forall_mem_of_isPltPair_add` gives the lifting
inequality. -/
private theorem hasRestrictedLiftingProperty_imageVeronese
    (d : ℕ) (hd : 2 ≤ d)
    {A₀ : Type} [CommRing A₀] [IsDomain A₀] [Algebra ℂ A₀] [Algebra.FiniteType ℂ A₀]
    [IsIntegrallyClosed A₀]
    (X : Scheme.{0}) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (sX : X ⟶ Spec (.of ℂ)) (π : X ⟶ Spec (.of A₀))
    (hπ : π ≫ Spec.map (CommRingCat.ofHom (algebraMap ℂ A₀)) = sX)
    (hπp : IsProjectiveMorphism π) (hsm : IsSmoothScheme sX)
    (K : Divisor X) (hK : K.IsCanonicalDivisor sX (d + 1))
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hKS : K.coeff S = -1) (hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (H : Divisor X) (a : ℕ) (A B Δ : QDivisor X)
    (hH : 0 ≤ H) (hHa : MMP.Flips.IsRelativelyAmpleCartier π H) (ha : 3 ≤ a)
    (hA : A = (a : ℚ)⁻¹ • Divisor.toQDivisor H) (hB : 0 ≤ B)
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B)
    (hfloor : Δ.roundDown = Finsupp.single S 1)
    (hplt : IsPltPair sX (d + 1) K Δ) (hplt' : IsPltPair sX (d + 1) K (Δ + A))
    (hcan : ∃ KS : Divisor S.idealSheaf.subscheme,
      IsCanonicalPair (S.idealSheaf.subschemeι ≫ sX) d KS ((2 • A + B).restrictPrimeDivisor S))
    (T : Scheme.{0}) (sT : T ⟶ Spec (.of ℂ)) (g : T ⟶ Spec (.of A₀))
    (f : S.idealSheaf.subscheme ⟶ T)
    (hg : g ≫ Spec.map (CommRingCat.ofHom (algebraMap ℂ A₀)) = sT) (hgf : IsFinite g)
    (hT : IsNormalVariety ℂ sT) (hTa : IsAffine T) (hfg : f ≫ g = S.idealSheaf.subschemeι ≫ π)
    (hfp : IsProjectiveMorphism f) (hfb : IsBirationalMorphism f)
    (q : ℕ) (hq : 0 < q) (hqΔ : ((q : ℚ) • Δ).IsCartierDivisor)
    (hne : imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S 1 ≠ ⊥)
    (hgen : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
      (H.restrictPrimeDivisor S).coeff Q ≠ 0 → ∀ n : ℕ, 0 < n → ∃ j : ℕ, 0 < j ∧ ∃ k : ℤ,
        (n : ℤ) * k < j ∧ ∃ h ∈ imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S j,
          h ≠ 0 ∧ WithZero.exp ((j : ℤ) *
            (((q : ℤ) • K + ((q : ℚ) • Δ).roundDown).restrictPrimeDivisor S).coeff Q - k) ≤
              Q.divisorialValuation h) :
    HasRestrictedLiftingProperty (S.idealSheaf.subschemeι ≫ sX) sT g f d
      ((K + Finsupp.single S 1).restrictPrimeDivisor S) ((A + B).restrictPrimeDivisor S) q
      (imageVeronese π ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S g f hfg q) := by
  haveI : IsProper π := isProper_of_isProjectiveMorphism _ hπp
  haveI : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap ℂ A₀))) := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  haveI : IsNoetherianRing A₀ := Algebra.FiniteType.isNoetherianRing ℂ A₀
  have hXn : IsNormalVariety ℂ sX := by
    subst hπ
    exact ⟨(isVariety_iff ℂ _).mpr ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩,
      inferInstance⟩
  have hSn : IsNormalVariety ℂ (S.idealSheaf.subschemeι ≫ sX) := by
    subst hπ
    exact ⟨(isVariety_iff ℂ _).mpr ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩,
      inferInstance⟩
  have hA0 := coeff_nonneg_of_eq_inv_smul hH hA
  have hABS := coeff_add_eq_zero_of_isPltPair hd hA0 hB hΔ hplt
  have ⟨D', hD', _⟩ := hqΔ
  refine ⟨⟨inferInstance, hgf, hg, hT, hTa, hSn, hSsm,
    isCanonicalDivisor_restrictPrimeDivisor_add_single hXn hsm hK S hKS,
    by rw [← hg, ← Category.assoc, hfg, Category.assoc, hπ], hfp, hfb,
    isKltPair_restrictPrimeDivisor hXn hsm hK S hKS hSn hSsm hA0 hB hΔ hABS hplt hq hqΔ, hq,
    isCartierDivisor_zsmul_restrictPrimeDivisor hSsm hΔ hABS hqΔ, ?_,
    fun _ hm => veroneseSeries_eq_bot hm,
    fg_imageVeronese hsm π _ S (coeff_qDivisor_eq_zero hΔ hKS hABS hD') g f hfg hq,
    one_mem_veroneseSeries
      (AddSubgroup.subset_closure ⟨1, fun P => by simp, 1, map_one _, map_one _⟩),
    mul_mem_veroneseSeries (fun hx hy => mul_mem_imageSeries_add _ S hx hy),
    veroneseSeries_ne_bot hq hne⟩,
    exists_forall_mem_of_isPltPair_add d hd X sX π hπ hπp hsm K hK S hKS hSsm H a A B Δ
      hH hHa ha hA hB hΔ hfloor hplt hplt' hcan g f q hq hqΔ hne hgen _
      fun _ _ => mem_veroneseSeries⟩
  rintro _ ⟨j, rfl⟩ s hs
  exact mem_divisorialSections_of_mem_imageSeries hsm S hSsm hΔ hKS hABS hD' j
    ((mem_veroneseSeries_mul hq j).mp hs)

/-- **Finite generation of a prepared restricted adjoint algebra.** Let `d ≥ 2` and assume the
birational finite-generation property `F(d)`. Let `A₀` be a finitely generated normal complex
domain, `π : X ⟶ Spec A₀` projective with `X` smooth of dimension `d + 1` and canonical divisor
`K` with coefficient `-1` along the smooth prime divisor `S`. Let `Δ = S + A + B` with
`⌊Δ⌋ = S`, `B ≥ 0` and `A = H/a`, `a ≥ 3`, `H ≥ 0` `π`-ample, be such that `(X, Δ)` and
`(X, Δ + A)` are plt, `(S, (2A + B)|_S) = (S, Ω + A|_S)` is canonical, and no component of
`H|_S` lies in the asymptotic restricted fixed divisor of `K + Δ`. Let `f : S ⟶ T` be projective
and birational onto a normal affine complex variety `T`, finite over `Spec A₀` compatibly with
`π`. If `q > 0`, `qΔ` is integral and some section of `𝒪_X(q(K + Δ))` restricts to a nonzero
section on `S`, then the algebra of restrictions
`⊕_{j ≥ 0} im(H⁰(X, 𝒪_X(jq(K + Δ))) → k(S)) tʲ ⊆ k(S)[t]` is generated, as an algebra over
`A₀`, by finitely many elements. -/
@[mmp "thm_fourfold_prepared_restricted_algebra_fg"]
public theorem restrictedImageAlgebra_fg_of_birationalFiniteGenerationProperty
    (d : ℕ) (hd : 2 ≤ d) (hFd : BirationalFiniteGenerationProperty d)
    {A₀ : Type} [CommRing A₀] [IsDomain A₀] [Algebra ℂ A₀] [Algebra.FiniteType ℂ A₀]
    [IsIntegrallyClosed A₀]
    (X : Scheme.{0}) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (sX : X ⟶ Spec (.of ℂ)) (π : X ⟶ Spec (.of A₀))
    (hπ : π ≫ Spec.map (CommRingCat.ofHom (algebraMap ℂ A₀)) = sX)
    (hπp : IsProjectiveMorphism π) (hsm : IsSmoothScheme sX)
    (K : Divisor X) (hK : K.IsCanonicalDivisor sX (d + 1))
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hKS : K.coeff S = -1) (hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (H : Divisor X) (a : ℕ) (A B Δ : QDivisor X)
    (hH : 0 ≤ H) (hHa : MMP.Flips.IsRelativelyAmpleCartier π H) (ha : 3 ≤ a)
    (hA : A = (a : ℚ)⁻¹ • Divisor.toQDivisor H) (hB : 0 ≤ B)
    (hΔ : Δ = Divisor.toQDivisor (Finsupp.single S 1) + A + B)
    (hfloor : Δ.roundDown = Finsupp.single S 1)
    (hplt : IsPltPair sX (d + 1) K Δ) (hplt' : IsPltPair sX (d + 1) K (Δ + A))
    (hcan : ∃ KS : Divisor S.idealSheaf.subscheme,
      IsCanonicalPair (S.idealSheaf.subschemeι ≫ sX) d KS ((2 • A + B).restrictPrimeDivisor S))
    (T : Scheme.{0}) (sT : T ⟶ Spec (.of ℂ)) (g : T ⟶ Spec (.of A₀))
    (f : S.idealSheaf.subscheme ⟶ T)
    (hg : g ≫ Spec.map (CommRingCat.ofHom (algebraMap ℂ A₀)) = sT) (hgf : IsFinite g)
    (hT : IsNormalVariety ℂ sT) (hTa : IsAffine T) (hfg : f ≫ g = S.idealSheaf.subschemeι ≫ π)
    (hfp : IsProjectiveMorphism f) (hfb : IsBirationalMorphism f)
    (q : ℕ) (hq : 0 < q) (hqΔ : ((q : ℚ) • Δ).IsCartierDivisor)
    (hne : imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S 1 ≠ ⊥)
    (hgen : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
      (H.restrictPrimeDivisor S).coeff Q ≠ 0 → ∀ n : ℕ, 0 < n → ∃ j : ℕ, 0 < j ∧ ∃ k : ℤ,
        (n : ℤ) * k < j ∧ ∃ h ∈ imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S j,
          h ≠ 0 ∧ WithZero.exp ((j : ℤ) *
            (((q : ℤ) • K + ((q : ℚ) • Δ).roundDown).restrictPrimeDivisor S).coeff Q - k) ≤
              Q.divisorialValuation h) :
    ∃ G : Finset (S.idealSheaf.subscheme.functionField)[X],
      {p : (S.idealSheaf.subscheme.functionField)[X] |
          ∀ j : ℕ, p.coeff j ∈ imageSeries ((q : ℤ) • K + ((q : ℚ) • Δ).roundDown) S j} =
        (Subring.closure (Set.range (C.comp
          ((S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint _) trivial).hom.comp
            ((S.idealSheaf.subschemeι ≫ π).appTop.hom.comp
              (Scheme.ΓSpecIso (.of A₀)).inv.hom))) ∪ ↑G) : Set _) := by
  haveI : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  obtain ⟨-, -, -, G', hG'⟩ :=
    exists_qDivisor_eq_restrictedClippedBoundary_of_hasRestrictedLiftingProperty hFd
      (hasRestrictedLiftingProperty_imageVeronese d hd X sX π hπ hπp hsm K hK S hKS hSsm H a A B
        Δ hH hHa ha hA hB hΔ hfloor hplt hplt' hcan T sT g f hg hgf hT hTa hfg hfp hfb q hq hqΔ
        hne hgen)
  obtain ⟨G, hG⟩ := exists_finset_eq_closure_of_expand _ hq G' hG'
  refine ⟨G, hG.trans ?_⟩
  rw [← hfg]
  refine congrArg (fun φ : A₀ →+* S.idealSheaf.subscheme.functionField =>
    SetLike.coe (Subring.closure (Set.range (C.comp φ) ∪ ↑G)))
    (RingHom.ext fun a => ?_)
  exact rationalFunctionsEquivFunctionField_restrictedSeriesBaseMap g f a

end MMP.Fourfold

end
