/-!
# Property `F(d)` gives projective pl-flips in dimension `d + 1`

Let `f : X ⟶ Z` be a small projective contraction of an extremal ray of a `ℚ`-factorial
projective complex variety of dimension `d + 1`, and `(X, S + B)` a plt pair with `⌊S + B⌋ = S`
prime such that `-(K_X + S + B)` and `-S` are `f`-ample. Assuming `F(d)`, the
`(K_X + S + B)`-flip of `f` exists.

By the finite generation criterion for flips it suffices that, for `r(K_X + S + B)` integral,
the divisorial algebra `R(Z, f_*(r(K_X + S + B)))` is finitely generated over an affine
neighbourhood of every point of `Z`. Writing `a(K_X + S + B) ∼_ℚ bS + f^*M`, one works over an
affine open `U ⊆ Z` on which `M` is principal. There `a(K_X + S + B) ∼_ℚ bS`, and the mobile
representative `S' ∼ S` not containing `S` turns the adjoint algebra into a Veronese
subalgebra of `R(f⁻¹U, S')`, up to multiplication by a principal function. With the boundary
`S + B + A`, `A = cS' - (K_X + S + B)` for a small `c > 0`, which is `ℚ`-linearly equivalent
to the `f`-ample divisor `-(b/a - c)S`, the restricted algebra of `R(f⁻¹U, S')` along `S` is
finitely generated by `F(d)`, and so is `R(f⁻¹U, S')` itself, since `S' ∼ S` and `S` is normal.

## References

* [C. Hacon, J. McKernan, *Extension theorems and the existence of flips*][HaconMcKernan2007]
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP.Mori Opposite

namespace MMP.Fourfold.PlFlip

/-! ### Finite generation of subrings of polynomial rings -/

section FiniteGeneration

open Polynomial

/-- `RingHom.FiniteType` as generation of the target by the image and a finite set. -/
private theorem finiteType_iff_exists_closure {A R : Type*} [CommRing A] [CommRing R]
    (α : A →+* R) :
    α.FiniteType ↔ ∃ s : Finset R, Subring.closure (Set.range α ∪ ↑s) = ⊤ := by
  letI := α.toAlgebra
  have hα : Set.range (algebraMap A R) = Set.range α := rfl
  constructor
  · rintro ⟨⟨s, hs⟩⟩
    refine ⟨s, ?_⟩
    rw [← hα, ← Algebra.adjoin_eq_ring_closure, hs]
    rfl
  · rintro ⟨s, hs⟩
    refine ⟨⟨s, Subalgebra.toSubring_injective ?_⟩⟩
    rw [Algebra.adjoin_eq_ring_closure, hα, hs]
    rfl

/-- A subring `T` of a ring `L` is generated by a set `C₀` and finitely many of its elements. -/
private def IsFGOver {L : Type*} [CommRing L] (T : Subring L) (C₀ : Set L) : Prop :=
  ∃ G : Finset L, (↑G : Set L) ⊆ T ∧ T ≤ Subring.closure (C₀ ∪ ↑G)

/-- Finite generation of a ring map into a subring, through `IsFGOver`. -/
private theorem finiteType_codRestrict_iff {A L : Type*} [CommRing A] [CommRing L]
    (α : A →+* L) (T : Subring L) (hα : ∀ a, α a ∈ T) :
    (α.codRestrict T hα).FiniteType ↔ IsFGOver T (Set.range α) := by
  classical
  rw [finiteType_iff_exists_closure]
  have himage : ∀ s : Finset T, (T.subtype : T → L) '' (Set.range (α.codRestrict T hα) ∪ ↑s) =
      Set.range α ∪ ↑(s.image Subtype.val) := by
    intro s
    rw [Set.image_union, Finset.coe_image]
    congr 1
    rw [← Set.range_comp]
    rfl
  constructor
  · rintro ⟨s, hs⟩
    refine ⟨s.image Subtype.val, ?_, fun x hx => ?_⟩
    · intro y hy
      rw [Finset.coe_image] at hy
      obtain ⟨z, -, rfl⟩ := hy
      exact z.2
    · have hx' : (⟨x, hx⟩ : T) ∈ Subring.closure (Set.range (α.codRestrict T hα) ∪ ↑s) :=
        hs ▸ Subring.mem_top _
      have : x ∈ (Subring.closure (Set.range (α.codRestrict T hα) ∪ ↑s)).map T.subtype :=
        Subring.mem_map.mpr ⟨⟨x, hx⟩, hx', rfl⟩
      rwa [RingHom.map_closure, himage] at this
  · rintro ⟨G, hGT, hT⟩
    let s : Finset T := G.subtype (· ∈ T)
    have hs : s.image Subtype.val = G := by
      ext y
      simp only [s, Finset.mem_image, Finset.mem_subtype, Subtype.exists, exists_and_right,
        exists_eq_right]
      exact ⟨fun ⟨_, h⟩ => h, fun h => ⟨hGT h, h⟩⟩
    refine ⟨s, eq_top_iff.mpr fun x _ => ?_⟩
    have hx := hT x.2
    rw [← hs, ← himage, ← RingHom.map_closure] at hx
    obtain ⟨y, hy, hyx⟩ := Subring.mem_map.mp hx
    rwa [show y = x from Subtype.ext hyx] at hy

/-- Finite generation is carried along a ring map which maps `T` onto `T'` and `C₀` into
`C₀'`. -/
private theorem IsFGOver.of_map {L L' : Type*} [CommRing L] [CommRing L'] (σ : L →+* L')
    {T : Subring L} {T' : Subring L'} {C₀ : Set L} {C₀' : Set L'} (h : IsFGOver T C₀)
    (hσT : ∀ x ∈ T, σ x ∈ T') (hT : (T' : Set L') ⊆ σ '' T) (hC : σ '' C₀ ⊆ C₀') :
    IsFGOver T' C₀' := by
  classical
  obtain ⟨G, hG, hTG⟩ := h
  refine ⟨G.image σ, ?_, fun y hy => ?_⟩
  · intro y hy
    rw [Finset.coe_image] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact hσT x (hG hx)
  · obtain ⟨x, hx, rfl⟩ := hT hy
    have : σ x ∈ (Subring.closure (C₀ ∪ ↑G)).map σ := Subring.mem_map.mpr ⟨x, hTG hx, rfl⟩
    rw [RingHom.map_closure, Set.image_union] at this
    refine Subring.closure_mono (Set.union_subset_union hC ?_) this
    rw [Finset.coe_image]

end FiniteGeneration

/-! ### Section algebras: principal shifts and the trivial divisor -/

section SectionAlgebra

open Polynomial

variable {Y : Scheme.{0}} [IsLocallyNoetherian Y] [IsNormal Y]

/-- Multiplication by `ψ` maps `H⁰(Y, 𝒪(B))` to `H⁰(Y, 𝒪(B'))` when `B = B' + div ψ`. -/
private theorem mul_mem_divisorialSections_of_coeff_eq {B B' : Divisor Y}
    (ψ : (RationalFunctions Y)ˣ) (h : ∀ E, B.coeff E = B'.coeff E + E.ord ψ)
    {g : RationalFunctions Y} (hg : g ∈ divisorialSections B) :
    (ψ : RationalFunctions Y) * g ∈ divisorialSections B' :=
  (Divisor.divisorialMulLinearMap ψ h ⊤ ⟨_, hg⟩).2

/-- The section algebras of `B` and of `B' = B - div ψ` correspond under `t ↦ ψ t`. -/
private theorem isFGOver_weilSectionAlgebra_of_coeff_eq {B B' : Divisor Y}
    (ψ : (RationalFunctions Y)ˣ) (h : ∀ E, B.coeff E = B'.coeff E + E.ord ψ)
    (R₀ : Set (RationalFunctions Y))
    (hB : IsFGOver (weilSectionAlgebra B) (C '' R₀)) :
    IsFGOver (weilSectionAlgebra B') (C '' R₀) := by
  set a : RationalFunctions Y := (ψ : RationalFunctions Y)
  set a' : RationalFunctions Y := ((ψ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y)
  have haa' : a' * a = 1 := by simp [a, a']
  have hm : ∀ m : ℕ, ∀ E, (m • B).coeff E = (m • B').coeff E + E.ord (ψ ^ m) := by
    intro m E
    rw [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul, h E,
      PrimeDivisor.ord_pow, smul_add]
  have hm' : ∀ m : ℕ, ∀ E, (m • B').coeff E = (m • B).coeff E + E.ord ((ψ⁻¹) ^ m) := by
    intro m E
    rw [hm m E, PrimeDivisor.ord_pow, PrimeDivisor.ord_pow, PrimeDivisor.ord_inv]
    simp
  refine hB.of_map (compRingHom (C a * Polynomial.X)) (fun p hp m => ?_) (fun q hq => ?_) ?_
  · change (p.comp (C a * Polynomial.X)).coeff m ∈ _
    rw [comp_C_mul_X_coeff, mul_comm]
    simpa [a] using mul_mem_divisorialSections_of_coeff_eq (ψ ^ m) (hm m) (hp m)
  · refine ⟨q.comp (C a' * Polynomial.X), fun m => ?_, ?_⟩
    · rw [comp_C_mul_X_coeff, mul_comm]
      simpa [a'] using mul_mem_divisorialSections_of_coeff_eq (ψ⁻¹ ^ m) (hm' m) (hq m)
    · refine Polynomial.ext fun m => ?_
      change ((q.comp (C a' * Polynomial.X)).comp (C a * Polynomial.X)).coeff m = q.coeff m
      rw [comp_C_mul_X_coeff, comp_C_mul_X_coeff, mul_assoc, ← mul_pow, haa', one_pow,
        mul_one]
  · rintro _ ⟨_, ⟨c, hc, rfl⟩, rfl⟩
    exact ⟨c, hc, by simp⟩

/-- The section algebra of the zero divisor is `H⁰(Y, 𝒪_Y)[t]`: it is generated over the
constants by `t`. -/
private theorem isFGOver_weilSectionAlgebra_zero :
    IsFGOver (weilSectionAlgebra (0 : Divisor Y))
      (C '' Set.range (globalSectionsToRationalFunctions (X := Y))) := by
  classical
  refine ⟨{Polynomial.X}, ?_, fun p hp => ?_⟩
  · intro x hx
    rw [Finset.coe_singleton, Set.mem_singleton_iff] at hx
    subst hx
    intro m
    rw [coeff_X]
    split_ifs
    · exact one_mem_divisorialSections (by simp)
    · exact zero_mem _
  · have hmem : ∀ n : ℕ, C (p.coeff n) * Polynomial.X ^ n ∈ Subring.closure
        (C '' Set.range (globalSectionsToRationalFunctions (X := Y)) ∪
          ↑({Polynomial.X} : Finset (RationalFunctions Y)[X])) := by
      intro n
      refine Subring.mul_mem _ ?_ (Subring.pow_mem _ ?_ n)
      · have := hp n
        rw [smul_zero, mem_divisorialSections_zero_iff] at this
        exact Subring.subset_closure (Or.inl ⟨_, this, rfl⟩)
      · exact Subring.subset_closure (Or.inr (by simp))
    rw [p.as_sum_support_C_mul_X_pow]
    exact Subring.sum_mem _ fun n _ => hmem n

end SectionAlgebra

/-! ### Local equations -/

section LocalEquation

/-- The inclusion of a nonempty open of an integral scheme is dominant. -/
private theorem isDominant_ι_of_nonempty {X : Scheme.{0}} [IsIntegral X] (V : X.Opens)
    [Nonempty V] : IsDominant V.ι :=
  Opens.isDominant_ι (V.isOpen.dense (by
    obtain ⟨x⟩ := ‹Nonempty V›
    exact ⟨x.1, x.2⟩))

/-- A unit of `K(X)` restricts to a unit of `K(V)` with the same orders along the prime divisors
of `V`. -/
private theorem exists_ord_eq_restrict {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (V : X.Opens) [Nonempty V] (φ : (RationalFunctions X)ˣ) :
    ∃ φ' : (RationalFunctions V.toScheme)ˣ, ∀ W : MMP.Mori.PrimeDivisor V.toScheme,
      W.ord φ' = MMP.Mori.PrimeDivisor.ord (OpenWeilRestriction.primeDivisorMap V.ι W) φ := by
  haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
  obtain ⟨g, hg, hφg⟩ := MMP.Positivity.exists_ord_eq_of_units φ
  obtain ⟨φ', hφ'⟩ := MMP.Positivity.exists_units_of_ne_zero
    ((map_ne_zero (functionFieldMap V.ι)).2 hg)
  refine ⟨φ', fun W => ?_⟩
  rw [hφ', hφg, MMP.Positivity.ord_functionFieldMap_of_isIso V.ι W _
    (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm]

/-- The pull-back of a Cartier divisor `M` with local equation `ψ` on `U` has a local
equation on `f⁻¹(U)`. -/
private theorem exists_isLocalEquation_pullback {X Y : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y)
    {M : Divisor Y} (hM : M.IsCartier)
    (hMf : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ M.supp)
    {U : Y.Opens} {ψ : (RationalFunctions Y)ˣ} (hψ : M.IsLocalEquation U ψ)
    (hU : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∈ U) :
    ∃ χ : (RationalFunctions X)ˣ, (M.pullback hM hMf).IsLocalEquation (f ⁻¹ᵁ U) χ := by
  refine ⟨(RationalFunctions.unitsEquiv X).symm fun Z => pullbackComponent f hMf hψ Z (hU Z),
    fun E hE => ?_⟩
  rw [Divisor.isPullback_pullback hM hMf U ψ hψ E hE, PrimeDivisor.ord_eq_ordUnit]
  rfl

/-- The coefficients of `a(K + Δ) ∼_ℚ bS + P`, `P` with a local equation `χ` on `V`, on the
prime divisors meeting `V`, for an integral multiple `rΔ = D_r`. -/
private theorem coeff_nsmul_eq_of_qLinearlyEquivalent {X : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {K P Dr : Divisor X} {Δ : QDivisor X}
    {S : MMP.Mori.PrimeDivisor X}
    {a b m r : ℕ} {φ : (RationalFunctions X)ˣ}
    (hφ : (m : ℤ) • ((a : ℤ) • (Divisor.toQDivisor K + Δ) -
      ((b : ℤ) • Divisor.toQDivisor (Finsupp.single S 1) + Divisor.toQDivisor P)) =
        Divisor.toQDivisor (MMP.Mori.principalDivisor φ))
    (hDr : Divisor.toQDivisor Dr = (r : ℚ) • Δ) {V : X.Opens} {χ : (RationalFunctions X)ˣ}
    (hχ : P.IsLocalEquation V χ) (W : MMP.Mori.PrimeDivisor X) (hW : (W.support ∩ V).Nonempty) :
    DivisorWithCoeffs.coeff ((m * a) • (r • K + Dr)) W =
      DivisorWithCoeffs.coeff ((r * m * b) • (Finsupp.single S 1 : Divisor X)) W +
        W.ord (φ ^ r * χ ^ (r * m)) := by
  have h1 := congrArg (fun D : QDivisor X => D.coeff W) hφ
  have h2 := congrArg (fun D : QDivisor X => D.coeff W) hDr
  have h3 := hχ W hW
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub,
    DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, coeff_principalDivisor,
    smul_eq_mul, zsmul_eq_mul] at h1 h2
  rw [h3] at h1
  rw [PrimeDivisor.ord_mul, PrimeDivisor.ord_pow, PrimeDivisor.ord_pow]
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, nsmul_eq_mul,
    smul_eq_mul]
  have key : ((m * a : ℕ) : ℚ) * ((r : ℚ) * (K.coeff W : ℚ) + (Dr.coeff W : ℚ)) =
      ((r * m * b : ℕ) : ℚ) *
          ((DivisorWithCoeffs.coeff (Finsupp.single S 1 : Divisor X) W : ℤ) : ℚ) +
        ((r : ℚ) * (W.ord φ : ℚ) + ((r * m : ℕ) : ℚ) * (W.ord χ : ℚ)) := by
    push_cast
    linear_combination (r : ℚ) * h1 + ((m : ℚ) * a) * h2
  exact_mod_cast key

end LocalEquation

/-! ### Subrings of polynomials with prescribed coefficients -/

section CoeffRing

open Polynomial

variable {L : Type*} [CommRing L]

/-- The subring `⊕_m W_m tᵐ ⊆ L[t]` of the polynomials whose coefficient of `tᵐ` lies in `W_m`,
for additive subgroups `W_m ⊆ L` with `1 ∈ W_0` and `W_i W_j ⊆ W_{i+j}`. -/
private def coeffRing (W : ℕ → AddSubgroup L) (h1 : (1 : L) ∈ W 0)
    (hmul : ∀ i j, ∀ x ∈ W i, ∀ y ∈ W j, x * y ∈ W (i + j)) : Subring L[X] where
  carrier := {p | ∀ m, p.coeff m ∈ W m}
  zero_mem' m := by simp
  one_mem' m := by
    rw [coeff_one]
    split_ifs with h
    · exact h ▸ h1
    · exact zero_mem _
  add_mem' hp hq m := by simpa using add_mem (hp m) (hq m)
  neg_mem' hp m := by simpa using neg_mem (hp m)
  mul_mem' {p q} hp hq m := by
    rw [coeff_mul]
    refine sum_mem fun x hx => ?_
    have := hmul _ _ _ (hp x.1) _ (hq x.2)
    rwa [Finset.HasAntidiagonal.mem_antidiagonal.mp hx] at this

private theorem mem_coeffRing {W : ℕ → AddSubgroup L} {h1 : (1 : L) ∈ W 0}
    {hmul : ∀ i j, ∀ x ∈ W i, ∀ y ∈ W j, x * y ∈ W (i + j)} {p : L[X]} :
    p ∈ coeffRing W h1 hmul ↔ ∀ m, p.coeff m ∈ W m := Iff.rfl

/-- A subalgebra is finitely generated exactly when, as a subring, it is generated by the image
of the base and finitely many of its elements. -/
private theorem isFGOver_toSubring_iff {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (S : Subalgebra R A) : IsFGOver S.toSubring (Set.range (algebraMap R A)) ↔ S.FG := by
  constructor
  · rintro ⟨G, hG, hle⟩
    refine ⟨G, le_antisymm (Algebra.adjoin_le hG) fun x hx => ?_⟩
    have := hle hx
    rwa [← Algebra.adjoin_eq_ring_closure, Subalgebra.mem_toSubring] at this
  · rintro ⟨G, hG⟩
    refine ⟨G, hG ▸ Algebra.subset_adjoin, fun x hx => ?_⟩
    rwa [← Algebra.adjoin_eq_ring_closure, hG]

variable (W : ℕ → AddSubgroup L) (h1 : (1 : L) ∈ W 0)
    (hmul : ∀ i j, ∀ x ∈ W i, ∀ y ∈ W j, x * y ∈ W (i + j)) (R₀ : Subring L)
    (hR₀ : ∀ x, x ∈ W 0 ↔ x ∈ R₀)

/-- `coeffRing W` as an `R₀`-subalgebra of `L[t]`, for `R₀ = W_0`. -/
private def coeffSubalgebra : Subalgebra R₀ L[X] :=
  { coeffRing W h1 hmul with
    algebraMap_mem' r m := by
      change (C (r : L)).coeff m ∈ W m
      rw [coeff_C]
      split_ifs with h
      · subst h; exact (hR₀ _).2 r.2
      · exact zero_mem _ }

private theorem isFGOver_coeffRing_iff_fg :
    IsFGOver (coeffRing W h1 hmul) (C '' R₀) ↔ (coeffSubalgebra W h1 hmul R₀ hR₀).FG := by
  have hC : C '' (R₀ : Set L) = Set.range (algebraMap R₀ L[X]) := by
    rw [show (algebraMap R₀ L[X] : R₀ → L[X]) = C ∘ Subtype.val from rfl, Set.range_comp,
      Subtype.range_coe]
  rw [hC]
  exact isFGOver_toSubring_iff (coeffSubalgebra W h1 hmul R₀ hR₀)

/-- The degree-`m` piece `W_m tᵐ` of `coeffSubalgebra W`. -/
private def coeffGrade (m : ℕ) : Submodule R₀ (coeffSubalgebra W h1 hmul R₀ hR₀) where
  carrier := {p | ∀ i, i ≠ m → (p : L[X]).coeff i = 0}
  add_mem' hp hq i hi := by simp [hp i hi, hq i hi]
  zero_mem' i _ := by simp
  smul_mem' a p hp i hi := by
    change ((a • p : coeffSubalgebra W h1 hmul R₀ hR₀) : L[X]).coeff i = 0
    rw [Subalgebra.coe_smul, coeff_smul, hp i hi, smul_zero]

private theorem coe_eq_monomial_of_mem_coeffGrade {m : ℕ} {p : coeffSubalgebra W h1 hmul R₀ hR₀}
    (hp : p ∈ coeffGrade W h1 hmul R₀ hR₀ m) :
    (p : L[X]) = monomial m ((p : L[X]).coeff m) := by
  ext i
  rw [coeff_monomial]
  split_ifs with h
  · rw [h]
  · exact hp i (Ne.symm h)

private theorem gradedMonoid_coeffGrade : SetLike.GradedMonoid (coeffGrade W h1 hmul R₀ hR₀) where
  one_mem i hi := by
    change (1 : L[X]).coeff i = 0
    rw [coeff_one, if_neg hi]
  mul_mem {m n} p q hp hq i hi := by
    change ((p : L[X]) * q).coeff i = 0
    rw [coe_eq_monomial_of_mem_coeffGrade W h1 hmul R₀ hR₀ hp,
      coe_eq_monomial_of_mem_coeffGrade W h1 hmul R₀ hR₀ hq, monomial_mul_monomial,
      coeff_monomial, if_neg (Ne.symm hi)]

private theorem coeff_coeLinearMap_coeffGrade
    (x : DirectSum ℕ fun m => coeffGrade W h1 hmul R₀ hR₀ m) (i : ℕ) :
    ((DirectSum.coeLinearMap (coeffGrade W h1 hmul R₀ hR₀) x : coeffSubalgebra W h1 hmul R₀ hR₀) :
      L[X]).coeff i = ((x i : coeffSubalgebra W h1 hmul R₀ hR₀) : L[X]).coeff i := by
  classical
  induction x using DirectSum.induction_on with
  | zero => simp
  | of j y =>
    rw [DirectSum.coeLinearMap_of, DirectSum.of_apply]
    split_ifs with h
    · subst h; rfl
    · simpa using y.2 i (Ne.symm h)
  | add x y hx hy => simp [map_add, Polynomial.coeff_add, hx, hy]

private theorem isInternal_coeffGrade : DirectSum.IsInternal (coeffGrade W h1 hmul R₀ hR₀) := by
  classical
  constructor
  · intro x y hxy
    change DirectSum.coeLinearMap _ x = DirectSum.coeLinearMap _ y at hxy
    ext m i
    have hx := coeff_coeLinearMap_coeffGrade W h1 hmul R₀ hR₀ x m
    have hy := coeff_coeLinearMap_coeffGrade W h1 hmul R₀ hR₀ y m
    rw [coe_eq_monomial_of_mem_coeffGrade W h1 hmul R₀ hR₀ (x m).2,
      coe_eq_monomial_of_mem_coeffGrade W h1 hmul R₀ hR₀ (y m).2, coeff_monomial,
      coeff_monomial, ← hx, ← hy, hxy]
  · intro p
    refine ⟨∑ m ∈ (p : L[X]).support, DirectSum.of (fun m => coeffGrade W h1 hmul R₀ hR₀ m) m
      ⟨⟨monomial m ((p : L[X]).coeff m), fun i => by
        rw [coeff_monomial]
        split_ifs with h
        · exact h ▸ p.2 m
        · exact zero_mem _⟩,
        fun i hi => by simp [coeff_monomial, Ne.symm hi]⟩, ?_⟩
    apply Subtype.ext
    rw [map_sum]
    simp only [DirectSum.coeAddMonoidHom_of]
    rw [AddSubmonoidClass.coe_finsetSum]
    exact (as_sum_support _).symm

/-- The grading of `coeffSubalgebra W` by the degree in `t`. -/
private noncomputable abbrev coeffGradedAlgebra : GradedAlgebra (coeffGrade W h1 hmul R₀ hR₀) :=
  { gradedMonoid_coeffGrade W h1 hmul R₀ hR₀,
    (isInternal_coeffGrade W h1 hmul R₀ hR₀).chooseDecomposition with }

private theorem coe_decompose_coeffGrade (p : coeffSubalgebra W h1 hmul R₀ hR₀) (n : ℕ) :
    letI := coeffGradedAlgebra W h1 hmul R₀ hR₀
    ((DirectSum.decompose (coeffGrade W h1 hmul R₀ hR₀) p n :
      coeffSubalgebra W h1 hmul R₀ hR₀) : L[X]) = monomial n ((p : L[X]).coeff n) := by
  letI := coeffGradedAlgebra W h1 hmul R₀ hR₀
  rw [coe_eq_monomial_of_mem_coeffGrade W h1 hmul R₀ hR₀ (DirectSum.decompose _ p n).2,
    ← coeff_coeLinearMap_coeffGrade W h1 hmul R₀ hR₀]
  congr 3
  classical
  rw [DirectSum.coeLinearMap_eq_dfinsuppSum]
  exact congrArg _ (DirectSum.sum_support_decompose (coeffGrade W h1 hmul R₀ hR₀) p)

/-- The `N`-th Veronese subalgebra of `⊕_m W_m tᵐ` is the image of `⊕_m W_{Nm} tᵐ` under
`t ↦ t^N`. -/
private theorem map_veroneseSubalgebra_coeffGrade {N : ℕ} (hN : 0 < N)
    (hR₀' : ∀ x, x ∈ W (N * 0) ↔ x ∈ R₀) :
    letI := coeffGradedAlgebra W h1 hmul R₀ hR₀
    (MMP.Fourfold.veroneseSubalgebra (coeffGrade W h1 hmul R₀ hR₀) N).map
        (coeffSubalgebra W h1 hmul R₀ hR₀).val =
      (coeffSubalgebra (fun m => W (N * m)) (by simpa using h1)
        (fun i j x hx y hy => by simpa [mul_add] using hmul _ _ x hx y hy) R₀ hR₀').map
          ((expand L N).restrictScalars R₀) := by
  letI := coeffGradedAlgebra W h1 hmul R₀ hR₀
  have hmem : ∀ p : coeffSubalgebra W h1 hmul R₀ hR₀,
      p ∈ MMP.Fourfold.veroneseSubalgebra (coeffGrade W h1 hmul R₀ hR₀) N ↔
        ∀ n, ¬ N ∣ n → (p : L[X]).coeff n = 0 := fun p => by
    rw [MMP.Fourfold.mem_veroneseSubalgebra_iff]
    refine forall_congr' fun n => imp_congr_right fun _ => ?_
    rw [← Subtype.coe_inj, coe_decompose_coeffGrade, ZeroMemClass.coe_zero]
    exact monomial_eq_zero_iff _ _
  ext p
  simp only [Subalgebra.mem_map, Subalgebra.coe_val, AlgHom.coe_restrictScalars']
  constructor
  · rintro ⟨p, hp, rfl⟩
    rw [hmem] at hp
    refine ⟨contract N (p : L[X]), fun m => ?_, ?_⟩
    · rw [coeff_contract hN.ne', mul_comm]
      exact p.2 _
    · ext n
      rw [coeff_expand hN]
      split_ifs with h
      · rw [coeff_contract hN.ne', Nat.div_mul_cancel h]
      · exact (hp n h).symm
  · rintro ⟨q, hq, rfl⟩
    refine ⟨⟨expand L N q, fun n => ?_⟩, (hmem _).mpr fun n hn => ?_, rfl⟩
    · rw [coeff_expand hN]
      split_ifs with h
      · have : q.coeff (n / N) ∈ W (N * (n / N)) := hq (n / N)
        rwa [Nat.mul_div_cancel' h] at this
      · exact zero_mem _
    · change (expand L N q).coeff n = 0
      rw [coeff_expand hN, if_neg hn]

include hR₀ in
/-- **Veronese.** Over a Noetherian degree-zero ring `R₀ = W_0`, the ring `⊕_m W_m tᵐ` is
finitely generated if and only if `⊕_m W_{Nm} tᵐ` is, for `N ≥ 1`. -/
private theorem isFGOver_coeffRing_iff [IsDomain L] [IsNoetherianRing R₀] {N : ℕ} (hN : 0 < N) :
    IsFGOver (coeffRing W h1 hmul) (C '' R₀) ↔
      IsFGOver (coeffRing (fun m => W (N * m)) (by simpa using h1)
        (fun i j x hx y hy => by simpa [mul_add] using hmul _ _ x hx y hy)) (C '' R₀) := by
  letI := coeffGradedAlgebra W h1 hmul R₀ hR₀
  have hR₀' : ∀ x, x ∈ W (N * 0) ↔ x ∈ R₀ := by simpa using hR₀
  rw [isFGOver_coeffRing_iff_fg W h1 hmul R₀ hR₀,
    isFGOver_coeffRing_iff_fg (fun m => W (N * m)) _ _ R₀ hR₀', Subalgebra.fg_iff_finiteType,
    MMP.Fourfold.finiteType_iff_veroneseSubalgebra_fg (coeffGrade W h1 hmul R₀ hR₀) hN]
  constructor
  · intro h
    refine Subalgebra.fg_of_fg_map _ ((expand L N).restrictScalars R₀)
      (expand_injective hN) ?_
    rw [← map_veroneseSubalgebra_coeffGrade W h1 hmul R₀ hR₀ hN hR₀']
    exact h.map _
  · intro h
    refine Subalgebra.fg_of_fg_map _ (coeffSubalgebra W h1 hmul R₀ hR₀).val
      Subtype.val_injective ?_
    rw [map_veroneseSubalgebra_coeffGrade W h1 hmul R₀ hR₀ hN hR₀']
    exact h.map _

end CoeffRing

/-! ### Veronese subalgebras of section algebras -/

section Veronese

open Polynomial

/-- The constants `H⁰(Y, 𝒪_Y) ⊆ K(Y)[t]` of the section algebras. -/
private abbrev weilConstants (Y : Scheme.{0}) [IsLocallyNoetherian Y] [IsNormal Y] :
    Set (RationalFunctions Y)[X] :=
  C '' Set.range (globalSectionsToRationalFunctions (X := Y))

variable {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

private theorem globalSections_mem_divisorialSections_zero_nsmul (D : Divisor Y) (s : Γ(Y, ⊤)) :
    globalSectionsToRationalFunctions s ∈ divisorialSections ((0 : ℕ) • D) := by
  rw [zero_smul]
  exact mem_divisorialSections_zero_iff.mpr ⟨s, rfl⟩

/-- **Veronese.** The section algebra of `B` is finitely generated over `H⁰(Y, 𝒪_Y)` if and only
if that of `N • B` is, for `N ≥ 1`. -/
private theorem isFGOver_weilSectionAlgebra_nsmul_iff (hY : IsNoetherianRing Γ(Y, ⊤))
    (B : Divisor Y) {N : ℕ} (hN : 0 < N) :
    IsFGOver (weilSectionAlgebra (N • B)) (weilConstants Y) ↔
      IsFGOver (weilSectionAlgebra B) (weilConstants Y) := by
  haveI := hY
  haveI : IsDomain (RationalFunctions Y) :=
    (rationalFunctionsEquivFunctionField Y).injective.isDomain
      (rationalFunctionsEquivFunctionField Y).toRingHom
  let W : ℕ → AddSubgroup (RationalFunctions Y) := fun m => divisorialSections (m • B)
  have h1 : (1 : RationalFunctions Y) ∈ W 0 := by
    change (1 : RationalFunctions Y) ∈ divisorialSections ((0 : ℕ) • B)
    rw [zero_smul]
    exact one_mem_divisorialSections le_rfl
  have hmul : ∀ i j, ∀ x ∈ W i, ∀ y ∈ W j, x * y ∈ W (i + j) := fun i j x hx y hy => by
    have := mul_mem_divisorialSections hx hy
    rwa [← add_smul] at this
  have hR₀ : ∀ x, x ∈ W 0 ↔ x ∈ (globalSectionsToRationalFunctions (X := Y)).range := fun x => by
    change x ∈ divisorialSections ((0 : ℕ) • B) ↔ _
    rw [zero_smul]
    exact mem_divisorialSections_zero_iff
  have hB : coeffRing W h1 hmul = weilSectionAlgebra B := by ext p; rfl
  have hNB : coeffRing (fun m => W (N * m)) (by simpa using h1)
      (fun i j x hx y hy => by simpa [mul_add] using hmul _ _ x hx y hy) =
        weilSectionAlgebra (N • B) := by
    ext p
    simp only [mem_coeffRing, mem_weilSectionAlgebra, W, smul_smul, mul_comm]
  have := isFGOver_coeffRing_iff W h1 hmul _ hR₀ hN
  rw [hB, hNB, RingHom.coe_range] at this
  exact this.symm

/-- The residues along `S` of the sections of `𝒪_Y(mD)` regular along `S`. -/
private noncomputable def residueFamily (S : MMP.Mori.PrimeDivisor Y) (D : Divisor Y) (m : ℕ) :
    AddSubgroup (Y.residueField S.genericPoint) :=
  ((divisorialSections (m • D)).comap (localSubring S).subtype.toAddMonoidHom).map
    (residueAlong S).toAddMonoidHom

private theorem one_mem_residueFamily (S : MMP.Mori.PrimeDivisor Y) (D : Divisor Y) :
    (1 : Y.residueField S.genericPoint) ∈ residueFamily S D 0 :=
  ⟨1, by
    change ((1 : localSubring S) : RationalFunctions Y) ∈ divisorialSections ((0 : ℕ) • D)
    rw [zero_smul]; exact one_mem_divisorialSections le_rfl, map_one (residueAlong S)⟩

private theorem mul_mem_residueFamily (S : MMP.Mori.PrimeDivisor Y) (D : Divisor Y) :
    ∀ i j, ∀ x ∈ residueFamily S D i, ∀ y ∈ residueFamily S D j,
      x * y ∈ residueFamily S D (i + j) := by
  rintro i j _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
  refine ⟨a * b, ?_, map_mul (residueAlong S) a b⟩
  have := mul_mem_divisorialSections ha hb
  rwa [← add_smul] at this

/-- The restricted algebra is `⊕_m (residues of H⁰(𝒪(mB))) tᵐ`. -/
private theorem coeffRing_residueFamily {B : Divisor Y} {S : MMP.Mori.PrimeDivisor Y}
    (hS : B.coeff S = 0) :
    coeffRing (residueFamily S B) (one_mem_residueFamily S B) (mul_mem_residueFamily S B) =
      weilRestrictionAlgebra hS := by
  classical
  ext q
  rw [mem_coeffRing, mem_weilRestrictionAlgebra_iff]
  constructor
  · intro hq
    choose g hg hgq using hq
    refine ⟨∑ m ∈ q.support, monomial m (g m : RationalFunctions Y), fun m => ?_, fun m => ?_⟩
    · rw [finset_sum_coeff]
      simp only [coeff_monomial]
      rw [Finset.sum_ite_eq']
      split_ifs
      · exact hg m
      · exact zero_mem _
    · rw [finset_sum_coeff]
      simp only [coeff_monomial]
      rw [Finset.sum_ite_eq']
      split_ifs with hm
      · obtain ⟨a, ha⟩ := mem_localSubring.mp (g m).2
        exact ⟨a, ha, by rw [← hgq m]; exact residueAlong_eq _ ha⟩
      · refine ⟨0, by simp, ?_⟩
        rw [Polynomial.notMem_support_iff.mp hm, map_zero]
  · rintro ⟨p, hp, h⟩ m
    obtain ⟨a, ha, hqa⟩ := h m
    refine ⟨⟨p.coeff m, divisorialSections_le_localSubring hS m (hp m)⟩, hp m, ?_⟩
    rw [hqa]
    exact residueAlong_eq _ ha

/-- **Veronese for restricted algebras.** If the restricted algebra of `N • B` along `S` is
finitely generated over `Γ(Y, 𝒪_Y)`, so is that of `B`. -/
private theorem finiteType_weilRestriction_of_nsmul (hY : IsNoetherianRing Γ(Y, ⊤))
    {B : Divisor Y} {S : MMP.Mori.PrimeDivisor Y} (hS : B.coeff S = 0) {N : ℕ} (hN : 0 < N)
    (hSN : (N • B).coeff S = 0)
    (h : ((weilRestrictionMap hSN).rangeRestrict.comp
      ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
        (weilSectionAlgebra (N • B))
        (fun s => Subring.mem_comap.mp ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩)))).FiniteType) :
    ((weilRestrictionMap hS).rangeRestrict.comp
      ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
        (weilSectionAlgebra B)
        (fun s => Subring.mem_comap.mp
          ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩)))).FiniteType := by
  haveI := hY
  have hgs : ∀ s : Γ(Y, ⊤), globalSectionsToRationalFunctions s ∈ localSubring S := fun s =>
    divisorialSections_le_localSubring (B := 0) rfl 0
      (globalSections_mem_divisorialSections_zero_nsmul 0 s)
  let γ : Γ(Y, ⊤) →+* Y.residueField S.genericPoint :=
    (residueAlong S).comp ((globalSectionsToRationalFunctions (X := Y)).codRestrict _ hgs)
  -- the finite type condition in terms of subrings of `k(S)[t]`
  have key : ∀ (D : Divisor Y) (hD : D.coeff S = 0),
      ((weilRestrictionMap hD).rangeRestrict.comp
        ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
          (weilSectionAlgebra D)
          (fun s => Subring.mem_comap.mp ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩)))).FiniteType ↔
        IsFGOver (coeffRing (residueFamily S D) (one_mem_residueFamily S D)
          (mul_mem_residueFamily S D)) (C '' γ.range) := by
    intro D hD
    rw [coeffRing_residueFamily hD]
    have hcod : (weilRestrictionMap hD).rangeRestrict.comp
        ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
          (weilSectionAlgebra D)
          (fun s => Subring.mem_comap.mp ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩))) =
        ((weilRestrictionMap hD).comp
          ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
            (weilSectionAlgebra D)
            (fun s => Subring.mem_comap.mp
              ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩)))).codRestrict
          (weilRestrictionAlgebra hD) (fun s => RingHom.mem_range_self _ _) := rfl
    rw [hcod]
    refine (finiteType_codRestrict_iff _ _ _).trans ?_
    have hrange : Set.range ((weilRestrictionMap hD).comp
        ((C.comp (globalSectionsToRationalFunctions (X := Y))).codRestrict
          (weilSectionAlgebra D)
          (fun s => Subring.mem_comap.mp ((comap_C_weilSectionAlgebra _).ge ⟨s, rfl⟩)))) =
        C '' γ.range := by
      ext q
      constructor
      · rintro ⟨s, rfl⟩
        refine ⟨γ s, ⟨s, rfl⟩, ?_⟩
        have :=
          weilRestrictionMap_monomial hD (globalSections_mem_divisorialSections_zero_nsmul D s)
        simp only [monomial_zero_left] at this
        rw [RingHom.comp_apply]
        convert this.symm using 2 <;> rfl
      · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
        refine ⟨s, ?_⟩
        have :=
          weilRestrictionMap_monomial hD (globalSections_mem_divisorialSections_zero_nsmul D s)
        simp only [monomial_zero_left] at this
        rw [RingHom.comp_apply]
        convert this using 2 <;> rfl
    rw [hrange]
  rw [key B hS]
  rw [key (N • B) hSN] at h
  have hfam : coeffRing (residueFamily S (N • B)) (one_mem_residueFamily S _)
      (mul_mem_residueFamily S _) =
      coeffRing (fun m => residueFamily S B (N * m)) (by simpa using one_mem_residueFamily S B)
        (fun i j x hx y hy => by simpa [mul_add] using mul_mem_residueFamily S B _ _ x hx y hy) := by
    ext p
    simp only [mem_coeffRing, residueFamily, smul_smul, mul_comm]
  rw [hfam] at h
  refine (isFGOver_coeffRing_iff (residueFamily S B) _ _ γ.range (fun x => ?_) hN).mpr h
  constructor
  · rintro ⟨a, ha, rfl⟩
    have ha' : (a : RationalFunctions Y) ∈ divisorialSections (0 : Divisor Y) := by
      have := ha
      change (a : RationalFunctions Y) ∈ divisorialSections ((0 : ℕ) • B) at this
      rwa [zero_smul] at this
    obtain ⟨s, hs⟩ := mem_divisorialSections_zero_iff.mp ha'
    exact ⟨s, congrArg (residueAlong S) (Subtype.ext hs)⟩
  · rintro ⟨s, rfl⟩
    exact ⟨_, globalSections_mem_divisorialSections_zero_nsmul B s, rfl⟩

/-- If `N • E = c • T + div φ` and the section algebra of `T` is finitely generated, so is that
of `E`. -/
private theorem isFGOver_weilSectionAlgebra_of_nsmul_eq (hY : IsNoetherianRing Γ(Y, ⊤))
    {E T : Divisor Y} {N c : ℕ} (hN : 0 < N) (hc : 0 < c) (φ : (RationalFunctions Y)ˣ)
    (h : ∀ P, (N • E).coeff P = (c • T).coeff P + P.ord φ)
    (hT : IsFGOver (weilSectionAlgebra T) (weilConstants Y)) :
    IsFGOver (weilSectionAlgebra E) (weilConstants Y) := by
  have h1 := (isFGOver_weilSectionAlgebra_nsmul_iff hY T hc).mpr hT
  have h2 := isFGOver_weilSectionAlgebra_of_coeff_eq φ⁻¹
    (fun P => by rw [h P, PrimeDivisor.ord_inv]; ring) _ h1
  exact (isFGOver_weilSectionAlgebra_nsmul_iff hY E hN).mp h2

end Veronese

/-! ### The mobile representative of the plt prime -/

section Mobile

open Polynomial

/-- **The restricted algebra over an affine base.** Over an affine `T`, let `(Y, S + B)` be plt
with `-S` relatively ample and `N(K + S + B) = cS + div φ`, and let `S' ∼ S` be effective, not
containing `S`. Then the section algebra of `S'` is finitely generated: with the boundary
`S + B + A`, `A = c'S' - (K + S + B)`, `c' = (2c - 1)/2N`, which is `ℚ`-linearly equivalent to
the relatively ample `-S/2N`, the restricted algebras of the multiples of `S'` are finitely
generated by `F(d)`. -/
private theorem isFGOver_weilSectionAlgebra_mobile {d : ℕ} (hd : 2 ≤ d)
    (hF : BirationalFiniteGenerationProperty d)
    {Y T : Scheme.{0}} [IsIntegral Y] [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y]
    {sY : Y ⟶ Spec (.of ℂ)} {sT : T ⟶ Spec (.of ℂ)} (g : Y ⟶ T) (hg : g ≫ sT = sY)
    (hgp : IsProjectiveMorphism g) (hT : IsNormalVariety ℂ sT) [IsAffine T]
    (hYQ : IsQFactorial sY) (hdim : topologicalKrullDim Y = d + 1)
    (K : Divisor Y) (hK : K.IsCanonicalDivisor sY (d + 1))
    (S : MMP.Mori.PrimeDivisor Y) (B : QDivisor Y) (hB : 0 ≤ B) (hBS : B.coeff S = 0)
    (hB1 : ∀ P, B.coeff P < 1)
    (hplt : IsPltPair sY (d + 1) K (Finsupp.single S 1 + B))
    (hSbir : IsBirationalMorphism (S.idealSheaf.subschemeι ≫ g).toImage)
    (hSn : IsNormal S.idealSheaf.subscheme)
    (hSneg : QDivisor.HasRelativelyAmpleMultiple (-(Finsupp.single S 1 : QDivisor Y)) g)
    {N c : ℕ} (hN : 0 < N) (hc : 0 < c) (φ : (RationalFunctions Y)ˣ)
    (hrel : ∀ P, (N : ℚ) * (Divisor.toQDivisor K + (Finsupp.single S 1 + B)).coeff P =
      (c : ℚ) * DivisorWithCoeffs.coeff (Finsupp.single S 1 : QDivisor Y) P + P.ord φ)
    (S' : Divisor Y) (hS'0 : 0 ≤ S') (hS'S : S'.coeff S = 0) (g' : (RationalFunctions Y)ˣ)
    (hg' : ∀ P, P.ord g' = (Finsupp.single S 1 - S' : Divisor Y).coeff P)
    (hNoeth : IsNoetherianRing Γ(Y, ⊤)) :
    IsFGOver (weilSectionAlgebra S') (weilConstants Y) := by
  obtain ⟨n, hn, hnS'⟩ := hYQ.2 S'
  rw [natCast_zsmul] at hnS'
  obtain ⟨e, he⟩ : ∃ e : ℕ, e + 1 = 2 * c := ⟨2 * c - 1, by omega⟩
  have he0 : 0 < e := by omega
  have heQ : (e : ℚ) = 2 * c - 1 := by
    rw [eq_sub_iff_add_eq]
    exact_mod_cast he
  have hN' : (0 : ℚ) < N := by exact_mod_cast hN
  have hs : ∀ P, ((DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor Y) P : ℤ) : ℚ) =
      DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℚ) : QDivisor Y) P := by
    intro P
    rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply]
    by_cases h : S = P
    · subst h; simp
    · simp [Finsupp.single_apply, h]
  set c' : ℚ := (e : ℚ) / (2 * N) with hc'
  have hcc : (2 * N : ℚ) * c' = e := by rw [hc']; field_simp
  set A : QDivisor Y :=
    c' • Divisor.toQDivisor S' - (Divisor.toQDivisor K + (Finsupp.single S 1 + B)) with hAdef
  set A₀ : QDivisor Y := ((1 : ℚ) / (2 * N)) • (-(Finsupp.single S 1 : QDivisor Y)) with hA₀def
  have hKA : Divisor.toQDivisor K + (Finsupp.single S 1 + B + A) = c' • Divisor.toQDivisor S' := by
    rw [hAdef]; abel
  have hA₀ : A₀.HasRelativelyAmpleMultiple g := by
    obtain ⟨m, hm, L, hL, hLe, hamp⟩ := hSneg
    refine ⟨2 * N * m, by positivity, L, hL, ?_, hamp⟩
    rw [hLe]
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply]
    simp only [hA₀def, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_neg, zsmul_eq_mul,
      smul_eq_mul]
    push_cast
    field_simp
  have hA : A.QLinearlyEquivalent A₀ := by
    refine ⟨2 * N, by positivity, g' ^ (-(e : ℤ)) * φ ^ (-2 : ℤ), ?_⟩
    refine Finsupp.ext fun P => ?_
    have h1 := hrel P
    have h2 := hg' P
    have h3 := hs P
    simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor] at h1 h2
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
      Divisor.coeff_toQDivisor, coeff_principalDivisor, PrimeDivisor.ord_mul,
      PrimeDivisor.ord_zpow, PrimeDivisor.ord_zpow, h2]
    simp only [hAdef, hA₀def, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub,
      DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_neg, Divisor.coeff_toQDivisor,
      zsmul_eq_mul, smul_eq_mul]
    push_cast
    rw [heQ] at *
    field_simp
    linear_combination ((DivisorWithCoeffs.coeff S' P : ℤ) : ℚ) * hcc - 2 * h1 + (2 * c - 1) * h3
  have hsec : ∃ m : ℕ, 0 < m ∧ ∃ D : Divisor Y,
      Divisor.toQDivisor D = (m : ℤ) • (Divisor.toQDivisor K + (Finsupp.single S 1 + B + A)) ∧
      ∃ ψ : (RationalFunctions Y)ˣ, (ψ : RationalFunctions Y) ∈ divisorialSections D ∧
        S.ord ψ + D.coeff S = 0 := by
    refine ⟨2 * N, by positivity, e • S', ?_, 1, ?_, ?_⟩
    · rw [hKA]
      refine Finsupp.ext fun P => ?_
      rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply]
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        nsmul_eq_mul, smul_eq_mul]
      push_cast
      linear_combination (-((DivisorWithCoeffs.coeff S' P : ℤ) : ℚ)) * hcc
    · rw [Units.val_one]
      exact one_mem_divisorialSections (nsmul_nonneg hS'0 _)
    · rw [PrimeDivisor.ord_one, DivisorWithCoeffs.coeff_smul, hS'S, smul_zero, add_zero]
  set D : Divisor Y := (e * n) • S' with hDdef
  have hDC : D.IsCartier := by
    rw [hDdef, ← smul_smul]
    exact hnS'.nsmul _
  have hD : Divisor.toQDivisor D =
      ((2 * N * n : ℕ) : ℤ) • (Divisor.toQDivisor K + (Finsupp.single S 1 + B + A)) := by
    rw [hKA]
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply]
    simp only [hDdef, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      nsmul_eq_mul, smul_eq_mul]
    push_cast
    linear_combination (-((DivisorWithCoeffs.coeff S' P : ℤ) : ℚ) * n) * hcc
  have hDS : D.coeff S = 0 := by
    rw [hDdef, DivisorWithCoeffs.coeff_smul, hS'S, smul_zero]
  have hprep := finiteType_weilRestrictionAlgebra_of_birationalFiniteGenerationProperty hd hF g
    hg hgp hT hYQ hdim K hK S B hB hBS hB1 hplt A₀ hA₀ A hA hsec hSbir (2 * N * n) D hDC hD hDS
  rw [← RingHom.comp_assoc] at hprep
  have h1 := RingHom.FiniteType.of_comp_finiteType hprep
  have h2 := finiteType_weilRestriction_of_nsmul hNoeth hS'S (Nat.mul_pos he0 hn) hDS h1
  have h3 := (finiteType_weilSectionAlgebra_iff hS'S hSn hg').mpr h2
  have h4 := (finiteType_codRestrict_iff _ _ _).mp h3
  rwa [RingHom.coe_comp, Set.range_comp] at h4

end Mobile

/-! ### Restriction to the preimage of an open of the base -/

section Restrict

/-- An H-projective morphism stays H-projective over an open of the base. -/
private theorem isProjectiveMorphism_morphismRestrict {X Z : Scheme.{0}} {f : X ⟶ Z}
    (hf : IsProjectiveMorphism f) (U : Z.Opens) : IsProjectiveMorphism (f ∣_ U) := by
  obtain ⟨n, i, hi, hif⟩ := hf.baseChange U.ι
  refine ⟨n, (pullbackRestrictIsoRestrict f U).inv ≫ i, inferInstance, ?_⟩
  rw [Category.assoc, hif, Iso.inv_comp_eq, pullbackRestrictIsoRestrict_hom_morphismRestrict]

/-- The restriction `f ∣_ U` is an isomorphism over `U ∩ V_f`. -/
private theorem isBiregular_morphismRestrict {X Z : Scheme.{0}} (f : X ⟶ Z) (U : Z.Opens) :
    IsBiregular (f ∣_ U) (U.ι ⁻¹ᵁ biregularLocus f) := by
  have e := morphismRestrictRestrict f U (U.ι ⁻¹ᵁ biregularLocus f)
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at e
  exact ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff e).mpr
    (isBiregular_iff_le_biregularLocus.mpr inf_le_right)

/-- A point of `Ex(f ∣_ U)` is a point of `Ex(f)`. -/
private theorem mem_exceptionalSet_of_mem_morphismRestrict {X Z : Scheme.{0}} {f : X ⟶ Z}
    {U : Z.Opens} {x : (f ⁻¹ᵁ U).toScheme} (hx : x ∈ exceptionalSet (f ∣_ U)) :
    (f ⁻¹ᵁ U).ι x ∈ exceptionalSet f := by
  rw [mem_exceptionalSet] at hx ⊢
  intro h
  apply hx
  apply le_biregularLocus (isBiregular_morphismRestrict f U)
  have hx' : U.ι ((f ∣_ U) x) = f ((f ⁻¹ᵁ U).ι x) := by
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  change U.ι ((f ∣_ U) x) ∈ biregularLocus f
  rw [hx']
  exact h

/-- A small morphism restricts to a small morphism over a nonempty open of the base. -/
private theorem isSmallMorphism_morphismRestrict {X Z : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
    (hf : IsSmallMorphism sX sZ f) (U : Z.Opens) [Nonempty U] [Nonempty (f ⁻¹ᵁ U)] :
    IsSmallMorphism ((f ⁻¹ᵁ U).ι ≫ sX) (U.ι ≫ sZ) (f ∣_ U) := by
  have hX := hf.isNormalVariety_source
  have hZ := hf.isNormalVariety_target
  haveI : IsIntegral X := hX.isIntegral
  haveI : IsIntegral Z := hZ.isIntegral
  haveI : IsIntegral (f ⁻¹ᵁ U).toScheme := isIntegral_of_isOpenImmersion (f ⁻¹ᵁ U).ι
  haveI : IsIntegral U.toScheme := isIntegral_of_isOpenImmersion U.ι
  haveI := hf.isProper
  haveI : IsDominant (f ⁻¹ᵁ U).ι := isDominant_ι_of_nonempty (f ⁻¹ᵁ U)
  -- the generic point of `f⁻¹(U)` maps into the biregular locus of `f`
  have hη : (f ∣_ U) (genericPoint (f ⁻¹ᵁ U).toScheme) ∈ U.ι ⁻¹ᵁ biregularLocus f := by
    have hx' : U.ι ((f ∣_ U) (genericPoint (f ⁻¹ᵁ U).toScheme)) =
        f ((f ⁻¹ᵁ U).ι (genericPoint (f ⁻¹ᵁ U).toScheme)) := by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    change U.ι ((f ∣_ U) (genericPoint (f ⁻¹ᵁ U).toScheme)) ∈ biregularLocus f
    rw [hx', MMP.Positivity.map_genericPoint_eq_of_isDominant (f ⁻¹ᵁ U).ι]
    by_contra h
    have h2 := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet hf.two_le_codimension
      (mem_exceptionalSet.mpr h)
    have hmax : IsMax (genericPoint X) := fun y _ => genericPoint_specializes y
    rw [Order.coheight_eq_zero.mpr hmax] at h2
    exact absurd h2 (by decide)
  refine ⟨MMP.Mori.IsNormalVariety.restrictOpen hX _, MMP.Mori.IsNormalVariety.restrictOpen hZ U,
    ?_, IsZariskiLocalAtTarget.restrict (P := @IsProper) hf.isProper U, ?_, ?_⟩
  · rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hf.comp_eq]
  · have hV := isBiregular_morphismRestrict f U
    refine MMP.Flips.isBirationalMorphism_of_isIso_resLE (f ∣_ U)
      ((f ∣_ U) ⁻¹ᵁ (U.ι ⁻¹ᵁ biregularLocus f)) (U.ι ⁻¹ᵁ biregularLocus f)
      ⟨_, hη⟩ ⟨_, hη⟩ le_rfl ?_
    rw [Scheme.Hom.resLE_eq_morphismRestrict]
    exact hV
  · rw [MMP.Flips.le_closedsCodimension_iff_le_coheight]
    intro x hx
    have h2 := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet hf.two_le_codimension
      (mem_exceptionalSet_of_mem_morphismRestrict hx)
    rwa [Topology.IsOpenEmbedding.coheight_eq _ (f ⁻¹ᵁ U).ι.isOpenEmbedding] at h2

/-- The source of an open immersion into a normal scheme is normal. -/
private theorem isNormal_of_isOpenImmersion {T W : Scheme.{0}} (j : T ⟶ W) [IsOpenImmersion j]
    [IsNormal W] : IsNormal T := by
  rw [isNormal_iff_stalk_normal]
  intro x
  haveI : IsIso (j.stalkMap x) := inferInstanceAs (IsIso (j.toLRSHom.stalkMap x))
  let e : W.presheaf.stalk (j x) ≃+* T.presheaf.stalk x :=
    (asIso (j.stalkMap x)).commRingCatIsoToRingEquiv
  haveI : IsDomain (T.presheaf.stalk x) := e.symm.injective.isDomain e.symm.toRingHom
  haveI : IsIntegrallyClosed (W.presheaf.stalk (j x)) := IsNormal.stalk_normal _
  exact ⟨inferInstance, IsIntegrallyClosed.of_equiv e⟩

/-- The restriction of a normal prime divisor to an open subscheme is normal. -/
private theorem isNormal_subscheme_of_primeDivisorMap {X : Scheme.{0}} (V : X.Opens)
    (SV : MMP.Mori.PrimeDivisor V.toScheme)
    (hS : IsNormal (OpenWeilRestriction.primeDivisorMap V.ι SV).idealSheaf.subscheme) :
    IsNormal SV.idealSheaf.subscheme := by
  set S := OpenWeilRestriction.primeDivisorMap V.ι SV with hSdef
  set I := S.idealSheaf.comap V.ι
  haveI := S.integral
  haveI := SV.integral
  let j : I.subscheme ⟶ S.idealSheaf.subscheme :=
    (S.idealSheaf.comapIso V.ι).hom ≫ CategoryTheory.Limits.pullback.snd _ _
  haveI : IsReduced I.subscheme := isReduced_of_isOpenImmersion j
  have hIeq : SV.idealSheaf = I := by
    rw [← MMP.Positivity.vanishingIdeal_support_of_isReduced SV.idealSheaf,
      ← MMP.Positivity.vanishingIdeal_support_of_isReduced I]
    congr 1
    apply SetLike.coe_injective
    rw [Scheme.IdealSheafData.support_comap]
    change SV.support = V.ι ⁻¹' S.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure, hSdef,
      OpenWeilRestriction.genericPoint_primeDivisorMap,
      V.ι.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image, Set.image_singleton]
  rw [hIeq]
  exact isNormal_of_isOpenImmersion j

end Restrict

/-! ### Divisors on the preimage of an open of the base -/

section RestrictDivisor

variable {X : Scheme.{0}}

private theorem restrictOpen_add {R : Type*} [AddCommGroup R] (V : X.Opens)
    (D D' : DivisorWithCoeffs R X) :
    (D + D').restrictOpen V = D.restrictOpen V + D'.restrictOpen V :=
  Finsupp.ext fun W => by
    simp only [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
      DivisorWithCoeffs.coeff_add]

private theorem restrictOpen_neg {R : Type*} [AddCommGroup R] (V : X.Opens)
    (D : DivisorWithCoeffs R X) : (-D).restrictOpen V = -D.restrictOpen V :=
  Finsupp.ext fun W => by
    simp only [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
      DivisorWithCoeffs.coeff_neg]

private theorem restrictOpen_nsmul {R : Type*} [AddCommGroup R] (V : X.Opens) (m : ℕ)
    (D : DivisorWithCoeffs R X) : (m • D).restrictOpen V = m • D.restrictOpen V :=
  Finsupp.ext fun W => by
    simp only [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
      DivisorWithCoeffs.coeff_smul]

private theorem restrictOpen_zsmul {R : Type*} [AddCommGroup R] (V : X.Opens) (m : ℤ)
    (D : DivisorWithCoeffs R X) : (m • D).restrictOpen V = m • D.restrictOpen V :=
  Finsupp.ext fun W => by
    simp only [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
      DivisorWithCoeffs.coeff_smul]

private theorem restrictOpen_single_of_eq {R : Type*} [Zero R] (V : X.Opens)
    {S : MMP.Mori.PrimeDivisor X} {SV : MMP.Mori.PrimeDivisor V.toScheme}
    (h : OpenWeilRestriction.primeDivisorMap V.ι SV = S) (a : R) :
    DivisorWithCoeffs.restrictOpen V (Finsupp.single S a : DivisorWithCoeffs R X) =
      Finsupp.single SV a := by
  classical
  refine Finsupp.ext fun W => ?_
  rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
    DivisorWithCoeffs.coeff_apply, ← h]
  by_cases hW : SV = W
  · subst hW; simp
  · rw [Finsupp.single_eq_of_ne (fun h' => hW (OpenWeilRestriction.primeDivisorMap_injective _
      h').symm), Finsupp.single_eq_of_ne (Ne.symm hW)]

private theorem restrictOpen_single_of_notMem {R : Type*} [Zero R] (V : X.Opens)
    {S : MMP.Mori.PrimeDivisor X} (h : S.genericPoint ∉ V) (a : R) :
    DivisorWithCoeffs.restrictOpen V (Finsupp.single S a : DivisorWithCoeffs R X) = 0 := by
  classical
  refine Finsupp.ext fun W => ?_
  rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_restrictOpen,
    DivisorWithCoeffs.coeff_apply, Finsupp.zero_apply]
  refine Finsupp.single_eq_of_ne fun hW => h ?_
  rw [← hW]
  change AlgebraicGeometry.PrimeDivisor.genericPoint
    (OpenWeilRestriction.primeDivisorMap V.ι W) ∈ V
  rw [OpenWeilRestriction.genericPoint_primeDivisorMap]
  exact (AlgebraicGeometry.PrimeDivisor.genericPoint W).2

/-- The closure in `X` of a prime divisor of `V` meets `V`. -/
private theorem support_primeDivisorMap_inter_nonempty (V : X.Opens)
    (W : MMP.Mori.PrimeDivisor V.toScheme) :
    ((OpenWeilRestriction.primeDivisorMap V.ι W).support ∩ V).Nonempty := by
  rw [← MMP.Mori.PrimeDivisor.genericPoint_mem_iff]
  change AlgebraicGeometry.PrimeDivisor.genericPoint
    (OpenWeilRestriction.primeDivisorMap V.ι W) ∈ V
  rw [OpenWeilRestriction.genericPoint_primeDivisorMap]
  exact (AlgebraicGeometry.PrimeDivisor.genericPoint W).2

end RestrictDivisor

/-! ### Restriction to the preimage of an affine open of the base -/

/-- The coefficient of `S` in `B` vanishes when `(X, S + B)` is plt and `B ≥ 0`: every
coefficient of an lc boundary is at most one. -/
private theorem coeff_eq_zero_of_isPltPair {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {d : ℕ} (hd : 2 ≤ d)
    {K : Divisor X} {S : MMP.Mori.PrimeDivisor X} {B : QDivisor X} (hB : 0 ≤ B)
    (hplt : IsPltPair sX (d + 1) K (Finsupp.single S 1 + B)) : B.coeff S = 0 := by
  have h1 := MMP.Mori.IsLcPair.coeff_le_one hplt.isLcPair (by omega) S
  rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
    Finsupp.single_eq_same] at h1
  exact le_antisymm (by linarith) (Finsupp.le_def.mp hB S)

/-- `ℚ`-factoriality restricts to open subschemes. -/
private theorem isQFactorial_restrictOpen {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)} (h : IsQFactorial sX) (V : X.Opens)
    [Nonempty V] [CompactSpace V.toScheme] :
    IsQFactorial (V.ι ≫ sX) := by
  haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
  haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
  refine ⟨MMP.Mori.IsNormalVariety.restrictOpen h.1 V, fun D => ?_⟩
  obtain ⟨m, hm, hmD⟩ := h.2 (Finsupp.mapDomain (OpenWeilRestriction.primeDivisorMap V.ι) D)
  refine ⟨m, hm, ?_⟩
  have := MMP.Fourfold.isCartier_of_isPullback V.ι hmD (MMP.Flips.isPullback_restrictOpen V hmD)
  rwa [restrictOpen_zsmul, show DivisorWithCoeffs.restrictOpen V
      (Finsupp.mapDomain (OpenWeilRestriction.primeDivisorMap V.ι) D) = D from
    Finsupp.comapDomain_mapDomain _ (OpenWeilRestriction.primeDivisorMap_injective _) D] at this

/-- Relative ampleness restricts to the preimage of an open of the base. -/
private theorem hasRelativelyAmpleMultiple_restrictOpen {X Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Z} [QuasiCompact f]
    {D : QDivisor X} (h : D.HasRelativelyAmpleMultiple f) (U : Z.Opens) [Nonempty (f ⁻¹ᵁ U)]
    [CompactSpace (f ⁻¹ᵁ U).toScheme] :
    QDivisor.HasRelativelyAmpleMultiple (D.restrictOpen (f ⁻¹ᵁ U)) (f ∣_ U) := by
  set V := f ⁻¹ᵁ U
  haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
  haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
  obtain ⟨m, hm, L, hL, hLe, hamp⟩ := h
  have hB := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant V.ι L
  have hpb := MMP.Flips.isPullback_restrictOpen V hL
  have hL' : Divisor.IsCartier (L.restrictOpen V) := MMP.Fourfold.isCartier_of_isPullback V.ι hL hpb
  refine ⟨m, hm, L.restrictOpen V, hL', ?_, ?_⟩
  · rw [← restrictOpen_zsmul, ← hLe]
    refine Finsupp.ext fun W => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toQDivisor,
      DivisorWithCoeffs.coeff_restrictOpen, DivisorWithCoeffs.coeff_restrictOpen,
      Divisor.coeff_toQDivisor]
  · haveI := hL.isInvertibleModule_divisorialSheaf
    haveI := hL'.isInvertibleModule_divisorialSheaf
    have h1 : MMP.Mori.IsRelativelyAmple (f ∣_ U)
        ((RingedSpaceModuleAdjunction.modulePullback V.ι.toLRSHom.toShHom).obj
          L.divisorialSheaf) :=
      hamp.isAmpleOver U
    obtain ⟨e⟩ := Divisor.nonempty_divisorialSheaf_pullback_iso (hD := hL) (f := V.ι) hB
    rw [hpb.pullback_eq hL] at e
    exact h1.of_iso (((AlgebraicGeometry.modulePullbackIsoSchemePullback V.ι).app _) ≪≫ e.symm)

/-- A prime divisor of `f⁻¹(U)` maps birationally onto its image when `f` is small. -/
private theorem isBirationalMorphism_toImage_restrict {X Z : Scheme.{0}} [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
    (hf : IsSmallMorphism sX sZ f) (U : Z.Opens) (SV : MMP.Mori.PrimeDivisor (f ⁻¹ᵁ U).toScheme) :
    IsBirationalMorphism (SV.idealSheaf.subschemeι ≫ f ∣_ U).toImage := by
  haveI := hf.isProper
  haveI : IsProper (f ∣_ U) := IsZariskiLocalAtTarget.restrict (P := @IsProper) hf.isProper U
  haveI : IsIso ((f ∣_ U) ∣_ (U.ι ⁻¹ᵁ biregularLocus f)) := isBiregular_morphismRestrict f U
  refine MMP.Flips.isBirationalMorphism_toImage_subschemeι_comp (f ∣_ U)
    (U.ι ⁻¹ᵁ biregularLocus f) SV ?_
  change U.ι ((f ∣_ U) (AlgebraicGeometry.PrimeDivisor.genericPoint SV)) ∈ biregularLocus f
  rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  by_contra h
  have h2 := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet hf.two_le_codimension
    (mem_exceptionalSet.mpr h)
  rw [Topology.IsOpenEmbedding.coheight_eq _ (f ⁻¹ᵁ U).ι.isOpenEmbedding,
    SV.coheight_genericPoint] at h2
  exact absurd h2 (by decide)

/-! ### Rational functions on an integral scheme as sections over an open -/

section Sections

open Opposite

variable {Y : Scheme.{0}} [IsIntegral Y]

private theorem eq_of_irreducibleComponents (Z Z' : irreducibleComponents Y) : Z = Z' := by
  haveI : Subsingleton (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  exact Subsingleton.elim Z Z'

private theorem componentGenericPoint_specializes (Z : irreducibleComponents Y) :
    componentGenericPoint Y Z ⤳ genericPoint Y := by
  have hZ : Z.1 = Set.univ :=
    Z.2.eq_of_le (IrreducibleSpace.isIrreducible_univ _) (Set.subset_univ _)
  exact (isGenericPoint_componentGenericPoint Y Z).specializes (by rw [hZ]; trivial)

/-- Generization to the generic point is injective on the factors of `K(Y)`. -/
private theorem stalkSpecializes_genericPoint_injective (Z : irreducibleComponents Y)
    (h : genericPoint Y ⤳ componentGenericPoint Y Z) :
    Function.Injective (Y.presheaf.stalkSpecializes h).hom := by
  intro a b hab
  have := congrArg (Y.presheaf.stalkSpecializes (componentGenericPoint_specializes Z)).hom hab
  change (Y.presheaf.stalkSpecializes h ≫ Y.presheaf.stalkSpecializes _).hom a =
    (Y.presheaf.stalkSpecializes h ≫ Y.presheaf.stalkSpecializes _).hom b at this
  rwa [TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl] at this

/-- On an integral scheme, a rational function is its value at the generic point. -/
private theorem stalkSpecializes_apply_eq (g : RationalFunctions Y) (Z : irreducibleComponents Y)
    (h : genericPoint Y ⤳ componentGenericPoint Y Z) :
    (Y.presheaf.stalkSpecializes h).hom (g Z) = rationalFunctionsEquivFunctionField Y g := by
  haveI : Finite (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  obtain ⟨W, hW, s, hs⟩ := Y.presheaf.exists_germ_eq (g Z)
  have hη : genericPoint Y ∈ W := h.mem_open W.isOpen hW
  let D : Stacks.Chow.DenseOpen Y := ⟨W, W.isOpen.dense ⟨_, hW⟩⟩
  have hg : (Stacks.Chow.rationalFunctionsEquivStalks Y).1 (Stacks.Chow.ofSection Y D s) = g := by
    funext Z'
    obtain rfl := eq_of_irreducibleComponents Z Z'
    rw [(Stacks.Chow.rationalFunctionsEquivStalks Y).2 D s Z hW, hs]
  rw [← hs, TopCat.Presheaf.germ_stalkSpecializes_apply, ← hg]
  change _ = (Stacks.Chow.rationalFunctionsEquivFunctionField Y).1
    ((Stacks.Chow.rationalFunctionsEquivStalks Y).1.symm
      ((Stacks.Chow.rationalFunctionsEquivStalks Y).1 (Stacks.Chow.ofSection Y D s)))
  rw [RingEquiv.symm_apply_apply, (Stacks.Chow.rationalFunctionsEquivFunctionField Y).2 D s hη]

/-- A rational function, as a section of `𝒦_Y` over `W`. -/
private noncomputable def toSectionsOver (W : Y.Opens) :
    Y.functionField →+* (rationalFunctionsPresheaf Y).obj (op W) :=
  ((rationalFunctionsPresheaf Y).map (homOfLE le_top : W ⟶ ⊤).op).hom.comp
    ((rationalFunctionsPresheafTopEquiv Y).symm.toRingHom.comp
      (rationalFunctionsEquivFunctionField Y).symm.toRingHom)

/-- The value at the generic point of a section of `𝒦_Y` over `W`. -/
private noncomputable def genericValue {W : Y.Opens}
    (a : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Y.functionField :=
  (Y.presheaf.stalkSpecializes (genericPoint_specializes (componentGenericPoint Y Z.1))).hom (a Z)

private theorem genericValue_toSectionsOver (W : Y.Opens)
    (ξ : Y.functionField) (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    genericValue (toSectionsOver W ξ) Z = ξ := by
  change (Y.presheaf.stalkSpecializes _).hom
    ((rationalFunctionsEquivFunctionField Y).symm ξ Z.1) = ξ
  rw [stalkSpecializes_apply_eq, RingEquiv.apply_symm_apply]

/-- A section of `𝒦_Y` over an open is determined by its value at the generic point. -/
private theorem eq_of_genericValue_eq {W : Y.Opens}
    {a b : ToType ((rationalFunctionsPresheaf Y).obj (op W))}
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W})
    (h : genericValue a Z = genericValue b Z) : a = b := by
  funext Z'
  obtain rfl : Z = Z' := Subtype.ext (eq_of_irreducibleComponents _ _)
  exact stalkSpecializes_genericPoint_injective Z.1 _ h

private theorem toSectionsOver_bijective (W : Y.Opens) (hW : genericPoint Y ∈ W) :
    Function.Bijective (toSectionsOver W) := by
  have hZ : ∀ Z : irreducibleComponents Y, componentGenericPoint Y Z ∈ W := fun Z =>
    (componentGenericPoint_specializes Z).mem_open W.isOpen hW
  obtain ⟨Z₀⟩ : Nonempty (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  refine ⟨fun ξ ζ h => ?_, fun a => ⟨genericValue a ⟨Z₀, hZ Z₀⟩, ?_⟩⟩
  · simpa only [genericValue_toSectionsOver] using congrArg (fun a => genericValue a ⟨Z₀, hZ Z₀⟩) h
  · exact eq_of_genericValue_eq ⟨Z₀, hZ Z₀⟩ (genericValue_toSectionsOver _ _ _)

/-- Over the whole space, `toSectionsOver` is the identification `K(Y) ≅ K(Y)`. -/
private theorem toSectionsOver_top (g : RationalFunctions Y) :
    toSectionsOver ⊤ (rationalFunctionsEquivFunctionField Y g) =
      (rationalFunctionsPresheafTopEquiv Y).symm g := by
  funext Z
  change (rationalFunctionsEquivFunctionField Y).symm (rationalFunctionsEquivFunctionField Y g)
    Z.1 = g Z.1
  rw [RingEquiv.symm_apply_apply]

variable [IsLocallyNoetherian Y] [IsNormal Y]

/-- Membership in `H⁰(Y, 𝒪(D))` through the function field. -/
private theorem mem_divisorialSections_iff_toSectionsOver {D : Divisor Y}
    {g : RationalFunctions Y} :
    g ∈ divisorialSections D ↔
      toSectionsOver ⊤ (rationalFunctionsEquivFunctionField Y g) ∈ D.divisorialSubmodule ⊤ := by
  rw [toSectionsOver_top]
  exact Iff.rfl

end Sections

/-- **Sections over an open subscheme.** A rational function on `X` is a section of `𝒪_X(D)`
over `V` exactly when its image in `K(V)` is a global section of `𝒪_V(D|_V)`. -/
private theorem toSectionsOver_mem_divisorialSubmodule_iff {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (V : X.Opens) [Nonempty V] (D : Divisor X)
    (ξ : X.functionField) :
    haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
    haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
    toSectionsOver V ξ ∈ D.divisorialSubmodule V ↔
      toSectionsOver (⊤ : V.toScheme.Opens) (functionFieldMap V.ι ξ) ∈
        Divisor.divisorialSubmodule (D.restrictOpen V) ⊤ := by
  haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
  haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
  obtain ⟨Z₀⟩ : Nonempty (irreducibleComponents V.toScheme) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  obtain ⟨Z₁⟩ : Nonempty (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  have hO' : V.ι ⁻¹ᵁ V = ⊤ := by
    ext x
    exact ⟨fun _ => trivial, fun _ => x.2⟩
  have hZ₀ : componentGenericPoint V.toScheme Z₀ ∈ (⊤ : V.toScheme.Opens) := trivial
  have hZ₁ : componentGenericPoint X Z₁ ∈ V := by
    obtain ⟨x⟩ := ‹Nonempty V›
    exact (componentGenericPoint_specializes Z₁).mem_open V.isOpen
      ((genericPoint_specializes x.1).mem_open V.isOpen x.2)
  have hZ₁' : V.ι (componentGenericPoint V.toScheme Z₀) ∈ Z₁.1 := by
    rw [Z₁.2.eq_of_le (IrreducibleSpace.isIrreducible_univ _) (Set.subset_univ _)]
    trivial
  -- the restriction of the section `ξ` over `V` is the section `ξ|_V` of `V`
  have hrestr : MMP.FourfoldProofs.FractionalLogComplexProof.rationalFunctionsToOpens V hO'
      (toSectionsOver V ξ) = toSectionsOver ⊤ (functionFieldMap V.ι ξ) := by
    refine eq_of_genericValue_eq ⟨Z₀, hZ₀⟩ ?_
    rw [genericValue_toSectionsOver]
    obtain ⟨W, hW, t, ht⟩ := X.presheaf.exists_germ_eq
      ((rationalFunctionsEquivFunctionField X).symm ξ Z₁)
    have hξ : ξ = X.presheaf.germ W (genericPoint X)
        ((genericPoint_specializes _).mem_open W.isOpen hW) t := by
      have := stalkSpecializes_apply_eq ((rationalFunctionsEquivFunctionField X).symm ξ) Z₁
        (genericPoint_specializes _)
      rw [RingEquiv.apply_symm_apply, ← ht, TopCat.Presheaf.germ_stalkSpecializes_apply] at this
      exact this.symm
    have hV : genericPoint V.toScheme ∈ V.ι ⁻¹ᵁ W := by
      change V.ι (genericPoint V.toScheme) ∈ W
      rw [MMP.Positivity.map_genericPoint_eq_of_isDominant V.ι]
      exact (genericPoint_specializes _).mem_open W.isOpen hW
    have hrhs : functionFieldMap V.ι ξ =
        V.toScheme.presheaf.germ (V.ι ⁻¹ᵁ W) (genericPoint V.toScheme) hV ((V.ι.app W).hom t) := by
      have hV' : V.ι (genericPoint V.toScheme) ∈ W := hV
      have h2 : ∀ h : Inseparable (genericPoint X) (V.ι (genericPoint V.toScheme)),
          (X.presheaf.stalkCongr h).hom.hom (X.presheaf.germ W (genericPoint X)
            ((genericPoint_specializes _).mem_open W.isOpen hW) t) =
            X.presheaf.germ W (V.ι (genericPoint V.toScheme)) hV' t := fun h => by
        simp only [TopCat.Presheaf.stalkCongr_hom]
        exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
      rw [hξ]
      change (V.ι.stalkMap (genericPoint V.toScheme)).hom
        ((X.presheaf.stalkCongr _).hom.hom (X.presheaf.germ W _ _ t)) = _
      rw [h2, Scheme.Hom.germ_stalkMap_apply]
    rw [hrhs]
    change (V.toScheme.presheaf.stalkSpecializes _).hom
      (MMP.FourfoldProofs.FractionalLogComplexProof.rationalFunctionsToOpens V hO'
        (toSectionsOver V ξ) ⟨Z₀, hZ₀⟩) = _
    rw [MMP.FourfoldProofs.FractionalLogComplexProof.rationalFunctionsToOpens_apply V hO' _
      ⟨Z₀, hZ₀⟩ Z₁ hZ₁' hZ₁]
    change (V.toScheme.presheaf.stalkSpecializes _).hom
      ((MMP.FourfoldProofs.FractionalLogComplexProof.componentStalkIso V hZ₁').hom.hom
        ((rationalFunctionsEquivFunctionField X).symm ξ Z₁)) = _
    rw [← ht, MMP.FourfoldProofs.FractionalLogComplexProof.componentStalkIso_hom_germ,
      TopCat.Presheaf.germ_stalkSpecializes_apply]
  have hD : MMP.FourfoldProofs.FractionalLogComplexProof.restrictDivisor V D = D.restrictOpen V := by
    refine Finsupp.ext fun E => ?_
    rw [MMP.FourfoldProofs.FractionalLogComplexProof.restrictDivisor_apply,
      ← DivisorWithCoeffs.coeff_apply (D.restrictOpen V), DivisorWithCoeffs.coeff_restrictOpen,
      DivisorWithCoeffs.coeff_apply]
    have hE : MMP.FourfoldProofs.FractionalLogComplexProof.primeDivisorOfOpens V E =
        OpenWeilRestriction.primeDivisorMap V.ι E :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        ((MMP.FourfoldProofs.FractionalLogComplexProof.genericPoint_primeDivisorOfOpens V E).trans
          (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm)
    rw [hE]
  rw [Divisor.mem_divisorialSubmodule, Divisor.mem_divisorialSubmodule, ← hrestr, ← hD,
    MMP.FourfoldProofs.FractionalLogComplexProof.isDivisorialSection_rationalFunctionsToOpens_iff V D
      le_rfl hO']

/-- A small birational morphism does not contract prime divisors: `f⁻¹_* f_* E = E`. -/
private theorem inverseTransformDivisor_transformDivisor {X Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    [IsSeparated (Z ↘ ⊤_ Scheme)] (f : X ⟶ Z) [IsProper f] (hf : IsBirationalMorphism f)
    (hEx : 2 ≤ closedsCodimension (exceptionalSet f)) (E : Divisor X) :
    inverseTransformDivisor f (RationalMap.transformDivisor f.toRationalMap E) = E := by
  induction E using Finsupp.induction_linear with
  | zero => simp
  | add D D' h h' => rw [map_add, map_add, h, h']
  | single P c =>
    have hbir : f P.genericPoint ∈ biregularLocus f := by
      by_contra h
      have h2 := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet hEx
        (mem_exceptionalSet.mpr h)
      rw [P.coheight_genericPoint] at h2
      exact absurd h2 (by decide)
    have hco : Order.coheight (f P.genericPoint) = 1 := by
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hbir, P.coheight_genericPoint]
    rw [RationalMap.transformDivisor_single_of_eq_some
      ((MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff f P _).mpr
        (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hco).symm),
      inverseTransformDivisor_single_of_eq_some
        (MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
          (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hco).symm hbir)]

/-- **From `f⁻¹(U)` to `U`.** Finite generation of the section algebra of `E|_{f⁻¹U}` gives
finite generation of `R(Z, f_* E)` over `U`, for `f` proper birational with exceptional set of
codimension at least two. -/
private theorem finiteType_divisorialAlgebraSections_of_isFGOver {X Z : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Z]
    [IsLocallyNoetherian Z] [IsNormal Z] [IsSeparated (Z ↘ ⊤_ Scheme)] (f : X ⟶ Z) [IsProper f]
    (hf : IsBirationalMorphism f) (hEx : 2 ≤ closedsCodimension (exceptionalSet f))
    (E : Divisor X) (U : Z.Opens) [Nonempty (f ⁻¹ᵁ U)]
    (h : IsFGOver (weilSectionAlgebra (E.restrictOpen (f ⁻¹ᵁ U)))
      (weilConstants (f ⁻¹ᵁ U).toScheme)) :
    Algebra.FiniteType Γ(Z, U)
      (Divisor.divisorialAlgebraSections (RationalMap.transformDivisor f.toRationalMap E) U) := by
  set V : X.Opens := f ⁻¹ᵁ U
  set B := RationalMap.transformDivisor f.toRationalMap E
  haveI : IsDominant f := hf.isDominant
  haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
  haveI : IsDominant V.ι := isDominant_ι_of_nonempty V
  have hηU : genericPoint Z ∈ U := by
    obtain ⟨x⟩ := ‹Nonempty V›
    exact (genericPoint_specializes (f x.1)).mem_open U.isOpen x.2
  -- the identification `K(f⁻¹U) ≅ K_Z(U)`
  let eF := RingEquiv.ofBijective (functionFieldMap f) hf.functionFieldMap_bijective
  let eι := RingEquiv.ofBijective (functionFieldMap V.ι)
    (MMP.Mori.functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤
      ⟨Classical.arbitrary V.toScheme, trivial⟩)
  let Φ : RationalFunctions V.toScheme →+* (rationalFunctionsPresheaf Z).obj (op U) :=
    (toSectionsOver U).comp (eF.symm.toRingHom.comp
      (eι.symm.toRingHom.comp (rationalFunctionsEquivFunctionField V.toScheme).toRingHom))
  have hΦ : Function.Bijective Φ :=
    (toSectionsOver_bijective U hηU).comp (eF.symm.bijective.comp
      (eι.symm.bijective.comp (rationalFunctionsEquivFunctionField V.toScheme).bijective))
  have hinv : ∀ m : ℕ, inverseTransformDivisor f (m • B) = m • E := fun m => by
    rw [map_nsmul, inverseTransformDivisor_transformDivisor f hf hEx]
  have hmem : ∀ (m : ℕ) (g : RationalFunctions V.toScheme),
      g ∈ divisorialSections (m • E.restrictOpen V) ↔ Φ g ∈ Divisor.divisorialSubmodule (m • B) U := by
    intro m g
    have hξ : functionFieldMap V.ι (eι.symm (rationalFunctionsEquivFunctionField _ g)) =
        rationalFunctionsEquivFunctionField _ g := eι.apply_symm_apply _
    have hφ : functionFieldMap f (eF.symm (eι.symm (rationalFunctionsEquivFunctionField _ g))) =
        eι.symm (rationalFunctionsEquivFunctionField _ g) := eF.apply_symm_apply _
    rw [mem_divisorialSections_iff_toSectionsOver, ← restrictOpen_nsmul, ← hξ,
      ← toSectionsOver_mem_divisorialSubmodule_iff V (m • E), ← hφ, ← hinv m]
    exact (Divisor.mem_divisorialSubmodule_inverseTransformDivisor_iff f hEx (m • B) U _).symm
  let eΦ := RingEquiv.ofBijective Φ hΦ
  have hT : IsFGOver (Divisor.divisorialAlgebraSections B U).toSubring
      (Set.range (algebraMap Γ(Z, U) (Polynomial ((rationalFunctionsPresheaf Z).obj (op U))))) := by
    refine h.of_map (Polynomial.mapRingHom Φ) (fun p hp m => ?_) (fun q hq => ?_) ?_
    · change (p.map Φ).coeff m ∈ Divisor.divisorialSubmodule (m • B) U
      rw [Polynomial.coeff_map]
      exact (hmem m _).mp (hp m)
    · refine ⟨q.map eΦ.symm.toRingHom, fun m => ?_, ?_⟩
      · rw [Polynomial.coeff_map]
        refine (hmem m _).mpr ?_
        have : Φ (eΦ.symm.toRingHom (q.coeff m)) = q.coeff m := eΦ.apply_symm_apply _
        rw [this]
        exact hq m
      · change (q.map eΦ.symm.toRingHom).map Φ = q
        rw [Polynomial.map_map]
        refine Polynomial.ext fun m => ?_
        rw [Polynomial.coeff_map]
        exact eΦ.apply_symm_apply _
    · rintro _ ⟨_, ⟨_, ⟨s, rfl⟩, rfl⟩, rfl⟩
      have h1 :=
        (hmem 0 _).mp (globalSections_mem_divisorialSections_zero_nsmul (E.restrictOpen V) s)
      rw [zero_smul] at h1
      obtain ⟨t, ht⟩ := Divisor.IsDivisorialSection.exists_eq h1
      refine ⟨t, ?_⟩
      rw [Polynomial.algebraMap_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
      exact congrArg Polynomial.C ht
  rw [← RingHom.finiteType_algebraMap]
  have hcod : algebraMap Γ(Z, U) (Divisor.divisorialAlgebraSections B U) =
      (algebraMap Γ(Z, U) (Polynomial ((rationalFunctionsPresheaf Z).obj (op U)))).codRestrict
        (Divisor.divisorialAlgebraSections B U).toSubring
        (fun a => (Divisor.divisorialAlgebraSections B U).algebraMap_mem a) := rfl
  rwa [hcod, finiteType_codRestrict_iff]

/-! ### The section algebra over an affine open of the base -/

/-- **Finite generation over an affine open of the base.** If `N E = c S + div φ` on the prime
divisors meeting `f⁻¹(U)`, with `E = r(K + S + B)`, then `R(Z, f_* E)` is finitely generated
over `U`. -/
private theorem finiteType_divisorialAlgebraSections_of_nsmul_eq
    {d : ℕ} (hd : 2 ≤ d) (hF : BirationalFiniteGenerationProperty d)
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} (hQ : IsQFactorial sX)
    {Z : Scheme.{0}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] {sZ : Z ⟶ Spec (.of ℂ)}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (d + 1))
    {S : MMP.Mori.PrimeDivisor X} {B : QDivisor X} (hB : 0 ≤ B) (hBS : B.coeff S = 0)
    (hB1 : ∀ P, B.coeff P < 1) (hplt : IsPltPair sX (d + 1) K (Finsupp.single S 1 + B))
    (hSn : IsNormal S.idealSheaf.subscheme)
    {f : X ⟶ Z} (hfp : IsProjectiveMorphism f) (hfs : Function.Surjective f)
    (hiso : ∀ U, IsIso (f.app U)) (hsmall : IsSmallMorphism sX sZ f)
    (hSneg : QDivisor.HasRelativelyAmpleMultiple (-(Finsupp.single S 1 : QDivisor X)) f)
    {E : Divisor X} {r : ℕ} (hr : 0 < r)
    (hE : Divisor.toQDivisor E = (r : ℚ) • (Divisor.toQDivisor K + (Finsupp.single S 1 + B)))
    (U : Z.Opens) (hU : IsAffineOpen U) (hUne : (U : Set Z).Nonempty)
    {N c : ℕ} (hN : 0 < N) (hc : 0 < c) (φ : (RationalFunctions X)ˣ)
    (hcoeff : ∀ W : MMP.Mori.PrimeDivisor X, (W.support ∩ f ⁻¹ᵁ U).Nonempty →
      DivisorWithCoeffs.coeff (N • E) W =
        DivisorWithCoeffs.coeff (c • (Finsupp.single S 1 : Divisor X)) W + W.ord φ) :
    Algebra.FiniteType Γ(Z, U)
      (Divisor.divisorialAlgebraSections (RationalMap.transformDivisor f.toRationalMap E) U) := by
  set V : X.Opens := f ⁻¹ᵁ U with hVdef
  obtain ⟨z, hz⟩ := hUne
  obtain ⟨x, rfl⟩ := hfs z
  haveI : Nonempty U := ⟨⟨_, hz⟩⟩
  haveI : Nonempty V := ⟨⟨x, hz⟩⟩
  haveI : IsAffine U.toScheme := hU
  haveI : IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
  haveI := hsmall.isProper
  haveI : IsDominant f := hsmall.isBirationalMorphism.isDominant
  haveI : CompactSpace V.toScheme :=
    isCompact_iff_compactSpace.mp (f.isCompact_preimage hU.isCompact)
  have hXnv := hsmall.isNormalVariety_source
  have hZnv := hsmall.isNormalVariety_target
  have hg : f ∣_ U ≫ U.ι ≫ sZ = V.ι ≫ sX := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hsmall.comp_eq]
  have hgp := isProjectiveMorphism_morphismRestrict hfp U
  have hUnv : IsNormalVariety ℂ (U.ι ≫ sZ) := MMP.Mori.IsNormalVariety.restrictOpen hZnv U
  have hQV : IsQFactorial (V.ι ≫ sX) := isQFactorial_restrictOpen hQ V
  have hKV : Divisor.IsCanonicalDivisor (V.ι ≫ sX) (d + 1) (K.restrictOpen V) :=
    MMP.Mori.Divisor.IsCanonicalDivisor.restrictOpen hXnv hK V
  have hdimV : topologicalKrullDim V.toScheme = d + 1 := hKV.1
  have hNoeth : IsNoetherianRing Γ(V.toScheme, ⊤) := by
    haveI : IsNoetherianRing Γ(Z, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    haveI := hiso U
    exact isNoetherianRing_of_ringEquiv Γ(Z, U)
      ((asIso (f.app U)).commRingCatIsoToRingEquiv.trans V.topIso.symm.commRingCatIsoToRingEquiv)
  obtain ⟨φV, hφV⟩ := exists_ord_eq_restrict V φ
  have hrelV : ∀ W : MMP.Mori.PrimeDivisor V.toScheme,
      DivisorWithCoeffs.coeff (N • E.restrictOpen V) W =
        DivisorWithCoeffs.coeff
          (c • DivisorWithCoeffs.restrictOpen V (Finsupp.single S 1 : Divisor X)) W +
          W.ord φV := by
    intro W
    rw [hφV]
    have := hcoeff _ (support_primeDivisorMap_inter_nonempty V W)
    simpa only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_restrictOpen] using this
  haveI : IsSeparated (Z ↘ ⊤_ Scheme) := by
    haveI : IsSeparated sZ := hZnv.1.toIsSeparated
    rw [show (Z ↘ ⊤_ Scheme) = sZ ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  refine finiteType_divisorialAlgebraSections_of_isFGOver f hsmall.isBirationalMorphism
    hsmall.two_le_codimension E U ?_
  by_cases hSV : S.genericPoint ∈ V
  · obtain ⟨SV, hSV'⟩ := (OpenWeilRestriction.mem_range_primeDivisorMap_iff V.ι S).2
      (by rwa [Scheme.Opens.range_ι])
    have hsingle := restrictOpen_single_of_eq V hSV' (1 : ℤ)
    have hsingleQ := restrictOpen_single_of_eq V hSV' (1 : ℚ)
    have hsmallV := isSmallMorphism_morphismRestrict hsmall U
    obtain ⟨⟨S', hS'0, ⟨ψ, hψ⟩, hS'S⟩, -⟩ :=
      hsmallV.exists_linearlyEquivalent_coeff_eq_zero hgp SV
    have hψc : ∀ P, P.ord ψ = DivisorWithCoeffs.coeff S' P -
        DivisorWithCoeffs.coeff (Finsupp.single SV (1 : ℤ) : Divisor V.toScheme) P := by
      intro P
      have := congrArg (fun D => DivisorWithCoeffs.coeff D P) hψ
      simpa only [DivisorWithCoeffs.coeff_sub, coeff_principalDivisor] using this.symm
    have hpltV : IsPltPair (V.ι ≫ sX) (d + 1) (K.restrictOpen V)
        (Finsupp.single SV 1 + B.restrictOpen V) := by
      have := MMP.Mori.IsPltPair.restrictOpen (U := V) hplt
      rwa [restrictOpen_add, hsingleQ] at this
    have hSnegV : QDivisor.HasRelativelyAmpleMultiple
        (-(Finsupp.single SV 1 : QDivisor V.toScheme)) (f ∣_ U) := by
      have := hasRelativelyAmpleMultiple_restrictOpen hSneg U
      rwa [restrictOpen_neg, hsingleQ] at this
    have hrelV' : ∀ P, ((N * r : ℕ) : ℚ) * DivisorWithCoeffs.coeff
        (Divisor.toQDivisor (K.restrictOpen V) + (Finsupp.single SV 1 + B.restrictOpen V)) P =
          (c : ℚ) * DivisorWithCoeffs.coeff (Finsupp.single SV 1 : QDivisor V.toScheme) P +
            P.ord φV := by
      intro P
      have h1 := hrelV P
      have h2 := congrArg (fun D : QDivisor X => DivisorWithCoeffs.coeff D
        (OpenWeilRestriction.primeDivisorMap V.ι P)) hE
      rw [← hsingleQ]
      simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_restrictOpen,
        DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, smul_eq_mul, nsmul_eq_mul] at h1 h2 ⊢
      have h1' : ((N : ℤ) : ℚ) * ((DivisorWithCoeffs.coeff E
          (OpenWeilRestriction.primeDivisorMap V.ι P) : ℤ) : ℚ) =
          ((c : ℤ) : ℚ) * ((DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X)
            (OpenWeilRestriction.primeDivisorMap V.ι P) : ℤ) : ℚ) + ((P.ord φV : ℤ) : ℚ) := by
        exact_mod_cast h1
      have hs : ((DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X)
          (OpenWeilRestriction.primeDivisorMap V.ι P) : ℤ) : ℚ) =
          DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℚ) : QDivisor X)
            (OpenWeilRestriction.primeDivisorMap V.ι P) := by
        rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply]
        by_cases h : S = OpenWeilRestriction.primeDivisorMap V.ι P
        · rw [← h]; simp
        · simp [Finsupp.single_apply, h]
      push_cast at h1' h2 ⊢
      rw [hs] at h1'
      linear_combination h1' - (N : ℚ) * h2
    have hS' := isFGOver_weilSectionAlgebra_mobile hd hF (f ∣_ U) hg hgp hUnv hQV hdimV
      (K.restrictOpen V) hKV SV (B.restrictOpen V)
      (Finsupp.le_def.mpr fun W => Finsupp.le_def.mp hB _)
      (by rwa [DivisorWithCoeffs.coeff_restrictOpen, hSV']) (fun P => hB1 _) hpltV
      (isBirationalMorphism_toImage_restrict hsmall U SV)
      (isNormal_subscheme_of_primeDivisorMap V SV (hSV' ▸ hSn)) hSnegV (Nat.mul_pos hN hr) hc
      φV hrelV' S' hS'0 hS'S ψ⁻¹
      (fun P => by rw [PrimeDivisor.ord_inv, hψc, DivisorWithCoeffs.coeff_sub]; ring) hNoeth
    refine isFGOver_weilSectionAlgebra_of_nsmul_eq hNoeth hN hc (φV * ψ ^ (-(c : ℤ)))
      (fun P => ?_) hS'
    rw [hrelV P, hsingle, PrimeDivisor.ord_mul, PrimeDivisor.ord_zpow, hψc]
    simp only [DivisorWithCoeffs.coeff_smul, smul_eq_mul, nsmul_eq_mul]
    ring
  · refine isFGOver_weilSectionAlgebra_of_nsmul_eq hNoeth hN hc φV (fun P => ?_)
      isFGOver_weilSectionAlgebra_zero
    rw [hrelV P, restrictOpen_single_of_notMem V hSV]

/-- Every point `z : Z` has an affine open neighbourhood `U` over which the divisorial algebra of
`f_*(r K + D_r)` is finitely generated. -/
private theorem exists_isAffineOpen_finiteType
    {d : ℕ} (hd : 2 ≤ d) (hF : BirationalFiniteGenerationProperty d)
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ : IsQFactorial sX)
    {Z : Scheme.{0}} [IsLocallyNoetherian Z] [IsNormal Z] (sZ : Z ⟶ Spec (.of ℂ))
    (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (d + 1))
    {S : MMP.Mori.PrimeDivisor X} {B : QDivisor X} (hB : 0 ≤ B)
    (hfloor : DivisorWithCoeffs.roundDown (Finsupp.single S 1 + B) = Finsupp.single S 1)
    (hplt : IsPltPair sX (d + 1) K (Finsupp.single S 1 + B))
    {R : Set (NumericalCurveClasses sX)}
    (hR : MMP.Mori.IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    {f : X ⟶ Z} (hf : IsContractionOfRay sX sZ R f) (hsmall : IsSmallMorphism sX sZ f)
    (hneg : (-(Divisor.toQDivisor K + (Finsupp.single S 1 + B))).HasRelativelyAmpleMultiple f)
    (hSneg : QDivisor.HasRelativelyAmpleMultiple (-(Finsupp.single S 1 : QDivisor X)) f)
    (r : ℕ) (hr : 0 < r) (Dr : Divisor X)
    (hDr : Divisor.toQDivisor Dr = (r : ℚ) • (Finsupp.single S 1 + B)) (z : Z) :
    ∃ U : Z.Opens, IsAffineOpen U ∧ z ∈ U ∧
      Algebra.FiniteType Γ(Z, U) (Divisor.divisorialAlgebraSections
        (RationalMap.transformDivisor f.toRationalMap (r • K + Dr)) U) := by
  have hZnv := hf.isNormalVariety_target
  haveI : IsIntegral Z := hZnv.isIntegral
  -- the boundary
  have hBS : B.coeff S = 0 := coeff_eq_zero_of_isPltPair hd hB hplt
  have hB1 : ∀ P, B.coeff P < 1 := by
    intro P
    by_cases hP : S = P
    · subst hP; rw [hBS]; norm_num
    · have := congrArg (fun D : Divisor X => DivisorWithCoeffs.coeff D P) hfloor
      rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_add,
        DivisorWithCoeffs.coeff_apply (Finsupp.single S (1 : ℚ)),
        DivisorWithCoeffs.coeff_apply (Finsupp.single S (1 : ℤ)),
        Finsupp.single_eq_of_ne (Ne.symm hP), Finsupp.single_eq_of_ne (Ne.symm hP), zero_add,
        Int.floor_eq_zero_iff] at this
      exact this.2
  have hB0 : B.roundDown = 0 := by
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_roundDown, Finsupp.zero_apply,
      Int.floor_eq_zero_iff]
    exact ⟨Finsupp.le_def.mp hB P, hB1 P⟩
  have hSn : IsNormal S.idealSheaf.subscheme :=
    IsPltPair.isNormal_subscheme_of_isQFactorial hQ hX
      (DivisorWithCoeffs.isEffective_iff_nonneg.mpr hB) hB0 hBS hplt
  -- the proportionality of `K + S + B` and `S`
  have hfF : IsContractionOfFace ℂ sX sZ R f :=
    ⟨hX, hZ, hf.comp_eq, hR.1, hf.isContractedBy_iff, hf.isIso_app⟩
  have hS1 : Divisor.toQDivisor (Finsupp.single S (1 : ℤ)) = Finsupp.single S (1 : ℚ) := by
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
      Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply]
    by_cases h : S = P
    · rw [← h]; simp
    · simp [Finsupp.single_apply, h]
  obtain ⟨a, b, ha, hb, M, hM, hMf, m, hm, φ, hφ⟩ :=
    IsPltPair.exists_qLinearlyEquivalent_add_pullback_of_isContractionOfFace hQ hR hfF hZnv hplt
      hfloor hneg (by rwa [hS1])
  -- an affine neighbourhood of `z` on which `M` is principal
  obtain ⟨W, hzW, ψ, hψ⟩ := hM z
  obtain ⟨U, hU, hzU, hUW⟩ := exists_isAffineOpen_mem_and_subset hzW
  refine ⟨U, hU, hzU, ?_⟩
  obtain ⟨x, rfl⟩ := hf.surjective z
  obtain ⟨χ, hχ⟩ := exists_isLocalEquation_pullback f hM hMf (hψ.mono hUW) (fun Zc => by
    have hZc : Zc.1 = Set.univ :=
      Zc.2.eq_of_le (IrreducibleSpace.isIrreducible_univ _) (Set.subset_univ _)
    exact (MMP.Mori.genericPoint_mem_iff Zc (f ⁻¹ᵁ U)).mpr ⟨x, hzU, hZc ▸ trivial⟩)
  have hcoeff := coeff_nsmul_eq_of_qLinearlyEquivalent hφ hDr hχ
  have hE : Divisor.toQDivisor (r • K + Dr) =
      (r : ℚ) • (Divisor.toQDivisor K + (Finsupp.single S 1 + B)) := by
    rw [map_add, map_nsmul, hDr, ← Nat.cast_smul_eq_nsmul ℚ, ← smul_add]
  exact finiteType_divisorialAlgebraSections_of_nsmul_eq hd hF hQ hK hB hBS hB1 hplt hSn
    hf.isProjectiveMorphism hf.surjective hf.isIso_app hsmall hSneg hr hE U hU ⟨_, hzU⟩
    (Nat.mul_pos hm ha) (Nat.mul_pos (Nat.mul_pos hr hm) hb) _ hcoeff

/-- A `ℚ`-divisor has a positive integral multiple which is integral. -/
private theorem exists_toQDivisor_eq_smul {X : Scheme.{0}} (Δ : QDivisor X) :
    ∃ r : ℕ, 0 < r ∧ ∃ Dr : Divisor X, Divisor.toQDivisor Dr = (r : ℚ) • Δ := by
  obtain ⟨r, hr, Dr, hDr⟩ := MMP.Flips.exists_pos_smul_eq_toQDivisor Δ
  exact ⟨r, hr, Dr, by rw [hDr, ← Int.cast_smul_eq_zsmul ℚ, Int.cast_natCast]⟩

end MMP.Fourfold.PlFlip

end

section

/-!
# Property `F(d)` gives projective pl-flips in dimension `d + 1`

Assume the birational finite-generation property `F(d)` for some `d ≥ 2`. Let `X` and `Z` be
normal projective complex varieties, `X` `ℚ`-factorial of dimension `d + 1`, and let
`f : X ⟶ Z` be the contraction of an extremal ray `R` of `NE̅(X)` which is small. Let
`(X, Δ = S + B)` be a plt pair with `Δ` a `ℚ`-divisor, `S = ⌊Δ⌋` a prime divisor and `B ≥ 0`.
If `-(K_X + Δ)` and `-S` are `f`-ample, then the `(K_X + Δ)`-flip of `f` exists.

The proof writes `a(K_X + Δ) ∼_ℚ bS + f^*M` with `a, b > 0`, works over an affine cover of `Z`,
and reduces the finite generation of the flipping algebra of `K_X + Δ` to that of its restriction
to the normal divisor `S`, which is supplied by `F(d)`.

## Main results

* `MMP.Fourfold.exists_isFlip_of_birationalFiniteGenerationProperty_of_isPltPair`.

## Implementation notes

* The plt condition is `MMP.Mori.IsPltPair` for the canonical divisor `K` of dimension `d + 1`;
  it contains that `K + Δ` is `ℚ`-Cartier. The condition `S = ⌊Δ⌋` is
  `MMP.Mori.DivisorWithCoeffs.roundDown (S + B) = S`, which for `B ≥ 0` says that every
  coefficient of `B` is less than one.
* The contraction of the extremal ray is `MMP.Fourfold.IsContractionOfRay` (a projective
  contraction contracting exactly the curves with class in `R`), and smallness is
  `MMP.Fourfold.IsSmallMorphism`. `f`-ampleness of a `ℚ`-divisor is
  `MMP.Mori.QDivisor.HasRelativelyAmpleMultiple`.
* The flip is `MMP.Mori.IsFlip` for `K`, `Δ`, `f`, `f⁺`, with boundary and canonical divisor on
  `X⁺` the birational transforms `(f⁺)⁻¹_* f_* Δ` and `(f⁺)⁻¹_* f_* K`.

## References

* [C. Hacon, J. McKernan, *Extension theorems and the existence of flips*][HaconMcKernan2007]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace MMP.Mori

namespace MMP.Fourfold

/-- **`F(d)` implies projective pl-flips in dimension `d + 1`.** Assume `F(d)`
(`MMP.Fourfold.BirationalFiniteGenerationProperty d`) with `d ≥ 2`. Let `X`, `Z` be normal
projective complex varieties, `X` `ℚ`-factorial of dimension `d + 1` with canonical divisor `K`,
and let `f : X ⟶ Z` be the contraction of an extremal ray `R` of `NE̅(X)` which is small. Let
`(X, Δ)` be plt, `Δ = S + B` a `ℚ`-divisor with `S` prime, `B ≥ 0` and `⌊Δ⌋ = S`. If
`-(K + Δ)` and `-S` are `f`-ample, then there is a normal variety `X⁺` with a morphism
`f⁺ : X⁺ ⟶ Z` which is the `(K + Δ)`-flip of `f` (`MMP.Mori.IsFlip`). -/
@[mmp "thm_fourfold_f_implies_projective_pl_flip"]
public theorem exists_isFlip_of_birationalFiniteGenerationProperty_of_isPltPair
    {d : ℕ} (hd : 2 ≤ d) (hF : BirationalFiniteGenerationProperty d)
    {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of ℂ)) (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hQ : IsQFactorial sX)
    (hdim : topologicalKrullDim X = d + 1)
    {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of ℂ)) (hZ : MMP.Mori.IsProjectiveVariety ℂ sZ)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX (d + 1))
    {S : MMP.Mori.PrimeDivisor X} {B : QDivisor X} (hB : 0 ≤ B)
    (hfloor : DivisorWithCoeffs.roundDown (Finsupp.single S 1 + B) = Finsupp.single S 1)
    (hplt : IsPltPair sX (d + 1) K (Finsupp.single S 1 + B))
    {R : Set (NumericalCurveClasses sX)}
    (hR : MMP.Mori.IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    {f : X ⟶ Z} (hf : IsContractionOfRay sX sZ R f) (hsmall : IsSmallMorphism sX sZ f)
    (hneg : (-(Divisor.toQDivisor K + (Finsupp.single S 1 + B))).HasRelativelyAmpleMultiple f)
    (hSneg : QDivisor.HasRelativelyAmpleMultiple (-(Finsupp.single S 1 : QDivisor X)) f) :
    ∃ (Xp : Scheme.{0}) (_ : CompactSpace Xp) (_ : IsLocallyNoetherian Xp) (_ : IsNormal Xp)
      (sXp : Xp ⟶ Spec (.of ℂ)) (fp : Xp ⟶ Z),
        IsFlip sX sZ sXp K (Finsupp.single S 1 + B) f fp := by
  have hZn := hf.isNormalVariety_target
  haveI : IsLocallyNoetherian Z := hZn.isLocallyNoetherian
  haveI : IsNormal Z := hZn.isNormal
  haveI : IsIntegral Z := hZn.isIntegral
  haveI : CompactSpace Z := (quasiCompact_iff_compactSpace sZ).mp hZn.1.toQuasiCompact
  have hfc : IsFlippingContraction sX sZ K (Finsupp.single S 1 + B) f :=
    { isNormalVariety_source := hsmall.isNormalVariety_source
      isNormalVariety_target := hsmall.isNormalVariety_target
      comp_eq := hsmall.comp_eq
      isCanonicalDivisor := ⟨d + 1, hK⟩
      isQCartier := hplt.1.2.2
      isProper := hsmall.isProper
      isBirationalMorphism := hsmall.isBirationalMorphism
      two_le_codimension := hsmall.two_le_codimension
      hasRelativelyAmpleMultiple := hneg }
  obtain ⟨r, hr, Dr, hDr⟩ := PlFlip.exists_toQDivisor_eq_smul (Finsupp.single S 1 + B)
  obtain ⟨X', sX', h1, h2, h3, fp, hfp⟩ :=
    (exists_isFlip_iff_finiteType_divisorialAlgebraSections sX sZ K _ f hfc r hr Dr hDr).mpr
      fun V hV => Divisor.finiteType_divisorialAlgebraSections_of_forall_exists _
        (PlFlip.exists_isAffineOpen_finiteType hd hF sX hX hQ sZ hZ hK hB
          hfloor hplt hR hf hsmall hneg hSneg r hr Dr hDr) hV
  exact ⟨X', h1, h2, h3, sX', fp, hfp⟩

end MMP.Fourfold

end
