  obtain ⟨Cs, hCsdef⟩ : ∃ Cs : ℕ → RDivisor Y, ∀ n, Cs n = ofCoeffs F (cs n) := ⟨_, fun _ => rfl⟩
  obtain ⟨Bs, hBsdef⟩ : ∃ Bs : RDivisor Y, Bs = ofCoeffs F bs := ⟨_, rfl⟩
