open CategoryTheory AlgebraicGeometry

namespace MMP.Fourfold

open MMP.Mori MMP.Flips

/-- **Programs for projective real klt threefolds.** Let `g : X ⟶ S` be a morphism of projective
complex varieties, `X` a normal `ℚ`-factorial threefold with canonical divisor `K`, and `(X, B)` a
klt pair with effective real boundary. Then there is a finite `(K + B)`-program over `S` through
projective `ℚ`-factorial real klt threefolds over `S` whose last model `(X_n, B_n)` either has
`K_n + B_n` nef over `S`, or admits the contraction `X_n ⟶ Z` over `S` of a
`(K_n + B_n)`-negative extremal ray of `NE̅(X_n/S)` with `dim Z < dim X_n`. -/
@[mmp "thm_fourfold_projective_real_threefold_program"]
public theorem IsRealKltPair.exists_program_isRelativelyNef_or_isFibreType
    {X S : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)} {g : X ⟶ S} {K : Divisor X}
    {B : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hg : g ≫ sS = sX) (hXQ : IsQFactorial sX) (hdim : topologicalKrullDim X = 3)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n) (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B) :
    ∃ (n : ℕ) (Yi : ℕ → Scheme.{0}) (sYi : ∀ i, Yi i ⟶ Spec (.of ℂ))
      (_ : ∀ i, IsIntegral (Yi i)) (_ : ∀ i, CompactSpace (Yi i))
      (_ : ∀ i, IsLocallyNoetherian (Yi i)) (_ : ∀ i, IsNormal (Yi i)) (πY : ∀ i, Yi i ⟶ S)
      (KY : ∀ i, Divisor (Yi i)) (BY : ∀ i, RDivisor (Yi i))
      (R : ∀ i, Set (RelativeNumericalCurveClasses (modelStr sX sYi i) (modelMap g πY i)))
      (Zi : ℕ → Scheme.{0}) (sZi : ∀ i, Zi i ⟶ Spec (.of ℂ)) (f : ∀ i, modelSeq X Yi i ⟶ Zi i)
      (h : ∀ i, Zi i ⟶ S) (fp : ∀ i, Yi i ⟶ Zi i),
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sX sYi i) ∧ IsQFactorial (modelStr sX sYi i) ∧
          topologicalKrullDim (modelSeq X Yi i) = 3 ∧ modelMap g πY i ≫ sS = modelStr sX sYi i ∧
          IsRealKltPair (modelStr sX sYi i) (divisorSeq B BY i)) ∧
      (∀ i < n,
        IsExtremalRay ℝ (relativeClosedConeOfCurves (modelStr sX sYi i) (modelMap g πY i) :
            Set (RelativeNumericalCurveClasses (modelStr sX sYi i) (modelMap g πY i))) (R i) ∧
          (∀ (Γ : ProperCurve (modelStr sX sYi i)) (hΓ : Γ.IsContractedBy (modelMap g πY i)),
            Γ.relativeClass (modelMap g πY i) hΓ ∈ R i →
            ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (modelSeq X Yi i)) (x : ℝ),
              IsRIntersectionNumber ℂ (modelStr sX sYi i)
                (logCanonicalDivisor (divisorSeq K KY i) (divisorSeq B BY i)) r L Γ x → x < 0) ∧
          IsRelativeContractionOfFace (modelMap g πY i) (R i) (f i) (h i) ∧
          IsNegativeExtremalContraction ℂ (modelStr sX sYi i) (sZi i)
            (logCanonicalDivisor (divisorSeq K KY i) (divisorSeq B BY i)) (f i) ∧
          fp i ≫ h i = πY i ∧
          (((IsBirationalMorphism (f i) ∧ ∃ E : MMP.Mori.PrimeDivisor (modelSeq X Yi i),
                (MMP.Mori.exceptionalSet (f i) : Set (modelSeq X Yi i)) = E.support) ∧
              IsIso (fp i) ∧ (∃ m : ℕ, (KY i).IsCanonicalDivisor (sYi i) m) ∧
              BY i = flipTransform (f i) (fp i) (divisorSeq B BY i)) ∨
            IsRealFlipStep (modelStr sX sYi i) (sZi i) (sYi i) (divisorSeq K KY i)
              (divisorSeq B BY i) (KY i) (BY i) (f i) (fp i))) ∧
      (IsRelativelyNef ℂ (modelStr sX sYi n) (modelMap g πY n)
          (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) ∨
        ∃ (Rn : Set (RelativeNumericalCurveClasses (modelStr sX sYi n) (modelMap g πY n)))
          (Z : Scheme.{0}) (_ : IsIntegral Z) (_ : IsLocallyNoetherian Z) (_ : IsNormal Z)
          (sZ : Z ⟶ Spec (.of ℂ)) (fn : modelSeq X Yi n ⟶ Z) (hn : Z ⟶ S),
          IsExtremalRay ℝ (relativeClosedConeOfCurves (modelStr sX sYi n) (modelMap g πY n) :
              Set (RelativeNumericalCurveClasses (modelStr sX sYi n) (modelMap g πY n))) Rn ∧
            (∀ (Γ : ProperCurve (modelStr sX sYi n)) (hΓ : Γ.IsContractedBy (modelMap g πY n)),
              Γ.relativeClass (modelMap g πY n) hΓ ∈ Rn →
              ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (modelSeq X Yi n)) (x : ℝ),
                IsRIntersectionNumber ℂ (modelStr sX sYi n)
                  (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) r L Γ x →
                x < 0) ∧
            IsRelativeContractionOfFace (modelMap g πY n) Rn fn hn ∧
            MMP.Mori.IsProjectiveVariety ℂ sZ ∧
            IsNegativeExtremalContraction ℂ (modelStr sX sYi n) sZ
              (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) fn ∧
            topologicalKrullDim Z < topologicalKrullDim (modelSeq X Yi n)) :=
              by revert X S sX sS g K B hX hS hg hXQ hdim hK hB0 hB; exact Proof_thm_fourfold_projective_real_threefold_program.solution

end MMP.Fourfold
