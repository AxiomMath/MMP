section

/-
# Finiteness for convergent small klt weak models
Let `X` be a normal projective `ℚ`-factorial complex threefold over a projective variety `S`,
and let `B_i → B` be a convergent sequence of effective real boundaries on `X` supported on
one finite set of prime divisors, with `(X, B)` klt. Suppose that every `(X, B_i)` has a
projective `ℚ`-factorial nef weak model `φ_i : X ⤏ X_i` over `S` which is an isomorphism in
codimension one. Then the nef models `(X_i, (φ_i)_* B_i)` fall into finitely many equivalence
classes: there are finitely many indices `j` such that every `X_i` is equivalent, through
`φ_j ∘ φ_i⁻¹`, to one of the `X_j`.
## Main results
* `MMP.Fourfold.exists_finset_isNefModelEquivalent_of_tendsto`.
## Implementation notes
The weak model `X_i` carries the canonical divisor `(φ_i)_* K_X` and the boundary
`(φ_i)_* B_i`, as in `MMP.Fourfold.IsNefWeakModel`. Convergence `B_i → B` is coefficientwise;
since all the `B_i` are supported on one finite set, this is convergence in the
finite-dimensional real space of divisors on that set. Isomorphism in codimension one means
that neither `φ_i` nor `φ_i⁻¹` contracts a prime divisor; the second half is part of
`MMP.Fourfold.IsNefWeakModel`. The comparison map `X_i ⤏ X_j` is the composite
`φ_j ∘ φ_i⁻¹`, written through partial isomorphisms representing `φ_i` and `φ_j`.
## References
* [J. Kollár et al., *Flips and abundance for algebraic threefolds*][KollarFlips]
-/
open AlgebraicGeometry CategoryTheory TopologicalSpace Filter Topology

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori

/-- **Finiteness for convergent small klt weak models.** Let `X` be a normal projective
`ℚ`-factorial complex threefold with canonical divisor `K`, over a projective variety `S` by
`πX`. Let `B i` be effective real boundaries on `X` supported on a fixed finite set `T` of prime
divisors and converging coefficientwise to `B`, with `(X, B)` klt. Suppose that for every `i`,
`φ i : X ⤏ Z i` is a nef weak model of `(X, B i)` over `S`, with `Z i` `ℚ`-factorial, and that
`φ i` contracts no prime divisor of `X` (so that it is an isomorphism in codimension one).
Then there is a finite set `F` of indices such that every nef model
`(Z i, (φ i)_* K + (φ i)_* (B i))` is equivalent (`MMP.Fourfold.IsNefModelEquivalent`), through
`φ j ∘ (φ i)⁻¹`, to `(Z j, (φ j)_* K + (φ j)_* (B j))` for some `j ∈ F`. -/
private theorem exists_finset_isNefModelEquivalent_of_tendsto
    {X S : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXq : IsQFactorial sX)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 3)
    (hS : MMP.Mori.IsProjectiveVariety ℂ sS) (πX : X ⟶ S) (hπX : πX ≫ sS = sX)
    (B : ℕ → RDivisor X) (B₀ : RDivisor X) (hB : ∀ i, 0 ≤ B i)
    (T : Finset (MMP.Mori.PrimeDivisor X)) (hT : ∀ i, (B i).support ⊆ T)
    (hlim : ∀ P, Tendsto (fun i ↦ (B i).coeff P) atTop (𝓝 (B₀.coeff P)))
    (hklt : IsRealKltPair sX B₀)
    (Z : ℕ → Scheme.{0}) [∀ i, IsIntegral (Z i)] [∀ i, IsLocallyNoetherian (Z i)]
    [∀ i, IsNormal (Z i)] (sZ : ∀ i, Z i ⟶ Spec (.of ℂ)) [∀ i, QuasiCompact (sZ i)]
    (πZ : ∀ i, Z i ⟶ S) (φ : ∀ i, X.RationalMap (Z i))
    (hφ : ∀ i, IsNefWeakModel sX (sZ i) sS πX (πZ i) K (B i) (φ i))
    (hZq : ∀ i, IsQFactorial (sZ i))
    (hsmall : ∀ i (P : MMP.Mori.PrimeDivisor X), ¬ RationalMap.IsExceptional (φ i) P) :
    ∃ F : Finset ℕ, ∀ i, ∃ j ∈ F, ∃ (eᵢ : X.PartialIso (Z i)) (eⱼ : X.PartialIso (Z j)),
      eᵢ.toRationalMap = φ i ∧ eⱼ.toRationalMap = φ j ∧
      IsNefModelEquivalent (sZ i) (sZ j) sS (πZ i) (πZ j)
        (RationalMap.transformDivisor (φ i) K) (RationalMap.transformDivisor (φ i) (B i))
        (RationalMap.transformDivisor (φ j) K) (RationalMap.transformDivisor (φ j) (B j))
        (eᵢ.symm.trans eⱼ).toRationalMap :=
          ThreefoldProgramPort.ConvergentWeakModelsFinite.main_result hX hXq hK hS πX hπX B B₀ hB T hT
            hlim hklt Z sZ πZ φ hφ hZq hsmall

end MMP.Fourfold

end

open CategoryTheory AlgebraicGeometry

namespace Proof_thm_fourfold_projective_real_threefold_program

open MMP.Fourfold MMP.Mori MMP.Flips
open scoped TensorProduct

section Stages

/-- A stage of a program with scaling over `S`: a normal integral scheme over `ℂ` and over `S`,
with a canonical divisor, a real boundary, the `l` components of the scaling divisor and a level
at which the scaled adjoint is nef. -/
private structure Stage (S : Scheme.{0}) (l : ℕ) where
  X : Scheme.{0}
  [isIntegral : IsIntegral X]
  [compactSpace : CompactSpace X]
  [isLocallyNoetherian : IsLocallyNoetherian X]
  [isNormal : IsNormal X]
  sX : X ⟶ Spec (.of ℂ)
  πX : X ⟶ S
  K : Divisor X
  B : RDivisor X
  Hq : Fin l → QDivisor X
  t₀ : ℝ

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

/-- The data of one step from a stage `s`: the next stage, the ray, its contraction and the
morphism from the next model to the contraction target. -/
private structure StepData {S : Scheme.{0}} {l : ℕ} (s : Stage S l) where
  t : Stage S l
  R : Set (RelativeNumericalCurveClasses s.sX s.πX)
  Zs : Scheme.{0}
  sZs : Zs ⟶ Spec (.of ℂ)
  f : s.X ⟶ Zs
  g : Zs ⟶ S
  fp : t.X ⟶ Zs

/-- The stages obtained from `s0` by iterating a choice of steps. -/
private noncomputable def Stage.seq {S : Scheme.{0}} {l : ℕ} (s0 : Stage S l)
    (next : (s : Stage S l) → StepData s) : ℕ → Stage S l
  | 0 => s0
  | i + 1 => (next (Stage.seq s0 next i)).t

/-- The rays of the iterated sequence of steps, indexed as the models of a program. -/
private noncomputable def Stage.progR {S : Scheme.{0}} {l : ℕ} (s0 : Stage S l)
    (next : (s : Stage S l) → StepData s) :
    ∀ i, Set (RelativeNumericalCurveClasses
      (modelStr s0.sX (fun j => (Stage.seq s0 next (j + 1)).sX) i)
      (modelMap s0.πX (fun j => (Stage.seq s0 next (j + 1)).πX) i))
  | 0 => (next s0).R
  | i + 1 => (next (Stage.seq s0 next (i + 1))).R

/-- The contractions of the iterated sequence of steps, indexed as the models of a program. -/
private noncomputable def Stage.progF {S : Scheme.{0}} {l : ℕ} (s0 : Stage S l)
    (next : (s : Stage S l) → StepData s) :
    ∀ i, modelSeq s0.X (fun j => (Stage.seq s0 next (j + 1)).X) i ⟶
      (next (Stage.seq s0 next i)).Zs
  | 0 => (next s0).f
  | i + 1 => (next (Stage.seq s0 next (i + 1))).f

end Stages

section

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

attribute [local instance] Stage.isIntegral Stage.compactSpace Stage.isLocallyNoetherian
  Stage.isNormal

variable {S : Scheme.{0}} (sS : S ⟶ Spec (.of ℂ)) {l : ℕ} (h : Fin l → ℝ)

/-- The scaling divisor `∑ⱼ hⱼ Hⱼ`. -/
private noncomputable def scaling {X : Scheme.{0}} (Hq : Fin l → QDivisor X) : RDivisor X :=
  ∑ j, h j • QDivisor.toRDivisor (Hq j)

/-- A good stage: a projective `ℚ`-factorial klt threefold over `S` with effective boundary,
effective components of the scaling divisor which span `N¹`, scaling coefficients independent
over the coefficients of the boundary, and a positive level at which the scaled pair is klt and
its adjoint nef over `S`. -/
private def IsGood (s : Stage S l) : Prop :=
  MMP.Mori.IsProjectiveVariety ℂ s.sX ∧ IsQFactorial s.sX ∧ s.πX ≫ sS = s.sX ∧
    topologicalKrullDim s.X = 3 ∧ (∃ n : ℕ, s.K.IsCanonicalDivisor s.sX n) ∧ 0 ≤ s.B ∧
    IsRealKltPair s.sX s.B ∧ (∀ j, 0 ≤ s.Hq j) ∧
    (∀ E : RDivisor s.X, IsCartierCombination E → ∃ a : Fin l → ℝ,
      IsNumericallyEquivalentOver ℂ s.sX s.sX E (∑ j, a j • QDivisor.toRDivisor (s.Hq j))) ∧
    LinearIndependent (Subfield.closure (Set.range s.B.coeff)) h ∧
    0 < s.t₀ ∧ IsRealKltPair s.sX (s.B + s.t₀ • scaling h s.Hq) ∧
    IsRelativelyNef ℂ s.sX s.πX (logCanonicalDivisor s.K (s.B + s.t₀ • scaling h s.Hq))

variable {sS h}

/-! ### Values of presentations -/

section Forms

variable {k : Type} [Field k] {X : Scheme.{0}} [CompactSpace X] [IsLocallyNoetherian X]
  [IsNormal X] (sX : X ⟶ Spec (.of k)) [QuasiCompact sX]

/-- The degree form of a Cartier divisor on `N₁(X)`. -/
private noncomputable def degForm (L : Divisor.cartierSubgroup (X := X)) :
    NumericalCurveClasses sX →ₗ[ℝ] ℝ :=
  haveI := (Divisor.mem_cartierSubgroup.mp L.2).isInvertibleModule_divisorialSheaf
  NumericalCurveClasses.degree sX (L : Divisor X).divisorialSheaf

private theorem degForm_numericalClass_cycle (L : Divisor.cartierSubgroup (X := X))
    (C : ProperCurve sX) :
    degForm sX L (OneCycle.numericalClass sX (C.cycle ℝ)) =
      ((L : Divisor X).degreeOn k sX C.ι C.dim_le (Divisor.mem_cartierSubgroup.mp L.2) : ℝ) := by
  unfold degForm
  rw [NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
    ProperCurve.degree_divisorialSheaf]

/-- `L ↦ (z ↦ deg_z 𝒪_X(L))` is additive. -/
private noncomputable def degHom :
    Divisor.cartierSubgroup (X := X) →+ (NumericalCurveClasses sX →ₗ[ℝ] ℝ) where
  toFun := degForm sX
  map_zero' := by
    refine MMP.ProgramBaseChange.linearMap_ext_numericalClass_cycle sX fun C => ?_
    rw [degForm_numericalClass_cycle]
    simp only [LinearMap.zero_apply, Int.cast_eq_zero]
    exact Divisor.degreeOn_zero' k sX C.ι C.dim_le
  map_add' L₁ L₂ := by
    refine MMP.ProgramBaseChange.linearMap_ext_numericalClass_cycle sX fun C => ?_
    rw [LinearMap.add_apply, degForm_numericalClass_cycle, degForm_numericalClass_cycle,
      degForm_numericalClass_cycle]
    have := Divisor.degreeOn_add k sX C.ι C.dim_le (L₁ : Divisor X) (L₂ : Divisor X)
      (Divisor.mem_cartierSubgroup.mp L₁.2) (Divisor.mem_cartierSubgroup.mp L₂.2)
    rw [← Int.cast_add, ← this]
    rfl

/-- The tensor extension `Ca(X) ⊗ ℝ → N₁(X)^*`, `L ⊗ r ↦ r • deg 𝒪_X(L)`. -/
private noncomputable def degTensor :
    Divisor.cartierSubgroup (X := X) ⊗[ℤ] ℝ →+ (NumericalCurveClasses sX →ₗ[ℝ] ℝ) :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun L => AddMonoidHom.mk' (fun r : ℝ => r • degHom sX L)
      fun r s => add_smul r s _) fun L₁ L₂ => by
        ext r : 1
        simp [map_add, smul_add])
    fun n L r => by
      simp [map_zsmul, smul_smul, mul_comm]
      rw [← Int.cast_smul_eq_zsmul ℝ n, smul_smul, mul_comm]

private theorem degTensor_tmul (L : Divisor.cartierSubgroup (X := X)) (r : ℝ) :
    degTensor sX (L ⊗ₜ r) = r • degHom sX L := by
  simp [degTensor]

/-- The value `∑ r_j deg_u 𝒪_X(L_j)` of a presentation. -/
private noncomputable def pval (u : NumericalCurveClasses sX) {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier) : ℝ :=
  ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
    NumericalCurveClasses.degree sX (L j).divisorialSheaf u)

private theorem pval_eq_degTensor (u : NumericalCurveClasses sX) {m : ℕ} (r : Fin m → ℝ)
    (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier) :
    pval sX u r L hL = degTensor sX (∑ j, (⟨L j, Divisor.mem_cartierSubgroup.mpr (hL j)⟩ :
      Divisor.cartierSubgroup (X := X)) ⊗ₜ[ℤ] r j) u := by
  rw [map_sum, LinearMap.sum_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [degTensor_tmul, LinearMap.smul_apply, smul_eq_mul]
  rfl

/-- **The value of a presentation depends only on the divisor.** -/
private theorem pval_eq (u : NumericalCurveClasses sX) {m m' : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} (hL : ∀ j, (L j).IsCartier) {r' : Fin m' → ℝ}
    {L' : Fin m' → Divisor X} (hL' : ∀ j, (L' j).IsCartier)
    (h : ∑ j, r j • Divisor.toRDivisor (L j) = ∑ j, r' j • Divisor.toRDivisor (L' j)) :
    pval sX u r L hL = pval sX u r' L' hL' := by
  rw [pval_eq_degTensor, pval_eq_degTensor,
    sum_tmul_eq_of_sum_smul_eq (fun j => ⟨L j, Divisor.mem_cartierSubgroup.mpr (hL j)⟩) r
      (fun j => ⟨L' j, Divisor.mem_cartierSubgroup.mpr (hL' j)⟩) r' h]

/-- `D` has a presentation by Cartier divisors whose value at `u` is `v`. -/
private def HasVal (D : RDivisor X) (u : NumericalCurveClasses sX) (v : ℝ) : Prop :=
  ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
    D = ∑ j, r j • Divisor.toRDivisor (L j) ∧ pval sX u r L hL = v

variable {sX}

private theorem HasVal.unique {D : RDivisor X} {u : NumericalCurveClasses sX} {v v' : ℝ}
    (h : HasVal sX D u v) (h' : HasVal sX D u v') : v = v' := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  obtain ⟨m', r', L', hL', hD, rfl⟩ := h'
  exact pval_eq sX u hL hL' hD

private theorem hasVal_of_eq {m : ℕ} (r : Fin m → ℝ) (L : Fin m → Divisor X)
    (hL : ∀ j, (L j).IsCartier) (u : NumericalCurveClasses sX) :
    HasVal sX (∑ j, r j • Divisor.toRDivisor (L j)) u (pval sX u r L hL) :=
  ⟨m, r, L, hL, rfl, rfl⟩

private theorem hasVal_cartier {L : Divisor X} (hL : L.IsCartier) (u : NumericalCurveClasses sX) :
    HasVal sX (Divisor.toRDivisor L) u
      (haveI := hL.isInvertibleModule_divisorialSheaf;
        NumericalCurveClasses.degree sX L.divisorialSheaf u) :=
  ⟨1, fun _ => 1, fun _ => L, fun _ => hL, (by simp), (by simp [pval])⟩

private theorem hasVal_zero (u : NumericalCurveClasses sX) : HasVal sX 0 u 0 :=
  ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, (by simp), (by simp [pval])⟩

private theorem HasVal.add {D₁ D₂ : RDivisor X} {u : NumericalCurveClasses sX} {v₁ v₂ : ℝ}
    (h₁ : HasVal sX D₁ u v₁) (h₂ : HasVal sX D₂ u v₂) : HasVal sX (D₁ + D₂) u (v₁ + v₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, rfl, rfl⟩ := h₁
  obtain ⟨m₂, r₂, L₂, hL₂, rfl, rfl⟩ := h₂
  have hL : ∀ j, (Fin.append L₁ L₂ j).IsCartier := fun j =>
    Fin.addCases (motive := fun j => (Fin.append L₁ L₂ j).IsCartier)
      (fun i => by simpa using hL₁ i) (fun i => by simpa using hL₂ i) j
  refine ⟨m₁ + m₂, Fin.append r₁ r₂, Fin.append L₁ L₂, hL, ?_, ?_⟩
  · simp [Fin.sum_univ_add]
  · simp only [pval, Fin.sum_univ_add, Fin.append_left, Fin.append_right]

private theorem HasVal.smul {D : RDivisor X} {u : NumericalCurveClasses sX} {v : ℝ}
    (h : HasVal sX D u v) (c : ℝ) : HasVal sX (c • D) u (c * v) := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  refine ⟨m, c • r, L, hL, ?_, ?_⟩
  · simp [Finset.smul_sum, smul_smul]
  · simp [pval, Finset.mul_sum, mul_assoc]

private theorem HasVal.sum {n : ℕ} {D : Fin n → RDivisor X} {u : NumericalCurveClasses sX}
    {v : Fin n → ℝ} (h : ∀ i, HasVal sX (D i) u (v i)) : HasVal sX (∑ i, D i) u (∑ i, v i) := by
  induction n with
  | zero => simpa using hasVal_zero u
  | succ n ih =>
    rw [Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
    exact (ih fun i => h _).add (h _)

private theorem HasVal.neg {D : RDivisor X} {u : NumericalCurveClasses sX} {v : ℝ}
    (h : HasVal sX D u v) : HasVal sX (-D) u (-v) := by
  simpa using h.smul (-1)

private theorem HasVal.sub {D₁ D₂ : RDivisor X} {u : NumericalCurveClasses sX} {v₁ v₂ : ℝ}
    (h₁ : HasVal sX D₁ u v₁) (h₂ : HasVal sX D₂ u v₂) : HasVal sX (D₁ - D₂) u (v₁ - v₂) := by
  simpa [sub_eq_add_neg] using h₁.add h₂.neg

private theorem HasVal.linear {D : RDivisor X} {u w : NumericalCurveClasses sX} {v v' : ℝ}
    (c : ℝ) (h : HasVal sX D u v) (h' : HasVal sX D w v') :
    HasVal sX D (c • u + w) (c * v + v') := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  have hv' : pval sX w r L hL = v' := (hasVal_of_eq r L hL w).unique h'
  refine ⟨m, r, L, hL, rfl, ?_⟩
  rw [← hv']
  simp only [pval, map_add, map_smul, smul_eq_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun j _ => by ring

private theorem HasVal.finsetSum {ι : Type*} (s : Finset ι) {D : ι → RDivisor X}
    {u : NumericalCurveClasses sX} {v : ι → ℝ} (h : ∀ i ∈ s, HasVal sX (D i) u (v i)) :
    HasVal sX (∑ i ∈ s, D i) u (∑ i ∈ s, v i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using hasVal_zero u
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact (h a (Finset.mem_insert_self a s)).add (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- The degree form of a Cartier divisor on the class of a proper curve is its degree. -/
private theorem degree_numericalClass_cycle {L : Divisor X} (hL : L.IsCartier) (C : ProperCurve sX) :
    (haveI := hL.isInvertibleModule_divisorialSheaf;
      NumericalCurveClasses.degree sX L.divisorialSheaf (OneCycle.numericalClass sX (C.cycle ℝ))) =
      (L.degreeOn k sX C.ι C.dim_le hL : ℝ) := by
  rw [NumericalCurveClasses.degree_numericalClass, OneCycle.degree_cycle,
    ProperCurve.degree_divisorialSheaf]

private theorem HasVal.smul_left {D : RDivisor X} {u : NumericalCurveClasses sX} {v : ℝ}
    (h : HasVal sX D u v) (c : ℝ) : HasVal sX D (c • u) (c * v) := by
  obtain ⟨m, r, L, hL, rfl, rfl⟩ := h
  refine ⟨m, r, L, hL, rfl, ?_⟩
  simp only [pval, map_smul, smul_eq_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- An intersection number is a presentation value on the class of the curve. -/
private theorem IsRIntersectionNumber.hasVal {D : RDivisor X} {m : ℕ} {r : Fin m → ℝ}
    {L : Fin m → Divisor X} {C : ProperCurve sX} {x : ℝ}
    (h : IsRIntersectionNumber k sX D r L C x) :
    HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ)) x := by
  obtain ⟨hL, d, hD, hd, rfl⟩ := h
  refine ⟨m, r, L, hL, hD, Finset.sum_congr rfl fun j _ => ?_⟩
  rw [degree_numericalClass_cycle (hL j),
    ← MMP.Fourfold.Oai4C1.Negativity.eq_degreeOn_of_isCartierIntersectionNumber (hd j)]

/-- A presentation value on the class of a curve is an intersection number. -/
private theorem HasVal.isRIntersectionNumber {D : RDivisor X} {C : ProperCurve sX} {v : ℝ}
    (h : HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ)) v) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X), IsRIntersectionNumber k sX D r L C v := by
  obtain ⟨m, r, L, hL, hD, rfl⟩ := h
  refine ⟨m, r, L, hL, fun j => (L j).degreeOn k sX C.ι C.dim_le (hL j), hD,
    fun j => MMP.Flips.isCartierIntersectionNumber_degreeOn k sX C (L j) (hL j), ?_⟩
  exact Finset.sum_congr rfl fun j _ => by rw [degree_numericalClass_cycle]

/-- Numerically equivalent divisors over `f` have the same value on every curve contracted by
`f`. -/
private theorem HasVal.eq_of_isNumericallyEquivalentOver {Y : Scheme.{0}} {f : X ⟶ Y}
    {E F : RDivisor X} (hEF : IsNumericallyEquivalentOver k sX f E F) {C : ProperCurve sX}
    (hC : C.IsContractedBy f) {v w : ℝ}
    (hE : HasVal sX E (OneCycle.numericalClass sX (C.cycle ℝ)) v)
    (hF : HasVal sX F (OneCycle.numericalClass sX (C.cycle ℝ)) w) : v = w := by
  obtain ⟨m, r, L, hv⟩ := hE.isRIntersectionNumber
  obtain ⟨m', r', L', hw⟩ := hF.isRIntersectionNumber
  exact hEF.2.2 C hC m r L v m' r' L' w hv hw

end Forms

section SingleRayAux

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

private theorem toRDivisor_apply (D : Divisor X) (E : MMP.Mori.PrimeDivisor X) :
    Divisor.toRDivisor D E = (D E : ℝ) := rfl

/-- Every divisor is the sum of its coefficients times its prime components. -/
private theorem eq_sum_smul_single (D : RDivisor X) :
    D = ∑ P ∈ D.support, D P • Divisor.toRDivisor (Finsupp.single P (1 : ℤ)) := by
  classical
  refine Finsupp.ext fun E => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, toRDivisor_apply, Finsupp.single_apply, smul_eq_mul]
  rw [Finset.sum_eq_single E]
  · simp
  · intro P _ hPE
    simp [hPE]
  · intro hE
    simp [Finsupp.notMem_support_iff.mp hE]

end SingleRayAux

section QFactorial

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- On a `ℚ`-factorial variety a prime divisor has a presentation by a Cartier divisor. -/
private theorem exists_hasVal_single (hXQ : IsQFactorial sX) (P : MMP.Mori.PrimeDivisor X)
    (u : NumericalCurveClasses sX) :
    ∃ v, HasVal sX (Divisor.toRDivisor (Finsupp.single P (1 : ℤ))) u v := by
  obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
  set E : Divisor X := (m : ℤ) • Finsupp.single P (1 : ℤ) with hE
  have h := (hasVal_cartier hc u).smul ((m : ℝ)⁻¹)
  have hm' : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : Divisor.toRDivisor (Finsupp.single P (1 : ℤ)) = (m : ℝ)⁻¹ • Divisor.toRDivisor E := by
    rw [hE, map_zsmul, ← Int.cast_smul_eq_zsmul ℝ, smul_smul]
    simp [hm']
  rw [← e] at h
  exact ⟨_, h⟩

/-- On a `ℚ`-factorial variety every `ℝ`-divisor has a presentation by Cartier divisors. -/
private theorem exists_hasVal (hXQ : IsQFactorial sX) (D : RDivisor X)
    (u : NumericalCurveClasses sX) : ∃ v, HasVal sX D u v := by
  choose v hv using fun P => exists_hasVal_single hXQ P u
  have := HasVal.finsetSum D.support fun P _ => (hv P).smul (D P)
  rw [← eq_sum_smul_single D] at this
  exact ⟨_, this⟩

private theorem HasVal.isCartierCombination {D : RDivisor X} {u : NumericalCurveClasses sX}
    {v : ℝ} (h : HasVal sX D u v) : IsCartierCombination D := by
  obtain ⟨m, r, L, hL, rfl, -⟩ := h
  exact ⟨m, r, L, hL, by simp [toRDivisor_eq_mapCoeffs]⟩

end QFactorial

section Flip

/-- A birational projective morphism onto a normal variety which is not an isomorphism
contracts a proper curve. -/
private theorem exists_properCurve_isContractedBy_of_not_isIso {X' Z : Scheme.{0}}
    [IsIntegral X'] [IsLocallyNoetherian X'] {sX' : X' ⟶ Spec (.of ℂ)} [IsProper sX']
    {fp : X' ⟶ Z} [IsProper fp] [IsIntegral Z] [IsNormal Z] (hb : IsBirationalMorphism fp)
    (hni : ¬ IsIso fp) : ∃ C : ProperCurve sX', C.IsContractedBy fp := by
  by_contra hno
  haveI : LocallyQuasiFinite fp := by
    by_contra h
    exact hno (MMP.Mori.exists_properCurve_isContractedBy_of_not_locallyQuasiFinite h)
  haveI : IsFinite fp := IsFinite.of_isProper_of_locallyQuasiFinite fp
  exact hni ((MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso fp
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hb)).2 inferInstance)

end Flip

/-- `ℝ`- or `ℚ`-Cartier combinations are closed under addition. -/
private theorem IsCartierCombination.add' {K : Type*} [Ring K] {X : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] {D₁ D₂ : DivisorWithCoeffs K X}
    (h₁ : IsCartierCombination D₁) (h₂ : IsCartierCombination D₂) :
    IsCartierCombination (D₁ + D₂) := by
  obtain ⟨m₁, r₁, L₁, hL₁, rfl⟩ := h₁
  obtain ⟨m₂, r₂, L₂, hL₂, rfl⟩ := h₂
  refine ⟨m₁ + m₂, Fin.append r₁ r₂, Fin.append L₁ L₂, fun j => ?_, by simp [Fin.sum_univ_add]⟩
  exact Fin.addCases (motive := fun j => (Fin.append L₁ L₂ j).IsCartier)
    (fun i => by simpa using hL₁ i) (fun i => by simpa using hL₂ i) j

/-- On a `ℚ`-factorial variety every `ℚ`-divisor is a `ℚ`-Cartier combination. -/
private theorem isCartierCombination_of_isQFactorial_q {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXQ : IsQFactorial sX)
    (D : QDivisor X) : IsCartierCombination D := by
  induction D using Finsupp.induction_linear with
  | zero => exact ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, by simp⟩
  | add D₁ D₂ h₁ h₂ => exact IsCartierCombination.add' h₁ h₂
  | single P q =>
    obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
    refine ⟨1, fun _ => q / m, fun _ => (m : ℤ) • Finsupp.single P (1 : ℤ), fun _ => hc, ?_⟩
    have hm0 : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
    refine Finsupp.ext fun E => ?_
    simp only [Fin.sum_univ_one, DivisorWithCoeffs.mapCoeffs, Finsupp.smul_apply,
      Finsupp.mapRange_apply, Finsupp.single_apply, smul_eq_mul]
    by_cases hPE : P = E
    · subst hPE
      field_simp
      rw [Finsupp.single_eq_same, Finsupp.single_eq_same]
      push_cast
      ring
    · simp [hPE]

/-! ### Transforms of divisors along a step -/

/-- Partial maps on prime divisors commute with changes of coefficients. -/
private theorem mapPrimeDivisors_mapRange {Y Y' : Scheme.{0}} {R R' : Type*} [AddCommMonoid R]
    [AddCommMonoid R'] (e : R →+ R')
    (φ : MMP.Mori.PrimeDivisor Y → Option (MMP.Mori.PrimeDivisor Y'))
    (D : DivisorWithCoeffs R Y) :
    DivisorWithCoeffs.mapPrimeDivisors φ (Finsupp.mapRange.addMonoidHom e D) =
      Finsupp.mapRange.addMonoidHom e (DivisorWithCoeffs.mapPrimeDivisors φ D) := by
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' h h' => simp only [map_add, h, h']
  | single P r =>
    rw [Finsupp.mapRange.addMonoidHom_apply, Finsupp.mapRange_single,
      DivisorWithCoeffs.mapPrimeDivisors_single, DivisorWithCoeffs.mapPrimeDivisors_single]
    cases φ P <;> simp

/-- The coefficients of the image of a divisor under a partial map on prime divisors lie in any
additive submonoid containing its coefficients. -/
private theorem mapPrimeDivisors_apply_mem {Y Y' : Scheme.{0}} {R : Type*} [AddCommMonoid R]
    (M : AddSubmonoid R) (φ : MMP.Mori.PrimeDivisor Y → Option (MMP.Mori.PrimeDivisor Y'))
    (D : DivisorWithCoeffs R Y) (hD : ∀ P, D P ∈ M) (E : MMP.Mori.PrimeDivisor Y') :
    DivisorWithCoeffs.mapPrimeDivisors φ D E ∈ M := by
  classical
  revert hD
  induction D using Finsupp.induction with
  | zero => intro _; simpa using M.zero_mem
  | single_add a b g ha hb ih =>
    intro hD
    have hga : g a = 0 := Finsupp.notMem_support_iff.mp ha
    have hb' : b ∈ M := by simpa [hga] using hD a
    have hg : ∀ P, g P ∈ M := fun P => by
      by_cases hP : P = a
      · subst hP; simpa [hga] using M.zero_mem
      · simpa [Finsupp.single_apply, Ne.symm hP] using hD P
    rw [map_add, Finsupp.add_apply]
    refine M.add_mem ?_ (ih hg)
    rw [DivisorWithCoeffs.mapPrimeDivisors_single]
    cases φ a with
    | none => simpa using M.zero_mem
    | some E' =>
      change Finsupp.single E' b E ∈ M
      rw [Finsupp.single_apply]
      split_ifs
      exacts [hb', M.zero_mem]

section FlipTransform

variable {X X' Z : Scheme.{0}} (f : X ⟶ Z) (fp : X' ⟶ Z)

/-- The transform of a `ℚ`-divisor, as an `ℝ`-divisor. -/
private theorem flipTransform_toRDivisor (D : QDivisor X) :
    flipTransform f fp (QDivisor.toRDivisor D) = QDivisor.toRDivisor (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, QDivisor.toRDivisor,
    DivisorWithCoeffs.mapCoeffsAddMonoidHom]
  rw [mapPrimeDivisors_mapRange, mapPrimeDivisors_mapRange]

/-- The transform of an integral divisor, as an `ℝ`-divisor. -/
private theorem flipTransform_divisor_toRDivisor (D : Divisor X) :
    flipTransform f fp (Divisor.toRDivisor D) = Divisor.toRDivisor (flipTransform f fp D) := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, Divisor.toRDivisor,
    DivisorWithCoeffs.mapCoeffsAddMonoidHom]
  rw [mapPrimeDivisors_mapRange, mapPrimeDivisors_mapRange]

/-- The transform commutes with real scalars. -/
private theorem flipTransform_smul (c : ℝ) (D : RDivisor X) :
    flipTransform f fp (c • D) = c • flipTransform f fp D := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor, DivisorWithCoeffs.mapPrimeDivisors_smul]

/-- The coefficients of a transform lie in any additive submonoid containing the coefficients of
the divisor. -/
private theorem flipTransform_apply_mem {R : Type*} [AddCommMonoid R] (M : AddSubmonoid R)
    (D : DivisorWithCoeffs R X) (hD : ∀ P, D P ∈ M) (E : MMP.Mori.PrimeDivisor X') :
    flipTransform f fp D E ∈ M := by
  simp only [flipTransform, AddMonoidHom.comp_apply, MMP.Mori.inverseTransformDivisor,
    MMP.Mori.RationalMap.transformDivisor]
  exact mapPrimeDivisors_apply_mem M _ _ (mapPrimeDivisors_apply_mem M _ D hD) E

/-- The transform of an effective divisor is effective. -/
private theorem flipTransform_nonneg {R : Type*} [AddCommMonoid R] [PartialOrder R]
    [IsOrderedAddMonoid R] {D : DivisorWithCoeffs R X} (hD : 0 ≤ D) : 0 ≤ flipTransform f fp D := by
  let M : AddSubmonoid R :=
    { carrier := {x | 0 ≤ x}, add_mem' := fun {a b} (ha : 0 ≤ a) (hb : 0 ≤ b) => add_nonneg ha hb,
      zero_mem' := show (0 : R) ≤ 0 from le_rfl }
  intro E
  exact flipTransform_apply_mem f fp M D (fun P => hD P) E

/-- The transform of a scaling divisor is the scaling divisor of the transforms. -/
private theorem flipTransform_scaling {l : ℕ} (h : Fin l → ℝ) (Hq : Fin l → QDivisor X) :
    flipTransform f fp (scaling h Hq) = scaling h fun j => flipTransform f fp (Hq j) := by
  simp only [scaling, map_sum, flipTransform_smul, flipTransform_toRDivisor]

/-- The field generated by the coefficients of a transform is contained in the field generated by
the coefficients of the divisor. -/
private theorem closure_range_flipTransform_le (B : RDivisor X) :
    Subfield.closure (Set.range (flipTransform f fp B).coeff) ≤
      Subfield.closure (Set.range B.coeff) := by
  rw [Subfield.closure_le]
  rintro _ ⟨P, rfl⟩
  exact flipTransform_apply_mem f fp (Subfield.closure (Set.range B.coeff)).toAddSubmonoid B
    (fun Q => Subfield.subset_closure ⟨Q, rfl⟩) P

end FlipTransform

/-- Linear independence over a field descends to a subfield. -/
private theorem linearIndependent_of_le {l : ℕ} {h : Fin l → ℝ} {F₁ F₂ : Subfield ℝ}
    (hle : F₁ ≤ F₂) (hind : LinearIndependent F₂ h) : LinearIndependent F₁ h := by
  refine Fintype.linearIndependent_iff.mpr fun c hc j => ?_
  have := Fintype.linearIndependent_iff.mp hind (fun i => Subfield.inclusion hle (c i))
    (by
      have e : ∀ x, ((Subfield.inclusion hle (c x) : F₂) : ℝ) = (c x : ℝ) := fun x => rfl
      simpa [Subfield.smul_def, e] using hc) j
  exact Subtype.ext (by simpa using congrArg Subtype.val this)

/-- The scaling divisor of effective components is effective. -/
private theorem scaling_nonneg {X : Scheme.{0}} {l : ℕ} {h : Fin l → ℝ} (hh : ∀ j, 0 < h j)
    {Hq : Fin l → QDivisor X} (hHq : ∀ j, 0 ≤ Hq j) : 0 ≤ scaling h Hq := by
  refine Finset.sum_nonneg fun j _ => smul_nonneg (hh j).le ?_
  intro P
  have := hHq j P
  simp only [QDivisor.toRDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom,
    Finsupp.mapRange.addMonoidHom_apply, Finsupp.mapRange_apply, Finsupp.coe_zero,
    Pi.zero_apply] at this ⊢
  exact Rat.cast_nonneg.mpr this

/-! ### Relative and absolute contractions -/

private theorem residueFieldDegree_pos_ph {V T : Scheme.{0}} {sV : V ⟶ Spec (.of ℂ)}
    {sT : T ⟶ Spec (.of ℂ)} [IsSeparated sT] [LocallyOfFiniteType sT] (u : V ⟶ T)
    (hu : u ≫ sT = sV) (Γ : ProperCurve sV) (h : ¬ Γ.IsContractedBy u) :
    0 < residueFieldDegree u Γ.point := by
  have hnc := Oai4C1.not_exists_range_eq_singleton u Γ h
  set φ := Γ.ι ≫ u with hφdef
  have hφ : φ ≫ sT = Γ.ι ≫ sV := by rw [hφdef, Category.assoc, hu]
  have : IsProper (φ ≫ sT) := hφ ▸ inferInstance
  have hP : IsProper φ := IsProper.of_comp _ sT
  have := Γ.isCurve
  have : AlgebraicGeometry.IsCurve ℂ (φ ≫ sT) := hφ ▸ inferInstance
  have hc : AlgebraicGeometry.IsCurve ℂ (φ.imageι ≫ sT) := isCurve_imageι_comp sT φ hnc
  have : IsIntegral φ.image := hc.toIsIntegral
  have hLφ : LocallyOfFiniteType φ := hP.toLocallyOfFiniteType
  have : QuasiCompact φ := instQuasiCompactOfUniversallyClosed φ
  have : LocallyOfFiniteType φ.toImage := by
    have : LocallyOfFiniteType (φ.toImage ≫ φ.imageι) := by
      rw [Scheme.Hom.toImage_imageι]; exact hLφ
    exact locallyOfFiniteType_of_comp _ φ.imageι
  have : IsDominant φ.toImage := Scheme.instIsDominantToImageOfQuasiCompact φ
  have hdeg : residueFieldDegree u Γ.point = degreeOver φ.toImage := by
    have h1 := residueDegree_comp Γ.ι u (genericPoint Γ.scheme)
    rw [Γ.ι_genericPoint, Stacks.Chow.residueDegree_eq_one_of_isClosedImmersion Γ.ι, mul_one]
      at h1
    have h2 := residueDegree_comp φ.toImage φ.imageι (genericPoint Γ.scheme)
    rw [Scheme.Hom.toImage_imageι,
      Stacks.Chow.residueDegree_eq_one_of_isClosedImmersion φ.imageι,
      one_mul, residueDegree_genericPoint_eq_degreeOver φ.toImage] at h2
    exact h1.symm.trans h2
  rw [hdeg]
  letI := (functionFieldMap φ.toImage).toAlgebra
  have hfin : Module.Finite φ.image.functionField Γ.scheme.functionField :=
    finite_functionField_image sT φ hnc
  have heq : functionFieldMap φ.toImage = dominantFunctionFieldMap φ.toImage :=
    (congrArg CommRingCat.Hom.hom
      (stalkMap_cast_target φ.toImage (genericPoint Γ.scheme)
        (map_genericPoint_of_isDominant φ.toImage))).symm
  rw [degreeOver_eq_finrank φ.toImage heq]
  exact Module.finrank_pos
private theorem pushforward_eq_zero_of_mem_relativeOneCycles {X S : Scheme.{0}}
    {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)} [IsSeparated sS] (π : X ⟶ S)
    (hπ : π ≫ sS = sX) {Z : OneCycle ℝ sX} (hZ : Z ∈ relativeOneCycles sX π) :
    OneCycle.pushforward ℝ sX sS π Z = 0 := by
  rw [relativeOneCycles, Finsupp.mem_supported] at hZ
  rw [OneCycle.pushforward, Finsupp.linearCombination_apply]
  refine Finset.sum_eq_zero fun C hC => ?_
  have := ProperCurve.pushforward_cycle_eq_zero_of_isContractedBy ℝ π hπ C (hZ hC)
  rw [OneCycle.pushforward_cycle] at this
  simp only [this, smul_zero]

/-- **Curves with relative classes are contracted.** Over a projective base `S`, a curve of `X`
numerically equivalent to a relative 1-cycle is contracted to a point: otherwise an ample divisor
of `S` would have positive degree on its push-forward. -/
private theorem isContractedBy_of_numericalClass_eq {X S : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sS : S ⟶ Spec (.of ℂ)} (hS : MMP.Mori.IsProjectiveVariety ℂ sS) (π : X ⟶ S)
    (hπ : π ≫ sS = sX) (C : ProperCurve sX) {Z : OneCycle ℝ sX}
    (hZ : Z ∈ relativeOneCycles sX π)
    (hCZ : OneCycle.numericalClass sX (C.cycle ℝ) = OneCycle.numericalClass sX Z) :
    C.IsContractedBy π := by
  haveI : IsSeparated sS := hS.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sS := hS.toIsVariety.toLocallyOfFiniteType
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sS := hS
  by_contra hnc
  obtain ⟨H, hH⟩ := MMP.Mori.IsProjectiveVariety.exists_isAmple_cartierDivisorSheaf (sX := sS)
  have hpos := MMP.Threefold.Mori.degreeOn_cartierSheaf_pos_of_isAmple hS.toIsVariety H hH
    ⟨π C.point, Oai4C1.isProperCurve_map π hπ C hnc⟩
  have heq := (OneCycle.numericalClass_eq_iff.mp hCZ)
    ((Scheme.Modules.pullback π).obj (MMP.CartierDivisor.sheaf H))
  rw [← OneCycle.degree_pushforward π hπ, ← OneCycle.degree_pushforward π hπ,
    pushforward_eq_zero_of_mem_relativeOneCycles π hπ hZ, map_zero, OneCycle.pushforward_cycle,
    cyclePushforwardOfPoint, dif_pos (Oai4C1.isProperCurve_map π hπ C hnc)] at heq
  have hd := residueFieldDegree_pos_ph π hπ C hnc
  have : OneCycle.degree ℝ sS (MMP.CartierDivisor.sheaf H)
      (Finsupp.single ⟨π C.point, Oai4C1.isProperCurve_map π hπ C hnc⟩
        (residueFieldDegree π C.point : ℝ)) =
      (residueFieldDegree π C.point : ℝ) *
        (degreeOn ℂ sS (ProperCurve.ι ⟨π C.point, Oai4C1.isProperCurve_map π hπ C hnc⟩)
          (ProperCurve.dim_le _) (MMP.CartierDivisor.sheaf H) : ℝ) := by
    rw [OneCycle.degree, Finsupp.linearCombination_single, smul_eq_mul]
    rfl
  rw [this] at heq
  have : (0 : ℝ) < (residueFieldDegree π C.point : ℝ) *
      (degreeOn ℂ sS (ProperCurve.ι ⟨π C.point, Oai4C1.isProperCurve_map π hπ C hnc⟩)
        (ProperCurve.dim_le _) (MMP.CartierDivisor.sheaf H) : ℝ) :=
    mul_pos (by exact_mod_cast hd) (by exact_mod_cast hpos)
  linarith

/-- **The relative contraction of a ray is the absolute contraction of its image.** -/
private theorem isContractionOfFace_image_relativeToAbsolute {X S Zs : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hZp : MMP.Mori.IsProjectiveVariety ℂ sZs) {π : X ⟶ S} (hπ : π ≫ sS = sX)
    {R : Set (RelativeNumericalCurveClasses sX π)}
    (hR : IsExtremalRay ℝ (relativeClosedConeOfCurves sX π :
      Set (RelativeNumericalCurveClasses sX π)) R)
    {f : X ⟶ Zs} {g : Zs ⟶ S} (hcont : IsRelativeContractionOfFace π R f g)
    (hfs : f ≫ sZs = sX) :
    IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX))
        (relativeToAbsolute sX π '' R) ∧
      IsContractionOfFace ℂ sX sZs (relativeToAbsolute sX π '' R) f := by
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
  haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sS := hS
  have hray := isExtremalRay_image_relativeToAbsolute sX sS π hπ hR
  have hinj : Function.Injective (relativeToAbsolute sX π) :=
    (MMP.Mori.existsUnique_isNaturalRelativeMap_and_injective sX π).2 _
      (isNaturalRelativeMap_relativeToAbsolute sX π)
  refine ⟨hray, hX, hZp, hfs, hray.1, fun C => ⟨fun hC => ?_, fun hC => ?_⟩, hcont.isIso_app⟩
  · have hCπ : C.IsContractedBy π := fun z hz => by
      rw [← hcont.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC z hz]
    exact ⟨C.relativeClass π hCπ, (hcont.isContractedBy_iff C hCπ).mp hC, rfl⟩
  · obtain ⟨r, hr, hrC⟩ := hC
    obtain ⟨Z, rfl⟩ := relativeNumericalClass_surjective sX π r
    have hCπ : C.IsContractedBy π :=
      isContractedBy_of_numericalClass_eq hS π hπ C Z.2 hrC.symm
    refine (hcont.isContractedBy_iff C hCπ).mpr ?_
    have : C.relativeClass π hCπ = relativeNumericalClass sX π Z :=
      hinj (hrC.symm ▸ rfl)
    rw [this]; exact hr

/-- A relative contraction of an extremal ray over a projective base which is not birational is of
fibre type. -/
private theorem topologicalKrullDim_lt_of_not_isBirationalMorphism {X S Zs : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX)
    (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hZp : MMP.Mori.IsProjectiveVariety ℂ sZs) {π : X ⟶ S} (hπ : π ≫ sS = sX)
    {R : Set (RelativeNumericalCurveClasses sX π)}
    (hR : IsExtremalRay ℝ (relativeClosedConeOfCurves sX π :
      Set (RelativeNumericalCurveClasses sX π)) R)
    {f : X ⟶ Zs} {g : Zs ⟶ S} (hcont : IsRelativeContractionOfFace π R f g)
    (hfs : f ≫ sZs = sX) (hb : ¬ IsBirationalMorphism f) :
    topologicalKrullDim Zs < topologicalKrullDim X := by
  obtain ⟨hray, hcf⟩ :=
    isContractionOfFace_image_relativeToAbsolute hX hS hZp hπ hR hcont hfs
  rcases (IsContractionOfFace.trichotomy_of_isExtremalRay hXQ hray hcf).1 with h | h | h
  · exact h.dim_lt
  · exact absurd h.isBirationalMorphism hb
  · exact absurd h.isBirationalMorphism hb

private theorem comp_eq_of_isRelativeContractionOfFace {X Zs : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {sX : X ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)} {πX : X ⟶ S}
    {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs} {g : Zs ⟶ S} {L : RDivisor X}
    (hcont : IsRelativeContractionOfFace πX R f g)
    (hneg : IsNegativeExtremalContraction ℂ sX sZs L f) (hπ : πX ≫ sS = sX) :
    g ≫ sS = sZs := by
  have hc := hneg.isContraction
  have h1 : f ≫ g ≫ sS = f ≫ sZs := by
    rw [← Category.assoc, hcont.comp_eq, hπ, hc.comp_eq]
  have : IsIso f.appTop := hc.isIso_app ⊤
  refine ext_of_isAffine ?_
  have h2 := congrArg Scheme.Hom.appTop h1
  simp only [Scheme.Hom.comp_appTop] at h2
  exact (cancel_mono (f.appTop)).mp h2

/-- One step of a program over `S`: a negative extremal ray, its contraction, and a divisorial
contraction or a real flip. -/
private def IsStep {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
    (sX : X ⟶ Spec (.of ℂ)) (sX' : X' ⟶ Spec (.of ℂ)) (sZs : Zs ⟶ Spec (.of ℂ))
    (πX : X ⟶ S) (πX' : X' ⟶ S) (K : Divisor X) (B : RDivisor X) (K' : Divisor X')
    (B' : RDivisor X') (R : Set (RelativeNumericalCurveClasses sX πX)) (f : X ⟶ Zs)
    (g : Zs ⟶ S) (fp : X' ⟶ Zs) : Prop :=
  IsExtremalRay ℝ (relativeClosedConeOfCurves sX πX :
      Set (RelativeNumericalCurveClasses sX πX)) R ∧
    (∀ (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy πX),
      Γ.relativeClass πX hΓ ∈ R →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
        IsRIntersectionNumber ℂ sX (logCanonicalDivisor K B) r L Γ x → x < 0) ∧
    IsRelativeContractionOfFace πX R f g ∧
    IsNegativeExtremalContraction ℂ sX sZs (logCanonicalDivisor K B) f ∧
    fp ≫ g = πX' ∧
    (((IsBirationalMorphism f ∧ ∃ E : MMP.Mori.PrimeDivisor X,
          (MMP.Mori.exceptionalSet f : Set X) = E.support) ∧
        IsIso fp ∧ (∃ m : ℕ, K'.IsCanonicalDivisor sX' m) ∧ B' = flipTransform f fp B) ∨
      IsRealFlipStep sX sZs sX' K B K' B' f fp)

/-- The end of a program at a stage: the contraction over `S` of a negative extremal ray which is
of fibre type. -/
private def IsFibreEnd (s : Stage S l) : Prop :=
  ∃ (Rn : Set (RelativeNumericalCurveClasses s.sX s.πX)) (Z : Scheme.{0}) (_ : IsIntegral Z)
    (_ : IsLocallyNoetherian Z) (_ : IsNormal Z) (sZ : Z ⟶ Spec (.of ℂ)) (fn : s.X ⟶ Z)
    (hn : Z ⟶ S),
    IsExtremalRay ℝ (relativeClosedConeOfCurves s.sX s.πX :
        Set (RelativeNumericalCurveClasses s.sX s.πX)) Rn ∧
      (∀ (Γ : ProperCurve s.sX) (hΓ : Γ.IsContractedBy s.πX), Γ.relativeClass s.πX hΓ ∈ Rn →
        ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.X) (x : ℝ),
          IsRIntersectionNumber ℂ s.sX (logCanonicalDivisor s.K s.B) r L Γ x → x < 0) ∧
      IsRelativeContractionOfFace s.πX Rn fn hn ∧ MMP.Mori.IsProjectiveVariety ℂ sZ ∧
      IsNegativeExtremalContraction ℂ s.sX sZ (logCanonicalDivisor s.K s.B) fn ∧
      topologicalKrullDim Z < topologicalKrullDim s.X

variable (sS h)

/-- A good step from a stage: the next stage is good, the step is a step of the program, the new
level is the nef threshold of the old stage, at which the contracted ray is null and positive for
the scaling divisor, and the scaling components and (for a flip) the canonical divisor are the
transforms of the old ones. -/
private def IsGoodStep (s : Stage S l) (d : StepData s) : Prop :=
  IsGood sS h d.t ∧
    IsStep s.sX d.t.sX d.sZs s.πX d.t.πX s.K s.B d.t.K d.t.B d.R d.f d.g d.fp ∧
    d.t.t₀ ≤ s.t₀ ∧
    IsRelativelyNef ℂ s.sX s.πX (logCanonicalDivisor s.K (s.B + d.t.t₀ • scaling h s.Hq)) ∧
    (∀ (C : ProperCurve s.sX) (hC : C.IsContractedBy s.πX), C.relativeClass s.πX hC ∈ d.R →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.X) (x : ℝ),
        IsRIntersectionNumber ℂ s.sX
          (logCanonicalDivisor s.K (s.B + d.t.t₀ • scaling h s.Hq)) r L C x → x = 0) ∧
    (∀ (C : ProperCurve s.sX) (hC : C.IsContractedBy s.πX), C.relativeClass s.πX hC ∈ d.R →
      ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor s.X) (x : ℝ),
        IsRIntersectionNumber ℂ s.sX (scaling h s.Hq) r L C x → 0 < x) ∧
    (∀ j, d.t.Hq j = flipTransform d.f d.fp (s.Hq j)) ∧
    (IsRealFlipStep s.sX d.sZs d.t.sX s.K s.B d.t.K d.t.B d.f d.fp →
      d.t.K = flipTransform d.f d.fp s.K)

variable {sS h}

/-! ### Picard numbers -/

/-- The contraction target of a step lies over `S` compatibly with the structure morphisms. -/
private theorem comp_eq_of_isStep {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
    {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs}
    {g : Zs ⟶ S} {fp : X' ⟶ Zs} (hstep : IsStep sX sX' sZs πX πX' K B K' B' R f g fp)
    (hπ : πX ≫ sS = sX) : g ≫ sS = sZs := by
  have hneg := hstep.2.2.2.1
  have hc := hneg.isContraction
  have h1 : f ≫ g ≫ sS = f ≫ sZs := by
    rw [← Category.assoc, hstep.2.2.1.comp_eq, hπ, hc.comp_eq]
  have : IsIso f.appTop := hc.isIso_app ⊤
  refine ext_of_isAffine ?_
  have h2 := congrArg Scheme.Hom.appTop h1
  simp only [Scheme.Hom.comp_appTop] at h2
  exact (cancel_mono (f.appTop)).mp h2

/-- The contraction target of a step is a projective variety. -/
private theorem isProjectiveVariety_target_of_isStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
    {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs}
    {g : Zs ⟶ S} {fp : X' ⟶ Zs} (hstep : IsStep sX sX' sZs πX πX' K B K' B' R f g fp)
    (hπ : πX ≫ sS = sX) : MMP.Mori.IsProjectiveVariety ℂ sZs := by
  have hv : AlgebraicGeometry.IsVariety ℂ sZs := hstep.2.2.2.1.isNormalVariety_target.1
  rw [← comp_eq_of_isStep hstep hπ] at hv ⊢
  exact { toIsVariety := hv,
          isProjective := hstep.2.2.1.isProjectiveMorphism.comp hS.isProjective }

/-- **Push-forward of curve classes.** For a surjective morphism `f : X ⟶ Y` of projective complex
varieties, `f_* : N₁(X) ⟶ N₁(Y)` is surjective, so `ρ(Y) ≤ ρ(X)`; if some curve contracted by `f`
has a nonzero class, then `ρ(Y) < ρ(X)`. -/
private theorem picardNumber_le_of_surjective {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hY : MMP.Mori.IsProjectiveVariety ℂ sY) (f : X ⟶ Y) [Surjective f] (hf : f ≫ sY = sX) :
    picardNumber sY ≤ picardNumber sX ∧
      ∀ Γ : ProperCurve sX, Γ.IsContractedBy f → OneCycle.numericalClass sX (Γ.cycle ℝ) ≠ 0 →
        picardNumber sY < picardNumber sX := by
  haveI : IsSeparated sY := hY.toIsVariety.toIsSeparated
  haveI : LocallyOfFiniteType sY := hY.toIsVariety.toLocallyOfFiniteType
  haveI : QuasiCompact sY := hY.toIsVariety.toQuasiCompact
  haveI : LocallyOfFiniteType sX := hX.toIsVariety.toLocallyOfFiniteType
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
  haveI : IsProper f := by subst hf; exact IsProper.of_comp f sY
  set φ := NumericalCurveClasses.pushforward f hf with hφ
  have hspan : ∀ C' : ProperCurve sY,
      OneCycle.numericalClass sY (C'.cycle ℝ) ∈ LinearMap.range φ := by
    intro C'
    obtain ⟨C, hC, -⟩ := ProperCurve.exists_map_eq sX sY f hf C'
    have hnc : ¬ C.IsContractedBy f := by
      intro hc
      subst hf
      refine ProperCurve.not_isProperCurve_of_forall_eq f C (y := f C.point) (fun z => ?_) ?_
      · exact hc _ (C.range_ι ▸ ⟨z, rfl⟩)
      · rw [hC]; exact C'.isProperCurve
    have hd := residueFieldDegree_pos_ph f hf C hnc
    have hC'' : (⟨f C.point, hC ▸ C'.isProperCurve⟩ : ProperCurve sY) = C' := by
      cases C'; simp only [ProperCurve.mk.injEq]; exact hC
    have hpush : φ (OneCycle.numericalClass sX (C.cycle ℝ)) =
        (residueFieldDegree f C.point : ℝ) • OneCycle.numericalClass sY (C'.cycle ℝ) := by
      change OneCycle.numericalClass sY (OneCycle.pushforward ℝ sX sY f (C.cycle ℝ)) = _
      rw [OneCycle.pushforward_cycle, cyclePushforwardOfPoint, dif_pos (hC ▸ C'.isProperCurve),
        hC'', ← map_smul]
      congr 1
      simp [ProperCurve.cycle, Finsupp.smul_single]
    refine ⟨((residueFieldDegree f C.point : ℝ))⁻¹ • OneCycle.numericalClass sX (C.cycle ℝ), ?_⟩
    rw [map_smul, hpush, smul_smul, inv_mul_cancel₀ (by positivity), one_smul]
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨z, rfl⟩ := OneCycle.numericalClass_surjective sY y
    induction z using Finsupp.induction_linear with
    | zero => exact ⟨0, by simp⟩
    | add a b ha hb =>
      obtain ⟨x, hx⟩ := ha
      obtain ⟨x', hx'⟩ := hb
      exact ⟨x + x', by rw [map_add, hx, hx', map_add]⟩
    | single C' a =>
      obtain ⟨x, hx⟩ := hspan C'
      refine ⟨a • x, ?_⟩
      rw [map_smul, hx, ← map_smul]
      congr 1
      simp [ProperCurve.cycle, Finsupp.smul_single]
  have hle : Module.rank ℝ (NumericalCurveClasses sY) ≤ Module.rank ℝ (NumericalCurveClasses sX) :=
    LinearMap.rank_le_of_surjective φ hsurj
  refine ⟨Cardinal.toENat.monotone' hle, fun Γ hΓ hne => ?_⟩
  have hker : OneCycle.numericalClass sX (Γ.cycle ℝ) ∈ LinearMap.ker φ := by
    rw [LinearMap.mem_ker]
    change OneCycle.numericalClass sY (OneCycle.pushforward ℝ sX sY f (Γ.cycle ℝ)) = 0
    rw [ProperCurve.pushforward_cycle_eq_zero_of_isContractedBy ℝ f hf Γ hΓ, map_zero]
  have hfin : picardNumber sX < ⊤ := by
    haveI : AlgebraicGeometry.IsProjectiveVariety ℂ sX := hX
    exact MMP.Mori.picardNumber_lt_top_of_isProjectiveVariety sX
  have hrk := LinearMap.rank_range_add_rank_ker φ
  rw [LinearMap.range_eq_top.mpr hsurj, rank_top] at hrk
  have hker1 : 0 < Module.rank ℝ (LinearMap.ker φ) :=
    rank_pos_iff_exists_ne_zero.mpr ⟨⟨_, hker⟩, fun h => hne (congrArg Subtype.val h)⟩
  have hXfin : Module.rank ℝ (NumericalCurveClasses sX) < Cardinal.aleph0 := by
    unfold picardNumber at hfin
    exact Cardinal.toENat_lt_top.mp hfin
  obtain ⟨a, ha⟩ := Cardinal.lt_aleph0.mp (hle.trans_lt hXfin)
  obtain ⟨b, hb⟩ := Cardinal.lt_aleph0.mp
    (lt_of_le_of_lt (le_add_self.trans_eq hrk) hXfin)
  have hpos : 0 < b := by rw [hb] at hker1; exact_mod_cast hker1
  have hXr : Module.rank ℝ (NumericalCurveClasses sX) = ((a + b : ℕ) : Cardinal) := by
    rw [← hrk, ha, hb, Nat.cast_add]
  unfold picardNumber
  rw [ha, hXr, Cardinal.toENat_nat, Cardinal.toENat_nat]
  exact_mod_cast (by omega : a < a + b)

/-- A curve with numerically trivial class has degree zero against every Cartier divisor. -/
private theorem degreeOn_eq_zero_of_numericalClass_eq_zero {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    (Γ : ProperCurve sX) (hΓ : OneCycle.numericalClass sX (Γ.cycle ℝ) = 0) (L : Divisor X)
    (hL : L.IsCartier) : L.degreeOn ℂ sX Γ.ι Γ.dim_le hL = 0 := by
  haveI := QuasiCompact.compactSpace_of_compactSpace sX
  haveI := hL.isInvertibleModule_divisorialSheaf
  have hmem : Γ.cycle ℝ ∈ OneCycle.numericallyTrivial sX :=
    (Submodule.Quotient.mk_eq_zero _).mp hΓ
  have h := OneCycle.mem_numericallyTrivial.mp hmem L.divisorialSheaf
  rw [OneCycle.degree_cycle, ProperCurve.degree_divisorialSheaf Γ L hL] at h
  exact_mod_cast h

/-- A curve on which an `ℝ`-Cartier divisor is negative has a nonzero numerical class. -/
private theorem numericalClass_ne_zero_of_neg {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    {D : RDivisor X} (hD : IsCartierCombination D) (Γ : ProperCurve sX)
    (hneg : ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX D r L Γ x → x < 0) :
    OneCycle.numericalClass sX (Γ.cycle ℝ) ≠ 0 := by
  intro h0
  obtain ⟨m, r, L, hL, hDL⟩ := hD
  have hDL' : D = ∑ j, r j • Divisor.toRDivisor (L j) := by
    simpa only [MMP.Flips.toRDivisor_eq_mapCoeffs] using hDL
  have hx := MMP.Flips.isRIntersectionNumber_sum_degreeOn ℂ sX Γ r L hL
  rw [← hDL'] at hx
  have := hneg m r L _ hx
  simp only [degreeOn_eq_zero_of_numericalClass_eq_zero Γ h0, Int.cast_zero, mul_zero,
    Finset.sum_const_zero, lt_irrefl] at this

/-- The exceptional prime of a divisorial contraction is covered by contracted curves; in
particular some curve is contracted. -/
private theorem exists_properCurve_isContractedBy_of_divisorial {X Zs : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)} {L : RDivisor X} {f : X ⟶ Zs}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hneg : IsNegativeExtremalContraction ℂ sX sZs L f) (hb : IsBirationalMorphism f)
    {E : MMP.Mori.PrimeDivisor X} (hE : (MMP.Mori.exceptionalSet f : Set X) = E.support) :
    ∃ Γ : ProperCurve sX, Γ.IsContractedBy f := by
  have hXv := hneg.isNormalVariety_source
  have hZv := hneg.isNormalVariety_target
  have : LocallyOfFiniteType sX := hXv.1.toLocallyOfFiniteType
  have : IsProper f := hneg.isContraction.isProper
  have : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  have hGmem : E.genericPoint ∈ E.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  obtain ⟨y, hyE, hyc⟩ := nonempty_inter_closedPoints (Z := E.support) ⟨_, hGmem⟩
    E.idealSheaf.support.isClosed.isLocallyClosed
  have hyEx : y ∈ (MMP.Mori.exceptionalSet f : Set X) := hE ▸ hyE
  obtain ⟨Cs, hCc, hCi, hCd, -, w, hw⟩ :=
    MMP.Mori.exists_isIrreducible_curve_image_eq_singleton_of_mem_exceptionalSet hXv.1 hZv.1 f
      hneg.isContraction.comp_eq hb hneg.isContraction.isIso_app (mem_closedPoints_iff.mp hyc)
      hyEx
  have hgen := hCi.isGenericPoint_genericPoint_closure
  rw [hCc.closure_eq] at hgen
  have hη1 : topologicalKrullDim (curveSubschemeAt hCi.genericPoint) = 1 := by
    rw [MMP.Chow.topologicalKrullDim_curveSubschemeAt_eq, hgen.def, hCd]
  refine ⟨⟨hCi.genericPoint, isProperCurve_of_isProper sX hη1⟩, fun x hx => ?_⟩
  change x ∈ closure {hCi.genericPoint} at hx
  rw [hgen.def] at hx
  have h1 : f x ∈ ({w} : Set Zs) := hw ▸ ⟨x, hx, rfl⟩
  have h2 : f hCi.genericPoint ∈ ({w} : Set Zs) := hw ▸ ⟨_, hgen.mem, rfl⟩
  exact h1.trans h2.symm

/-- A curve contracted by the contraction of a step is negative for `K + B`. -/
private theorem neg_of_isStep {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
    {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs}
    {g : Zs ⟶ S} {fp : X' ⟶ Zs} (hstep : IsStep sX sX' sZs πX πX' K B K' B' R f g fp)
    (Γ : ProperCurve sX) (hΓ : Γ.IsContractedBy f) :
    ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
      IsRIntersectionNumber ℂ sX (logCanonicalDivisor K B) r L Γ x → x < 0 := by
  have hΓS : Γ.IsContractedBy πX := fun z hz => by
    rw [← hstep.2.2.1.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hΓ z hz]
  exact hstep.2.1 Γ hΓS ((hstep.2.2.1.isContractedBy_iff Γ hΓS).mp hΓ)

/-- **A divisorial step lowers the Picard number.** -/
private theorem picardNumber_lt_of_isStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X'] [IsLocallyNoetherian X'] [IsNormal X']
    {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs}
    {g : Zs ⟶ S} {fp : X' ⟶ Zs} (hstep : IsStep sX sX' sZs πX πX' K B K' B' R f g fp)
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hπ : πX ≫ sS = sX)
    (hX' : MMP.Mori.IsProjectiveVariety ℂ sX') (hπ' : πX' ≫ sS = sX')
    (hdiv : (IsBirationalMorphism f ∧ ∃ E : MMP.Mori.PrimeDivisor X,
      (MMP.Mori.exceptionalSet f : Set X) = E.support) ∧ IsIso fp) :
    picardNumber sX' < picardNumber sX := by
  obtain ⟨⟨hb, E, hE⟩, hiso⟩ := hdiv
  have hneg := hstep.2.2.2.1
  have hc := hneg.isContraction
  have hZp := isProjectiveVariety_target_of_isStep hS hstep hπ
  have hfps : fp ≫ sZs = sX' := by
    rw [← comp_eq_of_isStep hstep hπ, ← Category.assoc, hstep.2.2.2.2.1, hπ']
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : IsProper f := hc.isProper
  haveI : Surjective f := Scheme.Hom.surjective_of_isIso_app f hc.isIso_app
  have h1 : picardNumber sX' ≤ picardNumber sZs :=
    (picardNumber_le_of_surjective hZp hX' (inv fp) (by rw [IsIso.inv_comp_eq, hfps])).1
  obtain ⟨Γ, hΓ⟩ := exists_properCurve_isContractedBy_of_divisorial hX hneg hb hE
  have h2 := (picardNumber_le_of_surjective hX hZp f hc.comp_eq).2 Γ hΓ
    (numericalClass_ne_zero_of_neg hneg.isCartierCombination Γ (neg_of_isStep hstep Γ hΓ))
  exact h1.trans_lt h2

private theorem exists_closeds_isIso_of_isSmall_ph {X Z : Scheme.{0}} [IsIntegral X]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
    (hf : MMP.Flips.IsSmall ℂ sZ sX f) :
    ∃ (V : TopologicalSpace.Closeds X) (W : TopologicalSpace.Closeds Z),
      (∀ x ∈ (V : Set X), 2 ≤ Order.coheight x) ∧
      (∀ z ∈ (W : Set Z), 2 ≤ Order.coheight z) ∧ V.compl ≤ f ⁻¹ᵁ W.compl ∧
      IsIso (f ∣_ W.compl) := by
  obtain ⟨V, W, hV, hW, h, hiso⟩ := hf.exists_isIso
  have hV' := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp hV
  have hW' := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp hW
  refine ⟨V, W, hV', hW', h, ?_⟩
  haveI : IsProper f := hf.isProper
  set U := f ⁻¹ᵁ W.compl
  set g := f ∣_ W.compl
  set j := X.homOfLE h
  have hjg : j ≫ g = f.resLE W.compl V.compl h := rfl
  set s := inv (f.resLE W.compl V.compl h) ≫ j
  have hs : s ≫ g = 𝟙 _ := by simp [s, hjg]
  haveI : IsClosedImmersion (s ≫ g) := by rw [hs]; infer_instance
  haveI : IsClosedImmersion s := IsClosedImmersion.of_comp s g
  have hj : j = f.resLE W.compl V.compl h ≫ s := by simp [s]
  haveI : IsClosedImmersion j := by rw [hj]; infer_instance
  have hgen : genericPoint X ∈ (V.compl : Set X) := by
    intro hgV
    have := hV' (genericPoint X) hgV
    rw [Order.coheight_eq_zero.mpr (fun z _ => genericPoint_specializes z)] at this
    exact absurd this (by decide)
  haveI : Nonempty U := ⟨⟨_, h hgen⟩⟩
  have hclopen : IsClopen (Set.range j) :=
    ⟨j.isClosedEmbedding.isClosed_range, j.isOpenEmbedding.isOpen_range⟩
  have hne : (Set.range j).Nonempty := ⟨_, ⟨⟨_, hgen⟩, rfl⟩⟩
  have hrange : Set.range j = Set.univ := (isClopen_iff.mp hclopen).resolve_left hne.ne_empty
  haveI : Surjective j := ⟨Set.range_eq_univ.mp hrange⟩
  haveI : IsIso j := (isIso_iff_isOpenImmersion_and_surjective j).mpr ⟨inferInstance, inferInstance⟩
  have hg : g = inv j ≫ f.resLE W.compl V.compl h := by rw [← hjg]; simp
  change IsIso g
  rw [hg]
  infer_instance

private theorem mem_biregularLocus_of_isSmall_ph {X Z : Scheme.{0}} [IsIntegral X]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} [IsLocallyNoetherian X] [IsNormal X]
    {f : X ⟶ Z} (hf : MMP.Flips.IsSmall ℂ sZ sX f) {z : Z} (hz : Order.coheight z ≤ 1) :
    z ∈ biregularLocus f := by
  obtain ⟨V, W, -, hW, -, hiso⟩ := exists_closeds_isIso_of_isSmall_ph hf
  have hzW : z ∈ (W.compl : Set Z) := fun h => absurd ((hW z h).trans hz) (by decide)
  exact le_biregularLocus hiso hzW

/-- A small contraction maps the generic point of a prime divisor to a point of coheight one,
in its biregular locus. -/
private theorem coheight_map_genericPoint_of_isSmall {X Z : Scheme.{0}} [IsIntegral X]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
    (hf : MMP.Flips.IsSmall ℂ sZ sX f) (P : MMP.Mori.PrimeDivisor X) :
    Order.coheight (f P.genericPoint) = 1 ∧ f P.genericPoint ∈ biregularLocus f := by
  obtain ⟨V, W, hV, -, h, hiso⟩ := exists_closeds_isIso_of_isSmall_ph hf
  have hPV : P.genericPoint ∈ (V.compl : Set X) := fun hP =>
    absurd (hV _ hP) (by rw [P.coheight_genericPoint]; decide)
  have hb : f P.genericPoint ∈ biregularLocus f := le_biregularLocus hiso (h hPV)
  exact ⟨by rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hb,
    P.coheight_genericPoint], hb⟩

/-- **A real flip preserves the Picard number**: `X` and `X⁺` are isomorphic over the open set of
`Z` over which both `f` and `f⁺` are isomorphisms, whose complements have codimension two. -/
private theorem picardNumber_eq_of_isRealFlipStep {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {f : X ⟶ Zs} {fp : X' ⟶ Zs}
    (hfl : IsRealFlipStep sX sZs sX' K B K' B' f fp) (hXQ : IsQFactorial sX)
    (hXp : MMP.Mori.IsProjectiveVariety ℂ sX) (hX'Q : IsQFactorial sX')
    (hX'p : MMP.Mori.IsProjectiveVariety ℂ sX') : picardNumber sX' = picardNumber sX := by
  have hsm := hfl.isSmall
  have hsm' := hfl.isSmall_flip
  have hfs : f ≫ sZs = sX := hsm.comp_eq
  have hfps : fp ≫ sZs = sX' := hsm'.comp_eq
  set U : Zs.Opens := biregularLocus f ⊓ biregularLocus fp with hU
  haveI hUf : IsIso (f ∣_ U) := isBiregular_iff_le_biregularLocus.mpr inf_le_left
  haveI hUfp : IsIso (fp ∣_ U) := isBiregular_iff_le_biregularLocus.mpr inf_le_right
  have hmem : ∀ {Y : Scheme.{0}} [IsIntegral Y] {sY : Y ⟶ Spec (.of ℂ)} {u : Y ⟶ Zs},
      MMP.Flips.IsSmall ℂ sZs sY u → ∀ y : Y, Order.coheight y ≤ 1 → u y ∈ U := by
    intro Y _ sY u hu y hy
    obtain ⟨V₁, W₁, hV₁, -, hle, hiso⟩ := exists_closeds_isIso_of_isSmall_ph hu
    have hyV : y ∈ (V₁.compl : Set Y) := fun h => absurd ((hV₁ y h).trans hy) (by decide)
    have hb : u y ∈ biregularLocus u := le_biregularLocus hiso (hle hyV)
    have hco : Order.coheight (u y) ≤ 1 :=
      (MMP.Positivity.coheight_map_of_mem_biregularLocus u hb).trans_le hy
    exact ⟨mem_biregularLocus_of_isSmall_ph hsm hco, mem_biregularLocus_of_isSmall_ph hsm' hco⟩
  set V : TopologicalSpace.Closeds X := (f ⁻¹ᵁ U).compl with hV
  set W : TopologicalSpace.Closeds X' := (fp ⁻¹ᵁ U).compl with hW
  have hVc : V.compl = f ⁻¹ᵁ U := by ext x; simp [V]
  have hWc : W.compl = fp ⁻¹ᵁ U := by ext x; simp [W]
  have hcod : ∀ {Y : Scheme.{0}} [IsIntegral Y] {sY : Y ⟶ Spec (.of ℂ)} {u : Y ⟶ Zs},
      MMP.Flips.IsSmall ℂ sZs sY u →
        2 ≤ closedsCodimension (u ⁻¹ᵁ U).compl := by
    intro Y _ sY u hu
    rw [MMP.Flips.le_closedsCodimension_iff_le_coheight]
    intro y hy
    by_contra h
    exact hy (hmem hu y (Order.le_of_lt_add_one (by simpa [one_add_one_eq_two] using h)))
  let e : Scheme.Opens.toScheme (X := X) V.compl ≅ Scheme.Opens.toScheme (X := X') W.compl :=
    X.isoOfEq hVc ≪≫ asIso (f ∣_ U) ≪≫ (asIso (fp ∣_ U)).symm ≪≫ X'.isoOfEq hWc.symm
  have he : e.hom ≫ Scheme.Opens.ι (X := X') W.compl ≫ sX' =
      Scheme.Opens.ι (X := X) V.compl ≫ sX := by
    simp only [e, Iso.trans_hom, asIso_hom, Iso.symm_hom, asIso_inv, Category.assoc,
      Scheme.isoOfEq_hom_ι_assoc]
    rw [← hfps, ← hfs, ← morphismRestrict_ι_assoc, IsIso.inv_hom_id_assoc,
      morphismRestrict_ι_assoc, Scheme.isoOfEq_hom_ι_assoc]
  exact (picardNumber_eq_of_isoInCodimOne sX sX' hXQ hXp hX'Q hX'p V W (hcod hsm) (hcod hsm')
    e he).symm

/-- **Picard numbers along a step**: they do not increase, and drop at a divisorial step. -/
private theorem picardNumber_le_of_isGoodStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {s : Stage S l} (hs : IsGood sS h s) {d : StepData s} (hd : IsGoodStep sS h s d) :
    picardNumber d.t.sX ≤ picardNumber s.sX ∧
      (¬ IsRealFlipStep s.sX d.sZs d.t.sX s.K s.B d.t.K d.t.B d.f d.fp →
        picardNumber d.t.sX < picardNumber s.sX) := by
  obtain ⟨hXp, hXQ, hπ, -⟩ := hs
  obtain ⟨⟨hX'p, hX'Q, hπ', -⟩, hst, -⟩ := hd
  rcases hst.2.2.2.2.2 with ⟨hdiv, hiso, -, -⟩ | hfl
  · have hlt := picardNumber_lt_of_isStep hS hst hXp hπ hX'p hπ' ⟨hdiv, hiso⟩
    exact ⟨hlt.le, fun _ => hlt⟩
  · have heq := picardNumber_eq_of_isRealFlipStep hfl hXQ hXp hX'Q hX'p
    exact ⟨heq.le, fun h => absurd hfl h⟩

/-! ### Rays spanned by contracted curves -/

/-- On an extremal ray every element is a nonnegative multiple of a given nonzero element, a
positive one if it is nonzero. -/
private theorem exists_smul_of_isExtremalRay {V : Type*} [AddCommGroup V] [Module ℝ V]
    {N R : Set V} (hR : IsExtremalRay ℝ N R) {w : V} (hw : w ∈ R) (hw0 : w ≠ 0) {u : V}
    (hu : u ∈ R) : ∃ t : ℝ, 0 ≤ t ∧ u = t • w ∧ (u ≠ 0 → 0 < t) := by
  obtain ⟨-, v, -, rfl⟩ := hR
  obtain ⟨c₀, hc₀, rfl⟩ := hw
  obtain ⟨c, hc, rfl⟩ := hu
  have hc₀' : c₀ ≠ 0 := by rintro rfl; exact hw0 (zero_smul _ _)
  refine ⟨c / c₀, div_nonneg hc hc₀, by rw [smul_smul, div_mul_cancel₀ _ hc₀'], fun hu0 => ?_⟩
  have : c ≠ 0 := by rintro rfl; exact hu0 (zero_smul _ _)
  exact div_pos (lt_of_le_of_ne hc (Ne.symm this)) (lt_of_le_of_ne hc₀ (Ne.symm hc₀'))

/-- **From a curve to its ray.** On a `ℚ`-factorial `X`, every `ℝ`-divisor `D` has a presentation
whose value at each point `t [C₀]` of an extremal ray spanned by the class of a curve `C₀` is
`t (D · C₀)`. -/
private theorem exists_presentation_of_mem_ray {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]
    (hXQ : IsQFactorial sX) (D : RDivisor X) {R : Set (NumericalCurveClasses sX)}
    (hR : IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) R)
    (C₀ : ProperCurve sX) (hC₀ : OneCycle.numericalClass sX (C₀.cycle ℝ) ∈ R)
    (hC₀0 : OneCycle.numericalClass sX (C₀.cycle ℝ) ≠ 0) :
    ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
      D = ∑ j, r j • Divisor.toRDivisor (L j) ∧ ∃ x₀ : ℝ,
        (∃ (m' : ℕ) (r' : Fin m' → ℝ) (L' : Fin m' → Divisor X),
          IsRIntersectionNumber ℂ sX D r' L' C₀ x₀) ∧
        ∀ u ∈ R, ∃ t : ℝ, 0 ≤ t ∧ (u ≠ 0 → 0 < t) ∧
          ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf u) = t * x₀ := by
  obtain ⟨v, hv⟩ := exists_hasVal hXQ D (OneCycle.numericalClass sX (C₀.cycle ℝ))
  obtain ⟨m, r, L, hL, hD, -⟩ := id hv
  refine ⟨m, r, L, hL, hD, v, hv.isRIntersectionNumber, fun u hu => ?_⟩
  obtain ⟨t, ht, rfl, htpos⟩ := exists_smul_of_isExtremalRay hR hC₀ hC₀0 hu
  refine ⟨t, ht, htpos, ?_⟩
  have h1 : HasVal sX D (t • OneCycle.numericalClass sX (C₀.cycle ℝ)) (t * v) := hv.smul_left t
  have h2 : HasVal sX D (t • OneCycle.numericalClass sX (C₀.cycle ℝ))
      (pval sX (t • OneCycle.numericalClass sX (C₀.cycle ℝ)) r L hL) := by
    rw [hD]; exact hasVal_of_eq r L hL _
  exact h2.unique h1

/-- A step contracts some curve. -/
private theorem exists_properCurve_isContractedBy_of_isStep {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)}
    {f : X ⟶ Zs} {g : Zs ⟶ S} {fp : X' ⟶ Zs}
    (hst : IsStep sX sX' sZs πX πX' K B K' B' R f g fp) (hX : MMP.Mori.IsProjectiveVariety ℂ sX) :
    ∃ C : ProperCurve sX, C.IsContractedBy f := by
  rcases hst.2.2.2.2.2 with ⟨⟨hb, E, hE⟩, -, -, -⟩ | hfl
  · exact exists_properCurve_isContractedBy_of_divisorial hX hst.2.2.2.1 hb hE
  · have hZv := hst.2.2.2.1.isNormalVariety_target
    haveI : IsIntegral Zs := hZv.1.toIsIntegral
    haveI : IsNormal Zs := hZv.2
    haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
    haveI : IsProper f := isProper_of_isProjectiveMorphism f hfl.isProjectiveMorphism
    exact exists_properCurve_isContractedBy_of_not_isIso hfl.isBirationalMorphism hfl.not_isIso

/-- **The absolute ray of a step.** The image `R` in `N₁(X)` of the relative ray of a step over a
projective base is an extremal ray contracted by the step, spanned by the class of a contracted
curve; a curve with class in `R` is contracted over the base with relative class in the relative
ray. -/
private theorem exists_absoluteRay_of_isStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)}
    {f : X ⟶ Zs} {g : Zs ⟶ S} {fp : X' ⟶ Zs}
    (hst : IsStep sX sX' sZs πX πX' K B K' B' R f g fp) (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hπ : πX ≫ sS = sX) :
    ∃ (Ra : Set (NumericalCurveClasses sX)) (C₀ : ProperCurve sX),
      IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) Ra ∧
      IsContractionOfFace ℂ sX sZs Ra f ∧
      OneCycle.numericalClass sX (C₀.cycle ℝ) ∈ Ra ∧
      OneCycle.numericalClass sX (C₀.cycle ℝ) ≠ 0 ∧
      ∀ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈ Ra →
        ∃ hC : C.IsContractedBy πX, C.relativeClass πX hC ∈ R := by
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  have hZp := isProjectiveVariety_target_of_isStep hS hst hπ
  have hfs : f ≫ sZs = sX := hst.2.2.2.1.isContraction.comp_eq
  obtain ⟨hray, hcf⟩ :=
    isContractionOfFace_image_relativeToAbsolute hX hS hZp hπ hst.1 hst.2.2.1 hfs
  have htr : ∀ C : ProperCurve sX, OneCycle.numericalClass sX (C.cycle ℝ) ∈
      relativeToAbsolute sX πX '' R → ∃ hC : C.IsContractedBy πX, C.relativeClass πX hC ∈ R := by
    intro C hC
    have hCf := (hcf.isContractedBy_iff C).mpr hC
    have hCπ : C.IsContractedBy πX := fun z hz => by
      rw [← hst.2.2.1.comp_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hCf z hz]
    exact ⟨hCπ, (hst.2.2.1.isContractedBy_iff C hCπ).mp hCf⟩
  obtain ⟨C₀, hC₀⟩ := exists_properCurve_isContractedBy_of_isStep hst hX
  have hC₀R := (hcf.isContractedBy_iff C₀).mp hC₀
  refine ⟨_, C₀, hray, hcf, hC₀R, ?_, htr⟩
  obtain ⟨hC₀π, hC₀r⟩ := htr C₀ hC₀R
  exact numericalClass_ne_zero_of_neg hst.2.2.2.1.isCartierCombination C₀ (hst.2.1 C₀ hC₀π hC₀r)

/-- **The class form of curvewise negativity and nullity on the ray of a step.** -/
private theorem exists_presentation_neg_of_isStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)}
    {f : X ⟶ Zs} {g : Zs ⟶ S} {fp : X' ⟶ Zs}
    (hst : IsStep sX sX' sZs πX πX' K B K' B' R f g fp) (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hXQ : IsQFactorial sX) (hπ : πX ≫ sS = sX) (D : RDivisor X) :
    ∃ Ra : Set (NumericalCurveClasses sX),
      IsExtremalRay ℝ (closedConeOfCurves sX : Set (NumericalCurveClasses sX)) Ra ∧
      IsContractionOfFace ℂ sX sZs Ra f ∧
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
        logCanonicalDivisor K B = ∑ j, r j • Divisor.toRDivisor (L j) ∧
          ∀ u ∈ Ra, u ≠ 0 → ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
            NumericalCurveClasses.degree sX (L j).divisorialSheaf u) < 0) ∧
      ((∀ (C : ProperCurve sX) (hC : C.IsContractedBy πX), C.relativeClass πX hC ∈ R →
        ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (x : ℝ),
          IsRIntersectionNumber ℂ sX D r L C x → x = 0) →
        ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor X) (hL : ∀ j, (L j).IsCartier),
          D = ∑ j, r j • Divisor.toRDivisor (L j) ∧
            ∀ u ∈ Ra, ∑ j, r j * (haveI := (hL j).isInvertibleModule_divisorialSheaf
              NumericalCurveClasses.degree sX (L j).divisorialSheaf u) = 0) := by
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  obtain ⟨Ra, C₀, hray, hcf, hC₀, hC₀0, htr⟩ := exists_absoluteRay_of_isStep hS hst hX hπ
  obtain ⟨hC₀π, hC₀r⟩ := htr C₀ hC₀
  refine ⟨Ra, hray, hcf, ?_, fun hnull => ?_⟩
  · obtain ⟨m, r, L, hL, hD, x₀, ⟨m', r', L', hx₀⟩, hval⟩ :=
      exists_presentation_of_mem_ray hXQ (logCanonicalDivisor K B) hray C₀ hC₀ hC₀0
    have hneg := hst.2.1 C₀ hC₀π hC₀r m' r' L' x₀ hx₀
    refine ⟨m, r, L, hL, hD, fun u hu hu0 => ?_⟩
    obtain ⟨t, -, htpos, he⟩ := hval u hu
    rw [he]
    exact mul_neg_of_pos_of_neg (htpos hu0) hneg
  · obtain ⟨m, r, L, hL, hD, x₀, ⟨m', r', L', hx₀⟩, hval⟩ :=
      exists_presentation_of_mem_ray hXQ D hray C₀ hC₀ hC₀0
    have h0 := hnull C₀ hC₀π hC₀r m' r' L' x₀ hx₀
    refine ⟨m, r, L, hL, hD, fun u hu => ?_⟩
    obtain ⟨t, -, -, he⟩ := hval u hu
    rw [he, h0, mul_zero]

/-- **After a flip the threshold drops strictly**: a repeated threshold would give a second
negative null ray, which the independence of the scaling coefficients excludes. -/
private theorem t₀_lt_of_isRealFlipStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hh : ∀ j, 0 < h j) {s : Stage S l} (hs : IsGood sS h s) {d : StepData s}
    (hd : IsGoodStep sS h s d)
    (hfl : IsRealFlipStep s.sX d.sZs d.t.sX s.K s.B d.t.K d.t.B d.f d.fp)
    {d' : StepData d.t} (hd' : IsGoodStep sS h d.t d') : d'.t.t₀ < d.t.t₀ := by
  by_contra hle
  push Not at hle
  have heq : d'.t.t₀ = d.t.t₀ := le_antisymm hd'.2.2.1 hle
  obtain ⟨hXp, hXQ, hπ, -, hK, hB0, hB, -, hspan, hind, -, -, -⟩ := hs
  obtain ⟨hgt, hst, -, -, hnull, -, hHqT, hKT⟩ := hd
  obtain ⟨hX'p, hX'Q, hπ', -, -, -, -, -, -, -, hlam, -, -⟩ := hgt
  obtain ⟨-, hst', -, -, hnull', -, -, -⟩ := hd'
  haveI : QuasiCompact s.sX := hXp.toIsVariety.toQuasiCompact
  haveI : QuasiCompact d.t.sX := hX'p.toIsVariety.toQuasiCompact
  obtain ⟨Ra, hray, hcf, hnegP, hnullP⟩ := exists_presentation_neg_of_isStep hS hst hXp hXQ hπ
    (logCanonicalDivisor s.K (s.B + d.t.t₀ • scaling h s.Hq))
  obtain ⟨Ra', hray', -, hnegP', hnullP'⟩ := exists_presentation_neg_of_isStep hS hst' hX'p hX'Q
    hπ' (logCanonicalDivisor d.t.K (d.t.B + d'.t.t₀ • scaling h d.t.Hq))
  have hneg := hst.2.2.2.1
  haveI : IsProper d.f := hneg.isContraction.isProper
  haveI : Surjective d.f := Scheme.Hom.surjective_of_isIso_app d.f hneg.isContraction.isIso_app
  have hcor : IsContractionOfRay s.sX d.sZs Ra d.f :=
    { isNormalVariety_source := hneg.isNormalVariety_source
      isNormalVariety_target := hneg.isNormalVariety_target
      comp_eq := hneg.isContraction.comp_eq
      isProjectiveMorphism := hfl.isProjectiveMorphism
      surjective := Surjective.surj
      isIso_app := hneg.isContraction.isIso_app
      isContractedBy_iff := hcf.isContractedBy_iff }
  have hsr := (exists_pos_smul_numericalClass_eq_of_linearIndependent (H := s.Hq) (h := h)
    (lam := d.t.t₀) hXp hXQ hK
    (fun j => isCartierCombination_of_isQFactorial_q hXQ (s.Hq j))
    hspan hind hlam).2 hB0 hB hray hnegP (hnullP hnull) hcor hfl hX'p hX'Q Ra' hray' hnegP'
  apply hsr
  have hT : flipTransform d.f d.fp (∑ j, h j • QDivisor.toRDivisor (s.Hq j)) =
      scaling h d.t.Hq := by
    rw [show (∑ j, h j • QDivisor.toRDivisor (s.Hq j)) = scaling h s.Hq from rfl,
      flipTransform_scaling]
    exact congrArg (scaling h) (funext fun j => (hHqT j).symm)
  rw [hT, ← heq]
  exact hnullP' hnull'

section CurveForm

variable {X : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
  {sX : X ⟶ Spec (.of ℂ)} [QuasiCompact sX]

/-- The curve form of a `ℚ`-Cartier `ℚ`-divisor is the value of its presentations. -/
private theorem hasVal_curveForm (D : QDivisor X) (hD : D.IsQCartier)
    (u : NumericalCurveClasses sX) :
    HasVal sX (QDivisor.toRDivisor D) u (QDivisor.curveForm sX D hD u) := by
  have hEc := Divisor.mem_cartierSubgroup.mp (D.cartierIndexSMul hD).2
  have hm := QDivisor.cartierIndex_pos hD
  have hm' : (D.cartierIndex hD : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hE := QDivisor.toQDivisor_cartierIndexSMul D hD
  have hrel : QDivisor.toRDivisor D = ((D.cartierIndex hD : ℝ))⁻¹ •
      Divisor.toRDivisor (D.cartierIndexSMul hD : Divisor X) := by
    refine Finsupp.ext fun P => ?_
    have h1 := congrArg (fun G : QDivisor X => G P) hE
    simp only [Finsupp.smul_apply, zsmul_eq_mul] at h1
    change ((D P : ℚ) : ℝ) = ((D.cartierIndex hD : ℝ))⁻¹ *
      (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℝ)
    have h2 : (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℚ) =
        ((D.cartierIndex hD : ℤ) : ℚ) * D P := h1
    have h3 : (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℝ) =
        (D.cartierIndex hD : ℝ) * ((D P : ℚ) : ℝ) := by
      have := congrArg (fun q : ℚ => (q : ℝ)) h2
      push_cast at this
      exact this
    rw [h3, ← mul_assoc, inv_mul_cancel₀ hm', one_mul]
  have key := (hasVal_cartier hEc u).smul ((D.cartierIndex hD : ℝ))⁻¹
  rw [← hrel] at key
  convert key using 1
  rw [QDivisor.curveForm, QDivisor.associatedCartier, CartierDivisorWithCoeffs.ofCartier,
    Finsupp.smul_single, Finsupp.sum_single_index (by simp)]
  simp [div_eq_inv_mul]

end CurveForm

/-- On a `ℚ`-factorial variety every `ℚ`-divisor is `ℚ`-Cartier. -/
private theorem isQCartier_of_isQFactorial {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hXQ : IsQFactorial sX)
    (D : QDivisor X) : D.IsQCartier := by
  classical
  have hD : D = ∑ P ∈ D.support, D P • Divisor.toQDivisor (Finsupp.single P (1 : ℤ)) := by
    refine Finsupp.ext fun E => ?_
    rw [Finsupp.finset_sum_apply]
    simp only [Finsupp.smul_apply, smul_eq_mul]
    rw [Finset.sum_eq_single E]
    · simp [Divisor.toQDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom]
    · intro P _ hPE
      simp [Divisor.toQDivisor, DivisorWithCoeffs.mapCoeffsAddMonoidHom, Finsupp.single_apply, hPE]
    · intro hE
      simp [Finsupp.notMem_support_iff.mp hE]
  rw [hD]
  refine MMP.Flips.QDivisor.isQCartier_sum _ _ fun P _ =>
    MMP.Flips.QDivisor.IsQCartier.qsmul ?_ _
  obtain ⟨m, hm, hc⟩ := hXQ.2 (Finsupp.single P (1 : ℤ))
  have h1 := MMP.Mori.QDivisor.isQCartier_toQDivisor hc
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : Divisor.toQDivisor (Finsupp.single P (1 : ℤ)) =
      ((m : ℚ))⁻¹ • Divisor.toQDivisor ((m : ℤ) • Finsupp.single P (1 : ℤ)) := by
    rw [map_zsmul, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
    simp [hm']
  rw [e]
  exact MMP.Flips.QDivisor.IsQCartier.qsmul h1 _

/-- **A rational klt witness of a step.** The absolute ray of a step of a real klt pair is
negative for a rational klt boundary: writing `K + B` as a convex combination of `K + Bᵢ` with
rational klt `Bᵢ`, the contracted curve spanning the ray is negative for some `K + Bᵢ`. -/
private theorem exists_isKltPair_isNegativeExtremalRayOf (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X}
    {K' : Divisor X'} {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)}
    {f : X ⟶ Zs} {g : Zs ⟶ S} {fp : X' ⟶ Zs}
    (hst : IsStep sX sX' sZs πX πX' K B K' B' R f g fp) (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hXQ : IsQFactorial sX) (hπ : πX ≫ sS = sX) (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n)
    (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B) :
    ∃ (Ra : Set (NumericalCurveClasses sX)) (Γ : QDivisor X), IsKltPair sX Γ ∧
      IsNegativeExtremalRayOf sX (Divisor.toQDivisor K + Γ) Ra ∧ IsContractionOfFace ℂ sX sZs Ra f := by
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  obtain ⟨Ra, C₀, hray, hcf, hC₀, hC₀0, htr⟩ := exists_absoluteRay_of_isStep hS hst hX hπ
  obtain ⟨n, hKn⟩ := hK
  obtain ⟨s, Bs, r, m, E, hE, hklt, -, hr, -, -, hdec, -, -⟩ :=
    exists_convexCombination_isKltPair_of_isRealKltPair sX hX hXQ K hKn B hB0 hB
  choose v hv using fun i =>
    exists_hasVal hXQ (Divisor.toRDivisor K + QDivisor.toRDivisor (Bs i))
      (OneCycle.numericalClass sX (C₀.cycle ℝ))
  have hsum : HasVal sX (Divisor.toRDivisor K + B) (OneCycle.numericalClass sX (C₀.cycle ℝ))
      (∑ i, r i * v i) := by
    rw [hdec]; exact HasVal.sum fun i => (hv i).smul (r i)
  obtain ⟨hC₀π, hC₀r⟩ := htr C₀ hC₀
  obtain ⟨m', r', L', hx⟩ := hsum.isRIntersectionNumber
  have hneg : ∑ i, r i * v i < 0 := hst.2.1 C₀ hC₀π hC₀r m' r' L' _ hx
  obtain ⟨i, hi⟩ : ∃ i, v i < 0 := by
    by_contra hno
    push Not at hno
    have := Finset.sum_nonneg fun i (_ : i ∈ Finset.univ) => mul_nonneg (hr i).le (hno i)
    linarith
  have hQC := isQCartier_of_isQFactorial hXQ (Divisor.toQDivisor K + Bs i)
  refine ⟨Ra, Bs i, hklt i, ⟨hQC, hray, fun u hu hu0 => ?_⟩, hcf⟩
  obtain ⟨t, -, rfl, htpos⟩ := exists_smul_of_isExtremalRay hray hC₀ hC₀0 hu
  have hc := hasVal_curveForm (Divisor.toQDivisor K + Bs i) hQC
    (OneCycle.numericalClass sX (C₀.cycle ℝ))
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at hc
  have he := hc.unique (hv i)
  rw [map_smul, smul_eq_mul, he]
  exact mul_neg_of_pos_of_neg (htpos hu0) hi

/-- The canonical divisor `(f⁺)⁻¹_* f_* K` after a divisorial contraction `f` with `f⁺` an
isomorphism is a canonical divisor. -/
private theorem isCanonicalDivisor_flipTransform_of_isIso {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {L : RDivisor X} {f : X ⟶ Zs} {fp : X' ⟶ Zs}
    (hneg : IsNegativeExtremalContraction ℂ sX sZs L f) (hb : IsBirationalMorphism f)
    (hX' : MMP.Mori.IsProjectiveVariety ℂ sX') [IsIso fp] (hfps : fp ≫ sZs = sX') {K : Divisor X}
    {n : ℕ} (hK : K.IsCanonicalDivisor sX n) :
    Divisor.IsCanonicalDivisor sX' n (flipTransform f fp K) := by
  have hXv := hneg.isNormalVariety_source
  have hZv := hneg.isNormalVariety_target
  have hX'v : IsNormalVariety ℂ sX' := ⟨hX'.toIsVariety, inferInstance⟩
  haveI : IsIntegral Zs := hZv.1.toIsIntegral
  haveI : IsNormal Zs := hZv.2
  haveI : LocallyOfFiniteType sZs := hZv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Zs := LocallyOfFiniteType.isLocallyNoetherian sZs
  haveI : IsProper f := hneg.isContraction.isProper
  have hfs : f ≫ sZs = sX := hneg.isContraction.comp_eq
  set g : X ⟶ X' := f ≫ inv fp with hgdef
  have hgs : g ≫ sX' = sX := by
    rw [hgdef, ← hfps, Category.assoc, IsIso.inv_hom_id_assoc, hfs]
  haveI : IsProper g := by rw [hgdef]; infer_instance
  have hgb : IsBirationalMorphism g :=
    MMP.Mori.isBirationalMorphism_comp_of_isBirational (inv fp) f
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
        (MMP.Mori.isBirationalMorphism_of_isIso (inv fp)))
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hb)
  haveI : IsDominant g := hgb.isDominant
  haveI : LocallyOfFiniteType sX' := hX'v.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (g ≫ sX') := by rw [hgs]; exact hXv.1.toLocallyOfFiniteType
  have hgv : IsNormalVariety ℂ (g ≫ sX') := by rw [hgs]; exact hXv
  have hdim : topologicalKrullDim X' = n := by
    haveI : MMP.Mori.IsVariety ℂ sX := hXv.1
    haveI : MMP.Mori.IsVariety ℂ sX' := hX'v.1
    rw [MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX' sX hgb]
    exact hK.topologicalKrullDim_eq
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isNormalVariety sX' hX'v hdim
  have hsm : IsSmallMorphism sX' sZs fp :=
    { isNormalVariety_source := hX'v
      isNormalVariety_target := hZv
      comp_eq := hfps
      isProper := inferInstance
      isBirationalMorphism := MMP.Mori.isBirationalMorphism_of_isIso fp
      two_le_codimension := MMP.Flips.le_closedsCodimension_iff_le_coheight.mpr fun x hx => by
        rw [(MMP.Mori.exceptionalSet_eq_bot_iff fp).mpr inferInstance] at hx
        exact absurd hx (by simp) }
  have heq : flipTransform f fp K = RationalMap.transformDivisor (X := X) g.toRationalMap K := by
    refine Finsupp.ext fun P => ?_
    obtain ⟨E, hE, -, htr⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply hX'v hgv hgb P
    rw [htr]
    obtain ⟨Pm, hPm, hfl⟩ := exists_eq_genericPoint_flipTransform_apply hb hsm P E.genericPoint
      (by rw [← hE, hgdef, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (inv fp) fp,
        IsIso.inv_hom_id]; rfl)
    rw [hfl, AlgebraicGeometry.PrimeDivisor.genericPoint_injective hPm.symm]
  rw [heq]
  exact MMP.Fourfold.Oai4C1.Main.isCanonicalDivisor_transformDivisor hX'v hgv hgb hK₀
    (by rw [hgs]; exact hK)

/-- A small birational contraction has exceptional locus of codimension at least two. -/
private theorem two_le_closedsCodimension_exceptionalSet_of_isSmall {X Z : Scheme.{0}}
    [IsIntegral X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {f : X ⟶ Z}
    (hf : MMP.Flips.IsSmall ℂ sZ sX f) :
    2 ≤ closedsCodimension (MMP.Mori.exceptionalSet f) := by
  obtain ⟨V, W, hV, -, h, hiso⟩ := exists_closeds_isIso_of_isSmall_ph hf
  refine MMP.Flips.le_closedsCodimension_iff_le_coheight.mpr fun x hx => ?_
  by_contra hlt
  have hxV : x ∈ (V.compl : Set X) := fun hxV => hlt (hV x hxV)
  exact (MMP.Mori.mem_exceptionalSet.mp hx) (le_biregularLocus hiso (h hxV))

/-- A small birational contraction of normal varieties is a small morphism. -/
private theorem isSmallMorphism_of_isSmall {X Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    {f : X ⟶ Z} (hX : IsNormalVariety ℂ sX) (hZ : IsNormalVariety ℂ sZ)
    (hf : MMP.Flips.IsSmall ℂ sZ sX f) (hb : IsBirationalMorphism f) :
    IsSmallMorphism sX sZ f :=
  { isNormalVariety_source := hX
    isNormalVariety_target := hZ
    comp_eq := hf.comp_eq
    isProper := hf.isProper
    isBirationalMorphism := hb
    two_le_codimension := two_le_closedsCodimension_exceptionalSet_of_isSmall hf }

/-- An `f`-ample Cartier divisor is ample over an affine neighbourhood of every point. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier' {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] {f : Y ⟶ X} {W : Divisor Y}
    (hW : MMP.Flips.IsRelativelyAmpleCartier f W) : W.IsRelativelyAmple f hW.1 := by
  obtain ⟨hWc, hamp⟩ := hW
  have := hWc.isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y)
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- Positive multiples of relatively ample `ℝ`-divisors are relatively ample. -/
private theorem isRelativelyAmple_smul_of_pos {X Y : Scheme.{0}} [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] {f : Y ⟶ X} {A : RDivisor Y} (hA : MMP.Flips.IsRelativelyAmple f A)
    {c : ℝ} (hc : 0 < c) : MMP.Flips.IsRelativelyAmple f (c • A) := by
  obtain ⟨m, r, L, hm, hr, hL, rfl⟩ := hA
  exact ⟨m, c • r, L, hm, fun j => mul_pos hc (hr j), hL, by
    simp only [Finset.smul_sum, smul_smul, Pi.smul_apply, smul_eq_mul]⟩

/-- **A `ℚ`-Cartier `ℚ`-divisor which is ample as an `ℝ`-divisor has an ample multiple.** -/
private theorem hasRelativelyAmpleMultiple_of_isRelativelyAmple {X Z : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsLocallyNoetherian Z] [IsNormal Z]
    {sX : X ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (hZ : IsNormalVariety ℂ sZ) [QuasiCompact sX] (f : X ⟶ Z) [IsProper f] (hf : f ≫ sZ = sX)
    {D : QDivisor X} (hD : D.IsQCartier)
    (hA : MMP.Flips.IsRelativelyAmple f (QDivisor.toRDivisor D)) :
    D.HasRelativelyAmpleMultiple f := by
  have hm := QDivisor.cartierIndex_pos hD
  have hEc := Divisor.mem_cartierSubgroup.mp (D.cartierIndexSMul hD).2
  have hE := QDivisor.toQDivisor_cartierIndexSMul D hD
  have hrel : Divisor.toRDivisor (D.cartierIndexSMul hD : Divisor X) =
      (D.cartierIndex hD : ℝ) • QDivisor.toRDivisor D := by
    refine Finsupp.ext fun P => ?_
    have h1 := congrArg (fun G : QDivisor X => G P) hE
    simp only [Finsupp.smul_apply, zsmul_eq_mul] at h1
    rw [Finsupp.smul_apply, smul_eq_mul]
    change (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℝ) =
      (D.cartierIndex hD : ℝ) * ((D P : ℚ) : ℝ)
    have h2 : (((D.cartierIndexSMul hD : Divisor X) P : ℤ) : ℚ) =
        ((D.cartierIndex hD : ℤ) : ℚ) * D P := h1
    have := congrArg (fun q : ℚ => (q : ℝ)) h2
    push_cast at this
    exact this
  have hamp := (MMP.Flips.relativelyAmple_basics sX sZ hX hZ f hf).2.2.2.2.1 _ hEc
    (by rw [hrel]; exact isRelativelyAmple_smul_of_pos hA (by exact_mod_cast hm))
  exact ⟨D.cartierIndex hD, hm, _, hEc, hE, isRelativelyAmple_of_isRelativelyAmpleCartier' hamp⟩

/-- A real flip of a `ℚ`-factorial projective threefold is a flip for a `ℚ`-divisor. -/
private theorem exists_isFlipOf_of_isRealFlipStep {X X' Zs : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X']
    [IsLocallyNoetherian X'] [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    {sZs : Zs ⟶ Spec (.of ℂ)} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {f : X ⟶ Zs} {fp : X' ⟶ Zs}
    (hfl : IsRealFlipStep sX sZs sX' K B K' B' f fp) (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hXQ : IsQFactorial sX) (hX' : MMP.Mori.IsProjectiveVariety ℂ sX') (hX'Q : IsQFactorial sX')
    (hK' : K' = flipTransform f fp K) :
    ∃ D : QDivisor X, IsFlipOf sX sZs sX' D f fp := by
  classical
  have hneg := hfl.isNegativeExtremalContraction
  have hXv := hneg.isNormalVariety_source
  have hZv := hneg.isNormalVariety_target
  have hX'v : IsNormalVariety ℂ sX' := ⟨hX'.toIsVariety, inferInstance⟩
  haveI : IsIntegral Zs := hZv.1.toIsIntegral
  haveI : IsNormal Zs := hZv.2
  haveI : LocallyOfFiniteType sZs := hZv.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Zs := LocallyOfFiniteType.isLocallyNoetherian sZs
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : QuasiCompact sX' := hX'.toIsVariety.toQuasiCompact
  haveI : IsProper f := hneg.isContraction.isProper
  haveI : IsProper fp := isProper_of_isProjectiveMorphism fp hfl.isProjectiveMorphism_flip
  haveI : Surjective f := Scheme.Hom.surjective_of_isIso_app f hneg.isContraction.isIso_app
  have hfs : f ≫ sZs = sX := hneg.isContraction.comp_eq
  have hfps : fp ≫ sZs = sX' := hfl.isSmall_flip.comp_eq
  let T := B.support
  let e : T → RDivisor X := fun P => Divisor.toRDivisor (Finsupp.single P.1 (1 : ℤ))
  have he : ∀ P, IsCartierCombination (e P) := fun P =>
    (exists_hasVal hXQ (e P) 0).choose_spec.isCartierCombination
  have he' : ∀ P, IsCartierCombination (flipTransform f fp (e P)) := fun P =>
    (exists_hasVal hX'Q (flipTransform f fp (e P)) 0).choose_spec.isCartierCombination
  obtain ⟨δ₁, hδ₁, h₁⟩ := MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul ℂ sX sZs hXv hZv f
    hfs hneg.isRelativelyAntiAmple e he
  obtain ⟨δ₂, hδ₂, h₂⟩ := MMP.Flips.exists_pos_isRelativelyAmple_add_sum_smul ℂ sX' sZs hX'v hZv
    fp hfps hfl.isRelativelyAmple_flip (fun P => flipTransform f fp (e P)) he'
  have hδ : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
  have hq : ∀ P : T, ∃ q : ℚ, |(q : ℝ) - B P| < min δ₁ δ₂ := fun P => by
    obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show B P - min δ₁ δ₂ < B P + min δ₁ δ₂ by linarith)
    exact ⟨q, abs_sub_lt_iff.mpr ⟨by linarith, by linarith⟩⟩
  choose q hq using hq
  let Bq : QDivisor X := ∑ P : T, Finsupp.single P.1 (q P)
  let D : QDivisor X := Divisor.toQDivisor K + Bq
  have hBq : QDivisor.toRDivisor Bq = B + ∑ P : T, ((q P : ℝ) - B P) • e P := by
    refine Finsupp.ext fun E => ?_
    have hL : (QDivisor.toRDivisor Bq) E =
        ∑ P : T, (((Finsupp.single P.1 (q P) : QDivisor X) E : ℚ) : ℝ) := by
      simp only [Bq, map_sum, Finsupp.finset_sum_apply] <;> rfl
    have hR : (B + ∑ P : T, ((q P : ℝ) - B P) • e P) E =
        B E + ∑ P : T, ((q P : ℝ) - B P) *
          (((Finsupp.single P.1 (1 : ℤ) : Divisor X) E : ℤ) : ℝ) := by
      simp only [Finsupp.add_apply, Finsupp.finset_sum_apply, Finsupp.smul_apply, smul_eq_mul]
        <;> rfl
    rw [hL, hR]
    by_cases hE : E ∈ T
    · have hne : ∀ P : T, P ≠ ⟨E, hE⟩ → P.1 ≠ E := fun P hP h => hP (Subtype.ext h)
      rw [Finset.sum_eq_single (⟨E, hE⟩ : T) (fun P _ hP => by simp [Finsupp.single_apply, hne P hP])
          (by simp),
        Finset.sum_eq_single (⟨E, hE⟩ : T) (fun P _ hP => by simp [Finsupp.single_apply, hne P hP])
          (by simp)]
      simp
    · have hB0 : B E = 0 := Finsupp.notMem_support_iff.mp hE
      have hne : ∀ P : T, P.1 ≠ E := fun P h => hE (h ▸ P.2)
      simp [Finsupp.single_apply, hne, hB0]
  have hDR : QDivisor.toRDivisor D =
      logCanonicalDivisor K B + ∑ P : T, ((q P : ℝ) - B P) • e P := by
    simp only [D, map_add, QDivisor.toRDivisor_toQDivisor, hBq, logCanonicalDivisor, add_assoc]
  have hamp1 : MMP.Flips.IsRelativelyAmple f (QDivisor.toRDivisor (-D)) := by
    have := h₁ (fun P => B P - (q P : ℝ)) fun P => by
      rw [abs_sub_comm]; exact (hq P).trans_le (min_le_left _ _)
    convert this using 1
    rw [map_neg, hDR, neg_add, ← Finset.sum_neg_distrib]
    congr 1
    refine Finset.sum_congr rfl fun P _ => ?_
    rw [← neg_smul, neg_sub]
  have hamp2 : MMP.Flips.IsRelativelyAmple fp (QDivisor.toRDivisor (flipTransform f fp D)) := by
    have := h₂ (fun P => (q P : ℝ) - B P) fun P => (hq P).trans_le (min_le_right _ _)
    convert this using 1
    rw [← flipTransform_toRDivisor, hDR]
    simp only [logCanonicalDivisor, map_add, map_sum, flipTransform_smul,
      flipTransform_divisor_toRDivisor, hK', hfl.eq_flipTransform]
  exact ⟨D, isQCartier_of_isQFactorial hXQ D,
    ⟨hXv, hZv, hfs, hfl.isProjectiveMorphism, Surjective.surj, hneg.isContraction.isIso_app⟩,
    isSmallMorphism_of_isSmall hXv hZv hfl.isSmall hfl.isBirationalMorphism,
    hasRelativelyAmpleMultiple_of_isRelativelyAmple hXv hZv f hfs
      (isQCartier_of_isQFactorial hXQ _) hamp1,
    isSmallMorphism_of_isSmall hX'v hZv hfl.isSmall_flip hfl.isBirationalMorphism_flip,
    hfl.isProjectiveMorphism_flip, isQCartier_of_isQFactorial hX'Q _,
    hasRelativelyAmpleMultiple_of_isRelativelyAmple hX'v hZv fp hfps
      (isQCartier_of_isQFactorial hX'Q _) hamp2⟩

/-- **Numerical spanning persists along a step.** -/
private theorem hspan_of_isStep {X X' Zs : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [CompactSpace X'] [IsLocallyNoetherian X']
    [IsNormal X'] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZs : Zs ⟶ Spec (.of ℂ)}
    {πX : X ⟶ S} {πX' : X' ⟶ S} {K : Divisor X} {B : RDivisor X} {K' : Divisor X'}
    {B' : RDivisor X'} {R : Set (RelativeNumericalCurveClasses sX πX)} {f : X ⟶ Zs}
    {g : Zs ⟶ S} {fp : X' ⟶ Zs} (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hstep : IsStep sX sX' sZs πX πX' K B K' B' R f g fp)
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hXQ : IsQFactorial sX) (hπ : πX ≫ sS = sX)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n) (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B)
    (hX' : MMP.Mori.IsProjectiveVariety ℂ sX') (hX'Q : IsQFactorial sX')
    (hK' : K' = flipTransform f fp K) {l : ℕ} (Hq : Fin l → QDivisor X)
    (hspan : ∀ E : RDivisor X, IsCartierCombination E → ∃ a : Fin l → ℝ,
      IsNumericallyEquivalentOver ℂ sX sX E (∑ j, a j • QDivisor.toRDivisor (Hq j))) :
    ∀ E : RDivisor X', IsCartierCombination E → ∃ a : Fin l → ℝ,
      IsNumericallyEquivalentOver ℂ sX' sX' E
        (∑ j, a j • QDivisor.toRDivisor (flipTransform f fp (Hq j))) := by
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  obtain ⟨Ra, Γ, hΓ, hRΓ, hcf⟩ :=
    exists_isKltPair_isNegativeExtremalRayOf hS hstep hX hXQ hπ hK hB0 hB
  have hneg := hstep.2.2.2.1
  have hfs : f ≫ sZs = sX := hneg.isContraction.comp_eq
  haveI : IsProper f := hneg.isContraction.isProper
  haveI : Surjective f := Scheme.Hom.surjective_of_isIso_app f hneg.isContraction.isIso_app
  have hZp := isProjectiveVariety_target_of_isStep hS hstep hπ
  have hcor : IsContractionOfRay sX sZs Ra f :=
    { isNormalVariety_source := hneg.isNormalVariety_source
      isNormalVariety_target := hneg.isNormalVariety_target
      comp_eq := hfs
      isProjectiveMorphism := IsProjectiveMorphism.of_comp f sZs (by rw [hfs]; exact hX.isProjective)
      surjective := Surjective.surj
      isIso_app := hneg.isContraction.isIso_app
      isContractedBy_iff := hcf.isContractedBy_iff }
  have hst' : (IsBirationalMorphism f ∧
      (∃ E : MMP.Mori.PrimeDivisor X, (MMP.Mori.exceptionalSet f : Set X) = E.support) ∧
        IsIso fp) ∨ ∃ D : QDivisor X, IsFlipOf sX sZs sX' D f fp := by
    rcases hstep.2.2.2.2.2 with ⟨⟨hb, hE⟩, hiso, -, -⟩ | hfl
    · exact Or.inl ⟨hb, hE, hiso⟩
    · exact Or.inr (exists_isFlipOf_of_isRealFlipStep hfl hX hXQ hX' hX'Q hK')
  obtain ⟨-, -, -, -, hspanT⟩ :=
    IsKltPair.isNumericallyTrivialOver_flipTransform_of_isContractionOfRay (h := 𝟙 Zs) hΓ hK hX
      hXQ hX' hX'Q hRΓ hcor hst' hZp (Category.id_comp sZs)
  intro E hE
  obtain ⟨a, -, ha⟩ := hspanT l (fun j => QDivisor.toRDivisor (Hq j))
    (fun j => (exists_hasVal hXQ (QDivisor.toRDivisor (Hq j)) 0).choose_spec.isCartierCombination)
    hspan E hE
  exact ⟨a, by simpa only [flipTransform_toRDivisor] using ha⟩

/-- **A good stage which is not nef either ends or takes a good step.** -/
private theorem exists_isGoodStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS) (hh : ∀ j, 0 < h j)
    (s : Stage S l) (hs : IsGood sS h s)
    (hnef : ¬ IsRelativelyNef ℂ s.sX s.πX (logCanonicalDivisor s.K s.B)) :
    IsFibreEnd s ∨ ∃ d : StepData s, IsGoodStep sS h s d := by
  obtain ⟨hXp, hXQ, hπ, hdim, hK, hB0, hB, hHq, hspan, hind, ht₀, hklt₀, hnef₀⟩ := hs
  have hH0 : 0 ≤ scaling h s.Hq := scaling_nonneg hh hHq
  obtain ⟨t, ht, htt, hnef_t, R, Zs, _, _, _, sZs, f, gZ, hR, hRneg, hnull, hpos, hcont, hZp,
    hneg, hbir⟩ :=
    IsRealKltPair.exists_isExtremalRay_of_isRelativelyNef_add_smul hXp hS hπ hXQ hdim hK hB0 hH0
      hklt₀ ht₀ hnef₀ hnef
  have hfs : f ≫ sZs = s.sX := hneg.isContraction.comp_eq
  have hgS : gZ ≫ sS = sZs := comp_eq_of_isRelativeContractionOfFace hcont hneg hπ
  by_cases hb : IsBirationalMorphism f
  swap
  · exact Or.inl ⟨R, Zs, inferInstance, inferInstance, inferInstance, sZs, f, gZ, hR, hRneg,
      hcont, hZp, hneg,
      topologicalKrullDim_lt_of_not_isBirationalMorphism hXp hXQ hS hZp hπ hR hcont hfs hb⟩
  obtain ⟨X', _, _, _, _, sX', fp, hcase, hX'p, hX'Q, hdim', hnef', hklt'⟩ := hbir hb
  refine Or.inr ⟨⟨⟨X', sX', fp ≫ gZ, flipTransform f fp s.K, flipTransform f fp s.B,
    fun j => flipTransform f fp (s.Hq j), t⟩, R, Zs, sZs, f, gZ, fp⟩, ?_⟩
  have hfps : fp ≫ sZs = sX' := by
    rcases hcase with ⟨-, -, h1⟩ | ⟨-, hfl⟩
    · exact h1
    · exact hfl.isSmall_flip.comp_eq
  have hT : flipTransform f fp (s.B + t • scaling h s.Hq) =
      flipTransform f fp s.B + t • scaling h (fun j => flipTransform f fp (s.Hq j)) := by
    rw [map_add, flipTransform_smul, flipTransform_scaling]
  rw [hT] at hnef' hklt'
  have hK' : ∃ m : ℕ, Divisor.IsCanonicalDivisor sX' m (flipTransform f fp s.K) := by
    rcases hcase with ⟨-, hiso, -⟩ | ⟨-, hfl⟩
    · obtain ⟨n, hn⟩ := hK
      haveI := hiso
      exact ⟨n, isCanonicalDivisor_flipTransform_of_isIso hneg hb hX'p hfps hn⟩
    · exact hfl.isCanonicalDivisor_flip
  have hstep : IsStep s.sX sX' sZs s.πX (fp ≫ gZ) s.K s.B (flipTransform f fp s.K)
      (flipTransform f fp s.B) R f gZ fp := by
    refine ⟨hR, hRneg, hcont, hneg, rfl, ?_⟩
    rcases hcase with ⟨hE, hiso, -⟩ | ⟨-, hfl⟩
    · exact Or.inl ⟨⟨hb, hE⟩, hiso, hK', rfl⟩
    · exact Or.inr hfl
  have hB'0 : 0 ≤ flipTransform f fp s.B := flipTransform_nonneg f fp hB0
  have hHq' : ∀ j, 0 ≤ flipTransform f fp (s.Hq j) := fun j => flipTransform_nonneg f fp (hHq j)
  have hH'0 : 0 ≤ scaling h fun j => flipTransform f fp (s.Hq j) := scaling_nonneg hh hHq'
  refine ⟨⟨hX'p, hX'Q, by rw [Category.assoc, hgS, hfps], hdim', hK', hB'0,
    IsRealKltPair.of_le hX'Q (fun P => ?_) hklt',
    hHq', hspan_of_isStep hS hstep hXp hXQ hπ hK hB0 hB hX'p hX'Q rfl s.Hq hspan,
    linearIndependent_of_le (closure_range_flipTransform_le f fp s.B) hind, ht, hklt', hnef'⟩,
    hstep, htt, hnef_t, hnull, hpos, fun j => rfl, fun _ => rfl⟩
  have := mul_nonneg ht.le (hH'0 P)
  simp only [DivisorWithCoeffs.coeff_apply, Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply,
    Pi.smul_apply, smul_eq_mul]
  linarith

/-! ### Towers of models dominating a chain -/

section Tower

/-- A composite of proper birational morphisms onto normal integral schemes is birational. -/
private theorem isBirationalMorphism_comp_ph {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] [IsNormal Y] [IsNormal Z] [IsLocallyNoetherian Y] [IsLocallyNoetherian Z]
    (p : X ⟶ Y) (f : Y ⟶ Z) [IsProper p] [IsProper f] (hp : IsBirationalMorphism p)
    (hf : IsBirationalMorphism f) : IsBirationalMorphism (p ≫ f) :=
  MMP.Mori.isBirationalMorphism_comp_of_isBirational f p
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hf)
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hp)

/-- **A smooth projective model dominating a sequence of elementary steps.** For models
`M₀, …, M_n` and steps `M_i ⟶ Z_i ⟵ M_{i+1}` of proper birational morphisms of normal projective
complex varieties, there is a smooth projective variety `W` with projective birational morphisms
`p_i : W ⟶ M_i`, `i ≤ m`, commuting with the steps. -/
private theorem exists_tower_ph {M : ℕ → Scheme.{0}} [∀ i, IsIntegral (M i)]
    [∀ i, IsLocallyNoetherian (M i)] [∀ i, IsNormal (M i)] {Z : ℕ → Scheme.{0}}
    (s : ∀ i, M i ⟶ Spec (.of ℂ)) (sZ : ∀ i, Z i ⟶ Spec (.of ℂ)) (f : ∀ i, M i ⟶ Z i)
    (fp : ∀ i, M (i + 1) ⟶ Z i) (n : ℕ)
    (hM : ∀ i ≤ n, MMP.Mori.IsProjectiveVariety ℂ (s i))
    (hZ : ∀ i < n, IsNormalVariety ℂ (sZ i))
    (hf : ∀ i < n, IsProper (f i) ∧ IsBirationalMorphism (f i) ∧ f i ≫ sZ i = s i)
    (hfp : ∀ i < n, IsProper (fp i) ∧ IsBirationalMorphism (fp i) ∧ fp i ≫ sZ i = s (i + 1)) :
    ∀ m ≤ n, ∃ (W : Scheme.{0}) (_ : IsIntegral W) (_ : IsLocallyNoetherian W) (_ : IsNormal W)
      (_ : CompactSpace W) (sW : W ⟶ Spec (.of ℂ)) (p : ∀ i, i ≤ m → (W ⟶ M i)),
      MMP.Mori.IsVariety ℂ sW ∧ IsSmoothScheme sW ∧ MMP.Mori.IsProjectiveVariety ℂ sW ∧
      (∀ i (hi : i ≤ m), p i hi ≫ s i = sW ∧ IsProjectiveMorphism (p i hi) ∧
        IsBirationalMorphism (p i hi)) ∧
      ∀ i (hi : i < m), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i := by
  intro m
  induction m with
  | zero =>
    intro _
    have hM0 := (MMP.Mori.isProjectiveVariety_iff ℂ _).mp (hM 0 (Nat.zero_le n))
    haveI : AlgebraicGeometry.IsVariety ℂ (s 0) := hM0.1
    have hX0 : IsNormalVariety ℂ (𝟙 (M 0) ≫ s 0) := by
      rw [Category.id_comp]; exact ⟨hM0.1, inferInstance⟩
    obtain ⟨W, w, hW, hwb, -, hsm, hwp, -, -, hproj⟩ :=
      MMP.Resolution.exists_isSmoothScheme_isProjectiveMorphism_forall_valuation_eq (k := ℂ)
        (s 0) (ι := Unit) (X := fun _ => M 0) (fun _ => 𝟙 (M 0))
        (fun _ => isBirationalMorphism_of_isIso _) (fun _ => hX0) (κ := Empty) Empty.elim
        (fun j => j.elim)
    haveI : IsIntegral W := hW.1.toIsIntegral
    haveI : LocallyOfFiniteType (w ≫ s 0) := hW.1.toLocallyOfFiniteType
    haveI : QuasiCompact (w ≫ s 0) := hW.1.toQuasiCompact
    haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian (w ≫ s 0)
    haveI : IsNormal W := hW.2
    haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace (w ≫ s 0)
    refine ⟨W, inferInstance, inferInstance, inferInstance, inferInstance, w ≫ s 0,
      fun i hi => match i, hi with | 0, _ => w, hW.1, hsm, hproj (hM 0 (Nat.zero_le n)),
      fun i hi => ?_, fun i hi => absurd hi (Nat.not_lt_zero i)⟩
    obtain rfl : i = 0 := Nat.le_zero.mp hi
    exact ⟨rfl, hwp, hwb⟩
  | succ m ih =>
    intro hm
    obtain ⟨W, _, _, _, _, sW, p, hWv, hWsm, hWproj, hp, hpq⟩ := ih (by omega)
    obtain ⟨hfP, hfB, hfs⟩ := hf m hm
    obtain ⟨hfpP, hfpB, hfps⟩ := hfp m hm
    have hZm := hZ m hm
    haveI : AlgebraicGeometry.IsVariety ℂ (sZ m) := hZm.1
    haveI : IsNormal (Z m) := hZm.2
    haveI : IsIntegral (Z m) := hZm.1.toIsIntegral
    haveI : LocallyOfFiniteType (sZ m) := hZm.1.toLocallyOfFiniteType
    haveI : IsLocallyNoetherian (Z m) := LocallyOfFiniteType.isLocallyNoetherian (sZ m)
    haveI := hfP
    haveI := hfpP
    obtain ⟨hpm, hpmP, hpmB⟩ := hp m le_rfl
    haveI : IsProper (p m le_rfl) := isProper_of_isProjectiveMorphism _ hpmP
    have hMm1 := (MMP.Mori.isProjectiveVariety_iff ℂ _).mp (hM (m + 1) hm)
    let T : Bool → Scheme.{0} := fun b => cond b W (M (m + 1))
    let F : ∀ b, T b ⟶ Z m := fun b =>
      Bool.rec (motive := fun b => T b ⟶ Z m) (fp m) (p m le_rfl ≫ f m) b
    haveI hFP : ∀ b, IsProper (F b) := fun b => by
      cases b
      · exact hfpP
      · exact (inferInstance : IsProper (p m le_rfl ≫ f m))
    have hFB : ∀ b, IsBirationalMorphism (F b) := fun b => by
      cases b
      · exact hfpB
      · change IsBirationalMorphism (p m le_rfl ≫ f m)
        exact isBirationalMorphism_comp_ph _ _ hpmB hfB
    have hFN : ∀ b, IsNormalVariety ℂ (F b ≫ sZ m) := fun b => by
      cases b
      · change IsNormalVariety ℂ (fp m ≫ sZ m)
        rw [hfps]
        exact ⟨hMm1.1, inferInstance⟩
      · change IsNormalVariety ℂ ((p m le_rfl ≫ f m) ≫ sZ m)
        rw [Category.assoc, hfs, hpm]
        exact ⟨hWv, inferInstance⟩
    obtain ⟨W', w, hW', hwb, g, hsm, hwp, hg, -, -⟩ :=
      MMP.Resolution.exists_isSmoothScheme_isProjectiveMorphism_forall_valuation_eq (k := ℂ)
        (sZ m) (ι := Bool) (X := T) F hFB hFN (κ := Empty) Empty.elim (fun j => j.elim)
    haveI : IsIntegral W' := hW'.1.toIsIntegral
    haveI : LocallyOfFiniteType (w ≫ sZ m) := hW'.1.toLocallyOfFiniteType
    haveI : QuasiCompact (w ≫ sZ m) := hW'.1.toQuasiCompact
    haveI : IsLocallyNoetherian W' := LocallyOfFiniteType.isLocallyNoetherian (w ≫ sZ m)
    haveI : IsNormal W' := hW'.2
    haveI : CompactSpace W' := QuasiCompact.compactSpace_of_compactSpace (w ≫ sZ m)
    obtain ⟨hg1, hg1P, hg1B⟩ := hg true
    obtain ⟨hg0, hg0P, hg0B⟩ := hg false
    let gt : W' ⟶ W := g true
    let gf : W' ⟶ M (m + 1) := g false
    haveI : IsProper gt := isProper_of_isProjectiveMorphism _ hg1P
    have hgt : gt ≫ p m le_rfl ≫ f m = w := hg1
    have hgf : gf ≫ fp m = w := hg0
    have hsW : gt ≫ sW = w ≫ sZ m := by
      rw [← hgt, ← hpm, Category.assoc, Category.assoc, hfs]
    let p' : ∀ i, i ≤ m + 1 → (W' ⟶ M i) := fun i hi =>
      if h : i ≤ m then gt ≫ p i h else (by obtain rfl : i = m + 1 := (by omega); exact gf)
    have hp'1 : ∀ i (h : i ≤ m) (h' : i ≤ m + 1), p' i h' = gt ≫ p i h := fun i h h' => dif_pos h
    have hp'2 : p' (m + 1) le_rfl = gf := dif_neg (Nat.not_succ_le_self m)
    refine ⟨W', inferInstance, inferInstance, inferInstance, inferInstance, w ≫ sZ m, p', hW'.1,
      hsm, ?_, fun i hi => ?_, fun i hi => ?_⟩
    · rw [← hsW]
      exact (MMP.Mori.isProjectiveVariety_iff ℂ _).mpr ⟨hsW ▸ hW'.1,
        hg1P.comp ((MMP.Mori.isProjectiveVariety_iff ℂ _).mp hWproj).2⟩
    · by_cases h : i ≤ m
      · rw [hp'1 i h hi]
        obtain ⟨hpi, hpiP, hpiB⟩ := hp i h
        haveI : IsProper (p i h) := isProper_of_isProjectiveMorphism _ hpiP
        refine ⟨by rw [Category.assoc, hpi, hsW], hg1P.comp hpiP, isBirationalMorphism_comp_ph _ _
          hg1B hpiB⟩
      · obtain rfl : i = m + 1 := by omega
        rw [hp'2]
        exact ⟨by rw [← hfps, ← Category.assoc, hgf], hg0P, hg0B⟩
    · by_cases h : i + 1 ≤ m
      · rw [hp'1 i (by omega) hi.le, hp'1 (i + 1) h hi, Category.assoc, hpq i h, Category.assoc]
      · obtain rfl : i = m := by omega
        rw [hp'1 i le_rfl hi.le, hp'2, Category.assoc, hgt, hgf]

/-- The morphisms of a tower dominating a sequence of steps over `S` all lie over `S`. -/
private theorem tower_comp_eq_ph {M Z : ℕ → Scheme.{0}} {W S : Scheme.{0}} (f : ∀ i, M i ⟶ Z i)
    (fp : ∀ i, M (i + 1) ⟶ Z i) (hZ : ∀ i, Z i ⟶ S) (π : ∀ i, M i ⟶ S) (n : ℕ)
    (hf : ∀ i < n, f i ≫ hZ i = π i) (hfp : ∀ i < n, fp i ≫ hZ i = π (i + 1))
    (p : ∀ i, i ≤ n → (W ⟶ M i))
    (hpq : ∀ i (hi : i < n), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i) :
    ∀ i (hi : i ≤ n), p i hi ≫ π i = p 0 (Nat.zero_le n) ≫ π 0 := by
  intro i
  induction i with
  | zero => exact fun _ => rfl
  | succ j ih =>
    intro hj
    rw [← hfp j hj, ← Category.assoc, ← hpq j hj, Category.assoc, hf j hj]
    exact ih (Nat.le_of_succ_le hj)

end Tower

/-! ### Rational maps along a tower -/

section RationalMaps

open CategoryTheory.Limits

/-- A separated complex scheme is separated over the terminal scheme. -/
private theorem isSeparated_toTerminal_ph {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [IsSeparated sX] : IsSeparated (X ↘ ⊤_ Scheme) := by
  rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of ℂ) ↘ ⊤_ Scheme) from terminal.hom_ext _ _]
  infer_instance

/-- Composing a rational map with two morphisms in turn is composing it with their composite. -/
private theorem compHom_compHom_ph {X Y Z T : Scheme.{0}} (φ : X.RationalMap Y) (f : Y ⟶ Z)
    (g : Z ⟶ T) : (φ.compHom f).compHom g = φ.compHom (f ≫ g) := by
  obtain ⟨φ, rfl⟩ := φ.exists_rep
  rw [← Scheme.RationalMap.compHom_toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    ← Scheme.RationalMap.compHom_toRationalMap]
  congr 1

/-- The identity rational map is the rational map of the identity. -/
private theorem toRationalMap_id_ph (X : Scheme.{0}) :
    Scheme.Hom.toRationalMap (𝟙 X) = Scheme.RationalMap.id X := by
  rw [← Scheme.RationalMap.id_compHom (𝟙 X), Scheme.RationalMap.id,
    ← Scheme.RationalMap.compHom_toRationalMap, Scheme.PartialMap.compHom_id]

/-- Composition with a rational map followed by a morphism. -/
private theorem comp_compHom_ph {X Y Z T : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] (φ : X.RationalMap Y) [φ.IsDominant] (ψ : Y.RationalMap Z) [ψ.IsDominant]
    (g : Z ⟶ T) : φ.comp (ψ.compHom g) = (φ.comp ψ).compHom g := by
  rw [← Scheme.RationalMap.comp_toRationalMap ψ g,
    ← Scheme.RationalMap.comp_toRationalMap (φ.comp ψ) g, Scheme.RationalMap.comp_assoc]

/-- **Cancelling a birational morphism.** Dominant rational maps which agree after composition
with a birational morphism agree. -/
private theorem eq_of_compHom_eq_ph {X Y T : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral T] {u : Y ⟶ T} (hu : IsBirationalMorphism u) {χ₁ χ₂ : X.RationalMap Y}
    [χ₁.IsDominant] [χ₂.IsDominant] (h : χ₁.compHom u = χ₂.compHom u) : χ₁ = χ₂ := by
  haveI : IsDominant u := hu.isDominant
  obtain ⟨ui, hui⟩ := hu.exists_isInverse
  have h1 : u.toRationalMap.comp ui = Scheme.RationalMap.id Y :=
    MMP.Fourfold.Crepant.comp_eq_id_of_isInverse hui
  have key : ∀ (χ : X.RationalMap Y) [χ.IsDominant], χ = (χ.comp u.toRationalMap).comp ui := by
    intro χ _
    rw [Scheme.RationalMap.comp_assoc, h1, Scheme.RationalMap.comp_id]
  rw [key χ₁, key χ₂]
  exact MMP.Fourfold.Crepant.comp_eq_comp_of_eq (by
    rw [Scheme.RationalMap.comp_toRationalMap, Scheme.RationalMap.comp_toRationalMap, h]) ui

/-- **Cancelling a birational map on the left.** -/
private theorem eq_of_comp_eq_ph {X Y Z : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] {ρ : X.RationalMap Y} [ρ.IsDominant] (hρ : MMP.Mori.RationalMap.IsBirational ρ)
    {χ₁ χ₂ : Y.RationalMap Z} (h : ρ.comp χ₁ = ρ.comp χ₂) : χ₁ = χ₂ := by
  obtain ⟨ρi, hρi⟩ := hρ.exists_isInverse
  haveI := MMP.Fourfold.Crepant.isDominant_of_isBirational hρi.isBirational_inverse
  have h1 : ρi.comp ρ = Scheme.RationalMap.id Y :=
    MMP.Fourfold.Crepant.comp_eq_id_of_isInverse hρi.symm
  have key : ∀ χ : Y.RationalMap Z, χ = ρi.comp (ρ.comp χ) := by
    intro χ
    rw [← Scheme.RationalMap.comp_assoc, MMP.Fourfold.Crepant.comp_eq_comp_of_eq h1 χ,
      Scheme.RationalMap.id_comp]
  rw [key χ₁, key χ₂, h]

/-- If `h` is an inverse of `p`, then `p ∘ h` is the identity. -/
private theorem compHom_eq_id_of_isInverse_ph {W X : Scheme.{0}} [IsReduced W] [IsReduced X]
    [IsSeparated (X ↘ ⊤_ Scheme)] (p : W ⟶ X) {h : X.RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse p.toRationalMap h) :
    h.compHom p = Scheme.Hom.toRationalMap (𝟙 X) := by
  obtain ⟨e, he, rfl⟩ := hh
  have hsrc : e.source.ι ≫ p = e.iso.hom ≫ e.target.ι :=
    ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp he)).symm
  change (e.symm.toPartialMap.compHom p).toRationalMap =
    (Scheme.Hom.toPartialMap (𝟙 X)).toRationalMap
  rw [Scheme.PartialMap.toRationalMap_eq_iff,
    Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)]
  change e.iso.inv ≫ e.source.ι ≫ p = e.target.ι ≫ 𝟙 X
  rw [hsrc, Iso.inv_hom_id_assoc, Category.comp_id]

/-- A representative of an inverse of `p` is a section of `p`. -/
private theorem apply_hom_of_isInverse_ph {W X : Scheme.{0}} [IsReduced W] [IsReduced X]
    [IsSeparated (X ↘ ⊤_ Scheme)] (p : W ⟶ X) {h : X.RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse p.toRationalMap h) (g' : X.PartialMap W)
    (hg' : g'.toRationalMap = h) {x : X} (hx : x ∈ g'.domain) : p (g'.hom ⟨x, hx⟩) = x := by
  have h1 : (g'.compHom p).toRationalMap = (Scheme.Hom.toPartialMap (𝟙 X)).toRationalMap := by
    rw [Scheme.RationalMap.compHom_toRationalMap, hg', compHom_eq_id_of_isInverse_ph p hh]
  have h2 := MMP.Positivity.PartialMap.hom_apply_eq_of_toRationalMap_eq h1 hx trivial
  change (g'.hom ≫ p) ⟨x, hx⟩ = (X.topIso.hom ≫ 𝟙 X) ⟨x, trivial⟩ at h2
  refine (Scheme.Hom.comp_apply _ _ _).symm.trans (h2.trans ?_)
  rw [Category.comp_id, Scheme.topIso_hom]
  rfl

/-- Over the biregular locus a morphism is injective. -/
private theorem eq_of_apply_eq_of_mem_biregularLocus_ph {X Y : Scheme.{0}} (g : X ⟶ Y)
    {x x' : X} (h : g x = g x') (hx : g x ∈ (MMP.Mori.biregularLocus g : Y.Opens)) : x = x' := by
  haveI : IsIso (g ∣_ MMP.Mori.biregularLocus g) := MMP.Mori.isBiregular_biregularLocus g
  obtain ⟨a, ha⟩ : x ∈ Set.range (g ⁻¹ᵁ MMP.Mori.biregularLocus g).ι := by
    rw [Scheme.Opens.range_ι]; exact hx
  obtain ⟨a', ha'⟩ : x' ∈ Set.range (g ⁻¹ᵁ MMP.Mori.biregularLocus g).ι := by
    rw [Scheme.Opens.range_ι]
    change g x' ∈ (MMP.Mori.biregularLocus g : Y.Opens)
    rw [← h]; exact hx
  have hι : ∀ b, (MMP.Mori.biregularLocus g).ι ((g ∣_ MMP.Mori.biregularLocus g) b) =
      g ((g ⁻¹ᵁ MMP.Mori.biregularLocus g).ι b) := fun b => by
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  have hb : (g ∣_ MMP.Mori.biregularLocus g) a = (g ∣_ MMP.Mori.biregularLocus g) a' :=
    (MMP.Mori.biregularLocus g).ι.isOpenEmbedding.injective (by rw [hι, hι, ha, ha', h])
  rw [← ha, ← ha', (g ∣_ MMP.Mori.biregularLocus g).isOpenEmbedding.injective hb]

/-- Two points over a point of coheight at most one of a normal scheme, along a proper birational
morphism, coincide. -/
private theorem eq_of_apply_eq_of_coheight_le_one_ph {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (g : X ⟶ Y) [IsProper g]
    (hg : IsBirationalMorphism g) {x x' : X} (h : g x = g x') (hx : Order.coheight (g x) ≤ 1) :
    x = x' :=
  eq_of_apply_eq_of_mem_biregularLocus_ph g h
    (MMP.Spreading.mem_biregularLocus_of_coheight_le_one_of_isNormal g hg hx)

/-- The transform of a prime divisor `G` of `X` along `q ∘ p⁻¹`, for `p : W ⟶ X` proper
birational onto a normal scheme, is read on the prime divisor `P` of `W` over `G`. -/
private theorem transformPrimeDivisor_compHom_eq_some_iff_ph {W X Y : Scheme.{0}} [IsIntegral W]
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsSeparated (X ↘ ⊤_ Scheme)]
    [IsSeparated (Y ↘ ⊤_ Scheme)] (p : W ⟶ X) [IsProper p] (hp : IsBirationalMorphism p)
    {h : X.RationalMap W} (hh : MMP.Mori.RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y)
    {G : MMP.Mori.PrimeDivisor X} {P : MMP.Mori.PrimeDivisor W}
    (hPG : p P.genericPoint = G.genericPoint) (F : MMP.Mori.PrimeDivisor Y) :
    MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom q) G = some F ↔
      q P.genericPoint = F.genericPoint := by
  have hG1 : Order.coheight G.genericPoint ≤ 1 := G.coheight_genericPoint.le
  have hdom := MMP.Flips.RationalMap.mem_domain_of_coheight_le_one (𝟙 X) p h
    (compHom_eq_id_of_isInverse_ph p hh) hG1
  obtain ⟨g', hxg', hg'⟩ := Scheme.RationalMap.mem_domain.mp hdom
  have hpw := apply_hom_of_isInverse_ph p hh g' hg' hxg'
  have hw : g'.hom ⟨G.genericPoint, hxg'⟩ = P.genericPoint :=
    eq_of_apply_eq_of_coheight_le_one_ph p hp (hpw.trans hPG.symm) (by rw [hpw]; exact hG1)
  have hrep : (g'.compHom q).toRationalMap = h.compHom q := by
    rw [← hg', Scheme.RationalMap.compHom_toRationalMap]
  have hval : (g'.compHom q).hom ⟨G.genericPoint, hxg'⟩ = q P.genericPoint := by
    rw [← hw]
    rfl
  refine ⟨fun hT => ?_, fun hq => MMP.Flips.transformPrimeDivisor_eq_some_of_genericPoint_eq
    (g'.compHom q) hrep hxg' (hval.trans hq).symm⟩
  rw [← hval]
  exact (MMP.Flips.genericPoint_eq_of_transformPrimeDivisor_eq_some hT (g'.compHom q) hrep
    hxg').symm

/-- A partial map which is an open immersion represents a birational map. -/
private theorem isBirational_of_isOpenImmersion_ph {X Y : Scheme.{0}} [IrreducibleSpace Y]
    (c : X.PartialMap Y) [IsOpenImmersion c.hom] [Nonempty c.domain] :
    MMP.Mori.RationalMap.IsBirational c.toRationalMap := by
  have hd : Dense (c.hom.opensRange : Set Y) :=
    c.hom.opensRange.2.dense ⟨_, Classical.arbitrary c.domain, rfl⟩
  refine ⟨⟨c.domain, c.dense_domain, c.hom.opensRange, hd, c.hom.isoOpensRange⟩, ?_⟩
  change Scheme.PartialMap.toRationalMap
    ⟨c.domain, c.dense_domain, c.hom.isoOpensRange.hom ≫ c.hom.opensRange.ι⟩ = _
  rw [Scheme.Hom.isoOpensRange_hom_ι]

/-- Restricting the source of a partial isomorphism does not change its rational map. -/
private theorem toRationalMap_restrictSource_ph {X Y : Scheme.{0}} (e : X.PartialIso Y)
    (U : X.Opens) (hU : Dense (U : Set X)) (hUe : U ≤ e.source) :
    (e.restrictSource U hU hUe).toRationalMap = e.toRationalMap := by
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialIso.toRationalMap,
    Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨U, hU, le_rfl, hUe, ?_⟩
  have key : (Scheme.Opens.isoOfLE hUe).inv ≫ (e.source.ι ⁻¹ᵁ U).ι = X.homOfLE hUe := by
    rw [← cancel_mono e.source.ι, Category.assoc, Scheme.Opens.isoOfLE_inv_ι, Scheme.homOfLE_ι]
  change X.homOfLE (le_refl U) ≫ (((Scheme.Opens.isoOfLE hUe).inv ≫
      (e.iso.hom.isoImage (e.source.ι ⁻¹ᵁ U)).hom) ≫
      (e.target.ι.isoImage (e.iso.hom ''ᵁ e.source.ι ⁻¹ᵁ U)).hom) ≫
      (e.target.ι ''ᵁ (e.iso.hom ''ᵁ (e.source.ι ⁻¹ᵁ U))).ι =
    X.homOfLE hUe ≫ e.iso.hom ≫ e.target.ι
  rw [Scheme.homOfLE_rfl, Category.id_comp, Category.assoc, Scheme.Hom.isoImage_hom_ι,
    Category.assoc, Scheme.Hom.isoImage_hom_ι_assoc, ← Category.assoc, key]

/-- The composite `q ∘ p⁻¹` of a birational morphism with the inverse of another is
birational. -/
private theorem isBirational_compHom_of_isInverse_ph {W X Y : Scheme.{0}} [IrreducibleSpace W]
    [IrreducibleSpace X] [IrreducibleSpace Y] (p : W ⟶ X) {h : X.RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse p.toRationalMap h) (q : W ⟶ Y)
    (hq : IsBirationalMorphism q) [IsSeparated (Y ↘ ⊤_ Scheme)] [IsReduced W] :
    MMP.Mori.RationalMap.IsBirational (h.compHom q) := by
  obtain ⟨e₀, he₀, rfl⟩ := hh
  obtain ⟨e₁, he₁⟩ := hq
  have hsrc : e₁.source.ι ≫ q = e₁.iso.hom ≫ e₁.target.ι :=
    ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := ⊤_ Scheme)).mp
      (Scheme.PartialMap.toRationalMap_eq_iff.mp he₁)).symm
  set U : W.Opens := e₀.source ⊓ e₁.source
  have hU : Dense (U : Set W) := e₀.dense_source.inter_of_isOpen_left e₁.dense_source
    e₀.source.isOpen
  set e₀' := e₀.restrictSource U hU inf_le_left
  have he₀' : e₀'.symm.toRationalMap = e₀.symm.toRationalMap :=
    MMP.Positivity.PartialIso.symm_toRationalMap_eq (toRationalMap_restrictSource_ph e₀ U hU _)
  rw [← he₀', ← Scheme.RationalMap.compHom_toRationalMap]
  have hU1 : U.ι ≫ q = W.homOfLE (inf_le_right : U ≤ e₁.source) ≫ e₁.iso.hom ≫ e₁.target.ι := by
    rw [← hsrc, Scheme.homOfLE_ι_assoc]
  have hUq : IsOpenImmersion (U.ι ≫ q) := by rw [hU1]; infer_instance
  haveI : IsOpenImmersion (e₀'.symm.toPartialMap.compHom q).hom :=
    @IsOpenImmersion.comp _ _ _ e₀'.iso.inv (U.ι ≫ q) inferInstance hUq
  haveI : Nonempty (e₀'.symm.toPartialMap.compHom q).domain := by
    obtain ⟨z, hz⟩ := (e₀'.symm.toPartialMap.compHom q).dense_domain.nonempty
    exact ⟨⟨z, hz⟩⟩
  exact isBirational_of_isOpenImmersion_ph _

/-- `d + 2 ≤ n` when `d + c = n` and `2 ≤ c`. -/
private theorem withBot_add_two_le_of_ph {d : WithBot ℕ∞} {c : ℕ∞} {n : ℕ} (h : d + c = n)
    (h2 : 2 ≤ c) : d + 2 ≤ n := by
  calc d + 2 = d + ((2 : ℕ∞) : WithBot ℕ∞) := rfl
    _ ≤ d + (c : WithBot ℕ∞) := add_le_add le_rfl (WithBot.coe_le_coe.mpr h2)
    _ = n := h

/-- A prime divisor of `W` whose image has coheight at least two is exceptional. -/
private theorem isExceptionalPrimeDivisor_of_two_le_coheight_ph {k : Type} [Field k]
    {W Y : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [LocallyOfFiniteType sY] {n : ℕ}
    (hn : topologicalKrullDim Y = n) {q : W ⟶ Y} (hW : IsNormalVariety k (q ≫ sY)) [IsProper q]
    (hq : IsBirationalMorphism q) (P : MMP.Mori.PrimeDivisor W)
    (h2 : 2 ≤ Order.coheight (q P.genericPoint)) : IsExceptionalPrimeDivisor sY q P := by
  refine ⟨hW, hq, inferInstance, ?_⟩
  unfold ProperDivisorOver.IsExceptional
  rw [ProperDivisorOver.center_eq_toDivisorOver_center,
    DivisorOver.center_eq_closure_genericPoint, hn]
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sY (q P.genericPoint)
  rw [hn] at h
  exact withBot_add_two_le_of_ph h h2

/-- The composite of a partial isomorphism `a` with the composite of its inverse and a partial
isomorphism `b` of the same source is `b`. -/
private theorem comp_symm_trans'_toRationalMap_ph {X Y Z : Scheme.{0}} [PreirreducibleSpace X]
    [Nonempty Y] (a : X.PartialIso Y) (b : X.PartialIso Z) (hab : a.source = b.source)
    [IsDominant a.toPartialMap.hom] :
    a.toPartialMap.toRationalMap.comp (a.symm.trans' b hab).toPartialMap.toRationalMap =
      b.toPartialMap.toRationalMap := by
  rw [Scheme.RationalMap.toRationalMap_comp, Scheme.PartialMap.toRationalMap_eq_iff]
  have hle : a.source.ι ''ᵁ ((a.iso.hom ≫ a.target.ι) ⁻¹ᵁ a.target) ≤ a.source := by
    change ((a.source.ι ''ᵁ _ : X.Opens) : Set X) ⊆ a.source
    exact (Set.image_subset_range _ _).trans (by simp)
  refine ⟨_, (a.toPartialMap.comp (a.symm.trans' b hab).toPartialMap).dense_domain, le_rfl,
    hle.trans hab.le, ?_⟩
  have h1 : (a.iso.hom ≫ a.target.ι) ∣_ a.target ≫ a.iso.inv =
      ((a.iso.hom ≫ a.target.ι) ⁻¹ᵁ a.target).ι := by
    rw [← cancel_mono (a.iso.hom ≫ a.target.ι), Category.assoc, Iso.inv_hom_id_assoc,
      morphismRestrict_ι]
  have h2 : (a.source.ι.isoImage ((a.iso.hom ≫ a.target.ι) ⁻¹ᵁ a.target)).inv ≫
      ((a.iso.hom ≫ a.target.ι) ⁻¹ᵁ a.target).ι = X.homOfLE hle := by
    rw [← cancel_mono a.source.ι, Category.assoc, Scheme.homOfLE_ι, Iso.inv_comp_eq,
      Scheme.Hom.isoImage_hom_ι]
  have h3 : X.homOfLE hle ≫ (X.isoOfEq hab).hom = X.homOfLE (hle.trans hab.le) := by
    rw [← cancel_mono b.source.ι, Category.assoc, Scheme.isoOfEq_hom_ι, Scheme.homOfLE_ι,
      Scheme.homOfLE_ι]
  change X.homOfLE (le_refl _) ≫
      (a.source.ι.isoImage ((a.iso.hom ≫ a.target.ι) ⁻¹ᵁ a.target)).inv ≫
      ((a.iso.hom ≫ a.target.ι) ∣_ a.target) ≫
      (a.iso.inv ≫ (X.isoOfEq hab).hom ≫ b.iso.hom) ≫ b.target.ι =
    X.homOfLE (hle.trans hab.le) ≫ b.iso.hom ≫ b.target.ι
  rw [Scheme.homOfLE_rfl, Category.id_comp]
  simp only [Category.assoc]
  rw [reassoc_of% h1, reassoc_of% h2, reassoc_of% h3]

/-- For partial isomorphisms `e₁ : X ⤏ Y` and `e₂ : X ⤏ Z`, `e₁` followed by `e₁⁻¹ ∘ e₂` is
`e₂`. -/
private theorem comp_symm_trans_toRationalMap_ph {X Y Z : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] (e₁ : X.PartialIso Y) (e₂ : X.PartialIso Z) [e₁.toRationalMap.IsDominant] :
    e₁.toRationalMap.comp (e₁.symm.trans e₂).toRationalMap = e₂.toRationalMap := by
  let V : X.Opens := e₁.source ⊓ e₂.source
  have hV : Dense (V : Set X) :=
    e₁.dense_source.inter_of_isOpen_left e₂.dense_source e₁.source.isOpen
  let a := e₁.restrictSource V hV inf_le_left
  let b := e₂.restrictSource V hV inf_le_right
  have ha : a.toRationalMap = e₁.toRationalMap :=
    toRationalMap_restrictSource_ph e₁ V hV inf_le_left
  have hb : b.toRationalMap = e₂.toRationalMap :=
    toRationalMap_restrictSource_ph e₂ V hV inf_le_right
  haveI : IsDominant a.toPartialMap.hom := by
    change IsDominant (a.iso.hom ≫ a.target.ι)
    haveI := AlgebraicGeometry.Opens.isDominant_ι a.dense_target
    infer_instance
  calc e₁.toRationalMap.comp (e₁.symm.trans e₂).toRationalMap
      = a.toRationalMap.comp (a.symm.trans' b rfl).toRationalMap :=
        MMP.Fourfold.Crepant.comp_eq_comp_of_eq ha.symm _
    _ = b.toRationalMap := comp_symm_trans'_toRationalMap_ph a b rfl
    _ = e₂.toRationalMap := hb

/-- The rational map of a morphism, composed with a morphism, is the rational map of the
composite. -/
private theorem toRationalMap_compHom_ph {X Z T : Scheme.{0}} (f : X ⟶ Z) (g : Z ⟶ T) :
    f.toRationalMap.compHom g = (f ≫ g).toRationalMap := by
  rw [Scheme.Hom.toRationalMap, ← Scheme.RationalMap.compHom_toRationalMap,
    Scheme.Hom.toPartialMap_compHom]

end RationalMaps

/-! ### Chains of small flips -/

section Chain

open CategoryTheory.Limits

variable {V T : ℕ → Scheme.{0}} [∀ k, IsIntegral (V k)] [∀ k, IsLocallyNoetherian (V k)]
  [∀ k, IsNormal (V k)] {sV : ∀ k, V k ⟶ Spec (.of ℂ)} {sT : ∀ k, T k ⟶ Spec (.of ℂ)}
  {f : ∀ k, V k ⟶ T k} {fp : ∀ k, V (k + 1) ⟶ T k}

variable (sV sT f fp) in
/-- A chain `V_k ⟶ T_k ⟵ V_{k+1}` of small birational contractions of projective
`ℚ`-factorial complex varieties onto normal varieties. -/
private structure IsFlipChain : Prop where
  isProjectiveVariety : ∀ k, MMP.Mori.IsProjectiveVariety ℂ (sV k)
  isQFactorial : ∀ k, IsQFactorial (sV k)
  dim_eq : ∀ k, topologicalKrullDim (V k) = 3
  isNormalVariety_target : ∀ k, IsNormalVariety ℂ (sT k)
  isSmall : ∀ k, MMP.Flips.IsSmall ℂ (sT k) (sV k) (f k)
  isSmall_flip : ∀ k, MMP.Flips.IsSmall ℂ (sT k) (sV (k + 1)) (fp k)
  isBirationalMorphism : ∀ k, IsBirationalMorphism (f k)
  isBirationalMorphism_flip : ∀ k, IsBirationalMorphism (fp k)

private theorem isNormalVariety_of_isFlipChain (hc : IsFlipChain sV sT f fp) (k : ℕ) :
    IsNormalVariety ℂ (sV k) :=
  ⟨(hc.isProjectiveVariety k).toIsVariety, inferInstance⟩

private theorem isSmallMorphism_of_isFlipChain (hc : IsFlipChain sV sT f fp) (k : ℕ) :
    IsSmallMorphism (sV k) (sT k) (f k) :=
  isSmallMorphism_of_isSmall (isNormalVariety_of_isFlipChain hc k) (hc.isNormalVariety_target k)
    (hc.isSmall k) (hc.isBirationalMorphism k)

private theorem isSmallMorphism_flip_of_isFlipChain (hc : IsFlipChain sV sT f fp) (k : ℕ) :
    IsSmallMorphism (sV (k + 1)) (sT k) (fp k) :=
  isSmallMorphism_of_isSmall (isNormalVariety_of_isFlipChain hc (k + 1))
    (hc.isNormalVariety_target k) (hc.isSmall_flip k) (hc.isBirationalMorphism_flip k)

/-- One step up a chain: a point of a common model over the generic point of a prime divisor of
`V_k` lies over the generic point of a prime divisor of `V_{k+1}`, at which the strict transform
reads the coefficient. -/
private theorem exists_primeDivisor_succ_of_isFlipChain (hc : IsFlipChain sV sT f fp) (k : ℕ)
    {W : Scheme.{0}} (pk : W ⟶ V k) (pk' : W ⟶ V (k + 1)) (hpq : pk ≫ f k = pk' ≫ fp k) (w : W)
    {P : MMP.Mori.PrimeDivisor (V k)} (hP : pk w = P.genericPoint) :
    ∃ P' : MMP.Mori.PrimeDivisor (V (k + 1)), pk' w = P'.genericPoint ∧
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R (V k)),
        flipTransform (f k) (fp k) D P' = D P := by
  haveI := (hc.isSmall k).isProper
  haveI := (hc.isSmall_flip k).isProper
  have hcomp : fp k (pk' w) = f k (pk w) := by
    rw [← Scheme.Hom.comp_apply, ← hpq, Scheme.Hom.comp_apply]
  obtain ⟨Pm, hPm, -⟩ := exists_eq_genericPoint_flipTransform_apply.{0, 0}
    (hc.isBirationalMorphism_flip k) (isSmallMorphism_of_isFlipChain hc k) P (pk' w)
    (by rw [hcomp, hP])
  obtain ⟨Pk', hPk', hfl⟩ := exists_eq_genericPoint_flipTransform_apply
    (hc.isBirationalMorphism k) (isSmallMorphism_flip_of_isFlipChain hc k) Pm P.genericPoint
    (by rw [← hP, ← hcomp, hPm])
  refine ⟨Pm, hPm, fun D => ?_⟩
  rw [hfl D, AlgebraicGeometry.PrimeDivisor.genericPoint_injective hPk'.symm]

/-- One step down a chain. -/
private theorem exists_primeDivisor_of_succ_of_isFlipChain (hc : IsFlipChain sV sT f fp) (k : ℕ)
    {W : Scheme.{0}} (pk : W ⟶ V k) (pk' : W ⟶ V (k + 1)) (hpq : pk ≫ f k = pk' ≫ fp k) (w : W)
    {P' : MMP.Mori.PrimeDivisor (V (k + 1))} (hP' : pk' w = P'.genericPoint) :
    ∃ P : MMP.Mori.PrimeDivisor (V k), pk w = P.genericPoint ∧
      ∀ {R : Type} [AddCommMonoid R] (D : DivisorWithCoeffs R (V k)),
        flipTransform (f k) (fp k) D P' = D P := by
  haveI := (hc.isSmall k).isProper
  obtain ⟨P, hP, hfl⟩ := exists_eq_genericPoint_flipTransform_apply
    (hc.isBirationalMorphism k) (isSmallMorphism_flip_of_isFlipChain hc k) P' (pk w)
    (by rw [← Scheme.Hom.comp_apply, hpq, Scheme.Hom.comp_apply, hP'])
  exact ⟨P, hP, fun D => hfl D⟩

/-- **Prime divisors along a chain.** A point of a model dominating `V_0, …, V_m` which lies over
the generic point of a prime divisor `P` of `V_i` lies over the generic point of a prime divisor
`P_k` of every `V_k`, and every family of strict transforms along the chain has the same
coefficient at `P_k` as at `P`. -/
private theorem exists_primeDivisor_forall_of_isFlipChain (hc : IsFlipChain sV sT f fp)
    {W : Scheme.{0}} {m : ℕ} (p : ∀ i, i ≤ m → (W ⟶ V i))
    (hpq : ∀ i (hi : i < m), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i) (w : W) {i : ℕ} (hi : i ≤ m)
    {P : MMP.Mori.PrimeDivisor (V i)} (hP : p i hi w = P.genericPoint) (k : ℕ) (hk : k ≤ m) :
    ∃ Pk : MMP.Mori.PrimeDivisor (V k), p k hk w = Pk.genericPoint ∧
      ∀ {R : Type} [AddCommMonoid R] (D : ∀ k, DivisorWithCoeffs R (V k)),
        (∀ k, D (k + 1) = flipTransform (f k) (fp k) (D k)) → D k Pk = D i P := by
  have hdown : ∀ d j (hj : j + d = i), ∃ Pj : MMP.Mori.PrimeDivisor (V j),
      p j (by omega) w = Pj.genericPoint ∧ ∀ {R : Type} [AddCommMonoid R]
        (D : ∀ k, DivisorWithCoeffs R (V k)),
        (∀ k, D (k + 1) = flipTransform (f k) (fp k) (D k)) → D j Pj = D i P := by
    intro d
    induction d with
    | zero =>
      intro j hj
      obtain rfl : j = i := hj
      exact ⟨P, hP, fun _ _ => rfl⟩
    | succ d ih =>
      intro j hj
      obtain ⟨P1, hP1, hD1⟩ := ih (j + 1) (by omega)
      obtain ⟨Pj, hPj, hfl⟩ := exists_primeDivisor_of_succ_of_isFlipChain hc j (p j (by omega))
        (p (j + 1) (by omega)) (hpq j (by omega)) w hP1
      refine ⟨Pj, hPj, fun D hD => ?_⟩
      rw [← hfl (D j), ← hD j]
      exact hD1 D hD
  obtain ⟨P0, hP0, hD0⟩ := hdown i 0 (Nat.zero_add i)
  have hup : ∀ k (hk : k ≤ m), ∃ Pk : MMP.Mori.PrimeDivisor (V k), p k hk w = Pk.genericPoint ∧
      ∀ {R : Type} [AddCommMonoid R] (D : ∀ k, DivisorWithCoeffs R (V k)),
        (∀ k, D (k + 1) = flipTransform (f k) (fp k) (D k)) → D k Pk = D 0 P0 := by
    intro k
    induction k with
    | zero => intro _; exact ⟨P0, hP0, fun _ _ => rfl⟩
    | succ k ih =>
      intro hk
      obtain ⟨Pk, hPk, hDk⟩ := ih (by omega)
      obtain ⟨P', hP', hfl⟩ := exists_primeDivisor_succ_of_isFlipChain hc k (p k (by omega))
        (p (k + 1) hk) (hpq k (by omega)) w hPk
      refine ⟨P', hP', fun D hD => ?_⟩
      rw [hD k, hfl (D k)]
      exact hDk D hD
  obtain ⟨Pk, hPk, hDk⟩ := hup k hk
  exact ⟨Pk, hPk, fun D hD => (hDk D hD).trans (hD0 D hD)⟩

/-- **Transforms along a tower.** For a normal model `W` dominating `V_0, …, V_m` and an inverse
`h` of `p_i`, the map `p_k ∘ p_i⁻¹ : V_i ⤏ V_k` is birational, carries every prime divisor to a
prime divisor, contracts none, has no exceptional prime divisor of its target, and carries every
family of strict transforms along the chain from its `i`-th to its `k`-th member. -/
private theorem compHom_of_isFlipChain (hc : IsFlipChain sV sT f fp) {W : Scheme.{0}}
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] {sW : W ⟶ Spec (.of ℂ)}
    (hW : IsNormalVariety ℂ sW) {m : ℕ} (p : ∀ i, i ≤ m → (W ⟶ V i))
    (hp : ∀ i (hi : i ≤ m), p i hi ≫ sV i = sW ∧ IsProjectiveMorphism (p i hi) ∧
      IsBirationalMorphism (p i hi))
    (hpq : ∀ i (hi : i < m), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i)
    {i k : ℕ} (hi : i ≤ m) (hk : k ≤ m) {h : (V i).RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse (p i hi).toRationalMap h) :
    MMP.Mori.RationalMap.IsBirational (h.compHom (p k hk)) ∧
      (∀ G : MMP.Mori.PrimeDivisor (V i),
        ¬ MMP.Mori.RationalMap.IsExceptional (h.compHom (p k hk)) G) ∧
      (∀ F : MMP.Mori.PrimeDivisor (V k),
        ¬ MMP.Flips.RationalMap.IsInverseExceptional (h.compHom (p k hk)) F) ∧
      (∀ {R : Type} [AddCommMonoid R] (D : ∀ k, DivisorWithCoeffs R (V k)),
        (∀ k, D (k + 1) = flipTransform (f k) (fp k) (D k)) →
          MMP.Mori.RationalMap.transformDivisor (h.compHom (p k hk)) (D i) = D k) := by
  have hVv := isNormalVariety_of_isFlipChain hc
  haveI hsep : ∀ j, IsSeparated (V j ↘ ⊤_ Scheme) := fun j => by
    haveI := (hVv j).1.toIsSeparated
    exact isSeparated_toTerminal_ph (sV j)
  haveI hpP : ∀ j (hj : j ≤ m), IsProper (p j hj) := fun j hj =>
    isProper_of_isProjectiveMorphism _ (hp j hj).2.1
  have hWj : ∀ j (hj : j ≤ m), IsNormalVariety ℂ (p j hj ≫ sV j) := fun j hj => by
    rw [(hp j hj).1]; exact hW
  have hover : ∀ j (hj : j ≤ m) (G : MMP.Mori.PrimeDivisor (V j)),
      ∃ E : MMP.Mori.PrimeDivisor W, p j hj E.genericPoint = G.genericPoint := fun j hj G => by
    obtain ⟨E, hE, -⟩ := MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0}
      (hVv j) (hWj j hj) (hp j hj).2.2 G
    exact ⟨E, hE⟩
  have hiff : ∀ (G : MMP.Mori.PrimeDivisor (V i)) (E : MMP.Mori.PrimeDivisor W),
      p i hi E.genericPoint = G.genericPoint → ∀ F,
        MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom (p k hk)) G = some F ↔
          p k hk E.genericPoint = F.genericPoint := fun G E hE F =>
    transformPrimeDivisor_compHom_eq_some_iff_ph (p i hi) (hp i hi).2.2 hh (p k hk) hE F
  have himg : ∀ G : MMP.Mori.PrimeDivisor (V i), ∃ F : MMP.Mori.PrimeDivisor (V k),
      MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom (p k hk)) G = some F := by
    intro G
    obtain ⟨E, hE⟩ := hover i hi G
    obtain ⟨F, hF, -⟩ := exists_primeDivisor_forall_of_isFlipChain hc p hpq E.genericPoint hi hE
      k hk
    exact ⟨F, (hiff G E hE F).mpr hF⟩
  refine ⟨isBirational_compHom_of_isInverse_ph (p i hi) hh (p k hk) (hp k hk).2.2,
    fun G hG => ?_, fun F hF => ?_, fun D hD => ?_⟩
  · obtain ⟨F, hT⟩ := himg G
    rcases hG with hnd | ⟨-, h2⟩
    · exact hnd (MMP.Mori.RationalMap.transformPrimeDivisor_eq_some_iff.mp hT).1
    · have hmem : F.genericPoint ∈ (MMP.Mori.RationalMap.transform (h.compHom (p k hk))
          G.idealSheaf.support : Set (V k)) := by
        rw [← MMP.Mori.RationalMap.support_transformPrimeDivisor hT,
          AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl
      have := (MMP.Flips.le_closedsCodimension_iff_le_coheight.mp h2) F.genericPoint hmem
      rw [F.coheight_genericPoint] at this
      exact absurd this (by decide)
  · obtain ⟨E, hE⟩ := hover k hk F
    obtain ⟨G, hG, -⟩ := exists_primeDivisor_forall_of_isFlipChain hc p hpq E.genericPoint hk hE
      i hi
    exact hF G ((hiff G E hG F).mpr hE)
  · refine Finsupp.ext fun F => ?_
    obtain ⟨E, hE⟩ := hover k hk F
    obtain ⟨G, hG, hDG⟩ := exists_primeDivisor_forall_of_isFlipChain hc p hpq E.genericPoint hk
      hE i hi
    have huniq : ∀ G', MMP.Mori.RationalMap.transformPrimeDivisor (h.compHom (p k hk)) G' =
        some F → G' = G := by
      intro G' hG'
      obtain ⟨E', hE'⟩ := hover i hi G'
      have h1 := (hiff G' E' hE' F).mp hG'
      have hEE : E'.genericPoint = E.genericPoint :=
        eq_of_apply_eq_of_coheight_le_one_ph (p k hk) (hp k hk).2.2 (h1.trans hE.symm)
          (by rw [h1, F.coheight_genericPoint])
      exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
        (hE'.symm.trans ((congrArg (fun x => p i hi x) hEE).trans hG))
    rw [MMP.Mori.RationalMap.transformDivisor,
      MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq ((hiff G E hG F).mpr hE) huniq]
    exact hDG D hD

/-- **Independence of the tower.** The maps `p_n ∘ p_0⁻¹ : V_0 ⤏ V_n` of two models dominating a
chain agree: both are compatible with the steps of the chain, and a dominant rational map is
determined by its composite with a birational morphism. -/
private theorem compHom_eq_compHom_of_isFlipChain (hc : IsFlipChain sV sT f fp)
    {W W' : Scheme.{0}} [IsIntegral W] [IsIntegral W'] {m m' : ℕ}
    (p : ∀ i, i ≤ m → (W ⟶ V i)) (hp : ∀ i (hi : i ≤ m), IsBirationalMorphism (p i hi))
    (hpq : ∀ i (hi : i < m), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i)
    (p' : ∀ i, i ≤ m' → (W' ⟶ V i)) (hp' : ∀ i (hi : i ≤ m'), IsBirationalMorphism (p' i hi))
    (hpq' : ∀ i (hi : i < m'), p' i hi.le ≫ f i = p' (i + 1) hi ≫ fp i)
    {h : (V 0).RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse (p 0 (Nat.zero_le m)).toRationalMap h)
    {h' : (V 0).RationalMap W'}
    (hh' : MMP.Mori.RationalMap.IsInverse (p' 0 (Nat.zero_le m')).toRationalMap h') :
    ∀ n (hn : n ≤ m) (hn' : n ≤ m'), h.compHom (p n hn) = h'.compHom (p' n hn') := by
  have hVv := isNormalVariety_of_isFlipChain hc
  haveI hsep : ∀ j, IsSeparated (V j ↘ ⊤_ Scheme) := fun j => by
    haveI := (hVv j).1.toIsSeparated
    exact isSeparated_toTerminal_ph (sV j)
  intro n
  induction n with
  | zero =>
    intro hn hn'
    rw [compHom_eq_id_of_isInverse_ph _ hh, compHom_eq_id_of_isInverse_ph _ hh']
  | succ n ih =>
    intro hn hn'
    haveI : IsIntegral (T n) := (hc.isNormalVariety_target n).1.toIsIntegral
    haveI := MMP.Fourfold.Crepant.isDominant_of_isBirational
      (isBirational_compHom_of_isInverse_ph _ hh (p (n + 1) hn) (hp (n + 1) hn))
    haveI := MMP.Fourfold.Crepant.isDominant_of_isBirational
      (isBirational_compHom_of_isInverse_ph _ hh' (p' (n + 1) hn') (hp' (n + 1) hn'))
    refine eq_of_compHom_eq_ph (hc.isBirationalMorphism_flip n) ?_
    rw [compHom_compHom_ph, compHom_compHom_ph, ← hpq n hn, ← hpq' n hn', ← compHom_compHom_ph,
      ← compHom_compHom_ph, ih (by omega) (by omega)]

/-- The maps `p_k ∘ p_i⁻¹` of a model dominating a chain over `S` lie over `S`. -/
private theorem isOver_compHom_of_isFlipChain {W : Scheme.{0}} [IsIntegral W] {m : ℕ}
    (p : ∀ i, i ≤ m → (W ⟶ V i)) (hpq : ∀ i (hi : i < m), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i)
    {πV : ∀ k, V k ⟶ S} {gT : ∀ k, T k ⟶ S} (hfg : ∀ k, f k ≫ gT k = πV k)
    (hfpg : ∀ k, fp k ≫ gT k = πV (k + 1)) {i k : ℕ} (hi : i ≤ m) (hk : k ≤ m)
    [IsSeparated (V i ↘ ⊤_ Scheme)] {h : (V i).RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse (p i hi).toRationalMap h) :
    MMP.Flips.RationalMap.IsOver (πV i) (πV k) (h.compHom (p k hk)) := by
  have htw := tower_comp_eq_ph f fp gT πV m (fun j _ => hfg j) (fun j _ => hfpg j) p hpq
  change (h.compHom (p k hk)).compHom (πV k) = (πV i).toRationalMap
  rw [compHom_compHom_ph, htw k hk, ← htw i hi, ← compHom_compHom_ph,
    compHom_eq_id_of_isInverse_ph _ hh, toRationalMap_compHom_ph, Category.id_comp]

/-- **The composite of a chain of small flips is a nef weak model.** Let `V_0 ⤏ V_n` be the
composite of the first `n` steps of a chain of small flips over `S`, read on a smooth projective
model `W` dominating `V_0, …, V_n`, carrying `K_0, C_0` to `K_n, C_n`. If `K_n + C_n` is nef over
`S`, then `V_0 ⤏ V_n` is a nef weak model of `(V_0, C_0)`: on `W` the push-forward of
`p_0^*(K_0 + C_0) - p_n^*(K_n + C_n)` to `V_0` vanishes, so the comparison is effective by the
negativity lemma, and it vanishes along every prime divisor of `W` not exceptional over `V_n`. -/
private theorem isNefWeakModel_of_isFlipChain (hc : IsFlipChain sV sT f fp)
    [∀ k, CompactSpace (V k)] [∀ k, QuasiCompact (sV k)] {πV : ∀ k, V k ⟶ S}
    {gT : ∀ k, T k ⟶ S} (hπ : ∀ k, πV k ≫ sS = sV k) (hfg : ∀ k, f k ≫ gT k = πV k)
    (hfpg : ∀ k, fp k ≫ gT k = πV (k + 1))
    {K : ∀ k, Divisor (V k)} (hK0 : ∃ n, (K 0).IsCanonicalDivisor (sV 0) n)
    (hK : ∀ k, K (k + 1) = flipTransform (f k) (fp k) (K k))
    {C : ∀ k, RDivisor (V k)} (hC : ∀ k, C (k + 1) = flipTransform (f k) (fp k) (C k))
    {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]
    {sW : W ⟶ Spec (.of ℂ)} (hWv : MMP.Mori.IsVariety ℂ sW) (hWsm : IsSmoothScheme sW)
    (hWp : MMP.Mori.IsProjectiveVariety ℂ sW) {n : ℕ} (p : ∀ i, i ≤ n → (W ⟶ V i))
    (hp : ∀ i (hi : i ≤ n), p i hi ≫ sV i = sW ∧ IsProjectiveMorphism (p i hi) ∧
      IsBirationalMorphism (p i hi))
    (hpq : ∀ i (hi : i < n), p i hi.le ≫ f i = p (i + 1) hi ≫ fp i)
    {h : (V 0).RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse (p 0 (Nat.zero_le n)).toRationalMap h)
    (hnef : IsRelativelyNef ℂ (sV n) (πV n) (logCanonicalDivisor (K n) (C n))) :
    IsNefWeakModel (sV 0) (sV n) sS (πV 0) (πV n) (K 0) (C 0) (h.compHom (p n le_rfl)) := by
  have hVv := isNormalVariety_of_isFlipChain hc
  haveI hsep : ∀ j, IsSeparated (V j ↘ ⊤_ Scheme) := fun j => by
    haveI := (hVv j).1.toIsSeparated
    exact isSeparated_toTerminal_ph (sV j)
  haveI hpP : ∀ j (hj : j ≤ n), IsProper (p j hj) := fun j hj =>
    isProper_of_isProjectiveMorphism _ (hp j hj).2.1
  haveI hpD : ∀ j (hj : j ≤ n), IsDominant (p j hj) := fun j hj => (hp j hj).2.2.isDominant
  have hW : IsNormalVariety ℂ sW := ⟨hWv, inferInstance⟩
  have hWj : ∀ j (hj : j ≤ n), IsNormalVariety ℂ (p j hj ≫ sV j) := fun j hj => by
    rw [(hp j hj).1]; exact hW
  obtain ⟨hbir, -, hnex, htr⟩ :=
    compHom_of_isFlipChain hc hW p hp hpq (Nat.zero_le n) le_rfl hh
  have hρK : MMP.Mori.RationalMap.transformDivisor (h.compHom (p n le_rfl)) (K 0) = K n :=
    htr K hK
  have hρC : MMP.Mori.RationalMap.transformDivisor (h.compHom (p n le_rfl)) (C 0) = C n :=
    htr C hC
  have hL : IsCartierCombination (logCanonicalDivisor (K 0) (C 0)) :=
    (exists_hasVal (hc.isQFactorial 0) _ 0).choose_spec.isCartierCombination
  have hM : IsCartierCombination (logCanonicalDivisor (K n) (C n)) :=
    (exists_hasVal (hc.isQFactorial n) _ 0).choose_spec.isCartierCombination
  obtain ⟨GY, hGY, -⟩ := existsUnique_isRCartierPullback (p 0 (Nat.zero_le n)) hL
  obtain ⟨GZ, hGZ, -⟩ := existsUnique_isRCartierPullback (p n le_rfl) hM
  have htw := tower_comp_eq_ph f fp gT πV n (fun j _ => hfg j) (fun j _ => hfpg j) p hpq
  -- the comparison vanishes along the primes of `W` over prime divisors of `V_0`
  have hzero : ∀ (P : MMP.Mori.PrimeDivisor W) (Q : MMP.Mori.PrimeDivisor (V 0)),
      p 0 (Nat.zero_le n) P.genericPoint = Q.genericPoint → (GY - GZ).coeff P = 0 := by
    intro P Q hPQ
    obtain ⟨Qn, hQn, hD⟩ := exists_primeDivisor_forall_of_isFlipChain hc p hpq P.genericPoint
      (Nat.zero_le n) hPQ n le_rfl
    haveI := isIso_stalkMap_of_map_eq_genericPoint (hp 0 (Nat.zero_le n)).2.2 hPQ
    haveI := isIso_stalkMap_of_map_eq_genericPoint (hp n le_rfl).2.2 hQn
    rw [DivisorWithCoeffs.coeff_sub, MMP.Fourfold.coeff_eq_of_isRCartierPullback P Q hPQ hGY,
      MMP.Fourfold.coeff_eq_of_isRCartierPullback P Qn hQn hGZ]
    simp only [logCanonicalDivisor, DivisorWithCoeffs.coeff_apply, Finsupp.add_apply,
      toRDivisor_apply]
    rw [hD K hK, hD C hC, sub_self]
  have hpush : MMP.Mori.RationalMap.transformDivisor (p 0 (Nat.zero_le n)).toRationalMap
      (GY - GZ) = 0 := by
    refine Finsupp.ext fun Q => ?_
    obtain ⟨E, hE, -, htrE⟩ := MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply
      (hVv 0) (hWj 0 (Nat.zero_le n)) (hp 0 (Nat.zero_le n)).2.2 Q
    rw [htrE]
    exact hzero E Q hE
  have hEff := MMP.Fourfold.nonneg_sub_of_nonneg_transformDivisor_sub sW (sV 0) (sV n) hW hWp
    (hVv 0) (hc.isProjectiveVariety 0) (hVv n) (hc.isProjectiveVariety n) (πV 0) (πV n)
    (p 0 (Nat.zero_le n)) (p n le_rfl) (hp 0 (Nat.zero_le n)).1 (hp n le_rfl).1 (htw n le_rfl).symm
    (hp 0 (Nat.zero_le n)).2.1 (hp 0 (Nat.zero_le n)).2.2 (hp n le_rfl).2.1 (hp n le_rfl).2.2 hL hnef hGY hGZ
    (by rw [hpush])
  have hdimn : topologicalKrullDim (V n) = (3 : ℕ) := by exact_mod_cast hc.dim_eq n
  have hdimW : topologicalKrullDim W = topologicalKrullDim (V n) := by
    haveI : MMP.Mori.IsVariety ℂ (sV n) := (hVv n).1
    haveI : MMP.Mori.IsVariety ℂ sW := hWv
    exact (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism (sV n) sW
      (hp n le_rfl).2.2).symm
  haveI : LocallyOfFiniteType (sV n) := (hVv n).1.toLocallyOfFiniteType
  have hExc : ∀ P, (GY - GZ).coeff P ≠ 0 →
      MMP.Flips.IsExceptionalPrimeDivisor (sV n) (p n le_rfl) P := by
    intro P hP
    rcases le_or_gt (Order.coheight (p n le_rfl P.genericPoint)) 1 with hle | hgt
    · exfalso
      have hge := MMP.Flips.coheight_le_coheight_map (sV n) sW (hVv n).1 hWv (p n le_rfl)
        (hp n le_rfl).1 hdimW P.genericPoint
      rw [P.coheight_genericPoint] at hge
      have h1 : Order.coheight (p n le_rfl P.genericPoint) = 1 := le_antisymm hle hge
      obtain ⟨Q0, hQ0, -⟩ := exists_primeDivisor_forall_of_isFlipChain hc p hpq P.genericPoint
        le_rfl (P := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ h1)
        (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ h1).symm 0 (Nat.zero_le n)
      exact hP (hzero P Q0 hQ0)
    · refine isExceptionalPrimeDivisor_of_two_le_coheight_ph hdimn (hWj n le_rfl)
        (hp n le_rfl).2.2 P ?_
      have := Order.add_one_le_of_lt hgt
      rwa [one_add_one_eq_two] at this
  exact
    { isNormalVariety_source := hVv 0
      isProjectiveVariety_source := hc.isProjectiveVariety 0
      comp_eq_source := hπ 0
      isCanonicalDivisor := hK0
      isCartierCombination := hL
      isNormalVariety_target := hVv n
      isProjectiveVariety_target := hc.isProjectiveVariety n
      comp_eq_target := hπ n
      isBirational := hbir
      isOver := isOver_compHom_of_isFlipChain p hpq hfg hfpg (Nat.zero_le n) le_rfl hh
      not_isInverseExceptional := hnex
      isRelativelyNef := by rw [hρK, hρC]; exact hnef
      exists_resolution := ⟨W, inferInstance, inferInstance, inferInstance, sW,
        p 0 (Nat.zero_le n), p n le_rfl, h, hWv, hWsm, (hp 0 (Nat.zero_le n)).1, (hp n le_rfl).1,
        (hp 0 (Nat.zero_le n)).2.1, (hp n le_rfl).2.1, (hp 0 (Nat.zero_le n)).2.2, (hp n le_rfl).2.2, hh, rfl, GY, GZ, hGY,
        by rw [hρK, hρC]; exact hGZ, fun P => hEff P, hExc⟩ }

/-- If `h` is an inverse of `p`, then `(p ∘ τ) ∘ h = τ`. -/
private theorem compHom_comp_of_isInverse_ph {X W Y : Scheme.{0}} [IsIntegral X] [IsIntegral W]
    [IsIntegral Y] {p : W ⟶ Y} [IsDominant p] {h : Y.RationalMap W}
    (hh : MMP.Mori.RationalMap.IsInverse p.toRationalMap h) (τ : X.RationalMap W)
    [τ.IsDominant] [(τ.compHom p).IsDominant] : (τ.compHom p).comp h = τ := by
  rw [← MMP.Fourfold.Crepant.comp_eq_comp_of_eq (Scheme.RationalMap.comp_toRationalMap τ p) h,
    Scheme.RationalMap.comp_assoc, MMP.Fourfold.Crepant.comp_eq_id_of_isInverse hh,
    Scheme.RationalMap.comp_id]

/-- **No infinite chain of small flips with strictly decreasing nef levels.** Let
`V_k ⟶ T_k ⟵ V_{k+1}` be a chain of small flips over `S` of projective `ℚ`-factorial threefolds,
carrying a canonical divisor `K`, an effective boundary `B` and an effective divisor `H`, with
levels `λ_k ↓` such that `K_k + B_k + λ_k H_k` is nef over `S`, `(V_k, B_k + t_k H_k)` is klt for
some `t_k ≥ λ_k`, and `V_k` carries a curve over a point of `S` on which `K_k + B_k + λ_k H_k` is
null and `H_k` is positive. This is impossible: the composites `V_0 ⤏ V_k` are nef weak models of
the convergent boundaries `B_0 + λ_k H_0`, which therefore fall into finitely many equivalence
classes, while models of distinct levels are inequivalent. -/
private theorem false_of_isFlipChain (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hc : IsFlipChain sV sT f fp) [∀ k, CompactSpace (V k)] [∀ k, QuasiCompact (sV k)]
    {πV : ∀ k, V k ⟶ S} {gT : ∀ k, T k ⟶ S} (hπ : ∀ k, πV k ≫ sS = sV k)
    (hfg : ∀ k, f k ≫ gT k = πV k) (hfpg : ∀ k, fp k ≫ gT k = πV (k + 1))
    {K : ∀ k, Divisor (V k)} (hK0 : ∀ k, ∃ n, (K k).IsCanonicalDivisor (sV k) n)
    (hK : ∀ k, K (k + 1) = flipTransform (f k) (fp k) (K k))
    {B H : ∀ k, RDivisor (V k)} (hB : ∀ k, B (k + 1) = flipTransform (f k) (fp k) (B k))
    (hH : ∀ k, H (k + 1) = flipTransform (f k) (fp k) (H k))
    (hB0 : ∀ k, 0 ≤ B k) (hH0 : ∀ k, 0 ≤ H k)
    {lam t : ℕ → ℝ} (hlam : StrictAnti lam) (hlam0 : ∀ k, 0 < lam k) (hlamt : ∀ k, lam k ≤ t k)
    (hklt : ∀ k, IsRealKltPair (sV k) (B k + t k • H k))
    (hnef : ∀ k, IsRelativelyNef ℂ (sV k) (πV k)
      (logCanonicalDivisor (K k) (B k + lam k • H k)))
    (hcurve : ∀ k, ∃ C : ProperCurve (sV k), C.IsContractedBy (πV k) ∧
      (∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (V k)),
        IsRIntersectionNumber ℂ (sV k) (logCanonicalDivisor (K k) (B k + lam k • H k)) r L C 0) ∧
      ∃ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (V k)) (x : ℝ),
        IsRIntersectionNumber ℂ (sV k) (H k) r L C x ∧ 0 < x) : False := by
  classical
  haveI : IsSeparated sS := hS.toIsVariety.toIsSeparated
  have hVv := isNormalVariety_of_isFlipChain hc
  haveI hsep : ∀ j, IsSeparated (V j ↘ ⊤_ Scheme) := fun j => by
    haveI := (hVv j).1.toIsSeparated
    exact isSeparated_toTerminal_ph (sV j)
  -- the families transported along the chain at a fixed level
  have hC : ∀ c : ℝ, ∀ k, B (k + 1) + c • H (k + 1) =
      flipTransform (f k) (fp k) (B k + c • H k) := fun c k => by
    rw [map_add, flipTransform_smul, ← hB k, ← hH k]
  -- towers of smooth projective models
  have htower := fun n => exists_tower_ph sV sT f fp n (fun i _ => hc.isProjectiveVariety i)
    (fun i _ => hc.isNormalVariety_target i)
    (fun i _ => ⟨(hc.isSmall i).isProper, hc.isBirationalMorphism i, (hc.isSmall i).comp_eq⟩)
    (fun i _ => ⟨(hc.isSmall_flip i).isProper, hc.isBirationalMorphism_flip i,
      (hc.isSmall_flip i).comp_eq⟩) n le_rfl
  choose W hWi hWl hWn hWc sW p hv using htower
  have hinv : ∀ n, ∃ h₀ : (V 0).RationalMap (W n),
      MMP.Mori.RationalMap.IsInverse ((p n) 0 (Nat.zero_le n)).toRationalMap h₀ := fun n =>
    MMP.Mori.RationalMap.IsBirational.exists_isInverse ((hv n).2.2.2.1 0 (Nat.zero_le n)).2.2
  choose h₀ hh₀ using hinv
  let φ : ∀ n, (V 0).RationalMap (V n) := fun n => (h₀ n).compHom (p n n le_rfl)
  have hWN : ∀ n, IsNormalVariety ℂ (sW n) := fun n => by
    haveI := hWi n; haveI := hWn n; exact ⟨(hv n).1, inferInstance⟩
  have hφ : ∀ n, MMP.Mori.RationalMap.IsBirational (φ n) ∧
      (∀ G : MMP.Mori.PrimeDivisor (V 0), ¬ MMP.Mori.RationalMap.IsExceptional (φ n) G) ∧
      (∀ F : MMP.Mori.PrimeDivisor (V n),
        ¬ MMP.Flips.RationalMap.IsInverseExceptional (φ n) F) ∧
      (∀ {R : Type} [AddCommMonoid R] (D : ∀ k, DivisorWithCoeffs R (V k)),
        (∀ k, D (k + 1) = flipTransform (f k) (fp k) (D k)) →
          MMP.Mori.RationalMap.transformDivisor (φ n) (D 0) = D n) := fun n => by
    haveI := hWi n; haveI := hWl n; haveI := hWn n
    exact compHom_of_isFlipChain hc (hWN n) (p n) (hv n).2.2.2.1 (hv n).2.2.2.2 (Nat.zero_le n)
      le_rfl (hh₀ n)
  have hWM : ∀ n, IsNefWeakModel (sV 0) (sV n) sS (πV 0) (πV n) (K 0) (B 0 + lam n • H 0)
      (φ n) := fun n => by
    haveI := hWi n; haveI := hWl n; haveI := hWn n; haveI := hWc n
    exact isNefWeakModel_of_isFlipChain hc hπ hfg hfpg (hK0 0) hK
      (C := fun k => B k + lam n • H k) (hC (lam n)) (hv n).1
      (hv n).2.1 (hv n).2.2.1 (p n) (hv n).2.2.2.1 (hv n).2.2.2.2 (hh₀ n) (hnef n)
  -- the levels converge
  have hbdd : BddBelow (Set.range lam) := ⟨0, by rintro _ ⟨k, rfl⟩; exact (hlam0 k).le⟩
  set lamInf := ⨅ k, lam k with hlamInf
  have hlim : Filter.Tendsto lam Filter.atTop (nhds lamInf) :=
    tendsto_atTop_ciInf hlam.antitone hbdd
  have hInf0 : 0 ≤ lamInf := le_ciInf fun k => (hlam0 k).le
  have hInf1 : lamInf ≤ t 0 := (ciInf_le hbdd 0).trans (hlamt 0)
  have hle_klt : ∀ k {c : ℝ}, 0 ≤ c → c ≤ t k → IsRealKltPair (sV k) (B k + c • H k) :=
    fun k c hc0 hct => IsRealKltPair.of_le (hc.isQFactorial k) (fun P => by
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
      have := hH0 k P
      have : c * (H k).coeff P ≤ t k * (H k).coeff P :=
        mul_le_mul_of_nonneg_right hct (by simpa [DivisorWithCoeffs.coeff_apply] using this)
      linarith) (hklt k)
  have hK3 : (K 0).IsCanonicalDivisor (sV 0) 3 := by
    obtain ⟨d, hd⟩ := hK0 0
    have h3 := hd.topologicalKrullDim_eq
    rw [hc.dim_eq 0] at h3
    have : d = 3 := by exact_mod_cast h3.symm
    subst this
    exact hd
  -- the nef weak models of the convergent boundaries fall into finitely many classes
  obtain ⟨F, hF⟩ := MMP.Fourfold.exists_finset_isNefModelEquivalent_of_tendsto
    (hc.isProjectiveVariety 0) (hc.isQFactorial 0) hK3 hS (πV 0) (hπ 0)
    (fun i => B 0 + lam i • H 0) (B 0 + lamInf • H 0)
    (fun i => add_nonneg (hB0 0) (smul_nonneg (hlam0 i).le (hH0 0)))
    ((B 0).support ∪ (H 0).support)
    (fun i => Finsupp.support_add.trans (Finset.union_subset_union le_rfl Finsupp.support_smul))
    (fun P => by
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
      exact tendsto_const_nhds.add (hlim.mul_const _))
    (hle_klt 0 hInf0 hInf1) V sV πV φ hWM hc.isQFactorial (fun i => (hφ i).2.1)
  -- a model outside the finite set of representatives
  set a := F.sup id + 1 with ha
  obtain ⟨j, hjF, ea, ej, hea, hej, heq⟩ := hF a
  have hja : j < a := Nat.lt_succ_of_le (Finset.le_sup (f := id) hjF)
  -- the equivalence, read from `V_j` to `V_a`
  have heq' := (MMP.Fourfold.isNefModelEquivalent_equivalence_and_refinement (k := ℂ)).2.1
    (sV a) (sV j) sS (πV a) (πV j) _ _ _ _ _ _ heq
    (MMP.Mori.RationalMap.isInverse_toRationalMap (ea.symm.trans ej))
  -- the transforms along the composites are the models' divisors
  have hTK : ∀ n, MMP.Mori.RationalMap.transformDivisor (φ n) (K 0) = K n := fun n =>
    (hφ n).2.2.2 K hK
  have hTC : ∀ n c, MMP.Mori.RationalMap.transformDivisor (φ n) (B 0 + c • H 0) =
      B n + c • H n := fun n c => (hφ n).2.2.2 (fun k => B k + c • H k) (hC c)
  rw [hTK, hTC, hTK, hTC] at heq'
  -- the comparison map `V_j ⤏ V_a`, read on the tower of `V_a`
  haveI := hWi a; haveI := hWl a; haveI := hWn a
  have hpa := (hv a).2.2.2.1
  have hpqa := (hv a).2.2.2.2
  obtain ⟨hj', hjinv⟩ := MMP.Mori.RationalMap.IsBirational.exists_isInverse (hpa j hja.le).2.2
  obtain ⟨ha', hainv⟩ := MMP.Mori.RationalMap.IsBirational.exists_isInverse (hpa a le_rfl).2.2
  obtain ⟨hχb, hχexc, -, hχtr⟩ :=
    compHom_of_isFlipChain hc (hWN a) (p a) hpa hpqa hja.le le_rfl hjinv
  obtain ⟨hχ'b, hχ'exc, -, -⟩ :=
    compHom_of_isFlipChain hc (hWN a) (p a) hpa hpqa le_rfl hja.le hainv
  haveI : (hj'.compHom (p a a le_rfl)).IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational hχb
  haveI : (ha'.compHom (p a j hja.le)).IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational hχ'b
  haveI : ∀ n, (φ n).IsDominant := fun n =>
    MMP.Fourfold.Crepant.isDominant_of_isBirational (hφ n).1
  haveI : hj'.IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational hjinv.isBirational_inverse
  haveI : ha'.IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational hainv.isBirational_inverse
  haveI : (h₀ a).IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational (hh₀ a).isBirational_inverse
  haveI : ∀ n (hn : n ≤ a), IsDominant (p a n hn) := fun n hn => (hpa n hn).2.2.isDominant
  -- `φ_j = p_j ∘ p_0⁻¹` on the tower of `V_a`
  have hφj : φ j = (h₀ a).compHom (p a j hja.le) := by
    haveI := hWi j
    exact compHom_eq_compHom_of_isFlipChain hc (p j) (fun i hi => ((hv j).2.2.2.1 i hi).2.2)
      (hv j).2.2.2.2 (p a) (fun i hi => (hpa i hi).2.2) hpqa (hh₀ j) (hh₀ a) j le_rfl hja.le
  haveI : ((h₀ a).compHom (p a j hja.le)).IsDominant := by rw [← hφj]; infer_instance
  -- `φ_j ∘ χ = φ_a` for `χ = p_a ∘ p_j⁻¹`
  have hjχ : (φ j).comp (hj'.compHom (p a a le_rfl)) = φ a := by
    rw [MMP.Fourfold.Crepant.comp_eq_comp_of_eq hφj, comp_compHom_ph,
      compHom_comp_of_isInverse_ph hjinv (h₀ a)]
  -- `φ_j ∘ ψ' = φ_a` for the inverse `ψ'` of the comparison map of the equivalence
  haveI : ea.toRationalMap.IsDominant := by rw [hea]; infer_instance
  haveI : (ea.symm.trans ej).toRationalMap.IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational
      (MMP.Mori.RationalMap.isBirational_toRationalMap _)
  haveI : (ea.symm.trans ej).symm.toRationalMap.IsDominant :=
    MMP.Fourfold.Crepant.isDominant_of_isBirational
      (MMP.Mori.RationalMap.isBirational_toRationalMap _)
  have hPT : (φ a).comp (ea.symm.trans ej).toRationalMap = φ j := by
    rw [← MMP.Fourfold.Crepant.comp_eq_comp_of_eq hea, comp_symm_trans_toRationalMap_ph ea ej,
      hej]
  have hψψ' : (ea.symm.trans ej).toRationalMap.comp (ea.symm.trans ej).symm.toRationalMap =
      Scheme.RationalMap.id (V a) :=
    MMP.Fourfold.Crepant.comp_eq_id_of_isInverse
      (MMP.Mori.RationalMap.isInverse_toRationalMap (ea.symm.trans ej))
  have hjψ' : (φ j).comp (ea.symm.trans ej).symm.toRationalMap = φ a := by
    rw [← MMP.Fourfold.Crepant.comp_eq_comp_of_eq hPT, Scheme.RationalMap.comp_assoc, hψψ',
      Scheme.RationalMap.comp_id]
  have hψ'χ : (ea.symm.trans ej).symm.toRationalMap = hj'.compHom (p a a le_rfl) :=
    eq_of_comp_eq_ph (hφ j).1 (hjψ'.trans hjχ.symm)
  rw [hψ'χ] at heq'
  -- `χ` is an isomorphism in codimension one
  have hχχ' : (hj'.compHom (p a a le_rfl)).comp (ha'.compHom (p a j hja.le)) =
      Scheme.RationalMap.id (V j) := by
    rw [comp_compHom_ph, compHom_comp_of_isInverse_ph hainv hj', compHom_eq_id_of_isInverse_ph _ hjinv,
      toRationalMap_id_ph]
  have hiso : MMP.Mori.RationalMap.IsIsomorphismInCodimOne (hj'.compHom (p a a le_rfl)) := by
    refine ⟨hχb, hχexc, fun ρ hρ E => ?_⟩
    haveI : ρ.IsDominant := MMP.Fourfold.Crepant.isDominant_of_isBirational
      hρ.isBirational_inverse
    have hρχ : ρ.comp (hj'.compHom (p a a le_rfl)) = Scheme.RationalMap.id (V a) :=
      MMP.Fourfold.Crepant.comp_eq_id_of_isInverse hρ.symm
    have : ρ = ha'.compHom (p a j hja.le) := by
      calc ρ = ρ.comp (Scheme.RationalMap.id (V j)) := (Scheme.RationalMap.comp_id ρ).symm
        _ = ρ.comp ((hj'.compHom (p a a le_rfl)).comp (ha'.compHom (p a j hja.le))) := by
          rw [hχχ']
        _ = (ρ.comp (hj'.compHom (p a a le_rfl))).comp (ha'.compHom (p a j hja.le)) :=
          (Scheme.RationalMap.comp_assoc _ _ _).symm
        _ = (Scheme.RationalMap.id (V a)).comp (ha'.compHom (p a j hja.le)) :=
          MMP.Fourfold.Crepant.comp_eq_comp_of_eq hρχ _
        _ = ha'.compHom (p a j hja.le) := Scheme.RationalMap.id_comp _
    rw [this]
    exact hχ'exc E
  have hover : MMP.Flips.RationalMap.IsOver (πV j) (πV a) (hj'.compHom (p a a le_rfl)) :=
    isOver_compHom_of_isFlipChain (p a) hpqa hfg hfpg hja.le le_rfl hjinv
  -- the null curve of the higher level
  obtain ⟨C, hCS, hzero, hpos⟩ := hcurve j
  have hdj : topologicalKrullDim (V j) = 3 := hc.dim_eq j
  have hda : topologicalKrullDim (V a) = 3 := hc.dim_eq a
  exact MMP.Fourfold.not_isNefModelEquivalent_of_lt_of_isRIntersectionNumber_pos (k := ℂ)
    (sV j) (sV a) sS (πV j) (πV a) (hc.isProjectiveVariety j) (hc.isProjectiveVariety a)
    (hc.isQFactorial j) (hc.isQFactorial a) hdj hda (hπ j) (hπ a) (hj'.compHom (p a a le_rfl)) hiso hover (hK0 j)
    (hχtr K hK).symm (hχtr B hB).symm (hχtr H hH).symm (hlam hja) (hlam0 a).le
    (add_nonneg (hB0 j) (smul_nonneg (hlam0 j).le (hH0 j)))
    (add_nonneg (hB0 a) (smul_nonneg (hlam0 a).le (hH0 a)))
    (hle_klt j (hlam0 j).le (hlamt j)) (hle_klt a (hlam0 a).le (hlamt a)) (hnef j) (hnef a)
    C hCS hzero hpos heq'

end Chain

/-- **No infinite tail of flips.** An infinite sequence of good flip steps with strictly
decreasing thresholds is impossible. -/
private theorem false_of_isRealFlipStep_tail (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hh : ∀ j, 0 < h j) (s0 : Stage S l) (next : (s : Stage S l) → StepData s)
    (hgood : ∀ i, IsGood sS h (Stage.seq s0 next i))
    (hstep : ∀ i, IsGoodStep sS h (Stage.seq s0 next i) (next (Stage.seq s0 next i)))
    (N : ℕ)
    (hflip : ∀ i, N ≤ i → IsRealFlipStep (Stage.seq s0 next i).sX
      (next (Stage.seq s0 next i)).sZs (Stage.seq s0 next (i + 1)).sX (Stage.seq s0 next i).K
      (Stage.seq s0 next i).B (Stage.seq s0 next (i + 1)).K (Stage.seq s0 next (i + 1)).B
      (next (Stage.seq s0 next i)).f (next (Stage.seq s0 next i)).fp)
    (hlt : ∀ i, N ≤ i → (Stage.seq s0 next (i + 2)).t₀ < (Stage.seq s0 next (i + 1)).t₀) :
    False := by
  haveI : ∀ k, QuasiCompact (Stage.seq s0 next (N + k)).sX := fun k =>
    (hgood (N + k)).1.toIsVariety.toQuasiCompact
  have hfl : ∀ k, IsRealFlipStep (Stage.seq s0 next (N + k)).sX
      (next (Stage.seq s0 next (N + k))).sZs (Stage.seq s0 next (N + k + 1)).sX
      (Stage.seq s0 next (N + k)).K (Stage.seq s0 next (N + k)).B
      (Stage.seq s0 next (N + k + 1)).K (Stage.seq s0 next (N + k + 1)).B
      (next (Stage.seq s0 next (N + k))).f (next (Stage.seq s0 next (N + k))).fp := fun k =>
    hflip (N + k) (Nat.le_add_right N k)
  have hc : IsFlipChain (fun k => (Stage.seq s0 next (N + k)).sX)
      (fun k => (next (Stage.seq s0 next (N + k))).sZs)
      (fun k => (next (Stage.seq s0 next (N + k))).f)
      (fun k => (next (Stage.seq s0 next (N + k))).fp) :=
    { isProjectiveVariety := fun k => (hgood (N + k)).1
      isQFactorial := fun k => (hgood (N + k)).2.1
      dim_eq := fun k => (hgood (N + k)).2.2.2.1
      isNormalVariety_target := fun k =>
        (hfl k).isNegativeExtremalContraction.isNormalVariety_target
      isSmall := fun k => (hfl k).isSmall
      isSmall_flip := fun k => (hfl k).isSmall_flip
      isBirationalMorphism := fun k => (hfl k).isBirationalMorphism
      isBirationalMorphism_flip := fun k => (hfl k).isBirationalMorphism_flip }
  refine false_of_isFlipChain (πV := fun k => (Stage.seq s0 next (N + k)).πX)
    (gT := fun k => (next (Stage.seq s0 next (N + k))).g)
    (K := fun k => (Stage.seq s0 next (N + k)).K) (B := fun k => (Stage.seq s0 next (N + k)).B)
    (H := fun k => scaling h (Stage.seq s0 next (N + k)).Hq)
    (lam := fun k => (Stage.seq s0 next (N + k + 1)).t₀)
    (t := fun k => (Stage.seq s0 next (N + k)).t₀) hS hc
    (fun k => (hgood (N + k)).2.2.1) (fun k => (hstep (N + k)).2.1.2.2.1.comp_eq)
    (fun k => (hstep (N + k)).2.1.2.2.2.2.1) (fun k => (hgood (N + k)).2.2.2.2.1)
    (fun k => (hstep (N + k)).2.2.2.2.2.2.2 (hfl k)) (fun k => (hfl k).eq_flipTransform)
    (fun k => ?_) (fun k => (hgood (N + k)).2.2.2.2.2.1)
    (fun k => scaling_nonneg hh (hgood (N + k)).2.2.2.2.2.2.2.1)
    (strictAnti_nat_of_succ_lt fun k => hlt (N + k) (Nat.le_add_right N k))
    (fun k => (hgood (N + k + 1)).2.2.2.2.2.2.2.2.2.2.1) (fun k => (hstep (N + k)).2.2.1)
    (fun k => (hgood (N + k)).2.2.2.2.2.2.2.2.2.2.2.1) (fun k => (hstep (N + k)).2.2.2.1)
    (fun k => ?_)
  · change scaling h (next (Stage.seq s0 next (N + k))).t.Hq =
      flipTransform (next (Stage.seq s0 next (N + k))).f (next (Stage.seq s0 next (N + k))).fp
        (scaling h (Stage.seq s0 next (N + k)).Hq)
    rw [flipTransform_scaling]
    exact congrArg (scaling h) (funext fun j => (hstep (N + k)).2.2.2.2.2.2.1 j)
  · have hst := (hstep (N + k)).2.1
    have hX := (hgood (N + k)).1
    have hXQ := (hgood (N + k)).2.1
    have hπk := (hgood (N + k)).2.2.1
    obtain ⟨Ra, C₀, -, -, hC₀, -, htr⟩ := exists_absoluteRay_of_isStep hS hst hX hπk
    obtain ⟨hC₀π, hC₀r⟩ := htr C₀ hC₀
    obtain ⟨v, hv⟩ := exists_hasVal hXQ (logCanonicalDivisor (Stage.seq s0 next (N + k)).K
      ((Stage.seq s0 next (N + k)).B +
        (next (Stage.seq s0 next (N + k))).t.t₀ • scaling h (Stage.seq s0 next (N + k)).Hq))
      (OneCycle.numericalClass _ (C₀.cycle ℝ))
    obtain ⟨m, r, L, hx⟩ := hv.isRIntersectionNumber
    have hv0 := (hstep (N + k)).2.2.2.2.1 C₀ hC₀π hC₀r m r L v hx
    obtain ⟨w, hw⟩ := exists_hasVal hXQ (scaling h (Stage.seq s0 next (N + k)).Hq)
      (OneCycle.numericalClass _ (C₀.cycle ℝ))
    obtain ⟨m', r', L', hx'⟩ := hw.isRIntersectionNumber
    exact ⟨C₀, hC₀π, ⟨m, r, L, hv0 ▸ hx⟩, m', r', L', w, hx',
      (hstep (N + k)).2.2.2.2.2.1 C₀ hC₀π hC₀r m' r' L' w hx'⟩

/-- **No infinite program.** -/
private theorem false_of_forall_isGoodStep (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hh : ∀ j, 0 < h j) (s0 : Stage S l) (next : (s : Stage S l) → StepData s)
    (hgood0 : IsGood sS h s0)
    (hstep : ∀ i, IsGoodStep sS h (Stage.seq s0 next i) (next (Stage.seq s0 next i)))
    (hnef : ∀ i, ¬ IsRelativelyNef ℂ (Stage.seq s0 next i).sX (Stage.seq s0 next i).πX
      (logCanonicalDivisor (Stage.seq s0 next i).K (Stage.seq s0 next i).B)) : False := by
  have hgood : ∀ i, IsGood sS h (Stage.seq s0 next i) := by
    intro i
    cases i with
    | zero => exact hgood0
    | succ i => exact (hstep i).1
  let ρ : ℕ → ℕ∞ := fun i => picardNumber (Stage.seq s0 next i).sX
  have hanti : ∀ i, ρ (i + 1) ≤ ρ i := fun i => (picardNumber_le_of_isGoodStep hS (hgood i)
    (hstep i)).1
  have h0 : ρ 0 < ⊤ := by
    haveI : AlgebraicGeometry.IsProjectiveVariety ℂ s0.sX := hgood0.1
    exact MMP.Mori.picardNumber_lt_top_of_isProjectiveVariety s0.sX
  have hle0 : ∀ i, ρ i ≤ ρ 0 := by
    intro i
    induction i with
    | zero => exact le_rfl
    | succ i ih => exact (hanti i).trans ih
  have hfin : ∀ i, ρ i ≠ ⊤ := fun i => ((hle0 i).trans_lt h0).ne
  let dρ : ℕ → ℕ := fun i => (ρ i).toNat
  have hd : ∀ i, (dρ i : ℕ∞) = ρ i := fun i => ENat.coe_toNat (hfin i)
  have hdanti : Antitone dρ := antitone_nat_of_succ_le fun i => by
    have := hanti i
    rw [← hd, ← hd] at this
    exact_mod_cast this
  obtain ⟨N, hN⟩ : ∃ N, ∀ i, dρ N ≤ dρ i :=
    ⟨Function.argmin dρ, fun i => Function.argmin_le dρ i⟩
  have hflip : ∀ i, N ≤ i → IsRealFlipStep (Stage.seq s0 next i).sX
      (next (Stage.seq s0 next i)).sZs (Stage.seq s0 next (i + 1)).sX (Stage.seq s0 next i).K
      (Stage.seq s0 next i).B (Stage.seq s0 next (i + 1)).K (Stage.seq s0 next (i + 1)).B
      (next (Stage.seq s0 next i)).f (next (Stage.seq s0 next i)).fp := by
    intro i hi
    by_contra hnot
    have h := (picardNumber_le_of_isGoodStep hS (hgood i) (hstep i)).2 hnot
    change ρ (i + 1) < ρ i at h
    rw [← hd, ← hd] at h
    have h' : dρ (i + 1) < dρ i := by exact_mod_cast h
    have := hN (i + 1)
    have := hdanti hi
    omega
  exact false_of_isRealFlipStep_tail hS hh s0 next hgood hstep N hflip fun i hi =>
    t₀_lt_of_isRealFlipStep hS hh (hgood i) (hstep i) (hflip i hi) (hstep (i + 1))

/-- The value of an intersection number of a presented divisor on a curve. -/
private theorem eq_sum_degreeOn_of_isRIntersectionNumber {X : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {D : RDivisor X} {m : ℕ} {r : Fin m → ℝ} {L : Fin m → Divisor X}
    (hL : ∀ j, (L j).IsCartier) (hD : D = ∑ j, r j • Divisor.toRDivisor (L j)) {C : ProperCurve sX}
    {m' : ℕ} {r' : Fin m' → ℝ} {L' : Fin m' → Divisor X} {x : ℝ}
    (hx : IsRIntersectionNumber ℂ sX D r' L' C x) :
    x = ∑ j, r j * ((L j).degreeOn ℂ sX C.ι C.dim_le (hL j) : ℝ) := by
  have h1 : HasVal sX D (OneCycle.numericalClass sX (C.cycle ℝ))
      (pval sX (OneCycle.numericalClass sX (C.cycle ℝ)) r L hL) := by
    rw [hD]; exact hasVal_of_eq r L hL _
  rw [(IsRIntersectionNumber.hasVal hx).unique h1]
  exact Finset.sum_congr rfl fun j _ => by rw [degree_numericalClass_cycle (hL j) C]

/-- The intersection number of the class of a Cartier divisor `A` with a proper curve is the
degree along the curve of the Weil divisor of `A`. -/
private theorem intersectionNumber_ofCartier_eq_degreeOn' {X : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    {A : X.CartierDivisor} {w : Divisor X} (hA : MMP.Intersection.IsWeilDivisorOfCartier A w)
    (C : ProperCurve sX) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ A) =
      (w.degreeOn ℂ sX C.ι C.dim_le hA.isCartier : ℝ) := by
  have := hA.isCartier.isInvertibleModule_divisorialSheaf
  obtain ⟨e⟩ := hA.nonempty_sheaf_iso_divisorialSheaf
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]
  exact_mod_cast degreeOn_eq_of_iso ℂ sX C.ι C.dim_le e

section WeilOfCartier

open Opposite MMP.Intersection

variable {Y : Scheme.{0}} [IsIntegral Y]

private theorem genericPoint_specializes_component_wc (Z : irreducibleComponents Y) :
    genericPoint Y ⤳ componentGenericPoint Y Z :=
  (genericPoint_spec Y).specializes trivial

variable [IsLocallyNoetherian Y]

/-- The order of a regular function at a point of coheight one is the length of its quotient. -/
private theorem scheme_ord_algebraMap_wc {z : Y} (hz : Order.coheight z = 1)
    {a : Y.presheaf.stalk z} (ha : a ≠ 0) :
    Y.ord (algebraMap (Y.presheaf.stalk z) Y.functionField a) z = (Ring.ord _ a).toNat := by
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk z) := krullDimLE_of_coheight_le hz.le
  have hne : algebraMap (Y.presheaf.stalk z) Y.functionField a ≠ 0 := by
    rwa [Ne, IsFractionRing.to_map_eq_zero_iff]
  rw [Scheme.ord_eq_iff hz hne]
  unfold Scheme.ordHom
  rw [Ring.ordFrac_eq_ord _ ha]
  have hnzd : a ∈ nonZeroDivisors _ := mem_nonZeroDivisors_of_ne_zero ha
  exact Ring.ordMonoidWithZeroHom_eq_coe (R := Y.presheaf.stalk z) hnzd
    (ENat.natCast_toNat (Ring.ord_ne_top hnzd)).symm

/-- On an integral locally Noetherian scheme, a point of coheight zero lies in the support of no
Cartier divisor. -/
private theorem notMem_cartierSupport_of_coheight_eq_zero_wc (A : Y.CartierDivisor) {x : Y}
    (hx : Order.coheight x = 0) : x ∉ cartierSupport A := by
  have : Ring.KrullDimLE 0 (Y.presheaf.stalk x) := krullDimLE_of_coheight_le (by simp [hx])
  have : IsArtinianRing (Y.presheaf.stalk x) := isArtinianRing_iff_krullDimLE_zero.mpr this
  exact notMem_cartierSupport_of_isArtinianRing A x

/-- Every Cartier divisor on a Noetherian integral scheme has a Weil divisor. -/
private theorem exists_isWeilDivisorOfCartier_wc [TopologicalSpace.NoetherianSpace Y]
    (A : Y.CartierDivisor) : ∃ w : Divisor Y, IsWeilDivisorOfCartier A w := by
  have hfin := MMP.Mori.finite_setOf_genericPoint_mem (isClosed_cartierSupport A)
    (fun s hs h0 => notMem_cartierSupport_of_coheight_eq_zero_wc A h0 hs)
  refine ⟨Finsupp.ofSupportFinite (fun P => primeDivisorOrder P A) (hfin.subset fun P hP => ?_),
    fun P => ?_⟩
  · by_contra h
    have hg : (primeDivisorSubvariety P).genericPoint = P.genericPoint := rfl
    refine hP ((isOrderAlong_primeDivisorOrder A P).eq_zero_of_not_subset fun h' => h ?_)
    show P.genericPoint ∈ cartierSupport A
    rw [← hg]
    exact genericPoint_mem_cartierSupport_iff.mpr h'
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.ofSupportFinite_coe]
    exact isOrderAlong_primeDivisorOrder A P

variable [IsNormal Y]

/-- `v_P` on the factor `𝒪_{Y,η}` of `K(Y)` is the inverse of the divisorial valuation of the
corresponding rational function. -/
private theorem valuation_eq_inv_divisorialValuation_wc (P : MMP.Mori.PrimeDivisor Y)
    (s : Y.presheaf.stalk (componentGenericPoint Y P.component)) :
    P.valuation s = (P.divisorialValuation
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes_component_wc P.component)).hom s))⁻¹ := by
  rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
  rfl

/-- The principal Cartier divisor of a nonzero rational function `r` has order `ord_Q r` along
every prime divisor `Q`: a fraction `r = a / b` of the stalk at the generic point of `Q` is a local
equation, and the order of a fraction is the difference of the lengths of `a` and `b`. -/
private theorem primeDivisorOrder_principalDivisor_functionField_wc {r : Y.functionField}
    (hr : r ≠ 0) (Q : MMP.Mori.PrimeDivisor Y) :
    primeDivisorOrder Q (MMP.Intersection.principalDivisor
      (Units.map (MMP.CartierDivisorSheaf.ofFunctionField
        (X := Y) ⊤).toMonoidHom (Units.mk0 r hr))) = Scheme.ord r Q.genericPoint := by
  set c : (Y.totalQuotientSheaf.obj.obj (Opposite.op ⊤))ˣ :=
    Units.map (MMP.CartierDivisorSheaf.ofFunctionField (X := Y) ⊤).toMonoidHom
      (Units.mk0 r hr) with hc
  obtain ⟨⟨a, b⟩, hab⟩ :=
    IsLocalization.surj (nonZeroDivisors (Y.presheaf.stalk Q.genericPoint)) r
  have hbK : algebraMap _ Y.functionField (b : Y.presheaf.stalk Q.genericPoint) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [map_zero] at hab
    exact mul_ne_zero hr hbK hab
  have hfrac : IsFraction (Y.totalQuotientSheaf.presheaf.germ ⊤ Q.genericPoint trivial (c : _))
      a b := by
    refine ⟨isUnit_stalkToTotalQuotient_of_mem_nonZeroDivisors b.2, ?_⟩
    apply (totalQuotientStalkToFunctionField_bijective Q.genericPoint).1
    rw [map_mul, totalQuotientStalkToFunctionField_stalkToTotalQuotient,
      totalQuotientStalkToFunctionField_stalkToTotalQuotient]
    erw [MMP.CartierDivisorSheaf.totalQuotientStalkToFunctionField_germ_top_ofFunctionField]
    rw [mul_comm]
    exact hab
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk (primeDivisorSubvariety Q).genericPoint) :=
    krullDimLE_of_coheight_le Q.coheight_genericPoint.le
  rw [(isOrderAlong_of_isFraction (V := primeDivisorSubvariety Q)
    ⟨⊤, trivial, c, isLocalEquationOn_principalDivisor c, rfl⟩
    (mem_nonZeroDivisors_of_ne_zero ha0) b.2 hfrac).primeDivisorOrder_eq]
  have h1 := Scheme.ord_mul (x := Q.genericPoint) hr hbK
  rw [hab, scheme_ord_algebraMap_wc Q.coheight_genericPoint ha0,
    scheme_ord_algebraMap_wc Q.coheight_genericPoint (nonZeroDivisors.ne_zero b.2)] at h1
  change ((Ring.ord _ a).toNat : ℤ) -
    ((Ring.ord _ (b : Y.presheaf.stalk Q.genericPoint)).toNat : ℤ) = _
  omega

/-- A principal divisor on a normal integral locally Noetherian scheme is the Weil divisor of the
principal Cartier divisor of the same rational function. -/
private theorem exists_isWeilDivisorOfCartier_principalDivisor_wc [CompactSpace Y]
    (φ : (RationalFunctions Y)ˣ) :
    ∃ A : Y.CartierDivisor, IsWeilDivisorOfCartier A (MMP.Mori.principalDivisor φ) := by
  obtain ⟨Z₀⟩ : Nonempty (irreducibleComponents Y) :=
    ⟨⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩⟩
  have : Subsingleton (irreducibleComponents Y) :=
    (irreducibleComponents_eq_singleton (X := Y) ▸ Set.subsingleton_singleton).coe_sort
  set r₀ : Y.functionField := (Y.presheaf.stalkSpecializes (genericPoint_specializes_component_wc Z₀)).hom
    ((φ : RationalFunctions Y) Z₀)
  have hr0 : r₀ ≠ 0 :=
    ((φ.isUnit.map (Pi.evalMonoidHom (fun Z : irreducibleComponents Y =>
      Y.presheaf.stalk (componentGenericPoint Y Z)) Z₀)).map
        (Y.presheaf.stalkSpecializes (genericPoint_specializes_component_wc Z₀)).hom).ne_zero
  refine ⟨MMP.Intersection.principalDivisor (Units.map
    (MMP.CartierDivisorSheaf.ofFunctionField (X := Y) ⊤).toMonoidHom
      (Units.mk0 r₀ hr0)), fun Q => ?_⟩
  have hord : Q.ord φ = Scheme.ord r₀ Q.genericPoint := by
    have h := valuation_eq_inv_divisorialValuation_wc Q ((φ : RationalFunctions Y) Q.component)
    obtain rfl := Subsingleton.elim Q.component Z₀
    rw [Q.valuation_component,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hr0, ← WithZero.exp_neg,
      neg_neg] at h
    exact WithZero.exp_injective h
  rw [coeff_principalDivisor, hord, ← primeDivisorOrder_principalDivisor_functionField_wc hr0]
  exact isOrderAlong_primeDivisorOrder _ Q

/-- **A Cartier Weil divisor is the Weil divisor of a Cartier divisor.** On a normal integral
Noetherian scheme, `𝒪_X(D) ≅ 𝒪_X(E₀)` for some Cartier divisor `E₀` with Weil divisor `w₀`;
then `D - w₀ = div φ`, and `E₀ + div φ` has Weil divisor `D`. -/
private theorem exists_isWeilDivisorOfCartier_of_isCartier_wc [CompactSpace Y] {D : Divisor Y}
    (hD : D.IsCartier) : ∃ E : Y.CartierDivisor, IsWeilDivisorOfCartier E D := by
  haveI : IsNoetherian Y := ⟨⟩
  have := hD.isInvertibleModule_divisorialSheaf
  obtain ⟨E₀, ⟨e₀⟩⟩ := MMP.Fourfold.exists_nonempty_iso_cartierDivisor_sheaf D.divisorialSheaf
  obtain ⟨w₀, hw₀⟩ := exists_isWeilDivisorOfCartier_wc E₀
  obtain ⟨e₁⟩ := hw₀.nonempty_sheaf_iso_divisorialSheaf
  obtain ⟨φ, hφ⟩ := MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso (e₀ ≪≫ e₁)
  obtain ⟨Pc, hPc⟩ := exists_isWeilDivisorOfCartier_principalDivisor_wc φ
  refine ⟨E₀ + Pc, fun Q => ?_⟩
  have h := (hw₀ Q).add (hPc Q)
  rwa [← DivisorWithCoeffs.coeff_add, ← hφ, add_sub_cancel] at h

end WeilOfCartier

/-- A Cartier Weil divisor is the Weil divisor of a Cartier divisor. -/
private theorem exists_isWeilDivisorOfCartier_of_isCartier {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {D : Divisor X} (hD : D.IsCartier) :
    ∃ A : X.CartierDivisor, MMP.Intersection.IsWeilDivisorOfCartier A D :=
  exists_isWeilDivisorOfCartier_of_isCartier_wc hD

/-- **Numerical spanning from spanning classes.** If the classes of Cartier divisors `Eⱼ` with
Weil divisors `wⱼ` span `N¹(X)_ℝ`, then every `ℝ`-Cartier combination is numerically equivalent to
a combination of the `wⱼ`. -/
private theorem exists_isNumericallyEquivalentOver_of_span {X : Scheme.{0}} [IsIntegral X]
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)}
    [QuasiCompact sX] {l : ℕ} {E : Fin l → X.CartierDivisor} {w : Fin l → Divisor X}
    (hE : ∀ j, MMP.Intersection.IsWeilDivisorOfCartier (E j) (w j))
    (hspan : Submodule.span ℝ (Set.range fun j =>
      numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (E j))) = ⊤)
    (D : RDivisor X) (hDc : IsCartierCombination D) :
    ∃ a : Fin l → ℝ, IsNumericallyEquivalentOver ℂ sX sX D
      (∑ j, a j • QDivisor.toRDivisor (Divisor.toQDivisor (w j))) := by
  obtain ⟨m, r, L, hL, hD⟩ := hDc
  have hD' : D = ∑ i, r i • Divisor.toRDivisor (L i) := by
    simpa only [← toRDivisor_eq_mapCoeffs] using hD
  choose A hA using fun i => exists_isWeilDivisorOfCartier_of_isCartier (hL i)
  set KD : KCartierDivisor ℝ X := ∑ i, r i • KCartierDivisor.ofCartier ℝ (A i)
  have hmem : numericalDivisorClass sX KD ∈ Submodule.span ℝ (Set.range fun j =>
      numericalDivisorClass sX (KCartierDivisor.ofCartier ℝ (E j))) := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hmem
  have hw : (∑ j, a j • QDivisor.toRDivisor (Divisor.toQDivisor (w j))) =
      ∑ j, a j • Divisor.toRDivisor (w j) := by
    simp only [QDivisor.toRDivisor_toQDivisor]
  have hwc : ∀ j, (w j).IsCartier := fun j => (hE j).isCartier
  refine ⟨a, ⟨m, r, L, hL, hD⟩, ⟨l, a, w, hwc, by
    rw [hw]; simp only [← toRDivisor_eq_mapCoeffs]⟩, fun C _ m₁ r₁ L₁ x₁ m₂ r₂ L₂ x₂ h₁ h₂ => ?_⟩
  rw [eq_sum_degreeOn_of_isRIntersectionNumber hL hD' h₁,
    eq_sum_degreeOn_of_isRIntersectionNumber (r := a) hwc hw h₂]
  have hcl : numericalDivisorClass sX KD =
      numericalDivisorClass sX (∑ j, a j • KCartierDivisor.ofCartier ℝ (E j)) := by
    rw [← ha, map_sum]
    simp only [map_smul]
  have hi := MMP.ProgramBaseChange.intersectionNumber_eq_of_numericalDivisorClass_eq' hcl C
  simp only [KD, OneCycle.intersectionNumber, map_sum, map_smul, LinearMap.sum_apply,
    LinearMap.smul_apply, smul_eq_mul] at hi
  have e1 : ∀ i, (OneCycle.intersectionPairing (KCartierDivisor.ofCartier ℝ (A i)))
      (C.cycle ℝ) = ((L i).degreeOn ℂ sX C.ι C.dim_le (hL i) : ℝ) := fun i =>
    intersectionNumber_ofCartier_eq_degreeOn' (hA i) C
  have e2 : ∀ j, (OneCycle.intersectionPairing (KCartierDivisor.ofCartier ℝ (E j)))
      (C.cycle ℝ) = ((w j).degreeOn ℂ sX C.ι C.dim_le (hwc j) : ℝ) := fun j =>
    intersectionNumber_ofCartier_eq_degreeOn' (hE j) C
  simp only [e1, e2] at hi
  exact hi

/-- Linear independence over an intermediate field descends to a subfield it contains. -/
private theorem linearIndependent_of_le_intermediateField {l : ℕ} {h : Fin l → ℝ}
    {F₁ : Subfield ℝ} {F₂ : IntermediateField ℚ ℝ} (hle : ∀ x ∈ F₁, x ∈ F₂)
    (hind : LinearIndependent F₂ h) : LinearIndependent F₁ h := by
  refine Fintype.linearIndependent_iff.mpr fun c hc j => ?_
  have := Fintype.linearIndependent_iff.mp hind (fun i => ⟨(c i : ℝ), hle _ (c i).2⟩)
    (by
      have e : ∀ x, (((⟨(c x : ℝ), hle _ (c x).2⟩ : F₂)) : ℝ) = (c x : ℝ) := fun x => rfl
      simpa [IntermediateField.smul_def, Subfield.smul_def, e] using hc) j
  exact Subtype.ext (by simpa using congrArg Subtype.val this)

/-- A divisor relatively ample over the structure morphism is nef over any base. -/
private theorem isRelativelyNef_of_isRelativelyAmple_absolute {X S : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {sX : X ⟶ Spec (.of ℂ)}
    {sS : S ⟶ Spec (.of ℂ)} [QuasiCompact sX] [IsProper sX] (hXv : IsNormalVariety ℂ sX)
    {g : X ⟶ S} (hg : g ≫ sS = sX) {A : RDivisor X} (hA : IsRelativelyAmple sX A) :
    IsRelativelyNef ℂ sX g A := by
  obtain ⟨m, r, L, -, hr, hL, rfl⟩ := hA
  haveI : IsNormal (Spec (.of ℂ)) := AlgebraicGeometry.isNormal_spec_of_isIntegrallyClosed ℂ
  have hpt : MMP.Mori.IsNormalVariety ℂ (𝟙 (Spec (.of ℂ))) :=
    ⟨{ toIsIntegral := inferInstance, toIsSeparated := inferInstance,
        toLocallyOfFiniteType := inferInstance, toQuasiCompact := inferInstance },
      inferInstance⟩
  have hc := (MMP.Flips.relativelyAmple_basics sX (𝟙 (Spec (.of ℂ))) hXv hpt sX
    (Category.comp_id sX)).2.2.1
  refine ⟨m, r, L, fun j => (hL j).1, rfl, fun C hC x hx => ?_⟩
  have hCs : C.IsContractedBy sX := fun z hz => by
    have h1 : (g ≫ sS) z = (g ≫ sS) C.point := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hC z hz]
    rwa [hg] at h1
  obtain ⟨hL', d, -, hd, rfl⟩ := hx
  exact Finset.sum_nonneg fun j _ => mul_nonneg (hr j).le
    (by exact_mod_cast (hc (L j) (hL j) (hL' j) C hCs (d j) (hd j)).le)

/-- **The starting stage.** -/
private theorem exists_isGood_start {X : Scheme.{0}} [IsIntegral X] [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {g : X ⟶ S} {K : Divisor X}
    {B : RDivisor X} (hX : MMP.Mori.IsProjectiveVariety ℂ sX)
    (hS : MMP.Mori.IsProjectiveVariety ℂ sS) (hg : g ≫ sS = sX) (hXQ : IsQFactorial sX)
    (hdim : topologicalKrullDim X = 3) (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n) (hB0 : 0 ≤ B)
    (hB : IsRealKltPair sX B) :
    ∃ (l : ℕ) (h : Fin l → ℝ) (Hq : Fin l → QDivisor X), (∀ j, 0 < h j) ∧
      IsGood sS h (⟨X, sX, g, K, B, Hq, 1⟩ : Stage S l) := by
  classical
  haveI : QuasiCompact sX := hX.toIsVariety.toQuasiCompact
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX.isProjective
  obtain ⟨l, P, E, h, -, -, hE, -, hspanN, hh, hind, hklt, hamp⟩ :=
    IsRealKltPair.exists_isRelativelyAmple_add_linearIndependent (k := ℂ) hXQ hX
      (by rw [hdim]; exact_mod_cast (by norm_num : (2 : ℕ) ≤ 3)) (fun P => hB0 P) hB
  set Hq : Fin l → QDivisor X := fun j => Divisor.toQDivisor (Finsupp.single (P j) 1)
  have hsc : scaling h Hq = ∑ j, h j • Divisor.toRDivisor (Finsupp.single (P j) 1) := by
    simp only [scaling, Hq, QDivisor.toRDivisor_toQDivisor]
  obtain ⟨n, hKn⟩ := hK
  refine ⟨l, h, Hq, fun j => (hh j).1, hX, hXQ, hg, hdim, ⟨n, hKn⟩, hB0, hB, fun j E' => ?_,
    exists_isNumericallyEquivalentOver_of_span hE hspanN,
    linearIndependent_of_le_intermediateField
      (fun x hx => (Subfield.closure_le (t := (IntermediateField.adjoin ℚ (Set.range B.coeff)).toSubfield)).mpr
        (IntermediateField.subset_adjoin ℚ _) hx) hind,
    one_pos, by rw [one_smul, hsc]; exact hklt, ?_⟩
  · change (0 : ℚ) ≤ ((Finsupp.single (P j) (1 : ℤ) E' : ℤ) : ℚ)
    rw [Finsupp.single_apply]
    split_ifs <;> norm_num
  · rw [one_smul, hsc]
    have hA := hamp n K hKn
    rw [add_assoc] at hA
    exact isRelativelyNef_of_isRelativelyAmple_absolute hB.1 hg hA

private theorem solution :
    ∀ {X S : Scheme.{0}} [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of ℂ)} {sS : S ⟶ Spec (.of ℂ)} {g : X ⟶ S} {K : Divisor X}
    {B : RDivisor X}
    (hX : MMP.Mori.IsProjectiveVariety ℂ sX) (hS : MMP.Mori.IsProjectiveVariety ℂ sS)
    (hg : g ≫ sS = sX) (hXQ : IsQFactorial sX) (hdim : topologicalKrullDim X = 3)
    (hK : ∃ n : ℕ, K.IsCanonicalDivisor sX n) (hB0 : 0 ≤ B) (hB : IsRealKltPair sX B),
    ∃ (n : ℕ) (Yi : ℕ → Scheme.{0}) (sYi : ∀ i, Yi i ⟶ Spec (.of ℂ))
      (_ : ∀ i, IsIntegral (Yi i)) (_ : ∀ i, CompactSpace (Yi i))
      (_ : ∀ i, IsLocallyNoetherian (Yi i)) (_ : ∀ i, IsNormal (Yi i)) (πY : ∀ i, Yi i ⟶ S)
      (KY : ∀ i, Divisor (Yi i)) (BY : ∀ i, RDivisor (Yi i))
      (R : ∀ i, Set (RelativeNumericalCurveClasses (modelStr sX sYi i) (modelMap g πY i)))
      (Zi : ℕ → Scheme.{0}) (sZi : ∀ i, Zi i ⟶ Spec (.of ℂ)) (f : ∀ i, modelSeq X Yi i ⟶ Zi i)
      (h : ∀ i, Zi i ⟶ S) (fp : ∀ i, Yi i ⟶ Zi i),
      (∀ i ≤ n,
        MMP.Mori.IsProjectiveVariety ℂ (modelStr sX sYi i) ∧ IsQFactorial (modelStr sX sYi i) ∧
          topologicalKrullDim (modelSeq X Yi i) = 3 ∧ modelMap g πY i ≫ sS = modelStr sX sYi i ∧
          IsRealKltPair (modelStr sX sYi i) (divisorSeq B BY i)) ∧
      (∀ i < n,
        IsExtremalRay ℝ (relativeClosedConeOfCurves (modelStr sX sYi i) (modelMap g πY i) :
            Set (RelativeNumericalCurveClasses (modelStr sX sYi i) (modelMap g πY i))) (R i) ∧
          (∀ (Γ : ProperCurve (modelStr sX sYi i)) (hΓ : Γ.IsContractedBy (modelMap g πY i)),
            Γ.relativeClass (modelMap g πY i) hΓ ∈ R i →
            ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (modelSeq X Yi i)) (x : ℝ),
              IsRIntersectionNumber ℂ (modelStr sX sYi i)
                (logCanonicalDivisor (divisorSeq K KY i) (divisorSeq B BY i)) r L Γ x → x < 0) ∧
          IsRelativeContractionOfFace (modelMap g πY i) (R i) (f i) (h i) ∧
          IsNegativeExtremalContraction ℂ (modelStr sX sYi i) (sZi i)
            (logCanonicalDivisor (divisorSeq K KY i) (divisorSeq B BY i)) (f i) ∧
          fp i ≫ h i = πY i ∧
          (((IsBirationalMorphism (f i) ∧ ∃ E : MMP.Mori.PrimeDivisor (modelSeq X Yi i),
                (MMP.Mori.exceptionalSet (f i) : Set (modelSeq X Yi i)) = E.support) ∧
              IsIso (fp i) ∧ (∃ m : ℕ, (KY i).IsCanonicalDivisor (sYi i) m) ∧
              BY i = flipTransform (f i) (fp i) (divisorSeq B BY i)) ∨
            IsRealFlipStep (modelStr sX sYi i) (sZi i) (sYi i) (divisorSeq K KY i)
              (divisorSeq B BY i) (KY i) (BY i) (f i) (fp i))) ∧
      (IsRelativelyNef ℂ (modelStr sX sYi n) (modelMap g πY n)
          (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) ∨
        ∃ (Rn : Set (RelativeNumericalCurveClasses (modelStr sX sYi n) (modelMap g πY n)))
          (Z : Scheme.{0}) (_ : IsIntegral Z) (_ : IsLocallyNoetherian Z) (_ : IsNormal Z)
          (sZ : Z ⟶ Spec (.of ℂ)) (fn : modelSeq X Yi n ⟶ Z) (hn : Z ⟶ S),
          IsExtremalRay ℝ (relativeClosedConeOfCurves (modelStr sX sYi n) (modelMap g πY n) :
              Set (RelativeNumericalCurveClasses (modelStr sX sYi n) (modelMap g πY n))) Rn ∧
            (∀ (Γ : ProperCurve (modelStr sX sYi n)) (hΓ : Γ.IsContractedBy (modelMap g πY n)),
              Γ.relativeClass (modelMap g πY n) hΓ ∈ Rn →
              ∀ (m : ℕ) (r : Fin m → ℝ) (L : Fin m → Divisor (modelSeq X Yi n)) (x : ℝ),
                IsRIntersectionNumber ℂ (modelStr sX sYi n)
                  (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) r L Γ x →
                x < 0) ∧
            IsRelativeContractionOfFace (modelMap g πY n) Rn fn hn ∧
            MMP.Mori.IsProjectiveVariety ℂ sZ ∧
            IsNegativeExtremalContraction ℂ (modelStr sX sYi n) sZ
              (logCanonicalDivisor (divisorSeq K KY n) (divisorSeq B BY n)) fn ∧
            topologicalKrullDim Z < topologicalKrullDim (modelSeq X Yi n))  := by
  intro X S _ _ _ _ sX sS g K B hX hS hg hXQ hdim hK hB0 hB
  classical
  obtain ⟨l, h, Hq, hh, hgood0⟩ := exists_isGood_start hX hS hg hXQ hdim hK hB0 hB
  let s0 : Stage S l := ⟨X, sX, g, K, B, Hq, 1⟩
  let cond : Stage S l → Prop := fun s =>
    IsGood sS h s ∧ ¬ IsRelativelyNef ℂ s.sX s.πX (logCanonicalDivisor s.K s.B) ∧
      ∃ d : StepData s, IsGoodStep sS h s d
  let next : (s : Stage S l) → StepData s := fun s =>
    if hc : cond s then hc.2.2.choose else ⟨s, ∅, S, sS, s.πX, 𝟙 S, s.πX⟩
  have hnext : ∀ s : Stage S l, cond s → IsGoodStep sS h s (next s) := by
    intro s hc
    simp only [next, dif_pos hc]
    exact hc.2.2.choose_spec
  have hgood : ∀ i, (∀ j < i, cond (Stage.seq s0 next j)) → IsGood sS h (Stage.seq s0 next i) := by
    intro i
    induction i with
    | zero => intro _; exact hgood0
    | succ i _ =>
      intro hall
      exact (hnext _ (hall i (Nat.lt_succ_self i))).1
  have hfin : ∃ i, ¬ cond (Stage.seq s0 next i) := by
    by_contra hno
    simp only [not_exists, not_not] at hno
    exact false_of_forall_isGoodStep hS hh s0 next hgood0 (fun i => hnext _ (hno i))
      (fun i => (hno i).2.1)
  have hlt : ∀ i < Nat.find hfin, cond (Stage.seq s0 next i) := fun i hi =>
    not_not.mp (Nat.find_min hfin hi)
  have hgn : IsGood sS h (Stage.seq s0 next (Nat.find hfin)) := hgood _ hlt
  have hend : IsRelativelyNef ℂ (Stage.seq s0 next (Nat.find hfin)).sX
      (Stage.seq s0 next (Nat.find hfin)).πX
      (logCanonicalDivisor (Stage.seq s0 next (Nat.find hfin)).K
        (Stage.seq s0 next (Nat.find hfin)).B) ∨
      IsFibreEnd (Stage.seq s0 next (Nat.find hfin)) := by
    by_cases hn : IsRelativelyNef ℂ (Stage.seq s0 next (Nat.find hfin)).sX
      (Stage.seq s0 next (Nat.find hfin)).πX
      (logCanonicalDivisor (Stage.seq s0 next (Nat.find hfin)).K
        (Stage.seq s0 next (Nat.find hfin)).B)
    · exact Or.inl hn
    · refine Or.inr ?_
      rcases exists_isGoodStep hS hh _ hgn hn with h1 | h1
      · exact h1
      · exact absurd ⟨hgn, hn, h1⟩ (Nat.find_spec hfin)
  have hmod : ∀ i : ℕ, IsGood sS h (Stage.seq s0 next i) →
      MMP.Mori.IsProjectiveVariety ℂ (modelStr sX (fun j => (Stage.seq s0 next (j + 1)).sX) i) ∧
      IsQFactorial (modelStr sX (fun j => (Stage.seq s0 next (j + 1)).sX) i) ∧
      topologicalKrullDim (modelSeq X (fun j => (Stage.seq s0 next (j + 1)).X) i) = 3 ∧
      modelMap g (fun j => (Stage.seq s0 next (j + 1)).πX) i ≫ sS =
        modelStr sX (fun j => (Stage.seq s0 next (j + 1)).sX) i ∧
      IsRealKltPair (modelStr sX (fun j => (Stage.seq s0 next (j + 1)).sX) i)
        (divisorSeq B (fun j => (Stage.seq s0 next (j + 1)).B) i) := by
    intro i hi
    obtain ⟨h1, h2, h3, h4, -, -, h7, -⟩ := hi
    cases i with
    | zero => exact ⟨h1, h2, h4, h3, h7⟩
    | succ i => exact ⟨h1, h2, h4, h3, h7⟩
  have hstepi : ∀ i : ℕ, cond (Stage.seq s0 next i) →
      IsStep (modelStr sX (fun j => (Stage.seq s0 next (j + 1)).sX) i)
        (Stage.seq s0 next (i + 1)).sX (next (Stage.seq s0 next i)).sZs
        (modelMap g (fun j => (Stage.seq s0 next (j + 1)).πX) i)
        (Stage.seq s0 next (i + 1)).πX
        (divisorSeq K (fun j => (Stage.seq s0 next (j + 1)).K) i)
        (divisorSeq B (fun j => (Stage.seq s0 next (j + 1)).B) i)
        (Stage.seq s0 next (i + 1)).K (Stage.seq s0 next (i + 1)).B
        (Stage.progR s0 next i) (Stage.progF s0 next i) (next (Stage.seq s0 next i)).g
        (next (Stage.seq s0 next i)).fp := by
    intro i hi
    have h := (hnext _ hi).2.1
    cases i with
    | zero => exact h
    | succ i => exact h
  refine ⟨Nat.find hfin, fun j => (Stage.seq s0 next (j + 1)).X,
    fun j => (Stage.seq s0 next (j + 1)).sX, fun i => inferInstance, fun i => inferInstance,
    fun i => inferInstance, fun i => inferInstance, fun j => (Stage.seq s0 next (j + 1)).πX,
    fun j => (Stage.seq s0 next (j + 1)).K, fun j => (Stage.seq s0 next (j + 1)).B,
    Stage.progR s0 next, fun i => (next (Stage.seq s0 next i)).Zs,
    fun i => (next (Stage.seq s0 next i)).sZs, Stage.progF s0 next,
    fun i => (next (Stage.seq s0 next i)).g, fun i => (next (Stage.seq s0 next i)).fp,
    fun i hi => hmod i (hgood i fun j hj => hlt j (lt_of_lt_of_le hj hi)),
    fun i hi => hstepi i (hlt i hi), ?_⟩
  revert hend
  generalize Nat.find hfin = n
  intro hend
  rcases hend with hn | ⟨Rn, Z, _, _, _, sZ, fn, hn, h1, h2, h3, h4, h5, h6⟩
  · left
    cases n with
    | zero => exact hn
    | succ i => exact hn
  · right
    cases n with
    | zero =>
      exact ⟨Rn, Z, inferInstance, inferInstance, inferInstance, sZ, fn, hn, h1, h2, h3, h4, h5, h6⟩
    | succ i =>
      exact ⟨Rn, Z, inferInstance, inferInstance, inferInstance, sZ, fn, hn, h1, h2, h3, h4, h5, h6⟩

end

end Proof_thm_fourfold_projective_real_threefold_program

