/-!
# Local rings of smooth surfaces

Commutative algebra of two-dimensional regular local rings, the dimension and residue field of the
local rings of a surface at closed points, and the bound of the local intersection number of two
effective divisors at a closed point by the product of their multiplicities.

## Main results

* `MMP.Mori.SurfaceAux.mul_le_finrank_quotient`: in a two-dimensional regular local `k`-algebra
  with residue field `k`, `a * b ≤ dim_k R / (g, g')` for `g` of order `a` and `g'` of order `b`.
* `MMP.Mori.SurfaceAux.ringKrullDim_stalk_eq_two`: the local ring of a surface at a closed point
  has Krull dimension two.
* `MMP.Mori.SurfaceAux.multiplicityAt_mul_le`: the product of the multiplicities at `q` of two
  effective divisors without common components through `q` is at most their local intersection
  number at `q`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace IsLocalRing Stacks.RegularLocalRing.Domain
  RingTheory.Sequence

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

set_option linter.style.haveILetI false

universe u

namespace MMP.Mori.SurfaceAux

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The maximal ideal of a regular local ring is generated by a list of `spanFinrank` elements. -/
theorem exists_gens : ∃ xs : List R, Ideal.ofList xs = maximalIdeal R ∧
    xs.length = (maximalIdeal R).spanFinrank := by
  obtain ⟨s, hs, hs2⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsNoetherian.noetherian (maximalIdeal R))
  refine ⟨s.toList, ?_, by simpa using hs⟩
  rw [← hs2]
  simp [Ideal.ofList]

/-- The maximal ideal of a two-dimensional regular local ring is generated by a quasi-regular
sequence `f : Fin 2 → R`. -/
theorem exists_quasiRegular_gens (hd : (maximalIdeal R).spanFinrank = 2) :
    ∃ f : Fin 2 → R, Jid f = maximalIdeal R ∧
      Function.Injective (quasiRegularCanonicalMap (M := R) f) := by
  obtain ⟨xs, hxs, hlen⟩ := exists_gens (R := R)
  have h2 : xs.length = 2 := hlen.trans hd
  have hinj := (IsRegularLocalRing.isQuasiRegular xs hxs hlen).injective
  have hI : Ideal.span (Set.range fun i : Fin xs.length => xs[i]) = maximalIdeal R :=
    (Stacks.QuasiregularSequence.ofList_eq_span_range xs).symm.trans hxs
  revert hinj hI
  rw [List.length_eq_two] at h2
  obtain ⟨x, y, rfl⟩ := h2
  intro hinj hI
  exact ⟨fun i : Fin [x, y].length => [x, y][i], hI, hinj⟩

/-- In a two-dimensional regular local ring, if `u ∈ 𝔪^a ∖ 𝔪^(a+1)` and `v ∈ 𝔪^b ∖ 𝔪^(b+1)`,
then `u * v ∉ 𝔪^(a+b+1)`. -/
theorem mul_notMem_pow_succ (hd : (maximalIdeal R).spanFinrank = 2) {a b : ℕ} {u v : R}
    (hua : u ∈ maximalIdeal R ^ a) (hua' : u ∉ maximalIdeal R ^ (a + 1))
    (hvb : v ∈ maximalIdeal R ^ b) (hvb' : v ∉ maximalIdeal R ^ (b + 1)) :
    u * v ∉ maximalIdeal R ^ (a + b + 1) := by
  obtain ⟨f, hf, hinj⟩ := exists_quasiRegular_gens hd
  have : (Jid f).IsPrime := hf ▸ inferInstance
  rw [← hf] at hua hua' hvb hvb' ⊢
  exact mul_notMem_pow_add_succ hinj hua hua' hvb hvb'

/-- For `h` of order exactly `a`, `c * h ∈ 𝔪^n` iff `c ∈ 𝔪^(n - a)`. -/
theorem mul_mem_pow_iff (hd : (maximalIdeal R).spanFinrank = 2) {a : ℕ} {h : R}
    (ha : h ∈ maximalIdeal R ^ a) (ha' : h ∉ maximalIdeal R ^ (a + 1)) (c : R) (n : ℕ) :
    c * h ∈ maximalIdeal R ^ n ↔ c ∈ maximalIdeal R ^ (n - a) := by
  constructor
  · intro hc
    by_contra hcn
    classical
    have hex : ∃ m, c ∉ maximalIdeal R ^ m := ⟨_, hcn⟩
    have hm0 : Nat.find hex ≠ 0 := fun h0 => Nat.find_spec hex (by simp [h0])
    have hle : Nat.find hex ≤ n - a := Nat.find_min' hex hcn
    set j := Nat.find hex - 1 with hj
    have hj1 : j + 1 = Nat.find hex := by omega
    have hcj : c ∈ maximalIdeal R ^ j := not_not.1 (Nat.find_min hex (by omega))
    have hcj' : c ∉ maximalIdeal R ^ (j + 1) := by rw [hj1]; exact Nat.find_spec hex
    exact mul_notMem_pow_succ hd hcj hcj' ha ha' (Ideal.pow_le_pow_right (by omega) hc)
  · intro hc
    rcases le_total n a with hna | han
    · exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hna ha)
    · have := Ideal.mul_mem_mul hc ha
      rwa [← pow_add, Nat.sub_add_cancel han] at this

section Field

variable {k : Type*} [Field k] [Algebra k R]

/-- The image of `c : k` in `R` lies in the maximal ideal if and only if `c = 0`. -/
theorem algebraMap_mem_iff {c : k} :
    algebraMap k R c ∈ maximalIdeal R ↔ c = 0 := by
  constructor
  · intro h
    have : algebraMap k (R ⧸ maximalIdeal R) c = 0 := by
      rw [IsScalarTower.algebraMap_apply k R (R ⧸ maximalIdeal R)]
      exact Ideal.Quotient.eq_zero_iff_mem.2 h
    exact (map_eq_zero _).1 this
  · rintro rfl
    simp

/-- If `k → R / 𝔪` is surjective, every `r : R` is congruent modulo `𝔪` to the image of some
`c : k`. -/
theorem exists_sub_mem (hk : Function.Surjective (algebraMap k (R ⧸ maximalIdeal R))) (r : R) :
    ∃ c : k, r - algebraMap k R c ∈ maximalIdeal R := by
  obtain ⟨c, hc⟩ := hk (Ideal.Quotient.mk _ r)
  refine ⟨c, ?_⟩
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, ← hc,
    IsScalarTower.algebraMap_apply k R (R ⧸ maximalIdeal R)]
  simp

/-- The linear map from degree-`n` forms to `R / 𝔪^(n+1)`. -/
noncomputable def formMap (f : Fin 2 → R) (n : ℕ) :
    MvPolynomial.homogeneousSubmodule (Fin 2) k n →ₗ[k] R ⧸ maximalIdeal R ^ (n + 1) :=
  (Submodule.mkQ _).restrictScalars k ∘ₗ
    ((MvPolynomial.aeval f).toLinearMap ∘ₗ (MvPolynomial.homogeneousSubmodule (Fin 2) k n).subtype)

/-- If `f` is a quasi-regular sequence generating `𝔪`, then `formMap f n` is injective. -/
theorem formMap_injective {f : Fin 2 → R} (hf : Jid f = maximalIdeal R)
    (hinj : Function.Injective (quasiRegularCanonicalMap (M := R) f)) (n : ℕ) :
    Function.Injective (formMap (k := k) f n) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro P hP
  have hmem : MvPolynomial.aeval f (P : MvPolynomial (Fin 2) k) ∈ Jid f ^ (n + 1) := by
    rw [hf]
    have h2 : Ideal.Quotient.mk (maximalIdeal R ^ (n + 1))
        (MvPolynomial.aeval f (P : MvPolynomial (Fin 2) k)) = 0 := hP
    exact Ideal.Quotient.eq_zero_iff_mem.1 h2
  have hev : MvPolynomial.eval f (P.1.map (algebraMap k R)) ∈ Jid f ^ (n + 1) := by
    rwa [MvPolynomial.eval_map]
  have hc := coeff_mem_of_isHomogeneous_of_eval_mem hinj (P.2.map _) hev
  apply Subtype.ext
  ext e
  have := hc e
  rw [MvPolynomial.coeff_map, hf, algebraMap_mem_iff] at this
  simpa using this

/-- The projection `R / 𝔪^(n+1) → R / 𝔪^n`. -/
noncomputable def projMap (n : ℕ) : R ⧸ maximalIdeal R ^ (n + 1) →ₗ[k] R ⧸ maximalIdeal R ^ n :=
  (Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ n))).restrictScalars k

/-- `projMap` sends the class of `r` modulo `𝔪^(n+1)` to its class modulo `𝔪^n`. -/
theorem projMap_mk (n : ℕ) (r : R) :
    projMap (k := k) n (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ r := rfl

/-- The projection `R / 𝔪^(n+1) → R / 𝔪^n` is surjective. -/
theorem projMap_surjective (n : ℕ) : Function.Surjective (projMap (k := k) (R := R) n) := by
  intro x
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact ⟨Ideal.Quotient.mk _ r, rfl⟩

/-- If `f` generates `𝔪`, the image of `formMap f n` lies in the kernel of `projMap n`. -/
theorem range_formMap_le_ker {f : Fin 2 → R} (hf : Jid f = maximalIdeal R) (n : ℕ) :
    LinearMap.range (formMap (k := k) f n) ≤ LinearMap.ker (projMap n) := by
  rintro _ ⟨P, rfl⟩
  rw [LinearMap.mem_ker]
  have h2 : MvPolynomial.aeval f (P : MvPolynomial (Fin 2) k) ∈ Jid f ^ n :=
    (Ideal.mem_span_pow_iff_exists_isHomogeneous f _).2
      ⟨P.1.map (algebraMap k R), P.2.map _, by rw [MvPolynomial.eval_map]; rfl⟩
  rw [hf] at h2
  exact Ideal.Quotient.eq_zero_iff_mem.2 h2

/-- If `f` generates `𝔪` and `k → R / 𝔪` is surjective, the kernel of `projMap n` lies in the
image of `formMap f n`. -/
theorem ker_le_range_formMap {f : Fin 2 → R} (hf : Jid f = maximalIdeal R)
    (hk : Function.Surjective (algebraMap k (R ⧸ maximalIdeal R))) (n : ℕ) :
    LinearMap.ker (projMap (k := k) n) ≤ LinearMap.range (formMap f n) := by
  intro x hx
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [LinearMap.mem_ker, projMap_mk] at hx
  have hr : r ∈ Jid f ^ n := by rw [hf]; exact Ideal.Quotient.eq_zero_iff_mem.1 hx
  obtain ⟨P, hP, hPr⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous f r).1 hr
  classical
  choose c hc using fun e => exists_sub_mem hk (P.coeff e)
  let Q : MvPolynomial (Fin 2) k := ∑ e ∈ P.support, MvPolynomial.monomial e (c e)
  have hQ : Q.IsHomogeneous n := by
    refine MvPolynomial.IsHomogeneous.sum _ _ _ fun e he => ?_
    refine MvPolynomial.isHomogeneous_monomial _ ?_
    by_contra h
    exact (MvPolynomial.mem_support_iff.1 he) (hP.coeff_eq_zero h)
  have hcoeffQ : ∀ e, Q.coeff e = if e ∈ P.support then c e else 0 := by
    intro e
    simp only [Q, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
    simp
  have hD : (P - Q.map (algebraMap k R)).IsHomogeneous n := hP.sub (hQ.map _)
  have hDc : ∀ e, (P - Q.map (algebraMap k R)).coeff e ∈ Jid f := by
    intro e
    rw [hf, MvPolynomial.coeff_sub, MvPolynomial.coeff_map, hcoeffQ]
    by_cases he : e ∈ P.support
    · simpa only [he, ite_true] using hc e
    · simp [he, MvPolynomial.notMem_support_iff.1 he]
  have h1 := eval_mem_mul_pow_of_isHomogeneous f (Jid f) hD hDc
  rw [hf, ← pow_succ'] at h1
  refine ⟨⟨Q, hQ⟩, ?_⟩
  show Ideal.Quotient.mk _ (MvPolynomial.aeval f Q) = Ideal.Quotient.mk _ r
  rw [Ideal.Quotient.eq]
  have : MvPolynomial.aeval f Q - r = - MvPolynomial.eval f (P - Q.map (algebraMap k R)) := by
    rw [map_sub, MvPolynomial.eval_map, hPr]
    simp [MvPolynomial.aeval_def]
  rw [this]
  exact neg_mem h1

/-- In a two-dimensional regular local `k`-algebra with residue field `k`, the quotient
`R / 𝔪^n` is finite-dimensional over `k`, of dimension `n * (n + 1) / 2`. -/
theorem finite_finrank_quotient_pow (hd : (maximalIdeal R).spanFinrank = 2)
    (hk : Function.Surjective (algebraMap k (R ⧸ maximalIdeal R))) (n : ℕ) :
    FiniteDimensional k (R ⧸ maximalIdeal R ^ n) ∧
      2 * Module.finrank k (R ⧸ maximalIdeal R ^ n) = n * (n + 1) := by
  obtain ⟨f, hf, hinj⟩ := exists_quasiRegular_gens hd
  induction n with
  | zero =>
    have : Subsingleton (R ⧸ maximalIdeal R ^ 0) := by
      rw [pow_zero, Ideal.one_eq_top]; exact Ideal.Quotient.subsingleton_iff.2 rfl
    exact ⟨inferInstance, by simp [Module.finrank_zero_of_subsingleton]⟩
  | succ n ih =>
    obtain ⟨hfin, hdim⟩ := ih
    have hexact : Function.Exact (formMap (k := k) f n) (projMap (k := k) n) := by
      rw [LinearMap.exact_iff]
      exact le_antisymm (range_formMap_le_ker hf n) (ker_le_range_formMap hf hk n) |>.symm
    have hfin' : FiniteDimensional k (R ⧸ maximalIdeal R ^ (n + 1)) :=
      Module.Finite.of_exact hexact (projMap_surjective n)
    refine ⟨hfin', ?_⟩
    have h1 := LinearMap.finrank_range_add_finrank_ker (projMap (k := k) (R := R) n)
    rw [LinearMap.range_eq_top.2 (projMap_surjective (k := k) (R := R) n), finrank_top] at h1
    have h2 : Module.finrank k (LinearMap.ker (projMap (k := k) (R := R) n)) = n + 1 := by
      rw [LinearMap.exact_iff.1 hexact, LinearMap.finrank_range_of_inj
        (formMap_injective hf hinj n), MvPolynomial.finrank_homogeneousSubmodule]
      simp [add_comm 1 n, Nat.choose_succ_self_right]
    rw [h2] at h1
    nlinarith [h1]

/-- Multiplication by `h`, followed by the projection to `R / 𝔪^N`. -/
noncomputable def mulMap (N : ℕ) (h : R) : R →ₗ[k] R ⧸ maximalIdeal R ^ N :=
  (Submodule.mkQ (maximalIdeal R ^ N)).restrictScalars k ∘ₗ LinearMap.mulRight k h

/-- `mulMap N h c` is the class of `c * h` modulo `𝔪^N`. -/
theorem mulMap_apply (N : ℕ) (h c : R) :
    mulMap (k := k) N h c = Ideal.Quotient.mk _ (c * h) := rfl

/-- In a two-dimensional regular local ring, for `h ∈ 𝔪^a ∖ 𝔪^(a+1)` the image of `mulMap N h`
has the same `k`-dimension as `R / 𝔪^(N - a)`. -/
theorem finrank_range_mulMap (hd : (maximalIdeal R).spanFinrank = 2) (N : ℕ) {a : ℕ} {h : R}
    (ha : h ∈ maximalIdeal R ^ a) (ha' : h ∉ maximalIdeal R ^ (a + 1)) :
    Module.finrank k (LinearMap.range (mulMap (k := k) N h)) =
      Module.finrank k (R ⧸ maximalIdeal R ^ (N - a)) := by
  have hker : LinearMap.ker (mulMap (k := k) N h) =
      (maximalIdeal R ^ (N - a)).restrictScalars k := by
    ext c
    rw [LinearMap.mem_ker, mulMap_apply, Ideal.Quotient.eq_zero_iff_mem, mul_mem_pow_iff hd ha ha']
    rfl
  rw [← (LinearMap.quotKerEquivRange (mulMap (k := k) N h)).finrank_eq, hker]
  exact (Submodule.Quotient.restrictScalarsEquiv k (maximalIdeal R ^ (N - a))).finrank_eq

/-- The image of `mulMap N (g * g')` lies in the images of both `mulMap N g` and `mulMap N g'`. -/
theorem range_mulMap_mul_le (N : ℕ) (g g' : R) :
    LinearMap.range (mulMap (k := k) N (g * g')) ≤
      LinearMap.range (mulMap (k := k) N g) ⊓ LinearMap.range (mulMap (k := k) N g') := by
  rintro _ ⟨c, rfl⟩
  refine ⟨⟨c * g', ?_⟩, ⟨c * g, ?_⟩⟩
  · simp only [mulMap_apply]
    rw [mul_assoc, mul_comm g' g]
  · simp only [mulMap_apply]
    rw [mul_assoc]

/-- If `𝔪^N ≤ (g, g')`, the kernel of the projection `R / 𝔪^N → R / (g, g')` is the sum of the
images of `mulMap N g` and `mulMap N g'`. -/
theorem ker_factor_eq_sup_range_mulMap {N : ℕ} {g g' : R}
    (hNI : maximalIdeal R ^ N ≤ Ideal.span {g, g'}) :
    LinearMap.ker ((Submodule.factor hNI).restrictScalars k) =
      LinearMap.range (mulMap (k := k) N g) ⊔ LinearMap.range (mulMap (k := k) N g') := by
  ext x
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [LinearMap.mem_ker]
  change Ideal.Quotient.mk _ r = 0 ↔ _
  rw [Ideal.Quotient.eq_zero_iff_mem]
  constructor
  · intro hr
    obtain ⟨c, d, rfl⟩ := Ideal.mem_span_pair.1 hr
    refine Submodule.mem_sup.2 ⟨Ideal.Quotient.mk _ (c * g), ⟨c, rfl⟩,
      Ideal.Quotient.mk _ (d * g'), ⟨d, rfl⟩, ?_⟩
    rw [← map_add]
  · intro h
    obtain ⟨y, ⟨c, rfl⟩, z, ⟨d, rfl⟩, hyz⟩ := Submodule.mem_sup.1 h
    have : Ideal.Quotient.mk (maximalIdeal R ^ N) (c * g + d * g' - r) = 0 := by
      rw [map_sub, map_add]
      exact sub_eq_zero.2 hyz
    have h2 := hNI (Ideal.Quotient.eq_zero_iff_mem.1 this)
    have h3 : c * g + d * g' ∈ Ideal.span {g, g'} :=
      Ideal.mem_span_pair.2 ⟨c, d, rfl⟩
    simpa using Ideal.sub_mem _ h3 h2

/-- In a regular local `k`-algebra `R` of dimension two with residue field `k`, if
`g ∈ 𝔪^a ∖ 𝔪^(a+1)`, `g' ∈ 𝔪^b ∖ 𝔪^(b+1)` and `R / (g, g')` is finite-dimensional, then
`a * b ≤ dim_k R / (g, g')`. -/
theorem mul_le_finrank_quotient (hd : (maximalIdeal R).spanFinrank = 2)
    (hk : Function.Surjective (algebraMap k (R ⧸ maximalIdeal R))) {a b : ℕ} {g g' : R}
    (ha : g ∈ maximalIdeal R ^ a) (ha' : g ∉ maximalIdeal R ^ (a + 1))
    (hb : g' ∈ maximalIdeal R ^ b) (hb' : g' ∉ maximalIdeal R ^ (b + 1))
    (hfin : FiniteDimensional k (R ⧸ Ideal.span {g, g'})) :
    a * b ≤ Module.finrank k (R ⧸ Ideal.span {g, g'}) := by
  classical
  have : IsArtinianRing (R ⧸ Ideal.span {g, g'}) := IsArtinianRing.of_finite k _
  obtain ⟨N₀, hN₀⟩ := IsLocalRing.exists_maximalIdeal_pow_le_of_isArtinianRing_quotient
    (Ideal.span {g, g'})
  set N := a + b + N₀ with hN
  have hNI : maximalIdeal R ^ N ≤ Ideal.span {g, g'} :=
    (Ideal.pow_le_pow_right (by omega)).trans hN₀
  obtain ⟨hW, hWdim⟩ := finite_finrank_quotient_pow (k := k) hd hk N
  set A := LinearMap.range (mulMap (k := k) N g) with hA
  set B := LinearMap.range (mulMap (k := k) N g') with hB
  set C := LinearMap.range (mulMap (k := k) N (g * g')) with hC
  have hq : Function.Surjective ((Submodule.factor hNI).restrictScalars k) :=
    Submodule.factor_surjective hNI
  have hAdim := finrank_range_mulMap (k := k) hd N ha ha'
  have hBdim := finrank_range_mulMap (k := k) hd N hb hb'
  have hgg : g * g' ∈ maximalIdeal R ^ (a + b) := by
    rw [pow_add]; exact Ideal.mul_mem_mul ha hb
  have hCdim := finrank_range_mulMap (k := k) hd N hgg (mul_notMem_pow_succ hd ha ha' hb hb')
  have hAd := (finite_finrank_quotient_pow (k := k) hd hk (N - a)).2
  have hBd := (finite_finrank_quotient_pow (k := k) hd hk (N - b)).2
  have hCd := (finite_finrank_quotient_pow (k := k) hd hk (N - (a + b))).2
  rw [← hA] at hAdim
  rw [← hB] at hBdim
  rw [← hC] at hCdim
  have h1 := LinearMap.finrank_range_add_finrank_ker ((Submodule.factor hNI).restrictScalars k)
  rw [LinearMap.range_eq_top.2 hq, finrank_top, ker_factor_eq_sup_range_mulMap (k := k) hNI,
    ← hA, ← hB] at h1
  have h2 := Submodule.finrank_sup_add_finrank_inf_eq A B
  have h3 : Module.finrank k C ≤ Module.finrank k ↥(A ⊓ B) :=
    Submodule.finrank_mono (range_mulMap_mul_le N g g')
  have e1 : N - a = b + N₀ := by omega
  have e2 : N - b = a + N₀ := by omega
  have e3 : N - (a + b) = N₀ := by omega
  rw [e1] at hAdim hAd
  rw [e2] at hBdim hBd
  rw [e3] at hCdim hCd
  rw [hN] at hWdim
  nlinarith [h1, h2, h3, hAdim, hBdim, hCdim, hAd, hBd, hCd, hWdim]

end Field

section Order

/-- A nonzero element of a regular local ring lies in `𝔪^a ∖ 𝔪^(a+1)` for some `a`. -/
theorem exists_order {u : R} (hu : u ≠ 0) :
    ∃ a : ℕ, u ∈ maximalIdeal R ^ a ∧ u ∉ maximalIdeal R ^ (a + 1) := by
  classical
  have hI : ⨅ n : ℕ, maximalIdeal R ^ n = ⊥ :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing _ (maximalIdeal.isMaximal R).ne_top
  have hex : ∃ n : ℕ, u ∉ maximalIdeal R ^ n := by
    by_contra h
    push Not at h
    exact hu (by simpa [hI] using (Submodule.mem_iInf _).2 h)
  have hpos : Nat.find hex ≠ 0 := fun h => Nat.find_spec hex (by simp [h])
  refine ⟨Nat.find hex - 1, not_not.mp (Nat.find_min hex (by omega)), ?_⟩
  rw [show Nat.find hex - 1 + 1 = Nat.find hex by omega]
  exact Nat.find_spec hex

/-- For `u ∈ 𝔪^a ∖ 𝔪^(a+1)`, `u ∈ 𝔪^m` if and only if `m ≤ a`. -/
theorem mem_pow_iff_le_of_order {u : R} {a : ℕ} (ha : u ∈ maximalIdeal R ^ a)
    (ha' : u ∉ maximalIdeal R ^ (a + 1)) (m : ℕ) : u ∈ maximalIdeal R ^ m ↔ m ≤ a := by
  constructor
  · intro h
    by_contra hlt
    exact ha' (Ideal.pow_le_pow_right (by omega) h)
  · intro h
    exact Ideal.pow_le_pow_right h ha

/-- In a two-dimensional regular local ring, if `u ∈ 𝔪^a ∖ 𝔪^(a+1)` then
`u ^ n ∈ 𝔪^(n*a) ∖ 𝔪^(n*a+1)`. -/
theorem order_pow (hd : (maximalIdeal R).spanFinrank = 2) {u : R} {a : ℕ}
    (ha : u ∈ maximalIdeal R ^ a) (ha' : u ∉ maximalIdeal R ^ (a + 1)) (n : ℕ) :
    u ^ n ∈ maximalIdeal R ^ (n * a) ∧ u ^ n ∉ maximalIdeal R ^ (n * a + 1) := by
  induction n with
  | zero =>
    refine ⟨by simp, ?_⟩
    simp only [pow_zero, zero_mul, zero_add, pow_one]
    exact fun h => (maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ h isUnit_one)
  | succ n ih =>
    rw [pow_succ, show (n + 1) * a = n * a + a by ring]
    exact ⟨by rw [pow_add]; exact Ideal.mul_mem_mul ih.1 ha,
      mul_notMem_pow_succ hd ih.1 ih.2 ha ha'⟩

/-- In a two-dimensional regular local ring, if each `π i ∈ 𝔪^(a i) ∖ 𝔪^(a i + 1)`, then
`∏ i ∈ s, π i ^ n i` lies in `𝔪^N ∖ 𝔪^(N+1)` for `N = ∑ i ∈ s, n i * a i`. -/
theorem order_prod (hd : (maximalIdeal R).spanFinrank = 2) {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (π : ι → R) (n a : ι → ℕ)
    (h : ∀ i ∈ s, π i ∈ maximalIdeal R ^ a i ∧ π i ∉ maximalIdeal R ^ (a i + 1)) :
    ∏ i ∈ s, π i ^ n i ∈ maximalIdeal R ^ (∑ i ∈ s, n i * a i) ∧
      ∏ i ∈ s, π i ^ n i ∉ maximalIdeal R ^ (∑ i ∈ s, n i * a i + 1) := by
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨by simp, ?_⟩
    simp only [Finset.prod_empty, Finset.sum_empty, zero_add, pow_one]
    exact fun h => (maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ h isUnit_one)
  | insert i s hi ih =>
    have ih' := ih fun j hj => h j (Finset.mem_insert_of_mem hj)
    have hp := order_pow hd (h i (Finset.mem_insert_self _ _)).1
      (h i (Finset.mem_insert_self _ _)).2 (n i)
    rw [Finset.prod_insert hi, Finset.sum_insert hi]
    refine ⟨by rw [pow_add]; exact Ideal.mul_mem_mul hp.1 ih'.1, ?_⟩
    exact mul_notMem_pow_succ hd hp.1 hp.2 ih'.1 ih'.2

end Order

section Finite

/-- In a two-dimensional regular local ring, a nonzero prime ideal strictly contained in the
maximal ideal is generated by a prime element. -/
theorem exists_prime_eq_span_of_lt_maximalIdeal (hdim : ringKrullDim R = 2) {P : Ideal R}
    (hP : P.IsPrime) (hPlt : P < maximalIdeal R) (hPbot : P ≠ ⊥) :
    ∃ p ∈ P, Prime p ∧ P = Ideal.span {p} := by
  have := IsRegularLocalRing.isDomain R
  have := IsRegularLocalRing.uniqueFactorizationMonoid R
  obtain ⟨p, hpP, hp⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot hP hPbot
  refine ⟨p, hpP, hp, ?_⟩
  have hspan : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).2 hp
  have hle : Ideal.span {p} ≤ P := (Ideal.span_singleton_le_iff_mem _).2 hpP
  by_contra hne2
  have hlt1 : Ideal.span {p} < P := lt_of_le_of_ne hle (Ne.symm hne2)
  have hlt0 : (⊥ : Ideal R) < Ideal.span {p} :=
    bot_lt_iff_ne_bot.2 (by simpa using hp.ne_zero)
  have h0 := Ideal.height_add_one_le_of_lt_of_isPrime hlt0
  have h1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt1
  have h2 := Ideal.height_add_one_le_of_lt_of_isPrime hPlt
  rw [Ideal.height_bot] at h0
  have h3 : (maximalIdeal R).height = 2 := by
    have := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := R)
    rw [hdim] at this
    exact WithBot.coe_injective (this.trans rfl)
  rw [h3] at h2
  have h4 : ((0 : ℕ∞) + 1 + 1 + 1) ≤ 2 :=
    calc ((0 : ℕ∞) + 1 + 1 + 1) ≤ (Ideal.span {p}).height + 1 + 1 :=
          add_le_add_left (add_le_add_left h0 1) 1
      _ ≤ P.height + 1 := add_le_add_left h1 1
      _ ≤ 2 := h2
  norm_num at h4

/-- A prime dividing a product of powers of primes is associated to one of them. -/
theorem exists_associated_of_dvd_prod {ι : Type*} {p : R} (hp : Prime p) {s : Finset ι}
    {a : ι → R} {m : ι → ℕ} (ha : ∀ i ∈ s, Prime (a i)) (h : p ∣ ∏ i ∈ s, a i ^ m i) :
    ∃ i ∈ s, Associated p (a i) := by
  have := IsRegularLocalRing.isDomain R
  obtain ⟨i, his, hdvd⟩ := (Prime.dvd_finsetProd_iff hp _).1 h
  exact ⟨i, his, hp.associated_of_dvd (ha i his) (hp.dvd_of_dvd_pow hdvd)⟩

/-- In a two-dimensional regular local ring, two elements without a common prime factor
generate an ideal containing a power of the maximal ideal. -/
theorem exists_pow_le_span_pair (hdim : ringKrullDim R = 2) {ι κ : Type*}
    (s : Finset ι) (t : Finset κ) (a : ι → R) (b : κ → R) (m : ι → ℕ) (n : κ → ℕ)
    (ha : ∀ i ∈ s, Prime (a i)) (hb : ∀ j ∈ t, Prime (b j))
    (hab : ∀ i ∈ s, ∀ j ∈ t, ¬ Associated (a i) (b j)) :
    ∃ N : ℕ, maximalIdeal R ^ N ≤ Ideal.span {∏ i ∈ s, a i ^ m i, ∏ j ∈ t, b j ^ n j} := by
  classical
  have := IsRegularLocalRing.isDomain R
  have := IsRegularLocalRing.uniqueFactorizationMonoid R
  set g := ∏ i ∈ s, a i ^ m i
  set g' := ∏ j ∈ t, b j ^ n j
  set I := Ideal.span {g, g'}
  have hg0 : g ≠ 0 := Finset.prod_ne_zero_iff.2 fun i hi => pow_ne_zero _ (ha i hi).ne_zero
  have hArt : IsArtinianRing (R ⧸ I) := by
    have : Ring.KrullDimLE 0 (R ⧸ I) := Ring.KrullDimLE.mk₀ fun J hJ => by
      have hP : (J.comap (Ideal.Quotient.mk I)).IsPrime := hJ.comap _
      have hIP : I ≤ J.comap (Ideal.Quotient.mk I) :=
        (Ideal.mk_ker (I := I)).symm.le.trans (Ideal.ker_le_comap _)
      have hgP : g ∈ J.comap (Ideal.Quotient.mk I) :=
        hIP (Ideal.subset_span (by simp))
      have hg'P : g' ∈ J.comap (Ideal.Quotient.mk I) :=
        hIP (Ideal.subset_span (by simp))
      have hmax : (J.comap (Ideal.Quotient.mk I)) = maximalIdeal R := by
        by_contra hne
        set P := J.comap (Ideal.Quotient.mk I)
        have hPlt : P < maximalIdeal R :=
          lt_of_le_of_ne (le_maximalIdeal hP.ne_top) hne
        have hPbot : P ≠ ⊥ := fun h => hg0 (by simpa [h] using hgP)
        obtain ⟨p, -, hp, hPeq⟩ := exists_prime_eq_span_of_lt_maximalIdeal hdim hP hPlt hPbot
        rw [hPeq, Ideal.mem_span_singleton] at hgP hg'P
        obtain ⟨i, his, hpi⟩ := exists_associated_of_dvd_prod hp ha hgP
        obtain ⟨j, hjt, hpj⟩ := exists_associated_of_dvd_prod hp hb hg'P
        exact hab i his j hjt (hpi.symm.trans hpj)
      refine Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := R) J ?_
      rw [Ideal.under_def, show (J.comap (algebraMap R (R ⧸ I))) = J.comap (Ideal.Quotient.mk I) from rfl, hmax]
      exact maximalIdeal.isMaximal R
    exact IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
  exact IsLocalRing.exists_maximalIdeal_pow_le_of_isArtinianRing_quotient I

end Finite

section Main

variable {k : Type*} [Field k] [Algebra k R]

/-- The maximal ideal of a regular local ring of Krull dimension two is generated by two
elements. -/
theorem spanFinrank_eq_two_of_ringKrullDim (hdim : ringKrullDim R = 2) :
    (maximalIdeal R).spanFinrank = 2 := by
  have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  rw [hdim] at this
  exact_mod_cast this

/-- In a two-dimensional regular local `k`-algebra with residue field `k`, for products
`g = ∏ a i ^ m i` and `g' = ∏ b j ^ n j` of powers of pairwise non-associated primes of orders
`oa i` and `ob j`, `(∑ m i * oa i) * (∑ n j * ob j) ≤ dim_k R / (g, g')`. -/
theorem sum_mul_sum_le_finrank (hdim : ringKrullDim R = 2)
    (hk : Function.Surjective (algebraMap k (R ⧸ maximalIdeal R))) {ι κ : Type*}
    [DecidableEq ι] [DecidableEq κ]
    (s : Finset ι) (t : Finset κ) (a : ι → R) (b : κ → R) (m : ι → ℕ) (n : κ → ℕ)
    (oa : ι → ℕ) (ob : κ → ℕ)
    (ha : ∀ i ∈ s, Prime (a i)) (hb : ∀ j ∈ t, Prime (b j))
    (hab : ∀ i ∈ s, ∀ j ∈ t, ¬ Associated (a i) (b j))
    (hoa : ∀ i ∈ s, a i ∈ maximalIdeal R ^ oa i ∧ a i ∉ maximalIdeal R ^ (oa i + 1))
    (hob : ∀ j ∈ t, b j ∈ maximalIdeal R ^ ob j ∧ b j ∉ maximalIdeal R ^ (ob j + 1)) :
    (∑ i ∈ s, m i * oa i) * (∑ j ∈ t, n j * ob j) ≤
      Module.finrank k (R ⧸ Ideal.span {∏ i ∈ s, a i ^ m i, ∏ j ∈ t, b j ^ n j}) := by
  have hd := spanFinrank_eq_two_of_ringKrullDim hdim
  obtain ⟨N, hN⟩ := exists_pow_le_span_pair hdim s t a b m n ha hb hab
  have hfin : FiniteDimensional k (R ⧸ Ideal.span {∏ i ∈ s, a i ^ m i, ∏ j ∈ t, b j ^ n j}) := by
    have := (finite_finrank_quotient_pow (k := k) hd hk N).1
    exact Module.Finite.of_surjective ((Submodule.factor hN).restrictScalars k)
      (Submodule.factor_surjective hN)
  have h1 := order_prod hd s a m oa hoa
  have h2 := order_prod hd t b n ob hob
  exact mul_le_finrank_quotient hd hk h1.1 h1.2 h2.1 h2.2 hfin

end Main

section Geometry

open MMP.Mori

variable {k : Type u} [Field k] [IsAlgClosed k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k))

/-- For a scheme locally of finite type over an algebraically closed field `k` and a closed point
`q`, the map from `k` to the residue field of the stalk at `q` is surjective. -/
theorem residue_surjective [LocallyOfFiniteType sY] (q : Y) (hq : IsClosed ({q} : Set Y)) :
    letI := stalkAlgebra sY q
    Function.Surjective
      (algebraMap k (Y.presheaf.stalk q ⧸ IsLocalRing.maximalIdeal (Y.presheaf.stalk q))) := by
  letI := stalkAlgebra sY q
  have hfin := finite_residueField_over_field_of_isClosed k sY q hq
  letI : Algebra k (Y.residueField q) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫ Y.Γevaluation q).hom.toAlgebra
  have hfin' : Module.Finite k (Y.residueField q) := hfin
  intro x
  obtain ⟨a, ha⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k)
    (K := Y.residueField q)).2 x
  refine ⟨a, ?_⟩
  rw [← ha]
  rfl

/-- For a scheme locally of finite type over an algebraically closed field and a closed point `q`,
the residue field at `q` has transcendence degree zero over the residue field of its image. -/
theorem trdeg_residue_eq_zero [LocallyOfFiniteType sY] (q : Y) (hq : IsClosed ({q} : Set Y)) :
    letI : Algebra ((Spec (.of k)).residueField (sY q)) (Y.residueField q) :=
      (sY.residueFieldMap q).hom.toAlgebra
    Algebra.trdeg ((Spec (.of k)).residueField (sY q)) (Y.residueField q) = 0 := by
  letI : Algebra ((Spec (.of k)).residueField (sY q)) (Y.residueField q) :=
      (sY.residueFieldMap q).hom.toAlgebra
  have hsurj := residue_surjective sY q hq
  have hcomp : Function.Surjective (sY.residueFieldMap q).hom := by
    have h := Scheme.Γevaluation_naturality sY q
    have hc : Function.Surjective
        (((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫ Y.Γevaluation q).hom) := hsurj
    rw [← h, ← Category.assoc, CommRingCat.hom_comp] at hc
    exact Function.Surjective.of_comp (g := fun x => _) (by simpa [RingHom.coe_comp] using hc)
  have : Algebra.IsAlgebraic ((Spec (.of k)).residueField (sY q)) (Y.residueField q) := by
    refine ⟨fun x => ?_⟩
    obtain ⟨a, rfl⟩ := hcomp x
    exact isAlgebraic_algebraMap a
  exact trdeg_eq_zero

omit [IsAlgClosed k] in
/-- Every stalk of the spectrum of a field has Krull dimension zero. -/
theorem ringKrullDim_stalk_spec_field (s : Spec (.of k)) :
    ringKrullDim ((Spec (.of k)).presheaf.stalk s) = 0 := by
  rw [ringKrullDim_stalk_eq_coheight]
  have : Order.coheight s = 0 := by
    rw [Order.coheight_eq_zero]
    intro b _
    have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
    exact le_of_eq (Subsingleton.elim b s)
  rw [this]
  rfl

/-- The local ring of a variety of dimension two over an algebraically closed field at a closed
point has Krull dimension two. -/
theorem ringKrullDim_stalk_eq_two (hY : MMP.Mori.IsVariety k sY) (hdim : topologicalKrullDim Y = 2)
    (q : Y) (hq : IsClosed ({q} : Set Y)) : ringKrullDim (Y.presheaf.stalk q) = 2 := by
  have := hY.toIsIntegral
  have := hY.toLocallyOfFiniteType
  have : IsDominant sY := ⟨by
    have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
    exact Function.Surjective.denseRange (fun _ => ⟨Classical.arbitrary Y, Subsingleton.elim _ _⟩)⟩
  have hcat : Scheme.IsUniversallyCatenary (Spec (.of k)) :=
    Scheme.isUniversallyCatenary_of_locallyOfFiniteType_over_field k (𝟙 _)
  have key := fun y => ringKrullDim_stalk_add_trdeg_residueField_eq sY hcat y
  have h0 := fun y : Y => ringKrullDim_stalk_spec_field (sY y)
  letI : ∀ y : Y, Algebra ((Spec (.of k)).residueField (sY y)) (Y.residueField y) :=
    fun y => (sY.residueFieldMap y).hom.toAlgebra
  obtain ⟨T, hT⟩ : ∃ T : WithBot ℕ∞, ∀ y, ringKrullDim (Y.presheaf.stalk y) +
      ((Cardinal.toNat
        (Algebra.trdeg ((Spec (.of k)).residueField (sY y)) (Y.residueField y)) : ℕ) :
        WithBot ℕ∞) = T :=
    ⟨_, fun y => (key y).trans (by rw [h0 y, zero_add])⟩
  have hle : ∀ y, ringKrullDim (Y.presheaf.stalk y) ≤ T := fun y =>
    (le_add_of_nonneg_right (by positivity)).trans_eq (hT y)
  have hdimT : topologicalKrullDim Y ≤ T := by
    rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk]
    exact iSup_le hle
  have hTq := hT q
  rw [trdeg_residue_eq_zero sY q hq] at hTq
  simp at hTq
  have h2 : ringKrullDim (Y.presheaf.stalk q) ≤ 2 := by
    rw [← hdim, topologicalKrullDim_eq_iSup_krullDimOfRing_stalk]
    exact le_iSup (fun y : Y => ringKrullDim (Y.presheaf.stalk y)) q
  rw [hdim] at hdimT
  exact le_antisymm h2 (hTq ▸ hdimT)

end Geometry

section Divisors

variable {k : Type u} [Field k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType sY]
  (hsm : IsSmoothScheme sY) (q : Y)

open Classical in
/-- A local equation of a prime divisor `E` at `q`: a prime element generating the stalk of the
ideal of `E` at `q` if `q ∈ E`, and `1` otherwise. -/
def piOf (E : PrimeDivisor Y) : Y.presheaf.stalk q :=
  if h : q ∈ E.support then
    Classical.choose (MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sY hsm E h)
  else 1

variable {sY hsm q}

/-- If `q ∉ E`, then `piOf sY hsm q E = 1`. -/
theorem piOf_of_notMem {E : PrimeDivisor Y} (h : q ∉ E.support) : piOf sY hsm q E = 1 := by
  simp [piOf, h]

/-- If `q ∈ E`, then `piOf sY hsm q E` is prime. -/
theorem prime_piOf {E : PrimeDivisor Y} (h : q ∈ E.support) : Prime (piOf sY hsm q E) := by
  simp only [piOf, h, dite_true]
  exact (Classical.choose_spec (MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sY hsm E h)).1

/-- The stalk at `q` of the ideal sheaf of `E` is generated by `piOf sY hsm q E`. -/
theorem stalk_eq_span_piOf (E : PrimeDivisor Y) :
    IdealSheafData.stalk E.idealSheaf q = Ideal.span {piOf sY hsm q E} := by
  by_cases h : q ∈ E.support
  · simp only [piOf, h, dite_true]
    exact (Classical.choose_spec
      (MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sY hsm E h)).2
  · rw [piOf_of_notMem h, (IdealSheafData.stalk_eq_top_iff_notMem_support E.idealSheaf q).2 h]
    simp

open Classical in
/-- The local ideal of the divisor `C` at `q` is generated by the product of the powers
`piOf sY hsm q E ^ (C E).toNat` over the components `E` of `C` through `q`. -/
theorem localIdeal_eq_span (C : Divisor Y) :
    localIdeal q C = Ideal.span {(∏ E ∈ C.support.filter (fun E : PrimeDivisor Y => q ∈ E.support),
      piOf sY hsm q E ^ (C E).toNat)} := by
  unfold localIdeal
  simp only [stalk_eq_span_piOf (sY := sY) (hsm := hsm) (q := q), Ideal.span_singleton_pow]
  rw [Ideal.prod_span_singleton]
  congr 1
  rw [Finset.prod_filter]
  refine congrArg _ (Finset.prod_congr rfl fun E _ => ?_)
  by_cases h : q ∈ E.support
  · simp [h]
  · simp [h, piOf_of_notMem h]

/-- If each local equation `piOf sY hsm q E` lies in `𝔪^(ord E) ∖ 𝔪^(ord E + 1)`, the
multiplicity of `E` at `q` is `ord E`. -/
theorem multiplicityAt_eq_of_order [IsRegularLocalRing (Y.presheaf.stalk q)]
    (ord : PrimeDivisor Y → ℕ)
    (hord : ∀ E, piOf sY hsm q E ∈ maximalIdeal (Y.presheaf.stalk q) ^ ord E ∧
      piOf sY hsm q E ∉ maximalIdeal (Y.presheaf.stalk q) ^ (ord E + 1)) (E : PrimeDivisor Y) :
    E.multiplicityAt q = (ord E : ℕ∞) := by
  have hg : E.idealSheaf.stalkIdeal q = Ideal.span {piOf sY hsm q E} := by
    rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk, stalk_eq_span_piOf (sY := sY) (hsm := hsm)]
  rw [PrimeDivisor.multiplicityAt_eq_localMultiplicity E hg]
  exact le_antisymm (iSup₂_le fun m hm => by
    exact_mod_cast (mem_pow_iff_le_of_order (hord E).1 (hord E).2 m).1 hm)
    (le_localMultiplicity (hord E).1)

open Classical in
/-- If each local equation `piOf sY hsm q E` lies in `𝔪^(ord E) ∖ 𝔪^(ord E + 1)`, the
multiplicity at `q` of an effective divisor `C` is `∑ (C E).toNat * ord E` over the components `E`
of `C` through `q`. -/
theorem divisor_multiplicityAt_eq [IsRegularLocalRing (Y.presheaf.stalk q)]
    (ord : PrimeDivisor Y → ℕ)
    (hord : ∀ E, piOf sY hsm q E ∈ maximalIdeal (Y.presheaf.stalk q) ^ ord E ∧
      piOf sY hsm q E ∉ maximalIdeal (Y.presheaf.stalk q) ^ (ord E + 1))
    (C : Divisor Y) (hC : C.IsEffective) :
    C.multiplicityAt q = ((∑ E ∈ C.support.filter (fun E : PrimeDivisor Y => q ∈ E.support),
      (C E).toNat * ord E : ℕ) : ℤ) := by
  unfold DivisorWithCoeffs.multiplicityAt
  rw [Finsupp.sum]
  have hsub : C.support.filter (fun E : PrimeDivisor Y => q ∈ E.support) ⊆ C.support :=
    Finset.filter_subset _ _
  rw [← Finset.sum_subset hsub]
  · push_cast
    refine Finset.sum_congr rfl fun E _ => ?_
    rw [multiplicityAt_eq_of_order (sY := sY) (hsm := hsm) ord hord E]
    have h0 : 0 ≤ C E := hC E
    simp only [ENat.toNat_natCast, nsmul_eq_mul]
    rw [mul_comm]
    congr 1
    exact (Int.toNat_of_nonneg h0).symm
  · intro E hE hnot
    have : q ∉ E.support := fun h => hnot (Finset.mem_filter.2 ⟨hE, h⟩)
    rw [PrimeDivisor.multiplicityAt_eq_zero_of_notMem E this]
    simp

end Divisors

section Main

variable {k : Type u} [Field k] [IsAlgClosed k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k))

open Classical in
/-- **Local intersection numbers bound the product of multiplicities.** -/
theorem multiplicityAt_mul_le (hY : IsVariety k sY) (hsm : IsSmoothScheme sY)
    (hdim : topologicalKrullDim Y = 2) {q : Y} (hq : IsClosed ({q} : Set Y))
    {C C' : Divisor Y} (hC : C.IsEffective) (hC' : C'.IsEffective)
    (hCC' : ∀ E ∈ C.support, E ∈ C'.support → q ∉ E.support) :
    C.multiplicityAt q * C'.multiplicityAt q ≤ (localIntersectionNumber sY q C C' : ℤ) := by
  have := hY.toLocallyOfFiniteType
  letI := stalkAlgebra sY q
  have := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sY hsm
  have : IsRegularLocalRing (Y.presheaf.stalk q) :=
    isRegularLocalRing_stalk_of_smooth_over_field sY q
  have hdimR := ringKrullDim_stalk_eq_two sY hY hdim q hq
  have hk := residue_surjective sY q hq
  have hne : ∀ E : PrimeDivisor Y, piOf sY hsm q E ≠ 0 := fun E => by
    by_cases h : q ∈ E.support
    · exact (prime_piOf h).ne_zero
    · rw [piOf_of_notMem h]; exact one_ne_zero
  choose ord hord using fun E : PrimeDivisor Y => exists_order (hne E)
  set s := C.support.filter (fun E : PrimeDivisor Y => q ∈ E.support) with hs
  set t := C'.support.filter (fun E : PrimeDivisor Y => q ∈ E.support) with ht
  rw [divisor_multiplicityAt_eq ord hord C hC, divisor_multiplicityAt_eq ord hord C' hC',
    localIntersectionNumber_eq_of_span sY q (localIdeal_eq_span (sY := sY) (hsm := hsm) C)
      (localIdeal_eq_span (sY := sY) (hsm := hsm) C')]
  rw [← Nat.cast_mul]
  refine Nat.cast_le.2 ?_
  refine sum_mul_sum_le_finrank (k := k) hdimR hk s t (piOf sY hsm q) (piOf sY hsm q)
    (fun E => (C E).toNat) (fun E => (C' E).toNat) ord ord ?_ ?_ ?_ ?_ ?_
  · intro E hE; exact prime_piOf (Finset.mem_filter.1 hE).2
  · intro E hE; exact prime_piOf (Finset.mem_filter.1 hE).2
  · intro E hE E' hE' hass
    obtain ⟨hEC, hEq⟩ := Finset.mem_filter.1 hE
    obtain ⟨hEC', hEq'⟩ := Finset.mem_filter.1 hE'
    have := IsRegularLocalRing.isDomain (Y.presheaf.stalk q)
    have he : IdealSheafData.stalk E.idealSheaf q = IdealSheafData.stalk E'.idealSheaf q := by
      rw [stalk_eq_span_piOf (sY := sY) (hsm := hsm), stalk_eq_span_piOf (sY := sY) (hsm := hsm),
        Ideal.span_singleton_eq_span_singleton.2 hass]
    have hEE := MMP.Resolution.Aux.eq_of_stalk_idealSheaf_eq sY hsm E E' hEq hEq' he
    subst hEE
    exact hCC' E hEC hEC' hEq
  · intro E _; exact hord E
  · intro E _; exact hord E

end Main

