module

public import MMP.AlgebraicGeometry.Divisor.Canonical.PluricanonicalForms
public import StacksFrontier.FieldTheory.KaehlerDifferential.CartierEquality
public import StacksFrontier.FieldTheory.Separable.PerfectField
public import StacksFrontier.RingTheory.Smooth.RegularLocalRing
public import StacksFrontier.AlgebraicGeometry.Variety.Defs.Dimension.Trdeg
public import Mathlib.FieldTheory.FinTrdeg

/-!
# Generators of the top differential forms along a prime divisor

Let `X` be a normal variety over a perfect field `k` (for instance a field of characteristic
zero), with function field `k(X)` of transcendence degree `d` over `k`, and let `Γ` be a prime
divisor of `X`. The local ring `𝒪_{X,Γ}` is a discrete valuation ring, hence a regular local ring,
essentially of finite type over `k`; its residue field is separable over the perfect field `k`, so
`𝒪_{X,Γ}` is formally smooth over `k` and `Ω_{𝒪_{X,Γ}/k}` is a finite free module. Its rank is the
dimension `d` of its localization `Ω_{k(X)/k}`, which is the transcendence degree of `k(X)/k`
because `k(X)` is formally smooth over `k`. Hence `Ω^d_{𝒪_{X,Γ}/k}` is free of rank one, and every
generator `σ` has nonzero image in the line `Ω^d_{k(X)/k}`.

Consequently the order `ord_Γ(τ)` of a rational `m`-canonical form is always the valuation
`v_Γ(τ / σ^{⊗m})` along such a generator, and it satisfies `ord_Γ(f • τ) = v_Γ(f) + ord_Γ(τ)`.

## Main results

* `MMP.Mori.finrank_kaehlerDifferential_eq_trdeg`: for a field `K` essentially of finite type over
  a perfect field `k`, `dim_K Ω_{K/k} = trdeg_k K`.
* `MMP.Mori.exists_span_singleton_eq_top_exteriorPower`: the `d`-th exterior power of a free module
  of rank `d` is generated by one element.
* `MMP.Mori.topFormsMap_ne_zero_of_span_eq_top`: a generator of `Ω^d_{A/k}` has nonzero image in
  `Ω^d_{K/k}` when the latter is nonzero.
* `MMP.Mori.PrimeDivisor.formallySmooth_localRing`: on a normal scheme locally of finite type over
  a perfect field, `𝒪_{X,Γ}` is formally smooth over `k`.
* `MMP.Mori.PrimeDivisor.free_kaehlerDifferential_localRing`,
  `MMP.Mori.PrimeDivisor.finrank_kaehlerDifferential_localRing`: `Ω_{𝒪_{X,Γ}/k}` is free of rank
  `trdeg_k k(X)`.
* `MMP.Mori.PrimeDivisor.exists_topForms_generator`: `Ω^d_{𝒪_{X,Γ}/k}` has a generator with
  nonzero image in `Ω^d_{k(X)/k}`, and `MMP.Mori.PrimeDivisor.topFormsMap_ne_zero`: every
  generator has nonzero image.
* `MMP.Mori.PrimeDivisor.ordForm_smul`: `ord_Γ(f • τ) = v_Γ(f) + ord_Γ(τ)`.
* `MMP.Mori.toENat_trdeg_functionField`: `dim X = trdeg_k k(X)`, so the results above hold with
  `d = dim X` (`MMP.Mori.PrimeDivisor.exists_topForms_generator_of_topologicalKrullDim_eq`,
  `MMP.Mori.PrimeDivisor.ordForm_smul_of_topologicalKrullDim_eq`).
* `MMP.Mori.exists_isPullbackGenerator_of_formallyEtale`, `MMP.Mori.exists_isPullbackGenerator`:
  along a formally étale extension `K'/K`, and in characteristic zero along an extension of the
  same transcendence degree, a generator of `Ω^d_{K/k}` pulls back to a generator of
  `Ω^d_{K'/k}`.

## Implementation notes

The dimension `d` of the forms is the transcendence degree of `k(X)` over `k`; for a variety it is
its dimension, the Krull dimension of the underlying space.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], 2.10
* [The Stacks Project, Tags 00TV, 07E1, 0A21](https://stacks.math.columbia.edu)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace
open scoped TensorProduct

universe u v

namespace MMP.Mori

/-! ### Top forms of a free module of differentials -/

section Algebra

/-- The `d`-th exterior power of a free module of rank `d` is generated by a single element. -/
theorem exists_span_singleton_eq_top_exteriorPower {A M : Type*} [CommRing A] [Nontrivial A]
    [AddCommGroup M] [Module A M] [Module.Free A M] [Module.Finite A M] {d : ℕ}
    (h : Module.finrank A M = d) : ∃ σ : ⋀[A]^d M, Submodule.span A {σ} = ⊤ := by
  classical
  let b := Module.Free.chooseBasis A (⋀[A]^d M)
  obtain ⟨_⟩ : Nonempty (Unique (Module.Free.ChooseBasisIndex A (⋀[A]^d M))) :=
    Fintype.card_eq_one_iff_nonempty_unique.mp <| by
      rw [← Module.finrank_eq_card_chooseBasisIndex, exteriorPower.finrank_eq, h, Nat.choose_self]
  exact ⟨b default, by rw [← b.span_eq, Set.range_unique]⟩

variable {k : Type*} [CommRing k] {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
  {K : Type*} [Field K] [Algebra k K] [Algebra A K] [IsScalarTower k A K] [IsFractionRing A K]

/-- If `Ω_{A/k}` is finite free, its rank is the dimension of `Ω_{K/k}`, for `K` the fraction field
of `A`. -/
theorem finrank_kaehlerDifferential_eq_of_isFractionRing [Module.Free A Ω[A⁄k]]
    [Module.Finite A Ω[A⁄k]] :
    Module.finrank K Ω[K⁄k] = Module.finrank A Ω[A⁄k] := by
  let b := Module.Free.chooseBasis A Ω[A⁄k]
  let b' := b.ofIsLocalizedModule K (nonZeroDivisors A) (KaehlerDifferential.map k k A K)
  rw [Module.finrank_eq_card_basis b, Module.finrank_eq_card_basis b']

variable (k K) in
/-- If `Ω_{K/k}` has dimension `d`, the line `Ω^d_{K/k}` is nonzero. -/
theorem nontrivial_exteriorPower_of_finrank_eq {d : ℕ} [FiniteDimensional K Ω[K⁄k]]
    (h : Module.finrank K Ω[K⁄k] = d) : Nontrivial (⋀[K]^d Ω[K⁄k]) :=
  Module.nontrivial_of_finrank_pos (R := K) (by simp [exteriorPower.finrank_eq, h])

omit [IsDomain A] in
/-- A generator `σ` of `Ω^d_{A/k}` has nonzero image in `Ω^d_{K/k}` when the latter is nonzero,
since that image spans `Ω^d_{K/k}`. -/
theorem topFormsMap_ne_zero_of_span_eq_top {d : ℕ} [Nontrivial (⋀[K]^d Ω[K⁄k])]
    {σ : ⋀[A]^d Ω[A⁄k]} (hσ : Submodule.span A {σ} = ⊤) : topFormsMap k A K d σ ≠ 0 := by
  intro h0
  have := span_singleton_topFormsMap (k := k) (K := K) (d := d) (nonZeroDivisors A) hσ
  rw [h0, Submodule.span_zero_singleton] at this
  exact bot_ne_top this

/-- If `Ω_{A/k}` is finite free of rank `d`, then `Ω^d_{A/k}` has a generator, and every
generator has nonzero image in `Ω^d_{K/k}`. -/
theorem exists_topForms_generator_of_free [Module.Free A Ω[A⁄k]] [Module.Finite A Ω[A⁄k]]
    {d : ℕ} (h : Module.finrank A Ω[A⁄k] = d) :
    ∃ σ : ⋀[A]^d Ω[A⁄k], Submodule.span A {σ} = ⊤ ∧ topFormsMap k A K d σ ≠ 0 := by
  have hK : Module.finrank K Ω[K⁄k] = d :=
    (finrank_kaehlerDifferential_eq_of_isFractionRing (A := A)).trans h
  have : FiniteDimensional K Ω[K⁄k] := Module.Finite.of_basis
    ((Module.Free.chooseBasis A Ω[A⁄k]).ofIsLocalizedModule K (nonZeroDivisors A)
      (KaehlerDifferential.map k k A K))
  have := nontrivial_exteriorPower_of_finrank_eq k K hK
  obtain ⟨σ, hσ⟩ := exists_span_singleton_eq_top_exteriorPower h
  exact ⟨σ, hσ, topFormsMap_ne_zero_of_span_eq_top hσ⟩

end Algebra

/-! ### Differentials of a field over a perfect field -/

variable (k K : Type*) [Field k] [Field K] [Algebra k K] in
/-- For a field `K` essentially of finite type over a perfect field `k`,
`dim_K Ω_{K/k} = trdeg_k K`: `K` is formally smooth over `k`, so `H₁(L_{K/k}) = 0`, and Cartier's
equality `trdeg_k K = dim Ω_{K/k} - dim H₁(L_{K/k})` applies. -/
theorem finrank_kaehlerDifferential_eq_trdeg [PerfectField k] [Algebra.EssFiniteType k K] :
    Module.finrank K Ω[K⁄k] = (Algebra.trdeg k K).toNat := by
  have h := (trdeg_eq_finrank_kaehlerDifferential_sub_finrank_h1Cotangent k K).2.2
  rw [Module.finrank_zero_of_subsingleton (M := Algebra.H1Cotangent k K), Nat.cast_zero,
    sub_zero] at h
  exact_mod_cast h.symm

/-! ### The local ring along a prime divisor -/

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

namespace PrimeDivisor

/-- **The local ring along a prime divisor is formally smooth.** On a normal scheme locally of
finite type over a perfect field `k`, the local ring `𝒪_{X,Γ}` along a prime divisor `Γ` is
essentially of finite type and formally smooth over `k`: it is the localization of a finitely
generated `k`-algebra `Γ(X, U)` at a prime with residue field separable over `k`, and a discrete
valuation ring, hence regular (Stacks 00TV). -/
theorem formallySmooth_localRing [PerfectField k] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) :
    letI := stalkAlgebra sX Γ.genericPoint
    Algebra.FormallySmooth k Γ.localRing ∧ Algebra.EssFiniteType k Γ.localRing := by
  let := stalkAlgebra sX Γ.genericPoint
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ Γ.genericPoint) isOpen_univ
  have hU' : IsAffineOpen U := hU
  let x : U := ⟨Γ.genericPoint, hxU⟩
  let := sectionAlgebra sX U
  have := finiteType_sectionAlgebra sX hU'
  let : Algebra Γ(X, U) Γ.localRing := TopCat.Presheaf.algebra_section_stalk X.presheaf x
  have := isScalarTower_section_stalk sX U x
  have := hU'.isLocalization_stalk x
  have := Γ.isDiscreteValuationRing_localRing
  set q := (hU'.primeIdealOf x).asIdeal
  have := Algebra.isSeparableExtension_of_perfectField k q.ResidueField
  have hs : Algebra.IsSmoothAt k q :=
    (Algebra.isSmoothAt_iff_isRegularLocalRing q Γ.localRing).mpr inferInstance
  have : Algebra.EssFiniteType Γ(X, U) Γ.localRing := .of_isLocalization _ q.primeCompl
  refine ⟨?_, .comp k Γ(X, U) Γ.localRing⟩
  exact Algebra.FormallySmooth.of_equiv
    ((IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q) Γ.localRing).restrictScalars k)

/-- On a normal scheme locally of finite type over a perfect field `k`, `Ω_{𝒪_{X,Γ}/k}` is a
finite free `𝒪_{X,Γ}`-module, for every prime divisor `Γ`. -/
theorem free_kaehlerDifferential_localRing [PerfectField k] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) :
    letI := stalkAlgebra sX Γ.genericPoint
    Module.Free Γ.localRing Ω[Γ.localRing⁄k] ∧ Module.Finite Γ.localRing Ω[Γ.localRing⁄k] := by
  let := stalkAlgebra sX Γ.genericPoint
  obtain ⟨_, _⟩ := Γ.formallySmooth_localRing (sX := sX)
  have := Γ.isDiscreteValuationRing_localRing
  exact ⟨Module.free_of_flat_of_isLocalRing, inferInstance⟩

end PrimeDivisor

/-! ### The function field -/

variable [IsIntegral X]

/-- The function field of an integral scheme locally of finite type over `k` is essentially of
finite type over `k`: it is the fraction field of the finitely generated `k`-algebra `Γ(X, U)` of a
nonempty affine open `U`. -/
theorem essFiniteType_functionField [LocallyOfFiniteType sX] :
    letI := functionFieldAlgebra sX
    Algebra.EssFiniteType k X.functionField := by
  let := functionFieldAlgebra sX
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  obtain ⟨_, ⟨U, hU, rfl⟩, hx₀U, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x₀) isOpen_univ
  have hU' : IsAffineOpen U := hU
  have : Nonempty U := ⟨⟨x₀, hx₀U⟩⟩
  let := sectionAlgebra sX U
  have := isScalarTower_section_functionField sX U
  have := finiteType_sectionAlgebra sX hU'
  have : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU'
  have : Algebra.EssFiniteType Γ(X, U) X.functionField :=
    .of_isLocalization _ (nonZeroDivisors Γ(X, U))
  exact .comp k Γ(X, U) X.functionField

/-- **The dimension of a variety is the transcendence degree of its function field** (Stacks 0A21):
for an integral scheme `X` locally of finite type over `k`, `dim X = trdeg_k k(X)`. -/
theorem toENat_trdeg_functionField [LocallyOfFiniteType sX] :
    letI := functionFieldAlgebra sX
    (Cardinal.toENat (Algebra.trdeg k X.functionField) : WithBot ℕ∞) = topologicalKrullDim X := by
  let := functionFieldAlgebra sX
  rw [topologicalKrullDim_eq_trdeg_residueField k X sX (genericPoint X) (genericPoint_spec X)]
  let : Algebra k (X.residueField (genericPoint X)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.Γevaluation (genericPoint X)).hom.toAlgebra
  have hbij : Function.Bijective (X.residue (genericPoint X)) :=
    ⟨RingHom.injective _, X.residue_surjective _⟩
  let e : X.functionField ≃ₐ[k] X.residueField (genericPoint X) :=
    { RingEquiv.ofBijective (X.residue (genericPoint X)).hom hbij with
      commutes' := fun _ => rfl }
  rw [e.trdeg_eq]

/-- If `X` has dimension `d`, then `trdeg_k k(X) = d`. -/
theorem toNat_trdeg_functionField_of_topologicalKrullDim_eq [LocallyOfFiniteType sX] {d : ℕ}
    (hd : topologicalKrullDim X = d) :
    letI := functionFieldAlgebra sX
    (Algebra.trdeg k X.functionField).toNat = d := by
  let := functionFieldAlgebra sX
  have h := (toENat_trdeg_functionField (sX := sX)).trans hd
  have h' : Cardinal.toENat (Algebra.trdeg k X.functionField) = d := by exact_mod_cast h
  rw [← Cardinal.toNat_toENat, h']
  rfl

namespace PrimeDivisor

/-- **The rank of the differentials along a prime divisor.** On a normal integral scheme locally of
finite type over a perfect field `k`, `Ω_{𝒪_{X,Γ}/k}` has rank `trdeg_k k(X)`. -/
theorem finrank_kaehlerDifferential_localRing [PerfectField k] [IsLocallyNoetherian X]
    [IsNormal X] [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) :
    letI := stalkAlgebra sX Γ.genericPoint
    letI := functionFieldAlgebra sX
    Module.finrank Γ.localRing Ω[Γ.localRing⁄k] = (Algebra.trdeg k X.functionField).toNat := by
  let := stalkAlgebra sX Γ.genericPoint
  let := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX Γ.genericPoint
  obtain ⟨_, _⟩ := Γ.free_kaehlerDifferential_localRing (sX := sX)
  have := essFiniteType_functionField (sX := sX)
  rw [← finrank_kaehlerDifferential_eq_of_isFractionRing (K := X.functionField),
    finrank_kaehlerDifferential_eq_trdeg]

/-- **Generators of the top forms along a prime divisor.** On a normal integral scheme locally of
finite type over a perfect field `k`, with `d = trdeg_k k(X)`, the module `Ω^d_{𝒪_{X,Γ}/k}` has a
generator `σ` whose image in `Ω^d_{k(X)/k}` is nonzero. -/
theorem exists_topForms_generator [PerfectField k] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d) :
    letI := stalkAlgebra sX Γ.genericPoint
    letI := functionFieldAlgebra sX
    haveI := isScalarTower_stalk_functionField sX Γ.genericPoint
    ∃ σ : ⋀[Γ.localRing]^d Ω[Γ.localRing⁄k], Submodule.span Γ.localRing {σ} = ⊤ ∧
      topFormsMap k Γ.localRing X.functionField d σ ≠ 0 := by
  let := stalkAlgebra sX Γ.genericPoint
  let := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX Γ.genericPoint
  obtain ⟨_, _⟩ := Γ.free_kaehlerDifferential_localRing (sX := sX)
  exact exists_topForms_generator_of_free ((Γ.finrank_kaehlerDifferential_localRing).trans hd)

/-- On a normal integral scheme locally of finite type over a perfect field `k`, with
`d = trdeg_k k(X)`, every generator of `Ω^d_{𝒪_{X,Γ}/k}` has nonzero image in `Ω^d_{k(X)/k}`. -/
theorem topFormsMap_ne_zero [PerfectField k] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d) :
    letI := stalkAlgebra sX Γ.genericPoint
    letI := functionFieldAlgebra sX
    haveI := isScalarTower_stalk_functionField sX Γ.genericPoint
    ∀ {σ : ⋀[Γ.localRing]^d Ω[Γ.localRing⁄k]}, Submodule.span Γ.localRing {σ} = ⊤ →
      topFormsMap k Γ.localRing X.functionField d σ ≠ 0 := by
  let := stalkAlgebra sX Γ.genericPoint
  let := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX Γ.genericPoint
  intro σ hσ
  have := essFiniteType_functionField (sX := sX)
  have hK : Module.finrank X.functionField Ω[X.functionField⁄k] = d :=
    (finrank_kaehlerDifferential_eq_trdeg k X.functionField).trans hd
  have := nontrivial_exteriorPower_of_finrank_eq k X.functionField hK
  exact topFormsMap_ne_zero_of_span_eq_top hσ

/-- **The order of a multiple of a form.** On a normal integral scheme locally of finite type over
a perfect field `k`, for rational `m`-canonical forms in degree `d = trdeg_k k(X)`,
`ord_Γ(f • τ) = v_Γ(f) + ord_Γ(τ)` for `f ≠ 0` and `τ ≠ 0`. -/
theorem ordForm_smul [PerfectField k] [IsLocallyNoetherian X] [IsNormal X]
    [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) {d : ℕ}
    (hd : letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = d) {m : ℤ}
    {f : X.functionField} (hf : f ≠ 0) {τ : RationalPluriForms sX d m} (hτ : τ ≠ 0) :
    Γ.ordForm (f • τ) = X.ord f Γ.genericPoint + Γ.ordForm τ := by
  let := stalkAlgebra sX Γ.genericPoint
  let := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX Γ.genericPoint
  exact ordAt_smul (k := k) Γ.ord_mul_of_ne_zero (fun _ ha => Γ.ord_algebraMap_of_isUnit ha)
    (Γ.exists_topForms_generator hd) hf hτ

/-- **Generators of the top forms on a variety.** On a normal integral scheme `X` of dimension
`d`, locally of finite type over a perfect field `k`, `Ω^d_{𝒪_{X,Γ}/k}` has a generator with
nonzero image in `Ω^d_{k(X)/k}`, for every prime divisor `Γ`. -/
theorem exists_topForms_generator_of_topologicalKrullDim_eq [PerfectField k]
    [IsLocallyNoetherian X] [IsNormal X] [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) {d : ℕ}
    (hd : topologicalKrullDim X = d) :
    letI := stalkAlgebra sX Γ.genericPoint
    letI := functionFieldAlgebra sX
    haveI := isScalarTower_stalk_functionField sX Γ.genericPoint
    ∃ σ : ⋀[Γ.localRing]^d Ω[Γ.localRing⁄k], Submodule.span Γ.localRing {σ} = ⊤ ∧
      topFormsMap k Γ.localRing X.functionField d σ ≠ 0 :=
  Γ.exists_topForms_generator (toNat_trdeg_functionField_of_topologicalKrullDim_eq hd)

/-- On a normal integral scheme `X` of dimension `d`, locally of finite type over a perfect field
`k`, `ord_Γ(f • τ) = v_Γ(f) + ord_Γ(τ)` for rational `m`-canonical forms `τ ≠ 0` and `f ≠ 0`. -/
theorem ordForm_smul_of_topologicalKrullDim_eq [PerfectField k] [IsLocallyNoetherian X]
    [IsNormal X] [LocallyOfFiniteType sX] (Γ : PrimeDivisor X) {d : ℕ}
    (hd : topologicalKrullDim X = d) {m : ℤ} {f : X.functionField} (hf : f ≠ 0)
    {τ : RationalPluriForms sX d m} (hτ : τ ≠ 0) :
    Γ.ordForm (f • τ) = X.ord f Γ.genericPoint + Γ.ordForm τ :=
  Γ.ordForm_smul (toNat_trdeg_functionField_of_topologicalKrullDim_eq hd) hf hτ

end PrimeDivisor

/-! ### Pull-back generators along an algebraic extension of function fields -/

section Pullback

variable {k : Type*} [CommRing k] {K K' : Type*} [Field K] [Field K'] [Algebra k K]
  [Algebra k K'] [Algebra K K'] [IsScalarTower k K K'] {d : ℕ}

/-- **Pull-back generators along a formally étale extension.** If `K'/K` is formally étale and
`Ω_{K/k}` has dimension `d`, then `Ω_{K'/k} = K' ⊗_K Ω_{K/k}`, so a generator `ω` of the line
`Ω^d_{K/k}` pulls back to a generator `u^*ω` of the line `Ω^d_{K'/k}`. -/
theorem exists_isPullbackGenerator_of_formallyEtale [Algebra.FormallyEtale K K']
    [FiniteDimensional K Ω[K⁄k]] (h : Module.finrank K Ω[K⁄k] = d) :
    ∃ ω : ⋀[K]^d Ω[K⁄k], IsPullbackGenerator K' ω := by
  have ibc := KaehlerDifferential.isBaseChange_of_formallyEtale k K K'
  let b := Module.finBasis K Ω[K⁄k]
  let b' := ibc.basis b
  have : FiniteDimensional K' Ω[K'⁄k] := Module.Finite.of_basis b'
  have h' : Module.finrank K' Ω[K'⁄k] = d := by
    rw [Module.finrank_eq_card_basis b', Fintype.card_fin, h]
  have := nontrivial_exteriorPower_of_finrank_eq k K' h'
  obtain ⟨ω, hω⟩ := exists_span_singleton_eq_top_exteriorPower h
  have hs : Submodule.span K' (Set.range (KaehlerDifferential.map k k K K')) = ⊤ := by
    refine eq_top_iff.mpr (b'.span_eq.symm.le.trans (Submodule.span_mono ?_))
    rintro - ⟨i, rfl⟩
    exact ⟨b i, (ibc.basis_apply b i).symm⟩
  have hrange : Submodule.span K' (Set.range (topFormsMap k K K' d)) = ⊤ := by
    refine eq_top_iff.mpr ((exteriorPower.ιMulti_span_of_span K' d (M := Ω[K'⁄k]) hs).symm.le.trans
      (Submodule.span_mono ?_))
    rintro - ⟨a, ha, rfl⟩
    have : ∀ i, ∃ x : Ω[K⁄k], KaehlerDifferential.map k k K K' x = a i :=
      fun i => by simpa using ha (Set.mem_range_self i)
    choose x hx using this
    exact ⟨exteriorPower.ιMulti K d x, by simp [topFormsMap_ιMulti, hx]⟩
  have hspan : Submodule.span K' {topFormsMap k K K' d ω} = ⊤ := by
    refine eq_top_iff.mpr (hrange.symm.le.trans ?_)
    rw [Submodule.span_le]
    rintro - ⟨y, rfl⟩
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp (hω ▸ Submodule.mem_top (x := y))
    rw [map_smul, ← algebraMap_smul K']
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
  refine ⟨ω, hω, hspan, fun h0 => ?_⟩
  rw [h0, Submodule.span_zero_singleton] at hspan
  exact bot_ne_top hspan

end Pullback

variable (k : Type*) {K K' : Type v} [Field k] [Field K] [Field K'] [Algebra k K]
  [Algebra k K'] [Algebra K K'] [IsScalarTower k K K'] in
/-- An extension `K'/K` of fields over `k`, with `K` essentially of finite type over `k` and
`trdeg_k K = trdeg_k K'`, is algebraic. -/
theorem isAlgebraic_of_trdeg_eq [Algebra.EssFiniteType k K]
    (h : Algebra.trdeg k K = Algebra.trdeg k K') : Algebra.IsAlgebraic K K' := by
  rw [← trdeg_eq_zero_iff]
  have h1 := trdeg_add_eq k K (A := K')
  rw [← h, add_comm] at h1
  exact (Cardinal.add_right_inj_of_lt_aleph0 (α := Algebra.trdeg K K') (β := 0)
    (trdeg_lt_aleph0 (K := k) (L := K))).mp (by rw [h1, zero_add])

variable {k : Type*} {K K' : Type v} [Field k] [CharZero k] [Field K] [Field K'] [Algebra k K]
  [Algebra k K'] [Algebra K K'] [IsScalarTower k K K'] in
/-- **Pull-back generators in characteristic zero.** Let `K ⊆ K'` be fields over a field `k` of
characteristic zero, with `K` essentially of finite type over `k` and of the same transcendence
degree `d` as `K'` (the function fields of a dominant morphism of varieties of the same dimension).
Then `K'/K` is algebraic, hence separable and formally étale, and `Ω^d_{K/k}` has a generator whose
pull-back generates `Ω^d_{K'/k}`; so `MMP.Mori.pullbackForms` is given by
`MMP.Mori.pullbackForms_eq`. -/
theorem exists_isPullbackGenerator [Algebra.EssFiniteType k K]
    (h : Algebra.trdeg k K = Algebra.trdeg k K') {d : ℕ} (hd : (Algebra.trdeg k K).toNat = d) :
    ∃ ω : ⋀[K]^d Ω[K⁄k], IsPullbackGenerator K' ω := by
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap k K).injective
  have := isAlgebraic_of_trdeg_eq k h
  have : Algebra.FormallyEtale K K' := Algebra.FormallyEtale.of_isSeparable K K'
  have : FiniteDimensional K Ω[K⁄k] :=
    (trdeg_eq_finrank_kaehlerDifferential_sub_finrank_h1Cotangent k K).1
  exact exists_isPullbackGenerator_of_formallyEtale
    ((finrank_kaehlerDifferential_eq_trdeg k K).trans hd)

end MMP.Mori
