module

public import MMP.Attr
public import MMP.AlgebraicGeometry.Divisor.DivisorialSheaf
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Coherent

/-!
# Weil divisorial subsheaves in *Flips and abundance*

The definitions of FA 16.1.1–16.1.5: `𝒪_X`-submodules of the sheaf of rational functions
`K(X)` (`MMP.Mori.rationalFunctionsPresheaf`), their saturation, Weil divisorial subsheaves, the
support of a Weil divisorial subsheaf, the inverse `𝓛⁻¹` and the product `𝓛 · 𝓛' = sat(𝓛𝓛')`.

The codimension of a point `η` of `X` is its coheight `Order.coheight η` in the specialization
order (the codimension of its closure, equal to `dim 𝒪_{X,η}`), so the points of codimension
`≤ 1` are those with `Order.coheight η ≤ 1`.

## Main definitions

* `MMP.Flips.RationalFunctionsSubmodule`: an `𝒪_X`-submodule `𝓕 ⊆ K(X)`, a family of
  `Γ(X, U)`-submodules of `K(X)(U)` stable under restriction and satisfying the sheaf (locality)
  condition.
* `MMP.Flips.RationalFunctionsSubmodule.stalkSet`: the stalk `𝓕_x ⊆ K(X)_x`.
* `MMP.Flips.RationalFunctionsSubmodule.saturation`, `IsSaturated`: `sat(𝓕)` (FA 16.1.1).
* `MMP.Flips.RationalFunctionsSubmodule.toModules`: `𝓕` as an object of `X.Modules`.
* `MMP.Flips.WeilDivisorialSubsheaf`: a Weil divisorial subsheaf (FA 16.1.1).
* `MMP.Flips.WeilDivisorialSubsheaf.support`: `Supp(𝓛)` (FA 16.1.5).
* `MMP.Flips.RationalFunctionsSubmodule.inv`: `𝓛⁻¹` (FA 16.1.2).
* `MMP.Flips.RationalFunctionsSubmodule.mulImage`, `mul`: `𝓛𝓛'` and `𝓛 · 𝓛' = sat(𝓛𝓛')`
  (FA 16.1.2).

## References

* [J. Kollár et al., *Flips and abundance for algebraic threefolds*][KollarFlips], 16.1.1–16.1.5
-/

@[expose] public noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TopologicalSpace Opposite

namespace MMP.Flips

open MMP.Mori

variable {X : Scheme.{u}}

/-- Restriction in `K(X)` along a composite of inclusions is the composite of the restrictions. -/
theorem rationalFunctionsPresheaf_map_map {U V W : X.Opens} (i : V ⟶ U) (j : W ⟶ V)
    (k : W ⟶ U) (s : ToType ((rationalFunctionsPresheaf X).obj (op U))) :
    (rationalFunctionsPresheaf X).map j.op ((rationalFunctionsPresheaf X).map i.op s) =
      (rationalFunctionsPresheaf X).map k.op s := rfl

/-- Restriction in `K(X)` along the identity is the identity. -/
theorem rationalFunctionsPresheaf_map_id_apply {U : X.Opens} (i : U ⟶ U)
    (s : ToType ((rationalFunctionsPresheaf X).obj (op U))) :
    (rationalFunctionsPresheaf X).map i.op s = s := rfl

/-- Restriction in `K(X)` maps the image of a section of `𝒪_X` to the image of its
restriction. -/
theorem rationalFunctionsPresheaf_map_algebraMap {U V : X.Opens} (i : V ⟶ U) (r : Γ(X, U)) :
    (rationalFunctionsPresheaf X).map i.op
        (algebraMap Γ(X, U) ((rationalFunctionsPresheaf X).obj (op U)) r) =
      algebraMap Γ(X, V) ((rationalFunctionsPresheaf X).obj (op V)) (X.presheaf.map i.op r) := by
  rw [Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
    rationalFunctionsPresheaf_map_smul, map_one]

/-! ### `𝒪_X`-submodules of `K(X)` -/

variable (X) in
/-- An *`𝒪_X`-submodule* `𝓕 ⊆ K(X)` of the sheaf of rational functions: for every open `U` a
`Γ(X, U)`-submodule `𝓕(U)` of `K(X)(U)`, stable under restriction, and local (a section of
`K(X)` that lies in `𝓕` locally lies in `𝓕`), so that `𝓕` is a subsheaf of `K(X)`. -/
structure RationalFunctionsSubmodule where
  /-- The sections `𝓕(U) ⊆ K(X)(U)`. -/
  sections (U : X.Opens) : Submodule Γ(X, U) ((rationalFunctionsPresheaf X).obj (op U))
  /-- `𝓕` is stable under restriction. -/
  map_mem {U V : X.Opens} (i : V ⟶ U) {s : ToType ((rationalFunctionsPresheaf X).obj (op U))}
    (hs : s ∈ sections U) : (rationalFunctionsPresheaf X).map i.op s ∈ sections V
  /-- A section of `K(X)` lying in `𝓕` locally lies in `𝓕`. -/
  mem_of_locally {U : X.Opens} {s : ToType ((rationalFunctionsPresheaf X).obj (op U))}
    (hs : ∀ x ∈ U, ∃ (W : X.Opens) (i : W ⟶ U), x ∈ W ∧
      (rationalFunctionsPresheaf X).map i.op s ∈ sections W) : s ∈ sections U

namespace RationalFunctionsSubmodule

/-- Two `𝒪_X`-submodules of `K(X)` with the same sections over every open are equal. -/
@[ext]
theorem ext {F G : RationalFunctionsSubmodule X} (h : ∀ U, F.sections U = G.sections U) :
    F = G := by
  obtain ⟨F, _, _⟩ := F
  obtain ⟨G, _, _⟩ := G
  congr
  exact funext h

/-- The *local closure* of a restriction-stable family of submodules `P(U) ⊆ K(X)(U)`: the
sections of `K(X)` lying in `P` locally. This is the subsheaf of `K(X)` generated by the
subpresheaf `P` (its sheafification inside `K(X)`). -/
def localClosure (P : ∀ U : X.Opens, Submodule Γ(X, U) ((rationalFunctionsPresheaf X).obj (op U)))
    (hP : ∀ {U V : X.Opens} (i : V ⟶ U) {s : ToType ((rationalFunctionsPresheaf X).obj (op U))},
      s ∈ P U → (rationalFunctionsPresheaf X).map i.op s ∈ P V) :
    RationalFunctionsSubmodule X where
  sections U :=
    { carrier := {s | ∀ x ∈ U, ∃ (W : X.Opens) (i : W ⟶ U), x ∈ W ∧
        (rationalFunctionsPresheaf X).map i.op s ∈ P W}
      zero_mem' := fun x hx => ⟨U, 𝟙 U, hx, by simp⟩
      add_mem' := by
        intro s t hs ht x hx
        obtain ⟨W₁, i₁, hx₁, h₁⟩ := hs x hx
        obtain ⟨W₂, i₂, hx₂, h₂⟩ := ht x hx
        refine ⟨W₁ ⊓ W₂, homOfLE (inf_le_left.trans i₁.le), ⟨hx₁, hx₂⟩, ?_⟩
        rw [map_add, ← rationalFunctionsPresheaf_map_map i₁ (homOfLE inf_le_left),
          ← rationalFunctionsPresheaf_map_map i₂ (homOfLE inf_le_right)]
        exact add_mem (hP _ h₁) (hP _ h₂)
      smul_mem' := by
        intro r s hs x hx
        obtain ⟨W, i, hxW, h⟩ := hs x hx
        refine ⟨W, i, hxW, ?_⟩
        rw [rationalFunctionsPresheaf_map_smul]
        exact Submodule.smul_mem _ _ h }
  map_mem := by
    intro U V i s hs x hx
    obtain ⟨W, j, hxW, h⟩ := hs x (i.le hx)
    refine ⟨W ⊓ V, homOfLE inf_le_right, ⟨hxW, hx⟩, ?_⟩
    rw [rationalFunctionsPresheaf_map_map i (homOfLE inf_le_right)
      (homOfLE (inf_le_left.trans j.le)), ← rationalFunctionsPresheaf_map_map j
      (homOfLE inf_le_left)]
    exact hP _ h
  mem_of_locally := by
    intro U s hs x hx
    obtain ⟨W, i, hxW, h⟩ := hs x hx
    obtain ⟨W', j, hxW', h'⟩ := h x hxW
    exact ⟨W', j ≫ i, hxW', h'⟩

/-- A section of `K(X)` lies in the local closure of `P` if and only if it lies in `P` locally. -/
theorem mem_localClosure_iff
    {P : ∀ U : X.Opens, Submodule Γ(X, U) ((rationalFunctionsPresheaf X).obj (op U))} {hP}
    {U : X.Opens} {s : ToType ((rationalFunctionsPresheaf X).obj (op U))} :
    s ∈ (localClosure P hP).sections U ↔ ∀ x ∈ U, ∃ (W : X.Opens) (i : W ⟶ U), x ∈ W ∧
      (rationalFunctionsPresheaf X).map i.op s ∈ P W := Iff.rfl

/-! ### Stalks -/

/-- The stalk `𝓕_x ⊆ K(X)_x` of an `𝒪_X`-submodule `𝓕 ⊆ K(X)` at a point `x`: the germs at `x`
of the sections of `𝓕` over the open neighbourhoods of `x`. -/
@[mmp "def_fa16a_saturation"]
def stalkSet (F : RationalFunctionsSubmodule X) (x : X) :
    Set ((rationalFunctionsPresheaf X).stalk x) :=
  {g | ∃ (V : X.Opens) (hx : x ∈ V) (s : ToType ((rationalFunctionsPresheaf X).obj (op V))),
    s ∈ F.sections V ∧ (rationalFunctionsPresheaf X).germ V x hx s = g}

/-- The germ `s_x` of a section `s` of `K(X)` lies in `𝓕_x` exactly when some restriction of `s`
to a smaller neighbourhood of `x` is a section of `𝓕`. -/
theorem germ_mem_stalkSet_iff (F : RationalFunctionsSubmodule X) {V : X.Opens} {x : X}
    (hx : x ∈ V) (s : ToType ((rationalFunctionsPresheaf X).obj (op V))) :
    (rationalFunctionsPresheaf X).germ V x hx s ∈ F.stalkSet x ↔ ∃ (W : X.Opens) (i : W ⟶ V),
      x ∈ W ∧ (rationalFunctionsPresheaf X).map i.op s ∈ F.sections W := by
  constructor
  · rintro ⟨V', hx', t, ht, heq⟩
    obtain ⟨W, hxW, iV', iV, e⟩ := TopCat.Presheaf.germ_eq _ x hx' hx t s heq
    exact ⟨W, iV, hxW, e ▸ F.map_mem iV' ht⟩
  · rintro ⟨W, i, hxW, h⟩
    exact ⟨W, hxW, _, h, TopCat.Presheaf.germ_res_apply _ i x hxW s⟩

/-! ### Saturation -/

/-- The *saturation* `sat(𝓕) ⊆ K(X)` of an `𝒪_X`-submodule `𝓕 ⊆ K(X)` (FA 16.1.1): its sections
over an open `V` are the `s ∈ K(X)(V)` with `s_η ∈ 𝓕_η` for every point `η ∈ V` of codimension
`≤ 1` (that is, `Order.coheight η ≤ 1`). -/
@[mmp "def_fa16a_saturation"]
def saturation (F : RationalFunctionsSubmodule X) : RationalFunctionsSubmodule X where
  sections V :=
    { carrier := {s | ∀ (η : X) (hη : η ∈ V), Order.coheight η ≤ 1 →
        (rationalFunctionsPresheaf X).germ V η hη s ∈ F.stalkSet η}
      zero_mem' := fun η hη _ => ⟨V, hη, 0, zero_mem _, rfl⟩
      add_mem' := by
        intro s t hs ht η hη hc
        obtain ⟨W₁, i₁, hx₁, h₁⟩ := (F.germ_mem_stalkSet_iff hη s).mp (hs η hη hc)
        obtain ⟨W₂, i₂, hx₂, h₂⟩ := (F.germ_mem_stalkSet_iff hη t).mp (ht η hη hc)
        refine (F.germ_mem_stalkSet_iff hη _).mpr
          ⟨W₁ ⊓ W₂, homOfLE (inf_le_left.trans i₁.le), ⟨hx₁, hx₂⟩, ?_⟩
        rw [map_add, ← rationalFunctionsPresheaf_map_map i₁ (homOfLE inf_le_left),
          ← rationalFunctionsPresheaf_map_map i₂ (homOfLE inf_le_right)]
        exact add_mem (F.map_mem _ h₁) (F.map_mem _ h₂)
      smul_mem' := by
        intro r s hs η hη hc
        obtain ⟨W, i, hxW, h⟩ := (F.germ_mem_stalkSet_iff hη s).mp (hs η hη hc)
        refine (F.germ_mem_stalkSet_iff hη _).mpr ⟨W, i, hxW, ?_⟩
        rw [rationalFunctionsPresheaf_map_smul]
        exact Submodule.smul_mem _ _ h }
  map_mem := by
    intro U V i s hs η hη hc
    rw [TopCat.Presheaf.germ_res_apply]
    exact hs η (i.le hη) hc
  mem_of_locally := by
    intro U s hs η hη hc
    obtain ⟨W, i, hηW, h⟩ := hs η hη
    simpa only [TopCat.Presheaf.germ_res_apply] using h η hηW hc

/-- A section `s` of `K(X)` over `V` lies in `sat(𝓕)` if and only if `s_η ∈ 𝓕_η` for every point
`η ∈ V` with `Order.coheight η ≤ 1`. -/
theorem mem_saturation_iff {F : RationalFunctionsSubmodule X} {V : X.Opens}
    {s : ToType ((rationalFunctionsPresheaf X).obj (op V))} :
    s ∈ F.saturation.sections V ↔ ∀ (η : X) (hη : η ∈ V), Order.coheight η ≤ 1 →
      (rationalFunctionsPresheaf X).germ V η hη s ∈ F.stalkSet η := Iff.rfl

/-- An `𝒪_X`-submodule `𝓕 ⊆ K(X)` is *saturated* (FA 16.1.1) if `𝓕 = sat(𝓕)`. -/
@[mmp "def_fa16a_saturation"]
def IsSaturated (F : RationalFunctionsSubmodule X) : Prop :=
  F = F.saturation

/-! ### The structure sheaf -/

variable (X) in
/-- The structure sheaf `𝒪_X ⊆ K(X)`, as an `𝒪_X`-submodule of `K(X)`: the image of
`𝒪_X ⟶ K(X)`, that is, the local closure of the images `Γ(X, U) → K(X)(U)` (the submodules
`1 ⊆ K(X)(U)`). -/
def unit : RationalFunctionsSubmodule X :=
  localClosure (fun U => 1) fun i s hs => by
    obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hs
    exact Submodule.mem_one.mpr ⟨_, (rationalFunctionsPresheaf_map_algebraMap i r).symm⟩

/-! ### Inverse and product -/

/-- The *inverse* `𝓛⁻¹ ⊆ K(X)` of an `𝒪_X`-submodule `𝓛 ⊆ K(X)` (FA 16.1.2, stated there for a
Weil divisorial subsheaf `𝓛`): its sections over `V` are the `x ∈ K(X)(V)` with
`x · 𝓛|_V ⊆ sat(𝒪_X)|_V`, that is, `x|_W · l ∈ sat(𝒪_X)(W)` for every open `W ⊆ V` and every
`l ∈ 𝓛(W)`. -/
@[mmp "def_fa16a_inverse_subsheaf"]
def inv (L : RationalFunctionsSubmodule X) : RationalFunctionsSubmodule X where
  sections V :=
    { carrier := {x | ∀ (W : X.Opens) (i : W ⟶ V) (l : ToType ((rationalFunctionsPresheaf X).obj
          (op W))), l ∈ L.sections W →
        (rationalFunctionsPresheaf X).map i.op x * l ∈ (unit X).saturation.sections W}
      zero_mem' := fun W i l _ => by
        rw [map_zero, zero_mul]
        exact zero_mem _
      add_mem' := fun hx hy W i l hl => by
        rw [map_add, add_mul]
        exact add_mem (hx W i l hl) (hy W i l hl)
      smul_mem' := fun r x hx W i l hl => by
        rw [rationalFunctionsPresheaf_map_smul, smul_mul_assoc]
        exact Submodule.smul_mem _ _ (hx W i l hl) }
  map_mem := by
    intro U V i x hx W j l hl
    rw [rationalFunctionsPresheaf_map_map i j (j ≫ i)]
    exact hx W (j ≫ i) l hl
  mem_of_locally := by
    intro U x hx W i l hl
    refine (unit X).saturation.mem_of_locally fun w hw => ?_
    obtain ⟨W', j, hwW', h⟩ := hx w (i.le hw)
    refine ⟨W ⊓ W', homOfLE inf_le_left, ⟨hw, hwW'⟩, ?_⟩
    rw [map_mul, rationalFunctionsPresheaf_map_map i (homOfLE inf_le_left)
      (homOfLE (inf_le_right.trans j.le)), ← rationalFunctionsPresheaf_map_map j
      (homOfLE inf_le_right)]
    exact h _ _ _ (L.map_mem _ hl)

/-- A section `x` of `K(X)` over `V` lies in `𝓛⁻¹` if and only if `x|_W · l ∈ sat(𝒪_X)(W)` for
every open `W ⊆ V` and every `l ∈ 𝓛(W)`. -/
theorem mem_inv_iff {L : RationalFunctionsSubmodule X} {V : X.Opens}
    {x : ToType ((rationalFunctionsPresheaf X).obj (op V))} :
    x ∈ L.inv.sections V ↔ ∀ (W : X.Opens) (i : W ⟶ V)
      (l : ToType ((rationalFunctionsPresheaf X).obj (op W))), l ∈ L.sections W →
        (rationalFunctionsPresheaf X).map i.op x * l ∈ (unit X).saturation.sections W := Iff.rfl

/-- The image `𝓛𝓛' ⊆ K(X)` of `𝓛 ⊗ 𝓛' → K(X)`, `a ⊗ b ↦ ab`: the subsheaf of `K(X)` generated
by the submodules `𝓛(U) · 𝓛'(U) ⊆ K(X)(U)` spanned by the products `ab` with `a ∈ 𝓛(U)`,
`b ∈ 𝓛'(U)` (the images of the sections of the presheaf tensor product). -/
@[mmp "def_fa16a_product_weil_divisorial_subsheaves"]
def mulImage (L L' : RationalFunctionsSubmodule X) : RationalFunctionsSubmodule X :=
  localClosure (fun U => L.sections U * L'.sections U) fun i s hs => by
    refine Submodule.mul_induction_on hs (fun a ha b hb => ?_) (fun a b ha hb => ?_)
    · rw [map_mul]
      exact Submodule.mul_mem_mul (L.map_mem i ha) (L'.map_mem i hb)
    · rw [map_add]
      exact add_mem ha hb

/-- The *product* `𝓛 · 𝓛' = sat(𝓛𝓛') ⊆ K(X)` of two `𝒪_X`-submodules of `K(X)` (FA 16.1.2,
stated there for Weil divisorial subsheaves): the saturation of the image `𝓛𝓛'` of
`𝓛 ⊗ 𝓛' → K(X)`, `a ⊗ b ↦ ab`. -/
@[mmp "def_fa16a_product_weil_divisorial_subsheaves"]
def mul (L L' : RationalFunctionsSubmodule X) : RationalFunctionsSubmodule X :=
  (mulImage L L').saturation

/-! ### The underlying `𝒪_X`-module -/

/-- The restriction `𝓕(U) → 𝓕(V)` along `V ⊆ U`. -/
def restrictHom (F : RationalFunctionsSubmodule X) {U V : X.Opens} (i : V ⟶ U) :
    F.sections U →+ F.sections V where
  toFun s := ⟨(rationalFunctionsPresheaf X).map i.op s.1, F.map_mem i s.2⟩
  map_zero' := Subtype.ext (map_zero ((rationalFunctionsPresheaf X).map i.op).hom)
  map_add' s t := Subtype.ext (map_add ((rationalFunctionsPresheaf X).map i.op).hom s.1 t.1)

/-- `𝓕` as a presheaf of abelian groups. -/
def presheafAb (F : RationalFunctionsSubmodule X) : TopCat.Presheaf AddCommGrpCat.{u} X where
  obj U := AddCommGrpCat.of (F.sections U.unop)
  map i := AddCommGrpCat.ofHom (F.restrictHom i.unop)
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The sections `𝓕(U)` form a module over `𝒪_X(U)`. -/
instance (F : RationalFunctionsSubmodule X) (U : X.Opensᵒᵖ) :
    Module (X.ringCatSheaf.obj.obj U) (F.presheafAb.obj U) :=
  inferInstanceAs (Module Γ(X, U.unop) (F.sections U.unop))

/-- `𝓕` as a presheaf of `𝒪_X`-modules. -/
def presheafOfModules (F : RationalFunctionsSubmodule X) : X.PresheafOfModules :=
  PresheafOfModules.ofPresheaf F.presheafAb fun _ _ i r φ =>
    Subtype.ext (rationalFunctionsPresheaf_map_smul i.unop r φ.1)

/-- An `𝒪_X`-submodule `𝓕 ⊆ K(X)` is a sheaf of abelian groups. -/
theorem isSheaf_presheafAb (F : RationalFunctionsSubmodule X) : F.presheafAb.IsSheaf := by
  rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
  intro ι U sf hsf
  have hmem : ∀ Z : irreducibleComponents X, componentGenericPoint X Z ∈ iSup U →
      ∃ i, componentGenericPoint X Z ∈ U i := fun _ => Opens.mem_iSup.mp
  have hagree : ∀ (i j : ι) (Z : irreducibleComponents X) (hi : componentGenericPoint X Z ∈ U i)
      (hj : componentGenericPoint X Z ∈ U j), (sf i).1 ⟨Z, hi⟩ = (sf j).1 ⟨Z, hj⟩ :=
    fun i j Z hi hj => congrFun (congrArg Subtype.val (hsf i j)) ⟨Z, ⟨hi, hj⟩⟩
  let s : ToType ((rationalFunctionsPresheaf X).obj (op (iSup U))) :=
    fun Z => (sf (hmem Z.1 Z.2).choose).1 ⟨Z.1, (hmem Z.1 Z.2).choose_spec⟩
  have hres : ∀ j, (rationalFunctionsPresheaf X).map (Opens.leSupr U j).op s = (sf j).1 :=
    fun j => funext fun Z => hagree _ _ _ _ _
  have hs : s ∈ F.sections (iSup U) := by
    refine F.mem_of_locally fun x hx => ?_
    obtain ⟨j, hj⟩ := Opens.mem_iSup.mp hx
    exact ⟨U j, Opens.leSupr U j, hj, (hres j).symm ▸ (sf j).2⟩
  refine ⟨⟨s, hs⟩, fun i => Subtype.ext (hres i), fun t ht => Subtype.ext (funext fun Z => ?_)⟩
  exact (congrFun (congrArg Subtype.val (ht (hmem Z.1 Z.2).choose))
    ⟨Z.1, (hmem Z.1 Z.2).choose_spec⟩).symm ▸ rfl

/-- An `𝒪_X`-submodule `𝓕 ⊆ K(X)` as an object of `X.Modules`. -/
def toModules (F : RationalFunctionsSubmodule X) : X.Modules where
  val := F.presheafOfModules
  isSheaf := F.isSheaf_presheafAb

/-- The sections of `F.toModules` over `U` are the elements of `F.sections U`. -/
theorem toModules_sections (F : RationalFunctionsSubmodule X) (U : X.Opens) :
    (Γ(F.toModules, U) : Type u) = F.sections U := rfl

end RationalFunctionsSubmodule

/-! ### Weil divisorial subsheaves -/

variable (X) in
/-- The stalk map `𝒪_{X,x} → K(X)_x` of the inclusion `𝒪_X ⟶ K(X)`, through which `𝒪_{X,x}`
acts on `K(X)_x`. -/
def structureStalkToRationalFunctionsStalk (x : X) :
    X.presheaf.stalk x ⟶ (rationalFunctionsPresheaf X).stalk x :=
  (TopCat.Presheaf.stalkFunctor CommRingCat x).map (toRationalFunctionsPresheaf X)

variable (X) in
/-- A *Weil divisorial subsheaf* of `X` (FA 16.1.1): a coherent `𝒪_X`-submodule `𝓛 ⊆ K(X)` (the
embedding into `K(X)` is part of the datum) such that
(i) `𝓛` is principal in codimension one: for every point `η` of codimension `≤ 1` there is a unit
`f` of `K(X)_η` with `𝓛_η = f · 𝒪_{X,η}`, where `𝒪_{X,η}` acts on `K(X)_η` through the stalk map
of `𝒪_X ⟶ K(X)`; and
(ii) `𝓛` is saturated. -/
@[mmp "def_fa16a_weil_divisorial_subsheaf"]
structure WeilDivisorialSubsheaf extends RationalFunctionsSubmodule X where
  /-- `𝓛` is a coherent `𝒪_X`-module. -/
  isCoherent : SheafOfModules.IsCoherent toRationalFunctionsSubmodule.toModules
  /-- (i) `𝓛` is principal in codimension one: `𝓛_η = f · 𝒪_{X,η}` for a unit `f` of `K(X)_η`. -/
  principal_codim_one : ∀ η : X, Order.coheight η ≤ 1 →
    ∃ f : ((rationalFunctionsPresheaf X).stalk η)ˣ,
      toRationalFunctionsSubmodule.stalkSet η = Set.range fun a : X.presheaf.stalk η =>
        (f : (rationalFunctionsPresheaf X).stalk η) *
          (structureStalkToRationalFunctionsStalk X η).hom a
  /-- (ii) `𝓛` is saturated. -/
  isSaturated : toRationalFunctionsSubmodule.IsSaturated

namespace WeilDivisorialSubsheaf

/-- The *support* of a Weil divisorial subsheaf (FA 16.1.5, corrected):
`Supp(𝓛) = {x ∈ X | 𝓛_x ≠ sat(𝒪_X)_x in K(X)_x}`. -/
@[mmp "def_fa16a_support_subsheaf"]
def support (L : WeilDivisorialSubsheaf X) : Set X :=
  {x | L.stalkSet x ≠ (RationalFunctionsSubmodule.unit X).saturation.stalkSet x}

/-- The inverse `𝓛⁻¹ ⊆ K(X)` of a Weil divisorial subsheaf (FA 16.1.2):
`RationalFunctionsSubmodule.inv` of its underlying `𝒪_X`-submodule. -/
@[mmp "def_fa16a_inverse_subsheaf"]
abbrev inv (L : WeilDivisorialSubsheaf X) : RationalFunctionsSubmodule X :=
  L.toRationalFunctionsSubmodule.inv

/-- The product `𝓛 · 𝓛' = sat(𝓛𝓛') ⊆ K(X)` of two Weil divisorial subsheaves (FA 16.1.2). -/
@[mmp "def_fa16a_product_weil_divisorial_subsheaves"]
abbrev mul (L L' : WeilDivisorialSubsheaf X) : RationalFunctionsSubmodule X :=
  L.toRationalFunctionsSubmodule.mul L'.toRationalFunctionsSubmodule

end WeilDivisorialSubsheaf

end MMP.Flips
