module
public import MMP.AlgebraicGeometry.Positivity.VeryAmpleMultiple
public import StacksFrontier.AlgebraicGeometry.FiberRank.FreeLocusBaseChange
public import StacksFrontier.AlgebraicGeometry.Flatness.Flattening.GenericFibreRankLocallyConstant
public import StacksFrontier.AlgebraicGeometry.InvertibleOnClosedCover.Basic
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.ClosedImmersionCoherence
public import StacksFrontier.AlgebraicGeometry.Morphisms.Proper.LocallyProjective
public import StacksFrontier.AlgebraicGeometry.Quot.ProjectiveQuot.SchemeRepresentation

/-!
# Countably many algebraic families contain every line bundle

Let `k` be an algebraically closed field and `X` a projective `k`-scheme with a very ample
invertible sheaf `H`. There are countably many finite-type `k`-schemes `Tᵢ`, each carrying an
invertible sheaf `𝓛ᵢ` on `X ×_k Tᵢ`, such that every invertible sheaf `L` on `X` is isomorphic to
the restriction of some `𝓛ᵢ` to the fibre `X ≅ X ×_k Spec k ⟶ X ×_k Tᵢ` over a `k`-point of
`Tᵢ`. The relative form: for `f : 𝒳 ⟶ S` flat and projective, `S` of finite type over `ℂ`, and
`H` an `f`-ample invertible sheaf, countably many finite-type `S`-schemes `Mᵢ` carry invertible
sheaves `Uᵢ` on `𝒳 ×_S Mᵢ` such that every invertible sheaf on every closed fibre `𝒳_s` is the
fibre of some `Uᵢ` at a `κ(s)`-point of `Mᵢ` over `s`.

The families are indexed by pairs `(m, r)` and, for each pair, by the countably many Hilbert
polynomials `P`: the families of `(m, r)` carry every line bundle `L` with `L ⊗ H^{⊗ m}`
generated by `r` global sections. Embedding `X` by `H` into `ℙᴺ`, such an `L ⊗ H^{⊗ m}` is a
quotient of `𝒪^{⊕ r}`, a point of the scheme `Quot^P_{𝒪^{⊕ r}/ℙᴺ/ℤ}` (Stacks, Tag 0DPA). The
universal quotient, restricted to `X` and flattened (Stacks, Tag 05UH), is invertible over an
open locus of the base containing the point (Stacks, Tag 0CZR), and its twist by `H^{⊗ -m}` is
the family (Stacks, Tag 01CD). Every line bundle has such a pair since `H` is ample (Stacks,
Tag 01Q3). In the relative case `S` is covered by finitely many affine opens `V` over which a
power of `H` embeds `f⁻¹(V)` in `ℙᴺ_V` (Stacks, Tag 01VS), and the families are also indexed by
the piece of the cover.

## Main results

* `MMP.exists_countable_isLineBundle_families`: the countable families of line bundles on a
  projective scheme over an algebraically closed field.
* `MMP.exists_countable_families_isInvertibleModule_fiber_iso`: the countable families of line
  bundles on the closed fibres of a flat projective morphism over a finite-type `ℂ`-scheme.

## Implementation notes

The absolute statement is made over an arbitrary algebraically closed field `k` and its
`k`-points rather than over `ℂ`. A finite-type `k`-scheme is a scheme `T` with a morphism
`p : T ⟶ Spec k` that is quasi-compact and locally of finite type; `X ×_k T` is
`pullback (X ↘ Spec k) p`, and the restriction of `𝓛` to the fibre over a section `t` of `p` is
the pullback along `pullback.lift (𝟙 X) (X ↘ Spec k ≫ t)`. Invertible sheaves are
`MMP.Intersection.Scheme.Modules.IsLineBundle` (locally free of rank one) in the absolute
statement and `Stacks.Ample.IsInvertibleModule` in the relative one; very ampleness is
`MMP.Intersection.IsVeryAmple` and projectivity is `AlgebraicGeometry.IsProjective` (Stacks,
Tag 01W8).

In the relative statement a complex point of `Mᵢ` over a closed point `s` is a morphism
`μ : Spec κ(s) ⟶ Mᵢ` lifting `Spec κ(s) ⟶ S`; since `s` is closed and `S` is of finite type over
`ℂ`, `κ(s) = ℂ`. The fibre of `Uᵢ` at `μ` is the pull-back along the induced morphism
`𝒳_s = 𝒳 ×_S Spec κ(s) ⟶ 𝒳 ×_S Mᵢ`.

## References

* [A. Grothendieck, *Techniques de construction et théorèmes d'existence en géométrie
  algébrique IV: les schémas de Hilbert*]
* [Stacks Project, Tag 0DPA], [Stacks Project, Tag 05UH], [Stacks Project, Tag 0CZR],
  [Stacks Project, Tag 01CD], [Stacks Project, Tag 01Q3], [Stacks Project, Tag 01VS],
  [Stacks Project, Tag 01W8], [Stacks Project, Tag 0DPC]
-/

@[expose] public section

open CategoryTheory Limits AlgebraicGeometry RingedSpaceModuleAdjunction MonoidalCategory
open ProjectiveQuot

namespace MMP

universe u

open MMP.Intersection.Scheme.Modules (IsLineBundle)
open Stacks.Ample (IsInvertibleModule tensorPowModule IsAmple)

/-! ### Line bundles and invertible modules -/

/-- A line bundle (locally free of rank one) is an invertible `𝒪_X`-module. -/
private theorem isInvertibleModule_of_isLineBundle {X : Scheme.{u}} (L : X.Modules)
    (hL : IsLineBundle L) : IsInvertibleModule X L := by
  refine (AlgebraicGeometry.isInvertible_iff_exists_restrict_iso_unit X L).2 fun x => ?_
  obtain ⟨U, hxU, ⟨e⟩⟩ := hL x
  exact ⟨U, hxU, ⟨e ≪≫ Limits.coproductUniqueIso _⟩⟩

/-- The twist `L ⊗ H^{⊗ m}`, for the tensor product of `X.Modules` that Stacks' global
generation statements use. -/
private noncomputable abbrev twist {X : Scheme.{u}} (H : X.Modules) [IsInvertibleModule X H]
    (m : ℤ) (L : X.Modules) : X.Modules :=
  @MonoidalCategoryStruct.tensorObj _ _
    (Stacks.SheafInternalHom.schemeMonoidalCategory X).toMonoidalCategoryStruct L
    (tensorPowModule X H m)

/-- The twist of an invertible module by a power of an invertible module is invertible. -/
private theorem isInvertibleModule_twist {X : Scheme.{u}} (H : X.Modules) [IsInvertibleModule X H]
    (m : ℤ) (L : X.Modules) [IsInvertibleModule X L] : IsInvertibleModule X (twist H m L) := by
  have := AlgebraicGeometry.SheafOfModules.isInvertible_tensor X.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) L (tensorPowModule X H m)
  exact Stacks.SheafOfModules.Invertible.isInvertible_of_iso _ _ (Iso.refl _)

/-- An invertible `𝒪_X`-module is a line bundle (locally free of rank one). -/
private theorem isLineBundle_of_isInvertibleModule {X : Scheme.{u}} (L : X.Modules)
    [IsInvertibleModule X L] : IsLineBundle L := by
  intro x
  obtain ⟨U, hxU, ⟨e⟩⟩ :=
    (AlgebraicGeometry.isInvertible_iff_exists_restrict_iso_unit X L).1 ‹_› x
  exact ⟨U, hxU, ⟨e ≪≫ (Limits.coproductUniqueIso (fun _ : ULift.{u} (Fin 1) =>
    SheafOfModules.unit (U : Scheme.{u}).ringCatSheaf)).symm⟩⟩

/-- Being a line bundle is invariant under isomorphism. -/
private theorem isLineBundle_of_iso {X : Scheme.{u}} {A B : X.Modules} (e : A ≅ B)
    (hA : IsLineBundle A) : IsLineBundle B := by
  intro x
  obtain ⟨U, hx, ⟨f⟩⟩ := hA x
  exact ⟨U, hx, ⟨(Scheme.Modules.restrictFunctor U.ι).mapIso e.symm ≪≫ f⟩⟩

/-- `L ⊗ H^{⊗ m}` is generated by `r` global sections. -/
private def IsGeneratedTwist {X : Scheme.{u}} (H : X.Modules) [IsInvertibleModule X H] (m : ℤ)
    (r : ℕ) (L : X.Modules) : Prop :=
  ∃ σ : (twist H m L).GeneratingSections, Finite σ.I ∧ Nat.card σ.I = r

/-- **Every line bundle has a generated twist** by an ample invertible module: `L ⊗ H^{⊗ m}` is
generated by finitely many global sections for `m ≫ 0` (Stacks 01Q3, clause (7)). -/
private theorem exists_isGeneratedTwist {X : Scheme.{u}} (H : X.Modules) [IsInvertibleModule X H]
    (hH : IsAmple X H) (L : X.Modules) [IsInvertibleModule X L] :
    ∃ (m : ℤ) (r : ℕ), IsGeneratedTwist H m r L := by
  obtain ⟨n₀, hn₀⟩ := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple H hH L
    (Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule L)
    (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule L)
  obtain ⟨σ, hσ⟩ := hn₀ n₀ le_rfl
  exact ⟨n₀, Nat.card σ.I, σ, hσ, rfl⟩

/-! ### Free modules on opens -/

/-- The free module over an open `V`, read on the open subscheme `V`. -/
private noncomputable def overEquivFreeIso {Y : Scheme.{u}} (V : Y.Opens) (I : Type u) :
    (Scheme.Modules.overEquiv V).functor.obj (SheafOfModules.free I) ≅
      SheafOfModules.free (R := (V : Scheme.{u}).ringCatSheaf) I :=
  PreservesCoproduct.iso (Scheme.Modules.overEquiv V).functor _ ≪≫
    Sigma.mapIso fun _ => TopologicalSpace.Opens.sheafOfModulesEquivOverUnit V Y.ringCatSheaf

/-- A trivialization of `F` over `V` is a trivialization of the restriction of `F` to the open
subscheme `V`. -/
private noncomputable def restrictIsoFreeOfOverIso {Y : Scheme.{u}} {F : Y.Modules}
    {V : Y.Opens} {I : Type u} (e : F.over V ≅ SheafOfModules.free I) :
    F.restrict V.ι ≅ SheafOfModules.free I :=
  ((Scheme.Modules.overFunctorEquiv V).app F).symm ≪≫
    (Scheme.Modules.overEquiv V).functor.mapIso e ≪≫ overEquivFreeIso V I

/-- A trivialization of the restriction of `F` to the open subscheme `V` is a trivialization
of `F` over `V`. -/
private noncomputable def overIsoFreeOfRestrictIso {Y : Scheme.{u}} {F : Y.Modules}
    {V : Y.Opens} {I : Type u} (e : F.restrict V.ι ≅ SheafOfModules.free I) :
    F.over V ≅ SheafOfModules.free I :=
  (Scheme.Modules.overEquiv V).functor.preimageIso
    ((Scheme.Modules.overFunctorEquiv V).app F ≪≫ e ≪≫ (overEquivFreeIso V I).symm)

/-- A trivialization of `F` on the open subscheme `V` pulls back to a trivialization of `g^* F`
on `g⁻¹ V`. -/
private noncomputable def restrictPullbackIsoFree {Z Y : Scheme.{u}} (g : Z ⟶ Y) {F : Y.Modules}
    {V : Y.Opens} {I : Type u} (e : F.restrict V.ι ≅ SheafOfModules.free I) :
    ((Scheme.Modules.pullback g).obj F).restrict (g ⁻¹ᵁ V).ι ≅ SheafOfModules.free I :=
  (Scheme.Modules.restrictFunctorIsoPullback (g ⁻¹ᵁ V).ι).app _ ≪≫
    (Scheme.Modules.pullbackComp (g ⁻¹ᵁ V).ι g).app F ≪≫
    (Scheme.Modules.pullbackCongr (morphismRestrict_ι g V).symm).app F ≪≫
    ((Scheme.Modules.pullbackComp (g ∣_ V) V.ι).app F).symm ≪≫
    (Scheme.Modules.pullback (g ∣_ V)).mapIso
      (((Scheme.Modules.restrictFunctorIsoPullback V.ι).app F).symm ≪≫ e) ≪≫
    SheafOfModules.pullbackObjFreeIso _ I

/-- The inverse image of a line bundle is a line bundle. -/
private theorem isLineBundle_pullback {Z Y : Scheme.{u}} (g : Z ⟶ Y) {F : Y.Modules}
    (hF : IsLineBundle F) : IsLineBundle ((Scheme.Modules.pullback g).obj F) := by
  intro z
  obtain ⟨V, hV, ⟨e⟩⟩ := hF (g z)
  exact ⟨g ⁻¹ᵁ V, hV, ⟨restrictPullbackIsoFree g e⟩⟩

/-- The points near which `F` is free of rank one. -/
private def lineLocus {Y : Scheme.{u}} (F : Y.Modules) : Set Y :=
  {y | ∃ V : Y.Opens, y ∈ V ∧ Nonempty (F.over V ≅ SheafOfModules.free (ULift.{u} (Fin 1)))}

/-- The locus where a module is free of rank one is open. -/
private theorem isOpen_lineLocus {Y : Scheme.{u}} (F : Y.Modules) : IsOpen (lineLocus F) :=
  isOpen_iff_forall_mem_open.mpr fun _ hx => by
    obtain ⟨U, hxU, e⟩ := hx
    exact ⟨U, fun y hy => ⟨U, hy, e⟩, U.2, hxU⟩

/-- **Freeness of rank one spreads from a fibre.** Let `F` be of finite presentation on `X`,
flat over `S`, and let `g : S' ⟶ S`. If the base change of `F` to `X ×_S S'` is a line bundle,
then `F` is free of rank one near every point of `X` over the image of `g`: the free locus of a
finitely presented flat module commutes with base change (Stacks 0CZR), and fibre ranks compare
the two trivializations. -/
private theorem mem_lineLocus_of_isLineBundle_pullback {X S S' : Scheme.{u}} (f : X ⟶ S)
    (F : X.Modules) [SheafOfModules.IsFinitePresentation F] [LocallyOfFinitePresentation f]
    (hF : IsFlatOver f.toLRSHom.toShHom F) (g : S' ⟶ S)
    (hg : IsLineBundle ((Scheme.Modules.pullback (pullback.fst f g)).obj F)) {x : X}
    (hx : f x ∈ Set.range g) : x ∈ lineLocus F := by
  obtain ⟨z, rfl⟩ : x ∈ Set.range (pullback.fst f g) := by
    rwa [Scheme.Pullback.range_fst]
  have hz : z ∈ ((Scheme.Modules.pullback (pullback.fst f g)).obj F).freeLocus := by
    obtain ⟨V, hV, ⟨e⟩⟩ := hg z
    exact ⟨V, hV, 1, ⟨overIsoFreeOfRestrictIso e⟩⟩
  rw [Scheme.Modules.freeLocus_pullback f F hF g] at hz
  obtain ⟨V, hV, n, ⟨e⟩⟩ := hz
  obtain ⟨V', hV', ⟨e'⟩⟩ := hg z
  have hn : n = 1 :=
    (Scheme.Modules.fiberRank_eq_of_iso_free_over _ _ n (overIsoFreeOfRestrictIso
      (restrictPullbackIsoFree (pullback.fst f g) (restrictIsoFreeOfOverIso e))) hV).symm.trans
      (Scheme.Modules.fiberRank_eq_of_iso_free_over _ _ 1 (overIsoFreeOfRestrictIso e') hV')
  subst hn
  exact ⟨V, hV, ⟨e⟩⟩

/-! ### Modules over a field -/

/-- The local ring of `Spec k` at its point is a field. -/
private theorem isField_stalk_spec (k : Type u) [Field k] (x : Spec (.of k)) :
    IsField ((Spec (.of k)).presheaf.stalk x) := by
  refine isField_stalk_of_closure_mem_irreducibleComponents _ _ ?_
  have : closure ({x} : Set (Spec (.of k))) = Set.univ := by
    have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
    refine Set.eq_univ_of_forall fun y => ?_
    rw [Subsingleton.elim y x]
    exact subset_closure rfl
  rw [this, irreducibleComponents_eq_singleton]
  rfl

/-- Every module over a field is flat, for any module structure. -/
private theorem flat_of_isField {R M : Type u} [CommRing R] [AddCommGroup M] (_ : Module R M)
    (h : IsField R) : Module.Flat R M := by
  letI := h.toField
  exact Module.Flat.of_free

/-- Every module on a scheme over `Spec k` is flat over `Spec k`. -/
private theorem isFlatOver_spec_field (k : Type u) [Field k] {Y : Scheme.{u}}
    (g : Y ⟶ Spec (.of k)) (F : SheafOfModules.{u} (structureSheafRing Y.toRingedSpace)) :
    IsFlatOver g.toLRSHom.toShHom F := fun _ =>
  flat_of_isField _ (isField_stalk_spec k _)

/-! ### Quotients of free modules on projective space over a field -/

/-- The free module `𝒪^{⊕ r}` on `ℙᴺ_S` is the free module on any index type in bijection with
`Fin r`. -/
private noncomputable def freeModuleIsoFree (N r : ℕ) (S : Scheme.{u}) {I : Type u}
    (e : Fin r ≃ I) :
    freeModule N r S ≅ SheafOfModules.free (R := (projectiveSpaceOver N S).ringCatSheaf) I :=
  Sigma.whiskerEquiv (f := fun _ : Fin r => Scheme.unitModule (projectiveSpaceOver N S))
    (g := fun _ : I => SheafOfModules.unit (projectiveSpaceOver N S).ringCatSheaf) e
    fun _ => Iso.refl _

/-- **A point of `Quot` from generating sections.** If a coherent module `F` on `X` is generated
by `r` global sections and `ι : X ⟶ ℙᴺ_k` is a closed immersion, then `ι_* F` is a quotient of
`𝒪^{⊕ r}` on `ℙᴺ_k` of finite presentation. -/
private theorem exists_subobject_quotient_iso (k : Type u) [Field k] {X : Scheme.{u}} {N r : ℕ}
    (ι : X ⟶ projectiveSpaceOver N (Spec (.of k))) [IsClosedImmersion ι]
    (F : X.Modules) [F.IsCoherent] (σ : F.GeneratingSections) [Finite σ.I]
    (hr : Nat.card σ.I = r) :
    ∃ (K : Subobject (freeModule N r (Spec (.of k)))) (_ : (quotient K).IsFinitePresentation),
      Nonempty (quotient K ≅ (Scheme.Modules.pushforward ι).obj F) := by
  haveI : σ.IsFiniteType := ⟨inferInstance⟩
  let e : Fin r ≃ σ.I := (finCongr hr.symm).trans (Finite.equivFin σ.I).symm
  let q := (freeModuleIsoFree N r _ e).hom ≫ Stacks.ClosedImmersion.pushforwardGeneratorsHom ι F σ
  haveI : Epi q := @epi_comp _ _ _ _ _ _ (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)) _
    (Stacks.ClosedImmersion.epi_pushforwardGeneratorsHom ι F σ)
  let c : IsColimit (CokernelCofork.ofπ q (kernelSubobject_arrow_comp q)) :=
    Abelian.epiIsCokernelOfKernel _
      (IsLimit.ofIsoLimit (kernelIsKernel q)
        (Fork.ext (t := KernelFork.ofι _ (kernelSubobject_arrow_comp q))
          (kernelSubobjectIso _).symm (kernelSubobject_arrow' _)))
  let eQ : quotient (kernelSubobject q) ≅ (Scheme.Modules.pushforward ι).obj F :=
    (colimit.isColimit _).coconePointUniqueUpToIso c
  haveI : IsLocallyNoetherian (projectiveSpaceOver N (Spec (.of k))) :=
    projectiveSpaceOver_isLocallyNoetherian N _
  haveI := Stacks.ClosedImmersion.isCoherent_pushforward ι F ‹_›
  exact ⟨kernelSubobject q, Stacks.SheafOfModules.Intrinsic.isFinitePresentation_of_iso eQ.symm
    (isFinitePresentation_of_isCoherent _), ⟨eQ⟩⟩

/-- Over a field, a module on `ℙᴺ_k` of finite presentation has some fibre Hilbert polynomial,
so its kernel lies in some `Quot^P(Spec k)`. -/
private theorem exists_mem_hilbertFamilies (k : Type u) [Field k] {N r : ℕ}
    (K : Subobject (freeModule N r (Spec (.of k)))) [(quotient K).IsFinitePresentation] :
    ∃ P : Polynomial ℚ, K ∈ hilbertFamilies N r P (Spec (.of k)) := by
  obtain ⟨t₀⟩ : Nonempty (Spec (.of k)) := inferInstance
  haveI := isCoherent_fibre t₀ (quotient K)
  obtain ⟨P, hP⟩ := exists_polynomial_eval_eq_hilbertPolynomial _ N (fibre t₀ (quotient K))
  refine ⟨P, ⟨‹_›, isFlatOver_spec_field k _ _⟩, fun t => ?_⟩
  have : Subsingleton (Spec (.of k)) := inferInstanceAs (Subsingleton (PrimeSpectrum k))
  obtain rfl := Subsingleton.elim t t₀
  exact ⟨_, hP⟩

/-! ### Families over an algebraically closed field -/

namespace OverField

variable {X : Scheme.{u}}

/-- On a scheme proper over `k`, a very ample invertible module is ample in the sense of
`Stacks.Ample.IsAmple`. -/
private theorem isAmple_of_isVeryAmple (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))] (H : X.Modules)
    [IsInvertibleModule X H] (hH : MMP.Intersection.IsVeryAmple k H) :
    Stacks.Ample.IsAmple X H :=
  ((Stacks.AmpleRelativeFiniteType.tfae_six (X ↘ Spec (.of k)) H).out 5 1).1
    (⟨1, le_rfl, MMP.Resolution.Bridges.hasImmersionTwistOver_of_isVeryAmple k _ _ hH
      (Stacks.Ample.tensorPowModuleOneIso X H)⟩ : ∃ d : ℕ, 1 ≤ d ∧
        Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver (X ↘ Spec (.of k))
          (tensorPowModule X H (d : ℤ)))

/-- The section `X ≅ X ×_k Spec k ⟶ X ×_k T` of the projection `X ×_k T ⟶ X` over a `k`-point
`t` of `T`: restricting a module on `X ×_k T` along it is taking its fibre over `t`. -/
private noncomputable abbrev fibreSection (k : Type u) [Field k] [X.Over (Spec (.of k))]
    {T : Scheme.{u}} (p : T ⟶ Spec (.of k)) (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) :
    X ⟶ pullback (X ↘ Spec (.of k)) p :=
  pullback.lift (𝟙 X) (X ↘ Spec (.of k) ≫ t)
    (by rw [Category.assoc, ht, Category.comp_id, Category.id_comp])

/-- The projection of the fibre section to `X` is the identity. -/
private theorem fibreSection_fst (k : Type u) [Field k] [X.Over (Spec (.of k))] {T : Scheme.{u}}
    (p : T ⟶ Spec (.of k)) (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) :
    fibreSection k p t ht ≫ pullback.fst _ _ = 𝟙 X :=
  pullback.lift_fst _ _ _

/-- The projection of the fibre section to `T` is the constant map at `t`. -/
private theorem fibreSection_snd (k : Type u) [Field k] [X.Over (Spec (.of k))] {T : Scheme.{u}}
    (p : T ⟶ Spec (.of k)) (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) :
    fibreSection k p t ht ≫ pullback.snd _ _ = X ↘ Spec (.of k) ≫ t :=
  pullback.lift_snd _ _ _

/-- The fibre section over `t` is the base change of `t` along `X ×_k T ⟶ T`. -/
private theorem isPullback_fibreSection (k : Type u) [Field k] [X.Over (Spec (.of k))]
    {T : Scheme.{u}} (p : T ⟶ Spec (.of k)) (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) :
    IsPullback (fibreSection k p t ht) (X ↘ Spec (.of k)) (pullback.snd (X ↘ Spec (.of k)) p)
      t := by
  refine IsPullback.of_right ?_ (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
  rw [pullback.lift_fst, ht]
  exact IsPullback.of_horiz_isIso ⟨by simp⟩

/-- **Flattening a family** (Stacks 05UH). A family `𝒢₀` of finite presentation on `X ×_k T₀`
has a base change `𝒢` to some `T ⟶ T₀` of finite type that is flat over `T`, and every
`k`-point of `T₀` lifts to `T` with the same fibre. -/
private theorem exists_flattening (k : Type u) [Field k] [X.Over (Spec (.of k))]
    [IsProper (X ↘ Spec (.of k))]
    {T₀ : Scheme.{u}} (p₀ : T₀ ⟶ Spec (.of k)) [QuasiCompact p₀] [LocallyOfFiniteType p₀]
    (𝒢₀ : (pullback (X ↘ Spec (.of k)) p₀).Modules) [SheafOfModules.IsFinitePresentation 𝒢₀] :
    ∃ (T : Scheme.{u}) (q : T ⟶ T₀) (_ : QuasiCompact (q ≫ p₀))
      (_ : LocallyOfFiniteType (q ≫ p₀))
      (𝒢 : (pullback (X ↘ Spec (.of k)) (q ≫ p₀)).Modules)
      (_ : SheafOfModules.IsFinitePresentation 𝒢)
      (_ : IsFlatOver (pullback.snd (X ↘ Spec (.of k)) (q ≫ p₀)).toLRSHom.toShHom 𝒢),
      ∀ (t : Spec (.of k) ⟶ T₀) (ht : t ≫ p₀ = 𝟙 _),
        ∃ (t' : Spec (.of k) ⟶ T) (ht' : t' ≫ q ≫ p₀ = 𝟙 _),
          Nonempty ((Scheme.Modules.pullback (fibreSection k (q ≫ p₀) t' ht')).obj 𝒢 ≅
            (Scheme.Modules.pullback (fibreSection k p₀ t ht)).obj 𝒢₀) := by
  let f := pullback.snd (X ↘ Spec (.of k)) p₀
  haveI : IsLocallyNoetherian T₀ := LocallyOfFiniteType.isLocallyNoetherian p₀
  haveI : LocallyOfFinitePresentation f :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  haveI := isQuasicoherent_of_isFinitePresentation 𝒢₀
  obtain ⟨Z, _, hfp, ⟨R⟩⟩ := exists_mono_finitePresentation_representableBy_of_isProper f 𝒢₀
  have hZ : IsFlatOver (pullback.snd f Z.hom).toLRSHom.toShHom
      ((Scheme.Modules.pullback (pullback.fst f Z.hom)).obj 𝒢₀) := (R.homEquiv (𝟙 Z)).down
  let M := (Scheme.Modules.pullback (pullback.fst f Z.hom)).obj 𝒢₀
  haveI : SheafOfModules.IsFinitePresentation
      (R := structureSheafRing (pullback (X ↘ Spec (.of k)) p₀).toRingedSpace) 𝒢₀ := ‹_›
  haveI : SheafOfModules.IsFinitePresentation M :=
    Stacks.SheafOfModules.modulePullback_isFinitePresentation
      (pullback.fst f Z.hom).toLRSHom.toShHom 𝒢₀
  haveI hMfp : SheafOfModules.IsFinitePresentation
      (R := structureSheafRing (pullback f Z.hom).toRingedSpace) M := ‹_›
  haveI : SheafOfModules.IsQuasicoherent
      (R := structureSheafRing (pullback f Z.hom).toRingedSpace) M :=
    isQuasicoherent_of_isFinitePresentation M
  obtain ⟨hZlfp, hZqc, -⟩ := hfp
  haveI := hZlfp
  haveI := hZqc
  have hsq : IsPullback (pullbackLeftPullbackSndIso (X ↘ Spec (.of k)) p₀ Z.hom).inv
      (pullback.snd (X ↘ Spec (.of k)) (Z.hom ≫ p₀)) (pullback.snd f Z.hom) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by simp [f]⟩
  refine ⟨Z.left, Z.hom, inferInstance, inferInstance,
    (Scheme.Modules.pullback (pullbackLeftPullbackSndIso (X ↘ Spec (.of k)) p₀ Z.hom).inv).obj M,
    Stacks.SheafOfModules.modulePullback_isFinitePresentation
      (pullbackLeftPullbackSndIso (X ↘ Spec (.of k)) p₀ Z.hom).inv.toLRSHom.toShHom M,
    modulePullback_isFlatOver hsq M hZ, fun t ht => ?_⟩
  let φ : Over.mk t ⟶ Z := R.homEquiv.symm ⟨isFlatOver_spec_field k _ _⟩
  let t' : Spec (.of k) ⟶ Z.left := φ.left
  have hφ : t' ≫ Z.hom = t := Over.w φ
  have ht' : t' ≫ Z.hom ≫ p₀ = 𝟙 (Spec (.of k)) := by rw [← Category.assoc, hφ, ht]
  refine ⟨t', ht', ⟨(Scheme.Modules.pullbackComp _ _).app M ≪≫
    (Scheme.Modules.pullbackComp _ _).app 𝒢₀ ≪≫ (Scheme.Modules.pullbackCongr ?_).app 𝒢₀⟩⟩
  apply pullback.hom_ext
  · simp only [Category.assoc, f, pullbackLeftPullbackSndIso_inv_fst]
    rw [fibreSection_fst, fibreSection_fst]
  · simp only [Category.assoc, f, pullbackLeftPullbackSndIso_inv_fst_snd]
    rw [← Category.assoc, fibreSection_snd, fibreSection_snd, Category.assoc, hφ]

/-- The morphism `X ×_k T ⟶ ℙᴺ_T` induced by `ι : X ⟶ ℙᴺ_k`: the base change of `ι` along
`T ⟶ Spec k`, read on the model `ℙᴺ_T = T ×_ℤ ℙᴺ_ℤ`. -/
private noncomputable def familyEmbedding (k : Type u) [Field k] [X.Over (Spec (.of k))] {N : ℕ}
    (ι : X ⟶ projectiveSpaceOver N (Spec (.of k))) {T : Scheme.{u}} (p : T ⟶ Spec (.of k)) :
    pullback (X ↘ Spec (.of k)) p ⟶ projectiveSpaceOver N T :=
  pullback.lift (pullback.snd _ _)
    (pullback.fst _ _ ≫ ι ≫ projectiveSpaceOver.toIntegralAtUniverse N _)
    (terminal.hom_ext _ _)

/-- Over a `k`-point `t` of `T`, the fibre section followed by `X ×_k T ⟶ ℙᴺ_T` is `ι` followed by
`ℙᴺ_k ⟶ ℙᴺ_T`. -/
private theorem fibreSection_familyEmbedding (k : Type u) [Field k] [X.Over (Spec (.of k))]
    {N : ℕ} (ι : X ⟶ projectiveSpaceOver N (Spec (.of k)))
    (hι : ι ≫ pullback.fst _ _ = X ↘ Spec (.of k)) {T : Scheme.{u}} (p : T ⟶ Spec (.of k))
    (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) :
    fibreSection k p t ht ≫ familyEmbedding k ι p = ι ≫ projectiveSpaceOverMap N t := by
  apply pullback.hom_ext
  · rw [Category.assoc, familyEmbedding, pullback.lift_fst, fibreSection_snd, Category.assoc,
      projectiveSpaceOverMap_fst, ← Category.assoc, hι]
  · rw [Category.assoc, familyEmbedding, pullback.lift_snd, ← Category.assoc, fibreSection_fst,
      Category.id_comp, Category.assoc, projectiveSpaceOverMap_snd]

/-- **The bounded families, for `1 ≤ r`, through `Quot`** (Stacks 0DPA). -/
private theorem exists_fpFamilies_of_isGeneratedTwist_of_pos (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsLocallyNoetherian X]
    (H : X.Modules) [IsInvertibleModule X H] (hHva : MMP.Intersection.IsVeryAmple k H)
    (m : ℤ) (r : ℕ) (hr : 1 ≤ r) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (p : ∀ j, T j ⟶ Spec (.of k))
      (_ : ∀ j, QuasiCompact (p j)) (_ : ∀ j, LocallyOfFiniteType (p j))
      (𝒢 : ∀ j, (pullback (X ↘ Spec (.of k)) (p j)).Modules)
      (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (L : X.Modules) [IsInvertibleModule X L], IsGeneratedTwist H m r L →
        ∃ (j : J) (t : Spec (.of k) ⟶ T j) (ht : t ≫ p j = 𝟙 _),
          Nonempty ((Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝒢 j) ≅
            twist H m L) := by
  obtain ⟨N, ι₀, hι₀, hι₀k, -⟩ := hHva
  haveI : IsClosedImmersion ι₀ := hι₀
  let ι := ι₀ ≫ (MMP.Intersection.ProjSpace.isoProjectiveSpaceOver k N).hom
  have hι : ι ≫ pullback.fst _ _ = X ↘ Spec (.of k) := by
    rw [Category.assoc, MMP.Intersection.ProjSpace.isoProjectiveSpaceOver_hom_fst, hι₀k]
  choose Z hZ hE using fun P : ULift.{u} (Polynomial ℚ) =>
    ProjectiveQuot.exists_isProper_iso_hilbertFunctor.{u} N r hr P.down
  let E := fun P => (hE P).some
  let T := fun P => pullback (terminal.from (Z P)) (terminal.from (Spec (.of k)))
  let p : ∀ P, T P ⟶ Spec (.of k) := fun P => pullback.snd _ _
  let U := fun P => (E P).inv.app (Opposite.op (T P))
    (ULift.up (pullback.fst _ _) : ULift.{u + 1} (T P ⟶ Z P))
  haveI : Countable (Polynomial ℚ) := Function.Injective.countable Polynomial.toFinsupp_injective
  refine ⟨ULift.{u} (Polynomial ℚ), inferInstance, T, p, fun P => haveI := hZ P; inferInstance,
    fun P => haveI := hZ P; inferInstance,
    fun P => (Scheme.Modules.pullback (familyEmbedding k ι (p P))).obj (quotient (U P).1),
    fun P => Stacks.Modules.isFinitePresentation_pullback _ _ (U P).2.1.1, fun L _ hgen => ?_⟩
  obtain ⟨σ, hfin, hcard⟩ := hgen
  haveI := isInvertibleModule_twist H m L
  haveI := Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule (twist H m L)
  haveI := Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule (twist H m L)
  haveI : (twist H m L).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType _
  obtain ⟨K, hKfp, ⟨eK⟩⟩ := exists_subobject_quotient_iso k ι (twist H m L) σ hcard
  obtain ⟨P, hK⟩ := exists_mem_hilbertFamilies k K
  let zK : Spec (.of k) ⟶ Z ⟨P⟩ := ((E ⟨P⟩).hom.app (Opposite.op (Spec (.of k))) ⟨K, hK⟩).down
  let t : Spec (.of k) ⟶ T ⟨P⟩ := pullback.lift zK (𝟙 _) (terminal.hom_ext _ _)
  have ht : t ≫ p ⟨P⟩ = 𝟙 _ := pullback.lift_snd _ _ _
  have hU : baseChange t (U ⟨P⟩).1 = K := by
    have h := NatTrans.naturality_apply (E ⟨P⟩).inv t.op
      (ULift.up (pullback.fst (terminal.from (Z ⟨P⟩)) (terminal.from (Spec (.of k)))) :
        ULift.{u + 1} (T ⟨P⟩ ⟶ Z ⟨P⟩))
    have h2 : (yoneda.obj (Z ⟨P⟩) ⋙ uliftFunctor.{u + 1}).map t.op
        (ULift.up (pullback.fst (terminal.from (Z ⟨P⟩)) (terminal.from (Spec (.of k)))) :
          ULift.{u + 1} (T ⟨P⟩ ⟶ Z ⟨P⟩)) =
          (E ⟨P⟩).hom.app (Opposite.op (Spec (.of k))) ⟨K, hK⟩ := by
      apply ULift.ext
      exact pullback.lift_fst (f := terminal.from (Z ⟨P⟩)) (g := terminal.from (Spec (.of k)))
        zK (𝟙 _) (terminal.hom_ext _ _)
    have h3 : (E ⟨P⟩).inv.app (Opposite.op (Spec (.of k)))
        ((E ⟨P⟩).hom.app (Opposite.op (Spec (.of k))) ⟨K, hK⟩) = ⟨K, hK⟩ :=
      Iso.hom_inv_id_apply ((E ⟨P⟩).app (Opposite.op (Spec (.of k)))) _
    rw [h2] at h
    exact (congrArg Subtype.val (h3.symm.trans h)).symm
  haveI := Stacks.ClosedImmersion.full_pushforward ι
  haveI := Stacks.ClosedImmersion.faithful_pushforward ι
  haveI : IsIso (Scheme.Modules.pullbackPushforwardAdjunction ι).counit :=
    Adjunction.counit_isIso_of_R_fully_faithful _
  refine ⟨⟨P⟩, t, ht, ⟨?_⟩⟩
  exact (Scheme.Modules.pullbackComp _ _).app _ ≪≫
    (Scheme.Modules.pullbackCongr (fibreSection_familyEmbedding k ι hι (p ⟨P⟩) t ht)).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback ι).mapIso ((quotientBaseChangeIso t (U ⟨P⟩).1).symm ≪≫
      eqToIso (by rw [hU]) ≪≫ eK) ≪≫
    asIso ((Scheme.Modules.pullbackPushforwardAdjunction ι).counit.app _)

/-- **The bounded families, for `r = 0`**: a module generated by no sections is zero, and the zero
module over `T = Spec k` is the family. -/
private theorem exists_fpFamilies_of_isGeneratedTwist_zero (k : Type u) [Field k]
    [X.Over (Spec (.of k))] (H : X.Modules) [IsInvertibleModule X H] (m : ℤ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (p : ∀ j, T j ⟶ Spec (.of k))
      (_ : ∀ j, QuasiCompact (p j)) (_ : ∀ j, LocallyOfFiniteType (p j))
      (𝒢 : ∀ j, (pullback (X ↘ Spec (.of k)) (p j)).Modules)
      (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (L : X.Modules) [IsInvertibleModule X L], IsGeneratedTwist H m 0 L →
        ∃ (j : J) (t : Spec (.of k) ⟶ T j) (ht : t ≫ p j = 𝟙 _),
          Nonempty ((Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝒢 j) ≅
            twist H m L) := by
  refine ⟨PUnit, inferInstance, fun _ => Spec (.of k), fun _ => 𝟙 _, fun _ => inferInstance,
    fun _ => inferInstance, fun _ => SheafOfModules.free PEmpty,
    fun _ => Stacks.AlgebraicGeometry.ModuleLimits.isFinitePresentation_free_of_finite _ PEmpty,
    fun L _ hgen => ?_⟩
  obtain ⟨σ, hfin, hcard⟩ := hgen
  haveI : IsEmpty σ.I := Finite.card_eq_zero_iff.mp hcard
  have h0 : ∀ Y : Scheme.{u}, IsZero (SheafOfModules.free (R := Y.ringCatSheaf) PEmpty.{u + 1}) :=
    fun _ => Stacks.AlgebraicGeometry.HigherDirectImage.isZero_free_pempty
  refine ⟨PUnit.unit, 𝟙 _, Category.id_comp _, ⟨IsZero.iso ?_ ?_⟩⟩
  · exact (h0 _).of_iso (SheafOfModules.pullbackObjFreeIso _ PEmpty)
  · exact @IsZero.of_epi _ _ _ _ _ σ.π (SheafOfModules.GeneratingSections.epi σ) ((h0 X).of_iso
      (Sigma.whiskerEquiv (f := fun _ : σ.I => SheafOfModules.unit X.ringCatSheaf)
        (g := fun _ : PEmpty.{u + 1} => SheafOfModules.unit X.ringCatSheaf)
        (Equiv.equivPEmpty σ.I) fun _ => Iso.refl _))

/-- **The bounded families for one twist `(m, r)`.** There are countably many finite-type
`k`-schemes `Tⱼ` with modules `𝒢ⱼ` of finite presentation on `X ×_k Tⱼ` such that for every line
bundle `L` with `L ⊗ H^{⊗ m}` generated by `r` sections, `L ⊗ H^{⊗ m}` is the fibre of some `𝒢ⱼ`
over a `k`-point. Flatness is not required: `exists_flattening` supplies it.

Embed `X` by `H` as a closed subscheme `ι : X ↪ ℙᴺ_k` (`MMP.Intersection.IsVeryAmple`,
`MMP.Intersection.ProjSpace.isoProjectiveSpaceOver`). The `r` sections give a quotient
`𝒪^{⊕ r} ↠ ι_*(L ⊗ H^{⊗ m})` on `ℙᴺ_k`, flat over `k` and with some fibre Hilbert polynomial `P`
(`AlgebraicGeometry.ProjectiveQuot.HasFibreHilbertPolynomial`), so a `k`-point of the scheme
`Z_P` representing `Quot^P_{𝒪^{⊕ r}/ℙᴺ/ℤ}`
(`AlgebraicGeometry.ProjectiveQuot.exists_isProper_iso_hilbertFunctor`). Take `Tⱼ = Z_P ×_ℤ k`,
`j = P`, and for `𝒢ⱼ` the restriction of the universal quotient to `X ×_k Tⱼ ⊆ ℙᴺ_{Tⱼ}`; its
fibre over the point is `ι^* ι_*(L ⊗ H^{⊗ m}) ≅ L ⊗ H^{⊗ m}`.

Quot needs `1 ≤ r` (`exists_fpFamilies_of_isGeneratedTwist_of_pos`). For `r = 0`,
`L ⊗ H^{⊗ m}` is a quotient of the zero module, hence zero, and
the zero module over `T = Spec k` is the family. -/
private theorem exists_fpFamilies_of_isGeneratedTwist (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsLocallyNoetherian X]
    (H : X.Modules) [IsInvertibleModule X H] (hHva : MMP.Intersection.IsVeryAmple k H)
    (m : ℤ) (r : ℕ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (p : ∀ j, T j ⟶ Spec (.of k))
      (_ : ∀ j, QuasiCompact (p j)) (_ : ∀ j, LocallyOfFiniteType (p j))
      (𝒢 : ∀ j, (pullback (X ↘ Spec (.of k)) (p j)).Modules)
      (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (L : X.Modules) [IsInvertibleModule X L], IsGeneratedTwist H m r L →
        ∃ (j : J) (t : Spec (.of k) ⟶ T j) (ht : t ≫ p j = 𝟙 _),
          Nonempty ((Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝒢 j) ≅
            twist H m L) := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact exists_fpFamilies_of_isGeneratedTwist_zero k H m
  · exact exists_fpFamilies_of_isGeneratedTwist_of_pos k H hHva m r hr

/-- **The flat families for one twist `(m, r)`**: the bounded families of
`exists_fpFamilies_of_isGeneratedTwist`, flattened by `exists_flattening`. -/
private theorem exists_flatFamilies_of_isGeneratedTwist (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))] [IsLocallyNoetherian X]
    (H : X.Modules) [IsInvertibleModule X H] (hHva : MMP.Intersection.IsVeryAmple k H)
    (m : ℤ) (r : ℕ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (p : ∀ j, T j ⟶ Spec (.of k))
      (_ : ∀ j, QuasiCompact (p j)) (_ : ∀ j, LocallyOfFiniteType (p j))
      (𝒢 : ∀ j, (pullback (X ↘ Spec (.of k)) (p j)).Modules)
      (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j))
      (_ : ∀ j, IsFlatOver (pullback.snd (X ↘ Spec (.of k)) (p j)).toLRSHom.toShHom (𝒢 j)),
      ∀ (L : X.Modules) [IsInvertibleModule X L], IsGeneratedTwist H m r L →
        ∃ (j : J) (t : Spec (.of k) ⟶ T j) (ht : t ≫ p j = 𝟙 _),
          Nonempty ((Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝒢 j) ≅
            twist H m L) := by
  obtain ⟨J, hJ, T₀, p₀, hqc, hlft, 𝒢₀, hfp, hcov⟩ :=
    exists_fpFamilies_of_isGeneratedTwist k H hHva m r
  choose T q hqc' hlft' 𝒢 hfp' hflat hfac using fun j =>
    haveI := hqc j; haveI := hlft j; haveI := hfp j
    exists_flattening k (p₀ j) (𝒢₀ j)
  refine ⟨J, hJ, T, fun j => q j ≫ p₀ j, hqc', hlft', 𝒢, hfp', hflat, fun L _ hgen => ?_⟩
  obtain ⟨j, t, ht, ⟨e⟩⟩ := hcov L hgen
  obtain ⟨t', ht', ⟨e'⟩⟩ := hfac j t ht
  exact ⟨j, t', ht', ⟨e' ≪≫ e⟩⟩

/-- **The invertible locus of a flat family.** For a module `𝒢` of finite presentation on
`X ×_k T`, flat over the finite-type `k`-scheme `T`, there is a finite-type `U ⟶ T` over which
`𝒢` is invertible and through which every `k`-point with invertible fibre factors.

`U` is the open complement of the image in `T` of the closed set where `𝒢` is not free of rank
one; the image is closed because `X ×_k T ⟶ T` is proper. A `k`-point with invertible fibre
lies in `U` by `mem_lineLocus_of_isLineBundle_pullback`, the fibre section being the base change
of the point (`isPullback_fibreSection`). -/
private theorem exists_isLineBundle_of_isFlatOver (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))] [IsLocallyNoetherian X]
    {T : Scheme.{u}} (p : T ⟶ Spec (.of k)) [QuasiCompact p] [LocallyOfFiniteType p]
    (𝒢 : (pullback (X ↘ Spec (.of k)) p).Modules) [SheafOfModules.IsFinitePresentation 𝒢]
    (h𝒢 : IsFlatOver (pullback.snd (X ↘ Spec (.of k)) p).toLRSHom.toShHom 𝒢) :
    ∃ (U : Scheme.{u}) (j : U ⟶ T) (_ : QuasiCompact (j ≫ p)) (_ : LocallyOfFiniteType (j ≫ p)),
      IsLineBundle ((Scheme.Modules.pullback (pullback.map (X ↘ Spec (.of k)) (j ≫ p)
        (X ↘ Spec (.of k)) p (𝟙 X) j (𝟙 _) (by simp) (by simp))).obj 𝒢) ∧
      ∀ (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _),
        IsLineBundle ((Scheme.Modules.pullback (fibreSection k p t ht)).obj 𝒢) →
          ∃ t' : Spec (.of k) ⟶ U, t' ≫ j = t := by
  let f := pullback.snd (X ↘ Spec (.of k)) p
  let U : T.Opens :=
    ⟨(f '' (lineLocus 𝒢)ᶜ)ᶜ, (f.isClosedMap _ (isOpen_lineLocus 𝒢).isClosed_compl).isOpen_compl⟩
  haveI : IsLocallyNoetherian T := LocallyOfFiniteType.isLocallyNoetherian p
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace p
  refine ⟨U, U.ι, inferInstance, inferInstance, ?_, ?_⟩
  · intro w
    let g := pullback.map (X ↘ Spec (.of k)) (U.ι ≫ p) (X ↘ Spec (.of k)) p (𝟙 X) U.ι (𝟙 _)
      (by simp) (by simp)
    have hgw : g w ∈ lineLocus 𝒢 := by
      by_contra hc
      have h1 : f (g w) = U.ι (pullback.snd (X ↘ Spec (.of k)) (U.ι ≫ p) w) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, pullback.lift_snd]
      have h2 : U.ι (pullback.snd (X ↘ Spec (.of k)) (U.ι ≫ p) w) ∈ (U : Set T) := by
        rw [← Scheme.Opens.range_ι]
        exact Set.mem_range_self _
      exact h2 ⟨g w, hc, h1⟩
    obtain ⟨V, hV, ⟨e⟩⟩ := hgw
    exact ⟨g ⁻¹ᵁ V, hV, ⟨restrictPullbackIsoFree g (restrictIsoFreeOfOverIso e)⟩⟩
  · intro t ht hinv
    have hP := isPullback_fibreSection (X := X) k p t ht
    have hfst : IsLineBundle
        ((Scheme.Modules.pullback (pullback.fst f t)).obj 𝒢) := by
      intro z
      obtain ⟨V, hV, ⟨e⟩⟩ := isLineBundle_pullback hP.isoPullback.inv hinv z
      refine ⟨V, hV, ⟨(Scheme.Modules.restrictFunctor V.ι).mapIso ?_ ≪≫ e⟩⟩
      exact ((Scheme.Modules.pullbackComp _ _).app 𝒢 ≪≫
        (Scheme.Modules.pullbackCongr hP.isoPullback_inv_fst).app 𝒢).symm
    have hrange : Set.range t ⊆ Set.range U.ι := by
      rintro _ ⟨a, rfl⟩
      rw [Scheme.Opens.range_ι]
      rintro ⟨y, hy, hfy⟩
      exact hy (mem_lineLocus_of_isLineBundle_pullback f 𝒢 h𝒢 t hfst ⟨a, hfy.symm⟩)
    exact ⟨IsOpenImmersion.lift U.ι t hrange, IsOpenImmersion.lift_fac _ _ _⟩

open Stacks.ProjBundleInverseBaseChange (Mods pullbackFunctor pullbackTensorIso) in
/-- **Untwisting a family.** For a line bundle `𝓛'` on `X ×_k T`, the line bundle
`𝓛' ⊗ pr_X^* H^{⊗ -m}` has fibre `L` wherever `𝓛'` has fibre `L ⊗ H^{⊗ m}`: inverse images
commute with tensor products (Stacks 01CD, `Stacks.ProjBundleInverseBaseChange.pullbackTensorIso`),
the fibre section is a section of `pr_X`, and `H^{⊗ m} ⊗ H^{⊗ -m} ≅ 𝒪_X`
(`Stacks.Ample.tensorPowModuleAddIso`). The tensor product is the one of
`Stacks.SheafInternalHom.schemeMonoidalCategory`, read on the `Mods` spelling. -/
private theorem exists_untwist (k : Type u) [Field k] [X.Over (Spec (.of k))]
    (H : X.Modules) [IsInvertibleModule X H] (m : ℤ)
    {T : Scheme.{u}} (p : T ⟶ Spec (.of k))
    (𝓛' : (pullback (X ↘ Spec (.of k)) p).Modules) (h𝓛' : IsLineBundle 𝓛') :
    ∃ 𝓛 : (pullback (X ↘ Spec (.of k)) p).Modules, IsLineBundle 𝓛 ∧
      ∀ (t : Spec (.of k) ⟶ T) (ht : t ≫ p = 𝟙 _) (L : X.Modules),
        Nonempty ((Scheme.Modules.pullback (fibreSection k p t ht)).obj 𝓛' ≅
          twist H m L) →
        Nonempty (L ≅ (Scheme.Modules.pullback (fibreSection k p t ht)).obj 𝓛) := by
  letI : ∀ Y : Scheme.{u}, MonoidalCategory (Mods Y) :=
    Stacks.SheafInternalHom.schemeMonoidalCategory
  let q : pullback (X ↘ Spec (.of k)) p ⟶ X := pullback.fst (X ↘ Spec (.of k)) p
  haveI := Stacks.Ample.isInvertibleModule_tensorPowModule X H (-m)
  let K : Mods (pullback (X ↘ Spec (.of k)) p) :=
    (Scheme.Modules.pullback q).obj (tensorPowModule X H (-m))
  haveI hK : IsInvertibleModule _ K :=
    Stacks.ProjectiveBundleQuotients.isInvertible_pullback_obj q _
  haveI h𝓛'i : IsInvertibleModule _ 𝓛' := isInvertibleModule_of_isLineBundle 𝓛' h𝓛'
  let 𝓛'' : Mods (pullback (X ↘ Spec (.of k)) p) := 𝓛'
  let 𝓛 : Mods (pullback (X ↘ Spec (.of k)) p) := 𝓛'' ⊗ K
  have h𝓛K : IsInvertibleModule _ 𝓛 :=
    AlgebraicGeometry.SheafOfModules.isInvertible_tensor _
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf _) 𝓛'' K
  refine ⟨𝓛, @isLineBundle_of_isInvertibleModule _ _ h𝓛K, fun t ht L he => ?_⟩
  obtain ⟨e⟩ := he
  refine ⟨?_⟩
  let s : X ⟶ _ := fibreSection k p t ht
  have hsq : s ≫ q = 𝟙 X := pullback.lift_fst _ _ _
  let L' : Mods X := L
  let Hm : Mods X := tensorPowModule X H m
  let Hn : Mods X := tensorPowModule X H (-m)
  let eK : @Iso (Mods X) _ ((pullbackFunctor s).obj K) Hn :=
    (Scheme.Modules.pullbackComp s q).app _ ≪≫ (Scheme.Modules.pullbackCongr hsq).app _ ≪≫
      (Scheme.Modules.pullbackId X).app _
  let e' : @Iso (Mods X) _ ((pullbackFunctor s).obj 𝓛'') (L' ⊗ Hm) := e
  let eHH : @Iso (Mods X) _ (Hm ⊗ Hn) (𝟙_ (Mods X)) :=
    AlgebraicGeometry.SheafOfModules.tensorIso X.presheaf
        (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) Hm Hn ≪≫
      Stacks.Ample.tensorPowModuleAddIso X H m (-m) ≪≫
      eqToIso (congrArg (tensorPowModule X H) (add_neg_cancel m)) ≪≫
      Stacks.Ample.tensorPowModuleZeroIso X H ≪≫ Stacks.Ample.unitModuleIsoTensorUnit X
  exact (show @Iso (Mods X) _ L' ((pullbackFunctor s).obj 𝓛) from
    (ρ_ L').symm ≪≫ (Iso.refl L' ⊗ᵢ eHH.symm) ≪≫ (α_ L' Hm Hn).symm ≪≫
      (e'.symm ⊗ᵢ eK.symm) ≪≫ (pullbackTensorIso s 𝓛'' K).symm)

/-- The fibre section over `t' : Spec k ⟶ U` followed by `X ×_k U ⟶ X ×_k T` is the fibre
section over `t' ≫ j`. -/
private theorem fibreSection_comp_map (k : Type u) [Field k] [X.Over (Spec (.of k))]
    {T U : Scheme.{u}} (p : T ⟶ Spec (.of k)) (j : U ⟶ T) (t' : Spec (.of k) ⟶ U)
    (ht' : t' ≫ j ≫ p = 𝟙 _) :
    fibreSection k (j ≫ p) t' ht' ≫ pullback.map (X ↘ Spec (.of k)) (j ≫ p)
        (X ↘ Spec (.of k)) p (𝟙 X) j (𝟙 _) (by simp) (by simp) =
      fibreSection k p (t' ≫ j) (by rw [Category.assoc, ht']) := by
  apply pullback.hom_ext
  · simp only [fibreSection, Category.assoc, pullback.lift_fst, pullback.lift_fst_assoc]
    exact Category.comp_id _
  · simp only [fibreSection, Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc]

/-- **The families for one twist `(m, r)`**: countably many finite-type families of line
bundles containing every `L` with `L ⊗ H^{⊗ m}` generated by `r` sections. -/
private theorem exists_families_of_isGeneratedTwist (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))] [IsLocallyNoetherian X]
    (H : X.Modules) [IsInvertibleModule X H] (hHva : MMP.Intersection.IsVeryAmple k H)
    (m : ℤ) (r : ℕ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (p : ∀ j, T j ⟶ Spec (.of k))
      (_ : ∀ j, QuasiCompact (p j)) (_ : ∀ j, LocallyOfFiniteType (p j))
      (𝓛 : ∀ j, (pullback (X ↘ Spec (.of k)) (p j)).Modules)
      (_ : ∀ j, IsLineBundle (𝓛 j)),
      ∀ (L : X.Modules), IsLineBundle L → IsGeneratedTwist H m r L →
        ∃ (j : J) (t : Spec (.of k) ⟶ T j) (ht : t ≫ p j = 𝟙 _),
          Nonempty (L ≅ (Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝓛 j)) := by
  obtain ⟨J, hJ, T, p, hqc, hlft, 𝒢, hfp, hflat, hcov⟩ :=
    exists_flatFamilies_of_isGeneratedTwist k H hHva m r
  choose U jU hUqc hUlft hU hUpt using fun j =>
    haveI := hqc j; haveI := hlft j; haveI := hfp j
    exists_isLineBundle_of_isFlatOver k (p j) (𝒢 j) (hflat j)
  choose 𝓛 h𝓛 h𝓛fib using fun j => exists_untwist k H m (jU j ≫ p j) _ (hU j)
  refine ⟨J, hJ, U, fun j => jU j ≫ p j, hUqc, hUlft, 𝓛, h𝓛, fun L hL hgen => ?_⟩
  haveI := isInvertibleModule_of_isLineBundle L hL
  obtain ⟨j, t, ht, ⟨e⟩⟩ := hcov L hgen
  have hinv : IsLineBundle ((Scheme.Modules.pullback (fibreSection k (p j) t ht)).obj (𝒢 j)) :=
    haveI := isInvertibleModule_twist H m L
    isLineBundle_of_iso e.symm (isLineBundle_of_isInvertibleModule _)
  obtain ⟨t', rfl⟩ := hUpt j t ht hinv
  have ht' : t' ≫ jU j ≫ p j = 𝟙 _ := by rw [← Category.assoc, ht]
  refine ⟨j, t', ht', h𝓛fib j t' ht' L ⟨?_⟩⟩
  refine ((Scheme.Modules.pullbackComp _ _).app (𝒢 j)) ≪≫ eqToIso ?_ ≪≫ e
  rw [fibreSection_comp_map]

end OverField

/-- Over an algebraically closed field `k`, on a projective `k`-scheme `X` with a very ample
invertible sheaf, there are countably many finite-type `k`-schemes `Tᵢ` and invertible sheaves
`𝓛ᵢ` on `X ×_k Tᵢ` such that every invertible sheaf on `X` is isomorphic to the restriction of
some `𝓛ᵢ` to the fibre over a `k`-point of `Tᵢ`. -/
@[mmp "lem_mmp_foundation_countable_line_bundle_families"]
public theorem exists_countable_isLineBundle_families (k : Type u) [Field k] [IsAlgClosed k]
    (X : Scheme.{u}) [X.Over (Spec (.of k))] (hX : IsProjective (X ↘ Spec (.of k))) (H : X.Modules)
    (hH : Intersection.Scheme.Modules.IsLineBundle H) (hHva : Intersection.IsVeryAmple k H) :
    ∃ (ι : Type u) (_ : Countable ι) (T : ι → Scheme.{u}) (p : ∀ i, T i ⟶ Spec (.of k))
      (_ : ∀ i, QuasiCompact (p i)) (_ : ∀ i, LocallyOfFiniteType (p i))
      (𝓛 : ∀ i, (pullback (X ↘ Spec (.of k)) (p i)).Modules)
      (_ : ∀ i, Intersection.Scheme.Modules.IsLineBundle (𝓛 i)),
      ∀ L : X.Modules, Intersection.Scheme.Modules.IsLineBundle L →
        ∃ (i : ι) (t : Spec (.of k) ⟶ T i) (ht : t ≫ p i = 𝟙 _),
          Nonempty (L ≅ (Scheme.Modules.pullback (pullback.lift (𝟙 X) (X ↘ Spec (.of k) ≫ t)
            (by rw [Category.assoc, ht, Category.comp_id, Category.id_comp]))).obj (𝓛 i)) := by
  haveI : IsProper (X ↘ Spec (.of k)) := hX.isProper
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of k))
  haveI : IsInvertibleModule X H := isInvertibleModule_of_isLineBundle H hH
  choose J hJ T p hqc hlft 𝓛 h𝓛 hcov using fun d : ULift.{u} (ℤ × ℕ) =>
    OverField.exists_families_of_isGeneratedTwist k H hHva d.down.1 d.down.2
  refine ⟨Σ d : ULift.{u} (ℤ × ℕ), J d, inferInstance, fun i => T i.1 i.2, fun i => p i.1 i.2,
    fun i => hqc i.1 i.2, fun i => hlft i.1 i.2, fun i => 𝓛 i.1 i.2, fun i => h𝓛 i.1 i.2,
    fun L hL => ?_⟩
  haveI := isInvertibleModule_of_isLineBundle L hL
  obtain ⟨m, r, hgen⟩ := exists_isGeneratedTwist H (OverField.isAmple_of_isVeryAmple k H hHva) L
  obtain ⟨j, t, ht, e⟩ := hcov ⟨(m, r)⟩ L hL hgen
  exact ⟨⟨⟨(m, r)⟩, j⟩, t, ht, e⟩

/-! ### Families over the closed fibres of a projective morphism -/

namespace Relative

/-! ### Fibres of families over `S`

For `g : T ⟶ S` and a point `y : Y ⟶ S` lifted to `μ : Y ⟶ T`, the fibre `X ×_S Y` maps to the
family `X ×_S T` over `μ`. -/

section Fibres

variable {X S : Scheme.{u}} (f : X ⟶ S)

/-- The morphism `X ×_S Y ⟶ X ×_S T` induced by a lift `μ : Y ⟶ T` of `y : Y ⟶ S` along
`g : T ⟶ S`. -/
private noncomputable abbrev fibMap {T Y : Scheme.{u}} (g : T ⟶ S) (y : Y ⟶ S) (μ : Y ⟶ T)
    (h : μ ≫ g = y) : pullback f y ⟶ pullback f g :=
  pullback.lift (pullback.fst f y) (pullback.snd f y ≫ μ)
    (by rw [Category.assoc, h, pullback.condition])

set_option backward.isDefEq.respectTransparency false in
/-- Fibre maps compose with the base change of `q : T' ⟶ T`. -/
private theorem fibMap_comp_map {T T' Y : Scheme.{u}} (g : T ⟶ S) (q : T' ⟶ T) (y : Y ⟶ S)
    (μ : Y ⟶ T') (h : μ ≫ q ≫ g = y) :
    fibMap f (q ≫ g) y μ h ≫ pullback.map f (q ≫ g) f g (𝟙 X) q (𝟙 S) (by simp) (by simp) =
      fibMap f g y (μ ≫ q) (by rw [Category.assoc, h]) := by
  apply pullback.hom_ext <;> simp [fibMap]

/-- The image of a composite lies in the image of its second factor. -/
private theorem range_comp_subset {T T' : Scheme.{u}} (q : T' ⟶ T) (g : T ⟶ S) {V : Set S}
    (hg : Set.range g ⊆ V) : Set.range (q ≫ g) ⊆ V := by
  rintro _ ⟨x, rfl⟩
  exact hg ⟨q x, by rw [Scheme.Hom.comp_apply]⟩

set_option backward.isDefEq.respectTransparency false in
/-- **Flattening a family over `S`** (Stacks 05UH). A family `𝒢₀` of finite presentation on
`X ×_S T₀` has a base change `𝒢` to some `T ⟶ T₀` of finite type that is flat over `T`, and
every point of `T₀` with values in a field lifts to `T` with the same fibre. -/
private theorem exists_flattening [IsProper f] {T₀ : Scheme.{u}} (g₀ : T₀ ⟶ S)
    [IsLocallyNoetherian T₀]
    (𝒢₀ : (pullback f g₀).Modules) [SheafOfModules.IsFinitePresentation 𝒢₀] :
    ∃ (T : Scheme.{u}) (q : T ⟶ T₀) (_ : QuasiCompact q) (_ : LocallyOfFiniteType q)
      (𝒢 : (pullback f (q ≫ g₀)).Modules) (_ : SheafOfModules.IsFinitePresentation 𝒢)
      (_ : IsFlatOver (pullback.snd f (q ≫ g₀)).toLRSHom.toShHom 𝒢),
      ∀ (k : Type u) [Field k] (y : Spec (.of k) ⟶ S) (μ : Spec (.of k) ⟶ T₀)
        (hμ : μ ≫ g₀ = y),
        ∃ (μ' : Spec (.of k) ⟶ T) (hμ' : μ' ≫ q ≫ g₀ = y), μ' ≫ q = μ ∧
          Nonempty ((Scheme.Modules.pullback (fibMap f (q ≫ g₀) y μ' hμ')).obj 𝒢 ≅
            (Scheme.Modules.pullback (fibMap f g₀ y μ hμ)).obj 𝒢₀) := by
  let f' := pullback.snd f g₀
  haveI : LocallyOfFinitePresentation f' :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  haveI := isQuasicoherent_of_isFinitePresentation 𝒢₀
  obtain ⟨Z, _, hfp, ⟨R⟩⟩ := exists_mono_finitePresentation_representableBy_of_isProper f' 𝒢₀
  have hZ : IsFlatOver (pullback.snd f' Z.hom).toLRSHom.toShHom
      ((Scheme.Modules.pullback (pullback.fst f' Z.hom)).obj 𝒢₀) := (R.homEquiv (𝟙 Z)).down
  let M := (Scheme.Modules.pullback (pullback.fst f' Z.hom)).obj 𝒢₀
  haveI : SheafOfModules.IsFinitePresentation
      (R := structureSheafRing (pullback f g₀).toRingedSpace) 𝒢₀ := ‹_›
  haveI : SheafOfModules.IsFinitePresentation M :=
    Stacks.SheafOfModules.modulePullback_isFinitePresentation
      (pullback.fst f' Z.hom).toLRSHom.toShHom 𝒢₀
  haveI hMfp : SheafOfModules.IsFinitePresentation
      (R := structureSheafRing (pullback f' Z.hom).toRingedSpace) M := ‹_›
  haveI : SheafOfModules.IsQuasicoherent
      (R := structureSheafRing (pullback f' Z.hom).toRingedSpace) M :=
    isQuasicoherent_of_isFinitePresentation M
  obtain ⟨hZlfp, hZqc, -⟩ := hfp
  haveI := hZlfp
  haveI := hZqc
  have hsq : IsPullback (pullbackLeftPullbackSndIso f g₀ Z.hom).inv
      (pullback.snd f (Z.hom ≫ g₀)) (pullback.snd f' Z.hom) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by simp [f']⟩
  refine ⟨Z.left, Z.hom, inferInstance, inferInstance,
    (Scheme.Modules.pullback (pullbackLeftPullbackSndIso f g₀ Z.hom).inv).obj M,
    Stacks.SheafOfModules.modulePullback_isFinitePresentation
      (pullbackLeftPullbackSndIso f g₀ Z.hom).inv.toLRSHom.toShHom M,
    modulePullback_isFlatOver hsq M hZ, fun k _ y μ hμ => ?_⟩
  let φ : Over.mk μ ⟶ Z := R.homEquiv.symm ⟨isFlatOver_spec_field k _ _⟩
  let μ' : Spec (.of k) ⟶ Z.left := φ.left
  have hφ : μ' ≫ Z.hom = μ := Over.w φ
  refine ⟨μ', by rw [← Category.assoc, hφ, hμ], hφ, ⟨(Scheme.Modules.pullbackComp _ _).app M ≪≫
    (Scheme.Modules.pullbackComp _ _).app 𝒢₀ ≪≫ (Scheme.Modules.pullbackCongr ?_).app 𝒢₀⟩⟩
  apply pullback.hom_ext
  · simp [f', fibMap]
  · simp [f', fibMap, hφ]

set_option backward.isDefEq.respectTransparency false in
/-- **The invertible locus of a flat family.** For a module `𝒢` of finite presentation on
`X ×_S T`, flat over `T`, there is an open `U ⊆ T` over which `𝒢` is invertible and through which
every point with invertible fibre factors. `U` is the complement of the image of the closed set
where `𝒢` is not free of rank one, closed as `X ×_S T ⟶ T` is proper. -/
private theorem exists_isLineBundle_of_isFlatOver [IsProper f] {T : Scheme.{u}} (g : T ⟶ S)
    [IsLocallyNoetherian T]
    (𝒢 : (pullback f g).Modules) [SheafOfModules.IsFinitePresentation 𝒢]
    (h𝒢 : IsFlatOver (pullback.snd f g).toLRSHom.toShHom 𝒢) :
    ∃ (U : Scheme.{u}) (j : U ⟶ T) (_ : IsOpenImmersion j),
      IsLineBundle ((Scheme.Modules.pullback
        (pullback.map f (j ≫ g) f g (𝟙 X) j (𝟙 S) (by simp) (by simp))).obj 𝒢) ∧
      ∀ {Y : Scheme.{u}} (y : Y ⟶ S) (μ : Y ⟶ T) (hμ : μ ≫ g = y),
        IsLineBundle ((Scheme.Modules.pullback (fibMap f g y μ hμ)).obj 𝒢) →
          ∃ μ' : Y ⟶ U, μ' ≫ j = μ := by
  let f' := pullback.snd f g
  haveI : LocallyOfFinitePresentation f' :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  let U : T.Opens :=
    ⟨(f' '' (lineLocus 𝒢)ᶜ)ᶜ, (f'.isClosedMap _ (isOpen_lineLocus 𝒢).isClosed_compl).isOpen_compl⟩
  refine ⟨U, U.ι, inferInstance, ?_, ?_⟩
  · intro w
    let g' := pullback.map f (U.ι ≫ g) f g (𝟙 X) U.ι (𝟙 _) (by simp) (by simp)
    have hgw : g' w ∈ lineLocus 𝒢 := by
      by_contra hc
      have h1 : f' (g' w) = U.ι (pullback.snd f (U.ι ≫ g) w) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, pullback.lift_snd]
      have h2 : U.ι (pullback.snd f (U.ι ≫ g) w) ∈ (U : Set T) := by
        rw [← Scheme.Opens.range_ι]
        exact Set.mem_range_self _
      exact h2 ⟨g' w, hc, h1⟩
    obtain ⟨V, hV, ⟨e⟩⟩ := hgw
    exact ⟨g' ⁻¹ᵁ V, hV, ⟨restrictPullbackIsoFree g' (restrictIsoFreeOfOverIso e)⟩⟩
  · intro Y y μ hμ hinv
    let φ : pullback f' μ ⟶ pullback f y :=
      pullback.lift (pullback.fst f' μ ≫ pullback.fst f g) (pullback.snd f' μ) (by
        rw [Category.assoc, pullback.condition (f := f), ← Category.assoc,
          pullback.condition (f := f'), Category.assoc, hμ])
    have hφ : φ ≫ fibMap f g y μ hμ = pullback.fst f' μ := by
      apply pullback.hom_ext
      · simp [φ, fibMap]
      · simp only [φ, fibMap, Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc]
        exact (pullback.condition (f := f')).symm
    have hfst : IsLineBundle ((Scheme.Modules.pullback (pullback.fst f' μ)).obj 𝒢) :=
      isLineBundle_of_iso ((Scheme.Modules.pullbackComp _ _).app 𝒢 ≪≫
        (Scheme.Modules.pullbackCongr hφ).app 𝒢) (isLineBundle_pullback φ hinv)
    have hrange : Set.range μ ⊆ Set.range U.ι := by
      rintro _ ⟨a, rfl⟩
      rw [Scheme.Opens.range_ι]
      rintro ⟨x, hx, hfx⟩
      exact hx (mem_lineLocus_of_isLineBundle_pullback f' 𝒢 h𝒢 μ hfst ⟨a, hfx.symm⟩)
    exact ⟨IsOpenImmersion.lift U.ι μ hrange, IsOpenImmersion.lift_fac _ _ _⟩

end Fibres

/-! ### Families over an open of the base embedded in projective space -/

section Embedded

variable {X S : Scheme.{u}} (f : X ⟶ S) (V : S.Opens)

/-- The projection `X ×_S T ⟶ f⁻¹(V)`, for `g : T ⟶ S` landing in `V`. -/
private noncomputable def fstV {T : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V) :
    pullback f g ⟶ (f ⁻¹ᵁ V).toScheme :=
  IsOpenImmersion.lift (f ⁻¹ᵁ V).ι (pullback.fst f g) (by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    change f (pullback.fst f g z) ∈ V
    rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply]
    exact hg ⟨_, rfl⟩)

private theorem fstV_ι {T : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V) :
    fstV f V g hg ≫ (f ⁻¹ᵁ V).ι = pullback.fst f g :=
  IsOpenImmersion.lift_fac _ _ _

private theorem fibMap_fstV {T Y : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V) (y : Y ⟶ S)
    (hy : Set.range y ⊆ V) (μ : Y ⟶ T) (hμ : μ ≫ g = y) :
    fibMap f g y μ hμ ≫ fstV f V g hg = fstV f V y hy := by
  rw [← cancel_mono (f ⁻¹ᵁ V).ι, Category.assoc, fstV_ι, fstV_ι]
  exact pullback.lift_fst _ _ _

private theorem range_fromSpecResidueField_subset {s : S} (hs : s ∈ V) :
    Set.range (S.fromSpecResidueField s) ⊆ V := by
  rw [Scheme.range_fromSpecResidueField]
  simpa using hs

/-- The fibre over a closed point is a closed subscheme of `f⁻¹(V)`. -/
private theorem isClosedImmersion_fstV {Y : Scheme.{u}} (y : Y ⟶ S) [IsClosedImmersion y]
    (hy : Set.range y ⊆ V) : IsClosedImmersion (fstV f V y hy) := by
  haveI : IsClosedImmersion (fstV f V y hy ≫ (f ⁻¹ᵁ V).ι) := by
    rw [fstV_ι]
    infer_instance
  exact IsClosedImmersion.of_comp _ (f ⁻¹ᵁ V).ι

open Stacks.ProjBundleInverseBaseChange (Mods pullbackFunctor pullbackTensorIso) in
/-- **Untwisting a family.** For a line bundle `𝓛'` on `X ×_S T`, the line bundle
`𝓛' ⊗ pr^* H_V^{⊗ -m}` has fibre `L` wherever `𝓛'` has fibre `L ⊗ H_V^{⊗ m}`: inverse images
commute with tensor products and tensor powers (Stacks 01CD), and
`H^{⊗ m} ⊗ H^{⊗ -m} ≅ 𝒪`. -/
private theorem exists_untwist (HV : (f ⁻¹ᵁ V).toScheme.Modules) [IsInvertibleModule _ HV]
    (m : ℤ) {T : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V)
    (𝓛' : (pullback f g).Modules) (h𝓛' : IsLineBundle 𝓛') :
    ∃ 𝓛 : (pullback f g).Modules, IsLineBundle 𝓛 ∧
      ∀ {Y : Scheme.{u}} (y : Y ⟶ S) (hy : Set.range y ⊆ V) (μ : Y ⟶ T) (hμ : μ ≫ g = y)
        (L : (pullback f y).Modules),
        Nonempty ((Scheme.Modules.pullback (fibMap f g y μ hμ)).obj 𝓛' ≅
          twist ((Scheme.Modules.pullback (fstV f V y hy)).obj HV) m L) →
        Nonempty (L ≅ (Scheme.Modules.pullback (fibMap f g y μ hμ)).obj 𝓛) := by
  letI : ∀ Y : Scheme.{u}, MonoidalCategory (Mods Y) :=
    Stacks.SheafInternalHom.schemeMonoidalCategory
  haveI := Stacks.Ample.isInvertibleModule_tensorPowModule _ HV (-m)
  let K : Mods (pullback f g) :=
    (Scheme.Modules.pullback (fstV f V g hg)).obj (tensorPowModule _ HV (-m))
  haveI hK : IsInvertibleModule _ K :=
    Stacks.ProjectiveBundleQuotients.isInvertible_pullback_obj _ _
  haveI h𝓛'i : IsInvertibleModule _ 𝓛' := isInvertibleModule_of_isLineBundle 𝓛' h𝓛'
  let 𝓛'' : Mods (pullback f g) := 𝓛'
  let 𝓛 : Mods (pullback f g) := 𝓛'' ⊗ K
  have h𝓛K : IsInvertibleModule _ 𝓛 :=
    AlgebraicGeometry.SheafOfModules.isInvertible_tensor _
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf _) 𝓛'' K
  refine ⟨𝓛, @isLineBundle_of_isInvertibleModule _ _ h𝓛K, fun {Y} y hy μ hμ L he => ?_⟩
  obtain ⟨e⟩ := he
  refine ⟨?_⟩
  let A : (pullback f y).Modules := (Scheme.Modules.pullback (fstV f V y hy)).obj HV
  let s : pullback f y ⟶ _ := fibMap f g y μ hμ
  let L' : Mods (pullback f y) := L
  let Hm : Mods (pullback f y) := tensorPowModule _ A m
  let Hn : Mods (pullback f y) := tensorPowModule _ A (-m)
  let eK : @Iso (Mods (pullback f y)) _ ((pullbackFunctor s).obj K) Hn :=
    (Scheme.Modules.pullbackComp s (fstV f V g hg)).app _ ≪≫
      (Scheme.Modules.pullbackCongr (fibMap_fstV f V g hg y hy μ hμ)).app _ ≪≫
      Stacks.AlgebraicGeometry.HyperplaneTwistSequence.pullbackTensorPowModuleIntIso _ HV (-m)
  let e' : @Iso (Mods (pullback f y)) _ ((pullbackFunctor s).obj 𝓛'') (L' ⊗ Hm) := e
  let eHH : @Iso (Mods (pullback f y)) _ (Hm ⊗ Hn) (𝟙_ (Mods (pullback f y))) :=
    AlgebraicGeometry.SheafOfModules.tensorIso (pullback f y).presheaf
        (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf (pullback f y)) Hm Hn ≪≫
      Stacks.Ample.tensorPowModuleAddIso _ A m (-m) ≪≫
      eqToIso (congrArg (tensorPowModule _ A) (add_neg_cancel m)) ≪≫
      Stacks.Ample.tensorPowModuleZeroIso _ A ≪≫ Stacks.Ample.unitModuleIsoTensorUnit _
  exact (show @Iso (Mods (pullback f y)) _ L' ((pullbackFunctor s).obj 𝓛) from
    (ρ_ L').symm ≪≫ (Iso.refl L' ⊗ᵢ eHH.symm) ≪≫ (α_ L' Hm Hn).symm ≪≫
      (e'.symm ⊗ᵢ eK.symm) ≪≫ (pullbackTensorIso s 𝓛'' K).symm)

variable {N : ℕ} (i : (f ⁻¹ᵁ V).toScheme ⟶ projectiveSpaceOver N V)

/-- The morphism `X ×_S T ⟶ ℙᴺ_T` induced by `i : f⁻¹(V) ⟶ ℙᴺ_V`, for `g : T ⟶ S` landing in
`V`. For a point `y`, it is the embedding of the fibre `X ×_S Y` into `ℙᴺ_Y`. -/
private noncomputable def familyEmbedding {T : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V) :
    pullback f g ⟶ projectiveSpaceOver N T :=
  pullback.lift (pullback.snd f g)
    (fstV f V g hg ≫ i ≫ projectiveSpaceOver.toIntegralAtUniverse N _) (terminal.hom_ext _ _)

set_option backward.isDefEq.respectTransparency false in
/-- Over a lift `μ` of `y`, the fibre map followed by the family embedding is the fibre embedding
followed by `ℙᴺ_Y ⟶ ℙᴺ_T`. -/
private theorem fibMap_familyEmbedding {T Y : Scheme.{u}} (g : T ⟶ S) (hg : Set.range g ⊆ V)
    (y : Y ⟶ S) (hy : Set.range y ⊆ V) (μ : Y ⟶ T) (hμ : μ ≫ g = y) :
    fibMap f g y μ hμ ≫ familyEmbedding f V i g hg =
      familyEmbedding f V i y hy ≫ projectiveSpaceOverMap N μ := by
  apply pullback.hom_ext
  · rw [Category.assoc, Category.assoc, projectiveSpaceOverMap_fst]
    simp [familyEmbedding, fibMap]
  · rw [Category.assoc, Category.assoc]
    erw [projectiveSpaceOverMap_snd]
    simp only [familyEmbedding, pullback.lift_snd]
    rw [← Category.assoc, fibMap_fstV f V g hg y hy μ hμ]

set_option backward.isDefEq.respectTransparency false in
/-- The fibre embedding followed by `ℙᴺ_Y ⟶ ℙᴺ_V` is the inclusion of the fibre into `f⁻¹(V)`
followed by `i`. -/
private theorem familyEmbedding_comp (hi : i ≫ pullback.fst _ _ = f ∣_ V) {Y : Scheme.{u}}
    (y : Y ⟶ S) (hy : Set.range y ⊆ V) (w : Y ⟶ V) (hw : w ≫ V.ι = y) :
    familyEmbedding f V i y hy ≫ projectiveSpaceOverMap N w = fstV f V y hy ≫ i := by
  apply pullback.hom_ext
  · rw [Category.assoc, projectiveSpaceOverMap_fst, Category.assoc, hi]
    simp only [familyEmbedding, pullback.lift_fst_assoc]
    rw [← cancel_mono V.ι, Category.assoc, Category.assoc, morphismRestrict_ι, hw,
      ← Category.assoc, fstV_ι, pullback.condition]
  · rw [Category.assoc]
    erw [projectiveSpaceOverMap_snd]
    simp only [familyEmbedding, pullback.lift_snd, Category.assoc]

/-- Over a closed point `y` of `V`, the fibre embedding is a closed immersion. -/
private theorem isClosedImmersion_familyEmbedding [IsAffine V] [IsClosedImmersion i]
    (hi : i ≫ pullback.fst _ _ = f ∣_ V) {Y : Scheme.{u}} [IsAffine Y]
    (y : Y ⟶ S) [IsClosedImmersion y] (hy : Set.range y ⊆ V) (w : Y ⟶ V) (hw : w ≫ V.ι = y) :
    IsClosedImmersion (familyEmbedding f V i y hy) := by
  haveI := isClosedImmersion_fstV f V y hy
  haveI : IsClosedImmersion (familyEmbedding f V i y hy ≫ projectiveSpaceOverMap N w) := by
    rw [familyEmbedding_comp f V i hi y hy w hw]
    infer_instance
  haveI : IsAffineHom (projectiveSpaceOverMap N w) :=
    ProjectiveQuot.isAffineHom_projectiveSpaceOverMap w
  exact IsClosedImmersion.of_comp _ (projectiveSpaceOverMap N w)

/-- The pull-back of `H_V` to the fibre `X_s` over a point `s ∈ V`. -/
private noncomputable abbrev fibreModule (HV : (f ⁻¹ᵁ V).toScheme.Modules) {s : S} (hs : s ∈ V) :
    (pullback f (S.fromSpecResidueField s)).Modules :=
  (Scheme.Modules.pullback (fstV f V _ (range_fromSpecResidueField_subset V hs))).obj HV

/-- **The bounded families, for `1 ≤ r`, through `Quot`** (Stacks 0DPA). For `L` on a closed
fibre `X_s` with `L ⊗ H_V^{⊗ m}` generated by `r` sections, the sections embed
`L ⊗ H_V^{⊗ m}` as a quotient of `𝒪^{⊕ r}` on `ℙᴺ_{κ(s)}`, a point of `Z_P` for its Hilbert
polynomial `P`; with `V`'s point `s` it is a `κ(s)`-point of `Z_P ×_ℤ V`, and the universal
quotient restricted along the family embedding has fibre `L ⊗ H_V^{⊗ m}` there. -/
private theorem exists_fpFamilies_of_pos [LocallyOfFiniteType f] [IsLocallyNoetherian S]
    (hV : IsAffineOpen V) [IsClosedImmersion i] (hi : i ≫ pullback.fst _ _ = f ∣_ V)
    (HV : (f ⁻¹ᵁ V).toScheme.Modules) [IsInvertibleModule _ HV] (m : ℤ) (r : ℕ) (hr : 1 ≤ r) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (g : ∀ j, T j ⟶ S)
      (_ : ∀ j, Set.range (g j) ⊆ V) (_ : ∀ j, QuasiCompact (g j))
      (_ : ∀ j, LocallyOfFiniteType (g j))
      (𝒢 : ∀ j, (pullback f (g j)).Modules) (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (s : S) (hs : s ∈ V), IsClosed ({s} : Set S) →
        ∀ (L : (pullback f (S.fromSpecResidueField s)).Modules) [IsInvertibleModule _ L],
        IsGeneratedTwist (fibreModule f V HV hs) m r L →
        ∃ (j : J) (μ : Spec (S.residueField s) ⟶ T j)
          (hμ : μ ≫ g j = S.fromSpecResidueField s),
          Nonempty ((Scheme.Modules.pullback (fibMap f (g j) _ μ hμ)).obj (𝒢 j) ≅
            twist (fibreModule f V HV hs) m L) := by
  choose Z hZ hE using fun P : ULift.{u} (Polynomial ℚ) =>
    ProjectiveQuot.exists_isProper_iso_hilbertFunctor.{u} N r hr P.down
  let E := fun P => (hE P).some
  let T := fun P => pullback (terminal.from (Z P)) (terminal.from V.toScheme)
  let g : ∀ P, T P ⟶ S := fun P => pullback.snd _ _ ≫ V.ι
  have hg : ∀ P, Set.range (g P) ⊆ V := fun P =>
    range_comp_subset _ _ (by rw [Scheme.Opens.range_ι])
  let U := fun P => (E P).inv.app (Opposite.op (T P))
    (ULift.up (pullback.fst _ _) : ULift.{u + 1} (T P ⟶ Z P))
  haveI : Countable (Polynomial ℚ) := Function.Injective.countable Polynomial.toFinsupp_injective
  refine ⟨ULift.{u} (Polynomial ℚ), inferInstance, T, g, hg, fun P => haveI := hZ P; inferInstance,
    fun P => haveI := hZ P; inferInstance,
    fun P => (Scheme.Modules.pullback (familyEmbedding f V i (g P) (hg P))).obj (quotient (U P).1),
    fun P => Stacks.Modules.isFinitePresentation_pullback _ _ (U P).2.1.1,
    fun s hs hsc L _ hgen => ?_⟩
  obtain ⟨σ, hfin, hcard⟩ := hgen
  have hy := range_fromSpecResidueField_subset V hs
  haveI : IsClosedImmersion (S.fromSpecResidueField s) :=
    isClosed_singleton_iff_isClosedImmersion.mp hsc
  haveI : IsAffine V := hV
  let w : Spec (S.residueField s) ⟶ V :=
    IsOpenImmersion.lift V.ι (S.fromSpecResidueField s) (by rwa [Scheme.Opens.range_ι])
  have hw : w ≫ V.ι = S.fromSpecResidueField s := IsOpenImmersion.lift_fac _ _ _
  let ιF := familyEmbedding f V i (S.fromSpecResidueField s) hy
  haveI : IsClosedImmersion ιF :=
    isClosedImmersion_familyEmbedding f V i hi (S.fromSpecResidueField s) hy w hw
  haveI : IsLocallyNoetherian (pullback f (S.fromSpecResidueField s)) :=
    LocallyOfFiniteType.isLocallyNoetherian (pullback.snd f (S.fromSpecResidueField s))
  let A := fibreModule f V HV hs
  haveI := isInvertibleModule_twist A m L
  haveI := Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule (twist A m L)
  haveI := Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule (twist A m L)
  haveI : (twist A m L).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType _
  obtain ⟨K, hKfp, ⟨eK⟩⟩ :=
    exists_subobject_quotient_iso (S.residueField s) ιF (twist A m L) σ hcard
  obtain ⟨P, hK⟩ := exists_mem_hilbertFamilies (S.residueField s) K
  let zK : Spec (S.residueField s) ⟶ Z ⟨P⟩ :=
    ((E ⟨P⟩).hom.app (Opposite.op (Spec (S.residueField s))) ⟨K, hK⟩).down
  let μ : Spec (S.residueField s) ⟶ T ⟨P⟩ := pullback.lift zK w (terminal.hom_ext _ _)
  have hμ : μ ≫ g ⟨P⟩ = S.fromSpecResidueField s := by
    simp only [μ, g, pullback.lift_snd_assoc, hw]
  have hU : baseChange μ (U ⟨P⟩).1 = K := by
    have h := NatTrans.naturality_apply (E ⟨P⟩).inv μ.op
      (ULift.up (pullback.fst (terminal.from (Z ⟨P⟩)) (terminal.from V.toScheme)) :
        ULift.{u + 1} (T ⟨P⟩ ⟶ Z ⟨P⟩))
    have h2 : (yoneda.obj (Z ⟨P⟩) ⋙ uliftFunctor.{u + 1}).map μ.op
        (ULift.up (pullback.fst (terminal.from (Z ⟨P⟩)) (terminal.from V.toScheme)) :
          ULift.{u + 1} (T ⟨P⟩ ⟶ Z ⟨P⟩)) =
          (E ⟨P⟩).hom.app (Opposite.op (Spec (S.residueField s))) ⟨K, hK⟩ := by
      apply ULift.ext
      exact pullback.lift_fst (f := terminal.from (Z ⟨P⟩)) (g := terminal.from V.toScheme)
        zK w (terminal.hom_ext _ _)
    have h3 : (E ⟨P⟩).inv.app (Opposite.op (Spec (S.residueField s)))
        ((E ⟨P⟩).hom.app (Opposite.op (Spec (S.residueField s))) ⟨K, hK⟩) = ⟨K, hK⟩ :=
      Iso.hom_inv_id_apply ((E ⟨P⟩).app (Opposite.op (Spec (S.residueField s)))) _
    rw [h2] at h
    exact (congrArg Subtype.val (h3.symm.trans h)).symm
  haveI := Stacks.ClosedImmersion.full_pushforward ιF
  haveI := Stacks.ClosedImmersion.faithful_pushforward ιF
  haveI : IsIso (Scheme.Modules.pullbackPushforwardAdjunction ιF).counit :=
    Adjunction.counit_isIso_of_R_fully_faithful _
  refine ⟨⟨P⟩, μ, hμ, ⟨?_⟩⟩
  exact (Scheme.Modules.pullbackComp _ _).app _ ≪≫
    (Scheme.Modules.pullbackCongr
      (fibMap_familyEmbedding f V i (g ⟨P⟩) (hg ⟨P⟩) _ hy μ hμ)).app _ ≪≫
    ((Scheme.Modules.pullbackComp _ _).app _).symm ≪≫
    (Scheme.Modules.pullback ιF).mapIso ((quotientBaseChangeIso μ (U ⟨P⟩).1).symm ≪≫
      eqToIso (by rw [hU]) ≪≫ eK) ≪≫
    asIso ((Scheme.Modules.pullbackPushforwardAdjunction ιF).counit.app _)

/-- **The bounded families, for `r = 0`**: a module generated by no sections is zero, and the
zero module over `V` is the family. -/
private theorem exists_fpFamilies_zero [IsLocallyNoetherian S]
    (HV : (f ⁻¹ᵁ V).toScheme.Modules) [IsInvertibleModule _ HV] (m : ℤ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (g : ∀ j, T j ⟶ S)
      (_ : ∀ j, Set.range (g j) ⊆ V) (_ : ∀ j, QuasiCompact (g j))
      (_ : ∀ j, LocallyOfFiniteType (g j))
      (𝒢 : ∀ j, (pullback f (g j)).Modules) (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (s : S) (hs : s ∈ V), IsClosed ({s} : Set S) →
        ∀ (L : (pullback f (S.fromSpecResidueField s)).Modules) [IsInvertibleModule _ L],
        IsGeneratedTwist (fibreModule f V HV hs) m 0 L →
        ∃ (j : J) (μ : Spec (S.residueField s) ⟶ T j)
          (hμ : μ ≫ g j = S.fromSpecResidueField s),
          Nonempty ((Scheme.Modules.pullback (fibMap f (g j) _ μ hμ)).obj (𝒢 j) ≅
            twist (fibreModule f V HV hs) m L) := by
  refine ⟨PUnit, inferInstance, fun _ => V.toScheme, fun _ => V.ι,
    fun _ => by rw [Scheme.Opens.range_ι], fun _ => inferInstance, fun _ => inferInstance,
    fun _ => SheafOfModules.free PEmpty,
    fun _ => Stacks.AlgebraicGeometry.ModuleLimits.isFinitePresentation_free_of_finite _ PEmpty,
    fun s hs _ L _ hgen => ?_⟩
  obtain ⟨σ, hfin, hcard⟩ := hgen
  haveI : IsEmpty σ.I := Finite.card_eq_zero_iff.mp hcard
  have h0 : ∀ Y : Scheme.{u}, IsZero (SheafOfModules.free (R := Y.ringCatSheaf) PEmpty.{u + 1}) :=
    fun _ => Stacks.AlgebraicGeometry.HigherDirectImage.isZero_free_pempty
  have hy := range_fromSpecResidueField_subset V hs
  refine ⟨PUnit.unit, IsOpenImmersion.lift V.ι (S.fromSpecResidueField s)
    (by rwa [Scheme.Opens.range_ι]), IsOpenImmersion.lift_fac _ _ _, ⟨IsZero.iso ?_ ?_⟩⟩
  · exact (h0 _).of_iso (SheafOfModules.pullbackObjFreeIso _ PEmpty)
  · exact @IsZero.of_epi _ _ _ _ _ σ.π (SheafOfModules.GeneratingSections.epi σ) ((h0 _).of_iso
      (Sigma.whiskerEquiv (f := fun _ : σ.I => SheafOfModules.unit _)
        (g := fun _ : PEmpty.{u + 1} => SheafOfModules.unit _)
        (Equiv.equivPEmpty σ.I) fun _ => Iso.refl _))

/-- **The bounded families for one twist `(m, r)`.** -/
private theorem exists_fpFamilies [LocallyOfFiniteType f] [IsLocallyNoetherian S]
    (hV : IsAffineOpen V) [IsClosedImmersion i] (hi : i ≫ pullback.fst _ _ = f ∣_ V)
    (HV : (f ⁻¹ᵁ V).toScheme.Modules) [IsInvertibleModule _ HV] (m : ℤ) (r : ℕ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (g : ∀ j, T j ⟶ S)
      (_ : ∀ j, Set.range (g j) ⊆ V) (_ : ∀ j, QuasiCompact (g j))
      (_ : ∀ j, LocallyOfFiniteType (g j))
      (𝒢 : ∀ j, (pullback f (g j)).Modules) (_ : ∀ j, SheafOfModules.IsFinitePresentation (𝒢 j)),
      ∀ (s : S) (hs : s ∈ V), IsClosed ({s} : Set S) →
        ∀ (L : (pullback f (S.fromSpecResidueField s)).Modules) [IsInvertibleModule _ L],
        IsGeneratedTwist (fibreModule f V HV hs) m r L →
        ∃ (j : J) (μ : Spec (S.residueField s) ⟶ T j)
          (hμ : μ ≫ g j = S.fromSpecResidueField s),
          Nonempty ((Scheme.Modules.pullback (fibMap f (g j) _ μ hμ)).obj (𝒢 j) ≅
            twist (fibreModule f V HV hs) m L) := by
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact exists_fpFamilies_zero f V HV m
  · exact exists_fpFamilies_of_pos f V i hV hi HV m r hr

/-- **The families of line bundles for one twist `(m, r)`**: the bounded families of
`exists_fpFamilies`, flattened, restricted to their invertible loci and untwisted. -/
private theorem exists_families_of_isGeneratedTwist [IsProper f] [IsLocallyNoetherian S]
    (hV : IsAffineOpen V) [IsClosedImmersion i] (hi : i ≫ pullback.fst _ _ = f ∣_ V)
    (HV : (f ⁻¹ᵁ V).toScheme.Modules) [IsInvertibleModule _ HV] (m : ℤ) (r : ℕ) :
    ∃ (J : Type u) (_ : Countable J) (T : J → Scheme.{u}) (g : ∀ j, T j ⟶ S)
      (_ : ∀ j, QuasiCompact (g j)) (_ : ∀ j, LocallyOfFiniteType (g j))
      (𝓛 : ∀ j, (pullback f (g j)).Modules) (_ : ∀ j, IsLineBundle (𝓛 j)),
      ∀ (s : S) (hs : s ∈ V), IsClosed ({s} : Set S) →
        ∀ (L : (pullback f (S.fromSpecResidueField s)).Modules) [IsInvertibleModule _ L],
        IsGeneratedTwist (fibreModule f V HV hs) m r L →
        ∃ (j : J) (μ : Spec (S.residueField s) ⟶ T j)
          (hμ : μ ≫ g j = S.fromSpecResidueField s),
          Nonempty (L ≅ (Scheme.Modules.pullback (fibMap f (g j) _ μ hμ)).obj (𝓛 j)) := by
  obtain ⟨J, hJ, T₀, g₀, hg₀, hqc, hlft, 𝒢₀, hfp, hcov⟩ := exists_fpFamilies f V i hV hi HV m r
  choose T q hqc' hlft' 𝒢 hfp' hflat hfac using fun j =>
    haveI := hlft j; haveI := hfp j
    haveI : IsLocallyNoetherian (T₀ j) := LocallyOfFiniteType.isLocallyNoetherian (g₀ j)
    exists_flattening f (g₀ j) (𝒢₀ j)
  choose U jU hjU hU hUpt using fun j =>
    haveI := hlft j; haveI := hlft' j; haveI := hfp' j
    haveI : IsLocallyNoetherian (T j) := LocallyOfFiniteType.isLocallyNoetherian (q j ≫ g₀ j)
    exists_isLineBundle_of_isFlatOver f (q j ≫ g₀ j) (𝒢 j) (hflat j)
  choose 𝓛 h𝓛 h𝓛fib using fun j => exists_untwist f V HV m (jU j ≫ q j ≫ g₀ j)
    (range_comp_subset _ _ (range_comp_subset _ _ (hg₀ j))) _ (hU j)
  refine ⟨J, hJ, U, fun j => jU j ≫ q j ≫ g₀ j,
    fun j => haveI := hqc j; haveI := hqc' j; haveI := hjU j; haveI := hlft j; haveI := hlft' j
      haveI : IsLocallyNoetherian (T j) := LocallyOfFiniteType.isLocallyNoetherian (q j ≫ g₀ j)
      inferInstance,
    fun j => haveI := hlft j; haveI := hlft' j; haveI := hjU j; inferInstance,
    𝓛, h𝓛, fun s hs hsc L _ hgen => ?_⟩
  obtain ⟨j, μ, hμ, ⟨e⟩⟩ := hcov s hs hsc L hgen
  obtain ⟨μ', hμ', -, ⟨e'⟩⟩ := hfac j (S.residueField s) _ μ hμ
  have hinv : IsLineBundle ((Scheme.Modules.pullback (fibMap f (q j ≫ g₀ j) _ μ' hμ')).obj (𝒢 j)) :=
    haveI := isInvertibleModule_twist (fibreModule f V HV hs) m L
    isLineBundle_of_iso (e' ≪≫ e).symm (isLineBundle_of_isInvertibleModule _)
  obtain ⟨μ'', rfl⟩ := hUpt j _ μ' hμ' hinv
  have h'' : μ'' ≫ jU j ≫ q j ≫ g₀ j = S.fromSpecResidueField s := by
    rw [← Category.assoc, hμ']
  refine ⟨j, μ'', h'', h𝓛fib j _ (range_fromSpecResidueField_subset V hs) μ'' h'' L ⟨?_⟩⟩
  exact (Scheme.Modules.pullbackComp _ _).app (𝒢 j) ≪≫
    (Scheme.Modules.pullbackCongr (fibMap_comp_map f (q j ≫ g₀ j) (jU j) _ μ'' h'')).app (𝒢 j) ≪≫
    e' ≪≫ e

end Embedded

/-! ### Assembly -/

/-- **Ampleness over an affine open gives a closed embedding** (Stacks 01VS). If `f` is proper
and `H` is ample on `f⁻¹(V)` for an affine open `V`, a power of `H` embeds `f⁻¹(V)` into some
`ℙᴺ_V` over `V`; the immersion is closed since `f⁻¹(V)` is proper over `V`. -/
private theorem exists_closedImmersion {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f]
    (V : S.Opens) (hV : IsAffineOpen V) (H : X.Modules) [IsInvertibleModule X H]
    (hamp : IsAmple (f ⁻¹ᵁ V).toScheme ((Scheme.Modules.pullback (f ⁻¹ᵁ V).ι).obj H)) :
    ∃ (N : ℕ) (i : (f ⁻¹ᵁ V).toScheme ⟶ projectiveSpaceOver N V), IsClosedImmersion i ∧
      i ≫ pullback.fst _ _ = f ∣_ V := by
  haveI : IsAffine V := hV
  obtain ⟨d, -, N, i, hi, hif, -⟩ :=
    ((Stacks.AmpleRelativeFiniteType.tfae_six (f ∣_ V) _).out 1 5).1 hamp
  haveI := hi
  haveI : UniversallyClosed (i ≫ pullback.fst _ _) := by
    rw [hif]
    infer_instance
  haveI := UniversallyClosed.of_comp_of_isSeparated i
    (pullback.fst (terminal.from V.toScheme) (terminal.from (projectiveSpaceAtUniverse.{u} N)))
  exact ⟨N, i, .of_isPreimmersion i i.isClosedMap.isClosed_range, hif⟩

/-- **The families over one affine open `V` of the base** with `H` ample on `f⁻¹(V)`. Every
invertible `L` on a closed fibre over `V` has some generated twist `L ⊗ H^{⊗ m}`, since `H` is
ample on the fibre, a closed subscheme of `f⁻¹(V)` (Stacks 01PU, 01Q3). -/
private theorem exists_families_piece {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f]
    [IsLocallyNoetherian S] (V : S.Opens) (hV : IsAffineOpen V) (H : X.Modules)
    [IsInvertibleModule X H]
    (hamp : IsAmple (f ⁻¹ᵁ V).toScheme ((Scheme.Modules.pullback (f ⁻¹ᵁ V).ι).obj H)) :
    ∃ (J : Type u) (_ : Countable J) (M : J → Scheme.{u}) (g : ∀ j, M j ⟶ S)
      (_ : ∀ j, LocallyOfFiniteType (g j)) (_ : ∀ j, QuasiCompact (g j))
      (U : ∀ j, (pullback f (g j)).Modules) (_ : ∀ j, IsInvertibleModule _ (U j)),
      ∀ s : S, s ∈ V → IsClosed ({s} : Set S) →
      ∀ (L : (pullback f (S.fromSpecResidueField s)).Modules), IsInvertibleModule _ L →
        ∃ (j : J) (μ : Spec (S.residueField s) ⟶ M j)
          (hμ : μ ≫ g j = S.fromSpecResidueField s),
          Nonempty ((Scheme.Modules.pullback (fibMap f (g j) _ μ hμ)).obj (U j) ≅ L) := by
  obtain ⟨N, i, hi_ci, hi⟩ := exists_closedImmersion f V hV H hamp
  haveI := hi_ci
  let HV := (Scheme.Modules.pullback (f ⁻¹ᵁ V).ι).obj H
  choose J hJ T g hqc hlft 𝓛 h𝓛 hcov using fun d : ULift.{u} (ℤ × ℕ) =>
    exists_families_of_isGeneratedTwist f V i hV hi HV d.down.1 d.down.2
  haveI : ∀ d, Countable (J d) := hJ
  refine ⟨Σ d, J d, inferInstance, fun x => T x.1 x.2, fun x => g x.1 x.2,
    fun x => hlft x.1 x.2, fun x => hqc x.1 x.2, fun x => 𝓛 x.1 x.2,
    fun x => isInvertibleModule_of_isLineBundle _ (h𝓛 x.1 x.2), fun s hs hsc L hL => ?_⟩
  haveI := hL
  have hy := range_fromSpecResidueField_subset V hs
  haveI : IsClosedImmersion (S.fromSpecResidueField s) :=
    isClosed_singleton_iff_isClosedImmersion.mp hsc
  haveI := isClosedImmersion_fstV f V _ hy
  have hA : IsAmple _ (fibreModule f V HV hs) :=
    Stacks.AmplePullback.isAmple_modulePullback_of_isClosedImmersion (fstV f V _ hy) HV hamp
  obtain ⟨m, r, hgen⟩ := exists_isGeneratedTwist _ hA L
  obtain ⟨j, μ, hμ, ⟨e⟩⟩ := hcov ⟨(m, r)⟩ s hs hsc L hgen
  exact ⟨⟨⟨(m, r)⟩, j⟩, μ, hμ, ⟨e.symm⟩⟩

end Relative

/-- **Countably many finite-type families contain every line bundle on every closed fibre.**
Let `f : 𝒳 ⟶ S` be flat and projective, with `S` of finite type over `ℂ`, and let `H` be an
`f`-ample invertible sheaf. There are a countable index type `ι`, finite-type `S`-schemes
`g i : M i ⟶ S` and invertible sheaves `U i` on `𝒳 ×_S M i` such that for every closed point `s`
of `S` and every invertible sheaf `L` on the fibre `f.fiber s`, some `i` and some point
`μ : Spec κ(s) ⟶ M i` over `s` have the pull-back of `U i` to `f.fiber s ≅ 𝒳_s × {μ}`
isomorphic to `L`. -/
@[mmp "lem_mmp_foundation_relative_countable_line_bundle_families"]
public theorem exists_countable_families_isInvertibleModule_fiber_iso
    {𝒳 S : Scheme.{0}} (f : 𝒳 ⟶ S) [Flat f] (hf : IsProjective f)
    (sS : S ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sS] [QuasiCompact sS]
    (H : 𝒳.Modules) [Stacks.Ample.IsInvertibleModule 𝒳 H] (hH : MMP.Mori.IsRelativelyAmple f H) :
    ∃ (ι : Type) (_ : Countable ι) (M : ι → Scheme.{0}) (g : ∀ i, M i ⟶ S)
      (_ : ∀ i, LocallyOfFiniteType (g i)) (_ : ∀ i, QuasiCompact (g i))
      (U : ∀ i, (pullback f (g i)).Modules)
      (_ : ∀ i, Stacks.Ample.IsInvertibleModule (pullback f (g i)) (U i)),
      ∀ s : S, IsClosed ({s} : Set S) →
      ∀ (L : (f.fiber s).Modules), Stacks.Ample.IsInvertibleModule (f.fiber s) L →
        ∃ (i : ι) (μ : Spec (S.residueField s) ⟶ M i)
          (hμ : μ ≫ g i = S.fromSpecResidueField s),
          Nonempty ((modulePullback (pullback.lift (f.fiberι s)
            (f.fiberToSpecResidueField s ≫ μ)
            (by rw [Category.assoc, hμ, Scheme.Hom.fiber_fac]) :
              f.fiber s ⟶ pullback f (g i)).toLRSHom.toShHom).obj (U i) ≅ L) := by
  haveI : IsProper f := hf.isProper
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS
  haveI : CompactSpace S := QuasiCompact.compactSpace_of_compactSpace sS
  choose V hVaff hyV hamp using hH
  choose J hJ M g hlft hqc U hU hcov using fun y : S =>
    Relative.exists_families_piece f (V y) (hVaff y) H (hamp y)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun y => (V y : Set S))
    (fun y => (V y).isOpen) (fun y _ => Set.mem_iUnion.2 ⟨y, hyV y⟩)
  haveI : ∀ c, Countable (J c) := hJ
  refine ⟨Σ c : t, J c, inferInstance, fun x => M x.1 x.2, fun x => g x.1 x.2,
    fun x => hlft _ _, fun x => hqc _ _, fun x => U _ _, fun x => hU _ _, fun s hsc L hL => ?_⟩
  haveI := hL
  obtain ⟨c, hc, hsc'⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ s))
  obtain ⟨j, μ, hμ, e⟩ := hcov c s hsc' hsc L hL
  exact ⟨⟨⟨c, hc⟩, j⟩, μ, hμ, e⟩

end MMP
