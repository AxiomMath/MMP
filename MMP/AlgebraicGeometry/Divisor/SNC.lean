module

public import MMP.Attr
public import MMP.AlgebraicGeometry.Divisor.Basic
public import Mathlib.RingTheory.RegularLocalRing.Defs
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic
public import StacksFrontier.AlgebraicGeometry.Variety.Smooth.RegularStalk

/-!
# Simple normal crossing divisors

Let `X` be a smooth separated scheme of finite type over a field `k`, and let `D = ∑ dᵢ Dᵢ` be
an `ℝ`-divisor on `X`, the `Dᵢ` distinct prime divisors and all `dᵢ ≠ 0`. Then `D` is a
*simple normal crossing* (*snc*) divisor if every `Dᵢ` is smooth and the `Dᵢ` meet
transversally: for every point `x ∈ X` there are a regular system of parameters `z₁, …, zₙ` of
`𝒪_{X,x}` and an injective map `j` from `{i : x ∈ Dᵢ}` to `{1, …, n}` such that, for each `i`
with `x ∈ Dᵢ`, the ideal of `Dᵢ` in `𝒪_{X,x}` is generated by `z_{j(i)}`.

A *regular system of parameters* of a local ring `(A, 𝔪)` is a family of `dim A` elements
generating `𝔪`.

## Main definitions

* `MMP.Mori.IsRegularSystemOfParameters`: a regular system of parameters of a local ring.
* `MMP.Mori.DivisorWithCoeffs.IsSNC`: simple normal crossing divisors.

## Main results

* `MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters`: a Noetherian local ring with a
  regular system of parameters is regular, and
  `MMP.Mori.exists_isRegularSystemOfParameters`: a regular local ring has one.
* `MMP.Mori.DivisorWithCoeffs.isSNC_iff_of_support_eq`: being snc depends only on the prime
  divisors with nonzero coefficient; `MMP.Mori.DivisorWithCoeffs.IsSNC.of_support_subset`: it
  passes to divisors whose components are among those of an snc divisor;
  `MMP.Mori.DivisorWithCoeffs.IsSNC.mapCoeffs` and
  `MMP.Mori.DivisorWithCoeffs.isSNC_mapCoeffs_iff` for changing coefficients.
* `MMP.Mori.DivisorWithCoeffs.isSNC_zero`: on a scheme smooth over a field the zero divisor
  is snc.

## Implementation notes

The definition is stated for a divisor with coefficients in any `R` with a zero, and for a
scheme `X` over an arbitrary base `Y`: the components are asked to be smooth over `Y`. The
standing hypotheses of the source (`X` smooth, separated and of finite type over a field) are
not part of the definition. Indexing the components by the prime divisors with nonzero
coefficient, the finite support of `D`, is the source's indexing by the `Dᵢ` with `dᵢ ≠ 0`.

The ideal of a prime divisor `E` in `𝒪_{X,x}` is the stalk at `x` of its ideal sheaf,
`AlgebraicGeometry.IdealSheafData.stalk`. A component `E` is smooth when the integral closed
subscheme it is presented by is smooth over the base, in the sense of
`MMP.Mori.IsSmoothScheme`.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], Notation 0.4(8)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry IsLocalRing

universe u

namespace MMP.Mori

section RegularSystemOfParameters

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- A *regular system of parameters* of a local ring `(A, 𝔪)`: a family `z₁, …, zₙ` of
`n = dim A` elements generating the maximal ideal `𝔪`. -/
def IsRegularSystemOfParameters {n : ℕ} (z : Fin n → A) : Prop :=
  Ideal.span (Set.range z) = maximalIdeal A ∧ ringKrullDim A = n

/-- A family `z` is a regular system of parameters of `A` if and only if it generates the
maximal ideal and its length is the Krull dimension of `A`. -/
theorem isRegularSystemOfParameters_iff {n : ℕ} (z : Fin n → A) :
    IsRegularSystemOfParameters z ↔
      Ideal.span (Set.range z) = maximalIdeal A ∧ ringKrullDim A = n :=
  Iff.rfl

/-- A Noetherian local ring with a regular system of parameters is a regular local ring. -/
theorem isRegularLocalRing_of_isRegularSystemOfParameters [IsNoetherianRing A] {n : ℕ}
    {z : Fin n → A} (hz : IsRegularSystemOfParameters z) : IsRegularLocalRing A := by
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le A ?_
  classical
  rw [← hz.1, hz.2]
  have h := Submodule.spanFinrank_span_le_ncard_of_finite (R := A) (Set.finite_range z)
  have h' : (Set.range z).ncard ≤ n := by
    rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
    exact Finset.card_image_le.trans (by simp)
  exact_mod_cast h.trans h'

end RegularSystemOfParameters

/-- A regular local ring has a regular system of parameters. -/
theorem exists_isRegularSystemOfParameters (A : Type*) [CommRing A] [IsRegularLocalRing A] :
    ∃ (n : ℕ) (z : Fin n → A), IsRegularSystemOfParameters z := by
  obtain ⟨s, hs, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (Ideal.fg_of_isNoetherianRing (maximalIdeal A))
  refine ⟨s.card, fun i => (s.equivFin.symm i : A), ?_, ?_⟩
  · have : Set.range (fun i => (s.equivFin.symm i : A)) = s := by
      ext a
      simp only [Set.mem_range, Finset.mem_coe]
      exact ⟨fun ⟨i, hi⟩ => hi ▸ (s.equivFin.symm i).2,
        fun ha => ⟨s.equivFin ⟨a, ha⟩, by simp⟩⟩
    rw [this]
    exact hspan
  · rw [hs, IsRegularLocalRing.spanFinrank_maximalIdeal]

namespace DivisorWithCoeffs

variable {R S : Type*} [Zero R] [Zero S] {X Y : Scheme.{u}} (f : X ⟶ Y)

/-- A divisor `D = ∑ dᵢ Dᵢ` (the `Dᵢ` distinct, all `dᵢ ≠ 0`) on a scheme `X` over `Y` is a
*simple normal crossing* (*snc*) divisor if every `Dᵢ` is smooth over `Y` and the `Dᵢ` meet
transversally: for every point `x ∈ X` there are a regular system of parameters `z₁, …, zₙ` of
`𝒪_{X,x}` and an injective map `j` from `{i : x ∈ Dᵢ}` to `{1, …, n}` such that for each `i`
with `x ∈ Dᵢ` the ideal of `Dᵢ` in `𝒪_{X,x}` is generated by `z_{j(i)}`. -/
@[mmp "def_km0_snc_divisor"]
def IsSNC (D : DivisorWithCoeffs R X) : Prop :=
  (∀ E ∈ D.support, IsSmoothScheme (E.idealSheaf.subschemeι ≫ f)) ∧
    ∀ x : X, ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x)
      (j : {E : PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} → Fin n),
      IsRegularSystemOfParameters z ∧ Function.Injective j ∧
        ∀ E, IdealSheafData.stalk E.1.idealSheaf x = Ideal.span {z (j E)}

variable {f}

/-- Being snc passes to a divisor whose prime divisors with nonzero coefficient are among
those of an snc divisor. -/
theorem IsSNC.of_support_subset {D : DivisorWithCoeffs R X} {D' : DivisorWithCoeffs S X}
    (hD : D.IsSNC f) (h : D'.support ⊆ D.support) : D'.IsSNC f := by
  refine ⟨fun E hE => hD.1 E (h hE), fun x => ?_⟩
  obtain ⟨n, z, j, hz, hj, hI⟩ := hD.2 x
  exact ⟨n, z, fun E => j ⟨E.1, h E.2.1, E.2.2⟩, hz,
    fun _ _ hEE' => Subtype.ext (Subtype.mk.inj (hj hEE')), fun E => hI ⟨E.1, h E.2.1, E.2.2⟩⟩

/-- Being snc depends only on the prime divisors with nonzero coefficient. -/
theorem isSNC_iff_of_support_eq {D : DivisorWithCoeffs R X} {D' : DivisorWithCoeffs S X}
    (h : D.support = D'.support) : D.IsSNC f ↔ D'.IsSNC f :=
  ⟨fun hD => hD.of_support_subset h.ge, fun hD' => hD'.of_support_subset h.le⟩

/-- Changing the coefficients of an snc divisor gives an snc divisor. -/
theorem IsSNC.mapCoeffs {D : DivisorWithCoeffs R X} (hD : D.IsSNC f) (g : R → S)
    (hg : g 0 = 0) : (D.mapCoeffs g hg).IsSNC f :=
  hD.of_support_subset Finsupp.support_mapRange

/-- Along an injective change of coefficients, a divisor is snc if and only if its image is. -/
theorem isSNC_mapCoeffs_iff {D : DivisorWithCoeffs R X} {g : R → S} (hg : g 0 = 0)
    (hinj : Function.Injective g) : (D.mapCoeffs g hg).IsSNC f ↔ D.IsSNC f :=
  isSNC_iff_of_support_eq (Finsupp.support_mapRange_of_injective hg D hinj)

/-- On a scheme smooth over a field, the zero divisor is snc. -/
theorem isSNC_zero {k : Type u} [Field k] (f : X ⟶ Spec (.of k)) [Smooth f] :
    (0 : DivisorWithCoeffs R X).IsSNC f := by
  refine ⟨fun E hE => by simp at hE, fun x => ?_⟩
  have := isRegularLocalRing_stalk_of_smooth_over_field f x
  obtain ⟨n, z, hz⟩ := exists_isRegularSystemOfParameters (X.presheaf.stalk x)
  refine ⟨n, z, fun E => absurd E.2.1 (by simp), hz, fun E => absurd E.2.1 (by simp),
    fun E => absurd E.2.1 (by simp)⟩

/-- On a scheme `X` smooth over a field in the sense of `MMP.Mori.IsSmoothScheme`, the zero
divisor is snc. -/
theorem isSNC_zero_of_isSmoothScheme {k : Type u} [Field k] (f : X ⟶ Spec (.of k))
    [LocallyOfFinitePresentation f] (hf : IsSmoothScheme f) :
    (0 : DivisorWithCoeffs R X).IsSNC f :=
  have := (isSmoothScheme_iff f).mp hf
  isSNC_zero f

end DivisorWithCoeffs

end MMP.Mori
