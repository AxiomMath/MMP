module

public import MMP.AlgebraicGeometry.Divisor.SectionAlgebra
public import MMP.AlgebraicGeometry.MMP.Abundance.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProj.Charts.Descent

/-!
# The relative `Proj` of a divisorial algebra is birational to the base

Let `Y` be an irreducible, locally Noetherian, normal scheme and `D` a Weil divisor on `Y`. Over
an affine open `V` meeting no prime divisor of the support of `D`, every `𝒪_Y(nD)(V)` is
`𝒪_Y(V)`, so the graded ring `⨁_n 𝒪_Y(nD)(V)` is the polynomial ring `𝒪_Y(V)[t]` and
`Proj_V ⨁_n 𝒪_Y(nD) = V`. Hence the structure morphism `Proj_Y ⨁_n 𝒪_Y(nD) ⟶ Y` is an
isomorphism over a nonempty open, so it is birational.

## Main results

* `MMP.ProjectiveSpectrum.isIso_toSpecZero_of_forall_eq_mul_pow`: `Proj 𝒜 ⟶ Spec 𝒜₀` is an
  isomorphism when `𝒜` is generated over `𝒜₀` by one non-zero-divisor of degree one.
* `MMP.Mori.Divisor.exists_isAffineOpen_coeff_eq_zero`: a divisor on an irreducible scheme
  vanishes on some nonempty affine open.
* `MMP.Mori.Divisor.mem_divisorialSubmodule_nsmul_iff_of_isLocalEquation`: where `ψ` is a local
  equation of `D`, `𝒪_Y(nD) = ψ⁻ⁿ 𝒪_Y`.
* `MMP.Fourfold.DivisorialSectionAlgebra.isIso_projInclusionToOpen`: over such an open the
  relative `Proj` is the open itself.
* `MMP.Fourfold.DivisorialSectionAlgebra.isIso_projInclusionToOpen_of_isLocalEquation`,
  `MMP.Fourfold.DivisorialSectionAlgebra.isBiregular_toBase_of_isLocalEquation`: the same over any
  affine open on which `D` has a local equation; the structure morphism is an isomorphism over
  the open where `D` is Cartier.
* `MMP.Fourfold.DivisorialSectionAlgebra.isBirationalMorphism_toBase`: the structure morphism
  of the relative `Proj` is birational.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori1998], Lemma 6.2.
* [Stacks Project, Tag 01MI](https://stacks.math.columbia.edu/tag/01MI)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Opposite HomogeneousLocalization

universe u

namespace MMP.ProjectiveSpectrum

variable {A σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
  [GradedRing 𝒜]

/-- **`Proj` of a ring generated by one element of degree one.** If every homogeneous element
of degree `n` is `c sⁿ` for some `c` of degree zero, with `s` of degree one and `sⁿ c = 0`
only for `c = 0`, then `Proj 𝒜 ⟶ Spec 𝒜₀` is an isomorphism. -/
theorem isIso_toSpecZero_of_forall_eq_mul_pow (s : A) (hs : s ∈ 𝒜 1)
    (hgen : ∀ n, ∀ a ∈ 𝒜 n, ∃ c ∈ 𝒜 0, a = c * s ^ n)
    (hinj : ∀ c ∈ 𝒜 0, ∀ n : ℕ, s ^ n * c = 0 → c = 0) :
    IsIso (Proj.toSpecZero 𝒜) := by
  have hadj : Algebra.adjoin (𝒜 0) (Set.range fun _ : Unit => s) = ⊤ := by
    have key : ∀ x : A, x ∈ Algebra.adjoin (𝒜 0) (Set.range fun _ : Unit => s) := by
      intro x
      induction x using DirectSum.Decomposition.inductionOn 𝒜 with
      | zero => exact zero_mem _
      | homogeneous a =>
        obtain ⟨c, hc, hac⟩ := hgen _ a.1 a.2
        rw [hac]
        have hc' : c ∈ Algebra.adjoin (𝒜 0) (Set.range fun _ : Unit => s) :=
          Subalgebra.algebraMap_mem _ (Subtype.mk (p := (· ∈ 𝒜 0)) c hc)
        exact mul_mem hc' (pow_mem (Algebra.subset_adjoin (Set.mem_range_self ())) _)
      | add x y hx hy => exact add_mem hx hy
    exact eq_top_iff.mpr fun x _ => key x
  have htop : Proj.basicOpen 𝒜 s = ⊤ := by
    have h := Proj.iSup_basicOpen_eq_top' (𝒜 := 𝒜) (fun _ : Unit => s) (fun _ => ⟨1, hs⟩) hadj
    rw [← h]
    exact (iSup_unique (f := fun _ : Unit => Proj.basicOpen 𝒜 s)).symm
  haveI : IsIso (Proj.awayι 𝒜 s hs Nat.one_pos) := by
    apply isIso_of_isOpenImmersion_of_opensRange_eq_top
    rw [Proj.opensRange_awayι, htop]
  haveI : IsIso (CommRingCat.ofHom (fromZeroRingHom 𝒜 (Submonoid.powers s))) := by
    have hv : ∀ c : ↥(𝒜 0), (CommRingCat.ofHom (fromZeroRingHom 𝒜 (Submonoid.powers s)) c).val =
        Localization.mk (c : A) 1 := fun c => rfl
    refine (ConcreteCategory.isIso_iff_bijective _).mpr ⟨?_, fun x => ?_⟩
    · refine (injective_iff_map_eq_zero _).mpr fun c hc => ?_
      have hc' := congrArg HomogeneousLocalization.val hc
      rw [hv, HomogeneousLocalization.val_zero, Localization.mk_one_eq_algebraMap,
        IsLocalization.map_eq_zero_iff (Submonoid.powers s)] at hc'
      obtain ⟨⟨_, n, rfl⟩, hn⟩ := hc'
      exact Subtype.ext (hinj c.1 c.2 n hn)
    · obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective 𝒜 hs x
      obtain ⟨c, hc, hac⟩ := hgen _ a ha
      refine ⟨⟨c, hc⟩, HomogeneousLocalization.val_injective _ ?_⟩
      rw [hv, Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      simp only [smul_eq_mul, mul_one] at hac
      refine ⟨1, ?_⟩
      simp only [OneMemClass.coe_one, one_mul]
      rw [hac]
      ring
  have h : Proj.toSpecZero 𝒜 = CategoryTheory.inv (Proj.awayι 𝒜 s hs Nat.one_pos) ≫
      Spec.map (CommRingCat.ofHom (fromZeroRingHom 𝒜 (Submonoid.powers s))) := by
    rw [← Proj.awayι_toSpecZero 𝒜 s hs Nat.one_pos, IsIso.inv_hom_id_assoc]
  rw [h]
  infer_instance

end MMP.ProjectiveSpectrum

namespace MMP.Mori.Divisor

open Polynomial

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]

/-- Over an open `V` meeting no prime divisor of the support of `D`, a rational function is a
section of `𝒪_X(D)` over `V` if and only if it is a section of `𝒪_X` over `V`. -/
theorem isDivisorialSection_iff_of_coeff_eq_zero {D : Divisor X} {V : X.Opens}
    (h : ∀ E : PrimeDivisor X, (E.support ∩ V).Nonempty → D.coeff E = 0)
    (φ : ToType ((rationalFunctionsPresheaf X).obj (op V))) :
    D.IsDivisorialSection V φ ↔ (0 : Divisor X).IsDivisorialSection V φ := by
  refine forall_congr' fun E => forall_congr' fun hE => ?_
  rw [h E hE, DivisorWithCoeffs.coeff_zero]

/-- Over an open `V` meeting no prime divisor of the support of `D`, `𝒪_X(D)(V) = 𝒪_X(V)`. -/
theorem divisorialSubmodule_eq_one_of_coeff_eq_zero {D : Divisor X} {V : X.Opens}
    (h : ∀ E : PrimeDivisor X, (E.support ∩ V).Nonempty → D.coeff E = 0) :
    D.divisorialSubmodule V = 1 := by
  refine le_antisymm (fun φ hφ => divisorialSubmodule_zero_le_one V
    ((isDivisorialSection_iff_of_coeff_eq_zero h φ).1 hφ)) ?_
  rw [Submodule.one_eq_range]
  rintro _ ⟨r, rfl⟩
  exact (isDivisorialSection_iff_of_coeff_eq_zero h _).2 (isDivisorialSection_algebraMap le_rfl r)

/-- On an irreducible scheme, every divisor vanishes on some nonempty affine open: one avoiding
the finitely many prime divisors of its support. -/
theorem exists_isAffineOpen_coeff_eq_zero [IrreducibleSpace X] (D : Divisor X) :
    ∃ V : X.Opens, IsAffineOpen V ∧ (V : Set X).Nonempty ∧
      ∀ E : PrimeDivisor X, (E.support ∩ V).Nonempty → D.coeff E = 0 := by
  classical
  let W : Set X := ⋃ E ∈ D.support, (E.support : Set X)
  have hW : IsClosed W := D.support.finite_toSet.isClosed_biUnion fun E _ => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact isClosed_closure
  have hη : genericPoint X ∉ W := by
    intro hm
    obtain ⟨E, -, hE⟩ := Set.mem_iUnion₂.mp hm
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
    have hEq : E.genericPoint = genericPoint X :=
      (specializes_iff_mem_closure.mpr hE).antisymm
        ((genericPoint_spec X).specializes (Set.mem_univ _)) |>.eq
    have hc := E.coheight_genericPoint
    rw [hEq, ← Stacks.Divisors.PrimeDivisor.codimension_closureSingleton] at hc
    have htop : TopologicalSpace.IrreducibleCloseds.closureSingleton (genericPoint X) =
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩ :=
      TopologicalSpace.IrreducibleCloseds.ext (genericPoint_spec X).def
    rw [htop] at hc
    have h0 : codimension (⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩ :
        TopologicalSpace.IrreducibleCloseds X) = 0 :=
      Order.coheight_eq_zero.mpr fun b _ => fun x _ => Set.mem_univ x
    rw [h0] at hc
    exact absurd hc (by decide)
  obtain ⟨V, hV, hηV, hVW⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (U := ⟨Wᶜ, hW.isOpen_compl⟩) hη
  refine ⟨V, hV, ⟨_, hηV⟩, fun E hE => ?_⟩
  by_contra hne
  obtain ⟨x, hxE, hxV⟩ := hE
  exact hVW hxV (Set.mem_iUnion₂.mpr ⟨E, Finsupp.mem_support_iff.mpr hne, hxE⟩)

/-- The restriction `K(X) → 𝒦_X(V)` of a rational function to an open `V`: its components on the
irreducible components meeting `V`. -/
def rationalFunctionsRestrict (V : X.Opens) :
    RationalFunctions X →+* (rationalFunctionsPresheaf X).obj (op V) :=
  RingHom.pi fun Z => Pi.evalRingHom _ Z.1

/-- The component of `rationalFunctionsRestrict V φ` on an irreducible component `Z` meeting `V`
is the component of `φ` on `Z`. -/
@[simp]
theorem rationalFunctionsRestrict_apply (V : X.Opens) (φ : RationalFunctions X) (Z) :
    rationalFunctionsRestrict V φ Z = φ Z.1 := rfl

/-- **Sections of `𝒪_X(nD)` over an open where `D` has a local equation.** If `ψ` is a local
equation of `D` on `V`, then `𝒪_X(nD)(V) = ψ⁻ⁿ 𝒪_X(V)`. -/
theorem mem_divisorialSubmodule_nsmul_iff_of_isLocalEquation [CompactSpace X] {D : Divisor X}
    {V : X.Opens} {ψ : (RationalFunctions X)ˣ} (hψ : D.IsLocalEquation V ψ) (n : ℕ)
    (φ : ToType ((rationalFunctionsPresheaf X).obj (op V))) :
    φ ∈ ((n : ℤ) • D).divisorialSubmodule V ↔
      ∃ r : Γ(X, V), φ = rationalFunctionsRestrict V ((ψ⁻¹ : (RationalFunctions X)ˣ) : _) ^ n *
        algebraMap Γ(X, V) _ r := by
  set D₀ : Divisor X := (n : ℤ) • D - principalDivisor (ψ ^ n) with hD₀
  have h0 : ∀ E : PrimeDivisor X, (E.support ∩ V).Nonempty → D₀.coeff E = 0 := fun E hE => by
    rw [hD₀, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, coeff_principalDivisor,
      hψ E hE, PrimeDivisor.ord_pow, natCast_zsmul, sub_self]
  have hone : D₀.divisorialSubmodule V = 1 := divisorialSubmodule_eq_one_of_coeff_eq_zero h0
  have hinv : rationalFunctionsRestrict V ((ψ⁻¹ : (RationalFunctions X)ˣ) : _) ^ n *
      rationalFunctionsRestrict V ((ψ ^ n : (RationalFunctions X)ˣ) : _) = 1 := by
    rw [← map_pow, ← map_mul, ← Units.val_pow_eq_pow_val, ← Units.val_mul, inv_pow,
      inv_mul_cancel, Units.val_one, map_one]
  constructor
  · intro hφ
    have h : ∀ E : PrimeDivisor X, ((n : ℤ) • D).coeff E = D₀.coeff E + E.ord (ψ ^ n) :=
      fun E => by rw [hD₀, DivisorWithCoeffs.coeff_sub, coeff_principalDivisor, sub_add_cancel]
    have hy : rationalFunctionsRestrict V ((ψ ^ n : (RationalFunctions X)ˣ) : _) * φ ∈
        D₀.divisorialSubmodule V := (divisorialMulLinearMap (ψ ^ n) h V ⟨φ, hφ⟩).2
    rw [hone, Submodule.mem_one] at hy
    obtain ⟨r, hr⟩ := hy
    exact ⟨r, by rw [hr, ← mul_assoc, hinv, one_mul]⟩
  · rintro ⟨r, rfl⟩
    have h : ∀ E : PrimeDivisor X,
        D₀.coeff E = ((n : ℤ) • D).coeff E + E.ord ((ψ ^ n)⁻¹) := fun E => by
      rw [hD₀, DivisorWithCoeffs.coeff_sub, coeff_principalDivisor, PrimeDivisor.ord_inv,
        sub_eq_add_neg]
    have hr : algebraMap Γ(X, V) _ r ∈ D₀.divisorialSubmodule V :=
      hone ▸ Submodule.algebraMap_mem r
    convert (divisorialMulLinearMap ((ψ ^ n)⁻¹) h V ⟨_, hr⟩).2 using 1
    rw [← map_pow, ← Units.val_pow_eq_pow_val, inv_pow]
    rfl

end MMP.Mori.Divisor

namespace MMP.Fourfold.DivisorialSectionAlgebra

open MMP.Mori MMP.Mori.Divisor Polynomial Stacks.RelativeProj

variable {Y : Scheme.{u}} [IsLocallyNoetherian Y] [IsNormal Y] {D : Divisor Y}
  (A : DivisorialSectionAlgebra (𝟙 Y) D)

set_option backward.isDefEq.respectTransparency false in
/-- The degree-zero map `𝒪_Y(V) → (⨁_n 𝒪_Y(nD)(V))₀` of a divisorial section algebra along the
identity is injective. -/
theorem sectionRingZeroMap_injective (V : Y.Opens) :
    Function.Injective (Situation.sectionRingZeroMap A.situation V) := by
  intro r r' hrr'
  have hc := congrArg Subtype.val hrr'
  change (DirectSum.decompose (A.situation.sectionRingGrading V)
      (A.situation.sectionRingBaseMap V r) 0 : A.situation.sectionRing V) =
    DirectSum.decompose (A.situation.sectionRingGrading V)
      (A.situation.sectionRingBaseMap V r') 0 at hc
  rw [DirectSum.decompose_of_mem_same _ (Situation.sectionRingBaseMap_mem_zero A.situation V r),
    DirectSum.decompose_of_mem_same _ (Situation.sectionRingBaseMap_mem_zero A.situation V r')]
    at hc
  have := congrArg (A.toPolynomial V) hc
  rw [A.toPolynomial_sectionRingBaseMap, A.toPolynomial_sectionRingBaseMap, C_inj] at this
  exact toRationalFunctionsPresheaf_app_injective V this

set_option backward.isDefEq.respectTransparency false in
/-- If every degree-zero section over `V` is a regular function, the degree-zero map
`𝒪_Y(V) → (⨁_n 𝒪_Y(nD)(V))₀` is an isomorphism. -/
theorem isIso_sectionRingZeroMap_of_forall (V : Y.Opens)
    (h : ∀ x : A.situation.sectionPieces V 0, ∃ r : Γ(Y, V),
      (show ToType ((rationalFunctionsPresheaf Y).obj (op V)) from
        A.pieceToRationalFunctions V 0 x) = algebraMap Γ(Y, V) _ r) :
    IsIso (Situation.sectionRingZeroMap A.situation V) := by
  refine (ConcreteCategory.isIso_iff_bijective _).mpr
    ⟨A.sectionRingZeroMap_injective V, fun c => ?_⟩
  obtain ⟨_, x, rfl⟩ := c
  obtain ⟨r, hr⟩ := h x
  have hb : A.situation.sectionRingBaseMap V r = DirectSum.of _ 0 x := by
    apply A.toPolynomial_injective V
    rw [A.toPolynomial_of, A.toPolynomial_sectionRingBaseMap, monomial_zero_left]
    exact congrArg C hr.symm
  refine ⟨r, Subtype.ext ?_⟩
  change (DirectSum.decompose (A.situation.sectionRingGrading V)
      (A.situation.sectionRingBaseMap V r) 0 : A.situation.sectionRing V) = _
  rw [DirectSum.decompose_of_mem_same _ (Situation.sectionRingBaseMap_mem_zero A.situation V r),
    hb]

set_option backward.isDefEq.respectTransparency false in
/-- If the section ring over `V` is the polynomial ring `𝒪_Y(V)[w t]` on a degree-one section `t`
with `t = w X` for a unit `w`, then `Proj` of it is `Spec` of its degree-zero part. -/
theorem isIso_toSpecZero_of_toPolynomial_eq {V : Y.Opens} (t : A.situation.sectionPieces V 1)
    {w : (rationalFunctionsPresheaf Y).obj (op V)} (hw : IsUnit w)
    (ht : (A.toPolynomial V : A.situation.sectionRing V →+*
      ((rationalFunctionsPresheaf Y).obj (op V))[X]) (DirectSum.of _ 1 t) = C w * Polynomial.X)
    (hmem : ∀ (n : ℕ) (x : A.situation.sectionPieces V n), ∃ r : Γ(Y, V),
      (show ToType ((rationalFunctionsPresheaf Y).obj (op V)) from
        A.pieceToRationalFunctions V n x) = w ^ n * algebraMap Γ(Y, V) _ r) :
    IsIso (Proj.toSpecZero (A.situation.sectionRingGrading V)) := by
  let P : A.situation.sectionRing V →+* ((rationalFunctionsPresheaf Y).obj (op V))[X] :=
    A.toPolynomial V
  have hP (n : ℕ) (c : A.situation.sectionPieces V n) :
      P (DirectSum.of _ n c) = @monomial ((rationalFunctionsPresheaf Y).obj (op V)) _ n
        (A.pieceToRationalFunctions V n c) :=
    A.toPolynomial_of V n c
  have hPbase (r : Γ(Y, V)) :
      P (A.situation.sectionRingBaseMap V r) = C (algebraMap Γ(Y, V) _ r) :=
    A.toPolynomial_sectionRingBaseMap V r
  have hPinj : Function.Injective P := A.toPolynomial_injective V
  replace ht : P (DirectSum.of _ 1 t) = C w * Polynomial.X := ht
  refine MMP.ProjectiveSpectrum.isIso_toSpecZero_of_forall_eq_mul_pow _ _ ⟨t, rfl⟩ ?_ ?_
  · rintro n _ ⟨x, rfl⟩
    obtain ⟨r, hr⟩ := hmem n x
    refine ⟨A.situation.sectionRingBaseMap V r,
      Situation.sectionRingBaseMap_mem_zero A.situation V r, hPinj ?_⟩
    rw [hP, map_mul, map_pow, hPbase, ht, mul_pow, ← C_pow, ← mul_assoc, ← C_mul,
      C_mul_X_pow_eq_monomial]
    exact congrArg (monomial n) (hr.trans (_root_.mul_comm _ _))
  · intro c _ n hc
    apply hPinj
    have := congrArg P hc
    rw [map_mul, map_pow, ht, map_zero, mul_pow, ← C_pow, mul_assoc] at this
    rw [map_zero]
    exact (monic_X_pow n).mul_right_eq_zero_iff.mp (((hw.pow n).map C).mul_right_eq_zero.mp this)

/-- If the section ring over an affine open `V` is the polynomial ring `𝒪_Y(V)[w t]` on a
degree-one section `t` with `t = w X` for a unit `w`, then the relative `Proj` over `V` is `V`. -/
theorem isIso_projInclusionToOpen_of_toPolynomial_eq {V : Y.Opens} (hV : IsAffineOpen V)
    (t : A.situation.sectionPieces V 1) {w : (rationalFunctionsPresheaf Y).obj (op V)}
    (hw : IsUnit w) (ht : (A.toPolynomial V : A.situation.sectionRing V →+*
      ((rationalFunctionsPresheaf Y).obj (op V))[X]) (DirectSum.of _ 1 t) = C w * Polynomial.X)
    (hmem : ∀ (n : ℕ) (x : A.situation.sectionPieces V n), ∃ r : Γ(Y, V),
      (show ToType ((rationalFunctionsPresheaf Y).obj (op V)) from
        A.pieceToRationalFunctions V n x) = w ^ n * algebraMap Γ(Y, V) _ r) :
    IsIso (A.situation.projInclusionToOpen V hV) := by
  have := A.isIso_toSpecZero_of_toPolynomial_eq t hw ht hmem
  have := A.isIso_sectionRingZeroMap_of_forall V fun x =>
    (hmem 0 x).imp fun r hr => hr.trans (by rw [pow_zero, one_mul])
  rw [Situation.projInclusionToOpen]
  infer_instance

set_option backward.isDefEq.respectTransparency false in
/-- Over an affine open on which `D` vanishes, the relative `Proj` of a divisorial section
algebra along the identity is the open itself. -/
theorem isIso_projInclusionToOpen {V : Y.Opens} (hV : IsAffineOpen V)
    (h0 : ∀ E : MMP.Mori.PrimeDivisor Y, (E.support ∩ V).Nonempty → D.coeff E = 0) :
    IsIso (A.situation.projInclusionToOpen V hV) := by
  have hsub : ∀ n : ℕ, ((n : ℤ) • D).divisorialSubmodule V = 1 := fun n =>
    divisorialSubmodule_eq_one_of_coeff_eq_zero fun E hE => by
      rw [DivisorWithCoeffs.coeff_smul, h0 E hE, smul_zero]
  have h1 : (1 : (rationalFunctionsPresheaf Y).obj (op V)) ∈
      (((1 : ℕ) : ℤ) • D).divisorialSubmodule V :=
    hsub 1 ▸ Submodule.one_le.mp le_rfl
  refine A.isIso_projInclusionToOpen_of_toPolynomial_eq hV
    ((A.sectionEquiv _ (Int.natCast_nonneg 1) V).symm ⟨1, h1⟩) isUnit_one ?_ fun n x => ?_
  · rw [A.toPolynomial_of, pieceToRationalFunctions_apply, AddEquiv.apply_symm_apply, C_1, one_mul]
    exact monomial_one_one_eq_X
  · have hx : (A.pieceToRationalFunctions V n x : (rationalFunctionsPresheaf Y).obj (op V)) ∈
        (1 : Submodule Γ(Y, V) ((rationalFunctionsPresheaf Y).obj (op V))) :=
      hsub n ▸ (A.sectionEquiv _ (Int.natCast_nonneg n) V x).2
    rw [Submodule.one_eq_range] at hx
    obtain ⟨r, hr⟩ := hx
    exact ⟨r, by rw [one_pow, one_mul]; exact hr.symm⟩

set_option backward.isDefEq.respectTransparency false in
/-- **Over an open where `D` is Cartier the relative `Proj` is the base.** If `ψ` is a local
equation of `D` on an affine open `V`, then `⨁_n 𝒪_Y(nD)(V) = 𝒪_Y(V)[ψ⁻¹ t]` is a polynomial ring
and the relative `Proj` of a divisorial section algebra along the identity is `V` over `V`. -/
theorem isIso_projInclusionToOpen_of_isLocalEquation [CompactSpace Y] {V : Y.Opens}
    (hV : IsAffineOpen V) {ψ : (RationalFunctions Y)ˣ} (hψ : D.IsLocalEquation V ψ) :
    IsIso (A.situation.projInclusionToOpen V hV) := by
  set w := rationalFunctionsRestrict V ((ψ⁻¹ : (RationalFunctions Y)ˣ) : RationalFunctions Y)
  have hmem := mem_divisorialSubmodule_nsmul_iff_of_isLocalEquation hψ
  have h1 : w ∈ (((1 : ℕ) : ℤ) • D).divisorialSubmodule V :=
    (hmem 1 w).2 ⟨1, by rw [pow_one, map_one, mul_one]⟩
  refine A.isIso_projInclusionToOpen_of_toPolynomial_eq hV
    ((A.sectionEquiv _ (Int.natCast_nonneg 1) V).symm ⟨w, h1⟩) (ψ⁻¹.isUnit.map _) ?_
    fun n x => (hmem n _).1 (A.sectionEquiv _ (Int.natCast_nonneg n) V x).2
  rw [A.toPolynomial_of, pieceToRationalFunctions_apply, AddEquiv.apply_symm_apply]
  exact C_mul_X_eq_monomial.symm

/-- The image of the chart of the relative `Proj` over an affine open `V` lies over `V`. -/
theorem relativeProjChart_opensRange_le {V : Y.Opens} (hV : IsAffineOpen V) :
    (A.situation.relativeProjChart ⟨V, show V ∈ Y.affineOpens from hV⟩).opensRange ≤
      A.toBase ⁻¹ᵁ V := by
  let c := A.situation.relativeProjChart ⟨V, show V ∈ Y.affineOpens from hV⟩
  have hw : c ≫ A.toBase = A.situation.projInclusionToOpen V hV ≫ V.ι :=
    (A.situation.relativeProjChart_isPullback ⟨V, show V ∈ Y.affineOpens from hV⟩).w
  rintro _ ⟨x, rfl⟩
  change (c ≫ A.toBase) x ∈ V
  rw [hw]
  exact (A.situation.projInclusionToOpen V hV x).2

/-- If the relative `Proj` over an affine open `V` is `V`, then the structure morphism restricted
to the image of the chart over `V` is an isomorphism. -/
theorem isIso_resLE_relativeProjChart {V : Y.Opens} (hV : IsAffineOpen V)
    [IsIso (A.situation.projInclusionToOpen V hV)] :
    IsIso (A.toBase.resLE V _ (A.relativeProjChart_opensRange_le hV)) := by
  let c := A.situation.relativeProjChart ⟨V, show V ∈ Y.affineOpens from hV⟩
  have he : c.isoOpensRange.hom ≫ A.toBase.resLE V c.opensRange
      (A.relativeProjChart_opensRange_le hV) = A.situation.projInclusionToOpen V hV := by
    rw [← cancel_mono V.ι]
    erw [Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.isoOpensRange_hom_ι]
    exact (A.situation.relativeProjChart_isPullback ⟨V, show V ∈ Y.affineOpens from hV⟩).w
  have : IsIso (c.isoOpensRange.hom ≫ A.toBase.resLE V c.opensRange
      (A.relativeProjChart_opensRange_le hV)) := by
    rw [he]
    infer_instance
  exact IsIso.of_isIso_comp_left c.isoOpensRange.hom _

/-- **The relative `Proj` of a divisorial algebra is birational to the base.** Over a nonempty
affine open avoiding the support of `D`, the structure morphism is an isomorphism. -/
theorem isBirationalMorphism_toBase [IrreducibleSpace Y] [IrreducibleSpace A.model] :
    IsBirationalMorphism A.toBase := by
  obtain ⟨V, hV, ⟨y, hy⟩, h0⟩ := exists_isAffineOpen_coeff_eq_zero D
  have := A.isIso_projInclusionToOpen hV h0
  let c := A.situation.relativeProjChart ⟨V, show V ∈ Y.affineOpens from hV⟩
  exact MMP.Flips.isBirationalMorphism_of_isIso_resLE A.toBase c.opensRange V
    ⟨c (inv (A.situation.projInclusionToOpen V hV) ⟨y, hy⟩), _, rfl⟩ ⟨y, hy⟩
    (A.relativeProjChart_opensRange_le hV) (A.isIso_resLE_relativeProjChart hV)

/-- **The structure morphism is biregular over an open where `D` is Cartier.** If `D` has a
local equation on an affine open `V`, then `Proj_Y ⨁_n 𝒪_Y(nD) ⟶ Y` restricts to an isomorphism
over `V`. -/
theorem isBiregular_toBase_of_isLocalEquation [CompactSpace Y] {V : Y.Opens}
    (hV : IsAffineOpen V) {ψ : (RationalFunctions Y)ˣ} (hψ : D.IsLocalEquation V ψ) :
    IsBiregular A.toBase V := by
  have := A.isIso_projInclusionToOpen_of_isLocalEquation hV hψ
  have hV' : V ∈ Y.affineOpens := hV
  have hpb := A.situation.relativeProjChart_isPullback ⟨V, hV'⟩
  have hrange : (A.situation.relativeProjChart ⟨V, hV'⟩).opensRange = A.toBase ⁻¹ᵁ V := by
    refine le_antisymm (A.relativeProjChart_opensRange_le hV) fun x hx => ?_
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := A.situation.relativeProjToBase) (g := (⟨V, hV'⟩ : Y.affineOpens).1.ι) x
      ⟨A.toBase x, hx⟩ rfl
    refine ⟨hpb.isoPullback.inv z, ?_⟩
    change (hpb.isoPullback.inv ≫ A.situation.relativeProjChart ⟨V, hV'⟩) z = x
    rw [hpb.isoPullback_inv_fst]
    exact hz
  have key : ∀ (U : A.model.Opens) (hU : U = A.toBase ⁻¹ᵁ V) (h : U ≤ A.toBase ⁻¹ᵁ V),
      IsIso (A.toBase.resLE V U h) → IsBiregular A.toBase V := by
    rintro U rfl h hU
    rwa [Scheme.Hom.resLE_eq_morphismRestrict] at hU
  exact key _ hrange _ (A.isIso_resLE_relativeProjChart hV)

end MMP.Fourfold.DivisorialSectionAlgebra
