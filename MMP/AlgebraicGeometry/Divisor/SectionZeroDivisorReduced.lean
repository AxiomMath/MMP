module

public import MMP.AlgebraicGeometry.Divisor.SectionZeroDivisor
public import MMP.AlgebraicGeometry.Cohomology.StupidTruncationEdgeSurjective
public import MMP.AlgebraicGeometry.Cohomology.Duality.SmoothSerreDuality
public import MMP.AlgebraicGeometry.Resolution.OrderReduction.RegularStalkComponents

/-!
# The divisor of zeros of a section with smooth zero scheme

Let `X` be an integral, locally Noetherian, normal, quasi-compact scheme, `L` an invertible
`𝒪_X`-module and `s` a nonzero global section of `L^{⊗ m}`, with divisor of zeros `D`. The
divisor `D` is effective and its support is the zero scheme `Z(s)` as a set: at a point `y`, the
stalk of the ideal of `Z(s)` is the ideal `I` with `s · 𝒪_{X,y} = I · L^{⊗ m}_y`, which at the
generic point of a prime divisor `E` is generated by an element of order `D(E)` along `E`. When
`Z(s)` is reduced, `𝒪_{X,E} / (π^{D(E)})` is reduced for a uniformizer `π`, so `D(E) ≤ 1`: `D` is
reduced. This applies when `Z(s)` is smooth over a field.

When every divisor on `X` is Cartier and `𝒪_X(M) ≅ L`, multiplication by `s^k` from
`L^{⊗ -(r + mk)}` to `L^{⊗ -r}` is the inclusion `𝒪_X(-rM - kD) ⊆ 𝒪_X(-rM)`, so the two induce
surjections on cohomology together.

## Main results

* `MMP.LcBpf.stalkRange_sectionHom_stalk_zeroScheme`: the stalk of the ideal of `Z(s)`.
* `MMP.LcBpf.IsSectionDivisor.isEffective`: the divisor of zeros is effective.
* `MMP.LcBpf.IsSectionDivisor.coe_supp_eq_support_zeroScheme`: its support is `Z(s)`.
* `MMP.LcBpf.IsSectionDivisor.coeff_eq_one`,
  `MMP.LcBpf.IsSectionDivisor.coeff_eq_one_of_smooth`: it is reduced when `Z(s)` is reduced, in
  particular when `Z(s)` is smooth over a field.
* `MMP.LcBpf.surjective_map_chain_iff_divisorialSheafInclusion`: multiplication by `s^k` and the
  inclusion `𝒪_X(-rM - kD) ⊆ 𝒪_X(-rM)` are surjective together after any functor to modules.
* `MMP.LcBpf.surjective_homology_map_chain_iff_divisorialSheafInclusion`: the same for the maps
  induced on `H^i(X, -)` over a field.

## References

* [J. Kollár and S. Mori, *Birational geometry of algebraic varieties*][KollarMori1998],
  proof of Theorem 2.47
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry MMP.Mori
open Stacks.EnriquesSeveriZariski Stacks.Ample

universe u

namespace MMP.LcBpf

section Effective

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]

/-- **The divisor of zeros of a section is effective.** -/
theorem IsSectionDivisor.isEffective {L : X.Modules} [IsInvertibleModule X L] {m : ℕ}
    {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X} (hD : IsSectionDivisor L s D) :
    D.IsEffective := by
  obtain ⟨G, -, h, -, -⟩ := hD
  intro E
  have := h E
  change G E - D E ≤ G E at this
  change 0 ≤ D E
  linarith

end Effective

section ZeroScheme

variable {X : Scheme.{u}}

/-- **The stalk of the zero scheme of a section.** The stalk at `y` of the ideal of `Z(s)` is the
ideal `I ⊆ 𝒪_{X,y}` with `s · 𝒪_{X,y} = I · M_y`. -/
theorem stalkRange_sectionHom_stalk_zeroScheme (M : X.Modules) [IsInvertibleModule X M]
    (s : Γ(M, ⊤)) (y : X) :
    haveI : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M :=
      ‹IsInvertibleModule X M›
    StalkRange (sectionHom M s) y
      (AlgebraicGeometry.IdealSheafData.stalk (AlgebraicGeometry.zeroScheme X M s) y) := by
  have : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M :=
    ‹IsInvertibleModule X M›
  obtain ⟨V, hyV, ⟨t⟩⟩ := Stacks.SectionProduct.exists_trivialization_at M y
  obtain ⟨-, ⟨U, hU, rfl⟩, hyU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hyV V.isOpen
  have hUV' : U ≤ V := hUV
  set a : Γ(X, U) := Stacks.NonvanishingOpen.triv t (homOfLE hUV')
    (M.presheaf.map (homOfLE le_top).op s)
  have hideal : (AlgebraicGeometry.zeroScheme X M s).ideal ⟨U, hU⟩ = Ideal.span {a} :=
    zeroScheme_ideal_of_trivialization X M s ⟨U, hU⟩ (t.θ U (homOfLE hUV')) a rfl
  set b := (M.presheaf.germ V y hyV).hom (Stacks.NonvanishingOpen.basis t)
  have hs : (M.presheaf.Γgerm y).hom s = (X.presheaf.germ U y hyU).hom a • b := by
    have e1 := Stacks.SectionProduct.eq_triv_smul_res_basis t (homOfLE hUV')
      (M.presheaf.map (homOfLE le_top).op s)
    have h1 : (M.presheaf.Γgerm y).hom s =
        (M.presheaf.germ U y hyU).hom (M.presheaf.map (homOfLE le_top).op s) :=
      (TopCat.Presheaf.germ_res_apply M.presheaf (homOfLE le_top) y hyU s).symm
    rw [h1, e1, Scheme.Modules.germ_smul, TopCat.Presheaf.germ_res_apply]
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ y ⟨U, hU⟩ hyU, hideal, Ideal.map_span,
    Set.image_singleton]
  refine le_antisymm ?_ ?_
  · rintro _ ⟨z, rfl⟩
    rw [stalkLinearMap_sectionHom, hs, smul_smul, mul_comm, ← smul_smul]
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self _) Submodule.mem_top
  · refine Submodule.smul_le.2 fun x hx m _ => ?_
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    obtain ⟨r, rfl⟩ := Stacks.SectionProduct.exists_smul_germ_basis t hyV m
    refine ⟨(unitStalkEquiv X y).symm (d * r), ?_⟩
    rw [stalkLinearMap_sectionHom, (unitStalkEquiv X y).apply_symm_apply, hs, smul_smul,
      smul_smul]
    congr 1
    ring

/-- **A point lies on the zero scheme of `s` exactly when `s` does not generate the stalk.** -/
theorem mem_support_zeroScheme_iff (M : X.Modules) [IsInvertibleModule X M] (s : Γ(M, ⊤))
    (y : X) :
    haveI : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M :=
      ‹IsInvertibleModule X M›
    y ∈ ((AlgebraicGeometry.zeroScheme X M s).support : Set X) ↔
      ¬ StalkRange (sectionHom M s) y ⊤ := by
  have : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M :=
    ‹IsInvertibleModule X M›
  have hA := stalkRange_sectionHom_stalk_zeroScheme M s y
  rw [SetLike.mem_coe, ← not_iff_not, not_not,
    ← AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_notMem_support]
  exact ⟨fun h => h ▸ hA, fun h => StalkRange.unique hA h⟩

/-- Where the closed subscheme of a reduced ideal sheaf `I` passes through `y`, the quotient
`𝒪_{X,y} / I_y` is reduced. -/
theorem isReduced_quotient_stalk (I : X.IdealSheafData) [IsReduced I.subscheme] {y : X}
    (hy : y ∈ (I.support : Set X)) :
    _root_.IsReduced (X.presheaf.stalk y ⧸ AlgebraicGeometry.IdealSheafData.stalk I y) := by
  rw [← Scheme.IdealSheafData.range_subschemeι] at hy
  obtain ⟨z, rfl⟩ := hy
  rw [← AlgebraicGeometry.IdealSheafData.ker_stalkMap_subschemeι_eq_stalk I z]
  exact isReduced_of_injective
    (RingHom.quotientKerEquivOfSurjective (I.subschemeι.stalkMap_surjective z)).toRingHom
    (RingHom.quotientKerEquivOfSurjective (I.subschemeι.stalkMap_surjective z)).injective

end ZeroScheme

section DVR

/-- In a domain, `R / (u ϖ^k)` with `ϖ` irreducible and `u` a unit is reduced only for `k ≤ 1`. -/
theorem le_one_of_isReduced_quotient_span_unit_mul_pow {R : Type*} [CommRing R] [IsDomain R]
    {ϖ : R} (hϖ : Irreducible ϖ) (v : Rˣ) {k : ℕ}
    (hred : _root_.IsReduced (R ⧸ Ideal.span {(v : R) * ϖ ^ k})) : k ≤ 1 := by
  by_contra hk
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 2 := ⟨k - 2, by omega⟩
  have hnil : IsNilpotent (Ideal.Quotient.mk (Ideal.span {(v : R) * ϖ ^ (j + 2)}) (ϖ ^ (j + 1))) :=
    ⟨2, by
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
      refine ⟨(↑v⁻¹ : R) * ϖ ^ j, ?_⟩
      rw [show (↑v⁻¹ * ϖ ^ j) * (↑v * ϖ ^ (j + 2)) = (↑v⁻¹ * ↑v) * ϖ ^ ((j + 1) * 2) by ring,
        Units.inv_mul, one_mul, pow_mul]⟩
  have h0 := hnil.eq_zero
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h0
  obtain ⟨c, hc⟩ := h0
  have h1 : ϖ ^ (j + 1) * (ϖ * (c * v)) = ϖ ^ (j + 1) * 1 :=
    calc ϖ ^ (j + 1) * (ϖ * (c * v)) = c * (v * ϖ ^ (j + 2)) := by ring
      _ = ϖ ^ (j + 1) * 1 := by rw [hc, mul_one]
  have h2 := mul_left_cancel₀ (pow_ne_zero _ hϖ.ne_zero) h1
  exact hϖ.not_isUnit ⟨⟨ϖ, c * v, h2, (mul_comm _ _).trans h2⟩, rfl⟩

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]

/-- An element of `𝒪_{X,E}` of order `n` along `E` is `u ϖ^n` for a uniformizer `ϖ` and a unit
`u`; in particular `n ≥ 0`. -/
theorem exists_eq_unit_mul_pow_of_valuation_eq (E : Mori.PrimeDivisor X) {q : E.localRing} {n : ℤ}
    (hq : E.valuation (E.toComponent.hom q) = WithZero.exp n) :
    ∃ (ϖ : E.localRing) (v : E.localRingˣ) (k : ℕ), Irreducible ϖ ∧ (k : ℤ) = n ∧
      q = v * ϖ ^ k := by
  have := E.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  have hq0 : q ≠ 0 := by
    rintro rfl
    rw [map_zero, map_zero] at hq
    exact WithZero.exp_ne_zero hq.symm
  obtain ⟨k, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hq0 hϖ
  refine ⟨ϖ, v, k, hϖ, ?_, rfl⟩
  rw [map_mul, map_mul, map_pow, map_pow, E.valuation_toComponent_of_isUnit v.isUnit, one_mul,
    E.valuation_toComponent_of_irreducible hϖ, ← WithZero.exp_nsmul, WithZero.exp_inj] at hq
  simpa using hq

end DVR

section Support

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X] [CompactSpace X]

/-- At the generic point of a prime divisor `E`, the section `s` generates `L^{⊗ m}` exactly when
`E` is not a component of its divisor of zeros. -/
theorem IsSectionDivisor.stalkRange_top_genericPoint_iff {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X}
    (hD : IsSectionDivisor L s D) (E : Mori.PrimeDivisor X) :
    StalkRange (sectionHom _ s) E.genericPoint ⊤ ↔ D.coeff E = 0 := by
  obtain ⟨q, hq, hr⟩ := hD.exists_stalkRange E
  obtain ⟨ϖ, v, k, hϖ, hk, rfl⟩ := exists_eq_unit_mul_pow_of_valuation_eq E hq
  refine ⟨fun htop => ?_, fun h0 => ?_⟩
  · have h := StalkRange.unique hr htop
    rw [Ideal.span_singleton_eq_top] at h
    have hk0 : k = 0 := by
      by_contra hk0
      exact hϖ.not_isUnit ((isUnit_pow_iff hk0).mp (IsUnit.mul_iff.mp h).2)
    omega
  · obtain rfl : k = 0 := by omega
    rwa [pow_zero, mul_one, Ideal.span_singleton_eq_top.mpr v.isUnit] at hr

omit [IsIntegral X] [CompactSpace X] in
/-- The stalk of an inclusion `𝒪_X(C) ⊆ 𝒪_X(B)` is onto at a point off the support of `B - C`. -/
theorem surjective_stalkLinearMap_divisorialSheafInclusion {C B : Divisor X} (h : C ≤ B) {x : X}
    (hx : x ∉ (B - C).supp) :
    Function.Surjective (stalkLinearMap _ _ (Divisor.divisorialSheafInclusion h) x) := by
  intro z
  obtain ⟨V, hxV, φ, rfl⟩ := B.divisorialSheaf.presheaf.exists_germ_eq z
  let O : X.Opens := ⟨((B - C).supp : Set X)ᶜ, (B - C).isClosed_supp.isOpen_compl⟩
  let W : X.Opens := V ⊓ O
  have hxW : x ∈ W := ⟨hxV, hx⟩
  let φW : Γ(B.divisorialSheaf, W) := B.divisorialSheaf.presheaf.map (homOfLE inf_le_left).op φ
  have hcoeff : ∀ E : Mori.PrimeDivisor X, (E.support ∩ (W : Set X)).Nonempty →
      C.coeff E = B.coeff E := by
    rintro E ⟨w, hwE, hwW⟩
    by_contra hne
    have hne' : (B - C).coeff E ≠ 0 := by
      rw [DivisorWithCoeffs.coeff_sub]
      exact sub_ne_zero.mpr (Ne.symm hne)
    exact hwW.2 (DivisorWithCoeffs.support_subset_supp hne' hwE)
  let ψ : Γ(C.divisorialSheaf, W) := ⟨φW.1, fun E hE => by
    have := φW.2 E hE
    rwa [← hcoeff E hE] at this⟩
  refine ⟨C.divisorialSheaf.presheaf.germ W x hxW ψ, ?_⟩
  rw [AlgebraicGeometry.stalkLinearMap_germ,
    show (Divisor.divisorialSheafInclusion h).val.app (Opposite.op W) ψ = φW from Subtype.ext rfl]
  exact B.divisorialSheaf.presheaf.germ_res_apply _ x hxW φ

/-- **The support of the divisor of zeros of `s` is the zero scheme of `s`**, as a set. -/
theorem IsSectionDivisor.coe_supp_eq_support_zeroScheme {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X}
    (hD : IsSectionDivisor L s D) :
    haveI : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
        (tensorPowModule X L (m : ℤ)) := isInvertibleModule_tensorPowModule X L _
    (D.supp : Set X) = ((AlgebraicGeometry.zeroScheme X _ s).support : Set X) := by
  have : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (tensorPowModule X L (m : ℤ)) := isInvertibleModule_tensorPowModule X L _
  ext x
  rw [SetLike.mem_coe, DivisorWithCoeffs.mem_supp_iff, mem_support_zeroScheme_iff]
  constructor
  · rintro ⟨E, hE, hxE⟩ htop
    have hηx : E.genericPoint ⤳ x := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
      exact specializes_iff_mem_closure.mpr hxE
    have hx : x ∉ ((AlgebraicGeometry.zeroScheme X _ s).support : Set X) := by
      rwa [mem_support_zeroScheme_iff, not_not]
    have hη : E.genericPoint ∉ ((AlgebraicGeometry.zeroScheme X _ s).support : Set X) :=
      fun hη => hx (hηx.mem_closed (AlgebraicGeometry.zeroScheme X _ s).support.isClosed hη)
    rw [mem_support_zeroScheme_iff, not_not, hD.stalkRange_top_genericPoint_iff] at hη
    exact hE hη
  · intro hx
    by_contra hsupp
    refine hx ?_
    obtain ⟨G, ε, h, e, hε⟩ := hD
    have hxG : x ∉ (G - (G - D)).supp := by
      rw [sub_sub_cancel]
      exact fun hmem => hsupp (DivisorWithCoeffs.mem_supp_iff.mp hmem)
    have hi : StalkRange (Divisor.divisorialSheafInclusion h) x ⊤ := by
      rw [StalkRange, Submodule.top_smul, LinearMap.range_eq_top]
      exact surjective_stalkLinearMap_divisorialSheafInclusion h hxG
    have hs : sectionHom _ s = e.hom ≫ Divisor.divisorialSheafInclusion h ≫ ε.inv := by
      rw [← Category.assoc, ← hε, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have := (StalkRange.of_inverse e.hom e.inv e.hom_inv_id e.inv_hom_id).comp
      (hi.comp (StalkRange.of_inverse ε.inv ε.hom ε.inv_hom_id ε.hom_inv_id))
    rwa [Ideal.top_mul, Ideal.top_mul, ← hs] at this

/-- **The divisor of zeros of a section with reduced zero scheme is reduced**: its coefficients
are at most `1`. -/
theorem IsSectionDivisor.coeff_le_one {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X}
    (hD : IsSectionDivisor L s D)
    (hred : IsReduced (@AlgebraicGeometry.zeroScheme X _
      (isInvertibleModule_tensorPowModule X L (m : ℤ)) s).subscheme)
    (E : Mori.PrimeDivisor X) : D.coeff E ≤ 1 := by
  have : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (tensorPowModule X L (m : ℤ)) := isInvertibleModule_tensorPowModule X L _
  by_cases hE : D.coeff E = 0
  · exact hE.le.trans zero_le_one
  have hη : E.genericPoint ∈ ((AlgebraicGeometry.zeroScheme X _ s).support : Set X) := by
    rw [← hD.coe_supp_eq_support_zeroScheme]
    refine DivisorWithCoeffs.support_subset_supp hE ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  obtain ⟨q, hq, hr⟩ := hD.exists_stalkRange E
  have hst := StalkRange.unique (stalkRange_sectionHom_stalk_zeroScheme _ s E.genericPoint) hr
  have hq' := isReduced_quotient_stalk _ hη
  rw [hst] at hq'
  obtain ⟨ϖ, v, k, hϖ, hk, rfl⟩ := exists_eq_unit_mul_pow_of_valuation_eq E hq
  have := le_one_of_isReduced_quotient_span_unit_mul_pow hϖ v hq'
  omega

/-- **The divisor of zeros of a section with reduced zero scheme is reduced and effective**: every
nonzero coefficient is `1`. -/
theorem IsSectionDivisor.coeff_eq_one {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X}
    (hD : IsSectionDivisor L s D)
    (hred : IsReduced (@AlgebraicGeometry.zeroScheme X _
      (isInvertibleModule_tensorPowModule X L (m : ℤ)) s).subscheme) :
    ∀ E ∈ D.support, D E = 1 := by
  intro E hE
  have h1 := hD.coeff_le_one hred E
  have h0 := hD.isEffective E
  have hne : D E ≠ 0 := Finsupp.mem_support_iff.mp hE
  change D E ≤ 1 at h1
  change 0 ≤ D E at h0
  omega

/-- **The divisor of zeros of a section with smooth zero scheme is reduced and effective**, over a
field: every nonzero coefficient is `1`. -/
theorem IsSectionDivisor.coeff_eq_one_of_smooth {K : Type u} [Field K] (f : X ⟶ Spec (.of K))
    [LocallyOfFiniteType f] {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} {D : Divisor X}
    (hD : IsSectionDivisor L s D)
    (hsm : Smooth ((@AlgebraicGeometry.zeroScheme X _
      (isInvertibleModule_tensorPowModule X L (m : ℤ)) s).subschemeι ≫ f)) :
    ∀ E ∈ D.support, D E = 1 :=
  hD.coeff_eq_one (MMP.Resolution.Aux.isReduced_subscheme_of_isSmoothScheme f _
    ((isSmoothScheme_iff _).2 hsm))

end Support

section Variety

/-- **The divisor of zeros of a section with smooth zero scheme on a projective variety is
reduced**: every coefficient is `0` or `1`. -/
theorem coeff_eq_zero_or_one_of_smooth_zeroScheme {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ f] (L : X.Modules) [IsInvertibleModule X L] {m : ℕ}
    (s : Γ(tensorPowModule X L (m : ℤ), ⊤))
    (hsm : Smooth ((@AlgebraicGeometry.zeroScheme X (tensorPowModule X L (m : ℤ))
      (isInvertibleModule_tensorPowModule X L m) s).subschemeι ≫ f))
    [IsLocallyNoetherian X] [IsNormal X] (D : Divisor X) (hD : IsSectionDivisor L s D) :
    ∀ E, D E = 0 ∨ D E = 1 := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  intro E
  by_cases hE : E ∈ D.support
  · exact Or.inr (hD.coeff_eq_one_of_smooth f hsm E hE)
  · exact Or.inl (Finsupp.notMem_support_iff.mp hE)

end Variety

section Transfer

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X] [CompactSpace X]

/-- **Multiplication by `s^k` and the inclusion `𝒪_X(-rM - kD) ⊆ 𝒪_X(-rM)` are surjective
together** after any functor to modules, when every divisor is Cartier, `𝒪_X(M) ≅ L` and `D` is
the divisor of zeros of `s`. -/
theorem surjective_map_chain_iff_divisorialSheafInclusion {K : Type} [Ring K]
    (F : X.Modules ⥤ ModuleCat.{0} K) (hcart : ∀ D : Divisor X, D.IsCartier)
    (L : X.Modules) [IsInvertibleModule X L] (M : Divisor X) (eM : M.divisorialSheaf ≅ L)
    {m : ℕ} (s : Γ(tensorPowModule X L (m : ℤ), ⊤)) {D : Divisor X}
    (hD : IsSectionDivisor L s D) (r k : ℕ)
    (h : -((r : ℤ) • M) - (k : ℤ) • D ≤ -((r : ℤ) • M)) :
    Function.Surjective (F.map (chain L s (unitModule X) (-(r : ℤ)) k)).hom ↔
      Function.Surjective (F.map (Divisor.divisorialSheafInclusion h)).hom := by
  obtain ⟨e₂, e₁, _, w⟩ := exists_iso_chain_eq_divisorialSheafInclusion hcart L M eM s hD r k
  exact surjective_map_iff_of_square F _ _ e₁ e₂ w

end Transfer

section Cohomology

/-- **Multiplication by `s^k` and the inclusion `𝒪_X(-rM - kD) ⊆ 𝒪_X(-rM)` induce surjections on
`H^i(X, -)` together**, for `X` over a field `K`, when every divisor is Cartier, `𝒪_X(M) ≅ L` and
`D` is the divisor of zeros of `s`. -/
theorem surjective_homology_map_chain_iff_divisorialSheafInclusion {X : Scheme.{0}}
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X] [CompactSpace X] {K : Type} [Field K]
    (f : X ⟶ Spec (.of K)) [HasDerivedCategory X.Modules] [HasDerivedCategory (ModuleCat.{0} K)]
    (hcart : ∀ D : Divisor X, D.IsCartier)
    (L : X.Modules) [IsInvertibleModule X L] (M : Divisor X) (eM : M.divisorialSheaf ≅ L)
    {m : ℕ} (s : Γ(tensorPowModule X L (m : ℤ), ⊤)) {D : Divisor X}
    (hD : IsSectionDivisor L s D) (r k : ℕ)
    (h : -((r : ℤ) • M) - (k : ℤ) • D ≤ -((r : ℤ) • M)) (i : ℤ) :
    Function.Surjective ((DerivedCategory.homologyFunctor (ModuleCat.{0} K) i).map
      ((derivedGlobalSectionsOver f).map
        ((DerivedCategory.singleFunctor X.Modules 0).map
          (chain L s (unitModule X) (-(r : ℤ)) k)))).hom ↔
      Function.Surjective ((DerivedCategory.homologyFunctor (ModuleCat.{0} K) i).map
        ((derivedGlobalSectionsOver f).map
          ((DerivedCategory.singleFunctor X.Modules 0).map
            (Divisor.divisorialSheafInclusion h)))).hom :=
  surjective_map_chain_iff_divisorialSheafInclusion
    (DerivedCategory.singleFunctor X.Modules 0 ⋙ derivedGlobalSectionsOver f ⋙
      DerivedCategory.homologyFunctor (ModuleCat.{0} K) i) hcart L M eM s hD r k h

end Cohomology

