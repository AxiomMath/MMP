module

public import MMP.AlgebraicGeometry.Divisor.RationalCycleMap
public import MMP.AlgebraicGeometry.Divisor.SNC
public import StacksFrontier.AlgebraicGeometry.PicardGroup.PuncturedSpectrumRegular
public import StacksFrontier.AlgebraicGeometry.Variety.Smooth.RegularStalk
public import MMP.AlgebraicGeometry.Divisor.PullbackExistence
public import MMP.AlgebraicGeometry.Dimension.HeightCoheight
import MMP.AlgebraicGeometry.Variety.Subvariety

/-!
# `ℝ`- and `ℚ`-divisors on a non-singular variety (Lazarsfeld Rem. 9.1.3)

On a non-singular variety `X` of dimension `n` over `k` every local ring is a regular local ring,
hence a UFD; so every prime divisor is locally principal, and the cycle map `Div(X) → WDiv(X)` is
an isomorphism carrying the effective Cartier divisors onto the effective Weil divisors. Tensoring
with `ℝ`, the cycle map `Div_ℝ(X) → WDiv_ℝ(X)` is an isomorphism of `ℝ`-vector spaces carrying
`Div_ℚ(X)` onto `WDiv_ℚ(X)`, and an `ℝ`-divisor is effective if and only if its Weil divisor is.

## Main results

* `MMP.Intersection.cycleMap_bijective_of_uniqueFactorizationMonoid`,
  `MMP.Intersection.exists_isEffective_cycleMap_eq_single_of_uniqueFactorizationMonoid`: on an
  integral, locally Noetherian scheme of pure dimension `n`, locally of finite type over `k`, all
  of whose stalks are UFDs, `Div(X) → WDiv(X)` is bijective and every prime divisor is the Weil
  divisor of an effective Cartier divisor.
* `MMP.Intersection.cycleMap_bijective_of_isSmoothScheme`: `Div(X) → WDiv(X)` is bijective.
* `MMP.Intersection.exists_isEffective_cycleMap_eq_single_of_isSmoothScheme`: every prime divisor
  is the Weil divisor of an effective Cartier divisor.
* `MMP.Intersection.CartierDivisorWithCoeffs.cycleMap_real_bijective_of_isSmoothScheme`,
  `MMP.Intersection.CartierDivisorWithCoeffs.range_cycleMap_ratCast_of_isSmoothScheme`: the real
  cycle map is an isomorphism of `ℝ`-vector spaces carrying `Div_ℚ(X)` onto `WDiv_ℚ(X)`.
* `MMP.Intersection.CartierDivisorWithCoeffs.isEffective_iff_of_isSmoothScheme`: effectivity of
  `ℝ`-divisors is effectivity of their Weil divisors.

## Implementation notes

* `Div_R(X) = Div(X) ⊗[ℤ] R` and `WDiv_R(X) = WDiv(X) ⊗[ℤ] R` carry their `R`-module structures
  through the coefficients (`MMP.Intersection.coeffSMul`); `ℝ`-linearity of the cycle map is
  `MMP.Intersection.CartierDivisorWithCoeffs.cycleMap_coeffSMul`, which holds for every `R`.
-/

@[expose] public noncomputable section

universe u

open CategoryTheory TopologicalSpace AlgebraicGeometry TensorProduct

namespace MMP.Intersection

/-! ### Orders in localizations of a unique factorization domain -/

section Algebra

/-- If the ideal generated by `x` is maximal, then `x` has order one. -/
theorem ord_eq_one_of_isMaximal_span {S : Type*} [CommRing S] {x : S}
    (h : (Ideal.span {x}).IsMaximal) : Ring.ord S x = 1 := by
  rw [Ring.ord, Module.length_eq_one_iff,
    isSimpleModule_iff_isSimpleModule_of_algebraMap_surjective (S := S ⧸ Ideal.span {x})
      Ideal.Quotient.mk_surjective]
  let := Ideal.Quotient.field (Ideal.span {x})
  exact instIsSimpleModule _

/-- An element of order zero is a unit. -/
theorem isUnit_of_ord_eq_zero {S : Type*} [CommRing S] {x : S} (h : Ring.ord S x = 0) :
    IsUnit x := by
  rwa [Ring.ord, Module.length_eq_zero_iff, Ideal.Quotient.subsingleton_iff,
    Ideal.span_singleton_eq_top] at h

/-- A criterion for two elements of a unique factorization domain to be associated: given for
every prime `π` an order function `v π`, additive on non-zero elements, zero on units, equal to
`1` at `π` and non-zero only on multiples of `π`, two non-zero elements with the same orders at
every prime are associated. -/
theorem associated_of_forall_eq {R : Type*} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] (v : R → R → ℕ∞)
    (hmul : ∀ π, Prime π → ∀ x y, x ≠ 0 → y ≠ 0 → v π (x * y) = v π x + v π y)
    (hunit : ∀ π, Prime π → ∀ u, IsUnit u → v π u = 0)
    (hself : ∀ π, Prime π → v π π = 1)
    (hdvd : ∀ π, Prime π → ∀ x, v π x ≠ 0 → π ∣ x) {a b : R} (ha : a ≠ 0) (hb : b ≠ 0)
    (h : ∀ π, Prime π → v π a = v π b) : Associated a b := by
  have hfin : ∀ π, Prime π → ∀ p, Prime p → v π p ≠ ⊤ := by
    intro π hπ p hp
    by_cases hd : π ∣ p
    · obtain ⟨c, rfl⟩ := hd
      have hc : IsUnit c := (hp.irreducible.isUnit_or_isUnit rfl).resolve_left hπ.not_isUnit
      rw [hmul π hπ _ _ hπ.ne_zero hc.ne_zero, hself π hπ, hunit π hπ c hc]
      simp
    · have : v π p = 0 := by by_contra hne; exact hd (hdvd π hπ p hne)
      simp [this]
  induction a using UniqueFactorizationMonoid.induction_on_prime generalizing b with
  | h₁ => exact absurd rfl ha
  | h₂ x hx =>
    by_cases hbu : IsUnit b
    · exact associated_of_dvd_dvd hx.dvd hbu.dvd
    · exfalso
      obtain ⟨π, hπi, c, rfl⟩ := WfDvdMonoid.exists_irreducible_factor hbu hb
      have hπ : Prime π := UniqueFactorizationMonoid.irreducible_iff_prime.mp hπi
      have hc : c ≠ 0 := right_ne_zero_of_mul hb
      have := h π hπ
      rw [hunit π hπ x hx, hmul π hπ _ _ hπ.ne_zero hc, hself π hπ] at this
      have h1 : (1 : ℕ∞) ≤ 1 + v π c := le_self_add
      rw [← this] at h1
      exact absurd h1 (by simp)
  | h₃ a p ha0 hp ih =>
    have hpb : p ∣ b := by
      apply hdvd p hp
      rw [← h p hp, hmul p hp _ _ hp.ne_zero ha0, hself p hp]
      simp
    obtain ⟨b', rfl⟩ := hpb
    have hb' : b' ≠ 0 := right_ne_zero_of_mul hb
    refine (ih ha0 hb' fun π hπ => ?_).mul_left p
    have := h π hπ
    rw [hmul π hπ _ _ hp.ne_zero ha0, hmul π hπ _ _ hp.ne_zero hb'] at this
    exact (WithTop.add_left_inj (hfin π hπ p hp)).mp this

variable {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime] (S : Type*)
  [CommRing S] [Algebra R S] [IsLocalization.AtPrime S p]

include p in
/-- In the localization `S` of a domain `R` at a prime `p`, for `y ≠ 0` the order of the image of
`x * y` is the sum of the orders of the images of `x` and `y`. -/
theorem ord_algebraMap_mul_of_isLocalization [IsDomain R] {x y : R} (hy : y ≠ 0) :
    Ring.ord S (algebraMap R S (x * y)) =
      Ring.ord S (algebraMap R S x) + Ring.ord S (algebraMap R S y) := by
  have := IsLocalization.isDomain_of_le_nonZeroDivisors (M := p.primeCompl) S
    (Ideal.primeCompl_le_nonZeroDivisors p)
  have hinj := IsLocalization.injective S (Ideal.primeCompl_le_nonZeroDivisors p)
  rw [map_mul]
  refine Ring.ord_mul _ (mem_nonZeroDivisors_of_ne_zero ?_)
  rw [Ne, ← map_zero (algebraMap R S)]
  exact fun h => hy (hinj h)

/-- The image of an element outside `p` in the localization at `p` has order zero. -/
theorem ord_algebraMap_of_notMem {x : R} (hx : x ∉ p) :
    Ring.ord S (algebraMap R S x) = 0 :=
  Ring.ord_of_isUnit ((IsLocalization.AtPrime.isUnit_to_map_iff S p x).2 hx)

/-- If `p` is generated by `π`, the image of `π` in the localization at `p` has order one. -/
theorem ord_algebraMap_eq_one_of_eq_span {π : R} (hp : p = Ideal.span {π}) :
    Ring.ord S (algebraMap R S π) = 1 := by
  have : IsLocalRing S := IsLocalization.AtPrime.isLocalRing S p
  apply ord_eq_one_of_isMaximal_span
  have h := IsLocalization.AtPrime.map_eq_maximalIdeal p S
  rw [hp, Ideal.map_span, Set.image_singleton] at h
  rw [h]
  exact IsLocalRing.maximalIdeal.isMaximal S

end Algebra

/-! ### Units of a factorial local ring of a scheme -/

section Stalk

variable {X : Scheme.{u}}

/-- The prime of a generization `y ⤳ x` in `𝒪_{X,x}`. -/
abbrev primeOfSpecializes {y x : X} (h : y ⤳ x) : Ideal (X.presheaf.stalk x) :=
  (IsLocalRing.maximalIdeal (X.presheaf.stalk y)).comap (X.presheaf.stalkSpecializes h).hom

/-- For a generization `y ⤳ x` with `𝒪_{X,x}` a domain and `d ≠ 0`, the order in `𝒪_{X,y}` of the
image of `c * d` is the sum of the orders of the images of `c` and `d`. -/
theorem ord_stalkSpecializes_mul {y x : X} [IsDomain (X.presheaf.stalk x)] (h : y ⤳ x)
    (c : X.presheaf.stalk x) {d : X.presheaf.stalk x} (hd : d ≠ 0) :
    Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h (c * d)) =
      Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h c) +
        Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h d) := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := isLocalization_stalkSpecializes h
  exact ord_algebraMap_mul_of_isLocalization (primeOfSpecializes h) (X.presheaf.stalk y) hd

/-- For a generization `y ⤳ x`, the image in `𝒪_{X,y}` of a unit of `𝒪_{X,x}` has order zero. -/
theorem ord_stalkSpecializes_of_isUnit {y x : X} (h : y ⤳ x) {u : X.presheaf.stalk x}
    (hu : IsUnit u) : Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h u) = 0 :=
  Ring.ord_of_isUnit (hu.map _)

/-- For a generization `y ⤳ x`, the image in `𝒪_{X,y}` of an element of `𝒪_{X,x}` outside
`primeOfSpecializes h` has order zero. -/
theorem ord_stalkSpecializes_of_notMem {y x : X} (h : y ⤳ x) {c : X.presheaf.stalk x}
    (hc : c ∉ primeOfSpecializes h) :
    Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h c) = 0 := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := isLocalization_stalkSpecializes h
  exact ord_algebraMap_of_notMem (primeOfSpecializes h) (X.presheaf.stalk y) hc

/-- For a generization `y ⤳ x`, an element of `𝒪_{X,x}` whose image in `𝒪_{X,y}` has non-zero
order lies in `primeOfSpecializes h`. -/
theorem mem_of_ord_stalkSpecializes_ne_zero {y x : X} (h : y ⤳ x) {c : X.presheaf.stalk x}
    (hc : Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h c) ≠ 0) :
    c ∈ primeOfSpecializes h :=
  Classical.byContradiction fun h' => hc (ord_stalkSpecializes_of_notMem h h')

/-- For a generization `y ⤳ x` whose prime `primeOfSpecializes h` is generated by `π`, the image of
`π` in `𝒪_{X,y}` has order one. -/
theorem ord_stalkSpecializes_eq_one {y x : X} (h : y ⤳ x) {π : X.presheaf.stalk x}
    (hπ : primeOfSpecializes h = Ideal.span {π}) :
    Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes h π) = 1 := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := isLocalization_stalkSpecializes h
  exact ord_algebraMap_eq_one_of_eq_span (primeOfSpecializes h) (X.presheaf.stalk y) hπ

/-- If `𝒪_{X,x}` is Noetherian and the prime `primeOfSpecializes h` of a generization `y ⤳ x` is
principal, then `y` has coheight at most one. -/
theorem coheight_le_one_of_primeOfSpecializes_eq_span {y x : X}
    [IsNoetherianRing (X.presheaf.stalk x)] (h : y ⤳ x) {π : X.presheaf.stalk x}
    (hπ : primeOfSpecializes h = Ideal.span {π}) : Order.coheight y ≤ 1 := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := isLocalization_stalkSpecializes h
  have e := IsLocalization.AtPrime.ringKrullDim_eq_height (primeOfSpecializes h)
    (X.presheaf.stalk y)
  rw [ringKrullDim_stalk_eq_coheight] at e
  rw [show Order.coheight y = (primeOfSpecializes h).height by exact_mod_cast e]
  exact Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {π})
    (primeOfSpecializes h) (by rw [← hπ, Ideal.minimalPrimes_eq_subsingleton_self]; rfl)

-- The `overlappingInstances` linter times out on `[IsDomain _] [UniqueFactorizationMonoid _]`.
set_option linter.overlappingInstances false in
/-- **Units of a factorial local ring.** If `𝒪_{X,x}` is a Noetherian unique factorization
domain, two non-zero elements whose images in `𝒪_{X,y}` have the same order for every
generization `y` of `x` with `dim 𝒪_{X,y} ≤ 1` are associated. -/
theorem associated_of_forall_ord_stalkSpecializes_eq (x : X) [IsDomain (X.presheaf.stalk x)]
    [UniqueFactorizationMonoid (X.presheaf.stalk x)] [IsNoetherianRing (X.presheaf.stalk x)]
    {a b : X.presheaf.stalk x} (ha : a ≠ 0) (hb : b ≠ 0)
    (h : ∀ (y : X) (hy : y ⤳ x), Order.coheight y ≤ 1 →
      Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes hy a) =
        Ring.ord (X.presheaf.stalk y) (X.presheaf.stalkSpecializes hy b)) :
    Associated a b := by
  classical
  let q : ∀ π : X.presheaf.stalk x, Prime π → PrimeSpectrum (X.presheaf.stalk x) :=
    fun π hπ => ⟨Ideal.span {π}, (Ideal.span_singleton_prime hπ.ne_zero).2 hπ⟩
  have hq : ∀ π (hπ : Prime π), primeOfSpecializes (fromSpecStalk_specializes x (q π hπ)) =
      Ideal.span {π} := fun π hπ =>
    comap_maximalIdeal_stalkSpecializes_fromSpecStalk x (q π hπ)
  let v : X.presheaf.stalk x → X.presheaf.stalk x → ℕ∞ := fun π c =>
    if hπ : Prime π then Ring.ord (X.presheaf.stalk (X.fromSpecStalk x (q π hπ)))
      (X.presheaf.stalkSpecializes (fromSpecStalk_specializes x (q π hπ)) c) else 0
  refine associated_of_forall_eq v ?_ ?_ ?_ ?_ ha hb ?_
  · intro π hπ c d _ hd
    simp only [v, dite_eq_left hπ]
    exact ord_stalkSpecializes_mul _ c hd
  · intro π hπ u hu
    simp only [v, dite_eq_left hπ]
    exact ord_stalkSpecializes_of_isUnit _ hu
  · intro π hπ
    simp only [v, dite_eq_left hπ]
    exact ord_stalkSpecializes_eq_one _ (hq π hπ)
  · intro π hπ c hc
    simp only [v, dite_eq_left hπ] at hc
    have := mem_of_ord_stalkSpecializes_ne_zero _ hc
    rwa [hq π hπ, Ideal.mem_span_singleton] at this
  · intro π hπ
    simp only [v, dite_eq_left hπ]
    exact h _ _ (coheight_le_one_of_primeOfSpecializes_eq_span _ (hq π hπ))

end Stalk

/-! ### Dimension and codimension-one points -/

section Dimension

open Order

/-- An integral scheme of pure dimension `n` has Krull dimension `n`. -/
theorem krullDim_eq_of_isPureDimensional {X : Scheme.{u}} [IsIntegral X] {n : ℕ}
    (hX : IsPureDimensional X n) : krullDim X = n := by
  have h1 := hX Set.univ (by rw [irreducibleComponents_eq_singleton]; rfl)
  rw [(Homeomorph.Set.univ X).isHomeomorph.topologicalKrullDim_eq] at h1
  rw [← krullDim_eq_of_orderIso MMP.Intersection.Scheme.Subvariety.orderIsoPoints,
    ← MMP.Intersection.Scheme.dimension_eq_krullDim_subvariety]
  exact h1

/-- On an integral scheme of pure dimension `n` locally of finite type over a field, the height and
the coheight of every point sum to `n`. -/
theorem height_add_coheight_eq_of_isPureDimensional (k : Type u) [Field k] {X : Scheme.{u}}
    [X.Over (Spec (.of k))] [IsIntegral X] [LocallyOfFiniteType (X ↘ Spec (.of k))] {n : ℕ}
    (hX : IsPureDimensional X n) (x : X) : height x + coheight x = n := by
  have h := MMP.height_add_coheight_eq_krullDim k x
  rw [krullDim_eq_of_isPureDimensional hX] at h
  exact_mod_cast h

/-- On an integral scheme of pure dimension `n` locally of finite type over a field, a
subvariety has dimension `n - 1` exactly when its generic point has coheight one. -/
theorem subvarietyDim_add_one_eq_iff (k : Type u) [Field k] {X : Scheme.{u}}
    [X.Over (Spec (.of k))] [IsIntegral X] [LocallyOfFiniteType (X ↘ Spec (.of k))] {n : ℕ}
    (hX : IsPureDimensional X n) (V : Scheme.Subvariety X) :
    subvarietyDim V + 1 = n ↔ coheight V.genericPoint = 1 := by
  have h := height_add_coheight_eq_of_isPureDimensional k hX V.genericPoint
  rw [subvarietyDim_eq_height]
  have hh : height V.genericPoint ≠ ⊤ := by
    intro ht; rw [ht, top_add] at h; exact ENat.top_ne_natCast n h
  have hc : coheight V.genericPoint ≠ ⊤ := by
    intro ht; rw [ht, add_top] at h; exact ENat.top_ne_natCast n h
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hh
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp hc
  rw [← ha, ← hb] at h ⊢
  have h' : a + b = n := by exact_mod_cast h
  constructor
  · intro e
    have e' : ((a + 1 : ℕ) : WithBot ℕ∞) = (n : WithBot ℕ∞) := by exact_mod_cast e
    have : a + 1 = n := by exact_mod_cast e'
    have : b = 1 := by omega
    rw [this]; rfl
  · intro e
    have : b = 1 := by exact_mod_cast e
    have : a + 1 = n := by omega
    rw [← this]; push_cast; rfl

end Dimension

/-! ### Subvarieties and their generic points -/

section GenericPoint

variable {X : Scheme.{u}}

/-- The support of a subvariety is the closure of its generic point. -/
theorem Scheme.Subvariety.support_eq_closure (V : Scheme.Subvariety X) :
    V.support = closure {V.genericPoint} :=
  V.isGenericPoint_genericPoint.def.symm

/-- Two subvarieties with the same generic point are equal. -/
theorem Scheme.Subvariety.ext_genericPoint {V W : Scheme.Subvariety X}
    (h : V.genericPoint = W.genericPoint) : V = W :=
  Scheme.Subvariety.support_injective (by rw [V.support_eq_closure, W.support_eq_closure, h])

/-- The generic point of the subvariety `associatedSubvariety ξ` is `ξ`. -/
theorem genericPoint_associatedSubvariety (ξ : X) : (associatedSubvariety ξ).genericPoint = ξ := by
  have h := (associatedSubvariety ξ).isGenericPoint_genericPoint
  have hs : (associatedSubvariety ξ).support = closure {ξ} := by
    change ((Scheme.IdealSheafData.vanishingIdeal
      (⟨closure {ξ}, isClosed_closure⟩ : Closeds X)).support : Set X) = _
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  rw [hs] at h
  exact h.eq isGenericPoint_closure

end GenericPoint

/-! ### Local equations at generizations -/

section Generization

variable {X : Scheme.{u}}

/-- The specialization maps of `𝒪_X` and of its sheaf of total quotient rings commute with
`stalkToTotalQuotient`. -/
theorem stalkSpecializes_stalkToTotalQuotient {y x : X} (h : y ⤳ x) (r : X.presheaf.stalk x) :
    X.totalQuotientSheaf.presheaf.stalkSpecializes h (stalkToTotalQuotient x r) =
      stalkToTotalQuotient y (X.presheaf.stalkSpecializes h r) :=
  (TopCat.Presheaf.stalkSpecializes_stalkFunctor_map_apply X.toTotalQuotientSheaf.hom h r).symm

/-- The image of a local equation of `D` at `x` under specialization is a local equation of `D` at
every generization `y` of `x`. -/
theorem IsLocalEquationAt.stalkSpecializes {D : X.CartierDivisor} {y x : X} (h : y ⤳ x)
    {f : X.totalQuotientSheaf.presheaf.stalk x} (hf : IsLocalEquationAt D x f) :
    IsLocalEquationAt D y (X.totalQuotientSheaf.presheaf.stalkSpecializes h f) := by
  obtain ⟨U, hxU, G, hG, rfl⟩ := hf
  exact ⟨U, h.mem_open U.isOpen hxU, G, hG, by
    rw [← ConcreteCategory.comp_apply, TopCat.Presheaf.germ_stalkSpecializes]⟩

/-- If `f` is the fraction `a / b` at `x`, then for every generization `y ⤳ x` the image of `f` is
the fraction of the images of `a` and `b`. -/
theorem IsFraction.stalkSpecializes {y x : X} (h : y ⤳ x)
    {f : X.totalQuotientSheaf.presheaf.stalk x} {a b : X.presheaf.stalk x}
    (hab : IsFraction f a b) :
    IsFraction (X.totalQuotientSheaf.presheaf.stalkSpecializes h f)
      (X.presheaf.stalkSpecializes h a) (X.presheaf.stalkSpecializes h b) := by
  refine ⟨?_, ?_⟩
  · rw [← stalkSpecializes_stalkToTotalQuotient]; exact hab.1.map _
  · rw [← stalkSpecializes_stalkToTotalQuotient, ← stalkSpecializes_stalkToTotalQuotient,
      ← map_mul, hab.2]

/-- On an integral scheme, the specialization map `𝒪_{X,x} → 𝒪_{X,y}` of a generization `y ⤳ x`
is injective. -/
theorem stalkSpecializes_injective [IsIntegral X] {y x : X} (h : y ⤳ x) :
    Function.Injective (X.presheaf.stalkSpecializes h) := by
  let := (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have := isLocalization_stalkSpecializes h
  exact IsLocalization.injective (M := (primeOfSpecializes h).primeCompl) (X.presheaf.stalk y)
    (Ideal.primeCompl_le_nonZeroDivisors _)

/-- On an integral scheme, the specialization map of a generization sends non-zero elements to
non-zero elements. -/
theorem stalkSpecializes_ne_zero [IsIntegral X] {y x : X} (h : y ⤳ x) {a : X.presheaf.stalk x}
    (ha : a ≠ 0) : X.presheaf.stalkSpecializes h a ≠ 0 := by
  rw [Ne, ← map_zero (X.presheaf.stalkSpecializes h).hom]
  exact fun e => ha (stalkSpecializes_injective h e)

/-- If a local equation of `D` at the generic point of `V` is the fraction `a / b` of
non-zero-divisors, then `ord a - ord b` is an order of `D` along `V`. -/
theorem isOrderAlong_of_isFraction [IsLocallyNoetherian X] {D : X.CartierDivisor}
    {V : Scheme.Subvariety X} [Ring.KrullDimLE 1 (X.presheaf.stalk V.genericPoint)]
    {g : X.totalQuotientSheaf.presheaf.stalk V.genericPoint}
    (hg : IsLocalEquationAt D V.genericPoint g) {a b : X.presheaf.stalk V.genericPoint}
    (ha : a ∈ nonZeroDivisors _) (hb : b ∈ nonZeroDivisors _) (hab : IsFraction g a b) :
    IsOrderAlong D V ((Ring.ord _ a).toNat - (Ring.ord _ b).toNat) :=
  ⟨a, b, ha, hb, ⟨g, hg, hab⟩, _, _, (ENat.natCast_toNat (Ring.ord_ne_top ha)).symm,
    (ENat.natCast_toNat (Ring.ord_ne_top hb)).symm, rfl⟩

end Generization

/-! ### Injectivity of the cycle map on a locally factorial scheme -/

section Injective

open Order

variable (k : Type u) [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsIntegral X]
  [LocallyOfFiniteType (X ↘ Spec (.of k))] [IsLocallyNoetherian X] [NoetherianSpace X] {n : ℕ}
  (hX : IsPureDimensional X n)

include k in
/-- **Lazarsfeld Rem. 9.1.3, injectivity.** On an integral scheme of pure dimension `n`, locally
of finite type over a field, whose local rings are unique factorization domains, a Cartier
divisor with Weil divisor zero is zero. -/
theorem cycleMap_injective_of_uniqueFactorizationMonoid
    (hUFD : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)) :
    Function.Injective (cycleMap hX) := by
  rw [injective_iff_map_eq_zero]
  intro D hD
  apply eq_of_forall_isLocalEquationAt
  intro x
  obtain ⟨f, hf⟩ := exists_isLocalEquationAt D x
  obtain ⟨a, b, ha, hb, hab⟩ := hf.exists_isFraction
  have := hUFD x
  have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
  have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
  have hassoc : Associated a b := by
    refine associated_of_forall_ord_stalkSpecializes_eq x ha0 hb0 fun y hy hy1 => ?_
    have hsa := stalkSpecializes_ne_zero hy ha0
    have hsb := stalkSpecializes_ne_zero hy hb0
    rcases Order.le_one_iff.mp hy1 with h0 | h1
    · have : Ring.KrullDimLE 0 (X.presheaf.stalk y) := krullDimLE_of_coheight_le (by rw [h0]; rfl)
      have : IsArtinianRing (X.presheaf.stalk y) := isArtinianRing_iff_krullDimLE_zero.2 this
      rw [Ring.ord_of_isUnit (IsArtinianRing.isUnit_of_mem_nonZeroDivisors
          (mem_nonZeroDivisors_of_ne_zero hsa)),
        Ring.ord_of_isUnit (IsArtinianRing.isUnit_of_mem_nonZeroDivisors
          (mem_nonZeroDivisors_of_ne_zero hsb))]
    · have hV : subvarietyDim (associatedSubvariety y) + 1 = n := by
        rw [subvarietyDim_add_one_eq_iff k hX, genericPoint_associatedSubvariety, h1]
      set V : Codim1Subvariety X n := ⟨associatedSubvariety y, hV⟩
      have h0 : IsOrderAlong D V.1 0 := by
        rw [← orderAlong_eq_iff hX, ← cycleMap_apply, hD]; rfl
      have hgp : V.1.genericPoint = y := genericPoint_associatedSubvariety y
      have hsf := hf.stalkSpecializes hy
      have hsab := hab.stalkSpecializes hy
      clear_value V
      subst hgp
      have : Ring.KrullDimLE 1 (X.presheaf.stalk V.1.genericPoint) :=
        krullDimLE_of_coheight_le (by rw [h1]; rfl)
      have hN := isOrderAlong_of_isFraction hsf (mem_nonZeroDivisors_of_ne_zero hsa)
        (mem_nonZeroDivisors_of_ne_zero hsb) hsab
      have e := h0.unique hN
      have e' : (Ring.ord _ (X.presheaf.stalkSpecializes hy a)).toNat =
          (Ring.ord _ (X.presheaf.stalkSpecializes hy b)).toNat := by omega
      rw [← ENat.natCast_toNat (Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero hsa)),
        ← ENat.natCast_toNat (Ring.ord_ne_top (mem_nonZeroDivisors_of_ne_zero hsb)), e']
  obtain ⟨u, hu⟩ := hassoc
  have hua : IsUnit (stalkToTotalQuotient x a) :=
    isUnit_stalkToTotalQuotient_of_mem_nonZeroDivisors ha
  have hfu : f = stalkToTotalQuotient x ((u⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) := by
    apply hua.mul_left_cancel
    have h2 := hab.2
    rw [← hu, map_mul] at h2
    have hu' : stalkToTotalQuotient x (u : X.presheaf.stalk x) *
        stalkToTotalQuotient x ((u⁻¹ : (X.presheaf.stalk x)ˣ) : X.presheaf.stalk x) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    linear_combination (stalkToTotalQuotient x ((u⁻¹ : (X.presheaf.stalk x)ˣ) :
      X.presheaf.stalk x)) * h2 - (stalkToTotalQuotient x a * f) * hu'
  refine ⟨f, hf, ?_⟩
  rw [hfu]
  exact isLocalEquationAt_zero_stalkToTotalQuotient x u⁻¹

end Injective

/-! ### Prime divisors are locally principal on a locally factorial scheme -/

section Surjective

open Order

variable {X : Scheme.{u}}

/-- The point `primeOfSpecializes h` of `Spec 𝒪_{X,x}` maps to `y` under `X.fromSpecStalk x`. -/
theorem fromSpecStalk_primeOfSpecializes {y x : X} (h : y ⤳ x) :
    X.fromSpecStalk x ⟨primeOfSpecializes h, inferInstance⟩ = y := by
  have := congrArg (fun f : Spec (X.presheaf.stalk y) ⟶ X =>
    f (IsLocalRing.closedPoint (X.presheaf.stalk y)))
    (Scheme.SpecMap_stalkSpecializes_fromSpecStalk h)
  simp only [Scheme.fromSpecStalk_closedPoint] at this
  exact this

/-- For generizations `y ⤳ x` and `y' ⤳ x`, if `primeOfSpecializes h ≤ primeOfSpecializes h'`
then `y ⤳ y'`. -/
theorem specializes_of_primeOfSpecializes_le {y y' x : X} (h : y ⤳ x) (h' : y' ⤳ x)
    (hle : primeOfSpecializes h ≤ primeOfSpecializes h') : y ⤳ y' := by
  have hs : (⟨primeOfSpecializes h, inferInstance⟩ : PrimeSpectrum (X.presheaf.stalk x)) ⤳
      ⟨primeOfSpecializes h', inferInstance⟩ := (PrimeSpectrum.le_iff_specializes _ _).1 hle
  have := hs.map (X.fromSpecStalk x).continuous
  rwa [fromSpecStalk_primeOfSpecializes, fromSpecStalk_primeOfSpecializes] at this

/-- On an integral locally Noetherian scheme, a section whose germ at a point `y` of coheight zero
is non-zero is invertible at `y`. -/
theorem mem_basicOpen_of_coheight_eq_zero [IsIntegral X] [IsLocallyNoetherian X] {U : X.Opens}
    (s : Γ(X, U)) {y : X} (hy : y ∈ U) (h0 : coheight y = 0)
    (hs : X.presheaf.germ U y hy s ≠ 0) : y ∈ X.basicOpen s := by
  have : Ring.KrullDimLE 0 (X.presheaf.stalk y) := krullDimLE_of_coheight_le (by rw [h0]; rfl)
  have : IsArtinianRing (X.presheaf.stalk y) := isArtinianRing_iff_krullDimLE_zero.2 this
  exact (X.mem_basicOpen s y hy).2
    (IsArtinianRing.isUnit_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hs))

/-- If `y'` specializes to `y` and `y ≠ y'`, then `y < y'` in the order on the points of `X`. -/
theorem lt_of_specializes_of_ne {y y' : X} (h : y' ⤳ y) (hne : y ≠ y') : y < y' := by
  refine lt_of_le_not_ge (Scheme.le_iff_specializes.2 h) fun h' => hne ?_
  exact (h.antisymm (Scheme.le_iff_specializes.1 h')).eq.symm

open scoped Classical in
/-- **Local equations of a prime divisor.** On an integral Noetherian scheme, let `η` be a point
of coheight one and `x` a point whose local ring `𝒪_{X,x}` is factorial. Then `x` has an open
neighbourhood `U` and a section `s` of `𝒪_X` over `U` with non-zero germs whose germ at every
point `y ∈ U` with `dim 𝒪_{X,y} ≤ 1` has order one if `y = η` and zero otherwise; if `η ∈ U`, the
germ of `s` at `η` generates the maximal ideal of `𝒪_{X,η}`. -/
theorem exists_section_ord_eq_ite [IsIntegral X] [IsLocallyNoetherian X] [NoetherianSpace X]
    {η : X} (hη : coheight η = 1) (x : X) (hUFD : UniqueFactorizationMonoid (X.presheaf.stalk x)) :
    ∃ (U : X.Opens) (s : Γ(X, U)) (_ : x ∈ U),
      (∀ y (hy : y ∈ U), X.presheaf.germ U y hy s ≠ 0) ∧
      (∀ y (hy : y ∈ U), coheight y ≤ 1 →
        Ring.ord (X.presheaf.stalk y) (X.presheaf.germ U y hy s) = if y = η then 1 else 0) ∧
      ∀ hηU : η ∈ U,
        IsLocalRing.maximalIdeal (X.presheaf.stalk η) = Ideal.span {X.presheaf.germ U η hηU s} := by
  by_cases hx : x ∈ closure ({η} : Set X)
  swap
  · refine ⟨⟨(closure {η})ᶜ, isClosed_closure.isOpen_compl⟩, 1, hx, fun y hy => ?_,
      fun y hy _ => ?_, fun hηU => (hηU (subset_closure rfl)).elim⟩
    · rw [map_one]; exact one_ne_zero
    · have hyη : y ≠ η := fun e => hy (e ▸ subset_closure rfl)
      rw [map_one, Ring.ord_one, ite_eq_right hyη]
  have hηx : η ⤳ x := specializes_iff_mem_closure.2 hx
  set q := primeOfSpecializes hηx
  have hq1 : q.height = 1 := by
    let := (X.presheaf.stalkSpecializes hηx).hom.toAlgebra
    have := isLocalization_stalkSpecializes hηx
    have e := IsLocalization.AtPrime.ringKrullDim_eq_height q (X.presheaf.stalk η)
    rw [ringKrullDim_stalk_eq_coheight, hη] at e
    exact_mod_cast e.symm
  have hq0 : q ≠ ⊥ := by
    intro h
    rw [h, Ideal.height_bot] at hq1
    exact zero_ne_one hq1
  obtain ⟨π, hπq, hπ⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot inferInstance hq0
  have hqπ : q = Ideal.span {π} := Ideal.eq_span_singleton_of_height_eq_one hq1 hπq hπ
  obtain ⟨U₀, hxU₀, s₀, hs₀⟩ := X.presheaf.exists_germ_eq π
  have hs₀0 : ∀ y (hy : y ∈ U₀), X.presheaf.germ U₀ y hy s₀ ≠ 0 := by
    intro y hy e
    have h1 : s₀ = 0 := germ_injective_of_isIntegral X y hy (by rw [e, map_zero])
    apply hπ.ne_zero
    rw [← hs₀, h1, map_zero]
  set B : Set X := {y | ∃ hy : y ∈ U₀, y ∉ X.basicOpen s₀ ∧ coheight y ≤ 1 ∧ y ≠ η}
  have hBx : ∀ y ∈ B, ¬ y ⤳ x := by
    rintro y ⟨hyU, hyb, hy1, hyη⟩ hyx
    have hπy : π ∈ primeOfSpecializes hyx := by
      change X.presheaf.stalkSpecializes hyx π ∈ IsLocalRing.maximalIdeal _
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hs₀, ← ConcreteCategory.comp_apply,
        TopCat.Presheaf.germ_stalkSpecializes]
      exact fun hu => hyb ((X.mem_basicOpen s₀ y hyU).2 hu)
    have hle : q ≤ primeOfSpecializes hyx := by
      rw [hqπ, Ideal.span_singleton_le_iff_mem]; exact hπy
    have hηy : η ⤳ y := specializes_of_primeOfSpecializes_le hηx hyx hle
    have h2 := coheight_add_one_le (lt_of_specializes_of_ne hηy hyη)
    rw [hη] at h2
    have := h2.trans hy1
    exact absurd this (by decide)
  have hBfin : B.Finite := by
    have hSz : IsClosed ((X.basicOpen s₀ : Set X)ᶜ) := (X.basicOpen s₀).isOpen.isClosed_compl
    have hmax : ∀ y ∈ B, Maximal (fun Z : Set X => IsIrreducible Z ∧ Z ⊆ (X.basicOpen s₀ : Set X)ᶜ)
        (closure {y}) := by
      rintro y ⟨hyU, hyb, hy1, -⟩
      refine ⟨⟨isIrreducible_singleton.closure,
        closure_minimal (Set.singleton_subset_iff.2 hyb) hSz⟩, fun Z ⟨hZ, hZS⟩ hyZ => ?_⟩
      set ζ := hZ.genericPoint
      have hζ : IsGenericPoint ζ (closure Z) := hZ.isGenericPoint_genericPoint_closure
      have hZS' : closure Z ⊆ (X.basicOpen s₀ : Set X)ᶜ := closure_minimal hZS hSz
      have hy' : y ∈ closure Z := subset_closure (hyZ (subset_closure rfl))
      have hζy : ζ ⤳ y := hζ.specializes hy'
      have hζU : ζ ∈ U₀ := hζy.mem_open U₀.isOpen hyU
      have hζb : ζ ∉ X.basicOpen s₀ := hZS' hζ.mem
      have hζ0 : coheight ζ ≠ 0 := fun h0 =>
        hζb (mem_basicOpen_of_coheight_eq_zero s₀ hζU h0 (hs₀0 ζ hζU))
      by_cases hyζ : y ⤳ ζ
      · have hζeq : ζ = y := (hζy.antisymm hyζ).eq
        calc Z ⊆ closure Z := subset_closure
          _ = closure {ζ} := hζ.def.symm
          _ = closure {y} := by rw [hζeq]
      · exfalso
        have hne : y ≠ ζ := fun e => hyζ (e ▸ specializes_rfl)
        have h2 := coheight_add_one_le (lt_of_specializes_of_ne hζy hne)
        have h3 : (1 : ℕ∞) + 1 ≤ coheight y :=
          (add_le_add (Order.one_le_iff_ne_zero.mpr hζ0) le_rfl).trans h2
        exact absurd (h3.trans hy1) (by decide)
    refine Set.Finite.of_finite_image (f := fun y : X => closure ({y} : Set X))
      ((finite_setOf_maximal_isIrreducible_subset hSz).subset ?_) ?_
    · rintro _ ⟨y, hy, rfl⟩
      exact hmax y hy
    · intro y _ y' _ e
      have h := (isGenericPoint_closure (x := y))
      change closure {y} = closure {y'} at e
      rw [e] at h
      exact h.eq isGenericPoint_closure
  set F : Set X := ⋃ y ∈ B, closure {y} with hF
  have hFc : IsClosed F := hBfin.isClosed_biUnion fun _ _ => isClosed_closure
  have hxF : x ∉ F := by
    simp only [hF, Set.mem_iUnion]
    rintro ⟨y, hy, hxy⟩
    exact hBx y hy (specializes_iff_mem_closure.2 hxy)
  set U : X.Opens := U₀ ⊓ ⟨Fᶜ, hFc.isOpen_compl⟩
  have hgerm : ∀ y (hy : y ∈ U), X.presheaf.germ U y hy (X.presheaf.map (homOfLE inf_le_left).op s₀)
      = X.presheaf.germ U₀ y hy.1 s₀ := fun y hy =>
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_left) y hy s₀
  have hgη : ∀ hη : η ∈ U₀, X.presheaf.germ U₀ η hη s₀ = X.presheaf.stalkSpecializes hηx π :=
    fun _ => by rw [← hs₀, ← ConcreteCategory.comp_apply, TopCat.Presheaf.germ_stalkSpecializes]
  refine ⟨U, X.presheaf.map (homOfLE inf_le_left).op s₀, ⟨hxU₀, hxF⟩, fun y hy => ?_,
    fun y hy hy1 => ?_, fun hηU => ?_⟩
  · rw [hgerm]; exact hs₀0 y hy.1
  · rw [hgerm]
    by_cases hyη : y = η
    · rw [ite_eq_left hyη]
      subst hyη
      rw [hgη]
      exact ord_stalkSpecializes_eq_one hηx hqπ
    · rw [ite_eq_right hyη]
      have hyb : y ∈ X.basicOpen s₀ := by
        by_contra hyb
        exact hy.2 (Set.mem_biUnion ⟨hy.1, hyb, hy1, hyη⟩ (subset_closure rfl))
      exact Ring.ord_of_isUnit ((X.mem_basicOpen s₀ y hy.1).1 hyb)
  · let := (X.presheaf.stalkSpecializes hηx).hom.toAlgebra
    have := isLocalization_stalkSpecializes hηx
    rw [hgerm, hgη, ← IsLocalization.AtPrime.map_eq_maximalIdeal q (X.presheaf.stalk η), hqπ,
      Ideal.map_span, Set.image_singleton]
    rfl

end Surjective

/-! ### The cycle map on a locally factorial scheme -/

section LocallyFactorial

open Order

variable (k : Type u) [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsIntegral X]
  [LocallyOfFiniteType (X ↘ Spec (.of k))] [IsLocallyNoetherian X] [NoetherianSpace X] {n : ℕ}
  (hX : IsPureDimensional X n)

include k in
open scoped Classical in
/-- **Lazarsfeld Rem. 9.1.3, prime divisors.** On an integral scheme of pure dimension `n`,
locally of finite type over a field, whose local rings are unique factorization domains, every
`(n-1)`-dimensional subvariety is the Weil divisor of an effective Cartier divisor. -/
theorem exists_isEffective_cycleMap_eq_single_of_uniqueFactorizationMonoid
    (hUFD : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)) (V : Codim1Subvariety X n) :
    ∃ C : X.CartierDivisor, IsEffective C ∧ cycleMap hX C = Finsupp.single V 1 := by
  set η := V.1.genericPoint with hηdef
  have hη : coheight η = 1 := (subvarietyDim_add_one_eq_iff k hX V.1).1 V.2
  choose U s hxU hs0 hord _ using fun x => exists_section_ord_eq_ite hη x (hUFD x)
  have hu : ∀ x, IsUnit (toTotalQuotient (U x) (s x)) := fun x =>
    isUnit_toTotalQuotientSheaf_app X.sheaf (U x) (s x)
      (fun y hy => show X.presheaf.germ (U x) y hy (s x) ∈ nonZeroDivisors (X.presheaf.stalk y)
        from mem_nonZeroDivisors_of_ne_zero (hs0 x y hy))
  have hU : iSup U = ⊤ := eq_top_iff.2 fun x _ => Opens.mem_iSup.2 ⟨x, hxU x⟩
  obtain ⟨C, hC⟩ := exists_isLocalEquationOn_of_germ_eq_mul U hU (fun x => (hu x).unit) (by
    intro i j p hi hj
    have := hUFD p
    have hassoc : Associated (X.presheaf.germ (U i) p hi (s i))
        (X.presheaf.germ (U j) p hj (s j)) := by
      refine associated_of_forall_ord_stalkSpecializes_eq p (hs0 i p hi) (hs0 j p hj)
        fun y hy hy1 => ?_
      rw [← ConcreteCategory.comp_apply, TopCat.Presheaf.germ_stalkSpecializes,
        ← ConcreteCategory.comp_apply, TopCat.Presheaf.germ_stalkSpecializes, hord i y _ hy1,
        hord j y _ hy1]
    obtain ⟨w, hw⟩ := hassoc
    refine ⟨w, ?_⟩
    simp only [IsUnit.unit_spec]
    rw [germ_toTotalQuotient, germ_toTotalQuotient, ← hw, map_mul])
  refine ⟨C, fun x => ⟨U x, hxU x, s x, hu x, hC x⟩, ?_⟩
  ext W
  rw [cycleMap_apply, Finsupp.single_apply]
  have hf : IsLocalEquationAt C W.1.genericPoint (stalkToTotalQuotient W.1.genericPoint
      (X.presheaf.germ (U W.1.genericPoint) W.1.genericPoint (hxU _) (s W.1.genericPoint))) :=
    ⟨U W.1.genericPoint, hxU _, (hu _).unit, hC _, germ_toTotalQuotient _ _⟩
  obtain ⟨m, hm, hN⟩ := (isOrderAlong_orderAlong hX W C).eq_length hf
  rw [hN]
  have key := hord W.1.genericPoint W.1.genericPoint (hxU _) (coheight_genericPoint_le_one hX W)
  change Ring.ord _ _ = _ at hm
  rw [key] at hm
  by_cases hVW : V = W
  · rw [ite_eq_left hVW]
    rw [ite_eq_left (by rw [hηdef, hVW])] at hm
    exact_mod_cast hm.symm
  · rw [ite_eq_right hVW]
    have hne : W.1.genericPoint ≠ η := fun e =>
      hVW (Subtype.ext (Scheme.Subvariety.ext_genericPoint e.symm))
    rw [ite_eq_right hne] at hm
    exact_mod_cast hm.symm

include k in
/-- **Lazarsfeld Rem. 9.1.3.** On an integral scheme of pure dimension `n`, locally of finite
type over a field, whose local rings are unique factorization domains, the cycle map
`Div(X) → WDiv(X)` is bijective. -/
theorem cycleMap_bijective_of_uniqueFactorizationMonoid
    (hUFD : ∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)) :
    Function.Bijective (cycleMap hX) := by
  refine ⟨cycleMap_injective_of_uniqueFactorizationMonoid k hX hUFD, fun w => ?_⟩
  induction w using Finsupp.induction_linear with
  | zero => exact ⟨0, map_zero _⟩
  | add f g hf hg =>
    obtain ⟨C, rfl⟩ := hf
    obtain ⟨D, rfl⟩ := hg
    exact ⟨C + D, map_add _ _ _⟩
  | single V b =>
    obtain ⟨C, -, hC⟩ := exists_isEffective_cycleMap_eq_single_of_uniqueFactorizationMonoid k hX
      hUFD V
    exact ⟨b • C, by rw [map_zsmul, hC, Finsupp.smul_single_one]⟩

end LocallyFactorial

/-! ### Smooth varieties are locally factorial -/

/-- Every local ring of a non-singular variety over a field is a unique factorization domain. -/
theorem uniqueFactorizationMonoid_stalk_of_isSmoothScheme {k : Type u} [Field k]
    {X : Scheme.{u}} [X.Over (Spec (.of k))] [MMP.Mori.IsVariety k (X ↘ Spec (.of k))]
    (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k))) (x : X) :
    UniqueFactorizationMonoid (X.presheaf.stalk x) := by
  have : Smooth (X ↘ Spec (.of k)) := (MMP.Mori.isSmoothScheme_iff _).1 hsm
  have := isRegularLocalRing_stalk_of_smooth_over_field (X ↘ Spec (.of k)) x
  exact IsRegularLocalRing.uniqueFactorizationMonoid _

variable {k : Type u} [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))]
  [IsLocallyNoetherian X] [NoetherianSpace X] {n : ℕ} (hX : IsPureDimensional X n)

/-- **Lazarsfeld Rem. 1.1.4.** On a non-singular variety of pure dimension `n`, the cycle map
`Div(X) → WDiv(X)` is bijective, hence an isomorphism of groups. -/
@[mmp "lem_mmp_foundation_smooth_cartier_weil_cycle_isomorphism"]
theorem cycleMap_bijective_of_isSmoothScheme [MMP.Mori.IsVariety k (X ↘ Spec (.of k))]
    (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k))) :
    Function.Bijective (cycleMap hX) :=
  cycleMap_bijective_of_uniqueFactorizationMonoid k hX
    (uniqueFactorizationMonoid_stalk_of_isSmoothScheme hsm)

/-- On a non-singular variety of pure dimension `n`, every `(n-1)`-dimensional subvariety `V` is
the Weil divisor of an effective Cartier divisor. -/
theorem exists_isEffective_cycleMap_eq_single_of_isSmoothScheme
    [MMP.Mori.IsVariety k (X ↘ Spec (.of k))] (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k)))
    (V : Codim1Subvariety X n) :
    ∃ C : X.CartierDivisor, IsEffective C ∧ cycleMap hX C = Finsupp.single V 1 :=
  exists_isEffective_cycleMap_eq_single_of_uniqueFactorizationMonoid k hX
    (uniqueFactorizationMonoid_stalk_of_isSmoothScheme hsm) V

namespace CartierDivisorWithCoeffs

/-- **Lazarsfeld Rem. 9.1.3, the real cycle map on a non-singular variety.** On a non-singular
variety `X` of dimension `n`, the cycle map `Div_ℝ(X) → WDiv_ℝ(X)` is bijective; it is `ℝ`-linear
by `MMP.Intersection.CartierDivisorWithCoeffs.cycleMap_coeffSMul`, hence an isomorphism of
`ℝ`-vector spaces. -/
@[mmp "lem_p09a_q_divisor_smooth_q_cartier_r_iso"]
theorem cycleMap_real_bijective_of_isSmoothScheme [MMP.Mori.IsVariety k (X ↘ Spec (.of k))]
    (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k))) :
    Function.Bijective (cycleMap ℝ hX) :=
  cycleMap_bijective hX (MMP.Intersection.cycleMap_bijective_of_isSmoothScheme hX hsm)

/-- **Lazarsfeld Rem. 9.1.3, `Div_ℚ(X)` onto `WDiv_ℚ(X)`.** On a non-singular variety `X` of
dimension `n`, the real cycle map carries the `ℚ`-divisors `Div_ℚ(X) ⊆ Div_ℝ(X)` onto the Weil
`ℚ`-divisors `WDiv_ℚ(X) ⊆ WDiv_ℝ(X)`. -/
@[mmp "lem_p09a_q_divisor_smooth_q_cartier_r_iso"]
theorem range_cycleMap_ratCast_of_isSmoothScheme [MMP.Mori.IsVariety k (X ↘ Spec (.of k))]
    (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k))) :
    Set.range (fun D : CartierDivisorWithCoeffs ℚ X =>
        cycleMap ℝ hX (coeffChange (Rat.castHom ℝ) D)) =
      Set.range (coeffChange (Rat.castHom ℝ) : WeilDivisor X n ⊗[ℤ] ℚ → WeilDivisor X n ⊗[ℤ] ℝ) :=
  range_cycleMap_comp_coeffChange_of_bijective hX _
    (MMP.Intersection.cycleMap_bijective_of_isSmoothScheme hX hsm)

open scoped Classical in
/-- **Lazarsfeld Rem. 9.1.3, effectivity on a non-singular variety.** On a non-singular variety
`X` of dimension `n`, an `ℝ`-divisor `D` is effective if and only if its Weil divisor `[D]` is
effective, i.e. has non-negative coefficients. -/
@[mmp "lem_p09a_q_divisor_smooth_q_cartier_effective"]
theorem isEffective_iff_of_isSmoothScheme [MMP.Mori.IsVariety k (X ↘ Spec (.of k))]
    (hsm : MMP.Mori.IsSmoothScheme (X ↘ Spec (.of k))) (D : CartierDivisorWithCoeffs ℝ X) :
    D.IsEffective ↔ ∀ V, 0 ≤ weilDivisorTensorEquiv ℝ n (cycleMap ℝ hX D) V :=
  isEffective_iff_of_bijective hX (MMP.Intersection.cycleMap_bijective_of_isSmoothScheme hX hsm)
    (MMP.Intersection.exists_isEffective_cycleMap_eq_single_of_isSmoothScheme hX hsm) D

end CartierDivisorWithCoeffs

end MMP.Intersection
