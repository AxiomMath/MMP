module

public import MMP.AlgebraicGeometry.Divisor.CartierDivisorSheaf
public import StacksFrontier.AlgebraicGeometry.IdealSheafFromAffineFamily
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.Stalks

/-!
# Effective Cartier divisors and their closed subschemes

Let `D` be an effective Cartier divisor on a scheme `X` (`MMP.Intersection.IsEffective`): near
every point, `D` has a local equation `g` which is a section of `𝒪_X`. The *closed subscheme* of
`D` is defined on such an open `U` by the ideal `g 𝒪(U)`. These ideals agree on overlaps, because
two local equations differ by a unit of `𝒪_X`. A closed subscheme is the closed subscheme of an
effective Cartier divisor exactly when its ideal sheaf is invertible, i.e. when it is an
effective Cartier divisor in the sense of the Stacks project.

## Main definitions

* `MMP.CartierDivisor.IsRegularLocalEquation D g`: the section `g` of `𝒪_X` over `U` is a local
  equation of `D` on `U`.
* `MMP.CartierDivisor.IsEffectiveOn D U`: `D` has a local equation in `𝒪_X` on `U`.
* `MMP.CartierDivisor.subscheme D hD`: the closed subscheme of the effective Cartier divisor `D`,
  as a quasi-coherent sheaf of ideals `X.IdealSheafData`.

## Main results

* `MMP.CartierDivisor.ideal_subscheme`: on every open `U` on which `D` has the local equation
  `g ∈ 𝒪(U)`, the sections over `U` of the ideal sheaf of the subscheme of `D` are `g 𝒪(U)`.
* `MMP.CartierDivisor.eq_subscheme_iff`: the subscheme of `D` is the only sheaf of ideals with this
  property on affine opens.
* `MMP.CartierDivisor.isEffectiveCartierDivisor_subscheme`: the subscheme of an effective Cartier
  divisor is an effective Cartier divisor in the sense of the Stacks project.
* `MMP.CartierDivisor.isEffectiveCartierDivisor_iff_exists_subscheme_eq`: a closed subscheme is a
  Stacks effective Cartier divisor iff it is the subscheme of an effective Cartier divisor.

## Implementation notes

The ideal on an open `U` on which `D` has a local equation in `𝒪_X` is the ideal generated by all
such local equations; it is principal, generated by any one of them. These ideals on affine opens
are glued by `AlgebraicGeometry.Scheme.IdealSheafData.ofAffineFamily`.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §1.5 and Appendix B.4.4.
* [Stacks Project, Tag 01WR](https://stacks.math.columbia.edu/tag/01WR)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open MMP.Intersection MMP.CartierDivisorSheaf

universe u

namespace MMP.CartierDivisor

variable {X : Scheme.{u}}

/-- The section `g` of `𝒪_X` over `U` is a *local equation* of the Cartier divisor `D` on `U`:
its image in `𝒦_X(U)` is a unit whose section of `𝒦*` is a local equation of `D`. -/
def IsRegularLocalEquation (D : X.CartierDivisor) {U : X.Opens} (g : Γ(X, U)) : Prop :=
  ∃ h : IsUnit (toK U g), IsLocalEquationOn D U h.unit

/-- The restriction of a local equation in `𝒪_X` is a local equation in `𝒪_X`. -/
theorem IsRegularLocalEquation.res {D : X.CartierDivisor} {U V : X.Opens} {g : Γ(X, U)}
    (hg : IsRegularLocalEquation D g) (h : V ≤ U) :
    IsRegularLocalEquation D ((X.presheaf.map (homOfLE h).op).hom g) := by
  obtain ⟨hu, hg⟩ := hg
  have e : toK V ((X.presheaf.map (homOfLE h).op).hom g) = resK h (toK U g) :=
    (resK_toK h g).symm
  have hu' : IsUnit (toK V ((X.presheaf.map (homOfLE h).op).hom g)) := e ▸ hu.map (resK h)
  refine ⟨hu', ?_⟩
  rw [show hu'.unit = Units.map (resK h).toMonoidHom hu.unit from Units.ext (by simpa using e)]
  exact isLocalEquation_restrict h hg

/-- `D` has a local equation in `𝒪_X` on `U`: some section of `𝒪_X` over `U` is a local equation
of `D`. -/
def IsEffectiveOn (D : X.CartierDivisor) (U : X.Opens) : Prop :=
  ∃ g : Γ(X, U), IsRegularLocalEquation D g

/-- An effective Cartier divisor (`MMP.Intersection.IsEffective`) is one with a local equation in
`𝒪_X` near every point. -/
theorem isEffective_iff (D : X.CartierDivisor) :
    IsEffective D ↔ ∀ x : X, ∃ U : X.Opens, x ∈ U ∧ IsEffectiveOn D U :=
  forall_congr' fun _ ↦ ⟨fun ⟨U, hxU, s, hs, hsD⟩ ↦ ⟨U, hxU, s, hs, hsD⟩,
    fun ⟨U, hxU, s, hs, hsD⟩ ↦ ⟨U, hxU, s, hs, hsD⟩⟩

/-- If `D` has a local equation in `𝒪_X` on `U`, it has one on every smaller open. -/
theorem IsEffectiveOn.mono {D : X.CartierDivisor} {U V : X.Opens} (hD : IsEffectiveOn D U)
    (h : V ≤ U) : IsEffectiveOn D V := by
  obtain ⟨g, hg⟩ := hD
  exact ⟨_, hg.res h⟩

/-- The zero divisor has the local equation `1` on every open. -/
theorem isEffectiveOn_zero (U : X.Opens) : IsEffectiveOn (0 : X.CartierDivisor) U := by
  have hu : IsUnit (toK U 1) := by simp
  refine ⟨1, hu, ?_⟩
  rw [show hu.unit = 1 from Units.ext (by simp), IsLocalEquationOn, cartierClass_one,
    restrictDivisor, map_zero]

/-- The zero divisor is effective. -/
theorem isEffective_zero : IsEffective (0 : X.CartierDivisor) :=
  (isEffective_iff 0).2 fun _ ↦ ⟨⊤, trivial, isEffectiveOn_zero ⊤⟩

/-- Two local equations in `𝒪_X` of the same Cartier divisor on the same open differ by a unit
of `𝒪_X`. -/
theorem IsRegularLocalEquation.exists_unit_mul {D : X.CartierDivisor} {U : X.Opens}
    {g g' : Γ(X, U)} (hg : IsRegularLocalEquation D g) (hg' : IsRegularLocalEquation D g') :
    ∃ u : Γ(X, U)ˣ, g = u * g' := by
  obtain ⟨hu, hf⟩ := hg
  obtain ⟨hu', hf'⟩ := hg'
  obtain ⟨u, hu₀⟩ := exists_units_eq_mul_inv hf hf'
  refine ⟨u, toK_injective U ?_⟩
  have h1 : toK U (u : Γ(X, U)) = (hu.unit : _) * ((hu'.unit⁻¹ : _ˣ) : _) := by
    simpa using congrArg Units.val hu₀
  rw [map_mul, h1, mul_assoc, Units.inv_mul_of_eq hu'.unit_spec, mul_one, hu.unit_spec]

/-- A local equation in `𝒪_X` is a non-zero-divisor. -/
theorem IsRegularLocalEquation.isRegular {D : X.CartierDivisor} {U : X.Opens} {g : Γ(X, U)}
    (hg : IsRegularLocalEquation D g) : IsRegular g := by
  obtain ⟨hu, -⟩ := hg
  refine isRegular_iff_mem_nonZeroDivisors.mpr (mem_nonZeroDivisors_iff.mpr
    ⟨fun a ha ↦ toK_injective U ?_, fun a ha ↦ toK_injective U ?_⟩)
  · rw [map_zero]
    exact (hu.mul_right_eq_zero).mp (by rw [← map_mul, ha, map_zero])
  · rw [map_zero]
    exact (hu.mul_left_eq_zero).mp (by rw [← map_mul, ha, map_zero])

/-- The ideal of `𝒪_X(U)` generated by the local equations of `D` on `U` which are sections of
`𝒪_X`. When `D` has such a local equation `g`, it is `g 𝒪_X(U)` (`localIdeal_eq_span`). -/
def localIdeal (D : X.CartierDivisor) (U : X.Opens) : Ideal Γ(X, U) :=
  Ideal.span {g | IsRegularLocalEquation D g}

/-- If `g ∈ 𝒪_X(U)` is a local equation of `D` on `U`, the ideal of local equations of `D` on `U`
is `g 𝒪_X(U)`. -/
theorem localIdeal_eq_span {D : X.CartierDivisor} {U : X.Opens} {g : Γ(X, U)}
    (hg : IsRegularLocalEquation D g) : localIdeal D U = Ideal.span {g} := by
  refine le_antisymm (Ideal.span_le.2 fun g' hg' ↦ ?_)
    (Ideal.span_le.2 (Set.singleton_subset_iff.2 (Ideal.subset_span hg)))
  obtain ⟨u, hu⟩ := IsRegularLocalEquation.exists_unit_mul hg' hg
  rw [SetLike.mem_coe, hu]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self g)

/-- The ideals of local equations are compatible with restriction. -/
theorem map_localIdeal {D : X.CartierDivisor} {U V : X.Opens} (hU : IsEffectiveOn D U)
    (h : V ≤ U) :
    (localIdeal D U).map (X.presheaf.map (homOfLE h).op).hom = localIdeal D V := by
  obtain ⟨g, hg⟩ := hU
  rw [localIdeal_eq_span hg, localIdeal_eq_span (hg.res h), Ideal.map_span, Set.image_singleton]

/-- Every point of `X` has an affine open neighbourhood on which the effective Cartier divisor
`D` has a local equation in `𝒪_X`. -/
theorem exists_affineOpens_isEffectiveOn {D : X.CartierDivisor} (hD : IsEffective D) (x : X) :
    ∃ U : X.affineOpens, IsEffectiveOn D U ∧ x ∈ (U : X.Opens) := by
  obtain ⟨V, hxV, hV⟩ := (isEffective_iff D).1 hD x
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.isOpen
  exact ⟨⟨W, hW⟩, hV.mono hWV, hxW⟩

/-- A local equation in `𝒪_X` on an affine open restricts to its standard opens. -/
theorem isEffectiveOn_affineBasicOpen (D : X.CartierDivisor) (U : X.affineOpens) (f : Γ(X, U))
    (hU : IsEffectiveOn D U) : IsEffectiveOn D (X.affineBasicOpen f) :=
  hU.mono (X.basicOpen_le f)

/-- `map_localIdeal` on affine opens, in the form `Scheme.IdealSheafData.ofAffineFamily` uses. -/
theorem map_localIdeal_affineOpens (D : X.CartierDivisor) (U V : X.affineOpens) (h : V ≤ U)
    (hU : IsEffectiveOn D U) (_ : IsEffectiveOn D V) :
    (localIdeal D U).map (X.presheaf.map (homOfLE h).op).hom = localIdeal D V :=
  map_localIdeal hU h

/-- **The closed subscheme of an effective Cartier divisor.** For an effective Cartier divisor
`D` with local equations `f_i ∈ 𝒪(U_i)`, the closed subscheme of `X` defined on `U_i` by the
ideal `f_i 𝒪_{U_i}`, as a quasi-coherent sheaf of ideals (`ideal_subscheme`). -/
def subscheme (D : X.CartierDivisor) (hD : IsEffective D) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofAffineFamily (fun U ↦ IsEffectiveOn D U) (fun U ↦ localIdeal D U)
    (exists_affineOpens_isEffectiveOn hD) (isEffectiveOn_affineBasicOpen D)
    (map_localIdeal_affineOpens D)

/-- On an affine open `U` on which the effective Cartier divisor `D` has the local equation
`g ∈ 𝒪(U)`, the closed subscheme of `D` is defined by the ideal `g 𝒪(U)`. The statement on an
arbitrary open is `ideal_subscheme`. -/
theorem ideal_subscheme_affine {D : X.CartierDivisor} (hD : IsEffective D) {U : X.affineOpens}
    {g : Γ(X, U)} (hg : IsRegularLocalEquation D g) :
    (subscheme D hD).ideal U = Ideal.span {g} := by
  rw [← localIdeal_eq_span hg, ← Scheme.IdealSheafData.ideal_ofAffineFamily (U := U)
    (fun U ↦ IsEffectiveOn D U) (fun U ↦ localIdeal D U) (exists_affineOpens_isEffectiveOn hD)
    (isEffectiveOn_affineBasicOpen D) (map_localIdeal_affineOpens D) ⟨g, hg⟩]
  rfl

/-- Membership in the sections of the ideal sheaf of a closed subscheme is local: a section of
`𝒪_X` over `U` lies in the ideal sheaf if its restrictions to the members of an open cover of `U`
do. -/
theorem mem_ker_subschemeι_app_of_cover (I : X.IdealSheafData) {U : X.Opens}
    (W : U → X.Opens) (hWU : ∀ y, W y ≤ U) (hcover : U ≤ iSup W) {s : Γ(X, U)}
    (hs : ∀ y, (X.presheaf.map (homOfLE (hWU y)).op).hom s ∈
      RingHom.ker (I.subschemeι.app (W y)).hom) :
    s ∈ RingHom.ker (I.subschemeι.app U).hom := by
  rw [RingHom.mem_ker]
  refine TopCat.Sheaf.eq_of_locally_eq' I.subscheme.sheaf (fun y ↦ I.subschemeι ⁻¹ᵁ W y)
    (I.subschemeι ⁻¹ᵁ U) (fun y ↦ homOfLE fun z hz ↦ hWU y hz) (fun z hz ↦ ?_) _ 0
    fun y ↦ ?_
  · obtain ⟨y, hy⟩ := Opens.mem_iSup.mp (hcover hz)
    exact Opens.mem_iSup.mpr ⟨y, hy⟩
  · have h2 := congrArg (fun φ ↦ φ.hom s) (I.subschemeι.naturality (homOfLE (hWU y)).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at h2
    have h3 := hs y
    rw [RingHom.mem_ker, h2] at h3
    exact h3.trans (map_zero _).symm

/-- A section `s` of `𝒪_X` over `U` is a multiple of `g` if its restrictions to the members of an
open cover of `U` are multiples of the restrictions of `g`, and every restriction of `g` is a
non-zero-divisor. -/
theorem mem_span_singleton_of_cover {U : X.Opens} {g s : Γ(X, U)} (W : U → X.Opens)
    (hWU : ∀ y, W y ≤ U) (hcover : U ≤ iSup W)
    (hreg : ∀ (V : X.Opens) (h : V ≤ U), IsRegular ((X.presheaf.map (homOfLE h).op).hom g))
    (hs : ∀ y, (X.presheaf.map (homOfLE (hWU y)).op).hom s ∈
      Ideal.span {(X.presheaf.map (homOfLE (hWU y)).op).hom g}) :
    s ∈ Ideal.span {g} := by
  have hres : ∀ {V V' : X.Opens} (h₁ : V ≤ U) (h₂ : V' ≤ V) (t : Γ(X, U)),
      (X.presheaf.map (homOfLE h₂).op).hom ((X.presheaf.map (homOfLE h₁).op).hom t) =
        (X.presheaf.map (homOfLE (h₂.trans h₁)).op).hom t := by
    intro V V' h₁ h₂ t
    rw [← CommRingCat.comp_apply, ← X.presheaf.map_comp]
    rfl
  choose c hc using fun y ↦ Ideal.mem_span_singleton.mp (hs y)
  have hcompat : TopCat.Presheaf.IsCompatible X.presheaf W c := by
    intro y y'
    have hle : W y ⊓ W y' ≤ U := inf_le_left.trans (hWU y)
    refine (hreg _ hle).right.eq_iff.mp ?_
    have k1 := congrArg
      (fun z ↦ (X.presheaf.map (Opens.infLELeft (W y) (W y')).op).hom z) (hc y)
    have k2 := congrArg
      (fun z ↦ (X.presheaf.map (Opens.infLERight (W y) (W y')).op).hom z) (hc y')
    simp only [map_mul] at k1 k2
    have eL : Opens.infLELeft (W y) (W y') = homOfLE inf_le_left := rfl
    have eR : Opens.infLERight (W y) (W y') = homOfLE inf_le_right := rfl
    rw [eL, hres, hres] at k1
    rw [eR, hres, hres] at k2
    simp only [eL, eR]
    rw [mul_comm, ← k1, k2, mul_comm]
  obtain ⟨c₀, hc₀, -⟩ :=
    X.sheaf.existsUnique_gluing' W U (fun y ↦ homOfLE (hWU y)) hcover c hcompat
  obtain ⟨c₁, rfl⟩ : ∃ c₁ : Γ(X, U), c₁ = c₀ := ⟨c₀, rfl⟩
  refine Ideal.mem_span_singleton.mpr ⟨c₁, ?_⟩
  refine TopCat.Sheaf.eq_of_locally_eq' X.sheaf W U (fun y ↦ homOfLE (hWU y)) hcover
    s _ fun y ↦ ?_
  change (X.presheaf.map (homOfLE (hWU y)).op).hom s =
    (X.presheaf.map (homOfLE (hWU y)).op).hom (g * c₁)
  rw [map_mul, hc y]
  congr 1
  exact (hc₀ y).symm

/-- **The closed subscheme of an effective Cartier divisor is cut out by its local equations.**
On every open `U` on which the effective Cartier divisor `D` has a local equation `g ∈ 𝒪(U)`
(affine or not), the sections over `U` of the ideal sheaf of the closed subscheme of `D` are the
multiples of `g`: the ideal sheaf is `g 𝒪_U` on `U`. -/
theorem ideal_subscheme {D : X.CartierDivisor} (hD : IsEffective D) {U : X.Opens}
    {g : Γ(X, U)} (hg : IsRegularLocalEquation D g) :
    RingHom.ker ((subscheme D hD).subschemeι.app U).hom = Ideal.span {g} := by
  set I := subscheme D hD
  have hex : ∀ y : U, ∃ W : X.Opens, IsAffineOpen W ∧ (y : X) ∈ W ∧ W ≤ U := fun y ↦ by
    obtain ⟨_, ⟨W, hW, rfl⟩, hyW, hWU⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open y.2 U.isOpen
    exact ⟨W, hW, hyW, hWU⟩
  choose W hWa hyW hWU' using hex
  have hcover : U ≤ iSup W := fun y hy ↦ Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hyW ⟨y, hy⟩⟩
  have hker : ∀ y, RingHom.ker (I.subschemeι.app (W y)).hom =
      Ideal.span {(X.presheaf.map (homOfLE (hWU' y)).op).hom g} := fun y ↦
    (I.ker_subschemeι_app ⟨W y, hWa y⟩).trans
      (ideal_subscheme_affine hD (U := ⟨W y, hWa y⟩) (hg.res (hWU' y)))
  refine le_antisymm (fun s hs ↦ mem_span_singleton_of_cover W hWU' hcover
    (fun V h ↦ (hg.res h).isRegular) fun y ↦ ?_) ?_
  · rw [← hker y]
    exact Stacks.Divisors.mem_ker_app_res I (hWU' y) hs
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine mem_ker_subschemeι_app_of_cover I W hWU' hcover fun y ↦ ?_
    rw [hker y]
    exact Ideal.mem_span_singleton_self _

/-- On every open `V` contained in an affine open `U` on which `D` has the local equation
`g ∈ 𝒪(U)`, the sections over `V` of the ideal sheaf of the closed subscheme of `D` are the
multiples of `g|_V`. -/
theorem ker_subschemeι_app {D : X.CartierDivisor} (hD : IsEffective D) {U : X.affineOpens}
    {g : Γ(X, U)} (hg : IsRegularLocalEquation D g) (V : X.Opens) (hVU : V ≤ U) :
    RingHom.ker ((subscheme D hD).subschemeι.app V).hom =
      Ideal.span {(X.presheaf.map (homOfLE hVU).op).hom g} :=
  Stacks.Divisors.ker_app_eq_span_res _ U.2 hg.isRegular (ideal_subscheme_affine hD hg) V hVU

/-- The closed subscheme of `D` is the only sheaf of ideals which is `g 𝒪(U)` on every affine
open `U` on which `D` has a local equation `g ∈ 𝒪(U)`. -/
theorem eq_subscheme_iff {D : X.CartierDivisor} (hD : IsEffective D) (I : X.IdealSheafData) :
    I = subscheme D hD ↔ ∀ (U : X.affineOpens) (g : Γ(X, U)), IsRegularLocalEquation D g →
      I.ideal U = Ideal.span {g} := by
  refine ⟨fun h U g hg ↦ h ▸ ideal_subscheme_affine hD hg, fun h ↦ ?_⟩
  refine Scheme.IdealSheafData.eq_ofAffineFamily _ _ _ _ _ I fun U ⟨g, hg⟩ ↦ ?_
  rw [h U g hg, localIdeal_eq_span hg]

/-- The closed subscheme of an effective Cartier divisor is an effective Cartier divisor: its
ideal sheaf is invertible. -/
theorem isEffectiveCartierDivisor_subscheme {D : X.CartierDivisor} (hD : IsEffective D) :
    Stacks.Divisors.IsEffectiveCartierDivisor (subscheme D hD) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun x ↦ ?_
  obtain ⟨U, hU, hxU⟩ := exists_affineOpens_isEffectiveOn hD x
  obtain ⟨g, hg⟩ := hU
  exact ⟨U, U.2, hxU, g, hg.isRegular, ideal_subscheme_affine hD hg⟩

/-- On an affine open, a non-zero-divisor of `𝒪_X(U)` is a unit of `𝒦_X(U)`. -/
theorem isUnit_toK_of_isRegular {U : X.Opens} (hU : IsAffineOpen U)
    {g : Γ(X, U)} (hg : IsRegular g) : IsUnit (toK U g) := by
  letI : Algebra Γ(X, U) (X.presheaf.totalQuotientPresheaf.obj (op U)) :=
    (X.presheaf.toTotalQuotientPresheaf.app (op U)).hom.toAlgebra
  haveI := isLocalization_totalQuotientPresheaf_obj_of_isAffineOpen X U hU
  have h1 : IsUnit (algebraMap Γ(X, U) (X.presheaf.totalQuotientPresheaf.obj (op U)) g) :=
    IsLocalization.map_units _
      (⟨g, isRegular_iff_mem_nonZeroDivisors.mp hg⟩ : nonZeroDivisors Γ(X, U))
  exact h1.map ((toSheafify (Opens.grothendieckTopology X)
    X.presheaf.totalQuotientPresheaf).app (op U)).hom

/-- **Fulton's definition.** A closed subscheme `Z` of `X` is an effective Cartier divisor (its
ideal sheaf is invertible) if and only if it is the closed subscheme of some effective Cartier
divisor on `X`. -/
theorem isEffectiveCartierDivisor_iff_exists_subscheme_eq (I : X.IdealSheafData) :
    Stacks.Divisors.IsEffectiveCartierDivisor I ↔
      ∃ (D : X.CartierDivisor) (hD : IsEffective D), subscheme D hD = I := by
  refine ⟨fun h ↦ ?_, fun ⟨D, hD, e⟩ ↦ e ▸ isEffectiveCartierDivisor_subscheme hD⟩
  choose U hU hxU g hg hgen using
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I h
  have hunit : ∀ x, IsUnit (toK (U x) (g x)) := fun x ↦ isUnit_toK_of_isRegular (hU x) (hg x)
  have hcov : iSup U = ⊤ := eq_top_iff.mpr fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩
  have hcompat : ∀ i j, ∃ u : Γ(X, U i ⊓ U j)ˣ,
      resUnit (homOfLE inf_le_left) (hunit i).unit =
        Units.map (toTotalQuotient (U i ⊓ U j)).toMonoidHom u *
          resUnit (homOfLE inf_le_right) (hunit j).unit := by
    intro i j
    set V := U i ⊓ U j
    set gi := (X.presheaf.map (homOfLE (inf_le_left : V ≤ U i)).op).hom (g i)
    set gj := (X.presheaf.map (homOfLE (inf_le_right : V ≤ U j)).op).hom (g j)
    have hi := Stacks.Divisors.ker_app_eq_span_res I (hU i) (hg i) (hgen i) V inf_le_left
    have hj := Stacks.Divisors.ker_app_eq_span_res I (hU j) (hg j) (hgen j) V inf_le_right
    have hij : Ideal.span {gi} = Ideal.span {gj} := hi.symm.trans hj
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hij ▸ Ideal.mem_span_singleton_self gi)
    obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp (hij ▸ Ideal.mem_span_singleton_self gj)
    have hcc' : c' * c = 1 := Stacks.Divisors.injective_mul_res (hU j) (hg j) V inf_le_right
      (by simp only; rw [mul_assoc, hc, hc', one_mul])
    let u : Γ(X, V)ˣ := ⟨c, c', by rw [mul_comm, hcc'], hcc'⟩
    refine ⟨u, Units.ext ?_⟩
    change resK inf_le_left (toK (U i) (g i)) =
      toK V (u : Γ(X, V)) * resK inf_le_right (toK (U j) (g j))
    rw [resK_toK, resK_toK, ← map_mul]
    exact congrArg (toK V) hc.symm
  obtain ⟨D, hD, -⟩ := existsUnique_isLocalEquationOn U hcov (fun x ↦ (hunit x).unit) hcompat
  have hreg : ∀ x, IsRegularLocalEquation D (g x) := fun x ↦ ⟨hunit x, hD x⟩
  have hDeff : IsEffective D := (isEffective_iff D).2 fun x ↦ ⟨U x, hxU x, g x, hreg x⟩
  refine ⟨D, hDeff, Scheme.IdealSheafData.ext_of_iSup_eq_top (fun x ↦ ⟨U x, hU x⟩) hcov
    fun x ↦ ?_⟩
  rw [hgen x]
  exact ideal_subscheme_affine hDeff (U := ⟨U x, hU x⟩) (hreg x)

/-! ### The canonical section -/

/-- For effective `D`, `1 ∈ 𝒦_X` is a global section of `𝒪_X(D)`: locally `1 = f · f⁻¹` with
`f ∈ 𝒪_X`. -/
@[mmp "lem_p01a_effective_divisor_canonical_section"]
theorem mem_one_top_of_isEffective {D : X.CartierDivisor} (hD : IsEffective D) :
    Mem D ⊤ 1 := by
  intro W h f hf
  rw [map_one, one_mul]
  refine mem_range_toK_of_locally _ fun x hx ↦ ?_
  obtain ⟨U, hxU, c, hc, hg⟩ := hD x
  obtain ⟨u, hu⟩ := exists_units_eq_mul_inv
    (isLocalEquation_restrict (inf_le_left : W ⊓ U ≤ W) hf)
    (isLocalEquation_restrict (inf_le_right : W ⊓ U ≤ U) hg)
  refine ⟨W ⊓ U, inf_le_left, ⟨hx, hxU⟩, u.val * X.presheaf.map (homOfLE inf_le_right).op c, ?_⟩
  have hu' : toK (W ⊓ U) u.val = resK inf_le_left (f : X.totalQuotientSheaf.obj.obj (op W)) *
      resK (inf_le_right : W ⊓ U ≤ U) ↑hc.unit⁻¹ := by
    have := congrArg Units.val hu
    simp only [Units.coe_map, MonoidHom.coe_coe, Units.val_mul, Units.coe_map_inv] at this
    exact this
  have hc' : toK (W ⊓ U) (X.presheaf.map (homOfLE (inf_le_right : W ⊓ U ≤ U)).op c) =
      resK inf_le_right (hc.unit : X.totalQuotientSheaf.obj.obj (op U)) := by
    rw [IsUnit.unit_spec]
    exact (resK_toK _ c).symm
  rw [map_mul, hc', hu', mul_assoc, ← map_mul, Units.inv_mul, map_one, mul_one]

/-- **The canonical section `1_D`** of `𝒪_X(D)` for an effective Cartier divisor `D`: the global
section `1 ∈ 𝒦_X`. -/
@[mmp "lem_p01a_effective_divisor_canonical_section"]
def canonicalSection (D : X.CartierDivisor) (hD : IsEffective D) :
    Γ(CartierDivisor.sheaf D, ⊤) :=
  (⟨(1 : X.totalQuotientSheaf.obj.obj (op ⊤)), mem_one_top_of_isEffective hD⟩ :
    ↥((CartierDivisor.sheafSubmodule D).obj (op ⊤)))

/-- The canonical section `canonicalSection D hD`, viewed as an element of `𝒦_X(X)`, is `1`. -/
@[mmp "lem_p01a_effective_divisor_canonical_section"]
theorem canonicalSection_val (D : X.CartierDivisor) (hD : IsEffective D) :
    (show ↥((CartierDivisor.sheafSubmodule D).obj (op ⊤)) from canonicalSection D hD).1 =
      (1 : X.totalQuotientSheaf.obj.obj (op ⊤)) :=
  rfl

end MMP.CartierDivisor
