module

public import MMP.AlgebraicGeometry.Divisor.Cartier
public import MMP.AlgebraicGeometry.Divisor.Coefficients
public import MMP.AlgebraicGeometry.Divisor.Cycles
public import MMP.AlgebraicGeometry.Divisor.LineBundle
public import MMP.AlgebraicGeometry.Divisor.DivisorialValuation
public import MMP.AlgebraicGeometry.Divisor.OrderPullback
public import MMP.AlgebraicGeometry.Divisor.CartierLineBundle
public import MMP.AlgebraicGeometry.Divisor.PullbackExistence
public import MMP.AlgebraicGeometry.Modules.AssociatedPoints
public import Mathlib.LinearAlgebra.Projectivization.Basic

/-!
# Linear series, base loci, global generation and (very) ampleness (Lazarsfeld §1.1, §1.2)

Let `k` be a field and `X` a scheme over `Spec k`. For an `𝒪_X`-module `L`, the space of global
sections `H⁰(X, L) = Γ(X, L)` is a `Γ(X, 𝒪_X)`-module, and it is a `k`-vector space through the
ring map `k ≅ Γ(Spec k, 𝒪) ⟶ Γ(X, 𝒪_X)` given by the structure morphism `X ⟶ Spec k`
(`MMP.Intersection.structureRingHom`). This `k`-vector space is `MMP.Intersection.H0 k L`.

## Main definitions

* `MMP.Intersection.LinearSeries k L`: a non-zero finite-dimensional `k`-subspace
  `V ⊆ H⁰(X, L)`; `MMP.Intersection.LinearSeries.proj` is `|V| = ℙ_sub(V)`, the projective space
  of one-dimensional subspaces of `V`, and `MMP.Intersection.LinearSeries.eval` the evaluation
  map `V ⊗_k 𝒪_X ⟶ L`.
* `MMP.Intersection.completeLinearSeries`, `MMP.Intersection.completeLinearSeriesOfDivisor`,
  `MMP.Intersection.MemCompleteLinearSeries`: `|L|`, `|D|` and `E ∈ |D|`.
* `MMP.Intersection.baseIdeal`, `MMP.Intersection.LinearSeries.baseIdeal`: the base ideal
  `𝔟(|V|) ⊆ 𝒪_X`; `MMP.Intersection.baseLocus`, `MMP.Intersection.baseScheme`: `Bs(|V|)`.
* `MMP.Intersection.LinearSeries.IsFree`: `|V|` is free (basepoint-free).
* `MMP.Intersection.IsGloballyGeneratedLineBundle`, `MMP.Intersection.IsGloballyGeneratedAt`,
  `MMP.Intersection.IsGloballyGenerated`: global generation of line bundles, divisors, sheaves.
* `MMP.Intersection.IsVeryAmple`, `MMP.Intersection.IsAmple`: Lazarsfeld Def. 1.2.1.

## Implementation notes

* **The base ideal.** For a line bundle `L` and `V ⊆ H⁰(X, L)`, the image of
  `V ⊗ L^* ⟶ 𝒪_X` has, at a point `x` where `L` is trivialized near `x` by a generator `e`, the
  stalk generated by the germs of the functions `s / e` for `s ∈ V` (a different generator changes
  these by one unit). The stalk `𝔟_x` is defined as the ideal of `𝒪_{X,x}` generated by the germs
  `s / e` over all trivializing generators `e` near `x`, and a function lies in `𝔟(U)` when all its
  germs lie in the `𝔟_x`, which is how the sections of a subsheaf of `𝒪_X` are determined by its
  stalks. The ideal sheaf is `Scheme.IdealSheafData.ofIdeals` of these ideals; since they are the
  sections of an ideal sheaf, `ofIdeals` returns them unchanged (`ofIdeals_ideal`).
* **The evaluation map.** `V ⊗_k 𝒪_X` is the free `𝒪_X`-module on a `k`-basis of `V`; the
  evaluation map sends the basis vector `vᵢ ⊗ 1` to the section `vᵢ`.
* **Finite-dimensionality.** The base ideal, base locus, global generation and the complete
  base ideal `𝔟(|L|)` are defined for every subspace of `H⁰(X, L)`, finite-dimensional or not.
  On a complete scheme `H⁰(X, L)` is finite-dimensional, so this is a generalization.
* **Very ampleness.** `ℙᴺ_k` is `MMP.Intersection.ProjSpace k (ULift (Fin (N + 1)))`, its Serre
  line bundle `𝒪(1)` the Stacks project's twisting sheaf `𝒪_{Proj S}(1)` of the polynomial ring,
  and the closed embedding is required to be a morphism over `k`. The completeness of `X` in
  Lazarsfeld's definition is not assumed (a generalization).
-/

@[expose] public noncomputable section

universe u

open CategoryTheory TopologicalSpace AlgebraicGeometry

namespace MMP.Intersection

open Scheme.Modules (tensorPow)

variable (k : Type u) [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))]

/-! ### The `k`-vector space of global sections -/

/-- The ring map `k ≅ Γ(Spec k, 𝒪) ⟶ Γ(X, 𝒪_X)` given by the structure morphism `X ⟶ Spec k`. -/
def structureRingHom : k →+* Γ(X, ⊤) :=
  (X ↘ Spec (.of k)).appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom

/-- `H⁰(X, L) = Γ(X, L)`, regarded as a `k`-vector space through
`MMP.Intersection.structureRingHom`. -/
@[mmp "def_p01a_linear_series"]
def H0 (k : Type u) [Field k] {X : Scheme.{u}} [X.Over (Spec (.of k))] (L : X.Modules) : Type u :=
  Γ(L, ⊤)

/-- The additive group structure on `H⁰(X, L)`, that of `Γ(X, L)`. -/
instance instAddCommGroupH0 (L : X.Modules) : AddCommGroup (H0 k L) :=
  inferInstanceAs (AddCommGroup Γ(L, ⊤))

/-- `H⁰(X, L)` is a `Γ(X, 𝒪_X)`-module, as `Γ(X, L)` is. -/
instance instModuleGlobalSectionsH0 (L : X.Modules) : Module Γ(X, ⊤) (H0 k L) :=
  inferInstanceAs (Module Γ(X, ⊤) Γ(L, ⊤))

/-- `H⁰(X, L)` is a `k`-vector space through `k ⟶ Γ(X, 𝒪_X)`. -/
@[mmp "def_p01a_linear_series"]
instance instModuleH0 (L : X.Modules) : Module k (H0 k L) :=
  Module.compHom _ (structureRingHom k (X := X))

variable {k}

/-- The restriction `s|_U ∈ Γ(U, L)` of a global section. -/
def H0.res {L : X.Modules} (s : H0 k L) (U : X.Opens) : Γ(L, U) :=
  L.presheaf.map (homOfLE le_top).op (show Γ(L, ⊤) from s)

/-- A global section as a compatible family of sections over all opens. -/
def H0.toSections {L : X.Modules} (s : H0 k L) : SheafOfModules.sections L :=
  PresheafOfModules.sectionsMk (fun U => H0.res s U.unop) fun U V f => by
    change L.presheaf.map f (L.presheaf.map _ (show Γ(L, ⊤) from s)) =
      L.presheaf.map _ (show Γ(L, ⊤) from s)
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl

variable (k)

/-! ### Linear series -/

/-- A *linear series* (Lazarsfeld §1.1.B) of an `𝒪_X`-module `L` (in the source, a line bundle):
a non-zero finite-dimensional `k`-subspace `V ⊆ H⁰(X, L)`. -/
@[ext, mmp "def_p01a_linear_series"]
structure LinearSeries (L : X.Modules) where
  /-- The subspace `V ⊆ H⁰(X, L)`. -/
  space : Submodule k (H0 k L)
  /-- The subspace `V` is finite-dimensional. -/
  finiteDimensional : FiniteDimensional k space
  /-- The subspace `V` is non-zero. -/
  ne_bot : space ≠ ⊥

variable {k}

namespace LinearSeries

variable {L : X.Modules} (V : LinearSeries k L)

instance : FiniteDimensional k V.space :=
  V.finiteDimensional

/-- The linear series `|V| = ℙ_sub(V)`: the projective space of one-dimensional subspaces of
`V`. -/
@[mmp "def_p01a_linear_series"]
abbrev proj : Type u := Projectivization k V.space

/-- The evaluation map `eval_V : V ⊗_k 𝒪_X ⟶ L`, `s ⊗ g ↦ g s`. Here `V ⊗_k 𝒪_X` is the free
`𝒪_X`-module on a `k`-basis `(vᵢ)` of `V`, and `vᵢ ⊗ 1 ↦ vᵢ`. -/
@[mmp "def_p01a_linear_series"]
def eval : SheafOfModules.free (Module.Free.ChooseBasisIndex k V.space) ⟶ L :=
  L.freeHomEquiv.symm fun i => H0.toSections ((Module.Free.chooseBasis k V.space i : V.space) :
    H0 k L)

end LinearSeries

/-! ### Complete linear series -/

variable (k) in
/-- The *complete linear series* `|L| = |H⁰(X, L)|`, when `H⁰(X, L)` is finite-dimensional and
non-zero (Lazarsfeld §1.1.B). -/
@[mmp "def_p01a_complete_linear_series"]
def completeLinearSeries (L : X.Modules) [FiniteDimensional k (H0 k L)] [Nontrivial (H0 k L)] :
    LinearSeries k L where
  space := ⊤
  finiteDimensional := inferInstance
  ne_bot := top_ne_bot

@[simp]
theorem completeLinearSeries_space (L : X.Modules) [FiniteDimensional k (H0 k L)]
    [Nontrivial (H0 k L)] : (completeLinearSeries k L).space = ⊤ :=
  rfl

variable (k) in
/-- The complete linear series `|D| = |𝒪_X(D)|` of a Cartier divisor. -/
@[mmp "def_p01a_complete_linear_series"]
abbrev completeLinearSeriesOfDivisor (D : X.CartierDivisor)
    [FiniteDimensional k (H0 k (MMP.CartierDivisor.sheaf D))]
    [Nontrivial (H0 k (MMP.CartierDivisor.sheaf D))] :
    LinearSeries k (MMP.CartierDivisor.sheaf D) :=
  completeLinearSeries k (MMP.CartierDivisor.sheaf D)

variable (k) in
/-- `E ∈ |D|`: `E = div(s)` for a regular section `0 ≠ s ∈ H⁰(X, 𝒪_X(D))`. -/
@[mmp "def_p01a_complete_linear_series"]
def MemCompleteLinearSeries (D E : X.CartierDivisor) : Prop :=
  ∃ s : H0 k (MMP.CartierDivisor.sheaf D),
    s ≠ 0 ∧ IsDivisorOfSection (MMP.CartierDivisor.sheaf D) s E

/-! ### Base ideals and base loci -/

/-- The stalk at `x` of the base ideal of `V ⊆ H⁰(X, L)`: the ideal of `𝒪_{X,x}` generated by the
germs at `x` of `s / e` for `s ∈ V` and `e` a generator of `L` on an open neighbourhood of `x`. -/
def baseIdealStalk {L : X.Modules} (V : Submodule k (H0 k L)) (x : X) :
    Ideal (X.presheaf.stalk x) :=
  Ideal.span {g | ∃ (W : X.Opens) (hx : x ∈ W) (e : Γ(L, W)) (r : Γ(X, W)) (s : H0 k L),
    s ∈ V ∧ IsTrivializingGenerator L W e ∧ H0.res s W = r • e ∧ X.presheaf.germ W x hx r = g}

/-- The *base ideal* `𝔟(|V|) ⊆ 𝒪_X` of `V ⊆ H⁰(X, L)`, for a line bundle `L` (Lazarsfeld Def.
1.1.8): the image of `V ⊗ L^* ⟶ 𝒪_X` induced by `eval_V`. Its sections over an affine open `U`
are the functions whose germ at every `x ∈ U` lies in the stalk `𝔟_x`, generated by the germs of
`s / e` for `s ∈ V` and `e` a local generator of `L` at `x`. -/
@[mmp "def_p01a_base_ideal"]
def baseIdeal {L : X.Modules} (V : Submodule k (H0 k L)) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun U =>
    ⨅ (x : X) (hx : x ∈ (U : X.Opens)),
      Ideal.comap (X.presheaf.germ (U : X.Opens) x hx).hom (baseIdealStalk V x)

/-- The base ideal `𝔟(|V|)` of a linear series. -/
@[mmp "def_p01a_base_ideal"]
abbrev LinearSeries.baseIdeal {L : X.Modules} (V : LinearSeries k L) : X.IdealSheafData :=
  MMP.Intersection.baseIdeal V.space

variable (k) in
/-- The base ideal `𝔟(|L|)` of the complete linear series, `𝔟(|H⁰(X, L)|)`. -/
@[mmp "def_p01a_base_ideal"]
abbrev completeBaseIdeal (L : X.Modules) : X.IdealSheafData :=
  baseIdeal (⊤ : Submodule k (H0 k L))

variable (k) in
/-- The base ideal `𝔟(|D|) = 𝔟(|𝒪_X(D)|)` of a Cartier divisor. -/
@[mmp "def_p01a_base_ideal"]
abbrev completeBaseIdealOfDivisor (D : X.CartierDivisor) : X.IdealSheafData :=
  completeBaseIdeal k (MMP.CartierDivisor.sheaf D)

/-- The *base locus* `Bs(|V|) ⊆ X` (Lazarsfeld Def. 1.1.8): the closed subset cut out by
`𝔟(|V|)`. -/
@[mmp "def_p01a_base_locus"]
abbrev baseLocus {L : X.Modules} (V : Submodule k (H0 k L)) : Closeds X :=
  (baseIdeal V).support

/-- The *base scheme* of `|V|`: the closed subscheme defined by `𝔟(|V|)`. -/
@[mmp "def_p01a_base_locus"]
abbrev baseScheme {L : X.Modules} (V : Submodule k (H0 k L)) : Scheme.{u} :=
  (baseIdeal V).subscheme

/-- The base locus `Bs(|V|)` of a linear series. -/
@[mmp "def_p01a_base_locus"]
abbrev LinearSeries.baseLocus {L : X.Modules} (V : LinearSeries k L) : Closeds X :=
  MMP.Intersection.baseLocus V.space

/-- The base scheme of a linear series. -/
@[mmp "def_p01a_base_locus"]
abbrev LinearSeries.baseScheme {L : X.Modules} (V : LinearSeries k L) : Scheme.{u} :=
  MMP.Intersection.baseScheme V.space

/-! ### Free linear series and global generation -/

/-- A linear series `|V|` is *free* (basepoint-free; Lazarsfeld Def. 1.1.10) if
`𝔟(|V|) = 𝒪_X`. -/
@[mmp "def_p01a_free_linear_series"]
def LinearSeries.IsFree {L : X.Modules} (V : LinearSeries k L) : Prop :=
  V.baseIdeal = ⊤

/-- `|V|` is free if and only if `Bs(|V|) = ∅`. -/
@[mmp "def_p01a_free_linear_series"]
theorem LinearSeries.isFree_iff_baseLocus_eq_bot {L : X.Modules} (V : LinearSeries k L) :
    V.IsFree ↔ V.baseLocus = ⊥ :=
  (Scheme.IdealSheafData.support_eq_bot_iff _).symm

variable (k) in
/-- A line bundle `L` is *free*, or *globally generated* (Lazarsfeld Def. 1.1.10), if
`H⁰(X, L) ≠ 0` and `|L|` is free, i.e. `𝔟(|L|) = 𝒪_X`. -/
@[mmp "def_p01a_globally_generated"]
def IsGloballyGeneratedLineBundle (L : X.Modules) : Prop :=
  Nontrivial (H0 k L) ∧ completeBaseIdeal k L = ⊤

variable (k) in
/-- A Cartier divisor `D` is *free*, or *globally generated*, if `𝒪_X(D)` is. -/
@[mmp "def_p01a_globally_generated"]
abbrev IsGloballyGeneratedDivisor (D : X.CartierDivisor) : Prop :=
  IsGloballyGeneratedLineBundle k (MMP.CartierDivisor.sheaf D)

omit [X.Over (Spec (.of k))] in
/-- An `𝒪_X`-module `F` is *globally generated at* the points of `S ⊆ X` (Lazarsfeld Def. 1.1.10)
if `H⁰(X, F) ⊗ 𝒪_X ⟶ F` is surjective at every `x ∈ S`: every germ at `x` of a section of `F`
is an `𝒪_{X,x}`-linear combination of germs of global sections, i.e. on some smaller
neighbourhood the section is `∑ rᵢ sᵢ` with `sᵢ ∈ H⁰(X, F)`. -/
@[mmp "def_p01a_globally_generated"]
def IsGloballyGeneratedAt (F : X.Modules) (S : Set X) : Prop :=
  ∀ x ∈ S, ∀ (U : X.Opens), x ∈ U → ∀ t : Γ(F, U),
    ∃ (W : X.Opens) (hWU : W ≤ U) (_ : x ∈ W) (n : ℕ) (s : Fin n → Γ(F, ⊤)) (r : Fin n → Γ(X, W)),
      F.presheaf.map (homOfLE hWU).op t =
        ∑ i, r i • F.presheaf.map (homOfLE le_top).op (s i)

omit [X.Over (Spec (.of k))] in
/-- An `𝒪_X`-module `F` is *globally generated* if `H⁰(X, F) ⊗ 𝒪_X ⟶ F` is surjective. -/
@[mmp "def_p01a_globally_generated"]
abbrev IsGloballyGenerated (F : X.Modules) : Prop :=
  IsGloballyGeneratedAt F Set.univ

/-! ### Very ample and ample line bundles -/

section Ample

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k)

/-- The structure morphism `ℙ^ι_k = Proj k[xᵢ] ⟶ Spec k`. -/
def ProjSpace.toSpec (ι : Type u) : ProjSpace k ι ⟶ Spec (.of k) :=
  Proj.toSpecZero (MvPolynomial.homogeneousSubmodule ι k) ≫
    Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial.homogeneousSubmodule ι k 0)))

/-- The Serre line bundle `𝒪_{ℙ^ι_k}(1)`: the twisting sheaf `𝒪_{Proj S}(1)` for
`S = k[xᵢ : i ∈ ι]`. -/
def ProjSpace.twistOne (ι : Type u) : (ProjSpace k ι).Modules :=
  ProjectiveSpectrum.Proj.twistingSheaf (MvPolynomial.homogeneousSubmodule ι k) 1

/-- A line bundle `L` on `X` is *very ample* (Lazarsfeld Def. 1.2.1(i)) if there is a closed
embedding `ι : X ↪ ℙᴺ_k` over `k` with `L ≅ ι^* 𝒪_{ℙᴺ}(1)`. -/
@[mmp "def_p01a_very_ample"]
def IsVeryAmple (L : X.Modules) : Prop :=
  ∃ (N : ℕ) (ι : X ⟶ ProjSpace k (ULift.{u} (Fin (N + 1)))),
    IsClosedImmersion ι ∧ ι ≫ ProjSpace.toSpec k _ = X ↘ Spec (.of k) ∧
      Nonempty (L ≅ (Scheme.Modules.pullback ι).obj (ProjSpace.twistOne k _))

/-- A Cartier divisor `D` is *very ample* if `𝒪_X(D)` is. -/
@[mmp "def_p01a_very_ample"]
abbrev IsVeryAmpleDivisor (D : X.CartierDivisor) : Prop :=
  IsVeryAmple k (MMP.CartierDivisor.sheaf D)

/-- A line bundle `L` is *ample* (Lazarsfeld Def. 1.2.1(ii)) if `L^{⊗m}` is very ample for some
integer `m > 0`. -/
@[mmp "def_p01a_ample"]
def IsAmple (L : X.Modules) : Prop :=
  ∃ m : ℕ, 0 < m ∧ IsVeryAmple k (tensorPow L m)

/-- A Cartier divisor `D` is *ample* if `𝒪_X(D)` is. -/
@[mmp "def_p01a_ample"]
abbrev IsAmpleDivisor (D : X.CartierDivisor) : Prop :=
  IsAmple k (MMP.CartierDivisor.sheaf D)

end Ample

end MMP.Intersection
