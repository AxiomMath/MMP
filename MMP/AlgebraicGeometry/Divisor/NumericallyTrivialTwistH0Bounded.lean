/-!
# Sections of a numerically trivial twist are bounded

Let `X` be a smooth projective variety over an algebraically closed field `k` of characteristic
zero, `D` a divisor and `N` a numerically trivial divisor on `X`. Then `h⁰(X, 𝒪_X(D + uN))` is
bounded as `u` ranges over `ℤ`.

The proof is by induction on `dim X`. In dimension zero every divisor vanishes. In positive
dimension `n` choose an ample `𝒪_X(A)` generated by finitely many global sections. The degree
`J(E) = (E · A^{n-1})` is additive, vanishes on `N`, is positive on `A`, and `h⁰(X, 𝒪_X(E)) = 0`
when `J(E) < 0`, since a nonzero section cuts out an effective Cartier divisor of nonnegative
degree. By Bertini a section of `𝒪_X(A)` has a smooth zero scheme `Y`, and the sequence
`0 → 𝒪_X(E - A) → 𝒪_X(E) → 𝒪_Y(E) → 0` gives
`h⁰(X, 𝒪_X(E)) ≤ h⁰(X, 𝒪_X(E - A)) + h⁰(Y, 𝒪_Y(E))`. The scheme `Y` is the finite disjoint union
of its connected components, smooth projective varieties of smaller dimension on which `N`
restricts to a numerically trivial divisor.

## Implementation notes

Instead of one smooth member of `|mH|`, the proof takes a smooth member `Y` of `|A|` for an ample
`𝒪_X(A)` generated by finitely many sections, and applies
`h⁰(X, 𝒪_X(E)) ≤ h⁰(X, 𝒪_X(E - A)) + h⁰(Y, 𝒪_Y(E))` to `E = D - jA + uN` for `j < m`, where
`m` is chosen with `((D - mA) · A^{n-1}) < 0`; this gives
`h⁰(X, 𝒪_X(D + uN)) ≤ ∑_{j < m} h⁰(Y, 𝒪_Y(D - jA + uN))`, each term bounded by induction. The
restriction of `𝒪_X(D')` to a component `Z` of `Y` is represented by a divisor of `Z`, chosen once
for `D'` and once for `N`, since every invertible sheaf on a smooth variety is divisorial.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], proof of
  Proposition 2.57
-/

namespace MMP.Mori.H0NumericallyTrivialBounded

open CategoryTheory AlgebraicGeometry MMP.Mori

universe u

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k]

/-- The invertibility of `L` in the spelling the zero scheme takes. -/
local instance {X : Scheme.{u}} {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] :
    SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
  (inferInstance : Stacks.Ample.IsInvertibleModule X L)

/-! ### Global sections as `k`-vector spaces -/

section Sections

variable (k) in
/-- `h⁰(Y, F)`: the dimension over `k` of the global sections of `F`, a `k`-vector space through
`g : Y ⟶ Spec k`. -/
private noncomputable def h0Sheaf {Y : Scheme.{u}} (g : Y ⟶ Spec (.of k)) (F : Y.Modules) : ℕ :=
  Module.finrank k (globalSectionsOverField k g F)

/-- The two descriptions of the scalars `k → Γ(X, 𝒪_X)` agree. -/
private theorem scalars_eq {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) :
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ (by simp)).hom =
      scalarsToGlobalSections k f := by
  simp [scalarsToGlobalSections, Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]

/-- `h⁰` of a divisor is `h⁰` of its divisorial sheaf. -/
private theorem h0_eq_h0Sheaf {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsLocallyNoetherian X]
    [IsNormal X] (D : Divisor X) : D.h0 k f = h0Sheaf k f D.divisorialSheaf := by
  letI : Module k (D.divisorialSubmodule ⊤) := Module.compHom _ (scalarsToGlobalSections k f)
  let e : (D.divisorialSubmodule ⊤) ≃ₗ[k] globalSectionsOverField k f D.divisorialSheaf :=
    { toFun := fun x => x
      invFun := fun x => x
      map_add' := fun _ _ => rfl
      map_smul' := fun c x => by
        change (scalarsToGlobalSections k f c) • x =
          (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ (by simp)).hom c) • x
        rw [scalars_eq]
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact e.finrank_eq

private theorem h0Sheaf_congr {Y : Scheme.{u}} (g : Y ⟶ Spec (.of k)) {F G : Y.Modules}
    (e : F ≅ G) : h0Sheaf k g F = h0Sheaf k g G :=
  ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k g).mapIso e).toLinearEquiv.finrank_eq

/-- The global sections of `i_* G` are those of `G`, as `k`-vector spaces. -/
private noncomputable def globalSectionsPushforwardEquiv {X Y : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (i : Y ⟶ X) (G : Y.Modules) :
    globalSectionsOverField k f ((Scheme.Modules.pushforward i).obj G) ≃ₗ[k]
      globalSectionsOverField k (i ≫ f) G :=
  have hring : ∀ c : k, i.app ⊤ (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ (by simp)).hom c) =
      ((Scheme.ΓSpecIso (.of k)).inv ≫ (i ≫ f).appLE ⊤ ⊤ (by simp)).hom c := by
    intro c
    rw [← CommRingCat.comp_apply]
    congr 2
    rw [Category.assoc, Scheme.Hom.app_eq_appLE i]
    congr 1
    exact Scheme.Hom.appLE_comp_appLE i f ⊤ ⊤ (i ⁻¹ᵁ ⊤) _ _
  { toFun := fun x => x
    invFun := fun x => x
    map_add' := fun _ _ => rfl
    map_smul' := fun c x => by
      change (i.app ⊤ (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ ⊤ (by simp)).hom c)) •
        (show Γ(G, i ⁻¹ᵁ ⊤) from x) = _
      rw [hring]
      rfl
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }

/-- Global sections are left exact: in a short exact sequence, a section of the middle term
killed by the second map comes from the first term. -/
private theorem exists_app_top_eq_of_shortExact {X : Scheme.{u}} {S : ShortComplex X.Modules}
    (hS : S.ShortExact) (x : Γ(S.X₂, ⊤)) (hx : S.g.app ⊤ x = 0) :
    ∃ y : Γ(S.X₁, ⊤), S.f.app ⊤ y = x := by
  let F : X.Modules ⥤ ModuleCat Γ(X, ⊤) :=
    SheafOfModules.evaluation X.ringCatSheaf (Opposite.op (⊤ : X.Opens))
  have hpres : Limits.PreservesFiniteLimits F := inferInstanceAs
    (Limits.PreservesFiniteLimits
      (SheafOfModules.evaluation X.ringCatSheaf (Opposite.op (⊤ : X.Opens))))
  have : Limits.PreservesLimitsOfShape Limits.WalkingParallelPair F :=
    hpres.preservesFiniteLimits _
  have : F.PreservesZeroMorphisms :=
    @Functor.preservesZeroMorphisms_of_additive _ _ _ _ _ _ F
      (AlgebraicGeometry.evaluationAdditive X)
  have hE := hS.exact.map_of_mono_of_preservesKernel F hS.mono_f inferInstance
  exact (ShortComplex.moduleCat_exact_iff_ker_sub_range _).mp hE (x := x) hx

/-- `h⁰(ℱ₂) ≤ h⁰(ℱ₁) + h⁰(ℱ₃)` for a short exact sequence `0 → ℱ₁ → ℱ₂ → ℱ₃ → 0`. -/
private theorem h0Sheaf_le_of_shortExact {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    {S : ShortComplex X.Modules} (hS : S.ShortExact)
    [FiniteDimensional k (globalSectionsOverField k f S.X₁)]
    [FiniteDimensional k (globalSectionsOverField k f S.X₂)]
    [FiniteDimensional k (globalSectionsOverField k f S.X₃)] :
    h0Sheaf k f S.X₂ ≤ h0Sheaf k f S.X₁ + h0Sheaf k f S.X₃ := by
  let G := Stacks.EnriquesSeveriZariski.globalSectionsFunctor k f
  let gk : globalSectionsOverField k f S.X₂ →ₗ[k] globalSectionsOverField k f S.X₃ :=
    (G.map S.g).hom
  let fk : globalSectionsOverField k f S.X₁ →ₗ[k] globalSectionsOverField k f S.X₂ :=
    (G.map S.f).hom
  have hker : LinearMap.ker gk ≤ LinearMap.range fk := fun x hx =>
    exists_app_top_eq_of_shortExact hS x hx
  have h1 := LinearMap.finrank_range_add_finrank_ker gk
  have h2 : Module.finrank k (LinearMap.range gk) ≤ h0Sheaf k f S.X₃ :=
    Submodule.finrank_le _
  have h3 : Module.finrank k (LinearMap.ker gk) ≤ h0Sheaf k f S.X₁ :=
    (Submodule.finrank_mono hker).trans (LinearMap.finrank_range_le fk)
  unfold h0Sheaf at h2 h3 ⊢
  omega

end Sections

/-! ### A smooth member of a free linear system -/

section Bertini

open MMP.Threefold.Bridges

attribute [local instance] MvPolynomial.gradedAlgebra
  Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.globalSectionsModule

/-- A dense open of the coefficient space `𝔸ᴺ⁺¹_k` over an infinite field contains a `k`-point
at which a given nonzero polynomial does not vanish. -/
private theorem exists_coefficientPoint_mem_and_eval_ne_zero {k : Type u} [Field k] [Infinite k]
    {N : ℕ} (U : (coefficientSpace k N).Opens) (hU : Dense (U : Set (coefficientSpace k N)))
    {g : MvPolynomial (Fin (N + 1)) k} (hg : g ≠ 0) :
    ∃ c : Fin (N + 1) → k, coefficientPoint c ∈ U ∧ MvPolynomial.eval c g ≠ 0 := by
  haveI : Nonempty (coefficientSpace k N) := ⟨coefficientPoint 0⟩
  obtain ⟨p, hp⟩ := hU.nonempty
  obtain ⟨_, ⟨f, rfl⟩, hpf, hfU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp U.2
  have hf : f ≠ 0 := by
    rintro rfl
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hpf (Submodule.zero_mem _)
  obtain ⟨c, hc⟩ : ∃ c, MvPolynomial.eval c (f * g) ≠ 0 := by
    by_contra h
    push Not at h
    exact mul_ne_zero hf hg (MvPolynomial.funext fun c => by simpa using h c)
  rw [map_mul] at hc
  refine ⟨c, hfU ?_, right_ne_zero_of_mul hc⟩
  exact (PrimeSpectrum.mem_basicOpen _ _).mpr fun h => left_ne_zero_of_mul hc h

/-- For a nonzero `k`-linear map `φ` out of `kᴺ⁺¹` there is a nonzero polynomial (a linear form
vanishing on the kernel of `φ`) whose non-vanishing forces `φ c ≠ 0`. -/
private theorem exists_polynomial_ne_zero_of_linearMap_ne_zero {k : Type u} [Field k] {N : ℕ}
    {M : Type*} [AddCommGroup M] [Module k M] (φ : (Fin (N + 1) → k) →ₗ[k] M) (hφ : φ ≠ 0) :
    ∃ ℓ : MvPolynomial (Fin (N + 1)) k, ℓ ≠ 0 ∧
      ∀ c, MvPolynomial.eval c ℓ ≠ 0 → φ c ≠ 0 := by
  obtain ⟨c₀, hc₀⟩ : ∃ c₀, φ c₀ ≠ 0 := by
    by_contra h
    push Not at h
    exact hφ (LinearMap.ext h)
  obtain ⟨ψ, hψc, hψK⟩ := Submodule.exists_dual_map_eq_bot_of_notMem
    (p := LinearMap.ker φ) (x := c₀) (by simpa using hc₀) inferInstance
  set ℓ : MvPolynomial (Fin (N + 1)) k :=
    ∑ j, MvPolynomial.C (ψ (Pi.single j 1)) * MvPolynomial.X j
  have hev : ∀ c, MvPolynomial.eval c ℓ = ψ c := by
    intro c
    conv_rhs => rw [pi_eq_sum_univ c]
    simp only [ℓ, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, map_smul,
      smul_eq_mul, mul_comm]
    refine Finset.sum_congr rfl fun x _ => ?_
    congr 2
    ext j
    simp [Pi.single_apply, eq_comm]
  refine ⟨ℓ, fun h => hψc (by rw [← hev, h, map_zero]), fun c hc hφc => hc ?_⟩
  rw [hev, ← Submodule.mem_bot k, ← hψK]
  exact ⟨c, hφc, rfl⟩

/-- **Bertini.** On a smooth variety over an algebraically closed field of characteristic zero,
an invertible sheaf generated by finitely many global sections has a nonzero section whose zero
scheme is smooth. -/
private theorem exists_smooth_zeroScheme {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsVariety k f] [Smooth f] (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] {N : ℕ} (σ : Fin (N + 1) → Γ(L, ⊤))
    (hσ : ∀ x : X, ∃ j, x ∈ Stacks.Ample.nonvanishingLocus L (σ j)) :
    ∃ s : Γ(L, ⊤), s ≠ 0 ∧ Smooth ((zeroScheme X L s).subschemeι ≫ f) := by
  letI : X.Over (Spec (.of k)) := ⟨f⟩
  haveI : AlgebraicGeometry.IsVariety k (X ↘ Spec (.of k)) := ‹AlgebraicGeometry.IsVariety k f›
  haveI : Infinite k := IsAlgClosed.instInfinite
  have hsingle : ∀ j, systemSection (k := k) σ (Pi.single j 1) = σ j := fun j => by
    simp [systemSection, Fintype.linearCombination_apply_single]
  have hs : ⨆ c : Fin (N + 1) → k, Stacks.NonvanishingOpen.nonvanishingOpen X L
      (systemSection σ c) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨j, hj⟩ := hσ x
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨Pi.single j 1, ?_⟩
    rwa [hsingle]
  have hφ : systemSection (k := k) σ ≠ 0 := by
    intro h0
    obtain ⟨j, hj⟩ := hσ (Classical.arbitrary X)
    rw [← hsingle j, h0, LinearMap.zero_apply, Stacks.Ample.nonvanishingLocus_zero] at hj
    exact hj
  let ιY : (i : PEmpty.{u + 1}) → (i.elim : Scheme.{u}) ⟶ X := fun i => i.elim
  haveI : ∀ i, IsImmersion (ιY i) := fun i => i.elim
  haveI : ∀ i, Smooth (ιY i ≫ X ↘ Spec (.of k)) := fun i => i.elim
  obtain ⟨⟨U, hUd, hU⟩, -⟩ := exists_dense_open_smooth_zeroScheme σ hs ιY
  obtain ⟨ℓ, hℓ, hℓφ⟩ := exists_polynomial_ne_zero_of_linearMap_ne_zero _ hφ
  obtain ⟨c, hcU, hc⟩ := exists_coefficientPoint_mem_and_eval_ne_zero U hUd hℓ
  exact ⟨systemSection σ c, hℓφ c hc, (hU c hcU).1 ‹Smooth f›⟩

end Bertini

/-- The statement, for varieties of dimension at most `n`. -/
private def Bounded (k : Type u) [Field k] (n : ℕ) : Prop :=
  ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsProjectiveVariety k f]
    (_ : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X],
    topologicalKrullDim X ≤ n → ∀ D N : Divisor X,
      (Divisor.toQDivisor N).IsNumericallyTrivial k f →
        BddAbove (Set.range fun u : ℤ => (D + u • N).h0 k f)

/-- On a scheme of dimension `≤ 0`, `h⁰(D + uN)` is bounded in `u`. -/
private theorem bounded_of_dim_le_zero {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsLocallyNoetherian X] [IsNormal X] (hdim : topologicalKrullDim X ≤ 0) (D N : Divisor X) :
    BddAbove (Set.range fun u : ℤ => (D + u • N).h0 k f) := by
  have hempty : IsEmpty (AlgebraicGeometry.PrimeDivisor X) := ⟨fun P => by
    have h1 := AlgebraicGeometry.coheight_le_topologicalKrullDim P.genericPoint
    rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint] at h1
    exact absurd (h1.trans hdim) (by decide)⟩
  have hD : ∀ E : Divisor X, E = 0 := fun E => Finsupp.ext hempty.elim
  refine ⟨(0 : Divisor X).h0 k f, ?_⟩
  rintro _ ⟨u, rfl⟩
  simp only [hD (D + u • N), le_refl]

/-! ### An ample sheaf generated by finitely many sections -/

section Ample

open MonoidalCategory

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory

/-- A projective variety carries an ample invertible sheaf generated by finitely many global
sections: a large tensor power of an ample sheaf ([Stacks, Tag 01Q3]). -/
private theorem exists_ample_generated {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] :
    ∃ (H : X.Modules) (_ : Stacks.Ample.IsInvertibleModule X H),
      Scheme.Modules.IsAmple X H ∧ ∃ (M : ℕ) (σ : Fin (M + 1) → Γ(H, ⊤)),
        ∀ x : X, ∃ j, x ∈ Stacks.Ample.nonvanishingLocus H (σ j) := by
  classical
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k f).toIsIntegral
  have hqp : Stacks.HProjective.IsHQuasiProjective f :=
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k f).isProjective.isHQuasiProjective
  obtain ⟨-, L, hLinv, hLamp⟩ := Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective f hqp
  have hL : Stacks.Ample.IsAmple X L :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f L hLamp
  obtain ⟨-, hgen⟩ :=
    Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      L hL
  obtain ⟨n₀, hn₀⟩ := hgen (Stacks.Ample.unitModule X) inferInstance inferInstance
  set d : ℕ := (max n₀ 1).toNat with hd
  obtain ⟨σ, hσ⟩ := hn₀ (d : ℤ) (by omega)
  have hTamp : Stacks.Ample.IsAmple X (Stacks.Ample.tensorPowModule X L (d : ℤ)) :=
    Stacks.AmplePositivePower.isAmple_tensorPowModule_of_isAmple L d (by omega) hL
  have e : (Stacks.Ample.unitModule X ⊗ Stacks.Ample.tensorPowModule X L (d : ℤ) : X.Modules) ≅
      Stacks.Ample.tensorPowModule X L (d : ℤ) :=
    whiskerRightIso (Stacks.AmpleGlobalGeneration.unitModuleIsoUnit X) _ ≪≫ λ_ _
  let g : (Stacks.Ample.tensorPowModule X L (d : ℤ)).GeneratingSections :=
    @SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _ σ e.hom (IsIso.epi_of_iso e.hom)
  haveI : Finite g.I := hσ
  haveI : Fintype g.I := Fintype.ofFinite _
  have hcov : ∀ x : X, ∃ i : g.I, x ∈ Stacks.Ample.nonvanishingLocus
      (Stacks.Ample.tensorPowModule X L (d : ℤ)) ((g.s i).eval (Opposite.op ⊤)) := fun x => by
    obtain ⟨i, hi⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing _ g x
    exact ⟨i, by rwa [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X _ (g.s i)]⟩
  have hcard : 0 < Fintype.card g.I := by
    obtain ⟨x⟩ : Nonempty X := inferInstance
    obtain ⟨i, -⟩ := hcov x
    exact Fintype.card_pos_iff.mpr ⟨i⟩
  refine ⟨_, inferInstance, (Stacks.AmpleBridge.isAmple_iff_isAmple X _).mp hTamp,
    Fintype.card g.I - 1, fun j => (g.s ((Fintype.equivFin g.I).symm
      (Fin.cast (by omega) j))).eval (Opposite.op ⊤), fun x => ?_⟩
  obtain ⟨i, hi⟩ := hcov x
  refine ⟨Fin.cast (by omega) (Fintype.equivFin g.I i), ?_⟩
  simpa using hi

end Ample

/-! ### The induction step -/

section Step

attribute [local instance] AlgebraicGeometry.schemeModulesMonoidal

/-- The pullback of an invertible sheaf along a morphism of schemes is invertible. -/
local instance {X Y : Scheme.{u}} {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L]
    (ι : Y ⟶ X) : Stacks.Ample.IsInvertibleModule Y ((Scheme.Modules.pullback ι).obj L) :=
  Stacks.InvertiblePullback.isInvertibleModule_pullback ι L

/-- An invertible sheaf on a proper `k`-scheme has finite-dimensional global sections. -/
private theorem finiteDimensional_globalSectionsOverField_of_isInvertible {Y : Scheme.{u}}
    (g : Y ⟶ Spec (.of k)) [IsProper g] (F : Y.Modules) [Stacks.Ample.IsInvertibleModule Y F] :
    FiniteDimensional k (globalSectionsOverField k g F) :=
  haveI := AlgebraicGeometry.SheafOfModules.isCoherent_of_isInvertible k g F
  Stacks.EnriquesSeveriZariski.finiteDimensional_globalSectionsOverField k g F

/-- On a projective variety `X` of dimension `e + 1` with an ample invertible sheaf `H`, a divisor
`E` with `(𝒪_X(E) · H^e) < 0` has `h⁰(E) = 0`. -/
private theorem h0_eq_zero_of_intersectionNumber_neg {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] [IsProper f] [IsLocallyNoetherian X] [IsNormal X]
    {e : ℕ} (hdim : topologicalKrullDim X = (e + 1 : ℕ)) (H : X.Modules)
    [Stacks.Ample.IsInvertibleModule X H] (hH : Scheme.Modules.IsAmple X H) (E : Divisor X)
    [Stacks.Ample.IsInvertibleModule X E.divisorialSheaf]
    [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      ((Fin.cons E.divisorialSheaf fun _ => H : Fin (e + 1) → X.Modules) q)]
    (hE : intersectionNumber k f (𝟙 X) (e + 1) hdim.le
      (Fin.cons E.divisorialSheaf fun _ => H) < 0) :
    E.h0 k f = 0 := by
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k f).toIsIntegral
  have hgeH : ∀ {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
      (hZ : topologicalKrullDim Z ≤ (e : WithBot ℕ∞)),
      0 ≤ intersectionNumber k f i e hZ (fun _ => H) := by
    intro Z i _ hZ
    rcases hZ.lt_or_eq with hlt | heq
    · rw [intersectionNumber_eq_zero_of_topologicalKrullDim_lt k f i e hZ hlt]
    · exact (intersectionNumber_pos k f i e heq (fun _ => H) fun _ => hH).le
  by_contra hne
  letI : Module k (E.divisorialSubmodule ⊤) := Module.compHom _ (scalarsToGlobalSections k f)
  have hpos : 0 < Module.finrank k (E.divisorialSubmodule ⊤) := Nat.pos_of_ne_zero hne
  haveI := Module.nontrivial_of_finrank_pos hpos
  obtain ⟨s, hs⟩ := exists_ne (0 : E.divisorialSubmodule ⊤)
  obtain ⟨s', hs'⟩ : ∃ s' : Γ(E.divisorialSheaf, ⊤), s' ≠ 0 := ⟨s, hs⟩
  obtain ⟨t, ht⟩ : ∃ t : E.divisorialSheaf.sections, t.eval (Opposite.op ⊤) = s' :=
    ⟨Stacks.SheafOfModules.sectionsOfTopOfRingSheaf _ s',
      Stacks.SheafOfModules.sectionsOfTopOfRingSheaf_eval_top _ s'⟩
  have hreg := isRegularSection_of_eval_top_ne_zero E.divisorialSheaf t (by rwa [ht])
  haveI hD := (isEffectiveCartierDivisor_zeroScheme_iff_isRegularSection X _ t).2 hreg
  obtain ⟨φ, -⟩ := (existsUnique_invertibleSheafIso_zeroScheme X _ t hreg).exists
  have hcut := intersectionNumber_eq_of_isEffectiveCartierDivisor' k f (𝟙 X) e hdim.le
    (Fin.cons E.divisorialSheaf fun _ => H)
    (zeroScheme X E.divisorialSheaf (t.eval (Opposite.op ⊤)))
    ((Scheme.Modules.pullbackId X).app _ ≪≫ φ.symm)
  have h2 := hgeH ((zeroScheme X E.divisorialSheaf (t.eval (Opposite.op ⊤))).subschemeι ≫ 𝟙 X)
    (topologicalKrullDim_subscheme_le_of_isEffectiveCartierDivisor_of_isProper k f (𝟙 X) e
      hdim.le _)
  rw [hcut] at hE
  exact absurd h2 (not_le.mpr hE)

/-- **The degree against an ample sheaf.** On a smooth projective variety `X` of dimension
`e + 1` with an ample invertible sheaf `H`, `J(E) = (𝒪_X(E) · H^e)` is additive in `E`, vanishes
on the numerically trivial `N`, is positive on a divisor `A` with `𝒪_X(A) ≅ H`, and `h⁰(E) = 0`
when `J(E) < 0`. -/
private theorem exists_degree {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {e : ℕ}
    (hdim : topologicalKrullDim X = (e + 1 : ℕ)) (N : Divisor X)
    (hN : (Divisor.toQDivisor N).IsNumericallyTrivial k f) (H : X.Modules)
    [Stacks.Ample.IsInvertibleModule X H] (hH : Scheme.Modules.IsAmple X H) :
    ∃ J : Divisor X →+ ℤ, J N = 0 ∧ (∀ A : Divisor X, Nonempty (A.divisorialSheaf ≅ H) →
      0 < J A) ∧ ∀ E : Divisor X, J E < 0 → E.h0 k f = 0 := by
  haveI : IsProper f := isProper_of_isProjectiveMorphism f
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k f).isProjective
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k f).toIsIntegral
  have hc : ∀ E : Divisor X, E.IsCartier :=
    MMP.Threefold.Resolution.isCartier_of_isSmoothScheme (sU := f) hsm
  haveI hinv : ∀ E : Divisor X, Stacks.Ample.IsInvertibleModule X E.divisorialSheaf :=
    fun E => (hc E).isInvertibleModule_divisorialSheaf
  let L : Divisor X → Fin (e + 1) → X.Modules := fun E => Fin.cons E.divisorialSheaf fun _ => H
  haveI hLinv : ∀ E q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L E q) :=
    fun E => isInvertible_finCons _ _
  let J₀ : Divisor X → ℤ := fun E => intersectionNumber k f (𝟙 X) (e + 1) hdim.le (L E)
  have hadd : ∀ E E', J₀ (E + E') = J₀ E + J₀ E' := fun E E' =>
    intersectionNumber_tensor k f (𝟙 X) (e + 1) hdim.le 0 (L (E + E')) (L E) (L E')
      (fun q hq => by
        obtain ⟨t, rfl⟩ := Fin.exists_succ_eq.mpr hq
        rfl)
      (fun q hq => by
        obtain ⟨t, rfl⟩ := Fin.exists_succ_eq.mpr hq
        rfl)
      ((hc E).divisorialSheafTensorIso (hc E')).symm
  let J : Divisor X →+ ℤ := AddMonoidHom.mk' J₀ hadd
  refine ⟨J, ?_, ?_, fun E hE => h0_eq_zero_of_intersectionNumber_neg f hdim H hH E hE⟩
  · change intersectionNumber k f (𝟙 X) (e + 1) hdim.le (L N) = 0
    rw [← MMP.Mori.Snapper.sheafIntersectionNumber_eq_intersectionNumber]
    refine MMP.Mori.sheafIntersectionNumber_eq_zero_of_degree_eq_zero k f (𝟙 X) e hdim.le
      (L N) fun C => ?_
    rw [QDivisor.isNumericallyTrivial_iff] at hN
    obtain ⟨_, hN⟩ := hN
    have h1 := hN C.scheme C.ι C.dim_eq
    rw [QDivisor.intersectionNumber_toQDivisor k f C.ι C.dim_eq.le N (hc N)] at h1
    rw [show C.degree k (L N 0) = N.degreeOn k f C.ι C.dim_le (hc N) from rfl]
    exact_mod_cast h1
  · rintro A ⟨φ⟩
    change 0 < intersectionNumber k f (𝟙 X) (e + 1) hdim.le (L A)
    rw [intersectionNumber_eq_of_iso_at k f (𝟙 X) (e + 1) hdim.le (L A) (fun _ => H) 0
      (fun q hq => by
        obtain ⟨t, rfl⟩ := Fin.exists_succ_eq.mpr hq
        rfl) φ]
    exact intersectionNumber_pos k f (𝟙 X) (e + 1) hdim (fun _ => H) fun _ => hH

/-- **The positive divisor of the induction step.** On a smooth projective variety `X` of
dimension `e + 1` there are a divisor `A` with `𝒪_X(A)` generated by finitely many global
sections and an additive `J : Div(X) → ℤ` such that
`J(N) = 0` for the numerically trivial `N`, `J(A) > 0`, and `h⁰(E) = 0` whenever `J(E) < 0`. -/
private theorem exists_positive_divisor {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {e : ℕ}
    (hdim : topologicalKrullDim X = (e + 1 : ℕ)) (N : Divisor X)
    (hN : (Divisor.toQDivisor N).IsNumericallyTrivial k f) :
    ∃ (A : Divisor X) (J : Divisor X →+ ℤ) (M : ℕ)
      (σ : Fin (M + 1) → Γ(A.divisorialSheaf, ⊤)),
      (∀ x : X, ∃ j, x ∈ Stacks.Ample.nonvanishingLocus A.divisorialSheaf (σ j)) ∧
      J N = 0 ∧ 0 < J A ∧ ∀ E : Divisor X, J E < 0 → E.h0 k f = 0 := by
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k f).toIsIntegral
  obtain ⟨H, _, hH, M, σ, hσ⟩ := exists_ample_generated f
  obtain ⟨J, hJN, hJpos, hJvan⟩ := exists_degree f hsm hdim N hN H hH
  obtain ⟨A, ⟨φ⟩⟩ := exists_divisorialSheaf_iso_of_isInvertible H
  refine ⟨A, J, M, fun j => φ.inv.app ⊤ (σ j), fun x => ?_, hJN, hJpos A ⟨φ⟩, hJvan⟩
  obtain ⟨j, hj⟩ := hσ x
  refine ⟨j, ?_⟩
  show x ∈ Stacks.Ample.nonvanishingLocus A.divisorialSheaf (φ.symm.hom.app ⊤ (σ j))
  rw [Stacks.Ample.nonvanishingLocus_congr φ.symm]
  exact hj

/-- **The restriction sequence.** For a nonzero section `s` of `𝒪_X(A)` with zero scheme
`i : Y ↪ X`, `h⁰(X, 𝒪_X(E)) ≤ h⁰(X, 𝒪_X(E - A)) + h⁰(Y, i^* 𝒪_X(E))`. -/
private theorem h0_le_h0_sub_add {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (A : Divisor X) [Stacks.Ample.IsInvertibleModule X A.divisorialSheaf]
    (s : Γ(A.divisorialSheaf, ⊤)) (hs : s ≠ 0) (E : Divisor X) :
    E.h0 k f ≤ (E - A).h0 k f +
      h0Sheaf k ((zeroScheme X A.divisorialSheaf s).subschemeι ≫ f)
        ((Scheme.Modules.pullback (zeroScheme X A.divisorialSheaf s).subschemeι).obj
          E.divisorialSheaf) := by
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k f).toIsIntegral
  have hcart : ∀ E : Divisor X, E.IsCartier :=
    MMP.Threefold.Resolution.isCartier_of_isSmoothScheme (sU := f) hsm
  haveI hinv : ∀ E : Divisor X, Stacks.Ample.IsInvertibleModule X E.divisorialSheaf :=
    fun E => (hcart E).isInvertibleModule_divisorialSheaf
  obtain ⟨t, rfl⟩ : ∃ t : A.divisorialSheaf.sections, t.eval (Opposite.op ⊤) = s :=
    ⟨Stacks.SheafOfModules.sectionsOfTopOfRingSheaf _ s,
      Stacks.SheafOfModules.sectionsOfTopOfRingSheaf_eval_top _ s⟩
  have hreg := isRegularSection_of_eval_top_ne_zero A.divisorialSheaf t hs
  obtain ⟨w, hS⟩ := shortExact_zeroScheme_twist_of_isRegularSection X A.divisorialSheaf t hreg
    (E - A).divisorialSheaf
  set i := (zeroScheme X A.divisorialSheaf (t.eval (Opposite.op ⊤))).subschemeι
  set S := ShortComplex.mk _ _ w
  have eX₂ : S.X₂ ≅ E.divisorialSheaf :=
    (hcart (E - A)).divisorialSheafTensorIso (hcart A) ≪≫ eqToIso (by rw [sub_add_cancel])
  haveI : FiniteDimensional k (globalSectionsOverField k f S.X₁) :=
    finiteDimensional_globalSectionsOverField_of_isInvertible f _
  haveI : FiniteDimensional k (globalSectionsOverField k f S.X₂) := by
    haveI : FiniteDimensional k
        ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k f).obj E.divisorialSheaf) :=
      finiteDimensional_globalSectionsOverField_of_isInvertible f E.divisorialSheaf
    exact LinearEquiv.finiteDimensional
      ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k f).mapIso eX₂.symm).toLinearEquiv
  haveI : FiniteDimensional k (globalSectionsOverField k f S.X₃) := by
    haveI : FiniteDimensional k ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k (i ≫ f)).obj
        ((Scheme.Modules.pullback i).obj E.divisorialSheaf)) :=
      finiteDimensional_globalSectionsOverField_of_isInvertible (i ≫ f) _
    exact LinearEquiv.finiteDimensional
      (((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k (i ≫ f)).mapIso
        ((Scheme.Modules.pullback i).mapIso eX₂.symm)).toLinearEquiv.trans
        (globalSectionsPushforwardEquiv f i _).symm)
  have h3 : h0Sheaf k f S.X₃ = h0Sheaf k (i ≫ f) ((Scheme.Modules.pullback i).obj
      E.divisorialSheaf) :=
    (globalSectionsPushforwardEquiv f i _).finrank_eq.trans
      (h0Sheaf_congr _ ((Scheme.Modules.pullback i).mapIso eX₂))
  rw [h0_eq_h0Sheaf, h0_eq_h0Sheaf, ← h0Sheaf_congr f eX₂, ← h3]
  exact h0Sheaf_le_of_shortExact f hS

/-- **Iterated restriction.** Applying `h0_le_h0_sub_add` `j` times along the zero scheme
`i : Y ↪ X` of a nonzero section of `𝒪_X(A)`:
`h⁰(X, 𝒪_X(E)) ≤ h⁰(X, 𝒪_X(E - jA)) + ∑_{t < j} h⁰(Y, i^* 𝒪_X(E - tA))`. -/
private theorem h0_le_h0_sub_nsmul_add_sum {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [AlgebraicGeometry.IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (A : Divisor X) [Stacks.Ample.IsInvertibleModule X A.divisorialSheaf]
    (s : Γ(A.divisorialSheaf, ⊤)) (hs : s ≠ 0) (E : Divisor X) (j : ℕ) :
    E.h0 k f ≤ (E - j • A).h0 k f + ∑ t ∈ Finset.range j,
      h0Sheaf k ((zeroScheme X A.divisorialSheaf s).subschemeι ≫ f)
        ((Scheme.Modules.pullback (zeroScheme X A.divisorialSheaf s).subschemeι).obj
          (E - t • A).divisorialSheaf) := by
  induction j with
  | zero => simp
  | succ j ih =>
    have := h0_le_h0_sub_add f hsm A s hs (E - j • A)
    rw [sub_sub, ← succ_nsmul] at this
    rw [Finset.sum_range_succ]
    omega

/-- The zero scheme of a nonzero section of an invertible sheaf on an integral scheme of dimension
`e + 1`, proper over `k`, has dimension at most `e`. -/
private theorem topologicalKrullDim_zeroScheme_le {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsProper f] [IsIntegral X] {e : ℕ} (hdim : topologicalKrullDim X = (e + 1 : ℕ))
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] (s : Γ(L, ⊤)) (hs : s ≠ 0) :
    topologicalKrullDim (zeroScheme X L s).subscheme ≤ e := by
  haveI := isEffectiveCartierDivisor_zeroScheme_of_ne_zero L s hs
  exact topologicalKrullDim_subscheme_le_of_isEffectiveCartierDivisor_of_isProper k f (𝟙 X) e
    hdim.le _

/-- `h⁰(Y, G) ≤ ∑_c h⁰(U_c, G|_{U_c})` for a finite open cover `U` of `Y`. -/
private theorem h0Sheaf_le_sum_of_cover {Y : Scheme.{u}} (g : Y ⟶ Spec (.of k)) {ι : Type u}
    [Fintype ι] (U : ι → Y.Opens) (hcover : ∀ y : Y, ∃ c, y ∈ U c) (G : Y.Modules)
    [∀ c, FiniteDimensional k (globalSectionsOverField k ((U c).ι ≫ g) (G.restrict (U c).ι))] :
    h0Sheaf k g G ≤ ∑ c, h0Sheaf k ((U c).ι ≫ g) ((Scheme.Modules.pullback (U c).ι).obj G) := by
  let ρ : ∀ c, globalSectionsOverField k g G →ₗ[k]
      globalSectionsOverField k ((U c).ι ≫ g) (G.restrict (U c).ι) := fun c =>
    (globalSectionsPushforwardEquiv g (U c).ι _).toLinearMap ∘ₗ
      ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k g).map
        ((Scheme.Modules.restrictAdjunction (U c).ι).unit.app G)).hom
  have hinj : Function.Injective (LinearMap.pi ρ) := by
    intro s t hst
    have hc : ∀ c, G.presheaf.map (homOfLE (le_top :
        (U c).ι ''ᵁ ((U c).ι ⁻¹ᵁ ⊤) ≤ ⊤)).op s = G.presheaf.map (homOfLE (le_top :
        (U c).ι ''ᵁ ((U c).ι ⁻¹ᵁ ⊤) ≤ ⊤)).op t := fun c => (congrFun hst c : ρ c s = ρ c t)
    exact TopCat.Sheaf.eq_of_locally_eq' ⟨G.presheaf, G.isSheaf⟩
      (fun c => (U c).ι ''ᵁ ((U c).ι ⁻¹ᵁ ⊤)) ⊤
      (fun c => homOfLE (le_top : (U c).ι ''ᵁ ((U c).ι ⁻¹ᵁ ⊤) ≤ ⊤)) (fun y _ => by
        obtain ⟨c, hyc⟩ := hcover y
        refine TopologicalSpace.Opens.mem_iSup.mpr ⟨c, ?_⟩
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact ⟨hyc, trivial⟩) s t hc
  have hle := LinearMap.finrank_le_finrank_of_injective hinj
  rw [Module.finrank_pi_fintype] at hle
  refine hle.trans (le_of_eq (Finset.sum_congr rfl fun c _ => ?_))
  exact ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k ((U c).ι ≫ g)).mapIso
    ((Scheme.Modules.restrictFunctorIsoPullback (U c).ι).app G)).toLinearEquiv.finrank_eq

/-- **The connected components.** A scheme `Y` smooth and proper over `k` has finitely many
integral, closed opens `U_c` (its connected components) with `h⁰(Y, G) ≤ ∑_c h⁰(U_c, G|_{U_c})`
for every invertible `G`. -/
private theorem exists_components {Y : Scheme.{u}} (g : Y ⟶ Spec (.of k)) [IsProper g]
    [Smooth g] :
    ∃ (ι : Type u) (_ : Fintype ι) (U : ι → Y.Opens), (∀ c, IsIntegral (U c)) ∧
      (∀ c, IsClosed (U c : Set Y)) ∧
      ∀ G : Y.Modules, [Stacks.Ample.IsInvertibleModule Y G] →
        h0Sheaf k g G ≤
          ∑ c, h0Sheaf k ((U c).ι ≫ g) ((Scheme.Modules.pullback (U c).ι).obj G) := by
  classical
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian g
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace g
  haveI : IsNoetherian Y := {}
  haveI hfin := TopologicalSpace.NoetherianSpace.finite_connectedComponents Y
  letI : Fintype (_root_.ConnectedComponents Y) := Fintype.ofFinite _
  choose x hx using ConnectedComponents.surjective_coe (α := (Y : Type u))
  have hcl : ∀ c, IsClopen (connectedComponent (x c)) := fun c =>
    TopologicalSpace.isClopen_connectedComponent_of_finite_connectedComponents (x c)
  let U : _root_.ConnectedComponents Y → Y.Opens := fun c =>
    ⟨connectedComponent (x c), (hcl c).isOpen⟩
  have hint : ∀ c, IsIntegral (U c) := fun c => by
    haveI : ConnectedSpace (U c) :=
      isConnected_iff_connectedSpace.mp isConnected_connectedComponent
    exact isIntegral_of_smooth_of_connectedSpace ((U c).ι ≫ g)
  refine ⟨_root_.ConnectedComponents Y, inferInstance, U, hint, fun c => (hcl c).isClosed, ?_⟩
  intro G _
  have hcover : ∀ y : Y, ∃ c, y ∈ U c := fun y => ⟨ConnectedComponents.mk y, by
    change y ∈ connectedComponent (x _)
    exact ConnectedComponents.coe_eq_coe'.mp (hx _).symm⟩
  have hfd : ∀ c, FiniteDimensional k
      (globalSectionsOverField k ((U c).ι ≫ g) (G.restrict (U c).ι)) := fun c => by
    haveI : IsClosedImmersion (U c).ι := IsClosedImmersion.of_isPreimmersion _ (by
      rw [Scheme.Opens.range_ι]
      exact (hcl c).isClosed)
    haveI : FiniteDimensional k ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k
        ((U c).ι ≫ g)).obj ((Scheme.Modules.pullback (U c).ι).obj G)) :=
      finiteDimensional_globalSectionsOverField_of_isInvertible ((U c).ι ≫ g) _
    exact LinearEquiv.finiteDimensional
      ((Stacks.EnriquesSeveriZariski.globalSectionsFunctor k ((U c).ι ≫ g)).mapIso
        ((Scheme.Modules.restrictFunctorIsoPullback (U c).ι).app G).symm).toLinearEquiv
  exact h0Sheaf_le_sum_of_cover g U hcover G

/-- The degree of a pull-back along `e : Z ⟶ X` on a curve `i : C ⟶ Z` is the degree on the
composite curve `i ≫ e`. -/
private theorem degreeOn_pullback {X Z C : Scheme.{u}} (f : X ⟶ Spec (.of k)) (e : Z ⟶ X)
    (i : C ⟶ Z) [IsProper (i ≫ e ≫ f)] [IsProper ((i ≫ e) ≫ f)]
    (hdim : topologicalKrullDim C ≤ 1) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] :
    MMP.Mori.degreeOn k (e ≫ f) i hdim ((Scheme.Modules.pullback e).obj L) =
      MMP.Mori.degreeOn k f (i ≫ e) hdim L := by
  have h1 : ∀ {g g' : C ⟶ Spec (.of k)} (_ : g = g') [IsProper g] [IsProper g']
      (F : C.Modules) [SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 F],
      invertibleCurveDegree k g hdim F = invertibleCurveDegree k g' hdim F := by
    intro g g' h _ _ F _
    subst h
    rfl
  rw [degreeOn_eq_invertibleCurveDegree, degreeOn_eq_invertibleCurveDegree,
    invertibleCurveDegree_eq_of_iso k _ hdim
      (show (Scheme.Modules.pullback i).obj ((Scheme.Modules.pullback e).obj L) ≅
        (Scheme.Modules.pullback (i ≫ e)).obj L from (Scheme.Modules.pullbackComp i e).app L)]
  exact h1 (Category.assoc _ _ _).symm _

/-- Divisors `D` and `N` of `X` restrict along `e : Z ⟶ X` to divisors `D'` and `N'` of `Z`, with
`e^* 𝒪_X(N) ≅ 𝒪_Z(N')` and `e^* 𝒪_X(D + uN) ≅ 𝒪_Z(D' + uN')` for every `u : ℤ`. -/
private theorem exists_pullback_divisorialSheaf_add_zsmul_iso {X Z : Scheme.{u}} (e : Z ⟶ X)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral Z] [IsLocallyNoetherian Z]
    [IsNormal Z] [CompactSpace Z] (hcX : ∀ E : Divisor X, E.IsCartier)
    (hcZ : ∀ E : Divisor Z, E.IsCartier) (D N : Divisor X) :
    ∃ D' N' : Divisor Z,
      Nonempty ((Scheme.Modules.pullback e).obj N.divisorialSheaf ≅ N'.divisorialSheaf) ∧
      ∀ u : ℤ, Nonempty ((Scheme.Modules.pullback e).obj (D + u • N).divisorialSheaf ≅
        (D' + u • N').divisorialSheaf) := by
  haveI : ∀ E : Divisor X, Stacks.Ample.IsInvertibleModule X E.divisorialSheaf :=
    fun E => (hcX E).isInvertibleModule_divisorialSheaf
  let R : Divisor X → Divisor Z → Prop := fun A A' =>
    Nonempty ((Scheme.Modules.pullback e).obj A.divisorialSheaf ≅ A'.divisorialSheaf)
  have hR0 : R 0 0 := ⟨(Scheme.Modules.pullback e).mapIso Divisor.divisorialSheafZeroIso ≪≫
    Scheme.Modules.pullbackUnitIso e ≪≫ Divisor.divisorialSheafZeroIso.symm⟩
  have hRadd : ∀ A A' B B', R A A' → R B B' → R (A + B) (A' + B') := fun A A' B B' ⟨φ⟩ ⟨ψ⟩ =>
    ⟨(Scheme.Modules.pullback e).mapIso ((hcX A).divisorialSheafTensorIso (hcX B)).symm ≪≫
      Stacks.Tag01VSPullbackTensor.schemePullbackTensorIso e _ _ ≪≫
      Stacks.Tag01VSPullbackTensor.tensorSheafMapIso φ ψ ≪≫
      (hcZ A').divisorialSheafTensorIso (hcZ B')⟩
  have hRsurj : ∀ A : Divisor X, ∃ A', R A A' := fun A => by
    obtain ⟨A', ⟨φ⟩⟩ := exists_divisorialSheaf_iso_of_isInvertible
      ((Scheme.Modules.pullback e).obj A.divisorialSheaf)
    exact ⟨A', ⟨φ.symm⟩⟩
  have hRneg : ∀ A A', R A A' → R (-A) (-A') := fun A A' hA => by
    obtain ⟨C, ⟨φ⟩⟩ := hRsurj (-A)
    obtain ⟨ψ⟩ := hRadd A A' (-A) C hA ⟨φ⟩
    obtain ⟨χ⟩ := hR0
    have hlin : (A' + C).LinearlyEquivalent 0 :=
      MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso
        (ψ.symm ≪≫ eqToIso (by rw [add_neg_cancel]) ≪≫ χ)
    have hC : C.LinearlyEquivalent (-A') := by
      have := hlin.add (Divisor.LinearlyEquivalent.refl (-A'))
      rwa [show A' + C + -A' = C by abel, zero_add] at this
    exact ⟨φ ≪≫ hC.divisorialSheafIso⟩
  have hRz : ∀ A A', R A A' → ∀ u : ℤ, R (u • A) (u • A') := fun A A' hA u => by
    induction u using Int.induction_on with
    | zero => simpa using hR0
    | succ u ih =>
      have := hRadd _ _ _ _ ih hA
      rwa [← add_one_zsmul, ← add_one_zsmul] at this
    | pred u ih =>
      rw [sub_zsmul, sub_zsmul, one_zsmul, one_zsmul]
      exact hRadd _ _ _ _ ih (hRneg A A' hA)
  obtain ⟨D', hD'⟩ := hRsurj D
  obtain ⟨N', hN'⟩ := hRsurj N
  exact ⟨D', N', hN', fun u => hRadd _ _ _ _ hD' (hRz N N' hN' u)⟩

/-- A divisor `N'` of `Z` representing the restriction of `𝒪_X(N)` along `e : Z ⟶ X` is
numerically trivial when `N` is. -/
private theorem isNumericallyTrivial_of_pullback_divisorialSheaf_iso {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsProjectiveVariety k f] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (e : Z ⟶ X) [IsClosedImmersion e]
    [AlgebraicGeometry.IsProjectiveVariety k (e ≫ f)] [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z]
    (hcX : ∀ E : Divisor X, E.IsCartier) (hcZ : ∀ E : Divisor Z, E.IsCartier) {N : Divisor X}
    {N' : Divisor Z} (φ : (Scheme.Modules.pullback e).obj N.divisorialSheaf ≅ N'.divisorialSheaf)
    (hN : (Divisor.toQDivisor N).IsNumericallyTrivial k f) :
    (Divisor.toQDivisor N').IsNumericallyTrivial k (e ≫ f) := by
  haveI : ∀ E : Divisor X, Stacks.Ample.IsInvertibleModule X E.divisorialSheaf :=
    fun E => (hcX E).isInvertibleModule_divisorialSheaf
  haveI : ∀ E : Divisor Z, Stacks.Ample.IsInvertibleModule Z E.divisorialSheaf :=
    fun E => (hcZ E).isInvertibleModule_divisorialSheaf
  rw [QDivisor.isNumericallyTrivial_iff] at hN ⊢
  obtain ⟨_, hN⟩ := hN
  refine ⟨QDivisor.isQCartier_toQDivisor (hcZ N'), fun C i _ _ _ hC => ?_⟩
  rw [QDivisor.intersectionNumber_toQDivisor k (e ≫ f) i hC.le N' (hcZ N')]
  have h1 := hN C (i ≫ e) hC
  rw [QDivisor.intersectionNumber_toQDivisor k f (i ≫ e) hC.le N (hcX N)] at h1
  have h2 : N'.degreeOn k (e ≫ f) i hC.le (hcZ N') = N.degreeOn k f (i ≫ e) hC.le (hcX N) := by
    change MMP.Mori.degreeOn k (e ≫ f) i hC.le N'.divisorialSheaf =
      MMP.Mori.degreeOn k f (i ≫ e) hC.le N.divisorialSheaf
    rw [← degreeOn_eq_of_iso k (e ≫ f) i hC.le φ]
    exact degreeOn_pullback f e i hC.le _
  rw [h2]
  exact_mod_cast h1

/-- **Restriction to a smooth subvariety.** If `e : Z ↪ X` is a smooth projective subvariety of
dimension at most `n`, then by the induction hypothesis `h⁰(Z, e^* 𝒪_X(D₀ + uN))` is bounded in
`u`: on `Z` these sheaves are `𝒪_Z(D' + uN')` for divisors `D'`, `N'` of `Z` with `N'`
numerically trivial. -/
private theorem exists_bound_restrict {n : ℕ} (ih : Bounded k n) {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (N : Divisor X)
    (hN : (Divisor.toQDivisor N).IsNumericallyTrivial k f) {Z : Scheme.{u}} (e : Z ⟶ X)
    [IsClosedImmersion e] [IsIntegral Z] (hZsm : Smooth (e ≫ f))
    (hZ : topologicalKrullDim Z ≤ n) (D₀ : Divisor X) :
    ∃ B : ℕ, ∀ u : ℤ,
      h0Sheaf k (e ≫ f) ((Scheme.Modules.pullback e).obj (D₀ + u • N).divisorialSheaf) ≤ B := by
  haveI hZvar : AlgebraicGeometry.IsProjectiveVariety k (e ≫ f) :=
    { toIsIntegral := inferInstance
      toIsSeparated := inferInstance
      toLocallyOfFiniteType := inferInstance
      toQuasiCompact := inferInstance
      isProjective := by
        obtain ⟨n, j, hj, hjf⟩ :=
          (inferInstance : AlgebraicGeometry.IsProjectiveVariety k f).isProjective
        haveI := hj
        exact ⟨n, e ≫ j, inferInstance, by rw [Category.assoc, hjf]⟩ }
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (e ≫ f)
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace (e ≫ f)
  haveI : IsNormal Z := isNormal_of_smooth_over_field (e ≫ f)
  have hZsm' : IsSmoothScheme (e ≫ f) := MMP.Mori.isSmoothScheme_of_smooth hZsm
  have hcX : ∀ E : Divisor X, E.IsCartier :=
    MMP.Threefold.Resolution.isCartier_of_isSmoothScheme (sU := f) hsm
  have hcZ : ∀ E : Divisor Z, E.IsCartier :=
    MMP.Threefold.Resolution.isCartier_of_isSmoothScheme (sU := e ≫ f) hZsm'
  obtain ⟨D', N', ⟨φN⟩, hD'⟩ := exists_pullback_divisorialSheaf_add_zsmul_iso e hcX hcZ D₀ N
  obtain ⟨B, hB⟩ := ih Z (e ≫ f) hZsm' hZ D' N'
    (isNumericallyTrivial_of_pullback_divisorialSheaf_iso f e hcX hcZ φN hN)
  refine ⟨B, fun u => ?_⟩
  obtain ⟨φ⟩ := hD' u
  rw [h0Sheaf_congr _ φ, ← h0_eq_h0Sheaf]
  exact hB ⟨u, rfl⟩

/-- The induction step. -/
private theorem bounded_step (n : ℕ) (ih : Bounded k n) : Bounded k (n + 1) := by
  intro X f _ hsm _ _ _ hdim D N hN
  by_cases h0 : topologicalKrullDim X ≤ 0
  · exact bounded_of_dim_le_zero f h0 D N
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_eq_natCast_of_isVariety k f
  obtain ⟨e, rfl⟩ : ∃ e, d = e + 1 := Nat.exists_eq_add_one.mpr (by
    rw [hd] at h0
    by_contra hd0
    exact h0 (by simp [Nat.eq_zero_of_not_pos hd0]))
  have he : e + 1 ≤ n + 1 := by exact_mod_cast hd ▸ hdim
  have hcart : ∀ E : Divisor X, E.IsCartier :=
    MMP.Threefold.Resolution.isCartier_of_isSmoothScheme (sU := f) hsm
  obtain ⟨A, J, M, σ, hσ, hJN, hJA, hvan⟩ := exists_positive_divisor f hsm hd N hN
  haveI hinv : ∀ E : Divisor X, Stacks.Ample.IsInvertibleModule X E.divisorialSheaf :=
    fun E => (hcart E).isInvertibleModule_divisorialSheaf
  haveI : Smooth f := hsm.smooth
  obtain ⟨s, hs, hYsm⟩ := exists_smooth_zeroScheme f A.divisorialSheaf σ hσ
  set Y := zeroScheme X A.divisorialSheaf s
  have hYdim := topologicalKrullDim_zeroScheme_le f hd A.divisorialSheaf s hs
  obtain ⟨ι, _, U, hUint, hUcl, hsum⟩ := exists_components (k := k) (Y.subschemeι ≫ f)
  have hbound : ∀ (c : ι) (t : ℕ), ∃ B : ℕ, ∀ u : ℤ,
      h0Sheaf k (((U c).ι ≫ Y.subschemeι) ≫ f)
        ((Scheme.Modules.pullback ((U c).ι ≫ Y.subschemeι)).obj
          (D - t • A + u • N).divisorialSheaf) ≤ B := by
    intro c t
    haveI := hUint c
    haveI : IsClosedImmersion (U c).ι := IsClosedImmersion.of_isPreimmersion _ (by
      rw [Scheme.Opens.range_ι]
      exact hUcl c)
    refine exists_bound_restrict ih f hsm N hN ((U c).ι ≫ Y.subschemeι) ?_ ?_ (D - t • A)
    · rw [Category.assoc]
      infer_instance
    · refine (((U c).ι.isOpenEmbedding.isEmbedding.topologicalKrullDim_le).trans
        hYdim).trans ?_
      exact_mod_cast Nat.le_of_succ_le_succ he
  choose B hB using hbound
  obtain ⟨m, hm⟩ : ∃ m : ℕ, J D < m * J A := by
    obtain ⟨m, hm⟩ := Archimedean.arch (J D) hJA
    rw [nsmul_eq_mul] at hm
    exact ⟨m + 1, by push_cast; nlinarith⟩
  refine ⟨∑ t ∈ Finset.range m, ∑ c, B c t, ?_⟩
  rintro _ ⟨u, rfl⟩
  dsimp only
  have hzero : (D + u • N - m • A).h0 k f = 0 := hvan _ (by
    simp only [map_add, map_sub, map_nsmul, map_zsmul, hJN, smul_zero, add_zero, nsmul_eq_mul]
    linarith)
  refine (h0_le_h0_sub_nsmul_add_sum f hsm A s hs (D + u • N) m).trans ?_
  rw [hzero, zero_add]
  refine Finset.sum_le_sum fun t _ => (hsum _).trans (Finset.sum_le_sum fun c _ => ?_)
  rw [← Category.assoc, ← sub_add_eq_add_sub]
  exact (h0Sheaf_congr _ ((Scheme.Modules.pullbackComp (U c).ι Y.subschemeι).app _)).trans_le
    (hB c t u)

end Step

private theorem bounded (n : ℕ) : Bounded k n := by
  induction n with
  | zero =>
    intro X f _ _ _ _ _ hdim D N _
    exact bounded_of_dim_le_zero f (by exact_mod_cast hdim) D N
  | succ n ih => exact bounded_step n ih

end MMP.Mori.H0NumericallyTrivialBounded

open CategoryTheory AlgebraicGeometry

universe u

namespace MMP.Mori

namespace Divisor

/-- Let `X` be a smooth projective variety over an algebraically closed field `k` of
characteristic zero, `D` a divisor and `N` a numerically trivial divisor on `X`. Then the
dimensions `h⁰(X, 𝒪_X(D + uN))` for `u ∈ ℤ` are bounded. -/
@[mmp "lem_km2c_h0_numerically_trivial_bounded"]
public theorem bddAbove_range_h0_add_zsmul_of_isNumericallyTrivial
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProjectiveVariety k f] (hsm : IsSmoothScheme f)
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (D N : Divisor X) (hN : (Divisor.toQDivisor N).IsNumericallyTrivial k f) :
    BddAbove (Set.range fun u : ℤ => (D + u • N).h0 k f) := by
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq_natCast_of_isVariety k f
  exact H0NumericallyTrivialBounded.bounded n X f hsm hn.le D N hN

end Divisor

end MMP.Mori
