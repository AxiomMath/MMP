module

public import MMP.AlgebraicGeometry.Divisor.RestrictedSectionAlgebra
public import MMP.AlgebraicGeometry.Divisor.DivisorialSheafQuasicoherent
public import MMP.RingTheory.GradedAlgebra.Veronese

/-!
# Section algebras, their restriction algebras, and Veronese subalgebras

Let `X` be a locally Noetherian normal scheme, `B` a Weil divisor on `X`, and `S` a prime divisor
not in the support of `B`. The restriction map `MMP.Fourfold.weilRestrictionMap` from the section
algebra `R = ⊕_{m ≥ 0} H⁰(X, 𝒪_X(mB)) tᵐ` to `k(S)[t]` is graded: it sends a homogeneous element
`g tᵐ` to `ḡ tᵐ`, where `ḡ` is the residue of `g` in the valuation ring `𝒪_{X,η_S}`.

Suppose moreover that `u ∈ K(X)ˣ` has `div u = S - B`. Then `u t` lies in degree one of `R`, and
for `m ≥ 1` the degree-`m` kernel of restriction is `(u t) R_{m-1}`: an element of `R_m` vanishing
along `S` is divisible by `u`. Consequently `R` is finitely generated over `A = Γ(X, 𝒪_X)` if and
only if its restriction algebra is. For the converse, lift finitely many generators of the
restriction algebra to `R` and adjoin their homogeneous components and `u t`; by induction on the
degree, using the description of the kernel, the resulting `A`-subalgebra is all of `R`.

Finally, finite generation passes from an `ℕ`-graded algebra to each of its Veronese subalgebras
`R^(d) = ⨁_{m ≥ 0} R_{dm}`, `d ≥ 1`: if `R` is generated by homogeneous `y₁, …, yₙ`, then `R^(d)`
is generated by the finitely many monomials in the `yᵢ` with exponents at most `d` and total degree
divisible by `d`.

## Main results

* `MMP.Fourfold.weilRestrictionMap_monomial`: restriction sends `g tᵐ` to `ḡ tᵐ`.
* `MMP.Fourfold.weilRestrictionMap_monomial_eq_zero_iff`: the degree-`m` kernel of restriction
  is `(u t) R_{m-1}`.
* `MMP.Fourfold.finiteType_weilSectionAlgebra_iff`: `R` is of finite type over `Γ(X, 𝒪_X)`
  exactly when the restriction algebra of `B` along `S` is.
* `MMP.Fourfold.veroneseSubalgebra_fg`: a Veronese subalgebra of a finitely generated graded
  algebra is finitely generated.

## Implementation notes

The section algebra and the restriction algebra are subrings of `K(X)[t]` and `k(S)[t]`, so
"finitely generated over `A`" is stated as `RingHom.FiniteType` of the structure maps: the
inclusion `A → R` in degree zero (`Polynomial.C` after `Γ(X, 𝒪_X) → K(X)`), and its composite
with the restriction map, corestricted to the image. In the finite generation criterion the
condition `div u = S - B` is stated coefficientwise, `ord_P u = (S - B)_P` for every prime
divisor `P`, which needs no quasi-compactness of `X`; the description of the kernel is proved in
that form and specialised to `Mori.principalDivisor` under `CompactSpace X`.
-/

@[expose] public section

universe u

open AlgebraicGeometry Polynomial

namespace MMP.Fourfold

open MMP.Mori

section Restriction

variable {X : Scheme} [IsLocallyNoetherian X] [IsNormal X]

/-- Membership in `H⁰(X, 𝒪_X(D))` read one prime divisor at a time on the components of `g`. -/
private theorem mem_divisorialSections_iff {D : Divisor X} {g : RationalFunctions X} :
    g ∈ divisorialSections D ↔ ∀ E : Mori.PrimeDivisor X, E.OrdGE (-D.coeff E) (g E.component) := by
  refine ⟨fun h E => h E ⟨E.genericPoint, ?_, trivial⟩, fun h E _ => h E⟩
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact subset_closure rfl

/-- The component of a unit `φ` of `K(X)` along `E` has order at least `v_E(φ)`. -/
private theorem ordGE_ord (E : Mori.PrimeDivisor X) (φ : (RationalFunctions X)ˣ) :
    E.OrdGE (E.ord φ) ((φ : RationalFunctions X) E.component) :=
  Or.inr (E.valuation_component φ).ge

/-- An element `a` of the discrete valuation ring `𝒪_{X,E}` has zero residue exactly when its
image in `K(X)` has order at least `1` along `E`. -/
private theorem residue_eq_zero_iff_ordGE_one (E : Mori.PrimeDivisor X) (a : E.localRing) :
    X.residue E.genericPoint a = 0 ↔ E.OrdGE 1 (E.toComponent.hom a) := by
  change IsLocalRing.residue _ a = 0 ↔ _
  rw [IsLocalRing.residue_eq_zero_iff]
  refine ⟨E.ordGE_one_toComponent, fun h hu => ?_⟩
  rcases h with h0 | hv
  · exact hu.ne_zero (stalkToRationalFunctions_injective (X := X) E.genericPoint_mem_component
      (h0.trans (map_zero _).symm))
  · rw [E.valuation_toComponent_of_isUnit hu, ← WithZero.exp_zero, WithZero.exp_le_exp] at hv
    exact absurd hv (by norm_num)

/-- On a section-algebra element written as a polynomial `q` over the functions regular at `η_S`,
the restriction map is coefficientwise residue. -/
private theorem weilRestrictionMap_localPolynomialMap {B : Divisor X} {S : Mori.PrimeDivisor X}
    (hS : B.coeff S = 0) (q : (localSubring S)[X])
    (hq : localPolynomialMap S q ∈ weilSectionAlgebra B) :
    weilRestrictionMap hS ⟨_, hq⟩ = q.map (residueAlong S) :=
  congrArg (map (residueAlong S)) (Function.leftInverse_invFun (localPolynomialMap_injective S) q)

/-- The restriction map from the section algebra of `B` to `k(S)[t]` is graded: it sends
`g tᵐ`, for `g ∈ H⁰(X, 𝒪_X(mB))`, to `ḡ tᵐ`, with `ḡ` the residue of `g` at the generic point
of `S`. -/
@[mmp "lem_fourfold_weil_restriction_defined"]
public theorem weilRestrictionMap_monomial {B : Divisor X} {S : Mori.PrimeDivisor X}
    (hS : B.coeff S = 0) {m : ℕ} {g : RationalFunctions X}
    (hg : g ∈ divisorialSections (m • B)) :
    weilRestrictionMap hS ⟨monomial m g, monomial_mem_weilSectionAlgebra.mpr hg⟩ =
      monomial m (residueAlong S ⟨g, divisorialSections_le_localSubring hS m hg⟩) := by
  simpa using weilRestrictionMap_localPolynomialMap hS
    (monomial m ⟨g, divisorialSections_le_localSubring hS m hg⟩)
    (by simpa using monomial_mem_weilSectionAlgebra.mpr hg)

/-- A homogeneous element `g tᵐ` of the section algebra restricts to zero exactly when `g`
vanishes along `S`. -/
private theorem weilRestrictionMap_monomial_eq_zero_iff_ordGE_one {B : Divisor X}
    {S : Mori.PrimeDivisor X} (hS : B.coeff S = 0) {m : ℕ} {g : RationalFunctions X}
    (hg : g ∈ divisorialSections (m • B)) :
    weilRestrictionMap hS ⟨monomial m g, monomial_mem_weilSectionAlgebra.mpr hg⟩ = 0 ↔
      S.OrdGE 1 (g S.component) := by
  obtain ⟨a, ha⟩ := mem_localSubring.mp (divisorialSections_le_localSubring hS m hg)
  rw [weilRestrictionMap_monomial hS hg, monomial_eq_zero_iff, residueAlong_eq _ ha,
    residue_eq_zero_iff_ordGE_one, ha]

variable {B : Divisor X} {S : Mori.PrimeDivisor X} {φ : (RationalFunctions X)ˣ}

/-- If `div φ = S - B`, then `φ ∈ H⁰(X, 𝒪_X(B))`. -/
private theorem coe_mem_divisorialSections
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P) :
    (φ : RationalFunctions X) ∈ divisorialSections ((1 : ℕ) • B) := by
  rw [mem_divisorialSections_iff]
  intro E
  refine (ordGE_ord E φ).mono ?_
  rw [hφ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, one_smul]
  rcases eq_or_ne E S with rfl | h
  · rw [DivisorWithCoeffs.coeff_single_self]
    omega
  · rw [DivisorWithCoeffs.coeff_single_of_ne h.symm]
    omega

/-- If `div φ = S - B` with `S` outside the support of `B`, then `g ∈ H⁰(X, 𝒪_X(mB))` vanishing
along `S` divides by `φ`: `g φ⁻¹ ∈ H⁰(X, 𝒪_X((m - 1)B))`. -/
private theorem mul_inv_mem_divisorialSections (hS : B.coeff S = 0)
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P)
    {m : ℕ} (hm : 1 ≤ m) {g : RationalFunctions X} (hg : g ∈ divisorialSections (m • B))
    (hgS : S.OrdGE 1 (g S.component)) :
    g * ((φ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) ∈
      divisorialSections ((m - 1) • B) := by
  rw [mem_divisorialSections_iff]
  intro E
  have hv := ordGE_ord E φ⁻¹
  rw [Mori.PrimeDivisor.ord_inv, hφ, DivisorWithCoeffs.coeff_sub] at hv
  have hgE : E.OrdGE (-(m • B).coeff E +
      DivisorWithCoeffs.coeff (Finsupp.single S 1 : Divisor X) E) (g E.component) := by
    by_cases hE : S = E
    · subst hE
      rw [DivisorWithCoeffs.coeff_single_self, DivisorWithCoeffs.coeff_smul, hS]
      simpa using hgS
    · rw [DivisorWithCoeffs.coeff_single_of_ne hE]
      simpa using mem_divisorialSections_iff.mp hg E
  refine (hgE.mul hv).mono (le_of_eq ?_)
  simp only [DivisorWithCoeffs.coeff_smul, nsmul_eq_mul, Nat.cast_sub hm]
  ring

/-- If `div φ = S - B` with `S` outside the support of `B`, then `φ w` vanishes along `S` for
every `w ∈ H⁰(X, 𝒪_X(nB))`. -/
private theorem ordGE_one_mul (hS : B.coeff S = 0)
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P)
    {n : ℕ} {w : RationalFunctions X} (hw : w ∈ divisorialSections (n • B)) :
    S.OrdGE 1 (((φ : RationalFunctions X) * w) S.component) := by
  have hv := ordGE_ord S φ
  rw [hφ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_single_self, hS] at hv
  refine (hv.mul (mem_divisorialSections_iff.mp hw S)).mono (le_of_eq ?_)
  simp [DivisorWithCoeffs.coeff_smul, hS]

end Restriction

/-- For `div u = S - B` with `S` a normal prime divisor off the support of `B`, and `m ≥ 1`,
a degree-`m` element `g tᵐ` of the section algebra of `B` lies in the kernel of the restriction
map to `k(S)[t]` if and only if it equals `(u t) · (w tᵐ⁻¹)` for some
`w ∈ H⁰(X, 𝒪_X((m - 1)B))`. -/
@[mmp "lem_fourfold_restriction_positive_kernel"]
public theorem weilRestrictionMap_monomial_eq_zero_iff {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [CompactSpace X] [IsNormal X] {B : Divisor X} {S : Mori.PrimeDivisor X}
    [IsNormal S.idealSheaf.subscheme] (hS : B.coeff S = 0) {u : (RationalFunctions X)ˣ}
    (hu : Mori.principalDivisor u = Finsupp.single S 1 - B) {m : ℕ} (hm : 1 ≤ m)
    {g : RationalFunctions X} (hg : g ∈ divisorialSections (m • B)) :
    weilRestrictionMap hS ⟨monomial m g, monomial_mem_weilSectionAlgebra.mpr hg⟩ = 0 ↔
      ∃ w ∈ divisorialSections ((m - 1) • B),
        monomial m g = monomial 1 (u : RationalFunctions X) * monomial (m - 1) w := by
  have hφ (P : Mori.PrimeDivisor X) : P.ord u = (Finsupp.single S 1 - B : Divisor X).coeff P := by
    rw [← coeff_principalDivisor, hu]
  rw [weilRestrictionMap_monomial_eq_zero_iff_ordGE_one hS hg]
  simp_rw [monomial_mul_monomial, Nat.add_sub_cancel' hm]
  refine ⟨fun h => ⟨_, mul_inv_mem_divisorialSections hS hφ hm hg h, ?_⟩, ?_⟩
  · rw [mul_left_comm, Units.mul_inv, mul_one]
  · rintro ⟨w, hw, heq⟩
    rw [monomial_injective m heq]
    exact ordGE_one_mul hS hφ hw

section Graded

variable {X : Scheme} [IsLocallyNoetherian X] [IsNormal X] {B : Divisor X}

/-- The degree-`m` homogeneous component of an element of the section algebra. -/
private noncomputable def proj (m : ℕ) (p : weilSectionAlgebra B) : weilSectionAlgebra B :=
  ⟨monomial m ((p : (RationalFunctions X)[X]).coeff m),
    monomial_mem_weilSectionAlgebra.mpr (p.2 m)⟩

private theorem coe_proj (m : ℕ) (p : weilSectionAlgebra B) :
    (proj m p : (RationalFunctions X)[X]) = monomial m ((p : (RationalFunctions X)[X]).coeff m) :=
  rfl

private theorem sum_proj (p : weilSectionAlgebra B) :
    ∑ j ∈ Finset.range ((p : (RationalFunctions X)[X]).natDegree + 1), proj j p = p := by
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_finset_sum]
  simp only [coe_proj]
  exact (as_sum_range' _ _ (Nat.lt_succ_self _)).symm

private theorem proj_of_coe_eq_monomial {p : weilSectionAlgebra B} {d : ℕ}
    {a : RationalFunctions X} (hp : (p : (RationalFunctions X)[X]) = monomial d a) (m : ℕ) :
    proj m p = p ∨ proj m p = 0 := by
  rcases eq_or_ne m d with rfl | h
  · exact Or.inl (Subtype.ext (by rw [coe_proj, hp, coeff_monomial_same]))
  · refine Or.inr (Subtype.ext ?_)
    rw [coe_proj, hp, coeff_monomial_of_ne _ h]
    simp

private theorem weilRestrictionMap_proj {S : Mori.PrimeDivisor X} (hS : B.coeff S = 0)
    (m : ℕ) (p : weilSectionAlgebra B) :
    weilRestrictionMap hS (proj m p) = monomial m ((weilRestrictionMap hS p).coeff m) := by
  obtain ⟨a, ha⟩ := divisorialSections_le_localSubring hS m (p.2 m)
  ext n
  rw [coeff_monomial]
  split_ifs with h
  · subst h
    rw [coeff_weilRestrictionMap hS (proj m p) m (a := a)
        (by rw [coe_proj, coeff_monomial_same]; exact ha),
      coeff_weilRestrictionMap hS p m ha]
  · rw [coeff_weilRestrictionMap hS (proj m p) n (a := 0)
      (by rw [coe_proj, coeff_monomial, if_neg h, map_zero]; rfl), map_zero]

/-- A subalgebra generated by homogeneous elements contains the homogeneous components of each
of its elements, over any base ring acting in degree zero. -/
private theorem proj_mem_adjoin {A : Type*} [CommRing A] [Algebra A (weilSectionAlgebra B)]
    (ι : A →+* RationalFunctions X)
    (hι : ∀ a, (algebraMap A (weilSectionAlgebra B) a : (RationalFunctions X)[X]) = C (ι a))
    {G : Set (weilSectionAlgebra B)}
    (hG : ∀ x ∈ G, ∃ d a, (x : (RationalFunctions X)[X]) = monomial d a)
    {c : weilSectionAlgebra B} (hc : c ∈ Algebra.adjoin A G) (m : ℕ) :
    proj m c ∈ Algebra.adjoin A G := by
  let P : weilSectionAlgebra B →ₗ[A] weilSectionAlgebra B :=
    { toFun := proj m
      map_add' := fun p q => Subtype.ext (by simp [coe_proj])
      map_smul' := fun a p => Subtype.ext (by
        rw [RingHom.id_apply, Algebra.smul_def, Algebra.smul_def, Subring.coe_mul, coe_proj,
          coe_proj, Subring.coe_mul, hι, coeff_C_mul, C_mul_monomial]) }
  have hle : (Algebra.adjoin A G).toSubmodule ≤ (Algebra.adjoin A G).toSubmodule.comap P := by
    conv_lhs => rw [Algebra.adjoin_eq_span]
    rw [Submodule.span_le]
    intro x hx
    obtain ⟨d, a, hd⟩ : ∃ d a, (x : (RationalFunctions X)[X]) = monomial d a := by
      induction hx using Submonoid.closure_induction with
      | mem x hx => exact hG x hx
      | one => exact ⟨0, 1, by simp⟩
      | mul x y _ _ hx hy =>
        obtain ⟨d, a, hd⟩ := hx
        obtain ⟨e, b, he⟩ := hy
        exact ⟨d + e, a * b, by rw [Subring.coe_mul, hd, he, monomial_mul_monomial]⟩
    change proj m x ∈ Algebra.adjoin A G
    rcases proj_of_coe_eq_monomial hd m with h1 | h1 <;> rw [h1]
    · exact (Submonoid.closure_le (S := (Algebra.adjoin A G).toSubmonoid)).mpr
        Algebra.subset_adjoin hx
    · exact zero_mem _
  exact hle hc

/-- An `A`-subalgebra of the section algebra that contains `ut`, contains the homogeneous
components of its elements, and maps onto the restriction algebra, is everything. -/
private theorem eq_top_of_restriction {S : Mori.PrimeDivisor X} (hS : B.coeff S = 0)
    {φ : (RationalFunctions X)ˣ}
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P)
    [Algebra Γ(X, ⊤) (weilSectionAlgebra B)]
    (hf : ∀ a, (algebraMap Γ(X, ⊤) (weilSectionAlgebra B) a : (RationalFunctions X)[X]) =
      C (globalSectionsToRationalFunctions a))
    (Cc : Subalgebra Γ(X, ⊤) (weilSectionAlgebra B))
    (hut : (⟨monomial 1 (φ : RationalFunctions X),
      monomial_mem_weilSectionAlgebra.mpr (coe_mem_divisorialSections hφ)⟩ :
        weilSectionAlgebra B) ∈ Cc)
    (hproj : ∀ c ∈ Cc, ∀ m, proj m c ∈ Cc)
    (hsurj : ∀ z, ∃ c ∈ Cc, weilRestrictionMap hS c = weilRestrictionMap hS z) :
    Cc = ⊤ := by
  suffices hdeg : ∀ m (g : RationalFunctions X) (hg : g ∈ divisorialSections (m • B)),
      (⟨monomial m g, monomial_mem_weilSectionAlgebra.mpr hg⟩ : weilSectionAlgebra B) ∈ Cc by
    refine eq_top_iff.mpr fun p _ => ?_
    rw [← sum_proj p]
    exact Subalgebra.sum_mem _ fun j _ => hdeg j _ (p.2 j)
  intro m
  induction m with
  | zero =>
    intro g hg
    obtain ⟨a, rfl⟩ := mem_divisorialSections_zero_iff.mp (by simpa using hg)
    convert Cc.algebraMap_mem a using 1
    exact Subtype.ext (by
      change monomial 0 _ = ((algebraMap _ (weilSectionAlgebra B) a : _) : (RationalFunctions X)[X])
      rw [hf, monomial_zero_left])
  | succ k ih =>
    intro g hg
    set z : weilSectionAlgebra B := ⟨monomial (k + 1) g, monomial_mem_weilSectionAlgebra.mpr hg⟩
      with hz
    obtain ⟨c, hc, e⟩ := hsurj z
    set g' := g - (c : (RationalFunctions X)[X]).coeff (k + 1) with hg'def
    have hg' : g' ∈ divisorialSections ((k + 1) • B) := sub_mem hg (c.2 (k + 1))
    have h0 : weilRestrictionMap hS
        ⟨monomial (k + 1) g', monomial_mem_weilSectionAlgebra.mpr hg'⟩ = 0 := by
      have hzz : proj (k + 1) z = z := Subtype.ext (by rw [coe_proj, hz, coeff_monomial_same])
      have hsub : (⟨monomial (k + 1) g', monomial_mem_weilSectionAlgebra.mpr hg'⟩ :
          weilSectionAlgebra B) = z - proj (k + 1) c :=
        Subtype.ext (by
          rw [AddSubgroupClass.coe_sub, coe_proj, hz]
          change monomial (k + 1) g' = monomial (k + 1) g - _
          rw [hg'def, map_sub])
      rw [hsub, map_sub, weilRestrictionMap_proj, e, ← weilRestrictionMap_proj, hzz, sub_self]
    have hw := mul_inv_mem_divisorialSections hS hφ (Nat.le_add_left 1 k) hg'
      ((weilRestrictionMap_monomial_eq_zero_iff_ordGE_one hS hg').mp h0)
    rw [Nat.add_sub_cancel] at hw
    have hzdec : z = proj (k + 1) c + ⟨monomial 1 (φ : RationalFunctions X),
        monomial_mem_weilSectionAlgebra.mpr (coe_mem_divisorialSections hφ)⟩ *
          ⟨_, monomial_mem_weilSectionAlgebra.mpr hw⟩ := by
      apply Subtype.ext
      rw [Subring.coe_add, Subring.coe_mul, coe_proj, hz]
      change monomial (k + 1) g = monomial (k + 1) _ +
        monomial 1 (φ : RationalFunctions X) * monomial k (g' * _)
      rw [monomial_mul_monomial, mul_comm g', ← mul_assoc, Units.mul_inv, one_mul,
        add_comm 1 k, ← map_add, hg'def, add_sub_cancel]
    rw [hzdec]
    exact Cc.add_mem (hproj c hc _) (Cc.mul_mem hut (ih _ hw))

/-- The converse half of `finiteType_weilSectionAlgebra_iff`, for any structure map
`Γ(X, 𝒪_X) → R` acting in degree zero. -/
private theorem finiteType_of_finiteType_restriction {S : Mori.PrimeDivisor X} (hS : B.coeff S = 0)
    {φ : (RationalFunctions X)ˣ}
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P)
    (f : Γ(X, ⊤) →+* weilSectionAlgebra B)
    (hf : ∀ a, (f a : (RationalFunctions X)[X]) = C (globalSectionsToRationalFunctions a))
    (h : ((weilRestrictionMap hS).rangeRestrict.comp f).FiniteType) : f.FiniteType := by
  classical
  letI := f.toAlgebra
  letI : Algebra Γ(X, ⊤) (weilRestrictionMap hS).range :=
    ((weilRestrictionMap hS).rangeRestrict.comp f).toAlgebra
  let ρA : weilSectionAlgebra B →ₐ[Γ(X, ⊤)] (weilRestrictionMap hS).range :=
    { (weilRestrictionMap hS).rangeRestrict with commutes' := fun _ => rfl }
  obtain ⟨s, hs⟩ := h.out
  choose L hL using fun t => (weilRestrictionMap hS).rangeRestrict_surjective t
  let ut : weilSectionAlgebra B :=
    ⟨monomial 1 (φ : RationalFunctions X),
      monomial_mem_weilSectionAlgebra.mpr (coe_mem_divisorialSections hφ)⟩
  let G : Finset (weilSectionAlgebra B) := insert ut (s.biUnion fun t =>
    (Finset.range ((L t : (RationalFunctions X)[X]).natDegree + 1)).image fun j => proj j (L t))
  have hG : ∀ x ∈ (G : Set (weilSectionAlgebra B)), ∃ d a,
      (x : (RationalFunctions X)[X]) = monomial d a := by
    intro x hx
    simp only [G, Finset.coe_insert, Finset.coe_biUnion, Finset.coe_image, Set.mem_insert_iff,
      Set.mem_iUnion, Set.mem_image] at hx
    rcases hx with rfl | ⟨t, -, j, -, rfl⟩
    · exact ⟨1, _, rfl⟩
    · exact ⟨j, _, coe_proj j (L t)⟩
  let Cc := Algebra.adjoin Γ(X, ⊤) (G : Set (weilSectionAlgebra B))
  have hmap : Cc.map ρA = ⊤ := by
    rw [eq_top_iff, ← hs, Algebra.adjoin_le_iff]
    intro t ht
    refine ⟨L t, ?_, hL t⟩
    rw [← sum_proj (L t)]
    refine Subalgebra.sum_mem _ fun j hj => Algebra.subset_adjoin ?_
    simp only [G, Finset.coe_insert, Finset.coe_biUnion, Finset.coe_image, Set.mem_insert_iff,
      Set.mem_iUnion, Set.mem_image]
    exact Or.inr ⟨t, ht, j, hj, rfl⟩
  refine ⟨⟨G, eq_top_of_restriction hS hφ hf Cc (Algebra.subset_adjoin (by simp [G, ut]))
    (fun c hc m => proj_mem_adjoin globalSectionsToRationalFunctions hf hG hc m) fun z => ?_⟩⟩
  obtain ⟨c, hc, e⟩ : ρA z ∈ Cc.map ρA := hmap ▸ Algebra.mem_top
  exact ⟨c, hc, congrArg Subtype.val e⟩

end Graded

/-- The section algebra of `B` is of finite type over `Γ(X, 𝒪_X)` if and only if its
restriction algebra along a normal prime divisor `S ∉ Supp B` is, provided `S - B` is
principal, `ord_P φ = (S - B)_P` for every prime divisor `P`. The structure map
`Γ(X, 𝒪_X) → weilSectionAlgebra B` is the degree-zero inclusion,
and the image `(weilRestrictionMap hS).range` (which is `weilRestrictionAlgebra hS`) receives
its composite with `weilRestrictionMap hS`. -/
@[mmp "lem_fourfold_restriction_fg"]
public theorem finiteType_weilSectionAlgebra_iff {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {B : Divisor X} {S : Mori.PrimeDivisor X}
    (hS : B.coeff S = 0) (hSn : IsNormal S.idealSheaf.subscheme) {φ : (RationalFunctions X)ˣ}
    (hφ : ∀ P : Mori.PrimeDivisor X, P.ord φ = (Finsupp.single S 1 - B : Divisor X).coeff P) :
    ((C.comp (globalSectionsToRationalFunctions (X := X))).codRestrict (weilSectionAlgebra B)
        (fun s => Subring.mem_comap.mp ((comap_C_weilSectionAlgebra B).ge ⟨s, rfl⟩))).FiniteType ↔
      ((weilRestrictionMap hS).rangeRestrict.comp
        ((C.comp (globalSectionsToRationalFunctions (X := X))).codRestrict
          (weilSectionAlgebra B)
          (fun s => Subring.mem_comap.mp
            ((comap_C_weilSectionAlgebra B).ge ⟨s, rfl⟩)))).FiniteType :=
  ⟨fun h => h.comp_surjective (weilRestrictionMap hS).rangeRestrict_surjective,
    finiteType_of_finiteType_restriction hS hφ _ fun _ => rfl⟩

/-! ### Veronese subalgebras -/

section Veronese

open DirectSum

variable {A R : Type*} [CommSemiring A] [CommSemiring R] [Algebra A R]
variable (𝒜 : ℕ → Submodule A R) [GradedAlgebra 𝒜]

/-- A finitely generated graded algebra is generated by finitely many homogeneous elements:
the homogeneous components of a finite generating set. -/
private theorem exists_homogeneous_generators [Algebra.FiniteType A R] :
    ∃ T : Finset (R × ℕ), (∀ p ∈ T, p.1 ∈ 𝒜 p.2) ∧
      Algebra.adjoin A (Prod.fst '' (T : Set (R × ℕ))) = ⊤ := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := A) (A := R)
  refine ⟨s.biUnion fun x => (decompose 𝒜 x).support.image fun n => ((decompose 𝒜 x n : R), n),
    ?_, ?_⟩
  · intro p hp
    simp only [Finset.mem_biUnion, Finset.mem_image] at hp
    obtain ⟨x, -, n, -, rfl⟩ := hp
    exact (decompose 𝒜 x n).2
  · rw [eq_top_iff, ← hs, Algebra.adjoin_le_iff]
    intro x hx
    rw [← sum_support_decompose 𝒜 x]
    refine Subalgebra.sum_mem _ fun n hn =>
      Algebra.subset_adjoin ⟨((decompose 𝒜 x n : R), n), ?_, rfl⟩
    simp only [Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe, Finset.mem_image]
    exact ⟨x, hx, n, hn, rfl⟩

/-- The monomials `∏ i, y i ^ b i` with every exponent `b i ≤ d` and total degree
`∑ i, b i * e i` divisible by `d`; a finite set generating the Veronese subalgebra. -/
private def boundedMonomials {ι : Type*} [Fintype ι] (y : ι → R) (e : ι → ℕ) (d : ℕ) : Set R :=
  {r | ∃ b : ι → ℕ, (∀ i, b i ≤ d) ∧ d ∣ ∑ i, b i * e i ∧ ∏ i, y i ^ b i = r}

private theorem boundedMonomials_finite {ι : Type*} [Fintype ι] (y : ι → R) (e : ι → ℕ)
    (d : ℕ) : (boundedMonomials y e d).Finite :=
  (Set.finite_range fun b : ι → Fin (d + 1) => ∏ i, y i ^ (b i : ℕ)).subset
    fun _ ⟨b, hb, _, h⟩ => ⟨fun i => ⟨b i, Nat.lt_succ_of_le (hb i)⟩, h⟩

/-- A monomial `∏ i, y i ^ a i` whose total degree is divisible by `d` lies in the algebra
generated by the bounded monomials. -/
private theorem prod_pow_mem_adjoin_boundedMonomials {ι : Type*} [Fintype ι] [DecidableEq ι]
    (y : ι → R) (e : ι → ℕ) {d : ℕ} (hd : 0 < d) (a : ι → ℕ) (ha : d ∣ ∑ i, a i * e i) :
    ∏ i, y i ^ a i ∈ Algebra.adjoin A (boundedMonomials y e d) := by
  have hsplit : ∏ i, y i ^ a i = (∏ i, (y i ^ d) ^ (a i / d)) * ∏ i, y i ^ (a i % d) := by
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [← pow_mul, ← pow_add, Nat.div_add_mod]
  have hsum : ∑ i, a i * e i = d * ∑ i, a i / d * e i + ∑ i, a i % d * e i := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    conv_lhs => rw [← Nat.div_add_mod (a i) d]
    ring
  rw [hsplit]
  refine Subalgebra.mul_mem _ (Subalgebra.prod_mem _ fun i _ => Subalgebra.pow_mem _ ?_ _) ?_
  · refine Algebra.subset_adjoin ⟨fun j => if j = i then d else 0, fun j => ?_, ?_, ?_⟩
    · dsimp only
      split_ifs <;> omega
    · simp [ite_mul, Finset.sum_ite_eq']
    · simp [pow_ite, Finset.prod_ite_eq']
  · refine Algebra.subset_adjoin ⟨fun j => a j % d, fun j => (Nat.mod_lt _ hd).le, ?_, rfl⟩
    exact (Nat.dvd_add_right (dvd_mul_right d _)).mp (hsum ▸ ha)

/-- If `R` is generated by homogeneous elements `y i` of degrees `e i`, the Veronese subalgebra
`R^(d)` is generated by the bounded monomials of degree divisible by `d`. -/
private theorem adjoin_boundedMonomials {ι : Type*} [Fintype ι] [DecidableEq ι] {y : ι → R}
    {e : ι → ℕ} (hy : ∀ i, y i ∈ 𝒜 (e i)) (hgen : Algebra.adjoin A (Set.range y) = ⊤) {d : ℕ}
    (hd : 0 < d) : Algebra.adjoin A (boundedMonomials y e d) = veroneseSubalgebra 𝒜 d := by
  classical
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff]
    rintro r ⟨b, -, ⟨k, hk⟩, rfl⟩
    exact mem_veroneseSubalgebra_of_mem (hk ▸ SetLike.prod_pow_mem_graded 𝒜 e y b fun i _ => hy i)
  · intro x hx
    have hx' : x ∈ Algebra.adjoin A (Set.range y) := hgen ▸ Algebra.mem_top
    rw [Algebra.adjoin_range_eq_range_aeval] at hx'
    obtain ⟨p, rfl⟩ := hx'
    change MvPolynomial.aeval y p ∈ _ at hx ⊢
    rw [← sum_support_decompose 𝒜 (MvPolynomial.aeval y p : R)]
    refine Subalgebra.sum_mem _ fun n _ => ?_
    by_cases hn : d ∣ n
    · rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq', decompose_sum,
        DFinsupp.finsetSum_apply, Submodule.coe_sum]
      refine Subalgebra.sum_mem _ fun a _ => ?_
      have ht : algebraMap A R (p.coeff a) * ∏ i, y i ^ a i ∈ 𝒜 (∑ i, a i * e i) := by
        simpa using SetLike.mul_mem_graded (SetLike.algebraMap_mem_graded 𝒜 (p.coeff a))
          (SetLike.prod_pow_mem_graded 𝒜 e y a fun i _ => hy i)
      by_cases han : ∑ i, a i * e i = n
      · rw [← han, decompose_of_mem_same 𝒜 ht]
        exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
          (prod_pow_mem_adjoin_boundedMonomials y e hd a (han ▸ hn))
      · rw [decompose_of_mem_ne 𝒜 ht han]
        exact Subalgebra.zero_mem _
    · rw [hx n hn]
      exact Subalgebra.zero_mem _

/-- If a commutative `ℕ`-graded `A`-algebra `R` is finitely generated over `A`, then so is its
`d`-th Veronese subalgebra `R^(d)` for every `d ≥ 1`. -/
@[mmp "lem_fourfold_veronese_fg_forward"]
public theorem veroneseSubalgebra_fg [Algebra.FiniteType A R] {d : ℕ} (hd : 0 < d) :
    (veroneseSubalgebra 𝒜 d).FG := by
  classical
  obtain ⟨T, hT, hTgen⟩ := exists_homogeneous_generators 𝒜
  refine ⟨(boundedMonomials_finite (fun p : T => p.1.1) (fun p : T => p.1.2) d).toFinset, ?_⟩
  rw [Set.Finite.coe_toFinset, adjoin_boundedMonomials 𝒜 (fun p : T => hT p.1 p.2) ?_ hd]
  rw [← hTgen]
  congr 1
  ext r
  simp

end Veronese

end MMP.Fourfold
