module

public import MMP.AlgebraicGeometry.AnalytificationChartTransition
public import MMP.AlgebraicGeometry.Analytic.ComplexRealizationCharts

/-!
# The stalks of the analytification

Let `X` be a scheme locally of finite type over `ℂ` and `c` an affine chart of `X`, a
presentation `Γ(X, U) = ℂ[z₁, …, zₙ]/I`. At a `ℂ`-point `y` of `U` with coordinates `p` the stalk
of `𝒪_{X^an}` is the local ring `𝒪_{ℂⁿ,p}/I 𝒪_{ℂⁿ,p}` of the chart: the `c`-component of a
section is an isomorphism from the stalk onto it.

Injectivity: a section whose `c`-component vanishes at `y` is near `y` the class of a holomorphic
function `h` whose germ at `p` lies in `I 𝒪_{ℂⁿ,p}`; writing `h = ∑ aᵢ rᵢ` with `rᵢ ∈ I` near `p`
shows that its germs at nearby points lie in the ideal too, so the `c`-components vanish near
`y`, and so do all other components, the transition maps being injective. Surjectivity: the class
of a holomorphic `h` near `p` is the `c`-component at `y` of the section whose components are the
transports of the classes of the germs of `h`; in another chart `d` this section is, near every
point, the class of `h ∘ P ∘ Q`, where `P` is a polynomial and `Q` a rational coordinate change.

## Main definitions

* `MMP.Analytic.Chart.stalkToStalkRing`: the `c`-component of germs of sections of `𝒪_{X^an}`.

## Main results

* `MMP.Analytic.Chart.injective_stalkToStalkRing`: it is injective.
* `MMP.Analytic.Chart.surjective_stalkToStalkRing`: it is surjective.
* `MMP.Analytic.Chart.exists_stalk_ringEquiv`: the stalk of `𝒪_{X^an}` at `y` is the local ring
  of the chart, compatibly with `α_X^#`.

## References

* [Serre, *Géométrie algébrique et géométrie analytique*], §2.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Topology TopologicalSpace Filter Opposite

namespace MMP.Analytic

open ComplexPoints Analytification

/-- If the germ at `p` of `h` lies in the ideal generated by polynomials of `I`, so do the germs
of `h` at all points near `p`. -/
theorem eventually_exists_mem_map_polyGermHom {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ))
    {p : Fin n → ℂ} {h : (Fin n → ℂ) → ℂ} {g : holGerms p} (hg : g ∈ I.map (polyGermHom p))
    (hgh : (g : Germ (𝓝 p) ℂ) = h) :
    ∀ᶠ q in 𝓝 p, ∃ g' ∈ I.map (polyGermHom q), (g' : Germ (𝓝 q) ℂ) = h := by
  rw [Ideal.map, Ideal.span, Submodule.mem_span_set'] at hg
  obtain ⟨k, a, r, rfl⟩ := hg
  choose α hα hαd using fun i => (a i).2
  choose P hPI hP using fun i => (r i).2
  have heq : ∀ᶠ x in 𝓝 p, ∑ i, α i x * MvPolynomial.eval x (P i) = h x := by
    refine Germ.coe_eq.1 (Eq.trans ?_ hgh)
    change _ = (holGerms p).subtype (∑ i, a i • (r i : holGerms p))
    simp only [map_sum, smul_eq_mul, map_mul, Subring.subtype_apply, ← hα, ← hP,
      coe_polyGermHom]
    have e : ((fun x => ∑ i, α i x * MvPolynomial.eval x (P i) : _ → ℂ) : Germ (𝓝 p) ℂ) =
        Germ.coeRingHom (𝓝 p) (∑ i, α i * fun x => MvPolynomial.eval x (P i)) := by
      congr 1
      funext x
      simp [Finset.sum_apply]
    rw [e, map_sum]
    simp only [map_mul]
    rfl
  filter_upwards [heq.eventually_nhds, Filter.eventually_all.2 fun i => (hαd i).eventually_nhds]
    with q hq hqd
  refine ⟨∑ i, ⟨(α i : Germ (𝓝 q) ℂ), coe_mem_holGerms (hqd i)⟩ * polyGermHom q (P i),
    Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hPI i)), ?_⟩
  refine Eq.trans ?_ (Germ.coe_eq.2 hq)
  change (holGerms q).subtype _ = _
  simp only [map_sum, map_mul, Subring.subtype_apply, coe_polyGermHom]
  have e : ((fun x => ∑ i, α i x * MvPolynomial.eval x (P i) : _ → ℂ) : Germ (𝓝 q) ℂ) =
      Germ.coeRingHom (𝓝 q) (∑ i, α i * fun x => MvPolynomial.eval x (P i)) := by
    congr 1
    funext x
    simp [Finset.sum_apply]
  rw [e, map_sum]
  simp only [map_mul]
  rfl

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

namespace Chart

/-- A subset of the chart of `c` open for the chart topology is open in the space of `ℂ`-points. -/
lemma isOpen_image_val (c : Chart sX) {O : Set (chart (sX := sX) c.U)}
    (hO : IsOpen[chartTopology c.U] O) : IsOpen (Subtype.val '' O) := by
  obtain ⟨hopen, htop, -, -⟩ := c.isOpen_chart_and_isEmbedding_coords
  rw [← htop] at hO
  exact hopen.isOpenMap_subtype_val O hO

/-- The coordinates of a chart are continuous for the chart topology. -/
lemma continuous_coords (c : Chart sX) : Continuous[chartTopology c.U, _] c.coords :=
  @continuous_pi _ _ _ (chartTopology c.U) _ _ fun i => continuous_eval c.U (c.gen i)

/-- The `c`-component at `y` of sections of `𝒪_{X^an}` over an open containing `y`. -/
def sectionComponent (c : Chart sX) (y : ComplexPoints sX) (hy : y ∈ chart (sX := sX) c.U)
    (W : Opens (space sX)) (hyW : y ∈ W) : sections sX W →+* c.StalkRing (c.coords ⟨y, hy⟩) :=
  (Pi.evalRingHom (fun c' : {c : Chart sX // y ∈ chart (sX := sX) c.U} =>
      c'.1.StalkRing (c'.1.coords ⟨y, c'.2⟩)) ⟨c, hy⟩).comp <|
    (Pi.evalRingHom (fun x : W => Fibre x.1) ⟨y, hyW⟩).comp (sections sX W).subtype

/-- The `c`-component of the germs at `y` of sections of `𝒪_{X^an}`. -/
def stalkToStalkRing (c : Chart sX) (y : ComplexPoints sX) (hy : y ∈ chart (sX := sX) c.U) :
    (analytification sX).presheaf.stalk y ⟶ CommRingCat.of (c.StalkRing (c.coords ⟨y, hy⟩)) :=
  Limits.colimit.desc _
    { pt := CommRingCat.of (c.StalkRing (c.coords ⟨y, hy⟩))
      ι :=
        { app := fun W => CommRingCat.ofHom (sectionComponent c y hy W.unop.1 W.unop.2)
          naturality := fun W W' i => by
            ext s
            rfl } }

/-- The `c`-component of the germ at `y` of a section `s` is the value of `s` at `y` in the chart
`c`. -/
lemma stalkToStalkRing_germ (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ chart (sX := sX) c.U) (W : Opens (space sX)) (hyW : y ∈ W) (s : sections sX W) :
    c.stalkToStalkRing y hy ((analytification sX).presheaf.germ W y hyW s) =
      s.1 ⟨y, hyW⟩ ⟨c, hy⟩ := by
  change (TopCat.Presheaf.germ _ W y hyW ≫ c.stalkToStalkRing y hy) s = _
  simp only [TopCat.Presheaf.germ, stalkToStalkRing]
  erw [Limits.colimit.ι_desc]
  rfl

variable [LocallyOfFiniteType sX]

/-- A section of `𝒪_{X^an}` whose component in one chart vanishes at a point vanishes near it. -/
theorem exists_eq_zero_of_apply_eq_zero {W : Opens (space sX)} (s : sections sX W) (c : Chart sX)
    (x : W) (hx : x.1 ∈ chart (sX := sX) c.U) (h0 : s.1 x ⟨c, hx⟩ = 0) :
    ∃ W' : Opens (space sX), x.1 ∈ W' ∧ ∃ hW' : W' ≤ W,
      ∀ (z : W') (d : {d : Chart sX // z.1 ∈ chart (sX := sX) d.U}),
        s.1 ⟨z.1, hW' z.2⟩ d = 0 := by
  obtain ⟨O, hO, hxO, h, hh⟩ := s.2.1 c x hx
  obtain ⟨hxW, gx, hgx, hsx⟩ := hh ⟨x.1, hx⟩ hxO
  have hmem : gx ∈ c.ideal.map (polyGermHom (c.coords ⟨x.1, hx⟩)) :=
    Ideal.Quotient.eq_zero_iff_mem.1 (hsx.symm.trans h0)
  obtain ⟨T, hT, hTo, hxT⟩ :=
    eventually_nhds_iff.1 (eventually_exists_mem_map_polyGermHom c.ideal hmem hgx)
  set O' : Set (chart (sX := sX) c.U) := O ∩ c.coords ⁻¹' T
  have hO' : IsOpen[chartTopology c.U] O' :=
    (chartTopology c.U).isOpen_inter _ _ hO
      (@Continuous.isOpen_preimage _ _ (chartTopology c.U) _ _ c.continuous_coords _ hTo)
  refine ⟨⟨_, c.isOpen_image_val hO'⟩, ⟨⟨x.1, hx⟩, ⟨hxO, hxT⟩, rfl⟩, ?_, ?_⟩
  · rintro _ ⟨o, ho, rfl⟩
    exact (hh o ho.1).1
  · rintro ⟨_, o, ⟨hoO, hoT⟩, rfl⟩ ⟨d, hd⟩
    obtain ⟨hoW, go, hgo, hso⟩ := hh o hoO
    obtain ⟨g', hg'I, hg'⟩ := hT _ hoT
    have hc0 : s.1 ⟨o.1, hoW⟩ ⟨c, o.2⟩ = 0 := by
      rw [hso]
      refine Ideal.Quotient.eq_zero_iff_mem.2 ?_
      convert hg'I using 1
      exact Subtype.ext (hgo.trans hg'.symm)
    obtain ⟨f, e, he, hle, hz⟩ := exists_refinement c d o.1 (mem_chart_iff.1 o.2)
      (mem_chart_iff.1 hd)
    have hz' : o.1 ∈ chart (sX := sX) e.U := mem_chart_iff.2 hz
    have hce : e.U ≤ c.U := he ▸ X.basicOpen_le f
    exact ((ChartHom.ofLE d e hle).bijective_transition ⟨o.1, hz'⟩).1 <|
      (s.2.2 d e (ChartHom.ofLE d e hle) ⟨o.1, hoW⟩ hz').trans
        ((s.2.2 c e (ChartHom.ofLE c e hce) ⟨o.1, hoW⟩ hz').symm.trans
          ((congrArg ((ChartHom.ofLE c e hce).transition ⟨o.1, hz'⟩) hc0).trans
            ((map_zero _).trans (map_zero _).symm)))

/-- The `c`-component of germs at `y` of sections of `𝒪_{X^an}` is injective. -/
theorem injective_stalkToStalkRing (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ chart (sX := sX) c.U) : Function.Injective (c.stalkToStalkRing y hy) := by
  refine (injective_iff_map_eq_zero (c.stalkToStalkRing y hy).hom).2 fun γ hγ => ?_
  obtain ⟨W, hyW, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq _ γ
  replace hγ := (stalkToStalkRing_germ c y hy W hyW s).symm.trans hγ
  obtain ⟨W', hyW', hW', h0⟩ := exists_eq_zero_of_apply_eq_zero s c ⟨y, hyW⟩ hy hγ
  have hres : (analytification sX).presheaf.map (homOfLE hW').op s = 0 :=
    Subtype.ext (funext₂ h0)
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE hW') y hyW', hres, map_zero]

/-- The `c`-component of germs at `y` of sections of `𝒪_{X^an}` is surjective. -/
theorem surjective_stalkToStalkRing (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ chart (sX := sX) c.U) : Function.Surjective (c.stalkToStalkRing y hy) := by
  intro t
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨h, hgh, hhd⟩ := g.2
  obtain ⟨T, hT, hTo, hyT⟩ := eventually_nhds_iff.1 hhd
  have hhd' : ∀ q ∈ T, ∀ᶠ x in 𝓝 q, DifferentiableAt ℂ h x := fun q hq =>
    Filter.eventually_of_mem (hTo.mem_nhds hq) hT
  let W : Opens (space sX) := ⟨_, c.isOpen_image_val
    (@Continuous.isOpen_preimage _ _ (chartTopology c.U) _ _ c.continuous_coords _ hTo)⟩
  have hWc : ∀ x : W, x.1 ∈ chart (sX := sX) c.U := fun ⟨_, o, _, ho⟩ => ho ▸ o.2
  have hWT : ∀ x : W, c.coords ⟨x.1, hWc x⟩ ∈ T := fun ⟨_, _, hoT, rfl⟩ => hoT
  let germAt : ∀ x : W, c.StalkRing (c.coords ⟨x.1, hWc x⟩) := fun x =>
    StalkRing.mk c _ ⟨(h : Germ (𝓝 (c.coords ⟨x.1, hWc x⟩)) ℂ), coe_mem_holGerms (hhd' _ (hWT x))⟩
  let s₀ : ∀ x : W, Fibre x.1 := fun x d => transport c d.1 x.1 (hWc x) d.2 (germAt x)
  have hcompat : IsCompatible s₀ := fun _ _ m x hx =>
    transition_transport m x.1 (hWc x) hx (germAt x)
  have hhol : IsLocallyHolomorphic s₀ := by
    intro d x hx
    obtain ⟨f, e, he, hle, hz⟩ := exists_refinement d c x.1 (mem_chart_iff.1 hx)
      (mem_chart_iff.1 (hWc x))
    have hde : e.U ≤ d.U := he ▸ X.basicOpen_le f
    obtain ⟨G, Q, hGw, hQd, hQw, hinv⟩ := (ChartHom.ofLE d e hde).exists_inverse_of_eq_basicOpen he
    refine ⟨{w | w.1 ∈ W ∧ w.1.toScheme ∈ e.U},
      (chartTopology d.U).isOpen_inter _ _ (isOpen_chart_inter ⟨d.U, d.isAffineOpen⟩ W)
        (isOpen_toScheme_mem ⟨d.U, d.isAffineOpen⟩ e.U), ⟨x.2, hz⟩,
      h ∘ (ChartHom.ofLE c e hle).polyMap ∘ Q, fun w ⟨hwW, hwe⟩ => ?_⟩
    let w' : chart (sX := sX) e.U := ⟨w.1, mem_chart_iff.2 hwe⟩
    have hQd' : ∀ᶠ x in 𝓝 (d.coords ((ChartHom.ofLE d e hde).incl w')),
        DifferentiableAt ℂ Q x :=
      ((differentiable_eval_mvPolynomial G).continuous.continuousAt.eventually_ne
        (hGw w')).mono fun x hx => hQd x hx
    have hQ : Tendsto Q (𝓝 (d.coords ((ChartHom.ofLE d e hde).incl w'))) (𝓝 (e.coords w')) :=
      hQw w' ▸ (hQd _ (hGw w')).continuousAt.tendsto
    let g₁ : holGerms (c.coords ((ChartHom.ofLE c e hle).incl w')) :=
      ⟨(h : Germ _ ℂ), coe_mem_holGerms (hhd' _ (hWT ⟨w.1, hwW⟩))⟩
    obtain ⟨-, hright, -⟩ := hinv w' hQd' hQ
    refine ⟨hwW, holPullbackAt Q hQd' hQ (holPullback (ChartHom.ofLE c e hle).polyMap
      (ChartHom.ofLE c e hle).differentiable_polyMap
      ((ChartHom.ofLE c e hle).tendsto_polyMap w') g₁), rfl, ?_⟩
    exact ((ChartHom.ofLE d e hde).bijective_transition w').1 <|
      (transition_transport (ChartHom.ofLE d e hde) w.1 (hWc ⟨w.1, hwW⟩) w'.2
        (germAt ⟨w.1, hwW⟩)).trans <|
      (transport_transition (ChartHom.ofLE c e hle) w.1 w'.2 (germAt ⟨w.1, hwW⟩)).trans <|
      ((ChartHom.ofLE c e hle).transition_mk w' g₁).trans (hright _).symm
  have hyW : y ∈ W := ⟨⟨y, hy⟩, hyT, rfl⟩
  refine ⟨(analytification sX).presheaf.germ W y hyW ⟨s₀, hhol, hcompat⟩, ?_⟩
  refine (stalkToStalkRing_germ c y hy W hyW ⟨s₀, hhol, hcompat⟩).trans ?_
  change transport c c y (hWc ⟨y, hyW⟩) hy (germAt ⟨y, hyW⟩) = _
  rw [transport_self]
  exact congrArg (StalkRing.mk c _) (Subtype.ext hgh)

/-- **The stalks of the analytification.** At a `ℂ`-point `y` of a chart `c`, the stalk of
`𝒪_{X^an}` is the local ring `𝒪_{ℂⁿ,z(y)}/I 𝒪_{ℂⁿ,z(y)}` of the chart, compatibly with
`α_X^# : 𝒪_{X,y} → 𝒪_{X^an,y}` and `Γ(X, U) → 𝒪_{ℂⁿ,z(y)}/I 𝒪_{ℂⁿ,z(y)}`. -/
theorem exists_stalk_ringEquiv (y : ComplexPoints sX) (c : Chart sX)
    (hy : y ∈ chart (sX := sX) c.U) :
    ∃ e : (analytification sX).presheaf.stalk y ≃+* c.StalkRing (c.coords ⟨y, hy⟩),
      ∀ f : Γ(X, c.U),
        e (((analytificationHom sX).hom.stalkMap y).hom
            (X.presheaf.germ c.U y.toScheme (mem_chart_iff.1 hy) f)) =
          c.toStalkRing (c.coords ⟨y, hy⟩) f := by
  refine ⟨RingEquiv.ofBijective (c.stalkToStalkRing y hy).hom
    ⟨c.injective_stalkToStalkRing y hy, c.surjective_stalkToStalkRing y hy⟩, fun f => ?_⟩
  have e := congrArg (fun φ => φ.hom f)
    (PresheafedSpace.stalkMap_germ (analytificationHom sX).hom c.U y (mem_chart_iff.1 hy))
  simp only [CommRingCat.comp_apply] at e
  change (c.stalkToStalkRing y hy).hom (((analytificationHom sX).hom.stalkMap y).hom
    (X.presheaf.germ c.U y.toScheme _ f)) = _
  erw [e, stalkToStalkRing_germ]
  exact c.stalkHom_germ ⟨y, hy⟩ f

end Chart

end MMP.Analytic
