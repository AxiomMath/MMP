module

public import MMP.AlgebraicGeometry.AnalytificationStalk
public import Mathlib.RingTheory.Localization.Algebra

/-!
# Stalks of the analytification along a closed immersion

Let `i : X → P` be a closed immersion of schemes locally of finite type over `ℂ` and `y` a
`ℂ`-point of `X`. Choose an affine chart `d` of `P` at `i(y)`, a presentation
`Γ(P, V) = ℂ[z₁, …, zₙ]/I`; since `Γ(P, V) → Γ(X, i⁻¹V)` is surjective, the images of the
generators give a chart `c` of `X` on `i⁻¹V`, with ideal `J ⊇ I` and the same coordinates at `y`.
Then the stalk of `𝒪_{X^an}` at `y` is `𝒪_{ℂⁿ,p}/J 𝒪 = (𝒪_{ℂⁿ,p}/I 𝒪)/(J/I)`, and `J/I` is the
image of the kernel of `Γ(P, V) → Γ(X, i⁻¹V)`, whose localization is the kernel of
`𝒪_{P,i(y)} → 𝒪_{X,y}`. Hence `𝒪_{X^an,y}` is the quotient of `𝒪_{P^an,i(y)}` by the ideal
generated by that kernel.

## Main definitions

* `MMP.Analytic.Chart.comapClosedImmersion`: the chart of `X` induced by a chart of `P`.

## Main results

* `MMP.Analytic.exists_stalk_ringEquiv_quotient_of_isClosedImmersion`: the stalk of `𝒪_{X^an}`
  at `y` is the quotient of the stalk of `𝒪_{P^an}` at `i(y)` by the kernel of
  `𝒪_{P,i(y)} → 𝒪_{X,y}`.

## References

* [Serre, *Géométrie algébrique et géométrie analytique*], §2.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Analytic

open ComplexPoints Analytification

variable {X P : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {sP : P ⟶ Spec (.of ℂ)}

/-- For `i : X → P` over `ℂ`, the image under `i^#` of a constant `a ∈ ℂ` in `Γ(P, V)` is the
constant `a` in `Γ(X, i⁻¹V)`. -/
lemma baseRingHom_preimage_apply (i : X ⟶ P) (hi : i ≫ sP = sX) (V : P.Opens) (a : ℂ) :
    baseRingHom sX (i ⁻¹ᵁ V) a = i.app V (baseRingHom sP V a) := by
  subst hi
  simp only [baseRingHom, RingHom.coe_comp, Function.comp_apply, Scheme.Hom.comp_appTop]
  rw [CommRingCat.comp_apply, ← CommRingCat.comp_apply (i.appTop),
    ← CommRingCat.comp_apply (P.presheaf.map _), Scheme.Hom.naturality]
  rfl

/-- A `ℂ`-point `y` of `X` lies in `i⁻¹V` if and only if its image `i(y)` lies in `V`. -/
lemma mem_chart_preimage_iff (i : X ⟶ P) (hi : i ≫ sP = sX) {V : P.Opens}
    {y : ComplexPoints sX} :
    y ∈ chart (sX := sX) (i ⁻¹ᵁ V) ↔ realize i hi y ∈ chart (sX := sP) V := by
  rw [mem_chart_iff, mem_chart_iff]
  rfl

/-- Evaluating `i^# a` at a `ℂ`-point `y` of `i⁻¹V` equals evaluating `a ∈ Γ(P, V)` at `i(y)`. -/
lemma evalHom_preimage_app (i : X ⟶ P) (hi : i ≫ sP = sX) {V : P.Opens}
    (y : chart (sX := sX) (i ⁻¹ᵁ V)) (a : Γ(P, V)) :
    evalHom (i ⁻¹ᵁ V) y (i.app V a) =
      evalHom V ⟨realize i hi y.1, (mem_chart_preimage_iff i hi).1 y.2⟩ a := by
  simp only [evalHom, RingHom.coe_comp, Function.comp_apply]
  congr 1

/-- Along a closed immersion `i : X → P`, the kernel of `𝒪_{P,i(x)} → 𝒪_{X,x}` is generated by the
kernel of `Γ(P, V) → Γ(X, i⁻¹V)` for an affine open `V ∋ i(x)`. -/
theorem ker_stalkMap_eq_map_ker_app (i : X ⟶ P) [IsClosedImmersion i] {V : P.Opens}
    (hV : IsAffineOpen V) (x : X) (hx : i x ∈ V) :
    RingHom.ker (i.stalkMap x).hom =
      (RingHom.ker (i.app V).hom).map (P.presheaf.germ V (i x) hx).hom := by
  let _ := TopCat.Presheaf.algebra_section_stalk P.presheaf (U := V) ⟨i x, hx⟩
  have := hV.isLocalization_stalk ⟨i x, hx⟩
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := i ⁻¹ᵁ V) ⟨x, hx⟩
  have := (hV.preimage i).isLocalization_stalk ⟨x, hx⟩
  have hcomap := IsAffineOpen.comap_primeIdealOf_appLE V hV (i ⁻¹ᵁ V) (hV.preimage i) le_rfl
    (x := x) hx
  rw [← Scheme.Hom.app_eq_appLE] at hcomap
  have hT : Submonoid.map (i.app V).hom
      (hV.primeIdealOf ⟨i x, hx⟩).asIdeal.primeCompl =
      ((hV.preimage i).primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl := by
    ext b
    constructor
    · rintro ⟨a, ha, rfl⟩ hb
      exact ha (by rwa [← hcomap])
    · intro hb
      obtain ⟨a, rfl⟩ := i.app_surjective V hV b
      exact ⟨a, fun ha => hb (by rwa [← hcomap] at ha), rfl⟩
  have heq : (i.stalkMap x).hom = IsLocalization.map (X.presheaf.stalk x) (i.app V).hom
      (hT.symm ▸ Submonoid.le_comap_map _ :
        (hV.primeIdealOf ⟨i x, hx⟩).asIdeal.primeCompl ≤
          Submonoid.comap (i.app V).hom
            ((hV.preimage i).primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl) := by
    refine IsLocalization.ringHom_ext (hV.primeIdealOf ⟨i x, hx⟩).asIdeal.primeCompl ?_
    ext a
    simp only [RingHom.coe_comp, Function.comp_apply, IsLocalization.map_eq]
    exact Scheme.Hom.germ_stalkMap_apply i V x hx a
  rw [heq]
  exact IsLocalization.ker_map _ _ hT

/-- The presentation map `ℂ[z₁, …, zₙ] → Γ(X, i⁻¹V)` sending `zⱼ` to the image under `i^#` of the
`j`-th generator of `d` is the composite of `d.pres` with `i^#`. -/
lemma eval₂Hom_app_comp (i : X ⟶ P) (hi : i ≫ sP = sX) (d : Chart sP) :
    MvPolynomial.eval₂Hom (baseRingHom sX (i ⁻¹ᵁ d.U)) (fun j => i.app d.U (d.gen j)) =
      (i.app d.U).hom.comp d.pres := by
  ext a <;> simp [Chart.pres, baseRingHom_preimage_apply i hi]

namespace Chart

/-- The chart of `X` on `i⁻¹V` induced by a chart `d` of `P` on `V` along a closed immersion
`i : X → P`: its generators are the images of those of `d`. -/
abbrev comapClosedImmersion (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX) (d : Chart sP) :
    Chart sX where
  U := i ⁻¹ᵁ d.U
  isAffineOpen := d.isAffineOpen.preimage i
  n := d.n
  gen j := i.app d.U (d.gen j)
  surjective := by
    rw [eval₂Hom_app_comp i hi d]
    exact (i.app_surjective d.U d.isAffineOpen).comp d.surjective

variable (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX) (d : Chart sP)

/-- The presentation of `comapClosedImmersion i hi d` is `d.pres` followed by `i^#`. -/
lemma comapClosedImmersion_pres :
    (comapClosedImmersion i hi d).pres = (i.app d.U).hom.comp d.pres :=
  eval₂Hom_app_comp i hi d

/-- The ideal of `comapClosedImmersion i hi d` is the preimage under `d.pres` of the kernel of
`i^# : Γ(P, V) → Γ(X, i⁻¹V)`. -/
lemma comapClosedImmersion_ideal :
    (comapClosedImmersion i hi d).ideal = (RingHom.ker (i.app d.U).hom).comap d.pres := by
  rw [Chart.ideal, comapClosedImmersion_pres]
  rfl

/-- The ideal of `d` is contained in the ideal of `comapClosedImmersion i hi d`. -/
lemma ideal_le_comapClosedImmersion_ideal : d.ideal ≤ (comapClosedImmersion i hi d).ideal := by
  rw [comapClosedImmersion_ideal]
  intro q hq
  rw [Ideal.mem_comap, RingHom.mem_ker, (RingHom.mem_ker).1 hq, map_zero]

/-- The coordinates of a `ℂ`-point `y` in the chart `comapClosedImmersion i hi d` are the
coordinates of `i(y)` in the chart `d`. -/
lemma coords_comapClosedImmersion (y : chart (sX := sX) (comapClosedImmersion i hi d).U) :
    (comapClosedImmersion i hi d).coords y =
      d.coords ⟨realize i hi y.1, (mem_chart_preimage_iff i hi).1 y.2⟩ := by
  funext j
  exact evalHom_preimage_app i hi y (d.gen j)

end Chart

/-- If `p` is the coordinates of `y` in the chart `c`, then the stalk of `𝒪_{X^an}` at `y` is
isomorphic to `c.StalkRing p`, compatibly with `c.toStalkRing p` on sections over `c.U`. -/
lemma Chart.exists_stalk_ringEquiv_of_coords_eq [LocallyOfFiniteType sX] (y : ComplexPoints sX)
    (c : Chart sX) (hy : y ∈ chart (sX := sX) c.U) {p : Fin c.n → ℂ}
    (hp : c.coords ⟨y, hy⟩ = p) :
    ∃ e : (analytification sX).presheaf.stalk y ≃+* c.StalkRing p,
      ∀ f : Γ(X, c.U),
        e (((analytificationHom sX).hom.stalkMap y).hom
            (X.presheaf.germ c.U y.toScheme (mem_chart_iff.1 hy) f)) = c.toStalkRing p f := by
  subst hp
  exact Chart.exists_stalk_ringEquiv y c hy

/-- **Stalks along a closed immersion.** For a closed immersion `i : X → P` over `ℂ` and a
`ℂ`-point `y` of `X`, the stalk of `𝒪_{X^an}` at `y` is the quotient of the stalk of `𝒪_{P^an}`
at `i(y)` by the ideal generated by the kernel of `i^# : 𝒪_{P,i(y)} → 𝒪_{X,y}`, compatibly with
the comparison maps `𝒪_{P,i(y)} → 𝒪_{P^an,i(y)}` and `𝒪_{X,y} → 𝒪_{X^an,y}`. -/
theorem exists_stalk_ringEquiv_quotient_of_isClosedImmersion
    [LocallyOfFiniteType sP] (i : X ⟶ P) [IsClosedImmersion i] (hi : i ≫ sP = sX)
    (y : ComplexPoints sX) :
    ∃ e : (analytification sP).presheaf.stalk (realize i hi y) ⧸
        (RingHom.ker (i.stalkMap y.toScheme).hom).map
          ((analytificationHom sP).hom.stalkMap (realize i hi y)).hom ≃+*
        (analytification sX).presheaf.stalk y,
      ∀ a, e (Ideal.Quotient.mk _
          (((analytificationHom sP).hom.stalkMap (realize i hi y)).hom a)) =
        ((analytificationHom sX).hom.stalkMap y).hom ((i.stalkMap y.toScheme).hom a) := by
  have : LocallyOfFiniteType sX := hi ▸ inferInstance
  obtain ⟨V, hV, hyV, -⟩ := (Opens.isBasis_iff_nbhd.mp P.isBasis_affineOpens)
    (show i y.toScheme ∈ (⊤ : P.Opens) from trivial)
  obtain ⟨d, rfl⟩ := Chart.exists_eq (sX := sP) hV
  set c := Chart.comapClosedImmersion i hi d
  have hy : y ∈ chart (sX := sX) c.U := mem_chart_iff.2 hyV
  have hy' : realize i hi y ∈ chart (sX := sP) d.U := (mem_chart_preimage_iff i hi).1 hy
  set p := d.coords ⟨realize i hi y, hy'⟩
  obtain ⟨eP, heP⟩ := Chart.exists_stalk_ringEquiv (realize i hi y) d hy'
  obtain ⟨eX, heX⟩ := Chart.exists_stalk_ringEquiv_of_coords_eq y c hy
    (Chart.coords_comapClosedImmersion i hi d ⟨y, hy⟩)
  let φP : P.presheaf.stalk (i y.toScheme) →+* (analytification sP).presheaf.stalk
      (realize i hi y) := ((analytificationHom sP).hom.stalkMap (realize i hi y)).hom
  let germP : Γ(P, d.U) →+* P.presheaf.stalk (i y.toScheme) :=
    (P.presheaf.germ d.U (i y.toScheme) hyV).hom
  let g : Γ(P, d.U) →+* Γ(X, i ⁻¹ᵁ d.U) := (i.app d.U).hom
  let K : Ideal (P.presheaf.stalk (i y.toScheme)) := RingHom.ker (i.stalkMap y.toScheme).hom
  have hK : K = (RingHom.ker g).map germP := ker_stalkMap_eq_map_ker_app i hV y.toScheme hyV
  let π := polyGermHom p
  let I : Ideal (holGerms p) := d.ideal.map π
  let I' : Ideal (holGerms p) := ((RingHom.ker g).comap d.pres).map π
  have hcI : c.ideal.map π = I' :=
    congrArg (Ideal.map π) (Chart.comapClosedImmersion_ideal i hi d)
  have hle : I ≤ I' := hcI ▸ Ideal.map_mono (Chart.ideal_le_comapClosedImmersion_ideal i hi d)
  let eX' : (analytification sX).presheaf.stalk y ≃+* holGerms p ⧸ I' :=
    eX.trans (Ideal.quotEquivOfEq hcI)
  have hcomp : ((eP : _ →+* d.StalkRing p).comp φP).comp germP = d.toStalkRing p :=
    RingHom.ext heP
  have hmk : (Ideal.Quotient.mk I).comp π = (d.toStalkRing p).comp d.pres :=
    RingHom.ext fun q => (d.toStalkRing_pres p q).symm
  have hR : (K.map φP).map (eP : _ →+* d.StalkRing p) = (RingHom.ker g).map (d.toStalkRing p) := by
    rw [hK, Ideal.map_map, Ideal.map_map, ← hcomp]
  have hJ : I'.map (Ideal.Quotient.mk I) = (K.map φP).map (eP : _ →+* d.StalkRing p) := by
    rw [hR]
    change (((RingHom.ker g).comap d.pres).map π).map (Ideal.Quotient.mk I) = _
    rw [Ideal.map_map, hmk]
    exact (Ideal.map_map d.pres (d.toStalkRing p)).symm.trans
      (congrArg (Ideal.map (d.toStalkRing p)) (Ideal.map_comap_of_surjective _ d.surjective _))
  let _ := TopCat.Presheaf.algebra_section_stalk P.presheaf (U := d.U) ⟨i y.toScheme, hyV⟩
  have := hV.isLocalization_stalk ⟨i y.toScheme, hyV⟩
  have key : (((DoubleQuot.quotQuotEquivQuotOfLE hle : _ →+* holGerms p ⧸ I').comp
      (Ideal.Quotient.mk (I'.map (Ideal.Quotient.mk I)))).comp
        (eP : _ →+* d.StalkRing p)).comp φP =
      ((eX' : _ →+* holGerms p ⧸ I').comp ((analytificationHom sX).hom.stalkMap y).hom).comp
        (i.stalkMap y.toScheme).hom := by
    refine IsLocalization.ringHom_ext (hV.primeIdealOf ⟨i y.toScheme, hyV⟩).asIdeal.primeCompl ?_
    ext f
    obtain ⟨q, rfl⟩ := d.surjective f
    change DoubleQuot.quotQuotEquivQuotOfLE hle (Ideal.Quotient.mk (I'.map (Ideal.Quotient.mk I))
        (eP (φP (germP (d.pres q))))) =
      eX' (((analytificationHom sX).hom.stalkMap y).hom
        ((i.stalkMap y.toScheme).hom (germP (d.pres q))))
    have h2 := heX (c.pres q)
    have h4 : c.pres q = g (d.pres q) :=
      RingHom.congr_fun (Chart.comapClosedImmersion_pres i hi d) q
    rw [h4] at h2
    erw [heP (d.pres q), Scheme.Hom.germ_stalkMap_apply i d.U y.toScheme hyV (d.pres q)]
    change _ = Ideal.quotEquivOfEq hcI (eX _)
    erw [h2, d.toStalkRing_pres, DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk, ← h4,
      c.toStalkRing_pres]
    rfl
  refine ⟨(Ideal.quotientEquiv (K.map φP) (I'.map (Ideal.Quotient.mk I)) eP hJ).trans
    ((DoubleQuot.quotQuotEquivQuotOfLE hle).trans eX'.symm), fun a => ?_⟩
  exact eX'.injective ((eX'.apply_symm_apply _).trans (RingHom.congr_fun key a))

end MMP.Analytic
