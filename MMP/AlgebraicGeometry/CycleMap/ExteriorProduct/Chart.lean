module

public import MMP.AlgebraicGeometry.CycleMap.ExteriorProduct.Homeomorph
public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.AlgebraicChart

/-!
# Products of algebraic charts (Fulton, §19.1)

Let `P = A ×_S B` be a fibre product of schemes over a field `K`, and `U_A ⊆ A`, `U_B ⊆ B`,
`U_S ⊆ S` affine opens with `U_A, U_B` over `U_S`. The sections of `𝒪_P` over the affine chart
`pr₁⁻¹ U_A ∩ pr₂⁻¹ U_B` are generated by the pull-backs of sections over `U_A` and `U_B`: for any
ring `Q` of `K`-valued functions on `A(K) × B(K)` containing the functions `(x, y) ↦ a(x)` and
`(x, y) ↦ b(y)`, the values of every such section are given by a function of `Q` evaluated at
`(pr₁ w, pr₂ w)`.

For schemes `V`, `W` over `𝕜 = ℝ` or `ℂ` and algebraic charts `e` of `V(𝕜)` and `e'` of
`W(𝕜)`, the product chart `(V × W)(𝕜) ≅ V(𝕜) × W(𝕜) ⊇ e.source × e'.source → E × E'` is then an
algebraic chart of `(V × W)(𝕜)`: its coordinates are pull-backs of those of `e` and `e'`, and a
regular function on `V × W` is near every point a fraction `c / hᵐ` with `c`, `h` in the ring
generated by pull-backs, hence analytic in the product chart.

## Main definitions

* `MMP.UnderlyingSpace.sectionsOfSubring`: the sections over
  `pr₁⁻¹ U_A ∩ pr₂⁻¹ U_B` whose values are a function of `Q` of the two projections.
* `MMP.UnderlyingSpace.productChart`: the product of two charts, read on
  `(V × W)(𝕜)`.

## Main results

* `MMP.UnderlyingSpace.exists_mem_subring_eval_eq`: the generation statement.
* `MMP.UnderlyingSpace.isAlgebraicChart_productChart`: products of algebraic
  charts are algebraic.
* `MMP.UnderlyingSpace.IsAlgebraicChart.contDiffOn_symm_trans₂`: the transition
  map between algebraic charts with values in two normed spaces is `C^ω`.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Limits TopologicalSpace Topology
open scoped ContDiff

universe u

namespace MMP

namespace UnderlyingSpace

section Generation

variable {K : Type u} [Field K] [TopologicalSpace K] {P A B S : Scheme.{u}}
  [P.Over (Spec (.of K))] [A.Over (Spec (.of K))] [B.Over (Spec (.of K))]

/-- Evaluating the pull-back `φ.appLE U V e a` at a point `q` landing in `V` gives the value of
`a` at the image point `mapFun φ q`. -/
lemma evalExt_appLE {X Y : Scheme.{u}} [X.Over (Spec (.of K))] [Y.Over (Spec (.of K))]
    (φ : X ⟶ Y) [φ.IsOver (Spec (.of K))] {U : Y.Opens} {V : X.Opens} (e : V ≤ φ ⁻¹ᵁ U)
    (a : Γ(Y, U)) {q : UnderlyingSpace K X} (hq : ⊤ ≤ q.toHom ⁻¹ᵁ V) :
    evalExt V (φ.appLE U V e a) q = evalExt U a (mapFun φ q) := by
  rw [evalExt_of_le _ hq, eval_appLE, evalExt_of_le]

/-- For a ring `Q` of `K`-valued functions on `A(K) × B(K)`, the sections over
`pr₁⁻¹ U_A ∩ pr₂⁻¹ U_B` whose values are given by a function of `Q` of the two projections. -/
def sectionsOfSubring (Q : Subring (UnderlyingSpace K A × UnderlyingSpace K B → K))
    (fst : P ⟶ A) (snd : P ⟶ B) [fst.IsOver (Spec (.of K))] [snd.IsOver (Spec (.of K))]
    (UA : A.Opens) (UB : B.Opens) : Subring Γ(P, fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB) where
  carrier := {c | ∃ F ∈ Q,
    ∀ (w : UnderlyingSpace K P) (hw : ⊤ ≤ w.toHom ⁻¹ᵁ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)),
      eval w hw c = F (prodMap fst snd w)}
  mul_mem' := by
    rintro c d ⟨F, hF, hF'⟩ ⟨G, hG, hG'⟩
    refine ⟨F * G, Q.mul_mem hF hG, fun w hw ↦ ?_⟩
    rw [← evalRingHom_apply, map_mul, evalRingHom_apply, evalRingHom_apply, hF', hG',
      Pi.mul_apply]
  one_mem' := ⟨1, Q.one_mem, fun w hw ↦ by
    rw [← evalRingHom_apply, map_one, Pi.one_apply]⟩
  add_mem' := by
    rintro c d ⟨F, hF, hF'⟩ ⟨G, hG, hG'⟩
    refine ⟨F + G, Q.add_mem hF hG, fun w hw ↦ ?_⟩
    rw [← evalRingHom_apply, map_add, evalRingHom_apply, evalRingHom_apply, hF', hG',
      Pi.add_apply]
  zero_mem' := ⟨0, Q.zero_mem, fun w hw ↦ by
    rw [← evalRingHom_apply, map_zero, Pi.zero_apply]⟩
  neg_mem' := by
    rintro c ⟨F, hF, hF'⟩
    refine ⟨-F, Q.neg_mem hF, fun w hw ↦ ?_⟩
    rw [← evalRingHom_apply, map_neg, evalRingHom_apply, hF', Pi.neg_apply]

/-- A section lies in `sectionsOfSubring Q fst snd UA UB` iff its values are given by a function
of `Q` of the two projections. -/
@[simp]
lemma mem_sectionsOfSubring {Q : Subring (UnderlyingSpace K A × UnderlyingSpace K B → K)}
    {fst : P ⟶ A} {snd : P ⟶ B} [fst.IsOver (Spec (.of K))] [snd.IsOver (Spec (.of K))]
    {UA : A.Opens} {UB : B.Opens} {c : Γ(P, fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)} :
    c ∈ sectionsOfSubring Q fst snd UA UB ↔ ∃ F ∈ Q,
      ∀ (w : UnderlyingSpace K P) (hw : ⊤ ≤ w.toHom ⁻¹ᵁ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)),
        eval w hw c = F (prodMap fst snd w) :=
  Iff.rfl

/-- **Sections of a fibre product are generated by pull-backs.** On an affine chart
`pr₁⁻¹ U_A ∩ pr₂⁻¹ U_B` of a pullback `P = A ×_S B` over `K`, the values of every section are a
function of the two projections lying in any ring `Q` of functions on `A(K) × B(K)` which
contains the functions `(x, y) ↦ a(x)`, `a ∈ Γ(A, U_A)`, and `(x, y) ↦ b(y)`, `b ∈ Γ(B, U_B)`. -/
lemma exists_mem_subring_eval_eq {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S}
    [fst.IsOver (Spec (.of K))] [snd.IsOver (Spec (.of K))] (H : IsPullback fst snd f g)
    {US : S.Opens} {UA : A.Opens} {UB : B.Opens} (hUS : IsAffineOpen US)
    (hUA : IsAffineOpen UA) (hUB : IsAffineOpen UB) (hUAS : UA ≤ f ⁻¹ᵁ US)
    (hUBS : UB ≤ g ⁻¹ᵁ US) (Q : Subring (UnderlyingSpace K A × UnderlyingSpace K B → K))
    (hQA : ∀ a : Γ(A, UA), (fun z ↦ evalExt UA a z.1) ∈ Q)
    (hQB : ∀ b : Γ(B, UB), (fun z ↦ evalExt UB b z.2) ∈ Q)
    (c : Γ(P, fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)) :
    ∃ F ∈ Q, ∀ (w : UnderlyingSpace K P) (hw : ⊤ ≤ w.toHom ⁻¹ᵁ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)),
      eval w hw c = F (prodMap fst snd w) := by
  have hiso := isIso_pushoutSection_of_isAffineOpen H hUBS hUAS rfl hUS hUB hUA
  let T := sectionsOfSubring Q fst snd UA UB
  have hA : ∀ a : Γ(A, UA), fst.appLE UA (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB) inf_le_left a ∈ T :=
    fun a ↦ ⟨_, hQA a, fun w hw ↦ by rw [eval_appLE]; exact (evalExt_of_le _ _).symm⟩
  have hB : ∀ b : Γ(B, UB), snd.appLE UB (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB) inf_le_right b ∈ T :=
    fun b ↦ ⟨_, hQB b, fun w hw ↦ by rw [eval_appLE]; exact (evalExt_of_le _ _).symm⟩
  let φA : Γ(A, UA) ⟶ CommRingCat.of T := CommRingCat.ofHom
    ((fst.appLE UA _ inf_le_left).hom.codRestrict T hA)
  let φB : Γ(B, UB) ⟶ CommRingCat.of T := CommRingCat.ofHom
    ((snd.appLE UB _ inf_le_right).hom.codRestrict T hB)
  have hcomm : f.appLE US UA hUAS ≫ φA = g.appLE US UB hUBS ≫ φB := by
    ext a
    change (f.appLE US UA hUAS ≫ fst.appLE UA _ inf_le_left) a =
      (g.appLE US UB hUBS ≫ snd.appLE UB _ inf_le_right) a
    simp only [Scheme.Hom.appLE_comp_appLE, H.w]
  have hk : Limits.pushout.desc φA φB hcomm ≫ CommRingCat.ofHom T.subtype =
      pushoutSection H hUBS hUAS rfl := by
    refine Limits.pushout.hom_ext ?_ ?_
    · rw [← Category.assoc, Limits.pushout.inl_desc, Limits.pushout.inl_desc]
      rfl
    · rw [← Category.assoc, Limits.pushout.inr_desc, Limits.pushout.inr_desc]
      rfl
  have : c = (Limits.pushout.desc φA φB hcomm ≫ CommRingCat.ofHom T.subtype)
      (inv (pushoutSection H hUBS hUAS rfl) c) := by
    rw [hk, ← CommRingCat.comp_apply, IsIso.inv_hom_id, CommRingCat.id_apply]
  rw [this]
  exact (Limits.pushout.desc φA φB hcomm (inv (pushoutSection H hUBS hUAS rfl) c)).2

end Generation

section Chart

variable {𝕜 : Type u} [RCLike 𝕜] {E E' : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  [NormedAddCommGroup E'] [NormedSpace 𝕜 E']

/-- The ring of functions `G` on a space `X` with `G ∘ φ` analytic on `s ⊆ F`. -/
def contDiffOnCompSubring {F X : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F] (φ : F → X)
    (s : Set F) : Subring (X → 𝕜) where
  carrier := {G | ContDiffOn 𝕜 ω (G ∘ φ) s}
  mul_mem' hF hG := hF.mul hG
  one_mem' := contDiffOn_const
  add_mem' hF hG := hF.add hG
  zero_mem' := contDiffOn_const
  neg_mem' hF := hF.neg

/-- A function `G` lies in `contDiffOnCompSubring φ s` iff `G ∘ φ` is analytic on `s`. -/
@[simp]
lemma mem_contDiffOnCompSubring {F X : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
    {φ : F → X} {s : Set F} {G : X → 𝕜} :
    G ∈ contDiffOnCompSubring φ s ↔ ContDiffOn 𝕜 ω (G ∘ φ) s :=
  Iff.rfl

namespace IsAlgebraicChart

variable {X : Scheme.{u}} [X.Over (Spec (.of 𝕜))]

/-- **Algebraic charts are analytically compatible.** The transition map between two algebraic
charts, with values in two normed spaces `E` and `E'`, is `C^ω` on its source. -/
theorem contDiffOn_symm_trans₂ {e : OpenPartialHomeomorph (UnderlyingSpace 𝕜 X) E}
    {e' : OpenPartialHomeomorph (UnderlyingSpace 𝕜 X) E'} (he : IsAlgebraicChart e)
    (he' : IsAlgebraicChart e') :
    ContDiffOn 𝕜 ω (e.symm.trans e') (e.symm.trans e').source := by
  intro k hk
  have hk' := hk
  rw [OpenPartialHomeomorph.trans_source, OpenPartialHomeomorph.symm_source] at hk'
  obtain ⟨V, ι, _, a, L, hV, hL⟩ := he'.exists_eq_evalExt _ hk'.2
  set S := e.target ∩ e.symm ⁻¹' {p : UnderlyingSpace 𝕜 X | ⊤ ≤ p.toHom ⁻¹ᵁ V}
  have hSo : IsOpen S := e.isOpen_inter_preimage_symm (isOpen_setOf_le_preimage V)
  have hmem : (e.symm.trans e').source ∩ S ∈ 𝓝 k :=
    ((e.symm.trans e').open_source.inter hSo).mem_nhds ⟨hk, hk'.1, hV⟩
  have hF : ContDiffOn 𝕜 ω (fun k ↦ L fun i ↦ evalExt V (a i) (e.symm k)) S :=
    L.contDiff.comp_contDiffOn (contDiffOn_pi.2 fun i ↦ he.contDiffOn_evalExt V (a i))
  refine ((hF.contDiffAt (Filter.mem_of_superset hmem Set.inter_subset_right)).congr_of_eventuallyEq
    ?_).contDiffWithinAt
  filter_upwards [hmem] with k' hk''
  have h1 := hk''.1
  rw [OpenPartialHomeomorph.trans_source, OpenPartialHomeomorph.symm_source] at h1
  rw [OpenPartialHomeomorph.coe_trans, Function.comp_apply]
  exact hL _ h1.2 hk''.2.2

end IsAlgebraicChart

variable {V W : Scheme.{u}} [V.Over (Spec (.of 𝕜))] [W.Over (Spec (.of 𝕜))]

/-- The product of charts `e` of `V(𝕜)` and `e'` of `W(𝕜)`, read on `(V × W)(𝕜)` through
`(V × W)(𝕜) ≃ₜ V(𝕜) × W(𝕜)`. -/
def productChart (e : OpenPartialHomeomorph (UnderlyingSpace 𝕜 V) E)
    (e' : OpenPartialHomeomorph (UnderlyingSpace 𝕜 W) E') :
    OpenPartialHomeomorph (UnderlyingSpace 𝕜 (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))))
      (E × E') :=
  (productHomeomorph 𝕜 V W).toOpenPartialHomeomorph.trans (e.prod e')

variable (e : OpenPartialHomeomorph (UnderlyingSpace 𝕜 V) E)
  (e' : OpenPartialHomeomorph (UnderlyingSpace 𝕜 W) E')

/-- The product chart sends `w` to `(e w₁, e' w₂)`, where `(w₁, w₂)` is the image of `w` in
`V(𝕜) × W(𝕜)`. -/
lemma productChart_apply
    (w : UnderlyingSpace 𝕜 (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)))) :
    productChart e e' w = (e (productHomeomorph 𝕜 V W w).1, e' (productHomeomorph 𝕜 V W w).2) :=
  rfl

/-- The inverse of the product chart sends `(k₁, k₂)` to the point of `(V × W)(𝕜)` corresponding
to `(e.symm k₁, e'.symm k₂)`. -/
lemma productChart_symm_apply (k : E × E') :
    (productChart e e').symm k = (productHomeomorph 𝕜 V W).symm (e.symm k.1, e'.symm k.2) :=
  rfl

/-- A point of `(V × W)(𝕜)` lies in the source of the product chart iff its two components lie
in the sources of `e` and `e'`. -/
lemma mem_productChart_source
    {w : UnderlyingSpace 𝕜 (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)))} :
    w ∈ (productChart e e').source ↔
      (productHomeomorph 𝕜 V W w).1 ∈ e.source ∧ (productHomeomorph 𝕜 V W w).2 ∈ e'.source := by
  simp [productChart]

/-- The target of the product chart is the product of the targets of `e` and `e'`. -/
lemma mem_productChart_target {k : E × E'} :
    k ∈ (productChart e e').target ↔ k.1 ∈ e.target ∧ k.2 ∈ e'.target := by
  simp [productChart]

/-- The image in `V(𝕜) × W(𝕜)` of the inverse of the product chart at `(k₁, k₂)` is
`(e.symm k₁, e'.symm k₂)`. -/
lemma productHomeomorph_productChart_symm (k : E × E') :
    productHomeomorph 𝕜 V W ((productChart e e').symm k) = (e.symm k.1, e'.symm k.2) :=
  (productHomeomorph 𝕜 V W).apply_symm_apply _

variable {e e'}

/-- Sections of `V × W` over an affine chart `pr₁⁻¹ U_A ∩ pr₂⁻¹ U_B` are `C^ω` in the product
of algebraic charts. -/
lemma contDiffOn_evalExt_productChart_inf (he : IsAlgebraicChart e) (he' : IsAlgebraicChart e')
    {UA : V.Opens} {UB : W.Opens} (hUA : IsAffineOpen UA) (hUB : IsAffineOpen UB)
    (c : Γ(pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)),
      pullback.fst (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)) ⁻¹ᵁ UA ⊓
        pullback.snd (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)) ⁻¹ᵁ UB)) :
    ContDiffOn 𝕜 ω (fun k ↦ evalExt _ c ((productChart e e').symm k))
      ((productChart e e').target ∩ (productChart e e').symm ⁻¹' {p | ⊤ ≤ p.toHom ⁻¹ᵁ
        (pullback.fst (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)) ⁻¹ᵁ UA ⊓
          pullback.snd (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)) ⁻¹ᵁ UB)}) := by
  set SA := e.target ∩ e.symm ⁻¹' {p | ⊤ ≤ p.toHom ⁻¹ᵁ UA}
  set SB := e'.target ∩ e'.symm ⁻¹' {p | ⊤ ≤ p.toHom ⁻¹ᵁ UB}
  set φ : E × E' → UnderlyingSpace 𝕜 V × UnderlyingSpace 𝕜 W := fun k ↦ (e.symm k.1, e'.symm k.2)
  have hprod : ∀ k, prodMap (pullback.fst _ _) (pullback.snd _ _) ((productChart e e').symm k) =
      φ k :=
    productHomeomorph_productChart_symm e e'
  obtain ⟨F, hF, hF'⟩ := exists_mem_subring_eval_eq
    (IsPullback.of_hasPullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))) (isAffineOpen_top _) hUA hUB
    (fun _ _ ↦ trivial) (fun _ _ ↦ trivial) (contDiffOnCompSubring (𝕜 := 𝕜) φ (SA ×ˢ SB))
    (fun b ↦ (he.contDiffOn_evalExt UA b).comp contDiff_fst.contDiffOn fun _ hz ↦ hz.1)
    (fun b ↦ (he'.contDiffOn_evalExt UB b).comp contDiff_snd.contDiffOn fun _ hz ↦ hz.2) c
  refine (hF.mono fun k hk ↦ ?_).congr fun k hk ↦ ?_
  · have ht := (mem_productChart_target e e').1 hk.1
    have h₂ := (top_le_preimage_inf_iff _ _ UA UB _).1 hk.2
    have h₃ := hprod k
    simp only [prodMap, φ, Prod.mk.injEq] at h₃
    rw [h₃.1, h₃.2] at h₂
    exact ⟨⟨ht.1, h₂.1⟩, ⟨ht.2, h₂.2⟩⟩
  · rw [evalExt_of_le _ hk.2, hF', hprod]
    rfl

/-- Regular functions on `V × W` are `C^ω` in the product of algebraic charts. -/
lemma contDiffOn_evalExt_productChart (he : IsAlgebraicChart e) (he' : IsAlgebraicChart e')
    (V₀ : (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).Opens)
    (a : Γ(pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)), V₀)) :
    ContDiffOn 𝕜 ω (fun k ↦ evalExt V₀ a ((productChart e e').symm k))
      ((productChart e e').target ∩ (productChart e e').symm ⁻¹' {p | ⊤ ≤ p.toHom ⁻¹ᵁ V₀}) := by
  set fst := pullback.fst (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))
  set snd := pullback.snd (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))
  refine contDiffOn_of_locally_contDiffOn fun k ⟨hkt, hkV⟩ ↦ ?_
  set w := (productChart e e').symm k
  obtain ⟨UA, hUA, hxA, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := fst (w.toHom (IsLocalRing.closedPoint 𝕜))) (U := ⊤) trivial
  obtain ⟨UB, hUB, hxB, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := snd (w.toHom (IsLocalRing.closedPoint 𝕜))) (U := ⊤) trivial
  have hUY := isAffineOpen_inf_of_isPullback
    (IsPullback.of_hasPullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))) (isAffineOpen_top _) hUA
    hUB (fun _ _ ↦ trivial) (fun _ _ ↦ trivial)
  have hxV : w.toHom (IsLocalRing.closedPoint 𝕜) ∈ V₀ ⊓ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB) :=
    ⟨(top_le_preimage_iff w V₀).mp hkV, hxA, hxB⟩
  obtain ⟨h, hhV, hxh⟩ := hUY.exists_basicOpen_le ⟨_, hxV⟩ ⟨hxA, hxB⟩
  have := hUY.isLocalization_basicOpen h
  obtain ⟨⟨c, _, m, rfl⟩, hck⟩ := IsLocalization.mk'_surjective (Submonoid.powers h)
    ((pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).presheaf.map
      (homOfLE (hhV.trans inf_le_left)).op a)
  have hck' : IsLocalization.mk' (M := Submonoid.powers h)
      Γ(pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)),
        (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).basicOpen h) c ⟨h ^ m, m, rfl⟩ =
      (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).presheaf.map
        (homOfLE (hhV.trans inf_le_left)).op a := hck
  set N := (productChart e e').target ∩ (productChart e e').symm ⁻¹'
    {p | ⊤ ≤ p.toHom ⁻¹ᵁ (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).basicOpen h}
  have hNY : ∀ k' ∈ N,
      ⊤ ≤ ((productChart e e').symm k').toHom ⁻¹ᵁ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB) := fun k' hk' ↦
    hk'.2.trans (Scheme.Hom.preimage_mono _
      ((pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).basicOpen_le h))
  have hsub : (productChart e e').target ∩ (productChart e e').symm ⁻¹'
      {p | ⊤ ≤ p.toHom ⁻¹ᵁ V₀} ∩ N ⊆ (productChart e e').target ∩ (productChart e e').symm ⁻¹'
        {p | ⊤ ≤ p.toHom ⁻¹ᵁ (fst ⁻¹ᵁ UA ⊓ snd ⁻¹ᵁ UB)} := fun k' hk' ↦ ⟨hk'.2.1, hNY k' hk'.2⟩
  refine ⟨N, (productChart e e').isOpen_inter_preimage_symm (isOpen_setOf_le_preimage _),
    ⟨hkt, (top_le_preimage_iff _ _).2 hxh⟩, ?_⟩
  refine (((contDiffOn_evalExt_productChart_inf he he' hUA hUB c).mono hsub).div
    (((contDiffOn_evalExt_productChart_inf he he' hUA hUB h).mono hsub).pow m)
    fun k' hk' ↦ pow_ne_zero _ ?_).congr fun k' hk' ↦ ?_
  · rw [evalExt_of_le _ (hNY k' hk'.2), ← top_le_preimage_basicOpen_iff]
    exact hk'.2.2
  · have hV : ⊤ ≤ ((productChart e e').symm k').toHom ⁻¹ᵁ V₀ :=
      hk'.2.2.trans (Scheme.Hom.preimage_mono _ (hhV.trans inf_le_left))
    rw [evalExt_of_le _ hV, ← eval_restrict (hhV.trans inf_le_left) _ hk'.2.2, ← hck',
      eval_mk'_of_isAffineOpen hUY, Pi.div_apply, evalExt_of_le c (hNY k' hk'.2),
      evalExt_of_le h (hNY k' hk'.2)]

/-- The coordinates of the product of algebraic charts are locally linear in finitely many
regular functions on `V × W`. -/
lemma exists_eq_evalExt_productChart (he : IsAlgebraicChart e) (he' : IsAlgebraicChart e')
    (p : UnderlyingSpace 𝕜 (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))))
    (hp : p ∈ (productChart e e').source) :
    ∃ (V₀ : (pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))).Opens) (ι : Type) (_ : Fintype ι)
      (a : ι → Γ(pullback (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜)), V₀)) (L : (ι → 𝕜) →L[𝕜] E × E'),
      ⊤ ≤ p.toHom ⁻¹ᵁ V₀ ∧ ∀ q ∈ (productChart e e').source, ⊤ ≤ q.toHom ⁻¹ᵁ V₀ →
        productChart e e' q = L fun i ↦ evalExt V₀ (a i) q := by
  set fst := pullback.fst (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))
  set snd := pullback.snd (V ↘ Spec (.of 𝕜)) (W ↘ Spec (.of 𝕜))
  obtain ⟨hp1, hp2⟩ := (mem_productChart_source e e').1 hp
  obtain ⟨V₁, ι₁, _, a₁, L₁, hV₁, hL₁⟩ := he.exists_eq_evalExt _ hp1
  obtain ⟨W₁, ι₂, _, a₂, L₂, hW₁, hL₂⟩ := he'.exists_eq_evalExt _ hp2
  refine ⟨fst ⁻¹ᵁ V₁ ⊓ snd ⁻¹ᵁ W₁, ι₁ ⊕ ι₂, inferInstance,
    Sum.elim (fun i ↦ fst.appLE V₁ _ inf_le_left (a₁ i))
      (fun i ↦ snd.appLE W₁ _ inf_le_right (a₂ i)),
    (L₁.comp (ContinuousLinearMap.pi fun i ↦ ContinuousLinearMap.proj (Sum.inl i))).prod
      (L₂.comp (ContinuousLinearMap.pi fun i ↦ ContinuousLinearMap.proj (Sum.inr i))),
    (top_le_preimage_inf_iff fst snd V₁ W₁ p).2 ⟨hV₁, hW₁⟩, fun q hq hqV ↦ ?_⟩
  obtain ⟨hq1, hq2⟩ := (mem_productChart_source e e').1 hq
  obtain ⟨hqV₁, hqW₁⟩ := (top_le_preimage_inf_iff fst snd V₁ W₁ q).1 hqV
  rw [productChart_apply, hL₁ _ hq1 hqV₁, hL₂ _ hq2 hqW₁]
  exact Prod.ext (congrArg L₁ (funext fun i ↦ (evalExt_appLE fst _ _ hqV).symm))
    (congrArg L₂ (funext fun i ↦ (evalExt_appLE snd _ _ hqV).symm))

/-- **Products of algebraic charts are algebraic.** For algebraic charts `e` of `V(𝕜)` and `e'`
of `W(𝕜)`, the product chart `(V × W)(𝕜) → E × E'` is an algebraic chart: its coordinates are
the pull-backs of those of `e` and `e'`, and a regular function on `V × W` is near every point a
fraction of polynomial expressions in pull-backs of regular functions on `V` and `W`. -/
theorem isAlgebraicChart_productChart (he : IsAlgebraicChart e) (he' : IsAlgebraicChart e') :
    IsAlgebraicChart (productChart e e') where
  contDiffOn_evalExt := contDiffOn_evalExt_productChart he he'
  exists_eq_evalExt := exists_eq_evalExt_productChart he he'

end Chart

end UnderlyingSpace

end MMP
