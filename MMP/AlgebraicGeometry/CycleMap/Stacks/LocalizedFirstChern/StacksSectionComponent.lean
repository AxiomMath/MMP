module

public import MMP.AlgebraicGeometry.CycleMap.Stacks.LocalizedFirstChern.StacksSectionIdeal
public import MMP.AlgebraicGeometry.Variety.SubvarietyComponentImage
public import StacksFrontier.AlgebraicGeometry.CartierAffineLocalConverse.Basic
public import MMP.AlgebraicGeometry.Dimension.EffectiveCartierPureDimension
import MMP.AlgebraicGeometry.Divisor.EffectiveCartierCoheight
import StacksFrontier.Topology.Dimension.NowhereDense
public import MMP.AlgebraicGeometry.CycleMap.Stacks.LocalizedFirstChern.StacksSectionComponentGeneric

/-!
# The zero scheme of a non-zero section of a Stacks line bundle

Let `ℰ` be a quasi-coherent `𝒪_X`-module, locally free of rank one, on an integral scheme `X`,
and `σ : X ⟶ 𝐕(ℰ)` a section of `π : 𝐕(ℰ) ⟶ X` other than the zero section. On a chart
`c = (V, b)` of `ℰ` the zero scheme `Z(σ)` is cut out by the single local coordinate
`σ^♯b ∈ Γ(X, V)` (`MMP.Modules.ideal_zeroLocus_chart`), which is non-zero when `V` is non-empty:
otherwise `Z(σ)` would contain a dense open, hence be all of the reduced scheme `X`, and `σ`
would factor through the zero section. So `Z(σ)` is an effective Cartier divisor, of pure
dimension `dim X - 1` by Krull's principal ideal theorem, and the trace on a chart of an
irreducible component of `Z(σ)` is an irreducible component of `V(σ^♯b)`.

These are the algebraic inputs of the local computation in Fulton's proof of Lemma 19.1.3.

## Main results

* `MMP.Modules.eq_zeroSection_of_zeroLocus_eq_bot`: a section with `Z(σ) = X` is zero.
* `MMP.Modules.chartLocalCoord_ne_zero`: the local coordinate of `σ ≠ 0` on a non-empty chart
  is non-zero.
* `MMP.Modules.isEffectiveCartierDivisor_zeroLocus`: `Z(σ)` is an effective Cartier divisor.
* `MMP.Modules.dimension_subscheme_zeroLocus_le`: `dim Z(σ) ≤ k` when `dim X = k + 1`.
* `MMP.Modules.hasDim_irreducibleComponent_zeroLocus`: the components of `Z(σ)` have
  dimension `k`.
* `MMP.Modules.maximal_support_image_ofIrreducibleComponent_zeroLocus`: the trace on a chart of a
  component of `Z(σ)` is a maximal irreducible subset of `V(σ^♯b)`.
* `MMP.Modules.exists_maximal_ne_mem_of_mem_irreducibleComponent_zeroLocus`: two components of
  `Z(σ)` have distinct traces.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §1.5, §2.1, §19.1 (proof of Lemma 19.1.3),
  Appendix B.3.2.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

namespace MMP.Modules

open MMP.Intersection.Scheme (dimension Subvariety)

variable {X : Scheme.{0}} {E : X.Modules} [E.IsQuasicoherent]

/-- A section `σ` of `π : 𝐕(ℰ) ⟶ X` maps an open `V` into `π⁻¹(V)`. -/
lemma le_preimage_proj_preimage {σ : X ⟶ totalSpace E} (hσ : σ ≫ proj E = 𝟙 X) (V : X.Opens) :
    V ≤ σ ⁻¹ᵁ (proj E ⁻¹ᵁ V) := fun x hx ↦ by
  change (proj E).base (σ.base x) ∈ V
  rw [← Scheme.Hom.comp_apply, hσ]
  exact hx

/-- The local coordinate `σ^♯b ∈ Γ(X, V)` of a section `σ` of a line bundle in a chart
`c = (V, b)`. -/
def chartLocalCoord (σ : X ⟶ totalSpace E) (hσ : σ ≫ proj E = 𝟙 X) (c : Chart E 1) :
    Γ(X, c.1.1) :=
  sectionCoord σ c (le_preimage_proj_preimage hσ c.1.1) 0

/-- **The zero scheme in a chart**: on a chart `c = (V, b)` the ideal of `Z(σ)` is generated by
the local coordinate `σ^♯b`. -/
theorem ideal_zeroLocus_chart (σ : X ⟶ totalSpace E) (hσ : σ ≫ proj E = 𝟙 X) (c : Chart E 1) :
    (zeroLocus E σ).ideal c.1 = Ideal.span {chartLocalCoord σ hσ c} := by
  rw [ideal_zeroLocus σ c c.1 (le_preimage_proj_preimage hσ c.1.1), Set.range_unique]
  rfl

/-- A point of a chart `c` lies on `Z(σ)` if and only if it lies off `D(σ^♯b)`. -/
lemma mem_support_zeroLocus_iff (σ : X ⟶ totalSpace E) (hσ : σ ≫ proj E = 𝟙 X)
    (c : Chart E 1) {y : X} (hy : y ∈ c.1.1) :
    y ∈ ((zeroLocus E σ).support : Set X) ↔ y ∉ X.basicOpen (chartLocalCoord σ hσ c) := by
  rw [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem (U := c.1) hy,
    ideal_zeroLocus_chart σ hσ c, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton]
  rfl

variable [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E 1]

/-- **The local coordinate of a non-zero section is non-zero** on every non-empty chart of an
integral scheme. -/
theorem chartLocalCoord_ne_zero [IsIntegral X] {σ : X ⟶ totalSpace E} (hσ : σ ≫ proj E = 𝟙 X)
    (h0 : σ ≠ zeroSection E) (c : Chart E 1) [Nonempty c.1.1] :
    chartLocalCoord σ hσ c ≠ 0 := by
  intro hc
  obtain ⟨⟨x, hx⟩⟩ := ‹Nonempty c.1.1›
  have hsub : (c.1.1 : Set X) ⊆ (zeroLocus E σ).support := fun y hy ↦ by
    rw [mem_support_zeroLocus_iff σ hσ c hy, hc, Scheme.basicOpen_zero]
    exact fun h ↦ h
  have htop : (zeroLocus E σ).support = ⊤ := by
    refine Closeds.ext (Set.eq_univ_of_univ_subset ?_)
    rw [← (c.1.1.isOpen.dense ⟨x, hx⟩).closure_eq]
    exact closure_minimal hsub (zeroLocus E σ).support.isClosed
  exact h0 (eq_zeroSection_of_zeroLocus_eq_bot hσ
    (Scheme.IdealSheafData.eq_bot_of_support_eq_top' _ htop))

/-- The local coordinate of a non-zero section is a non-zero rational function. -/
theorem germToFunctionField_chartLocalCoord_ne_zero [IsIntegral X] {σ : X ⟶ totalSpace E}
    (hσ : σ ≫ proj E = 𝟙 X) (h0 : σ ≠ zeroSection E) (c : Chart E 1) [Nonempty c.1.1] :
    X.germToFunctionField c.1.1 (chartLocalCoord σ hσ c) ≠ 0 := fun h ↦
  chartLocalCoord_ne_zero hσ h0 c (germ_injective_of_isIntegral X _ _ (h.trans (map_zero _).symm))

/-- **The zero scheme of a non-zero section of a line bundle is an effective Cartier divisor**
on an integral scheme: it is cut out on each chart by a non-zero element of a domain. -/
theorem isEffectiveCartierDivisor_zeroLocus [IsIntegral X] {σ : X ⟶ totalSpace E}
    (hσ : σ ≫ proj E = 𝟙 X) (h0 : σ ≠ zeroSection E) :
    Stacks.Divisors.IsEffectiveCartierDivisor (zeroLocus E σ) := by
  refine (Stacks.CartierAffineLocalConverse.isEffectiveCartierDivisor_iff_isRegular _).2
    fun x _ ↦ ?_
  obtain ⟨c, hc⟩ := exists_chart_mem (E := E) 1 x
  have : Nonempty c.1.1 := ⟨⟨x, hc⟩⟩
  exact ⟨c.1, hc, chartLocalCoord σ hσ c, IsRegular.of_ne_zero (chartLocalCoord_ne_zero hσ h0 c),
    ideal_zeroLocus_chart σ hσ c⟩

private lemma le_of_lt_natCast_add_one {a : WithBot ℕ∞} {k : ℕ}
    (h : a < ((k + 1 : ℕ) : WithBot ℕ∞)) : a ≤ k := by
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe a =>
    induction a using ENat.recTopCoe with
    | top => exact absurd h (by simp)
    | coe a =>
      exact_mod_cast Nat.lt_succ_iff.mp (by exact_mod_cast h)

/-- **The zero scheme of a non-zero section is a proper closed subscheme**: on an integral
scheme `X` of dimension `k + 1`, `dim Z(σ) ≤ k`. -/
theorem dimension_subscheme_zeroLocus_le [IsIntegral X] {k : ℕ}
    (hn : ((k + 1 : ℕ) : WithBot ℕ∞) = dimension X) {σ : X ⟶ totalSpace E}
    (hσ : σ ≫ proj E = 𝟙 X) (h0 : σ ≠ zeroSection E) :
    dimension (zeroLocus E σ).subscheme ≤ k := by
  set I := zeroLocus E σ
  have hmem : ∀ z, I.subschemeι.base z ∈ (I.support : Set X) := fun z ↦ by
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact Set.mem_range_self z
  have h1 : dimension I.subscheme ≤ topologicalKrullDim (I.support : Set X) :=
    (I.subschemeι.isClosedEmbedding.isInducing.codRestrict hmem).topologicalKrullDim_le
  have hne : (I.support : Set X) ≠ Set.univ := fun h ↦
    h0 (eq_zeroSection_of_zeroLocus_eq_bot hσ
      (Scheme.IdealSheafData.eq_bot_of_support_eq_top' _ (Closeds.ext h)))
  have hfin : topologicalKrullDim (Set.univ : Set X) ≠ ⊤ := by
    rw [topologicalKrullDim_univ]
    change dimension X ≠ ⊤
    rw [← hn]
    exact ne_of_beq_false rfl
  have h2 := topologicalKrullDim_lt_of_subset_of_ne (IrreducibleSpace.isIrreducible_univ X)
    I.support.isClosed (Set.subset_univ _) hne hfin
  rw [topologicalKrullDim_univ] at h2
  exact h1.trans (le_of_lt_natCast_add_one (h2.trans_eq hn.symm))

section Dimension

variable (K : Type) [Field K] [X.Over (Spec (.of K))] [IsIntegral X]
  [LocallyOfFiniteType (X ↘ Spec (.of K))] [QuasiCompact (X ↘ Spec (.of K))]

include K in
/-- **The zero scheme of a non-zero section of a line bundle is pure-dimensional**: on a variety
of dimension `k + 1` it is purely `k`-dimensional. -/
theorem isPureDimensional_subscheme_zeroLocus {k : ℕ}
    (hn : ((k + 1 : ℕ) : WithBot ℕ∞) = dimension X) {σ : X ⟶ totalSpace E}
    (hσ : σ ≫ proj E = 𝟙 X) (h0 : σ ≠ zeroSection E) :
    MMP.IsPureDimensional (zeroLocus E σ).subscheme k :=
  MMP.isPureDimensional_subscheme_of_isEffectiveCartierDivisor K hn
    (isEffectiveCartierDivisor_zeroLocus hσ h0)

include K in
/-- Every irreducible component of the zero scheme of a non-zero section of a line bundle on a
`(k + 1)`-dimensional variety has dimension `k`. -/
theorem hasDim_irreducibleComponent_zeroLocus {k : ℕ}
    (hn : ((k + 1 : ℕ) : WithBot ℕ∞) = dimension X) {σ : X ⟶ totalSpace E}
    (hσ : σ ≫ proj E = 𝟙 X) (h0 : σ ≠ zeroSection E)
    (j : irreducibleComponents (zeroLocus E σ).subscheme) :
    MMP.Intersection.HasDim (j.1 : Set (zeroLocus E σ).subscheme) k :=
  (isPureDimensional_subscheme_zeroLocus K hn hσ h0).hasDim j.2

end Dimension

omit [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E 1] in
/-- **The zero scheme is cut out by the local coordinate in a local ring**: the stalk at
`x ∈ V` of the ideal of `Z(σ)` is generated by the germ of `σ^♯b`. -/
theorem stalk_zeroLocus_eq_span_germ (σ : X ⟶ totalSpace E) (hσ : σ ≫ proj E = 𝟙 X)
    (c : Chart E 1) {x : X} (hx : x ∈ c.1.1) :
    AlgebraicGeometry.IdealSheafData.stalk (zeroLocus E σ) x =
      Ideal.span {(X.presheaf.germ c.1.1 x hx).hom (chartLocalCoord σ hσ c)} := by
  rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ _ x c.1 hx, ideal_zeroLocus_chart σ hσ c,
    Ideal.map_span, Set.image_singleton]

/-- Every component of the zero scheme meets a chart: the generic point of its image lies in
one. -/
theorem exists_chart_genericPoint_mem (σ : X ⟶ totalSpace E)
    (j : irreducibleComponents (zeroLocus E σ).subscheme) :
    ∃ c : Chart E 1,
      ((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).genericPoint ∈
        c.1.1 :=
  exists_chart_mem (E := E) 1 _

omit [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E 1] in
/-- **A component of the zero scheme in a chart.** Let `c = (V, b)` be a chart meeting the image
`Z ⊆ X` of an irreducible component of `Z(σ)`. Then `Z ∩ V` is an irreducible component of
`V(h) = V - D(h)`, `h = σ^♯b`: a maximal irreducible subset. -/
theorem maximal_support_image_ofIrreducibleComponent_zeroLocus (σ : X ⟶ totalSpace E)
    (hσ : σ ≫ proj E = 𝟙 X) (c : Chart E 1) (j : irreducibleComponents (zeroLocus E σ).subscheme)
    (hj : ((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).genericPoint ∈
      c.1.1) :
    Maximal (fun T : Set X ↦ IsIrreducible T ∧
        T ⊆ (c.1.1 : Set X) \ X.basicOpen (chartLocalCoord σ hσ c))
      ((((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).support :
        Set X) ∩ c.1.1) := by
  obtain ⟨ξ, hξ⟩ : ∃ ξ, (Subvariety.ofIrreducibleComponent j).genericPoint = ξ := ⟨_, rfl⟩
  have hZ : ((((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).support :
      Set X)) = closure {(zeroLocus E σ).subschemeι ξ} := by
    rw [Subvariety.support_image_eq_closure_genericPoint, hξ]
  rw [Subvariety.genericPoint_image, hξ] at hj
  have hξsupp : (zeroLocus E σ).subschemeι ξ ∈ ((zeroLocus E σ).support : Set X) := by
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨ξ, rfl⟩
  have hclsupp : closure {(zeroLocus E σ).subschemeι ξ} ⊆ ((zeroLocus E σ).support : Set X) :=
    closure_minimal (Set.singleton_subset_iff.2 hξsupp) (zeroLocus E σ).support.isClosed
  have hξcl : closure {ξ} = j.1 := by
    rw [← hξ]
    exact Subvariety.closure_genericPoint_ofIrreducibleComponent _
  rw [hZ]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rw [← isIrreducible_iff_closure]
    have : closure (closure {(zeroLocus E σ).subschemeι ξ} ∩ (c.1.1 : Set X)) =
        closure {(zeroLocus E σ).subschemeι ξ} :=
      ((closure_mono Set.inter_subset_left).trans closure_closure.le).antisymm
        (closure_mono (Set.singleton_subset_iff.2 ⟨subset_closure rfl, hj⟩))
    rw [this]
    exact isIrreducible_singleton.closure
  · rintro y ⟨hy, hyV⟩
    exact ⟨hyV, (mem_support_zeroLocus_iff σ hσ c hyV).1 (hclsupp hy)⟩
  · rintro T ⟨hT, hTsub⟩ hST
    obtain ⟨t, ht⟩ := QuasiSober.sober hT.closure isClosed_closure
    have hTsupp : closure T ⊆ ((zeroLocus E σ).support : Set X) :=
      closure_minimal (fun y hy ↦ (mem_support_zeroLocus_iff σ hσ c (hTsub hy).1).2 (hTsub hy).2)
        (zeroLocus E σ).support.isClosed
    obtain ⟨ξ', rfl⟩ : t ∈ Set.range (zeroLocus E σ).subschemeι := by
      rw [Scheme.IdealSheafData.range_subschemeι]
      exact hTsupp ht.mem
    have hsp : (zeroLocus E σ).subschemeι ξ' ⤳ (zeroLocus E σ).subschemeι ξ := by
      rw [specializes_iff_mem_closure, ht.def]
      exact subset_closure (hST ⟨subset_closure rfl, hj⟩)
    obtain rfl : ξ' = ξ := MMP.eq_of_specializes_of_mem_irreducibleComponents j.2 hξcl
      ((zeroLocus E σ).subschemeι.isClosedEmbedding.isInducing.specializes_iff.1 hsp)
    intro y hy
    exact ⟨ht.def ▸ subset_closure hy, (hTsub hy).1⟩

omit [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E 1] in
/-- **Two components of the zero scheme have distinct traces on a chart.** If a point `ι y` of a
chart `c = (V, b)` lies on the image of a component `j'` of `Z(σ)`, it lies on a maximal
irreducible subset of `V - D(σ^♯b)` other than the trace of a different component `j`. -/
theorem exists_maximal_ne_mem_of_mem_irreducibleComponent_zeroLocus (σ : X ⟶ totalSpace E)
    (hσ : σ ≫ proj E = 𝟙 X) (c : Chart E 1)
    {j j' : irreducibleComponents (zeroLocus E σ).subscheme} (hjj : j' ≠ j)
    {y : (zeroLocus E σ).subscheme} (hy : y ∈ j'.1) (hyV : (zeroLocus E σ).subschemeι y ∈ c.1.1) :
    ∃ T : Set X, Maximal (fun T : Set X ↦ IsIrreducible T ∧
        T ⊆ (c.1.1 : Set X) \ X.basicOpen (chartLocalCoord σ hσ c)) T ∧
      T ≠ (((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).support :
        Set X) ∩ c.1.1 ∧
      (zeroLocus E σ).subschemeι y ∈ T := by
  obtain ⟨ξ, hξ⟩ : ∃ ξ, (Subvariety.ofIrreducibleComponent j').genericPoint = ξ := ⟨_, rfl⟩
  obtain ⟨η, hη⟩ : ∃ η, (Subvariety.ofIrreducibleComponent j).genericPoint = η := ⟨_, rfl⟩
  have hξcl : closure {ξ} = j'.1 := by
    rw [← hξ]
    exact Subvariety.closure_genericPoint_ofIrreducibleComponent _
  have hηcl : closure {η} = j.1 := by
    rw [← hη]
    exact Subvariety.closure_genericPoint_ofIrreducibleComponent _
  have hZ' : ((((Subvariety.ofIrreducibleComponent j').image (zeroLocus E σ).subschemeι).support :
      Set X)) =
      closure {(zeroLocus E σ).subschemeι ξ} := by
    rw [Subvariety.support_image_eq_closure_genericPoint, hξ]
  have hZ : ((((Subvariety.ofIrreducibleComponent j).image (zeroLocus E σ).subschemeι).support :
      Set X)) =
      closure {(zeroLocus E σ).subschemeι η} := by
    rw [Subvariety.support_image_eq_closure_genericPoint, hη]
  have hξy : ξ ⤳ y := by
    rw [specializes_iff_mem_closure, hξcl]
    exact hy
  have hιξy : (zeroLocus E σ).subschemeι ξ ⤳ (zeroLocus E σ).subschemeι y :=
    hξy.map (zeroLocus E σ).subschemeι.continuous
  have hξV : (zeroLocus E σ).subschemeι ξ ∈ c.1.1 := hιξy.mem_open c.1.1.isOpen hyV
  have hgen' : ((Subvariety.ofIrreducibleComponent j').image
      (zeroLocus E σ).subschemeι).genericPoint ∈ c.1.1 := by
    rw [Subvariety.genericPoint_image, hξ]
    exact hξV
  refine ⟨_, maximal_support_image_ofIrreducibleComponent_zeroLocus σ hσ c j' hgen', ?_, ?_⟩
  · intro heq
    rw [hZ', hZ] at heq
    have hmem : (zeroLocus E σ).subschemeι ξ ∈
        closure {(zeroLocus E σ).subschemeι η} ∩ (c.1.1 : Set X) :=
      heq ▸ ⟨subset_closure rfl, hξV⟩
    have hηξ : η = ξ := MMP.eq_of_specializes_of_mem_irreducibleComponents j'.2 hξcl
      ((zeroLocus E σ).subschemeι.isClosedEmbedding.isInducing.specializes_iff.1
        (specializes_iff_mem_closure.2 hmem.1))
    exact hjj (Subtype.ext (hξcl.symm.trans (hηξ ▸ hηcl)))
  · rw [hZ']
    exact ⟨specializes_iff_mem_closure.1 hιξy, hyV⟩

end MMP.Modules
