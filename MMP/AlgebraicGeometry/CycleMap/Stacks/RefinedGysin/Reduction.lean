module

public import MMP.AlgebraicGeometry.CycleMap.Stacks.RefinedGysin.SpecializationStatement

/-!
# Reduction of the specialization step of Fulton's Theorem 19.2 to `α = [V]`

Both sides of the specialization step `MMP.Chow.SpecializationFormula`,
`u_{E'} ∩ cl((ι_* ∘ j^* ∘ C) ∩ α) = g^* u ∩ cl_{Y'}(α)`, are additive in `α ∈ A_{m+d}(Y')`, and
`A_{m+d}(Y')` is generated by the prime cycles `[x] = [closure {x}]` of the points `x` of
delta-dimension `m + d`. So the step holds for every `α` as soon as it holds for every prime cycle
(`MMP.Chow.specializationFormula_of_pointCycle`): this is step (a) of Fulton's proof of
Theorem 19.2, "it suffices to prove the theorem for `α = [V]`".

## Main definitions

* `MMP.Chow.specializedConeClassHom`: the specialization `α ↦ (ι_* ∘ j^* ∘ C) ∩ α` as an additive
  map `A_k(Y') →+ A_k(𝐕(E'))`.

## Main results

* `MMP.Chow.specializationFormula_of_pointCycle`: the specialization step holds at every
  `α ∈ A_{m+d}(Y')` once it holds at every prime cycle of delta-dimension `m + d`.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.2, proof of Theorem 19.2.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Set Stacks.Chow MMP.UnderlyingSpace
open Stacks.AlgebraicGeometry.RegularIdealSheaf Stacks.AlgebraicGeometry.ReflexiveModules
open MMP.Modules

namespace MMP.Chow

attribute [local instance] fibreProductOver isOver_fibreProduct_fst isOver_fibreProduct_snd
  isComplexScheme_fibreProduct isLocallyNoetherian_of_isComplexScheme
  isFiniteLocallyFreeOfRank_normalBundleOfRegular isQuasicoherent_fibreNormalModule
  isFiniteLocallyFreeOfRank_fibreNormalModule isComplexScheme_totalSpace_fibreNormalModule

variable {X Y Y' : Scheme.{0}} [X.Over (Spec (.of ℂ))] [Y.Over (Spec (.of ℂ))]
  [Y'.Over (Spec (.of ℂ))] (f : X ⟶ Y) [f.IsOver (Spec (.of ℂ))] (g : Y' ⟶ Y)
  [g.IsOver (Spec (.of ℂ))] [IsComplexScheme X] [IsComplexScheme Y] [IsComplexScheme Y']
  [IsClosedImmersion f] [LocallyOfFiniteType g] {d : ℕ} (R : Type) [CommRing R]

/-- The specialization `α ↦ (ι_* ∘ j^* ∘ C) ∩ α` of `MMP.Chow.specializedConeClass`, as an
additive map `A_k(Y') →+ A_k(𝐕(E'))`. -/
def specializedConeClassHom (hf : IsRegularClosedImmersionOfCodim f d) (k : ℕ) :
    chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) k →+
      chowGroup (fieldChowSituation ℂ) (totalSpace (fibreNormalModule f g hf) ↘ Spec (.of ℂ)) k :=
  AddMonoidHom.mk' (specializedConeClass f g hf k) fun a b ↦ by
    simp only [specializedConeClass, map_add]
    exact map_add _ _ _

/-- `MMP.Chow.specializedConeClassHom` evaluated at `α` is `MMP.Chow.specializedConeClass` of
`α`. -/
@[simp]
theorem specializedConeClassHom_apply (hf : IsRegularClosedImmersionOfCodim f d) (k : ℕ)
    (α : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) k) :
    specializedConeClassHom f g hf k α = specializedConeClass f g hf k α :=
  rfl

/-- **Reduction to `α = [V]`.** If the specialization step of Fulton's proof of Theorem 19.2
holds at the prime cycle `[x] = [closure {x}]` of every point `x` of `Y'` of delta-dimension
`m + d`, it holds at every `α ∈ A_{m+d}(Y')`. -/
theorem specializationFormula_of_pointCycle (hf : IsRegularClosedImmersionOfCodim f d)
    (u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (UnderlyingSpace ℂ Y))
      (range (UnderlyingSpace.map (K := ℂ) f)) (2 * d : ℕ)) (m : ℕ)
    (h : ∀ (x : Y') (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction
        (Y' ↘ Spec (.of ℂ)) x = ((m + d : ℕ) : ℤ)),
      SpecializationFormula f g R hf u m
        (QuotientAddGroup.mk (pointCycle (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ))
          ((m + d : ℕ) : ℤ) x hx)))
    (α : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) (m + d : ℕ)) :
    SpecializationFormula f g R hf u m α := by
  intro hu
  induction α using QuotientAddGroup.induction_on with
  | H β =>
    simp only [SpecializationFormula, ← specializedConeClassHom_apply] at h ⊢
    rw [← QuotientAddGroup.mk'_apply, eq_sum_pointCycleOrZero β]
    simp only [map_sum, map_zsmul]
    refine Finset.sum_congr rfl fun x hx ↦ ?_
    congr 1
    have hxm : relativeDimension (fieldChowSituation ℂ).dimensionFunction (Y' ↘ Spec (.of ℂ)) x =
        ((m + d : ℕ) : ℤ) :=
      (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation ℂ) _ _ β.1).mp β.2 x
        ((finite_support_cycle β).mem_toFinset.mp hx)
    rw [pointCycleOrZero, dif_pos hxm]
    exact h x hxm hu

end MMP.Chow
