/-!
# Fulton's Theorem 19.2 on Stacks' Chow groups: reduction to `α = [V]`

Let `f : X ⟶ Y` be a regular closed immersion of codimension `d` of complex schemes, with a class
`u ∈ H^{2d}(Y, Y - X)`, and `g : Y' ⟶ Y`. This file proves that Fulton's formula
`cl_{X'}(f^! α) = g^* u ∩ cl_{Y'}(α)` (`MMP.Chow.ChowCycleMapRefinedGysinFormulaAt`) reduces to the
fundamental classes of integral closed subschemes, step (a) of Fulton's proof of Theorem 19.2:

* for a proper `ι : V ⟶ Y'` and `β ∈ A_{m+d}(V)`, the formula for `(ι ≫ g, β)` implies it for
  `(g, ι_* β)` (`MMP.Chow.chowCycleMapRefinedGysinFormulaAt_properChowPushforward`): bivariant
  classes commute with proper push-forward (Stacks 0B76 (1)), the cycle class commutes with
  proper push-forward, and the topological projection formula `ι'_*(ι^* c ∩ a) = c ∩ ι_* a`;
* both sides are additive in `α`, and `A_{m+d}(Y')` is generated by the prime cycles
  `[x] = ι_*[closure {x}]`, so the formula for every fundamental class `[V]`, `V` integral closed
  of dimension `m + d`, tested against `V ⟶ Y' ⟶ Y`, gives it for every `α`
  (`MMP.Chow.chowCycleMapRefinedGysinFormulaAt_of_forall_fundamentalChowClass`).

## Main results

* `MMP.borelMooreHomology.pushforward_preimageMap_capProductSupportPullback`
* `MMP.Chow.chowCycleMapRefinedGysinFormulaAt_properChowPushforward`
* `MMP.Chow.chowCycleMapRefinedGysinFormulaAt_of_forall_fundamentalChowClass`

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.2, proof of Theorem 19.2.
* [Stacks Project, Tag 0B76](https://stacks.math.columbia.edu/tag/0B76)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Set Stacks.Chow MMP.UnderlyingSpace
open Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace MMP.borelMooreHomology

universe u

variable (R : Type u) [CommRing R]

/-- For `F = i ≫ g`, the map `F⁻¹ X → g⁻¹ X` induced by `i`. -/
def preimageMap {V Y' Y : TopCat.{u}} (i : V ⟶ Y') (g : Y' ⟶ Y) {F : V ⟶ Y} (hF : F = i ≫ g)
    (X : Set Y) : TopCat.of (F ⁻¹' X) ⟶ TopCat.of (g ⁻¹' X) :=
  TopCat.ofHom ⟨fun p ↦ ⟨i p.1, by subst hF; exact p.2⟩,
    (i.hom.continuous.comp continuous_subtype_val).subtype_mk _⟩

/-- The map `F⁻¹ X → g⁻¹ X` induced by a proper `i` is proper. -/
theorem isProperMap_preimageMap {V Y' Y : TopCat.{u}} (i : V ⟶ Y') (g : Y' ⟶ Y)
    (hi : IsProperMap i) {F : V ⟶ Y} (hF : F = i ≫ g) (X : Set Y) :
    IsProperMap (preimageMap i g hF X) := by
  subst hF
  exact hi.restrictPreimage (g ⁻¹' X)

/-- **The projection formula along a composite.** For `i : V → Y'` proper, `g : Y' → Y`,
`F = i ≫ g`, `c ∈ H^j(Y, Y - X)` and `a ∈ H_k V`: `i'_*(F^* c ∩ a) = g^* c ∩ i_* a` in
`H_{k-j}(g⁻¹ X)`, where `i' : F⁻¹ X → g⁻¹ X` is induced by `i`. -/
theorem pushforward_preimageMap_capProductSupportPullback {V Y' Y : TopCat.{u}} (i : V ⟶ Y')
    (g : Y' ⟶ Y) (hi : IsProperMap i) {F : V ⟶ Y} (hF : F = i ≫ g) {X : Set Y}
    (hX : IsClosed X) (hgd : HasProperNeighbourhoodDeformations (g ⁻¹' X))
    (hFd : HasProperNeighbourhoodDeformations (F ⁻¹' X)) (j k : ℤ)
    (c : cohomologyWithSupports R (ModuleCat.of R R) Y X j)
    (a : borelMooreHomology R (ModuleCat.of R R) V k) :
    (pushforward R (ModuleCat.of R R) (preimageMap i g hF X) (isProperMap_preimageMap i g hi hF X)
        (k - j)).hom (capProductSupportPullback R F hX hFd j k c a) =
      capProductSupportPullback R g hX hgd j k c
        ((pushforward R (ModuleCat.of R R) i hi k).hom a) := by
  subst hF
  rw [capProductSupportPullback_apply, cohomologyWithSupports.pullback_comp, ModuleCat.comp_apply]
  exact pushforward_restrictPreimage_capProductSupportPullback R i hi (hX.preimage g.hom.continuous)
    hgd hFd j k _ a

end MMP.borelMooreHomology

namespace MMP.Chow

attribute [local instance] fibreProductOver isOver_fibreProduct_fst isOver_fibreProduct_snd
  isComplexScheme_fibreProduct

/-- `Stacks.Chow.chowGroupCongr` commutes with proper push-forward. -/
theorem chowGroupCongr_properChowPushforward (C : ChowSituation.{0}) {A B : Scheme.{0}}
    {sA sA' : A ⟶ C.S} {sB sB' : B ⟶ C.S} [LocallyOfFiniteType sA] [LocallyOfFiniteType sA']
    [LocallyOfFiniteType sB] [LocallyOfFiniteType sB'] (p : A ⟶ B) [IsProper p] (hA : sA = sA')
    (hB : sB = sB') (hp : p ≫ sB = sA) (hp' : p ≫ sB' = sA') (k : ℤ)
    (hfac : ProperPushforwardFactorsThroughRationalEquivalence C sA sB p hp k)
    (hfac' : ProperPushforwardFactorsThroughRationalEquivalence C sA' sB' p hp' k)
    (x : chowGroup C sA k) :
    chowGroupCongr C hB k (properChowPushforward C sA sB p hp k hfac x) =
      properChowPushforward C sA' sB' p hp' k hfac' (chowGroupCongr C hA k x) := by
  subst hA hB
  rfl

/-- `Stacks.Chow.chowGroupCongrDegree` commutes with proper push-forward. -/
theorem chowGroupCongrDegree_properChowPushforward (C : ChowSituation.{0}) {A B : Scheme.{0}}
    (sA : A ⟶ C.S) (sB : B ⟶ C.S) [LocallyOfFiniteType sA] [LocallyOfFiniteType sB] (p : A ⟶ B)
    [IsProper p] (hp : p ≫ sB = sA) {j k : ℤ} (h : j = k)
    (hfac : ProperPushforwardFactorsThroughRationalEquivalence C sA sB p hp j)
    (hfac' : ProperPushforwardFactorsThroughRationalEquivalence C sA sB p hp k)
    (x : chowGroup C sA j) :
    chowGroupCongrDegree C sB h (properChowPushforward C sA sB p hp j hfac x) =
      properChowPushforward C sA sB p hp k hfac' (chowGroupCongrDegree C sA h x) := by
  subst h
  rfl

variable {X Y Y' : Scheme.{0}} [X.Over (Spec (.of ℂ))] [Y.Over (Spec (.of ℂ))]
  [Y'.Over (Spec (.of ℂ))] (f : X ⟶ Y) [f.IsOver (Spec (.of ℂ))] (g : Y' ⟶ Y)
  [g.IsOver (Spec (.of ℂ))]
  (R : Type) [CommRing R] [IsComplexScheme X] [IsComplexScheme Y] [IsComplexScheme Y']
  [IsClosedImmersion f] [LocallyOfFiniteType g] {d : ℕ}

omit [Y.Over (Spec (.of ℂ))] [Y'.Over (Spec (.of ℂ))] [f.IsOver (Spec (.of ℂ))]
  [g.IsOver (Spec (.of ℂ))] [IsComplexScheme X] [IsComplexScheme Y] [IsComplexScheme Y']
  [IsClosedImmersion f] [LocallyOfFiniteType g] in
/-- The base-change map `X ×_Y V ⟶ X ×_Y Y'` lies over `ℂ`. -/
theorem isOver_bivariantBaseChangeMap {V : Scheme.{0}} (ι : V ⟶ Y') :
    (bivariantBaseChangeMap f g ι).IsOver (Spec (.of ℂ)) :=
  ⟨by
    change bivariantBaseChangeMap f g ι ≫ pullback.fst f g ≫ X ↘ Spec (.of ℂ) =
      pullback.fst f (ι ≫ g) ≫ X ↘ Spec (.of ℂ)
    rw [← Category.assoc, bivariantBaseChangeMap_fst]⟩

omit [IsClosedImmersion f] in
/-- `ι ≫ g` is locally of finite type for a proper `ι`. -/
instance locallyOfFiniteType_comp_of_isProper {V : Scheme.{0}} (ι : V ⟶ Y') [IsProper ι] :
    LocallyOfFiniteType (ι ≫ g) :=
  haveI : LocallyOfFiniteType ι := IsProper.toLocallyOfFiniteType
  locallyOfFiniteType_comp ι g

/-- **Theorem 19.2 is compatible with proper push-forward of the class.** For a proper
`ι : V ⟶ Y'` and `β ∈ A_{m+d}(V)`, Fulton's formula for `(ι ≫ g, β)` implies it for
`(g, ι_* β)`. -/
theorem chowCycleMapRefinedGysinFormulaAt_properChowPushforward
    {V : Scheme.{0}} [V.Over (Spec (.of ℂ))] [IsComplexScheme V] (ι : V ⟶ Y')
    [ι.IsOver (Spec (.of ℂ))] [IsProper ι]
    (hf : IsRegularClosedImmersionOfCodim f d)
    (u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (UnderlyingSpace ℂ Y))
      (range (UnderlyingSpace.map (K := ℂ) f)) (2 * d : ℕ)) (m : ℕ)
    (β : chowGroup (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (m + d : ℕ))
    (h : ChowCycleMapRefinedGysinFormulaAt f (ι ≫ g) R hf u m β) :
    ChowCycleMapRefinedGysinFormulaAt f g R hf u m
      (properChowPushforward (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (Y' ↘ Spec (.of ℂ)) ι
        (comp_over ι _) (m + d : ℕ)
        (properPushforwardFactorsThroughRationalEquivalence_of_isProper _ _ _ ι
          (comp_over ι _) _) β) := by
  have := isOver_bivariantBaseChangeMap f g ι
  have : IsProper (bivariantBaseChangeMap f g ι) :=
    MorphismProperty.of_isPullback (isPullback_bivariantBaseChangeMap f g ι) (P := @IsProper)
      inferInstance
  unfold ChowCycleMapRefinedGysinFormulaAt at h ⊢
  rw [chowGroupCongr_properChowPushforward (fieldChowSituation ℂ) ι
      (comp_over (ι ≫ g) _).symm (comp_over g _).symm (comp_over ι _) (Category.assoc _ _ _).symm
      _ _
      (properPushforwardFactorsThroughRationalEquivalence_of_isProper _ _ _ ι _ _),
    (regularNormalGysinClass (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) (Y ↘ Spec (.of ℂ)) f
      (comp_over f _) hf).cap_properPushforward g ι (bivariantBaseChangeMap f g ι)
      (isPullback_bivariantBaseChangeMap f g ι) (bivariantBaseChangeMap_fst f g ι),
    chowGroupCongrDegree_properChowPushforward _ _ _ _ _ _ _
      (properPushforwardFactorsThroughRationalEquivalence_of_isProper _ _ _ _ _ _)]
  erw [chowCycleClass_properChowPushforward R (bivariantBaseChangeMap f g ι)]
  rw [chowCycleClass_properChowPushforward_of_isProper R ι]
  have hF : TopCat.ofHom (UnderlyingSpace.map (K := ℂ) (ι ≫ g)) =
      TopCat.ofHom (UnderlyingSpace.map (K := ℂ) ι) ≫
        TopCat.ofHom (UnderlyingSpace.map (K := ℂ) g) := by
    rw [UnderlyingSpace.map_comp]
    rfl
  rw [← borelMooreHomology.pushforward_preimageMap_capProductSupportPullback R _ _
      (isProperMap_map (K := ℂ) ι) hF _ _ (hasProperNeighbourhoodDeformations_preimage_range_map f
        (ι ≫ g)),
    ← borelMooreHomology.pushforward_congrDegree, ← h]
  have hH := (isProperMap_fibreSquarePointsHom (IsPullback.of_hasPullback f g).flip).comp
    (isProperMap_map (K := ℂ) (bivariantBaseChangeMap f g ι))
  refine (borelMooreHomology.pushforward_pushforward_apply_of_comp_eq R _ _
    (TopCat.ofHom (UnderlyingSpace.map (K := ℂ) (bivariantBaseChangeMap f g ι)) ≫
      fibreSquarePointsHom (IsPullback.of_hasPullback f g).flip) _ _ hH rfl _ _).trans
    (borelMooreHomology.pushforward_pushforward_apply_of_comp_eq R _ _ _ _ _ hH ?_ _ _).symm
  refine ConcreteCategory.hom_ext _ _ fun p ↦ ?_
  apply Subtype.ext
  apply UnderlyingSpace.ext
  change (p.toHom ≫ pullback.snd f (ι ≫ g)) ≫ ι = (p.toHom ≫ bivariantBaseChangeMap f g ι) ≫
    pullback.snd f g
  rw [Category.assoc, Category.assoc, (isPullback_bivariantBaseChangeMap f g ι).w]

section Additivity

variable (hf : IsRegularClosedImmersionOfCodim f d)
  (u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (UnderlyingSpace ℂ Y))
    (range (UnderlyingSpace.map (K := ℂ) f)) (2 * d : ℕ)) (m : ℕ)

/-- Fulton's formula holds for `α = 0`. -/
theorem chowCycleMapRefinedGysinFormulaAt_zero :
    ChowCycleMapRefinedGysinFormulaAt f g R hf u m 0 := by
  unfold ChowCycleMapRefinedGysinFormulaAt
  simp only [map_zero]
  erw [map_zero (chowCycleClass (X := pullback f g) R m)]
  simp only [map_zero]

/-- If Fulton's formula holds for `α` and `β`, it holds for `α + β`. -/
theorem chowCycleMapRefinedGysinFormulaAt_add
    {α β : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) (m + d : ℕ)}
    (hα : ChowCycleMapRefinedGysinFormulaAt f g R hf u m α)
    (hβ : ChowCycleMapRefinedGysinFormulaAt f g R hf u m β) :
    ChowCycleMapRefinedGysinFormulaAt f g R hf u m (α + β) := by
  unfold ChowCycleMapRefinedGysinFormulaAt at *
  simp only [map_add]
  erw [map_add (chowCycleClass (X := pullback f g) R m)]
  simp only [map_add]
  rw [hα, hβ]

/-- If Fulton's formula holds for `α`, it holds for `n • α` for every `n : ℤ`. -/
theorem chowCycleMapRefinedGysinFormulaAt_zsmul (n : ℤ)
    {α : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) (m + d : ℕ)}
    (hα : ChowCycleMapRefinedGysinFormulaAt f g R hf u m α) :
    ChowCycleMapRefinedGysinFormulaAt f g R hf u m (n • α) := by
  unfold ChowCycleMapRefinedGysinFormulaAt at *
  simp only [map_zsmul]
  erw [map_zsmul (chowCycleClass (X := pullback f g) R m)]
  simp only [map_zsmul]
  rw [hα]

end Additivity

/-- **Reduction of Theorem 19.2 to fundamental classes.** If Fulton's formula holds for the
fundamental class `[V] ∈ A_{m+d}(V)` of the integral closed subscheme `V = closure {x}` of every
point `x` of `Y'` of delta-dimension `m + d`, tested against `V ⟶ Y' ⟶ Y`, it holds for every
`α ∈ A_{m+d}(Y')`. -/
theorem chowCycleMapRefinedGysinFormulaAt_of_forall_fundamentalChowClass
    (hf : IsRegularClosedImmersionOfCodim f d)
    (u : cohomologyWithSupports R (ModuleCat.of R R) (TopCat.of (UnderlyingSpace ℂ Y))
      (range (UnderlyingSpace.map (K := ℂ) f)) (2 * d : ℕ)) (m : ℕ)
    (h : ∀ (x : Y') (_ : relativeDimension (fieldChowSituation ℂ).dimensionFunction
        (Y' ↘ Spec (.of ℂ)) x = ((m + d : ℕ) : ℤ)),
      ChowCycleMapRefinedGysinFormulaAt f ((integralComponentAt x).subschemeι ≫ g) R hf u m
        (fundamentalChowClass (fieldChowSituation ℂ)
          ((integralComponentAt x).subscheme ↘ Spec (.of ℂ)) (m + d : ℕ)))
    (α : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) (m + d : ℕ)) :
    ChowCycleMapRefinedGysinFormulaAt f g R hf u m α := by
  induction α using QuotientAddGroup.induction_on with
  | H β =>
    have hβ : (β : chowGroup (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ)) (m + d : ℕ)) =
        QuotientAddGroup.mk' (rationalEquivalences (fieldChowSituation ℂ) (Y' ↘ Spec (.of ℂ))
          ((m + d : ℕ) : ℤ)) β := rfl
    rw [hβ, eq_sum_pointCycleOrZero β, map_sum]
    refine Finset.sum_induction _ (ChowCycleMapRefinedGysinFormulaAt f g R hf u m)
      (fun _ _ ↦ chowCycleMapRefinedGysinFormulaAt_add f g R hf u m)
      (chowCycleMapRefinedGysinFormulaAt_zero f g R hf u m) fun x hx ↦ ?_
    rw [map_zsmul]
    refine chowCycleMapRefinedGysinFormulaAt_zsmul f g R hf u m _ ?_
    have hxm : relativeDimension (fieldChowSituation ℂ).dimensionFunction (Y' ↘ Spec (.of ℂ)) x =
        ((m + d : ℕ) : ℤ) :=
      (mem_cyclesOfDimension_iff_forall_point (fieldChowSituation ℂ) _ _ β.1).mp β.2 x
        ((finite_support_cycle β).mem_toFinset.mp hx)
    rw [pointCycleOrZero, dite_eq_left_of_eq_true (eq_true hxm),
      pointCycle_eq_properPushforward x hxm]
    have hV := chowCycleMapRefinedGysinFormulaAt_properChowPushforward f g R
      (integralComponentAt x).subschemeι hf u m _ (h x hxm)
    rw [fundamentalChowClass, fundamentalCycle, properChowPushforward_mk] at hV
    exact hV

end MMP.Chow
