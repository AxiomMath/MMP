module

public import MMP.AlgebraicGeometry.CycleMap.Stacks.OrientationClass.ZeroSectionCycle.StacksChart

/-!
# The bundle chart of `E|_V` is an immersion (Stacks vector bundles)

Let `ℰ` be a quasi-coherent `𝒪_X`-module, finite locally free of rank `r`, on a complex scheme
`X`, with vector bundle `π : 𝐕(ℰ) ⟶ X`, `V` a subvariety of `X` and `E|_V = π⁻¹(V)`, with
inclusion `ι : E|_V → 𝐕(ℰ)` and projection `π_V : E|_V → V`. Over the domain `π⁻¹(U)` of a chart
`c' = (U, b)` of `ℰ`, the bundle chart `p ↦ (π_V p, x^{c'}(ι p))` of `E|_V` read in algebraic
charts `c` of `E|_V(ℂ)` and `e` of `V(ℂ)` has injective derivative.

Indeed the differentials at `p` of the regular functions on the affine open `W = ι⁻¹(π⁻¹(U))` of
`E|_V` span the dual of the model space of `c`. The chart isomorphism `π⁻¹(U) ≅ 𝔸ʳ_U` shows that
the regular functions on `π⁻¹(U)` form the ring generated by the pull-backs of the functions on
`U` and the chart coordinates `bᵢ`, and those on `W` are their restrictions (`ι` is a closed
immersion). The differential of each generator factors through the derivative of the bundle
chart, hence so does the differential of every function on `W`, by the Leibniz rule.

## Main results

* `MMP.Modules.mem_closure_range_app_union_range_chartCoordSection`: the functions on `π⁻¹(U)`
  are generated by the pull-backs of the functions on `U` and the chart coordinates.
* `MMP.Modules.injective_fderiv_bundleChart`: the bundle chart of `E|_V` has injective
  derivative in algebraic charts.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.2, Lemma 19.2(d).
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Set Topology
open scoped ContDiff
open MMP.UnderlyingSpace

namespace MMP

/-- The restriction `f ∣_ U` of a morphism, on global sections: `Γ(U, ⊤) ≅ Γ(Y, U)` followed by
`f^*` is `f^*` followed by `Γ(f⁻¹U, ⊤) ≅ Γ(X, f⁻¹U)`. -/
lemma topIso_hom_morphismRestrict_appTop {X Y : Scheme.{0}} (f : X ⟶ Y)
    (U : Y.Opens) (a : Γ(U.toScheme, ⊤)) :
    (f ⁻¹ᵁ U).topIso.hom ((f ∣_ U).appTop a) = f.app U (U.topIso.hom a) := by
  have h : (f ∣_ U).appTop ≫ (f ⁻¹ᵁ U).topIso.hom = U.topIso.hom ≫ f.app U := by
    simp only [morphismRestrict_appLE, Scheme.Opens.topIso_hom,
      Scheme.Hom.app_eq_appLE]
    erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  rw [← CommRingCat.comp_apply, h, CommRingCat.comp_apply]

namespace UnderlyingSpace

variable {Y : Scheme.{0}} [Y.Over (Spec (.of ℂ))]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]
  {c : OpenPartialHomeomorph (UnderlyingSpace ℂ Y) F} {p : UnderlyingSpace ℂ Y}

/-- If, near `c(p)`, a regular function read in the chart `c` is `h ∘ Φ` for a map `h`
differentiable at `Φ(c p)`, its differential at `p` vanishes on the kernel of `Φ'(c p)`. -/
lemma chartDeriv_apply_eq_zero_of_eventuallyEq {H : Type*} [NormedAddCommGroup H]
    [NormedSpace ℂ H] {Φ : F → H} {W : Y.Opens} {b : Γ(Y, W)} {h : H → ℂ}
    (hh : DifferentiableAt ℂ h (Φ (c p))) (hΦ : DifferentiableAt ℂ Φ (c p))
    (heq : (fun y ↦ evalExt W b (c.symm y)) =ᶠ[𝓝 (c p)] h ∘ Φ) {w : F}
    (hw : fderiv ℂ Φ (c p) w = 0) : chartDeriv c W p b w = 0 := by
  rw [chartDeriv, heq.fderiv_eq, fderiv_comp _ hh hΦ, ContinuousLinearMap.comp_apply, hw, map_zero]

end UnderlyingSpace

namespace Modules

open MMP.Intersection.Scheme

variable {X : Scheme.{0}} {E : X.Modules} [E.IsQuasicoherent] {r : ℕ}

/-- **The functions on `π⁻¹(U)` are polynomials in the chart coordinates** with coefficients
functions on `U`, for a chart `c' = (U, b)`: the ring `Γ(π⁻¹U, 𝒪)` is generated by the
pull-backs `π^* a` of the functions `a ∈ Γ(X, U)` and the chart coordinates `bᵢ`. -/
theorem mem_closure_range_app_union_range_chartCoordSection (c' : Chart E r)
    (b : Γ(totalSpace E, proj E ⁻¹ᵁ c'.1.1)) :
    b ∈ Subring.closure
      (range ((proj E).app c'.1.1).hom ∪ range (chartCoordSection c')) := by
  have : IsAffine c'.1.1.toScheme := c'.1.2
  set ψ := ((chartIso c').hom.appTop ≫ (proj E ⁻¹ᵁ c'.1.1).topIso.hom).hom
  have hb : b = ψ ((chartIso c').inv.appTop ((proj E ⁻¹ᵁ c'.1.1).topIso.inv b)) := by
    change b = (proj E ⁻¹ᵁ c'.1.1).topIso.hom ((chartIso c').symm.inv.appTop
      ((chartIso c').symm.hom.appTop ((proj E ⁻¹ᵁ c'.1.1).topIso.inv b)))
    rw [appTop_inv_hom_apply, Iso.inv_hom_id_apply]
  have ht := closure_range_affineSpace_eq_top c'.1.1.toScheme r ▸
    Subring.mem_top ((chartIso c').inv.appTop ((proj E ⁻¹ᵁ c'.1.1).topIso.inv b))
  rw [hb]
  refine Subring.closure_le (t := (Subring.closure _).comap ψ) |>.2 ?_ ht
  rintro _ (⟨a, rfl⟩ | ⟨i, rfl⟩)
  · refine Subring.subset_closure (mem_union_left _ ⟨c'.1.1.topIso.hom a, ?_⟩)
    change _ = (proj E ⁻¹ᵁ c'.1.1).topIso.hom
      ((chartIso c').hom.appTop ((𝔸(Fin r; c'.1.1.toScheme) ↘ c'.1.1.toScheme).appTop a))
    rw [← CommRingCat.comp_apply ((𝔸(Fin r; c'.1.1.toScheme) ↘ c'.1.1.toScheme).appTop),
      ← Scheme.Hom.comp_appTop, chartIso_hom_over,
      topIso_hom_morphismRestrict_appTop]
  · refine Subring.subset_closure (mem_union_right _ ⟨i, ?_⟩)
    exact chartCoordSection_eq c' i

variable (E r) [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E r]
  [X.Over (Spec (.of ℂ))] (V : Subvariety X)
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F]
  {G : Type*} [NormedAddCommGroup G] [NormedSpace ℂ G]
  {c : OpenPartialHomeomorph (UnderlyingSpace ℂ (preimageSubvariety E r V).toScheme) F}
  {e : OpenPartialHomeomorph (UnderlyingSpace ℂ V.toScheme) G}
  {p : UnderlyingSpace ℂ (preimageSubvariety E r V).toScheme}

/-- **The bundle chart of `E|_V` is an immersion in algebraic charts.** For algebraic charts `c`
of `E|_V(ℂ)` (with finite-dimensional model) and `e` of `V(ℂ)`, and a point `p` of the source of
`c` with `π_V(p)` in the source of `e` and lying over the domain `π⁻¹(U)` of a chart
`c' = (U, b)` of `ℰ`, the derivative at `c(p)` of the chart expression
`y ↦ (e(π_V(c⁻¹ y)), x^{c'}(ι(c⁻¹ y)))` of the bundle chart is injective. -/
theorem injective_fderiv_bundleChart [FiniteDimensional ℂ F] (hc : IsAlgebraicChart c)
    (he : IsAlgebraicChart e) (hp : p ∈ c.source)
    (hpe : mapFun (preimageSubvarietyProj E r V) p ∈ e.source) (c' : Chart E r)
    (hpi : mapFun (preimageSubvariety E r V).ι p ∈ chartTotalOpens c') :
    Function.Injective (fderiv ℂ (fun y ↦ (e (mapFun (preimageSubvarietyProj E r V) (c.symm y)),
      coord c' (mapFun (preimageSubvariety E r V).ι (c.symm y)))) (c p)) := by
  set ιV := (preimageSubvariety E r V).ι
  set πV := preimageSubvarietyProj E r V
  set Φ : F → G × (Fin r → ℂ) := fun y ↦
    (e (mapFun πV (c.symm y)), coord c' (mapFun ιV (c.symm y))) with hΦdef
  set D := fderiv ℂ Φ (c p)
  have hΦ : DifferentiableAt ℂ Φ (c p) :=
    (contDiffAt_bundleChart E r V hc he hp hpe c' hpi).differentiableAt (by simp)
  have hΦp : Φ (c p) = (e (mapFun πV p), coord c' (mapFun ιV p)) := by
    simp only [Φ, c.left_inv hp]
  -- the affine open `W = ι⁻¹(π⁻¹(U))` around `p`
  set WE := proj E ⁻¹ᵁ c'.1.1
  have hWEa : IsAffineOpen WE := Scheme.Modules.isAffineOpen_preimage_vectorBundleToBase X E c'.1
  set W := ιV ⁻¹ᵁ WE
  have hWa : IsAffineOpen W := hWEa.preimage ιV
  have hpi' : ⊤ ≤ (mapFun ιV p).toHom ⁻¹ᵁ WE := (mem_chartTotalOpens_iff c' _).1 hpi
  have hpW : ⊤ ≤ p.toHom ⁻¹ᵁ W := (top_le_toHom_preimage_preimage_iff ιV WE).2 hpi'
  have hspan := span_chartDeriv_eq_top hc hp hWa hpW
  -- near `c p`, the points `c⁻¹ y` lie in `W(ℂ)` and `π_V (c⁻¹ y)` in the source of `e`
  have hnear : ∀ᶠ y in 𝓝 (c p), mapFun πV (c.symm y) ∈ e.source := by
    filter_upwards [(c.isOpen_inter_preimage_symm
      (e.open_source.preimage (continuous_mapFun _))).mem_nhds
      ⟨c.map_source hp, by simpa [c.left_inv hp] using hpe⟩] with y hy
    exact hy.2
  -- the functions on `π⁻¹(U)` whose pull-backs have differential vanishing on `ker D`
  let T : Subring Γ(totalSpace E, WE) :=
    { carrier := {b | ∀ w, D w = 0 → chartDeriv c W p (ιV.app WE b) w = 0}
      mul_mem' := fun {a b} ha hb w hw ↦ by
        simp only [map_mul, chartDeriv_mul hc hp hpW,
          _root_.add_apply, _root_.smul_apply, ha w hw, hb w hw,
          smul_zero, add_zero]
      one_mem' := fun w _ ↦ by
        have h1 : ιV.app WE 1 = constSection W (1 : ℂ) := by
          rw [map_one, constSection, map_one, map_one]
        simp only [h1, chartDeriv_constSection hp hpW,
          _root_.zero_apply]
      add_mem' := fun {a b} ha hb w hw ↦ by
        simp only [map_add, chartDeriv_add hc hp hpW,
          _root_.add_apply, ha w hw, hb w hw, add_zero]
      zero_mem' := fun w _ ↦ by
        have h0 : ιV.app WE 0 = constSection W (0 : ℂ) := by
          rw [map_zero, constSection, map_zero, map_zero]
        simp only [h0, chartDeriv_constSection hp hpW,
          _root_.zero_apply]
      neg_mem' := fun {a} ha w hw ↦ by
        have hn : ιV.app WE (-a) = constSection W (0 : ℂ) - ιV.app WE a := by
          rw [map_neg, constSection, map_zero, map_zero, zero_sub]
        simp only [hn, chartDeriv_sub hc hp hpW,
          chartDeriv_constSection hp hpW, _root_.sub_apply,
          _root_.zero_apply, ha w hw, sub_zero] }
  have hT : ∀ b, b ∈ T := by
    intro b
    refine Subring.closure_le.2 ?_ (mem_closure_range_app_union_range_chartCoordSection c' b)
    rintro _ (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · -- the pull-back of a function `a` on `U ⊆ X`
      set a' := V.ι.app c'.1.1 a
      have hO : ⊤ ≤ (mapFun πV p).toHom ⁻¹ᵁ (V.ι ⁻¹ᵁ c'.1.1) :=
        (top_le_toHom_preimage_preimage_iff V.ι _).2 (by
          rw [mapFun_preimageSubvarietyProj]
          exact hpi')
      intro w hw
      refine chartDeriv_apply_eq_zero_of_eventuallyEq
        (h := fun k ↦ evalExt (V.ι ⁻¹ᵁ c'.1.1) a' (e.symm k.1)) ?_ hΦ ?_ hw
      · rw [hΦp]
        exact DifferentiableAt.comp (g := fun k : G ↦ evalExt (V.ι ⁻¹ᵁ c'.1.1) a' (e.symm k)) _
          (differentiableAt_evalExt he hpe hO a') differentiableAt_fst
      · filter_upwards [hnear] with y hy
        simp only [Function.comp_apply, Φ, e.left_inv hy]
        rw [← evalExt_mapFun ιV, ← evalExt_mapFun (proj E), ← mapFun_preimageSubvarietyProj,
          evalExt_mapFun V.ι]
    · -- a chart coordinate
      intro w hw
      refine chartDeriv_apply_eq_zero_of_eventuallyEq (h := fun k ↦ k.2 a)
        (DifferentiableAt.comp (g := fun v : Fin r → ℂ ↦ v a) _
          (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin r ↦ ℂ) a).differentiableAt
          differentiableAt_snd) hΦ ?_ hw
      filter_upwards with y
      simp only [Function.comp_apply, Φ]
      rw [← evalExt_mapFun]
      rfl
  -- conclusion: the differentials span the dual
  refine (injective_iff_map_eq_zero _).2 fun w hw ↦ ?_
  refine SeparatingDual.eq_zero_of_forall_dual_eq_zero (R := ℂ) fun f ↦ ?_
  have hf : f ∈ Submodule.span ℂ (range (chartDeriv c W p)) := hspan ▸ Submodule.mem_top
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨b, rfl⟩ := hf
    obtain ⟨a, rfl⟩ := ιV.app_surjective WE hWEa b
    exact hT a w hw
  | zero => simp
  | add f g _ _ hf hg => simp [hf, hg]
  | smul k f _ hf => simp [hf]

end Modules

end MMP
