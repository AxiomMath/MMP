module

public import MMP.AlgebraicGeometry.CycleMap.Stacks.RegularEmbeddingOrientation.StacksClass
public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.AlgebraicChartDifferential
public import StacksFrontier.AlgebraicGeometry.RegularImmersion.CodimLocal
public import StacksFrontier.AlgebraicGeometry.Flatness.StalkIdealSheaf
public import Mathlib.RingTheory.KrullDimension.Regular
public import Mathlib.RingTheory.Regular.Flat

/-!
# Local equations of a regular imbedding cut out by a section of a Stacks vector bundle

Let `i : X → Y` be a regular closed immersion of codimension `d`, `ℰ` a quasi-coherent
`𝒪_Y`-module, finite locally free, and `σ : Y ⟶ 𝐕(ℰ)` a section with zero scheme `Z(σ) = X`. Let
`x ∈ X`, `c = (V, b)` a chart of `ℰ` and `W ⊆ σ⁻¹(π⁻¹V)` an affine open containing `i(x)`, and
let `I ⊆ 𝒪_{Y, i x}` be the ideal generated by the germs of the local coordinates `σ^♯bₐ` of `σ`
on `W`. Then:

* `I` is the kernel of the surjection `𝒪_{Y, i x} → 𝒪_{X, x}`, so `𝒪_{Y, i x} ⧸ I ≅ 𝒪_{X, x}`;
* if `𝒪_{X, x}` is regular, so is `𝒪_{Y, i x} ⧸ I`;
* `I` is also generated by a regular sequence of length `d`, so if `𝒪_{Y, i x}` is noetherian,
  `dim 𝒪_{Y, i x} ⧸ I + d = dim 𝒪_{Y, i x}`.

The same statements are given at a point `x ∈ X(ℂ)` of a complex scheme, with `p = i(x)`.

## Main results

* `MMP.Modules.exists_isRegular_ofList_eq_ker_stalkMap`: in `𝒪_{Y, i x}` the ideal of a regular
  closed immersion of codimension `d` is generated by a regular sequence of length `d`.
* `MMP.Modules.ker_stalkMap_eq_span_germ_sectionCoord`: the ideal of `X` in `𝒪_{Y, i x}` is
  generated by the germs of the local coordinates of `σ`.
* `MMP.Modules.quotientSpanGermSectionCoordEquiv`: the isomorphism `𝒪_{Y, i x} ⧸ I ≅ 𝒪_{X, x}`.
* `MMP.Modules.isRegularLocalRing_quotient_span_germ_sectionCoord` and
  `MMP.Modules.ringKrullDim_quotient_span_germ_sectionCoord_add`: regularity and dimension of
  `𝒪_{Y, i x} ⧸ I`.
* `MMP.Modules.isRegularLocalRing_quotient_span_germ_sectionCoord_mapFun` and
  `MMP.Modules.ringKrullDim_quotient_span_germ_sectionCoord_mapFun`: the same at a complex point.

## Implementation notes

The dimension formula assumes `𝒪_{Y, i x}` noetherian: the equality `dim A ⧸ (r) + 1 = dim A`
for a non-zero-divisor `r` of the maximal ideal rests on Krull's principal ideal theorem.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.2 and Appendix B.7.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

namespace MMP.Modules

open Stacks.AlgebraicGeometry.RegularIdealSheaf (IsRegularClosedImmersionOfCodim
  isRegularClosedImmersionOfCodim_iff_kerGeneratedBy)

section Scheme

variable {X Y : Scheme.{0}} {i : X ⟶ Y}

/-- In the local ring `𝒪_{Y, i x}` at a point of `X`, the ideal of a regular closed immersion
`i : X → Y` of codimension `d` is generated by a regular sequence of length `d`. -/
theorem exists_isRegular_ofList_eq_ker_stalkMap [IsClosedImmersion i] {d : ℕ}
    (hi : IsRegularClosedImmersionOfCodim i d) (x : X) :
    ∃ rs : List (Y.presheaf.stalk (i x)), rs.length = d ∧
      RingTheory.Sequence.IsRegular (Y.presheaf.stalk (i x)) rs ∧
      Ideal.ofList rs = RingHom.ker (i.stalkMap x).hom := by
  obtain ⟨U, hxU, r, f, hker, rfl, hreg⟩ :=
    (isRegularClosedImmersionOfCodim_iff_kerGeneratedBy i d).1 hi (i x)
      (subset_closure ⟨x, rfl⟩)
  have hxU' : x ∈ i ⁻¹ᵁ U.1 := hxU
  have hspan : Ideal.span (Set.range f) = Ideal.ofList (List.ofFn f) := by
    rw [Ideal.ofList]
    congr 1
    ext a
    simp [List.mem_ofFn]
  have hK : RingHom.ker (i.stalkMap x).hom =
      Ideal.ofList ((List.ofFn f).map (Y.presheaf.germ U.1 (i x) hxU).hom) := by
    rw [Stacks.Flatness.ker_stalkMap_eq_map_germ i U.2 (U.2.preimage i) le_rfl hxU' hxU
        (by rw [← Scheme.Hom.app_eq_appLE]; exact i.app_surjective U.1 U.2),
      ← Scheme.Hom.app_eq_appLE, hker, hspan, Ideal.map_ofList]
  refine ⟨(List.ofFn f).map (Y.presheaf.germ U.1 (i x) hxU).hom, by simp, ?_, hK.symm⟩
  letI : Algebra Γ(Y, U.1) (Y.presheaf.stalk (i x)) :=
    (Y.presheaf.germ U.1 (i x) hxU).hom.toAlgebra
  haveI := U.2.isLocalization_stalk ⟨i x, hxU⟩
  haveI : Module.Flat Γ(Y, U.1) (Y.presheaf.stalk (i x)) :=
    IsLocalization.flat _ (U.2.primeIdealOf ⟨i x, hxU⟩).asIdeal.primeCompl
  refine (RingTheory.Sequence.isRegular_iff _ _).2 ⟨hreg.of_flat, ?_⟩
  rw [smul_eq_mul, Ideal.mul_top, ← hK]
  haveI : Nontrivial (X.presheaf.stalk x) := inferInstance
  exact (RingHom.ker_ne_top _).symm

variable {E : Y.Modules} [E.IsQuasicoherent] {r : ℕ} {σ : Y ⟶ totalSpace E} {c : Chart E r}
  {W : Y.affineOpens} (hW : W.1 ≤ σ ⁻¹ᵁ (proj E ⁻¹ᵁ c.1.1))

/-- **The ideal of a zero scheme in a local ring is generated by the local coordinates.** If the
closed immersion `i : X → Y` has the zero scheme of a section `σ` of `𝐕(ℰ)` as its ideal sheaf,
then at a point `x ∈ X` with `i(x)` in an affine open `W ⊆ σ⁻¹(π⁻¹V)`, `c = (V, b)` a chart of
`ℰ`, the kernel of `𝒪_{Y, i x} → 𝒪_{X, x}` is generated by the germs of the local coordinates
of `σ` on `W`. -/
theorem ker_stalkMap_eq_span_germ_sectionCoord [IsClosedImmersion i]
    (hs : zeroLocus E σ = i.ker) {x : X} (hxW : i x ∈ W.1) :
    RingHom.ker (i.stalkMap x).hom = Ideal.span (Set.range fun a ↦
      Y.presheaf.germ W.1 (i x) hxW (sectionCoord σ c hW a)) := by
  have hxW' : x ∈ i ⁻¹ᵁ W.1 := hxW
  rw [Stacks.Flatness.ker_stalkMap_eq_map_germ i W.2 (W.2.preimage i) le_rfl hxW' hxW
      (by rw [← Scheme.Hom.app_eq_appLE]; exact i.app_surjective W.1 W.2),
    ← Scheme.Hom.app_eq_appLE, ← Scheme.Hom.ker_apply, ← hs, ideal_zeroLocus σ c W hW,
    Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The local ring of the zero scheme.** The quotient of `𝒪_{Y, i x}` by the ideal generated
by the germs of the local coordinates of `σ` is isomorphic to `𝒪_{X, x}`, through the stalk map
of `i`. -/
def quotientSpanGermSectionCoordEquiv [IsClosedImmersion i] (hs : zeroLocus E σ = i.ker)
    {x : X} (hxW : i x ∈ W.1) :
    (Y.presheaf.stalk (i x) ⧸ Ideal.span (Set.range fun a ↦
      Y.presheaf.germ W.1 (i x) hxW (sectionCoord σ c hW a))) ≃+* X.presheaf.stalk x :=
  (Ideal.quotEquivOfEq (ker_stalkMap_eq_span_germ_sectionCoord hW hs hxW).symm).trans
    (RingHom.quotientKerEquivOfSurjective (i.stalkMap_surjective x))

/-- **Regularity of the local ring of the zero scheme.** If `𝒪_{X, x}` is a regular local ring,
so is the quotient of `𝒪_{Y, i x}` by the germs of the local coordinates of `σ`. -/
theorem isRegularLocalRing_quotient_span_germ_sectionCoord [IsClosedImmersion i]
    (hs : zeroLocus E σ = i.ker) {x : X} (hxW : i x ∈ W.1)
    [IsRegularLocalRing (X.presheaf.stalk x)] :
    IsRegularLocalRing (Y.presheaf.stalk (i x) ⧸ Ideal.span (Set.range fun a ↦
      Y.presheaf.germ W.1 (i x) hxW (sectionCoord σ c hW a))) :=
  IsRegularLocalRing.of_ringEquiv (quotientSpanGermSectionCoordEquiv hW hs hxW).symm

/-- **Dimension of the local ring of the zero scheme.** If `i` is a regular closed immersion of
codimension `d` and `𝒪_{Y, i x}` is noetherian, the quotient of `𝒪_{Y, i x}` by the germs of the
local coordinates of `σ` has dimension `dim 𝒪_{Y, i x} - d`: these germs generate the ideal of
`X`, which is also generated by a regular sequence of length `d`. -/
theorem ringKrullDim_quotient_span_germ_sectionCoord_add [IsClosedImmersion i] {d : ℕ}
    (hi : IsRegularClosedImmersionOfCodim i d) (hs : zeroLocus E σ = i.ker) {x : X}
    (hxW : i x ∈ W.1) [IsNoetherianRing (Y.presheaf.stalk (i x))] :
    ringKrullDim (Y.presheaf.stalk (i x) ⧸ Ideal.span (Set.range fun a ↦
      Y.presheaf.germ W.1 (i x) hxW (sectionCoord σ c hW a))) + d =
      ringKrullDim (Y.presheaf.stalk (i x)) := by
  obtain ⟨rs, hlen, hreg, hrs⟩ := exists_isRegular_ofList_eq_ker_stalkMap hi x
  rw [← ker_stalkMap_eq_span_germ_sectionCoord hW hs hxW, ← hrs, ← hlen]
  exact ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hreg

end Scheme

section Complex

open UnderlyingSpace

variable {X Y : Scheme.{0}} [X.Over (Spec (.of ℂ))] [Y.Over (Spec (.of ℂ))] {i : X ⟶ Y}
  [i.IsOver (Spec (.of ℂ))] {E : Y.Modules} [E.IsQuasicoherent] {r : ℕ} {σ : Y ⟶ totalSpace E}
  {c : Chart E r} {W : Y.affineOpens} (hW : W.1 ≤ σ ⁻¹ᵁ (proj E ⁻¹ᵁ c.1.1))
  {x : UnderlyingSpace ℂ X}

/-- **Regularity of the local ring of the zero scheme at a complex point.** For `x ∈ X(ℂ)` with
`p = i(x)` in an affine open `W ⊆ σ⁻¹(π⁻¹V)`, if `𝒪_{X, x}` is regular, so is the quotient of
`𝒪_{Y, p}` by the germs at `p` of the local coordinates of `σ` on `W`. -/
theorem isRegularLocalRing_quotient_span_germ_sectionCoord_mapFun [IsClosedImmersion i]
    (hs : zeroLocus E σ = i.ker) (hpW : ⊤ ≤ (mapFun i x).toHom ⁻¹ᵁ W.1)
    [IsRegularLocalRing (X.presheaf.stalk (x.toHom (IsLocalRing.closedPoint ℂ)))] :
    IsRegularLocalRing (Y.presheaf.stalk ((mapFun i x).toHom (IsLocalRing.closedPoint ℂ)) ⧸
      Ideal.span (Set.range fun a ↦ Y.presheaf.germ W.1 _
        ((top_le_preimage_iff (mapFun i x) W.1).1 hpW) (sectionCoord σ c hW a))) :=
  isRegularLocalRing_quotient_span_germ_sectionCoord hW hs
    ((top_le_preimage_iff (mapFun i x) W.1).1 hpW)

/-- **Dimension of the local ring of the zero scheme at a complex point.** For `x ∈ X(ℂ)` with
`p = i(x)` in an affine open `W ⊆ σ⁻¹(π⁻¹V)`, if `i` is a regular closed immersion of
codimension `d` and `𝒪_{Y, p}` is noetherian, the quotient of `𝒪_{Y, p}` by the germs at `p` of
the local coordinates of `σ` on `W` has dimension `dim 𝒪_{Y, p} - d`. -/
theorem ringKrullDim_quotient_span_germ_sectionCoord_mapFun [IsClosedImmersion i] {d : ℕ}
    (hi : IsRegularClosedImmersionOfCodim i d) (hs : zeroLocus E σ = i.ker)
    (hpW : ⊤ ≤ (mapFun i x).toHom ⁻¹ᵁ W.1)
    [IsNoetherianRing (Y.presheaf.stalk ((mapFun i x).toHom (IsLocalRing.closedPoint ℂ)))] :
    ringKrullDim (Y.presheaf.stalk ((mapFun i x).toHom (IsLocalRing.closedPoint ℂ)) ⧸
      Ideal.span (Set.range fun a ↦ Y.presheaf.germ W.1 _
        ((top_le_preimage_iff (mapFun i x) W.1).1 hpW) (sectionCoord σ c hW a))) + d =
      ringKrullDim (Y.presheaf.stalk ((mapFun i x).toHom (IsLocalRing.closedPoint ℂ))) := by
  haveI : IsNoetherianRing (Y.presheaf.stalk (i (x.toHom (IsLocalRing.closedPoint ℂ)))) :=
    ‹IsNoetherianRing (Y.presheaf.stalk ((mapFun i x).toHom (IsLocalRing.closedPoint ℂ)))›
  exact ringKrullDim_quotient_span_germ_sectionCoord_add (x := x.toHom (IsLocalRing.closedPoint ℂ))
    hW hi hs ((top_le_preimage_iff (mapFun i x) W.1).1 hpW)

end Complex

end MMP.Modules
