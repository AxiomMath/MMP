module

public import MMP.AlgebraicGeometry.CycleMap.Stacks.LocalizedFirstChern.StacksSectionIdeal
public import MMP.AlgebraicGeometry.Variety.SmoothEmbedding
public import StacksFrontier.AlgebraicGeometry.Perfect.ResolutionPropertyNoetherianRegular
public import StacksFrontier.AlgebraicGeometry.Chow.ProjectiveCompletionChern.Basic
public import StacksFrontier.AlgebraicGeometry.Constructions.VectorBundlePoints
public import StacksFrontier.AlgebraicGeometry.Constructions.VectorBundleMapSections
public import StacksFrontier.AlgebraicGeometry.IdealPowerSmul.Coherence

/-!
# Closed subschemes are zero schemes of sections of Stacks bundles of large rank

Fulton, B.8.1, with a lower bound on the rank, for a scheme `Y` closed in a smooth variety `P`:
every closed subscheme of `Y` is the zero scheme `Z(σ)` of a section `σ : Y ⟶ 𝐕(ℰ)` of the
vector bundle `𝐕(ℰ) = Spec_Y(Sym ℰ)` of a quasi-coherent `𝒪_Y`-module `ℰ`, finite locally free
of a rank `≥ n`.

`P` is regular and Noetherian, so it has the resolution property, and the ideal sheaf `𝓘 ⊆ 𝒪_Y`
is a quotient `ℰ ↠ 𝓘` of a locally free sheaf, whose rank can be raised by adding trivial
summands (`MMP.Modules.exists_epi_of_isFiniteLocallyFreeOfRank_of_le`). A morphism `ℰ ⟶ 𝒪_Y` is a
section `σ` of `𝐕(ℰ)` (`AlgebraicGeometry.Scheme.Modules.vectorBundleHomEquiv`), and the ideal of
`Z(σ)` on an affine open `W` is generated by the values on `Γ(ℰ, W)` of the morphism
(`MMP.Modules.ideal_zeroLocus_sectionOfHom`), here `𝓘(W)`.

## Main results

* `MMP.Modules.exists_epi_of_isFiniteLocallyFreeOfRank_of_le`: a coherent sheaf on a scheme closed
  in a smooth variety is a quotient of a locally free sheaf of constant rank `e + 1` with `e ≥ n`.
* `MMP.Modules.ideal_zeroLocus_sectionOfHom`: the ideal of the zero scheme of the section given by
  `ψ : ℰ ⟶ 𝒪_Y` on an affine open `W` is generated by `ψ(Γ(ℰ, W))`.
* `MMP.Modules.exists_section_zeroLocus_eq_of_le`: every closed subscheme of `Y` is the zero
  scheme of a section of the vector bundle of a locally free sheaf of rank `≥ n`.
* `MMP.Modules.exists_section_zeroLocus_eq_ker_of_le`: a closed immersion into `Y` is cut out by a
  section of the vector bundle of a locally free sheaf of rank `≥ n`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Limits Opposite

namespace MMP.Modules

open Stacks.AffineAlgebraEquivalence

section Sections

variable {Y : Scheme.{0}} {E : Y.Modules} [E.IsQuasicoherent]

/-- A section `σ` of `π : 𝐕(ℰ) ⟶ Y` pulls `π⁻¹U` back to `U`. -/
lemma preimage_preimage_proj_of_comp_eq_id' {σ : Y ⟶ totalSpace E} (hσ : σ ≫ proj E = 𝟙 Y)
    (U : Y.Opens) : σ ⁻¹ᵁ (proj E ⁻¹ᵁ U) = U := by
  rw [← Scheme.Hom.comp_preimage, hσ, Scheme.Hom.id_preimage]

/-- On the part `π⁻¹V` of `𝐕(ℰ)` over an affine open `V`, the open immersion
`Spec Γ(V, Sym ℰ) ⟶ 𝐕(ℰ)` induces on sections the inverse of `totalSections` composed with
`Γ(Spec R, ⊤) ≅ R`. -/
lemma topIso_hom_comp_specSectionsι_appLE (V : Y.affineOpens)
    (h : ⊤ ≤ specSectionsι E V ⁻¹ᵁ (proj E ⁻¹ᵁ V.1)) :
    (proj E ⁻¹ᵁ V.1).topIso.hom ≫ (specSectionsι E V).appLE (proj E ⁻¹ᵁ V.1) ⊤ h =
      (specIso E V).inv.appTop := by
  have key : ∀ (g : Spec (symSections E V.1) ⟶ totalSpace E)
      (_ : g = (specIso E V).inv ≫ (proj E ⁻¹ᵁ V.1).ι) (h : ⊤ ≤ g ⁻¹ᵁ (proj E ⁻¹ᵁ V.1)),
      (proj E ⁻¹ᵁ V.1).topIso.hom ≫ g.appLE (proj E ⁻¹ᵁ V.1) ⊤ h =
        (specIso E V).inv.appTop := by
    rintro g rfl h
    rw [← Scheme.Hom.appLE_comp_appLE (specIso E V).inv (proj E ⁻¹ᵁ V.1).ι (proj E ⁻¹ᵁ V.1) ⊤ ⊤
      (by simp) le_top]
    have hid : (proj E ⁻¹ᵁ V.1).topIso.hom ≫
        (proj E ⁻¹ᵁ V.1).ι.appLE (proj E ⁻¹ᵁ V.1) ⊤ (by simp) = 𝟙 _ := by
      simp only [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_hom]
      exact ((totalSpace E).presheaf.map_comp _ _).symm.trans
        (Eq.trans (congrArg _ (Subsingleton.elim _ (𝟙 _))) ((totalSpace E).presheaf.map_id _))
    rw [reassoc_of% hid]
    rfl
  exact key _ (Iso.eq_inv_comp _ |>.2 (specIso_hom_specSectionsι E V)) h

/-- The identification `totalSections` of `Γ(V, Sym ℰ)` with the functions on `π⁻¹V` is the
inverse of the comparison isomorphism `π_* 𝒪 ≅ Sym ℰ` on sections over `V`. -/
lemma totalSections_apply_eq (V : Y.affineOpens) (a : symSections E V.1) :
    totalSections E V a =
      ((Scheme.Modules.vectorBundlePushforwardIso Y (F := E)).inv.right.hom.app
        (op V.1)).hom a := by
  set e := Scheme.Modules.vectorBundlePushforwardIso Y (F := E)
  have hinv : ∀ w, (e.inv.right.hom.app (op V.1)).hom ((e.hom.right.hom.app (op V.1)).hom w) = w :=
    fun w ↦ congrArg (fun g : pushforwardAlgebra (proj E) ⟶ pushforwardAlgebra (proj E) =>
      (g.right.hom.app (op V.1)).hom w) e.hom_inv_id
  have hhom : e.hom.right.hom.app (op V.1) =
      (specSectionsι E V).appLE (proj E ⁻¹ᵁ V.1) ⊤
          (le_ι_preimage (relativeSpecGluingData (symAlg E)) V) ≫
        (Scheme.ΓSpecIso (symSections E V.1)).hom :=
    Stacks.AffineAlgebraEquivalence.pushforwardSheafIso_hom_app _ V
  have hcomp : totalSections E V ≫ e.hom.right.hom.app (op V.1) = 𝟙 _ := by
    rw [hhom, totalSections]
    simp only [Category.assoc]
    have h1 : (specIso E V).hom.appTop ≫ (specIso E V).inv.appTop = 𝟙 _ := by
      rw [← Scheme.Hom.comp_appTop, Iso.inv_hom_id]
      rfl
    erw [reassoc_of% topIso_hom_comp_specSectionsι_appLE, reassoc_of% h1]
    exact Iso.inv_hom_id _
  exact (hinv _).symm.trans (congrArg _ (ConcreteCategory.congr_hom hcomp a))

open Scheme.Modules Stacks.RelativeSpec in
/-- **The module morphism of a point of `𝐕(ℰ)` on local sections.** For a morphism
`u : W ⟶ 𝐕(ℰ)` over `Y`, the morphism `ℰ ⟶ h_* 𝒪_W` of `vectorBundleHomEquiv` sends a section
`m ∈ Γ(ℰ, V)` over an affine open `V` to `u^♯ m`, the pullback along `u` of the function `m` on
`π⁻¹V`. -/
lemma vectorBundleHomEquiv_app_apply (W : Over Y) (u : W ⟶ vectorBundleOver Y (F := E))
    (V : Y.affineOpens) (m : Γ(E, V.1)) :
    (Scheme.Modules.Hom.app (vectorBundleHomEquiv E W u) V.1).hom m =
      u.left.appLE (proj E ⁻¹ᵁ V.1) (W.hom ⁻¹ᵁ V.1) (preimage_le_preimage_preimage u V.1)
        (totalSections E V (generator E V.2 m)) := by
  have := isAffineHom_vectorBundleOver Y (F := E)
  refine (congrArg (fun φ : E ⟶ structurePushforward W.hom => (φ.app V.1).hom m)
    (vectorBundleHomEquiv_apply E W u)).trans ?_
  set x := (symmetricAlgebraGen Y E).val.app (op V.1) m
  change ((pushforwardAlgebraMap u).right.hom.app (op V.1)).hom
      (((vectorBundlePushforwardIso Y (F := E)).inv.right.hom.app (op V.1)).hom
        (((ungradedToGradedRight Y (symmetricAlgebra Y E) (symmetricAlgebra_mul_comm Y E)).hom.app
          (op V.1)).hom (ungradedAlgebraSheafIncl Y (symmetricAlgebra Y E)
            (symmetricAlgebra_mul_comm Y E) 1 V.1 x))) = _
  rw [ungradedToGradedRight_ungradedAlgebraSheafIncl,
    pushforwardAlgebraMap_app _ _ (preimage_le_preimage_preimage _ V.1)]
  refine congrArg _ ?_
  erw [totalSections_apply_eq, generator_apply,
    Stacks.SymAlgSections.symSectionsRingEquiv_ι_eq_ungradedIncl]

/-- **The ideal of the zero scheme of `σ : Y ⟶ 𝐕(ℰ)` on an affine open `W`** is generated by the
pullbacks `σ^♯ m` of the degree-one functions `m ∈ Γ(ℰ, W)` on `π⁻¹W`. -/
theorem ideal_zeroLocus_eq_span_generator (σ : Y ⟶ totalSpace E) (W : Y.affineOpens)
    (hW : W.1 ≤ σ ⁻¹ᵁ (proj E ⁻¹ᵁ W.1)) :
    (zeroLocus E σ).ideal W = Ideal.span (Set.range fun m : Γ(E, W.1) ↦
      σ.appLE (proj E ⁻¹ᵁ W.1) W.1 hW (totalSections E W (generator E W.2 m))) := by
  rw [zeroLocus, Stacks.IdealSheaf.ideal_comap_appLE _ σ
    ⟨proj E ⁻¹ᵁ W.1, isAffineOpen_proj_preimage E W⟩ W hW,
    ideal_ker_zeroSection_eq_span_generator, Ideal.map_span, ← Set.range_comp]
  rfl

/-- The section `σ : Y ⟶ 𝐕(ℰ)` of the vector bundle of `ℰ` given by a morphism `ψ : ℰ ⟶ 𝒪_Y`
(`AlgebraicGeometry.Scheme.Modules.vectorBundleHomEquiv`). -/
def sectionOfHom (ψ : E ⟶ SheafOfModules.unit Y.ringCatSheaf) : Y ⟶ totalSpace E :=
  ((Scheme.Modules.vectorBundleHomEquiv E (Over.mk (𝟙 Y))).symm
    (ψ ≫ (Scheme.Modules.pushforwardId Y).inv.app _)).left

/-- The morphism `sectionOfHom ψ` is a section of the projection `π : 𝐕(ℰ) ⟶ Y`. -/
lemma sectionOfHom_comp_proj (ψ : E ⟶ SheafOfModules.unit Y.ringCatSheaf) :
    sectionOfHom ψ ≫ proj E = 𝟙 Y :=
  Over.w ((Scheme.Modules.vectorBundleHomEquiv E (Over.mk (𝟙 Y))).symm
    (ψ ≫ (Scheme.Modules.pushforwardId Y).inv.app _))

/-- **The zero scheme of the section given by `ψ : ℰ ⟶ 𝒪_Y`** is cut out on an affine open `W` by
the image `ψ(Γ(ℰ, W)) ⊆ Γ(Y, W)`. -/
theorem ideal_zeroLocus_sectionOfHom (ψ : E ⟶ SheafOfModules.unit Y.ringCatSheaf)
    (W : Y.affineOpens) :
    (zeroLocus E (sectionOfHom ψ)).ideal W =
      Ideal.span (Set.range fun m : Γ(E, W.1) ↦
        (show Γ(Y, W.1) from (Scheme.Modules.Hom.app ψ W.1).hom m)) := by
  have hW : W.1 ≤ sectionOfHom ψ ⁻¹ᵁ (proj E ⁻¹ᵁ W.1) := by
    rw [preimage_preimage_proj_of_comp_eq_id' (sectionOfHom_comp_proj ψ)]
  rw [ideal_zeroLocus_eq_span_generator _ W hW]
  congr 2
  funext m
  have h := vectorBundleHomEquiv_app_apply (Over.mk (𝟙 Y))
    ((Scheme.Modules.vectorBundleHomEquiv E (Over.mk (𝟙 Y))).symm
      (ψ ≫ (Scheme.Modules.pushforwardId Y).inv.app _)) W m
  rw [Equiv.apply_symm_apply] at h
  exact h.symm

end Sections

section Epi

universe u

/-- **Fulton B.8.1, with rank at least `n + 1`.** A coherent sheaf on a scheme closed in a
smooth variety is a quotient of a locally free sheaf of constant rank `e + 1` with `e ≥ n`. -/
theorem exists_epi_of_isFiniteLocallyFreeOfRank_of_le (K : Type u) [Field K]
    {X M : Scheme.{u}} [M.Over (Spec (.of K))] [IsSmoothVariety K (M ↘ Spec (.of K))]
    (i : X ⟶ M) [IsClosedImmersion i] (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (n : ℕ) :
    ∃ (e : ℕ) (E : X.Modules)
      (_ : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (e + 1)) (f : E ⟶ F),
      Epi f ∧ n ≤ e := by
  induction n with
  | zero =>
    have : IsNoetherian (Spec (CommRingCat.of K)) :=
      isNoetherian_Spec.mpr (inferInstanceAs (IsNoetherianRing K))
    have : IsLocallyNoetherian M := LocallyOfFiniteType.isLocallyNoetherian (M ↘ Spec (.of K))
    have : CompactSpace M := QuasiCompact.compactSpace_of_compactSpace (M ↘ Spec (.of K))
    have : IsNoetherian M := { }
    have : QuasiSeparatedSpace M := quasiSeparatedSpace_of_quasiSeparated (M ↘ Spec (.of K))
    have : IsSeparated (terminal.from M) := by
      rw [← terminal.comp_from (M ↘ Spec (.of K))]
      infer_instance
    have hM : HasResolutionProperty M :=
      hasResolutionProperty_of_isRegular_of_isNoetherian M
        (isRegular_of_smooth_over_field (M ↘ Spec (.of K)))
    have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace i
    obtain ⟨G, hGfp, p, hp⟩ :=
      Stacks.AlgebraicGeometry.ModuleLimits.exists_finitePresentation_epi_pullback
        Stacks.AlgebraicGeometry.ModuleLimits.affineCounitEpi.{u} i F
    obtain ⟨hGqc, hGft⟩ :=
      Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isFinitePresentation
        G hGfp
    obtain ⟨E₀, hE₀, v, hv⟩ := hM.exists_finiteLocallyFree_quotient G
    obtain ⟨x₀⟩ := (inferInstance : Nonempty M)
    have hr : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₀
        (Scheme.Modules.fiberRank E₀ x₀) :=
      Scheme.Modules.isFiniteLocallyFreeOfRank_of_fiberRank_eq E₀ _ x₀ rfl
    set r := Scheme.Modules.fiberRank E₀ x₀
    let E₁ := Stacks.Chow.ProjectiveCompletion.module E₀
    have hE₁ : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E₁ (r + 1) :=
      Stacks.Chow.ProjectiveCompletion.isFiniteLocallyFreeOfRank_module E₀ r
    have hfst : Epi (biprod.fst : E₀ ⊞ SheafOfModules.unit M.ringCatSheaf ⟶ E₀) :=
      epi_of_epi_fac biprod.inl_fst
    let w : E₁ ⟶ G := (biprod.fst : E₀ ⊞ SheafOfModules.unit M.ringCatSheaf ⟶ E₀) ≫ v
    have : Epi w := @epi_comp _ _ _ _ _ _ hfst _ hv
    have : Epi ((Scheme.Modules.pullback i).map w) :=
      preserves_epi_of_preservesColimit (Scheme.Modules.pullback i) w
    exact ⟨r, (Scheme.Modules.pullback i).obj E₁,
      Stacks.Chow.GenuineChern.isFiniteLocallyFreeOfRank_pullback i E₁ (r + 1),
      (Scheme.Modules.pullback i).map w ≫ p, @epi_comp _ _ _ _ _ _ inferInstance _ hp,
      Nat.zero_le _⟩
  | succ n ih =>
    obtain ⟨e, E, hE, f, hf, hn⟩ := ih
    have hfst : Epi (biprod.fst : E ⊞ SheafOfModules.unit X.ringCatSheaf ⟶ E) :=
      epi_of_epi_fac biprod.inl_fst
    exact ⟨e + 1, Stacks.Chow.ProjectiveCompletion.module E,
      Stacks.Chow.ProjectiveCompletion.isFiniteLocallyFreeOfRank_module E (e + 1),
      (biprod.fst : E ⊞ SheafOfModules.unit X.ringCatSheaf ⟶ E) ≫ f,
      @epi_comp _ _ _ _ _ _ hfst _ hf, by omega⟩

end Epi

/-- **Every closed subscheme is the zero scheme of a section of a bundle of rank `≥ n`** (Fulton,
B.8.1): for `Y` closed in a smooth variety `P` and an ideal sheaf `𝓘` on `Y`, there are a
quasi-coherent `𝒪_Y`-module `ℰ`, finite locally free of a rank `r ≥ n`, and a section
`σ : Y ⟶ 𝐕(ℰ)` with `Z(σ) = V(𝓘)`. -/
theorem exists_section_zeroLocus_eq_of_le (K : Type) [Field K] {Y P : Scheme.{0}}
    [P.Over (Spec (.of K))] [IsSmoothVariety K (P ↘ Spec (.of K))]
    (j : Y ⟶ P) [IsClosedImmersion j] (I : Y.IdealSheafData) (n : ℕ) :
    ∃ (r : ℕ) (_ : n ≤ r) (E : Y.Modules) (_ : E.IsQuasicoherent)
      (_ : SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E r) (σ : Y ⟶ totalSpace E),
      σ ≫ proj E = 𝟙 Y ∧ zeroLocus E σ = I := by
  have : IsNoetherian (Spec (CommRingCat.of K)) :=
    isNoetherian_Spec.mpr (inferInstanceAs (IsNoetherianRing K))
  have : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian (P ↘ Spec (.of K))
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian j
  let T : Y.Modules := SheafOfModules.unit Y.ringCatSheaf
  have : SheafOfModules.IsCoherent T := Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent_unit Y
  let G := Stacks.AlgebraicGeometry.IdealPowerSmul.idealPowSmul I 1 T
  have : G.toSheafOfModules.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.IdealPowerSmul.isQuasicoherent_idealPowSmul I 1 _
  have : SheafOfModules.IsCoherent G.toSheafOfModules :=
    Stacks.AlgebraicGeometry.IdealPowerSmul.isCoherent_idealPowSmul I 1 _
  have : G.toSheafOfModules.IsFiniteType := SheafOfModules.IsCoherent.isFiniteType
  obtain ⟨e, 𝓔, h𝓔, f, hf, hn⟩ :=
    exists_epi_of_isFiniteLocallyFreeOfRank_of_le K j G.toSheafOfModules n
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree 𝓔 (e + 1)
  have : 𝓔.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree _
  refine ⟨e + 1, by omega, 𝓔, inferInstance, h𝓔, sectionOfHom (f ≫ G.ι),
    sectionOfHom_comp_proj _, ?_⟩
  refine Scheme.IdealSheafData.ext (funext fun U ↦ ?_)
  change (zeroLocus 𝓔 (sectionOfHom (f ≫ G.ι))).ideal U = I.ideal U
  rw [ideal_zeroLocus_sectionOfHom]
  have hsurj := AlgebraicGeometry.surjective_app_of_epi_of_isAffineOpen f U.2
  have hG := Stacks.AlgebraicGeometry.IdealPowerSmul.obj_idealPowSmul I 1 T U
  rw [pow_one] at hG
  have hmem : ∀ a : Γ(Y, U.1), a ∈ I.ideal U ↔
      (show Γ(T, U.1) from a) ∈ (I.ideal U • (⊤ : Submodule Γ(Y, U.1) Γ(T, U.1))) := fun a ↦
    ⟨fun ha ↦ by
      have := Submodule.smul_mem_smul ha
        (Submodule.mem_top (x := (show Γ(T, U.1) from (1 : Γ(Y, U.1)))))
      convert this using 1
      exact (mul_one a).symm,
    fun ha ↦ Submodule.smul_induction_on
      (p := fun x : Γ(T, U.1) ↦ (show Γ(Y, U.1) from x) ∈ I.ideal U) ha
      (fun r hr m _ ↦ (I.ideal U).mul_mem_right _ hr) fun x y hx hy ↦ (I.ideal U).add_mem hx hy⟩
  refine le_antisymm (Ideal.span_le.2 ?_) fun a ha ↦ Ideal.subset_span ?_
  · rintro _ ⟨x, rfl⟩
    exact (hmem _).2 (hG ▸ (f.app U.1 x).2)
  · obtain ⟨x, hx⟩ := hsurj ⟨a, hG ▸ (hmem a).1 ha⟩
    exact ⟨x, congrArg Subtype.val hx⟩

/-- **A closed imbedding is cut out by a section of a bundle of rank `≥ n`.** -/
theorem exists_section_zeroLocus_eq_ker_of_le (K : Type) [Field K] {X Y P : Scheme.{0}}
    [P.Over (Spec (.of K))] [IsSmoothVariety K (P ↘ Spec (.of K))]
    (j : Y ⟶ P) [IsClosedImmersion j] (i : X ⟶ Y) (n : ℕ) :
    ∃ (r : ℕ) (_ : n ≤ r) (E : Y.Modules) (_ : E.IsQuasicoherent)
      (_ : SheafOfModules.IsFiniteLocallyFreeOfRank.{0, 0, 0} E r) (σ : Y ⟶ totalSpace E),
      σ ≫ proj E = 𝟙 Y ∧ zeroLocus E σ = i.ker :=
  exists_section_zeroLocus_eq_of_le K j i.ker n

end MMP.Modules
