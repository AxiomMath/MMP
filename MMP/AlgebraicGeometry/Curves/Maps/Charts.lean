/-!
# Charts for maps from a curve

The chart data of a morphism `f : C ⟶ U` of `k`-schemes used by the Čech deformation theory of
maps from a curve (`MMP.Fourfold.CurveChartDeformations.ChartSystem`): a finite cover of `C` by
affine opens `U_i` with `f(U_i)` inside affine opens `W_i` of `U`, the rings of sections of the
intersections `U_s`, `W_s` as charts (smooth with étale restrictions when `U` is smooth and
separated), the comparison of the Čech cohomology of `𝒪_C` on the cover with sheaf cohomology, the
coordinates `σ_m / σ_{l i}` of a family of sections of an invertible sheaf with their transition
functions, and flat base change of the global sections of an invertible sheaf in these charts.

## Main definitions

* `MMP.Fourfold.CurveMapCharts.sectionsCechPresheaf`: the presheaf `s ↦ Γ(G, ⋂_{i ∈ s} U_i)` of a
  module `G` on the nerve of a cover `U`, with `k`-module structure through `X ⟶ Spec k`.
* `MMP.Fourfold.CurveMapCharts.cechH1LinearEquiv`: Čech `H¹` of this presheaf is the first
  homology of the alternating Čech complex (Stacks 01FH).
* `MMP.Fourfold.CurveMapCharts.cechH1EquivCohomologyOverField`: on an affine cover with affine
  finite intersections, Čech `H¹` is `H¹(X, G)`, `k`-linearly (Stacks 01XD).
* `MMP.Fourfold.CurveMapCharts.ChartCover`, `MMP.Fourfold.CurveMapCharts.curveCharts`: an affine
  chart cover of `f` and its curve charts `Γ(W_s, 𝒪_U) → Γ(U_s, 𝒪_C)`, with the ideals of a finite
  set of points of `C`.
* `MMP.Fourfold.CurveMapCharts.ringPresheafH1Equiv`: the Čech `H¹` of the source charts is
  `H¹(C, 𝒪_C)`.
* `MMP.Fourfold.CurveMapCharts.chartCoord`, `MMP.Fourfold.CurveMapCharts.chartTrans`,
  `MMP.Fourfold.CurveMapCharts.chartLocal`: the coordinates `σ_m/σ_{l i}`, the transition functions
  `σ_{l j}/σ_{l i}` and the local expressions `t/σ_{l i}` of a family of sections `σ`.

## Main results

* `MMP.Fourfold.CurveMapCharts.exists_affine_chartCover`: adapted finite affine chart covers exist
  on a quasi-compact source.
* `MMP.Fourfold.CurveMapCharts.formallySmooth_sections`, `MMP.Fourfold.CurveMapCharts.etale_res`:
  the charts of a smooth scheme are smooth, restriction between affine opens is étale.
* `MMP.Fourfold.CurveMapCharts.exists_chartLocal_eq`: local expressions transforming by the
  transition functions glue to a global section.
* `MMP.Fourfold.CurveMapCharts.exists_glue_curveCharts`,
  `MMP.Fourfold.CurveMapCharts.glue_unique_curveCharts`: flat base change
  `H⁰(C_B, L_B) = H⁰(C, L) ⊗ B` in charts, for any `k`-algebra `B`.

## Implementation notes

The Čech complex of Stacks (`CechCochains`) indexes cochains by all tuples; the presheaf on the
nerve (`CechPresheaf`) by finite subsets of the index type. They are identified in degrees
`0, 1, 2` through the equalities `⨅ k, U (i k) = ⨅ k ∈ {i₀, i₁}, U k`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u v

namespace MMP.Fourfold.CurveMapCharts

variable {k : Type u} [CommRing k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) {ι : Type u}
  [DecidableEq ι] [LinearOrder ι] (U : ι → X.Opens) (G : X.Modules)

/-- The presheaf of sections of `G` on the nerve of the cover `U`: over `U_s` the `k`-module
`Γ(G, ⋂_{i ∈ s} U_i)`. -/
def sectionsCechPresheaf : CechPresheaf.{u} k ι where
  obj s := Γ(G, s.inf U)
  addCommGroup _ := inferInstance
  module s := Stacks.Cech.sectionsModule f G _
  res h := Stacks.Cech.sectionsRestrₗ f G (Finset.inf_mono h)
  res_refl h x := Stacks.Cech.restr_self _ _ x
  res_comp h₁ h₂ x := CechCochains.restr_restr _ _ _ x

section Opens

/-- The Čech intersection `⋂ₖ U (![i, j] k)` is the infimum of `U` over `{i, j}`. -/
theorem inter_pair (U : ι → X.Opens) (i j : ι) :
    CechCochains.inter U ![i, j] = ({i, j} : Finset ι).inf U := by
  refine le_antisymm (Finset.le_inf fun l hl => ?_) ?_
  · simp only [Finset.mem_insert, Finset.mem_singleton] at hl
    rcases hl with rfl | rfl
    · exact iInf_le_of_le 0 le_rfl
    · exact iInf_le_of_le 1 le_rfl
  · refine le_iInf fun k => ?_
    fin_cases k
    · exact Finset.inf_le (by simp)
    · exact Finset.inf_le (by simp)

/-- The Čech intersection `⋂ₖ U (![i] k)` is the infimum of `U` over `{i}`. -/
theorem inter_single (U : ι → X.Opens) (i : ι) :
    CechCochains.inter U ![i] = ({i} : Finset ι).inf U := by
  ext x
  simp [CechCochains.inter]

/-- The Čech intersection of a pair `t : Fin 2 → ι` is the infimum of `U` over `{t 0, t 1}`. -/
theorem inter_pair_eq (U : ι → X.Opens) (t : Fin 2 → ι) :
    CechCochains.inter U t = ({t 0, t 1} : Finset ι).inf U := by
  have : t = ![t 0, t 1] := by ext k; fin_cases k <;> rfl
  rw [this]
  exact inter_pair U _ _

end Opens

section Maps

/-- From a Čech `1`-cochain of the presheaf on the nerve to a degree-`1` cochain of
Stacks 01FH (all tuples `Fin 2 → ι`). -/
def toCochain1 :
    letI := Stacks.Cech.cochainModule f U G 1
    (sectionsCechPresheaf f U G).C1 →ₗ[k] CechCochains.Cochain U G.presheaf 1 :=
  letI := Stacks.Cech.cochainModule f U G 1
  letI : ∀ W : X.Opens, Module k Γ(G, W) := fun W => Stacks.Cech.sectionsModule f G W
  { toFun := fun b i =>
      Stacks.Cech.sectionsRestrₗ f G (V := ({i 0, i 1} : Finset ι).inf U)
        (W := CechCochains.inter U i) (inter_pair_eq U i).le (b (i 0) (i 1))
    map_add' := fun b b' => by
      funext i
      exact map_add (Stacks.Cech.sectionsRestrₗ f G (V := ({i 0, i 1} : Finset ι).inf U)
        (W := CechCochains.inter U i) (inter_pair_eq U i).le) _ _
    map_smul' := fun c b => by
      funext i
      exact map_smul (Stacks.Cech.sectionsRestrₗ f G (V := ({i 0, i 1} : Finset ι).inf U)
        (W := CechCochains.inter U i) (inter_pair_eq U i).le) c _ }

/-- The value of `toCochain1 f U G b` at `i` is the restriction of `b (i 0) (i 1)`. -/
theorem toCochain1_apply (b : (sectionsCechPresheaf f U G).C1) (i : Fin 2 → ι) :
    toCochain1 f U G b i = CechCochains.restr G.presheaf (V := ({i 0, i 1} : Finset ι).inf U)
      (W := CechCochains.inter U i) (inter_pair_eq U i).le (b (i 0) (i 1)) := rfl

/-- From a degree-`1` cochain of Stacks 01FH to a Čech `1`-cochain of the presheaf on the
nerve. -/
def fromCochain1 :
    letI := Stacks.Cech.cochainModule f U G 1
    CechCochains.Cochain U G.presheaf 1 →ₗ[k] (sectionsCechPresheaf f U G).C1 :=
  letI := Stacks.Cech.cochainModule f U G 1
  letI : ∀ W : X.Opens, Module k Γ(G, W) := fun W => Stacks.Cech.sectionsModule f G W
  { toFun := fun a i j =>
      Stacks.Cech.sectionsRestrₗ f G (V := CechCochains.inter U ![i, j])
        (W := ({i, j} : Finset ι).inf U) (inter_pair U i j).ge (a ![i, j])
    map_add' := fun a a' => by
      funext i j
      exact map_add (Stacks.Cech.sectionsRestrₗ f G (V := CechCochains.inter U ![i, j])
        (W := ({i, j} : Finset ι).inf U) (inter_pair U i j).ge) _ _
    map_smul' := fun c a => by
      funext i j
      exact map_smul (Stacks.Cech.sectionsRestrₗ f G (V := CechCochains.inter U ![i, j])
        (W := ({i, j} : Finset ι).inf U) (inter_pair U i j).ge) c _ }

/-- The value of `fromCochain1 f U G a` at `i, j` is the restriction of `a ![i, j]`. -/
theorem fromCochain1_apply (a : CechCochains.Cochain U G.presheaf 1) (i j : ι) :
    fromCochain1 f U G a i j = CechCochains.restr G.presheaf
      (V := CechCochains.inter U ![i, j]) (W := ({i, j} : Finset ι).inf U)
      (inter_pair U i j).ge (a ![i, j]) := rfl

/-- The restriction maps of `sectionsCechPresheaf f U G` are the restrictions of sections of
`G`. -/
theorem sectionsCechPresheaf_res {s t : Finset ι} (h : s ⊆ t)
    (x : (sectionsCechPresheaf f U G).obj s) :
    (sectionsCechPresheaf f U G).res h x =
      CechCochains.restr G.presheaf (V := s.inf U) (W := t.inf U) (Finset.inf_mono h) x := rfl

/-- The degree-`0` cochain attached to a `0`-cochain of the presheaf on the nerve. -/
def toCochain0 (c : (sectionsCechPresheaf f U G).C0) : CechCochains.Cochain U G.presheaf 0 :=
  fun t => CechCochains.restr G.presheaf (V := ({t 0} : Finset ι).inf U)
    (W := CechCochains.inter U t) (by simp [CechCochains.inter]) (c (t 0))

/-- The `0`-cochain of the presheaf on the nerve attached to a degree-`0` cochain. -/
def fromCochain0 (a : CechCochains.Cochain U G.presheaf 0) : (sectionsCechPresheaf f U G).C0 :=
  fun i => CechCochains.restr G.presheaf (V := CechCochains.inter U ![i])
    (W := ({i} : Finset ι).inf U) (by simp [CechCochains.inter]) (a ![i])

/-- `toCochain1` sends the Čech differential `d0 c` to the differential of
`toCochain0 f U G c`. -/
theorem toCochain1_d0 (c : (sectionsCechPresheaf f U G).C0) :
    toCochain1 f U G ((sectionsCechPresheaf f U G).d0 c) =
      CechCochains.cechD U G.presheaf 0 (toCochain0 f U G c) := by
  funext i
  rw [CechCochains.cechD_apply, Fin.sum_univ_two]
  simp only [toCochain1_apply, CechPresheaf.d0, LinearMap.coe_mk, AddHom.coe_mk,
    sectionsCechPresheaf_res, toCochain0]
  have e0 : Fin.succAbove (0 : Fin 2) (0 : Fin 1) = 1 := rfl
  have e1 : Fin.succAbove (1 : Fin 2) (0 : Fin 1) = 0 := rfl
  simp only [Function.comp_apply, e0, e1, map_sub, CechCochains.restr_restr,
    Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_smul, one_smul, ← sub_eq_add_neg]
  erw [map_sub, CechCochains.restr_restr, CechCochains.restr_restr, CechCochains.restr_restr,
    CechCochains.restr_restr]
  rfl

/-- The restriction of the value of a cochain at `t` equals the restriction of its value at an
equal tuple `t'`. -/
theorem restr_cochain_eq {p : ℕ} (a : CechCochains.Cochain U G.presheaf p) {t t' : Fin (p + 1) → ι}
    (h : t = t') {V : X.Opens} (h₁ : V ≤ CechCochains.inter U t) :
    CechCochains.restr G.presheaf h₁ (a t) =
      CechCochains.restr G.presheaf (show V ≤ CechCochains.inter U t' from h ▸ h₁) (a t') := by
  subst h; rfl

/-- `fromCochain1` sends the differential of a degree-`0` cochain `a` to
`d0 (fromCochain0 f U G a)`. -/
theorem fromCochain1_cechD (a : CechCochains.Cochain U G.presheaf 0) :
    fromCochain1 f U G (CechCochains.cechD U G.presheaf 0 a) =
      (sectionsCechPresheaf f U G).d0 (fromCochain0 f U G a) := by
  funext i j
  rw [fromCochain1_apply, CechCochains.cechD_apply, Fin.sum_univ_two]
  simp only [CechPresheaf.d0, LinearMap.coe_mk, AddHom.coe_mk,
    sectionsCechPresheaf_res, fromCochain0]
  have e0 : (![i, j] : Fin 2 → ι) ∘ Fin.succAbove 0 = ![j] := by
    funext k; fin_cases k; rfl
  have e1 : (![i, j] : Fin 2 → ι) ∘ Fin.succAbove 1 = ![i] := by
    funext k; fin_cases k; rfl
  simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_smul, neg_smul, ← sub_eq_add_neg,
    map_sub, CechCochains.restr_restr]
  rw [restr_cochain_eq U G a e0, restr_cochain_eq U G a e1]
  rfl

/-- `fromCochain1 f U G` is a left inverse of `toCochain1 f U G`. -/
theorem fromCochain1_toCochain1 (b : (sectionsCechPresheaf f U G).C1) :
    fromCochain1 f U G (toCochain1 f U G b) = b := by
  funext i j
  exact (CechCochains.restr_restr G.presheaf _ _ _).trans (Stacks.Cech.restr_self _ _ _)

/-- `fromCochain1 f U G` is a right inverse of `toCochain1 f U G`. -/
theorem toCochain1_fromCochain1 (a : CechCochains.Cochain U G.presheaf 1) :
    toCochain1 f U G (fromCochain1 f U G a) = a := by
  funext i
  have h : (![i 0, i 1] : Fin 2 → ι) = i := by funext k; fin_cases k <;> rfl
  exact ((CechCochains.restr_restr G.presheaf _ _ _).trans
    (restr_cochain_eq U G a h _)).trans (Stacks.Cech.restr_self _ _ _)

/-- The Čech intersection of `![i, j, l]` is contained in the infimum of `U` over `{i, j, l}`. -/
theorem inter_triple_le (i j l : ι) :
    CechCochains.inter U ![i, j, l] ≤ ({i, j, l} : Finset ι).inf U := by
  refine Finset.le_inf fun m hm => ?_
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl | rfl
  · exact iInf_le_of_le 0 le_rfl
  · exact iInf_le_of_le 1 le_rfl
  · exact iInf_le_of_le 2 le_rfl

/-- The Čech differential of `toCochain1 f U G b` at `![i, j, l]` is the restriction of
`b j l - b i l + b i j`. -/
theorem cechD_toCochain1 (b : (sectionsCechPresheaf f U G).C1) (i j l : ι) :
    CechCochains.cechD U G.presheaf 1 (toCochain1 f U G b) ![i, j, l] =
      CechCochains.restr G.presheaf (V := ({i, j, l} : Finset ι).inf U)
        (W := CechCochains.inter U ![i, j, l]) (inter_triple_le U i j l)
        ((sectionsCechPresheaf f U G).res (CechPresheaf.pair_sub_triple₂₃ i j l) (b j l) -
          (sectionsCechPresheaf f U G).res (CechPresheaf.pair_sub_triple₁₃ i j l) (b i l) +
          (sectionsCechPresheaf f U G).res (CechPresheaf.pair_sub_triple₁₂ i j l) (b i j)) := by
  rw [CechCochains.cechD_apply, Fin.sum_univ_three]
  simp only [toCochain1_apply, sectionsCechPresheaf_res, Fin.val_zero, Fin.val_one,
    Fin.val_two, pow_zero, pow_one, one_smul, map_add, map_sub, CechCochains.restr_restr,
    neg_one_sq, neg_smul, ← sub_eq_add_neg]
  erw [map_add, map_sub, CechCochains.restr_restr, CechCochains.restr_restr,
    CechCochains.restr_restr]
  erw [CechCochains.restr_restr, CechCochains.restr_restr, CechCochains.restr_restr]
  rfl

/-- The Čech intersection of `![x, y, z]` is contained in that of `![y, z]`. -/
theorem inter_le_yz (x y z : ι) :
    CechCochains.inter U ![x, y, z] ≤ CechCochains.inter U ![y, z] :=
  le_iInf fun m => by
    fin_cases m
    exacts [iInf_le_of_le 1 le_rfl, iInf_le_of_le 2 le_rfl]

/-- The Čech intersection of `![x, y, z]` is contained in that of `![x, z]`. -/
theorem inter_le_xz (x y z : ι) :
    CechCochains.inter U ![x, y, z] ≤ CechCochains.inter U ![x, z] :=
  le_iInf fun m => by
    fin_cases m
    exacts [iInf_le_of_le 0 le_rfl, iInf_le_of_le 2 le_rfl]

/-- The Čech intersection of `![x, y, z]` is contained in that of `![x, y]`. -/
theorem inter_le_xy (x y z : ι) :
    CechCochains.inter U ![x, y, z] ≤ CechCochains.inter U ![x, y] :=
  le_iInf fun m => by
    fin_cases m
    exacts [iInf_le_of_le 0 le_rfl, iInf_le_of_le 1 le_rfl]

/-- Restriction of sections of `G` along an inclusion `W ≤ V` with `V = W` is injective. -/
theorem restr_injective_of_eq {V W : X.Opens} (hV : V = W) (h : W ≤ V)
    {x y : ↑(G.presheaf.obj (op V))}
    (hxy : CechCochains.restr G.presheaf h x = CechCochains.restr G.presheaf h y) : x = y := by
  have h' := congrArg (CechCochains.restr G.presheaf hV.le) hxy
  rwa [CechCochains.restr_restr, CechCochains.restr_restr, Stacks.Cech.restr_self,
    Stacks.Cech.restr_self] at h'

/-- The Čech differential of a degree-`1` cochain `a` at `![x, y, z]` is
`a(y, z) - a(x, z) + a(x, y)`, restricted to the triple intersection. -/
theorem cechD1_apply (a : CechCochains.Cochain U G.presheaf 1) (x y z : ι) :
    CechCochains.cechD U G.presheaf 1 a ![x, y, z] =
      CechCochains.restr G.presheaf (inter_le_yz U x y z) (a ![y, z]) -
        CechCochains.restr G.presheaf (inter_le_xz U x y z) (a ![x, z]) +
        CechCochains.restr G.presheaf (inter_le_xy U x y z) (a ![x, y]) := by
  rw [CechCochains.cechD_apply, Fin.sum_univ_three]
  have e0 : (![x, y, z] : Fin 3 → ι) ∘ Fin.succAbove 0 = ![y, z] := by
    funext m; fin_cases m <;> rfl
  have e1 : (![x, y, z] : Fin 3 → ι) ∘ Fin.succAbove 1 = ![x, z] := by
    funext m; fin_cases m <;> rfl
  have e2 : (![x, y, z] : Fin 3 → ι) ∘ Fin.succAbove 2 = ![x, y] := by
    funext m; fin_cases m <;> rfl
  simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one, one_smul, neg_one_sq,
    neg_smul, ← sub_eq_add_neg]
  rw [restr_cochain_eq U G a e0, restr_cochain_eq U G a e1, restr_cochain_eq U G a e2]

/-- The permutation isomorphism `CechCochains.permIso` is a restriction of sections. -/
theorem permIso_eq_restr {p : ℕ} (i : Fin (p + 1) → ι) (σ : Equiv.Perm (Fin (p + 1)))
    (h : CechCochains.inter U (i ∘ σ) ≤ CechCochains.inter U i)
    (x : ↑(G.presheaf.obj (op (CechCochains.inter U i)))) :
    CechCochains.permIso U G.presheaf i σ x = CechCochains.restr G.presheaf h x := by
  unfold CechCochains.permIso CechCochains.restr
  congr 2

/-- The Čech intersection of a permuted tuple `i ∘ σ` is contained in that of `i`. -/
theorem inter_perm_le {p : ℕ} (i : Fin (p + 1) → ι) (σ : Equiv.Perm (Fin (p + 1))) :
    CechCochains.inter U (i ∘ σ) ≤ CechCochains.inter U i :=
  le_iInf fun m => iInf_le_of_le (σ.symm m) (by simp)

/-- The Čech intersection of `![y, x]` is contained in that of `![x, y]`. -/
theorem inter_swap_le (x y : ι) :
    CechCochains.inter U ![y, x] ≤ CechCochains.inter U ![x, y] := by
  refine le_iInf fun m => ?_
  fin_cases m
  exacts [iInf_le_of_le 1 le_rfl, iInf_le_of_le 0 le_rfl]

/-- The Čech intersection of `![x, y, x]` is that of `![x, y]`. -/
theorem inter_eq_vec3 (x y : ι) :
    CechCochains.inter U ![x, y, x] = CechCochains.inter U ![x, y] := by
  refine le_antisymm (inter_le_xy U x y x) (le_iInf fun m => ?_)
  fin_cases m
  exacts [iInf_le_of_le 0 le_rfl, iInf_le_of_le 1 le_rfl, iInf_le_of_le 0 le_rfl]

/-- A degree-`1` Čech cocycle is alternating. -/
theorem isAlternating_of_cechD_eq_zero (a : CechCochains.Cochain U G.presheaf 1)
    (h : CechCochains.cechD U G.presheaf 1 a = 0) :
    CechCochains.IsAlternating U G.presheaf a := by
  have hd : ∀ x : ι, a ![x, x] = 0 := by
    intro x
    have := congrFun h ![x, x, x]
    rw [cechD1_apply] at this
    simp only [sub_add_cancel, Pi.zero_apply] at this
    exact restr_injective_of_eq G (inter_eq_vec3 U x x).symm (inter_le_yz U x x x)
      (this.trans (map_zero _).symm)
  have hs : ∀ x y : ι, a ![y, x] =
      -CechCochains.restr G.presheaf (inter_swap_le U x y) (a ![x, y]) := by
    intro x y
    have := congrFun h ![x, y, x]
    rw [cechD1_apply, hd x, map_zero, sub_zero] at this
    have hV : CechCochains.inter U ![y, x] = CechCochains.inter U ![x, y, x] :=
      le_antisymm (le_iInf fun m => by
        fin_cases m
        exacts [iInf_le_of_le 1 le_rfl, iInf_le_of_le 0 le_rfl, iInf_le_of_le 1 le_rfl])
        (inter_le_yz U x y x)
    refine restr_injective_of_eq G hV (inter_le_yz U x y x) ?_
    rw [map_neg, CechCochains.restr_restr]
    exact eq_neg_of_add_eq_zero_left (by simpa using this)
  have hvec : ∀ i : Fin 2 → ι, i = ![i 0, i 1] := fun i => by
    funext m
    fin_cases m <;> rfl
  have hswap : ∀ x y m : Fin 2, x ≠ y → Equiv.swap x y m = ![1, 0] m := by decide
  refine ⟨fun i hi => ?_, fun i x y hxy => ?_⟩
  · have h01 : i 0 = i 1 := by
      by_contra hne
      apply hi
      intro m n hmn
      fin_cases m <;> fin_cases n <;>
        first | rfl | exact absurd hmn hne | exact absurd hmn.symm hne
    have : i = ![i 0, i 0] := by
      funext m
      fin_cases m
      · rfl
      · exact h01.symm
    rw [this]
    exact hd _
  · have hsw : i ∘ ⇑(Equiv.swap x y) = ![i 1, i 0] := by
      funext m
      simp only [Function.comp_apply, hswap x y m hxy]
      fin_cases m <;> rfl
    rw [permIso_eq_restr U G i _ (inter_perm_le U i _),
      restr_cochain_eq U G a (hvec i) (inter_perm_le U i _)]
    have k1 := restr_cochain_eq U G a hsw (le_refl (CechCochains.inter U (i ∘ ⇑(Equiv.swap x y))))
    rw [Stacks.Cech.restr_self] at k1
    rw [k1, hs (i 0) (i 1), map_neg, CechCochains.restr_restr]

/-- The infimum of `U` over `{i, j, l}` is contained in the Čech intersection of `![i, j, l]`. -/
theorem triple_inf_le (i j l : ι) :
    ({i, j, l} : Finset ι).inf U ≤ CechCochains.inter U ![i, j, l] := by
  refine le_iInf fun m => ?_
  fin_cases m <;> exact Finset.inf_le (by simp)

/-- A `1`-cochain of the presheaf on the nerve is a cocycle if and only if its image under
`toCochain1` has vanishing Čech differential. -/
theorem isCocycle_iff (b : (sectionsCechPresheaf f U G).C1) :
    (sectionsCechPresheaf f U G).IsCocycle b ↔
      CechCochains.cechD U G.presheaf 1 (toCochain1 f U G b) = 0 := by
  constructor
  · intro hb
    funext t
    have ht : t = ![t 0, t 1, t 2] := by
      funext m
      fin_cases m <;> rfl
    rw [ht, cechD_toCochain1, hb (t 0) (t 1) (t 2)]
    exact map_zero _
  · intro hb i j l
    have := congrFun hb ![i, j, l]
    rw [cechD_toCochain1] at this
    exact restr_injective_of_eq G
      (le_antisymm (inter_triple_le U i j l) (triple_inf_le U i j l)).symm
      (inter_triple_le U i j l) (this.trans (map_zero _).symm)

end Maps

section Assembly

/-- The segment `C⁰ → C¹ → C²` of the alternating Čech complex around degree `1`. -/
abbrev altSegment : ShortComplex (ModuleCat.{u} k) :=
  (Stacks.Cech.alternatingCechModuleComplex f U G).sc' 0 1 2

/-- The second map of `altSegment f U G` is the Čech differential in degree `1`. -/
theorem altSegment_g_apply (x : (altSegment f U G).X₂) :
    ((altSegment f U G).g.hom x).1 = CechCochains.cechD U G.presheaf 1 x.1 := rfl

/-- The first map of `altSegment f U G` is the Čech differential in degree `0`. -/
theorem altSegment_f_apply (x : (altSegment f U G).X₁) :
    ((altSegment f U G).f.hom x).1 = CechCochains.cechD U G.presheaf 0 x.1 := rfl

/-- An alternating `1`-cochain lies in the kernel of `altSegment f U G` if and only if its Čech
differential vanishes. -/
theorem mem_ker_altSegment_iff (x : (altSegment f U G).X₂) :
    x ∈ LinearMap.ker (altSegment f U G).g.hom ↔ CechCochains.cechD U G.presheaf 1 x.1 = 0 := by
  rw [LinearMap.mem_ker]
  exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩

/-- The Čech `1`-cocycles of the presheaf on the nerve are the `1`-cocycles of the
alternating Čech complex. -/
def cocycleEquiv :
    (sectionsCechPresheaf f U G).Z1 ≃ₗ[k] LinearMap.ker (altSegment f U G).g.hom where
  toFun b := ⟨(⟨toCochain1 f U G b.1, isAlternating_of_cechD_eq_zero U G _
      ((isCocycle_iff f U G b.1).1 b.2)⟩ : (altSegment f U G).X₂),
    (mem_ker_altSegment_iff f U G _).2 ((isCocycle_iff f U G b.1).1 b.2)⟩
  map_add' b b' := Subtype.ext (Subtype.ext (map_add (toCochain1 f U G) b.1 b'.1))
  map_smul' c b := Subtype.ext (Subtype.ext (by
    letI := Stacks.Cech.cochainModule f U G 1
    exact map_smul (toCochain1 f U G) c b.1))
  invFun a := ⟨fromCochain1 f U G a.1.1, (isCocycle_iff f U G _).2 (by
    rw [toCochain1_fromCochain1]; exact (mem_ker_altSegment_iff f U G a.1).1 a.2)⟩
  left_inv b := Subtype.ext (fromCochain1_toCochain1 f U G b.1)
  right_inv a := Subtype.ext (Subtype.ext (toCochain1_fromCochain1 f U G a.1.1))

/-- Every degree-`0` Čech cochain is alternating. -/
theorem isAlternating_zero (a : CechCochains.Cochain U G.presheaf 0) :
    CechCochains.IsAlternating U G.presheaf a := by
  refine ⟨fun i hi => absurd (fun m n _ => Fin.ext (by omega)) hi, fun i x y hxy => ?_⟩
  exact absurd (Fin.ext (by omega)) hxy

/-- `cocycleEquiv f U G` sends the Čech `1`-coboundaries of the presheaf on the nerve onto the
boundaries of the alternating Čech complex. -/
theorem map_coboundaries_eq :
    Submodule.map (cocycleEquiv f U G).toLinearMap (sectionsCechPresheaf f U G).B1 =
      LinearMap.range (altSegment f U G).moduleCatToCycles := by
  ext z
  constructor
  · rintro ⟨b, hb, rfl⟩
    obtain ⟨c, hc⟩ := hb
    refine ⟨⟨toCochain0 f U G c, isAlternating_zero U G _⟩, Subtype.ext (Subtype.ext ?_)⟩
    change CechCochains.cechD U G.presheaf 0 (toCochain0 f U G c) = toCochain1 f U G b.1
    rw [← toCochain1_d0, hc]
    rfl
  · rintro ⟨x, rfl⟩
    refine ⟨(cocycleEquiv f U G).symm ((altSegment f U G).moduleCatToCycles x), ?_,
      (cocycleEquiv f U G).apply_symm_apply _⟩
    refine ⟨fromCochain0 f U G x.1, ?_⟩
    change (sectionsCechPresheaf f U G).d0 (fromCochain0 f U G x.1) =
      fromCochain1 f U G (CechCochains.cechD U G.presheaf 0 x.1)
    rw [fromCochain1_cechD]

/-- **The Čech `H¹` of the sections presheaf on the nerve is the first homology of the alternating
Čech complex** of Stacks 01FH, `k`-linearly. -/
def cechH1LinearEquiv :
    (sectionsCechPresheaf f U G).H1 ≃ₗ[k]
      (Stacks.Cech.alternatingCechModuleComplex f U G).homology 1 :=
  (Submodule.Quotient.equiv _ _ (cocycleEquiv f U G) (map_coboundaries_eq f U G)).trans
    ((altSegment f U G).moduleCatLeftHomologyData.homologyIso.symm.toLinearEquiv.trans
      (((Stacks.Cech.alternatingCechModuleComplex f U G).homologyIsoSc' 0 1 2
        (by simp) (by simp)).symm.toLinearEquiv))

/-- **Čech `H¹` on a finite affine cover is the derived-functor `H¹`** (Stacks 01XD).  For a
quasi-coherent module `G` on a scheme `X` over `Spec k`, a cover `U` of `X` by affine opens with
affine finite intersections (automatic for `X` separated, `Stacks.Cech.inter_isAffineOpen`), the
Čech group `Ȟ¹(U, G)` of the presheaf `s ↦ Γ(G, U_s)` is, additively, the cohomology group
`H¹(X, G) = Hgroup X.ringCatSheaf ⊤ 1 G`. -/
def cechH1EquivHgroup (hU : (⊤ : X.Opens) = ⨆ i, U i)
    (haff : ∀ (r : ℕ) (s : Fin (r + 1) → ι), IsAffineOpen (⨅ m, U (s m)))
    [G.IsQuasicoherent] :
    (sectionsCechPresheaf f U G).H1 ≃+ Hgroup X.ringCatSheaf ⊤ 1 G :=
  (cechH1LinearEquiv f U G).toAddEquiv.trans
    ((Stacks.Cech.hgroupIsoAlternatingCechModuleHomology f U hU haff G 1).symm
      |>.addCommGroupIsoToAddEquiv)

end Assembly

section Scalar

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) {ι : Type u}
  [DecidableEq ι] [LinearOrder ι] (U : ι → X.Opens) (G : X.Modules)

/-- The global ring map `k → Γ(X, ⊤)` of `f` sends `c` to `baseScalarSection k f c`. -/
theorem globalRingHom_eq_baseScalarSection (c : k) :
    (Stacks.Cech.globalRingHom f).hom c = baseScalarSection k f c := by
  unfold Stacks.Cech.globalRingHom baseScalarSection
  have e : f.appTop = f.appLE ⊤ ⊤ (by simp) := Scheme.Hom.app_eq_appLE f
  rw [e]
  rfl

variable (hU : (⊤ : X.Opens) = ⨆ i, U i)
  (haff : ∀ (r : ℕ) (s : Fin (r + 1) → ι), IsAffineOpen (⨅ m, U (s m))) [G.IsQuasicoherent]

/-- **The `k`-linear form of `cechH1EquivHgroup`**: Čech `H¹` of the sections presheaf on an
affine cover with affine finite intersections is `H¹(X, G) = cohomologyOverField k f G 1`,
`k`-linearly. -/
def cechH1EquivCohomologyOverField :
    (sectionsCechPresheaf f U G).H1 ≃ₗ[k] cohomologyOverField k f G 1 where
  toFun z := (cohomologyOverFieldAddEquivHgroup k f G 1).symm (cechH1EquivHgroup f U G hU haff z)
  map_add' x y := by simp
  map_smul' a z := by
    have hΦ : ∀ y : cohomologyOverField k f G 1, cohomologyOverFieldAddEquivHgroup k f G 1
        (a • y) = ((Hfunctor X.ringCatSheaf ⊤ 1).map (globalSmul (baseScalarSection k f a) G)).hom
          (cohomologyOverFieldAddEquivHgroup k f G 1 y) := fun y => by
      rw [← cohomologyOverFieldMap_globalSmul k f a G 1 y, cohomologyOverFieldMap_apply]
      exact rightDerivedEvaluationForgetIso_naturality_apply _ _ _
    have hE : cechH1EquivHgroup f U G hU haff (a • z) =
        ((Hfunctor X.ringCatSheaf ⊤ 1).map (globalSmul (baseScalarSection k f a) G)).hom
          (cechH1EquivHgroup f U G hU haff z) := by
      rw [← globalRingHom_eq_baseScalarSection]
      have hl : cechH1LinearEquiv f U G (a • z) = a • cechH1LinearEquiv f U G z :=
        map_smul _ _ _
      have := Stacks.Cech.hgroupIsoAlternatingCechModuleHomology_inv_smul f U hU haff G a 1
        (cechH1LinearEquiv f U G z)
      exact (congrArg (fun w =>
        (Stacks.Cech.hgroupIsoAlternatingCechModuleHomology f U hU haff G 1).inv w) hl).trans this
    change (cohomologyOverFieldAddEquivHgroup k f G 1).symm
        (cechH1EquivHgroup f U G hU haff (a • z)) =
      a • (cohomologyOverFieldAddEquivHgroup k f G 1).symm (cechH1EquivHgroup f U G hU haff z)
    rw [hE]
    apply (cohomologyOverFieldAddEquivHgroup k f G 1).injective
    rw [hΦ, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
  invFun y := (cechH1EquivHgroup f U G hU haff).symm (cohomologyOverFieldAddEquivHgroup k f G 1 y)
  left_inv z := by simp
  right_inv y := by simp

end Scalar

open MMP.Fourfold.CurveChartDeformations

section RingHomProps

/-- An étale ring map is formally étale. -/
theorem formallyEtale_of_etale {R S : Type*} [CommRing R] [CommRing S] {f : R →+* S}
    (hf : f.Etale) : f.FormallyEtale := by
  letI := f.toAlgebra
  haveI : Algebra.Etale R S := hf
  exact (inferInstance : Algebra.FormallyEtale R S)

end RingHomProps

section Sections

variable {k : Type u} [CommRing k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

/-- The `k`-algebra structure on the sections of `𝒪_X` over an open, through `X ⟶ Spec k`. -/
@[instance_reducible]
def sectionsAlgebra (W : X.Opens) : Algebra k Γ(X, W) :=
  (Stacks.Cech.baseRingHom sX W).hom.toAlgebra

/-- Restriction of sections as a map of `k`-algebras. -/
def resAlgHom {V W : X.Opens} (h : W ≤ V) :
    letI := sectionsAlgebra sX V
    letI := sectionsAlgebra sX W
    Γ(X, V) →ₐ[k] Γ(X, W) :=
  letI := sectionsAlgebra sX V
  letI := sectionsAlgebra sX W
  { toRingHom := (X.presheaf.map (homOfLE h).op).hom
    commutes' := fun r => Stacks.Cech.map_baseRingHom_apply sX (homOfLE h).op r }

/-- `resAlgHom sX h` is the restriction map of `𝒪_X`. -/
theorem resAlgHom_apply {V W : X.Opens} (h : W ≤ V) (x : Γ(X, V)) :
    resAlgHom sX h x = X.presheaf.map (homOfLE h).op x := rfl

/-- Restriction from an open to itself is the identity. -/
theorem resAlgHom_refl {V : X.Opens} (h : V ≤ V) (x : Γ(X, V)) : resAlgHom sX h x = x := by
  rw [resAlgHom_apply, show (homOfLE h).op = 𝟙 (op V) from Subsingleton.elim _ _,
    CategoryTheory.Functor.map_id]
  rfl

/-- Restriction along `W' ≤ W` after restriction along `W ≤ V` is restriction along `W' ≤ V`. -/
theorem resAlgHom_comp {V W W' : X.Opens} (h₁ : W ≤ V) (h₂ : W' ≤ W) (x : Γ(X, V)) :
    resAlgHom sX h₂ (resAlgHom sX h₁ x) = resAlgHom sX (h₂.trans h₁) x := by
  simp only [resAlgHom_apply]
  rw [← CategoryTheory.ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- Restriction between affine opens is étale. -/
theorem etale_res {V W : X.Opens} (hV : IsAffineOpen V) (hW : IsAffineOpen W) (h : W ≤ V) :
    (X.presheaf.map (homOfLE h).op).hom.Etale := by
  have e : W.ι ⁻¹ᵁ V = ⊤ := eq_top_iff.2 fun x _ => h x.2
  haveI : IsAffine W := hW
  have h1 := HasRingHomProperty.appLE @Etale W.ι (inferInstance : Etale W.ι)
    ⟨V, show V ∈ X.affineOpens from hV⟩
    ⟨⊤, isAffineOpen_top W⟩ e.ge
  rw [Scheme.Opens.ι_appLE] at h1
  have h3 := RingHom.Etale.stableUnderComposition _ _ h1
    (RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso W.topIso.hom))
  convert h3 using 1
  change (X.presheaf.map _).hom = (X.presheaf.map _ ≫ W.topIso.hom).hom
  congr 1
  rw [Scheme.Opens.topIso_hom]
  refine Eq.trans ?_ (X.presheaf.map_comp _ _)
  congr 1

end Sections

section Smooth

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

/-- The sections of `𝒪_X` over an affine open of a smooth `k`-scheme form a smooth `k`-algebra. -/
theorem formallySmooth_sections [Smooth sX] {W : X.Opens} (hW : IsAffineOpen W) :
    letI := sectionsAlgebra sX W
    Algebra.FormallySmooth k Γ(X, W) := by
  letI := sectionsAlgebra sX W
  have h1 := HasRingHomProperty.appLE @Smooth sX (inferInstance : Smooth sX)
    ⟨⊤, isAffineOpen_top _⟩ ⟨W, show W ∈ X.affineOpens from hW⟩ le_top
  have h2 : (algebraMap k Γ(X, W)) =
      (sX.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom := by
    change (Stacks.Cech.baseRingHom sX W).hom = _
    rw [Stacks.Cech.baseRingHom_eq_appLE sX W le_top]
    rfl
  have h3 : (algebraMap k Γ(X, W)).Smooth := by
    rw [h2]
    exact RingHom.Smooth.comp (RingHom.Smooth.of_bijective
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of k)).inv)) h1
  rw [RingHom.smooth_algebraMap] at h3
  infer_instance

end Smooth

section Cover

/-- A point lies in the infimum over `s` of a family of opens if and only if it lies in each member
indexed by `s`. -/
theorem mem_finset_inf_opens {α : Type*} [TopologicalSpace α] {ι : Type*} (U : ι → Opens α)
    (s : Finset ι) (x : α) : x ∈ s.inf U ↔ ∀ i ∈ s, x ∈ U i := by
  rw [← SetLike.mem_coe, Opens.coe_finset_inf, Finset.inf_eq_iInf]
  simp

/-- **A finite affine cover adapted to a morphism and to two families of opens.** If every point
`x` of a quasi-compact scheme `C` lies in some `A l` with `f x ∈ B l`, there are finitely many
affine opens `U_i` covering `C` and affine opens `W_i` of the target with `U_i ⊆ f⁻¹ W_i`,
`U_i ⊆ A (l i)` and `W_i ⊆ B (l i)`. -/
theorem exists_affine_chartCover {C U : Scheme.{u}} (f : C ⟶ U) [CompactSpace C] {κ : Type*}
    (A : κ → C.Opens) (B : κ → U.Opens) (hAB : ∀ x : C, ∃ l, x ∈ A l ∧ f.base x ∈ B l) :
    ∃ (r : ℕ) (l : Fin r → κ) (UC : Fin r → C.Opens) (WU : Fin r → U.Opens),
      (∀ i, IsAffineOpen (UC i)) ∧ (∀ i, IsAffineOpen (WU i)) ∧ (∀ i, UC i ≤ f ⁻¹ᵁ WU i) ∧
      (∀ i, UC i ≤ A (l i)) ∧ (∀ i, WU i ≤ B (l i)) ∧ (⊤ : C.Opens) = ⨆ i, UC i := by
  choose l hlA hlB using hAB
  choose W hWa hWx hWB using fun x : C => exists_isAffineOpen_mem_and_subset (hlB x)
  have hV : ∀ x : C, x ∈ f ⁻¹ᵁ W x ⊓ A (l x) := fun x => ⟨hWx x, hlA x⟩
  choose V hVa hVx hVsub using fun x : C => exists_isAffineOpen_mem_and_subset (hV x)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (V x : Set C))
    (fun x => (V x).isOpen) (fun x _ => Set.mem_iUnion.2 ⟨x, hVx x⟩)
  let e := t.equivFin
  refine ⟨t.card, fun i => l (e.symm i), fun i => V (e.symm i), fun i => W (e.symm i),
    fun i => hVa _, fun i => hWa _, fun i y hy => (hVsub _ hy).1, fun i y hy => (hVsub _ hy).2,
    fun i => hWB _, ?_⟩
  refine le_antisymm (fun y _ => ?_) le_top
  obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ y))
  exact Opens.mem_iSup.2 ⟨e ⟨x, hx⟩, by simpa using hyx⟩

end Cover

section CurveChartsOfCover

variable {k : Type u} [Field k] {C U : Scheme.{u}} (sC : C ⟶ Spec (.of k)) (sU : U ⟶ Spec (.of k))
  (f : C ⟶ U)

/-- **An affine chart cover of a morphism `f : C ⟶ U`**: affine opens `U_i` covering `C` and affine
opens `W_i` of `U` with `U_i ⊆ f⁻¹ W_i`. -/
structure ChartCover (ι : Type u) where
  /-- The affine opens of the source. -/
  UC : ι → C.Opens
  /-- The affine opens of the target. -/
  WU : ι → U.Opens
  /-- The source opens are affine. -/
  affC : ∀ i, IsAffineOpen (UC i)
  /-- The target opens are affine. -/
  affW : ∀ i, IsAffineOpen (WU i)
  /-- `f` maps `U_i` into `W_i`. -/
  le : ∀ i, UC i ≤ f ⁻¹ᵁ WU i
  /-- The `U_i` cover `C`. -/
  cover : (⊤ : C.Opens) = ⨆ i, UC i

variable {f} {ι : Type u} (K : ChartCover f ι)

namespace ChartCover

/-- The intersection of the source opens indexed by `s` lies in the preimage of the intersection of
the target opens indexed by `s`. -/
theorem le_inf (s : Finset ι) : s.inf K.UC ≤ f ⁻¹ᵁ s.inf K.WU := fun x hx => by
  change f.base x ∈ s.inf K.WU
  rw [mem_finset_inf_opens] at hx ⊢
  exact fun i hi => K.le i (hx i hi)

/-- For `U` separated over `k`, a nonempty finite intersection of target opens of a chart cover is
affine. -/
theorem isAffineOpen_inf_WU [IsSeparated sU] {s : Finset ι} (hs : s.Nonempty) :
    IsAffineOpen (s.inf K.WU) := by
  have : IsSeparated (terminal.from U) := by
    rw [show terminal.from U = sU ≫ terminal.from (Spec (CommRingCat.of k)) from
      terminal.hom_ext _ _]
    infer_instance
  rw [Finset.inf_eq_iInf]
  exact IsAffineOpen.biInf (s : Set ι) s.finite_toSet hs fun i _ => K.affW i

/-- For `C` separated over `k`, a nonempty finite intersection of source opens of a chart cover is
affine. -/
theorem isAffineOpen_inf_UC [IsSeparated sC] {s : Finset ι} (hs : s.Nonempty) :
    IsAffineOpen (s.inf K.UC) := by
  have : IsSeparated (terminal.from C) := by
    rw [show terminal.from C = sC ≫ terminal.from (Spec (CommRingCat.of k)) from
      terminal.hom_ext _ _]
    infer_instance
  rw [Finset.inf_eq_iInf]
  exact IsAffineOpen.biInf (s : Set ι) s.finite_toSet hs fun i _ => K.affC i

end ChartCover

/-- For a morphism `f` over `Spec k`, the structure map `k → Γ(U, W)` followed by `f.appLE W V e`
is the structure map `k → Γ(C, V)`. -/
theorem baseRingHom_comp_appLE (hf : f ≫ sU = sC) {V : C.Opens} {W : U.Opens} (e : V ≤ f ⁻¹ᵁ W) :
    Stacks.Cech.baseRingHom sU W ≫ f.appLE W V e = Stacks.Cech.baseRingHom sC V := by
  subst hf
  simp only [Stacks.Cech.baseRingHom, Stacks.Cech.globalRingHom, Category.assoc]
  rw [Scheme.Hom.map_appLE, Scheme.Hom.comp_appTop]
  rfl

/-- The map `Γ(W, 𝒪_U) → Γ(V, 𝒪_C)` of `f`, as a map of `k`-algebras. -/
def appLEAlgHom (hf : f ≫ sU = sC) {V : C.Opens} {W : U.Opens} (e : V ≤ f ⁻¹ᵁ W) :
    letI := sectionsAlgebra sU W
    letI := sectionsAlgebra sC V
    Γ(U, W) →ₐ[k] Γ(C, V) :=
  letI := sectionsAlgebra sU W
  letI := sectionsAlgebra sC V
  { toRingHom := (f.appLE W V e).hom
    commutes' := fun r => by
      change (f.appLE W V e).hom ((Stacks.Cech.baseRingHom sU W).hom r) =
        (Stacks.Cech.baseRingHom sC V).hom r
      rw [← baseRingHom_comp_appLE sC sU hf e]
      rfl }

/-- `appLEAlgHom sC sU hf e` is `f.appLE W V e`. -/
theorem appLEAlgHom_apply (hf : f ≫ sU = sC) {V : C.Opens} {W : U.Opens} (e : V ≤ f ⁻¹ᵁ W)
    (x : Γ(U, W)) :
    appLEAlgHom sC sU hf e x = f.appLE W V e x := rfl

/-- The ideal of the functions on `V` vanishing at the points `pts β` lying in `V`. -/
def vanishingIdeal {b : ℕ} (pts : Fin b → C) (V : C.Opens) : Ideal Γ(C, V) :=
  ⨅ (β : Fin b) (hβ : pts β ∈ V),
    Ideal.comap (C.presheaf.germ V (pts β) hβ).hom (IsLocalRing.maximalIdeal _)

/-- A function on `V` lies in `vanishingIdeal pts V` if and only if its germ at each point `pts β`
of `V` lies in the maximal ideal. -/
theorem mem_vanishingIdeal {b : ℕ} (pts : Fin b → C) (V : C.Opens) (x : Γ(C, V)) :
    x ∈ vanishingIdeal pts V ↔ ∀ β (hβ : pts β ∈ V),
      C.presheaf.germ V (pts β) hβ x ∈ IsLocalRing.maximalIdeal _ := by
  simp [vanishingIdeal, Ideal.mem_iInf]

/-- Restriction to a smaller open maps `vanishingIdeal pts V` into `vanishingIdeal pts V'`. -/
theorem map_mem_vanishingIdeal {b : ℕ} (pts : Fin b → C) {V V' : C.Opens} (h : V' ≤ V)
    (x : Γ(C, V)) (hx : x ∈ vanishingIdeal pts V) :
    C.presheaf.map (homOfLE h).op x ∈ vanishingIdeal pts V' := by
  rw [mem_vanishingIdeal] at hx ⊢
  intro β hβ
  rw [TopCat.Presheaf.germ_res_apply]
  exact hx β (h hβ)

variable [IsSeparated sU]

/-- **The curve charts of an affine chart cover**: the target charts `Γ(W_s, 𝒪_U)` (smooth, with
étale restrictions), the source charts `Γ(U_s, 𝒪_C)`, the ideals of the points `pts` and the maps
of `f`. -/
def curveCharts (hf : f ≫ sU = sC) [Smooth sU] {b : ℕ} (pts : Fin b → C) : CurveCharts k ι where
  S s := Γ(U, s.inf K.WU)
  alg s := sectionsAlgebra sU _
  σ h := resAlgHom sU (Finset.inf_mono h)
  σ_refl h x := resAlgHom_refl sU _ x
  σ_comp h₁ h₂ x := resAlgHom_comp sU _ _ x
  smooth s hs := formallySmooth_sections sU (K.isAffineOpen_inf_WU sU hs)
  etale {s t} h hs := formallyEtale_of_etale (etale_res (K.isAffineOpen_inf_WU sU hs)
    (K.isAffineOpen_inf_WU sU (hs.mono h)) (Finset.inf_mono h))
  O s := Γ(C, s.inf K.UC)
  algO s := sectionsAlgebra sC _
  ρ h := resAlgHom sC (Finset.inf_mono h)
  ρ_refl h x := resAlgHom_refl sC _ x
  ρ_comp h₁ h₂ x := resAlgHom_comp sC _ _ x
  𝔟 s := vanishingIdeal pts (s.inf K.UC)
  ρ_mem h x hx := map_mem_vanishingIdeal pts (Finset.inf_mono h) x hx
  f0 s := appLEAlgHom sC sU hf (K.le_inf s)
  f0_comm {s t} h x := by
    change f.appLE _ _ _ (U.presheaf.map _ x) = C.presheaf.map _ (f.appLE _ _ _ x)
    rw [← CategoryTheory.ConcreteCategory.comp_apply, Scheme.Hom.map_appLE,
      ← CategoryTheory.ConcreteCategory.comp_apply, Scheme.Hom.appLE_map]

end CurveChartsOfCover

section ThetaO

variable {k : Type u} [Field k] {C U : Scheme.{u}} (sC : C ⟶ Spec (.of k)) (sU : U ⟶ Spec (.of k))
  {f : C ⟶ U} (hf : f ≫ sU = sC) {ι : Type u} [DecidableEq ι] [LinearOrder ι] (K : ChartCover f ι)
  [IsSeparated sU] [Smooth sU] {b : ℕ} (pts : Fin b → C)

/-- The presheaf of rings of the source charts is the sections presheaf of `𝒪_C`. -/
def ringPresheafIso :
    Cech.Iso (curveCharts sC sU K hf pts).ringPresheaf
      (sectionsCechPresheaf sC K.UC (SheafOfModules.unit C.ringCatSheaf)) where
  equiv s :=
    { toFun := fun x => x
      invFun := fun x => x
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  map_res h x := rfl

/-- **`θ_O`**: the Čech `H¹` of the presheaf of rings of the source charts is `H¹(C, 𝒪_C)`. -/
def ringPresheafH1Equiv [IsSeparated sC] [Fintype ι] :
    (curveCharts sC sU K hf pts).ringPresheaf.H1 ≃ₗ[k]
      cohomologyOverField k sC (SheafOfModules.unit C.ringCatSheaf) 1 :=
  (ringPresheafIso sC sU hf K pts).h1Equiv.trans
    (cechH1EquivCohomologyOverField sC K.UC (SheafOfModules.unit C.ringCatSheaf) K.cover
      (fun r s => Stacks.Cech.inter_isAffineOpen sC K.UC K.affC s))

end ThetaO

section Coordinates

open Stacks.ProjectiveFromSections

variable {X : Scheme.{u}} {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] {κ : Type*}
  (σ : κ → Γ(L, ⊤)) {ι : Type*} (V : ι → X.Opens) (l : ι → κ)
  (hV : ∀ i, V i ≤ nvCover σ (l i))

/-- Restriction of functions along `W' ≤ W` and then `W'' ≤ W'` is restriction along `W'' ≤ W`. -/
theorem resO_resO {W W' W'' : X.Opens} (h₁ : W' ≤ W) (h₂ : W'' ≤ W') (a : Γ(X, W)) :
    resO h₂ (resO h₁ a) = resO (h₂.trans h₁) a := by
  simp only [resO, ← CategoryTheory.ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- Restriction commutes with division by a section `t` on its non-vanishing locus. -/
theorem resO_div (t : Γ(L, ⊤)) {W W' : X.Opens} (hW : W ≤ nvOpen L t) (h : W' ≤ W)
    (u : Γ(L, W)) : resO h (div t hW u) = div t (h.trans hW) (resM h u) := by
  refine eq_div t (h.trans hW) ?_
  rw [← resM_resT h t, ← resM_smul, div_smul]

include hV in
/-- For `i ∈ s`, the intersection of `V` over `s` is contained in the non-vanishing locus of
`σ (l i)`. -/
theorem inf_le_nvCover {s : Finset ι} {i : ι} (hi : i ∈ s) : s.inf V ≤ nvCover σ (l i) :=
  (Finset.inf_le hi).trans (hV i)

/-- **The chart coordinates** `σ_m / σ_{l i}` on `V_i`. -/
def chartCoord (m : κ) (i : ι) : Γ(X, ({i} : Finset ι).inf V) :=
  resO (inf_le_nvCover σ V l hV (Finset.mem_singleton_self i)) (ratio σ (l i) m)

/-- **The local expression** `t / σ_{l i}` of a global section `t` on `V_i`. -/
def chartLocal (t : Γ(L, ⊤)) (i : ι) : Γ(X, ({i} : Finset ι).inf V) :=
  div (σ (l i)) (inf_le_nvCover σ V l hV (Finset.mem_singleton_self i)) (resT _ t)

variable [DecidableEq ι]

/-- **The transition functions** `σ_{l j} / σ_{l i}` on `V_i ∩ V_j`. -/
def chartTrans (i j : ι) : (Γ(X, ({i, j} : Finset ι).inf V))ˣ :=
  transUnit σ (inf_le_nvCover σ V l hV (Finset.mem_insert_self i {j}))
    (inf_le_nvCover σ V l hV (Finset.mem_insert_of_mem (Finset.mem_singleton_self j)))

/-- The transition function `chartTrans σ V l hV i j` is the restriction of the ratio
`σ_{l j} / σ_{l i}`. -/
theorem chartTrans_val (i j : ι) :
    (chartTrans σ V l hV i j : Γ(X, ({i, j} : Finset ι).inf V)) =
      resO (inf_le_nvCover σ V l hV (Finset.mem_insert_self i {j})) (ratio σ (l i) (l j)) := rfl

/-- The chart coordinate `σ_{l i} / σ_{l i}` on `V_i` is `1`. -/
theorem chartCoord_self (i : ι) : chartCoord σ V l hV (l i) i = 1 := by
  rw [chartCoord, ratio_self, resO_one]

/-- On `V_i ∩ V_j`, the chart coordinates of `σ_m` satisfy
`σ_m / σ_{l i} = (σ_{l j} / σ_{l i}) · (σ_m / σ_{l j})`. -/
theorem chartCoord_trans (m : κ) (i j : ι) :
    resO (Finset.inf_mono (CechPresheaf.sub_pair_left i j)) (chartCoord σ V l hV m i) =
      (chartTrans σ V l hV i j : Γ(X, ({i, j} : Finset ι).inf V)) *
        resO (Finset.inf_mono (CechPresheaf.sub_pair_right i j)) (chartCoord σ V l hV m j) := by
  rw [chartCoord, chartCoord, resO_resO, resO_resO, chartTrans_val]
  exact ratio_cocycle σ _ _ m

/-- The transition functions satisfy the cocycle condition on triple intersections. -/
theorem chartTrans_cocycle (i j m : ι) :
    resO (Finset.inf_mono (CechPresheaf.pair_sub_triple₁₂ i j m))
        (chartTrans σ V l hV i j : Γ(X, ({i, j} : Finset ι).inf V)) *
      resO (Finset.inf_mono (CechPresheaf.pair_sub_triple₂₃ i j m))
        (chartTrans σ V l hV j m : Γ(X, ({j, m} : Finset ι).inf V)) =
    resO (Finset.inf_mono (CechPresheaf.pair_sub_triple₁₃ i j m))
        (chartTrans σ V l hV i m : Γ(X, ({i, m} : Finset ι).inf V)) := by
  rw [chartTrans_val, chartTrans_val, chartTrans_val, resO_resO, resO_resO, resO_resO]
  exact (ratio_cocycle σ _ _ (l m)).symm

/-- On `V_i ∩ V_j`, the local expressions of `t` satisfy
`t / σ_{l i} = (σ_{l j} / σ_{l i}) · (t / σ_{l j})`. -/
theorem chartLocal_trans (t : Γ(L, ⊤)) (i j : ι) :
    resO (Finset.inf_mono (CechPresheaf.sub_pair_left i j)) (chartLocal σ V l hV t i) =
      (chartTrans σ V l hV i j : Γ(X, ({i, j} : Finset ι).inf V)) *
        resO (Finset.inf_mono (CechPresheaf.sub_pair_right i j)) (chartLocal σ V l hV t j) := by
  have hi := inf_le_nvCover σ V l hV (Finset.mem_insert_self i {j})
  have hj := inf_le_nvCover σ V l hV (s := {i, j})
    (Finset.mem_insert_of_mem (Finset.mem_singleton_self j))
  rw [chartLocal, chartLocal, resO_div, resO_div, resM_resT, resM_resT, chartTrans_val]
  refine eq_of_smul_eq_smul (σ (l i)) hi ?_
  rw [div_smul, mul_comm, mul_smul, resO_ratio_smul σ hi (l j), div_smul]

/-- `t` restricted to `V_i` is its local expression times `σ_{l i}`. -/
theorem chartLocal_smul (t : Γ(L, ⊤)) (i : ι) :
    chartLocal σ V l hV t i • resT (({i} : Finset ι).inf V) (σ (l i)) =
      resT (({i} : Finset ι).inf V) t :=
  div_smul _ _ _

end Coordinates

section LocalToGlobal

open Stacks.ProjectiveFromSections

variable {X : Scheme.{u}} {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] {κ : Type*}
  (σ : κ → Γ(L, ⊤)) {ι : Type*} [DecidableEq ι] (V : ι → X.Opens) (l : ι → κ)
  (hV : ∀ i, V i ≤ nvCover σ (l i))

/-- Restriction of sections of `L` along `W' ≤ W` and then `W'' ≤ W'` is restriction along
`W'' ≤ W`. -/
theorem resM_resM {W W' W'' : X.Opens} (h₁ : W' ≤ W) (h₂ : W'' ≤ W') (u : Γ(L, W)) :
    resM h₂ (resM h₁ u) = resM (h₂.trans h₁) u := by
  simp only [resM, ← CategoryTheory.ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- The intersection of the infima of `V` over `{i}` and over `{j}` is contained in the infimum
over `{i, j}`. -/
theorem inf_le_inf_pair (i j : ι) :
    ({i} : Finset ι).inf V ⊓ ({j} : Finset ι).inf V ≤ ({i, j} : Finset ι).inf V := by
  intro x hx
  rw [mem_finset_inf_opens]
  intro m hm
  rw [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with rfl | rfl
  · exact (show ({m} : Finset ι).inf V = V m from Finset.inf_singleton).le hx.1
  · exact (show ({m} : Finset ι).inf V = V m from Finset.inf_singleton).le hx.2

/-- **Local expressions glue**: a family of functions `a_i` on `V_i` transforming by the
transition functions `σ_{l j}/σ_{l i}` is the family of local expressions of a global section,
when the `V_i` cover `X`. -/
theorem exists_chartLocal_eq (hcov : (⊤ : X.Opens) = ⨆ i, V i)
    (a : ∀ i, Γ(X, ({i} : Finset ι).inf V))
    (ha : ∀ i j, resO (Finset.inf_mono (CechPresheaf.sub_pair_left i j)) (a i) =
      (chartTrans σ V l hV i j : Γ(X, ({i, j} : Finset ι).inf V)) *
        resO (Finset.inf_mono (CechPresheaf.sub_pair_right i j)) (a j)) :
    ∃ t : Γ(L, ⊤), ∀ i, chartLocal σ V l hV t i = a i := by
  let V' : ι → X.Opens := fun i => ({i} : Finset ι).inf V
  let sf : ∀ i, Γ(L, V' i) := fun i => a i • resT (V' i) (σ (l i))
  have hpair : ∀ i j, resM (Finset.inf_mono (CechPresheaf.sub_pair_left i j)) (sf i) =
      resM (Finset.inf_mono (CechPresheaf.sub_pair_right i j)) (sf j) := by
    intro i j
    have hi := inf_le_nvCover σ V l hV (s := {i, j}) (Finset.mem_insert_self i {j})
    have hj := inf_le_nvCover σ V l hV (s := {i, j})
      (Finset.mem_insert_of_mem (Finset.mem_singleton_self j))
    simp only [sf]
    rw [resM_smul, resM_smul, resM_resT, resM_resT, ha i j, chartTrans_val, mul_comm, mul_smul,
      resO_ratio_smul σ hi (l j)]
  have hcompat : TopCat.Presheaf.IsCompatible (⟨L.presheaf, L.isSheaf⟩ : TopCat.Sheaf _ _).1
      V' sf := by
    intro i j
    have h := congrArg (resM (inf_le_inf_pair V i j)) (hpair i j)
    rwa [resM_resM, resM_resM] at h
  have hcover : (⊤ : X.Opens) ≤ iSup V' := by
    rw [hcov]
    exact iSup_mono fun i => (show ({i} : Finset ι).inf V = V i from Finset.inf_singleton).ge
  obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (⟨L.presheaf, L.isSheaf⟩ : TopCat.Sheaf _ _) V' ⊤ (fun i => homOfLE le_top) hcover sf hcompat
  exact ⟨t, fun i => (eq_div (σ (l i)) _ (ht i).symm).symm⟩

/-- **A global section with vanishing local expressions vanishes.** -/
theorem eq_zero_of_chartLocal_eq_zero (hcov : (⊤ : X.Opens) = ⨆ i, V i) (t : Γ(L, ⊤))
    (ht : ∀ i, chartLocal σ V l hV t i = 0) : t = 0 := by
  have hcover : (⊤ : X.Opens) ≤ ⨆ i, ({i} : Finset ι).inf V := by
    rw [hcov]
    exact iSup_mono fun i => (show ({i} : Finset ι).inf V = V i from Finset.inf_singleton).ge
  refine TopCat.Sheaf.eq_of_locally_eq' (⟨L.presheaf, L.isSheaf⟩ : TopCat.Sheaf _ _)
    (fun i => ({i} : Finset ι).inf V) ⊤ (fun i => homOfLE le_top) hcover t 0 fun i => ?_
  rw [map_zero]
  change resT _ t = 0
  rw [← chartLocal_smul σ V l hV t i, ht i, zero_smul]

/-- The local expression of a sum of global sections is the sum of their local expressions. -/
theorem chartLocal_add (t t' : Γ(L, ⊤)) (i : ι) :
    chartLocal σ V l hV (t + t') i = chartLocal σ V l hV t i + chartLocal σ V l hV t' i := by
  refine (eq_div (σ (l i)) _ ?_).symm
  rw [add_smul, chartLocal_smul, chartLocal_smul]
  exact (map_add _ _ _).symm

/-- The local expression of `c • t`, for a global function `c`, is the restriction of `c` times the
local expression of `t`. -/
theorem chartLocal_smul_section (c : Γ(X, ⊤)) (t : Γ(L, ⊤)) (i : ι) :
    chartLocal σ V l hV (c • t) i = resO le_top c * chartLocal σ V l hV t i := by
  refine (eq_div (σ (l i)) _ ?_).symm
  rw [mul_smul, chartLocal_smul]
  exact (resM_smul le_top c t).symm

/-- The local expression of the zero section is zero. -/
theorem chartLocal_zero (i : ι) : chartLocal σ V l hV 0 i = 0 := by
  refine (eq_div (σ (l i)) _ ?_).symm
  rw [zero_smul]
  exact (map_zero _).symm

/-- The local expression of `∑ m, c m • w m` is `∑ m, c m · (w m / σ_{l i})`. -/
theorem chartLocal_sum {N : ℕ} (c : Fin N → Γ(X, ⊤)) (w : Fin N → Γ(L, ⊤)) (i : ι) :
    chartLocal σ V l hV (∑ m, c m • w m) i =
      ∑ m, resO le_top (c m) * chartLocal σ V l hV (w m) i := by
  induction (Finset.univ : Finset (Fin N)) using Finset.induction_on with
  | empty => simp [chartLocal_zero]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, chartLocal_add, ih, chartLocal_smul_section]

end LocalToGlobal

section Coord

open TensorProduct

variable {k : Type u} [CommRing k] {O O' B : Type u} [CommRing O] [Algebra k O] [CommRing O']
  [Algebra k O'] [CommRing B] [Algebra k B] {κ : Type u} [DecidableEq κ] (e : Module.Basis κ k B)

/-- The `β`-th coordinate `O ⊗_k B → O` with respect to a basis of `B`. -/
def coordB (β : κ) : O ⊗[k] B →ₗ[k] O :=
  (Finsupp.lapply β).comp (TensorProduct.equivFinsuppOfBasisRight e).toLinearMap

/-- The `β`-th coordinate of `a ⊗ c` is `e.repr c β • a`. -/
theorem coordB_tmul (β : κ) (a : O) (c : B) : coordB e β (a ⊗ₜ[k] c) = e.repr c β • a := by
  simp [coordB, TensorProduct.equivFinsuppOfBasisRight_apply_tmul_apply]

/-- The coordinates commute with `ρ ⊗ id_B` for a `k`-algebra map `ρ`. -/
theorem coordB_map (ρ : O →ₐ[k] O') (β : κ) (x : O ⊗[k] B) :
    coordB e β (Algebra.TensorProduct.map ρ (AlgHom.id k B) x) = ρ (coordB e β x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  | tmul a c => rw [Algebra.TensorProduct.map_tmul, coordB_tmul, coordB_tmul, map_smul]; rfl

/-- The coordinates are linear over `O`, acting through `g ↦ g ⊗ 1`. -/
theorem coordB_mul (g : O) (β : κ) (x : O ⊗[k] B) :
    coordB e β ((g ⊗ₜ[k] (1 : B)) * x) = g * coordB e β x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [mul_add, map_add, map_add, hx, hy, mul_add]
  | tmul a c => rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, coordB_tmul, coordB_tmul,
      mul_smul_comm]

/-- The `β`-th coordinate of `∑ m, a m ⊗ c m` is `∑ m, e.repr (c m) β • a m`. -/
theorem coordB_sum {N : ℕ} (a : Fin N → O) (c : Fin N → B) (β : κ) :
    coordB e β (∑ m, a m ⊗ₜ[k] c m) = ∑ m, e.repr (c m) β • a m := by
  rw [map_sum]
  simp only [coordB_tmul]

/-- Two elements of `O ⊗[k] B` with the same coordinates are equal. -/
theorem ext_coordB {x y : O ⊗[k] B} (h : ∀ β, coordB e β x = coordB e β y) : x = y := by
  apply (TensorProduct.equivFinsuppOfBasisRight e).injective
  ext β
  exact h β

end Coord

section Glue

open Stacks.ProjectiveFromSections TensorProduct
open Stacks.AlgebraicGeometry.SectionsBaseChange

variable {k : Type u} [Field k] {C U : Scheme.{u}} (sC : C ⟶ Spec (.of k)) (sU : U ⟶ Spec (.of k))
  {f : C ⟶ U} (hf : f ≫ sU = sC) {ι : Type u} [DecidableEq ι] [Fintype ι] (K : ChartCover f ι)
  [IsSeparated sU] [Smooth sU] {b : ℕ} (pts : Fin b → C)
  {L : C.Modules} [Stacks.Ample.IsInvertibleModule C L] {κ : Type*} (σ : κ → Γ(L, ⊤)) (l : ι → κ)
  (hσ : ∀ i, K.UC i ≤ nvCover σ (l i)) {N : ℕ}
  (w : letI := baseModule sC L ⊤; Module.Basis (Fin N) Γ(Spec (.of k), ⊤) Γ(L, ⊤))

/-- The local expressions of the global sections `t` of `L` in the source charts. -/
def localSection (t : Γ(L, ⊤)) (i : ι) : (curveCharts sC sU K hf pts).O {i} :=
  chartLocal σ K.UC l hσ t i

/-- The transition functions of `L` in the source charts. -/
def localTrans (i j : ι) : ((curveCharts sC sU K hf pts).O {i, j})ˣ :=
  chartTrans σ K.UC l hσ i j

/-- The `k`-algebra structure on a source chart is through the restriction of global functions. -/
theorem algebraMap_curveCharts_O (s : Finset ι) (c : k) :
    algebraMap k ((curveCharts sC sU K hf pts).O s) c =
      resO le_top (sC.appTop ((Scheme.ΓSpecIso (.of k)).inv c)) := rfl

/-- The local expression of the section with coefficients `a` in the basis `w` is
`∑ m, a m • localSection … (w m) i`. -/
theorem chartLocal_sum_coefficients (a : Fin N → k) (i : ι) :
    chartLocal σ K.UC l hσ (∑ m, sC.appTop ((Scheme.ΓSpecIso (.of k)).inv (a m)) • w m) i =
      ∑ m, a m • localSection sC sU hf K pts σ l hσ (w m) i := by
  rw [chartLocal_sum]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [Algebra.smul_def, algebraMap_curveCharts_O]
  rfl

/-- **Flat base change of `H⁰(C, L)`** in charts: a family of local expressions over `B`
transforming by the transition functions of `L` is given by coefficients in `B` of the basis
`w`. -/
theorem exists_glue_curveCharts (B : Type u) [CommRing B] [Algebra k B]
    (u : ∀ i : ι, (curveCharts sC sU K hf pts).O {i} ⊗[k] B)
    (hu : ∀ i j, Algebra.TensorProduct.map
      ((curveCharts sC sU K hf pts).ρ (CechPresheaf.sub_pair_left i j)) (AlgHom.id k _) (u i) =
      ((localTrans sC sU hf K pts σ l hσ i j : (curveCharts sC sU K hf pts).O {i, j}) ⊗ₜ[k]
          (1 : B)) *
        Algebra.TensorProduct.map
          ((curveCharts sC sU K hf pts).ρ (CechPresheaf.sub_pair_right i j)) (AlgHom.id k _)
            (u j)) :
    ∃ c : Fin N → B, ∀ i, u i = ∑ m, localSection sC sU hf K pts σ l hσ (w m) i ⊗ₜ[k] c m := by
  classical
  let e := Module.Free.chooseBasis k B
  have hglue : ∀ β, ∃ t : Γ(L, ⊤), ∀ i, chartLocal σ K.UC l hσ t i = coordB e β (u i) := by
    intro β
    refine exists_chartLocal_eq σ K.UC l hσ K.cover
      (fun i => coordB (O := (curveCharts sC sU K hf pts).O {i}) e β (u i)) fun i j => ?_
    have h := congrArg (coordB e β) (hu i j)
    rwa [coordB_map, coordB_mul, coordB_map] at h
  choose t ht using hglue
  let T : Finset _ := Finset.univ.biUnion fun i =>
    (TensorProduct.equivFinsuppOfBasisRight e (u i)).support
  let cβ : _ → Fin N → k := fun β => if β ∈ T then coefficients sC L w (t β) else 0
  have hcβ : ∀ β i, ∑ m, cβ β m • localSection sC sU hf K pts σ l hσ (w m) i =
      coordB e β (u i) := by
    intro β i
    by_cases hβ : β ∈ T
    · simp only [cβ, if_pos hβ]
      rw [← chartLocal_sum_coefficients sC sU hf K pts σ l hσ w, ← eq_sum_coefficients, ht]
    · simp only [cβ, if_neg hβ, Pi.zero_apply, zero_smul, Finset.sum_const_zero]
      by_contra hne
      exact hβ (Finset.mem_biUnion.2
        ⟨i, Finset.mem_univ _, Finsupp.mem_support_iff.2 (Ne.symm hne)⟩)
  refine ⟨fun m => ∑ β ∈ T, cβ β m • e β, fun i => ext_coordB e fun β => ?_⟩
  rw [coordB_sum, ← hcβ β i]
  refine Finset.sum_congr rfl fun m _ => ?_
  congr 1
  rw [map_sum]
  simp only [map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
    Finsupp.coe_finset_sum, Finset.sum_apply, Finsupp.single_apply]
  rw [Finset.sum_ite_eq']
  split_ifs with hβ
  · rfl
  · simp [cβ, hβ]

/-- **Uniqueness of the coefficients**: coefficients over `B` whose combination of the local
expressions of `w` vanishes on every chart vanish. -/
theorem glue_unique_curveCharts (B : Type u) [CommRing B] [Algebra k B] (c : Fin N → B)
    (hc : ∀ i, ∑ m, localSection sC sU hf K pts σ l hσ (w m) i ⊗ₜ[k] c m = 0) : c = 0 := by
  classical
  let e := Module.Free.chooseBasis k B
  have h0 : ∀ β m, e.repr (c m) β = 0 := by
    intro β
    have hzero : (∑ m, sC.appTop ((Scheme.ΓSpecIso (.of k)).inv (e.repr (c m) β)) • w m) = 0 := by
      refine eq_zero_of_chartLocal_eq_zero σ K.UC l hσ K.cover _ fun i => ?_
      rw [chartLocal_sum_coefficients sC sU hf K pts σ l hσ w]
      have h := congrArg (coordB e β) (hc i)
      rwa [coordB_sum, map_zero] at h
    have := coefficients_sum sC L w (fun m => e.repr (c m) β)
    rw [hzero] at this
    intro m
    rw [← congrFun this m]
    have hc0 : coefficients sC L w 0 = 0 := by
      have := coefficients_sum sC L w 0
      simp only [Pi.zero_apply, map_zero, zero_smul, Finset.sum_const_zero] at this
      exact this
    rw [hc0]
    rfl
  funext m
  rw [Pi.zero_apply, ← e.repr.injective.eq_iff, map_zero]
  ext β
  exact h0 β m

end Glue

end MMP.Fourfold.CurveMapCharts
