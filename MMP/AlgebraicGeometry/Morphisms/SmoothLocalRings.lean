module

public import MMP.AlgebraicGeometry.Divisor.BirationalPushforward
public import MMP.AlgebraicGeometry.DeRham.SNCCharts
public import MMP.AlgebraicGeometry.Morphisms.Smooth.RegularParameters

/-!
# Local rings of a smooth scheme at a prime divisor

Let `X` be a scheme smooth over a field `k`. Every point has an affine neighbourhood whose ring
of functions is standard smooth over `k`, so the local rings of `X` are essentially of finite
type and formally smooth over `k`, with free Kähler differentials of finite rank. For a prime
divisor `E` and an affine open `W` containing its generic point, the ideal of `E` on `W` is the
prime of the generic point; if it is principal, generated by `t`, then `t` is a uniformizer of the
local ring `𝒪_{X,E}`.

These are the hypotheses under which the adapted bases of the Kähler differentials at a prime
divisor exist (`MMP.FourfoldProofs.FractionalLogComplexProof.exists_basis_D_cons`).

## Main results

* `MMP.FourfoldProofs.FractionalLogComplexProof.exists_affine_isStandardSmooth`: standard smooth
  affine neighbourhoods.
* `MMP.FourfoldProofs.FractionalLogComplexProof.essFiniteType_stalkAlgebra`,
  `MMP.FourfoldProofs.FractionalLogComplexProof.formallySmooth_free_finite_stalk`: the local rings.
* `MMP.FourfoldProofs.FractionalLogComplexProof.idealSheaf_ideal_eq_primeIdealOf`: the ideal of a prime
  divisor on an affine open.
* `MMP.FourfoldProofs.FractionalLogComplexProof.maximalIdeal_localRing_eq_span`: uniformizers from
  local equations.
-/

@[expose] public section

open AlgebraicGeometry TopologicalSpace IsLocalRing

namespace MMP.FourfoldProofs.FractionalLogComplexProof

universe u

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

/-- **Standard smooth affine neighbourhoods.** On a scheme smooth over `k`, every point of an
open `O` has an affine neighbourhood `W ⊆ O` with `Γ(X, W)` standard smooth over `k`. -/
theorem exists_affine_isStandardSmooth {m : ℕ} [SmoothOfRelativeDimension m sX] {O : X.Opens}
    {x : X} (hx : x ∈ O) :
    ∃ W : X.affineOpens, x ∈ (W : X.Opens) ∧ (W : X.Opens) ≤ O ∧
      (letI := MMP.Mori.sectionAlgebra sX W; Algebra.IsStandardSmooth k Γ(X, W)) := by
  obtain ⟨W₀, hW₀, hxW₀, hW₀O⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hx
  let := MMP.Mori.sectionAlgebra sX W₀
  obtain ⟨s, hs, hP⟩ :=
    MMP.DeRham.locally_isStandardSmoothOfRelativeDimension_sectionAlgebra sX (m := m) hW₀
  obtain ⟨⟨t, ht⟩, hxt⟩ := Opens.mem_iSup.mp ((hW₀.self_le_iSup_basicOpen_iff (s := s)).2 hs hxW₀)
  let W : X.affineOpens := ⟨X.basicOpen t, hW₀.basicOpen t⟩
  refine ⟨W, hxt, (X.basicOpen_le t).trans hW₀O, ?_⟩
  let := MMP.Mori.sectionAlgebra sX W
  have : IsLocalization.Away t Γ(X, X.basicOpen t) := hW₀.isLocalization_basicOpen t
  let e : Localization.Away t ≃ₐ[Γ(X, W₀)] Γ(X, X.basicOpen t) :=
    IsLocalization.algEquiv (Submonoid.powers t) _ _
  have hres : algebraMap k Γ(X, W) =
      (e : Localization.Away t →+* Γ(X, X.basicOpen t)).comp
        ((algebraMap Γ(X, W₀) (Localization.Away t)).comp (algebraMap k Γ(X, W₀))) := by
    have he : (e : Localization.Away t →+* Γ(X, X.basicOpen t)).comp
        (algebraMap Γ(X, W₀) (Localization.Away t)) = algebraMap Γ(X, W₀) Γ(X, X.basicOpen t) :=
      e.toAlgHom.comp_algebraMap
    rw [← RingHom.comp_assoc, he]
    have := MMP.Flips.ResolutionInputs.isScalarTower_section_res sX (X.basicOpen_le t)
    exact IsScalarTower.algebraMap_eq k Γ(X, W₀) Γ(X, W)
  have h1 : RingHom.IsStandardSmoothOfRelativeDimension m (algebraMap k Γ(X, W)) := by
    rw [hres]
    exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e.toRingEquiv (hP t ht)
  exact RingHom.isStandardSmooth_algebraMap.1 (h1.isStandardSmooth _)

/-- **The local rings of a scheme locally of finite type over `k` are essentially of finite
type.** -/
theorem essFiniteType_stalkAlgebra [LocallyOfFiniteType sX] (x : X) :
    letI := MMP.Mori.stalkAlgebra sX x
    Algebra.EssFiniteType k (X.presheaf.stalk x) := by
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let := MMP.Mori.sectionAlgebra sX W
  let := MMP.Mori.stalkAlgebra sX x
  let x' : (W : X.Opens) := ⟨x, hxW⟩
  have : Algebra.FiniteType k Γ(X, W) := MMP.Mori.finiteType_sectionAlgebra sX hW
  let : Algebra Γ(X, W) (X.presheaf.stalk x) := TopCat.Presheaf.algebra_section_stalk X.presheaf x'
  have := MMP.Mori.isScalarTower_section_stalk sX W x'
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (hW.primeIdealOf x').asIdeal :=
    hW.isLocalization_stalk x'
  have : Algebra.EssFiniteType Γ(X, W) (X.presheaf.stalk x) :=
    Algebra.EssFiniteType.of_isLocalization _ (hW.primeIdealOf x').asIdeal.primeCompl
  exact Algebra.EssFiniteType.comp k Γ(X, W) (X.presheaf.stalk x)

/-- **The local rings of a smooth scheme are formally smooth**, with free Kähler differentials of
finite rank. -/
theorem formallySmooth_free_finite_stalk {m : ℕ} [SmoothOfRelativeDimension m sX] (x : X) :
    letI := MMP.Mori.stalkAlgebra sX x
    Algebra.FormallySmooth k (X.presheaf.stalk x) ∧
      Module.Free (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄k] ∧
      Module.Finite (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄k] := by
  obtain ⟨W, hxW, -, hsm⟩ := exists_affine_isStandardSmooth sX (m := m) (O := ⊤) trivial
  let := MMP.Mori.sectionAlgebra sX W
  let := MMP.Mori.stalkAlgebra sX x
  let x' : (W : X.Opens) := ⟨x, hxW⟩
  let : Algebra Γ(X, W) (X.presheaf.stalk x) := TopCat.Presheaf.algebra_section_stalk X.presheaf x'
  have := MMP.Mori.isScalarTower_section_stalk sX W x'
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (W.2.primeIdealOf x').asIdeal :=
    W.2.isLocalization_stalk x'
  have : Algebra.FormallySmooth Γ(X, W) (X.presheaf.stalk x) :=
    Algebra.FormallySmooth.of_isLocalization (W.2.primeIdealOf x').asIdeal.primeCompl
  have : Algebra.FormallyEtale Γ(X, W) (X.presheaf.stalk x) :=
    Algebra.FormallyEtale.of_isLocalization (W.2.primeIdealOf x').asIdeal.primeCompl
  refine ⟨Algebra.FormallySmooth.comp k Γ(X, W) (X.presheaf.stalk x), ?_⟩
  have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale k Γ(X, W) (X.presheaf.stalk x)
  let b := Module.Free.chooseBasis Γ(X, W) Ω[Γ(X, W)⁄k]
  exact ⟨Module.Free.of_basis (hbc.basis b), Module.Finite.of_basis (hbc.basis b)⟩

/-- **The ideal of a prime divisor on an affine open** containing its generic point is the prime
of the generic point. -/
theorem idealSheaf_ideal_eq_primeIdealOf (E : MMP.Mori.PrimeDivisor X) (W : X.affineOpens)
    (hη : E.genericPoint ∈ (W : X.Opens)) :
    E.idealSheaf.ideal W = (W.2.primeIdealOf ⟨E.genericPoint, hη⟩).asIdeal := by
  have hW : IsAffineOpen (W : X.Opens) := W.2
  have : IsReduced E.idealSheaf.subscheme := by
    have := E.integral
    infer_instance
  rw [← MMP.Positivity.vanishingIdeal_support_of_isReduced E.idealSheaf,
    Scheme.IdealSheafData.vanishingIdeal_ideal]
  set η' := hW.primeIdealOf ⟨E.genericPoint, hη⟩
  have hη' : hW.fromSpec η' = E.genericPoint := hW.fromSpec_primeIdealOf _
  ext f
  rw [PrimeSpectrum.mem_vanishingIdeal]
  refine ⟨fun h => h η' ?_, fun hf p hp => ?_⟩
  · change hW.fromSpec η' ∈ E.support
    rw [hη', E.support_eq_closure]
    exact subset_closure rfl
  · change hW.fromSpec p ∈ E.support at hp
    rw [E.support_eq_closure] at hp
    have hsp : hW.fromSpec η' ⤳ hW.fromSpec p := hη' ▸ specializes_iff_mem_closure.mpr hp
    exact (PrimeSpectrum.le_iff_specializes η' p).mpr
      (hW.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hsp) hf

/-- **A local equation of a prime divisor is a uniformizer** of its local ring. -/
theorem maximalIdeal_localRing_eq_span (E : MMP.Mori.PrimeDivisor X) (W : X.affineOpens)
    (hη : E.genericPoint ∈ (W : X.Opens)) {t : Γ(X, W)}
    (ht : E.idealSheaf.ideal W = Ideal.span {t}) :
    maximalIdeal E.localRing = Ideal.span {X.presheaf.germ (W : X.Opens) E.genericPoint hη t} := by
  let x' : (W : X.Opens) := ⟨E.genericPoint, hη⟩
  let : Algebra Γ(X, W) E.localRing := TopCat.Presheaf.algebra_section_stalk X.presheaf x'
  have : IsLocalization.AtPrime E.localRing (W.2.primeIdealOf x').asIdeal :=
    W.2.isLocalization_stalk x'
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal (W.2.primeIdealOf x').asIdeal E.localRing,
    ← idealSheaf_ideal_eq_primeIdealOf E W hη, ht, Ideal.map_span, Set.image_singleton]
  rfl

end MMP.FourfoldProofs.FractionalLogComplexProof
