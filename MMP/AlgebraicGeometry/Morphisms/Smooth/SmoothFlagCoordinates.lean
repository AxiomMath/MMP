open IsLocalRing

private theorem exists_parameters_flag {R : Type*} [CommRing R] [IsRegularLocalRing R]
    (JW JZ : Ideal R) (hle : JW ≤ JZ) (hW : IsRegularLocalRing (R ⧸ JW))
    (hZ : IsRegularLocalRing (R ⧸ JZ)) {s r : ℕ}
    (hs : ringKrullDim R = ringKrullDim (R ⧸ JW) + s)
    (hr : ringKrullDim R = ringKrullDim (R ⧸ JZ) + r) :
    ∃ ts : List R, Ideal.ofList ts = maximalIdeal R ∧
      ts.length = (maximalIdeal R).spanFinrank ∧ s ≤ r ∧ r ≤ ts.length ∧
      Ideal.ofList (ts.take s) = JW ∧ Ideal.ofList (ts.take r) = JZ := by
  classical
  -- dimensions as naturals
  have dR := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  have dW := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ JW)
  have dZ := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ JZ)
  set π : R →+* R ⧸ JW := Ideal.Quotient.mk JW with hπ
  have hπs : Function.Surjective π := Ideal.Quotient.mk_surjective
  have e1 : (R ⧸ JW) ⧸ JZ.map π ≃+* R ⧸ JZ := DoubleQuot.quotQuotEquivQuotOfLE hle
  have hQ : IsRegularLocalRing ((R ⧸ JW) ⧸ JZ.map π) := IsRegularLocalRing.of_ringEquiv e1.symm
  have e1d := ringKrullDim_eq_of_ringEquiv e1
  -- first step
  obtain ⟨xs, hxs, hxl, c0, hc0, hc0I, hc0d⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq JW hW
  obtain ⟨ys, hys, hyl, c, hc, hcI, hcd⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
      (R := R ⧸ JW) (JZ.map π) hQ
  obtain ⟨zs, hzs⟩ := hπs.list_map ys
  -- numeric identities
  have n1 : (Submodule.spanFinrank (maximalIdeal R) : ℕ) =
      Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) + s := by
    have : ((Submodule.spanFinrank (maximalIdeal R) : ℕ) : WithBot ℕ∞) =
        ((Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) + s : ℕ) : WithBot ℕ∞) := by
      rw [dR, hs, ← dW]; push_cast; rfl
    exact_mod_cast this
  have n0 : c0 = s := by
    have : ((Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) + c0 : ℕ) : WithBot ℕ∞) =
        ((Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) + s : ℕ) : WithBot ℕ∞) := by
      push_cast; rw [dW, hc0d, ← hs]
    exact Nat.add_left_cancel (by exact_mod_cast this)
  have nc : r = s + c := by
    have : ((Submodule.spanFinrank (maximalIdeal R) : ℕ) : WithBot ℕ∞) =
        ((Submodule.spanFinrank (maximalIdeal (R ⧸ JZ)) + r : ℕ) : WithBot ℕ∞) := by
      rw [dR, hr, ← dZ]; push_cast; rfl
    have h2 : ((Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) : ℕ) : WithBot ℕ∞) =
        ((Submodule.spanFinrank (maximalIdeal (R ⧸ JZ)) + c : ℕ) : WithBot ℕ∞) := by
      push_cast; rw [dW, dZ, ← e1d, ← hcd]
    have h1 := (by exact_mod_cast this : (Submodule.spanFinrank (maximalIdeal R) : ℕ) =
        Submodule.spanFinrank (maximalIdeal (R ⧸ JZ)) + r)
    have h2' := (by exact_mod_cast h2 : (Submodule.spanFinrank (maximalIdeal (R ⧸ JW)) : ℕ) =
        Submodule.spanFinrank (maximalIdeal (R ⧸ JZ)) + c)
    omega
  have hzl : zs.length = ys.length := by rw [← hzs]; simp
  have hJWm : JW ≤ maximalIdeal R :=
    le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  have hker : Ideal.comap π ⊥ = JW := (RingHom.ker_eq_comap_bot π).symm.trans Ideal.mk_ker
  have hcm : ∀ I : Ideal R, Ideal.comap π (Ideal.map π I) = I ⊔ JW := fun I => by
    rw [Ideal.comap_map_of_surjective π hπs, hker]
  have := IsLocalHom.of_surjective π hπs
  have key : ∀ z, π z ∈ maximalIdeal (R ⧸ JW) ↔ z ∈ maximalIdeal R := fun z => by
    rw [← Ideal.mem_comap, maximalIdeal_comap]
  have hmap : Ideal.map π (maximalIdeal R) = maximalIdeal (R ⧸ JW) :=
    map_maximalIdeal_of_surjective π hπs
  have hzm : Ideal.ofList zs ≤ maximalIdeal R := by
    refine Ideal.span_le.mpr fun z hz => ?_
    have : π z ∈ Ideal.ofList ys := Ideal.subset_span (by
      rw [← hzs]; exact List.mem_map.mpr ⟨z, hz, rfl⟩)
    exact (key z).mp (hys ▸ this)
  have hxs' : Ideal.ofList (xs.take s) = JW := n0 ▸ hc0I
  have hts : Ideal.ofList (xs.take s ++ zs) = maximalIdeal R := by
    rw [Ideal.ofList_append, hxs']
    refine le_antisymm (sup_le hJWm hzm) fun x hx => ?_
    have h1 : π x ∈ maximalIdeal (R ⧸ JW) := by rw [← hmap]; exact Ideal.mem_map_of_mem _ hx
    rw [← hys, ← hzs, ← Ideal.map_ofList] at h1
    have h2 : x ∈ Ideal.comap π (Ideal.map π (Ideal.ofList zs)) := h1
    rw [hcm] at h2
    rw [sup_comm]; exact h2
  have hxlen : (xs.take s).length = s := by
    rw [List.length_take]; omega
  refine ⟨xs.take s ++ zs, hts, ?_, by omega, ?_, ?_, ?_⟩
  · rw [List.length_append, hxlen, hzl, hyl]; omega
  · rw [List.length_append, hxlen, hzl]; omega
  · rw [List.take_left' hxlen]; exact hxs'
  · have htk : (xs.take s ++ zs).take r = xs.take s ++ zs.take c := by
      rw [List.take_append, List.take_of_length_le (by omega), hxlen, nc]
      congr 2; omega
    rw [htk, Ideal.ofList_append, hxs']
    have hT : Ideal.map π (Ideal.ofList (zs.take c)) = Ideal.map π JZ := by
      rw [Ideal.map_ofList, List.map_take, hzs]; exact hcI
    refine le_antisymm (sup_le hle ?_) ?_
    · have : Ideal.ofList (zs.take c) ≤ Ideal.comap π (Ideal.map π (Ideal.ofList (zs.take c))) :=
        Ideal.le_comap_map
      rw [hT, hcm] at this
      exact this.trans (sup_le le_rfl hle)
    · intro x hx
      have : x ∈ Ideal.comap π (Ideal.map π JZ) := Ideal.mem_comap.mpr (Ideal.mem_map_of_mem _ hx)
      rw [← hT, hcm, sup_comm] at this
      exact this

private theorem exists_mul_mem_of_map_le {A S : Type*} [CommRing A] [CommRing S] [Algebra A S]
    (M : Submonoid A) [IsLocalization M S] (I J : Ideal A) (hI : I.FG)
    (h : I.map (algebraMap A S) ≤ J.map (algebraMap A S)) :
    ∃ s ∈ M, ∀ a ∈ I, s * a ∈ J := by
  classical
  obtain ⟨t, rfl⟩ := hI
  have hc : ∀ a ∈ (t : Set A), ∃ c : M, (c : A) * a ∈ J := fun a ha => by
    obtain ⟨m, hm, hmJ⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff M S J a).mp
      (h (Ideal.mem_map_of_mem _ (Ideal.subset_span ha)))
    exact ⟨⟨m, hm⟩, hmJ⟩
  choose! c hc using hc
  refine ⟨∏ a ∈ t, (c a : A), ?_, ?_⟩
  · exact Submonoid.prod_mem _ fun a ha => (c a).2
  · intro a ha
    induction ha using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨u, hu⟩ := Finset.dvd_prod_of_mem (fun a => (c a : A)) (show x ∈ t from hx)
      rw [hu, mul_comm (c x : A) u, mul_assoc]
      exact J.mul_mem_left _ (hc x hx)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact J.add_mem hx hy
    | smul r x _ hx =>
      rw [smul_eq_mul, mul_left_comm]; exact J.mul_mem_left _ hx

/-- If `s * a ∈ L` for all `a ∈ K`, then `K ≤ L` after inverting `s`. -/
private theorem map_algebraMap_le_of_mul_mem {A S : Type*} [CommRing A] [CommRing S]
    [Algebra A S] (s : A) [IsLocalization.Away s S] {K L : Ideal A} (hKL : ∀ a ∈ K, s * a ∈ L) :
    K.map (algebraMap A S) ≤ L.map (algebraMap A S) := by
  obtain ⟨u, hu⟩ := IsLocalization.Away.algebraMap_isUnit (S := S) s
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  rw [Ideal.mem_comap]
  have : algebraMap A S a = ↑u⁻¹ * algebraMap A S (s * a) := by
    rw [map_mul, ← hu, ← mul_assoc]; simp
  rw [this]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hKL a ha))

end AlgebraicHelpers

section LinearAlgebraHelpers

open IsLocalRing TensorProduct Module

private theorem linearIndependent_tmul_D_of_cotangent {A0 R : Type*} [CommRing A0] [CommRing R]
    [IsLocalRing R] [Algebra A0 R] [Algebra.FormallySmooth A0 R] (J : Ideal R)
    [Algebra.FormallySmooth A0 (R ⧸ J)] (hJ : J ≤ maximalIdeal R) {c : ℕ} (t : Fin c → R)
    (htJ : ∀ i, t i ∈ J)
    (hind : LinearIndependent (ResidueField R)
      (fun i => (maximalIdeal R).toCotangent ⟨t i, hJ (htJ i)⟩)) :
    LinearIndependent (ResidueField R)
      (fun i => (1 : ResidueField R) ⊗ₜ[R] KaehlerDifferential.D A0 R (t i)) := by
  have hsurj : Function.Surjective (algebraMap R (R ⧸ J)) := Ideal.Quotient.mk_surjective
  obtain ⟨l, hl⟩ :=
    (Algebra.FormallySmooth.iff_split_injection (R := A0) (P := R) (A := R ⧸ J) hsurj).mp
      inferInstance
  have hker : RingHom.ker (algebraMap R (R ⧸ J)) = J := Ideal.mk_ker
  have hle : RingHom.ker (algebraMap R (R ⧸ J)) ≤ (maximalIdeal R).comap (AlgHom.id R R) := by
    rw [hker]; exact hJ
  let ψ : Ω[R⁄A0] →ₗ[R] (maximalIdeal R).Cotangent :=
    (Ideal.mapCotangent (RingHom.ker (algebraMap R (R ⧸ J))) (maximalIdeal R) (AlgHom.id R R) hle)
      ∘ₗ l ∘ₗ (TensorProduct.mk R (R ⧸ J) Ω[R⁄A0] 1)
  refine LinearIndependent.of_comp (LinearMap.liftBaseChange (ResidueField R) ψ) ?_
  convert hind using 1
  funext i
  have hx : t i ∈ RingHom.ker (algebraMap R (R ⧸ J)) := by rw [hker]; exact htJ i
  simp only [Function.comp_apply, LinearMap.liftBaseChange_tmul, one_smul]
  have h1 : (1 : R ⧸ J) ⊗ₜ[R] KaehlerDifferential.D A0 R (t i) =
      KaehlerDifferential.kerCotangentToTensor A0 R (R ⧸ J)
        (Ideal.toCotangent _ ⟨t i, hx⟩) := by
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
  have h2 : l ((1 : R ⧸ J) ⊗ₜ[R] KaehlerDifferential.D A0 R (t i)) =
      Ideal.toCotangent _ ⟨t i, hx⟩ := by
    rw [h1]; exact congrArg (fun F => F (Ideal.toCotangent _ ⟨t i, hx⟩)) hl
  change Ideal.mapCotangent _ _ _ _ (l ((1 : R ⧸ J) ⊗ₜ[R] KaehlerDifferential.D A0 R (t i))) = _
  rw [h2, Ideal.mapCotangent_toCotangent]
  rfl

private theorem linearIndependent_cotangent_of_ofList {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (ts : List R) (hm : Ideal.ofList ts = maximalIdeal R)
    (hl : ts.length = (maximalIdeal R).spanFinrank)
    (hmem : ∀ i : Fin ts.length, ts[i] ∈ maximalIdeal R) :
    LinearIndependent (ResidueField R) (fun i : Fin ts.length =>
      (maximalIdeal R).toCotangent ⟨ts[i], hmem i⟩) := by
  have hspan : Submodule.span R (Set.range (fun i : Fin ts.length =>
      (⟨ts[i], hmem i⟩ : maximalIdeal R))) = ⊤ := by
    apply Submodule.map_injective_of_injective (Submodule.injective_subtype (maximalIdeal R))
    rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top, Submodule.range_subtype]
    have : Set.range ((maximalIdeal R).subtype ∘ fun i : Fin ts.length =>
        (⟨ts[i], hmem i⟩ : maximalIdeal R)) = {r | r ∈ ts} := by
      ext x
      simp only [Set.mem_range, Function.comp_apply, Submodule.subtype_apply, Set.mem_ofPred_eq]
      constructor
      · rintro ⟨i, rfl⟩; exact List.getElem_mem i.2
      · intro hx
        obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
        exact ⟨⟨i, hi⟩, rfl⟩
    rw [this]
    exact hm
  apply linearIndependent_of_top_le_span_of_card_eq_finrank
  · have := (CotangentSpace.span_image_eq_top_iff (R := R)
      (s := Set.range (fun i : Fin ts.length => (⟨ts[i], hmem i⟩ : maximalIdeal R)))).mpr hspan
    rw [← Set.range_comp] at this
    exact this.ge
  · rw [Fintype.card_fin, hl, ← IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]

private theorem exists_basis_extension_in {κ V : Type*} [Field κ] [AddCommGroup V] [Module κ V]
    [FiniteDimensional κ V] (T : Set V) (hT : Submodule.span κ T = ⊤) {c : ℕ} (v : Fin c → V)
    (hv : LinearIndependent κ v) (hvT : ∀ i, v i ∈ T) (n : ℕ) (hn : finrank κ V = n) :
    ∃ w : Fin n → V, (∀ (i : Fin n) (h : (i : ℕ) < c), w i = v ⟨i, h⟩) ∧
      (∀ j, w j ∈ T) ∧ LinearIndependent κ w ∧ Submodule.span κ (Set.range w) = ⊤ := by
  classical
  subst hn
  have hs : LinearIndepOn κ id (Set.range v) := (linearIndepOn_id_range_iff hv.injective).mpr hv
  obtain ⟨b, hbT, hvb, hTb, hb⟩ := exists_linearIndepOn_id_extension hs (show Set.range v ⊆ T from
    by rintro _ ⟨i, rfl⟩; exact hvT i)
  have hspan : Submodule.span κ b = ⊤ := by
    rw [eq_top_iff, ← hT]; exact Submodule.span_le.mpr hTb
  let B : Basis b κ V := Basis.mk hb (by
    have : Set.range (fun x : b => id (x : V)) = b := Subtype.range_coe
    rw [this]; exact hspan.ge)
  have hfin : Finite b := Module.Finite.finite_basis B
  have hcardB : finrank κ V = Nat.card b := Module.finrank_eq_nat_card_basis B
  let ι' := {x : V // x ∈ b ∧ x ∉ Set.range v}
  let w' : Fin c ⊕ ι' → V := Sum.elim v (fun x => x.1)
  have hinj : Function.Injective w' := by
    rintro (i | x) (j | y) h
    · exact congrArg Sum.inl (hv.injective h)
    · exact absurd ⟨i, h⟩ y.2.2
    · exact absurd ⟨j, h.symm⟩ x.2.2
    · exact congrArg Sum.inr (Subtype.ext h)
  have hrange : Set.range w' = b := by
    ext x
    constructor
    · rintro ⟨(i | y), rfl⟩
      · exact hvb ⟨i, rfl⟩
      · exact y.2.1
    · intro hx
      by_cases h : x ∈ Set.range v
      · obtain ⟨i, rfl⟩ := h; exact ⟨Sum.inl i, rfl⟩
      · exact ⟨Sum.inr ⟨x, hx, h⟩, rfl⟩
  have hcard : Nat.card (Fin c ⊕ ι') = finrank κ V := by
    rw [hcardB, ← hrange]
    exact Nat.card_congr (Equiv.ofInjective w' hinj)
  have hfinS : Finite (Fin c ⊕ ι') :=
    Finite.of_injective (fun x => (⟨w' x, by rw [← hrange]; exact ⟨x, rfl⟩⟩ : b))
      fun x y h => hinj (congrArg Subtype.val h)
  have hfinι : Finite ι' := Finite.of_injective (Sum.inr : ι' → Fin c ⊕ ι') Sum.inr_injective
  have hcard' : Nat.card ι' = finrank κ V - c := by
    rw [← hcard, Nat.card_sum]; simp
  let eι : ι' ≃ Fin (finrank κ V - c) := Finite.equivFinOfCardEq hcard'
  have hle : c ≤ finrank κ V := by
    rw [← hcard, Nat.card_sum]; simp
  let e : Fin c ⊕ ι' ≃ Fin (finrank κ V) :=
    ((Equiv.sumCongr (Equiv.refl _) eι).trans finSumFinEquiv).trans (finCongr (by omega))
  have he : ∀ (i : Fin c), e (Sum.inl i) = ⟨i, by omega⟩ := by
    intro i
    simp [e, finSumFinEquiv_apply_left]
    rfl
  have hli : LinearIndependent κ w' :=
    (linearIndepOn_id_range_iff hinj).mp (by rw [hrange]; exact hb)
  refine ⟨w' ∘ e.symm, ?_, ?_, hli.comp _ e.symm.injective, ?_⟩
  · intro i h
    have : e.symm i = Sum.inl ⟨i, h⟩ := by
      rw [Equiv.symm_apply_eq, he]
    simp [this, w']
  · intro j
    refine hbT ?_
    rw [← hrange]
    exact ⟨e.symm j, rfl⟩
  · rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hrange]; exact hspan

private theorem span_tmul_D_eq_top {A0 R : Type*} [CommRing A0] [CommRing R] [Algebra A0 R]
    [IsLocalRing R] :
    Submodule.span (ResidueField R)
      {v : ResidueField R ⊗[R] Ω[R⁄A0] | ∃ a : R, v = 1 ⊗ₜ[R] KaehlerDifferential.D A0 R a} =
      ⊤ := by
  have : {v : ResidueField R ⊗[R] Ω[R⁄A0] | ∃ a : R, v = 1 ⊗ₜ[R] KaehlerDifferential.D A0 R a}
      = TensorProduct.mk R _ _ 1 '' Set.range (KaehlerDifferential.D A0 R) := by
    ext; simp [eq_comm]
  rw [this, ← Submodule.baseChange_span, KaehlerDifferential.span_range_derivation,
    Submodule.baseChange_top]

private theorem image_lt_eq_take {R : Type*} (ts : List R) {r n : ℕ} (hr : r ≤ ts.length)
    (hn : r ≤ n) (a : Fin n → R)
    (h : ∀ (i : Fin n) (hi : (i : ℕ) < r), a i = ts[(i : ℕ)]'(lt_of_lt_of_le hi hr)) :
    a '' {i | (i : ℕ) < r} = {x | x ∈ ts.take r} := by
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨i, hi, rfl⟩
    rw [h i hi]
    exact List.mem_iff_getElem.mpr ⟨i, by simp [List.length_take]; omega, by simp⟩
  · intro hx
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hx
    have hi' : i < r := by simp [List.length_take] at hi; omega
    refine ⟨⟨i, by omega⟩, hi', ?_⟩
    rw [h _ hi']
    simp

private theorem span_range_images_eq_maximalIdeal {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (φ : R →+* S) (hφ : Function.Surjective φ)
    (ts : List R) (hm : Ideal.ofList ts = maximalIdeal R) {r : ℕ} (hr : r ≤ ts.length)
    (hker : Ideal.ofList (ts.take r) ≤ RingHom.ker φ) :
    Ideal.span (Set.range (fun j : Fin (ts.length - r) =>
      φ (ts[r + (j : ℕ)]'(by omega)))) = maximalIdeal S := by
  have hmap : Ideal.map φ (maximalIdeal R) = maximalIdeal S := map_maximalIdeal_of_surjective φ hφ
  have hsplit : Ideal.ofList (ts.map φ) = Ideal.ofList ((ts.take r).map φ) ⊔
      Ideal.ofList ((ts.drop r).map φ) := by
    conv_lhs => rw [← List.take_append_drop r ts]
    rw [List.map_append, Ideal.ofList_append]
  rw [← hmap, ← hm, Ideal.map_ofList, hsplit]
  have h0 : Ideal.ofList ((ts.take r).map φ) = ⊥ := by
    rw [← Ideal.map_ofList]
    exact Ideal.map_eq_bot_iff_le_ker φ |>.mpr hker
  rw [h0, bot_sup_eq]
  refine congrArg _ (Set.ext fun x => ?_)
  constructor
  · rintro ⟨j, rfl⟩
    exact List.mem_map.mpr ⟨ts[r + (j : ℕ)], List.mem_iff_getElem.mpr
      ⟨j, by simp, by simp⟩, rfl⟩
  · intro hx
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hx
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hy
    exact ⟨⟨j, by simp at hj; omega⟩, by simp⟩

end LinearAlgebraHelpers

section StalkHelpers

open IsLocalRing

private theorem stalk_eq_ker_stalkMap (D : X.IdealSheafData) (d : D.subscheme) :
    AlgebraicGeometry.IdealSheafData.stalk D (D.subschemeι d) =
      RingHom.ker (D.subschemeι.stalkMap d).hom := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset
    (show D.subschemeι d ∈ (⊤ : X.Opens) from trivial)
  have := AlgebraicGeometry.stalk_ker_eq_of_affine_target D.subschemeι d U hU hxU
  rwa [D.ker_subschemeι] at this

private theorem ringKrullDim_stalk_eq_add (f : X ⟶ Spec (.of k)) [Smooth f] (D : X.IdealSheafData)
    [Smooth (D.subschemeι ≫ f)] (d : D.subscheme) {r : ℕ}
    (hr : topologicalKrullDimAt X (D.subschemeι d) = topologicalKrullDimAt D.subscheme d + r) :
    ringKrullDim (X.presheaf.stalk (D.subschemeι d)) =
      ringKrullDim (D.subscheme.presheaf.stalk d) + r := by
  have hX := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k X f (D.subschemeι d)
  have hD := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k D.subscheme
    (D.subschemeι ≫ f) d
  have htr := trdeg_residueField_of_surjectiveOnStalks k f D.subschemeι d
  have hfin := residueField_finTrdeg k f (D.subschemeι d)
  have h1 := isRegularLocalRing_stalk_of_smooth_over_field f (D.subschemeι d)
  have h2 := isRegularLocalRing_stalk_of_smooth_over_field (D.subschemeι ≫ f) d
  have d1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := X.presheaf.stalk (D.subschemeι d))
  have d2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := D.subscheme.presheaf.stalk d)
  rw [← d1, ← d2]
  let _ : Algebra k (X.residueField (D.subschemeι d)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation (D.subschemeι d)).hom.toAlgebra
  have hlt : Cardinal.toENat (Algebra.trdeg k (X.residueField (D.subschemeι d))) < ⊤ := by
    rw [Cardinal.toENat_lt_top]
    exact trdeg_lt_aleph0 k _
  rw [hX, hD, htr] at hr
  rw [htr] at hlt
  obtain ⟨t, ht⟩ := ENat.ne_top_iff_exists.mp hlt.ne
  rw [← ht] at hr
  have e1 : ∀ (m : ℕ), ((m : ℕ∞) : WithBot ℕ∞) = (m : WithBot ℕ∞) := fun m => rfl
  rw [e1, ← d1, ← d2] at hr
  have : ((t + Submodule.spanFinrank (maximalIdeal (X.presheaf.stalk (D.subschemeι d))) : ℕ) :
      WithBot ℕ∞) = ((t + (Submodule.spanFinrank (maximalIdeal (D.subscheme.presheaf.stalk d)) + r)
      : ℕ) : WithBot ℕ∞) := by
    push_cast
    rw [add_assoc] at hr
    exact hr
  have h3 := Nat.add_left_cancel (by exact_mod_cast this)
  rw [h3]; push_cast; rfl

private noncomputable def quotientStalkEquiv (D : X.IdealSheafData) (d : D.subscheme) :
    (X.presheaf.stalk (D.subschemeι d) ⧸
      AlgebraicGeometry.IdealSheafData.stalk D (D.subschemeι d)) ≃+*
      D.subscheme.presheaf.stalk d :=
  (Ideal.quotEquivOfEq (stalk_eq_ker_stalkMap D d)).trans
    (RingHom.quotientKerEquivOfSurjective (D.subschemeι.stalkMap_surjective d))

private theorem formallySmooth_quotient_stalk (f : X ⟶ Spec (.of k)) (D : X.IdealSheafData)
    [Smooth (D.subschemeι ≫ f)] (d : D.subscheme) :
    letI := (f.stalkMap (D.subschemeι d)).hom.toAlgebra
    Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f (D.subschemeι d)))
      (X.presheaf.stalk (D.subschemeι d) ⧸
      AlgebraicGeometry.IdealSheafData.stalk D (D.subschemeι d)) := by
  let _ := (f.stalkMap (D.subschemeι d)).hom.toAlgebra
  let _ : Algebra ((Spec (.of k)).presheaf.stalk (f (D.subschemeι d)))
    (D.subscheme.presheaf.stalk d) := ((D.subschemeι ≫ f).stalkMap d).hom.toAlgebra
  have hfs : Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f (D.subschemeι d)))
      (D.subscheme.presheaf.stalk d) :=
    InfinitesimalLifting.SmoothAt.formallySmooth_stalkMap (D.subschemeι ≫ f) d
      (InfinitesimalLifting.smoothAt_of_smooth _ d)
  let e : (X.presheaf.stalk (D.subschemeι d) ⧸
      AlgebraicGeometry.IdealSheafData.stalk D (D.subschemeι d)) ≃ₐ[
        (Spec (.of k)).presheaf.stalk (f (D.subschemeι d))] D.subscheme.presheaf.stalk d :=
    AlgEquiv.ofRingEquiv (f := quotientStalkEquiv D d) (fun a => by
      change (D.subschemeι.stalkMap d).hom ((f.stalkMap (D.subschemeι d)).hom a) =
        ((D.subschemeι ≫ f).stalkMap d).hom a
      rw [Scheme.Hom.stalkMap_comp]; rfl)
  exact Algebra.FormallySmooth.of_equiv e.symm

/-- The module of differentials of the stalk of a smooth `k`-scheme is finite free. -/
private theorem kaehler_stalk_free_finite (f : X ⟶ Spec (.of k)) [Smooth f] (p : X) :
    letI := (f.stalkMap p).hom.toAlgebra
    Module.Free (X.presheaf.stalk p) Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] ∧
    Module.Finite (X.presheaf.stalk p)
      Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] := by
  let _ := (f.stalkMap p).hom.toAlgebra
  have hfs : Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p) :=
    InfinitesimalLifting.SmoothAt.formallySmooth_stalkMap f p
      (InfinitesimalLifting.smoothAt_of_smooth f p)
  have : Algebra.EssFiniteType ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p) :=
    RingHom.essFiniteType_algebraMap.mp (LocallyOfFiniteType.stalkMap f p)
  have : Module.Flat (X.presheaf.stalk p)
      Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] := Module.Flat.of_projective
  exact ⟨Module.free_of_flat_of_isLocalRing, inferInstance⟩

private theorem ringKrullDim_stalk_eq_of_isClosed (f : X ⟶ Spec (.of k)) [Smooth f] (p : X)
    (hp : IsClosed ({p} : Set X)) {n : ℕ} (hn : topologicalKrullDimAt X p = n) :
    ringKrullDim (X.presheaf.stalk p) = n := by
  have hX := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k X f p
  have h0 : letI : Algebra k (X.residueField p) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation p).hom.toAlgebra
      Algebra.trdeg k (X.residueField p) = 0 := by
    let _ : Algebra k ((Spec (.of k)).residueField (f p)) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ (Spec (.of k)).Γevaluation (f p)).hom.toAlgebra
    let _ : Algebra k (X.residueField p) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation p).hom.toAlgebra
    let _ : Algebra ((Spec (.of k)).residueField (f p)) (X.residueField p) :=
      (f.residueFieldMap p).hom.toAlgebra
    have hst : IsScalarTower k ((Spec (.of k)).residueField (f p)) (X.residueField p) :=
      residueField_isScalarTower k f p
    have hfin : Module.Finite ((Spec (.of k)).residueField (f p)) (X.residueField p) :=
      finite_residueField_of_isClosed f hp
    have hsurj : Function.Surjective (algebraMap k ((Spec (.of k)).residueField (f p))) := by
      let q := (f p).asIdeal
      let e := Scheme.Spec.residueFieldIso (.of k) (f p)
      have : q.IsPrime := (f p).isPrime
      have : q.IsMaximal := by
        simpa [q.eq_bot_of_prime] using (Ideal.bot_isMaximal : (⊥ : Ideal k).IsMaximal)
      have heq : ((Scheme.ΓSpecIso (.of k)).inv ≫ (Spec (.of k)).Γevaluation (f p)).hom =
          e.inv.hom.comp (algebraMap k q.ResidueField) := by
        simpa [e, q, Scheme.Γevaluation, Scheme.evaluation, RingHom.comp_assoc] using
          (congrArg CommRingCat.Hom.hom
            (Scheme.Spec.algebraMap_residueFieldIso_inv (.of k) (f p))).symm
      change Function.Surjective ((Scheme.ΓSpecIso (.of k)).inv ≫
        (Spec (.of k)).Γevaluation (f p)).hom
      rw [heq]
      exact (e.symm.commRingCatIsoToRingEquiv.surjective).comp q.algebraMap_residueField_surjective
    have : Algebra.IsAlgebraic k ((Spec (.of k)).residueField (f p)) := ⟨fun r => by
      obtain ⟨a, rfl⟩ := hsurj r
      exact isAlgebraic_algebraMap a⟩
    have : Algebra.IsAlgebraic ((Spec (.of k)).residueField (f p)) (X.residueField p) :=
      Algebra.IsAlgebraic.of_finite _ _
    have : Algebra.IsAlgebraic k (X.residueField p) :=
      Algebra.IsAlgebraic.trans k ((Spec (.of k)).residueField (f p)) _
    exact trdeg_eq_zero
  rw [h0] at hX
  simpa [hn] using hX.symm

private theorem exists_open_restrict_eq {Y : Scheme.{u}} {U1 U2 : Y.Opens} {y : Y} (h1 : y ∈ U1)
    (h2 : y ∈ U2) (s : Γ(Y, U1)) (t : Γ(Y, U2))
    (h : (Y.presheaf.germ U1 y h1).hom s = (Y.presheaf.germ U2 y h2).hom t) :
    ∃ (W : Y.Opens) (_ : y ∈ W) (hW1 : W ≤ U1) (hW2 : W ≤ U2),
      (Y.presheaf.map (homOfLE hW1).op).hom s = (Y.presheaf.map (homOfLE hW2).op).hom t := by
  obtain ⟨W, hW, i1, i2, e⟩ := Y.presheaf.germ_eq y h1 h2 s t h
  exact ⟨W, hW, i1.le, i2.le, e⟩

private theorem res_res {Y : Scheme.{u}} {A B C : Y.Opens} (h1 : A ≤ B) (h2 : B ≤ C)
    (s : Γ(Y, C)) :
    (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom s) =
      (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
  rw [← CommRingCat.comp_apply, ← Y.presheaf.map_comp]; rfl

private theorem app_res_eq {X Z : Scheme.{u}} (ι : Z ⟶ X) {U V : X.Opens} (h : U ≤ V)
    (s : Γ(X, V)) :
    (ι.app U).hom ((X.presheaf.map (homOfLE h).op).hom s) =
      (Z.presheaf.map (homOfLE (show ι ⁻¹ᵁ U ≤ ι ⁻¹ᵁ V from fun _ hq => h hq)).op).hom
        ((ι.app V).hom s) :=
  congrArg (fun m => m.hom s) (ι.naturality (homOfLE h).op)

end StalkHelpers

/-- On every affine open `V ⊆ U`, the ideal `I_Z(V)` is generated by the restrictions of the
first `r` of the sections `x_1, …, x_n ∈ 𝒪_X(U)`: `Z ∩ U = V(x_1, …, x_r)` as closed subschemes
of `U`. -/
def IsCutOutByFirst (Z : X.IdealSheafData) (U : X.Opens) {n : ℕ} (x : Fin n → Γ(X, U))
    (r : ℕ) : Prop :=
  ∀ (V : X.affineOpens) (h : V.1 ≤ U),
    Z.ideal V = Ideal.span ((fun i => (X.presheaf.map (homOfLE h).op).hom (x i)) ''
      {i | (i : ℕ) < r})

/-- Restricting the generators to a smaller open keeps the ideal sheaf cut out by them. -/
theorem IsCutOutByFirst.restrict {Z : X.IdealSheafData} {U U' : X.Opens} (h : U' ≤ U)
    {n : ℕ} {x : Fin n → Γ(X, U)} {x' : Fin n → Γ(X, U')}
    (hx : ∀ i, x' i = (X.presheaf.map (homOfLE h).op).hom (x i)) {r : ℕ}
    (hZ : IsCutOutByFirst Z U x r) : IsCutOutByFirst Z U' x' r := by
  obtain rfl : x' = _ := funext hx
  intro V hV
  rw [hZ V (hV.trans h)]
  congr 1
  exact Set.image_congr fun i _ => (res_res _ _ _).symm

/-- Local coordinates on `U` restrict to local coordinates on a smaller open. -/
private theorem isLocalCoordinatesOn_restrict {sX : X ⟶ Spec (.of k)} {U U' : X.Opens}
    (h : U' ≤ U) {n : ℕ} {x : Fin n → Γ(X, U)} {x' : Fin n → Γ(X, U')}
    (hx : ∀ i, x' i = (X.presheaf.map (homOfLE h).op).hom (x i))
    (H : MMP.Resolution.IsLocalCoordinatesOn sX U x) :
    MMP.Resolution.IsLocalCoordinatesOn sX U' x' := by
  intro W hW
  obtain ⟨b, hb⟩ := H W (hW.trans h)
  refine ⟨b, fun i => ?_⟩
  rw [hb i]
  congr 1
  simp only [MMP.Resolution.restrictSection, hx]
  exact (res_res _ _ _).symm

/-- **Spreading generation of an ideal at a stalk to a neighbourhood.** -/
private theorem exists_isCutOutByFirst_of_stalk_eq_span [IsLocallyNoetherian X]
    (Z : X.IdealSheafData) (p : X) (V : X.Opens) (hV : IsAffineOpen V) (hpV : p ∈ V) {n : ℕ}
    (g : Fin n → Γ(X, V)) (r : ℕ)
    (h : Ideal.span ((fun i => (X.presheaf.germ V p hpV).hom (g i)) '' {i | (i : ℕ) < r}) =
      AlgebraicGeometry.IdealSheafData.stalk Z p) :
    ∃ (U : X.Opens) (_ : p ∈ U) (hUV : U ≤ V),
      IsCutOutByFirst Z U (fun i => (X.presheaf.map (homOfLE hUV).op).hom (g i)) r := by
  classical
  let _ : Algebra Γ(X, V) (X.presheaf.stalk p) := X.presheaf.algebra_section_stalk ⟨p, hpV⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk p) (hV.primeIdealOf ⟨p, hpV⟩).asIdeal :=
    hV.isLocalization_stalk ⟨p, hpV⟩
  have : IsNoetherianRing Γ(X, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  set I : Ideal Γ(X, V) := Z.ideal ⟨V, hV⟩ with hI
  set J : Ideal Γ(X, V) := Ideal.span (g '' {i | (i : ℕ) < r}) with hJ
  have hmap : I.map (algebraMap Γ(X, V) (X.presheaf.stalk p)) =
      J.map (algebraMap Γ(X, V) (X.presheaf.stalk p)) := by
    have e1 : Ideal.span ((fun i => (X.presheaf.germ V p hpV).hom (g i)) '' {i | (i : ℕ) < r}) =
        I.map (X.presheaf.germ V p hpV).hom :=
      h.trans (AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ Z p ⟨V, hV⟩ hpV)
    have e2 : J.map (algebraMap Γ(X, V) (X.presheaf.stalk p)) =
        Ideal.span ((fun i => (X.presheaf.germ V p hpV).hom (g i)) '' {i | (i : ℕ) < r}) := by
      rw [hJ, Ideal.map_span, Set.image_image]; rfl
    rw [e2, e1]; rfl
  obtain ⟨s1, hs1, h1⟩ := exists_mul_mem_of_map_le
    (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl I J (IsNoetherian.noetherian I) hmap.le
  obtain ⟨s2, hs2, h2⟩ := exists_mul_mem_of_map_le
    (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl J I (IsNoetherian.noetherian J) hmap.ge
  set s : Γ(X, V) := s1 * s2 with hs
  have hsM : s ∈ (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl := Submonoid.mul_mem _ hs1 hs2
  have hsI : ∀ a ∈ I, s * a ∈ J := fun a ha => by
    rw [hs, mul_comm s1, mul_assoc]; exact J.mul_mem_left _ (h1 a ha)
  have hsJ : ∀ a ∈ J, s * a ∈ I := fun a ha => by
    rw [hs, mul_assoc]; exact I.mul_mem_left _ (h2 a ha)
  have hpU : p ∈ X.basicOpen s := by
    rw [X.mem_basicOpen s p hpV]
    exact IsLocalization.map_units (X.presheaf.stalk p)
      (⟨s, hsM⟩ : (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl)
  have hUV : X.basicOpen s ≤ V := X.basicOpen_le s
  have := hV.isLocalization_basicOpen s
  have hT : I.map (algebraMap Γ(X, V) Γ(X, X.basicOpen s)) =
      J.map (algebraMap Γ(X, V) Γ(X, X.basicOpen s)) :=
    le_antisymm (map_algebraMap_le_of_mul_mem s hsI) (map_algebraMap_le_of_mul_mem s hsJ)
  refine ⟨X.basicOpen s, hpU, hUV, ?_⟩
  intro V' hV'
  have hU' : IsAffineOpen (X.basicOpen s) := hV.basicOpen s
  have e1 : Z.ideal V' = (Z.ideal ⟨X.basicOpen s, hU'⟩).map
      (X.presheaf.map (homOfLE hV').op).hom :=
    (Z.map_ideal (U := V') (V := ⟨X.basicOpen s, hU'⟩) hV').symm
  have e2 : Z.ideal ⟨X.basicOpen s, hU'⟩ = I.map (X.presheaf.map (homOfLE hUV).op).hom :=
    (Z.map_ideal (U := ⟨X.basicOpen s, hU'⟩) (V := ⟨V, hV⟩) hUV).symm
  rw [e1, e2]
  have e3 : I.map (X.presheaf.map (homOfLE hUV).op).hom =
      J.map (X.presheaf.map (homOfLE hUV).op).hom := hT
  rw [e3, Ideal.map_map, hJ, Ideal.map_span, Set.image_image]
  congr 1

/-- The stalk-level data of a smooth closed subscheme `D ⊆ X` at a point `p = ι d`: the quotient
of the local ring is regular and formally smooth over the base stalk, and the codimension is read
off from the dimensions at `p`. -/
private theorem stalk_data_of_smooth_closed (f : X ⟶ Spec (.of k)) [Smooth f]
    (D : X.IdealSheafData) [Smooth (D.subschemeι ≫ f)] (d : D.subscheme) (p : X)
    (hp : D.subschemeι d = p) {e : ℕ}
    (he : topologicalKrullDimAt X p = topologicalKrullDimAt D.subscheme d + e) :
    IsRegularLocalRing (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk D p) ∧
      (letI := (f.stalkMap p).hom.toAlgebra;
        Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f p))
          (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk D p)) ∧
      ringKrullDim (X.presheaf.stalk p) =
        ringKrullDim (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk D p) + e := by
  subst hp
  have hreg : IsRegularLocalRing (D.subscheme.presheaf.stalk d) :=
    AlgebraicGeometry.isRegularLocalRing_stalk_of_smooth_over_field (D.subschemeι ≫ f) d
  refine ⟨IsRegularLocalRing.of_ringEquiv (quotientStalkEquiv D d).symm,
    formallySmooth_quotient_stalk f D d, ?_⟩
  rw [ringKrullDim_eq_of_ringEquiv (quotientStalkEquiv D d)]
  exact ringKrullDim_stalk_eq_add f D d he

open IsLocalRing in
/-- **Adapted étale coordinates, from the data at the stalk.** Let `X` be smooth over `k`,
`W ≤ Z` ideal sheaves on `X` and `p ∈ X` such that the quotients of `𝒪_{X,p}` by the stalks of
`W` and `Z` are regular local rings, the one by `Z` formally smooth over the base stalk, and
`dim 𝒪_{X,p} = dim 𝒪_{X,p}/I_{W,p} + s = dim 𝒪_{X,p}/I_{Z,p} + r`. Then `r ≤ n`, where
`n = rank_p Ω_{X/k}`, and there are an affine open `U ∋ p` and local coordinates
`x_1, …, x_n` on `U` with `W ∩ U = V(x_1, …, x_s)` and `Z ∩ U = V(x_1, …, x_r)`.

Only the stalks at `p` enter, so this applies to closed subschemes smooth near `p` only. -/
theorem exists_isLocalCoordinates_isCutOutByFirst_of_stalk (f : X ⟶ Spec (.of k)) [Smooth f]
    (W Z : X.IdealSheafData) (hWZ : W ≤ Z) (p : X) {r s : ℕ}
    (hWreg : IsRegularLocalRing (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk W p))
    (hZreg : IsRegularLocalRing (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk Z p))
    (hZsm : letI := (f.stalkMap p).hom.toAlgebra
      Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f p))
        (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk Z p))
    (hs : ringKrullDim (X.presheaf.stalk p) =
      ringKrullDim (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk W p) + s)
    (hr : ringKrullDim (X.presheaf.stalk p) =
      ringKrullDim (X.presheaf.stalk p ⧸ AlgebraicGeometry.IdealSheafData.stalk Z p) + r) :
    letI := (f.stalkMap p).hom.toAlgebra
    r ≤ Module.finrank (X.presheaf.stalk p)
        Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] ∧
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (_ : p ∈ U)
      (x : Fin (Module.finrank (X.presheaf.stalk p)
        Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)]) → Γ(X, U)),
      MMP.Resolution.IsLocalCoordinates f U x ∧ IsCutOutByFirst W U x s ∧
        IsCutOutByFirst Z U x r := by
  classical
  let _ := (f.stalkMap p).hom.toAlgebra
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hRreg := AlgebraicGeometry.isRegularLocalRing_stalk_of_smooth_over_field f p
  set JW := AlgebraicGeometry.IdealSheafData.stalk W p with hJW
  set JZ := AlgebraicGeometry.IdealSheafData.stalk Z p with hJZ
  have hle : JW ≤ JZ := by
    obtain ⟨U, hU, hpU, -⟩ := exists_isAffineOpen_mem_and_subset
      (show p ∈ (⊤ : X.Opens) from trivial)
    rw [hJW, hJZ, AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ W p ⟨U, hU⟩ hpU,
      AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ Z p ⟨U, hU⟩ hpU]
    exact Ideal.map_mono ((Scheme.IdealSheafData.le_def.mp hWZ) ⟨U, hU⟩)
  obtain ⟨ts, hts_m, hts_len, hsr, hr_len, hJWts, hJZts⟩ :=
    exists_parameters_flag JW JZ hle hWreg hZreg hs hr
  have hmem : ∀ i : Fin ts.length, ts[i] ∈ maximalIdeal (X.presheaf.stalk p) := fun i => by
    rw [← hts_m]; exact Ideal.subset_span (List.getElem_mem i.2)
  have hind := linearIndependent_cotangent_of_ofList ts hts_m hts_len hmem
  have hJm : JZ ≤ maximalIdeal (X.presheaf.stalk p) :=
    le_maximalIdeal (Ideal.Quotient.nontrivial_iff.mp inferInstance)
  let t : Fin r → X.presheaf.stalk p := fun i => ts[(i : ℕ)]'(lt_of_lt_of_le i.2 hr_len)
  have htJ : ∀ i, t i ∈ JZ := fun i => by
    rw [← hJZts]
    exact Ideal.subset_span (List.mem_iff_getElem.mpr
      ⟨i, by simp [List.length_take]; omega, by simp [t]⟩)
  have hind' : LinearIndependent (ResidueField (X.presheaf.stalk p))
      (fun i : Fin r => (maximalIdeal (X.presheaf.stalk p)).toCotangent ⟨t i, hJm (htJ i)⟩) :=
    hind.comp (Fin.castLE hr_len) (Fin.castLE_injective hr_len)
  have hfs : Algebra.FormallySmooth ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p) :=
    InfinitesimalLifting.SmoothAt.formallySmooth_stalkMap f p
      (InfinitesimalLifting.smoothAt_of_smooth f p)
  have := hZsm
  have hv := linearIndependent_tmul_D_of_cotangent
    (A0 := (Spec (.of k)).presheaf.stalk (f p)) JZ hJm t htJ hind'
  obtain ⟨hfree, hfinite⟩ := kaehler_stalk_free_finite f p
  have hdimV : Module.finrank (ResidueField (X.presheaf.stalk p))
      (ResidueField (X.presheaf.stalk p) ⊗[X.presheaf.stalk p]
        Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)]) =
      Module.finrank (X.presheaf.stalk p)
        Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] :=
    Module.finrank_baseChange
  obtain ⟨n, hn⟩ : ∃ n, Module.finrank (X.presheaf.stalk p)
      Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] = n := ⟨_, rfl⟩
  have hrn : r ≤ n := by
    rw [← hn, ← hdimV]
    simpa using hv.fintype_card_le_finrank
  obtain ⟨w, hw1, hwT, hwli, hwsp⟩ := exists_basis_extension_in
    {v : ResidueField (X.presheaf.stalk p) ⊗[X.presheaf.stalk p]
        Ω[X.presheaf.stalk p ⁄ (Spec (.of k)).presheaf.stalk (f p)] |
      ∃ a : X.presheaf.stalk p, v = 1 ⊗ₜ[X.presheaf.stalk p]
        KaehlerDifferential.D ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p) a}
    span_tmul_D_eq_top _ hv (fun i => ⟨t i, rfl⟩)
    n (hdimV.trans hn)
  choose a0 ha0 using hwT
  let a : Fin n → X.presheaf.stalk p := fun j =>
    if h : (j : ℕ) < r then ts[(j : ℕ)]'(lt_of_lt_of_le h hr_len) else a0 j
  have ha : ∀ (j : Fin n) (h : (j : ℕ) < r), a j = ts[(j : ℕ)]'(lt_of_lt_of_le h hr_len) :=
    fun j h => by simp [a, h]
  have haw : ∀ j, w j = 1 ⊗ₜ[X.presheaf.stalk p]
      KaehlerDifferential.D ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p) (a j) := by
    intro j
    by_cases h : (j : ℕ) < r
    · rw [hw1 j h, ha j h]
    · simp only [a, h, dite_false]; exact ha0 j
  obtain ⟨V, hV, hpV, g, hg⟩ := MMP.Flips.ResolutionInputs.exists_affineOpen_germ_eq p a
  have hga : (fun i => (X.presheaf.germ V p hpV).hom (g i)) = a := funext hg
  have hZspan : Ideal.span ((fun i => (X.presheaf.germ V p hpV).hom (g i)) '' {i | (i : ℕ) < r}) =
      JZ := by
    rw [hga, image_lt_eq_take ts hr_len hrn a ha]
    exact hJZts
  have hWspan : Ideal.span ((fun i => (X.presheaf.germ V p hpV).hom (g i)) '' {i | (i : ℕ) < s}) =
      JW := by
    rw [hga, image_lt_eq_take ts (hsr.trans hr_len) (hsr.trans hrn) a
      (fun i hi => ha i (lt_of_lt_of_le hi hsr))]
    exact hJWts
  obtain ⟨UZ, hpUZ, hUZV, hUZ⟩ := exists_isCutOutByFirst_of_stalk_eq_span Z p V hV hpV g r hZspan
  obtain ⟨UW, hpUW, hUWV, hUW⟩ := exists_isCutOutByFirst_of_stalk_eq_span W p V hV hpV g s hWspan
  obtain ⟨V0, hV0, hpV0, hV0sub⟩ := exists_isAffineOpen_mem_and_subset
    (show p ∈ UZ ⊓ UW from ⟨hpUZ, hpUW⟩)
  have hV0Z : V0 ≤ UZ := fun x hx => (hV0sub hx).1
  have hV0W : V0 ≤ UW := fun x hx => (hV0sub hx).2
  have hV0V : V0 ≤ V := hV0Z.trans hUZV
  let g0 : Fin n → Γ(X, V0) := fun i => (X.presheaf.map (homOfLE hV0V).op).hom (g i)
  have hg0 : ∀ i, (X.presheaf.germ V0 p hpV0).hom (g0 i) = a i := fun i => by
    simp only [g0]
    rw [← CommRingCat.comp_apply, X.presheaf.germ_res (homOfLE hV0V) p hpV0]
    exact hg i
  obtain ⟨U, hU, hpU, hUV0, hetale⟩ :=
    MMP.Flips.ResolutionInputs.exists_isAffineOpen_etale_homOfVector f p V0 hpV0 g0 (by
      have hv0 : (fun i => (1 : ResidueField (X.presheaf.stalk p)) ⊗ₜ[X.presheaf.stalk p]
          KaehlerDifferential.D ((Spec (.of k)).presheaf.stalk (f p)) (X.presheaf.stalk p)
            ((X.presheaf.germ V0 p hpV0).hom (g0 i))) = w := by
        funext i
        rw [hg0 i, haw i]
      rw [hv0]
      exact ⟨hwli, hwsp⟩)
  subst hn
  refine ⟨hrn, U, hU, hpU, fun i => (X.presheaf.map (homOfLE (hUV0.trans hV0V)).op).hom (g i),
    ?_, ?_, ?_⟩
  · unfold MMP.Resolution.IsLocalCoordinates
    convert hetale using 4
    simp only [g0]
    rw [← CommRingCat.comp_apply, ← X.presheaf.map_comp]
    rfl
  · exact hUW.restrict (hUV0.trans hV0W) fun i => (res_res _ _ _).symm
  · exact hUZ.restrict (hUV0.trans hV0Z) fun i => (res_res _ _ _).symm

/-- **Étale coordinates adapted to a smooth flag.** Let `X` be smooth over `k`, `Z ⊆ W ⊆ X`
closed subschemes smooth over `k` (`W = X` allowed), `p ∈ Z`, and let `r` and `s` be the
codimensions at `p` of `Z` and of `W` in `X`. Then there are an affine open neighbourhood `U` of
`p` and local coordinates `x_1, …, x_n` on `U` with `W ∩ U = V(x_1, …, x_s)` and
`Z ∩ U = V(x_1, …, x_r)` as closed subschemes of `U`. -/
@[mmp "lem_mmp_foundation_smooth_flag_etale_coordinates"]
theorem exists_isLocalCoordinates_adapted_flag (f : X ⟶ Spec (.of k)) [Smooth f]
    (W Z : X.IdealSheafData) (hWZ : W ≤ Z) [Smooth (W.subschemeι ≫ f)]
    [Smooth (Z.subschemeι ≫ f)] (z : Z.subscheme) (w : W.subscheme)
    (hw : W.subschemeι w = Z.subschemeι z) {r s : ℕ}
    (hr : topologicalKrullDimAt X (Z.subschemeι z) = topologicalKrullDimAt Z.subscheme z + r)
    (hs : topologicalKrullDimAt X (W.subschemeι w) = topologicalKrullDimAt W.subscheme w + s) :
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (_ : Z.subschemeι z ∈ U) (n : ℕ)
      (x : Fin n → Γ(X, U)), MMP.Resolution.IsLocalCoordinates f U x ∧
        IsCutOutByFirst W U x s ∧ IsCutOutByFirst Z U x r := by
  obtain ⟨hWreg, -, hs'⟩ := stalk_data_of_smooth_closed f W w (Z.subschemeι z) hw
    (by rw [← hw]; exact hs)
  obtain ⟨hZreg, hZsm, hr'⟩ := stalk_data_of_smooth_closed f Z z (Z.subschemeι z) rfl hr
  obtain ⟨-, U, hU, hpU, x, h1, h2, h3⟩ := exists_isLocalCoordinates_isCutOutByFirst_of_stalk
    f W Z hWZ (Z.subschemeι z) hWreg hZreg hZsm hs' hr'
  exact ⟨U, hU, hpU, _, x, h1, h2, h3⟩

/-- **A smooth closed pair is locally the pullback of a coordinate subspace.** Let `X` be smooth
over `k`, `Z ⊆ X` a closed subscheme smooth over `k`, `z ∈ Z`, `n = rank_z Ω_{X/k}` and `c` the
codimension of `Z` in `X` at `z`. Then there are an affine open neighbourhood `U` of `z` and an
étale morphism `g = (x_1, …, x_n) : U ⟶ 𝔸^n_k` with `Z ∩ U = g⁻¹(V(x_1, …, x_c))`
scheme-theoretically. -/
@[mmp "lem_mmp_foundation_smooth_pair_etale_coordinates"]
theorem exists_isLocalCoordinates_adapted (f : X ⟶ Spec (.of k)) [Smooth f]
    (Z : X.IdealSheafData) [Smooth (Z.subschemeι ≫ f)] (z : Z.subscheme) {c : ℕ}
    (hc : topologicalKrullDimAt X (Z.subschemeι z) = topologicalKrullDimAt Z.subscheme z + c) :
    letI := (f.stalkMap (Z.subschemeι z)).hom.toAlgebra
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (_ : Z.subschemeι z ∈ U)
      (x : Fin (Module.finrank (X.presheaf.stalk (Z.subschemeι z))
        Ω[X.presheaf.stalk (Z.subschemeι z) ⁄ (Spec (.of k)).presheaf.stalk
          (f (Z.subschemeι z))]) → Γ(X, U)),
      MMP.Resolution.IsLocalCoordinates f U x ∧ IsCutOutByFirst Z U x c := by
  obtain ⟨hZreg, hZsm, hr'⟩ := stalk_data_of_smooth_closed f Z z (Z.subschemeι z) rfl hc
  obtain ⟨-, U, hU, hpU, x, h1, -, h3⟩ := exists_isLocalCoordinates_isCutOutByFirst_of_stalk
    f Z Z le_rfl (Z.subschemeι z) hZreg hZreg hZsm hr' hr'
  exact ⟨U, hU, hpU, x, h1, h3⟩

/-- **At a closed point a smooth pair has adapted coordinates all vanishing at the point.** Let
`X` be smooth of finite type over a field `k` of characteristic `0`, `Z ⊂ X` a closed subscheme
smooth over `k`, `p ∈ Z` a closed point, `n = dim_p X` and `r = codim_p(Z, X)`. Then there are an
open neighbourhood `U` of `p` and local coordinates `x_1, …, x_n` at `p` on `U` with
`Z ∩ U = (x_1 = ⋯ = x_r = 0)` as subschemes, such that `x_{r+1}|_{Z ∩ U}, …, x_n|_{Z ∩ U}` are
local coordinates on `Z ∩ U`. -/
@[mmp "lem_mmp_foundation_closed_smooth_pair_parameters"]
theorem exists_isLocalCoordinatesAt_adapted [CharZero k] (f : X ⟶ Spec (.of k)) [Smooth f]
    (Z : X.IdealSheafData) [Smooth (Z.subschemeι ≫ f)]
    (z : Z.subscheme) (hz : IsClosed {Z.subschemeι z}) {n r : ℕ}
    (hn : topologicalKrullDimAt X (Z.subschemeι z) = n)
    (hr : topologicalKrullDimAt X (Z.subschemeι z) = topologicalKrullDimAt Z.subscheme z + r) :
    ∃ (U : X.Opens) (hU : Z.subschemeι z ∈ U) (x : Fin n → Γ(X, U)),
      MMP.Resolution.IsLocalCoordinatesAt f U x (Z.subschemeι z) hU ∧ IsCutOutByFirst Z U x r ∧
      ∃ hrn : r ≤ n, MMP.Resolution.IsLocalCoordinatesOn (Z.subschemeι ≫ f) (Z.subschemeι ⁻¹ᵁ U)
        (fun j : Fin (n - r) => (Z.subschemeι.app U).hom (x ⟨r + j, by omega⟩)) := by
  classical
  obtain ⟨hZreg, hZsm, hr'⟩ := stalk_data_of_smooth_closed f Z z (Z.subschemeι z) rfl hr
  have hdimR := ringKrullDim_stalk_eq_of_isClosed f (Z.subschemeι z) hz hn
  have hRreg := AlgebraicGeometry.isRegularLocalRing_stalk_of_smooth_over_field f (Z.subschemeι z)
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨ts, hts_m, hts_len, -, hr_len, -, hJZts⟩ := exists_parameters_flag
    (AlgebraicGeometry.IdealSheafData.stalk Z (Z.subschemeι z))
    (AlgebraicGeometry.IdealSheafData.stalk Z (Z.subschemeι z)) le_rfl hZreg hZreg hr' hr'
  have hlen : ts.length = n := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal
      (R := X.presheaf.stalk (Z.subschemeι z))
    rw [hdimR, ← hts_len] at h1
    exact_mod_cast h1
  subst hlen
  let tX : Fin ts.length → X.presheaf.stalk (Z.subschemeι z) := fun i => ts[(i : ℕ)]'i.2
  have htX : MMP.Mori.IsRegularSystemOfParameters tX := by
    refine ⟨?_, hdimR⟩
    rw [← hts_m]
    refine congrArg _ (Set.ext fun y => ?_)
    simp only [Set.mem_range, Set.mem_ofPred_eq, List.mem_iff_getElem]
    constructor
    · rintro ⟨i, rfl⟩; exact ⟨i, i.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩; exact ⟨⟨i, hi⟩, rfl⟩
  obtain ⟨V, hpV, x, hxgerm, hxcoord⟩ :=
    MMP.Flips.ResolutionInputs.exists_isLocalCoordinatesAt_of_isRegularSystemOfParameters f
      (Z.subschemeι z) hz tX htX
  -- the parameters on `Z`
  have hzcl : IsClosed ({z} : Set Z.subscheme) := by
    have : ({z} : Set Z.subscheme) = Z.subschemeι ⁻¹' {Z.subschemeι z} := by
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => h ▸ rfl, fun h => (Z.subschemeι.isEmbedding.injective h)⟩
    rw [this]; exact hz.preimage Z.subschemeι.continuous
  let φ := (Z.subschemeι.stalkMap z).hom
  have hφs : Function.Surjective φ := Z.subschemeι.stalkMap_surjective z
  have hker : Ideal.ofList (ts.take r) ≤ RingHom.ker φ := by
    rw [hJZts, ← stalk_eq_ker_stalkMap Z z]
  have hmZ := span_range_images_eq_maximalIdeal φ hφs ts hts_m hr_len hker
  have hdimZ :
      ringKrullDim (Z.subscheme.presheaf.stalk z) = ((ts.length - r : ℕ) : WithBot ℕ∞) := by
    have hreg : IsRegularLocalRing (Z.subscheme.presheaf.stalk z) :=
      AlgebraicGeometry.isRegularLocalRing_stalk_of_smooth_over_field (Z.subschemeι ≫ f) z
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Z.subscheme.presheaf.stalk z)
    rw [← h1]
    rw [ringKrullDim_eq_of_ringEquiv (quotientStalkEquiv Z z), ← h1] at hr'
    rw [hdimR] at hr'
    have : ts.length =
        Submodule.spanFinrank (IsLocalRing.maximalIdeal (Z.subscheme.presheaf.stalk z)) + r := by
      exact_mod_cast hr'
    congr 1
    omega
  let tZ : Fin (ts.length - r) → Z.subscheme.presheaf.stalk z :=
    fun j => φ (ts[r + (j : ℕ)]'(by omega))
  have htZ : MMP.Mori.IsRegularSystemOfParameters tZ := ⟨hmZ, hdimZ⟩
  obtain ⟨VZ, hzVZ, y, hygerm, hycoord⟩ :=
    MMP.Flips.ResolutionInputs.exists_isLocalCoordinatesAt_of_isRegularSystemOfParameters
      (Z.subschemeι ≫ f) z hzcl tZ htZ
  -- cut-out neighbourhood on `X`
  obtain ⟨V1, hV1, hpV1, hV1V⟩ := exists_isAffineOpen_mem_and_subset (U := V) hpV
  have hV1V' : V1 ≤ V := hV1V
  let g : Fin ts.length → Γ(X, V1) := fun i => (X.presheaf.map (homOfLE hV1V').op).hom (x i)
  have hgg : (fun i => (X.presheaf.germ V1 (Z.subschemeι z) hpV1).hom (g i)) = tX := by
    funext i
    simp only [g]
    rw [← CommRingCat.comp_apply, X.presheaf.germ_res (homOfLE hV1V') (Z.subschemeι z) hpV1]
    exact hxgerm i
  have hspan : Ideal.span ((fun i => (X.presheaf.germ V1 (Z.subschemeι z) hpV1).hom (g i)) ''
      {i | (i : ℕ) < r}) = AlgebraicGeometry.IdealSheafData.stalk Z (Z.subschemeι z) := by
    have himg := image_lt_eq_take ts hr_len hr_len tX (fun i hi => rfl)
    rw [hgg, himg]
    exact hJZts
  obtain ⟨U1, hpU1, hU1V1, hU1⟩ := exists_isCutOutByFirst_of_stalk_eq_span Z (Z.subschemeι z)
    V1 hV1 hpV1 g r hspan
  -- agreement of the two systems on `Z`
  have hzV : z ∈ Z.subschemeι ⁻¹ᵁ V := hpV
  have hgermZ : ∀ j : Fin (ts.length - r),
      (Z.subscheme.presheaf.germ (Z.subschemeι ⁻¹ᵁ V) z hzV).hom
        ((Z.subschemeι.app V).hom (x ⟨r + (j : ℕ), by omega⟩)) =
      (Z.subscheme.presheaf.germ VZ z hzVZ).hom (y j) := by
    intro j
    rw [← Scheme.Hom.germ_stalkMap_apply Z.subschemeι V z hpV, hxgerm, hygerm]
  choose W hzW hW1 hW2 hWeq using fun j => exists_open_restrict_eq hzV hzVZ _ _ (hgermZ j)
  have hev : ∀ᶠ q in nhds z, q ∈ Z.subschemeι ⁻¹ᵁ V ∧ q ∈ VZ ∧ ∀ j, q ∈ W j :=
    Filter.Eventually.and ((Z.subschemeι ⁻¹ᵁ V).isOpen.mem_nhds hzV)
      (Filter.Eventually.and (VZ.isOpen.mem_nhds hzVZ)
        (Filter.eventually_all.mpr fun j => (W j).isOpen.mem_nhds (hzW j)))
  obtain ⟨O', hO'sub, hO'open, hzO'⟩ := mem_nhds_iff.mp hev
  obtain ⟨O, hOopen, hOpre⟩ :=
    Z.subschemeι.isEmbedding.isInducing.isOpen_iff.mp hO'open
  let Uo : X.Opens := ⟨O, hOopen⟩
  have hzO : Z.subschemeι z ∈ Uo := by
    have : z ∈ Z.subschemeι ⁻¹ᵁ Uo := by
      change z ∈ Z.subschemeι ⁻¹' O
      rw [hOpre]; exact hzO'
    exact this
  have hUU1 : Uo ⊓ U1 ≤ U1 := inf_le_right
  have hUV : Uo ⊓ U1 ≤ V := hUU1.trans (hU1V1.trans hV1V')
  have hpU : Z.subschemeι z ∈ Uo ⊓ U1 := ⟨hzO, hpU1⟩
  have hpre : Z.subschemeι ⁻¹ᵁ (Uo ⊓ U1) ≤ O' := by
    intro q hq
    have : Z.subschemeι q ∈ O := hq.1
    rw [← hOpre]; exact this
  refine ⟨Uo ⊓ U1, hpU, fun i => (X.presheaf.map (homOfLE hUV).op).hom (x i), ⟨?_, ?_⟩, ?_,
    by omega, ?_⟩
  · exact isLocalCoordinatesOn_restrict hUV (fun i => rfl) hxcoord.1
  · intro i
    rw [← CommRingCat.comp_apply, X.presheaf.germ_res (homOfLE hUV) (Z.subschemeι z) hpU, hxgerm i]
    have : tX i ∈ IsLocalRing.maximalIdeal _ := by
      rw [← hts_m]; exact Ideal.subset_span (List.getElem_mem i.2)
    exact this
  · refine hU1.restrict hUU1 (fun i => ?_)
    simp only [g]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← X.presheaf.map_comp,
      ← X.presheaf.map_comp]
    rfl
  · refine isLocalCoordinatesOn_restrict (U := VZ) (fun q hq => hO'sub (hpre hq) |>.2.1) ?_
      hycoord.1
    intro j
    have hle1 : Z.subschemeι ⁻¹ᵁ (Uo ⊓ U1) ≤ W j := fun q hq => (hO'sub (hpre hq)).2.2 j
    have hle2 : Z.subschemeι ⁻¹ᵁ (Uo ⊓ U1) ≤ Z.subschemeι ⁻¹ᵁ V := fun q hq => hUV hq
    change (Z.subschemeι.app (Uo ⊓ U1)).hom
        ((X.presheaf.map (homOfLE hUV).op).hom (x ⟨r + (j : ℕ), by omega⟩)) = _
    rw [app_res_eq]
    calc _ = (Z.subscheme.presheaf.map (homOfLE hle1).op).hom
            ((Z.subscheme.presheaf.map (homOfLE (hW1 j)).op).hom
              ((Z.subschemeι.app V).hom (x ⟨r + (j : ℕ), by omega⟩))) := (res_res _ _ _).symm
      _ = (Z.subscheme.presheaf.map (homOfLE hle1).op).hom
            ((Z.subscheme.presheaf.map (homOfLE (hW2 j)).op).hom (y j)) := by rw [hWeq j]
      _ = _ := res_res _ _ _

end MMP.Resolution.Bridges
