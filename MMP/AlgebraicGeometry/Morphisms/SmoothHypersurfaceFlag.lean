module

public import MMP.AlgebraicGeometry.Morphisms.Smooth.SmoothFlagCoordinates
public import StacksFrontier.AlgebraicGeometry.Chow.AffineBundle.AffineSpaceBundleSmooth
public import StacksFrontier.AlgebraicGeometry.Chow.RelativeCycles.SmoothSupportSpecialization

/-!
# Local flags of smooth hypersurfaces, and a sign lemma for negative-definite matrices

This file collects two auxiliary results.

**Flags.** Let `X` be smooth over a field `k` of pure dimension `m + c` and `Y ⊆ X` a closed
subscheme smooth over `k` of pure dimension `m`. Every point `x ∈ Y` has an open neighbourhood
`V ⊆ X` with sections `f₁, …, f_c ∈ 𝒪_X(V)` such that every partial zero locus
`Y_l = V(f_{l+1}, …, f_c) ⊆ V`, `0 ≤ l ≤ c`, is smooth over `k` of pure dimension `m + l`, with
`Y_0 = Y ∩ V` and `Y_c = V`. In particular each `Y_{l-1} = Y_l ∩ V(f_l)` is a smooth
hypersurface in `Y_l`. Near a point of `Y` there are étale coordinates `x_1, …, x_{m+c}` on an
affine open `U` with `Y ∩ U = V(x_1, …, x_c)`; the partial zero locus `V(x_{l+1}, …, x_c)` is
étale over the coordinate space `𝔸^{m+l}_k` of the remaining coordinates, by base change of the
étale map `U ⟶ 𝔸^{m+c}_k` along the inclusion of a coordinate subspace.

**Negative-definite matrices.** Let `M` be a real symmetric negative-definite matrix whose
off-diagonal entries are nonnegative (for instance the intersection matrix of the exceptional
curves of a resolution of a surface singularity). If `M *ᵥ c` has nonnegative entries, then
every entry of `c` is nonpositive.

## Main results

* `MMP.Resolution.exists_smoothOfRelativeDimension_flag`: a smooth closed subscheme is locally
  the bottom of a flag of smooth hypersurfaces.
* `MMP.Matrix.nonpos_of_posDef_neg_of_nonneg_mulVec`: if `(-M).PosDef`, `0 ≤ M i j` for
  `i ≠ j`, and `0 ≤ M *ᵥ c`, then `c ≤ 0`.

## Implementation notes

Pure dimension `d` over `k` is `SmoothOfRelativeDimension d` of the structure morphism. The
sections are indexed by `Fin c`, the section `f i` playing the role of `f_{i+1}`, and live in
`Γ(V, ⊤)` of the open subscheme `V`, canonically `𝒪_X(V)`. The partial zero locus `Y_l` is the
closed subscheme of `V` with ideal sheaf generated by `{f i | l ≤ i}`, and `Y ∩ V` is the
pullback of `Y` along the open immersion `V ⟶ X`. Since `Y_{l-1}` is cut out of `Y_l` by the
one equation `f_l` and is smooth of dimension one less, it is a smooth hypersurface of `Y_l`;
this is not restated.

The base change to a coordinate subspace is carried out algebraically: if
`φ : R[x_i | i ∈ ι] ⟶ A` is étale and `B = A / (φ x_i | i ∈ s)`, then `B` is étale over the
polynomial ring in the variables outside `s`, because `B` is the tensor product of `A` with that
polynomial ring over `R[x_i | i ∈ ι]`.

Negative definiteness is spelled `(-M).PosDef`; this includes symmetry of `M`
(`Matrix.PosDef` contains `Matrix.IsHermitian`, which over `ℝ` is symmetry). The equation
`M c = v` with `v ≥ 0` is stated as `0 ≤ M *ᵥ c` in the pointwise order on `ι → ℝ`.

## References

* [J. Kollár, *Lectures on resolution of singularities*]
-/

open CategoryTheory AlgebraicGeometry

universe u

namespace MMP.Resolution

section Flag

open MvPolynomial TensorProduct

/-- **Killing coordinates of an étale algebra over a polynomial ring.** If
`φ : R[x_i | i ∈ ι] ⟶ A` is étale, `π : A ⟶ B` is surjective with kernel generated by the
`φ x_i`, `i ∈ s`, and the variables outside `s` are indexed by `emb : κ → ι`, then the map
`R[y_j | j ∈ κ] ⟶ B` sending `y_j` to the image of `x_{emb j}` is étale. -/
private theorem etale_of_ker_eq_span {R A B : Type*} [CommRing R] [CommRing A] [CommRing B]
    {ι κ : Type*} (φ : MvPolynomial ι R →+* A) (hφ : φ.Etale) (s : Set ι) (emb : κ → ι)
    (back : ι → MvPolynomial κ R) (hback : ∀ j, back (emb j) = X j)
    (hs : ∀ i, i ∉ s → i ∈ Set.range emb) (hsemb : ∀ j, emb j ∉ s)
    (π : A →+* B) (hπ : Function.Surjective π)
    (hker : RingHom.ker π = Ideal.span ((fun i => φ (X i)) '' s))
    (ψ : MvPolynomial κ R →+* B) (hψC : ∀ r, ψ (C r) = π (φ (C r)))
    (hψX : ∀ j, ψ (X j) = π (φ (X (emb j)))) : ψ.Etale := by
  classical
  let β : MvPolynomial ι R →+* MvPolynomial κ R :=
    eval₂Hom C fun i => if i ∈ s then 0 else back i
  have hβ : ∀ j, β (X (emb j)) = X j := fun j => by
    simp only [β, eval₂Hom_X', if_neg (hsemb j), hback j]
  have hβs : ∀ i ∈ s, β (X i) = 0 := fun i hi => by simp only [β, eval₂Hom_X', if_pos hi]
  have hβC : ∀ r, β (C r) = C r := fun r => by simp only [β, eval₂Hom_C]
  let α : MvPolynomial κ R →+* MvPolynomial ι R := eval₂Hom C fun j => X (emb j)
  have hβα : ∀ q, β (α q) = q := by
    have : β.comp α = RingHom.id (MvPolynomial κ R) :=
      MvPolynomial.ringHom_ext (fun r => by simp [α, hβC]) (fun j => by
        simp only [RingHom.comp_apply, α, eval₂Hom_X', hβ, RingHom.id_apply])
    exact fun q => congrArg (fun g => g q) this
  have hπφ : π.comp φ = ψ.comp β := by
    refine MvPolynomial.ringHom_ext (fun r => by simp [hβC, hψC]) (fun i => ?_)
    by_cases hi : i ∈ s
    · have : φ (X i) ∈ RingHom.ker π := hker ▸ Ideal.subset_span ⟨i, hi, rfl⟩
      simp [hβs i hi, RingHom.mem_ker.mp this]
    · obtain ⟨j, rfl⟩ := hs i hi
      rw [RingHom.comp_apply, RingHom.comp_apply, hβ, hψX]
  letI : Algebra (MvPolynomial ι R) A := φ.toAlgebra
  letI : Algebra (MvPolynomial ι R) (MvPolynomial κ R) := β.toAlgebra
  letI : Algebra (MvPolynomial κ R) B := ψ.toAlgebra
  letI : Algebra (MvPolynomial ι R) B := (ψ.comp β).toAlgebra
  haveI : IsScalarTower (MvPolynomial ι R) (MvPolynomial κ R) B :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Algebra.Etale (MvPolynomial ι R) A := hφ
  let πP : A →ₐ[MvPolynomial ι R] B :=
    { π with commutes' := fun p => congrArg (fun g => g p) hπφ }
  let F : MvPolynomial κ R ⊗[MvPolynomial ι R] A →ₐ[MvPolynomial κ R] B :=
    Algebra.TensorProduct.lift (Algebra.ofId _ B) πP (fun _ _ => Commute.all _ _)
  let iR : A →+* MvPolynomial κ R ⊗[MvPolynomial ι R] A :=
    (Algebra.TensorProduct.includeRight : A →ₐ[MvPolynomial ι R] _).toRingHom
  have hiRφ : ∀ p, iR (φ p) = β p ⊗ₜ[MvPolynomial ι R] (1 : A) := fun p =>
    ((Algebra.TensorProduct.includeRight :
      A →ₐ[MvPolynomial ι R] MvPolynomial κ R ⊗[MvPolynomial ι R] A).commutes p).trans
    ((Algebra.TensorProduct.includeLeft :
      MvPolynomial κ R →ₐ[MvPolynomial ι R] MvPolynomial κ R ⊗[MvPolynomial ι R] A).commutes p).symm
  have hGker : ∀ a ∈ RingHom.ker π, iR a = 0 := by
    intro a ha
    rw [hker] at ha
    refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx hy => by simp [hx, hy])
      (fun r x _ hx => by simp [hx]) ha
    rintro _ ⟨i, hi, rfl⟩
    rw [hiRφ, hβs i hi, TensorProduct.zero_tmul]
  let G0 : B →+* MvPolynomial κ R ⊗[MvPolynomial ι R] A :=
    RingHom.liftOfSurjective π hπ ⟨iR, hGker⟩
  have hG0 : ∀ a, G0 (π a) = iR a := fun a =>
    RingHom.liftOfRightInverse_comp_apply _ _ _ _ _
  have hG0ψ : ∀ q, G0 (ψ q) = q ⊗ₜ[MvPolynomial ι R] (1 : A) := by
    intro q
    have : ψ q = π (φ (α q)) := by
      rw [← RingHom.comp_apply π, hπφ, RingHom.comp_apply, hβα]
    rw [this, hG0, hiRφ, hβα]
  let G : B →ₐ[MvPolynomial κ R] MvPolynomial κ R ⊗[MvPolynomial ι R] A :=
    { G0 with commutes' := hG0ψ }
  have hFG : ∀ b, F (G b) = b := by
    intro b
    obtain ⟨a, rfl⟩ := hπ b
    change F (G0 (π a)) = π a
    rw [hG0]
    simp [F, iR, πP]
  have hGF : ∀ t, G (F t) = t := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul q a =>
      simp only [F, Algebra.TensorProduct.lift_tmul, map_mul]
      change G0 (ψ q) * G0 (π a) = _
      rw [hG0ψ, hG0]
      simp [iR]
    | add x y hx hy => simp [hx, hy]
  exact RingHom.etale_algebraMap.mpr
    (Algebra.Etale.of_equiv (AlgEquiv.ofAlgHom F G (AlgHom.ext hFG) (AlgHom.ext hGF)))

/-- A morphism of affine schemes `T ⟶ 𝔸^n_S` given by functions `v` is étale exactly when the
ring map `Γ(S)[x_i] ⟶ Γ(T)` sending `x_i` to `v i` is étale. -/
private theorem etale_homOfVector_iff {S T : Scheme.{u}} [IsAffine S] [IsAffine T] (g : T ⟶ S)
    {n : Type u} (v : n → Γ(T, ⊤)) :
    Etale (AffineSpace.homOfVector g v) ↔ (eval₂Hom g.appTop.hom v).Etale := by
  set e := AffineSpace.isoOfIsAffine n S
  have key : Etale (AffineSpace.homOfVector g v) ↔
      Etale (AffineSpace.homOfVector g v ≫ e.hom) :=
    ⟨fun _ => inferInstance, fun _ => by
      simpa using (inferInstance : Etale ((AffineSpace.homOfVector g v ≫ e.hom) ≫ e.inv))⟩
  have : CommRingCat.ofHom (eval₂Hom (𝔸(n; S) ↘ S).appTop.hom (AffineSpace.coord S)) ≫
      (AffineSpace.homOfVector g v).appTop = CommRingCat.ofHom (eval₂Hom g.appTop.hom v) := by
    ext1
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, eval₂Hom_C]
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, AffineSpace.homOfVector_over]
    · simp [AffineSpace.homOfVector_appTop_coord]
  rw [key, HasRingHomProperty.iff_of_isAffine (P := @Etale), Scheme.Hom.comp_appTop,
    AffineSpace.isoOfIsAffine_hom_appTop, Category.assoc, this, CommRingCat.hom_comp,
    RingHom.Etale.respectsIso.cancel_left_isIso, CommRingCat.hom_ofHom]

/-- A scheme with an étale morphism to `𝔸^r_k` over `k` is smooth of relative dimension `r`. -/
private theorem smoothOfRelativeDimension_of_etale_homOfVector {k : Type u} [Field k]
    {T : Scheme.{u}} (g : T ⟶ Spec (.of k)) {r : ℕ} (v : ULift.{u} (Fin r) → Γ(T, ⊤))
    (h : Etale (AffineSpace.homOfVector g v)) : SmoothOfRelativeDimension r g := by
  haveI := Stacks.Chow.smoothOfRelativeDimension_affineSpaceOver (Spec (.of k)) r
  rw [← AffineSpace.homOfVector_over g v]
  simpa using (inferInstance : SmoothOfRelativeDimension (0 + r)
    (AffineSpace.homOfVector g v ≫ 𝔸(ULift.{u} (Fin r); Spec (.of k)) ↘ Spec (.of k)))

/-- **Counting étale coordinates.** On a nonempty open `U` of a scheme smooth of relative
dimension `n` over a field, any system of étale coordinates has exactly `n` members. -/
private theorem card_eq_of_isLocalCoordinates {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) {n : ℕ} [SmoothOfRelativeDimension n sX] {U : X.Opens} {x : X}
    (hx : x ∈ U) {N : ℕ} (xs : Fin N → Γ(X, U)) (h : IsLocalCoordinates sX U xs) : N = n := by
  haveI := smoothOfRelativeDimension_of_etale_homOfVector (U.ι ≫ sX) _ h
  haveI : SmoothOfRelativeDimension n (U.ι ≫ sX) := by
    simpa using (inferInstance : SmoothOfRelativeDimension (0 + n) (U.ι ≫ sX))
  have h1 := topologicalKrullDimAt_eq_of_smoothOfRelativeDimension_over_field N (U.ι ≫ sX) ⟨x, hx⟩
  have h2 := topologicalKrullDimAt_eq_of_smoothOfRelativeDimension_over_field n (U.ι ≫ sX) ⟨x, hx⟩
  exact_mod_cast h1.symm.trans h2

/-- On an affine open `U` with `Y ∩ U = V(x_1, …, x_c)`, the first `c` coordinates cut out
`Y ∩ U`. -/
private theorem ofIdealTop_span_eq_comap_of_isCutOutByFirst {X : Scheme.{u}} {m c : ℕ}
    (Y : X.IdealSheafData) (U : X.Opens) (hU : IsAffineOpen U) (xs : Fin (m + c) → Γ(X, U))
    (hcut : Bridges.IsCutOutByFirst Y U xs c) :
    Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun i : Fin c =>
      U.topIso.inv.hom (xs (Fin.castLE (Nat.le_add_left c m) i)))) = Y.comap U.ι := by
  haveI : IsAffine U.toScheme := hU
  set f : Fin c → Γ(U.toScheme, ⊤) := fun i =>
    U.topIso.inv.hom (xs (Fin.castLE (Nat.le_add_left c m) i))
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion, Scheme.Opens.ι_appIso]
  have hle : U.ι ''ᵁ ⊤ ≤ U := by simp
  rw [hcut ⟨U.ι ''ᵁ ⊤, (isAffineOpen_top _).image_of_isOpenImmersion U.ι⟩ hle]
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal, Iso.refl_inv]
  have hres : ∀ a : Γ(X, U), (X.presheaf.map (homOfLE hle).op).hom a = U.topIso.inv.hom a :=
    fun a => rfl
  have hset : (fun i => (X.presheaf.map (homOfLE hle).op).hom (xs i)) '' {i | (i : ℕ) < c} =
      Set.range f := by
    ext y
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, (hres _).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨Fin.castLE (Nat.le_add_left c m) i, i.2, hres _⟩
  rw [hset]
  have e1 : (homOfLE (le_top : (⊤ : U.toScheme.Opens) ≤ ⊤)) = 𝟙 _ := rfl
  simp only [e1, op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id,
    Ideal.comap_id]
  exact (Ideal.comap_id _).symm

/-- Given étale coordinates `x_1, …, x_{m+c}` on an affine open `U`, each partial zero locus
`V(x_{l+1}, …, x_c)` is smooth of relative dimension `m + l`. -/
private theorem smoothOfRelativeDimension_ofIdealTop_span_coords {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) {m c : ℕ} (U : X.Opens) [IsAffine U.toScheme]
    (xs : Fin (m + c) → Γ(X, U)) (hloc : IsLocalCoordinates sX U xs) {l : ℕ} (hl : l ≤ c) :
    SmoothOfRelativeDimension (m + l)
      ((Scheme.IdealSheafData.ofIdealTop (Ideal.span ((fun i : Fin c =>
        U.topIso.inv.hom (xs (Fin.castLE (Nat.le_add_left c m) i))) ''
          {i | l ≤ (i : ℕ)}))).subschemeι ≫ U.ι ≫ sX) := by
  classical
  let φ : MvPolynomial (ULift.{u} (Fin (m + c))) Γ(Spec (.of k), ⊤) →+* Γ(U.toScheme, ⊤) :=
    eval₂Hom (U.ι ≫ sX).appTop.hom (fun i => U.topIso.inv.hom (xs i.down))
  have hφ : φ.Etale := (etale_homOfVector_iff _ _).mp hloc
  set f : Fin c → Γ(U.toScheme, ⊤) := fun i =>
    U.topIso.inv.hom (xs (Fin.castLE (Nat.le_add_left c m) i))
  set J := Scheme.IdealSheafData.ofIdealTop (Ideal.span (f '' {i | l ≤ (i : ℕ)})) with hJ
  haveI : IsAffine J.subscheme := isAffine_of_isAffineHom J.subschemeι
  let π : Γ(U.toScheme, ⊤) →+* Γ(J.subscheme, ⊤) := J.subschemeι.appTop.hom
  have hπ : Function.Surjective π := J.subschemeι_app_surjective ⟨⊤, isAffineOpen_top _⟩
  have hker : RingHom.ker π = Ideal.span (f '' {i | l ≤ (i : ℕ)}) := by
    refine (J.ker_subschemeι_app ⟨⊤, isAffineOpen_top _⟩).trans ?_
    have e1 : (homOfLE (le_top : (⊤ : U.toScheme.Opens) ≤ ⊤)) = 𝟙 _ := rfl
    simp only [hJ, Scheme.IdealSheafData.ofIdealTop_ideal, e1, op_id,
      CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]
  let emb : ULift.{u} (Fin (m + l)) → ULift.{u} (Fin (m + c)) := fun j =>
    ⟨if h : (j.down : ℕ) < l then ⟨j.down, by omega⟩ else ⟨j.down + (c - l), by omega⟩⟩
  let back : ULift.{u} (Fin (m + c)) →
      MvPolynomial (ULift.{u} (Fin (m + l))) Γ(Spec (.of k), ⊤) := fun i =>
    if h : (i.down : ℕ) < l then MvPolynomial.X ⟨⟨i.down, by omega⟩⟩
    else if h2 : c ≤ (i.down : ℕ) then MvPolynomial.X ⟨⟨i.down - (c - l), by omega⟩⟩ else 0
  let s : Set (ULift.{u} (Fin (m + c))) := {i | l ≤ (i.down : ℕ) ∧ (i.down : ℕ) < c}
  let v : ULift.{u} (Fin (m + l)) → Γ(J.subscheme, ⊤) := fun j =>
    π (U.topIso.inv.hom (xs (emb j).down))
  refine smoothOfRelativeDimension_of_etale_homOfVector _ v ?_
  rw [etale_homOfVector_iff]
  refine etale_of_ker_eq_span φ hφ s emb back ?_ ?_ ?_ π hπ ?_ _ ?_ ?_
  · rintro ⟨⟨j, hj⟩⟩
    by_cases h : j < l
    · simp [back, emb, h]
    · have h3 : c ≤ j + (c - l) := by omega
      have h4 : ¬ (j + (c - l) < l) := by omega
      simp only [back, emb, dif_neg h, dif_neg h4, dif_pos h3]
      congr
      omega
  · rintro ⟨⟨i, hi⟩⟩ his
    simp only [s, Set.mem_setOf_eq, not_and_or, not_le, not_lt] at his
    by_cases h : i < l
    · exact ⟨⟨⟨i, by omega⟩⟩, by simp [emb, h]⟩
    · refine ⟨⟨⟨i - (c - l), by omega⟩⟩, ?_⟩
      have h4 : ¬ (i - (c - l) < l) := by omega
      simp only [emb, dif_neg h4]
      congr
      omega
  · rintro ⟨⟨j, hj⟩⟩
    simp only [s, emb, Set.mem_setOf_eq]
    split_ifs <;> simp only <;> omega
  · rw [hker]
    congr 1
    ext y
    simp only [Set.mem_image, Set.mem_setOf_eq, s, φ, eval₂Hom_X']
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨Fin.castLE (Nat.le_add_left c m) i⟩, ⟨hi, i.2⟩, rfl⟩
    · rintro ⟨⟨i⟩, ⟨hi1, hi2⟩, rfl⟩
      exact ⟨⟨i, hi2⟩, hi1, rfl⟩
  · intro r
    simp only [eval₂Hom_C, φ, π, Scheme.Hom.comp_appTop, CommRingCat.hom_comp,
      RingHom.comp_apply]
  · intro j
    simp only [eval₂Hom_X', v, φ]

/-- **The flag on a coordinate chart.** Given étale coordinates `x_1, …, x_{m+c}` on an affine
open `U` with `Y ∩ U = V(x_1, …, x_c)`, the first `c` coordinates cut out `Y ∩ U` and each partial
zero locus `V(x_{l+1}, …, x_c)` is smooth of relative dimension `m + l`. -/
private theorem flag_of_isLocalCoordinates {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) {m c : ℕ} (Y : X.IdealSheafData) (U : X.Opens) (hU : IsAffineOpen U)
    {N : ℕ} (hN : N = m + c) (xs : Fin N → Γ(X, U)) (hloc : IsLocalCoordinates sX U xs)
    (hcut : Bridges.IsCutOutByFirst Y U xs c) :
    ∃ (f : Fin c → Γ(U.toScheme, ⊤)),
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range f)) = Y.comap U.ι ∧
      ∀ l ≤ c, SmoothOfRelativeDimension (m + l)
        ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (f '' {i | l ≤ (i : ℕ)}))).subschemeι ≫
          U.ι ≫ sX) := by
  subst hN
  haveI : IsAffine U.toScheme := hU
  exact ⟨_, ofIdealTop_span_eq_comap_of_isCutOutByFirst Y U hU xs hcut,
    fun _ hl => smoothOfRelativeDimension_ofIdealTop_span_coords sX U xs hloc hl⟩

/-- **A smooth closed subscheme is locally a complete flag of smooth hypersurfaces.** Let `X` be
smooth over `k` of pure dimension `m + c` and `Y ⊆ X` a closed subscheme smooth over `k` of pure
dimension `m`. Every `x ∈ Y` has an open neighbourhood `V` and sections `f : Fin c → Γ(V, ⊤)`
such that for every `l ≤ c` the zero locus `Y_l` of `{f i | l ≤ i}` in `V` is smooth over `k` of
pure dimension `m + l`, and `Y_0 = Y ∩ V`. -/
@[mmp "lem_mmp_foundation_smooth_center_local_hypersurface_flag"]
public theorem exists_smoothOfRelativeDimension_flag {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) {m c : ℕ} [SmoothOfRelativeDimension (m + c) sX]
    (Y : X.IdealSheafData) [SmoothOfRelativeDimension m (Y.subschemeι ≫ sX)]
    {x : X} (hx : x ∈ Y.support) :
    ∃ (V : X.Opens) (_ : x ∈ V) (f : Fin c → Γ(V.toScheme, ⊤)),
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range f)) = Y.comap V.ι ∧
      ∀ l ≤ c, SmoothOfRelativeDimension (m + l)
        ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (f '' {i | l ≤ (i : ℕ)}))).subschemeι ≫
          V.ι ≫ sX) := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth (m + c) sX
  haveI : Smooth (Y.subschemeι ≫ sX) := SmoothOfRelativeDimension.smooth m _
  obtain ⟨z, rfl⟩ : x ∈ Set.range Y.subschemeι := by rwa [Y.range_subschemeι]
  have hc : topologicalKrullDimAt X (Y.subschemeι z) =
      topologicalKrullDimAt Y.subscheme z + c := by
    rw [topologicalKrullDimAt_eq_of_smoothOfRelativeDimension_over_field (m + c) sX,
      topologicalKrullDimAt_eq_of_smoothOfRelativeDimension_over_field m (Y.subschemeι ≫ sX)]
    push_cast
    rfl
  obtain ⟨U, hU, hzU, xs, hloc, hcut⟩ :=
    Bridges.exists_isLocalCoordinates_adapted sX Y z hc
  exact ⟨U, hzU, flag_of_isLocalCoordinates sX Y U hU
    (card_eq_of_isLocalCoordinates sX hzU xs hloc) xs hloc hcut⟩

end Flag

end MMP.Resolution

namespace MMP.Matrix

open scoped _root_.Matrix

/-- A matrix with nonnegative off-diagonal entries pairs a nonnegative vector `p` with a
nonpositive vector `n` of disjoint support nonpositively: `p ⬝ᵥ M *ᵥ n ≤ 0`. -/
private lemma dotProduct_mulVec_nonpos_of_offDiag_nonneg {ι : Type*} [Fintype ι]
    {M : _root_.Matrix ι ι ℝ} (hoff : ∀ i j, i ≠ j → 0 ≤ M i j) {p n : ι → ℝ} (hp : 0 ≤ p)
    (hn : n ≤ 0) (hpn : ∀ i, p i * n i = 0) : p ⬝ᵥ M *ᵥ n ≤ 0 := by
  simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
  refine Finset.sum_nonpos fun i _ => Finset.sum_nonpos fun j _ => ?_
  obtain rfl | hij := eq_or_ne i j
  · rw [mul_left_comm, hpn, mul_zero]
  · exact mul_nonpos_of_nonneg_of_nonpos (hp i)
      (mul_nonpos_of_nonneg_of_nonpos (hoff i j hij) (hn j))

/-- If `M` is a real negative-definite matrix (`-M` positive definite) with nonnegative
off-diagonal entries and `M *ᵥ c` has nonnegative entries, then every entry of `c` is
nonpositive. -/
@[mmp "lem_mmp_surface_negative_matrix_sign"]
public theorem nonpos_of_posDef_neg_of_nonneg_mulVec {ι : Type*} [Fintype ι]
    {M : _root_.Matrix ι ι ℝ} (hM : (-M).PosDef) (hoff : ∀ i j, i ≠ j → 0 ≤ M i j)
    {c : ι → ℝ} (hc : 0 ≤ M *ᵥ c) : c ≤ 0 := by
  by_contra hcon
  set p : ι → ℝ := fun i => max (c i) 0
  set n : ι → ℝ := fun i => min (c i) 0
  have hcpn : c = p + n := funext fun i => by simp [p, n, max_add_min]
  have hp : p ≠ 0 := fun h => hcon fun i => by simpa [p] using congrFun h i
  have hMp := hM.dotProduct_mulVec_pos hp
  have hMn := dotProduct_mulVec_nonpos_of_offDiag_nonneg hoff (fun i => le_max_right (c i) 0)
    (fun i => min_le_right (c i) 0) fun i => by
      rcases le_total (c i) 0 with h | h <;> simp [p, n, h]
  have hMc : 0 ≤ p ⬝ᵥ M *ᵥ c :=
    Finset.sum_nonneg fun i _ => mul_nonneg (le_max_right _ _) (hc i)
  rw [hcpn, Matrix.mulVec_add, dotProduct_add] at hMc
  simp only [Matrix.neg_mulVec, dotProduct_neg, star_trivial] at hMp
  linarith

end MMP.Matrix
