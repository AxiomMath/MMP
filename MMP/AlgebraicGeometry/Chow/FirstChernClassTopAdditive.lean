/-!
# Additivity of `c₁ᵗᵒᵖ` and Fulton's Proposition 19.2 for all cycles

Let `X` be a scheme over `ℂ`. The topological first Chern class `c₁ᵗᵒᵖ(L) ∈ H²(X(ℂ); R)` of an
invertible module `L` (`MMP.Chow.firstChernClassTop`) is the integral first Chern class
`c₁(L) ∈ H²(X^an; ℤ)` (`MMP.Analytic.algebraicFirstChernClass`) with coefficients changed to `R`
and pulled back along `X(ℂ) ≅ X^an` (`MMP.Modules.topFirstChernClass_dual`). The additivity of the
latter (`MMP.Analytic.algebraicFirstChernClass_sheafTensor`) therefore gives
`c₁ᵗᵒᵖ(L ⊗ M) = c₁ᵗᵒᵖ(L) + c₁ᵗᵒᵖ(M)`, and `c₁ᵗᵒᵖ(L^∨) = -c₁ᵗᵒᵖ(L)`.

On a complex variety `V` with an ample invertible module `A`, every invertible `N` becomes, after
a sufficiently positive twist `P = A^{⊗ n}`, generated by global sections, as does `P` itself
(Stacks 01Q3, clause (7)); so `N ⊗ P` and `P` both have non-zero global sections, and
`N = (N ⊗ P) ⊗ P^{-1}` is Fulton's decomposition `L|_V = A ⊗ B^{-1}`. With Stacks 02SP on the
algebraic side, additivity of `c₁ᵗᵒᵖ` on the topological side, and Fulton 19.2 for line bundles
with a section (`MMP.Chow.cycleClassFirstChern` for `α = [V]`), this proves Fulton 19.2 for
`α = i_*[V]` with no section hypothesis, and then, summing over the prime components of a cycle,
for every cycle (`MMP.Chow.cycleClassFirstChernFormula_of_isAmple`), and on Chow groups
(`MMP.Chow.chowCycleClass_firstChernClassCap`), for `X` carrying an ample invertible module
(Stacks 01PU restricts it to every closed subscheme). That the cycle class map kills rationally
trivial cycles is `MMP.Chow.cycleClass_eq_zero_of_isRationallyEquivalentToZero`.

## Main results

* `MMP.Chow.firstChernClassTop_tensorObj`: `c₁ᵗᵒᵖ(L ⊗ M) = c₁ᵗᵒᵖ(L) + c₁ᵗᵒᵖ(M)`.
* `MMP.Chow.firstChernClassTop_unit`: `c₁ᵗᵒᵖ(𝒪_X) = 0`.
* `MMP.Chow.firstChernClassTop_eq_neg_of_tensorObj_iso_unit`, `firstChernClassTop_dualSheaf`:
  `c₁ᵗᵒᵖ(L⁻¹) = -c₁ᵗᵒᵖ(L)`, `c₁ᵗᵒᵖ(L^∨) = -c₁ᵗᵒᵖ(L)`.
* `MMP.Chow.exists_tensorPowModule_sections_ne_zero`: on a nonempty scheme with an ample `A`,
  `N ⊗ A^{⊗ n}` and `A^{⊗ n}` have non-zero global sections for some `n`.
* `MMP.Chow.cycleClass_eq_firstChernClassTopCap_pushforward_of_isAmple`: Fulton 19.2 for
  `α = i_*[V]`, `V` a closed subvariety with an ample invertible module.
* `MMP.Chow.chowCycleClass_firstChernClassCapOfInvertible`, `chowCycleClass_firstChernClassCap`,
  `cycleClassFirstChernFormula_of_isAmple`: Fulton 19.2 on cycles, on Chow groups, and as
  `MMP.Chow.CycleClassFirstChernFormula`, on a complex scheme with an ample invertible module.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1, Proposition 19.2.
* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
* [Stacks Project, Tag 01PU](https://stacks.math.columbia.edu/tag/01PU)
* [Stacks Project, Tag 02SP](https://stacks.math.columbia.edu/tag/02SP)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Set Opposite
open MMP.UnderlyingSpace

namespace MMP.Chow

open MMP MMP.Modules MMP.Analytic Stacks.Chow Stacks.Ample

/-! ### Additivity of `c₁ᵗᵒᵖ` -/

section Additivity

variable (R : Type) [CommRing R] {X : Scheme.{0}} [X.Over (Spec (.of ℂ))]

omit [X.Over (Spec (.of ℂ))] in
/-- The tensor product of two invertible modules is invertible. -/
instance isInvertibleModule_tensorObj (L M : X.Modules) [IsInvertibleModule X L]
    [IsInvertibleModule X M] : IsInvertibleModule X (Scheme.Modules.tensorObj L M) :=
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
    ‹IsInvertibleModule X L›
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property M :=
    ‹IsInvertibleModule X M›
  Stacks.Chow.isInvertible_tensorObj L M

/-- `c₁ᵗᵒᵖ(L)` is the integral first Chern class of `L`, with coefficients in `R`, pulled back
along `X(ℂ) ≅ X^an`. -/
theorem firstChernClassTop_eq (L : X.Modules) [IsInvertibleModule X L] :
    firstChernClassTop R L =
      (cohomologyWithSupports.pullback R (ModuleCat.of R R) (complexPointsHom X) univ 2).hom
        (singularCohomology.mapCoeff (Int.castRingHom R) 2 (algebraicFirstChernClass L)) :=
  topFirstChernClass_dual R L

/-- `c₁ᵗᵒᵖ` only depends on the isomorphism class of the invertible module. -/
theorem firstChernClassTop_congr {L M : X.Modules} [IsInvertibleModule X L]
    [IsInvertibleModule X M] (e : L ≅ M) : firstChernClassTop R L = firstChernClassTop R M := by
  rw [firstChernClassTop_eq, firstChernClassTop_eq, algebraicFirstChernClass_eq_of_iso e]

/-- **Additivity of `c₁ᵗᵒᵖ`** (Fulton, §19.1): `c₁ᵗᵒᵖ(L ⊗ M) = c₁ᵗᵒᵖ(L) + c₁ᵗᵒᵖ(M)` in
`H²(X(ℂ); R)` for invertible modules `L`, `M` on a scheme over `ℂ`. -/
theorem firstChernClassTop_tensorObj (L M : X.Modules) [IsInvertibleModule X L]
    [IsInvertibleModule X M] :
    firstChernClassTop R (Scheme.Modules.tensorObj L M) =
      firstChernClassTop R L + firstChernClassTop R M := by
  have h : algebraicFirstChernClass (Scheme.Modules.tensorObj L M) =
      algebraicFirstChernClass L + algebraicFirstChernClass M :=
    algebraicFirstChernClass_sheafTensor L M
  rw [firstChernClassTop_eq, firstChernClassTop_eq, firstChernClassTop_eq, h, map_add, map_add]
  all_goals rfl

/-- `c₁ᵗᵒᵖ(𝒪_X) = 0`. -/
@[simp]
theorem firstChernClassTop_unit :
    firstChernClassTop R (SheafOfModules.unit X.ringCatSheaf) = 0 := by
  have : IsInvertibleModule X (Scheme.Modules.tensorObj (SheafOfModules.unit X.ringCatSheaf)
      (SheafOfModules.unit X.ringCatSheaf)) :=
    isInvertibleModule_tensorObj (SheafOfModules.unit X.ringCatSheaf)
      (SheafOfModules.unit X.ringCatSheaf)
  have h := firstChernClassTop_tensorObj R (SheafOfModules.unit X.ringCatSheaf)
    (SheafOfModules.unit X.ringCatSheaf)
  rw [firstChernClassTop_congr R (tensorObjUnitIso X (SheafOfModules.unit X.ringCatSheaf))] at h
  exact left_eq_add.mp h

/-- **`c₁ᵗᵒᵖ` of an inverse**: if `L ⊗ M ≅ 𝒪_X` then `c₁ᵗᵒᵖ(M) = -c₁ᵗᵒᵖ(L)`. -/
theorem firstChernClassTop_eq_neg_of_tensorObj_iso_unit {L M : X.Modules} [IsInvertibleModule X L]
    [IsInvertibleModule X M]
    (e : Scheme.Modules.tensorObj L M ≅ SheafOfModules.unit X.ringCatSheaf) :
    firstChernClassTop R M = -firstChernClassTop R L := by
  have h := firstChernClassTop_tensorObj R L M
  rw [firstChernClassTop_congr R e, firstChernClassTop_unit] at h
  exact eq_neg_of_add_eq_zero_right h.symm

omit [X.Over (Spec (.of ℂ))] in
/-- The dual of an invertible module is invertible. -/
instance isInvertibleModule_dualSheaf (L : X.Modules) [IsInvertibleModule X L] :
    IsInvertibleModule X (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) :=
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
    ‹IsInvertibleModule X L›
  Stacks.Chow.GenuineChern.isInvertible_dualSheaf L

/-- **`c₁ᵗᵒᵖ` of the dual**: `c₁ᵗᵒᵖ(L^∨) = -c₁ᵗᵒᵖ(L)`. -/
@[simp]
theorem firstChernClassTop_dualSheaf (L : X.Modules) [IsInvertibleModule X L] :
    firstChernClassTop R (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L) =
      -firstChernClassTop R L := by
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
    ‹IsInvertibleModule X L›
  exact firstChernClassTop_eq_neg_of_tensorObj_iso_unit R
    (Stacks.Chow.GenuineChern.nonempty_tensorObj_dualSheaf_iso_unit L).some

variable {R} in
/-- `c₁ᵗᵒᵖ(L ⊗ M) ∩ a = c₁ᵗᵒᵖ(L) ∩ a + c₁ᵗᵒᵖ(M) ∩ a`. -/
theorem firstChernClassTopCap_tensorObj [IsComplexScheme X] (L M : X.Modules)
    [IsInvertibleModule X L] [IsInvertibleModule X M] (k : ℕ) (a : BMHomology R X (2 * (k + 1))) :
    firstChernClassTopCap R (Scheme.Modules.tensorObj L M) k a =
      firstChernClassTopCap R L k a + firstChernClassTopCap R M k a := by
  simp only [firstChernClassTopCap, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
  rw [firstChernClassTop_tensorObj, map_add, LinearMap.add_apply, map_add]

end Additivity

/-! ### Twisting by an ample module produces sections -/

section Twist

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory

variable {V : Scheme.{0}}

/-- If `M ≅ N`, where `M` is generated by finitely many global sections and `N` is invertible on
a nonempty scheme, then `N` has a non-zero global section. -/
theorem exists_ne_zero_of_iso_of_generatingSections [Nonempty V] {M N : V.Modules}
    [IsInvertibleModule V N] (e : M ≅ N) (σ : M.GeneratingSections) (hσ : Finite σ.I) :
    ∃ s : Γ(N, ⊤), s ≠ 0 := by
  obtain ⟨σ', -⟩ := Stacks.AmpleEventualGeneration.IsFinGen.of_iso (M := M) (N := N) ⟨σ, hσ⟩ e
  obtain ⟨i, hi⟩ := exists_ne_zero_of_generatingSections N ‹_› σ'
  exact ⟨_, hi⟩

/-- **Twisting by an ample module produces sections** (Stacks 01Q3, clause (7)). On a nonempty
scheme with an ample invertible module `A`, for every invertible `N` there is an `n` such that
`N ⊗ A^{⊗ n}` and `A^{⊗ n}` both have non-zero global sections. -/
theorem exists_tensorPowModule_sections_ne_zero [Nonempty V] (N A : V.Modules)
    [IsInvertibleModule V N] [IsInvertibleModule V A] (hA : IsAmple V A) :
    ∃ n : ℤ, (∃ s : Γ(Scheme.Modules.tensorObj N (tensorPowModule V A n), ⊤), s ≠ 0) ∧
      ∃ t : Γ(tensorPowModule V A n, ⊤), t ≠ 0 := by
  have hgg := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple A hA
  obtain ⟨n₁, h₁⟩ := hgg N (Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule N)
    (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule N)
  obtain ⟨n₂, h₂⟩ := hgg (unitModule V)
    (Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule _)
    (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule _)
  obtain ⟨σ₁, hσ₁⟩ := h₁ (max n₁ n₂) (le_max_left _ _)
  obtain ⟨σ₂, hσ₂⟩ := h₂ (max n₁ n₂) (le_max_right _ _)
  refine ⟨max n₁ n₂, exists_ne_zero_of_iso_of_generatingSections
    ((Stacks.SheafInternalHom.tensorLeftIso V.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf V) N).app _) σ₁ hσ₁,
    exists_ne_zero_of_iso_of_generatingSections
      (Stacks.AmpleEventualGeneration.unitTensorIsoSelf _) σ₂ hσ₂⟩

end Twist

/-! ### Fulton 19.2 for subvarieties -/

section Subvariety

variable (R : Type) [CommRing R] {X : Scheme.{0}} [X.Over (Spec (.of ℂ))] [IsComplexScheme X]
  (L : X.Modules) [IsInvertibleModule X L]

open scoped MMP.SubschemeOver in
/-- Fulton 19.2 for `α = i_*[V]`, from a decomposition `L|_V ⊗ P = Q` with `P` and `Q` having
non-zero global sections. -/
theorem cycleClass_eq_firstChernClassTopCap_pushforward_of_tensorObj {V : Scheme.{0}}
    [V.Over (Spec (.of ℂ))] [IsComplexScheme V] [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i]
    [i.IsOver (Spec (.of ℂ))] {k : ℕ} (hn : ((k + 1 : ℕ) : WithBot ℕ∞) = topologicalKrullDim V)
    {μ : BMHomology R V (2 * (k + 1))} (hμ : IsVarietyFundamentalClass R hn μ)
    (P : V.Modules) [IsInvertibleModule V P]
    (s : Γ(Scheme.Modules.tensorObj ((Scheme.Modules.pullback i).obj L) P, ⊤)) (hs : s ≠ 0)
    (t : Γ(P, ⊤)) (ht : t ≠ 0)
    (β : CycleGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k)
    (hβ : letI : (AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj
        X.ringCatSheaf.property L) := ‹IsInvertibleModule X L›
      (QuotientAddGroup.mk β : chowGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k) =
        firstChernClassCapOfInvertible (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k L
          (properPushforward (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (X ↘ Spec (.of ℂ)) i
            (comp_over i _) ((k + 1 : ℕ) : ℤ)
            (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (𝟙 V)
              ((k + 1 : ℕ) : ℤ)))) :
    cycleClass R k β = firstChernClassTopCap R L k
      (borelMooreHomology.pushforward R (ModuleCat.of R R) (TopCat.ofHom (map (K := ℂ) i))
        (isProperMap_map (K := ℂ) i) (2 * (k + 1) : ℕ) μ) := by
  letI : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
    ‹IsInvertibleModule X L›
  have : IsInvertibleModule V ((Scheme.Modules.pullback i).obj L) := isInvertibleModule_pullback i L
  have : AlgebraicGeometry.SheafOfModules.IsInvertible V.sheaf.obj V.ringCatSheaf.property
      ((Scheme.Modules.pullback i).obj L) := isInvertibleModule_pullback i L
  have : AlgebraicGeometry.SheafOfModules.IsInvertible V.sheaf.obj V.ringCatSheaf.property P :=
    ‹IsInvertibleModule V P›
  have : AlgebraicGeometry.SheafOfModules.IsInvertible V.sheaf.obj V.ringCatSheaf.property
      (Scheme.Modules.tensorObj ((Scheme.Modules.pullback i).obj L) P) :=
    isInvertibleModule_tensorObj _ _
  have hDim : schemeDeltaDimension (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) =
      (((k : ℤ) + 1 : ℤ) : EInt) := by
    exact_mod_cast schemeDeltaDimension_fieldChowSituation_eq_of_topologicalKrullDim_eq
      (V ↘ Spec (.of ℂ)) hn.symm
  have hSQ := Stacks.ChernCap42.firstChernClassCapOfInvertible_fundamentalCycle
    (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) ((k : ℤ) + 1) hDim
    (Scheme.Modules.tensorObj ((Scheme.Modules.pullback i).obj L) P) s hs
  have hSP := Stacks.ChernCap42.firstChernClassCapOfInvertible_fundamentalCycle
    (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) ((k : ℤ) + 1) hDim P t ht
  rw [show (k : ℤ) + 1 - 1 = k by ring] at hSQ hSP
  have hadd := firstChernClassCapOfInvertible_tensorObj (fieldChowSituation ℂ)
    (V ↘ Spec (.of ℂ)) (k : ℤ) ((Scheme.Modules.pullback i).obj L) P
    (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (𝟙 V)
      ((k : ℤ) + 1))
  rw [hSQ, hSP] at hadd
  have hNV := eq_sub_of_add_eq hadd
  have h02SU := properChowPushforward_firstChernClassCapOfInvertible (fieldChowSituation ℂ)
    (V ↘ Spec (.of ℂ)) (X ↘ Spec (.of ℂ)) i (comp_over i _) (k : ℤ) L
    (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (𝟙 V)
      ((k : ℤ) + 1))
  have hβ' : (QuotientAddGroup.mk β : chowGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k) =
      QuotientAddGroup.mk (properPushforward (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ))
          (X ↘ Spec (.of ℂ)) i (comp_over i _) k
          (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ))
            (Stacks.Divisors.zeroScheme V
              (Scheme.Modules.tensorObj ((Scheme.Modules.pullback i).obj L) P) s).subschemeι k) -
        properPushforward (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ))
          (X ↘ Spec (.of ℂ)) i (comp_over i _) k
          (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ))
            (Stacks.Divisors.zeroScheme V P t).subschemeι k)) := by
    refine hβ.trans (h02SU.symm.trans ?_)
    erw [hNV, map_sub]
    rfl
  rw [QuotientAddGroup.eq_iff_sub_mem] at hβ'
  have h0 := cycleClass_eq_zero_of_isRationallyEquivalentToZero R k _ hβ'
  rw [map_sub, sub_eq_zero, map_sub, cycleClass_properPushforward, cycleClass_properPushforward,
    cycleClass_zeroScheme_eq_firstChernClassTopCap R _ hn s hs hμ,
    cycleClass_zeroScheme_eq_firstChernClassTopCap R P hn t ht hμ] at h0
  rw [h0, ← map_sub, firstChernClassTopCap_tensorObj, add_sub_cancel_right]
  exact pushforward_firstChernClassTopCap R i L k μ

open scoped MMP.SubschemeOver in
/-- **Fulton's Proposition 19.2 for `α = i_*[V]`.** Let `X` be a complex scheme, `L` an invertible
`𝒪_X`-module and `i : V ⟶ X` a closed immersion of a complex variety `V` of dimension `k + 1`
carrying an ample invertible module. Then `cl(β) = c₁ᵗᵒᵖ(L) ∩ i_* cl(V)` for every `k`-cycle `β`
representing `c₁(L) ∩ [V]_{k+1}`, `[V]_{k+1} = i_*[V]` on `X`. -/
theorem cycleClass_eq_firstChernClassTopCap_pushforward_of_isAmple {V : Scheme.{0}}
    [V.Over (Spec (.of ℂ))] [IsComplexScheme V] [IsIntegral V] (i : V ⟶ X) [IsClosedImmersion i]
    [i.IsOver (Spec (.of ℂ))] {k : ℕ} (hn : ((k + 1 : ℕ) : WithBot ℕ∞) = topologicalKrullDim V)
    {μ : BMHomology R V (2 * (k + 1))} (hμ : IsVarietyFundamentalClass R hn μ)
    (A : V.Modules) [IsInvertibleModule V A] (hA : IsAmple V A)
    (β : CycleGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k)
    (hβ : letI : (AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj
        X.ringCatSheaf.property L) := ‹IsInvertibleModule X L›
      (QuotientAddGroup.mk β : chowGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k) =
        firstChernClassCapOfInvertible (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k L
          (properPushforward (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (X ↘ Spec (.of ℂ)) i
            (comp_over i _) ((k + 1 : ℕ) : ℤ)
            (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ) (V ↘ Spec (.of ℂ)) (𝟙 V)
              ((k + 1 : ℕ) : ℤ)))) :
    cycleClass R k β = firstChernClassTopCap R L k
      (borelMooreHomology.pushforward R (ModuleCat.of R R) (TopCat.ofHom (map (K := ℂ) i))
        (isProperMap_map (K := ℂ) i) (2 * (k + 1) : ℕ) μ) := by
  have : IsInvertibleModule V ((Scheme.Modules.pullback i).obj L) := isInvertibleModule_pullback i L
  obtain ⟨n, ⟨s, hs⟩, ⟨t, ht⟩⟩ :=
    exists_tensorPowModule_sections_ne_zero ((Scheme.Modules.pullback i).obj L) A hA
  exact cycleClass_eq_firstChernClassTopCap_pushforward_of_tensorObj R L i hn hμ
    (tensorPowModule V A n) s hs t ht β hβ

end Subvariety

/-! ### Fulton 19.2 for all cycles -/

section AllCycles

variable (R : Type) [CommRing R] {X : Scheme.{0}} [X.Over (Spec (.of ℂ))] [IsComplexScheme X]
  (L : X.Modules) [IsInvertibleModule X L]

/-- The prime cycle `[x]` is the push-forward of the fundamental cycle of `closure {x}`. -/
theorem pointCycle_eq_properPushforward {k : ℤ} (x : X)
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = k) :
    pointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x hx =
      properPushforward (fieldChowSituation ℂ) ((integralComponentAt x).subscheme ↘ Spec (.of ℂ))
        (X ↘ Spec (.of ℂ)) (integralComponentAt x).subschemeι (comp_over _ _) k
        (cycleAssociatedToClosedSubscheme (fieldChowSituation ℂ)
          ((integralComponentAt x).subscheme ↘ Spec (.of ℂ)) (𝟙 _) k) := by
  have e := properPushforward_cycleAssociatedToClosedSubscheme_of_isClosedImmersion_comp
    (fieldChowSituation ℂ) ((integralComponentAt x).subscheme ↘ Spec (.of ℂ))
    (X ↘ Spec (.of ℂ)) (integralComponentAt x).subschemeι (comp_over _ _) (𝟙 _) k
  rw [cycleAssociatedToClosedSubscheme_congr (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) _ _
    (Category.id_comp (integralComponentAt x).subschemeι)] at e
  rw [e]
  classical
  refine Subtype.ext (Function.locallyFinsuppWithin.ext fun y ↦ ?_)
  rw [pointCycle_apply]
  by_cases hy : y = x
  · subst hy
    rw [ite_eq_left rfl, cycleAssociatedToClosedSubscheme_integralComponentAt_self
      (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) y
      (schemeDeltaDimension_integralComponentAt_of_relativeDimension_eq (fieldChowSituation ℂ)
        (X ↘ Spec (.of ℂ)) y hx)]
  · rw [ite_eq_right hy, cycleAssociatedToClosedSubscheme_integralComponentAt_of_ne
      (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k x hy]

open scoped MMP.SubschemeOver in
/-- **Fulton's Proposition 19.2 for line bundles, on cycles.** Let `X` be a complex scheme
carrying an ample invertible module `A`, and `L` an invertible `𝒪_X`-module. Then
`cl(c₁(L) ∩ α) = c₁ᵗᵒᵖ(L) ∩ cl(α)` in `H_{2k}(X(ℂ); R)` for every `(k+1)`-cycle `α`, with
Stacks' cap product `c₁(L) ∩ α ∈ A_k(X)` (Tag 02SO) and the cycle class map on `A_k(X)`. -/
theorem chowCycleClass_firstChernClassCapOfInvertible (k : ℕ) (A : X.Modules)
    [IsInvertibleModule X A] (hA : IsAmple X A)
    (α : CycleGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) ((k + 1 : ℕ) : ℤ)) :
    have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
      ‹IsInvertibleModule X L›
    chowCycleClass R k
        (firstChernClassCapOfInvertible (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k L α) =
      firstChernClassTopCap R L k (cycleClass R (k + 1) α) := by
  intro _
  -- both sides are additive in `α`
  let F₁ := (chowCycleClass R k).comp
    (firstChernClassCapOfInvertible (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k L)
  let F₂ := (firstChernClassTopCap R L k).toAddMonoidHom.comp (cycleClass R (k + 1))
  change F₁ α = F₂ α
  rw [eq_sum_pointCycleOrZero α, map_sum, map_sum]
  refine Finset.sum_congr rfl fun x hx ↦ ?_
  rw [map_zsmul, map_zsmul]
  congr 1
  unfold pointCycleOrZero
  split_ifs with hxk
  swap
  · rw [map_zero, map_zero]
  change chowCycleClass R k (firstChernClassCapOfInvertible (fieldChowSituation ℂ)
      (X ↘ Spec (.of ℂ)) k L (pointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) _ x hxk)) =
    firstChernClassTopCap R L k (cycleClass R (k + 1)
      (pointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) _ x hxk))
  rw [cycleClass_pointCycle]
  obtain ⟨β', hβ'⟩ := QuotientAddGroup.mk_surjective
    (firstChernClassCapOfInvertible (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) k L
      (pointCycle (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) _ x hxk))
  rw [← hβ']
  change cycleClass R k β' = _
  set i := (integralComponentAt x).subschemeι
  have hn := natCast_eq_dimension_integralComponentAt x hxk
  have hμ := (existsUnique_isVarietyFundamentalClass R hn).choose_spec.1
  have : IsInvertibleModule (integralComponentAt x).subscheme
      ((Scheme.Modules.pullback i).obj A) := isInvertibleModule_pullback i A
  have hA' : IsAmple (integralComponentAt x).subscheme ((Scheme.Modules.pullback i).obj A) := by
    have : AlgebraicGeometry.SheafOfModules.IsInvertible X.toRingedSpace.presheaf
        (structureSheafRing X.toRingedSpace).property A := ‹IsInvertibleModule X A›
    have : AlgebraicGeometry.SheafOfModules.IsInvertible
        (integralComponentAt x).subscheme.toRingedSpace.presheaf
        (structureSheafRing (integralComponentAt x).subscheme.toRingedSpace).property
        ((Scheme.Modules.pullback i).obj A) := ‹IsInvertibleModule _ _›
    exact (Stacks.AmpleBridge.isAmple_iff_isAmple _ _).mpr
      (Scheme.Modules.isAmple_pullback_of_isClosedImmersion i A
        ((Stacks.AmpleBridge.isAmple_iff_isAmple X A).mp hA))
  refine cycleClass_eq_firstChernClassTopCap_pushforward_of_isAmple R L i hn hμ _ hA' β' ?_
  rw [hβ']
  exact congrArg _ (pointCycle_eq_properPushforward x hxk)

/-- **Fulton's Proposition 19.2 for line bundles, on Chow groups.** Let `X` be a complex scheme
carrying an ample invertible module `A`, and `L` an invertible `𝒪_X`-module. Then
`cl(c₁(L) ∩ a) = c₁ᵗᵒᵖ(L) ∩ cl(a)` in `H_{2k}(X(ℂ); R)` for every `a ∈ A_{k+1}(X)`. -/
theorem chowCycleClass_firstChernClassCap (k : ℕ) (A : X.Modules) [IsInvertibleModule X A]
    (hA : IsAmple X A)
    (a : chowGroup (fieldChowSituation ℂ) (X ↘ Spec (.of ℂ)) ((k + 1 : ℕ) : ℤ)) :
    have : AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L :=
      ‹IsInvertibleModule X L›
    chowCycleClass R k
        (firstChernClassCapChow (fieldChowSituation ℂ) (k : ℤ) (X ↘ Spec (.of ℂ)) L a) =
      firstChernClassTopCap R L k (chowCycleClass R (k + 1) a) := by
  intro _
  induction a using QuotientAddGroup.induction_on with
  | H α => exact chowCycleClass_firstChernClassCapOfInvertible R L k A hA α

/-- **Fulton's Proposition 19.2 for line bundles** (`MMP.Chow.CycleClassFirstChernFormula`), on a
complex scheme carrying an ample invertible module: `cl(β) = c₁ᵗᵒᵖ(L) ∩ cl(α)` for every
`(k+1)`-cycle `α` and every `k`-cycle `β` representing `c₁(L) ∩ α`. -/
theorem cycleClassFirstChernFormula_of_isAmple (k : ℕ) (A : X.Modules) [IsInvertibleModule X A]
    (hA : IsAmple X A) : CycleClassFirstChernFormula R L k := by
  intro α β hβ
  rw [← chowCycleClass_mk, hβ]
  exact chowCycleClass_firstChernClassCapOfInvertible R L k A hA α

