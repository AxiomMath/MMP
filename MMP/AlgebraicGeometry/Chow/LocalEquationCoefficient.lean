module

public import StacksFrontier.AlgebraicGeometry.Chow.LocalEquationMultiplicity
public import StacksFrontier.AlgebraicGeometry.Chow.Degrees.ClosedImmersionCycles
public import StacksFrontier.AlgebraicGeometry.Chow.FieldSituation.Base
public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardClosedSubscheme

/-!
# The coefficient of a locally principal subscheme in its own cycle

Let `Y` be an integral locally Noetherian scheme, locally of finite type over a field `K`, and
`Z ⊆ Y` a closed subscheme. At the generic point `ξ` of a component of `Z` of delta-dimension `k`
at which the ideal of `Z` is generated by the germ of a section `t`, the coefficient of `ξ` in
the cycle `[Z]_k` of `Z` (on `Z` itself) is the order of vanishing `ord_ξ(t)` of `t` on `Y`
(Stacks 02QU, 02RJ): `[Z]_k` on `Z` pushes forward to `[Z]_k` on `Y` along the inclusion, which
does not change coefficients, and there the coefficient is the length of `𝒪_{Z,ξ}`, which is
`ord_ξ(t)` (`Stacks.Chow.ord_eq_componentMultiplicity`).

This is the multiplicity entering Fulton's Lemma 19.1.3: the coefficient of a component of the
zero scheme `D = Z(s)` of a section of a line bundle in `[D]` is the order of vanishing of a local
equation of `s`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Order Stacks.Chow

namespace MMP.Chow

/-- **The coefficient of a component in the cycle of a locally principal subscheme** (Stacks
02QU, 02RJ): `[Z]_k(ξ) = ord_ξ(t)` when the ideal of `Z` is generated near `ξ` by `t`. -/
theorem cycleAssociatedToClosedSubscheme_self_apply_eq_ord (K : Type) [Field K]
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] (sY : Y ⟶ Spec (.of K))
    [LocallyOfFiniteType sY] (Z : Y.IdealSheafData) (ξ : genericPoints Z.subscheme) {k : ℕ}
    (hk : relativeDimension (fieldChowSituation K).dimensionFunction (Z.subschemeι ≫ sY) ξ.1 = k)
    (hco : coheight (Z.subschemeι ξ.1) = 1)
    {V : Y.Opens} [Nonempty V] (hξV : Z.subschemeι ξ.1 ∈ V) (t : Γ(Y, V)) (ht : t ≠ 0)
    (hZt : IdealSheafData.stalk Z (Z.subschemeι ξ.1) =
      Ideal.span {(Y.presheaf.germ V (Z.subschemeι ξ.1) hξV).hom t}) :
    (cycleAssociatedToClosedSubscheme (fieldChowSituation K) (Z.subschemeι ≫ sY) (𝟙 _) k).1 ξ.1 =
      Y.ord (Y.germToFunctionField V t) (Z.subschemeι ξ.1) := by
  have hpush := properPushforward_cycleAssociatedToClosedSubscheme_of_isClosedImmersion_comp
    (fieldChowSituation K) (Z.subschemeι ≫ sY) sY Z.subschemeι rfl (𝟙 _) k
  simp only [Category.id_comp] at hpush
  have hξY : relativeDimension (fieldChowSituation K).dimensionFunction sY (Z.subschemeι ξ.1) =
      k := by
    rw [← hk]
    exact (relativeDimension_eq_of_isClosedImmersion_comp (fieldChowSituation K)
      (Z.subschemeι ≫ sY) sY Z.subschemeι rfl (𝟙 _) ξ.1).symm
  have h1 := congrArg (fun c ↦ c.1 (Z.subschemeι ξ.1)) hpush
  simp only at h1
  rw [properPushforward_apply_image_of_isClosedImmersion,
    cycleAssociatedToClosedSubscheme_apply (fieldChowSituation K) sY Z.subschemeι k ξ hξY] at h1
  rw [h1, ord_eq_componentMultiplicity Z ξ hco hξV t ht hZt]

end MMP.Chow
