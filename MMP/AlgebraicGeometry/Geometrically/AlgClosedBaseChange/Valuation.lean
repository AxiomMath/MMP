module

import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.FundamentalExactSequenceSectionsSupplement
public import MMP.AlgebraicGeometry.Geometrically.AlgClosedBaseChange.Basic
public import MMP.AlgebraicGeometry.Positivity.SemiampleDescent
public import MMP.AlgebraicGeometry.Resolution.SNCFieldChange
public import MMP.AlgebraicGeometry.Resolution.Surface.TopFormDivisors

/-!
# Base change of the ground field: numerical classes, valuations and Cartier descent

Let `k₀ ⊆ K` be algebraically closed fields and `π : X ⟶ X₀` the base change of a normal
variety `X₀` over `k₀` to `K`. A prime divisor `P` of `X` whose closure is `π⁻¹(closure P₀)` has
a divisorial valuation that restricts to that of `P₀` on the function field of `X₀`. This file
proves this, and the facts around it used to descend Cartier divisors along `π`:

* numerical classes of real Cartier divisors are determined by their degrees on curves, and are
  compatible with the pull-back along a morphism;
* the stalk of `X` at the generic point of such a `P` is regular of dimension one, with maximal
  ideal generated by that of `X₀`;
* closures of images of base-changed points, and inverse transforms of prime divisors under
  birational morphisms, are computed on generic points;
* orders of vanishing of sums `∑ aᵢ cᵢ`, with `aᵢ` rational functions on `X₀` and `cᵢ ∈ K`
  linearly independent over `k₀`, are the minima of the orders of the `aᵢ`;
* bounds on orders of vanishing of sections of divisorial sheaves.

## Main results

* `MMP.ProgramBaseChange.valuation_fieldMap_of_closure_eq`: the valuation of a base-changed prime
  divisor restricts to the valuation of the original one.
* `MMP.ProgramBaseChange.ordGE_of_ordGE_sum`: the order of a sum with linearly independent
  constant coefficients bounds the orders of its terms.
* `MMP.ProgramBaseChange.numericalDivisorClass_lmapDomain_eq_of_forall`: numerical classes of
  pulled back divisors.

## References

* [KM98] Kollár, Mori, *Birational Geometry of Algebraic Varieties*.
-/

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MMP.Mori MMP.Fourfold

universe u

namespace MMP.ProgramBaseChange

section Helpers

variable {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K] [IsAlgClosed k₀] [IsAlgClosed K]

/-- A morphism over `k` from a projective variety to a projective variety is proper. -/
public theorem isProper_of_comp_eq {k : Type u} [Field k] {X₀ Z₀ : Scheme.{u}}
    {s₀ : X₀ ⟶ Spec (.of k)} {t₀ : Z₀ ⟶ Spec (.of k)} (hX₀ : MMP.Mori.IsProjectiveVariety k s₀)
    (hZ₀ : MMP.Mori.IsProjectiveVariety k t₀) {f₀ : X₀ ⟶ Z₀} (hf₀ : f₀ ≫ t₀ = s₀) :
    IsProper f₀ := by
  have : IsProper s₀ :=
    (isProjectiveMorphism_iff_isHQuasiProjective_and_isProper.mp
      ((MMP.Mori.isProjectiveVariety_iff _ _).mp hX₀).2).2
  have : IsSeparated t₀ := hZ₀.toIsSeparated
  have : IsProper (f₀ ≫ t₀) := by rw [hf₀]; infer_instance
  exact IsProper.of_comp f₀ t₀

omit [IsAlgClosed k₀] [IsAlgClosed K] in
/-- The square of a morphism over `k₀` and its base change is a pullback. -/
public theorem isPullback_of_isPullback_comp {X₀ X Z₀ Z : Scheme.{u}}
    {s₀ : X₀ ⟶ Spec (.of k₀)} {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀}
    {t₀ : Z₀ ⟶ Spec (.of k₀)} {t : Z ⟶ Spec (.of K)} {πZ : Z ⟶ Z₀}
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    (hZ : IsPullback πZ t t₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    {f₀ : X₀ ⟶ Z₀} (hf₀ : f₀ ≫ t₀ = s₀) {f : X ⟶ Z} (hf : f ≫ t = s)
    (hfπ : f ≫ πZ = π ≫ f₀) : IsPullback π f f₀ πZ :=
  IsPullback.of_bot (by rw [hf, hf₀]; exact h) hfπ.symm hZ

omit [IsAlgClosed k₀] [IsAlgClosed K] in
/-- A base-changed morphism is isomorphic to the canonical base change
`X₀ ×_{Z₀} (Z₀ ×_{k₀} K) ⟶ Z₀ ×_{k₀} K`. -/
public theorem exists_iso_pullback_of_isPullback {X₀ X Z₀ Z : Scheme.{u}}
    {π : X ⟶ X₀} {t₀ : Z₀ ⟶ Spec (.of k₀)} {t : Z ⟶ Spec (.of K)} {πZ : Z ⟶ Z₀}
    {f₀ : X₀ ⟶ Z₀} {f : X ⟶ Z} (hsq : IsPullback π f f₀ πZ)
    (hZ : IsPullback πZ t t₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) :
    ∃ (e : X ≅ pullback f₀ (pullback.fst t₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))))
      (eZ : Z ≅ pullback t₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))),
      e.hom ≫ pullback.snd _ _ = f ≫ eZ.hom ∧ e.hom ≫ pullback.fst _ _ = π ∧
        eZ.hom ≫ pullback.fst _ _ = πZ := by
  set q := pullback.fst t₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))
  let eZ := hZ.isoPullback
  have hq : eZ.hom ≫ q = πZ := hZ.isoPullback_hom_fst
  have sq2 : IsPullback eZ.hom πZ q (𝟙 Z₀) :=
    IsPullback.of_horiz_isIso ⟨by rw [hq, Category.comp_id]⟩
  have hsq' := hsq.flip.paste_horiz sq2
  rw [Category.comp_id] at hsq'
  refine ⟨hsq'.flip.isoPullback, eZ, hsq'.flip.isoPullback_hom_snd,
    hsq'.flip.isoPullback_hom_fst, hq⟩

/-- A prime divisor of `X` is the base change of at most one prime divisor of `X₀`. -/
public theorem primeDivisor_eq_of_closure_eq {X₀ X : Scheme.{u}} {π : X ⟶ X₀} [Surjective π]
    {P₀ Q₀ : MMP.Mori.PrimeDivisor X₀} {P : MMP.Mori.PrimeDivisor X}
    (hP : closure {P.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint})
    (hQ : closure {P.genericPoint} = π.base ⁻¹' closure {Q₀.genericPoint}) : P₀ = Q₀ := by
  have hc : closure {P₀.genericPoint} = closure {Q₀.genericPoint} :=
    (Set.preimage_injective.mpr π.surjective) (hP.symm.trans hQ)
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    ((inseparable_iff_closure_eq.mpr hc).eq)

/-- At most one prime divisor of `X` is the base change of a given prime divisor of `X₀`. -/
public theorem primeDivisor_eq_of_closure_eq' {X₀ X : Scheme.{u}} {π : X ⟶ X₀}
    {P₀ : MMP.Mori.PrimeDivisor X₀} {P Q : MMP.Mori.PrimeDivisor X}
    (hP : closure {P.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint})
    (hQ : closure {Q.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint}) : P = Q :=
  AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    ((inseparable_iff_closure_eq.mpr (hP.trans hQ.symm)).eq)

/-- `f_* 𝒪 = 𝒪` is invariant under isomorphisms of source and target. -/
public theorem forall_isIso_app_of_iso {X Y X' Y' : Scheme.{u}} {f : X ⟶ Y} {f' : X' ⟶ Y'}
    (e : X ≅ X') (e' : Y ≅ Y') (w : e.hom ≫ f' = f ≫ e'.hom)
    (hf : ∀ U : Y.Opens, IsIso (f.app U)) (U : Y'.Opens) : IsIso (f'.app U) := by
  have : f' = e.inv ≫ f ≫ e'.hom := by rw [← w, Iso.inv_hom_id_assoc]
  subst this
  rw [Scheme.Hom.comp_app, Scheme.Hom.comp_app]
  exact @IsIso.comp_isIso _ _ _ _ _ _ _ (@IsIso.comp_isIso _ _ _ _ _ _ _
    (Scheme.Hom.instIsIsoCommRingCatApp e'.hom U) (hf (e'.hom ⁻¹ᵁ U)))
    (Scheme.Hom.instIsIsoCommRingCatApp e.inv _)

/-! ### Numerical classes of Cartier divisors -/

section NumericalClasses

variable {k : Type u} [Field k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  {sY : Y ⟶ Spec (.of k)}

/-- The intersection number of a proper curve with a Cartier divisor is the degree of its sheaf. -/
public theorem intersectionNumber_cycle_ofCartier (C : ProperCurve sX) (E : X.CartierDivisor) :
    (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ E) =
      (C.degree k (MMP.CartierDivisor.sheaf E) : ℝ) := by
  rw [OneCycle.intersectionNumber_ofCartier, OneCycle.cartierDegree, OneCycle.degree_cycle]

/-- `ℝ`-Cartier divisors with the same intersection numbers with every proper curve have the same
numerical class. -/
public theorem numericalDivisorClass_eq_of_forall {D D' : KCartierDivisor ℝ X}
    (h : ∀ C : ProperCurve sX,
      (C.cycle ℝ).intersectionNumber D = (C.cycle ℝ).intersectionNumber D') :
    numericalDivisorClass sX D = numericalDivisorClass sX D' := by
  change (numericallyTrivialDivisors sX).mkQ D = (numericallyTrivialDivisors sX).mkQ D'
  rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq,
    mem_numericallyTrivialDivisors]
  intro C
  have := h C
  simp only [OneCycle.intersectionNumber, map_sub, LinearMap.sub_apply] at this ⊢
  rw [this, sub_self]

/-- `ℝ`-Cartier divisors with the same numerical class have the same intersection numbers. -/
public theorem intersectionNumber_eq_of_numericalDivisorClass_eq' {D D' : KCartierDivisor ℝ X}
    (h : numericalDivisorClass sX D = numericalDivisorClass sX D') (C : ProperCurve sX) :
    (C.cycle ℝ).intersectionNumber D = (C.cycle ℝ).intersectionNumber D' := by
  have h' := (Submodule.Quotient.eq _).mp h
  rw [mem_numericallyTrivialDivisors] at h'
  have := h' C
  simp only [OneCycle.intersectionNumber, map_sub, LinearMap.sub_apply, sub_eq_zero] at this
  exact this

/-- Cartier divisors with isomorphic sheaves have the same class. -/
public theorem numericalDivisorClass_lmapDomain_eq {Z : Scheme.{u}}
    (a b : Z.CartierDivisor → X.CartierDivisor)
    (hab : ∀ G, Nonempty (MMP.CartierDivisor.sheaf (a G) ≅
      MMP.CartierDivisor.sheaf (b G)))
    (c : KCartierDivisor ℝ Z) :
    numericalDivisorClass sX (Finsupp.lmapDomain ℝ ℝ a c) =
      numericalDivisorClass sX (Finsupp.lmapDomain ℝ ℝ b c) := by
  refine numericalDivisorClass_eq_of_forall fun C => ?_
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c c' hc hc' =>
    simp only [map_add, OneCycle.intersectionNumber] at hc hc' ⊢
    rw [LinearMap.add_apply, LinearMap.add_apply, hc, hc']
  | single G r =>
    rw [Finsupp.lmapDomain_apply, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single,
      Finsupp.mapDomain_single, ← mul_one r, ← smul_eq_mul, ← Finsupp.smul_single,
      ← Finsupp.smul_single]
    simp only [OneCycle.intersectionNumber, map_smul, LinearMap.smul_apply]
    change r • (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ (a G)) =
      r • (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ (b G))
    rw [intersectionNumber_cycle_ofCartier, intersectionNumber_cycle_ofCartier,
      degree_congr C (hab G).some]

/-- **Pulled-back classes only depend on classes.** Let `p` lift Cartier divisors along
`g : X ⟶ Y`, `𝒪_X(p G) ≅ g^* 𝒪_Y(G)`. If two `ℝ`-Cartier divisors on `Y` have the same
intersection numbers with every proper curve, so do their lifts, by the projection formula. -/
public theorem numericalDivisorClass_lmapDomain_eq_of_forall [IsSeparated sY]
    [LocallyOfFiniteType sY] (g : X ⟶ Y) (hg : g ≫ sY = sX)
    (p : Y.CartierDivisor → X.CartierDivisor)
    (hp : ∀ G, Nonempty (MMP.CartierDivisor.sheaf (p G) ≅
      (Scheme.Modules.pullback g).obj (MMP.CartierDivisor.sheaf G)))
    {c c' : KCartierDivisor ℝ Y}
    (hcc' : ∀ C : ProperCurve sY,
      (C.cycle ℝ).intersectionNumber c = (C.cycle ℝ).intersectionNumber c') :
    numericalDivisorClass sX (Finsupp.lmapDomain ℝ ℝ p c) =
      numericalDivisorClass sX (Finsupp.lmapDomain ℝ ℝ p c') := by
  refine numericalDivisorClass_eq_of_forall fun C => ?_
  have hsingle (G : Y.CartierDivisor) (r : ℝ) :
      Finsupp.lmapDomain ℝ ℝ p (Finsupp.single G r) = r • KCartierDivisor.ofCartier ℝ (p G) := by
    rw [Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, KCartierDivisor.ofCartier,
      Finsupp.smul_single, smul_eq_mul, mul_one]
  have hsingle' (G : Y.CartierDivisor) (r : ℝ) :
      (Finsupp.single G r : KCartierDivisor ℝ Y) = r • KCartierDivisor.ofCartier ℝ G := by
    rw [KCartierDivisor.ofCartier, Finsupp.smul_single, smul_eq_mul, mul_one]
  by_cases h : IsProperCurve sY (g C.point)
  · have key (d : KCartierDivisor ℝ Y) :
        (C.cycle ℝ).intersectionNumber (Finsupp.lmapDomain ℝ ℝ p d) =
          (residueFieldDegree g C.point : ℝ) *
            ((⟨g C.point, h⟩ : ProperCurve sY).cycle ℝ).intersectionNumber d := by
      induction d using Finsupp.induction_linear with
      | zero => simp [OneCycle.intersectionNumber]
      | add d d' hd hd' =>
        simp only [map_add, OneCycle.intersectionNumber, LinearMap.add_apply] at hd hd' ⊢
        rw [hd, hd', mul_add]
      | single G r =>
        rw [hsingle, hsingle']
        simp only [OneCycle.intersectionNumber, map_smul, LinearMap.smul_apply]
        change r • (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ (p G)) =
          (residueFieldDegree g C.point : ℝ) * (r • ((⟨g C.point, h⟩ : ProperCurve sY).cycle ℝ
            ).intersectionNumber (KCartierDivisor.ofCartier ℝ G))
        rw [intersectionNumber_cycle_ofCartier, degree_congr C (hp G).some,
          ProperCurve.degree_pullback g hg C, dite_eq_left h, intersectionNumber_cycle_ofCartier]
        push_cast
        simp only [smul_eq_mul]
        ring
    rw [key, key, hcc' ⟨g C.point, h⟩]
  · have key (d : KCartierDivisor ℝ Y) :
        (C.cycle ℝ).intersectionNumber (Finsupp.lmapDomain ℝ ℝ p d) = 0 := by
      induction d using Finsupp.induction_linear with
      | zero => simp [OneCycle.intersectionNumber]
      | add d d' hd hd' =>
        simp only [map_add, OneCycle.intersectionNumber, LinearMap.add_apply] at hd hd' ⊢
        rw [hd, hd', add_zero]
      | single G r =>
        rw [hsingle]
        simp only [OneCycle.intersectionNumber, map_smul, LinearMap.smul_apply]
        change r • (C.cycle ℝ).intersectionNumber (KCartierDivisor.ofCartier ℝ (p G)) = 0
        rw [intersectionNumber_cycle_ofCartier, degree_congr C (hp G).some,
          ProperCurve.degree_pullback g hg C, dite_eq_right h]
        simp
    rw [key, key]

/-- If an isomorphism `e : N¹(X₀)_ℝ ≃ N¹(X)_ℝ` sends the class of each Cartier divisor `D₀` to the
class of `p D₀`, then every `ℝ`-Cartier divisor on `X` is numerically equivalent to the image of
an `ℝ`-Cartier divisor on `X₀` under the linear extension of `p`. -/
public theorem exists_numericalDivisorClass_eq_lmapDomain {k₀ K : Type u} [Field k₀] [Field K]
    {X₀ X : Scheme.{u}} {s₀ : X₀ ⟶ Spec (.of k₀)} {s : X ⟶ Spec (.of K)}
    (p : X₀.CartierDivisor → X.CartierDivisor)
    (e : NumericalDivisorClasses s₀ ≃ₗ[ℝ] NumericalDivisorClasses s)
    (he : ∀ D₀, e (numericalDivisorClass s₀ (KCartierDivisor.ofCartier ℝ D₀)) =
      numericalDivisorClass s (KCartierDivisor.ofCartier ℝ (p D₀)))
    (D : KCartierDivisor ℝ X) :
    ∃ c₀, numericalDivisorClass s D = numericalDivisorClass s (Finsupp.lmapDomain ℝ ℝ p c₀) := by
  have hcomp : e.toLinearMap ∘ₗ numericalDivisorClass s₀ =
      numericalDivisorClass s ∘ₗ Finsupp.lmapDomain ℝ ℝ p := by
    ext D₀
    simpa [KCartierDivisor.ofCartier] using he D₀
  obtain ⟨c₀, hc₀⟩ := (numericallyTrivialDivisors s₀).mkQ_surjective
    (e.symm (numericalDivisorClass s D))
  refine ⟨c₀, ?_⟩
  rw [← LinearMap.comp_apply (numericalDivisorClass s), ← hcomp]
  exact (congrArg e hc₀).trans (e.apply_symm_apply _) |>.symm

end NumericalClasses

/-! ### Valuations along base-changed prime divisors -/

section Valuation

open scoped TensorProduct
open MMP.Resolution

/-- Over an algebraically closed field `k`, `κ ⊗_k L` is a regular ring for every finitely
generated field extension `κ/k` and every field extension `L/k`. -/
private lemma isRegularRing_tensorProduct_of_isAlgClosed (k : Type u) (κ : Type u) (L : Type*)
    [Field k] [IsAlgClosed k] [Field κ] [Field L] [Algebra k κ] [Algebra k L]
    [Algebra.EssFiniteType k κ] : IsRegularRing (κ ⊗[k] L) := by
  refine (Algebra.forall_isRegularRing_tensorProduct_essFiniteType_iff_finite_isPurelyInseparable
    k L).mpr (fun K' _ _ _ _ => ?_) κ
  have hbij : Function.Bijective (algebraMap k K') := IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : K' ≃ₐ[k] k := (AlgEquiv.ofBijective (Algebra.ofId k K') hbij).symm
  exact IsRegularRing.of_ringEquiv ((Algebra.TensorProduct.congr e AlgEquiv.refl).trans
    (Algebra.TensorProduct.lid k L)).toRingEquiv.symm

omit [IsAlgClosed K] in
/-- The fibres of a base change `X ⟶ X₀` along `Spec K ⟶ Spec k₀`, for `k₀` algebraically closed
and `X₀` locally of finite type, are regular: the fibre over `x` is `Spec (κ(x) ⊗_{k₀} K)`. -/
private lemma isRegular_fiber_of_isPullback {X₀ X : Scheme.{u}} {s₀ : X₀ ⟶ Spec (.of k₀)}
    {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀} [LocallyOfFiniteType s₀]
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) (x : X₀) :
    IsRegular (π.fiber x) := by
  let : Algebra k₀ (X₀.residueField x) :=
    ((Scheme.ΓSpecIso (.of k₀)).inv ≫ s₀.appTop ≫ X₀.Γevaluation x).hom.toAlgebra
  have : Algebra.EssFiniteType k₀ (X₀.residueField x) := residueField_essFiniteType k₀ s₀ x
  have hpaste : IsPullback (π.fiberToSpecResidueField x) (π.fiberι x ≫ s)
      (X₀.fromSpecResidueField x ≫ s₀) (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) :=
    (IsPullback.of_hasPullback π (X₀.fromSpecResidueField x)).flip.paste_vert h
  rw [← SpecMap_algebraMap_residueField s₀ x] at hpaste
  let e : π.fiber x ≅ Spec (.of (X₀.residueField x ⊗[k₀] K)) :=
    hpaste.isoPullback ≪≫ pullbackSpecIso k₀ (X₀.residueField x) K
  have := isRegularRing_tensorProduct_of_isAlgClosed k₀ (X₀.residueField x) K
  exact IsRegular.of_iso e ((isRegular_spec_iff _).2 this)

omit [IsAlgClosed K] in
/-- **Uniformizers pull back to uniformizers.** At a point `y` of the base change `X` of
coheight one lying over a point of coheight one, the maximal ideal of `𝒪_{X₀,π(y)}` generates
that of `𝒪_{X,y}`: the closed fibre `𝒪_{X,y}/𝔪_{π y}𝒪_{X,y}` is a zero-dimensional regular local
ring, hence a field. -/
private lemma map_maximalIdeal_stalkMap_eq {X₀ X : Scheme.{u}} {s₀ : X₀ ⟶ Spec (.of k₀)}
    {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀} [LocallyOfFiniteType s₀] [IsIntegral X]
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) (y : X)
    (hy : Order.coheight y = 1) (hx : Order.coheight (π y) = 1) :
    Ideal.map (π.stalkMap y).hom (IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π y))) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk y) := by
  have : LocallyOfFiniteType s := MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) h ‹_›
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian s
  have : IsLocallyNoetherian X₀ := LocallyOfFiniteType.isLocallyNoetherian s₀
  have : Flat π := MorphismProperty.of_isPullback (P := @Flat) h.flip
    (specMap_mem_surjective_flat_quasiCompact (algebraMap k₀ K)).1.2
  letI := (π.stalkMap y).hom.toAlgebra
  have hreg := isRegularLocalRing_closedFibre_of_isRegular_fiber π y
    (isRegular_fiber_of_isPullback h (π y))
  let I : Ideal (X.presheaf.stalk y) := Ideal.map (π.stalkMap y).hom
    (IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π y)))
  change IsRegularLocalRing (X.presheaf.stalk y ⧸ I) at hreg
  haveI : IsLocalRing (X.presheaf.stalk y ⧸ I) := hreg.toIsLocalRing
  refine le_antisymm (IsLocalRing.map_maximalIdeal_le _) ?_
  -- `I ≠ ⊥`, since `𝔪_A ≠ 0` and `A ⟶ B` is injective
  have hdimA : ringKrullDim (X₀.presheaf.stalk (π y)) = 1 := by
    rw [ringKrullDim_stalk_eq_coheight, hx]; rfl
  have hdimB : ringKrullDim (X.presheaf.stalk y) = 1 := by
    rw [ringKrullDim_stalk_eq_coheight, hy]; rfl
  have hmA : IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π y)) ≠ ⊥ := by
    intro h0
    have hf : IsField (X₀.presheaf.stalk (π y)) :=
      (IsLocalRing.isField_iff_maximalIdeal_eq).mpr h0
    have := ringKrullDim_eq_zero_of_isField hf
    rw [hdimA] at this
    exact one_ne_zero this
  have hI0 : I ≠ ⊥ := by
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hmA
    intro h0
    have hmem : (π.stalkMap y).hom a ∈ I := Ideal.mem_map_of_mem _ ha
    rw [h0, Ideal.mem_bot] at hmem
    exact ha0 ((π.stalkMap_injective_of_flat y) (by rw [hmem, map_zero]))
  -- every prime of `B` containing `I` is maximal, so `B/I` has dimension zero
  have : Ring.KrullDimLE 1 (X.presheaf.stalk y) := by
    rw [Ring.krullDimLE_iff, hdimB]; rfl
  have hprime : ∀ Q : Ideal (X.presheaf.stalk y ⧸ I), Q.IsPrime → Q.IsMaximal := by
    intro Q hQ
    have hQ' : (Q.comap (Ideal.Quotient.mk I)).IsPrime := Ideal.comap_isPrime _ _
    have hle : I ≤ Q.comap (Ideal.Quotient.mk I) := by
      intro b hb
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hb]
      exact Q.zero_mem
    have hne : Q.comap (Ideal.Quotient.mk I) ≠ ⊥ := fun h0 => hI0 (le_bot_iff.mp (h0 ▸ hle))
    have hmax := Ideal.isMaximal_of_isPrime_of_ne_bot _ hne
    have := Ideal.IsMaximal.map_of_surjective_of_ker_le (m := Q.comap (Ideal.Quotient.mk I))
      (Ideal.Quotient.mk_surjective (I := I)) (by rw [Ideal.mk_ker]; exact hle)
    rwa [Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective] at this
  have hdim0 : ringKrullDim (X.presheaf.stalk y ⧸ I) = 0 :=
    ringKrullDimZero_iff_ringKrullDim_eq_zero.mp (Ring.krullDimLE_zero_iff.mpr hprime)
  have hbot : IsLocalRing.maximalIdeal (X.presheaf.stalk y ⧸ I) = ⊥ := by
    have h1 := hreg.spanFinrank_maximalIdeal
    rw [hdim0] at h1
    exact (Submodule.spanFinrank_eq_zero_iff_eq_bot
      (IsNoetherian.noetherian _)).mp (by exact_mod_cast h1)
  have hmax : I.IsMaximal :=
    Ideal.Quotient.maximal_of_isField _ (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot)
  exact (IsLocalRing.eq_maximalIdeal hmax).ge

/-- Over an algebraically closed field the tensor product of two domains is a domain. -/
private theorem isDomain_tensorProduct_of_isAlgClosed (k A B : Type u) [Field k] [IsAlgClosed k]
    [CommRing A] [IsDomain A] [Algebra k A] [CommRing B] [IsDomain B] [Algebra k B] :
    IsDomain (A ⊗[k] B) := by
  have he : Function.Bijective (algebraMap k (AlgebraicClosure k)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : k ≃ₐ[k] AlgebraicClosure k :=
    AlgEquiv.ofBijective (Algebra.ofId k (AlgebraicClosure k)) he
  have h : IsDomain (B ⊗[k] AlgebraicClosure k) := by
    let f : B ⊗[k] AlgebraicClosure k ≃ₐ[k] B :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl) e.symm).trans
        (Algebra.TensorProduct.rid k k B)
    exact Function.Injective.isDomain f.toRingHom f.injective
  haveI : Algebra.IsGeometricallyIntegral k B :=
    ((Algebra.isGeometricallyIntegral_tfae k B).out 4 1).mp h
  exact Algebra.IsGeometricallyIntegral.isDomain_tensorProduct k A B

/-- In a tensor product over a field, `∑ mᵢ ⊗ vᵢ = 0` with `(vᵢ)` linearly independent forces all
`mᵢ = 0`. -/
private theorem tmul_sum_eq_zero {k M V : Type*} [Field k] [AddCommGroup M] [Module k M]
    [AddCommGroup V] [Module k V] {ι : Type*} [Fintype ι] (m : ι → M) (v : ι → V)
    (hv : LinearIndependent k v) (h : ∑ i, m i ⊗ₜ[k] v i = 0) (i : ι) : m i = 0 := by
  classical
  let b := Module.Basis.extend hv.linearIndepOn_id
  let idx (j : ι) : hv.linearIndepOn_id.extend (Set.subset_univ _) :=
    ⟨v j, Module.Basis.subset_extend hv.linearIndepOn_id (Set.mem_range_self j)⟩
  have hb (j : ι) : v j = b (idx j) := by
    simp only [b, idx, Module.Basis.coe_extend]
  have h2 := congrArg (TensorProduct.equivFinsuppOfBasisRight (M := M) b) h
  simp only [map_sum, map_zero] at h2
  have h3 := congrArg (fun f => f (idx i)) h2
  simp only [Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.coe_zero, Pi.zero_apply] at h3
  rw [Finset.sum_eq_single i] at h3
  · rw [hb i, TensorProduct.equivFinsuppOfBasisRight_apply_tmul_apply] at h3
    simpa using h3
  · intro j _ hj
    rw [hb j, TensorProduct.equivFinsuppOfBasisRight_apply_tmul_apply]
    rw [Module.Basis.repr_self, Finsupp.single_apply, ite_eq_right, zero_smul]
    intro hji
    exact hj (hv.injective (congrArg Subtype.val hji))
  · simp

/-- For `f : Spec O ⟶ Spec A` from the spectrum of a local ring, `stalkClosedPointTo f` on germs
of global sections is the ring map of `f`. -/
private lemma germ_top_stalkClosedPointTo {O A : CommRingCat.{u}} [IsLocalRing O]
    (f : Spec O ⟶ Spec A) :
    (Spec A).presheaf.germ ⊤ _ (by simp) ≫ Scheme.stalkClosedPointTo f =
      (Scheme.ΓSpecIso A).hom ≫ Spec.preimage f := by
  obtain ⟨φ, rfl⟩ : ∃ φ, f = Spec.map φ := ⟨_, (Spec.map_preimage f).symm⟩
  rw [Spec.preimage_map]
  exact Scheme.germ_stalkClosedPointTo_Spec φ

/-- Stalk maps at `y'` through the canonical morphism `Spec 𝒪_{F,y'} ⟶ F`. -/
private lemma stalkClosedPointTo_fromSpecStalk_comp {F Z : Scheme.{u}} (y' : F) (g : F ⟶ Z) :
    Scheme.stalkClosedPointTo (F.fromSpecStalk y' ≫ g) =
      (Z.presheaf.stalkCongr (Inseparable.of_eq
        (congrArg g (Scheme.fromSpecStalk_closedPoint (x := y'))))).hom ≫ g.stalkMap y' := by
  rw [Scheme.stalkClosedPointTo_comp, Scheme.stalkClosedPointTo_fromSpecStalk]
  exact g.stalkMap_congr_point _ _ (Scheme.fromSpecStalk_closedPoint (x := y'))

/-- Germs of global sections commute with stalk maps, up to the identifications of stalks at
equal points. -/
private lemma appTop_germ_stalkCongr {X Z F : Scheme.{u}} (s : X ⟶ Z) (ι : F ⟶ X) (y : X)
    (y' : F) (h : y = ι y') (z : Z) (hz : z = s (ι y')) :
    s.appTop ≫ X.presheaf.germ ⊤ y (by simp) ≫ (X.presheaf.stalkCongr (Inseparable.of_eq h)).hom ≫
      ι.stalkMap y' = Z.presheaf.germ ⊤ z (by simp) ≫
        (Z.presheaf.stalkCongr (Inseparable.of_eq hz)).hom ≫ s.stalkMap (ι y') ≫
          ι.stalkMap y' := by
  subst h hz
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
    Category.id_comp, Scheme.Hom.germ_stalkMap_assoc]
  rfl

private lemma stalkSpecializes_three {C : Type*} [Category C] [HasColimits C] {X : TopCat}
    (F : TopCat.Presheaf C X) {a b c : X} (h₁ : b ⤳ a) (h₂ : c ⤳ b) (h₃ : a ⤳ c) {D : C}
    (g : F.stalk a ⟶ D) :
    F.stalkSpecializes h₁ ≫ F.stalkSpecializes h₂ ≫ F.stalkSpecializes h₃ ≫ g = g := by
  rw [TopCat.Presheaf.stalkSpecializes_comp_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc,
    TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]

/-- `stalkClosedPointTo` of `Spec.map f ≫ X.fromSpecStalk x` is `f`. -/
private lemma stalkClosedPointTo_eq_of_eq {X : Scheme.{u}} {x : X} {O : CommRingCat.{u}}
    [IsLocalRing O] (M : Spec O ⟶ X) (f : X.presheaf.stalk x ⟶ O) [IsLocalHom f.hom]
    (hM : M = Spec.map f ≫ X.fromSpecStalk x) :
    Scheme.stalkClosedPointTo M =
      (X.presheaf.stalkCongr (Inseparable.of_eq (by
        subst hM
        change X.fromSpecStalk x (Spec.map f (IsLocalRing.closedPoint O)) = x
        rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]))).hom ≫ f := by
  subst hM
  refine TopCat.Presheaf.stalk_hom_ext _ fun U hxU => ?_
  rw [Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk, TopCat.Presheaf.stalkCongr_hom,
    ← Category.assoc]
  erw [TopCat.Presheaf.germ_stalkSpecializes]

/-- If `F ≅ Spec R` with `R` a domain, the ring map `R ⟶ 𝒪_{F,y'}` is injective. -/
private lemma injective_preimage_fromSpecStalk_comp {F : Scheme.{u}} {R : CommRingCat.{u}}
    [IsDomain R] (e : F ≅ Spec R) (y' : F) :
    Function.Injective (Spec.preimage (F.fromSpecStalk y' ≫ e.hom)).hom := by
  intro r₁ r₂ hr
  have key (r : R) : (Spec.preimage (F.fromSpecStalk y' ≫ e.hom)).hom r =
      (Scheme.stalkClosedPointTo (F.fromSpecStalk y' ≫ e.hom)).hom
        ((Spec R).presheaf.germ ⊤ _ (by simp) ((Scheme.ΓSpecIso R).inv r)) := by
    rw [← CommRingCat.comp_apply, germ_top_stalkClosedPointTo]; simp
  rw [key, key, stalkClosedPointTo_fromSpecStalk_comp] at hr
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hr
  haveI : IsIso (e.hom.stalkMap y') := IsOpenImmersion.instIsIsoCommRingCatStalkMap e.hom y'
  have hinj1 := (ConcreteCategory.bijective_of_isIso (e.hom.stalkMap y')).1
  have hinj2 := (ConcreteCategory.bijective_of_isIso
    ((Spec R).presheaf.stalkCongr (Inseparable.of_eq
        (congrArg e.hom (Scheme.fromSpecStalk_closedPoint (x := y'))))).hom).1
  have hinj3 := germ_injective_of_isIntegral (Spec R)
    (e.hom (F.fromSpecStalk y' (IsLocalRing.closedPoint _))) (U := ⊤) (by simp)
  have hinj4 := (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).inv).1
  exact hinj4 (hinj3 (hinj2 (hinj1 hr)))

/-- On the fibre `F ≅ Spec R` of `π` through `y`, the composite `𝒪_{X₀,π y} ⟶ 𝒪_{X,y} ⟶ 𝒪_{F,y}`
factors through the residue field `κ(π y) ⟶ R`. -/
private lemma stalkMap_comp_fiberι_stalkMap_eq {X₀ X : Scheme.{u}} {π : X ⟶ X₀} (y : X)
    {R : CommRingCat.{u}} (e : π.fiber (π y) ≅ Spec R)
    (incL : X₀.residueField (π y) ⟶ R) [IsLocalHom (incL ≫ Spec.preimage
      ((π.fiber (π y)).fromSpecStalk (π.asFiber y) ≫ e.hom)).hom]
    (E1 : e.hom ≫ Spec.map incL = π.fiberToSpecResidueField (π y)) :
    π.stalkMap y ≫ (X.presheaf.stalkCongr (Inseparable.of_eq (π.fiberι_asFiber y).symm)).hom ≫
      (π.fiberι (π y)).stalkMap (π.asFiber y) =
      X₀.residue (π y) ≫ incL ≫
        Spec.preimage ((π.fiber (π y)).fromSpecStalk (π.asFiber y) ≫ e.hom) := by
  set y' := π.asFiber y
  set j := (π.fiber (π y)).fromSpecStalk y'
  set θ' := Spec.preimage (j ≫ e.hom)
  have hθ' : Spec.map θ' = j ≫ e.hom := Spec.map_preimage _
  let φ := X₀.residue (π y) ≫ incL ≫ θ'
  haveI : IsLocalHom (X₀.residue (π y)).hom :=
    inferInstanceAs (IsLocalHom (IsLocalRing.residue _))
  haveI : IsLocalHom φ.hom := by
    change IsLocalHom ((incL ≫ θ').hom.comp (X₀.residue (π y)).hom); infer_instance
  have hM : j ≫ π.fiberι (π y) ≫ π = Spec.map φ ≫ X₀.fromSpecStalk (π y) := by
    rw [Scheme.Hom.fiber_fac, ← E1, Scheme.fromSpecResidueField]
    simp only [φ, Spec.map_comp, Category.assoc]
    rw [← Category.assoc j, ← hθ']
  have L1 := stalkClosedPointTo_eq_of_eq _ φ hM
  rw [stalkClosedPointTo_fromSpecStalk_comp, Scheme.Hom.stalkMap_comp] at L1
  have h2 := π.stalkMap_congr_point _ _ (π.fiberι_asFiber y).symm
  rw [← Category.assoc, h2, Category.assoc, (Iso.eq_inv_comp _).mpr L1]
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkCongr_inv]
  exact stalkSpecializes_three _ _ _ _ φ

/-- On the fibre `F ≅ Spec R` of `π` through `y`, global sections pulled back from `s : X ⟶ Spec A`
reach `𝒪_{F,y}` through `A ⟶ R`. -/
private lemma appTop_comp_fiberι_stalkMap_eq {X₀ X : Scheme.{u}} {A : CommRingCat.{u}}
    {s : X ⟶ Spec A} {π : X ⟶ X₀} (y : X) {R : CommRingCat.{u}} (e : π.fiber (π y) ≅ Spec R)
    (incR : A ⟶ R) (E2 : e.hom ≫ Spec.map incR = π.fiberι (π y) ≫ s) :
    (Scheme.ΓSpecIso A).inv ≫ s.appTop ≫ X.presheaf.germ ⊤ y (by simp) ≫
      (X.presheaf.stalkCongr (Inseparable.of_eq (π.fiberι_asFiber y).symm)).hom ≫
        (π.fiberι (π y)).stalkMap (π.asFiber y) =
      incR ≫ Spec.preimage ((π.fiber (π y)).fromSpecStalk (π.asFiber y) ≫ e.hom) := by
  set y' := π.asFiber y
  set j := (π.fiber (π y)).fromSpecStalk y'
  have hpre : Spec.preimage (j ≫ π.fiberι (π y) ≫ s) = incR ≫ Spec.preimage (j ≫ e.hom) := by
    have : Spec.map (incR ≫ Spec.preimage (j ≫ e.hom)) = j ≫ π.fiberι (π y) ≫ s := by
      rw [Spec.map_comp, Spec.map_preimage, Category.assoc, E2]
    rw [← this, Spec.preimage_map]
  rw [← hpre, ← cancel_epi (Scheme.ΓSpecIso A).hom, Iso.hom_inv_id_assoc,
    ← germ_top_stalkClosedPointTo, stalkClosedPointTo_fromSpecStalk_comp,
    Scheme.Hom.stalkMap_comp]
  exact appTop_germ_stalkCongr s (π.fiberι (π y)) y y' (π.fiberι_asFiber y).symm _
    (congrArg (π.fiberι (π y) ≫ s) (Scheme.fromSpecStalk_closedPoint (x := y')))

omit [IsAlgClosed K] in
/-- **Gauss lemma on stalks.** Let `π : X ⟶ X₀` be the base change along `k₀ ⊆ K`, `k₀`
algebraically closed, and `y ∈ X` a point at which `𝔪_{π y}` generates `𝔪_y`. If `∑ aᵢ cᵢ ∈ 𝔪_y`
for germs `aᵢ ∈ 𝒪_{X₀,π y}` and constants `cᵢ ∈ K` linearly independent over `k₀`, then every
`aᵢ ∈ 𝔪_{π y}`: the fibre through `y` is `Spec (κ(π y) ⊗_{k₀} K)`, a domain, on whose local ring
at `y` the sum becomes the image of `∑ āᵢ ⊗ cᵢ`. -/
private theorem mem_maximalIdeal_of_sum_mem {X₀ X : Scheme.{u}} {s₀ : X₀ ⟶ Spec (.of k₀)}
    {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀}
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) (y : X)
    (hm : Ideal.map (π.stalkMap y).hom (IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π y))) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk y))
    {ι : Type*} [Fintype ι] (a : ι → X₀.presheaf.stalk (π y)) (c : ι → K)
    (hc : LinearIndependent k₀ c)
    (hsum : ∑ i, (π.stalkMap y).hom (a i) *
        (X.presheaf.germ ⊤ y (by simp)).hom (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (c i)))
        ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y)) (i : ι) :
    a i ∈ IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π y)) := by
  let : Algebra k₀ (X₀.residueField (π y)) :=
    ((Scheme.ΓSpecIso (.of k₀)).inv ≫ s₀.appTop ≫ X₀.Γevaluation (π y)).hom.toAlgebra
  have hpaste : IsPullback (π.fiberToSpecResidueField (π y)) (π.fiberι (π y) ≫ s)
      (X₀.fromSpecResidueField (π y) ≫ s₀) (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))) :=
    (IsPullback.of_hasPullback π (X₀.fromSpecResidueField (π y))).flip.paste_vert h
  rw [← SpecMap_algebraMap_residueField s₀ (π y)] at hpaste
  let R : CommRingCat.{u} := .of (X₀.residueField (π y) ⊗[k₀] K)
  haveI : IsDomain R := isDomain_tensorProduct_of_isAlgClosed k₀ (X₀.residueField (π y)) K
  let e : π.fiber (π y) ≅ Spec R :=
    hpaste.isoPullback ≪≫ pullbackSpecIso k₀ (X₀.residueField (π y)) K
  let incL : X₀.residueField (π y) ⟶ R :=
    CommRingCat.ofHom (algebraMap (X₀.residueField (π y)) (X₀.residueField (π y) ⊗[k₀] K))
  let incR : CommRingCat.of K ⟶ R :=
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := k₀)
      (A := X₀.residueField (π y)) (B := K)).toRingHom
  have E1 : e.hom ≫ Spec.map incL = π.fiberToSpecResidueField (π y) := by
    simp only [e, incL, Iso.trans_hom, Category.assoc]
    exact (congrArg (hpaste.isoPullback.hom ≫ ·) (pullbackSpecIso_hom_fst' ..)).trans
      hpaste.isoPullback_hom_fst
  have E2 : e.hom ≫ Spec.map incR = π.fiberι (π y) ≫ s := by
    simp only [e, incR, Iso.trans_hom, Category.assoc]
    exact (congrArg (hpaste.isoPullback.hom ≫ ·) (pullbackSpecIso_hom_snd ..)).trans
      hpaste.isoPullback_hom_snd
  set θ' := Spec.preimage ((π.fiber (π y)).fromSpecStalk (π.asFiber y) ≫ e.hom)
  haveI : IsLocalHom (incL ≫ θ').hom :=
    IsLocalRing.instIsLocalHomRingHomOfNontrivial (K := X₀.residueField (π y)) _
  have F4 := stalkMap_comp_fiberι_stalkMap_eq y e incL E1
  have F5 := appTop_comp_fiberι_stalkMap_eq y e incR E2
  set Φ := (X.presheaf.stalkCongr (Inseparable.of_eq (π.fiberι_asFiber y).symm)).hom ≫
      (π.fiberι (π y)).stalkMap (π.asFiber y)
  have F4' (b : X₀.presheaf.stalk (π y)) : Φ.hom ((π.stalkMap y).hom b) =
      θ'.hom (incL.hom ((X₀.residue (π y)).hom b)) := by
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using congrArg (fun f => f.hom b) F4
  have F5' (l : K) : Φ.hom ((X.presheaf.germ ⊤ y (by simp)).hom
      (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom l))) = θ'.hom (incR.hom l) := by
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using congrArg (fun f => f.hom l) F5
  have hres (b : X₀.presheaf.stalk (π y)) :
      (X₀.residue (π y)).hom b = 0 ↔ b ∈ IsLocalRing.maximalIdeal _ :=
    IsLocalRing.residue_eq_zero_iff b
  -- `Φ` kills the maximal ideal
  have hker : IsLocalRing.maximalIdeal (X.presheaf.stalk y) ≤ RingHom.ker Φ.hom := by
    rw [← hm, Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap, RingHom.mem_ker, F4', (hres b).mpr hb, map_zero, map_zero]
  have h0 := hker hsum
  rw [RingHom.mem_ker, map_sum] at h0
  simp only [map_mul, F4', F5'] at h0
  have h1 : ∑ j, (X₀.residue (π y)).hom (a j) ⊗ₜ[k₀] c j = 0 := by
    apply injective_preimage_fromSpecStalk_comp e (π.asFiber y)
    rw [map_zero, ← h0, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← map_mul]
    congr 1
    change _ = (_ ⊗ₜ[k₀] 1) * (1 ⊗ₜ[k₀] c j)
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rfl
  exact (hres _).mp (tmul_sum_eq_zero _ c hc h1 i)

end Valuation

/-! ### Transforms of base-changed divisors -/

section MapPrimeDivisors

open Classical in
/-- The coefficient of `mapPrimeDivisors φ D` along `F` is the sum of the coefficients of `D`
along the prime divisors sent to `F`. -/
private theorem mapPrimeDivisors_apply {R : Type*} [AddCommMonoid R] {X Y : Scheme.{u}}
    (φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)) (D : DivisorWithCoeffs R X)
    (F : MMP.Mori.PrimeDivisor Y) :
    DivisorWithCoeffs.mapPrimeDivisors φ D F =
      ∑ P ∈ D.support, if φ P = some F then D P else 0 := by
  classical
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' hD hD' =>
    rw [map_add, Finsupp.add_apply, hD, hD']
    have key (E : DivisorWithCoeffs R X) (s : Finset (MMP.Mori.PrimeDivisor X))
        (hs : E.support ⊆ s) :
        (∑ P ∈ E.support, if φ P = some F then E P else 0) =
          ∑ P ∈ s, if φ P = some F then E P else 0 := by
      refine Finset.sum_subset hs fun P _ hP => ?_
      rw [Finsupp.notMem_support_iff.mp hP]; simp
    rw [key D (D.support ∪ D'.support ∪ (D + D').support) (by intro; simp_all),
      key D' (D.support ∪ D'.support ∪ (D + D').support) (by intro; simp_all),
      key (D + D') (D.support ∪ D'.support ∪ (D + D').support) (by intro; simp_all),
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun P _ => ?_
    split_ifs <;> simp
  | single P r =>
    rw [DivisorWithCoeffs.mapPrimeDivisors_single,
      Finset.sum_subset Finsupp.support_single_subset (fun x _ hx => by
        rw [Finsupp.notMem_support_iff.mp hx]; simp), Finset.sum_singleton,
      Finsupp.single_eq_same]
    rcases φ P with _ | E
    · simp
    · simp only [Option.elim_some, Option.some.injEq, Finsupp.single_apply]

/-- **Transforms of base-changed divisors.** If `φ` and `φ₀` correspond under base change (a
base change `P` of `P₀` is sent to `F` exactly when `P₀` is sent to some `F₀` of which `F` is the
base change), then `mapPrimeDivisors φ` carries base changes to base changes. -/
public theorem IsBaseChange.mapPrimeDivisors {R : Type*} [AddCommMonoid R]
    {X₀ X Y₀ Y : Scheme.{u}} {πX : X ⟶ X₀} {πY : Y ⟶ Y₀} [Surjective πX] [Surjective πY]
    (hexX : ∀ P₀ : MMP.Mori.PrimeDivisor X₀, ∃ P : MMP.Mori.PrimeDivisor X,
      closure {P.genericPoint} = πX.base ⁻¹' closure {P₀.genericPoint})
    {φ₀ : MMP.Mori.PrimeDivisor X₀ → Option (MMP.Mori.PrimeDivisor Y₀)}
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    (hφ : ∀ (P₀ : MMP.Mori.PrimeDivisor X₀) (P : MMP.Mori.PrimeDivisor X),
      closure {P.genericPoint} = πX.base ⁻¹' closure {P₀.genericPoint} →
      ∀ (F₀ : MMP.Mori.PrimeDivisor Y₀) (F : MMP.Mori.PrimeDivisor Y),
        closure {F.genericPoint} = πY.base ⁻¹' closure {F₀.genericPoint} →
        (φ P = some F ↔ φ₀ P₀ = some F₀))
    (hφsupp : ∀ (P₀ : MMP.Mori.PrimeDivisor X₀) (P : MMP.Mori.PrimeDivisor X),
      closure {P.genericPoint} = πX.base ⁻¹' closure {P₀.genericPoint} →
      ∀ F : MMP.Mori.PrimeDivisor Y, φ P = some F →
        ∃ F₀ : MMP.Mori.PrimeDivisor Y₀,
          closure {F.genericPoint} = πY.base ⁻¹' closure {F₀.genericPoint})
    {D₀ : DivisorWithCoeffs R X₀} {D : DivisorWithCoeffs R X} (hD : IsBaseChange πX D₀ D) :
    IsBaseChange πY (DivisorWithCoeffs.mapPrimeDivisors φ₀ D₀)
      (DivisorWithCoeffs.mapPrimeDivisors φ D) := by
  choose β hβ using hexX
  refine ⟨fun F₀ F hF => ?_, fun F hF => ?_⟩
  · rw [mapPrimeDivisors_apply, mapPrimeDivisors_apply]
    symm
    refine Finset.sum_bij (fun P₀ _ => β P₀) (fun P₀ hP₀ => ?_) (fun P₀ _ P₀' _ h => ?_)
      (fun P hP => ?_) (fun P₀ _ => ?_)
    · rw [Finsupp.mem_support_iff, hD.1 P₀ (β P₀) (hβ P₀)]
      exact Finsupp.mem_support_iff.mp hP₀
    · exact primeDivisor_eq_of_closure_eq (hβ P₀) (h ▸ hβ P₀')
    · obtain ⟨P₀, hP₀⟩ := hD.2 P (Finsupp.mem_support_iff.mp hP)
      refine ⟨P₀, ?_, primeDivisor_eq_of_closure_eq' (hβ P₀) hP₀⟩
      rw [Finsupp.mem_support_iff, ← hD.1 P₀ P hP₀]
      exact Finsupp.mem_support_iff.mp hP
    · rw [hD.1 P₀ (β P₀) (hβ P₀)]
      have e := hφ P₀ (β P₀) (hβ P₀) F₀ F hF
      by_cases h1 : φ₀ P₀ = some F₀
      · rw [ite_eq_left h1, ite_eq_left (e.mpr h1)]
      · rw [ite_eq_right h1, ite_eq_right (fun h2 => h1 (e.mp h2))]
  · rw [mapPrimeDivisors_apply] at hF
    obtain ⟨P, -, hP⟩ := Finset.exists_ne_zero_of_sum_ne_zero hF
    by_cases hPF : φ P = some F
    · obtain ⟨P₀, hP₀⟩ := hD.2 P (by simpa [hPF] using hP)
      exact hφsupp P₀ P hP₀ F hPF
    · simp [hPF] at hP

end MapPrimeDivisors

/-! ### Birational transforms of prime divisors under base change -/

section Transforms

open TopologicalSpace

/-- In a pullback square of closed maps, the closure of the image of a base-changed point is the
preimage of the closure of the image. -/
public theorem closure_singleton_map_eq {X₀ X Z₀ Z : Scheme.{u}} {π : X ⟶ X₀} {f : X ⟶ Z}
    {f₀ : X₀ ⟶ Z₀} {πZ : Z ⟶ Z₀} (hsq : IsPullback π f f₀ πZ) (hf : IsClosedMap f.base)
    (hf₀ : IsClosedMap f₀.base) {x : X₀} {w : X}
    (hw : closure {w} = π.base ⁻¹' closure {x}) :
    closure {f w} = πZ.base ⁻¹' closure {f₀ x} := by
  have h1 : closure {f w} = f.base '' closure {w} := by
    rw [← hf.closure_image_eq_of_continuous f.continuous, Set.image_singleton]
  have h2 : f₀.base '' closure {x} = closure {f₀ x} := by
    rw [← hf₀.closure_image_eq_of_continuous f₀.continuous, Set.image_singleton]
  rw [h1, hw, Scheme.image_preimage_eq_of_isPullback hsq, h2]

/-- Two points of coheight one, one specializing to the other, are equal. -/
public theorem eq_of_specializes_of_coheight_eq_one {Y : Scheme.{u}} {a b : Y} (h : a ⤳ b)
    (ha : Order.coheight a = 1) (hb : Order.coheight b = 1) : a = b := by
  by_contra hne
  have hle : b ≤ a := h
  have hlt : b < a := lt_of_le_not_ge hle fun h' => hne (h.antisymm h').eq
  have := Order.coheight_add_one_le hlt
  rw [ha, hb] at this
  exact absurd this (by norm_num)

/-- Over the biregular locus, specialization is reflected: if `g a ⤳ g b` with `g a, g b` in the
biregular locus of `g`, then `a ⤳ b`. -/
private theorem specializes_of_map_specializes {X Y : Scheme.{u}} (g : Y ⟶ X) {a b : Y}
    (ha : g a ∈ MMP.Mori.biregularLocus g) (hb : g b ∈ MMP.Mori.biregularLocus g)
    (h : g a ⤳ g b) : a ⤳ b := by
  set V := MMP.Mori.biregularLocus g
  haveI : IsIso (g ∣_ V) := MMP.Mori.isBiregular_biregularLocus g
  let e := Scheme.homeoOfIso (asIso (g ∣_ V))
  have he (c : Y) (hc : g c ∈ V) : e ⟨c, hc⟩ = ⟨g c, hc⟩ := Subtype.ext (by
    change ((g ∣_ V) ⟨c, hc⟩).1 = g c
    exact morphismRestrict_base_coe g V ⟨c, hc⟩)
  have h1 : (⟨g a, ha⟩ : V) ⤳ ⟨g b, hb⟩ := Topology.IsInducing.subtypeVal.specializes_iff.mp h
  rw [← he a ha, ← he b hb] at h1
  have h2 := h1.map e.symm.continuous
  have e1 : e.symm (e ⟨a, ha⟩) = ⟨a, ha⟩ := e.symm_apply_apply _
  have e2 : e.symm (e ⟨b, hb⟩) = ⟨b, hb⟩ := e.symm_apply_apply _
  rw [e1, e2] at h2
  exact h2.map continuous_subtype_val

/-- For a morphism `g`, the inverse transform of a prime divisor `E` is the prime divisor `F` whose
generic point maps to `η_E`, when `η_E` lies in the biregular locus. -/
public theorem inverseTransformPrimeDivisor_eq_some_iff' {X Y : Scheme.{u}} [IsReduced Y]
    (g : Y ⟶ X) (E : MMP.Mori.PrimeDivisor X) (F : MMP.Mori.PrimeDivisor Y) :
    MMP.Mori.inverseTransformPrimeDivisor g E = some F ↔
      E.genericPoint ∈ MMP.Mori.biregularLocus g ∧ g F.genericPoint = E.genericPoint := by
  set V := MMP.Mori.biregularLocus g
  haveI : IsIso (g ∣_ V) := MMP.Mori.isBiregular_biregularLocus g
  have hE : E.support = closure {E.genericPoint} :=
    AlgebraicGeometry.PrimeDivisor.support_eq_closure E
  -- the inverse transform of `E` is the closure of a point over `η_E`
  have key (w : Y) (hw : g w = E.genericPoint) (hV : E.genericPoint ∈ V) :
      ((MMP.Mori.inverseTransform g E.idealSheaf.support : Closeds Y) : Set Y) = closure {w} := by
    change closure (g.base ⁻¹' ((E.support : Set X) ∩ V)) = _
    refine le_antisymm (closure_minimal ?_ isClosed_closure) (closure_mono ?_)
    · rintro y ⟨hy1, hy2⟩
      have : E.genericPoint ⤳ g y := by
        rwa [specializes_iff_mem_closure, ← hE]
      rw [← hw] at this
      exact specializes_iff_mem_closure.mp
        (specializes_of_map_specializes g (hw ▸ hV) hy2 this)
    · rw [Set.singleton_subset_iff]
      refine ⟨?_, hw ▸ hV⟩
      rw [hw, hE]; exact subset_closure rfl
  constructor
  · intro h
    obtain ⟨⟨z, hzE, hzV⟩, -⟩ := MMP.Mori.inverseTransformPrimeDivisor_eq_some_iff.mp h
    have hV : E.genericPoint ∈ V := by
      have : E.genericPoint ⤳ z := by rwa [specializes_iff_mem_closure, ← hE]
      exact this.mem_open V.isOpen hzV
    obtain ⟨⟨w, hwV⟩, hw⟩ := (Scheme.homeoOfIso (asIso (g ∣_ V))).surjective ⟨E.genericPoint, hV⟩
    have hw' : g w = E.genericPoint := by
      have := congrArg Subtype.val hw
      change ((g ∣_ V) ⟨w, hwV⟩).1 = _ at this
      exact (morphismRestrict_base_coe g V ⟨w, hwV⟩).symm.trans this
    refine ⟨hV, ?_⟩
    have h1 := MMP.Mori.support_inverseTransformPrimeDivisor h
    have h2 : closure {F.genericPoint} = closure {w} := by
      rw [← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact h1.trans (key w hw' hV)
    rw [(inseparable_iff_closure_eq.mpr h2).eq, hw']
  · rintro ⟨hV, hF⟩
    refine MMP.Mori.inverseTransformPrimeDivisor_eq_some_iff.mpr ⟨⟨E.genericPoint, ?_, hV⟩, ?_⟩
    · rw [hE]; exact subset_closure rfl
    · have h1 : MMP.Mori.inverseTransform g E.idealSheaf.support = F.idealSheaf.support := by
        apply SetLike.coe_injective
        rw [key F.genericPoint hF hV]
        exact (AlgebraicGeometry.PrimeDivisor.support_eq_closure F).symm
      have := F.integral
      rw [MMP.Mori.inverseTransformIdeal, h1, MMP.Positivity.vanishingIdeal_support_of_isReduced]

end Transforms

section ValuationBaseChange

/-- `fieldMap` on the images of the local rings along prime divisors over each other. -/
private theorem fieldMap_toComponent_eq {X₀ X : Scheme.{u}} [IsIntegral X₀] [IsIntegral X]
    {π : X ⟶ X₀} [IsDominant π] {P₀ : MMP.Mori.PrimeDivisor X₀} {P : MMP.Mori.PrimeDivisor X}
    (hπ : π P.genericPoint = P₀.genericPoint) (b : P₀.localRing) :
    MMP.Fourfold.fieldMap π P₀.component P.component (P₀.toComponent.hom b) =
      P.toComponent.hom ((π.stalkMap P.genericPoint).hom
        ((X₀.presheaf.stalkCongr (Inseparable.of_eq hπ)).inv.hom b)) := by
  have hcomm' : P₀.toComponent ≫ (X₀.presheaf.stalkSpecializes (specializes_of_eq
      (MMP.Fourfold.map_componentGenericPoint π P.component P₀.component)) ≫
        π.stalkMap (componentGenericPoint X P.component)) =
      (X₀.presheaf.stalkCongr (Inseparable.of_eq hπ)).inv ≫ π.stalkMap P.genericPoint ≫
        P.toComponent := by
    refine TopCat.Presheaf.stalk_hom_ext _ fun V hV => ?_
    simp only [MMP.Mori.PrimeDivisor.toComponent, stalkToRationalFunctions,
      TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap,
      TopCat.Presheaf.stalkCongr_inv]
    erw [TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc]
    erw [TopCat.Presheaf.germ_stalkSpecializes]
  exact congrArg (fun φ => φ.hom b) hcomm'

omit [IsAlgClosed K] in
/-- **Valuations along base-changed prime divisors.** If `P` is the base change of `P₀`, then the
order of vanishing along `P` of the pull-back of a rational function is its order along `P₀`. -/
public theorem valuation_fieldMap_of_closure_eq {X₀ X : Scheme.{u}} [IsIntegral X₀]
    [IsIntegral X] [IsNormal X₀] [IsNormal X] [IsLocallyNoetherian X₀] [IsLocallyNoetherian X]
    {s₀ : X₀ ⟶ Spec (.of k₀)}
    {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀} [LocallyOfFiniteType s₀]
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    {P₀ : MMP.Mori.PrimeDivisor X₀} {P : MMP.Mori.PrimeDivisor X}
    (hP : closure {P.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint}) [IsDominant π]
    (a : X₀.presheaf.stalk (componentGenericPoint X₀ P₀.component)) :
    P.valuation (MMP.Fourfold.fieldMap π P₀.component P.component a) = P₀.valuation a := by
  have : Surjective π := surjective_of_isPullback h
  have hπ : π P.genericPoint = P₀.genericPoint := map_eq_of_closure_eq hP
  -- the local homomorphism `𝒪_{X₀,P₀} ⟶ 𝒪_{X,P}`
  let e := X₀.presheaf.stalkCongr (Inseparable.of_eq hπ)
  let ψ : P₀.localRing →+* P.localRing :=
    (π.stalkMap P.genericPoint).hom.comp (e.symm.commRingCatIsoToRingEquiv : _ →+* _)
  have hcomm (b : P₀.localRing) : MMP.Fourfold.fieldMap π P₀.component P.component
      (P₀.toComponent.hom b) = P.toComponent.hom (ψ b) :=
    fieldMap_toComponent_eq hπ b
  -- `ψ` carries the maximal ideal onto the maximal ideal
  have hP1 : Order.coheight P.genericPoint = 1 := MMP.Mori.PrimeDivisor.coheight_genericPoint P
  have hP₀1 : Order.coheight (π P.genericPoint) = 1 := by
    rw [hπ]; exact MMP.Mori.PrimeDivisor.coheight_genericPoint P₀
  have hmax : Ideal.map ψ (IsLocalRing.maximalIdeal P₀.localRing) =
      IsLocalRing.maximalIdeal P.localRing := by
    have h1 : Ideal.map (e.symm.commRingCatIsoToRingEquiv : P₀.localRing →+* _)
        (IsLocalRing.maximalIdeal P₀.localRing) =
        IsLocalRing.maximalIdeal (X₀.presheaf.stalk (π P.genericPoint)) :=
      IsLocalRing.map_ringEquiv_maximalIdeal _
    rw [← Ideal.map_map, h1]
    exact map_maximalIdeal_stalkMap_eq h P.genericPoint hP1 hP₀1
  -- the computation on the discrete valuation rings
  haveI := P₀.isDiscreteValuationRing_localRing
  haveI := P.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P₀.localRing
  have hψϖ : Irreducible (ψ ϖ) := by
    rw [IsDiscreteValuationRing.irreducible_iff_uniformizer, ← hmax,
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ, Ideal.map_span,
      Set.image_singleton]
  have hloc (b : P₀.localRing) : P.valuation (P.toComponent.hom (ψ b)) =
      P₀.valuation (P₀.toComponent.hom b) := by
    by_cases hb : b = 0
    · subst hb; simp
    obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb hϖ
    simp only [map_mul, map_pow]
    rw [P₀.valuation_toComponent_of_isUnit u.isUnit, P₀.valuation_toComponent_of_irreducible hϖ,
      P.valuation_toComponent_of_isUnit (u.isUnit.map ψ),
      P.valuation_toComponent_of_irreducible hψϖ]
  -- fractions
  let := P₀.toComponent.hom.toAlgebra
  have hfr := isFractionRing_stalkToRationalFunctions (X := X₀) P₀.genericPoint_mem_component
  obtain ⟨⟨b, c⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors P₀.localRing) a
  have hc : (c : P₀.localRing) ≠ 0 := nonZeroDivisors.ne_zero c.2
  have e1 : IsLocalization.mk' (X₀.presheaf.stalk (componentGenericPoint X₀ P₀.component)) b c *
      P₀.toComponent.hom c = P₀.toComponent.hom b := IsLocalization.mk'_spec _ b c
  have hvc : P₀.valuation (P₀.toComponent.hom (c : P₀.localRing)) ≠ 0 := by
    obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc hϖ
    rw [hu, map_mul, map_pow, map_mul, map_pow, P₀.valuation_toComponent_of_isUnit u.isUnit,
      P₀.valuation_toComponent_of_irreducible hϖ]
    simp
  have e2 := congrArg P₀.valuation e1
  have e3 := congrArg (fun z => P.valuation (MMP.Fourfold.fieldMap π P₀.component P.component z)) e1
  simp only [map_mul, hcomm, hloc] at e2 e3
  rw [← e2] at e3
  exact mul_right_cancel₀ hvc e3

/-- At a prime divisor lying over the generic point of `X₀`, pulled-back units have order zero. -/
public theorem valuation_fieldMap_eq_one {X₀ X : Scheme.{u}} [IsIntegral X₀] [IsIntegral X]
    [IsNormal X] [IsLocallyNoetherian X] {π : X ⟶ X₀} [IsDominant π]
    {P : MMP.Mori.PrimeDivisor X} (hP : π P.genericPoint = genericPoint X₀)
    (Z₀ : irreducibleComponents X₀) {a : X₀.presheaf.stalk (componentGenericPoint X₀ Z₀)}
    (ha : IsUnit a) :
    P.valuation (MMP.Fourfold.fieldMap π Z₀ P.component a) = 1 := by
  have h' : π P.genericPoint = componentGenericPoint X₀ Z₀ := by
    rw [hP, MMP.Fourfold.componentGenericPoint_eq_genericPoint]
  have hcomm : (X₀.presheaf.stalkSpecializes (specializes_of_eq
      (MMP.Fourfold.map_componentGenericPoint π P.component Z₀)) ≫
        π.stalkMap (componentGenericPoint X P.component)) =
      (X₀.presheaf.stalkSpecializes (specializes_of_eq h') ≫ π.stalkMap P.genericPoint) ≫
        P.toComponent := by
    refine TopCat.Presheaf.stalk_hom_ext _ fun V hV => ?_
    simp only [MMP.Mori.PrimeDivisor.toComponent, stalkToRationalFunctions,
      TopCat.Presheaf.germ_stalkSpecializes_assoc, Scheme.Hom.germ_stalkMap_assoc,
      Category.assoc, Scheme.Hom.germ_stalkMap]
    erw [TopCat.Presheaf.germ_stalkSpecializes]
  have e : MMP.Fourfold.fieldMap π Z₀ P.component a = P.toComponent.hom
      ((X₀.presheaf.stalkSpecializes (specializes_of_eq h') ≫ π.stalkMap P.genericPoint).hom a) :=
    congrArg (fun φ => φ.hom a) hcomm
  rw [e]
  exact P.valuation_toComponent_of_isUnit (ha.map _)

attribute [local instance] MMP.Resolution.componentField

/-- A nonunit of `𝒪_{X,E}` has positive order along `E`. -/
private theorem valuation_toComponent_ne_one_of_mem {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (E : MMP.Mori.PrimeDivisor X) {β : E.localRing}
    (hβ : β ∈ IsLocalRing.maximalIdeal E.localRing) :
    E.valuation (E.toComponent.hom β) ≠ 1 := by
  haveI := E.isDiscreteValuationRing_localRing
  by_cases h0 : β = 0
  · subst h0; simp
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ,
    Ideal.mem_span_singleton'] at hβ
  obtain ⟨γ, rfl⟩ := hβ
  have hγ : γ ≠ 0 := by rintro rfl; exact h0 (zero_mul _)
  rw [map_mul, map_mul, E.valuation_toComponent_of_irreducible hϖ]
  intro h1
  have h2 := E.one_le_valuation_toComponent hγ
  have h3 : WithZero.exp (1 : ℤ) ≤ 1 := h1 ▸ le_mul_of_one_le_left' h2
  exact absurd h3 (by rw [← WithZero.exp_zero, WithZero.exp_le_exp]; norm_num)

omit [IsAlgClosed K] in
/-- **Gauss lemma for orders of vanishing.** Along a prime divisor `P` of the base change which is
the base change of `P₀`, if `∑ aᵢ cᵢ` (with `aᵢ ∈ K(X₀)` and constants `cᵢ ∈ K` linearly
independent over `k₀`) has order at least `n`, so does every `aᵢ`. -/
public theorem ordGE_of_ordGE_sum {X₀ X : Scheme.{u}} [IsIntegral X₀]
    [IsIntegral X] [IsNormal X₀] [IsNormal X] [IsLocallyNoetherian X₀] [IsLocallyNoetherian X]
    {s₀ : X₀ ⟶ Spec (.of k₀)} {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀} [LocallyOfFiniteType s₀]
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    {P₀ : MMP.Mori.PrimeDivisor X₀} {P : MMP.Mori.PrimeDivisor X}
    (hP : closure {P.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint}) [IsDominant π]
    {ι : Type*} [Fintype ι] (a : ι → X₀.presheaf.stalk (componentGenericPoint X₀ P₀.component))
    (c : ι → K) (hc : LinearIndependent k₀ c) (n : ℤ)
    (hsum : P.OrdGE n (∑ j, MMP.Fourfold.fieldMap π P₀.component P.component (a j) *
      (X.presheaf.germ ⊤ (componentGenericPoint X P.component) (by simp)).hom
        (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (c j))))) (i : ι) :
    P₀.OrdGE n (a i) := by
  classical
  have : Surjective π := surjective_of_isPullback h
  have hπ : π P.genericPoint = P₀.genericPoint := map_eq_of_closure_eq hP
  by_contra hne
  have hai : a i ≠ 0 := fun h0 => hne (Or.inl h0)
  let S := Finset.univ.filter fun j => a j ≠ 0
  obtain ⟨i₀, hi₀S, hmin⟩ := S.exists_min_image (fun j => P₀.valuation (a j))
    ⟨i, by simp [S, hai]⟩
  have ha₀ : a i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
  have hlt : P₀.valuation (a i₀) < WithZero.exp n := by
    have h1 : ¬ WithZero.exp n ≤ P₀.valuation (a i) := fun h' => hne (Or.inr h')
    exact (hmin i (by simp [S, hai])).trans_lt (lt_of_not_ge h1)
  have hv₀ : P₀.valuation (a i₀) ≠ 0 := (map_ne_zero _).mpr ha₀
  -- the normalized coefficients lie in `𝒪_{X₀,P₀}`
  have hb (j : ι) : ∃ β : P₀.localRing, P₀.toComponent.hom β = a j / a i₀ := by
    by_cases hj : a j = 0
    · exact ⟨0, by rw [map_zero, hj, zero_div]⟩
    refine P₀.exists_toComponent_eq_of_one_le_valuation ?_
    rw [map_div₀, one_le_div₀ (zero_lt_iff.mpr hv₀)]
    exact hmin j (by simp [S, hj])
  choose β hβ using hb
  have hfa₀ : MMP.Fourfold.fieldMap π P₀.component P.component (a i₀) ≠ 0 :=
    (map_ne_zero _).mpr ha₀
  set cst : ι → X.presheaf.stalk (componentGenericPoint X P.component) := fun j =>
    (X.presheaf.germ ⊤ (componentGenericPoint X P.component) (by simp)).hom
      (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (c j))) with hcst
  set S' := ∑ j, MMP.Fourfold.fieldMap π P₀.component P.component (a j / a i₀) * cst j
  have hS : (∑ j, MMP.Fourfold.fieldMap π P₀.component P.component (a j) * cst j) =
      MMP.Fourfold.fieldMap π P₀.component P.component (a i₀) * S' := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← mul_assoc, map_div₀, mul_div_cancel₀ _ hfa₀]
  -- the sum `S'` in the local ring `𝒪_{X,P}`
  set e := X₀.presheaf.stalkCongr (Inseparable.of_eq hπ)
  let a' : ι → X₀.presheaf.stalk (π P.genericPoint) := fun j => e.inv.hom (β j)
  set T := ∑ j, (π.stalkMap P.genericPoint).hom (a' j) *
    (X.presheaf.germ ⊤ P.genericPoint (by simp)).hom
      (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (c j)))
  have hT : P.toComponent.hom T = S' := by
    simp only [T, S', map_sum, map_mul]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← hβ j, fieldMap_toComponent_eq hπ]
    congr 1
    simp only [hcst, MMP.Mori.PrimeDivisor.toComponent, stalkToRationalFunctions]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  have hTm : T ∈ IsLocalRing.maximalIdeal P.localRing := by
    by_contra hu
    have hv1 : P.valuation S' = 1 := by
      rw [← hT]
      exact P.valuation_toComponent_of_isUnit (IsLocalRing.notMem_maximalIdeal.mp hu)
    rcases hsum with h0 | hge
    · rw [hS] at h0
      have : S' = 0 := (mul_eq_zero.mp h0).resolve_left hfa₀
      rw [this, map_zero] at hv1
      exact zero_ne_one hv1
    · rw [hS, map_mul, hv1, mul_one, valuation_fieldMap_of_closure_eq h hP] at hge
      exact absurd hge (not_le.mpr hlt)
  have hP1 : Order.coheight P.genericPoint = 1 := MMP.Mori.PrimeDivisor.coheight_genericPoint P
  have hP₀1 : Order.coheight (π P.genericPoint) = 1 := by
    rw [hπ]; exact MMP.Mori.PrimeDivisor.coheight_genericPoint P₀
  have hm := map_maximalIdeal_stalkMap_eq h P.genericPoint hP1 hP₀1
  have hmem := mem_maximalIdeal_of_sum_mem h P.genericPoint hm a' c hc hTm i₀
  have hβ₀ : β i₀ ∈ IsLocalRing.maximalIdeal P₀.localRing := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmem ⊢
    intro hu
    exact hmem (hu.map e.inv.hom)
  apply valuation_toComponent_ne_one_of_mem P₀ hβ₀
  rw [hβ i₀, div_self ha₀, map_one]

end ValuationBaseChange

/-! ### Cartier descent -/

section Germs

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- The germ at the generic point of a section is the image of its germ along `E`. -/
private theorem germ_eq_toComponent {U : X.Opens} (r : Γ(X, U)) (E : MMP.Mori.PrimeDivisor X)
    (hE : E.genericPoint ∈ U) :
    (X.presheaf.germ U (componentGenericPoint X E.component)
      (E.specializes_genericPoint.mem_open U.isOpen hE)).hom r =
      E.toComponent.hom ((X.presheaf.germ U E.genericPoint hE).hom r) :=
  (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf _ _ _).symm

omit [IsIntegral X] [CompactSpace X] in
/-- Regular functions have nonnegative order. -/
public theorem ordGE_zero_germ {U : X.Opens} (r : Γ(X, U)) (E : MMP.Mori.PrimeDivisor X)
    (hE : E.genericPoint ∈ U) :
    E.OrdGE 0 ((X.presheaf.germ U (componentGenericPoint X E.component)
      (E.specializes_genericPoint.mem_open U.isOpen hE)).hom r) := by
  rw [germ_eq_toComponent r E hE]
  by_cases h0 : (X.presheaf.germ U E.genericPoint hE).hom r = 0
  · rw [h0, map_zero]; exact PrimeDivisor.OrdGE.zero _
  · exact Or.inr (by rw [WithZero.exp_zero]; exact E.one_le_valuation_toComponent h0)

omit [IsIntegral X] [CompactSpace X] in
/-- A regular function vanishing at the generic point of `E` has order at least one along `E`. -/
private theorem ordGE_one_germ {U : X.Opens} (r : Γ(X, U)) (E : MMP.Mori.PrimeDivisor X)
    (hE : E.genericPoint ∈ U) (hr : E.genericPoint ∉ X.basicOpen r) :
    E.OrdGE 1 ((X.presheaf.germ U (componentGenericPoint X E.component)
      (E.specializes_genericPoint.mem_open U.isOpen hE)).hom r) := by
  rw [germ_eq_toComponent r E hE]
  refine E.ordGE_one_toComponent ?_
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  exact fun hu => hr ((Scheme.mem_basicOpen X r E.genericPoint hE).mpr hu)

omit [IsIntegral X] [CompactSpace X] in
/-- A regular function invertible at the generic point of `E` has order zero along `E`. -/
public theorem valuation_germ_eq_one {U : X.Opens} (r : Γ(X, U)) (E : MMP.Mori.PrimeDivisor X)
    (hE : E.genericPoint ∈ U) (hr : E.genericPoint ∈ X.basicOpen r) :
    E.valuation ((X.presheaf.germ U (componentGenericPoint X E.component)
      (E.specializes_genericPoint.mem_open U.isOpen hE)).hom r) = 1 := by
  rw [germ_eq_toComponent r E hE]
  exact E.valuation_toComponent_of_isUnit ((Scheme.mem_basicOpen X r E.genericPoint hE).mp hr)

end Germs

section Vanishing

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

omit [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- On an affine open `U`, for finitely many prime divisors meeting `U` there is a regular function
on `U`, invertible at the generic point, vanishing at all of their generic points. -/
private theorem exists_section_vanishing {U : X.Opens} (hU : IsAffineOpen U) [Nonempty U]
    (F : Finset (MMP.Mori.PrimeDivisor X)) :
    ∃ t : Γ(X, U), genericPoint X ∈ X.basicOpen t ∧ ∀ E ∈ F, E.genericPoint ∉ X.basicOpen t := by
  classical
  let C : Set X := ⋃ E ∈ F, closure {E.genericPoint}
  have hC : IsClosed C := Set.Finite.isClosed_biUnion F.finite_toSet fun _ _ => isClosed_closure
  have hgen : genericPoint X ∈ U := by
    obtain ⟨x⟩ := ‹Nonempty U›
    exact (genericPoint_spec X).specializes trivial |>.mem_open U.isOpen x.2
  have hgC : genericPoint X ∉ C := by
    simp only [C, Set.mem_iUnion, not_exists]
    intro E _ hE
    have h4 := MMP.Mori.PrimeDivisor.coheight_genericPoint E
    rw [((specializes_iff_mem_closure.mpr hE).antisymm
      ((genericPoint_spec X).specializes trivial)).eq,
      Stacks.EtaleCohomology.coheight_genericPoint_eq_zero] at h4
    exact zero_ne_one h4
  let V : X.Opens := U ⊓ ⟨Cᶜ, hC.isOpen_compl⟩
  obtain ⟨t, htV, hgt⟩ := hU.exists_basicOpen_le (V := V) ⟨genericPoint X, hgen, hgC⟩ hgen
  refine ⟨t, hgt, fun E hE hEt => ?_⟩
  exact (htV hEt).2 (Set.mem_biUnion hE (subset_closure rfl))

end Vanishing

section Bounds

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

omit [IsIntegral X] [CompactSpace X] in
/-- The order of a unit of `K(X)` along `E`. -/
public theorem ordGE_component (E : MMP.Mori.PrimeDivisor X) (φ : (RationalFunctions X)ˣ) :
    E.OrdGE (E.ord φ) ((φ : RationalFunctions X) E.component) :=
  Or.inr (le_of_eq (E.valuation_component φ).symm)

omit [CompactSpace X] in
/-- **A common denominator.** On a nonempty affine open `U₀` there is a regular function,
invertible at the generic point, with order at least `|D_E|` along every prime divisor `E`
meeting `U₀`. -/
public theorem exists_section_ordGE_natAbs {U : X.Opens} (hU : IsAffineOpen U) [Nonempty U]
    (D : Divisor X) :
    ∃ c : Γ(X, U), genericPoint X ∈ X.basicOpen c ∧ ∀ (E : MMP.Mori.PrimeDivisor X)
      (hE : E.genericPoint ∈ U), E.OrdGE ((D.coeff E).natAbs : ℤ)
        ((X.presheaf.germ U (componentGenericPoint X E.component)
          (E.specializes_genericPoint.mem_open U.isOpen hE)).hom c) := by
  classical
  obtain ⟨t, hgt, ht⟩ := exists_section_vanishing hU D.support
  let M : ℕ := ∑ E ∈ D.support, (D.coeff E).natAbs
  refine ⟨t ^ M, ?_, fun E hE => ?_⟩
  · have hgU : genericPoint X ∈ U := X.basicOpen_le t hgt
    rw [Scheme.mem_basicOpen X _ _ hgU, map_pow]
    exact ((Scheme.mem_basicOpen X t _ hgU).mp hgt).pow M
  rw [map_pow]
  by_cases hEs : E ∈ D.support
  · have h1 := (ordGE_one_germ t E hE (ht E hEs)).pow M
    rw [mul_one] at h1
    refine h1.mono ?_
    exact_mod_cast Finset.single_le_sum (f := fun E => (D.coeff E).natAbs)
      (fun _ _ => Nat.zero_le _) hEs
  · have h0 : D.coeff E = 0 := Finsupp.notMem_support_iff.mp hEs
    rw [h0]
    have h1 := (ordGE_zero_germ t E hE).pow M
    rwa [mul_zero] at h1

omit [IsIntegral X] in
/-- **Clearing the poles of a local equation.** If `φ` is a local equation of `D` on `V` and
`D(s) ⊆ V` for a regular function `s` on `U`, then for large `N` the functions `s^N φ^{∓1}` are
sections of `𝒪_X(±D)` on `U`. -/
public theorem exists_pow_ordGE {D : Divisor X} {V : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : D.IsLocalEquation V φ) {U : X.Opens} (s : Γ(X, U)) (hsV : X.basicOpen s ≤ V) :
    ∃ N : ℕ, ∀ (E : MMP.Mori.PrimeDivisor X) (hE : E.genericPoint ∈ U),
      E.OrdGE (-D.coeff E) (((X.presheaf.germ U (componentGenericPoint X E.component)
          (E.specializes_genericPoint.mem_open U.isOpen hE)).hom s) ^ N *
            ((φ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) E.component) ∧
      E.OrdGE (D.coeff E) (((X.presheaf.germ U (componentGenericPoint X E.component)
          (E.specializes_genericPoint.mem_open U.isOpen hE)).hom s) ^ N *
            (φ : RationalFunctions X) E.component) := by
  classical
  let F : Finset (MMP.Mori.PrimeDivisor X) := (finite_ord_ne_zero φ).toFinset ∪ D.support
  let N : ℕ := ∑ E ∈ F, ((E.ord φ).natAbs + (D.coeff E).natAbs)
  refine ⟨N, fun E hE => ?_⟩
  have hinv := ordGE_component E φ⁻¹
  rw [PrimeDivisor.ord_inv] at hinv
  have hφE := ordGE_component E φ
  by_cases hEs : E.genericPoint ∈ X.basicOpen s
  · have hEV : (E.support ∩ V).Nonempty := ⟨E.genericPoint, by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl, hsV hEs⟩
    have hDE := hφ E hEV
    have h0 := (ordGE_zero_germ s E hE).pow N
    rw [mul_zero] at h0
    refine ⟨?_, ?_⟩
    · have := h0.mul hinv
      rwa [zero_add, ← hDE] at this
    · have := h0.mul hφE
      rwa [zero_add, ← hDE] at this
  · have h1 := (ordGE_one_germ s E hE hEs).pow N
    rw [mul_one] at h1
    have hbound : |E.ord φ| + |D.coeff E| ≤ (N : ℤ) := by
      by_cases hEF : E ∈ F
      · have := Finset.single_le_sum (f := fun E => ((E.ord φ).natAbs + (D.coeff E).natAbs))
          (fun _ _ => Nat.zero_le _) hEF
        have h' : ((E.ord φ).natAbs + (D.coeff E).natAbs : ℤ) ≤ (N : ℤ) := by exact_mod_cast this
        simpa [Int.natCast_natAbs] using h'
      · have hF : E.ord φ = 0 ∧ D.coeff E = 0 := by
          simp only [F, Finset.mem_union, Set.Finite.mem_toFinset, Set.mem_ofPred_eq,
            Finsupp.mem_support_iff, not_or, not_not] at hEF
          exact hEF
        rw [hF.1, hF.2]; simp
    refine ⟨(h1.mul hinv).mono ?_, (h1.mul hφE).mono ?_⟩
    · have := neg_abs_le (D.coeff E)
      have := le_abs_self (E.ord φ)
      linarith [abs_nonneg (D.coeff E), abs_nonneg (E.ord φ)]
    · have := neg_abs_le (E.ord φ)
      have := le_abs_self (D.coeff E)
      linarith [abs_nonneg (D.coeff E), abs_nonneg (E.ord φ)]

end Bounds

section Decomposition

variable {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K] [IsAlgClosed k₀] [IsAlgClosed K]
variable {X₀ X : Scheme.{u}} [IsIntegral X₀] [IsIntegral X] [IsNormal X₀] [IsNormal X]
  [IsLocallyNoetherian X₀] [IsLocallyNoetherian X]
  {s₀ : X₀ ⟶ Spec (.of k₀)} {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀}

omit [IsAlgClosed k₀] [IsAlgClosed K] in
/-- **Sections over a base-changed affine open.** For `U₀ ⊆ X₀` affine, every regular function on
`π⁻¹U₀` is a finite sum `∑ π^*(a_β) · b_β` along a `k₀`-basis `(b_β)` of `K`: the square of
section rings is a pushout, so the images of a basis of `K` form a `Γ(X₀, U₀)`-basis. -/
public theorem exists_sum_basis_of_isPullback {X₀ X : Scheme.{u}} {s₀ : X₀ ⟶ Spec (.of k₀)}
    {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀}
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))) {U₀ : X₀.Opens}
    (hU₀ : IsAffineOpen U₀) (r : Γ(X, π ⁻¹ᵁ U₀)) :
    ∃ (t : Finset (Module.Basis.ofVectorSpaceIndex k₀ K))
      (a : Module.Basis.ofVectorSpaceIndex k₀ K → Γ(X₀, U₀)),
      r = ∑ β ∈ t, (π.app U₀).hom (a β) *
        (s.appLE ⊤ (π ⁻¹ᵁ U₀) (by simp)).hom ((Scheme.ΓSpecIso (.of K)).inv.hom
          (Module.Basis.ofVectorSpace k₀ K β)) := by
  have hUY : π ⁻¹ᵁ U₀ = π ⁻¹ᵁ U₀ ⊓ s ⁻¹ᵁ ⊤ := by simp
  have hiso := isIso_pushoutSection_of_isAffineOpen h (US := ⊤) (UT := ⊤) (UX := U₀)
    (by simp) (by simp) hUY (isAffineOpen_top _) (isAffineOpen_top _) hU₀
  have hpush := (isIso_pushoutSection_iff ..).mp hiso
  -- replace the sections of `Spec k₀` and `Spec K` by `k₀` and `K`
  let fA : CommRingCat.of k₀ ⟶ Γ(X₀, U₀) := (Scheme.ΓSpecIso (.of k₀)).inv ≫ s₀.appLE ⊤ U₀ (by simp)
  let fB : CommRingCat.of K ⟶ Γ(X, π ⁻¹ᵁ U₀) :=
    (Scheme.ΓSpecIso (.of K)).inv ≫ s.appLE ⊤ (π ⁻¹ᵁ U₀) (by simp)
  have hpush' : IsPushout fA (CommRingCat.ofHom (algebraMap k₀ K)) (π.app U₀) fB := by
    refine IsPushout.of_iso hpush (Scheme.ΓSpecIso (.of k₀)) (Iso.refl _) (Scheme.ΓSpecIso (.of K))
      (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [fA]
    · rw [← cancel_epi (Scheme.ΓSpecIso (.of k₀)).inv]
      have e1 : (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))).appLE ⊤ ⊤ (by simp) =
          (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))).appTop := by
        rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]; rfl
      rw [e1, Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
    · simp [Scheme.Hom.app_eq_appLE]
    · simp [fB]
  letI : Algebra k₀ Γ(X₀, U₀) := fA.hom.toAlgebra
  letI : Algebra K Γ(X, π ⁻¹ᵁ U₀) := fB.hom.toAlgebra
  letI : Algebra Γ(X₀, U₀) Γ(X, π ⁻¹ᵁ U₀) := (π.app U₀).hom.toAlgebra
  letI : Algebra k₀ Γ(X, π ⁻¹ᵁ U₀) := (fA ≫ π.app U₀).hom.toAlgebra
  haveI : IsScalarTower k₀ K Γ(X, π ⁻¹ᵁ U₀) := IsScalarTower.of_algebraMap_eq fun x => by
    have := congrArg (fun f => f.hom x) hpush'.w
    exact this
  haveI : IsScalarTower k₀ Γ(X₀, U₀) Γ(X, π ⁻¹ᵁ U₀) := IsScalarTower.of_algebraMap_eq fun x => rfl
  have hAP : Algebra.IsPushout k₀ K Γ(X₀, U₀) Γ(X, π ⁻¹ᵁ U₀) :=
    (CommRingCat.isPushout_iff_isPushout).mp hpush'.flip
  have hbc := hAP.symm.out
  let b := Module.Basis.ofVectorSpace k₀ K
  let B := hbc.basis b
  refine ⟨(B.repr r).support, fun β => B.repr r β, ?_⟩
  conv_lhs => rw [← B.linearCombination_repr r]
  rw [Finsupp.linearCombination_apply, Finsupp.sum]
  refine Finset.sum_congr rfl fun β _ => ?_
  rw [IsBaseChange.basis_apply, Algebra.smul_def]
  rfl

omit [IsAlgClosed K] [IsIntegral X] [IsNormal X] [IsLocallyNoetherian X] in
/-- Germs of constants. -/
public theorem germ_appLE_top {U : X.Opens} {x : X} (hx : x ∈ U) (a : Γ(Spec (.of K), ⊤)) :
    (X.presheaf.germ U x hx).hom ((s.appLE ⊤ U (by simp)).hom a) =
      (X.presheaf.germ ⊤ x (by simp)).hom (s.appTop.hom a) := by
  have e : s.appLE ⊤ U (by simp) ≫ X.presheaf.germ U x hx =
      s.appTop ≫ X.presheaf.germ ⊤ x (by simp) := by
    simp only [Scheme.Hom.appLE, Category.assoc, X.presheaf.germ_res, Scheme.Hom.appTop]
    rfl
  exact congrArg (fun f => f.hom a) e

end Decomposition

section CartierDescent

variable {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K] [IsAlgClosed k₀] [IsAlgClosed K]

attribute [local instance] MMP.Resolution.componentField

variable {X₀ X : Scheme.{u}} [IsIntegral X₀] [IsIntegral X] [IsNormal X₀] [IsNormal X]
  [IsLocallyNoetherian X₀] [IsLocallyNoetherian X] [CompactSpace X₀] [CompactSpace X]
  {s₀ : X₀ ⟶ Spec (.of k₀)} {s : X ⟶ Spec (.of K)} {π : X ⟶ X₀}

omit [CompactSpace X₀] [CompactSpace X] [IsAlgClosed K] in
/-- Orders along `P₀` are orders along its base change `P`. -/
public theorem ordGE_fieldMap [LocallyOfFiniteType s₀] [IsDominant π]
    (h : IsPullback π s s₀ (Spec.map (CommRingCat.ofHom (algebraMap k₀ K))))
    {P₀ : MMP.Mori.PrimeDivisor X₀} {P : MMP.Mori.PrimeDivisor X}
    (hP : closure {P.genericPoint} = π.base ⁻¹' closure {P₀.genericPoint}) {n : ℤ}
    {a : X₀.presheaf.stalk (componentGenericPoint X₀ P₀.component)} (ha : P₀.OrdGE n a) :
    P.OrdGE n (MMP.Fourfold.fieldMap π P₀.component P.component a) := by
  rcases ha with rfl | ha
  · rw [map_zero]; exact PrimeDivisor.OrdGE.zero _
  · exact Or.inr (by rwa [valuation_fieldMap_of_closure_eq h hP])

omit [IsIntegral X] [CompactSpace X] in
/-- Multiplying by a function of known order. -/
public theorem ordGE_mul_of_valuation_eq {E : MMP.Mori.PrimeDivisor X} {n m : ℤ}
    {f g : X.presheaf.stalk (componentGenericPoint X E.component)} (hf : E.OrdGE n f)
    (hg : E.valuation g = WithZero.exp m) : E.OrdGE (m + n) (g * f) :=
  PrimeDivisor.OrdGE.mul (Or.inr (le_of_eq hg.symm)) hf

omit [IsIntegral X] [CompactSpace X] in
/-- Dividing by a function of known order. -/
public theorem ordGE_div_of_valuation_eq {E : MMP.Mori.PrimeDivisor X} {n m : ℤ}
    {f g : X.presheaf.stalk (componentGenericPoint X E.component)} (hf : E.OrdGE n f)
    (hg : E.valuation g = WithZero.exp m) : E.OrdGE (n - m) (f / g) := by
  have hg' : E.valuation g⁻¹ = WithZero.exp (-m) := by
    rw [map_inv₀, hg, WithZero.exp_neg]
  rw [div_eq_mul_inv, mul_comm, sub_eq_neg_add]
  exact ordGE_mul_of_valuation_eq hf hg'

omit [IsLocallyNoetherian X] [CompactSpace X] in
/-- A regular function invertible at the generic point has invertible germs at the generic points
of all components. -/
public theorem isUnit_germ_componentGenericPoint {U : X.Opens} {c : Γ(X, U)}
    (hc : genericPoint X ∈ X.basicOpen c) (Z : irreducibleComponents X)
    (hZ : componentGenericPoint X Z ∈ U) : IsUnit ((X.presheaf.germ U _ hZ).hom c) := by
  have hm : componentGenericPoint X Z ∈ X.basicOpen c := by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]; exact hc
  exact (Scheme.mem_basicOpen X c _ hZ).mp hm

omit [CompactSpace X] in
/-- A regular function on `U` invertible at the generic point has a well-defined order along
every prime divisor meeting `U`. -/
public theorem exists_valuation_germ_eq_exp {U : X.Opens} {c : Γ(X, U)}
    (hc : genericPoint X ∈ X.basicOpen c) :
    ∃ ord : MMP.Mori.PrimeDivisor X → ℤ, ∀ (E : MMP.Mori.PrimeDivisor X)
      (hE : E.genericPoint ∈ U), E.valuation ((X.presheaf.germ U
        (componentGenericPoint X E.component)
          (E.specializes_genericPoint.mem_open U.isOpen hE)).hom c) = WithZero.exp (ord E) := by
  classical
  refine ⟨fun E => if hE : E.genericPoint ∈ U then WithZero.log (E.valuation
      ((X.presheaf.germ U (componentGenericPoint X E.component)
        (E.specializes_genericPoint.mem_open U.isOpen hE)).hom c)) else 0, fun E hE => ?_⟩
  simp only [dite_eq_left hE]
  exact (WithZero.exp_log ((map_ne_zero E.valuation).mpr
    (isUnit_germ_componentGenericPoint hc _ _).ne_zero)).symm

end CartierDescent

end Helpers

end MMP.ProgramBaseChange
