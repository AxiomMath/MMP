module

public import Mathlib.Algebra.MvPolynomial.Monad
public import Mathlib.Algebra.Order.Ring.Defs
public import Mathlib.Analysis.Complex.Basic
public import Mathlib.Data.Fintype.Basic
public import Mathlib.Basic.Sign.Basic

/-!
# Semialgebraic sets

Let `R` be an ordered commutative ring and `σ` a type. A subset of `σ → R` is *semialgebraic*
if it lies in the Boolean algebra of subsets generated by the sets `{x | 0 < p(x)}` for
polynomials `p ∈ R[X_σ]`. This file develops the elementary closure properties: semialgebraic
sets are closed under complements, finite unions and intersections and preimages under
polynomial maps, and contain the sets `{p = 0}`, `{p ≤ 0}`, `{p < q}`. Identifying `ℂ` with
`ℝ²`, the common zero set of finitely many complex polynomials is a real algebraic, hence
semialgebraic, set.

## Main definitions

* `IsSemialgebraic`: the semialgebraic subsets of `σ → R`.
* `sqDistPoly`: the squared Euclidean distance to a point, as a polynomial.
* `complexToReal`, `realToComplex`, `complexRealEquiv`: the real coordinates `ℂ^σ ≃ ℝ^{σ × Fin 2}`.

## Main results

* `IsSemialgebraic.compl`, `IsSemialgebraic.inter`, `IsSemialgebraic.union`,
  `IsSemialgebraic.iInter`, `IsSemialgebraic.iUnion`: Boolean closure.
* `IsSemialgebraic.sign_eq`: sign conditions on one polynomial.
* `IsSemialgebraic.preimage_polynomialMap`: preimages under polynomial maps.
* `isSemialgebraic_zeroLocus`: real algebraic sets are semialgebraic.
* `isSemialgebraic_sqDist_lt`, `isSemialgebraic_sqDist_le`, `isSemialgebraic_sqDist_eq`: balls
  and spheres.
* `exists_eval_eq_re_add_im`: `f(z) = a(x) + i b(x)` for real polynomials `a, b` in the real
  coordinates `x` of `z`.
* `isSemialgebraic_preimage_complexZeroLocus`: complex algebraic sets, read in real coordinates,
  are semialgebraic.

## References

* [J. Bochnak, M. Coste, M.-F. Roy, *Real algebraic geometry*][bochnak1998], §2.1.
* [J. Milnor, *Singular points of complex hypersurfaces*][milnor1968], §2.
-/

@[expose] public section

open MvPolynomial

namespace MMP

variable {σ τ R : Type*} [CommRing R] [LinearOrder R] [IsStrictOrderedRing R]

/-- A subset of `σ → R` is *semialgebraic* if it belongs to the Boolean algebra generated by
the sets `{x | 0 < p(x)}`, `p ∈ R[X_σ]`. -/
inductive IsSemialgebraic : Set (σ → R) → Prop
  | pos (p : MvPolynomial σ R) : IsSemialgebraic {x | 0 < eval x p}
  | compl {s : Set (σ → R)} : IsSemialgebraic s → IsSemialgebraic sᶜ
  | inter {s t : Set (σ → R)} : IsSemialgebraic s → IsSemialgebraic t → IsSemialgebraic (s ∩ t)

namespace IsSemialgebraic

/-- The whole space `σ → R` is semialgebraic. -/
theorem univ : IsSemialgebraic (Set.univ : Set (σ → R)) := by
  simpa using IsSemialgebraic.pos (σ := σ) (C 1 : MvPolynomial σ R)

/-- The empty set is semialgebraic. -/
theorem empty : IsSemialgebraic (∅ : Set (σ → R)) := by
  simpa using (univ (σ := σ) (R := R)).compl

/-- The union of two semialgebraic sets is semialgebraic. -/
theorem union {s t : Set (σ → R)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s ∪ t) := by
  have := (hs.compl.inter ht.compl).compl
  rwa [← Set.compl_union, compl_compl] at this

/-- The difference of two semialgebraic sets is semialgebraic. -/
theorem diff {s t : Set (σ → R)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s \ t) :=
  hs.inter ht.compl

/-- A set is semialgebraic if and only if its complement is. -/
theorem compl_iff {s : Set (σ → R)} : IsSemialgebraic sᶜ ↔ IsSemialgebraic s :=
  ⟨fun h ↦ by simpa using h.compl, compl⟩

/-- A finite intersection of semialgebraic sets is semialgebraic. -/
theorem iInter {ι : Type*} [Finite ι] {s : ι → Set (σ → R)} (hs : ∀ i, IsSemialgebraic (s i)) :
    IsSemialgebraic (⋂ i, s i) := by
  classical
  have key : ∀ t : Finset ι, IsSemialgebraic (⋂ i ∈ t, s i) := by
    intro t
    induction t using Finset.induction_on with
    | empty => simpa using (univ (σ := σ) (R := R))
    | insert a t _ ih =>
      rw [Finset.set_biInter_insert]
      exact (hs a).inter ih
  haveI := Fintype.ofFinite ι
  simpa using key Finset.univ

/-- A finite union of semialgebraic sets is semialgebraic. -/
theorem iUnion {ι : Type*} [Finite ι] {s : ι → Set (σ → R)} (hs : ∀ i, IsSemialgebraic (s i)) :
    IsSemialgebraic (⋃ i, s i) := by
  rw [← compl_iff, Set.compl_iUnion]
  exact iInter fun i ↦ (hs i).compl

/-- The intersection of a family of semialgebraic sets over a finite index set is semialgebraic. -/
theorem biInter {ι : Type*} {t : Set ι} (ht : t.Finite) {s : ι → Set (σ → R)}
    (hs : ∀ i ∈ t, IsSemialgebraic (s i)) : IsSemialgebraic (⋂ i ∈ t, s i) := by
  haveI := ht.to_subtype
  rw [Set.biInter_eq_iInter]
  exact iInter fun i ↦ hs i i.2

/-- The union of a family of semialgebraic sets over a finite index set is semialgebraic. -/
theorem biUnion {ι : Type*} {t : Set ι} (ht : t.Finite) {s : ι → Set (σ → R)}
    (hs : ∀ i ∈ t, IsSemialgebraic (s i)) : IsSemialgebraic (⋃ i ∈ t, s i) := by
  haveI := ht.to_subtype
  rw [Set.biUnion_eq_iUnion]
  exact iUnion fun i ↦ hs i i.2

/-- `{x | p(x) ≤ 0}` is semialgebraic. -/
theorem nonpos (p : MvPolynomial σ R) : IsSemialgebraic {x : σ → R | eval x p ≤ 0} := by
  simpa [Set.compl_setOf, not_lt] using (IsSemialgebraic.pos p).compl

/-- `{x | p(x) < q(x)}` is semialgebraic. -/
theorem lt (p q : MvPolynomial σ R) : IsSemialgebraic {x : σ → R | eval x p < eval x q} := by
  simpa [sub_pos] using IsSemialgebraic.pos (q - p)

/-- `{x | p(x) ≤ q(x)}` is semialgebraic. -/
theorem le (p q : MvPolynomial σ R) : IsSemialgebraic {x : σ → R | eval x p ≤ eval x q} := by
  simpa [sub_nonpos] using nonpos (p - q)

/-- `{x | p(x) = 0}` is semialgebraic. -/
theorem zero (p : MvPolynomial σ R) : IsSemialgebraic {x : σ → R | eval x p = 0} := by
  have h := (nonpos p).inter (nonpos (-p))
  convert h using 1
  ext x
  simp only [Set.mem_setOf_eq, Set.mem_inter_iff, map_neg, neg_nonpos]
  exact ⟨fun h ↦ ⟨h.le, h.ge⟩, fun h ↦ le_antisymm h.1 h.2⟩

/-- `{x | p(x) ≠ 0}` is semialgebraic. -/
theorem ne_zero (p : MvPolynomial σ R) : IsSemialgebraic {x : σ → R | eval x p ≠ 0} := by
  simpa [Set.compl_setOf] using (zero p).compl

/-- `{x | sign (p(x)) = s}` is semialgebraic. -/
theorem sign_eq (p : MvPolynomial σ R) (s : SignType) :
    IsSemialgebraic {x : σ → R | SignType.sign (eval x p) = s} := by
  rcases s with _ | _ | _
  · simpa [sign_eq_zero_iff] using zero p
  · simpa [sign_eq_neg_one_iff, neg_pos] using IsSemialgebraic.pos (-p)
  · simpa [sign_eq_one_iff] using IsSemialgebraic.pos p

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- The polynomial map `x ↦ (φ i (x))_i`. -/
noncomputable abbrev polynomialMap (φ : τ → MvPolynomial σ R) (x : σ → R) : τ → R :=
  fun i ↦ eval x (φ i)

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- Evaluating `p` at `polynomialMap φ x` is evaluating the substitution `bind₁ φ p` at `x`. -/
theorem eval_polynomialMap (φ : τ → MvPolynomial σ R) (x : σ → R) (p : MvPolynomial τ R) :
    eval (polynomialMap φ x) p = eval x (bind₁ φ p) := by
  induction p using MvPolynomial.induction_on with
  | C c => simp
  | add f g hf hg => simp [hf, hg]
  | mul_X f i hf => simp [hf]

/-- **Preimages under polynomial maps.** The preimage of a semialgebraic set under a polynomial
map is semialgebraic. -/
theorem preimage_polynomialMap (φ : τ → MvPolynomial σ R) {s : Set (τ → R)}
    (hs : IsSemialgebraic s) : IsSemialgebraic (polynomialMap φ ⁻¹' s) := by
  induction hs with
  | pos p =>
    have : polynomialMap φ ⁻¹' {y | 0 < eval y p} = {x | 0 < eval x (bind₁ φ p)} := by
      ext x; simp [eval_polynomialMap]
    rw [this]; exact .pos _
  | compl _ ih => exact ih.compl
  | inter _ _ ih₁ ih₂ => exact ih₁.inter ih₂

/-- Preimages under a change of variables `x ↦ x ∘ e` are semialgebraic. -/
theorem preimage_comp (e : τ → σ) {s : Set (τ → R)} (hs : IsSemialgebraic s) :
    IsSemialgebraic ((fun x : σ → R ↦ x ∘ e) ⁻¹' s) := by
  have := preimage_polynomialMap (fun i ↦ (X (e i) : MvPolynomial σ R)) hs
  convert this using 2
  ext x i
  simp

end IsSemialgebraic

/-- **Real algebraic sets are semialgebraic.** -/
theorem isSemialgebraic_zeroLocus {ι : Type*} [Finite ι] (f : ι → MvPolynomial σ R) :
    IsSemialgebraic {x : σ → R | ∀ j, eval x (f j) = 0} := by
  simp only [Set.setOf_forall]
  exact IsSemialgebraic.iInter fun j ↦ IsSemialgebraic.zero (f j)

namespace IsSemialgebraic

/-- **Products.** If `s ⊆ R^σ` and `t ⊆ R^τ` are semialgebraic, so is `s × t ⊆ R^{σ ⊕ τ}`. -/
theorem sumElim_preimage {s : Set (σ → R)} {t : Set (τ → R)} (hs : IsSemialgebraic s)
    (ht : IsSemialgebraic t) :
    IsSemialgebraic {x : σ ⊕ τ → R | x ∘ Sum.inl ∈ s ∧ x ∘ Sum.inr ∈ t} :=
  (preimage_comp Sum.inl hs).inter (preimage_comp Sum.inr ht)

end IsSemialgebraic

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- The squared Euclidean distance `∑ᵢ (Xᵢ - pᵢ)²` to a point `p ∈ R^σ`. -/
noncomputable def sqDistPoly [Fintype σ] (p : σ → R) : MvPolynomial σ R :=
  ∑ i, (X i - C (p i)) ^ 2

omit [LinearOrder R] [IsStrictOrderedRing R] in
/-- `sqDistPoly p` evaluates at `x` to `∑ᵢ (xᵢ - pᵢ)²`. -/
@[simp]
theorem eval_sqDistPoly [Fintype σ] (p x : σ → R) :
    eval x (sqDistPoly p) = ∑ i, (x i - p i) ^ 2 := by
  simp [sqDistPoly]

/-- Open balls `{x | ∑ᵢ (xᵢ - pᵢ)² < r}` are semialgebraic. -/
theorem isSemialgebraic_sqDist_lt [Fintype σ] (p : σ → R) (r : R) :
    IsSemialgebraic {x : σ → R | ∑ i, (x i - p i) ^ 2 < r} := by
  simpa using IsSemialgebraic.lt (sqDistPoly p) (C r)

/-- Closed balls `{x | ∑ᵢ (xᵢ - pᵢ)² ≤ r}` are semialgebraic. -/
theorem isSemialgebraic_sqDist_le [Fintype σ] (p : σ → R) (r : R) :
    IsSemialgebraic {x : σ → R | ∑ i, (x i - p i) ^ 2 ≤ r} := by
  simpa using IsSemialgebraic.le (sqDistPoly p) (C r)

/-- Spheres `{x | ∑ᵢ (xᵢ - pᵢ)² = r}` are semialgebraic. -/
theorem isSemialgebraic_sqDist_eq [Fintype σ] (p : σ → R) (r : R) :
    IsSemialgebraic {x : σ → R | ∑ i, (x i - p i) ^ 2 = r} := by
  have h := IsSemialgebraic.zero (sqDistPoly p - C r)
  simp only [map_sub, eval_sqDistPoly, eval_C, sub_eq_zero] at h
  exact h

/-! ### Complex polynomials in real coordinates -/

/-- The real coordinates `(re z_i, im z_i)` of `z ∈ ℂ^σ`, indexed by `σ × Fin 2`. -/
def complexToReal (z : σ → ℂ) : σ × Fin 2 → ℝ := fun i ↦
  if i.2 = 0 then (z i.1).re else (z i.1).im

/-- The point of `ℂ^σ` with real coordinates `x`. -/
def realToComplex (x : σ × Fin 2 → ℝ) : σ → ℂ := fun i ↦ ⟨x (i, 0), x (i, 1)⟩

@[simp]
theorem complexToReal_apply_zero (z : σ → ℂ) (i : σ) : complexToReal z (i, 0) = (z i).re := by
  simp [complexToReal]

@[simp]
theorem complexToReal_apply_one (z : σ → ℂ) (i : σ) : complexToReal z (i, 1) = (z i).im := by
  simp [complexToReal]

@[simp]
theorem re_realToComplex (x : σ × Fin 2 → ℝ) (i : σ) : (realToComplex x i).re = x (i, 0) := rfl

@[simp]
theorem im_realToComplex (x : σ × Fin 2 → ℝ) (i : σ) : (realToComplex x i).im = x (i, 1) := rfl

/-- `realToComplex` is a left inverse of `complexToReal`. -/
@[simp]
theorem realToComplex_complexToReal (z : σ → ℂ) : realToComplex (complexToReal z) = z := by
  ext i <;> simp [realToComplex, complexToReal]

/-- `realToComplex` is a right inverse of `complexToReal`. -/
@[simp]
theorem complexToReal_realToComplex (x : σ × Fin 2 → ℝ) :
    complexToReal (realToComplex x) = x := by
  ext ⟨i, j⟩
  fin_cases j <;> simp [realToComplex, complexToReal]

/-- `z ↦ (re z_i, im z_i)_i` is an equivalence `ℂ^σ ≃ ℝ^{σ × Fin 2}`. -/
@[simps]
def complexRealEquiv : (σ → ℂ) ≃ (σ × Fin 2 → ℝ) where
  toFun := complexToReal
  invFun := realToComplex
  left_inv := realToComplex_complexToReal
  right_inv := complexToReal_realToComplex

/-- **Real and imaginary parts of a complex polynomial.** For `f ∈ ℂ[X_σ]` there are real
polynomials `a, b` in the variables `X_{σ × Fin 2}` with `f(z) = a(x) + i b(x)` whenever `x` are
the real coordinates of `z`. -/
theorem exists_eval_eq_re_add_im (f : MvPolynomial σ ℂ) :
    ∃ a b : MvPolynomial (σ × Fin 2) ℝ, ∀ z : σ → ℂ,
      eval z f = ⟨eval (complexToReal z) a, eval (complexToReal z) b⟩ := by
  induction f using MvPolynomial.induction_on with
  | C c => exact ⟨C c.re, C c.im, fun z ↦ by simp⟩
  | add f g hf hg =>
    obtain ⟨a, b, h⟩ := hf
    obtain ⟨a', b', h'⟩ := hg
    exact ⟨a + a', b + b', fun z ↦ by rw [map_add, h, h']; apply Complex.ext <;> simp⟩
  | mul_X f i hf =>
    obtain ⟨a, b, h⟩ := hf
    refine ⟨a * X (i, 0) - b * X (i, 1), a * X (i, 1) + b * X (i, 0), fun z ↦ ?_⟩
    rw [map_mul, h, eval_X]
    apply Complex.ext <;> simp [complexToReal] <;> ring

/-- **Complex algebraic sets are real algebraic.** The common zero set in `ℂ^σ` of finitely many
complex polynomials, read in real coordinates, is the zero set of finitely many real
polynomials. -/
theorem exists_complexZeroLocus_eq {ι : Type*} [Finite ι] (f : ι → MvPolynomial σ ℂ) :
    ∃ g : ι × Fin 2 → MvPolynomial (σ × Fin 2) ℝ,
      realToComplex ⁻¹' {z : σ → ℂ | ∀ j, eval z (f j) = 0} =
        {x | ∀ j, eval x (g j) = 0} := by
  choose a b h using fun j ↦ exists_eval_eq_re_add_im (f j)
  refine ⟨fun j ↦ if j.2 = 0 then a j.1 else b j.1, ?_⟩
  ext x
  simp only [Set.mem_preimage, Set.mem_setOf_eq, h, complexToReal_realToComplex,
    Complex.ext_iff, Complex.zero_re, Complex.zero_im, Prod.forall]
  constructor
  · intro hx j k
    fin_cases k <;> simp [hx j]
  · intro hx j
    exact ⟨by simpa using hx j 0, by simpa using hx j 1⟩

/-- Complex algebraic sets, read in real coordinates, are semialgebraic. -/
theorem isSemialgebraic_preimage_complexZeroLocus {ι : Type*} [Finite ι]
    (f : ι → MvPolynomial σ ℂ) :
    IsSemialgebraic (realToComplex ⁻¹' {z : σ → ℂ | ∀ j, eval z (f j) = 0}) := by
  obtain ⟨g, hg⟩ := exists_complexZeroLocus_eq f
  rw [hg]
  exact isSemialgebraic_zeroLocus g

end MMP
