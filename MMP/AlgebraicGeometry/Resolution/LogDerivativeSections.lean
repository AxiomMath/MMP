module

public import MMP.AlgebraicGeometry.Resolution.MaximalContact.Derivative
public import MMP.AlgebraicGeometry.Morphisms.Smooth.RegularParametersCharZero

/-!
# Sections of logarithmic derivative ideals

Let `X` be a scheme locally of finite type over a field `k`, `S ⊆ X` a closed subscheme and `K`
an ideal sheaf. The logarithmic derivative `D(-log S)(K)` is the ideal sheaf generated by the
`δ f`, `δ` a local `k`-derivation of `𝒪_X` preserving `𝒪_X(-S)` and `f` a local section of
`K`. On an affine open `W` its sections are the ideal of `𝒪_X(W)` generated by the `δ f`, `δ` a
`k`-derivation of `𝒪_X(W)` with `δ(𝒪_X(-S)(W)) ⊆ 𝒪_X(-S)(W)` and `f ∈ K(W)`.

The point is that this ideal is compatible with passing to basic opens: a logarithmic derivation
of a localization `R_f` becomes a logarithmic derivation of `R` after multiplication with a
power of `f`, since `𝒪_X(-S)(W)` is finitely generated.

## Main results

* `MMP.Resolution.logDerivativeIdeal_ideal`: the sections of `D(-log S)(K)` over an affine open.

## References

* [J. Kollár, *Lectures on resolution of singularities*][kollar2007], 3.87
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace MMP.Resolution

section LogSpan

/-- The ideal generated by the `δ f`, `f ∈ K`, for the `k`-derivations `δ` of `R` preserving
`I`. -/
private def logSpan (k : Type*) {R : Type*} [CommRing k] [CommRing R] [Algebra k R]
    (I K : Ideal R) : Ideal R :=
  Ideal.span {g | ∃ δ : Derivation k R R, (∀ s ∈ I, δ s ∈ I) ∧ ∃ f ∈ K, δ f = g}

/-- A derivation preserving the generated ideal on its generators preserves it. -/
private theorem derivation_mem_of_mem_span {k R : Type*} [CommRing k] [CommRing R] [Algebra k R]
    (δ : Derivation k R R) {T : Set R} (hT : ∀ t ∈ T, δ t ∈ Ideal.span T) :
    ∀ x ∈ Ideal.span T, δ x ∈ Ideal.span T := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem t ht => exact hT t ht
  | zero => simp
  | add a b _ _ ha hb =>
    rw [map_add]
    exact add_mem ha hb
  | smul c a ha ih =>
    rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (Ideal.mul_mem_left _ c ih) (Ideal.mul_mem_right _ _ ha)

variable {k R R' : Type*} [CommRing k] [CommRing R] [CommRing R'] [Algebra k R] [Algebra k R']
  [Algebra R R'] [IsScalarTower k R R']

/-- A derivation of `R_f` preserving `I R_f` becomes, after multiplying by a power of `f`, a
derivation of `R` preserving `I`; this uses that `I` is finitely generated. -/
private theorem exists_clear_denominator_log (f : R) [IsLocalization.Away f R']
    [Algebra.FinitePresentation k R] [IsNoetherianRing R] (I : Ideal R) (δ' : Derivation k R' R')
    (hδ' : ∀ s ∈ I.map (algebraMap R R'), δ' s ∈ I.map (algebraMap R R')) :
    ∃ (n : ℕ) (δ'' : Derivation k R R), (∀ s ∈ I, δ'' s ∈ I) ∧
      ∀ r, algebraMap R R' f ^ n * δ' (algebraMap R R' r) = algebraMap R R' (δ'' r) := by
  obtain ⟨_, ⟨n, rfl⟩, δ₀, h₀⟩ :=
    exists_derivation_mul_of_isLocalization (Submonoid.powers f) δ'
  simp only [map_pow] at h₀
  obtain ⟨T, hT : Ideal.span (T : Set R) = I⟩ := (IsNoetherian.noetherian I : I.FG)
  have hgen : ∀ t ∈ T, ∃ m : ℕ, f ^ m * δ₀ t ∈ I := by
    intro t ht
    have htI : t ∈ I := hT ▸ Ideal.subset_span ht
    have : algebraMap R R' (δ₀ t) ∈ I.map (algebraMap R R') := by
      rw [← h₀]
      exact Ideal.mul_mem_left _ _ (hδ' _ (Ideal.mem_map_of_mem _ htI))
    obtain ⟨_, ⟨m, rfl⟩, hm⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers f) R' _ _).mp this
    exact ⟨m, hm⟩
  choose! m hm using hgen
  let M := ∑ t ∈ T, m t
  refine ⟨n + M, f ^ M • δ₀, ?_, fun r => ?_⟩
  · intro s hs
    rw [← hT] at hs ⊢
    refine derivation_mem_of_mem_span _ (fun t ht => ?_) s hs
    have hle : m t ≤ M := Finset.single_le_sum (fun _ _ => Nat.zero_le _) ht
    rw [Derivation.smul_apply, smul_eq_mul, ← Nat.sub_add_cancel hle, pow_add, mul_assoc, hT]
    exact Ideal.mul_mem_left _ _ (hm t ht)
  · rw [Derivation.smul_apply, smul_eq_mul, map_mul, ← h₀, map_pow, pow_add]
    ring

/-- The quotient rule with denominators cleared: if `x * s = g` and `c • δ` is computed by
`d` on `s` and `g`, then `c * s ^ 2 * δ x = s * d g - g * d s`. -/
private theorem mul_derivation_of_mul_eq {A : Type*} [CommRing A] [Algebra k A]
    (δ : Derivation k A A) {c x s g ds dg : A} (h : x * s = g) (hg : c * δ g = dg)
    (hs : c * δ s = ds) : c * s ^ 2 * δ x = s * dg - g * ds := by
  subst h hg hs
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
  ring

/-- `s δ g - g δ s` lies in `logSpan k I J` for a logarithmic `δ` and `g ∈ J`. -/
private theorem sub_mem_logSpan {I J : Ideal R} {δ : Derivation k R R} (hδ : ∀ s ∈ I, δ s ∈ I)
    {g : R} (hg : g ∈ J) (s : R) : s * δ g - g * δ s ∈ logSpan k I J := by
  have h1 : δ g ∈ logSpan k I J := Ideal.subset_span ⟨δ, hδ, g, hg, rfl⟩
  have h2 : δ (s * g) ∈ logSpan k I J := Ideal.subset_span ⟨δ, hδ, _, J.mul_mem_left _ hg, rfl⟩
  convert sub_mem (Ideal.mul_mem_left _ (2 * s) h1) h2 using 1
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
  ring

/-- `logSpan` commutes with localization away from an element. -/
private theorem logSpan_map_away (f : R) [IsLocalization.Away f R']
    [Algebra.FinitePresentation k R] [IsNoetherianRing R] (I J : Ideal R) :
    (logSpan k I J).map (algebraMap R R') =
      logSpan k (I.map (algebraMap R R')) (J.map (algebraMap R R')) := by
  apply le_antisymm
  · rw [logSpan, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨δ, hδ, g, hg, rfl⟩, rfl⟩
    obtain ⟨δ', hδ'⟩ :=
      exists_derivation_extend_of_isLocalization (A := R') (Submonoid.powers f) δ
    refine Ideal.subset_span ⟨δ', ?_, algebraMap R R' g, Ideal.mem_map_of_mem _ hg, hδ' g⟩
    rw [Ideal.map]
    refine derivation_mem_of_mem_span _ ?_
    rintro _ ⟨s, hs, rfl⟩
    rw [hδ']
    exact Ideal.subset_span ⟨_, hδ s hs, rfl⟩
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨δ', hlog, x, hx, rfl⟩
    obtain ⟨n, δ'', hδlog, hδ''⟩ := exists_clear_denominator_log f I δ' hlog
    obtain ⟨⟨g, s⟩, hgs⟩ := (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers f) R').mp hx
    have hu : IsUnit (algebraMap R R' (f ^ n * (s : R) ^ 2)) :=
      IsLocalization.map_units R' (⟨_, mul_mem (pow_mem (Submonoid.mem_powers f) n)
        (pow_mem s.2 2)⟩ : Submonoid.powers f)
    rw [SetLike.mem_coe, ← Ideal.unit_mul_mem_iff_mem _ hu, map_mul, map_pow, map_pow,
      mul_derivation_of_mul_eq δ' hgs (hδ'' g) (hδ'' s), ← map_mul, ← map_mul, ← map_sub]
    exact Ideal.mem_map_of_mem _ (sub_mem_logSpan hδlog g.2 s)

end LogSpan

section Geometry

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

private theorem sectionLogDerivativeIdeal_eq (S K : X.IdealSheafData) (W : X.affineOpens) :
    sectionLogDerivativeIdeal sX S K W =
      letI := MMP.Mori.sectionAlgebra sX W.1
      logSpan k (S.ideal W) (K.ideal W) := by
  let := MMP.Mori.sectionAlgebra sX W.1
  rfl

private theorem sectionLogDerivativeIdeal_map_basicOpen [LocallyOfFiniteType sX]
    (S K : X.IdealSheafData) (W : X.affineOpens) (f : Γ(X, W)) :
    (sectionLogDerivativeIdeal sX S K W).map
        (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      sectionLogDerivativeIdeal sX S K (X.affineBasicOpen f) := by
  let := MMP.Mori.sectionAlgebra sX W.1
  let := MMP.Mori.sectionAlgebra sX (X.basicOpen f)
  have : Algebra.FiniteType k Γ(X, W) := MMP.Mori.finiteType_sectionAlgebra sX W.2
  have : Algebra.FinitePresentation k Γ(X, W) :=
    Algebra.FinitePresentation.of_finiteType.mp this
  have : IsNoetherianRing Γ(X, W) := Algebra.FiniteType.isNoetherianRing k _
  let := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  have : IsScalarTower k Γ(X, W) Γ(X, X.basicOpen f) :=
    IsScalarTower.of_algebraMap_eq' <| RingHom.ext fun c =>
      (MMP.Flips.ResolutionInputs.sectionAlgebra_map_res sX (X.basicOpen_le f) c).symm
  have := W.2.isLocalization_basicOpen f
  rw [sectionLogDerivativeIdeal_eq, sectionLogDerivativeIdeal_eq, ← S.map_ideal_basicOpen W f,
    ← K.map_ideal_basicOpen W f]
  exact logSpan_map_away (k := k) (R' := Γ(X, X.basicOpen f)) f (S.ideal W) (K.ideal W)

/-- On a scheme locally of finite type over `k`, the sections of `D(-log S)(K)` over an affine
open `W` are the ideal generated by the `δ f`, `δ ∈ Der_X(-log S)(W)` and `f ∈ K(W)`. -/
theorem logDerivativeIdeal_ideal [LocallyOfFiniteType sX] (S K : X.IdealSheafData)
    (W : X.affineOpens) :
    (logDerivativeIdeal sX S K).ideal W = sectionLogDerivativeIdeal sX S K W := by
  let J₀ : X.IdealSheafData :=
    { ideal := sectionLogDerivativeIdeal sX S K
      map_ideal_basicOpen := sectionLogDerivativeIdeal_map_basicOpen sX S K }
  have hmem : J₀ ∈ {J : X.IdealSheafData | ∀ W : X.affineOpens,
      sectionLogDerivativeIdeal sX S K W ≤ J.ideal W} := fun W => le_rfl
  rw [show logDerivativeIdeal sX S K = J₀ from
    le_antisymm (sInf_le hmem) (le_sInf fun J hJ W => hJ W)]

end Geometry

end MMP.Resolution

end
