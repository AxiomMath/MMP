module

public import MMP.Attr
public import MMP.AlgebraicGeometry.Divisor.Canonical.PluricanonicalForms

/-!
# Divisors of top forms, normal forms and monomial valuations (Kollár 1.6, 1.10)

Let `X` be a smooth variety of pure dimension `n` over `k`, possibly disconnected, with
irreducible components `X_α`. A *rational `n`-form* `ω` on `X` is a family `(ω_α)` of rational
sections of `Ω^n_{X_α/k}`, that is, of elements of `Ω^n_{k(X_α)/k}`. Its *divisor* is
`div(ω) = ∑_D v_D(ω) D`, where for a prime divisor `D ⊆ X_α` the order `v_D(ω) = v_D(ω_α / η)` is
computed against a generator `η` of `Ω^n_{X/k}` near `D`, `v_D` the valuation of `𝒪_{D,X}`.

Let `(R, 𝔪)` be a regular local ring of dimension two with regular system of parameters `(x, y)`.
An element `f ∈ 𝔪^m ∖ 𝔪^{m+1}` is in *normal form* with respect to `(x, y)` if
`f ∈ (y^m) + 𝔪^{m+1}`. For an integer `w ≥ 1` the *monomial valuation* `v_w(s)` is the largest `ν`
with `s` in the ideal `I_ν` generated by the monomials `x^i y^j` with `i + w j ≥ ν`.

## Main definitions

* `MMP.Resolution.RationalComponentForms`: rational `m`-canonical forms on the components of `X`.
* `MMP.Resolution.ordComponentForm`, `MMP.Resolution.divisorOfComponentForm`: `v_D(ω)` and
  `div(ω)`.
* `MMP.Resolution.IsInNormalForm`: `f` is in normal form with respect to `(x, y)`.
* `MMP.Resolution.monomialIdeal`, `MMP.Resolution.monomialValuation`: `I_ν` and `v_w`.

## Implementation notes

The forms are stated for every `m ∈ ℤ`, using `MMP.Mori.PluriForms` on the function field of each
component; Kollár's rational differential `n`-forms are the case `m = 1`. The order along `D`
is `MMP.Mori.ordAt` for the local ring `𝒪_{X,D}` inside the function field of the component of
`D`, with the normalized valuation `MMP.Mori.PrimeDivisor.valuation`; it does not depend on the
generator `η` by `MMP.Mori.ordAt_eq`. Smoothness and pure dimensionality are not needed to state
the definition: it is made for a normal, locally Noetherian scheme of finite type over `k`.

The inverse image ideal sheaf `π^* I · 𝒪_{S'}` of Kollár 1.10 is Mathlib's
`AlgebraicGeometry.Scheme.IdealSheafData.comap`, the ideal of `S' ×_S V(I)`.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u v

namespace MMP.Resolution

/-! ### The divisor of a rational top form on a possibly disconnected scheme -/

section Forms

open MMP.Mori

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsReduced X]

/-- The field structure of the function field `k(X_α) = 𝒪_{X,η_α}` of an irreducible component
`X_α` of a reduced scheme. -/
@[instance_reducible]
noncomputable def componentField (Z : irreducibleComponents X) :
    Field (X.presheaf.stalk (componentGenericPoint X Z)) :=
  (RationalFunctions.isField_stalk X Z).toField

/-- A *rational `m`-canonical form* on a scheme `X` over `k` with function fields `k(X_α)` on its
irreducible components: a family `(ω_α)` of elements of `(Ω^n_{k(X_α)/k})^{⊗m}`. For `m = 1` these
are the rational differential `n`-forms of Kollár 1.6. -/
@[mmp "def_kr1c_divisor_of_rational_top_form"]
def RationalComponentForms (n : ℕ) (m : ℤ) : Type u :=
  ∀ Z : irreducibleComponents X,
    @PluriForms k _ (X.presheaf.stalk (componentGenericPoint X Z)) (componentField Z)
      (stalkAlgebra sX (componentGenericPoint X Z)) n m

variable {sX}

/-- The integer order `v_D(φ)` of an element of the function field of the component of `D`, from
the normalized valuation of the discrete valuation ring `𝒪_{X,D}`; it is `0` at `φ = 0`. -/
noncomputable def intValuation [IsLocallyNoetherian X] [IsNormal X]
    (D : Mori.PrimeDivisor X) (φ : X.presheaf.stalk (componentGenericPoint X D.component)) : ℤ :=
  WithZero.log (D.valuation φ)

variable [IsLocallyNoetherian X] [IsNormal X] {n : ℕ} {m : ℤ}

/-- The `k`-algebra structures on the local ring `𝒪_{X,D}` of a prime divisor `D` and on the
function field of its component form a scalar tower over the inclusion `𝒪_{X,D} → k(X_α)`. -/
theorem isScalarTower_toComponent (D : Mori.PrimeDivisor X) :
    letI := stalkAlgebra sX D.genericPoint
    letI := stalkAlgebra sX (componentGenericPoint X D.component)
    letI := D.toComponent.hom.toAlgebra
    IsScalarTower k D.localRing (X.presheaf.stalk (componentGenericPoint X D.component)) := by
  let := stalkAlgebra sX D.genericPoint
  let := stalkAlgebra sX (componentGenericPoint X D.component)
  let := D.toComponent.hom.toAlgebra
  refine IsScalarTower.of_algebraMap_eq' ?_
  have h : (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
        X.presheaf.germ ⊤ (componentGenericPoint X D.component) (TopologicalSpace.Opens.mem_top _) =
      ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
        X.presheaf.germ ⊤ D.genericPoint (TopologicalSpace.Opens.mem_top _)) ≫ D.toComponent := by
    simp [Mori.PrimeDivisor.toComponent, stalkToRationalFunctions]
  exact congrArg CommRingCat.Hom.hom h

/-- The *order* `v_D(ω) = v_D(ω_α / η^{⊗m})` of a rational `m`-canonical form along a prime divisor
`D` contained in the component `X_α`, for `η` a generator of `Ω^n_{𝒪_{X,D}/k}`. -/
@[mmp "def_kr1c_divisor_of_rational_top_form"]
noncomputable def ordComponentForm (D : Mori.PrimeDivisor X) (ω : RationalComponentForms sX n m) :
    ℤ :=
  letI := componentField (X := X) D.component
  letI := stalkAlgebra sX D.genericPoint
  letI := stalkAlgebra sX (componentGenericPoint X D.component)
  letI := D.toComponent.hom.toAlgebra
  haveI := isScalarTower_toComponent (sX := sX) D
  haveI := isFractionRing_stalkToRationalFunctions D.genericPoint_mem_component
  ordAt (k := k) D.localRing (intValuation D) (ω D.component)

private theorem intValuation_mul (D : Mori.PrimeDivisor X)
    (x y : X.presheaf.stalk (componentGenericPoint X D.component)) (hx : x ≠ 0) (hy : y ≠ 0) :
    intValuation D (x * y) = intValuation D x + intValuation D y := by
  letI := componentField (X := X) D.component
  exact (congrArg WithZero.log (map_mul D.valuation x y)).trans
    (WithZero.log_mul ((map_ne_zero D.valuation).mpr hx) ((map_ne_zero D.valuation).mpr hy))

private theorem intValuation_toComponent_of_isUnit (D : Mori.PrimeDivisor X) {a : D.localRing}
    (ha : IsUnit a) : intValuation D (D.toComponent.hom a) = 0 := by
  simp [intValuation, D.valuation_toComponent_of_isUnit ha]

private theorem eventually_germ (η : X) (f : X.presheaf.stalk η) :
    ∀ᶠ x in nhds η, ∃ (V : X.Opens) (hη : η ∈ V) (_ : x ∈ V) (a : Γ(X, V)),
      X.presheaf.germ V η hη a = f := by
  obtain ⟨V, hV, a, ha⟩ := X.presheaf.exists_germ_eq f
  filter_upwards [V.isOpen.mem_nhds hV] with x hx
  exact ⟨V, hV, hx, a, ha⟩

private theorem exists_open_ordComponentForm_eq_zero [CompactSpace X] [LocallyOfFiniteType sX]
    (ω : RationalComponentForms sX n m) (Z : irreducibleComponents X) :
    ∃ t : X.Opens, componentGenericPoint X Z ∈ t ∧ ∀ D : Mori.PrimeDivisor X,
      D.component = Z → D.genericPoint ∈ t → ordComponentForm D ω = 0 := by
  classical
  by_cases hτ : ω Z = 0
  · refine ⟨⊤, trivial, ?_⟩
    intro D hD _
    subst hD
    simp only [ordComponentForm]
    rw [hτ]
    letI := componentField (X := X) D.component
    letI := stalkAlgebra sX (componentGenericPoint X D.component)
    letI := stalkAlgebra sX D.genericPoint
    letI := D.toComponent.hom.toAlgebra
    haveI := isScalarTower_toComponent (sX := sX) D
    haveI := isFractionRing_stalkToRationalFunctions D.genericPoint_mem_component
    exact ordAt_zero (by simp [intValuation])
  letI := componentField (X := X) Z
  letI := stalkAlgebra sX (componentGenericPoint X Z)
  by_cases hb : Nonempty (Module.Basis Unit (X.presheaf.stalk (componentGenericPoint X Z))
    (⋀[X.presheaf.stalk (componentGenericPoint X Z)]^n
      Ω[X.presheaf.stalk (componentGenericPoint X Z)⁄k]))
  swap
  · refine ⟨⊤, trivial, ?_⟩
    intro D hD _
    subst hD
    simp only [ordComponentForm]
    letI := componentField (X := X) D.component
    letI := stalkAlgebra sX (componentGenericPoint X D.component)
    letI := stalkAlgebra sX D.genericPoint
    letI := D.toComponent.hom.toAlgebra
    haveI := isScalarTower_toComponent (sX := sX) D
    haveI := isFractionRing_stalkToRationalFunctions D.genericPoint_mem_component
    have : ¬ ∃ σ : ⋀[D.localRing]^n Ω[D.localRing⁄k], Submodule.span D.localRing {σ} = ⊤ ∧
        topFormsMap k D.localRing (X.presheaf.stalk (componentGenericPoint X D.component))
          n σ ≠ 0 :=
      fun ⟨σ, hσ, h0⟩ => hb ⟨topFormsBasis D.localRing hσ h0⟩
    simp only [ordAt, dite_eq_right this]
  obtain ⟨b⟩ := hb
  let η := componentGenericPoint X Z
  set g := (ZTensorPower.basis b m).repr (ω Z) () with hg_def
  have hg0 : g ≠ 0 := by
    intro h
    apply hτ
    rw [← basis_unit_repr_smul (ZTensorPower.basis b m) (ω Z), ← hg_def, h, zero_smul]
  obtain ⟨_, ⟨U, hU, rfl⟩, hηU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ η) isOpen_univ
  have hU' : IsAffineOpen U := hU
  let := sectionAlgebra sX U
  let := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨η, hηU⟩ : U)
  have : IsScalarTower k Γ(X, U) (X.presheaf.stalk η) :=
    isScalarTower_section_stalk sX U ⟨η, hηU⟩
  have := finiteType_sectionAlgebra sX hU'
  obtain ⟨s, hs⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k Γ(X, U)).FG)
  have : IsLocalization (hU'.primeIdealOf (⟨η, hηU⟩ : U)).asIdeal.primeCompl
      (X.presheaf.stalk η) := hU'.isLocalization_stalk ⟨η, hηU⟩
  have hspan := span_range_topFormsFamily (k := k) (d := n) (X.presheaf.stalk η)
    (hU'.primeIdealOf (⟨η, hηU⟩ : U)).asIdeal.primeCompl hs
  obtain ⟨l, hl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp
    (hspan ▸ Submodule.mem_top : b () ∈ _)
  have hP : ∀ᶠ x in nhds η, x ∈ U ∧
      (∀ I, ∃ (V : X.Opens) (hη : η ∈ V) (_ : x ∈ V) (a : Γ(X, V)),
        X.presheaf.germ V η hη a = b.repr (topFormsFamily k (X.presheaf.stalk η) s n I) ()) ∧
      (∀ I, ∃ (V : X.Opens) (hη : η ∈ V) (_ : x ∈ V) (a : Γ(X, V)),
        X.presheaf.germ V η hη a = l I) ∧
      (∃ (V : X.Opens) (hη : η ∈ V) (_ : x ∈ V) (a : Γ(X, V)),
        X.presheaf.germ V η hη a = g) ∧
      (∃ (V : X.Opens) (hη : η ∈ V) (_ : x ∈ V) (a : Γ(X, V)),
        X.presheaf.germ V η hη a = g⁻¹) :=
    (show ∀ᶠ x in nhds η, x ∈ U from U.isOpen.mem_nhds hηU).and <|
      (Filter.eventually_all.mpr fun _ => eventually_germ _ _).and <|
      (Filter.eventually_all.mpr fun _ => eventually_germ _ _).and <|
      (eventually_germ _ g).and (eventually_germ _ g⁻¹)
  obtain ⟨t, htP, ht, hηt⟩ := eventually_nhds_iff.mp hP
  refine ⟨⟨t, ht⟩, hηt, ?_⟩
  intro D hD hmem
  subst hD
  simp only [ordComponentForm]
  letI := stalkAlgebra sX D.genericPoint
  letI := D.toComponent.hom.toAlgebra
  haveI := isScalarTower_toComponent (sX := sX) D
  haveI := isFractionRing_stalkToRationalFunctions D.genericPoint_mem_component
  obtain ⟨hxU, hc, hl', hgx, hginv⟩ := htP _ hmem
  have hrange : ∀ f : X.presheaf.stalk (componentGenericPoint X D.component),
      (∃ (V : X.Opens) (hη : componentGenericPoint X D.component ∈ V) (_ : D.genericPoint ∈ V)
        (a : Γ(X, V)), X.presheaf.germ V _ hη a = f) →
      f ∈ Set.range (algebraMap D.localRing
        (X.presheaf.stalk (componentGenericPoint X D.component))) := by
    rintro f ⟨V, hV, hx, a, ha⟩
    refine ⟨X.presheaf.germ V D.genericPoint hx a, ?_⟩
    rw [← ha]
    change (X.presheaf.germ V _ hx ≫ X.presheaf.stalkSpecializes _).hom a = _
    rw [X.presheaf.germ_stalkSpecializes]
  let x : U := ⟨D.genericPoint, hxU⟩
  let : Algebra Γ(X, U) D.localRing := TopCat.Presheaf.algebra_section_stalk X.presheaf x
  have : IsScalarTower k Γ(X, U) D.localRing := isScalarTower_section_stalk sX U x
  have : IsScalarTower Γ(X, U) D.localRing
      (X.presheaf.stalk (componentGenericPoint X D.component)) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    simp_rw [RingHom.algebraMap_toAlgebra]
    change _ = (X.presheaf.germ U D.genericPoint hxU ≫ X.presheaf.stalkSpecializes _).hom
    rw [X.presheaf.germ_stalkSpecializes]
  have : IsLocalization (hU'.primeIdealOf x).asIdeal.primeCompl D.localRing :=
    hU'.isLocalization_stalk x
  obtain ⟨p, hp⟩ := hrange _ hgx
  obtain ⟨q, hq⟩ := hrange _ hginv
  have hpq : p * q = 1 := IsFractionRing.injective D.localRing
    (X.presheaf.stalk (componentGenericPoint X D.component))
    (by rw [map_mul, hp, hq, mul_inv_cancel₀ hg0, map_one])
  exact ordAt_eq_zero_of_forall_mem_range (B := Γ(X, U)) (A := D.localRing)
    (hU'.primeIdealOf x).asIdeal.primeCompl hs
    (fun a b ha hb => intValuation_mul D a b ha hb)
    (fun _ ha => intValuation_toComponent_of_isUnit D ha) b l hl
    (fun I => hrange _ (hc I)) (fun I => hrange _ (hl' I)) _
    ⟨p, isUnit_iff_exists_inv.mpr ⟨q, hpq⟩, hp⟩

/-- A rational `m`-canonical form on a normal Noetherian scheme of finite type over `k` has nonzero
order `v_D(ω)` along only finitely many prime divisors `D`. -/
theorem finite_ordComponentForm_ne_zero [CompactSpace X] [LocallyOfFiniteType sX]
    (ω : RationalComponentForms sX n m) :
    {D : Mori.PrimeDivisor X | ordComponentForm D ω ≠ 0}.Finite := by
  choose t ht0 ht using fun Z => exists_open_ordComponentForm_eq_zero ω Z
  have : AlgebraicGeometry.IsNoetherian X := ⟨⟩
  have : Finite (irreducibleComponents X) :=
    (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := X)).to_subtype
  have hfin : (⋃ Z, {z : X | z ∈ closure {componentGenericPoint X Z} ∧
      z ∉ t Z ∧ Order.coheight z = 1}).Finite :=
    Set.finite_iUnion fun Z => finite_coheight_eq_one_mem_closure_notMem _ _ (ht0 Z)
  refine Set.Finite.of_finite_image (hfin.subset ?_)
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective.injOn
  rintro - ⟨D, hD, rfl⟩
  refine Set.mem_iUnion.mpr ⟨D.component, ?_, fun hmem => hD ?_, D.coheight_genericPoint⟩
  · rw [(isGenericPoint_componentGenericPoint X D.component).def]
    exact D.genericPoint_mem_component
  · exact ht D.component D rfl hmem

/-- The *divisor* `div(ω) = ∑_D v_D(ω) D` of a rational `m`-canonical form `ω = (ω_α)` on a
normal Noetherian scheme of finite type over `k`, possibly disconnected (Kollár 1.6). -/
@[mmp "def_kr1c_divisor_of_rational_top_form"]
noncomputable def divisorOfComponentForm [CompactSpace X] [LocallyOfFiniteType sX]
    (ω : RationalComponentForms sX n m) : Divisor X :=
  Finsupp.ofSupportFinite (fun D => ordComponentForm D ω) (finite_ordComponentForm_ne_zero ω)

@[simp]
theorem divisorOfComponentForm_apply [CompactSpace X] [LocallyOfFiniteType sX]
    (ω : RationalComponentForms sX n m) (D : Mori.PrimeDivisor X) :
    divisorOfComponentForm ω D = ordComponentForm D ω :=
  rfl

end Forms

/-! ### Normal forms and monomial valuations in a two-dimensional regular local ring -/

section Local

variable {R : Type v} [CommRing R] [IsLocalRing R]

/-- An element `f` of a two-dimensional regular local ring `(R, 𝔪)` is *in normal form* with
respect to the regular system of parameters `(x, y)` if `f ∈ 𝔪^m ∖ 𝔪^{m+1}` and
`f ∈ (y^m) + 𝔪^{m+1}`, that is, the leading term of `f` is a unit times `y^m` (Kollár 1.10). -/
@[mmp "def_kr1c_normal_form"]
def IsInNormalForm (x y f : R) : Prop :=
  Ideal.span {x, y} = IsLocalRing.maximalIdeal R ∧
    ∃ m : ℕ, f ∈ IsLocalRing.maximalIdeal R ^ m ∧ f ∉ IsLocalRing.maximalIdeal R ^ (m + 1) ∧
      f ∈ Ideal.span {y ^ m} ⊔ IsLocalRing.maximalIdeal R ^ (m + 1)

end Local

section Monomial

variable {R : Type v} [CommRing R]

/-- The ideal `I_ν ⊆ R` generated by the monomials `x^i y^j` with `i + w j ≥ ν`. -/
@[mmp "def_kr1c_monomial_valuation"]
def monomialIdeal (x y : R) (w ν : ℕ) : Ideal R :=
  Ideal.span {r | ∃ i j : ℕ, ν ≤ i + w * j ∧ r = x ^ i * y ^ j}

/-- The *monomial valuation* `v_w(s) = sup {ν : s ∈ I_ν} ∈ ℕ ∪ {∞}` with respect to `(x, y)` and
the weight `w` (Kollár 1.10). -/
@[mmp "def_kr1c_monomial_valuation"]
noncomputable def monomialValuation (x y : R) (w : ℕ) (s : R) : ℕ∞ :=
  ⨆ (ν : ℕ) (_ : s ∈ monomialIdeal x y w ν), (ν : ℕ∞)

end Monomial

end MMP.Resolution
