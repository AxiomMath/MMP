/-! ### Countable algebraically closed subfields -/

/-- A countable subset of an algebraically closed field of characteristic zero is contained in a
countable algebraically closed subfield. -/
@[mmp "lem_mmp_countable_algebraic_subfield"]
theorem exists_countable_isAlgClosed_subfield_superset (k : Type*) [Field k]
    [IsAlgClosed k] [CharZero k] (T : Set k) (hT : T.Countable) :
    ∃ k₀ : Subfield k, T ⊆ k₀ ∧ (k₀ : Set k).Countable ∧ IsAlgClosed k₀ := by
  let F := Subfield.closure T
  have : Countable F := Cardinal.mk_le_aleph0_iff.mp <|
    (Subfield.cardinalMk_closure_le_max T).trans
      (max_le (Cardinal.mk_le_aleph0_iff.mpr hT.to_subtype) le_rfl)
  exact ⟨(algebraicClosure F k).toSubfield,
    fun x hx => (algebraicClosure F k).algebraMap_mem ⟨x, Subfield.subset_closure hx⟩,
    (Algebraic.countable F k).mono fun _ => mem_algebraicClosure_iff.mp,
    (IsAlgClosure.isAlgClosed F : IsAlgClosed (algebraicClosure F k))⟩

/-! ### Length of a cokernel over a discrete valuation ring -/

namespace IsDiscreteValuationRing

open Module

/-- A module of finite length over a discrete valuation ring is torsion. -/
private lemma isTorsion_of_isFiniteLength {A Q : Type*} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [AddCommGroup Q] [Module A Q] (hQ : IsFiniteLength A Q) :
    Module.IsTorsion A Q := by
  intro x
  by_contra! h
  have hinj : Function.Injective (LinearMap.toSpanSingleton A Q x) := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro c hc
    by_contra hc0
    exact h ⟨c, mem_nonZeroDivisors_of_ne_zero hc0⟩ hc
  have h1 := Module.length_le_of_injective _ hinj
  have h2 : Module.length A A = ⊤ := by
    rw [← Ring.ord_zero, Ring.ord_eq_addVal, AddValuation.map_zero]
  rw [h2, top_le_iff] at h1
  exact (Module.length_ne_top_iff.mpr hQ) h1

/-- The additive valuation of a finite product is the sum of the valuations. -/
private lemma addVal_prod {R Γ ι : Type*} [CommRing R] [LinearOrderedAddCommMonoidWithTop Γ]
    (v : AddValuation R Γ) (s : Finset ι) (f : ι → R) :
    v (∏ i ∈ s, f i) = ∑ i ∈ s, v (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert j s hj ih => rw [Finset.prod_insert hj, Finset.sum_insert hj, AddValuation.map_mul, ih]

/-- If the cokernel of `u` has finite length over a DVR, then `range u` has full rank. -/
private lemma finrank_range_eq_of_isFiniteLength {A M : Type*} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [AddCommGroup M] [Module A M] [Module.Free A M]
    [Module.Finite A M] {u : M →ₗ[A] M} (hu : IsFiniteLength A (M ⧸ LinearMap.range u)) :
    finrank A (LinearMap.range u) = finrank A M := by
  have := (LinearMap.range u).finrank_quotient_add_finrank
  rwa [Module.finrank_eq_zero_iff_isTorsion.mpr (isTorsion_of_isFiniteLength hu), zero_add]
    at this

/-- An endomorphism `u` of a finite free module whose range has full rank has determinant
equal, up to a unit, to the product of the Smith normal form coefficients of `range u`:
`u` is the diagonal map `diag a` composed with a surjective, hence bijective, endomorphism. -/
private lemma det_eq_prod_smithNormalFormCoeffs_mul_unit {A M : Type*} [CommRing A]
    [IsDomain A] [IsPrincipalIdealRing A] [AddCommGroup M] [Module A M] [Module.Free A M]
    [Module.Finite A M] {ι : Type*} [Fintype ι] (b : Basis ι A M) (u : M →ₗ[A] M)
    (hrank : finrank A (LinearMap.range u) = finrank A M) :
    ∃ c : Aˣ, LinearMap.det u = (∏ i, Submodule.smithNormalFormCoeffs b hrank i) * c := by
  classical
  set b' := Submodule.smithNormalFormTopBasis b hrank
  let e : M ≃ₗ[A] LinearMap.range u :=
    b'.equiv (Submodule.smithNormalFormBotBasis b hrank) (Equiv.refl _)
  let w : M →ₗ[A] M := e.symm.toLinearMap ∘ₗ u.rangeRestrict
  have hw : Function.Surjective w := e.symm.surjective.comp u.surjective_rangeRestrict
  have hu_eq : u = ((LinearMap.range u).subtype ∘ₗ e.toLinearMap) ∘ₗ w := by
    ext x
    simp [w]
  have hv : (LinearMap.range u).subtype ∘ₗ e.toLinearMap =
      Matrix.toLin b' b' (Matrix.diagonal (Submodule.smithNormalFormCoeffs b hrank)) := by
    refine b'.ext fun i => ?_
    simp only [e, LinearMap.comp_apply, LinearEquiv.coe_coe, Basis.equiv_apply, Equiv.refl_apply,
      Submodule.subtype_apply, Matrix.toLin_self, Matrix.diagonal_apply, ite_smul, zero_smul,
      Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    exact Submodule.smithNormalFormBotBasis_def b hrank i
  let we := LinearEquiv.ofBijective w
    ⟨OrzechProperty.injective_of_surjective_endomorphism w hw, hw⟩
  refine ⟨(LinearEquiv.isUnit_det' we).unit, ?_⟩
  conv_lhs => rw [hu_eq]
  rw [IsUnit.unit_spec, LinearMap.det_comp, hv, LinearMap.det_toLin, Matrix.det_diagonal]
  rfl

/-- **Length of a finite-length cokernel over a DVR.** Let `A` be a discrete valuation ring,
`M` a finite free `A`-module and `u : M →ₗ[A] M` an endomorphism whose cokernel has finite
length. Then `LinearMap.det u ≠ 0` and the length of `M ⧸ LinearMap.range u` is the valuation
`IsDiscreteValuationRing.addVal A (LinearMap.det u)`. -/
@[mmp "lem_mmp_dvr_finite_free_cokernel_length"]
theorem length_quotient_range_eq_addVal_det
    {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    {M : Type*} [AddCommGroup M] [Module A M] [Module.Free A M] [Module.Finite A M]
    (u : M →ₗ[A] M) (hu : IsFiniteLength A (M ⧸ LinearMap.range u)) :
    LinearMap.det u ≠ 0 ∧
      Module.length A (M ⧸ LinearMap.range u) =
        IsDiscreteValuationRing.addVal A (LinearMap.det u) := by
  classical
  have hrank := finrank_range_eq_of_isFiniteLength hu
  let b := Module.Free.chooseBasis A M
  obtain ⟨c, hdet⟩ := det_eq_prod_smithNormalFormCoeffs_mul_unit b u hrank
  have ha0 := Submodule.smithNormalFormCoeffs_ne_zero b hrank
  refine ⟨hdet ▸ mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun i _ => ha0 i) c.ne_zero, ?_⟩
  rw [((LinearMap.range u).quotientEquivPiSpan b hrank).length_eq, Module.length_pi_of_fintype,
    hdet, AddValuation.map_mul, IsDiscreteValuationRing.addVal_eq_zero_of_unit, add_zero,
    addVal_prod]
  simp_rw [← Ring.ord_eq_addVal]
  rfl

end IsDiscreteValuationRing

/-! ### Base change along an extension of an algebraically closed field -/

/-- For a flat morphism of schemes `r : A ⟶ B`, the local homomorphism of stalks
`𝒪_{B, r z} → 𝒪_{A, z}` is flat and local, hence faithfully flat. -/
private lemma faithfullyFlat_stalkMap {A B : Scheme.{u}} (r : A ⟶ B) [Flat r] (z : A) :
    letI := (r.stalkMap z).hom.toAlgebra
    Module.FaithfullyFlat (B.presheaf.stalk (r z)) (A.presheaf.stalk z) :=
  letI := (r.stalkMap z).hom.toAlgebra
  @Module.FaithfullyFlat.of_flat_of_isLocalHom _ _ _ _ _ _ _
    (Flat.stalkMap r z) (r.toLRSHom.prop z)

/-- A flat morphism of schemes induces injective maps of stalks. -/
private lemma stalkMap_injective_of_flat {A B : Scheme.{u}} (r : A ⟶ B) [Flat r] (z : A) :
    Function.Injective (r.stalkMap z).hom :=
  letI := (r.stalkMap z).hom.toAlgebra
  haveI := faithfullyFlat_stalkMap r z
  FaithfulSMul.algebraMap_injective (B.presheaf.stalk (r z)) (A.presheaf.stalk z)

/-- Normality of local rings descends along a flat morphism of schemes. -/
private lemma isNormalRing_stalk_of_flat {A B : Scheme.{u}} (r : A ⟶ B) [Flat r] (z : A)
    (h : IsNormalRing (A.presheaf.stalk z)) : IsNormalRing (B.presheaf.stalk (r z)) :=
  letI := (r.stalkMap z).hom.toAlgebra
  haveI := faithfullyFlat_stalkMap r z
  isDomain_and_isIntegrallyClosed_atPrime_of_faithfullyFlat h

/-- The Krull dimension of the image of an immersion is preserved by the preimage under the
projection of a base change along a field extension. -/
private lemma topologicalKrullDim_preimage_range {k₀ K : Type u} [Field k₀] [Field K]
    [Algebra k₀ K] {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of k₀)) {Y : Scheme.{u}}
    (i : Y ⟶ X) [IsImmersion i] [LocallyOfFiniteType i] [LocallyOfFiniteType f] :
    topologicalKrullDim
        ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k₀ K)))).base ⁻¹'
          Set.range i.base) =
      topologicalKrullDim (Set.range i.base) := by
  set g : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of k₀) :=
    Spec.map (CommRingCat.ofHom (algebraMap k₀ K))
  set p := pullback.fst f g
  have hP : IsPullback (pullback.snd p i) (pullback.fst p i ≫ pullback.snd f g) (i ≫ f) g :=
    (IsPullback.of_hasPullback p i).flip.paste_vert (IsPullback.of_hasPullback f g)
  have : LocallyOfFiniteType (i ≫ f) := MorphismProperty.comp_mem _ _ _ ‹_› ‹_›
  rw [← Scheme.Pullback.range_fst p i,
    ← (pullback.fst p i).isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq,
    ← i.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq]
  exact AlgebraicGeometry.topologicalKrullDim_baseChange k₀ K (pullback.snd p i) _ (i ≫ f) hP

/-- Every locally closed subset of a scheme is the image of an immersion. -/
private lemma exists_isImmersion_range_eq {X : Scheme.{u}} {Z : Set X} (hZ : IsLocallyClosed Z) :
    ∃ (Y : Scheme.{u}) (i : Y ⟶ X), IsImmersion i ∧ LocallyOfFiniteType i ∧
      Set.range i.base = Z := by
  obtain ⟨U, C, hU, hC, rfl⟩ := hZ
  let V : X.Opens := ⟨U, hU⟩
  let C' : TopologicalSpace.Closeds V.toScheme := ⟨V.ι.base ⁻¹' C, hC.preimage V.ι.continuous⟩
  let I := Scheme.IdealSheafData.vanishingIdeal C'
  have : LocallyOfFiniteType I.subschemeι := inferInstance
  have : LocallyOfFiniteType V.ι := inferInstance
  refine ⟨I.subscheme, I.subschemeι ≫ V.ι, inferInstance,
    MorphismProperty.comp_mem _ _ _ ‹_› ‹_›, ?_⟩
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
    Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
  change V.ι.base '' (V.ι.base ⁻¹' C) = U ∩ C
  rw [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι]
  exact Set.inter_comm _ _

/-- Reducedness, integrality and normality, irreducible components and dimensions of locally
closed subsets are invariant under base change of a scheme locally of finite type over an
algebraically closed field `k₀` to any extension field `K`. -/
@[mmp "lem_mmp_field_extension_geometric_invariants"]
theorem isReduced_isIntegral_isNormal_dim_baseChange_of_isAlgClosed
    {k₀ K : Type u} [Field k₀] [Field K] [Algebra k₀ K] [IsAlgClosed k₀]
    {X : Scheme.{u}} (f : X ⟶ Spec (CommRingCat.of k₀)) [LocallyOfFiniteType f] :
    let g : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of k₀) :=
      Spec.map (CommRingCat.ofHom (algebraMap k₀ K))
    let XK : Scheme.{u} := pullback f g
    let p : XK ⟶ X := pullback.fst f g
    (IsReduced X ↔ IsReduced XK) ∧
    (IsIntegral X ↔ IsIntegral XK) ∧
    (IsNormal X ↔ IsNormal XK) ∧
    Set.BijOn (fun Z : Set X => p.base ⁻¹' Z)
      (irreducibleComponents X) (irreducibleComponents XK) ∧
    ∀ Z : Set X, IsLocallyClosed Z →
      topologicalKrullDim (p.base ⁻¹' Z : Set XK) = topologicalKrullDim Z := by
  intro g XK p
  have hsurj : Function.Surjective p.base := (pullback.fst f g).surjective
  have hred : IsReduced X ↔ IsReduced XK := by
    constructor
    · intro _
      have := geometricallyReduced_of_isReduced f
      exact GeometricallyReduced.geometrically_isReduced (f := f) _ _ _
        (IsPullback.of_hasPullback _ _)
    · intro _
      refine @isReduced_of_isReduced_stalk _ fun x => ?_
      obtain ⟨y, rfl⟩ := hsurj x
      exact isReduced_of_injective _ (stalkMap_injective_of_flat p y)
  have hirr : IrreducibleSpace X ↔ IrreducibleSpace XK := by
    constructor
    · intro _
      have := geometricallyIrreducible_of_irreducibleSpace_of_isSepClosed k₀ X f
      exact GeometricallyIrreducible.geometrically_irreducibleSpace (f := f) _ _ _
        (IsPullback.of_hasPullback _ _)
    · intro h
      rw [irreducibleSpace_def, Set.top_eq_univ, ← Set.image_univ_of_surjective hsurj]
      exact (IrreducibleSpace.isIrreducible_univ XK).image _ p.continuous.continuousOn
  refine ⟨hred, ?_, ?_, ?_, ?_⟩
  · rw [isIntegral_iff_irreducibleSpace_and_isReduced,
      isIntegral_iff_irreducibleSpace_and_isReduced, hred, hirr]
  · refine ⟨fun _ => (isNormal_iff_stalk_isNormalRing XK).2 fun y =>
      isGeometricallyNormal_of_isNormal_of_perfectField k₀ f (p.base y) K y rfl, fun h => ?_⟩
    rw [isNormal_iff_stalk_isNormalRing] at h ⊢
    intro x
    obtain ⟨y, rfl⟩ := hsurj x
    exact isNormalRing_stalk_of_flat p y (h y)
  · have : Algebra.IsGeometricallyIrreducible k₀ K :=
      (Algebra.isGeometricallyIrreducible_iff_irreducibleSpace_primeSpectrum k₀ K).mpr
        inferInstance
    let e := Scheme.Hom.irreducibleComponentsEquiv (pullback.fst f g)
      (pullback.fst f g).isOpenMap
    exact Set.InvOn.bijOn (f' := (p.base '' ·))
      ⟨fun Z _ => Set.image_preimage_eq _ hsurj,
        fun W hW => congrArg Subtype.val (e.symm_apply_apply ⟨_, hW⟩)⟩
      (fun Z hZ => (e.symm ⟨_, hZ⟩).2) (fun W hW => (e ⟨_, hW⟩).2)
  · intro Z hZ
    obtain ⟨Y, i, _, _, rfl⟩ := exists_isImmersion_range_eq hZ
    exact topologicalKrullDim_preimage_range f i

/-! ### Smoothness and regularity over a perfect field -/

/-- Over a perfect field, a point lies in the smooth locus exactly when its local ring is
regular. -/
private lemma mem_smoothLocus_iff_isRegularLocalRing {k : Type u} [Field k] [PerfectField k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [LocallyOfFinitePresentation f] (x : X) :
    x ∈ f.smoothLocus ↔ IsRegularLocalRing (X.presheaf.stalk x) :=
  Scheme.Hom.mem_smoothLocus.trans <|
    (Iff.intro (InfinitesimalLifting.formallySmooth_stalkMap_smoothAt f x)
      (InfinitesimalLifting.SmoothAt.formallySmooth_stalkMap f x)).trans
    (Set.ext_iff.mp (smoothAt_locus_eq_regular_locus k f) x)

/-- Over a perfect field, a scheme locally of finite type is smooth at a point if and only if
its local ring there is regular; hence it is smooth if and only if all its local rings are
regular. -/
@[mmp "lem_mmp_foundation_regular_smooth_perfect_dictionary"]
theorem mem_smoothLocus_iff_isRegularLocalRing_of_perfectField
    {k : Type u} [Field k] [PerfectField k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [LocallyOfFinitePresentation f] :
    (∀ x : X, x ∈ f.smoothLocus ↔ IsRegularLocalRing (X.presheaf.stalk x)) ∧
      (Smooth f ↔ ∀ x : X, IsRegularLocalRing (X.presheaf.stalk x)) := by
  refine ⟨mem_smoothLocus_iff_isRegularLocalRing f, ?_⟩
  simp only [← Scheme.Hom.smoothLocus_eq_top_iff, ← mem_smoothLocus_iff_isRegularLocalRing f,
    eq_top_iff]
  exact ⟨fun h x => h trivial, fun h x _ => h x⟩

/-! ### Upper semicontinuity of the order of an ideal sheaf -/

namespace Resolution

/-- A derivation sends `P ^ (s + 1)` into `P ^ s`. -/
private theorem derivation_mem_pow {A₀ R : Type*} [CommRing A₀] [CommRing R] [Algebra A₀ R]
    (δ : Derivation A₀ R R) (P : Ideal R) (s : ℕ) {a : R} (ha : a ∈ P ^ (s + 1)) :
    δ a ∈ P ^ s := by
  induction s generalizing a with
  | zero => simp
  | succ s ih =>
    rw [pow_succ] at ha
    refine Submodule.mul_induction_on ha (fun b hb c hc => ?_) (fun b c hb hc => ?_)
    · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hb) ?_
      rw [pow_succ']
      exact Ideal.mul_mem_mul hc (ih hb)
    · rw [map_add]; exact Ideal.add_mem _ hb hc

/-- In the localization at a prime `P`, a derivation of `R` lowers the order by at most one. -/
private theorem derivation_algebraMap_mem_pow {A₀ R S : Type*} [CommRing A₀] [CommRing R]
    [Algebra A₀ R] [CommRing S] [Algebra R S] (P : Ideal R) [P.IsPrime]
    [IsLocalization.AtPrime S P] (δ : Derivation A₀ R R) (s : ℕ) {f : R}
    (hf : algebraMap R S f ∈ (P.map (algebraMap R S)) ^ (s + 1)) :
    algebraMap R S (δ f) ∈ (P.map (algebraMap R S)) ^ s := by
  rw [← Ideal.map_pow] at hf ⊢
  obtain ⟨v, hv, hvf⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl S _ f).mp hf
  have h1 := derivation_mem_pow δ P s hvf
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul] at h1
  rw [← Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units S (⟨v, hv⟩ : P.primeCompl)),
    ← map_mul, show v * δ f = (v * δ f + f * δ v) - f * δ v by ring, map_sub, map_mul]
  exact Ideal.sub_mem _ (Ideal.mem_map_of_mem _ h1) (Ideal.mul_mem_right _ _
    (Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ s)) hf))

/-- A derivative ideal `D(J)` has order at least one less than `J` at every point. -/
private theorem stalk_derivativeIdeal_le {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (J : X.IdealSheafData) (x : X) (s : ℕ)
    (h : IdealSheafData.stalk J x ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ (s + 1)) :
    IdealSheafData.stalk (derivativeIdeal sX J) x ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ s := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hx, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let U' : X.affineOpens := ⟨U, hU⟩
  rw [IdealSheafData.stalk_eq_map_germ J x U' hx] at h
  rw [IdealSheafData.stalk_eq_map_germ _ x U' hx, derivativeIdeal_ideal,
    sectionDerivativeIdeal, derivativeIdealOfRing, Ideal.map_span, Ideal.span_le]
  letI := MMP.Mori.sectionAlgebra sX U
  rintro _ ⟨_, ⟨δ, f, hf, rfl⟩, rfl⟩
  letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
  haveI := hU.isLocalization_stalk ⟨x, hx⟩
  have hm := IsLocalization.AtPrime.map_eq_maximalIdeal (hU.primeIdealOf ⟨x, hx⟩).asIdeal
    (X.presheaf.stalk x)
  have hf' : algebraMap Γ(X, U) (X.presheaf.stalk x) f ∈
      ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.map (algebraMap Γ(X, U) (X.presheaf.stalk x))) ^
        (s + 1) := by
    rw [hm]; exact h (Ideal.mem_map_of_mem _ hf)
  have := derivation_algebraMap_mem_pow _ δ s hf'
  rwa [hm] at this

/-- The order of `I` at `x` exceeds that of `D^n(I)` by at least `n`. -/
private theorem stalk_higherDerivativeIdeal_le {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (I : X.IdealSheafData) (x : X) (n : ℕ) :
    ∀ s : ℕ, IdealSheafData.stalk I x ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ (n + s) →
      IdealSheafData.stalk (higherDerivativeIdeal sX I n) x ≤
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ s := by
  induction n with
  | zero => intro s h; rw [higherDerivativeIdeal_zero]; simpa using h
  | succ n ih =>
    intro s h
    rw [higherDerivativeIdeal_succ]
    exact stalk_derivativeIdeal_le sX _ x s (ih (s + 1) (by rwa [← add_assoc, add_right_comm]))

private theorem sum_smul_derivation_apply {A₀ A : Type*} [CommRing A₀] [CommRing A]
    [Algebra A₀ A] {d : ℕ} (s : Fin d → A) (δ : Fin d → Derivation A₀ A A) (a : A) :
    (∑ i, s i • δ i) a = ∑ i, s i * δ i a := by
  rw [← Derivation.coeFnAddMonoidHom_apply, map_sum]; simp

/-- The Euler derivation `∑ sᵢ δᵢ` takes values in the ideal `(s_1, …, s_d)`. -/
private theorem sum_smul_derivation_mem_span {A₀ A : Type*} [CommRing A₀] [CommRing A]
    [Algebra A₀ A] {d : ℕ} (s : Fin d → A) (δ : Fin d → Derivation A₀ A A) (a : A) :
    (∑ i, s i • δ i) a ∈ Ideal.span (Set.range s) := by
  rw [sum_smul_derivation_apply]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- For derivations `δᵢ` dual to `s_j`, the Euler derivation `E = ∑ sᵢ δᵢ` acts on `J ^ c` as
multiplication by `c` modulo `J ^ (c + 1)`, where `J = (s_1, …, s_d)`. -/
private theorem euler_sub_mem_pow {A₀ A : Type*} [CommRing A₀] [CommRing A] [Algebra A₀ A]
    {d : ℕ} (s : Fin d → A) (δ : Fin d → Derivation A₀ A A)
    (hδ : ∀ i j, δ i (s j) = if i = j then 1 else 0) (c : ℕ) {g : A}
    (hg : g ∈ Ideal.span (Set.range s) ^ c) :
    (∑ i, s i • δ i) g - c * g ∈ Ideal.span (Set.range s) ^ (c + 1) := by
  set J := Ideal.span (Set.range s)
  have hE := sum_smul_derivation_mem_span s δ
  set E := ∑ i, s i • δ i
  have h1 : ∀ h ∈ J, E h - h ∈ J ^ 2 := by
    intro h hh
    induction hh using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, rfl⟩ := hx
      have : E (s j) = s j := by
        simp [E, sum_smul_derivation_apply, hδ]
      simp [this]
    | zero => simp
    | add x y _ _ hx hy => rw [map_add, add_sub_add_comm]; exact Ideal.add_mem _ hx hy
    | smul a x hx ihx =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul,
        show a * E x + x * E a - a * x = a * (E x - x) + x * E a by ring]
      refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ ihx) ?_
      rw [pow_two]; exact Ideal.mul_mem_mul hx (hE a)
  induction c generalizing g with
  | zero => simpa using hE g
  | succ c ih =>
    rw [pow_succ] at hg
    refine Submodule.mul_induction_on hg (fun a ha b hb => ?_) (fun a b ha hb => ?_)
    · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul,
        show a * E b + b * E a - ((c + 1 : ℕ) : A) * (a * b) =
          b * (E a - c * a) + a * (E b - b) by push_cast; ring]
      refine Ideal.add_mem _ ?_ ?_
      · rw [pow_succ, mul_comm]; exact Ideal.mul_mem_mul hb (ih ha)
      · rw [show c + 1 + 1 = c + 2 by ring, pow_add]; exact Ideal.mul_mem_mul ha (h1 b hb)
    · rw [map_add, mul_add, add_sub_add_comm]; exact Ideal.add_mem _ ha hb

/-- The Euler identity of `euler_sub_mem_pow` after localising at a prime `P` whose extension is
generated by the `s_j`. -/
private theorem euler_sub_mem_pow_localization {A₀ A S : Type*} [CommRing A₀] [CommRing A]
    [Algebra A₀ A] [CommRing S] [Algebra A S] (P : Ideal A) [P.IsPrime]
    [IsLocalization.AtPrime S P] {d : ℕ} (s : Fin d → A) (δ : Fin d → Derivation A₀ A A)
    (hδ : ∀ i j, δ i (s j) = if i = j then 1 else 0)
    (hs : (Ideal.span (Set.range s)).map (algebraMap A S) = P.map (algebraMap A S))
    (c : ℕ) {g : A} (hg : algebraMap A S g ∈ (P.map (algebraMap A S)) ^ c) :
    algebraMap A S ((∑ i, s i • δ i) g) - c * algebraMap A S g ∈
      (P.map (algebraMap A S)) ^ (c + 1) := by
  set J := Ideal.span (Set.range s)
  set E := ∑ i, s i • δ i
  rw [← hs, ← Ideal.map_pow] at hg ⊢
  obtain ⟨v, hv, hvg⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl S _ g).mp hg
  have h1 := Ideal.mem_map_of_mem (algebraMap A S) (euler_sub_mem_pow s δ hδ c hvg)
  have h2 : algebraMap A S g * algebraMap A S (E v) ∈ (J ^ (c + 1)).map (algebraMap A S) := by
    rw [Ideal.map_pow, pow_succ, ← Ideal.map_pow]
    exact Ideal.mul_mem_mul hg (Ideal.mem_map_of_mem _ (sum_smul_derivation_mem_span s δ v))
  rw [← Ideal.unit_mul_mem_iff_mem _ (IsLocalization.map_units S (⟨v, hv⟩ : P.primeCompl)),
    show algebraMap A S v * (algebraMap A S (E g) - c * algebraMap A S g) =
      algebraMap A S (E (v * g) - c * (v * g)) - algebraMap A S g * algebraMap A S (E v) by
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]; simp; ring]
  exact Ideal.sub_mem _ h1 h2

/-- **Derivatives detect the order.** If `f` has order exactly `n` at `P` (in the localization),
some word of length `n` in derivations dual to generators of `P` takes `f` to a unit at `P`; so
the `n`-th derivative ideal of any ideal containing `f` is not contained in `P`. -/
private theorem exists_mem_higherDerivativeIdealOfRing_notMem {A₀ A S : Type*} [CommRing A₀]
    [CommRing A] [Algebra A₀ A] [CommRing S] [Algebra A S] (P : Ideal A) [P.IsPrime]
    [IsLocalization.AtPrime S P] {d : ℕ} (s : Fin d → A) (δ : Fin d → Derivation A₀ A A)
    (hδ : ∀ i j, δ i (s j) = if i = j then 1 else 0)
    (hs : (Ideal.span (Set.range s)).map (algebraMap A S) = P.map (algebraMap A S))
    (hunit : ∀ n : ℕ, IsUnit ((n + 1 : ℕ) : S)) (n : ℕ) :
    ∀ (K : Ideal A) (f : A), f ∈ K → algebraMap A S f ∈ (P.map (algebraMap A S)) ^ n →
      algebraMap A S f ∉ (P.map (algebraMap A S)) ^ (n + 1) →
      ∃ g ∈ higherDerivativeIdealOfRing A₀ K n, algebraMap A S g ∉ P.map (algebraMap A S) := by
  set M := P.map (algebraMap A S)
  induction n with
  | zero => intro K f hf _ hf'; exact ⟨f, hf, by simpa using hf'⟩
  | succ n ih =>
    intro K f hfK hf hf'
    have hsM : ∀ i, algebraMap A S (s i) ∈ M := fun i =>
      hs ▸ Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
    have : ∃ i, algebraMap A S (δ i f) ∉ M ^ (n + 1) := by
      by_contra hcon
      simp only [not_exists, not_not] at hcon
      have hEf : algebraMap A S ((∑ i, s i • δ i) f) ∈ M ^ (n + 1 + 1) := by
        rw [sum_smul_derivation_apply, map_sum]
        refine Ideal.sum_mem _ fun i _ => ?_
        rw [map_mul, pow_succ']
        exact Ideal.mul_mem_mul (hsM i) (hcon i)
      have h := Ideal.sub_mem _ hEf (euler_sub_mem_pow_localization P s δ hδ hs (n + 1) hf)
      rw [sub_sub_cancel] at h
      exact hf' ((Ideal.unit_mul_mem_iff_mem _ (hunit n)).mp h)
    obtain ⟨i, hi⟩ := this
    have hi' := derivation_algebraMap_mem_pow P (δ i) n hf
    obtain ⟨g, hg, hgM⟩ := ih (derivativeIdealOfRing A₀ K) (δ i f)
      (Ideal.subset_span ⟨δ i, f, hfK, rfl⟩) hi' hi
    exact ⟨g, by rw [higherDerivativeIdealOfRing, Function.iterate_succ_apply]; exact hg, hgM⟩

/-- The sections of `D^n(I)` over an affine open are the `n`-th derivative ideal of `I(W)`. -/
theorem higherDerivativeIdeal_ideal {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (I : X.IdealSheafData)
    (W : X.affineOpens) (n : ℕ) :
    (higherDerivativeIdeal sX I n).ideal W =
      (letI := MMP.Mori.sectionAlgebra sX W.1; higherDerivativeIdealOfRing k (I.ideal W) n) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [higherDerivativeIdeal_succ, derivativeIdeal_ideal, sectionDerivativeIdeal, ih]
    exact (Function.iterate_succ_apply' _ _ _).symm

/-- If `I` has finite order `b` at `x` on a scheme smooth over a field of characteristic zero,
then `D^b(I)` is the unit ideal at `x`. -/
theorem stalk_higherDerivativeIdeal_eq_top_of_multAt_eq {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] (I : X.IdealSheafData)
    (x : X) (b : ℕ) (hb : multAt I x = b) :
    IdealSheafData.stalk (higherDerivativeIdeal sX I b) x = ⊤ := by
  classical
  let := MMP.Mori.stalkAlgebra sX x
  obtain ⟨_, _, _⟩ := MMP.Flips.ResolutionInputs.stalk_facts sX x
  haveI : IsRegularLocalRing (X.presheaf.stalk x) :=
    (mem_smoothLocus_iff_isRegularLocalRing_of_perfectField sX).2.1 inferInstance x
  obtain ⟨d, t, ht⟩ := MMP.Mori.exists_isRegularSystemOfParameters (X.presheaf.stalk x)
  have : Algebra.EssFiniteType k (IsLocalRing.ResidueField (X.presheaf.stalk x)) :=
    Algebra.EssFiniteType.of_surjective
      (IsScalarTower.toAlgHom k (X.presheaf.stalk x)
        (IsLocalRing.ResidueField (X.presheaf.stalk x)))
      IsLocalRing.residue_surjective
  have : Algebra.FormallySmooth k (IsLocalRing.ResidueField (X.presheaf.stalk x)) :=
    Algebra.FormallySmooth.of_perfectField
  obtain ⟨ht0, hli, -⟩ := MMP.Flips.ResolutionInputs.cotangent_basis_of_regular t ht.1 ht.2
  have hli' := MMP.Flips.ResolutionInputs.linearIndependent_tmul_D k t ht0 hli
  have : Module.Projective (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄k] :=
    ((Algebra.formallySmooth_iff _ _).mp ‹_›).1
  have : Module.Flat (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄k] := Module.Flat.of_projective
  obtain ⟨e, v, hvS, hvli, hvsp⟩ := MMP.Flips.ResolutionInputs.exists_sumElim_basis _ hli' _
    (MMP.Flips.ResolutionInputs.span_tmul_range_D k)
  choose r hr using hvS
  have hu : (TensorProduct.mk (X.presheaf.stalk x)
      (IsLocalRing.ResidueField (X.presheaf.stalk x)) Ω[X.presheaf.stalk x⁄k] 1 ∘
        fun i => KaehlerDifferential.D k (X.presheaf.stalk x) (Sum.elim t r i)) =
      Sum.elim (fun i => (1 : IsLocalRing.ResidueField (X.presheaf.stalk x)) ⊗ₜ
          KaehlerDifferential.D k (X.presheaf.stalk x) (t i)) v := by
    funext i
    cases i with
    | inl i => rfl
    | inr j => exact hr j
  have hbij : Function.Bijective (Finsupp.linearCombination (X.presheaf.stalk x)
      (fun i => KaehlerDifferential.D k (X.presheaf.stalk x) (Sum.elim t r i))) := by
    apply Module.IsLocalRing.linearCombination_bijective_of_flat
    rw [hu]
    refine ⟨hvli, ?_⟩
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination]
    exact top_le_iff.mp hvsp
  obtain ⟨V, hV, hxV, y, hy, hbas⟩ :=
    MMP.Flips.ResolutionInputs.exists_affineOpen_basis_of_bijective sX x _ hbij
  obtain ⟨B, hB⟩ := hbas V hV le_rfl
  letI := MMP.Mori.sectionAlgebra sX V
  let δ : Fin d → Derivation k Γ(X, V) Γ(X, V) := fun i =>
    (B.coord (Sum.inl i)).compDer (KaehlerDifferential.D k Γ(X, V))
  have hδ : ∀ i j, δ i (y (Sum.inl j)) = if i = j then 1 else 0 := by
    intro i j
    have e1 := hB (Sum.inl j)
    rw [MMP.Flips.ResolutionInputs.presheaf_map_homOfLE_self] at e1
    change B.coord (Sum.inl i) (KaehlerDifferential.D k Γ(X, V) (y (Sum.inl j))) = _
    rw [← e1, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    simp [eq_comm]
  letI : Algebra Γ(X, V) (X.presheaf.stalk x) := (X.presheaf.germ V x hxV).hom.toAlgebra
  haveI := hV.isLocalization_stalk ⟨x, hxV⟩
  set P := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
  have hm := IsLocalization.AtPrime.map_eq_maximalIdeal P (X.presheaf.stalk x)
  have hs : (Ideal.span (Set.range fun j => y (Sum.inl j))).map
      (algebraMap Γ(X, V) (X.presheaf.stalk x)) =
      P.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) := by
    rw [hm, Ideal.map_span, ← ht.1, ← Set.range_comp]
    congr 2
    funext j
    exact hy (Sum.inl j)
  have hunit : ∀ n : ℕ, IsUnit ((n + 1 : ℕ) : X.presheaf.stalk x) := fun n => by
    rw [← map_natCast (algebraMap k (X.presheaf.stalk x))]
    exact (isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 (Nat.succ_ne_zero n))).map _
  have hstalk := IdealSheafData.stalk_eq_map_germ I x ⟨V, hV⟩ hxV
  have hle : IdealSheafData.stalk I x ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ b := by
    rw [← natCast_le_idealOrder_iff', ← multAt, hb]
  have hnle : ¬ IdealSheafData.stalk I x ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ (b + 1) := by
    rw [← natCast_le_idealOrder_iff', ← multAt, hb]
    exact_mod_cast (Nat.lt_succ_self b).not_ge
  rw [hstalk] at hle hnle
  rw [Ideal.map_le_iff_le_comap] at hle hnle
  obtain ⟨f, hfI, hf⟩ := Set.not_subset.1 hnle
  rw [← hm] at hle hf
  obtain ⟨g, hg, hgM⟩ := exists_mem_higherDerivativeIdealOfRing_notMem (A₀ := k) P
    (fun j => y (Sum.inl j)) δ hδ hs hunit b (I.ideal ⟨V, hV⟩) f hfI (hle hfI) hf
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨V, hV⟩ hxV]
  by_contra hne
  apply hgM
  rw [hm]
  refine IsLocalRing.le_maximalIdeal hne (Ideal.mem_map_of_mem _ ?_)
  rw [higherDerivativeIdeal_ideal]
  exact hg

/-- **Pointwise characterisation of the order locus.** On a scheme smooth over a field of
characteristic zero, `ord_x I ≥ n + 1` iff `x` lies on the cosupport of `D^j(I)` for every
`j ≤ n`. -/
theorem succ_le_multAt_iff_forall_mem_support {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] (I : X.IdealSheafData) (n : ℕ)
    (x : X) :
    ((n + 1 : ℕ) : ℕ∞) ≤ multAt I x ↔
      ∀ j ≤ n, x ∈ ((higherDerivativeIdeal sX I j).support : Set X) := by
  constructor
  · intro h j hj
    rw [multAt, natCast_le_idealOrder_iff'] at h
    by_contra hx
    have htop := (IdealSheafData.stalk_eq_top_iff_notMem_support _ x).2 hx
    have hle := stalk_higherDerivativeIdeal_le sX I x j (n + 1 - j)
      (by rwa [Nat.add_sub_cancel' (by omega)])
    rw [htop, top_le_iff] at hle
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (top_le_iff.1 (hle.ge.trans (Ideal.pow_le_self (by omega))))
  · intro h
    by_contra hlt
    rw [not_le] at hlt
    obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.1 (hlt.trans (ENat.coe_lt_top _)).ne
    have hbn : b ≤ n := by
      have : (b : ℕ∞) < ((n + 1 : ℕ) : ℕ∞) := hb ▸ hlt
      exact Nat.lt_succ_iff.1 (Nat.cast_lt.1 this)
    exact (IdealSheafData.stalk_eq_top_iff_notMem_support _ x).1
      (stalk_higherDerivativeIdeal_eq_top_of_multAt_eq sX I x b hb.symm) (h b hbn)

/-- The locus `{x | n ≤ ord_x I}` for a finite threshold `n` is the intersection of the
cosupports of the derivative ideals `D^j(I)`, `j < n`, hence closed. -/
private theorem isClosed_setOf_natCast_le_multAt {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] (I : X.IdealSheafData) (n : ℕ) :
    IsClosed {x : X | (n : ℕ∞) ≤ multAt I x} := by
  rcases n with _ | n
  · simp only [Nat.cast_zero, zero_le, Set.setOf_true]
    exact isClosed_univ
  · have : {x : X | ((n + 1 : ℕ) : ℕ∞) ≤ multAt I x} =
        ⋂ j ∈ Finset.range (n + 1), ((higherDerivativeIdeal sX I j).support : Set X) := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_iInter, Finset.mem_range, Nat.lt_succ_iff]
      exact succ_le_multAt_iff_forall_mem_support sX I n x
    exact this ▸ isClosed_biInter fun j _ => (higherDerivativeIdeal sX I j).support.isClosed

/-- **Upper semicontinuity of the order.** For `X` smooth over a field `k` of characteristic
zero and an ideal sheaf `I` on `X`, the locus of points `x` (arbitrary scheme points) at which
`ord_x I ≥ r` is closed. -/
@[mmp "lem_mmp_foundation_char_zero_order_upper_semicontinuous"]
theorem isClosed_setOf_le_multAt {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] (I : X.IdealSheafData) (r : ℕ∞) :
    IsClosed {x : X | r ≤ multAt I x} := by
  induction r using ENat.recTopCoe with
  | top =>
    have : {x : X | ⊤ ≤ multAt I x} = ⋂ n : ℕ, {x : X | (n : ℕ∞) ≤ multAt I x} := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_iInter]
      exact ⟨fun h n => le_top.trans h,
        fun h => (ENat.forall_natCast_le_iff_le (m := ⊤)).1 fun a _ => h a⟩
    rw [this]
    exact isClosed_iInter fun n => isClosed_setOf_natCast_le_multAt sX I n
  | coe n => exact isClosed_setOf_natCast_le_multAt sX I n

end Resolution

/-! ### Ample multiples absorb Cartier twists -/

namespace Mori

open Stacks.Ample Stacks.RelativeVeryAmple

/-- The twist `𝒪_X(E) ⊗ 𝒪_X(L)^{⊗ n}` is `𝒪_X(nL + E)`. -/
private noncomputable def twistIso {X : Scheme.{u}} (L E : X.CartierDivisor) :
    (n : ℕ) → tensorModules X (MMP.CartierDivisor.sheaf E)
      (tensorPowModule X (CartierDivisor.sheaf L) (n : ℤ)) ≅ CartierDivisor.sheaf (n • L + E)
  | 0 => tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _) ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _ ≪≫ eqToIso (by simp)
  | n + 1 =>
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleCongr X _ (by push_cast; ring) ≪≫
          (tensorPowModuleAddIso X _ (n : ℤ) 1).symm ≪≫
          tensorModulesMapIso X (Iso.refl _) (tensorPowModuleOneIso X _)) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _).symm ≪≫
      tensorModulesMapIso X (twistIso L E n) (Iso.refl _) ≪≫
      MMP.CartierDivisorSheaf.sheafMulIso (n • L + E) L ≪≫ eqToIso (by rw [succ_nsmul]; abel_nf)

/-- `(𝒪_X(E) ⊗ 𝒪_X(L)^{⊗ j}) ⊗ 𝒪_X(L)^{⊗ k}` is `𝒪_X((j + k)L + E)`. -/
private noncomputable def splitIso {X : Scheme.{u}} (L E : X.CartierDivisor) (j k : ℕ) :
    tensorModules X (tensorModules X (MMP.CartierDivisor.sheaf E)
        (tensorPowModule X (MMP.CartierDivisor.sheaf L) (j : ℤ)))
      (tensorPowModule X (MMP.CartierDivisor.sheaf L) (k : ℤ)) ≅
      MMP.CartierDivisor.sheaf ((j + k) • L + E) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫
        tensorPowModuleCongr X _ (by push_cast; ring)) ≪≫
    twistIso L E (j + k)

/-- If `t` is a section of `𝒪_X(E) ⊗ 𝒪_X(L)^{⊗ j}` not vanishing at `x`, and `s` is a section
of `𝒪_X(L)^{⊗ k}` whose nonvanishing locus is an affine open `U ∋ x`, then the section `t ⊗ s`
of `𝒪_X((j + k)L + E)` does not vanish at `x` and its nonvanishing locus `X_t ∩ U` is affine. -/
private theorem exists_affine_nonvanishing_tensor {X : Scheme.{u}} (L E : X.CartierDivisor)
    (j k : ℕ)
    (t : (tensorModules X (MMP.CartierDivisor.sheaf E)
      (tensorPowModule X (MMP.CartierDivisor.sheaf L) (j : ℤ))).sections)
    (s : Γ(tensorPowModule X (MMP.CartierDivisor.sheaf L) (k : ℤ), ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(MMP.CartierDivisor.sheaf ((j + k) • L + E), ⊤),
      x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  let G := tensorModules X (MMP.CartierDivisor.sheaf E)
    (tensorPowModule X (MMP.CartierDivisor.sheaf L) (j : ℤ))
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap (splitIso L E j k).hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus (MMP.CartierDivisor.sheaf ((j + k) • L + E)) (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso (splitIso L E j k) (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- If `L` is a Cartier divisor on `X` with `𝒪_X(L)` ample and `E` is any Cartier divisor, then
`𝒪_X(mL + E)` is ample for all sufficiently large `m`. -/
@[mmp "lem_mmp_foundation_eventual_ample_cartier_twist"]
theorem eventually_isAmple_cartierSheaf_nsmul_add {X : Scheme.{u}}
    (L E : X.CartierDivisor)
    (hL : Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf L)) :
    ∀ᶠ m : ℕ in Filter.atTop,
      Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf (m • L + E)) := by
  have : SheafOfModules.IsFiniteType.{u, u, u} (MMP.CartierDivisor.sheaf E) := by
    haveI := MMP.CartierDivisor.isFinitePresentation_sheaf E
    exact SheafOfModules.instIsFiniteTypeOfIsFinitePresentation _
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 (MMP.CartierDivisor.sheaf E) inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X (MMP.CartierDivisor.sheaf E)
    (tensorPowModule X (MMP.CartierDivisor.sheaf L) (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X (MMP.CartierDivisor.sheaf E)
    (tensorPowModule X (MMP.CartierDivisor.sheaf L) (j : ℤ))
  haveI : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor L E j (k y) _ (s y) (U y) (hUs y) (hUaff y) ha hxy

/-! ### Depth and Cohen–Macaulay modules -/

open IsLocalRing RingTheory.Sequence

section Depth

variable {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
  {N : Type*} [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial N]

/-- By Nakayama, a weakly regular sequence in the maximal ideal is regular, so `localDepth` is
the `𝔪`-depth `Module.depthSup`. -/
private lemma localDepth_eq_depthSup :
    localDepth R N = Module.depthSup R (maximalIdeal R) N := by
  rw [localDepth, Module.depthSup_eq_iSup]
  congr! 3 with xs
  exact and_congr_right fun h => (isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal h).symm

/-- For a nontrivial finite module, `localDepth` is the `𝔪`-depth `Module.depth`. -/
private lemma localDepth_eq_depth : localDepth R N = Module.depth R (maximalIdeal R) N := by
  rw [Module.depth, if_neg (Module.maximalIdeal_smul_top_ne_top N), localDepth_eq_depthSup,
    Module.depthSup_eq_iSup]

/-- The depth of a nontrivial finite module is attained by a regular sequence, since it is
bounded by the finite dimension of the support. -/
private lemma exists_isRegularSequence_length_eq_localDepth :
    ∃ xs : List R, IsRegularSequence R N xs ∧ (xs.length : ℕ∞) = localDepth R N := by
  obtain ⟨e, he⟩ := exists_supportDim_eq_natCast R N
  have hlt : Module.depthSup R (maximalIdeal R) N < ⊤ :=
    (WithBot.coe_le_coe.mp (he ▸ depth_le_supportDim)).trans_lt (ENat.coe_lt_top e)
  have : Nonempty {n : ℕ∞ | ∃ rs : List R, rs.length = n ∧
      (∀ r ∈ rs, r ∈ maximalIdeal R) ∧ IsRegular N rs} :=
    ⟨⟨0, [], rfl, by simp, (isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal
      (by simp)).2 (IsWeaklyRegular.nil R N)⟩⟩
  obtain ⟨xs, hlen, hmem, hreg⟩ := ENat.sSup_mem_of_nonempty_of_lt_top hlt
  exact ⟨xs, ⟨hmem, hreg.toIsWeaklyRegular⟩, hlen.trans localDepth_eq_depthSup.symm⟩

private lemma isCMModule_iff_localDepth_eq_supportDim :
    IsCMModule R N ↔ (localDepth R N : WithBot ℕ∞) = Module.supportDim R N := by
  constructor
  · rintro (h | ⟨xs, hxs, hlen⟩)
    · exact absurd h (not_subsingleton N)
    exact le_antisymm (localDepth_eq_depthSup (R := R) (N := N) ▸ depth_le_supportDim)
      (hlen ▸ WithBot.coe_le_coe.mpr hxs.length_le_localDepth)
  · intro h
    obtain ⟨xs, hxs, hlen⟩ := exists_isRegularSequence_length_eq_localDepth (R := R) (N := N)
    exact Or.inr ⟨xs, hxs, by rw [hlen, h]⟩

end Depth

/-- Let `R` be a Noetherian local ring and `N` a nonzero finite `R`-module. Then `N` is
Cohen–Macaulay in the regular-sequence sense (`IsCMModule`) if and only if its depth
`localDepth R N` equals the dimension `Module.supportDim R N` of its support, and if and only if
`IsCohenMacaulayModule R N`. -/
@[mmp "lem_mmp_foundation_km_cm_depth_dictionary"]
theorem isCMModule_iff_localDepth_eq_supportDim_and_isCohenMacaulayModule
    (R : Type*) [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (N : Type*) [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial N] :
    (IsCMModule R N ↔ (localDepth R N : WithBot ℕ∞) = Module.supportDim R N) ∧
      (IsCMModule R N ↔ IsCohenMacaulayModule R N) :=
  ⟨isCMModule_iff_localDepth_eq_supportDim,
    isCMModule_iff_localDepth_eq_supportDim.trans <| by rw [localDepth_eq_depthSup]; rfl⟩

/-- Let `(R, 𝔪)` be a Noetherian local ring, `N ≠ 0` a finite `R`-module and `x ∈ 𝔪` regular on
`N`. Then `depth (N/xN) + 1 = depth N`, that is, `depth (N/xN) = depth N - 1`. -/
@[mmp "lem_mmp_foundation_km5a_regular_element_depth_drop"]
theorem localDepth_quotSMulTop_add_one {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] {N : Type*} [AddCommGroup N] [Module R N] [Module.Finite R N] [Nontrivial N]
    {x : R} (hx : x ∈ IsLocalRing.maximalIdeal R) (reg : IsSMulRegular N x) :
    localDepth R (QuotSMulTop x N) + 1 = localDepth R N := by
  have := nontrivial_quotSMulTop_of_mem_maximalIdeal N hx
  rw [localDepth_eq_depth, localDepth_eq_depth]
  exact (Module.depth_quotSMulTop_succ_eq_depth_and_exists_isRegular_append _ N).1 x hx reg

end Mori

end MMP

