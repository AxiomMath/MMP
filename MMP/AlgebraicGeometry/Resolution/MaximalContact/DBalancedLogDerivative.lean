module

public import MMP.AlgebraicGeometry.Resolution.LinearBlowupCharts
public import MMP.AlgebraicGeometry.Morphisms.ClosedPointsDense
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import MMP.AlgebraicGeometry.Resolution.MarkedIdeal.OrderOnePullback
public import MMP.AlgebraicGeometry.Resolution.LogDerivativeSections

/-!
# Derivative ideals, maximal contact and `D`-balanced ideals

Let `X` be a smooth scheme of finite type over a field `k` of characteristic zero and `I ⊆ 𝒪_X`
an ideal sheaf. This file collects basic properties of the derivative ideals `D^j(I)`, of the
logarithmic derivative ideals `D^j(-log S)(I)` along a smooth hypersurface `S`, of the maximal
contact ideal `MC(I) = D^{m-1}(I)` (`m = maxord I`) and of `D`-balanced ideals.

* In local coordinates `x_1, …, x_n`, `D(I)` is generated by generators `f_i` of `I` and their
  partial derivatives `∂f_i/∂x_j`.
* If `maxord I ≤ m` then `D^m(I) = 𝒪_X`, and `MC(I)` has order one wherever `I` has maximal
  order.
* `K ⊆ D(-log S)(K)` when every component of `X` has dimension at least `2`, and
  `D^r(-log S)(I)|_S = D^r(I|_S)`.
* A `D`-balanced ideal with `m = maxord I ≥ 1` has order `0` or `m` at every point, so
  `cosupp(I, m) = cosupp I`.
* The maximal coefficient ideal of order one is the maximal contact ideal: `W_1(I) = MC(I)`.

## Main results

* `MMP.Resolution.derivativeIdeal_ideal_eq_span_partialDerivative`: generators of `D(I)` in
  local coordinates.
* `MMP.Resolution.higherDerivativeIdeal_eq_top_of_maxOrder_le`: `maxord I ≤ m → D^m(I) = 𝒪_X`.
* `MMP.Resolution.multAt_maximalContactIdeal_eq_one`: `ord_x MC(I) = 1` where `ord_x I = m`.
* `MMP.Resolution.le_logDerivativeIdeal`: `K ⊆ D(-log S)(K)`, and `D^a(-log S)(K)` increases.
* `MMP.Resolution.comap_higherLogDerivativeIdeal_ker`: `D^r(-log Y)(K)|_Y = D^r(K|_Y)` for a
  closed immersion `Y → X` into a smooth `X`.
* `MMP.Resolution.comap_higherLogDerivativeIdeal_subschemeι`: `D^r(-log S)(I)|_S = D^r(I|_S)`.
* `MMP.Resolution.IsDBalanced.multAt_eq_zero_or_eq_maxOrder`: `ord_p I ∈ {0, maxord I}`.
* `MMP.Resolution.IsDBalanced.cosupport_maxOrder_eq_support`: `cosupp(I, maxord I) = cosupp I`.
* `MMP.Resolution.Kollar.maximalCoefficientIdeal_one_eq_maximalContactIdeal`: `W_1(I) = MC(I)`.

## Implementation notes

Equalities of ideal sheaves over an open `U` are read on the affine opens `W ⊆ U`. The
restriction `K|_S` of an ideal sheaf is the inverse image ideal `K.comap S.subschemeι`, and `S`
is a `k`-scheme through `S.subschemeι ≫ sX`.

Kollár proves `D(-log S)(K)|_S = D(K|_S)` in coordinates with `S = (x_1 = 0)`, splitting into
the cases `n ≥ 2` and `n = 1`. Here it is proved affine-locally and without coordinates, for any
closed immersion `Y → X` with ideal `𝒪_X(-Y)`: over an affine open `W` with `R = 𝒪_X(W)` and
`A = R / 𝒪_X(-Y)(W)`, a logarithmic derivation of `R`
descends to `A`, and every `k`-derivation of `A` lifts to a logarithmic derivation of `R`
because `Ω_{R/k}` is projective (`R` is smooth over `k`).

## References

* [J. Kollár, *Lectures on resolution of singularities*, 3.73–3.99]
-/

open AlgebraicGeometry CategoryTheory

universe u

namespace MMP.Resolution

/-! ### Orders and maximal orders -/

/-- The order at a point is at most the maximal order. -/
private lemma multAt_le_maxOrder {X : Scheme} (I : X.IdealSheafData) (x : X) :
    multAt I x ≤ maxOrder I :=
  le_iSup₂ (f := fun z (_ : z ∈ Set.univ) => multAt I z) x (Set.mem_univ x)

/-- An ideal sheaf has order `0` at `x` exactly when its stalk at `x` is the unit ideal. -/
private theorem multAt_eq_zero_iff_stalk_eq_top {X : Scheme.{u}} {J : X.IdealSheafData}
    {x : X} : multAt J x = 0 ↔ IdealSheafData.stalk J x = ⊤ := by
  rw [← ENat.lt_one_iff_eq_zero, ← not_le, multAt, ← Nat.cast_one, natCast_le_idealOrder_iff',
    pow_one, not_iff_comm, ← ne_eq]
  exact ⟨IsLocalRing.le_maximalIdeal, fun h ht => (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    (top_le_iff.mp (ht ▸ h))⟩

/-- A point lies in `cosupp I` exactly when the order of `I` there is at least one. -/
private lemma one_le_multAt_iff_mem_support {X : Scheme} (I : X.IdealSheafData) (x : X) :
    1 ≤ multAt I x ↔ x ∈ (I.support : Set X) := by
  rw [← Nat.cast_one, multAt, natCast_le_idealOrder_iff', pow_one]
  refine ⟨fun h => not_not.mp fun hx => ?_, fun hx => IsLocalRing.le_maximalIdeal fun h =>
    (IdealSheafData.stalk_eq_top_iff_notMem_support I x |>.1 h) hx⟩
  rw [(IdealSheafData.stalk_eq_top_iff_notMem_support I x).2 hx, top_le_iff] at h
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top h

/-- Equidimensionality of positive dimension `n`, unpacked into the two hypotheses of
`le_higherDerivativeIdeal_and_multAt`. -/
private lemma equidimensional_and_pos_of_dim_eq {X : Scheme.{u}}
    (hdim : ∃ n : ℕ, 0 < n ∧ ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n) :
    TopologicalSpace.Equidimensional X ∧
      ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z := by
  obtain ⟨n, hn, hZ⟩ := hdim
  exact ⟨fun Z hZ' W hW => (hZ Z hZ').trans (hZ W hW).symm,
    fun Z hZ' => by rw [hZ Z hZ']; exact_mod_cast hn⟩

/-! ### Derivatives in local coordinates -/

/-- The derivative ideal of an ideal generated by `S` lies in any ideal `T` that contains `S` and
every derivative `δ s`, `s ∈ S`: by the Leibniz rule `δ(∑ aᵢ sᵢ) = ∑ δ(aᵢ) sᵢ + ∑ aᵢ δ(sᵢ)`. -/
private theorem derivativeIdealOfRing_span_le {A₀ R : Type*} [CommRing A₀] [CommRing R]
    [Algebra A₀ R] {S : Set R} {T : Ideal R} (hS : S ⊆ T)
    (hδ : ∀ δ : Derivation A₀ R R, ∀ s ∈ S, δ s ∈ T) :
    derivativeIdealOfRing A₀ (Ideal.span S) ≤ T := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨δ, g, hg, rfl⟩
  induction hg using Submodule.span_induction with
  | mem s hs => exact hδ δ s hs
  | zero => simp
  | add a b _ _ ha hb => simpa using T.add_mem ha hb
  | smul a b hb ihb =>
    rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact T.add_mem (T.mul_mem_left _ ihb) (T.mul_mem_right _ (Ideal.span_le.mpr hS hb))

/-- In local coordinates every `k`-derivation is `δ = ∑_j δ(x_j) ∂_j`. -/
private theorem derivation_eq_sum_partialDerivative {k : Type*} [Field k] {X : Scheme}
    {sX : X ⟶ Spec (CommRingCat.of k)} {U : X.Opens} {n : ℕ} {x : Fin n → Γ(X, U)}
    (hx : IsLocalCoordinatesOn sX U x) (W : X.affineOpens) (h : W.1 ≤ U) :
    letI := MMP.Mori.sectionAlgebra sX W.1
    ∀ (δ : Derivation k Γ(X, W) Γ(X, W)) (g : Γ(X, W)),
      δ g = ∑ j, partialDerivative hx W h j g * δ (restrictSection W h (x j)) := by
  let := MMP.Mori.sectionAlgebra sX W.1
  intro δ g
  have e := congrArg δ.liftKaehlerDifferential (sum_partialDerivative_smul hx W h g)
  simp only [map_sum, map_smul, Derivation.liftKaehlerDifferential_comp_D, smul_eq_mul] at e
  exact e.symm

/-- On a smooth scheme over a field all of whose irreducible components have positive dimension,
if `x_1, …, x_n` are local coordinates on `U` and `I|_U` is generated by `f_1, …, f_s`, then on
every affine open `W ⊆ U` the sections of `D(I)` are the ideal generated by the `f_i` and the
partial derivatives `∂f_i/∂x_j`. -/
@[mmp "lem_kr3d_derivative_ideal_local_generators"]
public theorem derivativeIdeal_ideal_eq_span_partialDerivative {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z)
    {U : X.Opens} {n : ℕ} {x : Fin n → Γ(X, U)} (hx : IsLocalCoordinatesOn sX U x)
    (I : X.IdealSheafData) {s : ℕ} (f : Fin s → Γ(X, U))
    (hI : ∀ (W : X.affineOpens) (h : W.1 ≤ U),
      I.ideal W = Ideal.span (Set.range fun i => restrictSection W h (f i)))
    (W : X.affineOpens) (h : W.1 ≤ U) :
    (derivativeIdeal sX I).ideal W =
      Ideal.span (Set.range (fun i => restrictSection W h (f i)) ∪
        Set.range fun ij : Fin s × Fin n =>
          partialDerivative hx W h ij.2 (restrictSection W h (f ij.1))) := by
  let := MMP.Mori.sectionAlgebra sX W.1
  have hle := le_derivativeIdeal sX hdim I W
  rw [derivativeIdeal_ideal, sectionDerivativeIdeal, hI W h] at hle ⊢
  apply le_antisymm
  · refine derivativeIdealOfRing_span_le (fun _ hg => Ideal.subset_span (Or.inl hg)) ?_
    rintro δ _ ⟨i, rfl⟩
    rw [derivation_eq_sum_partialDerivative hx W h]
    exact Ideal.sum_mem _ fun j _ =>
      Ideal.mul_mem_right _ _ (Ideal.subset_span (Or.inr ⟨(i, j), rfl⟩))
  · refine Ideal.span_le.mpr (Set.union_subset ?_ ?_)
    · rintro _ ⟨i, rfl⟩
      exact hle (Ideal.subset_span ⟨i, rfl⟩)
    · rintro _ ⟨⟨i, j⟩, rfl⟩
      exact Ideal.subset_span ⟨((hx.basis W h).coord j).compDer (KaehlerDifferential.D k _),
        restrictSection W h (f i), Ideal.subset_span ⟨i, rfl⟩, rfl⟩

/-! ### Higher derivatives and the maximal contact ideal -/

/-- On a smooth, equidimensional scheme of finite type and positive dimension over a field of
characteristic zero, if an ideal sheaf `I`, nonzero at the generic point of every irreducible
component, has maximal order at most `m`, then its `m`-th derivative ideal is the unit ideal. -/
@[mmp "lem_kr3d_top_derivative_is_unit_ideal"]
public theorem higherDerivativeIdeal_eq_top_of_maxOrder_le {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hdim : ∃ n : ℕ, 0 < n ∧ ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) {m : ℕ} (hm : maxOrder I ≤ m) :
    higherDerivativeIdeal sX I m = ⊤ := by
  obtain ⟨hX, hpos⟩ := equidimensional_and_pos_of_dim_eq hdim
  refine eq_top_of_maxOrder_lt_one ((iSup₂_le fun x _ => ?_).trans_lt zero_lt_one)
  rw [(le_higherDerivativeIdeal_and_multAt sX hX hpos hI m x).2,
    tsub_eq_zero_of_le ((multAt_le_maxOrder I x).trans hm)]

/-- In an irreducible closed subset of dimension `≤ 0` of a `T₀` space, specialization between
its points is trivial. -/
private theorem specializes_of_topologicalKrullDim_le_zero {X : Type*} [TopologicalSpace X]
    [T0Space X] {W : Set X} (hW : topologicalKrullDim W ≤ 0) {x y : X} (hx : x ∈ W)
    (hy : y ∈ W) (hxy : y ⤳ x) : x = y := by
  by_contra hne
  have hpos : 0 < topologicalKrullDim W := by
    refine Order.krullDim_pos_iff.mpr ⟨⟨closure {(⟨x, hx⟩ : W)}, isIrreducible_singleton.closure,
      isClosed_closure⟩, ⟨closure {(⟨y, hy⟩ : W)}, isIrreducible_singleton.closure,
      isClosed_closure⟩, ?_⟩
    have hsp : (⟨y, hy⟩ : W) ⤳ ⟨x, hx⟩ :=
      (Topology.IsInducing.subtypeVal.specializes_iff).mp hxy
    refine lt_of_le_of_ne hsp.closure_subset fun h => ?_
    have h' : closure {(⟨x, hx⟩ : W)} = closure {(⟨y, hy⟩ : W)} :=
      congrArg (fun A : TopologicalSpace.IrreducibleCloseds W => (A : Set W)) h
    have : (⟨x, hx⟩ : W) ⤳ ⟨y, hy⟩ := by
      rw [specializes_iff_mem_closure, h']
      exact subset_closure rfl
    exact hne (congrArg Subtype.val (hsp.antisymm this).eq).symm
  exact absurd hW (not_le.mpr hpos)

/-- In a local ring whose maximal ideal is zero (a field), every ideal has order `0` or `∞`. -/
private theorem idealOrder_eq_zero_or_eq_top {R : Type*} [CommRing R] [IsLocalRing R]
    (hR : IsLocalRing.maximalIdeal R = ⊥) (J : Ideal R) :
    idealOrder J = 0 ∨ idealOrder J = ⊤ := by
  by_cases hJ : J ≤ IsLocalRing.maximalIdeal R
  · rw [hR, le_bot_iff] at hJ
    subst hJ
    exact .inr <| (ENat.eq_top_iff_forall_ge).mpr fun j => le_iSup₂_of_le j bot_le le_rfl
  · refine .inl <| nonpos_iff_eq_zero.mp <| iSup₂_le fun j hj => ?_
    rcases Nat.eq_zero_or_pos j with rfl | hj0
    · rfl
    · exact absurd (hj.trans (Ideal.pow_le_self hj0.ne')) hJ

/-- On a smooth equidimensional scheme over a field, an ideal sheaf of finite order `≥ 1` at some
point forces every irreducible component to have positive dimension: otherwise every point is a
generic point, every local ring is a reduced local ring of dimension `0`, that is a field, and an
ideal of a field has order `0` or `∞`. -/
private theorem topologicalKrullDim_pos_of_multAt {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] (hX : TopologicalSpace.Equidimensional X)
    {I : X.IdealSheafData} {m : ℕ} (hm1 : 1 ≤ m) {x : X} (hx : multAt I x = m) :
    ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z := by
  by_contra hcon
  push Not at hcon
  obtain ⟨Z₀, hZ₀, hZ₀dim⟩ := hcon
  have hmax : IsMax x := by
    intro y hxy
    rw [Scheme.le_iff_specializes] at hxy ⊢
    obtain ⟨W, hW, hyW⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := y)).closure
    rw [specializes_of_topologicalKrullDim_le_zero ((hX W hW Z₀ hZ₀).le.trans hZ₀dim)
      (hyW (specializes_iff_mem_closure.mp hxy)) (hyW (subset_closure rfl)) hxy]
  have := krullDimLE_of_coheight_le (n := 0) (Order.coheight_eq_zero.mpr hmax).le
  have : IsReduced X := isReduced_of_smooth sX
  have hR := (IsLocalRing.isField_iff_maximalIdeal_eq).mp
    (Ring.KrullDimLE.isField_of_isReduced (R := X.presheaf.stalk x))
  rcases idealOrder_eq_zero_or_eq_top hR (IdealSheafData.stalk I x) with h | h <;>
    rw [← multAt, hx] at h
  · exact absurd (Nat.cast_eq_zero.mp h) (by omega)
  · exact ENat.coe_ne_top m h

/-- On a smooth equidimensional scheme of finite type over a field of characteristic zero, for an
ideal sheaf `I` nonzero at the generic point of every irreducible component whose maximal order is
a natural number `m ≥ 1`, the maximal contact ideal `maximalContactIdeal sX I` has order exactly
`1` at every point where `I` has order `m`. -/
@[mmp "lem_kr3d_maximal_contact_ideal_order_one"]
public theorem multAt_maximalContactIdeal_eq_one {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : TopologicalSpace.Equidimensional X)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) {m : ℕ} (hm1 : 1 ≤ m)
    (hm : maxOrder I = m) {x : X} (hx : multAt I x = m) :
    multAt (maximalContactIdeal sX I) x = 1 := by
  have h := (le_higherDerivativeIdeal_and_multAt sX hX
    (topologicalKrullDim_pos_of_multAt sX hX hm1 hx) hI (m - 1) x).2
  rw [maximalContactIdeal, hm, ENat.toNat_coe, h, hx, ← ENat.coe_sub, Nat.sub_sub_self hm1,
    Nat.cast_one]

/-! ### Logarithmic derivatives -/

/-- If an `A₀`-derivation `δ` of `R` and `y ∈ R` satisfy `δ y = 1`, then `f = δ (y f) - y δ f`
for every `f`. -/
private theorem eq_sub_of_derivation_eq_one {A₀ R : Type*} [CommRing A₀] [CommRing R]
    [Algebra A₀ R] (δ : Derivation A₀ R R) (y : R) (hy : δ y = 1) (f : R) :
    f = δ (y * f) - y * δ f := by
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, hy]
  ring

/-- On an affine open avoiding the support of `S`, the sections of `S` are the unit ideal. -/
private theorem ideal_eq_top_of_disjoint {X : Scheme.{u}} (S : X.IdealSheafData)
    (W : X.affineOpens) (hW : ∀ x ∈ W.1, x ∉ S.support) : S.ideal W = ⊤ := by
  have := (W.2.fromSpec_image_zeroLocus (S.ideal W)).trans_subset
    (Scheme.IdealSheafData.zeroLocus_inter_subset_supportSet S W)
  have h : W.2.fromSpec '' PrimeSpectrum.zeroLocus (S.ideal W : Set Γ(X, W)) = ∅ :=
    Set.eq_empty_of_forall_notMem fun x hx =>
      hW x (W.2.fromSpec_image_zeroLocus _ ▸ hx).2 (this hx)
  exact PrimeSpectrum.zeroLocus_empty_iff_eq_top.mp (Set.image_eq_empty.mp h)

/-- A dimension `d` with `d + 1 = n` is `n - 1`. -/
private theorem eq_natCast_sub_one_of_add_one_eq {d : WithBot ℕ∞} {n : ℕ} (h : d + 1 = n) :
    d = (n - 1 : ℕ) := by
  induction d using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
    induction d using ENat.recTopCoe with
    | top => norm_cast at h
    | coe d =>
      obtain rfl : d + 1 = n := by exact_mod_cast h
      simp

/-- Around every closed point `p` of `X` there is an affine open `W` carrying a logarithmic
derivation `δ` and a section `y` with `δ y = 1`. Off `S` a coordinate derivation `∂/∂x_1` does;
on `S` there are coordinates with `S = (x_1 = 0)`, and `∂/∂x_2` does, which needs `n ≥ 2`. -/
private theorem exists_logDerivation_eq_one {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 2 ≤ topologicalKrullDim Z)
    {S : X.IdealSheafData} (hS : IsSmoothHypersurface sX S)
    (p : X) (hp : p ∈ closedPoints X) :
    ∃ W : X.affineOpens, p ∈ W.1 ∧ letI := MMP.Mori.sectionAlgebra sX W.1
      ∃ δ ∈ logDerivations sX S W, ∃ y : Γ(X, W), δ y = 1 := by
  have hpc : IsClosed ({p} : Set X) := hp
  obtain ⟨U, hpU, n, x, hx, -, hn⟩ :=
    MMP.Flips.ResolutionInputs.exists_isLocalCoordinatesOn sX p
  obtain ⟨Z, hZ, -, hZp⟩ :=
    exists_mem_irreducibleComponents_topologicalKrullDim_eq_topologicalKrullDimAt k X sX p
  have hn2 : 2 ≤ n := by
    have := hdim Z hZ
    rw [hZp, hn] at this
    exact_mod_cast this
  by_cases hpS : p ∈ S.support
  · have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
    have hR : ringKrullDim (X.presheaf.stalk p) = n := by
      rw [← topologicalKrullDimAt_eq_krullDimOfRing_stalk k X sX p hpc, hn]
    have := isRegularLocalRing_stalk_of_smooth_over_field sX p
    have hISreg := MMP.Flips.ResolutionInputs.isRegularLocalRing_quotient_stalk sX S hS.1 hpS
    have : (IdealSheafData.stalk S p).IsPrime := by
      have : IsDomain (X.presheaf.stalk p ⧸ IdealSheafData.stalk S p) :=
        IsRegularLocalRing.isDomain _
      exact (Ideal.Quotient.isDomain_iff_prime _).mp this
    have hht := MMP.Flips.ResolutionInputs.height_stalk_eq_one_of_isPureCodimOne S hS.2
      (x := p)
    have hIS := MMP.Flips.ResolutionInputs.ringKrullDim_quotient_add_one_of_height_eq_one _ hht
    obtain ⟨q, rfl⟩ : ∃ q, S.subschemeι q = p := by
      rwa [← SetLike.mem_coe, ← S.range_subschemeι] at hpS
    have hdimS : ringKrullDim (S.subscheme.presheaf.stalk q) = ((n - 1 : ℕ) : WithBot ℕ∞) := by
      rw [← ringKrullDim_eq_of_ringEquiv (MMP.Flips.ResolutionInputs.stalkQuotientEquiv S q)]
      exact eq_natCast_sub_one_of_add_one_eq (hR ▸ hIS)
    obtain ⟨V, hpV, x1, y, hc, -, hSV, -⟩ :=
      MMP.Flips.ResolutionInputs.exists_isLocalCoordinatesAt_flag sX
        ((MMP.Mori.isSmoothScheme_iff sX).2 inferInstance) S S hS.1 hS le_rfl q hpc
        (r := 1) (m := n - 1) le_rfl (by rw [hR]; congr 1; omega) hdimS
    obtain ⟨_, ⟨W₀, hW₀, rfl⟩, hpW, hWV⟩ :=
      (X.isBasis_affineOpens).exists_subset_of_mem_open hpV V.2
    let W : X.affineOpens := ⟨W₀, hW₀⟩
    replace hWV : W.1 ≤ V := hWV
    letI := MMP.Mori.sectionAlgebra sX W.1
    obtain ⟨b, hb⟩ := hc.1 W hWV
    let j : Fin (1 + (n - 1)) := Fin.natAdd 1 ⟨0, by omega⟩
    let δ := (b.coord j).compDer (KaehlerDifferential.D k Γ(X, W))
    have hδ : δ ∈ logDerivations sX S W := by
      intro f hf
      rw [hSV W hWV] at hf ⊢
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hf
      have h0 : δ (restrictSection W hWV (x1 ⟨0, zero_lt_one⟩)) = 0 := by
        have := hb (Fin.castAdd (n - 1) ⟨0, zero_lt_one⟩)
        simp only [Fin.append_left] at this
        change b.coord j (KaehlerDifferential.D k Γ(X, W) _) = 0
        rw [← this, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply,
          if_neg (by simp [j, Fin.ext_iff])]
      rw [Derivation.leibniz, h0, smul_zero, zero_add, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    refine ⟨W, hpW, δ, hδ, restrictSection W hWV (Fin.append x1 y j), ?_⟩
    simp [δ, ← hb]
  · obtain ⟨_, ⟨W₀, hW₀, rfl⟩, hpW, hWU⟩ := (X.isBasis_affineOpens).exists_subset_of_mem_open
      (show p ∈ (U ⊓ (S.support.compl) : X.Opens) from ⟨hpU, hpS⟩)
      (U ⊓ S.support.compl).2
    let W : X.affineOpens := ⟨W₀, hW₀⟩
    have hWU' : W.1 ≤ U := fun z hz => (hWU hz).1
    have hStop : S.ideal W = ⊤ :=
      ideal_eq_top_of_disjoint S W fun z hz => (hWU hz).2
    letI := MMP.Mori.sectionAlgebra sX W.1
    obtain ⟨b, hb⟩ := hx W hWU'
    exact ⟨W, hpW, (b.coord ⟨0, by omega⟩).compDer (KaehlerDifferential.D k Γ(X, W)),
      fun f _ => by rw [hStop]; trivial,
      restrictSection W hWU' (x ⟨0, by omega⟩), by simp [← hb]⟩

/-- If every closed point has an affine neighbourhood carrying a logarithmic derivation `δ`
and a section `y` with `δ y = 1`, then `J ≤ D(-log S)(J)`: on it `f = δ (y f) - y δ f`. -/
private theorem self_le_logDerivativeIdeal {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 2 ≤ topologicalKrullDim Z)
    {S : X.IdealSheafData} (hS : IsSmoothHypersurface sX S)
    (J : X.IdealSheafData) : J ≤ logDerivativeIdeal sX S J := by
  let ι := {W : X.affineOpens // letI := MMP.Mori.sectionAlgebra sX W.1
    ∃ δ ∈ logDerivations sX S W, ∃ y : Γ(X, W), δ y = 1}
  have hcover : (⨆ i : ι, i.1.1) = ⊤ :=
    Bridges.eq_top_of_closedPoints_subset sX _ fun p hp => by
      obtain ⟨W, hpW, hW⟩ := exists_logDerivation_eq_one sX hdim hS p hp
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨W, hW⟩, hpW⟩
  refine le_sInf fun J' hJ' => Scheme.IdealSheafData.le_of_iSup_eq_top (ι := ι) (fun W ↦ W.1)
    hcover fun ⟨W, hW⟩ => le_trans ?_ (hJ' W)
  letI := MMP.Mori.sectionAlgebra sX W.1
  obtain ⟨δ, hδ, y, hy⟩ := hW
  intro f hf
  rw [eq_sub_of_derivation_eq_one δ y hy f]
  exact sub_mem (Ideal.subset_span ⟨δ, hδ, y * f, J.ideal W |>.mul_mem_left y hf, rfl⟩)
    (Ideal.mul_mem_left _ y (Ideal.subset_span ⟨δ, hδ, f, hf, rfl⟩))

/-- On a smooth scheme of finite type over a field of characteristic `0` all of whose irreducible
components have dimension at least `2`, every ideal sheaf `K` is contained in its logarithmic
derivative along a smooth hypersurface `S`, and the higher logarithmic derivatives
`D^a(-log S)(K)` form an increasing sequence. -/
@[mmp "lem_kr3d_ideal_subset_log_derivative"]
public theorem le_logDerivativeIdeal {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 2 ≤ topologicalKrullDim Z)
    {S : X.IdealSheafData} (hS : IsSmoothHypersurface sX S) (K : X.IdealSheafData) :
    K ≤ logDerivativeIdeal sX S K ∧ Monotone (higherLogDerivativeIdeal sX S K) := by
  refine ⟨self_le_logDerivativeIdeal sX hdim hS K, monotone_nat_of_le_succ fun a => ?_⟩
  simpa only [higherLogDerivativeIdeal, Function.iterate_succ_apply'] using
    self_le_logDerivativeIdeal sX hdim hS _

/-! ### Restricting logarithmic derivatives to the hypersurface -/

/-- The ideal generated by the `δ f`, `f ∈ K`, for the `k`-derivations `δ` of `R` preserving
`I`. -/
private def logSpan (k : Type*) {R : Type*} [CommRing k] [CommRing R] [Algebra k R]
    (I K : Ideal R) : Ideal R :=
  Ideal.span {g | ∃ δ : Derivation k R R, (∀ s ∈ I, δ s ∈ I) ∧ ∃ f ∈ K, δ f = g}

open KaehlerDifferential in
/-- For a surjection `R → A` from a formally smooth `k`-algebra, the image of the logarithmic
span along the kernel is the derivative ideal of the image. -/
private theorem map_logSpan_eq {k R A : Type*} [CommRing k] [CommRing R] [CommRing A]
    [Algebra k R] [Algebra k A] [Algebra R A] [IsScalarTower k R A] [Algebra.FormallySmooth k R]
    (hφ : Function.Surjective (algebraMap R A)) (K : Ideal R) :
    (logSpan k (RingHom.ker (algebraMap R A)) K).map (algebraMap R A) =
      derivativeIdealOfRing k (K.map (algebraMap R A)) := by
  let φ : R →ₐ[k] A := IsScalarTower.toAlgHom k R A
  have hφ' : Function.Surjective φ := hφ
  apply le_antisymm
  · rw [logSpan, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨δ, hδ, f, hf, rfl⟩, rfl⟩
    have hd : ∀ x, φ x = 0 → φ (δ x) = 0 := hδ
    exact Ideal.subset_span ⟨Derivation.liftOfSurjective hφ' hd, φ f,
      Ideal.mem_map_of_mem _ hf, Derivation.liftOfSurjective_apply hφ' hd f⟩
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨δ', a, ha, rfl⟩
    obtain ⟨f, hf, rfl⟩ := (Ideal.mem_map_iff_of_surjective _ hφ).mp ha
    let d : Derivation k R A := (δ'.restrictScalars k).compAlgebraMap R
    let L : Ω[R⁄k] →ₗ[R] A := d.liftKaehlerDifferential
    obtain ⟨L', hL'⟩ := Module.projective_lifting_property (Algebra.linearMap R A) L hφ
    let δ : Derivation k R R := L'.compDer (D k R)
    have key (x : R) : algebraMap R A (δ x) = δ' (algebraMap R A x) := by
      simpa [δ, L, d] using LinearMap.congr_fun hL' (D k R x)
    rw [← key f]
    refine Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨δ, fun s hs => ?_, f, hf, rfl⟩)
    rw [RingHom.mem_ker] at hs ⊢
    rw [key, hs, map_zero]

section Geometry

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

private theorem sectionLogDerivativeIdeal_eq (S K : X.IdealSheafData) (W : X.affineOpens) :
    sectionLogDerivativeIdeal sX S K W =
      letI := MMP.Mori.sectionAlgebra sX W.1
      logSpan k (S.ideal W) (K.ideal W) := by
  let := MMP.Mori.sectionAlgebra sX W.1
  rfl

/-- The restriction along a closed immersion `i : Y → X` of `D(-log Y)(K)` is `D(K|_Y)`,
computed on `Y` over `k`. -/
private theorem comap_logDerivativeIdeal_ker [Smooth sX] {Y : Scheme.{u}} (i : Y ⟶ X)
    [IsClosedImmersion i] (K : X.IdealSheafData) :
    (logDerivativeIdeal sX i.ker K).comap i = derivativeIdeal (i ≫ sX) (K.comap i) := by
  let V : X.affineOpens → Y.affineOpens := fun W => ⟨i ⁻¹ᵁ W.1, W.2.preimage i⟩
  have hV : ⨆ W, (V W).1 = ⊤ := by
    refine eq_top_iff.mpr fun z _ => ?_
    obtain ⟨_, ⟨W, hW, rfl⟩, hz, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (i z)) isOpen_univ
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨W, hW⟩, hz⟩
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top V hV fun W => ?_
  let W' := V W
  let := MMP.Mori.sectionAlgebra sX W.1
  let := MMP.Mori.sectionAlgebra (i ≫ sX) (i ⁻¹ᵁ W.1)
  let := (i.app W.1).hom.toAlgebra
  have : IsScalarTower k Γ(X, W) Γ(Y, i ⁻¹ᵁ W.1) := by
    refine IsScalarTower.of_algebraMap_eq fun c => ?_
    have h := Scheme.Hom.appLE_comp_appLE i sX ⊤ W.1 (i ⁻¹ᵁ W.1) (by simp) le_rfl
    have h' := congrArg (fun t => ((Scheme.ΓSpecIso (.of k)).inv ≫ t).hom c) h
    simp only [← Scheme.Hom.app_eq_appLE] at h'
    exact h'.symm
  have : Algebra.FormallySmooth k Γ(X, W) :=
    (MMP.Flips.ResolutionInputs.smooth_sectionAlgebra sX W.2).formallySmooth
  have hsurj : Function.Surjective (algebraMap Γ(X, W) Γ(Y, i ⁻¹ᵁ W.1)) :=
    i.app_surjective W.1 W.2
  have hker : RingHom.ker (algebraMap Γ(X, W) Γ(Y, i ⁻¹ᵁ W.1)) = i.ker.ideal W :=
    (i.ker_apply W).symm
  have hcomap : ∀ L : X.IdealSheafData,
      (L.comap i).ideal W' = (L.ideal W).map (algebraMap Γ(X, W) Γ(Y, i ⁻¹ᵁ W.1)) := by
    intro L
    rw [Stacks.IdealSheaf.ideal_comap_appLE L i W W' le_rfl]
    change Ideal.map (i.appLE W.1 (i ⁻¹ᵁ W.1) le_rfl).hom _ = _
    rw [← Scheme.Hom.app_eq_appLE]
    rfl
  rw [hcomap, derivativeIdeal_ideal, logDerivativeIdeal_ideal, sectionLogDerivativeIdeal_eq]
  change _ = @derivativeIdealOfRing k Γ(Y, i ⁻¹ᵁ W.1) _ _
    (MMP.Mori.sectionAlgebra (i ≫ sX) (i ⁻¹ᵁ W.1)) ((K.comap i).ideal W')
  rw [hcomap, ← map_logSpan_eq hsurj, hker]

/-- On a smooth `k`-scheme `X`, the restriction along a closed immersion `i : Y → X` of the
`r`-th logarithmic derivative `D^r(-log Y)(K)` is the `r`-th derivative `D^r(K|_Y)`, computed on
`Y` over `k`. -/
public theorem comap_higherLogDerivativeIdeal_ker [Smooth sX] {Y : Scheme.{u}} (i : Y ⟶ X)
    [IsClosedImmersion i] (K : X.IdealSheafData) (r : ℕ) :
    (higherLogDerivativeIdeal sX i.ker K r).comap i =
      higherDerivativeIdeal (i ≫ sX) (K.comap i) r := by
  induction r with
  | zero => rfl
  | succ r ih =>
    rw [higherDerivativeIdeal_succ, ← ih, higherLogDerivativeIdeal, Function.iterate_succ_apply']
    exact comap_logDerivativeIdeal_ker sX i _

end Geometry

/-- On a smooth, equidimensional scheme of finite type over a field of characteristic zero, the
restriction to a smooth hypersurface `S` of the `r`-th logarithmic derivative `D^r(-log S)(I)` of
an ideal sheaf `I` is the `r`-th derivative, computed on `S` over `k`, of the restriction
`I|_S`. -/
@[mmp "lem_kr3d_log_derivative_restriction"]
public theorem comap_higherLogDerivativeIdeal_subschemeι {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hdim : ∃ n : ℕ∞, ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n)
    {S : X.IdealSheafData} (hS : IsSmoothHypersurface sX S) (I : X.IdealSheafData) (r : ℕ) :
    (higherLogDerivativeIdeal sX S I r).comap S.subschemeι =
      higherDerivativeIdeal (S.subschemeι ≫ sX) (I.comap S.subschemeι) r := by
  simpa only [S.ker_subschemeι] using comap_higherLogDerivativeIdeal_ker sX S.subschemeι I r

/-! ### `D`-balanced ideals -/

/-- On a noetherian scheme, an increasing chain of ideal sheaves stabilises. -/
private theorem exists_eq_succ_of_monotone_chain {X : Scheme.{u}} [IsNoetherian X]
    (a : ℕ →o X.IdealSheafData) : ∃ N, a N = a (N + 1) := by
  have : IsLocallyNoetherian X := IsNoetherian.toIsLocallyNoetherian
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun U : X.affineOpens => (U.1 : Set X))
    (fun U => U.1.isOpen) fun x _ => by
      obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) (by simp)
      exact Set.mem_iUnion.mpr ⟨⟨U, hU⟩, hxU⟩
  let V : t → X.affineOpens := fun i => i.1
  have hV : ⨆ i, (V i).1 = ⊤ := eq_top_iff.mpr fun x _ => by
    obtain ⟨U, hU, hxU⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hxU⟩
  have (i : t) : WellFoundedGT (Ideal Γ(X, (V i).1)) :=
    isNoetherian_iff'.mp (IsLocallyNoetherian.component_noetherian (V i))
  have : WellFoundedGT ((i : t) → Ideal Γ(X, (V i).1)) :=
    Pi.wellFoundedLT (α := fun i : t => (Ideal Γ(X, (V i).1))ᵒᵈ) (hw := this)
  obtain ⟨N, hN⟩ := WellFoundedGT.monotone_chain_condition
    (⟨fun j i => (a j).ideal (V i), fun _ _ h i => a.mono h (V i)⟩ :
      ℕ →o ((i : t) → Ideal Γ(X, (V i).1)))
  exact ⟨N, Scheme.IdealSheafData.ext_of_iSup_eq_top V hV fun i =>
    congrFun (hN (N + 1) N.le_succ) i⟩

/-- On a smooth `X` whose components have positive dimension, `j ↦ D^j(I)` is monotone. -/
public theorem monotone_higherDerivativeIdeal {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z) (I : X.IdealSheafData) :
    Monotone (higherDerivativeIdeal sX I) :=
  monotone_nat_of_le_succ fun n => by
    rw [higherDerivativeIdeal_succ]
    exact le_derivativeIdeal sX hdim _

/-- Under the standing assumptions, the maximal order of an ideal sheaf nonzero at the generic
points is a natural number: the chain `D^j(I)` stabilises at some `N`, and then `ord_x I ≤ N`
everywhere. -/
private theorem exists_maxOrder_eq_natCast {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : TopologicalSpace.Equidimensional X)
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z) {I : X.IdealSheafData}
    (hI : IsNonzeroAtGenericPoints I) : ∃ m : ℕ, maxOrder I = m := by
  obtain hX0 | _ := isEmpty_or_nonempty X
  · exact ⟨0, le_antisymm (iSup₂_le fun x _ => isEmptyElim x) bot_le⟩
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have : IsNoetherian X := {}
  have hord := le_higherDerivativeIdeal_and_multAt sX hX hdim hI
  obtain ⟨N, hN⟩ := exists_eq_succ_of_monotone_chain
    ⟨higherDerivativeIdeal sX I, monotone_higherDerivativeIdeal sX hdim I⟩
  change higherDerivativeIdeal sX I N = higherDerivativeIdeal sX I (N + 1) at hN
  have hle : maxOrder I ≤ N := iSup₂_le fun x _ => by
    have h := (hord N x).2
    rw [hN, (hord (N + 1) x).2] at h
    obtain ⟨r, hr⟩ := ENat.ne_top_iff_exists.mp (multAt_ne_top_of_isNonzeroAtGenericPoints hI x)
    rw [← hr] at h ⊢
    norm_cast at h ⊢
    omega
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.coe_ne_top N) hle)
  exact ⟨m, hm.symm⟩

/-- On a smooth, equidimensional scheme of finite type and positive dimension over a field of
characteristic zero, the order at any point of a `D`-balanced ideal sheaf `I`, nonzero at the
generic point of every irreducible component and with `1 ≤ maxOrder I`, is either `0` or
`maxOrder I`. -/
@[mmp "lem_kr3d_d_balanced_order_dichotomy"]
public theorem IsDBalanced.multAt_eq_zero_or_eq_maxOrder {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [Smooth sX] [QuasiCompact sX]
    (hdim : ∃ n : ℕ, 0 < n ∧ ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) (hD : IsDBalanced sX I)
    (hm : 1 ≤ maxOrder I) (p : X) :
    multAt I p = 0 ∨ multAt I p = maxOrder I := by
  obtain ⟨hX, hpos⟩ := equidimensional_and_pos_of_dim_eq hdim
  obtain ⟨m, hmdef⟩ := exists_maxOrder_eq_natCast sX hX hpos hI
  have hpm := multAt_le_maxOrder I p
  rw [hmdef] at hm hpm ⊢
  have hm1 : 1 ≤ m := by exact_mod_cast hm
  refine hpm.lt_or_eq.imp (fun hlt => ?_) id
  have hzero : multAt (higherDerivativeIdeal sX I (m - 1)) p = 0 := by
    rw [(le_higherDerivativeIdeal_and_multAt sX hX hpos hI (m - 1) p).2]
    refine tsub_eq_zero_of_le ((ENat.lt_add_one_iff (ENat.coe_ne_top _)).mp ?_)
    rwa [← ENat.coe_one, ← ENat.coe_add, Nat.sub_add_cancel hm1]
  have hb := hD (m - 1) (by simp [hmdef]; omega)
  rw [hmdef, ENat.toNat_coe, Nat.sub_sub_self hm1, pow_one] at hb
  refine multAt_eq_zero_iff_stalk_eq_top.mpr (top_le_iff.mp ?_)
  calc (⊤ : Ideal _) = IdealSheafData.stalk (higherDerivativeIdeal sX I (m - 1)) p ^ m := by
        rw [multAt_eq_zero_iff_stalk_eq_top.mp hzero, Ideal.top_pow]
    _ = IdealSheafData.stalk (higherDerivativeIdeal sX I (m - 1) ^ m) p :=
        (Aux.stalk_pow _ _ _).symm
    _ ≤ IdealSheafData.stalk I p := stalk_le_stalk_of_le hb p

/-- If every order is finite and lies in `{0, maxOrder I}` with `maxOrder I ≥ 1`, then
`maxOrder I` is finite. -/
private lemma maxOrder_ne_top {X : Scheme} {I : X.IdealSheafData}
    (hfin : ∀ x, multAt I x ≠ ⊤) (hdich : ∀ x, multAt I x = 0 ∨ multAt I x = maxOrder I)
    (hm : 1 ≤ maxOrder I) : maxOrder I ≠ ⊤ := by
  obtain ⟨x, hx⟩ : ∃ x, multAt I x ≠ 0 := by
    by_contra! h
    exact absurd (hm.trans (iSup₂_le fun z _ => (h z).le)) (by simp)
  exact (hdich x).resolve_left hx ▸ hfin x

/-- On a smooth, equidimensional scheme of finite type and positive dimension over a field of
characteristic zero, a `D`-balanced ideal sheaf `I`, nonzero at the generic point of every
irreducible component and with `1 ≤ maxOrder I`, has the same cosupport as the marked ideal
`(I, maxOrder I)`. -/
@[mmp "lem_kr3d_d_balanced_cosupport_equal"]
public theorem IsDBalanced.cosupport_maxOrder_eq_support {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [Smooth sX] [QuasiCompact sX]
    (hdim : ∃ n : ℕ, 0 < n ∧ ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) (hD : IsDBalanced sX I)
    (hm : 1 ≤ maxOrder I) :
    (MarkedIdeal.mk I (maxOrder I).toNat).cosupport = (I.support : Set X) := by
  have hdich := IsDBalanced.multAt_eq_zero_or_eq_maxOrder hdim hI hD hm
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have : IsNoetherian X := ⟨⟩
  ext x
  simp only [MarkedIdeal.cosupport, Set.mem_setOf_eq, ← one_le_multAt_iff_mem_support,
    ENat.coe_toNat (maxOrder_ne_top (multAt_ne_top_of_isNonzeroAtGenericPoints hI) hdich hm)]
  rcases hdich x with h | h <;> rw [h]
  · exact iff_of_false (fun h' => absurd (hm.trans h') (by simp)) (by simp)
  · exact iff_of_true le_rfl hm

/-! ### The maximal coefficient ideal of order one -/

/-- A vector `c` of nonzero coefficient weight has a nonzero entry `c j` with `j < m`. -/
public theorem exists_lt_ne_zero_of_coefficientWeight_ne_zero {m : ℕ} {c : Fin (m + 1) → ℕ}
    (hc : coefficientWeight m c ≠ 0) : ∃ j : Fin (m + 1), (j : ℕ) < m ∧ c j ≠ 0 := by
  obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hc
  exact ⟨j, by have := left_ne_zero_of_mul hj; omega, right_ne_zero_of_mul hj⟩

/-- A product of ideal sheaves `∏ a_i ^ c_i` with `c_j ≠ 0` lies in `a_j`. -/
public theorem prod_pow_le_of_ne_zero {X : Scheme} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (a : ι → X.IdealSheafData) {c : ι → ℕ} {j : ι} (hj : c j ≠ 0) : ∏ i, a i ^ c i ≤ a j := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j)]
  exact mul_le_of_le_of_le_one (pow_le_of_le_one zero_le (fun _ _ _ => trivial) hj)
    (Finset.prod_le_one' fun _ _ _ _ _ => trivial)

namespace Kollar

/-- **Kollár, Prop. 3.99(4)**. On a smooth scheme over a field all of whose irreducible
components have positive dimension, for an ideal sheaf `I` with `m = maxord I ≥ 1`, the maximal
coefficient ideal of order one is the maximal contact ideal: `W_1(I) = D^{m-1}(I)`. -/
@[mmp "lem_kr3e_maximal_coefficient_ideal_one_eq_mc"]
public theorem maximalCoefficientIdeal_one_eq_maximalContactIdeal {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) :
    maximalCoefficientIdeal sX I 1 = maximalContactIdeal sX I := by
  unfold maximalCoefficientIdeal maximalContactIdeal
  generalize (maxOrder I).toNat = m at hm ⊢
  apply le_antisymm
  · refine iSup₂_le fun c hc => ?_
    obtain ⟨j, hjm, hj⟩ := exists_lt_ne_zero_of_coefficientWeight_ne_zero (c := c) (by omega)
    exact (prod_pow_le_of_ne_zero _ hj).trans
      (monotone_higherDerivativeIdeal sX hdim I (by omega))
  · let j : Fin (m + 1) := ⟨m - 1, by omega⟩
    convert le_iSup₂ (f := fun (c : Fin (m + 1) → ℕ) (_ : (1 : ℤ) ≤ coefficientWeight m c) =>
      ∏ i : Fin (m + 1), higherDerivativeIdeal sX I (i : ℕ) ^ c i) (Pi.single j 1) ?_
    · rw [Finset.prod_eq_single j (fun b _ hb => by simp [hb]) (by simp)]
      simp [j]
    · simp [coefficientWeight, Pi.single_apply, j]
      omega

end Kollar

end MMP.Resolution
