/-!
# Tuning of ideals

Let `X` be smooth over a field `k` of characteristic zero, every irreducible component of which
has positive dimension, `I ⊆ 𝒪_X` an ideal sheaf with `m = maxord I ≥ 1`, `s ≥ 1` and
`J ⊆ 𝒪_X` an ideal sheaf with `I^s ⊆ J ⊆ W_{ms}(I)`, `W_{ms}(I)` the maximal coefficient ideal.
A smooth blow-up sequence is of order `≥ m` starting with `(X, I, m, E)` if and only if it is of
order `≥ ms` starting with `(X, J, ms, E)` (Kollár, Thm. 3.100).

One direction rests on the containment of formal transforms: along a sequence of order `≥ m`,
the pull-back of `D^j(I)` factors as `J'_j · E_i^{m-j}` with `J'_j ⊆ D^j(I_i)` (Cor. 3.77), so
the formal transform `T_i(J, ms) = N_i · D_i⁻¹` has `N_i` inside the ideal generated by the
products `∏_j (D^j I_i)^{c_j}` of weight `≥ ms`, times `D_i`. At a point where `ord I_i ≥ m`
that ideal has order `≥ ms`, and cancelling `D_i` gives `ord J_i ≥ ms`. The other direction is
`I_i^s ⊆ J_i`, which passes through each blow-up. Along the way the last marked transforms have
equal cosupports.

Specialising to `J = W_s(I)` with `m ∣ s` gives tuning with a divisor (Cor. 3.101), and to
`s = m!` the maximal order of the well-tuned ideal (Thm. 3.54.2(i)). The file ends with the
local smooth sections of `L ⊗ MC(I)` (Thm. 3.80(2)).

## Main results

In the namespace `MMP.Resolution`:

* `ClosedBlowupSequence.formalTransform_le_of_le_maximalCoefficientIdeal`
* `ClosedBlowupSequence.markedTransform_pow_le_markedTransform`
* `ClosedBlowupSequence.isOrderGeMarkedTripleSeq_iff_of_pow_le_of_le_maximalCoefficientIdeal`
* `ClosedBlowupSequence.cosupport_markedTransform_eq_of_pow_le_of_le_maximalCoefficientIdeal`
* `ClosedBlowupSequence.isOrderGeMarkedTripleSeq_iff_maximalCoefficientIdeal_of_dvd`
* `Kollar.maxOrder_wellTunedIdeal`
* `exists_smul_generator_mem_maximalContactIdeal_smooth`

## Implementation notes

The source's smooth variety is replaced by a smooth scheme all of whose irreducible components
have positive dimension (or an equidimensional one of positive dimension): every argument is
local, and Kollár applies these results to triples, which are neither integral nor separated.
The ordered divisor `E` is arbitrary; Kollár states the case `E = ∅`. The formal transform is a
fractional ideal sheaf `N · D⁻¹` with `D` invertible, so `N · D⁻¹ ⊆ K` is stated as
`N ⊆ K · D`. A section of `L ⊗ MC(I)` over an affine `U` is presented as `f • e`, with `e` a
generator of `L` on `U` and `f ∈ MC(I)(U)` a nonzerodivisor whose zero scheme is
`Spec (Γ(X, U) ⧸ (f))`.

## References

* [J. Kollár, *Lectures on resolution of singularities*][kollar2007], 3.54, 3.80, 3.100, 3.101
-/

open AlgebraicGeometry CategoryTheory TopologicalSpace IsLocalRing Scheme.IdealSheafData

universe u

namespace MMP.Resolution.ClosedBlowupSequence

/-- `I ^ s' ≤ W_{m s'}(I)`, `m = maxord I`: the vector `s' e₀` has weight `m s'`. -/
private theorem pow_le_maximalCoefficientIdeal {k : Type*} [Field k] {X : Scheme}
    (sX : X ⟶ Spec (.of k)) (I : X.IdealSheafData) (s' : ℕ) :
    I ^ s' ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s' : ℕ) : ℤ) := by
  classical
  let c : Fin ((maxOrder I).toNat + 1) → ℕ := Pi.single 0 s'
  have hw : coefficientWeight (maxOrder I).toNat c = (maxOrder I).toNat * s' := by
    unfold coefficientWeight
    rw [Finset.sum_eq_single (0 : Fin _)]
    · simp [c]
    · exact fun j _ hj => by simp [c, Pi.single_apply, hj]
    · simp
  have hp : ∏ j : Fin ((maxOrder I).toNat + 1), higherDerivativeIdeal sX I (j : ℕ) ^ c j =
      I ^ s' := by
    rw [Finset.prod_eq_single (0 : Fin _)]
    · simp [c, higherDerivativeIdeal_zero]
    · exact fun j _ hj => by simp [c, Pi.single_apply, hj]
    · simp
  rw [← hp, maximalCoefficientIdeal]
  exact le_iSup₂_of_le (f := fun c (_ : (((maxOrder I).toNat * s' : ℕ) : ℤ) ≤
      (coefficientWeight _ c : ℤ)) =>
    ∏ j : Fin ((maxOrder I).toNat + 1), higherDerivativeIdeal sX I (j : ℕ) ^ c j) c
    (by rw [hw]) le_rfl

/-! ### Formal transforms below a maximal coefficient ideal -/

section FormalTransform

private theorem formalTransformAux_eq {X : Scheme.{u}} (B : ClosedBlowupSequence X)
    (N D : X.IdealSheafData) (μ : ℕ) :
    B.formalTransformAux N D μ =
      ⟨N.comap B.toBase, D.comap B.toBase * B.exceptionalIdeal ^ μ⟩ := by
  induction B with
  | nil X =>
    change (⟨N, D⟩ : FractionalIdealRep X) = ⟨N.comap (𝟙 X), D.comap (𝟙 X) * 1 ^ μ⟩
    rw [comap_id, comap_id, one_pow, mul_one]
  | cons Z B ih =>
    change B.formalTransformAux _ _ μ = (⟨N.comap (B.toBase ≫ blowUpToBase Z),
      D.comap (B.toBase ≫ blowUpToBase Z) *
        ((Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal) ^ μ⟩ :
          FractionalIdealRep B.target)
    rw [ih, comap_comp, comap_comp, Stacks.IdealSheaf.comap_mul, Stacks.IdealSheaf.comap_pow,
      mul_pow, mul_assoc]

/-- If every truncation of the Cor. 3.77 recursion stays inside `𝒪`, its last term `J'`
satisfies `Π^*K = J' · E^a`. -/
private theorem comap_toBase_eq_mul {X : Scheme.{u}} (B : ClosedBlowupSequence X)
    (K : X.IdealSheafData) (a : ℕ)
    (hB : ∀ i ≤ B.length, (B.truncate i).derivedTransform (some K) a ≠ none)
    (J' : B.target.IdealSheafData) (hJ' : B.derivedTransform (some K) a = some J') :
    K.comap B.toBase = J' * B.exceptionalIdeal ^ a := by
  induction B with
  | nil X =>
    cases hJ'
    change K.comap (𝟙 X) = K * 1 ^ a
    rw [comap_id, one_pow, mul_one]
  | cons Z B ih =>
    have h1 : derivedTransformStep Z a (some K) ≠ none := by
      have := hB 1 (by simp [length])
      cases B <;> exact this
    obtain ⟨K', hK'⟩ := Option.ne_none_iff_exists'.mp h1
    have hstep := derivedTransformStep_mul_eq Z a K K' hK'
      (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal Z)
    have hB' : ∀ i ≤ B.length, (B.truncate i).derivedTransform (some K') a ≠ none := by
      intro i hi
      have := hB (i + 1) (by simp only [length]; omega)
      simp only [truncate, derivedTransform, hK'] at this
      exact this
    obtain ⟨J'', rfl⟩ : ∃ J'' : B.target.IdealSheafData, J'' = J' := ⟨J', rfl⟩
    have hJ'' : B.derivedTransform (some K') a = some J'' := by
      simp only [derivedTransform, hK'] at hJ'
      exact hJ'
    change K.comap (B.toBase ≫ blowUpToBase Z) =
      J'' * ((Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal) ^ a
    rw [comap_comp, ← hstep, Stacks.IdealSheaf.comap_mul, ih K' hB' J'' hJ'',
      Stacks.IdealSheaf.comap_pow, mul_pow]
    ring

private theorem truncate_truncate {X : Scheme.{u}} (B : ClosedBlowupSequence X) {i j : ℕ}
    (h : j ≤ i) : (B.truncate i).truncate j = B.truncate j := by
  induction B generalizing i j with
  | nil X => rfl
  | cons Z B ih =>
    obtain _ | i := i
    · obtain rfl : j = 0 := by omega
      rfl
    · obtain _ | j := j
      · rfl
      · exact congrArg (cons Z) (ih (by omega))

private theorem comap_iSup {X Y : Scheme.{u}} (f : Y ⟶ X) {ι : Sort*}
    (I : ι → X.IdealSheafData) : (⨆ i, I i).comap f = ⨆ i, (I i).comap f :=
  (map_gc f).l_iSup

private theorem length_truncate_le {X : Scheme.{u}} (B : ClosedBlowupSequence X) (i : ℕ) :
    (B.truncate i).length ≤ i := by
  induction B generalizing i with
  | nil X => exact Nat.zero_le _
  | cons Z B ih =>
    obtain _ | i := i
    · exact le_rfl
    · exact Nat.succ_le_succ (ih i)

variable {k : Type u} [Field k]

private theorem isTriple_of_isOrderGeMarkedTripleSeq {X : Scheme.{u}} {s : X ⟶ Spec (.of k)}
    {a : MarkedIdeal X} {E : OrderedDivisor X} {B : ClosedBlowupSequence X}
    (h : B.IsOrderGeMarkedTripleSeq s a E) : IsTriple s a.I E := by
  cases B with
  | nil => exact h
  | cons Z B => exact h.1

private theorem isOrderGePlainSeq_of_isOrderGeMarkedTripleSeq {X : Scheme.{u}}
    {s : X ⟶ Spec (.of k)} {a : MarkedIdeal X} {E : OrderedDivisor X}
    {B : ClosedBlowupSequence X} (h : B.IsOrderGeMarkedTripleSeq s a E) :
    B.IsOrderGePlainSeq s a := by
  induction B with
  | nil X => exact ⟨h.2.1, h.2.2.2.2.2.1⟩
  | cons Z B ih =>
    exact ⟨h.1.2.1, h.1.2.2.2.2.2.1, h.2.1, h.2.2.1, h.2.2.2.2.1, ih h.2.2.2.2.2⟩

/-- Along an order `≥ m` sequence, the pullback of `D^j(I)` to `X_i` factors as
`J' · E_i^{m-j}` with `J' ⊆ D^j(I_i)`: the derived transform of Kollár Cor. 3.77 is the factor
`J'`, and every truncation of its recursion stays inside `𝒪`. -/
private theorem exists_comap_higherDerivativeIdeal_eq_mul [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX]
    (hX : TopologicalSpace.Equidimensional X)
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z)
    (a : MarkedIdeal X) (ha : IsNonzeroAtGenericPoints a.I)
    (B : ClosedBlowupSequence X) (hB : IsOrderGePlainSeq sX a B)
    {i : ℕ} (hi : i ≤ B.length) {j : ℕ} (hj : j ≤ a.m) :
    ∃ J' : (B.truncate i).target.IdealSheafData,
      J' ≤ higherDerivativeIdeal ((B.truncate i).toBase ≫ sX)
        ((B.truncate i).markedTransform a).I j ∧
      (higherDerivativeIdeal sX a.I j).comap (B.truncate i).toBase =
        J' * (B.truncate i).exceptionalIdeal ^ (a.m - j) := by
  obtain ⟨J', hJ', hle⟩ :=
    derivedTransformJ_truncate_le_higherDerivativeIdeal sX hX hdim a ha B hB i hi j hj
  refine ⟨J', hle, comap_toBase_eq_mul _ _ _ (fun i' hi' => ?_) J' hJ'⟩
  have hi'i : i' ≤ i := hi'.trans (length_truncate_le B i)
  obtain ⟨J'', hJ'', -⟩ := derivedTransformJ_truncate_le_higherDerivativeIdeal sX hX hdim a ha
    B hB i' (hi'i.trans hi) j hj
  rw [truncate_truncate B hi'i]
  change derivedTransformJ sX (B.truncate i') a j ≠ none
  simp [hJ'']

end FormalTransform

/-- Along an order `≥ m` sequence for `(X, I, m, E)`, the formal transform `N_i · D_i⁻¹` of
`J ⊆ W_{ms}(I)` has `N_i ⊆ W_{ms}(I_i) · D_i`, where `W_{ms}(I_i)` is computed on `X_i`. -/
private theorem num_formalTransform_le_mul_den {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ C ∈ irreducibleComponents X, 0 < topologicalKrullDim C) (I : X.IdealSheafData)
    (s : ℕ) (J : X.IdealSheafData)
    (hJ : J ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s : ℕ) : ℤ))
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X)
    (hB : B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E)
    {i : ℕ} (hi : i ≤ B.length) :
    (B.formalTransform J ((maxOrder I).toNat * s) i).num ≤
      (⨆ (c : Fin ((maxOrder I).toNat + 1) → ℕ)
          (_ : (maxOrder I).toNat * s ≤ coefficientWeight (maxOrder I).toNat c),
          ∏ j : Fin ((maxOrder I).toNat + 1),
            higherDerivativeIdeal ((B.truncate i).toBase ≫ sX)
              ((B.truncate i).markedTransform ⟨I, (maxOrder I).toNat⟩).I (j : ℕ) ^ c j) *
        (B.formalTransform J ((maxOrder I).toNat * s) i).den := by
  classical
  obtain ⟨_, _, _, _, heq, hnz, _⟩ := isTriple_of_isOrderGeMarkedTripleSeq hB
  choose J' hJ'le hJ'eq using fun j : Fin ((maxOrder I).toNat + 1) =>
    exists_comap_higherDerivativeIdeal_eq_mul sX heq hdim _ hnz B
      (isOrderGePlainSeq_of_isOrderGeMarkedTripleSeq hB) hi (Nat.lt_succ_iff.mp j.2)
  rw [formalTransform, formalTransformAux_eq, comap_top, top_mul]
  refine (comap_mono _ hJ).trans ?_
  beta_reduce
  rw [maximalCoefficientIdeal, comap_iSup]
  refine iSup_le fun c => ?_
  rw [comap_iSup]
  refine iSup_le fun hc => ?_
  have hc' : (maxOrder I).toNat * s ≤ coefficientWeight (maxOrder I).toNat c := by
    exact_mod_cast hc
  simp_rw [Stacks.IdealSheaf.comap_finset_prod, Stacks.IdealSheaf.comap_pow, hJ'eq, mul_pow,
    ← pow_mul, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  exact mul_le_mul' ((Finset.prod_le_prod' fun j _ => pow_le_pow_left' (hJ'le j) _).trans
    (le_iSup₂_of_le c hc' le_rfl)) (pow_le_pow_of_le_one bot_le le_top hc')

/-! ### Orders in a regular local ring -/

private theorem exists_mem_notMem_of_idealOrder_eq {R : Type*} [CommRing R] [IsLocalRing R]
    {A : Ideal R} {a : ℕ} (ha : (a : ℕ∞) = idealOrder A) :
    ∃ φ ∈ A, φ ∈ maximalIdeal R ^ a ∧ φ ∉ maximalIdeal R ^ (a + 1) := by
  have h1 : A ≤ maximalIdeal R ^ a := (natCast_le_idealOrder_iff' A a).1 ha.le
  have h2 : ¬ A ≤ maximalIdeal R ^ (a + 1) := fun h => by
    have := (natCast_le_idealOrder_iff' A (a + 1)).2 h
    rw [← ha] at this
    norm_cast at this
    omega
  obtain ⟨φ, hφ, hφ'⟩ := SetLike.not_le_iff_exists.mp h2
  exact ⟨φ, hφ, h1 hφ, hφ'⟩

/-- In a regular local ring, `ord (A * B) ≤ ord A + ord B`. -/
private theorem idealOrder_mul_le {S : Type*} [CommRing S] [IsRegularLocalRing S]
    (A B : Ideal S) : idealOrder (A * B) ≤ idealOrder A + idealOrder B := by
  rcases eq_or_ne (idealOrder A) ⊤ with hA | hA
  · simp [hA]
  rcases eq_or_ne (idealOrder B) ⊤ with hB | hB
  · simp [hB]
  obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hA
  obtain ⟨b, hb⟩ := ENat.ne_top_iff_exists.mp hB
  obtain ⟨φ, hφA, hφ1, hφ2⟩ := exists_mem_notMem_of_idealOrder_eq ha
  obtain ⟨ψ, hψB, hψ1, hψ2⟩ := exists_mem_notMem_of_idealOrder_eq hb
  have hn : ¬ A * B ≤ maximalIdeal S ^ (a + b + 1) := fun h =>
    MMP.Flips.mul_notMem_maximalIdeal_pow_add_succ hφ1 hφ2 hψ1 hψ2 (h (Ideal.mul_mem_mul hφA hψB))
  rw [← ha, ← hb]
  by_contra hlt
  apply hn
  rw [← natCast_le_idealOrder_iff']
  have : ((a + b : ℕ) : ℕ∞) < idealOrder (A * B) := by
    push_cast
    exact lt_of_not_ge hlt
  exact_mod_cast Order.add_one_le_of_lt this

/-- In a noetherian local ring a nonzero ideal has finite order. -/
private theorem idealOrder_ne_top {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {A : Ideal R} (hA : A ≠ ⊥) : idealOrder A ≠ ⊤ := by
  intro h
  refine hA (eq_bot_iff.2 ?_)
  rw [← Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal R) (maximalIdeal.isMaximal R).ne_top]
  exact le_iInf fun n => (natCast_le_idealOrder_iff' A n).1 (h ▸ le_top)

/-! ### Orders of ideal sheaves -/

/-- In a regular local ring, a factor of finite order cancels on orders: if `A * D ≤ K * D` then
`ord A ≥ ord K`. -/
private theorem le_idealOrder_of_mul_le_mul {S : Type*} [CommRing S] [IsRegularLocalRing S]
    {A D K : Ideal S} {n : ℕ} (hK : (n : ℕ∞) ≤ idealOrder K) (hD : idealOrder D ≠ ⊤)
    (h : A * D ≤ K * D) : (n : ℕ∞) ≤ idealOrder A := by
  obtain ⟨d, hd⟩ := ENat.ne_top_iff_exists.mp hD
  have hKD : ((n + d : ℕ) : ℕ∞) ≤ idealOrder (K * D) := by
    rw [natCast_le_idealOrder_iff', pow_add]
    exact Ideal.mul_mono ((natCast_le_idealOrder_iff' _ _).1 hK)
      ((natCast_le_idealOrder_iff' _ _).1 hd.le)
  have := (hKD.trans (MMP.Resolution.Kollar.idealOrder_antitone h)).trans (idealOrder_mul_le A D)
  rw [← hd, Nat.cast_add] at this
  exact (ENat.add_le_add_iff_right (ENat.coe_ne_top d)).1 this

section Sheaves

variable {X : Scheme.{u}}

private theorem isNonzeroAtGenericPoints_mono {I J : X.IdealSheafData}
    (hI : IsNonzeroAtGenericPoints I) (h : I ≤ J) : IsNonzeroAtGenericPoints J :=
  fun η hη hbot => hI η hη (eq_bot_iff.2 (hbot ▸ stalk_le_stalk_of_le h η))

/-- An ideal sheaf of finite maximal order is nonzero at the generic points: a zero stalk has
infinite order. -/
private theorem isNonzeroAtGenericPoints_of_maxOrder {I : X.IdealSheafData}
    (hm : 1 ≤ (maxOrder I).toNat) : IsNonzeroAtGenericPoints I := by
  intro η _ hbot
  have htop : multAt I η = ⊤ := ENat.eq_top_iff_forall_ge.mpr fun n => by
    rw [multAt, natCast_le_idealOrder_iff', hbot]
    exact bot_le
  have : maxOrder I = ⊤ := top_le_iff.mp (htop ▸ le_iSup₂_of_le
    (f := fun z (_ : z ∈ Set.univ) => multAt I z) η (Set.mem_univ _) le_rfl)
  simp [this] at hm

/-- An ideal sheaf nonzero at the generic points has nonzero stalks everywhere. -/
private theorem stalk_ne_bot {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) (x : X) :
    IdealSheafData.stalk I x ≠ ⊥ := by
  obtain ⟨Z, hZ, hxZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible {x}
    isIrreducible_singleton
  have hZc : IsClosed Z := isClosed_of_mem_irreducibleComponents Z hZ
  have hgen := hZ.1.isGenericPoint_genericPoint_closure
  rw [hZc.closure_eq] at hgen
  have hsp : hZ.1.genericPoint ⤳ x := by
    rw [specializes_iff_mem_closure, hgen.def]
    exact hxZ rfl
  intro hb
  refine hI hZ.1.genericPoint (by rwa [hgen.def]) ?_
  rw [Stacks.Chow.idealStalk_eq_map_stalkSpecializes I hsp, hb, Ideal.map_bot]

private theorem isNonzeroAtGenericPoints_pow (hdom : ∀ x : X, IsDomain (X.presheaf.stalk x))
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) (t : ℕ) :
    IsNonzeroAtGenericPoints (I ^ t) := by
  intro η hη h
  haveI := hdom η
  rw [Aux.stalk_pow] at h
  refine hI η hη ?_
  rcases Nat.eq_zero_or_pos t with rfl | ht
  · rw [pow_zero, Ideal.one_eq_top] at h
    exact absurd h top_ne_bot
  · exact le_bot_iff.mp ((Ideal.isPrime_bot.pow_le_iff ht.ne').mp h.le)

/-- Bound on the stalk of a product `∏ A_j ^ c_j` from bounds on the factors. -/
private theorem stalk_prod_pow_le {ι : Type*} (S : Finset ι) (A : ι → X.IdealSheafData)
    (c d : ι → ℕ) (x : X) (h : ∀ j, IdealSheafData.stalk (A j) x ≤ maximalIdeal _ ^ d j) :
    IdealSheafData.stalk (∏ j ∈ S, A j ^ c j) x ≤
      maximalIdeal (X.presheaf.stalk x) ^ (∑ j ∈ S, d j * c j) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert j S hj ih =>
    rw [Finset.prod_insert hj, Finset.sum_insert hj, Aux.stalk_mul, Aux.stalk_pow, pow_add,
      pow_mul]
    exact Ideal.mul_mono (Ideal.pow_right_mono (h j) _) ih

end Sheaves

/-! ### One blow-up step -/

section Step

variable {X : Scheme.{u}}

/-- `(A : B) ^ s ≤ (C : B ^ s)` whenever `A ^ s ≤ C`. -/
private theorem idealColon_pow_le (A B C : X.IdealSheafData) (s : ℕ)
    (h : A ^ s ≤ C) : idealColon A B ^ s ≤ idealColon C (B ^ s) := by
  refine Scheme.IdealSheafData.le_ofIdeals_iff.mpr fun V => ?_
  have hP : (idealColon A B).ideal V * B.ideal V ≤ A.ideal V := by
    have h1 : (idealColon A B).ideal V ≤
        Submodule.colon (A.ideal V) (B.ideal V : Set Γ(X, V)) :=
      Scheme.IdealSheafData.ideal_ofIdeals_le _ V
    exact Ideal.mul_le.mpr fun x hx y hy => Submodule.mem_colon.mp (h1 hx) y hy
  have h2 : ((idealColon A B).ideal V) ^ s * (B ^ s).ideal V ≤ C.ideal V := by
    rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, ← mul_pow]
    refine (Ideal.pow_right_mono hP s).trans ?_
    simpa only [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply] using h V
  rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply]
  intro x hx
  refine Submodule.mem_colon.mpr fun y hy => ?_
  rw [smul_eq_mul]
  exact h2 (Ideal.mul_mem_mul hx hy)

/-- One blow-up step: `I ^ s ≤ J` passes to the birational transforms of `(I, m)`, `(J, ms)`. -/
private theorem birationalTransform_pow_le (Z : X.IdealSheafData)
    (a b : MarkedIdeal X) (s : ℕ) (hm : b.m = a.m * s) (h : a.I ^ s ≤ b.I) :
    (a.birationalTransform Z).I ^ s ≤ (b.birationalTransform Z).I := by
  change idealColon _ _ ^ s ≤ idealColon _ _
  rw [hm, pow_mul]
  refine idealColon_pow_le _ _ _ s ?_
  rw [← Stacks.IdealSheaf.comap_pow]
  exact Scheme.IdealSheafData.comap_mono _ h

/-- The ideal `π^*D · I_F^μ` is nonzero at the generic points of the blow-up if `D` is. -/
private theorem isNonzeroAtGenericPoints_comap_mul (Z : X.IdealSheafData) {D : X.IdealSheafData}
    (hD : IsNonzeroAtGenericPoints D) (μ : ℕ) :
    IsNonzeroAtGenericPoints (D.comap (blowUpToBase Z) * Z.comap (blowUpToBase Z) ^ μ) := by
  intro η hη h
  have hgen : η ∈ genericPoints (blowUp Z) := hη
  obtain ⟨-, hZ⟩ := (bijOn_genericPoints_blowUpToBase Z).1 hgen
  have htop : IdealSheafData.stalk (Z.comap (blowUpToBase Z)) η = ⊤ := by
    rw [IdealSheafData.stalk_comap,
      (IdealSheafData.stalk_eq_top_iff_notMem_support Z _).2 fun h' =>
        hZ (Scheme.IdealSheafData.mem_supportSet_iff_mem_support.2 h'), Ideal.map_top]
  rw [Aux.stalk_mul, Aux.stalk_pow, htop, Ideal.top_pow, Ideal.mul_top] at h
  exact isNonzeroAtGenericPoints_comap_blowUpToBase Z hD η hη h

end Step

/-! ### Blow-up sequences -/

section Sequences

variable {k : Type u} [Field k]

private theorem isTriple_of_isTriple {X : Scheme.{u}} {s : X ⟶ Spec (.of k)}
    {I J : X.IdealSheafData} {E : OrderedDivisor X} (h : IsTriple s I E)
    (hJ : IsNonzeroAtGenericPoints J) : IsTriple s J E :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, hJ, h.2.2.2.2.2.2⟩

private theorem isRegularLocalRing_of_isTriple {X : Scheme.{u}} {s : X ⟶ Spec (.of k)}
    {I : X.IdealSheafData} {E : OrderedDivisor X} (h : IsTriple s I E) (x : X) :
    IsRegularLocalRing (X.presheaf.stalk x) := by
  obtain ⟨-, hsm, hlft, -⟩ := h
  haveI : LocallyOfFiniteType s := hlft
  haveI : Smooth s := (MMP.Mori.isSmoothScheme_iff s).1 hsm
  exact isRegularLocalRing_stalk_of_smooth_over_field s x

/-- On the scheme of a triple, `I ^ t ≤ J` makes `J` nonzero at the generic points with `I`. -/
private theorem isTriple_of_pow_le {X : Scheme.{u}} {s : X ⟶ Spec (.of k)}
    {I J : X.IdealSheafData} {E : OrderedDivisor X} (t : ℕ) (hpow : I ^ t ≤ J)
    (hT : IsTriple s I E) : IsTriple s J E := by
  refine isTriple_of_isTriple hT (isNonzeroAtGenericPoints_mono
    (isNonzeroAtGenericPoints_pow (fun x => ?_) hT.2.2.2.2.2.1 t) hpow)
  haveI := isRegularLocalRing_of_isTriple hT x
  exact IsRegularLocalRing.isDomain _

private theorem isOrderGeMarkedTripleSeq_truncate {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ {s : X ⟶ Spec (.of k)} {a : MarkedIdeal X} {E : OrderedDivisor X},
      B.IsOrderGeMarkedTripleSeq s a E → ∀ i, (B.truncate i).IsOrderGeMarkedTripleSeq s a E := by
  induction B with
  | nil X => intro s a E h i; exact h
  | cons Z B ih =>
    intro s a E h i
    cases i with
    | zero => exact h.1
    | succ i => exact ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, ih h.2.2.2.2.2 i⟩

/-- Every irreducible component of the last scheme of a sequence of order `≥ m` has positive
dimension if those of `X` do. -/
private theorem pos_dim_target {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ {s : X ⟶ Spec (.of k)} {a : MarkedIdeal X} {E : OrderedDivisor X},
      B.IsOrderGeMarkedTripleSeq s a E →
      (∀ W ∈ irreducibleComponents X, 0 < topologicalKrullDim W) →
        ∀ W ∈ irreducibleComponents B.target, 0 < topologicalKrullDim W := by
  induction B with
  | nil X => intro s a E _ hd; exact hd
  | cons Z B ih =>
    intro s a E h hd
    refine ih h.2.2.2.2.2 fun W hW => ?_
    haveI : LocallyOfFiniteType s := h.1.2.2.1
    obtain ⟨D, hD, hDW⟩ := exists_topologicalKrullDim_eq_of_mem_irreducibleComponents_blowUp s Z hW
    rw [hDW]
    exact hd D hD

/-- Along a sequence of order `≥ μ` for `(J, μ)`, `J_r · D_r = N_r` for the iterated formal
transform `N_r · D_r⁻¹` of `N · D⁻¹ = J`. -/
private theorem markedTransform_mul_den {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ {s : X ⟶ Spec (.of k)} {b : MarkedIdeal X} {E : OrderedDivisor X} (N D : X.IdealSheafData),
      B.IsOrderGeMarkedTripleSeq s b E → b.I * D = N →
        (B.markedTransform b).I * (B.formalTransformAux N D b.m).den =
          (B.formalTransformAux N D b.m).num := by
  induction B with
  | nil X => intro s b E N D _ h; exact h
  | cons Z B ih =>
    intro s b E N D h hND
    obtain ⟨hT, hZ, hcod, -, hord, hB⟩ := h
    refine ih (N.comap (blowUpToBase Z)) (D.comap (blowUpToBase Z) * Z.comap (blowUpToBase Z) ^ b.m)
      hB ?_
    rw [← hND, Stacks.IdealSheaf.comap_mul,
      ← MarkedIdeal.birationalTransform_mul_eq s hT.2.1 Z hZ hcod b hord]
    change _ * (_ * _) = _
    ring

private theorem isNonzeroAtGenericPoints_den {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ (N D : X.IdealSheafData) (μ : ℕ), IsNonzeroAtGenericPoints D →
      IsNonzeroAtGenericPoints (B.formalTransformAux N D μ).den := by
  induction B with
  | nil X => intro N D μ h; exact h
  | cons Z B ih =>
    intro N D μ h
    exact ih _ _ μ (isNonzeroAtGenericPoints_comap_mul Z h μ)

/-- (`⇐`) A sequence of order `≥ mt` for `(J, mt)` is of order `≥ m` for `(I, m)` when
`I ^ t ≤ J` and `I` is nonzero at the generic points. -/
private theorem isOrderGeMarkedTripleSeq_of_pow_le {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ (s : X ⟶ Spec (.of k)) (a b : MarkedIdeal X) (E : OrderedDivisor X) (t : ℕ), 1 ≤ t →
      b.m = a.m * t → a.I ^ t ≤ b.I → IsNonzeroAtGenericPoints a.I →
      B.IsOrderGeMarkedTripleSeq s b E → B.IsOrderGeMarkedTripleSeq s a E := by
  induction B with
  | nil X => intro s a b E t _ _ _ hnz hb; exact isTriple_of_isTriple hb hnz
  | cons Z B ih =>
    intro s a b E t ht hm hpow hnz hb
    obtain ⟨hT, hZ, hcod, hsnc, hord, hB⟩ := hb
    refine ⟨isTriple_of_isTriple hT hnz, hZ, hcod, hsnc, fun W hW => ?_,
      ih _ (a.birationalTransform Z) (b.birationalTransform Z) _ t ht hm
        (birationalTransform_pow_le Z a b t hm hpow)
        (isNonzeroAtGenericPoints_idealColon_comap Z hnz _) hB⟩
    haveI := isRegularLocalRing_of_isTriple hT hW.1.1.genericPoint
    have h1 : ((a.m * t : ℕ) : ℕ∞) ≤ t * orderAlong a.I hW.1.1 := by
      rw [← hm, orderAlong, ← multAt_pow]
      exact (hord W hW).trans (Kollar.multAt_antitone hpow _)
    generalize orderAlong a.I hW.1.1 = y at h1 ⊢
    cases y with
    | top => exact le_top
    | coe y =>
      norm_cast at h1 ⊢
      exact Nat.le_of_mul_le_mul_left (by linarith) (by omega : 0 < t)

/-- (`⇒`) A sequence of order `≥ m` for `(I, m)` is of order `≥ mt` for `(J, mt)` when `I ^ t ≤ J`
and, at every step, order `≥ m` of `I_i` at a point forces order `≥ mt` of `J_i` there. -/
private theorem isOrderGeMarkedTripleSeq_of_forall {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ (s : X ⟶ Spec (.of k)) (a b : MarkedIdeal X) (E : OrderedDivisor X) (t : ℕ),
      b.m = a.m * t → a.I ^ t ≤ b.I → B.IsOrderGeMarkedTripleSeq s a E →
      (∀ i ≤ B.length, (B.truncate i).IsOrderGeMarkedTripleSeq s b E → ∀ x,
        (a.m : ℕ∞) ≤ multAt ((B.truncate i).markedTransform a).I x →
          (b.m : ℕ∞) ≤ multAt ((B.truncate i).markedTransform b).I x) →
      B.IsOrderGeMarkedTripleSeq s b E := by
  induction B with
  | nil X => intro s a b E t _ hpow ha _; exact isTriple_of_pow_le t hpow ha
  | cons Z B ih =>
    intro s a b E t hm hpow ha H
    obtain ⟨hT, hZ, hcod, hsnc, hord, hB⟩ := ha
    have hT' : IsTriple s b.I E := isTriple_of_pow_le t hpow hT
    have hord' : OrderAlongGE b.I (Z.support : Set _) b.m := fun W hW =>
      H 0 (Nat.zero_le _) hT' _ (hord W hW)
    refine ⟨hT', hZ, hcod, hsnc, hord', ih _ (a.birationalTransform Z) (b.birationalTransform Z) _
      t hm (birationalTransform_pow_le Z a b t hm hpow) hB fun i hi hC x hx => ?_⟩
    have hi' : i + 1 ≤ (cons Z B).length := by
      change i + 1 ≤ B.length + 1
      omega
    exact H (i + 1) hi' ⟨hT', hZ, hcod, hsnc, hord', hC⟩ x hx

end Sequences

/-! ### The order of the tuned ideal along the sequence -/

/-- At a point where `ord I ≥ m`, the ideal generated by the products `∏ (D^j I)^{c_j}` of
weight `≥ n` has order `≥ n`. -/
private theorem le_multAt_iSup_prod {k : Type u} [Field k] [CharZero k] {Y : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) [Smooth sY] [QuasiCompact sY]
    (hY : TopologicalSpace.Equidimensional Y)
    (hdim : ∀ Z ∈ irreducibleComponents Y, 0 < topologicalKrullDim Z) {I : Y.IdealSheafData}
    (hI : IsNonzeroAtGenericPoints I) (m n : ℕ) (x : Y) (hx : (m : ℕ∞) ≤ multAt I x) :
    (n : ℕ∞) ≤ multAt (⨆ (c : Fin (m + 1) → ℕ) (_ : n ≤ coefficientWeight m c),
      ∏ j : Fin (m + 1), higherDerivativeIdeal sY I (j : ℕ) ^ c j) x := by
  rw [multAt, natCast_le_idealOrder_iff', iSup_subtype', stalk_iSup]
  refine iSup_le fun c => ?_
  have hc : n ≤ ∑ j : Fin (m + 1), (m - (j : ℕ)) * c.1 j := c.2
  refine (stalk_prod_pow_le Finset.univ (fun j : Fin (m + 1) => higherDerivativeIdeal sY I j)
    c.1 (fun j => m - (j : ℕ)) x fun j => ?_).trans (Ideal.pow_le_pow_right hc)
  rw [← natCast_le_idealOrder_iff', ← multAt,
    (le_higherDerivativeIdeal_and_multAt sY hY hdim hI j x).2, ENat.coe_sub]
  exact tsub_le_tsub_right hx _

/-- The unit ideal sheaf is nonzero at the generic points. -/
private theorem isNonzeroAtGenericPoints_top {X : Scheme.{u}} :
    IsNonzeroAtGenericPoints (⊤ : X.IdealSheafData) := by
  intro η _ h
  rw [(IdealSheafData.stalk_eq_top_iff_notMem_support _ _).2 (by simp [← SetLike.mem_coe])] at h
  exact top_ne_bot h

/-- (`⇒`, one step) Along a sequence of order `≥ m` for `(I, m, E)` whose first `i` steps are of
order `≥ ms` for `(J, ms, E)`, a point where `ord I_i ≥ m` has `ord J_i ≥ ms`. -/
private theorem le_multAt_markedTransform_of_le_maximalCoefficientIdeal {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ C ∈ irreducibleComponents X, 0 < topologicalKrullDim C)
    (I : X.IdealSheafData) (s : ℕ) (J : X.IdealSheafData)
    (hJ : J ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s : ℕ) : ℤ))
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X)
    (hB : B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E) (i : ℕ) (hi : i ≤ B.length)
    (hC : (B.truncate i).IsOrderGeMarkedTripleSeq sX ⟨J, (maxOrder I).toNat * s⟩ E)
    (x : (B.truncate i).target)
    (hx : ((maxOrder I).toNat : ℕ∞) ≤
      multAt ((B.truncate i).markedTransform ⟨I, (maxOrder I).toNat⟩).I x) :
    (((maxOrder I).toNat * s : ℕ) : ℕ∞) ≤
      multAt ((B.truncate i).markedTransform ⟨J, (maxOrder I).toNat * s⟩).I x := by
  have hCI := isOrderGeMarkedTripleSeq_truncate B hB i
  obtain ⟨-, hsm, _, _, heq, hnz, -⟩ :=
    isTriple_target_of_isOrderGeMarkedTripleSeq (B.truncate i) _ _ _ hCI
  haveI : Smooth ((B.truncate i).toBase ≫ sX) := Aux.smooth_of_isSmoothScheme' _ hsm
  haveI hreg := isRegularLocalRing_stalk_of_smooth_over_field ((B.truncate i).toBase ≫ sX) x
  have hup := num_formalTransform_le_mul_den sX hdim I s J hJ E B hB hi
  change ((B.truncate i).formalTransformAux J ⊤ _).num ≤
    _ * ((B.truncate i).formalTransformAux J ⊤ _).den at hup
  rw [← markedTransform_mul_den (B.truncate i) J ⊤ hC (by simp)] at hup
  have h := stalk_le_stalk_of_le hup x
  rw [Aux.stalk_mul, Aux.stalk_mul] at h
  exact le_idealOrder_of_mul_le_mul
    (le_multAt_iSup_prod _ heq (pos_dim_target (B.truncate i) hCI hdim) hnz _ _ x hx)
    (@idealOrder_ne_top _ _ hreg.toIsLocalRing hreg.toIsNoetherian _ (stalk_ne_bot
      (isNonzeroAtGenericPoints_den (B.truncate i) J ⊤ _ isNonzeroAtGenericPoints_top) x)) h

/-- `I ^ s ≤ J` passes to the last marked transforms of `(I, m)` and `(J, ms)` along any
sequence of blow-ups. -/
private theorem markedTransform_pow_le {X : Scheme} (B : ClosedBlowupSequence X) :
    ∀ (a b : MarkedIdeal X) (s : ℕ), b.m = a.m * s → a.I ^ s ≤ b.I →
      (B.markedTransform a).I ^ s ≤ (B.markedTransform b).I := by
  induction B with
  | nil X => intro a b s _ h; exact h
  | cons Z B ih =>
    intro a b s hm h
    exact ih _ _ s hm (birationalTransform_pow_le Z a b s hm h)

private theorem truncate_length {X : Scheme} (B : ClosedBlowupSequence X) :
    B.truncate B.length = B := by
  induction B with
  | nil X => rfl
  | cons Z B ih => exact congrArg (cons Z) ih

/-- Every irreducible component of an equidimensional space of dimension `≥ 1` has positive
dimension. -/
private theorem pos_topologicalKrullDim_of_mem_irreducibleComponents {X : Type*}
    [TopologicalSpace X] (hX : TopologicalSpace.Equidimensional X)
    (hdim : 1 ≤ topologicalKrullDim X) {C : Set X} (hC : C ∈ irreducibleComponents X) :
    0 < topologicalKrullDim C := by
  by_contra h
  exact absurd (hdim.trans (MMP.Flips.topologicalKrullDim_le_of_forall_mem_irreducibleComponents
    fun W hW => (hX W hW C hC).trans_le (not_lt.mp h))) (by decide)

/-- At a point with regular local ring, `I ^ s ≤ J` with `s ≠ 0` turns `ord_x J ≥ ms` into
`ord_x I ≥ m`. -/
private theorem le_multAt_of_pow_le {X : Scheme} {I J : X.IdealSheafData} {s : ℕ} (hs : s ≠ 0)
    (h : I ^ s ≤ J) (x : X) [IsRegularLocalRing (X.presheaf.stalk x)] {m : ℕ}
    (hx : ((m * s : ℕ) : ℕ∞) ≤ multAt J x) : (m : ℕ∞) ≤ multAt I x := by
  have := hx.trans (Kollar.multAt_antitone h x)
  rw [multAt_pow, Nat.cast_mul, mul_comm] at this
  exact (ENat.mul_le_mul_left_iff (by exact_mod_cast hs) (ENat.coe_ne_top s)).1 this

/-- **Kollár, proof of Thm. 3.100 (first direction).** Let `X` be a smooth equidimensional
scheme of positive dimension over a field `k` of characteristic zero, `I` an ideal sheaf with `m =
maxord I ≥ 1`,
`s ≥ 1`, and `J ≤ W_{ms}(I)` (`maximalCoefficientIdeal`). If `B` is a smooth blow-up sequence of
order `≥ m` starting with `(X, I, m, E)` for some ordered divisor `E` (`IsOrderGeMarkedTripleSeq`),
then for every `i ≤ r` the
formal transform `T_i(J, ms) = N_i·D_i⁻¹` (`formalTransform`) satisfies
`N_i ≤ K_i * D_i`, where `K_i` is the ideal sheaf generated by `∏_{j=0}^m (D^j(I_i))^{c_j}` over
`c` with `coefficientWeight m c ≥ ms`, and `I_i` is the ideal of the marked transform of
`(I, m)` along the first `i` blow-ups. -/
@[mmp "lem_kr3e_tuning_transform_upper"]
public theorem formalTransform_le_of_le_maximalCoefficientIdeal {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hX : TopologicalSpace.Equidimensional X) (hdim : 1 ≤ topologicalKrullDim X)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) (s : ℕ) (hs : 1 ≤ s)
    (J : X.IdealSheafData)
    (hJ : J ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s : ℕ) : ℤ))
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X)
    (hB : B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E)
    (i : ℕ) (hi : i ≤ B.length) :
    (B.formalTransform J ((maxOrder I).toNat * s) i).num ≤
      (⨆ (c : Fin ((maxOrder I).toNat + 1) → ℕ)
          (_ : (maxOrder I).toNat * s ≤ coefficientWeight (maxOrder I).toNat c),
          ∏ j : Fin ((maxOrder I).toNat + 1),
            higherDerivativeIdeal ((B.truncate i).toBase ≫ sX)
              ((B.truncate i).markedTransform ⟨I, (maxOrder I).toNat⟩).I (j : ℕ) ^ c j) *
        (B.formalTransform J ((maxOrder I).toNat * s) i).den :=
  num_formalTransform_le_mul_den sX
    (fun _ hC => pos_topologicalKrullDim_of_mem_irreducibleComponents hX hdim hC) I s J hJ E B
    hB hi

/-- **Kollár, proof of Thm. 3.100 (converse direction).** Let `X` be a smooth
equidimensional scheme of positive dimension over a field `k` of characteristic zero, `I` an ideal
sheaf with `m = maxord I ≥ 1`,
`s ≥ 1`, and `J` an ideal sheaf with `I ^ s ≤ J`. If `B` is a smooth blow-up sequence of order
`≥ m` starting with `(X, I, m, E)` and of order `≥ ms` starting with `(X, J, ms, E)`
(`IsOrderGeMarkedTripleSeq`), then for every `i ≤ r` the ideals `I_i`, `J_i` of the marked
transforms of `(I, m)` and `(J, ms)` along the first `i` blow-ups satisfy `I_i ^ s ≤ J_i`. -/
@[mmp "lem_kr3e_tuning_transform_lower"]
public theorem markedTransform_pow_le_markedTransform {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hX : TopologicalSpace.Equidimensional X) (hdim : 1 ≤ topologicalKrullDim X)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) (s : ℕ) (hs : 1 ≤ s)
    (J : X.IdealSheafData) (hJ : I ^ s ≤ J)
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X)
    (hBI : B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E)
    (hBJ : B.IsOrderGeMarkedTripleSeq sX ⟨J, (maxOrder I).toNat * s⟩ E)
    (i : ℕ) (hi : i ≤ B.length) :
    ((B.truncate i).markedTransform ⟨I, (maxOrder I).toNat⟩).I ^ s ≤
      ((B.truncate i).markedTransform ⟨J, (maxOrder I).toNat * s⟩).I :=
  markedTransform_pow_le (B.truncate i) _ _ s rfl hJ

/-- **Kollár, Thm. 3.100 (tuning of ideals).** Let `X` be a smooth scheme over a field `k` of
characteristic zero all of whose irreducible components have positive dimension, `I` an ideal sheaf
with `m = maxord I ≥ 1`, `s ≥ 1`,
and `J` an ideal sheaf with `I ^ s ≤ J ≤ W_{ms}(I)` (`maximalCoefficientIdeal`). Then a smooth
blow-up sequence `B` starting with `X` is a smooth blow-up sequence of order `≥ m` starting with
`(X, I, m, E)` if and only if it is one of order `≥ ms` starting with `(X, J, ms, E)`
(`IsOrderGeMarkedTripleSeq`), for any ordered divisor `E` on `X`; the source's case is `E = ∅`. -/
@[mmp "thm_kr3e_tuning_of_ideals"]
public theorem isOrderGeMarkedTripleSeq_iff_of_pow_le_of_le_maximalCoefficientIdeal
    {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ C ∈ irreducibleComponents X, 0 < topologicalKrullDim C)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) (s : ℕ) (hs : 1 ≤ s)
    (J : X.IdealSheafData) (hIJ : I ^ s ≤ J)
    (hJ : J ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s : ℕ) : ℤ))
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X) (hB : B.IsSmooth sX) :
    B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E ↔
      B.IsOrderGeMarkedTripleSeq sX ⟨J, (maxOrder I).toNat * s⟩ E :=
  ⟨fun hB => isOrderGeMarkedTripleSeq_of_forall B sX ⟨I, _⟩ ⟨J, _⟩ _ s rfl hIJ hB
      fun i hi hC x hx => le_multAt_markedTransform_of_le_maximalCoefficientIdeal sX hdim I
        s J hJ E B hB i hi hC x hx,
    isOrderGeMarkedTripleSeq_of_pow_le B sX ⟨I, _⟩ ⟨J, _⟩ _ s hs rfl hIJ
      (isNonzeroAtGenericPoints_of_maxOrder hm)⟩

/-- **Kollár, proof of Thm. 3.100.** Let `X` be a smooth equidimensional scheme of positive
dimension over a field `k` of characteristic zero, `I` an ideal sheaf with `m = maxord I ≥ 1`, `s ≥
1`, and `J` an
ideal sheaf with `I ^ s ≤ J ≤ W_{ms}(I)` (`maximalCoefficientIdeal`). If `B` is a smooth blow-up
sequence of order `≥ m` starting with `(X, I, m, E)` (`IsOrderGeMarkedTripleSeq`) for some
ordered divisor `E`, then the last
marked transforms of `(I, m)` and `(J, ms)` along `B` have the same cosupport. -/
@[mmp "lem_kr3e_tuning_cosupport_eq"]
public theorem cosupport_markedTransform_eq_of_pow_le_of_le_maximalCoefficientIdeal
    {k : Type u} [Field k] [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hX : TopologicalSpace.Equidimensional X) (hdim : 1 ≤ topologicalKrullDim X)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) (s : ℕ) (hs : 1 ≤ s)
    (J : X.IdealSheafData) (hIJ : I ^ s ≤ J)
    (hJ : J ≤ maximalCoefficientIdeal sX I (((maxOrder I).toNat * s : ℕ) : ℤ))
    (E : OrderedDivisor X) (B : ClosedBlowupSequence X) (hB : B.IsSmooth sX)
    (hBI : B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E) :
    (B.markedTransform ⟨I, (maxOrder I).toNat⟩).cosupport =
      (B.markedTransform ⟨J, (maxOrder I).toNat * s⟩).cosupport := by
  have hdimC := fun C (hC : C ∈ irreducibleComponents X) =>
    pos_topologicalKrullDim_of_mem_irreducibleComponents hX hdim hC
  have hup := le_multAt_markedTransform_of_le_maximalCoefficientIdeal sX hdimC I s J hJ E B hBI
  have hBJ := (isOrderGeMarkedTripleSeq_iff_of_pow_le_of_le_maximalCoefficientIdeal sX hdimC I
    hm s hs J hIJ hJ E B hB).1 hBI
  ext x
  simp only [MarkedIdeal.cosupport, Set.mem_setOf_eq, markedTransform_m]
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · have h := hup B.length le_rfl (by rwa [truncate_length])
    rw [truncate_length] at h
    exact h x hx
  · obtain ⟨-, hsm, _, _, -, -, -⟩ := isTriple_target_of_isOrderGeMarkedTripleSeq B _ _ _ hBI
    haveI : Smooth (B.toBase ≫ sX) := Aux.smooth_of_isSmoothScheme' _ hsm
    haveI := isRegularLocalRing_stalk_of_smooth_over_field (B.toBase ≫ sX) x
    exact le_multAt_of_pow_le (by omega) (markedTransform_pow_le B _ _ s rfl hIJ) x hx

/-- **Kollár, Cor. 3.101 (tuning of ideals with a divisor).** Let `(X, I, E)` be a triple
(`IsTriple`) over a field `k`, with every irreducible component of `X` of positive dimension,
`m = maxord I ≥ 1` and `s` a positive multiple of `m`. Then a smooth blow-up sequence `B`
starting with `X` is a smooth blow-up sequence of order `≥ m` starting with `(X, I, m, E)` if and
only if it is one of order `≥ s` starting with `(X, W_s(I), s, E)` (`maximalCoefficientIdeal`,
`IsOrderGeMarkedTripleSeq`). -/
@[mmp "thm_kr3e_tuning_of_ideals_with_divisor"]
public theorem isOrderGeMarkedTripleSeq_iff_maximalCoefficientIdeal_of_dvd
    {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
    (I : X.IdealSheafData) (E : OrderedDivisor X) (ht : IsTriple sX I E)
    (hdim : ∀ C ∈ irreducibleComponents X, 0 < topologicalKrullDim C)
    (hm : 1 ≤ (maxOrder I).toNat)
    (s : ℕ) (hs : 0 < s) (hms : (maxOrder I).toNat ∣ s)
    (B : ClosedBlowupSequence X) (hB : B.IsSmooth sX) :
    B.IsOrderGeMarkedTripleSeq sX ⟨I, (maxOrder I).toNat⟩ E ↔
      B.IsOrderGeMarkedTripleSeq sX ⟨maximalCoefficientIdeal sX I (s : ℤ), s⟩ E := by
  obtain ⟨_, hsm, _, -, -, -, -⟩ := ht
  haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff _).1 hsm
  obtain ⟨s', rfl⟩ := hms
  exact isOrderGeMarkedTripleSeq_iff_of_pow_le_of_le_maximalCoefficientIdeal sX hdim I hm s'
    (Nat.pos_of_mul_pos_left hs) _ (pow_le_maximalCoefficientIdeal sX I s') le_rfl E B hB

end MMP.Resolution.ClosedBlowupSequence

namespace MMP.Resolution.Kollar

/-- **Kollár, Thm. 3.54.2(i)**. On a smooth equidimensional quasi-compact scheme, locally of
finite type and of positive dimension over a field of characteristic zero, for an ideal sheaf `I`
with `m = maxord I ≥ 1`, the well-tuned ideal
`W(I) = W_{m!}(I)` has maximal order `m!`. -/
@[mmp "thm_kr3e_well_tuned_max_order"]
public theorem maxOrder_wellTunedIdeal {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hXe : TopologicalSpace.Equidimensional X)
    (hdim : 1 ≤ topologicalKrullDim X)
    (I : X.IdealSheafData) (hm : 1 ≤ (maxOrder I).toNat) :
    maxOrder (wellTunedIdeal sX I) = ((maxOrder I).toNat.factorial : ℕ∞) :=
  maxOrder_maximalCoefficientIdeal sX ((MMP.Mori.isSmoothScheme_iff sX).mpr ‹_›) hXe hdim
    I hm (Nat.factorial_pos _)

end MMP.Resolution.Kollar

namespace MMP.Resolution

/-- Restricting a nonzerodivisor `g` of an affine open `V` to a basic open `D(a) ⊆ V` keeps it a
nonzerodivisor, and keeps its zero scheme smooth over the base. -/
private theorem restrict_basicOpen {X : Scheme.{u}} {S : Scheme.{u}} (sX : X ⟶ S)
    {V : X.Opens} (hV : IsAffineOpen V) (a g : Γ(X, V)) (hg : g ∈ nonZeroDivisors Γ(X, V))
    (hs : Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {g}))) ≫
        hV.isoSpec.inv ≫ V.ι ≫ sX)) :
    X.presheaf.map (homOfLE (X.basicOpen_le a)).op g ∈ nonZeroDivisors Γ(X, X.basicOpen a) ∧
      Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (Ideal.span {X.presheaf.map (homOfLE (X.basicOpen_le a)).op g}))) ≫
        (hV.basicOpen a).isoSpec.inv ≫ (X.basicOpen a).ι ≫ sX) := by
  let ρ := X.presheaf.map (homOfLE (X.basicOpen_le a)).op
  letI : Algebra Γ(X, V) Γ(X, X.basicOpen a) := ρ.hom.toAlgebra
  haveI : IsLocalization.Away a Γ(X, X.basicOpen a) := hV.isLocalization_basicOpen a
  refine ⟨IsLocalization.map_nonZeroDivisors_le (Submonoid.powers a) _ ⟨g, hg, rfl⟩, ?_⟩
  set I : Ideal Γ(X, V) := Ideal.span {g}
  set B := Γ(X, X.basicOpen a) ⧸ I.map (algebraMap Γ(X, V) Γ(X, X.basicOpen a))
  have hJ : Ideal.span {ρ g} = I.map (algebraMap Γ(X, V) Γ(X, X.basicOpen a)) := by
    rw [Ideal.map_span, Set.image_singleton]; rfl
  rw [hJ]
  haveI : IsLocalization.Away (Ideal.Quotient.mk I a) B := by
    have := IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      (Submonoid.powers a) Γ(X, X.basicOpen a) I
    rwa [Algebra.algebraMapSubmonoid, Submonoid.map_powers] at this
  have hsq : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (I.map (algebraMap Γ(X, V) Γ(X, X.basicOpen a))))) ≫
        (hV.basicOpen a).isoSpec.inv ≫ (X.basicOpen a).ι =
      Spec.map (CommRingCat.ofHom (algebraMap (Γ(X, V) ⧸ I) B)) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ hV.isoSpec.inv ≫ V.ι := by
    rw [IsAffineOpen.isoSpec_inv_ι, IsAffineOpen.isoSpec_inv_ι,
      ← hV.map_fromSpec (hV.basicOpen a) (homOfLE (X.basicOpen_le a)).op,
      ← Spec.map_comp_assoc, ← Spec.map_comp_assoc]
    congr 2
  have h := hsq =≫ sX
  simp only [Category.assoc] at h
  rw [h]
  haveI := IsOpenImmersion.of_isLocalization (S := B) (Ideal.Quotient.mk I a)
  infer_instance

/-- A section is a unit on every open inside its basic open. -/
private theorem isUnit_map_of_le_basicOpen {X : Scheme.{u}} {U W : X.Opens} (h : Γ(X, U))
    (i : W ≤ U) (hW : W ≤ X.basicOpen h) : IsUnit (X.presheaf.map (homOfLE i).op h) := by
  apply RingedSpace.isUnit_of_isUnit_germ X.toRingedSpace
  intro y hy
  convert (X.mem_basicOpen h y (i hy)).1 (hW hy) using 1
  exact X.presheaf.germ_res_apply (homOfLE i) y hy h

/-- The zero scheme of a unit is empty, hence smooth over anything. -/
private theorem smooth_of_isUnit {R : CommRingCat.{u}} {Y : Scheme.{u}} {f : R} (hf : IsUnit f)
    (φ : Spec (CommRingCat.of R) ⟶ Y) :
    Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) ≫ φ) := by
  haveI : Subsingleton (R ⧸ Ideal.span {f}) :=
    Ideal.Quotient.subsingleton_iff.2 (Ideal.span_singleton_eq_top.2 hf)
  haveI : IsEmpty (Spec (CommRingCat.of (R ⧸ Ideal.span {f}))) :=
    inferInstanceAs (IsEmpty (PrimeSpectrum _))
  infer_instance

/-- An ideal of order one in a local ring is contained in the maximal ideal but not in its
square. -/
private theorem le_maximalIdeal_and_not_le_sq_of_idealOrder_eq_one {R : Type*} [CommRing R]
    [IsLocalRing R] {J : Ideal R} (h : idealOrder J = 1) :
    J ≤ maximalIdeal R ∧ ¬ J ≤ maximalIdeal R ^ 2 := by
  refine ⟨?_, fun h2 => ?_⟩
  · simpa using (natCast_le_idealOrder_iff' J 1).1 (by simp [h])
  · have := (natCast_le_idealOrder_iff' J 2).2 h2
    rw [h] at this
    norm_num at this

/-- If the stalk of `J` at `x` is not contained in an ideal `P` of the local ring, some section
of `J` over an affine neighbourhood of `x` has germ outside `P`. -/
private theorem exists_mem_ideal_germ_notMem {X : Scheme.{u}} (J : X.IdealSheafData) {x : X}
    {U₀ : X.Opens} (hU₀ : IsAffineOpen U₀) (hx : x ∈ U₀) {P : Ideal (X.presheaf.stalk x)}
    (h : ¬ IdealSheafData.stalk J x ≤ P) :
    ∃ g ∈ J.ideal ⟨U₀, hU₀⟩, X.presheaf.germ U₀ x hx g ∉ P := by
  rwa [IdealSheafData.stalk_eq_map_germ J x ⟨U₀, hU₀⟩ hx, Ideal.map_le_iff_le_comap,
    SetLike.not_le_iff_exists] at h

/-- The local content of the theorem: inside any affine neighbourhood `U₀` of `x` there is an
affine neighbourhood `W` of `x` and a nonzerodivisor `f ∈ MC(I)(W)` with smooth zero scheme. -/
private theorem exists_affine_smooth_maximalContact {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : Equidimensional X) (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) {m : ℕ} (hm1 : 1 ≤ m)
    (hm : maxOrder I = m) {x : X} {U₀ : X.Opens} (hU₀ : IsAffineOpen U₀) (hxU₀ : x ∈ U₀) :
    ∃ (W : X.affineOpens) (_ : x ∈ W.1) (_ : W.1 ≤ U₀) (f : Γ(X, W.1)),
      f ∈ (maximalContactIdeal sX I).ideal W ∧ f ∈ nonZeroDivisors Γ(X, W.1) ∧
      Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) ≫
        W.2.isoSpec.inv ≫ W.1.ι ≫ sX) := by
  set J := maximalContactIdeal sX I
  have hle : multAt I x ≤ m :=
    hm ▸ le_iSup₂ (f := fun z (_ : z ∈ Set.univ) => multAt I z) x (Set.mem_univ x)
  rcases hle.lt_or_eq with hlt | heq
  · -- Below the maximal order, `MC(I)` is the unit ideal at `x`, so some section is a unit.
    have hA : IdealSheafData.stalk J x = ⊤ :=
      stalk_maximalContactIdeal_eq_top_of_multAt_lt sX hX hdim hI
        (by rw [hm]; exact ENat.coe_ne_top m) (hm ▸ hlt)
    obtain ⟨h, hh, hu⟩ := exists_mem_ideal_germ_notMem J hU₀ hxU₀
      (P := IsLocalRing.maximalIdeal _) (by simpa [hA] using Ideal.IsMaximal.ne_top inferInstance)
    obtain ⟨a, hah, hxa⟩ := hU₀.exists_basicOpen_le
      ⟨x, (X.mem_basicOpen h x hxU₀).2 (IsLocalRing.notMem_maximalIdeal.1 hu)⟩ hxU₀
    have hfu := isUnit_map_of_le_basicOpen h (X.basicOpen_le a) hah
    exact ⟨⟨_, hU₀.basicOpen a⟩, hxa, X.basicOpen_le a, _,
      J.ideal_le_comap_ideal (U := ⟨_, hU₀.basicOpen a⟩) (V := ⟨U₀, hU₀⟩) (X.basicOpen_le a) hh,
      hfu.mem_nonZeroDivisors, smooth_of_isUnit hfu _⟩
  · -- At the maximal order, `MC(I)` has order one at `x`, so some section is a parameter.
    obtain ⟨hle1, hnle⟩ := le_maximalIdeal_and_not_le_sq_of_idealOrder_eq_one
      (multAt_maximalContactIdeal_eq_one sX hX hI hm1 hm heq)
    obtain ⟨h, hh, hnot⟩ := exists_mem_ideal_germ_notMem J hU₀ hxU₀ hnle
    have hmem : X.presheaf.germ U₀ x hxU₀ h ∈ IsLocalRing.maximalIdeal _ := hle1 <| by
      rw [IdealSheafData.stalk_eq_map_germ J x ⟨U₀, hU₀⟩ hxU₀]
      exact Ideal.mem_map_of_mem _ hh
    obtain ⟨V, hxV, g, hgerm, hg, hs, -⟩ :=
      MMP.exists_isAffineOpen_smooth_zeroLocus_of_mem_maximalIdeal_notMem_sq sX x _ hmem hnot
    obtain ⟨W₀, hxW₀, iV, iU, heqW⟩ := X.presheaf.germ_eq x hxV hxU₀ g h hgerm
    obtain ⟨a, haW, hxa⟩ := V.2.exists_basicOpen_le (V := W₀ ⊓ U₀) ⟨x, hxW₀, hxU₀⟩ hxV
    have haU₀ : X.basicOpen a ≤ U₀ := haW.trans inf_le_right
    have hres : X.presheaf.map (homOfLE (X.basicOpen_le a)).op g =
        X.presheaf.map (homOfLE haU₀).op h := by
      have := congrArg (X.presheaf.map (homOfLE (haW.trans inf_le_left)).op) heqW
      rwa [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Functor.map_comp,
        ← Functor.map_comp] at this
    obtain ⟨hnzd, hsm⟩ := restrict_basicOpen sX V.2 a g hg hs
    refine ⟨⟨_, V.2.basicOpen a⟩, hxa, haU₀, _, ?_, hnzd, hsm⟩
    rw [hres]
    exact J.ideal_le_comap_ideal (U := ⟨_, V.2.basicOpen a⟩) (V := ⟨U₀, hU₀⟩) haU₀ hh

/-- **Local smooth sections of `L ⊗ MC(I)`** (Kollár Thm. 3.80(2)). Let `X` be smooth,
equidimensional and of finite type over a field `k` of characteristic `0`, with every irreducible
component of positive dimension, let `I` be an ideal sheaf nonzero at the generic point of every
irreducible component with `maxOrder I = m ≥ 1`, and let `L` be an invertible `𝒪_X`-module. Then
every `x : X` lies in an affine open `U` carrying a generator `e` of `L` on `U` and a section
`f ∈ (maximalContactIdeal sX I).ideal U`, a nonzerodivisor of `Γ(X, U)`, whose zero scheme `Spec
(Γ(X, U) ⧸ (f))` is smooth
over `k`; so `f • e` is a section of `L ⊗ MC(I)` over `U` with smooth zero scheme. -/
@[mmp "thm_kr3d_local_smooth_maximal_contact_section"]
public theorem exists_smul_generator_mem_maximalContactIdeal_smooth {k : Type u} [Field k]
    [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : Equidimensional X)
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) {m : ℕ} (hm1 : 1 ≤ m)
    (hm : maxOrder I = m) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] (x : X) :
    ∃ (U : X.affineOpens) (_ : x ∈ U.1) (e : Γ(L, U.1)) (f : Γ(X, U.1)),
      (∀ (W : X.Opens) (hW : W ≤ U.1) (s : Γ(L, W)),
        ∃! r : Γ(X, W), s = r • L.presheaf.map (homOfLE hW).op e) ∧
      f ∈ (maximalContactIdeal sX I).ideal U ∧ f ∈ nonZeroDivisors Γ(X, U.1) ∧
      Smooth (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f}))) ≫
        U.2.isoSpec.inv ≫ U.1.ι ≫ sX) := by
  obtain ⟨T, -, e, hxT, he⟩ :=
    MMP.Intersection.exists_isTrivializingGenerator L (V := ⊤) (x := x) trivial
  obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, hU₀T⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxT T.2
  obtain ⟨W, hxW, hWU₀, f, hfJ, hfnzd, hfs⟩ :=
    exists_affine_smooth_maximalContact sX hX hdim hI hm1 hm (U₀ := U₀) hU₀ hxU₀
  have hWT : W.1 ≤ T := hWU₀.trans hU₀T
  refine ⟨W, hxW, L.presheaf.map (homOfLE hWT).op e, f, fun W' hW' s => ?_, hfJ, hfnzd, hfs⟩
  simpa only [eq_comm] using ((he.res hWT) W' hW').existsUnique s

end MMP.Resolution

