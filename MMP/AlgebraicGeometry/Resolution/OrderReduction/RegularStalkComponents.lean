/-!
# Components of schemes with regular (hence domain) stalks

For a closed subscheme `D` smooth over a field, the irreducible components of the support of `D`
are pairwise disjoint, so any union of them is open and closed in the support and, with its reduced
structure, is again smooth. On a scheme smooth over a field, the stalks of the ideal sheaf of a
prime divisor are principal and generated by a prime element, which gives a stalkwise criterion
for an ideal sheaf to lie in a product of powers of prime divisors.

## Main definitions

* `componentCoeff`: the sum of the `A D` over the prime divisors `D` which are components of `Y`
  through `x`.

## Main results

* `eq_of_mem_componentsOf_of_isSmoothScheme`: two components of the support of a smooth closed
  subscheme that meet are equal.
* `componentCoeff_eq_of_isPreconnected`: `componentCoeff Y A` is constant on preconnected subsets
  of the support of a smooth `Y`.
* `isSmoothScheme_vanishingIdeal_union_components`: a union of components of the support of a
  smooth closed subscheme, with its reduced structure, is smooth.
* `exists_prime_stalk_idealSheaf`: the ideal stalks of a prime divisor on a smooth scheme are
  generated by prime elements.
* `le_prod_of_stalk_le`: an ideal sheaf whose stalk at the generic point of each `D ∈ F` lies in
  the `A D`-th power of the maximal ideal is contained in `∏ D ∈ F, D.idealSheaf ^ A D`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

universe u

namespace MMP.Resolution

namespace Aux

section Top

variable {T : Type*} [TopologicalSpace T]

/-- Each irreducible component of a closed set `D` is closed. -/
theorem isClosed_of_mem_componentsOf {D : Set T} (hD : IsClosed D) {W : Set T}
    (hW : W ∈ componentsOf D) : IsClosed W := by
  have h1 : IsIrreducible (closure W) := hW.1.1.closure
  have h2 : closure W ⊆ D := closure_minimal hW.1.2 hD
  exact closure_subset_iff_isClosed.mp (hW.2 ⟨h1, h2⟩ subset_closure)

/-- In a Noetherian space, a closed set `D` has finitely many irreducible components, and they
cover `D`. -/
theorem finite_and_cover_componentsOf [NoetherianSpace T] {D : Set T} (hD : IsClosed D) :
    (componentsOf D).Finite ∧ D ⊆ ⋃₀ componentsOf D := by
  obtain ⟨S, hSf, hSc, hSi, hSU⟩ := NoetherianSpace.exists_finite_set_isClosed_irreducible hD
  have hsub : ∀ u : Set T, IsIrreducible u → u ⊆ D → ∃ z ∈ S, u ⊆ z := by
    intro u hu huD
    obtain ⟨z, hz, huz⟩ := isIrreducible_iff_sUnion_isClosed.mp hu hSf.toFinset
      (fun z hz => hSc z (hSf.mem_toFinset.mp hz)) (by rw [hSf.coe_toFinset, ← hSU]; exact huD)
    exact ⟨z, hSf.mem_toFinset.mp hz, huz⟩
  refine ⟨hSf.subset fun W hW => ?_, fun y hy => ?_⟩
  · obtain ⟨z, hz, hWz⟩ := hsub W hW.1.1 hW.1.2
    have : z ⊆ W := hW.2 ⟨hSi z hz, by rw [hSU]; exact Set.subset_sUnion_of_mem hz⟩ hWz
    rwa [Set.Subset.antisymm hWz this]
  · rw [hSU] at hy
    obtain ⟨t, ht, hyt⟩ := hy
    obtain ⟨b, htb, hb⟩ := hSf.exists_le_maximal ht
    refine ⟨b, ⟨⟨hSi b hb.1, by rw [hSU]; exact Set.subset_sUnion_of_mem hb.1⟩, ?_⟩, htb hyt⟩
    intro u ⟨hu, huD⟩ hbu
    obtain ⟨z, hz, huz⟩ := hsub u hu huD
    exact huz.trans (hb.2 hz (hbu.trans huz))

/-- In a Noetherian space, if any two irreducible components of the closed set `D` that meet are
equal, then each point `x` of a component `W` has an open neighbourhood `V` with `V ∩ D ⊆ W`. -/
theorem exists_isOpen_inter_subset [NoetherianSpace T] {D : Set T} (hD : IsClosed D)
    (huniq : ∀ {W₁ W₂ : Set T}, W₁ ∈ componentsOf D → W₂ ∈ componentsOf D → ∀ {x : T},
      x ∈ W₁ → x ∈ W₂ → W₁ = W₂)
    {W : Set T} (hW : W ∈ componentsOf D) {x : T} (hx : x ∈ W) :
    ∃ V : Set T, IsOpen V ∧ x ∈ V ∧ V ∩ D ⊆ W := by
  obtain ⟨hfin, hcov⟩ := finite_and_cover_componentsOf hD
  have hcl : IsClosed (⋃₀ (componentsOf D \ {W})) :=
    (hfin.subset Set.diff_subset).isClosed_sUnion
      fun W' hW' => isClosed_of_mem_componentsOf hD hW'.1
  refine ⟨(⋃₀ (componentsOf D \ {W}))ᶜ, hcl.isOpen_compl, ?_, ?_⟩
  · rintro ⟨W', hW', hxW'⟩
    exact hW'.2 (huniq hW'.1 hW hxW' hx)
  · rintro y ⟨hyV, hyD⟩
    obtain ⟨W', hW', hyW'⟩ := hcov hyD
    by_cases h : W' = W
    · exact h ▸ hyW'
    · exact absurd ⟨W', ⟨hW', h⟩, hyW'⟩ hyV

end Top

/-- If the stalk of a scheme at `x` is a domain, then `x` has a generization `ξ` which generizes
every generization of `x`. -/
theorem exists_generization_of_isDomain_stalk {S : Scheme.{u}} (x : S)
    [IsDomain (S.presheaf.stalk x)] :
    ∃ ξ : S, ξ ⤳ x ∧ ∀ z : S, z ⤳ x → ξ ⤳ z := by
  haveI : IrreducibleSpace (Spec (S.presheaf.stalk x)) := inferInstance
  refine ⟨S.fromSpecStalk x (genericPoint (Spec (S.presheaf.stalk x))), ?_, ?_⟩
  · have h := ((genericPoint_specializes (IsLocalRing.closedPoint (S.presheaf.stalk x))).map
      (S.fromSpecStalk x).continuous)
    rwa [Scheme.fromSpecStalk_closedPoint] at h
  · intro z hz
    have hz' : z ∈ Set.range (S.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]; exact hz
    obtain ⟨w, rfl⟩ := hz'
    exact (genericPoint_specializes w).map (S.fromSpecStalk x).continuous

/-- A component of the support of `D` (a closed set) is the closure of a point. -/
theorem exists_eq_closure_of_mem_componentsOf {X : Scheme.{u}} {D : Set X} (hD : IsClosed D)
    {W : Set X} (hW : W ∈ componentsOf D) : ∃ ξ : X, ξ ∈ D ∧ W = closure {ξ} := by
  obtain ⟨ξ, hξ⟩ := QuasiSober.sober hW.1.1 (isClosed_of_mem_componentsOf hD hW)
  exact ⟨ξ, hW.1.2 hξ.mem, hξ.def.symm⟩

/-- If the closed subscheme `D` is smooth over a field `k`, then two irreducible components of the
support of `D` that meet are equal. -/
theorem eq_of_mem_componentsOf_of_isSmoothScheme {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX))
    {W₁ W₂ : Set X} (h₁ : W₁ ∈ componentsOf (D.support : Set X))
    (h₂ : W₂ ∈ componentsOf (D.support : Set X)) {x : X} (hx₁ : x ∈ W₁) (hx₂ : x ∈ W₂) :
    W₁ = W₂ := by
  have : LocallyOfFinitePresentation (D.subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := D.subschemeι ≫ sX)).mpr
      inferInstance
  have hsm : Smooth (D.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).1 hD
  have hcl : IsClosed (D.support : Set X) := D.support.isClosed
  have hrange : Set.range D.subschemeι = (D.support : Set X) := D.range_subschemeι
  obtain ⟨x', rfl⟩ : x ∈ Set.range D.subschemeι := by
    rw [hrange]; exact h₁.1.2 hx₁
  haveI : IsDomain (D.subscheme.presheaf.stalk x') := by
    haveI := isRegularLocalRing_stalk_of_smooth_over_field (D.subschemeι ≫ sX) x'
    exact IsRegularLocalRing.isDomain _
  obtain ⟨ξ', hξ'x, hξ'⟩ := exists_generization_of_isDomain_stalk x'
  have key : ∀ {W : Set X}, W ∈ componentsOf (D.support : Set X) → D.subschemeι x' ∈ W →
      W = closure {D.subschemeι ξ'} := by
    intro W hW hxW
    obtain ⟨ξ, hξD, hWξ⟩ := exists_eq_closure_of_mem_componentsOf hcl hW
    obtain ⟨ξ1, rfl⟩ : ξ ∈ Set.range D.subschemeι := by rwa [hrange]
    have hspec : D.subschemeι ξ1 ⤳ D.subschemeι x' := by
      rw [specializes_iff_mem_closure, ← hWξ]; exact hxW
    have hspec' : ξ1 ⤳ x' := D.subschemeι.isClosedEmbedding.isInducing.specializes_iff.mp hspec
    have h4 : D.subschemeι ξ' ⤳ D.subschemeι ξ1 := (hξ' ξ1 hspec').map D.subschemeι.continuous
    apply le_antisymm
    · rw [hWξ]
      exact closure_minimal (by simpa using (specializes_iff_mem_closure.mp h4)) isClosed_closure
    · have hirr : IsIrreducible (closure {D.subschemeι ξ'}) := isIrreducible_singleton.closure
      have hsub : closure {D.subschemeι ξ'} ⊆ (D.support : Set X) :=
        closure_minimal (by rintro _ rfl; rw [← hrange]; exact ⟨ξ', rfl⟩) hcl
      refine hW.2 ⟨hirr, hsub⟩ ?_
      rw [hWξ]
      exact closure_minimal (by simpa using (specializes_iff_mem_closure.mp h4)) isClosed_closure
  rw [key h₁ hx₁, key h₂ hx₂]

/-- A scheme quasi-compact and locally of finite type over a field is a Noetherian topological
space. -/
theorem noetherianSpace_of_finiteType {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] : NoetherianSpace X := by
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsNoetherian X := ⟨⟩
  infer_instance

/-- Near a point `x` of a component `W` of the support of a smooth closed subscheme `D`, `D` is
contained in `W`. -/
theorem exists_isOpen_inter_support_subset {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX)) {W : Set X}
    (hW : W ∈ componentsOf (D.support : Set X)) {x : X} (hx : x ∈ W) :
    ∃ V : Set X, IsOpen V ∧ x ∈ V ∧ V ∩ (D.support : Set X) ⊆ W := by
  haveI := noetherianSpace_of_finiteType sX
  exact exists_isOpen_inter_subset D.support.isClosed
    (fun h₁ h₂ _ hx₁ hx₂ => eq_of_mem_componentsOf_of_isSmoothScheme sX D hD h₁ h₂ hx₁ hx₂) hW hx

open Classical in
/-- The coefficient in `A` of the component of `Y` through `x`: the sum of the `A D` over the
prime divisors `D` which are components of `Y` through `x`. -/
def componentCoeff {X : Scheme.{u}} (Y : X.IdealSheafData)
    (A : AlgebraicGeometry.PrimeDivisor X → ℕ) (x : X) : ℕ :=
  ∑ᶠ D : AlgebraicGeometry.PrimeDivisor X,
    if D.support ∈ componentsOf (Y.support : Set X) ∧ x ∈ D.support then A D else 0

/-- If `Y` is smooth over `k` and `A` has finite support, then `componentCoeff Y A` is locally
constant on the support of `Y`. -/
theorem eventually_componentCoeff_eq {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (Y : X.IdealSheafData)
    (hY : MMP.Mori.IsSmoothScheme (Y.subschemeι ≫ sX))
    (A : AlgebraicGeometry.PrimeDivisor X → ℕ) (hA : (Function.support A).Finite) {x : X}
    (hx : x ∈ (Y.support : Set X)) :
    ∀ᶠ y in nhdsWithin x (Y.support : Set X), componentCoeff Y A y = componentCoeff Y A x := by
  classical
  have hind : ∀ D : AlgebraicGeometry.PrimeDivisor X, ∀ᶠ y in nhdsWithin x (Y.support : Set X),
      ((D.support ∈ componentsOf (Y.support : Set X) ∧ y ∈ D.support) ↔
        (D.support ∈ componentsOf (Y.support : Set X) ∧ x ∈ D.support)) := by
    intro D
    by_cases hDc : D.support ∈ componentsOf (Y.support : Set X)
    · by_cases hxD : x ∈ D.support
      · obtain ⟨V, hVo, hxV, hVW⟩ := exists_isOpen_inter_support_subset sX Y hY hDc hxD
        filter_upwards [inter_mem_nhdsWithin _ (hVo.mem_nhds hxV), self_mem_nhdsWithin]
          with y hy hy'
        exact ⟨fun h => ⟨hDc, hxD⟩, fun _ => ⟨hDc, hVW ⟨hy.2, hy'⟩⟩⟩
      · have hcl : IsClosed (D.support : Set X) := D.idealSheaf.support.isClosed
        filter_upwards [nhdsWithin_le_nhds (hcl.isOpen_compl.mem_nhds hxD)] with y hy
        exact ⟨fun h => absurd h.2 hy, fun h => absurd h.2 hxD⟩
    · exact Filter.Eventually.of_forall fun y => ⟨fun h => absurd h.1 hDc, fun h => absurd h.1 hDc⟩
  have hF := (Filter.eventually_all_finite hA).mpr (fun D _ => hind D)
  filter_upwards [hF] with y hy
  unfold componentCoeff
  refine finsum_congr fun D => ?_
  by_cases hD : A D = 0
  · simp [hD]
  · simp only [hy D hD]

/-- If `Y` is smooth over `k` and `A` has finite support, then `componentCoeff Y A` is constant on
every preconnected subset of the support of `Y`. -/
theorem componentCoeff_eq_of_isPreconnected {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (Y : X.IdealSheafData)
    (hY : MMP.Mori.IsSmoothScheme (Y.subschemeι ≫ sX))
    (A : AlgebraicGeometry.PrimeDivisor X → ℕ) (hA : (Function.support A).Finite) {S : Set X}
    (hS : _root_.IsPreconnected S) (hSY : S ⊆ (Y.support : Set X)) {x y : X} (hx : x ∈ S)
    (hy : y ∈ S) :
    componentCoeff Y A y = componentCoeff Y A x := by
  have hc : ContinuousOn (componentCoeff Y A) S := by
    intro z hz
    rw [ContinuousWithinAt, nhds_discrete, Filter.tendsto_pure]
    exact (eventually_componentCoeff_eq sX Y hY A hA (hSY hz)).filter_mono (nhdsWithin_mono z hSY)
  exact hS.constant_of_mapsTo (T := Set.univ) IsDiscrete.univ hc (fun _ _ => trivial) hy hx

/-- A smooth closed subscheme is reduced. -/
theorem isReduced_subscheme_of_isSmoothScheme {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX)) : IsReduced D.subscheme := by
  have : LocallyOfFinitePresentation (D.subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := D.subschemeι ≫ sX)).mpr
      inferInstance
  have hsm : Smooth (D.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).1 hD
  exact AlgebraicGeometry.TameCovers.isReduced_subscheme_of_isRegularLocalRing D
    (fun z => isRegularLocalRing_stalk_of_smooth_over_field (D.subschemeι ≫ sX) z)

/-- Let `g` be surjective on stalks at `i y`. If every element killed by the stalk map of `i ≫ g`
at `y` is killed by the stalk map of `g` at `i y`, then the stalk map of `i` at `y` is injective.
-/
theorem stalkMap_injective_of_comp {A B X : Scheme.{u}} (i : A ⟶ B) (g : B ⟶ X) (y : A)
    (hg : Function.Surjective (g.stalkMap (i y)))
    (hker : ∀ b : X.presheaf.stalk (g (i y)),
      (i ≫ g).stalkMap y b = 0 → g.stalkMap (i y) b = 0) :
    Function.Injective (i.stalkMap y) := by
  rw [injective_iff_map_eq_zero]
  intro a ha
  obtain ⟨b, rfl⟩ := hg a
  exact hker b (by rw [Scheme.Hom.stalkMap_comp]; exact ha)

/-- A union `T` of components of the support of a smooth `D` is cut out of it by a closed
complement `R`. -/
theorem exists_closed_complement_of_union_components {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX)) (S : Set (Set X))
    (hS : S ⊆ componentsOf (D.support : Set X)) :
    ∃ R : Set X, IsClosed R ∧ Disjoint (⋃₀ S) R ∧ (D.support : Set X) = ⋃₀ S ∪ R := by
  haveI := noetherianSpace_of_finiteType sX
  have hcl : IsClosed (D.support : Set X) := D.support.isClosed
  obtain ⟨hfin, hcov⟩ := finite_and_cover_componentsOf hcl
  refine ⟨⋃₀ (componentsOf (D.support : Set X) \ S),
    (hfin.subset Set.diff_subset).isClosed_sUnion
      fun W hW => isClosed_of_mem_componentsOf hcl hW.1, ?_, ?_⟩
  · rw [Set.disjoint_left]
    rintro x ⟨W, hWS, hxW⟩ ⟨W', hW', hxW'⟩
    exact hW'.2 (eq_of_mem_componentsOf_of_isSmoothScheme sX D hD (hS hWS) hW'.1 hxW hxW' ▸ hWS)
  · apply Set.Subset.antisymm
    · intro x hx
      obtain ⟨W, hW, hxW⟩ := hcov hx
      by_cases h : W ∈ S
      · exact Or.inl ⟨W, h, hxW⟩
      · exact Or.inr ⟨W, ⟨hW, h⟩, hxW⟩
    · rintro x (⟨W, hWS, hxW⟩ | ⟨W, hW, hxW⟩)
      · exact (hS hWS).1.2 hxW
      · exact hW.1.1.2 hxW

/-- If `φ` equals the closed immersion `Z.subschemeι`, then the kernel of the stalk map of `φ` at
`y` is the stalk of the ideal sheaf `Z` at `φ y`. -/
theorem ker_stalkMap_eq_stalk_of_eq {X : Scheme.{u}} (Z : X.IdealSheafData)
    (φ : Z.subscheme ⟶ X) (hφ : φ = Z.subschemeι) (y : Z.subscheme) :
    RingHom.ker (φ.stalkMap y).hom = IdealSheafData.stalk Z (φ y) := by
  subst hφ
  exact Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk Z y

/-- If `D` is reduced and its support is the disjoint union of `T` and a closed set `R`, then the
ideal stalks of `D` and of the vanishing ideal of `T` agree at points of `T`. -/
theorem stalk_vanishingIdeal_eq_of_support_eq_union {X : Scheme.{u}} (D : X.IdealSheafData)
    [IsReduced D.subscheme] {T : Closeds X} {R : Set X} (hRcl : IsClosed R)
    (hdisj : Disjoint (T : Set X) R) (hsup : (D.support : Set X) = (T : Set X) ∪ R) {x : X}
    (hx : x ∈ (T : Set X)) :
    IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal T) x =
      IdealSheafData.stalk D x := by
  have h1 := IdealSheafData.stalk_vanishingIdeal_congr (S := T) (T := D.support)
    (V := ⟨Rᶜ, hRcl.isOpen_compl⟩) (x := x) (Set.disjoint_left.mp hdisj hx) (by
      ext z
      constructor
      · rintro ⟨hz, hzR⟩
        exact ⟨by rw [hsup]; exact Or.inl hz, hzR⟩
      · rintro ⟨hz, hzR⟩
        rw [hsup] at hz
        rcases hz with hz | hz
        · exact ⟨hz, hzR⟩
        · exact absurd hz hzR)
  rw [h1, ← Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme D D.support rfl]

/-- If the support of `D` is the disjoint union of `T` and a closed set `R`, then the inclusion of
the reduced subscheme on `T` into the subscheme `D` is an open embedding. -/
theorem isOpenEmbedding_inclusion_of_support_eq_union {X : Scheme.{u}} {D : X.IdealSheafData}
    {T : Closeds X} {R : Set X} (hRcl : IsClosed R) (hdisj : Disjoint (T : Set X) R)
    (hsup : (D.support : Set X) = (T : Set X) ∪ R)
    (hDZ : D ≤ Scheme.IdealSheafData.vanishingIdeal T) :
    Topology.IsOpenEmbedding (Scheme.IdealSheafData.inclusion hDZ) := by
  set Z := Scheme.IdealSheafData.vanishingIdeal T with hZ
  have hZsupp : (Z.support : Set X) = T := by simp [hZ]
  set i := Scheme.IdealSheafData.inclusion hDZ
  have hie : i ≫ D.subschemeι = Z.subschemeι := Scheme.IdealSheafData.inclusion_subschemeι hDZ
  haveI : IsClosedImmersion (i ≫ D.subschemeι) := by rw [hie]; infer_instance
  have hi : IsClosedImmersion i := IsClosedImmersion.of_comp_isClosedImmersion i D.subschemeι
  have hrange : Set.range i = D.subschemeι ⁻¹' (T : Set X) := by
    ext y
    constructor
    · rintro ⟨z, rfl⟩
      have : Z.subschemeι z ∈ Set.range Z.subschemeι := ⟨z, rfl⟩
      rwa [Scheme.IdealSheafData.range_subschemeι, hZsupp, ← hie] at this
    · intro hy
      obtain ⟨z, hz⟩ : D.subschemeι y ∈ Set.range Z.subschemeι := by
        rwa [Scheme.IdealSheafData.range_subschemeι, hZsupp]
      rw [← hie] at hz
      exact ⟨z, D.subschemeι.isClosedEmbedding.injective hz⟩
  have hpre : D.subschemeι ⁻¹' (T : Set X) = D.subschemeι ⁻¹' Rᶜ := by
    ext y
    have hy : D.subschemeι y ∈ (D.support : Set X) := by
      rw [← Scheme.IdealSheafData.range_subschemeι]; exact ⟨y, rfl⟩
    rw [hsup] at hy
    simp only [Set.mem_preimage, Set.mem_compl_iff]
    exact ⟨fun h h' => Set.disjoint_left.mp hdisj h h', fun h => Or.resolve_right hy h⟩
  refine ⟨hi.isClosedEmbedding.isEmbedding, ?_⟩
  rw [hrange, hpre]
  exact hRcl.isOpen_compl.preimage D.subschemeι.continuous

/-- If `D ≤ Z` and the ideal stalks of `Z` and `D` agree on the support of `Z`, then the stalk maps
of the inclusion of the subscheme `Z` into the subscheme `D` are isomorphisms. -/
theorem isIso_stalkMap_inclusion {X : Scheme.{u}} {D Z : X.IdealSheafData} (hDZ : D ≤ Z)
    (hstalk : ∀ x ∈ (Z.support : Set X), IdealSheafData.stalk Z x = IdealSheafData.stalk D x)
    (y : Z.subscheme) : IsIso ((Scheme.IdealSheafData.inclusion hDZ).stalkMap y) := by
  set i := Scheme.IdealSheafData.inclusion hDZ
  have hie : i ≫ D.subschemeι = Z.subschemeι := Scheme.IdealSheafData.inclusion_subschemeι hDZ
  haveI : IsClosedImmersion (i ≫ D.subschemeι) := by rw [hie]; infer_instance
  haveI : IsClosedImmersion i := IsClosedImmersion.of_comp_isClosedImmersion i D.subschemeι
  rw [ConcreteCategory.isIso_iff_bijective]
  refine ⟨stalkMap_injective_of_comp i D.subschemeι y (D.subschemeι.stalkMap_surjective _)
    fun b hb => ?_, i.stalkMap_surjective y⟩
  have hmem : b ∈ IdealSheafData.stalk Z ((i ≫ D.subschemeι) y) := by
    rwa [← ker_stalkMap_eq_stalk_of_eq Z (i ≫ D.subschemeι) hie y]
  have hxZ : (i ≫ D.subschemeι) y ∈ (Z.support : Set X) := by
    rw [hie, ← Scheme.IdealSheafData.range_subschemeι]; exact ⟨y, rfl⟩
  rw [hstalk _ hxZ] at hmem
  have hmem2 : b ∈ IdealSheafData.stalk D (D.subschemeι (i y)) := hmem
  rwa [← Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk D (i y)] at hmem2

/-- A union of components of the support of a smooth `D`, with its reduced structure, is smooth. -/
theorem isSmoothScheme_vanishingIdeal_union_components {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX)) (S : Set (Set X))
    (hS : S ⊆ componentsOf (D.support : Set X)) (T : Closeds X) (hT : (T : Set X) = ⋃₀ S) :
    MMP.Mori.IsSmoothScheme ((Scheme.IdealSheafData.vanishingIdeal T).subschemeι ≫ sX) := by
  obtain ⟨R, hRcl, hdisj, hsup⟩ := exists_closed_complement_of_union_components sX D hD S hS
  rw [← hT] at hdisj hsup
  haveI := isReduced_subscheme_of_isSmoothScheme sX D hD
  have hTD : (T : Set X) ⊆ D.support := by rw [hsup]; exact Set.subset_union_left
  have hDZ : D ≤ Scheme.IdealSheafData.vanishingIdeal T :=
    Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal.mp hTD
  have hie := Scheme.IdealSheafData.inclusion_subschemeι hDZ
  haveI := isIso_stalkMap_inclusion hDZ fun x hx =>
    stalk_vanishingIdeal_eq_of_support_eq_union D hRcl hdisj hsup (by simpa using hx)
  haveI : IsOpenImmersion (Scheme.IdealSheafData.inclusion hDZ) :=
    IsOpenImmersion.of_isIso_stalkMap _
      (isOpenEmbedding_inclusion_of_support_eq_union hRcl hdisj hsup hDZ)
  haveI : LocallyOfFinitePresentation
      ((Scheme.IdealSheafData.vanishingIdeal T).subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := (Scheme.IdealSheafData.vanishingIdeal T).subschemeι ≫ sX)).mpr inferInstance
  haveI : LocallyOfFinitePresentation (D.subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := D.subschemeι ≫ sX)).mpr
      inferInstance
  haveI : Smooth (D.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).1 hD
  rw [MMP.Mori.isSmoothScheme_iff, ← hie, Category.assoc]
  infer_instance

/-- On a scheme quasi-compact and locally of finite type over a field, a union of irreducible
components of the support of `D` is closed. -/
theorem isClosed_sUnion_of_subset_componentsOf {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (S : Set (Set X)) (hS : S ⊆ componentsOf (D.support : Set X)) : IsClosed (⋃₀ S) := by
  haveI := noetherianSpace_of_finiteType sX
  have hfin := (finite_and_cover_componentsOf D.support.isClosed).1.subset hS
  exact hfin.isClosed_sUnion fun W hW => isClosed_of_mem_componentsOf D.support.isClosed (hS hW)

/-- If the support of `D` has pure codimension one, then so does every closed set `T` which is a
union of irreducible components of it. -/
theorem isPureCodimOne_union_components {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (hD' : MMP.Mori.IsPureCodimOne D.support) (S : Set (Set X))
    (hS : S ⊆ componentsOf (D.support : Set X)) (T : Closeds X) (hT : (T : Set X) = ⋃₀ S) :
    MMP.Mori.IsPureCodimOne T := by
  haveI := noetherianSpace_of_finiteType sX
  have hcl := D.support.isClosed
  have hfin : S.Finite := (finite_and_cover_componentsOf hcl).1.subset hS
  intro W hW
  have hWsub : (W : Set X) ⊆ ⋃₀ S := hT ▸ hW.1
  obtain ⟨z, hz, hWz⟩ := isIrreducible_iff_sUnion_isClosed.mp W.isIrreducible hfin.toFinset
    (fun z hz => isClosed_of_mem_componentsOf hcl (hS (hfin.mem_toFinset.mp hz)))
    (by rw [hfin.coe_toFinset]; exact hWsub)
  have hzS := hfin.mem_toFinset.mp hz
  let W1 : IrreducibleCloseds X :=
    ⟨z, (hS hzS).1.1, isClosed_of_mem_componentsOf hcl (hS hzS)⟩
  have hW1T : (W1 : Set X) ⊆ T := by
    rw [hT]; exact Set.subset_sUnion_of_mem hzS
  have hWW1 : W ≤ W1 := hWz
  have hEq : W = W1 := le_antisymm hWW1 (hW.2 hW1T hWW1)
  refine hD' W ⟨hW.1.trans (by rw [hT]; exact fun x ⟨W', hW', hx⟩ => (hS hW').1.2 hx), ?_⟩
  intro y hy hWy
  have : (W1 : Set X) ⊆ y := by rw [← hEq]; exact hWy
  rw [hEq]
  exact (hS hzS).2 ⟨y.isIrreducible, hy⟩ this

/-- If `D` is smooth over `k` and `x` lies in a union `⋃₀ S` of irreducible components of the
support of `D`, then the connected component of `x` in the support of `D` is contained in `⋃₀ S`.
-/
theorem connectedComponentIn_subset_union_components {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] (D : X.IdealSheafData)
    (hD : MMP.Mori.IsSmoothScheme (D.subschemeι ≫ sX)) (S : Set (Set X))
    (hS : S ⊆ componentsOf (D.support : Set X)) {x : X} (hx : x ∈ ⋃₀ S) :
    connectedComponentIn (D.support : Set X) x ⊆ ⋃₀ S := by
  obtain ⟨R, hRcl, hdisj, hsup⟩ := exists_closed_complement_of_union_components sX D hD S hS
  have hU := isClosed_sUnion_of_subset_componentsOf sX D S hS
  have hxD : x ∈ (D.support : Set X) := by rw [hsup]; exact Or.inl hx
  rcases isPreconnected_iff_subset_of_disjoint_closed.mp isPreconnected_connectedComponentIn
    _ _ hU hRcl ((connectedComponentIn_subset _ x).trans hsup.subset) (by
      apply Set.eq_empty_of_forall_notMem
      rintro z ⟨-, hzU, hzR⟩
      exact Set.disjoint_left.mp hdisj hzU hzR) with h | h
  · exact h
  · exact absurd (h (mem_connectedComponentIn hxD)) (Set.disjoint_left.mp hdisj hx)

/-! ### Stalks of ideal sheaves -/

section Stalks

variable {X : Scheme.{u}}

/-- The stalk of the unit ideal sheaf is the unit ideal. -/
theorem stalk_top (x : X) : IdealSheafData.stalk (⊤ : X.IdealSheafData) x = ⊤ := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) (by simp)
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU]
  simp only [Scheme.IdealSheafData.ideal_top]
  exact Ideal.map_top _

/-- The stalk of a product of ideal sheaves is the product of the stalks. -/
theorem stalk_mul (I J : X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (I * J) x = IdealSheafData.stalk I x * IdealSheafData.stalk J x := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) (by simp)
  simp only [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU, Scheme.IdealSheafData.ideal_mul,
    Pi.mul_apply, Ideal.map_mul]

/-- The stalk of a power of an ideal sheaf is the power of the stalk. -/
theorem stalk_pow (I : X.IdealSheafData) (n : ℕ) (x : X) :
    IdealSheafData.stalk (I ^ n) x = IdealSheafData.stalk I x ^ n := by
  induction n with
  | zero => simpa using stalk_top x
  | succ n ih => rw [pow_succ, stalk_mul, ih, pow_succ]

/-- The stalk of a finite product of ideal sheaves is the product of the stalks. -/
theorem stalk_prod {ι : Type*} (s : Finset ι) (I : ι → X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (∏ i ∈ s, I i) x = ∏ i ∈ s, IdealSheafData.stalk (I i) x := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using stalk_top x
  | insert a s ha ih => rw [Finset.prod_insert ha, Finset.prod_insert ha, stalk_mul, ih]

/-- If `y ⤳ x`, the stalk of `I` at `y` is the image of the stalk of `I` at `x` under the
specialization map. -/
theorem stalk_eq_map_stalkSpecializes (I : X.IdealSheafData) {y x : X} (h : y ⤳ x) :
    IdealSheafData.stalk I y = Ideal.map (X.presheaf.stalkSpecializes h).hom
      (IdealSheafData.stalk I x) := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) (by simp)
  have hyU : y ∈ U := h.mem_open U.isOpen hxU
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU,
    IdealSheafData.stalk_eq_map_germ _ y ⟨U, hU⟩ hyU, Ideal.map_map]
  congr 1
  ext a
  have := X.presheaf.germ_stalkSpecializes hxU h
  exact (congrArg (fun f => f.hom a) this).symm

end Stalks

/-! ### Prime divisors on a smooth scheme -/

section PrimeDiv

variable {X : Scheme.{u}}

/-- A prime divisor is determined by its support. -/
theorem PrimeDivisor.eq_of_support_eq {D D' : AlgebraicGeometry.PrimeDivisor X}
    (h : (D.support : Set X) = D'.support) : D = D' := by
  haveI := D.integral
  haveI := D'.integral
  have e1 := Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme D.idealSheaf
    D.idealSheaf.support rfl
  have e2 := Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme D'.idealSheaf
    D'.idealSheaf.support rfl
  have h' : D.idealSheaf.support = D'.idealSheaf.support := Closeds.ext h
  have : D.idealSheaf = D'.idealSheaf := by rw [e1, e2, h']
  cases D; cases D'
  simp only at this
  subst this
  rfl

/-- The generic point of a prime divisor specializes to every point of its support. -/
theorem genericPoint_specializes_of_mem_support (D : AlgebraicGeometry.PrimeDivisor X) {x : X}
    (hx : x ∈ D.support) : D.genericPoint ⤳ x := by
  haveI := D.integral
  have := Stacks.Chow.support_eq_closure_genericPointOf D.idealSheaf D.integral
  rw [specializes_iff_mem_closure]
  have hx' : x ∈ (D.idealSheaf.support : Set X) := hx
  rw [this] at hx'
  exact hx'

/-- A morphism to `Spec k`, locally of finite type and satisfying `MMP.Mori.IsSmoothScheme`, is
smooth. -/
theorem smooth_of_isSmoothScheme' {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX) :
    Smooth sX := by
  have : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  exact (MMP.Mori.isSmoothScheme_iff sX).1 h

/-- On a scheme smooth over a field, the ideal sheaf of a prime divisor is an effective Cartier
divisor. -/
theorem isEffectiveCartierDivisor_idealSheaf {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (D : AlgebraicGeometry.PrimeDivisor X) :
    Stacks.Divisors.IsEffectiveCartierDivisor D.idealSheaf := by
  haveI := D.integral
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  haveI := smooth_of_isSmoothScheme' sX h
  exact isEffectiveCartierDivisor_of_codimension_one_of_uniqueFactorizationMonoid D.idealSheaf
    D.codimension_one (fun x _ => by
      haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
      exact IsRegularLocalRing.uniqueFactorizationMonoid _)

/-- On a scheme smooth over a field, the stalk of the ideal sheaf of a prime divisor `D` at a point
of its support is generated by a prime element. -/
theorem exists_prime_stalk_idealSheaf {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (D : AlgebraicGeometry.PrimeDivisor X) {x : X} (hx : x ∈ D.support) :
    ∃ π : X.presheaf.stalk x, Prime π ∧
      IdealSheafData.stalk D.idealSheaf x = Ideal.span {π} := by
  haveI := D.integral
  have hcart := isEffectiveCartierDivisor_idealSheaf sX h D
  obtain ⟨U, hU, hxU, f, hf, hspan⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D.idealSheaf
      hcart x
  set g : X.presheaf.stalk x := (X.presheaf.germ U x hxU).hom f
  have hstalk : IdealSheafData.stalk D.idealSheaf x = Ideal.span {g} := by
    rw [AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ D.idealSheaf x ⟨U, hU⟩ hxU, hspan,
      Ideal.map_span, Set.image_singleton]
  have hg0 : g ≠ 0 :=
    nonZeroDivisors.ne_zero (Stacks.Divisors.germ_mem_nonZeroDivisors hU hf x hxU)
  refine ⟨g, ?_, hstalk⟩
  rw [← Ideal.span_singleton_prime hg0, ← hstalk]
  obtain ⟨y, rfl⟩ : x ∈ Set.range D.idealSheaf.subschemeι := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  rw [← Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk]
  exact RingHom.ker_isPrime _

/-- Let `S` be the localization of a domain `R` at a prime `P`, and let `π ∈ P` be prime. If the
image of `f` in `S` lies in `(π) ^ a`, then `π ^ a ∣ f`. -/
theorem pow_dvd_of_map_mem {R S : Type*} [CommRing R] [IsDomain R] [CommRing S] [Algebra R S]
    (P : Ideal R) [P.IsPrime] [IsLocalization.AtPrime S P] (π : R) (hπ : Prime π) (hπP : π ∈ P)
    (a : ℕ) (f : R) (hf : algebraMap R S f ∈ Ideal.span {algebraMap R S π} ^ a) : π ^ a ∣ f := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hf
  obtain ⟨s, hs⟩ := hf
  obtain ⟨⟨g, u⟩, hgu⟩ := IsLocalization.surj P.primeCompl s
  have hinj := IsLocalization.injective S (M := P.primeCompl)
    (Ideal.primeCompl_le_nonZeroDivisors P)
  have h1 : algebraMap R S (f * u) = algebraMap R S (g * π ^ a) := by
    rw [map_mul, map_mul, map_pow, ← hs, ← hgu]
    ring
  have h2 : f * (u : R) = g * π ^ a := hinj h1
  have h3 : π ^ a ∣ f * (u : R) := ⟨g, by rw [h2]; ring⟩
  refine hπ.pow_dvd_of_dvd_mul_right a ?_ h3
  rintro ⟨c, hc⟩
  exact u.2 (by rw [hc]; exact P.mul_mem_right c hπP)

/-- The support of a prime divisor is the closure of its generic point. -/
theorem support_eq_closure_genericPoint (D : AlgebraicGeometry.PrimeDivisor X) :
    (D.support : Set X) = closure {D.genericPoint} := by
  haveI := D.integral
  exact Stacks.Chow.support_eq_closure_genericPointOf D.idealSheaf D.integral

/-- The stalk of the ideal sheaf of a prime divisor at its generic point is the maximal ideal. -/
theorem stalk_idealSheaf_genericPoint (D : AlgebraicGeometry.PrimeDivisor X) :
    IdealSheafData.stalk D.idealSheaf D.genericPoint =
      IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) := by
  haveI := D.integral
  exact IdealSheafData.stalk_subschemeι_genericPoint_eq_maximalIdeal D.idealSheaf

/-- On a scheme smooth over a field, for `x` in the support of a prime divisor `D`, the prime ideal
of the stalk at `x` given by the generic point of `D` is the stalk of the ideal sheaf of `D` at
`x`. -/
theorem primeOfSpecializes_genericPoint {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (D : AlgebraicGeometry.PrimeDivisor X) {x : X} (hx : x ∈ D.support) :
    MMP.Intersection.primeOfSpecializes (genericPoint_specializes_of_mem_support D hx) =
      IdealSheafData.stalk D.idealSheaf x := by
  obtain ⟨π, hπ, hπD⟩ := exists_prime_stalk_idealSheaf sX h D hx
  haveI := smooth_of_isSmoothScheme' sX h
  have hsp := genericPoint_specializes_of_mem_support D hx
  letI := (X.presheaf.stalkSpecializes hsp).hom.toAlgebra
  haveI := MMP.Intersection.isLocalization_stalkSpecializes hsp
  have hmap : Ideal.map (X.presheaf.stalkSpecializes hsp).hom (IdealSheafData.stalk D.idealSheaf x)
      = IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) := by
    rw [← stalk_eq_map_stalkSpecializes D.idealSheaf hsp, stalk_idealSheaf_genericPoint]
  have hp : (IdealSheafData.stalk D.idealSheaf x).IsPrime := by
    rw [hπD]
    haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
    haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
    exact (Ideal.span_singleton_prime hπ.ne_zero).2 hπ
  have hle : IdealSheafData.stalk D.idealSheaf x ≤ MMP.Intersection.primeOfSpecializes hsp := by
    intro a ha
    have : algebraMap _ _ a ∈ Ideal.map (X.presheaf.stalkSpecializes hsp).hom
        (IdealSheafData.stalk D.idealSheaf x) := Ideal.mem_map_of_mem _ ha
    rw [hmap] at this
    exact this
  have := IsLocalization.comap_map_of_isPrime_disjoint
    (MMP.Intersection.primeOfSpecializes hsp).primeCompl (X.presheaf.stalk D.genericPoint) hp
    (by
      rw [Set.disjoint_left]
      intro a ha hap
      exact ha (hle hap))
  have e : MMP.Intersection.primeOfSpecializes hsp =
      Ideal.comap (X.presheaf.stalkSpecializes hsp).hom
        (Ideal.map (X.presheaf.stalkSpecializes hsp).hom
          (IdealSheafData.stalk D.idealSheaf x)) := by
    rw [hmap]
  exact e.trans this

/-- On a scheme smooth over a field, let `x` lie on a prime divisor `D` whose ideal stalk at `x` is
`(π)`. If the stalk of `I` at the generic point of `D` lies in the `a`-th power of the maximal
ideal, then `π ^ a` divides every element of the stalk of `I` at `x`. -/
theorem pow_dvd_of_stalk_genericPoint_le {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (D : AlgebraicGeometry.PrimeDivisor X) {x : X} (hx : x ∈ D.support)
    {π : X.presheaf.stalk x} (hπ : Prime π)
    (hπD : IdealSheafData.stalk D.idealSheaf x = Ideal.span {π}) (I : X.IdealSheafData) (a : ℕ)
    (hI : IdealSheafData.stalk I D.genericPoint ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) ^ a)
    {f : X.presheaf.stalk x} (hf : f ∈ IdealSheafData.stalk I x) : π ^ a ∣ f := by
  haveI := smooth_of_isSmoothScheme' sX h
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
  haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  have hsp := genericPoint_specializes_of_mem_support D hx
  letI := (X.presheaf.stalkSpecializes hsp).hom.toAlgebra
  haveI := MMP.Intersection.isLocalization_stalkSpecializes hsp
  have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) =
      Ideal.span {algebraMap _ (X.presheaf.stalk D.genericPoint) π} := by
    rw [← stalk_idealSheaf_genericPoint, stalk_eq_map_stalkSpecializes D.idealSheaf hsp, hπD,
      Ideal.map_span, Set.image_singleton]
    rfl
  have hπP : π ∈ MMP.Intersection.primeOfSpecializes hsp := by
    have : algebraMap (X.presheaf.stalk x) (X.presheaf.stalk D.genericPoint) π ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) := by
      rw [hm]; exact Ideal.mem_span_singleton_self _
    exact this
  refine pow_dvd_of_map_mem (S := X.presheaf.stalk D.genericPoint)
    (MMP.Intersection.primeOfSpecializes hsp) π hπ hπP a f ?_
  rw [← hm]
  refine hI ?_
  rw [stalk_eq_map_stalkSpecializes I hsp]
  exact Ideal.mem_map_of_mem _ hf

/-- On a scheme smooth over a field, two prime divisors through `x` whose ideal sheaves have equal
stalks at `x` are equal. -/
theorem eq_of_stalk_idealSheaf_eq {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (D D' : AlgebraicGeometry.PrimeDivisor X) {x : X} (hx : x ∈ D.support)
    (hx' : x ∈ D'.support)
    (he : IdealSheafData.stalk D.idealSheaf x = IdealSheafData.stalk D'.idealSheaf x) :
    D = D' := by
  have h1 := primeOfSpecializes_genericPoint sX h D hx
  have h2 := primeOfSpecializes_genericPoint sX h D' hx'
  have hs := genericPoint_specializes_of_mem_support D hx
  have hs' := genericPoint_specializes_of_mem_support D' hx'
  have e : MMP.Intersection.primeOfSpecializes hs = MMP.Intersection.primeOfSpecializes hs' := by
    rw [h1, h2, he]
  have a1 := MMP.Intersection.specializes_of_primeOfSpecializes_le hs hs' e.le
  have a2 := MMP.Intersection.specializes_of_primeOfSpecializes_le hs' hs e.ge
  have : D.genericPoint = D'.genericPoint := (a1.antisymm a2).eq
  apply PrimeDivisor.eq_of_support_eq
  rw [support_eq_closure_genericPoint D, support_eq_closure_genericPoint D', this]

/-- If the stalk of the ideal sheaf of `D` at `x` is generated by a prime element, then `x` lies in
the support of `D`. -/
theorem mem_support_of_stalk_eq_span_prime (D : AlgebraicGeometry.PrimeDivisor X) {x : X}
    {π : X.presheaf.stalk x} (hπ : Prime π)
    (hπD : IdealSheafData.stalk D.idealSheaf x = Ideal.span {π}) : x ∈ D.support := by
  by_contra hx
  have := (IdealSheafData.stalk_eq_top_iff_notMem_support D.idealSheaf x).2 hx
  rw [hπD, Ideal.span_singleton_eq_top] at this
  exact hπ.not_unit this

/-- On a scheme smooth over a field, `g` lies in the product over `D ∈ F` of the `A D`-th powers
of the ideal stalks of `D` at `x` provided `π ^ A D ∣ g` for every `D ∈ F` and every prime
generator `π` of the ideal stalk of `D` at `x`. -/
theorem mem_prod_stalk_of_forall_dvd {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (A : AlgebraicGeometry.PrimeDivisor X → ℕ) (x : X)
    (F : Finset (AlgebraicGeometry.PrimeDivisor X)) (g : X.presheaf.stalk x)
    (hg : ∀ D ∈ F, ∀ π : X.presheaf.stalk x, Prime π →
      IdealSheafData.stalk D.idealSheaf x = Ideal.span {π} → π ^ A D ∣ g) :
    g ∈ ∏ D ∈ F, IdealSheafData.stalk D.idealSheaf x ^ A D := by
  classical
  haveI := smooth_of_isSmoothScheme' sX h
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
  haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  induction F using Finset.induction_on generalizing g with
  | empty => simp
  | insert D0 F' hD0 ih =>
    rw [Finset.prod_insert hD0]
    by_cases hx0 : x ∈ D0.support
    · obtain ⟨π0, hπ0, hπ0D⟩ := exists_prime_stalk_idealSheaf sX h D0 hx0
      obtain ⟨g', hg'⟩ := hg D0 (Finset.mem_insert_self _ _) π0 hπ0 hπ0D
      have hg'mem : g' ∈ ∏ D ∈ F', IdealSheafData.stalk D.idealSheaf x ^ A D := by
        refine ih g' fun D hD π hπ hπD => ?_
        have hdvd := hg D (Finset.mem_insert_of_mem hD) π hπ hπD
        rw [hg'] at hdvd
        refine hπ.pow_dvd_of_dvd_mul_left (A D) ?_ hdvd
        intro hππ0
        have hπ0' : π ∣ π0 := hπ.dvd_of_dvd_pow hππ0
        have hass : Associated π π0 := hπ.associated_of_dvd hπ0 hπ0'
        have hDx := mem_support_of_stalk_eq_span_prime D hπ hπD
        have heq : IdealSheafData.stalk D.idealSheaf x = IdealSheafData.stalk D0.idealSheaf x := by
          rw [hπD, hπ0D, Ideal.span_singleton_eq_span_singleton.mpr hass]
        exact hD0 (eq_of_stalk_idealSheaf_eq sX h D D0 hDx hx0 heq ▸ hD)
      rw [hg', hπ0D, Ideal.span_singleton_pow]
      exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hg'mem
    · have : IdealSheafData.stalk D0.idealSheaf x = ⊤ :=
        (IdealSheafData.stalk_eq_top_iff_notMem_support D0.idealSheaf x).2 hx0
      have htp : (⊤ : Ideal (X.presheaf.stalk x)) ^ A D0 = ⊤ := by simp
      rw [this, htp, Ideal.top_mul]
      exact ih g fun D hD => hg D (Finset.mem_insert_of_mem hD)

/-- On a scheme smooth over a field, if for each `D ∈ F` the stalk of `I` at the generic point of
`D` lies in the `A D`-th power of the maximal ideal, then `I ≤ ∏ D ∈ F, D.idealSheaf ^ A D`. -/
theorem le_prod_of_stalk_le {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (h : MMP.Mori.IsSmoothScheme sX)
    (A : AlgebraicGeometry.PrimeDivisor X → ℕ) (F : Finset (AlgebraicGeometry.PrimeDivisor X))
    (I : X.IdealSheafData)
    (hI : ∀ D ∈ F, IdealSheafData.stalk I D.genericPoint ≤
      IsLocalRing.maximalIdeal (X.presheaf.stalk D.genericPoint) ^ A D) :
    I ≤ ∏ D ∈ F, D.idealSheaf ^ A D := by
  refine IdealSheafData.le_of_stalk_le _ _ fun x f hf => ?_
  rw [stalk_prod]
  simp only [stalk_pow]
  refine mem_prod_stalk_of_forall_dvd sX h A x F f fun D hD π hπ hπD => ?_
  exact pow_dvd_of_stalk_genericPoint_le sX h D (mem_support_of_stalk_eq_span_prime D hπ hπD) hπ
    hπD I (A D) (hI D hD) hf

/-- On a scheme quasi-compact and locally of finite type over a field, only finitely many prime
divisors have as support an irreducible component of the support of some `E i`. -/
theorem finite_primeDivisor_of_isComponent {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [QuasiCompact sX] {s : ℕ}
    (E : Fin s → X.IdealSheafData) :
    {D : AlgebraicGeometry.PrimeDivisor X |
      ∃ i, D.support ∈ componentsOf ((E i).support : Set X)}.Finite := by
  haveI := noetherianSpace_of_finiteType sX
  have hfin : (⋃ i, componentsOf ((E i).support : Set X)).Finite :=
    Set.finite_iUnion fun i => (finite_and_cover_componentsOf (E i).support.isClosed).1
  refine Set.Finite.of_finite_image (f := fun D : AlgebraicGeometry.PrimeDivisor X =>
    (D.support : Set X)) (hfin.subset ?_) ?_
  · rintro _ ⟨D, ⟨i, hi⟩, rfl⟩
    exact Set.mem_iUnion.2 ⟨i, hi⟩
  · intro D _ D' _ hDD'
    exact PrimeDivisor.eq_of_support_eq hDD'

