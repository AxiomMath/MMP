module

public import MMP.AlgebraicGeometry.Resolution.MarkedIdeal.Sequence

/-!
# Centres inside a hypersurface with simple normal crossings

Let `X` be a smooth variety, `H ⊆ X` a smooth hypersurface and `E = (E^1, …, E^s)` an ordered
simple normal crossing divisor such that `H + ∑ᵢ E^i` is a simple normal crossing divisor. A
closed subscheme `Z ⊆ H` which has simple normal crossings with `E` has simple normal crossings
with `H + ∑ᵢ E^i`: at a point `x ∈ Z`, a local equation `h` of `H` lies in the ideal of `Z`, and
it can replace one of the coordinates cutting out `Z` which does not cut out an `E^i`.

Conversely, simple normal crossings may be checked inside `H`: if `(H, E'^1, …, E'^t)` is an
ordered simple normal crossing divisor and `Z ⊆ H` has simple normal crossings in `H` with
`E'|_H = (E'^i ∩ H)ᵢ`, then `Z` has simple normal crossings in `X` with `(H, E')`; local
coordinates of `H` adapted to `E'|_H` and `Z` lift, together with a local equation of `H`, to
local coordinates of `X`.

## Main results

* `MMP.Mori.exists_update_isRegularSystemOfParameters`: an element of the ideal generated by some
  members of a regular system of parameters, which is itself a parameter, can replace one of them.
* `MMP.Mori.exists_lift_isRegularSystemOfParameters`: a regular system of parameters of
  `A/(h)`, `h` a parameter of `A`, lifts together with `h` to one of `A`.
* `MMP.Mori.isRegularSystemOfParameters_comp_succAbove`: the images in `A/(z_{j₀})` of the other
  members of a regular system of parameters `z` form one.
* `MMP.Resolution.Kollar.hasSNCWith_cons_of_hasSNCWith`: `Z ⊆ H` having snc with `E` has snc
  with `H + ∑ᵢ E^i`.
* `MMP.Resolution.Kollar.hasSNCWith_cons_of_hasSNCWith_comap`: `Z ⊆ H` having snc in `H` with
  `E'|_H` has snc in `X` with `(H, E')`.

## Implementation notes

The divisor `H + ∑ᵢ E^i`, resp. `(H, E'^1, …, E'^t)`, is the ordered divisor whose first entry
is `H` followed by the entries of `E`. A closed subscheme `Z ⊆ H` is an ideal sheaf `Z` on `X`
with `H ≤ Z`; as a closed subscheme of `H` it is its inverse image `Z·𝒪_H` along the inclusion
`H → X`, and `E'|_H` is the inverse image `OrderedDivisor.comap` of `E'` along that inclusion.

Both statements are local computations with regular systems of parameters of `𝒪_{X,x}`. The
assumption that `X` is a smooth variety is weakened to `X` locally Noetherian: a regular system of
parameters (`MMP.Mori.IsRegularSystemOfParameters`) is a family of `dim 𝒪_{X,x}` generators of the
maximal ideal, and its classes in `𝔪/𝔪²` are a basis only when the stalk is Noetherian, which
the computations use. The assumption that `H` is a smooth hypersurface is not used beyond what the
simple normal crossing condition on `H + ∑ᵢ E^i` already gives at the points of `H`; it is
dropped.

## References

* [J. Kollár, *Lectures on resolution of singularities*, proof of Cor. 3.85, proof of
  Lemma 3.102 and 3.104 Step 2.1]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

universe u

namespace MMP.Mori

open IsLocalRing in
/-- The classes in `𝔪/𝔪²` of a regular system of parameters of a Noetherian local ring are
linearly independent. -/
theorem linearIndependent_toCotangent_of_isRegularSystemOfParameters
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {n : ℕ} {z : Fin n → A}
    (hz : IsRegularSystemOfParameters z) (hmem : ∀ k, z k ∈ maximalIdeal A) :
    LinearIndependent (ResidueField A)
      (fun k => (maximalIdeal A).toCotangent (⟨z k, hmem k⟩ : maximalIdeal A)) := by
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  apply linearIndependent_of_top_le_span_of_card_eq_finrank
  · rw [top_le_iff]
    have h1 : Submodule.span A (Set.range fun k => (⟨z k, hmem k⟩ : maximalIdeal A)) = ⊤ := by
      apply Submodule.map_injective_of_injective (Submodule.injective_subtype _)
      rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype, ← Set.range_comp]
      exact hz.1
    have := (CotangentSpace.span_image_eq_top_iff (R := A)
      (s := Set.range fun k => (⟨z k, hmem k⟩ : maximalIdeal A))).mpr h1
    rw [← this, ← Set.range_comp]
    rfl
  · rw [Fintype.card_fin, ← spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hz.2] at h
    exact_mod_cast h.symm

open IsLocalRing in
/-- **Exchanging a parameter.** Let `z, z'` be regular systems of parameters of a Noetherian
local ring, `h = z'_{c₀}` an element of the ideal `(z_j : j ∈ J)`, and suppose that for `i ∈ I`
the parameter `z_{c i}` is an associate of `z'_{c' i}`, with `c' i ≠ c₀`. Then `h` can replace one
of the `z_j`, `j ∈ J`, `j ≠ c i` for `i ∈ I`: the result is a regular system of parameters
generating the same ideal with `J`. -/
theorem exists_update_isRegularSystemOfParameters
    {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {n n' : ℕ} {ι : Type*}
    {z : Fin n → A} {z' : Fin n' → A} (hz : IsRegularSystemOfParameters z)
    (hz' : IsRegularSystemOfParameters z') (J : Finset (Fin n))
    (c : ι → Fin n) (c' : ι → Fin n') (c₀ : Fin n') (I : Set ι)
    (hass : ∀ i ∈ I, Ideal.span {z (c i)} = Ideal.span {z' (c' i)})
    (hne : ∀ i ∈ I, c' i ≠ c₀) (hh : z' c₀ ∈ Ideal.span (z '' (J : Set (Fin n)))) :
    ∃ j₀ ∈ J, (∀ i ∈ I, c i ≠ j₀) ∧
      IsRegularSystemOfParameters (Function.update z j₀ (z' c₀)) ∧
      Ideal.span (Function.update z j₀ (z' c₀) '' (J : Set (Fin n))) =
        Ideal.span (z '' (J : Set (Fin n))) := by
  classical
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  haveI := IsRegularLocalRing.isDomain A
  have hmem : ∀ k, z k ∈ maximalIdeal A := fun k => hz.1 ▸ Ideal.subset_span ⟨k, rfl⟩
  have hmem' : ∀ k, z' k ∈ maximalIdeal A := fun k => hz'.1 ▸ Ideal.subset_span ⟨k, rfl⟩
  have hli := linearIndependent_toCotangent_of_isRegularSystemOfParameters hz' hmem'
  obtain ⟨a, ha⟩ := (Fintype.mem_span_image_iff_exists_fun (R := A) (v := z)
    (s := (J : Set (Fin n)))).mp hh
  -- a coefficient of `h` which is a unit and not at an index `c i`
  have key : ∃ j : (J : Set (Fin n)), (∀ i ∈ I, c i ≠ j.1) ∧ a j ∉ maximalIdeal A := by
    by_contra hcon
    push Not at hcon
    let W : Submodule (ResidueField A) (CotangentSpace A) :=
      Submodule.span (ResidueField A)
        ((fun k => (maximalIdeal A).toCotangent (⟨z' k, hmem' k⟩ : maximalIdeal A)) '' (c' '' I))
    have hnot : (maximalIdeal A).toCotangent (⟨z' c₀, hmem' c₀⟩ : maximalIdeal A) ∉ W :=
      hli.notMem_span_image fun ⟨i, hi, hic⟩ => hne i hi hic
    apply hnot
    have hsum : (maximalIdeal A).toCotangent (⟨z' c₀, hmem' c₀⟩ : maximalIdeal A) =
        ∑ j : (J : Set (Fin n)), a j • (maximalIdeal A).toCotangent
          (⟨z j.1, hmem j.1⟩ : maximalIdeal A) := by
      simp only [← map_smul, ← map_sum]
      congr 1
      apply Subtype.ext
      simp only [Submodule.coe_sum, Submodule.coe_smul]
      exact ha.symm
    rw [hsum]
    refine Submodule.sum_mem _ fun j _ => ?_
    by_cases hj : ∃ i ∈ I, c i = j.1
    · obtain ⟨i, hi, hij⟩ := hj
      obtain ⟨u, hu⟩ := (Ideal.span_singleton_eq_span_singleton.mp (hass i hi)).symm
      have h1 : (maximalIdeal A).toCotangent (⟨z j.1, hmem j.1⟩ : maximalIdeal A) =
          (u : A) • (maximalIdeal A).toCotangent (⟨z' (c' i), hmem' _⟩ : maximalIdeal A) := by
        rw [← map_smul]
        congr 1
        apply Subtype.ext
        simp only [Submodule.coe_smul, smul_eq_mul]
        rw [← hij, ← hu, mul_comm]
      rw [h1, smul_smul]
      exact Submodule.smul_of_tower_mem W (a j * u)
        (Submodule.subset_span ⟨c' i, ⟨i, hi, rfl⟩, rfl⟩)
    · push Not at hj
      have h1 := hcon j hj
      have h2 : a j • (maximalIdeal A).toCotangent (⟨z j.1, hmem j.1⟩ : maximalIdeal A) = 0 := by
        rw [← map_smul, Ideal.toCotangent_eq_zero]
        simp only [Submodule.coe_smul, smul_eq_mul]
        rw [pow_two]
        exact Ideal.mul_mem_mul h1 (hmem _)
      rw [h2]
      exact W.zero_mem
  obtain ⟨⟨j₀, hj₀⟩, hnc, hnm⟩ := key
  obtain ⟨u, hu⟩ : IsUnit (a ⟨j₀, hj₀⟩) := IsLocalRing.notMem_maximalIdeal.mp hnm
  have hj₀J : j₀ ∈ J := by simpa using hj₀
  set zt : Fin n → A := Function.update z j₀ (z' c₀) with hzt
  have hzt_eq : ∀ j, j ≠ j₀ → zt j = z j := fun j hj => Function.update_of_ne hj _ _
  have hzt_j₀ : zt j₀ = z' c₀ := Function.update_self ..
  have hS : ∀ j ∈ J, zt j ∈ Ideal.span (zt '' (J : Set (Fin n))) :=
    fun j hj => Ideal.subset_span ⟨j, hj, rfl⟩
  have hz0 : z j₀ ∈ Ideal.span (zt '' (J : Set (Fin n))) := by
    have hsplit := Finset.add_sum_erase (Finset.univ : Finset (J : Set (Fin n)))
      (fun j => a j • z j.1) (Finset.mem_univ ⟨j₀, hj₀⟩)
    rw [ha] at hsplit
    have h1 : a ⟨j₀, hj₀⟩ • z j₀ ∈ Ideal.span (zt '' (J : Set (Fin n))) := by
      have : a ⟨j₀, hj₀⟩ • z j₀ = z' c₀ - ∑ j ∈ (Finset.univ : Finset (J : Set (Fin n))).erase
          ⟨j₀, hj₀⟩, a j • z j.1 := eq_sub_iff_add_eq.mpr hsplit
      rw [this]
      refine Ideal.sub_mem _ ?_ (Ideal.sum_mem _ fun j hj => ?_)
      · rw [← hzt_j₀]
        exact hS j₀ hj₀J
      · have hne : j.1 ≠ j₀ := fun h => (Finset.mem_erase.mp hj).1 (Subtype.ext h)
        rw [← hzt_eq _ hne, smul_eq_mul]
        exact Ideal.mul_mem_left _ _ (hS j.1 (by simpa using j.2))
    have h2 := Ideal.mul_mem_left _ ((↑u⁻¹ : Aˣ) : A) h1
    rw [smul_eq_mul, ← mul_assoc, ← hu] at h2
    simpa using h2
  refine ⟨j₀, hj₀J, by simpa using hnc, ⟨?_, ?_⟩, ?_⟩
  · rw [← hzt]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      by_cases hk : k = j₀
      · rw [hk, hzt_j₀]
        exact hmem' c₀
      · rw [hzt_eq k hk]
        exact hmem k
    · rw [← hz.1, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      by_cases hk : k = j₀
      · rw [hk]
        exact Ideal.span_mono (Set.image_subset_range _ _) hz0
      · exact Ideal.subset_span ⟨k, hzt_eq k hk⟩
  · exact hz.2
  · rw [← hzt]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      by_cases hk : j = j₀
      · rw [hk, hzt_j₀]
        exact hh
      · rw [hzt_eq j hk]
        exact Ideal.subset_span ⟨j, hj, rfl⟩
    · rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      by_cases hk : j = j₀
      · rw [hk]
        exact hz0
      · rw [← hzt_eq j hk]
        exact hS j hj

open IsLocalRing in
/-- If `B = A/(h)` where `h` is a member of a regular system of parameters of the Noetherian local
ring `A` and `B` has a regular system of parameters of length `n`, then `A` has dimension
`n + 1`. -/
theorem dim_eq_succ_of_quotient
    {A B : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B] [IsLocalRing B]
    (φ : A →+* B) (hφ : Function.Surjective φ) {n₀ n : ℕ} {z₀ : Fin n₀ → A}
    (hz₀ : IsRegularSystemOfParameters z₀) (c₀ : Fin n₀)
    (hker : RingHom.ker φ = Ideal.span {z₀ c₀}) {w : Fin n → B}
    (hw : IsRegularSystemOfParameters w) : n₀ = n + 1 := by
  classical
  haveI : IsNoetherianRing B := isNoetherianRing_of_surjective A B φ hφ
  haveI : IsLocalHom φ := IsLocalHom.of_surjective φ hφ
  haveI := isRegularLocalRing_of_isRegularSystemOfParameters hw
  have hφz : φ (z₀ c₀) = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self _
  apply le_antisymm
  · -- `n₀ ≤ n + 1`
    have hjac : RingHom.ker φ ≤ Ring.jacobson A := by
      rw [hker, Ideal.span_le]
      rintro _ rfl
      rw [SetLike.mem_coe, IsLocalRing.ringJacobson_eq_maximalIdeal, ← hz₀.1]
      exact Ideal.subset_span ⟨c₀, rfl⟩
    have h1 := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (RingHom.ker φ) hjac
    rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ), hz₀.2, hw.2] at h1
    have h2 : (RingHom.ker φ).spanFinrank ≤ 1 := by
      rw [hker]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton _)).trans ?_
      simp
    have h3 : ((RingHom.ker φ).spanFinrank : WithBot ℕ∞) ≤ 1 := by exact_mod_cast h2
    have h4 : (n₀ : WithBot ℕ∞) ≤ n + 1 := h1.trans (by gcongr)
    exact_mod_cast h4
  · -- `n ≤ n₀ - 1`
    have hB := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B)
    rw [hw.2] at hB
    have hB' : (maximalIdeal B).spanFinrank = n := by exact_mod_cast hB
    have hmapm : Ideal.map φ (maximalIdeal A) = maximalIdeal B :=
      IsLocalRing.map_maximalIdeal_of_surjective φ hφ
    have hmax : maximalIdeal B = Ideal.span ((fun k => φ (z₀ k)) '' {k | k ≠ c₀}) := by
      apply le_antisymm
      · rw [← hmapm, ← hz₀.1, Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
        by_cases hk : k = c₀
        · rw [hk, hφz]
          exact Ideal.zero_mem _
        · exact Ideal.subset_span ⟨k, hk, rfl⟩
      · rw [Ideal.span_le]
        rintro _ ⟨k, -, rfl⟩
        rw [← hmapm]
        exact Ideal.mem_map_of_mem φ (hz₀.1 ▸ Ideal.subset_span ⟨k, rfl⟩)
    have hset :
        {k : Fin n₀ | k ≠ c₀} = ((Finset.univ.erase c₀ : Finset (Fin n₀)) : Set (Fin n₀)) := by
      ext k
      simp
    have h5 : (maximalIdeal B).spanFinrank ≤ n₀ - 1 := by
      rw [hmax]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite
        (Set.Finite.image _ (Set.toFinite _))).trans ?_
      refine (Set.ncard_image_le (Set.toFinite _)).trans ?_
      rw [hset, Set.ncard_coe_finset, Finset.card_erase_of_mem (Finset.mem_univ _)]
      simp
    have := c₀.pos
    omega

open IsLocalRing in
/-- **Lifting a regular system of parameters through `A/(h)`.** Let `A → B` be a surjection of
Noetherian local rings with kernel `(h)`, `h` a member of a regular system of parameters of `A`,
and `w` a regular system of parameters of `B`. Then `h` and lifts of `w` form a regular system of
parameters of `A`, and the lift of `w_{c' i}` may be taken to generate `(e_i)` when
`(w_{c' i}) = (φ e_i)`. -/
theorem exists_lift_isRegularSystemOfParameters
    {A B : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B] [IsLocalRing B]
    (φ : A →+* B) (hφ : Function.Surjective φ) {n₀ n : ℕ} {ι : Type*} {z₀ : Fin n₀ → A}
    (hz₀ : IsRegularSystemOfParameters z₀) (c₀ : Fin n₀)
    (hker : RingHom.ker φ = Ideal.span {z₀ c₀}) {w : Fin n → B}
    (hw : IsRegularSystemOfParameters w) (c' : ι → Fin n) (e : ι → A)
    (I : Set ι) (hE : ∀ i ∈ I, Ideal.span {w (c' i)} = (Ideal.span {e i}).map φ)
    (hinj : ∀ i ∈ I, ∀ i' ∈ I, c' i = c' i' → i = i') :
    ∃ t : Fin (n + 1) → A, IsRegularSystemOfParameters t ∧ t 0 = z₀ c₀ ∧
      (∀ k, φ (t k.succ) = w k) ∧ ∀ i ∈ I, Ideal.span {t (c' i).succ} = Ideal.span {e i} := by
  classical
  have hn : n₀ = n + 1 := dim_eq_succ_of_quotient φ hφ hz₀ c₀ hker hw
  haveI : IsNoetherianRing B := isNoetherianRing_of_surjective A B φ hφ
  haveI : IsLocalHom φ := IsLocalHom.of_surjective φ hφ
  haveI := isRegularLocalRing_of_isRegularSystemOfParameters hw
  haveI := IsRegularLocalRing.isDomain B
  have hlift : ∀ k : Fin n, ∃ a : A, φ a = w k ∧ ∀ i ∈ I, c' i = k →
      Ideal.span {a} = Ideal.span {e i} := by
    intro k
    by_cases hk : ∃ i ∈ I, c' i = k
    · obtain ⟨i₀, hi₀, rfl⟩ := hk
      obtain ⟨u, hu⟩ := (Ideal.span_singleton_eq_span_singleton.mp
        ((hE i₀ hi₀).trans (by rw [Ideal.map_span, Set.image_singleton]))).symm
      obtain ⟨ũ, hũ⟩ := hφ (u : B)
      have hunit : IsUnit ũ := by
        rw [← isUnit_map_iff φ, hũ]
        exact u.isUnit
      refine ⟨ũ * e i₀, ?_, ?_⟩
      · rw [map_mul, hũ, ← hu, mul_comm]
      · intro i hi hii
        obtain rfl := hinj i hi i₀ hi₀ hii
        exact Ideal.span_singleton_mul_left_unit hunit _
    · obtain ⟨a, ha⟩ := hφ (w k)
      exact ⟨a, ha, fun i hi hii => (hk ⟨i, hi, hii⟩).elim⟩
  choose lift hlift1 hlift2 using hlift
  have hmemA : ∀ a : A, φ a ∈ maximalIdeal B → a ∈ maximalIdeal A := by
    intro a ha
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at ha ⊢
    exact fun h => ha (h.map φ)
  have hw_mem : ∀ k, w k ∈ maximalIdeal B := fun k => hw.1 ▸ Ideal.subset_span ⟨k, rfl⟩
  refine ⟨Fin.cons (α := fun _ => A) (z₀ c₀) lift, ⟨?_, ?_⟩, rfl,
    fun k => by simpa using hlift1 k, fun i hi => by simpa using hlift2 _ i hi rfl⟩
  · apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      refine Fin.cases ?_ (fun k => ?_) k
      · simp only [Fin.cons_zero]
        rw [← hz₀.1]
        exact Ideal.subset_span ⟨c₀, rfl⟩
      · simp only [Fin.cons_succ]
        exact hmemA _ (by rw [hlift1]; exact hw_mem k)
    · intro a ha
      have h1 : φ a ∈ Ideal.map φ (Ideal.span (Set.range lift)) := by
        rw [Ideal.map_span, ← Set.range_comp, show φ ∘ lift = w from funext hlift1, hw.1,
          ← IsLocalRing.map_maximalIdeal_of_surjective φ hφ]
        exact Ideal.mem_map_of_mem φ ha
      have h2 : a ∈ Ideal.comap φ (Ideal.map φ (Ideal.span (Set.range lift))) := h1
      rw [Ideal.comap_map_of_surjective φ hφ, ← RingHom.ker_eq_comap_bot, hker] at h2
      refine (sup_le ?_ ?_ :
        _ ≤ Ideal.span (Set.range (Fin.cons (α := fun _ => A) (z₀ c₀) lift))) h2
      · apply Ideal.span_mono
        rintro _ ⟨k, rfl⟩
        exact ⟨k.succ, by simp⟩
      · rw [Ideal.span_le]
        rintro _ rfl
        exact Ideal.subset_span ⟨0, by simp⟩
  · rw [hz₀.2, hn]

open IsLocalRing in
/-- If `B = A/(z_{j₀})` for a regular system of parameters `z` of a Noetherian local ring `A`,
the images of the other `z_k` are a regular system of parameters of `B`. -/
theorem isRegularSystemOfParameters_comp_succAbove
    {A B : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B] [IsLocalRing B]
    (φ : A →+* B) (hφ : Function.Surjective φ) {m : ℕ} {z : Fin (m + 1) → A}
    (hz : IsRegularSystemOfParameters z) (j₀ : Fin (m + 1))
    (hker : RingHom.ker φ = Ideal.span {z j₀}) :
    IsRegularSystemOfParameters (fun k => φ (z (j₀.succAbove k))) := by
  classical
  haveI : IsNoetherianRing B := isNoetherianRing_of_surjective A B φ hφ
  have hφz : φ (z j₀) = 0 := by
    rw [← RingHom.mem_ker, hker]
    exact Ideal.mem_span_singleton_self _
  have hmax : Ideal.span (Set.range fun k => φ (z (j₀.succAbove k))) = maximalIdeal B := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective φ hφ, ← hz.1, Ideal.map_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      exact Ideal.subset_span ⟨z (j₀.succAbove k), ⟨_, rfl⟩, rfl⟩
    · rw [Ideal.span_le]
      rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
      by_cases hk : k = j₀
      · rw [hk, hφz]
        exact Ideal.zero_mem _
      · obtain ⟨k', rfl⟩ := Fin.exists_succAbove_eq hk
        exact Ideal.subset_span ⟨k', rfl⟩
  have hd : ringKrullDim B ≤ (m : ℕ) := by
    refine (ringKrullDim_le_spanFinrank_maximalIdeal (R := B)).trans ?_
    rw [← hmax]
    have h1 := Submodule.spanFinrank_span_le_ncard_of_finite (R := B)
      (Set.finite_range fun k => φ (z (j₀.succAbove k)))
    have h2 : (Set.range fun k => φ (z (j₀.succAbove k))).ncard ≤ m := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      simp
    exact_mod_cast h1.trans h2
  refine ⟨hmax, le_antisymm hd ?_⟩
  · have hjac : RingHom.ker φ ≤ Ring.jacobson A := by
      rw [hker, Ideal.span_le]
      rintro _ rfl
      rw [SetLike.mem_coe, IsLocalRing.ringJacobson_eq_maximalIdeal, ← hz.1]
      exact Ideal.subset_span ⟨j₀, rfl⟩
    have h1 := ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (RingHom.ker φ) hjac
    rw [ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ), hz.2] at h1
    have h2 : (RingHom.ker φ).spanFinrank ≤ 1 := by
      rw [hker]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton _)).trans ?_
      simp
    have h3 : ((RingHom.ker φ).spanFinrank : WithBot ℕ∞) ≤ 1 := by exact_mod_cast h2
    have h4 : ((m + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim B + 1 := h1.trans (by gcongr)
    obtain ⟨e, he⟩ : ∃ e : ℕ, ringKrullDim B = e := by
      generalize ringKrullDim B = d at h4 hd
      induction d using WithBot.recBotCoe with
      | bot => simp at h4
      | coe d =>
        induction d using WithTop.recTopCoe with
        | top => exact absurd hd (not_le.mpr (WithBot.coe_lt_coe.mpr (WithTop.coe_lt_top _)))
        | coe e => exact ⟨e, rfl⟩
    rw [he] at h4 ⊢
    have : m + 1 ≤ e + 1 := by exact_mod_cast h4
    exact_mod_cast (by omega : m ≤ e)

end MMP.Mori

namespace MMP.Resolution.Kollar

open MMP.Mori

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsLocallyNoetherian X]

private theorem exists_affineOpen_mem' (x : X) : ∃ U : X.affineOpens, x ∈ U.1 := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  exact ⟨⟨U, hU⟩, hxU⟩

private theorem stalk_mono' {I J : X.IdealSheafData} (h : I ≤ J) (x : X) :
    IdealSheafData.stalk I x ≤ IdealSheafData.stalk J x := by
  obtain ⟨U, hx⟩ := exists_affineOpen_mem' x
  rw [IdealSheafData.stalk_eq_map_germ I x U hx, IdealSheafData.stalk_eq_map_germ J x U hx]
  exact Ideal.map_mono (h U)

/-- A point of the support of `Z ≥ H` lies in the support of `H`. -/
private theorem mem_support_of_le {H Z : X.IdealSheafData} (h : H ≤ Z) {x : X}
    (hx : x ∈ Z.support) : x ∈ H.support := by
  by_contra hH
  have h1 := (Stacks.Divisors.stalk_eq_top_iff_notMem_support H x).mpr hH
  have h2 := stalk_mono' h x
  rw [h1, top_le_iff] at h2
  exact ((Stacks.Divisors.stalk_eq_top_iff_notMem_support Z x).mp h2) hx

/-- **A centre in `H` is snc with `H + ∑ᵢ E^i`** (Kollár, proof of Cor. 3.85). Let
`E = (E^1, …, E^s)` be an ordered snc divisor on `X` over `k` and `H ⊆ X` a closed subscheme
such that `H + ∑ᵢ E^i` is a simple normal crossing divisor. If `Z ⊆ H` is a closed subscheme
having simple normal crossings with `E`, then `Z` has simple normal crossings with
`H + ∑ᵢ E^i`. -/
@[mmp "lem_kr3d_snc_center_snc_with_hypersurface_sum"]
theorem hasSNCWith_cons_of_hasSNCWith (sX : X ⟶ Spec (.of k)) (E : OrderedDivisor X)
    (H : X.IdealSheafData)
    (hHE : IsSNCFamily sX (Fin.cons (α := fun _ => X.IdealSheafData) H E.E))
    (Z : X.IdealSheafData) (hZH : H ≤ Z) (hZ : HasSNCWith E.E Z) :
    HasSNCWith (Fin.cons (α := fun _ => X.IdealSheafData) H E.E) Z := by
  intro x hx
  obtain ⟨n, z, c, J, hz, hzE, hzinj, hZst⟩ := hZ x hx
  have hxH : x ∈ H.support := mem_support_of_le hZH hx
  obtain ⟨n', z', c', hz', hz'E, hz'inj⟩ := hHE.2 x
  have hx0 : x ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E.E 0).support := by
    simpa using hxH
  have hxs : ∀ i : {i : Fin E.s // x ∈ (E.E i).support},
      x ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E.E i.1.succ).support := fun i => by
    simpa using i.2
  have hass : ∀ i ∈ (Set.univ : Set {i : Fin E.s // x ∈ (E.E i).support}),
      Ideal.span {z (c i)} = Ideal.span {z' (c' ⟨i.1.succ, hxs i⟩)} := by
    intro i _
    have h2 := hz'E ⟨i.1.succ, hxs i⟩
    simp only [Fin.cons_succ] at h2
    rw [← hzE i, ← h2]
  have hne : ∀ i ∈ (Set.univ : Set {i : Fin E.s // x ∈ (E.E i).support}),
      c' ⟨i.1.succ, hxs i⟩ ≠ c' ⟨0, hx0⟩ := by
    intro i _ h
    exact Fin.succ_ne_zero _ (congrArg Subtype.val (hz'inj h))
  have hh : z' (c' ⟨0, hx0⟩) ∈ Ideal.span (z '' (J : Set (Fin n))) := by
    have h1 := hz'E ⟨0, hx0⟩
    simp only [Fin.cons_zero] at h1
    have h2 := stalk_mono' hZH x
    rw [h1, hZst] at h2
    exact h2 (Ideal.mem_span_singleton_self _)
  obtain ⟨j₀, hj₀, hnc, hrsp, hspan⟩ := exists_update_isRegularSystemOfParameters hz hz' J c
    (fun i => c' ⟨i.1.succ, hxs i⟩) (c' ⟨0, hx0⟩) Set.univ hass hne hh
  let cn : {j : Fin (E.s + 1) // x ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E.E j).support}
      → Fin n := fun j =>
    (Fin.cases (motive := fun j : Fin (E.s + 1) =>
        x ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E.E j).support → Fin n)
      (fun _ => j₀) (fun i hi => c ⟨i, by simpa using hi⟩) j.1) j.2
  refine ⟨n, Function.update z j₀ (z' (c' ⟨0, hx0⟩)), cn, J, hrsp, ?_, ?_, ?_⟩
  · rintro ⟨j, hj⟩
    induction j using Fin.cases with
    | zero =>
      have h1 := hz'E ⟨0, hx0⟩
      simp only [Fin.cons_zero] at h1 ⊢
      show _ = Ideal.span {Function.update z j₀ _ j₀}
      rw [Function.update_self, h1]
    | succ i =>
      have hi' : x ∈ (E.E i).support := by simpa using hj
      show _ = Ideal.span {Function.update z j₀ _ (c ⟨i, hi'⟩)}
      simp only [Fin.cons_succ]
      rw [Function.update_of_ne (hnc ⟨i, hi'⟩ trivial)]
      exact hzE ⟨i, hi'⟩
  · rintro ⟨j, hj⟩ ⟨j', hj'⟩ h
    induction j using Fin.cases with
    | zero =>
      induction j' using Fin.cases with
      | zero => rfl
      | succ i' =>
        exact absurd (show j₀ = c ⟨i', by simpa using hj'⟩ from h).symm (hnc _ trivial)
    | succ i =>
      induction j' using Fin.cases with
      | zero =>
        exact absurd (show c ⟨i, by simpa using hj⟩ = j₀ from h) (hnc _ trivial)
      | succ i' =>
        have := hzinj (show c ⟨i, by simpa using hj⟩ = c ⟨i', by simpa using hj'⟩ from h)
        exact Subtype.ext (congrArg Fin.succ (congrArg Subtype.val this))
  · exact hZst.trans hspan.symm

/-- **Snc inside a hypersurface lifts** (Kollár, proof of Lemma 3.102 and 3.104 Step 2.1). Let
`H ⊆ X` be a closed subscheme of `X` over `k` and `E' = (E'^1, …, E'^t)` an ordered divisor such
that `(H, E'^1, …, E'^t)` is an ordered snc divisor. If `Z ⊆ H` is a closed subscheme which has
simple normal crossings in `H` with `E'|_H = (E'^i ∩ H)ᵢ`, then `Z` has simple normal crossings
in `X` with `(H, E')`. -/
@[mmp "lem_kr3e_snc_centre_inside_divisor"]
theorem hasSNCWith_cons_of_hasSNCWith_comap (sX : X ⟶ Spec (.of k)) (H : X.IdealSheafData)
    (E' : OrderedDivisor X)
    (hHE' : IsSNCFamily sX (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E))
    (Z : X.IdealSheafData) (hZH : H ≤ Z)
    (hZ : HasSNCWith (E'.comap H.subschemeι).E (Z.comap H.subschemeι)) :
    HasSNCWith (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E) Z := by
  intro x hx
  have hxH : x ∈ H.support := mem_support_of_le hZH hx
  obtain ⟨y, rfl⟩ : x ∈ Set.range H.subschemeι := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  have hyZ : y ∈ ((Z.comap H.subschemeι).support : Set H.subscheme) := by
    show y ∈ (Z.comap H.subschemeι).support
    rwa [Scheme.IdealSheafData.support_comap]
  obtain ⟨n, w, c', J', hw, hwE, hwinj, hwZ⟩ := hZ y hyZ
  obtain ⟨n₀, z₀, c₀, hz₀, hz₀E, hz₀inj⟩ := hHE'.2 (H.subschemeι y)
  have hx0 : H.subschemeι y ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E 0).support := by
    simpa using hxH
  set φ := (H.subschemeι.stalkMap y).hom with hφdef
  have hφ : Function.Surjective φ := H.subschemeι.stalkMap_surjective y
  have hker : RingHom.ker φ = Ideal.span {z₀ (c₀ ⟨0, hx0⟩)} := by
    rw [hφdef, Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk H y]
    simpa using hz₀E ⟨0, hx0⟩
  have hsupp : ∀ i, y ∈ ((E'.comap H.subschemeι).E i).support ↔
      H.subschemeι y ∈ (E'.E i).support := by
    intro i
    show y ∈ ((E'.E i).comap H.subschemeι).support ↔ _
    rw [Scheme.IdealSheafData.support_comap]
    rfl
  have hxs : ∀ i : {i : Fin E'.s // y ∈ ((E'.comap H.subschemeι).E i).support},
      H.subschemeι y ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E i.1.succ).support :=
    fun i => by simpa using (hsupp i.1).mp i.2
  have hE : ∀ i ∈ (Set.univ : Set {i : Fin E'.s // y ∈ ((E'.comap H.subschemeι).E i).support}),
      Ideal.span {w (c' i)} = (Ideal.span {z₀ (c₀ ⟨i.1.succ, hxs i⟩)}).map φ := by
    intro i _
    have h2 := hz₀E ⟨i.1.succ, hxs i⟩
    simp only [Fin.cons_succ] at h2
    rw [← hwE i]
    show IdealSheafData.stalk ((E'.E i.1).comap H.subschemeι) y = _
    rw [IdealSheafData.stalk_comap, h2]
  have hinj : ∀ i ∈ (Set.univ : Set {i : Fin E'.s // y ∈ ((E'.comap H.subschemeι).E i).support}),
      ∀ i' ∈ (Set.univ : Set {i : Fin E'.s // y ∈ ((E'.comap H.subschemeι).E i).support}),
      c' i = c' i' → i = i' :=
    fun i _ i' _ h => hwinj h
  obtain ⟨t, ht, ht0, htφ, htE⟩ := exists_lift_isRegularSystemOfParameters φ hφ hz₀
    (c₀ ⟨0, hx0⟩) hker hw c' (fun i => z₀ (c₀ ⟨i.1.succ, hxs i⟩)) _ hE hinj
  let cn : {j : Fin (E'.s + 1) //
      H.subschemeι y ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E j).support} →
      Fin (n + 1) := fun j =>
    (Fin.cases (motive := fun j : Fin (E'.s + 1) =>
        H.subschemeι y ∈ (Fin.cons (α := fun _ => X.IdealSheafData) H E'.E j).support →
          Fin (n + 1))
      (fun _ => 0) (fun i hi => (c' ⟨i, (hsupp i).mpr (by simpa using hi)⟩).succ) j.1) j.2
  refine ⟨n + 1, t, cn, insert 0 (J'.image Fin.succ), ht, ?_, ?_, ?_⟩
  · rintro ⟨j, hj⟩
    induction j using Fin.cases with
    | zero =>
      have h1 := hz₀E ⟨0, hx0⟩
      simp only [Fin.cons_zero] at h1 ⊢
      show _ = Ideal.span {t 0}
      rw [h1, ht0]
    | succ i =>
      have hi' : y ∈ ((E'.comap H.subschemeι).E i).support := (hsupp i).mpr (by simpa using hj)
      show _ = Ideal.span {t (c' ⟨i, hi'⟩).succ}
      rw [htE ⟨i, hi'⟩ trivial]
      have h2 := hz₀E ⟨i.succ, hxs ⟨i, hi'⟩⟩
      simp only [Fin.cons_succ] at h2 ⊢
      exact h2
  · rintro ⟨j, hj⟩ ⟨j', hj'⟩ h
    induction j using Fin.cases with
    | zero =>
      induction j' using Fin.cases with
      | zero => rfl
      | succ i' => exact absurd (show (0 : Fin (n + 1)) = _ from h) (Fin.succ_ne_zero _).symm
    | succ i =>
      induction j' using Fin.cases with
      | zero => exact absurd (show _ = (0 : Fin (n + 1)) from h) (Fin.succ_ne_zero _)
      | succ i' =>
        have := hwinj (Fin.succ_injective _ h)
        exact Subtype.ext (congrArg Fin.succ (congrArg Subtype.val this))
  · have h1 : IdealSheafData.stalk Z (H.subschemeι y) =
        Ideal.comap φ (Ideal.span (w '' (J' : Set (Fin n)))) := by
      rw [← hwZ]
      show _ = Ideal.comap φ (IdealSheafData.stalk (Z.comap H.subschemeι) y)
      rw [IdealSheafData.stalk_comap, Ideal.comap_map_of_surjective φ hφ,
        ← RingHom.ker_eq_comap_bot, hφdef,
        Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk H y]
      exact (sup_eq_left.mpr (stalk_mono' hZH _)).symm
    rw [h1]
    have h5 : w '' (J' : Set (Fin n)) = φ '' ((fun k => t k.succ) '' (J' : Set (Fin n))) := by
      rw [Set.image_image]
      simp only [htφ]
    rw [h5, ← Ideal.map_span, Ideal.comap_map_of_surjective φ hφ, ← RingHom.ker_eq_comap_bot,
      hker, ← ht0, ← Ideal.span_union]
    congr 1
    ext a
    simp only [Finset.coe_insert, Finset.coe_image, Set.image_insert_eq, Set.image_image,
      Set.mem_union, Set.mem_singleton_iff, Set.mem_insert_iff]
    tauto

end MMP.Resolution.Kollar
