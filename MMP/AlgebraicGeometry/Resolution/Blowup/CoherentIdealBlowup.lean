module
public import MMP.AlgebraicGeometry.Resolution.Blowup.ProjectiveBirationalIsBlowup
public import MMP.AlgebraicGeometry.Resolution.Blowup.VarietyProjective

/-!
# The blow-up of a quasi-projective variety in a coherent ideal

Let `X` be a quasi-projective variety over a field `k` and `J ⊆ 𝒪_X` a non-zero coherent ideal.
The blow-up `Bl_J X = Proj_X ⨁_{n ≥ 0} Jⁿ` is projective and birational over `X`, an
isomorphism over `X ∖ V(J)`, and `J · 𝒪_{Bl_J X}` is invertible. It is the terminal scheme over
`X` on which the inverse image of `J` is invertible, and every projective birational morphism
from a variety to `X` is, up to isomorphism over `X`, such a blow-up.

## Main results

* `MMP.Blowup.isBirational_blowUpToBase_and_exists_iso_blowUp`: the statement above.

## Implementation notes

The blow-up is `AlgebraicGeometry.blowUp J` with structure morphism
`AlgebraicGeometry.blowUpToBase J`; coherent ideals are `Scheme.IdealSheafData` of finite type,
and "non-zero" is `J ≠ ⊥`. An ideal sheaf is invertible exactly when it is locally generated by
a non-zero-divisor, i.e. when it cuts out an effective Cartier divisor
(`Stacks.Divisors.IsEffectiveCartierDivisor`). Projectivity is
`AlgebraicGeometry.IsProjective` ([Stacks, Tag 01W8]) and birationality is
`AlgebraicGeometry.IsBirational`.

## References

* [KM98] J. Kollár, S. Mori, *Birational geometry of algebraic varieties*.
* [Har77] R. Hartshorne, *Algebraic geometry*, II.7.13, II.7.14, II.7.17.
-/

public section

universe u

open CategoryTheory AlgebraicGeometry

namespace MMP.Blowup

/-- **The blow-up package.** Let `X` be a quasi-projective variety over `k` and `J` a non-zero
coherent ideal sheaf on `X`. Then

* `blowUpToBase J : blowUp J ⟶ X` is projective and birational;
* it is an isomorphism over the complement of the support of `J`;
* the inverse image `J · 𝒪_{Bl_J X}` is invertible (an effective Cartier divisor);
* every morphism `g : Y ⟶ X` with `g⁻¹J · 𝒪_Y` invertible factors uniquely through
  `blowUpToBase J`;
* every projective birational morphism `f : X' ⟶ X` from an integral scheme is isomorphic over
  `X` to `blowUpToBase J'` for some non-zero coherent ideal sheaf `J'` on `X`. -/
@[mmp "lem_mmp_foundation_km5b_full_blowup_package"]
public theorem isBirational_blowUpToBase_and_exists_iso_blowUp {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsQuasiProjectiveVariety k sX]
    (J : X.IdealSheafData) (hJ : J ≠ ⊥) (hJft : J.IsFiniteType) :
    IsProjective (blowUpToBase J) ∧ IsBirational (blowUpToBase J) ∧
      IsIso (blowUpToBase J ∣_ J.support.compl) ∧
      Stacks.Divisors.IsEffectiveCartierDivisor (J.comap (blowUpToBase J)) ∧
      (∀ {Y : Scheme.{u}} (g : Y ⟶ X), Stacks.Divisors.IsEffectiveCartierDivisor (J.comap g) →
        ∃! h : Y ⟶ blowUp J, h ≫ blowUpToBase J = g) ∧
      (∀ {X' : Scheme.{u}} [IsIntegral X'] (f : X' ⟶ X), IsProjective f → IsBirational f →
        ∃ (J' : X.IdealSheafData) (_ : J' ≠ ⊥) (_ : J'.IsFiniteType) (e : X' ≅ blowUp J'),
          e.hom ≫ blowUpToBase J' = f) := by
  obtain ⟨-, hproj, hbir⟩ :=
    MMP.Flips.ResolutionInputs.isVariety_blowUp_and_isProjective_and_isBirational sX J hJ
  exact ⟨hproj, hbir, isIso_blowUpToBase_restrict_compl_support J,
    Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal J,
    fun g hg ↦ ⟨blowUpLift J g hg, blowUpLift_comp J g hg, blowUpLift_unique J g hg⟩,
    fun f ↦ MMP.exists_blowUp_iso_of_isProjective_of_isBirational sX f⟩

end MMP.Blowup

end
