        (I.comap (blowUpToBase I)).ideal (blowUpChartOpen I U (generatorSection I U f hf m)) =
          Ideal.span {(blowUpChartMap I U (generatorSection I U f hf m)).hom (f m)} :=
  ⟨iSup_blowUpChartOpen_eq_preimage I U f hf, fun m =>
    ⟨(blowUpChartOpen I U _).2,
      fun l => by
        rw [regularChartPresentation_X]
        exact blowUpChartMap_eq_blowUpChartFraction_mul I U _ _,
      (regularChartPresentation_surjective_and_ker I U f hf hloc m).1,
      (regularChartPresentation_surjective_and_ker I U f hf hloc m).2,
      ideal_comap_blowUpChartOpen_generatorSection I U f hf m⟩⟩

