/-!
# Charts of the blow-up along a locally regular sequence

Let `A` be a Noetherian ring and `f_1, …, f_s ∈ A` a sequence which is regular in the local ring
`A_𝔭` of every prime `𝔭 ⊇ (f_1, …, f_s)`, and let `π : B_I Spec A → Spec A` be the blow-up of
`I = (f_1, …, f_s)`. Then `B_I Spec A` is covered by the charts `D_+(f_m)`, each chart is
`Spec A[t_l : l ≠ m]/(f_l - t_l f_m : l ≠ m)` over `A` with `t_l = f_l / f_m`, and `π^*I` is
generated by `f_m` on `D_+(f_m)`.

The algebra behind this is that the sequence `f_m, (f_l)_{l ≠ m}` is `H₁`-regular in `A`: the
first Koszul homology vanishes after localizing at a maximal ideal, either because one of the
`f_l` becomes a unit, or because the localized sequence is regular, in any order. An
`H₁`-regular sequence makes `f_m` a nonzerodivisor on `A[t_l]/(f_l - t_l f_m)`, which is
therefore the affine blow-up algebra `A[I/f_m] ⊆ A_{f_m}`.

## Main definitions

* `MMP.Flips.ResolutionInputs.blowUpChartFraction`: the fraction `b / a` on the chart `D_+(a)`.
* `MMP.Flips.ResolutionInputs.regularChartPresentation`: `A[t_l : l ≠ m] → 𝒪(D_+(f_m))`,
  `t_l ↦ f_l / f_m`.
* `MMP.Flips.ResolutionInputs.regularChartEquiv`: the induced isomorphism
  `A[t_l : l ≠ m]/(f_l - t_l f_m) ≃ 𝒪(D_+(f_m))`.

## Main results

* `MMP.Flips.ResolutionInputs.isH1Regular_of_isUnit`: a sequence with a unit term is
  `H₁`-regular.
* `MMP.Flips.ResolutionInputs.isH1Regular_comp_of_forall_isRegular_localization`: a sequence
  regular at every prime containing it is `H₁`-regular, in any order.
* `MMP.Flips.ResolutionInputs.regularChartPresentation_surjective_and_ker`: the chart
  presentation is surjective with kernel `(f_l - t_l f_m)`.
* `MMP.Flips.ResolutionInputs.ideal_comap_blowUpChartOpen_generatorSection`: `π^*I` is
  generated by `f_m` on `D_+(f_m)`.
* `MMP.Flips.ResolutionInputs.iSup_blowUpChartOpen_eq_preimage`: the charts `D_+(f_m)` cover
  `π⁻¹(U)`.
* `MMP.Flips.ResolutionInputs.regularSequence_blowUp_charts`: the cover, the chart equations,
  and the inverse image of the centre, together.

## Implementation notes

The statement is made over an affine open `U` of an arbitrary scheme `X` carrying an ideal sheaf
`I` with `I(U) = (f_1, …, f_s)` and `𝒪_X(U)` Noetherian; the case of `Spec A` is `U = ⊤`. The
chart `D_+(f_m)` is `AlgebraicGeometry.blowUpChartOpen`, and the inverse image `π^*I` is
`I.comap (blowUpToBase I)`.

## References

* [J. Kollár, *Lectures on resolution of singularities*, 3.47, 3.60]
* [Stacks Project, Tag 0BIQ](https://stacks.math.columbia.edu/tag/0BIQ)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

universe u

namespace MMP.Flips.ResolutionInputs

/-! ### `H₁`-regularity of a locally regular sequence -/

section H1Regular

/-- A finite sequence one of whose terms is a unit is `H₁`-regular. -/
theorem isH1Regular_of_isUnit {A : Type*} [CommRing A] {r : ℕ} (g : Fin r → A) (j : Fin r)
    (hj : IsUnit (g j)) : Koszul.IsH1Regular g := by
  classical
  rw [Koszul.isH1Regular_iff_forall]
  intro a ha
  obtain ⟨u, hu⟩ := hj.exists_left_inv
  have key : a = ∑ i, (-(u * a i)) • Koszul.trivRel g i j := by
    funext k
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply, Koszul.trivRel, Pi.sub_apply, smul_eq_mul, mul_sub,
      Finset.sum_sub_distrib, Pi.single_apply]
    rw [show ∑ i, -(u * a i) * (if k = i then g j else 0) = -(u * a k) * g j by simp]
    by_cases hkj : k = j
    · subst hkj
      have h1 : ∑ i, -(u * a i) * (if k = k then g i else 0) = 0 := by
        simp only [ite_true]
        calc ∑ i, -(u * a i) * g i = -u * ∑ i, a i * g i := by
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl fun i _ => by ring
          _ = 0 := by rw [ha, mul_zero]
      rw [h1]
      linear_combination (-(a k)) * hu
    · simp only [hkj, ite_false, mul_zero, Finset.sum_const_zero]
      linear_combination (-(a k)) * hu
  rw [key]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Koszul.trivRel_mem_relSpan g i j)

/-- **A locally regular sequence is `H₁`-regular, in every order.** Let `A` be Noetherian and let
`f_1, …, f_s` be a regular sequence in `A_𝔭` for every prime `𝔭 ⊇ (f_1, …, f_s)`. Then every
reordering of `f` is `H₁`-regular in `A`. -/
theorem isH1Regular_comp_of_forall_isRegular_localization {A : Type*} [CommRing A]
    [IsNoetherianRing A] {r s : ℕ} (f : Fin s → A)
    (hloc : ∀ (P : Ideal A) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap A (Localization.AtPrime P) (f i)))
    (σ : Fin r ≃ Fin s) : Koszul.IsH1Regular (f ∘ σ) := by
  obtain rfl : r = s := by simpa using Fintype.card_congr σ
  refine Koszul.isH1Regular_of_forall_localization_maximal _ fun P hP => ?_
  by_cases hle : Ideal.span (Set.range f) ≤ P
  · have hreg' := IsLocalRing.isRegular_of_perm (M := Localization.AtPrime P) (hloc P hle)
      (Equiv.Perm.ofFn_comp_perm σ fun i => algebraMap A (Localization.AtPrime P) (f i)).symm
    have hK := (Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular
      (M := Localization.AtPrime P)).2.2 hreg'
    exact (Koszul.isH1RegularOn_self_iff _).1
      ((Koszul.isKoszulRegularOn_self_iff _).2 hK).isH1RegularOn
  · obtain ⟨i, hi⟩ : ∃ i, f i ∉ P := by
      by_contra h
      push Not at h
      exact hle (Ideal.span_le.2 (Set.range_subset_iff.2 h))
    refine isH1Regular_of_isUnit _ (σ.symm i) ?_
    simp only [Function.comp_apply, Equiv.apply_symm_apply]
    exact IsLocalization.map_units (Localization.AtPrime P) (⟨f i, hi⟩ : P.primeCompl)

end H1Regular

/-! ### The charts of the blow-up -/

section Charts

variable {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)

/-- The fraction `b / a` on the chart `D_+(a)` of the blow-up over an affine open `U`, for
sections `a, b` of `I` over `U`: the element of the affine blow-up algebra `𝒪_X(U)[I(U)/a]`
read on the chart. -/
def blowUpChartFraction (a : I.ideal U) {b : Γ(X, U.1)} (hb : b ∈ I.ideal U) :
    Γ(blowUp I, (blowUpChartOpen I U a).1) :=
  (blowUpChartRingIso I U a).inv.hom
    ⟨IsLocalization.mk' (Localization.Away (a : Γ(X, U.1))) b
      (⟨a, Submonoid.mem_powers _⟩ : Submonoid.powers (a : Γ(X, U.1))),
      Algebra.subset_adjoin ⟨b, hb, rfl⟩⟩

/-- The fraction `b / a` times the pull-back of `a` is the pull-back of `b`. -/
theorem blowUpChartMap_eq_blowUpChartFraction_mul (a : I.ideal U) {b : Γ(X, U.1)}
    (hb : b ∈ I.ideal U) :
    (blowUpChartMap I U a).hom b =
      blowUpChartFraction I U a hb * (blowUpChartMap I U a).hom (a : Γ(X, U.1)) := by
  apply (blowUpChartRingIso I U a).commRingCatIsoToRingEquiv.injective
  change (blowUpChartRingIso I U a).hom.hom _ = (blowUpChartRingIso I U a).hom.hom _
  rw [map_mul, blowUpChartRingIso_hom_blowUpChartMap, blowUpChartRingIso_hom_blowUpChartMap,
    blowUpChartFraction, ← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
  exact Subtype.ext (IsLocalization.mk'_spec _ _ _).symm

variable {s : ℕ} (f : Fin s → Γ(X, U.1)) (hf : I.ideal U = Ideal.span (Set.range f))

include hf in
/-- Each generator `f_i` of `I(U) = (f_1, …, f_s)` lies in `I(U)`. -/
theorem mem_ideal_of_eq_span (i : Fin s) : f i ∈ I.ideal U :=
  hf ▸ Ideal.subset_span ⟨i, rfl⟩

/-- The generator `f_m` as a section of `I` over `U`. -/
abbrev generatorSection (m : Fin s) : I.ideal U := ⟨f m, mem_ideal_of_eq_span I U f hf m⟩

/-- **The charts of the generators cover the blow-up over `U`.** If `f_1, …, f_s` generate
`I(U)`, then `π⁻¹(U) = ⋃_m D_+(f_m)`. -/
theorem iSup_blowUpChartOpen_eq_preimage :
    ⨆ m, (blowUpChartOpen I U (generatorSection I U f hf m)).1 = blowUpToBase I ⁻¹ᵁ U.1 := by
  classical
  refine le_antisymm (iSup_le fun m => blowUpChartOpen_le I U _) fun x hx => ?_
  let g : Fin s → I.ideal U := generatorSection I U f hf
  let A : Finset (I.ideal U) := insert 0 (Finset.univ.image g)
  have hspan : Ideal.span ((fun a : I.ideal U => (a : Γ(X, U.1))) '' (A : Set (I.ideal U))) =
      I.ideal U := by
    refine Eq.trans ?_ hf.symm
    simp only [A, Finset.coe_insert, Finset.coe_image, Finset.coe_univ, Set.image_univ,
      Set.image_insert_eq, ZeroMemClass.coe_zero, Ideal.span_insert_zero]
    congr 1
    rw [← Set.range_comp]
    rfl
  rw [← iSup_blowUpChartOpen I U A (Finset.insert_nonempty _ _) hspan] at hx
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨haA, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp ha
  rcases Finset.mem_insert.mp haA with rfl | haA
  · obtain ⟨y, -⟩ : x ∈ (blowUpAffineChart I U 0).opensRange := by
      rwa [← Scheme.Hom.image_top_eq_opensRange]
    exact ((isEmpty_spec_blowUpAffineChartRing_of_eq_zero I U 0 rfl).false y).elim
  · obtain ⟨m, -, rfl⟩ := Finset.mem_image.mp haA
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨m, hxa⟩

/-- **The inverse image of the centre on a chart.** On `D_+(f_m)` the ideal `π^*I` is generated
by the pull-back of `f_m`. -/
theorem ideal_comap_blowUpChartOpen_generatorSection (m : Fin s) :
    (I.comap (blowUpToBase I)).ideal (blowUpChartOpen I U (generatorSection I U f hf m)) =
      Ideal.span {(blowUpChartMap I U (generatorSection I U f hf m)).hom (f m)} :=
  ideal_exceptionalIdeal_blowUpChartOpen I U _

/-- The presentation `𝒪_X(U)[t_l : l ≠ m] → 𝒪(D_+(f_m))` of a chart of the blow-up: the
pull-back on `𝒪_X(U)` and `t_l ↦ f_l / f_m`. -/
def regularChartPresentation (m : Fin s) :
    MvPolynomial {l : Fin s // l ≠ m} Γ(X, U.1) →+*
      Γ(blowUp I, (blowUpChartOpen I U (generatorSection I U f hf m)).1) :=
  MvPolynomial.eval₂Hom (blowUpChartMap I U (generatorSection I U f hf m)).hom
    fun l => blowUpChartFraction I U _ (mem_ideal_of_eq_span I U f hf l.1)

/-- The chart presentation sends a constant `r` to the pull-back of `r`. -/
@[simp]
theorem regularChartPresentation_C (m : Fin s) (r : Γ(X, U.1)) :
    regularChartPresentation I U f hf m (MvPolynomial.C r) =
      (blowUpChartMap I U (generatorSection I U f hf m)).hom r :=
  MvPolynomial.eval₂Hom_C _ _ _

/-- The chart presentation sends the variable `t_l` to the fraction `f_l / f_m`. -/
@[simp]
theorem regularChartPresentation_X (m : Fin s) (l : {l : Fin s // l ≠ m}) :
    regularChartPresentation I U f hf m (MvPolynomial.X l) =
      blowUpChartFraction I U _ (mem_ideal_of_eq_span I U f hf l.1) :=
  MvPolynomial.eval₂Hom_X' _ _ _

/-- **The equations of a chart of the blow-up along a locally regular sequence.** If `𝒪_X(U)` is
Noetherian and `f_1, …, f_s` generate `I(U)` and form a regular sequence in the local ring at
every prime containing them, then `𝒪_X(U)[t_l : l ≠ m] → 𝒪(D_+(f_m))`, `t_l ↦ f_l / f_m`, is
surjective with kernel generated by the `f_l - t_l f_m`. -/
theorem regularChartPresentation_surjective_and_ker [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i)))
    (m : Fin s) :
    Function.Surjective (regularChartPresentation I U f hf m) ∧
      RingHom.ker (regularChartPresentation I U f hf m) =
        Ideal.span (Set.range fun l : {l : Fin s // l ≠ m} =>
          MvPolynomial.C (f l.1) - MvPolynomial.X l * MvPolynomial.C (f m)) := by
  classical
  let Θ : Γ(blowUp I, (blowUpChartOpen I U (generatorSection I U f hf m)).1) →+*
      Localization.Away (f m) :=
    (Subalgebra.val _).toRingHom.comp (blowUpChartRingIso I U (generatorSection I U f hf m)).hom.hom
  have hΘinj : Function.Injective Θ :=
    Subtype.val_injective.comp
      (blowUpChartRingIso I U (generatorSection I U f hf m)).commRingCatIsoToRingEquiv.injective
  have hcomp : Θ.comp (regularChartPresentation I U f hf m) =
      (MvPolynomial.aeval (R := Γ(X, U.1)) fun l : {l : Fin s // l ≠ m} =>
        IsLocalization.mk' (Localization.Away (f m)) (f l.1)
          (⟨f m, Submonoid.mem_powers _⟩ : Submonoid.powers (f m))).toRingHom := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun l => ?_)
    · simp only [RingHom.comp_apply, regularChartPresentation_C, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.aeval_C]
      exact congrArg Subtype.val (blowUpChartRingIso_hom_blowUpChartMap I U _ r)
    · simp only [RingHom.comp_apply, regularChartPresentation_X, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe, MvPolynomial.aeval_X]
      change Subtype.val ((blowUpChartRingIso I U (generatorSection I U f hf m)).hom.hom
        ((blowUpChartRingIso I U (generatorSection I U f hf m)).inv.hom _)) = _
      rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
  have hcard : Fintype.card {l : Fin s // l ≠ m} = s - 1 := by
    simp [Fintype.card_subtype_compl]
  obtain ⟨n, hn⟩ : ∃ n, s = n + 1 := ⟨s - 1, by have := m.pos; omega⟩
  let e : Fin n ≃ {l : Fin s // l ≠ m} :=
    (Fintype.equivFinOfCardEq (hcard.trans (by omega))).symm
  let σ : Fin (n + 1) ≃ Fin s :=
    (finSuccEquiv n).trans ((Equiv.optionCongr e).trans (Equiv.optionSubtypeNe m))
  let b : {l : Fin s // l ≠ m} → Γ(X, U.1) := fun l => f l.1
  have hH1 : Koszul.IsH1Regular (Fin.cases (f m) (fun j => b (e j)) : Fin (n + 1) → Γ(X, U.1)) := by
    convert isH1Regular_comp_of_forall_isRegular_localization f hloc σ using 1
    funext j
    induction j using Fin.cases <;> simp [σ, b]
  obtain ⟨halg1, halg2⟩ := aeval_mk'_range_and_ker_of_isH1Regular e (f m) b hH1
  have hI : I.ideal U = Ideal.span (insert (f m) (Set.range b)) := by
    rw [hf]
    congr 1
    ext y
    simp only [Set.mem_range, Set.mem_insert_iff, b]
    refine ⟨fun ⟨i, hi⟩ => ?_, by rintro (rfl | ⟨i, rfl⟩) <;> exact ⟨_, rfl⟩⟩
    rcases eq_or_ne i m with rfl | him
    exacts [Or.inl hi.symm, Or.inr ⟨⟨i, him⟩, hi⟩]
  refine ⟨fun t => ?_, ?_⟩
  · have hmem : Θ t ∈ affineBlowupAlgebra (Ideal.span (insert (f m) (Set.range b))) (f m)
        (Localization.Away (f m)) := by
      rw [← hI]
      exact ((blowUpChartRingIso I U (generatorSection I U f hf m)).hom.hom t).2
    obtain ⟨p, hp⟩ := halg1 (Θ t) hmem
    exact ⟨p, hΘinj (by rwa [← RingHom.comp_apply, hcomp])⟩
  · rwa [← RingHom.ker_comp_of_injective (regularChartPresentation I U f hf m) hΘinj, hcomp]

/-- **A chart of the blow-up along a locally regular sequence**:
`𝒪_X(U)[t_l : l ≠ m]/(f_l - t_l f_m) ≃ 𝒪(D_+(f_m))`, with `t_l ↦ f_l / f_m`
(`MMP.Flips.ResolutionInputs.regularChartEquiv_mk_X`) and compatible with the pull-back from
`𝒪_X(U)` (`MMP.Flips.ResolutionInputs.regularChartEquiv_mk_C`). -/
@[mmp "lem_mmp_foundation_regular_sequence_blowup_charts"]
def regularChartEquiv [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i)))
    (m : Fin s) :
    (MvPolynomial {l : Fin s // l ≠ m} Γ(X, U.1) ⧸
        Ideal.span (Set.range fun l : {l : Fin s // l ≠ m} =>
          MvPolynomial.C (f l.1) - MvPolynomial.X l * MvPolynomial.C (f m))) ≃+*
      Γ(blowUp I, (blowUpChartOpen I U (generatorSection I U f hf m)).1) :=
  (Ideal.quotEquivOfEq (regularChartPresentation_surjective_and_ker I U f hf hloc m).2.symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (regularChartPresentation_surjective_and_ker I U f hf hloc m).1)

/-- The chart isomorphism sends the class of a polynomial `p` to its image under the chart
presentation. -/
@[simp]
theorem regularChartEquiv_mk [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i)))
    (m : Fin s) (p : MvPolynomial {l : Fin s // l ≠ m} Γ(X, U.1)) :
    regularChartEquiv I U f hf hloc m (Ideal.Quotient.mk _ p) =
      regularChartPresentation I U f hf m p :=
  rfl

/-- The chart isomorphism sends the class of `t_l` to the fraction `f_l / f_m`. -/
theorem regularChartEquiv_mk_X [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i)))
    (m : Fin s) (l : {l : Fin s // l ≠ m}) :
    regularChartEquiv I U f hf hloc m (Ideal.Quotient.mk _ (MvPolynomial.X l)) =
      blowUpChartFraction I U _ (mem_ideal_of_eq_span I U f hf l.1) := by
  rw [regularChartEquiv_mk, regularChartPresentation_X]

/-- The chart isomorphism sends the class of a constant `r` to the pull-back of `r`. -/
theorem regularChartEquiv_mk_C [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i)))
    (m : Fin s) (r : Γ(X, U.1)) :
    regularChartEquiv I U f hf hloc m (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
      (blowUpChartMap I U (generatorSection I U f hf m)).hom r := by
  rw [regularChartEquiv_mk, regularChartPresentation_C]

/-- **Explicit equations for every chart of a regular-centre blow-up.** Let `U` be an affine
open of `X` with `𝒪_X(U)` Noetherian, and `f_1, …, f_s` generators of `I(U)` forming a regular
sequence in the local ring at every prime containing them. Then
1. the charts `D_+(f_m)` cover `π⁻¹(U)`;
2. each chart `D_+(f_m)` is affine and `𝒪_X(U)[t_l : l ≠ m] → 𝒪(D_+(f_m))`,
   `t_l ↦ f_l / f_m`, is surjective with kernel generated by the `f_l - t_l f_m`, so that
   `𝒪(D_+(f_m)) ≃ 𝒪_X(U)[t_l : l ≠ m]/(f_l - t_l f_m)`
   (`MMP.Flips.ResolutionInputs.regularChartEquiv`), and the pull-back of `f_l` is
   `t_l · f_m`;
3. on `D_+(f_m)` the ideal `π^*I` is generated by `f_m`. -/
@[mmp "lem_mmp_foundation_regular_sequence_blowup_charts"]
theorem regularSequence_blowUp_charts [IsNoetherianRing Γ(X, U.1)]
    (hloc : ∀ (P : Ideal Γ(X, U.1)) [P.IsPrime], Ideal.span (Set.range f) ≤ P →
      RingTheory.Sequence.IsRegular (Localization.AtPrime P)
        (List.ofFn fun i => algebraMap Γ(X, U.1) (Localization.AtPrime P) (f i))) :
    ⨆ m, (blowUpChartOpen I U (generatorSection I U f hf m)).1 = blowUpToBase I ⁻¹ᵁ U.1 ∧
      ∀ m : Fin s,
        IsAffineOpen (blowUpChartOpen I U (generatorSection I U f hf m)).1 ∧
        (∀ l : {l : Fin s // l ≠ m}, (blowUpChartMap I U (generatorSection I U f hf m)).hom (f l)
          = regularChartPresentation I U f hf m (MvPolynomial.X l) *
            (blowUpChartMap I U (generatorSection I U f hf m)).hom (f m)) ∧
        Function.Surjective (regularChartPresentation I U f hf m) ∧
        RingHom.ker (regularChartPresentation I U f hf m) =
          Ideal.span (Set.range fun l : {l : Fin s // l ≠ m} =>
