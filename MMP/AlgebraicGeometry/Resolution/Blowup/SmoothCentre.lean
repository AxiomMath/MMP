/-!
# Smooth blow-ups of smooth centres

Let `X` be smooth over a field `k` and `Z ⊆ X` a closed subscheme smooth over `k`. The blow-up
`B_Z X` and its exceptional divisor `F` are smooth over `k`, `I_Z/I_Z²` is a finite locally free
`𝒪_Z`-module, `F ≅ 𝐏(I_Z/I_Z²)` over `Z`, and the fibre of `F ⟶ Z` over `z` is
`ℙ^{c-1}_{κ(z)}`, `c` the codimension of `Z` in `X` at `z`.

## Main results

* `MMP.Resolution.Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup`.

## Implementation notes

* The codimension of `Z` in `X` at `z` is the height of the ideal `I_{Z,z}` of `Z` in `𝒪_{X,z}`,
  the kernel of the surjection `𝒪_{X,z} ⟶ 𝒪_{Z,z}`.
* The blow-up is `AlgebraicGeometry.blowUp` with `AlgebraicGeometry.blowUpToBase`, and the
  exceptional divisor `F = π⁻¹(Z)` is `AlgebraicGeometry.exceptionalDivisor`, cut out by
  `AlgebraicGeometry.exceptionalIdeal`. A smooth blow-up is `MMP.Resolution.IsSmoothBlowup`,
  with the centre `Z = V(I)` given by its ideal sheaf `I`.
* `I_Z/I_Z²` is `Stacks.Conormal.conormalSheafDegreeOne I.subschemeι` and
  `Proj_Z Sym(I_Z/I_Z²)` is `Stacks.RelativeProj.projectiveBundle`. The morphism `F ⟶ Z` is
  `Scheme.IdealSheafData.subschemeMap` of the blow-up morphism.
* `ℙ^{c-1}_{κ(z)}` is `MMP.Intersection.ProjSpace κ(z) (ULift (Fin c))` (`c` homogeneous
  coordinates), a `κ(z)`-scheme through `MMP.Intersection.ProjSpace.toSpec`; the fibre is a
  `κ(z)`-scheme through `Scheme.Hom.fiberToSpecResidueField`. For `c = 0` both are empty.
-/

@[expose] public section

universe u

open CategoryTheory Limits AlgebraicGeometry

namespace MMP.Resolution.Bridges

open Stacks.AlgebraicGeometry (coordinateSubspaceEmbedding)
open Stacks.RelativeDifferentialStalkMap (algebraStalkMap)

variable {k : Type u} [Field k]

private theorem smooth_of_isSmoothScheme {X Y : Scheme.{u}} {f : X ⟶ Y}
    (h : MMP.Mori.IsSmoothScheme f) : Smooth f := by
  have : IsZariskiLocalAtSource @Smooth := HasRingHomProperty.instIsZariskiLocalAtSource
  refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth)
    (fun U : {U : X.Opens // Smooth (U.ι ≫ f)} => U.1) ?_ fun U => U.2
  rw [← h, MMP.Mori.smoothLocus, sSup_eq_iSup']
  rfl

/-! ### Height of the centre ideal and rank of the conormal sheaf -/

section Height

open RingTheory.Sequence

/-- A weakly regular sequence of length `n` generates an ideal of height at least `n`. -/
private theorem le_height_ofList_of_isWeaklyRegular {R : Type*} [CommRing R] [IsNoetherianRing R]
    (rs : List R) (hreg : IsWeaklyRegular R rs) :
    (rs.length : ℕ∞) ≤ (Ideal.ofList rs).height := by
  rw [Ideal.height_eq_inf_minimalPrimes]
  refine le_iInf₂ fun P hP => ?_
  have hPp : P.IsPrime := hP.1.1
  have hle : ∀ r ∈ rs, r ∈ P := fun r hr => hP.1.2 (Ideal.subset_span hr)
  let S := Localization.AtPrime P
  have hS : IsRegular S (rs.map (algebraMap R S)) :=
    hreg.isRegular_of_isLocalization_of_mem S P hle
  have h1 := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular _ hS
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height P S] at h1
  have hne : Nontrivial (S ⧸ Ideal.ofList (rs.map (algebraMap R S))) :=
    Ideal.Quotient.nontrivial_iff.mpr fun htop => hS.2 (by simp [htop])
  have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim (S ⧸ Ideal.ofList (rs.map (algebraMap R S))) :=
    ringKrullDim_nonneg_of_nontrivial
  rw [List.length_map] at h1
  have : ((rs.length : ℕ∞) : WithBot ℕ∞) ≤ ((P.height : ℕ∞) : WithBot ℕ∞) := by
    rw [← h1]
    calc ((rs.length : ℕ∞) : WithBot ℕ∞) = 0 + (rs.length : WithBot ℕ∞) := by simp
      _ ≤ _ := by gcongr
  exact_mod_cast this

/-- A proper ideal generated by `n` elements has height at most `n` (Krull's height theorem). -/
private theorem height_ofList_le {R : Type*} [CommRing R] [IsNoetherianRing R]
    (rs : List R) (hne : Ideal.ofList rs ≠ ⊤) :
    (Ideal.ofList rs).height ≤ (rs.length : ℕ∞) := by
  classical
  refine (Ideal.height_le_spanRank_toENat _ hne).trans ?_
  have : Ideal.ofList rs = Ideal.span (rs.toFinset : Set R) := by
    simp [Ideal.ofList]
  rw [this]
  refine (OrderHomClass.mono Cardinal.toENat (Submodule.spanRank_span_le_card _)).trans ?_
  have h : Cardinal.mk ((rs.toFinset : Set R)) = rs.toFinset.card := by
    simp only [Finset.coe_sort_coe]
    exact Cardinal.mk_coe_finset
  rw [h]
  have h2 : Cardinal.toENat (rs.toFinset.card : Cardinal) = (rs.toFinset.card : ℕ∞) := by
    simp
  rw [h2]
  exact_mod_cast List.toFinset_card_le rs

end Height

/-- Composing with the inclusion of an open does not change the height of the kernel of the stalk
map. -/
private theorem height_ker_stalkMap_eq_of_comp_opens {Z X : Scheme.{u}} (U : X.Opens)
    (j : Z ⟶ U.toScheme) (i : Z ⟶ X) (h : j ≫ U.ι = i) (z : Z) :
    (RingHom.ker (i.stalkMap z).hom).height = (RingHom.ker (j.stalkMap z).hom).height := by
  subst h
  let e : X.presheaf.stalk ((j ≫ U.ι) z) ≅ U.toScheme.presheaf.stalk (j z) :=
    (U.stalkIso (j z)).symm
  have hcomp : (j ≫ U.ι).stalkMap z = e.hom ≫ j.stalkMap z := by
    rw [Scheme.Hom.stalkMap_comp]
    exact (congrArg (fun t => t ≫ j.stalkMap z) (Scheme.Opens.stalkIso_inv U (j z))).symm
  have hker : RingHom.ker ((j ≫ U.ι).stalkMap z).hom =
      (RingHom.ker (j.stalkMap z).hom).comap e.commRingCatIsoToRingEquiv := by
    rw [hcomp, CommRingCat.hom_comp, ← RingHom.comap_ker]
    rfl
  rw [hker, RingEquiv.height_comap]

open Stacks.AlgebraicGeometry Stacks.AlgebraicGeometry.RegularIdealSheaf in
/-- **The rank of the conormal sheaf of a regular immersion at `z` is the height of the ideal of
`Z` in the local ring of `X` at `i z`.** A regular sequence generating the ideal near `i z` has
length equal to the fibre rank of the conormal sheaf, and its germs are a regular sequence of the
local ring. -/
private theorem fiberRank_conormalModule_eq_height {Z X : Scheme.{u}}
    [IsLocallyNoetherian X] (i : Z ⟶ X) [IsImmersion i] (hi : IsRegularImmersion i) (z : Z) :
    ((Scheme.Modules.fiberRank (Stacks.Chow.conormalModule i) z : ℕ) : ℕ∞) =
      (RingHom.ker (i.stalkMap z).hom).height := by
  set U := i.coborderRange
  set j : Z ⟶ U.toScheme := i.liftCoborder
  have hij : j ≫ U.ι = i := i.liftCoborder_ι
  have hreg : IsRegularIdealSheaf U.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom j) := (isRegularImmersion_iff_of_open i U j hij).mp hi
  have hx : j z ∈ idealQuotientSupport U.toScheme.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom j) :=
    (mem_idealQuotientSupport_definingIdealOfHom_iff j (j z)).mpr (subset_closure ⟨z, rfl⟩)
  obtain ⟨U₀, hxU₀, s, g, hgreg, hgen⟩ := hreg (j z) hx
  have hrank : Scheme.Modules.fiberRank (Stacks.Chow.conormalModule i) z = s := by
    rw [Scheme.Modules.fiberRank_eq_of_iso (Stacks.Chow.immersionConormalSheafFactorIso U j hij) z]
    obtain ⟨V, hV, hxV, hVU₀⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp U.toScheme.isBasis_affineOpens hxU₀
    have hker := ker_app_eq_span_range j hV _ (isGeneratedByOn_of_le U₀ g hgen V hVU₀)
    have hq := isQuasiRegular_of_isWeaklyRegular _ (isWeaklyRegular_of_isRegularSequenceOn
      U.toScheme V hV _ (isRegularSequenceOn_of_le _ hVU₀ g hgreg))
    exact Stacks.Conormal.fiberRank_conormalSheaf_eq_of_isQuasiRegular j hV
      (by rw [Stacks.Conormal.coborderRange_eq_top j]; exact le_top) _ hq hker hxV
  set rs := List.ofFn (germFamily U.toScheme.toLocallyRingedSpace.toRingedSpace U₀ g (j z) hxU₀)
  have hspan : Ideal.ofList rs = RingHom.ker (j.stalkMap z).hom := by
    rw [ideal_ofList_ofFn, ← stalkIdeal_definingIdealOfHom_eq_ker,
      stalkIdeal_eq_Jid_germFamily _ U₀ g hgen (j z) hxU₀]
    rfl
  have hrs : RingTheory.Sequence.IsWeaklyRegular (U.toScheme.presheaf.stalk (j z)) rs :=
    isWeaklyRegular_germFamily_of_isRegularSequenceOn _ U₀ g hgreg (j z) hxU₀
  have hht : (RingHom.ker (j.stalkMap z).hom).height = (s : ℕ∞) := by
    rw [← hspan]
    exact le_antisymm (by simpa [rs] using height_ofList_le rs (hspan ▸ RingHom.ker_ne_top _))
      (by simpa [rs] using le_height_ofList_of_isWeaklyRegular rs hrs)
  rw [height_ker_stalkMap_eq_of_comp_opens U j i hij z, hht, hrank]

/-! ### The fibre of a projective bundle -/

section Fibre

open Stacks.RelativeProj (projectiveBundle projectiveBundleToBase)
open Stacks.AlgebraicGeometry.ProjPolyChart (polyGrading projToSpecCoeff)

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The fibre of a projective bundle over `y` is `ℙⁿ_{κ(y)}` as soon as the module is free of rank
`n + 1` on a neighbourhood of `y`. -/
private theorem exists_isPullback_projectiveBundle_of_restrict_free {X : Scheme.{u}}
    (E : X.Modules) [E.IsQuasicoherent] (n : ℕ) (y : X) (U : X.Opens) (hyU : y ∈ U)
    (e : E.restrict U.ι ≅
      SheafOfModules.free (R := U.toScheme.ringCatSheaf) (ULift.{u} (Fin (n + 1)))) :
    ∃ φ : AlgebraicGeometry.Proj (polyGrading (X.residueField y) n) ⟶ projectiveBundle X E,
      IsPullback φ (projToSpecCoeff (X.residueField y) n) (projectiveBundleToBase X E)
        (X.fromSpecResidueField y) := by
  let j : Spec (CommRingCat.of (X.residueField y)) ⟶ X := X.fromSpecResidueField y
  have hj : Set.range j ⊆ U := by
    simpa [j, X.range_fromSpecResidueField] using hyU
  obtain ⟨hF⟩ := Stacks.ProjectiveBundleFibre.nonempty_iso_pullback_of_restrict_free E _ U e j hj
  let F := SheafOfModules.free (R := (Spec (CommRingCat.of (X.residueField y))).ringCatSheaf)
    (ULift.{u} (Fin (n + 1)))
  have : F.IsQuasicoherent := Stacks.AlgebraicGeometry.AffineQcohEquivalence.isQuasicoherent_free _
  obtain ⟨θ, hθ, -⟩ := Stacks.ProjectiveBundleFibre.exists_iso_freeProjectiveBundle
    (X.residueField y) n
  let ψ := θ ≪≫ Stacks.RelativeProj.bundlePresentationIso F
  let bc := Stacks.RelativeProj.projectiveBundleBaseChange j E F hF
  have hψ : ψ.hom ≫ projectiveBundleToBase _ F = projToSpecCoeff (X.residueField y) n :=
    (Category.assoc _ _ _).trans ((congrArg (fun k => θ.hom ≫ k)
      (Stacks.RelativeProj.bundlePresentationIso_hom_comp_toBase F)).trans hθ)
  exact ⟨ψ.hom ≫ bc, (Stacks.RelativeProj.isPullback_projectiveBundleToBase_baseChange j E F
    hF).flip.of_iso ψ.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [bc]) (by simp [← hψ])
    (by simp) (by simp [j])⟩

open AlgebraicGeometry.Scheme.Modules in
/-- A finite locally free module is free of rank its fibre rank near each point. -/
private theorem exists_restrict_iso_free_fiberRank {X : Scheme.{u}} (E : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] (x : X) :
    ∃ (V : X.Opens) (_ : x ∈ V), Nonempty (E.restrict V.ι ≅
      SheafOfModules.free (R := V.toScheme.ringCatSheaf)
        (ULift.{u} (Fin (fiberRank E x)))) := by
  obtain ⟨V, hV, -, I, ⟨eI⟩, ⟨eV⟩⟩ :=
    exists_free_nbhd_of_mem_rankStratum E _ x ((mem_rankStratum E).2 rfl)
  have e1 := restrictIsoFreeOfOverIso E V I eV
  have hcard : fiberRank E x = Nat.card I :=
    @fiberRank_eq_card_of_trivialization _ E x V hV (trivializationOfRestrictIso E V I e1)
      (Finite.of_equiv _ eI.symm)
  have hrk : finiteLocallyFreeRank E x = fiberRank E x := by
    rw [hcard, Nat.card_congr eI, Nat.card_fin]
  exact ⟨V, hV, ⟨e1 ≪≫ SheafOfModules.freeFunctor.mapIso
    (eI.trans ((finCongr hrk).trans Equiv.ulift.symm)).toIso⟩⟩

section ProjSpaceFibre

attribute [local instance] MvPolynomial.gradedAlgebra

private theorem projIsoULiftIndex_inv_comp_toSpec (K : Type u) [Field K] (n : ℕ) :
    (Stacks.AlgebraicGeometry.ProjPoly.projIsoULiftIndex K n).inv ≫
      MMP.Intersection.ProjSpace.toSpec K (ULift.{u} (Fin (n + 1))) =
        Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff K n := by
  rw [Stacks.AlgebraicGeometry.ProjPoly.projIsoULiftIndex_inv]
  unfold MMP.Intersection.ProjSpace.toSpec Stacks.AlgebraicGeometry.ProjPolyChart.projToSpecCoeff
  rw [AlgebraicGeometry.Proj.map_toSpecZero_assoc, ← Spec.map_comp]
  congr 2
  refine CommRingCat.hom_ext (RingHom.ext fun r => ?_)
  apply Subtype.ext
  simp [Stacks.AlgebraicGeometry.ProjPoly.renameGradedHom]
  have h : (MvPolynomial.C r : MvPolynomial (Fin (n + 1)) K) ∈
      Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading K n 0 :=
    MvPolynomial.isHomogeneous_C _ r
  rw [DirectSum.decompose_of_mem_same _ h]

private theorem isEmpty_projSpace_zero (K : Type u) [Field K] :
    IsEmpty (MMP.Intersection.ProjSpace K (ULift.{u} (Fin 0))) := by
  refine ⟨fun x => ?_⟩
  let P : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (ULift.{u} (Fin 0)) K) := x
  apply P.not_irrelevant_le
  intro p hp
  rw [HomogeneousIdeal.mem_irrelevant_iff] at hp
  have hp0 : p ∈ MvPolynomial.homogeneousSubmodule (ULift.{u} (Fin 0)) K 0 := by
    rw [MvPolynomial.eq_C_of_isEmpty p]
    exact MvPolynomial.isHomogeneous_C _ _
  rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same _ hp0] at hp
  rw [hp]
  exact P.asHomogeneousIdeal.zero_mem

end ProjSpaceFibre

/-- **The fibre of a projective bundle of a finite locally free module over `z` is
`ℙ^{c-1}_{κ(z)}`**, `c` the fibre rank at `z`, compatibly with the structure maps to
`Spec κ(z)`. -/
private theorem exists_iso_fiber_projSpace {Z F : Scheme.{u}} (E : Z.Modules) [E.IsQuasicoherent]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
    (e0 : F ≅ projectiveBundle Z E) (f' : F ⟶ Z)
    (hf' : e0.hom ≫ projectiveBundleToBase Z E = f') (z : Z) :
    ∃ e : f'.fiber z ≅ MMP.Intersection.ProjSpace (Z.residueField z)
        (ULift.{u} (Fin (Scheme.Modules.fiberRank E z))),
      e.hom ≫ MMP.Intersection.ProjSpace.toSpec (Z.residueField z) _ =
        f'.fiberToSpecResidueField z := by
  obtain ⟨V, hV, ⟨eV⟩⟩ := exists_restrict_iso_free_fiberRank E z
  have hfib : IsPullback (f'.fiberι z) (f'.fiberToSpecResidueField z) f'
      (Z.fromSpecResidueField z) := IsPullback.of_hasPullback _ _
  generalize hn : Scheme.Modules.fiberRank E z = r at eV ⊢
  cases r with
  | zero =>
    let j : Spec (CommRingCat.of (Z.residueField z)) ⟶ Z := Z.fromSpecResidueField z
    have hj : Set.range j ⊆ V := by
      simpa [j, Z.range_fromSpecResidueField] using hV
    obtain ⟨hF⟩ := Stacks.ProjectiveBundleFibre.nonempty_iso_pullback_of_restrict_free E _ V eV j hj
    haveI : (SheafOfModules.free (R := (Spec (CommRingCat.of (Z.residueField z))).ringCatSheaf)
        (ULift.{u} (Fin 0))).IsQuasicoherent :=
      Stacks.AlgebraicGeometry.AffineQcohEquivalence.isQuasicoherent_free _
    haveI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        (SheafOfModules.free (R := (Spec (CommRingCat.of (Z.residueField z))).ringCatSheaf)
          (ULift.{u} (Fin 0))) 0 :=
      (AlgebraicGeometry.Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ 0).mp
        fun x => ⟨⊤, trivial, ⟨(AlgebraicGeometry.Scheme.Modules.restrictFreeIso
          (⊤ : (Spec (CommRingCat.of (Z.residueField z))).Opens).ι _).symm⟩⟩
    haveI hPE : IsEmpty (projectiveBundle (Spec (CommRingCat.of (Z.residueField z)))
        (SheafOfModules.free (R := (Spec (CommRingCat.of (Z.residueField z))).ringCatSheaf)
          (ULift.{u} (Fin 0)))) :=
      Stacks.ProjectiveBundleDeRham.isEmpty_projectiveBundle_of_rank_zero _
    have hsq := Stacks.RelativeProj.isPullback_projectiveBundleToBase_baseChange j E _ hF
    have hw : (f'.fiberι z ≫ e0.hom) ≫ projectiveBundleToBase Z E =
        f'.fiberToSpecResidueField z ≫ j := by
      rw [Category.assoc, hf']
      exact hfib.w
    haveI : IsEmpty (f'.fiber z) :=
      Function.isEmpty (hsq.flip.lift (f'.fiberι z ≫ e0.hom) (f'.fiberToSpecResidueField z) hw).base
    haveI := isEmpty_projSpace_zero (Z.residueField z)
    exact ⟨isInitialOfIsEmpty.uniqueUpToIso isInitialOfIsEmpty,
      (isInitialOfIsEmpty (X := f'.fiber z)).hom_ext _ _⟩
  | succ n =>
    obtain ⟨φ, hφ⟩ := exists_isPullback_projectiveBundle_of_restrict_free E n z V hV eV
    have h' : IsPullback (φ ≫ e0.inv) (projToSpecCoeff (Z.residueField z) n) f'
        (Z.fromSpecResidueField z) :=
      hφ.of_iso (Iso.refl _) e0.symm (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (e0.eq_inv_comp.mpr hf') (by simp)
    refine ⟨hfib.isoIsPullback _ _ h' ≪≫
      (Stacks.AlgebraicGeometry.ProjPoly.projIsoULiftIndex (Z.residueField z) n).symm, ?_⟩
    rw [Iso.trans_hom, Category.assoc, Iso.symm_hom, projIsoULiftIndex_inv_comp_toSpec,
      hfib.isoIsPullback_hom_snd]

end Fibre

open Stacks.AlgebraicGeometry.RegularIdealSheaf
  (isFiniteLocallyFree_conormalSheaf_of_isQuasiRegularImmersion) in
open Stacks.RelativeProj (projectiveBundle projectiveBundleToBase) in
/-- **Kollár, Notation 3.19 (relocated).** Let `π_{Z,X}` be a smooth blow-up with exceptional
divisor `F`. Then `B_Z X` and `F` are smooth over `k`; moreover `I_Z/I_Z²` is a locally free
`𝒪_Z`-module, `F ≅ Proj_Z Sym(I_Z/I_Z²)` over `Z` (Hartshorne's `ℙ(I_Z/I_Z²)`), and the fibre of
`F ⟶ Z` over `z ∈ Z` is `ℙ^{c-1}_{κ(z)}`, where `c` is the codimension of `Z` in `X` at `z`.

The centre is `Z = V(I)`; the codimension of `Z` in `X` at `z` is the height of `I_{Z,z}` in
`𝒪_{X,z}`, and the fibre is identified with `ℙ^{c-1}_{κ(z)}` as a `κ(z)`-scheme. -/
@[mmp "lem_kr3a_smooth_blowup_smooth"]
theorem smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) (I : X.IdealSheafData) (h : IsSmoothBlowup sX I) :
    Smooth (blowUpToBase I ≫ sX) ∧
      Smooth ((exceptionalIdeal I).subschemeι ≫ blowUpToBase I ≫ sX) ∧
      AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
        (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) ∧
      (∃ e : exceptionalDivisor I ≅
          projectiveBundle I.subscheme (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι),
        e.hom ≫ projectiveBundleToBase I.subscheme
            (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) =
          Scheme.IdealSheafData.subschemeMap (exceptionalIdeal I) I (blowUpToBase I)
            (I.le_map_comap (blowUpToBase I))) ∧
      ∀ z : I.subscheme, ∃ c : ℕ,
        (c : ℕ∞) = (RingHom.ker (I.subschemeι.stalkMap z).hom).height ∧
        ∃ e : (Scheme.IdealSheafData.subschemeMap (exceptionalIdeal I) I (blowUpToBase I)
              (I.le_map_comap (blowUpToBase I))).fiber z ≅
            MMP.Intersection.ProjSpace (I.subscheme.residueField z) (ULift.{u} (Fin c)),
          e.hom ≫ MMP.Intersection.ProjSpace.toSpec (I.subscheme.residueField z) _ =
            (Scheme.IdealSheafData.subschemeMap (exceptionalIdeal I) I (blowUpToBase I)
              (I.le_map_comap (blowUpToBase I))).fiberToSpecResidueField z := by
  have : Smooth sX := smooth_of_isSmoothScheme h.1
  have : Smooth (I.subschemeι ≫ sX) := smooth_of_isSmoothScheme h.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  obtain ⟨h1, h2, e, he, -⟩ :=
    Stacks.AlgebraicGeometry.smooth_exceptionalDivisor_isoProjectiveBundle_twistOne sX I
  have hlf1 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u}
