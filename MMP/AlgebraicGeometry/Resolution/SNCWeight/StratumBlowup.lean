module

public import MMP.AlgebraicGeometry.Singularities.MonomialValuationSnc
public import MMP.AlgebraicGeometry.Resolution.Blowup.SmoothCanonical
public import MMP.AlgebraicGeometry.Resolution.Surface.PointBlowupCurvePullback
public import MMP.AlgebraicGeometry.Intersection.CartierRestriction
public import MMP.AlgebraicGeometry.MMP.Steps
public import MMP.AlgebraicGeometry.Resolution.OneBlowupTotalTransform
public import StacksFrontier.AlgebraicGeometry.Morphisms.Unramified.ClosedImmersion

/-!
# Weighted orders, stratum blow-ups and their crepancy

Weighted orders on a regular local ring, the blow-up of a smooth variety along the intersection
of two components of an snc divisor, and the log crepancy of the resulting boundary.

* `WeightedOrder`: the root ring `R[Yᵢ]/(Yᵢ^{αᵢ} - zᵢ)` of a regular local ring and the
  weighted-order valuation, which computes the largest `m` with `f` in the weighted monomial
  ideal of weight `m`.
* `PrimeDivisorUnion`: unions of prime divisor supports, snc closed subsets and centres.
* `StratumBlowup`, `SNCBlowup`: prime divisors on the blow-up of a codimension-two snc stratum
  and the snc property of the new reduced boundary.
* `LocalEquation`: orders of local equations along prime divisors.
* `BlowupCrepancy`: the pulled-back boundary is log crepant, `K' + T' = σ^*(K + T)`.
-/

@[expose] public noncomputable section

universe uP

namespace MMP.Fourfold.SNCWeight

open IsLocalRing MvPolynomial
open scoped WithZero

namespace WeightedOrder

variable {R : Type*} [CommRing R] {ι : Type*}

set_option linter.unusedSectionVars false

/-- The relations `Y_i^{α_i} = z_i`. -/
abbrev rootRel (z : ι → R) (α : ι → ℕ) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun i => X i ^ α i - C (z i))

/-- The ring `R[Y_i]/(Y_i^{α_i} - z_i)` of roots. -/
abbrev RootRing (z : ι → R) (α : ι → ℕ) := MvPolynomial ι R ⧸ rootRel z α

variable (z : ι → R) (α : ι → ℕ)

/-- The root `y_i` of `z_i`. -/
abbrev rootGen (i : ι) : RootRing z α := Ideal.Quotient.mk _ (X i)

/-- In the root ring, `y_i ^ α_i = z_i`. -/
theorem rootGen_pow (i : ι) : rootGen z α i ^ α i = algebraMap R (RootRing z α) (z i) := by
  rw [← map_pow, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.eq]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- If `R` is a domain and every `α_i` is positive, `R` embeds in the root ring. -/
theorem rootRing_injective [IsDomain R] (hα : ∀ i, 0 < α i) :
    Function.Injective (algebraMap R (RootRing z α)) := by
  let L := AlgebraicClosure (FractionRing R)
  have hroot : ∀ i, ∃ ρ : L, ρ ^ α i = algebraMap R L (z i) := fun i =>
    IsAlgClosed.exists_pow_nat_eq _ (hα i)
  choose ρ hρ using hroot
  let ψ : MvPolynomial ι R →ₐ[R] L := aeval ρ
  have hle : rootRel z α ≤ RingHom.ker ψ := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    simp [ψ, hρ]
  let ψ' : RootRing z α →ₐ[R] L := Ideal.Quotient.liftₐ _ ψ fun a ha => hle ha
  have hL : Function.Injective (algebraMap R L) := by
    rw [IsScalarTower.algebraMap_eq R (FractionRing R) L]
    exact (algebraMap (FractionRing R) L).injective.comp (IsFractionRing.injective R _)
  intro a b h
  apply hL
  simpa only [ψ'.commutes] using congrArg ψ' h

/-- The root ring is generated as an `R`-algebra by the roots `y_i`. -/
theorem adjoin_rootGen : Algebra.adjoin R (Set.range (rootGen z α)) = ⊤ := by
  have := congrArg (Subalgebra.map (Ideal.Quotient.mkₐ R (rootRel z α)))
    (MvPolynomial.adjoin_range_X (R := R) (σ := ι))
  rwa [AlgHom.map_adjoin, Algebra.map_top, ← Set.range_comp,
    (AlgHom.range_eq_top _).mpr (Ideal.Quotient.mkₐ_surjective R _)] at this

/-- If every `α_i` is positive, the root ring is integral over `R`. -/
theorem isIntegral_rootRing (hα : ∀ i, 0 < α i) : Algebra.IsIntegral R (RootRing z α) := by
  have hy : ∀ i, IsIntegral R (rootGen z α i) := by
    intro i
    refine ⟨Polynomial.X ^ α i - Polynomial.C (z i), Polynomial.monic_X_pow_sub_C _ (hα i).ne', ?_⟩
    simp [rootGen_pow]
  have hle : Algebra.adjoin R (Set.range (rootGen z α)) ≤ integralClosure R (RootRing z α) :=
    Algebra.adjoin_le fun _ ⟨i, hi⟩ => hi ▸ hy i
  rw [adjoin_rootGen] at hle
  exact ⟨fun x => hle Algebra.mem_top⟩

/-- The ideal generated by the roots. -/
abbrev rootMax : Ideal (RootRing z α) := Ideal.span (Set.range (rootGen z α))

/-- The image of a polynomial `p` minus its constant coefficient lies in the ideal of the roots. -/
theorem mk_sub_algebraMap_mem_rootMax (p : MvPolynomial ι R) :
    Ideal.Quotient.mk (rootRel z α) p - algebraMap R (RootRing z α) (constantCoeff p) ∈
      rootMax z α := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [constantCoeff_C, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, sub_self]
    exact zero_mem _
  | add p q hp hq =>
    rw [map_add, map_add, map_add, add_sub_add_comm]
    exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- If every `α_i` is positive and the `z_i` generate the maximal ideal of `R`, every maximal ideal
of the root ring contains the roots. -/
theorem rootMax_le_of_isMaximal [IsLocalRing R] (hα : ∀ i, 0 < α i)
    (hz : Ideal.span (Set.range z) = maximalIdeal R) (𝔫 : Ideal (RootRing z α)) [𝔫.IsMaximal] :
    rootMax z α ≤ 𝔫 := by
  have := isIntegral_rootRing z α hα
  have hc : 𝔫.comap (algebraMap R (RootRing z α)) = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal 𝔫)
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨i, rfl⟩
  have hzi : z i ∈ 𝔫.comap (algebraMap R (RootRing z α)) := by
    rw [hc, ← hz]; exact Ideal.subset_span ⟨i, rfl⟩
  rw [Ideal.mem_comap, ← rootGen_pow] at hzi
  exact (Ideal.IsMaximal.isPrime ‹_›).mem_of_pow_mem _ hzi

/-- If every `α_i` is positive and the `z_i` generate the maximal ideal of `R`, the ideal of the
roots is the only maximal ideal of the root ring. -/
theorem eq_rootMax_of_isMaximal [IsLocalRing R] (hα : ∀ i, 0 < α i)
    (hz : Ideal.span (Set.range z) = maximalIdeal R) (𝔫 : Ideal (RootRing z α)) [𝔫.IsMaximal] :
    𝔫 = rootMax z α := by
  have := isIntegral_rootRing z α hα
  have hc : 𝔫.comap (algebraMap R (RootRing z α)) = maximalIdeal R :=
    IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_under_of_isIntegral_of_isMaximal 𝔫)
  refine le_antisymm (fun a ha => ?_) (rootMax_le_of_isMaximal z α hα hz 𝔫)
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  have h1 := mk_sub_algebraMap_mem_rootMax z α p
  have hr : constantCoeff p ∈ maximalIdeal R := by
    rw [← hc, Ideal.mem_comap]
    simpa using sub_mem ha (rootMax_le_of_isMaximal z α hα hz 𝔫 h1)
  have hr' : algebraMap R (RootRing z α) (constantCoeff p) ∈ rootMax z α := by
    rw [← hz] at hr
    have : (Ideal.span (Set.range z)).map (algebraMap R (RootRing z α)) ≤ rootMax z α := by
      rw [Ideal.map_span]
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      rw [← rootGen_pow]
      exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (Set.mem_range_self i)) _ (hα i)
    exact this (Ideal.mem_map_of_mem _ hr)
  simpa using add_mem h1 hr'

/-- If `R` is a local domain, every `α_i` is positive and the `z_i` generate the maximal ideal, the
root ring is local with maximal ideal generated by the roots. -/
theorem isLocalRing_rootRing [IsLocalRing R] [IsDomain R] (hα : ∀ i, 0 < α i)
    (hz : Ideal.span (Set.range z) = maximalIdeal R) :
    IsLocalRing (RootRing z α) ∧ ∀ _ : IsLocalRing (RootRing z α),
      maximalIdeal (RootRing z α) = rootMax z α := by
  have : Nontrivial (RootRing z α) :=
    (rootRing_injective z α hα).nontrivial
  obtain ⟨𝔫, h𝔫⟩ := Ideal.exists_maximal (RootRing z α)
  have he := eq_rootMax_of_isMaximal z α hα hz 𝔫
  have hmax : (rootMax z α).IsMaximal := he ▸ h𝔫
  refine ⟨IsLocalRing.of_unique_max_ideal ⟨rootMax z α, hmax, fun 𝔫' h𝔫' =>
    eq_rootMax_of_isMaximal z α hα hz 𝔫'⟩, fun _ => (IsLocalRing.eq_maximalIdeal hmax).symm⟩

open MMP.Fourfold in
/-- The image in the root ring of an element of `𝔞_m` lies in the `m`-th power of the ideal of
roots. -/
theorem map_mem_rootMax_pow [Fintype ι] {m : ℕ} {f : R} (hf : f ∈ weightedMonomialIdeal z α m) :
    algebraMap R (RootRing z α) f ∈ rootMax z α ^ m := by
  have : weightedMonomialIdeal z α m ≤ (rootMax z α ^ m).comap (algebraMap R (RootRing z α)) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨β, hβ, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap, map_prod]
    have h1 : ∏ i, algebraMap R (RootRing z α) (z i ^ β i) =
        ∏ i, rootGen z α i ^ (α i * β i) := by
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [map_pow, ← rootGen_pow, pow_mul]
    rw [h1]
    refine Ideal.pow_le_pow_right hβ ?_
    have hp : (∏ i, rootMax z α ^ (α i * β i)) = rootMax z α ^ ∑ i, α i * β i :=
      Finset.prod_pow_eq_pow_sum _ _ _
    rw [← hp]
    exact Ideal.prod_mem_prod fun i _ =>
      Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _
  exact this hf

open MMP.Fourfold in
/-- The product of an element of `𝔞_a` and an element of `𝔞_b` lies in `𝔞_(a + b)`. -/
theorem mul_mem_weightedMonomialIdeal [Fintype ι] {a b : ℕ} {f g : R}
    (hf : f ∈ weightedMonomialIdeal z α a) (hg : g ∈ weightedMonomialIdeal z α b) :
    f * g ∈ weightedMonomialIdeal z α (a + b) := by
  have : weightedMonomialIdeal z α a * weightedMonomialIdeal z α b ≤
      weightedMonomialIdeal z α (a + b) := by
    rw [weightedMonomialIdeal, weightedMonomialIdeal, Ideal.span_mul_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨_, ⟨β, hβ, rfl⟩, _, ⟨γ, hγ, rfl⟩, rfl⟩
    refine Ideal.subset_span ⟨β + γ, ?_, ?_⟩
    · simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]; omega
    · show _ * _ = _
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl fun i _ => by rw [Pi.add_apply, pow_add]
  exact this (Ideal.mul_mem_mul hf hg)

open MMP.Fourfold in
/-- An element of the maximal ideal times a monomial of weight `M` has weight `M + 1`. -/
theorem mul_monomial_mem_succ [Fintype ι] (hα : ∀ i, 0 < α i) {r : R}
    (hr : r ∈ Ideal.span (Set.range z)) (β : ι → ℕ) :
    r * ∏ i, z i ^ β i ∈ weightedMonomialIdeal z α (∑ i, α i * β i + 1) := by
  classical
  induction hr using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    refine Ideal.subset_span ⟨β + Pi.single j 1, ?_, ?_⟩
    · simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
      have : ∑ i, α i * (Pi.single j 1 : ι → ℕ) i = α j := by
        rw [Finset.sum_eq_single j (fun b _ hb => by simp [Pi.single_apply, hb]) (by simp)]
        simp
      have := hα j
      omega
    · have h1 : ∏ i, z i ^ ((β + Pi.single j 1 : ι → ℕ) i) =
          (∏ i, z i ^ β i) * ∏ i, z i ^ (Pi.single j 1 : ι → ℕ) i := by
        rw [← Finset.prod_mul_distrib]
        exact Finset.prod_congr rfl fun i _ => by rw [Pi.add_apply, pow_add]
      have h2 : ∏ i, z i ^ (Pi.single j 1 : ι → ℕ) i = z j := by
        rw [Fintype.prod_eq_single j (fun i hi => by rw [Pi.single_eq_of_ne hi, pow_zero])]
        simp
      rw [h1, h2, mul_comm]
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | smul a x _ hx => rw [smul_eq_mul, mul_assoc]; exact Ideal.mul_mem_left _ _ hx

open MMP.Fourfold in
/-- The weight-`M` part of an element of `𝔞_M`. -/
theorem exists_weight_decomposition [Fintype ι] (M : ℕ) {f : R}
    (hf : f ∈ weightedMonomialIdeal z α M) :
    ∃ c : (ι → ℕ) →₀ R, (∀ β ∈ c.support, ∑ i, α i * β i = M) ∧
      f - c.sum (fun β r => r * ∏ i, z i ^ β i) ∈ weightedMonomialIdeal z α (M + 1) := by
  classical
  induction hf using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨β, hβ, rfl⟩ := hx
    rcases hβ.eq_or_lt with h | h
    · refine ⟨Finsupp.single β 1, fun γ hγ => ?_, ?_⟩
      · rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hγ), h]
      · rw [Finsupp.sum_single_index (by simp), one_mul, sub_self]; exact zero_mem _
    · refine ⟨0, by simp, ?_⟩
      rw [Finsupp.sum_zero_index, sub_zero]
      exact Ideal.subset_span ⟨β, h, rfl⟩
  | zero => exact ⟨0, by simp, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨c, hc, hxc⟩ := hx
    obtain ⟨d, hd, hyd⟩ := hy
    refine ⟨c + d, fun β hβ => ?_, ?_⟩
    · rcases Finset.mem_union.mp (Finsupp.support_add hβ) with h | h
      exacts [hc β h, hd β h]
    · rw [Finsupp.sum_add_index (by simp) (by intros; ring)]
      convert add_mem hxc hyd using 1; ring
  | smul a x _ hx =>
    obtain ⟨c, hc, hxc⟩ := hx
    refine ⟨a • c, fun β hβ => hc β (Finsupp.support_smul hβ), ?_⟩
    rw [Finsupp.sum_smul_index (by simp)]
    have : a • x - c.sum (fun β r => a * r * ∏ i, z i ^ β i) =
        a * (x - c.sum (fun β r => r * ∏ i, z i ^ β i)) := by
      rw [smul_eq_mul, mul_sub, Finsupp.mul_sum]
      congr 1
      exact Finsupp.sum_congr fun β _ => by ring
    rw [this]
    exact Ideal.mul_mem_left _ _ hxc

/-- If `R` is a regular local ring of dimension `#ι` whose maximal ideal is generated by the `z_i`
and every `α_i` is positive, the root ring is a regular local ring of the same dimension, with
maximal ideal generated by the roots and lying over the maximal ideal of `R`. -/
theorem isRegularLocalRing_rootRing [Fintype ι] [IsLocalRing R] [IsDomain R] [IsNoetherianRing R]
    (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) :
    letI := (isLocalRing_rootRing z α hα hz).1
    IsRegularLocalRing (RootRing z α) ∧
      maximalIdeal (RootRing z α) = rootMax z α ∧
      (maximalIdeal (RootRing z α)).comap (algebraMap R (RootRing z α)) = maximalIdeal R ∧
      ringKrullDim (RootRing z α) = Fintype.card ι := by
  classical
  letI := (isLocalRing_rootRing z α hα hz).1
  have hmax := (isLocalRing_rootRing z α hα hz).2 this
  have := isIntegral_rootRing z α hα
  have hd : ringKrullDim (RootRing z α) = Fintype.card ι := by
    rw [← hdim]
    haveI : FaithfulSMul R (RootRing z α) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (rootRing_injective z α hα)
    exact (Algebra.IsIntegral.ringKrullDim_eq R (RootRing z α)).symm
  refine ⟨?_, hmax, IsLocalRing.eq_maximalIdeal
    (Ideal.isMaximal_under_of_isIntegral_of_isMaximal _), hd⟩
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [hd, hmax]
  have h := Submodule.spanFinrank_span_le_ncard_of_finite (R := RootRing z α)
    (Set.finite_range (rootGen z α))
  have h' : (Set.range (rootGen z α)).ncard ≤ Fintype.card ι := by
    rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
    exact Finset.card_image_le.trans (by simp)
  exact_mod_cast h.trans h'

/-- The roots `y_i`, listed along `Fintype.equivFin ι`. -/
abbrev rootList [Fintype ι] : List (RootRing z α) :=
  List.ofFn fun k : Fin (Fintype.card ι) => rootGen z α ((Fintype.equivFin ι).symm k)

/-- The roots form a quasiregular sequence generating the maximal ideal of the root ring. -/
theorem rootList_spec [Fintype ι] [IsLocalRing R] [IsDomain R] [IsNoetherianRing R]
    (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) :
    letI := (isLocalRing_rootRing z α hα hz).1
    Ideal.ofList (rootList z α) = maximalIdeal (RootRing z α) ∧
      Stacks.QuasiregularSequence.IsQuasiregularSeq (rootList z α) (RootRing z α) := by
  letI := (isLocalRing_rootRing z α hα hz).1
  obtain ⟨hreg, hmax, -, hd⟩ := isRegularLocalRing_rootRing z α hα hz hdim
  let e := Fintype.equivFin ι
  have hofList : Ideal.ofList (rootList z α) = maximalIdeal (RootRing z α) := by
    rw [hmax, Ideal.ofList]
    congr 1
    ext r
    simp only [rootList, List.mem_ofFn, Set.mem_ofPred_eq, Set.mem_range]
    exact ⟨fun ⟨k, hk⟩ => ⟨e.symm k, hk⟩, fun ⟨i, hi⟩ => ⟨e i, by simpa [e] using hi⟩⟩
  have hspan : (rootList z α).length = (maximalIdeal (RootRing z α)).spanFinrank := by
    have h1 := hreg.spanFinrank_maximalIdeal
    rw [hd] at h1
    rw [List.length_ofFn]
    exact_mod_cast h1.symm
  exact ⟨hofList, Stacks.QuasiregularSequence.isRegular_isQuasiregularSeq_self _
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      (RootRing z α)).1 _ hofList hspan).1⟩

open MMP.Fourfold in
/-- In a regular local ring with regular system of parameters `z`, an element of `𝔞_M` not in
`𝔞_(M + 1)` maps outside the `(M + 1)`-st power of the ideal of roots. -/
theorem map_notMem_rootMax_pow_succ [Fintype ι] [IsLocalRing R] [IsDomain R]
    [IsNoetherianRing R] (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) {M : ℕ} {f : R}
    (hf : f ∈ weightedMonomialIdeal z α M) (hf' : f ∉ weightedMonomialIdeal z α (M + 1)) :
    algebraMap R (RootRing z α) f ∉ rootMax z α ^ (M + 1) := by
  classical
  obtain ⟨c, hc, hrest⟩ := exists_weight_decomposition z α M hf
  obtain ⟨β0, hβ0s, hβ0⟩ : ∃ β ∈ c.support, c β ∉ maximalIdeal R := by
    by_contra hall
    push Not at hall
    apply hf'
    have : c.sum (fun β r => r * ∏ i, z i ^ β i) ∈ weightedMonomialIdeal z α (M + 1) :=
      Ideal.sum_mem _ fun β hβ => by
        have := mul_monomial_mem_succ z α hα (hz ▸ hall β hβ) β
        rwa [hc β hβ] at this
    have := add_mem hrest this
    simpa using this
  intro hmem
  letI := (isLocalRing_rootRing z α hα hz).1
  obtain ⟨-, hmax, hcomap, -⟩ := isRegularLocalRing_rootRing z α hα hz hdim
  set φ := algebraMap R (RootRing z α)
  have hS : φ (c.sum (fun β r => r * ∏ i, z i ^ β i)) ∈ rootMax z α ^ (M + 1) := by
    have := sub_mem hmem (map_mem_rootMax_pow z α hrest)
    rwa [map_sub, sub_sub_cancel] at this
  set s := Fintype.card ι
  let e := Fintype.equivFin ι
  set ys := rootList z α
  have hlen : ys.length = s := List.length_ofFn
  obtain ⟨hofList, hq⟩ := rootList_spec z α hα hz hdim
  let ix : Fin ys.length → ι := fun k => e.symm (Fin.cast hlen k)
  have hix : Function.Bijective ix :=
    e.symm.bijective.comp (finCongr hlen).bijective
  let Iβ : (ι → ℕ) → (Fin ys.length → ℕ) := fun β k => α (ix k) * β (ix k)
  have hIinj : Function.Injective Iβ := by
    intro β γ h
    funext i
    obtain ⟨k, rfl⟩ := hix.2 i
    have := congrFun h k
    exact Nat.eq_of_mul_eq_mul_left (hα _) this
  have hsumI : ∀ β : ι → ℕ, ∑ k, Iβ β k = ∑ i, α i * β i := fun β =>
    Function.Bijective.sum_comp hix (fun i => α i * β i)
  have hlist : ∀ β : ι → ℕ, Stacks.QuasiregularSequence.listPow ys (Iβ β) =
      φ (∏ i, z i ^ β i) := by
    intro β
    rw [Stacks.QuasiregularSequence.listPow, map_prod]
    have hys : ∀ k : Fin ys.length, ys[k] = rootGen z α (ix k) := fun k => by
      simp only [ys, rootList, ix]
      rw [Fin.getElem_fin, List.getElem_ofFn]
      rfl
    have : ∀ k : Fin ys.length, ys[k] ^ Iβ β k = (fun i => φ (z i ^ β i)) (ix k) := by
      intro k
      rw [hys]
      simp only [Iβ]
      rw [pow_mul, rootGen_pow, map_pow]
    rw [Finset.prod_congr rfl fun k _ => this k]
    exact hix.prod_comp (fun i => φ (z i ^ β i))
  let m : (Fin ys.length → ℕ) → RootRing z α := fun I =>
    ∑ β ∈ c.support, if Iβ β = I then φ (c β) else 0
  have hm : ∀ β ∈ c.support, m (Iβ β) = φ (c β) := by
    intro β hβ
    simp only [m]
    rw [Finset.sum_eq_single β (fun γ _ hγ => by rw [if_neg (fun h => hγ (hIinj h))])
      (fun h => absurd hβ h), if_pos rfl]
  have hrel : (∑ I ∈ Finset.Nat.antidiagonalTuple ys.length M,
      Stacks.QuasiregularSequence.listPow ys I • m I) ∈
        (Ideal.ofList ys ^ (M + 1)) • (⊤ : Submodule (RootRing z α) (RootRing z α)) := by
    rw [Ideal.smul_top_eq_self, hofList, hmax]
    convert hS using 1
    simp only [m, smul_eq_mul, Finset.mul_sum, mul_ite, mul_zero]
    rw [Finset.sum_comm]
    rw [Finsupp.sum, map_sum]
    refine Finset.sum_congr rfl fun β hβ => ?_
    rw [Finset.sum_ite_eq (Finset.Nat.antidiagonalTuple ys.length M) (Iβ β),
      if_pos (Finset.Nat.mem_antidiagonalTuple.mpr ((hsumI β).trans (hc β hβ))), hlist,
      map_mul, mul_comm]
  have := hq M m hrel (Iβ β0) (Finset.Nat.mem_antidiagonalTuple.mpr ((hsumI β0).trans (hc β0 hβ0s)))
  rw [Ideal.smul_top_eq_self, hofList, hm β0 hβ0s] at this
  apply hβ0
  rw [← hcomap]
  exact this

open MMP.Fourfold in
/-- In a regular local ring with regular system of parameters `z`, the parameter `z_i` does not lie
in `𝔞_(α_i + 1)`. -/
theorem notMem_weightedMonomialIdeal_succ [Fintype ι] [IsLocalRing R] [IsDomain R]
    [IsNoetherianRing R] (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) (i : ι) :
    z i ∉ weightedMonomialIdeal z α (α i + 1) := by
  classical
  intro hmem
  letI := (isLocalRing_rootRing z α hα hz).1
  obtain ⟨-, hmax, -, -⟩ := isRegularLocalRing_rootRing z α hα hz hdim
  have h1 := map_mem_rootMax_pow z α hmem
  rw [← rootGen_pow] at h1
  set s := Fintype.card ι
  let e := Fintype.equivFin ι
  set ys := rootList z α
  have hlen : ys.length = s := List.length_ofFn
  obtain ⟨hofList, hq⟩ := rootList_spec z α hα hz hdim
  let k0 : Fin ys.length := Fin.cast hlen.symm (e i)
  let I0 : Fin ys.length → ℕ := fun k => if k = k0 then α i else 0
  let m : (Fin ys.length → ℕ) → RootRing z α := fun I => if I = I0 then 1 else 0
  have hys : ys[k0] = rootGen z α i := by
    simp only [ys, rootList, k0]
    rw [Fin.getElem_fin, List.getElem_ofFn]
    congr 1
    simp [e]
  have hI0 : I0 ∈ Finset.Nat.antidiagonalTuple ys.length (α i) := by
    rw [Finset.Nat.mem_antidiagonalTuple]
    simp [I0]
  have hrel : (∑ I ∈ Finset.Nat.antidiagonalTuple ys.length (α i),
      Stacks.QuasiregularSequence.listPow ys I • m I) ∈
        (Ideal.ofList ys ^ (α i + 1)) • (⊤ : Submodule (RootRing z α) (RootRing z α)) := by
    rw [Ideal.smul_top_eq_self, hofList, hmax]
    convert h1 using 1
    simp only [m, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', if_pos hI0]
    rw [Stacks.QuasiregularSequence.listPow, Fintype.prod_eq_single k0 (fun k hk => by
      simp [I0, hk])]
    simp [I0, hys]
  have := hq (α i) m hrel I0 hI0
  rw [Ideal.smul_top_eq_self, hofList] at this
  simp only [m, if_pos rfl] at this
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr this)

open MMP.Fourfold in
/-- **The weighted order is a valuation.** In a regular local ring with a regular system of
parameters `z` and positive weights `α`, the weighted order `f ↦ max {m : f ∈ 𝔞_{α,m}}` is the
restriction of a valuation of the fraction field. -/
theorem exists_valuation_weightedOrder [Fintype ι] [IsLocalRing R] [IsDomain R]
    [IsNoetherianRing R] {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
    (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) :
    ∃ ν : Valuation K ℤᵐ⁰, ∀ f : R, f ≠ 0 → ∃ M : ℕ,
      IsGreatest {m : ℕ | f ∈ weightedMonomialIdeal z α m} M ∧
        ν (algebraMap R K f) = WithZero.exp (-(M : ℤ)) := by
  classical
  letI := (isLocalRing_rootRing z α hα hz).1
  obtain ⟨hreg, hmax, hcomap, hd⟩ := isRegularLocalRing_rootRing z α hα hz hdim
  set φ := algebraMap R (RootRing z α)
  have hinj : Function.Injective φ := rootRing_injective z α hα
  have hex : ∀ f : R, f ≠ 0 → ∃ n, f ∉ weightedMonomialIdeal z α (n + 1) := by
    intro f hf
    have hφ : φ f ≠ 0 := fun h => hf (hinj (h.trans (map_zero φ).symm))
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal (RootRing z α))
      (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    obtain ⟨N, hN⟩ : ∃ N, φ f ∉ maximalIdeal (RootRing z α) ^ N := by
      by_contra h
      push Not at h
      apply hφ
      rw [← Ideal.mem_bot, ← hK]
      exact Ideal.mem_iInf.mpr h
    refine ⟨N, fun hmem => hN ?_⟩
    have := map_mem_rootMax_pow z α hmem
    rw [← hmax] at this
    exact Ideal.pow_le_pow_right (Nat.le_succ N) this
  let μ : R → ℕ := fun f => if h : f = 0 then 0 else Nat.find (hex f h)
  have hμ1 : ∀ f, f ≠ 0 → f ∉ weightedMonomialIdeal z α (μ f + 1) := by
    intro f hf
    simp only [μ, dif_neg hf]
    exact Nat.find_spec (hex f hf)
  have hμ0 : ∀ f, f ≠ 0 → f ∈ weightedMonomialIdeal z α (μ f) := by
    intro f hf
    simp only [μ, dif_neg hf]
    rcases h : Nat.find (hex f hf) with _ | n
    · rw [weightedMonomialIdeal_zero]; exact Submodule.mem_top
    · have := Nat.find_min (hex f hf) (show n < Nat.find (hex f hf) by omega)
      push Not at this
      exact this
  have hgreat : ∀ f, f ≠ 0 → IsGreatest {m : ℕ | f ∈ weightedMonomialIdeal z α m} (μ f) := by
    intro f hf
    refine ⟨hμ0 f hf, fun m hm => ?_⟩
    by_contra hlt
    push Not at hlt
    exact hμ1 f hf (weightedMonomialIdeal_antitone z α hlt hm)
  have hmapmem : ∀ f, f ≠ 0 → φ f ∈ maximalIdeal (RootRing z α) ^ μ f := fun f hf => by
    rw [hmax]; exact map_mem_rootMax_pow z α (hμ0 f hf)
  have hmapnot : ∀ f, f ≠ 0 → φ f ∉ maximalIdeal (RootRing z α) ^ (μ f + 1) := fun f hf => by
    rw [hmax]; exact map_notMem_rootMax_pow_succ z α hα hz hdim (hμ0 f hf) (hμ1 f hf)
  have hμmul : ∀ f g, f ≠ 0 → g ≠ 0 → μ (f * g) = μ f + μ g := by
    intro f g hf hg
    have hfg : f * g ≠ 0 := mul_ne_zero hf hg
    refine le_antisymm ?_ ((hgreat _ hfg).2 (mul_mem_weightedMonomialIdeal z α (hμ0 f hf)
      (hμ0 g hg)))
    by_contra hlt
    push Not at hlt
    have h1 := weightedMonomialIdeal_antitone z α (Nat.succ_le_of_lt hlt) (hμ0 _ hfg)
    have h2 := map_mem_rootMax_pow z α h1
    rw [← hmax, map_mul] at h2
    exact MMP.Flips.mul_notMem_maximalIdeal_pow_add_succ (hmapmem f hf) (hmapnot f hf)
      (hmapmem g hg) (hmapnot g hg) h2
  have hμadd : ∀ f g, f + g ≠ 0 → f ≠ 0 → g ≠ 0 → min (μ f) (μ g) ≤ μ (f + g) := by
    intro f g hfg hf hg
    refine (hgreat _ hfg).2 (show f + g ∈ weightedMonomialIdeal z α _ from add_mem ?_ ?_)
    · exact weightedMonomialIdeal_antitone z α (min_le_left _ _) (hμ0 f hf)
    · exact weightedMonomialIdeal_antitone z α (min_le_right _ _) (hμ0 g hg)
  have hμone : μ 1 = 0 := by
    by_contra h
    have h1 := weightedMonomialIdeal_antitone z α (Nat.one_le_iff_ne_zero.mpr h)
      (hμ0 1 one_ne_zero)
    have h2 := map_mem_rootMax_pow z α h1
    rw [map_one, ← hmax] at h2
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      ((Ideal.eq_top_iff_one _).mpr (Ideal.pow_le_self one_ne_zero h2))
  let v : Valuation R ℤᵐ⁰ :=
    { toFun := fun f => if f = 0 then 0 else WithZero.exp (-(μ f : ℤ))
      map_zero' := by simp
      map_one' := by simp [hμone]
      map_mul' := by
        intro f g
        by_cases hf : f = 0
        · simp [hf]
        by_cases hg : g = 0
        · simp [hg]
        simp only [mul_eq_zero, hf, hg, or_self, if_false, hμmul f g hf hg]
        rw [← WithZero.exp_add]
        congr 1
        push_cast; ring
      map_add_le_max' := by
        intro f g
        by_cases hfg : f + g = 0
        · simp [hfg]
        by_cases hf : f = 0
        · simp [hf]
        by_cases hg : g = 0
        · simp [hg]
        simp only [hfg, hf, hg, if_false]
        rw [le_max_iff]
        rcases le_total (μ f) (μ g) with h | h
        · left
          rw [WithZero.exp_le_exp, neg_le_neg_iff, Nat.cast_le]
          have := hμadd f g hfg hf hg
          rwa [min_eq_left h] at this
        · right
          rw [WithZero.exp_le_exp, neg_le_neg_iff, Nat.cast_le]
          have := hμadd f g hfg hf hg
          rwa [min_eq_right h] at this }
  have hS : nonZeroDivisors R ≤ v.supp.primeCompl := by
    intro s hs
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    change s ∉ v.supp
    rw [Valuation.mem_supp_iff]
    change ¬ (if s = 0 then 0 else WithZero.exp (-(μ s : ℤ))) = 0
    simp [hs0]
  refine ⟨v.extendToLocalization hS K, fun f hf => ⟨μ f, hgreat f hf, ?_⟩⟩
  rw [Valuation.extendToLocalization_apply_map_apply]
  change (if f = 0 then 0 else WithZero.exp (-(μ f : ℤ))) = _
  simp [hf]

open MMP.Fourfold in
/-- The parameter `z_i` lies in `𝔞_(α_i)`. -/
theorem mem_weightedMonomialIdeal_self [Fintype ι] (i : ι) :
    z i ∈ weightedMonomialIdeal z α (α i) := by
  classical
  refine Ideal.subset_span ⟨Pi.single i 1, ?_, ?_⟩
  · rw [Fintype.sum_eq_single i (fun j hj => by simp [Pi.single_eq_of_ne hj])]; simp
  · rw [Fintype.prod_eq_single i (fun j hj => by simp [Pi.single_eq_of_ne hj])]; simp

open MMP.Fourfold in
/-- The weighted order valuation, with its values on the parameters and its centre. -/
theorem exists_valuation_weightedOrder' [Fintype ι] [IsLocalRing R] [IsDomain R]
    [IsNoetherianRing R] {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
    (hα : ∀ i, 0 < α i) (hz : Ideal.span (Set.range z) = maximalIdeal R)
    (hdim : ringKrullDim R = Fintype.card ι) :
    ∃ ν : Valuation K ℤᵐ⁰, (∀ f : R, f ≠ 0 → ∃ M : ℕ,
      IsGreatest {m : ℕ | f ∈ weightedMonomialIdeal z α m} M ∧
        ν (algebraMap R K f) = WithZero.exp (-(M : ℤ))) ∧
      (∀ i, ν (algebraMap R K (z i)) = WithZero.exp (-(α i : ℤ))) ∧
      (∀ f : R, ν (algebraMap R K f) ≤ 1) ∧
      (∀ f ∈ maximalIdeal R, ν (algebraMap R K f) < 1) := by
  obtain ⟨ν, hν⟩ := exists_valuation_weightedOrder z α (K := K) hα hz hdim
  refine ⟨ν, hν, fun i => ?_, fun f => ?_, fun f hf => ?_⟩
  · have hnot := notMem_weightedMonomialIdeal_succ z α hα hz hdim i
    have hz0 : z i ≠ 0 := fun h => hnot (h ▸ zero_mem _)
    obtain ⟨M, hM, hνM⟩ := hν _ hz0
    have hle : α i ≤ M := hM.2 (mem_weightedMonomialIdeal_self z α i)
    have hge : M ≤ α i := by
      by_contra h
      push Not at h
      exact hnot (weightedMonomialIdeal_antitone z α (Nat.succ_le_of_lt h) hM.1)
    rw [hνM, le_antisymm hge hle]
  · by_cases hf0 : f = 0
    · simp [hf0]
    · obtain ⟨M, -, hνM⟩ := hν f hf0
      rw [hνM, ← WithZero.exp_zero, WithZero.exp_le_exp]
      simp
  · by_cases hf0 : f = 0
    · simp [hf0]
    · obtain ⟨M, hM, hνM⟩ := hν f hf0
      have h1 : f ∈ weightedMonomialIdeal z α 1 := by
        have : Ideal.span (Set.range z) ≤ weightedMonomialIdeal z α 1 := by
          refine Ideal.span_le.mpr ?_
          rintro _ ⟨i, rfl⟩
          exact weightedMonomialIdeal_antitone z α (hα i) (mem_weightedMonomialIdeal_self z α i)
        exact this (hz ▸ hf)
      have hM1 : 1 ≤ M := hM.2 h1
      rw [hνM, ← WithZero.exp_zero, WithZero.exp_lt_exp]
      omega

end WeightedOrder

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace PrimeDivisorUnion

open MMP.Mori MMP.Resolution

variable {Y : Scheme.{uP}}

/-- An irreducible set inside a finite union of closed sets lies in one of them. -/
theorem exists_subset_of_isIrreducible {X : Type*} [TopologicalSpace X] {ι : Type*}
    {s : Finset ι} {A : ι → Set X} (hA : ∀ i ∈ s, IsClosed (A i)) {W : Set X} (hW : IsIrreducible W)
    (hWs : W ⊆ ⋃ i ∈ s, A i) : ∃ i ∈ s, W ⊆ A i := by
  classical
  have := (isIrreducible_iff_sUnion_isClosed.mp hW) ((s.image A))
    (by intro t ht; obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ht; exact hA i hi)
    (by intro x hx; obtain ⟨i, hi, hx⟩ := Set.mem_iUnion₂.mp (hWs hx)
        exact Set.mem_sUnion.mpr ⟨A i, Finset.mem_coe.mpr (Finset.mem_image_of_mem A hi), hx⟩)
  obtain ⟨t, ht, hWt⟩ := this
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ht
  exact ⟨i, hi, hWt⟩

/-- The support of a prime divisor is irreducible. -/
theorem isIrreducible_support (F : MMP.Mori.PrimeDivisor Y) :
    IsIrreducible (F.support : Set Y) := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact isIrreducible_singleton.closure

/-- The support of a prime divisor is closed. -/
theorem isClosed_support (F : MMP.Mori.PrimeDivisor Y) : IsClosed (F.support : Set Y) :=
  F.idealSheaf.support.isClosed

/-- Prime divisors with nested supports coincide. -/
theorem eq_of_support_subset {F G : MMP.Mori.PrimeDivisor Y}
    (h : (F.support : Set Y) ⊆ G.support) : F = G := by
  by_contra hne
  apply MMP.Threefold.Resolution.genericPoint_notMem_support_of_ne hne
  apply h
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact subset_closure rfl

/-- The irreducible components of a finite union of supports of prime divisors are those
supports. -/
theorem componentsOf_iUnion_support (Ps : Finset (MMP.Mori.PrimeDivisor Y)) :
    componentsOf (⋃ F ∈ Ps, (F.support : Set Y)) =
      (fun F : MMP.Mori.PrimeDivisor Y => (F.support : Set Y)) '' Ps := by
  ext W
  constructor
  · intro hW
    obtain ⟨G, hG, hWG⟩ := exists_subset_of_isIrreducible (s := Ps)
      (fun F _ => isClosed_support F) hW.1.1 hW.1.2
    exact ⟨G, hG, (hW.2 ⟨isIrreducible_support G, Set.subset_biUnion_of_mem
      (u := fun F : MMP.Mori.PrimeDivisor Y => (F.support : Set Y)) hG⟩ hWG).antisymm hWG⟩
  · rintro ⟨F, hF, rfl⟩
    refine ⟨⟨isIrreducible_support F, Set.subset_biUnion_of_mem
      (u := fun F : MMP.Mori.PrimeDivisor Y => (F.support : Set Y)) hF⟩, fun W hW hFW => ?_⟩
    obtain ⟨G, hG, hWG⟩ := exists_subset_of_isIrreducible (s := Ps)
      (fun F _ => isClosed_support F) hW.1 hW.2
    obtain rfl := eq_of_support_subset (hFW.trans hWG)
    exact hWG

/-- Every irreducible component of a finite union of prime-divisor supports is the support of one
of the divisors. -/
theorem exists_prime_of_mem_componentsOf {Ps : Finset (MMP.Mori.PrimeDivisor Y)} {W : Set Y}
    (hW : W ∈ componentsOf (⋃ F ∈ Ps, (F.support : Set Y))) :
    ∃ F ∈ Ps, W = F.support := by
  rw [componentsOf_iUnion_support] at hW
  obtain ⟨F, hF, rfl⟩ := hW
  exact ⟨F, hF, rfl⟩

/-- The ideal sheaf attached to a component of `D` equal to the support of a prime divisor `F` is
the ideal sheaf of `F`. -/
theorem componentsFamily_eq_idealSheaf {D : Set Y} (W : componentsOf D)
    (F : MMP.Mori.PrimeDivisor Y) (hW : W.1 = F.support) :
    componentsFamily D W = F.idealSheaf := by
  rw [componentsFamily]
  have : Closeds.closure (W : Set Y) = F.idealSheaf.support := by
    apply Closeds.ext
    rw [Closeds.coe_closure, hW]
    exact (isClosed_support F).closure_eq
  rw [this, MMP.Intersection.vanishingIdeal_support_idealSheaf]

/-- An irreducible closed subset equal to the support of a prime divisor has codimension one. -/
theorem codimension_eq_one_of_eq_support (W : IrreducibleCloseds Y) (F : MMP.Mori.PrimeDivisor Y)
    (hW : (W : Set Y) = F.support) : codimension W = 1 := by
  have : W = IrreducibleCloseds.closureSingleton F.genericPoint := by
    ext1
    rw [hW]
    exact AlgebraicGeometry.PrimeDivisor.support_eq_closure F
  rw [this, Stacks.Divisors.PrimeDivisor.codimension_closureSingleton]
  exact MMP.Mori.PrimeDivisor.coheight_genericPoint F

/-- The support of a prime divisor is of pure codimension one. -/
theorem isPureCodimOne_support (F : MMP.Mori.PrimeDivisor Y) :
    MMP.Mori.IsPureCodimOne F.idealSheaf.support := by
  intro W hW
  refine codimension_eq_one_of_eq_support W F (le_antisymm hW.1 ?_)
  exact hW.2 (y := ⟨F.support, isIrreducible_support F, isClosed_support F⟩) le_rfl hW.1

/-- A closed finite union of supports of prime divisors is of pure codimension one. -/
theorem isPureCodimOne_iUnion (Ps : Finset (MMP.Mori.PrimeDivisor Y))
    (hD : IsClosed (⋃ F ∈ Ps, (F.support : Set Y))) :
    MMP.Mori.IsPureCodimOne (⟨_, hD⟩ : Closeds Y) := by
  intro W hW
  have hWc : (W : Set Y) ∈ componentsOf (⋃ F ∈ Ps, (F.support : Set Y)) := by
    refine ⟨⟨W.isIrreducible, hW.1⟩, fun V hV hWV => ?_⟩
    have := hW.2 (y := ⟨closure V, hV.1.closure, isClosed_closure⟩)
      (closure_minimal hV.2 hD) (hWV.trans subset_closure)
    exact subset_closure.trans this
  obtain ⟨F, -, hF⟩ := exists_prime_of_mem_componentsOf hWc
  exact codimension_eq_one_of_eq_support W F hF

/-- A finite union of supports of prime divisors is closed. -/
theorem isClosed_iUnion_support (Ps : Finset (MMP.Mori.PrimeDivisor Y)) :
    IsClosed (⋃ F ∈ Ps, (F.support : Set Y)) :=
  isClosed_biUnion_finset fun F _ => isClosed_support F

/-- **An snc divisor is an snc closed subset.** -/
theorem isSNCClosedSubset_of_isSNC {k : Type uP} [Field k] (sY : Y ⟶ Spec (.of k))
    {T : Divisor Y} (hT : T.IsSNC sY) :
    IsSNCClosedSubset sY (⋃ F ∈ T.support, (F.support : Set Y)) := by
  classical
  refine ⟨isClosed_iUnion_support _, Or.inr ⟨isPureCodimOne_iUnion _ _, ?_, ?_, ?_⟩⟩
  · rw [componentsOf_iUnion_support]
    exact (T.support.finite_toSet.image _)
  · intro W
    obtain ⟨F, hF, hWF⟩ := exists_prime_of_mem_componentsOf W.2
    rw [componentsFamily_eq_idealSheaf W F hWF]
    have := F.integral
    exact ⟨inferInstance, isPureCodimOne_support F, hT.1 F hF⟩
  · intro x
    obtain ⟨n, z, j, hz, hj, hI⟩ := hT.2 x
    choose F hF hWF using fun W : componentsOf (⋃ F ∈ T.support, (F.support : Set Y)) =>
      exists_prime_of_mem_componentsOf W.2
    have hmem : ∀ W : {W : componentsOf (⋃ F ∈ T.support, (F.support : Set Y)) //
        x ∈ (componentsFamily _ W).support}, x ∈ (F W.1).support := by
      intro W
      have := W.2
      rwa [componentsFamily_eq_idealSheaf W.1 (F W.1) (hWF W.1)] at this
    refine ⟨n, z, fun W => j ⟨F W.1, hF W.1, hmem W⟩, hz, fun W => ?_, ?_⟩
    · rw [componentsFamily_eq_idealSheaf W.1 (F W.1) (hWF W.1)]
      exact hI ⟨F W.1, hF W.1, hmem W⟩
    · intro W W' h
      have h1 := congrArg (fun E => E.1) (hj h)
      simp only at h1
      apply Subtype.ext; apply Subtype.ext
      rw [hWF W.1, hWF W'.1, h1]

/-- **An snc closed subset which is a union of prime divisors gives an snc divisor.** -/
theorem isSNC_reducedDivisorOf_of_isSNCClosedSubset {k : Type uP} [Field k]
    (sY : Y ⟶ Spec (.of k)) [IsLocallyNoetherian Y]
    (hreg : ∀ y : Y, ∃ (n : ℕ) (z : Fin n → Y.presheaf.stalk y), IsRegularSystemOfParameters z)
    (Ps : Finset (MMP.Mori.PrimeDivisor Y))
    (h : IsSNCClosedSubset sY (⋃ F ∈ Ps, (F.support : Set Y))) :
    (MMP.Intersection.reducedDivisorOf Ps).IsSNC sY := by
  classical
  unfold DivisorWithCoeffs.IsSNC
  rw [MMP.Intersection.support_reducedDivisorOf]
  obtain ⟨hcl, hD⟩ := h
  rcases hD with hD | ⟨-, -, hfam1, hfam2⟩
  · have hP : Ps = ∅ := by
      by_contra hne
      obtain ⟨F, hF⟩ := Finset.nonempty_iff_ne_empty.mpr hne
      have : (F.support : Set Y) ⊆ ∅ := hD ▸ Set.subset_biUnion_of_mem
        (u := fun F : MMP.Mori.PrimeDivisor Y => (F.support : Set Y)) hF
      have hne' : (F.support : Set Y).Nonempty := ⟨F.genericPoint, by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
      exact hne'.ne_empty (Set.subset_empty_iff.mp this)
    subst hP
    refine ⟨fun E hE => absurd hE (Finset.notMem_empty _), fun x => ?_⟩
    obtain ⟨n, z, hz⟩ := hreg x
    exact ⟨n, z, fun E => absurd E.2.1 (Finset.notMem_empty _), hz,
      fun E => absurd E.2.1 (Finset.notMem_empty _), fun E => absurd E.2.1 (Finset.notMem_empty _)⟩
  · have hcomp : ∀ F ∈ Ps, (F.support : Set Y) ∈ componentsOf (⋃ F ∈ Ps, (F.support : Set Y)) :=
      fun F hF => by rw [componentsOf_iUnion_support]; exact ⟨F, hF, rfl⟩
    refine ⟨fun E hE => ?_, fun x => ?_⟩
    · have := (hfam1 ⟨_, hcomp E hE⟩).2.2
      rwa [componentsFamily_eq_idealSheaf ⟨_, hcomp E hE⟩ E rfl] at this
    · obtain ⟨n, z, c, hz, hI, hc⟩ := hfam2 x
      have hmem : ∀ E : {E : MMP.Mori.PrimeDivisor Y // E ∈ Ps ∧ x ∈ E.support},
          x ∈ (componentsFamily (⋃ F ∈ Ps, (F.support : Set Y))
            ⟨_, hcomp E.1 E.2.1⟩).support := fun E => by
        rw [componentsFamily_eq_idealSheaf ⟨_, hcomp E.1 E.2.1⟩ E.1 rfl]; exact E.2.2
      refine ⟨n, z, fun E => c ⟨⟨_, hcomp E.1 E.2.1⟩, hmem E⟩, hz, ?_, fun E => ?_⟩
      · intro E E' hEE'
        have h1 := congrArg (fun W => W.1.1) (hc hEE')
        simp only at h1
        exact Subtype.ext (eq_of_support_subset h1.le)
      · have := hI ⟨⟨_, hcomp E.1 E.2.1⟩, hmem E⟩
        rwa [componentsFamily_eq_idealSheaf ⟨_, hcomp E.1 E.2.1⟩ E.1 rfl] at this

/-- A closed subscheme whose local quotient rings are regular is smooth over a perfect field. -/
theorem isSmoothScheme_subscheme_of_isRegularLocalRing_quotient {k : Type uP} [Field k]
    [PerfectField k] (sY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType sY] (D : Y.IdealSheafData)
    (hD : ∀ y ∈ D.support,
      IsRegularLocalRing (Y.presheaf.stalk y ⧸ IdealSheafData.stalk D y)) :
    IsSmoothScheme (D.subschemeι ≫ sY) := by
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : LocallyOfFinitePresentation (D.subschemeι ≫ sY) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := D.subschemeι ≫ sY)).mpr
      inferInstance
  rw [isSmoothScheme_iff, MMP.Flips.ResolutionInputs.smooth_iff_forall_isRegularLocalRing_stalk]
  intro z
  apply isRegularLocalRing_stalk_subscheme_of_isRegularLocalRing_quotient
  apply hD
  rw [← SetLike.mem_coe, ← D.range_subschemeι]; exact ⟨z, rfl⟩

/-- At a point of `F ∩ F'`, an snc divisor gives two members of a regular system of parameters
cutting out `F` and `F'`. -/
theorem exists_params_of_isSNC {k : Type uP} [Field k] {sY : Y ⟶ Spec (.of k)} {T : Divisor Y}
    (hT : T.IsSNC sY) {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support)
    (hF' : F' ∈ T.support) (hFF : F ≠ F') {y : Y} (hy : y ∈ F.support) (hy' : y ∈ F'.support) :
    ∃ (n : ℕ) (z : Fin n → Y.presheaf.stalk y) (a b : Fin n), IsRegularSystemOfParameters z ∧
      a ≠ b ∧ IdealSheafData.stalk F.idealSheaf y = Ideal.span {z a} ∧
      IdealSheafData.stalk F'.idealSheaf y = Ideal.span {z b} := by
  obtain ⟨n, z, j, hz, hj, hI⟩ := hT.2 y
  let e : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ y ∈ E.support} := ⟨F, hF, hy⟩
  let e' : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ y ∈ E.support} := ⟨F', hF', hy'⟩
  have hne : j e ≠ j e' := fun h => hFF (congrArg Subtype.val (hj h))
  exact ⟨n, z, j e, j e', hz, hne, hI e, hI e'⟩

/-- The sum of the principal ideals of `z a` and `z b` is the ideal generated by `z '' {a, b}`. -/
theorem span_pair_eq_span_image {A : Type*} [CommRing A] {n : ℕ} (z : Fin n → A) (a b : Fin n) :
    Ideal.span {z a} ⊔ Ideal.span {z b} =
      Ideal.span (z '' (({a, b} : Finset (Fin n)) : Set _)) := by
  classical
  rw [Finset.coe_insert, Finset.coe_singleton, Set.image_insert_eq, Set.image_singleton,
    Ideal.span_insert]

/-- The local rings of the scheme-theoretic intersection of two components of an snc divisor
are regular. -/
theorem isRegularLocalRing_quotient_inter {k : Type uP} [Field k] {sY : Y ⟶ Spec (.of k)}
    [IsLocallyNoetherian Y] {T : Divisor Y}
    (hT : T.IsSNC sY) {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support)
    (hF' : F' ∈ T.support) (hFF : F ≠ F') {y : Y}
    (hy : y ∈ (F.idealSheaf ⊔ F'.idealSheaf).support) :
    IsRegularLocalRing (Y.presheaf.stalk y ⧸
      IdealSheafData.stalk (F.idealSheaf ⊔ F'.idealSheaf) y) := by
  rw [Scheme.IdealSheafData.support_sup] at hy
  obtain ⟨n, z, a, b, hz, -, ha, hb⟩ := exists_params_of_isSNC hT hF hF' hFF hy.1 hy.2
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  rw [IdealSheafData.stalk_sup, ha, hb, span_pair_eq_span_image]
  exact MMP.Resolution.isRegularLocalRing_quotient_span_image z hz _

/-- **The centre of a step.** For two components `F ≠ F'` of an snc divisor on a smooth
Noetherian scheme and a preconnected nonempty set `S ⊆ F ∩ F'`, the irreducible component `C` of
`F ∩ F'` containing `S`, with its reduced structure, is a smooth irreducible centre with local
equations those of `F` and `F'`. -/
theorem exists_centre {k : Type uP} [Field k] [PerfectField k] (sY : Y ⟶ Spec (.of k))
    [LocallyOfFiniteType sY] [QuasiCompact sY] {T : Divisor Y} (hT : T.IsSNC sY)
    {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support) (hF' : F' ∈ T.support) (hFF : F ≠ F')
    {S : Set Y} (hS : _root_.IsPreconnected S) (hSne : S.Nonempty) (hSF : S ⊆ F.support)
    (hSF' : S ⊆ F'.support) :
    ∃ I : Y.IdealSheafData, IsIrreducible (I.support : Set Y) ∧
      IsSmoothScheme (I.subschemeι ≫ sY) ∧ S ⊆ I.support ∧
      (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support ∧
      (∀ y ∈ I.support, IdealSheafData.stalk I y =
        IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y) ∧
      (_root_.IsPreconnected ((F.support : Set Y) ∩ F'.support) →
        (I.support : Set Y) = (F.support : Set Y) ∩ F'.support) ∧
      I = Scheme.IdealSheafData.vanishingIdeal I.support := by
  classical
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  have : IsNoetherian Y := {}
  set D := F.idealSheaf ⊔ F'.idealSheaf with hDdef
  have hDsupp : (D.support : Set Y) = (F.support : Set Y) ∩ F'.support := by
    rw [hDdef, Scheme.IdealSheafData.support_sup]; rfl
  have hDreg : ∀ y ∈ D.support,
      IsRegularLocalRing (Y.presheaf.stalk y ⧸ IdealSheafData.stalk D y) :=
    fun y hy => isRegularLocalRing_quotient_inter hT hF hF' hFF hy
  have hDsm : IsSmoothScheme (D.subschemeι ≫ sY) :=
    isSmoothScheme_subscheme_of_isRegularLocalRing_quotient sY D hDreg
  have hDred : IsReduced D.subscheme := by
    have : LocallyOfFinitePresentation (D.subschemeι ≫ sY) :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := D.subschemeι ≫ sY)).mpr
        inferInstance
    have hsm : Smooth (D.subschemeι ≫ sY) := (MMP.Mori.isSmoothScheme_iff _).1 hDsm
    haveI : ∀ x : D.subscheme, _root_.IsReduced (D.subscheme.presheaf.stalk x) := fun x => by
      have := isRegularLocalRing_stalk_of_smooth_over_field (D.subschemeι ≫ sY) x
      have := IsRegularLocalRing.isDomain (D.subscheme.presheaf.stalk x)
      exact isReduced_of_noZeroDivisors
    exact isReduced_of_isReduced_stalk _
  obtain ⟨s0, hs0⟩ := hSne
  have hs0D : s0 ∈ (D.support : Set Y) := by rw [hDsupp]; exact ⟨hSF hs0, hSF' hs0⟩
  have hDcl : IsClosed (D.support : Set Y) := D.support.isClosed
  obtain ⟨hfin, hcov⟩ := MMP.Resolution.Aux.finite_and_cover_componentsOf hDcl
  obtain ⟨C, hC, hs0C⟩ := hcov hs0D
  have hCcl : IsClosed C := MMP.Resolution.Aux.isClosed_of_mem_componentsOf hDcl hC
  set B := ⋃₀ (componentsOf (D.support : Set Y) \ {C}) with hB
  have hBcl : IsClosed B := (hfin.subset Set.sdiff_subset).isClosed_sUnion
    fun W hW => MMP.Resolution.Aux.isClosed_of_mem_componentsOf hDcl hW.1
  have hdisj : ∀ y ∈ C, y ∉ B := by
    rintro y hyC ⟨W, ⟨hW, hWC⟩, hyW⟩
    exact hWC (MMP.Resolution.Aux.eq_of_mem_componentsOf_of_isSmoothScheme sY D hDsm hW hC
      hyW hyC)
  have hCB : C ∪ B = D.support := by
    refine le_antisymm (Set.union_subset hC.1.2 ?_) fun y hy => ?_
    · rintro y ⟨W, ⟨hW, -⟩, hyW⟩; exact hW.1.2 hyW
    · obtain ⟨W, hW, hyW⟩ := hcov hy
      by_cases h : W = C
      · exact Or.inl (h ▸ hyW)
      · exact Or.inr ⟨W, ⟨hW, h⟩, hyW⟩
  have hSC : S ⊆ C := by
    have hSD : S ⊆ C ∪ B := by
      rw [hCB, hDsupp]; exact fun x hx => ⟨hSF hx, hSF' hx⟩
    rcases (isPreconnected_iff_subset_of_disjoint_closed.mp hS) C B hCcl hBcl hSD
      (Set.eq_empty_iff_forall_notMem.mpr fun x hx => hdisj x hx.2.1 hx.2.2) with h | h
    · exact h
    · exact absurd (h hs0) (hdisj s0 hs0C)
  set I := Scheme.IdealSheafData.vanishingIdeal (⟨C, hCcl⟩ : Closeds Y) with hIdef
  have hIsupp : (I.support : Set Y) = C := by
    rw [hIdef, Scheme.IdealSheafData.coe_support_vanishingIdeal]; rfl
  have hstalk : ∀ y ∈ I.support, IdealSheafData.stalk I y = IdealSheafData.stalk D y := by
    intro y hy
    rw [← SetLike.mem_coe, hIsupp] at hy
    exact MMP.Mori.stalk_vanishingIdeal_eq_stalk_of_sup_eq D ⟨C, hCcl⟩ ⟨B, hBcl⟩
      (Closeds.ext hCB) (hdisj y hy)
  refine ⟨I, hIsupp ▸ hC.1.1, ?_, hIsupp ▸ hSC, ?_, fun y hy => ?_, fun hpc => ?_, ?_⟩
  · refine isSmoothScheme_subscheme_of_isRegularLocalRing_quotient sY I fun y hy => ?_
    rw [hstalk y hy]
    refine hDreg y ?_
    rw [← SetLike.mem_coe, ← hCB]; rw [← SetLike.mem_coe, hIsupp] at hy; exact Or.inl hy
  · rw [hIsupp, ← hDsupp]; exact hC.1.2
  · rw [hstalk y hy, hDdef, IdealSheafData.stalk_sup]
  · rw [hIsupp]
    refine le_antisymm (hDsupp ▸ hC.1.2) ?_
    have hsub : (F.support : Set Y) ∩ F'.support ⊆ C ∪ B := by rw [hCB, hDsupp]
    rcases (isPreconnected_iff_subset_of_disjoint_closed.mp hpc) C B hCcl hBcl hsub
      (Set.eq_empty_iff_forall_notMem.mpr fun x hx => hdisj x hx.2.1 hx.2.2) with h | h
    · exact h
    · exact absurd (h ⟨hSF hs0, hSF' hs0⟩) (hdisj s0 hs0C)
  · rw [show I.support = ⟨C, hCcl⟩ from Closeds.ext hIsupp]

end PrimeDivisorUnion

namespace StratumBlowup

set_option linter.unusedSectionVars false

open MMP.Mori MMP.Resolution MMP.Threefold.Resolution

/-- The prime divisor with a given generic point of coheight one. -/
def primeOfCoheightOne {X : Scheme.{uP}} (x : X) (hx : Order.coheight x = 1) :
    MMP.Mori.PrimeDivisor X where
  idealSheaf := Stacks.Chow.integralComponentAt x
  integral := Stacks.Chow.isIntegral_integralComponentAt x
  codimension_one := by
    have := Stacks.Chow.genericPointOf_integralComponentAt x
    rw [Stacks.Divisors.PrimeDivisor.codimension_closureSingleton]
    convert hx
    exact this

/-- The generic point of `primeOfCoheightOne x hx` is `x`. -/
theorem genericPoint_primeOfCoheightOne {X : Scheme.{uP}} (x : X) (hx : Order.coheight x = 1) :
    (primeOfCoheightOne x hx).genericPoint = x :=
  Stacks.Chow.genericPointOf_integralComponentAt x

variable {k : Type uP} [Field k] {Y : Scheme.{uP}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]
  (I : Y.IdealSheafData)

/-- A point off the centre lies in the biregular locus of the blow-up. -/
theorem mem_biregularLocus_of_notMem {y : Y} (hy : y ∉ (I.support : Set Y)) :
    y ∈ biregularLocus (blowUpToBase I) :=
  le_biregularLocus (V := ⟨(I.support : Set Y)ᶜ, I.support.isClosed.isOpen_compl⟩)
    (isIso_blowUp_restrict_compl_support I) hy

/-- A point of the blow-up lying over a point off the centre has the same coheight as its image. -/
theorem coheight_map_eq {x : blowUp I} (hx : blowUpToBase I x ∉ (I.support : Set Y)) :
    Order.coheight (blowUpToBase I x) = Order.coheight x := by
  have := isIso_stalkMap_of_mem_biregularLocus (blowUpToBase I) (mem_biregularLocus_of_notMem I hx)
  have h :=
    ringKrullDim_eq_of_ringEquiv (asIso ((blowUpToBase I).stalkMap x)).commRingCatIsoToRingEquiv
  rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight] at h
  exact_mod_cast h

/-- A point off the centre has a preimage in the blow-up. -/
theorem exists_preimage_of_notMem {y : Y} (hy : y ∉ (I.support : Set Y)) :
    ∃ x : blowUp I, blowUpToBase I x = y := by
  set V : Y.Opens := ⟨(I.support : Set Y)ᶜ, I.support.isClosed.isOpen_compl⟩
  have := isIso_blowUp_restrict_compl_support I
  obtain ⟨x, hx⟩ := (asIso (blowUpToBase I ∣_ V)).hom.homeomorph.surjective ⟨y, hy⟩
  refine ⟨x.1, ?_⟩
  simpa [morphismRestrict_base_coe] using congrArg Subtype.val hx

/-- Two points of the blow-up with the same image off the centre coincide. -/
theorem eq_of_map_eq_of_notMem {x x' : blowUp I} (hx : blowUpToBase I x ∉ (I.support : Set Y))
    (h : blowUpToBase I x = blowUpToBase I x') : x = x' := by
  have hb := mem_biregularLocus_of_notMem I hx
  have hb' := mem_biregularLocus_of_notMem I (h ▸ hx)
  exact ((specializes_of_mem_biregularLocus _ hb hb' (h ▸ specializes_rfl)).antisymm
    (specializes_of_mem_biregularLocus _ hb' hb (h ▸ specializes_rfl))).eq

section Blowup

variable {I} (h : IsSmoothBlowup sY I) (hirr : IsIrreducible (I.support : Set Y))
  (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))

/-- The exceptional prime divisor. -/
abbrev excE : MMP.Mori.PrimeDivisor (blowUp I) := exceptionalPrimeDivisor sY I h hirr hc

/-- The support of the exceptional divisor is the preimage of the centre. -/
theorem coe_support_excE :
    ((excE sY h hirr hc).support : Set (blowUp I)) = blowUpToBase I ⁻¹' I.support := by
  change ((exceptionalIdeal I).support : Set (blowUp I)) = _
  rw [exceptionalIdeal, Scheme.IdealSheafData.support_comap]
  rfl

/-- The generic point of a prime divisor lies in its support. -/
theorem genericPoint_mem_support (F : MMP.Mori.PrimeDivisor Y) :
    F.genericPoint ∈ (F.support : Set Y) := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl

/-- A non-exceptional prime divisor of the blow-up has generic point lying over a point off the
centre. -/
theorem map_genericPoint_notMem_of_ne {H : MMP.Mori.PrimeDivisor (blowUp I)}
    (hH : H ≠ excE sY h hirr hc) : blowUpToBase I H.genericPoint ∉ (I.support : Set Y) := by
  intro hmem
  apply hH
  apply PrimeDivisorUnion.eq_of_support_subset
  rw [coe_support_excE, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact closure_minimal (Set.singleton_subset_iff.mpr hmem)
    ((I.support.isClosed).preimage (blowUpToBase I).continuous)

/-- A non-exceptional prime divisor of the blow-up has generic point lying over a point of coheight
one. -/
theorem coheight_map_genericPoint {H : MMP.Mori.PrimeDivisor (blowUp I)}
    (hH : H ≠ excE sY h hirr hc) : Order.coheight (blowUpToBase I H.genericPoint) = 1 := by
  rw [coheight_map_eq I (map_genericPoint_notMem_of_ne sY h hirr hc hH)]
  exact MMP.Mori.PrimeDivisor.coheight_genericPoint H

/-- The prime divisor of `Y` under a non-exceptional prime divisor of the blow-up. -/
def downPrime {H : MMP.Mori.PrimeDivisor (blowUp I)} (hH : H ≠ excE sY h hirr hc) :
    MMP.Mori.PrimeDivisor Y :=
  primeOfCoheightOne _ (coheight_map_genericPoint sY h hirr hc hH)

/-- The generic point of `downPrime` is the image of the generic point of `H`. -/
theorem genericPoint_downPrime {H : MMP.Mori.PrimeDivisor (blowUp I)}
    (hH : H ≠ excE sY h hirr hc) :
    (downPrime sY h hirr hc hH).genericPoint = blowUpToBase I H.genericPoint :=
  genericPoint_primeOfCoheightOne _ _

end Blowup

/-- The strict transform of a prime divisor whose generic point is off the centre. -/
def strictPrime (G : MMP.Mori.PrimeDivisor Y) (hG : G.genericPoint ∉ (I.support : Set Y)) :
    MMP.Mori.PrimeDivisor (blowUp I) :=
  primeOfCoheightOne (exists_preimage_of_notMem I hG).choose (by
    have hs := (exists_preimage_of_notMem I hG).choose_spec
    rw [← coheight_map_eq I (by rw [hs]; exact hG), hs]
    exact MMP.Mori.PrimeDivisor.coheight_genericPoint G)

/-- The generic point of the strict transform of `G` lies over the generic point of `G`. -/
theorem map_genericPoint_strictPrime {G : MMP.Mori.PrimeDivisor Y}
    (hG : G.genericPoint ∉ (I.support : Set Y)) :
    blowUpToBase I (strictPrime I G hG).genericPoint = G.genericPoint := by
  rw [strictPrime, genericPoint_primeOfCoheightOne]
  exact (exists_preimage_of_notMem I hG).choose_spec

/-- A prime divisor of the blow-up whose generic point lies over that of `G` is the strict
transform of `G`. -/
theorem strictPrime_eq_of_map {G : MMP.Mori.PrimeDivisor Y} {H : MMP.Mori.PrimeDivisor (blowUp I)}
    (hG : G.genericPoint ∉ (I.support : Set Y))
    (hH : blowUpToBase I H.genericPoint = G.genericPoint) : strictPrime I G hG = H := by
  apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
  apply eq_of_map_eq_of_notMem I (x := (strictPrime I G hG).genericPoint)
  · rw [map_genericPoint_strictPrime I hG]; exact hG
  · rw [map_genericPoint_strictPrime I hG, hH]

/-- If the centre lies in the intersection of two distinct prime divisors, no prime divisor has its
generic point on the centre. -/
theorem genericPoint_notMem_of_subset_inter {F F' : MMP.Mori.PrimeDivisor Y} (hFF : F ≠ F')
    (hI : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support) (G : MMP.Mori.PrimeDivisor Y) :
    G.genericPoint ∉ (I.support : Set Y) := by
  intro hG
  have hsub : (G.support : Set Y) ⊆ I.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact closure_minimal (Set.singleton_subset_iff.mpr hG) I.support.isClosed
  have h1 := PrimeDivisorUnion.eq_of_support_subset (hsub.trans (hI.trans Set.inter_subset_left))
  have h2 := PrimeDivisorUnion.eq_of_support_subset (hsub.trans (hI.trans Set.inter_subset_right))
  exact hFF (h1.symm.trans h2)

/-- The support of the strict transform of `G` lies in the preimage of the support of `G`. -/
theorem support_strictPrime_subset {G : MMP.Mori.PrimeDivisor Y}
    (hG : G.genericPoint ∉ (I.support : Set Y)) :
    ((strictPrime I G hG).support : Set (blowUp I)) ⊆ blowUpToBase I ⁻¹' G.support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  refine closure_minimal (Set.singleton_subset_iff.mpr ?_)
    ((PrimeDivisorUnion.isClosed_support G).preimage (blowUpToBase I).continuous)
  change blowUpToBase I (strictPrime I G hG).genericPoint ∈ (G.support : Set Y)
  rw [map_genericPoint_strictPrime I hG]
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl

/-- A point of the blow-up lying over a point of the support of `G` off the centre lies on the
strict transform of `G`. -/
theorem mem_support_strictPrime {G : MMP.Mori.PrimeDivisor Y}
    (hG : G.genericPoint ∉ (I.support : Set Y)) {x : blowUp I}
    (hx : blowUpToBase I x ∉ (I.support : Set Y)) (hxG : blowUpToBase I x ∈ G.support) :
    x ∈ (strictPrime I G hG).support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure]
  refine specializes_of_mem_biregularLocus _ ?_ (mem_biregularLocus_of_notMem I hx) ?_
  · rw [map_genericPoint_strictPrime I hG]; exact mem_biregularLocus_of_notMem I hG
  · rw [map_genericPoint_strictPrime I hG, specializes_iff_mem_closure,
      ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hxG

end StratumBlowup

namespace SNCBlowup

open MMP.Mori MMP.Resolution MMP.Threefold.Resolution PrimeDivisorUnion StratumBlowup

set_option linter.unusedSectionVars false

variable {k : Type uP} [Field k] {Y : Scheme.{uP}} (sY : Y ⟶ Spec (.of k)) {T : Divisor Y}

/-- For a closed set `D` containing the centre, the total transform of `D` is its preimage under
the blow-up. -/
theorem totalTransformStep_eq {Z : Y.IdealSheafData} {D : Set Y} (hD : IsClosed D)
    (hZ : (Z.support : Set Y) ⊆ D) :
    ClosedBlowupSequence.totalTransformStep Z D = blowUpToBase Z ⁻¹' D := by
  refine le_antisymm (Set.union_subset ?_ (Set.preimage_mono hZ)) fun y hy => ?_
  · exact closure_minimal (Set.preimage_mono Set.diff_subset)
      (hD.preimage (blowUpToBase Z).continuous)
  · by_cases h : blowUpToBase Z y ∈ (Z.support : Set Y)
    · exact Or.inr h
    · exact Or.inl (subset_closure ⟨hy, h⟩)

variable {F F' : MMP.Mori.PrimeDivisor Y} {I : Y.IdealSheafData}

/-- The centre has simple normal crossings with the boundary. -/
theorem hasSNCWith_centre (hT : T.IsSNC sY) (hF : F ∈ T.support) (hF' : F' ∈ T.support)
    (hIsub : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support)
    (hIst : ∀ y ∈ I.support, IdealSheafData.stalk I y =
      IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y) :
    HasSNCWith (componentsFamily (⋃ G ∈ T.support, (G.support : Set Y))) I := by
  classical
  intro x hx
  have hxF : x ∈ F.support := (hIsub hx).1
  have hxF' : x ∈ F'.support := (hIsub hx).2
  obtain ⟨n, z, j, hz, hj, hI⟩ := hT.2 x
  choose G hG hWG using fun W : componentsOf (⋃ F ∈ T.support, (F.support : Set Y)) =>
    exists_prime_of_mem_componentsOf W.2
  have hmem : ∀ W : {W : componentsOf (⋃ F ∈ T.support, (F.support : Set Y)) //
      x ∈ (componentsFamily _ W).support}, x ∈ (G W.1).support := by
    intro W
    have := W.2
    rwa [componentsFamily_eq_idealSheaf W.1 (G W.1) (hWG W.1)] at this
  let e : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ x ∈ E.support} := ⟨F, hF, hxF⟩
  let e' : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ x ∈ E.support} := ⟨F', hF', hxF'⟩
  refine ⟨n, z, fun W => j ⟨G W.1, hG W.1, hmem W⟩, {j e, j e'}, hz, fun W => ?_, ?_, ?_⟩
  · rw [componentsFamily_eq_idealSheaf W.1 (G W.1) (hWG W.1)]
    exact hI ⟨G W.1, hG W.1, hmem W⟩
  · intro W W' h
    have h1 := congrArg (fun E => E.1) (hj h)
    simp only at h1
    apply Subtype.ext; apply Subtype.ext
    rw [hWG W.1, hWG W'.1, h1]
  · rw [hIst x hx, hI e, hI e', span_pair_eq_span_image]

/-- The centre has codimension two. -/
theorem codimension_centre_eq_two [IsLocallyNoetherian Y] (hT : T.IsSNC sY)
    (hF : F ∈ T.support) (hF' : F' ∈ T.support) (hFF : F ≠ F')
    (hirr : IsIrreducible (I.support : Set Y))
    (hIsm : IsSmoothScheme (I.subschemeι ≫ sY))
    (hIsub : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support)
    (hIst : ∀ y ∈ I.support, IdealSheafData.stalk I y =
      IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y) :
    codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y) = 2 := by
  classical
  have := isIntegral_subscheme_of_isIrreducible sY I hIsm hirr
  set η := I.subschemeι (genericPoint I.subscheme)
  have hηI : η ∈ I.support := by
    rw [← SetLike.mem_coe, ← closure_subschemeι_genericPoint I]; exact subset_closure rfl
  have heq : (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y) =
      IrreducibleCloseds.closureSingleton η := by
    ext1; exact (closure_subschemeι_genericPoint I).symm
  rw [heq, Stacks.Divisors.PrimeDivisor.codimension_closureSingleton]
  suffices hd : ringKrullDim (Y.presheaf.stalk η) = 2 by
    have h := ringKrullDim_stalk_eq_coheight (X := Y) η
    rw [hd] at h
    have h' : ((Order.coheight η : ℕ∞) : WithBot ℕ∞) = ((2 : ℕ∞) : WithBot ℕ∞) := h.symm
    exact WithBot.coe_injective h'
  obtain ⟨n, z, a, b, hz, hab, ha, hb⟩ :=
    exists_params_of_isSNC hT hF hF' hFF (hIsub hηI).1 (hIsub hηI).2
  have hmax : maximalIdeal (Y.presheaf.stalk η) = Ideal.span {z a, z b} := by
    rw [← IdealSheafData.stalk_subschemeι_genericPoint_eq_maximalIdeal I, hIst η hηI, ha, hb,
      Ideal.span_insert]
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  have hspan := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Y.presheaf.stalk η)
  rw [hz.2] at hspan ⊢
  have hle : (maximalIdeal (Y.presheaf.stalk η)).spanFinrank ≤ 2 := by
    rw [hmax]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
    exact (Set.ncard_insert_le _ _).trans (by simp)
  have hn : n = (maximalIdeal (Y.presheaf.stalk η)).spanFinrank := by exact_mod_cast hspan.symm
  have h2 : 2 ≤ n := by
    by_contra h
    push Not at h
    interval_cases n
    · exact a.elim0
    · exact hab (Subsingleton.elim a b)
  have : n = 2 := by omega
  rw [this]; rfl

section NewBoundary

variable [IsIntegral Y] (hFF : F ≠ F')
  (hIsub : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support)
  (h : IsSmoothBlowup sY I) (hirr : IsIrreducible (I.support : Set Y))
  (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))

/-- The components of the new boundary: the exceptional divisor and the strict transforms. -/
def newPrimes (T : Divisor Y) : Finset (MMP.Mori.PrimeDivisor (blowUp I)) :=
  letI : DecidableEq (MMP.Mori.PrimeDivisor (blowUp I)) := Classical.decEq _
  insert (excE sY h hirr hc) (Finset.image (fun G : T.support =>
    strictPrime I G.1 (genericPoint_notMem_of_subset_inter I hFF hIsub G.1)) Finset.univ)

/-- A prime divisor of the blow-up lies in `newPrimes` exactly when it is the exceptional
divisor or the strict transform of a component of `T`. -/
theorem mem_newPrimes {H : MMP.Mori.PrimeDivisor (blowUp I)} :
    H ∈ newPrimes sY hFF hIsub h hirr hc T ↔ H = excE sY h hirr hc ∨
      ∃ G ∈ T.support, strictPrime I G (genericPoint_notMem_of_subset_inter I hFF hIsub G) = H := by
  classical
  simp only [newPrimes, Finset.mem_insert, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro (h1 | ⟨G, hG⟩)
    · exact Or.inl h1
    · exact Or.inr ⟨G.1, G.2, hG⟩
  · rintro (h1 | ⟨G, hG, hGH⟩)
    · exact Or.inl h1
    · exact Or.inr ⟨⟨G, hG⟩, hGH⟩

/-- The union of the supports of `newPrimes` is the preimage of the support of `T`. -/
theorem iUnion_newPrimes (hF : F ∈ T.support) :
    (⋃ H ∈ newPrimes sY hFF hIsub h hirr hc T, (H.support : Set (blowUp I))) =
      blowUpToBase I ⁻¹' ⋃ G ∈ T.support, (G.support : Set Y) := by
  classical
  ext y
  simp only [Set.mem_iUnion, Set.mem_preimage, exists_prop]
  constructor
  · rintro ⟨H, hH, hy⟩
    rcases (mem_newPrimes sY hFF hIsub h hirr hc).mp hH with rfl | ⟨G, hG, rfl⟩
    · rw [coe_support_excE] at hy
      exact ⟨F, hF, (hIsub hy).1⟩
    · exact ⟨G, hG, support_strictPrime_subset I _ hy⟩
  · rintro ⟨G, hG, hy⟩
    by_cases hyI : blowUpToBase I y ∈ (I.support : Set Y)
    · refine ⟨excE sY h hirr hc, (mem_newPrimes sY hFF hIsub h hirr hc).mpr (Or.inl rfl), ?_⟩
      rw [coe_support_excE]; exact hyI
    · exact ⟨_, (mem_newPrimes sY hFF hIsub h hirr hc).mpr (Or.inr ⟨G, hG, rfl⟩),
        mem_support_strictPrime I _ hyI hy⟩

/-- Over a field of characteristic zero, the blow-up of a smooth variety along the scheme-theoretic
intersection of two components of an snc divisor `T` has snc reduced boundary `newPrimes`. -/
theorem isSNC_newBoundary [CharZero k] [LocallyOfFiniteType sY] [QuasiCompact sY]
    (hYs : IsSmoothScheme sY) (hT : T.IsSNC sY) (hF : F ∈ T.support) (hF' : F' ∈ T.support)
    (hIst : ∀ y ∈ I.support, IdealSheafData.stalk I y =
      IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y) :
    (MMP.Intersection.reducedDivisorOf (newPrimes sY hFF hIsub h hirr hc T)).IsSNC
      (blowUpToBase I ≫ sY) := by
  have hD := isSNCClosedSubset_of_isSNC sY hT
  have hZ := hasSNCWith_centre sY hT hF hF' hIsub hIst
  have hS := isSNCClosedSubset_totalTransformStep sY hYs hD hZ
  rw [totalTransformStep_eq (isClosed_iUnion_support _)
    (fun y hy => Set.mem_biUnion hF (hIsub hy).1), ← iUnion_newPrimes sY hFF hIsub h hirr hc hF]
    at hS
  have hsm := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
  have : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
  refine isSNC_reducedDivisorOf_of_isSNCClosedSubset _ (fun y => ?_) _ hS
  have := isRegularLocalRing_stalk_of_smooth_over_field (blowUpToBase I ≫ sY) y
  exact MMP.Mori.exists_isRegularSystemOfParameters _

end NewBoundary

end SNCBlowup

namespace LocalEquation

open MMP.Mori MMP.Resolution MMP.Threefold.Resolution PrimeDivisorUnion StratumBlowup

set_option linter.unusedSectionVars false

variable {Y : Scheme.{uP}}

/-- The prime of the generic point of a prime divisor through `y` is its ideal at `y`. -/
theorem primeOfSpecializes_eq_stalk (G : MMP.Mori.PrimeDivisor Y) {y : Y}
    (h : G.genericPoint ⤳ y) :
    MMP.Intersection.primeOfSpecializes h = IdealSheafData.stalk G.idealSheaf y := by
  have hy : y ∈ (G.support : Set Y) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure]; exact h
  obtain ⟨q, hq, hst, -⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support G hy
  rw [hst, primeOfSpecializes_congr hq.symm h (MMP.Resolution.specializes_fromSpecStalk y q),
    primeOfSpecializes_fromSpecStalk]

/-- The generic point of a prime divisor specializes to every point of its support. -/
theorem specializes_of_mem (G : MMP.Mori.PrimeDivisor Y) {y : Y} (hy : y ∈ (G.support : Set Y)) :
    G.genericPoint ⤳ y := by
  rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact hy

variable [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- A local equation of a prime divisor `G` at a point of `G` has valuation `exp (-1)`. -/
theorem divisorialValuation_localEq (G : MMP.Mori.PrimeDivisor Y) {y : Y}
    (hy : y ∈ (G.support : Set Y)) {u : Y.presheaf.stalk y}
    (hu : IdealSheafData.stalk G.idealSheaf y = Ideal.span {u}) :
    G.divisorialValuation (algebraMap _ Y.functionField u) = WithZero.exp (-1) := by
  have h := specializes_of_mem G hy
  have := G.isDiscreteValuationRing_localRing
  rw [← MMP.Mori.algebraMap_stalkSpecializes h]
  refine G.divisorialValuation_algebraMap_of_irreducible ?_
  let := (Y.presheaf.stalkSpecializes h).hom.toAlgebra
  have hloc := MMP.Intersection.isLocalization_stalkSpecializes h
  have hmax := IsLocalization.AtPrime.map_eq_maximalIdeal
    (MMP.Intersection.primeOfSpecializes h) (Y.presheaf.stalk G.genericPoint)
  rw [primeOfSpecializes_eq_stalk G h, hu, Ideal.map_span, Set.image_singleton] at hmax
  refine IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ ?_ hmax.symm
  intro h0
  have : maximalIdeal (Y.presheaf.stalk G.genericPoint) = ⊥ := by
    rw [← hmax]; change Ideal.span {(Y.presheaf.stalkSpecializes h).hom u} = ⊥
    rw [h0]; simp
  exact IsDiscreteValuationRing.not_a_field _ this

/-- An element outside the ideal of `G` at a point of `G` is a unit along `G`. -/
theorem divisorialValuation_eq_one_of_notMem (G : MMP.Mori.PrimeDivisor Y) {y : Y}
    (hy : y ∈ (G.support : Set Y)) {u : Y.presheaf.stalk y}
    (hu : u ∉ IdealSheafData.stalk G.idealSheaf y) :
    G.divisorialValuation (algebraMap _ Y.functionField u) = 1 := by
  have h := specializes_of_mem G hy
  rw [← MMP.Mori.algebraMap_stalkSpecializes h]
  have hunit : IsUnit ((Y.presheaf.stalkSpecializes h).hom u) := by
    by_contra hnu
    apply hu
    rw [← primeOfSpecializes_eq_stalk G h]
    exact (IsLocalRing.mem_maximalIdeal _).2 hnu
  refine le_antisymm ((G.divisorialValuation_le_one_iff _).2 ⟨_, rfl⟩) ?_
  by_contra hlt
  push Not at hlt
  have := (G.divisorialValuation_algebraMap_lt_one_iff _).1 hlt
  exact (IsLocalRing.mem_maximalIdeal _).1 this hunit

omit [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] in
/-- A unit of the local ring of a prime divisor `E` has divisorial valuation `1` along `E`. -/
theorem divisorialValuation_algebraMap_of_isUnit' {X : Scheme.{uP}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (E : MMP.Mori.PrimeDivisor X) {a : E.localRing}
    (ha : IsUnit a) : E.divisorialValuation (algebraMap _ X.functionField a) = 1 := by
  refine le_antisymm ((E.divisorialValuation_le_one_iff _).2 ⟨_, rfl⟩) ?_
  by_contra hlt
  push Not at hlt
  exact (IsLocalRing.mem_maximalIdeal _).1
    ((E.divisorialValuation_algebraMap_lt_one_iff _).1 hlt) ha

/-- If `f ≠ 0` has divisorial valuation `exp (-n)` along `G`, the order of `f` at the generic point
of `G` is `n`. -/
theorem ord_eq_of_divisorialValuation_eq (G : MMP.Mori.PrimeDivisor Y) {f : Y.functionField}
    (hf : f ≠ 0) {n : ℤ} (h : G.divisorialValuation f = WithZero.exp (-n)) :
    Y.ord f G.genericPoint = n := by
  rw [G.divisorialValuation_eq_exp_neg_ord hf] at h
  exact neg_injective (WithZero.exp_injective h)

/-- A local equation of a prime divisor at one of its points is a nonzero rational function. -/
theorem localEq_ne_zero (H : MMP.Mori.PrimeDivisor Y) {y : Y} (hyH : y ∈ (H.support : Set Y))
    {u : Y.presheaf.stalk y} (hu : IdealSheafData.stalk H.idealSheaf y = Ideal.span {u}) :
    algebraMap _ Y.functionField u ≠ 0 := by
  intro h0
  have h0' : u = 0 := (map_eq_zero_iff _ (IsFractionRing.injective _ _)).mp h0
  obtain ⟨q, -, hq, hqh⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support H hyH
  rw [hu, h0', Ideal.span_singleton_eq_bot.mpr rfl] at hq
  rw [← hq, Ideal.height_bot] at hqh
  exact absurd hqh (by decide)

open Classical in
/-- The order along a prime divisor `G` through `y` of a local equation at `y` of a prime
divisor `F` through `y`. -/
theorem ord_localEq (G F : MMP.Mori.PrimeDivisor Y) {y : Y} (hyG : y ∈ (G.support : Set Y))
    (hyF : y ∈ (F.support : Set Y)) {x : Y.presheaf.stalk y}
    (hx : IdealSheafData.stalk F.idealSheaf y = Ideal.span {x}) :
    Y.ord (algebraMap _ Y.functionField x) G.genericPoint = if G = F then 1 else 0 := by
  classical
  obtain ⟨q, -, hq, hqh⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support F hyF
  have hax := localEq_ne_zero F hyF hx
  split_ifs with hGF
  · subst hGF
    exact ord_eq_of_divisorialValuation_eq G hax (by rw [divisorialValuation_localEq G hyG hx])
  · refine ord_eq_of_divisorialValuation_eq G hax ?_
    rw [divisorialValuation_eq_one_of_notMem G hyG]; · rfl
    intro hmem
    obtain ⟨q', -, hq', hqh'⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support G hyG
    have hle : q.asIdeal ≤ q'.asIdeal := by
      rw [← hq, ← hq', hx, Ideal.span_le, Set.singleton_subset_iff]; exact hmem
    rcases hle.lt_or_eq with hlt | heq
    · have : q'.asIdeal.FiniteHeight :=
        (Ideal.finiteHeight_iff _).mpr (Or.inr (by rw [hqh']; decide))
      have := Ideal.height_strict_mono_of_isPrime_of_isPrime hlt
      rw [hqh, hqh'] at this
      exact lt_irrefl _ this
    · exact hGF (MMP.Intersection.eq_of_stalk_idealSheaf_eq hyG hyF (by rw [hq', hq, heq]))

section Exc

variable {k : Type uP} [Field k] (sY : Y ⟶ Spec (.of k)) {I : Y.IdealSheafData}
  (h : IsSmoothBlowup sY I) (hirr : IsIrreducible (I.support : Set Y))
  (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))

/-- Along the exceptional divisor, the pull-backs of the equations of the centre are
uniformizers. -/
theorem divisorialValuation_excE_param
    {n : ℕ} {z : Fin n → Y.presheaf.stalk (blowUpToBase I (excE sY h hirr hc).genericPoint)}
    (hz : IsRegularSystemOfParameters z) {J : Finset (Fin n)}
    (hJ : IdealSheafData.stalk I (blowUpToBase I (excE sY h hirr hc).genericPoint) =
      Ideal.span (z '' J)) {j : Fin n} (hj : j ∈ J) :
    haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
    haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
    haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
    haveI : IsNormal (Spec (.of k)) := isNormal_spec_of_isIntegrallyClosed _
    haveI := AlgebraicGeometry.isNormal_of_smooth (blowUpToBase I ≫ sY)
    (excE sY h hirr hc).divisorialValuation
      (algebraMap _ (blowUp I).functionField
        (((blowUpToBase I).stalkMap (excE sY h hirr hc).genericPoint).hom (z j))) =
      WithZero.exp (-1) := by
  haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
  haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
  haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
  haveI : IsNormal (Spec (.of k)) := isNormal_spec_of_isIntegrallyClosed _
  haveI := AlgebraicGeometry.isNormal_of_smooth (blowUpToBase I ≫ sY)
  set E := excE sY h hirr hc
  have hx : blowUpToBase I E.genericPoint ∈ I.support := by
    have := genericPoint_mem_support E
    rw [coe_support_excE] at this; exact this
  obtain ⟨N, w, m, i₀, σ, U, hw, hm, hU, hwi₀, hout, hin, hunit, hσ₀⟩ :=
    exists_chart_coordinates I E.genericPoint hx hz hJ
  have hN : N = 1 := by
    have h1 := hw.2
    rw [ringKrullDim_stalk_eq_coheight, MMP.Mori.PrimeDivisor.coheight_genericPoint] at h1
    exact_mod_cast h1.symm
  subst hN
  have := E.isDiscreteValuationRing_localRing
  have hirrw : Irreducible (w i₀) := by
    refine IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ ?_ ?_
    · intro h0
      have hmax := hw.1
      have : maximalIdeal ((blowUp I).presheaf.stalk E.genericPoint) = ⊥ := by
        rw [← hmax]
        refine Ideal.span_eq_bot.mpr ?_
        rintro _ ⟨i, rfl⟩
        rw [Subsingleton.elim i i₀]; exact h0
      exact IsDiscreteValuationRing.not_a_field _ this
    · rw [← hw.1]
      congr 1
      ext a
      simp only [Set.mem_range, Set.mem_singleton_iff]
      exact ⟨fun ⟨i, hi⟩ => by rw [← hi, Subsingleton.elim i i₀], fun ha => ⟨i₀, ha.symm⟩⟩
  have hv := E.divisorialValuation_algebraMap_of_irreducible hirrw
  by_cases hjm : j = m
  · subst hjm; rw [← hwi₀]; exact hv
  · have hjU : j ∈ U := by
      by_contra hjU
      exact hσ₀ j hjm hjU (Subsingleton.elim _ _)
    obtain ⟨u, hu, hu'⟩ := hunit j hjU
    rw [hu', map_mul, map_mul, hv]
    rw [divisorialValuation_algebraMap_of_isUnit' E hu, one_mul]

end Exc

end LocalEquation

namespace BlowupCrepancy

open MMP.Mori MMP.Resolution MMP.Threefold.Resolution PrimeDivisorUnion StratumBlowup SNCBlowup
  LocalEquation

set_option linter.unusedSectionVars false

variable {k : Type uP} [Field k] {Y : Scheme.{uP}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]
  {I : Y.IdealSheafData}

/-- The closure of the image of the generic point of the exceptional divisor is the centre. -/
theorem closure_map_genericPoint_excE (h : IsSmoothBlowup sY I)
    (hirr : IsIrreducible (I.support : Set Y))
    (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y)) :
    closure {blowUpToBase I (excE sY h hirr hc).genericPoint} = (I.support : Set Y) := by
  obtain ⟨-, F₀, hF₀, -, himg⟩ :=
    isSmoothScheme_blowUp_and_exists_primeDivisor_exceptionalIdeal sY I h hirr hc
  have hF₀E : F₀ = excE sY h hirr hc := MMP.Mori.PrimeDivisor.ext_idealSheaf hF₀
  subst hF₀E
  have hmem : blowUpToBase I (excE sY h hirr hc).genericPoint ∈ (I.support : Set Y) := by
    rw [← himg]
    exact ⟨_, by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl,
      rfl⟩
  refine le_antisymm (closure_minimal (Set.singleton_subset_iff.mpr hmem) I.support.isClosed) ?_
  rw [← himg, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  refine (image_closure_subset_closure_image (blowUpToBase I).continuous).trans ?_
  rw [Set.image_singleton]

/-- The local ring of `Y` at the image of the generic point of the exceptional divisor has
dimension the codimension of the centre. -/
theorem ringKrullDim_stalk_map_genericPoint_excE (h : IsSmoothBlowup sY I)
    (hirr : IsIrreducible (I.support : Set Y))
    (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))
    {c : ℕ} (hcc : codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y) = c) :
    ringKrullDim (Y.presheaf.stalk (blowUpToBase I (excE sY h hirr hc).genericPoint)) = c := by
  have heq : (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y) =
      IrreducibleCloseds.closureSingleton (blowUpToBase I (excE sY h hirr hc).genericPoint) := by
    ext1; exact (closure_map_genericPoint_excE sY h hirr hc).symm
  rw [heq, Stacks.Divisors.PrimeDivisor.codimension_closureSingleton] at hcc
  rw [ringKrullDim_stalk_eq_coheight, hcc]; rfl

/-- Through a point of local dimension two where `F ≠ F'` of an snc divisor meet, no other
component of the divisor passes. -/
theorem mem_pair_of_ringKrullDim_eq_two {T : Divisor Y} (hT : T.IsSNC sY)
    {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support) (hF' : F' ∈ T.support) (hFF : F ≠ F')
    {y : Y} (hyF : y ∈ (F.support : Set Y)) (hyF' : y ∈ (F'.support : Set Y))
    (hd : ringKrullDim (Y.presheaf.stalk y) = 2) {G : MMP.Mori.PrimeDivisor Y}
    (hG : G ∈ T.support) (hyG : y ∈ (G.support : Set Y)) : G = F ∨ G = F' := by
  obtain ⟨n, z, j, hz, hj, -⟩ := hT.2 y
  have hn : n = 2 := by have := hz.2; rw [hd] at this; exact_mod_cast this.symm
  subst hn
  by_contra hne
  push Not at hne
  let e : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ y ∈ E.support} := ⟨F, hF, hyF⟩
  let e' : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ y ∈ E.support} := ⟨F', hF', hyF'⟩
  let e'' : {E : MMP.Mori.PrimeDivisor Y // E ∈ T.support ∧ y ∈ E.support} := ⟨G, hG, hyG⟩
  have h1 : j e ≠ j e' := fun h => hFF (congrArg Subtype.val (hj h))
  have h2 : j e'' ≠ j e := fun h => hne.1 (congrArg Subtype.val (hj h))
  have h3 : j e'' ≠ j e' := fun h => hne.2 (congrArg Subtype.val (hj h))
  revert h1 h2 h3
  generalize j e = a; generalize j e' = b; generalize j e'' = c
  intro h1 h2 h3
  fin_cases a <;> fin_cases b <;> fin_cases c <;> simp_all

/-- Along the exceptional divisor, a rational function whose divisor near the generic point of
the centre is `-(F + F')` has order `-2`. -/
theorem ord_excE_of_ord_eq [CharZero k] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsLocallyNoetherian Y] [IsNormal Y] {T : Divisor Y}
    (hTred : MMP.Intersection.IsReducedEffective T)
    (hT : T.IsSNC sY) {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support)
    (hF' : F' ∈ T.support) (hFF : F ≠ F') (hirr : IsIrreducible (I.support : Set Y))
    (hIsm : IsSmoothScheme (I.subschemeι ≫ sY))
    (hIsub : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support)
    (hIst : ∀ y ∈ I.support, IdealSheafData.stalk I y =
      IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y)
    (h : IsSmoothBlowup sY I)
    (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))
    (a : Y.functionField) (ha0 : a ≠ 0)
    (hordA : ∀ G : MMP.Mori.PrimeDivisor Y,
      blowUpToBase I (excE sY h hirr hc).genericPoint ∈ (G.support : Set Y) →
        Y.ord a G.genericPoint = -T.coeff G) :
    haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
    haveI := isDominant_blowUpToBase I hirr hc
    haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
    haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
    (blowUp I).ord (functionFieldMap (blowUpToBase I) a) (excE sY h hirr hc).genericPoint = -2 := by
  classical
  haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
  haveI := isDominant_blowUpToBase I hirr hc
  haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
  haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
  haveI : IsNormal (Spec (.of k)) := isNormal_spec_of_isIntegrallyClosed _
  haveI := AlgebraicGeometry.isNormal_of_smooth (blowUpToBase I ≫ sY)
  have hc2 := codimension_centre_eq_two sY hT hF hF' hFF hirr hIsm hIsub hIst
  have hy : blowUpToBase I (excE sY h hirr hc).genericPoint ∈ (I.support : Set Y) := by
    rw [← closure_map_genericPoint_excE sY h hirr hc]; exact subset_closure rfl
  have hdim := ringKrullDim_stalk_map_genericPoint_excE sY h hirr hc hc2
  obtain ⟨n, z, a', b', hz, hab, ha', hb'⟩ :=
    exists_params_of_isSNC hT hF hF' hFF (hIsub hy).1 (hIsub hy).2
  have hza : ∀ c : Fin n, algebraMap _ Y.functionField (z c) ≠ 0 := by
    intro c hc0
    have := (MMP.Intersection.prime_of_isRegularSystemOfParameters hz c).ne_zero
    exact this ((map_eq_zero_iff _ (IsFractionRing.injective _ _)).mp hc0)
  have hb0 : a * algebraMap _ Y.functionField (z a') * algebraMap _ Y.functionField (z b') ≠ 0 :=
    mul_ne_zero (mul_ne_zero ha0 (hza a')) (hza b')
  have hordb : ∀ G : MMP.Mori.PrimeDivisor Y,
      blowUpToBase I (excE sY h hirr hc).genericPoint ∈ G.support →
      Y.ord (a * algebraMap _ Y.functionField (z a') * algebraMap _ Y.functionField (z b'))
        G.genericPoint = 0 := by
    intro G hG
    rw [Scheme.ord_mul (mul_ne_zero ha0 (hza a')) (hza b'), Scheme.ord_mul ha0 (hza a'),
      hordA G hG, ord_localEq G F hG (hIsub hy).1 ha', ord_localEq G F' hG (hIsub hy).2 hb']
    by_cases hGT : G ∈ T.support
    · have hT1 : T.coeff G = 1 := (hTred G).resolve_left (Finsupp.mem_support_iff.mp hGT)
      rcases mem_pair_of_ringKrullDim_eq_two sY hT hF hF' hFF (hIsub hy).1 (hIsub hy).2 hdim hGT
        hG with rfl | rfl
      · rw [hT1, if_pos rfl, if_neg hFF]; ring
      · rw [hT1, if_neg (Ne.symm hFF), if_pos rfl]; ring
    · have hT0 : T.coeff G = 0 := Finsupp.notMem_support_iff.mp hGT
      have h1 : G ≠ F := fun h1 => hGT (h1 ▸ hF)
      have h2 : G ≠ F' := fun h2 => hGT (h2 ▸ hF')
      rw [hT0, if_neg h1, if_neg h2]; ring
  obtain ⟨r, hr, hrb⟩ := exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero _ hb0 hordb
  have hJ : IdealSheafData.stalk I (blowUpToBase I (excE sY h hirr hc).genericPoint) =
      Ideal.span (z '' (({a', b'} : Finset (Fin n)) : Set _)) :=
    by rw [hIst _ hy, ha', hb', span_pair_eq_span_image]
  have hva : ∀ c ∈ ({a', b'} : Finset (Fin n)), (excE sY h hirr hc).divisorialValuation
      (functionFieldMap (blowUpToBase I) (algebraMap _ Y.functionField (z c))) =
        WithZero.exp (-1) := by
    intro c hc'
    rw [MMP.Mori.functionFieldMap_algebraMap_stalk]
    exact divisorialValuation_excE_param sY h hirr hc hz hJ hc'
  have hvr : (excE sY h hirr hc).divisorialValuation
      (functionFieldMap (blowUpToBase I) (algebraMap _ Y.functionField r)) = 1 := by
    rw [MMP.Mori.functionFieldMap_algebraMap_stalk]
    exact divisorialValuation_algebraMap_of_isUnit' _ (hr.map _)
  have hab' : a = algebraMap _ Y.functionField r * (algebraMap _ Y.functionField (z a'))⁻¹ *
      (algebraMap _ Y.functionField (z b'))⁻¹ := by
    have h1 := hza a'
    have h2 := hza b'
    rw [hrb]; field_simp
  have hval : (excE sY h hirr hc).divisorialValuation (functionFieldMap (blowUpToBase I) a) =
      WithZero.exp (-(-2)) := by
    rw [hab', map_mul, map_mul, map_inv₀, map_inv₀, map_mul, map_mul, map_inv₀, map_inv₀, hvr,
      hva a' (by simp), hva b' (by simp), one_mul, ← WithZero.exp_neg, ← WithZero.exp_add]
    norm_num
  exact ord_eq_of_divisorialValuation_eq _ ((map_ne_zero _).mpr ha0) hval

open Classical in
/-- **Log crepancy of one blow-up.** If `σ` is a top form with `div σ = -T` near `V0`, then its
pull-back to the blow-up of the codimension-two stratum `C ⊆ F ∩ F'` has divisor `-T'` near the
preimage of `V0`, where `T'` is the exceptional divisor plus the strict transform of `T`. -/
theorem ordForm_pullback_blowUp [CharZero k] [LocallyOfFiniteType sY] [QuasiCompact sY]
    [IsLocallyNoetherian Y] (hYs : IsSmoothScheme sY) {T : Divisor Y}
    (hTred : MMP.Intersection.IsReducedEffective T)
    (hT : T.IsSNC sY) {F F' : MMP.Mori.PrimeDivisor Y} (hF : F ∈ T.support)
    (hF' : F' ∈ T.support) (hFF : F ≠ F') (hirr : IsIrreducible (I.support : Set Y))
    (hIsm : IsSmoothScheme (I.subschemeι ≫ sY))
    (hIsub : (I.support : Set Y) ⊆ (F.support : Set Y) ∩ F'.support)
    (hIst : ∀ y ∈ I.support, IdealSheafData.stalk I y =
      IdealSheafData.stalk F.idealSheaf y ⊔ IdealSheafData.stalk F'.idealSheaf y)
    (h : IsSmoothBlowup sY I)
    (hc : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds Y))
    {d : ℕ} (hd : topologicalKrullDim Y = d) (σ : RationalPluriForms sY d 1) (hσ0 : σ ≠ 0)
    (V0 : Y.Opens)
    (hσ : ∀ G : MMP.Mori.PrimeDivisor Y, G.genericPoint ∈ V0 → G.ordForm σ = -T.coeff G)
    (H : MMP.Mori.PrimeDivisor (blowUp I)) (hH : blowUpToBase I H.genericPoint ∈ V0) :
    haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
    haveI := isDominant_blowUpToBase I hirr hc
    haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
    haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
    H.ordForm (pullbackRationalPluriForms sY (blowUpToBase I) σ) =
      -(MMP.Intersection.reducedDivisorOf (newPrimes sY hFF hIsub h hirr hc T)).coeff H := by
  haveI := isIntegral_blowUp_of_one_le_codimension I hirr hc
  haveI := isDominant_blowUpToBase I hirr hc
  haveI := (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sY I h).1
  haveI : IsLocallyNoetherian (blowUp I) := isLocallyNoetherian_of_smooth (blowUpToBase I ≫ sY)
  haveI : Smooth sY := smooth_of_isSmoothScheme hYs
  haveI : IsNormal (Spec (.of k)) := isNormal_spec_of_isIntegrallyClosed _
  haveI := AlgebraicGeometry.isNormal_of_smooth sY
  haveI := AlgebraicGeometry.isNormal_of_smooth (blowUpToBase I ≫ sY)
  have hc2 := codimension_centre_eq_two sY hT hF hF' hFF hirr hIsm hIsub hIst
  have hbij := (isBirationalMorphism_blowUpToBase I hirr hc).functionFieldMap_bijective
  have htr := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) hd
  rw [MMP.Intersection.coeff_reducedDivisorOf]
  by_cases hHE : H = excE sY h hirr hc
  · rw [if_pos ((mem_newPrimes sY hFF hIsub h hirr hc).mpr (Or.inl hHE))]
    subst hHE
    obtain ⟨σA, hσA, h0A, σB, hσB, h0B, g, hrel, hg, hord⟩ :=
      exists_topForms_rel I sY h hirr (c := 2) (by rw [hc2]; rfl) (by norm_num) hd
        (excE sY h hirr hc)
    rw [if_pos rfl] at hord
    rw [ordForm_pullbackRationalPluriForms_eq sY (blowUpToBase I) _ hσA h0A hσB h0B g hrel hg hσ0,
      hord]
    let := stalkAlgebra sY (blowUpToBase I (excE sY h hirr hc).genericPoint)
    let := functionFieldAlgebra sY
    have := isScalarTower_stalk_functionField sY (blowUpToBase I (excE sY h hirr hc).genericPoint)
    rw [ord_excE_of_ord_eq sY hTred hT hF hF' hFF hirr hIsm hIsub hIst h hc
      (formCoeff (k := k) _ hσA h0A (show PluriForms k Y.functionField d 1 from σ))
      (fun h0 => hσ0 ((formCoeff_eq_zero_iff hσA h0A _).mp h0)) fun G hG => by
        rw [← ordForm_eq_ord_formCoeff sY _ G hG hσA h0A σ]
        exact hσ G ((specializes_of_mem G hG).mem_open V0.isOpen hH)]
    norm_num
  · have hnot : blowUpToBase I H.genericPoint ∉ (I.support : Set Y) :=
      map_genericPoint_notMem_of_ne sY h hirr hc hHE
    have heq : blowUpToBase I H.genericPoint = (downPrime sY h hirr hc hHE).genericPoint :=
      (genericPoint_downPrime sY h hirr hc hHE).symm
    haveI : IsIso ((blowUpToBase I).stalkMap H.genericPoint) :=
      isIso_stalkMap_of_mem_biregularLocus _ (mem_biregularLocus_of_notMem I hnot)
    rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso (blowUpToBase I) hbij htr H _
      heq σ, hσ _ (heq ▸ hH)]
    have hiff :
        H ∈ newPrimes sY hFF hIsub h hirr hc T ↔ downPrime sY h hirr hc hHE ∈ T.support := by
      rw [mem_newPrimes]
      constructor
      · rintro (h1 | ⟨G, hG, hGH⟩)
        · exact absurd h1 hHE
        · have : G = downPrime sY h hirr hc hHE := by
            apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
            calc G.genericPoint = blowUpToBase I (strictPrime I G
                  (genericPoint_notMem_of_subset_inter I hFF hIsub G)).genericPoint :=
                (map_genericPoint_strictPrime I _).symm
              _ = blowUpToBase I H.genericPoint := by rw [hGH]
              _ = _ := heq
          exact this ▸ hG
      · intro hG
        exact Or.inr ⟨_, hG, strictPrime_eq_of_map I _ heq⟩
    by_cases hG : downPrime sY h hirr hc hHE ∈ T.support
    · have h1 : T.coeff (downPrime sY h hirr hc hHE) = 1 :=
        (hTred _).resolve_left (Finsupp.mem_support_iff.mp hG)
      rw [if_pos (hiff.mpr hG), h1]
    · have h0 : T.coeff (downPrime sY h hirr hc hHE) = 0 := Finsupp.notMem_support_iff.mp hG
      rw [if_neg (fun h => hG (hiff.mp h)), h0]

end BlowupCrepancy

