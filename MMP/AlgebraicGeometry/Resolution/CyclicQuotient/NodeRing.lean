/-!
# Node-ring algebra and free modules over infinitesimal thickenings

Algebra of the node ring `K[x,y]/(xy)`, scaling of coordinates of the plane, and freeness of
invertible modules over nilpotent thickenings of domains; ideal-sheaf lemmas for the thickenings
of a chain of curves.

## Main definitions

* `scale`: the rescaling of the two coordinates of `𝔸²` by constants.
* `inclSections`: the comparison of sections of a thickening with those of a closed subscheme.
* `LevelEq`: the chart coordinates at level `n` generate the ideals of the exceptional curves.
* `LocalEquations`: the level-zero local data of a chain of curves.

## Main results

* `free_of_glue`: invertible modules over a ring glued from two principal ideal domains are free.
* `free_of_free_quot_nilpotent`: a finite projective module which is free modulo a nilpotent
  ideal is free.
* `ker_inclusion_app_eq_span`: the ideal of an effective Cartier divisor in a thickening is
  locally generated by the image of the canonical section.
* `node_alg`: a characterization of the node ring `K[x,y]/(xy)`.
* `end_alg0`, `end_alg1`: the analogous presentations of `K[X]` as a quotient of `K[x,y]`.
-/

open AlgebraicGeometry hiding PrimeDivisor
open CategoryTheory Opposite MMP.Mori

namespace MMP.Resolution.MarkedChain

universe u

@[expose] public section

/-- Restricting the image of a constant `k : K` in `Γ(S, U)` to `W ≤ U` gives the image of `k`
in `Γ(S, W)`. -/
theorem map_constants_restrict {K : Type u} [Field K] {S : Scheme.{u}}
    (g : S ⟶ Spec (.of K)) (U W : S.Opens) (h : W ≤ U) (k : K) :
    (S.presheaf.map (homOfLE h).op).hom
        (((Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ U (by simp)).hom k) =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ W (by simp)).hom k := by
  have := Scheme.Hom.appLE_map g (U := ⊤) (V := U) (by simp) (homOfLE h).op
  rw [← this]
  rfl

/-- For a morphism `i : A ⟶ B` over `Spec K`, the map on sections induced by `i` sends the image
of a constant `k : K` in `Γ(B, W)` to the image of `k` in `Γ(A, U)`. -/
theorem map_constants_hom {K : Type u} [Field K] {A B : Scheme.{u}}
    (f : A ⟶ Spec (.of K)) (g : B ⟶ Spec (.of K))
    (i : A ⟶ B) (hi : i ≫ g = f) (U : A.Opens) (W : B.Opens) (e : U ≤ i ⁻¹ᵁ W) (k : K) :
    (i.appLE W U e).hom (((Scheme.ΓSpecIso (.of K)).inv ≫ g.appLE ⊤ W (by simp)).hom k) =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ f.appLE ⊤ U (by simp)).hom k := by
  subst hi
  have := Scheme.Hom.appLE_comp_appLE i g ⊤ W U (by simp) e
  rw [← this]
  rfl

/-- Rescaling of the two coordinates of `𝔸²` by constants. -/
noncomputable def scale {K : Type u} [Field K] (a h : K) :
    MvPolynomial (Fin 2) K →+* MvPolynomial (Fin 2) K :=
  (MvPolynomial.aeval ![MvPolynomial.C a * MvPolynomial.X 0,
    MvPolynomial.C h * MvPolynomial.X 1] : MvPolynomial (Fin 2) K →ₐ[K] _).toRingHom

/-- `scale a h` sends the first coordinate `X 0` to `C a * X 0`. -/
theorem scale_X0 {K : Type u} [Field K] (a h : K) :
    scale a h (MvPolynomial.X 0) = MvPolynomial.C a * MvPolynomial.X 0 := by
  simp [scale]

/-- `scale a h` sends the second coordinate `X 1` to `C h * X 1`. -/
theorem scale_X1 {K : Type u} [Field K] (a h : K) :
    scale a h (MvPolynomial.X 1) = MvPolynomial.C h * MvPolynomial.X 1 := by
  simp [scale]

/-- `scale a h` fixes the constants. -/
theorem scale_C {K : Type u} [Field K] (a h k : K) :
    scale a h (MvPolynomial.C k) = MvPolynomial.C k := by
  simp [scale]

/-- `scale a⁻¹ h⁻¹` is a left inverse of `scale a h` when `a` and `h` are nonzero. -/
theorem scale_scale {K : Type u} [Field K] {a h : K} (ha : a ≠ 0) (hh : h ≠ 0)
    (z : MvPolynomial (Fin 2) K) : scale a⁻¹ h⁻¹ (scale a h z) = z := by
  have : (scale a⁻¹ h⁻¹).comp (scale a h) = RingHom.id _ := by
    refine MvPolynomial.ringHom_ext (fun k => ?_) (fun i => ?_)
    · simp [scale_C]
    · fin_cases i
      · show scale a⁻¹ h⁻¹ (scale a h (MvPolynomial.X 0)) = MvPolynomial.X 0
        rw [scale_X0, map_mul, scale_C, scale_X0, ← mul_assoc, ← map_mul,
          mul_inv_cancel₀ ha, map_one, one_mul]
      · show scale a⁻¹ h⁻¹ (scale a h (MvPolynomial.X 1)) = MvPolynomial.X 1
        rw [scale_X1, map_mul, scale_C, scale_X1, ← mul_assoc, ← map_mul,
          mul_inv_cancel₀ hh, map_one, one_mul]
  exact RingHom.congr_fun this z

/-- `scale a⁻¹ h⁻¹` is a right inverse of `scale a h` when `a` and `h` are nonzero. -/
theorem scale_scale' {K : Type u} [Field K] {a h : K} (ha : a ≠ 0) (hh : h ≠ 0)
    (z : MvPolynomial (Fin 2) K) : scale a h (scale a⁻¹ h⁻¹ z) = z := by
  simpa using scale_scale (inv_ne_zero ha) (inv_ne_zero hh) z

/-- The exceptional ideals of the model charts are generated by a monomial rescaled by a unit. -/
theorem scale_span_pow {K : Type u} [Field K] {a h : K} (ha : a ≠ 0) (hh : h ≠ 0)
    (p : MvPolynomial (Fin 2) K) (c c' : K)
    (h1 : scale a h p = MvPolynomial.C c * p) (h2 : scale a⁻¹ h⁻¹ p = MvPolynomial.C c' * p)
    (m : ℕ) :
    (Ideal.span {p} ^ m).comap (scale a h) = Ideal.span {p} ^ m := by
  rw [Ideal.span_singleton_pow]
  ext z
  simp only [Ideal.mem_comap, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨s, hs⟩
    refine ⟨scale a⁻¹ h⁻¹ s * (MvPolynomial.C c' ^ m), ?_⟩
    have := congrArg (scale a⁻¹ h⁻¹) hs
    rw [scale_scale ha hh, map_mul, map_pow, h2, mul_pow, ← map_pow] at this
    rw [← this, map_pow]
    ring
  · rintro ⟨s, rfl⟩
    refine ⟨scale a h s * (MvPolynomial.C c ^ m), ?_⟩
    rw [map_mul, map_pow, h1, mul_pow, ← map_pow]
    ring

/-- The powers of the exceptional ideal of the `j`-th model chart, `(y)`, `(x)` or `(xy)`, are
stable under the preimage by `scale a h` when `a` and `h` are nonzero. -/
theorem scale_exceptional_ideal {K : Type u} [Field K] {r : ℕ} {a h : K} (ha : a ≠ 0)
    (hh : h ≠ 0) (j : Fin (r + 1)) (m : ℕ) :
    ((if j = 0 then Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}
      else if j = Fin.last r then Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)}
      else Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}) ^ m).comap
        (scale a h) =
      (if j = 0 then Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}
      else if j = Fin.last r then Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)}
      else Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K)}) ^ m := by
  split_ifs
  · exact scale_span_pow ha hh _ h h⁻¹ (by rw [scale_X1]) (by rw [scale_X1]) m
  · exact scale_span_pow ha hh _ a a⁻¹ (by rw [scale_X0]) (by rw [scale_X0]) m
  · exact scale_span_pow ha hh _ (a * h) (a⁻¹ * h⁻¹)
      (by rw [map_mul, scale_X0, scale_X1, map_mul]; ring)
      (by rw [map_mul, scale_X0, scale_X1, map_mul]; ring) m

section

open Module
open scoped TensorProduct

variable {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]

/-- The `R ⧸ I`-linear isomorphism `(R ⧸ I) ⊗[R] M ≃ M ⧸ I • M`. -/
noncomputable def quotEquiv (I : Ideal R) :
    (R ⧸ I) ⊗[R] M ≃ₗ[R ⧸ I] M ⧸ (I • (⊤ : Submodule R M)) :=
  { TensorProduct.quotTensorEquivQuotSMul M I with
    map_smul' := fun a z => by
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
      have h1 : (Ideal.Quotient.mk I r) • z = r • z := rfl
      simp only [RingHom.id_apply]
      rw [h1]
      exact (TensorProduct.quotTensorEquivQuotSMul M I).map_smul r z }

/-- The reduction `M ⧸ I • M` of an invertible `R`-module `M` is an invertible `R ⧸ I`-module. -/
theorem invertible_quot' [Module.Invertible R M] (I : Ideal R) :
    Module.Invertible (R ⧸ I) (M ⧸ (I • (⊤ : Submodule R M))) :=
  Module.Invertible.congr (quotEquiv I)

/-- If `R ⧸ I` is a principal ideal domain, the reduction `M ⧸ I • M` of an invertible
`R`-module `M` is a free `R ⧸ I`-module. -/
theorem free_quot [Module.Invertible R M] (I : Ideal R) [IsDomain (R ⧸ I)]
    [IsPrincipalIdealRing (R ⧸ I)] :
    Module.Free (R ⧸ I) (M ⧸ (I • (⊤ : Submodule R M))) := by
  have := invertible_quot' (M := M) I
  infer_instance

/-- If `R ⧸ I` is a principal ideal domain, an invertible `R`-module `M` has an element `m` which
generates `M` modulo `I • M`. -/
theorem exists_generator_mod [Module.Invertible R M] (I : Ideal R) [IsDomain (R ⧸ I)]
    [IsPrincipalIdealRing (R ⧸ I)] :
    ∃ m : M, ∀ u : M, ∃ r : R, u - r • m ∈ I • (⊤ : Submodule R M) := by
  have := invertible_quot' (M := M) I
  obtain ⟨e⟩ := Module.Invertible.free_iff_linearEquiv.1 (free_quot (M := M) I)
  obtain ⟨m, hm⟩ := Submodule.Quotient.mk_surjective _ (e.symm 1)
  refine ⟨m, fun u => ?_⟩
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (e (Submodule.Quotient.mk u))
  refine ⟨r, ?_⟩
  have h : (Submodule.Quotient.mk u : M ⧸ (I • (⊤ : Submodule R M))) =
      (Ideal.Quotient.mk I r) • (e.symm 1) := by
    apply e.injective
    rw [map_smul, LinearEquiv.apply_symm_apply, ← hr]
    simp
  rw [← hm] at h
  exact (Submodule.Quotient.eq _).1 h

/-- If `I * J = ⊥`, every element of `I` annihilates `J • M`. -/
theorem annihilate_smul_smul (I J : Ideal R) (hIJ : I * J = ⊥) (α : R) (hα : α ∈ I)
    (t : M) (ht : t ∈ J • (⊤ : Submodule R M)) : α • t = 0 := by
  refine Submodule.smul_induction_on ht (fun β hβ n _ => ?_) (fun x y hx hy => ?_)
  · rw [smul_comm, ← mul_smul]
    have : α * β ∈ I * J := Ideal.mul_mem_mul hα hβ
    rw [hIJ] at this
    simp only [Ideal.mem_bot] at this
    rw [mul_comm, this, zero_smul]
  · rw [smul_add, hx, hy, add_zero]

/-- If `m₂` generates `M` modulo `J • M`, `m₂ - l • m₁ ∈ I • M` and `I ⊔ J ≠ ⊤`, then
`l ∉ I ⊔ J`. -/
theorem notMem_sup_of_generates_mod [Module.Invertible R M] (I J : Ideal R) (hne : I ⊔ J ≠ ⊤)
    {m₁ m₂ : M} (h₂ : ∀ u : M, ∃ r : R, u - r • m₂ ∈ J • (⊤ : Submodule R M)) {l : R}
    (hl : m₂ - l • m₁ ∈ I • (⊤ : Submodule R M)) : l ∉ I ⊔ J := by
  have hIJle : I • (⊤ : Submodule R M) ≤ (I ⊔ J) • (⊤ : Submodule R M) :=
    Submodule.smul_mono_left le_sup_left
  have hJIle : J • (⊤ : Submodule R M) ≤ (I ⊔ J) • (⊤ : Submodule R M) :=
    Submodule.smul_mono_left le_sup_right
  intro hmem
  have hall : ∀ u : M, u ∈ (I ⊔ J) • (⊤ : Submodule R M) := by
    intro u
    obtain ⟨r, hr⟩ := h₂ u
    have e : u = (u - r • m₂) + (r * l) • m₁ + r • (m₂ - l • m₁) := by
      rw [mul_smul, smul_sub]
      abel
    rw [e]
    refine add_mem (add_mem (hJIle hr) ?_) ?_
    · exact Submodule.smul_mem_smul (Ideal.mul_mem_left _ _ hmem) trivial
    · exact Submodule.smul_mem _ _ (hIJle hl)
  obtain ⟨t, ht, ht0⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
    (I ⊔ J) (⊤ : Submodule R M) Module.Finite.fg_top (fun u _ => hall u)
  have : t = 0 := FaithfulSMul.eq_of_smul_eq_smul (fun m => by rw [ht0 m trivial, zero_smul])
  subst this
  apply hne
  rw [Ideal.eq_top_iff_one]
  simpa using (Ideal.neg_mem_iff _).2 ht

/-- If `I * J = ⊥` and `m` generates `M` both modulo `I • M` and modulo `J • M`, then `m`
generates `M`. -/
theorem mem_span_singleton_of_generates_mod (I J : Ideal R) (hIJ : I * J = ⊥) (m : M)
    (hgenI : ∀ u : M, ∃ r : R, u - r • m ∈ I • (⊤ : Submodule R M))
    (hgenJ : ∀ u : M, ∃ r : R, u - r • m ∈ J • (⊤ : Submodule R M)) (u : M) :
    u ∈ Submodule.span R {m} := by
  obtain ⟨r, hr⟩ := hgenI u
  have hI : ∀ i ∈ I • (⊤ : Submodule R M), i ∈ Submodule.span R {m} := by
    intro i hi
    refine Submodule.smul_induction_on hi (fun α hα n _ => ?_) (fun x y hx hy => add_mem hx hy)
    obtain ⟨r', hr'⟩ := hgenJ n
    have e : α • n = (α * r') • m + α • (n - r' • m) := by
      rw [mul_smul, smul_sub]
      abel
    rw [e, annihilate_smul_smul I J hIJ α hα _ hr', add_zero]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m)
  have e : u = r • m + (u - r • m) := by abel
  rw [e]
  exact add_mem (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self m)) (hI _ hr)

/-- Let `I` and `J` be ideals of `R` with `I * J = ⊥`, such that `R ⧸ I` and `R ⧸ J` are principal
ideal domains, `I ⊔ J ≠ ⊤`, and every element outside `I ⊔ J` is congruent modulo `I ⊔ J` to a
unit. Then every invertible `R`-module is free. -/
theorem free_of_glue [Module.Invertible R M] (I J : Ideal R) (hIJ : I * J = ⊥)
    [IsDomain (R ⧸ I)] [IsPrincipalIdealRing (R ⧸ I)] [IsDomain (R ⧸ J)]
    [IsPrincipalIdealRing (R ⧸ J)] (hne : I ⊔ J ≠ ⊤)
    (hU : ∀ r : R, r ∉ I ⊔ J → ∃ s : Rˣ, (s : R) - r ∈ I ⊔ J) : Module.Free R M := by
  obtain ⟨m1, h1⟩ := exists_generator_mod (M := M) I
  obtain ⟨m2, h2⟩ := exists_generator_mod (M := M) J
  obtain ⟨l, hl⟩ := h1 m2
  have hIJle : I • (⊤ : Submodule R M) ≤ (I ⊔ J) • (⊤ : Submodule R M) :=
    Submodule.smul_mono_left le_sup_left
  obtain ⟨s, hs⟩ := hU l (notMem_sup_of_generates_mod I J hne h2 hl)
  set m2' : M := ((s⁻¹ : Rˣ) : R) • m2 with hm2'
  have hdiff : m2' - m1 ∈ I • (⊤ : Submodule R M) ⊔ J • (⊤ : Submodule R M) := by
    rw [← Submodule.sup_smul]
    have e : m2' - m1 = (((s⁻¹ : Rˣ) : R) * (l - s)) • m1 +
        ((s⁻¹ : Rˣ) : R) • (m2 - l • m1) := by
      have h3 : (((s⁻¹ : Rˣ) : R) * (l - s)) • m1 = ((s⁻¹ : Rˣ) : R) • l • m1 - m1 := by
        have : (((s⁻¹ : Rˣ) : R) * s) • m1 = m1 := by rw [Units.inv_mul, one_smul]
        rw [mul_sub, sub_smul, mul_smul ((s⁻¹ : Rˣ) : R) l, this]
      rw [h3, hm2', smul_sub]
      abel
    rw [e]
    refine add_mem ?_ ?_
    · refine Submodule.smul_mem_smul (Ideal.mul_mem_left _ _ ?_) trivial
      simpa using (I ⊔ J).neg_mem hs
    · exact hIJle (Submodule.smul_mem _ _ hl)
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.1 hdiff
  set m : M := m1 + a with hm
  have hgenI : ∀ u : M, ∃ r : R, u - r • m ∈ I • (⊤ : Submodule R M) := by
    intro u
    obtain ⟨r, hr⟩ := h1 u
    refine ⟨r, ?_⟩
    have e : u - r • m = (u - r • m1) - r • a := by
      rw [hm, smul_add]
      abel
    rw [e]
    exact sub_mem hr (Submodule.smul_mem _ _ ha)
  have hgenJ : ∀ u : M, ∃ r : R, u - r • m ∈ J • (⊤ : Submodule R M) := by
    intro u
    obtain ⟨r, hr⟩ := h2 u
    refine ⟨r * (s : R), ?_⟩
    have hm2 : m2 = (s : R) • m2' := by
      rw [hm2', ← mul_smul, Units.mul_inv, one_smul]
    have hmb : m = m2' - b := by
      have : m1 + a + b = m2' := by rw [add_assoc, hab]; abel
      exact eq_sub_of_add_eq this
    have h4 : (r * (s : R)) • m2' = r • m2 := by rw [mul_smul, ← hm2]
    have e : u - (r * (s : R)) • m = (u - r • m2) + (r * (s : R)) • b := by
      rw [hmb, smul_sub, h4]
      abel
    rw [e]
    exact add_mem hr (Submodule.smul_mem _ _ hb)
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton R M m) := by
    intro u
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.1
      (mem_span_singleton_of_generates_mod I J hIJ m hgenI hgenJ u)
    exact ⟨r, hr⟩
  exact Module.Free.of_equiv
    (LinearEquiv.ofBijective _ (Module.Invertible.bijective_of_surjective hsurj))

end

/-- If `K ≤ N • K`, then `K ≤ N ^ j • K` for every `j`. -/
theorem submodule_le_smul_pow {A : Type u} [CommRing A] (N : Ideal A) {M : Type u}
    [AddCommGroup M] [Module A M]
    (K : Submodule A M) (h : K ≤ N • K) (j : ℕ) : K ≤ (N ^ j) • K := by
  induction j with
  | zero => simp
  | succ j ih =>
    calc K ≤ N • K := h
      _ ≤ N • ((N ^ j) • K) := Submodule.smul_mono le_rfl ih
      _ = (N ^ (j + 1)) • K := by rw [smul_smul, pow_succ']

/-- A submodule `K` with `K ≤ N • K` for a nilpotent ideal `N` is zero. -/
theorem eq_bot_of_le_smul_nilpotent {A : Type u} [CommRing A] (N : Ideal A)
    (hN : ∃ k : ℕ, N ^ k = ⊥) {M : Type u} [AddCommGroup M] [Module A M] (K : Submodule A M)
    (h : K ≤ N • K) : K = ⊥ := by
  obtain ⟨k, hk⟩ := hN
  simpa [hk] using submodule_le_smul_pow N K h k

/-- A submodule `T` with `T ⊔ N • ⊤ = ⊤` for a nilpotent ideal `N` is the whole module. -/
theorem eq_top_of_sup_smul_nilpotent {A : Type u} [CommRing A] (N : Ideal A)
    (hN : ∃ k : ℕ, N ^ k = ⊥) {M : Type u} [AddCommGroup M] [Module A M] (T : Submodule A M)
    (h : T ⊔ N • (⊤ : Submodule A M) = ⊤) : T = ⊤ := by
  obtain ⟨k, hk⟩ := hN
  have key : ∀ j : ℕ, T ⊔ (N ^ j) • (⊤ : Submodule A M) = ⊤ := by
    intro j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [eq_top_iff]
      calc (⊤ : Submodule A M) = T ⊔ (N ^ j) • (⊤ : Submodule A M) := ih.symm
        _ ≤ T ⊔ (N ^ j) • (T ⊔ N • (⊤ : Submodule A M)) := by rw [h]
        _ ≤ T ⊔ (N ^ (j + 1)) • (⊤ : Submodule A M) := by
          rw [Submodule.smul_sup, smul_smul, ← pow_succ]
          refine sup_le le_sup_left (sup_le ?_ le_sup_right)
          exact le_trans Submodule.smul_le_right le_sup_left
  simpa [hk] using key k

/-- A surjection `f : P → M` onto a projective module whose kernel is contained in `N • P` for a
nilpotent ideal `N` is injective. -/
theorem injective_of_ker_le_smul_nilpotent {A : Type u} [CommRing A] (N : Ideal A)
    (hN : ∃ k : ℕ, N ^ k = ⊥) {P M : Type u} [AddCommGroup P] [Module A P] [AddCommGroup M]
    [Module A M] [Module.Projective A M] (f : P →ₗ[A] M) (hsurj : Function.Surjective f)
    (hker : LinearMap.ker f ≤ N • (⊤ : Submodule A P)) : Function.Injective f := by
  obtain ⟨sec, hsec⟩ := Module.projective_lifting_property f LinearMap.id hsurj
  let π : P →ₗ[A] P := LinearMap.id - sec ∘ₗ f
  have hπK : ∀ k ∈ LinearMap.ker f, π k = k := by
    intro k hk
    simp [π, LinearMap.mem_ker.1 hk]
  have hrange : LinearMap.ker f ≤ (N • (⊤ : Submodule A P)).map π :=
    fun k hk => ⟨k, hker hk, hπK k hk⟩
  have hmap : (N • (⊤ : Submodule A P)).map π = N • (LinearMap.ker f) := by
    rw [Submodule.map_smul'', Submodule.map_top]
    congr 1
    refine le_antisymm ?_ ?_
    · rintro _ ⟨x, rfl⟩
      have := LinearMap.congr_fun hsec (f x)
      simp only [LinearMap.comp_apply, LinearMap.id_apply] at this
      simp [π, this]
    · intro k hk
      exact ⟨k, hπK k hk⟩
  exact LinearMap.ker_eq_bot.1 (eq_bot_of_le_smul_nilpotent N hN _ (hmap ▸ hrange))

/-- A finitely generated projective module whose reduction modulo a nilpotent ideal is free is
free. -/
theorem free_of_free_quot_nilpotent {A : Type u} [CommRing A] (N : Ideal A)
    (hN : ∃ k : ℕ, N ^ k = ⊥) {M : Type u} [AddCommGroup M] [Module A M] [Module.Finite A M]
    [Module.Projective A M] {ι : Type u}
    (b : Module.Basis ι (A ⧸ N) (M ⧸ (N • (⊤ : Submodule A M)))) :
    Module.Free A M := by
  classical
  let q : M →ₗ[A] M ⧸ (N • (⊤ : Submodule A M)) := Submodule.mkQ _
  have hq : ∀ i, ∃ m : M, q m = b i := fun i => Submodule.mkQ_surjective _ (b i)
  choose e he using hq
  let f : (ι →₀ A) →ₗ[A] M := Finsupp.linearCombination A e
  let red : (ι →₀ A) →+ (ι →₀ (A ⧸ N)) :=
    Finsupp.mapRange.addMonoidHom (Ideal.Quotient.mk N).toAddMonoidHom
  have hred : ∀ a : ι →₀ A, q (f a) = b.repr.symm (red a) := by
    intro a
    induction a using Finsupp.induction_linear with
    | zero => simp [red]
    | add x y hx hy => simp only [map_add, hx, hy]
    | single i r =>
      simp only [f, Finsupp.linearCombination_single, map_smul, he]
      have : red (Finsupp.single i r) = Finsupp.single i (Ideal.Quotient.mk N r) := by
        simp [red]
      rw [this, Module.Basis.repr_symm_single]
      rfl
  have hred_surj : Function.Surjective red :=
    Finsupp.mapRange_surjective _ (map_zero _) Ideal.Quotient.mk_surjective
  have hsurj : Function.Surjective f := by
    refine LinearMap.range_eq_top.1 (eq_top_of_sup_smul_nilpotent N hN _ ?_)
    rw [eq_top_iff]
    intro m _
    obtain ⟨a', ha'⟩ := hred_surj (b.repr (q m))
    have hfa : q (f a') = q m := by
      rw [hred, ha']
      simp
    exact Submodule.mem_sup.2 ⟨f a', ⟨a', rfl⟩, m - f a',
      (Submodule.Quotient.eq (N • (⊤ : Submodule A M))).1 hfa.symm, by abel⟩
  have hker : LinearMap.ker f ≤ N • (⊤ : Submodule A (ι →₀ A)) := by
    intro k hk
    have h0 : b.repr.symm (red k) = 0 := by rw [← hred, LinearMap.mem_ker.1 hk, map_zero]
    have h1 : red k = 0 := (LinearEquiv.map_eq_zero_iff _).1 h0
    have hkN : ∀ i, k i ∈ N := fun i => by
      simpa [red, Ideal.Quotient.eq_zero_iff_mem] using congrArg (fun z => z i) h1
    have hk' : k = ∑ i ∈ k.support, Finsupp.single i (k i) := (Finsupp.sum_single k).symm
    rw [hk']
    refine Submodule.sum_mem _ fun i _ => ?_
    have : Finsupp.single i (k i) = (k i) • (Finsupp.single i (1 : A)) := by simp
    rw [this]
    exact Submodule.smul_mem_smul (hkN i) Submodule.mem_top
  exact Module.Free.of_equiv (LinearEquiv.ofBijective f
    ⟨injective_of_ker_le_smul_nilpotent N hN f hsurj hker, hsurj⟩)

/-- The comparison of the sections over `E_j` with the sections over the thickening, on the
trace of an open `U`. -/
noncomputable abbrev inclSections {Y : Scheme.{u}} {I Ej : Y.IdealSheafData} (hIE : I ≤ Ej)
    (U : Y.Opens) :
    Γ(I.subscheme, I.subschemeι ⁻¹ᵁ U) →+* Γ(Ej.subscheme, Ej.subschemeι ⁻¹ᵁ U) :=
  ((Scheme.IdealSheafData.inclusion hIE).appLE (I.subschemeι ⁻¹ᵁ U) (Ej.subschemeι ⁻¹ᵁ U) (by
    rw [← Scheme.Hom.comp_preimage, Scheme.IdealSheafData.inclusion_subschemeι])).hom

/-- The product of a finite family of ideal sheaves is contained in each factor. -/
theorem prod_le' {X : Scheme.{u}} {r : ℕ} (E : Fin r → X.IdealSheafData) (j : Fin r) :
    (∏ i, E i) ≤ E j := by
  rw [← Finset.mul_prod_erase Finset.univ E (Finset.mem_univ j)]
  exact mul_le_of_le_one_right' le_top

/-- If `N` is a nilpotent ideal of `R` and every invertible `R ⧸ N`-module is free, then every
invertible `R`-module `M` has an element `t` such that `r ↦ r • t` is a bijection `R ≃ M`. -/
theorem exists_bijective_smul_of_free_quot {R : Type u} [CommRing R] (N : Ideal R)
    (hN : ∃ k : ℕ, N ^ k = ⊥)
    (hfree : ∀ (M' : Type u) [AddCommGroup M'] [Module (R ⧸ N) M'] [Module.Invertible (R ⧸ N) M'],
      Module.Free (R ⧸ N) M')
    {M : Type u} [AddCommGroup M] [Module R M] [Module.Invertible R M] :
    ∃ t : M, Function.Bijective fun r : R => r • t := by
  classical
  haveI : Module.Invertible (R ⧸ N) (M ⧸ (N • (⊤ : Submodule R M))) := invertible_quot' N
  haveI := hfree (M ⧸ (N • (⊤ : Submodule R M)))
  haveI : Module.Free R M := free_of_free_quot_nilpotent N hN
    (Module.Free.chooseBasis (R ⧸ N) (M ⧸ (N • (⊤ : Submodule R M))))
  rcases subsingleton_or_nontrivial R with hR | hR
  · refine ⟨0, fun a b _ => Subsingleton.elim a b, fun m => ⟨0, ?_⟩⟩
    have : Subsingleton M := Module.subsingleton R M
    exact Subsingleton.elim _ _
  have hr := Module.Invertible.rank_eq_one R M
  let b := Module.Free.chooseBasis R M
  have h1 : Cardinal.mk (Module.Free.ChooseBasisIndex R M) = 1 := by
    rw [← Module.Free.rank_eq_card_chooseBasisIndex, hr]
  obtain ⟨_, ⟨i⟩⟩ := Cardinal.eq_one_iff_unique.1 h1
  haveI : Unique (Module.Free.ChooseBasisIndex R M) := uniqueOfSubsingleton i
  have hsingle : ∀ m : M, b.repr m = Finsupp.single i (b.repr m i) := fun m => by
    rw [Subsingleton.elim i default]
    exact Finsupp.unique_single (b.repr m)
  refine ⟨b i, ?_, ?_⟩
  · exact fun r r' h => by simpa using congrArg (fun m => b.repr m i) h
  · intro m
    refine ⟨b.repr m i, ?_⟩
    simp only
    conv_rhs => rw [← b.linearCombination_repr m, hsingle m]
    simp

/-- Let `M` be an invertible quasi-coherent module on `Z` and `U` an affine open. If `Γ(Z, U)` has
a nilpotent ideal `N` such that every invertible `Γ(Z, U) ⧸ N`-module is free, then `M` admits a
generating section over `U`. -/
theorem nonempty_generatorSections_of_free_quot {Z : Scheme.{u}} (M : Z.Modules)
    [M.IsQuasicoherent]
    [Stacks.SheafOfModules.IsInvertible Z.presheaf (structureSheafRing Z.toRingedSpace).property M]
    {U : Z.Opens} (hU : IsAffineOpen U) (N : Ideal Γ(Z, U)) (hN : ∃ k : ℕ, N ^ k = ⊥)
    (hfree : ∀ (M' : Type u) [AddCommGroup M'] [Module (Γ(Z, U) ⧸ N) M']
      [Module.Invertible (Γ(Z, U) ⧸ N) M'], Module.Free (Γ(Z, U) ⧸ N) M') :
    Nonempty (Stacks.SheafOfModules.GeneratorSections Z.toRingedSpace M U) := by
  haveI : Module.Invertible Γ(Z, U) Γ(M, U) :=
    (Stacks.Discriminant.isInvertible_iff_forall_module_invertible M).1 inferInstance ⟨U, hU⟩
  obtain ⟨t, ht⟩ := exists_bijective_smul_of_free_quot N hN hfree (M := Γ(M, U))
  exact ⟨Stacks.PicSurjectiveOpen.generatorSectionsOfBijectiveSmul M hU t ht⟩

section

open MvPolynomial

/-- If `J` is `(X v)` or `(X u * X v)` and `p * X v ∈ J ^ 2`, then `p ∈ J`. -/
theorem mul_mem_sq_imp_mem {K : Type u} [Field K] {u v : Fin 2}
    {J : Ideal (MvPolynomial (Fin 2) K)}
    (hJ : J = Ideal.span {X v} ∨ J = Ideal.span {X u * X v}) (p : MvPolynomial (Fin 2) K)
    (h : p * X v ∈ J ^ 2) : p ∈ J := by
  have hv : (X v : MvPolynomial (Fin 2) K) ≠ 0 := X_prime.ne_zero
  rcases hJ with rfl | rfl
  · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h
    obtain ⟨q, hq⟩ := h
    have : p = X v * q := by
      apply mul_right_cancel₀ hv
      rw [hq]
      ring
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  · rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h
    obtain ⟨q, hq⟩ := h
    have : p = X u * X v * (X u * q) := by
      apply mul_right_cancel₀ hv
      rw [hq]
      ring
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

/-- Let `J` be `(X v)` or `(X u * X v)`, let `φ1` be surjective with kernel `J ^ 2` and `φ0` have
kernel `J`, with `ρ.comp φ1 = φ0`. Then every `z` annihilated by `φ1 (X v)` lies in the kernel
of `ρ`. -/
theorem hann_chart {K : Type u} [Field K] {u v : Fin 2} {J : Ideal (MvPolynomial (Fin 2) K)}
    (hJ : J = Ideal.span {X v} ∨ J = Ideal.span {X u * X v})
    {A1 A0 : Type u} [CommRing A1] [CommRing A0]
    (φ1 : MvPolynomial (Fin 2) K →+* A1) (φ0 : MvPolynomial (Fin 2) K →+* A0) (ρ : A1 →+* A0)
    (hρ : ρ.comp φ1 = φ0) (hs1 : Function.Surjective φ1) (hk1 : RingHom.ker φ1 = J ^ 2)
    (hk0 : RingHom.ker φ0 = J) (z : A1) (hz : z * φ1 (X v) = 0) : ρ z = 0 := by
  obtain ⟨p, rfl⟩ := hs1 z
  have h1 : p * X v ∈ J ^ 2 := by rwa [← hk1, RingHom.mem_ker, map_mul]
  have h2 : p ∈ RingHom.ker φ0 := by
    rw [hk0]
    exact mul_mem_sq_imp_mem hJ p h1
  exact (RingHom.congr_fun hρ p).trans (RingHom.mem_ker.1 h2)

end

/-- The `(n + 1)`-st power of the product of the ideal sheaves of the `E i` is contained in the
ideal sheaf of each `E j`. -/
theorem pow_le_divisor {X : Scheme.{u}} {r : ℕ} (E : Fin r → PrimeDivisor X) (n : ℕ)
    (j : Fin r) : (∏ i, (E i).idealSheaf) ^ (n + 1) ≤ (E j).idealSheaf :=
  (pow_le_pow_right_of_le_one' le_top (by omega : 0 + 1 ≤ n + 1) :
    (∏ i, (E i).idealSheaf) ^ (n + 1) ≤ (∏ i, (E i).idealSheaf) ^ (0 + 1)).trans
    (by rw [zero_add, pow_one]; exact prod_le' (fun i => (E i).idealSheaf) j)

/-- The coordinates of the charts at level `n` generate the ideals of the exceptional curves: on
the chart `V j.castSucc` the ideal of `E_j` in the thickening is `(y)`, on `V j.succ` it is `(x)`.
-/
def LevelEq {X : Scheme.{u}} {r : ℕ}
    (E : Fin r → PrimeDivisor X) (V : Fin (r + 1) → X.Opens) (n : ℕ)
    (x y : ∀ j, Γ(((∏ i, (E i).idealSheaf) ^ (n + 1)).subscheme,
      ((∏ i, (E i).idealSheaf) ^ (n + 1)).subschemeι ⁻¹ᵁ (V j))) : Prop :=
  ∀ j : Fin r,
    RingHom.ker (inclSections (pow_le_divisor E n j) (V j.castSucc)) = Ideal.span {y j.castSucc} ∧
      RingHom.ker (inclSections (pow_le_divisor E n j) (V j.succ)) = Ideal.span {x j.succ}

/-- The level-zero local data: the traces of the charts cover the support of each `E_j`, and the
level-zero coordinates generate the ideals of the exceptional curves. -/
def LocalEquations {X : Scheme.{u}} {r : ℕ}
    (E : Fin r → PrimeDivisor X) (V : Fin (r + 1) → X.Opens)
    (x0 y0 : ∀ j, Γ(((∏ i, (E i).idealSheaf) ^ (0 + 1)).subscheme,
      ((∏ i, (E i).idealSheaf) ^ (0 + 1)).subschemeι ⁻¹ᵁ (V j))) : Prop :=
  (∀ j : Fin r,
    ((E j).idealSheaf.support : Set X) ⊆ (V j.castSucc : Set X) ∪ (V j.succ : Set X)) ∧
  LevelEq E V 0 x0 y0 ∧
  (∀ (c : Fin (r + 1)) (k : Fin r), k.castSucc ≠ c → k.succ ≠ c →
    ∀ y ∈ V c, y ∉ ((E k).idealSheaf.support : Set X))

/-- If `I ≤ Ej` and the trace of `U` on the subscheme of `I` is affine, then so is its trace on
the subscheme of `Ej`. -/
theorem isAffineOpen_of_closedImmersion_affine {Y : Scheme.{u}} {I Ej : Y.IdealSheafData}
    (hIE : I ≤ Ej) (U : Y.Opens) (hU : IsAffineOpen (I.subschemeι ⁻¹ᵁ U)) :
    IsAffineOpen (Ej.subschemeι ⁻¹ᵁ U) := by
  have hpre : (Scheme.IdealSheafData.inclusion hIE) ⁻¹ᵁ (I.subschemeι ⁻¹ᵁ U) =
      Ej.subschemeι ⁻¹ᵁ U := by
    rw [← Scheme.Hom.comp_preimage, Scheme.IdealSheafData.inclusion_subschemeι]
  rw [← hpre]
  exact hU.preimage _

/-- If `I ≤ Ej` and the trace of `U` on the subscheme of `I` is affine, then `inclSections hIE U`
is surjective. -/
theorem inclSections_surjective {Y : Scheme.{u}} {I Ej : Y.IdealSheafData} (hIE : I ≤ Ej)
    (U : Y.Opens) (hU : IsAffineOpen (I.subschemeι ⁻¹ᵁ U)) :
    Function.Surjective (inclSections hIE U) := by
  have hpre : (Scheme.IdealSheafData.inclusion hIE) ⁻¹ᵁ (I.subschemeι ⁻¹ᵁ U) =
      Ej.subschemeι ⁻¹ᵁ U := by
    rw [← Scheme.Hom.comp_preimage, Scheme.IdealSheafData.inclusion_subschemeι]
  have h := Scheme.Hom.app_surjective (Scheme.IdealSheafData.inclusion hIE) _ hU
  have key : ∀ (V : (Ej.subscheme).Opens)
      (hV : (Scheme.IdealSheafData.inclusion hIE) ⁻¹ᵁ (I.subschemeι ⁻¹ᵁ U) = V)
      (e : V ≤ (Scheme.IdealSheafData.inclusion hIE) ⁻¹ᵁ (I.subschemeι ⁻¹ᵁ U)),
      Function.Surjective
        ((Scheme.IdealSheafData.inclusion hIE).appLE (I.subschemeι ⁻¹ᵁ U) V e).hom := by
    intro V hV e
    subst hV
    rw [Scheme.Hom.appLE_eq_app]
    exact h
  exact key _ hpre _

/-- If `I' ≤ I` have the same support, the closed immersion of the subscheme of `I` into that of
`I'` is surjective. -/
theorem surjective_inclusion {Y : Scheme.{u}} {I I' : Y.IdealSheafData} (h : I' ≤ I)
    (hs : I'.support = I.support) : Surjective (Scheme.IdealSheafData.inclusion h) := by
  refine ⟨fun y => ?_⟩
  have : I'.subschemeι y ∈ (I.support : Set Y) := by
    rw [← hs, ← I'.range_subschemeι]
    exact ⟨y, rfl⟩
  rw [← I.range_subschemeι] at this
  obtain ⟨x, hx⟩ := this
  refine ⟨x, ?_⟩
  have h1 : I'.subschemeι (Scheme.IdealSheafData.inclusion h x) = I.subschemeι x := by
    rw [← Scheme.Hom.comp_apply, Scheme.IdealSheafData.inclusion_subschemeι]
  exact I'.subschemeι.isEmbedding.injective (h1.trans hx)

/-- On a locally noetherian scheme, if `I' ≤ I` have the same support and the trace of `V` on the
subscheme of `I` is affine, then so is its trace on the subscheme of `I'`. -/
theorem isAffineOpen_thickening {Y : Scheme.{u}} [IsLocallyNoetherian Y]
    {I I' : Y.IdealSheafData} (h : I' ≤ I) (hs : I'.support = I.support) (V : Y.Opens)
    (hV : IsAffineOpen (I.subschemeι ⁻¹ᵁ V)) : IsAffineOpen (I'.subschemeι ⁻¹ᵁ V) := by
  have hpre : (Scheme.IdealSheafData.inclusion h) ⁻¹ᵁ (I'.subschemeι ⁻¹ᵁ V) =
      I.subschemeι ⁻¹ᵁ V := by
    rw [← Scheme.Hom.comp_preimage, Scheme.IdealSheafData.inclusion_subschemeι]
  have hsurj := surjective_inclusion h hs
  let f := Scheme.IdealSheafData.inclusion h
  let U := I'.subschemeι ⁻¹ᵁ V
  have : IsAffine (f ⁻¹ᵁ U) := by
    rw [hpre]
    exact hV
  have hLN : IsLocallyNoetherian I'.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian I'.subschemeι
  have hLN' : IsLocallyNoetherian U := inferInstance
  haveI : IsNoetherian U := by
    have hc : CompactSpace U := by
      have hsU : Function.Surjective (f ∣_ U) := (inferInstance : Surjective (f ∣_ U)).surj
      exact Function.Surjective.compactSpace (f ∣_ U).continuous hsU
    exact { __ := hLN' }
  exact Stacks.AlgebraicGeometry.Tag01YQClauseThree.isAffine_of_isFinite_surjective (f ∣_ U)

/-- On a locally noetherian scheme, if the trace of `V` on the subscheme of `I` is affine, then so
is its trace on the subscheme of `I ^ (n + 1)`. -/
theorem isAffineOpen_tr_pow {Y : Scheme.{u}} [IsLocallyNoetherian Y] (I : Y.IdealSheafData)
    (n : ℕ) (V : Y.Opens) (hV : IsAffineOpen ((I ^ (0 + 1)).subschemeι ⁻¹ᵁ V)) :
    IsAffineOpen ((I ^ (n + 1)).subschemeι ⁻¹ᵁ V) :=
  isAffineOpen_thickening (pow_le_pow_right_of_le_one' le_top (by omega : 0 + 1 ≤ n + 1))
    ((I.support_pow_succ n).trans (I.support_pow_succ 0).symm) V hV

section

open CategoryTheory.Limits

/-- For `I₂ ≤ D`, the pullback of `D` to the subscheme of `I₂` is the kernel of the closed
immersion of the subscheme of `D` into that of `I₂`. -/
theorem comap_eq_ker_inclusion {X : Scheme.{u}} (D I₂ : X.IdealSheafData) (h : I₂ ≤ D) :
    D.comap I₂.subschemeι = (Scheme.IdealSheafData.inclusion h).ker := by
  have hc : Scheme.IdealSheafData.inclusion h ≫ I₂.subschemeι =
      𝟙 D.subscheme ≫ D.subschemeι := by
    rw [Scheme.IdealSheafData.inclusion_subschemeι, Category.id_comp]
  let l : D.subscheme ⟶ pullback I₂.subschemeι D.subschemeι := pullback.lift _ _ hc
  have h1 : l ≫ pullback.fst _ _ = Scheme.IdealSheafData.inclusion h := by simp [l]
  have h2 : pullback.snd I₂.subschemeι D.subschemeι ≫ Scheme.IdealSheafData.inclusion h =
      pullback.fst I₂.subschemeι D.subschemeι := by
    rw [← cancel_mono I₂.subschemeι, Category.assoc, Scheme.IdealSheafData.inclusion_subschemeι,
      pullback.condition]
  apply le_antisymm
  · change (pullback.fst I₂.subschemeι D.subschemeι).ker ≤ _
    rw [← h1]
    exact Scheme.Hom.le_ker_comp _ _
  · change _ ≤ (pullback.fst I₂.subschemeι D.subschemeι).ker
    rw [← h2]
    exact Scheme.Hom.le_ker_comp _ _

/-- Let `D` be an effective Cartier divisor and `I₂ ≤ D`. On an affine open `U` of the subscheme of
`I₂`, if a trivialization `e` of the pullback of `𝒪(D)` sends the canonical section to `a`, then
the kernel of the restriction of sections to the subscheme of `D` is `(a)`. -/
theorem ker_inclusion_app_eq_span {X : Scheme.{u}} (D : X.IdealSheafData)
    [Stacks.Divisors.IsEffectiveCartierDivisor D]
    (I₂ : X.IdealSheafData) (h : I₂ ≤ D) (U : I₂.subscheme.affineOpens)
    (e : Γ((Scheme.Modules.pullback I₂.subschemeι).obj
      (Stacks.Divisors.modulesInvertibleSheaf D), U.1) ≃ₗ[Γ(I₂.subscheme, U.1)]
        Γ(I₂.subscheme, U.1))
    (a : Γ(I₂.subscheme, U.1))
    (he : e (((Scheme.Modules.pullback I₂.subschemeι).obj
      (Stacks.Divisors.modulesInvertibleSheaf D)).presheaf.map (homOfLE le_top).op
        (pullbackGlobalSections I₂.subschemeι (Stacks.Divisors.modulesInvertibleSheaf D)
          (Stacks.Divisors.canonicalSection D))) = a) :
    RingHom.ker ((Scheme.IdealSheafData.inclusion h).app U.1).hom = Ideal.span {a} := by
  have hz := Stacks.Divisors.zeroScheme_ideal_of_trivialization I₂.subscheme
    ((Scheme.Modules.pullback I₂.subschemeι).obj (Stacks.Divisors.modulesInvertibleSheaf D))
    (pullbackGlobalSections I₂.subschemeι (Stacks.Divisors.modulesInvertibleSheaf D)
      (Stacks.Divisors.canonicalSection D)) U e a he
  have hzp := Stacks.Divisors.zeroScheme_pullback I₂.subschemeι
    (Stacks.Divisors.modulesInvertibleSheaf D) (Stacks.Divisors.canonicalSection D)
  have hcz : Stacks.Divisors.zeroScheme X (Stacks.Divisors.modulesInvertibleSheaf D)
      (Stacks.Divisors.canonicalSection D) = D := Stacks.Divisors.zeroScheme_canonicalSection' D
  rw [hzp, hcz, comap_eq_ker_inclusion D I₂ h] at hz
  rw [← hz, Scheme.Hom.ker_apply]

end

section NodeRingAlgebra

open Polynomial

/-- A polynomial in `x, y` vanishing under `x ↦ 0, y ↦ X` lies in the ideal `(x)`. -/
theorem mem_span_X0_of_eval {K : Type u} [Field K] (f : MvPolynomial (Fin 2) K)
    (h : MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![0, Polynomial.X] f = 0) :
    f ∈ Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)} := by
  have : ({MvPolynomial.X 0} : Set (MvPolynomial (Fin 2) K)) =
      MvPolynomial.X '' ({0} : Set (Fin 2)) := by simp
  rw [this, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra hcon
  push Not at hcon
  have hmi : m 0 = 0 := by simpa using hcon 0 (by simp)
  have hsum :
      (MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![0, Polynomial.X] f).coeff (m 1) =
        f.coeff m := by
    rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_eq', Polynomial.finset_sum_coeff,
      Finset.sum_eq_single m]
    · simp [Fin.prod_univ_two, hmi, Polynomial.coeff_C_mul]
    · intro m' _ hne
      by_cases h0 : m' 0 = 0
      · have h1 : m' 1 ≠ m 1 := by
          intro h1
          apply hne
          ext i
          fin_cases i <;> simp [h0, h1, hmi]
        simp [Fin.prod_univ_two, h0, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        exact fun h => absurd h.symm h1
      · simp [Fin.prod_univ_two, h0, zero_pow h0]
    · intro hnot
      rw [MvPolynomial.notMem_support_iff] at hnot
      simp [hnot]
  rw [h] at hsum
  rw [MvPolynomial.mem_support_iff] at hm
  exact hm (by rw [← hsum]; simp)

/-- A polynomial in `x, y` vanishing under `x ↦ X, y ↦ 0` lies in the ideal `(y)`. -/
theorem mem_span_X1_of_eval {K : Type u} [Field K] (f : MvPolynomial (Fin 2) K)
    (h : MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0] f = 0) :
    f ∈ Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)} := by
  have : ({MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) K)) =
      MvPolynomial.X '' ({1} : Set (Fin 2)) := by simp
  rw [this, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra hcon
  push Not at hcon
  have hmi : m 1 = 0 := by simpa using hcon 1 (by simp)
  have hsum :
      (MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0] f).coeff (m 0) =
        f.coeff m := by
    rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_eq', Polynomial.finset_sum_coeff,
      Finset.sum_eq_single m]
    · simp [Fin.prod_univ_two, hmi, Polynomial.coeff_C_mul]
    · intro m' _ hne
      by_cases h0 : m' 1 = 0
      · have h1 : m' 0 ≠ m 0 := by
          intro h1
          apply hne
          ext i
          fin_cases i <;> simp [h0, h1, hmi]
        simp [Fin.prod_univ_two, h0, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        exact fun h => absurd h.symm h1
      · simp [Fin.prod_univ_two, h0, zero_pow h0]
    · intro hnot
      rw [MvPolynomial.notMem_support_iff] at hnot
      simp [hnot]
  rw [h] at hsum
  rw [MvPolynomial.mem_support_iff] at hm
  exact hm (by rw [← hsum]; simp)

/-- A polynomial in `x, y` vanishing under both `x ↦ 0, y ↦ X` and `x ↦ X, y ↦ 0` lies in the
ideal `(xy)`. -/
theorem mem_span_mul_of_eval {K : Type u} [Field K] (f : MvPolynomial (Fin 2) K)
    (h0 : MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![0, Polynomial.X] f = 0)
    (h1 : MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0] f = 0) :
    f ∈ Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K)} := by
  obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.1 (mem_span_X0_of_eval f h0)
  rw [map_mul] at h1
  have hX : (MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0]
      (MvPolynomial.X 0 : MvPolynomial (Fin 2) K)) = Polynomial.X := by simp
  rw [hX] at h1
  have hg : MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0] g = 0 :=
    (mul_eq_zero.1 h1).resolve_right Polynomial.X_ne_zero
  obtain ⟨h', rfl⟩ := Ideal.mem_span_singleton'.1 (mem_span_X1_of_eval g hg)
  exact Ideal.mem_span_singleton'.2 ⟨h', by ring⟩

/-- A ring homomorphism `K[X] → K` fixing the constants is evaluation at the image of `X`. -/
theorem eq_evalRingHom_of_map_C {K : Type*} [CommRing K] (φ : K[X] →+* K)
    (hφ : ∀ c, φ (Polynomial.C c) = c) : φ = Polynomial.evalRingHom (φ Polynomial.X) :=
  Polynomial.ringHom_ext (fun c => by simp [hφ]) (by simp)

/-- Substituting `X + C c` after `(x, y) ↦ (0, X - C c)` gives `(x, y) ↦ (0, X)`. -/
theorem comp_eval₂Hom_zero_X_sub_C {K : Type*} [CommRing K] (c : K) :
    (Polynomial.eval₂RingHom Polynomial.C (Polynomial.X + Polynomial.C c)).comp
        (MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![0, Polynomial.X - Polynomial.C c]) =
      MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![0, Polynomial.X] :=
  MvPolynomial.ringHom_ext (fun _ => by simp) (fun i => by fin_cases i <;> simp)

/-- Substituting `X + C c` after `(x, y) ↦ (X - C c, 0)` gives `(x, y) ↦ (X, 0)`. -/
theorem comp_eval₂Hom_X_sub_C_zero {K : Type*} [CommRing K] (c : K) :
    (Polynomial.eval₂RingHom Polynomial.C (Polynomial.X + Polynomial.C c)).comp
        (MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X - Polynomial.C c, 0]) =
      MvPolynomial.eval₂Hom (Polynomial.C : K →+* K[X]) ![Polynomial.X, 0] :=
  MvPolynomial.ringHom_ext (fun _ => by simp) (fun i => by fin_cases i <;> simp)

/-- Let `A` be a `K`-algebra with surjections `πa`, `πb` whose kernels meet in `⊥`, where the
target of `πb` is `K[X]`, and an augmentation `ε : A → K` whose kernel is `ker πa ⊔ ker πb`. Then
`ker πa` is generated by an element `x` with `πb x` corresponding to `X - C c0` for some `c0`. -/
theorem gen_of_inf {K A Pa Pb : Type u} [Field K] [CommRing A] [CommRing Pa] [CommRing Pb]
    (σ : K →+* A) (πa : A →+* Pa) (πb : A →+* Pb)
    (hπb : Function.Surjective πb)
    (eb : Pb ≃+* K[X])
    (heb : ∀ c, eb (πb (σ c)) = Polynomial.C c)
    (hinf : RingHom.ker πa ⊓ RingHom.ker πb = ⊥)
    (ε : A →+* K) (hε : ∀ c, ε (σ c) = c)
    (hker : RingHom.ker ε = RingHom.ker πa ⊔ RingHom.ker πb) :
    ∃ x : A, RingHom.ker πa = Ideal.span {x} ∧
      ∃ c0 : K, eb (πb x) = Polynomial.X - Polynomial.C c0 := by
  have hle : RingHom.ker πb ≤ RingHom.ker ε := by rw [hker]; exact le_sup_right
  let εb : Pb →+* K := RingHom.liftOfSurjective πb hπb ⟨ε, hle⟩
  have hεb : ∀ w, εb (πb w) = ε w := fun w => RingHom.liftOfRightInverse_comp_apply _ _ _ _ w
  let φ : K[X] →+* K := εb.comp eb.symm.toRingHom
  have hφC : ∀ c, φ (Polynomial.C c) = c := by
    intro c
    have : eb.symm (Polynomial.C c) = πb (σ c) := by rw [← heb c]; simp
    simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, this, hεb, hε]
  set c0 := φ Polynomial.X with hc0
  have hφ : ∀ p : K[X], φ p = p.eval c0 := by
    intro p
    rw [eq_evalRingHom_of_map_C φ hφC]
    rfl
  obtain ⟨w, hw⟩ := hπb (eb.symm (Polynomial.X - Polynomial.C c0))
  have hεw : ε w = 0 := by
    rw [← hεb, hw]
    have := hφ (Polynomial.X - Polynomial.C c0)
    simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at this
    rw [this]
    simp
  have hw' : w ∈ RingHom.ker πa ⊔ RingHom.ker πb := by rw [← hker]; exact hεw
  obtain ⟨a, ha, b', hb', hab⟩ := Submodule.mem_sup.1 hw'
  have hxa : πb a = πb w := by
    rw [← hab, map_add, (RingHom.mem_ker.1 hb'), add_zero]
  refine ⟨a, le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).2 ha), c0, ?_⟩
  · intro z hz
    have hzε : ε z = 0 := by
      rw [← RingHom.mem_ker, hker]
      exact Ideal.mem_sup_left hz
    have h1 : φ (eb (πb z)) = 0 := by
      simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
        RingEquiv.symm_apply_apply, hεb, hzε]
    rw [hφ, ← Polynomial.IsRoot.def, Polynomial.dvd_iff_isRoot.symm] at h1
    obtain ⟨f, hf⟩ := h1
    obtain ⟨w', hw''⟩ := hπb (eb.symm f)
    have hz2 : z - w' * a ∈ RingHom.ker πa ⊓ RingHom.ker πb := by
      refine ⟨Ideal.sub_mem _ hz (Ideal.mul_mem_left _ _ ha), ?_⟩
      show z - w' * a ∈ RingHom.ker πb
      rw [RingHom.mem_ker, map_sub, map_mul, hxa, hw, hw'']
      apply eb.injective
      rw [map_sub, map_mul, hf]
      simp
      ring
    rw [hinf] at hz2
    rw [sub_eq_zero.1 ((Submodule.mem_bot A).1 hz2)]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self a)
  · rw [hxa, hw]
    simp

/-- If `πa` is a surjection onto `K[X]` sending `y` to `X - C d0`, every element of `A` is
congruent modulo `ker πa` to a polynomial in `y` with coefficients in `K`. -/
theorem polyCoeff_surj {K A Pa : Type u} [Field K] [CommRing A] [CommRing Pa]
    (σ : K →+* A) (πa : A →+* Pa) (hπa : Function.Surjective πa) (ea : Pa ≃+* K[X])
    (hea : ∀ c, ea (πa (σ c)) = Polynomial.C c) (y : A) (d0 : K)
    (hy : ea (πa y) = Polynomial.X - Polynomial.C d0) (a : A) :
    ∃ p : K[X], a - Polynomial.eval₂ σ y p ∈ RingHom.ker πa := by
  let P := ea (πa a)
  refine ⟨P.comp (Polynomial.X + Polynomial.C d0), ?_⟩
  show πa (a - _) = 0
  apply ea.injective
  rw [map_zero, map_sub]
  have key : ea (πa (Polynomial.eval₂ σ y (P.comp (Polynomial.X + Polynomial.C d0)))) = P := by
    have : (ea.toRingHom.comp πa).comp (Polynomial.eval₂RingHom σ y) =
        Polynomial.eval₂RingHom Polynomial.C (Polynomial.X - Polynomial.C d0) := by
      refine Polynomial.ringHom_ext (fun c => ?_) ?_
      · simp [hea]
      · simp [hy]
    have h2 := congrArg (fun F => F (P.comp (Polynomial.X + Polynomial.C d0))) this
    simp only [RingHom.comp_apply, Polynomial.coe_eval₂RingHom, RingEquiv.toRingHom_eq_coe,
      RingHom.coe_coe] at h2
    rw [h2]
    show (P.comp (Polynomial.X + Polynomial.C d0)).comp (Polynomial.X - Polynomial.C d0) = P
    rw [Polynomial.comp_assoc]
    simp
  rw [map_sub, key]
  exact sub_self _

/-- A `K`-algebra `A` with surjections onto two copies of `K[X]` whose kernels meet in `⊥`, and an
augmentation whose kernel is the sum of these kernels, is the node ring: there are `x` and `y`
generating the two kernels such that `(x, y)` induces `K[x, y] ⧸ (xy) ≃ A`. -/
theorem node_alg {K A Pa Pb : Type u} [Field K] [CommRing A] [CommRing Pa] [CommRing Pb]
    (σ : K →+* A) (πa : A →+* Pa) (πb : A →+* Pb)
    (hπa : Function.Surjective πa) (hπb : Function.Surjective πb)
    (ea : Pa ≃+* K[X]) (eb : Pb ≃+* K[X])
    (hea : ∀ c, ea (πa (σ c)) = Polynomial.C c) (heb : ∀ c, eb (πb (σ c)) = Polynomial.C c)
    (hinf : RingHom.ker πa ⊓ RingHom.ker πb = ⊥)
    (ε : A →+* K) (hε : ∀ c, ε (σ c) = c)
    (hker : RingHom.ker ε = RingHom.ker πa ⊔ RingHom.ker πb) :
    ∃ x y : A, RingHom.ker πa = Ideal.span {x} ∧ RingHom.ker πb = Ideal.span {y} ∧
      Function.Surjective (MvPolynomial.eval₂Hom σ ![x, y]) ∧
      RingHom.ker (MvPolynomial.eval₂Hom σ ![x, y]) =
        Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K)} := by
  obtain ⟨x, hx, c0, hxc⟩ := gen_of_inf σ πa πb hπb eb heb hinf ε hε hker
  obtain ⟨y, hy, d0, hyd⟩ := gen_of_inf σ πb πa hπa ea hea (by rw [inf_comm]; exact hinf) ε hε
    (by rw [hker, sup_comm])
  have hxa : x ∈ RingHom.ker πa := by rw [hx]; exact Ideal.mem_span_singleton_self x
  have hyb : y ∈ RingHom.ker πb := by rw [hy]; exact Ideal.mem_span_singleton_self y
  have hxy : x * y = 0 := by
    have : x * y ∈ RingHom.ker πa ⊓ RingHom.ker πb :=
      ⟨Ideal.mul_mem_right _ _ hxa, Ideal.mul_mem_left _ _ hyb⟩
    rw [hinf] at this
    exact (Submodule.mem_bot A).1 this
  refine ⟨x, y, hx, hy, ?_, ?_⟩
  · intro a
    obtain ⟨p, hp⟩ := polyCoeff_surj σ πa hπa ea hea y d0 hyd a
    rw [hx, Ideal.mem_span_singleton'] at hp
    obtain ⟨a1, ha1⟩ := hp
    obtain ⟨q, hq⟩ := polyCoeff_surj σ πb hπb eb heb x c0 hxc a1
    rw [hy, Ideal.mem_span_singleton'] at hq
    obtain ⟨a2, ha2⟩ := hq
    refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) p +
      MvPolynomial.X 0 * Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) q, ?_⟩
    rw [map_add, map_mul, Polynomial.hom_eval₂, Polynomial.hom_eval₂]
    simp only [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
    have hC : (MvPolynomial.eval₂Hom σ ![x, y]).comp MvPolynomial.C = σ :=
      RingHom.ext fun c => by simp
    rw [hC]
    linear_combination ha1 + x * ha2 - a2 * hxy
  · set φ := MvPolynomial.eval₂Hom σ ![x, y] with hφ
    apply le_antisymm
    · intro f hf
      have hf0 : φ f = 0 := hf
      apply mem_span_mul_of_eval
      · have H0 : (ea.toRingHom.comp πa).comp φ = MvPolynomial.eval₂Hom
            (Polynomial.C : K →+* K[X]) ![0, Polynomial.X - Polynomial.C d0] := by
          refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_)
          · simp [hφ, hea]
          · fin_cases i
            · simp [hφ, RingHom.mem_ker.1 hxa]
            · simp [hφ, hyd]
        rw [← comp_eval₂Hom_zero_X_sub_C d0, ← H0]
        simp [hf0]
      · have H1 : (eb.toRingHom.comp πb).comp φ = MvPolynomial.eval₂Hom
            (Polynomial.C : K →+* K[X]) ![Polynomial.X - Polynomial.C c0, 0] := by
          refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_)
          · simp [hφ, heb]
          · fin_cases i
            · simp [hφ, hxc]
            · simp [hφ, RingHom.mem_ker.1 hyb]
        rw [← comp_eval₂Hom_X_sub_C_zero c0, ← H1]
        simp [hf0]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show φ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
      simp [hφ, hxy]

/-- If `A ≃ K[X]` over `K`, the kernel of an augmentation `ε : A → K` is generated by an element
corresponding to `X - C c0` for some `c0`. -/
theorem exists_ker_eq_span_X_sub_C {K A : Type u} [Field K] [CommRing A] (σ : K →+* A)
    (e : A ≃+* K[X]) (he : ∀ c, e (σ c) = Polynomial.C c) (ε : A →+* K)
    (hε : ∀ c, ε (σ c) = c) :
    ∃ x : A, ∃ c0 : K, e x = Polynomial.X - Polynomial.C c0 ∧ RingHom.ker ε = Ideal.span {x} := by
  let φ : K[X] →+* K := ε.comp e.symm.toRingHom
  have hφC : ∀ c, φ (Polynomial.C c) = c := by
    intro c
    have : e.symm (Polynomial.C c) = σ c := by rw [← he c]; simp
    simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, this, hε]
  set c0 := φ Polynomial.X with hc0
  have hφ : ∀ p : K[X], φ p = p.eval c0 := by
    intro p
    rw [eq_evalRingHom_of_map_C φ hφC]
    rfl
  set x := e.symm (Polynomial.X - Polynomial.C c0) with hx
  have hex : e x = Polynomial.X - Polynomial.C c0 := by simp [hx]
  have hker : RingHom.ker ε = Ideal.span {x} := by
    apply le_antisymm
    · intro z hz
      have h1 : φ (e z) = 0 := by
        simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
          RingEquiv.symm_apply_apply]
        exact hz
      rw [hφ, ← Polynomial.IsRoot.def, Polynomial.dvd_iff_isRoot.symm] at h1
      obtain ⟨f, hf⟩ := h1
      rw [Ideal.mem_span_singleton']
      refine ⟨e.symm f, e.injective ?_⟩
      rw [map_mul, hex, RingEquiv.apply_symm_apply, hf]
      ring
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show ε x = 0
      have := hφ (Polynomial.X - Polynomial.C c0)
      simp only [φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at this
      rw [hx, this]
      simp
  exact ⟨x, c0, hex, hker⟩

/-- If `A ≃ K[X]` over `K` and `ε : A → K` is an augmentation, then `ker ε = (x)` for some `x`, and
`(x, 0)` induces a surjection `K[x, y] → A` with kernel `(y)`. -/
theorem end_alg0 {K A : Type u} [Field K] [CommRing A] (σ : K →+* A) (e : A ≃+* K[X])
    (he : ∀ c, e (σ c) = Polynomial.C c) (ε : A →+* K) (hε : ∀ c, ε (σ c) = c) :
    ∃ x : A, RingHom.ker ε = Ideal.span {x} ∧
      Function.Surjective (MvPolynomial.eval₂Hom σ ![x, 0]) ∧
      RingHom.ker (MvPolynomial.eval₂Hom σ ![x, 0]) =
        Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) K)} := by
  obtain ⟨x, c0, hex, hker⟩ := exists_ker_eq_span_X_sub_C σ e he ε hε
  refine ⟨x, hker, ?_, ?_⟩
  · intro a
    obtain ⟨p, hp⟩ := polyCoeff_surj σ (RingHom.id A) Function.surjective_id e he x c0 hex a
    have : a = Polynomial.eval₂ σ x p := by simpa [sub_eq_zero] using RingHom.mem_ker.1 hp
    refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0) p, ?_⟩
    rw [Polynomial.hom_eval₂]
    simp only [MvPolynomial.eval₂Hom_X']
    have hC : (MvPolynomial.eval₂Hom σ ![x, 0]).comp MvPolynomial.C = σ :=
      RingHom.ext fun c => by simp
    rw [hC]
    simpa using this.symm
  · apply le_antisymm
    · intro f hf
      have hf0 : MvPolynomial.eval₂Hom σ ![x, 0] f = 0 := hf
      apply mem_span_X1_of_eval
      have H1 : (e.toRingHom).comp (MvPolynomial.eval₂Hom σ ![x, 0]) = MvPolynomial.eval₂Hom
          (Polynomial.C : K →+* K[X]) ![Polynomial.X - Polynomial.C c0, 0] := by
        refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_)
        · simp [he]
        · fin_cases i
          · simp [hex]
          · simp
      rw [← comp_eval₂Hom_X_sub_C_zero c0, ← H1]
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, hf0, map_zero]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show MvPolynomial.eval₂Hom σ ![x, 0] (MvPolynomial.X 1) = 0
      simp

/-- If `A ≃ K[X]` over `K` and `ε : A → K` is an augmentation, then `ker ε = (x)` for some `x`, and
`(0, x)` induces a surjection `K[x, y] → A` with kernel `(x)`. -/
theorem end_alg1 {K A : Type u} [Field K] [CommRing A] (σ : K →+* A) (e : A ≃+* K[X])
    (he : ∀ c, e (σ c) = Polynomial.C c) (ε : A →+* K) (hε : ∀ c, ε (σ c) = c) :
    ∃ x : A, RingHom.ker ε = Ideal.span {x} ∧
      Function.Surjective (MvPolynomial.eval₂Hom σ ![0, x]) ∧
      RingHom.ker (MvPolynomial.eval₂Hom σ ![0, x]) =
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K)} := by
  obtain ⟨x, c0, hex, hker⟩ := exists_ker_eq_span_X_sub_C σ e he ε hε
  refine ⟨x, hker, ?_, ?_⟩
  · intro a
    obtain ⟨p, hp⟩ := polyCoeff_surj σ (RingHom.id A) Function.surjective_id e he x c0 hex a
    have : a = Polynomial.eval₂ σ x p := by simpa [sub_eq_zero] using RingHom.mem_ker.1 hp
    refine ⟨Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 1) p, ?_⟩
    rw [Polynomial.hom_eval₂]
    simp only [MvPolynomial.eval₂Hom_X']
    have hC : (MvPolynomial.eval₂Hom σ ![0, x]).comp MvPolynomial.C = σ :=
      RingHom.ext fun c => by simp
    rw [hC]
    simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
    exact this.symm
  · apply le_antisymm
    · intro f hf
      have hf0 : MvPolynomial.eval₂Hom σ ![0, x] f = 0 := hf
      apply mem_span_X0_of_eval
      have H1 : (e.toRingHom).comp (MvPolynomial.eval₂Hom σ ![0, x]) = MvPolynomial.eval₂Hom
          (Polynomial.C : K →+* K[X]) ![0, Polynomial.X - Polynomial.C c0] := by
        refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_)
        · simp [he]
        · fin_cases i
          · simp
          · simp [hex]
      rw [← comp_eval₂Hom_zero_X_sub_C c0, ← H1]
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, hf0, map_zero]
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      show MvPolynomial.eval₂Hom σ ![0, x] (MvPolynomial.X 0) = 0
      simp

end NodeRingAlgebra

end

end MMP.Resolution.MarkedChain
