/-!
# The centres of the disjoining sequence (Kollár, *Resolution*, 3.72)

Let `E = (E_1, …, E_k)` be a sequence of divisors on `X` and let `(X_j, Z_j)` be its disjoining
sequence: `Z_j ⊆ X_j` is the reduced subscheme on the points lying on at least `k - j` of the
transforms `E_i^{(j)}`, and `X_{j+1} = B_{Z_j}X_j`. Write `D_j` for the total divisor
`∑_i E_i^{(j)} + ∑_{l ≤ j} F^{l,(j)}`. Assume (a) `D_j` is a simple normal crossing divisor and
(b) no point of `X_j` lies on `k - j + 1` of the `E_i^{(j)}`.

At a point `x ∈ Z_j`, by (b) the `E_i^{(j)}` through `x` are exactly `k - j` of them, say those
with `i ∈ S₀`, and away from the other `E_i^{(j)}` the centre is `⋂_{i ∈ S₀} E_i^{(j)}`. In local
coordinates `z` at `x` adapted to `D_j`, `E_i^{(j)} = (z_{c(i)} = 0)`, so near `x` the centre is
`(z_{c(i)} : i ∈ S₀)`, which is prime since the `z_{c(i)}` are part of a regular system of
parameters. Thus `Z_j` has simple normal crossings with `D_j`, and is smooth.

Lifting the `z_{c(i)}` to sections `f_i` of `I_{E_i^{(j)}}` on an affine neighbourhood `W` of `x`
generating `I_{Z_j}` there, the charts `D_+(f_i)` cover `π_j⁻¹(W)`, and on `D_+(f_ℓ)` the ideal
`π_j^*I_{Z_j}` is generated by `π_j^*f_ℓ`; so `π_j⁻¹(E_ℓ^{(j)}) ∩ D_+(f_ℓ) ⊆ π_j⁻¹(Z_j)`, and the
transform `E_ℓ^{(j+1)}` misses `D_+(f_ℓ)`. Hence no point of `X_{j+1}` lies on `k - j` of the
`E_i^{(j+1)}`.

## Main results

* `MMP.Resolution.hasSNCWith_disjoiningTotalDivisor_center`: under (a) and (b), `Z_j` has simple
  normal crossings with `D_j`, and is smooth.
* `MMP.Resolution.exists_notMem_support_disjoiningStage_succ`: under (a) and (b), no point of
  `X_{j+1}` lies on `k - j` of the `E_i^{(j+1)}`.
* `MMP.Resolution.DisjoiningStage.hasSNCWith_center`,
  `MMP.Resolution.DisjoiningStage.exists_notMem_support_step_Es`: the same for an arbitrary
  stage `(X_j, (E_i^{(j)}), (F^{l,(j)}))`.
* `MMP.Resolution.DisjoiningStage.stalk_center_eq_span`: the centre in local coordinates.

## Implementation notes

The source states the lemmas for `0 ≤ j ≤ k - 2`, the range in which `Z_j` is a centre of the
disjoining sequence; the arguments need no bound on `j`. The scheme `X_j` is over `K` by an
arbitrary morphism `X_j → Spec K`, locally of finite type for the smoothness assertion; its
smoothness is not assumed, as it follows from (a): (a) provides a regular system of parameters at
every point. The statements hold over any perfect field, characteristic zero being the case of
the source. Hypothesis (b) reads: every set of `k - j + 1` indices contains an `i` with
`x ∉ E_i^{(j)}`.

## References

* [J. Kollár, *Lectures on resolution of singularities*, 3.72]
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace

universe u

namespace MMP.Resolution

section Stalks

variable {X : Scheme.{u}}

/-- The stalk of the radical of an ideal sheaf is the radical of its stalk. -/
theorem stalk_radical (I : X.IdealSheafData) (x : X) :
    IdealSheafData.stalk I.radical x = (IdealSheafData.stalk I x).radical := by
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) (by simp)
  rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU,
    IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU, Scheme.IdealSheafData.radical_ideal]
  let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxU⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hxU⟩
  exact IsLocalization.map_radical (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl _ _

/-- The stalk of a supremum of ideal sheaves is the supremum of their stalks. -/
theorem stalk_iSup {ι : Type*} (I : ι → X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (⨆ i, I i) x = ⨆ i, IdealSheafData.stalk (I i) x := by
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) (by simp)
  simp_rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU]
  rw [Scheme.IdealSheafData.ideal_iSup, iSup_apply, Ideal.map_iSup]

/-- A principal stalk `I_x = (g)` is generated by the germ of a section of `I` over any affine
open neighbourhood of `x`. -/
theorem exists_mem_ideal_stalk_eq_span_germ (I : X.IdealSheafData) {x : X} (U : X.affineOpens)
    (hxU : x ∈ U.1) {g : X.presheaf.stalk x} (hg : IdealSheafData.stalk I x = Ideal.span {g}) :
    ∃ e ∈ I.ideal U, IdealSheafData.stalk I x =
      Ideal.span {(X.presheaf.germ U.1 x hxU).hom e} := by
  let : Algebra Γ(X, U.1) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxU⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    U.2.isLocalization_stalk ⟨x, hxU⟩
  have halg : algebraMap Γ(X, U.1) (X.presheaf.stalk x) = (X.presheaf.germ U.1 x hxU).hom := rfl
  have hgmem : g ∈ (I.ideal U).map (algebraMap Γ(X, U.1) (X.presheaf.stalk x)) := by
    rw [halg, ← IdealSheafData.stalk_eq_map_germ I x U hxU, hg]
    exact Ideal.mem_span_singleton_self g
  obtain ⟨⟨⟨e, he⟩, t⟩, ht⟩ := (IsLocalization.mem_map_algebraMap_iff
    (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl _).1 hgmem
  refine ⟨e, he, ?_⟩
  rw [hg, ← halg]
  change g * algebraMap _ _ (t : Γ(X, U.1)) = algebraMap _ _ e at ht
  rw [← ht, Ideal.span_singleton_mul_right_unit (IsLocalization.map_units _ t)]

open MMP.Flips.ResolutionInputs in
/-- **On a chart, the centre contains every divisor through the chart's generator.** Let
`f_1, …, f_s` generate `I_Z` on an affine open `W`. On the chart `D_+(f_m)` of the blow-up
`π : B_ZX → X`, `π^*I_Z = (π^*f_m)`; hence if `f_m` vanishes on `D`, every point of the chart
over `D` lies over `Z`. -/
theorem mem_support_of_mem_blowUpChartOpen (Z D : X.IdealSheafData) (W : X.affineOpens) {s : ℕ}
    (f : Fin s → Γ(X, W.1)) (hf : Z.ideal W = Ideal.span (Set.range f)) (m : Fin s)
    (hfm : f m ∈ D.ideal W) {w : blowUp Z}
    (hw : w ∈ (blowUpChartOpen Z W (generatorSection Z W f hf m)).1)
    (hD : blowUpToBase Z w ∈ D.support) : blowUpToBase Z w ∈ Z.support := by
  rw [← mem_support_comap_iff, Scheme.IdealSheafData.mem_support_iff_of_mem hw] at hD ⊢
  rw [ideal_comap_blowUpChartOpen_generatorSection]
  rw [ideal_comap_blowUpToBase_blowUpChartOpen] at hD
  exact Scheme.zeroLocus_mono _ (SetLike.coe_subset_coe.2 (Ideal.span_le.2
    (Set.singleton_subset_iff.2 (Ideal.mem_map_of_mem _ hfm)))) hD

end Stalks

section Parameters

variable {R : Type*} [CommRing R] [IsRegularLocalRing R]

/-- In a regular local ring the ideal generated by part of a regular system of parameters is
radical. -/
theorem radical_span_image_of_isRegularSystemOfParameters {n : ℕ} {z : Fin n → R}
    (hz : MMP.Mori.IsRegularSystemOfParameters z) (s : Finset (Fin n)) :
    (Ideal.span (z '' s)).radical = Ideal.span (z '' s) := by
  obtain ⟨hreg, -, -⟩ :=
    MMP.Flips.ResolutionInputs.isRegularSystemOfParameters_quotient_image hz s
  exact ((Ideal.Quotient.isDomain_iff_prime _).mp (IsRegularLocalRing.isDomain _)).isRadical.radical

end Parameters

namespace DisjoiningStage

variable {k j : ℕ} (st : DisjoiningStage.{u} k j)

/-- The support of the centre `Z_j`: the points lying on all `E_i^{(j)}`, `i ∈ S`, for some
`S` with `|S| = k - j`. -/
theorem coe_support_center :
    (st.center.support : Set st.X) =
      ⋃ S : {S : Finset (Fin k) // S.card = k - j}, ⋂ i ∈ S.1, ((st.Es i).support : Set st.X) := by
  unfold center
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, ← Finset.sup_univ_eq_iSup,
    Closeds.coe_finset_sup]
  simp

/-- A point lies on `Z_j` iff it lies on `k - j` of the `E_i^{(j)}`. -/
theorem mem_support_center_iff (x : st.X) :
    x ∈ st.center.support ↔
      ∃ S : Finset (Fin k), S.card = k - j ∧ ∀ i ∈ S, x ∈ (st.Es i).support := by
  change x ∈ (st.center.support : Set st.X) ↔ _
  rw [coe_support_center]
  simp only [Set.mem_iUnion, Set.mem_iInter, SetLike.mem_coe, Subtype.exists, exists_prop]

/-- In local coordinates in which each `E_i^{(j)} ∋ x` is `(z_{c(i)} = 0)`, the sum of the ideals
of the `E_i^{(j)}`, `i ∈ S₀`, is `(z_{c(i)} : i ∈ S₀)`. -/
theorem iSup_stalk_eq_span {x : st.X} {S₀ : Finset (Fin k)}
    (hS₀ : ∀ i, i ∈ S₀ ↔ x ∈ (st.Es i).support) {n : ℕ}
    {z : Fin n → st.X.presheaf.stalk x}
    {c : {i // x ∈ (Sum.elim st.Es st.Fs i).support} → Fin n}
    (hc : ∀ i, IdealSheafData.stalk (Sum.elim st.Es st.Fs i.1) x = Ideal.span {z (c i)}) :
    ⨆ i : S₀, IdealSheafData.stalk (st.Es i) x =
      Ideal.span (z '' ((S₀.attach.image fun i => c ⟨Sum.inl i.1, (hS₀ _).1 i.2⟩ :
        Finset (Fin n)) : Set (Fin n))) := by
  have hi : ∀ i : S₀, IdealSheafData.stalk (st.Es i) x =
      Ideal.span {z (c ⟨Sum.inl i.1, (hS₀ _).1 i.2⟩)} := fun i => hc ⟨Sum.inl i.1, _⟩
  simp_rw [hi, ← Ideal.span_iUnion]
  congr 1
  ext a
  simp only [Set.mem_iUnion, Set.mem_singleton_iff, Finset.coe_image, Finset.coe_attach,
    Set.image_univ, Set.mem_image, Set.mem_range, Subtype.exists]
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨_, ⟨i, hi, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨i, hi, rfl⟩, rfl⟩
    exact ⟨i, hi, rfl⟩

section Local

variable {x : st.X} {S₀ : Finset (Fin k)} (hS₀ : ∀ i, i ∈ S₀ ↔ x ∈ (st.Es i).support)
  (hb : ∀ S : Finset (Fin k), S.card = k - j + 1 → ∃ i ∈ S, x ∉ (st.Es i).support)

include hS₀ hb

/-- Under (b), a point of `Z_j` lies on exactly `k - j` of the `E_i^{(j)}`. -/
theorem card_eq_of_mem_support_center (hx : x ∈ st.center.support) : S₀.card = k - j := by
  obtain ⟨S, hS, hSx⟩ := (st.mem_support_center_iff x).1 hx
  have hSS₀ : S ⊆ S₀ := fun i hi => (hS₀ i).2 (hSx i hi)
  have hle : S₀.card ≤ k - j := by
    by_contra h
    obtain ⟨T, hT, hTc⟩ := Finset.exists_subset_card_eq (s := S₀) (n := k - j + 1) (by omega)
    obtain ⟨i, hi, hxi⟩ := hb T hTc
    exact hxi ((hS₀ i).1 (hT hi))
  have := Finset.card_le_card hSS₀
  omega

/-- Near a point `x ∈ Z_j` lying on exactly the `E_i^{(j)}`, `i ∈ S₀`, the centre `Z_j` is
`⋂_{i ∈ S₀} E_i^{(j)}`. -/
theorem exists_support_center_inter_eq (hx : x ∈ st.center.support) :
    ∃ V : st.X.Opens, x ∈ V ∧ (st.center.support : Set st.X) ∩ V =
      ((⨆ i : S₀, st.Es i).support : Set st.X) ∩ V := by
  have hcard := st.card_eq_of_mem_support_center hS₀ hb hx
  refine ⟨⟨⋂ i ∈ S₀ᶜ, ((st.Es i).support : Set st.X)ᶜ,
    isOpen_biInter_finset fun i _ => (st.Es i).support.isClosed.isOpen_compl⟩, ?_, ?_⟩
  · change x ∈ ⋂ i ∈ S₀ᶜ, ((st.Es i).support : Set st.X)ᶜ
    simp only [Set.mem_iInter, Finset.mem_compl, Set.mem_compl_iff, SetLike.mem_coe]
    exact fun i hi hxi => hi ((hS₀ i).2 hxi)
  · ext y
    change y ∈ (st.center.support : Set st.X) ∩ ⋂ i ∈ S₀ᶜ, ((st.Es i).support : Set st.X)ᶜ ↔
      y ∈ ((⨆ i : S₀, st.Es i).support : Set st.X) ∩ ⋂ i ∈ S₀ᶜ, ((st.Es i).support : Set st.X)ᶜ
    simp only [Set.mem_inter_iff, Set.mem_iInter, Finset.mem_compl, Set.mem_compl_iff,
      SetLike.mem_coe, Scheme.IdealSheafData.support_iSup]
    have hiff : y ∈ (⨅ i : S₀, (st.Es i).support) ↔ ∀ i : S₀, y ∈ (st.Es i).support := by
      rw [← SetLike.mem_coe, Closeds.coe_iInf, Set.mem_iInter]
      rfl
    rw [hiff]
    refine and_congr_left fun hyV => ?_
    rw [st.mem_support_center_iff]
    refine ⟨fun ⟨S, hS, hSy⟩ i => ?_, fun h => ⟨S₀, hcard, fun i hi => h ⟨i, hi⟩⟩⟩
    have hSS₀ : S ⊆ S₀ := fun l hl => by_contra fun h => hyV l h (hSy l hl)
    have : S = S₀ := Finset.eq_of_subset_of_card_le hSS₀ (by omega)
    exact hSy i (this ▸ i.2)

/-- **The stalk of the centre.** At a point `x ∈ Z_j` lying on exactly the `E_i^{(j)}`,
`i ∈ S₀`, the ideal of `Z_j` is the radical of `∑_{i ∈ S₀} I_{E_i^{(j)}}`. -/
theorem stalk_center_eq (hx : x ∈ st.center.support) :
    IdealSheafData.stalk st.center x = (⨆ i : S₀, IdealSheafData.stalk (st.Es i) x).radical := by
  obtain ⟨V, hxV, hV⟩ := st.exists_support_center_inter_eq hS₀ hb hx
  have hV' : ((⨆ S : {S : Finset (Fin k) // S.card = k - j}, ⨅ i ∈ S.1, (st.Es i).support :
      Closeds st.X) : Set st.X) ∩ V = ((⨆ i : S₀, st.Es i).support : Set st.X) ∩ V := by
    rw [← hV]
    unfold center
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
  have h := IdealSheafData.stalk_vanishingIdeal_congr hxV hV'
  rw [Scheme.IdealSheafData.vanishingIdeal_support] at h
  unfold center
  rw [h, stalk_radical, stalk_iSup]

/-- **The centre in local coordinates.** Let `z_1, …, z_n` be local coordinates at a point
`x ∈ Z_j` in which each component `E` of `D_j` through `x` is `(z_{c(E)} = 0)`. If `x` lies on
exactly the `E_i^{(j)}`, `i ∈ S₀`, then near `x` the centre is `Z_j = (z_{c(i)} = 0 : i ∈ S₀)`. -/
theorem stalk_center_eq_span [IsLocallyNoetherian st.X] (hx : x ∈ st.center.support) {n : ℕ}
    {z : Fin n → st.X.presheaf.stalk x}
    {c : {i // x ∈ (Sum.elim st.Es st.Fs i).support} → Fin n}
    (hz : MMP.Mori.IsRegularSystemOfParameters z)
    (hc : ∀ i, IdealSheafData.stalk (Sum.elim st.Es st.Fs i.1) x = Ideal.span {z (c i)}) :
    IdealSheafData.stalk st.center x =
      Ideal.span (z '' ((S₀.attach.image fun i => c ⟨Sum.inl i.1, (hS₀ _).1 i.2⟩ :
        Finset (Fin n)) : Set (Fin n))) := by
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  rw [st.stalk_center_eq hS₀ hb hx, st.iSup_stalk_eq_span hS₀ hc,
    radical_span_image_of_isRegularSystemOfParameters hz]

/-- At `x ∈ Z_j`, in local coordinates adapted to `D_j`, `I_{Z_j} = ∑_{i ∈ S₀} I_{E_i^{(j)}}`. -/
theorem stalk_center_eq_iSup [IsLocallyNoetherian st.X] (hx : x ∈ st.center.support) {n : ℕ}
    {z : Fin n → st.X.presheaf.stalk x}
    {c : {i // x ∈ (Sum.elim st.Es st.Fs i).support} → Fin n}
    (hz : MMP.Mori.IsRegularSystemOfParameters z)
    (hc : ∀ i, IdealSheafData.stalk (Sum.elim st.Es st.Fs i.1) x = Ideal.span {z (c i)}) :
    IdealSheafData.stalk st.center x = ⨆ i : S₀, IdealSheafData.stalk (st.Es i) x := by
  rw [st.stalk_center_eq_span hS₀ hb hx hz hc, st.iSup_stalk_eq_span hS₀ hc]

end Local

/-- **Kollár 3.72, the centres of the disjoining sequence**, for a stage `(X_j, (E_i^{(j)}),
(F^{l,(j)}))`: if (a) `D_j = ∑ E_i^{(j)} + ∑ F^{l,(j)}` is a simple normal crossing divisor and
(b) no point of `X_j` lies on `k - j + 1` of the `E_i^{(j)}`, then `Z_j` has simple normal
crossings with `D_j`. -/
theorem hasSNCWith_center [IsLocallyNoetherian st.X] {K : Type u} [Field K]
    (sX : st.X ⟶ Spec (.of K)) (ha : IsSNCFamily sX (Sum.elim st.Es st.Fs))
    (hb : ∀ (x : st.X) (S : Finset (Fin k)), S.card = k - j + 1 →
      ∃ i ∈ S, x ∉ (st.Es i).support) :
    HasSNCWith (Sum.elim st.Es st.Fs) st.center := by
  classical
  intro x hx
  obtain ⟨n, z, c, hz, hc, hinj⟩ := ha.2 x
  have hS₀ : ∀ i, i ∈ Finset.univ.filter (fun i => x ∈ (st.Es i).support) ↔
      x ∈ (st.Es i).support := fun i => by simp
  exact ⟨n, z, c, _, hz, hc, hinj, st.stalk_center_eq_span hS₀ (hb x) hx hz hc⟩

/-- The transform of `D` under the blow-up of the centre lies over `D`. -/
theorem support_transform_subset (D : st.X.IdealSheafData) :
    ((st.transform D).support : Set (blowUp st.center)) ⊆
      blowUpToBase st.center ⁻¹' (D.support : Set st.X) := by
  unfold transform
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, Closeds.coe_closure]
  exact closure_minimal (fun _ h => h.1)
    (D.support.isClosed.preimage (blowUpToBase st.center).continuous)

open MMP.Flips.ResolutionInputs in
/-- On the chart `D_+(f_m)` of the blow-up of `Z_j`, where `f_m` vanishes on `D`, the transform
of `D` is empty. -/
theorem notMem_support_transform_of_mem_blowUpChartOpen (D : st.X.IdealSheafData)
    (W : st.X.affineOpens) {s : ℕ} (f : Fin s → Γ(st.X, W.1))
    (hf : st.center.ideal W = Ideal.span (Set.range f)) (m : Fin s) (hfm : f m ∈ D.ideal W)
    {q : blowUp st.center}
    (hm : q ∈ (blowUpChartOpen st.center W (generatorSection st.center W f hf m)).1) :
    q ∉ (st.transform D).support := by
  intro hq
  change q ∈ ((st.transform D).support : Set (blowUp st.center)) at hq
  unfold transform at hq
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, Closeds.coe_closure] at hq
  obtain ⟨w, hwC, hw⟩ := mem_closure_iff.1 hq _
    (blowUpChartOpen st.center W (generatorSection st.center W f hf m)).1.isOpen hm
  exact hw.2 (mem_support_of_mem_blowUpChartOpen st.center D W f hf m hfm hwC hw.1)

/-- **Kollár 3.72, one disjoining step removes the `(k - j)`-fold intersections**, for a stage
`(X_j, (E_i^{(j)}), (F^{l,(j)}))`: under (a) and (b) of `hasSNCWith_center`, no
point of `X_{j+1}` lies on `k - j` of the `E_i^{(j+1)}`. -/
theorem exists_notMem_support_step_Es [IsLocallyNoetherian st.X] {K : Type u} [Field K]
    (sX : st.X ⟶ Spec (.of K)) (ha : IsSNCFamily sX (Sum.elim st.Es st.Fs))
    (hb : ∀ (x : st.X) (S : Finset (Fin k)), S.card = k - j + 1 →
      ∃ i ∈ S, x ∉ (st.Es i).support)
    (q : st.step.X) (S : Finset (Fin k)) (hS : S.card = k - j) :
    ∃ i ∈ S, q ∉ (st.step.Es i).support := by
  classical
  by_contra hcon
  push Not at hcon
  set x : st.X := blowUpToBase st.center q
  have hxS : ∀ i ∈ S, x ∈ (st.Es i).support := fun i hi =>
    st.support_transform_subset (st.Es i) (hcon i hi)
  have hS₀ : ∀ i, i ∈ S ↔ x ∈ (st.Es i).support := by
    refine fun i => ⟨hxS i, fun hxi => ?_⟩
    by_contra hi
    obtain ⟨l, hl, hxl⟩ := hb x (insert i S) (by rw [Finset.card_insert_of_notMem hi, hS])
    rcases Finset.mem_insert.1 hl with rfl | hl
    · exact hxl hxi
    · exact hxl (hxS l hl)
  have hx : x ∈ st.center.support := (st.mem_support_center_iff x).2 ⟨S, hS, hxS⟩
  obtain ⟨n, z, c, hz, hc, -⟩ := ha.2 x
  have hstalk := st.stalk_center_eq_iSup hS₀ (hb x) hx hz hc
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := st.X) (x := x) (U := ⊤) (by simp)
  let Ua : st.X.affineOpens := ⟨U, hU⟩
  have hex : ∀ i : S, ∃ e ∈ (st.Es i).ideal Ua, IdealSheafData.stalk (st.Es i) x =
      Ideal.span {(st.X.presheaf.germ U x hxU).hom e} := fun i =>
    exists_mem_ideal_stalk_eq_span_germ (st.Es i) Ua hxU (hc ⟨Sum.inl i.1, (hS₀ _).1 i.2⟩)
  choose e he hspan using hex
  have hstalk' : IdealSheafData.stalk st.center x =
      Ideal.span (Set.range fun i : S => (st.X.presheaf.germ U x hxU).hom (e i)) := by
    rw [hstalk]
    simp_rw [hspan, ← Ideal.span_iUnion]
    congr 1
    ext a
    simp
  obtain ⟨U', hU'U, hxU', hgen⟩ :=
    MMP.Flips.ResolutionInputs.exists_ideal_eq_span_of_stalk_eq st.center (V := U) hxU
      (fun i : S => e i) hstalk'
  obtain ⟨W, hW, hxW, hWU'⟩ := exists_isAffineOpen_mem_and_subset hxU'
  let Wa : st.X.affineOpens := ⟨W, hW⟩
  let σ : S ≃ Fin S.card := S.equivFin
  let f : Fin S.card → Γ(st.X, W) := fun m => restrictSection Wa (hWU'.trans hU'U) (e (σ.symm m))
  have hf : st.center.ideal Wa = Ideal.span (Set.range f) := by
    rw [hgen Wa hWU']
    congr 1
    exact (σ.symm.surjective.range_comp
      (fun i : S => restrictSection Wa (hWU'.trans hU'U) (e i))).symm
  have hq : q ∈ blowUpToBase st.center ⁻¹ᵁ W := hxW
  rw [← MMP.Flips.ResolutionInputs.iSup_blowUpChartOpen_eq_preimage st.center Wa f hf] at hq
  obtain ⟨m, hm⟩ := Opens.mem_iSup.1 hq
  set ℓ : S := σ.symm m
  have hfm : f m ∈ (st.Es ℓ).ideal Wa :=
    Scheme.IdealSheafData.ideal_le_comap_ideal (st.Es ℓ) (U := Wa) (V := Ua)
      (hWU'.trans hU'U) (he ℓ)
  exact st.notMem_support_transform_of_mem_blowUpChartOpen (st.Es ℓ) Wa f hf m hfm hm (hcon ℓ ℓ.2)

end DisjoiningStage

/-! ### The disjoining sequence -/

section Disjoining

variable {X : Scheme.{u}}

/-- **Kollár 3.72: the centres of the disjoining sequence have snc with `D_j`.** Let
`E = (E_1, …, E_k)` and let `(X_j, Z_j)` be the disjoining sequence of `(X, E)`, `X_j` being a
scheme locally of finite type over a perfect field `K` (e.g. of characteristic zero). Assume
(a) the total divisor `D_j = ∑_i E_i^{(j)} + ∑_{l ≤ j} F^{l,(j)}` is a simple normal crossing
divisor and (b) no point of `X_j` lies on `k - j + 1` of the `E_i^{(j)}`. Then `Z_j` has simple
normal crossings with `D_j`; in particular `Z_j` is smooth over `K`. -/
@[mmp "lem_kr3c_disjoining_center_smooth"]
theorem hasSNCWith_disjoiningTotalDivisor_center {K : Type u} [Field K] [PerfectField K]
    (E : OrderedDivisor X) (j : ℕ) (sX : (disjoiningStage E j).X ⟶ Spec (.of K))
    [LocallyOfFiniteType sX] (ha : IsSNCFamily sX (disjoiningTotalDivisor E j))
    (hb : ∀ (x : (disjoiningStage E j).X) (S : Finset (Fin E.s)), S.card = E.s - j + 1 →
      ∃ i ∈ S, x ∉ ((disjoiningStage E j).Es i).support) :
    HasSNCWith (disjoiningTotalDivisor E j) (disjoiningStage E j).center ∧
      MMP.Mori.IsSmoothScheme ((disjoiningStage E j).center.subschemeι ≫ sX) := by
  have : IsLocallyNoetherian (disjoiningStage E j).X := LocallyOfFiniteType.isLocallyNoetherian sX
  have h1 : HasSNCWith (disjoiningTotalDivisor E j) (disjoiningStage E j).center :=
    (disjoiningStage E j).hasSNCWith_center sX ha fun x S hS => hb x S (by simpa using hS)
  have hX : MMP.Mori.IsSmoothScheme sX := by
    rw [MMP.Mori.isSmoothScheme_iff,
      MMP.Flips.ResolutionInputs.smooth_iff_forall_isRegularLocalRing_stalk]
    intro y
    obtain ⟨n, z, c, hz, -⟩ := ha.2 y
    exact MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  exact ⟨h1, isSmoothScheme_subscheme_of_hasSNCWith sX hX ha h1⟩

/-- **Kollár 3.72: a disjoining step removes the `(k - j)`-fold intersections.** In the setting
of `hasSNCWith_disjoiningTotalDivisor_center`, under (a) and (b), no point of `X_{j+1}` lies on
`k - j` of the `E_i^{(j+1)}`. -/
@[mmp "lem_kr3c_disjoining_step_removes_intersections"]
theorem exists_notMem_support_disjoiningStage_succ {K : Type u} [Field K]
    (E : OrderedDivisor X) (j : ℕ) (sX : (disjoiningStage E j).X ⟶ Spec (.of K))
    [IsLocallyNoetherian (disjoiningStage E j).X]
    (ha : IsSNCFamily sX (disjoiningTotalDivisor E j))
    (hb : ∀ (x : (disjoiningStage E j).X) (S : Finset (Fin E.s)), S.card = E.s - j + 1 →
      ∃ i ∈ S, x ∉ ((disjoiningStage E j).Es i).support)
    (q : (disjoiningStage E (j + 1)).X) (S : Finset (Fin E.s)) (hS : S.card = E.s - j) :
    ∃ i ∈ S, q ∉ ((disjoiningStage E (j + 1)).Es i).support :=
  (disjoiningStage E j).exists_notMem_support_step_Es sX ha
    (fun x S hS => hb x S (by simpa using hS)) q S (by simpa using hS)

end Disjoining

end MMP.Resolution
