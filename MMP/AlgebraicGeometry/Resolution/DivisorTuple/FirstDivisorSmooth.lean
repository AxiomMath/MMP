module

public import MMP.AlgebraicGeometry.Resolution.DivisorTupleTransform
import MMP.AlgebraicGeometry.Resolution.MarkedIdeal.ConstructionCenters
import MMP.AlgebraicGeometry.Resolution.OrderReduction.Existence
import MMP.AlgebraicGeometry.Divisor.BirationalPushforward

/-!
# Smoothing one divisor of an ordered divisor tuple

Let `(V, (I_1, …, I_m), E)` be an ordered divisor tuple over a field `k` of characteristic
zero. There is a finite sequence of order-one transformations of the tuple, each centre lying
outside the inverse image of the original snc locus (so nothing changes over that locus), after
which the cosupport of the chosen ideal `I_i`, with its reduced structure, is smooth over `k`, and
`I_i` is reduced: it is the ideal of its cosupport, locally generated by a regular parameter.
Each centre also misses the snc locus of the tuple it transforms.

The proof applies marked order reduction with mark two to `(V, I_i, 2, E)`. This gives a smooth
blow-up sequence `(X_r, Z_r)` after which the marked transform of `(I_i, 2)` has maximal order
`< 2`. Each centre `Z_r` lies where the marked transform has order `≥ 2`, hence off the inverse
image of the snc locus of the tuple. One step of mark two is reproduced by two order-one
transformations of the tuple: blow up `Z_r`, then the exceptional divisor `F` of that blow-up.
The second blow-up is an isomorphism, `F` being an effective Cartier divisor; the ideal
`π^*I_r : I_F` still vanishes along `F` since `π^*I_r ⊆ I_F^2`, and its transform
`(π^*I_r : I_F) : I_F = π^*I_r : I_F^2` is the marked transform. The boundary acquires one empty
entry at the second step, every component of `F` being already a component of the total
transform of the boundary. Later centres are moved along the resulting isomorphisms. At the end
the ideal is invertible of order `≤ 1` at every point, so at a point of its cosupport its local
equation is part of a regular system of parameters, and its reduced cosupport is smooth.

## Main results

* `MMP.Resolution.OrderedDivisorTuple.exists_transform_isSmoothScheme_support`.

## Implementation notes

A sequence of order-one transformations is a `MMP.Resolution.ClosedBlowupSequence` whose
centres are, stage by stage, centres of order-one transformations
(`MMP.Resolution.OrderedDivisorTuple.IsTransformCentre`) of the current tuple
(`MMP.Resolution.OrderedDivisorTuple.transform`); the condition is written by recursion on the
sequence, carrying the composite map `p : V_r → V` to the original variety. "Unchanged over the
snc locus" is that every centre `Z_r` is disjoint from `p⁻¹(sncLocus)`. The cosupport of an
ideal is given its reduced structure, as the vanishing ideal of its support.

## References

* [J. Kollár, *Semi log resolutions*, arXiv:0812.3592, Proposition 6]
-/

open CategoryTheory AlgebraicGeometry MMP.Mori IsLocalRing

universe u

namespace MMP.Resolution

/-! ### Regular systems of parameters -/

section RSOP

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- In a local ring, an element of `𝔪 ∖ 𝔪²` can replace a member of a regular system of
parameters. -/
private theorem exists_isRegularSystemOfParameters_update {n : ℕ} {z : Fin n → R}
    (hz : IsRegularSystemOfParameters z) {f : R} (hf : f ∈ maximalIdeal R)
    (hf2 : f ∉ maximalIdeal R ^ 2) :
    ∃ j, IsRegularSystemOfParameters (Function.update z j f) := by
  classical
  have hzm : ∀ i, z i ∈ maximalIdeal R := fun i => hz.1 ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 (hz.1.symm ▸ hf)
  obtain ⟨j, hj⟩ : ∃ j, c j ∉ maximalIdeal R := by
    by_contra h
    push Not at h
    refine hf2 (hc ▸ Ideal.sum_mem _ fun i _ => ?_)
    rw [pow_two]
    exact Ideal.mul_mem_mul (h i) (hzm i)
  have hu : IsUnit (c j) := (IsLocalRing.notMem_maximalIdeal).1 hj
  refine ⟨j, le_antisymm ?_ ?_, hz.2⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    by_cases hi : i = j
    · subst hi
      rwa [Function.update_self]
    · rw [Function.update_of_ne hi]
      exact hzm i
  · rw [← hz.1, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    have hmem : ∀ l, l ≠ j → z l ∈ Ideal.span (Set.range (Function.update z j f)) := fun l hl =>
      Ideal.subset_span ⟨l, by rw [Function.update_of_ne hl]⟩
    by_cases hi : i = j
    · subst hi
      have hsum := Finset.add_sum_erase Finset.univ (fun l => c l * z l) (Finset.mem_univ i)
      rw [hc] at hsum
      have h1 : c i * z i = f - ∑ l ∈ Finset.univ.erase i, c l * z l := by
        rw [← hsum]; ring
      have h2 : c i * z i ∈ Ideal.span (Set.range (Function.update z i f)) := by
        rw [h1]
        refine Ideal.sub_mem _ (Ideal.subset_span ⟨i, Function.update_self _ _ _⟩)
          (Ideal.sum_mem _ fun l hl => Ideal.mul_mem_left _ _ (hmem l (Finset.ne_of_mem_erase hl)))
      obtain ⟨u, hu'⟩ := hu
      have : z i = (↑u⁻¹ : R) * (c i * z i) := by
        rw [← mul_assoc, ← hu', Units.inv_mul, one_mul]
      rw [this]
      exact Ideal.mul_mem_left _ _ h2
    · exact hmem i hi

/-- A member of a regular system of parameters does not lie in the ideal generated by the
others. -/
private theorem notMem_span_compl_of_isRegularSystemOfParameters [IsNoetherianRing R] {n : ℕ}
    {z : Fin n → R} (hz : IsRegularSystemOfParameters z) (c : Fin n) :
    z c ∉ Ideal.span (z '' {c}ᶜ) := by
  classical
  intro hmem
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  set s : Set R := z '' ({c}ᶜ : Set (Fin n)) with hs
  have hspan : Ideal.span s = maximalIdeal R := by
    rw [← hz.1]
    refine le_antisymm (Ideal.span_mono ?_) (Ideal.span_le.2 ?_)
    · rintro _ ⟨l, -, rfl⟩; exact ⟨l, rfl⟩
    · rintro _ ⟨l, rfl⟩
      by_cases hl : l = c
      · subst hl; exact hmem
      · exact Ideal.subset_span ⟨l, hl, rfl⟩
  have hfin : s.Finite := Set.toFinite _
  have hle := Submodule.spanFinrank_span_le_ncard_of_finite (R := R) hfin
  rw [show Submodule.span R s = maximalIdeal R from hspan] at hle
  have hcard : s.ncard ≤ n - 1 := by
    rw [hs]
    refine (Set.ncard_image_le (Set.toFinite _)).trans ?_
    rw [Set.ncard_eq_toFinset_card']
    simp [Finset.card_compl]
  have hrank := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
  rw [hz.2] at hrank
  have : (maximalIdeal R).spanFinrank = n := by exact_mod_cast hrank
  have := c.2
  omega

/-- A member of a regular system of parameters does not lie in `𝔪²`. -/
private theorem notMem_sq_of_isRegularSystemOfParameters [IsNoetherianRing R] {n : ℕ}
    {z : Fin n → R} (hz : IsRegularSystemOfParameters z) (c : Fin n) :
    z c ∉ maximalIdeal R ^ 2 := by
  classical
  intro h2
  set J := Ideal.span (z '' {c}ᶜ)
  have hrange : Set.range z = z '' {c}ᶜ ∪ {z c} := by
    rw [← Set.image_singleton, ← Set.image_union, Set.compl_union_self, Set.image_univ]
  have hm : maximalIdeal R = J ⊔ Ideal.span {z c} := by
    rw [← hz.1, hrange, Ideal.span_union]
  have hle : maximalIdeal R ^ 2 ≤ J ⊔ maximalIdeal R * Ideal.span {z c} := by
    rw [pow_two]
    conv_lhs => rw [show maximalIdeal R * maximalIdeal R =
      maximalIdeal R * (J ⊔ Ideal.span {z c}) from by rw [← hm]]
    rw [Ideal.mul_sup]
    exact sup_le_sup_right Ideal.mul_le_right _
  obtain ⟨y, hy, w, hw, hyw⟩ := Submodule.mem_sup.1 (hle h2)
  obtain ⟨a, ha, rfl⟩ := Ideal.mem_mul_span_singleton.1 hw
  have hu : IsUnit (1 - a) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits a ha
  have hy' : (1 - a) * z c = y := by linear_combination (-1 : R) * hyw
  obtain ⟨u, hu'⟩ := hu
  have : z c = (↑u⁻¹ : R) * y := by rw [← hy', ← hu', ← mul_assoc, Units.inv_mul, one_mul]
  exact notMem_span_compl_of_isRegularSystemOfParameters hz c
    (this ▸ Ideal.mul_mem_left _ _ hy)

/-- A member `z_c` of a regular system of parameters lying in the prime ideal `(t)`, `t ∈ 𝔪`,
generates it. -/
private theorem span_eq_of_mem_span_singleton [IsNoetherianRing R] {n : ℕ}
    {z : Fin n → R} (hz : IsRegularSystemOfParameters z) (c : Fin n) {t : R}
    (ht : t ∈ maximalIdeal R) (hc : z c ∈ Ideal.span {t}) :
    Ideal.span {z c} = Ideal.span {t} := by
  have hP := span_singleton_isPrime_of_isRegularSystemOfParameters hz c
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hc
  have hrt : r * t ∈ Ideal.span {z c} := hr ▸ Ideal.subset_span rfl
  rcases hP.mem_or_mem hrt with hrP | htP
  · exfalso
    obtain ⟨s', hs'⟩ := Ideal.mem_span_singleton'.1 hrP
    have hu : IsUnit (1 - s' * t) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ (Ideal.mul_mem_left _ s' ht)
    have h0 : z c * (1 - s' * t) = 0 := by
      have : z c = s' * z c * t := by rw [hs', hr]
      linear_combination this
    have hz0 : z c = 0 := (hu.mul_left_eq_zero).1 h0
    exact notMem_span_compl_of_isRegularSystemOfParameters hz c (hz0 ▸ Ideal.zero_mem _)
  · exact le_antisymm (Ideal.span_le.2 (Set.singleton_subset_iff.2 hc))
      (Ideal.span_le.2 (Set.singleton_subset_iff.2 htP))

/-- The order of an ideal is invariant under ring isomorphisms of local rings. -/
private theorem idealOrder_map_ringEquiv {S : Type*} [CommRing S] [IsLocalRing S] (e : R ≃+* S)
    (I : Ideal R) : idealOrder (I.map e) = idealOrder I := by
  have key : ∀ j : ℕ, I.map e ≤ maximalIdeal S ^ j ↔ I ≤ maximalIdeal R ^ j := fun j => by
    rw [← map_ringEquiv_maximalIdeal e, ← Ideal.map_pow, Ideal.map_le_iff_le_comap,
      Ideal.comap_map_of_bijective _ e.bijective]
  simp only [idealOrder, key]

/-- An ideal contained in `𝔪²` has order `≥ 2`. -/
private theorem two_le_idealOrder {I : Ideal R} (h : I ≤ maximalIdeal R ^ 2) :
    2 ≤ idealOrder I :=
  le_iSup₂_of_le 2 h le_rfl

/-- An ideal of order `≥ 2` lies in `𝔪²`. -/
private theorem le_sq_of_two_le_idealOrder {I : Ideal R} (h : 2 ≤ idealOrder I) :
    I ≤ maximalIdeal R ^ 2 :=
  le_pow_of_le_idealOrder (m := 2) (by exact_mod_cast h)

end RSOP

/-! ### Orders of ideal sheaves -/

section Orders

variable {X Y : Scheme.{u}}

/-- `I` has principal stalks. -/
private def HasPrincipalStalks (I : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ f, IdealSheafData.stalk I x = Ideal.span {f}

/-- The order of an inverse image at a point where the stalk map is an isomorphism. -/
private theorem multAt_comap_of_isIso_stalkMap (f : Y ⟶ X) (y : Y) [IsIso (f.stalkMap y)]
    (I : X.IdealSheafData) : multAt (I.comap f) y = multAt I (f y) := by
  unfold multAt
  rw [IdealSheafData.stalk_comap]
  exact idealOrder_map_ringEquiv (asIso (f.stalkMap y)).commRingCatIsoToRingEquiv _

/-- At a point of the snc locus, every ideal of the tuple has order `≤ 1`. -/
private theorem multAt_le_one_of_mem_sncLocus {V : Scheme.{u}} [IsLocallyNoetherian V]
    (T : OrderedDivisorTuple V) (j : Fin T.m) {x : V} (hx : x ∈ T.sncLocus) :
    multAt (T.I j) x ≤ 1 := by
  obtain ⟨n, z, c, hz, -, hst⟩ := hx
  unfold multAt
  by_cases hxs : x ∈ (T.I j).support
  · have h : IdealSheafData.stalk (T.I j) x = Ideal.span {z (c ⟨Sum.inl j, hxs⟩)} :=
      hst ⟨Sum.inl j, hxs⟩
    rw [h]
    by_contra hlt
    have h2 : 2 ≤ idealOrder (Ideal.span {z (c ⟨Sum.inl j, hxs⟩)}) :=
      Order.add_one_le_of_lt (not_le.1 hlt)
    exact notMem_sq_of_isRegularSystemOfParameters hz _
      (le_sq_of_two_le_idealOrder h2 (Ideal.subset_span rfl))
  · rw [(IdealSheafData.stalk_eq_top_iff_notMem_support _ x).2 hxs]
    refine iSup₂_le fun l hl => ?_
    rcases Nat.eq_zero_or_pos l with rfl | hl0
    · exact zero_le_one
    · exact absurd (top_le_iff.1 (hl.trans (Ideal.pow_le_self hl0.ne')))
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top

/-- At a point of a smooth centre along which `I` has order `≥ 2`, the order of `I` is `≥ 2`. -/
private theorem two_le_multAt_of_mem_support {k : Type u} [Field k] (sX : X ⟶ Spec (.of k))
    (hX : IsSmoothScheme sX) (Z : X.IdealSheafData) (hZ : IsSmoothScheme (Z.subschemeι ≫ sX))
    (I : X.IdealSheafData) (hI : OrderAlongGE I (Z.support : Set X) (2 : ℕ)) {x : X}
    (hx : x ∈ (Z.support : Set X)) : 2 ≤ multAt I x := by
  have h1 := stalk_le_pow_of_orderAlongGE sX hX Z hZ I 2 hI x
  have h2 : IdealSheafData.stalk Z x ≤ maximalIdeal _ :=
    IsLocalRing.le_maximalIdeal fun h =>
      ((IdealSheafData.stalk_eq_top_iff_notMem_support Z x).1 h) hx
  exact two_le_idealOrder (h1.trans (Ideal.pow_right_mono h2 2))

/-- Off the centre, the birational transform of a marked ideal has the order of the ideal. -/
private theorem multAt_birationalTransform_of_notMem {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) (hX : IsSmoothScheme sX) (Z : X.IdealSheafData)
    (hZ : IsSmoothScheme (Z.subschemeι ≫ sX))
    (hcodim : HasComponentsOfPositiveCodim (Z.support : Set X)) (a : MarkedIdeal X)
    (ha : OrderAlongGE a.I (Z.support : Set X) a.m) (x : blowUp Z)
    (hx : blowUpToBase Z x ∉ (Z.support : Set X)) :
    multAt (a.birationalTransform Z).I x = multAt a.I (blowUpToBase Z x) := by
  have hmul := MarkedIdeal.birationalTransform_mul_eq sX hX Z hZ hcodim a ha
  have hFx : IdealSheafData.stalk (Z.comap (blowUpToBase Z) ^ a.m) x = ⊤ := by
    rw [IdealSheafData.stalk_pow,
      (IdealSheafData.stalk_eq_top_iff_notMem_support _ x).2
        fun h => hx ((mem_support_comap_iff _ _ x).1 h), Ideal.top_pow]
  have hst : IdealSheafData.stalk (a.birationalTransform Z).I x =
      IdealSheafData.stalk (a.I.comap (blowUpToBase Z)) x := by
    rw [← hmul, IdealSheafData.stalk_mul, hFx, Ideal.mul_top]
  haveI : IsIso ((blowUpToBase Z).stalkMap x) :=
    isIso_stalkMap_of_isIso_morphismRestrict (blowUpToBase Z)
      (isIso_blowUpToBase_restrict_compl_support Z)
      (show x ∈ blowUpToBase Z ⁻¹ᵁ Z.support.compl from hx)
  show idealOrder _ = _
  rw [hst]
  exact multAt_comap_of_isIso_stalkMap (blowUpToBase Z) x a.I

/-- The stalks of an effective Cartier divisor are nonzero. -/
private theorem stalk_ne_bot_of_isEffectiveCartierDivisor {I : X.IdealSheafData}
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) (x : X) :
    IdealSheafData.stalk I x ≠ ⊥ := by
  obtain ⟨f, hf, h⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor I hI x
  rw [h, Ne, Ideal.span_singleton_eq_bot]
  exact hf.ne_zero

/-- An effective Cartier divisor has principal stalks. -/
private theorem hasPrincipalStalks_of_isEffectiveCartierDivisor {I : X.IdealSheafData}
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) : HasPrincipalStalks I := fun x =>
  let ⟨f, _, h⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor I hI x
  ⟨f, h⟩

/-- The birational transform of a marked ideal with principal stalks has principal stalks. -/
private theorem hasPrincipalStalks_birationalTransform {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) (hX : IsSmoothScheme sX) (Z : X.IdealSheafData)
    (hZ : IsSmoothScheme (Z.subschemeι ≫ sX))
    (hcodim : HasComponentsOfPositiveCodim (Z.support : Set X)) (a : MarkedIdeal X)
    (ha : OrderAlongGE a.I (Z.support : Set X) a.m) (h : HasPrincipalStalks a.I) :
    HasPrincipalStalks (a.birationalTransform Z).I := by
  intro x
  have hmul := MarkedIdeal.birationalTransform_mul_eq sX hX Z hZ hcodim a ha
  obtain ⟨t, ht, hFt⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor _
    (Stacks.Divisors.isEffectiveCartierDivisor_pow
      (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal Z) a.m) x
  obtain ⟨f, hf⟩ := h (blowUpToBase Z x)
  have key : IdealSheafData.stalk (a.birationalTransform Z).I x * Ideal.span {t} =
      Ideal.span {((blowUpToBase Z).stalkMap x).hom f} := by
    rw [← hFt, ← IdealSheafData.stalk_mul, hmul, IdealSheafData.stalk_comap, hf, Ideal.map_span,
      Set.image_singleton]
  have hmem : ((blowUpToBase Z).stalkMap x).hom f ∈
      IdealSheafData.stalk (a.birationalTransform Z).I x * Ideal.span {t} := by
    rw [key]; exact Ideal.subset_span rfl
  obtain ⟨g, hg, hgt⟩ := Ideal.mem_mul_span_singleton.1 hmem
  refine ⟨g, le_antisymm ?_ (Ideal.span_le.2 (Set.singleton_subset_iff.2 hg))⟩
  intro d hd
  have hdt : d * t ∈ Ideal.span {((blowUpToBase Z).stalkMap x).hom f} := by
    rw [← key]; exact Ideal.mul_mem_mul hd (Ideal.subset_span rfl)
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hdt
  rw [← hgt] at hr
  have hrg : r * g = d := ht.2 (show r * g * t = d * t by rw [← hr, mul_assoc])
  rw [← hrg]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

/-- An ideal sheaf with principal stalks of order `≤ 1` on a smooth scheme over a field of
characteristic zero has, at the points of its cosupport, stalks generated by a regular
parameter. -/
private theorem exists_stalk_eq_span_parameter_of_hasPrincipalStalks {k : Type u} [Field k]
    [CharZero k] (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (hX : IsSmoothScheme sX)
    (I : X.IdealSheafData) (hI : HasPrincipalStalks I) (hord : ∀ x, multAt I x ≤ 1) :
    ∀ x ∈ (I.support : Set X), ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x) (j : Fin n),
      MMP.Mori.IsRegularSystemOfParameters z ∧ IdealSheafData.stalk I x = Ideal.span {z j} := by
  haveI : Smooth sX := (isSmoothScheme_iff sX).mp hX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  intro x hx'
  obtain ⟨f, hf⟩ := hI x
  have hfm : f ∈ maximalIdeal (X.presheaf.stalk x) := by
    have hne : IdealSheafData.stalk I x ≠ ⊤ := fun h =>
      ((IdealSheafData.stalk_eq_top_iff_notMem_support I x).1 h) hx'
    exact IsLocalRing.le_maximalIdeal hne (hf ▸ Ideal.subset_span rfl)
  have hf2 : f ∉ maximalIdeal (X.presheaf.stalk x) ^ 2 := fun h => by
    have h2 : 2 ≤ multAt I x := by
      show 2 ≤ idealOrder _
      rw [hf]
      exact two_le_idealOrder (Ideal.span_le.2 (Set.singleton_subset_iff.2 h))
    exact absurd (h2.trans (hord x)) (by decide)
  haveI : IsRegularLocalRing (X.presheaf.stalk x) :=
    isRegularLocalRing_stalk_of_smooth_over_field sX x
  obtain ⟨n, z, hz⟩ := exists_isRegularSystemOfParameters (X.presheaf.stalk x)
  obtain ⟨j, hw⟩ := exists_isRegularSystemOfParameters_update hz hfm hf2
  exact ⟨n, _, j, hw, by rw [hf, Function.update_self]⟩

/-- An ideal sheaf with principal stalks of order `≤ 1` on a smooth scheme over a field of
characteristic zero is the reduced ideal of its cosupport. -/
private theorem eq_vanishingIdeal_support {k : Type u} [Field k] [CharZero k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (hX : IsSmoothScheme sX)
    (I : X.IdealSheafData) (hI : HasPrincipalStalks I) (hord : ∀ x, multAt I x ≤ 1) :
    I = Scheme.IdealSheafData.vanishingIdeal I.support := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have := isReduced_subscheme_of_stalk_eq_span_parameter I
    (exists_stalk_eq_span_parameter_of_hasPrincipalStalks sX hX I hI hord)
  exact (MMP.Positivity.vanishingIdeal_support_of_isReduced I).symm

/-- An ideal sheaf with principal stalks of order `≤ 1` on a smooth scheme over a field of
characteristic zero has smooth reduced cosupport. -/
private theorem isSmoothScheme_vanishingIdeal_support {k : Type u} [Field k] [CharZero k]
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (hX : IsSmoothScheme sX)
    (I : X.IdealSheafData) (hI : HasPrincipalStalks I) (hord : ∀ x, multAt I x ≤ 1) :
    IsSmoothScheme ((Scheme.IdealSheafData.vanishingIdeal I.support).subschemeι ≫ sX) := by
  rw [← eq_vanishingIdeal_support sX hX I hI hord]
  exact isSmoothScheme_subscheme_of_stalk_eq_span_parameter sX I
    (exists_stalk_eq_span_parameter_of_hasPrincipalStalks sX hX I hI hord)

/-- Stalks generated by regular parameters are carried along an isomorphism. -/
public theorem exists_stalk_comap_eq_span_parameter (φ : Y ⟶ X) [IsIso φ]
    (I : X.IdealSheafData)
    (h : ∀ x ∈ (I.support : Set X), ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x) (j : Fin n),
      MMP.Mori.IsRegularSystemOfParameters z ∧ IdealSheafData.stalk I x = Ideal.span {z j}) :
    ∀ y ∈ ((I.comap φ).support : Set Y), ∃ (n : ℕ) (z : Fin n → Y.presheaf.stalk y) (j : Fin n),
      MMP.Mori.IsRegularSystemOfParameters z ∧
        IdealSheafData.stalk (I.comap φ) y = Ideal.span {z j} := by
  intro y hy
  obtain ⟨n, z, j, hz, hzj⟩ := h (φ y) ((mem_support_comap_iff φ I y).1 hy)
  haveI : IsIso (φ.stalkMap y) := ((isIso_iff_isIso_stalkMap φ).1 inferInstance).2 y
  let e := (asIso (φ.stalkMap y)).commRingCatIsoToRingEquiv
  refine ⟨n, fun i => e (z i), j, hz.map_ringEquiv e, ?_⟩
  rw [IdealSheafData.stalk_comap, hzj, Ideal.map_span, Set.image_singleton]
  rfl

end Orders

/-! ### Ideal quotients by effective Cartier divisors -/

section Colon

variable {X Y : Scheme.{u}}

/-- Cancellation of an effective Cartier divisor: `C·D ≤ C'·D` implies `C ≤ C'`. -/
private theorem le_of_mul_le_mul_right {C C' D : X.IdealSheafData}
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (h : C * D ≤ C' * D) : C ≤ C' := by
  refine IdealSheafData.le_of_stalk_le _ _ fun x => ?_
  obtain ⟨t, ht, hDx⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD x
  have h' := stalk_le_stalk_of_le h x
  rw [IdealSheafData.stalk_mul, IdealSheafData.stalk_mul, hDx] at h'
  intro c hc
  obtain ⟨c', hc', he⟩ :=
    Ideal.mem_mul_span_singleton.1 (h' (Ideal.mem_mul_span_singleton.2 ⟨c, hc, rfl⟩))
  rwa [← ht.2 he]

/-- Cancellation of an effective Cartier divisor: `C·D = C'·D` implies `C = C'`. -/
private theorem eq_of_mul_eq_mul_right {C C' D : X.IdealSheafData}
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (h : C * D = C' * D) : C = C' :=
  le_antisymm (le_of_mul_le_mul_right hD h.le) (le_of_mul_le_mul_right hD h.ge)

/-- An ideal sheaf contained in `B²` is contained in `B`. -/
private theorem le_of_le_sq {A B : X.IdealSheafData} (h : A ≤ B ^ 2) : A ≤ B :=
  h.trans (by rw [pow_two]; exact mul_le_of_le_one_right' le_top)

/-- The inverse image of a product of ideal sheaves. -/
private theorem comap_mul (f : Y ⟶ X) (I J : X.IdealSheafData) :
    (I * J).comap f = I.comap f * J.comap f := by
  have h : ∀ y, IdealSheafData.stalk ((I * J).comap f) y =
      IdealSheafData.stalk (I.comap f * J.comap f) y := fun y => by
    rw [IdealSheafData.stalk_comap, IdealSheafData.stalk_mul, IdealSheafData.stalk_mul,
      IdealSheafData.stalk_comap, IdealSheafData.stalk_comap, Ideal.map_mul]
  exact le_antisymm (IdealSheafData.le_of_stalk_le _ _ fun y => (h y).le)
    (IdealSheafData.le_of_stalk_le _ _ fun y => (h y).ge)

/-- `(A : B)·B = A` for an effective Cartier divisor `B ⊇ A`. -/
private theorem idealColon_mul_eq (A B : X.IdealSheafData)
    (hB : Stacks.Divisors.IsEffectiveCartierDivisor B) (hAB : A ≤ B) : idealColon A B * B = A := by
  have hcol : idealColon A B =
      Scheme.IdealSheafData.colon A B (fg_ideal_of_isEffectiveCartierDivisor _ hB) := by
    unfold idealColon
    exact Scheme.IdealSheafData.ofIdeals_ideal
      (Scheme.IdealSheafData.colon A B (fg_ideal_of_isEffectiveCartierDivisor _ hB))
  rw [hcol, mul_comm]
  exact mul_colon_eq_of_isEffectiveCartierDivisor _ _ hB hAB

/-- The ideal quotient by an effective Cartier divisor commutes with isomorphisms. -/
public theorem comap_idealColon_of_isIso (ψ : Y ⟶ X) [IsIso ψ] (A B : X.IdealSheafData)
    (hB : Stacks.Divisors.IsEffectiveCartierDivisor B) (hAB : A ≤ B) :
    (idealColon A B).comap ψ = idealColon (A.comap ψ) (B.comap ψ) := by
  have hB' : Stacks.Divisors.IsEffectiveCartierDivisor (B.comap ψ) :=
    Stacks.Divisors.isPullbackDefined_of_flat ψ B hB
  have hAB' : A.comap ψ ≤ B.comap ψ := Scheme.IdealSheafData.comap_mono ψ hAB
  have e : (idealColon A B).comap ψ * B.comap ψ =
      idealColon (A.comap ψ) (B.comap ψ) * B.comap ψ := by
    rw [← comap_mul, idealColon_mul_eq A B hB hAB, idealColon_mul_eq _ _ hB' hAB']
  exact eq_of_mul_eq_mul_right hB' e

/-- `(A : B) ⊆ B` for an effective Cartier divisor `B` with `A ⊆ B²`. -/
private theorem idealColon_le (A B : X.IdealSheafData)
    (hB : Stacks.Divisors.IsEffectiveCartierDivisor B) (hAB : A ≤ B ^ 2) :
    idealColon A B ≤ B := by
  refine le_of_mul_le_mul_right hB ?_
  rwa [idealColon_mul_eq A B hB (le_of_le_sq hAB), ← pow_two]

/-- `((A : B) : B) = (A : B²)` for an effective Cartier divisor `B` with `A ⊆ B²`. -/
private theorem idealColon_idealColon (A B : X.IdealSheafData)
    (hB : Stacks.Divisors.IsEffectiveCartierDivisor B) (hAB : A ≤ B ^ 2) :
    idealColon (idealColon A B) B = idealColon A (B ^ 2) := by
  have hQ := idealColon_le A B hB hAB
  have hB2 := Stacks.Divisors.isEffectiveCartierDivisor_pow hB 2
  have e : idealColon (idealColon A B) B * B ^ 2 = idealColon A (B ^ 2) * B ^ 2 := by
    rw [idealColon_mul_eq A (B ^ 2) hB2 hAB, pow_two, ← mul_assoc,
      idealColon_mul_eq _ B hB hQ, idealColon_mul_eq A B hB (le_of_le_sq hAB)]
  exact eq_of_mul_eq_mul_right hB2 e

/-- The inverse image of the reduced ideal of a closed set along an isomorphism. -/
public theorem comap_vanishingIdeal_of_isIso (ψ : Y ⟶ X) [IsIso ψ]
    (S : TopologicalSpace.Closeds X) :
    (Scheme.IdealSheafData.vanishingIdeal S).comap ψ =
      Scheme.IdealSheafData.vanishingIdeal ⟨ψ ⁻¹' S, S.isClosed.preimage ψ.continuous⟩ := by
  rw [Kollar.comap_eq_map_inv, Scheme.IdealSheafData.map_vanishingIdeal]
  congr 1
  apply TopologicalSpace.Closeds.ext
  rw [TopologicalSpace.Closeds.coe_closure]
  have : (inv ψ) '' (S : Set X) = ψ ⁻¹' S := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      change ψ (inv ψ x) ∈ (S : Set X)
      rwa [Kollar.apply_inv_apply]
    · intro hy
      refine ⟨ψ y, hy, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
      rfl
  rw [this]
  exact (S.isClosed.preimage ψ.continuous).closure_eq

/-- The reduced ideal of the empty set is the unit ideal. -/
private theorem vanishingIdeal_closure_empty :
    Scheme.IdealSheafData.vanishingIdeal (TopologicalSpace.Closeds.closure (∅ : Set X)) = ⊤ := by
  rw [show TopologicalSpace.Closeds.closure (∅ : Set X) = ⊥ from
    TopologicalSpace.Closeds.ext (by
      rw [TopologicalSpace.Closeds.coe_closure, closure_empty, TopologicalSpace.Closeds.coe_bot])]
  exact Scheme.IdealSheafData.vanishingIdeal_bot

/-- The inverse image of the reduced ideal of a closure along an isomorphism. -/
public theorem comap_vanishingIdeal_closure_of_isIso (ψ : Y ⟶ X) [IsIso ψ] (S : Set X) :
    (Scheme.IdealSheafData.vanishingIdeal (TopologicalSpace.Closeds.closure S)).comap ψ =
      Scheme.IdealSheafData.vanishingIdeal (TopologicalSpace.Closeds.closure (ψ ⁻¹' S)) := by
  rw [comap_vanishingIdeal_of_isIso]
  congr 1
  exact TopologicalSpace.Closeds.ext (ψ.homeomorph.preimage_closure S)

end Colon

/-! ### Transport along homeomorphisms -/

section Homeomorph

variable {A B : Type*} [TopologicalSpace A] [TopologicalSpace B]

/-- Irreducibility is transported by homeomorphisms. -/
private theorem isIrreducible_preimage_iff (h : A ≃ₜ B) (W : Set B) :
    IsIrreducible (h ⁻¹' W) ↔ IsIrreducible W :=
  ⟨fun hW => by simpa [h.image_preimage] using hW.image h h.continuous.continuousOn,
    fun hW => by simpa [h.image_symm] using hW.image h.symm h.symm.continuous.continuousOn⟩

/-- Irreducible components are transported by homeomorphisms. -/
private theorem componentsOf_preimage_homeomorph (h : A ≃ₜ B) (S : Set B) :
    componentsOf (h ⁻¹' S) = (h ⁻¹' ·) '' componentsOf S := by
  ext V
  constructor
  · intro hV
    have hV' : V = h ⁻¹' (h '' V) := (h.preimage_image V).symm
    refine ⟨h '' V, ⟨?_, fun W hW hle => ?_⟩, hV'.symm⟩
    · rw [hV'] at hV
      exact ⟨(isIrreducible_preimage_iff h _).1 hV.1.1,
        h.surjective.preimage_subset_preimage_iff.1 hV.1.2⟩
    · have := hV.2 ⟨(isIrreducible_preimage_iff h W).2 hW.1,
        h.surjective.preimage_subset_preimage_iff.2 hW.2⟩
        (by rw [hV']; exact h.surjective.preimage_subset_preimage_iff.2 hle)
      rw [hV'] at this
      exact h.surjective.preimage_subset_preimage_iff.1 this
  · rintro ⟨W, hW, rfl⟩
    refine ⟨⟨(isIrreducible_preimage_iff h W).2 hW.1.1,
      h.surjective.preimage_subset_preimage_iff.2 hW.1.2⟩, fun T hT hle => ?_⟩
    have hT' : T = h ⁻¹' (h '' T) := (h.preimage_image T).symm
    rw [hT'] at hT hle ⊢
    exact h.surjective.preimage_subset_preimage_iff.2
      (hW.2 ⟨(isIrreducible_preimage_iff h _).1 hT.1, h.surjective.preimage_subset_preimage_iff.1 hT.2⟩
        (h.surjective.preimage_subset_preimage_iff.1 hle))

/-- Preimage of irreducible closed subsets along a homeomorphism. -/
private def irreducibleClosedsPreimage (h : A ≃ₜ B) :
    TopologicalSpace.IrreducibleCloseds B ≃o TopologicalSpace.IrreducibleCloseds A where
  toFun T := ⟨h ⁻¹' T, (isIrreducible_preimage_iff h T).2 T.isIrreducible,
    T.isClosed.preimage h.continuous⟩
  invFun T := ⟨h '' T, T.isIrreducible.image _ h.continuous.continuousOn,
    h.isClosedMap _ T.isClosed⟩
  left_inv T := TopologicalSpace.IrreducibleCloseds.ext (h.image_preimage _)
  right_inv T := TopologicalSpace.IrreducibleCloseds.ext (h.preimage_image _)
  map_rel_iff' := h.surjective.preimage_subset_preimage_iff

/-- Codimension is invariant under homeomorphisms. -/
private theorem codimension_irreducibleClosure_preimage {X Y : Scheme.{u}} (ψ : Y ⟶ X) [IsIso ψ]
    {W : Set X} (hW : IsIrreducible W) (hV : IsIrreducible (ψ ⁻¹' W)) :
    codimension (irreducibleClosure hV) = codimension (irreducibleClosure hW) := by
  have : irreducibleClosure hV =
      irreducibleClosedsPreimage ψ.homeomorph (irreducibleClosure hW) :=
    TopologicalSpace.IrreducibleCloseds.ext (ψ.homeomorph.preimage_closure W).symm
  rw [this, codimension_eq_coheight, codimension_eq_coheight, Order.coheight_orderIso]

/-- Irreducible components are transported by isomorphisms. -/
public theorem componentsOf_preimage_of_isIso {X Y : Scheme.{u}} (ψ : Y ⟶ X) [IsIso ψ]
    (S : Set X) :
    componentsOf (ψ ⁻¹' S) = (ψ ⁻¹' ·) '' componentsOf S :=
  componentsOf_preimage_homeomorph ψ.homeomorph S

/-- The union of the components of codimension `≥ 2` is transported by homeomorphisms. -/
private theorem componentsOfCodimAtLeastTwo_preimage {X Y : Scheme.{u}} (ψ : Y ⟶ X) [IsIso ψ]
    (S : Set X) :
    componentsOfCodimAtLeastTwo (ψ ⁻¹' S) = ψ ⁻¹' componentsOfCodimAtLeastTwo S := by
  ext y
  rw [Set.mem_preimage, mem_componentsOfCodimAtLeastTwo, mem_componentsOfCodimAtLeastTwo]
  constructor
  · rintro ⟨V, hV, h2, hyV⟩
    have hV' := hV
    rw [componentsOf_preimage_of_isIso] at hV'
    obtain ⟨W, hW, rfl⟩ := hV'
    refine ⟨W, hW, ?_, hyV⟩
    rwa [← codimension_irreducibleClosure_preimage ψ hW.1.1 hV.1.1]
  · rintro ⟨W, hW, h2, hyW⟩
    have hV : ψ ⁻¹' W ∈ componentsOf (ψ ⁻¹' S) := by
      rw [componentsOf_preimage_of_isIso]; exact ⟨W, hW, rfl⟩
    refine ⟨ψ ⁻¹' W, hV, ?_, hyW⟩
    rwa [codimension_irreducibleClosure_preimage ψ hW.1.1 hV.1.1]

end Homeomorph

/-! ### Ordered divisors embedded along an isomorphism -/

section Embeds

variable {W X : Scheme.{u}}

/-- `E_W` is `φ⁻¹E_X` with some entries `⊤` (empty) inserted. -/
private def EmbedsAlong (φ : W ⟶ X) (EW : OrderedDivisor W) (EX : OrderedDivisor X) : Prop :=
  ∃ e : Fin EX.s → Fin EW.s, Function.Injective e ∧ (∀ j, EW.E (e j) = (EX.E j).comap φ) ∧
    ∀ l, l ∉ Set.range e → EW.E l = ⊤

/-- The support of `E_W` is the preimage of the support of `E_X`. -/
private theorem EmbedsAlong.support_eq {φ : W ⟶ X} {EW : OrderedDivisor W} {EX : OrderedDivisor X}
    (h : EmbedsAlong φ EW EX) : EW.support = φ ⁻¹' EX.support := by
  obtain ⟨e, -, hEe, htop⟩ := h
  ext y
  simp only [OrderedDivisor.support, Set.mem_iUnion, Set.mem_preimage]
  constructor
  · rintro ⟨l, hl⟩
    by_cases hr : l ∈ Set.range e
    · obtain ⟨j, rfl⟩ := hr
      rw [hEe j] at hl
      exact ⟨j, (mem_support_comap_iff φ _ y).1 hl⟩
    · rw [htop l hr, Scheme.IdealSheafData.support_top] at hl
      exact absurd hl (Set.notMem_empty y)
  · rintro ⟨j, hj⟩
    exact ⟨e j, by rw [hEe j]; exact (mem_support_comap_iff φ _ y).2 hj⟩

/-- A centre having snc with `E_X` pulls back to a centre having snc with `E_W`. -/
private theorem EmbedsAlong.hasSNCWith {φ : W ⟶ X} [IsIso φ] {EW : OrderedDivisor W}
    {EX : OrderedDivisor X} (h : EmbedsAlong φ EW EX) {Z : X.IdealSheafData}
    (hZ : HasSNCWith EX.E Z) : HasSNCWith EW.E (Z.comap φ) := by
  obtain ⟨e, -, hEe, htop⟩ := h
  intro y hy
  have hx : φ y ∈ (Z.support : Set X) := (mem_support_comap_iff φ Z y).1 hy
  obtain ⟨n, z, c, J, hz, hc, hinj, hJ⟩ := hZ (φ y) hx
  haveI : IsIso (φ.stalkMap y) := ((isIso_iff_isIso_stalkMap φ).1 inferInstance).2 y
  let ρ := (asIso (φ.stalkMap y)).commRingCatIsoToRingEquiv
  have hl : ∀ l : {l // y ∈ (EW.E l).support}, ∃ j, e j = l.1 := fun l => by
    by_contra hne
    have h0 := htop l.1 fun ⟨j, hj⟩ => hne ⟨j, hj⟩
    have h2 := l.2
    rw [h0, Scheme.IdealSheafData.support_top] at h2
    exact h2
  choose j hj using hl
  have hjx : ∀ l, φ y ∈ (EX.E (j l)).support := fun l => by
    have h2 := l.2
    rw [← hj l, hEe] at h2
    exact (mem_support_comap_iff φ _ y).1 h2
  refine ⟨n, fun i => ρ (z i), fun l => c ⟨j l, hjx l⟩, J,
    isRegularSystemOfParameters_map_ringEquiv ρ hz, fun l => ?_, fun l l' hll' => ?_, ?_⟩
  · rw [← hj l, hEe, IdealSheafData.stalk_comap, hc ⟨j l, hjx l⟩, Ideal.map_span,
      Set.image_singleton]
    rfl
  · have hjj : j l = j l' := congrArg Subtype.val (hinj hll')
    exact Subtype.ext (by rw [← hj l, ← hj l', hjj])
  · rw [IdealSheafData.stalk_comap, hJ, Ideal.map_span, ← Set.image_comp]
    rfl

/-- The embedding is carried to the total transforms under blowing up a centre and its
preimage. -/
private theorem EmbedsAlong.totalTransform_comap {φ : W ⟶ X} [IsIso φ] {EW : OrderedDivisor W}
    {EX : OrderedDivisor X} (h : EmbedsAlong φ EW EX) (Z : X.IdealSheafData) :
    EmbedsAlong (canonicalLift φ Z) (EW.totalTransform (Z.comap φ)) (EX.totalTransform Z) := by
  have hsupp := h.support_eq
  obtain ⟨e, he, hEe, htop⟩ := h
  haveI := Kollar.isIso_canonicalLift φ Z
  have hφ1 := canonicalLift_comp_blowUpToBase φ Z
  have hc : ∀ A : Set X, blowUpToBase (Z.comap φ) ⁻¹' (φ ⁻¹' A) =
      canonicalLift φ Z ⁻¹' (blowUpToBase Z ⁻¹' A) := fun A => by
    ext x
    simp only [Set.mem_preimage]
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hφ1]
  have hsZ : ((Z.comap φ).support : Set W) = φ ⁻¹' Z.support := by
    rw [Scheme.IdealSheafData.support_comap]; rfl
  have hC2 : componentsOfCodimAtLeastTwo ((Z.comap φ).support : Set W) =
      φ ⁻¹' componentsOfCodimAtLeastTwo (Z.support : Set X) := by
    rw [hsZ, componentsOfCodimAtLeastTwo_preimage]
  -- the sets defining the entries
  have hcast : ∀ j, totalTransformSet EW (Z.comap φ) (e j).castSucc =
      canonicalLift φ Z ⁻¹' totalTransformSet EX Z j.castSucc := fun j => by
    simp only [totalTransformSet, Fin.snoc_castSucc]
    rw [hEe, Scheme.IdealSheafData.support_comap, hC2, ← hc]
    rfl
  have hcast0 : ∀ l, l ∉ Set.range e → totalTransformSet EW (Z.comap φ) l.castSucc = ∅ :=
    fun l hl => by
      simp only [totalTransformSet, Fin.snoc_castSucc]
      rw [htop l hl, Scheme.IdealSheafData.support_top]
      simp
  have hlast : totalTransformSet EW (Z.comap φ) (Fin.last _) =
      canonicalLift φ Z ⁻¹' totalTransformSet EX Z (Fin.last _) := by
    simp only [totalTransformSet, Fin.snoc_last]
    ext x
    simp only [Set.mem_iUnion, Set.mem_preimage, exists_prop]
    rw [hsZ, componentsOf_preimage_of_isIso, hsupp, componentsOf_preimage_of_isIso]
    constructor
    · rintro ⟨V, ⟨W', hW', rfl⟩, hV, hx⟩
      exact ⟨W', hW', fun h => hV ⟨W', h, rfl⟩, (Set.ext_iff.1 (hc W') x).1 hx⟩
    · rintro ⟨W', hW', hW'E, hx⟩
      refine ⟨φ ⁻¹' W', ⟨W', hW', rfl⟩, ?_, (Set.ext_iff.1 (hc W') x).2 hx⟩
      rintro ⟨W'', hW'', heq⟩
      exact hW'E (Set.preimage_injective.2 φ.homeomorph.surjective heq ▸ hW'')
  -- the assignment
  let e' : Fin (EX.s + 1) → Fin (EW.s + 1) :=
    fun j => Fin.lastCases (Fin.last _) (fun j => (e j).castSucc) j
  have he'c : ∀ j, e' j.castSucc = (e j).castSucc := fun j => Fin.lastCases_castSucc _
  have he'l : e' (Fin.last _) = Fin.last _ := Fin.lastCases_last
  refine ⟨e', fun j j' hjj => ?_, fun j => ?_, fun l hl => ?_⟩
  · induction j using Fin.lastCases with
    | last =>
      induction j' using Fin.lastCases with
      | last => rfl
      | cast j' => rw [he'l, he'c] at hjj; exact absurd hjj.symm (Fin.castSucc_ne_last _)
    | cast j =>
      induction j' using Fin.lastCases with
      | last => rw [he'l, he'c] at hjj; exact absurd hjj (Fin.castSucc_ne_last _)
      | cast j' =>
        rw [he'c, he'c] at hjj
        rw [he (Fin.castSucc_injective _ hjj)]
  · induction j using Fin.lastCases with
    | last =>
      rw [he'l]
      change (EW.totalTransform (Z.comap φ)).E (Fin.last _) = _
      rw [totalTransform_E_eq, totalTransform_E_eq, comap_vanishingIdeal_closure_of_isIso, hlast]
    | cast j =>
      rw [he'c]
      change (EW.totalTransform (Z.comap φ)).E (e j).castSucc = _
      rw [totalTransform_E_eq, totalTransform_E_eq, comap_vanishingIdeal_closure_of_isIso, hcast]
  · change (EW.totalTransform (Z.comap φ)).E l = ⊤
    induction l using Fin.lastCases with
    | last => exact absurd ⟨Fin.last _, he'l⟩ hl
    | cast l =>
      have hl' : l ∉ Set.range e := fun ⟨j, hj⟩ => hl ⟨j.castSucc, by rw [he'c, hj]⟩
      rw [totalTransform_E_eq, hcast0 l hl', vanishingIdeal_closure_empty]

/-- The total transform under the blow-up of an effective Cartier divisor `D` whose components
are components of the boundary, and of codimension one. -/
private theorem EmbedsAlong.totalTransform_of_isEffectiveCartierDivisor {φ : W ⟶ X}
    {EW : OrderedDivisor W} {EX : OrderedDivisor X} (h : EmbedsAlong φ EW EX)
    (D : W.IdealSheafData) [IsIso (blowUpToBase D)]
    (hred : ∀ l, EW.E l = Scheme.IdealSheafData.vanishingIdeal (EW.E l).support)
    (h2 : componentsOfCodimAtLeastTwo (D.support : Set W) = ∅)
    (hcomp : ∀ V ∈ componentsOf (D.support : Set W), V ∈ componentsOf EW.support) :
    EmbedsAlong (blowUpToBase D ≫ φ) (EW.totalTransform D) EX := by
  obtain ⟨e, he, hEe, htop⟩ := h
  refine ⟨fun j => (e j).castSucc, fun j j' hjj => he (Fin.castSucc_injective _ hjj),
    fun j => ?_, fun l hl => ?_⟩
  · change (EW.totalTransform D).E (e j).castSucc = _
    rw [totalTransform_E_eq, Scheme.IdealSheafData.comap_comp, ← hEe, hred (e j),
      show (EW.E (e j)).support = TopologicalSpace.Closeds.closure ((EW.E (e j)).support : Set W)
        from (TopologicalSpace.Closeds.ext (EW.E (e j)).support.isClosed.closure_eq).symm,
      comap_vanishingIdeal_closure_of_isIso]
    simp only [totalTransformSet, Fin.snoc_castSucc, h2, Set.diff_empty]
  · change (EW.totalTransform D).E l = ⊤
    induction l using Fin.lastCases with
    | last =>
      rw [totalTransform_E_eq]
      have hempty : totalTransformSet EW D (Fin.last _) = ∅ := by
        simp only [totalTransformSet, Fin.snoc_last]
        ext x
        simp only [Set.mem_iUnion, Set.mem_empty_iff_false, iff_false, not_exists]
        intro V hV hVE _
        exact hVE (hcomp V hV)
      rw [hempty, vanishingIdeal_closure_empty]
    | cast l =>
      have hl' : l ∉ Set.range e := fun ⟨j, hj⟩ => hl ⟨j, congrArg Fin.castSucc hj⟩
      rw [totalTransform_E_eq]
      have hempty : totalTransformSet EW D l.castSucc = ∅ := by
        simp only [totalTransformSet, Fin.snoc_castSucc]
        rw [htop l hl', Scheme.IdealSheafData.support_top]
        simp
      rw [hempty, vanishingIdeal_closure_empty]

/-- The entries of a total transform are reduced. -/
private theorem totalTransform_E_eq_vanishingIdeal (E : OrderedDivisor X) (Z : X.IdealSheafData)
    (l : Fin (E.totalTransform Z).s) :
    (E.totalTransform Z).E l =
      Scheme.IdealSheafData.vanishingIdeal ((E.totalTransform Z).E l).support := by
  rw [totalTransform_E_eq E Z l]
  congr 1

end Embeds

/-! ### The exceptional divisor of a blow-up with snc centre -/

section Exceptional

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- At every point of the exceptional divisor of the blow-up of a centre having snc with a
divisor, the exceptional divisor is cut out by one member of a regular system of parameters. -/
private theorem exists_stalk_exceptional_eq_span_parameter [IsLocallyNoetherian X]
    {Λ : Type*} {E : Λ → X.IdealSheafData} {Z : X.IdealSheafData} (hZ : HasSNCWith E Z) :
    ∀ x ∈ (Z.comap (blowUpToBase Z)).support, ∃ (m : ℕ)
      (w : Fin m → (blowUp Z).presheaf.stalk x) (j : Fin m),
      IsRegularSystemOfParameters w ∧
        IdealSheafData.stalk (Z.comap (blowUpToBase Z)) x = Ideal.span {w j} := by
  intro x hx
  have hx' : blowUpToBase Z x ∈ Z.support := (mem_support_comap_iff _ Z x).1 hx
  obtain ⟨n, z, c, J, hz, -, -, hJ⟩ := hZ _ hx'
  obtain ⟨N, w, m, i₀, σ, U, hw, hmJ, -, hwi0, -, hJm, hUu, -⟩ :=
    exists_chart_coordinates Z x hx' hz hJ
  refine ⟨N, w, i₀, hw, ?_⟩
  rw [IdealSheafData.stalk_comap, hJ, Ideal.map_span]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
    by_cases hjm : j = m
    · subst hjm
      rw [← hwi0]
      exact Ideal.subset_span rfl
    · by_cases hjU : j ∈ U
      · obtain ⟨u, -, hu⟩ := hUu j hjU
        rw [hu]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      · rw [hJm j hj hjm hjU]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · rw [Ideal.span_le, Set.singleton_subset_iff, hwi0]
    exact Ideal.subset_span ⟨z m, ⟨m, hmJ, rfl⟩, rfl⟩

/-- A component of a closed set of pure codimension one has codimension one. -/
public theorem codimension_eq_one_of_mem_componentsOf {Y : Scheme.{u}}
    {S : TopologicalSpace.Closeds Y} (hS : IsPureCodimOne S) {W : Set Y}
    (hW : W ∈ componentsOf (S : Set Y)) : codimension (irreducibleClosure hW.1.1) = 1 := by
  have hWc : IsClosed W := isClosed_of_mem_componentsOf S.isClosed hW
  let W₀ : TopologicalSpace.IrreducibleCloseds Y := ⟨W, hW.1.1, hWc⟩
  have he : irreducibleClosure hW.1.1 = W₀ :=
    TopologicalSpace.IrreducibleCloseds.ext hWc.closure_eq
  rw [he]
  exact hS W₀ ⟨hW.1.2, fun V hV hWV => hW.2 ⟨V.isIrreducible, hV⟩ hWV⟩

/-- The exceptional divisor lies in the total transform of the boundary. -/
private theorem support_exceptional_subset (E : OrderedDivisor X)
    (hE : ∀ i, IsPureCodimOne (E.E i).support) (Z : X.IdealSheafData) :
    ((Z.comap (blowUpToBase Z)).support : Set (blowUp Z)) ⊆ (E.totalTransform Z).support := by
  rw [OrderedDivisor.support_totalTransform E hE Z]
  exact fun x hx => Or.inr ((mem_support_comap_iff _ Z x).1 hx)

/-- The exceptional divisor has snc with the total transform of the boundary. -/
private theorem hasSNCWith_exceptional (sX : X ⟶ Spec (.of k)) [IsLocallyNoetherian X]
    (E : OrderedDivisor X) (hE : ∀ i, IsPureCodimOne (E.E i).support)
    {Z : X.IdealSheafData} (hZ : HasSNCWith E.E Z)
    (hE' : (E.totalTransform Z).IsSNC (blowUpToBase Z ≫ sX)) :
    HasSNCWith (E.totalTransform Z).E (Z.comap (blowUpToBase Z)) := by
  haveI : IsLocallyNoetherian (blowUp Z) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase Z)
  intro x hx
  obtain ⟨m, w, i₀, hw, hFx⟩ := exists_stalk_exceptional_eq_span_parameter hZ x hx
  obtain ⟨n, z, c, hz, hc, hinj⟩ := hE'.2 x
  have hP := span_singleton_isPrime_of_isRegularSystemOfParameters hw i₀
  let q : PrimeSpectrum ((blowUp Z).presheaf.stalk x) := ⟨Ideal.span {w i₀}, hP⟩
  have hq : (blowUp Z).fromSpecStalk x q ∈
      ((Z.comap (blowUpToBase Z)).support : Set (blowUp Z)) :=
    (fromSpecStalk_mem_support_iff_stalk_le _ x q).2 hFx.le
  obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (support_exceptional_subset E hE Z hq)
  have hle := (fromSpecStalk_mem_support_iff_stalk_le _ x q).1 hl
  have hxl : x ∈ ((E.totalTransform Z).E l).support := by
    by_contra h
    rw [(IdealSheafData.stalk_eq_top_iff_notMem_support _ x).2 h] at hle
    exact hP.ne_top (top_le_iff.1 hle)
  have hmem : z (c ⟨l, hxl⟩) ∈ Ideal.span {w i₀} :=
    hle ((hc ⟨l, hxl⟩) ▸ Ideal.subset_span rfl)
  have hwm : w i₀ ∈ maximalIdeal _ := hw.1 ▸ Ideal.subset_span ⟨i₀, rfl⟩
  have heq := span_eq_of_mem_span_singleton hz _ hwm hmem
  refine ⟨n, z, c, {c ⟨l, hxl⟩}, hz, hc, hinj, ?_⟩
  rw [hFx, ← heq, Finset.coe_singleton, Set.image_singleton]

/-- Every component of the exceptional divisor is a component of the total transform of the
boundary. -/
private theorem mem_componentsOf_support_totalTransform [IsLocallyNoetherian X]
    (E : OrderedDivisor X) (hE : ∀ i, IsPureCodimOne (E.E i).support)
    {Z : X.IdealSheafData} (hZ : HasSNCWith E.E Z)
    (hE' : ∀ i, IsPureCodimOne ((E.totalTransform Z).E i).support) :
    ∀ V ∈ componentsOf ((Z.comap (blowUpToBase Z)).support : Set (blowUp Z)),
      V ∈ componentsOf (E.totalTransform Z).support := by
  classical
  haveI : IsLocallyNoetherian (blowUp Z) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase Z)
  intro V hV
  have hF := isPureCodimOne_support_of_stalk_eq_span_parameter _
    (exists_stalk_exceptional_eq_span_parameter hZ)
  have hVc : IsClosed V :=
    isClosed_of_mem_componentsOf (Z.comap (blowUpToBase Z)).support.isClosed hV
  have hcodV := codimension_eq_one_of_mem_componentsOf hF hV
  refine ⟨⟨hV.1.1, hV.1.2.trans (support_exceptional_subset E hE Z)⟩, fun T hT hVT => ?_⟩
  have hEc : IsClosed (E.totalTransform Z).support :=
    isClosed_iUnion_of_finite fun i => ((E.totalTransform Z).E i).support.isClosed
  let T₀ : TopologicalSpace.IrreducibleCloseds (blowUp Z) :=
    ⟨closure T, hT.1.closure, isClosed_closure⟩
  let V₀ : TopologicalSpace.IrreducibleCloseds (blowUp Z) := ⟨V, hV.1.1, hVc⟩
  have hT₀E : (T₀ : Set (blowUp Z)) ⊆ (E.totalTransform Z).support :=
    hEc.closure_subset_iff.2 hT.2
  have hVT₀ : V₀ ≤ T₀ := fun x hx => subset_closure (hVT hx)
  have hcodT : codimension T₀ ≠ 0 := by
    intro h0
    have hmax : IsMax T₀ := Order.coheight_eq_zero.1 h0
    obtain ⟨_, hz, hTz⟩ := isIrreducible_iff_sUnion_isClosed.mp T₀.isIrreducible
      (Finset.univ.image fun i => (((E.totalTransform Z).E i).support : Set (blowUp Z)))
      (fun z hz => by
        obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hz
        exact ((E.totalTransform Z).E i).support.isClosed)
      (by
        intro x hx
        obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hT₀E hx)
        exact Set.mem_sUnion.2 ⟨_, Finset.mem_coe.2 (Finset.mem_image.2
          ⟨i, Finset.mem_univ _, rfl⟩), hi⟩)
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hz
    have h1 := hE' i T₀ ⟨hTz, fun W _ hW => hmax hW⟩
    rw [h0] at h1
    exact zero_ne_one h1
  have hVeq : V₀ = T₀ := by
    by_contra hne
    have hlt : V₀ < T₀ := lt_of_le_of_ne hVT₀ hne
    have h := Order.coheight_add_one_le hlt
    have hV1 : codimension V₀ = 1 := by
      rw [← hcodV]; congr 1
      exact (TopologicalSpace.IrreducibleCloseds.ext hVc.closure_eq).symm
    rw [← codimension_eq_coheight, ← codimension_eq_coheight, hV1] at h
    exact hcodT (nonpos_iff_eq_zero.1
      ((ENat.add_le_add_iff_right ENat.one_ne_top).1 (by simpa using h)))
  intro x hx
  have : x ∈ (T₀ : Set (blowUp Z)) := subset_closure hx
  rwa [← hVeq] at this

/-- The exceptional divisor has no component of codimension `≥ 2`. -/
private theorem componentsOfCodimAtLeastTwo_exceptional [IsLocallyNoetherian X]
    {Λ : Type*} {E : Λ → X.IdealSheafData} {Z : X.IdealSheafData} (hZ : HasSNCWith E Z) :
    componentsOfCodimAtLeastTwo ((Z.comap (blowUpToBase Z)).support : Set (blowUp Z)) = ∅ := by
  haveI : IsLocallyNoetherian (blowUp Z) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase Z)
  have hF := isPureCodimOne_support_of_stalk_eq_span_parameter _
    (exists_stalk_exceptional_eq_span_parameter hZ)
  ext y
  simp only [Set.mem_empty_iff_false, iff_false]
  rw [mem_componentsOfCodimAtLeastTwo]
  rintro ⟨W, hW, h2, -⟩
  rw [codimension_eq_one_of_mem_componentsOf hF hW] at h2
  exact absurd h2 (by decide)

end Exceptional

/-! ### The induction -/

/-- The condition of the statement on a sequence of order-one transformations. -/
private abbrev IsSmoothingTransformSeq {k : Type u} [Field k] {V : Scheme.{u}}
    (sV : V ⟶ Spec (.of k))
    (T : OrderedDivisorTuple V) (i : Fin T.m) {S : Scheme.{u}} (B : ClosedBlowupSequence S)
    (p : S ⟶ V) (T' : OrderedDivisorTuple S) : Prop :=
  ClosedBlowupSequence.rec
    (motive := fun S _ => (S ⟶ V) → OrderedDivisorTuple S → Prop)
    (fun _ p T' => ∀ h : i.val < T'.m, MMP.Mori.IsSmoothScheme
      ((Scheme.IdealSheafData.vanishingIdeal (T'.I ⟨i, h⟩).support).subschemeι ≫ p ≫ sV) ∧
      T'.I ⟨i, h⟩ = Scheme.IdealSheafData.vanishingIdeal (T'.I ⟨i, h⟩).support ∧
      ∀ x ∈ ((T'.I ⟨i, h⟩).support : Set _), ∃ (n : ℕ) (z : Fin n → _) (j : Fin n),
        MMP.Mori.IsRegularSystemOfParameters z ∧
          IdealSheafData.stalk (T'.I ⟨i, h⟩) x = Ideal.span {z j})
    (fun Z _ ih p T' => T'.IsTransformCentre (p ≫ sV) Z ∧
      Disjoint (Z.support : Set _) (p ⁻¹' T.sncLocus) ∧
      Disjoint (Z.support : Set _) T'.sncLocus ∧
      ih (blowUpToBase Z ≫ p) (T'.transform Z))
    B p T'

/-- The first stage of a marked sequence of order `≥ m` is a triple. -/
private theorem isTriple_of_isOrderGeMarkedTripleSeq {k : Type u} [Field k] {X : Scheme.{u}}
    {s : X ⟶ Spec (.of k)} {a : MarkedIdeal X} {E : OrderedDivisor X}
    {B : ClosedBlowupSequence X} (h : B.IsOrderGeMarkedTripleSeq s a E) : IsTriple s a.I E := by
  cases B with
  | nil => exact h
  | cons Z B => exact h.1

/-- The induction on a marked sequence of mark two reducing the order below two: a tuple on
`W ≅ X` whose `i`-th ideal is the pullback of the marked ideal and whose boundary embeds into the
boundary of `X` admits a sequence of order-one transformations as in the statement. -/
private theorem exists_isSmoothingTransformSeq {k : Type u} [Field k] [CharZero k]
    {V : Scheme.{u}}
    (sV : V ⟶ Spec (.of k)) (T : OrderedDivisorTuple V) (i : Fin T.m) {X : Scheme.{u}}
    (B0 : ClosedBlowupSequence X) :
    ∀ (sX : X ⟶ Spec (.of k)) (a : MarkedIdeal X) (EX : OrderedDivisor X), a.m = 2 →
      B0.IsOrderGeMarkedTripleSeq sX a EX → maxOrder (B0.markedTransform a).I < 2 →
      HasPrincipalStalks a.I →
      ∀ {W : Scheme.{u}} (φ : W ⟶ X) [IsIso φ] (p : W ⟶ V), p ≫ sV = φ ≫ sX →
      ∀ (T' : OrderedDivisorTuple W) (hi : i.val < T'.m), T'.I ⟨i, hi⟩ = a.I.comap φ →
      EmbedsAlong φ T'.E EX → (∀ y, p y ∈ T.sncLocus → multAt a.I (φ y) ≤ 1) →
      ∃ B : ClosedBlowupSequence W, IsSmoothingTransformSeq sV T i B p T' := by
  induction B0 with
  | nil X =>
    intro sX a EX ha hB hfin hprin W φ _ p hp T' hi hI hE hsnc
    obtain ⟨-, hXsm, hlft, -, -, -, -⟩ := hB
    haveI : LocallyOfFiniteType sX := hlft
    refine ⟨.nil W, fun h => ?_⟩
    have hI' : T'.I ⟨i, h⟩ = a.I.comap φ := hI
    have hord : ∀ x, multAt a.I x ≤ 1 := fun x =>
      Order.le_of_lt_add_one <| one_add_one_eq_two (R := ℕ∞) ▸
        (le_iSup₂_of_le x (Set.mem_univ x) le_rfl).trans_lt hfin
    have hsm := isSmoothScheme_vanishingIdeal_support sX hXsm a.I hprin hord
    have hred := eq_vanishingIdeal_support sX hXsm a.I hprin hord
    have key := isSmoothScheme_comap_subschemeι φ _ hsm
    rw [comap_vanishingIdeal_of_isIso] at key
    have hsupp : (a.I.comap φ).support =
        ⟨φ ⁻¹' a.I.support, a.I.support.isClosed.preimage φ.continuous⟩ := by
      rw [Scheme.IdealSheafData.support_comap]; rfl
    refine ⟨?_, ?_, ?_⟩
    · rw [hI', hp, hsupp]
      exact key
    · calc T'.I ⟨i, h⟩ = (Scheme.IdealSheafData.vanishingIdeal a.I.support).comap φ := by
            rw [hI', ← hred]
        _ = _ := comap_vanishingIdeal_of_isIso _ _
        _ = _ := by rw [hI', hsupp]
    · rw [hI']
      exact exists_stalk_comap_eq_span_parameter φ a.I
        (exists_stalk_eq_span_parameter_of_hasPrincipalStalks sX hXsm a.I hprin hord)
  | @cons X Z B1 ih =>
    intro sX a EX ha hB hfin hprin W φ _ p hp T' hi hI hE hsnc
    obtain ⟨htr, hZsm, hZcodim, hZsnc, hZord, hB1⟩ := hB
    obtain ⟨-, hXsm, hlft, -, -, -, hEsnc⟩ := htr
    haveI : LocallyOfFiniteType sX := hlft
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
    obtain ⟨-, hX1sm, hlft1, -, -, -, hE1snc⟩ := isTriple_of_isOrderGeMarkedTripleSeq hB1
    haveI : LocallyOfFiniteType (blowUpToBase Z ≫ sX) := hlft1
    haveI : IsLocallyNoetherian (blowUp Z) :=
      LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase Z ≫ sX)
    have hZord2 : OrderAlongGE a.I (Z.support : Set X) (2 : ℕ) := by rwa [← ha]
    have hEpc : ∀ j, IsPureCodimOne (EX.E j).support := fun j => (hEsnc.2.1 j).2.1
    have hE1pc : ∀ j, IsPureCodimOne ((EX.totalTransform Z).E j).support :=
      fun j => (hE1snc.2.1 j).2.1
    -- the first blow-up and its comparison with the blow-up of `Z`
    haveI : IsIso (canonicalLift φ Z) := Kollar.isIso_canonicalLift φ Z
    have hφ1 : canonicalLift φ Z ≫ blowUpToBase Z = blowUpToBase (Z.comap φ) ≫ φ :=
      canonicalLift_comp_blowUpToBase φ Z
    have hF' : (Z.comap φ).comap (blowUpToBase (Z.comap φ)) =
        (Z.comap (blowUpToBase Z)).comap (canonicalLift φ Z) := by
      rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, hφ1]
    have hFxcart : Stacks.Divisors.IsEffectiveCartierDivisor (Z.comap (blowUpToBase Z)) :=
      Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal Z
    have hF'cart : Stacks.Divisors.IsEffectiveCartierDivisor
        ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) :=
      Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal _
    haveI : IsIso (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ)))) :=
      isIso_blowUpToBase_of_isEffectiveCartierDivisor _ hF'cart
    -- the ideal
    have hA2 : a.I.comap (blowUpToBase Z) ≤ Z.comap (blowUpToBase Z) ^ 2 :=
      comap_le_comap_pow_of_stalk_le _ _ _ _
        (stalk_le_pow_of_orderAlongGE sX hXsm Z hZsm a.I 2 hZord2)
    have hsub1 : ((Z.comap φ).support : Set W) ⊆ ((T'.I ⟨i, hi⟩).support : Set W) := by
      intro y hy
      have hy' := (mem_support_comap_iff φ Z y).1 hy
      rw [hI]
      exact (mem_support_comap_iff φ a.I y).2
        (subset_support_of_orderAlongGE (by norm_num) hZord2 hy')
    have hT1I : (T'.transform (Z.comap φ)).I ⟨i, hi⟩ =
        (idealColon (a.I.comap (blowUpToBase Z)) (Z.comap (blowUpToBase Z))).comap
          (canonicalLift φ Z) := by
      refine (OrderedDivisorTuple.transform_I_of_le T' (Z.comap φ) ⟨i, hi⟩ hsub1).trans ?_
      rw [hI, ← Scheme.IdealSheafData.comap_comp,
        ← hφ1, Scheme.IdealSheafData.comap_comp, hF',
        comap_idealColon_of_isIso _ _ _ hFxcart (le_of_le_sq hA2)]
    have hQF := idealColon_le _ _ hFxcart hA2
    have hsub2 : (((Z.comap φ).comap (blowUpToBase (Z.comap φ))).support :
          Set (blowUp (Z.comap φ))) ⊆
        (((T'.transform (Z.comap φ)).I ⟨i, hi⟩).support : Set (blowUp (Z.comap φ))) := by
      intro y hy
      rw [hF'] at hy
      have hy' := (mem_support_comap_iff _ _ y).1 hy
      rw [hT1I]
      exact (mem_support_comap_iff _ _ y).2 (Scheme.IdealSheafData.support_antitone hQF hy')
    have hF'σ : ((Z.comap φ).comap (blowUpToBase (Z.comap φ))).comap
          (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ)))) =
        (Z.comap (blowUpToBase Z)).comap
          (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫ canonicalLift φ Z) := by
      rw [Scheme.IdealSheafData.comap_comp, ← hF']
    have hT2I : ((T'.transform (Z.comap φ)).transform
          ((Z.comap φ).comap (blowUpToBase (Z.comap φ)))).I ⟨i, hi⟩ =
        (a.birationalTransform Z).I.comap
          (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫ canonicalLift φ Z) := by
      refine (OrderedDivisorTuple.transform_I_of_le (T'.transform (Z.comap φ)) _ ⟨i, hi⟩
        hsub2).trans ?_
      rw [hT1I, hF'σ, ← Scheme.IdealSheafData.comap_comp
          (idealColon (a.I.comap (blowUpToBase Z)) (Z.comap (blowUpToBase Z)))
          (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ)))) (canonicalLift φ Z),
        ← comap_idealColon_of_isIso _ _ _ hFxcart hQF,
        idealColon_idealColon _ _ hFxcart hA2]
      show _ = (idealColon _ (_ ^ a.m)).comap _
      rw [ha]
    -- the boundary
    have hE1 : EmbedsAlong (canonicalLift φ Z) (T'.transform (Z.comap φ)).E
        (EX.totalTransform Z) := hE.totalTransform_comap Z
    have hFxsnc := hasSNCWith_exceptional sX EX hEpc hZsnc hE1snc.2
    have hsuppF' : (((Z.comap φ).comap (blowUpToBase (Z.comap φ))).support : Set _) =
        canonicalLift φ Z ⁻¹' ((Z.comap (blowUpToBase Z)).support : Set _) := by
      rw [hF', Scheme.IdealSheafData.support_comap]; rfl
    have hE2 : EmbedsAlong
        (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫ canonicalLift φ Z)
        ((T'.transform (Z.comap φ)).transform
          ((Z.comap φ).comap (blowUpToBase (Z.comap φ)))).E (EX.totalTransform Z) := by
      refine hE1.totalTransform_of_isEffectiveCartierDivisor _
        (fun l => totalTransform_E_eq_vanishingIdeal _ _ l) ?_ ?_
      · rw [hsuppF', componentsOfCodimAtLeastTwo_preimage,
          componentsOfCodimAtLeastTwo_exceptional hZsnc, Set.preimage_empty]
      · intro V hV
        rw [hsuppF', componentsOf_preimage_of_isIso] at hV
        obtain ⟨V0, hV0, rfl⟩ := hV
        rw [hE1.support_eq, componentsOf_preimage_of_isIso]
        exact ⟨V0, mem_componentsOf_support_totalTransform EX hEpc hZsnc hE1pc V0 hV0, rfl⟩
    -- the snc locus
    have hcentre : ∀ y, y ∈ ((Z.comap φ).support : Set W) → p y ∉ T.sncLocus := by
      intro y hy hy'
      have hz : φ y ∈ (Z.support : Set X) := (mem_support_comap_iff φ Z y).1 hy
      have h1 := hsnc y hy'
      have h2 := two_le_multAt_of_mem_support sX hXsm Z hZsm a.I hZord2 hz
      have : (2 : ℕ∞) ≤ 1 := h2.trans h1
      exact absurd this (by decide)
    have hsnc' : ∀ y, (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫
        blowUpToBase (Z.comap φ) ≫ p) y ∈ T.sncLocus →
        multAt (a.birationalTransform Z).I
          ((blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫
            canonicalLift φ Z) y) ≤ 1 := by
      intro y hy
      set y1 := blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) y
      have hy1 : p (blowUpToBase (Z.comap φ) y1) ∈ T.sncLocus := by
        simpa only [Scheme.Hom.comp_apply] using hy
      have hπ : blowUpToBase Z (canonicalLift φ Z y1) = φ (blowUpToBase (Z.comap φ) y1) := by
        rw [← Scheme.Hom.comp_apply, hφ1, Scheme.Hom.comp_apply]
      have hnot : blowUpToBase Z (canonicalLift φ Z y1) ∉ (Z.support : Set X) := by
        rw [hπ]
        intro hz
        exact hcentre _ ((mem_support_comap_iff φ Z _).2 hz) hy1
      rw [Scheme.Hom.comp_apply, multAt_birationalTransform_of_notMem sX hXsm Z hZsm hZcodim a
        hZord _ hnot, hπ]
      exact hsnc _ hy1
    have hp' : (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫
        blowUpToBase (Z.comap φ) ≫ p) ≫ sV =
        (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫ canonicalLift φ Z) ≫
          blowUpToBase Z ≫ sX := by
      simp only [Category.assoc, hp, reassoc_of% hφ1]
    obtain ⟨B', hB'⟩ := ih (blowUpToBase Z ≫ sX) (a.birationalTransform Z) (EX.totalTransform Z)
      ha hB1 hfin
      (hasPrincipalStalks_birationalTransform sX hXsm Z hZsm hZcodim a hZord hprin)
      (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫ canonicalLift φ Z)
      (blowUpToBase ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) ≫
        blowUpToBase (Z.comap φ) ≫ p) hp'
      ((T'.transform (Z.comap φ)).transform ((Z.comap φ).comap (blowUpToBase (Z.comap φ))))
      hi hT2I hE2 hsnc'
    refine ⟨.cons (Z.comap φ) (.cons ((Z.comap φ).comap (blowUpToBase (Z.comap φ))) B'),
      ⟨?_, hE.hasSNCWith hZsnc⟩, ?_, ?_, ⟨?_, ?_⟩, ?_, ?_, hB'⟩
    · rw [hp]
      exact isSmoothScheme_comap_subschemeι φ Z hZsm
    · exact Set.disjoint_left.2 fun y hy hy' => hcentre y hy hy'
    · refine Set.disjoint_left.2 fun y hy hy' => ?_
      have hz : φ y ∈ (Z.support : Set X) := (mem_support_comap_iff φ Z y).1 hy
      haveI : IsLocallyNoetherian W := isLocallyNoetherian_of_isOpenImmersion φ
      haveI : IsIso (φ.stalkMap y) := ((isIso_iff_isIso_stalkMap φ).1 inferInstance).2 y
      have h1 := multAt_le_one_of_mem_sncLocus T' ⟨i, hi⟩ hy'
      rw [hI, multAt_comap_of_isIso_stalkMap φ y a.I] at h1
      have h2 := two_le_multAt_of_mem_support sX hXsm Z hZsm a.I hZord2 hz
      exact absurd (h2.trans h1) (by decide)
    · have hFxsm : IsSmoothScheme ((Z.comap (blowUpToBase Z)).subschemeι ≫ blowUpToBase Z ≫ sX) :=
        isSmoothScheme_subschemeι_of_hasSNCWith _ hX1sm _ hFxsnc
      have e : (blowUpToBase (Z.comap φ) ≫ p) ≫ sV = canonicalLift φ Z ≫ blowUpToBase Z ≫ sX := by
        simp only [Category.assoc, hp, reassoc_of% hφ1]
      rw [e, hF']
      exact isSmoothScheme_comap_subschemeι _ _ hFxsm
    · rw [hF']
      exact hE1.hasSNCWith hFxsnc
    · refine Set.disjoint_left.2 fun y hy hy' => hcentre _ ?_ hy'
      exact (mem_support_comap_iff _ _ y).1 hy
    · refine Set.disjoint_left.2 fun y hy hy' => ?_
      haveI : IsLocallyNoetherian W := isLocallyNoetherian_of_isOpenImmersion φ
      haveI : IsLocallyNoetherian (blowUp (Z.comap φ)) :=
        LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase (Z.comap φ))
      obtain ⟨m', w, i₀, hw, hFw⟩ :=
        exists_stalk_exceptional_eq_span_parameter (hE.hasSNCWith hZsnc) y hy
      have hIF : (T'.transform (Z.comap φ)).I ⟨i, hi⟩ ≤
          (Z.comap φ).comap (blowUpToBase (Z.comap φ)) := by
        rw [hT1I, hF']
        exact Scheme.IdealSheafData.comap_mono _ hQF
      have hFE : (((Z.comap φ).comap (blowUpToBase (Z.comap φ))).support : Set _) ⊆
          (T'.transform (Z.comap φ)).E.support := by
        rw [hE1.support_eq, hsuppF']
        exact Set.preimage_mono (support_exceptional_subset EX hEpc Z)
      obtain ⟨n, z, c, hz, hc, hzc⟩ := hy'
      let P : PrimeSpectrum ((blowUp (Z.comap φ)).presheaf.stalk y) :=
        ⟨Ideal.span {w i₀}, span_singleton_isPrime_of_isRegularSystemOfParameters hw i₀⟩
      have hPF : (blowUp (Z.comap φ)).fromSpecStalk y P ∈
          (((Z.comap φ).comap (blowUpToBase (Z.comap φ))).support : Set _) :=
        (fromSpecStalk_mem_support_iff_stalk_le _ y P).2 hFw.le
      obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (hFE hPF)
      have hyl : y ∈ ((T'.transform (Z.comap φ)).E.E l).support :=
        (fromSpecStalk_specializes_self y P).mem_closed
          ((T'.transform (Z.comap φ)).E.E l).support.isClosed hl
      have hyi : y ∈ ((T'.transform (Z.comap φ)).I ⟨i, hi⟩).support :=
        Scheme.IdealSheafData.support_antitone hIF hy
      have hle := (fromSpecStalk_mem_support_iff_stalk_le _ y P).1 hl
      rw [show IdealSheafData.stalk ((T'.transform (Z.comap φ)).E.E l) y =
        Ideal.span {z (c ⟨.inr l, hyl⟩)} from hzc ⟨.inr l, hyl⟩] at hle
      have hIle : IdealSheafData.stalk ((T'.transform (Z.comap φ)).I ⟨i, hi⟩) y ≤
          Ideal.span {w i₀} := hFw ▸ stalk_le_stalk_of_le hIF y
      rw [show IdealSheafData.stalk ((T'.transform (Z.comap φ)).I ⟨i, hi⟩) y =
        Ideal.span {z (c ⟨.inl ⟨i, hi⟩, hyi⟩)} from hzc ⟨.inl ⟨i, hi⟩, hyi⟩] at hIle
      have hwm : w i₀ ∈ maximalIdeal _ := hw.1 ▸ Ideal.subset_span ⟨i₀, rfl⟩
      have e1 := span_eq_of_mem_span_singleton hz _ hwm (hle (Ideal.mem_span_singleton_self _))
      have e2 := span_eq_of_mem_span_singleton hz _ hwm (hIle (Ideal.mem_span_singleton_self _))
      have := isRegularLocalRing_of_isRegularSystemOfParameters hz
      exact Sum.inr_ne_inl (congrArg Subtype.val
        (hc (span_singleton_injective_of_isRegularSystemOfParameters hz (e1.trans e2.symm))))

section

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

/-- **Smoothing one divisor without changing the snc locus.** For an ordered divisor tuple
`T = ((I_1, …, I_m), E)` on `V` over `k` and an index `i`, there is a blow-up sequence `B`
starting with `V` whose centres are, stage by stage, centres of order-one transformations of
the current tuple disjoint from the inverse image of `T.sncLocus` and from the snc locus of the
current tuple, and such that, for the final tuple `T_r` on `V_r` (over `k` through
`p : V_r → V`), the cosupport of `I_i` of `T_r`, with its reduced structure, is smooth over `k`;
moreover `I_i` of `T_r` is that reduced ideal, and its stalk at each point of its cosupport is
generated by a member of a regular system of parameters. -/
@[mmp "lem_mmp_tuple_first_divisor_smooth"]
public theorem OrderedDivisorTuple.exists_transform_isSmoothScheme_support {k : Type u} [Field k]
    {V : Scheme.{u}} (sV : V ⟶ Spec (.of k)) (T : OrderedDivisorTuple V)
    (hT : IsOrderedDivisorTuple sV T) (i : Fin T.m) :
    ∃ B : ClosedBlowupSequence V,
      ClosedBlowupSequence.rec
        (motive := fun S _ => (S ⟶ V) → OrderedDivisorTuple S → Prop)
        (fun _ p T' => ∀ h : i.val < T'.m, MMP.Mori.IsSmoothScheme
          ((Scheme.IdealSheafData.vanishingIdeal (T'.I ⟨i, h⟩).support).subschemeι ≫ p ≫ sV) ∧
          T'.I ⟨i, h⟩ = Scheme.IdealSheafData.vanishingIdeal (T'.I ⟨i, h⟩).support ∧
          ∀ x ∈ ((T'.I ⟨i, h⟩).support : Set _), ∃ (n : ℕ) (z : Fin n → _) (j : Fin n),
            MMP.Mori.IsRegularSystemOfParameters z ∧
              IdealSheafData.stalk (T'.I ⟨i, h⟩) x = Ideal.span {z j})
        (fun Z _ ih p T' => T'.IsTransformCentre (p ≫ sV) Z ∧
          Disjoint (Z.support : Set _) (p ⁻¹' T.sncLocus) ∧
          Disjoint (Z.support : Set _) T'.sncLocus ∧
          ih (blowUpToBase Z ≫ p) (T'.transform Z))
        B (𝟙 V) T := by
  obtain ⟨hchar, hvar, hsm, hI, hE⟩ := hT
  haveI : CharZero k := hchar
  haveI : AlgebraicGeometry.IsVariety k sV := hvar
  haveI : IsIntegral V := hvar.toIsIntegral
  haveI : IsLocallyNoetherian V := LocallyOfFiniteType.isLocallyNoetherian sV
  obtain ⟨F, -, hF⟩ := exists_isOrderReductionFunctorMarked_bmoFamily.{u} 2 (by norm_num)
  let t : MarkedTriple.{u} := ⟨⟨⟨V, T.I i, T.E⟩, k, sV⟩, 2⟩
  have hnz : IsNonzeroAtGenericPoints (T.I i) := fun η _ =>
    stalk_ne_bot_of_isEffectiveCartierDivisor (hI i).2 η
  have htriple : IsTriple sV (T.I i) T.E :=
    ⟨hchar, hsm, inferInstance, inferInstance,
      TopologicalSpace.Equidimensional.of_preirreducibleSpace V, hnz, hE⟩
  have hdim : HasDimensionIn V Set.univ := by
    have : CompactSpace V := QuasiCompact.compactSpace_of_compactSpace sV
    have htop := topologicalKrullDim_ne_top_of_locallyOfFiniteType k sV
    obtain ⟨x⟩ : Nonempty V := inferInstance
    have : Nonempty (TopologicalSpace.IrreducibleCloseds V) :=
      ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have hbot : topologicalKrullDim V ≠ ⊥ := Order.krullDim_ne_bot_iff.2 inferInstance
    generalize hd : topologicalKrullDim V = d at htop hbot
    induction d using WithBot.recBotCoe with
    | bot => exact absurd rfl hbot
    | coe n =>
      induction n using ENat.recTopCoe with
      | top => exact absurd rfl htop
      | coe n => exact ⟨n, trivial, hd⟩
  have ht : t ∈ markedTriplesOfDim Set.univ 2 := ⟨htriple, rfl, hdim⟩
  exact exists_isSmoothingTransformSeq sV T i (F.toFun t ht) sV ⟨T.I i, 2⟩ T.E rfl
    (F.isOrderGeMarkedTripleSeq t ht)
    (hF.1 t ht) (hasPrincipalStalks_of_isEffectiveCartierDivisor (hI i).2) (𝟙 V) (𝟙 V) rfl T
    i.2 (by simp) ⟨id, Function.injective_id, fun j => by simp,
      fun l hl => (hl ⟨l, rfl⟩).elim⟩
    (fun y hy => multAt_le_one_of_mem_sncLocus T i hy)

end

