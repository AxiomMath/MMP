/-- If every element of a finitely generated ideal `I` is moved into `J` by multiplication with
some element of a submonoid `M`, then a single element of `M` moves all of `I` into `J`. -/
private lemma exists_mem_forall_mul_mem {A : Type*} [CommRing A] (M : Submonoid A)
    {I J : Ideal A} (hI : I.FG) (h : ∀ a ∈ I, ∃ u ∈ M, u * a ∈ J) :
    ∃ u ∈ M, ∀ a ∈ I, u * a ∈ J := by
  classical
  obtain ⟨s, rfl⟩ := hI
  induction s using Finset.induction_on with
  | empty => exact ⟨1, M.one_mem, fun a ha => by simp_all⟩
  | insert b s hb ih =>
    obtain ⟨u, hu, hub⟩ := h b (Ideal.subset_span (by simp))
    obtain ⟨v, hv, hvs⟩ := ih fun a ha =>
      h a (Ideal.span_mono (by simp [Set.subset_insert]) ha)
    refine ⟨u * v, M.mul_mem hu hv, fun a ha => ?_⟩
    rw [Finset.coe_insert, Ideal.mem_span_insert] at ha
    obtain ⟨r, c, hc, rfl⟩ := ha
    rw [show u * v * (r * b + c) = (v * r) * (u * b) + u * (v * c) by ring]
    exact J.add_mem (J.mul_mem_left _ hub) (J.mul_mem_left _ (hvs c hc))

/-- Over a Noetherian ring `A`, if an ideal `J` generates `𝔪 A_𝔪` up to inclusion, then a single
`u ∉ 𝔪` both moves `𝔪` into `J` and kills the kernel of `A → A_𝔪`. -/
private lemma exists_notMem_mul_mem_and_mul_eq_zero {A B : Type*} [CommRing A]
    [IsNoetherianRing A] [CommRing B] [Algebra A B] (𝔪 : Ideal A) [𝔪.IsPrime]
    [IsLocalization.AtPrime B 𝔪] {J : Ideal A}
    (hJ : 𝔪.map (algebraMap A B) ≤ J.map (algebraMap A B)) :
    ∃ u ∈ 𝔪.primeCompl, (∀ a ∈ 𝔪, u * a ∈ J) ∧ ∀ a, algebraMap A B a = 0 → u * a = 0 := by
  obtain ⟨u₁, hu₁, h₁⟩ := exists_mem_forall_mul_mem 𝔪.primeCompl
    (I := 𝔪) (J := J) (IsNoetherian.noetherian _) fun a ha => by
      obtain ⟨⟨j, s⟩, hjs⟩ := (IsLocalization.mem_map_algebraMap_iff 𝔪.primeCompl B).1
        (hJ (Ideal.mem_map_of_mem _ ha))
      obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists 𝔪.primeCompl B).1
        ((map_mul _ a s).trans hjs)
      exact ⟨c * s, 𝔪.primeCompl.mul_mem c.2 s.2, by
        rw [show (c : A) * s * a = c * (a * s) by ring, hc]; exact J.mul_mem_left _ j.2⟩
  obtain ⟨u₂, hu₂, h₂⟩ := exists_mem_forall_mul_mem 𝔪.primeCompl
    (I := RingHom.ker (algebraMap A B)) (J := ⊥) (IsNoetherian.noetherian _) fun a ha => by
      obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff 𝔪.primeCompl _ a).1 ha
      exact ⟨c, c.2, Ideal.mem_bot.2 hc⟩
  refine ⟨u₁ * u₂, 𝔪.primeCompl.mul_mem hu₁ hu₂, fun a ha => ?_, fun a ha => ?_⟩
  · rw [mul_right_comm]
    exact J.mul_mem_right _ (h₁ a ha)
  · rw [mul_assoc, Ideal.mem_bot.1 (h₂ a ha), mul_zero]

/-- If `g` kills the kernel of `A → B`, then any `A_g → B` compatible with it is injective. -/
private lemma injective_of_mul_eq_zero {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra A C] {g : A} [IsLocalization.Away g C] {ψ : C →+* B}
    (hψ : ψ.comp (algebraMap A C) = algebraMap A B)
    (hg : ∀ a, algebraMap A B a = 0 → g * a = 0) : Function.Injective ψ := by
  refine (injective_iff_map_eq_zero ψ).2 fun r hr => ?_
  obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers g) r
  have ha : algebraMap A B a = 0 := by
    rw [← hψ, RingHom.comp_apply, ← hs, map_mul, hr, zero_mul]
  have hσa : algebraMap A C a = 0 :=
    (IsLocalization.Away.algebraMap_isUnit g).mul_right_eq_zero.1 (by
      rw [← map_mul, hg a ha, map_zero])
  exact (IsLocalization.map_units C s).mul_left_eq_zero.1 (hs.trans hσa)

/-- For a localization `C = M⁻¹A` and a map `C → B` over `A`, the preimage in `C` of an ideal of
`B` is generated by its preimage in `A`. -/
private lemma comap_eq_map_comap {A B C : Type*} [CommRing A] [CommRing B] [CommRing C]
    [Algebra A B] [Algebra A C] (M : Submonoid A) [IsLocalization M C] {ψ : C →+* B}
    (hψ : ψ.comp (algebraMap A C) = algebraMap A B) (I : Ideal B) :
    I.comap ψ = (I.comap (algebraMap A B)).map (algebraMap A C) := by
  rw [← IsLocalization.map_comap M C (I.comap ψ), Ideal.under, Ideal.comap_comap, hψ]

/-- If `J ≤ I` and `u I ⊆ J` with `u` invertible in `C`, then `I` and `J` generate the same ideal
of `C`. -/
private lemma map_eq_map_of_mul_mem {A C : Type*} [CommRing A] [CommRing C] [Algebra A C]
    {I J : Ideal A} {u : A} (hu : IsUnit (algebraMap A C u)) (hJI : J ≤ I)
    (h : ∀ a ∈ I, u * a ∈ J) : I.map (algebraMap A C) = J.map (algebraMap A C) := by
  refine le_antisymm (Ideal.map_le_iff_le_comap.2 fun a ha => ?_) (Ideal.map_mono hJI)
  rw [Ideal.mem_comap, ← Ideal.unit_mul_mem_iff_mem _ hu, ← map_mul]
  exact Ideal.mem_map_of_mem _ (h a ha)

/-- The prime ideal of a point `p` of an affine open `U` is the preimage of the maximal ideal of
the stalk under the germ map. -/
private lemma primeIdealOf_asIdeal_eq {S : Scheme} {U : S.Opens} (hU : IsAffineOpen U) {p : S}
    (hp : p ∈ U) : (hU.primeIdealOf ⟨p, hp⟩).asIdeal =
      (maximalIdeal (S.presheaf.stalk p)).comap (S.presheaf.germ U p hp).hom := by
  rw [hU.primeIdealOf_eq_map_closedPoint]
  rfl

/-- If `S` is Noetherian, `0 ∈ S` is a closed point with `𝒪_{S,0}` regular of dimension `2`,
and `x, y ∈ 𝒪_S(V)` have germs at `0` forming a regular system of parameters, then there is a
coordinate neighbourhood `(U, x|_U, y|_U)` of `0` with `U ⊆ V`. -/
@[mmp "lem_kr1b_local_coordinates_neighbourhood"]
theorem exists_of_isRegularSystemOfParameters {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) {V : S.Opens} (hpV : p ∈ V)
    (x y : Γ(S, V))
    (hxy : MMP.Mori.IsRegularSystemOfParameters
      ![(S.presheaf.germ V p hpV).hom x, (S.presheaf.germ V p hpV).hom y]) :
    ∃ (c : CoordinateNeighbourhood S p) (hUV : c.U ≤ V),
      c.x = (S.presheaf.map (homOfLE hUV).op).hom x ∧
        c.y = (S.presheaf.map (homOfLE hUV).op).hom y := by
  haveI : IsDomain (S.presheaf.stalk p) := IsRegularLocalRing.isDomain _
  obtain ⟨W, hW, hpW, hWV⟩ := exists_isAffineOpen_mem_and_subset hpV
  have hWV' : W ≤ V := hWV
  haveI : IsNoetherianRing Γ(S, W) :=
    @IsLocallyNoetherian.component_noetherian S ‹IsNoetherian S›.toIsLocallyNoetherian ⟨W, hW⟩
  letI : Algebra Γ(S, W) (S.presheaf.stalk p) := (S.presheaf.germ W p hpW).hom.toAlgebra
  haveI := hW.isLocalization_stalk ⟨p, hpW⟩
  set ρ := (S.presheaf.map (homOfLE hWV').op).hom
  have h𝔪 : (hW.primeIdealOf ⟨p, hpW⟩).asIdeal =
      (maximalIdeal _).comap (algebraMap Γ(S, W) (S.presheaf.stalk p)) :=
    primeIdealOf_asIdeal_eq hW hpW
  have hmax : (Ideal.span {ρ x, ρ y}).map (algebraMap Γ(S, W) (S.presheaf.stalk p)) =
      maximalIdeal (S.presheaf.stalk p) := by
    rw [Ideal.map_span, Set.image_pair, ← hxy.1]
    congr 1
    ext z
    simp [ρ, RingHom.algebraMap_toAlgebra, Fin.exists_fin_two, eq_comm, or_comm]
  obtain ⟨g, hg, hg𝔪, hgK⟩ := exists_notMem_mul_mem_and_mul_eq_zero (B := S.presheaf.stalk p)
    (hW.primeIdealOf ⟨p, hpW⟩).asIdeal (J := Ideal.span {ρ x, ρ y})
    (by rw [hmax, h𝔪]; exact Ideal.map_comap_le)
  have hUW : S.basicOpen g ≤ W := S.basicOpen_le g
  have hpU : p ∈ S.basicOpen g := by
    rw [Scheme.mem_basicOpen _ _ _ hpW]
    exact IsLocalRing.notMem_maximalIdeal.1 fun h => hg (h𝔪 ▸ h)
  letI : Algebra Γ(S, W) Γ(S, S.basicOpen g) := (S.presheaf.map (homOfLE hUW).op).hom.toAlgebra
  haveI := hW.isLocalization_basicOpen g
  have hψ : (S.presheaf.germ (S.basicOpen g) p hpU).hom.comp
      (algebraMap Γ(S, W) Γ(S, S.basicOpen g)) = algebraMap Γ(S, W) (S.presheaf.stalk p) :=
    RingHom.ext fun f => S.presheaf.germ_res_apply _ _ _ _
  haveI : IsDomain Γ(S, S.basicOpen g) := (injective_of_mul_eq_zero hψ hgK).isDomain _
  have hres : ∀ f, (S.presheaf.map (homOfLE (hUW.trans hWV')).op).hom f =
      algebraMap Γ(S, W) Γ(S, S.basicOpen g) (ρ f) := by
    intro f
    rw [RingHom.algebraMap_toAlgebra, ← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  refine ⟨⟨S.basicOpen g, hW.basicOpen g, hpU, inferInstance,
    (S.presheaf.map (homOfLE (hUW.trans hWV')).op).hom x,
    (S.presheaf.map (homOfLE (hUW.trans hWV')).op).hom y, ?_⟩, hUW.trans hWV', rfl, rfl⟩
  rw [primeIdealOf_asIdeal_eq, comap_eq_map_comap (Submonoid.powers g) hψ, ← h𝔪,
    map_eq_map_of_mul_mem (IsLocalization.Away.algebraMap_isUnit g)
      (by rw [h𝔪, ← Ideal.map_le_iff_le_comap, hmax]) hg𝔪,
    Ideal.map_span, Set.image_pair, hres, hres]

end MMP.Resolution.CoordinateNeighbourhood

end CoordinateNeighbourhood

/-! ### Charts of the blow-up along a coordinate linear subspace -/

section LinearBlowUp

open MMP.Flips.ResolutionInputs MvPolynomial

namespace MMP.Resolution

section Algebra

variable {R σ A : Type*} [CommRing R] [CommRing A] (α : MvPolynomial σ R ≃+* A) (s : Set σ)
  (j : σ)

open Classical in
/-- The chart map `R[y_σ] → A[x_j⁻¹]`, `y_i ↦ x_i / x_j` for `i ∈ s`, `i ≠ j` and `y_i ↦ x_i`
otherwise, where `x_i = α (X i)`. -/
private noncomputable def chartHom : MvPolynomial σ R →+* Localization.Away (α (X j)) :=
  eval₂Hom ((algebraMap A _).comp (α.toRingHom.comp C)) fun i =>
    if i ∈ s ∧ i ≠ j then IsLocalization.mk' _ (α (X i))
      (⟨α (X j), Submonoid.mem_powers _⟩ : Submonoid.powers (α (X j)))
    else algebraMap A _ (α (X i))

private theorem chartHom_C (r : R) : chartHom α s j (C r) = algebraMap A _ (α (C r)) :=
  eval₂Hom_C _ _ _

private theorem chartHom_X_of_mem {i : σ} (hi : i ∈ s) (hij : i ≠ j) :
    chartHom α s j (X i) = IsLocalization.mk' _ (α (X i))
      (⟨α (X j), Submonoid.mem_powers _⟩ : Submonoid.powers (α (X j))) := by
  simp [chartHom, hi, hij]

private theorem chartHom_X_of_not {i : σ} (hi : ¬ (i ∈ s ∧ i ≠ j)) :
    chartHom α s j (X i) = algebraMap A _ (α (X i)) := by
  simp [chartHom, hi]

open Classical in
/-- The substitution `x_i ↦ x_i x_j` for `i ∈ s`, `i ≠ j`, fixing the other variables. -/
private noncomputable def chartSubst : MvPolynomial σ R →+* MvPolynomial σ R :=
  eval₂Hom C fun i => if i ∈ s ∧ i ≠ j then X i * X j else X i

private theorem chartHom_comp_chartSubst :
    (chartHom α s j).comp (chartSubst s j) = (algebraMap A _).comp α.toRingHom := by
  classical
  refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
  · simp [chartSubst, chartHom_C]
  · rw [RingHom.comp_apply, RingHom.comp_apply]
    change chartHom α s j (eval₂ C _ (X i)) = _
    rw [eval₂_X]
    by_cases h : i ∈ s ∧ i ≠ j
    · rw [if_pos h, map_mul, chartHom_X_of_mem α s j h.1 h.2,
        chartHom_X_of_not α s j (by simp), IsLocalization.mk'_spec_mk]
      rfl
    · rw [if_neg h, chartHom_X_of_not α s j h]
      rfl

private theorem chartHom_injective : Function.Injective (chartHom α s j) := by
  classical
  let S := Localization.Away (X j : MvPolynomial σ R)
  let g : A →+* S := (algebraMap _ S).comp ((chartSubst s j).comp α.symm.toRingHom)
  have hgj : g (α (X j)) = algebraMap (MvPolynomial σ R) S (X j) := by
    simp [g, chartSubst]
  have hu : IsUnit (g (α (X j))) := by
    rw [hgj]
    exact IsLocalization.Away.algebraMap_isUnit (X j : MvPolynomial σ R)
  let L : Localization.Away (α (X j)) →+* S := IsLocalization.Away.lift (α (X j)) hu
  have hLa : ∀ y, L (algebraMap A _ y) = g y := fun y => IsLocalization.lift_eq _ _
  have hL : L.comp (chartHom α s j) = algebraMap _ S := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [hLa, chartHom_C, g, chartSubst]
    · by_cases h : i ∈ s ∧ i ≠ j
      · rw [RingHom.comp_apply]
        have hm := congrArg L (IsLocalization.mk'_spec_mk (Localization.Away (α (X j)))
          (α (X i)) (α (X j)) (Submonoid.mem_powers _))
        rw [map_mul, hLa, hLa, hgj, ← chartHom_X_of_mem α s j h.1 h.2] at hm
        have hgi : g (α (X i)) = algebraMap (MvPolynomial σ R) S (X i) *
            algebraMap (MvPolynomial σ R) S (X j) := by
          simp [g, chartSubst, h, map_mul]
        rw [hgi] at hm
        exact (IsLocalization.Away.algebraMap_isUnit (S := S)
          (X j : MvPolynomial σ R)).mul_left_inj.mp hm
      · rw [RingHom.comp_apply, chartHom_X_of_not α s j h, hLa]
        simp [g, chartSubst, h]
  have hinj : Function.Injective (algebraMap (MvPolynomial σ R) S) :=
    IsLocalization.injective (M := Submonoid.powers (X j : MvPolynomial σ R)) S
      (Submonoid.powers_le.mpr isRegular_X.mem_nonZeroDivisors)
  rw [← hL, RingHom.coe_comp] at hinj
  exact hinj.of_comp

private theorem algebraMap_mem_range_chartHom (c : A) :
    algebraMap A (Localization.Away (α (X j))) c ∈ (chartHom α s j).range :=
  ⟨chartSubst s j (α.symm c), by
    rw [← RingHom.comp_apply, chartHom_comp_chartSubst]
    simp⟩

private theorem chartHom_mem_affineBlowupAlgebra (p : MvPolynomial σ R) :
    chartHom α s j p ∈ affineBlowupAlgebra (Ideal.span ((fun i => α (X i)) '' s)) (α (X j))
      (Localization.Away (α (X j))) := by
  induction p using MvPolynomial.induction_on with
  | C r =>
    rw [chartHom_C]
    exact Subalgebra.algebraMap_mem _ _
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul]
    refine mul_mem hp ?_
    by_cases h : i ∈ s ∧ i ≠ j
    · rw [chartHom_X_of_mem α _ _ h.1 h.2]
      exact Algebra.subset_adjoin ⟨_, Ideal.subset_span ⟨i, h.1, rfl⟩, rfl⟩
    · rw [chartHom_X_of_not α _ _ h]
      exact Subalgebra.algebraMap_mem _ _

private theorem affineBlowupAlgebra_le_range (hj : j ∈ s) :
    ∀ y ∈ affineBlowupAlgebra (Ideal.span ((fun i => α (X i)) '' s)) (α (X j))
      (Localization.Away (α (X j))), y ∈ (chartHom α s j).range := by
  let T : Subalgebra A (Localization.Away (α (X j))) :=
    { (chartHom α s j).range with
      algebraMap_mem' := algebraMap_mem_range_chartHom α s j }
  suffices h : affineBlowupAlgebra (Ideal.span ((fun i => α (X i)) '' s)) (α (X j))
      (Localization.Away (α (X j))) ≤ T from fun y hy => h hy
  refine Algebra.adjoin_le ?_
  rintro _ ⟨y, hy, rfl⟩
  change _ ∈ (chartHom α s j).range
  rw [IsLocalization.mk'_eq_mul_mk'_one]
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, hi, rfl⟩ := hy
    by_cases hij : i = j
    · subst hij
      rw [← IsLocalization.mk'_eq_mul_mk'_one, IsLocalization.mk'_self]
      exact one_mem _
    · rw [← IsLocalization.mk'_eq_mul_mk'_one, ← chartHom_X_of_mem α s j hi hij]
      exact ⟨_, rfl⟩
  | zero => simpa using zero_mem _
  | add y z _ _ hy hz =>
    rw [map_add, add_mul]
    exact add_mem hy hz
  | smul c y _ hy =>
    rw [smul_eq_mul, map_mul, mul_assoc]
    exact mul_mem (algebraMap_mem_range_chartHom α s j c) hy

end Algebra

/-- The ring of the chart `D_+(x_j)` of the blow-up along `(x_i : i ∈ s)` over an affine open
`U` with `𝒪_Y(U) ≅ R[x_σ]` is the polynomial ring on `x_j`, `x_i/x_j` (`i ∈ s`, `i ≠ j`) and
`x_i` (`i ∉ s`). -/
private theorem exists_ringEquiv_blowUpChartOpen {Y : Scheme.{u}} (I : Y.IdealSheafData)
    (U : Y.affineOpens)
    {R σ : Type*} [CommRing R] (α : MvPolynomial σ R ≃+* Γ(Y, U.1)) (s : Set σ)
    (x : σ → Γ(Y, U.1)) (hαx : ∀ i, α (X i) = x i)
    (hI : I.ideal U = Ideal.span (x '' s)) (j : σ) (hj : j ∈ s)
    (hx : ∀ i ∈ s, x i ∈ I.ideal U) :
    ∃ e : MvPolynomial σ R ≃+* Γ(blowUp I, (blowUpChartOpen I U ⟨x j, hx j hj⟩).1),
      (∀ r : R, e (C r) = (blowUpChartMap I U ⟨x j, hx j hj⟩).hom (α (C r))) ∧
      (∀ i, ¬ (i ∈ s ∧ i ≠ j) →
        e (X i) = (blowUpChartMap I U ⟨x j, hx j hj⟩).hom (x i)) ∧
      (∀ (i : σ) (hi : i ∈ s), i ≠ j →
        e (X i) = blowUpChartFraction I U ⟨x j, hx j hj⟩ (hx i hi)) := by
  obtain rfl : x = fun i => α (X i) := funext fun i => (hαx i).symm
  classical
  let a : I.ideal U := ⟨α (X j), hx j hj⟩
  let ψ0 : MvPolynomial σ R →+* blowUpAffineChartRing I U a :=
    (chartHom α s j).codRestrict _ fun p => by
      simpa only [← hI] using chartHom_mem_affineBlowupAlgebra α s j p
  have hbij : Function.Bijective ψ0 := by
    refine ⟨fun p q h => chartHom_injective α _ _ (congrArg Subtype.val h), fun y => ?_⟩
    obtain ⟨p, hp⟩ := affineBlowupAlgebra_le_range α s j hj _ (by simpa only [hI] using y.2)
    exact ⟨p, Subtype.ext hp⟩
  let iso := (blowUpChartRingIso I U a).commRingCatIsoToRingEquiv
  let e := (RingEquiv.ofBijective ψ0 hbij).trans iso.symm
  have he : ∀ p, iso (e p) = ψ0 p := fun p => iso.apply_symm_apply _
  have hiso : ∀ z, iso z = (blowUpChartRingIso I U a).hom.hom z := fun z => rfl
  refine ⟨e, fun r => ?_, fun i hi => ?_, fun i hi hij => ?_⟩
  · apply iso.injective
    rw [he, hiso, AlgebraicGeometry.blowUpChartRingIso_hom_blowUpChartMap]
    exact Subtype.ext (chartHom_C α _ _ r)
  · apply iso.injective
    rw [he, hiso, AlgebraicGeometry.blowUpChartRingIso_hom_blowUpChartMap]
    exact Subtype.ext (chartHom_X_of_not α _ _ hi)
  · apply iso.injective
    rw [he, hiso, blowUpChartFraction, ← CommRingCat.comp_apply, Iso.inv_hom_id,
      CommRingCat.id_apply]
    exact Subtype.ext (chartHom_X_of_mem α _ _ hi hij)

/-- **Charts of the blow-up along a coordinate linear subspace.** Let `I` be an ideal sheaf on
`𝔸^σ_R = Spec R[x_σ]` with `I(𝔸^σ_R) = (x_i : i ∈ s)` for a finite set `s` of variables, and
`π : B_I 𝔸^σ_R → 𝔸^σ_R` the blow-up. Then
1. the charts `U_j = D_+(x_j)`, `j ∈ s`, cover `B_I 𝔸^σ_R`;
2. for each `j ∈ s` there is a ring isomorphism `R[x_σ] ≃ 𝒪(U_j)`, compatible with `π^*` on
   constants, sending `x_i` to `π^* x_i` for `i ∉ s` or `i = j`, and to `x_i / x_j` for
   `i ∈ s`, `i ≠ j`; in these coordinates `π^* x_i = (x_i / x_j) · π^* x_j`;
3. on `U_j` the inverse image ideal `π⁻¹ I` is generated by `π^* x_j`. -/
@[mmp "lem_kr3a_linear_blowup_charts"]
theorem linearBlowUp_charts {R : Type u} [CommRing R] {σ : Type u} (s : Finset σ)
    (I : (Spec (CommRingCat.of (MvPolynomial σ R))).IdealSheafData)
    (hI : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span
      ((fun i => (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial σ R))).inv.hom
        (MvPolynomial.X i)) '' (s : Set σ))) :
    let x : σ → Γ(Spec (CommRingCat.of (MvPolynomial σ R)), ⊤) := fun i =>
      (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial σ R))).inv.hom (MvPolynomial.X i)
    let U : (Spec (CommRingCat.of (MvPolynomial σ R))).affineOpens := ⟨⊤, isAffineOpen_top _⟩
    have hx : ∀ i ∈ s, x i ∈ I.ideal U := fun i hi =>
      hI ▸ Ideal.subset_span ⟨i, hi, rfl⟩
    (⨆ j : s, (blowUpChartOpen I U ⟨x j, hx j j.2⟩).1) = ⊤ ∧
      ∀ j : s,
        (∃ e : MvPolynomial σ R ≃+* Γ(blowUp I, (blowUpChartOpen I U ⟨x j, hx j j.2⟩).1),
          (∀ r : R, e (MvPolynomial.C r) = (blowUpChartMap I U ⟨x j, hx j j.2⟩).hom
            ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial σ R))).inv.hom
              (MvPolynomial.C r))) ∧
          (∀ i, (i ∉ s ∨ i = j.1) →
            e (MvPolynomial.X i) = (blowUpChartMap I U ⟨x j, hx j j.2⟩).hom (x i)) ∧
          (∀ (i : σ) (hi : i ∈ s), i ≠ j.1 →
            e (MvPolynomial.X i) = blowUpChartFraction I U ⟨x j, hx j j.2⟩ (hx i hi) ∧
            (blowUpChartMap I U ⟨x j, hx j j.2⟩).hom (x i) =
              e (MvPolynomial.X i) * (blowUpChartMap I U ⟨x j, hx j j.2⟩).hom (x j))) ∧
        (I.comap (blowUpToBase I)).ideal (blowUpChartOpen I U ⟨x j, hx j j.2⟩) =
          Ideal.span {(blowUpChartMap I U ⟨x j, hx j j.2⟩).hom (x j)} := by
  intro x U hx
  classical
  let α : MvPolynomial σ R ≃+* Γ(Spec (CommRingCat.of (MvPolynomial σ R)), U.1) :=
    (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial σ R))).symm.commRingCatIsoToRingEquiv
  refine ⟨?_, fun j => ⟨?_, ideal_exceptionalIdeal_blowUpChartOpen I U _⟩⟩
  · let eq : Fin s.card ≃ s := s.equivFin.symm
    let f : Fin s.card → Γ(Spec (CommRingCat.of (MvPolynomial σ R)), U.1) := fun m => x (eq m)
    have hf : I.ideal U = Ideal.span (Set.range f) := by
      rw [hI, Set.image_eq_range, ← eq.surjective.range_comp]
      rfl
    rw [← eq.iSup_comp]
    exact (iSup_blowUpChartOpen_eq_preimage I U f hf).trans (Scheme.Hom.preimage_top _)
  · obtain ⟨e, h1, h2, h3⟩ :=
      exists_ringEquiv_blowUpChartOpen I U α (s : Set σ) x (fun _ => rfl) hI j.1 j.2 hx
    refine ⟨e, h1, fun i hi => h2 i fun h => hi.elim (· h.1) h.2, fun i hi hij =>
      ⟨h3 i hi hij, h3 i hi hij ▸ blowUpChartMap_eq_blowUpChartFraction_mul I U _ (hx i hi)⟩⟩

end MMP.Resolution

end LinearBlowUp

/-! ### Smooth blow-up sequences -/

namespace MMP.Resolution.ClosedBlowupSequence

/-- The blow-up morphism preserves the dimension of the closure of a point lying over the
complement of the centre. -/
private theorem topologicalKrullDim_closure_blowUpToBase {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (Z : X.IdealSheafData)
    [LocallyOfFiniteType (blowUpToBase Z ≫ sX)] {η : blowUp Z}
    (hη : blowUpToBase Z η ∉ (Z.support : Set X)) :
    topologicalKrullDim (closure ({η} : Set (blowUp Z))) =
      topologicalKrullDim (closure ({blowUpToBase Z η} : Set X)) := by
  rw [topologicalKrullDim_closure_eq_toNat_relativeDimension k (blowUpToBase Z ≫ sX),
    topologicalKrullDim_closure_eq_toNat_relativeDimension k sX]
  let U : X.Opens := ⟨(Z.support : Set X)ᶜ, Z.support.isClosed.isOpen_compl⟩
  have : IsIso (blowUpToBase Z ∣_ U) := isIso_blowUp_restrict_compl_support Z
  let z : (blowUpToBase Z ⁻¹ᵁ U).toScheme := ⟨η, hη⟩
  have h1 := Stacks.Chow.relativeDimension_comp_isOpenImmersion
    (Stacks.Chow.fieldChowSituation k).dimensionFunction (blowUpToBase Z ⁻¹ᵁ U).ι
    (blowUpToBase Z ≫ sX) z
  rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc,
    Stacks.Chow.relativeDimension_comp_isOpenImmersion,
    Stacks.Chow.relativeDimension_comp_isOpenImmersion] at h1
  have h2 : U.ι ((blowUpToBase Z ∣_ U) z) = blowUpToBase Z η :=
    morphismRestrict_base_coe (blowUpToBase Z) U z
  rw [h2] at h1
  change _ = (Stacks.Chow.relativeDimension _ (blowUpToBase Z ≫ sX) η) at h1
  rw [h1]

/-- The generic point of an irreducible component is a generic point of the space. -/
private theorem mem_genericPoints_of_isGenericPoint {α : Type*} [TopologicalSpace α] {x : α}
    {C : Set α} (hC : C ∈ irreducibleComponents α) (hx : IsGenericPoint x C) :
    x ∈ genericPoints α :=
  show closure {x} ∈ _ by rwa [hx.def]

/-- The irreducible components of the blow-up of a scheme locally of finite type over `k`, all
of whose irreducible components have dimension `n`, have dimension `n`. -/
private theorem topologicalKrullDim_irreducibleComponents_blowUp {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (Z : X.IdealSheafData)
    [LocallyOfFiniteType (blowUpToBase Z ≫ sX)] {n : ℕ}
    (hdim : ∀ C ∈ irreducibleComponents X, topologicalKrullDim C = n) :
    ∀ C ∈ irreducibleComponents (blowUp Z), topologicalKrullDim C = n := by
  intro C hC
  obtain ⟨η, hη⟩ := QuasiSober.sober hC.1 (isClosed_of_mem_irreducibleComponents C hC)
  obtain ⟨hπ, hπZ⟩ :=
    (bijOn_genericPoints_blowUpToBase Z).mapsTo (mem_genericPoints_of_isGenericPoint hC hη)
  rw [← hη.def, topologicalKrullDim_closure_blowUpToBase sX Z
    (fun h => hπZ (Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mpr h))]
  exact hdim _ hπ

/-- Smooth morphisms are locally of finite type, stated so that it can be applied without a
typeclass search through the instances of the imported library. -/
private theorem locallyOfFiniteType_of_smooth {X Y : Scheme.{u}} (f : X ⟶ Y) [Smooth f] :
    LocallyOfFiniteType f :=
  inferInstance

/-- The induction invariant of `IsSmooth.truncate_target_equidimensional` at a stage `B`: the
target is smooth over `k`, and every generic point of the target has closure of dimension `n`,
avoids the total exceptional set, and maps to a generic point of `X`. -/
private def Invariant {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (n : ℕ)
    (B : ClosedBlowupSequence X) : Prop :=
  Smooth (B.toBase ≫ sX) ∧
    ∀ x ∈ genericPoints B.target,
      topologicalKrullDim (closure ({x} : Set B.target)) = n ∧
        x ∉ B.totalExceptionalSet ∧ B.toBase x ∈ genericPoints X

private theorem invariant_nil {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
    [Smooth sX] {n : ℕ} (hdim : ∀ C ∈ irreducibleComponents X, topologicalKrullDim C = n) :
    Invariant sX n (ClosedBlowupSequence.nil X) :=
  ⟨show Smooth (𝟙 X ≫ sX) by rwa [Category.id_comp], fun x hx =>
    ⟨hdim _ hx, by simp [ClosedBlowupSequence.totalExceptionalSet], hx⟩⟩

/-- The invariant holds at every stage of a smooth blow-up sequence. -/
private theorem invariant_truncate {k : Type u} [Field k] {n : ℕ} {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (hdim : ∀ C ∈ irreducibleComponents X, topologicalKrullDim C = n) (hB : B.IsSmooth sX)
    (i : ℕ) : Invariant sX n (B.truncate i) := by
  induction B generalizing i with
  | nil X => exact invariant_nil sX hdim
  | @cons X Z B ih =>
    cases i with
    | zero => exact invariant_nil sX hdim
    | succ i =>
      have : Smooth (blowUpToBase Z ≫ sX) :=
        (Bridges.smooth_blowUp_and_exceptionalDivisor_of_isSmoothBlowup sX Z ⟨hB.1, hB.2.1⟩).1
      have := locallyOfFiniteType_of_smooth sX
      have := locallyOfFiniteType_of_smooth (blowUpToBase Z ≫ sX)
      obtain ⟨hs, hg⟩ := ih (blowUpToBase Z ≫ sX)
        (topologicalKrullDim_irreducibleComponents_blowUp sX Z hdim) hB.2.2 i
      refine ⟨show Smooth (((B.truncate i).toBase ≫ blowUpToBase Z) ≫ sX) by
        rwa [Category.assoc], fun x hx => ?_⟩
      obtain ⟨hxd, hxE, hxg⟩ := hg x hx
      obtain ⟨hπ, hπZ⟩ := (bijOn_genericPoints_blowUpToBase Z).mapsTo hxg
      refine ⟨hxd, ?_, hπ⟩
      change x ∉ (B.truncate i).toBase ⁻¹' (blowUpToBase Z ⁻¹' (Z.support : Set X)) ∪
        (B.truncate i).totalExceptionalSet
      rintro (h | h)
      · exact hπZ (Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mpr h)
      · exact hxE h

/-- In a smooth blow-up sequence starting with a smooth scheme `X` over `k` all of whose
irreducible components have dimension `n`, every `X_i` is smooth over `k`, all its irreducible
components have dimension `n`, and their generic points lie outside the total exceptional set
of `X_i → X`. -/
@[mmp "lem_kr3d_blowup_sequence_equidimensional"]
theorem IsSmooth.truncate_target_equidimensional {k : Type u} [Field k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [Smooth sX] {n : ℕ}
    (hdim : ∀ C ∈ irreducibleComponents X, topologicalKrullDim C = n)
    {B : ClosedBlowupSequence X} (hB : B.IsSmooth sX) (i : ℕ) :
    Smooth ((B.truncate i).toBase ≫ sX) ∧
      ∀ C ∈ irreducibleComponents (B.truncate i).target,
        topologicalKrullDim C = n ∧
          ∀ x, IsGenericPoint x C → x ∉ (B.truncate i).totalExceptionalSet := by
  obtain ⟨hs, hg⟩ := invariant_truncate B sX hdim hB i
  refine ⟨hs, fun C hC => ⟨?_, fun x hx =>
    (hg x (mem_genericPoints_of_isGenericPoint hC hx)).2.1⟩⟩
  obtain ⟨η, hη⟩ := QuasiSober.sober hC.1 (isClosed_of_mem_irreducibleComponents C hC)
  rw [← hη.def]
  exact (hg η (mem_genericPoints_of_isGenericPoint hC hη)).1

/-- In a smooth blow-up sequence starting with a smooth scheme `X` over `k` all of whose
irreducible components have dimension `n`, written as `B.append (cons Z C)` so that the next
blow-up is `blowUpToBase Z : blowUp Z ⟶ B.target`, the inverse image along that blow-up of an
ideal sheaf on `B.target` nonzero at the generic points of `B.target` is nonzero at the generic
points of `blowUp Z`. See `MMP.Resolution.isNonzeroAtGenericPoints_comap_blowUpToBase` for the
statement without the smoothness hypotheses. -/
@[mmp "lem_kr3d_blowup_pullback_nonzero"]
theorem IsSmooth.isNonzeroAtGenericPoints_comap_blowUpToBase {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] {n : ℕ}
    (hdim : ∀ C ∈ irreducibleComponents X, topologicalKrullDim C = n)
    {B : ClosedBlowupSequence X} {Z : B.target.IdealSheafData}
    {C : ClosedBlowupSequence (blowUp Z)} (hB : (B.append (cons Z C)).IsSmooth sX)
    {K : B.target.IdealSheafData} (hK : IsNonzeroAtGenericPoints K) :
    IsNonzeroAtGenericPoints (K.comap (blowUpToBase Z)) :=
  MMP.Resolution.isNonzeroAtGenericPoints_comap_blowUpToBase Z hK

end MMP.Resolution.ClosedBlowupSequence

/-! ### Derivatives of ideal sheaves -/

namespace MMP.Resolution

/-- Being nonzero at the generic points passes to larger ideal sheaves. -/
private theorem isNonzeroAtGenericPoints_mono {X : Scheme} {I J : X.IdealSheafData}
    (hI : IsNonzeroAtGenericPoints I) (h : I ≤ J) : IsNonzeroAtGenericPoints J :=
  fun η hη hbot => hI η hη (eq_bot_iff.2 (hbot ▸ stalk_le_stalk_of_le h η))

/-- On an equidimensional scheme, smooth and quasi-compact over a field of characteristic zero,
all of whose irreducible components have positive dimension, for an ideal sheaf `I` nonzero at
the generic point of every irreducible component and every `j : ℕ`, the higher derivative
`higherDerivativeIdeal sX I j` contains `I`, and its order at any point `x` is `ord_x I - j`
(truncated at `0`). -/
@[mmp "lem_kr3d_order_higher_derivative_ideal"]
theorem le_higherDerivativeIdeal_and_multAt {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : TopologicalSpace.Equidimensional X)
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z) {I : X.IdealSheafData}
    (hI : IsNonzeroAtGenericPoints I) (j : ℕ) (x : X) :
    I ≤ higherDerivativeIdeal sX I j ∧
      multAt (higherDerivativeIdeal sX I j) x = multAt I x - j := by
  induction j with
  | zero => simp [higherDerivativeIdeal_zero]
  | succ j ih =>
    rw [higherDerivativeIdeal_succ, multAt_derivativeIdeal sX hX hdim
      (isNonzeroAtGenericPoints_mono hI ih.1) x, ih.2, tsub_tsub, Nat.cast_succ]
    exact ⟨ih.1.trans (le_derivativeIdeal sX hdim _), rfl⟩

/-! ### Cosupports of marked derivatives and of the maximal contact ideal -/

/-- On a scheme locally of finite type over a field, an irreducible component has the local
dimension at its generic point as its dimension. -/
private lemma topologicalKrullDim_eq_topologicalKrullDimAt_genericPoint {k : Type*} [Field k]
    {X : Scheme} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] {Z : Set X}
    (hZ : Z ∈ irreducibleComponents X) :
    topologicalKrullDim Z = topologicalKrullDimAt X hZ.1.genericPoint := by
  have hη : IsGenericPoint hZ.1.genericPoint Z :=
    hZ.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents Z hZ)
  have honly : ∀ W ∈ irreducibleComponents X, hZ.1.genericPoint ∈ W → W = Z := fun W hW hηW ↦
    have hZW : Z ⊆ W := hη ▸ closure_minimal (Set.singleton_subset_iff.mpr hηW)
      (isClosed_of_mem_irreducibleComponents W hW)
    (hZW.antisymm (hZ.2 hW.1 hZW)).symm
  rw [topologicalKrullDimAt_eq_iSup_irreducibleComponents k X sX]
  refine le_antisymm (le_iSup_of_le Z (le_iSup_of_le ⟨hZ, hη.mem⟩ le_rfl)) ?_
  exact iSup_le fun W ↦ iSup_le fun hW ↦ by rw [honly W hW.1 hW.2]

/-- Over a field, a scheme smooth of relative dimension `n` has all its irreducible components of
dimension `n`. -/
private lemma topologicalKrullDim_eq_of_smoothOfRelativeDimension {k : Type*} [Field k]
    {X : Scheme} (n : ℕ) (sX : X ⟶ Spec (.of k)) [SmoothOfRelativeDimension n sX] {Z : Set X}
    (hZ : Z ∈ irreducibleComponents X) : topologicalKrullDim Z = n := by
  have : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  rw [topologicalKrullDim_eq_topologicalKrullDimAt_genericPoint sX hZ,
    topologicalKrullDimAt_eq_of_smoothOfRelativeDimension_over_field n sX]

/-- For `r < m` in `ℕ`, `m - r ≤ a - r` iff `m ≤ a` in `ℕ∞`. -/
private lemma natCast_sub_le_sub_iff {m r : ℕ} (hr : r < m) (a : ℕ∞) :
    ((m - r : ℕ) : ℕ∞) ≤ a - r ↔ (m : ℕ∞) ≤ a := by
  induction a using ENat.recTopCoe with
  | top => simp
  | coe a =>
    rw [← ENat.coe_sub, Nat.cast_le, Nat.cast_le]
    omega

/-- On a smooth equidimensional scheme of finite type, with components of positive dimension,
over a field of characteristic zero, for a marked ideal `a = (I, m)` with `I` nonzero at the
generic point of every irreducible component and `r < m`, the marked derivative
`a.derivative sX r = (D^r(I), m - r)` has the same cosupport as `a`. -/
@[mmp "lem_kr3d_cosupport_marked_derivative"]
theorem MarkedIdeal.cosupport_derivative {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hX : TopologicalSpace.Equidimensional X)
    (hdim : ∀ Z ∈ irreducibleComponents X, 0 < topologicalKrullDim Z) (a : MarkedIdeal X)
    (hI : IsNonzeroAtGenericPoints a.I) {r : ℕ} (hr : r < a.m) :
    (a.derivative sX r).cosupport = a.cosupport := by
  ext x
  simp only [MarkedIdeal.derivative, MarkedIdeal.cosupport, Set.mem_setOf_eq]
  rw [(le_higherDerivativeIdeal_and_multAt sX hX hdim hI r x).2]
  exact natCast_sub_le_sub_iff hr _

/-- `x ∈ V(K)` iff `ord_x K ≥ 1`. -/
private lemma mem_support_iff_one_le_multAt {X : Scheme} (K : X.IdealSheafData) (x : X) :
    x ∈ (K.support : Set X) ↔ 1 ≤ multAt K x := by
  rw [show (1 : ℕ∞) = ((1 : ℕ) : ℕ∞) by simp, multAt, natCast_le_idealOrder_iff', pow_one]
  refine ⟨fun hx => IsLocalRing.le_maximalIdeal fun h =>
    ((IdealSheafData.stalk_eq_top_iff_notMem_support K x).1 h) hx, fun h => ?_⟩
  by_contra hx
  rw [(IdealSheafData.stalk_eq_top_iff_notMem_support K x).2 hx] at h
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.mp h)

/-- A space whose irreducible components all have dimension `n` has dimension `n`. -/
private lemma topologicalKrullDim_eq_of_forall {T : Type*} [TopologicalSpace T] [Nonempty T]
    {n : WithBot ℕ∞} (h : ∀ Z ∈ irreducibleComponents T, topologicalKrullDim Z = n) :
    topologicalKrullDim T = n := by
  apply le_antisymm
  · rw [topologicalKrullDim, Order.krullDim_eq_iSup_height]
    refine iSup_le fun Z ↦ ?_
    obtain ⟨W, hW, hZW⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible
      (Z : Set T) Z.isIrreducible
    let W' : TopologicalSpace.IrreducibleCloseds T :=
      ⟨W, hW.1, isClosed_of_mem_irreducibleComponents W hW⟩
    calc (Order.height Z : WithBot ℕ∞) ≤ (Order.height W' : WithBot ℕ∞) :=
          WithBot.coe_le_coe.mpr (Order.height_mono (show Z ≤ W' from hZW))
      _ = topologicalKrullDim (W : Set T) := (topologicalKrullDim_coe_eq_height W').symm
      _ = n := h W hW
  · obtain ⟨x⟩ := ‹Nonempty T›
    rw [← h _ (irreducibleComponent_mem_irreducibleComponents x)]
    exact topologicalKrullDim_subspace_le _ _

/-- In a space of dimension `≤ 0`, the closure of every point is an irreducible component. -/
private lemma closure_mem_irreducibleComponents {T : Type*} [TopologicalSpace T]
    (h : topologicalKrullDim T ≤ 0) (x : T) :
    closure ({x} : Set T) ∈ irreducibleComponents T := by
  let A : TopologicalSpace.IrreducibleCloseds T :=
    ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
  let B : TopologicalSpace.IrreducibleCloseds T :=
    ⟨irreducibleComponent x, isIrreducible_irreducibleComponent, isClosed_irreducibleComponent⟩
  have hAB : A ≤ B := (isClosed_irreducibleComponent.closure_subset_iff).2
    (Set.singleton_subset_iff.2 mem_irreducibleComponent)
  obtain hAB' | hlt := hAB.eq_or_lt
  · rw [show closure ({x} : Set T) = irreducibleComponent x from
      congrArg SetLike.coe hAB']
    exact irreducibleComponent_mem_irreducibleComponents x
  · exact absurd ((Order.one_le_krullDim_iff.2 ⟨A, B, hlt⟩).trans h) (by decide)

/-- An ideal sheaf whose stalk at a point with field stalk is nonzero has order `0` there. -/
private lemma multAt_eq_zero_of_isField {X : Scheme} (I : X.IdealSheafData) (x : X)
    (hfield : IsField (X.presheaf.stalk x)) (hne : IdealSheafData.stalk I x ≠ ⊥) :
    multAt I x = 0 := by
  refine ENat.lt_one_iff_eq_zero.mp (not_le.mp fun h ↦ hne (le_bot_iff.mp ?_))
  rw [← (IsLocalRing.isField_iff_maximalIdeal_eq).1 hfield]
  exact IsLocalRing.le_maximalIdeal fun h' ↦
    ((IdealSheafData.stalk_eq_top_iff_notMem_support I x).1 h')
      ((mem_support_iff_one_le_multAt I x).2 h)

/-- If the orders of `I` are finite and the loci `{x | s ≤ ord_x I}` are closed in a noetherian
space, then the maximal order of `I` is finite. -/
private lemma maxOrder_ne_top_of_isClosed {X : Scheme} [TopologicalSpace.NoetherianSpace X]
    (I : X.IdealSheafData) (hfin : ∀ x, multAt I x ≠ ⊤)
    (hC : ∀ s : ℕ, IsClosed {x | (s : ℕ∞) ≤ multAt I x}) : maxOrder I ≠ ⊤ := by
  let a : ℕ →o (TopologicalSpace.Closeds X)ᵒᵈ :=
    ⟨fun s ↦ OrderDual.toDual ⟨_, hC s⟩, fun s t hst x hx ↦
      le_trans (by exact_mod_cast hst) (show (t : ℕ∞) ≤ multAt I x from hx)⟩
  obtain ⟨N, hN⟩ := wellFoundedGT_iff_monotone_chain_condition.1 inferInstance a
  refine ne_top_of_le_ne_top (ENat.coe_ne_top N) (iSup₂_le fun x _ ↦ ?_)
  obtain ⟨M, hM⟩ := ENat.ne_top_iff_exists.1 (hfin x)
  by_contra! hlt
  rw [← hM] at hlt
  have hNM : N ≤ M := by exact_mod_cast hlt.le
  have hx : x ∈ ((a M).ofDual : Set X) := show (M : ℕ∞) ≤ multAt I x from hM ▸ le_rfl
  rw [← hN M hNM, hN (M + 1) (by omega)] at hx
  have : ((M + 1 : ℕ) : ℕ∞) ≤ M := hM ▸ hx
  exact absurd (by exact_mod_cast this : M + 1 ≤ M) (by omega)

/-- On a smooth scheme of positive pure dimension, `cosupp(I, s) = V(D^{s-1}(I))` for `s ≥ 1`. -/
private lemma cosupport_eq_support_higherDerivativeIdeal {k : Type*} [Field k] [CharZero k]
    {X : Scheme} (sX : X ⟶ Spec (.of k)) {d : ℕ} (hd : 0 < d) [SmoothOfRelativeDimension d sX]
    [QuasiCompact sX] {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) {s : ℕ}
    (hs : 1 ≤ s) :
    (MarkedIdeal.mk I s).cosupport = ((higherDerivativeIdeal sX I (s - 1)).support : Set X) := by
  have : Smooth sX := SmoothOfRelativeDimension.smooth d sX
  have hdim' {Z} (hZ : Z ∈ irreducibleComponents X) :=
    topologicalKrullDim_eq_of_smoothOfRelativeDimension d sX hZ
  rw [← MarkedIdeal.cosupport_derivative sX (fun Z hZ W hW ↦ by rw [hdim' hZ, hdim' hW])
    (fun Z hZ ↦ by rw [hdim' hZ]; exact_mod_cast hd) (MarkedIdeal.mk I s) hI (r := s - 1)
    (by simp; omega)]
  ext x
  simp only [MarkedIdeal.derivative, MarkedIdeal.cosupport, Set.mem_setOf_eq]
  rw [mem_support_iff_one_le_multAt, show s - (s - 1) = 1 by omega]
  simp

/-- On a smooth equidimensional scheme of finite type over a field of characteristic zero, for an
ideal sheaf `I` nonzero at the generic point of every irreducible component with
`1 ≤ maxOrder I`, the support of the maximal contact ideal `maximalContactIdeal sX I` is the
cosupport of the marked ideal `(I, maxOrder I)`. -/
@[mmp "lem_kr3d_cosupport_maximal_contact_ideal"]
theorem support_maximalContactIdeal {k : Type u} [Field k] [CharZero k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [Smooth sX] [QuasiCompact sX]
    (hdim : ∃ n : ℕ∞, ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n)
    {I : X.IdealSheafData} (hI : IsNonzeroAtGenericPoints I) (hm : 1 ≤ maxOrder I) :
    ((maximalContactIdeal sX I).support : Set X) =
      (MarkedIdeal.mk I (maxOrder I).toNat).cosupport := by
  rcases isEmpty_or_nonempty X with _ | _
  · exact Subsingleton.elim _ _
  obtain ⟨n, hn⟩ := hdim
  have hXdim : topologicalKrullDim X = n := topologicalKrullDim_eq_of_forall hn
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hntop : n ≠ ⊤ := fun h ↦
    topologicalKrullDim_ne_top_of_locallyOfFiniteType k sX (by rw [hXdim, h]; rfl)
  lift n to ℕ using hntop
  have : SmoothOfRelativeDimension n sX := smoothOfRelativeDimension_of_equidimensional k sX
    (fun _ hA _ hB ↦ (hn _ hA).trans (hn _ hB).symm) n (by rw [hXdim]; rfl)
  have hd0 : 0 < n := by
    refine Nat.pos_of_ne_zero fun hd0 ↦ ?_
    have : IsReduced X := isReduced_of_smooth sX
    have hcl := closure_mem_irreducibleComponents (by rw [hXdim, hd0]; rfl)
    have : maxOrder I = 0 := by
      simp [maxOrder, maxOrderAlong, fun x ↦ multAt_eq_zero_of_isField I x
        (isField_stalk_of_closure_mem_irreducibleComponents X x (hcl x)) (hI x (hcl x))]
    simp [this] at hm
  have key := fun s (hs : 1 ≤ s) ↦ cosupport_eq_support_higherDerivativeIdeal sX hd0 hI hs
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsNoetherian X := {}
  have hfin : maxOrder I ≠ ⊤ := maxOrder_ne_top_of_isClosed I
    (multAt_ne_top_of_isNonzeroAtGenericPoints hI) fun s ↦ by
      obtain _ | s := s
      · simp only [Nat.cast_zero, zero_le, Set.setOf_true, isClosed_univ]
      · change IsClosed (MarkedIdeal.mk I (s + 1)).cosupport
        rw [key _ (by omega)]
        exact (higherDerivativeIdeal sX I _).support.isClosed
  rw [key _ (by rwa [← ENat.coe_toNat hfin, Nat.one_le_cast] at hm)]
  rfl

end MMP.Resolution
