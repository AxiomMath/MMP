/-!
# The order along the exceptional divisor of a smooth blow-up

Let `X` be smooth over a field `k`, `Z = V(I) ⊆ X` an irreducible closed subscheme, smooth over
`k`, of codimension `≥ 1`, `π : B_Z X → X` the blow-up and `F = π⁻¹(Z)` its exceptional divisor,
a prime divisor. For every ideal sheaf `J ⊆ 𝒪_X`, the order of `π^*J` along `F` equals the order
of `J` along `Z`.

With `η`, `ξ` the generic points of `Z` and `F`, so that `π(ξ) = η`, the statement is
`𝔪_ξ^j ∩ 𝒪_{X,η} = 𝔪_η^j` for all `j`. Choose local coordinates `x_1, …, x_n` on an affine
neighbourhood `U` of `η` with `Z ∩ U = V(x_1, …, x_r)`, and a chart `U_ℓ = D_+(x_ℓ)` of the
blow-up containing `ξ`. On `U_ℓ` the ideal `π^*I` is generated by `x_ℓ`, so `𝔪_ξ = (x_ℓ)`. An
element of `𝔪_η^j` is, up to a unit, `P(x_1, …, x_r)` for a form `P` of degree `j` with
coefficients in `𝒪_X(U)`, and on `U_ℓ` it is `x_ℓ^j · P(x_1/x_ℓ, …, 1, …, x_r/x_ℓ)`. If it lies
in `𝔪_ξ^{j+1}`, the dehomogenized polynomial evaluates to a function vanishing at `ξ`, hence on
`F ∩ U_ℓ = V(x_ℓ)`; by the presentation `𝒪(U_ℓ) = 𝒪_X(U)[T_i]/(x_i - T_i x_ℓ)` its coefficients
then vanish at `η`, and so do those of `P`, so the element lies in `𝔪_η^{j+1}`.

## Main definitions

* `MMP.Resolution.dehomogenize`: the dehomogenization `P ↦ P|_{X_ℓ = 1}`.
* `MMP.Resolution.BlowupChartData.ofIsCutOutByFirst`: the blow-up chart data of local
  coordinates whose first `m` cut out `I`.

## Main results

* `MMP.Resolution.BlowupChartData.mem_map_C_of_germ_chartPresentation_mem`: a polynomial in the
  chart fractions vanishing at the generic point of the exceptional divisor has all its
  coefficients vanishing at the image point.
* `MMP.Resolution.BlowupChartData.comap_stalkMap_maximalIdeal_pow`:
  `𝔪_ξ^j ∩ 𝒪_{X,π(ξ)} = 𝔪_{π(ξ)}^j`.
* `MMP.Resolution.orderAlong_comap_blowUpToBase_eq`: `ord_F(π^*J) = ord_Z J`.

## Implementation notes

The pull-back `π^*J` is the inverse-image ideal sheaf `J.comap π`, and `ord_F` is
`MMP.Resolution.orderAlong` at the generic point of the support of
`MMP.Resolution.exceptionalPrimeDivisor`. The proof uses neither the associated graded ring of
`𝒪_{X,η}` nor the Krull intersection theorem: a homogeneous form over a domain whose
dehomogenization vanishes is zero, which is checked in the fraction field.

## References

* [J. Kollár, *Lectures on resolution of singularities*, Def. 3.47]
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace IsLocalRing

universe u

namespace MMP.Resolution

section Dehomogenization

open MvPolynomial

/-- For a homogeneous polynomial `P` of degree `j`, `P(c v) = c ^ j P(v)`. -/
theorem eval₂_mul_of_isHomogeneous {R S σ : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (v : σ → S) (c : S) {P : MvPolynomial σ R} {j : ℕ}
    (hP : P.IsHomogeneous j) :
    eval₂ f (fun i => c * v i) P = c ^ j * eval₂ f v P := by
  rw [eval₂_eq, eval₂_eq, Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg : ∑ i ∈ d.support, d i = j := by
    simpa [Finsupp.weight_apply, Finsupp.sum] using hP (mem_support_iff.mp hd)
  simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
  ring

/-- If `ψ` maps the `v_i` into an ideal `M`, then `ψ` maps `P(v)` into `M^{j+1}` for a homogeneous
form `P` of degree `j` with coefficients in `ψ⁻¹(M)`. -/
theorem map_eval_mem_pow_succ {A S σ : Type*} [CommRing A] [CommRing S] (ψ : A →+* S)
    (M : Ideal S) (v : σ → A) (hv : ∀ i, ψ (v i) ∈ M) {P : MvPolynomial σ A} {j : ℕ}
    (hP : P.IsHomogeneous j) (hPm : P ∈ Ideal.map MvPolynomial.C (M.comap ψ)) :
    ψ (MvPolynomial.eval v P) ∈ M ^ (j + 1) := by
  rw [show ψ (MvPolynomial.eval v P) = MvPolynomial.eval₂ ψ (ψ ∘ v) P by
    simpa using eval₂_comp_left ψ (RingHom.id A) v P, eval₂_eq]
  refine Ideal.sum_mem _ fun d hd => ?_
  have hdeg : ∑ i ∈ d.support, d i = j := by
    simpa [Finsupp.weight_apply, Finsupp.sum] using hP (MvPolynomial.mem_support_iff.mp hd)
  rw [pow_succ']
  refine Ideal.mul_mem_mul (MvPolynomial.mem_map_C_iff.mp hPm d) ?_
  rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
  exact Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow (hv i) _

/-- Cancellation of a power of a nonzero element in a domain. -/
theorem mul_eq_of_mul_pow_succ_eq {R : Type*} [CommRing R] [IsDomain R] {τ h v : R} {j : ℕ}
    (hτ : τ ≠ 0) (hv : v * τ ^ (j + 1) = τ ^ j * h) : v * τ = h := by
  refine mul_left_cancel₀ (pow_ne_zero j hτ) ?_
  rw [← hv]
  ring

variable {σ : Type*} [DecidableEq σ]

/-- The *dehomogenization* `P ↦ P|_{X_ℓ = 1}`, a polynomial in the variables `X_i`, `i ≠ ℓ`. -/
def dehomogenize (R : Type*) [CommSemiring R] (ℓ : σ) :
    MvPolynomial σ R →ₐ[R] MvPolynomial {i : σ // i ≠ ℓ} R :=
  aeval fun i => if h : i = ℓ then 1 else X ⟨i, h⟩

/-- `X_ℓ` dehomogenizes to `1`. -/
@[simp]
theorem dehomogenize_X_self (R : Type*) [CommSemiring R] (ℓ : σ) :
    dehomogenize R ℓ (X ℓ) = 1 := by
  simp [dehomogenize]

/-- `X_i`, `i ≠ ℓ`, dehomogenizes to `X_i`. -/
@[simp]
theorem dehomogenize_X_of_ne (R : Type*) [CommSemiring R] {ℓ i : σ} (h : i ≠ ℓ) :
    dehomogenize R ℓ (X i) = X ⟨i, h⟩ := by
  simp [dehomogenize, h]

/-- Constants are unchanged by dehomogenization. -/
@[simp]
theorem dehomogenize_C (R : Type*) [CommSemiring R] (ℓ : σ) (r : R) :
    dehomogenize R ℓ (C r) = C r := by
  simp [dehomogenize]

/-- Evaluating the dehomogenization at `v` is evaluating at `v` extended by `1` in the slot `ℓ`. -/
theorem eval₂_dehomogenize {R S : Type*} [CommSemiring R] [CommSemiring S] (f : R →+* S)
    (ℓ : σ) (v : {i : σ // i ≠ ℓ} → S) (P : MvPolynomial σ R) :
    eval₂ f v (dehomogenize R ℓ P) =
      eval₂ f (fun i => if h : i = ℓ then 1 else v ⟨i, h⟩) P := by
  have : (eval₂Hom f v).comp (dehomogenize R ℓ).toRingHom =
      eval₂Hom f (fun i => if h : i = ℓ then 1 else v ⟨i, h⟩) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [dehomogenize]
    · by_cases h : i = ℓ
      · subst h
        simp [dehomogenize]
      · simp [dehomogenize, h]
  exact congrArg (fun φ : MvPolynomial σ R →+* S => φ P) this

/-- Dehomogenization commutes with change of coefficients. -/
theorem map_dehomogenize {R S : Type*} [CommSemiring R] [CommSemiring S] (f : R →+* S)
    (ℓ : σ) (P : MvPolynomial σ R) :
    map f (dehomogenize R ℓ P) = dehomogenize S ℓ (map f P) := by
  have : (map f).comp (dehomogenize R ℓ).toRingHom =
      (dehomogenize S ℓ).toRingHom.comp (map f) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [dehomogenize]
    · by_cases h : i = ℓ
      · subst h
        simp [dehomogenize]
      · simp [dehomogenize, h]
  exact congrArg (fun φ : MvPolynomial σ R →+* MvPolynomial {i : σ // i ≠ ℓ} S => φ P) this

/-- Over a domain, a homogeneous polynomial whose dehomogenization vanishes is zero. -/
theorem eq_zero_of_isHomogeneous_of_dehomogenize_eq_zero {R : Type*} [CommRing R] [IsDomain R]
    {ℓ : σ} {P : MvPolynomial σ R} {j : ℕ} (hP : P.IsHomogeneous j)
    (h : dehomogenize R ℓ P = 0) : P = 0 := by
  let L := FractionRing (MvPolynomial σ R)
  let ι := algebraMap (MvPolynomial σ R) L
  let f : R →+* L := ι.comp C
  have hinj : Function.Injective ι := IsFractionRing.injective _ _
  set a : L := ι (X ℓ) with ha
  have ha0 : a ≠ 0 := fun h0 => X_ne_zero ℓ (hinj (h0.trans (map_zero ι).symm))
  let y : σ → L := fun i => ι (X i) / a
  have hy : (fun i => ι (X i)) = fun i => a * y i :=
    funext fun i => (mul_div_cancel₀ _ ha0).symm
  have hι : ι P = eval₂ f (fun i => ι (X i)) P := by
    have : ι = eval₂Hom f (fun i => ι (X i)) :=
      MvPolynomial.ringHom_ext (fun r => by simp [f]) (fun i => by simp)
    exact congrArg (fun φ : MvPolynomial σ R →+* L => φ P) this
  have hyℓ : (fun i => if h : i = ℓ then 1 else y i) = y := by
    funext i
    by_cases h : i = ℓ
    · subst h
      simp [y, ← ha, div_self ha0]
    · simp [h]
  have key : eval₂ f y P = 0 := by
    have := eval₂_dehomogenize f ℓ (fun i => y i.1) P
    rw [h, eval₂_zero] at this
    rw [this]
    exact congrArg (fun v => eval₂ f v P) hyℓ.symm
  apply hinj
  rw [hι, hy, eval₂_mul_of_isHomogeneous f y a hP, key, mul_zero, map_zero]

/-- For a prime `p`, a homogeneous polynomial whose dehomogenization has coefficients in `p`
has its coefficients in `p`. -/
theorem mem_map_C_of_isHomogeneous_of_dehomogenize_mem {A : Type*} [CommRing A] (p : Ideal A)
    [p.IsPrime] {ℓ : σ} {P : MvPolynomial σ A} {j : ℕ} (hP : P.IsHomogeneous j)
    (h : dehomogenize A ℓ P ∈ Ideal.map C p) : P ∈ Ideal.map C p := by
  rw [← Ideal.mk_ker (I := p), ← MvPolynomial.ker_map, RingHom.mem_ker] at h ⊢
  rw [map_dehomogenize] at h
  exact eq_zero_of_isHomogeneous_of_dehomogenize_eq_zero (hP.map _) h

end Dehomogenization

/-! ### The exceptional ideal on a chart -/

section Chart

open MvPolynomial MMP.Flips.ResolutionInputs

variable {X : Scheme.{u}} {I : X.IdealSheafData} (c : BlowupChartData I)

/-- Over the affine open `U` itself, `I(U)` is generated by `x_1, …, x_r`. -/
theorem BlowupChartData.ideal_eq_span (hU : IsAffineOpen c.U) :
    I.ideal ⟨c.U, hU⟩ = Ideal.span (Set.range c.x) := by
  rw [c.generates ⟨c.U, hU⟩ le_rfl]
  simp

/-- The generators `x_i` are sections of `I` over `U`. -/
theorem BlowupChartData.x_mem_ideal (hU : IsAffineOpen c.U) (i : Fin c.r) :
    c.x i ∈ I.ideal ⟨c.U, hU⟩ := by
  rw [c.ideal_eq_span hU]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- The germ at a point of the chart `U_ℓ` of the pull-back `π^*a` of a section over `U` is the
image of the germ of `a` under the stalk map of the blow-up. -/
theorem BlowupChartData.stalkMap_germ (ℓ : Fin c.r) {y : blowUp I} (hy : y ∈ c.chart ℓ)
    (a : Γ(X, c.U)) :
    (blowUpToBase I).stalkMap y ((X.presheaf.germ c.U (blowUpToBase I y) (c.chart_le ℓ hy)) a) =
      (blowUp I).presheaf.germ (c.chart ℓ) y hy (c.chartPullback ℓ a) := by
  refine (Scheme.Hom.germ_stalkMap_apply (blowUpToBase I) c.U y (c.chart_le ℓ hy) a).trans ?_
  simp only [BlowupChartData.chartPullback, Scheme.Hom.appLE, CommRingCat.comp_apply,
    TopCat.Presheaf.germ_res_apply]

/-- On the chart `U_ℓ` the inverse-image ideal `π^*I` is generated by `π^*x_ℓ`. -/
theorem BlowupChartData.stalk_comap_eq_span (hU : IsAffineOpen c.U) (ℓ : Fin c.r)
    {y : blowUp I} (hy : y ∈ c.chart ℓ) :
    IdealSheafData.stalk (I.comap (blowUpToBase I)) y =
      Ideal.span {(blowUp I).presheaf.germ (c.chart ℓ) y hy (c.chartPullback ℓ (c.x ℓ))} := by
  rw [IdealSheafData.stalk_comap, IdealSheafData.stalk_eq_map_germ I _ ⟨c.U, hU⟩
    (c.chart_le ℓ hy), c.ideal_eq_span hU, Ideal.map_span, Ideal.map_span, ← Set.range_comp,
    ← Set.range_comp]
  rw [show (((blowUpToBase I).stalkMap y).hom ∘
      (X.presheaf.germ c.U (blowUpToBase I y) (c.chart_le ℓ hy)).hom ∘ c.x) =
      fun i => (blowUp I).presheaf.germ (c.chart ℓ) y hy (c.chartPullback ℓ (c.x i)) from
      funext fun i => c.stalkMap_germ ℓ hy (c.x i)]
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe]
    rw [chartPullback_eq_chartFraction_mul c ℓ i, map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  · rintro _ rfl
    exact Ideal.subset_span ⟨ℓ, rfl⟩

/-- **Coefficients of a polynomial vanishing along the exceptional divisor.** Let `x_1, …, x_n` be local
coordinates on an affine open `U`, the first `r` of which generate `I|_U`, and let `ξ` be a point
of the chart `U_ℓ` which specializes to every point of the exceptional divisor `F = V(π^*I)`,
with `x_1, …, x_r` vanishing at `π(ξ)`. If a polynomial `Q ∈ 𝒪_X(U)[T_i : i ≠ ℓ]` evaluates, at
`T_i = x_i/x_ℓ`, to a function vanishing at `ξ`, then all coefficients of `Q` vanish at
`π(ξ)`. -/
theorem BlowupChartData.mem_map_C_of_germ_chartPresentation_mem {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) (hU : IsAffineOpen c.U) {n : ℕ} (x : Fin n → Γ(X, c.U))
    (hx : IsLocalCoordinates sX c.U x) (hrn : c.r ≤ n) (hcx : ∀ i, c.x i = x (Fin.castLE hrn i))
    (ℓ : Fin c.r) {ξ : blowUp I} (hξ : ξ ∈ c.chart ℓ)
    (hgen : ∀ y ∈ ((I.comap (blowUpToBase I)).support : Set (blowUp I)), ξ ⤳ y)
    (hxm : ∀ i, X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ) (c.x i) ∈
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)))
    (Q : MvPolynomial {i : Fin c.r // i ≠ ℓ} Γ(X, c.U))
    (hQ : (blowUp I).presheaf.germ (c.chart ℓ) ξ hξ (chartPresentation c ℓ Q) ∈
      maximalIdeal ((blowUp I).presheaf.stalk ξ)) :
    Q ∈ Ideal.map C ((maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ))).comap
      (X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ)).hom) := by
  set t₀ := c.chartPullback ℓ (c.x ℓ) with ht₀
  set s := chartPresentation c ℓ Q with hs
  set p := (maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ))).comap
      (X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ)).hom
  have hle : (blowUp I).basicOpen s ≤ (blowUp I).basicOpen t₀ := by
    intro y hy
    have hyU : y ∈ c.chart ℓ := (blowUp I).basicOpen_le s hy
    by_contra hyt
    have hyE : y ∈ ((I.comap (blowUpToBase I)).support : Set (blowUp I)) := by
      by_contra hyE
      have htop := (IdealSheafData.stalk_eq_top_iff_notMem_support _ y).2 hyE
      rw [c.stalk_comap_eq_span hU ℓ hyU, Ideal.span_singleton_eq_top] at htop
      exact hyt (((blowUp I).mem_basicOpen t₀ y hyU).2 htop)
    have hξs : ξ ∈ (blowUp I).basicOpen s :=
      (hgen y hyE).mem_open ((blowUp I).basicOpen s).isOpen hy
    rw [(blowUp I).mem_basicOpen s ξ hξ] at hξs
    exact (IsLocalRing.mem_maximalIdeal _).mp hQ hξs
  have hW := isAffineOpen_chart c hU ℓ
  have h2 : PrimeSpectrum.basicOpen s ≤ PrimeSpectrum.basicOpen t₀ := by
    rw [← hW.fromSpec_preimage_basicOpen, ← hW.fromSpec_preimage_basicOpen]
    exact fun q hq => hle hq
  rw [PrimeSpectrum.basicOpen_le_basicOpen_iff] at h2
  obtain ⟨N, hN⟩ := h2
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hN
  obtain ⟨hsurj, hker⟩ := chartPresentation_surjective_and_ker c sX hU x hx hrn hcx ℓ
  obtain ⟨Q', rfl⟩ := hsurj w
  have hC : chartPresentation c ℓ (C (c.x ℓ)) = t₀ := by
    simp [chartPresentation, ht₀, BlowupChartData.chartPullback]
  have hmem : Q ^ N - Q' * C (c.x ℓ) ∈ RingHom.ker (chartPresentation c ℓ) := by
    rw [RingHom.mem_ker, map_sub, map_pow, map_mul, hC, ← hs, hw, sub_self]
  have hxp : ∀ i, c.x i ∈ p := hxm
  have hrel : RingHom.ker (chartPresentation c ℓ) ≤ Ideal.map C p := by
    rw [hker, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact sub_mem (Ideal.mem_map_of_mem _ (hxp i))
      (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hxp ℓ)))
  have hpow : Q ^ N ∈ Ideal.map C p := by
    have h3 : Q' * C (c.x ℓ) ∈ Ideal.map C p :=
      Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hxp ℓ))
    simpa using add_mem (hrel hmem) h3
  have : p.IsPrime := Ideal.comap_isPrime _ _
  rw [← Ideal.mk_ker (I := p), ← MvPolynomial.ker_map, RingHom.mem_ker] at hpow ⊢
  rw [map_pow] at hpow
  exact pow_eq_zero_iff'.mp hpow |>.1

/-- On the chart `U_ℓ`, the pull-back of a homogeneous form `P(x_1, …, x_r)` of degree `j` is
`(π^*x_ℓ)^j · P(x_1/x_ℓ, …, 1, …, x_r/x_ℓ)`. -/
theorem BlowupChartData.chartPullback_eval_eq (ℓ : Fin c.r)
    {P : MvPolynomial (Fin c.r) Γ(X, c.U)} {j : ℕ} (hP : P.IsHomogeneous j) :
    c.chartPullback ℓ (eval c.x P) =
      c.chartPullback ℓ (c.x ℓ) ^ j * chartPresentation c ℓ (dehomogenize _ ℓ P) := by
  have h1 : c.chartPullback ℓ (eval c.x P) = eval₂ (chartPullbackHom c ℓ)
      (fun i => c.chartPullback ℓ (c.x ℓ) *
        (if h : i = ℓ then 1 else chartFraction c ℓ i)) P := by
    change chartPullbackHom c ℓ (eval₂ (RingHom.id _) c.x P) = _
    rw [eval₂_comp_left, RingHom.comp_id]
    congr 1
    funext i
    by_cases h : i = ℓ
    · subst h
      simp only [Function.comp_apply, dite_true, mul_one]
      rfl
    · simp only [Function.comp_apply, h, dite_false]
      rw [mul_comm]
      exact chartPullback_eq_chartFraction_mul c ℓ i
  rw [h1, eval₂_mul_of_isHomogeneous _ _ _ hP]
  congr 1
  exact (eval₂_dehomogenize (chartPullbackHom c ℓ) ℓ (fun i => chartFraction c ℓ i.1) P).symm

/-- If the germ at `π(ξ)` of a section `a` over `U` lies in `𝔪_{π(ξ)}^j` and its pull-back lies
in `𝔪_ξ^{j+1}`, then the germ lies in `𝔪_{π(ξ)}^{j+1}`. -/
theorem BlowupChartData.germ_mem_maximalIdeal_pow_succ {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) (hU : IsAffineOpen c.U) {n : ℕ} (x : Fin n → Γ(X, c.U))
    (hx : IsLocalCoordinates sX c.U x) (hrn : c.r ≤ n) (hcx : ∀ i, c.x i = x (Fin.castLE hrn i))
    (ℓ : Fin c.r) {ξ : blowUp I} (hξ : ξ ∈ c.chart ℓ)
    (hgen : ∀ y ∈ ((I.comap (blowUpToBase I)).support : Set (blowUp I)), ξ ⤳ y)
    (hIξ : IdealSheafData.stalk I (blowUpToBase I ξ) =
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)))
    (hEξ : IdealSheafData.stalk (I.comap (blowUpToBase I)) ξ =
      maximalIdeal ((blowUp I).presheaf.stalk ξ))
    [IsDomain ((blowUp I).presheaf.stalk ξ)]
    (hm0 : maximalIdeal ((blowUp I).presheaf.stalk ξ) ≠ ⊥) {j : ℕ} (a : Γ(X, c.U))
    (ha' : (X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ)).hom a ∈
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)) ^ j)
    (ha : ((blowUpToBase I).stalkMap ξ).hom
      ((X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ)).hom a) ∈
        maximalIdeal ((blowUp I).presheaf.stalk ξ) ^ (j + 1)) :
    (X.presheaf.germ c.U (blowUpToBase I ξ) (c.chart_le ℓ hξ)).hom a ∈
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)) ^ (j + 1) := by
  set y := blowUpToBase I ξ
  have hyU : y ∈ c.U := c.chart_le ℓ hξ
  set ψ := (X.presheaf.germ c.U y hyU).hom
  set φ := ((blowUpToBase I).stalkMap ξ).hom
  set τ := (blowUp I).presheaf.germ (c.chart ℓ) ξ hξ (c.chartPullback ℓ (c.x ℓ))
  have hmy : maximalIdeal (X.presheaf.stalk y) = (Ideal.span (Set.range c.x)).map ψ := by
    rw [← hIξ, IdealSheafData.stalk_eq_map_germ I y ⟨c.U, hU⟩ hyU, c.ideal_eq_span hU]
  have hmξ : maximalIdeal ((blowUp I).presheaf.stalk ξ) = Ideal.span {τ} := by
    rw [← hEξ, c.stalk_comap_eq_span hU ℓ hξ]
  have hτ0 : τ ≠ 0 := fun h => hm0 (by rw [hmξ, h, Ideal.span_singleton_eq_bot])
  have hxm : ∀ i, ψ (c.x i) ∈ maximalIdeal (X.presheaf.stalk y) := fun i => by
    rw [hmy]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
  have hcompat : ∀ a, φ (ψ a) =
      (blowUp I).presheaf.germ (c.chart ℓ) ξ hξ (c.chartPullback ℓ a) :=
    fun a => c.stalkMap_germ ℓ hξ a
  let : Algebra Γ(X, c.U) (X.presheaf.stalk y) := ψ.toAlgebra
  let M := (hU.primeIdealOf ⟨y, hyU⟩).asIdeal.primeCompl
  have : IsLocalization M (X.presheaf.stalk y) := hU.isLocalization_stalk ⟨y, hyU⟩
  rw [hmy, ← Ideal.map_pow] at ha'
  obtain ⟨⟨b, m'⟩, hbm⟩ := (IsLocalization.mem_map_algebraMap_iff M (X.presheaf.stalk y)).mp ha'
  have hab : algebraMap Γ(X, c.U) (X.presheaf.stalk y) (a * m') =
      algebraMap Γ(X, c.U) (X.presheaf.stalk y) (b : Γ(X, c.U)) :=
    (map_mul _ _ _).trans hbm
  obtain ⟨c', hc'⟩ := (IsLocalization.eq_iff_exists M (X.presheaf.stalk y)).mp hab
  set u : M := c' * m' with hu
  have hua : (u : Γ(X, c.U)) * a ∈ Ideal.span (Set.range c.x) ^ j := by
    rw [show (u : Γ(X, c.U)) * a = c' * (a * m') by
      simp only [hu, Submonoid.coe_mul]
      ring, hc']
    exact Ideal.mul_mem_left _ _ b.2
  have hunit : IsUnit (ψ u) := IsLocalization.map_units (X.presheaf.stalk y) u
  suffices h : ψ (u * a) ∈ maximalIdeal (X.presheaf.stalk y) ^ (j + 1) by
    rw [map_mul, mul_comm] at h
    exact (Ideal.mul_unit_mem_iff_mem _ hunit).mp h
  obtain ⟨P, hPh, hPe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous c.x _).mp hua
  have h1 : φ (ψ (u * a)) ∈ maximalIdeal ((blowUp I).presheaf.stalk ξ) ^ (j + 1) := by
    rw [map_mul, map_mul]
    exact Ideal.mul_mem_left _ _ ha
  rw [← hPe]
  refine map_eval_mem_pow_succ ψ _ c.x hxm hPh ?_
  refine mem_map_C_of_isHomogeneous_of_dehomogenize_mem (ℓ := ℓ) _ hPh ?_
  refine c.mem_map_C_of_germ_chartPresentation_mem sX hU x hx hrn hcx ℓ hξ hgen hxm _ ?_
  rw [← hPe, hcompat, c.chartPullback_eval_eq ℓ hPh, map_mul, map_pow, hmξ,
    Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
  obtain ⟨v, hv⟩ := h1
  rw [hmξ, Ideal.mem_span_singleton']
  exact ⟨v, mul_eq_of_mul_pow_succ_eq hτ0 hv⟩

/-- **Orders of functions along the generic point of the exceptional divisor of a coordinate
blow-up.** In the setting of
`MMP.Resolution.BlowupChartData.mem_map_C_of_germ_chartPresentation_mem`, suppose moreover that
`I` and `π^*I` have maximal stalks at `π(ξ)` and `ξ`, and that `𝒪_ξ` is a domain which is not a
field. Then `𝔪_ξ^j ∩ 𝒪_{π(ξ)} = 𝔪_{π(ξ)}^j` for every `j`. -/
theorem BlowupChartData.comap_stalkMap_maximalIdeal_pow {k : Type u} [Field k]
    (sX : X ⟶ Spec (.of k)) (hU : IsAffineOpen c.U) {n : ℕ} (x : Fin n → Γ(X, c.U))
    (hx : IsLocalCoordinates sX c.U x) (hrn : c.r ≤ n) (hcx : ∀ i, c.x i = x (Fin.castLE hrn i))
    (ℓ : Fin c.r) {ξ : blowUp I} (hξ : ξ ∈ c.chart ℓ)
    (hgen : ∀ y ∈ ((I.comap (blowUpToBase I)).support : Set (blowUp I)), ξ ⤳ y)
    (hIξ : IdealSheafData.stalk I (blowUpToBase I ξ) =
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)))
    (hEξ : IdealSheafData.stalk (I.comap (blowUpToBase I)) ξ =
      maximalIdeal ((blowUp I).presheaf.stalk ξ))
    [IsDomain ((blowUp I).presheaf.stalk ξ)]
    (hm0 : maximalIdeal ((blowUp I).presheaf.stalk ξ) ≠ ⊥) (j : ℕ) :
    (maximalIdeal ((blowUp I).presheaf.stalk ξ) ^ j).comap ((blowUpToBase I).stalkMap ξ).hom =
      maximalIdeal (X.presheaf.stalk (blowUpToBase I ξ)) ^ j := by
  set y := blowUpToBase I ξ
  have hyU : y ∈ c.U := c.chart_le ℓ hξ
  set ψ := (X.presheaf.germ c.U y hyU).hom
  set φ := ((blowUpToBase I).stalkMap ξ).hom
  have : IsLocalHom φ := inferInstanceAs (IsLocalHom ((blowUpToBase I).stalkMap ξ).hom)
  let : Algebra Γ(X, c.U) (X.presheaf.stalk y) := ψ.toAlgebra
  let M := (hU.primeIdealOf ⟨y, hyU⟩).asIdeal.primeCompl
  have : IsLocalization M (X.presheaf.stalk y) := hU.isLocalization_stalk ⟨y, hyU⟩
  have halg : ∀ a, algebraMap Γ(X, c.U) (X.presheaf.stalk y) a = ψ a := fun _ => rfl
  refine le_antisymm ?_ ?_
  swap
  · rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    exact Ideal.pow_right_mono
      (Ideal.map_le_iff_le_comap.2 (IsLocalRing.maximalIdeal_comap φ).ge) j
  induction j with
  | zero => simp
  | succ j ih =>
    intro g hg
    obtain ⟨⟨a, m'⟩, rfl⟩ := IsLocalization.mk'_surjective M g
    have hspec := IsLocalization.mk'_spec (X.presheaf.stalk y) a m'
    have hunit := IsLocalization.map_units (X.presheaf.stalk y) m'
    rw [← Ideal.mul_unit_mem_iff_mem _ hunit, hspec, halg]
    have ha : φ (ψ a) ∈ maximalIdeal ((blowUp I).presheaf.stalk ξ) ^ (j + 1) := by
      rw [← halg, ← hspec, map_mul]
      exact Ideal.mul_mem_right _ _ hg
    exact c.germ_mem_maximalIdeal_pow_succ sX hU x hx hrn hcx ℓ hξ hgen hIξ hEξ hm0 a
      (ih (Ideal.pow_le_pow_right (Nat.le_succ j) ha)) ha

end Chart

/-! ### The order along the exceptional divisor -/

section Exceptional

open MMP.Flips.ResolutionInputs

variable {k : Type u} [Field k] {X : Scheme.{u}}

/-- A morphism smooth at every point is smooth. -/
private theorem smooth_of_isSmoothScheme' {Y Z : Scheme.{u}} {f : Y ⟶ Z}
    (h : MMP.Mori.IsSmoothScheme f) : Smooth f := by
  have : IsZariskiLocalAtSource @Smooth := HasRingHomProperty.instIsZariskiLocalAtSource
  refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth)
    (fun U : {U : Y.Opens // Smooth (U.ι ≫ f)} => U.1) ?_ fun U => U.2
  rw [← h, MMP.Mori.smoothLocus, sSup_eq_iSup']
  rfl

/-- The support of the exceptional prime divisor is irreducible. -/
theorem isIrreducible_support_exceptionalPrimeDivisor (sX : X ⟶ Spec (.of k))
    (I : X.IdealSheafData) (h : IsSmoothBlowup sX I) (hirr : IsIrreducible (I.support : Set X))
    (hcodim : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds X)) :
    IsIrreducible (exceptionalPrimeDivisor sX I h hirr hcodim).support := by
  have := isIntegral_exceptionalDivisor sX I h hirr hcodim
  change IsIrreducible ((exceptionalIdeal I).support : Set (blowUp I))
  rw [← (exceptionalIdeal I).range_subschemeι, ← Set.image_univ]
  exact (IrreducibleSpace.isIrreducible_univ _).image _ (Scheme.Hom.continuous _).continuousOn

/-- The image of the generic point of an irreducible closed set `S` under a closed morphism `f`
with `f(S) = V(I)` is the generic point of `V(I)`. -/
theorem subschemeι_genericPoint_eq_apply_genericPoint {Y : Scheme.{u}} (f : Y ⟶ X)
    (hf : IsClosedMap f) (I : X.IdealSheafData) [IsIntegral I.subscheme] {S : Set Y}
    (hS : IsIrreducible S) (hSc : IsClosed S) (himg : f '' S = I.support) :
    I.subschemeι (genericPoint I.subscheme) = f hS.genericPoint := by
  refine IsGenericPoint.eq (closure_subschemeι_genericPoint I) ?_
  change closure {f hS.genericPoint} = _
  rw [← Set.image_singleton, hf.closure_image_eq_of_continuous f.continuous,
    hS.isGenericPoint_genericPoint_closure.trans hSc.closure_eq, himg]

/-- The local ring of a locally noetherian scheme at the generic point of an integral effective
Cartier divisor is not a field. -/
theorem maximalIdeal_stalk_ne_bot_of_isEffectiveCartierDivisor {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] (D : Y.IdealSheafData) [IsIntegral D.subscheme]
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) {ξ : Y}
    (hξ : D.subschemeι (genericPoint D.subscheme) = ξ) :
    maximalIdeal (Y.presheaf.stalk ξ) ≠ ⊥ := by
  subst hξ
  intro hm
  have hdim := ringKrullDim_stalk_eq_one_of_isEffectiveCartierDivisor D hD
    (genericPoint D.subscheme)
    ⟨⟨Set.univ, by
      rw [irreducibleComponents_eq_singleton]
      rfl⟩, genericPoint_spec D.subscheme⟩
  rw [ringKrullDim_eq_zero_of_isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm)] at hdim
  exact absurd hdim (by decide)

/-- Near a point of a smooth centre `V(I)` of a smooth scheme there are local coordinates on an
affine open, the first few of which cut out `I`. -/
theorem exists_isLocalCoordinates_isCutOutByFirst (sX : X ⟶ Spec (.of k)) [Smooth sX]
    (I : X.IdealSheafData) [Smooth (I.subschemeι ≫ sX)] (z : I.subscheme) :
    ∃ (m : ℕ) (U : X.Opens) (_ : IsAffineOpen U) (_ : I.subschemeι z ∈ U) (n : ℕ)
      (x : Fin n → Γ(X, U)), IsLocalCoordinates sX U x ∧ Bridges.IsCutOutByFirst I U x m := by
  obtain ⟨nX, hnX⟩ := Stacks.RelativeAssassin.exists_nat_eq_topologicalKrullDimAt X k sX
    (I.subschemeι z)
  obtain ⟨nZ, hnZ⟩ := Stacks.RelativeAssassin.exists_nat_eq_topologicalKrullDimAt I.subscheme k
    (I.subschemeι ≫ sX) z
  have hle :=
    Stacks.AlgebraicGeometry.LimitFibreDimensionBound.topologicalKrullDimAt_le_of_isInducing
      I.subschemeι.isClosedEmbedding.isInducing z
  rw [hnX, hnZ] at hle
  have hle' : nZ ≤ nX := mod_cast hle
  obtain ⟨U, hU, hzU, x, hx, hcut⟩ := Bridges.exists_isLocalCoordinates_adapted sX I z
    (c := nX - nZ) (by rw [hnX, hnZ, ← Nat.cast_add, Nat.add_sub_cancel' hle'])
  exact ⟨nX - nZ, U, hU, hzU, _, x, hx, hcut⟩

/-- The chart data of the coordinates `x_1, …, x_n` on `U` whose first `m` cut out `I`. -/
def BlowupChartData.ofIsCutOutByFirst {I : X.IdealSheafData} {U : X.Opens} {n m : ℕ}
    (x : Fin n → Γ(X, U)) (hcut : Bridges.IsCutOutByFirst I U x m) : BlowupChartData I where
  U := U
  r := min m n
  x i := x (Fin.castLE (min_le_right _ _) i)
  generates V hV := by
    rw [hcut V hV]
    congr 1
    ext s
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, lt_min hi i.2⟩, rfl⟩
    · rintro ⟨j, rfl⟩
      exact ⟨Fin.castLE (min_le_right _ _) j, lt_of_lt_of_le j.2 (min_le_left _ _), rfl⟩

/-- **Kollár, Def. 3.47 (last paragraph): the order along the exceptional divisor of a smooth
blow-up is the order along the centre.** Let `X` be smooth over `k` and `Z = V(I) ⊆ X` an
irreducible closed subscheme, smooth over `k`, of codimension `≥ 1`, with blow-up
`π : B_Z X → X` and exceptional prime divisor `F = π⁻¹(Z)`. Then for every ideal sheaf
`J ⊆ 𝒪_X`, `ord_F(π^*J) = ord_Z J`. -/
@[mmp "lem_kr3c_order_eq_multiplicity_along_exceptional"]
theorem orderAlong_comap_blowUpToBase_eq (sX : X ⟶ Spec (.of k)) (I : X.IdealSheafData)
    (h : IsSmoothBlowup sX I) (hirr : IsIrreducible (I.support : Set X))
    (hcodim : 1 ≤ codimension (⟨I.support, hirr, I.support.isClosed⟩ : IrreducibleCloseds X))
    (J : X.IdealSheafData) :
    orderAlong (J.comap (blowUpToBase I))
        (isIrreducible_support_exceptionalPrimeDivisor sX I h hirr hcodim) =
      orderAlong J hirr := by
  have : Smooth sX := smooth_of_isSmoothScheme' h.1
  have : Smooth (I.subschemeι ≫ sX) := smooth_of_isSmoothScheme' h.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have := isIntegral_subscheme_of_isIrreducible sX I h.2 hirr
  have := isIntegral_exceptionalDivisor sX I h hirr hcodim
  obtain ⟨hBsm, F, hFid, -, hFimg⟩ :=
    isSmoothScheme_blowUp_and_exists_primeDivisor_exceptionalIdeal sX I h hirr hcodim
  have : Smooth (blowUpToBase I ≫ sX) := smooth_of_isSmoothScheme' hBsm
  have : IsLocallyNoetherian (blowUp I) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase I ≫ sX)
  set hF := isIrreducible_support_exceptionalPrimeDivisor sX I h hirr hcodim
  set E := exceptionalIdeal I with hE
  set ξ := hF.genericPoint with hξ
  set π := blowUpToBase I with hπ
  have hFimg' : π '' (E.support : Set (blowUp I)) = I.support := by
    rwa [← show F.support = (E.support : Set (blowUp I)) by
      simp only [AlgebraicGeometry.PrimeDivisor.support, hFid, hE]]
  have hξgen : IsGenericPoint ξ (E.support : Set (blowUp I)) :=
    hF.isGenericPoint_genericPoint_closure.trans E.support.isClosed.closure_eq
  have hξeq : E.subschemeι (genericPoint E.subscheme) = ξ :=
    IsGenericPoint.eq (closure_subschemeι_genericPoint E) hξgen
  have hηeq : I.subschemeι (genericPoint I.subscheme) = π ξ :=
    subschemeι_genericPoint_eq_apply_genericPoint π π.isClosedMap I (S := E.support) hF
      E.support.isClosed hFimg'
  have hπη : π ξ = hirr.genericPoint := hηeq ▸ IsGenericPoint.eq (closure_subschemeι_genericPoint I)
    (hirr.isGenericPoint_genericPoint_closure.trans I.support.isClosed.closure_eq)
  have hIξ : IdealSheafData.stalk I (π ξ) = maximalIdeal (X.presheaf.stalk (π ξ)) :=
    hηeq ▸ IdealSheafData.stalk_subschemeι_genericPoint_eq_maximalIdeal I
  have hEξ : IdealSheafData.stalk (I.comap π) ξ = maximalIdeal ((blowUp I).presheaf.stalk ξ) :=
    hξeq ▸ IdealSheafData.stalk_subschemeι_genericPoint_eq_maximalIdeal E
  have := isRegularLocalRing_stalk_of_smooth_over_field (π ≫ sX) ξ
  have := IsRegularLocalRing.isDomain ((blowUp I).presheaf.stalk ξ)
  have hm0 := maximalIdeal_stalk_ne_bot_of_isEffectiveCartierDivisor E
    (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal I) hξeq
  have hgen : ∀ y ∈ ((I.comap π).support : Set (blowUp I)), ξ ⤳ y := fun y hy => by
    rwa [specializes_iff_mem_closure, hξgen.def]
  obtain ⟨m, U, hU, hzU, n, x, hx, hcut⟩ :=
    exists_isLocalCoordinates_isCutOutByFirst sX I (genericPoint I.subscheme)
  let cd := BlowupChartData.ofIsCutOutByFirst x hcut
  have hξU : ξ ∈ π ⁻¹ᵁ cd.U := show π ξ ∈ U from hηeq ▸ hzU
  rw [← iSup_chart_eq_preimage cd] at hξU
  obtain ⟨ℓ, hξℓ⟩ := TopologicalSpace.Opens.mem_iSup.mp hξU
  have hpow := cd.comap_stalkMap_maximalIdeal_pow sX hU x hx (min_le_right m n) (fun _ => rfl) ℓ
    hξℓ hgen hIξ hEξ hm0
  simp only [orderAlong, multAt, IdealSheafData.stalk_comap]
  rw [← hξ, ← hπη]
  simp only [idealOrder, Ideal.map_le_iff_le_comap]
  rw [← hπ] at hpow
  simp only [hpow]

end Exceptional

end MMP.Resolution
