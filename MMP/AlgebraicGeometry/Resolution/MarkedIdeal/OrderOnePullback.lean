/-!
# Pulling back along a smooth blow-up sequence of order `≥ 1` (Kollár, *Resolution*, 3.72)

Let `(X_i, Z_i)_{i < r}` be a smooth blow-up sequence of order `≥ m` starting with the marked
triple `(X, I, m, E)`, with marked triples `(X_i, I_i, m, E_i)`, exceptional divisors
`F_{i+1} = π_i⁻¹(Z_i) ⊆ X_{i+1}` and composites `Π_{r,i} : X_r → X_i`. Since
`π_i^*I_i = 𝒪(-mF_{i+1})·I_{i+1}` at every step and inverse images of ideal sheaves are
multiplicative,
`Π_{r,0}^*I = I_r · 𝒪_{X_r}(-m ∑_{i<r} Π_{r,i+1}^*F_{i+1})`.

If moreover `maxord I_r < 1`, then `I_r = 𝒪_{X_r}` and `Π_{r,0}^*I` is a power of the ideal of the
divisor `G = ∑_{i<r} Π_{r,i+1}^*F_{i+1}`. Every `F_{i+1}` lies in the support of the ordered
divisor `E_{i+1}`, and the inverse image of `Supp E_i` lies in `Supp E_{i+1}`; so `Supp G` lies in
`Supp E_r`, an snc divisor. At a point `x ∈ X_r` with local coordinates `z_1, …, z_n` such that the
entries of `E_r` through `x` are the `(z_{c(j)} = 0)`, the stalk of `𝒪(-G)` is generated by one
element `f`, and a power of `∏_j z_{c(j)}` is a multiple of `f`. The local ring is a unique
factorization domain and the `z_{c(j)}` are primes, so `f` is a unit times a monomial in them:
`Π_{r,0}^*I` is a monomial ideal.

Applied to the principalization construction `𝓑𝓟_𝓑` of 3.72, whose part after the disjoining
sequence `π : X' → X` is `𝓑(X', π^*I, 1, E_{X'})`, this shows that `𝓑𝓟_𝓑` principalizes `I` when
the last ideals of `𝓑` have maximal order `< 1`.

## Main definitions

* `MMP.Resolution.ClosedBlowupSequence.exceptionalIdeal`: the ideal sheaf
  `𝒪_{X_r}(-∑_{i<r} Π_{r,i+1}^*F_{i+1})` of a blow-up sequence.

## Main results

* `MMP.Resolution.ClosedBlowupSequence.comap_toBase_eq_markedTransform_mul_exceptionalIdeal_pow`:
  `Π^*I = I_r · 𝒪(-∑_i Π_{r,i+1}^*F_{i+1})^m` along a smooth blow-up sequence of order `≥ m`.
* `MMP.Resolution.ClosedBlowupSequence.isMonomialIdeal_comap_toBase_of_maxOrder_lt_one`:
  if `maxord I_r < 1`, then `Π^*I` is a monomial ideal.
* `MMP.Resolution.isMonomialIdeal_comap_principalizationConstruction`: the construction `𝓑𝓟_𝓑`
  of 3.72 principalizes `I`.

## Implementation notes

The source states the first two results for the marking `m = 1`; they are proved for every
marking (for `maxord I_r < 1` the marking only enters as an exponent).
The source sums the divisors `Π_{r,j+1}^*F_j` up to `j = r`; the last blow-up is `π_{r-1}`, so the
sum runs over `i < r`, and the factor is `𝒪_{X_r}(-∑ Π_{r,i+1}^*F_{i+1})`. The ideal sheaf of a
sum of effective Cartier divisors is the product of their ideal sheaves, so `𝒪(-G)` is the
product `∏_i (Π_{r,i+1}^*F_{i+1})` of inverse images of ideal sheaves.

For the principalization construction, the scheme `X` is assumed equidimensional. A marked
triple is equidimensional, and a blow-up of a scheme which is not equidimensional is not either,
so without this hypothesis `(X', π^*I, 1, E_{X'})` is not a marked triple, the construction
returns the disjoining sequence alone, and `π^*I` need not be monomial (for instance
`X = 𝔸¹ ⊔ 𝔸²`, `E = ()` and `I` the ideal of a cuspidal curve in `𝔸²`).

## References

* [J. Kollár, *Lectures on resolution of singularities*, 3.72]
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace IsLocalRing

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

universe u

namespace MMP.Resolution

/-! ### Divisors of monomials in primes -/

section Algebra

variable {R : Type*} [CommMonoidWithZero R] [IsCancelMulZero R] [DecompositionMonoid R]
  {ι : Type*}

/-- A divisor of a product of powers of primes is associated to a product of powers of the same
primes. -/
theorem exists_associated_prod_pow_of_dvd_prod_pow (z : ι → R) (N : ι → ℕ) :
    ∀ (s : Finset ι), (∀ i ∈ s, Prime (z i)) → ∀ {f : R}, f ∣ ∏ i ∈ s, z i ^ N i →
      ∃ a : ι → ℕ, (∀ i ∉ s, a i = 0) ∧ Associated f (∏ i ∈ s, z i ^ a i) := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty =>
    intro _ f hf
    rw [Finset.prod_empty] at hf
    exact ⟨0, fun _ _ => rfl, by
      rw [Finset.prod_empty]; exact associated_one_iff_isUnit.mpr (isUnit_of_dvd_one hf)⟩
  | insert j s hj ih =>
    intro hz f hf
    rw [Finset.prod_insert hj] at hf
    obtain ⟨f₁, f₂, h₁, h₂, rfl⟩ := exists_dvd_and_dvd_of_dvd_mul hf
    obtain ⟨e, -, he⟩ := (dvd_prime_pow (hz j (Finset.mem_insert_self _ _)) _).1 h₁
    obtain ⟨a, ha0, ha⟩ := ih (fun i hi => hz i (Finset.mem_insert_of_mem hi)) h₂
    refine ⟨Function.update a j e, fun i hi => ?_, ?_⟩
    · rw [Function.update_of_ne (by rintro rfl; exact hi (Finset.mem_insert_self _ _))]
      exact ha0 i fun h => hi (Finset.mem_insert_of_mem h)
    · have hs : ∏ i ∈ s, z i ^ Function.update a j e i = ∏ i ∈ s, z i ^ a i :=
        Finset.prod_congr rfl fun i hi => by
          rw [Function.update_of_ne (by rintro rfl; exact hj hi)]
      rw [Finset.prod_insert hj, Function.update_self, hs]
      exact he.mul_mul ha

/-- A divisor of a product of powers of primes `z_i`, `i ∈ s`, is associated to a monomial
`∏ᵢ z_i^{a_i}` over the whole (finite) index set. -/
theorem exists_associated_prod_pow_univ_of_dvd_prod_pow [Fintype ι] (z : ι → R) (N : ι → ℕ)
    (s : Finset ι) (hz : ∀ i ∈ s, Prime (z i)) {f : R} (hf : f ∣ ∏ i ∈ s, z i ^ N i) :
    ∃ a : ι → ℕ, Associated f (∏ i, z i ^ a i) := by
  obtain ⟨a, ha0, ha⟩ := exists_associated_prod_pow_of_dvd_prod_pow z N s hz hf
  refine ⟨a, ?_⟩
  rwa [← Finset.prod_subset (Finset.subset_univ s) fun i _ hi => by rw [ha0 i hi, pow_zero]]

end Algebra

/-- A member of a regular system of parameters of a Noetherian local ring is a prime. -/
theorem prime_of_isRegularSystemOfParameters {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {m : ℕ} {w : Fin m → R} (hw : MMP.Mori.IsRegularSystemOfParameters w)
    (j : Fin m) : Prime (w j) :=
  (Ideal.span_singleton_prime (ne_zero_of_isRegularSystemOfParameters hw j)).1
    (isPrime_span_singleton_of_isRegularSystemOfParameters hw j)

/-! ### Ideals of maximal order `< 1` -/

/-- An ideal sheaf of maximal order `< 1` is the unit ideal sheaf. -/
theorem eq_top_of_maxOrder_lt_one {X : Scheme.{u}} {I : X.IdealSheafData}
    (h : maxOrder I < 1) : I = ⊤ := by
  rw [← Scheme.IdealSheafData.support_eq_bot_iff, eq_bot_iff]
  intro x hx
  have hle : multAt I x ≤ maxOrder I := le_iSup₂ (f := fun z (_ : z ∈ Set.univ) => multAt I z)
    x (Set.mem_univ x)
  have hst : IdealSheafData.stalk I x ≤ maximalIdeal _ :=
    IsLocalRing.le_maximalIdeal fun ht =>
      ((IdealSheafData.stalk_eq_top_iff_notMem_support I x).1 ht) hx
  have h1 : (1 : ℕ∞) ≤ multAt I x :=
    le_iSup_of_le 1 (le_iSup_of_le (by rwa [pow_one]) (by simp))
  exact absurd (h1.trans hle) (not_le.2 h)

/-! ### The exceptional ideal of a blow-up sequence -/

namespace ClosedBlowupSequence

/-- The ideal sheaf `𝒪_{X_r}(-∑_{i<r} Π_{r,i+1}^*F_{i+1})` of a blow-up sequence
`(X_i, Z_i)_{i<r}`, `F_{i+1} = π_i⁻¹(Z_i)` the exceptional divisor of `π_i : X_{i+1} → X_i` and
`Π_{r,i+1} : X_r → X_{i+1}` the composite: the product of the inverse images of the ideal
sheaves of the `F_{i+1}`. -/
def exceptionalIdeal : {X : Scheme.{u}} → (B : ClosedBlowupSequence X) →
    B.target.IdealSheafData
  | _, nil _ => 1
  | _, cons Z B => (Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal

variable {k : Type u} [Field k]

/-- **Kollár 3.72, `Π^*I = I_r · 𝒪_{X_r}(-∑_i Π_{r,i+1}^*F_{i+1})`.** Along a smooth blow-up
sequence of order `≥ m` starting with the marked triple `(X, I, m, E)`, with last ideal `I_r`,
`Π^*I = I_r · 𝒪_{X_r}(-∑_{i<r} Π_{r,i+1}^*F_{i+1})^m`, `F_{i+1}` the exceptional divisor of the
`i`-th blow-up. For `m = 1` this is Kollár's display (with the sum ending at `r - 1`). -/
@[mmp "lem_kr3c_pullback_along_marked_order_one_sequence"]
theorem comap_toBase_eq_markedTransform_mul_exceptionalIdeal_pow {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (hB : B.IsOrderGeMarkedTripleSeq s a E) :
    a.I.comap B.toBase = (B.markedTransform a).I * B.exceptionalIdeal ^ a.m := by
  induction B with
  | nil X =>
    change a.I.comap (𝟙 X) = a.I * 1 ^ a.m
    rw [Scheme.IdealSheafData.comap_id, one_pow, mul_one]
  | cons Z B ih =>
    obtain ⟨hT, hZ, hcod, -, hord, hB⟩ := hB
    have h1 := MarkedIdeal.birationalTransform_mul_eq s hT.2.1 Z hZ hcod a hord
    have h2 : (a.birationalTransform Z).I.comap B.toBase =
        (B.markedTransform (a.birationalTransform Z)).I * B.exceptionalIdeal ^ a.m :=
      ih _ _ _ hB
    change a.I.comap (B.toBase ≫ blowUpToBase Z) =
      (B.markedTransform (a.birationalTransform Z)).I *
        ((Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal) ^ a.m
    rw [Scheme.IdealSheafData.comap_comp, ← h1, Stacks.IdealSheaf.comap_mul,
      Stacks.IdealSheaf.comap_pow, h2, mul_pow, mul_assoc, mul_comm (B.exceptionalIdeal ^ _)]

/-- The source's case of marking `1`: `Π^*I = I_r · 𝒪_{X_r}(-∑_{i<r} Π_{r,i+1}^*F_{i+1})`. -/
@[mmp "lem_kr3c_pullback_along_marked_order_one_sequence"]
theorem comap_toBase_eq_markedTransform_mul_exceptionalIdeal {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (ha : a.m = 1) (hB : B.IsOrderGeMarkedTripleSeq s a E) :
    a.I.comap B.toBase = (B.markedTransform a).I * B.exceptionalIdeal := by
  rw [comap_toBase_eq_markedTransform_mul_exceptionalIdeal_pow B s a E hB, ha, pow_one]

/-- The last marked triple `(X_r, I_r, m, E_r)` of a smooth blow-up sequence of order `≥ m`
starting with a marked triple is a marked triple. -/
theorem isTriple_target_of_isOrderGeMarkedTripleSeq {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (hB : B.IsOrderGeMarkedTripleSeq s a E) :
    IsTriple (B.toBase ≫ s) (B.markedTransform a).I (B.orderedTotalTransform E) := by
  induction B with
  | nil X =>
    change IsTriple (𝟙 X ≫ s) a.I E
    rw [Category.id_comp]
    exact hB
  | cons Z B ih =>
    have h := ih _ _ _ hB.2.2.2.2.2
    change IsTriple ((B.toBase ≫ blowUpToBase Z) ≫ s)
      (B.markedTransform (a.birationalTransform Z)).I
      (B.orderedTotalTransform (E.totalTransform Z))
    rw [Category.assoc]
    exact h

end ClosedBlowupSequence

/-! ### Supports of total transforms -/

section Support

variable {X : Scheme.{u}}

/-- Let `E` be an ordered divisor whose entries are of pure codimension one and `Z ⊆ X` a closed
subscheme. Under the blow-up `π : B_ZX → X`, the inverse image of `Z ∪ Supp E` lies in the support
of the total transform `π⁻¹_tot(E)`. -/
theorem preimage_union_subset_support_totalTransform (E : OrderedDivisor X)
    (hE : ∀ i, MMP.Mori.IsPureCodimOne (E.E i).support) (Z : X.IdealSheafData) :
    blowUpToBase Z ⁻¹' ((Z.support : Set X) ∪ E.support) ⊆ (E.totalTransform Z).support := by
  rw [OrderedDivisor.support_totalTransform E hE Z]
  rintro x' (hx | hx)
  · exact Or.inr hx
  · by_cases hZ : blowUpToBase Z x' ∈ (Z.support : Set X)
    · exact Or.inr hZ
    · exact Or.inl (subset_closure ⟨hx, hZ⟩)

end Support

namespace ClosedBlowupSequence

variable {k : Type u} [Field k]

/-- Along a smooth blow-up sequence of order `≥ m` starting with `(X, I, m, E)`, the inverse
image of `Supp E` in `X_r` lies in `Supp E_r`. -/
theorem preimage_support_subset_support_orderedTotalTransform {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (hB : B.IsOrderGeMarkedTripleSeq s a E) :
    B.toBase ⁻¹' E.support ⊆ (B.orderedTotalTransform E).support := by
  induction B with
  | nil X =>
    intro x hx
    exact hx
  | cons Z B ih =>
    obtain ⟨hT, -, -, -, -, hB⟩ := hB
    intro x hx
    change blowUpToBase Z (B.toBase x) ∈ E.support at hx
    exact ih _ _ _ hB (preimage_union_subset_support_totalTransform E
      (fun i => (hT.2.2.2.2.2.2.2.1 i).2.1) Z (Or.inr hx))

/-- Along a smooth blow-up sequence of order `≥ m` starting with `(X, I, m, E)`, the support of
`𝒪(-∑_i Π_{r,i+1}^*F_{i+1})` lies in `Supp E_r`. -/
theorem support_exceptionalIdeal_subset {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (hB : B.IsOrderGeMarkedTripleSeq s a E) :
    (B.exceptionalIdeal.support : Set B.target) ⊆ (B.orderedTotalTransform E).support := by
  induction B with
  | nil X =>
    simp [exceptionalIdeal, Scheme.IdealSheafData.one_eq_top,
      Scheme.IdealSheafData.support_top]
  | cons Z B ih =>
    obtain ⟨hT, -, -, -, -, hB'⟩ := hB
    intro x hx
    change x ∈ (((Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal).support :
      Set B.target) at hx
    simp only [Scheme.IdealSheafData.support_mul, Closeds.coe_sup] at hx
    rcases hx with hx | hx
    · rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage,
        Scheme.IdealSheafData.support_comap, Closeds.coe_preimage] at hx
      exact preimage_support_subset_support_orderedTotalTransform B _ _ _ hB'
        (preimage_union_subset_support_totalTransform E
          (fun i => (hT.2.2.2.2.2.2.2.1 i).2.1) Z (Or.inl hx))
    · exact ih _ _ _ hB' hx

/-- The stalks of `𝒪(-∑_i Π_{r,i+1}^*F_{i+1})` are principal. -/
theorem exists_stalk_exceptionalIdeal_eq_span {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ x : B.target, ∃ f, IdealSheafData.stalk B.exceptionalIdeal x = Ideal.span {f} := by
  induction B with
  | nil X =>
    change ∀ x : X, ∃ f, IdealSheafData.stalk (1 : X.IdealSheafData) x = Ideal.span {f}
    exact fun x => ⟨1, by rw [stalk_one, Ideal.span_singleton_one]⟩
  | cons Z B ih =>
    change ∀ x : B.target, ∃ f, IdealSheafData.stalk
      ((Z.comap (blowUpToBase Z)).comap B.toBase * B.exceptionalIdeal) x = Ideal.span {f}
    intro x
    obtain ⟨g, hg⟩ := ih x
    obtain ⟨U, hU, hxU, f, -, hf⟩ :=
      Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _
        (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal Z) (B.toBase x)
    have h := IdealSheafData.stalk_eq_span_germ_of_ideal_eq_span (U := ⟨U, hU⟩) hxU hf
    refine ⟨(B.toBase.stalkMap x).hom (((blowUp Z).presheaf.germ U _ hxU).hom f) * g, ?_⟩
    rw [IdealSheafData.stalk_mul, IdealSheafData.stalk_comap, hg]
    erw [h]
    rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_mul_span_singleton]

/-- **Kollár 3.72, "therefore `Π^*I` is a monomial ideal".** Along a smooth blow-up sequence of
order `≥ m` starting with the marked triple `(X, I, m, E)` whose last ideal `I_r` has
`maxord I_r < 1`, the inverse image `Π^*I` of `I` in `X_r` is a monomial ideal. -/
@[mmp "lem_kr3c_pullback_monomial_after_order_reduction"]
theorem isMonomialIdeal_comap_toBase_of_maxOrder_lt_one {X : Scheme.{u}}
    (B : ClosedBlowupSequence X) (s : X ⟶ Spec (.of k)) (a : MarkedIdeal X)
    (E : OrderedDivisor X) (hB : B.IsOrderGeMarkedTripleSeq s a E)
    (hmax : maxOrder (B.markedTransform a).I < 1) :
    IsMonomialIdeal (a.I.comap B.toBase) := by
  classical
  rw [comap_toBase_eq_markedTransform_mul_exceptionalIdeal_pow B s a E hB,
    eq_top_of_maxOrder_lt_one hmax, ← Scheme.IdealSheafData.one_eq_top, one_mul]
  have hsupp := support_exceptionalIdeal_subset B s a E hB
  obtain ⟨-, hsm, hlft, -, -, -, -, hEr⟩ := isTriple_target_of_isOrderGeMarkedTripleSeq B s a E hB
  have : LocallyOfFiniteType (B.toBase ≫ s) := hlft
  have : LocallyOfFinitePresentation (B.toBase ≫ s) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := B.toBase ≫ s)).mpr hlft
  have : Smooth (B.toBase ≫ s) := (MMP.Mori.isSmoothScheme_iff _).1 hsm
  intro x
  have : IsRegularLocalRing (B.target.presheaf.stalk x) :=
    isRegularLocalRing_stalk_of_smooth_over_field (B.toBase ≫ s) x
  have := IsRegularLocalRing.isDomain (B.target.presheaf.stalk x)
  have := IsRegularLocalRing.uniqueFactorizationMonoid (B.target.presheaf.stalk x)
  obtain ⟨n, z, c, hz, hc, hinj⟩ := hEr.2 x
  obtain ⟨f, hf⟩ := exists_stalk_exceptionalIdeal_eq_span B x
  have hrad : ∏ j, z (c j) ∈ (IdealSheafData.stalk B.exceptionalIdeal x).radical := by
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro p ⟨hp, hpp⟩
    have hq : B.target.fromSpecStalk x ⟨p, hpp⟩ ∈ (B.exceptionalIdeal.support : Set _) :=
      (fromSpecStalk_mem_support_iff_stalk_le _ x ⟨p, hpp⟩).2 hp
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hsupp hq)
    have hxj : x ∈ ((B.orderedTotalTransform E).E j).support :=
      (fromSpecStalk_specializes_self x _).mem_closed (Closeds.isClosed _) hj
    have hjp := (fromSpecStalk_mem_support_iff_stalk_le _ x ⟨p, hpp⟩).1 hj
    rw [hc ⟨j, hxj⟩] at hjp
    exact Ideal.IsPrime.prod_mem_iff.2
      ⟨⟨j, hxj⟩, Finset.mem_univ _, hjp (Ideal.mem_span_singleton_self _)⟩
  obtain ⟨N, hN⟩ := hrad
  rw [hf, Ideal.mem_span_singleton] at hN
  have hprod : (∏ j, z (c j)) ^ N = ∏ m ∈ Finset.univ.image c, z m ^ N := by
    rw [Finset.prod_image (fun j _ k _ h => hinj h), Finset.prod_pow]
  rw [hprod] at hN
  obtain ⟨b, hb⟩ := exists_associated_prod_pow_univ_of_dvd_prod_pow z (fun _ => N)
    (Finset.univ.image c) (fun m _ => prime_of_isRegularSystemOfParameters hz m) hN
  refine ⟨n, z, fun m => b m * a.m, hz, ?_⟩
  rw [IdealSheafData.stalk_pow, hf, Ideal.span_singleton_pow,
    Ideal.span_singleton_eq_span_singleton]
  have hpow := hb.pow_pow (n := a.m)
  rwa [← Finset.prod_pow, Finset.prod_congr rfl fun m _ => (pow_mul (z m) (b m) a.m).symm]
    at hpow

/-! ### Deleting empty blow-ups and concatenating -/

/-- Deleting the empty blow-ups of the pull-back of a blow-up sequence along an isomorphism
`h : Y → X` changes its composite only by an isomorphism of the last schemes. -/
theorem exists_isIso_pullbackReduced_toBase {X : Scheme.{u}} (B : ClosedBlowupSequence X) :
    ∀ {Y : Scheme.{u}} (h : Y ⟶ X) [IsIso h], ∃ e : (B.pullbackReduced h).target ⟶ B.target,
      IsIso e ∧ (B.pullbackReduced h).toBase ≫ h = e ≫ B.toBase := by
  induction B with
  | nil X =>
    intro Y h hh
    exact ⟨h, hh, by
      change 𝟙 Y ≫ h = h ≫ 𝟙 X
      rw [Category.id_comp, Category.comp_id]⟩
  | cons Z B ih =>
    intro Y h hh
    by_cases hZ : Z.comap h = ⊤
    · have hc := isCartierOver_of_comap_eq_top h Z hZ
      have hZ' : Z = ⊤ := (Kollar.comap_eq_top_iff_of_isIso h Z).1 hZ
      have key : (cons Z B).pullbackReduced h = B.pullbackReduced (blowUpLift Z h hc) := by
        simp only [pullbackReduced, hZ, dite_true]
      rw [key]
      have := Kollar.isIso_blowUpLift_of_eq_top hZ' h hc
      obtain ⟨e, he, heq⟩ := ih (blowUpLift Z h hc)
      refine ⟨e, he, ?_⟩
      have h3 := congrArg (· ≫ blowUpToBase Z) heq
      simp only [Category.assoc, blowUpLift_comp] at h3
      exact h3
    · have key : (cons Z B).pullbackReduced h =
          cons (Z.comap h) (B.pullbackReduced (canonicalLift h Z)) := by
        simp only [pullbackReduced, hZ, dite_false]
      rw [key]
      have := Kollar.isIso_canonicalLift h Z
      obtain ⟨e, he, heq⟩ := ih (canonicalLift h Z)
      refine ⟨e, he, ?_⟩
      change ((B.pullbackReduced (canonicalLift h Z)).toBase ≫ blowUpToBase (Z.comap h)) ≫ h =
        e ≫ B.toBase ≫ blowUpToBase Z
      rw [Category.assoc, ← canonicalLift_comp_blowUpToBase, ← Category.assoc, heq,
        Category.assoc]

/-- The composite of a concatenation `D.append C` is the composite of `C` followed by that of
`D`, up to an isomorphism of the last schemes. -/
theorem exists_isIso_append_toBase {X : Scheme.{u}} (D : ClosedBlowupSequence X) :
    ∀ C : ClosedBlowupSequence D.target, ∃ e : (D.append C).target ⟶ C.target,
      IsIso e ∧ (D.append C).toBase = e ≫ C.toBase ≫ D.toBase := by
  induction D with
  | nil X =>
    intro C
    change ∃ e : C.target ⟶ C.target, IsIso e ∧ C.toBase = e ≫ C.toBase ≫ 𝟙 X
    exact ⟨𝟙 _, inferInstance, by rw [Category.id_comp]; exact (Category.comp_id C.toBase).symm⟩
  | cons Z D ih =>
    intro C
    obtain ⟨e, he, heq⟩ := ih C
    refine ⟨e, he, ?_⟩
    change (D.append C).toBase ≫ blowUpToBase Z = e ≫ C.toBase ≫ D.toBase ≫ blowUpToBase Z
    rw [heq]
    exact rfl

end ClosedBlowupSequence

/-- Monomial ideals pull back to monomial ideals along isomorphisms. -/
theorem IsMonomialIdeal.comap_of_isIso {X Y : Scheme.{u}} {I : X.IdealSheafData}
    (hI : IsMonomialIdeal I) (e : Y ⟶ X) [IsIso e] : IsMonomialIdeal (I.comap e) := by
  intro y
  obtain ⟨n, z, c, hz, hIz⟩ := hI (e y)
  have : IsIso (e.stalkMap y) := inferInstanceAs (IsIso (e.toLRSHom.stalkMap y))
  let φ := (asIso (e.stalkMap y)).commRingCatIsoToRingEquiv
  refine ⟨n, fun i => φ (z i), c, isRegularSystemOfParameters_map_ringEquiv φ hz, ?_⟩
  rw [IdealSheafData.stalk_comap, hIz, Ideal.map_span, Set.image_singleton, map_prod]
  simp only [map_pow]
  rfl

/-- **Kollár 3.72 ⇒ 3.35(2): `𝓑𝓟_𝓑` principalizes `I`.** Let `𝓑` be a smooth blow-up sequence
functor of order `≥ 1` on the marked triples of marking `1` such that the last ideal `I_r` of
every `𝓑(X, I, 1, E)` has `maxord I_r < 1`. Let `(X, I, E) ∈ 𝒯^snc` with `X` equidimensional and
`Π` the composite of `𝓑𝓟_𝓑(X, I, E)`. Then `Π^*I` is a monomial ideal. -/
@[mmp "lem_kr3c_bp_construction_principalizes"]
theorem isMonomialIdeal_comap_principalizationConstruction
    (B : OrderGeBlowupSequenceFunctor.{u} (markedTriplesOfMarking 1))
    (hB : ∀ t ht, maxOrder ((B.toFun t ht).markedTransform t.markedIdeal).I < 1)
    (t : FieldBlowupTriple.{u}) (ht : t ∈ sncTriples) (hX : Equidimensional t.X) :
    IsMonomialIdeal (t.I.comap (principalizationConstruction B.toFun t ht).toBase) := by
  obtain ⟨hchar, -, hlft, hqc, hI, -, hE⟩ := id ht
  have := hchar
  have := hlft
  have := hqc
  let D := disjoiningSequence t.X t.E
  let t' : MarkedTriple.{u} :=
    ⟨⟨⟨D.target, t.I.comap D.toBase, disjoiningDivisor t.X t.E⟩, t.k, D.toBase ≫ t.sX⟩, 1⟩
  have h' : t' ∈ markedTriplesOfMarking 1 :=
    ⟨isTriple_disjoiningSequence t.sX hX t.I hI t.E hE, rfl⟩
  have hBP : principalizationConstruction B.toFun t ht = (D.append (B.toFun t' h')).reduction :=
    dite_eq_left h'
  have hmono := (B.toFun t' h').isMonomialIdeal_comap_toBase_of_maxOrder_lt_one t'.sX
    t'.markedIdeal t'.E (B.isOrderGeMarkedTripleSeq t' h') (hB t' h')
  generalize B.toFun t' h' = C at hBP hmono
  change IsMonomialIdeal ((t.I.comap D.toBase).comap C.toBase) at hmono
  rw [hBP]
  obtain ⟨e₁, he₁, h₁⟩ := (D.append C).exists_isIso_pullbackReduced_toBase (𝟙 _)
  obtain ⟨e₂, he₂, h₂⟩ := D.exists_isIso_append_toBase C
  have hcomp : (D.append C).reduction.toBase = (e₁ ≫ e₂) ≫ C.toBase ≫ D.toBase := by
    rw [Category.comp_id] at h₁
    exact h₁.trans (by rw [h₂, Category.assoc])
  have key := hmono.comap_of_isIso (e₁ ≫ e₂)
  rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp] at key
  rw [hcomp]
  exact key

end MMP.Resolution

