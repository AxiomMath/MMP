module

public import MMP.AlgebraicGeometry.Resolution.Surface.PointBlowupEmbedded
public import MMP.RingTheory.DiscreteValuationRing.Integrality
public import StacksFrontier.AlgebraicGeometry.Lift.Generator
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.TestModuleStalk
public import StacksFrontier.AlgebraicGeometry.NormalizationQuotient.Defs

/-!
# Multiple points of a reduced curve on a regular surface (Kollár §1.8)

Let `S` be a regular Noetherian scheme of dimension at most `2`, `C ⊆ S` a reduced effective
Cartier divisor and `p ∈ C` a closed point at which `C` is singular or has multiplicity at least
`2`. Then `𝒪_{S,p}` has dimension `2`: on a regular scheme of dimension at most one, a reduced
effective Cartier divisor is regular of multiplicity one at each of its points.

## Main statements

* `MMP.Resolution.Kollar.ringKrullDim_stalk_eq_two_of_singular`: Kollár §1.8 (tacit).

## Implementation notes

The closed subscheme `C` is its ideal sheaf `C : S.IdealSheafData`; its local ring at `p` is
`𝒪_{S,p} / I_{C,p}` and its multiplicity `mult_p C` is `MMP.Resolution.multAt C p`, as in
`MMP.Foundations.Resolution.Surfaces.Resolution`. "Regular" is `IsRegularLocalRing` of every
local ring, and "Noetherian" is weakened to locally Noetherian.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry

universe u

namespace MMP.Resolution.Kollar

/-- The image of a nonzerodivisor in a localization is a nonzerodivisor. -/
private theorem algebraMap_mem_nonZeroDivisors_of_isLocalization {R S : Type*} [CommRing R]
    [CommRing S] [Algebra R S] (M : Submonoid R) [IsLocalization M S] (g : R)
    (hg : g ∈ nonZeroDivisors R) : algebraMap R S g ∈ nonZeroDivisors S := by
  rw [mem_nonZeroDivisors_iff]
  have key : ∀ x : S, x * algebraMap R S g = 0 → x = 0 := by
    intro x hx
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj M x
    simp only at hs
    have h1 : algebraMap R S (a * g) = 0 := by
      rw [map_mul, ← hs, mul_assoc, mul_comm (algebraMap R S s), ← mul_assoc, hx, zero_mul]
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M S _).mp h1
    have h2 : (m : R) * a = 0 :=
      (mem_nonZeroDivisors_iff.mp hg).2 _ ((mul_assoc _ _ _).trans hm)
    have h3 : algebraMap R S a = 0 := by
      have := congrArg (algebraMap R S) h2
      rw [map_mul, map_zero] at this
      exact (IsLocalization.map_units S m).mul_right_eq_zero.mp this
    rw [h3] at hs
    exact (IsLocalization.map_units S s).mul_left_eq_zero.mp hs
  exact ⟨fun x hx => key x (by rw [mul_comm]; exact hx), key⟩

/-- The stalk of an effective Cartier divisor at a point is generated by a nonzerodivisor. -/
private theorem exists_stalk_eq_span_nonZeroDivisor {S : Scheme.{u}} (C : S.IdealSheafData)
    (hC : Stacks.Divisors.IsEffectiveCartierDivisor C) (p : S) :
    ∃ f : S.presheaf.stalk p, IdealSheafData.stalk C p = Ideal.span {f} ∧
      f ∈ nonZeroDivisors (S.presheaf.stalk p) := by
  obtain ⟨V, hpV, -, g, hg, hgen⟩ :=
    Stacks.Tag0806Lift.exists_affineOpen_nonZeroDivisor_le C hC ⊤ (Set.mem_univ p)
  refine ⟨(S.presheaf.germ V.1 p hpV).hom g, ?_, ?_⟩
  · rw [IdealSheafData.stalk_eq_map_germ C p V hpV, hgen, Ideal.map_span]
    simp
  · let : Algebra Γ(S, V.1) (S.presheaf.stalk p) := (S.presheaf.germ V.1 p hpV).hom.toAlgebra
    have := V.2.isLocalization_stalk ⟨p, hpV⟩
    exact algebraMap_mem_nonZeroDivisors_of_isLocalization (S := S.presheaf.stalk p)
      (V.2.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl g hg

/-- For a reduced closed subscheme, the quotient of the local ring by the stalk of the ideal
sheaf at a point of the support is a nonzero reduced ring. -/
private theorem isReduced_and_ne_top_stalk {S : Scheme.{u}} (C : S.IdealSheafData)
    [IsReduced C.subscheme] {p : S} (hpC : p ∈ C.support) :
    IsReduced (S.presheaf.stalk p ⧸ IdealSheafData.stalk C p) ∧ IdealSheafData.stalk C p ≠ ⊤ := by
  let e : (S.presheaf.stalk p ⧸ IdealSheafData.stalk C p) ≃+*
      C.subscheme.presheaf.stalk (IdealSheafData.subschemePoint C p hpC) :=
    IdealSheafData.subschemeStalkQuotEquiv C (IdealSheafData.subschemePoint C p hpC)
  refine ⟨isReduced_of_injective e.toRingHom e.injective, ?_⟩
  have : Nontrivial (S.presheaf.stalk p ⧸ IdealSheafData.stalk C p) := e.toEquiv.nontrivial
  exact Ideal.Quotient.nontrivial_iff.mp this

private theorem dim_cases (d : WithBot ℕ∞) (h0 : 0 ≤ d) (h2 : d ≤ 2) (hne : ¬ d = 2) :
    d = 0 ∨ d = 1 := by
  induction d using WithBot.recBotCoe with
  | bot => simp at h0
  | coe n =>
    have h2' : n ≤ 2 := WithBot.coe_le_coe.mp h2
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = m :=
      ⟨n.toNat, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) h2')).symm⟩
    have : m ≤ 2 := by exact_mod_cast h2'
    have hm : m ≠ 2 := fun h => hne (by rw [h]; rfl)
    interval_cases m
    · left; rfl
    · right; rfl
    · exact absurd rfl hm

/-- A reduced principal ideal generated by a nonzerodivisor in the maximal ideal of a regular
local ring of dimension at most one forces `ord ≤ 1` and regular quotient: a contradiction. -/
private theorem false_of_dim_le_one {A : Type*} [CommRing A] [IsRegularLocalRing A] (f : A)
    (hf : f ∈ nonZeroDivisors A) (hfm : f ∈ IsLocalRing.maximalIdeal A)
    (hred : IsReduced (A ⧸ Ideal.span {f}))
    (hsing : 2 ≤ MMP.Resolution.idealOrder (Ideal.span {f}) ∨
      ¬ IsRegularLocalRing (A ⧸ Ideal.span {f}))
    (h0 : ringKrullDim A = 0 ∨ ringKrullDim A = 1) : False := by
  have hdom : IsDomain A := IsRegularLocalRing.isDomain A
  have hf0 : f ≠ 0 := nonZeroDivisors.ne_zero hf
  rcases h0 with h0 | h1
  · have : Ring.KrullDimLE 0 A := by rw [Ring.krullDimLE_iff]; exact h0.le
    have hfield : IsField A := Ring.KrullDimLE.isField_of_isDomain
    let := hfield.toField
    rw [IsLocalRing.maximalIdeal_eq_bot] at hfm
    exact hf0 (by simpa using hfm)
  · obtain ⟨hd', hdvr⟩ := isDiscreteValuationRing_of_ringKrullDim_eq_one (A := A) h1
    have := hdvr
    obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible A
    obtain ⟨n, u, hn⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hf0 ht
    have hun : IsLocalRing.maximalIdeal A = Ideal.span {t} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer t).mp ht
    have ht0 : t ≠ 0 := ht.ne_zero
    have hspan : Ideal.span {f} = Ideal.span {t ^ n} := by
      rw [hn]; exact Ideal.span_singleton_mul_left_unit u.isUnit _
    have hn0 : n ≠ 0 := by
      rintro rfl
      rw [pow_zero, mul_one] at hn
      exact (IsLocalRing.mem_maximalIdeal _).mp hfm (by rw [hn]; exact u.isUnit)
    have hn1 : n = 1 := by
      by_contra hn1
      have hn2 : 2 ≤ n := by omega
      have hz : Ideal.Quotient.mk (Ideal.span {f}) (t ^ (n - 1)) ^ 2 = 0 := by
        rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, hspan, Ideal.mem_span_singleton,
          ← pow_mul]
        exact pow_dvd_pow t (by omega)
      have hz' := hred.1 _ ⟨2, hz⟩
      rw [Ideal.Quotient.eq_zero_iff_mem, hspan, Ideal.mem_span_singleton] at hz'
      obtain ⟨c, hc⟩ := hz'
      have : t ^ (n - 1) * (1 - t * c) = 0 := by
        have e : t ^ n = t ^ (n - 1) * t := by rw [← pow_succ]; congr 1; omega
        rw [e] at hc
        linear_combination hc
      rcases mul_eq_zero.mp this with h | h
      · exact pow_ne_zero _ ht0 h
      · have : t * c = 1 := by linear_combination -h
        exact ht.not_isUnit (IsUnit.of_mul_eq_one c this)
    subst hn1
    rw [pow_one, ← hun] at hspan
    rw [hspan] at hsing
    rcases hsing with h | h
    · have hle : MMP.Resolution.idealOrder (IsLocalRing.maximalIdeal A) ≤ 1 := by
        refine iSup₂_le fun j hj => ?_
        by_contra hj1
        have hj2 : 2 ≤ j := by
          have : 1 < (j : ℕ∞) := not_le.mp hj1
          exact_mod_cast this
        have h2 : IsLocalRing.maximalIdeal A ≤
            IsLocalRing.maximalIdeal A * IsLocalRing.maximalIdeal A := by
          refine hj.trans ?_
          rw [← pow_two]
          exact Ideal.pow_le_pow_right hj2
        have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal A)
          (IsLocalRing.maximalIdeal A) (IsNoetherian.noetherian _) h2
          (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
        have ht : t ∈ IsLocalRing.maximalIdeal A := by
          rw [hun]; exact Ideal.mem_span_singleton_self t
        rw [hbot] at ht
        exact ht0 (by simpa using ht)
      have := h.trans hle
      norm_num at this
    · apply h
      let := Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
      infer_instance

/-- **Kollár §1.8** (tacit): multiple points of a reduced curve on a regular surface. Let `S` be
a regular Noetherian scheme of dimension at most `2`, `C ⊆ S` a reduced effective Cartier divisor
and `p ∈ C` a closed point such that `mult_p C ≥ 2` or `𝒪_{p,C}` is not a regular local ring.
Then `dim 𝒪_{S,p} = 2`. (Closedness of `p` is not needed and is dropped.) -/
@[mmp "lem_kr1c_multiple_point_two_dimensional"]
theorem ringKrullDim_stalk_eq_two_of_singular {S : Scheme.{u}} [IsLocallyNoetherian S]
    (hreg : ∀ x : S, IsRegularLocalRing (S.presheaf.stalk x)) (hdim : topologicalKrullDim S ≤ 2)
    (C : S.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C)
    [IsReduced C.subscheme] {p : S} (hpC : p ∈ C.support)
    (hsing : 2 ≤ MMP.Resolution.multAt C p ∨
      ¬ IsRegularLocalRing (S.presheaf.stalk p ⧸ IdealSheafData.stalk C p)) :
    ringKrullDim (S.presheaf.stalk p) = 2 := by
  have := hreg p
  obtain ⟨f, hfI, hfnzd⟩ := exists_stalk_eq_span_nonZeroDivisor C hC p
  obtain ⟨hred, hne⟩ := isReduced_and_ne_top_stalk C hpC
  unfold MMP.Resolution.multAt at hsing
  rw [hfI] at hred hne hsing
  have hd2 : ringKrullDim (S.presheaf.stalk p) ≤ 2 :=
    (Stacks.AlgebraicGeometry.NormalizationQuotient.ringKrullDim_stalk_le_topologicalKrullDim
      S p).trans hdim
  by_contra hne2
  have hfm : f ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p) := by
    by_contra h
    exact hne (Ideal.span_singleton_eq_top.mpr (by simpa using h))
  exact false_of_dim_le_one f hfnzd hfm hred hsing
    (dim_cases _ ringKrullDim_nonneg_of_nontrivial hd2 hne2)

end MMP.Resolution.Kollar
