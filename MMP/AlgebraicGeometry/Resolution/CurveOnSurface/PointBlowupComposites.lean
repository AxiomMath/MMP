/-!
# Point blow-ups of regular surfaces

Let `S` be a regular surface (a Noetherian scheme whose local rings are regular, of dimension two
at closed points) and `σ : B_pS → S` the blow-up of a closed point `p`, with exceptional curve
`E = σ⁻¹(p) ≅ ℙ¹_{κ(p)}`. This file collects the local and global facts about such blow-ups and
their composites that drive Kollár's strong embedded resolution of curves on surfaces.

Locally, every local ring of `B_pS` along `E` is regular, of dimension two at closed points and
one at the generic point of `E`; hence `B_pS` is again a regular surface. Over a field `k`, if
`S` is smooth of relative dimension two and `κ(p)/k` is separable, then `B_pS` is smooth over `k`.
If the reduced structure on a closed set `Z ⊆ S` is a simple normal crossing (snc) divisor, so is
the reduced structure on `σ⁻¹(Z) ∪ E`.

Globally, for a composite `g : S' → S` of `m` point blow-ups, the points of `S'` with
one-dimensional local ring over a closed point of `S` (the generic points of the exceptional
prime divisors) number exactly `m`, and the reduced exceptional set `Ex(g)` is snc. Consequently
a composite of point blow-ups dominated by another has at most as many blow-ups, and every strong
embedded resolution sequence for `(S, C)` is dominated by any composite of point blow-ups on
which the reduced preimage of `C` is snc.

## Main results

* `MMP.Resolution.isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal`: regularity
  and dimension of the local rings of `B_pS` along `E`.
* `MMP.Resolution.Kollar.smooth_blowUpToBase_comp_of_isSeparable`: `B_pS` is smooth over `k`.
* `MMP.Resolution.isSNCSubscheme_vanishingIdeal_preimage_union_exceptional`: `B_pS` is a regular
  surface and `σ⁻¹(Z) ∪ E` is snc.
* `MMP.Resolution.encard_exceptionalPrimes_eq`: a composite of `m` point blow-ups has exactly `m`
  exceptional primes.
* `MMP.Resolution.IsCompositeOfPointBlowupsOfLength.le_of_comp`: domination bounds the number of
  point blow-ups.
* `MMP.Resolution.isSNCSubscheme_vanishingIdeal_exceptionalSet`: `Ex(g)` is snc.
* `MMP.Resolution.PointBlowupSequence.exists_isCompositeOfPointBlowups_comp_π_eq`: strong
  embedded resolution sequences are dominated by snc models.
* `MMP.Resolution.exists_isFinite_finrank_birationalTransform_sup_exceptionalIdeal`: the
  intersection `C₁ ∩ E` of the birational transform of an effective Cartier divisor `C` with `E`
  is finite over `κ(p)`, of degree `mult_p C`.
* `MMP.Resolution.sum_residueDegree_mul_multAt_birationalTransform_le_multAt`:
  `∑_{q ∈ C₁ ∩ E} [κ(q) : κ(p)] · mult_q C₁ ≤ mult_p C`.

## Implementation notes

The blow-up of a closed point `p` is `AlgebraicGeometry.blowUp` of the reduced ideal sheaf
`Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩`, and `E` is the support of
`AlgebraicGeometry.exceptionalIdeal`. A reduced closed subscheme is the reduced structure
`Scheme.IdealSheafData.vanishingIdeal Z` on its closed support. Dimensions of local rings are
`ringKrullDim`. Regularity along `E` is proved by flat base change to the blow-up of
`Spec 𝒪_{S,p}` in its closed point rather than in the affine charts. Smoothness over `k` is the
smoothness of a blow-up along a centre smooth over `k` [Stacks, Tag 0FUT], the centre `Spec κ(p)`
being étale over `k` exactly because `κ(p)/k` is finite and separable; without separability the
statement fails (Kollár 1.49). The number of exceptional primes is a cardinal `Set.encard`, so
that an infinite set is not counted as `0`.

The intersection `C₁ ∩ E` is the closed subscheme of the ideal sheaf
`birationalTransform p hp C ⊔ exceptionalIdeal (vanishingIdeal ⟨{p}, hp⟩)`. Its `κ(p)`-structure
is a morphism `g : C₁ ∩ E ⟶ Spec κ(p)` over `S`, unique because `Spec κ(p) → S` is a closed
immersion. Its degree is computed on the two charts `D₊(xt)`, `D₊(yt)` of a coordinate
neighbourhood `(x, y)` of `p`, where `C₁ ∩ E` is `Spec κ[Y]/(F(1, Y))`, resp.
`Spec κ[X]/(F(X, 1))`, `F` the leading form of a local equation of `C`; residue degrees are
ranks in `ℕ∞` (`Cardinal.toENat`).

## References

* [J. Kollár, *Lectures on resolution of singularities*, 1.36, 1.40, 1.48][kollar2007]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry TopologicalSpace

universe u

namespace MMP.Resolution

/-- A point of the blow-up along an ideal sheaf supported at `p` lies on the exceptional curve
iff it maps to `p`. -/
private theorem mem_support_exceptionalIdeal_iff {S : Scheme.{u}} {p : S} {I : S.IdealSheafData}
    (hsupp : (I.support : Set S) = {p}) (q : blowUp I) :
    q ∈ (exceptionalIdeal I).support ↔ blowUpToBase I q = p := by
  show q ∈ ((I.comap (blowUpToBase I)).support : Set _) ↔ _
  rw [Scheme.IdealSheafData.support_comap]
  show blowUpToBase I q ∈ (I.support : Set S) ↔ _
  rw [hsupp]
  rfl

/-- The reduced ideal of a closed point `p` is supported at `p`. -/
private theorem coe_support_vanishingIdeal_singleton {S : Scheme.{u}} (p : S)
    (hp : IsClosed ({p} : Set S)) :
    ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).support : Set S) = {p} := by
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
  rfl

/-! ### Regularity along the exceptional curve -/

section RegularAlongExceptional

open IsLocalRing

/-- A strict specialization is a strict inequality in the specialization order of a scheme. -/
private lemma lt_of_specializes_of_ne {X : Scheme} {x y : X} (h : x ⤳ y) (hne : x ≠ y) : y < x :=
  lt_of_le_not_ge (Scheme.le_iff_specializes.mpr h)
    fun h' ↦ hne (h.antisymm (Scheme.le_iff_specializes.mp h')).eq

/-- On the blowup of a two-dimensional regular local ring at its closed point, a point over the
closed point is not the generic point, so its local ring has dimension at least one. -/
private lemma one_le_ringKrullDim_stalk_blowUp_maximalIdealSheaf (A : Type*) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) (z : blowUp (maximalIdealSheaf A))
    (hz : blowUpToBase (maximalIdealSheaf A) z = closedPoint A) :
    1 ≤ ringKrullDim ((blowUp (maximalIdealSheaf A)).presheaf.stalk z) := by
  have : IsDomain A := IsRegularLocalRing.isDomain A
  haveI := irreducibleSpace_blowUp_maximalIdeal A hdim
  set π := blowUpToBase (maximalIdealSheaf A)
  -- A point over the generic point of `Spec A`, where `π` is an isomorphism.
  have hgen : genericPoint (Spec (.of A)) ∈ (maximalIdealSheaf A).support.compl := by
    have hcl : IsClosed ({closedPoint A} : Set (Spec (.of A))) := isClosed_singleton_closedPoint A
    show genericPoint (Spec (.of A)) ∉ ((maximalIdealSheaf A).support : Set (Spec (.of A)))
    rw [← vanishingIdeal_closedPoint_eq_maximalIdealSheaf A hcl,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    exact genericPoint_ne_closedPoint_of_ringKrullDim_eq_two A hdim
  haveI := isIso_blowUp_restrict_compl_support (maximalIdealSheaf A)
  obtain ⟨w, hw⟩ := (π ∣_ (maximalIdealSheaf A).support.compl).homeomorph.surjective
    ⟨_, hgen⟩
  have hw' : π w.1 = genericPoint (Spec (.of A)) := by
    rw [← morphismRestrict_base_coe]
    exact congrArg Subtype.val hw
  have hne : genericPoint (blowUp (maximalIdealSheaf A)) ≠ z := by
    intro heq
    have hsp : π (genericPoint (blowUp (maximalIdealSheaf A))) ⤳ π w.1 :=
      ((genericPoint_spec (blowUp (maximalIdealSheaf A))).specializes trivial).map
        π.continuous
    rw [heq, hz, hw'] at hsp
    exact genericPoint_ne_closedPoint_of_ringKrullDim_eq_two A hdim
      (hsp.mem_closed (isClosed_singleton_closedPoint A) rfl)
  rw [ringKrullDim_stalk_eq_coheight]
  exact_mod_cast le_add_self.trans (Order.coheight_add_one_le
    (lt_of_specializes_of_ne ((genericPoint_spec _).specializes trivial) hne))

/-- Transport of a point of the exceptional curve to the blowup of `Spec 𝒪_{S,p}`. -/
private lemma exists_point_blowUp_maximalIdealSheaf {S : Scheme} (p : S)
    (hp : IsClosed ({p} : Set S))
    (q : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hq : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) q = p) :
    ∃ z : blowUp (maximalIdealSheaf (S.presheaf.stalk p)),
      blowUpToBase (maximalIdealSheaf (S.presheaf.stalk p)) z = closedPoint _ ∧
      ringKrullDim ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q)
        = ringKrullDim ((blowUp (maximalIdealSheaf (S.presheaf.stalk p))).presheaf.stalk z) ∧
      (IsClosed ({q} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) →
        IsClosed ({z} : Set (blowUp (maximalIdealSheaf (S.presheaf.stalk p))))) := by
  obtain ⟨h, hpb, _, _⟩ :=
    exists_isPullback_blowUp_maximalIdealSheaf (S.presheaf.stalk p) p hp (RingEquiv.refl _)
  obtain ⟨z, hz1, hz2⟩ := Scheme.exists_preimage_of_isPullback hpb (closedPoint _) q
    (by rw [hq]; exact specToOfRingEquivStalk_closedPoint _ p _)
  subst hz2
  haveI : IsIso (h.stalkMap z) := isIso_stalkMap_of_flat_isPreimmersion h z
  refine ⟨z, hz1, ringKrullDim_eq_of_ringEquiv
    (asIso (h.stalkMap z)).commRingCatIsoToRingEquiv, fun hcl ↦ ?_⟩
  rw [← h.isEmbedding.injective.preimage_image {z}, Set.image_singleton]
  exact hcl.preimage h.continuous

/-- A point of the exceptional curve that is closed has a two-dimensional local ring. -/
private lemma ringKrullDim_stalk_eq_two_of_isClosed {S : Scheme} [IsNoetherian S] (p : S)
    (hp : IsClosed ({p} : Set S)) [IsRegularLocalRing (S.presheaf.stalk p)]
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (w : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hw : w ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support)
    (hcl : IsClosed ({w} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)))) :
    ringKrullDim
      ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk w) = 2 := by
  haveI : IsDomain (S.presheaf.stalk p) := IsRegularLocalRing.isDomain _
  haveI : IsNormalDomain (S.presheaf.stalk p) :=
    ⟨inferInstance, isIntegrallyClosed_of_isRegularLocalRing _⟩
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  obtain ⟨z, -, hdz, hcz⟩ := exists_point_blowUp_maximalIdealSheaf p hp w
    ((mem_support_exceptionalIdeal_iff (coe_support_vanishingIdeal_singleton p hp) w).mp hw)
  rw [hdz]
  exact ringKrullDim_stalk_blowUp_maximalIdeal_eq_two_of_isClosed _ hdim z (hcz hcl)

/-- A point specializing strictly to a point with a two-dimensional local ring has a local ring of
dimension at most one. -/
private lemma ringKrullDim_stalk_le_one_of_specializes {X : Scheme} {x y : X} (h : x ⤳ y)
    (hne : x ≠ y) (hy : ringKrullDim (X.presheaf.stalk y) = 2) :
    ringKrullDim (X.presheaf.stalk x) ≤ 1 := by
  rw [ringKrullDim_stalk_eq_coheight] at hy ⊢
  have hle := Order.coheight_add_one_le (lt_of_specializes_of_ne h hne)
  rw [WithBot.coe_inj.mp (hy.trans (WithBot.coe_ofNat 2).symm)] at hle
  exact_mod_cast Order.le_of_lt_succ
    ((ENat.add_one_le_iff (by rintro h; simp [h] at hle)).mp hle)

/-- Let `S` be a Noetherian scheme and `p ∈ S` a closed point with `𝒪_{S,p}` regular of
dimension `2`. Then at every point `q` of the exceptional curve of the blow-up `B_pS` of `p`,
the local ring `𝒪_{B_pS,q}` is regular, of dimension `2` if `q` is closed and `1` otherwise. -/
@[mmp "lem_kr1b_blowup_regular_along_exceptional"]
public theorem isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal
    {S : Scheme} [IsNoetherian S] (p : S) (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (q : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hq : q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    IsRegularLocalRing
        ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q) ∧
      (IsClosed ({q} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) →
        ringKrullDim
          ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q) = 2) ∧
      (¬ IsClosed ({q} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) →
        ringKrullDim
          ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q) = 1) := by
  haveI : IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :=
    Stacks.ResolutionOfSurfaces.isNoetherian_blowUp _
  have hqp := (mem_support_exceptionalIdeal_iff (coe_support_vanishingIdeal_singleton p hp) q).mp hq
  refine ⟨isRegularLocalRing_stalk_blowUp_of_blowUpToBase_eq p hp hdim q hqp,
    ringKrullDim_stalk_eq_two_of_isClosed p hp hdim q hq, fun hncl ↦ le_antisymm ?_ ?_⟩
  · -- A non-closed point specializes strictly to a closed point of the exceptional curve.
    obtain ⟨q', hq'q, hq'cl⟩ := (isClosed_closure (s := {q})).exists_closed_singleton
      ⟨q, subset_closure rfl⟩
    have hsp : q ⤳ q' := specializes_iff_mem_closure.mpr hq'q
    exact ringKrullDim_stalk_le_one_of_specializes hsp (by rintro rfl; exact hncl hq'cl)
      (ringKrullDim_stalk_eq_two_of_isClosed p hp hdim q'
        (hsp.mem_closed (exceptionalIdeal _).support.isClosed hq) hq'cl)
  · obtain ⟨z, hz, hdz, -⟩ := exists_point_blowUp_maximalIdealSheaf p hp q hqp
    haveI : IsDomain (S.presheaf.stalk p) := IsRegularLocalRing.isDomain _
    exact hdz ▸ one_le_ringKrullDim_stalk_blowUp_maximalIdealSheaf _ hdim z hz

end RegularAlongExceptional

/-! ### Smoothness of the blow-up of a separable point -/

namespace Kollar

/-- A morphism between affine schemes is `Spec` of its action on global sections. -/
private theorem eq_SpecMap_appTop {R T : CommRingCat} (h : Spec T ⟶ Spec R) :
    h = Spec.map ((Scheme.ΓSpecIso R).inv ≫ h.appTop ≫ (Scheme.ΓSpecIso T).hom) := by
  have := Scheme.toSpecΓ_naturality h
  rw [← SpecMap_ΓSpecIso_hom, ← SpecMap_ΓSpecIso_hom] at this
  rw [Spec.map_comp, Spec.map_comp, ← this, Category.assoc, ← Spec.map_comp]
  simp

/-- For `f : S ⟶ Spec R`, the composite `Spec κ(o) ⟶ S ⟶ Spec R` is `Spec` of the map
`R → κ(o)` induced by `f`. -/
private theorem fromSpecResidueField_comp_eq_SpecMap {R : CommRingCat} {S : Scheme.{u}}
    (f : S ⟶ Spec R) (o : S) :
    S.fromSpecResidueField o ≫ f =
      Spec.map ((Scheme.ΓSpecIso R).inv ≫ f.appTop ≫ S.Γevaluation o) := by
  rw [eq_SpecMap_appTop (S.fromSpecResidueField o ≫ f), Scheme.Hom.comp_appTop, Category.assoc]
  congr 3
  simp only [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Category.assoc,
    Scheme.ΓSpecIso_naturality, Scheme.fromSpecStalk_appTop]
  simp
  rfl

/-- A point of a `k`-scheme locally of finite type whose residue field is separable over `k`
is smooth over `k`: `Spec κ(o) ⟶ Spec k` is étale. -/
private theorem smooth_fromSpecResidueField_comp {k : Type u} [Field k] {S : Scheme.{u}}
    (f : S ⟶ Spec (.of k)) [LocallyOfFiniteType f] {o : S} (ho : IsClosed ({o} : Set S))
    (hsep : letI : Algebra k (S.residueField o) :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ S.Γevaluation o).hom.toAlgebra
      Algebra.IsSeparable k (S.residueField o)) :
    Smooth (S.fromSpecResidueField o ≫ f) := by
  have := isClosed_singleton_iff_isClosedImmersion.1 ho
  have hft : RingHom.FiniteType
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ S.Γevaluation o).hom := by
    rw [← HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType),
      ← fromSpecResidueField_comp_eq_SpecMap]
    infer_instance
  rw [fromSpecResidueField_comp_eq_SpecMap, HasRingHomProperty.Spec_iff (P := @Smooth)]
  letI := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ S.Γevaluation o).hom.toAlgebra
  have : Algebra.FiniteType k (S.residueField o) := hft
  have := Algebra.FormallyEtale.of_isSeparable k (S.residueField o)
  exact ⟨inferInstance, Algebra.FinitePresentation.of_finiteType.1 ‹_›⟩

/-- If a closed immersion `i` followed by `f` is smooth, so is the closed subscheme cut out by
the kernel of `i`, followed by `f`. -/
private theorem smooth_ker_subschemeι_comp {X Y Z : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]
    (f : Y ⟶ Z) (h : Smooth (i ≫ f)) : Smooth (i.ker.subschemeι ≫ f) := by
  rw [← i.toImage_imageι, Category.assoc] at h
  have : Smooth (inv i.toImage ≫ i.toImage ≫ i.imageι ≫ f) := inferInstance
  rwa [IsIso.inv_hom_id_assoc] at this

/-- **Kollár 1.36** (at a point with separable residue field). Let `f : S ⟶ Spec k` be of finite
type and smooth of relative dimension `2`, and let `o ∈ S` be a closed point whose residue field
is separable over `k`. Then the blow-up `B_oS` is smooth over `k`. -/
@[mmp "lem_kr1b_blowup_smooth"]
public theorem smooth_blowUpToBase_comp_of_isSeparable {k : Type u} [Field k] {S : Scheme.{u}}
    (f : S ⟶ Spec (.of k)) [SmoothOfRelativeDimension 2 f] [QuasiCompact f]
    {o : S} (ho : IsClosed ({o} : Set S))
    (hsep : letI : Algebra k (S.residueField o) :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ S.Γevaluation o).hom.toAlgebra
      Algebra.IsSeparable k (S.residueField o)) :
    Smooth (blowUpToBase (pointIdeal ho) ≫ f) := by
  have : Smooth f := SmoothOfRelativeDimension.smooth 2 f
  have := isClosed_singleton_iff_isClosedImmersion.1 ho
  have : Smooth ((MMP.Resolution.Kollar.pointIdeal ho).subschemeι ≫ f) := by
    rw [MMP.Resolution.Kollar.pointIdeal, vanishingIdeal_singleton_eq_ker o ho]
    exact smooth_ker_subschemeι_comp _ f (smooth_fromSpecResidueField_comp f ho hsep)
  exact Stacks.AlgebraicGeometry.smooth_blowUpToBase_comp_of_idealSheafData f _

end Kollar

/-! ### Blowing up a point preserves simple normal crossings -/

/-- Simple normal crossings at `f x` restrict along an open immersion `f`. -/
private theorem hasSNCAt_comap {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (I : Y.IdealSheafData) (x : X) (h : HasSNCAt I (f x)) : HasSNCAt (I.comap f) x := by
  obtain ⟨d, U, hU, s, m, hreg, hst⟩ := h
  have _ : ∀ q, IsIso (f.stalkMap q) := IsOpenImmersion.instIsIsoCommRingCatStalkMap f
  have hgerm : ∀ (q : X) (hq : q ∈ f ⁻¹ᵁ U) (t : Γ(Y, U)),
      (X.presheaf.germ (f ⁻¹ᵁ U) q hq).hom ((f.app U).hom t) =
        (f.stalkMap q).hom ((Y.presheaf.germ U (f q) hq).hom t) := by
    intro q hq t
    have := congrArg (fun φ => φ.hom t) (Scheme.Hom.germ_stalkMap f U q hq)
    exact this.symm
  refine ⟨d, f ⁻¹ᵁ U, hU, fun i => (f.app U).hom (s i), m, ?_, ?_⟩
  · have hfun : (fun i => (X.presheaf.germ (f ⁻¹ᵁ U) x hU).hom ((f.app U).hom (s i))) =
        fun i => (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv
          ((Y.presheaf.germ U (f x) hU).hom (s i)) :=
      funext fun i => hgerm x hU (s i)
    rw [hfun]
    exact hreg.map_ringEquiv _
  · intro q hq
    rw [IdealSheafData.stalk_comap, hst (f q) hq, Ideal.map_span, Set.image_singleton,
      ← hgerm]
    simp [map_prod, map_pow]

/-- Simple normal crossings at `x` extend along an open immersion `f` to `f x`. -/
private theorem hasSNCAt_of_comap {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (I : Y.IdealSheafData) (x : X) (h : HasSNCAt (I.comap f) x) : HasSNCAt I (f x) := by
  obtain ⟨d, U, hU, s, m, hreg, hst⟩ := h
  have _ : ∀ q, IsIso (f.stalkMap q) := IsOpenImmersion.instIsIsoCommRingCatStalkMap f
  have hmem : ∀ q ∈ U, f q ∈ f ''ᵁ U := fun q hq => Set.mem_image_of_mem _ hq
  have hgerm : ∀ (q : X) (hq : q ∈ U) (t : Γ(X, U)),
      (f.stalkMap q).hom ((Y.presheaf.germ (f ''ᵁ U) (f q) (hmem q hq)).hom
        ((f.appIso U).inv.hom t)) = (X.presheaf.germ U q hq).hom t := by
    intro q hq t
    have h2 : Y.presheaf.germ (f ''ᵁ U) (f q) (hmem q hq) ≫ f.stalkMap q =
        (f.appIso U).hom ≫ X.presheaf.germ U q hq := by
      rw [Scheme.Hom.germ_stalkMap f (f ''ᵁ U) q (hmem q hq), Scheme.Hom.appIso_hom,
        Category.assoc, X.presheaf.germ_res]
    simpa using congrArg (fun φ => φ.hom ((f.appIso U).inv.hom t)) h2
  let e : ∀ q : X, Y.presheaf.stalk (f q) ≃+* X.presheaf.stalk q := fun q =>
    (asIso (f.stalkMap q)).commRingCatIsoToRingEquiv
  have he : ∀ (q : X) (hq : q ∈ U) (t : Γ(X, U)),
      (Y.presheaf.germ (f ''ᵁ U) (f q) (hmem q hq)).hom ((f.appIso U).inv.hom t) =
        (e q).symm ((X.presheaf.germ U q hq).hom t) := by
    intro q hq t
    rw [RingEquiv.eq_symm_apply]
    exact hgerm q hq t
  refine ⟨d, f ''ᵁ U, hmem x hU, fun i => (f.appIso U).inv.hom (s i), m, ?_, ?_⟩
  · have hfun : (fun i => (Y.presheaf.germ (f ''ᵁ U) (f x) (hmem x hU)).hom
        ((f.appIso U).inv.hom (s i))) = fun i => (e x).symm ((X.presheaf.germ U x hU).hom (s i)) :=
      funext fun i => he x hU (s i)
    rw [hfun]
    exact hreg.map_ringEquiv _
  · intro y hy
    obtain ⟨q, hq, rfl⟩ := hy
    show IdealSheafData.stalk I (f q) = Ideal.span {((Y.presheaf.germ (f ''ᵁ U) (f q)
      (hmem q hq)).hom (∏ i, ((f.appIso U).inv.hom (s i)) ^ m i))}
    have h1 := hst q hq
    rw [IdealSheafData.stalk_comap] at h1
    have h2 : Ideal.map ((e q) : _ →+* _) (IdealSheafData.stalk I (f q)) =
        Ideal.span {(X.presheaf.germ U q hq).hom (∏ i, s i ^ m i)} := h1
    rw [← Ideal.map_of_equiv (I := IdealSheafData.stalk I (f q)) (e q), h2, Ideal.map_span,
      Set.image_singleton]
    congr 2
    simp only [map_prod, map_pow, he q hq]
    rfl

/-- Along an open immersion, the inverse image of the reduced structure on a closed set is the
reduced structure on its preimage. -/
private theorem comap_vanishingIdeal {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (C : Closeds Y) :
    (Scheme.IdealSheafData.vanishingIdeal C).comap f =
      Scheme.IdealSheafData.vanishingIdeal ⟨f ⁻¹' C, C.isClosed.preimage f.continuous⟩ := by
  set J := Scheme.IdealSheafData.vanishingIdeal C
  have : IsReduced (J.comap f).subscheme :=
    isReduced_of_isOpenImmersion ((J.comapIso f).hom ≫ Limits.pullback.snd f J.subschemeι)
  refine Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ ?_
  rw [Scheme.IdealSheafData.support_comap]
  ext1
  simp [J, Scheme.IdealSheafData.coe_support_vanishingIdeal]

/-- The blow-up morphism sends closed points to closed points. -/
private theorem isClosed_singleton_blowUpToBase {S : Scheme.{u}} [IsLocallyNoetherian S]
    {I : S.IdealSheafData} {q : blowUp I} (hq : IsClosed ({q} : Set (blowUp I))) :
    IsClosed ({blowUpToBase I q} : Set S) := by
  have := (blowUpToBase I).isClosedMap _ hq
  rwa [Set.image_singleton] at this

/-- The blow-up of a closed point of a regular surface is a regular surface. -/
private theorem isRegularSurface_blowUp {S : Scheme.{u}} (hS : IsRegularSurface S)
    (p : S) (hp : IsClosed ({p} : Set S)) :
    IsRegularSurface (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) := by
  obtain ⟨hN, hreg, hdim⟩ := hS
  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{p}, hp⟩ : Closeds S)
  have hsupp : (I.support : Set S) = {p} := coe_support_vanishingIdeal_singleton p hp
  have hE := mem_support_exceptionalIdeal_iff hsupp
  have hoff : ∀ q : blowUp I, q ∉ (exceptionalIdeal I).support →
      IsIso ((blowUpToBase I).stalkMap q) := by
    intro q hq
    refine isIso_stalkMap_of_isIso_morphismRestrict (blowUpToBase I)
      (isIso_blowUp_restrict_compl_support I) (x := q) ?_
    show blowUpToBase I q ∉ (I.support : Set S)
    rw [hsupp]
    exact fun h => hq ((hE q).2 h)
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  have hNB : IsNoetherian (blowUp I) := by
    have : IsLocallyNoetherian (blowUp I) :=
      LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase I)
    have : CompactSpace (blowUp I) := QuasiCompact.compactSpace_of_compactSpace (blowUpToBase I)
    constructor
  refine ⟨hNB, fun q => ?_, fun q hq => ?_⟩
  · by_cases hq : q ∈ (exceptionalIdeal I).support
    · exact (isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal p hp (hreg p)
        (hdim p hp) q hq).1
    · haveI := hoff q hq
      exact IsRegularLocalRing.of_ringEquiv
        (asIso ((blowUpToBase I).stalkMap q)).commRingCatIsoToRingEquiv
  · by_cases hqE : q ∈ (exceptionalIdeal I).support
    · exact (isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal p hp (hreg p)
        (hdim p hp) q hqE).2.1 hq
    · haveI := hoff q hqE
      rw [← ringKrullDim_eq_of_ringEquiv
        (asIso ((blowUpToBase I).stalkMap q)).commRingCatIsoToRingEquiv]
      exact hdim _ (isClosed_singleton_blowUpToBase hq)

/-- Off the exceptional curve, `σ⁻¹(Z) ∪ E` has simple normal crossings at every closed point. -/
private theorem hasSNCAt_of_notMem_exceptional {S : Scheme.{u}} [IsNoetherian S] (Z : Closeds S)
    (hZ : IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z))
    {p : S} {I : S.IdealSheafData} (hsupp : (I.support : Set S) = {p})
    (Z' : Closeds (blowUp I))
    (hZ' : (Z' : Set (blowUp I)) =
      (blowUpToBase I).base ⁻¹' (Z : Set S) ∪ (exceptionalIdeal I).support)
    (q : blowUp I) (hq : IsClosed ({q} : Set (blowUp I)))
    (hE : q ∉ (exceptionalIdeal I).support) :
    HasSNCAt (Scheme.IdealSheafData.vanishingIdeal Z') q := by
  let W : S.Opens := (I.support.compl : S.Opens)
  haveI : IsIso (blowUpToBase I ∣_ W) := isIso_blowUp_restrict_compl_support I
  let g : (W : Scheme) ⟶ blowUp I := inv (blowUpToBase I ∣_ W) ≫ (blowUpToBase I ⁻¹ᵁ W).ι
  have hg : g ≫ blowUpToBase I = W.ι := by
    rw [Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
  have hqW : q ∈ blowUpToBase I ⁻¹ᵁ W := by
    show blowUpToBase I q ∉ (I.support : Set S)
    rw [hsupp]
    exact fun h => hE ((mem_support_exceptionalIdeal_iff hsupp q).2 h)
  set w := (blowUpToBase I ∣_ W) ⟨q, hqW⟩
  have hqw : g w = q := by
    show (blowUpToBase I ⁻¹ᵁ W).ι ((blowUpToBase I ∣_ W ≫ inv (blowUpToBase I ∣_ W)) ⟨q, hqW⟩) = q
    rw [IsIso.hom_inv_id]
    rfl
  have hwq : W.ι w = blowUpToBase I q := by
    rw [← hqw, ← Scheme.Hom.comp_apply, hg]
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  have h1 : HasSNCAt ((Scheme.IdealSheafData.vanishingIdeal Z).comap W.ι) w :=
    hasSNCAt_comap W.ι _ w (hwq ▸ hZ _ (isClosed_singleton_blowUpToBase hq))
  have h2 : (Scheme.IdealSheafData.vanishingIdeal Z').comap g =
      (Scheme.IdealSheafData.vanishingIdeal Z).comap W.ι := by
    rw [comap_vanishingIdeal, comap_vanishingIdeal]
    congr 1
    ext v
    have hv : blowUpToBase I (g v) = W.ι v := by rw [← Scheme.Hom.comp_apply, hg]
    have hvp : W.ι v ≠ p := by
      have : (W.ι v : S) ∉ (I.support : Set S) := v.2
      rwa [hsupp] at this
    show g v ∈ (Z' : Set _) ↔ W.ι v ∈ (Z : Set S)
    have hgE : g v ∉ (exceptionalIdeal I).support := fun h =>
      hvp (hv ▸ (mem_support_exceptionalIdeal_iff hsupp (g v)).1 h)
    rw [hZ', Set.mem_union, Set.mem_preimage, hv]
    exact or_iff_left hgE
  rw [← hqw]
  exact hasSNCAt_of_comap g _ w (h2 ▸ h1)

/-- If each `w i`, `i ∈ s`, generates a prime ideal and no `w j` is a multiple of another `w i`,
then every common multiple of the `w i` is a multiple of their product. -/
private theorem prod_dvd_of_forall_dvd {R ι : Type*} [CommRing R] [DecidableEq ι] (w : ι → R)
    (s : Finset ι) (hp : ∀ i ∈ s, (Ideal.span {w i}).IsPrime)
    (hne : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → w j ∉ Ideal.span {w i}) {r : R}
    (hr : ∀ i ∈ s, w i ∣ r) : (∏ i ∈ s, w i) ∣ r := by
  induction s using Finset.induction_on generalizing r with
  | empty => simp
  | insert a s ha ih =>
    obtain ⟨t, rfl⟩ := ih (fun i hi => hp i (Finset.mem_insert_of_mem hi))
      (fun i hi j hj => hne i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj))
      (fun i hi => hr i (Finset.mem_insert_of_mem hi))
    rw [Finset.prod_insert ha]
    have hpa := hp a (Finset.mem_insert_self _ _)
    have hmem : (∏ i ∈ s, w i) * t ∈ Ideal.span {w a} :=
      Ideal.mem_span_singleton.2 (hr a (Finset.mem_insert_self _ _))
    rcases hpa.mem_or_mem hmem with h | h
    · exfalso
      obtain ⟨i, hi, hi'⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hpa)).1 h
      exact hne a (Finset.mem_insert_self _ _) i (Finset.mem_insert_of_mem hi)
        (fun e => ha (e ▸ hi)) hi'
    · obtain ⟨t', rfl⟩ := Ideal.mem_span_singleton.1 h
      exact ⟨t', by ring⟩

/-- In the setting of `prod_dvd_of_forall_dvd`, the product of the `w i` generates a radical
ideal. -/
private theorem isRadical_span_prod {R ι : Type*} [CommRing R] [DecidableEq ι] (w : ι → R)
    (s : Finset ι) (hp : ∀ i ∈ s, (Ideal.span {w i}).IsPrime)
    (hne : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → w j ∉ Ideal.span {w i}) :
    (Ideal.span {∏ i ∈ s, w i}).IsRadical := by
  rintro r ⟨n, hn⟩
  rw [Ideal.mem_span_singleton] at hn ⊢
  refine prod_dvd_of_forall_dvd w s hp hne fun i hi => ?_
  have : r ^ n ∈ Ideal.span {w i} :=
    Ideal.mem_span_singleton.2 ((Finset.dvd_prod_of_mem w hi).trans hn)
  exact Ideal.mem_span_singleton.1 ((hp i hi).mem_of_pow_mem n this)

/-- If on `Spec 𝒪_{Y,y}` a closed set `T` is the union of the hyperplanes `(w_c = 0)`, `c ∈ s`,
for a regular system of parameters `w`, the stalk at `y` of the reduced ideal of `T` is
`(∏_{c ∈ s} w_c)`. -/
private theorem stalk_vanishingIdeal_eq_span_prod {Y : Scheme.{u}} (T : Closeds Y) (y : Y)
    [IsNoetherianRing (Y.presheaf.stalk y)] {N : ℕ} {w : Fin N → Y.presheaf.stalk y}
    (hw : MMP.Mori.IsRegularSystemOfParameters w) (s : Finset (Fin N))
    (hT : ∀ P : PrimeSpectrum (Y.presheaf.stalk y),
      Y.fromSpecStalk y P ∈ (T : Set Y) ↔ ∃ c ∈ s, w c ∈ P.asIdeal) :
    IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal T) y =
      Ideal.span {∏ c ∈ s, w c} := by
  classical
  set K := IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal T) y
  have hzl : PrimeSpectrum.zeroLocus (K : Set (Y.presheaf.stalk y)) =
      PrimeSpectrum.zeroLocus ((Ideal.span {∏ c ∈ s, w c} : Ideal _) : Set _) := by
    rw [← preimage_fromSpecStalk_support, Scheme.IdealSheafData.coe_support_vanishingIdeal,
      PrimeSpectrum.zeroLocus_span]
    ext (P : PrimeSpectrum (Y.presheaf.stalk y))
    change Y.fromSpecStalk y P ∈ (T : Set Y) ↔ {∏ c ∈ s, w c} ⊆ (P.asIdeal : Set _)
    rw [Set.singleton_subset_iff, SetLike.mem_coe]
    exact (hT P).trans (Ideal.IsPrime.prod_mem_iff (hp := P.isPrime)).symm
  calc K = K.radical := (isRadical_stalk_vanishingIdeal T y).radical.symm
    _ = (Ideal.span {∏ c ∈ s, w c}).radical := by
      rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
        ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzl]
    _ = Ideal.span {∏ c ∈ s, w c} :=
      (isRadical_span_prod w s (fun c _ => span_singleton_isPrime_of_isRegularSystemOfParameters
        hw c) fun i _ j _ hij => notMem_span_singleton_of_ne_of_isRegularSystemOfParameters hw
          hij).radical

/-- The stalk at a point `y` of the reduced ideal of `{y}` is the maximal ideal of `𝒪_{Y,y}`. -/
private theorem stalk_vanishingIdeal_singleton {Y : Scheme.{u}} (T : Closeds Y) (y : Y)
    (hT : (T : Set Y) = {y}) :
    IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal T) y =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
  set K := IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal T) y
  have hinj : Function.Injective (Y.fromSpecStalk y) :=
    (Y.fromSpecStalk y).isEmbedding.injective
  have hzl : PrimeSpectrum.zeroLocus (K : Set (Y.presheaf.stalk y)) =
      PrimeSpectrum.zeroLocus (IsLocalRing.maximalIdeal (Y.presheaf.stalk y) : Set _) := by
    rw [← preimage_fromSpecStalk_support, Scheme.IdealSheafData.coe_support_vanishingIdeal, hT]
    ext (P : PrimeSpectrum (Y.presheaf.stalk y))
    change Y.fromSpecStalk y P = y ↔
      ((IsLocalRing.maximalIdeal (Y.presheaf.stalk y) : Ideal _) : Set _) ⊆
        (P.asIdeal : Set (Y.presheaf.stalk y))
    rw [SetLike.coe_subset_coe]
    constructor
    · intro h
      have h' : Y.fromSpecStalk y P = Y.fromSpecStalk y (IsLocalRing.closedPoint _) :=
        h.trans Scheme.fromSpecStalk_closedPoint.symm
      rw [hinj h']
      rfl
    · intro h
      have hP : P = IsLocalRing.closedPoint _ :=
        PrimeSpectrum.ext (le_antisymm (IsLocalRing.le_maximalIdeal P.isPrime.ne_top) h)
      rw [hP, Scheme.fromSpecStalk_closedPoint]
  calc K = K.radical := (isRadical_stalk_vanishingIdeal T y).radical.symm
    _ = (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)).radical := by
      rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
        ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzl]
    _ = _ := (IsLocalRing.maximalIdeal.isMaximal _).isPrime.radical

/-- Simple normal crossings at `x` follow from the stalk: if `I_x = (∏_{c ∈ s} w_c)` for a regular
system of parameters `w` of `𝒪_{X,x}`, then `I` has simple normal crossings at `x`. -/
private theorem hasSNCAt_of_stalk_eq_span_prod {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (x : X) {N : ℕ} {w : Fin N → X.presheaf.stalk x}
    (hw : MMP.Mori.IsRegularSystemOfParameters w) (s : Finset (Fin N))
    (h : IdealSheafData.stalk D x = Ideal.span {∏ c ∈ s, w c}) : HasSNCAt D x := by
  classical
  choose V hV t ht using fun c => X.presheaf.germ_exist (x := x) (w c)
  let W : X.Opens := Finset.univ.inf V
  have hxW : x ∈ W := by
    show x ∈ ((Finset.univ.inf V : X.Opens) : Set X)
    rw [TopologicalSpace.Opens.coe_finset_inf, Finset.inf_eq_iInf]
    exact Set.mem_iInter₂.2 fun c _ => hV c
  have hWV : ∀ c, W ≤ V c := fun c => Finset.inf_le (Finset.mem_univ c)
  let t' : Fin N → Γ(X, W) := fun c => (X.presheaf.map (homOfLE (hWV c)).op).hom (t c)
  have ht' : ∀ c (y : X) (hy : y ∈ W), (X.presheaf.germ W y hy).hom (t' c) =
      (X.presheaf.germ (V c) y (hWV c hy)).hom (t c) := fun c y hy =>
    X.presheaf.germ_res_apply (homOfLE (hWV c)) y hy (t c)
  let g : Γ(X, W) := ∏ c ∈ s, t' c
  have hg : (X.presheaf.germ W x hxW).hom g = ∏ c ∈ s, w c := by
    simp only [g, map_prod, ht', ht]
  obtain ⟨U, hUW, hxU, hU⟩ := MMP.Flips.ResolutionInputs.exists_ideal_eq_span_of_stalk_eq D hxW
    (fun _ : Unit => g) (by rw [Set.range_const, hg, h])
  let r : Fin N → Γ(X, U) := fun c => (X.presheaf.map (homOfLE hUW).op).hom (t' c)
  have hr : ∀ c (y : X) (hy : y ∈ U), (X.presheaf.germ U y hy).hom (r c) =
      (X.presheaf.germ W y (hUW hy)).hom (t' c) := fun c y hy =>
    X.presheaf.germ_res_apply (homOfLE hUW) y hy (t' c)
  refine ⟨N, U, hxU, r, fun c => if c ∈ s then 1 else 0, ?_, fun y hy => ?_⟩
  · convert hw using 1
    funext c
    rw [hr, ht', ht]
  · obtain ⟨W', hW', hyW', hW'U⟩ := exists_isAffineOpen_mem_and_subset hy
    rw [IdealSheafData.stalk_eq_map_germ D y ⟨W', hW'⟩ hyW', hU ⟨W', hW'⟩ hW'U, Ideal.map_span,
      Set.range_const, Set.image_singleton]
    congr 2
    have h1 : (X.presheaf.germ W' y hyW').hom (restrictSection ⟨W', hW'⟩ (hW'U.trans hUW) g) =
        (X.presheaf.germ W y (hUW hy)).hom g :=
      X.presheaf.germ_res_apply (homOfLE (hW'U.trans hUW)) y hyW' g
    rw [h1]
    simp only [pow_ite, pow_one, pow_zero]
    rw [Finset.prod_ite_mem, Finset.univ_inter]
    simp only [g, map_prod, hr]

/-- If the stalk of the ideal of `Z` at `y` is generated by a monomial `∏ i, x i ^ mexp i`, then a
point of `Spec 𝒪_{S,y}` lies over `Z` iff it contains some `x c` with `mexp c ≠ 0`. -/
public theorem fromSpecStalk_mem_iff_of_stalk_eq_span_prod {S : Scheme.{u}} (Z : Closeds S) {y : S}
    {V : S.Opens} (hV : y ∈ V) {d : ℕ} (x : Fin d → Γ(S, V)) (mexp : Fin d → ℕ)
    (hst : IdealSheafData.stalk (Scheme.IdealSheafData.vanishingIdeal Z) y =
      Ideal.span {(S.presheaf.germ V y hV).hom (∏ i, x i ^ mexp i)})
    (P : PrimeSpectrum (S.presheaf.stalk y)) :
    S.fromSpecStalk y P ∈ (Z : Set S) ↔
      ∃ c, mexp c ≠ 0 ∧ (S.presheaf.germ V y hV).hom (x c) ∈ P.asIdeal := by
  have h := Set.ext_iff.1 (preimage_fromSpecStalk_support
    (Scheme.IdealSheafData.vanishingIdeal Z) y) P
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal, hst] at h
  refine h.trans ?_
  change SetLike.coe (Ideal.span {(S.presheaf.germ V _ hV).hom (∏ i, x i ^ mexp i)}) ⊆
    SetLike.coe P.asIdeal ↔ _
  rw [SetLike.coe_subset_coe, Ideal.span_singleton_le_iff_mem, map_prod,
    Ideal.IsPrime.prod_mem_iff (hp := P.isPrime)]
  simp only [Finset.mem_univ, true_and, map_pow]
  refine exists_congr fun c => ?_
  by_cases hc : mexp c = 0
  · simp only [hc, pow_zero, ne_eq, not_true_eq_false, false_and, iff_false]
    exact fun h1 => P.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h1)
  · simp only [ne_eq, hc, not_false_eq_true, true_and]
    exact P.isPrime.pow_mem_iff_mem _ (Nat.pos_of_ne_zero hc)

/-- On the exceptional curve, `σ⁻¹(Z) ∪ E` has simple normal crossings at every closed point. -/
private theorem hasSNCAt_of_mem_exceptional {S : Scheme.{u}}
    (hS : IsRegularSurface S) (Z : Closeds S)
    (hZ : IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z))
    {p : S} (T : Closeds S) (hTp : (T : Set S) = {p}) {I : S.IdealSheafData}
    (hI : I = Scheme.IdealSheafData.vanishingIdeal T)
    (Z' : Closeds (blowUp I))
    (hZ' : (Z' : Set (blowUp I)) =
      (blowUpToBase I).base ⁻¹' (Z : Set S) ∪ (exceptionalIdeal I).support)
    (q : blowUp I) (hE : q ∈ (exceptionalIdeal I).support) :
    HasSNCAt (Scheme.IdealSheafData.vanishingIdeal Z') q := by
  classical
  have hp : IsClosed ({p} : Set S) := hTp ▸ T.isClosed
  have : IsNoetherian S := hS.1
  have : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  have : IsLocallyNoetherian (blowUp I) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase I)
  have hsupp : (I.support : Set S) = {p} := by
    rw [hI, Scheme.IdealSheafData.coe_support_vanishingIdeal, hTp]
  have hπq : blowUpToBase I q = p := (mem_support_exceptionalIdeal_iff hsupp q).1 hE
  have hclq : IsClosed ({blowUpToBase I q} : Set S) := hπq ▸ hp
  have hqZ : blowUpToBase I q ∈ I.support := by
    rw [← SetLike.mem_coe, hsupp, hπq]
    rfl
  obtain ⟨d, V, hV, x, mexp, hreg, hst⟩ := hZ _ hclq
  set z : Fin d → S.presheaf.stalk (blowUpToBase I q) :=
    fun i => (S.presheaf.germ V _ hV).hom (x i) with hz
  have hJ : IdealSheafData.stalk I (blowUpToBase I q) =
      Ideal.span (z '' ↑(Finset.univ : Finset (Fin d))) := by
    rw [Finset.coe_univ, Set.image_univ, hreg.1]
    subst hI
    exact stalk_vanishingIdeal_singleton T _ (by rw [hπq, hTp])
  obtain ⟨N, w, m, i₀, σ, U, hw, -, -, hwi₀, -, hin, hunit, hσ₀⟩ :=
    exists_chart_coordinates I q hqZ hreg hJ
  set φ := ((blowUpToBase I).stalkMap q).hom with hφ
  have hDx : ∀ P : PrimeSpectrum (S.presheaf.stalk (blowUpToBase I q)),
      S.fromSpecStalk _ P ∈ (Z : Set S) ↔ ∃ c, mexp c ≠ 0 ∧ z c ∈ P.asIdeal :=
    fromSpecStalk_mem_iff_of_stalk_eq_span_prod Z hV x mexp (hst _ hV)
  have hmul : ∀ (P : PrimeSpectrum ((blowUp I).presheaf.stalk q)) (j : Fin d),
      w i₀ ∈ P.asIdeal → φ (z j) ∈ P.asIdeal := by
    intro P j h
    by_cases hjm : j = m
    · rwa [hjm, ← hwi₀]
    by_cases hjU : j ∈ U
    · obtain ⟨u, -, hu⟩ := hunit j hjU
      rw [hu]
      exact Ideal.mul_mem_left _ _ h
    · rw [hin j (Finset.mem_univ _) hjm hjU]
      exact Ideal.mul_mem_left _ _ h
  have hEP : ∀ P : PrimeSpectrum ((blowUp I).presheaf.stalk q),
      (blowUp I).fromSpecStalk q P ∈ (exceptionalIdeal I).support ↔ w i₀ ∈ P.asIdeal := by
    intro P
    refine (mem_support_exceptionalIdeal_iff hsupp _).trans ?_
    refine (iff_of_eq (congrArg (· = p) (apply_fromSpecStalk _ _ P))).trans ?_
    have h := Set.ext_iff.1 (preimage_fromSpecStalk_support I (blowUpToBase I q))
      (PrimeSpectrum.comap φ P)
    rw [hsupp] at h
    refine h.trans ?_
    change SetLike.coe (IdealSheafData.stalk I (blowUpToBase I q)) ⊆
      SetLike.coe (PrimeSpectrum.comap φ P).asIdeal ↔ _
    rw [hJ, Finset.coe_univ, Set.image_univ, SetLike.coe_subset_coe, Ideal.span_le]
    constructor
    · intro h
      rw [hwi₀]
      exact h ⟨m, rfl⟩
    · rintro h _ ⟨j, rfl⟩
      exact hmul P j h
  let C₁ : Finset (Fin d) := Finset.univ.filter fun c => mexp c ≠ 0 ∧ c ≠ m ∧ c ∉ U
  have hZP : ∀ P : PrimeSpectrum ((blowUp I).presheaf.stalk q),
      blowUpToBase I ((blowUp I).fromSpecStalk q P) ∈ (Z : Set S) ↔
        ∃ c, mexp c ≠ 0 ∧ φ (z c) ∈ P.asIdeal := fun P =>
    (iff_of_eq (congrArg (· ∈ (Z : Set S)) (apply_fromSpecStalk _ _ P))).trans (hDx _)
  have hT : ∀ P : PrimeSpectrum ((blowUp I).presheaf.stalk q),
      (blowUp I).fromSpecStalk q P ∈ (Z' : Set _) ↔
        ∃ c ∈ insert i₀ (C₁.image σ), w c ∈ P.asIdeal := by
    intro P
    refine (Set.ext_iff.1 hZ' _).trans ((or_congr (hZP P) (hEP P)).trans ?_)
    simp only [Finset.mem_insert, Finset.mem_image, exists_eq_or_imp]
    constructor
    · rintro (⟨c, hc, hcP⟩ | h)
      · by_cases h0 : w i₀ ∈ P.asIdeal
        · exact Or.inl h0
        right
        by_cases hcm : c = m
        · rw [hcm, ← hwi₀] at hcP
          exact absurd hcP h0
        by_cases hcU : c ∈ U
        · obtain ⟨u, hu, hu'⟩ := hunit c hcU
          rw [hu'] at hcP
          refine absurd ((P.isPrime.mem_or_mem hcP).resolve_left fun h' => ?_) h0
          exact P.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h' hu)
        rw [hin c (Finset.mem_univ _) hcm hcU] at hcP
        exact ⟨σ c, ⟨c, Finset.mem_filter.2 ⟨Finset.mem_univ _, hc, hcm, hcU⟩, rfl⟩,
          (P.isPrime.mem_or_mem hcP).resolve_right h0⟩
      · exact Or.inl h
    · rintro (h | ⟨_, ⟨c, hc, rfl⟩, hcP⟩)
      · exact Or.inr h
      · obtain ⟨-, hc0, hcm, hcU⟩ := Finset.mem_filter.1 hc
        refine Or.inl ⟨c, hc0, ?_⟩
        rw [hin c (Finset.mem_univ _) hcm hcU]
        exact Ideal.mul_mem_right _ _ hcP
  exact hasSNCAt_of_stalk_eq_span_prod _ q hw _
    (stalk_vanishingIdeal_eq_span_prod Z' q hw _ hT)

/-- Blowing up a closed point of a regular surface preserves simple normal crossings: if the
reduced structure on a closed set `Z ⊆ S` is an snc divisor, then so is the reduced structure on
`σ⁻¹(Z) ∪ E ⊆ B_pS`, where `σ : B_pS → S` is the blow-up of the closed point `p` and `E` its
exceptional curve; moreover `B_pS` is a regular surface. -/
@[mmp "lem_kr1b_snc_preserved_by_point_blowup"]
public theorem isSNCSubscheme_vanishingIdeal_preimage_union_exceptional {S : Scheme.{u}}
    (hS : IsRegularSurface S) (Z : Closeds S)
    (hZ : IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z))
    (p : S) (hp : IsClosed ({p} : Set S))
    (Z' : Closeds (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)))
    (hZ' : (Z' : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) =
      (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base ⁻¹' (Z : Set S) ∪
        (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    IsRegularSurface (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) ∧
      IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z') := by
  refine ⟨isRegularSurface_blowUp hS p hp, fun q hq => ?_⟩
  by_cases hE : q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support
  · exact hasSNCAt_of_mem_exceptional hS Z hZ _ rfl rfl Z' hZ' q hE
  · haveI := hS.1
    exact hasSNCAt_of_notMem_exceptional Z hZ (coe_support_vanishingIdeal_singleton p hp) Z' hZ'
      q hq hE

/-! ### Counting the exceptional primes -/

section ExceptionalPrimes

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

/-- The points of `S'` with one-dimensional local ring lying over a closed point of `S`. -/
private def dimOneOverClosed {S' S : Scheme.{u}} (g : S' ⟶ S) : Set S' :=
  {ξ : S' | ringKrullDim (S'.presheaf.stalk ξ) = 1 ∧ IsClosed ({g.base ξ} : Set S)}

private lemma ringKrullDim_stalk_eq {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X)
    [IsIso (f.stalkMap x)] :
    ringKrullDim (X.presheaf.stalk x) = ringKrullDim (Y.presheaf.stalk (f.base x)) :=
  (ringKrullDim_eq_of_ringEquiv (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv).symm

private theorem isRegularSurface_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) (hY : IsRegularSurface Y) :
    IsRegularSurface X := by
  obtain ⟨hN, hreg, hdim⟩ := hY
  refine ⟨?_, fun x => IsRegularLocalRing.of_ringEquiv
    (asIso (e.hom.stalkMap x)).commRingCatIsoToRingEquiv, fun x hx => ?_⟩
  · have : IsLocallyNoetherian Y := hN.toIsLocallyNoetherian
    have : IsLocallyNoetherian X := isLocallyNoetherian_of_isOpenImmersion e.hom
    have : CompactSpace X := e.hom.homeomorph.symm.compactSpace
    exact {}
  · rw [ringKrullDim_stalk_eq e.hom x]
    refine hdim _ ?_
    rw [← Set.image_singleton]
    exact e.hom.homeomorph.isClosedMap _ hx

/-- Transport along an isomorphism of the source. -/
private lemma iso_transfer {X Y S : Scheme.{u}} (φ : X ≅ Y) (k : Y ⟶ S)
    (hY : IsRegularSurface Y) (hk : IsClosedMap k.base) :
    IsRegularSurface X ∧ IsClosedMap (φ.hom ≫ k).base ∧
      (dimOneOverClosed (φ.hom ≫ k)).encard = (dimOneOverClosed k).encard := by
  have hhom : IsHomeomorph φ.hom.base := φ.hom.homeomorph.isHomeomorph
  refine ⟨isRegularSurface_of_iso φ hY, ?_, ?_⟩
  · exact hk.comp hhom.isClosedMap
  · have hpre : dimOneOverClosed (φ.hom ≫ k) = φ.hom.base ⁻¹' dimOneOverClosed k := by
      ext ξ
      simp only [dimOneOverClosed, Set.mem_setOf_eq, Set.mem_preimage, Scheme.Hom.comp_base,
        TopCat.hom_comp, ContinuousMap.comp_apply, ringKrullDim_stalk_eq φ.hom ξ]
    rw [hpre, ← hhom.injective.encard_image, Set.image_preimage_eq _ hhom.surjective]

private lemma dimOneOverClosed_id {S : Scheme.{u}} (hS : IsRegularSurface S) :
    dimOneOverClosed (𝟙 S) = ∅ := by
  ext ξ
  simp only [dimOneOverClosed, Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_and]
  intro h1 hc
  rw [hS.2.2 ξ (by simpa using hc)] at h1
  norm_num at h1

section Step

variable {W S : Scheme.{u}} (w : W) (hw : IsClosed ({w} : Set W))

/-- The preimage of `W ∖ {w}` under the blow-up is the complement of the exceptional curve. -/
private lemma mem_preimage_complPoint_iff {q : blowUp (Scheme.IdealSheafData.vanishingIdeal
      ⟨{w}, hw⟩)} :
    q ∈ blowUpToBase (Kollar.pointIdeal hw) ⁻¹ᵁ Kollar.complPoint hw ↔
      q ∉ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support := by
  rw [← SetLike.mem_coe, Kollar.preimage_compl_eq_compl_support_exceptionalIdeal hw]
  rfl

/-- Off the exceptional curve the blow-up of a closed point is a local isomorphism. -/
private lemma isIso_stalkMap_blowUpToBase {q : blowUp (Scheme.IdealSheafData.vanishingIdeal
      ⟨{w}, hw⟩)}
    (hq : q ∉ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support) :
    IsIso ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).stalkMap q) := by
  have hq' := (mem_preimage_complPoint_iff w hw).2 hq
  set σ := blowUpToBase (Kollar.pointIdeal hw)
  set U := Kollar.complPoint hw
  haveI := Kollar.isIso_blowUpToBase_restrict_compl_point hw
  exact ((MorphismProperty.isomorphisms _).arrow_mk_iso_iff
    (morphismRestrictStalkMap σ U ⟨q, hq'⟩)).mp
      (((isIso_iff_isIso_stalkMap (σ ∣_ U)).mp inferInstance).2 ⟨q, hq'⟩)

private lemma blowUpToBase_bijOn :
    Set.BijOn (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).base
      ((exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support : Set _)ᶜ
      ({w}ᶜ) := by
  set σ := blowUpToBase (Kollar.pointIdeal hw)
  set U := Kollar.complPoint hw
  haveI := Kollar.isIso_blowUpToBase_restrict_compl_point hw
  have hbij : Function.Bijective (σ ∣_ U).base := (σ ∣_ U).homeomorph.bijective
  refine ⟨fun q hq => (mem_preimage_complPoint_iff w hw).2 hq, fun q₁ hq₁ q₂ hq₂ he => ?_, fun y hy => ?_⟩
  · have e1 := morphismRestrict_base_coe σ U ⟨q₁, (mem_preimage_complPoint_iff w hw).2 hq₁⟩
    have e2 := morphismRestrict_base_coe σ U ⟨q₂, (mem_preimage_complPoint_iff w hw).2 hq₂⟩
    have h := hbij.1 (Subtype.ext (e1.trans (he.trans e2.symm)))
    exact congrArg Subtype.val h
  · obtain ⟨x, hx⟩ := hbij.2 ⟨y, hy⟩
    refine ⟨x.1, (mem_preimage_complPoint_iff w hw).1 x.2, ?_⟩
    rw [← morphismRestrict_base_coe, hx]

private lemma exists_unique_not_isClosed (hW : IsRegularSurface W) :
    ∃ η, η ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support ∧
      ∀ q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support,
        (¬ IsClosed ({q} : Set _) ↔ q = η) := by
  obtain ⟨hN, hreg, hdim⟩ := hW
  set D := exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  obtain ⟨e, -⟩ :=
    Stacks.Blowup.exists_isExceptionalCurveOfFirstKind_exceptionalIdeal_vanishingIdeal w hw
      (hreg w) (hdim w hw)
  haveI : IsIntegral D.subscheme := isIntegral_subscheme_of_iso_projectiveLineProj D _ e
  set η := D.subschemeι.base (genericPoint D.subscheme)
  have hηmem : η ∈ (D.support : Set _) := by
    rw [← D.range_subschemeι]; exact ⟨_, rfl⟩
  have hspec : ∀ a : D.subscheme, η ⤳ D.subschemeι.base a := fun a =>
    ((genericPoint_spec D.subscheme).specializes (Set.mem_univ a)).map
      D.subschemeι.base.hom.continuous
  have hdim1 : topologicalKrullDim D.subscheme = 1 := by
    rw [← IsHomeomorph.topologicalKrullDim_eq _ e.hom.homeomorph.isHomeomorph,
      Stacks.ProjectiveSpace.topologicalKrullDim_proj_fin _ (r := 2) two_pos]
    norm_num
  have hns : ¬ IsClosed ({η} : Set _) := by
    intro hc
    have hsub : Subsingleton D.subscheme := by
      constructor
      intro a b
      have hab : ∀ a : D.subscheme, D.subschemeι.base a = η := fun a => by
        have := specializes_iff_mem_closure.mp (hspec a)
        rwa [hc.closure_eq] at this
      exact D.subschemeι.isClosedEmbedding.injective ((hab a).trans (hab b).symm)
    have := topologicalKrullDim_zero_of_discreteTopology D.subscheme
    rw [hdim1] at this
    norm_num at this
  refine ⟨η, hηmem, fun q hq => ⟨fun hnc => ?_, fun h => h ▸ hns⟩⟩
  by_contra hne
  have hq' := hq
  rw [← SetLike.mem_coe, ← D.range_subschemeι] at hq'
  obtain ⟨q', rfl⟩ := hq'
  exact hnc (specializes_and_isClosed_singleton_of_iso_projectiveLineProj D _ e hηmem hq
    (hspec q') (Ne.symm hne)).2

/-- A point of the blow-up has one-dimensional local ring over a closed point of `S` iff it is
off `E` and its image does, or it is the generic point `η` of `E`. -/
private lemma dimOneOverClosed_comp_blowUpToBase (hW : IsRegularSurface W) (h : W ⟶ S)
    (hh : IsClosedMap h.base) {η : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)}
    (hηE : η ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support)
    (hη : ∀ q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support,
        (¬ IsClosed ({q} : Set _) ↔ q = η)) :
    dimOneOverClosed (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫ h) =
      ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).base ⁻¹'
        dimOneOverClosed h ∩
        (SetLike.coe (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support)ᶜ)
        ∪ {η} := by
  haveI := hW.1
  set σ := blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  set E : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) :=
    SetLike.coe (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support
  have hhw : IsClosed ({h.base w} : Set S) := by
    rw [← Set.image_singleton]; exact hh _ hw
  ext q
  by_cases hq : q ∈ E
  · have hσq : σ.base q = w :=
      of_not_not fun hne => (mem_preimage_complPoint_iff w hw).1 hne hq
    have hcard := isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal w hw
      (hW.2.1 w) (hW.2.2 w hw) q hq
    simp only [dimOneOverClosed, Set.mem_setOf_eq, Set.mem_union, Set.mem_inter_iff,
      Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff, Scheme.Hom.comp_base,
      TopCat.hom_comp, ContinuousMap.comp_apply, hσq, hhw, hq, and_true, not_true_eq_false,
      and_false, false_or]
    rw [← hη q hq]
    constructor
    · intro h1 hc
      rw [hcard.2.1 hc] at h1
      norm_num at h1
    · intro hnc
      exact hcard.2.2 hnc
  · haveI := isIso_stalkMap_blowUpToBase w hw hq
    have hne : q ≠ η := fun h => hq (h ▸ hηE)
    simp only [dimOneOverClosed, Set.mem_setOf_eq, Set.mem_union, Set.mem_inter_iff,
      Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff, Scheme.Hom.comp_base,
      TopCat.hom_comp, ContinuousMap.comp_apply, hq, hne, not_false_eq_true, and_true,
      or_false, ringKrullDim_stalk_eq σ q]

private lemma encard_dimOneOverClosed_blowUpToBase_comp (hW : IsRegularSurface W) (h : W ⟶ S)
    (hh : IsClosedMap h.base) :
    IsRegularSurface (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) ∧
      IsClosedMap (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫ h).base ∧
      (dimOneOverClosed (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫
        h)).encard = (dimOneOverClosed h).encard + 1 := by
  haveI := hW.1
  set σ := blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  set E : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) :=
    SetLike.coe (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support
  have hσc : IsClosedMap σ.base := σ.isClosedMap
  refine ⟨isRegularSurface_blowUp hW w hw, hh.comp hσc, ?_⟩
  obtain ⟨η, hηE, hη⟩ := exists_unique_not_isClosed w hw hW
  have hsplit := dimOneOverClosed_comp_blowUpToBase w hw hW h hh hηE hη
  have hdisj : Disjoint (σ.base ⁻¹' dimOneOverClosed h ∩ Eᶜ) {η} := by
    rw [Set.disjoint_singleton_right]
    exact fun h' => h'.2 hηE
  have himage : σ.base '' (σ.base ⁻¹' dimOneOverClosed h ∩ Eᶜ) = dimOneOverClosed h := by
    apply le_antisymm
    · rintro _ ⟨q, hq, rfl⟩; exact hq.1
    · intro y hy
      have hyw : y ≠ w := by
        rintro rfl
        have := hy.1
        rw [hW.2.2 y hw] at this
        norm_num at this
      obtain ⟨q, hq, rfl⟩ := (blowUpToBase_bijOn w hw).surjOn hyw
      exact ⟨q, ⟨hy, hq⟩, rfl⟩
  rw [hsplit, Set.encard_union_eq hdisj, Set.encard_singleton]
  congr 1
  rw [← ((blowUpToBase_bijOn w hw).injOn.mono Set.inter_subset_right).encard_image, himage]

end Step

private lemma isRegularSurface_and_encard_dimOneOverClosed :
    ∀ (m : ℕ) {S' S : Scheme.{u}} (g : S' ⟶ S),
    IsCompositeOfPointBlowupsOfLength m g → IsRegularSurface S →
      IsRegularSurface S' ∧ IsClosedMap g.base ∧ (dimOneOverClosed g).encard = m
  | 0, S', S, g, hg, hS => by
    haveI : IsIso g := hg
    have := iso_transfer (asIso g) (𝟙 S) hS (by simpa using IsClosedMap.id)
    simp only [asIso_hom, Category.comp_id, dimOneOverClosed_id hS, Set.encard_empty] at this
    exact_mod_cast this
  | m + 1, S', S, g, hg, hS => by
    obtain ⟨W, h, w, hw, hh, φ, rfl⟩ := hg
    obtain ⟨hW, hhc, hcount⟩ := isRegularSurface_and_encard_dimOneOverClosed m h hh hS
    obtain ⟨hB, hσ, hc⟩ := encard_dimOneOverClosed_blowUpToBase_comp w hw hW h hhc
    obtain ⟨h1, h2, h3⟩ := iso_transfer φ _ hB hσ
    refine ⟨h1, h2, ?_⟩
    rw [h3, hc, hcount]
    norm_cast

/-- If `S` is a regular surface and `g : S' ⟶ S` is a composite of `m` point blow-ups, then the
set of points `ξ ∈ S'` with `dim 𝒪_{S',ξ} = 1` and `g ξ` closed in `S` has exactly `m`
elements. -/
@[mmp "lem_kr1b_exceptional_prime_count"]
public theorem encard_exceptionalPrimes_eq {S' S : Scheme.{u}} (hS : IsRegularSurface S)
    {m : ℕ} {g : S' ⟶ S} (hg : IsCompositeOfPointBlowupsOfLength m g) :
    {ξ : S' | ringKrullDim (S'.presheaf.stalk ξ) = 1 ∧ IsClosed ({g.base ξ} : Set S)}.encard =
      m :=
  (isRegularSurface_and_encard_dimOneOverClosed _ _ hg hS).2.2

end ExceptionalPrimes

/-! ### Domination bounds the number of point blow-ups -/

/-- Precomposing a composite of `n` point blow-ups with an isomorphism gives a composite of `n`
point blow-ups. -/
private theorem isCompositeOfPointBlowupsOfLength_iso_comp :
    ∀ (n : ℕ) {S' T S : Scheme.{u}} (e : S' ⟶ T) [IsIso e] {g : T ⟶ S},
      IsCompositeOfPointBlowupsOfLength n g → IsCompositeOfPointBlowupsOfLength n (e ≫ g)
  | 0, _, _, _, e, _, g, hg => by
    have : IsIso g := hg
    show IsIso (e ≫ g)
    infer_instance
  | n + 1, _, _, _, e, _, g, hg => by
    obtain ⟨W, h, w, hw, hh, φ, rfl⟩ := hg
    refine ⟨W, h, w, hw, hh, asIso e ≪≫ φ, ?_⟩
    rw [Iso.trans_hom, asIso_hom, Category.assoc]

/-- If `g` is a composite of `n` point blow-ups and `h` a composite of `r` point blow-ups, then
`h ≫ g` is a composite of `n + r` point blow-ups. -/
private theorem isCompositeOfPointBlowupsOfLength_comp (n : ℕ) :
    ∀ (r : ℕ) {S' T S : Scheme.{u}} {h : S' ⟶ T} {g : T ⟶ S},
      IsCompositeOfPointBlowupsOfLength n g → IsCompositeOfPointBlowupsOfLength r h →
        IsCompositeOfPointBlowupsOfLength (n + r) (h ≫ g)
  | 0, _, _, _, h, g, hg, hh => by
    have : IsIso h := hh
    exact isCompositeOfPointBlowupsOfLength_iso_comp n h hg
  | r + 1, _, _, _, h, g, hg, hh => by
    obtain ⟨W, h', w, hw, hh', φ, rfl⟩ := hh
    refine ⟨W, h' ≫ g, w, hw, isCompositeOfPointBlowupsOfLength_comp n r hg hh', φ, ?_⟩
    simp only [Category.assoc]

/-- If `g₁ : T ⟶ S` is a composite of `n` point blow-ups of a regular surface `S`,
`h : S' ⟶ T` is a composite of point blow-ups and `h ≫ g₁` is a composite of `N` point
blow-ups, then `n ≤ N`. -/
@[mmp "lem_kr1b_domination_bounds_length"]
public theorem IsCompositeOfPointBlowupsOfLength.le_of_comp {S T S' : Scheme.{u}}
    (hS : IsRegularSurface S) {n N : ℕ} {g₁ : T ⟶ S} {h : S' ⟶ T}
    (hg₁ : IsCompositeOfPointBlowupsOfLength n g₁) (hh : IsCompositeOfPointBlowups h)
    (hN : IsCompositeOfPointBlowupsOfLength N (h ≫ g₁)) : n ≤ N := by
  obtain ⟨r, hr⟩ := hh
  have := (encard_exceptionalPrimes_eq hS
    (isCompositeOfPointBlowupsOfLength_comp n r hg₁ hr)).symm.trans
      (encard_exceptionalPrimes_eq hS hN)
  exact Nat.cast_injective (R := ℕ∞) this ▸ Nat.le_add_right n r

/-! ### The exceptional set of a composite of point blow-ups is snc -/

/-- If `f` is biregular over `g⁻¹ V`, then `f ≫ g` is biregular over `V` exactly when `g` is. -/
private theorem isBiregular_comp_iff {X X' Y : Scheme.{u}} {f : X' ⟶ X} {g : X ⟶ Y}
    {V : Y.Opens} (hf : MMP.Mori.IsBiregular f (g ⁻¹ᵁ V)) :
    MMP.Mori.IsBiregular (f ≫ g) V ↔ MMP.Mori.IsBiregular g V := by
  have : IsIso (f ∣_ g ⁻¹ᵁ V) := hf
  unfold MMP.Mori.IsBiregular
  rw [morphismRestrict_comp]
  exact ⟨fun h => @IsIso.of_isIso_comp_left _ _ _ _ _ _ _ this h,
    fun h => @IsIso.comp_isIso _ _ _ _ _ _ _ this h⟩

private theorem exceptionalSet_comp_of_isIso {X X' Y : Scheme.{u}} (φ : X' ⟶ X) [IsIso φ]
    (f : X ⟶ Y) : (MMP.Mori.exceptionalSet (φ ≫ f) : Set X') =
      φ.base ⁻¹' (MMP.Mori.exceptionalSet f : Set X) := by
  have : MMP.Mori.biregularLocus (φ ≫ f) = MMP.Mori.biregularLocus f := by
    unfold MMP.Mori.biregularLocus
    congr 1
    ext V
    exact isBiregular_comp_iff (IsZariskiLocalAtTarget.restrict
      (P := MorphismProperty.isomorphisms Scheme) (inferInstanceAs (IsIso φ)) _)
  ext x
  simp [MMP.Mori.exceptionalSet, this]

/-- Along an isomorphism, the inverse image of an ideal sheaf is its image under the inverse. -/
private theorem comap_eq_map_inv {X Y : Scheme.{u}} (e : X ≅ Y) (I : Y.IdealSheafData) :
    I.comap e.hom = I.map e.inv := by
  have h1 : ∀ J : X.IdealSheafData, (J.comap e.inv).comap e.hom = J := fun J => by
    rw [← Scheme.IdealSheafData.comap_comp, e.hom_inv_id, Scheme.IdealSheafData.comap_id]
  have h2 : ∀ J : Y.IdealSheafData, (J.comap e.hom).comap e.inv = J := fun J => by
    rw [← Scheme.IdealSheafData.comap_comp, e.inv_hom_id, Scheme.IdealSheafData.comap_id]
  refine le_antisymm ?_ ?_
  · rw [Scheme.IdealSheafData.le_map_iff_comap_le, h2]
  · have := (Scheme.IdealSheafData.le_map_iff_comap_le (I := I) (f := e.inv)
      (J := I.map e.inv)).mp le_rfl
    calc I.map e.inv = ((I.map e.inv).comap e.inv).comap e.hom := (h1 _).symm
      _ ≤ I.comap e.hom := Scheme.IdealSheafData.comap_mono e.hom this

private theorem vanishingIdeal_eq_comap_of_iso {X Y : Scheme.{u}} (e : X ≅ Y)
    (Z : Closeds Y) (Z' : Closeds X) (hZ' : (Z' : Set X) = e.hom.base ⁻¹' (Z : Set Y)) :
    Scheme.IdealSheafData.vanishingIdeal Z' =
      (Scheme.IdealSheafData.vanishingIdeal Z).comap e.hom := by
  rw [comap_eq_map_inv, Scheme.IdealSheafData.map_vanishingIdeal]
  congr 1
  ext x
  rw [hZ']
  have : (e.inv.base '' (Z : Set Y)) = e.hom.base ⁻¹' (Z : Set Y) := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      simpa [← Scheme.Hom.comp_apply] using hz
    · intro hy
      exact ⟨e.hom.base y, hy, by simp [← Scheme.Hom.comp_apply]⟩
  rw [this, Closeds.coe_closure, (Z.isClosed.preimage e.hom.base.hom.continuous).closure_eq]

private theorem isSNCSubscheme_vanishingIdeal_preimage_of_iso {X Y : Scheme.{u}} (e : X ≅ Y)
    (Z : Closeds Y) (Z' : Closeds X) (hZ' : (Z' : Set X) = e.hom.base ⁻¹' (Z : Set Y))
    (hZ : IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z)) :
    IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal Z') := by
  rw [vanishingIdeal_eq_comap_of_iso e Z Z' hZ']
  intro p hp
  have hp' : IsClosed ({e.hom.base p} : Set Y) := by
    rw [← Set.image_singleton]
    exact e.hom.homeomorph.isClosedMap _ hp
  obtain ⟨d, U, hpU, x, m, ⟨hspan, hdim⟩, hstalk⟩ := hZ _ hp'
  have hbij : ∀ q : X, Function.Bijective (e.hom.stalkMap q).hom := fun q => by
    have := ((isIso_iff_isIso_stalkMap e.hom).mp (inferInstanceAs (IsIso e.hom))).2 q
    exact ConcreteCategory.bijective_of_isIso (e.hom.stalkMap q)
  refine ⟨d, e.hom ⁻¹ᵁ U, hpU, fun i => e.hom.app U (x i), m, ⟨?_, ?_⟩, fun q hq => ?_⟩
  · have : (fun i => (X.presheaf.germ (e.hom ⁻¹ᵁ U) p hpU).hom (e.hom.app U (x i))) =
        fun i => (e.hom.stalkMap p).hom ((Y.presheaf.germ U _ hpU).hom (x i)) := by
      funext i
      exact (Scheme.Hom.germ_stalkMap_apply e.hom U p hpU (x i)).symm
    rw [this, Set.range_comp', ← Ideal.map_span, hspan]
    exact IsLocalRing.map_maximalIdeal_of_surjective _ (hbij p).2
  · rw [← hdim]
    exact (ringKrullDim_eq_of_ringEquiv (RingEquiv.ofBijective _ (hbij p))).symm
  · rw [AlgebraicGeometry.IdealSheafData.stalk_comap, hstalk _ hq, Ideal.map_span,
      Set.image_singleton]
    congr 2
    rw [Scheme.Hom.germ_stalkMap_apply e.hom U q hq, map_prod]
    simp only [map_pow]

private theorem isSNCSubscheme_vanishingIdeal_bot {X : Scheme.{u}} (hX : IsRegularSurface X) :
    IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal (⊥ : Closeds X)) := by
  intro p hp
  obtain ⟨hN, hreg, hdim⟩ := hX
  have hd := hdim p hp
  have hR := hreg p
  have hfg : (IsLocalRing.maximalIdeal (X.presheaf.stalk p)).FG :=
    hR.toIsNoetherian.noetherian _
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  have hrank : (IsLocalRing.maximalIdeal (X.presheaf.stalk p)).spanFinrank = 2 := by
    have := hR.spanFinrank_maximalIdeal
    rw [hd] at this
    exact_mod_cast this
  rw [hrank] at hcard
  let z : Fin 2 → X.presheaf.stalk p := fun i => (s.equivFin.symm (Fin.cast hcard.symm i) : _)
  have hz : Set.range z = (s : Set _) := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm (Fin.cast hcard.symm i)).2
    · intro ha
      refine ⟨Fin.cast hcard (s.equivFin ⟨a, ha⟩), ?_⟩
      simp [z]
  choose U hpU t ht using fun i => TopCat.Presheaf.germ_exist X.presheaf (z i)
  let V : X.Opens := U 0 ⊓ U 1
  have hpV : p ∈ V := ⟨hpU 0, hpU 1⟩
  have hle : ∀ i, V ≤ U i := fun i => by
    fin_cases i
    · exact inf_le_left
    · exact inf_le_right
  let x : Fin 2 → Γ(X, V) := fun i => X.presheaf.map (homOfLE (hle i)).op (t i)
  have hgx : (fun i => (X.presheaf.germ V p hpV).hom (x i)) = z := by
    funext i
    simp only [x]
    rw [← ht i]
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  refine ⟨2, V, hpV, x, fun _ => 0, ⟨?_, hd⟩, fun q hq => ?_⟩
  · rw [hgx, hz]
    exact hspan
  · simp only [Scheme.IdealSheafData.vanishingIdeal_bot, pow_zero, Finset.prod_const_one,
      map_one, Ideal.span_singleton_one]
    obtain ⟨W, hW, hqW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (X := X) (x := q) (U := ⊤) (by simp)
    rw [IdealSheafData.stalk_eq_map_germ _ q ⟨W, hW⟩ hqW]
    simp only [Scheme.IdealSheafData.ideal_top]
    exact Ideal.map_top _

private theorem exceptionalSet_eq_bot_of_isIso {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] :
    MMP.Mori.exceptionalSet f = ⊥ := by
  have h : MMP.Mori.IsBiregular f ⊤ := (MMP.Mori.isBiregular_top_iff f).mpr inferInstance
  have := MMP.Mori.le_biregularLocus h
  ext x
  simp only [MMP.Mori.exceptionalSet, Closeds.coe_bot, Set.mem_empty_iff_false, iff_false]
  intro hx
  exact hx (this (Set.mem_univ _))

/-- Over an `f`-biregular open, `f` reflects specializations. -/
private theorem specializes_iff_of_isBiregular {X Y : Scheme.{u}} {f : X ⟶ Y} {V : Y.Opens}
    (hV : MMP.Mori.IsBiregular f V) {x₁ x₂ : X} (h₁ : f x₁ ∈ V) (h₂ : f x₂ ∈ V) :
    f x₁ ⤳ f x₂ ↔ x₁ ⤳ x₂ := by
  have : IsIso (f ∣_ V) := hV
  have key := (f ∣_ V).homeomorph.isInducing.specializes_iff
    (x := (⟨x₁, h₁⟩ : f ⁻¹ᵁ V)) (y := ⟨x₂, h₂⟩)
  have e₁ : ((f ∣_ V).homeomorph ⟨x₁, h₁⟩).1 = f x₁ := morphismRestrict_base_coe f V _
  have e₂ : ((f ∣_ V).homeomorph ⟨x₂, h₂⟩).1 = f x₂ := morphismRestrict_base_coe f V _
  rw [← e₁, ← e₂]
  exact (subtype_specializes_iff _ _).symm.trans (key.trans (subtype_specializes_iff _ _))

/-- Over an `f`-biregular open, `f` is injective. -/
private theorem apply_eq_iff_of_isBiregular {X Y : Scheme.{u}} {f : X ⟶ Y} {V : Y.Opens}
    (hV : MMP.Mori.IsBiregular f V) {x₁ x₂ : X} (h₁ : f x₁ ∈ V) (h₂ : f x₂ ∈ V) :
    f x₁ = f x₂ ↔ x₁ = x₂ := by
  have : IsIso (f ∣_ V) := hV
  have e₁ : ((f ∣_ V).homeomorph ⟨x₁, h₁⟩).1 = f x₁ := morphismRestrict_base_coe f V _
  have e₂ : ((f ∣_ V).homeomorph ⟨x₂, h₂⟩).1 = f x₂ := morphismRestrict_base_coe f V _
  refine ⟨fun h => ?_, fun h => h ▸ rfl⟩
  exact congrArg Subtype.val
    ((f ∣_ V).homeomorph.injective (Subtype.ext (e₁.trans (h.trans e₂.symm))))

/-- A point of the blow-up of a closed point `w` lies on the exceptional curve exactly when it
maps to `w`. -/
private theorem mem_support_exceptionalIdeal_singleton_iff {W : Scheme.{u}} {w : W}
    (hw : IsClosed ({w} : Set W)) (y : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) :
    y ∈ ((exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support : Set _) ↔
      blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) y = w :=
  mem_support_exceptionalIdeal_iff (coe_support_vanishingIdeal_singleton w hw) y

/-- The blow-up of a closed point `w` is biregular over every open avoiding `w`. -/
private theorem isBiregular_blowUpToBase_of_notMem {W : Scheme.{u}} {w : W}
    (hw : IsClosed ({w} : Set W)) {U : W.Opens} (hU : w ∉ U) :
    MMP.Mori.IsBiregular (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) U := by
  refine MMP.Mori.isBiregular_iff_le_biregularLocus.mpr (le_trans ?_
    (MMP.Mori.le_biregularLocus (Kollar.isIso_blowUpToBase_restrict_compl_point hw)))
  rintro x hx (rfl : x = w)
  exact hU hx

/-- The exceptional curve of the blow-up of a closed point of a regular surface has two distinct
points. -/
private theorem exists_ne_mem_support_exceptionalIdeal {W : Scheme.{u}} (hW : IsRegularSurface W)
    (w : W) (hw : IsClosed ({w} : Set W)) :
    ∃ a ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support,
      ∃ b ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support,
        a ≠ b := by
  obtain ⟨hN, hreg, hdim⟩ := hW
  set D := exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  obtain ⟨e, -⟩ :=
    Stacks.Blowup.exists_isExceptionalCurveOfFirstKind_exceptionalIdeal_vanishingIdeal w hw
      (hreg w) (hdim w hw)
  have hdim1 : topologicalKrullDim D.subscheme = 1 := by
    rw [← IsHomeomorph.topologicalKrullDim_eq _ e.hom.homeomorph.isHomeomorph,
      Stacks.ProjectiveSpace.topologicalKrullDim_proj_fin _ (r := 2) two_pos]
    norm_num
  by_contra hne
  push Not at hne
  have hsub : Subsingleton D.subscheme := by
    constructor
    intro a b
    have ha : D.subschemeι.base a ∈ (D.support : Set _) := by
      rw [← D.range_subschemeι]; exact ⟨_, rfl⟩
    have hb : D.subschemeι.base b ∈ (D.support : Set _) := by
      rw [← D.range_subschemeι]; exact ⟨_, rfl⟩
    exact D.subschemeι.isClosedEmbedding.injective (hne _ ha _ hb)
  have := @topologicalKrullDim_zero_of_discreteTopology D.subscheme _
    (@Subsingleton.discreteTopology _ _ hsub)
  rw [hdim1] at this
  norm_num at this

/-- If `σ ≫ h` is an isomorphism over `V`, where `σ` is the blow-up of the closed point `w`, then
`h(w) ∉ V`: the exceptional curve, which `σ` contracts to `w`, has more than one point. -/
private theorem notMem_preimage_of_isBiregular_blowUpToBase_comp {W S : Scheme.{u}}
    (hW : IsRegularSurface W) (h : W ⟶ S) (w : W) (hw : IsClosed ({w} : Set W)) (V : S.Opens)
    (hV : MMP.Mori.IsBiregular
      (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫ h) V) :
    w ∉ h ⁻¹ᵁ V := by
  intro hwV
  obtain ⟨a, ha, b, hb, hab⟩ := exists_ne_mem_support_exceptionalIdeal hW w hw
  replace ha := (mem_support_exceptionalIdeal_singleton_iff hw a).mp ha
  replace hb := (mem_support_exceptionalIdeal_singleton_iff hw b).mp hb
  set σ := blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  have hmem : ∀ {y}, σ y = w → (σ ≫ h) y ∈ V := fun {y} hy => by
    show h (σ y) ∈ V
    rwa [hy]
  refine hab ((apply_eq_iff_of_isBiregular hV (hmem ha) (hmem hb)).mp ?_)
  show h (σ a) = h (σ b)
  rw [ha, hb]

/-- Kollár 1.48, the exceptional set grows by `E`. -/
private theorem exceptionalSet_blowUpToBase_comp {W S : Scheme.{u}} (hW : IsRegularSurface W)
    (h : W ⟶ S) (w : W) (hw : IsClosed ({w} : Set W)) :
    (MMP.Mori.exceptionalSet
        (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫ h) :
        Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩))) =
      (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).base ⁻¹'
          (MMP.Mori.exceptionalSet h : Set W) ∪
        (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)).support := by
  set σ := blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)
  ext y
  simp only [Set.mem_union, Set.mem_preimage, mem_support_exceptionalIdeal_singleton_iff]
  constructor
  · intro hy
    by_contra! ⟨hy1, hy2⟩
    have hy1' : h (σ y) ∈ MMP.Mori.biregularLocus h := not_not.mp hy1
    -- `σ ≫ h` is biregular over the part of the biregular locus of `h` not specializing to `h w`
    let V' : S.Opens := MMP.Mori.biregularLocus h ⊓
      ⟨(closure {h w})ᶜ, isClosed_closure.isOpen_compl⟩
    have hV' : MMP.Mori.IsBiregular (σ ≫ h) V' :=
      (isBiregular_comp_iff (isBiregular_blowUpToBase_of_notMem hw (U := h ⁻¹ᵁ V')
        fun hx => hx.2 (subset_closure rfl))).mpr
        (MMP.Mori.isBiregular_iff_le_biregularLocus.mpr inf_le_left)
    refine hy (MMP.Mori.le_biregularLocus hV' ⟨hy1', fun hspec => hy2 ?_⟩)
    have hsp : h w ⤳ h (σ y) := specializes_iff_mem_closure.mpr hspec
    have hwB := hsp.mem_open (MMP.Mori.biregularLocus h).2 hy1'
    exact ((specializes_iff_of_isBiregular (MMP.Mori.isBiregular_biregularLocus h) hwB hy1').mp
      hsp).mem_closed hw rfl
  · intro hy (hyV : h (σ y) ∈ MMP.Mori.biregularLocus (σ ≫ h))
    have hV := MMP.Mori.isBiregular_biregularLocus (σ ≫ h)
    have hwV := notMem_preimage_of_isBiregular_blowUpToBase_comp hW h w hw _ hV
    rcases hy with hy | hy
    · exact hy (MMP.Mori.le_biregularLocus
        ((isBiregular_comp_iff (isBiregular_blowUpToBase_of_notMem hw hwV)).mp hV) hyV)
    · exact hwV (by rwa [hy] at hyV)

private theorem isRegularSurface_and_isSNCSubscheme_exceptionalSet (m : ℕ) :
    ∀ {S' S : Scheme.{u}} {g : S' ⟶ S}, IsRegularSurface S →
    IsCompositeOfPointBlowupsOfLength m g →
      IsRegularSurface S' ∧
        IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal (MMP.Mori.exceptionalSet g)) := by
  induction m with
  | zero =>
    intro S' S g hS hg
    have : IsIso g := hg
    have hS' : IsRegularSurface S' := isRegularSurface_of_iso (asIso g) hS
    refine ⟨hS', ?_⟩
    rw [exceptionalSet_eq_bot_of_isIso g]
    exact isSNCSubscheme_vanishingIdeal_bot hS'
  | succ m ih =>
    intro S' S g hS hg
    obtain ⟨W, h, w, hw, hh, φ, rfl⟩ := hg
    obtain ⟨hW, hZ⟩ := ih hS hh
    let Z' : Closeds (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩)) :=
      MMP.Mori.exceptionalSet
        (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{w}, hw⟩) ≫ h)
    obtain ⟨hB, hZ'⟩ := isSNCSubscheme_vanishingIdeal_preimage_union_exceptional hW
      (MMP.Mori.exceptionalSet h) hZ w hw Z' (exceptionalSet_blowUpToBase_comp hW h w hw)
    refine ⟨isRegularSurface_of_iso φ hB, ?_⟩
    exact isSNCSubscheme_vanishingIdeal_preimage_of_iso φ Z' _
      (exceptionalSet_comp_of_isIso φ.hom _) hZ'

/-- Kollár 1.48: if `S` is a regular surface and `g : S' ⟶ S` is a composite of point blow-ups,
then the reduced closed subscheme of `S'` with underlying set the exceptional set of `g` is a
simple normal crossing divisor. -/
@[mmp "lem_kr1b_exceptional_divisor_point_blowups_snc"]
public theorem isSNCSubscheme_vanishingIdeal_exceptionalSet {S S' : Scheme.{u}}
    (hS : IsRegularSurface S) {g : S' ⟶ S} (hg : IsCompositeOfPointBlowups g) :
    IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal (MMP.Mori.exceptionalSet g)) := by
  obtain ⟨m, hm⟩ := hg
  exact (isRegularSurface_and_isSNCSubscheme_exceptionalSet m hS hm).2

/-! ### Strong embedded resolution sequences are dominated by snc models -/

/-- Post-composing a composite of `m` point blow-ups with an isomorphism gives a composite of
`m` point blow-ups. -/
private theorem isCompositeOfPointBlowupsOfLength_comp_isIso :
    ∀ (m : ℕ) {S' S T : Scheme.{u}} {g : S' ⟶ S} (e : S ⟶ T) [IsIso e],
      IsCompositeOfPointBlowupsOfLength m g → IsCompositeOfPointBlowupsOfLength m (g ≫ e)
  | 0, _, _, _, g, e, _, hg => by
      have : IsIso g := hg
      show IsIso (g ≫ e)
      infer_instance
  | m + 1, _, _, _, _, e, _, ⟨W, h, w, hw, hh, φ, hg⟩ =>
      ⟨W, h ≫ e, w, hw, isCompositeOfPointBlowupsOfLength_comp_isIso m e hh, φ,
        by rw [hg]; simp only [Category.assoc]⟩

/-- Post-composing a composite of point blow-ups with an isomorphism gives a composite of point
blow-ups. -/
private theorem isCompositeOfPointBlowups_comp_isIso {S' S T : Scheme.{u}} {g : S' ⟶ S}
    (e : S ⟶ T) [IsIso e] (hg : IsCompositeOfPointBlowups g) :
    IsCompositeOfPointBlowups (g ≫ e) :=
  let ⟨m, hm⟩ := hg
  ⟨m, isCompositeOfPointBlowupsOfLength_comp_isIso m e hm⟩

/-- The inductive step: if `S^* → S` is snc over `C` and factors through `S_i` by a composite of
point blow-ups `h`, then `h` factors through the blow-up `σ_i : S_{i+1} → S_i`, again by a
composite of point blow-ups. The centre `p_i` is not snc for the preimage of `C`, so `h` is not
an isomorphism over any neighbourhood of `p_i`. -/
private theorem exists_comp_σ_eq {S Sstar : Scheme.{u}}
    (hSstar : IsRegularSurface Sstar) (C : S.IdealSheafData) {πstar : Sstar ⟶ S}
    (hsnc : IsSNCSubscheme (Scheme.IdealSheafData.vanishingIdeal (C.comap πstar).support))
    (s : PointBlowupSequence S) (hs : s.IsStrongEmbeddedResolution C) {i : ℕ}
    (hi : (i : ℕ∞) < s.length) {h : Sstar ⟶ s.S i} (hh : IsCompositeOfPointBlowups h)
    (hcomp : h ≫ s.π i hi.le = πstar) :
    ∃ h' : Sstar ⟶ s.S (i + 1), IsCompositeOfPointBlowups h' ∧ h' ≫ s.σ i hi = h := by
  have : IsNoetherian Sstar := hSstar.1
  have hiso : ∀ V : (s.S i).Opens, s.p i ∈ V → ¬ IsIso (h ∣_ V) :=
    not_isIso_morphismRestrict_of_not_hasSNCAt C (s.π i hi.le) h hSstar.2.1
      (hcomp ▸ hsnc) (s.p i) (s.isClosed_p i hi) (hs i hi).2
  obtain ⟨h', hh', hfac⟩ := exists_isCompositeOfPointBlowups_comp_blowUpToBase
    hh (s.isClosed_p i hi) hiso
  exact ⟨h' ≫ (s.blowupIso i hi).inv, isCompositeOfPointBlowups_comp_isIso _ hh',
    by rw [hfac, PointBlowupSequence.σ, Category.assoc, Iso.inv_hom_id_assoc]⟩

namespace PointBlowupSequence

/-- If `π* : S* ⟶ S` is a composite of point blow-ups of a regular surface with
`(π*)⁻¹(C)_red` an snc divisor, then for every strong embedded resolution sequence `s` for
`(S, C)` and every finite index `i`, `π*` factors as `h ≫ s.π i` with `h` a composite of point
blow-ups. -/
@[mmp "lem_kr1b_run_dominated_by_snc_model"]
public theorem exists_isCompositeOfPointBlowups_comp_π_eq {S Sstar : Scheme.{u}}
    (hS : IsRegularSurface S) (C : S.IdealSheafData) {πstar : Sstar ⟶ S}
    (hπ : IsCompositeOfPointBlowups πstar)
    (hsnc : IsSNCSubscheme
      (Scheme.IdealSheafData.vanishingIdeal (C.comap πstar).support))
    (s : PointBlowupSequence S) (hs : s.IsStrongEmbeddedResolution C)
    (i : ℕ) (hi : (i : ℕ∞) ≤ s.length) :
    ∃ h : Sstar ⟶ s.S i, IsCompositeOfPointBlowups h ∧ h ≫ s.π i hi = πstar := by
  have hSstar :=
    let ⟨m, hm⟩ := hπ; (isRegularSurface_and_isSNCSubscheme_exceptionalSet m hS hm).1
  induction i with
  | zero => exact ⟨πstar ≫ s.zeroIso.inv, isCompositeOfPointBlowups_comp_isIso _ hπ,
      by simp [PointBlowupSequence.π]⟩
  | succ i ih =>
    have hlt := PointBlowupSequence.coe_lt_of_succ_le hi
    obtain ⟨h, hh, hcomp⟩ := ih hlt.le
    obtain ⟨h', hh', hfac⟩ := exists_comp_σ_eq hSstar C hsnc s hs hlt hh hcomp
    exact ⟨h', hh', by rw [PointBlowupSequence.π, ← Category.assoc, hfac, hcomp]⟩

end PointBlowupSequence

/-! ### The intersection of the birational transform with the exceptional curve -/

section ExceptionalIntersectionDegree

open Polynomial

section Poly

variable {κ : Type*} [Field κ]

private theorem aeval_eq_sum (F : MvPolynomial (Fin 2) κ) (v : Fin 2 → Polynomial κ) :
    MvPolynomial.aeval v F =
      ∑ d ∈ F.support, C (F.coeff d) * (v 0 ^ d 0 * v 1 ^ d 1) := by
  conv_lhs => rw [F.as_sum]
  rw [map_sum]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
    Fin.prod_univ_two]
  rfl

private theorem add_eq_of_mem_support {R : Type*} [CommSemiring R] {F : MvPolynomial (Fin 2) R}
    {m : ℕ}
    (hF : F.IsHomogeneous m) {d : Fin 2 →₀ ℕ} (hd : d ∈ F.support) : d 0 + d 1 = m := by
  have := hF (MvPolynomial.mem_support_iff.mp hd)
  rw [← this, Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp), Fin.sum_univ_two]
  simp

/-- The coefficients of `F(X, 1)` are those of `F(1, Y)` read backwards. -/
private theorem coeff_aeval_X_one {F : MvPolynomial (Fin 2) κ} {m : ℕ} (hF : F.IsHomogeneous m)
    (i : ℕ) : (MvPolynomial.aeval ![(Polynomial.X : Polynomial κ), 1] F).coeff i =
      if i ≤ m then (MvPolynomial.aeval ![(1 : Polynomial κ), Polynomial.X] F).coeff (m - i)
      else 0 := by
  rw [aeval_eq_sum, aeval_eq_sum, finset_sum_coeff, finset_sum_coeff]
  split_ifs with hi
  · refine Finset.sum_congr rfl fun d hd => ?_
    have h := add_eq_of_mem_support hF hd
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, one_pow,
      mul_one, one_mul, coeff_C_mul_X_pow]
    congr 1
    apply propext
    omega
  · refine Finset.sum_eq_zero fun d hd => ?_
    have h := add_eq_of_mem_support hF hd
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, one_pow,
      mul_one, coeff_C_mul_X_pow]
    rw [if_neg (by omega)]

private theorem coeff_aeval_one_X_eq_zero {F : MvPolynomial (Fin 2) κ} {m : ℕ}
    (hF : F.IsHomogeneous m) {j : ℕ} (hj : m < j) :
    (MvPolynomial.aeval ![(1 : Polynomial κ), Polynomial.X] F).coeff j = 0 := by
  rw [aeval_eq_sum, finset_sum_coeff]
  refine Finset.sum_eq_zero fun d hd => ?_
  have h := add_eq_of_mem_support hF hd
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, one_pow,
    one_mul, coeff_C_mul_X_pow]
  rw [if_neg (by omega)]

/-- If `F(X, 1) = X^k u` with `u(0) ≠ 0`, then `deg F(1, Y) + k = m`. -/
private theorem natDegree_add_eq {F : MvPolynomial (Fin 2) κ} {m : ℕ} (hF : F.IsHomogeneous m)
    (h0 : MvPolynomial.aeval ![(1 : Polynomial κ), Polynomial.X] F ≠ 0) {k : ℕ} {u : Polynomial κ}
    (hu : MvPolynomial.aeval ![(Polynomial.X : Polynomial κ), 1] F = Polynomial.X ^ k * u)
    (hu0 : u.coeff 0 ≠ 0) :
    (MvPolynomial.aeval ![(1 : Polynomial κ), Polynomial.X] F).natDegree + k = m := by
  set H₁ := MvPolynomial.aeval ![(1 : Polynomial κ), Polynomial.X] F
  have hc : ∀ i, (Polynomial.X ^ k * u).coeff i = if i ≤ m then H₁.coeff (m - i) else 0 :=
    fun i => by
    rw [← hu]; exact coeff_aeval_X_one hF i
  have hk : k ≤ m := by
    by_contra hkm
    have := hc k
    rw [coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self, if_neg (by omega)] at this
    exact hu0 this
  have hlead : H₁.coeff (m - k) ≠ 0 := by
    have := hc k
    rw [coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self, if_pos hk] at this
    rwa [← this]
  have hle : H₁.natDegree ≤ m - k := by
    rw [natDegree_le_iff_coeff_eq_zero]
    intro j hj
    by_cases hjm : m < j
    · exact coeff_aeval_one_X_eq_zero hF hjm
    · have := hc (m - j)
      rw [coeff_X_pow_mul', if_neg (by omega), if_pos (by omega),
        show m - (m - j) = j by omega] at this
      exact this.symm
  have hge : m - k ≤ H₁.natDegree := le_natDegree_of_ne_zero hlead
  omega

/-- In `κ[X]/(u)` with `u(0) ≠ 0` the class of `X` is a unit. -/
private theorem isUnit_mk_X {u : Polynomial κ} (hu0 : u.coeff 0 ≠ 0) :
    IsUnit (Ideal.Quotient.mk (Ideal.span {u}) Polynomial.X) := by
  refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk _ (-(C (u.coeff 0)⁻¹ * u.divX))) ?_
  rw [← map_mul, ← map_one (Ideal.Quotient.mk (Ideal.span {u})), Ideal.Quotient.eq,
    Ideal.mem_span_singleton]
  refine ⟨-C (u.coeff 0)⁻¹, ?_⟩
  have h := X_mul_divX_add u
  have h1 : C (u.coeff 0)⁻¹ * C (u.coeff 0) = 1 := by rw [← C_mul, inv_mul_cancel₀ hu0, C_1]
  linear_combination (-C (u.coeff 0)⁻¹) * h + h1

/-- The kernel of `κ[X]/(X^k u) → κ[X]/(u)` is killed by `X^k`. -/
private theorem exists_pow_mul_eq_zero {k : ℕ} {u : Polynomial κ}
    (a : Polynomial κ ⧸ Ideal.span {Polynomial.X ^ k * u})
    (ha : Ideal.Quotient.factor (show Ideal.span {Polynomial.X ^ k * u} ≤ Ideal.span {u} from
      Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_left _ _)) a = 0) :
    Ideal.Quotient.mk _ Polynomial.X ^ k * a = 0 := by
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at ha
  obtain ⟨c, rfl⟩ := ha
  rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
  exact ⟨c, by ring⟩

end Poly

/-! ### Finite schemes over a field -/

/-- **A finite scheme over a field is the disjoint union of its local rings**, over an affine
open: the dimension of the sections over `U` is the sum of the dimensions of the stalks at the
points of `U`. The structures are those induced by `σ : K → Γ(X, ⊤)`. -/
private theorem sum_finrank_stalk_eq_finrank {X : Scheme.{u}} {K : Type u} [Field K]
    (σ : K →+* Γ(X, ⊤)) {U : X.Opens} (hU : IsAffineOpen U) (s : Finset X)
    (hs : ∀ z, z ∈ s ↔ z ∈ U)
    (hfin : letI := ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp σ).toAlgebra;
      Module.Finite K Γ(X, U)) :
    ∑ z ∈ s, (letI := ((X.presheaf.germ ⊤ z trivial).hom.comp σ).toAlgebra;
        Module.finrank K (X.presheaf.stalk z)) =
      (letI := ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp σ).toAlgebra;
        Module.finrank K Γ(X, U)) := by
  classical
  letI alg : Algebra K Γ(X, U) :=
    ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp σ).toAlgebra
  haveI : IsArtinianRing Γ(X, U) := IsArtinianRing.of_finite K _
  haveI : Fintype (PrimeSpectrum Γ(X, U)) := Fintype.ofFinite _
  show _ = Module.finrank K Γ(X, U)
  rw [IsArtinianRing.finrank_eq_sum_primeSpectrum (R := Γ(X, U)) K]
  rw [← Finset.sum_coe_sort s]
  let e : s ≃ PrimeSpectrum Γ(X, U) :=
    Equiv.ofBijective (fun z => hU.primeIdealOf ⟨z.1, (hs z.1).1 z.2⟩) (by
      constructor
      · intro z w h
        have h' := congrArg hU.fromSpec h
        simp only [IsAffineOpen.fromSpec_primeIdealOf] at h'
        exact Subtype.ext h'
      · intro P
        have hP : hU.fromSpec P ∈ U := hU.range_fromSpec.le ⟨P, rfl⟩
        refine ⟨⟨hU.fromSpec P, (hs _).2 hP⟩, ?_⟩
        apply hU.fromSpec.isOpenEmbedding.injective
        simp only [IsAffineOpen.fromSpec_primeIdealOf])
  refine Fintype.sum_equiv e _ _ fun z => ?_
  letI := ((X.presheaf.germ ⊤ z.1 trivial).hom.comp σ).toAlgebra
  letI : Algebra Γ(X, U) (X.presheaf.stalk z.1) :=
    (X.presheaf.germ U z.1 ((hs z.1).1 z.2)).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk z.1) (e z).asIdeal :=
    hU.isLocalization_stalk ⟨z.1, (hs z.1).1 z.2⟩
  haveI : IsScalarTower K Γ(X, U) (X.presheaf.stalk z.1) :=
    IsScalarTower.of_algebraMap_eq fun c => by
      change (X.presheaf.germ ⊤ z.1 trivial).hom (σ c) =
        (X.presheaf.germ U z.1 _).hom ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (σ c))
      exact (X.presheaf.germ_res_apply (homOfLE (le_top : U ≤ ⊤)) z.1 _ (σ c)).symm
  exact ((IsLocalization.algEquiv (e z).asIdeal.primeCompl (X.presheaf.stalk z.1)
    (Localization.AtPrime (e z).asIdeal)).restrictScalars K).toLinearEquiv.finrank_eq

/-- A ring isomorphism with `κ[X]/(H)` compatible with `κ` transports finiteness and dimension. -/
private theorem finite_and_finrank_of_ringEquiv {κ : Type u} [Field κ] {A : Type u} [CommRing A]
    [Algebra κ A] {H : Polynomial κ} (hH : H ≠ 0) (ε : A ≃+* Polynomial κ ⧸ Ideal.span {H})
    (hε : ∀ c, ε (algebraMap κ A c) = Ideal.Quotient.mk _ (C c)) :
    Module.Finite κ A ∧ Module.finrank κ A = H.natDegree := by
  let e : A ≃ₐ[κ] Polynomial κ ⧸ Ideal.span {H} := AlgEquiv.ofRingEquiv (f := ε) hε
  haveI : Module.Finite κ (Polynomial κ ⧸ Ideal.span {H}) := (AdjoinRoot.powerBasis hH).finite
  exact ⟨Module.Finite.equiv e.symm.toLinearEquiv,
    e.toLinearEquiv.finrank_eq.trans finrank_quotient_span_eq_natDegree⟩

/-- The points of an affine open with finite-dimensional sections form a finite set of open
points. -/
private theorem finite_and_isOpen_singleton {Z : Scheme.{u}} {κ : Type u} [Field κ]
    {O : Z.Opens} (hO : IsAffineOpen O) [Algebra κ Γ(Z, O)] [Module.Finite κ Γ(Z, O)] :
    (O : Set Z).Finite ∧ ∀ z ∈ O, IsOpen ({z} : Set Z) := by
  haveI : IsArtinianRing Γ(Z, O) := IsArtinianRing.of_finite κ _
  refine ⟨?_, fun z hz => ?_⟩
  · rw [← hO.range_fromSpec]
    exact Set.finite_range _
  · obtain ⟨P, rfl⟩ := hO.range_fromSpec.ge hz
    rw [← Set.image_singleton]
    exact hO.fromSpec.isOpenEmbedding.isOpenMap _
      (@isOpen_discrete _ _ (IsArtinianRing.instDiscreteTopologyPrimeSpectrum Γ(Z, O)) _)

set_option backward.isDefEq.respectTransparency.types false in
/-- **Counting the degree of a finite scheme over a field from two charts.** -/
private theorem isFinite_and_finrank_eq {Z : Scheme.{u}} {κ : Type u} [Field κ]
    (g : Z ⟶ Spec (.of κ)) {O₁ O₂ : Z.Opens} (hO₁ : IsAffineOpen O₁) (hO₂ : IsAffineOpen O₂)
    (hcov : ∀ z : Z, z ∈ O₁ ∨ z ∈ O₂) (t : Γ(Z, O₂))
    (hover : ∀ z, z ∈ Z.basicOpen t ↔ z ∈ O₁ ∧ z ∈ O₂)
    {H₁ H₂ v : Polynomial κ} {k : ℕ} (hH₁ : H₁ ≠ 0) (hH₂ : H₂ = Polynomial.X ^ k * v)
    (hv0 : v.coeff 0 ≠ 0)
    (ε₁ : Γ(Z, O₁) ≃+* Polynomial κ ⧸ Ideal.span {H₁})
    (hε₁ : ∀ c, ε₁ ((Z.presheaf.map (homOfLE (le_top : O₁ ≤ ⊤)).op).hom
        (((Scheme.ΓSpecIso (.of κ)).inv ≫ g.appTop).hom c)) = Ideal.Quotient.mk _ (C c))
    (ε₂ : Γ(Z, O₂) ≃+* Polynomial κ ⧸ Ideal.span {H₂})
    (hε₂ : ∀ c, ε₂ ((Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom
        (((Scheme.ΓSpecIso (.of κ)).inv ≫ g.appTop).hom c)) = Ideal.Quotient.mk _ (C c))
    (hε₂t : ε₂ t = Ideal.Quotient.mk _ Polynomial.X) :
    IsFinite g ∧
      (letI := ((Scheme.ΓSpecIso (.of κ)).inv ≫ g.appTop).hom.toAlgebra;
        Module.finrank κ Γ(Z, ⊤)) = H₁.natDegree + k := by
  classical
  set σ := ((Scheme.ΓSpecIso (.of κ)).inv ≫ g.appTop).hom with hσ
  have hv : v ≠ 0 := fun h => hv0 (by rw [h, coeff_zero])
  have hH₂0 : H₂ ≠ 0 := by rw [hH₂]; exact mul_ne_zero (pow_ne_zero _ X_ne_zero) hv
  -- the two charts
  letI a₁ : Algebra κ Γ(Z, O₁) :=
    ((Z.presheaf.map (homOfLE (le_top : O₁ ≤ ⊤)).op).hom.comp σ).toAlgebra
  letI a₂ : Algebra κ Γ(Z, O₂) :=
    ((Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom.comp σ).toAlgebra
  obtain ⟨hfin₁, hrk₁⟩ := finite_and_finrank_of_ringEquiv hH₁ ε₁ hε₁
  obtain ⟨hfin₂, hrk₂⟩ := finite_and_finrank_of_ringEquiv hH₂0 ε₂ hε₂
  -- the overlap
  set D := Z.basicOpen t
  have hD : IsAffineOpen D := hO₂.basicOpen t
  letI a₃ : Algebra κ Γ(Z, D) :=
    ((Z.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op).hom.comp σ).toAlgebra
  letI : Algebra Γ(Z, O₂) Γ(Z, D) := (Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op).hom.toAlgebra
  haveI : IsLocalization.Away t Γ(Z, D) := hO₂.isLocalization_basicOpen t
  have hle : Ideal.span {H₂} ≤ Ideal.span {v} := by
    rw [hH₂]; exact Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_left _ _)
  set ψ : Γ(Z, O₂) →+* Polynomial κ ⧸ Ideal.span {v} :=
    (Ideal.Quotient.factor hle).comp ε₂.toRingHom
  have hψs : Function.Surjective ψ :=
    (Ideal.Quotient.factor_surjective hle).comp ε₂.surjective
  letI : Algebra Γ(Z, O₂) (Polynomial κ ⧸ Ideal.span {v}) := ψ.toAlgebra
  have hloc : IsLocalization.Away t (Polynomial κ ⧸ Ideal.span {v}) :=
    IsLocalization.Away.of_surjective hψs (by
        change IsUnit (Ideal.Quotient.factor hle (ε₂ t))
        rw [hε₂t, Ideal.Quotient.factor_mk]; exact isUnit_mk_X hv0) k (by
      rintro _ ⟨a, ha, rfl⟩
      refine (Submodule.mem_bot _).2 (ε₂.injective ?_)
      change ε₂ (t ^ k * a) = ε₂ 0
      rw [map_mul, map_pow, hε₂t, map_zero]
      subst hH₂
      exact exists_pow_mul_eq_zero (ε₂ a) ha)
  haveI : IsScalarTower κ Γ(Z, O₂) Γ(Z, D) := IsScalarTower.of_algebraMap_eq fun c => by
    show (Z.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op).hom (σ c) =
      (Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op ≫
        Z.presheaf.map (homOfLE (Z.basicOpen_le t)).op).hom (σ c)
    rw [← Functor.map_comp]; rfl
  haveI : IsScalarTower κ Γ(Z, O₂) (Polynomial κ ⧸ Ideal.span {v}) := IsScalarTower.of_algebraMap_eq
    fun c => by
      show Ideal.Quotient.mk _ (C c) = Ideal.Quotient.factor hle
        (ε₂ ((Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom (σ c)))
      rw [hε₂, Ideal.Quotient.factor_mk]
  let e₃ : Γ(Z, D) ≃ₐ[κ] Polynomial κ ⧸ Ideal.span {v} :=
    (IsLocalization.algEquiv (Submonoid.powers t) Γ(Z, D)
      (Polynomial κ ⧸ Ideal.span {v})).restrictScalars κ
  haveI : Module.Finite κ (Polynomial κ ⧸ Ideal.span {v}) := (AdjoinRoot.powerBasis hv).finite
  haveI hfin₃ : Module.Finite κ Γ(Z, D) := Module.Finite.equiv e₃.symm.toLinearEquiv
  have hrk₃ : Module.finrank κ Γ(Z, D) = v.natDegree :=
    e₃.toLinearEquiv.finrank_eq.trans finrank_quotient_span_eq_natDegree
  -- the points
  obtain ⟨hf₁, ho₁⟩ := finite_and_isOpen_singleton (κ := κ) hO₁
  obtain ⟨hf₂, ho₂⟩ := finite_and_isOpen_singleton (κ := κ) hO₂
  haveI : Finite Z := by
    rw [← Set.finite_univ_iff]
    refine (hf₁.union hf₂).subset fun z _ => hcov z
  haveI : DiscreteTopology Z := discreteTopology_iff_isOpen_singleton.mpr fun z =>
    (hcov z).elim (ho₁ z) (ho₂ z)
  haveI : Fintype Z := Fintype.ofFinite Z
  -- finiteness of the global sections
  letI a₀ : Algebra κ Γ(Z, ⊤) :=
    ((Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom.comp σ).toAlgebra
  let l : Γ(Z, ⊤) →ₗ[κ] Γ(Z, O₁) × Γ(Z, O₂) :=
    { toFun := fun s => ((Z.presheaf.map (homOfLE (le_top : O₁ ≤ ⊤)).op).hom s,
        (Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom s)
      map_add' := fun s s' => by simp
      map_smul' := fun c s => by
        simp only [Algebra.smul_def, map_mul, RingHom.id_apply, Prod.smul_mk]
        refine Prod.ext ?_ ?_
        · change _ * _ = (Z.presheaf.map _).hom (σ c) * _
          congr 1
          show (Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op ≫
            Z.presheaf.map (homOfLE (le_top : O₁ ≤ ⊤)).op).hom (σ c) = _
          rw [← Functor.map_comp]; rfl
        · change _ * _ = (Z.presheaf.map _).hom (σ c) * _
          congr 1
          show (Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op ≫
            Z.presheaf.map (homOfLE (le_top : O₂ ≤ ⊤)).op).hom (σ c) = _
          rw [← Functor.map_comp]; rfl }
  have hl : Function.Injective l := by
    intro s s' h
    exact Z.sheaf.eq_of_locally_eq₂ (homOfLE (le_top : O₁ ≤ ⊤)) (homOfLE (le_top : O₂ ≤ ⊤))
      (fun z _ => hcov z) s s' (congrArg Prod.fst h) (congrArg Prod.snd h)
  haveI hfin₀ : Module.Finite κ Γ(Z, ⊤) := Module.Finite.of_injective l hl
  have hσ0 : (Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom.comp σ = σ := by
    rw [show homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤) = 𝟙 _ from Subsingleton.elim _ _, op_id,
      CategoryTheory.Functor.map_id]
    rfl
  -- sum over the points
  have h0 := sum_finrank_stalk_eq_finrank σ (isAffineOpen_top Z) Finset.univ
    (fun z => ⟨fun _ => trivial, fun _ => Finset.mem_univ z⟩) hfin₀
  have h1 := sum_finrank_stalk_eq_finrank σ hO₁ (Finset.univ.filter (· ∈ O₁)) (fun z => by
    rw [Finset.mem_filter]; exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ z, h⟩⟩) hfin₁
  have h2 := sum_finrank_stalk_eq_finrank σ hO₂ (Finset.univ.filter (· ∈ O₂)) (fun z => by
    rw [Finset.mem_filter]; exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ z, h⟩⟩) hfin₂
  have h3 := sum_finrank_stalk_eq_finrank σ hD ((Finset.univ.filter (· ∈ O₂)).filter (· ∈ O₁))
    (fun z => by
    rw [Finset.mem_filter, Finset.mem_filter, hover]
    exact ⟨fun h => ⟨h.2, h.1.2⟩, fun h => ⟨⟨Finset.mem_univ z, h.2⟩, h.1⟩⟩) hfin₃
  have hsplit := Finset.sum_filter_add_sum_filter_not Finset.univ (· ∈ O₁)
    (fun z => (letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp σ).toAlgebra;
        Module.finrank κ (Z.presheaf.stalk z)))
  have hsplit₂ := Finset.sum_filter_add_sum_filter_not (Finset.univ.filter (· ∈ O₂)) (· ∈ O₁)
    (fun z => (letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp σ).toAlgebra;
        Module.finrank κ (Z.presheaf.stalk z)))
  have hset : (Finset.univ.filter (· ∈ O₂)).filter (· ∉ O₁) = Finset.univ.filter (· ∉ O₁) := by
    ext z
    rw [Finset.mem_filter, Finset.mem_filter, Finset.mem_filter]
    exact ⟨fun h => ⟨Finset.mem_univ z, h.2⟩,
      fun h => ⟨⟨Finset.mem_univ z, (hcov z).resolve_left h.2⟩, h.2⟩⟩
  rw [hset] at hsplit₂
  have hk : H₂.natDegree = k + v.natDegree := by
    rw [hH₂, natDegree_mul (pow_ne_zero _ X_ne_zero) hv, natDegree_X_pow]
  refine ⟨?_, ?_⟩
  · rw [HasAffineProperty.iff_of_isAffine (P := @AlgebraicGeometry.IsFinite)
      (Q := fun X _ f _ ↦ IsAffine X ∧ RingHom.Finite f.appTop.hom)]
    refine ⟨inferInstance, ?_⟩
    have hσf : σ.Finite := by
      rwa [← hσ0]
    have : g.appTop = (Scheme.ΓSpecIso (.of κ)).hom ≫ CommRingCat.ofHom σ := by
      rw [hσ]; simp
    rw [this, CommRingCat.hom_comp]
    exact RingHom.Finite.comp hσf (RingHom.Finite.of_surjective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of κ)).hom).2)
  · change (letI := σ.toAlgebra; Module.finrank κ Γ(Z, ⊤)) = _
    rw [← hσ0, ← h0, ← hsplit, h1, hrk₁]
    have : (∑ z ∈ Finset.univ.filter (· ∉ O₁),
        (letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp σ).toAlgebra;
          Module.finrank κ (Z.presheaf.stalk z))) + v.natDegree = k + v.natDegree := by
      rw [← hk, ← hrk₂, ← h2, ← hsplit₂, h3, hrk₃, add_comm]
    rw [Nat.add_right_cancel this]

private theorem fromSpecResidueField_eq {S : Scheme.{u}} {p : S} {U : S.Opens}
    (hU : IsAffineOpen U) (hpU : p ∈ U) :
    S.fromSpecResidueField p = Spec.map (S.evaluation U p hpU) ≫ hU.fromSpec := by
  rw [Scheme.fromSpecResidueField, ← hU.fromSpecStalk_eq_fromSpecStalk hpU,
    IsAffineOpen.fromSpecStalk, ← Category.assoc, ← Spec.map_comp, Scheme.germ_residue]

/-- The `κ(p)`-structure of a scheme `Z` over `Spec κ(p)` and over `S`, compatible with
`Spec κ(p) → S`, is the residue map: on `ι⁻¹ W` the image of `r̄ ∈ κ(p)` is that of `r`. -/
private theorem res_evaluation_eq {S Z B : Scheme.{u}} {p : S} {U : S.Opens}
    (hU : IsAffineOpen U) (hpU : p ∈ U) (g : Z ⟶ Spec (S.residueField p)) (ι : Z ⟶ B)
    (π : B ⟶ S) (hg : g ≫ S.fromSpecResidueField p = ι ≫ π) (W : B.Opens) (hW : W ≤ π ⁻¹ᵁ U)
    (r : Γ(S, U)) :
    (Z.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ W ≤ ⊤)).op).hom
        (((Scheme.ΓSpecIso _).inv ≫ g.appTop).hom ((S.evaluation U p hpU).hom r)) =
      (ι.app W).hom ((π.appLE U W hW).hom r) := by
  have key : ∀ (φ ψ : Z ⟶ S) (_ : φ = ψ) (e₁ : ι ⁻¹ᵁ W ≤ φ ⁻¹ᵁ U) (e₂ : ι ⁻¹ᵁ W ≤ ψ ⁻¹ᵁ U),
      φ.appLE U (ι ⁻¹ᵁ W) e₁ = ψ.appLE U (ι ⁻¹ᵁ W) e₂ := by
    rintro _ _ rfl _ _; rfl
  have h : ⊤ ≤ S.fromSpecResidueField p ⁻¹ᵁ U := fun z _ => by
    change S.fromSpecResidueField p z ∈ U
    rwa [Scheme.fromSpecResidueField_apply]
  have h1 : (Z.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ W ≤ ⊤)).op).hom
      (((Scheme.ΓSpecIso _).inv ≫ g.appTop).hom ((S.evaluation U p hpU).hom r)) =
      ((S.fromSpecResidueField p).appLE U ⊤ h ≫
        g.appLE ⊤ (ι ⁻¹ᵁ W) (fun _ _ => trivial)).hom r := by
    rw [Stacks.Blowup.appLE_top_of_eq_specMap_fromSpec ⟨U, hU⟩ _
      (fromSpecResidueField_eq hU hpU) h]; rfl
  rw [h1, Scheme.Hom.appLE_comp_appLE g (S.fromSpecResidueField p) U ⊤ (ι ⁻¹ᵁ W) h
      (fun _ _ => trivial), key _ _ hg _ (by
      rw [Scheme.Hom.comp_preimage]; exact Scheme.Hom.preimage_mono ι hW),
    ← Scheme.Hom.appLE_comp_appLE ι π U W (ι ⁻¹ᵁ W) hW le_rfl, Scheme.Hom.appLE_eq_app]
  rfl

/-! ### The blow-up of a point in coordinates -/

/-- The only point of `Spec Γ(S, U)` lying over `p` is `primeIdealOf p`. -/
private theorem preimage_fromSpec_singleton {S : Scheme.{u}} {p : S}
    (c : CoordinateNeighbourhood S p) :
    c.isAffineOpen.fromSpec ⁻¹' ({p} : Set S) = {c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩} := by
  ext q
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  refine ⟨fun hq => c.isAffineOpen.fromSpec.isOpenEmbedding.injective ?_, ?_⟩
  · rw [hq, c.isAffineOpen.fromSpec_primeIdealOf]
  · rintro rfl
    exact c.isAffineOpen.fromSpec_primeIdealOf _

/-- On a coordinate neighbourhood, the ideal of the reduced point is `(x, y)`. -/
private theorem ideal_vanishingIdeal_eq_span {S : Scheme.{u}} {p : S}
    (hp : IsClosed ({p} : Set S)) (c : CoordinateNeighbourhood S p) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ =
      Ideal.span {c.x, c.y} := by
  rw [Scheme.IdealSheafData.vanishingIdeal_ideal, c.span_eq]
  convert PrimeSpectrum.vanishingIdeal_singleton (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩)
    using 2
  exact preimage_fromSpec_singleton c

/-- A nonzero form `F` of degree `m` has `F(1, Y) ≠ 0`. -/
private theorem aeval_one_X_ne_zero {K : Type*} [CommRing K] {F : MvPolynomial (Fin 2) K}
    {m : ℕ} (hF : F.IsHomogeneous m) (h0 : F ≠ 0) :
    MvPolynomial.aeval (![1, Polynomial.X] : Fin 2 → Polynomial K) F ≠ 0 := by
  obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp h0
  intro h
  apply hd
  have hprod : ∀ v : Fin 2 →₀ ℕ,
      (v.prod fun i k => (![1, Polynomial.X] : Fin 2 → Polynomial K) i ^ k) =
        Polynomial.X ^ (v 1) := by
    intro v
    rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _), Fin.prod_univ_two]
    simp
  rw [F.as_sum, map_sum] at h
  simp only [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq, hprod] at h
  have h2 := congrArg (fun P : Polynomial K => P.coeff (d 1)) h
  simp only [Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_zero] at h2
  rw [Finset.sum_eq_single d] at h2
  · simpa using h2
  · intro v hv hvd
    rw [if_neg]
    intro h1
    apply hvd
    have hv' := add_eq_of_mem_support hF hv
    have hd' := add_eq_of_mem_support hF (MvPolynomial.mem_support_iff.mpr hd)
    ext i
    fin_cases i
    · simp; omega
    · simpa using h1.symm
  · intro hdn
    exact absurd (MvPolynomial.notMem_support_iff.mp hdn) hd

/-- The kernel ideal sheaf of `Spec B ⟶ Spec A` induced by `g : A →+* B` is the ideal sheaf
attached to `ker g`. -/
private theorem ker_specMap {A B : Type u} [CommRing A] [CommRing B] (g : A →+* B) :
    (Spec.map (CommRingCat.ofHom g)).ker =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (RingHom.ker g)) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  have h : (Spec.map (CommRingCat.ofHom g)).appTop =
      (Scheme.ΓSpecIso (.of A)).hom ≫ CommRingCat.ofHom g ≫ (Scheme.ΓSpecIso (.of B)).inv := by
    rw [← Category.assoc]
    exact (Iso.eq_comp_inv _).mpr (Scheme.ΓSpecIso_naturality _)
  have hinj : Function.Injective (Scheme.ΓSpecIso (.of B)).inv.hom :=
    (Scheme.ΓSpecIso (.of B)).symm.commRingCatIsoToRingEquiv.injective
  rw [h]
  change RingHom.ker (((Scheme.ΓSpecIso (.of B)).inv.hom.comp g).comp
    (Scheme.ΓSpecIso (.of A)).hom.hom) = _
  rw [RingHom.comp_assoc, RingHom.ker_comp_of_injective _ hinj, ← RingHom.comap_ker]
  exact Stacks.Blowup.comap_inv_eq_map_hom (Scheme.ΓSpecIso (.of A)).symm _

/-- The ideal of `ker (Spec B ⟶ Spec A)` on the top affine open. -/
private theorem ideal_ker_specMap_top {A B : Type u} [CommRing A] [CommRing B] (g : A →+* B) :
    (Spec.map (CommRingCat.ofHom g)).ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (RingHom.ker g) := by
  rw [ker_specMap]
  exact Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _

/-- **Sections of a closed subscheme over a chart.** If an ideal sheaf `K` pulls back along an
open immersion `j : Spec B ⟶ X` with image `W` to the kernel of `Spec` of a surjection
`q : B → T`, then the sections of the closed subscheme of `K` over the preimage of `W` are `T`. -/
private theorem exists_ringEquiv_of_comap_eq {X : Scheme.{u}} (K : X.IdealSheafData)
    {B : CommRingCat.{u}} {T : Type u} [CommRing T] (j : Spec B ⟶ X) [IsOpenImmersion j]
    (W : X.affineOpens) (hW : j ''ᵁ ⊤ = W.1) (hle : ⊤ ≤ j ⁻¹ᵁ W.1) (q : B →+* T)
    (hq : Function.Surjective q)
    (hK : K.comap j = (Spec.map (CommRingCat.ofHom q)).ker) :
    ∃ ε : Γ(K.subscheme, K.subschemeι ⁻¹ᵁ W.1) ≃+* T,
      ∀ s, ε ((K.subschemeι.app W.1).hom s) =
        q ((Scheme.ΓSpecIso B).hom.hom ((j.appLE W.1 ⊤ hle).hom s)) := by
  obtain ⟨W, hWa⟩ := W
  subst hW
  set ψ : Γ(X, j ''ᵁ ⊤) →+* T := q.comp ((Scheme.ΓSpecIso B).hom.hom.comp
    (j.appIso ⊤).hom.hom) with hψ
  have hψs : Function.Surjective ψ := by
    refine hq.comp ((ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso B).hom).2.comp
      (ConcreteCategory.bijective_of_isIso (j.appIso ⊤).hom).2)
  have hker : RingHom.ker ψ = K.ideal ⟨j ''ᵁ ⊤, hWa⟩ := by
    have h1 := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion K j ⟨⊤, isAffineOpen_top _⟩
    rw [hK, ideal_ker_specMap_top] at h1
    ext s
    rw [RingHom.mem_ker]
    have h2 : s ∈ K.ideal ⟨j ''ᵁ ⊤, hWa⟩ ↔ (j.appIso ⊤).hom.hom s ∈
        Ideal.map (Scheme.ΓSpecIso (.of B)).inv.hom (RingHom.ker q) := by
      rw [h1, Ideal.mem_comap, ← CommRingCat.comp_apply, Iso.hom_inv_id]
      rfl
    have h3 : Ideal.map (Scheme.ΓSpecIso (.of B)).inv.hom (RingHom.ker q) =
        (RingHom.ker q).comap (Scheme.ΓSpecIso (.of B)).hom.hom :=
      (Stacks.Blowup.comap_inv_eq_map_hom (Scheme.ΓSpecIso (.of B)).symm _).symm
    rw [h2, h3, Ideal.mem_comap, RingHom.mem_ker]
    rfl
  have hι := K.subschemeι_app_surjective ⟨j ''ᵁ ⊤, hWa⟩
  have hιk := K.ker_subschemeι_app ⟨j ''ᵁ ⊤, hWa⟩
  refine ⟨(RingHom.quotientKerEquivOfSurjective hι).symm.trans
    ((Ideal.quotEquivOfEq (hιk.trans hker.symm)).trans
      (RingHom.quotientKerEquivOfSurjective hψs)), fun s => ?_⟩
  have : (RingHom.quotientKerEquivOfSurjective hι).symm ((K.subschemeι.app (j ''ᵁ ⊤)).hom s) =
      Ideal.Quotient.mk _ s := by
    rw [RingEquiv.symm_apply_eq]; rfl
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, this, Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk, hψ, Scheme.Hom.appIso_hom']
  rfl

/-- Exchanging the coordinates of a coordinate neighbourhood. -/
private def swapCoordinates {S : Scheme.{u}} {p : S}
    (c : CoordinateNeighbourhood S p) : CoordinateNeighbourhood S p where
  U := c.U
  isAffineOpen := c.isAffineOpen
  mem := c.mem
  isDomain := c.isDomain
  x := c.y
  y := c.x
  span_eq := by rw [Set.pair_comm]; exact c.span_eq

/-- A leading term with respect to `y, x` is obtained by exchanging the variables. -/
private theorem isLeadingTerm_swap {A : Type*} [CommRing A] [IsLocalRing A] {x y f : A}
    {F : MvPolynomial (Fin 2) (IsLocalRing.ResidueField A)} (hF : IsLeadingTerm x y f F) :
    IsLeadingTerm y x f (MvPolynomial.rename (Equiv.swap 0 1) F) := by
  obtain ⟨m, hm, hFm, G, hG, hGF, hfG⟩ := hF
  refine ⟨m, hm, hFm.rename_isHomogeneous, MvPolynomial.rename (Equiv.swap 0 1) G,
    hG.rename_isHomogeneous, ?_, ?_⟩
  · rw [MvPolynomial.map_rename, hGF]
  · convert hfG using 2
    rw [MvPolynomial.eval_rename, show (![y, x] ∘ ⇑(Equiv.swap (0 : Fin 2) 1)) = ![x, y] from by
      funext i; fin_cases i <;> rfl]

/-- The evaluation at a closed point of an affine open is surjective. -/
private theorem evaluation_surjective {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    {U : S.Opens} (hU : IsAffineOpen U) (hpU : p ∈ U) :
    Function.Surjective (S.evaluation U p hpU).hom := by
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, hpU⟩ : U)
  have := hU.isLocalization_stalk ⟨p, hpU⟩
  have := hU.primeIdealOf_isMaximal_of_isClosed ⟨p, hpU⟩ hp
  intro k
  obtain ⟨r', hr⟩ := (IsLocalization.AtPrime.equivQuotMaximalIdeal
    (hU.primeIdealOf ⟨p, hpU⟩).asIdeal (S.presheaf.stalk p)).surjective k
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r'
  refine ⟨r, ?_⟩
  rw [← hr]
  rfl
/-- **Sections of `C₁ ∩ E` over the chart `D₊(xt)`**: they are `κ[Y]/(F(1, Y))`, by an
isomorphism sending the image of `r ∈ R` to its residue and `y/x` to `Y`. -/
private theorem exists_ringEquiv_chart {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (f : Γ(S, c.U)) (m : ℕ) (hm : mult ((S.presheaf.germ c.U p c.mem).hom f) = m)
    (F : MvPolynomial (Fin 2) (S.residueField p))
    (hF : IsLeadingTerm ((S.presheaf.germ c.U p c.mem).hom c.x)
      ((S.presheaf.germ c.U p c.mem).hom c.y) ((S.presheaf.germ c.U p c.mem).hom f) F)
    (C : S.IdealSheafData) (hC : C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f})
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩) :
    ∃ ε : Γ((birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme,
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι ⁻¹ᵁ
            (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1) ≃+*
        Polynomial (S.residueField p) ⧸
          Ideal.span {MvPolynomial.aeval ![(1 : Polynomial (S.residueField p)), Polynomial.X] F},
      (∀ r, ε (((birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.app
            (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1).hom
          ((blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).hom r)) =
          Ideal.Quotient.mk _ (Polynomial.C ((S.evaluation c.U p c.mem).hom r))) ∧
      ∀ w, (blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).hom c.x * w =
            (blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).hom c.y →
        ε (((birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.app
            (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
              ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1).hom w) =
          Ideal.Quotient.mk _ (Polynomial.X : Polynomial (S.residueField p)) := by
  obtain ⟨hx', e, he⟩ := CoordinateNeighbourhood.exists_iso_spec_adjoin_div hp hreg hdim c
  obtain ⟨-, hφC, hφX⟩ :=
    CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv
      hp hreg hdim c hx e he
  let φ := CoordinateNeighbourhood.exceptionalChartPolynomialEquiv hp hreg hdim c
  have hK := CoordinateNeighbourhood.comap_birationalTransform_sup_exceptionalIdeal_eq_ker hp hreg
    hdim c f m hm F hF C hC hx e he φ hφC hφX
  have hjW : (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
      ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) ''ᵁ ⊤ =
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1 := by
    rw [Scheme.Hom.image_top_eq_opensRange, Scheme.Hom.opensRange_comp_of_isIso,
      Scheme.Opens.opensRange_ι]
  have hle : ⊤ ≤ (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) ⁻¹ᵁ
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1 :=
    fun z _ => (e.inv z).2
  have hqs : Function.Surjective ((Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.aeval ![1, Polynomial.X] F})).comp
      (φ.symm.toRingHom.comp (Ideal.Quotient.mk _))) :=
    Ideal.Quotient.mk_surjective.comp (φ.symm.surjective.comp Ideal.Quotient.mk_surjective)
  obtain ⟨ε, hε⟩ := exists_ringEquiv_of_comap_eq _
      (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι)
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩) hjW hle _ hqs hK
  have hjπ : (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) ≫
      blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) ≫
      (⟨c.U, c.isAffineOpen⟩ : S.affineOpens).2.fromSpec := by
    rw [Category.assoc, ← he, Iso.inv_hom_id_assoc]
  have key : blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
        ⟨c.x, hx⟩ ≫ (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι).appLE
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1 ⊤ hle ≫ (Scheme.ΓSpecIso _).hom =
      CommRingCat.ofHom (algebraMap Γ(S, c.U) _) := by
    have h2 := Stacks.Blowup.appLE_top_of_eq_specMap_fromSpec
      (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) hjπ
    rw [← Category.assoc, Scheme.Hom.appLE_comp_appLE, h2, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have hR : ∀ r, (Scheme.ΓSpecIso _).hom.hom
      (((e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι).appLE
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1 ⊤ hle).hom
      ((blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
        ⟨c.x, hx⟩).hom r)) = algebraMap Γ(S, c.U) _ r := fun r => by
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, key]
    rfl
  refine ⟨ε, fun r => ?_, fun w hw => ?_⟩
  · refine (hε _).trans ?_
    refine (congrArg (fun t => (Ideal.Quotient.mk (Ideal.span
      {MvPolynomial.aeval ![1, Polynomial.X] F})) (φ.symm (Ideal.Quotient.mk _ t))) (hR r)).trans ?_
    exact congrArg _ ((RingEquiv.symm_apply_eq φ).mpr (hφC r).symm)
  · refine (hε _).trans ?_
    have hz := congrArg (fun t => (Scheme.ΓSpecIso _).hom.hom
      (((e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι).appLE
        (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1 ⊤ hle).hom t)) hw
    simp only [map_mul, hR] at hz
    exact congrArg _ ((RingEquiv.symm_apply_eq φ).mpr (hφX _ hz).symm)

/-- **A coordinate neighbourhood on which `C` is principal.** -/
private theorem exists_coordinateNeighbourhood {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C) :
    ∃ (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U)),
      C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f} ∧
        multAt C p = mult ((S.presheaf.germ c.U p c.mem).hom f) := by
  haveI := hreg
  obtain ⟨D, -, hsub⟩ := hC
  obtain ⟨V, hpV, s, -, -, hZ⟩ := hsub p
  obtain ⟨n, z, hz⟩ := MMP.Mori.exists_isRegularSystemOfParameters (S.presheaf.stalk p)
  have hn : n = 2 := by
    have h := hz.2.symm.trans hdim
    exact_mod_cast h
  subst hn
  letI : Algebra Γ(S, V.1) (S.presheaf.stalk p) := (S.presheaf.germ V.1 p hpV).hom.toAlgebra
  haveI := V.2.isLocalization_stalk ⟨p, hpV⟩
  obtain ⟨⟨a, t⟩, ha⟩ := IsLocalization.mk'_surjective
    (V.2.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl (z 0)
  obtain ⟨⟨b, t'⟩, hb⟩ := IsLocalization.mk'_surjective
    (V.2.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl (z 1)
  have ha' : (S.presheaf.germ V.1 p hpV).hom a =
      z 0 * algebraMap Γ(S, V.1) (S.presheaf.stalk p) t := by
    rw [← ha, IsLocalization.mk'_spec]; rfl
  have hb' : (S.presheaf.germ V.1 p hpV).hom b =
      z 1 * algebraMap Γ(S, V.1) (S.presheaf.stalk p) t' := by
    rw [← hb, IsLocalization.mk'_spec]; rfl
  have hrange : ∀ (w : Fin 2 → S.presheaf.stalk p), Set.range w = {w 0, w 1} := fun w => by
    ext g; simp [Fin.exists_fin_two, eq_comm]
  have hxy : MMP.Mori.IsRegularSystemOfParameters
      ![(S.presheaf.germ V.1 p hpV).hom a, (S.presheaf.germ V.1 p hpV).hom b] := by
    refine ⟨?_, by rw [hdim]; rfl⟩
    rw [hrange, ← hz.1, hrange]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [ha', hb', Ideal.span_insert, Ideal.span_insert,
      Ideal.span_singleton_mul_right_unit (IsLocalization.map_units _ t),
      Ideal.span_singleton_mul_right_unit (IsLocalization.map_units _ t')]
  obtain ⟨c, hUV, -, -⟩ :=
    MMP.Resolution.CoordinateNeighbourhood.exists_of_isRegularSystemOfParameters hp hreg hdim hpV
      a b hxy
  have hUV' : (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) ≤ V := hUV
  have hCf : C.ideal ⟨c.U, c.isAffineOpen⟩ =
      Ideal.span {(S.presheaf.map (homOfLE hUV').op).hom s} := by
    rw [← C.map_ideal hUV', hZ, Ideal.map_span, Set.image_singleton]
  refine ⟨c, _, hCf, ?_⟩
  rw [multAt, IdealSheafData.stalk_eq_map_germ C p ⟨c.U, c.isAffineOpen⟩ c.mem, hCf,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- The germ of a section `f^♯ r` pulled back along `f` is the image of the germ of `r`. -/
private theorem germ_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {W : X.Opens}
    (e : W ≤ f ⁻¹ᵁ U) {z : X} (hz : z ∈ W) (r : Γ(Y, U)) :
    (X.presheaf.germ W z hz).hom ((f.appLE U W e).hom r) =
      f.stalkMap z ((Y.presheaf.germ U (f z) (e hz)).hom r) := by
  rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
  exact (Scheme.Hom.germ_stalkMap_apply f U z (e hz) r).symm

open Stacks.BlowUpChartCover in
/-- **The charts of the blow-up meet.** A point of the standard chart at `a` lies on the
standard chart at `b` as soon as the fraction `b / a` of the affine blow-up algebra avoids its
prime. -/
private theorem mem_chartOpen_chart_of_notMem {X : Scheme.{u}} (I : X.IdealSheafData)
    (V : X.affineOpens) (a b : I.ideal V) (q : PrimeSpectrum (chartRing I V a))
    (hq : affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
        (I.ideal V) (a : Γ(X, V.1)) 1
        ⟨(b : Γ(X, V.1)), by simp⟩ ∉ q.asIdeal) :
    chart I V a q ∈ (chartOpen I V b).1 := by
  let := (reesSituation I).sectionRingGradedRing V.1
  let := (reesSituation I).sectionRingGradingGradedRing V.1
  set z : Spec (.of (HomogeneousLocalization.Away
      ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1)) :=
    Spec.map (CommRingCat.ofHom (reesToAffineBlowupEquiv I V a).toRingHom) q with hzdef
  have hpt : chart I V a q =
      Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) V
        (Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
          (reesDegreeOne I V a).2 Nat.one_pos z) := by
    conv_lhs => rw [Stacks.Blowup.chart_eq_specMap_awayι I V a]
    rfl
  rw [hpt]
  change Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
      (reesDegreeOne I V a).2 Nat.one_pos z ∈
    (Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) V ⁻¹ᵁ
      (chartOpen I V b).1)
  rw [preimage_relativeProjChart_chartOpen I V b]
  change z ∈ (Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
      (reesDegreeOne I V a).2 Nat.one_pos ⁻¹ᵁ
    Proj.basicOpen ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V b).1)
  rw [Proj.awayι_preimage_basicOpen ((reesSituation I).sectionRingGrading V.1)
    (reesDegreeOne I V a).2 Nat.one_pos (reesDegreeOne I V b).2 Nat.one_pos]
  have hlog : HomogeneousLocalization.Away.isLocalizationElem
        (𝒜 := (reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 (reesDegreeOne I V b).2 =
      HomogeneousLocalization.Away.mk ((reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 1 (reesDegreeOne I V b).1
          (by simp) := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, pow_one]
  have heval : reesToAffineBlowupEquiv I V a
      (HomogeneousLocalization.Away.isLocalizationElem
        (𝒜 := (reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 (reesDegreeOne I V b).2) =
      affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
        (I.ideal V) (a : Γ(X, V.1)) 1 ⟨(b : Γ(X, V.1)), by simp⟩ := by
    rw [hlog, Stacks.Blowup.reesToAffineBlowupEquiv_awayMk I V a 1 (reesDegreeOne I V b).1
      (reesDegreeOne I V b).2]
    exact congrArg (affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
      (I.ideal V) (a : Γ(X, V.1)) 1) (Subtype.ext (reesToBase_degreeOne I V b))
  intro hmem
  exact hq (heval ▸ hmem)

/-- **The overlap of two charts of a blow-up**, read on the chart of `b`: it is the locus where
the transition section `a/b` is invertible. -/
private theorem basicOpen_eq_inf {X : Scheme.{u}} (I : X.IdealSheafData) (V : X.affineOpens)
    (a b : I.ideal V) (w : Γ(blowUp I, (blowUpChartOpen I V b).1))
    (hw : (blowUpChartMap I V b).hom b * w = (blowUpChartMap I V b).hom a) :
    (blowUp I).basicOpen w = (blowUpChartOpen I V a).1 ⊓ (blowUpChartOpen I V b).1 := by
  refine le_antisymm (le_inf ?_ (Scheme.basicOpen_le _ _)) ?_
  · -- the chart of `b` meets the chart of `a` where `a/b` is invertible
    intro z hz
    have hzb : z ∈ (blowUpChartOpen I V b).1 := Scheme.basicOpen_le _ _ hz
    obtain ⟨q, -, rfl⟩ := hzb
    have hq : q ∈ blowUpAffineChart I V b ⁻¹ᵁ (blowUp I).basicOpen w := hz
    have hle : (⊤ : (Spec (CommRingCat.of (blowUpAffineChartRing I V b))).Opens) ≤
        blowUpAffineChart I V b ⁻¹ᵁ (blowUpChartOpen I V b).1 :=
      ((blowUpAffineChart I V b).preimage_image_eq ⊤).ge
    set ρ := (Scheme.ΓSpecIso (CommRingCat.of (blowUpAffineChartRing I V b))).hom.hom
      ((blowUpAffineChart I V b).appLE (blowUpChartOpen I V b).1 ⊤ hle w) with hρ
    have hρ' : (blowUpAffineChart I V b).appLE (blowUpChartOpen I V b).1 ⊤ hle w =
        (Scheme.ΓSpecIso (CommRingCat.of (blowUpAffineChartRing I V b))).inv.hom ρ :=
      ((Scheme.ΓSpecIso (CommRingCat.of (blowUpAffineChartRing I V b))).hom_inv_id_apply _).symm
    have h9 : q ∈ (Spec (CommRingCat.of (blowUpAffineChartRing I V b))).basicOpen
        ((blowUpAffineChart I V b).appLE (blowUpChartOpen I V b).1 ⊤ hle w) := by
      rw [Scheme.basicOpen_appLE]; exact ⟨trivial, hq⟩
    rw [hρ', basicOpen_eq_of_affine] at h9
    have hq' : q ∈ PrimeSpectrum.basicOpen ρ := h9
    have hcomp : blowUpChartMap I V b ≫ (blowUpAffineChart I V b).appLE
        (blowUpChartOpen I V b).1 ⊤ hle ≫ (Scheme.ΓSpecIso _).hom =
        CommRingCat.ofHom (algebraMap Γ(X, V.1) (blowUpAffineChartRing I V b)) := by
      have h2 := Stacks.Blowup.appLE_top_of_eq_specMap_fromSpec
        (f := blowUpAffineChart I V b ≫ blowUpToBase I) V
        (CommRingCat.ofHom (algebraMap Γ(X, V.1) (blowUpAffineChartRing I V b)))
        (by rw [blowUpAffineChart_comp_blowUpToBase, V.2.isoSpec_inv_ι])
      rw [← Category.assoc, Scheme.Hom.appLE_comp_appLE, h2, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
    have hfrac : ρ =
        affineBlowupAlgebra.fraction (S := Localization.Away (b : Γ(X, V.1)))
          (I.ideal V) (b : Γ(X, V.1)) 1 ⟨(a : Γ(X, V.1)), by simp⟩ := by
      have hreg := affineBlowup_isRegular (I.ideal V) (b : Γ(X, V.1))
      have hmap : ∀ r, (Scheme.ΓSpecIso (CommRingCat.of (blowUpAffineChartRing I V b))).hom.hom
          ((blowUpAffineChart I V b).appLE (blowUpChartOpen I V b).1 ⊤ hle
            ((blowUpChartMap I V b).hom r)) =
          algebraMap Γ(X, V.1) (blowUpAffineChartRing I V b) r := fun r => by
        rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, hcomp]; rfl
      have h1 := congrArg (fun t => (Scheme.ΓSpecIso (CommRingCat.of
        (blowUpAffineChartRing I V b))).hom.hom
          ((blowUpAffineChart I V b).appLE (blowUpChartOpen I V b).1 ⊤ hle t)) hw
      simp only [map_mul, hmap] at h1
      have h2 := affineBlowupAlgebra.algebraMap_pow_mul_fraction
        (S := Localization.Away (b : Γ(X, V.1))) (I.ideal V) (b : Γ(X, V.1)) 1
        ⟨(a : Γ(X, V.1)), by simp⟩
      rw [pow_one] at h2
      exact hreg.1 (h1.trans h2.symm)
    rw [hfrac] at hq'
    have h6 := mem_chartOpen_chart_of_notMem I V b a q hq'
    have h7 : (Stacks.BlowUpChartCover.chartOpen I V a).1 = (blowUpChartOpen I V a).1 :=
      (Scheme.Hom.image_top_eq_opensRange (blowUpAffineChart I V a)).symm
    rw [h7] at h6
    exact h6
  · -- on the overlap, `a` and `b` generate the same ideal of the local ring
    rintro z ⟨hza, hzb⟩
    rw [Scheme.mem_basicOpen _ _ _ hzb]
    set α := (blowUpToBase I).stalkMap z
      ((X.presheaf.germ V.1 (blowUpToBase I z) (blowUpChartOpen_le I V a hza)).hom a)
    set β := (blowUpToBase I).stalkMap z
      ((X.presheaf.germ V.1 (blowUpToBase I z) (blowUpChartOpen_le I V b hzb)).hom b)
    have hαa : ((blowUp I).presheaf.germ _ z hza).hom ((blowUpChartMap I V a).hom a) = α :=
      germ_appLE _ _ _ _
    have hαb : ((blowUp I).presheaf.germ _ z hzb).hom ((blowUpChartMap I V b).hom a) = α :=
      germ_appLE _ _ _ _
    have hβ : ((blowUp I).presheaf.germ _ z hzb).hom ((blowUpChartMap I V b).hom b) = β :=
      germ_appLE _ _ _ _
    have hspan : Ideal.span {α} = Ideal.span {β} := by
      have h1 := IdealSheafData.stalk_eq_map_germ (exceptionalIdeal I) z (blowUpChartOpen I V a)
        hza
      have h2 := IdealSheafData.stalk_eq_map_germ (exceptionalIdeal I) z (blowUpChartOpen I V b)
        hzb
      rw [ideal_exceptionalIdeal_blowUpChartOpen, Ideal.map_span, Set.image_singleton, hαa]
        at h1
      rw [ideal_exceptionalIdeal_blowUpChartOpen, Ideal.map_span, Set.image_singleton, hβ] at h2
      exact h1.symm.trans h2
    have hα0 : α ∈ nonZeroDivisors ((blowUp I).presheaf.stalk z) := by
      letI : Algebra Γ(blowUp I, (blowUpChartOpen I V a).1) ((blowUp I).presheaf.stalk z) :=
        ((blowUp I).presheaf.germ _ z hza).hom.toAlgebra
      haveI := (blowUpChartOpen I V a).2.isLocalization_stalk ⟨z, hza⟩
      rw [← hαa]
      exact IsLocalization.map_nonZeroDivisors_le
        ((blowUpChartOpen I V a).2.primeIdealOf ⟨z, hza⟩).asIdeal.primeCompl _
        ⟨_, blowUpChartMap_self_mem_nonZeroDivisors I V a, rfl⟩
    have hαβ : β * ((blowUp I).presheaf.germ _ z hzb).hom w = α := by
      rw [← hβ, ← map_mul, hw, hαb]
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hspan.ge (Ideal.mem_span_singleton_self β))
    refine isUnit_iff_exists_inv'.mpr ⟨c, ?_⟩
    have h3 : α * (c * ((blowUp I).presheaf.germ _ z hzb).hom w) = α * 1 := by
      rw [mul_one, ← mul_assoc, mul_comm α, hc, hαβ]
    exact (mul_cancel_left_mem_nonZeroDivisors hα0).mp h3

/-! ### The degree of `C₁ ∩ E` -/

/-- For a closed point `p`, the kernel of `Spec κ(p) → S` is the ideal of the reduced point. -/
private theorem ker_fromSpecResidueField_eq {S : Scheme.{u}} {p : S}
    (hp : IsClosed ({p} : Set S)) :
    (S.fromSpecResidueField p).ker = Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩ := by
  rw [← Scheme.IdealSheafData.map_bot, ← Scheme.nilradical_eq_bot,
    ← Scheme.IdealSheafData.vanishingIdeal_top, Scheme.IdealSheafData.map_vanishingIdeal]
  congr 1
  ext1
  rw [TopologicalSpace.Closeds.coe_closure, TopologicalSpace.Closeds.coe_top, Set.image_univ,
    Scheme.range_fromSpecResidueField, hp.closure_eq]
  rfl

/-- `C₁ ∩ E` maps to `S` through `Spec κ(0)`. -/
private theorem exists_comp_fromSpecResidueField_eq
    {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S)) (C : S.IdealSheafData) :
    ∃ g : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme ⟶
          Spec (.of (S.residueField p)),
      g ≫ S.fromSpecResidueField p =
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) := by
  have : IsClosedImmersion (S.fromSpecResidueField p) :=
    isClosed_singleton_iff_isClosedImmersion.mp hp
  refine ⟨IsClosedImmersion.lift _ _ ?_, IsClosedImmersion.lift_fac _ _ _⟩
  rw [ker_fromSpecResidueField_eq hp, Scheme.Hom.ker_comp, Scheme.IdealSheafData.ker_subschemeι,
    Scheme.IdealSheafData.le_map_iff_comap_le]
  exact le_sup_right

/-- **The exceptional curve lies in the two charts of a coordinate neighbourhood.** -/
private theorem mem_or_mem_of_mem_support {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    (c : CoordinateNeighbourhood S p)
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (hy : c.y ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (z : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hz : z ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    z ∈ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
        ⟨c.x, hx⟩).1 ∨
      z ∈ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.y, hy⟩).1 := by
  have hzp : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) z = p := by
    have h1 : z ∈ ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).comap
        (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))).support := hz
    rw [Scheme.IdealSheafData.support_comap] at h1
    have h2 : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) z ∈
        ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).support : Set S) := h1
    have h3 : ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).support : Set S) = {p} := by
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]; rfl
    rw [h3] at h2
    exact h2
  have hspan : ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ :
      Ideal Γ(S, c.U)) ≤ Ideal.span (Set.range ![c.x, c.y]) := by
    rw [ideal_vanishingIdeal_eq_span hp c]
    exact Ideal.span_mono (by
      rintro w (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩)
  obtain ⟨j, w, hw⟩ := exists_mem_range_blowupChartι
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩ ![c.x, c.y]
    (fun j => by fin_cases j; exacts [hx, hy]) hspan z (by rw [hzp]; exact c.mem)
  fin_cases j
  · exact Or.inl ⟨w, trivial, hw⟩
  · exact Or.inr ⟨w, trivial, hw⟩

/-- The `κ(0)`-structure on `C₁ ∩ E`, read on a chart, is the residue map. -/
private theorem res_eq_algebraMap {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    (c : CoordinateNeighbourhood S p) {Z : Scheme.{u}} (g : Z ⟶ Spec (.of (S.residueField p)))
    (ι : Z ⟶ blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hg : g ≫ S.fromSpecResidueField p =
      ι ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (a : (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    {T : Type u} [CommRing T] (ε : Γ(Z, ι ⁻¹ᵁ (blowUpChartOpen
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩ a).1) ≃+* T)
    (φ : S.residueField p →+* T)
    (hε : ∀ r, ε ((ι.app _).hom ((blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
      ⟨c.U, c.isAffineOpen⟩ a).hom r)) = φ ((S.evaluation c.U p c.mem).hom r))
    (κ₀ : S.residueField p) :
    ε ((Z.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ (blowUpChartOpen
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩ a).1 ≤ ⊤)).op).hom
        (((Scheme.ΓSpecIso (.of (S.residueField p))).inv ≫ g.appTop).hom κ₀)) = φ κ₀ := by
  obtain ⟨r, rfl⟩ := evaluation_surjective hp c.isAffineOpen c.mem κ₀
  exact (congrArg ε (res_evaluation_eq c.isAffineOpen c.mem g ι _ hg _
    (blowUpChartOpen_le _ _ a) r)).trans (hε r)

/-- **Kollár 1.40, the degree computation**: every `κ(0)`-structure `g` on `C₁ ∩ E` over `S` is
finite, of degree `mult₀ C`. -/
private theorem isFinite_and_finrank_eq_of_comp_eq
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C)
    (m : ℕ) (hm : multAt C p = m)
    (g : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme ⟶
          Spec (.of (S.residueField p)))
    (hg : g ≫ S.fromSpecResidueField p =
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :
    IsFinite g ∧
      letI : Algebra (S.residueField p)
          Γ((birationalTransform p hp C ⊔
            exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme, ⊤) :=
        ((Scheme.ΓSpecIso (.of (S.residueField p))).inv ≫ g.appTop).hom.toAlgebra
      Module.finrank (S.residueField p)
          Γ((birationalTransform p hp C ⊔
            exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme, ⊤) =
        m := by
  haveI := hreg
  obtain ⟨c, f, hCf, hmult⟩ := exists_coordinateNeighbourhood hp hreg hdim C hC
  have hm' : mult ((S.presheaf.germ c.U p c.mem).hom f) = m := hmult.symm.trans hm
  have hmax : IsLocalRing.maximalIdeal (S.presheaf.stalk p) =
      Ideal.span {(S.presheaf.germ c.U p c.mem).hom c.x,
        (S.presheaf.germ c.U p c.mem).hom c.y} := by
    let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
    have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal
      (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal, ← c.span_eq, Ideal.map_span,
      Set.image_pair]
    rfl
  obtain ⟨⟨F₀, hF₀, -⟩, hF0⟩ := MMP.Resolution.Kollar.existsUnique_isLeadingTerm hdim hmax
    (f := (S.presheaf.germ c.U p c.mem).hom f) (by rw [hm']; exact ENat.coe_ne_top m)
  obtain ⟨F, hF, hFne⟩ : ∃ F : MvPolynomial (Fin 2) (S.residueField p),
      IsLeadingTerm ((S.presheaf.germ c.U p c.mem).hom c.x)
        ((S.presheaf.germ c.U p c.mem).hom c.y) ((S.presheaf.germ c.U p c.mem).hom f) F ∧
      F ≠ 0 := ⟨F₀, hF₀, hF0 F₀ hF₀⟩
  have hFm : F.IsHomogeneous m := by
    obtain ⟨m', hm'', hFh, -⟩ := hF
    have : (m' : ℕ∞) = m := hm''.symm.trans hm'
    rwa [Nat.cast_inj.mp this] at hFh
  have hJ := ideal_vanishingIdeal_eq_span hp c
  have hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ :=
    hJ ▸ Ideal.subset_span (Set.mem_insert _ _)
  have hy : c.y ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ :=
    hJ ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  obtain ⟨ε₁, hε₁C, -⟩ := exists_ringEquiv_chart hp hreg hdim c f m hm' F hF C hCf hx
  obtain ⟨ε₂, hε₂C, hε₂X⟩ := exists_ringEquiv_chart hp hreg hdim (swapCoordinates c) f m hm' _
    (isLeadingTerm_swap hF) C hCf hy
  -- the transition section `x/y` on the chart of `y`
  obtain ⟨w, hw⟩ := exists_mul_eq_blowUpChartMap_of_mem_pow
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩ ⟨c.y, hy⟩ (n := 1)
    (x := c.x) (by rw [pow_one]; exact hx)
  rw [pow_one] at hw
  have hover := basicOpen_eq_inf (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
    ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩ ⟨c.y, hy⟩ w hw.symm
  -- the polynomials
  have hH₁ := aeval_one_X_ne_zero hFm hFne
  have hren : MvPolynomial.aeval ![(1 : Polynomial (S.residueField p)), Polynomial.X]
      (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) F) =
      MvPolynomial.aeval ![(Polynomial.X : Polynomial (S.residueField p)), 1] F := by
    rw [MvPolynomial.aeval_rename, show (![(1 : Polynomial (S.residueField p)), Polynomial.X] ∘
      ⇑(Equiv.swap (0 : Fin 2) 1)) = ![Polynomial.X, 1] from by funext i; fin_cases i <;> rfl]
  have hH₂0 : MvPolynomial.aeval ![(Polynomial.X : Polynomial (S.residueField p)), 1] F ≠ 0 := by
    intro h0
    apply hH₁
    rw [Polynomial.ext_iff]
    intro j
    rw [coeff_zero]
    by_cases hj : j ≤ m
    · have := coeff_aeval_X_one hFm (m - j)
      rw [h0, coeff_zero, if_pos (Nat.sub_le m j), Nat.sub_sub_self hj] at this
      exact this.symm
    · exact coeff_aeval_one_X_eq_zero hFm (by omega)
  obtain ⟨v, hv, hndvd⟩ := exists_eq_pow_rootMultiplicity_mul_and_not_dvd _ hH₂0 0
  rw [map_zero, sub_zero] at hv hndvd
  have hv0 : v.coeff 0 ≠ 0 := fun h => hndvd (X_dvd_iff.mpr h)
  have hdeg := natDegree_add_eq hFm hH₁ hv hv0
  -- the counting
  have hE := isFinite_and_finrank_eq g
    ((blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
      ⟨c.x, hx⟩).2.preimage _)
    ((blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
      ⟨c.y, hy⟩).2.preimage _)
    (fun z => mem_or_mem_of_mem_support hp c hx hy _
      (Scheme.IdealSheafData.support_antitone le_sup_right
        ((Scheme.IdealSheafData.range_subschemeι _).le ⟨z, rfl⟩)))
    (((birationalTransform p hp C ⊔
      exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.app _).hom w)
    (fun z => by
      rw [← Scheme.preimage_basicOpen, Scheme.Hom.mem_preimage, hover]
      rfl)
    hH₁ (hren.trans hv) hv0 ε₁
    (res_eq_algebraMap hp c g _ hg ⟨c.x, hx⟩ ε₁ (Ideal.Quotient.mk _ |>.comp Polynomial.C) hε₁C)
    ε₂ (res_eq_algebraMap hp c g _ hg ⟨c.y, hy⟩ ε₂ (Ideal.Quotient.mk _ |>.comp Polynomial.C)
      hε₂C)
    (hε₂X w hw.symm)
  rwa [hdeg] at hE

/-- **Kollár, Lemma 1.40.** Let `p` be a closed point of a Noetherian scheme `S` with `𝒪_{S,p}`
a two-dimensional regular local ring, and `C ⊆ S` an effective Cartier divisor with
`mult_p C = m`. Then `C₁ ∩ E`, the intersection of the birational transform of `C` with the
exceptional curve of the blow-up of `p`, is finite over `Spec κ(p)` (compatibly with the maps
to `S`), and `dim_{κ(p)} Γ(C₁ ∩ E, 𝒪) = m`. -/
@[mmp "lem_kr1b_exceptional_intersection_degree"]
public theorem exists_isFinite_finrank_birationalTransform_sup_exceptionalIdeal
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C)
    (m : ℕ) (hm : multAt C p = m) :
    ∃ g : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme ⟶
          Spec (.of (S.residueField p)),
      g ≫ S.fromSpecResidueField p =
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ∧
      IsFinite g ∧
      letI : Algebra (S.residueField p)
          Γ((birationalTransform p hp C ⊔
            exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme, ⊤) :=
        ((Scheme.ΓSpecIso (.of (S.residueField p))).inv ≫ g.appTop).hom.toAlgebra
      Module.finrank (S.residueField p)
          Γ((birationalTransform p hp C ⊔
            exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme, ⊤) =
        m := by
  obtain ⟨g, hg⟩ := exists_comp_fromSpecResidueField_eq hp C
  exact ⟨g, hg, isFinite_and_finrank_eq_of_comp_eq hp hreg hdim C hC m hm g hg⟩

end ExceptionalIntersectionDegree

/-! ### The multiplicities of the birational transform over the centre -/

section SumMultiplicities

open MMP.Intersection

/-- A scheme finite over the spectrum of a field has finitely many points. -/
private theorem finite_univ_of_isFinite {X : Scheme.{u}} {K : Type u} [Field K]
    (g : X ⟶ Spec (.of K)) [IsFinite g] : (Set.univ : Set X).Finite := by
  simpa using g.finite_preimage (s := Set.univ) Set.finite_univ

/-- In a Noetherian local ring a nonzero element has finite order (Krull's intersection
theorem). -/
private theorem idealOrder_span_singleton_ne_top {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {f : R} (hf : f ≠ 0) : idealOrder (Ideal.span {f}) ≠ ⊤ := by
  have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
    (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  obtain ⟨j, hj⟩ : ∃ j : ℕ, f ∉ IsLocalRing.maximalIdeal R ^ j := by
    by_contra h
    push Not at h
    apply hf
    have : f ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal R ^ i := Ideal.mem_iInf.mpr h
    rwa [hK] at this
  refine ne_top_of_le_ne_top (ENat.coe_ne_top j) (iSup₂_le fun i hi => ?_)
  by_contra hlt
  push Not at hlt
  exact hj (Ideal.pow_le_pow_right (by exact_mod_cast hlt.le)
    (hi (Ideal.mem_span_singleton_self f)))

/-- The germ of a section that is a unit in the total quotient ring is a nonzerodivisor. -/
private theorem germ_mem_nonZeroDivisors {X : Scheme.{u}} {U : X.Opens} {x : X} (hx : x ∈ U)
    {s : Γ(X, U)} (hs : IsUnit (toTotalQuotient U s)) :
    X.presheaf.germ U x hx s ∈ nonZeroDivisors (X.presheaf.stalk x) := by
  apply mem_nonZeroDivisors_of_isUnit_stalkToTotalQuotient
  convert hs.map (X.totalQuotientSheaf.presheaf.germ U x hx).hom using 1
  exact TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx X.toTotalQuotientSheaf.hom s

/-- The multiplicity of an effective Cartier divisor at a point with regular local ring is
finite. -/
private theorem multAt_ne_top {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C) :
    multAt C p ≠ ⊤ := by
  have : IsNoetherianRing (S.presheaf.stalk p) := hreg.toIsNoetherian
  obtain ⟨D, -, hsub⟩ := hC
  obtain ⟨U, hpU, s, hs, -, hZ⟩ := hsub p
  rw [multAt, IdealSheafData.stalk_eq_map_germ C p U hpU, hZ, Ideal.map_span, Set.image_singleton]
  exact idealOrder_span_singleton_ne_top (nonZeroDivisors.ne_zero (germ_mem_nonZeroDivisors hpU hs))

/-- The `K`-algebra structure on the stalks of a scheme over `Spec K`, through the global
sections. -/
private noncomputable abbrev stalkAlgebra {X : Scheme.{u}} {K : Type u} [Field K]
    (g : X ⟶ Spec (.of K)) (z : X) : Algebra K (X.presheaf.stalk z) :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ X.presheaf.germ ⊤ z trivial).hom.toAlgebra

/-- A finite scheme over a field is the disjoint union of its local rings: the dimension of its
ring of global sections is the sum of the dimensions of its stalks. -/
private theorem sum_finrank_stalk_eq_finrank_of_isFinite {X : Scheme.{u}} {K : Type u} [Field K]
    (g : X ⟶ Spec (.of K)) [IsFinite g] :
    ∑ z ∈ (finite_univ_of_isFinite g).toFinset,
        (letI := stalkAlgebra g z; Module.finrank K (X.presheaf.stalk z)) =
      (letI : Algebra K Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop).hom.toAlgebra;
        Module.finrank K Γ(X, ⊤)) := by
  classical
  letI alg : Algebra K Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop).hom.toAlgebra
  have : IsAffine X := isAffine_of_isAffineHom g
  have hU := isAffineOpen_top X
  haveI : Module.Finite K Γ(X, ⊤) := by
    have h : g.appTop.hom.Finite := ((isFinite_iff g).mp inferInstance).2 ⊤ (isAffineOpen_top _)
    have h2 : ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop).hom.Finite := by
      rw [CommRingCat.hom_comp]
      exact RingHom.Finite.comp h (RingHom.Finite.of_surjective _
        ((ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of K)).inv).2))
    exact h2
  haveI : IsArtinianRing Γ(X, ⊤) := IsArtinianRing.of_finite K _
  haveI : Fintype (PrimeSpectrum Γ(X, ⊤)) := Fintype.ofFinite _
  haveI : Finite X := Set.finite_univ_iff.mp (finite_univ_of_isFinite g)
  haveI : Fintype X := Fintype.ofFinite X
  show _ = Module.finrank K Γ(X, ⊤)
  rw [IsArtinianRing.finrank_eq_sum_primeSpectrum (R := Γ(X, ⊤)) K]
  let e : X ≃ PrimeSpectrum Γ(X, ⊤) :=
    (Equiv.Set.univ X).symm.trans
      (Equiv.ofBijective _ (ConcreteCategory.bijective_of_isIso hU.isoSpec.hom.base))
  have hfs : (finite_univ_of_isFinite g).toFinset = Finset.univ := by
    ext z
    simp only [Set.Finite.mem_toFinset, Set.mem_univ, Finset.mem_univ]
  rw [hfs]
  refine Fintype.sum_equiv e _ _ fun z => ?_
  letI := stalkAlgebra g z
  letI : Algebra Γ(X, ⊤) (X.presheaf.stalk z) :=
    X.presheaf.algebra_section_stalk (U := ⊤) ⟨z, trivial⟩
  haveI : IsLocalization.AtPrime (X.presheaf.stalk z) (e z).asIdeal :=
    hU.isLocalization_stalk ⟨z, trivial⟩
  haveI : IsScalarTower K Γ(X, ⊤) (X.presheaf.stalk z) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact ((IsLocalization.algEquiv (e z).asIdeal.primeCompl (X.presheaf.stalk z)
    (Localization.AtPrime (e z).asIdeal)).restrictScalars K).toLinearEquiv.finrank_eq

/-! ### Multiplicity and length -/

/-- In a Noetherian local ring `(A, 𝔫)` with `dim A/J ≥ 1`, `𝔫^k ⊄ J + 𝔫^{k+1}`. -/
private lemma not_pow_le_sup_pow_succ {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {J : Ideal A} (hdim : 1 ≤ ringKrullDim (A ⧸ J)) (k : ℕ) :
    ¬ IsLocalRing.maximalIdeal A ^ k ≤ J ⊔ IsLocalRing.maximalIdeal A ^ (k + 1) := by
  intro h
  set B := A ⧸ J
  have hB : Nontrivial B := by
    by_contra hn
    rw [not_nontrivial_iff_subsingleton] at hn
    rw [ringKrullDim_eq_bot_of_subsingleton] at hdim
    exact absurd hdim (by decide)
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  set π := Ideal.Quotient.mk J
  have hm : (IsLocalRing.maximalIdeal A).map π = IsLocalRing.maximalIdeal B :=
    IsLocalRing.map_maximalIdeal_of_surjective π Ideal.Quotient.mk_surjective
  have h' : IsLocalRing.maximalIdeal B ^ k ≤
      IsLocalRing.maximalIdeal B • IsLocalRing.maximalIdeal B ^ k := by
    have := Ideal.map_mono (f := π) h
    rw [Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq, Ideal.map_pow, Ideal.map_pow, hm]
      at this
    rwa [smul_eq_mul, ← pow_succ']
  have hbot : IsLocalRing.maximalIdeal B ^ k = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (IsNoetherian.noetherian _) h'
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
  have : IsArtinianRing B :=
    (isArtinianRing_iff_isNilpotent_maximalIdeal B).mpr ⟨k, hbot⟩
  have h0 : ringKrullDim B = 0 := (ringKrullDimZero_iff_ringKrullDim_eq_zero).mp
    (isArtinianRing_iff_krullDimLE_zero.mp this)
  rw [h0] at hdim
  exact absurd hdim (by decide)

/-- If `dim A/J₂ ≥ 1` and `J₁ ⊆ 𝔫ʲ`, then `j ≤ length_A A/(J₁ + J₂)`: the images of
`𝔫^j ⊆ ⋯ ⊆ 𝔫 ⊆ A` form a strictly increasing chain. -/
private lemma le_length_quotient_of_le_pow {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {J₁ J₂ : Ideal A} (hdim : 1 ≤ ringKrullDim (A ⧸ J₂)) {j : ℕ}
    (hj : J₁ ≤ IsLocalRing.maximalIdeal A ^ j) :
    (j : ℕ∞) ≤ Module.length A (A ⧸ (J₁ ⊔ J₂)) := by
  set J : Ideal A := J₁ ⊔ J₂
  let f : ℕ → Submodule A (A ⧸ J) := fun k =>
    Submodule.map J.mkQ (IsLocalRing.maximalIdeal A ^ k : Ideal A)
  have hstep : ∀ k, k < j → f (k + 1) < f k := by
    intro k hk
    refine lt_of_le_of_ne (Submodule.map_mono (Ideal.pow_le_pow_right k.le_succ)) fun heq => ?_
    have h2 := congrArg (Submodule.comap J.mkQ) heq
    simp only [f, Submodule.comap_map_mkQ] at h2
    refine not_pow_le_sup_pow_succ hdim k ?_
    have hJ : J ≤ J₂ ⊔ IsLocalRing.maximalIdeal A ^ (k + 1) :=
      sup_le ((hj.trans (Ideal.pow_le_pow_right hk)).trans le_sup_right) le_sup_left
    calc IsLocalRing.maximalIdeal A ^ k ≤ J ⊔ IsLocalRing.maximalIdeal A ^ k := le_sup_right
      _ = J ⊔ IsLocalRing.maximalIdeal A ^ (k + 1) := h2.symm
      _ ≤ _ := sup_le hJ le_sup_right
  let p : LTSeries (Submodule A (A ⧸ J)) :=
    { length := j
      toFun := fun i => f (j - i)
      step := fun i => by
        simp only [Fin.coe_castSucc, Fin.val_succ]
        rw [show j - (i : ℕ) = (j - (i + 1)) + 1 by omega]
        exact hstep _ (by omega) }
  have hlast : p.last = ⊤ := by simp [p, f, RelSeries.last]
  rw [Module.length_eq_height, ← hlast]
  exact Order.length_le_height_last (p := p)

/-- **The order of `J₁` is at most the length of `A/(J₁ + (e))`** for `e` in the maximal ideal of
a two-dimensional Noetherian local ring. -/
private lemma idealOrder_le_length {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (hdim : ringKrullDim A = 2) {e : A} (he : e ∈ IsLocalRing.maximalIdeal A) (J₁ : Ideal A) :
    idealOrder J₁ ≤ Module.length A (A ⧸ (J₁ ⊔ Ideal.span {e})) := by
  have hdimB : 1 ≤ ringKrullDim (A ⧸ Ideal.span {e}) := by
    have := Ideal.height_le_ringKrullDim_quotient_add_one (p := IsLocalRing.maximalIdeal A) he
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hdim, ← one_add_one_eq_two] at this
    exact ENat.WithBot.add_le_add_natCast_right_iff.mp this
  exact iSup₂_le fun j hj => le_length_quotient_of_le_pow hdimB hj

/-- The order of `J₁` is at most the length of `T = A/(J₁ + (e))`, for `e` in the maximal ideal
of a two-dimensional Noetherian local ring `A`. -/
private lemma idealOrder_le_length_of_surjective {A T : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] [CommRing T] (φ : A →+* T) (hφ : Function.Surjective φ)
    (hdim : ringKrullDim A = 2) (J₁ : Ideal A) {e : A} (he : e ∈ IsLocalRing.maximalIdeal A)
    (hker : RingHom.ker φ = J₁ ⊔ Ideal.span {e}) :
    idealOrder J₁ ≤ Module.length T T := by
  letI := φ.toAlgebra
  have h := idealOrder_le_length hdim he J₁
  rw [← hker] at h
  exact h.trans_eq
    (((Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A T) hφ).toLinearEquiv
      |>.length_eq).trans (Module.length_eq_of_surjective hφ))

/-! ### The residue fields -/

/-- Evaluation at equal points, through the identification of the residue fields. -/
private theorem residueFieldCongr_evaluation {S : Scheme.{u}} {p' p : S} (h : p' = p)
    {U : S.Opens} (hp' : p' ∈ U) (hp : p ∈ U) (r : Γ(S, U)) :
    (S.residueFieldCongr h).hom ((S.evaluation U p' hp').hom r) = (S.evaluation U p hp).hom r := by
  subst h
  simp

/-- **The residue degree, read on `C₁ ∩ E`.** The degree `[κ(q) : κ(π q)]` of the residue field
of the blow-up at `q = ι z` is the dimension over `κ(0)` of the residue field of the stalk of
`C₁ ∩ E` at `z`. -/
private theorem rank_toENat_eq_finrank {S Z B : Scheme.{u}} {p : S}
    (hp : IsClosed ({p} : Set S)) (g : Z ⟶ Spec (.of (S.residueField p))) [IsFinite g]
    (ι : Z ⟶ B) [IsClosedImmersion ι] (π : B ⟶ S)
    (hg : g ≫ S.fromSpecResidueField p = ι ≫ π) (z : Z) :
    (letI := (π.residueFieldMap (ι z)).hom.toAlgebra;
      (Module.rank (S.residueField (π (ι z))) (B.residueField (ι z))).toENat) =
    ((letI := stalkAlgebra g z;
      Module.finrank (S.residueField p) (IsLocalRing.ResidueField (Z.presheaf.stalk z)) : ℕ) :
        ℕ∞) := by
  have hpq : π (ι z) = p := by
    rw [← Scheme.Hom.comp_apply, ← hg, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  obtain ⟨_, ⟨U, hU, rfl⟩, hpU, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ p) isOpen_univ
  letI := (π.residueFieldMap (ι z)).hom.toAlgebra
  letI := stalkAlgebra g z
  have hkey : ∀ r : Γ(S, U), algebraMap (S.residueField p)
      (IsLocalRing.ResidueField (Z.presheaf.stalk z)) ((S.evaluation U p hpU).hom r) =
      (ι.residueFieldMap z).hom ((π.residueFieldMap (ι z)).hom
        ((S.evaluation U (π (ι z)) (hpq ▸ hpU)).hom r)) := by
    intro r
    have hz : z ∈ ι ⁻¹ᵁ (π ⁻¹ᵁ U) := by
      show π (ι z) ∈ U
      rwa [hpq]
    have h1 := res_evaluation_eq hU hpU g ι π hg (π ⁻¹ᵁ U) le_rfl r
    have h2 := congrArg (Z.presheaf.germ (ι ⁻¹ᵁ (π ⁻¹ᵁ U)) z hz).hom h1
    erw [TopCat.Presheaf.germ_res_apply] at h2
    have hz' : ι z ∈ π ⁻¹ᵁ U := hz
    have h3 := (Scheme.Hom.germ_stalkMap_apply ι (π ⁻¹ᵁ U) z hz'
      ((π.appLE U (π ⁻¹ᵁ U) le_rfl).hom r)).symm
    have h4 := germ_appLE π (le_rfl : π ⁻¹ᵁ U ≤ π ⁻¹ᵁ U) hz' r
    rw [h3, h4] at h2
    rw [IsScalarTower.algebraMap_apply (S.residueField p) (Z.presheaf.stalk z)]
    refine (congrArg (IsLocalRing.residue (Z.presheaf.stalk z)) h2).trans ?_
    rw [← Scheme.germ_residue, CommRingCat.comp_apply,
      ← CommRingCat.comp_apply (S.residue (π (ι z))) (π.residueFieldMap (ι z)),
      Scheme.residue_residueFieldMap, CommRingCat.comp_apply,
      ← CommRingCat.comp_apply (B.residue (ι z)) (ι.residueFieldMap z),
      Scheme.residue_residueFieldMap, CommRingCat.comp_apply]
    rfl
  have hsurj : Function.Surjective (ι.residueFieldMap z).hom := by
    intro w
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective w
    obtain ⟨b, rfl⟩ := ι.stalkMap_surjective z a
    refine ⟨B.residue (ι z) b, ?_⟩
    rw [← CommRingCat.comp_apply, Scheme.residue_residueFieldMap, CommRingCat.comp_apply]
    rfl
  let j : B.residueField (ι z) ≃+ IsLocalRing.ResidueField (Z.presheaf.stalk z) :=
    AddEquiv.ofBijective (ι.residueFieldMap z).hom.toAddMonoidHom
      ⟨(ι.residueFieldMap z).hom.injective, hsurj⟩
  have hrank : Module.rank (S.residueField (π (ι z))) (B.residueField (ι z)) =
      Module.rank (S.residueField p) (IsLocalRing.ResidueField (Z.presheaf.stalk z)) := by
    refine rank_eq_of_equiv_equiv (S.residueFieldCongr hpq).hom j
      (ConcreteCategory.bijective_of_isIso _) fun c w => ?_
    obtain ⟨r, hr⟩ := evaluation_surjective hp hU hpU ((S.residueFieldCongr hpq).hom c)
    have hc : c = (S.evaluation U (π (ι z)) (hpq ▸ hpU)).hom r := by
      apply (ConcreteCategory.bijective_of_isIso (S.residueFieldCongr hpq).hom).1
      rw [← hr, residueFieldCongr_evaluation]
    rw [Algebra.smul_def, Algebra.smul_def, ← hr, hkey, ← hc]
    exact map_mul (ι.residueFieldMap z).hom _ _
  haveI : Module.Finite (S.residueField p) (Z.presheaf.stalk z) :=
    AlgebraicGeometry.finite_stalk_of_isFinite_over_field _ g z
  haveI : Module.Finite (S.residueField p) (IsLocalRing.ResidueField (Z.presheaf.stalk z)) :=
    Module.Finite.of_surjective ((IsScalarTower.toAlgHom (S.residueField p) _ _).toLinearMap)
      IsLocalRing.residue_surjective
  rw [hrank, ← Module.finrank_eq_rank, Cardinal.toENat_nat]

/-- **The local estimate** (Kollár 1.40(2), chart computation). At a point `q` of `C₁ ∩ E`, the
residue degree times `mult_q C₁` is at most the `κ(0)`-dimension of `𝒪_{C₁ ∩ E, q}`: in a chart
`B = R[y/x]` of the blow-up, `A = 𝒪_{B₀S,q}` is regular of dimension two with maximal ideal
`(x, h̃)`, the ideal of `C₁` is `f¹A` with `f¹ ∉ xA`, so
`mult_q C₁ = mult f¹ ≤ length_A A/(f¹, x) = length_A 𝒪_{C₁ ∩ E, q}`, and every composition factor
of `𝒪_{C₁ ∩ E, q}` is `κ(q)`. -/
private theorem residueDegree_mul_multAt_le_finrank_stalk
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C)
    (g : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme ⟶
          Spec (.of (S.residueField p)))
    (hg : g ≫ S.fromSpecResidueField p =
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    [IsFinite g]
    (z : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme) :
    (letI := ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueFieldMap
          ((birationalTransform p hp C ⊔ exceptionalIdeal
            (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base z)).hom.toAlgebra;
        (Module.rank (S.residueField
          ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base
            ((birationalTransform p hp C ⊔ exceptionalIdeal
              (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base z)))
          ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueField
            ((birationalTransform p hp C ⊔ exceptionalIdeal
              (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base z))).toENat) *
        multAt (birationalTransform p hp C)
          ((birationalTransform p hp C ⊔ exceptionalIdeal
            (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base z) ≤
      ((letI := stalkAlgebra g z; Module.finrank (S.residueField p)
        ((birationalTransform p hp C ⊔ exceptionalIdeal
          (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z) : ℕ) :
        ℕ∞) := by
  classical
  haveI := hreg
  letI := stalkAlgebra g z
  -- the dimension of the stalk
  have hfinT := AlgebraicGeometry.finrank_stalk_eq_length_mul_finrank_residueField _ g z
  have hrk := rank_toENat_eq_finrank hp g _ _ hg z
  -- the point `q`
  have hq : (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z ∈
      (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support :=
    Scheme.IdealSheafData.support_antitone le_sup_right
      ((Scheme.IdealSheafData.range_subschemeι _).le ⟨z, rfl⟩)
  have hZ : IsAffine (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme := isAffine_of_isAffineHom g
  haveI := AlgebraicGeometry.isArtinianRing_globalSections_of_isFinite_over_field _ g
  have hzc : IsClosed ({z} : Set (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme) := by
    rw [← (Scheme.homeoOfIso (Scheme.isoSpec _)).isClosed_image, Set.image_singleton]
    exact @isClosed_discrete _ _
      (IsArtinianRing.instDiscreteTopologyPrimeSpectrum _) _
  have hqc := (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.isClosedEmbedding.isClosedMap
    _ hzc
  rw [Set.image_singleton] at hqc
  obtain ⟨hregq, hdim2, -⟩ := isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal p hp
    hreg hdim _ hq
  have hdimq := hdim2 hqc
  -- the stalk of `C₁ ∩ E` is `𝒪_{B₀S,q}/(I_{C₁,q} + (e))`
  obtain ⟨_, ⟨V, hV, rfl⟩, hpV, -⟩ :=
    S.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ((birationalTransform p hp C ⊔ exceptionalIdeal
          (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z))) isOpen_univ
  obtain ⟨a, w, hw⟩ := exists_mem_range_blowupChartι
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨V, hV⟩
    (fun a : (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨V, hV⟩ => (a : Γ(S, V)))
    (fun a => a.2) (fun r hr => Ideal.subset_span ⟨⟨r, hr⟩, rfl⟩) _ hpV
  have hqW : (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z ∈
      (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨V, hV⟩
        a).1 := ⟨w, trivial, hw⟩
  have hJ : RingHom.ker ((birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.stalkMap z).hom =
      IdealSheafData.stalk (birationalTransform p hp C)
        ((birationalTransform p hp C ⊔ exceptionalIdeal
          (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z) ⊔
        Ideal.span {(((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.germ _ _
          hqW).hom ((blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨V, hV⟩
            a).hom (a : Γ(S, V))))} := by
    rw [← IdealSheafData.stalk_ker_of_isClosedImmersion, Scheme.IdealSheafData.ker_subschemeι,
      IdealSheafData.stalk_eq_map_germ _ _ _ hqW, IdealSheafData.stalk_eq_map_germ _ _ _ hqW,
      Scheme.IdealSheafData.ideal_sup, Pi.sup_apply, Ideal.map_sup,
      ideal_exceptionalIdeal_blowUpChartOpen,
      Ideal.map_span, Set.image_singleton]
  -- the length estimate in `𝒪_{B₀S,q}`
  haveI : IsNoetherianRing ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk
      ((birationalTransform p hp C ⊔ exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z)) := hregq.toIsNoetherian
  have hsurj := (birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.stalkMap_surjective z
  have he : ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.germ _ _
      hqW).hom ((blowUpChartMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨V, hV⟩
        a).hom (a : Γ(S, V))) ∈ IsLocalRing.maximalIdeal _ := by
    refine IsLocalRing.le_maximalIdeal (J := RingHom.ker ((birationalTransform p hp C ⊔
      exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.stalkMap z).hom)
      (RingHom.ker_ne_top _) ?_
    rw [hJ]
    exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  have hmult := idealOrder_le_length_of_surjective _ hsurj hdimq
    (IdealSheafData.stalk (birationalTransform p hp C)
      ((birationalTransform p hp C ⊔ exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι z)) he hJ
  -- the dimension count
  haveI : Module.Finite (S.residueField p) ((birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z) :=
    AlgebraicGeometry.finite_stalk_of_isFinite_over_field _ g z
  haveI : IsArtinianRing ((birationalTransform p hp C ⊔ exceptionalIdeal
      (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z) :=
    IsArtinianRing.of_finite (S.residueField p) _
  haveI hnoeth : IsNoetherianRing ((birationalTransform p hp C ⊔ exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z) :=
    ((IsArtinianRing.tfae _ _).out 3 2).mp ‹_›
  have hfl := Module.length_ne_top_iff.mpr
    (isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨hnoeth, inferInstance⟩ :
      IsFiniteLength ((birationalTransform p hp C ⊔ exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z)
        ((birationalTransform p hp C ⊔ exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subscheme.presheaf.stalk z))
  rw [hrk]
  change _ ≤ ((Module.finrank _ _ : ℕ) : ℕ∞)
  rw [hfinT, Nat.cast_mul, ENat.coe_toNat hfl, mul_comm (Module.length _ _)]
  exact mul_le_mul_right hmult _

/-- **Kollár, Lemma 1.40(2), weighted form.** Let `S` be a Noetherian scheme, `p ∈ S` a closed
point with `𝒪_{S,p}` regular of dimension `2`, and `C ⊆ S` an effective Cartier divisor. Then the
intersection of the birational transform `C₁ = MMP.Resolution.birationalTransform p hp C` with
the exceptional curve `E` of the blow-up `π : B_pS → S` has finitely many points, and
`∑_{q ∈ C₁ ∩ E} [κ(q) : κ(p)] · mult_q C₁ ≤ mult_p C`, where `[κ(q) : κ(p)]` is the degree of
`π.residueFieldMap q : κ(π q) → κ(q)`. -/
@[mmp "lem_kr1b_sum_multiplicities_over_point"]
public theorem sum_residueDegree_mul_multAt_birationalTransform_le_multAt
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C) :
    ∃ hfin : (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support.carrier.Finite,
      ∑ q ∈ hfin.toFinset,
          (letI := ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueFieldMap
              q).hom.toAlgebra;
            (Module.rank (S.residueField
              ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base q))
              ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueField q)).toENat) *
            multAt (birationalTransform p hp C) q ≤
        multAt C p := by
  obtain ⟨m, hm⟩ := WithTop.ne_top_iff_exists.mp (multAt_ne_top hreg C hC)
  obtain ⟨g, hg, hgfin, hdeg⟩ :=
    exists_isFinite_finrank_birationalTransform_sup_exceptionalIdeal hp hreg hdim C hC m hm.symm
  have hfin : (birationalTransform p hp C ⊔
      exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support.carrier.Finite := by
    have h := (finite_univ_of_isFinite g).image
      (birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base
    rwa [Set.image_univ, Scheme.IdealSheafData.range_subschemeι] at h
  refine ⟨hfin, ?_⟩
  rw [← hm]
  /- The local estimate at each `q ∈ C₁ ∩ E` (Kollár 1.40(2), chart computation): in a chart
  `B = R[y/x]` of the blow-up, `A = 𝒪_{B₀S,q}` is regular of dimension two with `x` part of a
  regular system of parameters and `f¹ ∉ xA`, so `mult_q C₁ ≤ length_A A/(f¹, x)`, and
  `dim_κ 𝒪_{C₁ ∩ E, q} = [κ(q) : κ] · length_A 𝒪_{C₁ ∩ E, q}`; the stalks sum to `m`. -/
  have key : ∑ q ∈ hfin.toFinset,
          (letI := ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueFieldMap
              q).hom.toAlgebra;
            (Module.rank (S.residueField
              ((blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base q))
              ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).residueField q)).toENat) *
            multAt (birationalTransform p hp C) q ≤ (m : ℕ∞) := by
    classical
    have hset : hfin.toFinset = (finite_univ_of_isFinite g).toFinset.image
        (birationalTransform p hp C ⊔
          exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).subschemeι.base := by
      ext q
      simp only [Set.Finite.mem_toFinset, Finset.mem_image, Set.mem_univ, true_and]
      rw [← Set.mem_range, Scheme.IdealSheafData.range_subschemeι]
      rfl
    rw [hset, Finset.sum_image fun a _ b _ h =>
      (Scheme.IdealSheafData.subschemeι _).isClosedEmbedding.injective h, ← hdeg,
      ← sum_finrank_stalk_eq_finrank_of_isFinite g, Nat.cast_sum]
    exact Finset.sum_le_sum fun z _ =>
      residueDegree_mul_multAt_le_finrank_stalk hp hreg hdim C hC g hg z
  exact key

end SumMultiplicities

end MMP.Resolution

