module

public import MMP.RingTheory.RegularLocalRing.LeadingTerm
public import StacksFrontier.AlgebraicGeometry.HomogeneousQuotient.Basic
public import StacksFrontier.RingTheory.Blowup.Affine

/-!
# The blow-up of a regular point of a surface in coordinates

Let `S` be a Noetherian scheme, `0 ∈ S` a closed point with `𝒪_{S,0}` regular of dimension two,
and `(U = Spec R, x, y)` a coordinate neighbourhood of `0`, so that `R` is a domain and
`(x, y)R = 𝔪₀`. Since `x, y` is a regular sequence, `x ≠ 0` and the blow-up `B₀S` of `0` is
described explicitly over `U`: it is the closed subscheme `V₊(xu - yv)` of `𝐏¹_U`, and its chart
`D₊(xt)` is `Spec R[y/x]` with `R[y/x] ≅ R[Y]/(xY - y)` a subring of the fraction field of `R`.
On this chart the exceptional curve `E` is `V(x)`, with `R[y/x]/x ≅ κ(0)[Y]`. A function `f`
of multiplicity `m` and leading term `F` pulls back to `x^m f¹` with `f¹ ≡ F(1, y/x) mod x`;
consequently the birational transform of `C = V(f)` is `V(f¹)` on the chart, and it meets `E`
in `V(F(1, Y))`. Finally, the multiplicity of `g` is bounded by its intersection length with a
regular curve `e = 0`.

## Main results

* `MMP.Resolution.mult_le_length_quotient_span_pair`: `mult g ≤ length_A A/(g, e)` for a regular
  parameter `e` of a two-dimensional regular local ring `A` and `g ∉ eA`.
* `MMP.Resolution.CoordinateNeighbourhood.surjective_aeval_div_and_ker_eq_span`:
  `R[Y] → R[y/x]`, `Y ↦ y/x`, is surjective with kernel `(xY - y)`.
* `MMP.Resolution.CoordinateNeighbourhood.exists_iso_spec_adjoin_div`: `D₊(xt) ≅ Spec R[y/x]`
  compatibly with the maps to `S`.
* `MMP.Resolution.CoordinateNeighbourhood.ker_blowUpSpecToProjSpace_eq_ker_projMap_quotientMk`:
  the blow-up of `U` is `V₊(xu - yv) ⊆ 𝐏¹_U`.
* `MMP.Resolution.CoordinateNeighbourhood.exceptionalChartPolynomialEquiv`:
  the isomorphism `κ(0)[Y] ≃ R[y/x]/x R[y/x]` induced by `R → R[y/x]` and `Y ↦ y/x`.
* `CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv`:
  `E ∩ D₊(xt) = V(x)`, and the values of `κ(0)[Y] ≃ R[y/x]/x R[y/x]` on constants and `Y`.
* `MMP.Resolution.CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq`: `f = x^m f¹` in `R[y/x]`
  with `f¹ ≡ F(1, y/x) mod x`.
* `MMP.Resolution.CoordinateNeighbourhood.comap_birationalTransform_eq_ker`: the birational
  transform of `C = V(f)` is `V(f¹)` on the chart.
* `MMP.Resolution.CoordinateNeighbourhood.comap_birationalTransform_sup_exceptionalIdeal_eq_ker`:
  the birational transform meets `E ∩ D₊(xt)` in `V(F(1, Y))`.

## Implementation notes

The blow-up is that of the ideal sheaf of the reduced point `{0}` on all of `S`, and `D₊(xt)` is
the standard chart `AlgebraicGeometry.blowUpChartOpen` over the affine open `U` at the section
`x`. The ring `R[y/x]` is the `R`-subalgebra of `FractionRing R` generated by the solutions `z`
of `x z = y`; as `x ≠ 0` the only solution is `y/x`. Being a `U`-isomorphism is compatibility
with the maps to `S`. Closed subschemes are compared through their ideal sheaves, and the
intersection of two closed subschemes is the supremum of the ideal sheaves. An isomorphism
`κ(0)[Y] ≃ R[y/x]/x R[y/x]` is pinned by its values on constants and on `Y`.

For the bound on the multiplicity the source computes `length A/(g, e)` exactly as the order of
`g` in the discrete valuation ring `A/eA`; the inequality needs only that the images of
`𝔫^j ⊆ ⋯ ⊆ 𝔫 ⊆ A` in `A/(g, e)` form a strictly increasing chain, which uses `dim A = 2` and
Nakayama's lemma but neither `e ∉ 𝔫²` nor `g ∉ eA`. The factorisation `f = x^m f¹` follows
Kollár's form `f¹ = f_m(1, y/x) + x r` and does not use the uniqueness of leading terms.

## References

* [Kollár, *Lectures on resolution of singularities*, 1.36, 1.38, 1.40 and 1.40(2)][kollar2007]
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory

namespace MMP.Resolution

/-! ### Coordinate neighbourhoods -/

/-- The first coordinate of a coordinate neighbourhood of a point of dimension `2` is nonzero:
otherwise `𝔪 = (y)` would have height at most one. -/
private theorem CoordinateNeighbourhood.x_ne_zero.{w} {S : Scheme.{w}} [IsNoetherian S] {p : S}
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    c.x ≠ 0 := by
  intro h0
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  have : IsNoetherianRing Γ(S, c.U) :=
    (IsNoetherian.toIsLocallyNoetherian (X := S)).component_noetherian ⟨c.U, c.isAffineOpen⟩
  have h1 := IsLocalization.AtPrime.ringKrullDim_eq_height
    (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal (S.presheaf.stalk p)
  have hspan : (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal = Ideal.span {c.y} := by
    rw [← c.span_eq, h0, Ideal.span_insert, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq]
  have hnu : ¬ IsUnit c.y := fun hu => (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).isPrime.ne_top
    (hspan ▸ Ideal.span_singleton_eq_top.mpr hu)
  have h2 := Ideal.height_span_singleton_le_one hnu
  rw [← hspan] at h2
  have : ringKrullDim (S.presheaf.stalk p) ≤ 1 := by
    rw [h1]
    exact_mod_cast h2
  rw [hdim] at this
  norm_num at this

/-- The only point of `Spec Γ(S, U)` lying over `p` is `primeIdealOf p`. -/
private theorem preimage_fromSpec_singleton.{v} {S : Scheme.{v}} {p : S}
    (c : CoordinateNeighbourhood S p) :
    c.isAffineOpen.fromSpec ⁻¹' ({p} : Set S) = {c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩} := by
  ext q
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  refine ⟨fun hq => c.isAffineOpen.fromSpec.isOpenEmbedding.injective ?_, ?_⟩
  · rw [hq, c.isAffineOpen.fromSpec_primeIdealOf]
  · rintro rfl
    exact c.isAffineOpen.fromSpec_primeIdealOf _

/-- On a coordinate neighbourhood, the ideal of the reduced point is `(x, y)`. -/
private theorem ideal_vanishingIdeal_eq_span.{v} {S : Scheme.{v}} {p : S}
    (hp : IsClosed ({p} : Set S)) (c : CoordinateNeighbourhood S p) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ =
      Ideal.span {c.x, c.y} := by
  rw [Scheme.IdealSheafData.vanishingIdeal_ideal, c.span_eq]
  convert PrimeSpectrum.vanishingIdeal_singleton (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩)
    using 2
  exact preimage_fromSpec_singleton c

/-- The kernel ideal sheaf of `Spec B ⟶ Spec A` induced by `g : A →+* B` is the ideal sheaf
attached to `ker g`. -/
private theorem ker_specMap.{v} {A B : Type v} [CommRing A] [CommRing B] (g : A →+* B) :
    (Spec.map (CommRingCat.ofHom g)).ker =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (RingHom.ker g)) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  have h : (Spec.map (CommRingCat.ofHom g)).appTop =
      (Scheme.ΓSpecIso (.of A)).hom ≫ CommRingCat.ofHom g ≫ (Scheme.ΓSpecIso (.of B)).inv := by
    rw [← Category.assoc]
    exact (Iso.eq_comp_inv _).mpr (Scheme.ΓSpecIso_naturality _)
  have hinj : Function.Injective (Scheme.ΓSpecIso (.of B)).inv.hom :=
    (Scheme.ΓSpecIso (.of B)).symm.commRingCatIsoToRingEquiv.injective
  rw [h]
  change RingHom.ker (((Scheme.ΓSpecIso (.of B)).inv.hom.comp g).comp
    (Scheme.ΓSpecIso (.of A)).hom.hom) = _
  rw [RingHom.comp_assoc, RingHom.ker_comp_of_injective _ hinj, ← RingHom.comap_ker]
  exact Stacks.Blowup.comap_inv_eq_map_hom (Scheme.ΓSpecIso (.of A)).symm _

/-- Let `I` be an ideal sheaf on `Z`, `b : Y ⟶ Z`, and `j : Spec B ⟶ Y` with `j ≫ b` equal to
`Spec B → Spec Γ(Z, U) → Z` for a ring map `φ : Γ(Z, U) → B` and an affine open `U`. If `φ`
extends `I(U)` to `(t)`, then the inverse image of `I` along `j ≫ b` is the closed subscheme
`Spec (B / t)`. -/
private theorem comap_comap_eq_ker_specMap.{v} {Z Y : Scheme.{v}} (I : Z.IdealSheafData)
    (b : Y ⟶ Z) {B : Type v} [CommRing B] (j : Spec (CommRingCat.of B) ⟶ Y) {U : Z.Opens}
    (hU : IsAffineOpen U) (φ : Γ(Z, U) ⟶ CommRingCat.of B)
    (hover : j ≫ b = Spec.map φ ≫ hU.fromSpec)
    {J : Ideal Γ(Z, U)} {t : B} (hspan : J.map φ.hom = Ideal.span {t})
    (hI : I.ideal ⟨U, hU⟩ = J) :
    (I.comap b).comap j =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))).ker := by
  have hb : I.comap hU.fromSpec = Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso Γ(Z, U)).inv.hom J) := by
    apply Scheme.IdealSheafData.ext_of_isAffine
    rw [← hI]
    exact (Stacks.Blowup.ideal_comap_fromSpec_top I ⟨U, hU⟩).trans
      (Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _).symm
  have key : ∀ (T : Scheme.{v}) [IsAffine T] (L : Ideal Γ(T, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop L).ideal ⟨⊤, isAffineOpen_top T⟩ = L :=
    fun _ _ L => Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply L
  rw [← Scheme.IdealSheafData.comap_comp, hover, Scheme.IdealSheafData.comap_comp, hb,
    ker_specMap, Ideal.mk_ker]
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, key, key,
    Stacks.Blowup.map_appTop_map_ΓSpecIso_inv, hspan]

/-! ### Multiplicity and intersection with a regular curve -/

section

open IsLocalRing

/-- In a Noetherian local ring `(A, 𝔫)` with `dim A/eA ≥ 1`, `𝔫^k ⊄ (e) + 𝔫^{k+1}`. -/
private lemma not_pow_le_span_sup_pow_succ {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {e : A} (hdim : 1 ≤ ringKrullDim (A ⧸ Ideal.span {e})) (k : ℕ) :
    ¬ maximalIdeal A ^ k ≤ Ideal.span {e} ⊔ maximalIdeal A ^ (k + 1) := by
  intro h
  set B := A ⧸ Ideal.span {e}
  have hB : Nontrivial B := by
    by_contra hn
    rw [not_nontrivial_iff_subsingleton] at hn
    rw [ringKrullDim_eq_bot_of_subsingleton] at hdim
    exact absurd hdim (by decide)
  have := IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {e}))
    Ideal.Quotient.mk_surjective
  set π := Ideal.Quotient.mk (Ideal.span {e})
  have hm : (maximalIdeal A).map π = maximalIdeal B :=
    IsLocalRing.map_maximalIdeal_of_surjective π Ideal.Quotient.mk_surjective
  have h' : maximalIdeal B ^ k ≤ maximalIdeal B • maximalIdeal B ^ k := by
    have := Ideal.map_mono (f := π) h
    rw [Ideal.map_sup, Ideal.map_span, Set.image_singleton,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self e),
      Ideal.span_singleton_zero,
      bot_sup_eq, Ideal.map_pow, Ideal.map_pow, hm] at this
    rwa [smul_eq_mul, ← pow_succ']
  have hbot : maximalIdeal B ^ k = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (IsNoetherian.noetherian _) h'
      (by rw [jacobson_eq_maximalIdeal ⊥ bot_ne_top])
  have : IsArtinianRing B :=
    (isArtinianRing_iff_isNilpotent_maximalIdeal B).mpr ⟨k, hbot⟩
  have h0 : ringKrullDim B = 0 := (ringKrullDimZero_iff_ringKrullDim_eq_zero).mp
    (isArtinianRing_iff_krullDimLE_zero.mp this)
  rw [h0] at hdim
  exact absurd hdim (by decide)

/-- If `dim A/eA ≥ 1` and `g ∈ 𝔫ʲ`, then `j ≤ length_A A/(g, e)`: the images of
`𝔫^j ⊆ ⋯ ⊆ 𝔫 ⊆ A` in `A/(g, e)` form a strictly increasing chain of length `j`. -/
private lemma le_length_quotient_of_mem_pow {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {e g : A} (hdim : 1 ≤ ringKrullDim (A ⧸ Ideal.span {e})) {j : ℕ}
    (hgj : g ∈ maximalIdeal A ^ j) : (j : ℕ∞) ≤ Module.length A (A ⧸ Ideal.span {g, e}) := by
  set J : Ideal A := Ideal.span {g, e}
  let f : ℕ → Submodule A (A ⧸ J) := fun k =>
    Submodule.map J.mkQ (maximalIdeal A ^ k : Ideal A)
  have hstep : ∀ k, k < j → f (k + 1) < f k := by
    intro k hk
    refine lt_of_le_of_ne (Submodule.map_mono (Ideal.pow_le_pow_right k.le_succ)) fun heq => ?_
    have h2 := congrArg (Submodule.comap J.mkQ) heq
    simp only [f, Submodule.comap_map_mkQ] at h2
    refine not_pow_le_span_sup_pow_succ hdim k ?_
    have hJ : J ≤ Ideal.span {e} ⊔ maximalIdeal A ^ (k + 1) := by
      rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · exact Ideal.mem_sup_right (Ideal.pow_le_pow_right hk hgj)
      · exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    calc maximalIdeal A ^ k ≤ J ⊔ maximalIdeal A ^ k := le_sup_right
      _ = J ⊔ maximalIdeal A ^ (k + 1) := h2.symm
      _ ≤ _ := sup_le hJ le_sup_right
  let p : LTSeries (Submodule A (A ⧸ J)) :=
    { length := j
      toFun := fun i => f (j - i)
      step := fun i => by
        simp only [Fin.coe_castSucc, Fin.val_succ]
        rw [show j - (i : ℕ) = (j - (i + 1)) + 1 by omega]
        exact hstep _ (by omega) }
  have hlast : p.last = ⊤ := by simp [p, f, RelSeries.last]
  rw [Module.length_eq_height, ← hlast]
  exact Order.length_le_height_last (p := p)

/-- In a two-dimensional regular local ring `(A, 𝔫)`, for `e ∈ 𝔫 ∖ 𝔫²` and `g ∉ eA`, the
multiplicity of `g` is at most the length of `A/(g, e)`. -/
@[mmp "lem_kr1b_multiplicity_le_intersection_with_regular_curve"]
public theorem mult_le_length_quotient_span_pair {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) {e g : A} (he : e ∈ maximalIdeal A)
    (he2 : e ∉ maximalIdeal A ^ 2) (hg : g ∉ Ideal.span {e}) :
    mult g ≤ Module.length A (A ⧸ Ideal.span {g, e}) := by
  have hdimB : 1 ≤ ringKrullDim (A ⧸ Ideal.span {e}) := by
    have := Ideal.height_le_ringKrullDim_quotient_add_one (p := maximalIdeal A) he
    rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hdim, ← one_add_one_eq_two] at this
    exact ENat.WithBot.add_le_add_natCast_right_iff.mp this
  exact iSup₂_le fun j hj =>
    le_length_quotient_of_mem_pow hdimB (hj (Ideal.mem_span_singleton_self g))

end

/-! ### The presentation `R[y/x] ≅ R[Y]/(xY - y)` -/

section

open Polynomial

/-- In a regular local ring of dimension two whose maximal ideal is `(a, b)`, `a ≠ 0` and `b` is a
non-zero-divisor modulo `a`. -/
private theorem ne_zero_and_dvd_of_dvd_mul {A : Type*} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) {a b : A}
    (hab : IsLocalRing.maximalIdeal A = Ideal.span {a, b}) :
    a ≠ 0 ∧ ∀ c : A, a ∣ b * c → a ∣ c := by
  have hfin : (IsLocalRing.maximalIdeal A).spanFinrank = 2 := by
    have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hdim] at this
    exact_mod_cast this
  have hof : Ideal.ofList [a, b] = IsLocalRing.maximalIdeal A := by
    rw [hab, Ideal.ofList]
    congr 1
    ext
    simp
  obtain ⟨hreg, -⟩ :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      A).1 [a, b] hof (by simp [hfin])
  rw [RingTheory.Sequence.isRegular_cons_iff, RingTheory.Sequence.isRegular_cons_iff] at hreg
  obtain ⟨ha, hb, -⟩ := hreg
  refine ⟨?_, fun c hc => ?_⟩
  · rintro rfl
    exact one_ne_zero (ha (by simp : (0 : A) • (1 : A) = (0 : A) • (0 : A)))
  · obtain ⟨d, hd⟩ := hc
    have h0 : b • (Submodule.Quotient.mk c : QuotSMulTop a A) =
        b • (0 : QuotSMulTop a A) := by
      rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul, hd]
      exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top
    have h1 := (Submodule.Quotient.mk_eq_zero _).1 (hb h0)
    obtain ⟨e, -, he⟩ := Submodule.mem_smul_pointwise_iff_exists _ _ _ |>.1 h1
    exact ⟨e, by rw [← he, smul_eq_mul]⟩

/-- If `(x, y) = m` is a maximal ideal and `y` is a non-zero-divisor modulo `x` in `R_m`, then `y`
is a non-zero-divisor modulo `x` in `R`. -/
private theorem dvd_of_dvd_mul_of_isLocalization {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] {m : Ideal R} [hm : m.IsMaximal] [IsLocalization.AtPrime A m] {x y : R}
    (hxy : Ideal.span {x, y} = m)
    (h : ∀ c : A, algebraMap R A x ∣ algebraMap R A y * c → algebraMap R A x ∣ c)
    (r : R) (hr : x ∣ y * r) : x ∣ r := by
  by_contra hne
  let J : Ideal R := (Ideal.span {x}).colon (Ideal.span {r})
  have hJ : ∀ s, s ∈ J ↔ x ∣ s * r := fun s => by
    simp [J, Submodule.mem_colon_singleton, Ideal.mem_span_singleton]
  have hJtop : J ≠ ⊤ := fun hJ' => hne (by simpa using (hJ 1).1 (hJ' ▸ Submodule.mem_top))
  obtain ⟨P, hP, hJP⟩ := Ideal.exists_le_maximal J hJtop
  have hmP : m ≤ P := by
    rw [← hxy, Ideal.span_le]
    rintro z (rfl | rfl)
    · exact hJP ((hJ _).2 (dvd_mul_right _ _))
    · exact hJP ((hJ _).2 hr)
  have hPm : P = m := (hm.eq_of_le hP.out.1 hmP).symm
  obtain ⟨d, hd⟩ := hr
  obtain ⟨a, ha⟩ := h (algebraMap R A r) ⟨algebraMap R A d, by rw [← map_mul, hd, map_mul]⟩
  obtain ⟨⟨s, t⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl a
  have hst : algebraMap R A (r * t) = algebraMap R A (x * s) := by
    rw [map_mul, ha, mul_assoc, IsLocalization.mk'_spec, map_mul]
  obtain ⟨u, hu⟩ := (IsLocalization.eq_iff_exists m.primeCompl A).1 hst
  have hut : (u * t : R) ∈ J := (hJ _).2 ⟨u * s, by linear_combination hu⟩
  exact (m.primeCompl.mul_mem u.2 t.2) ((le_of_le_of_eq hJP hPm) hut)

/-- If `x ∣ c yᵏ` and `y` is a non-zero-divisor modulo `x`, then `x ∣ c`. -/
private theorem dvd_of_dvd_mul_pow {R : Type*} [CommMonoid R] {x y : R}
    (hreg : ∀ r, x ∣ y * r → x ∣ r) : ∀ (k : ℕ) (c : R), x ∣ c * y ^ k → x ∣ c
  | 0, c, h => by simpa using h
  | k + 1, c, h => hreg c (by
      have := dvd_of_dvd_mul_pow hreg k (c * y) (by rwa [mul_assoc, ← pow_succ'])
      rwa [mul_comm])

/-- If `y` is a root of `F.scaleRoots x`, i.e. `xⁿ F(y/x) = 0` with `n = deg F`, then `x` divides
the leading term `c yⁿ`. -/
private theorem dvd_leadingCoeff_mul_pow_of_isRoot_scaleRoots {R : Type*} [CommRing R] {F : R[X]}
    {x y : R} (h : (F.scaleRoots x).IsRoot y) : x ∣ F.leadingCoeff * y ^ F.natDegree := by
  have := dvd_term_of_isRoot_of_dvd_terms F.natDegree h fun j hj => by
    rw [coeff_scaleRoots]
    rcases lt_or_gt_of_ne hj with hj | hj
    · exact ((dvd_pow_self _ (by omega)).mul_left _).mul_right _
    · simp [coeff_eq_zero_of_natDegree_lt hj]
  simpa [coeff_scaleRoots_natDegree] using this

/-- If `deg F ≤ n + 1` and the coefficient of `Yⁿ⁺¹` is `x c`, then subtracting `c Yⁿ (xY - y)`
lowers the degree to at most `n`. -/
private theorem natDegree_sub_C_mul_X_pow_mul_le {R : Type*} [CommRing R] {F : R[X]} {n : ℕ}
    {x y c : R} (hF : F.natDegree ≤ n + 1) (hc : F.coeff (n + 1) = x * c) :
    (F - C c * Polynomial.X ^ n * (C x * Polynomial.X - C y)).natDegree ≤ n := by
  have hq : C c * Polynomial.X ^ n * (C x * Polynomial.X - C y) =
      C (x * c) * Polynomial.X ^ (n + 1) - C (c * y) * Polynomial.X ^ n := by
    simp only [C_mul, pow_succ]
    ring
  rw [hq, natDegree_le_iff_coeff_eq_zero]
  intro N hN
  simp only [coeff_sub, coeff_C_mul_X_pow]
  rcases (Nat.succ_le_of_lt hN).eq_or_lt with rfl | hN'
  · simp [hc]
  · simp [coeff_eq_zero_of_natDegree_lt (hF.trans_lt hN'), hN'.ne', hN.ne']

/-- For a domain `R` with fraction field `K`, `x ≠ 0` and `y` a non-zero-divisor modulo `x`, the
kernel of `R[Y] → K`, `Y ↦ y/x`, is `(xY - y)`. -/
private theorem ker_aeval_div_eq_span {R K : Type*} [CommRing R] [IsDomain R] [Field K]
    [Algebra R K] [IsFractionRing R K] {x y : R} (hx : x ≠ 0)
    (hreg : ∀ r, x ∣ y * r → x ∣ r) :
    RingHom.ker (aeval (R := R) (algebraMap R K y / algebraMap R K x)) =
      Ideal.span {C x * Polynomial.X - C y} := by
  set z := algebraMap R K y / algebraMap R K x
  have hinj := IsFractionRing.injective R K
  have hz : algebraMap R K x * z = algebraMap R K y :=
    mul_div_cancel₀ _ ((map_ne_zero_iff _ hinj).2 hx)
  have hlin : aeval z (C x * Polynomial.X - C y) = 0 := by simp [hz]
  refine le_antisymm (fun F hF => ?_) (Ideal.span_le.2 <| by simpa using hlin)
  replace hF := RingHom.mem_ker.1 hF
  induction hd : F.natDegree using Nat.strong_induction_on generalizing F with
  | _ n ih =>
  rcases n with _ | n
  · rw [eq_C_of_natDegree_eq_zero hd] at hF ⊢
    simp [(map_eq_zero_iff _ hinj).1 (by simpa using hF)]
  have hroot : (F.scaleRoots x).IsRoot y := hinj <| by
    rw [map_zero, ← eval₂_hom, ← hz, scaleRoots_eval₂_mul, ← aeval_def, hF, mul_zero]
  obtain ⟨c, hc⟩ :=
    dvd_of_dvd_mul_pow hreg _ _ (dvd_leadingCoeff_mul_pow_of_isRoot_scaleRoots hroot)
  have hle := natDegree_sub_C_mul_X_pow_mul_le (y := y) hd.le (by rwa [← hd])
  have hmem := ih _ (by omega) (F - C c * Polynomial.X ^ n * (C x * Polynomial.X - C y))
    (by simp [hF, hlin]) rfl
  rw [← sub_add_cancel F (C c * Polynomial.X ^ n * (C x * Polynomial.X - C y))]
  exact add_mem hmem (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

/-- The evaluation `R[Y] → R[z]`, `Y ↦ z`, onto the subalgebra generated by `z` is surjective. -/
private theorem surjective_aeval_adjoin_singleton {R A : Type*} [CommRing R] [CommRing A]
    [Algebra R A] (z : A) :
    Function.Surjective
      (aeval (R := R) (⟨z, Algebra.self_mem_adjoin_singleton R z⟩ : Algebra.adjoin R {z})) := by
  rintro ⟨w, hw⟩
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hw
  obtain ⟨F, rfl⟩ := hw
  exact ⟨F, Subtype.ext (by simp [aeval_subalgebra_coe])⟩

/-- For a coordinate neighbourhood `(U = Spec R, x, y)` of a closed point `0` of a Noetherian
scheme with `𝒪_{S,0}` regular of dimension two, the evaluation `R[Y] → R[y/x]`, `Y ↦ y/x`, into
the subalgebra `R[y/x]` of a fraction field `K` of `R` is surjective with kernel `(xY - y)`. -/
@[mmp "lem_kr1b_blowup_chart_presentation"]
public theorem CoordinateNeighbourhood.surjective_aeval_div_and_ker_eq_span
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    [IsRegularLocalRing (S.presheaf.stalk p)] (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : CoordinateNeighbourhood S p) (K : Type u) [Field K] [Algebra Γ(S, C.U) K]
    [IsFractionRing Γ(S, C.U) K] :
    Function.Surjective
        (aeval (R := Γ(S, C.U)) (⟨algebraMap Γ(S, C.U) K C.y / algebraMap Γ(S, C.U) K C.x,
            Algebra.self_mem_adjoin_singleton _ _⟩ :
          Algebra.adjoin Γ(S, C.U) {algebraMap Γ(S, C.U) K C.y / algebraMap Γ(S, C.U) K C.x})) ∧
      RingHom.ker
          (aeval (R := Γ(S, C.U)) (⟨algebraMap Γ(S, C.U) K C.y / algebraMap Γ(S, C.U) K C.x,
              Algebra.self_mem_adjoin_singleton _ _⟩ :
            Algebra.adjoin Γ(S, C.U)
              {algebraMap Γ(S, C.U) K C.y / algebraMap Γ(S, C.U) K C.x})) =
        Ideal.span {Polynomial.C C.x * Polynomial.X - Polynomial.C C.y} := by
  haveI := C.isDomain
  refine ⟨surjective_aeval_adjoin_singleton _, ?_⟩
  set m := (C.isAffineOpen.primeIdealOf ⟨p, C.mem⟩).asIdeal with hm
  haveI : m.IsMaximal := C.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, C.mem⟩ hp
  letI := S.presheaf.algebra_section_stalk ⟨p, C.mem⟩
  haveI : IsLocalization.AtPrime (S.presheaf.stalk p) m :=
    C.isAffineOpen.isLocalization_stalk ⟨p, C.mem⟩
  have hmax : IsLocalRing.maximalIdeal (S.presheaf.stalk p) =
      Ideal.span {algebraMap Γ(S, C.U) _ C.x, algebraMap Γ(S, C.U) _ C.y} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m, hm, ← C.span_eq, Ideal.map_span,
      Set.image_pair]
  obtain ⟨hx0, hloc⟩ := ne_zero_and_dvd_of_dvd_mul hdim hmax
  have hx : C.x ≠ 0 := fun h => hx0 (by rw [h, map_zero])
  have hreg := dvd_of_dvd_mul_of_isLocalization (A := S.presheaf.stalk p) C.span_eq hloc
  rw [← ker_aeval_div_eq_span (K := K) hx hreg]
  ext F
  simp only [RingHom.mem_ker]
  rw [← Subalgebra.coe_eq_zero, aeval_subalgebra_coe]

end

/-! ### The chart `D₊(xt) ≅ Spec R[y/x]` -/

section

open Stacks.Blowup

section Algebra

variable {R : Type*} [CommRing R] {K : Type*} [CommRing K] [Algebra R K] [IsFractionRing R K]

/-- The canonical map `R_x → Q(R)` for a nonzerodivisor `x`. -/
private noncomputable def awayToFrac {x : R} (hx : x ∈ nonZeroDivisors R) :
    Localization.Away x →ₐ[R] K :=
  IsLocalization.liftAlgHom (M := Submonoid.powers x) (f := Algebra.ofId R K) (by
    rintro ⟨_, n, rfl⟩
    simpa using (IsLocalization.map_units K ⟨x, hx⟩).pow n)

private theorem awayToFrac_injective {x : R} (hx : x ∈ nonZeroDivisors R) :
    Function.Injective (awayToFrac (K := K) hx) := by
  rw [injective_iff_map_eq_zero]
  intro w hw
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers x) w
  have h := congrArg (· * awayToFrac (K := K) hx (algebraMap R (Localization.Away x) s)) hw
  simp only [zero_mul] at h
  rw [← map_mul, IsLocalization.mk'_spec, AlgHom.commutes] at h
  rw [IsFractionRing.to_map_eq_zero_iff] at h
  simp [h]

/-- The image of the affine blow-up algebra `R[(x, y)/x] ⊆ R_x` in `Q(R)` is `R[y/x]`. -/
private theorem map_affineBlowupAlgebra {x y : R} (hx : x ∈ nonZeroDivisors R) {J : Ideal R}
    (hJ : J = Ideal.span {x, y}) :
    (affineBlowupAlgebra J x (Localization.Away x)).map (awayToFrac (K := K) hx) =
      Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y} := by
  subst hJ
  have hu : IsUnit (algebraMap R K x) := IsLocalization.map_units K ⟨x, hx⟩
  have hφ : ∀ w : R, awayToFrac (K := K) hx
      (IsLocalization.mk' (Localization.Away x) w ⟨x, Submonoid.mem_powers x⟩) * algebraMap R K x
        = algebraMap R K w := by
    intro w
    rw [← AlgHom.commutes (awayToFrac (K := K) hx), ← map_mul, IsLocalization.mk'_spec_mk,
      AlgHom.commutes]
  rw [affineBlowupAlgebra, AlgHom.map_adjoin]
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨_, ⟨w, hw, rfl⟩, rfl⟩
    obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hw
    set z0 := awayToFrac (K := K) hx
      (IsLocalization.mk' (Localization.Away x) y ⟨x, Submonoid.mem_powers x⟩)
    have hz0 : algebraMap R K x * z0 = algebraMap R K y := by rw [mul_comm]; exact hφ y
    have : awayToFrac (K := K) hx
        (IsLocalization.mk' (Localization.Away x) (a * x + b * y) ⟨x, Submonoid.mem_powers x⟩) =
        algebraMap R K a + algebraMap R K b * z0 := by
      apply hu.mul_right_cancel
      rw [hφ, add_mul, mul_assoc, mul_comm z0, hz0]
      simp [map_add, map_mul]
    rw [this]
    exact Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin hz0))
  · rw [Algebra.adjoin_le_iff]
    intro z hz
    apply Algebra.subset_adjoin
    refine ⟨_, ⟨y, Ideal.subset_span (by simp), rfl⟩, ?_⟩
    apply hu.mul_right_cancel
    rw [hφ, mul_comm, hz]

end Algebra

/-- The chart `D₊(a)` of the blow-up over an affine open `V` is the image of the open immersion
`blowUpAffineChart I V a`. -/
private theorem range_blowUpChartOpen_ι.{w} {X : Scheme.{w}} (I : X.IdealSheafData)
    (V : X.affineOpens) (a : I.ideal V) :
    Set.range (blowUpChartOpen I V a).1.ι = Set.range (blowUpAffineChart I V a) := by
  rw [Scheme.Opens.range_ι, ← Scheme.Hom.coe_opensRange, ← Scheme.Hom.image_top_eq_opensRange]
  rfl

/-- The chart `D₊(a)` over an affine open `V`, read through an algebra isomorphism of its ring
`Γ(V)[I(V)/a]` with `B`, maps to the base through `Spec B → Spec Γ(V) → X`. -/
private theorem blowUpChartOpen_iso_comp.{w} {X : Scheme.{w}} (I : X.IdealSheafData)
    (V : X.affineOpens) (a : I.ideal V) {B : Type w} [CommRing B] [Algebra Γ(X, V.1) B]
    (E : blowUpAffineChartRing I V a ≃ₐ[Γ(X, V.1)] B) :
    (IsOpenImmersion.isoOfRangeEq _ _ (range_blowUpChartOpen_ι I V a)).hom ≫
        (Scheme.Spec.mapIso E.symm.toRingEquiv.toCommRingCatIso.op).hom ≫
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, V.1) B)) ≫ V.2.fromSpec =
      (blowUpChartOpen I V a).1.ι ≫ blowUpToBase I := by
  have h1 : (Scheme.Spec.mapIso E.symm.toRingEquiv.toCommRingCatIso.op).hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, V.1) B)) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, V.1) (blowUpAffineChartRing I V a))) := by
    change Spec.map _ ≫ _ = _
    rw [← Spec.map_comp]
    congr 1
    ext r
    exact congrArg Subtype.val (E.symm.commutes r)
  rw [reassoc_of% h1, ← V.2.isoSpec_inv_ι, ← blowUpAffineChart_comp_blowUpToBase,
    IsOpenImmersion.isoOfRangeEq_hom_fac_assoc]

/-- **The chart `D₊(xt)` of a point blow-up is `Spec R[y/x]`** (Kollár 1.36). Let `S` be a
Noetherian scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension `2`, and
`c = (U = Spec R, x, y)` a coordinate neighbourhood of `p`. Then `x` is a section over `U` of the
ideal sheaf `I₀` of the reduced point, and the standard chart `D₊(xt)` of the blow-up of `I₀`
at `x` is isomorphic to `Spec R[y/x]`, `R[y/x] ⊆ Frac R`, compatibly with the maps to `S`. -/
@[mmp "lem_kr1b_blowup_charts"]
public theorem CoordinateNeighbourhood.exists_iso_spec_adjoin_div {S : Scheme.{u}}
    [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    ∃ (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal
          ⟨c.U, c.isAffineOpen⟩)
      (e : (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.toScheme ≅
        Spec (CommRingCat.of (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}))),
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) ≫
          c.isAffineOpen.fromSpec =
        (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) := by
  have := c.isDomain
  set I := Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩
  have hJ := ideal_vanishingIdeal_eq_span hp c
  have hx : c.x ∈ I.ideal ⟨c.U, c.isAffineOpen⟩ := hJ ▸ Ideal.subset_span (Set.mem_insert _ _)
  have hx0 : c.x ∈ nonZeroDivisors Γ(S, c.U) :=
    mem_nonZeroDivisors_of_ne_zero (c.x_ne_zero hdim)
  refine ⟨hx, ?_⟩
  set V : S.affineOpens := ⟨c.U, c.isAffineOpen⟩
  set a : I.ideal V := ⟨c.x, hx⟩
  let E : blowUpAffineChartRing I V a ≃ₐ[Γ(S, c.U)] Algebra.adjoin Γ(S, c.U)
      {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y} :=
    (Subalgebra.equivMapOfInjective _ _ (awayToFrac_injective hx0)).trans
      (Subalgebra.equivOfEq _ _ (map_affineBlowupAlgebra hx0 hJ))
  exact ⟨IsOpenImmersion.isoOfRangeEq _ _ (range_blowUpChartOpen_ι I V a) ≪≫
    Scheme.Spec.mapIso E.symm.toRingEquiv.toCommRingCatIso.op, blowUpChartOpen_iso_comp I V a E⟩

end

/-! ### The equation `xu - yv` of the blow-up -/

section

open MvPolynomial RingTheory.Sequence

attribute [local instance] MvPolynomial.gradedAlgebra

/-- A surjection of graded rings is surjective in each degree: a homogeneous element of degree `i`
of the target is the image of an element of degree `i` of the source. -/
private theorem exists_mem_eq_of_surjective {σ τ A B : Type*} [CommRing A] [CommRing B]
    [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
    {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
    (hf : Function.Surjective f) {i : ℕ} {b : B} (hb : b ∈ ℬ i) : ∃ a ∈ 𝒜 i, f a = b := by
  obtain ⟨a, rfl⟩ := hf b
  refine ⟨DirectSum.decompose 𝒜 a i, SetLike.coe_mem _, ?_⟩
  rw [GradedRingHom.map_directSumDecompose]
  exact DirectSum.decompose_of_mem_same ℬ hb

/-- Two surjections of graded rings with the same kernel induce closed immersions of projective
spectra with the same ideal sheaf. -/
private theorem ker_projMap_eq_of_ker_eq.{w} {σ τ υ A B C : Type w} [CommRing A] [CommRing B]
    [CommRing C] [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
    [SetLike υ C] [AddSubgroupClass υ C] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} {𝒞 : ℕ → υ} [GradedRing 𝒜]
    [GradedRing ℬ] [GradedRing 𝒞] (f : 𝒜 →+*ᵍ ℬ) (g : 𝒜 →+*ᵍ 𝒞)
    (hf : Function.Surjective f) (hg : Function.Surjective g)
    (h : RingHom.ker (f : A →+* B) = RingHom.ker (g : A →+* C))
    (hirrf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (hirrg : HomogeneousIdeal.irrelevant 𝒞 ≤ (HomogeneousIdeal.irrelevant 𝒜).map g) :
    (Proj.map f hirrf).ker = (Proj.map g hirrg).ker := by
  let e : B ≃+* C := (RingHom.quotientKerEquivOfSurjective hf).symm.trans
    ((Ideal.quotEquivOfEq h).trans (RingHom.quotientKerEquivOfSurjective hg))
  have he : ∀ a, e (f a) = g a := fun a ↦ by
    have h₁ : (RingHom.quotientKerEquivOfSurjective hf).symm (f a) = Ideal.Quotient.mk _ a :=
      (RingEquiv.symm_apply_eq _).2 rfl
    change (RingHom.quotientKerEquivOfSurjective hg)
      (Ideal.quotEquivOfEq h ((RingHom.quotientKerEquivOfSurjective hf).symm (f a))) = g a
    rw [h₁]
    rfl
  have he' : ∀ a, e.symm (g a) = f a := fun a ↦ (RingEquiv.symm_apply_eq _).2 (he a).symm
  let φ : ℬ →+*ᵍ 𝒞 :=
    { toRingHom := e.toRingHom
      map_mem := fun {i b} hb ↦ by
        obtain ⟨a, ha, rfl⟩ := exists_mem_eq_of_surjective f hf hb
        exact (he a).symm ▸ g.map_mem ha }
  let ψ : 𝒞 →+*ᵍ ℬ :=
    { toRingHom := e.symm.toRingHom
      map_mem := fun {i c} hc ↦ by
        obtain ⟨a, ha, rfl⟩ := exists_mem_eq_of_surjective g hg hc
        exact (he' a).symm ▸ f.map_mem ha }
  have hψφ : ψ.comp φ = GradedRingHom.id ℬ := GradedRingHom.ext fun b ↦ e.symm_apply_apply b
  have hφψ : φ.comp ψ = GradedRingHom.id 𝒞 := GradedRingHom.ext fun c ↦ e.apply_symm_apply c
  have hφ := Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id hφψ
  have hψ := Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id hψφ
  haveI := Proj.isIso_map hφ hψ hψφ hφψ
  have key : ∀ (k : 𝒜 →+*ᵍ 𝒞), k = g → ∀ hk, (Proj.map k hk).ker = (Proj.map g hirrg).ker := by
    rintro _ rfl _
    rfl
  rw [← key (φ.comp f) (GradedRingHom.ext he) (HomogeneousIdeal.irrelevant_le_map_comp hirrf hφ),
    Proj.map_comp, Scheme.Hom.ker_comp_of_isIso]

/-- Over a domain `R` with fraction field `K`, if `(x, y) ≠ R` and the evaluation
`R[Y] → R[y/x]`, `Y ↦ y/x`, has kernel `(xY - y)`, then `y, x` is a weakly regular sequence. -/
private theorem isWeaklyRegular_of_ker_aeval_div {R K : Type*} [CommRing R] [IsDomain R] [Field K]
    [Algebra R K] [IsFractionRing R K] {x y : R} (hxy : Ideal.span {x, y} ≠ ⊤)
    (hker : RingHom.ker (Polynomial.aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
        Algebra.self_mem_adjoin_singleton _ _⟩ :
          Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) =
      Ideal.span {Polynomial.C x * Polynomial.X - Polynomial.C y}) :
    IsWeaklyRegular R [y, x] := by
  have hX : (Polynomial.X : Polynomial R) ∈ RingHom.ker (Polynomial.aeval (R := R)
      (⟨algebraMap R K y / algebraMap R K x, Algebra.self_mem_adjoin_singleton _ _⟩ :
        Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) ↔
      algebraMap R K y / algebraMap R K x = 0 := by
    rw [RingHom.mem_ker, Polynomial.aeval_X, ← Subalgebra.coe_eq_zero]
  have hx : x ≠ 0 := by
    intro h0
    have hX0 := hX.2 (by simp [h0])
    rw [hker, h0, map_zero, zero_mul, zero_sub, Ideal.span_singleton_neg,
      Ideal.mem_span_singleton'] at hX0
    obtain ⟨g, hg⟩ := hX0
    have h1 := congrArg (fun q : Polynomial R ↦ q.coeff 1) hg
    simp only [Polynomial.coeff_mul_C, Polynomial.coeff_X_one] at h1
    exact hxy (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
      (IsUnit.of_mul_eq_one_right _ h1))
  have hy : y ≠ 0 := by
    intro h0
    have hX0 := hX.2 (by simp [h0])
    rw [hker, h0, map_zero, sub_zero, Ideal.mem_span_singleton'] at hX0
    obtain ⟨g, hg⟩ := hX0
    have h1 := congrArg (fun q : Polynomial R ↦ q.coeff 1) hg
    simp only [← mul_assoc, Polynomial.coeff_mul_X, Polynomial.coeff_mul_C,
      Polynomial.coeff_X_one] at h1
    exact hxy (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span (Set.mem_insert _ _))
      (IsUnit.of_mul_eq_one_right _ h1))
  rw [isWeaklyRegular_cons_iff, isWeaklyRegular_singleton_iff]
  refine ⟨fun a b h ↦ mul_left_cancel₀ hy h, ?_⟩
  refine (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).2 fun d hd ↦ ?_
  obtain ⟨e, -, he⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hd
  obtain ⟨f, rfl⟩ : y ∣ d := by
    have hx' : algebraMap R K x ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective R K)).2 hx
    have hmem : Polynomial.C e * Polynomial.X - Polynomial.C d ∈ RingHom.ker
        (Polynomial.aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
          Algebra.self_mem_adjoin_singleton _ _⟩ :
            Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) := by
      rw [RingHom.mem_ker]
      apply Subtype.ext
      have he' := congrArg (algebraMap R K) he
      simp only [smul_eq_mul, map_mul] at he'
      simp only [map_sub, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
        Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ZeroMemClass.coe_zero]
      field_simp
      rw [mul_comm, he', mul_comm]
      ring
    rw [hker, Ideal.mem_span_singleton'] at hmem
    obtain ⟨g, hg⟩ := hmem
    have hrel : (Polynomial.C x * Polynomial.X - Polynomial.C y).natDegree = 1 := by
      rw [Polynomial.natDegree_sub_C, Polynomial.natDegree_C_mul_X _ hx]
    have hrel0 : Polynomial.C x * Polynomial.X - Polynomial.C y ≠ 0 :=
      Polynomial.ne_zero_of_natDegree_gt (n := 0) (by omega)
    by_cases hg0 : g = 0
    · have h0 := congrArg (fun q : Polynomial R ↦ q.coeff 0) hg
      simp [hg0] at h0
      simp [h0]
    · have hdeg := congrArg Polynomial.natDegree hg
      rw [Polynomial.natDegree_mul hg0 hrel0, hrel] at hdeg
      have hle : (Polynomial.C e * Polynomial.X - Polynomial.C d).natDegree ≤ 1 := by
        compute_degree
      have hg' := Polynomial.eq_C_of_natDegree_eq_zero (p := g) (by omega)
      rw [hg'] at hg
      have h0 := congrArg (fun q : Polynomial R ↦ q.coeff 0) hg
      simp at h0
      exact ⟨g.coeff 0, by rw [← h0, mul_comm]⟩
  exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top

/-- For a coordinate neighbourhood `(U = Spec R, x, y)` of a closed point with regular local ring
of dimension two, `y, x` is a weakly regular sequence in `R`. -/
private theorem isWeaklyRegular_y_x.{v} {S : Scheme.{v}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) [IsRegularLocalRing (S.presheaf.stalk p)]
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    IsWeaklyRegular Γ(S, c.U) [c.y, c.x] := by
  haveI := c.isDomain
  letI : Field (FractionRing Γ(S, c.U)) := FractionRing.field _
  refine isWeaklyRegular_of_ker_aeval_div (K := FractionRing Γ(S, c.U)) ?_
    (MMP.Resolution.CoordinateNeighbourhood.surjective_aeval_div_and_ker_eq_span hp
      hdim c (FractionRing Γ(S, c.U))).2
  rw [c.span_eq]
  exact (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).isPrime.ne_top

/-- If `y, x` is a weakly regular sequence, the kernel of the Rees presentation
`R[u, v] → R[(y, x)t]`, `u ↦ yt`, `v ↦ xt`, is the ideal `(xu - yv)`. -/
private theorem ker_reesPresentation_eq_relationIdeal {R : Type*} [CommRing R] {x y : R}
    (h : IsWeaklyRegular R [y, x]) :
    RingHom.ker (Stacks.Blowup.reesPresentation (Ideal.span (Set.range ![y, x])) ![y, x]
      (fun i ↦ Ideal.subset_span ⟨i, rfl⟩)).toRingHom =
        Stacks.AlmostBlowUp.relationIdeal R y x := by
  have hval : ∀ (I : Ideal R) (hI : ∀ i, ![y, x] i ∈ I),
      RingHom.ker (Stacks.Blowup.reesPresentation I ![y, x] hI).toRingHom =
        RingHom.ker (MvPolynomial.eval₂Hom (Polynomial.C : R →+* Polynomial R)
          fun i ↦ Polynomial.C (![y, x] i) * Polynomial.X) := fun I hI ↦ by
    rw [← Stacks.Blowup.val_comp_reesPresentation I _ hI,
      RingHom.ker_comp_of_injective _ Subtype.val_injective]
  exact (hval _ _).trans ((hval _ _).symm.trans
    (Stacks.AlmostBlowUp.ker_centerReesPresentation_eq_relationIdeal _ _ _ h))

/-- **The blow-up of a regular surface point is `V₊(xu - yv)` in `𝐏¹_U`** (Kollár 1.36). Let `S`
be a Noetherian scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension `2`, and
`c = (U = Spec R, x, y)` a coordinate neighbourhood of `p`. The closed immersion
`Proj R[(x, y)t] ⟶ Proj R[u, v]` induced by `u ↦ yt`, `v ↦ xt` has the same ideal sheaf as the
closed immersion `Proj (R[u, v] ⧸ (xu - yv)) ⟶ Proj R[u, v]`, i.e. it is an isomorphism onto
`V₊(xu - yv)`. -/
@[mmp "lem_kr1b_blowup_hypersurface_equation"]
public theorem CoordinateNeighbourhood.ker_blowUpSpecToProjSpace_eq_ker_projMap_quotientMk
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    (Stacks.Blowup.blowUpSpecToProjSpace (Ideal.span (Set.range ![c.y, c.x])) ![c.y, c.x]
        (fun i ↦ Ideal.subset_span ⟨i, rfl⟩) rfl).ker =
      (Proj.map (Stacks.RingTheory.HomogeneousQuotient.quotientMk
          (MvPolynomial.homogeneousSubmodule (Fin 2) Γ(S, c.U))
          (Ideal.homogeneousHull (MvPolynomial.homogeneousSubmodule (Fin 2) Γ(S, c.U))
            (Ideal.span {C c.x * X 0 - C c.y * X 1})))
        (Proj.irrelevant_le_map_of_surjective _ Ideal.Quotient.mk_surjective)).ker := by
  refine ker_projMap_eq_of_ker_eq
    (Stacks.Blowup.reesPresentation (Ideal.span (Set.range ![c.y, c.x])) ![c.y, c.x]
      (fun i ↦ Ideal.subset_span ⟨i, rfl⟩))
    (Stacks.RingTheory.HomogeneousQuotient.quotientMk
      (MvPolynomial.homogeneousSubmodule (Fin 2) Γ(S, c.U))
      (Ideal.homogeneousHull (MvPolynomial.homogeneousSubmodule (Fin 2) Γ(S, c.U))
        (Ideal.span {C c.x * X 0 - C c.y * X 1})))
    (Stacks.Blowup.surjective_reesPresentation _ _ _ rfl) Ideal.Quotient.mk_surjective ?_
    (Proj.irrelevant_le_map_of_surjective _ (Stacks.Blowup.surjective_reesPresentation _ _ _ rfl))
    (Proj.irrelevant_le_map_of_surjective _ Ideal.Quotient.mk_surjective)
  exact (ker_reesPresentation_eq_relationIdeal (isWeaklyRegular_y_x hp hdim c)).trans
    ((Stacks.AlmostBlowUp.relationIdeal_isHomogeneous _ c.y c.x
      ).toIdeal_homogeneousHull_eq_self.symm.trans
        (Stacks.RingTheory.HomogeneousQuotient.ker_quotientMk _ _).symm)

end

/-! ### The exceptional curve in the chart -/

section

open Stacks.Blowup Polynomial

section Algebra

variable {R : Type*} [CommRing R] [IsDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K] {x y : R}

/-- For `x ≠ 0`, the solutions of `x z = y` in a fraction field are exactly `y / x`. -/
private theorem setOf_mul_eq (hx : x ≠ 0) :
    {z : K | algebraMap R K x * z = algebraMap R K y} = {algebraMap R K y / algebraMap R K x} := by
  ext z
  simp [eq_div_iff (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (K := K)
    (mem_nonZeroDivisors_of_ne_zero hx)), mul_comm]

/-- `R[Y] / (x, xY - y) = R[Y] / (x, y)`: the two ideals agree. -/
private theorem span_C_sup_span_eq_map_C :
    Ideal.span {(C x : R[X])} ⊔ Ideal.span {C x * Polynomial.X - C y} =
      (Ideal.span {x, y}).map C := by
  rw [Ideal.map_span, Set.image_pair, Ideal.span_insert]
  apply le_antisymm
  · refine sup_le le_sup_left ?_
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ (Ideal.mem_sup_left (Ideal.subset_span rfl)))
      (Ideal.mem_sup_right (Ideal.subset_span rfl))
  · refine sup_le le_sup_left ?_
    rw [Ideal.span_le, Set.singleton_subset_iff]
    have := Ideal.sub_mem (Ideal.span {(C x : R[X])} ⊔ Ideal.span {C x * Polynomial.X - C y})
      (Ideal.mul_mem_right Polynomial.X _ (Ideal.mem_sup_left (Ideal.subset_span rfl)))
      (Ideal.mem_sup_right (Ideal.subset_span rfl))
    rwa [sub_sub_cancel] at this

/-- If `R[Y] → R[y/x]`, `Y ↦ y/x`, is surjective with kernel `(xY - y)` and `(x, y) = 𝔪` is
maximal, then `R[y/x] / x R[y/x] ≃ (R/𝔪)[Y]`, by the residues of `R` and `Y ↦ y/x`. -/
private theorem exists_ringEquiv_quotient (hx : x ≠ 0) (m : Ideal R) [m.IsMaximal]
    (hm : Ideal.span {x, y} = m)
    (hsurj : Function.Surjective (aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
      Algebra.self_mem_adjoin_singleton _ _⟩ :
        Algebra.adjoin R {algebraMap R K y / algebraMap R K x})))
    (hker : RingHom.ker (aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
      Algebra.self_mem_adjoin_singleton _ _⟩ :
        Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) =
      Ideal.span {C x * Polynomial.X - C y}) :
    ∃ φ : (R ⧸ m)[X] ≃+* (Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y}) ⧸
        Ideal.span {algebraMap R (Algebra.adjoin R
          {z : K | algebraMap R K x * z = algebraMap R K y}) x},
      (∀ r : R, φ (C (Ideal.Quotient.mk m r)) = Ideal.Quotient.mk _ (algebraMap R _ r)) ∧
      ∀ z : Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y},
        algebraMap R _ x * z = algebraMap R _ y → φ Polynomial.X = Ideal.Quotient.mk _ z := by
  set B := Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y}
  have hBB : Algebra.adjoin R {algebraMap R K y / algebraMap R K x} = B := by
    simp only [B, setOf_mul_eq hx]
  let E := Subalgebra.equivOfEq _ _ hBB
  let g : R[X] →ₐ[R] B := E.toAlgHom.comp (aeval ⟨algebraMap R K y / algebraMap R K x,
      Algebra.self_mem_adjoin_singleton _ _⟩)
  have hg : Function.Surjective g := E.surjective.comp hsurj
  have hgker : RingHom.ker (g : R[X] →+* B) = Ideal.span {C x * Polynomial.X - C y} := by
    rw [← hker]
    ext q
    simp only [RingHom.mem_ker]
    exact E.toEquiv.injective.eq_iff' (map_zero E)
  let f : R[X] →+* B ⧸ Ideal.span {algebraMap R B x} :=
    (Ideal.Quotient.mk _).comp (g : R[X] →+* B)
  have hf : Function.Surjective f := Ideal.Quotient.mk_surjective.comp hg
  have hfker : (m.map C : Ideal R[X]) = RingHom.ker f := by
    have h1 : Ideal.span {algebraMap R B x} = (Ideal.span {(C x : R[X])}).map (g : R[X] →+* B) := by
      rw [Ideal.map_span, Set.image_singleton]
      simp [g]
    rw [← RingHom.comap_ker, Ideal.mk_ker, h1, Ideal.comap_map_of_surjective (g : R[X] →+* B) hg,
      ← RingHom.ker_eq_comap_bot, hgker, span_C_sup_span_eq_map_C, hm]
  refine ⟨(Ideal.polynomialQuotientEquivQuotientPolynomial m).trans
    ((Ideal.quotEquivOfEq hfker).trans (RingHom.quotientKerEquivOfSurjective hf)), ?_, ?_⟩
  · intro r
    rw [RingEquiv.trans_apply, RingEquiv.trans_apply, ← Polynomial.map_C,
      Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    simp [f, g]
  · intro z hz
    rw [RingEquiv.trans_apply, RingEquiv.trans_apply, ← Polynomial.map_X (Ideal.Quotient.mk m),
      Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    change Ideal.Quotient.mk _ (g Polynomial.X) = _
    congr 1
    apply Subtype.ext
    have hz' : (z : K) ∈ {z : K | algebraMap R K x * z = algebraMap R K y} := by
      simpa using congrArg Subtype.val hz
    rw [setOf_mul_eq hx] at hz'
    simp only [g, E, AlgHom.comp_apply, aeval_X, AlgEquiv.coe_algHom, Subalgebra.equivOfEq_apply]
    exact (Set.mem_singleton_iff.1 hz').symm

/-- For `x ≠ 0`, the element `y / x` of `R[y/x]`. -/
noncomputable def divElem (hx : x ≠ 0) :
    Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y} :=
  ⟨algebraMap R K y / algebraMap R K x, Algebra.subset_adjoin (by rw [setOf_mul_eq hx]; rfl)⟩

/-- `x · (y / x) = y` in `R[y/x]`. -/
private theorem algebraMap_mul_divElem (hx : x ≠ 0) :
    algebraMap R (Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y}) x *
      divElem hx = algebraMap R _ y := by
  have hx' : algebraMap R K x ≠ 0 := fun h => hx ((IsFractionRing.to_map_eq_zero_iff).1 h)
  exact Subtype.ext (by simp [divElem, mul_div_cancel₀ _ hx'])

/-- In `R[y/x]`, the extension of `(x, y)` is `(x)`, since `y = x · (y/x)`. -/
private theorem map_span_pair_eq_span (hx : x ≠ 0) :
    (Ideal.span {x, y}).map
        (algebraMap R (Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y})) =
      Ideal.span {(algebraMap R
        (Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y}) x)} := by
  rw [Ideal.map_span, Set.image_pair, ← algebraMap_mul_divElem hx, Ideal.span_insert, sup_eq_left,
    Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_span_singleton]
  exact dvd_mul_right _ _

/-- For `x ≠ 0`, every solution `z` of `x z = y` in `R[y/x]` is `y / x`. -/
private theorem eq_divElem (hx : x ≠ 0)
    {z : Algebra.adjoin R {z : K | algebraMap R K x * z = algebraMap R K y}}
    (hz : algebraMap R _ x * z = algebraMap R _ y) : z = divElem hx := by
  have hx' : algebraMap R K x ≠ 0 := fun h => hx ((IsFractionRing.to_map_eq_zero_iff).1 h)
  have hz' : algebraMap R K x * z = algebraMap R K y := by simpa using congrArg Subtype.val hz
  exact Subtype.ext (eq_div_of_mul_eq hx' (by rwa [mul_comm]))

/-- The ring map `κ[Y] → R[y/x] / x R[y/x]` induced by `R → R[y/x]` (which kills
`𝔪 = (x, y)`, so factors through `R / 𝔪 ≃ κ`) and `Y ↦ y/x`. -/
noncomputable def chartPolynomialHom.{v} {R : Type v} [CommRing R] [IsDomain R]
    {x y : R} (hx : x ≠ 0) (m : Ideal R) (hm : Ideal.span {x, y} = m)
    {κ : Type*} [CommRing κ] (ε : κ ≃+* R ⧸ m) :
    κ[X] →+* (Algebra.adjoin R
          {z : FractionRing R | algebraMap R _ x * z = algebraMap R _ y}) ⧸
        Ideal.span {algebraMap R (Algebra.adjoin R
          {z : FractionRing R | algebraMap R _ x * z = algebraMap R _ y}) x} :=
  eval₂RingHom
    ((Ideal.quotientMap _ (algebraMap R _) (by
      rw [← hm, ← Ideal.map_le_iff_le_comap, map_span_pair_eq_span hx])).comp ε.toRingHom)
    (Ideal.Quotient.mk _ (divElem (K := FractionRing R) hx))

private theorem chartPolynomialHom_C.{v} {R : Type v} [CommRing R] [IsDomain R]
    {x y : R} (hx : x ≠ 0) (m : Ideal R) (hm : Ideal.span {x, y} = m)
    {κ : Type*} [CommRing κ] (ε : κ ≃+* R ⧸ m) {a : κ} {r : R}
    (ha : ε a = Ideal.Quotient.mk m r) :
    chartPolynomialHom hx m hm ε (C a) = Ideal.Quotient.mk _ (algebraMap R _ r) := by
  rw [chartPolynomialHom, coe_eval₂RingHom, eval₂_C, RingHom.comp_apply,
    RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, ha, Ideal.quotientMap_mk]

private theorem chartPolynomialHom_X.{v} {R : Type v} [CommRing R] [IsDomain R]
    {x y : R} (hx : x ≠ 0) (m : Ideal R) (hm : Ideal.span {x, y} = m)
    {κ : Type*} [CommRing κ] (ε : κ ≃+* R ⧸ m)
    {z : Algebra.adjoin R {z : FractionRing R | algebraMap R _ x * z = algebraMap R _ y}}
    (hz : algebraMap R _ x * z = algebraMap R _ y) :
    chartPolynomialHom hx m hm ε Polynomial.X = Ideal.Quotient.mk _ z := by
  rw [chartPolynomialHom, coe_eval₂RingHom, eval₂_X, ← eq_divElem hx hz]

/-- `κ[Y] → R[y/x] / x R[y/x]` is bijective: it agrees on constants and on `Y` with the
isomorphism `κ[Y] ≃ (R/𝔪)[Y] ≃ R[Y]/(x, xY - y) ≃ R[y/x]/x` of `exists_ringEquiv_quotient`,
given the presentation `R[y/x] = R[Y]/(xY - y)` over every fraction field of `R`. -/
private theorem bijective_chartPolynomialHom.{v} {R : Type v} [CommRing R] [IsDomain R]
    {x y : R} (hx : x ≠ 0) (m : Ideal R) [m.IsMaximal] (hm : Ideal.span {x, y} = m)
    {κ : Type*} [CommRing κ] (ε : κ ≃+* R ⧸ m)
    (hpres : ∀ (K : Type v) [Field K] [Algebra R K] [IsFractionRing R K],
      Function.Surjective (aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
        Algebra.self_mem_adjoin_singleton _ _⟩ :
          Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) ∧
      RingHom.ker (aeval (R := R) (⟨algebraMap R K y / algebraMap R K x,
        Algebra.self_mem_adjoin_singleton _ _⟩ :
          Algebra.adjoin R {algebraMap R K y / algebraMap R K x})) =
        Ideal.span {C x * Polynomial.X - C y}) :
    Function.Bijective (chartPolynomialHom hx m hm ε) := by
  obtain ⟨φ₀, h₁, h₂⟩ :=
    exists_ringEquiv_quotient hx m hm (hpres (FractionRing R)).1 (hpres (FractionRing R)).2
  have hφ : chartPolynomialHom hx m hm ε = ((Polynomial.mapEquiv ε).trans φ₀).toRingHom := by
    refine Polynomial.ringHom_ext (fun a => ?_) ?_
    · obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (ε a)
      rw [chartPolynomialHom_C hx m hm ε hr.symm, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
        RingEquiv.trans_apply, Polynomial.mapEquiv_apply, Polynomial.map_C, RingHom.coe_coe,
        ← hr, h₁]
    · rw [chartPolynomialHom_X hx m hm ε (algebraMap_mul_divElem hx),
        RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, RingEquiv.trans_apply,
        Polynomial.mapEquiv_apply, Polynomial.map_X, h₂ _ (algebraMap_mul_divElem hx)]
  rw [hφ]
  exact ((Polynomial.mapEquiv ε).trans φ₀).bijective

end Algebra

/-- For a closed point `p` of an affine open `U = Spec R`, the residue field `κ(p)` is
`R / 𝔪_p`: the inverse of `R / 𝔪_p ≃ 𝒪_{S,p} / 𝔪_p`. -/
noncomputable def residueFieldEquivQuotient.{v} {S : Scheme.{v}} {p : S}
    (hp : IsClosed ({p} : Set S)) (c : CoordinateNeighbourhood S p) :
    S.residueField p ≃+* Γ(S, c.U) ⧸ (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal :=
  letI := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  haveI := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  haveI := c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩ hp
  (IsLocalization.AtPrime.equivQuotMaximalIdeal
    (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal (S.presheaf.stalk p)).toRingEquiv.symm

/-- `κ(p) ≃ R / 𝔪_p` is compatible with the evaluation `R → κ(p)`. -/
private theorem residueFieldEquivQuotient_evaluation.{v} {S : Scheme.{v}} {p : S}
    (hp : IsClosed ({p} : Set S)) (c : CoordinateNeighbourhood S p) (r : Γ(S, c.U)) :
    residueFieldEquivQuotient hp c ((S.evaluation c.U p c.mem).hom r) =
      Ideal.Quotient.mk _ r := by
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  have := c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩ hp
  exact (RingEquiv.symm_apply_eq _).mpr rfl

/-- **The exceptional curve chart isomorphism** `κ(p)[Y] ≃ R[y/x] / x R[y/x]`, for a closed
point `p` of a Noetherian scheme `S` with `𝒪_{S,p}` regular of dimension `2` and a coordinate
neighbourhood `c = (U = Spec R, x, y)` of `p`: the homomorphism induced by `R → R[y/x]` and
`Y ↦ y/x`, which is bijective. -/
@[irreducible] public noncomputable def CoordinateNeighbourhood.exceptionalChartPolynomialEquiv
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    Polynomial (S.residueField p) ≃+*
      (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
          algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) ⧸
        Ideal.span {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x} :=
  haveI := c.isDomain
  haveI := c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩ hp
  RingEquiv.ofBijective (chartPolynomialHom (by exact c.x_ne_zero hdim) _ c.span_eq
    (residueFieldEquivQuotient hp c)) (by
      exact bijective_chartPolynomialHom (c.x_ne_zero hdim) _ c.span_eq
        (residueFieldEquivQuotient hp c)
        (fun K _ _ _ => CoordinateNeighbourhood.surjective_aeval_div_and_ker_eq_span hp hdim c K))

/-- `κ(p)[Y] ≃ R[y/x] / x R[y/x]` sends the residue of `r ∈ R` to the class of `r`. -/
public theorem CoordinateNeighbourhood.exceptionalChartPolynomialEquiv_C
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (r : Γ(S, c.U)) :
    c.exceptionalChartPolynomialEquiv hp hreg hdim
        (Polynomial.C ((S.evaluation c.U p c.mem).hom r)) =
      Ideal.Quotient.mk _ (algebraMap Γ(S, c.U) _ r) := by
  have := c.isDomain
  unfold exceptionalChartPolynomialEquiv
  exact chartPolynomialHom_C (c.x_ne_zero hdim) _ c.span_eq _
    (residueFieldEquivQuotient_evaluation hp c r)

/-- `κ(p)[Y] ≃ R[y/x] / x R[y/x]` sends `Y` to the class of `y/x`, the solution `z` of
`x z = y`. -/
public theorem CoordinateNeighbourhood.exceptionalChartPolynomialEquiv_X
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (z : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y})
    (hz : algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y) :
    c.exceptionalChartPolynomialEquiv hp hreg hdim Polynomial.X = Ideal.Quotient.mk _ z := by
  have := c.isDomain
  unfold exceptionalChartPolynomialEquiv
  exact chartPolynomialHom_X (c.x_ne_zero hdim) _ c.span_eq (residueFieldEquivQuotient hp c) hz

/-- **The exceptional curve in a chart** (Kollár 1.36). Let `S` be a Noetherian scheme, `p ∈ S`
a closed point with `𝒪_{S,p}` regular of dimension `2`, `c = (U = Spec R, x, y)` a coordinate
neighbourhood of `p`, and `e : D₊(xt) ≅ Spec R[y/x]` an isomorphism over `S`. Then the
exceptional curve `E = π⁻¹(p)` pulls back along `Spec R[y/x] ≅ D₊(xt) ⊆ B_pS` to the closed
subscheme `Spec R[y/x] / x R[y/x]`, and the ring isomorphism
`exceptionalChartPolynomialEquiv : κ(p)[Y] ≃ R[y/x] / x R[y/x]` sends the residue of `r ∈ R` to
the class of `r` and `Y` to the class of `y/x`. -/
@[mmp "lem_kr1b_exceptional_curve_chart"]
public theorem
    CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (e : (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.toScheme ≅
        Spec (CommRingCat.of (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y})))
    (he : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) ≫
          c.isAffineOpen.fromSpec =
        (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :
    (AlgebraicGeometry.exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).comap
        (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span
        {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x})))).ker ∧
    (∀ r : Γ(S, c.U), c.exceptionalChartPolynomialEquiv hp hreg hdim
          (Polynomial.C ((S.evaluation c.U p c.mem).hom r)) =
        Ideal.Quotient.mk _ (algebraMap Γ(S, c.U) _ r)) ∧
    ∀ z : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
          algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y →
        c.exceptionalChartPolynomialEquiv hp hreg hdim Polynomial.X = Ideal.Quotient.mk _ z := by
  have := c.isDomain
  have hx0 := c.x_ne_zero hdim
  have hJ := ideal_vanishingIdeal_eq_span hp c
  have := c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩ hp
  refine ⟨?_, ?_⟩
  · exact comap_comap_eq_ker_specMap (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
      (AlgebraicGeometry.blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
      (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) c.isAffineOpen
      (CommRingCat.ofHom (algebraMap Γ(S, c.U) _))
      (by rw [Category.assoc, ← he, Iso.inv_hom_id_assoc]) (map_span_pair_eq_span hx0) hJ
  · exact ⟨c.exceptionalChartPolynomialEquiv_C hp hreg hdim,
      c.exceptionalChartPolynomialEquiv_X hp hreg hdim⟩

end

/-! ### Factorisation of a pull-back along the exceptional curve -/

section

open IsLocalRing MvPolynomial

/-- A monomial in the support of a homogeneous polynomial of degree `m` in two variables has
exponents summing to `m`. -/
private theorem add_eq_of_mem_support {R : Type*} [CommSemiring R]
    {m : ℕ} {G : MvPolynomial (Fin 2) R} (hG : G.IsHomogeneous m) {d : Fin 2 →₀ ℕ}
    (hd : d ∈ G.support) : d 0 + d 1 = m := by
  simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using
    hG (mem_support_iff.mp hd)

section Algebra

variable {R B : Type*} [CommRing R] [CommRing B] [Algebra R B] {x y : R} {z : B}

/-- If `x z = y` in `B`, every element of `(x, y)^n` becomes divisible by `x^n` in `B`. -/
private theorem exists_eq_pow_mul_of_mem_span_pair_pow
    (hz : algebraMap R B x * z = algebraMap R B y)
    {n : ℕ} {h : R} (hh : h ∈ Ideal.span {x, y} ^ n) :
    ∃ b : B, algebraMap R B h = algebraMap R B x ^ n * b := by
  have hle : (Ideal.span {x, y} ^ n).map (algebraMap R B) ≤
      Ideal.span {algebraMap R B x ^ n} := by
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, ← Ideal.span_singleton_pow]
    refine Ideal.pow_right_mono ?_ n
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Ideal.subset_span rfl
    · rw [← hz]; exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (hle (Ideal.mem_map_of_mem _ hh))
  exact ⟨b, by rw [← hb, mul_comm]⟩

/-- For `G` homogeneous of degree `m` and `x z = y`, `G(x, y) = x^m G(1, z)` in `B`. -/
private theorem aeval_eq_pow_mul_aeval (hz : algebraMap R B x * z = algebraMap R B y)
    {m : ℕ} {G : MvPolynomial (Fin 2) R} (hG : G.IsHomogeneous m) :
    algebraMap R B (eval ![x, y] G) = algebraMap R B x ^ m * aeval ![1, z] G := by
  conv_lhs => rw [G.as_sum]
  conv_rhs => rw [G.as_sum]
  simp only [map_sum, Finset.mul_sum, aeval_monomial, eval_monomial]
  refine Finset.sum_congr rfl fun d hd => ?_
  have hdeg := add_eq_of_mem_support hG hd
  rw [Finsupp.prod_fintype _ _ (by simp), Finsupp.prod_fintype _ _ (by simp),
    Fin.prod_univ_two, Fin.prod_univ_two]
  simp only [map_mul, map_pow, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    one_pow, one_mul, ← hz, mul_pow, ← hdeg, pow_add]
  ring

end Algebra

/-- A homogeneous polynomial lifts along a surjective ring map to a homogeneous polynomial of
the same degree. -/
private theorem exists_isHomogeneous_map_eq {R K σ : Type*} [CommRing R] [CommRing K]
    {ε : R →+* K} (hε : Function.Surjective ε) {m : ℕ} {F : MvPolynomial σ K}
    (hF : F.IsHomogeneous m) :
    ∃ G : MvPolynomial σ R, G.IsHomogeneous m ∧ MvPolynomial.map ε G = F := by
  obtain ⟨G, rfl⟩ := MvPolynomial.map_surjective ε hε F
  refine ⟨homogeneousComponent m G, homogeneousComponent_isHomogeneous m G, ?_⟩
  have h := homogeneousComponent_of_mem (m := m) hF
  rw [if_pos rfl] at h
  conv_rhs => rw [← h]
  ext d
  simp only [coeff_map, coeff_homogeneousComponent]
  split_ifs <;> simp

private theorem eval_mem_pow_succ_of_map_eq_zero {A : Type*} [CommRing A] [IsLocalRing A]
    {x y : A} (hx : x ∈ maximalIdeal A) (hy : y ∈ maximalIdeal A) {m : ℕ}
    {G : MvPolynomial (Fin 2) A} (hG : G.IsHomogeneous m) (h0 : map (residue A) G = 0) :
    eval ![x, y] G ∈ maximalIdeal A ^ (m + 1) := by
  rw [eval_eq']
  refine Ideal.sum_mem _ fun d hd => ?_
  have hdeg := add_eq_of_mem_support hG hd
  have hc : G.coeff d ∈ maximalIdeal A := by
    have := congrArg (·.coeff d) h0
    rw [coeff_map, MvPolynomial.coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at this
    exact (residue_eq_zero_iff _).mp this
  have hp : (∏ i, (![x, y] : Fin 2 → A) i ^ d i) ∈ maximalIdeal A ^ m := by
    rw [Fin.prod_univ_two, ← hdeg, pow_add]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hx _) (Ideal.pow_mem_pow hy _)
  rw [pow_succ']
  exact Ideal.mul_mem_mul hc hp

/-- In the localization `A = R_𝔪` at a maximal ideal, `𝔪^{n+1} A ∩ R = 𝔪^{n+1}`. -/
private theorem mem_pow_of_algebraMap_mem {R A : Type*} [CommRing R] [CommRing A] [IsLocalRing A]
    [Algebra R A] (𝔪 : Ideal R) [𝔪.IsMaximal] [IsLocalization.AtPrime A 𝔪] {n : ℕ} {r : R}
    (hr : algebraMap R A r ∈ maximalIdeal A ^ (n + 1)) : r ∈ 𝔪 ^ (n + 1) := by
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 A, ← Ideal.map_pow] at hr
  have hprim : (𝔪 ^ (n + 1)).IsPrimary := by
    apply Ideal.isPrimary_of_isMaximal_radical
    rw [Ideal.radical_pow _ (Nat.succ_ne_zero n), (inferInstance : 𝔪.IsMaximal).isPrime.radical]
    infer_instance
  have hdisj : Disjoint (𝔪.primeCompl : Set R) (𝔪 ^ (n + 1) : Ideal R) := by
    rw [Set.disjoint_left]
    intro a ha ha'
    exact ha (Ideal.pow_le_self (Nat.succ_ne_zero n) ha')
  rw [← IsLocalization.under_map_of_isPrimary_disjoint 𝔪.primeCompl A hprim hdisj]
  exact hr

/-- The residue field of the localization at a maximal ideal `𝔪` is a quotient of `R`. -/
private theorem residue_comp_algebraMap_surjective {R : Type*} [CommRing R] (𝔪 : Ideal R)
    [𝔪.IsMaximal] (A : Type*) [CommRing A] [IsLocalRing A] [Algebra R A]
    [IsLocalization.AtPrime A 𝔪] :
    Function.Surjective ((residue A).comp (algebraMap R A)) := by
  intro a
  obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective
    ((IsLocalization.AtPrime.equivQuotMaximalIdeal 𝔪 A).symm a)
  refine ⟨q, ?_⟩
  apply (IsLocalization.AtPrime.equivQuotMaximalIdeal 𝔪 A).symm.injective
  rw [← hq]
  exact (RingEquiv.symm_apply_eq _).mpr rfl

/-- **Kollár 1.38, algebraic form.** Let `𝔪 = (x, y)` be a maximal ideal of `R`, `A = R_𝔪`, and
`B` an `R`-algebra with `x z = y` in `B`. If the image of `f` in `A` has multiplicity `m` and
leading term `F`, then `f = x^m f₁` in `B`, and the class of `f₁` in `B / x B` is `φ (F(1, Y))`
for every ring map `φ : κ[Y] → B / x B` sending residues of `r ∈ R` to the class of `r` and `Y`
to the class of `z`. -/
private theorem exists_eq_pow_mul_and_mk_eq_of_isLocalization {R : Type*} [CommRing R] (𝔪 : Ideal R)
    [𝔪.IsMaximal] (A : Type*) [CommRing A] [IsLocalRing A] [Algebra R A]
    [IsLocalization.AtPrime A 𝔪] {x y : R} (hxy : Ideal.span {x, y} = 𝔪)
    {B : Type*} [CommRing B] [Algebra R B] {z : B}
    (hz : algebraMap R B x * z = algebraMap R B y) (f : R) (m : ℕ)
    (hm : mult (algebraMap R A f) = m) (F : MvPolynomial (Fin 2) (ResidueField A))
    (hF : IsLeadingTerm (algebraMap R A x) (algebraMap R A y) (algebraMap R A f) F) :
    ∃ f₁ : B, algebraMap R B f = algebraMap R B x ^ m * f₁ ∧
      ∀ φ : Polynomial (ResidueField A) →+* B ⧸ Ideal.span {algebraMap R B x},
        (∀ r : R, φ (Polynomial.C (residue A (algebraMap R A r))) =
          Ideal.Quotient.mk _ (algebraMap R B r)) →
        (∀ z' : B, algebraMap R B x * z' = algebraMap R B y →
          φ Polynomial.X = Ideal.Quotient.mk _ z') →
        φ (MvPolynomial.aeval ![1, Polynomial.X] F) = Ideal.Quotient.mk _ f₁ := by
  classical
  obtain ⟨m', hm', hFh, G, hG, hGF, hfG⟩ := hF
  have hmm : m = m' := by exact_mod_cast hm.symm.trans hm'
  subst hmm
  obtain ⟨G', hG', hG'F⟩ := exists_isHomogeneous_map_eq
    (residue_comp_algebraMap_surjective 𝔪 A) hFh
  -- `f - G'(x, y) ∈ 𝔪^{m+1}`
  have hmax : ∀ r ∈ 𝔪, algebraMap R A r ∈ maximalIdeal A :=
    fun r hr => (IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪 A) ▸ Ideal.mem_map_of_mem _ hr
  have hxm : x ∈ 𝔪 := hxy ▸ Ideal.subset_span (by simp)
  have hym : y ∈ 𝔪 := hxy ▸ Ideal.subset_span (by simp)
  have hev : algebraMap R A (eval ![x, y] G') =
      eval ![algebraMap R A x, algebraMap R A y] (MvPolynomial.map (algebraMap R A) G') := by
    rw [MvPolynomial.eval_map, MvPolynomial.eval, MvPolynomial.coe_eval₂Hom,
      MvPolynomial.eval₂_comp_left]
    congr 1
    funext i
    fin_cases i <;> rfl
  have h1 : algebraMap R A (f - eval ![x, y] G') ∈ maximalIdeal A ^ (m + 1) := by
    have h0 : MvPolynomial.map (residue A) (G - MvPolynomial.map (algebraMap R A) G') = 0 := by
      rw [map_sub, MvPolynomial.map_map, hGF, ← hG'F, sub_eq_zero]
    have := Ideal.add_mem _ hfG (eval_mem_pow_succ_of_map_eq_zero (hmax _ hxm) (hmax _ hym)
      (hG.sub (hG'.map _)) h0)
    rw [map_sub, hev]
    convert this using 1
    rw [map_sub]
    ring
  have h2 := mem_pow_of_algebraMap_mem 𝔪 h1
  rw [← hxy] at h2
  obtain ⟨b, hb⟩ := exists_eq_pow_mul_of_mem_span_pair_pow hz h2
  refine ⟨aeval ![1, z] G' + algebraMap R B x * b, ?_, ?_⟩
  · have h3 := aeval_eq_pow_mul_aeval hz hG'
    calc algebraMap R B f = algebraMap R B (eval ![x, y] G') +
          algebraMap R B (f - eval ![x, y] G') := by rw [← map_add]; ring_nf
      _ = _ := by rw [h3, hb]; ring
  · intro φ hφC hφX
    have hxb : Ideal.Quotient.mk (Ideal.span {algebraMap R B x}) (algebraMap R B x * b) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl))
    rw [map_add, hxb, add_zero, ← hG'F]
    have key : (φ.comp (MvPolynomial.aeval (R := ResidueField A)
        ![1, Polynomial.X]).toRingHom).comp (MvPolynomial.map ((residue A).comp (algebraMap R A))) =
        (Ideal.Quotient.mk _).comp (MvPolynomial.aeval (R := R) ![1, z]).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [hφC]
      · intro i
        fin_cases i
        · simp
        · simp [hφX z hz]
    exact DFunLike.congr_fun key G'

/-- **Factorisation of a pull-back along the exceptional curve** (Kollár 1.38). Let `S` be a
Noetherian scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension `2`,
`c = (U = Spec R, x, y)` a coordinate neighbourhood of `p`, and `f ∈ R` whose germ at `p` has
multiplicity `m` and leading term `F` with respect to the germs of `x, y`. Then there is
`f¹ ∈ R[y/x]` with `f = x^m f¹`, and for every ring homomorphism
`φ : κ(p)[Y] → R[y/x] / x R[y/x]` sending residues of `r ∈ R` to the class of `r` and `Y` to
the class of `y/x`, the class of `f¹` is `φ (F(1, Y))`. -/
@[mmp "lem_kr1b_pullback_factor_exceptional"]
public theorem CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (f : Γ(S, c.U)) (m : ℕ) (hm : mult ((S.presheaf.germ c.U p c.mem).hom f) = m)
    (F : MvPolynomial (Fin 2) (S.residueField p))
    (hF : IsLeadingTerm ((S.presheaf.germ c.U p c.mem).hom c.x)
      ((S.presheaf.germ c.U p c.mem).hom c.y) ((S.presheaf.germ c.U p c.mem).hom f) F) :
    ∃ f₁ : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
      algebraMap Γ(S, c.U) _ f = algebraMap Γ(S, c.U) _ c.x ^ m * f₁ ∧
      ∀ φ : Polynomial (S.residueField p) →+*
          (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
              algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) ⧸
            Ideal.span {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
              {z : FractionRing Γ(S, c.U) |
                algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x},
        (∀ r : Γ(S, c.U), φ (Polynomial.C ((S.evaluation c.U p c.mem).hom r)) =
          Ideal.Quotient.mk _ (algebraMap Γ(S, c.U) _ r)) →
        (∀ z : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
          algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y →
            φ Polynomial.X = Ideal.Quotient.mk _ z) →
        φ (MvPolynomial.aeval ![1, Polynomial.X] F) = Ideal.Quotient.mk _ f₁ := by
  have := c.isDomain
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  have := c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩
    (show IsClosed {((⟨p, c.mem⟩ : c.U) : S)} from hp)
  exact exists_eq_pow_mul_and_mk_eq_of_isLocalization _ (S.presheaf.stalk p) c.span_eq
    (algebraMap_mul_divElem (K := FractionRing Γ(S, c.U)) (c.x_ne_zero hdim)) f m hm F hF

end

/-! ### The birational transform in the chart -/

section

open Limits

section Algebra

/-- In a ring where a non-zero-divisor `x` generates a prime ideal not containing `f₁`, the
`x`-saturation of `(x ^ m f₁)` is `(f₁)`. -/
private theorem exists_pow_mul_mem_span_iff {B : Type*} [CommRing B] {x f₁ : B}
    (hx : (Ideal.span {x}).IsPrime) (hx0 : IsLeftRegular x) (hf : f₁ ∉ Ideal.span {x}) (m : ℕ)
    (b : B) :
    (∃ N : ℕ, x ^ N * b ∈ Ideal.span {x ^ m * f₁}) ↔ b ∈ Ideal.span {f₁} := by
  constructor
  · rintro ⟨N, hN⟩
    have h1 : x ^ N * b ∈ Ideal.span {f₁} :=
      Ideal.span_singleton_le_span_singleton.mpr (dvd_mul_left _ _) hN
    clear hN
    induction N generalizing b with
    | zero => simpa using h1
    | succ N ih =>
      apply ih
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h1
      have hcx : c * f₁ ∈ Ideal.span {x} :=
        hc ▸ Ideal.mem_span_singleton.mpr ⟨x ^ N * b, by ring⟩
      rcases hx.mem_or_mem hcx with hc' | hc'
      · obtain ⟨c', rfl⟩ := Ideal.mem_span_singleton.mp hc'
        have : x * (c' * f₁) = x * (x ^ N * b) := by linear_combination hc
        exact Ideal.mem_span_singleton'.mpr ⟨c', hx0 this⟩
      · exact absurd hc' hf
  · intro hb
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hb
    exact ⟨m, Ideal.mem_span_singleton.mpr ⟨c, by ring⟩⟩

/-- The dehomogenisation `F(1, Y)` of a nonzero form `F` is nonzero. -/
private theorem aeval_one_X_ne_zero {K : Type*} [CommRing K] {F : MvPolynomial (Fin 2) K}
    {m : ℕ} (hF : F.IsHomogeneous m) (h0 : F ≠ 0) :
    MvPolynomial.aeval (![1, Polynomial.X] : Fin 2 → Polynomial K) F ≠ 0 := by
  obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp h0
  intro h
  apply hd
  have hprod : ∀ v : Fin 2 →₀ ℕ,
      (v.prod fun i k => (![1, Polynomial.X] : Fin 2 → Polynomial K) i ^ k) =
        Polynomial.X ^ (v 1) := by
    intro v
    rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _), Fin.prod_univ_two]
    simp
  rw [F.as_sum, map_sum] at h
  simp only [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq, hprod] at h
  have h2 := congrArg (fun P : Polynomial K => P.coeff (d 1)) h
  simp only [Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_zero] at h2
  rw [Finset.sum_eq_single d] at h2
  · simpa using h2
  · intro v hv hvd
    rw [if_neg]
    intro h1
    apply hvd
    have hv' := add_eq_of_mem_support hF hv
    have hd' := add_eq_of_mem_support hF (MvPolynomial.mem_support_iff.mpr hd)
    ext i
    fin_cases i
    · change v 0 = d 0
      omega
    · simpa using h1.symm
  · intro hdn
    exact absurd (MvPolynomial.notMem_support_iff.mp hdn) hd

/-- An element of `R` becoming a unit in `K` is left regular in every `R`-subalgebra of `K`. -/
private theorem isLeftRegular_algebraMap_subalgebra {R K : Type*} [CommRing R] [CommRing K]
    [Algebra R K] (B : Subalgebra R K) {x : R} (hx : IsUnit (algebraMap R K x)) :
    IsLeftRegular (algebraMap R B x) :=
  fun _ _ hab => Subtype.ext (hx.mul_left_cancel (congrArg Subtype.val hab))

end Algebra

section Geometry

/-- Pulling back a kernel ideal sheaf along an open immersion is the kernel of the base change. -/
private theorem comap_ker_eq_ker_pullbackSnd.{v} {X Y Z : Scheme.{v}} (h : Z ⟶ X)
    [QuasiCompact h] (g : Y ⟶ X) [IsOpenImmersion g] :
    h.ker.comap g = (pullback.snd h g).ker := by
  ext W : 2
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.ker_ideal_of_isPullback_of_isOpenImmersion h (pullback.snd h g) (pullback.fst h g) g
      (IsPullback.of_hasPullback h g).flip W]

private theorem ker_pullbackSnd_comp.{v} {X Y Z W : Scheme.{v}} (j : W ⟶ Z) (q : Z ⟶ X)
    (g : Y ⟶ X) :
    (pullback.snd (j ≫ q) g).ker = (pullback.snd j (pullback.fst q g) ≫ pullback.snd q g).ker := by
  rw [← pullbackRightPullbackFstIso_hom_snd, Scheme.Hom.ker_comp_of_isIso]

private theorem ker_pullbackSnd_ι_comp.{v} {X P : Scheme.{v}} (O : X.Opens) (k : P ⟶ X)
    {T : Scheme.{v}} (q : P ⟶ T) :
    (pullback.snd O.ι k ≫ q).ker = ((k ⁻¹ᵁ O).ι ≫ q).ker := by
  rw [← pullbackSymmetry_hom_comp_fst, ← pullbackRestrictIsoRestrict_hom_ι, Category.assoc,
    Category.assoc, Scheme.Hom.ker_comp_of_isIso, Scheme.Hom.ker_comp_of_isIso]

private theorem ker_ι_comp_congr.{v} {P T : Scheme.{v}} {O O' : P.Opens} (hO : O = O')
    (q : P ⟶ T) : (O.ι ≫ q).ker = (O'.ι ≫ q).ker := by
  subst hO
  rfl

/-- The kernel of `D(t) ⊆ P → Spec A`, `t` the image of `s`, on global sections: the
`s`-saturation of the kernel of `q`. -/
private theorem mem_ker_basicOpen_ι_comp_iff.{v} {P T : Scheme.{v}} [IsAffine P] [IsAffine T]
    (q : P ⟶ T) [QuasiCompact q] (s a : Γ(T, ⊤))
    [QuasiCompact ((P.basicOpen (q.appTop s)).ι ≫ q)] :
    a ∈ ((P.basicOpen (q.appTop s)).ι ≫ q).ker.ideal ⟨⊤, isAffineOpen_top T⟩ ↔
      ∃ N : ℕ, s ^ N * a ∈ q.ker.ideal ⟨⊤, isAffineOpen_top T⟩ := by
  rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
  set t := q.appTop s
  have := (isAffineOpen_top P).isLocalization_basicOpen t
  have hO : (P.basicOpen t).ι ''ᵁ ⊤ = P.basicOpen t := Scheme.Opens.ι_image_top _
  have hzero : ∀ b, (P.basicOpen t).ι.appTop b = 0 ↔
      P.presheaf.map (homOfLE (P.basicOpen_le t)).op b = 0 := by
    intro b
    rw [Scheme.Opens.ι_appTop]
    have : P.presheaf.map (homOfLE (x := (P.basicOpen t).ι ''ᵁ ⊤) le_top).op =
        P.presheaf.map (homOfLE (P.basicOpen_le t)).op ≫ P.presheaf.map (eqToHom hO).op := by
      rw [← Functor.map_comp]
      rfl
    rw [this]
    exact map_eq_zero_iff (P.presheaf.map (eqToHom hO).op).hom
      (ConcreteCategory.bijective_of_isIso (P.presheaf.map (eqToHom hO).op)).1
  simp only [RingHom.mem_ker, Scheme.Hom.comp_app, CommRingCat.hom_comp, RingHom.comp_apply]
  change (P.basicOpen t).ι.appTop (q.appTop a) = 0 ↔ ∃ N : ℕ, q.appTop (s ^ N * a) = 0
  rw [hzero]
  change algebraMap Γ(P, ⊤) Γ(P, P.basicOpen t) (q.appTop a) = 0 ↔ _
  rw [IsLocalization.map_eq_zero_iff (Submonoid.powers t)]
  constructor
  · rintro ⟨⟨_, N, rfl⟩, hN⟩
    exact ⟨N, by rwa [map_mul, map_pow]⟩
  · rintro ⟨N, hN⟩
    rw [map_mul, map_pow] at hN
    exact ⟨⟨_, N, rfl⟩, hN⟩

/-- The ideal sheaf of `Spec (A ⧸ I) ⟶ Spec A`, on global sections. -/
private theorem ideal_ker_specMap_quotientMk_top.{v} {A : Type v} [CommRing A] (t : A) :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))).ker.ideal
        ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {(Scheme.ΓSpecIso (.of A)).inv.hom t} := by
  rw [Scheme.Hom.ker_apply]
  have h : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))).appTop =
      (Scheme.ΓSpecIso (.of A)).hom ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})) ≫
        (Scheme.ΓSpecIso (.of (A ⧸ Ideal.span {t}))).inv := by
    rw [← Category.assoc]
    exact (Iso.eq_comp_inv _).mpr (Scheme.ΓSpecIso_naturality _)
  ext a
  change (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))).appTop a = 0 ↔ _
  rw [h]
  change (Scheme.ΓSpecIso (.of (A ⧸ Ideal.span {t}))).inv.hom
    (Ideal.Quotient.mk _ ((Scheme.ΓSpecIso (.of A)).hom.hom a)) = 0 ↔ _
  rw [map_eq_zero_iff _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of (A ⧸ Ideal.span {t}))).inv).1,
    Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨(Scheme.ΓSpecIso (.of A)).inv.hom c, ?_⟩
    rw [← map_mul, ← hc]
    exact (CommRingCat.inv_hom_apply (Scheme.ΓSpecIso (.of A)) a).symm
  · rintro ⟨c, hc⟩
    refine ⟨(Scheme.ΓSpecIso (.of A)).hom.hom c, ?_⟩
    rw [hc, map_mul]
    exact congrArg (· * _) (CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of A)) t)

/-- The support of the closed subscheme `Spec (A ⧸ (t))` of `Spec A` is the complement of the
basic open `D(t)`. -/
private theorem coe_support_ker_specMap_quotientMk.{v} {A : Type v} [CommRing A] (t : A) :
    ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))).ker.support :
        Set (Spec (.of A))) =
      (((Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv.hom t) : Set (Spec (.of A))))ᶜ := by
  ext z
  rw [SetLike.mem_coe,
    Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨⊤, isAffineOpen_top _⟩) trivial,
    ideal_ker_specMap_quotientMk_top]
  simp only [Scheme.mem_zeroLocus_iff, SetLike.mem_coe, Set.mem_compl_iff]
  refine ⟨fun h => h _ (Ideal.subset_span rfl), fun h r hr => ?_⟩
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hr
  rw [Scheme.basicOpen_mul]
  exact fun hz => h hz.2

/-- The pullback of a birational-transform-type ideal sheaf along an open immersion
`Spec A ⟶ X`: if the exceptional ideal pulls back to `(x)` and the total transform to `(f)`,
then the ideal is the `x`-saturation of `(f)`. -/
private theorem comap_ker_ι_comp_snd_eq_ker.{v} {X Z : Scheme.{v}} (π : X ⟶ Z)
    (C : Z.IdealSheafData) (E : X.IdealSheafData) {A : Type v} [CommRing A]
    (g : Spec (.of A) ⟶ X) [IsOpenImmersion g]
    [QuasiCompact (((pullback.snd C.subschemeι π) ⁻¹ᵁ E.support.compl).ι ≫
      pullback.snd C.subschemeι π)]
    (x fA f₁ : A)
    (hE : E.comap g = (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {x})))).ker)
    (hT : (C.comap π).comap g =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {fA})))).ker)
    (hsat : ∀ b : A, (∃ N : ℕ, x ^ N * b ∈ Ideal.span {fA}) ↔ b ∈ Ideal.span {f₁}) :
    ((((pullback.snd C.subschemeι π) ⁻¹ᵁ E.support.compl).ι ≫
        pullback.snd C.subschemeι π).ker).comap g =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f₁})))).ker := by
  rw [comap_ker_eq_ker_pullbackSnd, ker_pullbackSnd_comp, ker_pullbackSnd_ι_comp]
  set q := pullback.snd C.subschemeι π
  set ψ := (Scheme.ΓSpecIso (.of A)).inv.hom
  have hW : g ⁻¹ᵁ E.support.compl = (Spec (.of A)).basicOpen (ψ x) := by
    ext z
    have := congrArg (z ∈ ·) (coe_support_ker_specMap_quotientMk x)
    rw [← hE] at this
    simp only [Scheme.IdealSheafData.support_comap, eq_iff_iff] at this
    have h3 : z ∈ (g ⁻¹ᵁ E.support.compl : Set (Spec (.of A))) ↔
        ¬ (z ∈ (E.support.preimage g.continuous : Set (Spec (.of A)))) := Iff.rfl
    rw [h3, this, Set.mem_compl_iff, not_not]
  have hopen : (pullback.fst q g) ⁻¹ᵁ (q ⁻¹ᵁ E.support.compl) =
      (pullback q g).basicOpen ((pullback.snd q g).appTop (ψ x)) := by
    have h := Scheme.preimage_basicOpen (pullback.snd q g) (U := ⊤) (ψ x)
    rw [← hW] at h
    refine Eq.trans ?_ h
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, pullback.condition]
  rw [ker_ι_comp_congr hopen]
  haveI : IsAffine (pullback q g) := isAffine_of_isAffineHom (pullback.snd q g)
  haveI : IsAffine ((pullback q g).basicOpen ((pullback.snd q g).appTop (ψ x))) :=
    (isAffineOpen_top _).basicOpen _
  have hq' : (pullback.snd q g).ker =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {fA})))).ker := by
    rw [← pullbackSymmetry_hom_comp_fst, Scheme.Hom.ker_comp_of_isIso,
      Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]
    change (pullback.snd C.subschemeι π).ker.comap g = _
    rw [← pullbackSymmetry_hom_comp_fst,
      Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
      Scheme.IdealSheafData.ker_subschemeι, hT]
  apply Scheme.IdealSheafData.ext_of_isAffine
  ext a
  rw [mem_ker_basicOpen_ι_comp_iff, ideal_ker_specMap_quotientMk_top, hq',
    ideal_ker_specMap_quotientMk_top]
  have hψ : ∀ u v : A, ψ u ∈ Ideal.span {ψ v} ↔ u ∈ Ideal.span {v} := by
    intro u v
    simp only [Ideal.mem_span_singleton]
    constructor
    · rintro ⟨c, hc⟩
      refine ⟨(Scheme.ΓSpecIso (.of A)).hom.hom c, ?_⟩
      have := congrArg (Scheme.ΓSpecIso (.of A)).hom.hom hc
      rwa [map_mul, CommRingCat.hom_inv_apply, CommRingCat.hom_inv_apply] at this
    · rintro ⟨c, rfl⟩
      exact ⟨ψ c, map_mul _ _ _⟩
  obtain ⟨b, rfl⟩ : ∃ b, ψ b = a :=
    ⟨(Scheme.ΓSpecIso (.of A)).hom.hom a, CommRingCat.hom_inv_apply _ a⟩
  have hmul : ∀ N : ℕ, ψ x ^ N * ψ b = ψ (x ^ N * b) := fun N => by rw [map_mul, map_pow]
  simp only [hmul]
  exact (exists_congr fun N => hψ _ _).trans ((hsat b).trans (hψ _ _).symm)

end Geometry

/-- The blow-up of a Noetherian scheme is Noetherian: it is proper, hence of finite type and
quasi-compact, over the base. -/
private theorem isNoetherian_blowUp.{v} {Y : Scheme.{v}} [hY : IsNoetherian Y]
    (W : Y.IdealSheafData) : IsNoetherian (blowUp W) := by
  have : IsLocallyNoetherian Y := hY.toIsLocallyNoetherian
  have : IsProper (blowUpToBase W) := isProper_blowUpToBase (I := W)
  have : IsLocallyNoetherian (blowUp W) :=
    LocallyOfFiniteType.isLocallyNoetherian (blowUpToBase W)
  have : CompactSpace Y := hY.toCompactSpace
  have : CompactSpace (blowUp W) := QuasiCompact.compactSpace_of_compactSpace (blowUpToBase W)
  exact { }

/-- **Equation of the birational transform in a chart** (Kollár 1.38). Let `S` be a Noetherian
scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension `2`,
`c = (U = Spec R, x, y)` a coordinate neighbourhood of `p`, `e : D₊(xt) ≅ Spec R[y/x]` an
isomorphism over `S`, and `C ⊆ S` a closed subscheme whose ideal on `U` is `f R`, where the germ
of `f` at `p` has multiplicity `m`. If `f¹ ∈ R[y/x]` satisfies `f = x^m f¹`, then the birational
transform `C₁ = MMP.Resolution.birationalTransform p hp C` pulls back along
`Spec R[y/x] ≅ D₊(xt) ⊆ B_pS` to the closed subscheme `Spec R[y/x] / f¹ R[y/x]`. -/
@[mmp "lem_kr1b_birational_transform_chart_equation"]
public theorem CoordinateNeighbourhood.comap_birationalTransform_eq_ker
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (f : Γ(S, c.U)) (m : ℕ) (hm : mult ((S.presheaf.germ c.U p c.mem).hom f) = m)
    (C : S.IdealSheafData) (hC : C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f})
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (e : (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.toScheme ≅
        Spec (CommRingCat.of (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y})))
    (he : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) ≫
          c.isAffineOpen.fromSpec =
        (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (f₁ : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y})
    (hf₁ : algebraMap Γ(S, c.U) _ f = algebraMap Γ(S, c.U) _ c.x ^ m * f₁) :
    (birationalTransform p hp C).comap
        (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {f₁})))).ker := by
  have := c.isDomain
  have hxB : IsLeftRegular (algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
      {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x) :=
    isLeftRegular_algebraMap_subalgebra _ (IsLocalization.map_units (FractionRing Γ(S, c.U))
      (⟨c.x, mem_nonZeroDivisors_of_ne_zero (c.x_ne_zero hdim)⟩ :
        nonZeroDivisors Γ(S, c.U)))
  have hE :=
    (CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv
      hp hreg hdim c hx e he).1
  have hφC := c.exceptionalChartPolynomialEquiv_C hp hreg hdim
  have hφX := c.exceptionalChartPolynomialEquiv_X hp hreg hdim
  let φ := c.exceptionalChartPolynomialEquiv hp hreg hdim
  -- the leading term of `f`
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  have hmax : IsLocalRing.maximalIdeal (S.presheaf.stalk p) =
      Ideal.span {(S.presheaf.germ c.U p c.mem).hom c.x,
        (S.presheaf.germ c.U p c.mem).hom c.y} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal
      (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal, ← c.span_eq, Ideal.map_span,
      Set.image_pair]
    rfl
  obtain ⟨⟨F, hF, -⟩, hF0⟩ := MMP.Resolution.Kollar.existsUnique_isLeadingTerm hdim hmax
    (f := (S.presheaf.germ c.U p c.mem).hom f) (by rw [hm]; exact ENat.coe_ne_top m)
  obtain ⟨f₁', hf₁', hφF⟩ :=
    CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq hp hreg hdim c f m hm F hF
  have hf₁eq : f₁' = f₁ := (hxB.pow m) (hf₁'.symm.trans hf₁)
  have hmk := hφF φ.toRingHom hφC hφX
  have hFm : F.IsHomogeneous m := by
    obtain ⟨m', hm', hFh, -⟩ := hF
    have : (m' : ℕ∞) = m := hm'.symm.trans hm
    rwa [Nat.cast_inj.mp this] at hFh
  have hnot : f₁ ∉ Ideal.span {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
      {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x} := by
    intro h
    have h0 := Ideal.Quotient.eq_zero_iff_mem.mpr h
    rw [← hf₁eq, ← hmk] at h0
    exact aeval_one_X_ne_zero hFm (hF0 F hF) ((map_eq_zero_iff φ φ.injective).mp h0)
  have hprime : (Ideal.span {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
      {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x}).IsPrime := by
    haveI := Function.Injective.isDomain φ.symm.toRingHom φ.symm.injective
    exact (Ideal.Quotient.isDomain_iff_prime _).mp this
  -- the geometry
  haveI : IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :=
    isNoetherian_blowUp _
  have hT := comap_comap_eq_ker_specMap C
    (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) c.isAffineOpen
    (CommRingCat.ofHom (algebraMap Γ(S, c.U) _))
    (by rw [Category.assoc, ← he, Iso.inv_hom_id_assoc])
    (by rw [Ideal.map_span, Set.image_singleton]) hC
  have hsat : ∀ b : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
      (∃ N : ℕ, algebraMap Γ(S, c.U) _ c.x ^ N * b ∈ Ideal.span {algebraMap Γ(S, c.U) _ f}) ↔
        b ∈ Ideal.span {f₁} := fun b => by
    rw [hf₁]
    exact exists_pow_mul_mem_span_iff hprime hxB hnot m b
  exact comap_ker_ι_comp_snd_eq_ker _ C _ _ _ _ f₁ hE hT hsat

end

/-! ### The birational transform meets the exceptional curve -/

section

open Stacks.Blowup

/-- `V(I) ∩ V(J) = V(I + J)` for the closed subschemes `Spec (A ⧸ I)` of `Spec A`, and the
latter is the closed subscheme cut out by any `g` with kernel `I ⊔ J`. -/
private theorem ker_specMap_sup.{v} {A B : Type v} [CommRing A] [CommRing B] (I J : Ideal A)
    (g : A →+* B) (hg : RingHom.ker g = I ⊔ J) :
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).ker ⊔
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))).ker =
      (Spec.map (CommRingCat.ofHom g)).ker := by
  rw [ker_specMap, ker_specMap, ker_specMap, Ideal.mk_ker, Ideal.mk_ker, hg, Ideal.map_sup,
    ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply,
    ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply,
    ← Scheme.IdealSheafData.equivOfIsAffine_symm_apply, map_sup]

/-- In `A ⧸ (t)`, with `ψ : P ≃+* A ⧸ (t)` and `ψ a = [s]`, the kernel of
`A → A ⧸ (t) → P → P ⧸ (a)` is `(s) + (t)`. -/
private theorem ker_comp_eq_sup {A P : Type*} [CommRing A] [CommRing P] (t s : A) (a : P)
    (ψ : P ≃+* A ⧸ Ideal.span {t}) (hψ : ψ a = Ideal.Quotient.mk _ s) :
    RingHom.ker ((Ideal.Quotient.mk (Ideal.span {a})).comp
        (ψ.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {t})))) =
      Ideal.span {s} ⊔ Ideal.span {t} := by
  rw [← RingHom.comap_ker, Ideal.mk_ker]
  have h : Ideal.comap ψ.symm.toRingHom (Ideal.span {a}) = Ideal.span {ψ a} := by
    ext q
    simp only [Ideal.mem_comap, Ideal.mem_span_singleton]
    rw [← map_dvd_iff ψ]
    exact Iff.of_eq (congrArg _ (ψ.apply_symm_apply q))
  rw [← Ideal.comap_comap, h, hψ, ← Set.image_singleton, ← Ideal.map_span,
    Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]

/-- **The birational transform meets the exceptional curve in the leading term** (Kollár 1.40).
Let `S` be a Noetherian scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension `2`,
`c = (U = Spec R, x, y)` a coordinate neighbourhood of `p`, `e : D₊(xt) ≅ Spec R[y/x]` an
isomorphism over `S`, and `C ⊆ S` a closed subscheme whose ideal on `U` is `f R`, where the germ
of `f` at `p` has multiplicity `m` and leading term `F` with respect to the germs of `x, y`.
Then for every ring isomorphism `φ : κ(p)[Y] ≃ R[y/x] / x R[y/x]` sending residues of `r ∈ R`
to the class of `r` and `Y` to the class of `y/x`, the intersection `C₁ ∩ E` of the birational
transform `C₁ = MMP.Resolution.birationalTransform p hp C` with the exceptional curve pulls back
along `Spec R[y/x] ≅ D₊(xt) ⊆ B_pS` to the closed subscheme cut out by the kernel of
`R[y/x] → R[y/x] / x R[y/x] ≃ κ(p)[Y] → κ(p)[Y] / (F(1, Y))`. -/
@[mmp "lem_kr1b_strict_transform_restriction_to_exceptional"]
public theorem CoordinateNeighbourhood.comap_birationalTransform_sup_exceptionalIdeal_eq_ker
    {S : Scheme.{u}} [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    (f : Γ(S, c.U)) (m : ℕ) (hm : mult ((S.presheaf.germ c.U p c.mem).hom f) = m)
    (F : MvPolynomial (Fin 2) (S.residueField p))
    (hF : IsLeadingTerm ((S.presheaf.germ c.U p c.mem).hom c.x)
      ((S.presheaf.germ c.U p c.mem).hom c.y) ((S.presheaf.germ c.U p c.mem).hom f) F)
    (C : S.IdealSheafData) (hC : C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f})
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (e : (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.toScheme ≅
        Spec (CommRingCat.of (Algebra.adjoin Γ(S, c.U)
          {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y})))
    (he : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) _)) ≫
          c.isAffineOpen.fromSpec =
        (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (φ : Polynomial (S.residueField p) ≃+*
        (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
            algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) ⧸
          Ideal.span {algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U)
            {z : FractionRing Γ(S, c.U) |
              algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x})
    (hφC : ∀ r : Γ(S, c.U), φ (Polynomial.C ((S.evaluation c.U p c.mem).hom r)) =
      Ideal.Quotient.mk _ (algebraMap Γ(S, c.U) _ r))
    (hφX : ∀ z : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
        algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y →
        φ Polynomial.X = Ideal.Quotient.mk _ z) :
    (birationalTransform p hp C ⊔
        AlgebraicGeometry.exceptionalIdeal
          (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).comap
        (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
          ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι) =
      (Spec.map (CommRingCat.ofHom
        ((Ideal.Quotient.mk (Ideal.span {MvPolynomial.aeval ![1, Polynomial.X] F})).comp
          (φ.symm.toRingHom.comp (Ideal.Quotient.mk _))))).ker := by
  obtain ⟨f₁, hf₁, hφ⟩ :=
    CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq hp hreg hdim c f m hm F hF
  have h₁ := CoordinateNeighbourhood.comap_birationalTransform_eq_ker hp hreg hdim c f m hm C hC
    hx e he f₁ hf₁
  have h₂ :=
    (CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv
      hp hreg hdim c hx e he).1
  have h₃ := ker_comp_eq_sup _ f₁ (MvPolynomial.aeval ![1, Polynomial.X] F) φ
    (hφ φ.toRingHom hφC hφX)
  have h₄ := ker_specMap_sup _ _ _ h₃
  refine (Scheme.IdealSheafData.comap_sup _ _ _).trans ((congrArg₂ (· ⊔ ·) h₁ h₂).trans ?_)
  convert h₄ using 4

end

end MMP.Resolution

end
