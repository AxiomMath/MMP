module

public import MMP.AlgebraicGeometry.Resolution.CurveOnSurface.MultiplicityOneBlowup
public import MMP.AlgebraicGeometry.Resolution.CurveOnSurface.MultiplePoint
public import MMP.AlgebraicGeometry.Resolution.Blowup.PointBlowupSequence

/-!
# Blow-up sequences of constant multiplicity and ideal membership

Let `S₀` be a two-dimensional regular Noetherian scheme, `C₀ ⊆ S₀` a reduced curve (an effective
Cartier divisor with reduced subscheme) and `p₀ ∈ C₀` a closed point with `mult_{p₀} C₀ = m ≥ 2`;
let `R₀ = 𝒪_{S₀,p₀}` and `f` a local equation of `C₀` at `p₀`. This file proves Kollár's
characterisation of blow-up sequences of multiplicity `m` starting at `p₀` by the membership of
`f` in the ideals `(x^{k+1}, y)^m`.

*If.* If `(x, y')` is a regular system of parameters of `R₀` with `f ∈ (x^{k+1}, y')^m`, then
the points `p_i = (x, y'/x^i)` of the charts `Spec R₀[y'/x^i]`, `i ≤ k`, form a blow-up sequence
of multiplicity `m` of length `k`, with `(x, y'/x^i)` a regular system of parameters at `p_i` and
`x^{-mi} f` a local equation of the `i`-th transform. The proof is by induction on `k`: in the
chart `Spec R[y'/x]` of a coordinate neighbourhood, `(x^{k+1}, y')^m = x^m (x^k, y'/x)^m`, so the
equation `x^{-m} f` of the birational transform lies in `(x^k, y'/x)^m`, its multiplicity at
`p₁ = (x, y'/x)` is at least `m`, and the bound on the sum of the multiplicities over `p₀` gives
equality.

*Moreover.* If moreover `f` is in normal form with respect to `(x, y')` when `k = 0`, and a
blow-up sequence of multiplicity `m` of length at least `k + 1` starts at `p₀`, then
`f ∈ (x^{k+2}, y' - a x^{k+1})^m` for some `a ∈ R₀`. At the `k`-th point, `f_k = x^{-mk} f` is
in normal form with respect to a regular system of parameters `(X, Y)`, and `p_{k+1}` is the chart
point `(X, Y/X)`; so `f_k ∈ (X^2, Y)^m`, and `(Y) + 𝔪^2 = (y'/x^k - a x) + 𝔪^2` for some `a`,
because `f` is in normal form for `k = 0` and the exceptional curve `x = 0` is not tangent to
`C_k` for `k ≥ 1`. Contracting from the local rings of the charts ends the proof.

*Only if.* If a blow-up sequence of multiplicity `m` of length `k ∈ ℕ ∪ {∞}` starts at `p₀`,
there are a regular system of parameters `(x, y)` of `R₀` and `a_j ∈ R₀` with
`f ∈ (x^{j+1}, y - ∑_{i=1}^j a_i x^i)^m` for every finite `j ≤ k`: the coefficients are chosen
one at a time by the previous result.

## Main results

* `MMP.Resolution.PointBlowupSequence.exists_isConstantMultiplicity_of_mem_span_pow`: ideal
  membership gives a blow-up sequence of multiplicity `m` along the chart points `(x, y'/x^i)`.
* `MMP.Resolution.PointBlowupSequence.exists_mem_span_pow_of_isConstantMultiplicity`: a blow-up
  sequence of length at least `k + 1` gives the next coefficient `a`.
* `MMP.Resolution.PointBlowupSequence.exists_forall_mem_span_pow_of_isConstantMultiplicity`: a
  blow-up sequence of multiplicity `m` gives ideal membership for every finite `j ≤ k`.

## Implementation notes

The ring `R₀` maps to `𝒪_{S_i,p_i}` by the stalk map of `π_i : S_i → S₀` at `p_i`, composed with
the identification of stalks given by `π_i(p_i) = p₀`; write `φ_i` for it. The elements `y'/x^i`
and `x^{-mi} f` are the `t` and `g` with `φ_i(x)^i t = φ_i(y')` and `φ_i(x)^{mi} g = φ_i(f)`. The
chart `Spec R₀[y'/x^i]` is recorded through its local ring: `𝒪_{S_i,p_i}` is the localization of
`R₀[t]` at the contraction of the maximal ideal. In the proofs this is carried as the statement
that every element of `𝒪_{S_i,p_i}` is a fraction `F(t)/G(t)` of polynomials over `R₀`
(`MMP.Resolution.Kr1c.IsPolynomialFraction`), which is transitive along the sequence.

The induction for the first result builds the sequence from the front: a sequence of point
blow-ups of `B_{p₀}S₀` starting at `p₁` is extended by the blow-up of `p₀`. It is applied on
`B_{p₀}S₀`, which is regular only along the exceptional curve; it needs of the curve only that
its stalks are generated by nonzerodivisors (`MMP.Resolution.Kr1c.HasPrincipalStalks`), and of
the point only a regular system of parameters.

In the second result the hypothesis on the sequence is `k + 1 ≤ length` in `ℕ∞` rather than
`length = k + 1`; the conclusion only concerns the first `k + 1` blow-ups. In the third, the
coefficients form a single sequence `a : ℕ → R₀`, and "`j ≤ k`, `j < ∞`" is
`(j : ℕ∞) ≤ s.length` for `j : ℕ`.

## References

* [J. Kollár, *Lectures on resolution of singularities*][kollar2007], Proposition 1.69.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry IsLocalRing MMP.Resolution.Kr1c

universe u

namespace MMP.Resolution.PointBlowupSequence

/-! ### A blow-up sequence of constant multiplicity from ideal membership -/

section

section Algebra

variable {R : Type*} [CommRing R]

/-- In a domain, the powers of a nonzero element are nonzero. Stated over `[IsDomain R]` so that
`NoZeroDivisors` comes from the domain instance: on stalks of blow-ups the direct search for it
runs through `IsReduced` and times out. -/
private theorem pow_ne_zero_of_isDomain [IsDomain R] {a : R} (h : a ≠ 0) (n : ℕ) : a ^ n ≠ 0 :=
  pow_ne_zero n h

end Algebra

section LocalRing

open MMP.Resolution

variable {O : Type*} [CommRing O] [IsLocalRing O]

/-- An ideal of finite positive order is proper. -/
private theorem ne_top_of_idealOrder_eq {I : Ideal O} {m : ℕ} (hI : idealOrder I = m)
    (hm : 1 ≤ m) : I ≠ ⊤ := by
  rintro rfl
  have h := (natCast_le_idealOrder_iff' (⊤ : Ideal O) 1).mp (by rw [hI]; exact_mod_cast hm)
  rw [pow_one, top_le_iff] at h
  exact (maximalIdeal.isMaximal O).ne_top h

/-- In a two-dimensional Noetherian local ring, `𝔪` is not contained in `(v) + 𝔪²` for any
`v ∈ 𝔪`. -/
private theorem false_of_le_span_singleton_sup_smul [IsNoetherianRing O]
    (hdim : ringKrullDim O = 2) {v : O} (hv : v ∈ maximalIdeal O)
    (hle : maximalIdeal O ≤ Ideal.span {v} ⊔ maximalIdeal O • maximalIdeal O) : False := by
  have hle' : maximalIdeal O ≤ Ideal.span {v} :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Ideal.fg_of_isNoetherianRing _)
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]) hle
  have h1 : (maximalIdeal O).spanFinrank ≤ 1 := by
    rw [le_antisymm hle' ((Ideal.span_singleton_le_iff_mem _).mpr hv)]
    simpa using Submodule.spanFinrank_span_le_ncard_of_finite (R := O) (Set.finite_singleton v)
  have h2 := ringKrullDim_le_spanFinrank_maximalIdeal (R := O)
  rw [hdim] at h2
  have : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    h2.trans (by exact_mod_cast h1)
  exact absurd ((Nat.cast_le (α := WithBot ℕ∞)).mp this) (by omega)

/-- In a two-dimensional regular local ring, the quotient by an element of multiplicity at least
two is not regular. -/
private theorem not_isRegularLocalRing_quotient [IsRegularLocalRing O]
    (hdim : ringKrullDim O = 2) {g : O} {m : ℕ} (hg : idealOrder (Ideal.span {g}) = m)
    (hm : 2 ≤ m) : ¬ IsRegularLocalRing (O ⧸ Ideal.span {g}) := by
  intro hQ
  haveI := IsRegularLocalRing.isDomain O
  have hg2 : g ∈ maximalIdeal O ^ 2 :=
    (natCast_le_idealOrder_iff' (Ideal.span {g}) 2).mp (by rw [hg]; exact_mod_cast hm)
      (Ideal.mem_span_singleton_self g)
  have hg0 : g ≠ 0 := by
    rintro rfl
    have h := (natCast_le_idealOrder_iff' (Ideal.span {(0 : O)}) (m + 1)).mpr
      (by rw [Ideal.span_singleton_eq_bot.mpr rfl]; exact bot_le)
    rw [hg] at h
    exact absurd (Nat.cast_le.mp h) (by omega)
  have hgm : g ∈ maximalIdeal O :=
    Ideal.pow_le_self two_ne_zero hg2
  -- the quotient has dimension at most one
  have hdimQ : ringKrullDim (O ⧸ Ideal.span {g}) + 1 ≤ 2 := by
    rw [← hdim]
    exact ringKrullDim_quotient_succ_le_of_nonZeroDivisor (mem_nonZeroDivisors_of_ne_zero hg0)
  have hrk : (maximalIdeal (O ⧸ Ideal.span {g})).spanFinrank ≤ 1 := by
    have h := hQ.spanFinrank_maximalIdeal
    rw [← h] at hdimQ
    have key : (((maximalIdeal (O ⧸ Ideal.span {g})).spanFinrank + 1 : ℕ) : WithBot ℕ∞) ≤
        ((2 : ℕ) : WithBot ℕ∞) := by
      push_cast; exact hdimQ
    have := (Nat.cast_le (α := WithBot ℕ∞)).mp key
    omega
  obtain ⟨s, hs, hspan⟩ :=
    Submodule.FG.exists_span_finset_card_eq_spanFinrank
      (Ideal.fg_of_isNoetherianRing (maximalIdeal (O ⧸ Ideal.span {g})))
  obtain ⟨hbar, hsub, hbarm⟩ : ∃ hbar, s ⊆ {hbar} ∧ hbar ∈ maximalIdeal (O ⧸ Ideal.span {g}) := by
    rcases s.eq_empty_or_nonempty with rfl | ⟨b, hb⟩
    · exact ⟨0, Finset.empty_subset _, Ideal.zero_mem _⟩
    · refine ⟨b, fun a ha => ?_, hspan ▸ Submodule.subset_span hb⟩
      rw [Finset.mem_singleton]
      exact Finset.card_le_one.mp (hs.trans_le hrk) a ha b hb
  obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective hbar
  have hhm : h ∈ maximalIdeal O := by
    by_contra hh
    exact (maximalIdeal (O ⧸ Ideal.span {g})).ne_top_iff_one.mp (maximalIdeal.isMaximal _).ne_top
      ((maximalIdeal (O ⧸ Ideal.span {g})).eq_top_of_isUnit_mem hbarm
        ((IsLocalRing.notMem_maximalIdeal.mp hh).map _) ▸ Submodule.mem_top)
  -- `𝔪 ⊆ (h) + 𝔪²`
  have hle : maximalIdeal O ≤ Ideal.span {h} ⊔ maximalIdeal O • maximalIdeal O := by
    intro a ha
    have hamem : Ideal.Quotient.mk (Ideal.span {g}) a ∈
        maximalIdeal (O ⧸ Ideal.span {g}) := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      rintro ⟨u, hu⟩
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (↑u⁻¹ : O ⧸ Ideal.span {g})
      have h1 : Ideal.Quotient.mk (Ideal.span {g}) (a * b) = 1 := by
        rw [map_mul, ← hu, hb, Units.mul_inv]
      rw [← map_one (Ideal.Quotient.mk (Ideal.span {g})), Ideal.Quotient.eq] at h1
      have h2 : a * b - 1 ∈ maximalIdeal O :=
        (Ideal.span_singleton_le_iff_mem _).mpr hgm h1
      have h3 : (1 : O) ∈ maximalIdeal O := by
        have := (maximalIdeal O).sub_mem (Ideal.mul_mem_right b _ ha) h2
        simpa using this
      exact (maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    rw [← hspan] at hamem
    have hamem' := Submodule.span_mono (by exact_mod_cast hsub) hamem
    rw [Finset.coe_singleton, Ideal.mem_span_singleton'] at hamem'
    obtain ⟨cbar, hc⟩ := hamem'
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective cbar
    rw [← map_mul, Ideal.Quotient.eq] at hc
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hc
    have : a = c * h - d * g := by rw [hd]; ring
    rw [this, sub_eq_add_neg]
    refine Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self h)) ?_
    rw [Ideal.smul_eq_mul, ← pow_two]
    exact Submodule.neg_mem _ (Ideal.mul_mem_left _ _ hg2)
  exact false_of_le_span_singleton_sup_smul hdim hhm hle

end LocalRing

section Stalks

/-- The stalk map of the identity is the identity. -/
private theorem stalkHom_id {X : Scheme.{u}} (x : X) (h : (𝟙 X : X ⟶ X) x = x)
    (a : X.presheaf.stalk x) : stalkHom (𝟙 X) x h a = a := by
  simp [stalkHom, TopCat.Presheaf.stalkCongr]

end Stalks

section Sequences

open MMP.Resolution

/-- `i + 1 < n + 1` iff `i < n` in `ℕ∞`. -/
private theorem natCast_succ_lt_add_one_iff (i : ℕ) (n : ℕ∞) :
    ((i + 1 : ℕ) : ℕ∞) < n + 1 ↔ (i : ℕ∞) < n := by
  push_cast
  exact ENat.add_lt_add_iff_right ENat.one_ne_top

/-- `i + 1 ≤ n + 1` iff `i ≤ n` in `ℕ∞`. -/
private theorem natCast_succ_le_add_one_iff (i : ℕ) (n : ℕ∞) :
    ((i + 1 : ℕ) : ℕ∞) ≤ n + 1 ↔ (i : ℕ∞) ≤ n := by
  push_cast
  exact ENat.add_le_add_iff_right ENat.one_ne_top

/-- The schemes `S₀, T₀, T₁, …`. -/
private def consS (S₀ : Scheme.{u}) (T : ℕ → Scheme.{u}) : ℕ → Scheme.{u}
  | 0 => S₀
  | i + 1 => T i

/-- The points `p₀, q₀, q₁, …`. -/
private def consP {S₀ : Scheme.{u}} (p₀ : S₀) {T : ℕ → Scheme.{u}} (q : ∀ i, T i) :
    ∀ i, consS S₀ T i
  | 0 => p₀
  | i + 1 => q i

variable {S₀ : Scheme.{u}} (p₀ : S₀) (hp₀ : IsClosed ({p₀} : Set S₀))
  (s : PointBlowupSequence (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p₀}, hp₀⟩)))

/-- The points `p₀, q₀, q₁, …` of the prepended sequence are closed. -/
private theorem consP_isClosed :
    ∀ i : ℕ, (i : ℕ∞) < s.length + 1 → IsClosed ({consP p₀ s.p i} : Set (consS S₀ s.S i))
  | 0, _ => hp₀
  | i + 1, h => s.isClosed_p i ((natCast_succ_lt_add_one_iff i s.length).mp h)

/-- The identifications of the prepended sequence with the blow-ups of its points. -/
private noncomputable def consIso :
    ∀ (i : ℕ) (hi : (i : ℕ∞) < s.length + 1), consS S₀ s.S (i + 1) ≅
      blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{consP p₀ s.p i}, consP_isClosed p₀ hp₀ s i hi⟩)
  | 0, _ => s.zeroIso
  | i + 1, h => s.blowupIso i ((natCast_succ_lt_add_one_iff i s.length).mp h)

/-- The sequence `S₀ ← B_{p₀}S₀ = T₀ ← T₁ ← ⋯` obtained by putting the blow-up of `p₀` in front
of a sequence of point blow-ups of `B_{p₀}S₀`. -/
private noncomputable def consSeq : PointBlowupSequence S₀ where
  length := s.length + 1
  S := consS S₀ s.S
  zeroIso := Iso.refl S₀
  p := consP p₀ s.p
  isClosed_p := consP_isClosed p₀ hp₀ s
  blowupIso := consIso p₀ hp₀ s

/-- The composite `π_{i+1}` of the prepended sequence is `π_i` followed by the blow-up of `p₀`. -/
private theorem consSeq_π_succ (i : ℕ) (hi : ((i + 1 : ℕ) : ℕ∞) ≤ (consSeq p₀ hp₀ s).length)
    (hi' : (i : ℕ∞) ≤ s.length) :
    (consSeq p₀ hp₀ s).π (i + 1) hi =
      s.π i hi' ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p₀}, hp₀⟩) := by
  induction i with
  | zero =>
    show (s.zeroIso.hom ≫ _) ≫ (Iso.refl S₀).hom = s.zeroIso.hom ≫ _
    rw [Iso.refl_hom, Category.comp_id]
    rfl
  | succ i ih =>
    show s.σ i _ ≫ (consSeq p₀ hp₀ s).π (i + 1) _ = (s.σ i _ ≫ s.π i _) ≫ _
    rw [ih _ (PointBlowupSequence.coe_lt_of_succ_le hi').le, Category.assoc]

/-- The `(i+1)`-st transform of `C₀` in the prepended sequence is the `i`-th transform of the
birational transform of `C₀`. -/
private theorem consSeq_transformedSubscheme_succ (C₀ : S₀.IdealSheafData) (i : ℕ) :
    (consSeq p₀ hp₀ s).transformedSubscheme C₀ (i + 1) =
      s.transformedSubscheme (birationalTransform p₀ hp₀ C₀) i := by
  induction i with
  | zero =>
    have h0 : ((0 : ℕ) : ℕ∞) < (consSeq p₀ hp₀ s).length := by
      show ((0 : ℕ) : ℕ∞) < s.length + 1
      rw [Nat.cast_zero]; exact lt_of_lt_of_le zero_lt_one le_add_self
    show (if hi : ((0 : ℕ) : ℕ∞) < (consSeq p₀ hp₀ s).length then
      (birationalTransform ((consSeq p₀ hp₀ s).p 0) ((consSeq p₀ hp₀ s).isClosed_p 0 hi)
        ((consSeq p₀ hp₀ s).transformedSubscheme C₀ 0)).comap
          ((consSeq p₀ hp₀ s).blowupIso 0 hi).hom else ⊤) = _
    rw [dif_pos h0]
    show (birationalTransform p₀ _ (C₀.comap (Iso.refl S₀).hom)).comap s.zeroIso.hom = _
    rw [Iso.refl_hom, Scheme.IdealSheafData.comap_id]
    rfl
  | succ i ih =>
    show (if hi : ((i + 1 : ℕ) : ℕ∞) < (consSeq p₀ hp₀ s).length then
      (birationalTransform ((consSeq p₀ hp₀ s).p (i + 1)) ((consSeq p₀ hp₀ s).isClosed_p (i + 1) hi)
        ((consSeq p₀ hp₀ s).transformedSubscheme C₀ (i + 1))).comap
          ((consSeq p₀ hp₀ s).blowupIso (i + 1) hi).hom else ⊤) =
      (if hi : (i : ℕ∞) < s.length then
        (birationalTransform (s.p i) (s.isClosed_p i hi)
          (s.transformedSubscheme (birationalTransform p₀ hp₀ C₀) i)).comap
            (s.blowupIso i hi).hom else ⊤)
    by_cases h : (i : ℕ∞) < s.length
    · have h' : ((i + 1 : ℕ) : ℕ∞) < (consSeq p₀ hp₀ s).length :=
        (natCast_succ_lt_add_one_iff i s.length).mpr h
      rw [dif_pos h', dif_pos h]
      exact congrArg (fun Z => (birationalTransform (s.p i) (s.isClosed_p i h) Z).comap
        (s.blowupIso i h).hom) ih
    · have h' : ¬ ((i + 1 : ℕ) : ℕ∞) < (consSeq p₀ hp₀ s).length :=
        fun h' => h ((natCast_succ_lt_add_one_iff i s.length).mp h')
      rw [dif_neg h', dif_neg h]
      rfl

end Sequences

section ChartAlgebra

open MMP.Resolution Polynomial

variable {R O : Type*} [CommRing R] [CommRing O]

/-- A polynomial expression in `t`, times a power of `φ x`, comes from `R` when
`φ x ^ a * t = φ y`. -/
private theorem exists_pow_mul_eval₂_eq {φ : R →+* O} {t : O} {x y : R} {a : ℕ}
    (ht : φ x ^ a * t = φ y) (F : R[X]) : ∃ (N : ℕ) (r : R), φ x ^ N * F.eval₂ φ t = φ r := by
  induction F using Polynomial.induction_on with
  | C c => exact ⟨0, c, by simp⟩
  | add F G hF hG =>
    obtain ⟨N, r, hr⟩ := hF
    obtain ⟨N', r', hr'⟩ := hG
    refine ⟨N + N', x ^ N' * r + x ^ N * r', ?_⟩
    rw [eval₂_add, map_add, map_mul, map_mul, map_pow, map_pow, ← hr, ← hr']
    ring
  | monomial n c h =>
    obtain ⟨N, r, hr⟩ := h
    refine ⟨N + a, r * y, ?_⟩
    rw [map_mul, ← hr, ← ht]
    simp only [eval₂_mul, eval₂_C, eval₂_X_pow, eval₂_X, pow_succ, pow_add]
    ring

/-- Translating the variable keeps fractions: a fraction in `t` is a fraction in `t - φ c`. -/
private theorem IsPolynomialFraction.sub {φ : R →+* O} {t : O} (h : IsPolynomialFraction φ t)
    (c : R) : IsPolynomialFraction φ (t - φ c) := by
  have hcomp : ∀ F : R[X], (F.comp (Polynomial.X + C c)).eval₂ φ (t - φ c) = F.eval₂ φ t := by
    intro F
    rw [eval₂_comp]
    simp
  intro o
  obtain ⟨F, G, hG, ho⟩ := h o
  exact ⟨F.comp (Polynomial.X + C c), G.comp (Polynomial.X + C c), by rwa [hcomp],
    by rw [hcomp, hcomp, ho]⟩

end ChartAlgebra

section Contraction

open MMP.Resolution Polynomial

variable {R O : Type*} [CommRing R] [CommRing O]

/-- In a two-dimensional Noetherian local ring, a member of a regular system of parameters
`(u, v)` is not in `𝔪²`. -/
private theorem notMem_sq_of_span_pair_eq [IsLocalRing O] [IsNoetherianRing O] {u v : O}
    (huv : Ideal.span {u, v} = maximalIdeal O) (hdim : ringKrullDim O = 2) :
    u ∉ maximalIdeal O ^ 2 := by
  intro hu
  have hle : maximalIdeal O ≤ Ideal.span {v} ⊔ maximalIdeal O • maximalIdeal O := by
    rw [← huv, Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Submodule.mem_sup_right (by rw [Ideal.smul_eq_mul, ← pow_two, huv]; exact hu)
    · exact Submodule.mem_sup_left (Ideal.mem_span_singleton_self _)
  exact false_of_le_span_singleton_sup_smul hdim
    (huv ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) hle

/-- **Contraction from a chart.** Let `(x, y)` be a regular system of parameters of a
two-dimensional Noetherian local ring `R`, `φ : R → O` an injective map to a local domain, and
`t ∈ O` with `φ x ^ a t = φ y`, `φ x, t ∈ 𝔪_O`, every element of `O` a fraction of polynomials in
`t` over `R`. Then for `b > a ≥ 1` and `m ≥ 1`, the ideal `(x^b, y)^m` is contracted from `O`. -/
private theorem mem_of_map_mem_span_pow [IsLocalRing R] [IsNoetherianRing R] [IsDomain O]
    [IsLocalRing O] {x y : R} (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y])
    {φ : R →+* O} (hφ : Function.Injective φ) {t : O} {a b m : ℕ} (ha : 1 ≤ a) (hab : a < b)
    (hm : 1 ≤ m) (ht : φ x ^ a * t = φ y) (hxm : φ x ∈ maximalIdeal O)
    (htm : t ∈ maximalIdeal O) (hfrac : IsPolynomialFraction φ t) {r : R}
    (hr : φ r ∈ (Ideal.span {x ^ b, y} ^ m).map φ) : r ∈ Ideal.span {x ^ b, y} ^ m := by
  have hx0 : x ≠ 0 := ne_zero_of_isRegularSystemOfParameters hxy 0
  letI : Algebra R O := φ.toAlgebra
  let K := FractionRing O
  have hRKφ : ∀ r, algebraMap R K r = algebraMap O K (φ r) := fun r =>
    IsScalarTower.algebraMap_apply R O K r
  have hinjK : Function.Injective (algebraMap O K) := IsFractionRing.injective O K
  have hRK : Function.Injective (algebraMap R K) := hinjK.comp hφ
  have hxK : algebraMap R K x ≠ 0 := fun h => hx0 (hRK (h.trans (map_zero _).symm))
  -- every element of `O` is a quotient of elements of `R` in `K`
  have hO : ∀ o : O, ∃ r s : R, algebraMap O K o = algebraMap R K r / algebraMap R K s := by
    intro o
    obtain ⟨F, G, hG, ho⟩ := hfrac o
    obtain ⟨N, r₁, hr₁⟩ := exists_pow_mul_eval₂_eq ht F
    obtain ⟨N', r₂, hr₂⟩ := exists_pow_mul_eval₂_eq ht G
    refine ⟨r₁ * x ^ N', r₂ * x ^ N, ?_⟩
    have hG0 : algebraMap O K (G.eval₂ φ t) ≠ 0 := fun h =>
      hG.ne_zero (hinjK (h.trans (map_zero _).symm))
    have e1 : algebraMap R K r₁ = algebraMap O K (φ x) ^ N * algebraMap O K (F.eval₂ φ t) := by
      rw [← map_pow, ← map_mul, hr₁, hRKφ]
    have e2 : algebraMap R K r₂ = algebraMap O K (φ x) ^ N' * algebraMap O K (G.eval₂ φ t) := by
      rw [← map_pow, ← map_mul, hr₂, hRKφ]
    have e3 : algebraMap R K x = algebraMap O K (φ x) := hRKφ x
    have hφxK : algebraMap O K (φ x) ≠ 0 := e3 ▸ hxK
    rw [map_mul, map_mul, map_pow, map_pow, e1, e2, e3, ← ho, map_mul, eq_div_iff
      (mul_ne_zero (mul_ne_zero (pow_ne_zero _ hφxK) hG0) (pow_ne_zero _ hφxK))]
    ring
  haveI : FaithfulSMul R K := (faithfulSMul_iff_algebraMap_injective R K).mpr hRK
  haveI : IsFractionRing R K := by
    refine IsFractionRing.of_field R K fun z => ?_
    obtain ⟨o₁, o₂, -, rfl⟩ := IsFractionRing.div_surjective (A := O) z
    obtain ⟨r₁, s₁, h₁⟩ := hO o₁
    obtain ⟨r₂, s₂, h₂⟩ := hO o₂
    refine ⟨r₁ * s₂, s₁ * r₂, ?_⟩
    rw [h₁, h₂, map_mul, map_mul, div_div_div_eq]
  -- the chart algebra `R[y/x^a] ⊆ K` is `R[t] ⊆ O`
  let ι : O →ₐ[R] K := IsScalarTower.toAlgHom R O K
  have hιt : algebraMap R K y / algebraMap R K x ^ a = ι t := by
    rw [div_eq_iff (pow_ne_zero _ hxK), hRKφ, hRKφ, ← ht, map_mul, map_pow, mul_comm]
    rfl
  set A := Algebra.adjoin R {algebraMap R K y / algebraMap R K x ^ a} with hA
  let A' := Algebra.adjoin R {t}
  let e₁ : A ≃ₐ[R] A'.map ι := Subalgebra.equivOfEq _ _ (by rw [AlgHom.map_adjoin_singleton, ← hιt])
  let e₂ : A' ≃ₐ[R] A'.map ι := Subalgebra.equivMapOfInjective A' ι hinjK
  let e : A ≃ₐ[R] A' := e₁.trans e₂.symm
  have he : ∀ s : A, ι (e s : O) = (s : K) := fun s =>
    congrArg (fun w : A'.map ι => (w : K)) (by simp [e] : e₂ (e s) = e₁ s)
  set P' := (maximalIdeal O).comap (algebraMap A' O) with hP'
  haveI hloc : IsLocalization.AtPrime O P' := hfrac.isLocalization_atPrime
  letI : Algebra A O := ((algebraMap A' O).comp e.toRingEquiv.toRingHom).toAlgebra
  let S : Submonoid A := P'.primeCompl.comap e.toRingEquiv.toMonoidHom
  haveI : IsLocalization S O := by
    refine ⟨fun s => ?_, fun o => ?_, fun {u v} huv => ?_⟩
    · exact IsLocalization.map_units O (⟨e s, s.2⟩ : P'.primeCompl)
    · obtain ⟨⟨a', s'⟩, h⟩ := IsLocalization.surj P'.primeCompl o
      refine ⟨⟨e.symm a', ⟨e.symm s', by simpa [S] using s'.2⟩⟩, ?_⟩
      simpa [RingHom.algebraMap_toAlgebra] using h
    · refine ⟨1, ?_⟩
      have : (e u : O) = e v := huv
      simp [e.injective (Subtype.ext this)]
  haveI : IsScalarTower R A O := IsScalarTower.of_algebraMap_eq fun r => by
    show φ r = ((e (algebraMap R A r) : A') : O)
    rw [AlgEquiv.commutes]; rfl
  have hS : ∀ s ∈ S, s ∉ Ideal.span {algebraMap R A x,
      ⟨algebraMap R K y / algebraMap R K x ^ a, Algebra.subset_adjoin rfl⟩} := by
    intro s hs hmem
    obtain ⟨c, d, hcd⟩ := Ideal.mem_span_pair.mp hmem
    have htg : ((e ⟨_, Algebra.subset_adjoin rfl⟩ : A') : O) = t :=
      hinjK ((he ⟨_, Algebra.subset_adjoin rfl⟩).trans hιt)
    have hs' : ((e s : A') : O) ∈ maximalIdeal O := by
      rw [← hcd, map_add, map_mul, map_mul, AlgEquiv.commutes]
      simp only [Subalgebra.coe_add, Subalgebra.coe_mul, htg]
      exact add_mem (Ideal.mul_mem_left _ _ hxm) (Ideal.mul_mem_left _ _ htm)
    exact hs hs'
  have key := MMP.Resolution.Kollar.comap_map_span_pow_of_isLocalization_adjoin_div (K := K) hxy
    ha hab hm S hS O
  rwa [← key]

end Contraction

section LocalAlgebra

open MMP.Resolution

variable {O : Type*} [CommRing O] [IsLocalRing O]

/-- `(u^2, v) = (v) + 𝔪^2` when `(u, v)` generates `𝔪`. -/
private theorem span_sq_pair_eq {u v : O} (huv : Ideal.span {u, v} = maximalIdeal O) :
    Ideal.span {u ^ 2, v} = Ideal.span {v} ⊔ maximalIdeal O ^ 2 := by
  have hu : u ∈ maximalIdeal O := huv ▸ Ideal.subset_span (Set.mem_insert _ _)
  have hv2 : v ∈ Ideal.span {u ^ 2, v} := Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Submodule.mem_sup_right (Ideal.pow_mem_pow hu 2)
    · exact Submodule.mem_sup_left (Ideal.mem_span_singleton_self _)
  · refine sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hv2) ?_
    rw [← huv, pow_two, Ideal.span_mul_span', Ideal.span_le]
    rintro _ ⟨a, ha, b, hb, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · show _ * _ ∈ Ideal.span _
      rw [← pow_two]; exact Ideal.subset_span (Set.mem_insert _ _)
    · exact Ideal.mul_mem_left _ _ hv2
    · exact Ideal.mul_mem_right _ _ hv2
    · exact Ideal.mul_mem_left _ _ hv2

/-- Elements congruent modulo `𝔪^2` give the same ideal `(v) + 𝔪^2`. -/
private theorem span_sup_sq_eq {v v' : O} (h : v - v' ∈ maximalIdeal O ^ 2) :
    Ideal.span {v} ⊔ maximalIdeal O ^ 2 = Ideal.span {v'} ⊔ maximalIdeal O ^ 2 := by
  have key : ∀ {a b : O}, a - b ∈ maximalIdeal O ^ 2 →
      Ideal.span {a} ⊔ maximalIdeal O ^ 2 ≤ Ideal.span {b} ⊔ maximalIdeal O ^ 2 := by
    intro a b hab
    refine sup_le ?_ le_sup_right
    rw [Ideal.span_singleton_le_iff_mem, show a = b + (a - b) by ring]
    exact add_mem (Submodule.mem_sup_left (Ideal.mem_span_singleton_self b))
      (Submodule.mem_sup_right hab)
  exact le_antisymm (key h) (key (by rw [← neg_sub]; exact neg_mem h))

/-- The multiplicity of an element of `𝔪^n ∖ 𝔪^{n+1}` is `n`. -/
private theorem mult_eq_of_mem_of_notMem {f : O} {n : ℕ} (h1 : f ∈ maximalIdeal O ^ n)
    (h2 : f ∉ maximalIdeal O ^ (n + 1)) : mult f = n := by
  apply le_antisymm
  · by_contra hlt
    push Not at hlt
    have : ((n + 1 : ℕ) : ℕ∞) ≤ mult f := by
      push_cast; exact Order.add_one_le_of_lt hlt
    exact h2 ((natCast_le_idealOrder_iff' _ _).mp this (Ideal.mem_span_singleton_self f))
  · exact (natCast_le_idealOrder_iff' _ _).mpr ((Ideal.span_singleton_le_iff_mem _).mpr h1)

/-- If `a ≡ b` modulo `𝔪^2` with `a, b ∈ 𝔪`, then `a^{n+1} ≡ b^{n+1}` modulo `𝔪^{n+2}`. -/
private theorem pow_sub_pow_mem {a b : O} (ha : a ∈ maximalIdeal O) (hb : b ∈ maximalIdeal O)
    (hab : a - b ∈ maximalIdeal O ^ 2) :
    ∀ n : ℕ, a ^ (n + 1) - b ^ (n + 1) ∈ maximalIdeal O ^ (n + 2)
  | 0 => by simpa using hab
  | n + 1 => by
    have ih := pow_sub_pow_mem ha hb hab n
    rw [show a ^ (n + 1 + 1) - b ^ (n + 1 + 1) =
      a * (a ^ (n + 1) - b ^ (n + 1)) + b ^ (n + 1) * (a - b) by ring]
    refine add_mem ?_ ?_
    · rw [show n + 1 + 2 = 1 + (n + 2) by ring, pow_add, pow_one]
      exact Ideal.mul_mem_mul ha ih
    · rw [show n + 1 + 2 = (n + 1) + 2 by ring, pow_add]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hb _) hab

/-- An element in normal form with respect to `(x, y)` is `w y^n` modulo `𝔪^{n+1}`, `w` a
unit, where `n` is its multiplicity. -/
private theorem IsInNormalForm.exists_unit {x y f : O} (h : IsInNormalForm x y f) {m : ℕ}
    (hm : mult f = m) : ∃ w : O, w ∉ maximalIdeal O ∧ f - w * y ^ m ∈ maximalIdeal O ^ (m + 1) := by
  obtain ⟨hxy, n, hn1, hn2, hn3⟩ := h
  have hnm : n = m := by
    have := (mult_eq_of_mem_of_notMem hn1 hn2).symm.trans hm
    exact_mod_cast this
  subst hnm
  obtain ⟨g, hg, h', hh', hgh⟩ := Submodule.mem_sup.mp hn3
  obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hg
  have hy : y ∈ maximalIdeal O := hxy ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  refine ⟨w, fun hw => hn2 ?_, by rw [← hgh]; simpa using hh'⟩
  rw [← hgh]
  refine add_mem ?_ hh'
  rw [pow_succ']
  exact Ideal.mul_mem_mul hw (Ideal.pow_mem_pow hy _)

/-- **Two normal forms have the same tangent.** If `f`, of multiplicity `m ≥ 1`, is in normal
form with respect to both `(u, v)` and `(X, Y)`, then `Y ∈ (v) + 𝔪^2`. -/
private theorem mem_span_sup_sq_of_isInNormalForm [IsRegularLocalRing O]
    (hdim : ringKrullDim O = 2) {u v X Y f : O} (h₁ : IsInNormalForm u v f)
    (h₂ : IsInNormalForm X Y f) {m : ℕ} (hm : mult f = m) (hm1 : 1 ≤ m) :
    Y ∈ Ideal.span {v} ⊔ maximalIdeal O ^ 2 := by
  have huv := h₁.1
  have hY : Y ∈ maximalIdeal O := h₂.1 ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hu : u ∈ maximalIdeal O := huv ▸ Ideal.subset_span (Set.mem_insert _ _)
  obtain ⟨c₁, c₂, hc⟩ := Ideal.mem_span_pair.mp (huv ▸ hY)
  obtain ⟨w₁, -, hw₁⟩ := IsInNormalForm.exists_unit h₁ hm
  obtain ⟨w₂, hw₂, hw₂'⟩ := IsInNormalForm.exists_unit h₂ hm
  let G₁ : MvPolynomial (Fin 2) O := MvPolynomial.C w₁ * MvPolynomial.X 1 ^ m
  let G₂ : MvPolynomial (Fin 2) O := MvPolynomial.C w₂ *
    (MvPolynomial.C c₁ * MvPolynomial.X 0 + MvPolynomial.C c₂ * MvPolynomial.X 1) ^ m
  have hG₁ : G₁.IsHomogeneous m := by
    simpa using (MvPolynomial.isHomogeneous_C _ w₁).mul ((MvPolynomial.isHomogeneous_X _ 1).pow m)
  have hG₂ : G₂.IsHomogeneous m := by
    simpa using (MvPolynomial.isHomogeneous_C _ w₂).mul
      (((MvPolynomial.isHomogeneous_C_mul_X c₁ 0).add
        (MvPolynomial.isHomogeneous_C_mul_X c₂ 1)).pow m)
  have hL₁ : IsLeadingTerm u v f (MvPolynomial.map (residue O) G₁) :=
    ⟨m, hm, hG₁.map _, G₁, hG₁, rfl, by simpa [G₁] using hw₁⟩
  have hL₂ : IsLeadingTerm u v f (MvPolynomial.map (residue O) G₂) :=
    ⟨m, hm, hG₂.map _, G₂, hG₂, rfl, by simpa [G₂, hc] using hw₂'⟩
  have heq := (MMP.Resolution.Kollar.existsUnique_isLeadingTerm hdim huv.symm
    (by rw [hm]; exact ENat.coe_ne_top m)).1.unique hL₁ hL₂
  have hev := congrArg (MvPolynomial.eval ![(1 : ResidueField O), 0]) heq
  simp only [G₁, G₂, map_mul, MvPolynomial.map_C, MvPolynomial.map_X,
    map_pow, map_add, MvPolynomial.eval_mul, MvPolynomial.eval_C,
    MvPolynomial.eval_X, MvPolynomial.eval_pow, MvPolynomial.eval_add, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons, mul_one, mul_zero, add_zero,
    zero_pow (by omega : m ≠ 0)] at hev
  have hw₂r : residue O w₂ ≠ 0 := by
    rwa [ne_eq, residue_eq_zero_iff]
  have hc₁ : c₁ ∈ maximalIdeal O := by
    rw [← residue_eq_zero_iff]
    rcases mul_eq_zero.mp hev.symm with h | h
    · exact absurd h hw₂r
    · exact pow_eq_zero_iff (by omega) |>.mp h
  rw [← hc]
  refine add_mem (Submodule.mem_sup_right ?_) (Submodule.mem_sup_left
    (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self v)))
  rw [pow_two]
  exact Ideal.mul_mem_mul hc₁ hu

/-- **The tangent is not the exceptional direction.** Let `(u, t)` be a regular system of
parameters of a two-dimensional regular local ring and `f`, of multiplicity `m ≥ 1`, in normal
form with respect to `(X, Y)`. If the leading form of `u` divides no leading term of `f`, then
`(Y) = (t - c u)` for some `c`. -/
private theorem exists_span_eq_sub_mul_of_not_dvd [IsNoetherianRing O]
    (hdim : ringKrullDim O = 2) {u t X Y f : O} (hut : Ideal.span {u, t} = maximalIdeal O)
    (h₂ : IsInNormalForm X Y f) {m : ℕ} (hm : mult f = m) (hm1 : 1 ≤ m)
    (hnd : ∀ L F, IsLeadingTerm u t u L → IsLeadingTerm u t f F → ¬ L ∣ F) :
    ∃ c : O, Ideal.span {Y} = Ideal.span {t - c * u} := by
  have hY : Y ∈ maximalIdeal O := h₂.1 ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hu : u ∈ maximalIdeal O := hut ▸ Ideal.subset_span (Set.mem_insert _ _)
  have ht : t ∈ maximalIdeal O := hut ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  obtain ⟨c₁, c₂, hc⟩ := Ideal.mem_span_pair.mp (hut ▸ hY)
  by_cases hc₂ : IsUnit c₂
  · refine ⟨-(↑hc₂.unit⁻¹ * c₁), ?_⟩
    have : Y = c₂ * (t - -(↑hc₂.unit⁻¹ * c₁) * u) := by
      rw [← hc]
      linear_combination (-(c₁ * u)) * hc₂.mul_val_inv
    rw [this, Ideal.span_singleton_mul_left_unit hc₂]
  · exfalso
    obtain ⟨w, -, hw⟩ := IsInNormalForm.exists_unit h₂ hm
    obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
    have hdiff : Y ^ (n + 1) - (c₁ * u) ^ (n + 1) ∈ maximalIdeal O ^ (n + 1 + 1) := by
      refine pow_sub_pow_mem hY (Ideal.mul_mem_left _ _ hu) ?_ n
      rw [← hc, add_sub_cancel_left, pow_two]
      exact Ideal.mul_mem_mul ((mem_maximalIdeal _).mpr hc₂) ht
    let G : MvPolynomial (Fin 2) O :=
      MvPolynomial.C (w * c₁ ^ (n + 1)) * MvPolynomial.X 0 ^ (n + 1)
    have hG : G.IsHomogeneous (n + 1) := by
      simpa using (MvPolynomial.isHomogeneous_C _ _).mul ((MvPolynomial.isHomogeneous_X _ 0).pow _)
    have hF : IsLeadingTerm u t f (MvPolynomial.map (residue O) G) := by
      refine ⟨n + 1, hm, hG.map _, G, hG, rfl, ?_⟩
      have : f - MvPolynomial.eval ![u, t] G =
          (f - w * Y ^ (n + 1)) + w * (Y ^ (n + 1) - (c₁ * u) ^ (n + 1)) := by
        simp [G]
        ring
      rw [this]
      exact add_mem hw (Ideal.mul_mem_left _ _ hdiff)
    have hu1 : mult u = 1 := mult_eq_of_mem_of_notMem (by simpa using hu)
      (by simpa using notMem_sq_of_span_pair_eq hut hdim)
    have hL : IsLeadingTerm u t u (MvPolynomial.map (residue O) (MvPolynomial.X 0)) :=
      ⟨1, hu1, (MvPolynomial.isHomogeneous_X _ 0).map _, MvPolynomial.X 0,
        MvPolynomial.isHomogeneous_X _ 0, rfl, by simp⟩
    refine hnd _ _ hL hF ?_
    simp only [G, map_mul, MvPolynomial.map_C, map_pow, MvPolynomial.map_X]
    exact Dvd.dvd.mul_left (dvd_pow_self _ (by omega)) _

/-- **Residues lift along a chart.** If every element of the local ring `O` is a fraction in
`t ∈ 𝔪_O` over a map `φ : R → O` of local rings, then every element of `O` is congruent to an
element of `φ R` modulo `𝔪_O`. -/
private theorem exists_sub_mem_maximalIdeal {R : Type*} [CommRing R] [IsLocalRing R]
    {φ : R →+* O} {t : O} (hfrac : IsPolynomialFraction φ t) (htm : t ∈ maximalIdeal O)
    (hφm : ∀ r ∈ maximalIdeal R, φ r ∈ maximalIdeal O) (o : O) :
    ∃ a : R, o - φ a ∈ maximalIdeal O := by
  obtain ⟨F, G, hG, ho⟩ := hfrac o
  have key : ∀ H : Polynomial R, H.eval₂ φ t - φ (H.coeff 0) ∈ maximalIdeal O := by
    intro H
    have e := congrArg (Polynomial.eval₂ φ t) (Polynomial.divX_mul_X_add H)
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
      Polynomial.eval₂_C] at e
    rw [← e, add_sub_cancel_right]
    exact Ideal.mul_mem_left _ _ htm
  have hG0 : IsUnit (G.coeff 0) := by
    by_contra h
    have h1 := hφm _ ((mem_maximalIdeal _).mpr h)
    have h2 : G.eval₂ φ t ∈ maximalIdeal O := by
      rw [show G.eval₂ φ t = (G.eval₂ φ t - φ (G.coeff 0)) + φ (G.coeff 0) by ring]
      exact add_mem (key G) h1
    exact (mem_maximalIdeal _).mp h2 hG
  refine ⟨F.coeff 0 * ↑hG0.unit⁻¹, ?_⟩
  have hc : φ (F.coeff 0 * ↑hG0.unit⁻¹) * φ (G.coeff 0) = φ (F.coeff 0) := by
    rw [← map_mul, mul_assoc, IsUnit.val_inv_mul, mul_one]
  have e : (o - φ (F.coeff 0 * ↑hG0.unit⁻¹)) * G.eval₂ φ t =
      (F.eval₂ φ t - φ (F.coeff 0)) -
        φ (F.coeff 0 * ↑hG0.unit⁻¹) * (G.eval₂ φ t - φ (G.coeff 0)) := by
    linear_combination ho - hc
  refine (Ideal.mul_unit_mem_iff_mem _ hG).mp ?_
  rw [e]
  exact sub_mem (key F) (Ideal.mul_mem_left _ _ (key G))

/-- Regular systems of parameters are carried along ring isomorphisms of local rings. -/
private theorem isRegularSystemOfParameters_map_ringEquiv {B : Type*} [CommRing B]
    [IsLocalRing B] (σ : O ≃+* B) {x y : O} (h : MMP.Mori.IsRegularSystemOfParameters ![x, y]) :
    MMP.Mori.IsRegularSystemOfParameters ![σ x, σ y] := by
  convert MMP.Resolution.isRegularSystemOfParameters_map_ringEquiv σ h using 1
  ext i; fin_cases i <;> rfl

/-- A regular system of parameters `(x, y)` stays one when `y` is changed by a multiple of `x`. -/
private theorem isRegularSystemOfParameters_sub_mul {x y : O}
    (h : MMP.Mori.IsRegularSystemOfParameters ![x, y]) (c : O) :
    MMP.Mori.IsRegularSystemOfParameters ![x, y - c * x] := by
  refine ⟨?_, h.2⟩
  rw [Matrix.range_cons_cons_empty (u := ![]), sub_eq_add_neg, ← neg_mul,
    Ideal.span_pair_add_mul_left,
    ← Matrix.range_cons_cons_empty (u := ![])]
  exact h.1

/-- In a two-dimensional local ring, a pair in normal form is a regular system of parameters. -/
private theorem isRegularSystemOfParameters_of_isInNormalForm
    (hdim : ringKrullDim O = 2) {x y f : O} (h : IsInNormalForm x y f) :
    MMP.Mori.IsRegularSystemOfParameters ![x, y] :=
  ⟨by rw [Matrix.range_cons_cons_empty (u := ![])]; exact h.1, by rw [hdim]; rfl⟩

end LocalAlgebra

section Step

open MMP.Resolution PointBlowupSequence

/-- **The chart point of one blow-up.** Let `p` be a closed point of a Noetherian scheme `S`,
`(x, y)` a regular system of parameters of `𝒪_{S,p}`, and `C ⊆ S` a curve with principal stalks
and local equation `f` of multiplicity `m` at `p`. The point `p₁ = (x, y/x)` of the chart
`Spec 𝒪[y/x]` of the blow-up of `p` lies over `p`; `𝒪_{S,p} → 𝒪_{p₁}` is injective, `(x, y/x)` is a
regular system of parameters of the regular local ring `𝒪_{p₁}`, every element of which is a
fraction in `y/x` over `𝒪_{S,p}`; `x^{-m} f` is a local equation of the birational transform and
`x` one of the exceptional curve at `p₁`. -/
private theorem exists_chartPoint {S : Scheme.{u}} [IsNoetherian S] (C : S.IdealSheafData)
    (hC : HasPrincipalStalks C) {p : S}
    (hp : IsClosed ({p} : Set S)) {m : ℕ} {f x y : S.presheaf.stalk p}
    (hf : IdealSheafData.stalk C p = Ideal.span {f})
    (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y]) (hmult : mult f = m) :
    ∃ (p₁ : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
      (_ : IsClosed ({p₁} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))))
      (hπ : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) p₁ = p)
      (t₁ f₁ : (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk p₁),
      stalkHom _ p₁ hπ x * t₁ = stalkHom _ p₁ hπ y ∧
      stalkHom _ p₁ hπ x ^ m * f₁ = stalkHom _ p₁ hπ f ∧
      MMP.Mori.IsRegularSystemOfParameters ![stalkHom _ p₁ hπ x, t₁] ∧
      IsPolynomialFraction (stalkHom _ p₁ hπ) t₁ ∧
      Function.Injective (stalkHom _ p₁ hπ) ∧
      IdealSheafData.stalk (birationalTransform p hp C) p₁ = Ideal.span {f₁} ∧
      IdealSheafData.stalk
          (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ =
        Ideal.span {stalkHom _ p₁ hπ x} ∧
      IsRegularLocalRing
        ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk p₁) := by
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing (S.presheaf.stalk p) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  have hreg : IsRegularLocalRing (S.presheaf.stalk p) :=
    MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hxy
  haveI := hreg
  haveI : IsDomain (S.presheaf.stalk p) := IsRegularLocalRing.isDomain _
  have hdim : ringKrullDim (S.presheaf.stalk p) = 2 := by rw [hxy.2]; rfl
  have hmax : maximalIdeal (S.presheaf.stalk p) = Ideal.span {x, y} := by
    rw [← hxy.1, Matrix.range_cons_cons_empty (u := ![])]
  -- a coordinate neighbourhood with coordinates `x, y` on which `C` is principal
  obtain ⟨V, hpV, hprin⟩ : ∃ V : S.affineOpens, p ∈ (V : Set S) ∧ (C.ideal V).IsPrincipal := by
    obtain ⟨g, -, hg⟩ := hC p
    exact Stacks.Divisors.exists_affineOpens_isPrincipal_of_stalk_isPrincipal C p ⟨⟨g, hg⟩⟩
  obtain ⟨⟨s₀, hZ⟩⟩ := hprin
  change C.ideal V = Ideal.span {s₀} at hZ
  obtain ⟨U₁, hpU₁, a, ha⟩ := TopCat.Presheaf.germ_exist S.presheaf x
  obtain ⟨U₂, hpU₂, b, hb⟩ := TopCat.Presheaf.germ_exist S.presheaf y
  have hpW : p ∈ V.1 ⊓ U₁ ⊓ U₂ := ⟨⟨hpV, hpU₁⟩, hpU₂⟩
  have hW₁ : V.1 ⊓ U₁ ⊓ U₂ ≤ U₁ := inf_le_left.trans inf_le_right
  have hW₂ : V.1 ⊓ U₁ ⊓ U₂ ≤ U₂ := inf_le_right
  have hWV : V.1 ⊓ U₁ ⊓ U₂ ≤ V.1 := inf_le_left.trans inf_le_left
  have ha' : (S.presheaf.germ (V.1 ⊓ U₁ ⊓ U₂) p hpW).hom
      ((S.presheaf.map (homOfLE hW₁).op).hom a) = x := by
    rwa [TopCat.Presheaf.germ_res_apply]
  have hb' : (S.presheaf.germ (V.1 ⊓ U₁ ⊓ U₂) p hpW).hom
      ((S.presheaf.map (homOfLE hW₂).op).hom b) = y := by
    rwa [TopCat.Presheaf.germ_res_apply]
  have hxy' : MMP.Mori.IsRegularSystemOfParameters
      ![(S.presheaf.germ (V.1 ⊓ U₁ ⊓ U₂) p hpW).hom ((S.presheaf.map (homOfLE hW₁).op).hom a),
        (S.presheaf.germ (V.1 ⊓ U₁ ⊓ U₂) p hpW).hom ((S.presheaf.map (homOfLE hW₂).op).hom b)] := by
    rwa [ha', hb']
  obtain ⟨c, hUW, hcx, hcy⟩ :=
    MMP.Resolution.CoordinateNeighbourhood.exists_of_isRegularSystemOfParameters hp hreg hdim hpW
      _ _ hxy'
  have hgx : (S.presheaf.germ c.U p c.mem).hom c.x = x := by
    rwa [hcx, TopCat.Presheaf.germ_res_apply]
  have hgy : (S.presheaf.germ c.U p c.mem).hom c.y = y := by
    rwa [hcy, TopCat.Presheaf.germ_res_apply]
  have hUV : (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) ≤ V := hUW.trans hWV
  have hCU : C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span
      {(S.presheaf.map (homOfLE hUV).op).hom s₀} := by
    rw [← C.map_ideal hUV, hZ, Ideal.map_span, Set.image_singleton]
  set sU := (S.presheaf.map (homOfLE hUV).op).hom s₀
  have hstalkU : IdealSheafData.stalk C p =
      Ideal.span {(S.presheaf.germ c.U p c.mem).hom sU} := by
    rw [IdealSheafData.stalk_eq_map_germ C p ⟨c.U, c.isAffineOpen⟩ c.mem, hCU, Ideal.map_span,
      Set.image_singleton]
  obtain ⟨v, hv⟩ : Associated ((S.presheaf.germ c.U p c.mem).hom sU) f :=
    Ideal.span_singleton_eq_span_singleton.mp (hstalkU.symm.trans hf)
  have hmU : mult ((S.presheaf.germ c.U p c.mem).hom sU) = m := by
    rwa [mult, ← hstalkU, hf]
  -- the chart `Spec R[y/x]`
  have := c.isDomain
  haveI hK : IsDomain (FractionRing Γ(S, c.U)) := IsLocalization.isDomain_localization le_rfl
  haveI : IsDomain (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) :=
    @Subalgebra.isDomain _ _ _ _ hK _ _
  have hmax' : maximalIdeal (S.presheaf.stalk p) = Ideal.span
      {(S.presheaf.germ c.U p c.mem).hom c.x, (S.presheaf.germ c.U p c.mem).hom c.y} := by
    rw [hgx, hgy, hmax]
  obtain ⟨⟨F, hF, -⟩, -⟩ := MMP.Resolution.Kollar.existsUnique_isLeadingTerm hdim hmax'
    (f := (S.presheaf.germ c.U p c.mem).hom sU) (by rw [hmU]; exact ENat.natCast_ne_top m)
  obtain ⟨hx, e, he⟩ := CoordinateNeighbourhood.exists_iso_spec_adjoin_div hp hreg hdim c
  obtain ⟨hEker, -, hφX⟩ :=
    CoordinateNeighbourhood.comap_exceptionalIdeal_eq_ker_and_exceptionalChartPolynomialEquiv
      hp hreg hdim c hx e he
  let φκ := CoordinateNeighbourhood.exceptionalChartPolynomialEquiv hp hreg hdim c
  obtain ⟨f₁', hf₁', -⟩ := CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq hp hreg hdim c sU
    m hmU F hF
  have h₁ := CoordinateNeighbourhood.comap_birationalTransform_eq_ker hp hreg hdim c sU m hmU C
    hCU hx e he f₁' hf₁'
  have hx0R := CoordinateNeighbourhood.x_ne_zero hdim c
  obtain ⟨z, hz⟩ := exists_mul_eq (y := c.y) hx0R
  have hxK : algebraMap Γ(S, c.U) (FractionRing Γ(S, c.U)) c.x ≠ 0 :=
    fun h => hx0R ((IsFractionRing.to_map_eq_zero_iff).1 h)
  have hz' : algebraMap Γ(S, c.U) (FractionRing Γ(S, c.U)) c.x * (z : FractionRing Γ(S, c.U)) =
      algebraMap Γ(S, c.U) _ c.y := congrArg Subtype.val hz
  have hset : {z' : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z' = algebraMap Γ(S, c.U) _ c.y} =
        {(z : FractionRing Γ(S, c.U))} := by
    ext z'
    simp only [Set.mem_setOf_eq, Set.mem_singleton_iff]
    exact ⟨fun h => mul_left_cancel₀ hxK (h.trans hz'.symm), by rintro rfl; exact hz'⟩
  have hgen : ∀ b : Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y},
      ∃ G : Polynomial Γ(S, c.U), Polynomial.aeval z G = b := by
    intro b
    have hb : (b : FractionRing Γ(S, c.U)) ∈
        Algebra.adjoin Γ(S, c.U) {(z : FractionRing Γ(S, c.U))} := by
      rw [← hset]; exact b.2
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hb
    obtain ⟨G, hG⟩ := hb
    refine ⟨G, Subtype.ext ?_⟩
    rw [← hG]
    exact Polynomial.aeval_subalgebra_coe G _ z
  have hx0 : algebraMap Γ(S, c.U) (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) c.x ≠ 0 :=
    fun h => hxK (congrArg Subtype.val h)
  obtain ⟨q₁, hπ, lam, hcl, hinj, hlam, hrsp, hfrac, hreg₁, hstalkZ⟩ :=
    exists_point_of_isOpenImmersion hp hreg hdim c
      (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1.ι)
      (by rw [Category.assoc, ← he, Iso.inv_hom_id_assoc]) z hz hgen φκ (hφX z hz) hx0
  haveI := hreg₁
  haveI : IsDomain ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk
    q₁) := IsRegularLocalRing.isDomain _
  -- `let`, not `set`: `set` abstracts `Φ` in every hypothesis, unfolding stalks at each one.
  let Φ := stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) q₁ hπ
  -- Explicit terms rather than `rw`: matching ring-hom applications here is slow.
  have hΦx : Φ x = lam (algebraMap Γ(S, c.U) _ c.x) := (congrArg Φ hgx.symm).trans (hlam c.x).symm
  have hΦy : Φ y = lam (algebraMap Γ(S, c.U) _ c.y) := (congrArg Φ hgy.symm).trans (hlam c.y).symm
  have heq1 : Φ x * lam z = Φ y :=
    ((congrArg (· * lam z) hΦx).trans (map_mul lam _ _).symm).trans
      ((congrArg lam hz).trans hΦy.symm)
  have hΦsU : Φ ((S.presheaf.germ c.U p c.mem).hom sU) = Φ x ^ m * lam f₁' :=
    (hlam sU).symm.trans ((congrArg lam hf₁').trans ((map_mul lam _ _).trans
      (congrArg (· * lam f₁') ((map_pow lam _ m).trans (congrArg (· ^ m) hΦx.symm)))))
  have heq2 : Φ x ^ m * (Φ (v : S.presheaf.stalk p) * lam f₁') = Φ f :=
    ((congrArg (Φ x ^ m * ·) (mul_comm _ _)).trans (mul_assoc _ _ _).symm).trans
      ((congrArg (· * Φ (v : S.presheaf.stalk p)) hΦsU.symm).trans
        ((map_mul Φ _ _).symm.trans (congrArg Φ hv)))
  have hstalk₁ : IdealSheafData.stalk (birationalTransform p hp C) q₁ =
      Ideal.span {Φ (v : S.presheaf.stalk p) * lam f₁'} := by
    rw [hstalkZ _ f₁' h₁, Ideal.span_singleton_mul_left_unit ((v.isUnit).map _)]
  have hE : IdealSheafData.stalk
      (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) q₁ =
        Ideal.span {Φ x} := by
    rw [hstalkZ _ _ hEker, hΦx]
  have hinjΦ : Function.Injective Φ := by
    letI : Algebra Γ(S, c.U) (S.presheaf.stalk p) := S.presheaf.algebra_section_stalk ⟨p, c.mem⟩
    haveI := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
    rw [injective_iff_map_eq_zero]
    intro o ho
    obtain ⟨⟨r, s'⟩, rfl⟩ := IsLocalization.mk'_surjective
      (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal.primeCompl o
    dsimp only at ho ⊢
    have h1 := IsLocalization.mk'_spec (S.presheaf.stalk p) r s'
    have h2 : lam (algebraMap Γ(S, c.U) _ r) = 0 := by
      rw [hlam]
      have : (S.presheaf.germ c.U p c.mem).hom r =
          algebraMap Γ(S, c.U) (S.presheaf.stalk p) r := rfl
      rw [this, ← h1, map_mul, ho, zero_mul]
    have h3 := hinj (h2.trans (map_zero lam).symm)
    have h4 : algebraMap Γ(S, c.U) (FractionRing Γ(S, c.U)) r = 0 := congrArg Subtype.val h3
    have hr : r = 0 := IsFractionRing.injective Γ(S, c.U) (FractionRing Γ(S, c.U))
      (h4.trans (map_zero _).symm)
    rw [hr, IsLocalization.mk'_zero]
  exact ⟨q₁, hcl, hπ, lam z, _, heq1, heq2, by rwa [hΦx], hfrac, hinjΦ, hstalk₁, hE, hreg₁⟩

end Step

section Main

open MMP.Resolution PointBlowupSequence

/-- The conclusion of the proposition at the index `i` of the sequence `s`, together with the
regularity of the local ring at `p_i`. -/
private def IsChartPointAt {S₀ : Scheme.{u}} (s : PointBlowupSequence S₀) (C₀ : S₀.IdealSheafData)
    (p₀ : S₀) (m : ℕ) (f x y' : S₀.presheaf.stalk p₀) (i : ℕ) (hi : (i : ℕ∞) ≤ s.length) : Prop :=
  ∃ hπ : (s.π i hi).base (s.p i) = p₀,
    ∃ t g : (s.S i).presheaf.stalk (s.p i),
      stalkHom (s.π i hi) (s.p i) hπ x ^ i * t = stalkHom (s.π i hi) (s.p i) hπ y' ∧
      stalkHom (s.π i hi) (s.p i) hπ x ^ (m * i) * g = stalkHom (s.π i hi) (s.p i) hπ f ∧
      MMP.Mori.IsRegularSystemOfParameters ![stalkHom (s.π i hi) (s.p i) hπ x, t] ∧
      IsPolynomialFraction (stalkHom (s.π i hi) (s.p i) hπ) t ∧
      IdealSheafData.stalk (s.transformedSubscheme C₀ i) (s.p i) = Ideal.span {g} ∧
      IsRegularLocalRing ((s.S i).presheaf.stalk (s.p i))

/-- **One blow-up.** Blowing up `p` where `f ∈ (x^(k+2), y)^m` has multiplicity `m`, the point
`p₁ = (x, y/x)` of the chart `Spec R[y/x]` is a closed point over `p` at which `(x, y/x)` is a
regular system of parameters, `𝒪_{p₁}` is a localization of `𝒪_p[y/x]`, `x^{-m} f` is a local
equation of the birational transform, of multiplicity `m`, lying in `(x^(k+1), y/x)^m`, and `p₁`
is the only point of the birational transform over `p`. -/
private theorem exists_chartPoint_blowUp {S : Scheme.{u}} [IsNoetherian S] (C : S.IdealSheafData)
    (hC : HasPrincipalStalks C) {p : S}
    (hp : IsClosed ({p} : Set S)) {m : ℕ} (hm : 2 ≤ m) {f x y : S.presheaf.stalk p}
    (hf : IdealSheafData.stalk C p = Ideal.span {f})
    (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y]) (hmult : mult f = m) (k : ℕ)
    (hmem : f ∈ Ideal.span {x ^ (k + 1 + 1), y} ^ m) :
    ∃ (p₁ : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
      (_ : IsClosed ({p₁} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))))
      (hπ : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) p₁ = p)
      (t₁ f₁ : (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk p₁),
      stalkHom _ p₁ hπ x * t₁ = stalkHom _ p₁ hπ y ∧
      stalkHom _ p₁ hπ x ^ m * f₁ = stalkHom _ p₁ hπ f ∧
      MMP.Mori.IsRegularSystemOfParameters ![stalkHom _ p₁ hπ x, t₁] ∧
      IsPolynomialFraction (stalkHom _ p₁ hπ) t₁ ∧
      IdealSheafData.stalk (birationalTransform p hp C) p₁ = Ideal.span {f₁} ∧
      mult f₁ = m ∧ f₁ ∈ Ideal.span {stalkHom _ p₁ hπ x ^ (k + 1), t₁} ^ m ∧
      ∀ q, q ∈ (birationalTransform p hp C).support →
        blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) q = p → q = p₁ := by
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing (S.presheaf.stalk p) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  have hreg : IsRegularLocalRing (S.presheaf.stalk p) :=
    MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hxy
  haveI := hreg
  have hdim : ringKrullDim (S.presheaf.stalk p) = 2 := by rw [hxy.2]; rfl
  obtain ⟨q₁, hcl, hπ, t₁, f₁, heq1, heq2, hrsp, hfrac, hinj, hstalk₁, -, hreg₁⟩ :=
    exists_chartPoint C hC hp hf hxy hmult
  haveI := hreg₁
  haveI : IsDomain ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk
    q₁) := IsRegularLocalRing.isDomain _
  -- `let`, not `set`: `set` abstracts `Φ` in every hypothesis, unfolding stalks at each one.
  let Φ := stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) q₁ hπ
  have e1 : Φ x * t₁ = Φ y := heq1
  have e2 : Φ x ^ m * f₁ = Φ f := heq2
  have hΦx0 : Φ x ≠ 0 := fun h =>
    ne_zero_of_isRegularSystemOfParameters hxy 0 (hinj (h.trans (map_zero Φ).symm))
  have hΦmem : Φ f ∈ Ideal.span {Φ x * Φ x ^ (k + 1), Φ x * t₁} ^ m := by
    have := Ideal.mem_map_of_mem Φ hmem
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, map_pow] at this
    rwa [← pow_succ', e1]
  obtain ⟨g, hg, hfg⟩ := exists_eq_pow_mul_of_mem hΦmem
  obtain rfl : g = f₁ := (mul_left_cancel₀ (pow_ne_zero_of_isDomain hΦx0 m) (e2.trans hfg)).symm
  have hmax₁ := hrsp.1
  rw [Matrix.range_cons_cons_empty (u := ![])] at hmax₁
  have hxm : Φ x ∈ maximalIdeal _ := by
    rw [← hmax₁]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hzm : t₁ ∈ maximalIdeal _ := by
    rw [← hmax₁]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hgm : g ∈ maximalIdeal _ ^ m := by
    refine Ideal.pow_right_mono ?_ m hg
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Ideal.pow_mem_of_mem _ hxm _ (Nat.succ_pos k)
    · exact hzm
  have hCcart : MMP.Intersection.IsEffectiveCartierSubscheme C :=
    isEffectiveCartierSubscheme_of_hasPrincipalStalks hC
  have hmultC : multAt C p = m := by rwa [multAt, hf]
  obtain ⟨H1, H2⟩ := birationalTransform_fibre_eq_singleton_or_multAt_lt hp hreg hdim C hCcart
    m hmultC hm
  have hmultAt₁ : multAt (birationalTransform p hp C) q₁ = mult g := by
    rw [multAt, hstalk₁]; rfl
  have hge : (m : ℕ∞) ≤ mult g := (natCast_le_idealOrder_iff' _ m).mpr
    ((Ideal.span_singleton_le_iff_mem _).mpr hgm)
  have hp₁C : q₁ ∈ (birationalTransform p hp C).support := by
    rw [← IdealSheafData.stalk_le_maximalIdeal_iff_mem_support, hstalk₁,
      Ideal.span_singleton_le_iff_mem]
    exact Ideal.pow_le_self (by omega) hgm
  have hp₁E := (mem_support_exceptionalIdeal_iff p hp q₁).mpr hπ
  have hmeq : multAt (birationalTransform p hp C) q₁ = m := by
    by_contra hne
    by_cases hex : ∃ q, q ∈ (birationalTransform p hp C).support ∧
        q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support ∧
        multAt (birationalTransform p hp C) q = m
    · obtain ⟨q, hq1, hq2, hq3⟩ := hex
      have hmemf : q₁ ∈
          {q' | q' ∈ (birationalTransform p hp C).support ∧
            (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base q' = p} :=
        ⟨hp₁C, hπ⟩
      rw [(H1 q hq1 hq2 hq3).1, Set.mem_singleton_iff] at hmemf
      exact hne (hmemf ▸ hq3)
    · push Not at hex
      have hlt := H2 (fun q hq1 hq2 => hex q hq1 hq2) q₁ hp₁C hπ
      rw [hmultAt₁] at hlt
      exact not_le.mpr hlt hge
  have hfib := (H1 q₁ hp₁C hp₁E hmeq).1
  refine ⟨_, hcl, hπ, t₁, g, heq1, heq2, hrsp, hfrac, hstalk₁, by rwa [← hmultAt₁], hg, ?_⟩
  intro q hq hqp
  have : q ∈ {q' | q' ∈ (birationalTransform p hp C).support ∧
      (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).base q' = p} := ⟨hq, hqp⟩
  rwa [hfib, Set.mem_singleton_iff] at this

/-- Two equal morphisms induce the same maps of stalks. -/
private theorem stalkHom_congr {X Y : Scheme.{u}} {g g' : X ⟶ Y} (hg : g = g') (x : X) {y : Y}
    (h : g x = y) (h' : g' x = y) (a : Y.presheaf.stalk y) :
    stalkHom g x h a = stalkHom g' x h' a := by
  subst hg; rfl

/-- For a surjective ring map, every element is a polynomial fraction of any `t`. -/
private theorem isPolynomialFraction_of_surjective {R O : Type*} [CommRing R] [CommRing O]
    {φ : R →+* O} (hφ : Function.Surjective φ) (t : O) : IsPolynomialFraction φ t :=
  fun o => let ⟨r, hr⟩ := hφ o; ⟨Polynomial.C r, 1, by simp, by simp [hr]⟩

/-- A point of multiplicity `m ≥ 2` of a curve on a two-dimensional regular local ring is a
singular point of the curve. -/
private theorem isSingular_of_multAt_eq {X : Scheme.{u}} (Z : X.IdealSheafData) (x : X)
    [IsRegularLocalRing (X.presheaf.stalk x)] (hdim : ringKrullDim (X.presheaf.stalk x) = 2)
    {g : X.presheaf.stalk x} (hg : IdealSheafData.stalk Z x = Ideal.span {g}) {m : ℕ}
    (hm : multAt Z x = m) (hm2 : 2 ≤ m) :
    x ∈ Z.support ∧ ¬ IsRegularLocalRing (X.presheaf.stalk x ⧸ IdealSheafData.stalk Z x) := by
  have hg' : idealOrder (Ideal.span {g}) = m := by rwa [← hg]
  refine ⟨?_, ?_⟩
  · by_contra h
    rw [← IdealSheafData.stalk_eq_top_iff_notMem_support, hg] at h
    exact ne_top_of_idealOrder_eq hg' (by omega) h
  · rw [hg]
    exact not_isRegularLocalRing_quotient hdim hg' hm2

/-- The induction: the statement of the proposition for all `k`, with the data of
`IsChartPointAt` at every index. -/
private theorem exists_isConstantMultiplicity_isChartPointAt (m : ℕ) (hm : 2 ≤ m) (k : ℕ) :
    ∀ {S : Scheme.{u}} [IsNoetherian S]
    (C : S.IdealSheafData) (_ : HasPrincipalStalks C) {p : S} (hp : IsClosed ({p} : Set S))
    {f x y : S.presheaf.stalk p} (_ : IdealSheafData.stalk C p = Ideal.span {f})
    (_ : MMP.Mori.IsRegularSystemOfParameters ![x, y]) (_ : mult f = m)
    (_ : f ∈ Ideal.span {x ^ (k + 1), y} ^ m),
    ∃ s : PointBlowupSequence S, s.length = k ∧ s.zeroIso.hom.base (s.p 0) = p ∧
      s.IsConstantMultiplicity C m ∧ ∀ (i : ℕ) (hi : (i : ℕ∞) ≤ s.length),
        IsChartPointAt s C p m f x y i hi := by
  induction k with
  | zero =>
    intro S _ C _ p hp f x y hf hxy hmult _
    let s : PointBlowupSequence S := {
      length := ((0 : ℕ) : ℕ∞)
      S _ := S
      zeroIso := Iso.refl S
      p _ := p
      isClosed_p i hi := absurd hi (by norm_num)
      blowupIso i hi := absurd hi (by norm_num) }
    haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
    haveI : IsNoetherianRing (S.presheaf.stalk p) :=
      instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
    have hreg : IsRegularLocalRing (S.presheaf.stalk p) :=
      MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hxy
    have h0 : ∀ i : ℕ, (i : ℕ∞) ≤ s.length → i = 0 := fun i hi =>
      Nat.le_zero.mp (Nat.cast_le.mp (show (i : ℕ∞) ≤ ((0 : ℕ) : ℕ∞) from hi))
    refine ⟨s, rfl, rfl, ⟨fun i hi => ?_, fun i hi => absurd hi (by norm_num [s])⟩,
      fun i hi => ?_⟩
    · obtain rfl := h0 i hi
      show multAt (C.comap (𝟙 S)) p = m
      rwa [Scheme.IdealSheafData.comap_id, multAt, hf]
    · obtain rfl := h0 i hi
      have hid : ∀ a, stalkHom (y := p) (s.π 0 hi) (s.p 0) rfl a = a :=
        stalkHom_id (X := S) p rfl
      unfold IsChartPointAt
      refine ⟨rfl, y, f, ?_, ?_, ?_,
          isPolynomialFraction_of_surjective (fun o => ⟨o, hid o⟩) y, ?_, hreg⟩
      · rw [hid, hid, pow_zero, one_mul]
      · rw [hid, hid, mul_zero, pow_zero, one_mul]
      · rwa [hid]
      · show IdealSheafData.stalk (C.comap (𝟙 S)) p = _
        rwa [Scheme.IdealSheafData.comap_id]
  | succ k ih =>
    intro S _ C hC p hp f x y hf hxy hmult hmem
    haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
    haveI : IsNoetherianRing (S.presheaf.stalk p) :=
      instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
    have hreg : IsRegularLocalRing (S.presheaf.stalk p) :=
      MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hxy
    have hdim : ringKrullDim (S.presheaf.stalk p) = 2 := by rw [hxy.2]; rfl
    obtain ⟨p₁, hp₁, hπ₁, t₁, f₁, h1, h2, hrsp₁, hfrac₁, hstalk₁, hmult₁, hmem₁, huniq⟩ :=
      exists_chartPoint_blowUp C hC hp hm hf hxy hmult k hmem
    haveI : IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :=
      Stacks.ResolutionOfSurfaces.isNoetherian_blowUp _
    have hmC : multAt C p ≠ ⊤ := by
      show idealOrder _ ≠ ⊤
      rw [hf]
      show mult f ≠ ⊤
      rw [hmult]; exact ENat.natCast_ne_top m
    have hC₁ := hasPrincipalStalks_birationalTransform hp hreg hdim hC hmC
    obtain ⟨s, hlen, hs0, hcm, hconcl⟩ := ih (birationalTransform p hp C) hC₁ hp₁
      hstalk₁ hrsp₁ hmult₁ hmem₁
    have hlt : ∀ i : ℕ, (i : ℕ∞) < (consSeq p hp s).length → (i : ℕ∞) ≤ s.length :=
      fun i hi => ENat.natCast_lt_add_one_iff.mp hi
    refine ⟨consSeq p hp s, by show s.length + 1 = _; rw [hlen]; norm_cast, rfl,
      ⟨?_, ?_⟩, ?_⟩
    · -- multiplicities
      rintro (_ | i) hi
      · show multAt (C.comap (𝟙 S)) p = m
        rwa [Scheme.IdealSheafData.comap_id, multAt, hf]
      · rw [consSeq_transformedSubscheme_succ]
        exact hcm.1 i ((natCast_succ_le_add_one_iff i s.length).mp hi)
    · -- the points over each other, singular and unique
      intro i hi
      have hsing : (consSeq p hp s).IsSingularPointOfTransform C (i + 1)
          ((consSeq p hp s).p (i + 1)) := by
        obtain ⟨_hπ', _t', g, _h1', _h2', hrsp, _hfrac', hstalk, hreg'⟩ := hconcl i (hlt i hi)
        haveI := hreg'
        unfold IsSingularPointOfTransform
        rw [consSeq_transformedSubscheme_succ]
        exact isSingular_of_multAt_eq (X := s.S i)
          (s.transformedSubscheme (birationalTransform p hp C) i) (s.p i)
          (by rw [hrsp.2]; rfl) hstalk (hcm.1 i (hlt i hi)) hm
      rcases i with _ | j
      · refine ⟨?_, hsing, ?_⟩
        · show blowUpToBase _ (s.zeroIso.hom (s.p 0)) = p
          rw [hs0, hπ₁]
        · intro q _ hqp hq
          unfold IsSingularPointOfTransform at hq
          rw [consSeq_transformedSubscheme_succ] at hq
          have hq1 : s.zeroIso.hom q ∈ (birationalTransform p hp C).support :=
            (mem_support_comap_iff s.zeroIso.hom _ q).mp hq.1
          have hq2 := huniq _ hq1 hqp
          have : s.zeroIso.inv (s.zeroIso.hom q) = s.zeroIso.inv (s.zeroIso.hom (s.p 0)) := by
            rw [hq2, hs0]
          exact (Scheme.hom_inv_apply s.zeroIso q).symm.trans
            (this.trans (Scheme.hom_inv_apply s.zeroIso (s.p 0)))
      · have hj : (j : ℕ∞) < s.length := (natCast_succ_lt_add_one_iff j s.length).mp hi
        obtain ⟨h1', -, h3'⟩ := hcm.2 j hj
        refine ⟨h1', hsing, ?_⟩
        intro q hqc hqp hq
        unfold IsSingularPointOfTransform at hq
        rw [consSeq_transformedSubscheme_succ] at hq
        exact h3' q hqc hqp hq
    · -- the conclusion at every index
      rintro (_ | i) hi
      · have hid : ∀ a, stalkHom (y := p) ((consSeq p hp s).π 0 hi) ((consSeq p hp s).p 0) rfl a =
            a :=
          stalkHom_id (X := S) p rfl
        unfold IsChartPointAt
        refine ⟨rfl, y, f, ?_, ?_, ?_,
            isPolynomialFraction_of_surjective (fun o => ⟨o, hid o⟩) y, ?_, hreg⟩
        · rw [hid, hid]; exact (by rw [pow_zero, one_mul] : x ^ 0 * y = y)
        · rw [hid, hid]; exact (by rw [mul_zero, pow_zero, one_mul] : x ^ (m * 0) * f = f)
        · rwa [hid]
        · show IdealSheafData.stalk (C.comap (𝟙 S)) p = _
          rwa [Scheme.IdealSheafData.comap_id]
      · have hi' : (i : ℕ∞) ≤ s.length := (natCast_succ_le_add_one_iff i s.length).mp hi
        obtain ⟨hπs, t', g', h1', h2', hrsp', hfrac', hstalk', hreg'⟩ := hconcl i hi'
        have hπ : ((consSeq p hp s).π (i + 1) hi).base ((consSeq p hp s).p (i + 1)) = p := by
          rw [consSeq_π_succ p hp s i hi hi']
          show blowUpToBase _ ((s.π i hi').base (s.p i)) = p
          rw [hπs, hπ₁]
        have hΦ : ∀ a, stalkHom ((consSeq p hp s).π (i + 1) hi) ((consSeq p hp s).p (i + 1)) hπ a =
            stalkHom (s.π i hi') (s.p i) hπs
              (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ hπ₁
                a) := by
          intro a
          rw [stalkHom_congr (consSeq_π_succ p hp s i hi hi') _ hπ
            (by rw [← consSeq_π_succ p hp s i hi hi']; exact hπ)]
          exact stalkHom_comp _ _ _ hπs hπ₁ _ a
        have e1 : stalkHom (s.π i hi') (s.p i) hπs
              (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ hπ₁
                x) ^ (i + 1) * t' =
            stalkHom (s.π i hi') (s.p i) hπs
              (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ hπ₁
                y) := by
          rw [pow_succ', mul_assoc, h1', ← map_mul, h1]
        have e2 : stalkHom (s.π i hi') (s.p i) hπs
              (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ hπ₁
                x) ^ (m * (i + 1)) * g' =
            stalkHom (s.π i hi') (s.p i) hπs
              (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁ hπ₁
                f) := by
          rw [← h2, map_mul, ← h2', map_pow]
          ring
        unfold IsChartPointAt
        refine ⟨hπ, t', g', ?_, ?_, ?_, ?_, ?_, hreg'⟩
        · rwa [hΦ, hΦ]
        · rwa [hΦ, hΦ]
        · rwa [hΦ]
        · have heq : stalkHom ((consSeq p hp s).π (i + 1) hi) ((consSeq p hp s).p (i + 1)) hπ =
              (stalkHom (s.π i hi') (s.p i) hπs).comp
                (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) p₁
                  hπ₁) := RingHom.ext hΦ
          rw [heq]
          exact IsPolynomialFraction.trans hfrac₁ hfrac' h1'.symm
        · rwa [consSeq_transformedSubscheme_succ]

/-- **Kollár, Proposition 1.69 ("if")**. Let `S₀` be a two-dimensional regular Noetherian scheme,
`C₀ ⊆ S₀` a reduced effective Cartier divisor, `p₀ ∈ C₀` a closed point with `mult_{p₀} C₀ = m ≥ 2`
and local equation `f ∈ R₀ = 𝒪_{S₀,p₀}`, and `(x, y')` a regular system of parameters of `R₀`
with `f ∈ (x^{k+1}, y')^m`. Then there is a blow-up sequence `s` of multiplicity `m` for `C₀`
(`IsConstantMultiplicity`) of length `k` starting at `p₀` such that, for every `i ≤ k`,
`π_i(p_i) = p₀` and, writing `φ_i : R₀ → 𝒪_{S_i,p_i}` for the stalk map of `π_i`, there are
`t, g ∈ 𝒪_{S_i,p_i}` with `φ_i(x)^i t = φ_i(y')` and `φ_i(x)^{mi} g = φ_i(f)`, such that
`(φ_i x, t)` is a regular system of parameters of `𝒪_{S_i,p_i}`, `𝒪_{S_i,p_i}` is the
localization of `R₀[t]` at the contraction of its maximal ideal, and `g` is a local equation
of the transform `C_i` at `p_i`. -/
@[mmp "prop_kr1c_blowup_sequence_from_ideal_membership"]
public theorem exists_isConstantMultiplicity_of_mem_span_pow
    {S₀ : Scheme.{u}} [IsNoetherian S₀]
    (hreg : ∀ q : S₀, IsRegularLocalRing (S₀.presheaf.stalk q))
    (hdim : topologicalKrullDim S₀ = 2)
    (C₀ : S₀.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C₀)
    [IsReduced C₀.subscheme] {p₀ : S₀} (hp₀c : IsClosed ({p₀} : Set S₀))
    (hp₀C : p₀ ∈ C₀.support) {m : ℕ} (hm : 2 ≤ m) (hmult : multAt C₀ p₀ = m)
    {f : S₀.presheaf.stalk p₀} (hf : IdealSheafData.stalk C₀ p₀ = Ideal.span {f})
    (k : ℕ) {x y' : S₀.presheaf.stalk p₀} (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y'])
    (hmem : f ∈ Ideal.span {x ^ (k + 1), y'} ^ m) :
    ∃ s : PointBlowupSequence S₀, s.length = k ∧ s.zeroIso.hom.base (s.p 0) = p₀ ∧
      s.IsConstantMultiplicity C₀ m ∧
      ∀ (i : ℕ) (hi : (i : ℕ∞) ≤ s.length),
        ∃ hπ : (s.π i hi).base (s.p i) = p₀,
          letI φ := ((S₀.presheaf.stalkCongr (Inseparable.of_eq hπ)).inv ≫
            (s.π i hi).stalkMap (s.p i)).hom
          letI := φ.toAlgebra
          ∃ t g : (s.S i).presheaf.stalk (s.p i),
            φ x ^ i * t = φ y' ∧ φ x ^ (m * i) * g = φ f ∧
            MMP.Mori.IsRegularSystemOfParameters ![φ x, t] ∧
            IsLocalization.AtPrime ((s.S i).presheaf.stalk (s.p i))
              ((maximalIdeal ((s.S i).presheaf.stalk (s.p i))).comap
                (algebraMap (Algebra.adjoin (S₀.presheaf.stalk p₀) {t})
                  ((s.S i).presheaf.stalk (s.p i)))) ∧
            IdealSheafData.stalk (s.transformedSubscheme C₀ i) (s.p i) = Ideal.span {g} := by
  have hmult' : mult f = m := by rwa [mult, ← hf]
  obtain ⟨s, hlen, hs0, hcm, hconcl⟩ :=
    exists_isConstantMultiplicity_isChartPointAt m hm k C₀
    (hasPrincipalStalks_of_isEffectiveCartierDivisor hC) hp₀c hf hxy hmult' hmem
  refine ⟨s, hlen, hs0, hcm, fun i hi => ?_⟩
  obtain ⟨hπ, t, g, h1, h2, hrsp, hfrac, hstalk, -⟩ := hconcl i hi
  exact ⟨hπ, t, g, h1, h2, hrsp, IsPolynomialFraction.isLocalization_atPrime hfrac, hstalk⟩

end Main

end

/-! ### The next coefficient from a blow-up sequence -/

section

section Sequence

open MMP.Resolution PointBlowupSequence

/-- At the image point itself, `stalkHom` is the stalk isomorphism of an open immersion. -/
private theorem stalkHom_eq_stalkEquiv {X Y : Scheme.{u}} (j : X ⟶ Y) [IsOpenImmersion j]
    (x : X) (a : Y.presheaf.stalk (j x)) : stalkHom j x rfl a = stalkEquiv j x a := by
  simp [stalkHom, TopCat.Presheaf.stalkCongr]

/-- The stalk map of an isomorphism is bijective. -/
private theorem bijective_stalkHom_of_isIso {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f] (x : X)
    {y : Y} (h : f x = y) : Function.Bijective (stalkHom f x h) := by
  subst h
  have e := stalkHom_eq_stalkEquiv f x
  refine ⟨fun a b hab => (stalkEquiv f x).injective (by rwa [e, e] at hab), fun b =>
    ⟨(stalkEquiv f x).symm b, by rw [e]; exact (stalkEquiv f x).apply_symm_apply b⟩⟩

open Classical in
/-- The exceptional curve `E_i ⊆ S_i` of `σ_i : S_i → S_{i-1}`, for `1 ≤ i ≤ n` (junk `⊤`
otherwise). -/
private noncomputable def exceptionalCurve {S₀ : Scheme.{u}} (s : PointBlowupSequence S₀) :
    ∀ i : ℕ, (s.S i).IdealSheafData
  | 0 => ⊤
  | i + 1 =>
    if hi : (i : ℕ∞) < s.length then
      (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{s.p i}, s.isClosed_p i hi⟩)).comap
        (s.blowupIso i hi).hom
    else ⊤

private theorem exceptionalCurve_succ {S₀ : Scheme.{u}} (s : PointBlowupSequence S₀) (j : ℕ)
    (hj : (j : ℕ∞) < s.length) :
    exceptionalCurve s (j + 1) =
      (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{s.p j}, s.isClosed_p j hj⟩)).comap
        (s.blowupIso j hj).hom := by
  rw [exceptionalCurve, dif_pos hj]

/-- The data at the index `i ≤ k` of the sequence `s`: `p_i` is the chart point `(x, t)`,
`t = y'/x^i`, with local equation `g = x^{-mi} f ∈ (x^{k+1-i}, t)^m` of `C_i`, the exceptional
curve `E_i` is `x = 0` near `p_i` for `i ≥ 1`, and the invariants needed to blow up again. -/
private def IsChartPoint {S₀ : Scheme.{u}} (s : PointBlowupSequence S₀) (C₀ : S₀.IdealSheafData)
    (p₀ : S₀) (m k : ℕ) (f x y' : S₀.presheaf.stalk p₀) (i : ℕ) (hi : (i : ℕ∞) ≤ s.length) :
    Prop :=
  ∃ hπ : (s.π i hi).base (s.p i) = p₀,
    ∃ t g : (s.S i).presheaf.stalk (s.p i),
      stalkHom (s.π i hi) (s.p i) hπ x ^ i * t = stalkHom (s.π i hi) (s.p i) hπ y' ∧
      stalkHom (s.π i hi) (s.p i) hπ x ^ (m * i) * g = stalkHom (s.π i hi) (s.p i) hπ f ∧
      MMP.Mori.IsRegularSystemOfParameters ![stalkHom (s.π i hi) (s.p i) hπ x, t] ∧
      IsPolynomialFraction (stalkHom (s.π i hi) (s.p i) hπ) t ∧
      Function.Injective (stalkHom (s.π i hi) (s.p i) hπ) ∧
      IdealSheafData.stalk (s.transformedSubscheme C₀ i) (s.p i) = Ideal.span {g} ∧
      g ∈ Ideal.span {stalkHom (s.π i hi) (s.p i) hπ x ^ (k + 1 - i), t} ^ m ∧
      (0 < i → IdealSheafData.stalk (exceptionalCurve s i) (s.p i) =
        Ideal.span {stalkHom (s.π i hi) (s.p i) hπ x}) ∧
      IsRegularLocalRing ((s.S i).presheaf.stalk (s.p i)) ∧
      IsNoetherian (s.S i) ∧ HasPrincipalStalks (s.transformedSubscheme C₀ i)

/-- **The sequence is the sequence of chart points.** Along a blow-up sequence of multiplicity
`m` starting at `p₀`, with `f ∈ (x^{k+1}, y')^m`, the points `p_i`, `i ≤ k`, are the chart points
`(x, y'/x^i)`: the chart point of the blow-up of `p_i` lies on `C_{i+1}` over `p_i`, and `p_{i+1}`
is the only such point. -/
private theorem isChartPoint_of_le {S₀ : Scheme.{u}} [IsNoetherian S₀]
    (hreg : ∀ q : S₀, IsRegularLocalRing (S₀.presheaf.stalk q))
    (C₀ : S₀.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C₀)
    {p₀ : S₀} {m : ℕ} (hm : 2 ≤ m)
    {f : S₀.presheaf.stalk p₀} (hf : IdealSheafData.stalk C₀ p₀ = Ideal.span {f})
    (k : ℕ) {x y' : S₀.presheaf.stalk p₀} (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y'])
    (hmem : f ∈ Ideal.span {x ^ (k + 1), y'} ^ m)
    (s : PointBlowupSequence S₀) (hp₀ : s.zeroIso.hom.base (s.p 0) = p₀)
    (hs : s.IsConstantMultiplicity C₀ m) :
    ∀ (i : ℕ) (hi : (i : ℕ∞) ≤ s.length), i ≤ k → IsChartPoint s C₀ p₀ m k f x y' i hi
  | 0, hi, _ => by
    subst hp₀
    have hφ : ∀ a, stalkHom (y := s.zeroIso.hom.base (s.p 0)) (s.π 0 hi) (s.p 0) rfl a =
        stalkEquiv s.zeroIso.hom (s.p 0) a :=
      stalkHom_eq_stalkEquiv s.zeroIso.hom (s.p 0)
    set σ := stalkEquiv s.zeroIso.hom (s.p 0)
    haveI := hreg (s.zeroIso.hom (s.p 0))
    refine ⟨rfl, σ y', σ f, ?_, ?_, ?_, ?_, ?_, ?_, ?_, fun h => absurd h (lt_irrefl 0),
      IsRegularLocalRing.of_ringEquiv σ, isNoetherian_of_iso s.zeroIso,
      (hasPrincipalStalks_of_isEffectiveCartierDivisor hC).comap s.zeroIso.hom⟩
    · rw [hφ, hφ, pow_zero, one_mul]
    · rw [hφ, hφ, mul_zero, pow_zero, one_mul]
    · rw [hφ]; exact isRegularSystemOfParameters_map_ringEquiv σ hxy
    · exact isPolynomialFraction_of_surjective
        (fun o => ⟨σ.symm o, by rw [hφ, RingEquiv.apply_symm_apply]⟩) _
    · exact fun a b hab => σ.injective (by rwa [hφ, hφ] at hab)
    · show IdealSheafData.stalk (C₀.comap s.zeroIso.hom) (s.p 0) = _
      rw [stalk_comap_eq_map_stalkEquiv, hf, Ideal.map_span, Set.image_singleton]
    · have := Ideal.mem_map_of_mem σ hmem
      rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, map_pow] at this
      rw [hφ, Nat.sub_zero]
      exact this
  | i + 1, hi, hik => by
    have hlt : (i : ℕ∞) < s.length := coe_lt_of_succ_le hi
    obtain ⟨hπ, t, g, h1, h2, hrsp, hfrac, hinj, hstalk, hgmem, -, hreg', hN, hP⟩ :=
      isChartPoint_of_le hreg C₀ hC hm hf k hxy hmem s hp₀ hs i hlt.le (by omega)
    haveI := hN
    haveI := hreg'
    haveI : IsLocallyNoetherian (s.S i) := IsNoetherian.toIsLocallyNoetherian
    haveI : IsNoetherianRing ((s.S i).presheaf.stalk (s.p i)) :=
      instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
    haveI : IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal
        ⟨{s.p i}, s.isClosed_p i hlt⟩)) :=
      Stacks.ResolutionOfSurfaces.isNoetherian_blowUp _
    have hdim : ringKrullDim ((s.S i).presheaf.stalk (s.p i)) = 2 := by rw [hrsp.2]; rfl
    have hmultg : mult g = m := by rw [mult, ← hstalk]; exact hs.1 i hlt.le
    obtain ⟨q₁, -, hπ₁, t₁, f₁, e1, e2, hrsp₁, hfrac₁, hinj₁, hstalk₁, hE₁, hreg₁⟩ :=
      exists_chartPoint (s.transformedSubscheme C₀ i) hP (s.isClosed_p i hlt) hstalk hrsp hmultg
    haveI := hreg₁
    haveI : IsNoetherianRing ((blowUp (Scheme.IdealSheafData.vanishingIdeal
        ⟨{s.p i}, s.isClosed_p i hlt⟩)).presheaf.stalk q₁) := hreg₁.toIsNoetherian
    haveI : IsDomain ((blowUp (Scheme.IdealSheafData.vanishingIdeal
        ⟨{s.p i}, s.isClosed_p i hlt⟩)).presheaf.stalk q₁) := IsRegularLocalRing.isDomain _
    have hΦx0 : stalkHom _ q₁ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ x) ≠ 0 := by
      intro h0
      exact ne_zero_of_isRegularSystemOfParameters hrsp 0 (hinj₁ (h0.trans (map_zero _).symm))
    -- `f₁ ∈ (x^(k-i), t₁)^m`
    have hgΦ : stalkHom _ q₁ hπ₁ g ∈ Ideal.span
        {stalkHom _ q₁ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ x) *
          stalkHom _ q₁ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ x) ^ (k - i),
         stalkHom _ q₁ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ x) * t₁} ^ m := by
      have := Ideal.mem_map_of_mem (stalkHom _ q₁ hπ₁) hgmem
      rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, map_pow, ← e1,
        show k + 1 - i = k - i + 1 by omega, pow_succ'] at this
      exact this
    obtain ⟨g', hg', hgg'⟩ := exists_eq_pow_mul_of_mem hgΦ
    obtain rfl : f₁ = g' :=
      mul_left_cancel₀ (pow_ne_zero_of_isDomain hΦx0 m) (e2.trans hgg')
    -- the chart point is `p_{i+1}`
    have hT := transformedSubscheme_succ s C₀ i hlt
    obtain ⟨hqC, hqE, hmq⟩ := mem_support_blowupIso_p_succ hs i hi
    have hCc := isEffectiveCartierSubscheme_of_hasPrincipalStalks hP
    obtain ⟨H1, -⟩ := birationalTransform_fibre_eq_singleton_or_multAt_lt (s.isClosed_p i hlt)
      hreg' hdim _ hCc m (hs.1 i hlt.le) hm
    have hxq₁ : stalkHom _ q₁ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ x) ∈ maximalIdeal _ := by
      rw [← hrsp₁.1]; exact Ideal.subset_span ⟨0, rfl⟩
    have htq₁ : t₁ ∈ maximalIdeal _ := by
      rw [← hrsp₁.1]; exact Ideal.subset_span ⟨1, rfl⟩
    have hq₁C : q₁ ∈ (birationalTransform (s.p i) (s.isClosed_p i hlt)
        (s.transformedSubscheme C₀ i)).support := by
      rw [← IdealSheafData.stalk_le_maximalIdeal_iff_mem_support, hstalk₁,
        Ideal.span_singleton_le_iff_mem]
      refine Ideal.pow_le_self (n := m) (by omega) ?_
      refine Ideal.pow_right_mono (Ideal.span_le.mpr ?_) m hg'
      rintro _ (rfl | rfl)
      · exact Ideal.pow_mem_of_mem _ hxq₁ _ (by omega)
      · exact htq₁
    obtain rfl : q₁ = (s.blowupIso i hlt).hom (s.p (i + 1)) := by
      have : q₁ ∈ {q' | q' ∈ (birationalTransform (s.p i) (s.isClosed_p i hlt)
          (s.transformedSubscheme C₀ i)).support ∧
            (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal
              ⟨{s.p i}, s.isClosed_p i hlt⟩)).base q' = s.p i} := ⟨hq₁C, hπ₁⟩
      rwa [(H1 _ hqC hqE hmq).1, Set.mem_singleton_iff] at this
    -- the data at `p_{i+1}`
    set ψ := stalkEquiv (s.blowupIso i hlt).hom (s.p (i + 1)) with hψ
    have hσ : (s.σ i hlt).base (s.p (i + 1)) = s.p i := hπ₁
    have hπ' : (s.π (i + 1) hi).base (s.p (i + 1)) = p₀ := by
      show (s.σ i hlt ≫ s.π i hlt.le).base (s.p (i + 1)) = p₀
      rw [Scheme.Hom.comp_apply, hσ, hπ]
    have hΦ : ∀ a, stalkHom (s.π (i + 1) hi) (s.p (i + 1)) hπ' a =
        ψ (stalkHom _ _ hπ₁ (stalkHom (s.π i hlt.le) (s.p i) hπ a)) := by
      intro a
      have k1 := stalkHom_comp (s.σ i hlt) (s.π i hlt.le) (s.p (i + 1)) hσ hπ hπ' a
      have k2 := stalkHom_comp (s.blowupIso i hlt).hom (blowUpToBase
        (Scheme.IdealSheafData.vanishingIdeal ⟨{s.p i}, s.isClosed_p i hlt⟩)) (s.p (i + 1)) rfl
        hπ₁ hσ (stalkHom (s.π i hlt.le) (s.p i) hπ a)
      rw [stalkHom_eq_stalkEquiv] at k2
      exact k1.trans k2
    have heq : stalkHom (s.π (i + 1) hi) (s.p (i + 1)) hπ' =
        ψ.toRingHom.comp ((stalkHom _ _ hπ₁).comp (stalkHom (s.π i hlt.le) (s.p i) hπ)) :=
      RingHom.ext hΦ
    refine ⟨hπ', ψ t₁, ψ f₁, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, IsRegularLocalRing.of_ringEquiv ψ,
      isNoetherian_of_iso (s.blowupIso i hlt), ?_⟩
    · rw [hΦ, hΦ, ← map_pow, ← map_mul]
      congr 1
      rw [pow_succ, mul_assoc, e1, ← map_pow, ← map_mul, h1]
    · rw [hΦ, hΦ, ← map_pow, ← map_mul]
      congr 1
      rw [show m * (i + 1) = m * i + m by ring, pow_add, mul_assoc, e2, ← map_pow, ← map_mul, h2]
    · rw [hΦ]; exact isRegularSystemOfParameters_map_ringEquiv ψ hrsp₁
    · have k1 := IsPolynomialFraction.trans hfrac hfrac₁ (x := x) (i := 1)
        (by rw [pow_one]; exact e1.symm)
      have k2 : IsPolynomialFraction ψ.toRingHom (ψ t₁) :=
        isPolynomialFraction_of_surjective ψ.surjective _
      have k3 := IsPolynomialFraction.trans k1 k2 (x := x) (i := 0)
        (by rw [pow_zero, one_mul]; rfl)
      rwa [heq]
    · rw [heq]; exact ψ.injective.comp (hinj₁.comp hinj)
    · rw [hT, stalk_comap_eq_map_stalkEquiv, hstalk₁, Ideal.map_span, Set.image_singleton]
    · rw [hΦ, show k + 1 - (i + 1) = k - i by omega, ← map_pow]
      have := Ideal.mem_map_of_mem ψ hg'
      rwa [Ideal.map_pow, Ideal.map_span, Set.image_pair] at this
    · intro _
      rw [exceptionalCurve_succ s i hlt, stalk_comap_eq_map_stalkEquiv, hE₁, Ideal.map_span,
        Set.image_singleton, hΦ]
    · rw [hT]
      exact (hasPrincipalStalks_birationalTransform _ hreg' hdim hP
        (by rw [hs.1 i hlt.le]; exact ENat.coe_ne_top m)).comap _

end Sequence

section LastBlowup

open MMP.Resolution

/-- **The last blow-up.** Let `p` be a closed point of a Noetherian scheme `S` with a regular
system of parameters `(u, t)`, and `C` a curve with principal stalks, local equation `g` and
multiplicity `m ≥ 2` at `p`. If a point `q` of the birational transform `C₁` on the exceptional
curve has multiplicity `m`, then for some regular system of parameters `(X, Y)` of `𝒪_{S,p}` the
equation `g` is in normal form with respect to `(X, Y)` and `g ∈ (X^2, Y)^m`. -/
private theorem exists_isInNormalForm_mem_span_sq_pow {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (C : S.IdealSheafData) (hC : HasPrincipalStalks C)
    {g u t : S.presheaf.stalk p} (hut : MMP.Mori.IsRegularSystemOfParameters ![u, t])
    (hg : IdealSheafData.stalk C p = Ideal.span {g}) {m : ℕ} (hm : 2 ≤ m)
    (hmult : multAt C p = m) (q : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hqC : q ∈ (birationalTransform p hp C).support)
    (hqE : q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support)
    (hmq : multAt (birationalTransform p hp C) q = m) :
    ∃ X Y : S.presheaf.stalk p, IsInNormalForm X Y g ∧ g ∈ Ideal.span {X ^ 2, Y} ^ m := by
  haveI : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing (S.presheaf.stalk p) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  have hreg : IsRegularLocalRing (S.presheaf.stalk p) :=
    MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hut
  haveI := hreg
  have hdim : ringKrullDim (S.presheaf.stalk p) = 2 := by rw [hut.2]; rfl
  have hCc := isEffectiveCartierSubscheme_of_hasPrincipalStalks hC
  obtain ⟨-, hsupp, -, X, Y, hnf, -⟩ := exists_isInNormalForm_of_multAt_birationalTransform_eq hp
    hreg hdim C hCc g hg m hmult (by omega) q hqC hqE hmq
  have hXY := isRegularSystemOfParameters_of_isInNormalForm hdim hnf
  have hmultg : mult g = m := by rwa [mult, ← hg]
  obtain ⟨q₁, -, hπ₁, T, f₁, e1, e2, hrsp₁, hfrac₁, hinj₁, hstalk₁, -, hreg₁⟩ :=
    exists_chartPoint C hC hp hg hXY hmultg
  haveI := hreg₁
  haveI : IsDomain ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk
    q₁) := IsRegularLocalRing.isDomain _
  have hXm : stalkHom _ q₁ hπ₁ X ∈ maximalIdeal _ := by
    rw [← hrsp₁.1]; exact Ideal.subset_span ⟨0, rfl⟩
  have hTm : T ∈ maximalIdeal _ := by
    rw [← hrsp₁.1]; exact Ideal.subset_span ⟨1, rfl⟩
  have hX0 : stalkHom _ q₁ hπ₁ X ≠ 0 := fun h0 =>
    ne_zero_of_isRegularSystemOfParameters hXY 0 (hinj₁ (h0.trans (map_zero _).symm))
  -- `x^{-m} g` vanishes at the chart point, so the chart point is `q`
  obtain ⟨w, -, hw⟩ := IsInNormalForm.exists_unit hnf hmultg
  have hΦm : (maximalIdeal (S.presheaf.stalk p) ^ (m + 1)).map (stalkHom _ q₁ hπ₁) ≤
      Ideal.span {stalkHom _ q₁ hπ₁ X ^ (m + 1)} := by
    rw [← hnf.1, Ideal.map_pow, Ideal.map_span, Set.image_pair, ← e1,
      ← Ideal.span_singleton_pow]
    refine Ideal.pow_right_mono ?_ _
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Ideal.mem_span_singleton_self _
    · exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  obtain ⟨h', hh'⟩ := Ideal.mem_span_singleton'.mp (hΦm (Ideal.mem_map_of_mem _ hw))
  rw [map_sub, map_mul, map_pow, ← e1, ← e2] at hh'
  have hf₁ : f₁ = stalkHom _ q₁ hπ₁ w * T ^ m + stalkHom _ q₁ hπ₁ X * h' := by
    refine mul_left_cancel₀ (pow_ne_zero_of_isDomain hX0 m) ?_
    linear_combination -hh'
  have hq₁C : q₁ ∈ (birationalTransform p hp C).support := by
    rw [← IdealSheafData.stalk_le_maximalIdeal_iff_mem_support, hstalk₁,
      Ideal.span_singleton_le_iff_mem, hf₁]
    exact add_mem (Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hTm _ (by omega)))
      (Ideal.mul_mem_right _ _ hXm)
  have hq₁E := (mem_support_exceptionalIdeal_iff p hp q₁).mpr hπ₁
  obtain rfl : q₁ = q := by
    have : q₁ ∈ ((birationalTransform p hp C ⊔
        exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support : Set _) := by
      rw [Scheme.IdealSheafData.support_sup]; exact ⟨hq₁C, hq₁E⟩
    rwa [hsupp] at this
  -- `x^{-m} g` has order `m` at `q`
  have hmf₁ : ((m : ℕ) : ℕ∞) ≤ idealOrder (Ideal.span {f₁}) := by rw [← hstalk₁, ← multAt, hmq]
  have hf₁m : f₁ ∈ Ideal.span {stalkHom _ q₁ hπ₁ X, T} ^ m := by
    rw [← Matrix.range_cons_cons_empty (u := ![]), hrsp₁.1]
    exact le_pow_of_le_idealOrder hmf₁ (Ideal.mem_span_singleton_self f₁)
  have hmem : stalkHom _ q₁ hπ₁ g ∈ (Ideal.span {X ^ 2, Y} ^ m).map (stalkHom _ q₁ hπ₁) := by
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, map_pow, ← e1, ← e2, pow_two,
      span_mul_pair_pow]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hf₁m
  exact ⟨X, Y, hnf, mem_of_map_mem_span_pow hXY hinj₁ (a := 1) (b := 2) le_rfl one_lt_two
    (by omega) (by rw [pow_one]; exact e1) hXm hTm hfrac₁ hmem⟩

end LastBlowup

section Main

open MMP.Resolution PointBlowupSequence

/-- **Kollár, Proposition 1.69 ("moreover")**. Let `S₀` be a two-dimensional regular Noetherian
scheme, `C₀ ⊆ S₀` a reduced effective Cartier divisor, `p₀ ∈ C₀` a point with local equation
`f ∈ R₀ = 𝒪_{S₀,p₀}`, `m ≥ 2`, and `(x, y')` a regular system of
parameters of `R₀` with `f ∈ (x^{k+1}, y')^m`, such that `f` is in normal form with respect to
`(x, y')` (`MMP.Resolution.IsInNormalForm`) when `k = 0`. If `s` is a blow-up sequence of
multiplicity `m` for `C₀` (`IsConstantMultiplicity`) of length at least `k + 1` starting at `p₀`,
then there is `a ∈ R₀` with `f ∈ (x^{k+2}, y' - a x^{k+1})^m`. -/
@[mmp "prop_kr1c_ideal_membership_from_blowup_sequence"]
public theorem exists_mem_span_pow_of_isConstantMultiplicity
    {S₀ : Scheme.{u}} [IsNoetherian S₀]
    (hreg : ∀ q : S₀, IsRegularLocalRing (S₀.presheaf.stalk q))
    (hdim : topologicalKrullDim S₀ = 2)
    (C₀ : S₀.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C₀)
    [IsReduced C₀.subscheme] {p₀ : S₀}
    (hp₀C : p₀ ∈ C₀.support) {m : ℕ} (hm : 2 ≤ m)
    {f : S₀.presheaf.stalk p₀} (hf : IdealSheafData.stalk C₀ p₀ = Ideal.span {f})
    (k : ℕ) {x y' : S₀.presheaf.stalk p₀} (hxy : MMP.Mori.IsRegularSystemOfParameters ![x, y'])
    (hmem : f ∈ Ideal.span {x ^ (k + 1), y'} ^ m)
    (hnf : k = 0 → MMP.Resolution.IsInNormalForm x y' f)
    (s : PointBlowupSequence S₀) (hlen : ((k + 1 : ℕ) : ℕ∞) ≤ s.length)
    (hp₀ : s.zeroIso.hom.base (s.p 0) = p₀) (hs : s.IsConstantMultiplicity C₀ m) :
    ∃ a : S₀.presheaf.stalk p₀,
      f ∈ Ideal.span {x ^ (k + 2), y' - a * x ^ (k + 1)} ^ m := by
  haveI : IsLocallyNoetherian S₀ := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing (S₀.presheaf.stalk p₀) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  have hlt : (k : ℕ∞) < s.length := coe_lt_of_succ_le hlen
  obtain ⟨hπ, t, g, h1, h2, hrsp, hfrac, hinj, hstalk, -, hE, hreg', hN, hP⟩ :=
    isChartPoint_of_le hreg C₀ hC hm hf k hxy hmem s hp₀ hs k hlt.le le_rfl
  haveI := hN
  haveI := hreg'
  haveI : IsLocallyNoetherian (s.S k) := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing ((s.S k).presheaf.stalk (s.p k)) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  have hdimk : ringKrullDim ((s.S k).presheaf.stalk (s.p k)) = 2 := by rw [hrsp.2]; rfl
  have hmultg : mult g = m := by rw [mult, ← hstalk]; exact hs.1 k hlt.le
  set φ := stalkHom (s.π k hlt.le) (s.p k) hπ with hφ
  -- the last blow-up: `g ∈ (X^2, Y)^m` for a normal form `(X, Y)` of `g`
  obtain ⟨hqC, hqE, hmq⟩ := mem_support_blowupIso_p_succ hs k hlen
  obtain ⟨X, Y, hnfXY, hgXY⟩ := exists_isInNormalForm_mem_span_sq_pow (s.isClosed_p k hlt) _ hP
    hrsp hstalk hm (hs.1 k hlt.le) _ hqC hqE hmq
  have hut : Ideal.span {φ x, t} = maximalIdeal _ := by
    rw [← Matrix.range_cons_cons_empty (u := ![])]; exact hrsp.1
  have hxm : φ x ∈ maximalIdeal _ := hut ▸ Ideal.subset_span (Set.mem_insert _ _)
  have htm : t ∈ maximalIdeal _ := hut ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  -- the tangent `(Y)` is `(t - a x)` modulo `𝔪^2`, for some `a ∈ R₀`
  obtain ⟨a, ha⟩ : ∃ a : S₀.presheaf.stalk p₀, Ideal.span {Y} ⊔ maximalIdeal _ ^ 2 =
      Ideal.span {t - φ a * φ x} ⊔ maximalIdeal _ ^ 2 := by
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · refine ⟨0, ?_⟩
      rw [map_zero, zero_mul, sub_zero]
      have hbij : Function.Bijective φ := bijective_stalkHom_of_isIso s.zeroIso.hom (s.p 0) hπ
      have hnf0 := IsInNormalForm.map_ringEquiv (RingEquiv.ofBijective φ hbij) (hnf rfl)
      simp only [RingEquiv.ofBijective_apply] at hnf0
      rw [pow_zero, one_mul] at h1
      rw [mul_zero, pow_zero, one_mul] at h2
      rw [← h1, ← h2] at hnf0
      apply le_antisymm
      · exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr
          (mem_span_sup_sq_of_isInNormalForm hdimk hnf0 hnfXY hmultg (by omega))) le_sup_right
      · exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr
          (mem_span_sup_sq_of_isInNormalForm hdimk hnfXY hnf0 hmultg (by omega))) le_sup_right
    · obtain ⟨i, rfl⟩ : ∃ i, k = i + 1 := ⟨k - 1, by omega⟩
      have htan := not_dvd_isLeadingTerm_of_isConstantMultiplicity
        hreg hdim C₀ hC hp₀C hm s hp₀ hs i hlt.le
      have hEst := hE (by omega)
      rw [exceptionalCurve_succ s i (coe_lt_of_succ_le hlt.le)] at hEst
      obtain ⟨c, hc⟩ := exists_span_eq_sub_mul_of_not_dvd hdimk hut hnfXY hmultg (by omega)
        (fun L F hL hF => htan.2.1 _ _ hrsp _ hEst L hL g hstalk F hF)
      have hφm : ∀ r ∈ maximalIdeal (S₀.presheaf.stalk p₀), φ r ∈ maximalIdeal _ := by
        intro r hr
        rw [← hxy.1, Matrix.range_cons_cons_empty (u := ![])] at hr
        have := Ideal.mem_map_of_mem φ hr
        rw [Ideal.map_span, Set.image_pair] at this
        refine (Ideal.span_le.mpr ?_) this
        rintro _ (rfl | rfl)
        · exact hxm
        · rw [← h1]
          exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hxm _ (by omega))
      obtain ⟨a, ha⟩ := exists_sub_mem_maximalIdeal hfrac htm hφm c
      refine ⟨a, ?_⟩
      rw [hc]
      apply span_sup_sq_eq
      rw [show t - c * φ x - (t - φ a * φ x) = -(c - φ a) * φ x by ring, pow_two]
      exact Ideal.mul_mem_mul (neg_mem ha) hxm
  -- `f = x^{mk} g ∈ (x^{k+2}, y' - a x^{k+1})^m` in `𝔪_{p_k}`, and contraction to `R₀`
  have hut' : Ideal.span {φ x, t - φ a * φ x} = maximalIdeal _ := by
    rw [show t - φ a * φ x = t + (-φ a) * φ x by ring, Ideal.span_pair_add_mul_left]
    exact hut
  have hgt' : g ∈ Ideal.span {φ x ^ 2, t - φ a * φ x} ^ m := by
    rw [span_sq_pair_eq hut', ← ha, ← span_sq_pair_eq hnfXY.1]
    exact hgXY
  have e : φ x ^ k * (t - φ a * φ x) = φ (y' - a * x ^ (k + 1)) := by
    rw [map_sub, map_mul, map_pow, ← h1]
    ring
  have hfφ : φ f ∈ (Ideal.span {x ^ (k + 2), y' - a * x ^ (k + 1)} ^ m).map φ := by
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, ← e, map_pow,
      show φ x ^ (k + 2) = φ x ^ k * φ x ^ 2 by ring, span_mul_pair_pow, ← h2, ← pow_mul,
      mul_comm k m]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) hgt'
  refine ⟨a, ?_⟩
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · have hbij : Function.Bijective φ := bijective_stalkHom_of_isIso s.zeroIso.hom (s.p 0) hπ
    have := Ideal.mem_comap.mpr hfφ
    rwa [Ideal.comap_map_of_bijective _ hbij] at this
  · have hxy'' : MMP.Mori.IsRegularSystemOfParameters ![x, y' - a * x ^ (k + 1)] := by
      rw [pow_succ, ← mul_assoc]; exact isRegularSystemOfParameters_sub_mul hxy _
    have hfrac' : IsPolynomialFraction φ (t - φ a * φ x) := by
      rw [← map_mul]; exact IsPolynomialFraction.sub hfrac (a * x)
    have ht'm : t - φ a * φ x ∈ maximalIdeal _ :=
      hut' ▸ Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    haveI : IsDomain ((s.S k).presheaf.stalk (s.p k)) := IsRegularLocalRing.isDomain _
    exact mem_of_map_mem_span_pow hxy'' hinj (a := k) (b := k + 2) hk (by omega) (by omega) e
      hxm ht'm hfrac' hfφ

end Main

end

/-! ### Ideal membership along a blow-up sequence -/

section

open MMP.Resolution PointBlowupSequence

section Coefficients

variable {R : Type*} [CommRing R]

open Classical in
/-- A coefficient `a` with `f ∈ (x^{j+2}, b - a x^{j+1})^m` if there is one, and `0` otherwise. -/
private noncomputable def nextCoeff (x f : R) (m j : ℕ) (b : R) : R :=
  if h : ∃ a : R, f ∈ Ideal.span {x ^ (j + 2), b - a * x ^ (j + 1)} ^ m then h.choose else 0

private theorem mem_span_pow_nextCoeff {x f : R} {m j : ℕ} {b : R}
    (h : ∃ a : R, f ∈ Ideal.span {x ^ (j + 2), b - a * x ^ (j + 1)} ^ m) :
    f ∈ Ideal.span {x ^ (j + 2), b - nextCoeff x f m j b * x ^ (j + 1)} ^ m := by
  rw [nextCoeff, dif_pos h]
  exact h.choose_spec

/-- The successive parameters `y_0 = y`, `y_{j+1} = y_j - a_{j+1} x^{j+1}`. -/
private noncomputable def approxParam (x y f : R) (m : ℕ) : ℕ → R
  | 0 => y
  | j + 1 => approxParam x y f m j - nextCoeff x f m j (approxParam x y f m j) * x ^ (j + 1)

/-- The successive coefficients `a_{j+1}` (and `a_0 = 0`). -/
private noncomputable def approxCoeff (x y f : R) (m : ℕ) : ℕ → R
  | 0 => 0
  | j + 1 => nextCoeff x f m j (approxParam x y f m j)

private theorem approxParam_eq (x y f : R) (m : ℕ) (j : ℕ) :
    approxParam x y f m j = y - ∑ i ∈ Finset.Icc 1 j, approxCoeff x y f m i * x ^ i := by
  induction j with
  | zero => simp [approxParam]
  | succ j ih =>
    rw [Finset.sum_Icc_succ_top (by omega), approxParam, approxCoeff, ih]
    ring

/-- Every `(x, y_j)` is a regular system of parameters if `(x, y)` is. -/
private theorem isRegularSystemOfParameters_approxParam [IsLocalRing R] {x y : R}
    (h : MMP.Mori.IsRegularSystemOfParameters ![x, y]) (f : R) (m j : ℕ) :
    MMP.Mori.IsRegularSystemOfParameters ![x, approxParam x y f m j] := by
  induction j with
  | zero => exact h
  | succ j ih =>
    rw [approxParam, pow_succ, ← mul_assoc]
    exact isRegularSystemOfParameters_sub_mul ih _

/-- A two-dimensional regular local ring has a regular system of parameters `(x, y)`. -/
private theorem exists_isRegularSystemOfParameters_pair [IsRegularLocalRing R]
    (hdim : ringKrullDim R = 2) : ∃ x y : R, MMP.Mori.IsRegularSystemOfParameters ![x, y] := by
  obtain ⟨n, z, hz⟩ := MMP.Mori.exists_isRegularSystemOfParameters R
  obtain rfl : n = 2 := by exact_mod_cast (hdim ▸ hz.2).symm
  refine ⟨z 0, z 1, ?_⟩
  convert hz using 1
  ext i; fin_cases i <;> rfl

end Coefficients

section Main

/-- If a blow-up sequence of multiplicity `m` of length at least one starts at `p₀`, then `f` is
in normal form with respect to some regular system of parameters of `𝒪_{S₀,p₀}`. -/
private theorem exists_isInNormalForm {S₀ : Scheme.{u}} [IsNoetherian S₀]
    (hreg : ∀ q : S₀, IsRegularLocalRing (S₀.presheaf.stalk q))
    (C₀ : S₀.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C₀) {p₀ : S₀}
    (hdim₀ : ringKrullDim (S₀.presheaf.stalk p₀) = 2) {m : ℕ} (hm : 2 ≤ m)
    {f : S₀.presheaf.stalk p₀} (hf : IdealSheafData.stalk C₀ p₀ = Ideal.span {f})
    (s : PointBlowupSequence S₀) (hp₀ : s.zeroIso.hom.base (s.p 0) = p₀)
    (hs : s.IsConstantMultiplicity C₀ m) (hlen : ((0 + 1 : ℕ) : ℕ∞) ≤ s.length) :
    ∃ x y : S₀.presheaf.stalk p₀, IsInNormalForm x y f := by
  subst hp₀
  have hlt : ((0 : ℕ) : ℕ∞) < s.length := coe_lt_of_succ_le hlen
  set σ := stalkEquiv s.zeroIso.hom (s.p 0)
  haveI := isNoetherian_of_iso s.zeroIso
  haveI : IsLocallyNoetherian (s.S 0) := IsNoetherian.toIsLocallyNoetherian
  haveI := hreg (s.zeroIso.hom (s.p 0))
  have hreg' : IsRegularLocalRing ((s.S 0).presheaf.stalk (s.p 0)) :=
    IsRegularLocalRing.of_ringEquiv σ
  have hdim' : ringKrullDim ((s.S 0).presheaf.stalk (s.p 0)) = 2 := by
    rw [← ringKrullDim_eq_of_ringEquiv σ]; exact hdim₀
  have hT : s.transformedSubscheme C₀ 0 = C₀.comap s.zeroIso.hom := rfl
  have hCc : MMP.Intersection.IsEffectiveCartierSubscheme (s.transformedSubscheme C₀ 0) := by
    rw [hT]
    exact isEffectiveCartierSubscheme_of_hasPrincipalStalks
      ((hasPrincipalStalks_of_isEffectiveCartierDivisor hC).comap s.zeroIso.hom)
  have hfC : IdealSheafData.stalk (s.transformedSubscheme C₀ 0) (s.p 0) = Ideal.span {σ f} := by
    rw [hT, stalk_comap_eq_map_stalkEquiv, hf, Ideal.map_span, Set.image_singleton]
  have hmC := hs.1 0 hlt.le
  obtain ⟨hqC, hqE, hmq⟩ := mem_support_blowupIso_p_succ hs 0 hlen
  obtain ⟨-, -, -, X, Y, hnf, -⟩ := exists_isInNormalForm_of_multAt_birationalTransform_eq _
    hreg' hdim' _ hCc (σ f) hfC m hmC (by omega) _ hqC hqE hmq
  refine ⟨σ.symm X, σ.symm Y, ?_⟩
  simpa using IsInNormalForm.map_ringEquiv σ.symm hnf

/-- **Kollár, Proposition 1.69 ("only if")**. Let `S₀` be a two-dimensional regular Noetherian
scheme, `C₀ ⊆ S₀` a reduced effective Cartier divisor, `p₀ ∈ C₀` a point with
`multAt C₀ p₀ = m ≥ 2` and local equation `f ∈ R₀ = 𝒪_{S₀,p₀}`. If `s` is a blow-up sequence of
multiplicity `m` for `C₀` (`IsConstantMultiplicity`) starting at `p₀`, then there are a regular
system of parameters `(x, y)` of `R₀` and `a : ℕ → R₀` such that
`f ∈ (x^{j+1}, y - ∑_{i=1}^j a i * x^i)^m` for every natural number `j ≤ s.length`. -/
@[mmp "prop_kr1c_blowup_sequence_gives_ideal_membership"]
public theorem exists_forall_mem_span_pow_of_isConstantMultiplicity
    {S₀ : Scheme.{u}} [IsNoetherian S₀]
    (hreg : ∀ q : S₀, IsRegularLocalRing (S₀.presheaf.stalk q))
    (hdim : topologicalKrullDim S₀ = 2)
    (C₀ : S₀.IdealSheafData) (hC : Stacks.Divisors.IsEffectiveCartierDivisor C₀)
    [IsReduced C₀.subscheme] {p₀ : S₀}
    (hp₀C : p₀ ∈ C₀.support) {m : ℕ} (hm : 2 ≤ m) (hmult : multAt C₀ p₀ = m)
    {f : S₀.presheaf.stalk p₀} (hf : IdealSheafData.stalk C₀ p₀ = Ideal.span {f})
    (s : PointBlowupSequence S₀) (hp₀ : s.zeroIso.hom.base (s.p 0) = p₀)
    (hs : s.IsConstantMultiplicity C₀ m) :
    ∃ (x y : S₀.presheaf.stalk p₀) (a : ℕ → S₀.presheaf.stalk p₀),
      MMP.Mori.IsRegularSystemOfParameters ![x, y] ∧
      ∀ j : ℕ, (j : ℕ∞) ≤ s.length →
        f ∈ Ideal.span {x ^ (j + 1), y - ∑ i ∈ Finset.Icc 1 j, a i * x ^ i} ^ m := by
  haveI : IsLocallyNoetherian S₀ := IsNoetherian.toIsLocallyNoetherian
  haveI : IsNoetherianRing (S₀.presheaf.stalk p₀) :=
    instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian
  haveI := hreg p₀
  have hdim₀ : ringKrullDim (S₀.presheaf.stalk p₀) = 2 :=
    MMP.Resolution.Kollar.ringKrullDim_stalk_eq_two_of_singular hreg hdim.le C₀ hC hp₀C
      (Or.inl (by rw [hmult]; exact_mod_cast hm))
  -- a regular system of parameters, in normal form for `f` if the sequence is not trivial
  obtain ⟨x, y, hxy, hnf⟩ : ∃ x y : S₀.presheaf.stalk p₀,
      MMP.Mori.IsRegularSystemOfParameters ![x, y] ∧
        (((0 + 1 : ℕ) : ℕ∞) ≤ s.length → IsInNormalForm x y f) := by
    by_cases hlen : ((0 + 1 : ℕ) : ℕ∞) ≤ s.length
    · obtain ⟨x, y, hnf⟩ := exists_isInNormalForm hreg C₀ hC hdim₀ hm hf s hp₀ hs hlen
      exact ⟨x, y, isRegularSystemOfParameters_of_isInNormalForm hdim₀ hnf, fun _ => hnf⟩
    · obtain ⟨x, y, hxy⟩ := exists_isRegularSystemOfParameters_pair hdim₀
      exact ⟨x, y, hxy, fun h => absurd h hlen⟩
  refine ⟨x, y, approxCoeff x y f m, hxy, fun j hj => ?_⟩
  rw [← approxParam_eq]
  induction j with
  | zero =>
    -- `f ∈ 𝔪^m = (x, y)^m`
    rw [approxParam, zero_add, pow_one, ← Matrix.range_cons_cons_empty (u := ![]), hxy.1]
    refine le_pow_of_le_idealOrder ?_ (Ideal.mem_span_singleton_self f)
    rw [← hf, ← multAt, hmult]
  | succ j ih =>
    rw [approxParam]
    exact mem_span_pow_nextCoeff
      (exists_mem_span_pow_of_isConstantMultiplicity
        hreg hdim C₀ hC hp₀C hm hf j
        (isRegularSystemOfParameters_approxParam hxy f m j) (ih (coe_lt_of_succ_le hj).le)
        (fun hj0 => by subst hj0; exact hnf hj) s hj hp₀ hs)

end Main

end

end MMP.Resolution.PointBlowupSequence

