/-!
# Local algebra and charts for the blow-up of a point of a regular surface

This file collects the commutative algebra and the local geometry of a point blow-up used in
Kollár's treatment of embedded resolution of curves on surfaces.

Let `S` be a Noetherian scheme, `p ∈ S` a closed point with `𝒪_{S,p}` regular of dimension two,
and `π : B_pS → S` the blow-up of `p` with exceptional curve `E`. Over a coordinate neighbourhood
`U = Spec A` of `p` on which `(x, y)` generates the ideal of `p`, `B_pS` is covered by the two
charts `Spec A[y/x]` and `Spec A[x/y]`, and `E` meets them in `x = 0` and `y = 0`. Off `E`, `π` is
an isomorphism, so the birational transform of a curve `C` there is the inverse image of `C`. On
the chart `Spec A[y/x]` it is cut out by `f¹ = f / x^m`, where `m = mult_p C`, a nonzero element
of the domain `A[y/x]`. Hence an ideal sheaf whose stalks are generated by nonzerodivisors
(`MMP.Resolution.Kr1c.HasPrincipalStalks`) keeps this property under the birational transform
(`MMP.Resolution.Kr1c.hasPrincipalStalks_birationalTransform`); on a locally Noetherian scheme
such an ideal sheaf is the ideal of an effective Cartier divisor.

The algebra consists of facts on homogeneous forms in two variables, on ideals and
nonzerodivisors under ring isomorphisms, and on rings of polynomial fractions `F(t) / G(t)`
(`MMP.Resolution.Kr1c.IsPolynomialFraction`), which describe the local rings of the charts.

## Main definitions

* `MMP.Resolution.Kr1c.HasPrincipalStalks`: every stalk of an ideal sheaf is generated by a
  nonzerodivisor.
* `MMP.Resolution.Kr1c.stalkEquiv`: the stalk isomorphism of an open immersion.
* `MMP.Resolution.Kr1c.stalkHom`: the stalk map `𝒪_{Y,y} → 𝒪_{X,x}` of `f` for `f x = y`.
* `MMP.Resolution.Kr1c.IsPolynomialFraction`, `MMP.Resolution.Kr1c.fractionSubring`: rings all
  of whose elements are fractions of polynomial expressions in one element.

## Main results

* `MMP.Resolution.Kr1c.exists_coordinateNeighbourhood`: a coordinate neighbourhood of `p` on
  which a curve with principal stalks is principal, with the multiplicity read off the germ.
* `MMP.Resolution.Kr1c.mem_or_mem_of_mem_support`: a point of `E` lies on one of the two charts.
* `MMP.Resolution.Kr1c.exists_span_eq_stalk_birationalTransform_of_notMem`,
  `MMP.Resolution.Kr1c.exists_span_eq_stalk_birationalTransform_of_mem_chart`: the stalks of the
  birational transform off `E` and on a chart.
* `MMP.Resolution.Kr1c.hasPrincipalStalks_birationalTransform`: principal stalks are preserved by
  the birational transform.
* `MMP.Resolution.Kr1c.isEffectiveCartierSubscheme_of_hasPrincipalStalks`: principal stalks give
  an effective Cartier subscheme.
* `MMP.Resolution.Kr1c.mem_support_blowupIso_p_succ`: the next centre of a blow-up sequence of
  constant multiplicity lies on the birational transform and on the exceptional curve.

## References

* [J. Kollár, *Lectures on resolution of singularities*][kollar2007], 1.36–1.69.
-/

@[expose] public section

universe u

open AlgebraicGeometry CategoryTheory IsLocalRing MMP.Resolution

namespace MMP.Resolution.Kr1c

section Homogeneous

open MvPolynomial

variable {R : Type*} [CommRing R] [IsLocalRing R]

/-- An exponent `d` in the support of a form of degree `m` in two variables has `d 0 + d 1 = m`. -/
theorem add_eq_of_mem_support {R : Type*} [CommSemiring R] {F : MvPolynomial (Fin 2) R}
    {m : ℕ} (hF : F.IsHomogeneous m) {d : Fin 2 →₀ ℕ} (hd : d ∈ F.support) : d 0 + d 1 = m := by
  rw [← hF (MvPolynomial.mem_support_iff.mp hd), Finsupp.weight_apply,
    Finsupp.sum_fintype _ _ (fun _ => by simp), Fin.sum_univ_two]
  simp

/-- A form of degree `m` with coefficients in `𝔪` evaluated at `x, y ∈ 𝔪` lies in `𝔪^(m+1)`. -/
theorem eval_mem_pow_succ_of_map_eq_zero {x y : R} (hx : x ∈ maximalIdeal R)
    (hy : y ∈ maximalIdeal R) {m : ℕ} {G : MvPolynomial (Fin 2) R} (hG : G.IsHomogeneous m)
    (h0 : map (residue R) G = 0) :
    eval ![x, y] G ∈ maximalIdeal R ^ (m + 1) := by
  rw [eval_eq']
  refine Ideal.sum_mem _ fun d hd => ?_
  have hdeg : d 0 + d 1 = m := add_eq_of_mem_support hG hd
  have hc : G.coeff d ∈ maximalIdeal R := by
    have := congrArg (·.coeff d) h0
    rw [coeff_map, MvPolynomial.coeff_zero, Finsupp.coe_zero, Pi.zero_apply] at this
    exact (residue_eq_zero_iff _).mp this
  have hp : (∏ i, (![x, y] : Fin 2 → R) i ^ d i) ∈ maximalIdeal R ^ m := by
    rw [Fin.prod_univ_two, ← hdeg, pow_add]
    exact Ideal.mul_mem_mul (Ideal.pow_mem_pow hx _) (Ideal.pow_mem_pow hy _)
  rw [pow_succ']
  exact Ideal.mul_mem_mul hc hp

end Homogeneous

section Ideals

variable {R : Type*} [CommRing R]

/-- A term `μ i` of a sum `∑ d j * μ j` with weights `d j ≥ 1` is at most the sum. -/
theorem le_sum_mul {ι : Type*} {s : Finset ι} {d μ : ι → ℕ∞} (hd : ∀ i ∈ s, 1 ≤ d i)
    {i : ι} (hi : i ∈ s) : μ i ≤ ∑ j ∈ s, d j * μ j :=
  (le_mul_of_one_le_left' (hd i hi)).trans
    (Finset.single_le_sum (f := fun j => d j * μ j) (fun _ _ => zero_le) hi)

/-- A field extension has rank at least one. -/
theorem one_le_toENat_rank {K L : Type*} [Field K] [Field L] (φ : K →+* L) :
    1 ≤ (letI := φ.toAlgebra; (Module.rank K L).toENat) := by
  letI := φ.toAlgebra
  have h : (1 : Cardinal) ≤ Module.rank K L := Cardinal.one_le_iff_ne_zero.mpr rank_pos.ne'
  simpa using Cardinal.toENat.monotone' h

/-- The order of the zero ideal of a local ring is infinite. -/
theorem idealOrder_bot {A : Type*} [CommRing A] [IsLocalRing A] :
    idealOrder (⊥ : Ideal A) = ⊤ :=
  ENat.eq_top_iff_forall_ge.mpr fun n => (natCast_le_idealOrder_iff' _ n).mpr bot_le

/-- A pair of elements times units generates the same ideal. -/
theorem span_pair_mul_units {A : Type*} [CommRing A] {a b u v : A} (hu : IsUnit u)
    (hv : IsUnit v) : Ideal.span {a * u, b * v} = Ideal.span {a, b} := by
  rw [Ideal.span_insert, Ideal.span_insert, Ideal.span_singleton_mul_right_unit hu,
    Ideal.span_singleton_mul_right_unit hv]

/-- For `x ≠ 0` in a domain, `y / x` is a solution of `x z = y` in `R[y/x]`. -/
theorem exists_mul_eq [IsDomain R] {x y : R} (hx : x ≠ 0) :
    ∃ z : Algebra.adjoin R {z : FractionRing R | algebraMap R _ x * z = algebraMap R _ y},
      algebraMap R _ x * z = algebraMap R _ y := by
  have hxK : algebraMap R (FractionRing R) x ≠ 0 :=
    fun h => hx ((IsFractionRing.to_map_eq_zero_iff).1 h)
  exact ⟨⟨algebraMap R _ y / algebraMap R _ x,
    Algebra.subset_adjoin (show _ = _ from mul_div_cancel₀ _ hxK)⟩,
    Subtype.ext (mul_div_cancel₀ _ hxK)⟩

/-- `(a u, a v)^n = (a^n) (u, v)^n`. -/
theorem span_mul_pair_pow (a u v : R) (n : ℕ) :
    Ideal.span {a * u, a * v} ^ n = Ideal.span {a ^ n} * Ideal.span {u, v} ^ n := by
  have : Ideal.span {a * u, a * v} = Ideal.span {a} * Ideal.span {u, v} := by
    rw [Ideal.span_mul_span, Set.singleton_mul, Set.image_pair]
  rw [this, mul_pow, Ideal.span_singleton_pow]

/-- An element of `(a u, a v)^n` is `a^n g` with `g ∈ (u, v)^n`. -/
theorem exists_eq_pow_mul_of_mem {a u v f : R} {n : ℕ}
    (h : f ∈ Ideal.span {a * u, a * v} ^ n) :
    ∃ g ∈ Ideal.span {u, v} ^ n, f = a ^ n * g := by
  rw [span_mul_pair_pow] at h
  obtain ⟨g, hg, rfl⟩ := Ideal.mem_span_singleton_mul.mp h
  exact ⟨g, hg, rfl⟩

end Ideals

section RingEquiv

variable {A B : Type*} [CommRing A] [CommRing B]

/-- A ring isomorphism carries nonzerodivisors to nonzerodivisors. -/
theorem map_mem_nonZeroDivisors_ringEquiv (σ : A ≃+* B) {g : A}
    (hg : g ∈ nonZeroDivisors A) : σ g ∈ nonZeroDivisors B := by
  rw [← MulEquivClass.map_nonZeroDivisors σ]
  exact Submonoid.mem_map_of_mem _ hg

/-- If `y = c x` is a nonzerodivisor, so is `x`. -/
theorem mem_nonZeroDivisors_of_mem_span_singleton {x y : A}
    (hy : y ∈ nonZeroDivisors A) (hmem : y ∈ Ideal.span ({x} : Set A)) :
    x ∈ nonZeroDivisors A := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
  exact isRegular_iff_mem_nonZeroDivisors.1
    (IsRegular.of_mul_right (a := c) (hc ▸ isRegular_iff_mem_nonZeroDivisors.2 hy))

/-- Two generators of the same principal ideal, one a nonzerodivisor, differ by a unit. -/
theorem exists_unit_mul_eq_of_span_eq {a b : A}
    (h : Ideal.span ({a} : Set A) = Ideal.span {b}) (ha : a ∈ nonZeroDivisors A) :
    ∃ w : Aˣ, a * w = b := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp
    (h ▸ Ideal.mem_span_singleton_self b : b ∈ Ideal.span ({a} : Set A))
  obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp
    (h.symm ▸ Ideal.mem_span_singleton_self a : a ∈ Ideal.span ({b} : Set A))
  have h0 : (d * c - 1) * a = 0 := by
    rw [sub_mul, mul_assoc, hc, hd, one_mul, sub_self]
  have h1 : d * c = 1 := sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff ha).mp h0)
  exact ⟨⟨c, d, by rw [mul_comm, h1], h1⟩, by rw [Units.val_mk, mul_comm, hc]⟩

/-- An ideal whose image under a ring isomorphism is generated by a nonzerodivisor is itself
generated by a nonzerodivisor. -/
theorem exists_span_eq_of_map_ringEquiv (σ : A ≃+* B) {J : Ideal A} {h : B}
    (hh : h ∈ nonZeroDivisors B) (hJ : J.map σ = Ideal.span {h}) :
    ∃ g ∈ nonZeroDivisors A, J = Ideal.span {g} := by
  refine ⟨σ.symm h, map_mem_nonZeroDivisors_ringEquiv σ.symm hh, ?_⟩
  have e : (J.map σ).map σ.symm = J := Ideal.map_of_equiv σ
  rw [← e, hJ, Ideal.map_span, Set.image_singleton]

end RingEquiv

section NormalForm

variable {O : Type*} [CommRing O] [IsLocalRing O]

/-- Normal forms are carried along ring isomorphisms of local rings. -/
theorem IsInNormalForm.map_ringEquiv {B : Type*} [CommRing B] [IsLocalRing B]
    (σ : O ≃+* B) {x y f : O} (h : IsInNormalForm x y f) :
    IsInNormalForm (σ x) (σ y) (σ f) := by
  have hmax : (maximalIdeal O).map σ = maximalIdeal B :=
    IsLocalRing.map_maximalIdeal_of_surjective σ.toRingHom σ.surjective
  obtain ⟨hxy, n, h1, h2, h3⟩ := h
  refine ⟨?_, n, ?_, ?_, ?_⟩
  · rw [← hmax, ← hxy, Ideal.map_span, Set.image_pair]
  · rw [← hmax, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ h1
  · rwa [← hmax, ← Ideal.map_pow, ← Ideal.symm_apply_mem_of_equiv_iff,
      RingEquiv.symm_apply_apply]
  · rw [← hmax, ← Ideal.map_pow, ← map_pow, show ({σ (y ^ n)} : Set B) = σ '' {y ^ n} by simp,
      ← Ideal.map_span, ← Ideal.map_sup]
    exact Ideal.mem_map_of_mem _ h3

end NormalForm

section Fractions

open Polynomial

variable {R O : Type*} [CommRing R] [CommRing O]

/-- Every element of `O` is a fraction `F(t) / G(t)` of polynomial expressions in `t` with
coefficients from `φ : R → O`, with unit denominator. -/
def IsPolynomialFraction (φ : R →+* O) (t : O) : Prop :=
  ∀ o : O, ∃ F G : R[X], IsUnit (G.eval₂ φ t) ∧ o * G.eval₂ φ t = F.eval₂ φ t

/-- The elements of `O` that are fractions in `t` over `φ`. -/
def fractionSubring (φ : R →+* O) (t : O) : Subring O where
  carrier := {o | ∃ F G : R[X], IsUnit (G.eval₂ φ t) ∧ o * G.eval₂ φ t = F.eval₂ φ t}
  zero_mem' := ⟨0, 1, by simp, by simp⟩
  one_mem' := ⟨1, 1, by simp, by simp⟩
  add_mem' := by
    rintro a b ⟨F, G, hG, ha⟩ ⟨F', G', hG', hb⟩
    refine ⟨F * G' + F' * G, G * G', by simpa using hG.mul hG', ?_⟩
    simp only [eval₂_mul, eval₂_add, ← ha, ← hb]
    ring
  mul_mem' := by
    rintro a b ⟨F, G, hG, ha⟩ ⟨F', G', hG', hb⟩
    refine ⟨F * F', G * G', by simpa using hG.mul hG', ?_⟩
    simp only [eval₂_mul, ← ha, ← hb]
    ring
  neg_mem' := by
    rintro a ⟨F, G, hG, ha⟩
    exact ⟨-F, G, hG, by simp [← ha]⟩

/-- A polynomial expression in `t` is a fraction in `t`. -/
theorem eval₂_mem_fractionSubring (φ : R →+* O) (t : O) (F : R[X]) :
    F.eval₂ φ t ∈ fractionSubring φ t :=
  ⟨F, 1, by simp, by simp⟩

/-- The inverse of a unit fraction is a fraction. -/
theorem inv_mem_fractionSubring {φ : R →+* O} {t : O} {o : O}
    (ho : o ∈ fractionSubring φ t) (hu : IsUnit o) :
    ↑hu.unit⁻¹ ∈ fractionSubring φ t := by
  obtain ⟨F, G, hG, hF⟩ := ho
  refine ⟨G, F, ?_, ?_⟩
  · rw [← hF]
    exact hu.mul hG
  · rw [← hF, ← mul_assoc, IsUnit.val_inv_mul, one_mul]

/-- **Fractions are transitive.** If every element of `R₁` is a fraction in `t₁` over
`ψ : R₀ → R₁`, every element of `O` a fraction in `t'` over `φ : R₁ → O`, and
`φ t₁ = φ (ψ x)^i t'`, then every element of `O` is a fraction in `t'` over `φ ∘ ψ`. -/
theorem IsPolynomialFraction.trans {R₀ : Type*} [CommRing R₀] {ψ : R₀ →+* R} {t₁ : R}
    {φ : R →+* O} {t' : O} (h₁ : IsPolynomialFraction ψ t₁) (h' : IsPolynomialFraction φ t')
    {x : R₀} {i : ℕ} (ht : φ t₁ = φ (ψ x) ^ i * t') : IsPolynomialFraction (φ.comp ψ) t' := by
  have hcomp : ∀ F : R₀[X],
      φ (F.eval₂ ψ t₁) = (F.comp (C (x ^ i) * Polynomial.X)).eval₂ (φ.comp ψ) t' := by
    intro F
    rw [hom_eval₂, eval₂_comp, ht]
    congr 1
    simp [eval₂_C, eval₂_X, eval₂_pow, map_pow]
  have himg : ∀ r : R, φ r ∈ fractionSubring (φ.comp ψ) t' := by
    intro r
    obtain ⟨F, G, hG, hr⟩ := h₁ r
    refine ⟨F.comp (C (x ^ i) * Polynomial.X), G.comp (C (x ^ i) * Polynomial.X), ?_, ?_⟩
    · rw [← hcomp]; exact hG.map φ
    · rw [← hcomp, ← hcomp, ← map_mul, hr]
  have hpoly : ∀ H : R[X], H.eval₂ φ t' ∈ fractionSubring (φ.comp ψ) t' := by
    intro H
    induction H using Polynomial.induction_on with
    | C a => simpa using himg a
    | add p q hp hq => rw [eval₂_add]; exact add_mem hp hq
    | monomial n a _ =>
      rw [eval₂_mul, eval₂_C, eval₂_X_pow]
      refine mul_mem (himg a) (pow_mem ?_ _)
      simpa using eval₂_mem_fractionSubring (φ.comp ψ) t' Polynomial.X
  intro o
  obtain ⟨F, G, hG, ho⟩ := h' o
  have : o = F.eval₂ φ t' * ↑hG.unit⁻¹ := by
    rw [← ho, mul_assoc, IsUnit.mul_val_inv, mul_one]
  rw [this]
  exact mul_mem (hpoly F) (inv_mem_fractionSubring (hpoly G) hG)

/-- If every element of the local ring `O` is a fraction in `t` over `φ`, then `O` is the
localization of `R[t]` at the contraction of its maximal ideal. -/
theorem IsPolynomialFraction.isLocalization_atPrime [IsLocalRing O] {φ : R →+* O} {t : O}
    (h : IsPolynomialFraction φ t) :
    letI := φ.toAlgebra
    IsLocalization.AtPrime O
      ((maximalIdeal O).comap (algebraMap (Algebra.adjoin R {t}) O)) := by
  letI := φ.toAlgebra
  have hmem : ∀ F : R[X], F.eval₂ φ t ∈ Algebra.adjoin R {t} := fun F => by
    have := Polynomial.aeval_mem_adjoin_singleton R (x := t) (p := F)
    rwa [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra] at this
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨s, hs⟩
    by_contra hu
    exact hs ((IsLocalRing.mem_maximalIdeal _).mpr hu)
  · intro o
    obtain ⟨F, G, hG, ho⟩ := h o
    refine ⟨⟨⟨_, hmem F⟩, ⟨⟨_, hmem G⟩, ?_⟩⟩, ?_⟩
    · intro hm
      exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mem_comap.mp hm) hG
    · exact ho
  · intro a b hab
    exact ⟨1, by simpa using Subtype.ext hab⟩

/-- Let `B` be generated by `z` over `R₀` and let `σ : O ≃ B_P` identify `O` with a localization
of `B` at a prime, compatibly with `lam : B → O` and with `φ ∘ g = lam` on `R₀`. Then every
element of `O` is a fraction in `lam z` over `φ`. -/
theorem IsPolynomialFraction.of_ringEquiv_localization {R₀ B L : Type*} [CommRing R₀]
    [CommRing B] [CommRing L] [Algebra R₀ B] [Algebra B L] (P : Ideal B) [P.IsPrime]
    [IsLocalization.AtPrime L P] (g : R₀ →+* R) (φ : R →+* O) (lam : B →+* O) (σ : O ≃+* L)
    (hσlam : ∀ b, σ (lam b) = algebraMap B L b) (hcomp : φ.comp g = lam.comp (algebraMap R₀ B))
    (z : B) (hgen : ∀ b : B, ∃ F : R₀[X], aeval z F = b) : IsPolynomialFraction φ (lam z) := by
  have heval : ∀ F : R₀[X], (F.map g).eval₂ φ (lam z) = lam (aeval z F) := fun F => by
    rw [eval₂_map, hcomp, aeval_def, hom_eval₂]
  intro o
  obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.mk'_surjective P.primeCompl (σ o)
  replace hbs : IsLocalization.mk' L b s = σ o := hbs
  obtain ⟨F, rfl⟩ := hgen b
  obtain ⟨G, hG⟩ := hgen (s : B)
  refine ⟨F.map g, G.map g, ?_, ?_⟩
  · rw [heval, hG, ← σ.symm_apply_apply (lam s), hσlam]
    exact (IsLocalization.map_units L s).map σ.symm
  · rw [heval, heval, hG]
    apply σ.injective
    rw [map_mul, hσlam, hσlam, ← IsLocalization.mk'_spec L (aeval z F) s, hbs]

end Fractions

section Primes

open Polynomial

/-- If `B / x ≅ κ[Y]` with `Y ↦ z`, then `(x, z)` is a maximal ideal of `B`. -/
theorem isMaximal_span_pair {κ B : Type*} [Field κ] [CommRing B] {x z : B}
    (φ : κ[X] ≃+* B ⧸ Ideal.span {x}) (hφX : φ Polynomial.X = Ideal.Quotient.mk _ z) :
    (Ideal.span {x, z}).IsMaximal := by
  let ψ : B →+* κ := (Polynomial.evalRingHom 0).comp
    ((φ.symm : B ⧸ Ideal.span {x} →+* κ[X]).comp (Ideal.Quotient.mk _))
  have hψ : ∀ b, ψ b = (φ.symm (Ideal.Quotient.mk _ b)).eval 0 := fun _ => rfl
  have hX : φ.symm (Ideal.Quotient.mk _ z) = Polynomial.X := by
    rw [← hφX, RingEquiv.symm_apply_apply]
  have hsurj : Function.Surjective ψ := by
    intro a
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (φ (Polynomial.C a))
    exact ⟨b, by rw [hψ, hb, RingEquiv.symm_apply_apply, eval_C]⟩
  have hker : RingHom.ker ψ = Ideal.span {x, z} := by
    apply le_antisymm
    · intro b hb
      rw [RingHom.mem_ker, hψ] at hb
      have h0 : (φ.symm (Ideal.Quotient.mk _ b)).coeff 0 = 0 := by
        rwa [Polynomial.coeff_zero_eq_eval_zero]
      obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr h0
      obtain ⟨b', hb'⟩ := Ideal.Quotient.mk_surjective (φ Q)
      have h1 : Ideal.Quotient.mk (Ideal.span {x}) b = Ideal.Quotient.mk _ (z * b') := by
        rw [map_mul, hb', ← hφX, ← map_mul, ← hQ, RingEquiv.apply_symm_apply]
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at h1
      obtain ⟨c, hc⟩ := h1
      rw [show b = c * x + b' * z by linear_combination -hc]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
    · rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe,
        SetLike.mem_coe, RingHom.mem_ker, RingHom.mem_ker]
      refine ⟨?_, ?_⟩
      · rw [hψ, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x), map_zero,
          eval_zero]
      · rw [hψ, hX, eval_X]
  rw [← hker]
  exact RingHom.ker_isMaximal_of_surjective ψ hsurj

/-- If `B / x ≅ κ[Y]`, then `x B` is prime. -/
theorem isPrime_span_singleton_of_ringEquiv {κ B : Type*} [Field κ] [CommRing B] {x : B}
    (φ : κ[X] ≃+* B ⧸ Ideal.span {x}) : (Ideal.span {x}).IsPrime :=
  (Ideal.Quotient.isDomain_iff_prime _).mp (Function.Injective.isDomain φ.symm φ.symm.injective)

/-- A prime containing a chain `0 < P` of primes strictly has height at least two. -/
theorem two_le_height {B : Type*} [CommRing B] [IsDomain B] {P Q : Ideal B} [P.IsPrime]
    [Q.IsPrime] (hP : P ≠ ⊥) (hPQ : P < Q) : 2 ≤ Q.height := by
  have : (⊥ : Ideal B).IsPrime := Ideal.isPrime_bot
  calc (2 : ℕ∞) = 0 + 1 + 1 := by norm_num
    _ ≤ (⊥ : Ideal B).height + 1 + 1 := add_le_add (add_le_add zero_le le_rfl) le_rfl
    _ ≤ P.height + 1 :=
      add_le_add (Ideal.height_add_one_le_of_lt_of_isPrime (bot_lt_iff_ne_bot.mpr hP)) le_rfl
    _ ≤ Q.height := Ideal.height_add_one_le_of_lt_of_isPrime hPQ

/-- If `B / x ≅ κ[Y]` with `Y ↦ z` and `x ≠ 0` in the domain `B`, then `(x, z)` has height at
least two. -/
theorem two_le_height_span_pair {κ B : Type*} [Field κ] [CommRing B] [IsDomain B] {x z : B}
    (φ : κ[X] ≃+* B ⧸ Ideal.span {x}) (hφX : φ Polynomial.X = Ideal.Quotient.mk _ z)
    (hx0 : x ≠ 0) : 2 ≤ (Ideal.span {x, z}).height := by
  have := isPrime_span_singleton_of_ringEquiv φ
  have := (isMaximal_span_pair φ hφX).isPrime
  have hxQ : x ∈ Ideal.span {x, z} := Ideal.subset_span (Set.mem_insert _ _)
  have hzQ : z ∈ Ideal.span {x, z} := Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  refine two_le_height (by rwa [ne_eq, Ideal.span_singleton_eq_bot])
    (lt_of_le_of_ne ((Ideal.span_singleton_le_iff_mem _).mpr hxQ) fun h => ?_)
  have hz0 : Ideal.Quotient.mk (Ideal.span {x}) z = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (h ▸ hzQ)
  rw [← hφX, map_eq_zero_iff _ φ.injective] at hz0
  exact Polynomial.X_ne_zero hz0

end Primes

section Stalks

variable {X Y : Scheme.{u}}

/-- The stalk map of an open immersion, as a ring isomorphism. -/
noncomputable def stalkEquiv (j : X ⟶ Y) [IsOpenImmersion j] (x : X) :
    Y.presheaf.stalk (j x) ≃+* X.presheaf.stalk x :=
  haveI := IsOpenImmersion.instIsIsoCommRingCatStalkMap j x
  (asIso (j.stalkMap x)).commRingCatIsoToRingEquiv

@[simp]
theorem stalkEquiv_apply (j : X ⟶ Y) [IsOpenImmersion j] (x : X) (a : Y.presheaf.stalk (j x)) :
    stalkEquiv j x a = (j.stalkMap x).hom a :=
  rfl

/-- The stalk of a pulled-back ideal sheaf along an open immersion is the image of the stalk. -/
theorem stalk_comap_eq_map_stalkEquiv (j : X ⟶ Y) [IsOpenImmersion j]
    (I : Y.IdealSheafData) (x : X) :
    IdealSheafData.stalk (I.comap j) x = (IdealSheafData.stalk I (j x)).map (stalkEquiv j x) :=
  MMP.Threefold.Mori.OpenRestriction.stalk_comap_eq_map j I x

/-- A point lies on the inverse image `f⁻¹(V(I))` iff its image lies on `V(I)`. -/
theorem mem_support_comap_iff (f : X ⟶ Y) (I : Y.IdealSheafData) (x : X) :
    x ∈ (I.comap f).support ↔ f x ∈ I.support := by
  rw [← SetLike.mem_coe, Scheme.IdealSheafData.support_comap]
  rfl

/-- Every stalk of `Z` is generated by a nonzerodivisor. -/
def HasPrincipalStalks (Z : X.IdealSheafData) : Prop :=
  ∀ x : X, ∃ g ∈ nonZeroDivisors (X.presheaf.stalk x), IdealSheafData.stalk Z x = Ideal.span {g}

/-- Principal stalks are preserved by pulling back along an open immersion. -/
theorem HasPrincipalStalks.comap (j : X ⟶ Y) [IsOpenImmersion j] {Z : Y.IdealSheafData}
    (h : HasPrincipalStalks Z) : HasPrincipalStalks (Z.comap j) := fun x => by
  obtain ⟨g, hg, hZ⟩ := h (j x)
  refine ⟨stalkEquiv j x g, map_mem_nonZeroDivisors_ringEquiv _ hg, ?_⟩
  rw [stalk_comap_eq_map_stalkEquiv, hZ, Ideal.map_span, Set.image_singleton]

/-- An effective Cartier divisor in the sense of the Stacks project has principal stalks. -/
theorem hasPrincipalStalks_of_isEffectiveCartierDivisor {Z : X.IdealSheafData}
    (h : Stacks.Divisors.IsEffectiveCartierDivisor Z) : HasPrincipalStalks Z := fun x => by
  obtain ⟨U, hU, hxU, f, hf, hgen⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor Z h x
  refine ⟨_, Stacks.Divisors.germ_mem_nonZeroDivisors hU hf x hxU, ?_⟩
  rw [IdealSheafData.stalk_eq_map_germ Z x ⟨U, hU⟩ hxU, hgen, Ideal.map_span, Set.image_singleton]

/-- **Principal stalks glue to an effective Cartier divisor.** On a locally Noetherian scheme, a
closed subscheme whose stalks are generated by nonzerodivisors is the closed subscheme of an
effective Cartier divisor. -/
theorem isEffectiveCartierSubscheme_of_hasPrincipalStalks [IsLocallyNoetherian X]
    {Z : X.IdealSheafData} (h : HasPrincipalStalks Z) :
    MMP.Intersection.IsEffectiveCartierSubscheme Z := by
  have hU : ∀ x, ∃ U : X.affineOpens, x ∈ (U : Set X) ∧ (Z.ideal U).IsPrincipal := fun x => by
    obtain ⟨g, -, hg⟩ := h x
    exact Stacks.Divisors.exists_affineOpens_isPrincipal_of_stalk_isPrincipal Z x ⟨⟨g, hg⟩⟩
  choose U hxU hprin using hU
  set s := fun x => Submodule.IsPrincipal.generator (Z.ideal (U x)) with hs_def
  have hs : ∀ x, Z.ideal (U x) = Ideal.span {s x} := fun x =>
    (Ideal.span_singleton_generator _).symm
  have hst : ∀ x y (hy : y ∈ (U x : X.Opens)),
      IdealSheafData.stalk Z y = Ideal.span {(X.presheaf.germ (U x) y hy).hom (s x)} := by
    intro x y hy
    rw [IdealSheafData.stalk_eq_map_germ Z y (U x) hy, hs x, Ideal.map_span, Set.image_singleton]
  have hnzd : ∀ x y (hy : y ∈ (U x : X.Opens)),
      (X.presheaf.germ (U x) y hy).hom (s x) ∈ nonZeroDivisors (X.presheaf.stalk y) := by
    intro x y hy
    obtain ⟨g, hg, hgy⟩ := h y
    exact mem_nonZeroDivisors_of_mem_span_singleton hg
      (((hst x y hy).symm.trans hgy).symm ▸ Ideal.mem_span_singleton_self g)
  have hu : ∀ x, IsUnit (MMP.Intersection.toTotalQuotient (U x : X.Opens) (s x)) := fun x =>
    isUnit_toTotalQuotientSheaf_app X.sheaf (U x : X.Opens) (s x) (fun y hy => hnzd x y hy)
  have hUtop : iSup (fun x => (U x : X.Opens)) = ⊤ :=
    eq_top_iff.2 fun x _ => TopologicalSpace.Opens.mem_iSup.2 ⟨x, hxU x⟩
  obtain ⟨D, hD⟩ := MMP.Intersection.exists_isLocalEquationOn_of_germ_eq_mul
    (fun x => (U x : X.Opens)) hUtop (fun x => (hu x).unit) (by
      intro i j p hi hj
      obtain ⟨w, hw⟩ := exists_unit_mul_eq_of_span_eq ((hst i p hi).symm.trans (hst j p hj))
        (hnzd i p hi)
      refine ⟨w, ?_⟩
      simp only [IsUnit.unit_spec]
      rw [MMP.Intersection.germ_toTotalQuotient, MMP.Intersection.germ_toTotalQuotient, ← hw,
        map_mul])
  exact ⟨D, fun x => ⟨U x, (U x).2, hxU x, s x, hu x, hD x⟩,
    fun x => ⟨U x, hxU x, s x, hu x, hD x, hs x⟩⟩

end Stalks

section StalkMaps

/-- The ring map `𝒪_{Y,y} → 𝒪_{X,x}` of `f : X → Y` at `x`, for `f x = y`. -/
noncomputable def stalkHom {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) {y : Y} (h : f x = y) :
    Y.presheaf.stalk y →+* X.presheaf.stalk x :=
  ((Y.presheaf.stalkCongr (Inseparable.of_eq h)).inv ≫ f.stalkMap x).hom

/-- The stalk maps of a composite compose. -/
theorem stalkHom_comp {X Y Z : Scheme.{u}} (g : X ⟶ Y) (h : Y ⟶ Z) (x : X) {y : Y}
    {z : Z} (hg : g x = y) (hh : h y = z) (hgh : (g ≫ h) x = z) (a : Z.presheaf.stalk z) :
    stalkHom (g ≫ h) x hgh a = stalkHom g x hg (stalkHom h y hh a) := by
  subst hg hh
  simp [stalkHom, Scheme.Hom.stalkMap_comp, TopCat.Presheaf.stalkCongr]

/-- Moving a germ along an equality `x = y` of points. -/
theorem stalkCongr_inv_germ {X : Scheme.{u}} {x y : X} (h : x = y) (U : X.Opens)
    (hy : y ∈ U) (s : Γ(X, U)) :
    (X.presheaf.stalkCongr (Inseparable.of_eq h)).inv.hom ((X.presheaf.germ U y hy).hom s) =
      (X.presheaf.germ U x (h ▸ hy)).hom s := by
  subst h; simp

/-- The germ of a section `f^♯ r` pulled back along `f` is the image of the germ of `r`. -/
theorem germ_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {W : X.Opens}
    (e : W ≤ f ⁻¹ᵁ U) {z : X} (hz : z ∈ W) (r : Γ(Y, U)) :
    (X.presheaf.germ W z hz).hom ((f.appLE U W e).hom r) =
      f.stalkMap z ((Y.presheaf.germ U (f z) (e hz)).hom r) := by
  rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
  exact (Scheme.Hom.germ_stalkMap_apply f U z (e hz) r).symm

/-- A point of the support of an ideal sheaf has multiplicity at least one. -/
theorem one_le_multAt_of_mem_support {X : Scheme.{u}} {I : X.IdealSheafData} {x : X}
    (hx : x ∈ I.support) : 1 ≤ multAt I x := by
  have h : ((1 : ℕ) : ℕ∞) ≤ multAt I x := by
    rw [multAt, natCast_le_idealOrder_iff', pow_one]
    exact le_maximalIdeal fun ht => (IdealSheafData.stalk_eq_top_iff_notMem_support I x).1 ht hx
  simpa using h

/-- A point of a finite intersection `V(I) ∩ V(J)`, as an element of the finset. -/
theorem mem_toFinset_support_sup_iff {X : Scheme.{u}} {I J : X.IdealSheafData}
    (hfin : (I ⊔ J).support.carrier.Finite) {x : X} :
    x ∈ hfin.toFinset ↔ x ∈ I.support ∧ x ∈ J.support := by
  rw [Set.Finite.mem_toFinset]
  change x ∈ ((I ⊔ J).support : Set X) ↔ _
  rw [Scheme.IdealSheafData.support_sup]
  rfl

/-- A scheme isomorphic to a Noetherian scheme is Noetherian. -/
theorem isNoetherian_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) [h : IsNoetherian Y] :
    IsNoetherian X := by
  have : IsLocallyNoetherian Y := h.toIsLocallyNoetherian
  have := isLocallyNoetherian_of_isOpenImmersion e.hom
  have : CompactSpace X := (Scheme.homeoOfIso e).symm.compactSpace
  exact ⟨⟩

end StalkMaps

section OffExceptional

open Limits

variable {X : Scheme.{u}}

/-- A point of the blow-up of `p` lies on the exceptional curve iff it lies over `p`. -/
theorem mem_support_exceptionalIdeal_iff (p : X) (hp : IsClosed ({p} : Set X))
    (z : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) :
    z ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support ↔
      blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) z = p := by
  rw [← SetLike.mem_coe, exceptionalIdeal, Scheme.IdealSheafData.support_comap]
  change blowUpToBase _ z ∈
    ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).support : Set X) ↔ _
  rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
  rfl

/-- Kernels commute with base change along an open immersion. -/
theorem ker_comap_of_isPullback {T T' B B' : Scheme.{u}} {g : T ⟶ B} {g' : T' ⟶ B'}
    {r : T' ⟶ T} {h : B' ⟶ B} [IsOpenImmersion h] [QuasiCompact g]
    (H : IsPullback g' r h g) : g.ker.comap h = g'.ker := by
  ext W
  rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
    Scheme.ker_ideal_of_isPullback_of_isOpenImmersion g g' r h H]

/-- Kernels of the restriction to an open commute with base change along an open immersion. -/
theorem ker_restrict_comap_of_isPullback {P P' B B' : Scheme.{u}} {q : P ⟶ B}
    {q' : P' ⟶ B'} {r : P' ⟶ P} {h : B' ⟶ B} [IsOpenImmersion h] (U : B.Opens)
    [QuasiCompact ((q ⁻¹ᵁ U).ι ≫ q)] (H : IsPullback q' r h q) :
    ((q ⁻¹ᵁ U).ι ≫ q).ker.comap h = ((q' ⁻¹ᵁ (h ⁻¹ᵁ U)).ι ≫ q').ker := by
  rw [ker_comap_of_isPullback ((isPullback_morphismRestrict r (q ⁻¹ᵁ U)).flip.paste_horiz H)]
  have hU : r ⁻¹ᵁ (q ⁻¹ᵁ U) = q' ⁻¹ᵁ (h ⁻¹ᵁ U) := by
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, H.w]
  rw [hU]

/-- The kernel of the base change of `C.subschemeι` along `σ` is `C.comap σ`. -/
theorem ker_pullback_snd_subschemeι {B : Scheme.{u}} (C : X.IdealSheafData)
    (σ : B ⟶ X) : (pullback.snd C.subschemeι σ).ker = C.comap σ := by
  rw [← pullbackSymmetry_hom_comp_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, Scheme.IdealSheafData.ker_subschemeι]

/-- A closed immersion into a locally Noetherian scheme stays quasi-compact on restriction. -/
theorem quasiCompact_restrict_comp {P B : Scheme.{u}} [IsLocallyNoetherian B]
    (q : P ⟶ B) [IsClosedImmersion q] (U : B.Opens) : QuasiCompact ((q ⁻¹ᵁ U).ι ≫ q) := by
  have : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian q
  infer_instance

/-- The inclusion of the top open subscheme is an isomorphism. -/
theorem isIso_top_ι (P : Scheme.{u}) : IsIso (⊤ : P.Opens).ι :=
  ⟨⟨P.topIso.inv, P.ι_toIso_inv, P.toIso_inv_ι⟩⟩

/-- The complement of `V(f⁻¹ J)` is the preimage of the complement of `V(J)`. -/
theorem compl_support_comap {Y : Scheme.{u}} (J : Y.IdealSheafData) (f : X ⟶ Y) :
    (J.comap f).support.compl = f ⁻¹ᵁ J.support.compl := by
  ext z
  change z ∉ ((J.comap f).support : Set X) ↔ f z ∉ (J.support : Set Y)
  rw [Scheme.IdealSheafData.support_comap]
  rfl

/-- Off the exceptional curve, the blow-up `B_I X → X` is an open immersion. -/
theorem isOpenImmersion_compl_exceptional (I : X.IdealSheafData) :
    IsOpenImmersion (Scheme.Opens.ι (X := blowUp I) (exceptionalIdeal I).support.compl ≫
      blowUpToBase I) := by
  have hO : ((exceptionalIdeal I).support.compl : (blowUp I).Opens) =
      blowUpToBase I ⁻¹ᵁ (I.support.compl : X.Opens) :=
    compl_support_comap I (blowUpToBase I)
  have hiso := isIso_blowUp_restrict_compl_support I
  rw [hO, ← morphismRestrict_ι]
  infer_instance

/-- Away from the exceptional curve, the birational transform is the inverse image of the
curve. -/
theorem comap_birationalTransform_compl [IsNoetherian X] (p : X)
    (hp : IsClosed ({p} : Set X)) (C : X.IdealSheafData) :
    (birationalTransform p hp C).comap
        (Scheme.Opens.ι (X := blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
          (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support.compl) =
      C.comap (Scheme.Opens.ι (X := blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
        (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support.compl ≫
          blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) := by
  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{p}, hp⟩ : TopologicalSpace.Closeds X)
  have : IsLocallyNoetherian (blowUp I) :=
    (Stacks.ResolutionOfSurfaces.isNoetherian_blowUp I).toIsLocallyNoetherian
  let O : (blowUp I).Opens := (exceptionalIdeal I).support.compl
  have : QuasiCompact ((pullback.snd C.subschemeι (blowUpToBase I) ⁻¹ᵁ O).ι ≫
      pullback.snd C.subschemeι (blowUpToBase I)) := quasiCompact_restrict_comp _ _
  rw [birationalTransform, ker_restrict_comap_of_isPullback O
      (IsPullback.of_hasPullback O.ι (pullback.snd C.subschemeι (blowUpToBase I))),
    Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
  have := isIso_top_ι (pullback O.ι (pullback.snd C.subschemeι (blowUpToBase I)))
  rw [Scheme.Hom.ker_comp_of_isIso, Scheme.IdealSheafData.ker_fst_of_isClosedImmersion,
    ker_pullback_snd_subschemeι, ← Scheme.IdealSheafData.comap_comp]

/-- Away from the exceptional curve, principal stalks of `C` give principal stalks of the
birational transform. -/
theorem exists_span_eq_stalk_birationalTransform_of_notMem [IsNoetherian X] (p : X)
    (hp : IsClosed ({p} : Set X)) {C : X.IdealSheafData} (hC : HasPrincipalStalks C)
    (z : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hz : z ∉ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    ∃ g ∈ nonZeroDivisors _,
      IdealSheafData.stalk (birationalTransform p hp C) z = Ideal.span {g} := by
  revert z hz
  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{p}, hp⟩ : TopologicalSpace.Closeds X)
  intro z hz
  let O : (blowUp I).Opens := (exceptionalIdeal I).support.compl
  have := isOpenImmersion_compl_exceptional I
  have hzO : z ∈ O := by
    rw [← SetLike.mem_coe, TopologicalSpace.Closeds.coe_compl]
    exact hz
  obtain ⟨z', rfl⟩ : z ∈ Set.range O.ι := by rw [Scheme.Opens.range_ι]; exact hzO
  obtain ⟨g, hg, hgen⟩ := (hC.comap (O.ι ≫ blowUpToBase I)) z'
  rw [← comap_birationalTransform_compl, stalk_comap_eq_map_stalkEquiv] at hgen
  exact exists_span_eq_of_map_ringEquiv _ hg hgen

end OffExceptional

section Charts

/-- The first coordinate of a coordinate neighbourhood of a point of dimension `2` is nonzero. -/
theorem CoordinateNeighbourhood.x_ne_zero {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p) :
    c.x ≠ 0 := by
  intro h0
  let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
  have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
  have : IsNoetherianRing Γ(S, c.U) :=
    (IsNoetherian.toIsLocallyNoetherian (X := S)).component_noetherian ⟨c.U, c.isAffineOpen⟩
  have h1 := IsLocalization.AtPrime.ringKrullDim_eq_height
    (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal (S.presheaf.stalk p)
  have hspan : (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal = Ideal.span {c.y} := by
    rw [← c.span_eq, h0, Ideal.span_insert, Ideal.span_singleton_eq_bot.mpr rfl, bot_sup_eq]
  have hnu : ¬ IsUnit c.y := fun hu => (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).isPrime.ne_top
    (hspan ▸ Ideal.span_singleton_eq_top.mpr hu)
  have h2 := Ideal.height_span_singleton_le_one hnu
  rw [← hspan] at h2
  have : ringKrullDim (S.presheaf.stalk p) ≤ 1 := by
    rw [h1]; exact_mod_cast h2
  rw [hdim] at this
  norm_num at this

/-- Exchanging the coordinates of a coordinate neighbourhood. -/
def swapCoordinates {S : Scheme.{u}} {p : S}
    (c : CoordinateNeighbourhood S p) : CoordinateNeighbourhood S p where
  U := c.U
  isAffineOpen := c.isAffineOpen
  mem := c.mem
  isDomain := c.isDomain
  x := c.y
  y := c.x
  span_eq := by
    rw [Set.pair_comm]
    exact c.span_eq

/-- The ideal of `ker (Spec B ⟶ Spec A)` on the top affine open. -/
theorem ideal_ker_specMap_top {A B : Type u} [CommRing A] [CommRing B] (g : A →+* B) :
    (Spec.map (CommRingCat.ofHom g)).ker.ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (RingHom.ker g) := by
  rw [Scheme.ker_of_isAffine]
  have h : (Spec.map (CommRingCat.ofHom g)).appTop =
      (Scheme.ΓSpecIso (.of A)).hom ≫ CommRingCat.ofHom g ≫ (Scheme.ΓSpecIso (.of B)).inv := by
    rw [← Category.assoc]
    exact (Iso.eq_comp_inv _).mpr (Scheme.ΓSpecIso_naturality _)
  have hinj : Function.Injective (Scheme.ΓSpecIso (.of B)).inv.hom :=
    (Scheme.ΓSpecIso (.of B)).symm.commRingCatIsoToRingEquiv.injective
  have h2 : RingHom.ker (Spec.map (CommRingCat.ofHom g)).appTop.hom =
      Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (RingHom.ker g) := by
    rw [h]
    change RingHom.ker (((Scheme.ΓSpecIso (.of B)).inv.hom.comp g).comp
      (Scheme.ΓSpecIso (.of A)).hom.hom) = _
    rw [RingHom.comp_assoc, RingHom.ker_comp_of_injective _ hinj, ← RingHom.comap_ker]
    exact Stacks.Blowup.comap_inv_eq_map_hom (Scheme.ΓSpecIso (.of A)).symm _
  rw [← h2]
  exact Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _

/-- The stalk of the closed subscheme `Spec B/(b)` of `Spec B` is generated by `b`. -/
theorem stalk_ker_specMap_mk_span {B : Type u} [CommRing B] (b : B) (w : Spec (.of B)) :
    IdealSheafData.stalk (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b})))).ker
        w = Ideal.span {(((Spec (.of B)).presheaf.germ ⊤ w trivial).hom
          ((Scheme.ΓSpecIso (.of B)).inv.hom b))} := by
  rw [IdealSheafData.stalk_eq_map_germ _ w ⟨⊤, isAffineOpen_top _⟩ trivial,
    ideal_ker_specMap_top, Ideal.mk_ker, Ideal.map_span, Ideal.map_span, Set.image_singleton,
    Set.image_singleton]

/-- In a domain `B`, the germ at any point of `Spec B` of a nonzero element is a
nonzerodivisor. -/
theorem germ_mem_nonZeroDivisors_of_ne_zero {B : Type u} [CommRing B] [IsDomain B]
    {b : B} (hb : b ≠ 0) (w : Spec (.of B)) :
    ((Spec (.of B)).presheaf.germ ⊤ w trivial).hom ((Scheme.ΓSpecIso (.of B)).inv.hom b) ∈
      nonZeroDivisors ((Spec (.of B)).presheaf.stalk w) := by
  have := w.isPrime
  letI : Algebra B ((Spec (.of B)).presheaf.stalk w) := StructureSheaf.stalkAlgebra (R := B) w
  have : IsLocalization.AtPrime ((Spec (.of B)).presheaf.stalk w) w.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk B w
  change algebraMap B _ b ∈ _
  exact IsLocalization.map_nonZeroDivisors_le w.asIdeal.primeCompl _
    ⟨b, mem_nonZeroDivisors_of_ne_zero hb, rfl⟩

/-- Every affine open neighbourhood of a closed regular point of dimension two contains a
coordinate neighbourhood. -/
theorem exists_coordinateNeighbourhood_le {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) {V : S.Opens} (hV : IsAffineOpen V)
    (hpV : p ∈ V) : ∃ c : CoordinateNeighbourhood S p, c.U ≤ V := by
  obtain ⟨n, z, hz⟩ := MMP.Mori.exists_isRegularSystemOfParameters (S.presheaf.stalk p)
  have hn : n = 2 := by
    have h := hz.2.symm.trans hdim
    exact_mod_cast h
  subst hn
  letI : Algebra Γ(S, V) (S.presheaf.stalk p) := (S.presheaf.germ V p hpV).hom.toAlgebra
  have := hV.isLocalization_stalk ⟨p, hpV⟩
  obtain ⟨⟨a, t⟩, ha⟩ := IsLocalization.mk'_surjective
    (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl (z 0)
  obtain ⟨⟨b, t'⟩, hb⟩ := IsLocalization.mk'_surjective
    (hV.primeIdealOf ⟨p, hpV⟩).asIdeal.primeCompl (z 1)
  have ha' : (S.presheaf.germ V p hpV).hom a =
      z 0 * algebraMap Γ(S, V) (S.presheaf.stalk p) t := by
    rw [← ha, IsLocalization.mk'_spec]
    rfl
  have hb' : (S.presheaf.germ V p hpV).hom b =
      z 1 * algebraMap Γ(S, V) (S.presheaf.stalk p) t' := by
    rw [← hb, IsLocalization.mk'_spec]
    rfl
  have hrange : ∀ (w : Fin 2 → S.presheaf.stalk p), Set.range w = {w 0, w 1} := fun w => by
    ext g
    simp [Fin.exists_fin_two, eq_comm]
  have hxy : MMP.Mori.IsRegularSystemOfParameters
      ![(S.presheaf.germ V p hpV).hom a, (S.presheaf.germ V p hpV).hom b] := by
    refine ⟨?_, by rw [hdim]; rfl⟩
    rw [hrange, ← hz.1, hrange]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one]
    rw [ha', hb']
    exact span_pair_mul_units (IsLocalization.map_units _ t) (IsLocalization.map_units _ t')
  obtain ⟨c, hUV, -, -⟩ :=
    MMP.Resolution.CoordinateNeighbourhood.exists_of_isRegularSystemOfParameters hp hreg hdim hpV
      a b hxy
  exact ⟨c, hUV⟩

/-- If `C` is cut out by one section `s` on an affine open neighbourhood of `p`, it is cut out by
one section on a coordinate neighbourhood of `p`, whose germ computes the multiplicity of `C`. -/
theorem exists_coordinateNeighbourhood_of_ideal_eq_span {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (C : S.IdealSheafData) {V : S.affineOpens}
    (hpV : p ∈ V.1) {s : Γ(S, V.1)} (hZ : C.ideal V = Ideal.span {s}) :
    ∃ (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U)),
      C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f} ∧
        multAt C p = mult ((S.presheaf.germ c.U p c.mem).hom f) := by
  obtain ⟨c, hUV⟩ := exists_coordinateNeighbourhood_le hp hreg hdim V.2 hpV
  have hUV' : (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) ≤ V := hUV
  have hCf : C.ideal ⟨c.U, c.isAffineOpen⟩ =
      Ideal.span {(S.presheaf.map (homOfLE hUV').op).hom s} := by
    rw [← C.map_ideal hUV', hZ, Ideal.map_span, Set.image_singleton]
  refine ⟨c, _, hCf, ?_⟩
  rw [multAt, IdealSheafData.stalk_eq_map_germ C p ⟨c.U, c.isAffineOpen⟩ c.mem, hCf,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- **A coordinate neighbourhood on which a curve `C` with principal stalks is principal**, with
the multiplicity of `C` at `p` read off the germ of the generator. -/
theorem exists_coordinateNeighbourhood {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : HasPrincipalStalks C) :
    ∃ (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U)),
      C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f} ∧
        multAt C p = mult ((S.presheaf.germ c.U p c.mem).hom f) := by
  have : IsLocallyNoetherian S := IsNoetherian.toIsLocallyNoetherian
  obtain ⟨V, hpV, hprin⟩ : ∃ V : S.affineOpens, p ∈ (V : Set S) ∧ (C.ideal V).IsPrincipal := by
    obtain ⟨g, -, hg⟩ := hC p
    exact Stacks.Divisors.exists_affineOpens_isPrincipal_of_stalk_isPrincipal C p ⟨⟨g, hg⟩⟩
  exact exists_coordinateNeighbourhood_of_ideal_eq_span hp hreg hdim C hpV
    (Ideal.span_singleton_generator _).symm

/-- **A coordinate neighbourhood on which an effective Cartier subscheme `C` is principal**, with
the multiplicity of `C` at `p` read off the germ of the generator. -/
theorem exists_coordinateNeighbourhood_of_isEffectiveCartierSubscheme {S : Scheme.{u}}
    [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (hC : MMP.Intersection.IsEffectiveCartierSubscheme C) :
    ∃ (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U)),
      C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f} ∧
        multAt C p = mult ((S.presheaf.germ c.U p c.mem).hom f) := by
  obtain ⟨D, -, hsub⟩ := hC
  obtain ⟨V, hpV, s, -, -, hZ⟩ := hsub p
  exact exists_coordinateNeighbourhood_of_ideal_eq_span hp hreg hdim C hpV hZ

/-- The only point of `Spec Γ(S, U)` lying over `p` is `primeIdealOf p`. -/
theorem preimage_fromSpec_singleton {S : Scheme.{u}} {p : S}
    (c : CoordinateNeighbourhood S p) :
    c.isAffineOpen.fromSpec ⁻¹' ({p} : Set S) = {c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩} := by
  ext q
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  refine ⟨fun hq => c.isAffineOpen.fromSpec.isOpenEmbedding.injective ?_, ?_⟩
  · rw [hq, c.isAffineOpen.fromSpec_primeIdealOf]
  · rintro rfl
    exact c.isAffineOpen.fromSpec_primeIdealOf _

/-- On a coordinate neighbourhood, the ideal of the reduced point is `(x, y)`. -/
theorem ideal_vanishingIdeal_eq_span {S : Scheme.{u}} {p : S}
    (hp : IsClosed ({p} : Set S)) (c : CoordinateNeighbourhood S p) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ =
      Ideal.span {c.x, c.y} := by
  rw [Scheme.IdealSheafData.vanishingIdeal_ideal, c.span_eq]
  convert PrimeSpectrum.vanishingIdeal_singleton (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩)
    using 2
  exact preimage_fromSpec_singleton c

/-- **The exceptional curve lies in the two charts of a coordinate neighbourhood.** -/
theorem mem_or_mem_of_mem_support {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    (c : CoordinateNeighbourhood S p)
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (hy : c.y ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (z : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hz : z ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    z ∈ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩
        ⟨c.x, hx⟩).1 ∨
      z ∈ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
        ⟨c.U, c.isAffineOpen⟩ ⟨c.y, hy⟩).1 := by
  have hzp := (mem_support_exceptionalIdeal_iff p hp z).mp hz
  have hspan : ((Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩ :
      Ideal Γ(S, c.U)) ≤ Ideal.span (Set.range ![c.x, c.y]) := by
    rw [ideal_vanishingIdeal_eq_span hp c]
    exact Ideal.span_mono (by
      rintro w (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩)
  obtain ⟨j, w, hw⟩ := exists_mem_range_blowupChartι
    (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⟨c.U, c.isAffineOpen⟩ ![c.x, c.y]
    (fun j => by fin_cases j; exacts [hx, hy]) hspan z (by rw [hzp]; exact c.mem)
  fin_cases j
  · exact Or.inl ⟨w, trivial, hw⟩
  · exact Or.inr ⟨w, trivial, hw⟩

/-- On an open `Spec B ⟶ Y` of a scheme, `B` a domain, an ideal sheaf cut out by `b ≠ 0` has
stalks generated by nonzerodivisors. -/
private theorem exists_span_eq_stalk_of_comap_eq_ker {Y : Scheme.{u}} {B : Type u} [CommRing B]
    [IsDomain B] (Φ : Spec (.of B) ⟶ Y) [IsOpenImmersion Φ] (Z : Y.IdealSheafData) {b : B}
    (hb : b ≠ 0)
    (hZ : Z.comap Φ = (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b})))).ker)
    (w : Spec (.of B)) :
    ∃ g ∈ nonZeroDivisors _, IdealSheafData.stalk Z (Φ w) = Ideal.span {g} := by
  have h := stalk_comap_eq_map_stalkEquiv Φ Z w
  rw [hZ, stalk_ker_specMap_mk_span] at h
  exact exists_span_eq_of_map_ringEquiv _ (germ_mem_nonZeroDivisors_of_ne_zero hb w) h.symm

/-- **The birational transform on the chart `D₊(xt)`.** If `C` is cut out by `f` on a
coordinate neighbourhood `(U, x, y)` of `p`, with `mult_p f` finite, the stalks of the
birational transform at the points of the chart `D₊(xt) ≅ Spec R[y/x]` are generated by
nonzerodivisors: on the chart it is cut out by `f¹ ≠ 0` in the domain `R[y/x]`. -/
theorem exists_span_eq_stalk_birationalTransform_of_mem_chart {S : Scheme.{u}}
    [IsNoetherian S] {p : S} (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2)
    (C : S.IdealSheafData) (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U))
    (hCf : C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f}) (m : ℕ)
    (hm : mult ((S.presheaf.germ c.U p c.mem).hom f) = m)
    (hx : c.x ∈ (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩).ideal ⟨c.U, c.isAffineOpen⟩)
    (z : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hzW : z ∈ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)
      ⟨c.U, c.isAffineOpen⟩ ⟨c.x, hx⟩).1) :
    ∃ g ∈ nonZeroDivisors _,
      IdealSheafData.stalk (birationalTransform p hp C) z = Ideal.span {g} := by
  have := c.isDomain
  letI : Field (FractionRing Γ(S, c.U)) := FractionRing.field (A := Γ(S, c.U))
  have hmax : maximalIdeal (S.presheaf.stalk p) =
      Ideal.span {(S.presheaf.germ c.U p c.mem).hom c.x,
        (S.presheaf.germ c.U p c.mem).hom c.y} := by
    let := TopCat.Presheaf.algebra_section_stalk S.presheaf (⟨p, c.mem⟩ : c.U)
    have := c.isAffineOpen.isLocalization_stalk ⟨p, c.mem⟩
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal
      (c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩).asIdeal, ← c.span_eq, Ideal.map_span,
      Set.image_pair]
    rfl
  obtain ⟨⟨F, hF, -⟩, -⟩ := MMP.Resolution.Kollar.existsUnique_isLeadingTerm hdim hmax
    (f := (S.presheaf.germ c.U p c.mem).hom f) (by rw [hm]; exact ENat.natCast_ne_top m)
  obtain ⟨hx', e, he⟩ := CoordinateNeighbourhood.exists_iso_spec_adjoin_div hp hreg hdim c
  obtain rfl : hx = hx' := rfl
  obtain ⟨f₁, hf₁, -⟩ := CoordinateNeighbourhood.exists_eq_pow_mul_and_mk_eq hp hreg hdim c f m
    hm F hF
  have h₁ := CoordinateNeighbourhood.comap_birationalTransform_eq_ker hp hreg hdim c f m hm C hCf
    hx e he f₁ hf₁
  -- `f₁ ≠ 0`
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [map_zero, mult, Ideal.span_singleton_eq_bot.mpr rfl, idealOrder_bot] at hm
    exact ENat.top_ne_natCast m hm
  have hf₁0 : f₁ ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hf₁
    apply hf0
    have h : algebraMap Γ(S, c.U) (FractionRing Γ(S, c.U)) f = 0 :=
      congrArg Subtype.val hf₁
    exact IsFractionRing.injective Γ(S, c.U) (FractionRing Γ(S, c.U))
      (h.trans (map_zero _).symm)
  obtain ⟨w, rfl⟩ : ∃ w, (e.inv ≫ (blowUpChartOpen (Scheme.IdealSheafData.vanishingIdeal
      ⟨({p} : Set S), hp⟩) (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) ⟨c.x, hx⟩).1.ι) w = z :=
    ⟨e.hom ⟨z, hzW⟩, by
      rw [Scheme.Hom.comp_apply]
      erw [Scheme.hom_inv_apply]
      rfl⟩
  have : IsDomain (FractionRing Γ(S, c.U)) :=
    IsFractionRing.isDomain (A := Γ(S, c.U)) (K := FractionRing Γ(S, c.U))
  have : IsDomain (Algebra.adjoin Γ(S, c.U) {z : FractionRing Γ(S, c.U) |
      algebraMap Γ(S, c.U) _ c.x * z = algebraMap Γ(S, c.U) _ c.y}) := Subalgebra.isDomain _
  exact exists_span_eq_stalk_of_comap_eq_ker _ _ hf₁0 h₁ w

/-- **The birational transform of a curve with principal stalks has principal stalks.** -/
theorem hasPrincipalStalks_birationalTransform {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) {C : S.IdealSheafData}
    (hC : HasPrincipalStalks C) (hm : multAt C p ≠ ⊤) :
    HasPrincipalStalks (birationalTransform p hp C) := by
  intro z
  by_cases hz : z ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support
  · obtain ⟨c, f, hCf, hmult⟩ := exists_coordinateNeighbourhood hp hreg hdim C hC
    obtain ⟨m, hm'⟩ := ENat.ne_top_iff_exists.mp (hmult ▸ hm)
    obtain ⟨hx, -⟩ := CoordinateNeighbourhood.exists_iso_spec_adjoin_div hp hreg hdim c
    obtain ⟨hy, -⟩ :=
      CoordinateNeighbourhood.exists_iso_spec_adjoin_div hp hreg hdim (swapCoordinates c)
    rcases mem_or_mem_of_mem_support hp c hx hy z hz with hW | hW
    · exact exists_span_eq_stalk_birationalTransform_of_mem_chart hp hreg hdim C c f hCf m
        hm'.symm hx z hW
    · exact exists_span_eq_stalk_birationalTransform_of_mem_chart hp hreg hdim C
        (swapCoordinates c) f hCf m hm'.symm hy z hW
  · exact exists_span_eq_stalk_birationalTransform_of_notMem p hp hC z hz

/-- A point of `Spec B` containing `x` and `y`, for `B` an algebra over a coordinate
neighbourhood `(U, x, y)` of the closed point `p`, maps to `p`. -/
theorem fromSpec_specMap_apply_eq {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    (c : CoordinateNeighbourhood S p) {B : Type u} [CommRing B] [Algebra Γ(S, c.U) B]
    (w : Spec (.of B)) (hx : algebraMap Γ(S, c.U) B c.x ∈ w.asIdeal)
    (hy : algebraMap Γ(S, c.U) B c.y ∈ w.asIdeal) :
    c.isAffineOpen.fromSpec (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) B)) w) = p := by
  have := w.isPrime
  have h : Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) B)) w =
      c.isAffineOpen.primeIdealOf ⟨p, c.mem⟩ := by
    apply PrimeSpectrum.ext
    rw [Spec.map_apply]
    refine ((c.isAffineOpen.primeIdealOf_isMaximal_of_isClosed ⟨p, c.mem⟩ hp).eq_of_le
      (Ideal.comap_ne_top _ this.ne_top) ?_).symm
    rw [← c.span_eq, Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact hx
    · exact hy
  rw [h, c.isAffineOpen.fromSpec_primeIdealOf]

/-- On an open `Spec B ⟶ Y`, the stalk of an ideal sheaf cut out by `b` is generated by the
germ of `b`. -/
theorem stalk_eq_span_of_comap_eq_ker {Y : Scheme.{u}} {B : Type u} [CommRing B]
    (Φ : Spec (.of B) ⟶ Y) [IsOpenImmersion Φ] (Z : Y.IdealSheafData) (b : B)
    (hZ : Z.comap Φ = (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b})))).ker)
    (w : Spec (.of B)) :
    IdealSheafData.stalk Z (Φ w) = Ideal.span {((stalkEquiv Φ w).symm
      (((Spec (.of B)).presheaf.germ ⊤ w trivial).hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)))} := by
  have h := stalk_comap_eq_map_stalkEquiv Φ Z w
  rw [hZ, stalk_ker_specMap_mk_span] at h
  have e : ((IdealSheafData.stalk Z (Φ w)).map (stalkEquiv Φ w)).map (stalkEquiv Φ w).symm =
      IdealSheafData.stalk Z (Φ w) := Ideal.map_of_equiv (stalkEquiv Φ w)
  rw [← e, ← h, Ideal.map_span, Set.image_singleton]

open Polynomial in
/-- **The point `(x, y/x)` of a chart.** Let `j : Spec B → B_pS` be an open immersion over `S`
through `Spec(R → B)`, where `(U = Spec R, x, y)` is a coordinate neighbourhood of `p`, `B` is a
domain generated over `R` by `z` with `x z = y`, `x ≠ 0` in `B`, and `B / x ≅ κ(p)[Y]` with
`Y ↦ z`. Then the point `w = (x, z)` of `Spec B` maps to a closed point `j w` over `p`; the local
ring `𝒪_{j w}` receives `B` injectively, `(x, z)` is a regular system of parameters of it, every
element of it is a fraction `F(z)/G(z)` over `𝒪_{S,p}`, and an ideal sheaf cut out on `Spec B` by
`b` has stalk `(b)` at `j w`. -/
theorem exists_point_of_isOpenImmersion {S : Scheme.{u}} [IsNoetherian S] {p : S}
    (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (c : CoordinateNeighbourhood S p)
    {B : Type u} [CommRing B] [IsDomain B] [Algebra Γ(S, c.U) B]
    (j : Spec (.of B) ⟶ blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    [IsOpenImmersion j]
    (hjπ : j ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) B)) ≫ c.isAffineOpen.fromSpec)
    (z : B) (hz : algebraMap Γ(S, c.U) B c.x * z = algebraMap Γ(S, c.U) B c.y)
    (hgen : ∀ b : B, ∃ F : Γ(S, c.U)[X], Polynomial.aeval z F = b)
    (φ : (S.residueField p)[X] ≃+* B ⧸ Ideal.span {algebraMap Γ(S, c.U) B c.x})
    (hφX : φ Polynomial.X = Ideal.Quotient.mk _ z) (hx0 : algebraMap Γ(S, c.U) B c.x ≠ 0) :
    ∃ (q : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
      (hπ : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) q = p)
      (lam : B →+* (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q),
      IsClosed ({q} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) ∧
      Function.Injective lam ∧
      (∀ r, lam (algebraMap Γ(S, c.U) B r) =
        stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) q hπ
          ((S.presheaf.germ c.U p c.mem).hom r)) ∧
      MMP.Mori.IsRegularSystemOfParameters ![lam (algebraMap Γ(S, c.U) B c.x), lam z] ∧
      IsPolynomialFraction
        (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) q hπ)
        (lam z) ∧
      IsRegularLocalRing
        ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk q) ∧
      ∀ (Z : (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).IdealSheafData) (b : B),
        Z.comap j = (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {b})))).ker →
        IdealSheafData.stalk Z q = Ideal.span {lam b} := by
  have hmaxQ := isMaximal_span_pair φ hφX
  let w : Spec (.of B) := ⟨Ideal.span {algebraMap Γ(S, c.U) B c.x, z}, hmaxQ.isPrime⟩
  have hwQ : w.asIdeal = Ideal.span {algebraMap Γ(S, c.U) B c.x, z} := rfl
  have hxQ : algebraMap Γ(S, c.U) B c.x ∈ w.asIdeal := Ideal.subset_span (Set.mem_insert _ _)
  letI : Algebra B ((Spec (.of B)).presheaf.stalk w) := StructureSheaf.stalkAlgebra (R := B) w
  have : IsLocalization.AtPrime ((Spec (.of B)).presheaf.stalk w) w.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk B w
  have hle : ⊤ ≤ (j ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal
      ⟨({p} : Set S), hp⟩)) ⁻¹ᵁ c.U := by
    intro w' _
    change (j ≫ _) w' ∈ c.U
    rw [hjπ, Scheme.Hom.comp_apply]
    exact c.isAffineOpen.range_fromSpec.subset ⟨_, rfl⟩
  have hπ : blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) (j w) = p := by
    have h1 : (j ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) w =
        c.isAffineOpen.fromSpec (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, c.U) B)) w) := by
      rw [hjπ, Scheme.Hom.comp_apply]
    rw [Scheme.Hom.comp_apply] at h1
    rw [h1]
    refine fromSpec_specMap_apply_eq hp c w hxQ ?_
    rw [← hz]
    exact Ideal.mul_mem_right _ _ hxQ
  have happLE := Stacks.Blowup.appLE_top_of_eq_specMap_fromSpec
    (⟨c.U, c.isAffineOpen⟩ : S.affineOpens) (CommRingCat.ofHom (algebraMap Γ(S, c.U) B)) hjπ hle
  have hcompat : ∀ r : Γ(S, c.U), (j.stalkMap w).hom
      (stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) (j w) hπ
        ((S.presheaf.germ c.U p c.mem).hom r)) =
      algebraMap B _ (algebraMap Γ(S, c.U) B r) := by
    intro r
    rw [stalkHom, CommRingCat.comp_apply, stalkCongr_inv_germ hπ c.U c.mem r]
    have h1 := germ_appLE (j ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal
      ⟨({p} : Set S), hp⟩)) hle (trivial : w ∈ ⊤) r
    rw [happLE, Scheme.Hom.stalkMap_comp, CommRingCat.comp_apply] at h1
    exact h1.symm
  let σ := stalkEquiv j w
  have hσ : ∀ a, σ a = (j.stalkMap w).hom a := fun _ => rfl
  let lam : B →+* _ := σ.symm.toRingHom.comp (algebraMap B ((Spec (.of B)).presheaf.stalk w))
  have hσlam : ∀ b, σ (lam b) = algebraMap B _ b := fun b => σ.apply_symm_apply _
  have hlam : ∀ r, lam (algebraMap Γ(S, c.U) B r) =
      stalkHom (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)) (j w) hπ
        ((S.presheaf.germ c.U p c.mem).hom r) := by
    intro r
    apply σ.injective
    rw [hσlam, hσ, hcompat]
  have hinj : Function.Injective lam :=
    σ.symm.injective.comp (IsLocalization.injective _
      (Ideal.primeCompl_le_nonZeroDivisors w.asIdeal))
  have hmax : Ideal.span {lam (algebraMap Γ(S, c.U) B c.x), lam z} =
      maximalIdeal ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk
        (j w)) := by
    rw [← IsLocalRing.map_maximalIdeal_of_surjective σ.symm.toRingHom σ.symm.surjective,
      ← IsLocalization.AtPrime.map_eq_maximalIdeal w.asIdeal ((Spec (.of B)).presheaf.stalk w), hwQ,
      Ideal.map_span, Ideal.map_span, Set.image_pair, Set.image_pair]
    rfl
  have hdimw : 2 ≤ ringKrullDim
      ((blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).presheaf.stalk (j w)) := by
    rw [ringKrullDim_eq_of_ringEquiv σ,
      IsLocalization.AtPrime.ringKrullDim_eq_height w.asIdeal]
    exact WithBot.coe_le_coe.mpr (two_le_height_span_pair φ hφX hx0)
  have hE : j w ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support :=
    (mem_support_exceptionalIdeal_iff p hp (j w)).mpr hπ
  obtain ⟨hreg₁, hcl₁, hncl₁⟩ :=
    isRegularLocalRing_stalk_blowUp_of_mem_support_exceptionalIdeal p hp hreg hdim (j w) hE
  have hcl : IsClosed ({j w} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) := by
    by_contra hn
    rw [hncl₁ hn] at hdimw
    norm_num at hdimw
  refine ⟨j w, hπ, lam, hcl, hinj, hlam, ⟨?_, ?_⟩,
    IsPolynomialFraction.of_ringEquiv_localization w.asIdeal (S.presheaf.germ c.U p c.mem).hom _
      lam σ hσlam (RingHom.ext fun r => (hlam r).symm) z hgen, hreg₁,
    fun Z b hZb => stalk_eq_span_of_comap_eq_ker j Z b hZb w⟩
  · rwa [Matrix.range_cons_cons_empty]
  · rw [hcl₁ hcl]
    rfl

end Charts

section Koenig

variable {S : Scheme.{u}} {p : S}

/-- A coordinate neighbourhood of `p` on which an effective Cartier divisor is cut out by a
single regular element. -/
theorem exists_coordinateNeighbourhood_isRegular [IsNoetherian S] (hp : IsClosed ({p} : Set S))
    (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) {C : S.IdealSheafData}
    (hC : Stacks.Divisors.IsEffectiveCartierDivisor C) :
    ∃ (c : CoordinateNeighbourhood S p) (f : Γ(S, c.U)),
      C.ideal ⟨c.U, c.isAffineOpen⟩ = Ideal.span {f} ∧ IsRegular f := by
  obtain ⟨V, hV, hpV, s, hs, hZ⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor C hC p
  obtain ⟨c, hUV⟩ := exists_coordinateNeighbourhood_le hp hreg hdim hV hpV
  refine ⟨c, (S.presheaf.map (homOfLE hUV).op).hom s, ?_,
    AlgebraicGeometry.isRegular_res_of_isAffineOpen hV hs hUV⟩
  rw [← C.map_ideal (U := ⟨c.U, c.isAffineOpen⟩) (V := ⟨V, hV⟩) hUV, hZ, Ideal.map_span,
    Set.image_singleton]
  rfl

end Koenig

section Sequence

open PointBlowupSequence

/-- The `(j+1)`-st transform of `C₀` is the birational transform of the `j`-th, read on
`S_{j+1}`. -/
theorem transformedSubscheme_succ {S₀ : Scheme.{u}}
    (s : PointBlowupSequence S₀) (C₀ : S₀.IdealSheafData) (j : ℕ) (hj : (j : ℕ∞) < s.length) :
    s.transformedSubscheme C₀ (j + 1) =
      (birationalTransform (s.p j) (s.isClosed_p j hj) (s.transformedSubscheme C₀ j)).comap
        (s.blowupIso j hj).hom := by
  rw [PointBlowupSequence.transformedSubscheme, dif_pos hj]

/-- The point `p_{j+1}` of a blow-up sequence of multiplicity `m`, read on the blow-up of `p_j`,
lies on the birational transform of `C_j` and on the exceptional curve, with multiplicity `m`. -/
theorem mem_support_blowupIso_p_succ {S₀ : Scheme.{u}}
    {s : PointBlowupSequence S₀} {C₀ : S₀.IdealSheafData} {m : ℕ}
    (hs : s.IsConstantMultiplicity C₀ m) (j : ℕ) (hj : ((j + 1 : ℕ) : ℕ∞) ≤ s.length) :
    (s.blowupIso j (coe_lt_of_succ_le hj)).hom (s.p (j + 1)) ∈ (birationalTransform (s.p j)
        (s.isClosed_p j (coe_lt_of_succ_le hj)) (s.transformedSubscheme C₀ j)).support ∧
      (s.blowupIso j (coe_lt_of_succ_le hj)).hom (s.p (j + 1)) ∈ (exceptionalIdeal
        (Scheme.IdealSheafData.vanishingIdeal
          ⟨{s.p j}, s.isClosed_p j (coe_lt_of_succ_le hj)⟩)).support ∧
      multAt (birationalTransform (s.p j) (s.isClosed_p j (coe_lt_of_succ_le hj))
        (s.transformedSubscheme C₀ j))
          ((s.blowupIso j (coe_lt_of_succ_le hj)).hom (s.p (j + 1))) = m := by
  have hlt : (j : ℕ∞) < s.length := coe_lt_of_succ_le hj
  have hT := transformedSubscheme_succ s C₀ j hlt
  refine ⟨?_, ?_, ?_⟩
  · have := (hs.2 j hlt).2.1.1
    rwa [hT, mem_support_comap_iff] at this
  · rw [mem_support_exceptionalIdeal_iff]
    have := (hs.2 j hlt).1
    rwa [PointBlowupSequence.σ, Scheme.Hom.comp_apply] at this
  · have := hs.1 (j + 1) hj
    rwa [hT, multAt, stalk_comap_eq_map_stalkEquiv,
      MMP.Threefold.Resolution.idealOrder_map_ringEquiv] at this

/-- The points of `C₁ ∩ E` on the blow-up of a closed point are closed: `C₁ ∩ E` is finite over
`κ(p)`. -/
theorem isClosed_of_mem_support_birationalTransform {S : Scheme.{u}} [IsNoetherian S]
    {p : S} (hp : IsClosed ({p} : Set S)) (hreg : IsRegularLocalRing (S.presheaf.stalk p))
    (hdim : ringKrullDim (S.presheaf.stalk p) = 2) (C : S.IdealSheafData)
    (hC : MMP.Intersection.IsEffectiveCartierSubscheme C) (m : ℕ) (hm : multAt C p = m)
    (q : blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
    (hqC : q ∈ (birationalTransform p hp C).support)
    (hqE : q ∈ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) :
    IsClosed ({q} : Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) := by
  revert q
  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{p}, hp⟩ : TopologicalSpace.Closeds S)
  intro q hqC hqE
  obtain ⟨g, -, hgfin, -⟩ :=
    exists_isFinite_finrank_birationalTransform_sup_exceptionalIdeal hp hreg hdim C hC m hm
  have := hgfin
  have hqZ : q ∈ ((birationalTransform p hp C ⊔ exceptionalIdeal I).support : Set _) := by
    rw [Scheme.IdealSheafData.support_sup]; exact ⟨hqC, hqE⟩
  obtain ⟨z, hz⟩ : q ∈ Set.range (birationalTransform p hp C ⊔ exceptionalIdeal I).subschemeι := by
    rw [Scheme.IdealSheafData.range_subschemeι]; exact hqZ
  have hZaff : IsAffine (birationalTransform p hp C ⊔ exceptionalIdeal I).subscheme :=
    isAffine_of_isAffineHom g
  have := AlgebraicGeometry.isArtinianRing_globalSections_of_isFinite_over_field _ g
  have hzc : IsClosed ({z} : Set (birationalTransform p hp C ⊔ exceptionalIdeal I).subscheme) := by
    rw [← (Scheme.homeoOfIso (Scheme.isoSpec _)).isClosed_image, Set.image_singleton]
    exact @isClosed_discrete _ _
      (IsArtinianRing.instDiscreteTopologyPrimeSpectrum _) _
  have := (birationalTransform p hp C ⊔ exceptionalIdeal I).subschemeι.isClosedEmbedding.isClosedMap
    _ hzc
  rwa [Set.image_singleton, hz] at this

end Sequence

