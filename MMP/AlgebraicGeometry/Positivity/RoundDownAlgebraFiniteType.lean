open Stacks.GradedSections in
/-- The degree-`k` sections of the restricted tensor power, read as rational functions on `W`. -/
private noncomputable def sectionValue {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (k : ℕ) :
    powSections (Divisor.restrictSheaf W L) k →+ (rationalFunctionsPresheaf Z).obj (op W) :=
  AddMonoidHom.mk' (fun s => ((rationalFunctionsPresheaf Z).map
      (homOfLE (W.ι_image_top.ge : W ≤ W.ι ''ᵁ ⊤)).op).hom
      (Divisor.powSectionsRestrict W hL s).1)
    fun s t => by rw [Divisor.powSectionsRestrict_add, map_add]

/-- Sections of degree `k` to monomials of degree `mk`, as a ring map from the section ring. -/
private noncomputable def sectionPolyHom {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (m : ℕ) :
    DirectSum ℕ (Stacks.GradedSections.powSections (Divisor.restrictSheaf W L)) →+*
      Polynomial ((rationalFunctionsPresheaf Z).obj (op W)) :=
  DirectSum.toSemiring (fun k => (monomial (m * k)).toAddMonoidHom.comp (sectionValue W hL k))
    (by
      change monomial (m * 0) (((rationalFunctionsPresheaf Z).map
        (homOfLE (W.ι_image_top.ge : W ≤ W.ι ''ᵁ ⊤)).op).hom
        (Divisor.powSectionsRestrict W hL (k := 0) (𝟙 _)).1) = 1
      rw [Divisor.powSectionsRestrict_one, map_one, Nat.mul_zero, monomial_zero_one])
    fun {i j} a b => by
      change monomial (m * (i + j)) (((rationalFunctionsPresheaf Z).map
        (homOfLE (W.ι_image_top.ge : W ≤ W.ι ''ᵁ ⊤)).op).hom
        (Divisor.powSectionsRestrict W hL (Stacks.GradedSections.mul a b)).1) =
        monomial (m * i) (sectionValue W hL i a) * monomial (m * j) (sectionValue W hL j b)
      rw [Divisor.powSectionsRestrict_mul, map_mul, monomial_mul_monomial, mul_add]
      rfl

private theorem sectionPolyHom_of {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (m k : ℕ)
    (s : Stacks.GradedSections.powSections (Divisor.restrictSheaf W L) k) :
    sectionPolyHom W hL m (DirectSum.of _ k s) = monomial (m * k) (sectionValue W hL k s) :=
  DirectSum.toSemiring_of _ _ _ _ _

/-- The value of a section of degree `k` is a section of `𝒪(⌊mkM⌋)` when `L = mM`. -/
private theorem sectionValue_mem {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (M : QDivisor Z) {m : ℕ}
    (hLM : Divisor.toQDivisor L = (m : ℤ) • M) (k : ℕ)
    (s : Stacks.GradedSections.powSections (Divisor.restrictSheaf W L) k) :
    sectionValue W hL k s ∈
      (DivisorWithCoeffs.roundDown (((m * k : ℕ) : ℚ) • M)).divisorialSubmodule W := by
  rw [roundDown_natCast_mul_smul M L hLM k]
  exact (Divisor.powSectionsRestrict W hL s).2.map (homOfLE W.ι_image_top.ge)

/-- The image of `sectionPolyHom` consists of round-down polynomials supported in the multiples
of `m`. -/
private theorem sectionPolyHom_mem {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (M : QDivisor Z) {m : ℕ}
    (hLM : Divisor.toQDivisor L = (m : ℤ) • M)
    (x : DirectSum ℕ (Stacks.GradedSections.powSections (Divisor.restrictSheaf W L))) :
    sectionPolyHom W hL m x ∈ roundDownSubring M W ∧
      ∀ n, ¬ m ∣ n → (sectionPolyHom W hL m x).coeff n = 0 := by
  induction x using DirectSum.induction_on with
  | zero => exact map_zero (sectionPolyHom W hL m) ▸ ⟨Subring.zero_mem _, fun n _ => coeff_zero n⟩
  | of k s =>
    rw [sectionPolyHom_of]
    refine ⟨monomial_mem_roundDownSubring (sectionValue_mem W hL M hLM k s), fun n hn => ?_⟩
    rw [coeff_monomial, if_neg]
    rintro rfl
    exact hn (dvd_mul_right m k)
  | add x y hx hy =>
    rw [map_add]
    exact ⟨Subring.add_mem _ hx.1 hy.1,
      fun n hn => by rw [coeff_add, hx.2 n hn, hy.2 n hn, add_zero]⟩

/-- Every monomial `c t^{mk}` with `c` a section of `𝒪(kL)` is in the image of `sectionPolyHom`. -/
private theorem exists_sectionPolyHom_of_eq_monomial {Z : Scheme.{u}} [IsLocallyNoetherian Z]
    [IsNormal Z] [CompactSpace Z] (W : Z.Opens) {L : Divisor Z} (hL : L.IsCartier) (m k : ℕ)
    {c : (rationalFunctionsPresheaf Z).obj (op W)} (hc : c ∈ (k • L).divisorialSubmodule W) :
    ∃ s, sectionPolyHom W hL m (DirectSum.of _ k s) = monomial (m * k) c := by
  obtain ⟨s, hs⟩ := Divisor.powSectionsRestrict_surjective W hL
    (⟨((rationalFunctionsPresheaf Z).map (homOfLE (W.ι_image_top.le : W.ι ''ᵁ ⊤ ≤ W)).op).hom c,
      hc.map _⟩ : (k • L).divisorialSubmodule (W.ι ''ᵁ ⊤))
  refine ⟨s, ?_⟩
  rw [sectionPolyHom_of]
  congr 1
  change ((rationalFunctionsPresheaf Z).map
    (homOfLE (W.ι_image_top.ge : W ≤ W.ι ''ᵁ ⊤)).op).hom
    (Divisor.powSectionsRestrict W hL s).1 = _
  rw [hs]
  rfl

/-- **The Veronese part is the image of the section ring.** Let `mM = L` with `L` Cartier, and
let `T` generate the section ring `⨁_k Γ(g⁻¹V, (𝒪(L)|_{g⁻¹V})^{⊗ k})` over the constants coming
from `Γ(Y, V)`. Sending a section of degree `k` to the monomial of degree `mk` with its value as
coefficient (`MMP.Mori.Divisor.powSectionsRestrict`, with `⌊mkM⌋ = kL`) is a ring map onto the
round-down polynomials supported in degrees divisible by `m`; the image of `T` generates them. -/
private theorem exists_finset_closure_veronese_of_closure_eq_top
    {Z Y : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z] (g : Z ⟶ Y)
    (M : QDivisor Z) {m : ℕ} (L : Divisor Z) (hL : L.IsCartier)
    (hLM : Divisor.toQDivisor L = (m : ℤ) • M) (V : Y.Opens)
    (T : Finset (Stacks.GradedSections.sectionRing (Divisor.restrictSheaf (g ⁻¹ᵁ V) L)))
    (hT : Subring.closure (Set.range (fun a : Γ(Y, V) =>
      DirectSum.of (Stacks.GradedSections.powSections (Divisor.restrictSheaf (g ⁻¹ᵁ V) L)) 0
        ((Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm (baseMap g V a))) ∪ ↑T) = ⊤) :
    ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G, p ∈ roundDownSubring M (g ⁻¹ᵁ V) ∧ ∀ n, ¬ m ∣ n → p.coeff n = 0) ∧
      ∀ p, p ∈ roundDownSubring M (g ⁻¹ᵁ V) → (∀ n, ¬ m ∣ n → p.coeff n = 0) →
        p ∈ Subring.closure (baseConsts g V ∪ ↑G) := by
  classical
  have hbase : ∀ a : Γ(Y, V), sectionPolyHom (g ⁻¹ᵁ V) hL m (DirectSum.of _ 0
      ((Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm (baseMap g V a))) ∈
        baseConsts g V := by
    intro a
    erw [sectionPolyHom_of]
    rw [Nat.mul_zero, Polynomial.monomial_zero_left]
    refine ⟨a, congrArg Polynomial.C ?_⟩
    change _ = ((rationalFunctionsPresheaf Z).map
      (homOfLE ((g ⁻¹ᵁ V).ι_image_top.ge : g ⁻¹ᵁ V ≤ (g ⁻¹ᵁ V).ι ''ᵁ ⊤)).op).hom
      (Divisor.powSectionsRestrict (g ⁻¹ᵁ V) hL (k := 0)
        ((Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm (baseMap g V a))).1
    rw [Divisor.powSectionsRestrict_unitScalar]
    funext C
    exact (TopCat.Presheaf.germ_res_apply Z.presheaf _ _ _ _).symm
  have hclos : ∀ {x}, x ∈ Subring.closure (Set.range (fun a : Γ(Y, V) =>
      DirectSum.of (Stacks.GradedSections.powSections (Divisor.restrictSheaf (g ⁻¹ᵁ V) L)) 0
        ((Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm (baseMap g V a))) ∪ ↑T) →
      sectionPolyHom (g ⁻¹ᵁ V) hL m x ∈
        Subring.closure (baseConsts g V ∪ ↑(T.image (sectionPolyHom (g ⁻¹ᵁ V) hL m))) :=
    fun hx => (Subring.closure_le
      (t := (Subring.closure _).comap (sectionPolyHom (g ⁻¹ᵁ V) hL m))).mpr (Set.union_subset
      (Set.range_subset_iff.mpr fun a => Subring.subset_closure (Or.inl (hbase a)))
      fun y hy => Subring.subset_closure
        (Or.inr (Finset.mem_image_of_mem (sectionPolyHom (g ⁻¹ᵁ V) hL m) hy))) hx
  refine ⟨T.image (sectionPolyHom (g ⁻¹ᵁ V) hL m), fun p hp => ?_, fun p hp hsupp => ?_⟩
  · obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hp
    exact sectionPolyHom_mem _ hL M hLM x
  · rw [Polynomial.as_sum_support p]
    refine Subring.sum_mem _ fun n _ => ?_
    by_cases hdiv : m ∣ n
    · obtain ⟨k, rfl⟩ := hdiv
      have hc := hp (m * k)
      rw [roundDown_natCast_mul_smul M L hLM k] at hc
      obtain ⟨s, hs⟩ := exists_sectionPolyHom_of_eq_monomial _ hL m k hc
      rw [← hs]
      exact hclos (hT ▸ Subring.mem_top _)
    · rw [hsupp n hdiv, Polynomial.monomial_zero_right]
      exact Subring.zero_mem _

/-- **The Veronese part is finitely generated, ample case.** For `r > 0` with `rM = L` Cartier
and `g`-ample, the section ring `⨁_k Γ(g⁻¹V, (𝒪(L)|_{g⁻¹V})^{⊗ k})` is of finite type over the
Noetherian ring `Γ(Y, V)` because `𝒪(L)` is ample on `g⁻¹V` (Stacks Tag 01VJ) and `g⁻¹V` is
proper over `Spec Γ(Y, V)` (Stacks Tag 0B5T); conclude by
`exists_finset_closure_veronese_of_closure_eq_top`. -/
private theorem exists_finset_closure_veronese_of_hasRelativelyAmpleMultiple
    {Z Y : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    [IsLocallyNoetherian Y] (g : Z ⟶ Y) [IsProper g]
    (M : QDivisor Z) (hM : M.HasRelativelyAmpleMultiple g)
    (V : Y.Opens) (hV : IsAffineOpen V) :
    ∃ r : ℕ, 0 < r ∧ ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G, p ∈ roundDownSubring M (g ⁻¹ᵁ V) ∧ ∀ n, ¬ r ∣ n → p.coeff n = 0) ∧
      ∀ p, p ∈ roundDownSubring M (g ⁻¹ᵁ V) → (∀ n, ¬ r ∣ n → p.coeff n = 0) →
        p ∈ Subring.closure (baseConsts g V ∪ ↑G) := by
  obtain ⟨m, hm, L, hL, hLM, hamp⟩ := hM
  haveI : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := Divisor.isInvertibleModule_restrictSheaf (g ⁻¹ᵁ V) hL
  have hrel : Stacks.RelativeAmple.IsRelativelyAmple g L.divisorialSheaf :=
    Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple g _
      inferInstance hamp
  haveI := Stacks.InvertiblePullback.isInvertibleModule_restrict (g ⁻¹ᵁ V) L.divisorialSheaf
  have hampU : Stacks.Ample.IsAmple (g ⁻¹ᵁ V).toScheme (Divisor.restrictSheaf (g ⁻¹ᵁ V) L) :=
    (Stacks.RelativeVeryAmple.isAmple_congr _ _
      ((Scheme.Modules.restrictFunctorIsoPullback (g ⁻¹ᵁ V).ι).app _ ≪≫
        (Stacks.ProjectiveBundleQuotients.pullbackIso (g ⁻¹ᵁ V).ι).app _)).mpr
      (Stacks.RelativeAmple.IsRelativelyAmple.isAmple_preimage g _ hrel V hV)
  have hft := Stacks.AlgebraicGeometry.ProperAmpleCohomology.ringHomFiniteType_sectionRing
    (R := Γ(Y, V)) ((g ∣_ V) ≫ hV.isoSpec.hom) (Divisor.restrictSheaf (g ⁻¹ᵁ V) L) hampU
  rw [specAlgebraRingHom_eq_baseMap g V hV] at hft
  obtain ⟨T, hT⟩ := hft.out
  refine ⟨m, hm, exists_finset_closure_veronese_of_closure_eq_top g M L hL hLM V T
    (eq_top_iff.mpr fun x hx => ?_)⟩
  clear hx
  induction (SetLike.ext_iff.mp hT x).mpr trivial using Algebra.adjoin_induction with
  | mem y hy => exact Subring.subset_closure (Or.inr hy)
  | algebraMap a => exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
  | add y z _ _ hy hz => exact Subring.add_mem _ hy hz
  | mul y z _ _ hy hz => exact Subring.mul_mem _ hy hz

open MonoidalCategory in
/-- **The Veronese part is finitely generated, free case.** For `g` projective and `dM = L`
Cartier and `g`-free, the sections of `𝒪(L)` over the preimages of small neighbourhoods generate
it everywhere (`exists_forall_mem_nonvanishingLocusOn_of_epi_counit`), so the section ring over
`g⁻¹V` is finitely generated over `Γ(Y, V)` (`MMP.fg_sectionRing_restrict_of_isProjective`);
conclude by `exists_finset_closure_veronese_of_closure_eq_top`. -/
private theorem exists_finset_closure_veronese_of_isRelativelyFreeDivisor
    {Z Y : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    [IsLocallyNoetherian Y] (g : Z ⟶ Y) (hg : IsProjective g) (M : QDivisor Z)
    {d : ℕ} (L : Divisor Z) (hLM : Divisor.toQDivisor L = (d : ℤ) • M)
    (hL : L.IsCartier) (hfree : MMP.Fourfold.IsRelativelyFreeDivisor g L)
    (V : Y.Opens) (hV : IsAffineOpen V) :
    ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G, p ∈ roundDownSubring M (g ⁻¹ᵁ V) ∧ ∀ n, ¬ d ∣ n → p.coeff n = 0) ∧
      ∀ p, p ∈ roundDownSubring M (g ⁻¹ᵁ V) → (∀ n, ¬ d ∣ n → p.coeff n = 0) →
        p ∈ Subring.closure (baseConsts g V ∪ ↑G) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI : IsProper g := hg.isProper
  refine (MMP.fg_sectionRing_restrict_of_isProjective g hg L.divisorialSheaf (fun s => ?_) V
    hV).elim fun T hT => exists_finset_closure_veronese_of_closure_eq_top g M L hL hLM V T hT
  obtain ⟨U, hsU, hU⟩ := exists_forall_mem_nonvanishingLocusOn_of_epi_counit g _ hfree s
  refine ⟨U, hsU, 1, one_pos, fun y hy => ?_⟩
  obtain ⟨t, ht⟩ := hU y hy
  exact ⟨(λ_ L.divisorialSheaf).inv.app _ t,
    (Stacks.SectionPowerOverOpen.mem_nonvanishingLocusOn_congr_iff (λ_ _).symm _ t hy).mpr ht⟩

end SectionRing

/-- **From the Veronese part to the whole algebra.** The Veronese part is a finitely generated
`Γ(Y, V)`-algebra, hence a Noetherian ring (Hilbert's basis theorem), and
`exists_finset_of_veronese` adds finitely many generators of the remaining strands to `G`. Over an
empty `g⁻¹V` the ring of rational functions is trivial and there is nothing to prove. -/
private theorem exists_finset_closure_of_veronese
    {Z Y : Scheme.{u}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    [IsLocallyNoetherian Y] (g : Z ⟶ Y) (M : QDivisor Z)
    (V : Y.Opens) (hV : IsAffineOpen V) (r : ℕ) (hr : 0 < r)
    (G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))))
    (hG : ∀ p ∈ G, p ∈ roundDownSubring M (g ⁻¹ᵁ V) ∧ ∀ n, ¬ r ∣ n → p.coeff n = 0)
    (hgen : ∀ p, p ∈ roundDownSubring M (g ⁻¹ᵁ V) → (∀ n, ¬ r ∣ n → p.coeff n = 0) →
        p ∈ Subring.closure (baseConsts g V ∪ ↑G)) :
    ∃ G' : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G', p ∈ roundDownSubring M (g ⁻¹ᵁ V)) ∧
      ∀ p, p ∈ roundDownSubring M (g ⁻¹ᵁ V) → p ∈ Subring.closure (baseConsts g V ∪ ↑G') := by
  classical
  by_cases hW : ((g ⁻¹ᵁ V : Z.Opens) : Set Z).Nonempty
  swap
  · haveI := subsingleton_rationalFunctionsPresheaf (g ⁻¹ᵁ V) hW
    refine ⟨∅, by simp, fun p _ => ?_⟩
    rw [Subsingleton.elim p 0]
    exact Subring.zero_mem _
  haveI := isDomain_rationalFunctionsPresheaf (g ⁻¹ᵁ V) hW
  let A := roundDownSubring M (g ⁻¹ᵁ V)
  have hconst : baseConsts g V ⊆ (A : Set _) := by
    rintro _ ⟨a, rfl⟩
    exact monomial_mem_roundDownSubring (n := 0) <|
      Divisor.divisorialSubmodule_mono (zero_le_roundDown_zero M) _
        (Divisor.isDivisorialSection_algebraMap le_rfl _)
  have hBA : Subring.closure (baseConsts g V ∪ ↑G) ≤ A :=
    (Subring.closure_le).mpr (Set.union_subset hconst fun p hp => (hG p hp).1)
  let Vsub : Subring (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))) :=
    { carrier := {p | SuppMod r 0 p}
      zero_mem' := fun n _ => Polynomial.coeff_zero n
      add_mem' := fun hp hq n hn => by rw [Polynomial.coeff_add, hp n hn, hq n hn, add_zero]
      neg_mem' := fun hp n hn => by rw [Polynomial.coeff_neg, hp n hn, neg_zero]
      one_mem' := suppMod_one r
      mul_mem' := fun hp hq => by simpa using hp.mul hq }
  have hBsupp : ∀ p ∈ Subring.closure (baseConsts g V ∪ ↑G), SuppMod r 0 p := by
    have : Subring.closure (baseConsts g V ∪ ↑G) ≤ Vsub := (Subring.closure_le).mpr
      (Set.union_subset
        (by
          rintro _ ⟨a, rfl⟩
          change SuppMod r 0 _
          simpa using suppMod_monomial (K := (rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))
            r 0 (algebraMap Γ(Z, g ⁻¹ᵁ V) _ (g.app V a)))
        fun p hp => suppMod_zero_iff.mpr (hG p hp).2)
    exact fun p hp => this hp
  haveI : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  haveI : IsNoetherianRing (Subring.closure (baseConsts g V ∪ ↑G)) := by
    rw [show baseConsts g V = Set.range
      (Polynomial.C.comp ((algebraMap Γ(Z, g ⁻¹ᵁ V) _).comp (g.app V).hom)) from rfl]
    exact isNoetherianRing_closure_range_union _ G
  obtain ⟨F, hFA, hF⟩ := exists_finset_of_veronese A
    (fun p hp m => monomial_mem_roundDownSubring (hp m)) _ hBA hr hBsupp
    fun p hp hs => hgen p hp (suppMod_zero_iff.mp hs)
  refine ⟨G ∪ F, fun p hp => ?_, fun p hp => ?_⟩
  · exact (Finset.mem_union.mp hp).elim (fun h => (hG p h).1) (hFA ·)
  · refine (Subring.closure_le.mpr (Set.union_subset (fun x hx => Subring.closure_mono
      (Set.union_subset_union_right _ (by simp)) hx) fun x hx =>
        Subring.subset_closure (Or.inr (by simp [hx])))) (hF p hp)

/-- **The round-down algebra of a relatively ample `ℚ`-divisor is of finite type.** Let
`g : Z ⟶ Y` be a proper morphism of locally Noetherian schemes with `Z` integral, normal and
quasi-compact, and `M` a `ℚ`-Cartier `ℚ`-divisor on `Z` which is `g`-ample. For every affine open
`V ⊆ Y`, the `Γ(Y, V)`-algebra `⨁_{m ≥ 0} Γ(g⁻¹V, 𝒪_Z(⌊mM⌋)) ⊆ 𝒦_Z(g⁻¹V)[t]` is generated, over
the constants coming from `Γ(Y, V)`, by a finite set `G` of its elements. -/
@[mmp "lem_km3c_relatively_ample_algebra_fg"]
theorem QDivisor.exists_finset_closure_roundDown_eq_of_hasRelativelyAmpleMultiple
    {Z Y : Scheme.{u}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    [IsLocallyNoetherian Y] (g : Z ⟶ Y) [IsProper g]
    (M : QDivisor Z) (hMq : M.IsQCartier) (hM : M.HasRelativelyAmpleMultiple g)
    (V : Y.Opens) (hV : IsAffineOpen V) :
    ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G, ∀ m : ℕ, p.coeff m ∈
        (DivisorWithCoeffs.roundDown ((m : ℚ) • M)).divisorialSubmodule (g ⁻¹ᵁ V)) ∧
      ∀ p : Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V))),
        (∀ m : ℕ, p.coeff m ∈
          (DivisorWithCoeffs.roundDown ((m : ℚ) • M)).divisorialSubmodule (g ⁻¹ᵁ V)) →
        p ∈ Subring.closure (Set.range (fun a : Γ(Y, V) =>
          Polynomial.C (algebraMap Γ(Z, g ⁻¹ᵁ V)
            ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V))) (g.app V a))) ∪ ↑G) := by
  obtain ⟨r, hr, G, hG, hgen⟩ := exists_finset_closure_veronese_of_hasRelativelyAmpleMultiple g M hM V hV
  exact exists_finset_closure_of_veronese g M V hV r hr G hG hgen

/-- **The round-down algebra of a relatively free `ℚ`-divisor is of finite type.** Let
`g : Z ⟶ Y` be a projective morphism of locally Noetherian schemes with `Z` integral, normal and
quasi-compact, and `M` a `ℚ`-divisor on `Z` with `dM = L` (`d > 0`) a Cartier divisor which is
`g`-free. For every affine open `V ⊆ Y`, the `Γ(Y, V)`-algebra
`⨁_{m ≥ 0} Γ(g⁻¹V, 𝒪_Z(⌊mM⌋)) ⊆ 𝒦_Z(g⁻¹V)[t]` is generated, over the constants coming from
`Γ(Y, V)`, by a finite set `G` of its elements. -/
theorem QDivisor.exists_finset_closure_roundDown_eq_of_isRelativelyFreeDivisor
    {Z Y : Scheme.{u}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] [CompactSpace Z]
    [IsLocallyNoetherian Y] (g : Z ⟶ Y) (hg : IsProjective g) (M : QDivisor Z)
    {d : ℕ} (hd : 0 < d) (L : Divisor Z) (hLM : Divisor.toQDivisor L = (d : ℤ) • M)
    (hL : L.IsCartier) (hfree : MMP.Fourfold.IsRelativelyFreeDivisor g L)
    (V : Y.Opens) (hV : IsAffineOpen V) :
    ∃ G : Finset (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))),
      (∀ p ∈ G, ∀ m : ℕ, p.coeff m ∈
        (DivisorWithCoeffs.roundDown ((m : ℚ) • M)).divisorialSubmodule (g ⁻¹ᵁ V)) ∧
      ∀ p : Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V))),
        (∀ m : ℕ, p.coeff m ∈
          (DivisorWithCoeffs.roundDown ((m : ℚ) • M)).divisorialSubmodule (g ⁻¹ᵁ V)) →
        p ∈ Subring.closure (Set.range (fun a : Γ(Y, V) =>
          Polynomial.C (algebraMap Γ(Z, g ⁻¹ᵁ V)
            ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V))) (g.app V a))) ∪ ↑G) := by
  obtain ⟨G, hG, hgen⟩ :=
    exists_finset_closure_veronese_of_isRelativelyFreeDivisor g hg M L hLM hL hfree V hV
  exact exists_finset_closure_of_veronese g M V hV d hd G hG hgen

end MMP.Mori

end
