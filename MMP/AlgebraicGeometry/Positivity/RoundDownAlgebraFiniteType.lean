/-!
# Finite generation of the round-down algebra of a relatively ample or free `ℚ`-divisor

Let `g : Z ⟶ Y` be a proper morphism of locally Noetherian schemes, with `Z` integral, normal and
quasi-compact, and let `M` be a `ℚ`-Cartier `ℚ`-divisor on `Z` which is `g`-ample. Then the graded
`𝒪_Y`-algebra `⨁_{m ≥ 0} g_* 𝒪_Z(⌊mM⌋)` is of finite type. Over an affine open `V ⊆ Y` its
sections are the polynomials `∑ φₘ tᵐ` with coefficients in `𝒦_Z(g⁻¹V)` such that
`φₘ ∈ 𝒪_Z(⌊mM⌋)(g⁻¹V)`, and the claim is that finitely many of them generate it over `Γ(Y, V)`.
The same holds, for `g` projective, when a positive multiple `dM` is a Cartier divisor which is
`g`-free instead of `g`-ample.

In both cases the proof first finds finitely many generators of the Veronese part, the
polynomials supported in degrees divisible by the multiple `r` with `rM` Cartier: it is the image
of the section ring of `𝒪_Z(rM)` over `g⁻¹V`, which is of finite type over `Γ(Y, V)` (by Serre
finiteness in the ample case, by semiampleness in the free case). The remaining strands are then
finite modules over the Noetherian Veronese part.

## Main results

* `MMP.Mori.QDivisor.exists_finset_closure_roundDown_eq_of_hasRelativelyAmpleMultiple`
* `MMP.Mori.QDivisor.exists_finset_closure_roundDown_eq_of_isRelativelyFreeDivisor`
* `MMP.Mori.exists_forall_mem_nonvanishingLocusOn_of_epi_counit`: for `g` universally closed
  and `N` invertible with `g^* g_* N → N` surjective, every point of `Y` has a neighbourhood `U`
  such that the sections of `N` over `g⁻¹U` generate `N` at every point of `g⁻¹U`.

## Implementation notes

Finite generation of the quasi-coherent `𝒪_Y`-algebra is stated over every affine open of `Y`,
and it is expressed as a subring closure inside `𝒦_Z(g⁻¹V)[t]`: the algebra is the set of
polynomials whose coefficients satisfy the divisorial condition, and it is generated by the
constants coming from `Γ(Y, V)` together with a finite set `G` of its elements.

The source states the result for varieties over a field; the argument (Serre finiteness for
ample twists of a coherent sheaf over an affine Noetherian base) works over any locally
Noetherian base, which is the generality stated here (compare [kollar-mori], Remark 6.1).

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][kollar-mori], §6
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite Polynomial

universe u

namespace MMP.Mori

open Stacks.NonvanishingLocusRestrict in
/-- **Relative global generation is uniform over a neighbourhood of each point of the base.**
Let `g : Z ⟶ Y` be universally closed and `N` an invertible `𝒪_Z`-module with `g^* g_* N → N`
surjective. Every `s ∈ Y` has an open neighbourhood `U` such that every point of `g⁻¹U` lies in
the nonvanishing locus of a section of `N` over `g⁻¹U`. -/
theorem exists_forall_mem_nonvanishingLocusOn_of_epi_counit {Z Y : Scheme.{u}} (g : Z ⟶ Y)
    [UniversallyClosed g] (N : Z.Modules) [Stacks.Ample.IsInvertibleModule Z N]
    (h : Epi ((Scheme.Modules.pullbackPushforwardAdjunction g).counit.app N)) (s : Y) :
    ∃ U : Y.Opens, s ∈ U ∧ ∀ z ∈ g ⁻¹ᵁ U, ∃ t : Γ(N, g ⁻¹ᵁ U),
      z ∈ nonvanishingLocusOn N (g ⁻¹ᵁ U) t := by
  classical
  haveI : Epi (((Scheme.Modules.pullbackPushforwardAdjunction g).homEquiv _ N).symm
      (𝟙 ((Scheme.Modules.pushforward g).obj N))) := by
    rwa [Adjunction.homEquiv_counit, CategoryTheory.Functor.map_id, Category.id_comp]
  choose V _ t ht using Stacks.Tag01VMVeryAmple.exists_mem_nonvanishingLocusOn_of_epi_adjoint g
    (𝟙 ((Scheme.Modules.pushforward g).obj N))
  have hO : ∀ z, IsOpen (nonvanishingLocusOn N (g ⁻¹ᵁ V z)
      (Scheme.Modules.Hom.app (𝟙 ((Scheme.Modules.pushforward g).obj N)) (V z) (t z))) :=
    fun z => Stacks.SectionPowerOpen.isOpen_nonvanishingLocusOn _ _ _
  obtain ⟨I, hI⟩ := (g.isProperMap.isCompact_preimage isCompact_singleton).elim_finite_subcover
    _ (fun z : g ⁻¹' {s} => hO z.1) fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, ht z⟩
  let U : Y.Opens := ⟨(⋂ i ∈ I, (V i.1 : Set Y)) ∩ (g '' _)ᶜ,
    (isOpen_biInter_finset fun i _ => (V i.1).2).inter
      (g.isClosedMap _ (isOpen_biUnion fun i (_ : i ∈ I) => hO i.1).isClosed_compl).isOpen_compl⟩
  refine ⟨U, ⟨Set.mem_iInter₂.mpr fun i _ =>
    Set.mem_of_eq_of_mem i.2.symm (ht i.1).1, fun ⟨c, hc, hcs⟩ => hc (hI hcs)⟩,
    fun z hz => ?_⟩
  obtain ⟨i, hi, hzi⟩ := Set.mem_iUnion₂.mp (not_not.mp fun hn => hz.2 ⟨z, hn, rfl⟩)
  have hle : g ⁻¹ᵁ U ≤ g ⁻¹ᵁ V i.1 := fun x hx => Set.mem_iInter₂.mp hx.1 i hi
  let x : Γ(N, g ⁻¹ᵁ V i.1) :=
    Scheme.Modules.Hom.app (𝟙 ((Scheme.Modules.pushforward g).obj N)) (V i.1) (t i.1)
  refine ⟨(N.presheaf.map (homOfLE hle).op).hom x, ?_⟩
  rw [nonvanishingLocusOn_res]
  exact ⟨hz, hzi⟩

/-- Constants coming from `Γ(Y, V)`. -/
private abbrev baseConsts {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Opens) :
    Set (Polynomial ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V)))) :=
  Set.range (fun a : Γ(Y, V) =>
    Polynomial.C (algebraMap Γ(Z, g ⁻¹ᵁ V)
      ((rationalFunctionsPresheaf Z).obj (op (g ⁻¹ᵁ V))) (g.app V a)))

/-- `p` is supported in the residue class of `i` modulo `r`. -/
private def SuppMod {K : Type*} [Semiring K] (r i : ℕ) (p : K[X]) : Prop :=
  ∀ n, n % r ≠ i % r → p.coeff n = 0

private theorem SuppMod.mul {K : Type*} [Semiring K] {r i j : ℕ} {p q : K[X]} (hp : SuppMod r i p)
    (hq : SuppMod r j q) : SuppMod r (i + j) (p * q) := by
  intro n hn
  rw [coeff_mul]
  refine Finset.sum_eq_zero fun x hx => ?_
  have hx : x.1 + x.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
  by_cases ha : x.1 % r = i % r
  · by_cases hc : x.2 % r = j % r
    · exact absurd (by rw [← hx, Nat.add_mod, ha, hc, ← Nat.add_mod]) hn
    · rw [hq _ hc, mul_zero]
  · rw [hp _ ha, zero_mul]

private theorem suppMod_one {K : Type*} [Semiring K] (r : ℕ) : SuppMod r 0 (1 : K[X]) := by
  intro n hn
  rw [coeff_one]
  rcases n with _ | n
  · simp at hn
  · simp

private theorem SuppMod.pow {K : Type*} [Semiring K] {r i : ℕ} {p : K[X]} (hp : SuppMod r i p) :
    ∀ k : ℕ, SuppMod r (k * i) (p ^ k)
  | 0 => by simpa using suppMod_one (K := K) r
  | k + 1 => by
    rw [pow_succ, add_mul, one_mul]
    exact (hp.pow k).mul hp

private theorem suppMod_monomial {K : Type*} [Semiring K] (r n : ℕ) (c : K) :
    SuppMod r n (monomial n c) := by
  intro m hm
  rw [coeff_monomial, if_neg]
  rintro rfl
  exact hm rfl

/-- Support in degrees `≡ 0 (mod r)` is support in the multiples of `r`. -/
private theorem suppMod_zero_iff {K : Type*} [Semiring K] {r : ℕ} {p : K[X]} :
    SuppMod r 0 p ↔ ∀ n, ¬ r ∣ n → p.coeff n = 0 := by
  simp only [SuppMod, Nat.zero_mod, ne_eq, Nat.dvd_iff_mod_eq_zero]

/-- A `B`-submodule of `K[X]` contained in the strand of `A` of degrees `≡ j (mod r)` is finite
over `B`: multiplication by `y ^ (r - 1)`, for a nonzero `y` of the strand, embeds it
`B`-linearly into `B`. -/
private theorem fg_of_forall_mem_suppMod {K : Type*} [CommRing K] [IsDomain K]
    {A B : Subring K[X]} {r j : ℕ} (hr : 0 < r) (hB : ∀ p ∈ A, SuppMod r 0 p → p ∈ B)
    [IsNoetherianRing B] (S : Submodule B K[X]) (hS : ∀ p ∈ S, p ∈ A ∧ SuppMod r j p) :
    S.FG := by
  by_cases hy : ∃ y ∈ S, y ≠ 0
  · obtain ⟨y, hyS, hy0⟩ := hy
    let T : K[X] →ₗ[B] K[X] := LinearMap.mulLeft B (y ^ (r - 1))
    have hT : Function.Injective T := fun a b hab => mul_left_cancel₀ (pow_ne_zero _ hy0) hab
    let N : Submodule B K[X] := Submodule.span B {1}
    haveI : IsNoetherian B N := isNoetherian_of_fg_of_noetherian N (Submodule.fg_span_singleton 1)
    have hle : S.map T ≤ N := by
      rintro _ ⟨x, hx, rfl⟩
      have hmem : y ^ (r - 1) * x ∈ B := by
        refine hB _ (A.mul_mem (A.pow_mem (hS y hyS).1 _) (hS x hx).1) fun n hn =>
          (((hS y hyS).2.pow (r - 1)).mul (hS x hx).2) n ?_
        rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hr, Nat.mul_mod_right]
        exact hn
      rw [Submodule.mem_span_singleton]
      refine ⟨⟨_, hmem⟩, ?_⟩
      simp [T, Algebra.smul_def]
      rfl
    have hfg : (S.map T).FG := by
      have := IsNoetherian.noetherian (R := B) (M := N) (Submodule.comap N.subtype (S.map T))
      have h2 := this.map N.subtype
      rwa [Submodule.map_comap_eq, inf_eq_right.mpr (by simpa using hle)] at h2
    exact Submodule.fg_of_fg_map_injective T hT hfg
  · push Not at hy
    have : S = ⊥ := eq_bot_iff.mpr fun y hy' => (Submodule.mem_bot B).mpr (hy y hy')
    rw [this]
    exact Submodule.fg_bot

/-- **From a Noetherian Veronese part to the whole algebra.** Let `A ⊆ K[X]` be a subring closed
under taking homogeneous components, and `B ≤ A` a Noetherian subring which is exactly the part of
`A` supported in degrees divisible by `r > 0`. Then `A` is generated over `B` by finitely many of
its elements: for each residue `j` mod `r`, multiplication by `y ^ (r - 1)`, for a nonzero `y` of
the strand of degrees `≡ j (mod r)`, embeds that strand `B`-linearly into `B`, so the strand is a
finite `B`-module. -/
private theorem exists_finset_of_veronese {K : Type*} [CommRing K] [IsDomain K]
    (A : Subring K[X]) (hhom : ∀ p ∈ A, ∀ m, monomial m (p.coeff m) ∈ A)
    (B : Subring K[X]) (hBA : B ≤ A) {r : ℕ} (hr : 0 < r)
    (hBsupp : ∀ p ∈ B, SuppMod r 0 p)
    (hB : ∀ p ∈ A, SuppMod r 0 p → p ∈ B) [IsNoetherianRing B] :
    ∃ F : Finset K[X], (↑F ⊆ (A : Set K[X])) ∧
      ∀ p ∈ A, p ∈ Subring.closure ((B : Set K[X]) ∪ ↑F) := by
  classical
  let S : ℕ → Submodule B K[X] := fun j =>
    { carrier := {p | p ∈ A ∧ SuppMod r j p}
      add_mem' := fun {p q} hp hq => ⟨A.add_mem hp.1 hq.1, fun n hn => by
        rw [coeff_add, hp.2 n hn, hq.2 n hn, add_zero]⟩
      zero_mem' := ⟨A.zero_mem, fun n _ => coeff_zero n⟩
      smul_mem' := fun b p hp =>
        ⟨A.mul_mem (hBA b.2) hp.1, by
          change SuppMod r j ((b : K[X]) * p)
          simpa using (hBsupp b b.2).mul hp.2⟩ }
  have hS : ∀ j, (S j).FG := fun j => fg_of_forall_mem_suppMod hr hB (S j) fun _ hp => hp
  choose F hF using hS
  refine ⟨(Finset.range r).biUnion F, ?_, ?_⟩
  · intro p hp
    simp only [Finset.coe_biUnion, Finset.coe_range, Set.mem_iUnion, Finset.mem_coe] at hp
    obtain ⟨j, -, hj⟩ := hp
    exact (hF j ▸ Submodule.subset_span hj : p ∈ S j).1
  · intro p hp
    have hspan : ∀ j < r, ∀ q ∈ S j, q ∈ Subring.closure ((B : Set K[X]) ∪
        ↑((Finset.range r).biUnion F)) := by
      intro j hj q hq
      rw [← hF j] at hq
      induction hq using Submodule.span_induction with
      | mem x hx =>
        exact Subring.subset_closure (Or.inr (Finset.mem_biUnion.mpr
          ⟨j, Finset.mem_range.mpr hj, hx⟩))
      | zero => exact Subring.zero_mem _
      | add x y _ _ hx hy => exact Subring.add_mem _ hx hy
      | smul b x _ hx =>
        rw [Algebra.smul_def]
        exact Subring.mul_mem _ (Subring.subset_closure (Or.inl b.2)) hx
    rw [as_sum_support p]
    refine Subring.sum_mem _ fun n _ => ?_
    refine hspan (n % r) (Nat.mod_lt n hr) _ ⟨hhom p hp n, fun m hm => ?_⟩
    exact suppMod_monomial r n _ m (by rwa [Nat.mod_mod] at hm)

/-- The subring generated by the image of a Noetherian ring and finitely many elements is
Noetherian (Hilbert's basis theorem). -/
private theorem isNoetherianRing_closure_range_union {R S : Type*} [CommRing R]
    [IsNoetherianRing R] [CommRing S] (φ : R →+* S) (G : Finset S) :
    IsNoetherianRing (Subring.closure (Set.range φ ∪ ↑G)) := by
  letI : Algebra R S := φ.toAlgebra
  have hBeq : (Algebra.adjoin R (↑G : Set S)).toSubring = Subring.closure (Set.range φ ∪ ↑G) :=
    Algebra.adjoin_eq_ring_closure _
  haveI : Algebra.FiniteType R (Algebra.adjoin R (↑G : Set S)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset G)
  haveI hN : IsNoetherianRing (Algebra.adjoin R (↑G : Set S)) :=
    Algebra.FiniteType.isNoetherianRing R _
  haveI hN' : IsNoetherianRing (Algebra.adjoin R (↑G : Set S)).toSubring := hN
  exact hBeq ▸ hN'

/-- On an integral scheme the rational functions over a nonempty open form a domain: the product
has a single factor, the function field. -/
private theorem isDomain_rationalFunctionsPresheaf {Z : Scheme.{u}} [IsIntegral Z] (W : Z.Opens)
    (hW : (W : Set Z).Nonempty) : IsDomain ((rationalFunctionsPresheaf Z).obj (op W)) := by
  have hsub : Subsingleton (irreducibleComponents Z) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  let C : irreducibleComponents Z := ⟨Set.univ, by
    rw [irreducibleComponents_eq_singleton]
    rfl⟩
  have hC : componentGenericPoint Z C ∈ W := by
    rw [genericPoint_mem_iff]
    simpa [C] using hW
  let ι := {C : irreducibleComponents Z // componentGenericPoint Z C ∈ W}
  letI : Unique ι :=
    { default := ⟨C, hC⟩
      uniq := fun a => Subtype.ext (Subsingleton.elim _ _) }
  letI : Field (Z.presheaf.stalk (componentGenericPoint Z (default : ι).1)) :=
    (RationalFunctions.isField_stalk (X := Z) (default : ι).1).toField
  let e := RingEquiv.piUnique (fun Z' : ι => Z.presheaf.stalk (componentGenericPoint Z Z'.1))
  exact Function.Injective.isDomain e.toRingHom e.injective

/-- Over an empty open the ring of rational functions is trivial. -/
private theorem subsingleton_rationalFunctionsPresheaf {Z : Scheme.{u}} (W : Z.Opens)
    (hW : ¬ (W : Set Z).Nonempty) :
    Subsingleton (ToType ((rationalFunctionsPresheaf Z).obj (op W))) :=
  ⟨fun a b => funext fun C => absurd ⟨_, C.2⟩ hW⟩

/-- `⌊aM⌋ + ⌊bM⌋ ≤ ⌊(a + b)M⌋`. -/
private theorem roundDown_add_le {Z : Scheme.{u}} (M : QDivisor Z) (a b : ℕ) :
    DivisorWithCoeffs.roundDown ((a : ℚ) • M) + DivisorWithCoeffs.roundDown ((b : ℚ) • M) ≤
      DivisorWithCoeffs.roundDown (((a + b : ℕ) : ℚ) • M) := by
  rw [Finsupp.le_def]
  intro E
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_roundDown,
    DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_roundDown,
    DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul,
    Nat.cast_add, add_smul]
  exact Int.le_floor_add _ _

/-- `0 ≤ ⌊0 • M⌋`. -/
private theorem zero_le_roundDown_zero {Z : Scheme.{u}} (M : QDivisor Z) :
    (0 : Divisor Z) ≤ DivisorWithCoeffs.roundDown (((0 : ℕ) : ℚ) • M) := by
  rw [Finsupp.le_def]
  intro E
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul]
  simp [DivisorWithCoeffs.coeff_zero]

/-- The round-down algebra, as a subring of `𝒦_Z(W)[t]`. -/
private def roundDownSubring {Z : Scheme.{u}} [IsLocallyNoetherian Z] [IsNormal Z]
    (M : QDivisor Z) (W : Z.Opens) :
    Subring (Polynomial ((rationalFunctionsPresheaf Z).obj (op W))) where
  carrier := {p | ∀ m : ℕ, p.coeff m ∈
    (DivisorWithCoeffs.roundDown ((m : ℚ) • M)).divisorialSubmodule W}
  zero_mem' := fun m => by rw [Polynomial.coeff_zero]; exact Submodule.zero_mem _
  add_mem' := fun hp hq m => by rw [Polynomial.coeff_add]; exact Submodule.add_mem _ (hp m) (hq m)
  neg_mem' := fun hp m => by rw [Polynomial.coeff_neg]; exact Submodule.neg_mem _ (hp m)
  one_mem' := fun m => by
    rw [Polynomial.coeff_one]
    split_ifs with h
    · subst h
      exact Divisor.divisorialSubmodule_mono (zero_le_roundDown_zero M) W
        (Divisor.IsDivisorialSection.one le_rfl W)
    · exact Submodule.zero_mem _
  mul_mem' := fun {p q} hp hq m => by
    rw [Polynomial.coeff_mul]
    refine Submodule.sum_mem _ fun x hx => ?_
    obtain rfl : x.1 + x.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    exact Divisor.divisorialSubmodule_mono (roundDown_add_le M x.1 x.2) W
      (Divisor.divisorialMul W ⟨_, hp x.1⟩ ⟨_, hq x.2⟩).2

/-- A monomial `c tⁿ` lies in the round-down algebra iff `c` is a section of `𝒪(⌊nM⌋)`. -/
private theorem monomial_mem_roundDownSubring {Z : Scheme.{u}} [IsLocallyNoetherian Z]
    [IsNormal Z] {M : QDivisor Z} {W : Z.Opens} {n : ℕ}
    {c : (rationalFunctionsPresheaf Z).obj (op W)}
    (hc : c ∈ (DivisorWithCoeffs.roundDown ((n : ℚ) • M)).divisorialSubmodule W) :
    monomial n c ∈ roundDownSubring M W := fun m => by
  rw [coeff_monomial]
  split_ifs with h
  · exact h ▸ hc
  · exact Submodule.zero_mem _

/-- `⌊mkM⌋ = kL` when `L = mM` is integral. -/
private theorem roundDown_natCast_mul_smul {Z : Scheme.{u}} (M : QDivisor Z) {m : ℕ}
    (L : Divisor Z) (hLM : Divisor.toQDivisor L = (m : ℤ) • M) (k : ℕ) :
    DivisorWithCoeffs.roundDown (((m * k : ℕ) : ℚ) • M) = k • L := by
  ext E
  have h := congrArg (fun D : QDivisor Z => D.coeff E) hLM
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
    Int.cast_natCast] at h
  rw [DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_smul, smul_eq_mul, nsmul_eq_mul, Nat.cast_mul, mul_comm (m : ℚ),
    mul_assoc, ← h]
  exact_mod_cast Int.floor_intCast ((k : ℤ) * L.coeff E)

/-- The structure map `Γ(Y, V) → Γ(g⁻¹V, ⊤)` of the open subscheme `g⁻¹V` over `Γ(Y, V)`. -/
private noncomputable def baseMap {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Opens) :
    Γ(Y, V) →+* Γ((g ⁻¹ᵁ V).toScheme, ⊤) :=
  (g ⁻¹ᵁ V).topIso.inv.hom.comp (g.app V).hom

private theorem specAlgebraRingHom_eq_baseMap {Z Y : Scheme.{u}} (g : Z ⟶ Y) (V : Y.Opens)
    (hV : IsAffineOpen V) :
    Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom Γ(Y, V)
      ((g ∣_ V) ≫ hV.isoSpec.hom) = baseMap g V := by
  have h : (Scheme.ΓSpecIso Γ(Y, V)).inv ≫ ((g ∣_ V) ≫ hV.isoSpec.hom).appTop =
      g.app V ≫ (g ⁻¹ᵁ V).topIso.inv := by
    rw [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop, Category.assoc,
      Iso.inv_hom_id_assoc, Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv,
      morphismRestrict_appTop,
      Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    simp only [Scheme.Hom.app_eq_appLE, Category.assoc, Scheme.Hom.appLE_map,
      Scheme.Hom.map_appLE]
    erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  exact congrArg CommRingCat.Hom.hom h

