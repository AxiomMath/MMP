module

public import MMP.AlgebraicGeometry.Positivity.VeryAmpleMultiple
public import StacksFrontier.AlgebraicGeometry.ProperAmpleCohomology.Basic
public import StacksFrontier.AlgebraicGeometry.AmpleCharacterization.NineClauses
public import StacksFrontier.AlgebraicGeometry.AmplePositivePower.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ModuleTypesUnderIso

/-!
# Serre's theorems for twists by an ample Cartier divisor

For a Cartier divisor `L` on a scheme and `m > 0`, `L` is ample if and only if `mL` is;
and for a scheme `X` proper over a field `k`, an ample Cartier divisor `A` and a coherent sheaf
`F`, the twist `F ⊗ 𝒪_X(mA)` is globally generated with vanishing higher cohomology for `m ≫ 0`.

## Main results

* `MMP.Resolution.Bridges.isAmple_lineBundle_iff_nsmul`: `L` ample `↔` `mL` ample, `m > 0`.
* `MMP.Resolution.Bridges.eventually_isGeneratedByGlobalSections_and_isZero_Hgroup`: Serre's
  generation and vanishing for `F ⊗ 𝒪_X(mA)`, `m ≫ 0`.

## Implementation notes

* `𝒪_X(D)` is `MMP.CartierDivisor.sheaf D`. For a scheme with no base field,
  ampleness is the Stacks notion `Stacks.Ample.IsAmple` (Tag 01PS) of `𝒪_X(L)`; over a field it is
  the notion `MMP.Intersection.IsAmpleDivisor` (Lazarsfeld Def. 1.2.1), which is equivalent
  for proper schemes (`Stacks.AmpleRelativeFiniteType.tfae_six`).
* The tensor product is the monoidal structure
  `MMP.Intersection.Scheme.Modules.monoidalCategory` on `X.Modules` (Stacks 01CA).
* Generation by global sections is `SheafOfModules.IsGeneratedByGlobalSections` (Stacks 03DE) and
  cohomology is the derived-functor cohomology `Hgroup X.ringCatSheaf ⊤ i` on `X`.
* The library results are
  `Stacks.AmplePositivePower.isAmple_iff_isAmple_tensorPowModule` (Tag 01PT),
  `Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple`
  (Tag 01Q3 (7)) and
  `Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_isZero_Hgroup_tensorPowTwist`
  (Tag 0B5T (4)), stated for tensor powers of invertible modules; the bridge is
  `MMP.Resolution.Bridges.lineBundle_nsmul_iso_tensorPow`.
-/

@[expose] public section

universe u

open CategoryTheory AlgebraicGeometry MonoidalCategory

namespace MMP.Resolution.Bridges

open MMP.Intersection (IsAmpleDivisor)

open Stacks.Ample in
private theorem nonempty_lineBundle_nsmul_iso {X : Scheme.{u}} (L : X.CartierDivisor) (m : ℕ) :
    Nonempty (MMP.CartierDivisor.sheaf (m • L) ≅
      tensorPowModule X (MMP.CartierDivisor.sheaf L) (m : ℤ)) := by
  obtain ⟨e⟩ := lineBundle_nsmul_iso_tensorPow L m
  obtain ⟨e'⟩ := nonempty_tensorPow_iso_tensorPowModule X (MMP.CartierDivisor.sheaf L) m
  exact ⟨e ≪≫ e'⟩

/-- **Ampleness and positive multiples.** A Cartier divisor `L` on a scheme is ample if
and only if `mL` is ample, for any natural number `m > 0`. -/
@[mmp "lem_mmp_foundation_ample_positive_power"]
theorem isAmple_lineBundle_iff_nsmul {X : Scheme.{u}} (L : X.CartierDivisor)
    (m : ℕ) (hm : 0 < m) :
    Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf L) ↔
      Stacks.Ample.IsAmple X (MMP.CartierDivisor.sheaf (m • L)) := by
  obtain ⟨e⟩ := nonempty_lineBundle_nsmul_iso L m
  rw [Stacks.AmplePositivePower.isAmple_iff_isAmple_tensorPowModule (MMP.CartierDivisor.sheaf L) m
      hm]
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).symm

/-- **Serre generation and vanishing for proper schemes.** Let `X` be proper over a field `k`,
`A` an ample Cartier divisor on `X` and `F` a coherent sheaf. Then for all `m ≫ 0` the sheaf
`F ⊗ 𝒪_X(mA)` is generated by its global sections and `Hⁱ(X, F ⊗ 𝒪_X(mA)) = 0` for every
`i > 0`. -/
@[mmp "lem_mmp_foundation_proper_ample_serre"]
theorem eventually_isGeneratedByGlobalSections_and_isZero_Hgroup (k : Type u) [Field k]
    {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))]
    (A : X.CartierDivisor) (hA : IsAmpleDivisor k A) (F : X.Modules)
    [SheafOfModules.IsCoherent F] :
    ∀ᶠ m : ℕ in Filter.atTop,
      SheafOfModules.IsGeneratedByGlobalSections.{u, u, u}
          (tensorObj (C := X.Modules) F (MMP.CartierDivisor.sheaf (m • A))) ∧
        ∀ i : ℕ, 0 < i → Limits.IsZero (Hgroup X.ringCatSheaf ⊤ i
          (tensorObj (C := X.Modules) F (MMP.CartierDivisor.sheaf (m • A)))) := by
  set M := MMP.CartierDivisor.sheaf A
  obtain ⟨d, hd, hva⟩ := hA
  obtain ⟨eP⟩ := nonempty_tensorPow_iso_tensorPowModule X M d
  have h5 : ∃ d : ℕ, 1 ≤ d ∧ Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver
      (X ↘ Spec (.of k)) (Stacks.Ample.tensorPowModule X M (d : ℤ)) :=
    ⟨d, hd, hasImmersionTwistOver_of_isVeryAmple k _ _ hva eP.symm⟩
  have hample : Stacks.Ample.IsAmple X M :=
    ((Stacks.AmpleRelativeFiniteType.tfae_six (X ↘ Spec (.of k)) M).out 5 1).1 h5
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple
      M hample).2 F (_root_.isQuasicoherent_of_isCoherent (M := F))
      (SheafOfModules.IsCoherent.isFiniteType (M := F))
  obtain ⟨d₀, hd₀⟩ :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_isZero_Hgroup_tensorPowTwist
      (X ↘ Spec (.of k)) F M hample
  rw [Filter.eventually_atTop]
  refine ⟨max n₀.toNat d₀, fun m hm => ?_⟩
  obtain ⟨e⟩ := nonempty_lineBundle_nsmul_iso A m
  let e2 : Stacks.RelativeVeryAmple.tensorModules X F (MMP.CartierDivisor.sheaf (m • A)) ≅
      Stacks.RelativeVeryAmple.tensorModules X F (Stacks.Ample.tensorPowModule X M (m : ℤ)) :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl F) e
  refine ⟨?_, fun i hi => ?_⟩
  · have hg := hn₀ (m : ℤ) (by have := (le_max_left _ _).trans hm; omega)
    refine Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso ?_ hg
    exact (Stacks.AmplePullbackPart1.tensorIsoTensorModules X F _).trans e2.symm
  · have h0 := hd₀ m i ((le_max_right _ _).trans hm) hi
    exact h0.of_iso ((Hfunctor X.ringCatSheaf ⊤ i).mapIso e2)

end MMP.Resolution.Bridges
