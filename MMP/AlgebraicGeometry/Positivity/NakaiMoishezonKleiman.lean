/-- **A globally generated invertible sheaf has a nonvanishing global section through every
point**: otherwise every global section, and so every germ of a section at `x`, would lie in
`𝔪ₓ · Lₓ`. -/
private theorem IsGloballyGenerated.exists_mem_nonvanishingLocus {X : Scheme.{u}}
    {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L] (hL : IsGloballyGenerated L) (x : X) :
    ∃ σ : Γ(L, ⊤), x ∈ Stacks.Ample.nonvanishingLocus L σ := by
  by_contra hx
  push Not at hx
  have hm (σ : Γ(L, ⊤)) : (L.presheaf.Γgerm x).hom σ ∈ Stacks.ModuleStalk.maximalSmul L x := by
    simpa [Stacks.Ample.mem_nonvanishingLocus_iff] using hx σ
  obtain ⟨w, hw⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul L x
  obtain ⟨U, hU, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq (C := Ab.{u}) L.presheaf w
  obtain ⟨W, hWU, hxW, n, s, r, heq⟩ := hL x trivial U hU t
  apply hw
  rw [← TopCat.Presheaf.germ_res_apply (C := Ab.{u}) L.presheaf (homOfLE hWU) x hxW t, heq,
    map_sum]
  refine Submodule.sum_mem _ fun i _ => Stacks.ModuleStalk.germ_smul L x W hxW _ _ ▸
    Submodule.smul_mem _ _ ?_
  rw [TopCat.Presheaf.germ_res_apply (C := Ab.{u}) L.presheaf (homOfLE (le_top : W ≤ ⊤)) x hxW]
  exact hm (s i)

/-- **A globally generated invertible sheaf is generated, stalk by stalk, by all its global
sections**, since some global section is nonvanishing at each point. This is what lets a free
linear system define a morphism to projective space. -/
theorem IsGloballyGenerated.generatesStalks_id {X : Scheme.{u}} {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] (hL : IsGloballyGenerated L) :
    Stacks.ProjectiveFromSections.GeneratesStalks (id : Γ(L, ⊤) → Γ(L, ⊤)) :=
  Stacks.AmpleImmersionReduction.generatesStalks_of_forall_exists_mem _ fun x =>
    (hL.exists_mem_nonvanishingLocus x).imp fun _ hσ =>
      (Stacks.NonvanishingOpen.mem_nonvanishingOpen X L _ x).2 hσ

end MMP.Intersection

namespace MMP.Mori.Internal.FreePositiveCurveDegreesAmple

/-- **Each fibre of the morphism defined by sections lies in one chart.** The image `z` of the
fibre over `y` in `ℙⁿ_ℤ` lies in some `D₊(Tⱼ)`, whose inverse image is the nonvanishing open of
`sⱼ` (`Stacks.ProjectiveFromSections.preimage_basicOpen_eq_nvCover_canonical`). -/
private theorem fiber_subset_nonvanishingLocus {X S : Scheme.{u}} {L : X.Modules}
    [Stacks.Ample.IsInvertibleModule X L] {n : ℕ} (t : Fin (n + 1) → Γ(L, ⊤))
    (ht : Stacks.ProjectiveFromSections.GeneratesStalks t) (f : X ⟶ S)
    (y : projectiveSpaceOver n S) :
    ∃ σ : Γ(L, ⊤), Stacks.ProjectiveFromSections.toProjectiveSpaceOver t ht f ⁻¹' {y} ⊆
      Stacks.Ample.nonvanishingLocus L σ := by
  have hx : projectiveSpaceOver.toIntegralAtUniverse n S y ∈ ⨆ i : Fin (n + 1),
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X i) := by
    rw [Stacks.ProjectiveChart.iSup_basicOpen_X_eq_top (ULift.{u} ℤ) n]; trivial
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.1 hx
  refine ⟨t j, fun x hxy => ?_⟩
  have hx' : x ∈ Stacks.ProjectiveFromSections.nvCover t j := by
    rw [← Stacks.ProjectiveFromSections.preimage_basicOpen_eq_nvCover_canonical t ht j,
      ← Stacks.ProjectiveFromSections.toProjectiveSpaceOver_snd t ht f]
    obtain rfl : _ = y := hxy
    exact hj
  exact (Stacks.NonvanishingOpen.mem_nonvanishingOpen X L (t j) x).1 hx'

/-- The sections of a globally generated invertible sheaf on a projective `k`-scheme define a
proper morphism to projective space pulling `𝒪(1)` back to `L`. -/
private theorem exists_toProjectiveSpaceOver_iso_pullback (k : Type u) [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (hX : IsProjectiveMorphism sX)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hL : MMP.Intersection.IsGloballyGenerated L) :
    ∃ (n : ℕ) (φ : X ⟶ projectiveSpaceOver n (Spec (.of k))), IsProper φ ∧
      Nonempty (L ≅ Stacks.AmpleLocallyClosed.pullbackModule φ
        (projectiveSpaceTwistingSheaf n (Spec (.of k)))) ∧
      ∀ y, ∃ σ : Γ(L, ⊤), φ ⁻¹' {y} ⊆ Stacks.Ample.nonvanishingLocus L σ := by
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX
  obtain ⟨n, t, ht, -⟩ := exists_fin_basis_generatesStalks_of_generatesStalks_id sX L
    hL.generatesStalks_id
  obtain ⟨θ, -⟩ := exists_iso_projectiveSpaceTwistingSheaf_toProjectiveSpaceOver t ht sX
  refine ⟨n, Stacks.ProjectiveFromSections.toProjectiveSpaceOver t ht sX, ?_, ⟨θ.symm⟩,
    fiber_subset_nonvanishingLocus t ht sX⟩
  haveI : IsProper (Stacks.ProjectiveFromSections.toProjectiveSpaceOver t ht sX ≫
      pullback.fst (terminal.from (Spec (.of k)))
        (terminal.from (projectiveSpaceAtUniverse.{u} n))) := by
    rw [Stacks.ProjectiveFromSections.toProjectiveSpaceOver_fst]; infer_instance
  exact IsProper.of_comp _ (pullback.fst (terminal.from (Spec (.of k)))
    (terminal.from (projectiveSpaceAtUniverse.{u} n)))

set_option backward.isDefEq.respectTransparency false in
/-- **A proper morphism with finite fibres over the closed points of a Jacobson target is
finite.** Over each closed point it is finite on a neighbourhood
(`AlgebraicGeometry.exists_isFinite_morphismRestrict_of_finite_preimage_singleton`), and an open
containing every closed point of a Jacobson space is everything. -/
private theorem isFinite_of_finite_preimage_closedPoints {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsProper f] [JacobsonSpace Y] (h : ∀ y ∈ closedPoints Y, (f ⁻¹' {y}).Finite) :
    IsFinite f := by
  choose V hyV hV using fun y : closedPoints Y =>
    exists_isFinite_morphismRestrict_of_finite_preimage_singleton f y.1 (h y.1 y.2)
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsFinite) V ?_ hV
  by_contra hne
  obtain ⟨y, hy, hyc⟩ := nonempty_inter_closedPoints (Z := ((iSup V : Y.Opens) : Set Y)ᶜ)
    (Set.nonempty_compl.2 fun e =>
      hne (SetLike.coe_injective (e.trans TopologicalSpace.Opens.coe_top.symm)))
    (iSup V).isOpen.isClosed_compl.isLocallyClosed
  exact hy (TopologicalSpace.Opens.mem_iSup.2 ⟨⟨y, hyc⟩, hyV _⟩)

/-- In a Noetherian quasi-sober space, a closed set all of whose points are closed is finite:
it is a finite union of irreducible closed sets, each the closure of its generic point. -/
private theorem finite_of_forall_isClosed_singleton {α : Type*} [TopologicalSpace α]
    [TopologicalSpace.NoetherianSpace α] [QuasiSober α] (F : Set α) (hF : IsClosed F)
    (h : ∀ x ∈ F, IsClosed ({x} : Set α)) : F.Finite := by
  obtain ⟨S, hS, hSc, hSi, rfl⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hF
  refine hS.sUnion fun t ht => ?_
  have hg := (hSi t ht).isGenericPoint_genericPoint_closure
  rw [(hSc t ht).closure_eq] at hg
  have hgt : (hSi t ht).genericPoint ∈ t := hg.mem
  rw [← hg.def, (h _ (Set.mem_sUnion_of_mem hgt ht)).closure_eq]
  exact Set.finite_singleton _

/-- **A closed set of a projective `k`-scheme with infinitely many points contains a closed
integral curve.** -/
private theorem exists_curve_of_infinite (k : Type u) [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (hX : IsProjectiveMorphism sX)
    (F : Set X) (hF : IsClosed F) (hinf : F.Infinite) :
    ∃ (C : Scheme.{u}) (i : C ⟶ X), IsClosedImmersion i ∧ IsIntegral C ∧
      topologicalKrullDim C = 1 ∧ Set.range i ⊆ F := by
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsNoetherian X := ⟨⟩
  obtain ⟨η, hηF, hη⟩ : ∃ η ∈ F, ¬ IsClosed ({η} : Set X) := by
    by_contra! hcl
    exact hinf (finite_of_forall_isClosed_singleton F hF hcl)
  obtain ⟨p, hp, hpc⟩ := isClosed_closure.exists_closed_singleton
    (⟨η, subset_closure rfl⟩ : (closure ({η} : Set X)).Nonempty)
  have hηp : η ⤳ p := specializes_iff_mem_closure.mpr hp
  obtain ⟨y, hηy, -, -, hy⟩ := MMP.Fourfold.exists_isProperCurve_of_specializes sX hηp hpc hpc
    rfl (fun h => hη (h ▸ hpc))
  refine ⟨MMP.Mori.curveSubschemeAt y, MMP.Mori.curveSubschemeAtι y, inferInstance,
    StacksTag09NX.isIntegral_subscheme_vanishingIdeal_of_isIrreducible
      (TopologicalSpace.Closeds.closure ({y} : Set X)) isIrreducible_singleton.closure,
    hy.dim_eq, ?_⟩
  rw [MMP.Mori.range_curveSubschemeAtι]
  exact hF.closure_subset_iff.2 (Set.singleton_subset_iff.2
    (hF.closure_subset_iff.2 (Set.singleton_subset_iff.2 hηF) (specializes_iff_mem_closure.mp hηy)))

/-- **Positive curve degrees force finite closed fibres.** If the fibre of `φ` over a closed point
were infinite it would contain a closed integral curve `C`; the image of `C` lies in one chart
`X_{sⱼ}`, so the section `sⱼ` of `L` vanishes nowhere on `C` and `deg_C L = 0`
(`MMP.Threefold.Mori.invertibleCurveDegree_pullback_eq_zero`). -/
private theorem finite_preimage_of_degreeOn_pos (k : Type u) [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (hX : IsProjectiveMorphism sX)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hdeg : ∀ (C : Scheme.{u}) (i : C ⟶ X) [IsClosedImmersion i] [IsIntegral C]
      [IsProper (i ≫ sX)] (hC : topologicalKrullDim C = 1), 0 < MMP.Mori.degreeOn k sX i hC.le L)
    (n : ℕ) (φ : X ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hfib : ∀ y, ∃ σ : Γ(L, ⊤), φ ⁻¹' {y} ⊆ Stacks.Ample.nonvanishingLocus L σ)
    (y : projectiveSpaceOver n (Spec (.of k))) (hy : y ∈ closedPoints _) :
    (φ ⁻¹' {y}).Finite := by
  haveI : IsProper sX := isProper_of_isProjectiveMorphism sX hX
  by_contra hinf
  obtain ⟨C, i, _, _, hdim, hrange⟩ := exists_curve_of_infinite k sX hX _
    ((show IsClosed {y} from hy).preimage φ.continuous) hinf
  obtain ⟨σ, hσ⟩ := hfib y
  exact (hdeg C i hdim).ne' (MMP.Threefold.Mori.invertibleCurveDegree_pullback_eq_zero sX i
    hdim.le L σ fun c => hσ (hrange ⟨c, rfl⟩))

/-- A proper morphism to `ℙᴺ_k` pulling `𝒪(1)` back to `L` is finite when `L` has positive degree
on every closed integral curve. -/
private theorem isFinite_of_degreeOn_pos (k : Type u) [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (hX : IsProjectiveMorphism sX)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hdeg : ∀ (C : Scheme.{u}) (i : C ⟶ X) [IsClosedImmersion i] [IsIntegral C]
      [IsProper (i ≫ sX)] (hC : topologicalKrullDim C = 1), 0 < MMP.Mori.degreeOn k sX i hC.le L)
    (n : ℕ) (φ : X ⟶ projectiveSpaceOver n (Spec (.of k))) (hφ : IsProper φ)
    (hfib : ∀ y, ∃ σ : Γ(L, ⊤), φ ⁻¹' {y} ⊆ Stacks.Ample.nonvanishingLocus L σ) :
    IsFinite φ := by
  haveI := hφ
  haveI := isProper_projectiveSpaceOver n (Spec (.of k))
  haveI := LocallyOfFiniteType.jacobsonSpace (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
  exact isFinite_of_finite_preimage_closedPoints φ
    (finite_preimage_of_degreeOn_pos k sX hX L hdeg n φ hfib)

end MMP.Mori.Internal.FreePositiveCurveDegreesAmple

namespace MMP.Mori

open MMP.Mori.Internal.FreePositiveCurveDegreesAmple in
/-- **Positive curve degrees make a globally generated invertible sheaf ample.** Let `X` be a
projective scheme over a field `k` (structure morphism `sX`) and `L` an invertible sheaf on `X`
generated by its global sections. If `deg_C L > 0` for every closed integral curve `i : C ⟶ X`,
then `L` is ample. -/
@[mmp "lem_mmp_free_positive_curve_degrees_ample"]
public theorem isAmple_of_isGloballyGenerated_of_degreeOn_pos (k : Type u) [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (hX : IsProjectiveMorphism sX)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hL : MMP.Intersection.IsGloballyGenerated L)
    (hdeg : ∀ (C : Scheme.{u}) (i : C ⟶ X) [IsClosedImmersion i] [IsIntegral C]
      [IsProper (i ≫ sX)] (hC : topologicalKrullDim C = 1), 0 < degreeOn k sX i hC.le L) :
    Stacks.Ample.IsAmple X L := by
  obtain ⟨n, φ, hφ, ⟨e⟩, hfib⟩ := exists_toProjectiveSpaceOver_iso_pullback k sX hX L hL
  have : IsFinite φ := isFinite_of_degreeOn_pos k sX hX L hdeg n φ hφ hfib
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mpr
    (Stacks.AmplePullback.isAmple_modulePullback_of_isAffineHom φ _
      (Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf n _))

end MMP.Mori

end FreeAmple

section Nakai

open CategoryTheory.Limits Opposite
open Stacks.SheafOfModules.Invertible (tensorPower)

namespace MMP.Mori.Internal.AlgebraicProjectiveNakai

/-! ### Comparison with the Stacks intersection number -/

section Aux

open MvPolynomial

private noncomputable def negSub {d : ℕ} : MvPolynomial (Fin d) ℚ →ₐ[ℚ] MvPolynomial (Fin d) ℚ :=
  aeval (fun i => - X i)

private theorem negSub_monomial {d : ℕ} (s : Fin d →₀ ℕ) (a : ℚ) :
    negSub (monomial s a) = monomial s (a * (-1) ^ s.sum fun _ e => e) := by
  rw [negSub, aeval_monomial, monomial_eq, Finsupp.prod_fintype _ _ (by simp),
    Finsupp.prod_fintype _ _ (by simp), Finsupp.sum_fintype _ _ (by simp)]
  have : ∀ i : Fin d, (-X i : MvPolynomial (Fin d) ℚ) ^ s i = (-1) ^ s i * X i ^ s i := by
    intro i; rw [neg_pow]
  simp only [this, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  simp [map_mul, mul_assoc, algebraMap_eq]

private theorem coeff_negSub {d : ℕ} (P : MvPolynomial (Fin d) ℚ) (s : Fin d →₀ ℕ) :
    (negSub P).coeff s = P.coeff s * (-1) ^ s.sum fun _ e => e := by
  induction P using MvPolynomial.induction_on' with
  | monomial u a =>
    rw [negSub_monomial]
    by_cases h : u = s
    · subst h; simp [coeff_monomial]
    · simp [coeff_monomial, h]
  | add p q hp hq => simp [map_add, hp, hq, add_mul]

private theorem eval_negSub {d : ℕ} (P : MvPolynomial (Fin d) ℚ) (x : Fin d → ℚ) :
    eval x (negSub P) = eval (fun i => - x i) P := by
  induction P using MvPolynomial.induction_on' with
  | monomial u a =>
    rw [negSub_monomial, eval_monomial, eval_monomial, Finsupp.prod_fintype _ _ (by simp),
      Finsupp.prod_fintype _ _ (by simp), Finsupp.sum_fintype _ _ (by simp)]
    have : ∀ i : Fin d, (-x i) ^ u i = (-1) ^ u i * x i ^ u i := by
      intro i; rw [neg_pow]
    simp only [this, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
    ring
  | add p q hp hq => simp [map_add, hp, hq]

private theorem totalDegree_negSub {d : ℕ} (P : MvPolynomial (Fin d) ℚ) :
    (negSub P).totalDegree ≤ P.totalDegree := by
  refine totalDegree_le_of_support_subset ?_
  intro s hs
  rw [mem_support_iff, coeff_negSub] at hs
  exact mem_support_iff.2 fun h => hs (by simp [h])

private theorem sum_neg_indicator {d : ℕ} (P : MvPolynomial (Fin d) ℚ) (hP : P.totalDegree ≤ d) :
    ∑ I : Finset (Fin d), (-1 : ℚ) ^ I.card *
        eval (fun j => if j ∈ I then (-1 : ℚ) else 0) P =
      P.coeff (Finsupp.equivFunOnFinite.symm fun _ => 1) := by
  have h := MvPolynomial.sum_neg_one_pow_mul_eval_indicator_eq_coeff_one (negSub P)
    ((totalDegree_negSub P).trans hP)
  rw [coeff_negSub] at h
  have hs : (Finsupp.equivFunOnFinite.symm fun _ : Fin d => 1).sum (fun _ e => e) = d := by
    rw [Finsupp.sum_fintype _ _ (by simp)]; simp
  rw [hs] at h
  have e1 : ∀ I : Finset (Fin d), eval (fun j => if j ∈ I then (1 : ℚ) else 0) (negSub P) =
      eval (fun j => if j ∈ I then (-1 : ℚ) else 0) P := by
    intro I; rw [eval_negSub]
    have : (fun j => -(if j ∈ I then (1 : ℚ) else 0)) = fun j => if j ∈ I then (-1 : ℚ) else 0 := by
      funext j; split_ifs <;> simp
    rw [this]
  simp only [e1] at h
  have : ∀ I : Finset (Fin d), (-1 : ℚ) ^ (d - I.card) = (-1) ^ d * (-1) ^ I.card := by
    intro I
    have hI : I.card ≤ d := by simpa using Finset.card_le_univ I
    have : (-1 : ℚ) ^ d = (-1) ^ (d - I.card) * (-1) ^ I.card := by
      rw [← pow_add]; congr 1; omega
    rw [this, mul_assoc, ← pow_add, ← two_mul, pow_mul]; simp
  simp only [this, mul_assoc, ← Finset.mul_sum] at h
  have h2 : ((-1 : ℚ) ^ d) * ((-1) ^ d) = 1 := by rw [← pow_add, ← two_mul, pow_mul]; simp
  linear_combination ((-1:ℚ)^d) * h - (∑ I : Finset (Fin d), (-1 : ℚ) ^ I.card *
        eval (fun j => if j ∈ I then (-1 : ℚ) else 0) P -
      P.coeff (Finsupp.equivFunOnFinite.symm fun _ => 1)) * h2

private theorem sheafIntersectionNumber_eq_intersectionNumber (k : Type u) [Field k]
    {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (i : Z ⟶ X) [IsClosedImmersion i]
    (d : ℕ) (hd : topologicalKrullDim Z ≤ d) (L : Fin d → X.Modules)
    [∀ j, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L j)] :
    MMP.Mori.sheafIntersectionNumber k f i d hd L =
      AlgebraicGeometry.intersectionNumber k f i d hd L := by
  have hc := Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k (i ≫ f)
  obtain ⟨P, hP0, hP⟩ := exists_eulerPolynomial_twistedSheaf_of_isProper k (i ≫ f)
    (fun j => (Scheme.Modules.pullback i).obj (L j)) (SheafOfModules.unit Z.ringCatSheaf) hc
  have hdeg : P.totalDegree ≤ d := by
    rcases hP0 with rfl | h
    · simp
    · exact_mod_cast h.trans ((topologicalKrullDim_subspace_le Z _).trans hd)
  have hcoeff := AlgebraicGeometry.intersectionNumber_eq_coeff k f i d hd L P
    (fun n => by rw [hP n]) hdeg
  apply Int.cast_injective (α := ℚ)
  rw [hcoeff, ← sum_neg_indicator P hdeg]
  unfold MMP.Mori.sheafIntersectionNumber
  push_cast
  refine Finset.sum_congr rfl fun I _ => ?_
  congr 1
  have h := hP fun j => if j ∈ I then (-1 : ℤ) else 0
  rw [show (fun j : Fin d => (((if j ∈ I then (-1 : ℤ) else 0) : ℤ) : ℚ)) =
        fun j : Fin d => if j ∈ I then (-1 : ℚ) else 0 from
      funext fun j => by split_ifs <;> simp] at h
  rw [h]

end Aux

section Twist

open Stacks.SheafOfModules.Invertible

/-- **Integer tensor powers depend only on the isomorphism class of the invertible module.**
An isomorphism `M ≅ N` makes the two tensoring autoequivalences `- ⊗ M` and `- ⊗ N` objectwise
isomorphic, and `Stacks.Equivalence.powIntertwineObj` carries that to every integer iterate,
the negative ones through the quasi-inverses. -/
private noncomputable def tensorPowerIsoOfIso {X : Scheme.{u}} (M N : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N] (e : M ≅ N) (m : ℤ) :
    tensorPower X.presheaf X.ringCatSheaf.2 M m ≅
      tensorPower X.presheaf X.ringCatSheaf.2 N m :=
  Stacks.Equivalence.powIntertwineObj
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _ X.presheaf
          (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).flip.obj M).asEquivalence
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _ X.presheaf
          (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).flip.obj N).asEquivalence (𝟭 _)
    (fun A => ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _ X.presheaf
          (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).obj A).mapIso e) m
    (SheafOfModules.unit _)

end Twist

section Restrict

open Stacks.SheafOfModules.Invertible

/-- Isomorphic families of invertible modules give isomorphic twists. -/
private noncomputable def twistListFamilyIso {X : Scheme.{u}} {r : ℕ} (L L' : Fin r → X.Modules)
    [∀ i, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L i)]
    [∀ i, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L' i)]
    (e : ∀ i, L i ≅ L' i) (n : Fin r → ℤ) :
    ∀ (l : List (Fin r)) {M M' : X.Modules}, (M ≅ M') →
      (twistList L n l M ≅ twistList L' n l M')
  | [], _, _, ε => ε
  | i :: t, _, _, ε => twistListFamilyIso L L' e n t
      (tensorProductIso X.presheaf X.ringCatSheaf.2 ε
        (tensorPowerIsoOfIso (L i) (L' i) (e i) (n i)))

/-- **Intersection numbers along a closed subscheme are computed on it**: for closed
immersions `j : Z ⟶ W` and `i : W ⟶ X`, `(i^*L₁ ⋯ i^*L_d · Z)_W = (L₁ ⋯ L_d · Z)_X`. -/
private theorem intersectionNumber_pullback_comp (k : Type u) [Field k] {X W Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (i : W ⟶ X) [IsClosedImmersion i] (j : Z ⟶ W)
    [IsClosedImmersion j] (d : ℕ) (hd : topologicalKrullDim Z ≤ d) (L : Fin d → X.Modules)
    [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L q)] :
    intersectionNumber k (i ≫ f) j d hd (fun q => (Scheme.Modules.pullback i).obj (L q)) =
      intersectionNumber k f (j ≫ i) d hd L := by
  unfold intersectionNumber
  refine Finset.sum_congr rfl fun T _ => ?_
  congr 1
  refine finsum_congr fun n => ?_
  congr 2
  rw [← Category.assoc]
  exact finrank_cohomologyOverField_eq_of_iso k _
    (twistListFamilyIso (fun q => (Scheme.Modules.pullback j).obj
        ((Scheme.Modules.pullback i).obj (L q)))
      (fun q => (Scheme.Modules.pullback (j ≫ i)).obj (L q))
      (fun q => (Scheme.Modules.pullbackComp j i).app (L q)) _ _ (Iso.refl _)) n

end Restrict

private theorem isProjective_comp {X Z S : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (f : X ⟶ S) (hf : IsProjective f) : IsProjective (i ≫ f) := by
  obtain ⟨E, h1, h2, hqc, i', hi', hcomp⟩ := hf
  exact ⟨E, h1, h2, hqc, i ≫ i', inferInstance, by rw [Category.assoc, hcomp]⟩

/-! ### Tensor powers -/

/-- The pullback of a tensor power of an invertible sheaf is invertible. -/
private theorem isInvertible_pullback_tensorPower {X Z : Scheme.{u}} (i : Z ⟶ X) (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M] (n : ℤ) :
    SheafOfModules.IsInvertible Z.presheaf Z.ringCatSheaf.2
      ((Scheme.Modules.pullback i).obj (tensorPower X.presheaf X.ringCatSheaf.2 M n)) :=
  SheafOfModules.isInvertible_pullback i _

attribute [local instance] isInvertible_pullback_tensorPower

/-- A module isomorphic to a positive tensor power of `N` is ample exactly when `N` is. -/
private theorem isAmple_tensorPower_iff {Y : Scheme.{u}} (N P : Y.Modules)
    [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 N]
    [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 P] (a : ℕ) (ha : 1 ≤ a)
    (e : P ≅ tensorPower Y.presheaf Y.ringCatSheaf.2 N a) :
    Stacks.Ample.IsAmple Y P ↔ Stacks.Ample.IsAmple Y N := by
  rw [Stacks.AmplePositivePower.isAmple_iff_isAmple_tensorPowModule N a ha]
  exact Stacks.RelativeVeryAmple.isAmple_congr _ _
    (e ≪≫ Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso Y N a)

/-! ### Ampleness is checked on the integral closed subschemes -/

/-- The cohomology over `k` vanishes exactly when the cohomology of global sections does: the
two have the same underlying group. -/
private theorem isZero_rightDerived_iff (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (F : X.Modules) (p : ℕ) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj F) ↔
      IsZero (cohomologyOverField k f F p) := by
  rw [ModuleCat.isZero_iff_subsingleton, ModuleCat.isZero_iff_subsingleton]
  rfl

/-- **Ampleness is checked on the integral closed subschemes.** If the restriction of `L` to
every integral closed subscheme of a scheme `X` proper over `k` is ample, then `L` is ample:
by the dévissage of coherent sheaves, the higher cohomology of `F ⊗ L^n` vanishes for `n ≫ 0`
for every coherent `F`, and the cohomological criterion applies. -/
private theorem isAmple_of_forall_isIntegral (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (h : ∀ (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [IsIntegral Z],
      Stacks.Ample.IsAmple Z ((Scheme.Modules.pullback i).obj L)) :
    Stacks.Ample.IsAmple X L := by
  classical
  haveI : IsNoetherian X :=
    Stacks.AlgebraicGeometry.ComponentDegrees.isNoetherian_of_isProper_over_field k f
  let P : X.Modules → Prop := fun F => ∃ n₀ : ℕ, ∀ n p : ℕ, n₀ ≤ n → 0 < p →
    IsZero (cohomologyOverField k f (twistedSheaf F (fun _ : Fin 1 => L) (fun _ => (n : ℤ))) p)
  have hP : ∀ F : X.Modules, SheafOfModules.IsCoherent F → P F := by
    refine Stacks.AlgebraicGeometry.CoherentDevissage.property_of_isCoherent X P ?_ ?_ ?_
    · refine ⟨0, fun n p _ _ => isZero_cohomologyOverField_of_isZero k f ?_ p⟩
      rw [← twistedSheafFunctor_obj]
      exact (twistedSheafFunctor (fun _ : Fin 1 => L) (fun _ => (n : ℤ))).map_isZero
        Stacks.AlgebraicGeometry.CoherentDevissage.isZero_terminal
    · rintro S hS - - - ⟨n₁, h₁⟩ ⟨n₃, h₃⟩
      refine ⟨max n₁ n₃, fun n p hn hp => ?_⟩
      have hS' := shortExact_map_twistedSheafFunctor (fun _ : Fin 1 => L) hS (fun _ => (n : ℤ))
      have h := isZero_cohomologyOverField_of_shortExact k f hS' p
        (by rw [ShortComplex.map_X₁, twistedSheafFunctor_obj]
            exact h₁ n p ((le_max_left _ _).trans hn) hp)
        (by rw [ShortComplex.map_X₃, twistedSheafFunctor_obj]
            exact h₃ n p ((le_max_right _ _).trans hn) hp)
      rwa [ShortComplex.map_X₂, twistedSheafFunctor_obj] at h
    · intro Z i _ _ I hI
      haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (i ≫ f)
      haveI : I.toSheafOfModules.IsQuasicoherent := hI
      haveI : @Mono Z.Modules _ _ _ I.ι := inferInstanceAs (Mono I.ι)
      have hIc : SheafOfModules.IsCoherent I.toSheafOfModules :=
        Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_of_mono_of_isQuasicoherent
          (Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k (i ≫ f)) I.ι
      have hZ := Stacks.PowerFamilyBridge.modulesIsAmple_of_isAmple Z _ (h Z i)
      obtain ⟨n₀, hn₀⟩ := Scheme.Modules.hasEventualTwistCohomologyVanishing_of_isAmple
        ((Scheme.Modules.pullback i).obj L) (i ≫ f) hZ I.toSheafOfModules hIc
      refine ⟨n₀, fun n p hn hp => ?_⟩
      refine IsZero.of_iso ?_ (cohomologyOverFieldIso k f
        (pushforwardTwistedSheafIso i (fun _ : Fin 1 => L) I.toSheafOfModules
          (fun _ => (n : ℤ))) p)
      refine IsZero.of_iso ?_ (cohomologyOverFieldPushforwardIsoOfIsClosedImmersion k i f _ p).symm
      exact (isZero_rightDerived_iff k (i ≫ f) _ p).1 (hn₀ n p hn hp)
  apply Stacks.PowerFamilyBridge.isAmple_of_modulesIsAmple
  refine Scheme.Modules.isAmple_of_eventualTwistVanishing L f fun F hF => ?_
  obtain ⟨n₀, hn₀⟩ := hP F hF
  exact ⟨n₀, fun n p hn hp => (isZero_rightDerived_iff k f _ p).2 (hn₀ n p hn hp)⟩

/-! ### The ideal sheaf sequence of a closed immersion, twisted by an invertible sheaf -/

section IdealSequence

attribute [local instance] HasDerivedCategory.standard

/-- The comorphism `𝒪_X ⟶ i_*𝒪_Z` of a closed immersion. -/
private noncomputable abbrev comorph {X Z : Scheme.{u}} (i : Z ⟶ X) :=
  SheafOfModules.unitToPushforwardObjUnit
    (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)

/-- Tensoring on the left by `Q`. -/
private noncomputable abbrev tensL {X : Scheme.{u}} (Q : X.Modules) :=
  (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).obj Q

/-- **The third term of the twisted ideal sequence is computed on `Z`**:
`Hᵖ(X, Q ⊗ i_*𝒪_Z) ≅ Hᵖ(Z, i^*Q)`. -/
private noncomputable def cohomologyTwistPushforwardIso (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (i : Z ⟶ X) [IsClosedImmersion i] (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] (p : ℕ) :
    cohomologyOverField k f ((tensL Q).obj
        ((Scheme.Modules.pushforward i).obj (SheafOfModules.unit Z.ringCatSheaf))) p ≅
      cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj Q) p :=
  cohomologyOverFieldIso k f
    (Stacks.SheafOfModules.Invertible.tensorProductBraiding X.presheaf X.ringCatSheaf.2 Q
       ((Scheme.Modules.pushforward i).obj (SheafOfModules.unit Z.ringCatSheaf)) ≪≫
      Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
        (Stacks.SheafOfModules.Invertible.tensorPowerOneIso X.presheaf X.ringCatSheaf.2 Q).symm ≪≫
      pushforwardTwistedSheafIso i (fun _ : Fin 1 => Q) (SheafOfModules.unit Z.ringCatSheaf)
        (fun _ => 1)) p ≪≫
    (cohomologyOverFieldPushforwardIsoOfIsClosedImmersion k i f _ p).symm ≪≫
    cohomologyOverFieldIso k (i ≫ f)
      (Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor Z.presheaf Z.ringCatSheaf.2 _ ≪≫
        Stacks.SheafOfModules.Invertible.tensorPowerOneIso Z.presheaf Z.ringCatSheaf.2 _) p

/-- The second term of the twisted ideal sequence is `Q`. -/
private theorem finrank_tensL_unit (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] (p : ℕ) :
    Module.finrank k (cohomologyOverField k f ((tensL Q).obj
        (SheafOfModules.unit (structureSheafRing X.toSheafedSpace))) p) =
      Module.finrank k (cohomologyOverField k f Q p) :=
  finrank_cohomologyOverField_eq_of_iso k f
    (Stacks.SheafOfModules.Invertible.tensorProductRightUnitor X.presheaf X.ringCatSheaf.2 Q) p

/-- **`Hᵖ(X, Q ⊗ ℐ) ⟶ Hᵖ(X, Q)` is surjective when `Hᵖ(Z, i^*Q) = 0`.** -/
private theorem surjective_cohomology_ideal (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (i : Z ⟶ X) [IsClosedImmersion i] (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] (p : ℕ)
    (h : IsZero (cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj Q) p)) :
    Function.Surjective
      (cohomologyOverFieldMap k f ((tensL Q).map (kernel.ι (comorph i))) p) := by
  have hS := Stacks.Cohomology.AmpleH1.shortExact_map_tensorLeft X Q
    (Stacks.Cohomology.AmpleH1.shortExact_idealSheaf i)
  obtain ⟨d, -, hex, -, -⟩ := exists_cohomologyOverField_longExactSequence k f hS
  have h3 := ModuleCat.subsingleton_of_isZero (h.of_iso (cohomologyTwistPushforwardIso k f i Q p))
  exact fun y => (hex p y).1 (@Subsingleton.elim _ h3 _ _)

/-- **`Hᵖ(X, Q) ≤ Hᵖ(X, Q ⊗ ℐ)` in dimension when `Hᵖ(Z, i^*Q) = 0`.** -/
private theorem finrank_le_finrank_ideal (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (i : Z ⟶ X) [IsClosedImmersion i] (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] (p : ℕ)
    (hfin : FiniteDimensional k
      (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) p))
    (h : IsZero (cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj Q) p)) :
    Module.finrank k (cohomologyOverField k f Q p) ≤
      Module.finrank k (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) p) := by
  have hsurj := surjective_cohomology_ideal k f i Q p h
  rw [← finrank_tensL_unit k f Q p]
  calc _ = Module.finrank k (LinearMap.range
          (cohomologyOverFieldMap k f ((tensL Q).map (kernel.ι (comorph i))) p).hom) := by
        rw [LinearMap.range_eq_top.2 hsurj, finrank_top]
    _ ≤ _ := @LinearMap.finrank_range_le k _ _ _ _ _ _ _ _ hfin _

/-- **`Hᵖ⁺¹(X, Q ⊗ ℐ) ≤ Hᵖ⁺¹(X, Q)` in dimension when `Hᵖ(Z, i^*Q) = 0`.** -/
private theorem finrank_ideal_succ_le (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (i : Z ⟶ X) [IsClosedImmersion i] (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] (p : ℕ)
    (hfin : FiniteDimensional k (cohomologyOverField k f Q (p + 1)))
    (h : IsZero (cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj Q) p)) :
    Module.finrank k (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) (p + 1)) ≤
      Module.finrank k (cohomologyOverField k f Q (p + 1)) := by
  have hS := Stacks.Cohomology.AmpleH1.shortExact_map_tensorLeft X Q
    (Stacks.Cohomology.AmpleH1.shortExact_idealSheaf i)
  obtain ⟨d, -, -, -, hdf⟩ := exists_cohomologyOverField_longExactSequence k f hS
  have h3 := ModuleCat.subsingleton_of_isZero (h.of_iso (cohomologyTwistPushforwardIso k f i Q p))
  have hinj : Function.Injective
      (cohomologyOverFieldMap k f ((tensL Q).map (kernel.ι (comorph i))) (p + 1)) := by
    rw [← LinearMap.ker_eq_bot (f := (cohomologyOverFieldMap k f
      ((tensL Q).map (kernel.ι (comorph i))) (p + 1)).hom)]
    refine (Submodule.eq_bot_iff _).2 fun x hx => ?_
    obtain ⟨y, rfl⟩ := (hdf p x).1 hx
    obtain rfl : y = 0 := @Subsingleton.elim _ h3 y 0
    exact LinearMap.map_zero _
  have hfin' : FiniteDimensional k (cohomologyOverField k f ((tensL Q).obj
      (SheafOfModules.unit (structureSheafRing X.toSheafedSpace))) (p + 1)) :=
    LinearEquiv.finiteDimensional (cohomologyOverFieldIso k f
      (Stacks.SheafOfModules.Invertible.tensorProductRightUnitor X.presheaf
        X.ringCatSheaf.2 Q) (p + 1)).toLinearEquiv.symm
  rw [← finrank_tensL_unit k f Q (p + 1)]
  exact @LinearMap.finrank_le_finrank_of_injective k _ _ _ _ _ _ _ _ hfin' _ hinj

/-- **A monomorphism on `R¹F` of the first map makes `F` surjective on the last one.** For an
additive left exact `F` and a short exact sequence `0 ⟶ A ⟶ B ⟶ C ⟶ 0`, the long exact sequence
`F(B) ⟶ F(C) ⟶ R¹F(A) ⟶ R¹F(B)` shows that `F(B) ⟶ F(C)` is epi once `R¹F(A) ⟶ R¹F(B)` is
mono. -/
private theorem epi_map_g_of_mono_rightDerived_one {C D : Type*} [Category* C] [Category* D]
    [Abelian C] [Abelian D] [HasDerivedCategory C] [HasDerivedCategory D] [EnoughInjectives C]
    (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F] {S : ShortComplex C} (hS : S.ShortExact)
    (h₁ : Mono ((F.rightDerived 1).map S.f)) : Epi (F.map S.g) := by
  set E := Stacks.DerivedIndexing.rightDerivedDeltaFunctorOfEnoughInjectives F
  have h₁' : Mono ((E.functor 1).map S.f) := h₁
  have hδ : E.δ hS 0 = 0 := (E.exact_δ₂ hS 0).mono_g_iff.1 h₁'
  have hepi : Epi ((F.rightDerived 0).map S.g) :=
    (ShortComplex.exact_iff_epi _ hδ).1 (E.exact_δ₁ hS 0)
  rw [← NatIso.naturality_1 F.rightDerivedZeroIsoSelf S.g]
  infer_instance

/-- `F.map f` is epi if `F.map (f ≫ g)` is and `g` is an isomorphism. -/
private theorem epi_map_of_comp_eq_of_isIso {C D : Type*} [Category C] [Category D]
    (F : C ⥤ D) {A B B' : C} (f : A ⟶ B) (g : B ⟶ B') (h : A ⟶ B') (hfg : f ≫ g = h)
    (hg : IsIso g) (hh : Epi (F.map h)) : Epi (F.map f) := by
  rw [← hfg, F.map_comp] at hh
  exact (epi_comp_iff_of_isIso _ _).1 hh

/-- In a commutative square `f ≫ g = h ≫ k` with `g`, `k` isomorphisms, `F.map h` is epi if
`F.map f` is. -/
private theorem epi_map_of_comm_sq_of_isIso {C D : Type*} [Category C] [Category D]
    (F : C ⥤ D) {A B B' A' : C} (f : A ⟶ B) (g : B ⟶ B') (h : A ⟶ A') (k : A' ⟶ B')
    (hfg : f ≫ g = h ≫ k) (hg : IsIso g) (hk : IsIso k) (hf : Epi (F.map f)) :
    Epi (F.map h) :=
  epi_map_of_comp_eq_of_isIso F h k _ hfg.symm hk (by rw [F.map_comp]; infer_instance)

/-- In a commutative square `h ≫ k = f ≫ g` with `g` an isomorphism, `F.map k` is epi if
`F.map f` is. -/
private theorem epi_map_of_comm_sq_of_isIso_right {C D : Type*} [Category C] [Category D]
    (F : C ⥤ D) {A A' B M : C} (h : A ⟶ A') (k : A' ⟶ B) (f : A ⟶ M) (g : M ⟶ B)
    (hfg : h ≫ k = f ≫ g) (hg : IsIso g) (hf : Epi (F.map f)) : Epi (F.map k) := by
  have : Epi (F.map h ≫ F.map k) := by rw [← F.map_comp, hfg, F.map_comp]; infer_instance
  exact epi_of_epi (F.map h) (F.map k)

private theorem epi_globalSections_unit_app_unit_of_epi {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i]
    (P : _root_.SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X.toRingedSpace).property P]
    (hepi : Epi ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj
      (P)) ⋙ AlgebraicGeometry.moduleGlobalSections X).map
      (_root_.SheafOfModules.unitToPushforwardObjUnit
        (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)))) :
    Epi ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj
      (P)) ⋙ AlgebraicGeometry.moduleGlobalSections X).map
      ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction i.toLRSHom.toShHom).unit.app
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))))) := by
  let : (_root_.SheafOfModules.pushforward
      (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)).IsRightAdjoint :=
    RingedSpaceModuleAdjunction.modulePushforward_isRightAdjoint i.toLRSHom.toShHom
  let : (RingedSpaceModuleAdjunction.modulePullback i.toLRSHom.toShHom).IsLeftAdjoint :=
    ⟨_, ⟨RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction i.toLRSHom.toShHom⟩⟩
  let : (TopologicalSpace.Opens.map i.toLRSHom.toShHom.hom.base).Final :=
    CategoryTheory.final_of_representablyFlat _
  have hIso2 : IsIso ((RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).map
      (_root_.SheafOfModules.pullbackObjUnitToUnit
        (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom))) := inferInstance
  exact epi_map_of_comp_eq_of_isIso
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj (P)) ⋙
      AlgebraicGeometry.moduleGlobalSections X) _ _ _
    (Stacks.Cohomology.AmpleH1.unit_app_unit_comp i) hIso2 hepi

private theorem epi_globalSections_unit_app_tensor_unit_of_epi {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i]
    (P : _root_.SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X.toRingedSpace).property P]
    (hepi : Epi ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj
      (P)) ⋙ AlgebraicGeometry.moduleGlobalSections X).map
      (_root_.SheafOfModules.unitToPushforwardObjUnit
        (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)))) :
    Epi ((AlgebraicGeometry.moduleGlobalSections X).map
      ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction i.toLRSHom.toShHom).unit.app
        ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj (P))).obj
          (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))))) := by
  have hc : IsIso ((Stacks.RingedSpace.comparisonNatTrans i.toLRSHom.toShHom).app
      (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)), P)) :=
    inferInstance
  have hk : IsIso ((RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).map
      ((Stacks.RingedSpace.comparisonNatTrans i.toLRSHom.toShHom).app
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)), P))) :=
    ((RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).mapIso
      (@asIso _ _ _ _ ((Stacks.RingedSpace.comparisonNatTrans i.toLRSHom.toShHom).app
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)), P))
          hc)).isIso_hom
  refine epi_map_of_comm_sq_of_isIso (AlgebraicGeometry.moduleGlobalSections X)
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj (P))).map
      ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
        i.toLRSHom.toShHom).unit.app
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))))
    (Stacks.AffineProjectionFormula.closedImmersionProjectionFormulaIso i
      ((Stacks.RingedSpace.pullbackFunctor i.toLRSHom.toShHom).obj
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))) P).hom
    _ _ ?_ (Iso.isIso_hom _) hk
    (epi_globalSections_unit_app_unit_of_epi i P hepi)
  have h := (Stacks.AffineProjectionFormula.closedImmersionProjectionFormulaIso_hom_natural_unit
    i (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))) P).trans
      ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
        i.toLRSHom.toShHom).homEquiv_unit _ _ _)
  let tensor := Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf
  let unitMap :=
    (RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
      i.toLRSHom.toShHom).unit.app
      (_root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
  have identityLaw :=
    (congrArg (fun arrow => (tensor.map unitMap).app P ≫ arrow)
      ((tensor.obj ((RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).obj
        ((RingedSpaceModuleAdjunction.modulePullback i.toLRSHom.toShHom).obj
          (_root_.SheafOfModules.unit
            (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))))).map_id P)).trans
      (Category.comp_id ((tensor.map unitMap).app P))
  exact (congrArg (· ≫ _) identityLaw.symm).trans h

/-- **Surjectivity of global sections of `P ⊗ 𝒪_X ⟶ P ⊗ i_*𝒪_Z` gives surjectivity of
`Γ(X, P) ⟶ Γ(Z, i^*P)`**, through the projection formula; this is the iso-transport part of
`Stacks.Cohomology.AmpleH1.epi_globalSections_map_unit_app`, from an epimorphism rather than from
the vanishing of the obstruction group. -/
private theorem epi_globalSections_map_unit_app_of_epi {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i]
    (P : _root_.SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X.toRingedSpace).property P]
    (hepi : Epi ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj
      (P)) ⋙ AlgebraicGeometry.moduleGlobalSections X).map
      (_root_.SheafOfModules.unitToPushforwardObjUnit
        (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)))) :
    Epi ((AlgebraicGeometry.moduleGlobalSections X).map
      ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
        i.toLRSHom.toShHom).unit.app P)) := by
  have hstep3 := epi_globalSections_unit_app_tensor_unit_of_epi i P hepi
  -- the unit at `P`
  have hu : (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj
      (P))).obj
      (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))) ≅ P :=
    Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor X.presheaf
      (structureSheafRing X.toRingedSpace).property P
  have hg : IsIso ((RingedSpaceModuleAdjunction.modulePullback i.toLRSHom.toShHom ⋙
      RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).map hu.hom) :=
    ((RingedSpaceModuleAdjunction.modulePullback i.toLRSHom.toShHom ⋙
      RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).mapIso hu).isIso_hom
  refine epi_map_of_comm_sq_of_isIso_right (AlgebraicGeometry.moduleGlobalSections X)
    hu.hom _
    ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction i.toLRSHom.toShHom).unit.app
      ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).flip.obj (P))).obj
        (_root_.SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))))
    ((RingedSpaceModuleAdjunction.modulePullback i.toLRSHom.toShHom ⋙
      RingedSpaceModuleAdjunction.modulePushforward i.toLRSHom.toShHom).map hu.hom) ?_ hg hstep3
  exact (RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    i.toLRSHom.toShHom).unit.naturality hu.hom

/-- **Sections of `i^*Q` lift to `X` when `H¹(X, Q ⊗ ℐ) ⟶ H¹(X, Q)` is injective**, which is
read off dimensions: `H¹(Z, i^*Q) = 0` makes it surjective, and the two groups have the same
finite dimension. -/
private theorem surjective_pullbackGlobalSection_of_finrank (k : Type u) [Field k]
    {X Z : Scheme.{u}} (f : X ⟶ Spec (.of k)) (i : Z ⟶ X) [IsClosedImmersion i] (Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q]
    (h1 : IsZero (cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj Q) 1))
    (hfin₁ : FiniteDimensional k
      (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) 1))
    (hfin₂ : FiniteDimensional k (cohomologyOverField k f Q 1))
    (hle : Module.finrank k (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) 1) ≤
      Module.finrank k (cohomologyOverField k f Q 1)) :
    Function.Surjective (Stacks.NonvanishingPullback.pullbackGlobalSection i Q) := by
  have hsurj := surjective_cohomology_ideal k f i Q 1 h1
  have hfin₂' : FiniteDimensional k (cohomologyOverField k f ((tensL Q).obj
      (SheafOfModules.unit (structureSheafRing X.toSheafedSpace))) 1) :=
    LinearEquiv.finiteDimensional (cohomologyOverFieldIso k f
      (Stacks.SheafOfModules.Invertible.tensorProductRightUnitor X.presheaf
        X.ringCatSheaf.2 Q) 1).toLinearEquiv.symm
  have hge := finrank_le_finrank_ideal k f i Q 1 hfin₁ h1
  have heq : Module.finrank k (cohomologyOverField k f ((tensL Q).obj (kernel (comorph i))) 1) =
      Module.finrank k (cohomologyOverField k f ((tensL Q).obj
        (SheafOfModules.unit (structureSheafRing X.toSheafedSpace))) 1) := by
    rw [finrank_tensL_unit k f Q 1]; omega
  have hinj := (@LinearMap.injective_iff_surjective_of_finrank_eq_finrank k _ _ _ _ _ _ _
    hfin₁ hfin₂' heq _).2 hsurj
  have hmono : Mono (((SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))).rightDerived
      1).map ((tensL Q).map (kernel.ι (comorph i)))) := by
    refine (ModuleCat.mono_iff_injective _).2 fun a b hab => hinj ?_
    unfold cohomologyOverFieldMap
    exact hab
  have hS := Stacks.Cohomology.AmpleH1.shortExact_map_tensorLeft X Q
    (Stacks.Cohomology.AmpleH1.shortExact_idealSheaf i)
  have hepi' := epi_map_g_of_mono_rightDerived_one
    (SheafOfModules.evaluation X.ringCatSheaf (op (⊤ : X.Opens))) hS hmono
  have hepi : Epi ((moduleGlobalSections X).map ((tensL Q).map (comorph i))) := hepi'
  have h2 := Stacks.Cohomology.AmpleH1.epi_tensorRight_map_of_tensorLeft X Q (comorph i) hepi
  have h3 := epi_globalSections_map_unit_app_of_epi i Q h2
  rw [ModuleCat.epi_iff_surjective] at h3
  exact h3

end IdealSequence

/-! ### Global generation from nonvanishing sections -/

/-- **An invertible sheaf with a nonvanishing global section through every point is globally
generated**: near `x`, a section `σ` nonvanishing at `x` generates the stalk
(`Stacks.SectionProduct.exists_smul_Γgerm`), and the germ identity spreads to a neighbourhood. -/
private theorem isGloballyGenerated_of_forall_mem_nonvanishingLocus {X : Scheme.{u}}
    (F : X.Modules) [Stacks.Ample.IsInvertibleModule X F]
    (h : ∀ x : X, ∃ σ : Γ(F, ⊤), x ∈ Stacks.Ample.nonvanishingLocus F σ) :
    MMP.Intersection.IsGloballyGenerated F := by
  intro x _ U hxU t
  obtain ⟨σ, hσ⟩ := h x
  obtain ⟨r, hr⟩ := Stacks.SectionProduct.exists_smul_Γgerm F σ hσ
    ((F.presheaf.germ U x hxU).hom t)
  obtain ⟨V, hxV, a, rfl⟩ := TopCat.Presheaf.germ_exist X.presheaf r
  have hxUV : x ∈ U ⊓ V := ⟨hxU, hxV⟩
  set b : Γ(X, U ⊓ V) := X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op a with hb
  set τ : Γ(F, U ⊓ V) := F.presheaf.map (homOfLE (le_top : U ⊓ V ≤ ⊤)).op σ with hτ
  have hgerm : (F.presheaf.germ U x hxU).hom t = (F.presheaf.germ (U ⊓ V) x hxUV).hom (b • τ) := by
    rw [hr, Stacks.ModuleStalk.germ_smul, hb, hτ]
    congr 1
    · exact (TopCat.Presheaf.germ_res_apply X.presheaf _ x hxUV a).symm
    · exact (TopCat.Presheaf.germ_res_apply F.presheaf _ x hxUV σ).symm
  obtain ⟨W, hxW, iU, iV, heq⟩ := TopCat.Presheaf.germ_eq F.presheaf x hxU hxUV _ _ hgerm
  refine ⟨W, leOfHom iU, hxW, 1, fun _ => σ, fun _ => X.presheaf.map iV.op b, ?_⟩
  rw [Fin.sum_univ_one]
  have h1 : homOfLE (leOfHom iU) = iU := Subsingleton.elim _ _
  rw [h1]
  refine heq.trans ?_
  have h2 := PresheafOfModules.map_smul F.val iV.op b τ
  refine h2.trans ?_
  congr 1
  rw [hτ]
  change (F.presheaf.map (homOfLE (le_top : U ⊓ V ≤ ⊤)).op ≫ F.presheaf.map iV.op) σ = _
  rw [← F.presheaf.map_comp]
  rfl

/-- A nonincreasing sequence of natural numbers from `N` on is constant at some step. -/
private theorem exists_eq_of_antitone_from (h : ℕ → ℕ) (N : ℕ)
    (hmono : ∀ j, N ≤ j → h (j + 1) ≤ h j) : ∃ j, N ≤ j ∧ h (j + 1) = h j := by
  by_contra hne
  push Not at hne
  have hlt : ∀ j, N ≤ j → h (j + 1) < h j := fun j hj =>
    lt_of_le_of_ne (hmono j hj) (hne j hj)
  have key : ∀ t : ℕ, h (N + t) + t ≤ h N := by
    intro t
    induction t with
    | zero => simp
    | succ t ih =>
      have := hlt (N + t) (by omega)
      show h (N + t + 1) + (t + 1) ≤ h N
      omega
  have := key (h N + 1)
  omega

/-- **Serre vanishing on a closed subscheme on which `M` is ample**:
`Hᵖ(Z, i^*M^{⊗ j}) = 0` for `p > 0` and `j ≫ 0`. -/
private theorem eventually_isZero_cohomology_pullback (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (i : Z ⟶ X) [IsClosedImmersion i] (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    (hM : Stacks.Ample.IsAmple Z ((Scheme.Modules.pullback i).obj M)) :
    ∃ n₀ : ℕ, ∀ j : ℕ, n₀ ≤ j → ∀ p : ℕ, 0 < p →
      IsZero (cohomologyOverField k (i ≫ f) ((Scheme.Modules.pullback i).obj
        (tensorPower X.presheaf X.ringCatSheaf.2 M j)) p) := by
  obtain ⟨n₀, h⟩ := Scheme.Modules.hasEventualTwistCohomologyVanishing_of_isAmple
    ((Scheme.Modules.pullback i).obj M) (i ≫ f)
    (Stacks.PowerFamilyBridge.modulesIsAmple_of_isAmple Z _ hM) _
    (Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k (i ≫ f))
  refine ⟨n₀, fun j hj p hp => ?_⟩
  refine ((isZero_rightDerived_iff k (i ≫ f) _ p).1 (h j p hj hp)).of_iso
    (cohomologyOverFieldIso k (i ≫ f) ?_ p)
  exact Scheme.Modules.pullbackTensorPowerIntIso i M j ≪≫
    (Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor Z.presheaf Z.ringCatSheaf.2 _).symm

/-- **Serre generation on a closed subscheme on which `M` is ample**: for `j ≫ 0` every point of
`Z` lies in the nonvanishing locus of a global section of `i^*M^{⊗ j}`. -/
private theorem eventually_exists_mem_nonvanishingLocus (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (i : Z ⟶ X) [IsClosedImmersion i]
    (M : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    (hM : Stacks.Ample.IsAmple Z ((Scheme.Modules.pullback i).obj M)) :
    ∃ n₀ : ℕ, ∀ j : ℕ, n₀ ≤ j → ∀ x : Z,
      ∃ t : Γ((Scheme.Modules.pullback i).obj (tensorPower X.presheaf X.ringCatSheaf.2 M j), ⊤),
        x ∈ Stacks.Ample.nonvanishingLocus _ t := by
  have hO : SheafOfModules.IsCoherent (SheafOfModules.unit Z.ringCatSheaf) :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k (i ≫ f)
  obtain ⟨n₀, h⟩ :=
    (Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple
      _ hM).2 (SheafOfModules.unit Z.ringCatSheaf)
      (_root_.isQuasicoherent_of_isCoherent (M := _))
      (SheafOfModules.IsCoherent.isFiniteType (M := _))
  refine ⟨n₀.toNat, fun j hj x => ?_⟩
  have hg := h j (by omega)
  have hg' := MMP.Fourfold.isGloballyGenerated_of_isGeneratedByGlobalSections _
    (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
      (Stacks.AmplePullbackPart1.tensorIsoTensorModules Z _ _ ≪≫
        Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor Z.presheaf Z.ringCatSheaf.2 _ ≪≫
        (Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso Z _ j).symm ≪≫
        (Scheme.Modules.pullbackTensorPowerIntIso i M j).symm) hg)
  exact hg'.exists_mem_nonvanishingLocus x

/-! ### The zero scheme of a nonzero section on an integral scheme -/

/-- **The zero scheme of a nonzero section.** On an integral `X` proper over `k` of dimension at
most `n + 1`, a nonzero global section `s` of an invertible `G` cuts out an effective Cartier
divisor `D` of dimension at most `n`, with nonvanishing locus `X ∖ D` and ideal sheaf
`ℐ_D ≅ G^{⊗ -1}`. -/
private theorem exists_zeroScheme (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] [IsIntegral X] (n : ℕ)
    (hX : topologicalKrullDim X ≤ ((n + 1 : ℕ) : WithBot ℕ∞)) (G : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 G] (s : Γ(G, ⊤)) (hs : s ≠ 0) :
    ∃ D : X.IdealSheafData, topologicalKrullDim D.subscheme ≤ (n : WithBot ℕ∞) ∧
      Stacks.Ample.nonvanishingLocus G s = (Set.range D.subschemeι.base)ᶜ ∧
      Nonempty (kernel (comorph D.subschemeι) ≅
        tensorPower X.presheaf X.ringCatSheaf.2 G (-1)) := by
  have hevaltop : (Stacks.SheafOfModules.sectionsOfTop G s).eval (op ⊤) = s :=
    Stacks.SheafOfModules.sectionsOfTop_eval_top _ s
  have hne0' : (Stacks.SheafOfModules.sectionsOfTop G s).eval (op ⊤) ≠ 0 := by
    rw [hevaltop]; exact hs
  have hreg : IsRegularSection X.sheaf.obj X.ringCatSheaf.property
      (Stacks.SheafOfModules.sectionsOfTop G s) :=
    isRegularSection_of_eval_top_ne_zero _ _ hne0'
  set D := zeroScheme X G ((Stacks.SheafOfModules.sectionsOfTop G s).eval (op ⊤)) with hD
  haveI hDc : Stacks.Divisors.IsEffectiveCartierDivisor D :=
    (isEffectiveCartierDivisor_zeroScheme_iff_isRegularSection X G _).2 hreg
  obtain ⟨e, -⟩ := (existsUnique_invertibleSheafIso_zeroScheme X G _ hreg).exists
  refine ⟨D, ?_, ?_, ?_⟩
  · exact topologicalKrullDim_subscheme_le_of_isEffectiveCartierDivisor_of_isProper k f (𝟙 X) n
      hX D
  · have hcompl := nonvanishingLocus_eq_compl_supportSet_zeroScheme G
      (Stacks.SheafOfModules.sectionsOfTop G s) hne0'
    rw [← hevaltop, ← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G
      (Stacks.SheafOfModules.sectionsOfTop G s)]
    refine hcompl.trans ?_
    rw [Scheme.IdealSheafData.range_subschemeι]
    rfl
  · have h := twistedSheafNegativeTwistConsZeroIso (Z := X) (d := 0) D (fun _ : Fin 1 => G)
      e.symm Fin.elim0
    exact ⟨(Stacks.SheafOfModules.Invertible.tensorProductRightUnitor X.presheaf
        X.ringCatSheaf.2 _).symm ≪≫
      Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
        (eqToIso (Stacks.SheafOfModules.Invertible.tensorPower_zero X.presheaf
          X.ringCatSheaf.2 G).symm) ≪≫ h ≪≫
      Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor X.presheaf X.ringCatSheaf.2 _⟩

/-- The twisted ideal sheaf of a divisor `D` with `ℐ_D ≅ M^{⊗ -1}`:
`M^{⊗ (j+1)} ⊗ ℐ_D ≅ M^{⊗ j}`. -/
private noncomputable def idealTwistIso {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (M : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    (eI : kernel (comorph i) ≅ tensorPower X.presheaf X.ringCatSheaf.2 M (-1)) (m m' : ℤ)
    (hm : m' = m + 1) :
    (tensL (tensorPower X.presheaf X.ringCatSheaf.2 M m')).obj (kernel (comorph i)) ≅
      tensorPower X.presheaf X.ringCatSheaf.2 M m :=
  Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _) eI ≪≫
    (Stacks.SheafOfModules.Invertible.tensorPowerCoherence X.presheaf X.ringCatSheaf.2 M).mulIso
      _ _ ≪≫
    eqToIso (congrArg (tensorPower X.presheaf X.ringCatSheaf.2 M) (by rw [hm]; ring))

/-! ### The Euler polynomial of the powers of an invertible sheaf -/

section EulerPolynomial

open Stacks.SheafOfModules.Invertible (tensorPowerCoherence tensorProductIso)

/-! ### Substituting a sum of variables into a univariate polynomial -/

/-- The polynomial `p(n_1 + ⋯ + n_d)` in `d` variables attached to a univariate `p` of degree at
most `d`, written out in the monomial basis so that its total degree and its coefficient of
`n_1 ⋯ n_d` can be read off. -/
private noncomputable def sumSubst (d : ℕ) (p : Polynomial ℚ) : MvPolynomial (Fin d) ℚ :=
  ∑ j ∈ Finset.range (d + 1),
    MvPolynomial.C (p.coeff j) * (∑ i, MvPolynomial.X i : MvPolynomial (Fin d) ℚ) ^ j

private theorem sumSubst_totalDegree_le (d : ℕ) (p : Polynomial ℚ) :
    (sumSubst d p).totalDegree ≤ d := by
  classical
  refine le_trans (MvPolynomial.totalDegree_finsetSum _ _) (Finset.sup_le fun j hj => ?_)
  have hj' : j ≤ d := Nat.lt_succ_iff.1 (Finset.mem_range.1 hj)
  refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
  have hA : (∑ i, MvPolynomial.X i : MvPolynomial (Fin d) ℚ).totalDegree ≤ 1 :=
    le_trans (MvPolynomial.totalDegree_finsetSum _ _)
      (Finset.sup_le fun i _ => le_of_eq (MvPolynomial.totalDegree_X i))
  have h2 : ((∑ i, MvPolynomial.X i : MvPolynomial (Fin d) ℚ) ^ j).totalDegree ≤ j :=
    le_trans (MvPolynomial.totalDegree_pow _ _) (by simpa using Nat.mul_le_mul_left j hA)
  have h1 : (MvPolynomial.C (p.coeff j) : MvPolynomial (Fin d) ℚ).totalDegree = 0 :=
    MvPolynomial.totalDegree_C _
  omega

private theorem sumSubst_eval (d : ℕ) (p : Polynomial ℚ) (hp : p.natDegree < d + 1)
    (g : Fin d → ℚ) :
    MvPolynomial.eval g (sumSubst d p) = p.eval (∑ i, g i) := by
  rw [Polynomial.eval_eq_sum_range' hp, sumSubst, map_sum]
  exact Finset.sum_congr rfl fun j _ => by simp

private theorem sumSubst_coeff (d : ℕ) (p : Polynomial ℚ) :
    (sumSubst d p).coeff (Finsupp.equivFunOnFinite.symm fun _ : Fin d => 1) =
      (d.factorial : ℚ) * p.coeff d := by
  classical
  set m : Fin d →₀ ℕ := Finsupp.equivFunOnFinite.symm fun _ : Fin d => 1 with hmdef
  have hmval : ∀ i, m i = 1 := fun i => rfl
  have hsum : (m.sum fun _ e => e) = d := by
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
    simp [hmval]
  have hmult : m.multinomial = d.factorial := by
    rw [Finsupp.multinomial, Finsupp.sum_fintype _ _ (fun _ => rfl),
      Finsupp.prod_fintype _ _ (fun _ => rfl)]
    simp [hmval]
  rw [sumSubst, MvPolynomial.coeff_sum]
  rw [Finset.sum_eq_single_of_mem d (Finset.self_mem_range_succ d)]
  · rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_sum_X_pow_of_fintype, hsum, hmult]
    simp [mul_comm]
  · intro j _ hjd
    rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_sum_X_pow_of_fintype, hsum]
    simp [Ne.symm hjd]

/-- The fold over a list of indices of a constant family of invertible modules, started at a
tensor power, is the tensor power with the exponents added on. -/
private noncomputable def twistListTensorPowerIso {X : Scheme.{u}} {r : ℕ}
    (M : Fin r → X.Modules)
    [∀ i, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (M i)]
    (N : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N]
    (e : ∀ i, M i ≅ N) (n : Fin r → ℤ) :
    ∀ (l : List (Fin r)) (m : ℤ),
      twistList M n l (tensorPower X.presheaf X.ringCatSheaf.2 N m) ≅
        tensorPower X.presheaf X.ringCatSheaf.2 N (l.foldl (fun z i => z + n i) m) := by
  intro l
  induction l with
  | nil => exact fun m => Iso.refl _
  | cons i t ih =>
      exact fun m =>
        twistListIso M n t
            (tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
                (tensorPowerIsoOfIso (M i) N (e i) (n i)) ≪≫
              (tensorPowerCoherence X.presheaf X.ringCatSheaf.2 N).mulIso m (n i)) ≪≫
          ih (m + n i)

private theorem finRange_foldl_add {r : ℕ} (n : Fin r → ℤ) (z : ℤ) :
    (List.finRange r).foldl (fun a i => a + n i) z = z + ∑ i, n i := by
  induction r generalizing z with
  | zero => simp
  | succ r ih =>
      rw [List.finRange_succ, List.foldl_cons, List.foldl_map]
      rw [ih (fun i => n i.succ) (z + n 0)]
      simp [Fin.sum_univ_succ, add_assoc]

/-- **A twist of the structure sheaf by a constant family is a single tensor power.**
`𝒪_X ⊗ M_1^{⊗ n_1} ⊗ ⋯ ⊗ M_r^{⊗ n_r} ≅ N^{⊗ (n_1 + ⋯ + n_r)}` whenever every `M_i` is
isomorphic to `N`. -/
private noncomputable def twistedSheafUnitIsoTensorPower {X : Scheme.{u}} {r : ℕ}
    (M : Fin r → X.Modules)
    [∀ i, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (M i)]
    (N : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N]
    (e : ∀ i, M i ≅ N) (n : Fin r → ℤ) :
    twistedSheaf (SheafOfModules.unit X.ringCatSheaf) M n ≅
      tensorPower X.presheaf X.ringCatSheaf.2 N (∑ i, n i) :=
  have hunit : (SheafOfModules.unit X.ringCatSheaf : X.Modules) =
      tensorPower X.presheaf X.ringCatSheaf.2 N 0 := rfl
  have hfold : (List.finRange r).foldl (fun z i => z + n i) 0 = ∑ i, n i := by
    rw [finRange_foldl_add]; ring
  twistListIso M n (List.finRange r) (eqToIso hunit) ≪≫
    twistListTensorPowerIso M N e n (List.finRange r) 0 ≪≫
    eqToIso (congrArg (tensorPower X.presheaf X.ringCatSheaf.2 N) hfold)

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f]
  (d : ℕ) (hdim : topologicalKrullDim X = (d : WithBot ℕ∞)) (L : X.Modules)
  [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]

include hdim in
/-- The Euler characteristics of the tensor powers of an invertible module on a proper scheme
over a field are the values of a univariate rational polynomial of degree at most the dimension
of the scheme.  This is [Stacks, Tag 0BEM] in one variable, read through
`twistedSheafUnitIsoTensorPower` and
`MvPolynomial.uniqueAlgEquiv`. -/
private theorem exists_eulerPolynomial_tensorPower :
    ∃ p : Polynomial ℚ, p.degree ≤ (d : WithBot ℕ) ∧
      ∀ m : ℤ, p.eval (m : ℚ) =
        ((@eulerCharacteristic k _ X f _ (tensorPower X.presheaf X.ringCatSheaf.2 L m)
          (SheafOfModules.isCoherent_of_isInvertible k f
            (tensorPower X.presheaf X.ringCatSheaf.2 L m)) : ℤ) : ℚ) := by
  classical
  haveI hunit : (SheafOfModules.unit X.ringCatSheaf : X.Modules).IsCoherent :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k f
  haveI : ∀ _ : Fin 1, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L :=
    fun _ => inferInstance
  obtain ⟨q, hqdeg, hqeval⟩ := exists_eulerPolynomial_twistedSheaf_of_isProper k f
    (fun _ : Fin 1 => L) (SheafOfModules.unit X.ringCatSheaf) hunit
  have hsupp : topologicalKrullDim
      (SheafOfModules.supp (SheafOfModules.unit X.ringCatSheaf : X.Modules)) ≤
      (d : WithBot ℕ∞) := le_trans (topologicalKrullDim_subspace_le X _) (le_of_eq hdim)
  have htotal : q.totalDegree ≤ d := by
    rcases hqdeg with hzero | hdeg
    · simp [hzero]
    · exact_mod_cast le_trans hdeg hsupp
  refine ⟨MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) q, ?_, ?_⟩
  · refine (Polynomial.degree_le_iff_coeff_zero _ (d : WithBot ℕ)).2 fun s hs => ?_
    have hs' : d < s := by exact_mod_cast hs
    rw [MvPolynomial.coeff_uniqueAlgEquiv]
    by_contra hne
    have hmem : Finsupp.single (default : Fin 1) s ∈ q.support :=
      MvPolynomial.mem_support_iff.2 hne
    have hle := MvPolynomial.le_totalDegree hmem
    rw [Finsupp.sum_single_index rfl] at hle
    omega
  · intro m
    have he : ((MvPolynomial.uniqueAlgEquiv ℚ (Fin 1) q : Polynomial ℚ)).eval₂
        (RingHom.id ℚ) (m : ℚ) = q.eval₂ (RingHom.id ℚ) (fun _ : Fin 1 => (m : ℚ)) :=
      MvPolynomial.eval₂_const_uniqueAlgEquiv
    rw [Polynomial.eval₂_id] at he
    rw [he, MvPolynomial.eval₂_id]
    have hval := hqeval (fun _ : Fin 1 => m)
    have hcast : (fun j : Fin 1 => ((m : ℤ) : ℚ)) = fun _ : Fin 1 => (m : ℚ) := rfl
    rw [hcast] at hval
    rw [hval]
    have hsum : (∑ _i : Fin 1, m) = m := by simp
    have eiso : twistedSheaf (SheafOfModules.unit X.ringCatSheaf) (fun _ : Fin 1 => L)
        (fun _ => m) ≅ tensorPower X.presheaf X.ringCatSheaf.2 L m :=
      twistedSheafUnitIsoTensorPower (fun _ : Fin 1 => L) L (fun _ => Iso.refl L) (fun _ => m) ≪≫
        eqToIso (congrArg (tensorPower X.presheaf X.ringCatSheaf.2 L) hsum)
    haveI : (twistedSheaf (SheafOfModules.unit X.ringCatSheaf) (fun _ : Fin 1 => L)
        (fun _ => m)).IsCoherent := twistedSheaf_isCoherent _ _ _
    haveI := SheafOfModules.isCoherent_of_isInvertible k f
      (tensorPower X.presheaf X.ringCatSheaf.2 L m)
    exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) (eulerCharacteristic_eq_of_iso k f eiso)

include hdim in
/-- **The self-intersection number is `d!` times the leading coefficient of the Euler
polynomial.**  The polynomial `P(n_1, …, n_d) = p(n_1 + ⋯ + n_d)` takes the twisted Euler
characteristics as its values and has total degree at most `d`, so [Stacks, Tag 0BEP] identifies
`(𝓛^d ⬝ X)` with its coefficient of `n_1 ⋯ n_d`, which is `d! ⬝ p_d`. -/
private theorem selfIntersectionNumber_eq_factorial_mul_coeff (p : Polynomial ℚ)
    (hp : p.degree ≤ (d : WithBot ℕ))
    (hpeval : ∀ m : ℤ, p.eval (m : ℚ) =
      ((@eulerCharacteristic k _ X f _ (tensorPower X.presheaf X.ringCatSheaf.2 L m)
        (SheafOfModules.isCoherent_of_isInvertible k f
          (tensorPower X.presheaf X.ringCatSheaf.2 L m)) : ℤ) : ℚ)) :
    ((selfIntersectionNumber k f (𝟙 X) d hdim.le L : ℤ) : ℚ) =
      (d.factorial : ℚ) * p.coeff d := by
  classical
  haveI : ∀ _ : Fin d, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L :=
    fun _ => inferInstance
  have hnat : p.natDegree < d + 1 :=
    Nat.lt_succ_of_le (Polynomial.natDegree_le_iff_degree_le.2 hp)
  have hkey := intersectionNumber_eq_coeff k f (𝟙 X) d hdim.le (fun _ : Fin d => L)
    (sumSubst d p) ?_ (sumSubst_totalDegree_le d p)
  · rw [selfIntersectionNumber_eq_intersectionNumber, hkey, sumSubst_coeff]
  · intro n
    rw [sumSubst_eval d p hnat]
    have hcast : (∑ j, ((n j : ℤ) : ℚ)) = (((∑ j, n j : ℤ)) : ℚ) := by push_cast; ring
    rw [hcast, hpeval (∑ j, n j)]
    have eiso : twistedSheaf (SheafOfModules.unit X.ringCatSheaf)
        (fun j : Fin d => (Scheme.Modules.pullback (𝟙 X)).obj L) n ≅
        tensorPower X.presheaf X.ringCatSheaf.2 L (∑ j, n j) :=
      twistedSheafUnitIsoTensorPower (fun _ : Fin d => (Scheme.Modules.pullback (𝟙 X)).obj L) L
        (fun _ => (Scheme.Modules.pullbackId X).app L) n
    haveI := SheafOfModules.isCoherent_of_isInvertible k f
      (tensorPower X.presheaf X.ringCatSheaf.2 L (∑ j, n j))
    haveI : (twistedSheaf (SheafOfModules.unit X.ringCatSheaf)
        (fun j : Fin d => (Scheme.Modules.pullback (𝟙 X)).obj L) n).IsCoherent :=
      isCoherent_twistedSheafUnitPullback k f (𝟙 X) (fun _ : Fin d => L) n
    have hiso := eulerCharacteristic_eq_of_iso k f eiso
    have hid : (𝟙 X ≫ f) = f := Category.id_comp f
    have : ((@eulerCharacteristic k _ X (𝟙 X ≫ f) inferInstance
          (twistedSheaf (SheafOfModules.unit X.ringCatSheaf)
            (fun j : Fin d => (Scheme.Modules.pullback (𝟙 X)).obj L) n)
          (isCoherent_twistedSheafUnitPullback k f (𝟙 X) (fun _ : Fin d => L) n) : ℤ) : ℚ) =
        ((@eulerCharacteristic k _ X f _
          (tensorPower X.presheaf X.ringCatSheaf.2 L (∑ j, n j))
          (SheafOfModules.isCoherent_of_isInvertible k f _) : ℤ) : ℚ) := by
      simp only [hid]
      exact_mod_cast congrArg (fun z : ℤ => (z : ℚ)) hiso
    exact this.symm

end EulerPolynomial

/-! ### Isomorphisms of tensor products of invertible sheaves -/

section TensorAlgebra

open Stacks.SheafOfModules.Invertible (tensorPowerCoherence tensorProductIso
  tensorProductAssociator tensorProductBraiding tensorPowerOneIso tensorProductLeftUnitor
  tensorProductRightUnitor)

/-- Tensor product of modules on a scheme. -/
private noncomputable abbrev tens {X : Scheme.{u}} (A B : X.Modules) : X.Modules :=
  ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _
    X.presheaf (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).obj A).obj B

private theorem isInvertible_tens {X : Scheme.{u}} (A B : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 A]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 B] :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (tens A B) :=
  Stacks.SheafOfModules.tensorProduct_isInvertible X.presheaf X.ringCatSheaf.2 A B

attribute [local instance] isInvertible_tens

/-- Tensoring by an invertible sheaf can be cancelled. -/
private noncomputable def cancelIso {X : Scheme.{u}} (N : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N] {A B : X.Modules}
    (h : tens A N ≅ tens B N) : A ≅ B :=
  haveI : ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _
      X.presheaf (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).flip.obj N).IsEquivalence :=
    (Stacks.SheafOfModules.Invertible.isInvertible_iff_tensorRightFunctor_isEquivalence
      X.presheaf X.ringCatSheaf.2 N).1 inferInstance
  ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _
      X.presheaf (forget₂ CommRingCat RingCat) X.ringCatSheaf.2⟩).flip.obj N).preimageIso h

/-- `N^{⊗ -1} ⊗ N ≅ 𝒪_X`. -/
private noncomputable def tensorPowerNegOneTensorIso {X : Scheme.{u}} (N : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N] :
    tens (tensorPower X.presheaf X.ringCatSheaf.2 N (-1)) N ≅
      SheafOfModules.unit X.ringCatSheaf :=
  tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
      (tensorPowerOneIso X.presheaf X.ringCatSheaf.2 N).symm ≪≫
    (tensorPowerCoherence X.presheaf X.ringCatSheaf.2 N).mulIso (-1) 1 ≪≫
    eqToIso ((congrArg (tensorPower X.presheaf X.ringCatSheaf.2 N) (by norm_num)).trans
      (Stacks.SheafOfModules.Invertible.tensorPower_zero X.presheaf X.ringCatSheaf.2 N))

/-- `L ⊗ (L ⊗ G)^{⊗ -1} ≅ G^{⊗ -1}`. -/
private noncomputable def tensNegOneIso {X : Scheme.{u}} (L G : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 G] :
    tens L (tensorPower X.presheaf X.ringCatSheaf.2 (tens L G) (-1)) ≅
      tensorPower X.presheaf X.ringCatSheaf.2 G (-1) :=
  cancelIso G
    (tensorProductIso X.presheaf X.ringCatSheaf.2
        (tensorProductBraiding X.presheaf X.ringCatSheaf.2 _ _) (Iso.refl G) ≪≫
      tensorProductAssociator X.presheaf X.ringCatSheaf.2 _ _ _ ≪≫
      tensorPowerNegOneTensorIso (tens L G) ≪≫ (tensorPowerNegOneTensorIso G).symm)

/-- `L^{⊗ (m+1)} ⊗ (L ⊗ G)^{⊗ -1} ≅ L^{⊗ m} ⊗ G^{⊗ -1}`. -/
private noncomputable def tensPowSuccNegOneIso {X : Scheme.{u}} (L G : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 G] (m m' : ℤ) (hm : m' = m + 1) :
    tens (tensorPower X.presheaf X.ringCatSheaf.2 L m')
        (tensorPower X.presheaf X.ringCatSheaf.2 (tens L G) (-1)) ≅
      tens (tensorPower X.presheaf X.ringCatSheaf.2 L m)
        (tensorPower X.presheaf X.ringCatSheaf.2 G (-1)) :=
  tensorProductIso X.presheaf X.ringCatSheaf.2
      (eqToIso (congrArg (tensorPower X.presheaf X.ringCatSheaf.2 L) hm) ≪≫
        ((tensorPowerCoherence X.presheaf X.ringCatSheaf.2 L).mulIso m 1).symm ≪≫
        tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
          (tensorPowerOneIso X.presheaf X.ringCatSheaf.2 L))
      (Iso.refl _) ≪≫
    tensorProductAssociator X.presheaf X.ringCatSheaf.2 _ _ _ ≪≫
    tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _) (tensNegOneIso L G)

end TensorAlgebra

/-! ### Growth of the Euler characteristic and of the global sections -/

section Growth

attribute [local instance] isInvertible_tens

/-- **`χ(X, L^m) → ∞`** on an `X` of dimension `n + 1` with `(L^{n+1} · X) > 0`: the Euler
characteristic is a polynomial of degree at most `n + 1` whose coefficient of `m^{n+1}` is
`(L^{n+1} · X)/(n+1)!`. -/
private theorem exists_lt_eulerCharacteristic (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (n : ℕ)
    (hX : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hpos : 0 < intersectionNumber k f (𝟙 X) (n + 1) hX.le (fun _ => L)) (C : ℤ) (m₀ : ℕ) :
    ∃ m : ℕ, m₀ ≤ m ∧ C < @eulerCharacteristic k _ X f _
      (tensorPower X.presheaf X.ringCatSheaf.2 L m)
      (SheafOfModules.isCoherent_of_isInvertible k f _) := by
  obtain ⟨p, hp, hpeval⟩ := exists_eulerPolynomial_tensorPower k f (n + 1) hX L
  have hc := selfIntersectionNumber_eq_factorial_mul_coeff k f (n + 1) hX L p hp hpeval
  rw [selfIntersectionNumber_eq_intersectionNumber] at hc
  have hposQ : (0 : ℚ) < (intersectionNumber k f (𝟙 X) (n + 1) hX.le (fun _ => L) : ℚ) := by
    exact_mod_cast hpos
  rw [hc] at hposQ
  have hcoeff : 0 < p.coeff (n + 1) :=
    (mul_pos_iff_of_pos_left (by positivity : (0 : ℚ) < ((n + 1).factorial : ℚ))).1 hposQ
  have hdeg : p.natDegree = n + 1 :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero (Polynomial.natDegree_le_iff_degree_le.2 hp)
      hcoeff.ne'
  have hp0 : p ≠ 0 := fun h => by simp [h] at hcoeff
  have hlead : 0 ≤ p.leadingCoeff := by
    rw [Polynomial.leadingCoeff, hdeg]; exact hcoeff.le
  have hdeg' : 0 < p.degree := by
    rw [Polynomial.degree_eq_natDegree hp0, hdeg]; exact_mod_cast Nat.succ_pos n
  have ht := (Polynomial.tendsto_atTop_of_leadingCoeff_nonneg p hdeg' hlead).comp
    tendsto_natCast_atTop_atTop
  obtain ⟨m, hm1, hm2⟩ := ((ht.eventually (Filter.eventually_gt_atTop (C : ℚ))).and
    (Filter.eventually_ge_atTop m₀)).exists
  refine ⟨m, hm2, ?_⟩
  have h := hpeval m
  simp only [Function.comp_apply] at hm1
  rw [show ((m : ℤ) : ℚ) = (m : ℚ) by push_cast; rfl] at h
  rw [h] at hm1
  exact_mod_cast hm1

/-- **The higher cohomology of `L^m` decreases.** On an integral projective `X` of dimension
`n + 1`, with `L` ample on every closed subscheme of dimension at most `n`, the dimensions
`hᵖ(X, L^m)`, `p ≥ 2`, are nonincreasing in `m ≫ 0`. Writing `L = A - B` for two effective
Cartier divisors (`𝒪(B) = H^c`, `𝒪(A) = L ⊗ H^c`, `H` ample, `c ≫ 0`), the sequences
`0 → L^{m+1}(-A) → L^{m+1} → L^{m+1}|_A → 0` and `0 → L^m(-B) → L^m → L^m|_B → 0` have the same
first term and vanishing higher cohomology of the last terms. -/
private theorem exists_antitone_higher_cohomology (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f) [IsIntegral X] (n : ℕ)
    (hX : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (ih : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) [IsClosedImmersion j], topologicalKrullDim Y ≤ n →
      Stacks.Ample.IsAmple Y ((Scheme.Modules.pullback j).obj L)) :
    ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m → ∀ p : ℕ, 2 ≤ p →
      Module.finrank k (cohomologyOverField k f
        (tensorPower X.presheaf X.ringCatSheaf.2 L ((m + 1 : ℕ) : ℤ)) p) ≤
      Module.finrank k
        (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m) p) := by
  classical
  -- an ample sheaf `H`
  obtain ⟨M₀, hM₀, hM₀a⟩ := Stacks.HProjective.exists_isAmple_of_isAffine (Spec (.of k))
  obtain ⟨H, hHinv, hH⟩ := exists_isAmple_of_isProjectiveMorphism f M₀ hM₀a
    (isProjectiveMorphism_of_isProjective_of_isAffine f hproj)
  -- Serre generation of `L ⊗ H^c` and of `H^c`
  have hLc := SheafOfModules.isCoherent_of_isInvertible k f L
  have hOc := Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k f
  obtain ⟨c₁, hc₁⟩ :=
    (Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple
      H hH).2 L (_root_.isQuasicoherent_of_isCoherent (M := L))
      (SheafOfModules.IsCoherent.isFiniteType (M := L))
  obtain ⟨c₂, hc₂⟩ :=
    (Stacks.AmpleCharacterization.quasiSeparatedSpace_and_isGeneratedByGlobalSections_of_isAmple
      H hH).2 (SheafOfModules.unit X.ringCatSheaf) (_root_.isQuasicoherent_of_isCoherent (M := _))
      (SheafOfModules.IsCoherent.isFiniteType (M := _))
  obtain ⟨G, hG⟩ : ∃ G : X.Modules, G = Stacks.Ample.tensorPowModule X H (max c₁ c₂) := ⟨_, rfl⟩
  haveI hGinv : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 G := hG ▸ inferInstance
  have hggA : MMP.Intersection.IsGloballyGenerated (tens L G) :=
    MMP.Fourfold.isGloballyGenerated_of_isGeneratedByGlobalSections _
      (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
        (Stacks.AmplePullbackPart1.tensorIsoTensorModules X _ _ ≪≫
          eqToIso (congrArg (tens L) hG.symm)) (hc₁ _ (le_max_left _ _)))
  have hggB : MMP.Intersection.IsGloballyGenerated G :=
    MMP.Fourfold.isGloballyGenerated_of_isGeneratedByGlobalSections _
      (Stacks.SheafOfModules.Intrinsic.isGeneratedByGlobalSections_of_iso
        (Stacks.AmplePullbackPart1.tensorIsoTensorModules X _ _ ≪≫
          Stacks.SheafOfModules.Invertible.tensorProductLeftUnitor X.presheaf X.ringCatSheaf.2 _ ≪≫
          eqToIso hG.symm) (hc₂ _ (le_max_right _ _)))
  -- nonzero sections and their zero schemes `A`, `B`
  obtain ⟨x₀⟩ : Nonempty X := inferInstance
  obtain ⟨σA, hσA⟩ := hggA.exists_mem_nonvanishingLocus x₀
  obtain ⟨σB, hσB⟩ := hggB.exists_mem_nonvanishingLocus x₀
  have hne : ∀ {P : X.Modules} (σ : Γ(P, ⊤)), x₀ ∈ Stacks.Ample.nonvanishingLocus P σ → σ ≠ 0 := by
    intro P σ hσ h
    rw [h, Stacks.Ample.mem_nonvanishingLocus_iff] at hσ
    exact hσ (by simp)
  obtain ⟨A, hAdim, -, ⟨eA⟩⟩ := exists_zeroScheme k f n hX.le _ σA (hne σA hσA)
  obtain ⟨B, hBdim, -, ⟨eB⟩⟩ := exists_zeroScheme k f n hX.le _ σB (hne σB hσB)
  -- Serre vanishing on `A` and `B`
  obtain ⟨nA, hvA⟩ := eventually_isZero_cohomology_pullback k f A.subschemeι L
    (ih _ A.subschemeι hAdim)
  obtain ⟨nB, hvB⟩ := eventually_isZero_cohomology_pullback k f B.subschemeι L
    (ih _ B.subschemeι hBdim)
  refine ⟨max nA nB, fun m hm p hp => ?_⟩
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
  have eB' : (tensL (tensorPower X.presheaf X.ringCatSheaf.2 L m)).obj
      (kernel (comorph B.subschemeι)) ≅ tens (tensorPower X.presheaf X.ringCatSheaf.2 L m)
        (tensorPower X.presheaf X.ringCatSheaf.2 G (-1)) :=
    Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _) eB
  have E : (tensL (tensorPower X.presheaf X.ringCatSheaf.2 L ((m + 1 : ℕ) : ℤ))).obj
      (kernel (comorph A.subschemeι)) ≅ (tensL (tensorPower X.presheaf X.ringCatSheaf.2 L m)).obj
      (kernel (comorph B.subschemeι)) :=
    Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf X.ringCatSheaf.2 (Iso.refl _)
        eA ≪≫ tensPowSuccNegOneIso L G m _ (by push_cast; ring) ≪≫ eB'.symm
  have hfinE : ∀ r : ℕ, FiniteDimensional k (cohomologyOverField k f
      ((tensL (tensorPower X.presheaf X.ringCatSheaf.2 L m)).obj
        (kernel (comorph B.subschemeι))) r) := fun r =>
    haveI := @finiteDimensional_cohomologyOverField_of_isProper k _ X f _ _
      (SheafOfModules.isCoherent_of_isInvertible k f (tens
        (tensorPower X.presheaf X.ringCatSheaf.2 L m)
        (tensorPower X.presheaf X.ringCatSheaf.2 G (-1)))) r
    LinearEquiv.finiteDimensional (cohomologyOverFieldIso k f eB' r).toLinearEquiv.symm
  have hfinA : FiniteDimensional k (cohomologyOverField k f
      ((tensL (tensorPower X.presheaf X.ringCatSheaf.2 L ((m + 1 : ℕ) : ℤ))).obj
        (kernel (comorph A.subschemeι))) (q + 1)) :=
    haveI := hfinE (q + 1)
    LinearEquiv.finiteDimensional (cohomologyOverFieldIso k f E (q + 1)).toLinearEquiv.symm
  have h1 := finrank_le_finrank_ideal k f A.subschemeι
    (tensorPower X.presheaf X.ringCatSheaf.2 L ((m + 1 : ℕ) : ℤ)) (q + 1) hfinA
    (hvA (m + 1) (by omega) (q + 1) (by omega))
  rw [finrank_cohomologyOverField_eq_of_iso k f E] at h1
  have h2 := finrank_ideal_succ_le k f B.subschemeι
    (tensorPower X.presheaf X.ringCatSheaf.2 L m) q
    (@finiteDimensional_cohomologyOverField_of_isProper k _ X f _ _
      (SheafOfModules.isCoherent_of_isInvertible k f _) (q + 1))
    (hvB m (by omega) q (by omega))
  exact h1.trans h2

end Growth

/-! ### The integral case -/

/-- **A power of `L` has a nonzero section.** On an integral projective `X` of dimension
`n + 1` with `(L^{n+1} · X) > 0`, and with `L` ample on every closed subscheme of dimension at
most `n`, some `L^a`, `a ≥ 1`, has a nonzero global section. -/
private theorem exists_section_ne_zero (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f) [IsIntegral X] (n : ℕ)
    (hX : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hpos : 0 < intersectionNumber k f (𝟙 X) (n + 1) hX.le (fun _ => L))
    (ih : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) [IsClosedImmersion j], topologicalKrullDim Y ≤ n →
      Stacks.Ample.IsAmple Y ((Scheme.Modules.pullback j).obj L)) :
    ∃ a : ℕ, 1 ≤ a ∧ ∃ s : Γ(tensorPower X.presheaf X.ringCatSheaf.2 L a, ⊤), s ≠ 0 := by
  classical
  obtain ⟨m₀, hmono⟩ := exists_antitone_higher_cohomology k f hproj n hX L ih
  set N := X.affineCoverNum ⊤ with hN
  have hcoh : ∀ m : ℤ, SheafOfModules.IsCoherent (tensorPower X.presheaf X.ringCatSheaf.2 L m) :=
    fun m => SheafOfModules.isCoherent_of_isInvertible k f _
  have hvan : ∀ (m : ℤ) (p : ℕ), N ≤ p → Module.finrank k
      (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m) p) = 0 :=
    fun m p hp => @finrank_cohomologyOverField_eq_zero_of_affineCoverNum_le k _ X f _ _
      (@_root_.isQuasicoherent_of_isCoherent _ _ _ _ (hcoh m)) p hp
  have hbound : ∀ m : ℕ, m₀ ≤ m → ∀ p : ℕ, 2 ≤ p →
      Module.finrank k (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m) p) ≤
      Module.finrank k
        (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m₀) p) := by
    intro m hm p hp
    induction m, hm using Nat.le_induction with
    | base => exact le_rfl
    | succ m hm ih' => exact (hmono m hm p hp).trans ih'
  set C : ℤ := ∑ p ∈ Finset.range N, (Module.finrank k
    (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m₀) p) : ℤ) with hC
  obtain ⟨m, hm, hmC⟩ := exists_lt_eulerCharacteristic k f n hX L hpos C (max m₀ 1)
  set a : ℕ → ℕ := fun p =>
    Module.finrank k (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m) p)
    with ha
  have hchi : @eulerCharacteristic k _ X f _ (tensorPower X.presheaf X.ringCatSheaf.2 L m)
      (SheafOfModules.isCoherent_of_isInvertible k f _) ≤ (a 0 : ℤ) + C := by
    show ∑ᶠ p : ℕ, (-1 : ℤ) ^ p * (a p : ℤ) ≤ _
    rw [finsum_eq_sum_of_support_subset _ (s := Finset.range N) ?_]
    · calc ∑ p ∈ Finset.range N, (-1 : ℤ) ^ p * (a p : ℤ)
          ≤ ∑ p ∈ Finset.range N, ((if p = 0 then (a 0 : ℤ) else 0) + (Module.finrank k
              (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 L m₀) p) : ℤ)) := by
            refine Finset.sum_le_sum fun p _ => ?_
            rcases p with _ | _ | p
            · simp
            · simp
            · have h1 := hbound m (by omega) (p + 2) (by omega)
              rw [if_neg (by omega), zero_add]
              have h2 : (-1 : ℤ) ^ (p + 1 + 1) * (a (p + 1 + 1) : ℤ) ≤ (a (p + 1 + 1) : ℤ) := by
                rcases neg_one_pow_eq_or ℤ (p + 1 + 1) with h | h <;> rw [h] <;> omega
              exact h2.trans (by exact_mod_cast h1)
        _ ≤ (a 0 : ℤ) + C := by
            rw [Finset.sum_add_distrib, Finset.sum_ite_eq' (Finset.range N) 0]
            split_ifs <;> simp [hC]
    · intro p hp
      simp only [Function.mem_support, ne_eq] at hp
      simp only [Finset.coe_range, Set.mem_Iio]
      by_contra hpN
      exact hp (by rw [show a p = 0 from hvan m p (by omega)]; simp)
  have h0 : 0 < a 0 := by
    have := hmC.trans_le hchi
    omega
  haveI := @finiteDimensional_cohomologyOverField_of_isProper k _ X f _ _ (hcoh m) 0
  obtain ⟨v, hv⟩ := (Module.finrank_pos_iff_exists_ne_zero).1 h0
  refine ⟨m, by omega, cohomologyOverFieldZeroEquivSections k f _ v, fun h => hv ?_⟩
  apply (cohomologyOverFieldZeroEquivSections k f _).injective
  rw [h]
  have h1 := cohomologyOverFieldZeroEquivSections_cohomologyOverFieldMap k f
    (0 : tensorPower X.presheaf X.ringCatSheaf.2 L m ⟶
      tensorPower X.presheaf X.ringCatSheaf.2 L m) 0
  rw [map_zero] at h1
  rw [h1]
  rfl

/-- **A nonzero section of a power of `L` makes a further power globally generated.** -/
private theorem exists_isGloballyGenerated (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] [IsIntegral X] (n : ℕ)
    (hX : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞)) (M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    (s : Γ(M, ⊤)) (hs : s ≠ 0)
    (ih : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) [IsClosedImmersion j], topologicalKrullDim Y ≤ n →
      Stacks.Ample.IsAmple Y ((Scheme.Modules.pullback j).obj M)) :
    ∃ j : ℕ, 1 ≤ j ∧
      MMP.Intersection.IsGloballyGenerated (tensorPower X.presheaf X.ringCatSheaf.2 M j) := by
  classical
  obtain ⟨D, hDdim, hnv, ⟨eI⟩⟩ := exists_zeroScheme k f n hX.le M s hs
  have hMD := ih D.subscheme D.subschemeι hDdim
  obtain ⟨n₁, hvan⟩ := eventually_isZero_cohomology_pullback k f D.subschemeι M hMD
  obtain ⟨n₂, hgen⟩ := eventually_exists_mem_nonvanishingLocus k f D.subschemeι M hMD
  have hfin : ∀ (m : ℤ) (p : ℕ), FiniteDimensional k
      (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 M m) p) := fun m p =>
    @finiteDimensional_cohomologyOverField_of_isProper k _ X f _ _
      (SheafOfModules.isCoherent_of_isInvertible k f _) p
  have hfinI : ∀ (j p : ℕ), FiniteDimensional k (cohomologyOverField k f
      ((tensL (tensorPower X.presheaf X.ringCatSheaf.2 M ((j + 1 : ℕ) : ℤ))).obj
        (kernel (comorph D.subschemeι))) p) := fun j p =>
    haveI := hfin j p
    LinearEquiv.finiteDimensional (cohomologyOverFieldIso k f
      (idealTwistIso D.subschemeι M eI j _ (by push_cast; ring)) p).toLinearEquiv.symm
  have hrkI : ∀ (j p : ℕ), Module.finrank k (cohomologyOverField k f
      ((tensL (tensorPower X.presheaf X.ringCatSheaf.2 M ((j + 1 : ℕ) : ℤ))).obj
        (kernel (comorph D.subschemeι))) p) =
      Module.finrank k (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 M j) p) :=
    fun j p => finrank_cohomologyOverField_eq_of_iso k f
      (idealTwistIso D.subschemeι M eI j _ (by push_cast; ring)) p
  set h : ℕ → ℕ := fun j =>
    Module.finrank k (cohomologyOverField k f (tensorPower X.presheaf X.ringCatSheaf.2 M j) 1)
    with hh
  have hmono : ∀ j, n₁ ≤ j → h (j + 1) ≤ h j := by
    intro j hj
    have h1 := finrank_le_finrank_ideal k f D.subschemeι
      (tensorPower X.presheaf X.ringCatSheaf.2 M ((j + 1 : ℕ) : ℤ)) 1 (hfinI j 1)
      (hvan (j + 1) (by omega) 1 one_pos)
    rw [hrkI] at h1
    exact h1
  obtain ⟨j, hj, hjeq⟩ := exists_eq_of_antitone_from h (max n₁ n₂)
    (fun j hj => hmono j (le_of_max_le_left hj))
  have hsurj := surjective_pullbackGlobalSection_of_finrank k f D.subschemeι
    (tensorPower X.presheaf X.ringCatSheaf.2 M ((j + 1 : ℕ) : ℤ))
    (hvan (j + 1) (by omega) 1 one_pos) (hfinI j 1) (hfin _ 1)
    (by rw [hrkI]; exact hjeq.ge)
  refine ⟨j + 1, by omega, ?_⟩
  refine isGloballyGenerated_of_forall_mem_nonvanishingLocus _ fun x => ?_
  by_cases hx : x ∈ Set.range D.subschemeι.base
  · obtain ⟨x', rfl⟩ := hx
    obtain ⟨t, ht⟩ := hgen (j + 1) (by omega) x'
    obtain ⟨σ, rfl⟩ := hsurj t
    refine ⟨σ, ?_⟩
    have hpre := Stacks.NonvanishingPullback.preimage_nonvanishingLocus D.subschemeι _ σ
    have hmem : x' ∈ D.subschemeι.base ⁻¹' Stacks.Ample.nonvanishingLocus _ σ := hpre ▸ ht
    exact hmem
  · have hxs : x ∈ Stacks.Ample.nonvanishingLocus M s := by rw [hnv]; exact hx
    obtain ⟨s', hs'⟩ := Stacks.Ample.exists_tensorPow_nonvanishingLocus_eq_of_dvd M (n := 1)
      (D := j + 1) (by omega) (one_dvd _)
      ((Scheme.Modules.Hom.app (Stacks.Ample.tensorPowModuleOneIso X M).symm.hom ⊤) s)
    refine ⟨(Scheme.Modules.Hom.app
      (Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso X M ((j + 1 : ℕ) : ℤ)).symm.hom ⊤)
      s', ?_⟩
    have e1 := Stacks.Ample.nonvanishingLocus_congr
      (Stacks.PowerFamilyBridge.invertibleTensorPowerModuleIso X M ((j + 1 : ℕ) : ℤ)).symm s'
    have e2 := Stacks.Ample.nonvanishingLocus_congr (Stacks.Ample.tensorPowModuleOneIso X M).symm s
    exact (Set.ext_iff.mp (e1.trans (hs'.trans e2)) x).mpr hxs

/-- The degree of a positive tensor power on a curve: if `P ≅ N^{⊗ b}` then
`(P · C) = b (N · C)`. -/
private theorem intersectionNumber_one_of_iso_tensorPower (k : Type u) [Field k] {X C : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (i : C ⟶ X) [IsClosedImmersion i]
    (hC : topologicalKrullDim C ≤ ((1 : ℕ) : WithBot ℕ∞)) (N P : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 P] (b : ℕ)
    (e : P ≅ tensorPower X.presheaf X.ringCatSheaf.2 N b) :
    intersectionNumber k f i 1 hC (fun _ => P) =
      b * intersectionNumber k f i 1 hC (fun _ => N) := by
  haveI : ∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      (Function.update (fun _ : Fin 1 => N) 0 (tensorPower X.presheaf X.ringCatSheaf.2 N b) q) :=
    isInvertible_update _ 0 _
  rw [← intersectionNumber_update_tensorPower k f i 1 hC (fun _ => N) 0 b]
  refine intersectionNumber_eq_of_iso_at k f i 1 hC _ _ 0
    (fun q hq => absurd (Subsingleton.elim q 0) hq) ?_
  exact e ≪≫ eqToIso (Function.update_self (β := fun _ : Fin 1 => X.Modules) 0 _ _).symm

/-- **A globally generated positive power of positive degree on every curve.** If `N ≅ M^{⊗ j}`
and `M ≅ L^{⊗ a}`, `a, j ≥ 1`, with `N` globally generated and `(L · C) > 0` for every integral
curve `C ⊆ X`, then `L` is ample. -/
private theorem isAmple_of_isGloballyGenerated_pow (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f) (L M N : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 N] (a j : ℕ) (ha : 1 ≤ a)
    (hj : 1 ≤ j) (eM : M ≅ tensorPower X.presheaf X.ringCatSheaf.2 L a)
    (eN : N ≅ tensorPower X.presheaf X.ringCatSheaf.2 M j)
    (hgg : MMP.Intersection.IsGloballyGenerated N)
    (hcurve : ∀ (C : Scheme.{u}) (i : C ⟶ X) [IsClosedImmersion i] [IsIntegral C]
      (hC : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞)),
      0 < intersectionNumber k f i 1 hC.le (fun _ => L)) :
    Stacks.Ample.IsAmple X L := by
  have hN : Stacks.Ample.IsAmple X N := by
    refine MMP.Mori.isAmple_of_isGloballyGenerated_of_degreeOn_pos k f
      (isProjectiveMorphism_of_isProjective_of_isAffine f hproj) N hgg ?_
    intro C i _ _ _ hC
    have hC' : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞) := by rw [hC]; rfl
    rw [MMP.Mori.degreeOn_eq_invertibleCurveDegree,
      ← intersectionNumber_one_eq_invertibleCurveDegree k f i hC'.le N,
      intersectionNumber_one_of_iso_tensorPower k f i hC'.le M N j eN,
      intersectionNumber_one_of_iso_tensorPower k f i hC'.le L M a eM]
    have := hcurve C i hC'
    have hj' : (0 : ℤ) < j := by exact_mod_cast hj
    have ha' : (0 : ℤ) < a := by exact_mod_cast ha
    positivity
  exact (isAmple_tensorPower_iff L M a ha eM).1 ((isAmple_tensorPower_iff M N j hj eN).1 hN)

/-- **The integral case of the Nakai criterion**, given the criterion in lower dimension. -/
private theorem isAmple_of_isIntegral (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f) [IsIntegral X] (n : ℕ)
    (hX : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hpos : 0 < intersectionNumber k f (𝟙 X) (n + 1) hX.le (fun _ => L))
    (hcurve : ∀ (C : Scheme.{u}) (i : C ⟶ X) [IsClosedImmersion i] [IsIntegral C]
      (hC : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞)),
      0 < intersectionNumber k f i 1 hC.le (fun _ => L))
    (ih : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) [IsClosedImmersion j], topologicalKrullDim Y ≤ n →
      Stacks.Ample.IsAmple Y ((Scheme.Modules.pullback j).obj L)) :
    Stacks.Ample.IsAmple X L := by
  obtain ⟨a, ha, s, hs⟩ := exists_section_ne_zero k f hproj n hX L hpos ih
  obtain ⟨M, hM⟩ : ∃ M : X.Modules, M = tensorPower X.presheaf X.ringCatSheaf.2 L a := ⟨_, rfl⟩
  haveI hMinv : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M := hM ▸ inferInstance
  have ihM : ∀ (Y : Scheme.{u}) (j : Y ⟶ X) [IsClosedImmersion j], topologicalKrullDim Y ≤ n →
      Stacks.Ample.IsAmple Y ((Scheme.Modules.pullback j).obj M) := by
    intro Y j _ hY
    exact (isAmple_tensorPower_iff ((Scheme.Modules.pullback j).obj L)
      ((Scheme.Modules.pullback j).obj M) a ha ((Scheme.Modules.pullback j).mapIso (eqToIso hM) ≪≫
        Scheme.Modules.pullbackTensorPowerIntIso j L a)).2 (ih Y j hY)
  obtain ⟨j, hj, hgg⟩ := exists_isGloballyGenerated k f n hX M (hM ▸ s) (by subst hM; exact hs) ihM
  exact isAmple_of_isGloballyGenerated_pow k f hproj L M _ a j ha hj (eqToIso hM) (Iso.refl _) hgg
    hcurve

/-! ### The induction on dimension -/

/-- A nonempty scheme of dimension at most `n` has dimension `d` for some `d ≤ n`. -/
private theorem exists_eq_of_le (Z : Scheme.{u}) [Nonempty Z] {n : ℕ}
    (h : topologicalKrullDim Z ≤ (n : WithBot ℕ∞)) :
    ∃ d : ℕ, d ≤ n ∧ topologicalKrullDim Z = (d : WithBot ℕ∞) := by
  have hne : topologicalKrullDim Z ≠ ⊥ := by
    obtain ⟨x⟩ : Nonempty Z := inferInstance
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds Z) :=
      ⟨⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    exact ne_bot_of_le_ne_bot (by simp)
      (Order.krullDim_nonneg (α := TopologicalSpace.IrreducibleCloseds Z))
  obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hne
  have hle : e ≤ (n : ℕ∞) := by
    rw [← he] at h
    exact_mod_cast h
  obtain ⟨d, rfl⟩ := ENat.ne_top_iff_exists.mp (ne_top_of_le_ne_top (ENat.coe_ne_top n) hle)
  exact ⟨d, by exact_mod_cast hle, he.symm⟩

/-- **The Nakai criterion, with the Stacks intersection numbers**, by induction on an upper
bound `n` for the dimension. -/
private theorem isAmple_of_intersectionNumber_pos (k : Type u) [Field k] (n : ℕ) :
    ∀ {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f], IsProjective f →
      topologicalKrullDim X ≤ (n : WithBot ℕ∞) → ∀ (L : X.Modules)
      [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L],
      (∀ (V : Scheme.{u}) (i : V ⟶ X) [IsClosedImmersion i] [IsIntegral V] (d : ℕ)
        (hd : topologicalKrullDim V = (d : WithBot ℕ∞)), 0 < d →
          0 < intersectionNumber k f i d hd.le (fun _ => L)) →
      Stacks.Ample.IsAmple X L := by
  induction n using Nat.strong_induction_on with
  | _ n ihn =>
  intro X f _ hproj hdim L _ hL
  refine isAmple_of_forall_isIntegral k f L fun Z i _ _ => ?_
  have hZn : topologicalKrullDim Z ≤ (n : WithBot ℕ∞) :=
    ((topologicalKrullDim_range_eq i).symm.le.trans (topologicalKrullDim_subspace_le X _)).trans
      hdim
  obtain ⟨d, hdn, hZ⟩ := exists_eq_of_le Z hZn
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace (i ≫ f)
  rcases d with _ | m
  · haveI : Subsingleton Z :=
      StacksTag09NX.subsingleton_of_topologicalKrullDim_le_zero Z (by rw [hZ]; rfl)
    haveI : IsAffine Z := StacksTag09NX.isAffine_of_subsingleton Z
    exact Stacks.PowerFamilyBridge.isAmple_of_modulesIsAmple Z _
      (Scheme.Modules.isAmple_of_isAffine_of_isInvertible _)
  · refine isAmple_of_isIntegral k (i ≫ f) (isProjective_comp i f hproj) m hZ
      ((Scheme.Modules.pullback i).obj L) ?_ ?_ ?_
    · rw [intersectionNumber_pullback_comp k f i (𝟙 Z) (m + 1) hZ.le (fun _ => L)]
      exact hL Z (𝟙 Z ≫ i) (m + 1) hZ (Nat.succ_pos m)
    · intro C j _ _ hC
      rw [intersectionNumber_pullback_comp k f i j 1 hC.le (fun _ => L)]
      exact hL C (j ≫ i) 1 hC Nat.one_pos
    · intro Y j _ hY
      refine ihn m (by omega) (j ≫ i ≫ f) (isProjective_comp j _ (isProjective_comp i f hproj))
        hY _ fun V v _ _ e he he0 => ?_
      rw [intersectionNumber_pullback_comp k (i ≫ f) j v e he.le
          (fun _ => (Scheme.Modules.pullback i).obj L),
        intersectionNumber_pullback_comp k f i (v ≫ j) e he.le (fun _ => L)]
      exact hL V ((v ≫ j) ≫ i) e he he0

end MMP.Mori.Internal.AlgebraicProjectiveNakai

namespace MMP.Mori

open MMP.Mori.Internal.AlgebraicProjectiveNakai in
/-- **Nakai criterion** (KM Theorem 1.37 (⇐), for `X` projective, with Euler-characteristic
intersection numbers). Let `f : X ⟶ Spec k` be projective and `L` an invertible sheaf on `X`
with `(L^{dim V} · V) > 0` for every closed integral subscheme `V ⊆ X` of positive dimension.
Then `L` is ample. -/
@[mmp "thm_mmp_algebraic_projective_nakai"]
public theorem isAmple_of_sheafSelfIntersectionNumber_pos_of_dim_pos (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [Stacks.Ample.IsInvertibleModule X L]
    (hL : ∀ (V : Scheme.{u}) (i : V ⟶ X) [IsClosedImmersion i] [IsIntegral V] (d : ℕ)
      (hd : topologicalKrullDim V = d), 0 < d → 0 < sheafSelfIntersectionNumber k f i d hd.le L) :
    Stacks.Ample.IsAmple X L := by
  have hne := topologicalKrullDim_ne_top_of_isProper k f
  obtain ⟨n, hn⟩ : ∃ n : ℕ, topologicalKrullDim X ≤ (n : WithBot ℕ∞) := by
    rcases h : topologicalKrullDim X with _ | e
    · exact ⟨0, bot_le⟩
    · rw [h] at hne
      have he : e ≠ ⊤ := fun h' => hne (by rw [h']; rfl)
      obtain ⟨n, rfl⟩ := ENat.ne_top_iff_exists.mp he
      exact ⟨n, le_rfl⟩
  refine isAmple_of_intersectionNumber_pos k n f hproj hn L fun V i _ _ d hd hd0 => ?_
  have h := hL V i d hd hd0
  rwa [sheafSelfIntersectionNumber, sheafIntersectionNumber_eq_intersectionNumber] at h

end MMP.Mori

end Nakai

namespace MMP.Mori

/-- **Nakai–Moishezon criterion** (KM Theorem 1.37 (⇐), for `X` projective). Let `f : X ⟶ Spec k`
be projective and `L` an invertible sheaf on `X` with `(L^{dim Z} · Z) > 0` for every closed
integral subscheme `Z ⊆ X`. Then `L` is ample. This is the converse of
`MMP.Threefold.Mori.sheafSelfIntersectionNumber_pos_of_isAmple`. -/
@[mmp "thm_mmp_projective_nakai"]
public theorem isAmple_of_sheafSelfIntersectionNumber_pos (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (hproj : IsProjective f)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [Stacks.Ample.IsInvertibleModule X L]
    (hL : ∀ (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [IsIntegral Z] (d : ℕ)
      (hd : topologicalKrullDim Z = d), 0 < sheafSelfIntersectionNumber k f i d hd.le L) :
    Stacks.Ample.IsAmple X L :=
  isAmple_of_sheafSelfIntersectionNumber_pos_of_dim_pos k f hproj L
    fun Z i _ _ d hd _ => hL Z i d hd

end MMP.Mori

section Kleiman

open Stacks.SheafOfModules.Invertible

namespace MMP.Mori.Internal.NefNonnegativeDegreesProjective

open MMP.Mori.Internal.AlgebraicProjectiveNakai

/-! ### Auxiliary: mixed intersection numbers against an ample sheaf -/

section Mixed

open AlgebraicGeometry
open Stacks.SheafOfModules.Invertible (tensorPower)

/-- The family with the sheaf `M` in the slots satisfying `lab` and `L` in the others. -/
private def mixFam {X : Scheme.{u}} (L M : X.Modules) {d : ℕ} (lab : Fin d → Prop)
    [DecidablePred lab] : Fin d → X.Modules := fun q => if lab q then M else L

private instance mixFam_isInvertible {X : Scheme.{u}} (L M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M] {d : ℕ} (lab : Fin d → Prop)
    [DecidablePred lab] (q : Fin d) :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (mixFam L M lab q) := by
  unfold mixFam; split_ifs <;> infer_instance

/-- Nonnegativity of an intersection number from nonnegativity on the top-dimensional
components, as `AlgebraicGeometry.intersectionNumber_pos_of_pos_topDimComponents`. -/
private theorem intersectionNumber_nonneg_of_nonneg_topDimComponents (k : Type u) [Field k]
    {X Z : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (i : Z ⟶ X) [IsClosedImmersion i]
    (d : ℕ) (hd : topologicalKrullDim Z = (d : WithBot ℕ∞)) (L : Fin d → X.Modules)
    [∀ j, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L j)]
    (hnn : ∀ W : TopDimIntegralSubscheme
        ((Scheme.Modules.pushforward i).obj (Stacks.Ample.unitModule Z)),
        0 ≤ intersectionNumber k f W.1.subschemeι d
          (topologicalKrullDim_subscheme_le_of_topDimIntegralSubscheme i hd W) L) :
    0 ≤ intersectionNumber k f i d hd.le L := by
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsNoetherian X := ⟨⟩
  haveI hZcoh : (Stacks.Ample.unitModule Z).IsCoherent :=
    Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k (i ≫ f)
  haveI hFcoh : ((Scheme.Modules.pushforward i).obj (Stacks.Ample.unitModule Z)).IsCoherent :=
    isCoherent_pushforward_of_isClosedImmersion i (Stacks.Ample.unitModule Z)
  haveI : Finite (TopDimIntegralSubscheme
      ((Scheme.Modules.pushforward i).obj (Stacks.Ample.unitModule Z))) :=
    finite_topDimIntegralSubscheme k f _
  classical
  haveI : Fintype (TopDimIntegralSubscheme
      ((Scheme.Modules.pushforward i).obj (Stacks.Ample.unitModule Z))) := Fintype.ofFinite _
  rw [intersectionNumber_eq_sum_topDimComponents k f i d hd L, finsum_eq_sum_of_fintype]
  exact Finset.sum_nonneg fun W _ =>
    mul_nonneg (sheafMultiplicity_genericPt_pos k f _ W).le (hnn W)

/-- **The induction behind the mixed nonnegativity** (KM Theorem 1.38, proof), following the proof
of [Stacks, Tag 0BEV] in `AlgebraicGeometry.intersectionNumber_pos`: if `(L^j · W) ≥ 0` for every
integral closed `W` of dimension `j` and `M` is ample, then every closed subscheme `Z` of
dimension `j + s` has `(L^j M^s · Z) ≥ 0`, the family being `L` in some `j` slots and `M` in the
other `s`. -/
private theorem mixed_nonneg_aux (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsProper f] (L M : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    (hM : Stacks.Ample.IsAmple X M) (j : ℕ)
    (hL : ∀ (W : Scheme.{u}) (i : W ⟶ X) [IsClosedImmersion i] [IsIntegral W]
      (hW : topologicalKrullDim W = (j : WithBot ℕ∞)),
      0 ≤ intersectionNumber k f i j hW.le (fun _ => L)) :
    ∀ (s d : ℕ), d = j + s → ∀ {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
      (hdim : topologicalKrullDim Z = (d : WithBot ℕ∞)) (lab : Fin d → Prop)
      [DecidablePred lab], (∑ q, if lab q then 1 else 0) = s →
      0 ≤ intersectionNumber k f i d hdim.le (mixFam L M lab) := by
  classical
  intro s
  induction s with
  | zero =>
    intro d hdj Z i _ hdim lab _ hcnt
    refine intersectionNumber_nonneg_of_nonneg_topDimComponents k f i d hdim _ (fun W => ?_)
    haveI : IsIntegral W.1.subscheme := W.2.1
    have hdimW : topologicalKrullDim W.1.subscheme = (d : WithBot ℕ∞) := by
      refine W.2.2.2.trans ?_
      rw [Stacks.Chow.supp_pushforwardStructureSheaf i, topologicalKrullDim_range_eq i]
      exact hdim
    have hlab : ∀ q, ¬ lab q := by
      intro q hq
      have : 0 < ∑ q, if lab q then 1 else 0 :=
        Finset.sum_pos' (fun _ _ => Nat.zero_le _) ⟨q, Finset.mem_univ _, by simp [hq]⟩
      omega
    have hfam : mixFam L M lab = fun _ => L := funext fun q => if_neg (hlab q)
    have hdj' : d = j := by omega
    subst hdj'
    rw [intersectionNumber_congr_family k f W.1.subschemeι d _ hfam]
    exact hL W.1.subscheme W.1.subschemeι hdimW
  | succ s ih =>
    intro d hdj Z i _ hdim lab _ hcnt
    obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨j + s, by omega⟩
    obtain ⟨q0, hq0⟩ : ∃ q0, lab q0 := by
      by_contra h
      push Not at h
      simp [h] at hcnt
    let σ : Equiv.Perm (Fin (d' + 1)) := Equiv.swap 0 q0
    have hlab0 : lab (σ 0) := by simp [σ, hq0]
    suffices H : ∀ (lab' : Fin (d' + 1) → Prop) [DecidablePred lab'], lab' 0 →
        (∑ q, if lab' q then 1 else 0) = s + 1 →
        0 ≤ intersectionNumber k f i (d' + 1) hdim.le (mixFam L M lab') by
      rw [← intersectionNumber_comp_perm k f i (d' + 1) hdim.le (mixFam L M lab) σ]
      exact H (fun q => lab (σ q)) hlab0
        ((Equiv.sum_comp σ (fun q => if lab q then 1 else 0)).trans hcnt)
    intro lab' _ h0 hcnt'
    set T : Fin d' → X.Modules := mixFam L M (fun t : Fin d' => lab' t.succ) with hT
    have hGeq : mixFam L M lab' = (Fin.cons M T : Fin (d' + 1) → X.Modules) := by
      funext q
      refine Fin.cases ?_ (fun t => ?_) q
      · exact if_pos h0
      · rfl
    haveI hGinv : ∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
        ((Fin.cons M T : Fin (d' + 1) → X.Modules) q) := isInvertible_finCons M T
    rw [intersectionNumber_congr_family k f i (d' + 1) hdim.le hGeq]
    refine intersectionNumber_nonneg_of_nonneg_topDimComponents k f i (d' + 1) hdim _
      (fun W => ?_)
    haveI : IsIntegral W.1.subscheme := W.2.1
    have hdimW : topologicalKrullDim W.1.subscheme = ((d' + 1 : ℕ) : WithBot ℕ∞) := by
      refine W.2.2.2.trans ?_
      rw [Stacks.Chow.supp_pushforwardStructureSheaf i, topologicalKrullDim_range_eq i]
      exact hdim
    have hposdim : 0 < topologicalKrullDim W.1.subscheme := by
      rw [hdimW]
      exact_mod_cast Nat.succ_pos d'
    haveI hMinv : Stacks.Ample.IsInvertibleModule W.1.subscheme
        ((Scheme.Modules.pullback W.1.subschemeι).obj M) := inferInstance
    have hMample : Scheme.Modules.IsAmple W.1.subscheme
        ((Scheme.Modules.pullback W.1.subschemeι).obj M) :=
      Stacks.PowerFamilyBridge.modulesIsAmple_of_isAmple _ _
        (Stacks.AmplePullbackCovering.isAmple_modulePullback_of_immersion_or_isEmbedding
          W.1.subschemeι M hM (Or.inl ⟨inferInstance, inferInstance⟩))
    obtain ⟨n, D, hn, hDcartier, hDne, ⟨e⟩⟩ :=
      exists_effectiveCartierDivisor_tensorPower_of_isAmple k (W.1.subschemeι ≫ f) hposdim
        ((Scheme.Modules.pullback W.1.subschemeι).obj M) hMample
    haveI : Nonempty D.subscheme := hDne
    have hDdim : topologicalKrullDim D.subscheme = (d' : WithBot ℕ∞) :=
      topologicalKrullDim_subscheme_of_isEffectiveCartierDivisor k
        (W.1.subschemeι ≫ f) D hDcartier hdimW
    set G : Fin (d' + 1) → X.Modules := Fin.cons M T with hG
    set N : Fin (d' + 1) → X.Modules :=
      Function.update G 0 (tensorPower X.presheaf X.ringCatSheaf.2 (G 0) (n : ℤ)) with hN
    haveI : ∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (N q) :=
      isInvertible_update G 0 _
    have hNsucc : ∀ t : Fin d', N t.succ = T t := fun t =>
      (Function.update_of_ne (Fin.succ_ne_zero t) _ _).trans (Fin.cons_succ _ _ _)
    have hNiso : (Scheme.Modules.pullback W.1.subschemeι).obj (N 0) ≅
        (Stacks.Divisors.invertibleSheaf D : W.1.subscheme.Modules) :=
      eqToIso (congrArg (Scheme.Modules.pullback W.1.subschemeι).obj
          (Function.update_self (0 : Fin (d' + 1)) _ G)) ≪≫
        Scheme.Modules.pullbackTensorPowerIso W.1.subschemeι (G 0) n ≪≫ e
    haveI : Stacks.Divisors.IsEffectiveCartierDivisor D := hDcartier
    have hBEU := intersectionNumber_eq_of_isEffectiveCartierDivisor k f W.1.subschemeι d'
      (le_of_eq hdimW) N D (le_of_eq hDdim) hNiso
    have hrec : 0 ≤ intersectionNumber k f (D.subschemeι ≫ W.1.subschemeι) d'
        (le_of_eq hDdim) (fun t : Fin d' => N t.succ) := by
      have hNs : (fun t : Fin d' => N t.succ) = T := funext hNsucc
      rw [intersectionNumber_congr_family k f _ d' _ hNs]
      refine ih d' (by omega) (D.subschemeι ≫ W.1.subschemeι) hDdim
        (fun t : Fin d' => lab' t.succ) ?_
      rw [Fin.sum_univ_succ] at hcnt'
      simp only [h0, if_true] at hcnt'
      omega
    have hNnn : 0 ≤ intersectionNumber k f W.1.subschemeι (d' + 1) (le_of_eq hdimW) N := by
      rw [hBEU]; exact hrec
    have hmul := intersectionNumber_update_tensorPower k f W.1.subschemeι (d' + 1)
      (le_of_eq hdimW) G 0 n
    have hn' : (0 : ℤ) < n := by exact_mod_cast hn
    have hprod : 0 ≤ (n : ℤ) * intersectionNumber k f W.1.subschemeι (d' + 1)
        (le_of_eq hdimW) G := by
      rw [← hmul]; exact hNnn
    exact le_of_not_gt fun h => by nlinarith

end Mixed

/-! ### Invertibility of the families used -/

/-- The tensor product `P ⊗ Q` of two modules on a scheme. -/
private noncomputable abbrev tensorObj {X : Scheme.{u}} (P Q : X.Modules) : X.Modules :=
  ((Stacks.SheafOfModules.Tensor.sheafTensor ⟨X.presheaf, Presheaf.isSheaf_of_isSheaf_comp _
    (X.presheaf) (forget₂ CommRingCat RingCat) (X.ringCatSheaf.2)⟩).obj P).obj Q

private theorem isInvertible_tensorObj {X : Scheme.{u}} (P Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 P]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (tensorObj P Q) :=
  Stacks.SheafOfModules.tensorProduct_isInvertible X.presheaf X.ringCatSheaf.2 P Q

private theorem isInvertible_ite {X : Scheme.{u}} (p : Prop) [hp : Decidable p] (P Q : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 P]
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q] :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (if p then P else Q) := by
  cases hp with
  | isTrue h => exact ‹SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 P›
  | isFalse h => exact ‹SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 Q›

/-- The intersection number depends on the closed immersion only through its value. -/
private theorem intersectionNumber_congr_immersion' (k : Type u) [Field k] {X Z : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProper f] {i i' : Z ⟶ X} [IsClosedImmersion i]
    [IsClosedImmersion i'] (h : i = i') (d : ℕ) (hd : topologicalKrullDim Z ≤ d)
    (L : Fin d → X.Modules) [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (L q)] :
    intersectionNumber k f i d hd L = intersectionNumber k f i' d hd L := by
  subst h; rfl

/-- The family with `M` in the slots of `S` and `F` elsewhere. -/
private def selFam {X : Scheme.{u}} {d : ℕ} (S : Finset (Fin d)) (M : X.Modules)
    (F : Fin d → X.Modules) : Fin d → X.Modules := fun q => if q ∈ S then M else F q

private theorem isInvertible_selFam {X : Scheme.{u}} {d : ℕ} (S : Finset (Fin d)) (M : X.Modules)
    (F : Fin d → X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 M]
    [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (F q)] (q : Fin d) :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (selFam S M F q) := by
  unfold selFam; exact isInvertible_ite _ _ _

attribute [local instance] isInvertible_tensorObj isInvertible_ite isInvertible_selFam

/-! ### Multilinear expansion -/

section Expansion

variable (k : Type u) [Field k] {X Z : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f]
  (i : Z ⟶ X) [IsClosedImmersion i] (d : ℕ) (hd : topologicalKrullDim Z ≤ d)
  (L A : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
  [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 A] (a b : ℕ)

/-- Additivity in one slot holding `L^b ⊗ A^a`. -/
private theorem intersectionNumber_slot (G : Fin d → X.Modules)
    [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (G q)] (x : Fin d)
    (hx : G x = tensorObj (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ))
      (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ))) :
    haveI := isInvertible_update G x L
    haveI := isInvertible_update G x A
    intersectionNumber k f i d hd G =
      b * intersectionNumber k f i d hd (Function.update G x L) +
        a * intersectionNumber k f i d hd (Function.update G x A) := by
  haveI := isInvertible_update G x L
  haveI := isInvertible_update G x A
  haveI := isInvertible_update G x (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ))
  haveI := isInvertible_update G x (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ))
  have h := intersectionNumber_tensor k f i d hd x G
    (Function.update G x (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ)))
    (Function.update G x (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ)))
    (fun q hq => Function.update_of_ne hq _ _) (fun q hq => Function.update_of_ne hq _ _)
    (eqToIso (hx.trans (congrArg₂ (fun P Q => tensorObj P Q)
      (Function.update_self x _ G).symm (Function.update_self x _ G).symm)))
  rw [h]
  have hL := intersectionNumber_update_tensorPower k f i d hd (Function.update G x L) x b
  have hA := intersectionNumber_update_tensorPower k f i d hd (Function.update G x A) x a
  have eL : Function.update G x (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ)) =
      Function.update (Function.update G x L) x
        (tensorPower X.presheaf X.ringCatSheaf.2 (Function.update G x L x) (b : ℤ)) := by
    simp only [Function.update_idem, Function.update_self]
    exact (Function.update_idem _ _ _).symm
  have eA : Function.update G x (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ)) =
      Function.update (Function.update G x A) x
        (tensorPower X.presheaf X.ringCatSheaf.2 (Function.update G x A x) (a : ℤ)) := by
    simp only [Function.update_idem, Function.update_self]
    exact (Function.update_idem _ _ _).symm
  haveI := isInvertible_update (Function.update G x L) x
    (tensorPower X.presheaf X.ringCatSheaf.2 (Function.update G x L x) (b : ℤ))
  haveI := isInvertible_update (Function.update G x A) x
    (tensorPower X.presheaf X.ringCatSheaf.2 (Function.update G x A x) (a : ℤ))
  rw [intersectionNumber_congr_family k f i d hd eL, hL,
    intersectionNumber_congr_family k f i d hd eA, hA]

/-- **Multilinear expansion** of `(N^{|P|} · M · Z)` for `N = L^b ⊗ A^a` in the slots of `P`:
`∑_{S ⊆ P} a^{|S|} b^{|P| - |S|}` times the number with `A` on `S` and `L` on `P \ S`. -/
private theorem intersectionNumber_expand (P : Finset (Fin d)) (B : Fin d → X.Modules)
    [∀ q, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (B q)] :
    intersectionNumber k f i d hd (selFam P
        (tensorObj (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ))
          (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ))) B) =
      ∑ S ∈ P.powerset, (a : ℤ) ^ S.card * (b : ℤ) ^ (P.card - S.card) *
        intersectionNumber k f i d hd (selFam S A (selFam P L B)) := by
  classical
  induction P using Finset.induction_on generalizing B with
  | empty =>
    simp only [Finset.powerset_empty, Finset.sum_singleton, Finset.card_empty, pow_zero,
      Nat.sub_zero, one_mul]
    exact intersectionNumber_congr_family k f i d hd (funext fun q => by simp [selFam])
  | insert x P hx ih =>
    set N := tensorObj (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ))
      (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ))
    haveI := isInvertible_update B x N
    have h1 := ih (Function.update B x N)
    rw [intersectionNumber_congr_family k f i d hd (M := selFam P N (Function.update B x N))
      (funext fun q => by
        by_cases hq : q = x
        · subst hq; simp [selFam, hx] <;> rfl
        · simp [selFam, Finset.mem_insert, hq] <;> rfl), h1, Finset.sum_powerset_insert hx,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun S hS => ?_
    have hSP : S ⊆ P := Finset.mem_powerset.mp hS
    have hxS : x ∉ S := fun h => hx (hSP h)
    have hcard : S.card ≤ P.card := Finset.card_le_card hSP
    set G : Fin d → X.Modules := selFam S A (selFam P L (Function.update B x N))
    have hs := intersectionNumber_slot k f i d hd L A a b G x (by simp [G, selFam, hxS, hx] <;> rfl)
    haveI := isInvertible_update G x L
    haveI := isInvertible_update G x A
    rw [hs, intersectionNumber_congr_family k f i d hd (L := Function.update G x L)
        (M := selFam S A (selFam (insert x P) L B))
        (funext fun q => by
          by_cases hq : q = x
          · subst hq; simp [selFam, hxS]
          · simp [G, selFam, Function.update_of_ne hq, Finset.mem_insert, hq]),
      intersectionNumber_congr_family k f i d hd (L := Function.update G x A)
        (M := selFam (insert x S) A (selFam (insert x P) L B))
        (funext fun q => by
          by_cases hq : q = x
          · subst hq; simp [selFam]
          · simp [G, selFam, Function.update_of_ne hq, Finset.mem_insert, hq])]
    rw [Finset.card_insert_of_notMem hx, Finset.card_insert_of_notMem hxS,
      show P.card + 1 - S.card = (P.card - S.card) + 1 by omega,
      show P.card + 1 - (S.card + 1) = P.card - S.card by omega]
    ring

/-- **The expansion as a polynomial in `a / b`**: for `N = L^b ⊗ A^a` in the slots of `P` and
`L` in the others, `(N^{|P|} L^{d - |P|} · Z) = b^{|P|} ∑_{S ⊆ P} (a / b)^{|S|} e_S(Z)`, where
`e_S(Z)` is the number with `A` on `S` and `L` elsewhere. -/
private theorem intersectionNumber_selFam_eq_pow_mul_sum (hb : 0 < b) (P : Finset (Fin d)) :
    (intersectionNumber k f i d hd (selFam P
        (tensorObj (tensorPower X.presheaf X.ringCatSheaf.2 L (b : ℤ))
          (tensorPower X.presheaf X.ringCatSheaf.2 A (a : ℤ))) (fun _ => L)) : ℝ) =
      (b : ℝ) ^ P.card * ∑ S ∈ P.powerset, ((a : ℝ) / b) ^ S.card *
        (intersectionNumber k f i d hd (selFam S A (fun _ => L)) : ℝ) := by
  rw [intersectionNumber_expand]
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun S hS => ?_
  obtain ⟨r, hr⟩ : ∃ r, P.card = S.card + r :=
    ⟨_, (Nat.add_sub_cancel' (Finset.card_le_card (Finset.mem_powerset.mp hS))).symm⟩
  rw [intersectionNumber_congr_family k f i d hd (M := selFam S A (fun _ => L))
    (funext fun q => by simp only [selFam]; split_ifs <;> rfl), hr, Nat.add_sub_cancel_left,
    pow_add, div_pow]
  have : (b : ℝ) ≠ 0 := by positivity
  field_simp

end Expansion

/-! ### The real-variable argument -/

/-- The numerical heart of Kleiman's argument (KM (1.5)): if `e_∅ < 0`, `e_S ≥ 0` for `S ≠ ∅`
and `e_{univ} > 0`, there is a positive rational `q` with `F(q) > 0` and `G(q) < 0`, where
`F(t) = ∑_S t^{|S|} e_S` and `G(t) = ∑_{0 ∉ S} t^{|S|} e_S`. -/
private theorem exists_rat_sum_pos_sum_neg (m : ℕ) (e : Finset (Fin (m + 1)) → ℝ)
    (h0 : e ∅ < 0) (hnn : ∀ S, S ≠ ∅ → 0 ≤ e S) (hU : 0 < e Finset.univ) :
    ∃ q : ℚ, 0 < q ∧ 0 < ∑ S ∈ (Finset.univ : Finset (Fin (m + 1))).powerset,
        (q : ℝ) ^ S.card * e S ∧
      ∑ S ∈ (Finset.univ.erase (0 : Fin (m + 1))).powerset, (q : ℝ) ^ S.card * e S < 0 := by
  classical
  set P0 := (Finset.univ : Finset (Fin (m + 1))).erase 0
  let F : ℝ → ℝ := fun t => ∑ S ∈ (Finset.univ : Finset (Fin (m + 1))).powerset,
    t ^ S.card * e S
  let G : ℝ → ℝ := fun t => ∑ S ∈ P0.powerset, t ^ S.card * e S
  let H : ℝ → ℝ := fun t => ∑ S ∈ P0.powerset, t ^ S.card * e (insert 0 S)
  have h0P : (0 : Fin (m + 1)) ∉ P0 := Finset.notMem_erase _ _
  have hins : insert (0 : Fin (m + 1)) P0 = Finset.univ := Finset.insert_erase (Finset.mem_univ _)
  have hFGH : ∀ t, F t = G t + t * H t := by
    intro t
    simp only [F, G, H]
    rw [← hins, Finset.sum_powerset_insert h0P, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun S hS => ?_
    have h0S : (0 : Fin (m + 1)) ∉ S := fun h => h0P (Finset.mem_powerset.mp hS h)
    rw [Finset.card_insert_of_notMem h0S, pow_succ]
    ring
  have hcF : Continuous F := by fun_prop
  have hcG : Continuous G := by fun_prop
  have hU0 : (Finset.univ : Finset (Fin (m + 1))) ≠ ∅ := Finset.univ_nonempty.ne_empty
  have hUmem : (Finset.univ : Finset (Fin (m + 1))) ∈
      ((Finset.univ : Finset (Fin (m + 1))).powerset.erase ∅) :=
    Finset.mem_erase.mpr ⟨hU0, Finset.mem_powerset.mpr le_rfl⟩
  -- `F(t) ≥ e_∅ + t^{m+1} e_univ` for `t ≥ 0`
  have hFlow : ∀ t : ℝ, 0 ≤ t → e ∅ + t ^ (m + 1) * e Finset.univ ≤ F t := by
    intro t ht
    simp only [F]
    rw [← Finset.add_sum_erase _ _ (Finset.empty_mem_powerset _)]
    simp only [Finset.card_empty, pow_zero, one_mul, add_le_add_iff_left]
    have := Finset.single_le_sum (f := fun S => t ^ S.card * e S)
      (fun S hS => mul_nonneg (pow_nonneg ht _) (hnn S (Finset.ne_of_mem_erase hS))) hUmem
    simpa [Finset.card_univ, Fintype.card_fin] using this
  have hF0 : F 0 = e ∅ := by
    simp only [F]
    rw [Finset.sum_eq_single (∅ : Finset (Fin (m + 1)))]
    · simp
    · intro S _ hS
      rw [zero_pow (by simpa [Finset.card_eq_zero] using hS), zero_mul]
    · exact fun h => absurd (Finset.empty_mem_powerset _) h
  -- a point where `F` is nonnegative
  set T : ℝ := 1 + (-e ∅) / e Finset.univ
  have hT1 : 1 ≤ T := by linarith [div_nonneg (by linarith : 0 ≤ -e ∅) hU.le]
  have hFT : 0 ≤ F T := by
    have hTU : T * e Finset.univ = e Finset.univ + -e ∅ := by
      simp only [T]
      field_simp
    linarith [hFlow T (by linarith),
      mul_le_mul_of_nonneg_right (le_self_pow₀ hT1 (by omega : m + 1 ≠ 0)) hU.le]
  -- a root `t₀ ∈ (0, T]`
  obtain ⟨t₀, ⟨ht₀0, ht₀T⟩, hFt₀⟩ : ∃ t₀ ∈ Set.Icc (0 : ℝ) T, F t₀ = 0 :=
    intermediate_value_Icc (by linarith) hcF.continuousOn ⟨by rw [hF0]; exact h0.le, hFT⟩
  have ht₀pos : 0 < t₀ := by
    rcases ht₀0.lt_or_eq with h | h
    · exact h
    · rw [← h, hF0] at hFt₀
      linarith
  -- `F > 0` to the right of `t₀`
  have hFpos : ∀ s : ℝ, t₀ < s → 0 < F s := by
    intro s hs
    have hdiff : F s - F t₀ = ∑ S ∈ (Finset.univ : Finset (Fin (m + 1))).powerset,
        (s ^ S.card - t₀ ^ S.card) * e S := by
      simp only [F, ← Finset.sum_sub_distrib, sub_mul]
    have hterm : ∀ S ∈ (Finset.univ : Finset (Fin (m + 1))).powerset,
        0 ≤ (s ^ S.card - t₀ ^ S.card) * e S := by
      intro S _
      by_cases hS : S = ∅
      · subst hS; simp
      · exact mul_nonneg (sub_nonneg.mpr (pow_le_pow_left₀ ht₀pos.le hs.le _)) (hnn S hS)
    have hlt : 0 < (s ^ (Finset.univ : Finset (Fin (m + 1))).card -
        t₀ ^ (Finset.univ : Finset (Fin (m + 1))).card) * e Finset.univ := by
      refine mul_pos (sub_pos.mpr (pow_lt_pow_left₀ hs ht₀pos.le ?_)) hU
      simp
    have := Finset.single_le_sum hterm (Finset.mem_powerset.mpr (le_refl Finset.univ))
    linarith
  -- `H(t₀) > 0`, hence `G(t₀) < 0`
  have hH : 0 < H t₀ := by
    have hterm : ∀ S ∈ P0.powerset, 0 ≤ t₀ ^ S.card * e (insert 0 S) := fun S _ =>
      mul_nonneg (pow_nonneg ht₀pos.le _) (hnn _ (Finset.insert_ne_empty _ _))
    have hlt : 0 < t₀ ^ P0.card * e (insert 0 P0) := by
      rw [hins]; exact mul_pos (pow_pos ht₀pos _) hU
    exact hlt.trans_le (Finset.single_le_sum hterm (Finset.mem_powerset.mpr le_rfl))
  have hGt₀ : G t₀ < 0 := by
    have := hFGH t₀
    rw [hFt₀] at this
    nlinarith
  -- a rational point slightly to the right of `t₀`
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (isOpen_lt hcG continuous_const) t₀ hGt₀
  obtain ⟨q, hq1, hq2⟩ := exists_rat_btwn (show t₀ < t₀ + ε by linarith)
  refine ⟨q, by exact_mod_cast ht₀pos.trans hq1, hFpos q hq1, ?_⟩
  exact hball (by
    rw [Metric.mem_ball, Real.dist_eq, abs_lt]
    constructor <;> linarith)

/-! ### The inductive step -/

/-- The mixed number `e_S(Z)`: `A` in the slots of `S`, `L` in the others. -/
private theorem mixFam_eq {X : Scheme.{u}} (L A : X.Modules) {d : ℕ} (S : Finset (Fin d)) :
    mixFam L A (fun q => q ∈ S) = selFam S A (fun _ => L) := rfl

/-- **The inductive step of Kleiman's theorem.** On an integral projective `k`-scheme `Y` of
dimension `m + 1` with an ample `A`, an invertible `L` that is nonnegative on every closed
integral subscheme of smaller dimension and on every curve satisfies `(L^{m+1}) ≥ 0`. -/
private theorem selfIntersection_nonneg_step (k : Type u) [Field k] {Y : Scheme.{u}}
    (g : Y ⟶ Spec (.of k)) [IsProper g] [IsIntegral Y] (hproj : IsProjective g)
    (A : Y.Modules) [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 A]
    (hA : Stacks.Ample.IsAmple Y A) (L : Y.Modules)
    [SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 L] (m : ℕ)
    (hY : topologicalKrullDim Y = ((m + 1 : ℕ) : WithBot ℕ∞))
    (H1 : ∀ (W : Scheme.{u}) (j : W ⟶ Y) [IsClosedImmersion j] [IsIntegral W] (e : ℕ)
      (hW : topologicalKrullDim W = (e : WithBot ℕ∞)), e < m + 1 →
        0 ≤ intersectionNumber k g j e hW.le (fun _ => L))
    (H2 : ∀ (W : Scheme.{u}) (j : W ⟶ Y) [IsClosedImmersion j] [IsIntegral W]
      (hW : topologicalKrullDim W = ((1 : ℕ) : WithBot ℕ∞)),
        0 ≤ intersectionNumber k g j 1 hW.le (fun _ => L)) :
    0 ≤ intersectionNumber k g (𝟙 Y) (m + 1) hY.le (fun _ => L) := by
  classical
  by_contra hneg
  push Not at hneg
  -- positivity of an ample sheaf
  have hApos : ∀ (W : Scheme.{u}) (j : W ⟶ Y) [IsClosedImmersion j] (e : ℕ)
      (hW : topologicalKrullDim W = (e : WithBot ℕ∞)),
      0 < intersectionNumber k g j e hW.le (fun _ => A) := fun W j _ e hW =>
    selfIntersectionNumber_pos k g j e hW A
      (Stacks.PowerFamilyBridge.modulesIsAmple_of_isAmple _ _ hA)
  -- mixed numbers are nonnegative below the top slot count
  have hmix : ∀ (W : Scheme.{u}) (j : W ⟶ Y) [IsClosedImmersion j] (e : ℕ)
      (hW : topologicalKrullDim W = (e : WithBot ℕ∞)), e ≤ m + 1 →
      ∀ S : Finset (Fin e), S ≠ ∅ ∨ e < m + 1 →
        0 ≤ intersectionNumber k g j e hW.le (selFam S A (fun _ => L)) := by
    intro W j _ e hW he S hS
    have hcard : S.card ≤ e := by simpa using Finset.card_le_univ S
    have h := mixed_nonneg_aux k g L A hA (e - S.card) (fun W' j' _ _ hW' =>
      H1 W' j' (e - S.card) hW' (by
        rcases hS with hS | hS
        · have := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hS); omega
        · omega)) S.card e (by omega) j hW (fun q => q ∈ S) (by
          rw [Finset.sum_boole, Finset.filter_mem_eq_inter, Finset.univ_inter, Nat.cast_id])
    rwa [intersectionNumber_congr_family k g j e hW.le (mixFam_eq L A S)] at h
  obtain ⟨e, he⟩ : ∃ e : Finset (Fin (m + 1)) → ℝ, ∀ S, e S =
      (intersectionNumber k g (𝟙 Y) (m + 1) hY.le (selFam S A (fun _ => L)) : ℝ) :=
    ⟨_, fun _ => rfl⟩
  have he0 : e ∅ < 0 := by
    rw [he, intersectionNumber_congr_family k g (𝟙 Y) (m + 1) hY.le (M := fun _ => L)
      (funext fun q => by simp [selFam])]
    exact_mod_cast hneg
  have hnn : ∀ S, S ≠ ∅ → 0 ≤ e S := fun S hS => by
    rw [he]; exact_mod_cast hmix Y (𝟙 Y) (m + 1) hY le_rfl S (Or.inl hS)
  have hU : 0 < e Finset.univ := by
    rw [he, intersectionNumber_congr_family k g (𝟙 Y) (m + 1) hY.le (M := fun _ => A)
      (funext fun q => by simp [selFam])]
    exact_mod_cast hApos Y (𝟙 Y) (m + 1) hY
  obtain ⟨q, hq0, hFq, hGq⟩ := exists_rat_sum_pos_sum_neg m e he0 hnn hU
  -- `q = a / b`
  set a : ℕ := q.num.toNat
  set b : ℕ := q.den
  have hnum : (0 : ℤ) < q.num := Rat.num_pos.mpr hq0
  have ha : (a : ℤ) = q.num := Int.toNat_of_nonneg hnum.le
  have hb : 0 < b := q.den_pos
  have ha0 : (0 : ℤ) < a := ha ▸ hnum
  have hqab : (q : ℝ) = (a : ℝ) / b := by
    rw [← Rat.num_div_den q]
    push_cast
    rw [show ((a : ℕ) : ℝ) = ((q.num : ℤ) : ℝ) by exact_mod_cast ha]
  simp only [he, hqab] at hFq hGq
  set N := tensorObj (tensorPower Y.presheaf Y.ringCatSheaf.2 L (b : ℤ))
    (tensorPower Y.presheaf Y.ringCatSheaf.2 A (a : ℤ)) with hNdef
  -- the self-intersection of `N` on `Y` is `b^{m+1} F(a / b) > 0`
  have hNtop : 0 < intersectionNumber k g (𝟙 Y) (m + 1) hY.le (fun _ => N) := by
    have h : (0 : ℝ) < intersectionNumber k g (𝟙 Y) (m + 1) hY.le
        (selFam Finset.univ N (fun _ => L)) := by
      rw [intersectionNumber_selFam_eq_pow_mul_sum k g (𝟙 Y) (m + 1) hY.le L A a b hb]
      exact mul_pos (by positivity) hFq
    rw [intersectionNumber_congr_family k g (𝟙 Y) (m + 1) hY.le
      (L := fun _ => N) (M := selFam Finset.univ N (fun _ => L))
      (funext fun q => by simp [selFam])]
    exact_mod_cast h
  -- `N` is ample
  have hdimle : ∀ (W : Scheme.{u}) (j : W ⟶ Y) [IsClosedImmersion j],
      topologicalKrullDim W ≤ topologicalKrullDim Y := fun W j _ =>
    j.isClosedEmbedding.isInducing.topologicalKrullDim_le
  have hNample : Stacks.Ample.IsAmple Y N := by
    refine MMP.Mori.isAmple_of_sheafSelfIntersectionNumber_pos k g hproj N ?_
    intro W j _ _ e' hW
    unfold MMP.Mori.sheafSelfIntersectionNumber
    rw [sheafIntersectionNumber_eq_intersectionNumber]
    have he'le : e' ≤ m + 1 := by
      have := hdimle W j
      rw [hW, hY] at this
      exact_mod_cast this
    rcases he'le.lt_or_eq with hlt | heq
    · have hx := intersectionNumber_expand k g j e' hW.le L A a b Finset.univ (fun _ => L)
      rw [intersectionNumber_congr_family k g j e' hW.le
        (L := fun _ => N) (M := selFam Finset.univ N (fun _ => L))
        (funext fun q => by simp [selFam]), hx]
      refine Finset.sum_pos' (fun S _ => ?_) ⟨Finset.univ, Finset.mem_powerset.mpr le_rfl, ?_⟩
      · refine mul_nonneg (by positivity) ?_
        rw [intersectionNumber_congr_family k g j e' hW.le
          (M := selFam S A (fun _ => L)) (funext fun q => by simp only [selFam]; split_ifs <;> rfl)]
        exact hmix W j e' hW he'le S (Or.inr hlt)
      · refine mul_pos (mul_pos (pow_pos ha0 _) (pow_pos (by exact_mod_cast hb) _)) ?_
        rw [intersectionNumber_congr_family k g j e' hW.le (M := fun _ => A)
          (funext fun q => by simp [selFam])]
        exact hApos W j e' hW
    · subst heq
      -- `W` is all of `Y`
      have hsurj : Function.Surjective j := by
        by_contra hns
        have hne : Set.range j.base ≠ Set.univ := fun h =>
          hns (Set.range_eq_univ.mp h)
        have hlt := topologicalKrullDim_lt_of_isClosed_ne_univ j.isClosedEmbedding.isClosed_range
          hne (by rw [hY]; exact WithBot.coe_lt_coe.mpr (by simp))
        rw [topologicalKrullDim_range_eq j, hW, hY] at hlt
        exact lt_irrefl _ hlt
      haveI : Surjective j := ⟨hsurj⟩
      haveI : IsIso j := isIso_of_isClosedImmersion_of_surjective j
      haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian g
      rw [intersectionNumber_eq_intersectionNumber_id k g j (m + 1) hW.le hY.le]
      exact hNtop
  -- `(L · N^m) ≥ 0`
  have hLN := mixed_nonneg_aux k g L N hNample 1 H2 m (m + 1) (by omega)
    (𝟙 Y) hY (fun q => q ∈ Finset.univ.erase (0 : Fin (m + 1))) (by
      rw [Finset.sum_boole, Finset.filter_mem_eq_inter, Finset.univ_inter, Nat.cast_id,
        Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin,
        Nat.add_sub_cancel])
  -- but it is `b^m G(a / b) < 0`
  rw [intersectionNumber_congr_family k g (𝟙 Y) (m + 1) hY.le (mixFam_eq L N _)] at hLN
  have h := Int.cast_nonneg (R := ℝ) hLN
  rw [intersectionNumber_selFam_eq_pow_mul_sum k g (𝟙 Y) (m + 1) hY.le L A a b hb] at h
  exact absurd h (not_le.mpr (mul_neg_of_pos_of_neg (by positivity) hGq))

end MMP.Mori.Internal.NefNonnegativeDegreesProjective

namespace MMP.Mori

open MMP.Mori.Internal.AlgebraicProjectiveNakai
  MMP.Mori.Internal.NefNonnegativeDegreesProjective in
/-- **Kleiman's theorem, projective case** (Kollár–Mori, Theorem 1.38). Let `X` be a projective
variety over `k` and `L` a nef invertible sheaf on `X`. Then `(L^{dim Z} · Z) ≥ 0` for every
closed integral subscheme `i : Z ⟶ X`. -/
@[mmp "thm_km1b_nef_nonnegative_degrees_projective"]
public theorem sheafSelfIntersectionNumber_nonneg_of_isNef (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (hX : IsProjectiveVariety k f)
    (L : X.Modules) [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    (hL : IsNef k f L) (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [IsIntegral Z]
    {d : ℕ} (hZ : topologicalKrullDim Z = d) :
    0 ≤ sheafSelfIntersectionNumber k f i d hZ.le L := by
  unfold MMP.Mori.sheafSelfIntersectionNumber
  rw [sheafIntersectionNumber_eq_intersectionNumber]
  -- an ample sheaf on `X`
  have hprojM : IsProjectiveMorphism f := hX.isProjective
  obtain ⟨M, hMinv, hMample⟩ := Stacks.HProjective.exists_isAmple_of_isAffine (Spec (.of k))
  obtain ⟨A, hAinv, hA⟩ := exists_isAmple_of_isProjectiveMorphism f M hMample hprojM
  haveI : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 A := hAinv
  -- nonnegativity on curves
  have hcurve : ∀ (C : Scheme.{u}) (j : C ⟶ X) [IsClosedImmersion j] [IsIntegral C]
      (hC : topologicalKrullDim C = ((1 : ℕ) : WithBot ℕ∞)),
      0 ≤ intersectionNumber k f j 1 hC.le (fun _ => L) := by
    intro C j _ _ hC
    have h := hL C j (by exact_mod_cast hC)
    rw [MMP.Mori.degreeOn_eq_invertibleCurveDegree,
      ← intersectionNumber_one_eq_invertibleCurveDegree] at h
    exact h
  induction d using Nat.strong_induction_on generalizing Z with
  | _ n ih =>
    rcases n with _ | m
    · exact (intersectionNumber_pos_of_topologicalKrullDim_eq_zero k f i hZ _).le
    · have hZproj : IsProjective (i ≫ f) := isProjective_comp i f hprojM.isProjective
      have hAZ : Stacks.Ample.IsAmple Z ((Scheme.Modules.pullback i).obj A) :=
        Stacks.AmplePullbackCovering.isAmple_modulePullback_of_immersion_or_isEmbedding i A hA
          (Or.inl ⟨inferInstance, inferInstance⟩)
      have key := selfIntersection_nonneg_step k (i ≫ f) hZproj
        ((Scheme.Modules.pullback i).obj A) hAZ ((Scheme.Modules.pullback i).obj L) m hZ
        (fun W j _ _ e hW he => by
          rw [intersectionNumber_pullback_comp]
          exact ih e he W (j ≫ i) hW)
        (fun W j _ _ hW => by
          rw [intersectionNumber_pullback_comp]
          exact hcurve W (j ≫ i) hW)
      rwa [intersectionNumber_pullback_comp,
        intersectionNumber_congr_immersion' k f (Category.id_comp i)] at key

end MMP.Mori

end Kleiman

