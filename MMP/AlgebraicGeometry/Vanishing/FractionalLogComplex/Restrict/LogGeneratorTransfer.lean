module

public import MMP.AlgebraicGeometry.Vanishing.FractionalLogComplex.Construction

/-!
# Transport of logarithmic generators along an isomorphism of total rings of forms

Let `A₁` and `A₂` be graded algebras of presheaves of modules, possibly over different sites
and rings, and fix objects `X₁`, `X₂`. A family of additive maps `eᵢ : A₁ᵢ(X₁) → A₂ᵢ(X₂)`
that turns the graded multiplication of `A₁` into that of `A₂` and the unit into the unit
induces a ring homomorphism between the total rings `⨁ᵢ A₁ᵢ(X₁) → ⨁ᵢ A₂ᵢ(X₂)`; when every `eᵢ` is
bijective, so is it.

For the total rings of forms on `X₁ ∖ D₁` and `X₂ ∖ D₂` over affine opens `W₁`, `W₂`, such a ring
homomorphism `Φ`, together with ring maps `ψ` on functions on `Wᵢ ∖ Dᵢ` and `β` on functions on
`Wᵢ`, compatible with the structure maps, with `d` and with restriction to `Wᵢ ∖ Dᵢ`, carries the
logarithmic generators over `W₁` into the subring generated by those over `W₂`, as soon as
every local equation over `W₁` of a component of `D₁` is carried by `β` to a local equation of a
component of `D₂`, or to a unit. If moreover `β` carries `I₁(W₁)` into `I₂(W₂)`, then `Φ`
carries the `I₁`-multiples of logarithmic forms over `W₁` into the `I₂`-multiples over `W₂`.

## Main definitions

* `MMP.FourfoldProofs.FractionalLogComplexProof.totalRingHomOfMul`: the ring homomorphism of total
  rings induced by multiplicative unital degreewise maps.
* `MMP.FourfoldProofs.FractionalLogComplexProof.totalRingEquivOfMul`: the ring isomorphism induced by
  multiplicative unital degreewise isomorphisms.
* `MMP.FourfoldProofs.FractionalLogComplexProof.gradedTotalRingEquivOfMul`: the same for two sheaves of
  `ℤ`-graded algebras.
* `MMP.FourfoldProofs.FractionalLogComplexProof.gensOn`,
  `MMP.FourfoldProofs.FractionalLogComplexProof.brSetOn`: the logarithmic generators and their
  `I`-multiples, read on the forms of an arbitrary open `Uc ⊆ X`; for `Uc = X ∖ D` they are those
  of the definition of logarithmic forms.

## Main results

* `MMP.FourfoldProofs.FractionalLogComplexProof.mem_brSetOn_cU_iff`: `brSetOn` for `Uc = X ∖ D` is the
  condition of the definition of logarithmic forms.
* `MMP.FourfoldProofs.FractionalLogComplexProof.map_mem_closure_gensOn`: the generators are carried
  into the subring generated by the generators.
* `MMP.FourfoldProofs.FractionalLogComplexProof.map_mem_brSetOn`: the `I`-multiples of logarithmic
  forms are carried into the `I`-multiples of logarithmic forms.

## Implementation notes

The generators are stated for an arbitrary open `Uc` rather than for the spelling `X ∖ D` of the
definition, so that both sides of a comparison can be written with the same spelling of the
complement as the comparison of forms uses; the two spellings are definitionally equal.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite

namespace MMP.FourfoldProofs.FractionalLogComplexProof

section TotalEquiv

universe w v₁ v₂ u₁ u₂

variable {C₁ : Type u₁} [Category.{v₁} C₁] {C₂ : Type u₂} [Category.{v₂} C₂]
  {R₁ : C₁ᵒᵖ ⥤ RingCat.{w}} {R₂ : C₂ᵒᵖ ⥤ RingCat.{w}} {ι : Type} [DecidableEq ι] [AddMonoid ι]
  {P₁ : ι → PresheafOfModules.{w} R₁} {P₂ : ι → PresheafOfModules.{w} R₂}
  (A₁ : Stacks.GradedAlgebra P₁) (A₂ : Stacks.GradedAlgebra P₂) (X₁ : C₁ᵒᵖ) (X₂ : C₂ᵒᵖ)

/-- **The ring homomorphism of total rings induced by degreewise maps** which turn the graded
multiplication into the graded multiplication and the unit into the unit. -/
noncomputable def totalRingHomOfMul (e : ∀ i, (P₁ i).obj X₁ →+ (P₂ i).obj X₂)
    (hone : e 0 (A₁.one.eval X₁) = A₂.one.eval X₂)
    (hmul : ∀ (i j : ι) (x : (P₁ i).obj X₁) (y : (P₁ j).obj X₁),
      e (i + j) ((A₁.mul i j).app X₁ x y) = (A₂.mul i j).app X₂ (e i x) (e j y)) :
    A₁.Total X₁ →+* A₂.Total X₂ :=
  letI := A₁.gring X₁
  DirectSum.toSemiring (A := fun i => ((P₁ i).obj X₁ : Type w))
    (fun i => AddMonoidHom.mk' (fun x => A₂.incl i (e i x))
      (fun x y => by rw [map_add, A₂.incl_add]))
    (by
      change A₂.incl 0 (e 0 (A₁.one.eval X₁)) = 1
      rw [hone, A₂.one_eq_incl])
    (fun {i j} x y => by
      change A₂.incl (i + j) (e (i + j) ((A₁.mul i j).app X₁ x y)) =
        A₂.incl i (e i x) * A₂.incl j (e j y)
      rw [hmul, A₂.incl_mul_incl])

/-- `totalRingHomOfMul` sends the inclusion of `x` in degree `i` to the inclusion of `e i x` in
degree `i`. -/
@[simp]
theorem totalRingHomOfMul_incl (e : ∀ i, (P₁ i).obj X₁ →+ (P₂ i).obj X₂)
    (hone : e 0 (A₁.one.eval X₁) = A₂.one.eval X₂)
    (hmul : ∀ (i j : ι) (x : (P₁ i).obj X₁) (y : (P₁ j).obj X₁),
      e (i + j) ((A₁.mul i j).app X₁ x y) = (A₂.mul i j).app X₂ (e i x) (e j y))
    (i : ι) (x : (P₁ i).obj X₁) :
    totalRingHomOfMul A₁ A₂ X₁ X₂ e hone hmul (A₁.incl i x) = A₂.incl i (e i x) :=
  letI := A₁.gring X₁
  DirectSum.toSemiring_of (A := fun i => ((P₁ i).obj X₁ : Type w)) _ _ _ i x

variable (e : ∀ i, (P₁ i).obj X₁ ≃+ (P₂ i).obj X₂)
  (hone : e 0 (A₁.one.eval X₁) = A₂.one.eval X₂)
  (hmul : ∀ (i j : ι) (x : (P₁ i).obj X₁) (y : (P₁ j).obj X₁),
    e (i + j) ((A₁.mul i j).app X₁ x y) = (A₂.mul i j).app X₂ (e i x) (e j y))

omit [DecidableEq ι] in
include hone in
/-- The inverse of `e 0` sends the unit of `A₂` to the unit of `A₁`. -/
theorem degreewise_symm_one : (e 0).symm (A₂.one.eval X₂) = A₁.one.eval X₁ :=
  (AddEquiv.symm_apply_eq _).2 hone.symm

omit [DecidableEq ι] in
include hmul in
/-- The inverses of the degreewise isomorphisms turn the graded multiplication of `A₂` into that
of `A₁`. -/
theorem degreewise_symm_mul (i j : ι) (x : (P₂ i).obj X₂) (y : (P₂ j).obj X₂) :
    (e (i + j)).symm ((A₂.mul i j).app X₂ x y) =
      (A₁.mul i j).app X₁ ((e i).symm x) ((e j).symm y) := by
  refine (AddEquiv.symm_apply_eq _).2 ?_
  rw [hmul, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]

/-- **The ring isomorphism of total rings induced by degreewise isomorphisms** which turn the
graded multiplication into the graded multiplication and the unit into the unit. -/
noncomputable def totalRingEquivOfMul : A₁.Total X₁ ≃+* A₂.Total X₂ :=
  RingEquiv.ofRingHom
    (totalRingHomOfMul A₁ A₂ X₁ X₂ (fun i => (e i).toAddMonoidHom) hone hmul)
    (totalRingHomOfMul A₂ A₁ X₂ X₁ (fun i => (e i).symm.toAddMonoidHom)
      (degreewise_symm_one A₁ A₂ X₁ X₂ e hone) (degreewise_symm_mul A₁ A₂ X₁ X₂ e hmul))
    (RingHom.ext fun z => by
      induction z using A₂.incl_induction with
      | zero => simp
      | incl i y =>
        rw [RingHom.comp_apply, RingHom.id_apply]
        refine (congrArg (totalRingHomOfMul A₁ A₂ X₁ X₂ _ _ _)
          (totalRingHomOfMul_incl A₂ A₁ X₂ X₁ _ _ _ i y)).trans ?_
        refine (totalRingHomOfMul_incl A₁ A₂ X₁ X₂ _ _ _ i _).trans ?_
        exact congrArg (A₂.incl i) ((e i).apply_symm_apply y)
      | add a b ha hb => simp only [map_add] at ha hb ⊢; rw [ha, hb])
    (RingHom.ext fun z => by
      induction z using A₁.incl_induction with
      | zero => simp
      | incl i y =>
        rw [RingHom.comp_apply, RingHom.id_apply]
        refine (congrArg (totalRingHomOfMul A₂ A₁ X₂ X₁ _ _ _)
          (totalRingHomOfMul_incl A₁ A₂ X₁ X₂ _ _ _ i y)).trans ?_
        refine (totalRingHomOfMul_incl A₂ A₁ X₂ X₁ _ _ _ i _).trans ?_
        exact congrArg (A₁.incl i) ((e i).symm_apply_apply y)
      | add a b ha hb => simp only [map_add] at ha hb ⊢; rw [ha, hb])

/-- `totalRingEquivOfMul` sends the inclusion of `x` in degree `i` to the inclusion of `e i x` in
degree `i`. -/
@[simp]
theorem totalRingEquivOfMul_incl (i : ι) (x : (P₁ i).obj X₁) :
    totalRingEquivOfMul A₁ A₂ X₁ X₂ e hone hmul (A₁.incl i x) = A₂.incl i (e i x) :=
  totalRingHomOfMul_incl A₁ A₂ X₁ X₂ (fun i => (e i).toAddMonoidHom) hone hmul i x

/-- The inverse of `totalRingEquivOfMul` sends the inclusion of `x` in degree `i` to the
inclusion of `(e i).symm x` in degree `i`. -/
@[simp]
theorem totalRingEquivOfMul_symm_incl (i : ι) (x : (P₂ i).obj X₂) :
    (totalRingEquivOfMul A₁ A₂ X₁ X₂ e hone hmul).symm (A₂.incl i x) =
      A₁.incl i ((e i).symm x) :=
  totalRingHomOfMul_incl A₂ A₁ X₂ X₁ (fun i => (e i).symm.toAddMonoidHom)
    (degreewise_symm_one A₁ A₂ X₁ X₂ e hone) (degreewise_symm_mul A₁ A₂ X₁ X₂ e hmul) i x

end TotalEquiv

section SheafTotalEquiv

universe w v₁ v₂ u₁ u₂

variable {C₁ : Type u₁} [Category.{v₁} C₁] {C₂ : Type u₂} [Category.{v₂} C₂]
  {J₁ : GrothendieckTopology C₁} {J₂ : GrothendieckTopology C₂}
  {R₁ : Sheaf J₁ RingCat.{w}} {R₂ : Sheaf J₂ RingCat.{w}}
  (A₁ : SheafOfModules.GradedAlgebra.{w, w} R₁) (A₂ : SheafOfModules.GradedAlgebra.{w, w} R₂)
  (X₁ : C₁ᵒᵖ) (X₂ : C₂ᵒᵖ)
  (e : ∀ i : ℤ, (A₁.piece i).val.obj X₁ ≃+ (A₂.piece i).val.obj X₂)
  (hone : e 0 (A₁.one.eval X₁) = A₂.one.eval X₂)
  (hmul : ∀ (i j : ℤ) (x : (A₁.piece i).val.obj X₁) (y : (A₁.piece j).val.obj X₁),
    e (i + j) ((A₁.mul i j).app X₁ x y) = (A₂.mul i j).app X₂ (e i x) (e j y))

/-- **The ring isomorphism of total rings of two sheaves of graded algebras** induced by
degreewise isomorphisms which turn the graded multiplication into the graded multiplication and
the unit into the unit. -/
noncomputable def gradedTotalRingEquivOfMul :
    A₁.toPresheafGradedAlgebra.Total X₁ ≃+* A₂.toPresheafGradedAlgebra.Total X₂ :=
  totalRingEquivOfMul A₁.toPresheafGradedAlgebra A₂.toPresheafGradedAlgebra X₁ X₂ e hone hmul

/-- `gradedTotalRingEquivOfMul` sends the inclusion of `x` in degree `i` to the inclusion of
`e i x` in degree `i`. -/
@[simp]
theorem gradedTotalRingEquivOfMul_incl (i : ℤ) (x : (A₁.piece i).val.obj X₁) :
    gradedTotalRingEquivOfMul A₁ A₂ X₁ X₂ e hone hmul (A₁.toPresheafGradedAlgebra.incl i x) =
      A₂.toPresheafGradedAlgebra.incl i (e i x) :=
  totalRingEquivOfMul_incl _ _ X₁ X₂ e hone hmul i x

/-- The inverse of `gradedTotalRingEquivOfMul` sends the inclusion of `x` in degree `i` to the
inclusion of `(e i).symm x` in degree `i`. -/
@[simp]
theorem gradedTotalRingEquivOfMul_symm_incl (i : ℤ) (x : (A₂.piece i).val.obj X₂) :
    (gradedTotalRingEquivOfMul A₁ A₂ X₁ X₂ e hone hmul).symm
        (A₂.toPresheafGradedAlgebra.incl i x) =
      A₁.toPresheafGradedAlgebra.incl i ((e i).symm x) :=
  totalRingEquivOfMul_symm_incl _ _ X₁ X₂ e hone hmul i x

end SheafTotalEquiv

section Transfer

universe u

/-- The exact one-form `d a` of a function on an open of `Uc`, for `Uc ⊆ X` open and
`f : X ⟶ S`, as a section of `Ω¹_{Uc/S}`. -/
noncomputable abbrev dOneOn {X S : Scheme.{u}} (f : X ⟶ S) (Uc : X.Opens) (V : Uc.toScheme.Opens)
    (a : Γ(Uc.toScheme, V)) :
    ((Scheme.Hom.relativeDifferentialFormsAlgebra (Uc.ι ≫ f)).piece 1).val.obj (op V) :=
  (Scheme.Modules.exteriorGenerator (Scheme.Hom.relativeDifferentials (Uc.ι ≫ f))).val.app
    (op V) ((Scheme.Hom.universalRelativeDerivation (Uc.ι ≫ f)).d (X := op V) a)

/-- The logarithmic generators over an affine open `W'` of `X`, read in the forms on an open
`Uc ⊆ X`: functions on `W'`, their differentials, and the forms `s · dt` for local equations
`t` on `W'` of components of `D` and `s` an inverse of `t` on `Uc ∩ W'`. For `Uc = X ∖ D` this is
`MMP.FourfoldProofs.FractionalLogComplexProof.G1.gens`. -/
def gensOn {X S : Scheme.{u}} (f : X ⟶ S) (Uc : X.Opens) (D : MMP.Mori.Divisor X)
    (W' : X.Opens) (hW' : IsAffineOpen W') :
    Set ((Scheme.Hom.relativeDifferentialFormsAlgebra (Uc.ι ≫ f)).toPresheafGradedAlgebra.Total
      (op (Uc.ι ⁻¹ᵁ W'))) :=
  Set.range (fun g : Γ(X, W') =>
      (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc.ι ≫ f)).toPresheafGradedAlgebra.structureMap
        _ ((Uc.ι.app W').hom g)) ∪
    Set.range (fun g : Γ(X, W') =>
      (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc.ι ≫ f)).toPresheafGradedAlgebra.incl 1
        (dOneOn f Uc _ ((Uc.ι.app W').hom g))) ∪
    {η | ∃ E ∈ D.support, ∃ t : Γ(X, W'), E.idealSheaf.ideal ⟨W', hW'⟩ = Ideal.span {t} ∧
      ∃ s : Γ(Uc.toScheme, Uc.ι ⁻¹ᵁ W'), s * (Uc.ι.app W').hom t = 1 ∧
        η = (Scheme.Hom.relativeDifferentialFormsAlgebra
            (Uc.ι ≫ f)).toPresheafGradedAlgebra.structureMap _ s *
          (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc.ι ≫ f)).toPresheafGradedAlgebra.incl 1
            (dOneOn f Uc _ ((Uc.ι.app W').hom t))}

/-- The `I`-multiples of the subring generated by `gensOn`. For `Uc = X ∖ D` this is
`MMP.FourfoldProofs.FractionalLogComplexProof.G1.BrSet`. -/
noncomputable def brSetOn {X S : Scheme.{u}} (f : X ⟶ S) (Uc : X.Opens) (D : MMP.Mori.Divisor X)
    (I : X.IdealSheafData) (W' : X.Opens) (hW' : IsAffineOpen W') :
    AddSubgroup ((Scheme.Hom.relativeDifferentialFormsAlgebra
      (Uc.ι ≫ f)).toPresheafGradedAlgebra.Total (op (Uc.ι ⁻¹ᵁ W'))) :=
  AddSubgroup.closure {η | ∃ g ∈ I.ideal ⟨W', hW'⟩, ∃ ζ ∈ Subring.closure (gensOn f Uc D W' hW'),
    η = (Scheme.Hom.relativeDifferentialFormsAlgebra
      (Uc.ι ≫ f)).toPresheafGradedAlgebra.structureMap _ ((Uc.ι.app W').hom g) * ζ}

/-- A form lies in `G1.BrSet f D I W'` if and only if it lies in `brSetOn` for the complement
`cU D` of `D`. -/
theorem mem_brSetOn_cU_iff {X S : Scheme.{u}} (f : X ⟶ S) (D : MMP.Mori.Divisor X)
    (I : X.IdealSheafData) (W' : X.affineOpens) (z) :
    z ∈ G1.BrSet f D I W' ↔ z ∈ brSetOn f (cU D) D I W' W'.2 := Iff.rfl

variable {X₁ X₂ S₁ S₂ : Scheme.{u}} (f₁ : X₁ ⟶ S₁) (f₂ : X₂ ⟶ S₂) (Uc₁ : X₁.Opens)
  (Uc₂ : X₂.Opens) (D₁ : MMP.Mori.Divisor X₁) (D₂ : MMP.Mori.Divisor X₂)
  (I₁ : X₁.IdealSheafData) (I₂ : X₂.IdealSheafData) (W₁ : X₁.Opens) (hW₁ : IsAffineOpen W₁)
  (W₂ : X₂.Opens) (hW₂ : IsAffineOpen W₂)
  (Φ : (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc₁.ι ≫ f₁)).toPresheafGradedAlgebra.Total
      (op (Uc₁.ι ⁻¹ᵁ W₁)) ≃+*
    (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc₂.ι ≫ f₂)).toPresheafGradedAlgebra.Total
      (op (Uc₂.ι ⁻¹ᵁ W₂)))
  (ψ : Γ(Uc₁.toScheme, Uc₁.ι ⁻¹ᵁ W₁) ≃+* Γ(Uc₂.toScheme, Uc₂.ι ⁻¹ᵁ W₂))
  (β : Γ(X₁, W₁) ≃+* Γ(X₂, W₂))
  (hsm : ∀ c : Γ(Uc₁.toScheme, Uc₁.ι ⁻¹ᵁ W₁),
    Φ ((Scheme.Hom.relativeDifferentialFormsAlgebra
      (Uc₁.ι ≫ f₁)).toPresheafGradedAlgebra.structureMap _ c) =
      (Scheme.Hom.relativeDifferentialFormsAlgebra
        (Uc₂.ι ≫ f₂)).toPresheafGradedAlgebra.structureMap _ (ψ c))
  (hδ : ∀ c : Γ(Uc₁.toScheme, Uc₁.ι ⁻¹ᵁ W₁),
    Φ ((Scheme.Hom.relativeDifferentialFormsAlgebra (Uc₁.ι ≫ f₁)).toPresheafGradedAlgebra.incl 1
      (dOneOn f₁ Uc₁ _ c)) =
      (Scheme.Hom.relativeDifferentialFormsAlgebra (Uc₂.ι ≫ f₂)).toPresheafGradedAlgebra.incl 1
        (dOneOn f₂ Uc₂ _ (ψ c)))
  (hres : ∀ a, ψ ((Uc₁.ι.app W₁).hom a) = (Uc₂.ι.app W₂).hom (β a))
  (hE : ∀ E ∈ D₁.support, ∀ t : Γ(X₁, W₁), E.idealSheaf.ideal ⟨W₁, hW₁⟩ = Ideal.span {t} →
    (∃ E' ∈ D₂.support, E'.idealSheaf.ideal ⟨W₂, hW₂⟩ = Ideal.span {β t}) ∨ IsUnit (β t))

include hsm hδ hres hE in
/-- **Transfer of logarithmic generators.** `Φ` carries each logarithmic generator over `W₁`
(for `D₁`, read on `Uc₁`) into the subring generated by the logarithmic generators over `W₂`
(for `D₂`, read on `Uc₂`). -/
theorem map_mem_closure_gensOn {z} (hz : z ∈ gensOn f₁ Uc₁ D₁ W₁ hW₁) :
    Φ z ∈ Subring.closure (gensOn f₂ Uc₂ D₂ W₂ hW₂) := by
  rcases hz with (⟨g, rfl⟩ | ⟨g, rfl⟩) | ⟨E, hE₁, t, ht, s, hs, rfl⟩
  · rw [hsm, hres]
    exact Subring.subset_closure (Or.inl (Or.inl ⟨β g, rfl⟩))
  · rw [hδ, hres]
    exact Subring.subset_closure (Or.inl (Or.inr ⟨β g, rfl⟩))
  · rw [map_mul, hsm, hδ, hres]
    have hs' : ψ s * (Uc₂.ι.app W₂).hom (β t) = 1 := by
      rw [← hres, ← map_mul, hs, map_one]
    rcases hE E hE₁ t ht with ⟨E', hE', ht'⟩ | ⟨u, hu⟩
    · exact Subring.subset_closure (Or.inr ⟨E', hE', β t, ht', ψ s, hs', rfl⟩)
    · have hinv : (Uc₂.ι.app W₂).hom (β t) * (Uc₂.ι.app W₂).hom ↑u⁻¹ = 1 := by
        rw [← map_mul, ← hu, Units.mul_inv, map_one]
      rw [left_inv_eq_right_inv hs' hinv]
      exact Subring.mul_mem _ (Subring.subset_closure (Or.inl (Or.inl ⟨↑u⁻¹, rfl⟩)))
        (Subring.subset_closure (Or.inl (Or.inr ⟨β t, rfl⟩)))

include hsm hδ hres hE in
/-- **Transfer of `I`-multiples of logarithmic forms.** If `β` carries `I₁(W₁)` into `I₂(W₂)`,
then `Φ` carries `brSetOn f₁ Uc₁ D₁ I₁ W₁` into `brSetOn f₂ Uc₂ D₂ I₂ W₂`. -/
theorem map_mem_brSetOn (hI : ∀ a ∈ I₁.ideal ⟨W₁, hW₁⟩, β a ∈ I₂.ideal ⟨W₂, hW₂⟩) {z}
    (hz : z ∈ brSetOn f₁ Uc₁ D₁ I₁ W₁ hW₁) : Φ z ∈ brSetOn f₂ Uc₂ D₂ I₂ W₂ hW₂ := by
  have hgens : Subring.closure (gensOn f₁ Uc₁ D₁ W₁ hW₁) ≤
      (Subring.closure (gensOn f₂ Uc₂ D₂ W₂ hW₂)).comap Φ.toRingHom :=
    Subring.closure_le.mpr fun z hz =>
      map_mem_closure_gensOn f₁ f₂ Uc₁ Uc₂ D₁ D₂ W₁ hW₁ W₂ hW₂ Φ ψ β hsm hδ hres hE hz
  have hcl : brSetOn f₁ Uc₁ D₁ I₁ W₁ hW₁ ≤
      (brSetOn f₂ Uc₂ D₂ I₂ W₂ hW₂).comap Φ.toRingHom.toAddMonoidHom := by
    refine (AddSubgroup.closure_le _).mpr ?_
    rintro _ ⟨g, hg, ζ, hζ, rfl⟩
    refine AddSubgroup.subset_closure ⟨β g, hI g hg, Φ ζ, hgens hζ, ?_⟩
    change Φ _ = _
    rw [map_mul, hsm, hres]
  exact hcl hz

end Transfer

end MMP.FourfoldProofs.FractionalLogComplexProof
