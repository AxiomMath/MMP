module

public import MMP.AlgebraicGeometry.Vanishing.KodairaTwistSurjective
public import MMP.AlgebraicGeometry.Bertini.FreeLinearSystem

/-!
# Kodaira vanishing over the complex numbers

Let `X` be a smooth projective variety of dimension `n` over `ℂ` and let `L` be an ample line
bundle on `X`. Then `H^i(X, L^{-1}) = 0` for every `i < n`.

## Main results

* `MMP.Mori.subsingleton_derivedCohomologyOverField_dualSheaf_of_isAmple_complex`: Kodaira
  vanishing `H^i(X, L^{-1}) = 0` for `i < dim X`, over `ℂ`.

## Implementation notes

* `H^i(X, ℱ)` for `i : ℤ` is `Stacks.Duality.derivedCohomologyOverField f` of `ℱ` placed in
  degree zero, as in `MMP.Mori.subsingleton_dual_iff_subsingleton_exteriorPower_tensor`. It
  agrees with sheaf cohomology for `i ≥ 0` and vanishes for `i < 0`, so the statement for every
  integer `i < n` contains the one for `0 ≤ i < n`.
* `L^{-1}` is the dual `Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L`, and ampleness
  is `Stacks.Ample.IsAmple` (Stacks Tag 01PS).
* A smooth projective variety of dimension `n` is a projective variety
  (`MMP.Mori.IsProjectiveVariety`) whose smooth locus is everything (`MMP.Mori.IsSmoothScheme`)
  with `topologicalKrullDim X = n`.
* The extension to an arbitrary algebraically closed field of characteristic zero is
  `MMP.Mori.subsingleton_derivedCohomologyOverField_dualSheaf_of_isAmple`, which is deduced from
  this one by descending to a finitely generated field and embedding it into `ℂ`.

## References

* [J. Kollár and S. Mori, *Birational geometry of algebraic varieties*][KollarMori1998],
  Theorem 2.47
-/

@[expose] public section

/-!
## Proof: Kodaira vanishing over the complex numbers

Let `X` be a smooth projective variety of dimension `n` over `ℂ` and `L` an ample line bundle on
`X`. Then `H^i(X, L^{-1}) = 0` for `i < n` [KollarMori1998, Theorem 2.47].

The proof is the covering-trick reduction to Serre vanishing. Some power `L^{⊗ m}`, `m ≥ 2`, is
generated by finitely many global sections, so by Bertini it has a nonzero section `s` whose
zero scheme is smooth. Multiplication by `s^k` induces a surjection
`H^i(X, L^{⊗ -(1 + mk)}) ⟶ H^i(X, L^{⊗ -1})` for every `k`. By Serre duality the source is dual
to `H^{n-i}(X, ω_X ⊗ L^{⊗ (1 + mk)})`, and since `n - i > 0` this vanishes for `k ≫ 0` by Serre
vanishing. Finally `𝒪_X ⊗ L^{⊗ -1} ≅ L^∨`.

## Implementation notes

The power `L^{⊗ m}` is not taken very ample: Bertini's smoothness theorem in characteristic zero
needs only a base-point-free system, and an ample `L` has a power with even exponent generated
by finitely many global sections. The Serre vanishing used is applied to `L` itself with the
coherent sheaf `ω_X`, choosing `k` with `1 + mk` beyond its bound.

## References

* [J. Kollár and S. Mori, *Birational geometry of algebraic varieties*][KollarMori1998],
  Theorem 2.47
-/

namespace MMP.FourfoldProofs.Km2cKodairaVanishingProof

open CategoryTheory AlgebraicGeometry
open scoped Stacks.SmallDerivedModel

section Helpers

variable {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))

/-- For `E ≅ F`, `H^i(X, E)` is subsingleton iff `H^i(X, F)` is. -/
private theorem subsingleton_iff_of_iso {E F : X.Modules} (e : E ≅ F) (i : ℤ) :
    Subsingleton (Stacks.Duality.derivedCohomologyOverField f
        ((DerivedCategory.singleFunctor X.Modules 0).obj E) i) ↔
      Subsingleton (Stacks.Duality.derivedCohomologyOverField f
        ((DerivedCategory.singleFunctor X.Modules 0).obj F) i) :=
  ((DerivedCategory.homologyFunctor (ModuleCat ℂ) i).mapIso ((derivedGlobalSectionsOver f).mapIso
    ((DerivedCategory.singleFunctor X.Modules 0).mapIso e)))
    |>.toLinearEquiv.toEquiv.subsingleton_congr

variable (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- `L^{⊗ -j}` is the dual of `L^{⊗ j}`: it is a tensor inverse of `L^{⊗ j}`. -/
private noncomputable def tensorPowModuleNegIsoDualSheaf (j : ℤ) :
    Stacks.Ample.tensorPowModule X L (-j) ≅
      Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf (Stacks.Ample.tensorPowModule X L j) :=
  Stacks.SheafOfModules.Invertible.tensorInverseIsoDualSheaf X.presheaf
    (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
    (Stacks.Ample.tensorPowModuleAddIso X L j (-j) ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X L (add_neg_cancel j) ≪≫
      Stacks.Ample.tensorPowModuleZeroIso X L)

/-- `𝒪_X ⊗ L^{⊗ n} ≅ L^{⊗ n}`. -/
private noncomputable def unitTensorPowModuleIso (n : ℤ) :
    Scheme.Modules.tensorObj (Stacks.Ample.unitModule X) (Stacks.Ample.tensorPowModule X L n) ≅
      Stacks.Ample.tensorPowModule X L n :=
  ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso
      (Stacks.Ample.tensorPowModuleZeroIso X L).symm).app _ ≪≫
    Stacks.Ample.tensorPowModuleAddIso X L 0 n ≪≫
    Stacks.RelativeVeryAmple.tensorPowModuleCongr X L (zero_add n)

/-- **Serre duality plus Serre vanishing.** On a smooth projective variety of dimension `n` over
`ℂ` with `L` ample, `H^i(X, (L^{⊗ d})^∨) = 0` for all `i < n` and all `d ≫ 0`. -/
private theorem exists_subsingleton_dualSheaf_tensorPowModule [IsProjectiveVariety ℂ f]
    (hsm : MMP.Mori.IsSmoothScheme f) (n : ℕ) (hn : topologicalKrullDim X = n)
    (hL : Stacks.Ample.IsAmple X L) (i : ℤ) (hi : i < n) :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d →
      Subsingleton (Stacks.Duality.derivedCohomologyOverField f
        ((DerivedCategory.singleFunctor X.Modules 0).obj
          (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf
            (Stacks.Ample.tensorPowModule X L d))) i) := by
  haveI : IsProper f := isProper_of_isProjectiveMorphism f
    (inferInstance : IsProjectiveVariety ℂ f).isProjective
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : Smooth f := (MMP.Mori.isSmoothScheme_iff f).1 hsm
  haveI := Scheme.Hom.isFiniteLocallyFree_relativeDifferentials f
  haveI : SheafOfModules.IsFiniteLocallyFree
      (Scheme.Modules.exteriorPower (Scheme.Hom.relativeDifferentials f) n) :=
    Scheme.Modules.isFiniteLocallyFree_exteriorPower _ n inferInstance
  haveI : SheafOfModules.IsCoherent
      (Scheme.Modules.exteriorPower (Scheme.Hom.relativeDifferentials f) n) :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isFiniteLocallyFree X _
  obtain ⟨d₀, hd₀⟩ :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.exists_isZero_Hgroup_tensorPowTwist f
      (Scheme.Modules.exteriorPower (Scheme.Hom.relativeDifferentials f) n) L hL
  refine ⟨d₀, fun d hd => ?_⟩
  rw [MMP.Mori.subsingleton_dual_iff_subsingleton_exteriorPower_tensor f hsm n hn]
  obtain ⟨p, hp⟩ : ∃ p : ℕ, (n : ℤ) - i = p := ⟨((n : ℤ) - i).toNat, by omega⟩
  rw [hp]
  haveI := AddCommGrpCat.subsingleton_of_isZero (hd₀ d p hd (by omega))
  have hC : Subsingleton (cohomologyOverField ℂ f
      (Stacks.RelativeVeryAmple.tensorModules X
        (Scheme.Modules.exteriorPower (Scheme.Hom.relativeDifferentials f) n)
        (Stacks.Ample.tensorPowModule X L d)) p) :=
    (cohomologyOverFieldAddEquivHgroup ℂ f _ p).subsingleton_congr.2 inferInstance
  exact (Stacks.Duality.cohomologyOverFieldLinearEquivDerivedCohomologyOverField ℂ f _
    p).toEquiv.subsingleton_congr.1 hC

end Helpers

section Bertini

open MMP.Threefold.Bridges

attribute [local instance]
  Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.globalSectionsModule

/-- A dense open of the coefficient space `𝔸ᴺ⁺¹_k` over an infinite field contains a `k`-point
`c` at which a given nonzero polynomial does not vanish. -/
private theorem exists_coefficientPoint_mem_and_eval_ne_zero {k : Type} [Field k] [Infinite k]
    {N : ℕ} (U : (coefficientSpace k N).Opens) (hU : Dense (U : Set (coefficientSpace k N)))
    {g : MvPolynomial (Fin (N + 1)) k} (hg : g ≠ 0) :
    ∃ c : Fin (N + 1) → k, coefficientPoint c ∈ U ∧ MvPolynomial.eval c g ≠ 0 := by
  haveI : Nonempty (coefficientSpace k N) := ⟨coefficientPoint 0⟩
  obtain ⟨p, hp⟩ := hU.nonempty
  obtain ⟨_, ⟨f, rfl⟩, hpf, hfU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp U.2
  have hf : f ≠ 0 := by
    rintro rfl
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hpf (Submodule.zero_mem _)
  obtain ⟨c, hc⟩ : ∃ c, MvPolynomial.eval c (f * g) ≠ 0 := by
    by_contra h
    push Not at h
    exact mul_ne_zero hf hg (MvPolynomial.funext fun c => by simpa using h c)
  rw [map_mul] at hc
  exact ⟨c, hfU ((PrimeSpectrum.mem_basicOpen _ _).mpr (left_ne_zero_of_mul hc)),
    right_ne_zero_of_mul hc⟩

/-- For a nonzero `k`-linear map `φ` out of `kᴺ⁺¹` there is a nonzero polynomial (a linear form
vanishing on the kernel of `φ`) whose non-vanishing forces `φ c ≠ 0`. -/
private theorem exists_polynomial_ne_zero_of_linearMap_ne_zero {k : Type} [Field k] {N : ℕ}
    {M : Type*} [AddCommGroup M] [Module k M] (φ : (Fin (N + 1) → k) →ₗ[k] M) (hφ : φ ≠ 0) :
    ∃ ℓ : MvPolynomial (Fin (N + 1)) k, ℓ ≠ 0 ∧
      ∀ c, MvPolynomial.eval c ℓ ≠ 0 → φ c ≠ 0 := by
  obtain ⟨c₀, hc₀⟩ : ∃ c₀, φ c₀ ≠ 0 := by
    by_contra h
    push Not at h
    exact hφ (LinearMap.ext h)
  obtain ⟨ψ, hψc, hψK⟩ := Submodule.exists_dual_map_eq_bot_of_notMem
    (p := LinearMap.ker φ) (x := c₀) (by simpa using hc₀) inferInstance
  set ℓ : MvPolynomial (Fin (N + 1)) k :=
    ∑ j, MvPolynomial.C (ψ (Pi.single j 1)) * MvPolynomial.X j
  have hev : ∀ c, MvPolynomial.eval c ℓ = ψ c := by
    intro c
    conv_rhs => rw [pi_eq_sum_univ c]
    simp only [ℓ, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X, map_smul,
      smul_eq_mul, mul_comm]
    refine Finset.sum_congr rfl fun x _ => ?_
    congr 2
    ext j
    simp [Pi.single_apply, eq_comm]
  refine ⟨ℓ, fun h => hψc (by rw [← hev, h, map_zero]), fun c hc hφc => hc ?_⟩
  rw [hev]
  have : ψ c ∈ (LinearMap.ker φ).map ψ := ⟨c, hφc, rfl⟩
  rwa [hψK] at this

/-- **A smooth member of a power of an ample line bundle.** On a smooth projective variety over
`ℂ` with `L` ample there are `m ≥ 2` and a nonzero `s ∈ H⁰(X, L^{⊗ m})` with smooth zero
scheme. -/
private theorem exists_ne_zero_smooth_zeroScheme_tensorPowModule {X : Scheme.{0}}
    (f : X ⟶ Spec (.of ℂ)) [IsProjectiveVariety ℂ f] (hsm : MMP.Mori.IsSmoothScheme f)
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] (hL : Stacks.Ample.IsAmple X L) :
    ∃ m : ℕ, 2 ≤ m ∧ ∃ s : Γ(Stacks.Ample.tensorPowModule X L (m : ℤ), ⊤), s ≠ 0 ∧
      Smooth ((@AlgebraicGeometry.zeroScheme X (Stacks.Ample.tensorPowModule X L (m : ℤ))
        (Stacks.Ample.isInvertibleModule_tensorPowModule X L m) s).subschemeι ≫ f) := by
  classical
  obtain ⟨N, -, F, c, hN1, h2N, -, -, hcov⟩ :=
    Stacks.SectionExtension.exists_common_degree_affine_cover L hL (n := 2) (by norm_num) 0
  choose σ hσ using fun i => Stacks.FinGenFromCover.exists_global_nonvanishingLocus_eq L N (c i)
  letI : X.Over (Spec (.of ℂ)) := ⟨f⟩
  haveI hvar : IsVariety ℂ (X ↘ Spec (.of ℂ)) := (inferInstance : IsVariety ℂ f)
  haveI : IsIntegral X := hvar.toIsIntegral
  haveI : Smooth f := (MMP.Mori.isSmoothScheme_iff f).1 hsm
  let E := Fintype.equivFin {y : X // y ∈ F}
  let s : Fin (Fintype.card {y : X // y ∈ F} + 1) →
      Γ(Stacks.Ample.tensorPowModule X L (N : ℤ), ⊤) :=
    Fin.cons 0 fun j => σ (E.symm j)
  have hsingle : ∀ i, systemSection (k := ℂ) s (Pi.single (E i).succ 1) = σ i := fun i => by
    simp [systemSection, Fintype.linearCombination_apply_single, s]
  have hloc : ∀ x : X, ∃ i, x ∈ Stacks.Ample.nonvanishingLocus _ (σ i) := by
    intro x
    have hx : x ∈ (⨆ i, Stacks.AmpleFiniteAvoidance.nvOpen L (c i)) := hcov trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨i, by rwa [hσ i, ← Stacks.AmpleFiniteAvoidance.coe_nvOpen]⟩
  have hs : ⨆ c : Fin (Fintype.card {y : X // y ∈ F} + 1) → ℂ,
      Stacks.NonvanishingOpen.nonvanishingOpen X _ (systemSection s c) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    obtain ⟨i, hi⟩ := hloc x
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨Pi.single (E i).succ 1, ?_⟩
    rwa [Stacks.NonvanishingOpen.mem_nonvanishingOpen, hsingle]
  have hφ : systemSection (k := ℂ) s ≠ 0 := by
    intro h0
    obtain ⟨i, hi⟩ := hloc (Classical.arbitrary X)
    rwa [← hsingle i, h0, LinearMap.zero_apply, Stacks.Ample.nonvanishingLocus_zero] at hi
  let ιY : (i : PEmpty.{1}) → (i.elim : Scheme.{0}) ⟶ X := fun i => i.elim
  haveI : ∀ i, IsImmersion (ιY i) := fun i => i.elim
  haveI : ∀ i, Smooth (ιY i ≫ X ↘ Spec (.of ℂ)) := fun i => i.elim
  obtain ⟨⟨U, hUd, hU⟩, -⟩ := exists_dense_open_smooth_zeroScheme s hs ιY
  obtain ⟨ℓ, hℓ, hℓφ⟩ := exists_polynomial_ne_zero_of_linearMap_ne_zero _ hφ
  obtain ⟨c', hcU, hc⟩ := exists_coefficientPoint_mem_and_eval_ne_zero U hUd hℓ
  have h2 : 2 ≤ N := by
    obtain ⟨t, rfl⟩ := h2N
    omega
  exact ⟨N, h2, systemSection s c', hℓφ c' hc, (hU c' hcU).1 ‹Smooth f›⟩

end Bertini

/-- **Kodaira vanishing over `ℂ`.** On a smooth projective variety `X` of dimension `n` over `ℂ`
with `L` ample, `H^i(X, L^{-1}) = 0` for every `i < n`. -/
private theorem subsingleton_dualSheaf_of_isAmple
    {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) [IsProjectiveVariety ℂ f]
    (hsm : MMP.Mori.IsSmoothScheme f) (n : ℕ) (hn : topologicalKrullDim X = n) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] (hL : Stacks.Ample.IsAmple X L)
    (i : ℤ) (hi : i < n) :
    Subsingleton (Stacks.Duality.derivedCohomologyOverField f
      ((DerivedCategory.singleFunctor X.Modules 0).obj
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L)) i) := by
  haveI : Stacks.Ample.IsInvertibleModule X L := ‹_›
  obtain ⟨m, hm, s, hs, hD⟩ := exists_ne_zero_smooth_zeroScheme_tensorPowModule f hsm L hL
  obtain ⟨d₀, hd₀⟩ := exists_subsingleton_dualSheaf_tensorPowModule f L hsm n hn hL i hi
  have hsurj := MMP.Mori.surjective_derivedCohomologyOverField_map_chain_of_smooth_zeroScheme
    f hsm L hm s hs hD (r := 1) one_pos (by omega) d₀ i
  have hdesc : Stacks.EnriquesSeveriZariski.descend m (-((1 : ℕ) : ℤ)) d₀ =
      -(((1 + m * d₀ : ℕ)) : ℤ) := by
    rw [Stacks.EnriquesSeveriZariski.descend_eq]
    push_cast
    ring
  have hsrc : Subsingleton (Stacks.Duality.derivedCohomologyOverField f
      ((DerivedCategory.singleFunctor X.Modules 0).obj
        (Scheme.Modules.tensorObj (Stacks.Ample.unitModule X)
          (Stacks.Ample.tensorPowModule X L
            (Stacks.EnriquesSeveriZariski.descend m (-((1 : ℕ) : ℤ)) d₀)))) i) :=
    (subsingleton_iff_of_iso f (unitTensorPowModuleIso L _ ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X L hdesc ≪≫
      tensorPowModuleNegIsoDualSheaf L _) i).2 (hd₀ _ (by nlinarith))
  exact (subsingleton_iff_of_iso f (unitTensorPowModuleIso L _ ≪≫
    tensorPowModuleNegIsoDualSheaf L ((1 : ℕ) : ℤ) ≪≫
    Stacks.AlgebraicGeometry.ReflexiveModules.dualSheafIsoOfIso
      ((Stacks.Ample.tensorPowModuleOneIso X L).symm ≪≫
        Stacks.RelativeVeryAmple.tensorPowModuleCongr X L (by norm_num))) i).1 hsurj.subsingleton

end MMP.FourfoldProofs.Km2cKodairaVanishingProof

section

open CategoryTheory AlgebraicGeometry
open scoped Stacks.SmallDerivedModel

namespace MMP.Mori

/-- **Kodaira vanishing** (Kollár--Mori, Theorem 2.47). Let `X` be a smooth projective variety
of dimension `n` over `ℂ` and `L` an ample line bundle on `X`. Then `H^i(X, L^{-1}) = 0` for
every `i < n`. -/
@[mmp "thm_km2c_kodaira_vanishing"]
public theorem subsingleton_derivedCohomologyOverField_dualSheaf_of_isAmple_complex
    {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ)) [IsProjectiveVariety ℂ f] (hsm : IsSmoothScheme f)
    (n : ℕ) (hn : topologicalKrullDim X = n) (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] (hL : Stacks.Ample.IsAmple X L)
    (i : ℤ) (hi : i < n) :
    Subsingleton (Stacks.Duality.derivedCohomologyOverField f
      ((DerivedCategory.singleFunctor X.Modules 0).obj
        (Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf L)) i) :=
  MMP.FourfoldProofs.Km2cKodairaVanishingProof.subsingleton_dualSheaf_of_isAmple f hsm n hn L hL i hi

end MMP.Mori

