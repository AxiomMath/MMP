namespace MMP.Flips

open MMP.Mori

/-! ### Multiplicities, inverse transforms and coheights on a surface -/

/-- On a smooth variety a prime divisor has an invertible ideal sheaf. -/
private theorem isEffectiveCartierDivisor_idealSheaf {k : Type u} [Field k] {Y : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} (hY : MMP.Mori.IsVariety k sY) (hsm : IsSmoothScheme sY)
    (C : MMP.Mori.PrimeDivisor Y) :
    Stacks.Divisors.IsEffectiveCartierDivisor C.idealSheaf := by
  have := C.integral
  have := hY.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  have : Smooth sY := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sY hsm
  exact isEffectiveCartierDivisor_of_codimension_one_of_uniqueFactorizationMonoid C.idealSheaf
    C.codimension_one (fun x _ => uniqueFactorizationMonoid_stalk_of_smooth sY x)

/-- On a smooth variety a prime divisor has finite multiplicity, at least one, at each of its
points. -/
private theorem one_le_toNat_multiplicityAt {k : Type u} [Field k] {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of k)} (hY : MMP.Mori.IsVariety k sY)
    (hsm : IsSmoothScheme sY) (C : MMP.Mori.PrimeDivisor Y) {y : Y} (hy : y ∈ C.support) :
    1 ≤ (C.multiplicityAt y).toNat ∧ C.multiplicityAt y ≠ ⊤ := by
  have htop := MMP.Threefold.Resolution.multiplicityAt_ne_top C
    (isEffectiveCartierDivisor_idealSheaf hY hsm C) y
  refine ⟨?_, htop⟩
  have h1 : (1 : ℕ∞) ≤ C.multiplicityAt y := by
    refine le_iSup₂_of_le (f := fun (m : ℕ) (_ : C.idealSheaf.stalkIdeal y ≤
      IsLocalRing.maximalIdeal (Y.presheaf.stalk y) ^ m) => (m : ℕ∞)) 1 ?_ (by simp)
    rw [pow_one]
    exact IsLocalRing.le_maximalIdeal
      ((Scheme.IdealSheafData.stalkIdeal_eq_top_iff _).not.mpr (not_not.mpr hy))
  lift C.multiplicityAt y to ℕ using htop with m
  exact_mod_cast h1

open MMP.Threefold.Resolution in
/-- The coefficient of `g⁻¹_*(D)` in `g⁻¹_* B` is that of `D` in `B`. -/
private theorem inverseTransformDivisor_apply_of_eq_some {X Y : Scheme.{u}} {R : Type*}
    [AddCommMonoid R] {g : Y ⟶ X} {D : MMP.Mori.PrimeDivisor X} {C : MMP.Mori.PrimeDivisor Y}
    (hD : inverseTransformPrimeDivisor g D = some C) (B : DivisorWithCoeffs R X) :
    inverseTransformDivisor g B C = B D :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hD (fun _ hD' =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective <|
      (map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hD').1.symm.trans
      (map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hD).1) B

/-- A prime divisor in the support of `mapPrimeDivisors φ D` is in the image of `φ`. -/
private theorem exists_eq_some_of_mem_support_mapPrimeDivisors {X Y : Scheme.{u}} {R : Type*}
    [AddCommMonoid R] {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    {D : DivisorWithCoeffs R X} {Q : MMP.Mori.PrimeDivisor Y}
    (hQ : Q ∈ (DivisorWithCoeffs.mapPrimeDivisors φ D).support) : ∃ E, φ E = some Q := by
  classical
  by_contra! h
  refine Finsupp.mem_support_iff.mp hQ ?_
  clear hQ
  induction D using Finsupp.induction_linear with
  | zero => simp
  | add D D' hD hD' => rw [map_add, Finsupp.add_apply, hD, hD', add_zero]
  | single E r =>
    rw [DivisorWithCoeffs.mapPrimeDivisors_single]
    rcases hφ : φ E with _ | Q'
    · rfl
    · simp [show Q' ≠ Q from fun h' => h E (h' ▸ hφ)]

/-- On an irreducible scheme, a point whose closure is not everything has positive coheight. -/
theorem coheight_ne_zero_of_closure_ne_univ {Y : Scheme.{u}} [IrreducibleSpace Y] {x : Y}
    (hx : closure ({x} : Set Y) ≠ Set.univ) : Order.coheight x ≠ 0 := by
  intro h0
  have hgx : genericPoint Y ≤ x :=
    Order.coheight_eq_zero.mp h0 ((genericPoint_spec Y).specializes (Set.mem_univ x))
  refine hx (Set.eq_univ_of_univ_subset ?_)
  rw [← (genericPoint_spec Y).def]
  exact isClosed_closure.closure_subset_iff.mpr
    (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hgx))

/-- A proper specialization raises the coheight: if `ξ ⤳ η` with `ξ ≠ η` then
`coheight ξ + 1 ≤ coheight η`. -/
theorem coheight_add_one_le_of_specializes {Y : Scheme.{u}} {ξ η : Y} (h : ξ ⤳ η)
    (hne : ξ ≠ η) : Order.coheight ξ + 1 ≤ Order.coheight η :=
  Order.coheight_add_one_le (lt_of_le_not_ge (α := Y) h fun h' => hne (h.antisymm h').eq)

/-- On an integral scheme of dimension two, locally of finite type over a field, a non-closed
point whose closure is not the whole scheme has coheight one. -/
theorem coheight_eq_one_of_not_isClosed {k : Type u} [Field k] {Y : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY]
    (hYd : topologicalKrullDim Y = 2) {x : Y} (hx : ¬ IsClosed ({x} : Set Y))
    (hx' : closure ({x} : Set Y) ≠ Set.univ) : Order.coheight x = 1 := by
  obtain ⟨z, hz, hzx⟩ : ∃ z ∈ closure ({x} : Set Y), z ≠ x := by
    by_contra! h
    exact hx (isClosed_of_closure_subset h)
  have hz2 : Order.coheight z ≤ 2 := by
    have h := topologicalKrullDim_closure_singleton_add_coheight sY z
    rw [hYd] at h
    generalize topologicalKrullDim (closure ({z} : Set Y)) = d at h
    induction d using WithBot.recBotCoe with
    | bot => simp at h
    | coe d => exact le_add_self.trans_eq (WithBot.coe_inj.mp (by push_cast; exact h))
  have h := (coheight_add_one_le_of_specializes (specializes_iff_mem_closure.mpr hz)
    hzx.symm).trans hz2
  rw [← one_add_one_eq_two, ENat.add_le_add_iff_right ENat.one_ne_top] at h
  exact h.antisymm (Order.one_le_iff_ne_zero.mpr (coheight_ne_zero_of_closure_ne_univ hx'))

/-! ### A boundary curve through the node of a two-vertex chain -/

section TwoVertexChain

open MMP.Threefold.Resolution

/-- If every component of `Θ` through `x` has nonnegative coefficient, then the coefficients of
finitely many components, weighted by their multiplicities at `x`, add up to at most
`mult_x Θ`. -/
private theorem sum_mul_le_multiplicityAt {Y : Scheme.{u}} {Θ : QDivisor Y} {x : Y}
    (hnn : ∀ D : MMP.Mori.PrimeDivisor Y, x ∈ D.support → 0 ≤ Θ D)
    (S : Finset (MMP.Mori.PrimeDivisor Y)) :
    ∑ D ∈ S, ((D.multiplicityAt x).toNat : ℚ) * Θ D ≤ DivisorWithCoeffs.multiplicityAt Θ x := by
  classical
  set f : MMP.Mori.PrimeDivisor Y → ℚ := fun D => (D.multiplicityAt x).toNat • Θ D with hf
  have hmult : DivisorWithCoeffs.multiplicityAt Θ x = ∑ D ∈ S ∪ Θ.support, f D := by
    unfold DivisorWithCoeffs.multiplicityAt
    exact Finsupp.sum_of_support_subset _ Finset.subset_union_right _ (fun _ _ => smul_zero _)
  rw [hmult]
  calc ∑ D ∈ S, ((D.multiplicityAt x).toNat : ℚ) * Θ D = ∑ D ∈ S, f D :=
        Finset.sum_congr rfl fun D _ => by simp only [hf, nsmul_eq_mul]
    _ ≤ ∑ D ∈ S ∪ Θ.support, f D :=
        Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left fun D _ _ => by
          by_cases hD : x ∈ D.support
          · exact nsmul_nonneg (hnn D hD) _
          · simp [hf, PrimeDivisor.multiplicityAt_eq_zero_of_notMem D hD]

/-- If every component of `Θ` through `x` has nonnegative coefficient and multiplicity at least
one at `x`, then the coefficients of any finite set of components through `x` sum to at most
`mult_x Θ`. -/
private theorem sum_le_multiplicityAt {Y : Scheme.{u}} {Θ : QDivisor Y} {x : Y}
    (hnn : ∀ D : MMP.Mori.PrimeDivisor Y, x ∈ D.support → 0 ≤ Θ D)
    (hpos : ∀ D : MMP.Mori.PrimeDivisor Y, x ∈ D.support → 1 ≤ (D.multiplicityAt x).toNat)
    (S : Finset (MMP.Mori.PrimeDivisor Y)) (hS : ∀ D ∈ S, x ∈ D.support) :
    ∑ D ∈ S, Θ D ≤ DivisorWithCoeffs.multiplicityAt Θ x :=
  (Finset.sum_le_sum fun D hD => le_mul_of_one_le_left (hnn D (hS D hD))
    (by exact_mod_cast hpos D (hS D hD))).trans (sum_mul_le_multiplicityAt hnn S)

/-- A prime divisor of `Y` has coefficient `0` or `1` in the inverse transform `g⁻¹_* B` of a
reduced boundary `B`. -/
private theorem inverseTransformDivisor_apply_eq_zero_or_one {X Y : Scheme.{u}} {g : Y ⟶ X}
    {B : QDivisor X} (hB : IsReducedBoundary B) (D : MMP.Mori.PrimeDivisor Y) :
    inverseTransformDivisor g B D = 0 ∨ inverseTransformDivisor g B D = 1 := by
  refine or_iff_not_imp_left.2 fun hD => ?_
  obtain ⟨D₀, hD₀⟩ :=
    exists_eq_some_of_mem_support_mapPrimeDivisors (Finsupp.mem_support_iff.2 hD)
  rw [inverseTransformDivisor_apply_of_eq_some hD₀] at hD ⊢
  exact hB D₀ (Finsupp.mem_support_iff.2 hD)

/-- On an integral surface locally of finite type over a field, a point lying on two distinct
prime divisors is closed. -/
private theorem isClosed_singleton_of_mem_support_of_ne {k : Type u} [Field k] {Y : Scheme.{u}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY]
    (hYd : topologicalKrullDim Y = 2) {D₁ D₂ : MMP.Mori.PrimeDivisor Y} (h : D₁ ≠ D₂) {z : Y}
    (hz₁ : z ∈ D₁.support) (hz₂ : z ∈ D₂.support) : IsClosed ({z} : Set Y) := by
  have hsp : ∀ D : MMP.Mori.PrimeDivisor Y, z ∈ D.support → D.genericPoint ⤳ z := fun D hD => by
    rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hD
  have hne : D₁.genericPoint ≠ z := by
    rintro rfl
    have hne' : D₂.genericPoint ≠ D₁.genericPoint := fun h' =>
      h (AlgebraicGeometry.PrimeDivisor.genericPoint_injective h').symm
    have := coheight_add_one_le_of_specializes (hsp D₂ hz₂) hne'
    rw [MMP.Mori.PrimeDivisor.coheight_genericPoint,
      MMP.Mori.PrimeDivisor.coheight_genericPoint] at this
    exact absurd this (by decide)
  have h2 := coheight_add_one_le_of_specializes (hsp D₁ hz₁) hne
  rw [MMP.Mori.PrimeDivisor.coheight_genericPoint] at h2
  by_contra hz
  have hcl : closure ({z} : Set Y) ≠ Set.univ := by
    intro hcl
    have h0 : Order.coheight z = 0 := by
      rw [Order.coheight_eq_zero]
      intro b _
      exact specializes_iff_mem_closure.mpr (hcl ▸ Set.mem_univ b)
    rw [h0] at h2
    exact absurd h2 (by decide)
  rw [coheight_eq_one_of_not_isClosed sY hYd hz hcl] at h2
  exact absurd h2 (by decide)

variable {k : Type u} [Field k] [IsAlgClosed k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
  {P : X} {B : QDivisor X} {g : Y ⟶ X} [QuasiCompact (g ≫ sX)] [IsLocallyNoetherian Y]
  [IsNormal Y] {n : ℕ} {E : Fin n → Mori.PrimeDivisor Y}

/-- Let `g` be a resolution of the surface germ with reduced boundary `(X, P; B)` whose weighted
dual graph `Γ = Γ(g)` is a rational tree which is a chain `w_1, w_2` (enumerated by `e`) with
`β_{w_1} = β_{w_2} = 1`. If a boundary point `(C, z)` of `g` has `z ∈ E_{w_1} ∩ E_{w_2}`, then
`(X, B)` is not log canonical near `P`: on no open neighbourhood `U` of `P` is `(U, B|_U)` log
canonical with canonical divisor `K_X|_U`. -/
@[mmp "lem_fa3_case9_two_vertices_node"]
public theorem IsWeightedDualGraph.not_isLogCanonical_of_mem_support_of_isChainOrder
    {Γ : WeightedGraph (Fin n)} (hΓ : IsWeightedDualGraph sX P B g E Γ)
    (hB : IsReducedBoundary B) (hrt : Γ.IsRationalTree) {e : Fin 2 ≃ Fin n}
    (hch : Γ.IsChainOrder e) (hβ : ∀ i, Γ.boundary (e i) = 1)
    {C : Mori.PrimeDivisor Y} {z : Y} (hC : IsGermBoundaryPoint g P B C z)
    (hz₁ : z ∈ (E (e 0)).support) (hz₂ : z ∈ (E (e 1)).support)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 2) :
    ¬ HoldsOnGerm {P} fun U : X.Opens => ∀ [Nonempty U],
      haveI : CompactSpace U := isCompact_iff_compactSpace.mp
        (@NoetherianSpace.isCompact _ _ (haveI : IsNoetherian X := {}; inferInstance) _)
      IsLogCanonical (U.ι ≫ sX) 2 (DivisorWithCoeffs.restrictOpen U K)
        (DivisorWithCoeffs.restrictOpen U (QDivisor.toRDivisor B)) := by
  classical
  have ha : IsGermLogDiscrepancyVector sX P B g E 0 :=
    (hΓ.isGermLogDiscrepancyVector_iff 0).2 <|
      (WeightedGraph.isLogDiscrepancyVector_iff_eq_zero_of_isChainOrder hrt hΓ.isNegDef two_pos
        hch fun i => by fin_cases i <;> simp [hβ]).2 rfl
  have hg := ha.2.1
  have hE := hΓ.isExceptionalCurveEnumeration.injective
  have : LocallyOfFiniteType (g ≫ sX) := hg.isVariety.toLocallyOfFiniteType
  have : IsIntegral Y := hg.isVariety.toIsIntegral
  have h01 : E (e 0) ≠ E (e 1) := (hE.comp e.injective).ne (by decide)
  have hpos := fun D (hD : z ∈ D.support) =>
    (one_le_toNat_multiplicityAt hg.isVariety hg.isSmoothResolution.isSmoothScheme D hD).1
  refine ha.not_isLogCanonical_of_two_lt_multiplicityAt
    (isClosed_singleton_of_mem_support_of_ne (g ≫ sX) hg.topologicalKrullDim_eq h01 hz₁ hz₂)
    hC.2.2 ?_ hK
  -- `mult_z (g⁻¹_* B) ≥ 1`, since `C` has coefficient `1` and passes through `z`
  have hinv := inverseTransformDivisor_apply_eq_zero_or_one (g := g) hB
  have h₁ := sum_le_multiplicityAt (Θ := inverseTransformDivisor g B)
    (fun D _ => by rcases hinv D with h | h <;> simp [h]) hpos {C} (by simpa using hC.2.1)
  rw [Finset.sum_singleton, (hinv C).resolve_left hC.1] at h₁
  -- `mult_z (E_1 + ⋯ + E_n) ≥ 2`, since `E_{w_1}` and `E_{w_2}` pass through `z`
  have h₂ := sum_le_multiplicityAt (Θ := ∑ j, Finsupp.single (E j) (1 - (0 : Fin n → ℚ) j))
    (fun D _ => by
      simp only [Finsupp.finset_sum_apply, Finsupp.single_apply, Pi.zero_apply, sub_zero]
      positivity)
    hpos {E (e 0), E (e 1)} (by
      simp only [Finset.mem_insert, Finset.mem_singleton, forall_eq_or_imp, forall_eq]
      exact ⟨hz₁, hz₂⟩)
  simp only [Finset.sum_pair h01, Finsupp.finset_sum_apply, Finsupp.single_apply, hE.eq_iff,
    Pi.zero_apply, sub_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true] at h₂
  rw [logPullbackBoundary, DivisorWithCoeffs.multiplicityAt_add]
  simp only [Pi.zero_apply, sub_zero]
  linarith

end TwoVertexChain

/-! ### Log canonical germs at a smooth point, step A: `X` is smooth -/

/-- A closed subset of a Noetherian quasi-sober space all of whose points are closed is
finite. -/
theorem finite_of_forall_isClosed_singleton {T : Type*} [TopologicalSpace T]
    [NoetherianSpace T] [QuasiSober T] {S : Set T} (hS : IsClosed S)
    (h : ∀ x ∈ S, IsClosed ({x} : Set T)) : S.Finite := by
  obtain ⟨F, hFirr, hF⟩ := NoetherianSpace.exists_finset_irreducible ⟨S, hS⟩
  have hS' : S = ⋃ K ∈ F, (K : Set T) := by
    have := congrArg (fun K : Closeds T => (K : Set T)) hF
    simpa [Closeds.coe_finset_sup] using this
  rw [hS']
  refine Set.Finite.biUnion F.finite_toSet fun K hK => ?_
  have hgen := (hFirr ⟨K, hK⟩).isGenericPoint_genericPoint_closure
  rw [K.isClosed.closure_eq] at hgen
  have hKS : (K : Set T) ⊆ S := by
    rw [hS']; exact Set.subset_biUnion_of_mem (u := fun K : Closeds T => (K : Set T)) hK
  rw [← hgen.def, (h _ (hKS hgen.mem)).closure_eq]
  exact Set.finite_singleton _

/-- A point of a proper closed subset does not have dense closure. -/
theorem closure_singleton_ne_univ {T : Type*} [TopologicalSpace T] {F : Set T}
    (hF : IsClosed F) (hFne : F ≠ Set.univ) {x : T} (hx : x ∈ F) :
    closure ({x} : Set T) ≠ Set.univ := fun h =>
  hFne (Set.eq_univ_of_univ_subset
    (h ▸ hF.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx)))

/-- On an irreducible scheme, a point `η` of coheight one is specialized to only by itself
among the points whose closure is not the whole scheme. -/
theorem eq_of_specializes_of_coheight_eq_one {Y : Scheme.{u}} [IrreducibleSpace Y]
    {ξ η : Y} (hη : Order.coheight η = 1) (h : ξ ⤳ η)
    (hξ : closure ({ξ} : Set Y) ≠ Set.univ) : ξ = η := by
  by_contra hne
  have h1 := coheight_add_one_le_of_specializes h hne
  rw [hη] at h1
  exact coheight_ne_zero_of_closure_ne_univ hξ
    (nonpos_iff_eq_zero.mp ((ENat.add_le_add_iff_right ENat.one_ne_top).mp (by simpa using h1)))

/-- On a surface `Y`, the closure of a coheight-one point `η` of a proper closed fibre
`g⁻¹(P)` is an exceptional curve of `g` over `P`. -/
theorem isGermExceptionalCurve_ofCoheightOne {k : Type u} [Field k] {X Y : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} (hYv : MMP.Mori.IsVariety k sY) (hYd : topologicalKrullDim Y = 2)
    {g : Y ⟶ X} {P : X} (hFcl : IsClosed (g.base ⁻¹' {P})) (hFne : g.base ⁻¹' {P} ≠ Set.univ)
    {η : Y} (hηF : η ∈ g.base ⁻¹' {P}) (hη1 : Order.coheight η = 1) :
    IsGermExceptionalCurve g P (AlgebraicGeometry.PrimeDivisor.ofCoheightOne η hη1) := by
  have : IsIntegral Y := hYv.toIsIntegral
  have hsupp : (AlgebraicGeometry.PrimeDivisor.ofCoheightOne η hη1).support = closure {η} := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure,
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]
  refine ⟨⟨⟨?_, ?_⟩, fun Z ⟨hZirr, hZF⟩ hle => ?_⟩,
    isCurveIn_idealSheaf_of_topologicalKrullDim_eq_two hYv hYd _⟩
  · rw [hsupp]; exact isIrreducible_singleton.closure
  · rw [hsupp]; exact hFcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hηF)
  · rw [hsupp] at hle ⊢
    have hgen := hZirr.isGenericPoint_genericPoint_closure
    have hξF : hZirr.genericPoint ∈ g.base ⁻¹' {P} := hFcl.closure_subset_iff.mpr hZF hgen.mem
    have hξ := eq_of_specializes_of_coheight_eq_one hη1
      (hgen.specializes (subset_closure (hle (subset_closure rfl))))
      (closure_singleton_ne_univ hFcl hFne hξF)
    rw [← hξ, hgen.def]
    exact subset_closure

/-- If a resolution `f` of a surface germ `(X, P)` has no exceptional curve, then `X` is smooth
over `k`. -/
theorem IsGermResolution.isSmoothScheme_of_isExceptionalCurveEnumeration {k : Type u}
    [Field k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsNormal X]
    [CompactSpace X] {P : X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)]
    [IsLocallyNoetherian Y] [IsNormal Y]
    {E : Fin 0 → MMP.Mori.PrimeDivisor Y}
    (hf : IsGermResolution sX P f) (hE : IsExceptionalCurveEnumeration f P E) :
    IsSmoothScheme sX := by
  have hYv := hf.isVariety
  have : IsIntegral Y := hf.isIntegral sX
  have hYd := hf.topologicalKrullDim_eq
  have : LocallyOfFiniteType (f ≫ sX) := hYv.toLocallyOfFiniteType
  obtain ⟨hFcl, hFne⟩ := hf.isClosed_preimage_and_ne_univ
  have hclosed : ∀ y ∈ f.base ⁻¹' {P}, IsClosed ({y} : Set Y) := by
    intro y hy
    by_contra hcl
    have h1 := coheight_eq_one_of_not_isClosed (f ≫ sX) hYd hcl
      (closure_singleton_ne_univ hFcl hFne hy)
    obtain ⟨j, -⟩ := hE.exists_eq _ (isGermExceptionalCurve_ofCoheightOne hYv hYd hFcl hFne hy h1)
    exact j.elim0
  have := hf.isSmoothResolution.isProper
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian Y := {}
  have hfin := finite_of_forall_isClosed_singleton hFcl hclosed
  have hbir := MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism
    hf.isSmoothResolution.isBirationalMorphism
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso f hbir).1
    inferInstance
  set U : X.Opens := ⟨_, hU⟩
  have hPU : P ∈ U := hfin
  have hYsm : Smooth (f ≫ sX) :=
    MMP.Threefold.Resolution.smooth_of_isSmoothScheme hf.isSmoothResolution.isSmoothScheme
  have hsmU : Smooth (U.ι ≫ sX) := by
    have e : (f ∣_ U) ≫ U.ι = (f ⁻¹ᵁ U).ι ≫ f := morphismRestrict_ι f U
    have : U.ι ≫ sX = inv (f ∣_ U) ≫ (f ⁻¹ᵁ U).ι ≫ f ≫ sX := by
      rw [← reassoc_of% e, IsIso.inv_hom_id_assoc]
    rw [this]
    infer_instance
  refine eq_top_iff.mpr fun x _ => ?_
  by_cases hx : x = P
  · exact le_smoothLocus sX hsmU (hx ▸ hPU)
  · exact hf.isSurfaceGerm.2.2.2 x hx

/-! ### Step B: the identity of `X` as a resolution -/

/-- The support of a curve is not contained in a single point. -/
private theorem not_support_subset_singleton {Z : Scheme.{u}} {D : MMP.Mori.PrimeDivisor Z}
    (hD : IsCurveIn D.idealSheaf) (p : Z) : ¬ D.support ⊆ {p} := by
  intro h
  have h1 := hD.2
  rw [topologicalKrullDim_subscheme] at h1
  have : Subsingleton (D.idealSheaf.support : Set Z) :=
    ((Set.subsingleton_singleton).anti h).coe_sort
  have : DiscreteTopology (D.idealSheaf.support : Set Z) := Subsingleton.discreteTopology
  have h0 := topologicalKrullDim_zero_of_discreteTopology (D.idealSheaf.support : Set Z)
  rw [h1] at h0
  exact absurd h0 (by decide)

/-- For `X` smooth, the identity of `X` is a resolution of the surface germ `(X, P)`. -/
private theorem isGermResolution_id {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} {P : X} (hP : IsSurfaceGerm sX P) (hsm : IsSmoothScheme sX) :
    IsGermResolution sX P (𝟙 X) where
  isSurfaceGerm := hP
  isSmoothResolution := ⟨inferInstance, isBirationalMorphism_of_isIso _,
    by rw [Category.id_comp]; exact hsm⟩
  topologicalKrullDim_eq := hP.2.1
  isIso_away := ⟨⟨{P}ᶜ, hP.2.2.1.isOpen_compl⟩, rfl, inferInstance⟩

/-- The inverse transform under the identity is the identity. -/
private theorem inverseTransformDivisor_id {X : Scheme.{u}} {R : Type*} [AddCommMonoid R]
    (D : MMP.Mori.DivisorWithCoeffs R X) : inverseTransformDivisor (𝟙 X) D = D := by
  have : inverseTransformDivisor (R := R) (𝟙 X) = AddMonoidHom.id _ := by
    refine Finsupp.addHom_ext fun C r ↦ ?_
    rw [AddMonoidHom.id_apply]
    refine inverseTransformDivisor_single_of_eq_some
      (MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint rfl ?_) r
    rw [top_le_iff.mp (le_biregularLocus ((isBiregular_top_iff (𝟙 X)).mpr inferInstance))]
    trivial
  exact DFunLike.congr_fun this D

/-- The identity has no exceptional curve. -/
private theorem isExceptionalCurveEnumeration_id {X : Scheme.{u}} (P : X) :
    IsExceptionalCurveEnumeration (𝟙 X) P (Fin.elim0 : Fin 0 → MMP.Mori.PrimeDivisor X) where
  injective := fun i => i.elim0
  isGermExceptionalCurve := fun i => i.elim0
  exists_eq := fun C hC => absurd (hC.1.prop.2.trans (by intro x hx; exact hx))
    (not_support_subset_singleton hC.2 P)

/-- On the identity, with no exceptional curves, the boundary `Θ` is `B`. -/
private theorem logPullbackBoundary_id {X : Scheme.{u}} (B : QDivisor X) :
    logPullbackBoundary (𝟙 X) B Fin.elim0 Fin.elim0 = B := by
  simp only [logPullbackBoundary, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
  exact inverseTransformDivisor_id B

/-- The multiplicity of a reduced boundary is the sum of the multiplicities of its components. -/
private theorem multiplicityAt_eq_sum_of_isReducedBoundary {X : Scheme.{u}} {B : QDivisor X}
    (hred : IsReducedBoundary B) (P : X) :
    DivisorWithCoeffs.multiplicityAt B P = ∑ C ∈ B.support, ((C.multiplicityAt P).toNat : ℚ) := by
  rw [DivisorWithCoeffs.multiplicityAt, Finsupp.sum]
  exact Finset.sum_congr rfl fun C hC => by rw [hred C hC, nsmul_eq_mul, mul_one]

section SmoothLocus

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

/-- Over a perfect field, a point `z` of the closed subscheme cut out by an ideal sheaf `I`
lies in the smooth locus exactly when `𝒪_{X,x} ⧸ I_x` is regular, where `x` is the image
of `z`. -/
private theorem mem_smoothLocus_subschemeι_iff {k : Type u} [Field k] [PerfectField k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (I : X.IdealSheafData) (z : I.subscheme) :
    z ∈ smoothLocus (I.subschemeι ≫ f) ↔
      IsRegularLocalRing (X.presheaf.stalk (I.subschemeι z) ⧸ I.stalkIdeal (I.subschemeι z)) := by
  rw [smoothLocus_eq_smoothLocus,
    (MMP.mem_smoothLocus_iff_isRegularLocalRing_of_perfectField _).1 z]
  refine ⟨fun h => ?_, fun h => ?_⟩
  · haveI := h
    exact .of_ringEquiv (I.subschemeStalkRingEquiv z).symm
  · exact .of_ringEquiv (R := X.presheaf.stalk (I.subschemeι z) ⧸ I.stalkIdeal (I.subschemeι z))
      (I.subschemeStalkRingEquiv z)

end SmoothLocus

/-! ### Counting and coefficients -/

/-- The number of elements of a finite union of pairwise disjoint finite sets. -/
private theorem ncard_biUnion_finset {α ι : Type*} (s : Finset ι)
    (t : ι → Set α) (hd : (s : Set ι).PairwiseDisjoint t) (hf : ∀ i ∈ s, (t i).Finite) :
    (⋃ i ∈ s, t i).ncard = ∑ i ∈ s, (t i).ncard := by
  rw [← finsum_mem_coe_finset]; exact s.finite_toSet.ncard_biUnion hf hd

/-! ### The blow-up of a point -/

section Blowup

open MMP.Threefold.Resolution

variable {k : Type u} [Field k] [IsAlgClosed k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}

set_option hygiene false in
/-- The blow-up `π : Y' ⟶ Y` of the reduced closed point `y`. -/
local notation "πy" => blowUpToBase (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds _))

set_option hygiene false in
/-- The blow-up `Y'` of the reduced closed point `y`. -/
local notation "Y'y" => blowUp (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds _))

/-- The generic point of a curve on a surface is not a closed point. -/
private theorem genericPoint_ne_of_isClosed (hY : MMP.Mori.IsVariety k sY)
    (hYd : topologicalKrullDim Y = 2) {y : Y} (hy : IsClosed ({y} : Set Y))
    (P : MMP.Mori.PrimeDivisor Y) : P.genericPoint ≠ y := by
  intro h
  have h1 := coheight_eq_two_of_isClosed hY hYd hy
  rw [← h, MMP.Mori.PrimeDivisor.coheight_genericPoint] at h1
  exact absurd h1 (by decide)

/-- The exceptional curve of the blow-up of a point is not the strict transform of a curve. -/
private theorem ne_of_inverseTransformPrimeDivisor_eq_some (hY : MMP.Mori.IsVariety k sY)
    (hYd : topologicalKrullDim Y = 2) {y : Y} (hy : IsClosed ({y} : Set Y))
    {F : MMP.Mori.PrimeDivisor Y'y}
    (hF : F.idealSheaf = exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{y}, hy⟩))
    {P : MMP.Mori.PrimeDivisor Y} {P' : MMP.Mori.PrimeDivisor Y'y}
    (hP' : inverseTransformPrimeDivisor πy P = some P') : F ≠ P' := by
  rintro rfl
  have h1 := (mem_support_iff_of_idealSheaf_eq_exceptionalIdeal hy hF F.genericPoint).mp (by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)
  rw [(map_genericPoint_of_inverseTransformPrimeDivisor_eq_some hP').1] at h1
  exact genericPoint_ne_of_isClosed hY hYd hy P h1

/-- **The strict transform meets the exceptional curve with multiplicity `mult_y D`.** With
`π^* D = D' + (mult_y D) F`, `(π^* D · F) = 0` and `F² = -1`, `(D' · F) = mult_y D`. -/
private theorem isIntersectionNumber_strictTransform_exceptional (hY : MMP.Mori.IsVariety k sY)
    (hYs : IsSmoothScheme sY) (hYd : topologicalKrullDim Y = 2) {y : Y}
    (hy : IsClosed ({y} : Set Y)) {F : MMP.Mori.PrimeDivisor Y'y}
    (hF : F.idealSheaf = exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{y}, hy⟩))
    {D : MMP.Mori.PrimeDivisor Y} {D' : MMP.Mori.PrimeDivisor Y'y}
    (hD' : inverseTransformPrimeDivisor πy D = some D') :
    haveI := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme
      (isSmoothScheme_blowUp_singleton hY hYs hYd hy)).1
    haveI := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme
      (isSmoothScheme_blowUp_singleton hY hYs hYd hy)).2
    haveI := (isVariety_blowUp_singleton hY hYd hy).toQuasiCompact
    IsIntersectionNumber (πy ≫ sY) (Finsupp.single D' (1 : ℚ)) F.idealSheaf
      ((D.multiplicityAt y).toNat : ℚ) := by
  have hYsm := isSmoothScheme_blowUp_singleton hY hYs hYd hy
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme hYs).1
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme hYs).2
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme hYsm).1
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme hYsm).2
  have hvar := isVariety_blowUp_singleton hY hYd hy
  have := hvar.toQuasiCompact
  have : IsIntegral Y'y := hvar.toIsIntegral
  have : IsSeparated sY := hY.toIsSeparated
  have : LocallyOfFiniteType sY := hY.toLocallyOfFiniteType
  have : QuasiCompact sY := hY.toQuasiCompact
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  have := compactSpace_blowUp_singleton hY hYd hy
  -- the exceptional curve is a proper curve
  obtain ⟨-, -, -, -, F₀, hF₀, -, hprop, hself⟩ :=
    blowUp_singleton_smooth_isProper_isBirational_exceptional_selfIntersection hY hYs hYd hy
  have hFF₀ : F₀ = F := MMP.Mori.PrimeDivisor.ext_idealSheaf (by rw [hF₀, hF])
  subst hFF₀
  set F' : ProperCurve (πy ≫ sY) := ⟨F₀.genericPoint, hprop⟩
  have hFmem := mem_support_iff_of_idealSheaf_eq_exceptionalIdeal hy hF
  -- `(F · F) = -1`
  have hFF : IsIntersectionNumber (πy ≫ sY) (Finsupp.single F₀ (1 : ℚ)) F₀.idealSheaf (-1) := by
    have h := isIntersectionNumber_of_properCurve (Divisor.toQDivisor (Finsupp.single F₀ 1))
      (MMP.Threefold.Mori.isQCartier_single_of_isSmoothScheme hYsm F₀) F' F₀ rfl
    rw [hself F' rfl, toQDivisor_single, Int.cast_one] at h
    exact h
  -- `(π^* D · F) = 0`
  have hD := MMP.Threefold.Mori.isCartier_single_of_isSmoothScheme hYs D
  have hB := blowUpToBase_componentGenericPoint_notMem_supp hY hYd hy (Finsupp.single D (1 : ℤ))
  have hcon : F'.IsContractedBy πy := by
    intro q hq
    change q ∈ closure {F₀.genericPoint} at hq
    rw [← AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hq
    rw [(hFmem q).mp hq, (hFmem _).mp (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)]
  have h0 := Divisor.degreeOn_pullback_eq_zero_of_isContractedBy (sY := sY)
    (sX := πy ≫ sY) πy rfl hD hB F' hcon
  have hD'c := hD.isCartier_pullback πy hB
  have : IsProper (F'.ι ≫ πy ≫ sY) := ProperCurve.isProper_ι_comp F'
  have hpb := isIntersectionNumber_of_properCurve (Divisor.toQDivisor (Divisor.pullback
    (f := πy) _ hD hB)) (QDivisor.isQCartier_toQDivisor hD'c) F' F₀ rfl
  rw [QDivisor.intersectionNumber_toQDivisor k _ _ _ _ hD'c, h0, Int.cast_zero] at hpb
  have hpbeq := pullback_single_blowUp_singleton hY hYs hYd hy hF D
  rw [hpbeq, map_add, inverseTransformDivisor_single, hD'] at hpb
  change IsIntersectionNumber _ (Divisor.toQDivisor (Finsupp.single D' 1) +
    Divisor.toQDivisor (Finsupp.single F₀ _)) _ 0 at hpb
  rw [toQDivisor_single, toQDivisor_single, Int.cast_one, Int.cast_natCast] at hpb
  -- `(D' · F)` exists
  obtain ⟨x, hx⟩ : ∃ x, IsIntersectionNumber (πy ≫ sY) (Finsupp.single D' (1 : ℚ))
      F₀.idealSheaf x := by
    obtain ⟨hp, hdim, -, -⟩ := hFF
    exact ⟨_, hp, hdim, MMP.Fourfold.isQCartier_of_isSmoothScheme hYsm _, rfl⟩
  have hsm := hFF.smul ((D.multiplicityAt y).toNat : ℚ)
    (MMP.Fourfold.isQCartier_of_isSmoothScheme hYsm _)
  rw [Finsupp.smul_single, smul_eq_mul, mul_one] at hsm
  have hsum := MMP.Flips.isIntersectionNumber_add hx hsm
  have := hsum.unique hpb
  have hxeq : x = ((D.multiplicityAt y).toNat : ℚ) := by linarith
  rwa [hxeq] at hx

/-- The support of the birational transform of `T` in the blow-up of a closed point `p` is the
closure of `π⁻¹(T) ∖ E`. -/
private theorem support_birationalTransform {S : Scheme.{u}} {p : S} (hp : IsClosed ({p} : Set S))
    [IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))]
    (T : S.IdealSheafData) :
    ((MMP.Resolution.birationalTransform p hp T).support :
        Set (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))) =
      closure (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩) ⁻¹'
        (T.support : Set S) \
        (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support) := by
  set q := Limits.pullback.snd T.subschemeι
    (blowUpToBase (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩))
  set U := q ⁻¹ᵁ (exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{p}, hp⟩)).support.compl
  have : NoetherianSpace U.toScheme :=
    (q.isClosedEmbedding.isInducing.comp U.ι.isOpenEmbedding.isInducing).noetherianSpace
  rw [MMP.Resolution.birationalTransform, Scheme.Hom.support_ker]
  congr 1
  rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι,
    Scheme.Hom.coe_preimage, Set.image_preimage_eq_inter_range, Scheme.Pullback.range_snd,
    Scheme.IdealSheafData.range_subschemeι, Set.diff_eq, Set.inter_comm]
  rfl

end Blowup

/-! ### The case `mult_P B = 2` -/

open MMP.Threefold.Resolution in
/-- The case `mult_P B = 2`: the strict transform of `B` on the blow-up of `P` meets the
exceptional curve in two points. -/
private theorem isFig3Type9_of_sum_eq_two {k : Type u} [Field k] [IsAlgClosed k]
    {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    {P : X} {B : QDivisor X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y]
    [IsNormal Y] {E : Fin 0 → MMP.Mori.PrimeDivisor Y}
    (hB : IsSurfaceGermWithBoundary sX P B) (hred : IsReducedBoundary B)
    (hf : IsMinimalGermResolution sX P f) (hE : IsExceptionalCurveEnumeration f P E)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 2)
    (hlc : HoldsOnGerm {P} fun U : X.Opens => ∀ [Nonempty U],
      haveI : CompactSpace U := isCompact_iff_compactSpace.mp
        (@NoetherianSpace.isCompact _ _ (haveI : IsNoetherian X := {}; inferInstance) _)
      IsLogCanonical (U.ι ≫ sX) 2 (DivisorWithCoeffs.restrictOpen U K)
        (DivisorWithCoeffs.restrictOpen U (QDivisor.toRDivisor B)))
    (hsm : IsSmoothScheme sX) (h2 : ∑ C ∈ B.support, (C.multiplicityAt P).toNat = 2) :
    IsFig3Type9 sX P B := by
  classical
  have hP := hB.1
  have hXv : MMP.Mori.IsVariety k sX := hP.1.1
  have hXd := hP.2.1
  have hPcl := hP.2.2.1
  have : QuasiCompact sX := hXv.toQuasiCompact
  have ha := isGermLogDiscrepancyVector_of_isEmpty hB (isGermResolution_id hP hsm) _
    (isExceptionalCurveEnumeration_id P) Fin.elim0
  have hmult1 : ∀ C ∈ B.support, 1 ≤ (C.multiplicityAt P).toNat ∧ C.multiplicityAt P ≠ ⊤ :=
    fun C hC => one_le_toNat_multiplicityAt hXv hsm C (hB.2.1 C hC)
  have hmultB : DivisorWithCoeffs.multiplicityAt B P = 2 := by
    rw [multiplicityAt_eq_sum_of_isReducedBoundary hred, ← Nat.cast_sum, h2, Nat.cast_ofNat]
  have hirr := isIrreducible_support_vanishingIdeal_singleton hPcl
  have hsb := isSmoothBlowup_vanishingIdeal_singleton (sY := sX) hsm hPcl
  set F : MMP.Mori.PrimeDivisor (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩)) :=
    MMP.Resolution.exceptionalPrimeDivisor sX _ hsb hirr
      (one_le_codimension_vanishingIdeal_singleton hXd hPcl)
  have hF : F.idealSheaf = exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩) :=
    rfl
  obtain ⟨hres', E', -, hEnum', hiff⟩ := isGermLogDiscrepancyVector_snoc_blowUp_iff ha hPcl rfl hF
  set π := blowUpToBase (Scheme.IdealSheafData.vanishingIdeal (⟨{P}, hPcl⟩ : Closeds X))
  have := hres'.quasiCompact_comp
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme
    hres'.isSmoothResolution.isSmoothScheme).1
  have := (isLocallyNoetherian_and_isNormal_of_isSmoothScheme
    hres'.isSmoothResolution.isSmoothScheme).2
  set a' : Fin 1 → ℚ := Fin.snoc Fin.elim0 (2 - DivisorWithCoeffs.multiplicityAt
    (logPullbackBoundary (𝟙 X) B Fin.elim0 Fin.elim0) P) with ha'def
  have ha' := (hiff a').2 rfl
  set Θ' := logPullbackBoundary (π ≫ 𝟙 X) B (Fin.snoc E' F : Fin 1 → _) a' with hΘ'def
  have hΘ' : Θ' = inverseTransformDivisor π B + Finsupp.single F 1 := by
    rw [hΘ'def, logPullbackBoundary, Category.comp_id, Fin.sum_univ_castSucc]
    simp only [ha'def, logPullbackBoundary_id, hmultB]
    have hl : (Fin.snoc E' F : Fin 1 → _) 0 = F := Fin.snoc_last (α := fun _ => _) F E'
    have hl' : (Fin.snoc Fin.elim0 (0 : ℚ) : Fin 1 → ℚ) 0 = 0 :=
      Fin.snoc_last (α := fun _ => ℚ) 0 Fin.elim0
    simp [hl, hl']
  -- the blown-up surface `Y'`
  have hY'v : MMP.Mori.IsVariety k (π ≫ sX) := isVariety_blowUp_singleton hXv hXd hPcl
  have hY's : IsSmoothScheme (π ≫ sX) := isSmoothScheme_blowUp_singleton hXv hsm hXd hPcl
  have hY'd := hres'.topologicalKrullDim_eq
  have : QuasiCompact (π ≫ sX) := hY'v.toQuasiCompact
  have : CompactSpace (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩)) :=
    compactSpace_blowUp_singleton hXv hXd hPcl
  have : IsNoetherian (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩)) := {}
  have : IsIntegral (blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩)) :=
    hY'v.toIsIntegral
  have : LocallyOfFiniteType (π ≫ sX) := hY'v.toLocallyOfFiniteType
  have hFy : ∀ q, q ∈ F.support ↔ π q = P :=
    mem_support_iff_of_idealSheaf_eq_exceptionalIdeal hPcl hF
  have hηne : ∀ D : MMP.Mori.PrimeDivisor X, D.genericPoint ≠ P :=
    genericPoint_ne_of_isClosed hXv hXd hPcl
  choose T hT hTη using fun C : MMP.Mori.PrimeDivisor X =>
    MMP.Flips.exists_inverseTransformPrimeDivisor_eq_some (g := π) C
      (mem_biregularLocus_blowUpToBase_singleton hPcl (hηne C))
  have hTF : ∀ C, F ≠ T C := fun C =>
    ne_of_inverseTransformPrimeDivisor_eq_some hXv hXd hPcl hF (hT C)
  have hTinj : Function.Injective T := fun C D h =>
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((hTη C).symm.trans (h ▸ hTη D))
  -- coefficients of `Θ'`
  have hΘ'F : Θ' F = 1 := by
    rw [hΘ', Finsupp.add_apply, Finsupp.single_eq_same]
    have h0 : inverseTransformDivisor π B F = 0 := by
      by_contra h0
      obtain ⟨D, hD⟩ := exists_eq_some_of_mem_support_mapPrimeDivisors
        (Finsupp.mem_support_iff.2 h0)
      exact ne_of_inverseTransformPrimeDivisor_eq_some hXv hXd hPcl hF hD rfl
    rw [h0, zero_add]
  have hΘ'T : ∀ C, Θ' (T C) = B C := by
    intro C
    rw [hΘ', Finsupp.add_apply, inverseTransformDivisor_apply_of_eq_some (hT C),
      Finsupp.single_apply, if_neg (hTF C), add_zero]
  have hΘ'nn : ∀ D, 0 ≤ Θ' D := by
    intro D
    rw [hΘ', Finsupp.add_apply]
    have h1 : 0 ≤ inverseTransformDivisor π B D := by
      by_cases hD : inverseTransformDivisor π B D = 0
      · rw [hD]
      · obtain ⟨C, hC⟩ := exists_eq_some_of_mem_support_mapPrimeDivisors
          (Finsupp.mem_support_iff.2 hD)
        rw [inverseTransformDivisor_apply_of_eq_some hC]
        exact (hB.2.2 C).1
    have h2 : (0 : ℚ) ≤ Finsupp.single F 1 D := by
      rw [Finsupp.single_apply]; split_ifs <;> norm_num
    linarith
  -- points of `F ∩ T C` are closed
  have hFcl : IsClosed (F.support : Set _) := F.idealSheaf.support.isClosed
  have hclosed : ∀ C, ∀ q ∈ F.support ∩ (T C).support, IsClosed ({q} : Set _) := by
    rintro C q ⟨hqF, hqT⟩
    by_contra hq
    have hFne : (F.support : Set _) ≠ Set.univ := fun h =>
      hηne C ((hTη C) ▸ (hFy _).1 (h ▸ Set.mem_univ _))
    have h1 := coheight_eq_one_of_not_isClosed (π ≫ sX) hY'd hq
      (closure_singleton_ne_univ hFcl hFne hqF)
    have key : ∀ D : MMP.Mori.PrimeDivisor (blowUp (Scheme.IdealSheafData.vanishingIdeal
        ⟨{P}, hPcl⟩)), q ∈ D.support → D.genericPoint = q := by
      intro D hqD
      by_contra hne
      have hsp : D.genericPoint ⤳ q := by
        rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact hqD
      have := coheight_add_one_le_of_specializes hsp hne
      rw [MMP.Mori.PrimeDivisor.coheight_genericPoint, h1] at this
      exact absurd this (by decide)
    exact hTF C (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      ((key F hqF).trans (key _ hqT).symm))
  have hqP : ∀ q, q ∈ F.support → (π ≫ 𝟙 X) q = P := by
    intro q hq
    rw [Category.comp_id]
    exact (hFy q).1 hq
  -- log canonicity bounds the multiplicities on `F`
  have hbound : ∀ q, IsClosed ({q} : Set _) → q ∈ F.support →
      ¬ 2 < DivisorWithCoeffs.multiplicityAt Θ' q := fun q hqc hqF h =>
    ha'.not_isLogCanonical_of_two_lt_multiplicityAt hqc (hqP q hqF) h hK hlc
  have hfib : ∀ q, IsClosed ({q} : Set _) → q ∈ F.support → ∀ S ⊆ B.support,
      (∀ C ∈ S, q ∈ (T C).support) → ∑ C ∈ S, ((T C).multiplicityAt q).toNat ≤ 1 := by
    intro q hqc hqF S hS hST
    have hle := sum_mul_le_multiplicityAt (x := q) (fun D _ => hΘ'nn D) (insert F (S.image T))
    have hnot := hbound q hqc hqF
    rw [Finset.sum_insert (by
        simp only [Finset.mem_image, not_exists, not_and]
        exact fun C _ h => hTF C h.symm),
      Finset.sum_image (fun C _ D _ h => hTinj h), hΘ'F, mul_one] at hle
    have hsum : ∑ C ∈ S, (((T C).multiplicityAt q).toNat : ℚ) * Θ' (T C) =
        ∑ C ∈ S, (((T C).multiplicityAt q).toNat : ℚ) :=
      Finset.sum_congr rfl fun C hC => by rw [hΘ'T, hred C (hS hC), mul_one]
    rw [hsum] at hle
    have hF1 : (1 : ℚ) ≤ (F.multiplicityAt q).toNat := by
      exact_mod_cast (one_le_toNat_multiplicityAt hY'v hY's F hqF).1
    have : ((∑ C ∈ S, ((T C).multiplicityAt q).toNat : ℕ) : ℚ) ≤ 1 := by
      push_cast
      linarith [not_lt.mp hnot]
    exact_mod_cast this
  have huniq : ∀ q, IsClosed ({q} : Set _) → q ∈ F.support → ∀ C ∈ B.support,
      ∀ D ∈ B.support, q ∈ (T C).support → q ∈ (T D).support → C = D := by
    intro q hqc hqF C hC D hD hqC hqD
    by_contra hCD
    have := hfib q hqc hqF {C, D}
      (by intro x hx; simp only [Finset.mem_insert, Finset.mem_singleton] at hx
          rcases hx with rfl | rfl <;> assumption)
      (by intro x hx; simp only [Finset.mem_insert, Finset.mem_singleton] at hx
          rcases hx with rfl | rfl <;> assumption)
    rw [Finset.sum_pair hCD] at this
    have h1 := (one_le_toNat_multiplicityAt hY'v hY's (T C) hqC).1
    have h2 := (one_le_toNat_multiplicityAt hY'v hY's (T D) hqD).1
    omega
  have hmultq : ∀ q, IsClosed ({q} : Set _) → q ∈ F.support → ∀ C ∈ B.support,
      q ∈ (T C).support → (T C).multiplicityAt q = 1 := by
    intro q hqc hqF C hC hqC
    have := hfib q hqc hqF {C} (by simpa using hC) (by simpa using hqC)
    rw [Finset.sum_singleton] at this
    obtain ⟨h1, htop⟩ := one_le_toNat_multiplicityAt hY'v hY's (T C) hqC
    lift (T C).multiplicityAt q to ℕ using htop with m
    simp only [ENat.toNat_coe] at h1 this
    rw [show m = 1 by omega]; rfl
  -- `F` is a smooth proper curve
  have hFprop : IsProper (F.idealSheaf.subschemeι ≫ π ≫ sX) := by
    have h := (IsGermExceptionalCurve.isProper sX hres'
      (hEnum'.isGermExceptionalCurve (Fin.last 0))).2
    rw [Fin.snoc_last (α := fun _ => _), Category.comp_id] at h
    exact h
  have hFsm : Smooth (F.idealSheaf.subschemeι ≫ π ≫ sX) :=
    (smooth_exceptionalDivisor_and_fiber_iso_projSpace sX _ hsb hirr
      (by rw [codimension_vanishingIdeal_singleton_eq_two hXv hXd hPcl])).1
  -- each component of `B` meets `F` in `mult_P C` points
  have hcount : ∀ C ∈ B.support, (F.support ∩ (T C).support).Finite ∧
      (F.support ∩ (T C).support).ncard = (C.multiplicityAt P).toNat := by
    intro C hC
    obtain ⟨hfin, hint, hpos⟩ := isIntersectionNumber_finsum_localIntersectionNumber_of_ne
      (π ≫ sX) hY'v hY's hY'd (hTF C) hFprop
    have hx := isIntersectionNumber_strictTransform_exceptional hXv hsm hXd hPcl hF (hT C)
    have heq := hint.unique hx
    have hone : ∀ q ∈ F.support ∩ (T C).support, localIntersectionNumber (π ≫ sX) q
        (Finsupp.single F 1) (Finsupp.single (T C) 1) = 1 := by
      intro q hq
      have hp := hpos q hq
      by_contra hne
      have hqc := hclosed C q hq
      refine ha'.not_isLogCanonical_of_two_le_localIntersectionNumber hqc (hqP q hq.1)
        (fun D _ => hΘ'nn D) (hTF C) hΘ'F (by rw [hΘ'T, hred C hC]) ?_ ?_ ?_ hK hlc
      · obtain ⟨z, hz⟩ : q ∈ Set.range F.idealSheaf.subschemeι := by
          rw [Scheme.IdealSheafData.range_subschemeι]; exact hq.1
        refine ⟨z, hz, ?_⟩
        rw [Category.comp_id]
        have : Smooth ((⊤ : (F.idealSheaf.subscheme).Opens).ι ≫
            F.idealSheaf.subschemeι ≫ π ≫ sX) := inferInstance
        exact le_smoothLocus _ this trivial
      · obtain ⟨z, hz, hzs⟩ := (multiplicityAt_eq_one_iff_exists_mem_smoothLocus hY'v hY's hY'd
          (T C) hq.2).1 (hmultq q hqc hq.1 C hC hq.2)
        exact ⟨z, hz, by rwa [Category.comp_id]⟩
      · have h2 : 2 ≤ localIntersectionNumber (π ≫ sX) q (Finsupp.single F 1)
            (Finsupp.single (T C) 1) := by omega
        rw [Category.comp_id]; exact h2
    rw [finsum_mem_congr rfl (fun q hq => by rw [hone q hq]),
      finsum_mem_eq_finite_toFinset_sum _ hfin, Finset.sum_const] at heq
    refine ⟨hfin, ?_⟩
    rw [Set.ncard_eq_toFinset_card _ hfin]
    simp only [nsmul_eq_mul, Nat.cast_one, mul_one] at heq
    exact_mod_cast heq
  -- the birational transform of Kollár 1.38 is the strict transform
  have hPnot : P ∉ biregularLocus π := notMem_biregularLocus_blowUpToBase_singleton hXv hXd hPcl hF
  have hbridge : ∀ C : MMP.Mori.PrimeDivisor X,
      ((MMP.Resolution.birationalTransform P hPcl C.idealSheaf).support : Set _) =
        (T C).support := by
    intro C
    rw [support_birationalTransform hPcl, support_inverseTransformPrimeDivisor (hT C),
      inverseTransform, Closeds.coe_closure]
    congr 1
    ext x
    have hxE : x ∈ ((exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal
        ⟨{P}, hPcl⟩)).support : Set _) ↔ π x = P := hFy x
    simp only [Set.mem_diff, Set.mem_preimage, Set.mem_inter_iff, hxE, SetLike.mem_coe]
    refine and_congr Iff.rfl ⟨fun h => mem_biregularLocus_blowUpToBase_singleton hPcl h,
      fun h h' => hPnot ((congrArg (· ∈ biregularLocus π) h').mp h)⟩
  refine ⟨hB, Y, f, inferInstance, inferInstance, inferInstance, 0, E, hf, hE,
    Or.inl ⟨rfl, hPcl, fun C => (C.multiplicityAt P).toNat, ?_, ?_, ?_⟩⟩
  · intro C hC
    rw [ENat.coe_toNat (hmult1 C hC).2, MMP.Resolution.multAt, MMP.Resolution.idealOrder,
      ← Scheme.IdealSheafData.stalkIdeal_eq_stalk]
    rfl
  · rw [← Nat.cast_ofNat, ← h2, Nat.cast_sum]
    exact Finset.sum_congr rfl fun C hC => by rw [hred C hC, one_mul]
  · have hset : (⋃ C ∈ B.support,
        ((MMP.Resolution.birationalTransform P hPcl C.idealSheaf).support : Set _)) ∩
        ((exceptionalIdeal (Scheme.IdealSheafData.vanishingIdeal ⟨{P}, hPcl⟩)).support :
          Set _) = ⋃ C ∈ B.support, (F.support ∩ (T C).support) := by
      rw [Set.iUnion₂_inter]
      refine Set.iUnion₂_congr fun C _ => ?_
      rw [hbridge C, Set.inter_comm]
      rfl
    rw [hset, ncard_biUnion_finset _ _ ?_ fun C hC => (hcount C hC).1, ← h2]
    · exact Finset.sum_congr rfl fun C hC => (hcount C hC).2
    · intro C hC D hD hCD
      rw [Function.onFun, Set.disjoint_left]
      rintro q ⟨hqF, hqC⟩ ⟨-, hqD⟩
      exact hCD (huniq q (hclosed C q ⟨hqF, hqC⟩) hqF C hC D hD hqC hqD)

/-! ### The cases `mult_P B ≤ 1` -/

/-- The case `mult_P B = 0`: `B = 0`, type (1) with the empty chain. -/
private theorem isFig3Type1_of_sum_eq_zero {k : Type u} [Field k] [IsAlgClosed k]
    {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {P : X} {B : QDivisor X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)]
    [IsLocallyNoetherian Y] [IsNormal Y] {E : Fin 0 → MMP.Mori.PrimeDivisor Y}
    (hB : IsSurfaceGermWithBoundary sX P B) (hf : IsMinimalGermResolution sX P f)
    (hE : IsExceptionalCurveEnumeration f P E) (hsm : IsSmoothScheme sX)
    (h0 : ∑ C ∈ B.support, (C.multiplicityAt P).toNat = 0) : IsFig3Type1 sX P B := by
  have hB0 : B = 0 := Finsupp.support_eq_empty.mp <| Finset.eq_empty_of_forall_notMem
    fun C hC => by
      have := (one_le_toNat_multiplicityAt hB.1.1.1 hsm C (hB.2.1 C hC)).1
      rw [Finset.sum_eq_zero_iff.mp h0 C hC] at this
      exact absurd this (by decide)
  exact ⟨hB0, 0, ⟨Fin.elim0, Fin.elim0, Fin.elim0, fun v => v.elim0, fun v => v.elim0,
    fun v => v.elim0, fun v => v.elim0⟩, ⟨Y, f, inferInstance, inferInstance, inferInstance, E,
    hf, ⟨hB, hf.1, hE, fun j => j.elim0, fun j => j.elim0, fun j => j.elim0,
    fun j => j.elim0⟩⟩, ⟨0, Equiv.refl _, ⟨fun i => i.elim0, fun i => i.elim0⟩⟩,
    fun j => j.elim0⟩

/-- The case `mult_P B = 1`: `B` is a single curve, smooth at `P`, type (3). -/
private theorem isFig3Type3_of_sum_eq_one {k : Type u} [Field k] [IsAlgClosed k]
    {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [LocallyOfFiniteType sX] {P : X} {B : QDivisor X} {f : Y ⟶ X}
    [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y] [IsNormal Y]
    {E : Fin 0 → MMP.Mori.PrimeDivisor Y} (hB : IsSurfaceGermWithBoundary sX P B)
    (hf : IsMinimalGermResolution sX P f) (hE : IsExceptionalCurveEnumeration f P E)
    (hsm : IsSmoothScheme sX) (h1 : ∑ C ∈ B.support, (C.multiplicityAt P).toNat = 1) :
    IsFig3Type3 sX P B := by
  have hXv : MMP.Mori.IsVariety k sX := hB.1.1.1
  have hmult1 := fun C (hC : C ∈ B.support) => one_le_toNat_multiplicityAt hXv hsm C (hB.2.1 C hC)
  obtain ⟨C, hC⟩ : ∃ C, B.support = {C} := by
    refine Finset.card_eq_one.mp (le_antisymm ?_ ?_)
    · exact ((Finset.card_eq_sum_ones _).trans_le
        (Finset.sum_le_sum fun C hC => (hmult1 C hC).1)).trans_eq h1
    · rw [Nat.one_le_iff_ne_zero, Ne, Finset.card_eq_zero]
      rintro h
      simp [h] at h1
  have hCB : C ∈ B.support := hC ▸ Finset.mem_singleton_self C
  have hCm : C.multiplicityAt P = 1 := by
    rw [hC, Finset.sum_singleton] at h1
    rw [← ENat.coe_toNat (hmult1 C hCB).2, h1]
    rfl
  obtain ⟨z, hz, hzs⟩ := (MMP.Threefold.Resolution.multiplicityAt_eq_one_iff_exists_mem_smoothLocus
    hXv hsm hB.1.2.1 C (hB.2.1 C hCB)).1 hCm
  have hreg := (mem_smoothLocus_subschemeι_iff sX C.idealSheaf z).1 hzs
  rw [hz] at hreg
  refine ⟨hB, Y, f, inferInstance, inferInstance, inferInstance, 0, E, hf, hE,
    Or.inl ⟨rfl, C, hC, ?_⟩⟩
  rwa [← Scheme.IdealSheafData.stalkIdeal_eq_stalk]

/-! ### The main result: types (1), (3) and (9) -/

/-- **Log canonical germs with reduced boundary at a smooth point** (FA Fig. 3 (1), (3), (9)).
Let `(X, P; B)` be a surface germ with reduced boundary over an algebraically closed field `k`,
whose minimal resolution `f` has no exceptional curves. If `(X, B)` is log canonical near `P`
(on some open neighbourhood `U` of `P`, `(U, B|_U)` is log canonical with canonical divisor
`K_X|_U`), then `(X, P; B)` is of type (1), (3) or (9). -/
@[mmp "lem_fa3_smooth_point_lc_only_if"]
public theorem IsMinimalGermResolution.isFig3Type1_or_isFig3Type3_or_isFig3Type9
    {k : Type u} [Field k] [IsAlgClosed k] {X Y : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [LocallyOfFiniteType sX]
    {P : X} {B : QDivisor X} {f : Y ⟶ X} [QuasiCompact (f ≫ sX)] [IsLocallyNoetherian Y]
    [IsNormal Y] {E : Fin 0 → Mori.PrimeDivisor Y}
    (hB : IsSurfaceGermWithBoundary sX P B) (hred : IsReducedBoundary B)
    (hf : IsMinimalGermResolution sX P f) (hE : IsExceptionalCurveEnumeration f P E)
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX 2)
    (hlc : HoldsOnGerm {P} fun U : X.Opens => ∀ [Nonempty U],
      haveI : CompactSpace U := isCompact_iff_compactSpace.mp
        (@NoetherianSpace.isCompact _ _ (haveI : IsNoetherian X := {}; inferInstance) _)
      IsLogCanonical (U.ι ≫ sX) 2 (DivisorWithCoeffs.restrictOpen U K)
        (DivisorWithCoeffs.restrictOpen U (QDivisor.toRDivisor B))) :
    IsFig3Type1 sX P B ∨ IsFig3Type3 sX P B ∨ IsFig3Type9 sX P B := by
  classical
  have hsm : IsSmoothScheme sX := hf.1.isSmoothScheme_of_isExceptionalCurveEnumeration hE
  rcases (show ∀ m : ℕ, m = 0 ∨ m = 1 ∨ m = 2 ∨ 3 ≤ m by omega)
      (∑ C ∈ B.support, (C.multiplicityAt P).toNat) with h0 | h1 | h2 | h3
  · exact .inl (isFig3Type1_of_sum_eq_zero hB hf hE hsm h0)
  · exact .inr (.inl (isFig3Type3_of_sum_eq_one hB hf hE hsm h1))
  · exact .inr (.inr (isFig3Type9_of_sum_eq_two hB hred hf hE hK hlc hsm h2))
  · exfalso
    have : QuasiCompact sX := hB.1.1.1.toQuasiCompact
    refine (isGermLogDiscrepancyVector_of_isEmpty hB (isGermResolution_id hB.1 hsm) _
      (isExceptionalCurveEnumeration_id P) Fin.elim0).not_isLogCanonical_of_two_lt_multiplicityAt
      hB.1.2.2.1 rfl ?_ hK hlc
    rw [logPullbackBoundary_id, multiplicityAt_eq_sum_of_isReducedBoundary hred, ← Nat.cast_sum]
    exact_mod_cast h3

end MMP.Flips

/-! ## The section module of a relatively semiample invertible module -/

namespace MMP

open MonoidalCategory Stacks.GradedSections Stacks.TensorPowers

attribute [local implicit_reducible] Stacks.TensorPowers.natTensorPow

/-! ### Monoidal identities for the multiplication maps -/

section Monoidal

variable {C : Type*} [Category C] [MonoidalCategory C]

/-- Multiplying by `t` and then by `s` is multiplying by the product `s · t`. -/
private theorem mulMap_comp_mulMap {L : C} {a b : ℕ} (t : powSections L a)
    (s : powSections L b) : ∀ m : ℕ, mulMap t m ≫ mulMap s (a + m) =
      mulMap (mul s t) m ≫ eqToHom (congrArg (natTensorPow L) (Nat.add_assoc b a m))
  | 0 => by
    change t ≫ mulMap s a = (t ≫ mulMap s a) ≫ eqToHom rfl
    simp
  | m + 1 => by
    rw [mulMap_succ, mulMap_succ, show mulMap s (a + (m + 1)) = mulMap s (a + m) ▷ L from
      mulMap_succ s (a + m), ← comp_whiskerRight, mulMap_comp_mulMap t s m, comp_whiskerRight,
      eqToHom_whiskerRight]

private theorem leftUnitor_conj_whiskerRight (e : 𝟙_ C ⟶ 𝟙_ C) (Z L : C) :
    ((λ_ Z).inv ≫ e ▷ Z ≫ (λ_ Z).hom) ▷ L =
      (λ_ (Z ⊗ L)).inv ≫ e ▷ (Z ⊗ L) ≫ (λ_ (Z ⊗ L)).hom := by
  monoidal

private theorem leftUnitor_conj_eq_rightUnitor_conj [BraidedCategory C] (e : 𝟙_ C ⟶ 𝟙_ C)
    (Z : C) : (λ_ Z).inv ≫ e ▷ Z ≫ (λ_ Z).hom = (ρ_ Z).inv ≫ Z ◁ e ≫ (ρ_ Z).hom := by
  rw [← braiding_leftUnitor, BraidedCategory.braiding_naturality_right_assoc]
  simp

private theorem whiskerLeft_rightUnitor_conj (e : 𝟙_ C ⟶ 𝟙_ C) (F Z : C) :
    F ◁ ((ρ_ Z).inv ≫ Z ◁ e ≫ (ρ_ Z).hom) =
      (ρ_ (F ⊗ Z)).inv ≫ (F ⊗ Z) ◁ e ≫ (ρ_ (F ⊗ Z)).hom := by
  monoidal

private theorem comp_rightUnitor_conj (e : 𝟙_ C ⟶ 𝟙_ C) (Z : C) (y : 𝟙_ C ⟶ Z) :
    y ≫ (ρ_ Z).inv ≫ Z ◁ e ≫ (ρ_ Z).hom = e ≫ y := by
  rw [rightUnitor_inv_naturality_assoc, ← whisker_exchange_assoc, rightUnitor_naturality]
  simp [unitors_equal, unitors_inv_equal]

/-- Multiplication by an element of degree zero is its left action. -/
private theorem mulMap_zero_eq {L : C} (e : powSections L 0) :
    ∀ q : ℕ, mulMap e q ≫ eqToHom (congrArg (natTensorPow L) (Nat.zero_add q)) =
      (λ_ _).inv ≫ e ▷ natTensorPow L q ≫ (λ_ _).hom
  | 0 => by
    change e ≫ eqToHom rfl = (λ_ (𝟙_ C)).inv ≫ e ▷ 𝟙_ C ≫ (λ_ (𝟙_ C)).hom
    simp [unitors_equal, unitors_inv_equal]
    erw [Iso.inv_hom_id, Category.comp_id]
  | q + 1 => by
    have h := congrArg (· ▷ L) (mulMap_zero_eq e q)
    rw [comp_whiskerRight, eqToHom_whiskerRight] at h
    rw [mulMap_succ]
    exact h.trans (leftUnitor_conj_whiskerRight e _ L)

/-- A section of `F ⊗ L^{⊗ q}` multiplied by an element `e` of degree zero is `e ≫ y`. -/
private theorem comp_whiskerLeft_mulMap_zero [BraidedCategory C] {L F : C}
    (e : powSections L 0) (q : ℕ) (y : 𝟙_ C ⟶ F ⊗ natTensorPow L q) :
    y ≫ F ◁ mulMap e q =
      (e ≫ y) ≫ F ◁ eqToHom (congrArg (natTensorPow L) (Nat.zero_add q)).symm := by
  have h : mulMap e q = ((λ_ _).inv ≫ e ▷ natTensorPow L q ≫ (λ_ _).hom) ≫
      eqToHom (congrArg (natTensorPow L) (Nat.zero_add q)).symm := by
    rw [← mulMap_zero_eq e q]; simp
  rw [h, MonoidalCategory.whiskerLeft_comp, leftUnitor_conj_eq_rightUnitor_conj,
    whiskerLeft_rightUnitor_conj, ← Category.assoc, comp_rightUnitor_conj]

open MMP.SemiampleSections in
/-- Iterated right whiskering commutes with left whiskering, as arrows. -/
private def iterWhiskerLeftArrowIso (F J : C) {A B : C} (φ : A ⟶ B) :
    (k : ℕ) → (Arrow.mk ((iter (tensorRight J) k).map (F ◁ φ)) ≅
      Arrow.mk (F ◁ (iter (tensorRight J) k).map φ))
  | 0 => Iso.refl _
  | k + 1 => (tensorRight J).mapArrow.mapIso (iterWhiskerLeftArrowIso F J φ k) ≪≫
      Arrow.isoMk (α_ _ _ _) (α_ _ _ _) (associator_naturality_middle _ _ _).symm

end Monoidal

/-! ### Generation of the high twists of a coherent module -/

section Scheme

open MMP.SemiampleSections Stacks.TwistedSections CategoryTheory.Limits

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

/-- Left whiskering of `𝒪_X`-modules is additive: it is right whiskering up to the braiding. -/
private theorem whiskerLeft_sum {X : Scheme.{u}} (F : X.Modules) {A B : X.Modules} {ι : Type*}
    (t : Finset ι) (φ : ι → (A ⟶ B)) : F ◁ ∑ i ∈ t, φ i = ∑ i ∈ t, F ◁ φ i := by
  have key : ∀ ψ : A ⟶ B, F ◁ ψ = (β_ F A).hom ≫ (tensorRight F).map ψ ≫ (β_ F B).inv :=
    fun ψ => by
      change F ◁ ψ = (β_ F A).hom ≫ ψ ▷ F ≫ (β_ F B).inv
      rw [← BraidedCategory.braiding_naturality_right_assoc]
      simp
  rw [key, Functor.map_sum, Preadditive.sum_comp, Preadditive.comp_sum]
  exact Finset.sum_congr rfl fun i _ => (key (φ i)).symm

/-- **From the sheafified-tensor twist by `E` to the twist by `M`, after `F ⊗ -`.** Let
`θ : E ≅ M^{⊗ D}` and `φ : Q ⟶ E`. If `(F ⊗ M^{⊗ r}) ⊗ φ`, twisted `k` times by `E` in the
sheafified-tensor spelling, is surjective on global sections, then so is `F ⊗ -` applied to
`φ ≫ θ` twisted `r + D k` times by `M`. -/
private theorem surjective_whiskerLeft_twistPowMap {X : Scheme.{u}} (M F : X.Modules) {D : ℕ}
    {E : X.Modules} (θ : E ≅ natTensorPow M D) {Q : X.Modules} (φ : Q ⟶ E) (r k : ℕ)
    (h : Function.Surjective ((gammaTop X).map ((iter (sheafTensorRight E) k).map
      ((sheafTensorLeft (F ⊗ natTensorPow M r)).map φ)))) :
    Function.Surjective ((gammaTop X).map (F ◁ twistPowMap M (φ ≫ θ.hom) (r + D * k))) := by
  have h3 := surjective_iter_whiskerLeft_comp θ φ k
    (surjective_iter_tensorRight_of_sheafTensor φ k h)
  set χ := φ ≫ θ.hom
  have e4 : (iter (tensorRight (natTensorPow M D)) k).mapArrow.obj
        (Arrow.mk (natTensorPow M r ◁ χ)) ≅ Arrow.mk (twistPowMap M χ (r + D * k)) :=
    (iter (tensorRight (natTensorPow M D)) k).mapArrow.mapIso
      ((whiskerRightArrowIso χ (natTensorPow M r)).symm ≪≫
        (twistPowMapArrowIso M χ r).symm) ≪≫
    eqToIso (arrow_twistPowMap (natTensorPow M D) (twistPowMap M χ r) k).symm ≪≫
      (twistPowMapMulArrowIso M (twistPowMap M χ r) D k).symm ≪≫
      eqToIso (arrow_twistPowMap_twistPowMap M χ r (D * k))
  have a : Arrow.mk ((F ⊗ natTensorPow M r) ◁ χ) ≅ Arrow.mk (F ◁ natTensorPow M r ◁ χ) :=
    Arrow.isoMk (α_ F (natTensorPow M r) Q) (α_ F (natTensorPow M r) (natTensorPow M D))
      (associator_naturality_right _ _ _).symm
  have e1 : Arrow.mk ((iter (tensorRight (natTensorPow M D)) k).map
        ((F ⊗ natTensorPow M r) ◁ χ)) ≅
      Arrow.mk ((iter (tensorRight (natTensorPow M D)) k).map (F ◁ natTensorPow M r ◁ χ)) :=
    (iter (tensorRight (natTensorPow M D)) k).mapArrow.mapIso a
  have e2 := iterWhiskerLeftArrowIso F (natTensorPow M D) (natTensorPow M r ◁ χ) k
  have e3 : Arrow.mk (F ◁ (iter (tensorRight (natTensorPow M D)) k).map
        (natTensorPow M r ◁ χ)) ≅ Arrow.mk (F ◁ twistPowMap M χ (r + D * k)) :=
    (tensorLeft F).mapArrow.mapIso e4
  have h3' : Function.Surjective ((gammaTop X).map (Arrow.mk ((iter (tensorRight
      (natTensorPow M D)) k).map ((F ⊗ natTensorPow M r) ◁ χ))).hom) := h3
  -- elaborated before meeting the goal: unifying the composite iso against it times out
  have := surjective_map_of_arrowIso (gammaTop X) (e1 ≪≫ e2 ≪≫ e3) h3'
  exact this

/-- **Surjectivity on sections of high twists of `F`, through a morphism to a projective
scheme.** The module form of `MMP.SemiampleSections.exists_surjective_twistPowMap_pullback`:
Serre's theorem for the coherent `g_*(F ⊗ M^{⊗ r})` on `P`, carried to `X` by the projection
formula. -/
private theorem exists_surjective_whiskerLeft_twistPowMap_pullback {X P : Scheme.{u}}
    {R : Type u} [CommRing R] [IsNoetherianRing R] (p : X ⟶ Spec (CommRingCat.of R))
    [IsProper p] (π : P ⟶ Spec (CommRingCat.of R)) [IsProper π] (g : X ⟶ P) [IsProper g]
    (O : P.Modules) [Stacks.Ample.IsInvertibleModule P O] (hO : Stacks.Ample.IsAmple P O)
    {m : ℕ} (Ψ : (⨁ fun _ : Fin m => 𝟙_ P.Modules) ⟶ O) [Epi Ψ] (M : X.Modules)
    [Stacks.Ample.IsInvertibleModule X M] (F : X.Modules) [F.IsCoherent] {D : ℕ}
    (θ : (Scheme.Modules.pullback g).obj O ≅ natTensorPow M D) (r : ℕ) :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → Function.Surjective ((gammaTop X).map
      (F ◁ twistPowMap M ((Scheme.Modules.pullback g).map Ψ ≫ θ.hom) (r + D * k))) := by
  have : IsLocallyNoetherian (Spec (CommRingCat.of R)) :=
    isLocallyNoetherian_Spec.mpr inferInstance
  have : IsLocallyNoetherian P := LocallyOfFiniteType.isLocallyNoetherian π
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  have : (F ⊗ natTensorPow M r).IsCoherent :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.isCoherent_tensorObj F _ inferInstance
  have : ((Scheme.Modules.pushforward g).obj (F ⊗ natTensorPow M r)).IsCoherent :=
    AlgebraicGeometry.ProperCoherenceWitness.isCoherent_pushforward g _
  obtain ⟨k₀, hk₀⟩ := exists_surjective_sheafTensor_map π O hO Ψ
    ((Scheme.Modules.pushforward g).obj (F ⊗ natTensorPow M r))
  refine ⟨k₀, fun k hk => ?_⟩
  have h1 := surjective_of_surjective_pushforward g O (F ⊗ natTensorPow M r) Ψ k (hk₀ k hk)
  exact surjective_whiskerLeft_twistPowMap M F θ _ r k h1

/-- **Generation of high twists from surjectivity on sections.** Let `ψ : Q ⟶ M^{⊗ D}` be the
sum `∑ᵢ pᵢ ≫ sᵢ` of maps factoring through `𝒪_X`. If `F ⊗ ψ`, twisted `n` times by `M`, is
surjective on global sections, then every section of `F ⊗ M^{⊗ (D + n)}` is `∑ᵢ sᵢ · aᵢ` with
`aᵢ` sections of `F ⊗ M^{⊗ n}`. -/
private theorem exists_eq_sum_whiskerLeft_mulMap_of_surjective {X : Scheme.{u}}
    (M F : X.Modules) {D : ℕ} {ι : Type*} [Fintype ι] {Q : X.Modules}
    (ψ : Q ⟶ natTensorPow M D) (p : ι → (Q ⟶ 𝟙_ X.Modules)) (s : ι → powSections M D)
    (hps : ∑ i, p i ≫ s i = ψ) (n : ℕ)
    (h : Function.Surjective ((gammaTop X).map (F ◁ twistPowMap M ψ n)))
    (u : 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M (D + n)) :
    ∃ a : ι → (𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n),
      u = ∑ i, a i ≫ F ◁ mulMap (s i) n := by
  set hJ := Stacks.AlgebraicGeometry.ProperAmpleCohomology.twistPow_natTensorPow M D n
  set h1 := Stacks.SectionRingProjTheta.twistPow_unit M n
  obtain ⟨x, hx⟩ := h (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _
    (u ≫ F ◁ eqToHom hJ.symm))
  set v := (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _).symm x
  have hv : v ≫ F ◁ twistPowMap M ψ n = u ≫ F ◁ eqToHom hJ.symm := by
    apply (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X _).injective
    rw [Stacks.AlgebraicGeometry.ProperAmpleCohomology.schemeGlobalSectionsAddEquiv_comp]
    exact (congrArg _ (AddEquiv.apply_symm_apply
      (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X (F ⊗ twistPow Q M n))
      (show Γ(F ⊗ twistPow Q M n, ⊤) from x))).trans hx
  refine ⟨fun i => v ≫ F ◁ (twistPowMap M (p i) n ≫ eqToHom h1), ?_⟩
  have hsum : twistPowMap M ψ n = ∑ i, twistPowMap M (p i) n ≫ twistPowMap M (s i) n := by
    rw [← hps, Stacks.AlgebraicGeometry.ProperAmpleCohomology.twistPowMap_sum]
    exact Finset.sum_congr rfl fun i _ => twistPowMap_comp _ _ _
  calc u = (v ≫ F ◁ twistPowMap M ψ n) ≫ F ◁ eqToHom hJ := by
        rw [hv, Category.assoc, ← MonoidalCategory.whiskerLeft_comp]; simp
    _ = ∑ i, (v ≫ F ◁ (twistPowMap M (p i) n ≫ eqToHom h1)) ≫ F ◁ mulMap (s i) n := by
      rw [hsum, whiskerLeft_sum, Preadditive.comp_sum, Preadditive.sum_comp]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [mulMap_eq_twistPowMap]
      simp only [Category.assoc, ← MonoidalCategory.whiskerLeft_comp]
      simp

/-- **High twists of a coherent module are generated in one degree.** Let `X` be proper over a
Noetherian ring, `M` invertible on `X` with `σ₀, …, σ_N` global sections of `M^{⊗ D}` generating
it, and `F` coherent. Then there are sections `s₀, …, s_N` of `M^{⊗ D}` and an `N₀` such that
for `n ≥ N₀` every section of `F ⊗ M^{⊗ (D + n)}` is `∑ⱼ sⱼ · aⱼ` with `aⱼ` sections of
`F ⊗ M^{⊗ n}`. -/
private theorem exists_forall_eq_sum_whiskerLeft_mulMap {X : Scheme.{u}} {R : Type u}
    [CommRing R] [IsNoetherianRing R] (p : X ⟶ Spec (CommRingCat.of R)) [IsProper p]
    (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M] (F : X.Modules) [F.IsCoherent]
    {D N : ℕ} (hD : 0 < D) [Stacks.Ample.IsInvertibleModule X (natTensorPow M D)]
    (σ : Fin (N + 1) → Γ(natTensorPow M D, ⊤))
    (hσ : Stacks.ProjectiveFromSections.GeneratesStalks σ) :
    ∃ (s : Fin (N + 1) → powSections M D) (N₀ : ℕ), ∀ n : ℕ, N₀ ≤ n →
      ∀ u : 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M (D + n),
        ∃ a : Fin (N + 1) → (𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n),
          u = ∑ j, a j ≫ F ◁ mulMap (s j) n := by
  classical
  set g := Stacks.ProjectiveFromSections.toProjectiveSpaceOver σ hσ p
  obtain ⟨θ, -⟩ := exists_iso_projectiveSpaceTwistingSheaf_toProjectiveSpaceOver σ hσ p
  set O := Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf N
    (Spec (CommRingCat.of R))
  have hO : Stacks.Ample.IsAmple _ O :=
    Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf N (Spec (CommRingCat.of R))
  have : IsProper (Stacks.Tag01VT.projectiveSpaceHom N (Spec (CommRingCat.of R))) :=
    projectiveSpaceOver_isProper N (Spec (CommRingCat.of R))
  have : IsProper g := by
    have : IsProper (g ≫ Stacks.Tag01VT.projectiveSpaceHom N (Spec (CommRingCat.of R))) := by
      rw [Stacks.ProjectiveFromSections.toProjectiveSpaceOver_fst σ hσ p]; infer_instance
    exact IsProper.of_comp g (Stacks.Tag01VT.projectiveSpaceHom N (Spec (CommRingCat.of R)))
  obtain ⟨Ψ, hΨ⟩ := exists_epi_biproduct_of_generatesStalks (O := O) _
    (Stacks.ProjectiveSpaceModuli.taut_generates
      (projectiveSpaceOver.toIntegralAtUniverse N (Spec (CommRingCat.of R))))
  set ψ := (Scheme.Modules.pullback g).map Ψ ≫ θ.hom
  choose k₀ hk₀ using fun r => exists_surjective_whiskerLeft_twistPowMap_pullback p
    (Stacks.Tag01VT.projectiveSpaceHom N (Spec (CommRingCat.of R))) g O hO Ψ M F θ r
  set w := Stacks.PullbackUnitSection.unitPullbackIso g
  refine ⟨fun j => w.inv ≫ (Scheme.Modules.pullback g).map
      (biproduct.ι (fun _ : Fin (N + 1) => 𝟙_ _) j) ≫ ψ,
    D * (Finset.range D).sup k₀, fun n hn u => ?_⟩
  have hn' : n % D + D * (n / D) = n := Nat.mod_add_div n D
  have hk : k₀ (n % D) ≤ n / D := by
    refine le_trans (Finset.le_sup (Finset.mem_range.mpr (Nat.mod_lt n hD))) ?_
    exact (Nat.le_div_iff_mul_le hD).mpr (by rw [Nat.mul_comm]; exact hn)
  have hsurj := hk₀ (n % D) (n / D) hk
  rw [hn'] at hsurj
  exact exists_eq_sum_whiskerLeft_mulMap_of_surjective M F ψ
    (fun j => (Scheme.Modules.pullback g).map (biproduct.π (fun _ : Fin (N + 1) => 𝟙_ _) j) ≫
      w.hom) _ (sum_pullback_biproduct_comp g ψ) n hsurj u

end Scheme

/-! ### Generating sections of a power of `L` over `f⁻¹U` -/

section Generators

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

/-- Relative semiampleness of `L` over `S`: every point of `S` has an open neighbourhood `U` over
which some positive power `L^{⊗ d}` has its sections over `f⁻¹U` generating every stalk. -/
private abbrev IsRelSemiample {Y S : Scheme.{u}} (f : Y ⟶ S) (L : Y.Modules) : Prop :=
  ∀ s : S, ∃ U : S.Opens, s ∈ U ∧ ∃ d : ℕ, 0 < d ∧ ∀ y ∈ f ⁻¹ᵁ U,
    ∃ t : Γ(natTensorPow L d, f ⁻¹ᵁ U),
      y ∈ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) t

/-- The degree of the `k`-th iterated power, `d * (k + 1)`, with the recursion of the product. -/
private def powDeg (d : ℕ) : ℕ → ℕ
  | 0 => d
  | k + 1 => d + powDeg d k

private theorem powDeg_eq (d : ℕ) : ∀ k, powDeg d k = d * (k + 1)
  | 0 => by simp [powDeg]
  | k + 1 => by rw [powDeg, powDeg_eq d k]; ring

/-- The `(k + 1)`-st power of a section, by iterated multiplication. -/
private noncomputable def sectionPow {X : Scheme.{u}} (L : X.Modules) {d : ℕ}
    (t : powSections L d) : (k : ℕ) → powSections L (powDeg d k)
  | 0 => t
  | k + 1 => mul t (sectionPow L t k)

private theorem nonvanishingLocus_sectionPow {X : Scheme.{u}} (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] {d : ℕ} (t : powSections L d) :
    ∀ k, Stacks.Ample.nonvanishingLocus (natTensorPow L (powDeg d k))
        (Stacks.SectionProduct.globalSection X _ (sectionPow L t k)) =
      Stacks.Ample.nonvanishingLocus (natTensorPow L d)
        (Stacks.SectionProduct.globalSection X _ t)
  | 0 => rfl
  | k + 1 => by
    change Stacks.Ample.nonvanishingLocus (natTensorPow L (d + powDeg d k))
        (Stacks.SectionProduct.globalSection X _ (mul t (sectionPow L t k))) = _
    rw [Stacks.SectionProduct.nonvanishingLocus_mul,
      nonvanishingLocus_sectionPow L t k, Set.inter_self]

private theorem nonvanishingLocus_cast {X : Scheme.{u}} (L : X.Modules) {a b : ℕ} (h : a = b)
    (t : powSections L a) :
    Stacks.Ample.nonvanishingLocus (natTensorPow L b)
        (Stacks.SectionProduct.globalSection X _ (h ▸ t)) =
      Stacks.Ample.nonvanishingLocus (natTensorPow L a)
        (Stacks.SectionProduct.globalSection X _ t) := by
  subst h; rfl

/-- On a quasi-compact scheme, if every point lies in the nonvanishing locus of a section of some
positive tensor power of `L`, then finitely many sections of one positive power do. -/
private theorem exists_common_degree {X : Scheme.{u}} [CompactSpace X] (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L]
    (h : ∀ x : X, ∃ d : ℕ, 0 < d ∧ ∃ t : powSections L d,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow L d)
        (Stacks.SectionProduct.globalSection X _ t)) :
    ∃ D : ℕ, 0 < D ∧ ∃ (n : ℕ) (s : Fin n → powSections L D), ∀ x : X, ∃ i,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow L D)
        (Stacks.SectionProduct.globalSection X _ (s i)) := by
  classical
  choose d hd t ht using h
  obtain ⟨F, hF⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X => Stacks.Ample.nonvanishingLocus (natTensorPow L (d x))
      (Stacks.SectionProduct.globalSection X _ (t x)))
    (fun x => Stacks.NonvanishingOpen.isOpen_nonvanishingLocus X _ _)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, ht x⟩)
  set D := ∏ x ∈ F, d x
  have hDpos : 0 < D := Finset.prod_pos fun x _ => hd x
  have hdvd : ∀ x ∈ F, d x ∣ D := fun x hx => Finset.dvd_prod_of_mem _ hx
  have hk : ∀ x ∈ F, powDeg (d x) (D / d x - 1) = D := fun x hx => by
    rw [powDeg_eq, Nat.sub_add_cancel (Nat.div_pos (Nat.le_of_dvd hDpos (hdvd x hx)) (hd x)),
      Nat.mul_div_cancel' (hdvd x hx)]
  refine ⟨D, hDpos, F.card, fun i => ?_, fun y => ?_⟩
  · let x := (F.equivFin.symm i : X)
    exact hk x (F.equivFin.symm i).2 ▸ sectionPow L (t x) (D / d x - 1)
  · obtain ⟨x, hxF, hyx⟩ := Set.mem_iUnion₂.mp (hF (Set.mem_univ y))
    refine ⟨F.equivFin ⟨x, hxF⟩, ?_⟩
    rw [nonvanishingLocus_cast, nonvanishingLocus_sectionPow]
    generalize hz : F.equivFin.symm (F.equivFin ⟨x, hxF⟩) = z
    rw [Equiv.symm_apply_apply] at hz
    subst hz
    exact hyx

open Stacks.NonvanishingLocusRestrict in
/-- Near a point `y` of `f⁻¹U`, a section of some positive power of `L` over the neighbourhood
given by `hL` becomes, after multiplication by a power of a function `a` on `U` with
`f y ∈ D(a)`, the restriction of a section over all of `f⁻¹U`, still nonvanishing at `y`. -/
private theorem exists_section_over_preimage {Y S : Scheme.{u}} (f : Y ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U) (y : Y)
    (hy : y ∈ f ⁻¹ᵁ U) :
    ∃ d : ℕ, 0 < d ∧ ∃ e : Γ(natTensorPow L d, f ⁻¹ᵁ U),
      y ∈ nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) e := by
  obtain ⟨V, hyV, d, hd, hV⟩ := hL (f.base y)
  obtain ⟨t, ht⟩ := hV y hyV
  obtain ⟨a, haV, hya⟩ := hU.exists_basicOpen_le (V := V) ⟨f.base y, hyV⟩ hy
  set g : Γ(Y, f ⁻¹ᵁ U) := f.app U a
  have hbo : Y.basicOpen g = f ⁻¹ᵁ S.basicOpen a := (Scheme.preimage_basicOpen f a).symm
  have hWV : Y.basicOpen g ≤ f ⁻¹ᵁ V := fun z hz => haV (by rw [hbo] at hz; exact hz)
  have hyg : y ∈ Y.basicOpen g := by rw [hbo]; exact hya
  have hc : IsCompact ((f ⁻¹ᵁ U : Y.Opens) : Set Y) :=
    QuasiCompact.isCompact_preimage (f := f) _ U.2 hU.isCompact
  have hqs : IsQuasiSeparated ((f ⁻¹ᵁ U : Y.Opens) : Set Y) :=
    f.isQuasiSeparated_preimage hU.isQuasiSeparated
  obtain ⟨k, e, he⟩ :=
    Stacks.AlgebraicGeometry.QcqsLocalization.exists_eq_pow_smul_of_isCompact_of_isQuasiSeparated
      (natTensorPow L d) hc hqs g ((natTensorPow L d).presheaf.map (homOfLE hWV).op t)
  refine ⟨d, hd, e, (mem_nonvanishingLocusOn_iff _ _ hy).mpr ?_⟩
  rw [← TopCat.Presheaf.germ_res_apply (C := Ab.{u}) (natTensorPow L d).presheaf
    (homOfLE (Y.basicOpen_le g)) y hyg, he, Stacks.ModuleStalk.germ_smul,
    Stacks.ModuleStalk.smul_mem_maximalSmul_iff, not_or, not_not,
    TopCat.Presheaf.germ_res_apply (C := Ab.{u})]
  refine ⟨?_, ht.2⟩
  rw [map_pow]
  exact (IsUnit.map (Y.presheaf.germ (Y.basicOpen g) y hyg).hom
    (Y.toRingedSpace.isUnit_res_basicOpen g)).pow k

/-- Every point of `f⁻¹U` lies in the nonvanishing locus of a global section of some positive
power of the restriction of `L` to `f⁻¹U`. -/
private theorem exists_powSections_restrict_at {Y S : Scheme.{u}} (f : Y ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)]
    (x : (f ⁻¹ᵁ U).toScheme) :
    ∃ d : ℕ, 0 < d ∧ ∃ t : powSections (L.restrict (f ⁻¹ᵁ U).ι) d,
      x ∈ Stacks.Ample.nonvanishingLocus (natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) d)
        (Stacks.SectionProduct.globalSection _ _ t) := by
  obtain ⟨d, hd, e, he⟩ := exists_section_over_preimage f L hL U hU ((f ⁻¹ᵁ U).ι.base x) x.2
  let eIso : (Scheme.Modules.pullback (f ⁻¹ᵁ U).ι).obj L ≅ L.restrict (f ⁻¹ᵁ U).ι :=
    ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ U).ι).app L).symm
  let σ' := Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul.restrictPowSection L
    (f ⁻¹ᵁ U) d e
  let σ := (Stacks.AmplePullbackPart1.natTensorPowCongr eIso d).hom.app ⊤ σ'
  refine ⟨d, hd, (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _).symm σ, ?_⟩
  change x ∈ Stacks.Ample.nonvanishingLocus _
    (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _
      ((Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv _ _).symm σ))
  rw [AddEquiv.apply_symm_apply, Stacks.Ample.nonvanishingLocus_congr]
  exact (iff_of_eq (congrArg (x ∈ ·)
    (Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul.nonvanishingOpen_restrictPowSection
      L (f ⁻¹ᵁ U) d e))).mpr he

/-- Some positive power `L^{⊗ D}` of the restriction of `L`
to `f⁻¹U` has `N + 1` global sections generating every stalk, the datum
`Stacks.ProjectiveFromSections.toProjectiveSpaceOver` takes. -/
private theorem exists_generatesStalks_restrict {Y S : Scheme.{u}} (f : Y ⟶ S)
    [QuasiCompact f] [QuasiSeparated f] (L : Y.Modules) [Stacks.Ample.IsInvertibleModule Y L]
    (hL : IsRelSemiample f L) (U : S.Opens) (hU : IsAffineOpen U)
    [Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι)] :
    ∃ D : ℕ, 0 < D ∧ ∃ (N : ℕ) (s : Fin (N + 1) → Γ(natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) D, ⊤)),
      Stacks.ProjectiveFromSections.GeneratesStalks s := by
  haveI : CompactSpace (f ⁻¹ᵁ U).toScheme :=
    isCompact_iff_compactSpace.mp (QuasiCompact.isCompact_preimage (f := f) _ U.2 hU.isCompact)
  obtain ⟨D, hD, n, s, hs⟩ := exists_common_degree _ (exists_powSections_restrict_at f L hL U hU)
  refine ⟨D, hD, n, Fin.lastCases 0 (fun i => Stacks.SectionProduct.globalSection _ _ (s i)),
    fun x w => ?_⟩
  obtain ⟨i, hi⟩ := hs x
  obtain ⟨r, hr⟩ :=
    (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates _ _ x).mp hi w
  refine ⟨{i.castSucc}, fun _ => r, ?_⟩
  simp only [Finset.sum_singleton, Fin.lastCases_castSucc]
  exact hr

end Generators

/-! ### The section module -/

section SectionModule

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (F M : X.Modules)

/-- Reindexing a homogeneous element of `⨁ₙ Γ(F ⊗ M^{⊗ n})` along an equality of degrees. -/
private theorem of_comp_whiskerLeft_eqToHom {i j : ℕ} (h : i = j)
    (z : 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M i) :
    DirectSum.of (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) j
      (z ≫ F ◁ eqToHom (congrArg (natTensorPow M) h)) =
    DirectSum.of (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) i z := by
  subst h
  simp

/-- Multiplication by a section `s` of `M^{⊗ b}`, as an additive endomorphism of
`⨁ₙ Γ(F ⊗ M^{⊗ n})` raising degrees by `b`. -/
private noncomputable def mulSectionModule {b : ℕ} (s : powSections M b) :
    (DirectSum ℕ fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) →+
      DirectSum ℕ fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n :=
  DirectSum.toAddMonoid fun n =>
    (DirectSum.of (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) (b + n)).comp
      (Preadditive.rightComp _ (F ◁ mulMap s n))

private theorem mulSectionModule_of {b : ℕ} (s : powSections M b) (n : ℕ)
    (y : 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) :
    mulSectionModule F M s (DirectSum.of _ n y) =
      DirectSum.of (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) (b + n)
        (y ≫ F ◁ mulMap s n) :=
  DirectSum.toAddMonoid_of _ _ _

/-- The additive submonoid generated by the products `s · g`, `g ∈ G`, is stable under
multiplication by every homogeneous section of a power of `M`. -/
private theorem mulSectionModule_mem_closure
    (G : Finset (Σ n : ℕ, 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n)) {b : ℕ} (s : powSections M b)
    {x : DirectSum ℕ fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n}
    (hx : x ∈ AddSubmonoid.closure {x | ∃ g ∈ G, ∃ (a : ℕ) (s : powSections M a),
        x = DirectSum.of (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n)
          (a + g.1) (g.2 ≫ F ◁ mulMap s g.1)}) :
    mulSectionModule F M s x ∈ AddSubmonoid.closure {x | ∃ g ∈ G, ∃ (a : ℕ)
        (s : powSections M a), x = DirectSum.of
          (fun n : ℕ => 𝟙_ X.Modules ⟶ F ⊗ natTensorPow M n) (a + g.1)
          (g.2 ≫ F ◁ mulMap s g.1)} := by
  induction hx using AddSubmonoid.closure_induction with
  | mem x hx =>
    obtain ⟨g, hg, a, t, rfl⟩ := hx
    refine AddSubmonoid.subset_closure ⟨g, hg, b + a, mul s t, ?_⟩
    rw [mulSectionModule_of, Category.assoc, ← MonoidalCategory.whiskerLeft_comp,
      mulMap_comp_mulMap, MonoidalCategory.whiskerLeft_comp, ← Category.assoc,
      of_comp_whiskerLeft_eqToHom F M (Nat.add_assoc b a g.1)]
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy

end SectionModule

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory

/-- **Finite generation of the section module of a relatively semiample invertible module.**
For a projective `f : Y ⟶ S` over a locally Noetherian `S`, an invertible `L` some positive power
of which is generated by relative sections locally over `S`, and a coherent `F`, over every affine
open `U ⊆ S` the module `⨁_{n ≥ 0} Γ(f⁻¹U, F ⊗ L^{⊗ n})` over the section ring
`⨁_{n ≥ 0} Γ(f⁻¹U, L^{⊗ n})` is generated by finitely many homogeneous elements: there is a
finite set `G` of homogeneous elements such that the sums of the products `s • g`, `g ∈ G`, `s` a
homogeneous section of a power of `L`, exhaust the direct sum. -/
public theorem fg_sectionModule_restrict_of_isProjective {Y S : Scheme.{u}} (f : Y ⟶ S)
    (hf : IsProjective f) [IsLocallyNoetherian S] (L : Y.Modules)
    [Stacks.Ample.IsInvertibleModule Y L]
    (hL : ∀ s : S, ∃ U : S.Opens, s ∈ U ∧ ∃ d : ℕ, 0 < d ∧ ∀ y ∈ f ⁻¹ᵁ U,
      ∃ t : Γ(natTensorPow L d, f ⁻¹ᵁ U),
        y ∈ Stacks.NonvanishingLocusRestrict.nonvanishingLocusOn (natTensorPow L d) (f ⁻¹ᵁ U) t)
    (F : Y.Modules) [F.IsCoherent] (U : S.Opens) (hU : IsAffineOpen U) :
    ∃ G : Finset (Σ n : ℕ,
        𝟙_ _ ⟶ F.restrict (f ⁻¹ᵁ U).ι ⊗ natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) n),
      AddSubmonoid.closure {x | ∃ g ∈ G, ∃ (a : ℕ) (s : powSections (L.restrict (f ⁻¹ᵁ U).ι) a),
        x = DirectSum.of
          (fun n : ℕ => 𝟙_ _ ⟶ F.restrict (f ⁻¹ᵁ U).ι ⊗ natTensorPow (L.restrict (f ⁻¹ᵁ U).ι) n)
          (a + g.1) (g.2 ≫ (F.restrict (f ⁻¹ᵁ U).ι ◁ mulMap s g.1))} = ⊤ := by
  classical
  letI := Stacks.SectionRingGeometric.schemeBraidedCategory
  letI := Stacks.SectionRingGeometric.schemePreadditive
  haveI : Stacks.Ample.IsInvertibleModule (f ⁻¹ᵁ U).toScheme (L.restrict (f ⁻¹ᵁ U).ι) :=
    letI := Stacks.InvertiblePullback.isInvertibleModule_restrict (f ⁻¹ᵁ U) L
    Stacks.AlgebraicGeometry.ProjAmpleTwist.isInvertibleModule_of_iso
      ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ U).ι).app L ≪≫
        (Stacks.ProjectiveBundleQuotients.pullbackIso (f ⁻¹ᵁ U).ι).app L).symm
  haveI : IsProper f := hf.isProper
  haveI : IsNoetherianRing Γ(S, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : IsLocallyNoetherian (Spec Γ(S, U)) := isLocallyNoetherian_Spec.mpr inferInstance
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : IsLocallyNoetherian (f ⁻¹ᵁ U).toScheme :=
    LocallyOfFiniteType.isLocallyNoetherian ((f ∣_ U) ≫ hU.isoSpec.hom)
  set M := L.restrict (f ⁻¹ᵁ U).ι
  set F' := F.restrict (f ⁻¹ᵁ U).ι
  haveI := isCoherent_pullback (f ⁻¹ᵁ U).ι F
  haveI : F'.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentDevissage.isCoherent_of_iso
      ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ U).ι).app F)
  obtain ⟨D, hD, N, σ, hσ⟩ := exists_generatesStalks_restrict f L hL U hU
  obtain ⟨s, N₀, hs⟩ := exists_forall_eq_sum_whiskerLeft_mulMap (R := Γ(S, U))
    ((f ∣_ U) ≫ hU.isoSpec.hom) M F' hD σ hσ
  have hfin : ∀ q : ℕ, ∃ t : Finset (𝟙_ _ ⟶ F' ⊗ natTensorPow M q),
      Submodule.span Γ((f ⁻¹ᵁ U).toScheme, ⊤) (t : Set (𝟙_ _ ⟶ F' ⊗ natTensorPow M q)) = ⊤ :=
    fun q =>
      haveI := Stacks.AlgebraicGeometry.ProperAmpleCohomology.isCoherent_tensorObj F'
        (natTensorPow M q) inferInstance
      Stacks.SectionRingZero.exists_finset_span_eq_top ((f ∣_ U) ≫ hU.isoSpec.hom) _
  choose t ht using hfin
  refine ⟨(Finset.range (D + N₀)).sigma t, ?_⟩
  rw [eq_top_iff]
  rintro z -
  induction z using DirectSum.induction_on with
  | zero => exact zero_mem _
  | add x y hx hy => exact add_mem hx hy
  | of q u =>
    induction q using Nat.strong_induction_on with
    | _ q ih =>
      rcases lt_or_ge q (D + N₀) with hq | hq
      · obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp
          (show u ∈ Submodule.span _ (t q : Set _) by rw [ht q]; trivial)
        rw [← hc, map_sum]
        refine sum_mem fun y hy => AddSubmonoid.subset_closure
          ⟨⟨q, y⟩, Finset.mem_sigma.mpr ⟨Finset.mem_range.mpr hq, hy⟩, 0,
            (Stacks.SectionRingGeometric.unitScalarAddEquiv _).symm (c y), ?_⟩
        dsimp only
        rw [comp_whiskerLeft_mulMap_zero, of_comp_whiskerLeft_eqToHom F' M (Nat.zero_add q).symm,
          Stacks.SectionRingZero.unitHom_smul_def]
      · obtain ⟨n, rfl⟩ := Nat.le.dest (Nat.le_trans (Nat.le_add_right D N₀) hq)
        obtain ⟨a, ha⟩ := hs n (by omega) u
        rw [ha, map_sum]
        refine sum_mem fun j _ => ?_
        rw [← mulSectionModule_of]
        exact mulSectionModule_mem_closure F' M _ (s j) (ih n (by omega) (a j))

end MMP

/-! ## Valuations of zero reduced snc discrepancy -/

namespace MMP.Fourfold

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

open MMP.Mori
open scoped WithZero

section Helpers

variable {W : Scheme.{u}}

/-- `E ∈ J(S)` for the closure `S` of a point `x` iff `x` lies on `E`. -/
private theorem mem_sncIndexSet_closure_iff (T : Divisor W) (x : W) (E : MMP.Mori.PrimeDivisor W) :
    E ∈ sncIndexSet T (closure {x}) ↔ E ∈ T.support ∧ x ∈ E.support := by
  classical
  unfold sncIndexSet
  rw [Finset.mem_filter]
  refine and_congr Iff.rfl ⟨fun h => h (subset_closure rfl), fun h => closure_minimal
    (Set.singleton_subset_iff.2 h) ?_⟩
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
  exact isClosed_closure

/-- On `sncComplement T S`, a reduced effective divisor `T` restricts to the sum of its
components containing `S`. -/
private theorem restrictOpen_reducedDivisorOf_sncIndexSet {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)).restrictOpen (sncComplement T S) =
      T.restrictOpen (sncComplement T S) := by
  classical
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap (sncComplement T S).ι F
  have hPU : P.genericPoint ∈ sncComplement T S := by
    rw [OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  change (MMP.Intersection.reducedDivisorOf _).coeff P = T.coeff P
  rw [MMP.Intersection.coeff_reducedDivisorOf]
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, by_contra fun hZP => hPU ?_⟩
      refine Set.mem_biUnion (Finset.mem_filter.2 ⟨hPT, hZP⟩) ?_
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact subset_closure rfl
    rw [if_pos hPJ]
    exact ((hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)).symm
  · rw [if_neg (fun h : P ∈ sncIndexSet T S => hPT (Finset.mem_filter.1 h).1)]
    exact (Finsupp.notMem_support_iff.1 hPT).symm

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
theorem toRDivisor_restrictOpen_sncComplement [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen,
    restrictOpen_reducedDivisorOf_sncIndexSet hT]
  refine Finsupp.ext fun F => ?_
  change (((T _ : ℤ) : ℚ) : ℝ) = ((T _ : ℤ) : ℝ)
  push_cast; rfl

/-- A nonempty open subscheme of an integral scheme has the same function field. -/
private theorem functionFieldMap_opens_ι_bijective [IsIntegral W] (V : W.Opens)
    [Nonempty V] [IsDominant V.ι] : Function.Bijective (functionFieldMap V.ι) :=
  functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤ ⟨Classical.arbitrary V, trivial⟩

/-- At a point `x` of a scheme carrying an snc divisor `T`, at most `codim x` components of `T`
pass through `x`. -/
private theorem card_sncIndexSet_closure_le {k : Type u} [Field k] {sW : W ⟶ Spec (.of k)}
    {T : Divisor W} (hTs : T.IsSNC sW) (x : W) :
    ((sncIndexSet T (closure {x})).card : ℕ∞) ≤ Order.coheight x := by
  obtain ⟨N, w, jj, hw, hjj, -⟩ := hTs.2 x
  have hN : (N : ℕ∞) = Order.coheight x := by
    have := hw.2.symm.trans (ringKrullDim_stalk_eq_coheight x)
    exact_mod_cast this
  rw [← hN]
  let f : sncIndexSet T (closure {x}) → Fin N := fun E =>
    jj ⟨E.1, (mem_sncIndexSet_closure_iff T x E.1).1 E.2⟩
  have hf : Function.Injective f := fun a b hab =>
    Subtype.ext (by have := congrArg Subtype.val (hjj hab); exact this)
  have := Fintype.card_le_of_injective f hf
  rw [Fintype.card_coe, Fintype.card_fin] at this
  exact_mod_cast this

/-- **The centre of zero error is a stratum.** Let `T` be an snc divisor and `Z` an irreducible
closed subset of codimension `c ≤ |J(Z)|`. Then `c = |J(Z)|` and `Z` is an irreducible component of
`⋂_{j ∈ J(Z)} Tⱼ`. -/
private theorem maximal_of_codimension_le_card {k : Type u} [Field k] {sW : W ⟶ Spec (.of k)}
    {T : Divisor W} (hTs : T.IsSNC sW) (Z : IrreducibleCloseds W) {c : ℕ}
    (hc : codimension Z = c) (hle : c ≤ (sncIndexSet T (Z : Set W)).card) :
    Maximal (fun S : Set W => IsIrreducible S ∧ S ⊆ ⋂ E ∈ sncIndexSet T (Z : Set W), E.support)
      (Z : Set W) ∧ (sncIndexSet T (Z : Set W)).card = c := by
  classical
  set J := sncIndexSet T (Z : Set W)
  set η := Z.isIrreducible.genericPoint
  have hZcl : (Z : Set W) = closure {η} := by
    have := Z.isIrreducible.isGenericPoint_genericPoint_closure
    rw [Z.isClosed.closure_eq] at this
    exact this.symm
  have hcη : Order.coheight η = c := by
    rw [← MMP.Flips.codimension_eq_coheight_genericPoint, hc]
  -- every component in `J` through a point `s` gives `|J| ≤ codim s`
  have hJle : ∀ s : W, (∀ E ∈ J, s ∈ E.support) → (J.card : ℕ∞) ≤ Order.coheight s := by
    intro s hs
    refine le_trans ?_ (card_sncIndexSet_closure_le hTs s)
    exact_mod_cast Finset.card_le_card fun E hE =>
      (mem_sncIndexSet_closure_iff T s E).2 ⟨(Finset.mem_filter.1 hE).1, hs E hE⟩
  have hηZ : η ∈ (Z : Set W) := by rw [hZcl]; exact subset_closure rfl
  have hJZ : ∀ E ∈ J, (Z : Set W) ⊆ E.support := fun E hE => (Finset.mem_filter.1 hE).2
  have hcard : J.card = c := by
    refine le_antisymm ?_ hle
    have := hJle η fun E hE => hJZ E hE hηZ
    rw [hcη] at this
    exact_mod_cast this
  refine ⟨⟨⟨Z.isIrreducible, Set.subset_iInter₂ fun E hE => hJZ E hE⟩, ?_⟩, hcard⟩
  rintro S ⟨hSi, hSJ⟩ hZS
  have hSc := hSi.closure
  set s := hSc.genericPoint
  have hscl : closure S = closure {s} := by
    have := hSc.isGenericPoint_genericPoint_closure
    rw [isClosed_closure.closure_eq] at this
    exact this.symm
  have hsS : s ∈ closure S := by rw [hscl]; exact subset_closure rfl
  have hsJ : ∀ E ∈ J, s ∈ E.support := by
    intro E hE
    have hcl : IsClosed (E.support : Set W) := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]; exact isClosed_closure
    exact closure_minimal (fun y hy => Set.mem_iInter₂.1 (hSJ hy) E hE) hcl hsS
  have hsη : s ⤳ η := by
    rw [specializes_iff_mem_closure, ← hscl]
    exact subset_closure (hZS hηZ)
  have hseq : s = η := by
    by_contra hne
    have hlt : η < s := lt_of_le_not_ge (show η ≤ s from hsη) fun h => hne (hsη.antisymm h).eq
    have h1 := Order.coheight_strictAnti hlt
      ((Order.coheight_anti hlt.le).trans_lt (by rw [hcη]; exact ENat.coe_lt_top c))
    have h2 := hJle s hsJ
    rw [hcard, ← hcη] at h2
    exact absurd h1 (not_lt.2 h2)
  intro y hy
  rw [hZcl, ← hseq, ← hscl]
  exact subset_closure hy

/-- The centre of a divisor over an integral scheme `X` has codimension at least one: a
valuation of `k(X)` taking the value `exp (-1)` is not centred at the generic point. -/
private theorem one_le_coheight_map_genericPoint {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] (D : DivisorOver k sX) :
    1 ≤ Order.coheight (D.f D.E.genericPoint) := by
  by_contra hlt
  have h0 : Order.coheight (D.f D.E.genericPoint) = 0 := ENat.lt_one_iff_eq_zero.1 (not_le.1 hlt)
  have hsp : genericPoint X ⤳ D.f D.E.genericPoint := (genericPoint_spec X).specializes trivial
  have hx : D.f D.E.genericPoint = genericPoint X :=
    ((show D.f D.E.genericPoint ⤳ genericPoint X from (Order.coheight_eq_zero.1 h0) hsp).antisymm
      hsp).eq
  obtain ⟨g, hg⟩ := MMP.Positivity.DivisorOver.exists_valuation_eq_exp_neg_one D
  obtain ⟨a, ha⟩ :=
    MMP.Positivity.DivisorOver.algebraMap_stalk_surjective_of_eq_genericPoint _ hx g⁻¹
  have hle := MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D _ rfl a
  rw [ha, map_inv₀, hg, ← WithZero.exp_neg, neg_neg] at hle
  exact absurd hle (by decide)

/-- The coheight of a point of a locally Noetherian scheme is finite. -/
private theorem coheight_ne_top {X : Scheme.{u}} [IsLocallyNoetherian X] (x : X) :
    Order.coheight x ≠ ⊤ := by
  intro htop
  have h1 := ringKrullDim_le_spanFinrank_maximalIdeal (X.presheaf.stalk x)
  rw [ringKrullDim_stalk_eq_coheight, htop] at h1
  have h2 : (⊤ : ℕ∞) ≤ ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).spanFinrank : ℕ∞) := by
    exact_mod_cast h1
  exact ENat.coe_ne_top _ (top_le_iff.1 h2)

/-- A normalized divisorial valuation of a normal variety whose centre lies on a prime divisor
`E` and has codimension at most one is `ord_E`. -/
private theorem eq_divisorialValuation_of_isCentre {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hX : IsNormalVariety k sX) {v : Valuation X.functionField ℤᵐ⁰} {C : IrreducibleCloseds X}
    (hC : MMP.Intersection.IsCentre k sX v C) {E : MMP.Mori.PrimeDivisor X}
    (hCE : (C : Set X) ⊆ E.support) (hcod : codimension C ≤ 1) :
    v = E.divisorialValuation := by
  obtain ⟨D, -, rfl, rfl⟩ := hC
  rw [MMP.Positivity.DivisorOver.codimension_center] at hcod
  set x := D.f D.E.genericPoint
  have hxE : x ∈ (E.support : Set X) := hCE (by
    rw [D.center_eq_closure_genericPoint]; exact subset_closure rfl)
  have hEx : E.genericPoint ⤳ x := by
    rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hxE
  have hx : x = E.genericPoint := by
    by_contra hne
    have hlt : x < E.genericPoint :=
      lt_of_le_not_ge (show x ≤ E.genericPoint from hEx) fun h =>
        hne ((show x ⤳ E.genericPoint from h).antisymm hEx).eq
    have h1 := Order.coheight_strictAnti hlt
      (by rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint]; exact ENat.one_lt_top)
    rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint] at h1
    exact lt_irrefl _ (hcod.trans_lt h1)
  rw [MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX D E hx]
  ext g
  change E.divisorialValuation (functionFieldMap (𝟙 X) g) = _
  rw [MMP.Mori.functionFieldMap_id_apply]

/-- A dominant morphism `f : Y ⟶ X` of varieties inducing an isomorphism of function fields
preserves dimension: both dimensions are the transcendence degree of the common function
field. -/
private theorem topologicalKrullDim_eq_of_functionFieldMap_bijective {k : Type u} [Field k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y] {sX : X ⟶ Spec (.of k)}
    [LocallyOfFiniteType sX] (f : Y ⟶ X) [IsDominant f] [LocallyOfFiniteType (f ≫ sX)]
    (hbij : Function.Bijective (functionFieldMap f)) :
    topologicalKrullDim Y = topologicalKrullDim X := by
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (f ≫ sX)
  rw [← toENat_trdeg_functionField (sX := f ≫ sX),
    ← trdeg_functionField_eq_of_bijective sX f hbij, toENat_trdeg_functionField (sX := sX)]

/-- On a smooth variety the discrepancy does not depend on the chosen canonical divisor. -/
private theorem isDiscrepancy_of_isCanonicalDivisor {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hsm : IsSmoothScheme sX) {n : ℕ} {K K' : Divisor X} {B : Divisor X}
    {D : DivisorOver k sX} {a : ℚ} (ha : IsDiscrepancy sX n K (Divisor.toQDivisor B) D a)
    (hK' : K'.IsCanonicalDivisor sX n) :
    IsDiscrepancy sX n K' (Divisor.toQDivisor B) D a := by
  obtain ⟨hX, -, m, hm, -, V, hV, τ, hτ, hτa⟩ := ha
  refine ⟨hX, hK', m, hm, ?_, V, hV, τ, hτ, hτa⟩
  rw [← map_add, ← map_zsmul, QDivisor.isCartierDivisor_toQDivisor]
  exact MMP.Fourfold.isCartier_of_isSmoothScheme hsm _

/-- The generic point of the centre of a divisor over `X` lies in `W° = sncComplement T Z` for
the centre `Z`. -/
theorem map_genericPoint_mem_sncComplement {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] (T : Divisor X) (D : DivisorOver k sX) :
    D.f D.E.genericPoint ∈ sncComplement T (D.center : Set X) :=
  SNCWeight.mem_sncComplement_iff.2 fun E _ hE hmem => hE (by
    rw [D.center_eq_closure_genericPoint]
    refine closure_minimal (Set.singleton_subset_iff.2 hmem) ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    exact isClosed_closure)

/-- **Zero reduced snc discrepancy is discrepancy `-1`.** If `e_T(ξ) = 0`, then every proper
divisor `D` over `W` with valuation `ξ` has discrepancy `a(D, W, T) = -1`. -/
private theorem isDiscrepancy_neg_one_of_isReducedSNCDiscrepancy {k : Type u} [Field k]
    [PerfectField k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {T : Divisor X} {ξ : Valuation X.functionField ℤᵐ⁰}
    (h : IsReducedSNCDiscrepancy sX T ξ 0) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (D : DivisorOver k sX) (hDp : IsProper D.f)
    (hξD : ξ = D.valuation) :
    IsDiscrepancy sX n K (Divisor.toQDivisor T) D (-1) := by
  classical
  obtain ⟨hXv, hsm, hT, -, Z₀, hZ₀, hne, n₀, D₀, -, hξD₀, hla⟩ := h
  have hX : IsNormalVariety k sX := ⟨hXv, inferInstance⟩
  haveI : CompactSpace X := (hXv.toQuasiCompact).compactSpace_of_compactSpace
  obtain rfl : Z₀ = D.center := by
    obtain ⟨D₁, -, hξ1, rfl⟩ := hZ₀
    exact MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hXv (hξ1.symm.trans hξD)
  set U := sncComplement T (D.center : Set X)
  haveI : Nonempty U := hne
  haveI : IsDominant U.ι := isDominant_ι_of_nonempty U
  have hηmem : D.f D.E.genericPoint ∈ (D.center : Set X) := by
    rw [D.center_eq_closure_genericPoint]; exact subset_closure rfl
  have hPXT : IsPairWith sX n K (Divisor.toQDivisor T) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPXT.isPair hK D
  obtain ⟨_hYU, _hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPXT D
      U ⟨_, hηmem, map_genericPoint_mem_sncComplement T D⟩
  have hpU : IsProper (D.f ∣_ U) := by
    haveI : IsProper D.f := hDp
    infer_instance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy ((hiff c).1 hc) hpU
  rw [toRDivisor_restrictOpen_sncComplement hT] at hLU
  have hbij := functionFieldMap_opens_ι_bijective U
  have hee : (0 : ℝ) = 1 + (c : ℝ) := by
    refine MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq hla hLU ?_
    ext x
    obtain ⟨y, rfl⟩ := hbij.2 x
    have h1 := congrArg (fun v => v y) hξD₀
    have h2 := congrArg (fun v => v y) (hξD.trans hvU)
    simp only [Valuation.comap_apply] at h1 h2
    exact h1.symm.trans h2
  have hc1 : c = -1 := by exact_mod_cast (by linarith : (c : ℝ) = -1)
  rwa [hc1] at hc

/-- **Discrepancy `-1` is zero reduced snc discrepancy.** On a smooth variety with a reduced snc
divisor `T`, a proper divisor `D` with discrepancy `a(D, X, T) = -1` has `e_T(ord_D) = 0`. -/
theorem isReducedSNCDiscrepancy_zero_of_isDiscrepancy {k : Type u} [Field k]
    [PerfectField k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {T : Divisor X} (hT : MMP.Intersection.IsReducedEffective T) (hsnc : T.IsSNC sX) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) (D : DivisorOver k sX)
    (hDp : IsProper D.f) (hD : IsDiscrepancy sX n K (Divisor.toQDivisor T) D (-1)) :
    IsReducedSNCDiscrepancy sX T D.valuation 0 := by
  classical
  haveI : CompactSpace X := (hX.1.toQuasiCompact).compactSpace_of_compactSpace
  set U := sncComplement T (D.center : Set X)
  have hηU := map_genericPoint_mem_sncComplement T D
  haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
  have hηmem : D.f D.E.genericPoint ∈ (D.center : Set X) := by
    rw [D.center_eq_closure_genericPoint]; exact subset_closure rfl
  have hPXT : IsPairWith sX n K (Divisor.toQDivisor T) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPXT D U ⟨_, hηmem, hηU⟩
  have hpU : IsProper (D.f ∣_ U) := by
    haveI : IsProper D.f := hDp
    infer_instance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy ((hiff _).1 hD) hpU
  rw [toRDivisor_restrictOpen_sncComplement hT] at hLU
  refine ⟨hX.1, hsm, hT, hsnc, D.center, ⟨D, hDp, rfl, rfl⟩, inferInstance, n,
    ⟨_, D.f ∣_ U, hYU, hfU, E'⟩, hpU, hvU, ?_⟩
  convert hLU using 1
  norm_num

/-- A vector of positive integers is a positive multiple of a primitive one. -/
private theorem exists_eq_mul_primitive {ι : Type*} [Fintype ι] [Nonempty ι] {α : ι → ℕ}
    (hα : ∀ j, 0 < α j) : ∃ (d : ℕ) (α' : ι → ℕ), 0 < d ∧ (∀ j, α j = d * α' j) ∧
      (∀ j, 0 < α' j) ∧ ∀ e : ℕ, (∀ j, e ∣ α' j) → e = 1 := by
  obtain ⟨α', hα', h1⟩ := Finset.extract_gcd α Finset.univ_nonempty
  have hα' : ∀ j, α j = Finset.univ.gcd α * α' j := fun j => hα' j (Finset.mem_univ j)
  obtain ⟨j₀⟩ := ‹Nonempty ι›
  refine ⟨_, α', Nat.pos_of_mul_pos_right (hα' j₀ ▸ hα j₀), hα', fun j => Nat.pos_of_mul_pos_left
    (hα' j ▸ hα j), fun e he => Nat.dvd_one.1 (h1 ▸ Finset.dvd_gcd fun j _ => he j)⟩

/-- **Zero reduced snc discrepancy survives a log crepant modification.** If `e_T(ξ) = 0` on a
smooth `W`, `U ⊆ W` is an open set meeting the centre of `ξ`, and `g : W' ⟶ U` is a birational
morphism from a smooth variety with a reduced snc divisor `T'` such that
`K_{W'} + T' = g^*(K_U + T|_U)`, then `e_{T'}(ξ') = 0` for the valuation `ξ'` of `k(W')`
inducing `ξ`. Both vanishings say that the discrepancy of `ξ` is `-1`, which the crepant
pull-back preserves. -/
private theorem isReducedSNCDiscrepancy_zero_of_isCrepantBoundary {k : Type u} [Field k]
    [PerfectField k] {W : Scheme.{u}} {sW : W ⟶ Spec (.of k)} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W} {ξ : Valuation W.functionField ℤᵐ⁰}
    (h : IsReducedSNCDiscrepancy sW T ξ 0) {Z : IrreducibleCloseds W}
    (hZ : MMP.Intersection.IsCentre k sW ξ Z) (U : W.Opens) [Nonempty U]
    (hZU : ((Z : Set W) ∩ U).Nonempty) {W' : Scheme.{u}} [IsIntegral W']
    [IsLocallyNoetherian W'] [IsNormal W'] {g : W' ⟶ U} (hg : IsBirationalMorphism g)
    [IsDominant (g ≫ U.ι)] (hW' : IsNormalVariety k (g ≫ U.ι ≫ sW)) {T' : Divisor W'}
    (hsm' : IsSmoothScheme (g ≫ U.ι ≫ sW)) (hT' : MMP.Intersection.IsReducedEffective T')
    (hsnc' : T'.IsSNC (g ≫ U.ι ≫ sW)) {nU : ℕ} {K : Divisor U}
    (hK : K.IsCanonicalDivisor (U.ι ≫ sW) nU)
    (hcrepK : IsCrepantBoundary (U.ι ≫ sW) nU K
      (Divisor.toQDivisor (inverseTransformDivisor U.ι T)) g hW' hg (Divisor.toQDivisor T'))
    {ξ' : Valuation W'.functionField ℤᵐ⁰} (hξ'ξ : ξ'.comap (functionFieldMap (g ≫ U.ι)) = ξ)
    {C' : IrreducibleCloseds W'} (hC' : MMP.Intersection.IsCentre k (g ≫ U.ι ≫ sW) ξ' C') :
    IsReducedSNCDiscrepancy (g ≫ U.ι ≫ sW) T' ξ' 0 := by
  obtain ⟨hWv, hsm, -⟩ := id h
  haveI : IsDominant U.ι := isDominant_ι_of_nonempty U
  haveI : IsDominant g := hg.isDominant
  haveI : AlgebraicGeometry.IsVariety k (g ≫ U.ι ≫ sW) := hW'.1
  haveI : Smooth sW := MMP.Threefold.Resolution.smooth_of_isSmoothScheme hsm
  haveI : CompactSpace W := (hWv.toQuasiCompact).compactSpace_of_compactSpace
  haveI : CompactSpace W' := (hW'.1.toQuasiCompact).compactSpace_of_compactSpace
  obtain ⟨D'', hD''p, hξ'D'', -⟩ := hC'
  obtain ⟨D0, hD0p, hξD0, rfl⟩ := hZ
  have hsmU : IsSmoothScheme (U.ι ≫ sW) := MMP.Flips.isSmoothScheme_of_smooth _
  have hbijU := functionFieldMap_opens_ι_bijective U
  -- the dimension `nU` and canonical divisors of `W` and `W'`
  have hdimU : topologicalKrullDim U = nU := hK.topologicalKrullDim_eq
  have hdimW : topologicalKrullDim W = nU :=
    (topologicalKrullDim_eq_of_functionFieldMap_bijective (sX := sW) U.ι hbijU).symm.trans hdimU
  have hdimW' : topologicalKrullDim W' = nU :=
    (topologicalKrullDim_eq_of_functionFieldMap_bijective (sX := U.ι ≫ sW) g
      hg.functionFieldMap_bijective).trans hdimU
  obtain ⟨KW, hKW⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sW hsm hdimW
  obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme
    (g ≫ U.ι ≫ sW) hsm' hdimW'
  -- the discrepancy of `ξ` over `(W, T)` is `-1`, and so is that over `(U, T|_U)`
  have hdW := isDiscrepancy_neg_one_of_isReducedSNCDiscrepancy h hKW D0 hD0p hξD0
  have hPWT : IsPairWith sW nU KW (Divisor.toQDivisor T) :=
    ⟨⟨hWv, inferInstance⟩, hKW, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨_hYU, _hfU, E0, -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPWT D0 U hZU
  have hdU := (hiff _).1 hdW
  have hTU : (Divisor.toQDivisor T).restrictOpen U =
      Divisor.toQDivisor (inverseTransformDivisor U.ι T) := by
    rw [MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen]
    refine Finsupp.ext fun F => ?_
    rfl
  rw [hTU] at hdU
  have hdU' := isDiscrepancy_of_isCanonicalDivisor hsmU hdU hK
  have hPWU : MMP.Mori.IsPairWith (U.ι ≫ sW) nU K
      (Divisor.toQDivisor (inverseTransformDivisor U.ι T)) :=
    ⟨hdU'.1, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsmU _⟩
  have hPU := hPWU.isPair
  -- crepant pull-back to `(W', T')`
  have hval : (⟨_, D0.f ∣_ U, _hYU, _hfU, E0⟩ : DivisorOver k (U.ι ≫ sW)).valuation =
      D''.valuation.comap (functionFieldMap g) := by
    ext x
    obtain ⟨y, rfl⟩ := hbijU.2 x
    have h1 := congrArg (fun v => v y) hvU
    have h2 := congrArg (fun v => v y) hξ'ξ
    simp only [Valuation.comap_apply] at h1 h2 ⊢
    rw [← h1, ← hξD0, ← h2, hξ'D'',
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
  have hdY := ((MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hPU g hW' hg hK hKY
    (Or.inl hcrepK)).2 D'' _ hval (-1)).2 hdU'
  rw [hξ'D'']
  exact isReducedSNCDiscrepancy_zero_of_isDiscrepancy hW' hsm' hT' hsnc' hKY D'' hD''p hdY

end Helpers

/-- **Zero error forces a monomial valuation.** Let `W` be a smooth variety over an algebraically
closed field `k` of characteristic zero, `T = ∑ⱼ Tⱼ` a reduced snc divisor on `W` and `ξ` a
normalized divisorial valuation of `k(W)` with centre on `W` and reduced snc discrepancy
`e_T(ξ) = 0`. Then the centre `Z = c_W(ξ)` lies on some component of `T`, i.e.
`J(ξ) = MMP.Fourfold.sncIndexSet T Z` is nonempty, and there is a weight `α` such that, for every
choice of local equations `zⱼ` of the `Tⱼ` (`j ∈ J(ξ)`) at the generic point of `Z` (one exists),
`αⱼ = ξ(Tⱼ)`, i.e. `ξ zⱼ = exp (-αⱼ)`, and `ξ` is monomial of weight `α` at the irreducible
component `Z` of `⋂_{j ∈ J(ξ)} Tⱼ`. -/
@[mmp "lem_oai4_snc_valuations_d"]
public theorem IsReducedSNCDiscrepancy.isMonomialValuationOfWeight_of_eq_zero
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {W : Scheme.{u}}
    {sW : W ⟶ Spec (.of k)} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    {T : Divisor W} {ξ : Valuation W.functionField ℤᵐ⁰}
    (h : IsReducedSNCDiscrepancy sW T ξ 0) :
    ∃ Z : IrreducibleCloseds W, MMP.Intersection.IsCentre k sW ξ Z ∧
      (sncIndexSet T (Z : Set W)).Nonempty ∧
      ∃ α : sncIndexSet T (Z : Set W) → ℕ,
        (∃ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
          ∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
            Ideal.span {z j}) ∧
        ∀ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
          (∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
            Ideal.span {z j}) →
          (∀ j, ξ (algebraMap _ W.functionField (z j)) = WithZero.exp (-(α j : ℤ))) ∧
            IsMonomialValuationOfWeight sW T (sncIndexSet T (Z : Set W)) Z z α ξ := by
  classical
  obtain ⟨hWv, hsm, hT, hsnc, Z, hZ, -⟩ := id h
  haveI : AlgebraicGeometry.IsVariety k sW := hWv
  set J := sncIndexSet T (Z : Set W)
  set η := Z.isIrreducible.genericPoint
  have hZcl : (Z : Set W) = closure {η} := by
    have := Z.isIrreducible.isGenericPoint_genericPoint_closure
    rw [Z.isClosed.closure_eq] at this
    exact this.symm
  -- the codimension `c` of the centre is `|J(ξ)| ≥ 1`, and the centre is a stratum
  obtain ⟨c, hc, hc1⟩ : ∃ c : ℕ, codimension Z = c ∧ 1 ≤ c := by
    obtain ⟨D0, -, -, rfl⟩ := hZ
    rw [MMP.Positivity.DivisorOver.codimension_center]
    have h1 := one_le_coheight_map_genericPoint D0
    obtain ⟨c, hc⟩ := ENat.ne_top_iff_exists.1 (coheight_ne_top (D0.f D0.E.genericPoint))
    refine ⟨c, hc.symm, ?_⟩
    rw [← hc] at h1
    exact_mod_cast h1
  have hcJ : c ≤ J.card := by
    have := h.sub_card_sncIndexSet_le hZ hc
    have : (c : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  obtain ⟨hZmax, hcard⟩ := maximal_of_codimension_le_card hsnc Z hc hcJ
  have hJne : J.Nonempty := Finset.card_pos.1 (by omega)
  have hJT : J ⊆ T.support := Finset.filter_subset _ _
  have hηZ : η ∈ (Z : Set W) := by rw [hZcl]; exact subset_closure rfl
  have hmem : ∀ j : J, η ∈ (j.1.support : Set W) := fun j => (Finset.mem_filter.1 j.2).2 hηZ
  obtain ⟨z0, hz0⟩ := SNCWeight.Restriction.exists_localEqs hsnc hJT hmem
  have hdom := SNCWeight.Restriction.dominates_of_isCentre hZcl hZ
  -- the orders `α = (ξ(Tⱼ))` are positive integers
  have hval : ∀ j : J, ∃ a : ℕ, 0 < a ∧
      ξ (algebraMap _ W.functionField (z0 j)) = WithZero.exp (-(a : ℤ)) := by
    intro j
    have hlt := SNCWeight.Subtraction.valuation_lt_one_of_localEq hdom j.1 (hmem j) (hz0 j)
    have hne : ξ (algebraMap _ W.functionField (z0 j)) ≠ 0 :=
      (Valuation.ne_zero_iff ξ).2 (SNCWeight.LocalEquation.localEq_ne_zero j.1 (hmem j) (hz0 j))
    obtain ⟨m, hm⟩ := SNCWeight.Subtraction.exists_exp_of_ne_zero hne
    rw [hm, ← WithZero.exp_zero, WithZero.exp_lt_exp] at hlt
    refine ⟨(-m).toNat, by omega, ?_⟩
    rw [hm]
    congr 1
    omega
  choose α hαpos hα using hval
  have hαz : ∀ z : J → W.presheaf.stalk η,
      (∀ j, IdealSheafData.stalk j.1.idealSheaf η = Ideal.span {z j}) →
      ∀ j, ξ (algebraMap _ W.functionField (z j)) = WithZero.exp (-(α j : ℤ)) := fun z hz j => by
    rw [SNCWeight.Subtraction.valuation_eq_of_span_eq hdom ((hz j).symm.trans (hz0 j)), hα j]
  -- the primitive part `α'` of `α = d • α'`
  haveI : Nonempty J := hJne.to_subtype
  obtain ⟨d, α', hdpos, hαd, hα'pos, hα'p⟩ := exists_eq_mul_primitive hαpos
  -- the snc modification adapted to `α'`
  obtain ⟨U, hηU, hUa, hUJ, W', _, _, _, g, hg, _, hW', T', hgp, -, hsm', hT', hsnc', hsupp,
    hexc, hcrep, E, hE, hmono, hcent⟩ :=
    exists_snc_modification_primitive_weight sW hWv hsm T hT hsnc J hJne hJT Z hZmax α' hα'pos hα'p
  obtain ⟨ξ', C', hξ'ξ, hC', hC'E, hC'F⟩ := hcent ξ d z0 hz0 hZ hdpos fun j => by
    rw [hα j, hαd j]
  obtain ⟨nU, K, hK, hcrepK⟩ := hcrep
  haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
  have hzero := isReducedSNCDiscrepancy_zero_of_isCrepantBoundary h hZ U ⟨η, hηZ, hηU⟩ hg hW'
    hsm' hT' hsnc' hK hcrepK hξ'ξ hC'
  -- so the centre of `ξ` on `W'` is `E`, and `ξ = ord_E`
  have hξE : ξ = E.divisorialValuation.comap (functionFieldMap (g ≫ U.ι)) := by
    have hJ' : sncIndexSet T' (C' : Set W') = {E} := by
      ext F
      rw [Finset.mem_singleton]
      refine ⟨fun hF => by_contra fun hFE => hC'F F (Finset.mem_filter.1 hF).1 hFE
        (Finset.mem_filter.1 hF).2, ?_⟩
      rintro rfl
      exact Finset.mem_filter.2 ⟨hE, hC'E⟩
    obtain ⟨D', -, -, rfl⟩ := id hC'
    obtain ⟨c', hc'⟩ := ENat.ne_top_iff_exists.1 (show codimension D'.center ≠ ⊤ by
      rw [MMP.Positivity.DivisorOver.codimension_center]
      exact coheight_ne_top (D'.f D'.E.genericPoint))
    have hle := hzero.sub_card_sncIndexSet_le hC' hc'.symm
    rw [hJ', Finset.card_singleton] at hle
    have hcod : codimension D'.center ≤ 1 := by
      rw [← hc']
      have : (c' : ℝ) ≤ 1 := by push_cast at hle; linarith
      exact_mod_cast this
    rw [← hξ'ξ, eq_divisorialValuation_of_isCentre hW' hC' hC'E hcod]
  -- `α = α'`
  have hαα' : α = α' := by
    obtain ⟨hspan, hdim⟩ := SNCWeight.Restriction.span_range_eq_and_ringKrullDim hZmax hsnc hJT hZcl
      hmem z0 hz0
    funext j
    obtain ⟨-, -, -, -, -, -, -, -, -, -, hval⟩ := hmono z0 hz0
    obtain ⟨M, hM, hξM⟩ := hval (z0 j) fun h0 =>
      SNCWeight.LocalEquation.localEq_ne_zero j.1 (hmem j) (hz0 j) (by rw [h0, map_zero])
    have hMj : M = α' j := by
      refine le_antisymm (by_contra fun hlt => ?_) (hM.2
        (SNCWeight.WeightedOrder.mem_weightedMonomialIdeal_self z0 α' j))
      exact SNCWeight.WeightedOrder.notMem_weightedMonomialIdeal_succ z0 α' hα'pos hspan hdim j
        (weightedMonomialIdeal_antitone z0 α' (by omega) hM.1)
    rw [← hξE, hα j, hMj] at hξM
    exact_mod_cast neg_injective (WithZero.exp_injective hξM)
  subst hαα'
  refine ⟨Z, hZ, hJne, α, ⟨z0, hz0⟩, fun z hz => ⟨hαz z hz, ?_⟩⟩
  rw [hξE]
  exact hmono z hz

/-- **A divisor of discrepancy `-1` over a reduced snc pair is monomial at its centre.** On a
smooth variety `W` over an algebraically closed field of characteristic zero with a reduced snc
divisor `T`, a proper divisor `D` over `W` with discrepancy `a(D, W, T) = -1` has
`e_T(ord_D) = 0`, so `ord_D` is monomial at its centre as in
`MMP.Fourfold.IsReducedSNCDiscrepancy.isMonomialValuationOfWeight_of_eq_zero`. -/
theorem isMonomialValuationOfWeight_of_isDiscrepancy_neg_one
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {W : Scheme.{u}}
    {sW : W ⟶ Spec (.of k)} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (hW : IsNormalVariety k sW) (hsm : IsSmoothScheme sW) {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (hsnc : T.IsSNC sW) {n : ℕ}
    {K : Divisor W} (hK : K.IsCanonicalDivisor sW n) (D : DivisorOver k sW)
    (hDp : IsProper D.f) (hD : IsDiscrepancy sW n K (Divisor.toQDivisor T) D (-1)) :
    ∃ Z : IrreducibleCloseds W, MMP.Intersection.IsCentre k sW D.valuation Z ∧
      (sncIndexSet T (Z : Set W)).Nonempty ∧
      ∃ α : sncIndexSet T (Z : Set W) → ℕ,
        (∃ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
          ∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
            Ideal.span {z j}) ∧
        ∀ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
          (∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
            Ideal.span {z j}) →
          (∀ j, D.valuation (algebraMap _ W.functionField (z j)) = WithZero.exp (-(α j : ℤ))) ∧
            IsMonomialValuationOfWeight sW T (sncIndexSet T (Z : Set W)) Z z α D.valuation :=
  (isReducedSNCDiscrepancy_zero_of_isDiscrepancy hW hsm hT hsnc hK D hDp
    hD).isMonomialValuationOfWeight_of_eq_zero

section Finiteness

/-- In a noetherian space, a closed set has only finitely many maximal irreducible subsets. -/
private lemma finite_setOf_maximal_isIrreducible {X : Type*} [TopologicalSpace X]
    [NoetherianSpace X] {s : Set X} (hs : IsClosed s) :
    {Z : Set X | Maximal (fun S : Set X => IsIrreducible S ∧ S ⊆ s) Z}.Finite := by
  obtain ⟨S, hSf, hSc, hSi, rfl⟩ := NoetherianSpace.exists_finite_set_isClosed_irreducible hs
  refine hSf.subset fun Z hZ => ?_
  obtain ⟨t, ht, hZt⟩ := (isIrreducible_iff_sUnion_isClosed.mp hZ.1.1) hSf.toFinset
    (fun t ht => hSc t (hSf.mem_toFinset.mp ht)) (by simpa using hZ.1.2)
  rw [hSf.mem_toFinset] at ht
  have : t ⊆ Z := hZ.2 ⟨hSi t ht, Set.subset_sUnion_of_mem ht⟩ hZt
  rwa [hZt.antisymm this]

variable {k : Type u} [Field k] {W : Scheme.{u}} {sW : W ⟶ Spec (.of k)} [IsIntegral W]

/-- In a noetherian scheme there are only finitely many irreducible closed subsets that are
irreducible components of the intersection of the components of `T` through them: each is an
irreducible component of `⋂_{j ∈ J} Tⱼ` for one of the finitely many `J ⊆ T`. -/
private lemma finite_setOf_maximal_sncStratum [NoetherianSpace W] (T : Divisor W) :
    {Z : IrreducibleCloseds W | Maximal (fun S : Set W => IsIrreducible S ∧
      S ⊆ ⋂ E ∈ sncIndexSet T (Z : Set W), E.support) (Z : Set W)}.Finite := by
  classical
  refine (T.support.powerset.finite_toSet.biUnion fun J _ =>
    (finite_setOf_maximal_isIrreducible (s := ⋂ E ∈ J, E.support) (isClosed_biInter fun E _ => ?_)
      ).preimage SetLike.coe_injective.injOn).subset fun Z hZ => ?_
  · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    exact isClosed_closure
  · exact Set.mem_biUnion (x := sncIndexSet T (Z : Set W))
      (Finset.mem_coe.mpr (Finset.mem_powerset.mpr (Finset.filter_subset _ _))) hZ

/-- A monomial valuation is determined by its weight and its local equations. -/
private lemma eq_of_isMonomialValuationOfWeight {T : Divisor W}
    {J : Finset (MMP.Mori.PrimeDivisor W)}
    {Z : IrreducibleCloseds W} {z : J → W.presheaf.stalk Z.isIrreducible.genericPoint}
    {α : J → ℕ} {ξ ξ' : Valuation W.functionField ℤᵐ⁰}
    (h : IsMonomialValuationOfWeight sW T J Z z α ξ)
    (h' : IsMonomialValuationOfWeight sW T J Z z α ξ') : ξ = ξ' := by
  have key : ∀ f : W.presheaf.stalk Z.isIrreducible.genericPoint,
      ξ (algebraMap _ W.functionField f) = ξ' (algebraMap _ W.functionField f) := by
    intro f
    by_cases hf : f = 0
    · simp [hf]
    obtain ⟨M, hM, hξ⟩ := h.2.2.2.2.2.2.2.2.2.2 f hf
    obtain ⟨M', hM', hξ'⟩ := h'.2.2.2.2.2.2.2.2.2.2 f hf
    rw [hξ, hξ', hM.unique hM']
  ext x
  obtain ⟨a, b, -, rfl⟩ :=
    IsFractionRing.div_surjective (A := W.presheaf.stalk Z.isIrreducible.genericPoint) x
  rw [map_div₀, map_div₀, key, key]

end Finiteness

/-- **Finitely many zero-error valuations of bounded order.** Let `W` be a smooth variety over
an algebraically closed field `k` of characteristic zero, `T = ∑ⱼ Tⱼ` a reduced snc divisor on
`W` and `M ≥ 1` an integer. The normalized divisorial valuations `ξ` of `k(W)` with centre on
`W`, reduced snc discrepancy `e_T(ξ) = 0` (`MMP.Fourfold.IsReducedSNCDiscrepancy`) and
`ξ(Tⱼ) ≤ M` for every component `Tⱼ` of `T` containing the centre `Z`
(`j ∈ MMP.Fourfold.sncIndexSet T Z`) form a finite set. Here `ξ(Tⱼ)` is the order of `ξ` on a
local equation `zⱼ` of `Tⱼ` at the generic point of `Z`. -/
@[mmp "lem_oai4_snc_valuations_e"]
public theorem finite_setOf_isReducedSNCDiscrepancy_zero
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {W : Scheme.{u}}
    (sW : W ⟶ Spec (.of k)) [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]
    (T : Divisor W) {M : ℕ} (hM : 1 ≤ M) :
    {ξ : Valuation W.functionField ℤᵐ⁰ | IsReducedSNCDiscrepancy sW T ξ 0 ∧
      ∀ Z : IrreducibleCloseds W, MMP.Intersection.IsCentre k sW ξ Z →
        ∀ j ∈ sncIndexSet T (Z : Set W),
          ∀ z : W.presheaf.stalk Z.isIrreducible.genericPoint,
            IdealSheafData.stalk j.idealSheaf Z.isIrreducible.genericPoint = Ideal.span {z} →
              WithZero.exp (-(M : ℤ)) ≤ ξ (algebraMap _ W.functionField z)}.Finite := by
  -- the valuations monomial of weight `α` at `Z` for every choice of local equations
  let B : (Z : IrreducibleCloseds W) → (sncIndexSet T (Z : Set W) → ℕ) →
      Set (Valuation W.functionField ℤᵐ⁰) := fun Z α =>
    {ξ | (∃ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
        ∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
          Ideal.span {z j}) ∧
      ∀ z : sncIndexSet T (Z : Set W) → W.presheaf.stalk Z.isIrreducible.genericPoint,
        (∀ j, IdealSheafData.stalk j.1.idealSheaf Z.isIrreducible.genericPoint =
          Ideal.span {z j}) → IsMonomialValuationOfWeight sW T (sncIndexSet T (Z : Set W)) Z z α ξ}
  have hB : ∀ Z α, (B Z α).Subsingleton := by
    rintro Z α ξ ⟨⟨z, hz⟩, hξ⟩ ξ' ⟨-, hξ'⟩
    exact eq_of_isMonomialValuationOfWeight (hξ z hz) (hξ' z hz)
  -- the set is empty unless `W` is a variety, hence noetherian
  by_cases hW : MMP.Mori.IsVariety k sW
  swap
  · exact Set.finite_empty.subset fun ξ hξ => hW hξ.1.1
  haveI : NoetherianSpace W := by
    haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian sW
    haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace sW
    haveI : IsNoetherian W := {}
    infer_instance
  classical
  refine ((finite_setOf_maximal_sncStratum T).biUnion fun Z _ =>
    (Set.finite_Iic fun _ => M).biUnion fun α _ => (hB Z α).finite).subset fun ξ hξ => ?_
  obtain ⟨Z, hc, -, α, ⟨z₀, hz₀⟩, hall⟩ := hξ.1.isMonomialValuationOfWeight_of_eq_zero
  refine Set.mem_biUnion (x := Z) (hall z₀ hz₀).2.2.2.2.2.2.2.1 ?_
  refine Set.mem_biUnion (x := α) (fun j => ?_) ⟨⟨z₀, hz₀⟩, fun z hz => (hall z hz).2⟩
  have := hξ.2 Z hc j.1 j.2 (z₀ j) (hz₀ j)
  rw [(hall z₀ hz₀).1 j, WithZero.exp_le_exp, neg_le_neg_iff] at this
  exact_mod_cast this

end MMP.Fourfold

end
