section AmpleBridge

variable {X Z : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Removing a small multiple of `P` from `A/c`.** If `aA = H` with `H` an `f`-ample Cartier
divisor, then `A/c - ((c - 1)/(cl))P` has an `f`-ample multiple for every large `l`. -/
public theorem eventually_hasRelativelyAmpleMultiple_sub (f : X ⟶ Z) (hf : IsProjectiveMorphism f)
    [IsAffine Z] {A : QDivisor X} {H : Divisor X} {a : ℕ} (ha : 0 < a) (hHc : H.IsCartier)
    (hH : H.IsRelativelyAmple f hHc) (hHA : Divisor.toQDivisor H = (a : ℤ) • A)
    {c : ℕ} (hc : 0 < c) {P : Divisor X} (hP : P.IsCartier) :
    ∀ᶠ l : ℕ in Filter.atTop, ((c : ℚ)⁻¹ • A - (((c : ℚ) - 1) / (c * l : ℕ)) •
      Divisor.toQDivisor P).HasRelativelyAmpleMultiple f := by
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  have hF : (-(((a * (c - 1) : ℕ) : ℤ) • P)).IsCartier := (hP.zsmul _).neg
  filter_upwards [eventually_isRelativelyAmpleCartier_nsmul_add f
    (isRelativelyAmpleCartier_of_isRelativelyAmple f hHc hH) hF, Filter.eventually_gt_atTop 0]
    with l hl hl0
  refine ⟨c * l * a, by positivity, _, hl.choose, ?_,
    isRelativelyAmple_of_isRelativelyAmpleCartier f hl⟩
  have hcq : (c : ℚ) ≠ 0 := by exact_mod_cast hc.ne'
  have hlq : (l : ℚ) ≠ 0 := by exact_mod_cast hl0.ne'
  have hc1 : 1 ≤ c := hc
  ext E
  unfold DivisorWithCoeffs.coeff
  simp only [map_add, map_neg, map_nsmul, map_zsmul, hHA, Finsupp.coe_add, Finsupp.coe_neg,
    Finsupp.coe_smul, Finsupp.coe_sub, Pi.add_apply, Pi.neg_apply, Pi.smul_apply, Pi.sub_apply,
    smul_eq_mul, nsmul_eq_mul, zsmul_eq_mul]
  push_cast [Nat.cast_sub hc1]
  field_simp
  simp only [Pi.mul_apply, Pi.natCast_apply, Pi.intCast_apply, Pi.add_apply, Pi.neg_apply, Pi.one_apply,
    Pi.sub_apply]
  ring

end AmpleBridge

/-! ### Restriction of divisors to a prime divisor -/

section Restriction

variable {X : Scheme.{0}} [NoetherianSpace X]

/-- The coefficients of a restriction as a sum over any finite set containing the support. -/
private theorem coeff_restrictPrimeDivisor_eq_sum' {R : Type*} [AddCommMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (hs : D.support ⊆ s)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    (D.restrictPrimeDivisor S).coeff Q =
      ∑ E ∈ s, E.intersectionLength (haveI := S.integral; S.idealSheaf.subschemeι) Q •
        D.coeff E := by
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D S hD Q]
  exact Finsupp.sum_of_support_subset D hs _ (fun E _ => smul_zero _)

/-- Restriction to `S` is additive on divisors of which `S` is not a component. -/
private theorem restrictPrimeDivisor_add' {R : Type*} [AddCommMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D₁ D₂ : DivisorWithCoeffs R X} (h₁ : D₁.coeff S = 0)
    (h₂ : D₂.coeff S = 0) :
    (D₁ + D₂).restrictPrimeDivisor S = D₁.restrictPrimeDivisor S + D₂.restrictPrimeDivisor S := by
  classical
  have h₁₂ : (D₁ + D₂).coeff S = 0 := by
    change D₁ S + D₂ S = 0
    rw [show D₁ S = 0 from h₁, show D₂ S = 0 from h₂, add_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, ← DivisorWithCoeffs.coeff_apply,
    ← DivisorWithCoeffs.coeff_apply,
    coeff_restrictPrimeDivisor_eq_sum' S h₁₂ (D₁.support ∪ D₂.support) Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum' S h₁ (D₁.support ∪ D₂.support)
      Finset.subset_union_left Q,
    coeff_restrictPrimeDivisor_eq_sum' S h₂ (D₁.support ∪ D₂.support)
      Finset.subset_union_right Q, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  change _ • (D₁ E + D₂ E) = _ • D₁ E + _ • D₂ E
  rw [smul_add]

/-- Restriction to `S` commutes with scalar multiples. -/
private theorem restrictPrimeDivisor_smul' {A R : Type*} [Semiring A] [AddCommMonoid R]
    [Module A R] (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0)
    (a : A) : (a • D).restrictPrimeDivisor S = a • D.restrictPrimeDivisor S := by
  classical
  have ha : (a • D).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_smul, hD, smul_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_smul,
    coeff_restrictPrimeDivisor_eq_sum' S ha D.support Finsupp.support_smul Q,
    coeff_restrictPrimeDivisor_eq_sum' S hD D.support subset_rfl Q, Finset.smul_sum]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_smul, smul_comm]

/-- Restriction to `S` commutes with negation. -/
private theorem restrictPrimeDivisor_neg' {R : Type*} [AddCommGroup R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0) :
    (-D).restrictPrimeDivisor S = -D.restrictPrimeDivisor S := by
  rw [← neg_one_zsmul, restrictPrimeDivisor_smul' S hD, neg_one_zsmul]

/-- Restriction to `S` commutes with subtraction. -/
private theorem restrictPrimeDivisor_sub' {R : Type*} [AddCommGroup R]
    (S : MMP.Mori.PrimeDivisor X) {D₁ D₂ : DivisorWithCoeffs R X} (h₁ : D₁.coeff S = 0)
    (h₂ : D₂.coeff S = 0) :
    (D₁ - D₂).restrictPrimeDivisor S = D₁.restrictPrimeDivisor S - D₂.restrictPrimeDivisor S := by
  have h₂' : (-D₂).coeff S = 0 := by
    rw [show (-D₂).coeff S = -D₂.coeff S from rfl, h₂, neg_zero]
  rw [sub_eq_add_neg, restrictPrimeDivisor_add' S h₁ h₂', restrictPrimeDivisor_neg' S h₂,
    sub_eq_add_neg]

/-- Restriction to `S` commutes with regarding a divisor as a `ℚ`-divisor. -/
private theorem restrictPrimeDivisor_toQDivisor' (S : MMP.Mori.PrimeDivisor X) {D : Divisor X}
    (hD : D.coeff S = 0) :
    (Divisor.toQDivisor D).restrictPrimeDivisor S = Divisor.toQDivisor (D.restrictPrimeDivisor S)
    := by
  classical
  have hD' : (Divisor.toQDivisor D).coeff S = 0 := by
    rw [Divisor.coeff_toQDivisor, hD]; simp
  have hsub : (Divisor.toQDivisor D).support ⊆ D.support := by
    intro E hE
    rw [Finsupp.mem_support_iff] at hE ⊢
    intro h0
    apply hE
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_apply,
      h0]
    simp
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toQDivisor,
    coeff_restrictPrimeDivisor_eq_sum' S hD' D.support hsub Q,
    coeff_restrictPrimeDivisor_eq_sum' S hD D.support subset_rfl Q]
  push_cast
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [Divisor.coeff_toQDivisor, nsmul_eq_mul, nsmul_eq_mul]
  push_cast
  ring

/-- The restriction of an effective divisor is effective. -/
public theorem coeff_restrictPrimeDivisor_nonneg' {R : Type*}
    [AddCommMonoid R] [PartialOrder R] [IsOrderedAddMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hD : D.coeff S = 0)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    0 ≤ (D.restrictPrimeDivisor S).coeff Q := by
  rw [coeff_restrictPrimeDivisor_eq_sum' S hD D.support subset_rfl Q]
  exact Finset.sum_nonneg fun E _ => nsmul_nonneg (hD0 E) _

/-- Restriction is monotone on divisors of which `S` is not a component. -/
private theorem restrictPrimeDivisor_mono' {R : Type*} [AddCommGroup R] [PartialOrder R]
    [IsOrderedAddMonoid R] (S : MMP.Mori.PrimeDivisor X) {D₁ D₂ : DivisorWithCoeffs R X}
    (h₁ : D₁.coeff S = 0) (h₂ : D₂.coeff S = 0) (h : D₁ ≤ D₂) :
    D₁.restrictPrimeDivisor S ≤ D₂.restrictPrimeDivisor S := by
  have h₂₁ : (D₂ - D₁).coeff S = 0 := by
    rw [show (D₂ - D₁).coeff S = D₂.coeff S - D₁.coeff S from rfl, h₁, h₂, sub_zero]
  intro Q
  have := coeff_restrictPrimeDivisor_nonneg' S (D := D₂ - D₁)
    (fun P => sub_nonneg.mpr (h P)) h₂₁ Q
  rw [restrictPrimeDivisor_sub' S h₂ h₁] at this
  exact sub_nonneg.mp this

end Restriction

/-! ### Elementary facts about the boundary -/

section Boundary

variable {X : Scheme.{0}}

/-- Dropping an effective part of the boundary keeps `⌊S + B⌋ = S`. -/
private theorem roundDown_single_add_eq (S : MMP.Mori.PrimeDivisor X) {A B : QDivisor X}
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (h : DivisorWithCoeffs.roundDown (Divisor.toQDivisor (Finsupp.single S 1) + A + B) =
      Finsupp.single S 1) :
    DivisorWithCoeffs.roundDown (Divisor.toQDivisor (Finsupp.single S 1) + B) =
      Finsupp.single S 1 := by
  ext P
  have hP := congrArg (fun D : Divisor X => D P) h
  change ⌊((Finsupp.single S (1 : ℤ) P : ℤ) : ℚ) + B P⌋ = Finsupp.single S (1 : ℤ) P
  change ⌊((Finsupp.single S (1 : ℤ) P : ℤ) : ℚ) + A P + B P⌋ = Finsupp.single S (1 : ℤ) P at hP
  rw [add_assoc, Int.floor_intCast_add] at hP
  rw [Int.floor_intCast_add]
  have hAP : (0 : ℚ) ≤ A P := hA P
  have hBP : (0 : ℚ) ≤ B P := hB P
  have h1 : 0 ≤ ⌊B P⌋ := Int.floor_nonneg.mpr hBP
  have h2 : ⌊B P⌋ ≤ ⌊A P + B P⌋ := Int.floor_le_floor (by linarith)
  omega

/-- A `ℚ`-divisor that is an integral multiple, plus an integral divisor, is Cartier on a smooth
variety. -/
public theorem isCartierDivisor_smul_add {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    [IsLocallyNoetherian X] [IsNormal X] (hXs : IsSmoothScheme sX) (K : Divisor X)
    {c : ℕ} {Δ : QDivisor X} (h : ((c : ℚ) • Δ).IsCartierDivisor) :
    ((c : ℚ) • (Divisor.toQDivisor K + Δ)).IsCartierDivisor := by
  obtain ⟨D', hD', -⟩ := h
  refine ⟨(c : ℤ) • K + D', ?_, MMP.Fourfold.isCartier_of_isSmoothScheme hXs _⟩
  rw [map_add, hD', map_zsmul, smul_add, ← Int.cast_smul_eq_zsmul ℚ]
  push_cast
  rfl

/-- A `ℚ`-divisor with integral coefficients is Cartier on a smooth variety. -/
private theorem isCartierDivisor_of_integral {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    [IsLocallyNoetherian X] [IsNormal X] (hXs : IsSmoothScheme sX) {D : QDivisor X}
    (h : ∃ D' : Divisor X, Divisor.toQDivisor D' = D) : D.IsCartierDivisor := by
  obtain ⟨D', rfl⟩ := h
  exact ⟨D', rfl, MMP.Fourfold.isCartier_of_isSmoothScheme hXs _⟩

/-- The coefficientwise minimum is nonnegative, so a `ℚ`-divisor above it is effective. -/
public theorem nonneg_of_coeffwiseMin_le {Ω : QDivisor X} {G : MMP.Mori.PrimeDivisor X → ENNReal}
    {Φ : QDivisor X} (h : coeffwiseMin Ω G ≤ QDivisor.toRDivisor Φ) : 0 ≤ Φ := by
  intro P
  have h1 := h P
  have h2 : (0 : ℝ) ≤ (coeffwiseMin Ω G) P := by
    change (0 : ℝ) ≤ (coeffwiseMin Ω G).coeff P
    rw [coeff_coeffwiseMin]
    exact ENNReal.toReal_nonneg
  change (0 : ℚ) ≤ Φ P
  have h3 : (0 : ℝ) ≤ (Φ P : ℝ) := le_trans h2 h1
  exact_mod_cast h3

/-- If `cE` is integral and `S` is not a component of `E`, then `c(E|_S)` is integral. -/
public theorem exists_toQDivisor_eq_smul_restrictPrimeDivisor [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {E : QDivisor X} (hE : E.coeff S = 0) {c : ℕ}
    (h : ∃ D' : Divisor X, Divisor.toQDivisor D' = (c : ℚ) • E) :
    ∃ D'' : Divisor (haveI := S.integral; S.idealSheaf.subscheme),
      Divisor.toQDivisor D'' = (c : ℚ) • E.restrictPrimeDivisor S := by
  obtain ⟨D', hD'⟩ := h
  have hD'S : D'.coeff S = 0 := by
    have := congrArg (fun D : QDivisor X => D S) hD'
    change ((D' S : ℤ) : ℚ) = (c : ℚ) * E S at this
    rw [show E S = 0 from hE, mul_zero] at this
    exact_mod_cast this
  exact ⟨D'.restrictPrimeDivisor S, by
    rw [← restrictPrimeDivisor_toQDivisor' S hD'S, hD', restrictPrimeDivisor_smul' S hE]⟩

/-- If `S` is not a component of `H`, the components of `(rH)|_S` are components of `H|_S`. -/
public theorem coeff_restrictPrimeDivisor_ne_zero_of_smul [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {H : Divisor X} (hH : H.coeff S = 0) (r : ℚ)
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (h : ((r • Divisor.toQDivisor H).restrictPrimeDivisor S).coeff G ≠ 0) :
    (H.restrictPrimeDivisor S).coeff G ≠ 0 := by
  have hH' : (Divisor.toQDivisor H).coeff S = 0 := by
    rw [Divisor.coeff_toQDivisor, hH]; simp
  rw [restrictPrimeDivisor_smul' S hH', restrictPrimeDivisor_toQDivisor' S hH] at h
  intro h0
  apply h
  change r * ((H.restrictPrimeDivisor S).coeff G : ℚ) = 0
  rw [h0]; simp

/-- Removing an effective part of the boundary preserves plt on a smooth variety. -/
public theorem isPltPair_of_add {k : Type} [Field k] [IsAlgClosed k] [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    {Δ A : QDivisor X} (hA : 0 ≤ A) (h : IsPltPair sX n K (Δ + A)) : IsPltPair sX n K Δ :=
  ⟨⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _⟩, lt_of_lt_of_le h.2
    (MMP.Threefold.Mori.Helpers.discrep_add_le (fun P => hA P)
      (MMP.Fourfold.isQCartier_of_isSmoothScheme hXs A))⟩

/-- If `c(S + E)` is integral then so is `cE`. -/
public theorem exists_toQDivisor_eq_smul_of_single_add [IsLocallyNoetherian X] [IsNormal X]
    (S : MMP.Mori.PrimeDivisor X) {E : QDivisor X} {c : ℕ}
    (h : ((c : ℚ) • (Divisor.toQDivisor (Finsupp.single S 1) + E)).IsCartierDivisor) :
    ∃ D' : Divisor X, Divisor.toQDivisor D' = (c : ℚ) • E := by
  obtain ⟨D₁, hD₁, -⟩ := h
  refine ⟨D₁ - (c : ℤ) • Finsupp.single S 1, ?_⟩
  rw [map_sub, hD₁, map_zsmul, smul_add, ← Int.cast_smul_eq_zsmul ℚ]
  push_cast
  abel

/-- `c(K + Ω - Φ)` is Cartier on a smooth variety when `cΩ` and `cΦ` are integral. -/
public theorem isCartierDivisor_smul_add_sub {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    [IsLocallyNoetherian X] [IsNormal X] (hXs : IsSmoothScheme sX) (K : Divisor X)
    {c : ℕ} {Ω Φ : QDivisor X} (hΩ : ∃ D' : Divisor X, Divisor.toQDivisor D' = (c : ℚ) • Ω)
    (hΦ : ((c : ℚ) • Φ).IsCartierDivisor) :
    ((c : ℚ) • (Divisor.toQDivisor K + (Ω - Φ))).IsCartierDivisor := by
  obtain ⟨D₁, hD₁⟩ := hΩ
  obtain ⟨D₂, hD₂, -⟩ := hΦ
  refine isCartierDivisor_of_integral hXs ⟨(c : ℤ) • K + D₁ - D₂, ?_⟩
  rw [map_sub, map_add, hD₁, hD₂, map_zsmul, smul_add, smul_sub, ← Int.cast_smul_eq_zsmul ℚ]
  push_cast
  abel

/-- `(M a N')A` is Cartier for `A = H/a` on a smooth variety. -/
public theorem isCartierDivisor_natCast_smul_inv_smul {k : Type} [Field k]
    {sX : X ⟶ Spec (.of k)} [IsLocallyNoetherian X] [IsNormal X] (hXs : IsSmoothScheme sX)
    (H : Divisor X) {M a N' : ℕ} (ha : (a : ℚ) ≠ 0) :
    (((M * a * N' : ℕ) : ℚ) • ((a : ℚ)⁻¹ • Divisor.toQDivisor H)).IsCartierDivisor := by
  refine isCartierDivisor_of_integral hXs ⟨((M * N' : ℕ) : ℤ) • H, ?_⟩
  rw [map_zsmul, smul_smul, ← Int.cast_smul_eq_zsmul ℚ]
  congr 1
  push_cast
  field_simp

end Boundary

/-! ### Klt boundaries on a smooth variety -/

section Klt

variable {k : Type} [Field k] [IsAlgClosed k] {Y : Scheme.{0}} [IsIntegral Y]
  [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of k)}

/-- A log discrepancy of a divisor over `Y` that is not exceptional is `1 - coeff_P(B)` for the
prime divisor `P` of `Y` with the same valuation. -/
private theorem exists_eq_one_sub_coeff_of_not_isExceptional (hYs : IsSmoothScheme sY)
    (hY : IsNormalVariety k sY) {n : ℕ} {K : Divisor Y} (hK : K.IsCanonicalDivisor sY n)
    {B : QDivisor Y} {D : DivisorOver k sY} (hD : ¬ D.IsExceptional) {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sY n (QDivisor.toRDivisor B) D a) :
    ∃ P : MMP.Mori.PrimeDivisor Y, a = 1 - (B.coeff P : ℝ) := by
  obtain ⟨P, hPv⟩ := MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hY D hD
  have hPair : MMP.Mori.IsPair sY B := ⟨hY, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hYs _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPair hK
    (DivisorOver.ofPrimeDivisor k hY P)
  have hb := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 Y) from inferInstance)
  refine ⟨P, ?_⟩
  rw [MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hb hPv,
    hc.eq_neg_coeff_of_ofPrimeDivisor hY]
  push_cast
  ring

/-- **A canonical boundary with an effective part removed is klt.** On a smooth variety, if
`(Y, Ω + A)` is a real canonical pair with `A ≥ 0`, then `(Y, Ω)` is klt. -/
public theorem isKltPair_of_isRealCanonicalPair_add [CharZero k] (hYs : IsSmoothScheme sY)
    {Ω A : QDivisor Y} (hΩ : 0 ≤ Ω) (hA : 0 ≤ A)
    (h : IsRealCanonicalPair sY (QDivisor.toRDivisor (Ω + A))) :
    MMP.Fourfold.IsKltPair sY Ω := by
  obtain ⟨hY, hcoef, ⟨n, K, hK, -⟩, hexc⟩ := h
  refine ⟨⟨inferInstance, inferInstance,
    ⟨hY, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hYs _⟩, fun P => hΩ P⟩,
    fun n' D a ha => ?_⟩
  obtain ⟨a', ha'le, ha'⟩ := MMP.Fourfold.exists_isLogDiscrepancy_add_le hYs A (fun P => hA P) ha
  rw [← map_add] at ha'
  by_cases hE : D.IsExceptional
  · linarith [hexc n' D a' hE ha']
  · have hn : n' = n := by
      have e := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha').symm.trans
        hK.topologicalKrullDim_eq
      exact_mod_cast e
    subst hn
    obtain ⟨P, hP⟩ := exists_eq_one_sub_coeff_of_not_isExceptional hYs hY hK hE ha'
    have h1 : ((Ω + A).coeff P : ℝ) < 1 := by
      by_cases h0 : ((Ω + A).coeff P : ℝ) = 0
      · rw [h0]; norm_num
      · exact (hcoef P (by rwa [QDivisor.coeff_toRDivisor])).2
    have h1' : ((Ω + A).coeff P : ℝ) < 1 := by
      simpa only [QDivisor.coeff_toRDivisor] using h1
    linarith

/-- **Klt is open under adding a small effective divisor**, on a smooth variety. -/
public theorem exists_isKltPair_add_smul [CharZero k] (hYs : IsSmoothScheme sY)
    {Ω Δ' : QDivisor Y} (h : MMP.Fourfold.IsKltPair sY Ω) (hΔ' : 0 ≤ Δ') :
    ∃ δ : ℚ, 0 < δ ∧ ∀ t : ℚ, 0 ≤ t → t < δ → MMP.Fourfold.IsKltPair sY (Ω + t • Δ') := by
  obtain ⟨⟨-, -, ⟨hY, n, K, hK, -⟩, hΩ0⟩, -⟩ := id h
  have hP : ∀ E : QDivisor Y, 0 ≤ E → MMP.Fourfold.IsPair sY E := fun E hE =>
    ⟨inferInstance, inferInstance,
      ⟨hY, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hYs _⟩, fun P => hE P⟩
  have hM := (MMP.Fourfold.isKltPair_iff_mori_isKltPair sY hK (hP Ω (fun P => hΩ0 P))).mp h
  obtain ⟨δ, hδ, hall⟩ := MMP.Mori.IsKltPair.exists_forall_isKltPair_add_smul hM
    (Δ' := Δ') (fun P => hΔ' P) (MMP.Fourfold.isQCartier_of_isSmoothScheme hYs _)
  refine ⟨δ, hδ, fun t ht0 ht => (MMP.Fourfold.isKltPair_iff_mori_isKltPair sY hK
    (hP _ fun P => ?_)).mpr (hall t ht0 ht)⟩
  change (0 : ℚ) ≤ Ω P + t * Δ' P
  exact add_nonneg (hΩ0 P) (mul_nonneg ht0 (hΔ' P))

end Klt

/-! ### Log resolutions and strict transforms -/

section StrictTransform

variable {k : Type} [Field k] {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)}

/-- For a strict transform `T` of `S`, the inverse image of `S` lies in `Ex(μ) ∪ T`. -/
private theorem exceptionalSet_sup_preimage_eq {μ : Y ⟶ X} {S : MMP.Mori.PrimeDivisor X}
    {T : MMP.Mori.PrimeDivisor Y} (hT : inverseTransformPrimeDivisor μ S = some T) :
    exceptionalSet μ ⊔ S.idealSheaf.support.preimage μ.continuous =
      exceptionalSet μ ⊔ T.idealSheaf.support := by
  have hTs : T.support = (inverseTransform μ S.idealSheaf.support : Set Y) :=
    support_inverseTransformPrimeDivisor hT
  refine le_antisymm (sup_le le_sup_left fun y hy => ?_) (sup_le le_sup_left fun y hy => ?_)
  · by_cases hyE : y ∈ exceptionalSet μ
    · exact Or.inl hyE
    · right
      change y ∈ T.support
      rw [hTs]
      refine subset_closure ⟨hy, ?_⟩
      rw [mem_exceptionalSet] at hyE
      exact not_not.mp hyE
  · right
    change y ∈ T.support at hy
    rw [hTs] at hy
    change μ y ∈ S.idealSheaf.support
    have hcl : closure (μ ⁻¹' ((S.idealSheaf.support : Set X) ∩ biregularLocus μ)) ⊆
        μ ⁻¹' (S.idealSheaf.support : Set X) :=
      closure_minimal (fun z hz => hz.1) (S.idealSheaf.support.isClosed.preimage μ.continuous)
    exact hcl hy

/-- **A log resolution of `(X, R)` is one of `(X, S)`** for every component `S` of `R` with a
strict transform. -/
private theorem isLogResolution_single [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] {R : RDivisor X} {μ : Y ⟶ X} (h : MMP.Mori.IsLogResolution sX R μ)
    (S : MMP.Mori.PrimeDivisor X) (hS : R.coeff S ≠ 0) {T : MMP.Mori.PrimeDivisor Y}
    (hT : inverseTransformPrimeDivisor μ S = some T) :
    MMP.Mori.IsLogResolution sX
      (QDivisor.toRDivisor (Divisor.toQDivisor (Finsupp.single S 1) + 0)) μ := by
  have hsupp : (QDivisor.toRDivisor (Divisor.toQDivisor (Finsupp.single S (1 : ℤ)) + 0)).supp =
      S.idealSheaf.support := by
    rw [add_zero, QDivisor.supp_toRDivisor, Divisor.supp_toQDivisor]
    refine le_antisymm (DivisorWithCoeffs.supp_single_le S 1) ?_
    exact DivisorWithCoeffs.support_subset_supp (by
      rw [DivisorWithCoeffs.coeff_single_self]; norm_num)
  have hle : S.idealSheaf.support ≤ R.supp := DivisorWithCoeffs.support_subset_supp hS
  refine ⟨h.toIsSmoothResolution, h.isPureCodimOne_exceptionalSet, ?_⟩
  rw [hsupp]
  refine isSNCSubset_of_le h.isSNCSubset ?_ (sup_le_sup_left (fun y hy => hle hy) _)
  rw [exceptionalSet_sup_preimage_eq hT]
  refine isPureCodimOne_sup h.isPureCodimOne_exceptionalSet
    (isPureCodimOne_of_eq_iUnion' _ ({T} : Finset (MMP.Mori.PrimeDivisor Y)) ?_)
  simp only [Finset.mem_singleton, Set.iUnion_iUnion_eq_left]

/-- A prime divisor of `Y` whose generic point lies over the biregular locus of `μ` is the
strict transform of a prime divisor of `X`. -/
private theorem exists_primeDivisor_of_mem_biregularLocus [IsLocallyNoetherian X]
    [IsLocallyNoetherian Y] (μ : Y ⟶ X) (P : MMP.Mori.PrimeDivisor Y)
    (h : μ P.genericPoint ∈ biregularLocus μ) :
    ∃ Q : MMP.Mori.PrimeDivisor X, μ P.genericPoint = Q.genericPoint ∧
      IsIso (μ.stalkMap P.genericPoint) := by
  have hiso := MMP.isIso_stalkMap_of_mem_biregularLocus μ h
  have hco : Order.coheight (μ P.genericPoint) = 1 := by
    have h' := ringKrullDim_eq_of_ringEquiv (asIso (μ.stalkMap P.genericPoint)).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight,
      P.coheight_genericPoint] at h'
    exact_mod_cast h'
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hco, ?_, hiso⟩
  exact (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hco).symm

/-- The exceptional prime divisors of a log resolution form a finite set. -/
private theorem exists_finset_isExceptional [IsIntegral X] {D : RDivisor X}
    {f : Y ⟶ X} (hf : MMP.Mori.IsLogResolution sX D f) (hY : IsNormalVariety k (f ≫ sX)) :
    ∃ Ex : Finset (MMP.Mori.PrimeDivisor Y),
      ∀ E, E ∈ Ex ↔ RationalMap.IsExceptional f.toRationalMap E := by
  classical
  haveI : IsIntegral Y := hY.1.toIsIntegral
  haveI : LocallyOfFiniteType (f ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : QuasiCompact (f ≫ sX) := hY.1.toQuasiCompact
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (f ≫ sX)
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (f ≫ sX)
  haveI : AlgebraicGeometry.IsNoetherian Y := {}
  have hcoh : ∀ s ∈ (exceptionalSet f : Set Y), Order.coheight s ≠ 0 := by
    intro s hs
    have hs' : s ∈ ((exceptionalSet f ⊔ D.supp.preimage f.continuous : Closeds Y) : Set Y) :=
      Or.inl hs
    rcases hf.isSNCSubset with h | ⟨t, ht, -⟩
    · rw [h] at hs'
      exact hs'.elim
    · rw [← ht] at hs'
      obtain ⟨E, -, hsE⟩ := Set.mem_iUnion₂.1 hs'
      have hle : s ≤ E.genericPoint := by
        rw [Scheme.le_iff_specializes]
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hsE
        exact specializes_iff_mem_closure.2 hsE
      have h1 := Order.coheight_anti hle
      rw [E.coheight_genericPoint] at h1
      intro h0
      rw [h0] at h1
      exact absurd h1 (by norm_num)
  have hfin := finite_setOf_genericPoint_mem (exceptionalSet f).isClosed hcoh
  refine ⟨hfin.toFinset.filter fun E => RationalMap.IsExceptional f.toRationalMap E, fun E => ?_⟩
  rw [Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  exact ⟨fun h => h.2, fun h => ⟨MMP.Positivity.support_subset_exceptionalSet E h
    (MMP.Flips.primeDivisor_genericPoint_mem_support E), h⟩⟩

/-- A prime divisor contained in a finite union of prime divisors is one of them. -/
private theorem mem_of_support_subset_iUnion {Y : Scheme.{0}}
    {s : Finset (MMP.Mori.PrimeDivisor Y)} (P : MMP.Mori.PrimeDivisor Y)
    (h : (P.support : Set Y) ⊆ ⋃ E ∈ s, E.support) : P ∈ s := by
  obtain ⟨E, hE, hle⟩ := exists_mem_of_subset_iUnion (primeIrr P) (by rwa [coe_primeIrr])
  have hmem : P.genericPoint ∈ E.support := by
    have := hle (show P.genericPoint ∈ (primeIrr P : Set Y) by
      rw [coe_primeIrr]; exact MMP.Flips.primeDivisor_genericPoint_mem_support P)
    change P.genericPoint ∈ (primeIrr E : Set Y) at this
    rwa [coe_primeIrr] at this
  have heq := MMP.Mori.PrimeDivisor.eq_genericPoint_of_mem_support E hmem P.coheight_genericPoint
  rwa [AlgebraicGeometry.PrimeDivisor.genericPoint_injective heq]

/-- A closed set containing the generic point of a prime divisor contains its support. -/
private theorem support_subset_of_genericPoint_mem {Y : Scheme.{0}} (P : MMP.Mori.PrimeDivisor Y)
    {C : Set Y} (hC : IsClosed C) (h : P.genericPoint ∈ C) : (P.support : Set Y) ⊆ C := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact closure_minimal (Set.singleton_subset_iff.mpr h) hC

end StrictTransform

/-! ### The boundaries `Γ`, `E` and `Ξ` on the resolution -/

section ClippedBoundary

variable {Y : Scheme.{0}}

/-- **The clipped boundary.** For `lΘ` with coefficient `l` along `T` and `< l` elsewhere, and an
effective `F` not containing `T`, put `Γ = lΘ ∨ 0`, `E = (-lΘ) ∨ 0`, `H = F + E` and
`Ξ = Γ - Γ ∧ H`; then `B = Ξ/l - T` is effective with coefficients `< 1` and none along `T`,
`0 ≤ Ξ ≤ Γ`, and `Ξ`, `H`, `E` have coefficients `l`, `0`, `0` along `T`. -/
private theorem clippedBoundary_facts (T : MMP.Mori.PrimeDivisor Y) {l : ℕ} (hl : 0 < l)
    {lΘ Fμ Γl El Hl Ξl : Divisor Y} (hΓl : Γl = lΘ ⊔ 0) (hEl : El = (-lΘ) ⊔ 0)
    (hHl : Hl = Fμ + El) (hΞl : Ξl = Γl - Γl ⊓ Hl) (hT : lΘ.coeff T = l)
    (hlt : ∀ P, P ≠ T → lΘ.coeff P < l) (hF0 : ∀ P, 0 ≤ Fμ.coeff P) (hFT : Fμ.coeff T = 0) :
    (0 ≤ (l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1)) ∧
      (∀ E, ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl -
        Divisor.toQDivisor (Finsupp.single T 1)).coeff E < 1) ∧
      ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1)).coeff T = 0 ∧
      (∀ P, 0 ≤ Ξl.coeff P) ∧ (∀ P, Ξl.coeff P ≤ Γl.coeff P) ∧ Ξl.coeff T = l ∧
      Hl.coeff T = 0 ∧ El.coeff T = 0 ∧ Γl.coeff T = l ∧ (∀ P, 0 ≤ El.coeff P) := by
  have hlq : (0 : ℚ) < l := by exact_mod_cast hl
  have hΓc : ∀ P, Γl.coeff P = max (lΘ.coeff P) 0 := fun P => by
    rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hEc : ∀ P, El.coeff P = max (-lΘ.coeff P) 0 := fun P => by
    rw [hEl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hHc : ∀ P, Hl.coeff P = Fμ.coeff P + El.coeff P := fun P => by
    rw [hHl]; rfl
  have hΞc : ∀ P, Ξl.coeff P = Γl.coeff P - min (Γl.coeff P) (Hl.coeff P) := fun P => by
    rw [hΞl, DivisorWithCoeffs.coeff_apply, Finsupp.sub_apply, Finsupp.inf_apply]; rfl
  have hE0 : ∀ P, 0 ≤ El.coeff P := fun P => by rw [hEc]; exact le_max_right _ _
  have hET : El.coeff T = 0 := by rw [hEc, hT]; simp
  have hHT : Hl.coeff T = 0 := by rw [hHc, hFT, hET, add_zero]
  have hΓT : Γl.coeff T = l := by rw [hΓc, hT]; simp
  have hΞT : Ξl.coeff T = l := by rw [hΞc, hΓT, hHT]; simp
  have hΞ0 : ∀ P, 0 ≤ Ξl.coeff P := fun P => by
    rw [hΞc]; linarith [min_le_left (Γl.coeff P) (Hl.coeff P)]
  have hΞΓ : ∀ P, Ξl.coeff P ≤ Γl.coeff P := fun P => by
    rw [hΞc]
    have h1 : 0 ≤ Γl.coeff P := by rw [hΓc]; exact le_max_right _ _
    have h2 : 0 ≤ Hl.coeff P := by rw [hHc]; linarith [hF0 P, hE0 P]
    have : 0 ≤ min (Γl.coeff P) (Hl.coeff P) := le_min h1 h2
    linarith
  have hBc : ∀ P, ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl -
      Divisor.toQDivisor (Finsupp.single T 1)).coeff P =
        (l : ℚ)⁻¹ * (Ξl.coeff P : ℚ) - ((Finsupp.single T (1 : ℤ) P : ℤ) : ℚ) := fun P => rfl
  have hBT : ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl -
      Divisor.toQDivisor (Finsupp.single T 1)).coeff T = 0 := by
    rw [hBc, hΞT, Finsupp.single_eq_same]
    push_cast
    rw [inv_mul_cancel₀ hlq.ne', sub_self]
  refine ⟨fun P => ?_, fun P => ?_, hBT, hΞ0, hΞΓ, hΞT, hHT, hET, hΓT, hE0⟩
  · show (0 : ℚ) ≤ DivisorWithCoeffs.coeff _ P
    by_cases hP : P = T
    · subst hP; rw [hBT]
    · rw [hBc, Finsupp.single_eq_of_ne hP]
      have : (0 : ℚ) ≤ Ξl.coeff P := by exact_mod_cast hΞ0 P
      push_cast
      rw [sub_zero]
      positivity
  · by_cases hP : P = T
    · subst hP; rw [hBT]; norm_num
    · rw [hBc, Finsupp.single_eq_of_ne hP]
      have h1 := hΞΓ P
      have h2 : Γl.coeff P < l := by
        rw [hΓc]; exact max_lt (hlt P hP) (by exact_mod_cast hl)
      have h3 : (Ξl.coeff P : ℚ) < l := by exact_mod_cast lt_of_le_of_lt h1 h2
      push_cast
      rw [sub_zero, inv_mul_lt_iff₀ hlq]
      linarith

/-- `lK + Ξ = l(K + T + (Ξ/l - T))` as `ℚ`-divisors. -/
private theorem toQDivisor_zsmul_add_eq {Y : Scheme.{0}} (K Ξ : Divisor Y)
    (T : MMP.Mori.PrimeDivisor Y) {l : ℕ} (hl : (l : ℚ) ≠ 0) :
    Divisor.toQDivisor ((l : ℤ) • K + Ξ) = (l : ℚ) • (Divisor.toQDivisor K +
      Divisor.toQDivisor (Finsupp.single T 1) +
        ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξ - Divisor.toQDivisor (Finsupp.single T 1))) := by
  rw [map_add, map_zsmul, ← Int.cast_smul_eq_zsmul ℚ, smul_add, smul_add, smul_sub, smul_smul,
    mul_inv_cancel₀ hl, one_smul]
  push_cast
  abel

/-- At a strict transform `E` of `Q`, `v_E` seen on `k(X)` through `μ` is `v_Q`. -/
private theorem valuationOver_eq_of_isIso' {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (μ : Y ⟶ X) [IsDominant μ] (E : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : μ E.genericPoint = Q.genericPoint) [IsIso (μ.stalkMap E.genericPoint)] :
    E.valuationOver μ = Q.divisorialValuation := by
  refine Valuation.ext fun t => ?_
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply]
  by_cases ht : t = 0
  · rw [ht, map_zero, map_zero, map_zero]
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
    MMP.Positivity.ord_functionFieldMap_of_isIso μ E Q heq t]

/-- The round-down of an integral `ℚ`-divisor is the divisor itself. -/
private theorem roundDown_toQDivisor' {Y : Scheme.{0}} (D : Divisor Y) :
    DivisorWithCoeffs.roundDown (Divisor.toQDivisor D) = D := by
  ext P
  rw [DivisorWithCoeffs.coeff_roundDown, Divisor.coeff_toQDivisor, Int.floor_intCast]

end ClippedBoundary

/-! ### Pushing sections and restrictions down a resolution -/

section PushDown

/-- The square of stalk maps for `fS ≫ ι = ι' ≫ μ`. -/
private theorem stalkSpecializes_stalkMap_square {X Y T' S' : Scheme.{0}} (μ : Y ⟶ X)
    (ι : S' ⟶ X) (ι' : T' ⟶ Y) (fS : T' ⟶ S') (hfS : fS ≫ ι = ι' ≫ μ) (ηT : T') (ηS : S')
    (h1 : fS ηT ⤳ ηS) (hsp : ι ηS ⤳ μ (ι' ηT)) :
    X.presheaf.stalkSpecializes hsp ≫ ι.stalkMap ηS ≫ S'.presheaf.stalkSpecializes h1 ≫
      fS.stalkMap ηT = μ.stalkMap (ι' ηT) ≫ ι'.stalkMap ηT := by
  rw [← Scheme.Hom.stalkSpecializes_stalkMap_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc,
    ← Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_congr_hom _ _ hfS, Scheme.Hom.stalkMap_comp,
    TopCat.Presheaf.stalkCongr_hom]
  erw [TopCat.Presheaf.stalkSpecializes_comp_assoc, TopCat.Presheaf.stalkSpecializes_refl,
    Category.id_comp]

/-- **Restrictions descend from a strict transform.** If `μ : Y ⟶ X` is an isomorphism at the
generic point of the strict transform `T` of `S`, `fS : T ⟶ S` the induced dominant morphism, and
`g_Y` restricts to `fS^*u` along `T`, then `g_Y = μ^*g` for a `g` restricting to `u` along `S`. -/
private theorem exists_functionFieldMap_eq_and_isRestrictionAlong {X Y : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y]
    (μ : Y ⟶ X) [IsDominant μ] (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y)
    [hTiso : IsIso (μ.stalkMap T.genericPoint)]
    (fS : (haveI := T.integral; T.idealSheaf.subscheme) ⟶
      (haveI := S.integral; S.idealSheaf.subscheme))
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    (hfSd : haveI := S.integral; haveI := T.integral; IsDominant fS)
    (gY : Y.functionField) (u : (haveI := S.integral; S.idealSheaf.subscheme.functionField))
    (hres : haveI := S.integral; haveI := T.integral;
      IsRestrictionAlong T gY (functionFieldMap fS u)) :
    ∃ g : X.functionField, functionFieldMap μ g = gY ∧ IsRestrictionAlong S g u := by
  haveI := S.integral
  haveI := T.integral
  obtain ⟨b, hb1, hb2⟩ := hres
  have hfη : fS (genericPoint T.idealSheaf.subscheme) = genericPoint S.idealSheaf.subscheme :=
    map_genericPoint_of_isDominant fS
  have hp : μ (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)) =
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) := by
    rw [← hfη, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfS]
  have hsp : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ⤳
      μ (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)) := by rw [hp]
  have h1 : fS (genericPoint T.idealSheaf.subscheme) ⤳ genericPoint S.idealSheaf.subscheme := by
    rw [hfη]
  haveI : IsIso (μ.stalkMap (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme))) :=
    hTiso
  obtain ⟨a₀, hμa₀⟩ : ∃ a₀, (μ.stalkMap
      (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme))).hom a₀ = b :=
    ⟨(inv (μ.stalkMap _)).hom b, by
      rw [← CommRingCat.comp_apply, IsIso.inv_hom_id, CommRingCat.id_apply]⟩
  refine ⟨algebraMap _ X.functionField a₀, ?_, (X.presheaf.stalkSpecializes hsp).hom a₀, ?_, ?_⟩
  · rw [MMP.Mori.functionFieldMap_algebraMap_stalk, hμa₀]
    exact hb1
  · exact MMP.Mori.algebraMap_stalkSpecializes hsp a₀
  · apply (functionFieldMap fS).injective
    rw [← hb2, ← hμa₀]
    have hsq := stalkSpecializes_stalkMap_square μ S.idealSheaf.subschemeι T.idealSheaf.subschemeι
      fS hfS (genericPoint T.idealSheaf.subscheme) (genericPoint S.idealSheaf.subscheme) h1 hsp
    have := congrArg (fun φ => φ.hom a₀) hsq
    simp only [CommRingCat.comp_apply] at this
    exact this

/-- **Sections descend along a resolution.** If `μ^*g` is a section of `𝒪_Y(N_Y)` and `N_Y` is
at most `N` at the strict transform of every prime divisor of `X`, then `g` is a section of
`𝒪_X(N)`. -/
private theorem mem_sectionsIn_of_functionFieldMap {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] [IsProper μ]
    (hX : IsNormalVariety k sX) (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    {N : Divisor X} {NY : Divisor Y}
    (hN : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        NY.coeff Q' ≤ N.coeff Q)
    {g : X.functionField} (hg : functionFieldMap μ g ∈ sectionsIn NY) : g ∈ sectionsIn N := by
  intro Q
  obtain ⟨Q', hQ', hiso, -⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hY hμ Q
  haveI := hiso
  have h1 := hg Q'
  rw [← MMP.Mori.PrimeDivisor.valuationOver_apply, valuationOver_eq_of_isIso' μ Q' Q hQ'] at h1
  exact h1.trans (WithZero.exp_le_exp.mpr (hN Q Q' hQ' hiso))

end PushDown

/-! ### A very ample divisor on a projective scheme over an affine base -/

section VeryAmple

/-- **An effective very ample divisor avoiding a prime divisor.** A scheme projective over an
affine base carries an effective divisor `A` not containing a given prime divisor `T` with
`𝒪(A)` very ample over the base. -/
private theorem exists_effective_hasImmersionTwistOver {k : Type} [Field k] {Y Z : Scheme.{0}}
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (hsm : IsSmoothScheme sY) (g : Y ⟶ Z) (hg : IsProjectiveMorphism g) [IsAffine Z]
    (T : MMP.Mori.PrimeDivisor Y) :
    ∃ A₁ : Divisor Y, 0 ≤ A₁ ∧ A₁.coeff T = 0 ∧
      Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver g A₁.divisorialSheaf := by
  have hA₀ : ∃ A₀ : Divisor Y,
      Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver g A₀.divisorialSheaf := by
    obtain ⟨n, i, hi, hcomp⟩ := hg
    have h1 := Stacks.TwistInvertibleOverBase.isInvertibleModule_projectiveSpaceTwistingSheaf n Z
    have h2 : Stacks.Ample.IsInvertibleModule Y ((Scheme.Modules.pullback i).obj
        (Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf n Z)) :=
      Stacks.InvertiblePullback.isInvertibleModule_pullback i _
    obtain ⟨D, ⟨e⟩⟩ := MMP.Mori.exists_divisorialSheaf_iso_of_isInvertible
      ((Scheme.Modules.pullback i).obj
        (Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf n Z))
    exact ⟨D, n, i, inferInstance, hcomp, ⟨e⟩⟩
  obtain ⟨A₀, hA₀⟩ := hA₀
  obtain ⟨σ, hσ0, hσ, hσT⟩ := isNonvanishingAt_of_hasImmersionTwistOver sY g hsm hg hA₀
    T.genericPoint
  refine ⟨A₀ + ffDiv σ hσ0, fun P => coeff_add_ffDiv_nonneg hσ hσ0 P, ?_, ?_⟩
  · by_contra h
    exact hσT (DivisorWithCoeffs.support_subset_supp h
      (MMP.Flips.primeDivisor_genericPoint_mem_support T))
  · obtain ⟨n, i, hi, hcomp, ⟨e⟩⟩ := hA₀
    refine ⟨n, i, hi, hcomp, ⟨?_⟩⟩
    refine (Divisor.divisorialSheafMulIso
      (Units.map (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom (Units.mk0 σ hσ0))
      fun E => ?_) ≪≫ e
    rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor]

/-- **One ample twist for finitely many divisors** (Serre). For an `g`-ample Cartier divisor `A`
and finitely many divisors `N` on a smooth `Y`, some `r > 0` makes every `N + rA` have an
`g`-ample multiple. -/
private theorem exists_pos_forall_hasRelativelyAmpleMultiple_add {k : Type} [Field k]
    {Y Z : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [CompactSpace Z] (hsm : IsSmoothScheme sY) (g : Y ⟶ Z) [QuasiCompact g]
    {A : Divisor Y} (hA : MMP.Flips.IsRelativelyAmpleCartier g A) (s : Finset (Divisor Y)) :
    ∃ r : ℕ, 0 < r ∧ ∀ N ∈ s, (Divisor.toQDivisor N + (r : ℚ) • Divisor.toQDivisor A)
      |>.HasRelativelyAmpleMultiple g := by
  have hev : ∀ N ∈ s, ∀ᶠ r : ℕ in Filter.atTop, MMP.Flips.IsRelativelyAmpleCartier g (r • A + N) :=
    fun N _ => eventually_isRelativelyAmpleCartier_nsmul_add g hA
      (MMP.Fourfold.isCartier_of_isSmoothScheme hsm N)
  obtain ⟨r, hr, hr0⟩ := ((Filter.eventually_all_finset s).2 hev |>.and
    (Filter.eventually_gt_atTop 0)).exists
  refine ⟨r, hr0, fun N hN => ⟨1, one_pos, r • A + N, (hr N hN).choose, ?_,
    isRelativelyAmple_of_isRelativelyAmpleCartier g (hr N hN)⟩⟩
  rw [map_add, map_nsmul, Nat.cast_one, one_smul, add_comm, ← Nat.cast_smul_eq_nsmul ℚ]

end VeryAmple

/-! ### The general member -/

section General

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Adding a general very ample member preserves plt.** For a general member
`H = H₀ + div(∑ tᵢ sᵢ)` of the system of a relatively very ample `H₀`, if `(X, S + B)` is plt
with `⌊S + B⌋ = S`, then so is `(X, S + B + τH)`, with `⌊S + B + τH⌋ = S`, for every rational
`0 ≤ τ < 1`. -/
private theorem exists_polynomial_isPltPair_add_smul (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (B : QDivisor X) (hBS : B.coeff S = 0) (H₀ : Divisor X)
    (hH₀ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f H₀.divisorialSheaf)
    (N : ℕ) (s : Fin N → X.functionField) (hs : ∀ i, s i ∈ sectionsIn H₀)
    (hgen : ∀ g ∈ sectionsIn H₀, ∀ x : X, ∃ r : Fin N → X.presheaf.stalk x,
      g = ∑ i, (X.presheaf.stalkSpecializes (genericPoint_specializes x)).hom (r i) * s i) :
    ∃ Q : MvPolynomial (Fin N) k, Q ≠ 0 ∧ ∀ t : Fin N → k, MvPolynomial.eval t Q ≠ 0 →
      ∃ hg : (∑ i, baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom (t i)) * s i) ≠ 0,
        ∀ τ : ℚ, 0 ≤ τ → τ < 1 →
          DivisorWithCoeffs.roundDown (Divisor.toQDivisor (Finsupp.single S 1) + B) =
            Finsupp.single S 1 →
          IsPltPair sX n KX (Divisor.toQDivisor (Finsupp.single S 1) + B) →
          IsPltPair sX n KX (Divisor.toQDivisor (Finsupp.single S 1) + B + τ • Divisor.toQDivisor
            (H₀ + MMP.Mori.principalDivisor
              (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
                (Units.mk0 _ hg)))) ∧
          DivisorWithCoeffs.roundDown (Divisor.toQDivisor (Finsupp.single S 1) + B +
            τ • Divisor.toQDivisor (H₀ + MMP.Mori.principalDivisor
              (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
                (Units.mk0 _ hg)))) = Finsupp.single S 1 := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  set Δ₀ : QDivisor X := Divisor.toQDivisor (Finsupp.single S 1) + B with hΔ₀
  -- a log resolution of `(X, S + B)` and its snc divisor
  obtain ⟨Y, μ, hlog, -⟩ := MMP.Mori.exists_isLogResolution_isProjectiveMorphism sX hX
    (QDivisor.toRDivisor Δ₀)
  have hres := hlog.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : IsProper μ := hres.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨Bs, hBs, hBsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hmemBs : ∀ G : MMP.Mori.PrimeDivisor Y, G.genericPoint ∈ ((exceptionalSet μ ⊔
      (QDivisor.toRDivisor Δ₀).supp.preimage μ.continuous : Closeds Y) : Set Y) → G ∈ Bs := by
    intro G hG
    rw [← hBs] at hG
    obtain ⟨E, hE, hGE⟩ := Set.mem_iUnion₂.mp hG
    rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hGE]
  -- the sections `sᵢ` as sections of `𝒪_X(H₀)`
  set eX := rationalFunctionsEquivFunctionField X with heX
  let φs : Fin N → ToType ((rationalFunctionsPresheaf X).obj (Opposite.op ⊤)) := fun i Z =>
    eX.symm (s i) Z.1
  have hsec : ∀ i, H₀.IsDivisorialSection ⊤ (φs i) := by
    intro i E _
    change E.OrdGE (-H₀.coeff E) (eX.symm (s i) E.component)
    by_cases h0 : s i = 0
    · rw [h0, map_zero]
      exact MMP.Mori.PrimeDivisor.OrdGE.zero _
    rw [ordGE_symm_iff E _ h0]
    have := ord_add_coeff_nonneg (hs i) h0 E
    omega
  let s' : Fin N → H₀.divisorialSubmodule ⊤ := fun i => ⟨φs i, hsec i⟩
  have hs'rat : ∀ i, Divisor.sectionToRationalFunctions (s' i) = eX.symm (s i) := fun i => rfl
  have hH₀c : H₀.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs H₀
  -- the sections have no common zero
  have hfree : ∀ x : X, ∃ i, s i ≠ 0 ∧ ∃ hi : s' i ≠ 0, x ∉ (H₀.zeroDivisor (s' i) hi).supp := by
    intro x
    obtain ⟨g, hg0, hgs, hgx⟩ := isNonvanishingAt_of_hasImmersionTwistOver sX f hXs hf hH₀ x
    obtain ⟨r, hr⟩ := hgen g hgs x
    obtain ⟨U, hxU, φ, hφ⟩ := hH₀c x
    set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
    set ψf := MMP.Threefold.Mori.Helpers.evalFF Z₀ (φ : MMP.Mori.RationalFunctions X) with hψf
    have hψ0 : ψf ≠ 0 := evalFF_ne_zero Z₀ φ
    have hordψ : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
        X.ord ψf Γ.genericPoint = H₀.coeff Γ :=
      fun Γ hΓ => ord_evalFF_of_isLocalEquation hφ Z₀ Γ ⟨x, hΓ, hxU⟩
    have hreg : ∀ i, ∃ a : X.presheaf.stalk x, algebraMap _ X.functionField a = s i * ψf := by
      intro i
      rcases eq_or_ne (s i) 0 with h0 | h0
      · exact ⟨0, by rw [map_zero, h0, zero_mul]⟩
      · refine MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x
          (mul_ne_zero h0 hψ0) fun Γ hΓ => ?_
        rw [Scheme.ord_mul h0 hψ0, hordψ Γ hΓ]
        exact ord_add_coeff_nonneg (hs i) h0 Γ
    choose a ha using hreg
    have hg0' : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
        X.ord (g * ψf) Γ.genericPoint = 0 := by
      intro Γ hΓ
      rw [Scheme.ord_mul hg0 hψ0, hordψ Γ hΓ]
      have h1 : (H₀ + ffDiv g hg0).coeff Γ = 0 := by
        by_contra hne
        exact hgx (DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ, hne, hΓ⟩)
      rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
      omega
    obtain ⟨b, hbU, hb⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero x
      (mul_ne_zero hg0 hψ0) hg0'
    have hsum : ∑ i, r i * a i = b := by
      apply IsFractionRing.injective (X.presheaf.stalk x) X.functionField
      rw [hb, map_sum, hr, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, ha i, mul_assoc]
      rfl
    obtain ⟨i, -, hiu⟩ := exists_isUnit_of_sum_mul_eq_one Finset.univ
      (fun i => r i * ↑hbU.unit⁻¹) a (by
        calc ∑ i, r i * ↑hbU.unit⁻¹ * a i = (∑ i, r i * a i) * ↑hbU.unit⁻¹ := by
              rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun i _ => by ring
          _ = 1 := by rw [hsum, IsUnit.mul_val_inv])
    have hsi0 : s i ≠ 0 := by
      intro h0
      have h1 := ha i
      rw [h0, zero_mul] at h1
      exact hiu.ne_zero (IsFractionRing.injective _ X.functionField (by rw [h1, map_zero]))
    have hti : s' i ≠ 0 := fun h => hsi0 (eX.symm.injective (by
      rw [← hs'rat, h, map_zero]; exact map_zero (rationalFunctionsPresheafTopEquiv X)))
    refine ⟨i, hsi0, hti, fun hmem => ?_⟩
    obtain ⟨P, hP0, hxP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    rw [coeff_zeroDivisor H₀ (s' i) hti (hs'rat i) P] at hP0
    have h1 := ord_algebraMap_eq_zero_of_isUnit P hxP hiu
    rw [ha i, Scheme.ord_mul hsi0 hψ0, hordψ P hxP] at h1
    exact hP0 (by omega)
  -- a general member is nonzero
  obtain ⟨j, hj, -⟩ := hfree (genericPoint X)
  obtain ⟨Q₁, hQ₁0, hQ₁⟩ := exists_polynomial_notMem_supp sX hH₀c s hs (genericPoint X) j hj
    (MMP.Fourfold.genericPoint_notMem_supp _)
  -- Bertini on the log resolution
  obtain ⟨Q₂, hQ₂0, hQ₂⟩ := MMP.Mori.exists_polynomial_pullback_zeroDivisor_eq_sum_isSNC hX.1 hres
    s' (fun x => by obtain ⟨i, -, hi, hx⟩ := hfree x; exact ⟨i, hi, hx⟩) Bs hBsnc
  refine ⟨Q₁ * Q₂, mul_ne_zero hQ₁0 hQ₂0, fun t ht => ?_⟩
  rw [map_mul] at ht
  obtain ⟨hg, -⟩ := hQ₁ t (left_ne_zero_of_mul ht)
  refine ⟨hg, fun τ hτ0 hτ1 hfloor₀ hplt₀ => ?_⟩
  set g := ∑ i, baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom (t i)) * s i with hgdef
  set σ := ∑ i, scalarsToGlobalSections k sX (t i) • s' i with hσdef
  have hrat_smul : ∀ (r : Γ(X, ⊤)) (σ' : H₀.divisorialSubmodule ⊤),
      Divisor.sectionToRationalFunctions (r • σ') =
        eX.symm (X.presheaf.germ ⊤ (genericPoint X) trivial r) *
          Divisor.sectionToRationalFunctions σ' := fun r σ' => by
    funext Z
    rw [Pi.mul_apply, germ_eq_rationalFunctionsEquivFunctionField_symm ⊤ r trivial Z trivial]
    rfl
  have hσrat : Divisor.sectionToRationalFunctions σ = eX.symm g := by
    change rationalFunctionsPresheafTopEquiv X σ.1 = _
    rw [hσdef, Submodule.coe_sum, map_sum]
    change ∑ i, Divisor.sectionToRationalFunctions
      (scalarsToGlobalSections k sX (t i) • s' i) = _
    simp only [hrat_smul, hs'rat]
    rw [hgdef, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [map_mul]; rfl
  have hσ : σ ≠ 0 := fun h => hg (eX.symm.injective (by
    rw [← hσrat, h, map_zero]; exact map_zero (rationalFunctionsPresheafTopEquiv X)))
  set H : Divisor X := H₀ + MMP.Mori.principalDivisor
    (Units.map eX.symm.toMonoidHom (Units.mk0 g hg)) with hH
  have hHz : H₀.zeroDivisor σ hσ = H := by
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
      coeff_zeroDivisor H₀ σ hσ hσrat P, hH, DivisorWithCoeffs.coeff_add,
      MMP.Mori.coeff_principalDivisor_mk0]
    ring
  have hHc : H.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs H
  have hBH := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ
    (H₀.zeroDivisor σ hσ)
  obtain ⟨H', hH'⟩ :=
    (MMP.Fourfold.isCartier_of_isSmoothScheme hXs (H₀.zeroDivisor σ hσ)).exists_isPullback hBH
  obtain ⟨T, hT, hTB, hTBsnc, -⟩ := hQ₂ t (right_ne_zero_of_mul ht) hσ hBH H' hH'
  obtain ⟨hBH', hH'H⟩ : ∃ hB, H.IsPullback μ hB H' := hHz ▸ ⟨hBH, hH'⟩
  have hH'c : ∀ G, H'.coeff G = if G ∈ T then 1 else 0 := fun G => by
    rw [hT, coeff_sum_single_one]
  -- the coefficients of `Δ₀`
  have hΔ₀S : Δ₀.coeff S = 1 := by
    rw [hΔ₀, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor,
      DivisorWithCoeffs.coeff_single_self, hBS]
    norm_num
  have hΔ₀lt : ∀ Q, Q ≠ S → Δ₀.coeff Q < 1 := by
    intro Q hQ
    have h0 := congrArg (fun D : Divisor X => D Q) hfloor₀
    rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_roundDown,
      Finsupp.single_eq_of_ne hQ, Int.floor_eq_zero_iff] at h0
    exact h0.2
  have hBsupp : ∀ (G : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X),
      μ G.genericPoint = Q.genericPoint → Δ₀.coeff Q ≠ 0 → G ∈ Bs := by
    intro G Q hGQ hne
    refine hmemBs G (Or.inr ?_)
    change μ G.genericPoint ∈ (QDivisor.toRDivisor Δ₀).supp
    rw [hGQ]
    exact DivisorWithCoeffs.support_subset_supp (by
      rw [QDivisor.coeff_toRDivisor]; exact_mod_cast hne)
      (MMP.Flips.primeDivisor_genericPoint_mem_support Q)
  -- the round-down
  have hHval : ∀ P : MMP.Mori.PrimeDivisor X,
      H.coeff P = 0 ∨ (H.coeff P = 1 ∧ Δ₀.coeff P = 0) := by
    intro P
    obtain ⟨P', hP'eq, hiso, -⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hY hμ P
    haveI := hiso
    have h1 := MMP.Positivity.coeff_eq_of_isPullback P' P hP'eq hHc hH'H
    rw [hH'c] at h1
    by_cases hP'T : P' ∈ T
    · rw [if_pos hP'T] at h1
      refine Or.inr ⟨h1.symm, ?_⟩
      by_contra hne
      exact Finset.disjoint_left.mp hTB hP'T (hBsupp P' P hP'eq hne)
    · rw [if_neg hP'T] at h1
      exact Or.inl h1.symm
  have hround : DivisorWithCoeffs.roundDown (Δ₀ + τ • Divisor.toQDivisor H) =
      Finsupp.single S 1 := by
    refine Finsupp.ext fun P => ?_
    have h0 := congrArg (fun D : Divisor X => D P) hfloor₀
    rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_roundDown] at h0 ⊢
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
      smul_eq_mul]
    rcases hHval P with h | ⟨h1, h2⟩
    · rw [h]; simpa using h0
    · rw [h2, Int.floor_zero] at h0
      rw [h1, h2, ← h0]
      push_cast
      rw [zero_add, mul_one, Int.floor_eq_zero_iff]
      exact ⟨hτ0, hτ1⟩
  refine ⟨?_, hround⟩
  -- plt: the crepant boundary on `Y` is snc with coefficients `≤ 1`, one of them equal to `1`
  have hΔ' : MMP.Mori.IsPairWith sX n KX (Δ₀ + τ • Divisor.toQDivisor H) :=
    ⟨hX, hKX, MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _⟩
  refine ⟨hΔ', ?_⟩
  have hdimY : topologicalKrullDim Y = n := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ]
    exact hKX.topologicalKrullDim_eq
  obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hdimY
  obtain ⟨⟨Γ₀, hΓ₀, -⟩, -⟩ :=
    MMP.Mori.IsPair.existsUnique_isCrepantBoundary hplt₀.1.isPair hKX μ hY hμ
  obtain ⟨⟨Γ', hΓ', -⟩, -⟩ := MMP.Mori.IsPair.existsUnique_isCrepantBoundary hΔ'.isPair hKX μ hY hμ
  have hHq : (Divisor.toQDivisor H).IsQCartier := MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _
  have hΓ'c : ∀ G : MMP.Mori.PrimeDivisor Y,
      Γ'.coeff G = Γ₀.coeff G + τ * (if G ∈ T then 1 else 0) := by
    intro G
    obtain ⟨-, hB, hall⟩ := MMP.Mori.IsPairWith.isDiscrepancy_add_smul_iff hplt₀.1 hHq
      (⟨Y, μ, hY, hμ, G⟩ : DivisorOver k sX)
    have hBQ := MMP.Mori.QDivisor.isPullback_toQDivisor hHc hB hH'H
    have h1 := ((hall _ hBQ).2 τ (-Γ₀.coeff G)).mpr (hΓ₀ G)
    have h2 := (hΓ' G).eq h1
    change -Γ'.coeff G = -Γ₀.coeff G - τ * (Divisor.toQDivisor H').coeff G at h2
    rw [Divisor.coeff_toQDivisor, hH'c] at h2
    split_ifs at h2 ⊢ <;> push_cast at h2 <;> linarith
  have hΓ₀exc : ∀ G, (⟨Y, μ, hY, hμ, G⟩ : DivisorOver k sX).IsExceptional →
      Γ₀.coeff G < 1 ∧ G ∈ Bs := by
    intro G hG
    refine ⟨?_, hmemBs G (Or.inl (MMP.Positivity.support_subset_exceptionalSet G hG
      (MMP.Flips.primeDivisor_genericPoint_mem_support G)))⟩
    have h1 := lt_of_lt_of_le hplt₀.2 (MMP.Mori.discrep_le hG (hΓ₀ G))
    have h2 : ((-1 : ℝ) : EReal) < (((-Γ₀.coeff G : ℚ) : ℝ) : EReal) := by simpa using h1
    have h3 := EReal.coe_lt_coe_iff.mp h2
    have h4 : (-1 : ℚ) < -Γ₀.coeff G := by exact_mod_cast h3
    linarith
  -- the three facts on `Γ'`
  have hfacts : ∀ G : MMP.Mori.PrimeDivisor Y, Γ'.coeff G ≤ 1 ∧
      (Γ'.coeff G = 1 → μ G.genericPoint = S.genericPoint ∧
        inverseTransformPrimeDivisor μ S = some G) ∧
      (Γ'.coeff G ≠ 0 → G ∈ T ∪ Bs) := by
    intro G
    rw [hΓ'c]
    by_cases hGe : (⟨Y, μ, hY, hμ, G⟩ : DivisorOver k sX).IsExceptional
    · obtain ⟨h1, h2⟩ := hΓ₀exc G hGe
      have hGT : G ∉ T := fun h => Finset.disjoint_left.mp hTB h h2
      rw [if_neg hGT, mul_zero, add_zero]
      exact ⟨h1.le, fun h => absurd h h1.ne, fun _ => Finset.mem_union_right _ h2⟩
    · obtain ⟨Q, hc, hηQ, hiQ⟩ := MMP.Mori.exists_coeff_eq_of_not_isExceptional hplt₀.1 hY hμ hΓ₀ hGe
      rw [hc]
      by_cases hGT : G ∈ T
      · have hQ0 : Δ₀.coeff Q = 0 := by
          by_contra hne
          exact Finset.disjoint_left.mp hTB hGT (hBsupp G Q hηQ hne)
        rw [if_pos hGT, hQ0, zero_add, mul_one]
        exact ⟨hτ1.le, fun h => absurd h hτ1.ne, fun _ => Finset.mem_union_left _ hGT⟩
      · rw [if_neg hGT, mul_zero, add_zero]
        by_cases hQS : Q = S
        · subst hQS
          exact ⟨hΔ₀S.le, fun _ => ⟨hηQ, hiQ⟩, fun h => Finset.mem_union_right _
            (hBsupp G Q hηQ h)⟩
        · have hlt := hΔ₀lt Q hQS
          exact ⟨hlt.le, fun h => absurd h hlt.ne, fun h => Finset.mem_union_right _
            (hBsupp G Q hηQ h)⟩
  have hc1 : ∀ G, Γ'.coeff G ≤ 1 := fun G => (hfacts G).1
  have huniq : ∀ E F : MMP.Mori.PrimeDivisor Y, Γ'.coeff E = 1 → Γ'.coeff F = 1 → E = F := by
    intro E F hE hF
    exact Option.some.inj (((hfacts E).2.1 hE).2.symm.trans ((hfacts F).2.1 hF).2)
  obtain ⟨δ, hδ0, hδ1, hδ⟩ : ∃ δ : ℚ, 0 < δ ∧ δ ≤ 1 ∧
      ∀ G ∈ T ∪ Bs, Γ'.coeff G < 1 → δ ≤ 1 - Γ'.coeff G := by
    set U := (T ∪ Bs).filter (fun G => Γ'.coeff G < 1) with hU
    rcases U.eq_empty_or_nonempty with hU0 | hUne
    · refine ⟨1, one_pos, le_rfl, fun G hG hlt => ?_⟩
      have : G ∈ U := Finset.mem_filter.mpr ⟨hG, hlt⟩
      rw [hU0] at this
      exact absurd this (Finset.notMem_empty G)
    · obtain ⟨G₀, hG₀, hmin⟩ := Finset.exists_min_image U (fun G => 1 - Γ'.coeff G) hUne
      have h1 := (Finset.mem_filter.mp hG₀).2
      exact ⟨min 1 (1 - Γ'.coeff G₀), lt_min one_pos (by linarith), min_le_left _ _,
        fun G hG hlt => (min_le_right _ _).trans (hmin G (Finset.mem_filter.mpr ⟨hG, hlt⟩))⟩
  have hsuppΓ' : Γ'.support ⊆ T ∪ Bs := fun G hG =>
    (hfacts G).2.2 (Finsupp.mem_support_iff.mp hG)
  have hbound := MMP.Mori.le_discrep_of_isSNC hY hsmY hKY hsuppΓ' hTBsnc (fun G _ => hc1 G)
  have hYb : (((-1 + δ : ℚ) : ℝ) : EReal) ≤ MMP.Mori.discrep (μ ≫ sX) n KY Γ' := by
    refine le_trans ?_ hbound
    refine le_inf (le_inf ?_ ?_) ?_
    · refine le_iInf₂ fun E hE => le_iInf₂ fun F hF => le_iInf₂ fun hEF _ => ?_
      refine EReal.coe_le_coe_iff.mpr ?_
      have key : (-1 + δ : ℚ) ≤ 1 - Γ'.coeff E - Γ'.coeff F := by
        by_cases hE1 : Γ'.coeff E = 1
        · have hF1 : Γ'.coeff F < 1 := lt_of_le_of_ne (hc1 F) fun hF1 =>
            hEF (huniq E F hE1 hF1)
          have := hδ F hF hF1
          linarith
        · have hE1' := lt_of_le_of_ne (hc1 E) hE1
          have := hδ E hE hE1'
          have := hc1 F
          linarith
      exact_mod_cast key
    · refine le_iInf₂ fun E _ => EReal.coe_le_coe_iff.mpr ?_
      have key : (-1 + δ : ℚ) ≤ 1 - Γ'.coeff E := by linarith [hc1 E]
      exact_mod_cast key
    · have hδ1' : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ1
      have key : ((-1 + δ : ℚ) : ℝ) ≤ 1 := by push_cast; linarith
      exact_mod_cast key
  have hPY : MMP.Mori.IsPairWith (μ ≫ sX) n KY Γ' :=
    ⟨hY, hKY, MMP.Fourfold.isQCartier_of_isSmoothScheme hsmY _⟩
  have hX0 : (((-1 + δ : ℚ) : ℝ) : EReal) ≤
      MMP.Mori.discrep sX n KX (Δ₀ + τ • Divisor.toQDivisor H) := by
    refine MMP.Mori.le_discrep_iff.mpr fun D a hD ha => ?_
    obtain ⟨-, hcr⟩ := MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hΔ'.isPair μ hY hμ hKX hKY
      (Or.inl hΓ')
    obtain ⟨E, hE⟩ := MMP.Mori.exists_divisorOver_comap_eq hY hμ D
    have hEa := (hcr E D hE a).mpr ha
    by_cases hEx : E.IsExceptional
    · exact hYb.trans (MMP.Mori.discrep_le hEx hEa)
    · obtain ⟨G, hGv⟩ :=
        MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hY E hEx
      obtain ⟨c', hc'⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPY.isPair hKY
        (DivisorOver.ofPrimeDivisor k hY G)
      have hc'eq := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hY hc'
      have haeq := MMP.Threefold.Mori.isDiscrepancy_eq_of_valuation_eq hPY hGv hEa hc'
      rw [haeq, hc'eq]
      refine EReal.coe_le_coe_iff.mpr ?_
      have key : (-1 + δ : ℚ) ≤ -Γ'.coeff G := by
        by_cases hG1 : Γ'.coeff G = 1
        · exfalso
          obtain ⟨hηG, -⟩ := (hfacts G).2.1 hG1
          haveI : IsIso (μ.stalkMap G.genericPoint) := MMP.isIso_stalkMap_of_mem_biregularLocus μ
            (hηG ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus μ hμ S)
          have hvS : D.valuation = (DivisorOver.ofPrimeDivisor k hX S).valuation := by
            refine Valuation.ext fun u => ?_
            rw [hE, valuation_ofPrimeDivisor, Valuation.comap_apply, hGv,
              valuation_ofPrimeDivisor, ← MMP.Mori.PrimeDivisor.valuationOver_apply,
              valuationOver_eq_of_isIso' μ G S hηG]
          have hη := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX.1 hvS
          have h2 := (MMP.Mori.DivisorOver.isExceptional_iff_two_le_coheight hX D).mp hD
          rw [hη] at h2
          change 2 ≤ Order.coheight S.genericPoint at h2
          rw [S.coheight_genericPoint] at h2
          exact absurd h2 (by decide)
        · by_cases hG0 : Γ'.coeff G = 0
          · rw [hG0]; linarith
          · have := hδ G ((hfacts G).2.2 hG0) (lt_of_le_of_ne (hc1 G) hG1)
            linarith
      exact_mod_cast key
  have hδ0' : (0 : ℝ) < δ := by exact_mod_cast hδ0
  have hlt : ((-1 : ℝ) : EReal) < (((-1 + δ : ℚ) : ℝ) : EReal) :=
    EReal.coe_lt_coe_iff.mpr (by push_cast; linarith)
  exact lt_of_lt_of_le (by simpa using hlt) hX0

end General

/-! ### Restriction to the strict transform and the comparison of sections -/

/-- **Restriction commutes with pull-back.** If `h` is the restriction of `g` along `S`, then
`fS^*h` is the restriction of `μ^*g` along the strict transform `T`, where
`fS ≫ ι_S = ι_T ≫ μ`. -/
private theorem isRestrictionAlong_functionFieldMap {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] (μ : Y ⟶ X) [IsDominant μ] (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y)
    (fS : (haveI := T.integral; T.idealSheaf.subscheme) ⟶
      (haveI := S.integral; S.idealSheaf.subscheme))
    (hfSd : haveI := S.integral; haveI := T.integral; IsDominant fS)
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    {g : X.functionField} {h : (haveI := S.integral; S.idealSheaf.subscheme.functionField)}
    (hres : IsRestrictionAlong S g h) :
    haveI := S.integral; haveI := T.integral
    IsRestrictionAlong T (functionFieldMap μ g) (functionFieldMap fS h) := by
  haveI := S.integral
  haveI := T.integral
  obtain ⟨a, ha1, ha2⟩ := hres
  have hfη : fS (genericPoint T.idealSheaf.subscheme) = genericPoint S.idealSheaf.subscheme :=
    map_genericPoint_of_isDominant fS
  have hp : μ (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)) =
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) := by
    rw [← hfη, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfS]
  have hsp : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ⤳
      μ (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)) := by rw [hp]
  have hsp' : μ (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)) ⤳
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) := by rw [hp]
  have h1 : fS (genericPoint T.idealSheaf.subscheme) ⤳ genericPoint S.idealSheaf.subscheme := by
    rw [hfη]
  set a' := (X.presheaf.stalkSpecializes hsp').hom a with ha'
  have haa : (X.presheaf.stalkSpecializes hsp).hom a' = a := by
    rw [ha', ← CommRingCat.comp_apply, TopCat.Presheaf.stalkSpecializes_comp,
      TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.id_apply]
  refine ⟨(μ.stalkMap _).hom a', ?_, ?_⟩
  · change algebraMap _ Y.functionField _ = _
    rw [← MMP.Mori.functionFieldMap_algebraMap_stalk, ← MMP.Mori.algebraMap_stalkSpecializes hsp a',
      haa, ← ha1]
    rfl
  · have hsq := stalkSpecializes_stalkMap_square μ S.idealSheaf.subschemeι
      T.idealSheaf.subschemeι fS hfS (genericPoint T.idealSheaf.subscheme)
      (genericPoint S.idealSheaf.subscheme) h1 hsp
    have := congrArg (fun φ => φ.hom a') hsq
    simp only [CommRingCat.comp_apply] at this
    rw [← this, haa, ha2]
    rfl

/-- **Restriction of a local equation.** On a smooth variety `Z`, let `W` be a smooth prime
divisor, `D` a divisor without component `W`, and `φ` a rational function whose restriction `ψ`
to `W` is nonzero. If `D = div φ` near the image of the generic point of a prime divisor `Q` of
`W`, then the coefficient of `Q` in `D|_W` is `v_Q(ψ)`. -/
private theorem coeff_restrictPrimeDivisor_eq_ord' {k : Type} [Field k] {Z : Scheme.{0}}
    (sZ : Z ⟶ Spec (.of k)) [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z]
    [NoetherianSpace Z] [Smooth sZ]
    (W : MMP.Mori.PrimeDivisor Z)
    [IsLocallyNoetherian (haveI := W.integral; W.idealSheaf.subscheme)]
    [Smooth (haveI := W.integral; W.idealSheaf.subschemeι ≫ sZ)]
    {D : Divisor Z} (hD : D.coeff W = 0) (φ : Z.functionField)
    (ψ : (haveI := W.integral; W.idealSheaf.subscheme.functionField))
    (hψ : ψ ≠ 0) (hres : IsRestrictionAlong W φ ψ)
    (Q : MMP.Mori.PrimeDivisor (haveI := W.integral; W.idealSheaf.subscheme))
    (hloc : ∀ E : MMP.Mori.PrimeDivisor Z,
      W.idealSheaf.subschemeι Q.genericPoint ∈ E.support → D.coeff E = Z.ord φ E.genericPoint) :
    haveI := W.integral
    (D.restrictPrimeDivisor W).coeff Q = W.idealSheaf.subscheme.ord ψ Q.genericPoint := by
  haveI := W.integral
  classical
  set ι := W.idealSheaf.subschemeι with hι
  have hgen : genericPoint W.idealSheaf.subscheme ⤳ Q.genericPoint :=
    (genericPoint_spec _).specializes trivial
  have hsp : ι (genericPoint _) ⤳ ι Q.genericPoint := hgen.map ι.continuous
  obtain ⟨a, ha1, ha2⟩ := hres
  obtain ⟨q, hq⟩ : ∃ q, Z.fromSpecStalk (ι Q.genericPoint) q = ι (genericPoint _) := by
    have : ι (genericPoint _) ∈ Set.range (Z.fromSpecStalk (ι Q.genericPoint)) := by
      rw [Scheme.range_fromSpecStalk]; exact hsp
    exact this
  letI := (Z.presheaf.stalkSpecializes hsp).hom.toAlgebra
  have hloc' := Stacks.Chow.isLocalization_stalk_of_specializes hsp q hq
  obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective q.asIdeal.primeCompl a
  have hspa := IsLocalization.mk'_spec (Z.presheaf.stalk (ι (genericPoint _))) r s
  change IsLocalization.mk' _ r s = a at hrs
  rw [hrs] at hspa
  set sp := (Z.presheaf.stalkSpecializes hsp).hom with hsp_def
  have hspa' : a * sp (s : Z.presheaf.stalk (ι Q.genericPoint)) = sp r := hspa
  have haU : IsUnit a := by
    have : IsUnit ((ι.stalkMap (genericPoint _)).hom a) := by
      rw [ha2]; exact hψ.isUnit
    exact isUnit_of_map_unit _ _ this
  have hsU : IsUnit (sp (s : Z.presheaf.stalk (ι Q.genericPoint))) :=
    IsLocalization.map_units _ s
  have hrU : IsUnit (sp r) := hspa' ▸ haU.mul hsU
  -- the images on `W`
  have hsq : ∀ t, algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
      W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom t) =
        (ι.stalkMap (genericPoint _)).hom (sp t) := fun t => by
    rw [hsp_def, Scheme.Hom.stalkSpecializes_stalkMap_apply ι _ _ hgen]
    rfl
  have hW0 : ∀ t, IsUnit (sp t) → (ι.stalkMap Q.genericPoint).hom t ≠ 0 := fun t ht h0 => by
    have h1 := hsq t
    rw [h0, map_zero] at h1
    exact (ht.map (ι.stalkMap (genericPoint _)).hom).ne_zero h1.symm
  have hWne : ∀ t, IsUnit (sp t) → algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
      W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom t) ≠ 0 := fun t ht => by
    rw [hsq]; exact (ht.map (ι.stalkMap (genericPoint _)).hom).ne_zero
  have hψrs : ψ * algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
      W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom s) =
      algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
      W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom r) := by
    rw [hsq, hsq, ← ha2, ← map_mul, hspa']
  -- the images on `Z`
  have hZ : ∀ t, algebraMap (Z.presheaf.stalk (ι Q.genericPoint)) Z.functionField t =
      algebraMap (Z.presheaf.stalk (ι (genericPoint _))) Z.functionField (sp t) := fun t =>
    (MMP.Mori.algebraMap_stalkSpecializes hsp t).symm
  have hφrs : φ * algebraMap (Z.presheaf.stalk (ι Q.genericPoint)) Z.functionField s =
      algebraMap (Z.presheaf.stalk (ι Q.genericPoint)) Z.functionField r := by
    rw [hZ, hZ, ← hspa', map_mul, ← ha1]
    rfl
  have hZne : ∀ t, IsUnit (sp t) →
      algebraMap (Z.presheaf.stalk (ι Q.genericPoint)) Z.functionField t ≠ 0 := fun t ht => by
    rw [hZ]
    exact (ht.map _).ne_zero
  have hφ0 : φ ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hφrs
    exact hZne r hrU hφrs.symm
  obtain ⟨S0r, -, hSr⟩ :=
    MMP.Mori.PrimeDivisor.ord_stalkMap_eq_sum_intersectionLength_mul_ord sZ ι Q r (hW0 r hrU)
  obtain ⟨S0s, -, hSs⟩ :=
    MMP.Mori.PrimeDivisor.ord_stalkMap_eq_sum_intersectionLength_mul_ord sZ ι Q s (hW0 s hsU)
  set S := S0r ∪ S0s ∪ D.support with hS
  have e1 := hSr S (fun x hx => by simp [hS, hx])
  have e2 := hSs S (fun x hx => by simp [hS, hx])
  have hψord : W.idealSheaf.subscheme.ord ψ Q.genericPoint =
      W.idealSheaf.subscheme.ord (algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
        W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom r)) Q.genericPoint -
      W.idealSheaf.subscheme.ord (algebraMap (W.idealSheaf.subscheme.presheaf.stalk Q.genericPoint)
        W.idealSheaf.subscheme.functionField ((ι.stalkMap Q.genericPoint).hom s)) Q.genericPoint := by
    rw [← hψrs, Scheme.ord_mul hψ (hWne s hsU)]
    ring
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D W hD Q,
    Finsupp.sum_of_support_subset D (fun x hx => Finset.mem_union_right _ hx) _ (fun _ _ => smul_zero _),
    hψord, e1, e2, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  split_ifs with hE
  · have h1 := congrArg (fun t => Z.ord t E.genericPoint) hφrs
    rw [Scheme.ord_mul hφ0 (hZne s hsU)] at h1
    rw [show D E = Z.ord φ E.genericPoint from hloc E hE, nsmul_eq_mul, ← mul_sub, ← h1]
    ring
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem ι E hE, zero_smul]
    ring

/-- **A local equation restricts.** On a smooth variety `X` with a smooth prime divisor `S`, a
local equation `φ` on `U` of a divisor `N` without component `S` restricts to a nonzero rational
function `ψ` on `S`, which is a local equation of `N|_S` on `ι_S⁻¹(U)`. -/
private theorem exists_isLocalEquation_restrictPrimeDivisor {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [NoetherianSpace X] [Smooth sX] (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [Smooth (haveI := S.integral; S.idealSheaf.subschemeι ≫ sX)]
    {N : Divisor X} (hNS : N.coeff S = 0) {U : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : N.IsLocalEquation U φ) (hSU : (S.support ∩ U).Nonempty) :
    haveI := S.integral
    ∃ ψ : S.idealSheaf.subscheme.functionField, ∃ hψ : ψ ≠ 0,
      IsRestrictionAlong S (rationalFunctionsEquivFunctionField X φ) ψ ∧
      Divisor.IsLocalEquation (N.restrictPrimeDivisor S) (S.idealSheaf.subschemeι ⁻¹ᵁ U)
        (Units.map (rationalFunctionsEquivFunctionField _).symm.toMonoidHom (Units.mk0 ψ hψ)) := by
  haveI := S.integral
  set g := rationalFunctionsEquivFunctionField X φ with hg
  have hg0 : g ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hordS : X.ord g S.genericPoint = 0 := by
    rw [← MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, ← hφ S hSU, hNS]
  have hη : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) = S.genericPoint := rfl
  obtain ⟨a, haU, ha⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero
    (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) hg0 fun Γ hΓ => by
      rw [hη] at hΓ
      rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ, hordS]
  set ψ := (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a
  have hψ : ψ ≠ 0 := (haU.map _).ne_zero
  have hres : IsRestrictionAlong S g ψ := ⟨a, ha, rfl⟩
  refine ⟨ψ, hψ, hres, fun G hG => ?_⟩
  have hGU : S.idealSheaf.subschemeι G.genericPoint ∈ U :=
    (G.genericPoint_mem_iff (S.idealSheaf.subschemeι ⁻¹ᵁ U)).mpr hG
  rw [MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  simp only [MulEquiv.toMonoidHom_eq_coe, Units.coe_map, MonoidHom.coe_coe, Units.val_mk0,
    MulEquiv.apply_symm_apply]
  rw [show (rationalFunctionsEquivFunctionField _) ((rationalFunctionsEquivFunctionField
    S.idealSheaf.subscheme).symm.toMonoidHom ψ) = ψ from
    (rationalFunctionsEquivFunctionField _).apply_symm_apply ψ]
  refine coeff_restrictPrimeDivisor_eq_ord' sX S hNS g ψ hψ hres G fun E hE => ?_
  rw [hφ E ⟨_, hE, hGU⟩, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]

/-- **Restriction commutes with pull-back of divisors.** Let `μ : Y ⟶ X` be a dominant morphism of
smooth varieties, `S ⊆ X` and `T ⊆ Y` smooth prime divisors with `fS ≫ ι_S = ι_T ≫ μ` for a
dominant `fS : T ⟶ S`. For a Cartier divisor `N` on `X` without component `S` whose pull-back
`μ^*N` has no component `T`, `(μ^*N)|_T = fS^*(N|_S)`. -/
private theorem isPullback_restrictPrimeDivisor {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [NoetherianSpace X] [Smooth sX] (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [NoetherianSpace Y] [Smooth (μ ≫ sX)] [IsDominant μ]
    (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [Smooth (haveI := S.integral; S.idealSheaf.subschemeι ≫ sX)]
    [IsLocallyNoetherian (haveI := T.integral; T.idealSheaf.subscheme)]
    [IsNormal (haveI := T.integral; T.idealSheaf.subscheme)]
    [CompactSpace (haveI := T.integral; T.idealSheaf.subscheme)]
    [Smooth (haveI := T.integral; T.idealSheaf.subschemeι ≫ μ ≫ sX)]
    (fS : (haveI := T.integral; T.idealSheaf.subscheme) ⟶
      (haveI := S.integral; S.idealSheaf.subscheme))
    (hfSd : haveI := S.integral; haveI := T.integral; IsDominant fS)
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    {N : Divisor X} (hN : N.IsCartier) (hNS : N.coeff S = 0)
    {hB : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ N.supp}
    {Nμ : Divisor Y} (hNμ : N.IsPullback μ hB Nμ) (hNμT : Nμ.coeff T = 0) :
    haveI := S.integral; haveI := T.integral
    ∃ hB' : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
        fS (componentGenericPoint _ Z) ∉ (N.restrictPrimeDivisor S).supp,
      Divisor.IsPullback fS (N.restrictPrimeDivisor S) hB' (Nμ.restrictPrimeDivisor T) := by
  haveI := S.integral
  haveI := T.integral
  have hB' := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fS
    (N.restrictPrimeDivisor S)
  have hrange : Set.range S.idealSheaf.subschemeι.base = (S.support : Set X) :=
    Scheme.IdealSheafData.range_subschemeι _
  have hNSc : Divisor.IsCartier (N.restrictPrimeDivisor S) := by
    intro x
    obtain ⟨U, hxU, φ, hφ⟩ := hN (S.idealSheaf.subschemeι x)
    obtain ⟨ψ, hψ, -, hloc⟩ := exists_isLocalEquation_restrictPrimeDivisor sX S hNS hφ
      ⟨_, hrange ▸ Set.mem_range_self x, hxU⟩
    exact ⟨_, hxU, _, hloc⟩
  obtain ⟨N', hN'⟩ := Divisor.IsCartier.exists_isPullback hNSc hB'
  refine ⟨hB', ?_⟩
  convert hN' using 1
  ext Q
  have hy : μ (T.idealSheaf.subschemeι Q.genericPoint) =
      S.idealSheaf.subschemeι (fS Q.genericPoint) := by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfS]
  obtain ⟨U, hxU, φ, hφ⟩ := hN (μ (T.idealSheaf.subschemeι Q.genericPoint))
  obtain ⟨ψ, hψ, hres, hloc⟩ := exists_isLocalEquation_restrictPrimeDivisor sX S hNS hφ
    ⟨_, hrange ▸ Set.mem_range_self (fS Q.genericPoint), hy ▸ hxU⟩
  have hfQ : fS Q.genericPoint ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U := by
    change S.idealSheaf.subschemeι (fS Q.genericPoint) ∈ U
    rw [← hy]; exact hxU
  rw [coeff_eq_ord_of_isPullback fS hN' hloc Q hfQ]
  simp only [MulEquiv.toMonoidHom_eq_coe, Units.coe_map, MonoidHom.coe_coe, Units.val_mk0,
    MulEquiv.apply_symm_apply]
  rw [show (rationalFunctionsEquivFunctionField _) ((rationalFunctionsEquivFunctionField
    S.idealSheaf.subscheme).symm.toMonoidHom ψ) = ψ from
    (rationalFunctionsEquivFunctionField _).apply_symm_apply ψ]
  have hres' := isRestrictionAlong_functionFieldMap μ S T fS hfSd hfS hres
  refine coeff_restrictPrimeDivisor_eq_ord' (μ ≫ sX) T hNμT _ _
    ((map_ne_zero_iff _ (functionFieldMap fS).injective).mpr hψ) hres' Q fun E hE => ?_
  have hsp : E.genericPoint ⤳ T.idealSheaf.subschemeι Q.genericPoint := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
    exact specializes_iff_mem_closure.mpr hE
  exact coeff_eq_ord_of_isPullback μ hNμ hφ E ((μ.base.hom.map_specializes hsp).mem_open U.isOpen hxU)

/-- **Sections pull back.** For a dominant `f : Y ⟶ X` and a Cartier divisor `N` on `X`, the
pull-back of a section of `𝒪_X(N)` is a section of `𝒪_Y(f^*N)`. -/
private theorem functionFieldMap_mem_sectionsIn_of_isPullback {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {N : Divisor X} (hN : N.IsCartier)
    {hB : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ N.supp}
    {N' : Divisor Y} (h : N.IsPullback f hB N') {u : X.functionField} (hu : u ∈ sectionsIn N) :
    functionFieldMap f u ∈ sectionsIn N' := by
  by_cases hu0 : u = 0
  · rw [hu0, map_zero]; exact (sectionsSubgroup _).zero_mem
  have hu0' : functionFieldMap f u ≠ 0 := (map_ne_zero_iff _ (functionFieldMap f).injective).mpr hu0
  have hBp : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ (N + ffDiv u hu0).supp :=
    fun Z => MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z
  have hp := isPullback_add_principalDivisor f hN h hu0 hu0' hBp
  refine mem_sectionsIn_of_coeff_nonneg hu0' fun P => ?_
  exact MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn
    (hN.add (Divisor.isCartier_principalDivisor _)) (V := ⊤)
    (fun P _ => coeff_add_ffDiv_nonneg hu hu0 P) hp P
    ⟨P.genericPoint, MMP.Flips.primeDivisor_genericPoint_mem_support P, trivial⟩

/-- **Canonical pairs bound pull-backs by the discrepancy.** Let `f : W ⟶ V` be a proper
birational morphism onto a smooth variety, `Q` an `f`-exceptional prime divisor with discrepancy
`a(Q, V, 0) = -Θ_Q`, and `(V, Ω)` a real canonical pair. For an integral `N` with `N ≤ m Ω`,
the coefficient of `f^*N` along `Q` is at most `m · a(Q, V, 0)`. -/
private theorem coeff_isPullback_le_of_isRealCanonicalPair {k : Type} [Field k] [IsAlgClosed k]
    {V W : Scheme.{0}} {sV : V ⟶ Spec (.of k)} [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] (hVs : IsSmoothScheme sV) {n : ℕ} {KV : Divisor V}
    (f : W ⟶ V) [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [IsDominant f] [IsProper f]
    (hW : IsNormalVariety k (f ≫ sV)) (hf : IsBirationalMorphism f) (Q : MMP.Mori.PrimeDivisor W)
    {a : ℚ} (ha : MMP.Mori.IsDiscrepancy sV n KV 0 ⟨W, f, hW, hf, Q⟩ a)
    {Ω : QDivisor V} (hcan : IsRealCanonicalPair sV (QDivisor.toRDivisor Ω))
    (hexc : (⟨W, f, hW, hf, Q⟩ : DivisorOver k sV).IsExceptional)
    {N : Divisor V} {m : ℕ} (hm : 0 < m) (hN : Divisor.toQDivisor N ≤ (m : ℚ) • Ω)
    {hB : ∀ Z : irreducibleComponents W, f (componentGenericPoint W Z) ∉ N.supp}
    {N' : Divisor W} (hpb : N.IsPullback f hB N') :
    (N'.coeff Q : ℚ) ≤ m * a := by
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy ha
    (show IsProper f from inferInstance)
  have hNc : N.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hVs N
  have h1 := isLogDiscrepancy_add_smul hlog hNc ((m : ℝ)⁻¹) N' hB hpb
  set Δ : QDivisor V := Ω - (m : ℚ)⁻¹ • Divisor.toQDivisor N with hΔ
  have hmq : (0 : ℚ) < m := by exact_mod_cast hm
  have hΔ0 : ∀ P, 0 ≤ Δ.coeff P := by
    intro P
    have h2 := hN P
    change ((N P : ℤ) : ℚ) ≤ (m : ℚ) * Ω P at h2
    change (0 : ℚ) ≤ Ω P - (m : ℚ)⁻¹ * ((N P : ℤ) : ℚ)
    rw [sub_nonneg, inv_mul_le_iff₀ hmq]
    exact h2
  obtain ⟨a', ha'le, ha'⟩ := MMP.Fourfold.exists_isLogDiscrepancy_add_le hVs Δ hΔ0 h1
  have hbd : QDivisor.toRDivisor 0 + (m : ℝ)⁻¹ • Divisor.toRDivisor N + QDivisor.toRDivisor Δ =
      QDivisor.toRDivisor Ω := by
    ext P
    change (((0 : QDivisor V) P : ℚ) : ℝ) + (m : ℝ)⁻¹ * ((N P : ℤ) : ℝ) +
      ((Ω P - (m : ℚ)⁻¹ * ((N P : ℤ) : ℚ) : ℚ) : ℝ) = ((Ω P : ℚ) : ℝ)
    push_cast
    simp
  rw [hbd] at ha'
  have h3 := hcan.2.2.2 n _ a' hexc ha'
  have h4 : (1 : ℝ) ≤ 1 + (a : ℝ) - (m : ℝ)⁻¹ * (N'.coeff Q : ℝ) := le_trans h3 ha'le
  have hmr : (0 : ℝ) < m := by exact_mod_cast hm
  have h5 : (m : ℝ)⁻¹ * (N'.coeff Q : ℝ) ≤ (a : ℝ) := by linarith
  rw [inv_mul_le_iff₀ hmr] at h5
  exact_mod_cast h5

/-- A prime divisor on a proper birational model of a normal variety is either the strict
transform of a prime divisor, with `f` an isomorphism of local rings at its generic point, or
exceptional. -/
private theorem exists_primeDivisor_or_isExceptional {k : Type} [Field k] {V W : Scheme.{0}}
    {sV : V ⟶ Spec (.of k)} [IsIntegral V] [IsLocallyNoetherian V] [IsNormal V]
    (hV : IsNormalVariety k sV) (f : W ⟶ V) [IsIntegral W] [IsProper f]
    (hW : IsNormalVariety k (f ≫ sV)) (hf : IsBirationalMorphism f) (Q : MMP.Mori.PrimeDivisor W) :
    (∃ G : MMP.Mori.PrimeDivisor V, f Q.genericPoint = G.genericPoint ∧
      IsIso (f.stalkMap Q.genericPoint)) ∨
      (⟨W, f, hW, hf, Q⟩ : DivisorOver k sV).IsExceptional := by
  by_cases h : (⟨W, f, hW, hf, Q⟩ : DivisorOver k sV).IsExceptional
  · exact Or.inr h
  left
  obtain ⟨G, hv⟩ := MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hV _ h
  have h1 := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hV.1 hv
  refine ⟨G, h1, ?_⟩
  exact MMP.isIso_stalkMap_of_mem_biregularLocus f
    (h1 ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus f hf G)

/-- The discrepancy of `(V, 0)` along a non-exceptional divisor over a smooth variety is `0`. -/
private theorem eq_zero_of_isDiscrepancy_of_not_isExceptional {k : Type} [Field k] [IsAlgClosed k]
    {V W : Scheme.{0}} {sV : V ⟶ Spec (.of k)} [IsIntegral V] [IsLocallyNoetherian V]
    [IsNormal V] (hVs : IsSmoothScheme sV) (hV : IsNormalVariety k sV) {n : ℕ} {KV : Divisor V}
    (hKV : KV.IsCanonicalDivisor sV n) (f : W ⟶ V) [IsProper f]
    (hW : IsNormalVariety k (f ≫ sV)) (hf : IsBirationalMorphism f) (Q : MMP.Mori.PrimeDivisor W)
    {a : ℚ} (ha : MMP.Mori.IsDiscrepancy sV n KV 0 ⟨W, f, hW, hf, Q⟩ a)
    (hnexc : ¬ (⟨W, f, hW, hf, Q⟩ : DivisorOver k sV).IsExceptional) : a = 0 := by
  have hlog := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy ha
    (show IsProper f from inferInstance)
  obtain ⟨P, hP⟩ := exists_eq_one_sub_coeff_of_not_isExceptional hVs hV hKV hnexc hlog
  have h0 : ((0 : QDivisor V).coeff P : ℝ) = 0 := by
    change (((0 : QDivisor V) P : ℚ) : ℝ) = 0
    simp
  rw [h0, sub_zero, add_eq_left] at hP
  exact_mod_cast hP

/-- A prime divisor whose generic point maps to that of a prime divisor is not exceptional. -/
private theorem not_isExceptional_of_map_genericPoint_eq {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsSeparated (X ↘ Limits.terminal Scheme)] {f : Y ⟶ X} {P : MMP.Mori.PrimeDivisor Y}
    {Q : MMP.Mori.PrimeDivisor X} (h : f P.genericPoint = Q.genericPoint) :
    ¬ RationalMap.IsExceptional (X := Y) f.toRationalMap P := by
  intro hex
  have h2 := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp
    ((MMP.Positivity.isExceptional_toRationalMap_iff (f := f) P).mp hex) _ <|
      subset_closure ⟨P.genericPoint, MMP.Flips.primeDivisor_genericPoint_mem_support P, h⟩
  rw [Q.coheight_genericPoint] at h2
  exact absurd h2 (by decide)

private theorem max_sub_max_neg (a : ℤ) : max a 0 - max (-a) 0 = a := by
  rcases le_total a 0 with h | h
  · rw [max_eq_right h, max_eq_left (by omega)]; ring
  · rw [max_eq_left h, max_eq_right (by omega)]; ring

/-- **The clipped boundary has no stratum in the stable base locus.** -/
private theorem containsNoStratum_baseLocus_clipped {k : Type} [Field k] {X Y : Scheme.{0}}
    [IsIntegral X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (μ : Y ⟶ X) [IsDominant μ] {sY : Y ⟶ Spec (.of k)} {V : Set X.functionField}
    {Dμ Fμ KY lΘ Γl El Hl Ξl DET Δ' : Divisor Y} {l : ℕ}
    (hlΘ : lΘ = Dμ - (l : ℤ) • KY) (hΓl : Γl = lΘ ⊔ 0) (hEl : El = (-lΘ) ⊔ 0)
    (hHl : Hl = Fμ + El) (hΞl : Ξl = Γl - Γl ⊓ Hl) (hDET : DET = (l : ℤ) • KY + Ξl)
    (hfix : IsFixedDivisorOfPullback μ V Dμ Fμ) (hfree : IsFreeModuloFixedDivisor μ V Dμ Fμ)
    (s : Finset (MMP.Mori.PrimeDivisor Y))
    (hsnc : DivisorWithCoeffs.IsSNC sY (∑ E ∈ s, Finsupp.single E (1 : ℤ)))
    (hΔ' : ∀ P, Δ'.coeff P ≠ 0 → Ξl.coeff P ≠ 0)
    (hs : ∀ P, (Ξl.coeff P ≠ 0 ∨ Fμ.coeff P ≠ 0 ∨ El.coeff P ≠ 0) → P ∈ s) :
    ContainsNoStratum Δ'
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • DET)) ((m : ℤ) • DET)) := by
  classical
  have hΓc : ∀ P, Γl.coeff P = max (lΘ.coeff P) 0 := fun P => by
    rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hEc : ∀ P, El.coeff P = max (-lΘ.coeff P) 0 := fun P => by
    rw [hEl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hHc : ∀ P, Hl.coeff P = Fμ.coeff P + El.coeff P := fun P => by rw [hHl]; rfl
  have hΞc : ∀ P, Ξl.coeff P = Γl.coeff P - min (Γl.coeff P) (Hl.coeff P) := fun P => by
    rw [hΞl, DivisorWithCoeffs.coeff_apply, Finsupp.sub_apply, Finsupp.inf_apply]; rfl
  have hlΘc : ∀ P, lΘ.coeff P = Dμ.coeff P - l * KY.coeff P := fun P => by
    rw [hlΘ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
  have hDETc : ∀ P, DET.coeff P = Dμ.coeff P + El.coeff P - min (Γl.coeff P) (Hl.coeff P) := by
    intro P
    rw [hDET, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul, hΞc]
    have := max_sub_max_neg (lΘ.coeff P)
    rw [← hΓc, ← hEc, hlΘc] at this
    linarith
  have hΓ0 : ∀ P, 0 ≤ Γl.coeff P := fun P => by rw [hΓc]; exact le_max_right _ _
  have hE0 : ∀ P, 0 ≤ El.coeff P := fun P => by rw [hEc]; exact le_max_right _ _
  have hsupp : ∀ P, P ∈ s → P ∈ (∑ E ∈ s, Finsupp.single E (1 : ℤ)).support := fun P hP => by
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, coeff_sum_single_one, if_pos hP]
    exact one_ne_zero
  refine containsNoStratum_of_forall_genericPoint fun ξ hξ hmem => ?_
  have hmem1 : ξ ∈ baseLocusIn (sectionsIn (((1 : ℕ) : ℤ) • DET)) (((1 : ℕ) : ℤ) • DET) :=
    Set.mem_iInter₂.mp hmem 1 one_pos
  obtain ⟨g, hgV, hg0, hgP⟩ := hfree ξ
  have hg0' : functionFieldMap μ g ≠ 0 :=
    (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr hg0
  have hord : ∀ P, Fμ.coeff P ≤ Dμ.coeff P + Y.ord (functionFieldMap μ g) P.genericPoint := by
    intro P
    have := (valuationOver_le_exp_iff μ P hg0' _).mp ((hfix P).1 g hgV)
    omega
  have hordξ : ∀ P, ξ ∈ P.support →
      Dμ.coeff P + Y.ord (functionFieldMap μ g) P.genericPoint = Fμ.coeff P := by
    intro P hP
    have := (valuationOver_eq_exp_iff μ P hg0' _).mp (hgP P hP)
    omega
  have hcoef : ∀ P, ((((1 : ℕ) : ℤ) • DET) + ffDiv _ hg0').coeff P =
      Dμ.coeff P + Y.ord (functionFieldMap μ g) P.genericPoint + El.coeff P -
        min (Γl.coeff P) (Hl.coeff P) := by
    intro P
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, coeff_ffDiv, hDETc]
    simp only [Nat.cast_one, one_smul]
    ring
  have hnv : IsNonvanishingAt (((1 : ℕ) : ℤ) • DET) (functionFieldMap μ g) ξ := by
    refine ⟨hg0', mem_sectionsIn_of_coeff_nonneg hg0' fun P => ?_, fun hx => ?_⟩
    · rw [hcoef]
      have h1 := hord P
      have h2 := min_le_right (Γl.coeff P) (Hl.coeff P)
      have h3 := hHc P
      linarith
    · obtain ⟨P, hP, hξP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
      rw [hcoef, hordξ P hξP] at hP
      have hlt : Γl.coeff P < Hl.coeff P := by
        by_contra h
        push_neg at h
        apply hP
        rw [min_eq_right h, hHc]
        ring
      have hΞ0 : Ξl.coeff P = 0 := by rw [hΞc, min_eq_left hlt.le]; ring
      have hPs : P ∈ s := by
        refine hs P (Or.inr ?_)
        by_contra h
        push_neg at h
        have := hΓ0 P
        rw [hHc, h.1, h.2] at hlt
        omega
      obtain ⟨J, hJ, hmax⟩ := hξ
      have hJs : J ⊆ (∑ E ∈ s, Finsupp.single E (1 : ℤ)).support := fun E hE =>
        hsupp E (hs E (Or.inl (hΔ' E (Finsupp.mem_support_iff.mp (hJ hE)))))
      have hPJ := mem_of_maximal_closure hsnc hJs hmax (hsupp P hPs) hξP
      exact hΔ' P (Finsupp.mem_support_iff.mp (hJ hPJ)) hΞ0
  exact notMem_baseLocusIn_of_mem_of_isNonvanishingAt hnv.2.1 hnv hmem1

/-- On an integral scheme, the generic point is the only point lying in every stratum of the zero
divisor; in particular the zero divisor contains no stratum of a set missing the generic point. -/
private theorem containsNoStratum_zero_of_genericPoint_notMem {W : Scheme.{0}} [IsIntegral W]
    {C : Set W} (hC : genericPoint W ∉ C) : ContainsNoStratum (0 : Divisor W) C := by
  rintro T ⟨J, hJ, hmax⟩ hTC
  have hJ0 : J = ∅ := by
    rw [Finsupp.support_zero] at hJ
    exact Finset.subset_empty.mp hJ
  subst hJ0
  have hT : T = Set.univ := by
    refine (hmax.2 ⟨IrreducibleSpace.isIrreducible_univ W, by simp⟩ (Set.subset_univ T)).antisymm
      (Set.subset_univ T) |>.symm
  exact hC (hTC (hT ▸ Set.mem_univ _))

/-- **A section lies in the asymptotic multiplier ideal of its complete series.** On a smooth
variety `W` projective over an affine base, for a nonzero section `u` of `𝒪_W(M)` and an effective
`P`, the asymptotic adjoint ideal `J = 𝒥(‖M‖)` of `(W, 0)` exists and near every point `u` lies
in `𝒪_W(M + P) · J`. -/
private theorem exists_isAsymptoticAdjointIdealOfDivisor_mem_span {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {W Z : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W]
    [IsNormal W] [CompactSpace W] (sW : W ⟶ Spec (.of k)) (f : W ⟶ Z) (hf : IsProjectiveMorphism f)
    [IsAffine Z] (hW : IsNormalVariety k sW) (hsm : IsSmoothScheme sW) {M P : Divisor W}
    (hP0 : 0 ≤ P) {u : W.functionField} (hu : u ∈ sectionsIn M) (hu0 : u ≠ 0) :
    ∃ J : W.Opens → Set W.functionField, IsAsymptoticAdjointIdealOfDivisor sW f 0 M 1 1 J ∧
      ∀ x : W, ∃ V : W.Opens, x ∈ V ∧
        u ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) (M + P) V * J V) := by
  classical
  haveI : LocallyOfFinitePresentation sW :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sW)).mpr hW.1.toLocallyOfFiniteType
  have hMc : M.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm M
  have hΔ0 : IsReducedSNC sW (0 : Divisor W) := ⟨fun P => Or.inl rfl,
    DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sW hsm⟩
  have hu1 : u ∈ completeSeries M 1 := by
    change u ∈ sectionsIn (((1 : ℕ) : ℤ) • M)
    rwa [Nat.cast_one, one_smul]
  have hVb : completeSeries M 1 ≠ ⊥ := fun h => hu0 (by
    have := hu1; rw [h] at this; exact this)
  have hns : ContainsNoStratum (0 : Divisor W)
      (baseLocusIn (completeSeries M 1) (((1 : ℕ) : ℤ) • M)) := by
    refine containsNoStratum_zero_of_genericPoint_notMem fun h => ?_
    obtain ⟨P', hP', -⟩ := h u hu1 hu0
    exact MMP.Threefold.Mori.CanonUniq.genericPoint_notMem_support P' hP'
  obtain ⟨J, hJ⟩ := exists_isAsymptoticAdjointIdeal f sW hf hW hsm hΔ0 hMc
    (isGradedLinearSeries_completeSeries f M) one_pos hVb hns one_pos
  refine ⟨J, hJ, fun x => ?_⟩
  obtain ⟨V, hxV, e, he0, he⟩ := exists_localGenerator hMc x
  have hV : V ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxV⟩
  refine ⟨V, hxV, Submodule.subset_span ⟨e, ?_, e⁻¹ * u, ?_, by field_simp⟩⟩
  · refine ⟨fun h => absurd ((preimage_eq_bot_iff (𝟙 W) V).1 h) hV, fun Q hQ => ?_⟩
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
      he Q (by simpa using hQ), DivisorWithCoeffs.coeff_add, WithZero.exp_le_exp]
    have h := hP0 Q
    change (0 : ℤ) ≤ P Q at h
    rw [← DivisorWithCoeffs.coeff_apply] at h
    linarith
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, Jp, hJp, hJ'⟩ := hJ
  refine (hJ' V _).2 ⟨fun h => absurd h hV, fun y hy => ⟨V, hy, le_rfl, 1, one_pos, dvd_rfl, ?_⟩⟩
  obtain ⟨Y, μ, hon⟩ := hJp 1 one_pos dvd_rfl
  rw [eq_seriesSet sW hon]
  refine ⟨fun h => absurd h hV, fun n G a hc ha => ?_⟩
  set Z₀ : irreducibleComponents W := MMP.Mori.pointComponent (genericPoint W)
  obtain ⟨U₀, hcU₀, φ₀, hφ₀⟩ := hMc (G.f G.E.genericPoint)
  set ψ₀ := MMP.Threefold.Mori.Helpers.evalFF Z₀ (φ₀ : MMP.Mori.RationalFunctions W) with hψ₀
  have hψ₀0 : ψ₀ ≠ 0 := evalFF_ne_zero Z₀ φ₀
  have hordψ₀ : ∀ Γ : MMP.Mori.PrimeDivisor W, G.f G.E.genericPoint ∈ Γ.support →
      W.ord ψ₀ Γ.genericPoint = M.coeff Γ := fun Γ hΓ =>
    ord_evalFF_of_isLocalEquation hφ₀ Z₀ Γ ⟨_, hΓ, hcU₀⟩
  have ht₀ : G.valuation (u * ψ₀) ≠ 0 := (map_ne_zero _).mpr (mul_ne_zero hu0 hψ₀0)
  set w : ℤ := -WithZero.log (G.valuation (u * ψ₀)) with hw
  have hvw : G.valuation (u * ψ₀) = WithZero.exp (-w) := by
    rw [hw, neg_neg, WithZero.exp_log ht₀]
  -- a rational function with the orders of `ψ₀` near the centre has the valuation of `ψ₀`
  have hcmp : ∀ t : W.functionField, t ≠ 0 → (∀ Γ : MMP.Mori.PrimeDivisor W,
      G.f G.E.genericPoint ∈ Γ.support → W.ord t Γ.genericPoint = M.coeff Γ) →
      G.valuation (u * t) = WithZero.exp (-w) := by
    intro t ht hordt
    have hq : G.valuation (t * ψ₀⁻¹) = 1 :=
      valuation_eq_one_of_forall_ord_eq_zero G (mul_ne_zero ht (inv_ne_zero hψ₀0))
        fun Γ hΓ => by rw [ord_mul_inv ht hψ₀0, hordt Γ hΓ, hordψ₀ Γ hΓ, sub_self]
    have e2 : u * t = (u * ψ₀) * (t * ψ₀⁻¹) := by field_simp
    rw [e2, Valuation.map_mul, hq, mul_one, hvw]
  have hDeq : ((1 : ℕ) : ℤ) • M = M := by rw [Nat.cast_one, one_smul]
  refine ⟨u, hu1, hu0, w, fun U φ Z hφ hxU => ?_, ?_⟩
  · rw [hDeq] at hφ
    refine (hcmp _ (evalFF_ne_zero Z φ) fun Γ hΓ =>
      ord_evalFF_of_isLocalEquation hφ Z Γ ⟨_, hΓ, hxU⟩).ge
  · have hgen : G.valuation (e⁻¹ * u) = WithZero.exp (-w) := by
      rw [mul_comm]
      refine hcmp _ (inv_ne_zero he0) fun Γ hΓ => ?_
      have h1 := he Γ ⟨_, hΓ, hc⟩
      rw [Γ.divisorialValuation_eq_exp_neg_ord he0, WithZero.exp_inj] at h1
      rw [← zpow_neg_one, MMP.Mori.ord_zpow _ he0]
      omega
    rw [hgen, WithZero.exp_le_exp]
    haveI : LocallyOfFinitePresentation sW := inferInstance
    obtain ⟨a₀, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sW hW.1 hsm
      hΔ0.1 hΔ0.2 ha
    have hc1 : (((1 : ℚ) / ((1 : ℕ) : ℚ) : ℚ) : ℝ) * (w : ℝ) = ((w : ℤ) : ℝ) := by
      push_cast; ring
    rw [hc1, ← Int.cast_natCast, ← Int.cast_sub, Int.ceil_intCast]
    split_ifs with h0
    · have : (a₀ : ℤ) = 0 := by exact_mod_cast h0
      omega
    · have : (a₀ : ℤ) ≠ 0 := fun h => h0 (by exact_mod_cast h)
      omega

/-- The restriction of the zero divisor is zero. -/
private theorem restrictPrimeDivisor_zero' {X : Scheme.{0}} [NoetherianSpace X] {R : Type*}
    [AddCommGroup R] (S : MMP.Mori.PrimeDivisor X) :
    (0 : DivisorWithCoeffs R X).restrictPrimeDivisor S = 0 := by
  have h := restrictPrimeDivisor_add' S (D₁ := (0 : DivisorWithCoeffs R X)) (D₂ := 0) rfl rfl
  rw [add_zero] at h
  exact add_eq_left.mp h.symm

/-- Restriction to `S` commutes with finite sums of divisors of which `S` is not a component. -/
private theorem restrictPrimeDivisor_sum' {X : Scheme.{0}} [NoetherianSpace X] {R ι : Type*}
    [AddCommGroup R] (S : MMP.Mori.PrimeDivisor X) (s : Finset ι)
    (D : ι → DivisorWithCoeffs R X) (hD : ∀ i ∈ s, (D i).coeff S = 0) :
    (∑ i ∈ s, D i).restrictPrimeDivisor S = ∑ i ∈ s, (D i).restrictPrimeDivisor S := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using restrictPrimeDivisor_zero' (R := R) S
  | insert a s ha ih =>
    have hs : (∑ i ∈ s, D i).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
      exact Finset.sum_eq_zero fun i hi => hD i (Finset.mem_insert_of_mem hi)
    rw [Finset.sum_insert ha, Finset.sum_insert ha,
      restrictPrimeDivisor_add' S (hD a (Finset.mem_insert_self a s)) hs,
      ih fun i hi => hD i (Finset.mem_insert_of_mem hi)]

/-- Sections of `𝒪_X(D₁)` are sections of `𝒪_X(D₂)` for `D₁ ≤ D₂`. -/
private theorem sectionsIn_mono {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {D₁ D₂ : Divisor X} (h : ∀ P, D₁.coeff P ≤ D₂.coeff P) :
    sectionsIn D₁ ⊆ sectionsIn D₂ :=
  fun _ hg P => (hg P).trans (WithZero.exp_le_exp.mpr (h P))

/-- The arithmetic of the comparison at a prime divisor of `S` along which `T ⟶ S` is an
isomorphism. -/
private theorem comparison_arith {mm m' l K Ω Φ C F lam η x f nΩ : ℝ} (hmm : mm = m' * l)
    (hm' : 0 ≤ m') (hl : 0 ≤ l) (hC : 0 ≤ C) (hCF : C ≠ 0 → F = 0) (hη : 0 ≤ η) (hΦ0 : 0 ≤ Φ)
    (hΦ : min Ω (lam * F) ≤ Φ) (hnΩ : nΩ ≤ mm * (Ω - Φ)) (hx1 : x ≤ f) (hf : f ≤ l * lam * F)
    (hx2 : x ≤ l * (Ω + C) + η) : mm * K + nΩ ≤ m' * (l * (K + Ω + C) + η - x) := by
  subst hmm
  have hml : 0 ≤ m' * l := mul_nonneg hm' hl
  have e : m' * (l * (K + Ω + C) + η - x) = m' * l * K + m' * l * Ω + m' * l * C + m' * η -
      m' * x := by ring
  have e2 : m' * l * (Ω - Φ) = m' * l * Ω - m' * l * Φ := by ring
  have h2 : 0 ≤ m' * η := mul_nonneg hm' hη
  rw [e]
  rw [e2] at hnΩ
  by_cases hC0 : C = 0
  · subst hC0
    rcases le_total Ω (lam * F) with h | h
    · rw [min_eq_left h] at hΦ
      have h0 : m' * l * Ω ≤ m' * l * Φ := mul_le_mul_of_nonneg_left hΦ hml
      have h1 : m' * x ≤ m' * (l * (Ω + 0) + η) := mul_le_mul_of_nonneg_left hx2 hm'
      have e3 : m' * (l * (Ω + 0) + η) = m' * l * Ω + m' * η := by ring
      linarith
    · rw [min_eq_right h] at hΦ
      have h0 : m' * l * (lam * F) ≤ m' * l * Φ := mul_le_mul_of_nonneg_left hΦ hml
      have h1 : m' * x ≤ m' * (l * lam * F) := mul_le_mul_of_nonneg_left (hx1.trans hf) hm'
      have e3 : m' * (l * lam * F) = m' * l * (lam * F) := by ring
      linarith
  · have hF0 := hCF hC0
    subst hF0
    have hx0 : x ≤ 0 := by linarith [hx1.trans hf]
    have h1 : m' * x ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hm' hx0
    have h3 : 0 ≤ m' * l * C := mul_nonneg hml hC
    have h4 : 0 ≤ m' * l * Φ := mul_nonneg hml hΦ0
    linarith

section MultRestrict

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [NoetherianSpace X] (hXs : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
  [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
  [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
  [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
  (hSs : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))

/-- In the local ring of a prime divisor, an element of the `k`-th power of the maximal ideal has
order at least `k`. -/
private theorem le_ord_of_mem_maximalIdeal_pow {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (G : MMP.Mori.PrimeDivisor Y)
    {y : Y.presheaf.stalk G.genericPoint} (hy0 : y ≠ 0) {n : ℕ}
    (hy : y ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk G.genericPoint) ^ n) :
    (n : ℤ) ≤ Y.ord (algebraMap _ Y.functionField y) G.genericPoint := by
  have := G.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible G.localRing
  have hϖm := hϖ.maximalIdeal_eq
  change y ∈ IsLocalRing.maximalIdeal G.localRing ^ n at hy
  rw [hϖm, Ideal.span_singleton_pow] at hy
  obtain ⟨z, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  have hz0 : z ≠ 0 := left_ne_zero_of_mul hy0
  have hinj := IsFractionRing.injective (Y.presheaf.stalk G.genericPoint) Y.functionField
  have hz' : algebraMap _ Y.functionField z ≠ 0 := (map_ne_zero_iff _ hinj).mpr hz0
  have hϖ' : algebraMap _ Y.functionField ϖ ≠ 0 := (map_ne_zero_iff _ hinj).mpr hϖ.ne_zero
  have hordϖ : Y.ord (algebraMap _ Y.functionField ϖ) G.genericPoint = 1 := by
    rw [Scheme.ord_eq_iff G.coheight_genericPoint hϖ']
    exact Ring.ordFrac_irreducible (R := Y.presheaf.stalk G.genericPoint) hϖ
  have hpos := ord_algebraMap_nonneg G (MMP.Flips.primeDivisor_genericPoint_mem_support G) z hz'
  rw [map_mul, map_pow, Scheme.ord_mul hz' (pow_ne_zero _ hϖ'), ← zpow_natCast,
    MMP.Mori.ord_zpow _ hϖ', hordϖ]
  omega

include hXs hSs in
/-- **Ambient multiplicity is at most restricted order.** For a prime divisor `P ≠ S` of the smooth
`X` and a prime divisor `G` of the smooth prime divisor `S`, the multiplicity of `P` at the generic
point of `G` is at most the local intersection length of `P` along `G`. -/
private theorem toNat_multiplicityAt_le_intersectionLength (P : MMP.Mori.PrimeDivisor X)
    (hPS : P ≠ S) (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    haveI := S.integral
    (P.multiplicityAt (S.idealSheaf.subschemeι G.genericPoint)).toNat ≤
      P.intersectionLength S.idealSheaf.subschemeι G := by
  haveI := S.integral
  classical
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSs
  set ι := S.idealSheaf.subschemeι with hι
  set x := ι G.genericPoint with hx
  by_cases hxP : x ∈ P.support
  swap
  · rw [P.multiplicityAt_eq_zero_of_notMem hxP]; exact Nat.zero_le _
  have hPmem := MMP.Flips.primeDivisor_genericPoint_mem_support P
  have hPx : P.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxP
    exact specializes_iff_mem_closure.mpr hxP
  -- a local equation of `P` near `x`, regular on an affine neighbourhood `U`
  have hPc : Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor X) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hXs _
  obtain ⟨U₀, hxU₀, φ, hφ⟩ := hPc x
  obtain ⟨U, hUaff, hxU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) hxU₀
  set ψ := rationalFunctionsEquivFunctionField X φ with hψ
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hordψ : ∀ E : MMP.Mori.PrimeDivisor X, (E.support ∩ (U : Set X)).Nonempty →
      X.ord ψ E.genericPoint = if E = P then 1 else 0 := by
    intro E hE
    rw [← MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField,
      ← hφ E (hE.mono (Set.inter_subset_inter_right _ hUU₀))]
    by_cases hEP : E = P
    · subst hEP; rw [if_pos rfl, DivisorWithCoeffs.coeff_single_self]
    · rw [if_neg hEP, DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hEP)]
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨f, hf⟩ := (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord U
    hψ0).mpr fun E hE => by rw [hordψ E hE]; split_ifs <;> norm_num
  -- `f` lies in the ideal of `P`
  have hfI : f ∈ P.idealSheaf.ideal ⟨U, hUaff⟩ := by
    rw [MMP.Mori.PrimeDivisor.mem_ideal_idealSheaf_iff]
    intro hηU hηf
    have hηmem := MMP.Flips.primeDivisor_genericPoint_mem_support P
    have hu : IsUnit ((X.presheaf.germ U P.genericPoint hηU).hom f) :=
      (X.mem_basicOpen f _ hηU).mp hηf
    have h1 := ord_algebraMap_eq_zero_of_isUnit P hηmem hu
    rw [Scheme.algebraMap_germ_eq_germToFunctionField, hf,
      hordψ P ⟨_, hηmem, hηU⟩, if_pos rfl] at h1
    exact one_ne_zero h1
  have hfx : (X.presheaf.germ U x hxU).hom f ∈ P.idealSheaf.stalkIdeal x := by
    rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk, IdealSheafData.stalk_eq_map_germ _ x
      ⟨U, hUaff⟩ hxU]
    exact Ideal.mem_map_of_mem _ hfI
  -- the restriction of `f` to `S` has order `length(𝒪_{S,G}/I_P 𝒪_{S,G})` along `G`
  have hgen : genericPoint S.idealSheaf.subscheme ⤳ G.genericPoint := genericPoint_specializes _
  have hηS : ι (genericPoint S.idealSheaf.subscheme) ∈ U :=
    (hgen.map ι.continuous).mem_open U.isOpen hxU
  set a := (X.presheaf.germ U _ hηS).hom f with ha
  have haψ : algebraMap _ X.functionField a = ψ := by
    rw [ha, Scheme.algebraMap_germ_eq_germToFunctionField, hf]
  have hSmem : S.genericPoint ∈ S.support := MMP.Flips.primeDivisor_genericPoint_mem_support S
  have hSU : (S.support ∩ (U : Set X)).Nonempty := ⟨_, hSmem, hηS⟩
  have hordS : X.ord ψ S.genericPoint = 0 := by rw [hordψ S hSU, if_neg (Ne.symm hPS)]
  have hau : IsUnit a := by
    obtain ⟨b, hbu, hb⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero
      (ι (genericPoint S.idealSheaf.subscheme)) hψ0 fun Γ hΓ => by
        rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ, hordS]
    have : b = a := IsFractionRing.injective _ X.functionField (by rw [hb, haψ])
    rw [← this]; exact hbu
  set s := (principalDivisor φ).support with hs
  have hord := MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX ι a hau G s (fun E hE => by
    rw [haψ] at hE
    rw [hs, Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor,
      MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
    exact hE)
  have hηPU : P.genericPoint ∈ U := hPx.mem_open U.isOpen hxU
  have hPs : P ∈ s := by
    rw [hs, Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor,
      MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, ← hψ,
      hordψ P ⟨_, hPmem, hηPU⟩, if_pos rfl]
    exact one_ne_zero
  have hsum : ∑ E ∈ s, (E.intersectionLength ι G : ℤ) *
      X.ord (algebraMap _ X.functionField a) E.genericPoint = P.intersectionLength ι G := by
    rw [Finset.sum_eq_single P]
    · rw [haψ, hordψ P ⟨_, hPmem, hηPU⟩, if_pos rfl, mul_one]
    · intro E _ hEP
      by_cases hxE : x ∈ E.support
      · rw [haψ, hordψ E ⟨x, hxE, hxU⟩, if_neg hEP, mul_zero]
      · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem ι E hxE]; simp
    · intro h; exact absurd hPs h
  have hbound : P.multiplicityAt x ≤ (P.intersectionLength ι G : ℕ∞) := by
    unfold MMP.Mori.PrimeDivisor.multiplicityAt
    refine iSup₂_le fun n hn => ?_
    have hfn := hn hfx
    set y := (ι.stalkMap G.genericPoint).hom ((X.presheaf.germ U x hxU).hom f) with hydef
    have hmap : (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).map (ι.stalkMap G.genericPoint).hom ≤
        IsLocalRing.maximalIdeal _ := Ideal.map_le_iff_le_comap.mpr fun b hb =>
      (IsLocalRing.mem_maximalIdeal _).mpr fun hu =>
        (IsLocalRing.mem_maximalIdeal _).mp hb (isUnit_of_map_unit _ _ hu)
    have hy : y ∈ IsLocalRing.maximalIdeal _ ^ n := by
      have h1 := Ideal.mem_map_of_mem (ι.stalkMap G.genericPoint).hom hfn
      rw [Ideal.map_pow] at h1
      exact pow_le_pow_left' hmap n h1
    have hyh : algebraMap _ S.idealSheaf.subscheme.functionField y =
        (ι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a := by
      change (S.idealSheaf.subscheme.presheaf.stalkSpecializes _).hom y = _
      rw [hydef, ← Scheme.Hom.stalkSpecializes_stalkMap_apply ι _ _ hgen,
        TopCat.Presheaf.germ_stalkSpecializes_apply]
    have hy0 : y ≠ 0 := by
      intro h0
      have := (hau.map (ι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom).ne_zero
      rw [← hyh, h0, map_zero] at this
      exact this rfl
    have h2 := le_ord_of_mem_maximalIdeal_pow G hy0 hy
    rw [hyh, hord, hsum] at h2
    exact_mod_cast h2
  exact ENat.toNat_le_of_le_coe hbound

end MultRestrict

/-- Every member of the restricted series in degree `m` is `0` or the restriction of a section of
`𝒪_X(⌊mD⌋)`, for `mD` integral. -/
private theorem mem_restrictedSeries_cases {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) (D : QDivisor X) (m : ℕ)
    {s : RationalFunctions (haveI := S.integral; S.idealSheaf.subscheme)}
    (hs : haveI := S.integral; s ∈ AddSubgroup.closure
      {h | ((m : ℚ) • D).IsCartierDivisor ∧
        ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
          IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}) :
    haveI := S.integral
    s = 0 ∨ ((m : ℚ) • D).IsCartierDivisor ∧
      ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
        IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ s) := by
  haveI := S.integral
  refine AddSubgroup.closure_induction (p := fun s _ => s = 0 ∨ ((m : ℚ) • D).IsCartierDivisor ∧
      ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
        IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ s))
    (fun h hh => Or.inr hh) (Or.inl rfl) ?_ ?_ hs
  · rintro a b - - ha hb
    rcases ha with rfl | ⟨hc, g₁, hg₁, a₁, ha₁, hb₁⟩
    · rwa [zero_add]
    rcases hb with rfl | ⟨-, g₂, hg₂, a₂, ha₂, hb₂⟩
    · rw [add_zero]; exact Or.inr ⟨hc, g₁, hg₁, a₁, ha₁, hb₁⟩
    refine Or.inr ⟨hc, g₁ + g₂, (sectionsSubgroup _).add_mem hg₁ hg₂, a₁ + a₂,
      by rw [map_add, ha₁, ha₂], by rw [map_add, hb₁, hb₂, map_add]⟩
  · rintro a - ha
    rcases ha with rfl | ⟨hc, g₁, hg₁, a₁, ha₁, hb₁⟩
    · rw [neg_zero]; exact Or.inl rfl
    exact Or.inr ⟨hc, -g₁, (sectionsSubgroup _).neg_mem hg₁, -a₁, by rw [map_neg, ha₁],
      by rw [map_neg, hb₁, map_neg]⟩

section RestrictWitness

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [NoetherianSpace X] (hXs : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
  [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
  [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
  [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
  (hSs : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))

include hXs hSs in
/-- **Powers of a restricted section.** -/
private theorem restrict_witness_pow {M : Divisor X} (hMS : M.coeff S = 0)
    {σ : X.functionField} (hσ : σ ∈ sectionsIn M)
    {h : (haveI := S.integral; S.idealSheaf.subscheme.functionField)}
    (hres : IsRestrictionAlong S σ h) (hh : h ≠ 0)
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) (j : ℕ) :
    haveI := S.integral
    σ ^ j ∈ sectionsIn ((j : ℤ) • M) ∧ IsRestrictionAlong S (σ ^ j) (h ^ j) ∧ h ^ j ≠ 0 ∧
      S.idealSheaf.subscheme.ord (h ^ j) G.genericPoint +
          (((j : ℤ) • M).restrictPrimeDivisor S).coeff G =
        j * (S.idealSheaf.subscheme.ord h G.genericPoint + (M.restrictPrimeDivisor S).coeff G) := by
  haveI := S.integral
  refine ⟨pow_mem_sectionsIn hσ j, ?_, pow_ne_zero _ hh, ?_⟩
  · induction j with
    | zero => simpa using isRestrictionAlong_one S
    | succ j ih => rw [pow_succ, pow_succ]; exact IsRestrictionAlong.mul ih hres
  · rw [restrictPrimeDivisor_zsmul S hMS, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      ← zpow_natCast, MMP.Mori.ord_zpow _ hh]
    ring

include hXs hSs in
/-- **Products of restricted sections.** -/
private theorem restrict_witness_mul {M₁ M₂ : Divisor X} (h₁S : M₁.coeff S = 0)
    (h₂S : M₂.coeff S = 0) {σ₁ σ₂ : X.functionField} (hσ₁ : σ₁ ∈ sectionsIn M₁)
    (hσ₂ : σ₂ ∈ sectionsIn M₂)
    {h₁ h₂ : (haveI := S.integral; S.idealSheaf.subscheme.functionField)}
    (hr₁ : IsRestrictionAlong S σ₁ h₁) (hr₂ : IsRestrictionAlong S σ₂ h₂) (hh₁ : h₁ ≠ 0)
    (hh₂ : h₂ ≠ 0) (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    haveI := S.integral
    σ₁ * σ₂ ∈ sectionsIn (M₁ + M₂) ∧ IsRestrictionAlong S (σ₁ * σ₂) (h₁ * h₂) ∧
      h₁ * h₂ ≠ 0 ∧
      S.idealSheaf.subscheme.ord (h₁ * h₂) G.genericPoint +
          ((M₁ + M₂).restrictPrimeDivisor S).coeff G =
        (S.idealSheaf.subscheme.ord h₁ G.genericPoint + (M₁.restrictPrimeDivisor S).coeff G) +
          (S.idealSheaf.subscheme.ord h₂ G.genericPoint +
            (M₂.restrictPrimeDivisor S).coeff G) := by
  haveI := S.integral
  refine ⟨mul_mem_sectionsIn hσ₁ hσ₂, IsRestrictionAlong.mul hr₁ hr₂, mul_ne_zero hh₁ hh₂, ?_⟩
  rw [restrictPrimeDivisor_add S h₁S h₂S, DivisorWithCoeffs.coeff_add, Scheme.ord_mul hh₁ hh₂]
  ring

include hXs hSs in
/-- **A section not vanishing at the image of `η_G` restricts to a section not vanishing along
`G`.** -/
private theorem restrict_witness_of_isNonvanishingAt {M : Divisor X} (hMS : M.coeff S = 0)
    {σ : X.functionField}
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hσ : IsNonvanishingAt M σ (haveI := S.integral; S.idealSheaf.subschemeι G.genericPoint)) :
    haveI := S.integral
    ∃ h, IsRestrictionAlong S σ h ∧ h ≠ 0 ∧
      S.idealSheaf.subscheme.ord h G.genericPoint + (M.restrictPrimeDivisor S).coeff G = 0 := by
  haveI := S.integral
  obtain ⟨h, hres, hh0, -, hG⟩ := exists_restriction_isNonvanishingAt sX hXs S hSs hMS hσ
  refine ⟨h, hres, hh0, ?_⟩
  by_contra hne
  apply hG
  refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨G, ?_, MMP.Flips.primeDivisor_genericPoint_mem_support G⟩
  rw [DivisorWithCoeffs.coeff_add, coeff_ffDiv]
  omega

end RestrictWitness

section AmplePerturb

variable {X Z : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- A positive rational multiple of a `ℚ`-divisor with an `f`-ample multiple has one. -/
private theorem hasRelativelyAmpleMultiple_inv_smul (f : X ⟶ Z) {D : QDivisor X}
    (hD : D.HasRelativelyAmpleMultiple f) {r : ℕ} (hr : 0 < r) :
    ((r : ℚ)⁻¹ • D).HasRelativelyAmpleMultiple f := by
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hD
  refine ⟨m * r, Nat.mul_pos hm hr, L, hLc, ?_, hLamp⟩
  rw [hLeq, ← Int.cast_smul_eq_zsmul ℚ, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
  congr 1
  have : (r : ℚ) ≠ 0 := by exact_mod_cast hr.ne'
  push_cast
  field_simp

/-- **Ampleness is open in a fixed direction.** If `M` has an `f`-ample multiple and `qN` is an
integral Cartier divisor, `M + δN` has an `f`-ample multiple for some arbitrarily small rational
`δ > 0`. -/
private theorem exists_hasRelativelyAmpleMultiple_add_smul (f : X ⟶ Z)
    (hf : IsProjectiveMorphism f) [IsAffine Z] {M N : QDivisor X}
    (hM : M.HasRelativelyAmpleMultiple f) {q : ℕ} (hq : 0 < q) {N' : Divisor X}
    (hN' : Divisor.toQDivisor N' = (q : ℚ) • N) (hN'c : N'.IsCartier) {δ₁ : ℚ} (hδ₁ : 0 < δ₁) :
    ∃ δ : ℚ, 0 < δ ∧ δ < δ₁ ∧ (M + δ • N).HasRelativelyAmpleMultiple f := by
  obtain ⟨p, hp, L, hLc, hLeq, hLamp⟩ := hM
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  have hH := isRelativelyAmpleCartier_of_isRelativelyAmple f hLc hLamp
  obtain ⟨j₀, hj₀⟩ := Filter.eventually_atTop.mp
    (eventually_isRelativelyAmpleCartier_nsmul_add f hH hN'c)
  obtain ⟨j₁, hj₁⟩ := exists_nat_gt ((q : ℚ) / (p * δ₁))
  set j := max j₀ (j₁ + 1) with hj
  have hjpos : 0 < j := lt_of_lt_of_le (Nat.succ_pos j₁) (le_max_right _ _)
  have hjq : (j₁ : ℚ) < j := by exact_mod_cast lt_of_lt_of_le (Nat.lt_succ_self j₁) (le_max_right _ _)
  have hamp := hj₀ j (le_max_left _ _)
  have hpq : (0 : ℚ) < p := by exact_mod_cast hp
  have hjq' : (0 : ℚ) < j := by exact_mod_cast hjpos
  refine ⟨q / (j * p), by positivity, ?_, j * p, Nat.mul_pos hjpos hp, _, hamp.choose, ?_,
    isRelativelyAmple_of_isRelativelyAmpleCartier f hamp⟩
  · rw [div_lt_iff₀ (by positivity)]
    rw [div_lt_iff₀ (by positivity)] at hj₁
    nlinarith
  · rw [map_add, map_nsmul, hLeq, hN']
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply]
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      nsmul_eq_mul, zsmul_eq_mul]
    push_cast
    field_simp

end AmplePerturb

section GoodIndex

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- An integral divisor with an `f`-ample `ℚ`-multiple has, after a further multiple, a section
not vanishing at any given point. -/
private theorem exists_nsmul_isNonvanishingAt_of_hasRelativelyAmpleMultiple
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX) (f : X ⟶ Z)
    (hf : IsProjectiveMorphism f) [IsAffine Z] {C : QDivisor X}
    (hC : C.HasRelativelyAmpleMultiple f) :
    ∃ (q : ℕ) (LC : Divisor X), 0 < q ∧ Divisor.toQDivisor LC = (q : ℚ) • C ∧
      ∀ x : X, ∃ g, IsNonvanishingAt LC g x := by
  obtain ⟨p, hp, LC, hLCc, hLCeq, hLCamp⟩ := hC
  have hLCa : LC.IsAmple hLCc := isAmple_of_hasRelativelyAmpleMultiple f hf hLCc
    ⟨1, one_pos, LC, hLCc, by rw [Nat.cast_one, one_smul], hLCamp⟩
  obtain ⟨m', hm', hg⟩ := exists_nsmul_isNonvanishingAt_of_isAmple sX hX hXs hLCc hLCa
  refine ⟨m' * p, (m' : ℤ) • LC, Nat.mul_pos hm' hp, ?_, hg⟩
  rw [map_zsmul, hLCeq, smul_smul, ← Int.cast_smul_eq_zsmul ℚ]
  push_cast
  ring_nf

/-- A section of `𝒪_X(M)` whose valuation along `S` is `exp(coeff_S M)` does not vanish at the
generic point of `S`. -/
private theorem isNonvanishingAt_genericPoint_of_divisorialValuation_eq {M : Divisor X}
    {S : MMP.Mori.PrimeDivisor X} {σ : X.functionField} (hσ : σ ∈ sectionsIn M)
    (hv : S.divisorialValuation σ = WithZero.exp (M.coeff S)) :
    IsNonvanishingAt M σ S.genericPoint := by
  have hσ0 : σ ≠ 0 := by
    rintro rfl
    rw [map_zero] at hv
    exact WithZero.exp_ne_zero hv.symm
  refine ⟨hσ0, hσ, fun hx => ?_⟩
  obtain ⟨Γ, hΓ, hxΓ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hxΓ] at hΓ
  apply hΓ
  rw [S.divisorialValuation_eq_exp_neg_ord hσ0, WithZero.exp_inj] at hv
  rw [DivisorWithCoeffs.coeff_add, coeff_ffDiv]
  omega

end GoodIndex

section RestrictedSeriesAPI

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [NoetherianSpace X] (hXs : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
  [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
  [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
  [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
  (hSs : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))

/-- A rational function whose image in `K(Y)` is a section of `𝒪_Y(M)` is a divisorial section. -/
private theorem mem_divisorialSections_of_mem_sectionsIn {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {M : Divisor Y} {s : RationalFunctions Y}
    (h : rationalFunctionsEquivFunctionField Y s ∈ sectionsIn M) : s ∈ divisorialSections M := by
  rw [mem_divisorialSections]
  intro E _
  change E.OrdGE (-M.coeff E) (s E.component)
  rw [← (rationalFunctionsEquivFunctionField Y).symm_apply_apply s]
  by_cases h0 : rationalFunctionsEquivFunctionField Y s = 0
  · rw [h0, map_zero]
    exact MMP.Mori.PrimeDivisor.OrdGE.zero _
  rw [ordGE_symm_iff E _ h0]
  have := ord_add_coeff_nonneg h h0 E
  omega

/-- The generators of the restricted series of `D` in degree `m`. -/
private abbrev restrictedSeriesGens (D : QDivisor X) (m : ℕ) :
    Set (RationalFunctions (haveI := S.integral; S.idealSheaf.subscheme)) :=
  haveI := S.integral
  {h | ((m : ℚ) • D).IsCartierDivisor ∧
    ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
      IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}

/-- For `mD` integral, `D = K_X + S + Δ'` with `K_X` of coefficient `-1` along `S`, the restriction
of `mD` to `S` is `m K_S + ⌊m Ω⌋`, `K_S = (K_X + S)|_S`, `Ω = Δ'|_S`. -/
private theorem restrictPrimeDivisor_eq_seriesDivisor (KX : Divisor X) (hKXS : KX.coeff S = -1)
    (Δ' : QDivisor X) (hΔ'S : Δ'.coeff S = 0) {m : ℕ} {Dm : Divisor X}
    (hDm : Divisor.toQDivisor Dm = (m : ℚ) • (Divisor.toQDivisor KX +
      (Divisor.toQDivisor (Finsupp.single S 1) + Δ'))) :
    haveI := S.integral
    Dm.coeff S = 0 ∧ Dm.restrictPrimeDivisor S =
      seriesDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S) (Δ'.restrictPrimeDivisor S) m := by
  haveI := S.integral
  have hKXS0 : (KX + Finsupp.single S 1).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self]; norm_num
  have hDmS : Dm.coeff S = 0 := by
    have := congrArg (fun D : QDivisor X => D.coeff S) hDm
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      hKXS, DivisorWithCoeffs.coeff_single_self, hΔ'S, smul_eq_mul] at this
    exact_mod_cast (show (Dm.coeff S : ℚ) = 0 by rw [this]; push_cast; ring)
  refine ⟨hDmS, ?_⟩
  have hq : Divisor.toQDivisor (Dm.restrictPrimeDivisor S) =
      (m : ℚ) • (Divisor.toQDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S) +
        Δ'.restrictPrimeDivisor S) := by
    have hKq : (Divisor.toQDivisor (KX + Finsupp.single S 1)).coeff S = 0 := by
      rw [Divisor.coeff_toQDivisor, hKXS0]; simp
    have e1 : Divisor.toQDivisor Dm = (m : ℚ) • (Divisor.toQDivisor (KX + Finsupp.single S 1) +
        Δ') := by rw [hDm, map_add]; congr 1; abel
    have hsum : (Divisor.toQDivisor (KX + Finsupp.single S 1) + Δ').coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_add, hKq, hΔ'S, add_zero]
    rw [← restrictPrimeDivisor_toQDivisor' S hDmS, e1, restrictPrimeDivisor_smul' S hsum,
      restrictPrimeDivisor_add' S hKq hΔ'S, restrictPrimeDivisor_toQDivisor' S hKXS0]
  set E := Dm.restrictPrimeDivisor S - (m : ℤ) • (KX + Finsupp.single S 1).restrictPrimeDivisor S
    with hE
  have hEq : Divisor.toQDivisor E = (m : ℚ) • Δ'.restrictPrimeDivisor S := by
    rw [hE, map_sub, hq, map_zsmul, smul_add, ← Int.cast_smul_eq_zsmul ℚ]
    push_cast
    abel
  rw [seriesDivisor, ← hEq, roundDown_toQDivisor', hE, natCast_zsmul]
  abel

include hXs hSs in
/-- The members of the restricted series of `D = K_X + S + Δ'` (with `K_X` of coefficient `-1`
along `S`) in degree `m` are sections of `m K_S + ⌊m Ω⌋`, `K_S = (K_X + S)|_S`, `Ω = Δ'|_S`. -/
private theorem mem_divisorialSections_seriesDivisor_of_mem_restrictedSeries (KX : Divisor X)
    (hKXS : KX.coeff S = -1) (Δ' : QDivisor X) (hΔ'S : Δ'.coeff S = 0) {m : ℕ}
    {s : RationalFunctions (haveI := S.integral; S.idealSheaf.subscheme)}
    (hs : s ∈ AddSubgroup.toIntSubmodule (AddSubgroup.closure
      (restrictedSeriesGens S (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) +
        Δ')) m))) :
    haveI := S.integral
    s ∈ divisorialSections (seriesDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S)
      (Δ'.restrictPrimeDivisor S) m) := by
  haveI := S.integral
  rcases mem_restrictedSeries_cases S _ m hs with rfl | ⟨⟨Dm, hDm, -⟩, g, hg, hres⟩
  · exact (divisorialSections _).zero_mem
  have hrw : DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
      (Divisor.toQDivisor (Finsupp.single S 1) + Δ'))) = Dm := by
    rw [← hDm, roundDown_toQDivisor']
  rw [hrw] at hg
  obtain ⟨hDmS, hser⟩ := restrictPrimeDivisor_eq_seriesDivisor S KX hKXS Δ' hΔ'S hDm
  have hsec := mem_sectionsIn_restrictPrimeDivisor sX hXs S hSs hDmS hg hres
  rw [hser] at hsec
  exact mem_divisorialSections_of_mem_sectionsIn hsec

include hXs hSs in
/-- **Ambient multiplicity is at most restricted order**, for effective divisors. -/
private theorem multiplicityAt_le_coeff_restrictPrimeDivisor {E : Divisor X}
    (hE0 : ∀ P, 0 ≤ E.coeff P) (hES : E.coeff S = 0)
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    haveI := S.integral
    E.multiplicityAt (S.idealSheaf.subschemeι G.genericPoint) ≤
      (E.restrictPrimeDivisor S).coeff G := by
  haveI := S.integral
  classical
  rw [coeff_restrictPrimeDivisor_eq_sum' S hES E.support subset_rfl G,
    DivisorWithCoeffs.multiplicityAt, Finsupp.sum]
  refine Finset.sum_le_sum fun P hP => ?_
  have hPS : P ≠ S := by
    rintro rfl
    exact Finsupp.mem_support_iff.mp hP hES
  have h1 := toNat_multiplicityAt_le_intersectionLength sX hXs S hSs P hPS G
  have h2 : 0 ≤ E P := hE0 P
  rw [nsmul_eq_mul, nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast h1) h2

end RestrictedSeriesAPI

section GoodIndexCases

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [NoetherianSpace X] (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX) (f : X ⟶ Z)
  (hf : IsProjectiveMorphism f) [IsAffine Z] (S : MMP.Mori.PrimeDivisor X)
  [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
  [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
  [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
  (hSs : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
  (KX : Divisor X) (hKXS : KX.coeff S = -1) (Δ' : QDivisor X) (hΔ'S : Δ'.coeff S = 0)

open scoped ENNReal in
include hX hXs hf hSs hKXS hΔ'S in
/-- **The vanishing case of the good index.** If the asymptotic restricted fixed part of
`D = K_X + S + Δ'` vanishes along `G`, then for the `f`-ample `C` some `l(D + C)` is integral and
has a section whose restriction to `S` does not vanish along `G`. This is the
zero-multiplicity removal lemma, fed by `mult_{η_G} ≤ ord_G` of restricted sections. -/
private theorem exists_witness_of_restrictedAsymptoticFixedPart_eq_zero
    (hD0 : ∃ m : ℕ, 0 < m ∧ ((m : ℚ) • (Divisor.toQDivisor KX +
        (Divisor.toQDivisor (Finsupp.single S 1) + Δ'))).IsCartierDivisor ∧
      ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
        (Divisor.toQDivisor (Finsupp.single S 1) + Δ')))), σ ≠ 0)
    {C : QDivisor X} (hC : C.HasRelativelyAmpleMultiple f) (hCS : C.coeff S = 0)
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hF0 : haveI := S.integral; restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) (Δ'.restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S
        (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')) m))) G = 0) :
    haveI := S.integral
    ∃ l : ℕ, 0 < l ∧ ∃ Dl : Divisor X, Divisor.toQDivisor Dl = (l : ℚ) •
      (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ') + C) ∧
      ∃ σ ∈ sectionsIn Dl, ∃ h, IsRestrictionAlong S σ h ∧ h ≠ 0 ∧
        S.idealSheaf.subscheme.ord h G.genericPoint + (Dl.restrictPrimeDivisor S).coeff G = 0 := by
  haveI := S.integral
  classical
  set D : QDivisor X := Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')
    with hD
  set KS := (KX + Finsupp.single S 1).restrictPrimeDivisor S with hKS
  set Ω := Δ'.restrictPrimeDivisor S with hΩ
  set V : ℕ → Submodule ℤ (RationalFunctions S.idealSheaf.subscheme) := fun m =>
    AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S D m)) with hV
  have hzq : ∀ m : ℕ, ((m : ℤ) • D : QDivisor X) = (m : ℚ) • D := fun m => by
    rw [← Int.cast_smul_eq_zsmul ℚ]; push_cast; rfl
  set x := S.idealSheaf.subschemeι G.genericPoint with hx
  -- the multiplicity hypothesis of the removal lemma
  have hmult : ∀ ε : ℚ, 0 < ε → ∃ m : ℕ, 0 < m ∧ ((m : ℤ) • D).IsCartierDivisor ∧
      ∃ (s : X.functionField) (hs : s ≠ 0),
        s ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℤ) • D)) ∧
        (((DivisorWithCoeffs.roundDown ((m : ℤ) • D) + principalDivisor
          (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
            (Units.mk0 s hs))).multiplicityAt x : ℤ) : ℚ) < ε * m := by
    intro ε hε
    have hlt : restrictedAsymptoticFixedPart KS Ω 1 V G < ENNReal.ofReal ε := by
      rw [hF0]; exact ENNReal.ofReal_pos.mpr (by exact_mod_cast hε)
    unfold restrictedAsymptoticFixedPart at hlt
    obtain ⟨n, hlt⟩ := iInf_lt_iff.mp hlt
    obtain ⟨hn, hlt⟩ := iInf_lt_iff.mp hlt
    set m := 1 * n.factorial with hm
    have hm0 : 0 < m := by rw [hm, one_mul]; exact Nat.factorial_pos n
    unfold restrictedNormalizedFixedPart at hlt
    have hmem : ∀ s ∈ V m, s ∈ divisorialSections (seriesDivisor KS Ω m) := fun s hs =>
      mem_divisorialSections_seriesDivisor_of_mem_restrictedSeries sX hXs S hSs KX hKXS Δ' hΔ'S hs
    have hne : ∃ s ∈ V m, s ≠ 0 := by
      by_contra hne
      push Not at hne
      have : restrictedFixedMultiplicity KS Ω V m G = ⊤ := by
        unfold restrictedFixedMultiplicity
        exact iInf_eq_top.mpr fun s => iInf_eq_top.mpr fun hsV => iInf_eq_top.mpr fun _ =>
          iInf_eq_top.mpr fun h0 => absurd (hne s hsV) h0
      rw [this] at hlt
      simp [ENNReal.top_div, hm0.ne'] at hlt
    obtain ⟨s, hsV, hs0, χ, hχ, -, hfm⟩ := exists_restrictedFixedMultiplicity_eq hmem hne G
    rcases mem_restrictedSeries_cases S D m hsV with h0 | ⟨⟨Dm, hDm, hDmc⟩, g, hg, hres⟩
    · exact absurd h0 hs0
    have hrw : DivisorWithCoeffs.roundDown ((m : ℚ) • D) = Dm := by
      rw [← hDm, roundDown_toQDivisor']
    rw [hrw] at hg
    obtain ⟨hDmS, hser⟩ := restrictPrimeDivisor_eq_seriesDivisor S KX hKXS Δ' hΔ'S hDm
    set h := rationalFunctionsEquivFunctionField _ s with hhdef
    have hh0 : h ≠ 0 := by
      rw [hhdef, ← hχ]; exact (χ.isUnit.map _).ne_zero
    obtain ⟨hg0, hordS⟩ := ne_zero_and_ord_eq_zero_of_isRestrictionAlong S hres hh0
    refine ⟨m, hm0, ⟨Dm, by rw [hDm, hzq], hDmc⟩, g, hg0, ?_, ?_⟩
    · rw [hzq, hrw]; exact hg
    · rw [hzq, hrw]
      -- `mult_x(D_m + div g) ≤ ord_G` of the restriction, which is the fixed multiplicity
      have hE0 : ∀ P, 0 ≤ (Dm + ffDiv g hg0).coeff P := coeff_add_ffDiv_nonneg hg hg0
      have hES : (Dm + ffDiv g hg0).coeff S = 0 := by
        rw [DivisorWithCoeffs.coeff_add, hDmS, zero_add, coeff_ffDiv, hordS]
      have h1 := multiplicityAt_le_coeff_restrictPrimeDivisor sX hXs S hSs hE0 hES G
      rw [restrictPrimeDivisor_add_ffDiv sX hXs S hSs Dm hDmS hres hg0 hh0,
        DivisorWithCoeffs.coeff_add, coeff_ffDiv, hser] at h1
      have hfmG : ((seriesDivisor KS Ω m).coeff G + G.ord χ) =
          (seriesDivisor KS Ω m).coeff G + S.idealSheaf.subscheme.ord h G.genericPoint := by
        rw [MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, hhdef, hχ]
      have hnn : 0 ≤ (seriesDivisor KS Ω m).coeff G + G.ord χ := by
        obtain ⟨χ', hχ', hχ'e⟩ := exists_unit_of_mem_divisorialSections (hmem s hsV) hs0
        have : χ' = χ := Units.ext (hχ'.trans hχ.symm)
        rw [← this]; exact hχ'e G
      -- the fixed multiplicity is `< ε m`
      rw [hfm] at hlt
      have hlt' : (((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℕ∞) : ℝ≥0∞)) <
          ENNReal.ofReal ε * (m : ℝ≥0∞) := by
        rwa [ENNReal.div_lt_iff (Or.inl (by exact_mod_cast hm0.ne')) (Or.inl (ENNReal.natCast_ne_top m))] at hlt
      have hlt'' : ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℝ)) < ε * m := by
        have h2 : (((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℕ∞) : ℝ≥0∞)) =
            ENNReal.ofReal ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℝ)) := by
          simp
        rw [h2, ← ENNReal.ofReal_natCast m, ← ENNReal.ofReal_mul (by exact_mod_cast hε.le)] at hlt'
        exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).mp hlt'
      have h3 : ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℤ)) =
          (seriesDivisor KS Ω m).coeff G + G.ord χ := Int.toNat_of_nonneg hnn
      have h4 : ((((Dm + ffDiv g hg0).multiplicityAt x : ℤ)) : ℝ) < ε * m := by
        have h5 : (((Dm + ffDiv g hg0).multiplicityAt x : ℤ) : ℝ) ≤
            ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℕ) : ℝ) := by
          have : (Dm + ffDiv g hg0).multiplicityAt x ≤
              (((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℤ) := by
            rw [h3, hfmG]; linarith
          exact_mod_cast this
        linarith
      exact_mod_cast h4
  -- the removal lemma
  have hDq : D.IsQCartier := MMP.Fourfold.isQCartier_of_isSmoothScheme hXs D
  have hD0' : ∃ m : ℕ, 0 < m ∧ ((m : ℤ) • D).IsCartierDivisor ∧
      ∃ s ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℤ) • D)), s ≠ 0 := by
    obtain ⟨m, hm, hmc, σ, hσ, hσ0⟩ := hD0
    exact ⟨m, hm, by rw [hzq]; exact hmc, σ, by rw [hzq]; exact hσ, hσ0⟩
  obtain ⟨m, hm, -, hmc, s, hs, hxs⟩ :=
    MMP.Fourfold.exists_notMem_baseLocusIn_of_forall_multiplicityAt_lt sX hX hXs f hf D hDq hD0' x
      hmult C hC 1 one_pos
  obtain ⟨Dl, hDl, -⟩ := hmc
  have hrw : DivisorWithCoeffs.roundDown ((m : ℤ) • (D + C)) = Dl := by
    rw [← hDl, roundDown_toQDivisor']
  rw [hrw] at hs hxs
  obtain ⟨σ, hσmem, hσ⟩ := exists_isNonvanishingAt_of_notMem_baseLocusIn
    (V := {s}) (by rintro _ rfl; exact hs) hxs
  rw [Set.mem_singleton_iff] at hσmem
  subst hσmem
  have hDlS : Dl.coeff S = 0 := by
    have := congrArg (fun D : QDivisor X => D.coeff S) hDl
    simp only [hD, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self, hΔ'S, hCS,
      smul_eq_mul] at this
    exact_mod_cast (show (Dl.coeff S : ℚ) = 0 by rw [this]; push_cast; ring)
  obtain ⟨h, hres, hh0, hord⟩ := restrict_witness_of_isNonvanishingAt sX hXs S hSs hDlS G hσ
  refine ⟨m, hm, Dl, by rw [hDl, ← Int.cast_smul_eq_zsmul ℚ]; push_cast; rfl, σ, hs, h, hres,
    hh0, hord⟩

open scoped ENNReal in
include hXs hSs hKXS hΔ'S in
/-- **The positive case of the good index.** If the asymptotic restricted fixed part `F_G` of
`D = K_X + S + Δ'` is finite and positive along `G`, `μ = u/v < λ`, and `L_R = q_R((1 - μ)D + C)`
is integral and free, then some `l(D + C)` is integral and has a section whose restriction to `S`
vanishes along `G` to order at most `l λ F_G`: a member of `|mD|_S` nearly computing `F_{m}` with
`F_m < (λ/μ) F_G`, raised to the power `u q_R`, times a free member of `|L_R|`. -/
private theorem exists_witness_of_restrictedAsymptoticFixedPart_pos {C : QDivisor X}
    (hCS : C.coeff S = 0) {u v : ℕ} (hu : 0 < u) (hv : 0 < v) {qR : ℕ} (hqR : 0 < qR)
    {LR : Divisor X} (hLR : Divisor.toQDivisor LR = (qR : ℚ) • ((1 - (u : ℚ) / v) •
      (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')) + C))
    (hfree : ∀ x : X, ∃ g, IsNonvanishingAt LR g x) {lam : ℝ}
    (hlam : (((u : ℚ) / v : ℚ) : ℝ) < lam)
    (G : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hF0 : haveI := S.integral; restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) (Δ'.restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S
        (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')) m))) G ≠ 0)
    (hFtop : haveI := S.integral; restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) (Δ'.restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S
        (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')) m))) G ≠ ⊤) :
    haveI := S.integral
    ∃ l : ℕ, 0 < l ∧ ∃ Dl : Divisor X, Divisor.toQDivisor Dl = (l : ℚ) •
      (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ') + C) ∧
      ∃ σ ∈ sectionsIn Dl, ∃ h, IsRestrictionAlong S σ h ∧ h ≠ 0 ∧
        (((S.idealSheaf.subscheme.ord h G.genericPoint + (Dl.restrictPrimeDivisor S).coeff G : ℤ)
          : ℝ) ≤ l * lam * (restrictedAsymptoticFixedPart
            ((KX + Finsupp.single S 1).restrictPrimeDivisor S) (Δ'.restrictPrimeDivisor S) 1
            (fun m => AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S
              (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')) m)))
              G).toReal) := by
  haveI := S.integral
  classical
  set D : QDivisor X := Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')
    with hD
  set KS := (KX + Finsupp.single S 1).restrictPrimeDivisor S with hKS
  set Ω := Δ'.restrictPrimeDivisor S with hΩ
  set V : ℕ → Submodule ℤ (RationalFunctions S.idealSheaf.subscheme) := fun m =>
    AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S D m)) with hV
  set Fa := restrictedAsymptoticFixedPart KS Ω 1 V with hFa
  set φ := (Fa G).toReal with hφ
  have hφ0 : 0 < φ := ENNReal.toReal_pos hF0 hFtop
  have hμ0 : (0 : ℝ) < ((u : ℚ) / v : ℚ) := by
    have : (0 : ℚ) < (u : ℚ) / v := by positivity
    exact_mod_cast this
  set κ := lam / ((u : ℚ) / v : ℚ) with hκ
  have hκ1 : 1 < κ := by rw [hκ, one_lt_div hμ0]; exact hlam
  -- a factorial index with `F_m < κ F_G`
  have hlt : Fa G < ENNReal.ofReal (κ * φ) := by
    rw [← ENNReal.ofReal_toReal hFtop]
    exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by nlinarith)
  rw [hFa] at hlt
  unfold restrictedAsymptoticFixedPart at hlt
  obtain ⟨n, hlt⟩ := iInf_lt_iff.mp hlt
  obtain ⟨hn, hlt⟩ := iInf_lt_iff.mp hlt
  set m := 1 * n.factorial with hm
  have hm0 : 0 < m := by rw [hm, one_mul]; exact Nat.factorial_pos n
  unfold restrictedNormalizedFixedPart at hlt
  have hmem : ∀ s ∈ V m, s ∈ divisorialSections (seriesDivisor KS Ω m) := fun s hs =>
    mem_divisorialSections_seriesDivisor_of_mem_restrictedSeries sX hXs S hSs KX hKXS Δ' hΔ'S hs
  have hne : ∃ s ∈ V m, s ≠ 0 := by
    by_contra hne
    push Not at hne
    have : restrictedFixedMultiplicity KS Ω V m G = ⊤ := by
      unfold restrictedFixedMultiplicity
      exact iInf_eq_top.mpr fun s => iInf_eq_top.mpr fun hsV => iInf_eq_top.mpr fun _ =>
        iInf_eq_top.mpr fun h0 => absurd (hne s hsV) h0
    rw [this] at hlt
    simp [ENNReal.top_div, hm0.ne'] at hlt
  obtain ⟨s, hsV, hs0, χ, hχ, -, hfm⟩ := exists_restrictedFixedMultiplicity_eq hmem hne G
  rcases mem_restrictedSeries_cases S D m hsV with h0 | ⟨⟨Dm, hDm, hDmc⟩, g, hg, hres⟩
  · exact absurd h0 hs0
  have hrw : DivisorWithCoeffs.roundDown ((m : ℚ) • D) = Dm := by
    rw [← hDm, roundDown_toQDivisor']
  rw [hrw] at hg
  obtain ⟨hDmS, hser⟩ := restrictPrimeDivisor_eq_seriesDivisor S KX hKXS Δ' hΔ'S hDm
  set h := rationalFunctionsEquivFunctionField _ s with hhdef
  have hh0 : h ≠ 0 := by
    rw [hhdef, ← hχ]; exact (χ.isUnit.map _).ne_zero
  have hfmG : ((seriesDivisor KS Ω m).coeff G + G.ord χ) =
      S.idealSheaf.subscheme.ord h G.genericPoint + (Dm.restrictPrimeDivisor S).coeff G := by
    rw [MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, hhdef, hχ, hser]; ring
  have hnn : 0 ≤ (seriesDivisor KS Ω m).coeff G + G.ord χ := by
    obtain ⟨χ', hχ', hχ'e⟩ := exists_unit_of_mem_divisorialSections (hmem s hsV) hs0
    have : χ' = χ := Units.ext (hχ'.trans hχ.symm)
    rw [← this]; exact hχ'e G
  set w := S.idealSheaf.subscheme.ord h G.genericPoint + (Dm.restrictPrimeDivisor S).coeff G
    with hw
  have hwlt : (w : ℝ) < κ * φ * m := by
    rw [hfm] at hlt
    rw [ENNReal.div_lt_iff (Or.inl (by exact_mod_cast hm0.ne')) (Or.inl (ENNReal.natCast_ne_top m))] at hlt
    have h2 : ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℕ∞) : ℝ≥0∞) =
        ENNReal.ofReal ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℝ)) := by simp
    rw [h2, ← ENNReal.ofReal_natCast m, ← ENNReal.ofReal_mul (by positivity)] at hlt
    have h3 := (ENNReal.ofReal_lt_ofReal_iff (by positivity)).mp hlt
    have h4 : ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℤ)) =
        (seriesDivisor KS Ω m).coeff G + G.ord χ := Int.toNat_of_nonneg hnn
    have h5 : (w : ℝ) = ((((seriesDivisor KS Ω m).coeff G + G.ord χ).toNat : ℕ) : ℝ) := by
      rw [← hfmG]; exact_mod_cast h4.symm
    rw [h5]; linarith
  -- the free part
  have hLRS : LR.coeff S = 0 := by
    have := congrArg (fun D : QDivisor X => D.coeff S) hLR
    simp only [hD, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self, hΔ'S, hCS,
      smul_eq_mul] at this
    exact_mod_cast (show (LR.coeff S : ℚ) = 0 by rw [this]; push_cast; ring)
  obtain ⟨gR, hgR⟩ := hfree (S.idealSheaf.subschemeι G.genericPoint)
  obtain ⟨hR, hresR, hhR0, hordR⟩ := restrict_witness_of_isNonvanishingAt sX hXs S hSs hLRS G hgR
  -- the product `g^{u q_R} g_R^{v m}`
  obtain ⟨hpa, hra, hha, hoa⟩ := restrict_witness_pow sX hXs S hSs hDmS hg hres hh0 G (u * qR)
  obtain ⟨hpb, hrb, hhb, hob⟩ := restrict_witness_pow sX hXs S hSs hLRS hgR.2.1 hresR hhR0 G
    (v * m)
  have hS1 : (((u * qR : ℕ) : ℤ) • Dm).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_smul, hDmS, smul_zero]
  have hS2 : (((v * m : ℕ) : ℤ) • LR).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_smul, hLRS, smul_zero]
  obtain ⟨hpab, hrab, hhab, hoab⟩ := restrict_witness_mul sX hXs S hSs hS1 hS2 hpa hpb hra hrb
    hha hhb G
  refine ⟨v * m * qR, by positivity, ((u * qR : ℕ) : ℤ) • Dm + ((v * m : ℕ) : ℤ) • LR, ?_,
    _, hpab, _, hrab, hhab, ?_⟩
  · rw [map_add, map_zsmul, map_zsmul, hDm, hLR, ← Int.cast_smul_eq_zsmul ℚ,
      ← Int.cast_smul_eq_zsmul ℚ]
    have hv' : (v : ℚ) ≠ 0 := by exact_mod_cast hv.ne'
    refine Finsupp.ext fun P => ?_
    simp only [Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
      smul_add, Int.cast_natCast]
    push_cast
    field_simp
    ring
  · rw [hoab, hoa, hob, hordR, ← hw, mul_zero, add_zero]
    have hu' : (0 : ℝ) ≤ ((u * qR : ℕ) : ℝ) := by positivity
    have key : (((u * qR : ℕ) : ℤ) * w : ℝ) ≤ ((u * qR : ℕ) : ℝ) * (κ * φ * m) :=
      by push_cast; exact mul_le_mul_of_nonneg_left hwlt.le (by positivity)
    have hκ' : κ * (((u : ℚ) / v : ℚ) : ℝ) = lam := by
      rw [hκ]; field_simp
    have hv'' : (v : ℝ) ≠ 0 := by exact_mod_cast hv.ne'
    calc (((((u * qR : ℕ) : ℤ) * w : ℤ) : ℝ)) ≤ ((u * qR : ℕ) : ℝ) * (κ * φ * m) := by
          exact_mod_cast key
      _ = ((v * m * qR : ℕ) : ℝ) * lam * φ := by
          rw [← hκ']
          push_cast
          field_simp

end GoodIndexCases

/-! ### Extension with one effective twist -/

section Core

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **A good index** (the first step of the source's proof). With `C = A/c` and
`λ = 1 - ε/c`, there is `l > 0` such that `l(D + C)` is integral, has a section not vanishing
along `S`, and for every prime divisor `G` of `S` some section of `𝒪_X(l(D + C))` has a nonzero
restriction to `S` vanishing along `G` to order at most `l λ F_G`. -/
private theorem exists_good_index (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] [IsNormal Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (hA : A.HasRelativelyAmpleMultiple f)
    (c : ℕ) (hc : 0 < c)
    (hplt : IsPltPair sX n KX
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A))
    (hfloor : DivisorWithCoeffs.roundDown
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A) = Finsupp.single S 1)
    (hcan : haveI := S.integral; IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
      (QDivisor.toRDivisor ((A + B).restrictPrimeDivisor S + A.restrictPrimeDivisor S)))
    (hsec : ∃ m : ℕ, 0 < m ∧ ((m : ℚ) • (Divisor.toQDivisor KX +
        (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
      ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
          (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
        S.divisorialValuation σ = WithZero.exp ((DivisorWithCoeffs.roundDown ((m : ℚ) •
          (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))).coeff S))
    (F : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme) → ENNReal)
    (hF : haveI := S.integral; F = restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) ((A + B).restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule <| AddSubgroup.closure
        {h | ((m : ℚ) • (Divisor.toQDivisor KX +
            (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
          ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
              (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
            IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}))
    (hAF : haveI := S.integral; ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0)
    (ε : ℚ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (hεA : (ε • (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)) +
      A).HasRelativelyAmpleMultiple f)
    (hcΔ : ((c : ℚ) • (Divisor.toQDivisor (Finsupp.single S 1) + A + B)).IsCartierDivisor)
    (Φ : haveI := S.integral; QDivisor S.idealSheaf.subscheme)
    (hcΦ : ((c : ℚ) • Φ).IsCartierDivisor)
    (hΦlo : haveI := S.integral; coeffwiseMin ((A + B).restrictPrimeDivisor S)
      (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤ QDivisor.toRDivisor Φ)
    (hΦhi : Φ ≤ (A + B).restrictPrimeDivisor S)  :
    haveI := S.integral
    ∃ l : ℕ, 0 < l ∧ ∃ Dl : Divisor X, Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A) ∧
      (∃ σ₀ ∈ sectionsIn Dl, σ₀ ≠ 0 ∧ S.divisorialValuation σ₀ = 1) ∧
      ∀ G : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme, F G ≠ ⊤ ∧
        ∃ σ ∈ sectionsIn Dl, ∃ h : S.idealSheaf.subscheme.functionField,
          IsRestrictionAlong S σ h ∧ ∃ hh : h ≠ 0,
            (((S.idealSheaf.subscheme.ord h G.genericPoint +
              (Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℝ) ≤
                (l : ℝ) * (1 - (ε : ℝ) / c) * (F G).toReal) := by
  haveI := S.integral
  classical
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : NoetherianSpace X := MMP.Resolution.Aux.noetherianSpace_of_finiteType sX
  subst hF
  simp only [add_assoc] at hsec hεA ⊢
  set Δ' : QDivisor X := A + B with hΔ'
  have hΔ'S : Δ'.coeff S = 0 := by
    rw [hΔ', DivisorWithCoeffs.coeff_add, hAS, hBS, add_zero]
  set D : QDivisor X := Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + Δ')
    with hD
  set C : QDivisor X := (c : ℚ)⁻¹ • A with hC
  have hCS : C.coeff S = 0 := by rw [hC, DivisorWithCoeffs.coeff_smul, hAS, smul_zero]
  have hCamp : C.HasRelativelyAmpleMultiple f := hasRelativelyAmpleMultiple_inv_smul f hA hc
  have hDC : Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + (A + (B +
      (c : ℚ)⁻¹ • A))) = D + C := by rw [hD, hC, hΔ']; abel
  rw [hDC]
  set V : ℕ → Submodule ℤ (RationalFunctions S.idealSheaf.subscheme) := fun m =>
    AddSubgroup.toIntSubmodule (AddSubgroup.closure (restrictedSeriesGens S D m)) with hV
  set F := restrictedAsymptoticFixedPart ((KX + Finsupp.single S 1).restrictPrimeDivisor S)
    (Δ'.restrictPrimeDivisor S) 1 V with hFdef
  set lam : ℝ := 1 - (ε : ℝ) / c with hlam
  have hc1 : (1 : ℚ) ≤ c := by exact_mod_cast hc
  have hεc : ε / c < 1 := by rw [div_lt_one (by linarith)]; linarith
  have hεc0 : 0 < ε / c := by positivity
  have hlam0 : 0 ≤ lam := by
    have : ((ε / c : ℚ) : ℝ) < 1 := by exact_mod_cast hεc
    rw [hlam]; push_cast at this; linarith
  -- the base section, not vanishing along `S`
  obtain ⟨m₀, hm₀, ⟨D₀, hD₀, hD₀c⟩, σ₁, hσ₁, hvS⟩ := hsec
  have hrw₀ : DivisorWithCoeffs.roundDown ((m₀ : ℚ) • D) = D₀ := by
    rw [← hD₀, roundDown_toQDivisor']
  rw [hrw₀] at hσ₁ hvS
  have hσ₁S := isNonvanishingAt_genericPoint_of_divisorialValuation_eq hσ₁ hvS
  obtain ⟨hD₀S, -⟩ := restrictPrimeDivisor_eq_seriesDivisor S KX hKXS Δ' hΔ'S hD₀
  obtain ⟨qC, LC, hqC, hLC, hfreeC⟩ :=
    exists_nsmul_isNonvanishingAt_of_hasRelativelyAmpleMultiple sX hX hXs f hf hCamp
  obtain ⟨gC, hgC⟩ := hfreeC S.genericPoint
  set Dl₀ : Divisor X := (qC : ℤ) • D₀ + (m₀ : ℤ) • LC with hDl₀
  set σb := σ₁ ^ qC * gC ^ m₀ with hσbdef
  have hσb : IsNonvanishingAt Dl₀ σb S.genericPoint := (hσ₁S.pow qC).mul (hgC.pow m₀)
  have hDl₀q : Divisor.toQDivisor Dl₀ = ((m₀ * qC : ℕ) : ℚ) • (D + C) := by
    rw [hDl₀, map_add, map_zsmul, map_zsmul, hD₀, hLC, ← Int.cast_smul_eq_zsmul ℚ,
      ← Int.cast_smul_eq_zsmul ℚ, smul_smul, smul_smul,
      show ((m₀ * qC : ℕ) : ℚ) • (D + C) = ((m₀ * qC : ℕ) : ℚ) • D + ((m₀ * qC : ℕ) : ℚ) • C
        from smul_add _ _ _]
    congr 2 <;> push_cast <;> ring
  have hDl₀S : Dl₀.coeff S = 0 := by
    have := congrArg (fun D : QDivisor X => D.coeff S) hDl₀q
    simp only [hD, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
      DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self, hΔ'S, hCS,
      smul_eq_mul] at this
    exact_mod_cast (show (Dl₀.coeff S : ℚ) = 0 by rw [this]; push_cast; ring)
  obtain ⟨hσb0, hσbsec, hσbS⟩ := hσb
  have hordσb : X.ord σb S.genericPoint = 0 := by
    by_contra hne
    apply hσbS
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨S, ?_, MMP.Flips.primeDivisor_genericPoint_mem_support S⟩
    rw [DivisorWithCoeffs.coeff_add, hDl₀S, zero_add, coeff_ffDiv]
    exact hne
  obtain ⟨hb, hresb⟩ := exists_isRestrictionAlong_of_mem_sectionsIn S hDl₀S hσbsec
  have hhb0 := ne_zero_of_isRestrictionAlong S hresb hσb0 hordσb
  set Sg := (Dl₀.restrictPrimeDivisor S + ffDiv hb hhb0).support with hSg
  have hbase : ∀ G, G ∉ Sg →
      S.idealSheaf.subscheme.ord hb G.genericPoint + (Dl₀.restrictPrimeDivisor S).coeff G = 0 := by
    intro G hG
    rw [hSg, Finsupp.notMem_support_iff, ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_add, coeff_ffDiv] at hG
    linarith
  -- `F` is finite
  have hmem : ∀ m, ∀ s ∈ V m, s ∈ divisorialSections
      (seriesDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S)
        (Δ'.restrictPrimeDivisor S) m) := fun m s hs =>
    mem_divisorialSections_seriesDivisor_of_mem_restrictedSeries sX hXs S hSs KX hKXS Δ' hΔ'S hs
  have hFtop : ∀ G, F G ≠ ⊤ := by
    intro G
    obtain ⟨h₁, hres₁⟩ := exists_isRestrictionAlong_of_mem_sectionsIn S hD₀S hσ₁
    have hσ₁0 : σ₁ ≠ 0 := hσ₁S.1
    have hord₁ : X.ord σ₁ S.genericPoint = 0 := by
      by_contra hne
      apply hσ₁S.2.2
      refine DivisorWithCoeffs.mem_supp_iff.mpr
        ⟨S, ?_, MMP.Flips.primeDivisor_genericPoint_mem_support S⟩
      rw [DivisorWithCoeffs.coeff_add, hD₀S, zero_add, coeff_ffDiv]
      exact hne
    have hh₁0 := ne_zero_of_isRestrictionAlong S hres₁ hσ₁0 hord₁
    obtain ⟨a, ha⟩ : m₀ ∣ m₀.factorial := Nat.dvd_factorial hm₀ le_rfl
    obtain ⟨hpa, hra, hha, -⟩ := restrict_witness_pow sX hXs S hSs hD₀S hσ₁ hres₁ hh₁0 G a
    set s := (rationalFunctionsEquivFunctionField S.idealSheaf.subscheme).symm (h₁ ^ a) with hs
    have hsV : s ∈ V (1 * m₀.factorial) := by
      refine AddSubgroup.subset_closure ⟨⟨(a : ℤ) • D₀, ?_,
        MMP.Fourfold.isCartier_of_isSmoothScheme hXs _⟩, σ₁ ^ a, ?_, ?_⟩
      · rw [map_zsmul, hD₀, ← Int.cast_smul_eq_zsmul ℚ, smul_smul, one_mul, ha]
        push_cast; ring_nf
      · have e : DivisorWithCoeffs.roundDown (((1 * m₀.factorial : ℕ) : ℚ) • D) = (a : ℤ) • D₀ := by
          rw [← roundDown_toQDivisor' ((a : ℤ) • D₀), map_zsmul, hD₀,
            ← Int.cast_smul_eq_zsmul ℚ, smul_smul, one_mul, ha]
          push_cast; ring_nf
        rw [e]; exact hpa
      · rw [hs, RingEquiv.apply_symm_apply]; exact hra
    have hs0 : s ≠ 0 := by
      rw [hs]; exact fun h0 => hha ((RingEquiv.symm_apply_eq _).mp h0 |>.trans (map_zero _))
    have hfm := restrictedFixedMultiplicity_ne_top (hmem _) ⟨s, hsV, hs0⟩ G
    have hle : F G ≤ restrictedNormalizedFixedPart ((KX + Finsupp.single S 1).restrictPrimeDivisor S)
        (Δ'.restrictPrimeDivisor S) V (1 * m₀.factorial) G :=
      iInf₂_le m₀ hm₀
    refine ne_top_of_le_ne_top ?_ hle
    exact ENNReal.div_ne_top (ENat.toENNReal_ne_top.mpr hfm)
      (by rw [one_mul]; exact_mod_cast (Nat.factorial_pos m₀).ne')
  -- the free twist `ηD + C`, `η = ε/c + δ`
  have hM : ((ε / c : ℚ) • D + C).HasRelativelyAmpleMultiple f := by
    have := hasRelativelyAmpleMultiple_inv_smul f hεA hc
    have e : (c : ℚ)⁻¹ • (ε • D + A) = (ε / c) • D + C := by
      rw [smul_add, smul_smul, hC, div_eq_inv_mul]
    exact e ▸ this
  obtain ⟨δ, hδ0, hδ1, hR⟩ := exists_hasRelativelyAmpleMultiple_add_smul f hf hM hm₀ hD₀
    (MMP.Fourfold.isCartier_of_isSmoothScheme hXs D₀) (δ₁ := 1 - ε / c) (by linarith)
  set μ : ℚ := 1 - ε / c - δ with hμ
  have hμ0 : 0 < μ := by rw [hμ]; linarith
  set u := μ.num.toNat with hu
  set v := μ.den with hv
  have hu0 : 0 < u := by
    rw [hu]; have := Rat.num_pos.mpr hμ0; omega
  have hv0 : 0 < v := μ.den_pos
  have huv : (u : ℚ) / v = μ := by
    rw [hu, hv]
    have : ((μ.num.toNat : ℤ) : ℚ) = μ.num := by
      rw [Int.toNat_of_nonneg (Rat.num_nonneg.mpr hμ0.le)]
    rw [show ((μ.num.toNat : ℕ) : ℚ) = ((μ.num.toNat : ℤ) : ℚ) by norm_cast, this]
    exact Rat.num_div_den μ
  have hR' : ((1 - (u : ℚ) / v) • D + C).HasRelativelyAmpleMultiple f := by
    convert hR using 1
    rw [huv, hμ]
    rw [show (1 : ℚ) - (1 - ε / c - δ) = ε / c + δ by ring, add_smul]
    abel
  obtain ⟨qR, LR, hqR, hLR, hfreeR⟩ :=
    exists_nsmul_isNonvanishingAt_of_hasRelativelyAmpleMultiple sX hX hXs f hf hR'
  have hlamμ : (((u : ℚ) / v : ℚ) : ℝ) < lam := by
    rw [huv, hlam]
    have : μ < 1 - ε / c := by rw [hμ]; linarith
    have h2 : ((μ : ℚ) : ℝ) < ((1 - ε / c : ℚ) : ℝ) := by exact_mod_cast this
    push_cast at h2
    exact h2
  -- the witnesses along the finitely many primes of `Sg`
  have hD0' : ∃ m : ℕ, 0 < m ∧ ((m : ℚ) • D).IsCartierDivisor ∧
      ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)), σ ≠ 0 :=
    ⟨m₀, hm₀, ⟨D₀, hD₀, hD₀c⟩, σ₁, by rw [hrw₀]; exact hσ₁, hσ₁S.1⟩
  have hw : ∀ G ∈ Sg, ∃ l : ℕ, 0 < l ∧ ∃ Dl : Divisor X,
      Divisor.toQDivisor Dl = (l : ℚ) • (D + C) ∧ ∃ σ ∈ sectionsIn Dl, ∃ h,
        IsRestrictionAlong S σ h ∧ h ≠ 0 ∧
          (((S.idealSheaf.subscheme.ord h G.genericPoint + (Dl.restrictPrimeDivisor S).coeff G :
            ℤ) : ℝ) ≤ l * lam * (F G).toReal) := by
    intro G _
    by_cases hF0 : F G = 0
    · obtain ⟨l, hl, Dl, hDl, σ, hσ, h, hres, hh, hord⟩ :=
        exists_witness_of_restrictedAsymptoticFixedPart_eq_zero sX hX hXs f hf S hSs KX hKXS
          Δ' hΔ'S hD0' hCamp hCS G hF0
      refine ⟨l, hl, Dl, hDl, σ, hσ, h, hres, hh, ?_⟩
      rw [hord, hF0]
      simp
    · exact exists_witness_of_restrictedAsymptoticFixedPart_pos sX hXs S hSs KX hKXS Δ' hΔ'S hCS
        hu0 hv0 hqR hLR hfreeR hlamμ G hF0 (hFtop G)
  choose! lG hlG DlG hDlG σG hσG hG hresG hhG hbndG using hw
  -- a common index
  set kb := ∏ G ∈ Sg, lG G with hkb
  have hkb0 : 0 < kb := Finset.prod_pos fun G hG => hlG G hG
  set L := m₀ * qC * kb with hL
  have hL0 : 0 < L := by positivity
  set DL : Divisor X := (kb : ℤ) • Dl₀ with hDL
  have hDLq : Divisor.toQDivisor DL = (L : ℚ) • (D + C) := by
    rw [hDL, map_zsmul, hDl₀q, ← Int.cast_smul_eq_zsmul ℚ, smul_smul, hL]
    push_cast; ring_nf
  refine ⟨L, hL0, DL, hDLq, ⟨σb ^ kb, ?_, pow_ne_zero _ hσb0, ?_⟩, fun G => ⟨hFtop G, ?_⟩⟩
  · exact pow_mem_sectionsIn hσbsec kb
  · rw [S.divisorialValuation_eq_exp_neg_ord (pow_ne_zero _ hσb0), ← zpow_natCast,
      MMP.Mori.ord_zpow _ hσb0, hordσb, mul_zero, neg_zero, WithZero.exp_zero]
  · have hFnn : 0 ≤ (F G).toReal := ENNReal.toReal_nonneg
    by_cases hGSg : G ∈ Sg
    · obtain ⟨kG, hkG⟩ : lG G ∣ L := by
        rw [hL]; exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem lG hGSg) _
      obtain ⟨hp, hr, hh, ho⟩ := restrict_witness_pow sX hXs S hSs (by
          have := congrArg (fun D : QDivisor X => D.coeff S) (hDlG G hGSg)
          simp only [hD, Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul,
            DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self, hΔ'S, hCS,
            smul_eq_mul] at this
          exact_mod_cast (show ((DlG G).coeff S : ℚ) = 0 by rw [this]; push_cast; ring))
        (hσG G hGSg) (hresG G hGSg) (hhG G hGSg) G kG
      have hDeq : (kG : ℤ) • DlG G = DL := by
        apply Divisor.toQDivisor_injective
        rw [map_zsmul, hDlG G hGSg, hDLq, ← Int.cast_smul_eq_zsmul ℚ, smul_smul, hkG]
        push_cast; ring_nf
      rw [hDeq] at hp ho
      refine ⟨_, hp, _, hr, hh, ?_⟩
      rw [ho]
      have h1 := hbndG G hGSg
      have hk0 : (0 : ℝ) ≤ kG := Nat.cast_nonneg _
      calc ((((kG : ℤ) * (S.idealSheaf.subscheme.ord (hG G) G.genericPoint +
            ((DlG G).restrictPrimeDivisor S).coeff G) : ℤ) : ℝ))
          ≤ (kG : ℝ) * (lG G * lam * (F G).toReal) := by
            push_cast; exact mul_le_mul_of_nonneg_left (by exact_mod_cast h1) hk0
        _ = (L : ℝ) * lam * (F G).toReal := by rw [hkG]; push_cast; ring
    · obtain ⟨hp, hr, hh, ho⟩ := restrict_witness_pow sX hXs S hSs hDl₀S hσbsec hresb hhb0 G kb
      refine ⟨_, hp, _, hr, hh, ?_⟩
      rw [ho, hbase G hGSg, mul_zero]
      push_cast
      positivity

/-- At a divisor of the resolution not over the biregular locus, the coefficient of
`μ^*D_l - l K_Y` is less than `l`, by the plt property (Step Y3). -/
private theorem coeff_pullback_sub_smul_canonical_lt_of_resolution (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (n' : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX (n' + 1))
    (S : MMP.Mori.PrimeDivisor X) (A B : QDivisor X) (c : ℕ) (R' : QDivisor X)
    (hR' : R' = Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A)
    (hplt : IsPltPair sX (n' + 1) KX R') (l : ℕ) (hl0 : 0 < l) (Dl : Divisor X)
    (hDl : Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A))
    (hDlc : Dl.IsCartier)
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [IsProper μ] [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)]
    (hDμL : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ Dl.supp)
    (Dμ : Divisor Y) (hDμ : Dl.IsPullback μ hDμL Dμ)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (ω : RationalPluriForms sX (n' + 1) 1) (hω0 : ω ≠ 0)
    (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = KX.coeff Γ)
    (KY : Divisor Y) (hKYdef : KY = divisorOfForm (pullbackRationalPluriForms sX μ ω))
    (hKY : KY.IsCanonicalDivisor (μ ≫ sX) (n' + 1))
    (lΘ : Divisor Y) (hlΘ : lΘ = Dμ - (l : ℤ) • KY) :
    ∀ P : MMP.Mori.PrimeDivisor Y, μ P.genericPoint ∉ biregularLocus μ → lΘ.coeff P < l := by
  have hlq : (0 : ℚ) < l := by exact_mod_cast hl0
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  classical
  have hPair : MMP.Mori.IsPair sX R' :=
    ⟨hX, _, KX, hKX, MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _⟩
  obtain ⟨⟨Θ', hΘ', -⟩, -⟩ := MMP.Mori.IsPair.existsUnique_isCrepantBoundary hPair hKX μ hY hμ
  have hωKX : divisorOfForm ω = KX := by
    ext Γ
    rw [coeff_divisorOfForm, hωK]
  obtain ⟨hpull, -, -⟩ := MMP.Mori.IsPair.isPullback_of_isCrepantBoundary hPair μ hY hμ hKX hKY
    (Or.inl ⟨ω, hω0, hωKX, by rw [hKYdef]⟩) hΘ'
  obtain ⟨DY, hDY, -, hB, hDYpb⟩ := hpull l hl0 Dl (by
    rw [hDl, ← Int.cast_smul_eq_zsmul ℚ, hR']
    push_cast
    abel_nf) hDlc
  have hDYeq : DY = Dμ := Divisor.IsPullback.eq hDlc hDYpb hDμ
  intro P hP
  have hexc : (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX).IsExceptional := by
    by_contra hnot
    obtain ⟨Q, hv⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX _ hnot
    have h1 := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX.1 hv
    exact hP (h1 ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus μ hμ Q)
  have h1 := MMP.Mori.discrep_le hexc (hΘ' P)
  have h2 : ((-1 : ℝ) : EReal) < (((-Θ'.coeff P : ℚ) : ℝ) : EReal) := by
    have := lt_of_lt_of_le hplt.2 h1
    simpa using this
  have h3 : (-1 : ℝ) < ((-Θ'.coeff P : ℚ) : ℝ) := EReal.coe_lt_coe_iff.mp h2
  have h4 : -1 < -Θ'.coeff P := by exact_mod_cast h3
  have h5 : (lΘ.coeff P : ℚ) = l * Θ'.coeff P := by
    have h6 := congrArg (fun D : QDivisor Y => D P) hDY
    rw [hDYeq] at h6
    change ((Dμ P : ℤ) : ℚ) = ((l : ℤ) : ℚ) * (((KY P : ℤ) : ℚ) + Θ' P) at h6
    rw [hlΘ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      Int.cast_sub, Int.cast_mul, Int.cast_natCast, DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_apply, h6, DivisorWithCoeffs.coeff_apply]
    push_cast
    ring
  have h7 : (lΘ.coeff P : ℚ) < l := by rw [h5]; nlinarith
  exact_mod_cast h7

/-- A multiple `r A₁` of the very ample divisor makes every twist `(j - 1)K_Y + Ξ'` with
`0 ≤ Ξ' ≤ j(T + ⌈B_ET⌉)`, `1 ≤ j ≤ l + 1`, relatively ample (Step Y4). -/
private theorem exists_hasRelativelyAmpleMultiple_twist_of_resolution (f : X ⟶ Z) [IsAffine Z]
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)] (hsmY : IsSmoothScheme (μ ≫ sX))
    (hprojY : IsProjectiveMorphism (μ ≫ f)) (A₁ : Divisor Y) (hA₁c : A₁.IsCartier)
    (hA₁ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver (μ ≫ f) A₁.divisorialSheaf)
    (KY : Divisor Y) (T : MMP.Mori.PrimeDivisor Y) (BET : QDivisor Y) (l : ℕ) :
    ∃ r : ℕ, 0 < r ∧ ∀ j : ℕ, 1 ≤ j → j ≤ l + 1 → ∀ Ξ' : Divisor Y,
      0 ≤ Ξ' → Ξ' ≤ (j : ℤ) • (Finsupp.single T 1 + DivisorWithCoeffs.roundUp BET) →
      QDivisor.HasRelativelyAmpleMultiple (((j : ℚ) - 1) • Divisor.toQDivisor KY +
        Divisor.toQDivisor Ξ' + (r : ℚ) • Divisor.toQDivisor A₁) (μ ≫ f) := by
  classical
  haveI : IsProper (μ ≫ f) := isProper_of_isProjectiveMorphism (μ ≫ f) hprojY
  set B₀ : Divisor Y := Finsupp.single T 1 + DivisorWithCoeffs.roundUp BET with hB₀
  set s : Finset (Divisor Y) := ((Finset.Icc 1 (l + 1)).sigma
    (fun j => Finset.Icc (0 : Divisor Y) ((j : ℤ) • B₀))).image
      (fun p => ((p.1 : ℤ) - 1) • KY + p.2) with hs
  obtain ⟨r, hr0, hr⟩ := exists_pos_forall_hasRelativelyAmpleMultiple_add hsmY (μ ≫ f)
    (isRelativelyAmpleCartier_of_isRelativelyAmple (μ ≫ f) hA₁c
      (isRelativelyAmple_of_isAmple_of_isAffine (μ ≫ f) hA₁c
        (isAmple_of_hasImmersionTwistOver (μ ≫ f) hprojY hA₁c hA₁))) s
  refine ⟨r, hr0, fun j hj1 hj2 Ξ' hΞ'0 hΞ' => ?_⟩
  have hmem : ((j : ℤ) - 1) • KY + Ξ' ∈ s :=
    Finset.mem_image.mpr ⟨⟨j, Ξ'⟩, Finset.mem_sigma.mpr ⟨Finset.mem_Icc.mpr ⟨hj1, hj2⟩,
      Finset.mem_Icc.mpr ⟨hΞ'0, hΞ'⟩⟩, rfl⟩
  have h := hr _ hmem
  rwa [map_add, map_zsmul, ← Int.cast_smul_eq_zsmul ℚ, Int.cast_sub, Int.cast_natCast,
    Int.cast_one] at h

/-- The boundary `T + B_ET` of the extension theorem on the resolution is snc (Step Y3). -/
private theorem isSNC_single_add_clippedBoundary_of_resolution {Y : Scheme.{0}} (μ : Y ⟶ X)
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [IsDominant μ]
    (R' : QDivisor X) (Fμ : Divisor Y) (T : MMP.Mori.PrimeDivisor Y) (l : ℕ) (hl0 : 0 < l)
    (lΘ Γl Ξl : Divisor Y) (hΓl : Γl = lΘ ⊔ 0)
    (hlΘstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        (lΘ.coeff Q' : ℚ) = (l : ℚ) * R'.coeff Q)
    (hlΘT : lΘ.coeff T = l) (hΞ0 : ∀ P, 0 ≤ Ξl.coeff P) (hΞΓ : ∀ P, Ξl.coeff P ≤ Γl.coeff P)
    (hsnc : IsSNCSubset (μ ≫ sX) (exceptionalSet μ ⊔ (QDivisor.toRDivisor R').supp.preimage
      μ.continuous ⊔ Fμ.supp)) :
    DivisorWithCoeffs.IsSNC (μ ≫ sX) (Divisor.toQDivisor (Finsupp.single T 1) +
      ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1))) := by
  classical
  set BET : QDivisor Y := (l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1) with hBET
  -- the components of `Ξ` lie in `Ex(μ) ∪ μ⁻¹(Supp R)`
  have hsub : ∀ P : MMP.Mori.PrimeDivisor Y, 0 < lΘ.coeff P → (P.support : Set Y) ⊆
      ((exceptionalSet μ ⊔ (QDivisor.toRDivisor R').supp.preimage μ.continuous ⊔ Fμ.supp :
        Closeds Y) : Set Y) := by
    intro P hP
    refine support_subset_of_genericPoint_mem P (Closeds.isClosed _) ?_
    by_cases hb : μ P.genericPoint ∈ biregularLocus μ
    · obtain ⟨Q, hQ, hiso⟩ := exists_primeDivisor_of_mem_biregularLocus μ P hb
      have h1 := hlΘstrict Q P hQ hiso
      have h2 : (0 : ℚ) < lΘ.coeff P := by exact_mod_cast hP
      have h3 : R'.coeff Q ≠ 0 := by
        intro h0; rw [h1, h0, mul_zero] at h2; exact lt_irrefl 0 h2
      refine Or.inl (Or.inr ?_)
      change μ P.genericPoint ∈ (QDivisor.toRDivisor R').supp
      rw [hQ]
      exact DivisorWithCoeffs.support_subset_supp (by
        rw [QDivisor.coeff_toRDivisor]; exact_mod_cast h3)
        (MMP.Flips.primeDivisor_genericPoint_mem_support Q)
    · exact Or.inl (Or.inl (mem_exceptionalSet.mpr hb))
  rcases hsnc with h0 | ⟨s, hs, hsnc'⟩
  · exfalso
    have := hsub T (by rw [hlΘT]; exact_mod_cast hl0)
      (MMP.Flips.primeDivisor_genericPoint_mem_support T)
    rw [h0] at this
    exact this
  · refine hsnc'.of_support_subset fun P hP => ?_
    have hP' : Ξl.coeff P ≠ 0 := by
      intro h0
      apply Finsupp.mem_support_iff.mp hP
      change ((Finsupp.single T (1 : ℤ) P : ℤ) : ℚ) + ((l : ℚ)⁻¹ * (Ξl P : ℚ) -
        ((Finsupp.single T (1 : ℤ) P : ℤ) : ℚ)) = 0
      rw [show Ξl P = 0 from h0]
      simp
    have hΓ : 0 < lΘ.coeff P := by
      have h1 := hΞΓ P
      have h2 := hΞ0 P
      have h3 : Γl.coeff P = max (lΘ.coeff P) 0 := by
        rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
      omega
    have hPs : P ∈ s := mem_of_support_subset_iUnion P (by rw [hs]; exact hsub P hΓ)
    have : DivisorWithCoeffs.coeff (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y) P = 1 := by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
      simp [Finsupp.single_apply, hPs]
    rw [Finsupp.mem_support_iff]
    rw [← DivisorWithCoeffs.coeff_apply, this]
    norm_num

/-- The stable base locus of `D_ET` contains no stratum of `T + ⌈B_ET⌉` (Step Y5). -/
private theorem containsNoStratum_baseLocus_of_resolution {Y : Scheme.{0}} (μ : Y ⟶ X)
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [IsDominant μ]
    (R' : QDivisor X) (hR'0 : ∀ Q : MMP.Mori.PrimeDivisor X, 0 ≤ R'.coeff Q)
    (Dl : Divisor X) (Dμ Fμ KY : Divisor Y)
    (hfix : IsFixedDivisorOfPullback μ (sectionsIn Dl) Dμ Fμ)
    (hfree : IsFreeModuloFixedDivisor μ (sectionsIn Dl) Dμ Fμ)
    (T : MMP.Mori.PrimeDivisor Y) (l : ℕ) (hl0 : 0 < l)
    (lΘ Γl El Hl Ξl DET : Divisor Y) (hlΘ : lΘ = Dμ - (l : ℤ) • KY) (hΓl : Γl = lΘ ⊔ 0)
    (hEl : El = (-lΘ) ⊔ 0) (hHl : Hl = Fμ + El) (hΞl : Ξl = Γl - Γl ⊓ Hl)
    (hDET : DET = (l : ℤ) • KY + Ξl)
    (hlΘstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        (lΘ.coeff Q' : ℚ) = (l : ℚ) * R'.coeff Q)
    (hlΘT : lΘ.coeff T = l) (hΞ0 : ∀ P, 0 ≤ Ξl.coeff P) (hΞΓ : ∀ P, Ξl.coeff P ≤ Γl.coeff P)
    (hΞT : Ξl.coeff T = l)
    (hsnc : IsSNCSubset (μ ≫ sX) (exceptionalSet μ ⊔ (QDivisor.toRDivisor R').supp.preimage
      μ.continuous ⊔ Fμ.supp)) :
    ContainsNoStratum (Finsupp.single T 1 + DivisorWithCoeffs.roundUp
        ((l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1)))
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • DET)) ((m : ℤ) • DET)) := by
  classical
  set BET : QDivisor Y := (l : ℚ)⁻¹ • Divisor.toQDivisor Ξl - Divisor.toQDivisor (Finsupp.single T 1) with hBET
  -- the components of `Ξ`, of `F` and of `E` lie in the snc divisor
  have hsub : ∀ P : MMP.Mori.PrimeDivisor Y,
      (0 < lΘ.coeff P ∨ Fμ.coeff P ≠ 0 ∨ lΘ.coeff P < 0) → (P.support : Set Y) ⊆
        ((exceptionalSet μ ⊔ (QDivisor.toRDivisor R').supp.preimage μ.continuous ⊔ Fμ.supp :
          Closeds Y) : Set Y) := by
    intro P hP
    refine support_subset_of_genericPoint_mem P (Closeds.isClosed _) ?_
    rcases hP with hP | hP | hP
    · by_cases hb : μ P.genericPoint ∈ biregularLocus μ
      · obtain ⟨Q, hQ, hiso⟩ := exists_primeDivisor_of_mem_biregularLocus μ P hb
        have h1 := hlΘstrict Q P hQ hiso
        have h2 : (0 : ℚ) < lΘ.coeff P := by exact_mod_cast hP
        have h3 : R'.coeff Q ≠ 0 := by
          intro h0; rw [h1, h0, mul_zero] at h2; exact lt_irrefl 0 h2
        refine Or.inl (Or.inr ?_)
        change μ P.genericPoint ∈ (QDivisor.toRDivisor R').supp
        rw [hQ]
        exact DivisorWithCoeffs.support_subset_supp (by
          rw [QDivisor.coeff_toRDivisor]; exact_mod_cast h3)
          (MMP.Flips.primeDivisor_genericPoint_mem_support Q)
      · exact Or.inl (Or.inl (mem_exceptionalSet.mpr hb))
    · exact Or.inr (DivisorWithCoeffs.support_subset_supp hP
        (MMP.Flips.primeDivisor_genericPoint_mem_support P))
    · by_cases hb : μ P.genericPoint ∈ biregularLocus μ
      · exfalso
        obtain ⟨Q, hQ, hiso⟩ := exists_primeDivisor_of_mem_biregularLocus μ P hb
        have h1 := hlΘstrict Q P hQ hiso
        have h2 : (lΘ.coeff P : ℚ) < 0 := by exact_mod_cast hP
        have h3 := hR'0 Q
        rw [h1] at h2
        nlinarith
      · exact Or.inl (Or.inl (mem_exceptionalSet.mpr hb))
  have hΓc : ∀ P, Γl.coeff P = max (lΘ.coeff P) 0 := fun P => by
    rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hEc : ∀ P, El.coeff P = max (-lΘ.coeff P) 0 := fun P => by
    rw [hEl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  rcases hsnc with h0 | ⟨s, hs, hsnc'⟩
  · exfalso
    have := hsub T (Or.inl (by rw [hlΘT]; exact_mod_cast hl0))
      (MMP.Flips.primeDivisor_genericPoint_mem_support T)
    rw [h0] at this
    exact this
  · refine containsNoStratum_baseLocus_clipped μ hlΘ hΓl hEl hHl hΞl hDET hfix hfree s hsnc'
      (fun P hP hΞ => hP ?_) (fun P hP => ?_)
    · have hPT : P ≠ T := by
        rintro rfl
        rw [hΞT] at hΞ
        exact (Nat.cast_ne_zero.mpr hl0.ne') hΞ
      rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hPT),
        DivisorWithCoeffs.coeff_roundUp, zero_add]
      have hB0 : BET.coeff P = 0 := by
        change (l : ℚ)⁻¹ * ((Ξl P : ℤ) : ℚ) - ((Finsupp.single T (1 : ℤ) P : ℤ) : ℚ) = 0
        rw [Finsupp.single_eq_of_ne hPT, ← DivisorWithCoeffs.coeff_apply, hΞ]
        simp
      rw [hB0, Int.ceil_zero]
    · have hP' : 0 < lΘ.coeff P ∨ Fμ.coeff P ≠ 0 ∨ lΘ.coeff P < 0 := by
        rcases hP with hP | hP | hP
        · left
          have h1 := hΞΓ P
          have h2 := hΞ0 P
          rw [hΓc] at h1
          by_contra h
          rw [max_eq_right (not_lt.mp h)] at h1
          exact hP (le_antisymm h1 h2)
        · exact Or.inr (Or.inl hP)
        · right; right
          rw [hEc] at hP
          by_contra h
          exact hP (max_eq_right (by linarith [not_lt.mp h]))
      exact mem_of_support_subset_iUnion P (by rw [hs]; exact hsub P hP')

/-- On a smooth prime divisor `S` of a smooth variety with `K_X` of coefficient `-1` along `S`,
the restriction `(K_X + S)|_S` is a canonical divisor of `S` (adjunction). -/
private theorem isCanonicalDivisor_restrictPrimeDivisor_add_single (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (n' : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX (n' + 1))
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX)) :
    Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n'
      (DivisorWithCoeffs.restrictPrimeDivisor (KX + Finsupp.single S 1) S) := by
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  classical
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSs
  have hKXS0 : (KX + Finsupp.single S 1).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self]; norm_num
  obtain ⟨w, hw0, hwK⟩ := exists_isCanonicalDivisor_restrictPrimeDivisor sX hX hXs hKX S
  set gw := rationalFunctionsEquivFunctionField X w with hgw
  have hgw0 : gw ≠ 0 := (w.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hdivw : principalDivisor w = ffDiv gw hgw0 :=
    (ffDiv_rationalFunctionsEquivFunctionField w hgw0).symm
  have hordS : X.ord gw S.genericPoint = 0 := by
    rw [← coeff_ffDiv gw hgw0, ← hdivw]
    rw [DivisorWithCoeffs.coeff_add, hKXS0, zero_add] at hw0
    exact hw0
  have hη : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) = S.genericPoint :=
    rfl
  obtain ⟨a, haU, ha⟩ := MMP.Mori.exists_isUnit_algebraMap_stalk_eq_of_forall_ord_eq_zero
    (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) hgw0 fun Γ hΓ => by
      rw [hη] at hΓ
      rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ, hordS]
  set hS := (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a
  have hhS0 : hS ≠ 0 := (haU.map _).ne_zero
  have hres : IsRestrictionAlong S gw hS := ⟨a, ha, rfl⟩
  have e := restrictPrimeDivisor_add_ffDiv sX hXs S hSs (KX + Finsupp.single S 1) hKXS0 hres
    hgw0 hhS0
  rw [hdivw, e] at hwK
  refine hwK.of_linearlyEquivalent ⟨(Units.map
    (rationalFunctionsEquivFunctionField _).symm.toMonoidHom (Units.mk0 hS hhS0))⁻¹, ?_⟩
  rw [MMP.Mori.principalDivisor_inv]
  abel

/-- The crepant boundary of `(X, S)` on the resolution restricts to `T` as the discrepancies of
`(S, 0)`: `(K_Y + T)|_T = (μ^*(K_X + S))|_T + a` with `a` the discrepancies over `S`. -/
private theorem exists_isPullback_restrictPrimeDivisor_discrepancy_of_resolution
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX)
    (n' : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX (n' + 1))
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hKS : Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n'
      (DivisorWithCoeffs.restrictPrimeDivisor (KX + Finsupp.single S 1) S))
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [IsProper μ] [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)]
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hsmY : IsSmoothScheme (μ ≫ sX))
    (T : MMP.Mori.PrimeDivisor Y) (hμT : μ T.genericPoint = S.genericPoint)
    (hTS : inverseTransformPrimeDivisor μ S = some T)
    [IsIntegral T.idealSheaf.subscheme] [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme]
    (Ex : Finset (MMP.Mori.PrimeDivisor Y))
    (hEx : ∀ E, E ∈ Ex ↔ RationalMap.IsExceptional μ.toRationalMap E)
    (hPairS : MMP.Mori.IsPair sX (Divisor.toQDivisor (Finsupp.single S 1) + 0))
    (e : MMP.Mori.PrimeDivisor Y → ℚ)
    (he : ∀ E, MMP.Mori.IsDiscrepancy sX (n' + 1) KX
      (Divisor.toQDivisor (Finsupp.single S 1) + 0) ⟨Y, μ, hY, hμ, E⟩ (e E))
    (fS : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hT' : IsNormalVariety k (fS ≫ S.idealSheaf.subschemeι ≫ sX)) (hfSb : IsBirationalMorphism fS)
    (hcrepT : ∀ KS : Divisor S.idealSheaf.subscheme,
      KS.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n' →
        IsCrepantBoundary (S.idealSheaf.subschemeι ≫ sX) n' KS
          ((0 : QDivisor X).restrict S.idealSheaf.subschemeι) fS hT' hfSb
          (-∑ E ∈ Ex, e E • DivisorWithCoeffs.restrict T.idealSheaf.subschemeι
            (Finsupp.single E (1 : ℚ))))
    (ω : RationalPluriForms sX (n' + 1) 1) (hω0 : ω ≠ 0)
    (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = KX.coeff Γ)
    (KY : Divisor Y) (hKYdef : KY = divisorOfForm (pullbackRationalPluriForms sX μ ω))
    (hKY : KY.IsCanonicalDivisor (μ ≫ sX) (n' + 1)) (hKYT : KY.coeff T = -1) :
    ∃ DY : Divisor Y, ∃ hBY : (∀ Z : irreducibleComponents Y,
        μ (componentGenericPoint Y Z) ∉ DivisorWithCoeffs.supp (KX + Finsupp.single S 1)),
      Divisor.IsPullback μ (KX + Finsupp.single S 1) hBY DY ∧ DY.coeff T = 0 ∧
      ∃ aG : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme → ℚ,
        (∀ G', ((((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) =
          (DY.restrictPrimeDivisor T).coeff G' + aG G') ∧
        ∀ G', MMP.Mori.IsDiscrepancy (S.idealSheaf.subschemeι ≫ sX) n'
          ((KX + Finsupp.single S 1).restrictPrimeDivisor S) 0
            ⟨T.idealSheaf.subscheme, fS, hT', hfSb, G'⟩ (aG G') := by
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : NoetherianSpace Y := MMP.Resolution.Aux.noetherianSpace_of_finiteType (μ ≫ sX)
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  haveI : Smooth (μ ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hsmY
  haveI : CompactSpace T.idealSheaf.subscheme :=
    T.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
  haveI : IsSeparated sX := hX.1.toIsSeparated
  haveI : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  have h0 : (0 : QDivisor X).restrict S.idealSheaf.subschemeι = 0 :=
    restrictPrimeDivisor_zero' (R := ℚ) S
  set KS : Divisor S.idealSheaf.subscheme := (KX + Finsupp.single S 1).restrictPrimeDivisor S
    with hKSdef
  classical
  -- the crepant boundary of `(X, S)` on `Y`: `K_Y + T = μ^*(K_X + S) + ∑ e_E E`
  have hPairWS : MMP.Mori.IsPairWith sX (n' + 1) KX
      (Divisor.toQDivisor (Finsupp.single S 1) + 0) :=
    ⟨hX, hKX, MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _⟩
  obtain ⟨⟨Θs, hΘs, -⟩, -⟩ := MMP.Mori.IsPair.existsUnique_isCrepantBoundary hPairS hKX μ hY hμ
  have hTne : ¬ (⟨Y, μ, hY, hμ, T⟩ : DivisorOver k sX).IsExceptional :=
    not_isExceptional_of_map_genericPoint_eq hμT
  have hTEx : T ∉ Ex := fun h => hTne ((hEx T).mp h)
  have hΘsc : ∀ P, Θs.coeff P = if P = T then 1 else if P ∈ Ex then -e P else 0 := by
    intro P
    by_cases hPex : (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX).IsExceptional
    · have hPT : P ≠ T := by rintro rfl; exact hTne hPex
      rw [if_neg hPT, if_pos ((hEx P).mpr hPex)]
      have := (hΘs P).eq (he P)
      linarith
    · obtain ⟨Q, hc, hηQ, hiQ⟩ :=
        MMP.Mori.exists_coeff_eq_of_not_isExceptional hPairWS hY hμ hΘs hPex
      rw [hc]
      by_cases hPT : P = T
      · subst hPT
        have hQS : Q = S := AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (hηQ.symm.trans hμT)
        subst hQS
        rw [if_pos rfl]
        simp [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_single_self]
      · have hQS : Q ≠ S := by
          rintro rfl
          exact hPT (Option.some.inj (hiQ.symm.trans hTS))
        rw [if_neg hPT, if_neg fun h => hPex ((hEx P).mp h)]
        rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor,
          DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hQS)]
        simp
  have hωKX : divisorOfForm ω = KX := by
    ext Γ
    rw [coeff_divisorOfForm, hωK]
  obtain ⟨hpullS, -, -⟩ := MMP.Mori.IsPair.isPullback_of_isCrepantBoundary hPairS μ hY hμ hKX
    hKY (Or.inl ⟨ω, hω0, hωKX, by rw [hKYdef]⟩) hΘs
  have hKXSc : (KX + Finsupp.single S 1).IsCartier :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hXs _
  obtain ⟨DY, hDY, -, hBY, hDYpb⟩ := hpullS 1 one_pos (KX + Finsupp.single S 1) (by
    rw [map_add]; simp) hKXSc
  have hDYc : ∀ P, (DY.coeff P : ℚ) = KY.coeff P + Θs.coeff P := by
    intro P
    have h6 := congrArg (fun D : QDivisor Y => D.coeff P) hDY
    simpa [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor] using h6
  have hDYT : DY.coeff T = 0 := by
    have h1 := hDYc T
    rw [hKYT, hΘsc, if_pos rfl] at h1
    exact_mod_cast (show (DY.coeff T : ℚ) = 0 by rw [h1]; push_cast; ring)
  have hKYT0 : (KY + Finsupp.single T 1).coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKYT, DivisorWithCoeffs.coeff_single_self]; norm_num
  have hYid : Divisor.toQDivisor (KY + Finsupp.single T 1) - Divisor.toQDivisor DY =
      ∑ E ∈ Ex, e E • (Finsupp.single E (1 : ℚ) : QDivisor Y) := by
    refine Finsupp.ext fun P => ?_
    have hsumc : (∑ E ∈ Ex, e E • (Finsupp.single E (1 : ℚ) : QDivisor Y)) P =
        if P ∈ Ex then e P else 0 := by
      rw [Finsupp.finset_sum_apply]
      simp [Finsupp.single_apply]
    rw [hsumc, Finsupp.sub_apply]
    have h1 := hDYc P
    rw [hΘsc] at h1
    change (((KY + Finsupp.single T 1 : Divisor Y) P : ℤ) : ℚ) - ((DY P : ℤ) : ℚ) = _
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply, h1,
      DivisorWithCoeffs.coeff_add]
    by_cases hPT : P = T
    · subst hPT
      rw [if_pos rfl, if_neg hTEx, DivisorWithCoeffs.coeff_single_self]
      push_cast; ring
    · rw [if_neg hPT, DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hPT)]
      split_ifs <;> push_cast <;> ring
  -- restricting to `T`
  have hsingleT : ∀ E ∈ Ex,
      DivisorWithCoeffs.coeff (Finsupp.single E (1 : ℚ) : QDivisor Y) T = 0 := by
    intro E hE
    exact DivisorWithCoeffs.coeff_single_of_ne (show E ≠ T from fun h => hTEx (h ▸ hE)) _
  set aG : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme → ℚ := fun G' =>
    ∑ E ∈ Ex, e E * DivisorWithCoeffs.coeff
      (DivisorWithCoeffs.restrictPrimeDivisor (Finsupp.single E (1 : ℚ) : QDivisor Y) T) G'
    with haGdef
  have hresid : ∀ G', ((((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) =
      (DY.restrictPrimeDivisor T).coeff G' + aG G' := by
    intro G'
    have h := congrArg (fun D : QDivisor Y => (D.restrictPrimeDivisor T).coeff G') hYid
    rw [restrictPrimeDivisor_sub' T (by rw [Divisor.coeff_toQDivisor, hKYT0]; simp)
        (by rw [Divisor.coeff_toQDivisor, hDYT]; simp),
      restrictPrimeDivisor_toQDivisor' T hKYT0, restrictPrimeDivisor_toQDivisor' T hDYT,
      restrictPrimeDivisor_sum' T Ex _ fun E hE => by
        rw [DivisorWithCoeffs.coeff_smul, hsingleT E hE, smul_zero],
      DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, Divisor.coeff_toQDivisor] at h
    rw [haGdef]
    simp only
    rw [← sub_eq_iff_eq_add', h, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
    refine Finset.sum_congr rfl fun E hE => ?_
    rw [restrictPrimeDivisor_smul' T (hsingleT E hE), ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_smul, smul_eq_mul]
  have hdiscG : ∀ G', MMP.Mori.IsDiscrepancy (S.idealSheaf.subschemeι ≫ sX) n' KS 0
      ⟨T.idealSheaf.subscheme, fS, hT', hfSb, G'⟩ (aG G') := by
    intro G'
    have h := hcrepT KS hKS G'
    rw [h0] at h
    convert h using 1
    rw [haGdef]
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.neg_apply, Finsupp.finset_sum_apply,
      Finsupp.smul_apply, smul_eq_mul, neg_neg]
  exact ⟨DY, hBY, hDYpb, hDYT, aG, hresid, hdiscG⟩

/-- Coefficientwise, the pull-back to `T` of `m(K_S + Ω - Φ)` is at most `m' D_ET|_T`
(the comparison of Step Y8). -/
private theorem coeff_le_coeff_restrictPrimeDivisor_clipped_of_resolution
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX)
    (n' : ℕ) (KX : Divisor X) (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (hKXS0 : (KX + Finsupp.single S 1).coeff S = 0)
    (hKS : Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n'
      (DivisorWithCoeffs.restrictPrimeDivisor (KX + Finsupp.single S 1) S))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (c : ℕ) (hc : 0 < c)
    (hcan : IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
      (QDivisor.toRDivisor ((A + B).restrictPrimeDivisor S + A.restrictPrimeDivisor S)))
    (F : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme → ENNReal)
    (hAF : ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0)
    (ε : ℚ) (hε1 : ε < 1)
    (Φ : QDivisor S.idealSheaf.subscheme)
    (hΦlo : coeffwiseMin ((A + B).restrictPrimeDivisor S)
      (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤ QDivisor.toRDivisor Φ)
    (l : ℕ) (hl0 : 0 < l) (Dl : Divisor X)
    (hDl : Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A))
    (hDlS : Dl.coeff S = 0)
    (hGl : ∀ G : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme, F G ≠ ⊤ ∧
        ∃ σ ∈ sectionsIn Dl, ∃ h : S.idealSheaf.subscheme.functionField,
          IsRestrictionAlong S σ h ∧ ∃ hh : h ≠ 0,
            (((S.idealSheaf.subscheme.ord h G.genericPoint +
              (Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℝ) ≤
                (l : ℝ) * (1 - (ε : ℝ) / c) * (F G).toReal))
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [IsProper μ] [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)]
    (Dμ Fμ : Divisor Y) (hfix : IsFixedDivisorOfPullback μ (sectionsIn Dl) Dμ Fμ)
    (hY : IsNormalVariety k (μ ≫ sX)) (hsmY : IsSmoothScheme (μ ≫ sX))
    (T : MMP.Mori.PrimeDivisor Y) (hμT : μ T.genericPoint = S.genericPoint)
    [IsIso (μ.stalkMap T.genericPoint)] [IsIntegral T.idealSheaf.subscheme] [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme]
    (fS : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme) [IsDominant fS]
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) (hfSp : IsProper fS)
    (hsmT : IsSmoothScheme (fS ≫ S.idealSheaf.subschemeι ≫ sX))
    (hT' : IsNormalVariety k (fS ≫ S.idealSheaf.subschemeι ≫ sX)) (hfSb : IsBirationalMorphism fS)
    (hfSeq : fS ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ ≫ sX)
    (KY : Divisor Y) (hKYT : KY.coeff T = -1)
    (lΘ Γl El Hl Ξl DET : Divisor Y) (hlΘ : lΘ = Dμ - (l : ℤ) • KY) (hΓl : Γl = lΘ ⊔ 0)
    (hEl : El = (-lΘ) ⊔ 0) (hHl : Hl = Fμ + El) (hΞl : Ξl = Γl - Γl ⊓ Hl)
    (hDET : DET = (l : ℤ) • KY + Ξl)
    (hlΘT : lΘ.coeff T = l) (hFμ0 : ∀ P, 0 ≤ Fμ.coeff P) (hFμT : Fμ.coeff T = 0)
    (hΓT : Γl.coeff T = l) (hE0 : ∀ P, 0 ≤ El.coeff P)
    (m'' : ℕ) (hm'' : 0 < m'') (m' : ℕ) (hm' : m' = c * m'')
    (DY : Divisor Y) (aG : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme → ℚ)
    (hresid : ∀ G', ((((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) =
      (DY.restrictPrimeDivisor T).coeff G' + aG G')
    (hdiscG : ∀ G', MMP.Mori.IsDiscrepancy (S.idealSheaf.subschemeι ≫ sX) n'
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) 0
        ⟨T.idealSheaf.subscheme, fS, hT', hfSb, G'⟩ (aG G'))
    (hBKS : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      fS (componentGenericPoint T.idealSheaf.subscheme Z) ∉
        DivisorWithCoeffs.supp (DivisorWithCoeffs.restrictPrimeDivisor (KX + Finsupp.single S 1) S))
    (hKSpb : Divisor.IsPullback fS
      (DivisorWithCoeffs.restrictPrimeDivisor (KX + Finsupp.single S 1) S) hBKS
      (DivisorWithCoeffs.restrictPrimeDivisor DY T))
    (hDμT : Dμ.coeff T = 0)
    (hBDl : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      fS (componentGenericPoint T.idealSheaf.subscheme Z) ∉
        DivisorWithCoeffs.supp (DivisorWithCoeffs.restrictPrimeDivisor Dl S))
    (hDlpb : Divisor.IsPullback fS (DivisorWithCoeffs.restrictPrimeDivisor Dl S) hBDl
      (DivisorWithCoeffs.restrictPrimeDivisor Dμ T))
    (NΩ' : Divisor T.idealSheaf.subscheme)
    (hBN : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      fS (componentGenericPoint T.idealSheaf.subscheme Z) ∉
        DivisorWithCoeffs.supp (DivisorWithCoeffs.roundDown (((c * l * m'' : ℕ) : ℚ) •
          ((A + B).restrictPrimeDivisor S - Φ))))
    (hNΩ' : Divisor.IsPullback fS (DivisorWithCoeffs.roundDown (((c * l * m'' : ℕ) : ℚ) •
      ((A + B).restrictPrimeDivisor S - Φ))) hBN NΩ') :
    ∀ G', (((c * l * m'' : ℕ) : ℤ) • DY.restrictPrimeDivisor T + NΩ').coeff G' ≤
      (((m' : ℤ) • (DET + principalDivisor 1)).restrictPrimeDivisor T).coeff G' := by
  intro G'
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  classical
  haveI : NoetherianSpace Y := MMP.Resolution.Aux.noetherianSpace_of_finiteType (μ ≫ sX)
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  haveI : Smooth (μ ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hsmY
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSs
  have hsmT' : IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ ≫ sX) := by rw [← hfSeq]; exact hsmT
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hsmT'
  haveI : CompactSpace T.idealSheaf.subscheme :=
    T.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
  haveI : IsProper fS := hfSp
  haveI : IsSeparated sX := hX.1.toIsSeparated
  haveI : IsSeparated (S.idealSheaf.subscheme ↘ ⊤_ Scheme) := by
    rw [show (S.idealSheaf.subscheme ↘ ⊤_ Scheme) =
      S.idealSheaf.subschemeι ≫ sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from
        Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : AlgebraicGeometry.IsVariety k (S.idealSheaf.subschemeι ≫ sX) := ⟨⟩
  have hSv : IsNormalVariety k (S.idealSheaf.subschemeι ≫ sX) := ⟨inferInstance, inferInstance⟩
  set KS : Divisor S.idealSheaf.subscheme := (KX + Finsupp.single S 1).restrictPrimeDivisor S
  set mm : ℕ := c * l * m'' with hmm
  have hmm' : (mm : ℝ) = (m' : ℝ) * l := by rw [hmm, hm']; push_cast; ring
  set Ω : QDivisor S.idealSheaf.subscheme := (A + B).restrictPrimeDivisor S
  set NΩ : Divisor S.idealSheaf.subscheme :=
    DivisorWithCoeffs.roundDown ((mm : ℚ) • (Ω - Φ)) with hNΩ
  have hNΩc : NΩ.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hSs NΩ
  have hKSc : KS.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hSs KS
  have hKYT0 : (KY + Finsupp.single T 1).coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKYT, DivisorWithCoeffs.coeff_single_self]; norm_num
  -- `D_ET = μ^*D_l + E - Γ ∧ F` and its restriction to `T`
  have hΓc : ∀ P, Γl.coeff P = max (lΘ.coeff P) 0 := fun P => by
    rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hEc : ∀ P, El.coeff P = max (-lΘ.coeff P) 0 := fun P => by
    rw [hEl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]; rfl
  have hHc : ∀ P, Hl.coeff P = Fμ.coeff P + El.coeff P := fun P => by rw [hHl]; rfl
  have hElT : El.coeff T = 0 := by
    rw [hEc, hlΘT]
    simp
  have hΞc : ∀ P, Ξl.coeff P = Γl.coeff P - min (Γl.coeff P) (Hl.coeff P) := fun P => by
    rw [hΞl, DivisorWithCoeffs.coeff_apply, Finsupp.sub_apply, Finsupp.inf_apply]; rfl
  have hlΘc : ∀ P, lΘ.coeff P = Dμ.coeff P - l * KY.coeff P := fun P => by
    rw [hlΘ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
  have hinfc : ∀ P, (Γl ⊓ Fμ).coeff P = min (Γl.coeff P) (Fμ.coeff P) := fun P => by
    rw [DivisorWithCoeffs.coeff_apply, Finsupp.inf_apply]; rfl
  have hDETY : DET + principalDivisor 1 = Dμ + El - Γl ⊓ Fμ := by
    rw [MMP.Mori.principalDivisor_one, add_zero]
    refine Finsupp.ext fun P => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply]
    have hF0 := hFμ0 P
    have e1 : DET.coeff P = l * KY.coeff P + (Γl.coeff P - min (Γl.coeff P)
        (Fμ.coeff P + El.coeff P)) := by
      rw [hDET, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul, hΞc,
        hHc]
    have e2 : (Dμ + El - Γl ⊓ Fμ).coeff P = Dμ.coeff P + El.coeff P -
        min (Γl.coeff P) (Fμ.coeff P) := by
      rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add, hinfc]
    rw [e1, e2, hΓc, hEc, hlΘc]
    simp only [max_def, min_def]
    split_ifs <;> omega
  have hX0T : (Γl ⊓ Fμ).coeff T = 0 := by
    rw [hinfc, hΓT, hFμT]
    exact min_eq_right (Nat.cast_nonneg l)
  have hDEX : (Dμ + El).coeff T = 0 := by rw [DivisorWithCoeffs.coeff_add, hDμT, hElT, add_zero]
  have hDETres : ((m' : ℤ) • (DET + principalDivisor 1)).restrictPrimeDivisor T =
      (m' : ℤ) • (Dμ.restrictPrimeDivisor T + El.restrictPrimeDivisor T -
        (Γl ⊓ Fμ).restrictPrimeDivisor T) := by
    rw [hDETY, restrictPrimeDivisor_smul' T (by
        rw [DivisorWithCoeffs.coeff_sub, hDEX, hX0T, sub_zero]),
      restrictPrimeDivisor_sub' T hDEX hX0T, restrictPrimeDivisor_add' T hDμT hElT]
  -- the two bounds on `(Γ ∧ F)|_T`
  have hmono1 := restrictPrimeDivisor_mono' T hX0T hFμT (D₁ := Γl ⊓ Fμ) (D₂ := Fμ)
    inf_le_right
  have hR0 : (Dμ - (l : ℤ) • (KY + Finsupp.single T 1) + El).coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul,
      hKYT0, hDμT, hElT]
    simp
  have hmono2 := restrictPrimeDivisor_mono' T hX0T hR0
    (D₁ := Γl ⊓ Fμ) (D₂ := Dμ - (l : ℤ) • (KY + Finsupp.single T 1) + El) (fun P => by
      change (Γl ⊓ Fμ).coeff P ≤ (Dμ - (l : ℤ) • (KY + Finsupp.single T 1) + El).coeff P
      rw [hinfc, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
        DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, smul_eq_mul]
      by_cases hPT : P = T
      · subst hPT
        rw [hΓT, hFμT, hKYT, hDμT, hElT, DivisorWithCoeffs.coeff_single_self,
          min_eq_right (Nat.cast_nonneg l)]
        ring_nf; rfl
      · rw [DivisorWithCoeffs.coeff_single_of_ne (Ne.symm hPT)]
        have h1 := min_le_left (Γl.coeff P) (Fμ.coeff P)
        have h2 := max_sub_max_neg (lΘ.coeff P)
        rw [← hΓc, ← hEc, hlΘc] at h2
        linarith)
  have hRres : (Dμ - (l : ℤ) • (KY + Finsupp.single T 1) + El).restrictPrimeDivisor T =
      Dμ.restrictPrimeDivisor T - (l : ℤ) • (KY + Finsupp.single T 1).restrictPrimeDivisor T +
        El.restrictPrimeDivisor T := by
    have h1 : (Dμ - (l : ℤ) • (KY + Finsupp.single T 1)).coeff T = 0 := by
      rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, hKYT0, hDμT]; simp
    rw [restrictPrimeDivisor_add' T h1 hElT, restrictPrimeDivisor_sub' T hDμT
      (by rw [DivisorWithCoeffs.coeff_smul, hKYT0, smul_zero]),
      restrictPrimeDivisor_smul' T hKYT0]
  -- the comparison at `G'`
  rw [hDETres, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
    DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add,
    smul_eq_mul, smul_eq_mul]
  have hη0 : 0 ≤ (El.restrictPrimeDivisor T).coeff G' :=
    coeff_restrictPrimeDivisor_nonneg' T (fun P => hE0 P) hElT G'
  have hx1 := hmono1 G'
  have hx2 := hmono2 G'
  rw [hRres] at hx2
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply] at hx2
  rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul,
    smul_eq_mul] at hx2
  have hres1 := hresid G'
  rcases exists_primeDivisor_or_isExceptional hSv fS hT' hfSb G' with ⟨G, hG, hiso⟩ | hexc
  · -- `T ⟶ S` is an isomorphism at `G'`
    haveI := hiso
    have hnexc : ¬ (⟨T.idealSheaf.subscheme, fS, hT', hfSb, G'⟩ :
        DivisorOver k (S.idealSheaf.subschemeι ≫ sX)).IsExceptional :=
      not_isExceptional_of_map_genericPoint_eq hG
    have ha0 := eq_zero_of_isDiscrepancy_of_not_isExceptional hSs hSv hKS fS hT' hfSb G'
      (hdiscG G') hnexc
    have hky : (DY.restrictPrimeDivisor T).coeff G' = KS.coeff G := by
      exact MMP.Positivity.coeff_eq_of_isPullback G' G hG hKSc hKSpb
    have hnΩ : NΩ'.coeff G' = NΩ.coeff G := MMP.Positivity.coeff_eq_of_isPullback G' G hG hNΩc hNΩ'
    have hdμ : (Dμ.restrictPrimeDivisor T).coeff G' = (Dl.restrictPrimeDivisor S).coeff G := by
      refine MMP.Positivity.coeff_eq_of_isPullback G' G hG ?_ hDlpb
      exact MMP.Fourfold.isCartier_of_isSmoothScheme hSs _
    -- the coefficients of `D_l|_S`
    have hKXq : (Divisor.toQDivisor (KX + Finsupp.single S 1)).coeff S = 0 := by
      rw [Divisor.coeff_toQDivisor, hKXS0]; simp
    have hABS : (A + B).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_add, hAS, hBS, add_zero]
    have hcAS : ((c : ℚ)⁻¹ • A).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_smul, hAS, smul_zero]
    have hsum1 : (Divisor.toQDivisor (KX + Finsupp.single S 1) + (A + B)).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_add, hKXq, hABS, add_zero]
    have hsum2 : (Divisor.toQDivisor (KX + Finsupp.single S 1) + (A + B) +
        (c : ℚ)⁻¹ • A).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_add, hsum1, hcAS, add_zero]
    have hDlSq : Divisor.toQDivisor (Dl.restrictPrimeDivisor S) =
        (l : ℚ) • (Divisor.toQDivisor KS + Ω + (c : ℚ)⁻¹ • A.restrictPrimeDivisor S) := by
      have e1 : Divisor.toQDivisor Dl = (l : ℚ) • (Divisor.toQDivisor (KX + Finsupp.single S 1) +
          (A + B) + (c : ℚ)⁻¹ • A) := by
        rw [hDl, map_add]
        congr 1
        abel
      rw [← restrictPrimeDivisor_toQDivisor' S hDlS, e1, restrictPrimeDivisor_smul' S hsum2,
        restrictPrimeDivisor_add' S hsum1 hcAS, restrictPrimeDivisor_add' S hKXq hABS,
        restrictPrimeDivisor_toQDivisor' S hKXS0, restrictPrimeDivisor_smul' S hAS]
    have hdμq : (((Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℚ) = (l : ℚ) * ((KS.coeff G : ℚ) +
        Ω.coeff G + (c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G) := by
      have h := congrArg (fun D : QDivisor S.idealSheaf.subscheme => D.coeff G) hDlSq
      simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
        Divisor.coeff_toQDivisor, smul_eq_mul] at h
      rw [h]
    -- the good index at `G`
    obtain ⟨hFtop, σ, hσ, h, hres, hh, hineq⟩ := hGl G
    obtain ⟨hσ0, hσS⟩ := ne_zero_and_ord_eq_zero_of_isRestrictionAlong S hres hh
    set σY := functionFieldMap μ σ with hσYdef
    have hσY0 : σY ≠ 0 := (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr hσ0
    have hFle : ∀ P, Fμ.coeff P ≤ (Dμ + ffDiv σY hσY0).coeff P := by
      intro P
      have := (valuationOver_le_exp_iff μ P hσY0 _).mp ((hfix P).1 σ hσ)
      rw [← hσYdef] at this
      rw [DivisorWithCoeffs.coeff_add, coeff_ffDiv]
      omega
    have hσYT : (Dμ + ffDiv σY hσY0).coeff T = 0 := by
      rw [DivisorWithCoeffs.coeff_add, coeff_ffDiv, hDμT, zero_add, hσYdef,
        MMP.Positivity.ord_functionFieldMap_of_isIso μ T S hμT σ, hσS]
    have hresY := isRestrictionAlong_functionFieldMap μ S T fS inferInstance hfS hres
    have hfh0 : functionFieldMap fS h ≠ 0 :=
      (map_ne_zero_iff _ (functionFieldMap fS).injective).mpr hh
    have hadd := restrictPrimeDivisor_add_ffDiv (μ ≫ sX) hsmY T hsmT' Dμ hDμT hresY hσY0 hfh0
    have hmonoF := restrictPrimeDivisor_mono' T hFμT hσYT (D₁ := Fμ)
      (D₂ := Dμ + ffDiv σY hσY0) (fun P => hFle P)
    have hFG := hmonoF G'
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply] at hFG
    rw [hadd, DivisorWithCoeffs.coeff_add, coeff_ffDiv, hdμ,
      MMP.Positivity.ord_functionFieldMap_of_isIso fS G' G hG h] at hFG
    -- the real numbers of the comparison
    have hεc : (ε : ℝ) / c < 1 := by
      have hc1 : (1 : ℝ) ≤ c := by exact_mod_cast hc
      rw [div_lt_one (by linarith)]
      have : (ε : ℝ) < 1 := by exact_mod_cast hε1
      linarith
    have hlam0 : (0 : ℝ) ≤ 1 - (ε : ℝ) / c := by linarith
    have hΩ0 : (0 : ℚ) ≤ Ω.coeff G := coeff_restrictPrimeDivisor_nonneg' S
      (fun P => add_nonneg (hA0 P) (hB0 P)) hABS G
    have hΦG : min (Ω.coeff G : ℝ) ((1 - (ε : ℝ) / c) * (F G).toReal) ≤ Φ.coeff G := by
      have h1 := hΦlo G
      change (coeffwiseMin Ω (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G)).coeff G ≤
        (QDivisor.toRDivisor Φ).coeff G at h1
      rw [coeff_coeffwiseMin, QDivisor.coeff_toRDivisor,
        ENNReal.toReal_min ENNReal.ofReal_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hFtop),
        ENNReal.toReal_ofReal (by exact_mod_cast hΩ0), ENNReal.toReal_mul,
        ENNReal.toReal_ofReal hlam0] at h1
      exact h1
    have hΦ0 : (0 : ℝ) ≤ Φ.coeff G := by exact_mod_cast nonneg_of_coeffwiseMin_le hΦlo G
    have hCG0 : (0 : ℝ) ≤ (((c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G : ℚ) : ℝ) := by
      have h3 : (0 : ℚ) ≤ (A.restrictPrimeDivisor S).coeff G :=
        coeff_restrictPrimeDivisor_nonneg' S (fun P => hA0 P) hAS G
      exact_mod_cast mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg c)) h3
    have hCF : (((c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G : ℚ) : ℝ) ≠ 0 →
        (F G).toReal = 0 := by
      intro hne
      have hA : (A.restrictPrimeDivisor S).coeff G ≠ 0 := by
        intro h0; apply hne; rw [h0]; simp
      rw [hAF G hA]; rfl
    have hnΩ0 : ((NΩ.coeff G : ℤ) : ℝ) ≤ (mm : ℝ) * ((Ω.coeff G : ℝ) - Φ.coeff G) := by
      rw [hNΩ, DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul,
        DivisorWithCoeffs.coeff_sub, smul_eq_mul]
      have := Int.floor_le ((mm : ℚ) * (Ω.coeff G - Φ.coeff G))
      exact_mod_cast this
    have hkyt : ((((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) =
        KS.coeff G := by rw [hres1, ha0, add_zero, hky]
    have hx2r : ((((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G' : ℤ) : ℝ) ≤
        (l : ℝ) * ((Ω.coeff G : ℝ) + (((c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G : ℚ) : ℝ)) +
          (El.restrictPrimeDivisor T).coeff G' := by
      have h1 : ((((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) ≤
          (Dμ.restrictPrimeDivisor T).coeff G' -
            l * ((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' +
            (El.restrictPrimeDivisor T).coeff G' := by exact_mod_cast hx2
      rw [hkyt, hdμ, hdμq] at h1
      have h2 : ((((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) ≤
          (l : ℚ) * (Ω.coeff G + (c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G) +
            (El.restrictPrimeDivisor T).coeff G' := by linarith
      exact_mod_cast h2
    have hx1r : ((((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G' : ℤ) : ℝ) ≤
        ((Fμ.restrictPrimeDivisor T).coeff G' : ℝ) := by exact_mod_cast hx1
    have hfr : ((Fμ.restrictPrimeDivisor T).coeff G' : ℝ) ≤
        (l : ℝ) * (1 - (ε : ℝ) / c) * (F G).toReal := by
      refine le_trans ?_ hineq
      have : (Fμ.restrictPrimeDivisor T).coeff G' ≤ (Dl.restrictPrimeDivisor S).coeff G +
          S.idealSheaf.subscheme.ord h G.genericPoint := hFG
      push_cast
      exact_mod_cast (by linarith : (Fμ.restrictPrimeDivisor T).coeff G' ≤
        S.idealSheaf.subscheme.ord h G.genericPoint + (Dl.restrictPrimeDivisor S).coeff G)
    have key := comparison_arith (K := (KS.coeff G : ℝ)) hmm' (Nat.cast_nonneg m')
      (Nat.cast_nonneg l) hCG0 hCF (by exact_mod_cast hη0) hΦ0 hΦG hnΩ0 hx1r hfr hx2r
    rw [hky, hnΩ, hdμ]
    have hdμr : (((Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℝ) = (l : ℝ) * ((KS.coeff G : ℝ) +
        Ω.coeff G + (((c : ℚ)⁻¹ * (A.restrictPrimeDivisor S).coeff G : ℚ) : ℝ)) := by
      exact_mod_cast hdμq
    have : (((mm : ℤ) * KS.coeff G + NΩ.coeff G : ℤ) : ℝ) ≤ (((m' : ℤ) *
        ((Dl.restrictPrimeDivisor S).coeff G + (El.restrictPrimeDivisor T).coeff G' -
          ((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G') : ℤ) : ℝ) := by
      push_cast
      rw [hdμr]
      exact key
    exact_mod_cast this
  · -- `G'` is exceptional over `S`: the canonicity of `(S, Ω + A|_S)`
    have hΦ0 : 0 ≤ Φ := nonneg_of_coeffwiseMin_le hΦlo
    have hNle : Divisor.toQDivisor NΩ ≤ (mm : ℚ) • ((A + B).restrictPrimeDivisor S +
        A.restrictPrimeDivisor S) := by
      intro G
      change ((NΩ.coeff G : ℤ) : ℚ) ≤ ((mm : ℚ) • ((A + B).restrictPrimeDivisor S +
        A.restrictPrimeDivisor S)).coeff G
      rw [hNΩ, DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_smul,
        DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
        smul_eq_mul, smul_eq_mul]
      have h1 := Int.floor_le ((mm : ℚ) * (Ω.coeff G - Φ.coeff G))
      have h2 : (0 : ℚ) ≤ Φ.coeff G := hΦ0 G
      have h3 : (0 : ℚ) ≤ (A.restrictPrimeDivisor S).coeff G :=
        coeff_restrictPrimeDivisor_nonneg' S (fun P => hA0 P) hAS G
      have h4 : (0 : ℚ) ≤ mm := Nat.cast_nonneg _
      nlinarith
    have hmm0 : 0 < mm := Nat.mul_pos (Nat.mul_pos hc hl0) hm''
    have hle := coeff_isPullback_le_of_isRealCanonicalPair hSs fS hT' hfSb G' (hdiscG G') hcan
      hexc hmm0 hNle hNΩ'
    have hm'0 : (0 : ℚ) ≤ m' := Nat.cast_nonneg _
    have hmmq : (mm : ℚ) = (m' : ℚ) * l := by rw [hmm, hm']; push_cast; ring
    have hx2q : ((((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) ≤
        (Dμ.restrictPrimeDivisor T).coeff G' -
          l * ((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' +
          (El.restrictPrimeDivisor T).coeff G' := by exact_mod_cast hx2
    have key : (((mm : ℤ) * (DY.restrictPrimeDivisor T).coeff G' + NΩ'.coeff G' : ℤ) : ℚ) ≤
        (((m' : ℤ) * ((Dμ.restrictPrimeDivisor T).coeff G' +
          (El.restrictPrimeDivisor T).coeff G' -
            ((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G') : ℤ) : ℚ) := by
      push_cast
      have h1 : (m' : ℚ) * (l * ((((KY + Finsupp.single T 1).restrictPrimeDivisor T).coeff G' :
          ℤ) : ℚ)) ≤ (m' : ℚ) * ((Dμ.restrictPrimeDivisor T).coeff G' +
            (El.restrictPrimeDivisor T).coeff G' -
              ((Γl ⊓ Fμ).restrictPrimeDivisor T).coeff G') :=
        mul_le_mul_of_nonneg_left (by linarith) hm'0
      rw [hres1] at h1
      have e1 : (m' : ℚ) * (l * ((((DY.restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) + aG G')) =
          mm * (((DY.restrictPrimeDivisor T).coeff G' : ℤ) : ℚ) + mm * aG G' := by
        rw [hmmq]; ring
      linarith [h1, hle, e1]
    exact_mod_cast key

/-- The pull-back to the strict transform `T` of a section of `𝒪_S(m(K_S + Ω - Φ))` is a section
of `m' D_ET|_T` (Step Y8 of `exists_isRestrictionAlong_twist_of_resolution`). -/
private theorem functionFieldMap_mem_sectionsIn_restrictPrimeDivisor_of_resolution
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX)
    (n' : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX (n' + 1))
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1) [IsIntegral S.idealSheaf.subscheme]
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (c : ℕ) (hc : 0 < c)
    (hcan : IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
      (QDivisor.toRDivisor ((A + B).restrictPrimeDivisor S + A.restrictPrimeDivisor S)))
    (F : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme → ENNReal)
    (hAF : ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0)
    (ε : ℚ) (hε1 : ε < 1)
    (Φ : QDivisor S.idealSheaf.subscheme)
    (hΦlo : coeffwiseMin ((A + B).restrictPrimeDivisor S)
      (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤ QDivisor.toRDivisor Φ)
    (l : ℕ) (hl0 : 0 < l) (Dl : Divisor X)
    (hDl : Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A))
    (hDlc : Dl.IsCartier) (hDlS : Dl.coeff S = 0)
    (hGl : ∀ G : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme, F G ≠ ⊤ ∧
        ∃ σ ∈ sectionsIn Dl, ∃ h : S.idealSheaf.subscheme.functionField,
          IsRestrictionAlong S σ h ∧ ∃ hh : h ≠ 0,
            (((S.idealSheaf.subscheme.ord h G.genericPoint +
              (Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℝ) ≤
                (l : ℝ) * (1 - (ε : ℝ) / c) * (F G).toReal))
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [IsProper μ] [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)]
    (hDμL : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ Dl.supp)
    (Dμ Fμ : Divisor Y) (hDμ : Dl.IsPullback μ hDμL Dμ)
    (hfix : IsFixedDivisorOfPullback μ (sectionsIn Dl) Dμ Fμ)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hsmY : IsSmoothScheme (μ ≫ sX))
    (T : MMP.Mori.PrimeDivisor Y) (hμT : μ T.genericPoint = S.genericPoint)
    (hTiso : IsIso (μ.stalkMap T.genericPoint)) (hTS : inverseTransformPrimeDivisor μ S = some T)
    [IsIntegral T.idealSheaf.subscheme] [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme]
    (Ex : Finset (MMP.Mori.PrimeDivisor Y))
    (hEx : ∀ E, E ∈ Ex ↔ RationalMap.IsExceptional μ.toRationalMap E)
    (hPairS : MMP.Mori.IsPair sX (Divisor.toQDivisor (Finsupp.single S 1) + 0))
    (e : MMP.Mori.PrimeDivisor Y → ℚ)
    (he : ∀ E, MMP.Mori.IsDiscrepancy sX (n' + 1) KX
      (Divisor.toQDivisor (Finsupp.single S 1) + 0) ⟨Y, μ, hY, hμ, E⟩ (e E))
    (fS : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme) [IsDominant fS]
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) (hfSp : IsProper fS)
    (hsmT : IsSmoothScheme (fS ≫ S.idealSheaf.subschemeι ≫ sX))
    (hT' : IsNormalVariety k (fS ≫ S.idealSheaf.subschemeι ≫ sX)) (hfSb : IsBirationalMorphism fS)
    (hcrepT : ∀ KS : Divisor S.idealSheaf.subscheme,
      KS.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n' →
        IsCrepantBoundary (S.idealSheaf.subschemeι ≫ sX) n' KS
          ((0 : QDivisor X).restrict S.idealSheaf.subschemeι) fS hT' hfSb
          (-∑ E ∈ Ex, e E • DivisorWithCoeffs.restrict T.idealSheaf.subschemeι
            (Finsupp.single E (1 : ℚ))))
    (hfSeq : fS ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ ≫ sX)
    (ω : RationalPluriForms sX (n' + 1) 1) (hω0 : ω ≠ 0)
    (hωK : ∀ Γ : MMP.Mori.PrimeDivisor X, Γ.ordForm ω = KX.coeff Γ)
    (KY : Divisor Y) (hKYdef : KY = divisorOfForm (pullbackRationalPluriForms sX μ ω))
    (hKY : KY.IsCanonicalDivisor (μ ≫ sX) (n' + 1)) (hKYT : KY.coeff T = -1)
    (hDμstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        Dμ.coeff Q' = Dl.coeff Q)
    (lΘ Γl El Hl Ξl DET : Divisor Y) (hlΘ : lΘ = Dμ - (l : ℤ) • KY) (hΓl : Γl = lΘ ⊔ 0)
    (hEl : El = (-lΘ) ⊔ 0) (hHl : Hl = Fμ + El) (hΞl : Ξl = Γl - Γl ⊓ Hl)
    (hDET : DET = (l : ℤ) • KY + Ξl)
    (hlΘT : lΘ.coeff T = l) (hFμ0 : ∀ P, 0 ≤ Fμ.coeff P) (hFμT : Fμ.coeff T = 0)
    (hΓT : Γl.coeff T = l) (hE0 : ∀ P, 0 ≤ El.coeff P)
    (m'' : ℕ) (hm'' : 0 < m'') (m' : ℕ) (hm' : m' = c * m'')
    (u : S.idealSheaf.subscheme.functionField)
    (hu : u ∈ sectionsIn (DivisorWithCoeffs.roundDown (((c * l * m'' : ℕ) : ℚ) •
      (Divisor.toQDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S) +
        ((A + B).restrictPrimeDivisor S - Φ))))) :
    functionFieldMap fS u ∈
      sectionsIn (((m' : ℤ) • (DET + principalDivisor 1)).restrictPrimeDivisor T) := by
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  classical
  haveI : NoetherianSpace Y := MMP.Resolution.Aux.noetherianSpace_of_finiteType (μ ≫ sX)
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  haveI : Smooth (μ ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hsmY
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSs
  have hsmT' : IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ ≫ sX) := by rw [← hfSeq]; exact hsmT
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hsmT'
  haveI : CompactSpace T.idealSheaf.subscheme :=
    T.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
  haveI : IsProper fS := hfSp
  haveI : IsSeparated sX := hX.1.toIsSeparated
  haveI : IsSeparated (S.idealSheaf.subscheme ↘ ⊤_ Scheme) := by
    rw [show (S.idealSheaf.subscheme ↘ ⊤_ Scheme) =
      S.idealSheaf.subschemeι ≫ sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from
        Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : AlgebraicGeometry.IsVariety k (S.idealSheaf.subschemeι ≫ sX) := ⟨⟩
  set KS : Divisor S.idealSheaf.subscheme := (KX + Finsupp.single S 1).restrictPrimeDivisor S
    with hKSdef
  have hKXS0 : (KX + Finsupp.single S 1).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKXS, DivisorWithCoeffs.coeff_single_self]; norm_num
  have hKS : KS.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n' :=
    isCanonicalDivisor_restrictPrimeDivisor_add_single sX hX hXs n' KX hKX S hKXS hSs
  have hKXSc : (KX + Finsupp.single S 1).IsCartier :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hXs _
  obtain ⟨DY, _hBY, hDYpb, hDYT, aG, hresid, hdiscG⟩ :=
    exists_isPullback_restrictPrimeDivisor_discrepancy_of_resolution sX hX hXs n' KX hKX S hKS μ
      hY hμ hsmY T hμT hTS Ex hEx hPairS e he fS hT' hfSb hcrepT ω hω0 hωK KY hKYdef hKY hKYT
  -- the pull-backs of `K_S` and `D_l|_S` to `T`
  obtain ⟨hBKS, hKSpb⟩ := isPullback_restrictPrimeDivisor sX μ S T fS inferInstance hfS hKXSc
    hKXS0 hDYpb hDYT
  have hDμT : Dμ.coeff T = 0 := by rw [hDμstrict S T hμT hTiso, hDlS]
  obtain ⟨hBDl, hDlpb⟩ := isPullback_restrictPrimeDivisor sX μ S T fS inferInstance hfS hDlc
    hDlS hDμ hDμT
  -- the divisor of `u`
  set mm : ℕ := c * l * m'' with hmm
  have hmm' : (mm : ℝ) = (m' : ℝ) * l := by rw [hmm, hm']; push_cast; ring
  set Ω : QDivisor S.idealSheaf.subscheme := (A + B).restrictPrimeDivisor S with hΩdef
  set NΩ : Divisor S.idealSheaf.subscheme :=
    DivisorWithCoeffs.roundDown ((mm : ℚ) • (Ω - Φ)) with hNΩ
  have hNu : DivisorWithCoeffs.roundDown ((mm : ℚ) • (Divisor.toQDivisor KS + (Ω - Φ))) =
      (mm : ℤ) • KS + NΩ := by
    refine Finsupp.ext fun G => ?_
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_roundDown, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, hNΩ, DivisorWithCoeffs.coeff_roundDown,
      DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor, smul_eq_mul, smul_eq_mul, smul_eq_mul, mul_add,
      show (mm : ℚ) * ((KS.coeff G : ℤ) : ℚ) = (((mm : ℤ) * KS.coeff G : ℤ) : ℚ) by push_cast; ring,
      Int.floor_intCast_add]
  have hNΩc : NΩ.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hSs NΩ
  obtain ⟨NΩ', hNΩ'⟩ := hNΩc.exists_isPullback
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fS NΩ)
  have hKSc : KS.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hSs KS
  have hpbNu := (hKSpb.zsmul hKSc (mm : ℤ)
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fS _)).add
      (hKSc.zsmul _) hNΩc
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant fS ((mm : ℤ) • KS + NΩ))
      hNΩ'
  have hu' : u ∈ sectionsIn ((mm : ℤ) • KS + NΩ) := by rw [← hNu]; exact hu
  have huT1 := functionFieldMap_mem_sectionsIn_of_isPullback fS ((hKSc.zsmul _).add hNΩc)
    hpbNu hu'
  exact sectionsIn_mono (coeff_le_coeff_restrictPrimeDivisor_clipped_of_resolution sX hX hXs n'
    KX S hSs hKXS0 hKS A B hA0 hB0 hAS hBS c hc hcan F hAF ε hε1 Φ hΦlo l hl0 Dl hDl hDlS hGl μ
    Dμ Fμ hfix hY hsmY T hμT fS hfS hfSp hsmT hT' hfSb hfSeq KY hKYT lΘ Γl El Hl Ξl DET hlΘ hΓl
    hEl hHl hΞl hDET hlΘT hFμ0 hFμT hΓT hE0 m'' hm'' m' hm' DY aG hresid hdiscG hBKS hKSpb hDμT
    hBDl hDlpb NΩ' _ hNΩ') huT1

/-- An extension on `Y` of the pull-back of `u` to `T` descends to a section of
`𝒪_X(m(D + C) + P)` restricting to `u` (Step Y9). -/
private theorem exists_isRestrictionAlong_of_extension_of_resolution (hX : IsNormalVariety k sX)
    (S : MMP.Mori.PrimeDivisor X) [IsIntegral S.idealSheaf.subscheme]
    (A B : QDivisor X) (c : ℕ) (KX : Divisor X) (l : ℕ) (hlq : (0 : ℚ) < l) (Dl : Divisor X)
    (hDl : Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A))
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [IsProper μ] [CompactSpace Y] [LocallyOfFiniteType (μ ≫ sX)]
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (T : MMP.Mori.PrimeDivisor Y) [IsIso (μ.stalkMap T.genericPoint)]
    [IsIntegral T.idealSheaf.subscheme]
    (fS : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme) [IsDominant fS]
    (hfS : fS ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    (R' : QDivisor X) (hR'0 : ∀ Q : MMP.Mori.PrimeDivisor X, 0 ≤ R'.coeff Q)
    (Dμ KY : Divisor Y)
    (hDμstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        Dμ.coeff Q' = Dl.coeff Q)
    (lΘ Γl Ξl DET : Divisor Y) (hlΘ : lΘ = Dμ - (l : ℤ) • KY) (hΓl : Γl = lΘ ⊔ 0)
    (hDET : DET = (l : ℤ) • KY + Ξl)
    (hlΘstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        (lΘ.coeff Q' : ℚ) = (l : ℚ) * R'.coeff Q)
    (hΞΓ : ∀ P, Ξl.coeff P ≤ Γl.coeff P)
    (PY : Divisor Y)
    (P : Divisor X) (hP : P = MMP.Mori.RationalMap.transformDivisor (X := Y) μ.toRationalMap PY)
    (m'' m' : ℕ) (hm' : m' = c * m'') (u : S.idealSheaf.subscheme.functionField)
    (gY : Y.functionField)
    (hgY : gY ∈ sectionsIn ((m' : ℤ) • (DET + principalDivisor 1) + (PY + principalDivisor 1)))
    (hresY : IsRestrictionAlong T gY (functionFieldMap fS u)) :
    ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown (((c * l * m'' : ℕ) : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A)) + P),
      IsRestrictionAlong S g u := by
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  classical
  obtain ⟨g, hgμ, hgres⟩ := exists_functionFieldMap_eq_and_isRestrictionAlong μ S T fS hfS
    inferInstance gY u hresY
  have hround : DivisorWithCoeffs.roundDown (((c * l * m'' : ℕ) : ℚ) •
      (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
        (c : ℚ)⁻¹ • A)) = (m' : ℤ) • Dl := by
    rw [← roundDown_toQDivisor' ((m' : ℤ) • Dl), map_zsmul, hDl, ← Int.cast_smul_eq_zsmul ℚ,
      smul_smul]
    congr 2
    rw [hm']
    push_cast
    ring
  refine ⟨g, mem_sectionsIn_of_functionFieldMap μ hX hY hμ ?_ (hgμ ▸ hgY), hgres⟩
  intro Q Q' hQ hiso
  rw [hround, MMP.Mori.principalDivisor_one, add_zero, add_zero, DivisorWithCoeffs.coeff_add,
    DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_smul,
    smul_eq_mul, smul_eq_mul]
  have hDETQ : DET.coeff Q' ≤ Dl.coeff Q := by
    have h1 := hΞΓ Q'
    have h2 : Γl.coeff Q' = lΘ.coeff Q' := by
      rw [hΓl, DivisorWithCoeffs.coeff_apply, Finsupp.sup_apply]
      have h3 : (0 : ℚ) ≤ lΘ.coeff Q' := by
        rw [hlΘstrict Q Q' hQ hiso]; exact mul_nonneg hlq.le (hR'0 Q)
      have h4 : 0 ≤ lΘ.coeff Q' := by exact_mod_cast h3
      exact max_eq_left h4
    have h5 : lΘ.coeff Q' = Dμ.coeff Q' - l * KY.coeff Q' := by
      rw [hlΘ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    rw [hDET, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      ← hDμstrict Q Q' hQ hiso]
    linarith
  have hPQ : PY.coeff Q' = P.coeff Q := by
    obtain ⟨E, hE, hEiso, hEtr⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hY hμ Q
    have hEQ : E = Q' := by
      have h1 := MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
        hE (hE ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus μ hμ Q)
      have h2 := MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
        hQ (hQ ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus μ hμ Q)
      rw [h1] at h2
      exact Option.some.inj h2
    subst hEQ
    change PY E = P Q
    rw [hP, hEtr PY]
  rw [← hPQ]
  have hm'0 : (0 : ℤ) ≤ m' := by positivity
  nlinarith

/-- **Lifting through the resolution of the series** (the inclusions (1)–(3) of the source).
Given a good index `l` and a log resolution `μ : Y ⟶ X` of the boundary and of `|l(D + C)|`,
some effective `P` and `M` make every section of `𝒪_S(m(K_S + Ω - Φ))`, `M ∣ m`, the
restriction of a section of `𝒪_X(m(D + C) + P)`. -/
private theorem exists_isRestrictionAlong_twist_of_resolution (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] [IsNormal Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (hA : A.HasRelativelyAmpleMultiple f)
    (c : ℕ) (hc : 0 < c)
    (hplt : IsPltPair sX n KX
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A))
    (hfloor : DivisorWithCoeffs.roundDown
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A) = Finsupp.single S 1)
    (hcan : haveI := S.integral; IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
      (QDivisor.toRDivisor ((A + B).restrictPrimeDivisor S + A.restrictPrimeDivisor S)))
    (hsec : ∃ m : ℕ, 0 < m ∧ ((m : ℚ) • (Divisor.toQDivisor KX +
        (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
      ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
          (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
        S.divisorialValuation σ = WithZero.exp ((DivisorWithCoeffs.roundDown ((m : ℚ) •
          (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))).coeff S))
    (F : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme) → ENNReal)
    (hF : haveI := S.integral; F = restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) ((A + B).restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule <| AddSubgroup.closure
        {h | ((m : ℚ) • (Divisor.toQDivisor KX +
            (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
          ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
              (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
            IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}))
    (hAF : haveI := S.integral; ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0)
    (ε : ℚ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (hεA : (ε • (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)) +
      A).HasRelativelyAmpleMultiple f)
    (hcΔ : ((c : ℚ) • (Divisor.toQDivisor (Finsupp.single S 1) + A + B)).IsCartierDivisor)
    (Φ : haveI := S.integral; QDivisor S.idealSheaf.subscheme)
    (hcΦ : ((c : ℚ) • Φ).IsCartierDivisor)
    (hΦlo : haveI := S.integral; coeffwiseMin ((A + B).restrictPrimeDivisor S)
      (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤ QDivisor.toRDivisor Φ)
    (hΦhi : Φ ≤ (A + B).restrictPrimeDivisor S)
    (l : ℕ) (hl0 : 0 < l) (Dl : Divisor X)
    (hDl : Divisor.toQDivisor Dl = (l : ℚ) •
        (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
          (c : ℚ)⁻¹ • A))
    (σ₀ : X.functionField) (hσ₀ : σ₀ ∈ sectionsIn Dl) (hσ₀0 : σ₀ ≠ 0)
    (hσ₀S : S.divisorialValuation σ₀ = 1)
    (hGl : haveI := S.integral; ∀ G : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme, F G ≠ ⊤ ∧
        ∃ σ ∈ sectionsIn Dl, ∃ h : S.idealSheaf.subscheme.functionField,
          IsRestrictionAlong S σ h ∧ ∃ hh : h ≠ 0,
            (((S.idealSheaf.subscheme.ord h G.genericPoint +
              (Dl.restrictPrimeDivisor S).coeff G : ℤ) : ℝ) ≤
                (l : ℝ) * (1 - (ε : ℝ) / c) * (F G).toReal))
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] (hDμL : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ Dl.supp)
    (Dμ Fμ : Divisor Y)
    (hlog : MMP.Mori.IsLogResolution sX (QDivisor.toRDivisor
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A)) μ)
    (hproj : IsProjectiveMorphism μ) (hDμ : Dl.IsPullback μ hDμL Dμ)
    (hfix : IsFixedDivisorOfPullback μ (sectionsIn Dl) Dμ Fμ)
    (hfree : IsFreeModuloFixedDivisor μ (sectionsIn Dl) Dμ Fμ)
    (hsnc : IsSNCSubset (μ ≫ sX) (exceptionalSet μ ⊔ (QDivisor.toRDivisor
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A)).supp.preimage
        μ.continuous ⊔ Fμ.supp)) :
    ∃ P : Divisor X, P.IsCartier ∧ 0 ≤ P ∧ P.coeff S = 0 ∧ ∃ M : ℕ, 0 < M ∧
      ∀ m : ℕ, 0 < m → M ∣ m →
        haveI := S.integral
        ∀ u ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor
            ((KX + Finsupp.single S 1).restrictPrimeDivisor S) +
              ((A + B).restrictPrimeDivisor S - Φ)))),
          ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) •
              (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
                (c : ℚ)⁻¹ • A)) + P),
            IsRestrictionAlong S g u       := by
  haveI := S.integral
  classical
  haveI : IsNoetherian X := {}
  haveI : MMP.Mori.IsVariety k sX := hX.1
  obtain ⟨n', rfl⟩ := exists_eq_succ_of_isCanonicalDivisor sX hX hKX S
  have hres := hlog.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsProper μ := hres.isProper
  have hμ : IsBirationalMorphism μ := hres.isBirationalMorphism
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  -- the strict transform `T` of `S`
  obtain ⟨T, hμT, hTiso, hTpush⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hY hμ S
  have hTS : inverseTransformPrimeDivisor μ S = some T :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint hμT
      (hμT ▸ MMP.Fourfold.Oai4C1.genericPoint_mem_biregularLocus μ hμ S)
  haveI := T.integral
  -- Step Y1: the induced morphism `T → S` and the crepant boundary of `(S, 0)` on `T`
  have hRS : (QDivisor.toRDivisor (Divisor.toQDivisor (Finsupp.single S 1) + A + B +
      (c : ℚ)⁻¹ • A)).coeff S ≠ 0 := by
    rw [QDivisor.coeff_toRDivisor]
    change (((((Finsupp.single S (1 : ℤ)) S : ℤ) : ℚ) + A S + B S + (c : ℚ)⁻¹ * A S : ℚ) : ℝ) ≠ 0
    rw [show A S = 0 from hAS, show B S = 0 from hBS]
    simp
  have hlogS := isLogResolution_single hlog S hRS hTS
  obtain ⟨Ex, hEx⟩ := exists_finset_isExceptional hlog hY
  have hPairS : MMP.Mori.IsPair sX (Divisor.toQDivisor (Finsupp.single S 1) + 0) :=
    ⟨hX, _, KX, hKX, MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _⟩
  choose e he using fun E : MMP.Mori.PrimeDivisor Y =>
    MMP.Positivity.IsPair.exists_isDiscrepancy hPairS hKX (⟨Y, μ, hY, hμ, E⟩ : DivisorOver k sX)
  have hcartS : ∀ x : X, Order.coheight x = 2 → x ∈ S.support →
      MMP.Flips.IsCartierAt (Finsupp.single S (1 : ℤ)) x := by
    intro x _ _
    haveI : LocallyOfFinitePresentation sX :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
    haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hXs
    have hU : IsSmoothScheme ((⊤ : X.Opens).ι ≫ sX) :=
      (MMP.Mori.isSmoothScheme_iff _).mpr inferInstance
    exact ⟨⊤, trivial, MMP.Fourfold.isCartier_of_isSmoothScheme hU _⟩
  have hdisj : Disjoint (T.support : Set Y)
      ((inverseTransformDivisor μ (0 : QDivisor X)).supp : Set Y) := by
    rw [map_zero, DivisorWithCoeffs.supp_zero]
    exact Set.disjoint_empty _
  obtain ⟨⟨fS, hfS⟩, hall⟩ := MMP.Mori.isCrepantBoundary_restrict_of_isLogResolution sX hX hKX.1
    S.idealSheaf.subschemeι S (Scheme.IdealSheafData.range_subschemeι _) hcartS 0 (by simp) KX hKX
    (MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _) μ hlogS hY T hTS hdisj
    T.idealSheaf.subschemeι (Scheme.IdealSheafData.range_subschemeι _) Ex hEx e
    (fun E _ => he E)
  obtain ⟨hfSp, hsmT, hT', hfSb, hcrepT⟩ := hall fS hfS
  haveI : IsLocallyNoetherian T.idealSheaf.subscheme := by
    haveI : LocallyOfFiniteType (fS ≫ S.idealSheaf.subschemeι ≫ sX) := hT'.1.toLocallyOfFiniteType
    exact LocallyOfFiniteType.isLocallyNoetherian (fS ≫ S.idealSheaf.subschemeι ≫ sX)
  haveI : IsNormal T.idealSheaf.subscheme := hT'.2
  have hfSeq : fS ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ ≫ sX := by
    rw [reassoc_of% hfS]
  -- Step Y2: forms and the canonical divisor of `Y`
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hKX
  set KY : Divisor Y := divisorOfForm (pullbackRationalPluriForms sX μ ω) with hKYdef
  have hnY : topologicalKrullDim Y = ((n' + 1 : ℕ) : WithBot ℕ∞) := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ]
    exact hKX.1
  have hdX := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hKX.1
  have hσ0 : pullbackRationalPluriForms sX μ ω ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' μ hμ.functionFieldMap_bijective
      hdX hω0
  obtain ⟨K₀, hK₀⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
  have hKY : KY.IsCanonicalDivisor (μ ≫ sX) (n' + 1) :=
    hK₀.of_linearlyEquivalent <| by
      simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hY hK₀ hσ0
  -- `K_Y` agrees with `K_X` at strict transforms
  have hKYstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        KY.coeff Q' = KX.coeff Q := by
    intro Q Q' hQ hiso
    rw [hKYdef, coeff_divisorOfForm, MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso μ
      hμ.functionFieldMap_bijective hdX Q' Q hQ ω, hωK]
  have hKYT : KY.coeff T = -1 := by rw [hKYstrict S T hμT hTiso, hKXS]
  -- the coefficients of `Dl` and of its pull-back at strict transforms
  have hDlc : Dl.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs Dl
  have hDlQ : ∀ Q : MMP.Mori.PrimeDivisor X, (Dl.coeff Q : ℚ) = (l : ℚ) * ((KX.coeff Q : ℚ) +
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A).coeff Q) := by
    intro Q
    have := congrArg (fun D : QDivisor X => D Q) hDl
    change ((Dl Q : ℤ) : ℚ) = (l : ℚ) * (((KX Q : ℤ) : ℚ) + _ + _ + _ + _) at this
    rw [DivisorWithCoeffs.coeff_apply, this]
    change _ = (l : ℚ) * (((KX Q : ℤ) : ℚ) + (_ + _ + _ + _))
    ring
  have hDμstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        Dμ.coeff Q' = Dl.coeff Q := fun Q Q' hQ hiso =>
    MMP.Positivity.coeff_eq_of_isPullback Q' Q hQ hDlc hDμ
  have hRS1 : (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A).coeff S = 1 := by
    change (((Finsupp.single S (1 : ℤ)) S : ℤ) : ℚ) + A S + B S + (c : ℚ)⁻¹ * A S = 1
    rw [show A S = 0 from hAS, show B S = 0 from hBS]
    simp
  have hDlS : Dl.coeff S = 0 := by
    have h1 := hDlQ S
    rw [hRS1, hKXS] at h1
    exact_mod_cast (show (Dl.coeff S : ℚ) = 0 by rw [h1]; ring)
  -- Step Y3: the boundaries `Γ`, `E`, the fixed part `H` and `Ξ`, scaled by `l`
  set lΘ : Divisor Y := Dμ - (l : ℤ) • KY with hlΘ
  set Γl : Divisor Y := lΘ ⊔ 0 with hΓl
  set El : Divisor Y := (-lΘ) ⊔ 0 with hEl
  set Hl : Divisor Y := Fμ + El with hHl
  set Ξl : Divisor Y := Γl - Γl ⊓ Hl with hΞl
  set DET : Divisor Y := (l : ℤ) • KY + Ξl with hDET
  set BET : QDivisor Y := (l : ℚ)⁻¹ • Divisor.toQDivisor Ξl -
    Divisor.toQDivisor (Finsupp.single T 1) with hBET
  set R' : QDivisor X := Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A with hR'
  have hlq : (0 : ℚ) < l := by exact_mod_cast hl0
  -- the coefficients of `lΘ`
  have hlΘstrict : ∀ (Q : MMP.Mori.PrimeDivisor X) (Q' : MMP.Mori.PrimeDivisor Y),
      μ Q'.genericPoint = Q.genericPoint → IsIso (μ.stalkMap Q'.genericPoint) →
        (lΘ.coeff Q' : ℚ) = (l : ℚ) * R'.coeff Q := by
    intro Q Q' hQ hiso
    rw [hlΘ, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, hDμstrict Q Q' hQ hiso,
      hKYstrict Q Q' hQ hiso, smul_eq_mul, Int.cast_sub, Int.cast_mul, Int.cast_natCast, hDlQ Q]
    ring
  have hlΘT : lΘ.coeff T = l := by
    have h1 := hlΘstrict S T hμT hTiso
    rw [hRS1, mul_one] at h1
    exact_mod_cast h1
  have hR'lt : ∀ Q : MMP.Mori.PrimeDivisor X, Q ≠ S → R'.coeff Q < 1 := by
    intro Q hQ
    have h1 := congrArg (fun D : Divisor X => D Q) hfloor
    change ⌊R' Q⌋ = (Finsupp.single S (1 : ℤ)) Q at h1
    rw [Finsupp.single_eq_of_ne hQ, Int.floor_eq_zero_iff] at h1
    exact h1.2
  have hR'0 : ∀ Q : MMP.Mori.PrimeDivisor X, 0 ≤ R'.coeff Q := by
    intro Q
    change (0 : ℚ) ≤ ((Finsupp.single S (1 : ℤ) Q : ℤ) : ℚ) + A Q + B Q + (c : ℚ)⁻¹ * A Q
    have h1 : (0 : ℤ) ≤ Finsupp.single S (1 : ℤ) Q := by
      rw [Finsupp.single_apply]; split_ifs <;> norm_num
    have h2 : (0 : ℚ) ≤ A Q := hA0 Q
    have h3 : (0 : ℚ) ≤ B Q := hB0 Q
    have h4 : (0 : ℚ) ≤ (c : ℚ)⁻¹ := by positivity
    have h5 : (0 : ℚ) ≤ ((Finsupp.single S (1 : ℤ) Q : ℤ) : ℚ) := by exact_mod_cast h1
    nlinarith
  have hlΘexc : ∀ P : MMP.Mori.PrimeDivisor Y, μ P.genericPoint ∉ biregularLocus μ →
      lΘ.coeff P < l :=
    coeff_pullback_sub_smul_canonical_lt_of_resolution sX hX hXs n' KX hKX S A B c R' hR' hplt l
      hl0 Dl hDl hDlc μ hDμL Dμ hDμ hY hμ ω hω0 hωK KY hKYdef hKY lΘ hlΘ
  have hlΘlt : ∀ P : MMP.Mori.PrimeDivisor Y, P ≠ T → lΘ.coeff P < l := by
    intro P hPT
    by_cases hP : μ P.genericPoint ∈ biregularLocus μ
    · obtain ⟨Q, hQ, hiso⟩ := exists_primeDivisor_of_mem_biregularLocus μ P hP
      have hQS : Q ≠ S := by
        rintro rfl
        apply hPT
        have h2 := MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
          hQ hP
        rw [hTS] at h2
        exact (Option.some.inj h2).symm
      have h1 := hlΘstrict Q P hQ hiso
      have h3 := hR'lt Q hQS
      have h4 : (lΘ.coeff P : ℚ) < l := by rw [h1]; nlinarith
      exact_mod_cast h4
    · exact hlΘexc P hP
  -- the fixed divisor does not contain `T`
  have hFμ0 : ∀ P, 0 ≤ Fμ.coeff P := fun P =>
    coeff_nonneg_of_isFixedDivisorOfPullback hDlc subset_rfl hDμ hfix P hY hμ
  have hFμT : Fμ.coeff T = 0 := by
    have h1 := (hfix T).1 σ₀ hσ₀
    rw [valuationOver_eq_of_isIso' μ T S hμT, hσ₀S, hDμstrict S T hμT hTiso, hDlS, zero_sub,
      ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
    linarith [hFμ0 T]
  have hlΘexc' := hlΘexc
  obtain ⟨hBET0, hBET1, hBETT, hΞ0, hΞΓ, hΞT, hHT, hET, hΓT, hE0⟩ :=
    clippedBoundary_facts T hl0 hΓl hEl hHl hΞl hlΘT hlΘlt hFμ0 hFμT
  have hΔET : DivisorWithCoeffs.IsSNC (μ ≫ sX) (Divisor.toQDivisor (Finsupp.single T 1) + BET) :=
    isSNC_single_add_clippedBoundary_of_resolution sX μ R' Fμ T l hl0 lΘ Γl Ξl hΓl hlΘstrict hlΘT
      hΞ0 hΞΓ hsnc
  have hDETeq : Divisor.toQDivisor DET = (l : ℚ) • (Divisor.toQDivisor KY +
      Divisor.toQDivisor (Finsupp.single T 1) + BET) :=
    toQDivisor_zsmul_add_eq KY Ξl T hlq.ne'
  -- Step Y4: a very ample divisor on `Y` and the twist
  have hprojY : IsProjectiveMorphism (μ ≫ f) := IsProjectiveMorphism.comp hproj hf
  obtain ⟨A₁, hA₁0, hA₁T, hA₁⟩ := exists_effective_hasImmersionTwistOver hsmY (μ ≫ f) hprojY T
  have hA₁c : A₁.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY A₁
  have hA₁amp : (Divisor.toQDivisor A₁).HasRelativelyAmpleMultiple (μ ≫ f) :=
    ⟨1, one_pos, A₁, hA₁c, by rw [Nat.cast_one, one_smul],
      isRelativelyAmple_of_isAmple_of_isAffine (μ ≫ f) hA₁c
        (isAmple_of_hasImmersionTwistOver (μ ≫ f) hprojY hA₁c hA₁)⟩
  obtain ⟨r, hr0, hamp⟩ :=
    exists_hasRelativelyAmpleMultiple_twist_of_resolution sX f μ hsmY hprojY A₁ hA₁c hA₁ KY T BET l
  set PY : Divisor Y := ((1 * (n' + 1) + r : ℕ) : ℤ) • A₁ with hPY
  -- Step Y5: the stable base locus of `D_ET` contains no stratum
  have hbase : ContainsNoStratum (Finsupp.single T 1 + DivisorWithCoeffs.roundUp BET)
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • DET)) ((m : ℤ) • DET)) :=
    containsNoStratum_baseLocus_of_resolution sX μ R' hR'0 Dl Dμ Fμ KY hfix hfree T l hl0 lΘ Γl El
      Hl Ξl DET hlΘ hΓl hEl hHl hΞl hDET hlΘstrict hlΘT hΞ0 hΞΓ hΞT hsnc
  -- Step Y6: the extension theorem with one ample twist
  have hET := MMP.Fourfold.asymptoticAdjointIdeal_subset_and_exists_isRestrictionAlong
    (μ ≫ sX) hY hsmY (μ ≫ f) hprojY (n' + 1) KY hKY T BET hBET0 hBET1 hBETT hΔET l hl0 DET hDETeq
    (Divisor.toQDivisor A₁) hA₁amp 1 r one_pos hr0 A₁ (by rw [Nat.cast_one, one_smul]) hA₁
    (isCartierDivisor_of_integral hsmY ⟨(r : ℤ) • A₁, by
      rw [map_zsmul, ← Int.cast_smul_eq_zsmul ℚ]; push_cast; rfl⟩) hamp PY
    (by rw [hPY, map_zsmul, ← Int.cast_smul_eq_zsmul ℚ]; push_cast; rfl) hbase
  -- Step Y7: the effective twist on `X`
  haveI : IsDominant fS := hfSb.isDominant
  set P : Divisor X := MMP.Mori.RationalMap.transformDivisor (X := Y) μ.toRationalMap PY with hP
  have hPYc : ∀ P', PY.coeff P' = ((1 * (n' + 1) + r : ℕ) : ℤ) * A₁.coeff P' := fun P' => rfl
  have hP0 : 0 ≤ P := by
    intro Q
    obtain ⟨Q', -, -, hQ'⟩ :=
      MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply.{0, 0} hX hY hμ Q
    change (0 : ℤ) ≤ P Q
    rw [hP, hQ' PY]
    change (0 : ℤ) ≤ PY.coeff Q'
    rw [hPYc]
    exact mul_nonneg (by positivity) (hA₁0 Q')
  have hPS : P.coeff S = 0 := by
    change P S = 0
    rw [hP, hTpush PY]
    change PY.coeff T = 0
    rw [hPYc, hA₁T, mul_zero]
  have hPYT : (PY + principalDivisor 1).coeff T = 0 := by
    rw [MMP.Mori.principalDivisor_one, add_zero, hPYc, hA₁T, mul_zero]
  have hDETT : (DET + principalDivisor 1).coeff T = 0 := by
    rw [MMP.Mori.principalDivisor_one, add_zero, hDET, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, hKYT, hΞT, smul_eq_mul]
    ring
  refine ⟨P, MMP.Fourfold.isCartier_of_isSmoothScheme hXs P, hP0, hPS, c * l,
    Nat.mul_pos hc hl0, ?_⟩
  intro m hm hdvd u hu
  obtain ⟨m'', rfl⟩ := hdvd
  by_cases hu0 : u = 0
  · exact ⟨0, (sectionsSubgroup _).zero_mem, 0, map_zero _, by rw [hu0, map_zero]⟩
  have hm'' : 0 < m'' := Nat.pos_of_mul_pos_left hm
  set m' : ℕ := c * m'' with hm'
  -- Step Y8: the pull-back of `u` to `T` is a section of `m' D_ET|_T`
  set uT : T.idealSheaf.subscheme.functionField := functionFieldMap fS u with huTdef
  have huT0 : uT ≠ 0 := (map_ne_zero_iff _ (functionFieldMap fS).injective).mpr hu0
  have huT : uT ∈ sectionsIn (((m' : ℤ) • (DET + principalDivisor 1)).restrictPrimeDivisor T) :=
    functionFieldMap_mem_sectionsIn_restrictPrimeDivisor_of_resolution sX hX hXs n' KX hKX S hKXS
      hSs A B hA0 hB0 hAS hBS c hc hcan F hAF ε hε1 Φ hΦlo l hl0 Dl hDl hDlc hDlS hGl μ hDμL Dμ Fμ
      hDμ hfix hY hμ hsmY T hμT hTiso hTS Ex hEx hPairS e he fS hfS hfSp hsmT hT' hfSb hcrepT hfSeq
      ω hω0 hωK KY hKYdef hKY hKYT hDμstrict lΘ Γl El Hl Ξl DET hlΘ hΓl hEl hHl hΞl hDET hlΘT hFμ0
      hFμT hΓT hE0 m'' hm'' m' hm' u hu
  -- the asymptotic multiplier ideal on `T` and the membership of `u_T`
  obtain ⟨J₀, hJ₀, hmem⟩ : ∃ J₀ : T.idealSheaf.subscheme.Opens →
      Set T.idealSheaf.subscheme.functionField,
      IsAsymptoticAdjointIdealOfDivisor (T.idealSheaf.subschemeι ≫ μ ≫ sX)
        (T.idealSheaf.subschemeι ≫ μ ≫ f) 0
        (((m' : ℤ) • (DET + principalDivisor 1)).restrictPrimeDivisor T) 1 1 J₀ ∧
      ∀ x : T.idealSheaf.subscheme, ∃ W : T.idealSheaf.subscheme.Opens, x ∈ W ∧
        uT ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections
          (𝟙 T.idealSheaf.subscheme) (((m' : ℤ) • (DET + principalDivisor 1) +
            (PY + principalDivisor 1)).restrictPrimeDivisor T) W * J₀ W) := by
    haveI : NoetherianSpace Y := MMP.Resolution.Aux.noetherianSpace_of_finiteType (μ ≫ sX)
    haveI : CompactSpace T.idealSheaf.subscheme :=
      T.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
    have hTsm : IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ ≫ sX) := by rw [← hfSeq]; exact hsmT
    have hTv : IsNormalVariety k (T.idealSheaf.subschemeι ≫ μ ≫ sX) := by rw [← hfSeq]; exact hT'
    have hprojT : IsProjectiveMorphism (T.idealSheaf.subschemeι ≫ μ ≫ f) :=
      (MMP.isProjectiveMorphism_of_isClosedImmersion _).comp hprojY
    have hPY0 : ∀ P', 0 ≤ (PY + principalDivisor 1).coeff P' := fun P' => by
      rw [MMP.Mori.principalDivisor_one, add_zero, hPYc]
      exact mul_nonneg (by positivity) (hA₁0 P')
    have hPT0 : 0 ≤ (PY + principalDivisor 1).restrictPrimeDivisor T := fun G' =>
      coeff_restrictPrimeDivisor_nonneg' T hPY0 hPYT G'
    obtain ⟨J₀, hJ₀, hmem⟩ := exists_isAsymptoticAdjointIdealOfDivisor_mem_span
      (T.idealSheaf.subschemeι ≫ μ ≫ sX) (T.idealSheaf.subschemeι ≫ μ ≫ f) hprojT hTv hTsm hPT0
      huT huT0
    refine ⟨J₀, hJ₀, fun x => ?_⟩
    obtain ⟨V, hxV, hV⟩ := hmem x
    refine ⟨V, hxV, ?_⟩
    have h1 : ((m' : ℤ) • (DET + principalDivisor 1)).coeff T = 0 := by
      rw [DivisorWithCoeffs.coeff_smul, hDETT, smul_zero]
    rw [restrictPrimeDivisor_add' T h1 hPYT]
    exact hV
  obtain ⟨-, hext2⟩ := hET m' (Nat.succ_le_of_lt (Nat.mul_pos hc hm'')) 1 hDETT
  obtain ⟨gY, hgY, hresY⟩ := hext2 1 J₀ hJ₀ 1 hPYT uT hmem
  -- Step Y9: push the extension down to `X`
  exact exists_isRestrictionAlong_of_extension_of_resolution sX hX S A B c KX l hlq Dl hDl μ hY hμ
    T fS hfS R' hR'0 Dμ KY hDμstrict lΘ Γl Ξl DET hlΘ hΓl hDET hlΘstrict hΞΓ PY P hP m'' m' hm' u gY hgY hresY

/-- **Extension after an effective twist** (the inclusion (3) of the source). With `C = A/c`,
there are an effective Cartier divisor `P` not containing `S` and `M > 0` such that for every
`m` divisible by `M` every section of `𝒪_S(m(K_S + Ω - Φ))` is the restriction of a section of
`𝒪_X(m(D + C) + P)`. -/
public theorem exists_isRestrictionAlong_twist (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] [IsNormal Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (hA : A.HasRelativelyAmpleMultiple f)
    (c : ℕ) (hc : 0 < c)
    (hplt : IsPltPair sX n KX
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A))
    (hfloor : DivisorWithCoeffs.roundDown
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A) = Finsupp.single S 1)
    (hcan : haveI := S.integral; IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
      (QDivisor.toRDivisor ((A + B).restrictPrimeDivisor S + A.restrictPrimeDivisor S)))
    (hsec : ∃ m : ℕ, 0 < m ∧ ((m : ℚ) • (Divisor.toQDivisor KX +
        (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
      ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
          (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
        S.divisorialValuation σ = WithZero.exp ((DivisorWithCoeffs.roundDown ((m : ℚ) •
          (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))).coeff S))
    (F : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme) → ENNReal)
    (hF : haveI := S.integral; F = restrictedAsymptoticFixedPart
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) ((A + B).restrictPrimeDivisor S) 1
      (fun m => AddSubgroup.toIntSubmodule <| AddSubgroup.closure
        {h | ((m : ℚ) • (Divisor.toQDivisor KX +
            (Divisor.toQDivisor (Finsupp.single S 1) + A + B))).IsCartierDivisor ∧
          ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor KX +
              (Divisor.toQDivisor (Finsupp.single S 1) + A + B)))),
            IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}))
    (hAF : haveI := S.integral; ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0)
    (ε : ℚ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (hεA : (ε • (Divisor.toQDivisor KX + (Divisor.toQDivisor (Finsupp.single S 1) + A + B)) +
      A).HasRelativelyAmpleMultiple f)
    (hcΔ : ((c : ℚ) • (Divisor.toQDivisor (Finsupp.single S 1) + A + B)).IsCartierDivisor)
    (Φ : haveI := S.integral; QDivisor S.idealSheaf.subscheme)
    (hcΦ : ((c : ℚ) • Φ).IsCartierDivisor)
    (hΦlo : haveI := S.integral; coeffwiseMin ((A + B).restrictPrimeDivisor S)
      (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤ QDivisor.toRDivisor Φ)
    (hΦhi : Φ ≤ (A + B).restrictPrimeDivisor S) :
    ∃ P : Divisor X, P.IsCartier ∧ 0 ≤ P ∧ P.coeff S = 0 ∧ ∃ M : ℕ, 0 < M ∧
      ∀ m : ℕ, 0 < m → M ∣ m →
        haveI := S.integral
        ∀ u ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • (Divisor.toQDivisor
            ((KX + Finsupp.single S 1).restrictPrimeDivisor S) +
              ((A + B).restrictPrimeDivisor S - Φ)))),
          ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) •
              (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
                (c : ℚ)⁻¹ • A)) + P),
            IsRestrictionAlong S g u := by
  haveI := S.integral
  obtain ⟨l, hl0, Dl, hDl, ⟨σ₀, hσ₀, hσ₀0, hσ₀S⟩, hGl⟩ := exists_good_index sX hX hXs f hf n KX
    hKX S hKXS hSs A B hA0 hB0 hAS hBS hA c hc hplt hfloor hcan hsec F hF hAF ε hε0 hε1 hεA hcΔ
    Φ hcΦ hΦlo hΦhi
  obtain ⟨Y, μ, _, _, _, _, hDμL, Dμ, Fμ, hlog, hproj, hDμ, hfix, hfree, hsnc⟩ :=
    exists_isLogResolution_isFreeModuloFixedDivisor sX hX hXs (QDivisor.toRDivisor
      (Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A)) (sectionsIn Dl)
      subset_rfl hσ₀ hσ₀0
  exact exists_isRestrictionAlong_twist_of_resolution sX hX hXs f hf n KX hKX S hKXS hSs A B hA0
    hB0 hAS hBS hA c hc hplt hfloor hcan hsec F hF hAF ε hε0 hε1 hεA hcΔ Φ hcΦ hΦlo hΦhi l hl0 Dl
    hDl σ₀ hσ₀ hσ₀0 hσ₀S hGl μ hDμL Dμ Fμ hlog hproj hDμ hfix hfree hsnc

end Core

/-! ### Arithmetic -/

/-- `x = a • (a⁻¹ • x)` for a nonzero natural number `a`, with the outer scalar in `ℤ`. -/
public theorem zsmul_inv_smul_eq {M : Type*} [AddCommGroup M] [Module ℚ M] (x : M) {a : ℕ}
    (ha : (a : ℚ) ≠ 0) : x = ((a : ℕ) : ℤ) • ((a : ℚ)⁻¹ • x) := by
  rw [← Int.cast_smul_eq_zsmul ℚ, smul_smul]
  push_cast
  rw [mul_inv_cancel₀ ha, one_smul]

/-- `(c - 1)/(c · M a (N₀ + 2)) < δ` once `N₀ > 1/δ`. -/
public theorem div_lt_of_nat_gt {δ : ℚ} (hδ : 0 < δ) {N₀ c M a : ℕ} (hN₀ : 1 / δ < N₀)
    (hc : 0 < c) (hM : 0 < M) (ha : 0 < a) :
    ((c : ℚ) - 1) / ((c * (M * a * (N₀ + 2)) : ℕ) : ℚ) < δ := by
  have hN₀' : (0 : ℚ) < N₀ := lt_trans (one_div_pos.mpr hδ) hN₀
  have hcq : (0 : ℚ) < c := by exact_mod_cast hc
  have hl : (N₀ : ℚ) ≤ ((M * a * (N₀ + 2) : ℕ) : ℚ) := by
    have : 1 ≤ M * a := Nat.one_le_iff_ne_zero.mpr (by positivity)
    exact_mod_cast (show N₀ ≤ M * a * (N₀ + 2) by nlinarith)
  have h1 : 1 / (N₀ : ℚ) < δ := by
    rw [div_lt_iff₀ hN₀']
    rw [div_lt_iff₀ hδ] at hN₀
    linarith
  calc ((c : ℚ) - 1) / ((c * (M * a * (N₀ + 2)) : ℕ) : ℚ)
      ≤ (c : ℚ) / ((c * (M * a * (N₀ + 2)) : ℕ) : ℚ) :=
        div_le_div_of_nonneg_right (by linarith) (Nat.cast_nonneg _)
    _ = 1 / ((M * a * (N₀ + 2) : ℕ) : ℚ) := by
        rw [Nat.cast_mul]; field_simp
    _ ≤ 1 / (N₀ : ℚ) := one_div_le_one_div_of_le hN₀' hl
    _ < δ := h1

/-! ### Assembly -/

end MMP.Proof_thm_fourfold_asymptotic_section_lifting

end

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori
open MMP.Proof_thm_fourfold_asymptotic_section_lifting
open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

/-- **Lifting below the asymptotic restricted fixed divisor.** Let `f : X ⟶ Z` be a projective
morphism to a normal affine scheme from a smooth variety `X` over an algebraically closed field
`k` of characteristic zero, with canonical divisor `K_X`, `S` a smooth prime divisor with `K_X`
of coefficient `-1` along `S`, `K_S = (K_X + S)|_S`, and `B ≥ 0` a `ℚ`-divisor not containing
`S`. Let `H₀` be very ample over `Z`, `a ≥ 3`, and `s₁, …, s_N` sections generating `𝒪_X(H₀)`.
Then there is a nonzero polynomial `Q` such that for every `t ∈ kᴺ` with `Q(t) ≠ 0` the function
`g = ∑ tᵢ sᵢ` is nonzero and, for `H = H₀ + div g`, `A = H/a`, `Δ = S + A + B`, `D = K_X + Δ`,
`Ω = (A + B)|_S` and `F` the asymptotic fixed part of the restricted systems `|mD|_S`
(`MMP.Fourfold.restrictedAsymptoticFixedPart`): if `S ⊄ H`, `(X, Δ)` is plt with `⌊Δ⌋ = S`,
`(S, Ω + A|_S)` is canonical, some `mD`, `m > 0`, has a section not vanishing along `S`, and
`H|_S` has no component in the support of `F`, then for every rational `0 < ε < 1` with
`εD + A` `f`-ample, every `c > 0` with `cΔ` integral and every `ℚ`-divisor `Φ` on `S` with `cΦ`
integral and `Ω ∧ (1 - ε/c)F ≤ Φ ≤ Ω`, every section of `𝒪_S(c(K_S + Ω - Φ))` is the restriction
of a section of `𝒪_X(cD)`. -/
@[mmp "thm_fourfold_asymptotic_section_lifting"]
public theorem exists_isRestrictionAlong_of_le_restrictedAsymptoticFixedPart {k : Type}
    [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX)
    (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] [IsNormal Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (B : QDivisor X) (hB0 : 0 ≤ B) (hBS : B.coeff S = 0)
    (H₀ : Divisor X)
    (hH₀ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f H₀.divisorialSheaf)
    (a : ℕ) (ha : 3 ≤ a)
    (N : ℕ) (s : Fin N → X.functionField) (hs : ∀ i, s i ∈ sectionsIn H₀)
    (hgen : ∀ g ∈ sectionsIn H₀, ∀ x : X, ∃ r : Fin N → X.presheaf.stalk x,
      g = ∑ i, (X.presheaf.stalkSpecializes (genericPoint_specializes x)).hom (r i) * s i) :
    haveI := S.integral
    ∃ Q : MvPolynomial (Fin N) k, Q ≠ 0 ∧ ∀ t : Fin N → k, MvPolynomial.eval t Q ≠ 0 →
      let g : X.functionField :=
        ∑ i, baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom (t i)) * s i
      ∃ hg : g ≠ 0,
        let H : Divisor X := H₀ + MMP.Mori.principalDivisor
          (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg))
        let A : QDivisor X := (a : ℚ)⁻¹ • Divisor.toQDivisor H
        let Δ : QDivisor X := Divisor.toQDivisor (Finsupp.single S 1) + A + B
        let D : QDivisor X := Divisor.toQDivisor KX + Δ
        let KS : Divisor S.idealSheaf.subscheme := (KX + Finsupp.single S 1).restrictPrimeDivisor S
        let Ω : QDivisor S.idealSheaf.subscheme := (A + B).restrictPrimeDivisor S
        let V : ℕ → Submodule ℤ (RationalFunctions S.idealSheaf.subscheme) := fun m =>
          AddSubgroup.toIntSubmodule <| AddSubgroup.closure
            {h | ((m : ℚ) • D).IsCartierDivisor ∧
              ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
                IsRestrictionAlong S g (rationalFunctionsEquivFunctionField _ h)}
        let F := restrictedAsymptoticFixedPart KS Ω 1 V
        H.coeff S = 0 →
        MMP.Mori.IsPltPair sX n KX Δ →
        DivisorWithCoeffs.roundDown Δ = Finsupp.single S 1 →
        IsRealCanonicalPair (S.idealSheaf.subschemeι ≫ sX)
          (QDivisor.toRDivisor (Ω + A.restrictPrimeDivisor S)) →
        (∃ m : ℕ, 0 < m ∧ ((m : ℚ) • D).IsCartierDivisor ∧
          ∃ σ ∈ sectionsIn (DivisorWithCoeffs.roundDown ((m : ℚ) • D)),
            S.divisorialValuation σ =
              WithZero.exp ((DivisorWithCoeffs.roundDown ((m : ℚ) • D)).coeff S)) →
        (∀ G, (H.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0) →
        ∀ ε : ℚ, 0 < ε → ε < 1 → (ε • D + A).HasRelativelyAmpleMultiple f →
        ∀ c : ℕ, 0 < c → ((c : ℚ) • Δ).IsCartierDivisor →
        ∀ Φ : QDivisor S.idealSheaf.subscheme, ((c : ℚ) • Φ).IsCartierDivisor →
          coeffwiseMin Ω (fun G => ENNReal.ofReal (1 - (ε : ℝ) / c) * F G) ≤
            QDivisor.toRDivisor Φ →
          Φ ≤ Ω →
          ∀ u ∈ sectionsIn (DivisorWithCoeffs.roundDown
              ((c : ℚ) • (Divisor.toQDivisor KS + Ω - Φ))),
            ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((c : ℚ) • D)),
              IsRestrictionAlong S g u := by
  haveI := S.integral
  obtain ⟨Q, hQ0, hQ⟩ := exists_polynomial_isPltPair_add_smul sX hX hXs f hf n KX hKX S B hBS H₀
    hH₀ N s hs hgen
  refine ⟨Q, hQ0, fun t ht => ?_⟩
  obtain ⟨hg, hGP⟩ := hQ t ht
  clear hQ
  refine ⟨hg, ?_⟩
  intro H A Δ D KS Ω V F hHS hplt hfloor hcan hsec hHF ε hε0 hε1 hεA c hc hcΔ Φ hcΦ hΦlo hΦhi
    u hu
  have ha0 : (0 : ℚ) < a := by exact_mod_cast (show 0 < a by omega)
  -- the member `H` and `A = H/a`
  have hH0 : 0 ≤ H := fun P => coeff_add_ffDiv_nonneg
    (sum_mem_sectionsIn sX s hs t) hg P
  have hA0 : 0 ≤ A := fun P => by
    have := hH0 P
    change (0 : ℚ) ≤ (a : ℚ)⁻¹ * ((H P : ℤ) : ℚ)
    exact mul_nonneg (inv_nonneg.mpr ha0.le) (by exact_mod_cast this)
  have hAS : A.coeff S = 0 := by
    change (a : ℚ)⁻¹ * ((H.coeff S : ℤ) : ℚ) = 0
    rw [hHS]; simp
  -- the pair with `C = A/c` added
  have hfloorSB : DivisorWithCoeffs.roundDown (Divisor.toQDivisor (Finsupp.single S 1) + B) =
      Finsupp.single S 1 := roundDown_single_add_eq S hA0 hB0 hfloor
  have hpltSB : IsPltPair sX n KX (Divisor.toQDivisor (Finsupp.single S 1) + B) :=
    isPltPair_of_add hX hXs hKX hA0 (by
      rw [show Divisor.toQDivisor (Finsupp.single S 1) + B + A = Δ by simp only [Δ]; abel]
      exact hplt)
  have hτ1 : ((1 : ℚ) + (c : ℚ)⁻¹) / a < 1 := by
    have hc1 : (c : ℚ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast hc)
    have ha3 : (3 : ℚ) ≤ a := by exact_mod_cast ha
    rw [div_lt_one ha0]
    linarith
  obtain ⟨hpltC, hfloorC⟩ := hGP (((1 : ℚ) + (c : ℚ)⁻¹) / a) (by positivity) hτ1 hfloorSB hpltSB
  clear hGP
  have hAamp : A.HasRelativelyAmpleMultiple f := by
    have hH₀c : H₀.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs H₀
    have hH₀a := isRelativelyAmple_of_isAmple_of_isAffine f hH₀c
      (isAmple_of_hasImmersionTwistOver f hf hH₀c hH₀)
    refine ⟨a, by omega, H, hH₀c.add (Divisor.isCartier_principalDivisor _), ?_,
      isRelativelyAmple_add_principalDivisor f hH₀c hH₀a _⟩
    exact zsmul_inv_smul_eq _ ha0.ne'
  have heqC : Divisor.toQDivisor (Finsupp.single S 1) + B +
      (((1 : ℚ) + (c : ℚ)⁻¹) / a) • Divisor.toQDivisor H =
      Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A := by
    simp only [A]
    rw [div_eq_mul_inv, add_mul, one_mul, add_smul, mul_smul, smul_comm ((c : ℚ)⁻¹)]
    abel
  rw [heqC] at hpltC hfloorC
  haveI : IsNoetherian X := {}
  have hAF : ∀ G, (A.restrictPrimeDivisor S).coeff G ≠ 0 → F G = 0 := fun G hG =>
    hHF G (coeff_restrictPrimeDivisor_ne_zero_of_smul S hHS _ G hG)
  obtain ⟨P, hPc, hP0, hPS, M, hM, hext⟩ := exists_isRestrictionAlong_twist sX hX hXs f hf n KX
    hKX S hKXS hSs A B hA0 hB0 hAS hBS hAamp c hc hpltC hfloorC hcan hsec F rfl hAF ε hε0 hε1 hεA
    hcΔ Φ hcΦ hΦlo hΦhi
  -- the data of the removal lemma
  have hkltΩ : IsKltPair (S.idealSheaf.subschemeι ≫ sX) ((A + B).restrictPrimeDivisor S) :=
    isKltPair_of_isRealCanonicalPair_add hSs
      (fun Q => coeff_restrictPrimeDivisor_nonneg' S (D := A + B)
        (fun P => add_nonneg (hA0 P) (hB0 P)) (by
          change A S + B S = 0
          rw [show A S = 0 from hAS, show B S = 0 from hBS, add_zero]) Q)
      (fun Q => coeff_restrictPrimeDivisor_nonneg' S (fun P => hA0 P) hAS Q) hcan
  have hcD : ((c : ℚ) • (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A +
      B)).IsCartierDivisor := by
    simpa only [Δ, add_assoc] using isCartierDivisor_smul_add hXs KX hcΔ
  have hΦ0' : 0 ≤ Φ := nonneg_of_coeffwiseMin_le hΦlo
  have hΦ0 : 0 ≤ (A + B).restrictPrimeDivisor S - Φ := sub_nonneg.mpr hΦhi
  have hΦΩ : (A + B).restrictPrimeDivisor S - Φ ≤ (A + B).restrictPrimeDivisor S :=
    sub_le_self _ hΦ0'
  have hcΦ' : ((c : ℚ) • (Divisor.toQDivisor ((KX + Finsupp.single S 1).restrictPrimeDivisor S) +
      ((A + B).restrictPrimeDivisor S - Φ))).IsCartierDivisor := by
    have hABS : (A + B).coeff S = 0 := by
      change A S + B S = 0
      rw [show A S = 0 from hAS, show B S = 0 from hBS, add_zero]
    refine isCartierDivisor_smul_add_sub hSs _
      (exists_toQDivisor_eq_smul_restrictPrimeDivisor S hABS
        (exists_toQDivisor_eq_smul_of_single_add S (by simpa only [Δ, add_assoc] using hcΔ)))
      hcΦ
  have hampP : ∃ L₀ : ℕ, ∀ l : ℕ, L₀ ≤ l → ((c : ℚ)⁻¹ • A - (((c : ℚ) - 1) / (c * l : ℕ)) •
      Divisor.toQDivisor P).HasRelativelyAmpleMultiple f := by
    have hH₀c : H₀.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs H₀
    have hH₀a := isRelativelyAmple_of_isAmple_of_isAffine f hH₀c
      (isAmple_of_hasImmersionTwistOver f hf hH₀c hH₀)
    exact Filter.eventually_atTop.mp (eventually_hasRelativelyAmpleMultiple_sub f hf
      (show 0 < a by omega) (hH₀c.add (Divisor.isCartier_principalDivisor _))
      (isRelativelyAmple_add_principalDivisor f hH₀c hH₀a _) (zsmul_inv_smul_eq _ ha0.ne') hc hPc)
  have hkltP : ∃ δ : ℚ, 0 < δ ∧ ∀ t : ℚ, 0 ≤ t → t < δ →
      IsKltPair (S.idealSheaf.subschemeι ≫ sX) ((A + B).restrictPrimeDivisor S +
        t • (Divisor.toQDivisor P).restrictPrimeDivisor S) :=
    exists_isKltPair_add_smul hSs hkltΩ (fun Q => coeff_restrictPrimeDivisor_nonneg' S
      (fun E => by change (0 : ℚ) ≤ ((P E : ℤ) : ℚ); exact_mod_cast hP0 E)
      (by change ((P S : ℤ) : ℚ) = 0; exact_mod_cast hPS) Q)
  obtain ⟨L₀, hamp₁⟩ := hampP
  obtain ⟨δ₂, hδ₂, hklt₂⟩ := hkltP
  obtain ⟨N₁, hN₁⟩ := exists_nat_gt (1 / δ₂)
  set N₀ : ℕ := max N₁ L₀ with hN₀_def
  have hN₀ : 1 / δ₂ < N₀ := lt_of_lt_of_le hN₁ (by exact_mod_cast le_max_left N₁ L₀)
  set l : ℕ := M * a * (N₀ + 2) with hl_def
  have hl : 1 < l := by
    have : 1 ≤ M * a := Nat.one_le_iff_ne_zero.mpr (by positivity)
    rw [hl_def]
    nlinarith
  have hlA : ((l : ℚ) • A).IsCartierDivisor :=
    isCartierDivisor_natCast_smul_inv_smul hXs H ha0.ne'
  have ht0 : 0 ≤ ((c : ℚ) - 1) / ((c * l : ℕ) : ℚ) :=
    div_nonneg (sub_nonneg.mpr (by exact_mod_cast hc)) (Nat.cast_nonneg _)
  have ht1 : ((c : ℚ) - 1) / ((c * l : ℕ) : ℚ) < δ₂ :=
    div_lt_of_nat_gt hδ₂ hN₀ hc hM (by omega)
  have hlL : L₀ ≤ l := by
    have : 1 ≤ M * a := Nat.one_le_iff_ne_zero.mpr (by positivity)
    have : L₀ ≤ N₀ := le_max_right _ _
    rw [hl_def]; nlinarith
  have hu' : u ∈ sectionsIn (DivisorWithCoeffs.roundDown ((c : ℚ) • (Divisor.toQDivisor
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + ((A + B).restrictPrimeDivisor S - Φ))))
      := by
    simpa only [KS, Ω, add_sub_assoc] using hu
  obtain ⟨g', hg', hres⟩ := exists_isRestrictionAlong_of_exists_isRestrictionAlong_twist sX hX hXs
    f hf n KX hKX S hKXS hSs A B hA0 hB0 hAS hBS hAamp hkltΩ c hc hcD
    ((A + B).restrictPrimeDivisor S - Φ) hΦ0 hΦΩ hcΦ' l hl P hPc hP0 hPS hlA
    (hamp₁ l hlL) (hklt₂ _ ht0 ht1)
    (fun u' hu'' => hext (c * l) (Nat.mul_pos hc (by omega))
      (Dvd.dvd.mul_left (Dvd.intro _ (by rw [hl_def, mul_assoc])) c) u' hu'') u hu'
  refine ⟨g', ?_, hres⟩
  simpa only [D, Δ, add_assoc] using hg'

end MMP.Fourfold

