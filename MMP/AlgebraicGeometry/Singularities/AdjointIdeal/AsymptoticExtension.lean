open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_fourfold_asymptotic_ideal_generation
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Pointwise Opposite
open MMP.Mori MMP.Fourfold

/-- **Uniform generation for asymptotic adjoint ideals of a graded series.** Let `f : X ⟶ Z` be
projective with `Z` affine and `X` a smooth variety of dimension `n` over an algebraically closed
field `k` of characteristic zero, let `J = 𝒥_{0,V_•}` be the asymptotic adjoint ideal (zero
boundary, `c = 1`) of a nonzero graded linear series `V_•` of an integral Cartier divisor `D`
(`MMP.Fourfold.IsAsymptoticAdjointIdeal`), let `K` be a canonical divisor, `A` an `f`-ample
Cartier divisor and `H` an `f`-very ample Cartier divisor. Put `G = D + K + A + nH`. Then
`J(G) = J ⊗ 𝒪_X(G)` is generated by global sections: for every point `x`, every section `h` of
`J(G)` over an open `W ∋ x` is, on some open `x ∈ W' ≤ W`, a sum of products of regular functions
on `W'` and global sections of `J(G)`. -/
@[mmp "lem_fourfold_asymptotic_ideal_generation"]
public theorem IsAsymptoticAdjointIdeal.generated_twist_canonical_add_ample_add_veryAmple
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    {Z : Scheme.{0}} (f : X ⟶ Z) (D : Divisor X) (V : ℕ → AddSubgroup X.functionField) (b : ℕ)
    (J : X.Opens → Set X.functionField) (hJ : IsAsymptoticAdjointIdeal sX f 0 D V b 1 J)
    (n : ℕ) (K : Divisor X) (hK : K.IsCanonicalDivisor sX n)
    (A : Divisor X) (hAc : A.IsCartier) (hA : A.IsRelativelyAmple f hAc)
    (H : Divisor X) (hHc : H.IsCartier)
    (hH : haveI := hHc.isInvertibleModule_divisorialSheaf
      Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f H.divisorialSheaf) :
    let G : Divisor X := D + K + A + (n : ℤ) • H
    -- sections of `J(G)` over `W`, before sheafification
    let M : X.Opens → Set X.functionField := fun W =>
      Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 X) G W * J W)
    -- global sections of `J(G)`
    let Γ : Set X.functionField := {h | ∀ x : X, ∃ W : X.Opens, x ∈ W ∧ h ∈ M W}
    ∀ (x : X) (W : X.Opens), x ∈ W → ∀ h ∈ M W, ∃ W' : X.Opens, x ∈ W' ∧ W' ≤ W ∧
      h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 X) 0 W' * Γ) := by
  intro G M Γ x W hxW h hh
  classical
  obtain ⟨hfp, hZa, hX, hsm, -, hDc, hgr, hb, hVb, -, -, Jp, hJp, hJiff⟩ := id hJ
  haveI := hZa
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hfp
  haveI : MMP.Mori.IsVariety k sX := hX.1
  -- a sufficiently divisible `p ≥ 2` computes `J`
  obtain ⟨-, -, p₀, hp₀, hbp₀, hstab⟩ :=
    (MMP.Fourfold.isAsymptoticAdjointIdeal_operations sX f).1 0 D V b 1 J hJ
  set p : ℕ := 2 * p₀ with hpdef
  have hp : 0 < p := by omega
  have hp₀p : p₀ ∣ p := Dvd.intro_left 2 rfl
  have hbp : b ∣ p := hbp₀.trans hp₀p
  obtain ⟨Y, μ, hOn⟩ := hJp p hp hbp
  have hJeq : ∀ (U : X.Opens) [Nonempty U], Jp p U = J U :=
    hstab p hp hp₀p (Jp p) ⟨Y, μ, hOn⟩
  -- `V_p ≠ 0`
  have hVp : V p ≠ ⊥ := ne_bot_of_isGradedLinearSeries hgr hVb hbp
  -- an affine variety under `X`
  obtain ⟨Z', sZ', g', hZ'v, hZ'a, hg's, hg'p⟩ :=
    exists_isProjectiveMorphism_isAffine_isVariety sX hX.1 f hfp
  -- a general member of the `k`-span of `V_p` computes `J_p`
  have hOn' := isSeriesAdjointIdealOn_constSpan sX hOn
  have hV0 : constSpan sX (V p) ≠ ⊥ := fun h0 => hVp (le_bot_iff.mp (h0 ▸ le_constSpan sX (V p)))
  have hVs : (constSpan sX (V p) : Set X.functionField) ⊆ sectionsIn ((p : ℤ) • D) :=
    hOn'.2.2.2.2.1
  have hp1 : (1 : ℚ) / p < 1 := by
    rw [div_lt_one (by exact_mod_cast hp)]
    exact_mod_cast (show 1 < p by omega)
  obtain ⟨⟨N, s, hsV, hgen⟩, hgen'⟩ :=
    MMP.Fourfold.IsSeriesAdjointIdealOn.exists_isReducedAdjointIdealOn_of_general sX sZ' g' hg's
      hg'p hZ'a hZ'v hsm ((p : ℤ) • D) (hDc.zsmul p) (constSpan sX (V p)) hVs hV0
      (fun a g hg => constFn_mul_mem_constSpan sX (V p) a hg) ((1 : ℚ) / p) (by positivity) hp1
      μ (Jp p) hOn'
  obtain ⟨Q, hQ, hQa⟩ := hgen' N s hsV hgen x
  obtain ⟨a, ha⟩ := exists_eval_ne_zero hQ
  obtain ⟨hg0, hRed, -⟩ := hQa a ha
  obtain ⟨u, hRed⟩ : ∃ u : (RationalFunctions X)ˣ, IsReducedAdjointIdealOn sX 0
      (((1 : ℚ) / p) • Divisor.toQDivisor ((p : ℤ) • D + principalDivisor u)) μ (Jp p) :=
    ⟨_, hRed⟩
  -- the data of `J_p = μ_*𝒪_Y(G₀)`
  obtain ⟨-, -, -, -, -, hlog, i1, i2, i3, i4, hY, hμb, -, Γ₀, E₀, F₀, -, -, -, hJpe⟩ :=
    id hRed
  set G₀ := E₀ - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F₀) with hG₀def
  haveI : IsProper μ := hlog.isProper
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace μ
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  have hμbij : Function.Bijective (functionFieldMap μ) := hμb.functionFieldMap_bijective
  have hJG₀ : ∀ U : X.Opens, U ≠ ⊥ → J U = MMP.Intersection.multiplierIdealSections μ G₀ U := by
    intro U hU
    obtain ⟨y, hy⟩ := (Opens.ne_bot_iff_nonempty U).1 hU
    haveI : Nonempty U := ⟨⟨y, hy⟩⟩
    rw [← hJeq U, hJpe]
  have hJsub : ∀ U, J U ⊆ MMP.Intersection.multiplierIdealSections μ G₀ U := by
    intro U g hg
    by_cases hU : U = ⊥
    · obtain rfl : g = 0 := ((hJiff U g).1 hg).1 hU
      exact ⟨fun _ => rfl, fun P _ => by simp⟩
    · rwa [hJG₀ U hU] at hg
  -- pull-backs of the twists
  have hHs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ H
  obtain ⟨Hμ, hHμ⟩ := hHc.exists_isPullback hHs
  have hM₀c : (D + K + A).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  obtain ⟨Mμ₀, hM₀μ⟩ :=
    hM₀c.exists_isPullback (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _)
  have hMpb : ∀ j : ℕ, (D + K + A + (j : ℤ) • H).IsPullback μ
      (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _) (Mμ₀ + (j : ℤ) • Hμ) :=
    fun j => Divisor.IsPullback.add hM₀c (hHc.zsmul j) _ hM₀μ
      (Divisor.IsPullback.zsmul hHc hHμ (j : ℤ)
        (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _))
  -- vanishing for every twist `D + K + A + jH`
  have hvan : ∀ j : ℕ, ∀ i : ℕ, 0 < i →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
        ((Scheme.Modules.pushforward μ).obj (G₀ + (Mμ₀ + (j : ℤ) • Hμ)).divisorialSheaf)) := by
    intro j i hi
    have hNc : (D + A + (j : ℤ) • H).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hMc : (D + K + A + (j : ℤ) • H).IsCartier :=
      MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hMK : (D + K + A + (j : ℤ) • H).LinearlyEquivalent (K + 0 + (D + A + (j : ℤ) • H)) := by
      rw [show K + 0 + (D + A + (j : ℤ) • H) = D + K + A + (j : ℤ) • H by abel]
    have hND : (Divisor.toQDivisor (D + A + (j : ℤ) • H) - ((1 : ℚ) / p) •
        Divisor.toQDivisor ((p : ℤ) • D + principalDivisor u)).HasRelativelyAmpleMultiple f :=
      hasRelativelyAmpleMultiple_add_sub_smul f D hAc hA hHc
        (isRelativelyAmple_of_hasImmersionTwistOver f hHc hH) j p hp u
    exact isZero_rightDerived_twist sX f hfp μ hRed G₀ hJpe (D + A + (j : ℤ) • H) hNc hND hK
      (D + K + A + (j : ℤ) • H) hMc hMK _ _ (hMpb j) i hi
  -- global generation of `μ_*𝒪_Y(G₀ + μ^*(D + K + A + nH))`
  haveI := hHc.isInvertibleModule_divisorialSheaf
  obtain ⟨R, _, _, Nn, ι, hι, ⟨eL⟩⟩ :=
    exists_isClosedImmersion_isNoetherianRing sX hX.1 f H.divisorialSheaf hH
  have hgg := isGloballyGenerated_pushforward_add_zsmul_pullback μ hHc hHμ
    (MMP.Fourfold.isCartier_of_isSmoothScheme hsmY (G₀ + Mμ₀)) ι eL n
    hK.topologicalKrullDim_eq.le fun j i hi => by rw [add_assoc]; exact hvan j i hi
  rw [add_assoc] at hgg
  -- read on rational functions
  have hGc : G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hmem := span_subset_multiplierIdealSections_add μ G₀ J hJsub hGc (hMpb n) W hh
  obtain ⟨W', hxW', hW'W, hspan⟩ :=
    exists_mem_span_of_isGloballyGenerated μ hμbij _ hgg hxW hmem
  refine ⟨W', hxW', hW'W, Submodule.span_mono (Set.mul_subset_mul_left ?_) hspan⟩
  intro t ht x'
  exact exists_mem_span_of_mem_multiplierIdealSections_add μ G₀ J (fun U hU => (hJG₀ U hU).ge)
    hGc (hMpb n) ht x'

end MMP.Fourfold

