/-! ### `thm_fourfold_asymptotic_section_lifting` -/

section

noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

namespace MMP.Proof_thm_fourfold_asymptotic_section_lifting

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

noncomputable section

variable {X : Scheme.{0}}

open Classical in
/-- The reduced divisor `Δ^s = S + ∑_{c b_E > c - s} E` of the filtration of `⌈S + B⌉`. -/
private def bdry (S : MMP.Mori.PrimeDivisor X) (B : QDivisor X) (c s : ℕ) : Divisor X :=
  Finsupp.single S 1 +
    (DivisorWithCoeffs.roundUp B).filter (fun E => ((c : ℚ) - s) < (c : ℚ) * B.coeff E)

/-- The partial sum `D_{≤ t} = ∑_{s ≤ t} (K_X + Δ^s)`. -/
private def dle (KX : Divisor X) (S : MMP.Mori.PrimeDivisor X) (B : QDivisor X) (c t : ℕ) : Divisor X :=
  ∑ s ∈ Finset.range t, (KX + bdry S B c (s + 1))

section Filtration

variable (S : MMP.Mori.PrimeDivisor X) (B : QDivisor X) (c : ℕ)

private theorem coeff_bdry_pos {s : ℕ} {E : MMP.Mori.PrimeDivisor X}
    (h : ((c : ℚ) - s) < (c : ℚ) * B.coeff E) :
    (bdry S B c s).coeff E = DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E + ⌈B.coeff E⌉ := by
  classical
  simp only [bdry, DivisorWithCoeffs.coeff_add]
  congr 1
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.filter_apply, if_pos h]
  exact DivisorWithCoeffs.coeff_roundUp B E

private theorem coeff_bdry_neg {s : ℕ} {E : MMP.Mori.PrimeDivisor X}
    (h : ¬ ((c : ℚ) - s) < (c : ℚ) * B.coeff E) :
    (bdry S B c s).coeff E = DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E := by
  classical
  simp only [bdry, DivisorWithCoeffs.coeff_add]
  rw [DivisorWithCoeffs.coeff_apply (Finsupp.filter _ _), Finsupp.filter_apply, if_neg h, add_zero]

private theorem single_le_bdry (hB0 : 0 ≤ B) (s : ℕ) :
    (Finsupp.single S 1 : Divisor X) ≤ bdry S B c s := by
  intro E
  change DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E ≤ (bdry S B c s).coeff E
  by_cases h : ((c : ℚ) - s) < (c : ℚ) * B.coeff E
  · rw [coeff_bdry_pos S B c h]
    have : (0 : ℚ) ≤ B.coeff E := hB0 E
    have : (0 : ℤ) ≤ ⌈B.coeff E⌉ := Int.ceil_nonneg this
    omega
  · rw [coeff_bdry_neg S B c h]

private theorem bdry_le (hB0 : 0 ≤ B) (s : ℕ) :
    bdry S B c s ≤ Finsupp.single S 1 + DivisorWithCoeffs.roundUp B := by
  intro E
  change (bdry S B c s).coeff E ≤ DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) + DivisorWithCoeffs.roundUp B : Divisor X) E
  rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_roundUp]
  by_cases h : ((c : ℚ) - s) < (c : ℚ) * B.coeff E
  · rw [coeff_bdry_pos S B c h]
  · rw [coeff_bdry_neg S B c h]
    have : (0 : ℚ) ≤ B.coeff E := hB0 E
    have : (0 : ℤ) ≤ ⌈B.coeff E⌉ := Int.ceil_nonneg this
    omega

private theorem bdry_one (hc : 0 < c) (hcB : ∀ E, ∃ z : ℤ, (c : ℚ) * B.coeff E = z)
    (hB1 : ∀ E, B.coeff E < 1) : bdry S B c 1 = Finsupp.single S 1 := by
  ext E
  change (bdry S B c 1).coeff E = _
  refine coeff_bdry_neg S B c ?_
  · obtain ⟨z, hz⟩ := hcB E
    have hc' : (0 : ℚ) < c := by exact_mod_cast hc
    have h1 : (c : ℚ) * B.coeff E < c := by
      have := mul_lt_mul_of_pos_left (hB1 E) hc'
      simpa using this
    rw [hz] at h1 ⊢
    have h2 : z < (c : ℤ) := by exact_mod_cast h1
    have h3 : z ≤ (c : ℤ) - 1 := by omega
    push_cast
    intro h4
    have h5 : ((c : ℤ) - 1 : ℚ) < z := by exact_mod_cast h4
    have h6 : (c : ℤ) - 1 < z := by exact_mod_cast h5
    omega

/-- The number of `s ∈ {1, …, c}` with `c - s < z` is `z`, for `0 ≤ z ≤ c`. -/
private theorem card_filter_lt (z : ℕ) (hz : z ≤ c) :
    ((Finset.range c).filter fun s => (c : ℚ) - (s + 1 : ℕ) < z).card = z := by
  have e : ((Finset.range c).filter fun s => (c : ℚ) - (s + 1 : ℕ) < z) = Finset.Ico (c - z) c := by
    ext s
    simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨?_, h1⟩
      have : ((c : ℤ) - (s + 1 : ℕ) : ℚ) < (z : ℤ) := by push_cast at h2 ⊢; linarith
      have : (c : ℤ) - (s + 1 : ℕ) < z := by exact_mod_cast this
      omega
    · rintro ⟨h1, h2⟩
      refine ⟨h2, ?_⟩
      have : (c : ℤ) - (s + 1 : ℕ) < z := by omega
      have : ((c : ℤ) - (s + 1 : ℕ) : ℚ) < (z : ℤ) := by exact_mod_cast this
      push_cast at this ⊢; linarith
  rw [e, Nat.card_Ico]
  omega

private theorem dle_eq (KX D : Divisor X) (hc : 0 < c) (hB0 : 0 ≤ B) (hB1 : ∀ E, B.coeff E < 1)
    (hcB : ∀ E, ∃ z : ℤ, (c : ℚ) * B.coeff E = z)
    (hD : Divisor.toQDivisor D =
      (c : ℚ) • (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + B)) :
    dle KX S B c c = D := by
  classical
  apply Divisor.toQDivisor_injective
  ext E
  have hDE := congrArg (fun G : QDivisor X => G.coeff E) hD
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
    Divisor.coeff_toQDivisor, smul_eq_mul] at hDE
  change ((dle KX S B c c).coeff E : ℚ) = (D.coeff E : ℚ)
  rw [hDE]
  have hsum : (dle KX S B c c).coeff E = ∑ s ∈ Finset.range c,
      (KX.coeff E + DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E +
        if ((c : ℚ) - (s + 1 : ℕ)) < (c : ℚ) * B.coeff E then ⌈B.coeff E⌉ else 0) := by
    unfold dle
    rw [show ∀ (F : ℕ → Divisor X), (∑ s ∈ Finset.range c, F s).coeff E =
        ∑ s ∈ Finset.range c, (F s).coeff E from fun F => map_sum
          (Finsupp.applyAddHom E) _ _]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [DivisorWithCoeffs.coeff_add]
    by_cases h : ((c : ℚ) - (s + 1 : ℕ)) < (c : ℚ) * B.coeff E
    · rw [coeff_bdry_pos S B c h, if_pos h]; ring
    · rw [coeff_bdry_neg S B c h, if_neg h]; ring
  rw [hsum, Int.cast_sum]
  simp only [Int.cast_add]
  rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have hBE0 : (0 : ℚ) ≤ B.coeff E := hB0 E
  rcases hBE0.lt_or_eq with hpos | hzero
  · -- `0 < b_E < 1`, so `⌈b_E⌉ = 1` and the count is `c b_E`
    have hceil : ⌈B.coeff E⌉ = 1 := by
      rw [Int.ceil_eq_iff]; constructor <;> push_cast <;> linarith [hB1 E]
    obtain ⟨z, hz⟩ := hcB E
    have hc' : (0 : ℚ) < c := by exact_mod_cast hc
    have hz0 : (0 : ℤ) ≤ z := by
      have : (0 : ℚ) ≤ z := by rw [← hz]; positivity
      exact_mod_cast this
    have hzc : z ≤ (c : ℤ) := by
      have : (z : ℚ) ≤ c := by
        rw [← hz]; nlinarith [hB1 E]
      exact_mod_cast this
    obtain ⟨z', rfl⟩ := Int.eq_ofNat_of_zero_le hz0
    have hcount := card_filter_lt c z' (by omega)
    have e2 : ∑ s ∈ Finset.range c,
        ((if ((c : ℚ) - (s + 1 : ℕ)) < (c : ℚ) * B.coeff E then ⌈B.coeff E⌉ else 0 : ℤ) : ℚ) =
        ((Finset.range c).filter fun s => (c : ℚ) - (s + 1 : ℕ) < z').card := by
      rw [Finset.card_filter, Nat.cast_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [hz, hceil]
      push_cast
      split_ifs <;> simp
    rw [e2, hcount]
    have : (c : ℚ) * B.coeff E = z' := by rw [hz]; push_cast; ring
    linear_combination -this
  · have e2 : ∑ s ∈ Finset.range c,
        ((if ((c : ℚ) - (s + 1 : ℕ)) < (c : ℚ) * B.coeff E then ⌈B.coeff E⌉ else 0 : ℤ) : ℚ) =
        0 := by
      refine Finset.sum_eq_zero fun s hs => ?_
      rw [← hzero, mul_zero, if_neg]
      · simp
      · have : s + 1 ≤ c := Finset.mem_range.mp hs
        have : ((s + 1 : ℕ) : ℚ) ≤ c := by exact_mod_cast this
        linarith
    rw [e2, ← hzero]
    ring

private theorem coeff_roundUp_le_one (hB0 : 0 ≤ B) (hB1 : ∀ E, B.coeff E < 1)
    (E : MMP.Mori.PrimeDivisor X) :
    ⌈B.coeff E⌉ = 0 ∨ ⌈B.coeff E⌉ = 1 := by
  have h0 : (0 : ℚ) ≤ B.coeff E := hB0 E
  rcases h0.lt_or_eq with h | h
  · right; rw [Int.ceil_eq_iff]; constructor <;> push_cast <;> linarith [hB1 E]
  · left; rw [← h]; simp

/-- Every divisor between `S` and `⌈S + B⌉` is a reduced snc divisor with coefficient one along
`S`. -/
private theorem isReducedSNC_of_le {k : Type} [Field k] (sX : X ⟶ Spec (.of k))
    (hB0 : 0 ≤ B) (hB1 : ∀ E, B.coeff E < 1) (hBS : B.coeff S = 0)
    (hΔ : DivisorWithCoeffs.IsSNC sX (Divisor.toQDivisor (Finsupp.single S 1) + B))
    {Δ' : Divisor X} (h1 : Finsupp.single S 1 ≤ Δ')
    (h2 : Δ' ≤ Finsupp.single S 1 + DivisorWithCoeffs.roundUp B) :
    IsReducedSNC sX Δ' ∧ Δ'.coeff S = 1 := by
  classical
  have hle : ∀ E, DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E ≤ Δ'.coeff E ∧
      Δ'.coeff E ≤ DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E +
        ⌈B.coeff E⌉ := by
    intro E
    refine ⟨h1 E, ?_⟩
    have := h2 E
    change Δ'.coeff E ≤ DivisorWithCoeffs.coeff
      (Finsupp.single S (1 : ℤ) + DivisorWithCoeffs.roundUp B : Divisor X) E at this
    rwa [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_roundUp] at this
  have hsingle : ∀ E, DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) E =
      if E = S then 1 else 0 := by
    intro E
    by_cases h : E = S
    · subst h; rw [if_pos rfl]; exact DivisorWithCoeffs.coeff_single_self _ _
    · rw [if_neg h]; exact DivisorWithCoeffs.coeff_single_of_ne (Ne.symm h) _
  have hS : Δ'.coeff S = 1 := by
    have := hle S
    rw [hsingle, if_pos rfl, hBS, Int.ceil_zero] at this
    omega
  refine ⟨⟨fun E => ?_, hΔ.of_support_subset fun E hE => ?_⟩, hS⟩
  · have := hle E
    have hc := coeff_roundUp_le_one B hB0 hB1 E
    rw [hsingle] at this
    split_ifs at this with h
    · subst h; right; exact hS
    · omega
  · rw [Finsupp.mem_support_iff] at hE ⊢
    change (Divisor.toQDivisor (Finsupp.single S 1) + B).coeff E ≠ 0
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have := hle E
    change Δ'.coeff E ≠ 0 at hE
    rw [hsingle] at this ⊢
    have hB : (0 : ℚ) ≤ B.coeff E := hB0 E
    split_ifs at this ⊢ with h
    · push_cast; linarith
    · push_cast
      intro h0
      have hBE : B.coeff E = 0 := by linarith
      rw [hBE, Int.ceil_zero] at this
      omega

private theorem dle_eq_smul_add (KX : Divisor X) (t : ℕ) :
    dle KX S B c t = (t : ℤ) • KX + ∑ s ∈ Finset.range t, bdry S B c (s + 1) := by
  simp [dle, Finset.sum_add_distrib]

/-- `0 ≤ ∑_{s ≤ t} Δ^s ≤ t⌈Δ⌉`. -/
private theorem sum_bdry_bounds (hB0 : 0 ≤ B) (t : ℕ) :
    0 ≤ ∑ s ∈ Finset.range t, bdry S B c (s + 1) ∧
      ∑ s ∈ Finset.range t, bdry S B c (s + 1) ≤
        (t : ℤ) • (Finsupp.single S 1 + DivisorWithCoeffs.roundUp B) := by
  have h0 : (0 : Divisor X) ≤ Finsupp.single S 1 := fun E => by
    classical
    change (0 : ℤ) ≤ (Finsupp.single S (1 : ℤ) : Divisor X) E
    rw [Finsupp.single_apply]; split_ifs <;> norm_num
  refine ⟨Finset.sum_nonneg fun s _ => h0.trans (single_le_bdry S B c hB0 _), ?_⟩
  calc ∑ s ∈ Finset.range t, bdry S B c (s + 1)
      ≤ ∑ s ∈ Finset.range t, (Finsupp.single S 1 + DivisorWithCoeffs.roundUp B) :=
        Finset.sum_le_sum fun s _ => bdry_le S B c hB0 _
    _ = (t : ℤ) • (Finsupp.single S 1 + DivisorWithCoeffs.roundUp B) := by
        rw [Finset.sum_const, Finset.card_range, natCast_zsmul]

private theorem zsmul_le_zsmul_of_le {D : Divisor X} (hD : 0 ≤ D) {a b : ℕ} (hab : a ≤ b) :
    (a : ℤ) • D ≤ (b : ℤ) • D := by
  intro E
  change ((a : ℤ) • D) E ≤ ((b : ℤ) • D) E
  simp only [Finsupp.smul_apply, smul_eq_mul]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast hab) (hD E)

private theorem support_subset_of_le {D₁ D₂ : Divisor X} (h0 : 0 ≤ D₁) (h : D₁ ≤ D₂) :
    D₁.support ⊆ D₂.support := by
  intro E hE
  rw [Finsupp.mem_support_iff] at hE ⊢
  have h1 := h0 E
  have h2 := h E
  change (0 : ℤ) ≤ D₁ E at h1
  intro h3
  rw [h3] at h2
  exact hE (le_antisymm h2 h1)

end Filtration

end

section RationalFunctions

variable {X : Scheme.{0}} [IsIntegral X]

private theorem germ_eq_rationalFunctionsEquivFunctionField_symm (U : X.Opens) (s : Γ(X, U))
    (h : genericPoint X ∈ U) (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ U) :
    (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s) Z =
      X.presheaf.germ U (componentGenericPoint X Z) hZ s := by
  have : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hd : Dense (U : Set X) := U.isOpen.dense ⟨_, h⟩
  let D : Stacks.Chow.DenseOpen X := ⟨U, hd⟩
  have key : (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s)
      = (Stacks.Chow.rationalFunctionsEquivStalks X).1 (Stacks.Chow.ofSection X D s) := by
    rw [RingEquiv.symm_apply_eq, ← (Stacks.Chow.rationalFunctionsEquivFunctionField X).2 D s h]
    change _ = (Stacks.Chow.rationalFunctionsEquivFunctionField X).1
      ((Stacks.Chow.rationalFunctionsEquivStalks X).1.symm _)
    rw [RingEquiv.symm_apply_apply]
  rw [key]
  exact (Stacks.Chow.rationalFunctionsEquivStalks X).2 D s Z hZ

variable [IsLocallyNoetherian X] [IsNormal X]

end RationalFunctions

section Principal

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [CompactSpace X] [IsNormal X]

omit [CompactSpace X] in
/-- Along a prime divisor of a normal integral scheme there is a rational function of order
one. -/
private theorem exists_ord_eq_one [IsIntegral X] (P : MMP.Mori.PrimeDivisor X) :
    ∃ f : X.functionField, f ≠ 0 ∧ X.ord f P.genericPoint = 1 := by
  have := P.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible P.localRing
  have hne : algebraMap P.localRing X.functionField ϖ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hϖ.ne_zero
  refine ⟨_, hne, ?_⟩
  rw [Scheme.ord_eq_iff P.coheight_genericPoint hne]
  exact Ring.ordFrac_irreducible (R := X.presheaf.stalk P.genericPoint) hϖ

/-- **Moving a divisor off a prime divisor.** Every divisor is linearly equivalent to one of
which a given prime divisor is not a component. -/
private theorem exists_coeff_add_principalDivisor_eq_zero [IsIntegral X] (M : Divisor X)
    (S : MMP.Mori.PrimeDivisor X) :
    ∃ φ : (RationalFunctions X)ˣ, (M + principalDivisor φ).coeff S = 0 := by
  obtain ⟨z, hz0, hz⟩ := exists_ord_eq_one S
  have hg : z ^ (-M.coeff S) ≠ 0 := zpow_ne_zero _ hz0
  refine ⟨Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 _ hg), ?_⟩
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0, MMP.Mori.ord_zpow _ hz0, hz]
  ring

/-- The divisor of a power of a unit. -/
private theorem principalDivisor_pow (u : (RationalFunctions X)ˣ) (j : ℕ) :
    principalDivisor (u ^ j) = (j : ℤ) • principalDivisor u := by
  induction j with
  | zero => simp [MMP.Mori.principalDivisor_one]
  | succ j ih =>
    rw [pow_succ, MMP.Mori.principalDivisor_mul, ih]
    push_cast; rw [add_smul, one_smul]

end Principal

private theorem preimage_eq_bot_iff {X Y : Scheme.{0}} (μ : Y ⟶ X) [IsDominant μ] (U : X.Opens) :
    μ ⁻¹ᵁ U = ⊥ ↔ U = ⊥ := by
  refine ⟨fun h => by_contra fun hU => ?_, fun h => by simp [h]⟩
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).1 hU
  obtain ⟨_, hx', ⟨x', rfl⟩⟩ := μ.denseRange.inter_open_nonempty U U.isOpen ⟨x, hx⟩
  have hmem : x' ∈ μ ⁻¹ᵁ U := hx'
  rw [h] at hmem
  exact hmem

section Local

variable {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W]

/-- Sections of `𝒪_W(G)` restrict to smaller nonempty opens. -/
private theorem mem_mis_of_le {G : Divisor W} {U V : W.Opens} (hVU : V ≤ U) (hV : V ≠ ⊥)
    {g : W.functionField} (hg : g ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) G U) :
    g ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) G V :=
  ⟨fun h => absurd ((preimage_eq_bot_iff (𝟙 W) V).1 h) hV,
    fun P hP => hg.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hVU hy))⟩

/-- The product of sections of `𝒪_W(G₁)` and `𝒪_W(G₂)` is a section of `𝒪_W(G₁ + G₂)`. -/
private theorem mul_mem_mis {G₁ G₂ : Divisor W} {V : W.Opens} {a b : W.functionField}
    (ha : a ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) G₁ V)
    (hb : b ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) G₂ V) :
    a * b ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) (G₁ + G₂) V :=
  ⟨fun h => by rw [ha.1 h, zero_mul], fun P hP => by
    rw [map_mul, DivisorWithCoeffs.coeff_add, WithZero.exp_add]
    exact mul_le_mul' (ha.2 P hP) (hb.2 P hP)⟩

/-- The span of the products `𝒪_W(G)(U) · J(U)` restricts to smaller nonempty opens. -/
private theorem span_mis_mul_le {G : Divisor W} {J : W.Opens → Set W.functionField}
    (hJres : ∀ U V : W.Opens, V ≤ U → V ≠ ⊥ → J U ⊆ J V) {U V : W.Opens} (hVU : V ≤ U)
    (hV : V ≠ ⊥) :
    Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) G U * J U) ≤
      Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * J V) :=
  Submodule.span_mono (Set.mul_subset_mul (fun _ hg => mem_mis_of_le hVU hV hg) (hJres U V hVU hV))

/-- Multiplying by a regular function preserves the span of `𝒪_W(G)(V) · J(V)`. -/
private theorem mul_mem_span_mis {G : Divisor W} {J : Set W.functionField} {V : W.Opens}
    {o : W.functionField} (ho : o ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) 0 V)
    {w : W.functionField}
    (hw : w ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * J)) :
    o * w ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * J) := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨a, ha, j, hj, rfl⟩ := hw
    refine Submodule.subset_span ⟨o * a, ?_, j, hj, by ring⟩
    simpa using mul_mem_mis ho ha
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact add_mem ha hb
  | smul n a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ n ha

/-- **A local generator of a Cartier divisor.** Near every point a Cartier divisor `G` has a
nonzero rational function `e` with `v_P(e) = exp(coeff_P G)` along every prime divisor meeting
the neighbourhood: a generator of `𝒪_W(G)` there. -/
private theorem exists_localGenerator [CompactSpace W] {G : Divisor W} (hG : G.IsCartier)
    (x : W) :
    ∃ V : W.Opens, x ∈ V ∧ ∃ e : W.functionField, e ≠ 0 ∧
      ∀ P : MMP.Mori.PrimeDivisor W, (P.support ∩ V).Nonempty →
        P.divisorialValuation e = WithZero.exp (G.coeff P) := by
  obtain ⟨V, hxV, φ, hφ⟩ := hG x
  set ψ := rationalFunctionsEquivFunctionField W φ with hψ
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
  refine ⟨V, hxV, ψ⁻¹, inv_ne_zero hψ0, fun P hP => ?_⟩
  rw [map_inv₀, P.divisorialValuation_eq_exp_neg_ord hψ0, hφ P hP,
    MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, ← WithZero.exp_neg, neg_neg]

/-- **Global generation turns an inclusion of sections into an inclusion of ideals.** Let `I`,
`J` be ideals of `W` given by their sections, `J` an ideal sheaf on the affine opens, both local,
and `G` a Cartier divisor. If every local section of `I(G)` is generated near each point by
global sections of `I(G)`, and every global section of `I(G)` is a section of `J(G)`, then
`I ⊆ J`. -/
private theorem subset_of_forall_globalSections [CompactSpace W] {G : Divisor W}
    (hG : G.IsCartier) {I J : W.Opens → Set W.functionField}
    (hIres : ∀ U V : W.Opens, V ≤ U → V ≠ ⊥ → I U ⊆ I V) (hIbot : ∀ g ∈ I ⊥, g = 0)
    (hJres : ∀ U V : W.Opens, V ≤ U → V ≠ ⊥ → J U ⊆ J V) (hJbot : (0 : W.functionField) ∈ J ⊥)
    (hJglue : ∀ (U : W.Opens) (g : W.functionField), U ≠ ⊥ →
      (∀ x ∈ U, ∃ V : W.Opens, x ∈ V ∧ V ≤ U ∧ g ∈ J V) → g ∈ J U)
    (I' : W.IdealSheafData)
    (hJI' : ∀ (U : W.affineOpens) [Nonempty (U : W.Opens)],
      J U = W.germToFunctionField (U : W.Opens) '' (I'.ideal U : Set Γ(W, U)))
    (hgen : ∀ (x : W) (U : W.Opens), x ∈ U →
      ∀ h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) G U * I U),
        ∃ U' : W.Opens, x ∈ U' ∧ U' ≤ U ∧
          h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) 0 U' *
            {h | ∀ x : W, ∃ V : W.Opens, x ∈ V ∧ h ∈ Submodule.span ℤ
              (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * I V)}))
    (hΓ : ∀ γ : W.functionField, (∀ x : W, ∃ V : W.Opens, x ∈ V ∧ γ ∈ Submodule.span ℤ
        (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * I V)) →
      ∀ x : W, ∃ V : W.Opens, x ∈ V ∧ γ ∈ Submodule.span ℤ
        (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * J V)) :
    ∀ U, I U ⊆ J U := by
  intro U j hj
  by_cases hU : U = ⊥
  · subst hU; rw [hIbot j hj]; exact hJbot
  refine hJglue U j hU fun x hx => ?_
  obtain ⟨V₀, hxV₀, e, he0, he⟩ := exists_localGenerator hG x
  have hxW₁ : x ∈ V₀ ⊓ U := ⟨hxV₀, hx⟩
  have hW₁ : V₀ ⊓ U ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxW₁⟩
  have heW₁ : e ∈ MMP.Intersection.multiplierIdealSections (𝟙 W) G (V₀ ⊓ U) :=
    ⟨fun h => absurd ((preimage_eq_bot_iff (𝟙 W) _).1 h) hW₁, fun P hP => by
      rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply]
      exact (he P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hy.1))).le⟩
  have hh : e * j ∈ Submodule.span ℤ
      (MMP.Intersection.multiplierIdealSections (𝟙 W) G (V₀ ⊓ U) * I (V₀ ⊓ U)) :=
    Submodule.subset_span ⟨e, heW₁, j, hIres U _ inf_le_right hW₁ hj, rfl⟩
  obtain ⟨U', hxU', hU'W₁, hU'⟩ := hgen x _ hxW₁ _ hh
  -- every element of the span is near `x` a section of `J(G)`
  have claim : ∀ w ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 W) 0 U' *
      {h | ∀ x : W, ∃ V : W.Opens, x ∈ V ∧ h ∈ Submodule.span ℤ
        (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * I V)}),
      ∃ V : W.Opens, x ∈ V ∧ V ≤ U' ∧ w ∈ Submodule.span ℤ
        (MMP.Intersection.multiplierIdealSections (𝟙 W) G V * J V) := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨o, ho, γ, hγ, rfl⟩ := hw
      obtain ⟨V₁, hxV₁, hV₁⟩ := hΓ γ hγ x
      have hV : V₁ ⊓ U' ≠ ⊥ :=
        (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxV₁, hxU'⟩
      refine ⟨V₁ ⊓ U', ⟨hxV₁, hxU'⟩, inf_le_right, mul_mem_span_mis
        (mem_mis_of_le inf_le_right hV ho) (span_mis_mul_le hJres inf_le_left hV hV₁)⟩
    | zero => exact ⟨U', hxU', le_rfl, zero_mem _⟩
    | add a b _ _ ha hb =>
      obtain ⟨Va, hxa, hVa, ha⟩ := ha
      obtain ⟨Vb, hxb, hVb, hb⟩ := hb
      have hV : Va ⊓ Vb ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxa, hxb⟩
      exact ⟨Va ⊓ Vb, ⟨hxa, hxb⟩, inf_le_left.trans hVa,
        add_mem (span_mis_mul_le hJres inf_le_left hV ha)
          (span_mis_mul_le hJres inf_le_right hV hb)⟩
    | smul n a _ ha =>
      obtain ⟨V, hxV, hVU, ha⟩ := ha
      exact ⟨V, hxV, hVU, Submodule.smul_mem _ n ha⟩
  obtain ⟨V, hxV, hVU', hV⟩ := claim _ hU'
  obtain ⟨V', hV'aff, hxV', hV'V⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens W)) hxV
  have hV'0 : V' ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxV'⟩
  have hV'1 := span_mis_mul_le hJres hV'V hV'0 hV
  have hV'V₀ : V' ≤ V₀ := hV'V.trans (hVU'.trans (hU'W₁.trans inf_le_left))
  haveI : Nonempty (V' : W.Opens) := ⟨⟨x, hxV'⟩⟩
  have hJV' := hJI' ⟨V', hV'aff⟩
  -- dividing by the local generator
  have key : ∀ w ∈ Submodule.span ℤ
      (MMP.Intersection.multiplierIdealSections (𝟙 W) G V' * J V'), e⁻¹ * w ∈ J V' := by
    intro w hw
    rw [hJV']
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨a, ha, j', hj', rfl⟩ := hw
      rw [hJV'] at hj'
      obtain ⟨s', hs', rfl⟩ := hj'
      by_cases ha0 : a = 0
      · exact ⟨0, zero_mem _, by simp [ha0]⟩
      have hreg : ∃ r : Γ(W, V'), W.germToFunctionField V' r = e⁻¹ * a := by
        refine (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord V'
          (mul_ne_zero (inv_ne_zero he0) ha0)).mpr fun P hP => ?_
        have h1 := ha.2 P (by simpa using hP)
        rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
          P.divisorialValuation_eq_exp_neg_ord ha0, WithZero.exp_le_exp] at h1
        have h2 := he P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hV'V₀ hy))
        rw [P.divisorialValuation_eq_exp_neg_ord he0] at h2
        have h3 := WithZero.exp_injective h2
        rw [Scheme.ord_mul (inv_ne_zero he0) ha0, ← zpow_neg_one, MMP.Mori.ord_zpow _ he0]
        omega
      obtain ⟨r, hr⟩ := hreg
      refine ⟨r * s', Ideal.mul_mem_left _ r hs', ?_⟩
      simp only [map_mul, Scheme.Hom.comp_apply] at hr ⊢
      rw [hr]; ring
    | zero => exact ⟨0, zero_mem _, by simp⟩
    | add a b _ _ ha hb =>
      obtain ⟨sa, hsa, ea⟩ := ha
      obtain ⟨sb, hsb, eb⟩ := hb
      exact ⟨sa + sb, add_mem hsa hsb, by rw [map_add, ea, eb, mul_add]⟩
    | smul n a _ ha =>
      obtain ⟨sa, hsa, ea⟩ := ha
      exact ⟨n • sa, Submodule.smul_of_tower_mem _ n hsa, by rw [map_zsmul, ea, mul_smul_comm]⟩
  have := key _ hV'1
  rw [← mul_assoc, inv_mul_cancel₀ he0, one_mul] at this
  exact ⟨V', hxV', hV'V.trans (hVU'.trans (hU'W₁.trans inf_le_right)), this⟩

end Local

section Asymptotic

variable {k : Type} [Field k] {X Z : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Z} {Δ D : Divisor X}
  {V : ℕ → AddSubgroup X.functionField} {b : ℕ} {c : ℚ} {J : X.Opens → Set X.functionField}

/-- Sections of an asymptotic adjoint ideal restrict to smaller nonempty opens. -/
private theorem asy_res (h : IsAsymptoticAdjointIdeal sX f Δ D V b c J) :
    ∀ U W : X.Opens, W ≤ U → W ≠ ⊥ → J U ⊆ J W := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, Jp, hJp, hJ⟩ := h
  intro U W hWU hW g hg
  rw [hJ] at hg ⊢
  refine ⟨fun h => absurd h hW, fun x hx => ?_⟩
  obtain ⟨W', hxW', hW'U, p, hp, hbp, hg'⟩ := hg.2 x (hWU hx)
  obtain ⟨Y, μ, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hJpeq⟩ :=
    hJp p hp hbp
  refine ⟨W' ⊓ W, ⟨hxW', hx⟩, inf_le_right, p, hp, hbp, ?_⟩
  rw [hJpeq] at hg' ⊢
  have hne : W' ⊓ W ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hxW', hx⟩
  exact ⟨fun h => absurd ((preimage_eq_bot_iff μ _).1 h) hne,
    fun P hP => hg'.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hy.1))⟩

/-- The sections of an asymptotic adjoint ideal over the empty open are `0`. -/
private theorem asy_bot (h : IsAsymptoticAdjointIdeal sX f Δ D V b c J) :
    ∀ g ∈ J ⊥, g = 0 := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, Jp, -, hJ⟩ := h
  intro g hg
  exact ((hJ ⊥ g).1 hg).1 rfl

private theorem asy_zero_bot (h : IsAsymptoticAdjointIdeal sX f Δ D V b c J) :
    (0 : X.functionField) ∈ J ⊥ := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, Jp, -, hJ⟩ := h
  exact (hJ ⊥ 0).2 ⟨fun _ => rfl, fun x hx => absurd hx (by simp)⟩

/-- Membership in an asymptotic adjoint ideal is local. -/
private theorem asy_glue (h : IsAsymptoticAdjointIdeal sX f Δ D V b c J) :
    ∀ (U : X.Opens) (g : X.functionField), U ≠ ⊥ →
      (∀ x ∈ U, ∃ W : X.Opens, x ∈ W ∧ W ≤ U ∧ g ∈ J W) → g ∈ J U := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, Jp, -, hJ⟩ := h
  intro U g hU hg
  refine (hJ U g).2 ⟨fun h => absurd h hU, fun x hx => ?_⟩
  obtain ⟨W, hxW, hWU, hgW⟩ := hg x hx
  obtain ⟨W', hxW', hW'W, p, hp, hbp, h'⟩ := ((hJ W g).1 hgW).2 x hxW
  exact ⟨W', hxW', hW'W.trans hWU, p, hp, hbp, h'⟩

end Asymptotic

/-! ### Relative ampleness of Cartier divisors -/

section AmpleTools

open RingedSpaceModuleAdjunction Stacks.Ample Stacks.RelativeVeryAmple

/-- The ringed-space pull-back of a module along a morphism of schemes is the scheme pull-back. -/
private noncomputable def modulePullbackIso {X Y : Scheme.{0}} (f : X ⟶ Y) (F : Y.Modules) :
    (modulePullback f.toLRSHom.toShHom).obj F ≅ (Scheme.Modules.pullback f).obj F :=
  (Adjunction.leftAdjointUniq (modulePullbackPushforwardAdjunction f.toLRSHom.toShHom)
    (Scheme.Modules.pullbackPushforwardAdjunction f)).app F

/-- For a quasi-compact morphism, `f`-ampleness gives ampleness over every affine open. -/
private theorem stacks_of_isRelativelyAmple {X S : Scheme.{0}} (f : X ⟶ S) [QuasiCompact f]
    (L : X.Modules) [IsInvertibleModule X L] (hL : MMP.Mori.IsRelativelyAmple f L) :
    Stacks.RelativeAmple.IsRelativelyAmple f L :=
  Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple f L inferInstance hL

/-- `𝒪_Y(mA) ≅ 𝒪_Y(A)^{⊗ m}` for a Cartier divisor `A`. -/
private noncomputable def divisorialSheafNsmulIso {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] {A : Divisor V} (hA : A.IsCartier) (m : ℕ) :
    haveI := hA.isInvertibleModule_divisorialSheaf
    (m • A).divisorialSheaf ≅ Stacks.Ample.tensorPowModule V A.divisorialSheaf (m : ℤ) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  induction m with
  | zero =>
    exact eqToIso (by rw [zero_smul]) ≪≫ Divisor.divisorialSheafZeroIso ≪≫
      (Stacks.Ample.tensorPowModuleZeroIso V A.divisorialSheaf).symm
  | succ n ih =>
    exact eqToIso (by rw [succ_nsmul]) ≪≫
      ((hA.nsmul n).divisorialSheafTensorIso hA).symm ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso ih).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso V A.divisorialSheaf).symm ≪≫
      Stacks.Ample.tensorPowModuleAddIso V A.divisorialSheaf (n : ℤ) 1 ≪≫
      eqToIso (by push_cast; rfl)

/-- **[Stacks, Tag 0C4K] for Cartier divisors.** Let `f : X ⟶ Y` and `g : Y ⟶ S` be
quasi-compact, `S` quasi-compact, `L` an `f`-ample Cartier divisor on `X` and `M` a `g`-ample
Cartier divisor on `Y` with pull-back `M' = f^*M`. Then `L + nM'` is `(f ≫ g)`-ample for all
large `n`. -/
private theorem exists_isRelativelyAmple_add_nsmul {X Y S : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace S]
    (f : X ⟶ Y) (g : Y ⟶ S) [QuasiCompact f] [QuasiCompact g]
    {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    {M : Divisor Y} (hM : M.IsCartier) (hMg : M.IsRelativelyAmple g hM)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ M.supp}
    {M' : Divisor X} (hM' : M.IsPullback f hB M') :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      (L + n • M').IsRelativelyAmple (f ≫ g) (hL.add ((hM'.isCartier hM).nsmul n)) := by
  have hM'c := hM'.isCartier hM
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := hM.isInvertibleModule_divisorialSheaf
  haveI := hM'c.isInvertibleModule_divisorialSheaf
  obtain ⟨n₀, hn₀⟩ := Stacks.AmplePullbackDatum.exists_threshold_isRelativelyAmple_comp f g _ _
    (stacks_of_isRelativelyAmple f _ hLf) (stacks_of_isRelativelyAmple g _ hMg)
  refine ⟨n₀, fun n hn => ?_⟩
  haveI := (hL.add (hM'c.nsmul n)).isInvertibleModule_divisorialSheaf
  have eB : (modulePullback f.toLRSHom.toShHom).obj M.divisorialSheaf ≅ M'.divisorialSheaf :=
    modulePullbackIso f _ ≪≫ (hM'.divisorialSheafIso (hBc := hM)).symm
  have e : Stacks.AmplePullbackPart1.tensorPullbackPowModule f L.divisorialSheaf
      M.divisorialSheaf n ≅ (L + n • M').divisorialSheaf :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
        (Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso f _ n ≪≫
          Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso X _ _ eB n ≪≫
          (divisorialSheafNsmulIso hM'c n).symm) ≪≫
      hL.divisorialSheafTensorIso (hM'c.nsmul n)
  exact MMP.Mori.IsRelativelyAmple.of_stacks _ _
    ((Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _ e).mp (hn₀ n hn))

end AmpleTools

/-! ### Serre's theorem for relatively ample Cartier divisors -/

section SerreTwist

open Stacks.Ample Stacks.RelativeVeryAmple MMP.Flips

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{0}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{0}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{0}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{0, 0, 0} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

/-- The pull-back of `𝒪_Y(nH + F)` along `f : X ⟶ Y` is `f^*𝒪_Y(F) ⊗ (f^*𝒪_Y(H))^{⊗ n}`, for
Cartier divisors `H` and `F`. -/
private theorem nonempty_modulePullback_divisorialSheaf_nsmul_add_iso {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (f : X ⟶ Y) {H F : Divisor Y}
    (hH : H.IsCartier) (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
        (n • H + F).divisorialSheaf ≅
      tensorModules X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          F.divisorialSheaf)
        (tensorPowModule X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          H.divisorialSheaf) (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  set P := RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      P.mapIso (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      pullbackTensorModulesIso f _ _ ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- If `H` is an `g`-ample Cartier divisor and `F` is any Cartier divisor, then `mH + F` is
`g`-ample for `m ≫ 0`, provided the base is quasi-compact. -/
private theorem eventually_isRelativelyAmpleCartier_nsmul_add {Y Z : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [CompactSpace Z] (g : Y ⟶ Z)
    [QuasiCompact g] {H F : Divisor Y} (hH : IsRelativelyAmpleCartier g H) (hF : F.IsCartier) :
    ∀ᶠ m : ℕ in Filter.atTop, IsRelativelyAmpleCartier g (m • H + F) := by
  obtain ⟨hHc, hHa⟩ := hH
  haveI := hHc.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  choose V' hVa hzV _ using fun z : Z =>
    exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun z : Z ↦ ((V' z : Z.Opens) : Set Z))
    (fun z ↦ (V' z).isOpen) (fun z _ ↦ Set.mem_iUnion.2 ⟨z, hzV z⟩)
  have hev : ∀ v ∈ T, ∀ᶠ m : ℕ in Filter.atTop,
      haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
      IsAmple (g ⁻¹ᵁ V' v).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback
          (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom).obj (m • H + F).divisorialSheaf) := by
    intro v _
    let W := (g ⁻¹ᵁ V' v).toScheme
    let P := RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom
    haveI hPF : IsInvertibleModule W (P.obj F.divisorialSheaf) := inferInstance
    haveI hPH : IsInvertibleModule W (P.obj H.divisorialSheaf) := inferInstance
    filter_upwards [eventually_isAmple_tensorModules_tensorPowModule (P.obj H.divisorialSheaf)
      (P.obj F.divisorialSheaf) (hHa _ (hVa v))]
      with m hm
    haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := nonempty_modulePullback_divisorialSheaf_nsmul_add_iso (g ⁻¹ᵁ V' v).ι hHc hF m
    exact (@isAmple_congr _ _ _ inferInstance
      (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
        (isInvertibleModule_tensorPowModule _ _ _)) e).2 hm
  filter_upwards [(Filter.eventually_all_finset T).2 hev] with m hm
  have hc := (hHc.nsmul m).add hF
  haveI := hc.isInvertibleModule_divisorialSheaf
  refine ⟨hc, ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover
    g _ inferInstance).2 fun z => ?_).2⟩
  obtain ⟨v, hvT, hzv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ z))
  exact ⟨V' v, hVa v, hzv, hm v hvT⟩

end SerreTwist

/-! ### Bridges between the notions of relative ampleness -/

section AmpleBridges

open Stacks.Ample

/-- `f`-ampleness of a Cartier divisor gives ampleness over every affine open of the base. -/
private theorem isRelativelyAmpleCartier_of_isRelativelyAmple {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) [QuasiCompact f]
    {L : Divisor X} (hL : L.IsCartier) (h : L.IsRelativelyAmple f hL) :
    MMP.Flips.IsRelativelyAmpleCartier f L := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  exact ⟨hL, (stacks_of_isRelativelyAmple f _ h).2⟩

/-- Ampleness over every affine open of the base gives `f`-ampleness. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) {L : Divisor X}
    (h : MMP.Flips.IsRelativelyAmpleCartier f L) : L.IsRelativelyAmple f h.choose := by
  obtain ⟨hL, hamp⟩ := h
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- An ample Cartier divisor on `X` is ample relative to `g : X ⟶ Z'` for affine `Z'`. -/
private theorem isRelativelyAmple_of_isAmple_of_isAffine {X Z' : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (g : X ⟶ Z') [IsAffine Z']
    {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple g hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro z
  refine ⟨⊤, isAffineOpen_top Z', trivial, ?_⟩
  haveI : IsIso (g ⁻¹ᵁ ⊤).ι := by
    rw [Scheme.Hom.preimage_top]
    exact (Scheme.topIso X).isIso_hom
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffineHom (g ⁻¹ᵁ ⊤).ι
    A.divisorialSheaf hamp

/-- An ample Cartier divisor on `X` is ample relative to the identity of `X`. -/
private theorem isRelativelyAmple_id_of_isAmple {X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple (𝟙 X) hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro x
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  refine ⟨V, hV, hxV, ?_⟩
  haveI : IsAffine ((𝟙 X) ⁻¹ᵁ V).toScheme := by
    rw [Scheme.Hom.id_preimage]; exact hV
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffine ((𝟙 X) ⁻¹ᵁ V).ι
    A.divisorialSheaf hamp

end AmpleBridges

section AmpleSum

open RingedSpaceModuleAdjunction Stacks.Ample Stacks.RelativeVeryAmple

/-- If `φ = (a, b) : W ⟶ X ×_S Y` is affine, `L` is `f`-ample and `N` is `g`-ample, then
`a^* L ⊗ b^* N` is ample relative to `a ≫ f`. -/
private theorem isRelativelyAmple_tensorModules_of_isAffineHom {S X Y W : Scheme.{0}}
    {f : X ⟶ S} {g : Y ⟶ S} {a : W ⟶ X} {b : W ⟶ Y} (h : a ≫ f = b ≫ g)
    [IsAffineHom (Limits.pullback.lift a b h)] (L : X.Modules) (N : Y.Modules)
    [IsInvertibleModule X L] [IsInvertibleModule Y N]
    (hL : Stacks.RelativeAmple.IsRelativelyAmple f L)
    (hN : Stacks.RelativeAmple.IsRelativelyAmple g N) :
    Stacks.RelativeAmple.IsRelativelyAmple (a ≫ f)
      (tensorModules W ((modulePullback a.toLRSHom.toShHom).obj L)
        ((modulePullback b.toLRSHom.toShHom).obj N)) := by
  have h1 := Stacks.AmpleFibreNeighbourhood.isRelativelyAmple_pullbackModule_of_isAffineHom
    (Limits.pullback.lift a b h) (Limits.pullback.fst f g ≫ f) _
    (Stacks.AmpleExternalTensor.isRelativelyAmple_externalTensor f g L N hL hN)
  have e := Stacks.AmpleExternalTensor.pullbackExternalTensorIso f g
    (Limits.pullback.lift a b h) L N
  simp only [Limits.pullback.lift_fst, Limits.pullback.lift_snd] at e
  rw [← Category.assoc, Limits.pullback.lift_fst] at h1
  exact (isRelativelyAmple_congr _ _ _ e).mp h1

/-- For a quasi-compact separated morphism `f`, the sum of two `f`-ample Cartier divisors is
`f`-ample: `𝒪(A + B) ≅ Δ^*(𝒪(A) ⊠ 𝒪(B))` and the diagonal of `f` is affine. -/
private theorem isRelativelyAmple_add {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {A B : Divisor X} (hA : A.IsCartier) (hAf : A.IsRelativelyAmple f hA)
    (hB : B.IsCartier) (hBf : B.IsRelativelyAmple f hB) :
    (A + B).IsRelativelyAmple f (hA.add hB) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  haveI := hB.isInvertibleModule_divisorialSheaf
  haveI := (hA.add hB).isInvertibleModule_divisorialSheaf
  haveI : IsAffineHom (Limits.pullback.lift (𝟙 X) (𝟙 X) (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f)) :=
    show IsAffineHom (Limits.pullback.diagonal f) from inferInstance
  have h := isRelativelyAmple_tensorModules_of_isAffineHom (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f) _ _
    (stacks_of_isRelativelyAmple f _ hAf) (stacks_of_isRelativelyAmple f _ hBf)
  rw [Category.id_comp] at h
  refine MMP.Mori.IsRelativelyAmple.of_stacks _ _ ((isRelativelyAmple_congr _ _ _ ?_).mp h)
  exact tensorModulesMapIso X (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _)
    (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _) ≪≫
    hA.divisorialSheafTensorIso hB

/-- For a quasi-compact separated morphism `f`, every positive multiple of an `f`-ample Cartier
divisor is `f`-ample. -/
private theorem isRelativelyAmple_nsmul {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    (n : ℕ) (hn : 0 < n) : (n • L).IsRelativelyAmple f (hL.nsmul n) := by
  induction n with
  | zero => exact absurd hn (lt_irrefl 0)
  | succ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn'
    · simpa using hLf
    · convert isRelativelyAmple_add _ (ih hn') _ hLf using 2
      rw [succ_nsmul]

/-- Relative ampleness of a Cartier divisor does not depend on the proof that it is Cartier, and
is transported along equalities of divisors. -/
private theorem isRelativelyAmple_of_eq {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} {A B : Divisor X}
    (hAB : A = B) (hA : A.IsCartier) (hB : B.IsCartier) (hAf : A.IsRelativelyAmple f hA) :
    B.IsRelativelyAmple f hB := by
  subst hAB; exact hAf

end AmpleSum

section Valuations

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- A rational function with nonnegative order along every prime divisor through the centre of a
divisor `G` over `X` has `v_G ≤ 1`. -/
private theorem valuation_le_one_of_forall_ord_nonneg (G : DivisorOver k sX)
    {u : X.functionField}
    (h : ∀ Γ : MMP.Mori.PrimeDivisor X, G.f G.E.genericPoint ∈ Γ.support →
      0 ≤ X.ord u Γ.genericPoint) : G.valuation u ≤ 1 := by
  rcases eq_or_ne u 0 with rfl | hu
  · simp
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg _ hu h
  rw [← hr]
  exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one G _ rfl r

/-- A nonzero rational function of order zero along every prime divisor through the centre of a
divisor `G` over `X` has `v_G = 1`. -/
private theorem valuation_eq_one_of_forall_ord_eq_zero (G : DivisorOver k sX)
    {u : X.functionField} (hu : u ≠ 0)
    (h : ∀ Γ : MMP.Mori.PrimeDivisor X, G.f G.E.genericPoint ∈ Γ.support →
      X.ord u Γ.genericPoint = 0) : G.valuation u = 1 := by
  apply le_antisymm (valuation_le_one_of_forall_ord_nonneg G fun Γ hΓ => (h Γ hΓ).ge)
  have h2 := valuation_le_one_of_forall_ord_nonneg G (u := u ^ (-1 : ℤ)) fun Γ hΓ => by
    rw [MMP.Mori.ord_zpow _ hu, h Γ hΓ]; simp
  rw [map_zpow₀, zpow_neg_one] at h2
  have hpos : 0 < G.valuation u := by
    rw [zero_lt_iff]; exact (map_ne_zero _).mpr hu
  exact (inv_le_one₀ hpos).mp h2

/-- The order of a local equation `φ` of `D` on `U` along a prime divisor meeting `U` is the
coefficient of `D`. -/
private theorem ord_evalFF_of_isLocalEquation {D : Divisor X} {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (Z : irreducibleComponents X) (Γ : MMP.Mori.PrimeDivisor X) (hΓ : (Γ.support ∩ U).Nonempty) :
    X.ord (MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X))
      Γ.genericPoint = D.coeff Γ := by
  rw [hφ Γ hΓ, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord,
    show Γ.component = Z from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]

private theorem evalFF_ne_zero (Z : irreducibleComponents X)
    (φ : (MMP.Mori.RationalFunctions X)ˣ) :
    MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X) ≠ 0 :=
  (φ.isUnit.map _).ne_zero

/-- A section `g` of `𝒪_X(D)` has `ord_Γ(g) + coeff_Γ(D) ≥ 0`. -/
private theorem ord_add_coeff_nonneg {D : Divisor X} {g : X.functionField}
    (hg : g ∈ sectionsIn D) (hg0 : g ≠ 0) (Γ : MMP.Mori.PrimeDivisor X) :
    0 ≤ X.ord g Γ.genericPoint + D.coeff Γ := by
  have h := hg Γ
  rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h
  omega

/-- A section `g` of `𝒪_X(D)` times a local equation of `D` near the centre of `G` has
`v_G ≤ 1`. -/
private theorem valuation_mul_evalFF_le_one (G : DivisorOver k sX) {D : Divisor X}
    {g : X.functionField} (hg : g ∈ sectionsIn D) {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (hx : G.f G.E.genericPoint ∈ U) (Z : irreducibleComponents X) :
    G.valuation (g * MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)) ≤
      1 := by
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  refine valuation_le_one_of_forall_ord_nonneg G fun Γ hΓ => ?_
  rw [Scheme.ord_mul hg0 (evalFF_ne_zero Z φ),
    ord_evalFF_of_isLocalEquation hφ Z Γ ⟨_, hΓ, hx⟩]
  exact ord_add_coeff_nonneg hg hg0 Γ

/-- An integer `w` with `exp (-w) ≤ v_G(g' φ)` for every local equation `φ` of `D` near the centre
of `G`, where `g'` is a section of `𝒪_X(D)`, is nonnegative. -/
private theorem nonneg_of_forall_exp_neg_le (G : DivisorOver k sX) {D : Divisor X}
    (hDc : D.IsCartier) {g' : X.functionField} (hg' : g' ∈ sectionsIn D) {w : ℤ}
    (hw : ∀ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      D.IsLocalEquation U φ → G.f G.E.genericPoint ∈ U →
      WithZero.exp (-w) ≤ G.valuation (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X))) :
    0 ≤ w := by
  obtain ⟨U, hxU, φ, hφ⟩ := hDc (G.f G.E.genericPoint)
  have h1 := (hw U φ (MMP.Mori.pointComponent (genericPoint X)) hφ hxU).trans
    (valuation_mul_evalFF_le_one G hg' hφ hxU _)
  rw [← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  omega

/-- Along a prime divisor `P` of `Y` centred in `U`, a local equation of `D` on `U` has
`v_P(μ^*φ) = exp (-coeff_P(μ^*D))`. -/
private theorem valuationOver_evalFF_eq {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {μ : Y ⟶ X} [IsDominant μ] {D : Divisor X}
    {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp}
    {Dμ : Divisor Y} (h : D.IsPullback μ hD Dμ) {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (P : MMP.Mori.PrimeDivisor Y) (hP : μ P.genericPoint ∈ U) (Z : irreducibleComponents X) :
    P.valuationOver μ (MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)) =
      WithZero.exp (-Dμ.coeff P) := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
    P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr (evalFF_ne_zero Z φ)),
    MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hP Z]

end Valuations

section Toolkit

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- Adding `c • C` to the boundary, for a Cartier divisor `C` with pull-back `C'` along the model,
lowers a log discrepancy by `c` times the coefficient of `C'` along the divisor. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {C : Divisor X}
    (hC : C.IsCartier) (c : ℝ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + c • Divisor.toRDivisor C) F
        (a - c * (C'.coeff F.E : ℝ)) := by
  classical
  intro C' hCs hC'
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₁, C₁', hC₁, hrel, hpb, ha⟩ := h
  refine ⟨hnv, hprop, ω, hω0, hK, m + 1, Fin.snoc r c, Fin.snoc C₁ C, Fin.snoc C₁' C', ?_, ?_,
    ?_, ?_⟩
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using hC
    · simpa using hC₁ j
  · intro Γ
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, DivisorWithCoeffs.coeff_add, ← hrel Γ,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    ring
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · refine ⟨by simpa using hCs, ?_⟩
      simpa using hC'
    · simpa using hpb j
  · rw [Fin.sum_univ_castSucc, ha]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    ring

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- Log discrepancies exist on a smooth variety, at the index `n = dim X`. -/
private theorem exists_isLogDiscrepancy [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (F : DivisorOver k sX) (hF : IsProper F.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) F a := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK F
  exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hF⟩

/-- Adding a `ℚ`-divisor `D` with a Cartier multiple `D₀ = mD` lowers a log discrepancy by
`1/m` times the coefficient of the pull-back of `D₀`. -/
private theorem isLogDiscrepancy_add_of_zsmul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {D : QDivisor X} {m : ℕ}
    (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (D₀' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ D₀.supp), D₀.IsPullback F.f hCs D₀' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + QDivisor.toRDivisor D) F
        (a - (D₀'.coeff F.E : ℝ) / m) := by
  intro D₀' hCs hpb
  have h1 := isLogDiscrepancy_add_smul h hD₀c (1 / (m : ℝ)) D₀' hCs hpb
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : B + (1 / (m : ℝ)) • Divisor.toRDivisor D₀ = B + QDivisor.toRDivisor D := by
    congr 1
    refine Finsupp.ext fun Γ => ?_
    have h2 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    have h3 : ((D₀.coeff Γ : ℤ) : ℝ) = m * ((D.coeff Γ : ℚ) : ℝ) := by exact_mod_cast h2
    change DivisorWithCoeffs.coeff ((1 / (m : ℝ)) • Divisor.toRDivisor D₀) Γ =
      DivisorWithCoeffs.coeff (QDivisor.toRDivisor D) Γ
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, QDivisor.coeff_toRDivisor,
      smul_eq_mul, h3]
    field_simp
  rw [e] at h1
  convert h1 using 1
  ring

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{0}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  show IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    rw [if_pos hPJ]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    rw [if_neg hPJ]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every set closed under specialization containing no
stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : ∀ x ∈ T, closure {x} ⊆ T)
    (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K (Divisor.toQDivisor Δ) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hK F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists, not_and]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  haveI : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT x hxT

/-- Adding `∑_{P ∈ s} c_P P` to the boundary on a smooth variety lowers a log discrepancy by
`∑_{P ∈ s} c_P e_P`, where `e_P` is the coefficient of the pull-back of `P` along the divisor. -/
private theorem isLogDiscrepancy_add_sum (hsm : IsSmoothScheme sX) {n : ℕ} {B : RDivisor X}
    {F : DivisorOver k sX} {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (c : MMP.Mori.PrimeDivisor X → ℝ)
    (e : MMP.Mori.PrimeDivisor X → ℤ)
    (he : haveI := F.isLocallyNoetherian
      haveI := F.isNormal
      ∀ P ∈ s, ∀ (P' : Divisor F.Y) (hB : ∀ Z : irreducibleComponents F.Y,
          F.f (componentGenericPoint F.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor X)),
        Divisor.IsPullback F.f (Finsupp.single P 1 : Divisor X) hB P' → P'.coeff F.E = e P) :
    MMP.Intersection.IsLogDiscrepancy sX n
      (B + ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X)) F
      (a - ∑ P ∈ s, c P * e P) := by
  classical
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  induction s using Finset.induction_on with
  | empty => simpa using h
  | insert P s hP ih =>
    have hC : Divisor.IsCartier (Finsupp.single P 1 : Divisor X) :=
      MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
      (Finsupp.single P (1 : ℤ) : Divisor X)
    obtain ⟨P', hP'⟩ := hC.exists_isPullback hB
    have h' := isLogDiscrepancy_add_smul (ih fun Q hQ => he Q (Finset.mem_insert_of_mem hQ)) hC
      (c P) P' hB hP'
    rw [he P (Finset.mem_insert_self _ _) P' hB hP'] at h'
    have e1 : B + ∑ Q ∈ insert P s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) =
        B + ∑ Q ∈ s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) +
          c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
      rw [Finset.sum_insert hP]; abel
    have e2 : a - ∑ Q ∈ insert P s, c Q * e Q = a - ∑ Q ∈ s, c Q * e Q - c P * e P := by
      rw [Finset.sum_insert hP]; ring
    rw [e1, e2]
    exact h'

/-- **Zero places see no `D`.** If `a(F, X, Δ) = 0` for the reduced snc `Δ` and `D` contains no
stratum of `Δ`, then `a(F, X, Δ + D) = 0`. -/
private theorem eq_zero_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hns : ContainsNoStratum Δ D.supp) {n : ℕ}
    {F : DivisorOver k sX} {a : ℝ}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0)
    (ha : MMP.Intersection.IsLogDiscrepancy sX n
      (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a) : a = 0 := by
  have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ (fun x hx =>
    (DivisorWithCoeffs.supp D).isClosed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx))
    hns h0
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
  obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hz := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hx) D₀' hB hD₀'
  have h1 := isLogDiscrepancy_add_of_zsmul h0 hm hD₀ hD₀c D₀' hB hD₀'
  rw [hz] at h1
  have h2 : (0 : ℝ) - ((0 : ℤ) : ℝ) / m = 0 := by simp
  rw [h2] at h1
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1

end Toolkit

/-! ### The arithmetic of the comparison on a log resolution -/

/-- If `A₀ = t + ∑ a₀ᵢ eᵢ` and `A = t + ∑ αᵢ eᵢ` with `t, eᵢ ≥ 0`, `a₀ᵢ ∈ ℕ`, `αᵢ = 0` whenever
`a₀ᵢ = 0`, and `Gᵢ = ⌈αᵢ⌉ - 1 + [a₀ᵢ = 0]`, then `∑ Gᵢ eᵢ ≤ ⌈A⌉ - 1 + [A₀ = 0]`. -/
private theorem sum_mul_le_ceil {ι : Type*} (s : Finset ι) (a₀ : ι → ℕ) (α : ι → ℝ)
    (e G : ι → ℤ) (t : ℕ) {A₀ A : ℝ} (he : ∀ i ∈ s, 0 ≤ e i)
    (hz : ∀ i ∈ s, a₀ i = 0 → α i = 0)
    (hG : ∀ i ∈ s, G i = ⌈α i⌉ - 1 + if ((a₀ i : ℕ) : ℝ) = 0 then 1 else 0)
    (hA₀ : A₀ = t + ∑ i ∈ s, (a₀ i : ℝ) * e i) (hA : A = t + ∑ i ∈ s, α i * e i) :
    ∑ i ∈ s, G i * e i ≤ ⌈A⌉ - 1 + if A₀ = 0 then 1 else 0 := by
  have hGz : ∀ i ∈ s, a₀ i = 0 → G i = 0 := by
    intro i hi h0
    rw [hG i hi, hz i hi h0]
    simp [h0]
  have hGpos : ∀ i ∈ s, a₀ i ≠ 0 → (G i : ℝ) < α i := by
    intro i hi h0
    rw [hG i hi, if_neg (by exact_mod_cast h0)]
    push_cast
    linarith [Int.ceil_lt_add_one (α i)]
  have hterm : ∀ i ∈ s, 0 ≤ (α i - G i) * e i := by
    intro i hi
    by_cases h0 : a₀ i = 0
    · rw [hz i hi h0, hGz i hi h0]; simp
    · exact mul_nonneg (by linarith [hGpos i hi h0]) (by exact_mod_cast he i hi)
  have hdiff : A - ∑ i ∈ s, (G i : ℝ) * e i = t + ∑ i ∈ s, (α i - G i) * e i := by
    rw [hA]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have ht : (0 : ℝ) ≤ t := Nat.cast_nonneg t
  by_cases hA0 : A₀ = 0
  · rw [if_pos hA0]
    have hnn : ∀ i ∈ s, 0 ≤ (a₀ i : ℝ) * e i := fun i hi =>
      mul_nonneg (Nat.cast_nonneg _) (by exact_mod_cast he i hi)
    have hs := Finset.sum_nonneg hnn
    have hsum0 : ∑ i ∈ s, (a₀ i : ℝ) * e i = 0 := by linarith
    have ht0 : (t : ℝ) = 0 := by linarith
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hsum0
    have hGe : ∀ i ∈ s, (G i : ℝ) * e i = 0 ∧ α i * e i = 0 := by
      intro i hi
      by_cases h0 : a₀ i = 0
      · rw [hGz i hi h0, hz i hi h0]; simp
      · have he0 : (e i : ℝ) = 0 := by
          rcases mul_eq_zero.mp (hzero i hi) with h | h
          · exact absurd (by exact_mod_cast h) h0
          · exact h
        rw [he0]; simp
    have hS : ∑ i ∈ s, (G i : ℝ) * e i = 0 := Finset.sum_eq_zero fun i hi => (hGe i hi).1
    have hA' : A = 0 := by
      rw [hA, ht0, Finset.sum_eq_zero fun i hi => (hGe i hi).2]; simp
    have hS' : ∑ i ∈ s, G i * e i = 0 := by exact_mod_cast hS
    rw [hS', hA']
    simp
  · rw [if_neg hA0]
    have hlt : ((∑ i ∈ s, G i * e i : ℤ) : ℝ) < A := by
      push_cast
      by_contra hle
      have hle := not_lt.mp hle
      have hsnn := Finset.sum_nonneg hterm
      have ht0 : (t : ℝ) = 0 := by linarith
      have hs0 : ∑ i ∈ s, (α i - G i) * e i = 0 := by linarith
      have hz2 := (Finset.sum_eq_zero_iff_of_nonneg hterm).mp hs0
      apply hA0
      rw [hA₀, ht0, zero_add]
      refine Finset.sum_eq_zero fun i hi => ?_
      by_cases h0 : a₀ i = 0
      · simp [h0]
      · rcases mul_eq_zero.mp (hz2 i hi) with h | h
        · exact absurd h (by linarith [hGpos i hi h0])
        · rw [h]; simp
    have : (∑ i ∈ s, G i * e i : ℤ) < ⌈A⌉ := by
      have := hlt.trans_le (Int.le_ceil A)
      exact_mod_cast this
    omega

/-- `⌈a⌉ - 1 + [a₀ = 0] ≤ 0` when `a ≤ a₀ ∈ {0, 1}`. -/
private theorem ceil_sub_one_add_ite_nonpos {a₀ a : ℝ} (h01 : a₀ = 0 ∨ a₀ = 1) (hle : a ≤ a₀) :
    ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) ≤ 0 := by
  rcases h01 with h | h
  · rw [if_pos h]
    have := Int.ceil_le.mpr (show a ≤ ((0 : ℤ) : ℝ) by push_cast; linarith)
    omega
  · rw [if_neg (by rw [h]; norm_num)]
    have := Int.ceil_le.mpr (show a ≤ ((1 : ℤ) : ℝ) by push_cast; linarith)
    omega

/-- The exponent `⌈a⌉ - 1 + [a₀ = 0]` decreases when the integral `a₀ ∈ ℕ` drops by `c₁ ≥ 0` to
`a₀ - c₁ ∈ ℕ` and `a` drops by at least `c₁`. -/
private theorem ceil_add_ite_le_of_le {a₀ a c₁ c₂ : ℝ} {p p' : ℕ} (hp : a₀ = p)
    (hp' : a₀ - 1 * c₁ = p') (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    ⌈a - 1 * c₁ - c₂⌉ - 1 + (if a₀ - 1 * c₁ = 0 then 1 else 0) ≤
      ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) := by
  have hmono : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a⌉ := Int.ceil_mono (by linarith)
  split_ifs with h1 h2 h2
  · omega
  · have hp1 : (1 : ℝ) ≤ p := by
      have hp0 : p ≠ 0 := by
        rintro rfl
        exact h2 (by rw [hp]; simp)
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hp0
    have h3 : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a - 1⌉ := Int.ceil_mono (by linarith)
    rw [Int.ceil_sub_one] at h3
    omega
  · exfalso
    apply h1
    have : (0 : ℝ) ≤ p' := Nat.cast_nonneg _
    linarith
  · omega

/-! ### Divisors over `X` realized over a proper birational model -/

section Model

variable {k : Type} [Field k]

/-- **The centre of a divisorial valuation on a proper model.** Let `π : W ⟶ X` be a proper
dominant morphism of integral schemes and `D` a divisor over `X`. A valuation `ξ` of `k(W)`
restricting to `ord_D` on `k(X)` dominates the local ring of some point of `W`. -/
private theorem exists_dominated_point {X W : Scheme.{0}} [IsIntegral X]
    [IsIntegral W] {sX : X ⟶ Spec (.of k)} (π : W ⟶ X) [IsDominant π] (hπ : IsProper π)
    (D : DivisorOver k sX) (ξ : Valuation W.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ.comap (functionFieldMap π) = D.valuation) :
    ∃ x : W, (∀ a : W.presheaf.stalk x, ξ (algebraMap _ W.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk x),
        ξ (algebraMap _ W.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  have hw : ∀ b : X.presheaf.stalk y,
      ξ (functionFieldMap π (algebraMap _ X.functionField b)) =
        D.valuation (algebraMap _ X.functionField b) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ X.functionField b)) h
    simpa only [Valuation.comap_apply] using this
  let R := ξ.valuationSubring
  let φ : X.presheaf.stalk y →+* R :=
    ((functionFieldMap π).comp (algebraMap (X.presheaf.stalk y) X.functionField)).codRestrict R
      fun b => (ξ.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint X ⤳ y := (genericPoint_spec X).specializes trivial
  have hex : ValuativeCriterion.Existence π := by
    have h : @IsProper _ _ π := hπ
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq π :=
    { R := R
      K := W.functionField
      i₁ := W.fromSpecStalk (genericPoint W)
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ X.fromSpecStalk y
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk π,
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R W.functionField)) ≫ l =
      W.fromSpecStalk (genericPoint W) := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint W ⤳ x := (genericPoint_spec W).specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R W.functionField) =
      W.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (W.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : W.presheaf.stalk x,
      algebraMap _ W.functionField a = ((f.hom a : R) : W.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]; exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

/-- **Divisors over `X` are realized over a proper birational model.** For a proper birational
morphism `π : W ⟶ X` of normal varieties and a divisor `D` over `X`, some divisor `D'` over `W`,
proper over `W`, induces the valuation of `D` on `k(X) ≅ k(W)`, and its centre on `W` maps to
the centre of `D` on `X`. -/
private theorem exists_divisorOver_model {X W : Scheme.{0}} [IsIntegral X] [IsIntegral W]
    {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX) (π : W ⟶ X) (hπ : IsProper π)
    (hbir : IsBirationalMorphism π) (hW : IsNormalVariety k (π ≫ sX)) (D : DivisorOver k sX) :
    haveI : IsDominant π := hbir.isDominant
    ∃ D' : DivisorOver k (π ≫ sX), IsProper D'.f ∧
      D.valuation = D'.valuation.comap (functionFieldMap π) ∧
      π (D'.f D'.E.genericPoint) = D.f D.E.genericPoint := by
  haveI : IsDominant π := hbir.isDominant
  have hbij := hbir.functionFieldMap_bijective
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (π ≫ sX)
  let eπ := functionFieldAlgEquiv sX π hbij
  let ξ := D.valuation.comap (eπ.symm : W.functionField →+* X.functionField)
  have hξ : ξ.comap (functionFieldMap π) = D.valuation := by
    ext t
    change D.valuation (eπ.symm (eπ t)) = D.valuation t
    rw [eπ.symm_apply_apply]
  obtain ⟨x, h1, h2⟩ := exists_dominated_point π hπ D ξ hξ
  haveI : AlgebraicGeometry.IsVariety k (π ≫ sX) := hW.1
  have hdiv : MMP.Flips.IsDivisorOfFunctionField k (π ≫ sX) ξ := by
    haveI := D.isIntegral
    haveI := D.isNormal
    haveI := D.isLocallyNoetherian
    haveI := D.isDominant
    refine ⟨D.Y, D.f ≫ sX, D.isNormalVariety, D.E, ?_⟩
    letI := functionFieldAlgebra (D.f ≫ sX)
    let eD := functionFieldAlgEquiv sX D.f D.isBirationalMorphism.functionFieldMap_bijective
    refine ⟨eπ.symm.trans eD, ?_⟩
    ext t
    rfl
  obtain ⟨D', -, hv, hDx⟩ :=
    MMP.Flips.exists_properDivisorOver_isProjective_of_dominates (π ≫ sX) hdiv x h1 h2
  have hval : D.valuation = D'.toDivisorOver.valuation.comap (functionFieldMap π) := by
    rw [← hξ, ← hv]
  refine ⟨D'.toDivisorOver, D'.isProper, hval, ?_⟩
  -- the centres agree: compare `D` with `D'` regarded as a divisor over `X`
  have hcomp := MMP.Mori.valuation_compDivisorOver π hW hbir D'.toDivisorOver
  have hcen := MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX
    (hcomp.trans hval.symm)
  have e1 := (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).center_eq_closure_genericPoint
  have e2 := D.center_eq_closure_genericPoint
  rw [← hcen, e1] at e2
  have hins : Inseparable ((MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).f
      (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).E.genericPoint)
      (D.f D.E.genericPoint) := inseparable_iff_closure_eq.mpr e2
  exact hins.eq

end Model

/-! ### Push-forwards with values in `𝒪_X` are ideal sheaves -/

section Ideal

variable {X X' : Scheme.{0}} [IsIntegral X] [IsIntegral X'] [IsLocallyNoetherian X']
  [IsNormal X'] (μ : X' ⟶ X) [IsDominant μ]

/-- The valuation `v_P(μ^* ·)` on the stalk of `X` at the centre `μ(η_P)` is at most `1`. -/
private theorem val_stalk_le_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) :
    P.valuationOver μ (algebraMap _ X.functionField a) ≤ 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
    MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff,
    MMP.Mori.functionFieldMap_algebraMap_stalk]
  exact ⟨_, rfl⟩

/-- A non-unit of the stalk of `X` at the centre `μ(η_P)` has `v_P(μ^* ·) < 1`. -/
private theorem val_stalk_lt_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) (ha : ¬ IsUnit a) :
    P.valuationOver μ (algebraMap _ X.functionField a) < 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_algebraMap_stalk,
    MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff]
  exact (IsLocalRing.mem_maximalIdeal _).mpr fun h => ha (isUnit_of_map_unit _ _ h)

/-- In `ℤᵐ⁰`, an element below `1` is at most `exp (-1)`. -/
private theorem le_exp_neg_one_of_lt_one {x : WithZero (Multiplicative ℤ)} (hx : x < 1) :
    x ≤ WithZero.exp (-1) := by
  rcases eq_or_ne x 0 with rfl | h0
  · exact zero_le'
  rw [← WithZero.exp_log h0] at hx ⊢
  rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hx
  rw [WithZero.exp_le_exp]
  omega

/-- The regular functions `a` on `U` with `v_P(μ^* a) ≤ exp (coeff_P G)` at every prime divisor
`P` whose generic point maps into `U`. -/
private def valIdeal (G : Divisor X') (U : X.Opens) : Ideal Γ(X, U) where
  carrier := {a | ∀ (P : MMP.Mori.PrimeDivisor X') (hP : μ P.genericPoint ∈ U),
    P.valuationOver μ (algebraMap _ X.functionField (X.presheaf.germ U _ hP a)) ≤
      WithZero.exp (G.coeff P)}
  add_mem' {a b} ha hb P hP := by
    rw [map_add, map_add]
    exact (Valuation.map_add _ _ _).trans (max_le (ha P hP) (hb P hP))
  zero_mem' P hP := by simp
  smul_mem' c a ha P hP := by
    rw [smul_eq_mul, map_mul, map_mul, Valuation.map_mul]
    exact (mul_le_of_le_one_left' (val_stalk_le_one μ P _)).trans (ha P hP)

/-- Some `m : ℕ` bounds every coefficient of `G` from below by `-m`. -/
private theorem exists_neg_le_coeff (G : Divisor X') : ∃ m : ℕ, ∀ P, -(m : ℤ) ≤ G.coeff P := by
  refine ⟨∑ P ∈ G.support, (G.coeff P).natAbs, fun P => ?_⟩
  by_cases hP : P ∈ G.support
  · have := Finset.single_le_sum (f := fun P => (G.coeff P).natAbs) (fun _ _ => Nat.zero_le _) hP
    omega
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.notMem_support_iff.mp hP]; omega

/-- If `y|_{D(f)} = f ^ n b` with `b` in the ideal on `D(f)`, then `f ^ m y` lies in the ideal on
`U` as soon as `-m` bounds the coefficients of `G` from below. -/
private theorem pow_mul_mem_valIdeal {G : Divisor X'} {U : X.Opens} {f y : Γ(X, U)}
    {b : Γ(X, X.basicOpen f)} {n m : ℕ} (hb : b ∈ valIdeal μ G (X.basicOpen f))
    (hy : y |_ X.basicOpen f = (f |_ X.basicOpen f) ^ n * b) (hm : ∀ P, -(m : ℤ) ≤ G.coeff P) :
    f ^ m * y ∈ valIdeal μ G U := by
  intro P hP
  rw [map_mul, map_mul, Valuation.map_mul, map_pow, map_pow, Valuation.map_pow]
  by_cases hf : μ P.genericPoint ∈ X.basicOpen f
  · refine (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) m)).trans ?_
    have h2 : X.presheaf.germ _ _ hP y = X.presheaf.germ _ _ hP f ^ n *
        X.presheaf.germ _ _ hf b := by
      rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← map_pow, ← map_mul]
      exact congrArg _ hy
    rw [h2, map_mul, Valuation.map_mul, map_pow, Valuation.map_pow]
    exact (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) n)).trans (hb P hf)
  · have hle := le_exp_neg_one_of_lt_one (val_stalk_lt_one μ P (X.presheaf.germ _ _ hP f)
      (by rwa [← X.mem_basicOpen f _ hP]))
    refine (mul_le_of_le_one_right' (val_stalk_le_one μ P _)).trans
      ((pow_le_pow_left₀ zero_le' hle m).trans ?_)
    rw [← WithZero.exp_nsmul, WithZero.exp_le_exp]
    simpa using hm P

/-- The ideal sheaf of `X` whose ideal on an affine open `U` is `valIdeal μ G U`. -/
private def valIdealSheaf (G : Divisor X') : X.IdealSheafData where
  ideal U := valIdeal μ G U
  map_ideal_basicOpen U f := by
    change _ = valIdeal μ G (X.basicOpen f)
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha P hP
      change P.valuationOver μ (algebraMap _ X.functionField
        (X.presheaf.germ _ _ hP ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a))) ≤ _
      rw [TopCat.Presheaf.germ_res_apply]
      exact ha P (X.basicOpen_le f hP)
    · intro b hb
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen X U U.2 f b
      obtain ⟨m, hm⟩ := exists_neg_le_coeff G
      have hin := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (pow_mul_mem_valIdeal μ hb hy hm)
      rw [map_mul, map_pow] at hin
      change _ * (y |_ X.basicOpen f) ∈ _ at hin
      rw [hy, ← mul_assoc] at hin
      have hu := X.toRingedSpace.isUnit_res_basicOpen f
      exact (Ideal.unit_mul_mem_iff_mem _ ((hu.pow m).mul (hu.pow n))).mp hin

/-- **A push-forward with values in `𝒪_X` is an ideal sheaf.** If the sections of
`μ_*𝒪_{X'}(G)` over every non-empty open are regular functions, then on every non-empty affine
open they are the ideal of an ideal sheaf of `X`. -/
private theorem exists_idealSheafData_of_subset_range [IsLocallyNoetherian X] [IsNormal X]
    (G : Divisor X')
    (hsub : ∀ (U : X.Opens) [Nonempty U],
      MMP.Intersection.multiplierIdealSections μ G U ⊆ Set.range (X.germToFunctionField U)) :
    ∃ I : X.IdealSheafData, ∀ (U : X.affineOpens) [Nonempty (U : X.Opens)],
      MMP.Intersection.multiplierIdealSections μ G U =
        X.germToFunctionField (U : X.Opens) '' (I.ideal U : Set Γ(X, U)) := by
  refine ⟨valIdealSheaf μ G, fun U _ => ?_⟩
  have hne : μ ⁻¹ᵁ (U : X.Opens) ≠ ⊥ := by
    obtain ⟨u⟩ := ‹Nonempty (U : X.Opens)›
    obtain ⟨_, hx', x', rfl⟩ :=
      μ.denseRange.inter_open_nonempty _ (U : X.Opens).isOpen ⟨u.1, u.2⟩
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x', hx'⟩
  ext g
  constructor
  · intro hg
    obtain ⟨a, rfl⟩ := hsub U hg
    refine ⟨a, fun P hP => ?_, rfl⟩
    have := hg.2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P
      (V := μ ⁻¹ᵁ (U : X.Opens)) hP)
    rwa [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hP] at this
  · rintro ⟨a, ha, rfl⟩
    refine ⟨fun h => absurd h hne, fun P hP => ?_⟩
    have hη : μ P.genericPoint ∈ (U : X.Opens) :=
      MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hη]
    exact ha P hη

end Ideal

/-! ### The adjoint ideal by orders along all divisors over `X` -/

section Main

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} c_P P = B` when `B` has coefficient `c_P` along `P ∈ s` and vanishes off `s`. -/
private theorem sum_smul_single_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  refine Finsupp.ext fun Q => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul]
  have h1 : ∀ P, (Divisor.toRDivisor (Finsupp.single P (1 : ℤ) : Divisor X)) Q =
      if P = Q then 1 else 0 := by
    intro P
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply]
    split_ifs <;> simp
  simp only [h1, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.sum_ite_eq]
  rw [← DivisorWithCoeffs.coeff_apply B]
  by_cases hQ : Q ∈ s
  · rw [if_pos hQ, hin Q hQ]
  · rw [if_neg hQ, hout Q hQ]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} P + ∑_{P ∈ s} c_P P = B` when `B` has coefficient `1 + c_P` along `P ∈ s` and
vanishes off `s`. -/
private theorem toRDivisor_add_sum_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = 1 + c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) +
      ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  have hT : Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) =
      ∑ P ∈ s, (1 : ℝ) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
    refine (sum_smul_single_eq s (fun _ => 1) _ (fun Q hQ => ?_) (fun Q hQ => ?_)).symm
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_pos hQ]; simp
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_neg hQ]; simp
  rw [hT, ← Finset.sum_add_distrib]
  simp_rw [← add_smul]
  exact sum_smul_single_eq s (fun P => 1 + c P) B hin hout

/-- The sections over `U` of `𝒥_{Δ,D}` described valuatively: the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` whose
centre lies in `U`. -/
private def adjointSet (Δ : Divisor X) (D : QDivisor X) (U : X.Opens) : Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (F : DivisorOver k sX) (a₀ a : ℝ),
    F.f F.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F a₀ →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a →
    F.valuation g ≤ WithZero.exp (⌈a⌉ - 1 + if a₀ = 0 then 1 else 0)}

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An snc closed subset of a smooth scheme is the union of the components of an snc divisor. -/
private theorem exists_finset_of_isSNCSubset [LocallyOfFinitePresentation sX]
    (hsm : IsSmoothScheme sX) {S : Closeds X} (h : IsSNCSubset sX S) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor X), (⋃ E ∈ s, E.support) = (S : Set X) ∧
      DivisorWithCoeffs.IsSNC sX (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
  rcases h with h | h
  · refine ⟨∅, by simp [h], ?_⟩
    simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme (R := ℤ) sX hsm
  · exact h

/-- A prime divisor of a proper birational model which is not exceptional and whose centre lies
off `Supp B` has log discrepancy `1` with respect to `B`. -/
private theorem isLogDiscrepancy_one_of_notMem [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    (B : QDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (hexc : P.genericPoint ∉ (exceptionalSet μ : Set Y))
    (hB : μ P.genericPoint ∉ (DivisorWithCoeffs.supp (QDivisor.toRDivisor B) : Set X)) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K B :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ¬ FP.IsExceptional := fun hexc' =>
    hexc (MMP.Positivity.support_subset_exceptionalSet P hexc' hPmem)
  obtain ⟨Q, hQc, hQd⟩ := MMP.Mori.DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPW FP hne
  have hηQ : μ P.genericPoint = Q.genericPoint := by
    have e1 := FP.center_eq_closure_genericPoint
    rw [hQc, AlgebraicGeometry.PrimeDivisor.support_eq_closure Q] at e1
    exact (inseparable_iff_closure_eq.mpr e1.symm).eq
  have hQmem : Q.genericPoint ∈ Q.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hQ0 : B.coeff Q = 0 := by
    by_contra hne'
    apply hB
    rw [hηQ]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero]) hQmem
  rw [hQ0, neg_zero] at hQd
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hQd hμp
  convert hl using 1
  simp

/-- **Log discrepancy one off the snc divisor of a log resolution.** Let `μ : Y → X` be a proper
birational model and `s` the components of `Exc(μ) ∪ μ⁻¹ Supp(Δ + D)`, for `Δ` reduced and `D`
effective. A prime divisor `P ∉ s` of `Y` has log discrepancy `1` for `(X, Δ)` and `(X, Δ + D)`. -/
private theorem isLogDiscrepancy_one_of_notMem_finset [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) :
        Set Y) ⊆ ⋃ E ∈ s, E.support)
    {P : MMP.Mori.PrimeDivisor Y} (hPs : P ∉ s) :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ 1 ∧
      MMP.Intersection.IsLogDiscrepancy sX n
        (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
    intro hz
    obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
    exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
  have hnot' := fun h => hnot (hs h)
  rw [Closeds.coe_sup, Set.mem_union] at hnot'
  obtain ⟨hexc, hsupp⟩ := not_or.mp hnot'
  have hsuppΔ : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
    intro hmem
    apply hsupp
    obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have : (0 : ℝ) ≤ ((D.coeff Γ' : ℚ) : ℝ) := by exact_mod_cast hD0 Γ'
    rcases hΔ Γ' with h | h
    · rw [h] at hΓ'; simp at hΓ'
    · rw [h]; push_cast; linarith
  have h0 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsuppΔ
  have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsupp
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
  exact ⟨h0, h1⟩

/-- **Linearity along an snc divisor of a model.** Let `F'` be a divisor over a smooth variety
`Y`, proper over `Y`, and `s` the components of a reduced snc divisor `T` on `Y`. With
`t = a(F', Y, T) ∈ ℕ` and `e_P ≥ 0` the coefficient along `F'` of the pull-back of `P`, every
boundary `B = ∑_{P ∈ s} (1 + c_P) P` has `a(F', Y, B) = t - ∑ c_P e_P`, and every divisor `G`
supported on `s` pulls back to a divisor with coefficient `∑ G_P e_P` along `F'`. -/
private theorem exists_isLogDiscrepancy_and_coeff_eq_sum {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k]
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {sY : Y ⟶ Spec (.of k)}
    (hY : IsNormalVariety k sY) (hsmY : IsSmoothScheme sY) {n : ℕ}
    (hnY : topologicalKrullDim Y = n) {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hsnc : DivisorWithCoeffs.IsSNC sY (∑ E ∈ s, Finsupp.single E (1 : ℤ)))
    (F' : DivisorOver k sY) (hF'p : IsProper F'.f) :
    haveI := F'.isLocallyNoetherian
    haveI := F'.isNormal
    ∃ (t : ℕ) (e : MMP.Mori.PrimeDivisor Y → ℤ), (∀ P ∈ s, 0 ≤ e P) ∧
      (∀ (c : MMP.Mori.PrimeDivisor Y → ℝ) (B : RDivisor Y), (∀ Q ∈ s, B.coeff Q = 1 + c Q) →
        (∀ Q ∉ s, B.coeff Q = 0) →
        MMP.Intersection.IsLogDiscrepancy sY n B F' (t - ∑ P ∈ s, c P * e P)) ∧
      ∀ (G : Divisor Y), (∀ Q ∉ s, G.coeff Q = 0) → ∀ (G' : Divisor F'.Y)
        (hB : ∀ Z : irreducibleComponents F'.Y, F'.f (componentGenericPoint F'.Y Z) ∉ G.supp),
        G.IsPullback F'.f hB G' → G'.coeff F'.E = ∑ P ∈ s, G.coeff P * e P := by
  classical
  haveI : MMP.Mori.IsVariety k sY := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  have := F'.isLocallyNoetherian
  have := F'.isNormal
  have := F'.isIntegral
  have := F'.isBirationalMorphism.isDominant
  have : CompactSpace F'.Y :=
    (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hTred : MMP.Intersection.IsReducedEffective (MMP.Intersection.reducedDivisorOf s) :=
    fun P => by rw [MMP.Intersection.coeff_reducedDivisorOf]; split_ifs <;> simp
  obtain ⟨tr, htr⟩ := exists_isLogDiscrepancy hY hsmY hnY
    (Divisor.toQDivisor (MMP.Intersection.reducedDivisorOf s)) F' hF'p
  rw [QDivisor.toRDivisor_toQDivisor] at htr
  obtain ⟨t, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sY hY.1
    hsmY hTred hsnc htr
  have hcart : ∀ P : MMP.Mori.PrimeDivisor Y,
      Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor Y) := fun P =>
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  choose P' hP' using fun P : MMP.Mori.PrimeDivisor Y => (hcart P).exists_isPullback
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
      (Finsupp.single P (1 : ℤ) : Divisor Y))
  set e : MMP.Mori.PrimeDivisor Y → ℤ := fun P => (P' P).coeff F'.E with hedef
  have he : ∀ P ∈ s, ∀ (Q' : Divisor F'.Y) (hB : ∀ Z : irreducibleComponents F'.Y,
        F'.f (componentGenericPoint F'.Y Z) ∉
          DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor Y)),
      Divisor.IsPullback F'.f (Finsupp.single P 1 : Divisor Y) hB Q' → Q'.coeff F'.E = e P := by
    intro P _ Q' hB hQ'
    rw [hQ'.eq (hcart P) (hP' P)]
  refine ⟨t, e, fun P _ => coeff_isPullback_nonneg (F := F') (hcart P) (fun Γ _ => by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> simp) _ _ (hP' P),
    fun c B hin hout => ?_, fun G hG0 G' hB hG' => ?_⟩
  · rw [← toRDivisor_add_sum_eq s c B hin hout]
    exact isLogDiscrepancy_add_sum hsmY htr s c e he
  · have hl1 := isLogDiscrepancy_add_smul htr (MMP.Fourfold.isCartier_of_isSmoothScheme hsmY G)
      (1 : ℝ) G' hB hG'
    have hl2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => (G.coeff P : ℝ)) e he
    rw [sum_smul_single_eq s (fun P => (G.coeff P : ℝ)) ((1 : ℝ) • Divisor.toRDivisor G)
      (fun Q _ => by rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor]; simp)
      (fun Q hQ => by rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, hG0 Q hQ]; simp)]
      at hl2
    have h := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hl1 hl2
    have h' : (G'.coeff F'.E : ℝ) = ∑ P ∈ s, (G.coeff P : ℝ) * e P := by linarith
    exact_mod_cast h'

/-- **Bounds along one model give bounds along all divisors over `X`.** Let `μ : Y ⟶ X` be a
proper birational morphism from a smooth variety and `s` a finite set of prime divisors of `Y`
whose reduced sum is snc and whose union contains `Ex(μ) ∪ μ⁻¹ Supp(Δ + D)`, and let `D₀ = mD`
be integral with pull-back `D₀'`. A rational function with `v_P(g) ≤ exp (⌈a₀ - coeff_P(D₀')/m⌉
- 1 + [a₀ = 0])` along every prime divisor `P` of `Y` centred in `U`, where `a₀ = a(P, X, Δ)`, is
a section of `𝒥_{Δ,D}` over `U`. -/
private theorem multiplierIdealSections_subset_adjointSet [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDns : ContainsNoStratum Δ D.supp)
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hμp : IsProper μ) (hsmY : IsSmoothScheme (μ ≫ sX)) {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) :
        Set Y) ⊆ ⋃ E ∈ s, E.support)
    (hsnc : DivisorWithCoeffs.IsSNC (μ ≫ sX) (∑ E ∈ s, Finsupp.single E (1 : ℤ)))
    {m : ℕ} (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier)
    {hD₀μ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D₀.supp}
    {D₀' : Divisor Y} (hD₀' : D₀.IsPullback μ hD₀μ D₀') (G : Divisor Y)
    (hG : ∀ (n : ℕ) (P : MMP.Mori.PrimeDivisor Y) (a₀ : ℕ),
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ →
      G.coeff P = ⌈(a₀ : ℝ) - (D₀'.coeff P : ℝ) / m⌉ - 1 + if a₀ = 0 then 1 else 0)
    (U : X.Opens) :
    MMP.Intersection.multiplierIdealSections μ G U ⊆ adjointSet sX Δ D U := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hμp
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hμp
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    refine ⟨a₀, (a₀ : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m, ha₀r, hα, ?_, ?_, ?_⟩
    · rw [hG n P a₀ ha₀r]
      congr 1
      by_cases h : a₀ = 0 <;> simp [h]
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hμp hs hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  intro g
  rintro ⟨hg0, hgP⟩
  refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a₀ a hx ha₀ ha => ?_⟩
  rcases eq_or_ne g 0 with rfl | hgne
  · simp
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha₀
  obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hμp hμ hY F₀
  set y := F'.f F'.E.genericPoint with hy
  have hyU : y ∈ μ ⁻¹ᵁ U := by
    show μ y ∈ U
    rw [hcen]; exact hx
  have hnY : topologicalKrullDim Y = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
      hn
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
  have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  have hP1 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ + D) :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨B₀, hB₀⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
  obtain ⟨B₁, hB₁⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP1 hK μ hY hμ).1.exists
  have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
    (Or.inl hB₀)).2 F' F₀ hval
  have hcr1 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP1 μ hY hμ hK hKY
    (Or.inl hB₁)).2 F' F₀ hval
  obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
  obtain ⟨c₁, hc₁⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP1 hK F₀
  have ha₀c : a₀ = 1 + c₀ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
    hc₀ (by rwa [QDivisor.toRDivisor_toQDivisor])
  have hac : a = 1 + c₁ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
    hc₁ (by rwa [map_add, QDivisor.toRDivisor_toQDivisor])
  have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
    ((hcr0 c₀).2 hc₀) hF'p
  have hY1 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
    ((hcr1 c₁).2 hc₁) hF'p
  obtain ⟨t, e, he0, hlin, hpull⟩ :=
    exists_isLogDiscrepancy_and_coeff_eq_sum hY hsmY hnY hsnc F' hF'p
  choose a₀P αP ha₀P hαP hGP hzP houtP using hcoef n hn
  have := F'.isLocallyNoetherian
  have := F'.isNormal
  have := F'.isIntegral
  have := F'.isBirationalMorphism.isDominant
  have : CompactSpace F'.Y :=
    (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  -- the crepant boundaries in terms of the coefficients
  have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
    intro Q
    have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
      hμp
    rw [QDivisor.toRDivisor_toQDivisor] at hl
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
    push_cast at this
    linarith
  have hB₁Q : ∀ Q, ((B₁.coeff Q : ℚ) : ℝ) = 1 - αP Q := by
    intro Q
    have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₁ Q)
      hμp
    rw [map_add, QDivisor.toRDivisor_toQDivisor] at hl
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hαP Q) hl
    push_cast at this
    linarith
  have hA₀ : a₀ = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
    rw [ha₀c, MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0 (hlin (fun P => -(a₀P P : ℝ)) _
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp))]
    simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
  have hA : a = t + ∑ P ∈ s, αP P * e P := by
    rw [hac, MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY1 (hlin (fun P => -αP P) _
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q, (houtP Q hQ).2]; simp))]
    simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
  -- `v_F(g) ≤ exp (∑ G_P e_P)`
  have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
  obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
  have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
    (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_neg, neg_neg]
      exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
  have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
    intro Q hQ
    rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
    simp
  have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by
    rw [hpull (-G) (fun Q hQ => by rw [DivisorWithCoeffs.coeff_neg, hG0 Q hQ, neg_zero]) G' hBG
      hG']
    simp only [DivisorWithCoeffs.coeff_neg, neg_mul, Finset.sum_neg_distrib]
  have hval' : F₀.valuation g = F'.valuation (functionFieldMap μ g) := by
    rw [hval]; rfl
  rw [hval']
  refine hR.trans ?_
  rw [hGe', neg_neg, WithZero.exp_le_exp]
  exact sum_mul_le_ceil s a₀P αP e (fun P => G.coeff P) t he0 (fun P _ => hzP P)
    (fun P _ => hGP P) hA₀ hA

/-- The zero log discrepancy divisor has coefficient `[a₀ = 0]` at a prime divisor of log
discrepancy `a₀ ∈ ℕ`. -/
private theorem coeff_eq_ite_of_isZeroLogDiscrepancyDivisor [PerfectField k] {Y : Scheme.{0}}
    {μ : Y ⟶ X}
    {hY : IsNormalVariety k (μ ≫ sX)} {hμ : IsBirationalMorphism μ} {Δ : Divisor X}
    {Γ : Divisor Y} (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    {P : MMP.Mori.PrimeDivisor Y} {n a₀ : ℕ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀) :
    Γ.coeff P = if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0 := by
  rcases hΓ.1 P with h0 | h1
  · rw [h0, if_neg]
    intro ha0
    have : Γ.coeff P = 1 := (hΓ.2 P).2 ⟨n, by rw [ha0] at ha; exact ha⟩
    omega
  · rw [h1, if_pos]
    obtain ⟨n', h'⟩ := (hΓ.2 P).1 h1
    exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h'

/-- **The adjoint ideal is computed by orders along all divisors over `X`.** The sections of
`μ_*𝒪_Y(E - ⌊μ^*D⌋)` are the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` centred
in the open set. -/
private theorem eq_adjointSet [IsAlgClosed k] [CharZero k] {Δ : Divisor X} {D : QDivisor X}
    {Y : Scheme.{0}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J) : J = adjointSet sX Δ D := by
  classical
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, _, _, _, _, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  set G := E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hGdef
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  obtain ⟨D₀', hD₀'eq, hD₀'pb⟩ := hF m hm D₀ hD₀ hD₀c
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'pb
    have hFP : ((D₀'.coeff P : ℤ) : ℝ) / m = ((F.coeff P : ℚ) : ℝ) := by
      have h1 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        Int.cast_natCast] at h1
      have h' : ((D₀'.coeff P : ℤ) : ℝ) = m * ((F.coeff P : ℚ) : ℝ) := by exact_mod_cast h1
      rw [h']
      field_simp
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    rw [hFP] at hα
    refine ⟨a₀, (a₀ : ℝ) - F.coeff P, ha₀r, hα, ?_, ?_, ?_⟩
    · have hΓP := coeff_eq_ite_of_isZeroLogDiscrepancyDivisor sX hΓ ha₀r
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊((F.coeff P : ℚ) : ℝ)⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - F.coeff P⌉ := by
        have e : ((F.coeff P : ℚ) : ℝ) = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        QDivisor.coeff_toRDivisor, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hlog.isProper hs.ge hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  funext U
  ext g
  constructor
  · /- `J ⊆ adjointSet`: the comparison along a model of `F` on `Y`. -/
    refine fun hg => multiplierIdealSections_subset_adjointSet sX hX hsm hΔ hD0 hDns hY hμ
      hlog.isProper hsmY hs.ge hsnc hm hD₀ hD₀c hD₀'pb G (fun n P a₀ ha => ?_) U hg
    obtain ⟨a₀', α, ha₀', hα, hGP, -, -⟩ :=
      hcoef n (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha) P
    have e1 : (a₀ : ℝ) = a₀' := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha₀'
    have e2 : a₀ = a₀' := by exact_mod_cast e1
    subst e2
    have hα' := isLogDiscrepancy_add_of_zsmul ha hm hD₀ hD₀c D₀' _ hD₀'pb
    have e3 : α = (a₀ : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m :=
      MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα hα'
    rw [hGP, e3]
    congr 1
    by_cases h0 : a₀ = 0 <;> simp [h0]
  · /- `adjointSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ((preimage_eq_bot_iff μ U).1 hU), fun P hP => ?_⟩
    have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    obtain ⟨n, a, hla, -⟩ := hE P
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
    obtain ⟨a₀, α, ha₀, hα, hGP, -, -⟩ := hcoef n hn P
    have := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ α hxU ha₀ hα
    rw [hGP]
    exact this

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A variety has finite dimension. -/
private theorem exists_topologicalKrullDim_eq [IsIntegral X] (hX : MMP.Mori.IsVariety k sX) :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  refine ⟨(Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction sX
    (genericPoint X)).toNat, ?_⟩
  rw [← Stacks.Chow.topologicalKrullDim_closure_singleton_eq k sX (genericPoint X)]
  have h : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
  exact (IsHomeomorph.topologicalKrullDim_eq _
    ((Homeomorph.setCongr h).trans (Homeomorph.Set.univ X)).isHomeomorph).symm

/-- The log discrepancy of a prime divisor `Q` of the smooth `X` is `1 - coeff_Q B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (Q : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hX Q) (1 - B.coeff Q) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
    (DivisorOver.ofPrimeDivisor k hX Q)
  have hcQ := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc
  have h := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 X) from inferInstance)
  rw [hcQ] at h
  convert h using 1
  push_cast
  ring

/-- The valuation of a prime divisor of `X`, regarded as a divisor over `X`. -/
private theorem valuation_ofPrimeDivisor (hX : IsNormalVariety k sX)
    (Q : MMP.Mori.PrimeDivisor X) (g : X.functionField) :
    (DivisorOver.ofPrimeDivisor k hX Q).valuation g = Q.divisorialValuation g := by
  change Q.divisorialValuation (functionFieldMap (𝟙 X) g) = _
  rw [MMP.Mori.functionFieldMap_id_apply]

/-- **The resolution choices exist**: a projective log resolution of `Δ + D`, the reduced sum
`Γ` of the zero places of `(X, Δ)` on it, and the divisor `E` with `K_Y + Γ = μ^*(K_X + Δ) + E`. -/
private theorem exists_isReducedAdjointIdealOn [IsAlgClosed k] [CharZero k] (Δ : Divisor X)
    (D : QDivisor X) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hΔ : IsReducedSNC sX Δ) (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ X) (J : X.Opens → Set X.functionField),
      IsReducedAdjointIdealOn sX Δ D μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨Y, μ, h1, h2⟩ := MMP.Mori.exists_isLogResolution_isProjectiveMorphism sX hX
    (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))
  have hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ := ⟨h1, h2⟩
  have hres := h1.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀]
    exact MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ D₀ Z
  have hF := QDivisor.isPullback_pullback (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D) hD
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hres.isProper hs.ge hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨Y, μ, _, hX, hsm, hΔ, hD0, hDns, hlog, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Γ, E, _, ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, hF, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

end Main

section Fixed

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The base locus of a linear series is closed under specialization. -/
private theorem closure_subset_baseLocusIn {V : Set X.functionField} {D : Divisor X} {x : X}
    (hx : x ∈ baseLocusIn V D) : closure {x} ⊆ baseLocusIn V D := by
  intro z hz g hg hg0
  obtain ⟨P, hxP, hlt⟩ := hx g hg hg0
  refine ⟨P, ?_, hlt⟩
  have hcl : IsClosed (P.support : Set X) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  exact hcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxP) hz

variable {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
  [IsDominant μ] {D : Divisor X}
  {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp} {Dμ : Divisor Y}

/-- `v_P(μ^*(g φ)) = v_P(μ^*g) · exp (-coeff_P(μ^*D))` for a local equation `φ` of `D` near the
centre of `P`. -/
private theorem valuationOver_mul_evalFF (h : D.IsPullback μ hD Dμ) (hDc : D.IsCartier)
    (P : MMP.Mori.PrimeDivisor Y) (g : X.functionField) :
    ∃ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ), D.IsLocalEquation U φ ∧
      μ P.genericPoint ∈ U ∧ ∀ Z : irreducibleComponents X,
        P.valuationOver μ (g * MMP.Threefold.Mori.Helpers.evalFF Z
          (φ : MMP.Mori.RationalFunctions X)) =
          P.valuationOver μ g * WithZero.exp (-Dμ.coeff P) := by
  obtain ⟨U, hxU, φ, hφ⟩ := hDc (μ P.genericPoint)
  refine ⟨U, φ, hφ, hxU, fun Z => ?_⟩
  rw [Valuation.map_mul, valuationOver_evalFF_eq h hφ P hxU Z]

/-- The fixed divisor of a series of sections of `𝒪_X(D)` pulled back to `Y` is effective. -/
private theorem coeff_nonneg_of_isFixedDivisorOfPullback (hDc : D.IsCartier)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (h : D.IsPullback μ hD Dμ)
    {F : Divisor Y} (hF : IsFixedDivisorOfPullback μ V Dμ F) (P : MMP.Mori.PrimeDivisor Y)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) :
    0 ≤ F.coeff P := by
  obtain ⟨g, hgV, -, hgeq⟩ := (hF P).2
  obtain ⟨U, φ, hφ, hxU, hval⟩ := valuationOver_mul_evalFF h hDc P g
  set Z : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have h1 := valuation_mul_evalFF_le_one (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX) (hVs hgV) hφ
    hxU Z
  change P.valuationOver μ _ ≤ 1 at h1
  rw [hval Z, hgeq, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  omega

/-- The fixed divisor vanishes along a prime divisor whose centre lies off the base locus. -/
private theorem coeff_nonpos_of_notMem_baseLocusIn (hDc : D.IsCartier)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (h : D.IsPullback μ hD Dμ)
    {F : Divisor Y} (hF : IsFixedDivisorOfPullback μ V Dμ F) (P : MMP.Mori.PrimeDivisor Y)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hx : μ P.genericPoint ∉ baseLocusIn V D) : F.coeff P ≤ 0 := by
  simp only [baseLocusIn, Set.mem_setOf_eq, not_forall, not_exists, not_and, not_lt] at hx
  obtain ⟨g, hgV, hg0, hge⟩ := hx
  obtain ⟨U, φ, hφ, hxU, hval⟩ := valuationOver_mul_evalFF h hDc P g
  set Z : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have h1 := valuation_eq_one_of_forall_ord_eq_zero (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX)
    (u := g * MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X))
    (mul_ne_zero hg0 (evalFF_ne_zero Z φ)) fun Γ hΓ => by
      rw [Scheme.ord_mul hg0 (evalFF_ne_zero Z φ),
        ord_evalFF_of_isLocalEquation hφ Z Γ ⟨_, hΓ, hxU⟩]
      have h2 := hge Γ hΓ
      rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h2
      have h3 := ord_add_coeff_nonneg (hVs hgV) hg0 Γ
      omega
  change P.valuationOver μ _ = 1 at h1
  have h4 := (hF P).1 g hgV
  rw [hval Z] at h1
  have h5 : P.valuationOver μ g * WithZero.exp (-Dμ.coeff P) ≤
      WithZero.exp (Dμ.coeff P - F.coeff P) * WithZero.exp (-Dμ.coeff P) :=
    mul_le_mul_left h4 _
  rw [h1, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp] at h5
  omega

end Fixed

/-! ### The adjoint ideal of a linear series by orders along all divisors over `X` -/

section SeriesMain

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The valuative condition at a divisor `G` over `X` with `a = a(G, X, Δ)`: some nonzero
`g' ∈ V` and some integer `w` bounding `ord_G(g') + ord_G(D)` from above (through every local
equation of `D` near the centre of `G`) give `v_G(g) ≤ exp (⌈a - c w⌉ - 1 + [a = 0])`. -/
private def SeriesCond (D : Divisor X) (V : Set X.functionField) (c : ℚ) (G : DivisorOver k sX)
    (a : ℝ) (g : X.functionField) : Prop :=
  ∃ g' ∈ V, g' ≠ 0 ∧ ∃ w : ℤ,
    (∀ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      D.IsLocalEquation U φ → G.f G.E.genericPoint ∈ U →
      WithZero.exp (-w) ≤ G.valuation (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X))) ∧
    G.valuation g ≤ WithZero.exp (⌈a - (c : ℝ) * w⌉ - 1 + if a = 0 then 1 else 0)

/-- The sections over `U` of `𝒥_{Δ,cV}` described valuatively: the rational functions satisfying
`SeriesCond` at every divisor over `X` centred in `U`. -/
private def seriesSet (Δ D : Divisor X) (V : Set X.functionField) (c : ℚ) (U : X.Opens) :
    Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (G : DivisorOver k sX) (a : ℝ),
    G.f G.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) G a →
    SeriesCond sX D V c G a g}

/-- **The adjoint ideal of a linear series is computed by orders along all divisors over `X`.**
The sections of `μ_*𝒪_Y(E - ⌊cF⌋)`, for a log resolution `μ` of `Δ` and of the series `V` with
fixed divisor `F`, are the rational functions satisfying the valuative condition
`SeriesCond` at every divisor over `X` centred in the open set. -/
private theorem eq_seriesSet [IsAlgClosed k] [CharZero k] {Δ D : Divisor X}
    {V : AddSubgroup X.functionField} {c : ℚ} {Y : Scheme.{0}} {μ : Y ⟶ X}
    {J : X.Opens → Set X.functionField}
    (h : IsSeriesAdjointIdealOn sX Δ D V c μ J) : J = seriesSet sX Δ D V c := by
  classical
  obtain ⟨hX, hsm, hΔ, hDc, hVs, hVns, hc, _, _, _, _, hY, hμ, hD, Dμ, F, Γ, E, hDμ,
    ⟨hlog, hfix, hfree, hsncF⟩, hΓ, hE, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hsncF
  set G := E - MMP.Intersection.WeilRDivisor.roundDown ((c : ℝ) • Divisor.toRDivisor F)
    with hGdef
  have hc0 : (0 : ℝ) ≤ c := by exact_mod_cast hc
  set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have hVs' : (V : Set X.functionField) ⊆ sectionsIn D := hVs
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ a₀ : ℕ,
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        G.coeff P = ⌈(a₀ : ℝ) - c * F.coeff P⌉ - 1 +
          (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → F.coeff P = 0) ∧ (P ∉ s → a₀ = 1 ∧ F.coeff P = 0) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hF0 : 0 ≤ F.coeff P :=
      coeff_nonneg_of_isFixedDivisorOfPullback hDc hVs' hDμ hfix P hY hμ
    refine ⟨a₀, ha₀r, ?_, ?_, ?_⟩
    · have hΓP := coeff_eq_ite_of_isZeroLogDiscrepancyDivisor sX hΓ ha₀r
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊(c : ℝ) * F.coeff P⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - c * F.coeff P⌉ := by
        have e : (c : ℝ) * F.coeff P = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - c * F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ
        (fun x hx => closure_subset_baseLocusIn hx) hVns (F := FP) (by simpa using ha₀r)
      exact le_antisymm (coeff_nonpos_of_notMem_baseLocusIn hDc hVs' hDμ hfix P hY hμ hx) hF0
    · intro hPs
      have hPmem : P.genericPoint ∈ P.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
        intro hz
        obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
        exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
      rw [hs, Closeds.coe_sup, Closeds.coe_sup, Set.mem_union, Set.mem_union, not_or,
        not_or] at hnot
      obtain ⟨⟨hexc, hsuppΔ⟩, hsuppF⟩ := hnot
      have hsuppΔ' : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
          (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
        intro hmem
        apply hsuppΔ
        obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
        refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
        rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
        exact_mod_cast hΓ'
      have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hlog.isProper
        (Divisor.toQDivisor Δ) P hexc hsuppΔ'
      rw [QDivisor.toRDivisor_toQDivisor] at h1
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h1
      refine ⟨by exact_mod_cast this, ?_⟩
      by_contra hne
      exact hsuppF (DivisorWithCoeffs.support_subset_supp hne hPmem)
  funext U
  ext g
  constructor
  · /- `J ⊆ seriesSet`: the comparison along a model of the divisor on `Y`. -/
    rintro ⟨hg0, hgP⟩
    refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a hx ha => ?_⟩
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
    obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hlog.isProper hμ hY F₀
    set y := F'.f F'.E.genericPoint with hy
    have hyU : y ∈ μ ⁻¹ᵁ U := by
      show μ y ∈ U
      rw [hcen]; exact hx
    have hnY : topologicalKrullDim Y = n :=
      (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
        hn
    have hval' : ∀ t, F₀.valuation t = F'.valuation (functionFieldMap μ t) := fun t => by
      rw [hval]; rfl
    obtain ⟨g', hg'V, hg'0, hfr⟩ := hfree y
    have := F'.isLocallyNoetherian
    have := F'.isNormal
    have := F'.isIntegral
    have := F'.isBirationalMorphism.isDominant
    have : CompactSpace F'.Y :=
      (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
    have hFc : F.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    have hBF := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f F
    obtain ⟨F'', hF''⟩ := hFc.exists_isPullback hBF
    refine ⟨g', hg'V, hg'0, F''.coeff F'.E, ?_, ?_⟩
    · /- `w = ord_{F'}(F)` bounds `ord(g') + ord(D)`, by freeness at the centre. -/
      intro U' φ Z hφ hxU'
      rw [hval']
      set t := functionFieldMap μ (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X)) with htdef
      have ht0 : t ≠ 0 := (map_ne_zero _).mpr (mul_ne_zero hg'0 (evalFF_ne_zero Z φ))
      have hnegc : ((-1 : ℤ) • F).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
      have hBn := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
        ((-1 : ℤ) • F)
      have hpn := hF''.zsmul hFc (-1) hBn
      have hle := valuation_le_exp_of_isPullback (F := F') hnegc (g := t⁻¹) (fun Γ' hΓ' => by
          have hsp : Γ'.genericPoint ⤳ y := by
            rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
            exact hΓ'
          have hμΓ : μ Γ'.genericPoint ∈ U' :=
            (hsp.map μ.continuous).mem_open U'.isOpen (by show μ y ∈ U'; rw [hcen]; exact hxU')
          have e1 : Γ'.divisorialValuation t = WithZero.exp (-F.coeff Γ') := by
            rw [htdef, ← MMP.Mori.PrimeDivisor.valuationOver_apply, Valuation.map_mul,
              hfr Γ' hΓ', valuationOver_evalFF_eq hDμ hφ Γ' hμΓ Z, ← WithZero.exp_add]
            congr 1; ring
          rw [map_inv₀, e1, DivisorWithCoeffs.coeff_smul, smul_eq_mul, ← WithZero.exp_neg]
          simp) _ hBn hpn
      rw [map_inv₀, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at hle
      have hpos : 0 < F'.valuation t := by
        rw [zero_lt_iff]; exact (map_ne_zero _).mpr ht0
      have := (inv_le_comm₀ hpos (zero_lt_iff.mpr WithZero.exp_ne_zero)).mp hle
      rw [← WithZero.exp_neg] at this
      simpa using this
    · /- the valuation bound -/
      rcases eq_or_ne g 0 with rfl | hgne
      · simp
      obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
      obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
      have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
        ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
      obtain ⟨B₀, hB₀⟩ :=
        (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
      have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
        (Or.inl hB₀)).2 F' F₀ hval
      obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
      have ha₀c : a = 1 + c₀ :=
        MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc₀
          (by rwa [QDivisor.toRDivisor_toQDivisor])
      have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
        ((hcr0 c₀).2 hc₀) hF'p
      obtain ⟨t, e, he0, hlin, hpull⟩ :=
        exists_isLogDiscrepancy_and_coeff_eq_sum hY hsmY hnY hsnc F' hF'p
      choose a₀P ha₀P hGP hzP houtP using hcoef n hn
      -- the crepant boundary in terms of the coefficients
      have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
        intro Q
        have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
          hlog.isProper
        rw [QDivisor.toRDivisor_toQDivisor] at hl
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
        push_cast at this
        linarith
      have hA₀ : a = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
        rw [ha₀c, MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0
          (hlin (fun P => -(a₀P P : ℝ)) _
            (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
            (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp))]
        simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
      -- `ord_{F'}(F) = ∑ F_P e_P`
      have hFe : F''.coeff F'.E = ∑ P ∈ s, F.coeff P * e P :=
        hpull F (fun Q hQ => (houtP Q hQ).2) F'' hBF hF''
      -- `v_F(g) ≤ exp (∑ G_P e_P)`
      have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
      have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
      obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
      have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
        (fun Γ hΓ => by
          rw [DivisorWithCoeffs.coeff_neg, neg_neg]
          exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
      have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
        intro Q hQ
        rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
        simp
      have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by
        rw [hpull (-G) (fun Q hQ => by rw [DivisorWithCoeffs.coeff_neg, hG0 Q hQ, neg_zero]) G'
          hBG hG']
        simp only [DivisorWithCoeffs.coeff_neg, neg_mul, Finset.sum_neg_distrib]
      rw [hval']
      refine hR.trans ?_
      rw [hGe', neg_neg, WithZero.exp_le_exp]
      refine sum_mul_le_ceil s a₀P (fun P => (a₀P P : ℝ) - c * F.coeff P) e
        (fun P => G.coeff P) t he0 (fun P _ h0 => by simp [h0, hzP P h0])
        (fun P _ => hGP P) hA₀ ?_
      rw [hFe, hA₀]
      push_cast
      rw [Finset.mul_sum, add_sub_assoc, ← Finset.sum_sub_distrib]
      congr 1
      refine Finset.sum_congr rfl fun P _ => ?_
      ring
  · /- `seriesSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ((preimage_eq_bot_iff μ U).1 hU), fun P hP => ?_⟩
    have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    obtain ⟨n, a, hla, -⟩ := hE P
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
    obtain ⟨a₀, ha₀, hGP, -, -⟩ := hcoef n hn P
    obtain ⟨g', hg'V, -, w, hw, hv⟩ := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ hxU ha₀
    obtain ⟨U', φ, hφ, hxU', hvalφ⟩ := valuationOver_mul_evalFF hDμ hDc P g'
    have h1 := hw U' φ Z₀ hφ hxU'
    change _ ≤ P.valuationOver μ _ at h1
    rw [hvalφ Z₀] at h1
    have h2 := (hfix P).1 g' hg'V
    have h3 : WithZero.exp (-w) ≤ WithZero.exp (-F.coeff P) := by
      refine h1.trans ((mul_le_mul_left h2 _).trans_eq ?_)
      rw [← WithZero.exp_add]
      congr 1; ring
    rw [WithZero.exp_le_exp] at h3
    change P.valuationOver μ g ≤ _ at hv
    rw [hGP]
    refine hv.trans (WithZero.exp_le_exp.mpr ?_)
    have hFw : (F.coeff P : ℝ) ≤ w := by exact_mod_cast (show F.coeff P ≤ w by omega)
    have : ⌈(a₀ : ℝ) - c * w⌉ ≤ ⌈(a₀ : ℝ) - c * F.coeff P⌉ :=
      Int.ceil_mono (by nlinarith)
    omega

end SeriesMain

section SeriesOps

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsNormal X] in
/-- `v_z(a b⁻¹) = v_z(a) - v_z(b)`. -/
private theorem ord_mul_inv {a b : X.functionField} (ha : a ≠ 0) (hb : b ≠ 0) (z : X) :
    X.ord (a * b⁻¹) z = X.ord a z - X.ord b z := by
  rw [← zpow_neg_one b, Scheme.ord_mul ha (zpow_ne_zero _ hb), MMP.Mori.ord_zpow _ hb]
  ring

/-- **Passing to a multiple of the series.** If `g ^ m ∈ V'` for every `g ∈ V`, the
valuative description for `(D, V, c)` is contained in the one for `(mD, V', c/m)`. -/
private theorem seriesSet_subset_nsmul {Δ D : Divisor X} {V V' : Set X.functionField} {c : ℚ}
    {m : ℕ} (hm : 0 < m) (hDc : D.IsCartier) (hV : ∀ g ∈ V, g ^ m ∈ V') (U : X.Opens) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ ((m : ℤ) • D) V' (c / m) U := by
  rintro g ⟨hg0, hg⟩
  refine ⟨hg0, fun n G a hx ha => ?_⟩
  obtain ⟨g', hg'V, hg'0, w, hw, hv⟩ := hg n G a hx ha
  refine ⟨g' ^ m, hV _ hg'V, pow_ne_zero _ hg'0, m * w, fun U' φ' Z hφ' hxU' => ?_, ?_⟩
  · obtain ⟨U'', hxU'', φ, hφ⟩ := hDc (G.f G.E.genericPoint)
    have h1 := hw U'' φ Z hφ hxU''
    have hφm := hφ.zsmul (m : ℤ)
    rw [zpow_natCast] at hφm
    set e := MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)
    set e' := MMP.Threefold.Mori.Helpers.evalFF Z (φ' : MMP.Mori.RationalFunctions X)
    have he : e ≠ 0 := evalFF_ne_zero Z φ
    have he' : e' ≠ 0 := evalFF_ne_zero Z φ'
    have hem : MMP.Threefold.Mori.Helpers.evalFF Z ((φ ^ m : (MMP.Mori.RationalFunctions X)ˣ) :
        MMP.Mori.RationalFunctions X) = e ^ m := by
      rw [Units.val_pow_eq_pow_val, map_pow]
    have hu : G.valuation (e' * (e ^ m)⁻¹) = 1 := by
      refine valuation_eq_one_of_forall_ord_eq_zero G (mul_ne_zero he' (inv_ne_zero
        (pow_ne_zero _ he))) fun Γ hΓ => ?_
      rw [ord_mul_inv he' (pow_ne_zero _ he), ord_evalFF_of_isLocalEquation hφ' Z Γ ⟨_, hΓ, hxU'⟩,
        ← hem, ord_evalFF_of_isLocalEquation hφm Z Γ ⟨_, hΓ, hxU''⟩]
      ring
    have e2 : g' ^ m * e' = (g' * e) ^ m * (e' * (e ^ m)⁻¹) := by
      field_simp
      ring
    have e3 : WithZero.exp (-((m : ℤ) * w)) = WithZero.exp (-w) ^ m := by
      rw [← WithZero.exp_nsmul]
      congr 1
      simp
    rw [e2, Valuation.map_mul, hu, mul_one, Valuation.map_pow, e3]
    exact pow_le_pow_left₀ zero_le' h1 m
  · have e1 : ((c / m : ℚ) : ℝ) * (((m : ℤ) * w : ℤ) : ℝ) = (c : ℝ) * w := by
      have : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
      push_cast
      field_simp
    rw [e1]
    exact hv

/-- **Antitonicity in the boundary and the coefficient.** For `Δ ≤ Δ'` reduced snc and
`0 ≤ c ≤ c'`, the valuative description for `(Δ', c')` is contained in the one for `(Δ, c)`. -/
private theorem seriesSet_anti (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {Δ Δ' D : Divisor X} (hΔ : IsReducedSNC sX Δ) (hΔ' : IsReducedSNC sX Δ') (hle : Δ ≤ Δ')
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (hDc : D.IsCartier) {c c' : ℚ}
    (hc : 0 ≤ c) (hcc : c ≤ c') [IsAlgClosed k] [CharZero k] (U : X.Opens) :
    seriesSet sX Δ' D V c' U ⊆ seriesSet sX Δ D V c U := by
  rintro g ⟨hg0, hg⟩
  refine ⟨hg0, fun n G a hx ha => ?_⟩
  have := G.isLocallyNoetherian
  have := G.isNormal
  have := G.isIntegral
  have := G.isBirationalMorphism.isDominant
  have : CompactSpace G.Y := (G.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hC₁ : Divisor.IsCartier (Δ' - Δ) := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hB₁ := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp G.f (Δ' - Δ)
  obtain ⟨C₁', hC₁'⟩ := hC₁.exists_isPullback hB₁
  have hc1 : 0 ≤ C₁'.coeff G.E := coeff_isPullback_nonneg hC₁ (fun Γ _ => by
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_apply]
    linarith [hle Γ]) C₁' hB₁ hC₁'
  have ha' := isLogDiscrepancy_add_smul ha hC₁ 1 C₁' hB₁ hC₁'
  have e1 : Divisor.toRDivisor Δ + (1 : ℝ) • Divisor.toRDivisor (Δ' - Δ) =
      Divisor.toRDivisor Δ' := by
    rw [one_smul, map_sub]; abel
  rw [e1] at ha'
  obtain ⟨g', hg'V, hg'0, w, hw, hv⟩ := hg n G _ hx ha'
  refine ⟨g', hg'V, hg'0, w, hw, hv.trans (WithZero.exp_le_exp.mpr ?_)⟩
  have hw0 := nonneg_of_forall_exp_neg_le _ hDc (hVs hg'V) hw
  obtain ⟨p, hp⟩ :=
    MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
  obtain ⟨p', hp'⟩ :=
    MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ'.1 hΔ'.2 ha'
  have key := ceil_add_ite_le_of_le (a := a - c * w) hp hp' (by exact_mod_cast hc1)
    (c₂ := ((c' : ℝ) - c) * w) (mul_nonneg (by exact_mod_cast sub_nonneg.mpr hcc)
      (by exact_mod_cast hw0))
  rw [show a - 1 * (C₁'.coeff G.E : ℝ) - (c' : ℝ) * w =
    a - c * w - 1 * (C₁'.coeff G.E : ℝ) - ((c' : ℝ) - c) * w by ring]
  exact key

/-- **The valuative description consists of regular functions.** -/
private theorem seriesSet_subset_range [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ D : Divisor X} (hΔ : IsReducedSNC sX Δ)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (hDc : D.IsCartier) {c : ℚ}
    (hc : 0 ≤ c) (U : X.Opens) [Nonempty U] :
    seriesSet sX Δ D V c U ⊆ Set.range (X.germToFunctionField U) := by
  intro g hg
  rcases eq_or_ne g 0 with rfl | hg0
  · exact ⟨0, map_zero _⟩
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  refine (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord U hg0).mpr
    fun Q hQ => ?_
  have hxU : (DivisorOver.ofPrimeDivisor k hX Q).f
      (DivisorOver.ofPrimeDivisor k hX Q).E.genericPoint ∈ U :=
    MMP.Intersection.genericPoint_mem_of_support_inter_nonempty Q hQ
  have h0 := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn (Divisor.toQDivisor Δ) Q
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  obtain ⟨g', hg'V, -, w, hw, hv⟩ := hg.2 n _ _ hxU h0
  have hw0 := nonneg_of_forall_exp_neg_le _ hDc (hVs hg'V) hw
  rw [valuation_ofPrimeDivisor] at hv
  have hle1 : Q.divisorialValuation g ≤ 1 := by
    refine hv.trans ?_
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]
    refine ceil_sub_one_add_ite_nonpos ?_ ?_
    · rw [Divisor.coeff_toQDivisor]
      rcases hΔ.1 Q with h | h <;> rw [h] <;> norm_num
    · have : (0 : ℝ) ≤ (c : ℝ) * w :=
        mul_nonneg (by exact_mod_cast hc) (by exact_mod_cast hw0)
      linarith
  rw [Q.divisorialValuation_eq_exp_neg_ord hg0, ← WithZero.exp_zero, WithZero.exp_le_exp]
    at hle1
  omega

/-- The valuative description restricts to smaller non-empty opens. -/
private theorem seriesSet_mono_open {Δ D : Divisor X} {V : Set X.functionField} {c : ℚ}
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ D V c W :=
  fun _ hg => ⟨fun h => absurd h hW, fun n G a hx => hg.2 n G a (hWU hx)⟩

/-- **The valuative description is local.** A comparison of two valuative descriptions on the
non-empty affine opens inside `U` gives the comparison on `U`. -/
private theorem seriesSet_subset_of_affine {Δ Δ' D D' : Divisor X} {V V' : Set X.functionField}
    {c c' : ℚ} {U : X.Opens}
    (h : ∀ W : X.affineOpens, (W : X.Opens) ≤ U → Nonempty (W : X.Opens) →
      seriesSet sX Δ D V c W ⊆ seriesSet sX Δ' D' V' c' W) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ' D' V' c' U := by
  intro g hg
  refine ⟨hg.1, fun n G a hx ha => ?_⟩
  obtain ⟨W, hW, hxW, hWU⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) hx
  have hW0 : (W : X.Opens) ≠ ⊥ :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hxW⟩
  exact (h ⟨W, hW⟩ hWU ⟨⟨_, hxW⟩⟩ (seriesSet_mono_open sX hWU hW0 hg)).2 n G a hxW ha

end SeriesOps

section SeriesExtra

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **A free member puts the regular functions in the valuative description.** If a nonzero
member `h` of the series `V` of `L` has `div h + L` meeting no prime divisor through `W`, every
regular function on `W` satisfies the valuative condition for `(0, L, V, c)` on `W`. -/
private theorem mem_seriesSet_of_free [IsAlgClosed k] [CharZero k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {L : Divisor X} {V : Set X.functionField} {c : ℚ}
    {W : X.Opens} [Nonempty W] {h : X.functionField} (hV : h ∈ V) (hh : h ≠ 0)
    (hfree : ∀ P : MMP.Mori.PrimeDivisor X, (P.support ∩ W).Nonempty →
      X.ord h P.genericPoint = -L.coeff P)
    {g : X.functionField} (hg : g ∈ Set.range (X.germToFunctionField W)) :
    g ∈ seriesSet sX 0 L V c W := by
  have hW : W ≠ ⊥ := by
    obtain ⟨⟨x, hx⟩⟩ := ‹Nonempty W›
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x, hx⟩
  refine ⟨fun h0 => absurd h0 hW, fun n G a hx ha => ⟨h, hV, hh, 0, fun U φ Z hφ hxU => ?_, ?_⟩⟩
  · have hmeet : ∀ Γ : MMP.Mori.PrimeDivisor X, G.f G.E.genericPoint ∈ Γ.support →
        (Γ.support ∩ W).Nonempty ∧ (Γ.support ∩ U).Nonempty := fun Γ hΓ =>
      ⟨⟨_, hΓ, hx⟩, ⟨_, hΓ, hxU⟩⟩
    rw [neg_zero, WithZero.exp_zero]
    refine (valuation_eq_one_of_forall_ord_eq_zero G (mul_ne_zero hh (evalFF_ne_zero Z φ))
      fun Γ hΓ => ?_).ge
    rw [Scheme.ord_mul hh (evalFF_ne_zero Z φ), hfree Γ (hmeet Γ hΓ).1,
      ord_evalFF_of_isLocalEquation hφ Z Γ (hmeet Γ hΓ).2]
    ring
  · haveI : LocallyOfFinitePresentation sX :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr
        hX.1.toLocallyOfFiniteType
    have hΔ : IsReducedSNC sX (0 : Divisor X) := ⟨fun P => Or.inl rfl,
      DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sX hsm⟩
    obtain ⟨a₀, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm
      hΔ.1 hΔ.2 ha
    have hv : G.valuation g ≤ 1 := by
      rcases eq_or_ne g 0 with rfl | hg0
      · simp
      refine valuation_le_one_of_forall_ord_nonneg G fun Γ hΓ => ?_
      exact (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord W hg0).mp hg Γ
        ⟨_, hΓ, hx⟩
    refine hv.trans ?_
    rw [← WithZero.exp_zero, WithZero.exp_le_exp, Int.cast_zero, mul_zero, sub_zero,
      Int.ceil_natCast]
    split_ifs with h0
    · simp
    · have : (a₀ : ℤ) ≠ 0 := by exact_mod_cast fun h' => h0 (by rw [h']; simp)
      omega

/-- `g ∈ H⁰(mD)` gives `g ^ N ∈ H⁰(NmD)`. -/
private theorem pow_mem_sectionsIn {D : Divisor X} {g : X.functionField} (hg : g ∈ sectionsIn D)
    (N : ℕ) : g ^ N ∈ sectionsIn ((N : ℤ) • D) := by
  intro P
  rw [map_pow, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
  calc P.divisorialValuation g ^ N ≤ WithZero.exp (D.coeff P) ^ N :=
        pow_le_pow_left₀ zero_le' (hg P) N
    _ = WithZero.exp (N • D.coeff P) := by rw [WithZero.exp_nsmul]
    _ = WithZero.exp ((N : ℤ) * D.coeff P) := by rw [nsmul_eq_mul]

/-- **Asymptotic monotonicity for complete series**: `𝒥_{0,‖(m+1)L‖} ⊆ 𝒥_{0,‖mL‖}`. A member of
`|p(m+1)L|` raised to the power `mb'` lies in `|p'mL|` for `p' = p(m+1)b'`, and the coefficient
`1/p'` is at most `1/(pmb')`. -/
private theorem asy_completeSeries_succ_subset [IsAlgClosed k] [CharZero k] {Z : Scheme.{0}}
    (f : X ⟶ Z) {L : Divisor X} {m b b' : ℕ} {I I' : X.Opens → Set X.functionField}
    (hI : IsAsymptoticAdjointIdeal sX f 0 (((m + 1 : ℕ) : ℤ) • L)
      (completeSeries (((m + 1 : ℕ) : ℤ) • L)) b 1 I)
    (hI' : IsAsymptoticAdjointIdeal sX f 0 ((m : ℤ) • L) (completeSeries ((m : ℤ) • L)) b' 1 I') :
    ∀ U, I U ⊆ I' U := by
  intro U g hg
  by_cases hU : U = ⊥
  · subst hU; rw [asy_bot hI g hg]; exact asy_zero_bot hI'
  have hI0 := hI
  obtain ⟨-, -, hX, hsm, hΔ0, hLc, -, -, -, -, -, Jp, hJp, hJ⟩ := hI0
  obtain ⟨-, -, -, -, -, hLc', -, hb', -, -, -, Jp', hJp', hJ'⟩ := hI'
  refine (hJ' U g).2 ⟨fun h => absurd h hU, fun x hx => ?_⟩
  obtain ⟨W, hxW, hWU, p, hp, hbp, hgW⟩ := ((hJ U g).1 hg).2 x hx
  obtain ⟨Y, μ, hon⟩ := hJp p hp hbp
  rw [eq_seriesSet sX hon] at hgW
  haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
  have hp' : 0 < p * (m + 1) * b' := Nat.mul_pos (Nat.mul_pos hp (Nat.succ_pos m)) hb'
  have hb'p' : b' ∣ p * (m + 1) * b' := ⟨p * (m + 1), by ring⟩
  refine ⟨W, hxW, hWU, p * (m + 1) * b', hp', hb'p', ?_⟩
  obtain ⟨Y', μ', hon'⟩ := hJp' _ hp' hb'p'
  rw [eq_seriesSet sX hon']
  have hVs : ∀ q : ℕ, ∀ M : Divisor X, ((completeSeries M q : AddSubgroup X.functionField) :
      Set X.functionField) ⊆ sectionsIn ((q : ℤ) • M) := fun q M _ hv => hv
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · have hreg := seriesSet_subset_range sX hX hsm hΔ0 (hVs p _) (hLc.zsmul p)
      (by positivity) W hgW
    refine mem_seriesSet_of_free sX hX hsm (h := 1) ?_ one_ne_zero (fun P _ => ?_) hreg
    · change (1 : X.functionField) ∈ sectionsIn _
      intro P
      simp
    · simp [ord_one']
  · have hN : 0 < m * b' := Nat.mul_pos hm hb'
    have h1 := seriesSet_subset_nsmul sX hN (hLc.zsmul p)
      (V := (completeSeries (((m + 1 : ℕ) : ℤ) • L) p : Set X.functionField))
      (V' := (completeSeries ((m : ℤ) • L) (p * (m + 1) * b') : Set X.functionField))
      (fun v hv => by
        have := pow_mem_sectionsIn (hVs p _ hv) (m * b')
        change v ^ (m * b') ∈ sectionsIn _
        convert this using 2
        rw [smul_smul, smul_smul, smul_smul]
        congr 1
        push_cast; ring) W hgW
    have e1 : (((m * b' : ℕ) : ℤ)) • ((p : ℤ) • (((m + 1 : ℕ) : ℤ) • L)) =
        ((p * (m + 1) * b' : ℕ) : ℤ) • ((m : ℤ) • L) := by
      rw [smul_smul, smul_smul, smul_smul]
      congr 1
      push_cast; ring
    rw [e1] at h1
    refine seriesSet_anti sX hX hsm hΔ0 hΔ0 le_rfl (hVs _ _) (hLc'.zsmul _)
      (by positivity) ?_ W h1
    have hp0 : (0 : ℚ) < p := by exact_mod_cast hp
    have hm0 : (0 : ℚ) < m := by exact_mod_cast hm
    have hb0 : (0 : ℚ) < b' := by exact_mod_cast hb'
    rw [div_div]
    push_cast
    apply div_le_div_of_nonneg_left zero_le_one (by positivity)
    nlinarith

end SeriesExtra

section Resolution

open MMP.Resolution

/-! ### Topology -/

/-- On an irreducible space, the generic point lies in every nonempty open. -/
private theorem genericPoint_mem_of_nonempty {X : Scheme.{0}} [IrreducibleSpace X] (V : X.Opens)
    (hV : (V : Set X).Nonempty) : genericPoint X ∈ V :=
  ((genericPoint_spec X).mem_open_set_iff V.isOpen).2 (by simpa using hV)

/-- A union of two closed sets of pure codimension one is of pure codimension one. -/
private theorem isPureCodimOne_sup {T : Type*} [TopologicalSpace T] {S S' : Closeds T}
    (hS : IsPureCodimOne S) (hS' : IsPureCodimOne S') : IsPureCodimOne (S ⊔ S') := by
  intro W hW
  have hsub : (W : Set T) ⊆ (S : Set T) ∪ S' := by simpa using hW.prop
  rcases (isPreirreducible_iff_isClosed_union_isClosed.1 W.isIrreducible.isPreirreducible)
    _ _ S.isClosed S'.isClosed hsub with h | h
  · exact hS W ⟨h, fun W' hW' hle => hW.2 (hW'.trans (by simp)) hle⟩
  · exact hS' W ⟨h, fun W' hW' hle => hW.2 (hW'.trans (by simp)) hle⟩

/-! ### Isomorphisms over opens and biregular loci -/

/-- A morphism which is an isomorphism over a nonempty open has points over it. -/
private theorem nonempty_preimage_of_isIso_restrict {X Y : Scheme.{0}} (g : Y ⟶ X) (V : X.Opens)
    [IsIso (g ∣_ V)] (hV : (V : Set X).Nonempty) : ((g ⁻¹ᵁ V : Y.Opens) : Set Y).Nonempty := by
  obtain ⟨x, hx⟩ := hV
  exact ⟨((inv (g ∣_ V)) ⟨x, hx⟩).1, ((inv (g ∣_ V)) ⟨x, hx⟩).2⟩

/-- On an irreducible scheme, the generic point lies over every nonempty open over which a
morphism is an isomorphism. -/
private theorem genericPoint_mem_preimage {X Y : Scheme.{0}} [IrreducibleSpace Y] (g : Y ⟶ X)
    (V : X.Opens) [IsIso (g ∣_ V)] (hV : (V : Set X).Nonempty) :
    genericPoint Y ∈ g ⁻¹ᵁ V :=
  genericPoint_mem_of_nonempty _ (nonempty_preimage_of_isIso_restrict g V hV)

/-- A morphism of irreducible schemes which is an isomorphism over a nonempty open is
birational. -/
private theorem isBirationalMorphism_of_isIso_restrict {X Y : Scheme.{0}} [IrreducibleSpace X]
    [IrreducibleSpace Y] (g : Y ⟶ X) (V : X.Opens) [IsIso (g ∣_ V)]
    (hV : (V : Set X).Nonempty) : IsBirationalMorphism g := by
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE g _ _
    (nonempty_preimage_of_isIso_restrict g V hV) hV le_rfl ?_
  rwa [Scheme.Hom.resLE_eq_morphismRestrict]

/-- A composite of isomorphisms over `V` and over its inverse image is an isomorphism over `V`. -/
private theorem isIso_restrict_comp {X Y W : Scheme.{0}} (h : W ⟶ Y) (g : Y ⟶ X) (V : X.Opens)
    [IsIso (g ∣_ V)] [IsIso (h ∣_ g ⁻¹ᵁ V)] : IsIso ((h ≫ g) ∣_ V) := by
  rw [morphismRestrict_comp]
  exact @IsIso.comp_isIso _ _ _ _ _ _ _ ‹_› ‹_›

/-- The biregular locus of a morphism from a smooth scheme lies in the smooth locus. -/
private theorem biregularLocus_le_smoothLocus {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (f : Y ⟶ X) [LocallyOfFiniteType (f ≫ sX)]
    (hY : IsSmoothScheme (f ≫ sX)) : biregularLocus f ≤ smoothLocus sX := by
  set V := biregularLocus f
  haveI : IsIso (f ∣_ V) := isBiregular_biregularLocus f
  have : LocallyOfFinitePresentation (f ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := f ≫ sX)).mpr inferInstance
  haveI : Smooth (f ≫ sX) := (isSmoothScheme_iff _).1 hY
  haveI h : Smooth ((f ∣_ V) ≫ V.ι ≫ sX) := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
    infer_instance
  have e : V.ι ≫ sX = inv (f ∣_ V) ≫ ((f ∣_ V) ≫ V.ι ≫ sX) := by simp
  refine le_smoothLocus _ ?_
  rw [e]
  infer_instance

/-- The inverse image of the smooth locus under a morphism which is an isomorphism over an open
`V ⊆ X_sm` contains the inverse image of `V`. -/
private theorem preimage_le_smoothLocus {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] (q : Y ⟶ X) (V : X.Opens) [IsIso (q ∣_ V)]
    (hV : V ≤ smoothLocus sX) : q ⁻¹ᵁ V ≤ smoothLocus (q ≫ sX) := by
  have : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : Smooth (V.ι ≫ sX) := by
    rw [← Scheme.Hom.smoothLocus_eq_top_iff, ← Scheme.Hom.preimage_smoothLocus_eq,
      ← smoothLocus_eq_smoothLocus]
    exact top_le_iff.1 fun x _ => hV x.2
  refine le_smoothLocus _ ?_
  rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  infer_instance

/-- **Composing on the source does not enlarge the biregular locus.** Let `g : Y₂ ⟶ X` be
separated, with `Y₂` reduced and irreducible and `g` an isomorphism over an open with nonempty
inverse image. If `h ≫ g` is an isomorphism over `W`, so is `g`. -/
private theorem biregularLocus_comp_le {X Y Y₂ : Scheme.{0}} (h : Y ⟶ Y₂) (g : Y₂ ⟶ X)
    [IsSeparated g] [IsReduced Y₂] [IrreducibleSpace Y₂]
    (hne : ((g ⁻¹ᵁ biregularLocus g : Y₂.Opens) : Set Y₂).Nonempty) :
    biregularLocus (h ≫ g) ≤ biregularLocus g := by
  set W := biregularLocus (h ≫ g) with hWdef
  have hW : IsIso ((h ≫ g) ∣_ W) := isBiregular_biregularLocus _
  refine le_biregularLocus (show IsIso (g ∣_ W) from ?_)
  rw [morphismRestrict_comp] at hW
  set a := h ∣_ g ⁻¹ᵁ W with ha
  set b := g ∣_ W with hb
  haveI : IsIso (a ≫ b) := hW
  set s := inv (a ≫ b) ≫ a with hs
  have hsb : s ≫ b = 𝟙 _ := by rw [hs, Category.assoc, IsIso.inv_hom_id]
  set W' : W.toScheme.Opens := W.ι ⁻¹ᵁ biregularLocus g with hW'
  haveI : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
  haveI : IsIso (g ∣_ W.ι ''ᵁ W') := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le g
    (V := biregularLocus g) (by rintro _ ⟨y, hy, rfl⟩; exact hy)
  haveI hc : IsIso (b ∣_ W') := ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
    (morphismRestrictRestrict g W W')).2 (inferInstanceAs (IsIso (g ∣_ W.ι ''ᵁ W')))
  haveI : IsSeparated b := IsZariskiLocalAtTarget.restrict ‹IsSeparated g› W
  set ι := (b ⁻¹ᵁ W').ι with hι
  have hbase : ∀ z : (g ⁻¹ᵁ W).toScheme, W.ι (b z) = g ((g ⁻¹ᵁ W).ι z) := fun z => by
    rw [← Scheme.Hom.comp_apply, hb, morphismRestrict_ι, Scheme.Hom.comp_apply]
  haveI : IsDominant ι := by
    constructor
    have hpre : IsPreirreducible ((g ⁻¹ᵁ W : Y₂.Opens) : Set Y₂) :=
      (IrreducibleSpace.isIrreducible_univ Y₂).isPreirreducible.open_subset (g ⁻¹ᵁ W).isOpen
        (Set.subset_univ _)
    haveI : PreirreducibleSpace (g ⁻¹ᵁ W).toScheme := Subtype.preirreducibleSpace hpre
    rcases isEmpty_or_nonempty (g ⁻¹ᵁ W).toScheme with hE | hN
    · intro z; exact isEmptyElim z
    · obtain ⟨z₀⟩ := hN
      rw [DenseRange, Scheme.Opens.range_ι]
      refine (b ⁻¹ᵁ W').isOpen.dense ?_
      obtain ⟨y₁, hy₁⟩ := hne
      obtain ⟨y, -, hyW, hyV⟩ := (IrreducibleSpace.isIrreducible_univ Y₂).isPreirreducible _ _
        (g ⁻¹ᵁ W).isOpen (g ⁻¹ᵁ biregularLocus g).isOpen ⟨z₀.1, trivial, z₀.2⟩
        ⟨y₁, trivial, hy₁⟩
      refine ⟨⟨y, hyW⟩, ?_⟩
      have e := hbase ⟨y, hyW⟩
      change W.ι (b _) ∈ biregularLocus g
      rw [e]
      exact hyV
  have hbs : b ≫ s = 𝟙 _ := by
    refine ext_of_isDominant_of_isSeparated b
      (by rw [Category.assoc, hsb, Category.comp_id, Category.id_comp]) ι ?_
    have hrange : Set.range (ι ≫ b ≫ s) ⊆ Set.range ι := by
      rintro _ ⟨z, rfl⟩
      rw [hι, Scheme.Opens.range_ι]
      show b ((ι ≫ b ≫ s) z) ∈ W'
      rw [← Scheme.Hom.comp_apply, Category.assoc, Category.assoc, hsb, Category.comp_id]
      exact z.2
    set m := IsOpenImmersion.lift ι (ι ≫ b ≫ s) hrange with hmdef
    have hm : m ≫ ι = ι ≫ b ≫ s := IsOpenImmersion.lift_fac _ _ _
    have key : ι ≫ b = (b ∣_ W') ≫ W'.ι := (morphismRestrict_ι b W').symm
    have h1 : m ≫ (b ∣_ W') = b ∣_ W' := by
      rw [← cancel_mono W'.ι, Category.assoc, ← key, ← Category.assoc, hm, Category.assoc,
        Category.assoc, hsb, Category.comp_id]
    have h2 : m = 𝟙 _ := by rw [← cancel_mono (b ∣_ W'), h1, Category.id_comp]
    rw [← hm, h2, Category.id_comp, Category.comp_id]
  exact ⟨⟨s, hbs, hsb⟩⟩

/-- If `q` is an isomorphism over `V` and the biregular locus of `g ≫ q` lies in `V`, then `g` is
an isomorphism over the inverse image of the biregular locus of `g ≫ q`. -/
private theorem preimage_biregularLocus_comp_le {W Y X : Scheme.{0}} (g : W ⟶ Y) (q : Y ⟶ X)
    (V : X.Opens) [IsIso (q ∣_ V)] (hV : biregularLocus (g ≫ q) ≤ V) :
    q ⁻¹ᵁ biregularLocus (g ≫ q) ≤ biregularLocus g := by
  set B := biregularLocus (g ≫ q)
  have h : IsIso ((g ≫ q) ∣_ B) := isBiregular_biregularLocus (g ≫ q)
  rw [morphismRestrict_comp] at h
  haveI : IsIso (q ∣_ B) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le q hV
  haveI : IsIso (g ∣_ q ⁻¹ᵁ B) := @IsIso.of_isIso_comp_right _ _ _ _ _ _ (q ∣_ B) _ h
  exact le_biregularLocus this

/-- If `q` is an isomorphism over `V`, a point of `W` over `V` at which `g` is biregular lies over
the biregular locus of `g ≫ q`. -/
private theorem mem_biregularLocus_comp {W Y X : Scheme.{0}} (g : W ⟶ Y) (q : Y ⟶ X)
    (V : X.Opens) [IsIso (q ∣_ V)] (y : Y) (hyV : q y ∈ V) (hy : y ∈ biregularLocus g) :
    q y ∈ biregularLocus (g ≫ q) := by
  set N := q ⁻¹ᵁ V
  set j : N.toScheme ⟶ X := (q ∣_ V) ≫ V.ι with hj
  have hjapp : ∀ z : N.toScheme, j z = q z.1 := fun z => by
    rw [hj, morphismRestrict_ι, Scheme.Hom.comp_apply]; rfl
  set O : X.Opens := j ''ᵁ (N.ι ⁻¹ᵁ biregularLocus g) with hO
  have hOV : O ≤ V := by
    rintro _ ⟨z, -, rfl⟩
    have hz : q z.1 ∈ V := z.2
    exact Eq.mpr (congrArg (· ∈ V) (hjapp z)) hz
  have hqO : q ⁻¹ᵁ O ≤ biregularLocus g := by
    intro y' hy'
    obtain ⟨z, hz, hzy⟩ := hy'
    have hzq : q z.1 = q y' := (hjapp z).symm.trans hzy
    have hy'N : y' ∈ N := by
      show q y' ∈ V
      rw [← hzq]
      exact z.2
    have : z = (⟨y', hy'N⟩ : N.toScheme) :=
      j.isOpenEmbedding.injective (hzy.trans (hjapp ⟨y', hy'N⟩).symm)
    rw [this] at hz
    exact hz
  haveI : IsIso (q ∣_ O) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le q hOV
  haveI : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
  haveI : IsIso (g ∣_ q ⁻¹ᵁ O) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le g hqO
  haveI := isIso_restrict_comp g q O
  refine le_biregularLocus this ⟨⟨y, hyV⟩, hy, ?_⟩
  exact hjapp _

/-- **The exceptional set of a composite.** If `q` is an isomorphism over `V` and `g ≫ q` is
biregular only over `V`, then the exceptional set of `g ≫ q` is the inverse image of `X ∖ V`
together with the exceptional set of `g`. -/
private theorem coe_exceptionalSet_comp {W Y X : Scheme.{0}} (g : W ⟶ Y) (q : Y ⟶ X)
    (V : X.Opens) [IsIso (q ∣_ V)] (hV : biregularLocus (g ≫ q) ≤ V) :
    (exceptionalSet (g ≫ q) : Set W) = (g ≫ q) ⁻¹' (V.compl : Set X) ∪ exceptionalSet g := by
  ext y
  change q (g y) ∉ biregularLocus (g ≫ q) ↔ q (g y) ∉ V ∨ g y ∉ biregularLocus g
  refine ⟨fun hy => ?_, ?_⟩
  · by_contra hc
    push Not at hc
    exact hy (mem_biregularLocus_comp g q V (g y) hc.1 hc.2)
  · rintro (hy | hy) hy'
    · exact hy (hV hy')
    · exact hy (preimage_biregularLocus_comp_le g q V hV hy')

/-- The support of the pulled-back ideal of a closed subset is its inverse image. -/
private theorem coe_support_comap_vanishingIdeal {X Y : Scheme.{0}} (q : Y ⟶ X) (Z : Closeds X) :
    (((Scheme.IdealSheafData.vanishingIdeal Z).comap q).support : Set Y) = q ⁻¹' Z := by
  rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage,
    Scheme.IdealSheafData.coe_support_vanishingIdeal]

/-! ### Invertible ideals -/

/-- In a local domain, a factor of a nonzero principal ideal is a nonzero principal ideal. -/
private theorem exists_eq_span_of_mul_eq_span {R : Type*} [CommRing R] [IsDomain R]
    [IsLocalRing R] {I J : Ideal R} {t : R} (ht : t ≠ 0) (h : I * J = Ideal.span {t}) :
    ∃ a : R, a ≠ 0 ∧ I = Ideal.span {a} := by
  have hmem : ∀ a ∈ I, ∀ b ∈ J, ∃ c, a * b = t * c := fun a ha b hb => by
    have : a * b ∈ Ideal.span {t} := h ▸ Ideal.mul_mem_mul ha hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 this
    exact ⟨c, by rw [← hc, mul_comm]⟩
  have hex : ∃ a ∈ I, ∃ b ∈ J, ∃ u : R, IsUnit u ∧ a * b = t * u := by
    by_contra hne
    push Not at hne
    have hle : I * J ≤ Ideal.span {t} * IsLocalRing.maximalIdeal R := by
      refine Ideal.mul_le.2 fun a ha b hb => ?_
      obtain ⟨c, hc⟩ := hmem a ha b hb
      have hcu : ¬ IsUnit c := fun hu => hne a ha b hb c hu hc
      rw [hc]
      exact Ideal.mem_span_singleton_mul.2 ⟨c, (IsLocalRing.mem_maximalIdeal c).2 hcu, rfl⟩
    rw [h] at hle
    obtain ⟨z, hz, htz⟩ := Ideal.mem_span_singleton_mul.1 (hle (Ideal.mem_span_singleton_self t))
    have hz1 : z = 1 := by
      have : t * (z - 1) = 0 := by rw [mul_sub, htz, mul_one, sub_self]
      exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_left ht)
    exact (IsLocalRing.mem_maximalIdeal z).1 hz (hz1 ▸ isUnit_one)
  obtain ⟨a₀, ha₀, b₀, hb₀, u, hu, hab⟩ := hex
  refine ⟨a₀, fun h0 => ?_, le_antisymm (fun a ha => ?_) (Ideal.span_le.2 (by simpa using ha₀))⟩
  · rw [h0, zero_mul] at hab
    exact (mul_ne_zero ht hu.ne_zero) hab.symm
  · obtain ⟨s, hs⟩ := hmem a ha b₀ hb₀
    have key : t * (a * u) = t * (a₀ * s) := by
      calc t * (a * u) = a * (t * u) := by ring
        _ = a * (a₀ * b₀) := by rw [hab]
        _ = a₀ * (a * b₀) := by ring
        _ = a₀ * (t * s) := by rw [hs]
        _ = t * (a₀ * s) := by ring
    have h2 : a * u = a₀ * s := mul_left_cancel₀ ht key
    rw [Ideal.mem_span_singleton']
    refine ⟨s * ↑hu.unit⁻¹, ?_⟩
    calc s * ↑hu.unit⁻¹ * a₀ = (a₀ * s) * ↑hu.unit⁻¹ := by ring
      _ = (a * u) * ↑hu.unit⁻¹ := by rw [h2]
      _ = a := by rw [mul_assoc, IsUnit.mul_val_inv, mul_one]

/-- **Krull's height theorem, geometric form.** On a locally noetherian scheme, if
`closure {η}` is an irreducible component of the support of `I`, then the coheight of `η` is at
most the number of generators of `I` on any affine open containing `η`. -/
private theorem coheight_le_spanRank_ideal {X : Scheme.{0}} [IsLocallyNoetherian X]
    (I : X.IdealSheafData) {η : X}
    (hη : Maximal (fun s : Set X => IsIrreducible s ∧ s ⊆ (I.support : Set X)) (closure {η}))
    (W : X.affineOpens) (hηW : η ∈ W.1) :
    Order.coheight η ≤ Cardinal.toENat (Submodule.spanRank (I.ideal W)) := by
  have hW : IsAffineOpen W.1 := W.2
  have : IsNoetherianRing Γ(X, W.1) := IsLocallyNoetherian.component_noetherian W
  set x := hW.primeIdealOf ⟨η, hηW⟩ with hx_def
  have hx : hW.fromSpec x = η := hW.fromSpec_primeIdealOf ⟨η, hηW⟩
  have hsupp : ∀ y : Spec Γ(X, W.1),
      hW.fromSpec y ∈ (I.support : Set X) ↔ (I.ideal W : Set Γ(X, W.1)) ⊆ y.asIdeal := by
    intro y
    have hyW : hW.fromSpec y ∈ W.1 := by
      rw [← SetLike.mem_coe, ← hW.range_fromSpec]
      exact ⟨y, rfl⟩
    rw [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem hyW]
    rw [← Set.mem_preimage, hW.fromSpec_preimage_zeroLocus]
    rfl
  have hηsupp : η ∈ (I.support : Set X) := hη.prop.2 (subset_closure rfl)
  have hmin : x.asIdeal ∈ (I.ideal W).minimalPrimes := by
    refine ⟨⟨x.isPrime, (hsupp x).mp (hx ▸ hηsupp)⟩, ?_⟩
    rintro q ⟨hq, hJq⟩ hqx
    let y : Spec Γ(X, W.1) := ⟨q, hq⟩
    have hyx : y ⤳ x := (PrimeSpectrum.le_iff_specializes y x).mp hqx
    have hyη : hW.fromSpec y ⤳ η := hx ▸ hyx.map (hW.fromSpec).continuous
    have hysupp : hW.fromSpec y ∈ (I.support : Set X) := (hsupp y).mpr hJq
    have hcl : closure {hW.fromSpec y} ⊆ closure {η} := by
      refine hη.2 ⟨isIrreducible_singleton.closure, ?_⟩
        (specializes_iff_closure_subset.mp hyη)
      exact (I.support.isClosed.closure_subset_iff).mpr (Set.singleton_subset_iff.mpr hysupp)
    have hηy : η ⤳ hW.fromSpec y := specializes_iff_closure_subset.mpr hcl
    rw [← hx] at hηy
    have hxy : x ⤳ y := hW.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hηy
    exact (PrimeSpectrum.le_iff_specializes x y).mpr hxy
  have hle := Ideal.height_le_spanRank_toENat_of_mem_minimal_primes _ _ hmin
  rwa [idealHeight_eq_coheight _ x,
    show Order.coheight (α := Spec Γ(X, W.1)) x = Order.coheight η from
      (coheight_eq_of_isOpenImmersion (x := x) hW.fromSpec).symm.trans (congrArg _ hx)] at hle

/-- **The support of an effective Cartier divisor is of pure codimension one** (Krull's principal
ideal theorem), on an integral locally noetherian scheme, when it misses the generic point. -/
private theorem isPureCodimOne_support_of_isEffectiveCartierDivisor {X : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] (I : X.IdealSheafData)
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I) (hgen : genericPoint X ∉ I.support) :
    IsPureCodimOne I.support := by
  intro W hW
  set η := W.isIrreducible.genericPoint with hη
  have hηW : closure {η} = (W : Set X) := by
    have := W.isIrreducible.isGenericPoint_genericPoint_closure
    rw [W.isClosed.closure_eq] at this
    exact this
  have hWeq : W = IrreducibleCloseds.closureSingleton η :=
    IrreducibleCloseds.ext (by rw [IrreducibleCloseds.coe_closureSingleton, hηW])
  have hmax : Maximal (fun s : Set X => IsIrreducible s ∧ s ⊆ (I.support : Set X))
      (closure {η}) := by
    rw [hηW]
    refine ⟨⟨W.isIrreducible, hW.prop⟩, fun s ⟨hs, hsI⟩ hWs => ?_⟩
    have hle := hW.2 (y := ⟨closure s, hs.closure, isClosed_closure⟩)
      (closure_minimal hsI I.support.isClosed) (hWs.trans subset_closure)
    exact subset_closure.trans hle
  have hηI : η ∈ (I.support : Set X) := hmax.prop.2 (subset_closure rfl)
  rw [hWeq, Stacks.AlgebraicGeometry.CodimensionOneDivisor.codimension_closureSingleton_eq_coheight]
  obtain ⟨U, hU, hηU, f, -, hf⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor I hI η
  have h1 := coheight_le_spanRank_ideal I hmax ⟨U, hU⟩ hηU
  have hrank : Cardinal.toENat (Submodule.spanRank (I.ideal ⟨U, hU⟩)) ≤ 1 := by
    rw [hf]
    have := Submodule.spanRank_span_le_card (R := Γ(X, U)) ({f} : Set Γ(X, U))
    rw [Cardinal.mk_singleton] at this
    exact (Cardinal.toENat.monotone' this).trans (by simp)
  have h0 : Order.coheight η ≠ 0 := by
    intro h0
    rw [Order.coheight_eq_zero] at h0
    have hle : η ≤ genericPoint X := by
      rw [Scheme.le_iff_specializes]
      exact genericPoint_specializes η
    have h2 := h0 hle
    rw [Scheme.le_iff_specializes] at h2
    exact hgen (h2.mem_closed I.support.isClosed hηI)
  exact le_antisymm (h1.trans hrank) (Order.one_le_iff_pos.2 (pos_iff_ne_zero.2 h0))

/-- On an integral locally noetherian scheme, if `P * Q = R` stalkwise with `R` an effective
Cartier divisor, then `P` is an effective Cartier divisor. -/
private theorem isEffectiveCartierDivisor_of_stalk_mul {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] (P Q R : X.IdealSheafData)
    (hR : Stacks.Divisors.IsEffectiveCartierDivisor R)
    (h : ∀ x, IdealSheafData.stalk P x * IdealSheafData.stalk Q x = IdealSheafData.stalk R x) :
    Stacks.Divisors.IsEffectiveCartierDivisor P := by
  refine isEffectiveCartierDivisor_of_stalk_regular_principal P fun x _ => ?_
  obtain ⟨U, hU, hxU, t, ht, hRt⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor R hR x
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  have hstalk : IdealSheafData.stalk R x = Ideal.span {(X.presheaf.germ U x hxU).hom t} := by
    rw [IdealSheafData.stalk_eq_map_germ _ x ⟨U, hU⟩ hxU, hRt, Ideal.map_span,
      Set.image_singleton]
  have ht0 : (X.presheaf.germ U x hxU).hom t ≠ 0 := by
    intro h0
    refine ht.ne_zero (germ_injective_of_isIntegral X x hxU ?_)
    rw [h0, map_zero]
  obtain ⟨a, ha, hPa⟩ := exists_eq_span_of_mul_eq_span ht0 ((h x).trans hstalk)
  exact ⟨a, IsRegular.of_ne_zero ha, hPa⟩

/-! ### Projectivity -/

/-- A proper morphism from a scheme which immerses into some `ℙⁿ_k` over `k` is H-projective. -/
private theorem isProjectiveMorphism_of_isHQuasiProjective_comp {k : Type} [Field k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) (f : Y ⟶ X) [IsProper f]
    (h : IsHQuasiProjective (f ≫ sX)) : IsProjectiveMorphism f := by
  obtain ⟨n, i, hi, -, hcomm⟩ := h
  have hfst : IsImmersion (Limits.pullback.lift i f hcomm ≫
      Limits.pullback.fst (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) sX) := by
    rw [Limits.pullback.lift_fst]; exact hi
  have hmid : IsImmersion (Limits.pullback.lift i f hcomm) :=
    IsImmersion.of_comp _ (Limits.pullback.fst _ _)
  have hover : (Limits.pullback.lift i f hcomm ≫ (projectiveSpaceOverBaseChangeIso n sX).hom) ≫
      (projectiveSpaceOver n X ↘ X) = f := by
    rw [Category.assoc, projectiveSpaceOverBaseChangeIso_hom_over, Limits.pullback.lift_snd]
  exact isProjectiveMorphism_of_isImmersion_projectiveSpaceOver _ hover

/-! ### Chow's lemma -/

/-- **Chow's lemma for a variety.** A variety `X` over `k` admits a proper morphism `q : X₂ ⟶ X`
from a variety quasi-projective over `k` which is an isomorphism over a nonempty open. -/
private theorem exists_isQuasiProjective_isIso_restrict {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (hX : AlgebraicGeometry.IsVariety k sX) :
    ∃ (X₂ : Scheme.{0}) (q : X₂ ⟶ X) (U : X.Opens), AlgebraicGeometry.IsVariety k (q ≫ sX) ∧
      IsProper q ∧ (U : Set X).Nonempty ∧ IsIso (q ∣_ U) ∧ IsQuasiProjective (q ≫ sX) := by
  haveI : IsIntegral X := hX.toIsIntegral
  haveI := hX.toIsSeparated
  haveI := hX.toLocallyOfFiniteType
  haveI := hX.toQuasiCompact
  obtain ⟨n, X₁, p₁, i, U, hp₁, -, hi, hcomm, hdense, hiso⟩ :=
    AlgebraicGeometry.hasChowModificationIsoOnDenseOpen_of_isAffine sX
  haveI := hiso
  haveI : IsProper p₁ := hp₁
  haveI : IsImmersion i := hi
  haveI : IsLocallyNoetherian X₁ := LocallyOfFiniteType.isLocallyNoetherian (p₁ ≫ sX)
  haveI : CompactSpace X₁ := QuasiCompact.compactSpace_of_compactSpace (p₁ ≫ sX)
  haveI : AlgebraicGeometry.IsNoetherian X₁ := {}
  haveI : Nonempty U := hdense.nonempty.to_subtype
  haveI : Nonempty (p₁ ⁻¹ᵁ U) := ⟨(inv (p₁ ∣_ U)) (Classical.arbitrary U)⟩
  haveI : IsIntegral (p₁ ⁻¹ᵁ U) := isIntegral_of_isOpenImmersion (p₁ ∣_ U)
  have hi1 : IsIso ((p₁ ⁻¹ᵁ U).ι.imageι ∣_ (p₁ ⁻¹ᵁ U)) :=
    Stacks.SchemeTheoreticImage.isIso_imageι_restrict _
  refine ⟨(p₁ ⁻¹ᵁ U).ι.image, (p₁ ⁻¹ᵁ U).ι.imageι ≫ p₁, U, ?_, inferInstance,
    hdense.nonempty, ?_, ?_⟩
  · rw [Category.assoc]
    exact Scheme.Hom.isVariety_image k _ (p₁ ≫ sX)
  · rw [morphismRestrict_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ hi1 hiso
  · refine Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective _
      ⟨n, (p₁ ⁻¹ᵁ U).ι.imageι ≫ i, inferInstance, inferInstance, ?_⟩
    rw [Category.assoc, ← hcomm, Category.assoc]

section SNC

/-- The preimage in a subspace `C` of a preirreducible subset of `C` is preirreducible. -/
private theorem isPreirreducible_preimage_val {Y : Type*} [TopologicalSpace Y] {C W : Set Y}
    (hW : IsPreirreducible W) (hWC : W ⊆ C) : IsPreirreducible (Subtype.val ⁻¹' W : Set C) := by
  rintro u v hu hv ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  obtain ⟨u', hu', rfl⟩ := isOpen_induced_iff.mp hu
  obtain ⟨v', hv', rfl⟩ := isOpen_induced_iff.mp hv
  obtain ⟨y, hyW, hyu, hyv⟩ := hW u' v' hu' hv' ⟨a, ha, hau⟩ ⟨b, hb, hbv⟩
  exact ⟨⟨y, hWC hyW⟩, hyW, hyu, hyv⟩

/-- An irreducible closed set contained in a closed set lies in an irreducible closed subset
maximal in it. -/
private theorem exists_maximal_ge {Y : Type*} [TopologicalSpace Y] {C : Set Y} (hC : IsClosed C)
    (Z : IrreducibleCloseds Y) (hZ : (Z : Set Y) ⊆ C) :
    ∃ W : IrreducibleCloseds Y, Maximal (fun W' : IrreducibleCloseds Y ↦ (W' : Set Y) ⊆ C) W ∧
      Z ≤ W := by
  obtain ⟨t, ht, hxt, hmax⟩ := exists_preirreducible (Subtype.val ⁻¹' (Z : Set Y) : Set C)
    (isPreirreducible_preimage_val Z.isIrreducible.isPreirreducible hZ)
  obtain ⟨z, hz⟩ := Z.isIrreducible.nonempty
  let W : IrreducibleCloseds Y := ⟨closure (Subtype.val '' t),
    (IsIrreducible.closure ⟨⟨z, ⟨z, hZ hz⟩, hxt hz, rfl⟩,
      ht.image _ continuous_subtype_val.continuousOn⟩), isClosed_closure⟩
  have hWC : (W : Set Y) ⊆ C := closure_minimal (by rintro _ ⟨y, -, rfl⟩; exact y.2) hC
  refine ⟨W, ⟨hWC, fun W' hW'C hWW' y hy ↦ ?_⟩, fun y hy ↦ subset_closure ⟨⟨y, hZ hy⟩, hxt hy, rfl⟩⟩
  have := hmax _ (isPreirreducible_preimage_val W'.isIrreducible.isPreirreducible hW'C)
    fun y hy ↦ hWW' (subset_closure ⟨y, hy, rfl⟩)
  have : (⟨y, hW'C hy⟩ : C) ∈ t := by rw [← this]; exact hy
  exact subset_closure ⟨_, this, rfl⟩

/-- The support of a prime divisor, as an irreducible closed subset. -/
private noncomputable def primeIrr {X : Scheme.{0}} (E : AlgebraicGeometry.PrimeDivisor X) :
    IrreducibleCloseds X :=
  IrreducibleCloseds.closureSingleton E.genericPoint

private theorem coe_primeIrr {X : Scheme.{0}} (E : AlgebraicGeometry.PrimeDivisor X) :
    (primeIrr E : Set X) = E.support := by
  rw [E.support_eq_closure]; rfl

private theorem codimension_primeIrr {X : Scheme.{0}} (E : AlgebraicGeometry.PrimeDivisor X) :
    codimension (primeIrr E) = 1 := E.codimension_one

private theorem exists_mem_of_subset_iUnion {X : Scheme.{0}}
    {s : Finset (AlgebraicGeometry.PrimeDivisor X)}
    (W : IrreducibleCloseds X) (hW : (W : Set X) ⊆ ⋃ E ∈ s, E.support) :
    ∃ E ∈ s, W ≤ primeIrr E := by
  classical
  obtain ⟨z, hz, hWz⟩ := (isIrreducible_iff_sUnion_isClosed.mp W.isIrreducible)
    (s.image AlgebraicGeometry.PrimeDivisor.support)
    (by
      intro z hz
      obtain ⟨E, -, rfl⟩ := Finset.mem_image.mp hz
      rw [← coe_primeIrr]; exact (primeIrr E).isClosed)
    (by
      intro x hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.mp (hW hx)
      exact ⟨E.support, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hE), hxE⟩)
  obtain ⟨E, hE, rfl⟩ := Finset.mem_image.mp hz
  exact ⟨E, hE, fun x hx ↦ by
    change x ∈ (primeIrr E : Set X); rw [coe_primeIrr]; exact hWz hx⟩

/-- A closed subset of pure codimension one of an snc divisor is an snc divisor. -/
private theorem isSNCSubset_of_le {k : Type} [Field k] {X : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} {S C : Closeds X}
    (hS : IsSNCSubset sX S) (hC : IsPureCodimOne C) (hCS : C ≤ S) : IsSNCSubset sX C := by
  classical
  rcases hS with rfl | ⟨s, hs, hsnc⟩
  · exact Or.inl (le_bot_iff.mp hCS)
  right
  refine ⟨s.filter (fun E ↦ E.support ⊆ C), ?_, ?_⟩
  · apply subset_antisymm
    · intro x hx
      obtain ⟨E, hE, hxE⟩ := Set.mem_iUnion₂.mp hx
      exact (Finset.mem_filter.mp hE).2 hxE
    · intro x hx
      obtain ⟨W, hW, hxW⟩ := exists_maximal_ge C.isClosed
        (IrreducibleCloseds.closureSingleton x) (by
          change closure {x} ⊆ (C : Set X)
          exact closure_minimal (by simpa using hx) C.isClosed)
      have hxW' : x ∈ (W : Set X) := hxW (subset_closure rfl)
      obtain ⟨E, hE, hWE⟩ := exists_mem_of_subset_iUnion W (hs ▸ hW.1.trans hCS)
      have hWE' : W = primeIrr E := by
        by_contra hne
        have hlt : W < primeIrr E := lt_of_le_of_ne hWE hne
        have := Order.coheight_add_one_le hlt
        rw [← codimension_eq_coheight, ← codimension_eq_coheight, codimension_primeIrr,
          hC W hW] at this
        exact absurd this (by decide)
      refine Set.mem_iUnion₂.mpr ⟨E, Finset.mem_filter.mpr ⟨hE, ?_⟩, ?_⟩
      · rw [← coe_primeIrr, ← hWE']; exact hW.1
      · rw [← coe_primeIrr, ← hWE']; exact hxW'
  · refine hsnc.of_support_subset ?_
    intro E hE
    rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply] at hE ⊢
    simp only [Finsupp.single_apply] at hE ⊢
    rw [Finset.sum_ite_eq'] at hE ⊢
    split_ifs at hE with h1
    · rw [if_pos (Finset.mem_filter.mp h1).1]; exact one_ne_zero
    · exact absurd rfl hE

end SNC

/-- **Projective log resolution with principalization of an ideal.** Let `X` be a normal variety
over an algebraically closed field of characteristic zero, `Δ` an `ℝ`-divisor and `I` an ideal
sheaf whose support misses the generic point. There is a projective log resolution `f` of
`(X, Δ)` such that `I 𝒪_Y` is an effective Cartier divisor and
`Ex(f) ∪ f⁻¹(Supp Δ) ∪ Supp(I 𝒪_Y)` is an snc divisor. -/
private theorem exists_isLogResolution_isEffectiveCartierDivisor_comap' {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} [IsIntegral X] (sX : X ⟶ Spec (.of k))
    (hX : IsNormalVariety k sX) (Δ : RDivisor X) (I : X.IdealSheafData)
    (hI : genericPoint X ∉ I.support) :
    ∃ (Y : Scheme.{0}) (f : Y ⟶ X), MMP.Mori.IsLogResolution sX Δ f ∧ IsProjectiveMorphism f ∧
      Stacks.Divisors.IsEffectiveCartierDivisor (I.comap f) ∧
      IsSNCSubset (f ≫ sX)
        (exceptionalSet f ⊔ Δ.supp.preimage f.continuous ⊔ (I.comap f).support) := by
  obtain ⟨hXv, -⟩ := hX
  haveI := hXv
  haveI : IsIntegral X := hXv.toIsIntegral
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨X₂, q, U, hX₂, hq, hUne, hqU, hqp⟩ := exists_isQuasiProjective_isIso_restrict sX hXv
  haveI := hX₂
  haveI := hq
  haveI := hqU
  haveI : IsIntegral X₂ := hX₂.toIsIntegral
  haveI : IsLocallyNoetherian X₂ := LocallyOfFiniteType.isLocallyNoetherian (q ≫ sX)
  haveI : CompactSpace X₂ := QuasiCompact.compactSpace_of_compactSpace (q ≫ sX)
  haveI : IsIso (q ∣_ biregularLocus q) := isBiregular_biregularLocus q
  set V : X.Opens := biregularLocus q ⊓ smoothLocus sX with hV
  haveI : IsIso (q ∣_ V) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le q inf_le_left
  set O : X.Opens := V ⊓ Δ.supp.compl ⊓ I.support.compl with hO
  haveI : IsIso (q ∣_ O) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le q
    (inf_le_left.trans (inf_le_left.trans inf_le_left))
  have : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  have hgenO : genericPoint X ∈ O := by
    refine ⟨⟨⟨genericPoint_mem_of_nonempty _ (hUne.mono (le_biregularLocus hqU)), ?_⟩, ?_⟩, hI⟩
    · rw [smoothLocus_eq_smoothLocus]
      exact Scheme.Hom.genericPoint_mem_smoothLocus_of_perfectField sX
    · exact MMP.Fourfold.genericPoint_notMem_supp Δ
  have hOne : (O : Set X).Nonempty := ⟨_, hgenO⟩
  set A : X₂.IdealSheafData := (Scheme.IdealSheafData.vanishingIdeal V.compl).comap q
  set B : X₂.IdealSheafData := (Scheme.IdealSheafData.vanishingIdeal Δ.supp).comap q
  set C : X₂.IdealSheafData := I.comap q
  have hAsupp : (A.support : Set X₂) = q ⁻¹' (V.compl : Set X) :=
    coe_support_comap_vanishingIdeal q _
  have hBsupp : (B.support : Set X₂) = q ⁻¹' (Δ.supp : Set X) :=
    coe_support_comap_vanishingIdeal q _
  have hCsupp : (C.support : Set X₂) = q ⁻¹' (I.support : Set X) := by
    rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage]
  have hKsupp : ((A * (B * C)).support : Set X₂) =
      q ⁻¹' (V.compl : Set X) ∪ (q ⁻¹' (Δ.supp : Set X) ∪ q ⁻¹' (I.support : Set X)) := by
    rw [Scheme.IdealSheafData.support_mul, Scheme.IdealSheafData.support_mul, Closeds.coe_sup,
      Closeds.coe_sup, hAsupp, hBsupp, hCsupp]
  have hgen₂ : q (genericPoint X₂) ∈ O := genericPoint_mem_preimage q O hOne
  have hK : A * (B * C) ≠ ⊥ := by
    intro h0
    have h1 : genericPoint X₂ ∈ ((A * (B * C)).support : Set X₂) := by rw [h0]; simp
    rw [hKsupp] at h1
    rcases h1 with h1 | h1 | h1
    · exact h1 hgen₂.1.1
    · exact hgen₂.1.2 h1
    · exact hgen₂.2 h1
  obtain ⟨Y, g, hYv, hgP, -, hgS, hgiso, hcart, hsnc, hpure⟩ :=
    MMP.Resolution.exists_isResolutionOfVariety_isEffectiveCartierDivisor_comap (q ≫ sX) hX₂
      (A * (B * C)) hK
  set f : Y ⟶ X := g ≫ q with hf
  haveI := hYv
  haveI : IsIntegral Y := hYv.toIsIntegral
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ q ≫ sX)
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (g ≫ q ≫ sX)
  have hfs : f ≫ sX = g ≫ q ≫ sX := Category.assoc _ _ _
  haveI : IsProper g := hgP.isProper
  have hqOsm : q ⁻¹ᵁ O ≤ smoothLocus (q ≫ sX) ⊓ (A * (B * C)).support.compl := by
    refine le_inf (fun y hy => preimage_le_smoothLocus sX q V inf_le_right hy.1.1) ?_
    intro y hy h
    have h' : y ∈ ((A * (B * C)).support : Set X₂) := h
    rw [hKsupp] at h'
    rcases h' with h' | h' | h'
    · exact h' hy.1.1
    · exact hy.1.2 h'
    · exact hy.2 h'
  haveI := hgiso
  haveI : IsIso (g ∣_ q ⁻¹ᵁ O) := MMP.Resolution.TupleResolutionAux.isIso_restrict_of_le g hqOsm
  haveI hfO : IsIso (f ∣_ O) := isIso_restrict_comp g q O
  have hsm : IsSmoothScheme (f ≫ sX) := hfs ▸ hgS
  haveI : LocallyOfFiniteType (f ≫ sX) := by rw [hfs]; infer_instance
  have hfV : biregularLocus f ≤ V := le_inf
    (biregularLocus_comp_le g q (nonempty_preimage_of_isIso_restrict q _ ⟨_, hgenO.1.1.1⟩))
    (biregularLocus_le_smoothLocus sX f hsm)
  have hEx : (exceptionalSet f : Set Y) = f ⁻¹' (V.compl : Set X) ∪ exceptionalSet g :=
    coe_exceptionalSet_comp g q V hfV
  -- the factors of the principalized ideal are effective Cartier
  have hstalk : ∀ (P₁ P₂ : X₂.IdealSheafData) (y : Y),
      IdealSheafData.stalk (P₁.comap g) y * IdealSheafData.stalk (P₂.comap g) y =
        IdealSheafData.stalk ((P₁ * P₂).comap g) y := fun P₁ P₂ y => by
    rw [IdealSheafData.stalk_comap (P₁ * P₂) g, Aux.stalk_mul, Ideal.map_mul,
      IdealSheafData.stalk_comap P₁ g, IdealSheafData.stalk_comap P₂ g]
  have hAcart : Stacks.Divisors.IsEffectiveCartierDivisor (A.comap g) :=
    isEffectiveCartierDivisor_of_stalk_mul _ _ _ hcart (hstalk A (B * C))
  have hBCcart : Stacks.Divisors.IsEffectiveCartierDivisor ((B * C).comap g) :=
    isEffectiveCartierDivisor_of_stalk_mul _ _ _ hcart fun y => by
      rw [mul_comm]; exact hstalk A (B * C) y
  have hBcart : Stacks.Divisors.IsEffectiveCartierDivisor (B.comap g) :=
    isEffectiveCartierDivisor_of_stalk_mul _ _ _ hBCcart (hstalk B C)
  have hCcart : Stacks.Divisors.IsEffectiveCartierDivisor (C.comap g) :=
    isEffectiveCartierDivisor_of_stalk_mul _ _ _ hBCcart fun y => by
      rw [mul_comm]; exact hstalk B C y
  have hgenY : f (genericPoint Y) ∈ O := genericPoint_mem_preimage f O hOne
  have hPsupp : ((A.comap g).support : Set Y) = f ⁻¹' (V.compl : Set X) := by
    rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage, hAsupp]; rfl
  have hBYsupp : ((B.comap g).support : Set Y) = f ⁻¹' (Δ.supp : Set X) := by
    rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage, hBsupp]; rfl
  have hgenP : genericPoint Y ∉ (A.comap g).support := by
    intro h
    have h' : genericPoint Y ∈ ((A.comap g).support : Set Y) := h
    rw [hPsupp] at h'
    exact h' hgenY.1.1
  have hgenB : genericPoint Y ∉ (B.comap g).support := by
    intro h
    have h' : genericPoint Y ∈ ((B.comap g).support : Set Y) := h
    rw [hBYsupp] at h'
    exact hgenY.1.2 h'
  have hExeq : exceptionalSet f = (A.comap g).support ⊔ exceptionalSet g :=
    Closeds.ext (by rw [Closeds.coe_sup, hEx, hPsupp])
  have hpureEx : IsPureCodimOne (exceptionalSet f) := by
    rw [hExeq]
    exact isPureCodimOne_sup (isPureCodimOne_support_of_isEffectiveCartierDivisor _ hAcart hgenP)
      hpure
  have hDeq : Δ.supp.preimage f.continuous = (B.comap g).support :=
    Closeds.ext (by rw [Closeds.coe_preimage, hBYsupp])
  have hICeq : (I.comap f).support = (C.comap g).support := by
    rw [hf, Scheme.IdealSheafData.comap_comp]
  have hbig : exceptionalSet f ⊔ Δ.supp.preimage f.continuous ⊔ (I.comap f).support =
      exceptionalSet g ⊔ ((A * (B * C)).comap g).support := by
    refine Closeds.ext ?_
    have hR : (((A * (B * C)).comap g).support : Set Y) =
        g ⁻¹' (q ⁻¹' (V.compl : Set X) ∪ (q ⁻¹' (Δ.supp : Set X) ∪ q ⁻¹' (I.support : Set X))) := by
      rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage, hKsupp]
    have hR' : ((C.comap g).support : Set Y) = g ⁻¹' (q ⁻¹' (I.support : Set X)) := by
      rw [Scheme.IdealSheafData.support_comap, Closeds.coe_preimage, hCsupp]
    rw [Closeds.coe_sup, Closeds.coe_sup, Closeds.coe_sup, hEx, hR, hICeq, hR']
    simp only [Closeds.coe_preimage]
    ext y
    simp only [Set.mem_union, Set.mem_preimage, hf, Scheme.Hom.comp_apply]
    tauto
  have hsncbig : IsSNCSubset (f ≫ sX)
      (exceptionalSet f ⊔ Δ.supp.preimage f.continuous ⊔ (I.comap f).support) := by
    rw [hbig, hfs]; exact hsnc
  have h1 : IsQuasiProjective g := isQuasiProjective_of_isProjective hgP
  have h2 : IsQuasiProjective (f ≫ sX) := by
    rw [hfs]
    exact IsQuasiProjective.comp g (q ≫ sX) h1 hqp
  have h3 := Stacks.HProjective.isHQuasiProjective_of_isQuasiProjective_of_exists_isAmple (f ≫ sX)
    (Stacks.HProjective.exists_isAmple_of_isAffine _) h2
  refine ⟨Y, f, ⟨⟨inferInstance, isBirationalMorphism_of_isIso_restrict f O hOne, hsm⟩, hpureEx,
    ?_⟩, isProjectiveMorphism_of_isHQuasiProjective_comp sX f h3, ?_, hsncbig⟩
  · refine isSNCSubset_of_le hsncbig ?_ le_sup_left
    rw [hDeq]
    exact isPureCodimOne_sup hpureEx
      (isPureCodimOne_support_of_isEffectiveCartierDivisor _ hBcart hgenB)
  · rw [hf, Scheme.IdealSheafData.comap_comp]; exact hCcart

end Resolution

section ExtToolkit

section Restriction

variable {k : Type} [Field k] {X T : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [Smooth sX] (j : T ⟶ X) [IsClosedImmersion j]
  [IsIntegral T] [IsLocallyNoetherian T] [Smooth (j ≫ sX)]

include sX in
/-- **The restriction of a Cartier divisor has the restricted local equation.** Let `S` be a
smooth prime divisor of the smooth `X`, not a component of the Cartier divisor `M`, and `a` a
unit of `𝒪_{X,η_S}` representing a local equation `φ` of `M` on `V`. At every prime divisor `Q`
of `S` with `η_Q ∈ V`, the coefficient of `Q` in `M|_S` is the order of `a|_S`. -/
private theorem coeff_restrictPrimeDivisor_eq_ord (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (a : X.presheaf.stalk (haveI := S.integral;
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))) (ha : IsUnit a)
    (Z : irreducibleComponents X)
    (haφ : algebraMap _ X.functionField a =
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X))
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord ((S.idealSheaf.subschemeι.stalkMap
        (genericPoint S.idealSheaf.subscheme)).hom a) Q.genericPoint := by
  haveI := S.integral
  classical
  have hordE : ∀ E : MMP.Mori.PrimeDivisor X,
      X.ord (algebraMap _ X.functionField a) E.genericPoint = E.ord φ := by
    intro E
    rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, haφ]
    rw [Subsingleton.elim
      (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := X)) Z E.component]
  set s := M.support ∪ (principalDivisor φ).support with hs
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor M S hM Q,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX S.idealSheaf.subschemeι a ha Q s
      (fun E hE => by
        rw [hordE] at hE
        refine Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr ?_)
        rw [← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor]
        exact hE)]
  rw [Finsupp.sum, Finset.sum_subset (Finset.subset_union_left (s₂ := (principalDivisor φ).support))
    (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [hordE, nsmul_eq_mul]
  by_cases hmem : S.idealSheaf.subschemeι Q.genericPoint ∈ E.support
  · rw [← DivisorWithCoeffs.coeff_apply, hφ E ⟨_, hmem, hQ⟩]
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hmem]
    simp

include sX in
/-- `coeff_restrictPrimeDivisor_eq_ord` for a unit at the image of any point `t = η_S` of `S`,
representing the local equation through the component of `X` containing it. -/
private theorem coeff_restrictPrimeDivisor_eq_ord_of_eq (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (t : haveI := S.integral; S.idealSheaf.subscheme)
    (ht : haveI := S.integral; t = genericPoint S.idealSheaf.subscheme)
    (a : (X.presheaf.stalk (haveI := S.integral; S.idealSheaf.subschemeι t))ˣ)
    {W : irreducibleComponents X} (hW : (haveI := S.integral; S.idealSheaf.subschemeι t) ∈ W.1)
    (ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) W)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord (algebraMap (S.idealSheaf.subscheme.presheaf.stalk t)
        S.idealSheaf.subscheme.functionField
        ((S.idealSheaf.subschemeι.stalkMap t).hom a)) Q.genericPoint := by
  haveI := S.integral
  subst ht
  rw [coeff_restrictPrimeDivisor_eq_ord sX S M hM hφ a.val a.isUnit W ?_ Q hQ]
  · congr 1
    change _ = (S.idealSheaf.subscheme.presheaf.stalkSpecializes (specializes_refl _)).hom _
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    rfl
  · change _ = (X.presheaf.stalkSpecializes _).hom ((φ : RationalFunctions X) W)
    rw [← ha]
    change _ = (stalkToRationalFunctions X hW ≫ X.presheaf.stalkSpecializes _).hom a.val
    rw [stalkToRationalFunctions, TopCat.Presheaf.stalkSpecializes_comp]
    rfl

end Restriction

/-! ### Members of linear series and the model of a general member -/

section Construction

variable {k : Type} [Field k]

/-! ### Rational functions and their divisors -/

/-- An element of the local ring at `y` has nonnegative order along every prime divisor
through `y`. -/
private theorem ord_algebraMap_nonneg {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support) (a : Y.presheaf.stalk y)
    (ha : algebraMap (Y.presheaf.stalk y) Y.functionField a ≠ 0) :
    0 ≤ Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField a) P.genericPoint := by
  have hsp : P.genericPoint ⤳ y := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hP
    exact specializes_iff_mem_closure.mpr hP
  rw [← MMP.Mori.algebraMap_stalkSpecializes hsp] at ha ⊢
  set b := (Y.presheaf.stalkSpecializes hsp).hom a
  have hx := P.coheight_genericPoint
  rw [Scheme.le_ord_iff hx ha]
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk P.genericPoint) := krullDimLE_of_coheight_le hx.le
  have hb0 : b ≠ 0 := by rintro hb; simp [hb] at ha
  change _ ≤ Ring.ordFrac (Y.presheaf.stalk P.genericPoint) _
  rw [Ring.ordFrac_eq_ord _ hb0]
  have hnz : b ∈ nonZeroDivisors (Y.presheaf.stalk P.genericPoint) :=
    mem_nonZeroDivisors_of_ne_zero hb0
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (Ring.ord_ne_top hnz)
  simp only [Ring.ordMonoidWithZeroHom, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk, hnz, if_true,
    ← hn]
  simp only [ENat.recTopCoe_coe, WithZero.one_le_coe]
  exact WithZero.coe_le_coe.mpr (Multiplicative.ofAdd_le.mpr (by exact_mod_cast Nat.zero_le n))

/-- A unit of the local ring at `y` has order zero along every prime divisor through `y`. -/
private theorem ord_algebraMap_eq_zero_of_isUnit {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support)
    {v : Y.presheaf.stalk y} (hv : IsUnit v) :
    Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField v) P.genericPoint = 0 := by
  obtain ⟨w, rfl⟩ := hv
  have h1 : algebraMap (Y.presheaf.stalk y) Y.functionField (w : Y.presheaf.stalk y) ≠ 0 :=
    (w.isUnit.map _).ne_zero
  have h2 : algebraMap (Y.presheaf.stalk y) Y.functionField ((w⁻¹ : (Y.presheaf.stalk y)ˣ) :
      Y.presheaf.stalk y) ≠ 0 := (w⁻¹.isUnit.map _).ne_zero
  have h3 := Scheme.ord_mul (x := P.genericPoint) h1 h2
  rw [← map_mul, Units.mul_inv, map_one, Scheme.ord_one] at h3
  have := ord_algebraMap_nonneg P hP _ h1
  have := ord_algebraMap_nonneg P hP _ h2
  omega

/-- In a local ring, if `∑ aᵢ bᵢ = 1` then some `bᵢ` is a unit. -/
private theorem exists_isUnit_of_sum_mul_eq_one {R : Type*} [CommRing R] [IsLocalRing R]
    {ι : Type*} (s : Finset ι) (a b : ι → R) (h : ∑ i ∈ s, a i * b i = 1) :
    ∃ i ∈ s, IsUnit (b i) := by
  by_contra hne
  push Not at hne
  apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  rw [Ideal.eq_top_iff_one, ← h]
  exact Ideal.sum_mem _ fun i hi =>
    Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hne i hi))

section GlobalGeneration

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **A generating family has a member whose divisor of zeros misses a point where the divisor
is Cartier.** If the global sections `sᵢ` generate `𝒪_X(D)` and `ψ` is a local equation of `D`
near `x`, write `sᵢ = gᵢ ψ⁻¹` near `x`; since the germs of the `sᵢ` span the stalk, some `gᵢ` is a
unit at `x`, and then `(sᵢ)₀ = div(gᵢ)` misses `x`. -/
private theorem exists_notMem_supp_zeroDivisor {D : Divisor X}
    (σ : D.divisorialSheaf.GeneratingSections) [Finite σ.I] {W : X.Opens}
    {ψ : (RationalFunctions X)ˣ} (hψ : D.IsLocalEquation W ψ) {x : X} (hx : x ∈ W) :
    ∃ i, ∃ hi : ((σ.s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0,
      x ∉ (D.zeroDivisor _ hi).supp := by
  classical
  have hspan := (AlgebraicGeometry.generates_iff_stalkwise_generates _ _ σ.s).mp σ.epi x
  have hfin : Finite σ.I := inferInstance
  revert hspan hfin
  obtain ⟨I, s, -⟩ := σ
  intro hspan hfin
  haveI := Fintype.ofFinite I
  dsimp only at hspan ⊢
  set b : Γ(D.divisorialSheaf, W) := hψ.invSection with hb
  have hgen := hψ.isLocalGenerator_invSection
  have hs : ∀ i, ∃ g : Γ(X, W), g • D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b =
      D.divisorialSheaf.presheaf.map (homOfLE le_top).op ((s i).eval (Opposite.op ⊤)) :=
    fun i => (hgen W le_rfl).2 _
  choose g hg using hs
  have hbW : D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b = b := by
    have h1 : (homOfLE (le_refl W)).op = 𝟙 (Opposite.op W) := rfl
    rw [h1, CategoryTheory.Functor.map_id]; rfl
  rw [hbW] at hg
  set G := TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf W x hx
  have hmem : G b ∈
      Submodule.span (TopCat.Presheaf.stalk (C := RingCat.{0}) X.ringCatSheaf.obj x)
        (Set.range fun i => (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
          ((s i).eval (Opposite.op ⊤))) := by
    rw [hspan]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  have hgerm : ∀ i, (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
      ((s i).eval (Opposite.op ⊤)) = G.hom (g i • b) := by
    intro i
    rw [hg i]
    exact (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top) x hx _).symm
  have hsm : ∀ i, G.hom (g i • b) = (TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj
      W x hx).hom (g i) • G.hom b := fun i =>
    PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x W hx (g i) b
  simp only [hgerm, hsm, smul_smul, ← Finset.sum_smul] at hc
  set RG := TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj W x hx
  set r := ∑ i, c i * RG.hom (g i) with hr
  -- `𝒪_X(D)_x` is torsion free over `𝒪_{X,x}` along the frame `ψ⁻¹`
  have hr1 : r = 1 := by
    have h0 : (1 - r) • G.hom b = 0 := by rw [sub_smul, one_smul, hc, sub_self]
    obtain ⟨V, hVW, hxV, a, ha⟩ := TopCat.Presheaf.exists_le_germ_eq _ (1 - r) hx
    have e1 := PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x V hxV a
      (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b)
    have e2 := TopCat.Presheaf.germ_res_apply D.divisorialSheaf.val.presheaf (homOfLE hVW) x
      hxV b
    rw [ha, e2] at e1
    have e3 : (1 - r) • G.hom b =
        (TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf V x hxV).hom 0 := by
      rw [h0, map_zero]
    obtain ⟨W', hxW', i1, i2, he⟩ := TopCat.Presheaf.germ_eq _ x hxV hxV _ _ (e1.trans e3)
    have hle : W' ≤ W := i1.le.trans hVW
    rw [map_zero] at he
    have he2 := (PresheafOfModules.map_smul D.divisorialSheaf.val i1.op a _).symm.trans he
    have ha0 : X.presheaf.map i1.op a = 0 := by
      refine (hgen W' hle).1 ?_
      change _ • _ = (0 : Γ(X, W')) • _
      rw [zero_smul]
      have hcomp : D.divisorialSheaf.val.map i1.op
          (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b) =
          D.divisorialSheaf.presheaf.map (homOfLE hle).op b := rfl
      rw [hcomp] at he2
      exact he2
    have h5 : (1 : _) - r = 0 := ha.symm.trans
      ((TopCat.Presheaf.germ_res_apply _ i1 x hxW' a).symm.trans
        ((congrArg (TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj W' x hxW').hom
          ha0).trans
          (map_zero _)))
    exact (sub_eq_zero.mp h5).symm
  -- some `gᵢ` is a unit at `x`
  obtain ⟨i, -, hu⟩ : ∃ i ∈ Finset.univ, IsUnit ((X.presheaf.germ W x hx).hom (g i)) := by
    have hge : ∀ i, SemilinearStalk.commStalkRingEquiv X.presheaf x (RG.hom (g i)) =
        (X.presheaf.germ W x hx).hom (g i) := fun i =>
      SemilinearStalk.commStalkRingEquiv_germ X.presheaf x W hx (g i)
    set e := SemilinearStalk.commStalkRingEquiv X.presheaf x
    have h1 : ∑ i, e (c i) * (X.presheaf.germ W x hx).hom (g i) = 1 := by
      have h2 : e r = 1 := (congrArg e hr1).trans (map_one e)
      have h3 : e r = ∑ i, e (c i * RG.hom (g i)) := map_sum e _ _
      have h4 : ∀ i, e (c i * RG.hom (g i)) = e (c i) * (X.presheaf.germ W x hx).hom (g i) :=
        fun i => (map_mul e _ _).trans (congrArg _ (hge i))
      simp only [h4] at h3
      exact h3.symm.trans h2
    exact exists_isUnit_of_sum_mul_eq_one Finset.univ _ _ h1
  have hxg : x ∈ X.basicOpen (g i) := (X.mem_basicOpen (g i) x hx).mpr hu
  -- the values of `sᵢ` near `x`
  have hval : ∀ (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ W),
      ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤).1 ⟨Z, trivial⟩ =
        (X.presheaf.germ W _ hZ).hom (g i) *
          ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) Z := by
    intro Z hZ
    have := congrArg (fun m : D.divisorialSubmodule W => m.1 ⟨Z, hZ⟩) (hg i)
    simp only [Submodule.coe_smul, rationalFunctions_smul_apply] at this
    exact this.symm
  have hunit : ∀ y (hy : y ∈ X.basicOpen (g i)),
      IsUnit ((X.presheaf.germ W y (X.basicOpen_le _ hy)).hom (g i)) := fun y hy =>
    (X.mem_basicOpen (g i) y (X.basicOpen_le _ hy)).mp hy
  have hZ₀ : componentGenericPoint X (pointComponent x) ∈ X.basicOpen (g i) :=
    ((isGenericPoint_componentGenericPoint X _).specializes
      (mem_pointComponent x)).mem_open (X.basicOpen _).isOpen hxg
  have hi : ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0 := by
    intro h0
    have h2 := hval (pointComponent x) (X.basicOpen_le _ hZ₀)
    rw [h0] at h2
    have h3 : IsUnit ((X.presheaf.germ W _ (X.basicOpen_le _ hZ₀)).hom (g i) *
        ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) (pointComponent x)) :=
      (hunit _ hZ₀).mul ((Pi.isUnit_iff.mp (ψ⁻¹).isUnit) _)
    rw [← h2] at h3
    exact not_isUnit_zero h3
  refine ⟨i, hi, fun hxs => ?_⟩
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hxs
  apply hE
  have hηE : E.genericPoint ∈ X.basicOpen (g i) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact (specializes_iff_mem_closure.mpr hxE).mem_open (X.basicOpen _).isOpen hxg
  have hηW : E.genericPoint ∈ W := X.basicOpen_le _ hηE
  have hZ : componentGenericPoint X E.component ∈ W :=
    E.specializes_genericPoint.mem_open W.isOpen hηW
  set u := (Divisor.isUnit_sectionToRationalFunctions hi).unit
  have hv := congrArg E.valuation (hval E.component hZ)
  have hgerm : (X.presheaf.germ W _ hZ).hom (g i) =
      E.toComponent.hom ((X.presheaf.germ W _ hηW).hom (g i)) := by
    rw [← TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hηW E.specializes_genericPoint]
    rfl
  rw [map_mul, hgerm, E.valuation_toComponent_of_isUnit (hunit _ hηE), one_mul,
    PrimeDivisor.valuation_component, PrimeDivisor.ord_inv,
    ← hψ E ⟨E.genericPoint, (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl), hηW⟩] at hv
  have hv' : E.valuation ((u : RationalFunctions X) E.component) =
      WithZero.exp (-D.coeff E) := hv
  rw [PrimeDivisor.valuation_component] at hv'
  have hv'' := WithZero.exp_injective hv'
  have hc : (D.zeroDivisor _ hi).coeff E = (principalDivisor u).coeff E + D.coeff E := rfl
  refine hc.trans ?_
  rw [coeff_principalDivisor]
  omega

/-- `𝒪_X(nL) ≅ 𝒪_X(L)^{⊗ n}` for a Cartier divisor `L` and `n ≥ 1`. -/
private theorem nonempty_divisorialSheaf_nsmul_iso {L : Divisor X} (hL : L.IsCartier) (n : ℕ)
    (hn : 1 ≤ n) :
    haveI := hL.isInvertibleModule_divisorialSheaf
    Nonempty ((n • L).divisorialSheaf ≅
      Stacks.Ample.tensorPowModule X L.divisorialSheaf (n : ℤ)) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  induction n, hn using Nat.le_induction with
  | base =>
    exact ⟨eqToIso (congrArg Divisor.divisorialSheaf (one_nsmul L)) ≪≫
      (Stacks.Ample.tensorPowModuleOneIso X _).symm⟩
  | succ n hn ih =>
    obtain ⟨e⟩ := ih
    refine ⟨eqToIso (congrArg Divisor.divisorialSheaf (succ_nsmul L n)) ≪≫
      ((hL.nsmul n).divisorialSheafTensorIso hL).symm ≪≫ ?_ ≪≫
      Stacks.Ample.tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by push_cast; rfl)⟩
    exact ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso e).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso X _).symm

/-- **Serre generation for `𝒪_X(E + m'H)`** ([Stacks, Tag 01Q3]). For an ample Cartier divisor
`H` on a variety and any divisor `E`, for some `m' > 0` the sheaf `𝒪_X(E + m'H)` is generated by
finitely many global sections: `𝒪_X(E)` is coherent, so `𝒪_X(E) ⊗ 𝒪_X(H)^{⊗ m'}` is globally
generated for `m' ≫ 0`, and multiplication `𝒪_X(E) ⊗ 𝒪_X(m'H) ⟶ 𝒪_X(E + m'H)` is an
isomorphism. -/
private theorem exists_generatingSections {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    (hX : MMP.Mori.IsVariety k sX) {H : Divisor X} (hH : H.IsCartier) (hHa : H.IsAmple hH)
    (E : Divisor X) :
    ∃ m' : ℕ, 0 < m' ∧ ∃ σ : (E + m' • H).divisorialSheaf.GeneratingSections, Finite σ.I := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  have hcoh := MMP.Threefold.isCoherent_divisorialSheaf_and_isIso_divisorialSheafTensorMul sX hX E
  haveI := (hcoh H).1
  have hqc := Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
    E.divisorialSheaf
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hHa).2 E.divisorialSheaf hqc.1 hqc.2
  set n : ℕ := max n₀.toNat 1 with hn
  obtain ⟨σ, hσ⟩ := hn₀ (n : ℤ) (by omega)
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X E.divisorialSheaf
    (Stacks.Ample.tensorPowModule X H.divisorialSheaf (n : ℤ))
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_iso hH n (le_max_right _ _)
  let pI := i ≪≫ Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _) e.symm ≪≫
    @asIso _ _ _ _ (E.divisorialSheafTensorMul (n • H)) ((hcoh (n • H)).2.2 (hH.nsmul n))
  let p := pI.hom
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ p :=
    @IsIso.epi_of_iso _ _ _ _ p inferInstance
  exact ⟨n, by omega, σ.ofEpi p, hσ⟩

end GlobalGeneration

/-- The divisor `div g` of a nonzero rational function `g`. -/
private noncomputable abbrev ffDiv {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (g : X.functionField) (hg : g ≠ 0) : Divisor X :=
  MMP.Mori.principalDivisor
    (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg))

/-- The image in `K(X)` of a scalar `a ∈ k`. -/
private noncomputable abbrev scalarFun {X : Scheme.{0}} [IsIntegral X] (sX : X ⟶ Spec (.of k)) (a : k) :
    X.functionField :=
  baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom a)

/-- The divisor of the rational function of a unit of `K(X)` is its principal divisor. -/
private theorem ffDiv_rationalFunctionsEquivFunctionField {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (w : (MMP.Mori.RationalFunctions X)ˣ)
    (hw : rationalFunctionsEquivFunctionField X w ≠ 0) :
    ffDiv (rationalFunctionsEquivFunctionField X w) hw = MMP.Mori.principalDivisor w := by
  have hu : Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
      (Units.mk0 (rationalFunctionsEquivFunctionField X w) hw) = w := by
    ext1
    rw [Units.coe_map, Units.val_mk0]
    exact (rationalFunctionsEquivFunctionField X).symm_apply_apply _
  unfold ffDiv
  rw [hu]

/-- A rational function whose divisor plus `M` is effective is a section of `𝒪_X(M)`. -/
private theorem mem_sectionsIn_of_coeff_nonneg {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {M : Divisor X} {g : X.functionField}
    (hg : g ≠ 0) (h : ∀ P, 0 ≤ (M + ffDiv g hg).coeff P) : g ∈ sectionsIn M := by
  intro P
  have h1 := h P
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
  rw [P.divisorialValuation_eq_exp_neg_ord hg, WithZero.exp_le_exp]
  omega

/-- A coefficient vector outside a proper subspace is detected by a nonzero polynomial: if
`v ∉ p` for a subspace `p ⊆ kⁱ`, some linear form `ℓ` vanishes on `p` with `ℓ(v) ≠ 0`, and
`Q = ∑ ℓ(eᵢ) Xᵢ` is nonzero with `Q(c) ≠ 0 → c ∉ p`. -/
private theorem exists_polynomial_forall_notMem {k : Type} [Field k] {ι : Type*} [Fintype ι]
    {p : Submodule k (ι → k)} {v : ι → k} (hv : v ∉ p) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 → c ∉ p := by
  classical
  obtain ⟨ℓ, hℓ, hp⟩ := Submodule.exists_le_ker_of_notMem hv
  let Q : MvPolynomial ι k :=
    ∑ i, MvPolynomial.C (ℓ (fun j => if i = j then 1 else 0)) * MvPolynomial.X i
  have heval : ∀ c, MvPolynomial.eval c Q = ℓ c := by
    intro c
    rw [LinearMap.pi_apply_eq_sum_univ ℓ c]
    simp [Q, MvPolynomial.eval_sum, mul_comm]
  refine ⟨Q, fun h => hℓ (by rw [← heval, h, map_zero]), fun c hc hcp => hc ?_⟩
  rw [heval]
  exact hp hcp

/-- **A finite free subfamily.** If the moving part of a pulled-back series is free, finitely
many members of the series already have no common base point on `Y`. -/
private theorem exists_finite_free_family {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] (μ : Y ⟶ X) [IsDominant μ] {V : Set X.functionField} {Dμ F : Divisor Y}
    (hfree : IsFreeModuloFixedDivisor μ V Dμ F) :
    ∃ (n : ℕ) (h : Fin n → X.functionField), (∀ i, h i ∈ V) ∧ ∀ y : Y, ∃ i, h i ≠ 0 ∧
      ∀ P : MMP.Mori.PrimeDivisor Y, y ∈ P.support →
        P.valuationOver μ (h i) = WithZero.exp (Dμ.coeff P - F.coeff P) := by
  classical
  choose G hGV hG0 hGP using hfree
  have hf0 : ∀ y, functionFieldMap μ (G y) ≠ 0 := fun y =>
    (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr (hG0 y)
  have hgood : ∀ y (P : MMP.Mori.PrimeDivisor Y),
      P ∉ (ffDiv _ (hf0 y)).support ∪ Dμ.support ∪ F.support →
      P.valuationOver μ (G y) = WithZero.exp (Dμ.coeff P - F.coeff P) := by
    intro y P hP
    simp only [Finset.mem_union, not_or, Finsupp.notMem_support_iff] at hP
    obtain ⟨⟨h1, h2⟩, h3⟩ := hP
    have h1' : (ffDiv _ (hf0 y)).coeff P = 0 := h1
    rw [MMP.Mori.coeff_principalDivisor_mk0] at h1'
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord (hf0 y),
      h1', DivisorWithCoeffs.coeff_apply, h2, DivisorWithCoeffs.coeff_apply, h3]
    simp
  set bad : Y → Finset (MMP.Mori.PrimeDivisor Y) := fun y =>
    ((ffDiv _ (hf0 y)).support ∪ Dμ.support ∪ F.support).filter fun P =>
      P.valuationOver μ (G y) ≠ WithZero.exp (Dμ.coeff P - F.coeff P) with hbad
  set U : Y → Set Y := fun y => (⋃ P ∈ bad y, (P.support : Set Y))ᶜ with hU
  have hUo : ∀ y, IsOpen (U y) := fun y =>
    (Set.Finite.isClosed_biUnion (Finset.finite_toSet _) fun P _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure).isOpen_compl
  have hyU : ∀ y, y ∈ U y := fun y hy => by
    obtain ⟨P, hP, hyP⟩ := Set.mem_iUnion₂.mp hy
    exact (Finset.mem_filter.mp hP).2 (hGP y P hyP)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover U hUo
    (fun y _ => Set.mem_iUnion.mpr ⟨y, hyU y⟩)
  refine ⟨t.card, fun i => G (t.equivFin.symm i), fun i => hGV _, fun y => ?_⟩
  obtain ⟨y₀, hy₀t, hyU₀⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ y))
  refine ⟨t.equivFin ⟨y₀, hy₀t⟩, by simpa using hG0 y₀, fun P hP => ?_⟩
  simp only [Equiv.symm_apply_apply]
  by_contra hne
  apply hyU₀
  refine Set.mem_iUnion₂.mpr ⟨P, Finset.mem_filter.mpr ⟨?_, hne⟩, hP⟩
  by_contra hPs
  exact hne (hgood y₀ P hPs)

/-! ### Pull-backs, sections and exceptional sets on a model -/

/-- `v_E(φ_{i(E)}) ≥ n` for the factor of a nonzero rational function `f` reads `ord_E f ≥ n`. -/
private theorem ordGE_symm_iff {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (E : MMP.Mori.PrimeDivisor X) (n : ℤ) {f : X.functionField}
    (hf : f ≠ 0) :
    E.OrdGE n ((rationalFunctionsEquivFunctionField X).symm f E.component) ↔
      n ≤ X.ord f E.genericPoint := by
  set u : (RationalFunctions X)ˣ :=
    Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 f hf)
  have hu : (u : RationalFunctions X) = (rationalFunctionsEquivFunctionField X).symm f := rfl
  have hne : (u : RationalFunctions X) E.component ≠ 0 :=
    ((Pi.isUnit_iff.mp u.isUnit) E.component).ne_zero
  have hord : E.ord u = X.ord f E.genericPoint := by
    rw [MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, hu, RingEquiv.apply_symm_apply]
  rw [← hu]
  unfold MMP.Mori.PrimeDivisor.OrdGE
  rw [E.valuation_component, hord, WithZero.exp_le_exp]
  simp [hne]

/-- The valuation along `F` of a nonzero element of the factor of `K(X)` is the order of the
rational function it represents. -/
private theorem valuation_eq_exp_ord {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (F : MMP.Mori.PrimeDivisor X)
    (c : X.presheaf.stalk (componentGenericPoint X F.component))
    (hc : (MMP.Positivity.componentToFunctionField F.component).hom c ≠ 0) :
    F.valuation c =
      WithZero.exp
        (X.ord ((MMP.Positivity.componentToFunctionField F.component).hom c) F.genericPoint) := by
  set χ := (MMP.Positivity.componentToFunctionField F.component).hom c
  letI := (RationalFunctions.isField_stalk X F.component).toField
  have hcχ : c = (rationalFunctionsEquivFunctionField X).symm χ F.component :=
    RingHom.injective (MMP.Positivity.componentToFunctionField F.component).hom
      (MMP.Positivity.componentToFunctionField_symm_apply _ χ).symm
  set u : (RationalFunctions X)ˣ :=
    Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 χ hc)
  have hu : (u : RationalFunctions X) F.component = c := hcχ.symm
  rw [← hu, F.valuation_component, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  simp [u, χ]

/-- The coefficient along `F` of the pull-back of a Cartier divisor with local equation `ψ` near
`φ(η_F)` is the order of `φ^*ψ` along `F`. -/
private theorem coeff_eq_ord_of_isPullback {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (φ : X ⟶ Y) [IsDominant φ] {B : Divisor Y}
    {hB : ∀ Z : irreducibleComponents X, φ (componentGenericPoint X Z) ∉ B.supp}
    {B' : Divisor X} (h : B.IsPullback φ hB B') {U : Y.Opens} {ψ : (RationalFunctions Y)ˣ}
    (hψ : B.IsLocalEquation U ψ) (F : MMP.Mori.PrimeDivisor X) (hF : φ F.genericPoint ∈ U) :
    B'.coeff F =
      X.ord (functionFieldMap φ (rationalFunctionsEquivFunctionField Y ψ)) F.genericPoint := by
  have hFU : (F.support ∩ φ ⁻¹ᵁ U).Nonempty := (F.genericPoint_mem_iff (φ ⁻¹ᵁ U)).mp hF
  rw [h U ψ hψ F hFU]
  obtain ⟨W, hW⟩ := exists_mem_irreducibleComponents (φ (componentGenericPoint X F.component))
  have hmem := F.map_componentGenericPoint_mem φ hFU
  obtain ⟨a, ha⟩ := hψ.exists_unit_stalk hmem (hB _) hW
  rw [pullbackComponent_eq hB hψ hmem hW a ha]
  set χ := functionFieldMap φ (rationalFunctionsEquivFunctionField Y ψ)
  have hχ : χ ≠ 0 := (map_ne_zero_iff _ (functionFieldMap φ).injective).mpr
    (ψ.isUnit.map (rationalFunctionsEquivFunctionField Y)).ne_zero
  have hcχ : (MMP.Positivity.componentToFunctionField F.component).hom
      ((φ.stalkMap (componentGenericPoint X F.component)).hom a) = χ := by
    change algebraMap (X.presheaf.stalk (componentGenericPoint X F.component)) X.functionField
      ((φ.stalkMap _).hom a) = χ
    rw [← MMP.Mori.functionFieldMap_algebraMap_stalk, ← MMP.Mori.algebraMap_stalkSpecializes
      ((isGenericPoint_componentGenericPoint Y W).specializes hW)]
    change functionFieldMap φ ((Y.presheaf.stalkSpecializes _).hom
      ((stalkToRationalFunctions Y hW).hom a)) = χ
    rw [ha]
    change functionFieldMap φ ((MMP.Positivity.componentToFunctionField W).hom _) = χ
    rw [MMP.Positivity.componentToFunctionField_apply]
  have h1 := F.valuation_eq_exp_ordUnit
    (Units.map (φ.stalkMap (componentGenericPoint X F.component)).hom.toMonoidHom a)
  rw [valuation_eq_exp_ord F _ (hcχ ▸ hχ)] at h1
  rw [← hcχ]
  exact (WithZero.exp_injective h1).symm

/-- The valuation over `μ` of `g` is at most `exp n` exactly when `ord (μ^*g) ≥ -n`. -/
private theorem valuationOver_le_exp_iff {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] (P : MMP.Mori.PrimeDivisor Y)
    {g : X.functionField} (hg : functionFieldMap μ g ≠ 0) (n : ℤ) :
    P.valuationOver μ g ≤ WithZero.exp n ↔ -n ≤ Y.ord (functionFieldMap μ g) P.genericPoint := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord hg,
    WithZero.exp_le_exp]
  omega

/-- The valuation over `μ` of `g` is `exp n` exactly when `ord (μ^*g) = -n`. -/
private theorem valuationOver_eq_exp_iff {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] (P : MMP.Mori.PrimeDivisor Y)
    {g : X.functionField} (hg : functionFieldMap μ g ≠ 0) (n : ℤ) :
    P.valuationOver μ g = WithZero.exp n ↔ Y.ord (functionFieldMap μ g) P.genericPoint = -n := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord hg,
    WithZero.exp_inj]
  omega

/-- The coefficient of the divisor of zeros of a section read as the rational function `f`. -/
private theorem coeff_zeroDivisor {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (M : Divisor Y) (σ : M.divisorialSubmodule ⊤) (hσ : σ ≠ 0)
    {f : Y.functionField} (hf : Divisor.sectionToRationalFunctions σ =
      (rationalFunctionsEquivFunctionField Y).symm f) (P : MMP.Mori.PrimeDivisor Y) :
    (M.zeroDivisor σ hσ).coeff P = Y.ord f P.genericPoint + M.coeff P := by
  rw [MMP.Mori.Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
    MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  congr 2
  rw [IsUnit.unit_spec, hf, RingEquiv.apply_symm_apply]

/-- The pull-back of the germ at the generic point of a global function. -/
private theorem functionFieldMap_germ_top {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (μ : Y ⟶ X) [IsDominant μ] (t : Γ(X, ⊤)) :
    functionFieldMap μ (X.presheaf.germ ⊤ (genericPoint X) trivial t) =
      Y.presheaf.germ ⊤ (genericPoint Y) trivial (μ.appTop t) := by
  have h1 : X.presheaf.germ ⊤ (genericPoint X) trivial t =
      algebraMap (X.presheaf.stalk (μ (genericPoint Y))) X.functionField
        (X.presheaf.germ ⊤ (μ (genericPoint Y)) trivial t) :=
    (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf _ _ t).symm
  have h2 := μ.germ_stalkMap_apply ⊤ (genericPoint Y) trivial t
  rw [h1, MMP.Mori.functionFieldMap_algebraMap_stalk, h2]
  exact TopCat.Presheaf.germ_stalkSpecializes_apply Y.presheaf _ _ _

/-- `μ^*(D + div g) = μ^*D + div(μ^*g)`. -/
private theorem isPullback_add_principalDivisor {X Y : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (μ : Y ⟶ X) [IsDominant μ] {D : Divisor X} (hDc : D.IsCartier)
    {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp} {Dμ : Divisor Y}
    (hpull : D.IsPullback μ hD Dμ) {g : X.functionField} (hg : g ≠ 0)
    (hg' : functionFieldMap μ g ≠ 0)
    (hB : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉
      (D + MMP.Mori.principalDivisor
        (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
          (Units.mk0 g hg))).supp) :
    (D + MMP.Mori.principalDivisor
      (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
        (Units.mk0 g hg))).IsPullback μ hB
      (Dμ + MMP.Mori.principalDivisor (Units.map
        (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom
          (Units.mk0 (functionFieldMap μ g) hg'))) := by
  set u := Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg)
  have hBp : ∀ Z : irreducibleComponents Y,
      μ (componentGenericPoint Y Z) ∉ (MMP.Mori.principalDivisor u).supp :=
    fun Z => MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ _ Z
  obtain ⟨P', hP'⟩ := (Divisor.isCartier_principalDivisor u).exists_isPullback hBp
  have hP'eq : P' = MMP.Mori.principalDivisor (Units.map
      (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom
        (Units.mk0 (functionFieldMap μ g) hg')) := by
    ext P
    rw [coeff_eq_ord_of_isPullback μ hP' (Divisor.isLocalEquation_principalDivisor u ⊤) P trivial,
      MMP.Mori.coeff_principalDivisor_mk0]
    simp [u]
  rw [← hP'eq]
  exact hpull.add hDc (Divisor.isCartier_principalDivisor u) hB hP'

/-- **Pull-back of Cartier divisors along a composite**: `g^*(f^*L) = (g ≫ f)^*L`. -/
private theorem isPullback_comp {X Y Z : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral X] [IsLocallyNoetherian Z] [IsNormal Z]
    {f : Y ⟶ X} {g : Z ⟶ Y} {L : Divisor X} {L' : Divisor Y}
    {L'' : Divisor Z} {hB : ∀ W : irreducibleComponents Y, f (componentGenericPoint Y W) ∉ L.supp}
    {hB' : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉ L'.supp}
    (h : L.IsPullback f hB L') (h' : L'.IsPullback g hB' L'')
    (hB'' : ∀ W : irreducibleComponents Z, (g ≫ f) (componentGenericPoint Z W) ∉ L.supp) :
    L.IsPullback (g ≫ f) hB'' L'' := by
  intro U φ hφ E hE
  have hψ := h.isLocalEquation hφ
  rw [h' (f ⁻¹ᵁ U) _ hψ E hE]
  congr 1
  set z := componentGenericPoint Z E.component
  have hzU : f (g z) ∈ U := E.map_componentGenericPoint_mem (g ≫ f) hE
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hzU (hB'' _) (MMP.Fourfold.mem_irreducibleComponent_of_irreducibleSpace
    (pointComponent ((g ≫ f) z)) _)
  rw [pullbackComponent_eq hB'' hφ hzU _ a ha]
  set W := pointComponent (g z)
  have hspec : componentGenericPoint Y W ⤳ g z :=
    (isGenericPoint_componentGenericPoint Y W).specializes (mem_pointComponent _)
  have hWU : f (componentGenericPoint Y W) ∈ U :=
    (f.base.hom.map_specializes hspec).mem_open U.isOpen hzU
  have hb : (stalkToRationalFunctions Y (mem_pointComponent (g z))).hom
      (Units.map (f.stalkMap (g z)).hom.toMonoidHom a) =
      ((pullbackLocalEquation f hB hφ : (RationalFunctions Y)ˣ) : RationalFunctions Y) W := by
    have e1 := congrArg Units.val (pullbackLocalEquation_apply f hB hφ W hWU)
    refine Eq.trans ?_ e1.symm
    rw [pullbackComponent_eq hB hφ hWU
      (MMP.Fourfold.mem_irreducibleComponent_of_irreducibleSpace (pointComponent ((g ≫ f) z)) _)
      (Units.map (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom.toMonoidHom a)
      ?_]
    · change (stalkToRationalFunctions Y _).hom ((f.stalkMap (g z)).hom a.val) =
        (f.stalkMap _).hom ((X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom
          a.val)
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, stalkToRationalFunctions,
        Scheme.Hom.stalkSpecializes_stalkMap]
    · change (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec) ≫
        X.presheaf.stalkSpecializes _).hom a.val = _
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact ha
  rw [pullbackComponent_eq hB' hψ _ (mem_pointComponent (g z)) _ hb]
  ext
  change _ = ((g ≫ f).stalkMap z).hom a.val
  rw [Scheme.Hom.stalkMap_comp]
  rfl

/-- A point off the exceptional sets of `h` and of `g` at `h y` is off that of `h ≫ g`. -/
private theorem mem_exceptionalSet_comp {Y X' X : Scheme.{0}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsSeparated g] [UniversallyClosed g] {y : Y} (hy : y ∈ exceptionalSet (h ≫ g)) :
    y ∈ exceptionalSet h ∨ h y ∈ exceptionalSet g := by
  by_contra hne
  push Not at hne
  obtain ⟨hyh, hyg⟩ := hne
  simp only [MMP.Mori.mem_exceptionalSet, not_not, Scheme.Hom.comp_apply] at hy hyh hyg
  apply hy
  have hcl : IsClosed (g '' (biregularLocus h : Set X')ᶜ) :=
    g.isClosedMap _ (biregularLocus h).isOpen.isClosed_compl
  let W : X.Opens := biregularLocus g ⊓ ⟨_, hcl.isOpen_compl⟩
  have hWg : IsBiregular g W :=
    isBiregular_iff_le_biregularLocus.mpr inf_le_left
  have hWh : IsBiregular h (g ⁻¹ᵁ W) := by
    refine isBiregular_iff_le_biregularLocus.mpr ?_
    intro x hx
    by_contra hxU
    exact hx.2 ⟨x, hxU, rfl⟩
  have hiso : IsBiregular (h ≫ g) W := by
    unfold IsBiregular at *
    rw [morphismRestrict_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ hWh hWg
  refine le_biregularLocus hiso ⟨hyg, ?_⟩
  rintro ⟨x, hx, hxy⟩
  have : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
  have hxy' : g x = g (h y) := hxy.trans (Scheme.Hom.comp_apply h g y)
  have hx' : g x ∈ biregularLocus g := hxy' ▸ hyg
  have hinj := (g ∣_ biregularLocus g).isOpenEmbedding.injective
    (a₁ := (⟨x, hx'⟩ : g ⁻¹ᵁ biregularLocus g)) (a₂ := ⟨h y, hyg⟩)
  have : x = h y := congrArg Subtype.val (hinj (Subtype.ext
    ((morphismRestrict_base_coe g _ _).trans (hxy'.trans
      (morphismRestrict_base_coe g (biregularLocus g) ⟨h y, hyg⟩).symm))))
  exact hx (this ▸ hyh)

/-- A combination of sections of `𝒪_X(M)` with scalar coefficients is a section. -/
private theorem sum_mem_sectionsIn {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {M : Divisor X} {ι : Type*} [Fintype ι]
    (g : ι → X.functionField) (hg : ∀ i, g i ∈ sectionsIn M) (c : ι → k) :
    (∑ i, scalarFun sX (c i) * g i) ∈ sectionsIn M := by
  refine (sectionsSubgroup M).sum_mem fun i _ => ?_
  intro P
  rw [map_mul]
  refine (mul_le_of_le_one_left' ?_).trans (hg i P)
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
  exact ⟨_, (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ⊤)
    (show P.genericPoint ∈ (⊤ : X.Opens) from trivial) _).trans rfl⟩

/-- A section of `𝒪_X(M)` has effective divisor `M + div g`. -/
private theorem coeff_add_ffDiv_nonneg {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {M : Divisor X} {g : X.functionField} (hg : g ∈ sectionsIn M)
    (hg0 : g ≠ 0) (P : MMP.Mori.PrimeDivisor X) : 0 ≤ (M + ffDiv g hg0).coeff P := by
  have h := hg P
  rw [P.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  omega

open Classical in
/-- The coefficient of a reduced sum of prime divisors. -/
private theorem coeff_sum_single_one {Y : Scheme.{0}} (s : Finset (MMP.Mori.PrimeDivisor Y))
    (P : MMP.Mori.PrimeDivisor Y) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).coeff P = if P ∈ s then 1 else 0 := by
  classical
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
  simp [Finsupp.single_apply]

/-- **A general member misses a point that one member misses.** If `x` lies off the divisor of
the member `g_j` of `|M|`, then for a general coefficient vector `c` the combination
`∑ cᵢ gᵢ` is nonzero and `x` lies off its divisor. -/
private theorem exists_polynomial_notMem_supp {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {M : Divisor X}
    (hMc : M.IsCartier) {ι : Type*} [Fintype ι] (g : ι → X.functionField)
    (hg : ∀ i, g i ∈ sectionsIn M) (x : X) (j : ι) (hj : g j ≠ 0)
    (hjx : x ∉ (M + ffDiv (g j) hj).supp) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      ∃ hc : (∑ i, scalarFun sX (c i) * g i) ≠ 0, x ∉ (M + ffDiv _ hc).supp := by
  classical
  obtain ⟨U, hxU, φ, hφ⟩ := hMc x
  set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  set ψf := MMP.Threefold.Mori.Helpers.evalFF Z₀ (φ : MMP.Mori.RationalFunctions X) with hψf
  have hψ0 : ψf ≠ 0 := evalFF_ne_zero Z₀ φ
  have hordψ : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord ψf Γ.genericPoint = M.coeff Γ :=
    fun Γ hΓ => ord_evalFF_of_isLocalEquation hφ Z₀ Γ ⟨x, hΓ, hxU⟩
  have hreg : ∀ i, ∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = g i * ψf := by
    intro i
    rcases eq_or_ne (g i) 0 with h0 | h0
    · exact ⟨0, by rw [map_zero, h0, zero_mul]⟩
    · refine MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x
        (mul_ne_zero h0 hψ0) fun Γ hΓ => ?_
      rw [Scheme.ord_mul h0 hψ0, hordψ Γ hΓ]
      exact ord_add_coeff_nonneg (hg i) h0 Γ
  choose r hr using hreg
  have hj0 : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord (g j * ψf) Γ.genericPoint = 0 := by
    intro Γ hΓ
    rw [Scheme.ord_mul hj hψ0, hordψ Γ hΓ]
    have h1 : (M + ffDiv (g j) hj).coeff Γ = 0 := by
      by_contra hne
      exact hjx (DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ, hne, hΓ⟩)
    rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
    omega
  obtain ⟨r', hr'⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x
    (inv_ne_zero (mul_ne_zero hj hψ0)) fun Γ hΓ => by
      rw [← zpow_neg_one, MMP.Mori.ord_zpow _ (mul_ne_zero hj hψ0), hj0 Γ hΓ]; simp
  have hmul : r j * r' = 1 := IsFractionRing.injective _ X.functionField (by
    rw [map_mul, hr j, hr', map_one, mul_inv_cancel₀ (mul_ne_zero hj hψ0)])
  have hunit : IsUnit (r j) := ⟨⟨r j, r', hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
  let φk : k →+* X.presheaf.stalk x := (X.presheaf.germ ⊤ x trivial).hom.comp
    (sX.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
  have hφk : ∀ a, algebraMap _ X.functionField (φk a) = scalarFun sX a := fun a =>
    (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ⊤)
      (show x ∈ (⊤ : X.Opens) from trivial) _).trans rfl
  let p : Submodule k (ι → k) :=
    { carrier := {c | ∑ i, φk (c i) * r i ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib] at *
        exact Ideal.add_mem _ ha hb
      zero_mem' := by simp
      smul_mem' := by
        intro a c hc
        simp only [Set.mem_setOf_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc] at *
        rw [← Finset.mul_sum]
        exact Ideal.mul_mem_left _ _ hc }
  have hjp : (Pi.single j 1 : ι → k) ∉ p := by
    intro h
    have h' : ∑ i, φk ((Pi.single j 1 : ι → k) i) * r i ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) := h
    rw [Finset.sum_eq_single j (fun i _ hi => by simp [Pi.single_apply, hi]) (by simp),
      Pi.single_eq_same, map_one, one_mul] at h'
    exact (IsLocalRing.mem_maximalIdeal _).mp h' hunit
  obtain ⟨Q, hQ0, hQ⟩ := exists_polynomial_forall_notMem hjp
  refine ⟨Q, hQ0, fun c hc => ?_⟩
  have hcp := hQ c hc
  have hsu : IsUnit (∑ i, φk (c i) * r i) := by
    by_contra h
    exact hcp ((IsLocalRing.mem_maximalIdeal _).mpr h)
  have hsum : algebraMap _ X.functionField (∑ i, φk (c i) * r i) =
      (∑ i, scalarFun sX (c i) * g i) * ψf := by
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hφk, hr i, mul_assoc]
  have hne : (∑ i, scalarFun sX (c i) * g i) ≠ 0 := by
    intro h0
    have := (hsu.map (algebraMap _ X.functionField)).ne_zero
    rw [hsum, h0, zero_mul] at this
    exact this rfl
  refine ⟨hne, fun hx => ?_⟩
  obtain ⟨Γ, hΓ, hxΓ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  apply hΓ
  have h1 := ord_algebraMap_eq_zero_of_isUnit Γ hxΓ hsu
  rw [hsum, Scheme.ord_mul hne hψ0, hordψ Γ hxΓ] at h1
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  omega

/-- `⌊(p₀K(f + t) + β)/(p₀(pK + 1))⌋ ≤ ⌊f/p⌋` when `f ≥ 0`, `t ∈ {0, 1}` with `f = β = 0` if
`t = 1`, and `β < p₀K`. -/
private theorem floor_div_le_floor_div {p p₀ K : ℕ} (hp : 0 < p) (hp₀ : 0 < p₀) {f t β : ℤ}
    (hf : 0 ≤ f) (hβ : 0 ≤ β) (ht : t = 0 ∨ (t = 1 ∧ f = 0 ∧ β = 0)) (hK : β < p₀ * K) :
    ⌊(((p₀ * K : ℕ) * (f + t) + β : ℤ) : ℝ) / ((p₀ * (p * K + 1) : ℕ) : ℝ)⌋ ≤
      ⌊((1 / (p : ℚ) : ℚ) : ℝ) * f⌋ := by
  have hb : (0 : ℝ) < ((p₀ * (p * K + 1) : ℕ) : ℝ) := by positivity
  set q := ⌊((1 / (p : ℚ) : ℚ) : ℝ) * f⌋ with hqdef
  have hp' : (0 : ℝ) < p := by exact_mod_cast hp
  have hq : f < p * (q + 1) := by
    have h1 := Int.lt_floor_add_one (((1 / (p : ℚ) : ℚ) : ℝ) * f)
    rw [← hqdef] at h1
    push_cast at h1
    rw [div_mul_eq_mul_div, one_mul, div_lt_iff₀ hp'] at h1
    have h2 : (f : ℝ) < (p : ℝ) * ((q : ℝ) + 1) := by linarith
    exact_mod_cast h2
  have hq0 : 0 ≤ q := Int.floor_nonneg.mpr (by positivity)
  have key : ((p₀ * K : ℕ) * (f + t) + β : ℤ) < (q + 1) * ((p₀ * (p * K + 1) : ℕ) : ℤ) := by
    push_cast
    have hp₀' : (1 : ℤ) ≤ p₀ := by exact_mod_cast hp₀
    have hp1 : (1 : ℤ) ≤ p := by exact_mod_cast hp
    have hK0 : (0 : ℤ) ≤ K := by positivity
    rcases ht with rfl | ⟨rfl, rfl, rfl⟩
    · nlinarith
    · nlinarith
  rw [← Int.lt_add_one_iff, Int.floor_lt, div_lt_iff₀ hb]
  exact_mod_cast key

end Construction

/-! ### Strata of a reduced snc divisor -/

section Strata

variable {k : Type} [Field k]

/-- A divisor has finitely many strata. -/
private theorem finite_setOf_isSNCStratum {X : Scheme.{0}} [NoetherianSpace X]
    (Δ : Divisor X) : {W : Set X | IsSNCStratum Δ W}.Finite := by
  classical
  have hC : ∀ J : Finset (MMP.Mori.PrimeDivisor X),
      IsClosed (⋂ E ∈ J, (E.support : Set X)) := fun J =>
    isClosed_biInter fun E _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  refine (Set.Finite.biUnion (s := (Δ.support.powerset : Set (Finset _)))
    (Finset.finite_toSet _) fun J _ =>
      (MMP.Resolution.Aux.finite_and_cover_componentsOf (hC J)).1).subset ?_
  rintro W ⟨J, hJ, hmax⟩
  exact Set.mem_biUnion (Finset.mem_coe.2 (Finset.mem_powerset.2 hJ)) hmax

/-- A stratum is the closure of a point. -/
private theorem exists_eq_closure_of_isSNCStratum {X : Scheme.{0}} {Δ : Divisor X} {W : Set X}
    (hW : IsSNCStratum Δ W) : ∃ ξ : X, W = closure {ξ} := by
  obtain ⟨J, -, hmax⟩ := hW
  obtain ⟨ξ, -, hξ⟩ := MMP.Resolution.Aux.exists_eq_closure_of_mem_componentsOf
    (isClosed_biInter fun E _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure) hmax
  exact ⟨ξ, hξ⟩

/-- A member of a regular system of parameters outside a subfamily is not in the ideal the
subfamily generates. -/
private theorem notMem_span_image_of_isRegularSystemOfParameters {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {n : ℕ} {z : Fin n → R}
    (hz : MMP.Mori.IsRegularSystemOfParameters z) {s : Finset (Fin n)} {i : Fin n} (hi : i ∉ s) :
    z i ∉ Ideal.span (z '' (s : Set (Fin n))) := by
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  obtain ⟨hreg, -, hq⟩ := MMP.Flips.ResolutionInputs.isRegularSystemOfParameters_quotient_image hz s
  have hmem : i ∈ Set.range (sᶜ.orderEmbOfFin rfl) := by
    rw [Finset.range_orderEmbOfFin]; exact Finset.mem_coe.2 (Finset.mem_compl.2 hi)
  obtain ⟨j, hj⟩ := hmem
  intro h
  apply MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hq j
  change Ideal.Quotient.mk _ (z (sᶜ.orderEmbOfFin rfl j)) = 0
  rw [hj]
  exact Ideal.Quotient.eq_zero_iff_mem.2 h

/-- **The components through the generic point of a stratum are its index set.** If `closure {ξ}`
is an irreducible component of `⋂_{E ∈ J} E` for components `J` of an snc divisor `Δ`, every
component of `Δ` through `ξ` lies in `J`: otherwise its local equation is a parameter outside
those of `J`, and the prime they generate is a generization of `ξ` on `⋂_{E ∈ J} E`. -/
private theorem mem_of_maximal_closure {X : Scheme.{0}} [IsLocallyNoetherian X]
    {s : X ⟶ Spec (.of k)} {R : Type*} [Zero R] {Δ : DivisorWithCoeffs R X}
    (hΔ : DivisorWithCoeffs.IsSNC s Δ) {J : Finset (MMP.Mori.PrimeDivisor X)}
    (hJ : J ⊆ Δ.support) {ξ : X}
    (hmax : Maximal (fun T : Set X => IsIrreducible T ∧ T ⊆ ⋂ E ∈ J, (E.support : Set X))
      (closure {ξ}))
    {E : MMP.Mori.PrimeDivisor X} (hE : E ∈ Δ.support) (hξE : ξ ∈ E.support) : E ∈ J := by
  classical
  by_contra hEJ
  obtain ⟨n, z, j, hz, hj, hI⟩ := hΔ.2 ξ
  have hξJ : ∀ E' ∈ J, ξ ∈ E'.support := fun E' hE' => by
    have := hmax.prop.2 (subset_closure rfl : ξ ∈ closure {ξ})
    simp only [Set.mem_iInter] at this
    exact this E' hE'
  set J' : Finset (Fin n) := Finset.univ.filter fun i =>
    ∃ (E' : MMP.Mori.PrimeDivisor X) (h : E' ∈ J), j ⟨E', hJ h, hξJ E' h⟩ = i with hJ'
  have hiE : j ⟨E, hE, hξE⟩ ∉ J' := by
    simp only [hJ', Finset.mem_filter, Finset.mem_univ, true_and, not_exists]
    intro E' hE' he
    have := congrArg Subtype.val (hj he)
    exact hEJ (by rw [← show E' = E from this]; exact hE')
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  let q := MMP.Resolution.coordPrime hz J'
  have hzq : z (j ⟨E, hE, hξE⟩) ∉ q.asIdeal :=
    notMem_span_image_of_isRegularSystemOfParameters hz hiE
  have hq : q.asIdeal < (IsLocalRing.closedPoint (X.presheaf.stalk ξ)).asIdeal := by
    refine lt_of_le_of_ne (IsLocalRing.le_maximalIdeal q.2.ne_top) fun h => hzq ?_
    rw [h]
    change _ ∈ IsLocalRing.maximalIdeal _
    rw [← hz.1]
    exact Ideal.subset_span ⟨_, rfl⟩
  have hss := MMP.Resolution.closure_fromSpecStalk_ssubset hq
  rw [Scheme.fromSpecStalk_closedPoint] at hss
  have hsub : closure {X.fromSpecStalk ξ q} ⊆ ⋂ E' ∈ J, (E'.support : Set X) := by
    refine closure_minimal (Set.singleton_subset_iff.2 ?_) (isClosed_biInter fun E' _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure)
    simp only [Set.mem_iInter]
    intro E' hE'
    refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E'.idealSheaf ξ q).2 ?_
    rw [hI ⟨E', hJ hE', hξJ E' hE'⟩]
    refine (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨_, ?_, rfl⟩)
    simp only [hJ', Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq]
    exact ⟨E', hE', rfl⟩
  exact hss.2 (hmax.2 ⟨isIrreducible_singleton.closure, hsub⟩ hss.1)

/-- **A stratum of `Δ - S` does not lie on `S`.** -/
private theorem not_subset_of_isSNCStratum_sub_single {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (sX : X ⟶ Spec (.of k)) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) {W : Set X}
    (hW : IsSNCStratum (Δ - Finsupp.single S 1) W) : ¬ W ⊆ S.support := by
  classical
  obtain ⟨J, hJ, hmax⟩ := hW
  obtain ⟨ξ, rfl⟩ := exists_eq_closure_of_isSNCStratum ⟨J, hJ, hmax⟩
  intro hsub
  have hJΔ : J ⊆ Δ.support := fun E hE => by
    have h := hJ hE
    rw [Finsupp.mem_support_iff] at h ⊢
    intro h0
    apply h
    rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
    split_ifs with hSE
    · subst hSE
      rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
      exact absurd h0 one_ne_zero
    · rfl
  have hSΔ : S ∈ Δ.support := by
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, hS]; exact one_ne_zero
  have hSJ := mem_of_maximal_closure hΔ.2 hJΔ hmax hSΔ (hsub (subset_closure rfl))
  have h := hJ hSJ
  rw [Finsupp.mem_support_iff, Finsupp.sub_apply, Finsupp.single_eq_same,
    ← DivisorWithCoeffs.coeff_apply, hS, sub_self] at h
  exact h rfl

/-- **A stratum of `(Δ - S)|_S` maps onto a stratum of `Δ`.** -/
private theorem exists_isSNCStratum_subset_image {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [NoetherianSpace X] (sX : X ⟶ Spec (.of k))
    {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    {W : Set (haveI := S.integral; S.idealSheaf.subscheme)}
    (hW : haveI := S.integral;
      IsSNCStratum ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) W) :
    haveI := S.integral
    ∃ W' : Set X, IsSNCStratum Δ W' ∧ W' ⊆ S.idealSheaf.subschemeι '' W := by
  haveI := S.integral
  classical
  set ι := S.idealSheaf.subschemeι with hιdef
  have hemb := ι.isClosedEmbedding
  have hrange : ∀ y : X, y ∈ S.support → ∃ t, ι t = y := fun y hy => by
    have : y ∈ Set.range ι := by
      rw [Scheme.IdealSheafData.range_subschemeι]; exact hy
    exact this
  have hιS : ∀ t, ι t ∈ S.support := fun t => by
    have : ι t ∈ Set.range ι := ⟨t, rfl⟩
    rw [Scheme.IdealSheafData.range_subschemeι] at this
    exact this
  have hspec : ∀ a b, ι a ⤳ ι b ↔ a ⤳ b := fun a b => hemb.isInducing.specializes_iff
  have hclS : ∀ E : MMP.Mori.PrimeDivisor X, IsClosed (E.support : Set X) := fun E => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  have hSΔ : S ∈ Δ.support := by
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, hS]; exact one_ne_zero
  have hsubΔ : ∀ E ∈ (Δ - Finsupp.single S 1).support, E ∈ Δ.support ∧ E ≠ S := by
    intro E hE
    refine ⟨?_, fun hES => ?_⟩
    · rw [Finsupp.mem_support_iff] at hE ⊢
      intro h0
      apply hE
      rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
      split_ifs with hSE
      · subst hSE
        rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
        exact absurd h0 one_ne_zero
      · rfl
    · subst hES
      rw [Finsupp.mem_support_iff, Finsupp.sub_apply, Finsupp.single_eq_same,
        ← DivisorWithCoeffs.coeff_apply, hS, sub_self] at hE
      exact hE rfl
  have hΔS : (Δ - Finsupp.single S 1).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_eq_same, hS, sub_self]
  obtain ⟨J', hJ', hmax'⟩ := hW
  obtain ⟨ξ', rfl⟩ := exists_eq_closure_of_isSNCStratum ⟨J', hJ', hmax'⟩
  set x := ι ξ' with hxdef
  have hξ'J : ∀ P ∈ J', ξ' ∈ P.support := fun P hP => by
    have := hmax'.prop.2 (subset_closure rfl : ξ' ∈ closure {ξ'})
    simp only [Set.mem_iInter] at this
    exact this P hP
  -- every member of `J'` lies on a component of `Δ - S`
  have hcomp : ∀ P ∈ J', ∃ E ∈ (Δ - Finsupp.single S 1).support, ι P.genericPoint ∈ E.support := by
    intro P hP
    have hP := hJ' hP
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_restrictPrimeDivisor _ S hΔS P] at hP
    obtain ⟨E, hE, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hP
    refine ⟨E, hE, ?_⟩
    by_contra hnot
    apply hne
    change E.intersectionLength ι P • _ = 0
    rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem ι E hnot, zero_smul]
  set JX := Δ.support.filter fun E => x ∈ E.support with hJXdef
  have hxJX : x ∈ ⋂ E ∈ JX, (E.support : Set X) := by
    simp only [Set.mem_iInter, hJXdef, Finset.mem_filter]
    exact fun E hE => hE.2
  have hclJX : IsClosed (⋂ E ∈ JX, (E.support : Set X)) := isClosed_biInter fun E _ => hclS E
  refine ⟨closure {x}, ⟨JX, Finset.filter_subset _ _, ⟨isIrreducible_singleton.closure,
    closure_minimal (Set.singleton_subset_iff.2 hxJX) hclJX⟩, fun T' hT' hxT' => ?_⟩, ?_⟩
  · obtain ⟨y, hy⟩ := QuasiSober.sober hT'.1.closure isClosed_closure
    have hyx : y ⤳ x := hy.specializes (subset_closure (hxT' (subset_closure rfl)))
    have hyJX : y ∈ ⋂ E ∈ JX, (E.support : Set X) :=
      closure_minimal hT'.2 hclJX hy.mem
    have hyE : ∀ E ∈ JX, y ∈ E.support := by
      simp only [Set.mem_iInter] at hyJX; exact hyJX
    have hSJX : S ∈ JX := Finset.mem_filter.2 ⟨hSΔ, hιS ξ'⟩
    obtain ⟨y', rfl⟩ := hrange y (hyE S hSJX)
    have hy'ξ' : y' ⤳ ξ' := (hspec _ _).1 hyx
    -- the key step: `y'` lies on every member of `J'`
    have hy'P : ∀ P ∈ J', y' ∈ P.support := by
      intro P hP
      obtain ⟨E, hE, hηE⟩ := hcomp P hP
      obtain ⟨hEΔ, hES⟩ := hsubΔ E hE
      have hηξ : P.genericPoint ⤳ ξ' := by
        have := hξ'J P hP
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at this
        exact specializes_iff_mem_closure.mpr this
      have hxE : x ∈ E.support :=
        ((hspec _ _).2 hηξ).mem_closed (hclS E) hηE
      have hEJX : E ∈ JX := Finset.mem_filter.2 ⟨hEΔ, hxE⟩
      obtain ⟨n, z, j, hz, hj, hI⟩ := hΔ.2.2 x
      set iE := j ⟨E, hEΔ, hxE⟩
      set iS := j ⟨S, hSΔ, hιS ξ'⟩
      let q := MMP.Resolution.coordPrime hz {iE, iS}
      have hle : ∀ (p : PrimeSpectrum (X.presheaf.stalk x)),
          X.fromSpecStalk x p ∈ E.support → X.fromSpecStalk x p ∈ S.support →
          q.asIdeal ≤ p.asIdeal := by
        intro p hpE hpS
        have h1 := (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E.idealSheaf x p).1 hpE
        have h2 := (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le S.idealSheaf x p).1 hpS
        rw [hI ⟨E, hEΔ, hxE⟩] at h1
        rw [hI ⟨S, hSΔ, hιS ξ'⟩] at h2
        refine Ideal.span_le.2 ?_
        rintro _ ⟨i, hi, rfl⟩
        simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
          Set.mem_singleton_iff] at hi
        rcases hi with rfl | rfl
        · exact (Ideal.span_singleton_le_iff_mem _).1 h1
        · exact (Ideal.span_singleton_le_iff_mem _).1 h2
      have hqE : X.fromSpecStalk x q ∈ E.support := by
        refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E.idealSheaf x q).2 ?_
        rw [hI ⟨E, hEΔ, hxE⟩]
        exact (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨iE, by simp, rfl⟩)
      have hqS : X.fromSpecStalk x q ∈ S.support := by
        refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le S.idealSheaf x q).2 ?_
        rw [hI ⟨S, hSΔ, hιS ξ'⟩]
        exact (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨iS, by simp, rfl⟩)
      -- the point `q` is the image of the generic point of `P`
      obtain ⟨pw, hpw⟩ := MMP.Resolution.exists_fromSpecStalk_eq_of_specializes
        ((hspec _ _).2 hηξ)
      have hqw : X.fromSpecStalk x q ⤳ ι P.genericPoint := by
        rw [← hpw]
        exact specializes_iff_mem_closure.mpr
          ((MMP.Resolution.fromSpecStalk_mem_closure_iff x q pw).2
            (hle pw (hpw ▸ hηE) (hpw ▸ hιS _)))
      obtain ⟨t, ht⟩ := hrange _ hqS
      have htP : t ⤳ P.genericPoint := (hspec _ _).1 (ht ▸ hqw)
      have htη : t = P.genericPoint := by
        by_contra hne
        have hlt : P.genericPoint < t := lt_of_le_not_ge htP fun h => hne (htP.antisymm h).eq
        have h1 := Order.coheight_add_one_le hlt
        rw [MMP.Mori.PrimeDivisor.coheight_genericPoint] at h1
        have h0 : Order.coheight t = 0 := by
          have : Order.coheight t + 1 ≤ 0 + 1 := by simpa using h1
          exact le_antisymm (by exact_mod_cast (WithTop.add_le_add_iff_right
            (WithTop.one_ne_top)).1 this) bot_le
        have hmaxt : IsMax t := Order.coheight_eq_zero.mp h0
        have htg : t = genericPoint S.idealSheaf.subscheme :=
          ((genericPoint_specializes t).antisymm (hmaxt (genericPoint_specializes t))).eq.symm
        have hSE : S.genericPoint ∈ E.support := by
          have : ι (genericPoint S.idealSheaf.subscheme) = S.genericPoint := rfl
          rw [← this, ← htg, ht]; exact hqE
        exact hES (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (E.eq_genericPoint_of_mem_support hSE S.coheight_genericPoint).symm)
      -- `y` specializes from `q`, hence lies over `P`
      obtain ⟨py, hpy⟩ := MMP.Resolution.exists_fromSpecStalk_eq_of_specializes hyx
      have hqy : X.fromSpecStalk x q ⤳ ι y' := by
        rw [← hpy]
        exact specializes_iff_mem_closure.mpr
          ((MMP.Resolution.fromSpecStalk_mem_closure_iff x q py).2
            (hle py (hpy ▸ hyE E hEJX) (hpy ▸ hιS _)))
      rw [← ht, htη, hspec] at hqy
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact specializes_iff_mem_closure.mp hqy
    have hsub' : closure {y'} ⊆ ⋂ P ∈ J', (P.support : Set _) := by
      refine closure_minimal (Set.singleton_subset_iff.2 ?_) (isClosed_biInter fun P _ => by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure)
      simp only [Set.mem_iInter]
      exact hy'P
    have h1 := hmax'.2 ⟨isIrreducible_singleton.closure, hsub'⟩
      (closure_minimal (Set.singleton_subset_iff.2 (specializes_iff_mem_closure.mp hy'ξ'))
        isClosed_closure)
    have hξy : ξ' ⤳ y' := specializes_iff_mem_closure.mpr (h1 (subset_closure rfl))
    have heq : y' = ξ' := (hy'ξ'.antisymm hξy).eq
    rw [heq] at hy
    exact subset_closure.trans hy.def.symm.subset
  · have := hemb.closure_image_eq {ξ'}
    rw [Set.image_singleton] at this
    rw [this]

end Strata

section ExtTail

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  {Z : Scheme.{0}} (f : X ⟶ Z)

/-- Removing a component from a reduced snc divisor leaves a reduced snc divisor. -/
private theorem isReducedSNC_sub_single {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) :
    IsReducedSNC sX (Δ - Finsupp.single S 1) := by
  classical
  have hcoeff : ∀ P, (Δ - Finsupp.single S 1).coeff P = if S = P then 0 else Δ.coeff P := by
    intro P
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_apply]
    split_ifs with h
    · subst h; rw [hS, sub_self]
    · rw [sub_zero]
  refine ⟨fun P => ?_, hΔ.2.of_support_subset fun P hP => ?_⟩
  · rw [hcoeff P]; split_ifs
    · exact Or.inl rfl
    · exact hΔ.1 P
  · rw [Finsupp.mem_support_iff] at hP ⊢
    rw [← DivisorWithCoeffs.coeff_apply, hcoeff P] at hP
    split_ifs at hP
    · exact absurd rfl hP
    · rwa [← DivisorWithCoeffs.coeff_apply]

/-- A stratum of `Δ - S` is a stratum of `Δ`. -/
private theorem isSNCStratum_of_sub_single {Δ : Divisor X} (S : MMP.Mori.PrimeDivisor X)
    (hS : Δ.coeff S = 1) {T : Set X} (hT : IsSNCStratum (Δ - Finsupp.single S 1) T) :
    IsSNCStratum Δ T := by
  classical
  obtain ⟨J, hJ, hmax⟩ := hT
  refine ⟨J, fun P hP => ?_, hmax⟩
  have h := hJ hP
  rw [Finsupp.mem_support_iff] at h ⊢
  intro h0
  apply h
  rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
  split_ifs with hSP
  · subst hSP
    rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
    exact absurd h0 one_ne_zero
  · rfl

/-- A set containing no stratum of `Δ` contains no stratum of `Δ - S`. -/
private theorem containsNoStratum_sub_single {Δ : Divisor X} (S : MMP.Mori.PrimeDivisor X)
    (hS : Δ.coeff S = 1) {T : Set X} (hT : ContainsNoStratum Δ T) :
    ContainsNoStratum (Δ - Finsupp.single S 1) T :=
  fun T' hT' => hT T' (isSNCStratum_of_sub_single S hS hT')

/-- A union of two closed sets containing no stratum contains no stratum. -/
private theorem containsNoStratum_union {Δ : Divisor X} {T₁ T₂ : Set X} (h₁ : IsClosed T₁)
    (h₂ : IsClosed T₂) (hT₁ : ContainsNoStratum Δ T₁) (hT₂ : ContainsNoStratum Δ T₂) :
    ContainsNoStratum Δ (T₁ ∪ T₂) := by
  intro T hT hsub
  obtain ⟨J, hJ, hmax⟩ := hT
  have hirr := hmax.prop.1.isPreirreducible
  by_cases hs₁ : T ⊆ T₁
  · exact hT₁ T ⟨J, hJ, hmax⟩ hs₁
  by_cases hs₂ : T ⊆ T₂
  · exact hT₂ T ⟨J, hJ, hmax⟩ hs₂
  obtain ⟨x₁, hx₁, hx₁'⟩ := Set.not_subset.mp hs₁
  obtain ⟨x₂, hx₂, hx₂'⟩ := Set.not_subset.mp hs₂
  obtain ⟨z, hz, hz₁, hz₂⟩ := hirr T₁ᶜ T₂ᶜ h₁.isOpen_compl h₂.isOpen_compl ⟨x₁, hx₁, hx₁'⟩
    ⟨x₂, hx₂, hx₂'⟩
  rcases hsub hz with h | h
  · exact hz₁ h
  · exact hz₂ h

/-! ### Restriction to `S` of sections and of divisors -/

/-- A section of `𝒪_X(M)`, for `S` not a component of `M`, restricts to `S`. -/
private theorem exists_isRestrictionAlong_of_mem_sectionsIn (S : MMP.Mori.PrimeDivisor X)
    {M : Divisor X} (hM : M.coeff S = 0) {g : X.functionField} (hg : g ∈ sectionsIn M) :
    haveI := S.integral
    ∃ h : S.idealSheaf.subscheme.functionField, IsRestrictionAlong S g h := by
  haveI := S.integral
  rcases eq_or_ne g 0 with rfl | hg0
  · exact ⟨0, 0, map_zero _, map_zero _⟩
  have hnn : ∀ Γ : MMP.Mori.PrimeDivisor X,
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ∈ Γ.support →
        0 ≤ X.ord g Γ.genericPoint := by
    intro Γ hΓ
    rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ]
    have h := hg S
    rw [S.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp, hM] at h
    omega
  obtain ⟨a, ha⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg
    (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) hg0 hnn
  exact ⟨_, a, ha, rfl⟩

/-- The image series in degree `m` consists of the restrictions of sections of `𝒪_X(mD)`. -/
private theorem mem_imageSeries_iff (D : Divisor X) (S : MMP.Mori.PrimeDivisor X) (m : ℕ)
    (h : haveI := S.integral; S.idealSheaf.subscheme.functionField) :
    h ∈ imageSeries D S m ↔ ∃ g ∈ sectionsIn ((m : ℤ) • D), IsRestrictionAlong S g h := by
  haveI := S.integral
  constructor
  · intro hh
    refine AddSubgroup.closure_induction
      (p := fun h _ => ∃ g ∈ sectionsIn ((m : ℤ) • D), IsRestrictionAlong S g h)
      (fun h hh => hh) ⟨0, (sectionsSubgroup _).zero_mem, 0, map_zero _, map_zero _⟩ ?_ ?_ hh
    · rintro h₁ h₂ - - ⟨g₁, hg₁, a₁, ha₁, hb₁⟩ ⟨g₂, hg₂, a₂, ha₂, hb₂⟩
      exact ⟨g₁ + g₂, (sectionsSubgroup _).add_mem hg₁ hg₂, a₁ + a₂,
        by rw [map_add, ha₁, ha₂], by rw [map_add, hb₁, hb₂]⟩
    · rintro h₁ - ⟨g₁, hg₁, a₁, ha₁, hb₁⟩
      exact ⟨-g₁, (sectionsSubgroup _).neg_mem hg₁, -a₁, by rw [map_neg, ha₁],
        by rw [map_neg, hb₁]⟩
  · exact fun hh => AddSubgroup.subset_closure hh

/-- Restriction to `S` respects combinations with scalar coefficients. -/
private theorem isRestrictionAlong_sum (S : MMP.Mori.PrimeDivisor X) {ι : Type*} [Fintype ι]
    (g : ι → X.functionField) (h : ι → (haveI := S.integral; S.idealSheaf.subscheme.functionField))
    (hgh : ∀ i, IsRestrictionAlong S (g i) (h i)) (c : ι → k) :
    haveI := S.integral
    IsRestrictionAlong S (∑ i, scalarFun sX (c i) * g i)
      (∑ i, scalarFun (S.idealSheaf.subschemeι ≫ sX) (c i) * h i) := by
  haveI := S.integral
  classical
  choose a ha hb using hgh
  let φ : k → X.presheaf.stalk (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) :=
    fun c => X.presheaf.germ ⊤ _ trivial (sX.appTop ((Scheme.ΓSpecIso (.of k)).inv.hom c))
  refine ⟨∑ i, φ (c i) * a i, ?_, ?_⟩
  · rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, ha i]
    congr 1
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  · rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hb i]
    congr 1
    have key : (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
        (X.presheaf.germ ⊤ (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))
          (show _ ∈ (⊤ : X.Opens) from trivial) ≫
          S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)) =
        (Scheme.ΓSpecIso (.of k)).inv ≫ (S.idealSheaf.subschemeι ≫ sX).appTop ≫
          S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint S.idealSheaf.subscheme)
            (show _ ∈ (⊤ : S.idealSheaf.subscheme.Opens) from trivial) := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.comp_appTop, Category.assoc]
      rfl
    exact congrArg (fun ψ => ψ.hom (c i)) key

/-- A unit at the generic point of `S` has nonzero restriction. -/
private theorem ne_zero_of_isRestrictionAlong (S : MMP.Mori.PrimeDivisor X)
    {g : X.functionField} {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hg0 : g ≠ 0) (hord : X.ord g S.genericPoint = 0) :
    h ≠ 0 := by
  haveI := S.integral
  obtain ⟨a, ha, hb⟩ := hgh
  have hv : S.divisorialValuation g = 1 := by
    rw [S.divisorialValuation_eq_exp_neg_ord hg0, hord, neg_zero, WithZero.exp_zero]
  have hnm : a ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk S.genericPoint) := by
    intro hm
    have h1 := (MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff S a).2 hm
    have h2 : algebraMap S.localRing X.functionField a = g := ha
    rw [h2, hv] at h1
    exact lt_irrefl _ h1
  have hu : IsUnit a := IsLocalRing.notMem_maximalIdeal.mp hnm
  rw [← hb]
  exact (hu.map _).ne_zero

/-- The coefficients of a restriction as a sum over any finite set containing the support. -/
private theorem coeff_restrictPrimeDivisor_eq_sum [NoetherianSpace X] {R : Type*} [AddCommMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (hs : D.support ⊆ s)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    (D.restrictPrimeDivisor S).coeff Q =
      ∑ E ∈ s, E.intersectionLength (haveI := S.integral; S.idealSheaf.subschemeι) Q •
        D.coeff E := by
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D S hD Q]
  exact Finsupp.sum_of_support_subset D hs _ (fun E _ => smul_zero _)

/-- **The restriction of a principal divisor is principal**: `(M + div g)|_S = M|_S + div(g|_S)`
for `S` a component of neither. -/
private theorem restrictPrimeDivisor_add_ffDiv [NoetherianSpace X] (hsm : IsSmoothScheme sX)
    (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    (M : Divisor X) (hM : M.coeff S = 0) {g : X.functionField}
    {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hg0 : g ≠ 0) (hh0 : h ≠ 0) :
    haveI := S.integral
    (M + ffDiv g hg0).restrictPrimeDivisor S = M.restrictPrimeDivisor S + ffDiv h hh0 := by
  haveI := S.integral
  classical
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  obtain ⟨a, ha, hb⟩ := hgh
  have hu : IsUnit a := isUnit_of_map_unit
    (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a (by
      rw [hb]; exact isUnit_iff_ne_zero.mpr hh0)
  have ha' : algebraMap _ X.functionField a = g := ha
  have hSmem : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ∈ S.support := by
    change S.genericPoint ∈ S.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hordS : X.ord g S.genericPoint = 0 := by
    rw [← ha']; exact ord_algebraMap_eq_zero_of_isUnit S hSmem hu
  have hgS : (ffDiv g hg0).coeff S = 0 := by rw [MMP.Mori.coeff_principalDivisor_mk0, hordS]
  have hMg : (M + ffDiv g hg0).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hM, hgS, add_zero]
  set s := M.support ∪ (ffDiv g hg0).support with hs
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add,
    coeff_restrictPrimeDivisor_eq_sum S hMg s Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum S hM s Finset.subset_union_left Q,
    MMP.Mori.coeff_principalDivisor_mk0 h hh0 Q, ← hb,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX S.idealSheaf.subschemeι a hu Q s
      (fun E hE => by
      rw [ha'] at hE
      refine Finset.mem_union_right _ (Finsupp.mem_support_iff.2 ?_)
      rw [← DivisorWithCoeffs.coeff_apply, MMP.Mori.coeff_principalDivisor_mk0]
      exact hE), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_add, smul_add, ha', MMP.Mori.coeff_principalDivisor_mk0, nsmul_eq_mul,
    nsmul_eq_mul]

/-- Restriction to `S` is additive on divisors of which `S` is not a component. -/
private theorem restrictPrimeDivisor_add [NoetherianSpace X] (S : MMP.Mori.PrimeDivisor X)
    {M₁ M₂ : Divisor X} (h₁ : M₁.coeff S = 0) (h₂ : M₂.coeff S = 0) :
    (M₁ + M₂).restrictPrimeDivisor S = M₁.restrictPrimeDivisor S + M₂.restrictPrimeDivisor S := by
  classical
  have h₁₂ : (M₁ + M₂).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_add, h₁, h₂, add_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add,
    coeff_restrictPrimeDivisor_eq_sum S h₁₂ (M₁.support ∪ M₂.support) Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum S h₁ (M₁.support ∪ M₂.support)
      Finset.subset_union_left Q,
    coeff_restrictPrimeDivisor_eq_sum S h₂ (M₁.support ∪ M₂.support)
      Finset.subset_union_right Q, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_add, smul_add]

/-- Restriction to `S` commutes with integer multiples. -/
private theorem restrictPrimeDivisor_zsmul [NoetherianSpace X] (S : MMP.Mori.PrimeDivisor X)
    {M : Divisor X} (hM : M.coeff S = 0) (n : ℤ) :
    (n • M).restrictPrimeDivisor S = n • M.restrictPrimeDivisor S := by
  classical
  have hn : (n • M).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_smul, hM, smul_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_smul,
    coeff_restrictPrimeDivisor_eq_sum S hn M.support Finsupp.support_smul Q,
    coeff_restrictPrimeDivisor_eq_sum S hM M.support subset_rfl Q, Finset.smul_sum]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_smul, smul_comm]

/-- Restriction to `S` commutes with rational multiples of integral divisors. -/
private theorem restrictPrimeDivisor_smul_toQDivisor [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {M : Divisor X} (hM : M.coeff S = 0) (r : ℚ) :
    (r • Divisor.toQDivisor M).restrictPrimeDivisor S =
      r • Divisor.toQDivisor (M.restrictPrimeDivisor S) := by
  classical
  have hr : (r • Divisor.toQDivisor M).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, hM]; simp
  have hsub : (r • Divisor.toQDivisor M).support ⊆ M.support := by
    intro E hE
    rw [Finsupp.mem_support_iff] at hE ⊢
    intro h0
    apply hE
    rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
      DivisorWithCoeffs.coeff_apply, h0]
    simp
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
    coeff_restrictPrimeDivisor_eq_sum S hr M.support hsub Q,
    coeff_restrictPrimeDivisor_eq_sum S hM M.support subset_rfl Q]
  push_cast
  rw [smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, nsmul_eq_mul, nsmul_eq_mul,
    smul_eq_mul]
  push_cast
  ring

/-- The restriction of an effective divisor is effective. -/
private theorem coeff_restrictPrimeDivisor_nonneg [NoetherianSpace X] {R : Type*}
    [AddCommMonoid R] [PartialOrder R] [IsOrderedAddMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hD : D.coeff S = 0)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    0 ≤ (D.restrictPrimeDivisor S).coeff Q := by
  rw [coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q]
  exact Finset.sum_nonneg fun E _ => nsmul_nonneg (hD0 E) _

/-- The support of a restriction lies over the support. -/
private theorem image_supp_restrictPrimeDivisor_subset [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {D : QDivisor X} (hD : D.coeff S = 0) :
    haveI := S.integral
    S.idealSheaf.subschemeι '' ((D.restrictPrimeDivisor S).supp : Set _) ⊆ D.supp := by
  haveI := S.integral
  classical
  rintro _ ⟨x, hx, rfl⟩
  obtain ⟨Q, hQ, hxQ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  rw [coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q] at hQ
  obtain ⟨E, -, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hQ
  have hEQ : S.idealSheaf.subschemeι Q.genericPoint ∈ E.support := by
    by_contra hnot
    apply hne
    rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hnot, zero_smul]
  refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, fun h0 => hne (by rw [h0, smul_zero]), ?_⟩
  have hsp : Q.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxQ
    exact specializes_iff_mem_closure.mpr hxQ
  exact (hsp.map S.idealSheaf.subschemeι.continuous).mem_closed
    (by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure) hEQ

end ExtTail

end ExtToolkit

section Nonvanishing

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- `g` is a section of `𝒪_X(M)` not vanishing at `x`: `x` lies on no component of the effective
divisor `M + div g`. -/
private def IsNonvanishingAt (M : Divisor X) (g : X.functionField) (x : X) : Prop :=
  ∃ hg : g ≠ 0, g ∈ sectionsIn M ∧ x ∉ (M + ffDiv g hg).supp

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- A point of the support of the sum of two effective divisors lies on one of them. -/
private theorem mem_supp_of_mem_supp_add {D₁ D₂ : Divisor X} (h₁ : ∀ E, 0 ≤ D₁.coeff E)
    (h₂ : ∀ E, 0 ≤ D₂.coeff E) {x : X} (hx : x ∈ (D₁ + D₂).supp) :
    x ∈ D₁.supp ∨ x ∈ D₂.supp := by
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  rw [DivisorWithCoeffs.coeff_add] at hE
  by_cases h : D₁.coeff E = 0
  · right; exact DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, by rw [h, zero_add] at hE; exact hE, hxE⟩
  · left; exact DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, h, hxE⟩

private theorem ffDiv_mul {g₁ g₂ : X.functionField} (h₁ : g₁ ≠ 0) (h₂ : g₂ ≠ 0) :
    ffDiv (g₁ * g₂) (mul_ne_zero h₁ h₂) = ffDiv g₁ h₁ + ffDiv g₂ h₂ := by
  ext E
  change (ffDiv (g₁ * g₂) _).coeff E = (ffDiv g₁ h₁ + ffDiv g₂ h₂).coeff E
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0, MMP.Mori.coeff_principalDivisor_mk0,
    MMP.Mori.coeff_principalDivisor_mk0, Scheme.ord_mul h₁ h₂]

private theorem IsNonvanishingAt.mul {M₁ M₂ : Divisor X} {g₁ g₂ : X.functionField} {x : X}
    (h₁ : IsNonvanishingAt M₁ g₁ x) (h₂ : IsNonvanishingAt M₂ g₂ x) :
    IsNonvanishingAt (M₁ + M₂) (g₁ * g₂) x := by
  obtain ⟨hg₁, hs₁, hx₁⟩ := h₁
  obtain ⟨hg₂, hs₂, hx₂⟩ := h₂
  have hdiv : M₁ + M₂ + ffDiv (g₁ * g₂) (mul_ne_zero hg₁ hg₂) =
      (M₁ + ffDiv g₁ hg₁) + (M₂ + ffDiv g₂ hg₂) := by rw [ffDiv_mul hg₁ hg₂]; abel
  refine ⟨mul_ne_zero hg₁ hg₂, mem_sectionsIn_of_coeff_nonneg (mul_ne_zero hg₁ hg₂) fun P => ?_,
    fun hx => ?_⟩
  · rw [hdiv, DivisorWithCoeffs.coeff_add]
    exact add_nonneg (coeff_add_ffDiv_nonneg hs₁ hg₁ P) (coeff_add_ffDiv_nonneg hs₂ hg₂ P)
  · rw [hdiv] at hx
    rcases mem_supp_of_mem_supp_add (coeff_add_ffDiv_nonneg hs₁ hg₁)
      (coeff_add_ffDiv_nonneg hs₂ hg₂) hx with h | h
    · exact hx₁ h
    · exact hx₂ h

private theorem isNonvanishingAt_zero_one (x : X) : IsNonvanishingAt (0 : Divisor X) 1 x := by
  have h1 : ffDiv (1 : X.functionField) one_ne_zero = 0 := by
    ext E
    change (ffDiv (1 : X.functionField) _).coeff E = (0 : Divisor X).coeff E
    rw [MMP.Mori.coeff_principalDivisor_mk0, ord_one', DivisorWithCoeffs.coeff_zero]
  refine ⟨one_ne_zero, mem_sectionsIn_of_coeff_nonneg one_ne_zero fun P => ?_, ?_⟩
  · rw [h1, add_zero]; exact le_rfl
  · rw [h1, add_zero, DivisorWithCoeffs.supp_zero]; exact fun h => h

private theorem IsNonvanishingAt.pow {M : Divisor X} {g : X.functionField} {x : X}
    (h : IsNonvanishingAt M g x) (k : ℕ) : IsNonvanishingAt ((k : ℤ) • M) (g ^ k) x := by
  induction k with
  | zero => simpa using isNonvanishingAt_zero_one x
  | succ k ih =>
    have := ih.mul h
    rw [← pow_succ] at this
    convert this using 1
    push_cast; rw [add_smul, one_smul]

/-- Shifting the divisor by a principal divisor and the section by the inverse function. -/
private theorem IsNonvanishingAt.add_principalDivisor {M : Divisor X} {g : X.functionField}
    {x : X} (h : IsNonvanishingAt M g x) (u : (RationalFunctions X)ˣ) :
    IsNonvanishingAt (M + principalDivisor u)
      (g * (rationalFunctionsEquivFunctionField X u)⁻¹) x := by
  obtain ⟨hg, hs, hx⟩ := h
  have hu0 : rationalFunctionsEquivFunctionField X u ≠ 0 :=
    (u.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hg' : g * (rationalFunctionsEquivFunctionField X u)⁻¹ ≠ 0 :=
    mul_ne_zero hg (inv_ne_zero hu0)
  have hdiv : M + principalDivisor u + ffDiv _ hg' = M + ffDiv g hg := by
    ext E
    change (M + principalDivisor u + ffDiv _ hg').coeff E = (M + ffDiv g hg).coeff E
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_add,
      MMP.Mori.coeff_principalDivisor_mk0, MMP.Mori.coeff_principalDivisor_mk0, coeff_principalDivisor,
      MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField,
      Scheme.ord_mul hg (inv_ne_zero hu0), ← zpow_neg_one, MMP.Mori.ord_zpow _ hu0]
    ring
  refine ⟨hg', mem_sectionsIn_of_coeff_nonneg hg' fun P => ?_, ?_⟩
  · rw [hdiv]; exact coeff_add_ffDiv_nonneg hs hg P
  · rw [hdiv]; exact hx

omit [IsNormal X] [CompactSpace X] in
/-- Not vanishing at a point passes to its generizations. -/
private theorem IsNonvanishingAt.of_specializes [IsNormal X] [CompactSpace X] {M : Divisor X}
    {g : X.functionField} {x y : X} (h : IsNonvanishingAt M g x) (hyx : y ⤳ x) :
    IsNonvanishingAt M g y := by
  obtain ⟨hg, hs, hx⟩ := h
  exact ⟨hg, hs, fun hy => hx (hyx.mem_closed (M + ffDiv g hg).supp.isClosed hy)⟩

/-- Off the base locus of a linear series there is a member not vanishing at the point. -/
private theorem exists_isNonvanishingAt_of_notMem_baseLocusIn {V : Set X.functionField}
    {M : Divisor X} (hV : V ⊆ sectionsIn M) {x : X} (hx : x ∉ baseLocusIn V M) :
    ∃ g ∈ V, IsNonvanishingAt M g x := by
  simp only [baseLocusIn, Set.mem_setOf_eq, not_forall, not_exists, not_and] at hx
  obtain ⟨g, hgV, hg0, hP⟩ := hx
  have hgs := hV hgV
  refine ⟨g, hgV, hg0, hgs, fun hxs => ?_⟩
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hxs
  have h0 := coeff_add_ffDiv_nonneg hgs hg0 E
  have hlt : 0 < (M + ffDiv g hg0).coeff E := lt_of_le_of_ne h0 (Ne.symm hE)
  apply hP E hxE
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at hlt
  rw [E.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_lt_exp]
  omega

/-- A member of a linear series not vanishing at a point puts the point off the base locus. -/
private theorem notMem_baseLocusIn_of_mem_of_isNonvanishingAt {V : Set X.functionField}
    {M : Divisor X} {g : X.functionField} (hgV : g ∈ V) {x : X}
    (h : IsNonvanishingAt M g x) : x ∉ baseLocusIn V M := by
  obtain ⟨hg, hs, hx⟩ := h
  intro hB
  obtain ⟨E, hxE, hlt⟩ := hB g hgV hg
  apply hx
  refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hxE⟩
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  rw [E.divisorialValuation_eq_exp_neg_ord hg, WithZero.exp_lt_exp] at hlt
  omega

/-- **General position.** If every point of a finite set has a section of `𝒪_X(M)` not vanishing
there, one section does not vanish at any of them (the field being infinite). -/
private theorem exists_isNonvanishingAt_finset {k : Type} [Field k] [Infinite k]
    (sX : X ⟶ Spec (.of k)) {M : Divisor X} (hMc : M.IsCartier) (s : Finset X)
    (h : ∀ x ∈ s, ∃ g, IsNonvanishingAt M g x) :
    ∃ g, ∀ x ∈ s, IsNonvanishingAt M g x := by
  classical
  choose! g hg using h
  let ι := s
  let gs : ι → X.functionField := fun x => g x.1
  have hgs : ∀ i, gs i ∈ sectionsIn M := fun i => (hg i.1 i.2).2.1
  have hQ : ∀ x : ι, ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      ∃ hc : (∑ i, scalarFun sX (c i) * gs i) ≠ 0, x.1 ∉ (M + ffDiv _ hc).supp := fun x =>
    exists_polynomial_notMem_supp sX hMc gs hgs x.1 x (hg x.1 x.2).1 (hg x.1 x.2).2.2
  choose Q hQ0 hQ using hQ
  have hprod : (∏ x, Q x) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun x _ => hQ0 x
  obtain ⟨c, hc⟩ : ∃ c : ι → k, MvPolynomial.eval c (∏ x, Q x) ≠ 0 := by
    by_contra hall
    simp only [not_exists, not_not] at hall
    exact hprod (MvPolynomial.funext fun c => by rw [hall c, map_zero])
  rw [map_prod] at hc
  refine ⟨∑ i, scalarFun sX (c i) * gs i, fun x hx => ?_⟩
  obtain ⟨hne, hxs⟩ := hQ ⟨x, hx⟩ c (Finset.prod_ne_zero_iff.mp hc _ (Finset.mem_univ _))
  exact ⟨hne, sum_mem_sectionsIn sX gs hgs c, hxs⟩

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
private theorem IsNonvanishingAt.congr_left [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {M M' : Divisor X} {g : X.functionField} {x : X}
    (h : IsNonvanishingAt M g x) (hM : M = M') : IsNonvanishingAt M' g x := hM ▸ h

end Nonvanishing

section RestrictSections

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Restricting a section not vanishing at a point of `S`.** If `σ` is a section of `𝒪_X(M)`
not vanishing at `ι(x)` and `S` is not a component of `M`, its restriction `h` to `S` is a
section of `𝒪_S(M|_S)` not vanishing at `x`. -/
private theorem exists_restriction_isNonvanishingAt [NoetherianSpace X]
    (hsm : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    {M : Divisor X} (hM : M.coeff S = 0) {σ : X.functionField}
    {x : haveI := S.integral; S.idealSheaf.subscheme}
    (hσ : IsNonvanishingAt M σ (haveI := S.integral; S.idealSheaf.subschemeι x)) :
    haveI := S.integral
    ∃ h, IsRestrictionAlong S σ h ∧ IsNonvanishingAt (M.restrictPrimeDivisor S) h x := by
  haveI := S.integral
  obtain ⟨hσ0, hσs, hx⟩ := hσ
  obtain ⟨h, hh⟩ := exists_isRestrictionAlong_of_mem_sectionsIn S hM hσs
  have hxS : S.idealSheaf.subschemeι x ∈ S.support := by
    have : S.idealSheaf.subschemeι x ∈ Set.range S.idealSheaf.subschemeι.base := ⟨x, rfl⟩
    rwa [Scheme.IdealSheafData.range_subschemeι] at this
  have hES : (M + ffDiv σ hσ0).coeff S = 0 := by
    by_contra hne
    exact hx (DivisorWithCoeffs.mem_supp_iff.mpr ⟨S, hne, hxS⟩)
  have hord : X.ord σ S.genericPoint = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hM, zero_add, MMP.Mori.coeff_principalDivisor_mk0] at hES
    exact hES
  have hh0 := ne_zero_of_isRestrictionAlong S hh hσ0 hord
  have hres := restrictPrimeDivisor_add_ffDiv sX hsm S hSsm M hM hh hσ0 hh0
  refine ⟨h, hh, hh0, mem_sectionsIn_of_coeff_nonneg hh0 fun Q => ?_, fun hxs => ?_⟩
  · rw [← hres]
    exact coeff_restrictPrimeDivisor_nonneg S (coeff_add_ffDiv_nonneg hσs hσ0) hES Q
  · rw [← hres] at hxs
    apply hx
    have hsub := image_supp_restrictPrimeDivisor_subset S
      (D := Divisor.toQDivisor (M + ffDiv σ hσ0)) (by rw [Divisor.coeff_toQDivisor, hES]; simp)
    rw [Divisor.restrictPrimeDivisor_toQDivisor _ S hES, Divisor.supp_toQDivisor,
      Divisor.supp_toQDivisor] at hsub
    exact hsub ⟨x, hxs, rfl⟩

end RestrictSections

section Ampleness

variable {X Z : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (f : X ⟶ Z)

/-- A divisor very ample over an affine base is ample. -/
private theorem isAmple_of_hasImmersionTwistOver (hf : IsProjectiveMorphism f) [IsAffine Z]
    {A : Divisor X} (hAc : A.IsCartier)
    (hA : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A.divisorialSheaf) :
    A.IsAmple hAc := by
  haveI := hAc.isInvertibleModule_divisorialSheaf
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  obtain ⟨n, i, hi, hover, ⟨e⟩⟩ := hA
  have h5 : ∃ d : ℕ, 1 ≤ d ∧ Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f
      (Stacks.Ample.tensorPowModule X A.divisorialSheaf (d : ℤ)) :=
    ⟨1, le_rfl, n, i, hi, hover, ⟨Stacks.Ample.tensorPowModuleOneIso X _ ≪≫ e⟩⟩
  exact ((Stacks.AmpleRelativeFiniteType.tfae_six f A.divisorialSheaf).out 5 1).1 h5

/-- Relative ampleness is invariant under linear equivalence. -/
private theorem isRelativelyAmple_add_principalDivisor {L : Divisor X} (hLc : L.IsCartier)
    (hL : L.IsRelativelyAmple f hLc) (u : (MMP.Mori.RationalFunctions X)ˣ) :
    (L + MMP.Mori.principalDivisor u).IsRelativelyAmple f
      (hLc.add (Divisor.isCartier_principalDivisor u)) := by
  haveI := hLc.isInvertibleModule_divisorialSheaf
  haveI := (hLc.add (Divisor.isCartier_principalDivisor u)).isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, hamp⟩ := hL y
  refine ⟨V, hV, hyV, ?_⟩
  have e : (L + MMP.Mori.principalDivisor u).divisorialSheaf ≅ L.divisorialSheaf :=
    Divisor.divisorialSheafMulIso u fun E => by
      rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor]
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((RingedSpaceModuleAdjunction.modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e)).mpr
    hamp

/-- **An integral divisor with an `f`-ample multiple is ample**, for `f` projective over an
affine base. -/
private theorem isAmple_of_hasRelativelyAmpleMultiple (hf : IsProjectiveMorphism f) [IsAffine Z]
    {N : Divisor X} (hNc : N.IsCartier)
    (hN : (Divisor.toQDivisor N).HasRelativelyAmpleMultiple f) : N.IsAmple hNc := by
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hN
  have hL : L = m • N := Divisor.toQDivisor_injective (by rw [hLeq, map_nsmul, natCast_zsmul])
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI := hLc.isInvertibleModule_divisorialSheaf
  have hLX : Stacks.Ample.IsAmple X L.divisorialSheaf :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f _
      (stacks_of_isRelativelyAmple f _ hLamp)
  subst hL
  haveI := hNc.isInvertibleModule_divisorialSheaf
  have := (Stacks.RelativeVeryAmple.isAmple_congr _ _ (divisorialSheafNsmulIso hNc m)).mp hLX
  exact (Stacks.AmplePowers.isAmple_tensorPowModule_iff _ m hm).mpr this

/-- Adding an `f`-ample Cartier divisor preserves having an `f`-ample multiple. -/
private theorem hasRelativelyAmpleMultiple_add (hf : IsProjectiveMorphism f) {M : QDivisor X}
    (hM : M.HasRelativelyAmpleMultiple f) {Q : Divisor X} (hQc : Q.IsCartier)
    (hQ : Q.IsRelativelyAmple f hQc) :
    (M + Divisor.toQDivisor Q).HasRelativelyAmpleMultiple f := by
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hM
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  refine ⟨m, hm, L + m • Q, hLc.add (hQc.nsmul m), ?_, isRelativelyAmple_add hLc hLamp _
    (isRelativelyAmple_nsmul hQc hQ m hm)⟩
  rw [map_add, hLeq, map_nsmul, smul_add]
  simp [natCast_zsmul]

/-- Adding a principal divisor preserves having an `f`-ample multiple. -/
private theorem hasRelativelyAmpleMultiple_add_principalDivisor {M : QDivisor X}
    (hM : M.HasRelativelyAmpleMultiple f) (w : (RationalFunctions X)ˣ) :
    (M + Divisor.toQDivisor (principalDivisor w)).HasRelativelyAmpleMultiple f := by
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hM
  refine ⟨m, hm, L + principalDivisor (w ^ m), hLc.add (Divisor.isCartier_principalDivisor _), ?_,
    isRelativelyAmple_add_principalDivisor f hLc hLamp _⟩
  rw [map_add, hLeq, principalDivisor_pow, map_zsmul, smul_add]

open Stacks.AmpleProjectiveImmersion in
/-- **A relatively very ample divisor over an affine base is generated by finitely many global
sections**: the coordinate sections of `𝒪(1)` pull back along the closed immersion. -/
private theorem exists_generatingSections_of_hasImmersionTwistOver (hf : IsProjectiveMorphism f)
    [IsAffine Z] {Q : Divisor X}
    (hQ : HasImmersionTwistOver f Q.divisorialSheaf) :
    ∃ σ : Q.divisorialSheaf.GeneratingSections, Finite σ.I := by
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  obtain ⟨N, ι, hι, hover, ⟨e⟩⟩ := hQ
  have : IsClosedImmersion ι :=
    Stacks.AmpleFormalSystemEmbeddedTuple.isClosedImmersion_of_isImmersion_over (f := f) ι hι hover
  obtain ⟨ι', -, ⟨e'⟩⟩ := MMP.Fourfold.exists_isClosedImmersion_projectiveSpaceOverRing ι _ e
  let σ₀ : (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver N
      (Spec (.of Γ(Z, ⊤))) 1).GeneratingSections :=
    ⟨ULift (Fin (N + 1)), fun j => MMP.Fourfold.coordSection N j.down,
      MMP.Fourfold.epi_coordFreeHom N⟩
  let σ₁ := @SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _ σ₀
    (Scheme.Modules.pullback ι')
    (Scheme.Modules.pullbackPushforwardAdjunction ι').leftAdjoint_preservesColimits
    (asIso (Stacks.ProjectionFormula.pullbackUnitToUnit ι'.toLRSHom.toShHom)).symm
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ e'.inv :=
    @IsIso.epi_of_iso _ _ _ _ e'.inv inferInstance
  exact ⟨σ₁.ofEpi e'.inv, inferInstanceAs (Finite (ULift (Fin (N + 1))))⟩

end Ampleness

section Positivity

variable {k : Type} [Field k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z)

/-- A divisor generated by finitely many global sections has, at every point, a section not
vanishing there. -/
private theorem isNonvanishingAt_of_generatingSections (hsm : IsSmoothScheme sX)
    {M : Divisor X} (σ : M.divisorialSheaf.GeneratingSections) [Finite σ.I] (x : X) :
    ∃ g, IsNonvanishingAt M g x := by
  obtain ⟨W, hxW, ψ, hψ⟩ := MMP.Fourfold.isCartier_of_isSmoothScheme hsm M x
  obtain ⟨i, hi, hx⟩ := exists_notMem_supp_zeroDivisor σ hψ hxW
  set w := (Divisor.isUnit_sectionToRationalFunctions hi).unit with hwdef
  have hw0 : rationalFunctionsEquivFunctionField X w ≠ 0 :=
    (w.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hZ : M + ffDiv _ hw0 = M.zeroDivisor _ hi := by
    rw [ffDiv_rationalFunctionsEquivFunctionField, add_comm]
    rfl
  refine ⟨_, hw0, mem_sectionsIn_of_coeff_nonneg hw0 fun P => ?_, ?_⟩
  · rw [hZ]; exact MMP.Mori.Divisor.zeroDivisor_nonneg _ _ hi P
  · rw [hZ]; exact hx

/-- **Serre generation**: some multiple of an ample divisor has, at every point, a section not
vanishing there. -/
private theorem exists_nsmul_isNonvanishingAt_of_isAmple (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {A : Divisor X} (hAc : A.IsCartier) (hAa : A.IsAmple hAc) :
    ∃ m' : ℕ, 0 < m' ∧ ∀ x : X, ∃ g, IsNonvanishingAt ((m' : ℤ) • A) g x := by
  obtain ⟨m', hm', σ, hσ⟩ := exists_generatingSections hX.1 hAc hAa 0
  refine ⟨m', hm', fun x => ?_⟩
  obtain ⟨g, hg⟩ := isNonvanishingAt_of_generatingSections sX hsm σ x
  exact ⟨g, hg.congr_left (by rw [zero_add, natCast_zsmul])⟩

/-- A relatively very ample divisor over an affine base has, at every point, a section not
vanishing there. -/
private theorem isNonvanishingAt_of_hasImmersionTwistOver (hsm : IsSmoothScheme sX)
    (hf : IsProjectiveMorphism f) [IsAffine Z] {Q : Divisor X}
    (hQ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f Q.divisorialSheaf) (x : X) :
    ∃ g, IsNonvanishingAt Q g x := by
  obtain ⟨σ, hσ⟩ := exists_generatingSections_of_hasImmersionTwistOver f hf hQ
  exact isNonvanishingAt_of_generatingSections sX hsm σ x

/-- **Strata off the stable base locus.** If the stable base locus of `D` contains no stratum of
`Δ`, the generic point of every stratum has, for some multiple of `D`, a section not vanishing
there. -/
private theorem exists_isNonvanishingAt_of_containsNoStratum {Δ D : Divisor X}
    (h : ContainsNoStratum Δ
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • D)) ((m : ℤ) • D)))
    {ξ : X} (hξ : IsSNCStratum Δ (closure {ξ})) :
    ∃ m : ℕ, 0 < m ∧ ∃ g, IsNonvanishingAt ((m : ℤ) • D) g ξ := by
  have h1 := h _ hξ
  rw [Set.not_subset] at h1
  obtain ⟨x, hx, hxB⟩ := h1
  simp only [Set.mem_iInter, not_forall] at hxB
  obtain ⟨m, hm, hxm⟩ := hxB
  obtain ⟨g, -, hg⟩ := exists_isNonvanishingAt_of_notMem_baseLocusIn subset_rfl hxm
  exact ⟨m, hm, g, hg.of_specializes (specializes_iff_mem_closure.mpr hx)⟩

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- A set none of whose points is the generic point of a stratum contains no stratum. -/
private theorem containsNoStratum_of_forall_genericPoint {Δ : Divisor X} {C : Set X}
    (h : ∀ ξ, IsSNCStratum Δ (closure {ξ}) → ξ ∉ C) : ContainsNoStratum Δ C := by
  intro W hW hWC
  obtain ⟨ξ, rfl⟩ := exists_eq_closure_of_isSNCStratum hW
  exact h ξ hW (hWC (subset_closure rfl))

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- Strata of a divisor are strata of any divisor whose support contains its support. -/
private theorem isSNCStratum_of_support_subset {Δ Δ' : Divisor X} (h : Δ.support ⊆ Δ'.support)
    {W : Set X} (hW : IsSNCStratum Δ W) : IsSNCStratum Δ' W := by
  obtain ⟨J, hJ, hmax⟩ := hW
  exact ⟨J, hJ.trans h, hmax⟩

/-- The generic points of the strata of a divisor on a Noetherian scheme form a finite set. -/
private theorem finite_setOf_isSNCStratum_closure [NoetherianSpace X] (Δ : Divisor X) :
    {ξ : X | IsSNCStratum Δ (closure {ξ})}.Finite := by
  exact Set.Finite.preimage (f := fun ξ : X => closure ({ξ} : Set X))
    (fun a _ b _ hab => (inseparable_iff_closure_eq.mpr hab).eq) (finite_setOf_isSNCStratum Δ)

/-- A section of a divisor gives a principal divisor shift. -/
private theorem principalDivisor_units_mk0 {g : X.functionField} (hg : g ≠ 0) :
    principalDivisor (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
      (Units.mk0 g hg)) = ffDiv g hg := rfl

/-- **The decomposition `p₀M₀ ∼ A' + B'`.** For `M₀ = m'D + L + eQ` with `L` ample, `Q` very
ample over the affine base, `e ≥ 1` and the stable base locus of `D` containing no stratum of
`Δ_r ⊇ Δ`, some multiple `p₀M₀` is linearly equivalent to `A' + B'` with `A'` effective and very
ample and `B'` effective containing no stratum of `Δ`. -/
private theorem exists_linearlyEquivalent_add [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX) (hf : IsProjectiveMorphism f)
    [IsAffine Z] {Δ Δr D L Q : Divisor X} (hsupp : Δ.support ⊆ Δr.support)
    (hbase : ContainsNoStratum Δr
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • D)) ((m : ℤ) • D)))
    (hLc : L.IsCartier) (hLa : L.IsAmple hLc)
    (hQ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f Q.divisorialSheaf)
    (m' e : ℕ) (he : 1 ≤ e) :
    ∃ p₀ : ℕ, 0 < p₀ ∧ ∃ A' B' : Divisor X, 0 ≤ A' ∧
      Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A'.divisorialSheaf ∧
      0 ≤ B' ∧ ContainsNoStratum Δ B'.supp ∧
      ((p₀ : ℤ) • ((m' : ℤ) • D + L + (e : ℤ) • Q)).LinearlyEquivalent (A' + B') := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : NoetherianSpace X := MMP.Resolution.Aux.noetherianSpace_of_finiteType sX
  have hc : ∀ G : Divisor X, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs
  set pts : Finset X := insert (genericPoint X) (finite_setOf_isSNCStratum_closure Δ).toFinset
    with hpts
  have hpts' : ∀ ξ, IsSNCStratum Δ (closure {ξ}) → ξ ∈ pts := fun ξ hξ =>
    Finset.mem_insert_of_mem
      ((Set.Finite.mem_toFinset (finite_setOf_isSNCStratum_closure Δ)).mpr hξ)
  -- sections of a multiple of `D`
  have hD : ∀ ξ ∈ pts, ∃ m : ℕ, 0 < m ∧ ∃ g, IsNonvanishingAt ((m : ℤ) • D) g ξ := by
    intro ξ hξ
    rcases Finset.mem_insert.mp hξ with rfl | hξ
    · refine exists_isNonvanishingAt_of_containsNoStratum hbase ⟨∅, Finset.empty_subset _, ?_⟩
      rw [genericPoint_spec X]
      exact ⟨⟨IrreducibleSpace.isIrreducible_univ _, by simp⟩, fun T _ _ => Set.subset_univ T⟩
    · have hξ' : ξ ∈ {ξ : X | IsSNCStratum Δ (closure {ξ})} :=
        (Set.Finite.mem_toFinset (finite_setOf_isSNCStratum_closure Δ)).mp hξ
      exact exists_isNonvanishingAt_of_containsNoStratum hbase
        (isSNCStratum_of_support_subset hsupp hξ')
  choose! mD hmD gD hgD using hD
  set N₂ : ℕ := ∏ ξ ∈ pts, mD ξ with hN₂
  have hN₂0 : 0 < N₂ := Finset.prod_pos fun ξ hξ => hmD ξ hξ
  have hD' : ∀ ξ ∈ pts, ∃ g, IsNonvanishingAt ((N₂ : ℤ) • D) g ξ := by
    intro ξ hξ
    obtain ⟨c, hc'⟩ := Finset.dvd_prod_of_mem mD hξ
    refine ⟨gD ξ ^ c, ?_⟩
    have := (hgD ξ hξ).pow c
    convert this using 1
    rw [smul_smul, hN₂, hc']
    push_cast; ring_nf
  obtain ⟨gD', hgD'⟩ := exists_isNonvanishingAt_finset sX (hc _) pts hD'
  obtain ⟨N₁, hN₁, hL⟩ := exists_nsmul_isNonvanishingAt_of_isAmple sX hX hXs hLc hLa
  obtain ⟨gL, hgL⟩ := exists_isNonvanishingAt_finset sX (hc _) pts (fun ξ _ => hL ξ)
  obtain ⟨gQ, hgQ⟩ := exists_isNonvanishingAt_finset sX (hc Q) pts
    (fun ξ _ => isNonvanishingAt_of_hasImmersionTwistOver sX f hXs hf hQ ξ)
  set p₀ := N₁ * N₂ with hp₀def
  have hp₀ : 0 < p₀ := Nat.mul_pos hN₁ hN₂0
  have hpe : 1 ≤ p₀ * e := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero hp₀.ne' (by omega))
  set G := gD' ^ (N₁ * m') * gL ^ N₂ * gQ ^ (p₀ * e - 1) with hGdef
  set MG : Divisor X := ((N₁ * m' : ℕ) : ℤ) • ((N₂ : ℤ) • D) + ((N₂ : ℕ) : ℤ) • ((N₁ : ℤ) • L) +
    ((p₀ * e - 1 : ℕ) : ℤ) • Q with hMG
  have hG : ∀ ξ ∈ pts, IsNonvanishingAt MG G ξ := fun ξ hξ =>
    (((hgD' ξ hξ).pow _).mul ((hgL ξ hξ).pow _)).mul ((hgQ ξ hξ).pow _)
  have hgen : genericPoint X ∈ pts := Finset.mem_insert_self _ _
  obtain ⟨hG0, hGs, -⟩ := hG _ hgen
  obtain ⟨hQ0, hQs, -⟩ := hgQ _ hgen
  refine ⟨p₀, hp₀, Q + ffDiv gQ hQ0, MG + ffDiv G hG0, fun E => coeff_add_ffDiv_nonneg hQs hQ0 E,
    ?_, fun E => coeff_add_ffDiv_nonneg hGs hG0 E,
    containsNoStratum_of_forall_genericPoint fun ξ hξ => (hG ξ (hpts' ξ hξ)).2.2, ?_⟩
  · obtain ⟨N₀, i, hi, hif, ⟨e'⟩⟩ := hQ
    exact ⟨N₀, i, hi, hif, ⟨Divisor.divisorialSheafMulIso _ (fun E => by
      rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor]) ≪≫ e'⟩⟩
  · refine ⟨(Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 gQ hQ0) *
      Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 G hG0))⁻¹, ?_⟩
    rw [MMP.Mori.principalDivisor_inv, MMP.Mori.principalDivisor_mul, principalDivisor_units_mk0,
      principalDivisor_units_mk0]
    have hsum : (p₀ : ℤ) • ((m' : ℤ) • D + L + (e : ℤ) • Q) = Q + MG := by
      rw [hMG, hp₀def]
      ext E
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
      rw [Nat.cast_sub (by rw [← hp₀def]; exact hpe)]
      push_cast
      ring
    rw [hsum]
    abel

/-- **The stable base locus of a twist.** For `M = m'D + L + eQ + div u` with `L` ample, `Q` very
ample over the affine base and the stable base locus of `D` containing no stratum of `Δ_r ⊇ Δ`,
the stable base locus of `M` contains no stratum of `Δ`. -/
private theorem containsNoStratum_stableBaseLocus [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX) (hf : IsProjectiveMorphism f)
    [IsAffine Z] {Δ Δr D L Q : Divisor X} (hsupp : Δ.support ⊆ Δr.support)
    (hbase : ContainsNoStratum Δr
      (⋂ (m : ℕ) (_ : 0 < m), baseLocusIn (sectionsIn ((m : ℤ) • D)) ((m : ℤ) • D)))
    (hLc : L.IsCartier) (hLa : L.IsAmple hLc)
    (hQ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f Q.divisorialSheaf)
    (m' e : ℕ) (u : (RationalFunctions X)ˣ) :
    ContainsNoStratum Δ (⋂ (m : ℕ) (_ : 0 < m),
      baseLocusIn (sectionsIn ((m : ℤ) • ((m' : ℤ) • D + L + (e : ℤ) • Q + principalDivisor u)))
        ((m : ℤ) • ((m' : ℤ) • D + L + (e : ℤ) • Q + principalDivisor u))) := by
  intro W hW hWsub
  obtain ⟨ξ, rfl⟩ := exists_eq_closure_of_isSNCStratum hW
  obtain ⟨m₁, hm₁, gD, hgD⟩ :=
    exists_isNonvanishingAt_of_containsNoStratum hbase (isSNCStratum_of_support_subset hsupp hW)
  obtain ⟨N₁, hN₁, hL⟩ := exists_nsmul_isNonvanishingAt_of_isAmple sX hX hXs hLc hLa
  obtain ⟨gL, hgL⟩ := hL ξ
  obtain ⟨gQ, hgQ⟩ := isNonvanishingAt_of_hasImmersionTwistOver sX f hXs hf hQ ξ
  have hG := (((hgD.pow (N₁ * m')).mul (hgL.pow m₁)).mul (hgQ.pow (m₁ * N₁ * e))).add_principalDivisor
    (u ^ (m₁ * N₁))
  obtain ⟨G, hG⟩ := (⟨_, hG⟩ : ∃ G, IsNonvanishingAt _ G ξ)
  have key : IsNonvanishingAt (((m₁ * N₁ : ℕ) : ℤ) •
      ((m' : ℤ) • D + L + (e : ℤ) • Q + principalDivisor u)) G ξ := by
    convert hG using 1
    rw [principalDivisor_pow]
    ext E
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    push_cast
    ring
  have h1 := hWsub (subset_closure rfl)
  simp only [Set.mem_iInter] at h1
  exact notMem_baseLocusIn_of_mem_of_isNonvanishingAt key.2.1 key (h1 _ (Nat.mul_pos hm₁ hN₁))

end Positivity

section Restrict

variable {k : Type} [Field k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- `𝒪_S(B|_S) ≅ ι^* 𝒪_X(B)` for a divisor `B` of the smooth `X` not containing the smooth prime
divisor `S`. -/
private theorem nonempty_divisorialSheaf_restrictPrimeDivisor_iso (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (hTsm : haveI := S.integral; IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX)) {B : Divisor X}
    (hBS : B.coeff S = 0) :
    haveI := S.integral
    Nonempty (Divisor.divisorialSheaf (B.restrictPrimeDivisor S) ≅
      (Scheme.Modules.pullback S.idealSheaf.subschemeι).obj B.divisorialSheaf) := by
  haveI := S.integral
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : IsSmoothVariety k sX :=
    (isSmoothVariety_iff k sX).2 ⟨hX.1, (MMP.Mori.isSmoothScheme_iff _).mp hXs⟩
  haveI : LocallyOfFinitePresentation (S.idealSheaf.subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType).mpr inferInstance
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hTsm
  exact (MMP.Mori.Divisor.isCartier_restrictPrimeDivisor_of_isSmoothVariety k sX S B hBS).2.1

/-- **Very ampleness over the base restricts to `S`.** -/
private theorem hasImmersionTwistOver_restrictPrimeDivisor (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (f : X ⟶ Z) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (hTsm : haveI := S.integral; IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX)) {Q : Divisor X}
    (hQS : Q.coeff S = 0)
    (hQ : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f Q.divisorialSheaf) :
    haveI := S.integral
    Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver (S.idealSheaf.subschemeι ≫ f)
      (Divisor.divisorialSheaf (Q.restrictPrimeDivisor S)) := by
  haveI := S.integral
  obtain ⟨e⟩ := nonempty_divisorialSheaf_restrictPrimeDivisor_iso sX hX hXs S hTsm hQS
  obtain ⟨N, i, hi, hif, ⟨e'⟩⟩ := hQ
  haveI := hi
  refine ⟨N, S.idealSheaf.subschemeι ≫ i, inferInstance, by rw [Category.assoc, hif],
    ⟨e ≪≫ (Scheme.Modules.pullback _).mapIso e' ≪≫ (Scheme.Modules.pullbackComp _ _).app _⟩⟩

/-- **Ampleness restricts to `S`.** -/
private theorem isAmple_restrictPrimeDivisor (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hTsm : haveI := S.integral; IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX)) {L : Divisor X}
    (hLc : L.IsCartier) (hL : L.IsAmple hLc) (hLS : L.coeff S = 0)
    (hc : haveI := S.integral; Divisor.IsCartier (L.restrictPrimeDivisor S)) :
    haveI := S.integral
    Divisor.IsAmple (L.restrictPrimeDivisor S) hc := by
  haveI := S.integral
  obtain ⟨e⟩ := nonempty_divisorialSheaf_restrictPrimeDivisor_iso sX hX hXs S hTsm hLS
  haveI := hLc.isInvertibleModule_divisorialSheaf
  haveI := hc.isInvertibleModule_divisorialSheaf
  have h1 := (Stacks.PowerFamilyBridge.modulesIsAmple_iff_isAmple X _).mpr hL
  have h2 := isAmple_pullback_of_isFinite S.idealSheaf.subschemeι _ h1
  haveI := MMP.Mori.isInvertible_pullback_obj S.idealSheaf.subschemeι L.divisorialSheaf
  have h3 := (Stacks.PowerFamilyBridge.modulesIsAmple_iff_isAmple _ _).mp h2
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _ e).mpr h3

end Restrict

section Adjunction

variable {k : Type} [Field k] [IsAlgClosed k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **Adjunction for the prime divisor `S` of a smooth variety.** For a canonical divisor `K_X`,
some `K_X + S + div u` does not contain `S`, and its restriction to `S` is a canonical divisor of
`S`. -/
private theorem exists_isCanonicalDivisor_restrictPrimeDivisor (hX : IsNormalVariety k sX)
    (hXs : IsSmoothScheme sX) {n : ℕ} {KX : Divisor X} (hKX : KX.IsCanonicalDivisor sX (n + 1))
    (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)] :
    haveI := S.integral
    ∃ u : (RationalFunctions X)ˣ, (KX + Finsupp.single S 1 + principalDivisor u).coeff S = 0 ∧
      Divisor.IsCanonicalDivisor (S.idealSheaf.subschemeι ≫ sX) n
        ((KX + Finsupp.single S 1 + principalDivisor u).restrictPrimeDivisor S) := by
  haveI := S.integral
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : CompactSpace S.idealSheaf.subscheme :=
    S.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
  have hdim : topologicalKrullDim X = n + 1 := by exact_mod_cast hKX.1
  have hcart : ∀ x : X, Order.coheight x = 2 → (∃ _ : Unit, x ∈ S.support) →
      MMP.Flips.IsCartierAt (∑ _ : Unit, Finsupp.single S (1 : ℤ)) x := by
    intro x _ _
    haveI : LocallyOfFinitePresentation sX :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
    haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hXs
    have hU : IsSmoothScheme ((⊤ : X.Opens).ι ≫ sX) :=
      (MMP.Mori.isSmoothScheme_iff _).mpr inferInstance
    exact ⟨⊤, trivial, MMP.Fourfold.isCartier_of_isSmoothScheme hU _⟩
  have hP : ∀ _ : Unit, Set.range S.idealSheaf.subschemeι.base = (S.support : Set X) :=
    fun _ => Scheme.IdealSheafData.range_subschemeι _
  obtain ⟨-, ⟨ω, hω0, hωS⟩, h2, -, -⟩ := MMP.Mori.adjunction_restrict_of_isCartierAt_coheight_eq_two
    sX hX hdim (J := Unit) (T := fun _ => S.idealSheaf.subscheme)
    (fun _ => S.idealSheaf.subschemeι) (fun _ => S) hP
    (fun a b h => absurd (Subsingleton.elim a b) h) hcart 0 (fun _ => by simp) KX hKX
    (MMP.Fourfold.isQCartier_of_isSmoothScheme hXs _)
  obtain ⟨hK', hres⟩ := h2 ω hω0 hωS
  obtain ⟨⟨ρ, hρ⟩, hρ'⟩ := hres ()
  obtain ⟨hKT, heq⟩ := hρ' ρ hρ
  obtain ⟨w, hw⟩ := MMP.Flips.linearlyEquivalent_of_isCanonicalDivisor hXs hKX hK'
  have hK'eq : topFormDivisor sX ω = KX + principalDivisor w⁻¹ := by
    rw [MMP.Mori.principalDivisor_inv, ← hw]; abel
  have hsum : (∑ _ : Unit, Finsupp.single S (1 : ℤ)) = Finsupp.single S 1 := by simp
  have hcoeff : (KX + Finsupp.single S 1 + principalDivisor w⁻¹).coeff S = 0 := by
    rw [add_right_comm, ← hK'eq, DivisorWithCoeffs.coeff_add, coeff_topFormDivisor, hωS (),
      DivisorWithCoeffs.coeff_single_self]
    norm_num
  have h0 : (0 : QDivisor X).restrict S.idealSheaf.subschemeι = 0 := by
    have := DivisorWithCoeffs.restrictPrimeDivisor_add (0 : QDivisor X) 0 S (by simp) (by simp)
    rw [add_zero] at this
    exact (add_eq_left.mp this.symm)
  refine ⟨w⁻¹, hcoeff, ?_⟩
  have e : (KX + Finsupp.single S 1 + principalDivisor w⁻¹).restrictPrimeDivisor S =
      divisorOfForm ρ := by
    apply Divisor.toQDivisor_injective
    rw [← Divisor.restrictPrimeDivisor_toQDivisor _ S hcoeff]
    rw [hsum, add_zero, h0, add_zero] at heq
    rw [← heq, add_right_comm, ← hK'eq, map_add]
  rw [e]
  exact hKT

/-- A variety with a prime divisor has positive dimension. -/
private theorem exists_eq_succ_of_isCanonicalDivisor (hX : IsNormalVariety k sX) {n : ℕ}
    {KX : Divisor X} (hKX : KX.IsCanonicalDivisor sX n) (S : MMP.Mori.PrimeDivisor X) :
    ∃ n' : ℕ, n = n' + 1 := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX S.genericPoint
  rw [S.coheight_genericPoint, hKX.1] at h
  rcases n with _ | n'
  · exfalso
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim (closure {S.genericPoint} : Set X) := by
      haveI : Nonempty (IrreducibleCloseds (closure {S.genericPoint} : Set X)) :=
        ⟨IrreducibleCloseds.closureSingleton ⟨S.genericPoint, subset_closure rfl⟩⟩
      exact Order.krullDim_nonneg
    have h1 : (1 : WithBot ℕ∞) ≤ topologicalKrullDim (closure {S.genericPoint} : Set X) + 1 := by
      have := add_le_add_right h0 (1 : WithBot ℕ∞)
      rwa [add_zero, add_comm] at this
    have h' : topologicalKrullDim (closure {S.genericPoint} : Set X) + 1 = 0 := by
      exact_mod_cast h
    rw [h'] at h1
    exact absurd h1 (by decide)
  · exact ⟨n', rfl⟩

end Adjunction

section Transfer

variable {k : Type} [Field k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ Z)

/-- **The restricted asymptotic ideal only depends on the linear equivalence class.** A witness
for `M` is a witness for `M + div u`: the representative of which `S` is not a component is the
same divisor. -/
private theorem isRestrictedAsymptoticAdjointIdeal_add_principalDivisor {Δ M : Divisor X}
    {S : MMP.Mori.PrimeDivisor X} {b : ℕ} {c : ℚ}
    {J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField}
    (hJ : IsRestrictedAsymptoticAdjointIdeal sX f Δ M S b c J) (u : (RationalFunctions X)ˣ) :
    haveI : CompactSpace X := hJ.1
    IsRestrictedAsymptoticAdjointIdeal sX f Δ (M + principalDivisor u) S b c J := by
  obtain ⟨h1, h2, h3, φ, hφ, h⟩ := hJ
  have e : M + principalDivisor u + principalDivisor (φ * u⁻¹) = M + principalDivisor φ := by
    rw [MMP.Mori.principalDivisor_mul, MMP.Mori.principalDivisor_inv]; abel
  exact ⟨h1, h2, h3, φ * u⁻¹, by rw [e]; exact hφ, by rw [e]; exact h⟩

end Transfer

section BaseIdeal

variable {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]

/-- **The ascending chain condition for ideal sheaves** on a Noetherian scheme. -/
private theorem wellFoundedGT_idealSheafData (X : Scheme.{0}) [IsNoetherian X] :
    WellFoundedGT X.IdealSheafData := by
  classical
  rw [wellFoundedGT_iff_monotone_chain_condition]
  intro a
  let 𝒰 := X.affineCover.finiteSubcover
  have hAff : ∀ i : 𝒰.I₀, IsAffine (𝒰.X i) := fun i => by dsimp [𝒰]; infer_instance
  let U : 𝒰.I₀ → X.affineOpens := fun i =>
    ⟨(𝒰.f i).opensRange, have := hAff i; isAffineOpen_opensRange (𝒰.f i)⟩
  have hU : ⨆ i, (U i).1 = ⊤ := 𝒰.iSup_opensRange
  have hstab : ∀ i : 𝒰.I₀, ∃ n : ℕ, ∀ m : ℕ, n ≤ m →
      (a n).ideal (U i) = (a m).ideal (U i) := by
    intro i
    have hN : IsNoetherianRing Γ(X, (U i).1) := IsLocallyNoetherian.component_noetherian (U i)
    exact monotone_stabilizes_iff_noetherian.mpr hN
      ⟨fun n => (a n).ideal (U i), fun p q hpq =>
        Scheme.IdealSheafData.le_def.mp (a.monotone hpq) (U i)⟩
  let start : 𝒰.I₀ → ℕ := fun i => Classical.choose (hstab i)
  have hstart : ∀ i : 𝒰.I₀, start i ≤ Finset.sup Finset.univ start :=
    fun i => Finset.le_sup (Finset.mem_univ i)
  refine ⟨Finset.sup Finset.univ start, fun m hm => ?_⟩
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top U hU fun i => ?_
  have h₁ := Classical.choose_spec (hstab i) _ (hstart i)
  have h₂ := Classical.choose_spec (hstab i) m ((hstart i).trans hm)
  exact h₁.symm.trans h₂

open Classical in
/-- The ideal sheaf `𝒪_W(-(L + div g))` of the divisor of zeros of a section `g` of `𝒪_W(L)`;
the zero ideal for `g = 0`. -/
private noncomputable def sectionIdeal (L : Divisor W) (g : W.functionField) :
    W.IdealSheafData :=
  if hg : g = 0 then ⊥ else valIdealSheaf (𝟙 W) (-(L + ffDiv g hg))

/-- **The local generator of `𝒪_W(-(L + div g))`.** If `φ` is a local equation of `L` on `U₀`,
on every nonempty affine `U ⊆ U₀` the ideal is generated by the regular function `g φ`. -/
private theorem sectionIdeal_ideal_eq_span {L : Divisor W} {g : W.functionField}
    (hg : g ∈ sectionsIn L) (hg0 : g ≠ 0) {U₀ : W.Opens} {φ : (RationalFunctions W)ˣ}
    (hφ : L.IsLocalEquation U₀ φ) (U : W.affineOpens) (hU : (U : W.Opens) ≤ U₀)
    [Nonempty (U : W.Opens)] :
    ∃ s : Γ(W, U), W.germToFunctionField U s = g * rationalFunctionsEquivFunctionField W φ ∧
      (sectionIdeal L g).ideal U = Ideal.span {s} := by
  set ψ := rationalFunctionsEquivFunctionField W φ with hψ
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
  have hgψ : g * ψ ≠ 0 := mul_ne_zero hg0 hψ0
  have hord : ∀ P : MMP.Mori.PrimeDivisor W, (P.support ∩ (U : W.Opens)).Nonempty →
      W.ord (g * ψ) P.genericPoint = (L + ffDiv g hg0).coeff P := by
    intro P hP
    rw [Scheme.ord_mul hg0 hψ0, DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0,
      hφ P (hP.mono (Set.inter_subset_inter_right _ hU)),
      MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
    ring
  obtain ⟨s, hs⟩ := (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord
    (U : W.Opens) hgψ).mpr fun P hP => by
      rw [hord P hP]; exact coeff_add_ffDiv_nonneg hg hg0 P
  refine ⟨s, hs, ?_⟩
  have hdef : (sectionIdeal L g).ideal U = valIdeal (𝟙 W) (-(L + ffDiv g hg0)) U := by
    classical
    unfold sectionIdeal
    rw [dif_neg hg0]
    rfl
  rw [hdef]
  have hval : ∀ (P : MMP.Mori.PrimeDivisor W) (hP : (𝟙 W) P.genericPoint ∈ (U : W.Opens))
      (a : Γ(W, U)), P.valuationOver (𝟙 W) (algebraMap _ W.functionField
        (W.presheaf.germ (U : W.Opens) _ hP a)) =
        P.divisorialValuation (W.germToFunctionField U a) := by
    intro P hP a
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
      Scheme.algebraMap_germ_eq_germToFunctionField]
  apply le_antisymm
  · intro b hb
    by_cases hb0 : W.germToFunctionField U b = 0
    · have : b = 0 := Scheme.germToFunctionField_injective W (U : W.Opens) (by rw [hb0, map_zero])
      rw [this]; exact zero_mem _
    obtain ⟨r, hr⟩ := (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord
      (U : W.Opens) (mul_ne_zero hb0 (inv_ne_zero hgψ))).mpr fun P hP => by
        have hη := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
        have h1 := hb P hη
        rw [hval P hη b, P.divisorialValuation_eq_exp_neg_ord hb0, WithZero.exp_le_exp,
          DivisorWithCoeffs.coeff_neg] at h1
        rw [Scheme.ord_mul hb0 (inv_ne_zero hgψ), ← zpow_neg_one, MMP.Mori.ord_zpow _ hgψ,
          hord P hP]
        omega
    refine Ideal.mem_span_singleton'.mpr ⟨r, Scheme.germToFunctionField_injective W
      (U : W.Opens) ?_⟩
    rw [map_mul, hr, hs, mul_assoc, inv_mul_cancel₀ hgψ, mul_one]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    intro P hP
    rw [hval P hP s, hs, P.divisorialValuation_eq_exp_neg_ord hgψ, WithZero.exp_le_exp,
      DivisorWithCoeffs.coeff_neg,
      hord P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P hP)]

/-- **The ideal of finitely many sections near a point.** On a nonempty affine `U ⊆ U₀`, where
`φ` is a local equation of `L`, the ideal sheaf `∑_{g ∈ T} 𝒪_W(-(L + div g))` is generated by
the regular functions `g φ`, `g ∈ T`. -/
private theorem finsetSup_sectionIdeal_ideal {L : Divisor W} (T : Finset W.functionField)
    (hT : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0) {U₀ : W.Opens} {φ : (RationalFunctions W)ˣ}
    (hφ : L.IsLocalEquation U₀ φ) (U : W.affineOpens) (hU : (U : W.Opens) ≤ U₀)
    [Nonempty (U : W.Opens)] :
    ∃ s : T → Γ(W, U), (∀ g : T, W.germToFunctionField U (s g) =
        g.1 * rationalFunctionsEquivFunctionField W φ) ∧
      (T.sup (sectionIdeal L)).ideal U = Ideal.span (Set.range s) := by
  classical
  have h := fun g : T => sectionIdeal_ideal_eq_span (hT g.1 g.2).1 (hT g.1 g.2).2 hφ U hU
  choose s hs hspan using h
  refine ⟨s, hs, ?_⟩
  have e1 : (T.sup (sectionIdeal L)).ideal U = ⨆ g : T, (sectionIdeal L g.1).ideal U := by
    rw [Finset.sup_eq_iSup, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
    have h1 : ∀ i, (⨆ (_ : i ∈ T), sectionIdeal L i).ideal U =
        ⨆ (_ : i ∈ T), (sectionIdeal L i).ideal U := by
      intro i
      by_cases h : i ∈ T
      · simp [h]
      · simp [h]
    simp only [h1]
    exact iSup_subtype' (p := fun i => i ∈ T) (f := fun i _ => (sectionIdeal L i).ideal U)
  rw [e1, Ideal.span, Submodule.span_range_eq_iSup]
  exact iSup_congr fun g => hspan g

/-- **Finitely many sections generate the base ideal** (ascending chain condition). For a
nonzero `g₀` in a series `V` of `L` on a Noetherian `W`, some finite `T ∋ g₀` of nonzero members
has `𝒪_W(-(L + div g)) ⊆ ∑_{g' ∈ T} 𝒪_W(-(L + div g'))` for every `g ∈ V`. -/
private theorem exists_finset_sectionIdeal_le [IsNoetherian W] {L : Divisor W}
    (V : Set W.functionField) {g₀ : W.functionField} (hg₀V : g₀ ∈ V) (hg₀ : g₀ ≠ 0) :
    ∃ T : Finset W.functionField, g₀ ∈ T ∧ (∀ g ∈ T, g ∈ V ∧ g ≠ 0) ∧
      ∀ g ∈ V, sectionIdeal L g ≤ T.sup (sectionIdeal L) := by
  classical
  haveI := wellFoundedGT_idealSheafData W
  set 𝒮 : Set W.IdealSheafData := {I | ∃ T : Finset W.functionField, g₀ ∈ T ∧
    (∀ g ∈ T, g ∈ V ∧ g ≠ 0) ∧ I = T.sup (sectionIdeal L)} with h𝒮
  have hne : 𝒮.Nonempty := ⟨_, {g₀}, Finset.mem_singleton_self _, fun g hg => by
    rw [Finset.mem_singleton.mp hg]; exact ⟨hg₀V, hg₀⟩, rfl⟩
  obtain ⟨I₀, ⟨T, hgT, hT, rfl⟩, hmax⟩ := WellFounded.has_min (wellFounded_gt) 𝒮 hne
  refine ⟨T, hgT, hT, fun g hgV => ?_⟩
  by_cases hg : g = 0
  · rw [hg]; unfold sectionIdeal; rw [dif_pos rfl]; exact bot_le
  have hmem : (insert g T).sup (sectionIdeal L) ∈ 𝒮 := ⟨insert g T, Finset.mem_insert_of_mem hgT,
    fun g' hg' => by
      rcases Finset.mem_insert.mp hg' with rfl | hg'
      · exact ⟨hgV, hg⟩
      · exact hT g' hg', rfl⟩
  have hle : T.sup (sectionIdeal L) ≤ (insert g T).sup (sectionIdeal L) :=
    Finset.sup_mono (Finset.subset_insert _ _)
  have heq : (insert g T).sup (sectionIdeal L) = T.sup (sectionIdeal L) := by
    by_contra hne'
    exact hmax _ hmem (lt_of_le_of_ne hle (Ne.symm hne'))
  rw [← heq, Finset.sup_insert]
  exact le_sup_left

/-- In a local domain, if finitely many elements generate a nonzero principal ideal, one of them
divides all the others. -/
private theorem exists_forall_mem_span_singleton {R : Type*} [CommRing R] [IsLocalRing R]
    [IsDomain R] {ι : Type*} [Fintype ι] (α : ι → R) {d : R} (hd : d ≠ 0)
    (h : Ideal.span (Set.range α) = Ideal.span {d}) :
    ∃ i, ∀ j, α j ∈ Ideal.span {α i} := by
  classical
  have hdmem : d ∈ Ideal.span (Set.range α) := by rw [h]; exact Ideal.mem_span_singleton_self d
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hdmem
  have ht : ∀ j, ∃ t : R, α j = t * d := fun j => by
    have : α j ∈ Ideal.span {d} := by rw [← h]; exact Ideal.subset_span ⟨j, rfl⟩
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp this
    exact ⟨t, ht.symm⟩
  choose t ht using ht
  have hsum : ∑ j, c j * t j = 1 := by
    have h1 : d * (∑ j, c j * t j) = d * 1 := by
      rw [mul_one, Finset.mul_sum]
      conv_rhs => rw [← hc]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [smul_eq_mul, ht j]; ring
    exact mul_left_cancel₀ hd h1
  obtain ⟨i, -, hi⟩ := exists_isUnit_of_sum_mul_eq_one Finset.univ c t hsum
  refine ⟨i, fun j => Ideal.mem_span_singleton'.mpr ⟨t j * ↑hi.unit⁻¹, ?_⟩⟩
  rw [ht i, ht j]
  calc t j * ↑hi.unit⁻¹ * (t i * d) = t j * (↑hi.unit⁻¹ * t i) * d := by ring
    _ = t j * d := by rw [IsUnit.val_inv_mul, mul_one]

/-- **Every member of the series is bounded by the finite family.** If
`𝒪_W(-(L + div g)) ⊆ ∑_{g' ∈ T} 𝒪_W(-(L + div g'))`, then along every prime divisor `P` of a model
`μ : Y ⟶ W` some `g' ∈ T` has `ord_P(μ^*g') ≤ ord_P(μ^*g)`. -/
private theorem exists_ord_le_of_le_sup {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (μ : Y ⟶ W) [IsDominant μ] {L : Divisor W} (hLc : L.IsCartier)
    (T : Finset W.functionField) (hT : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0) {g : W.functionField}
    (hg : g ∈ sectionsIn L) (hg0 : g ≠ 0) (hle : sectionIdeal L g ≤ T.sup (sectionIdeal L))
    (P : MMP.Mori.PrimeDivisor Y) (hTne : T.Nonempty) :
    ∃ g' ∈ T, Y.ord (functionFieldMap μ g') P.genericPoint ≤
      Y.ord (functionFieldMap μ g) P.genericPoint := by
  classical
  obtain ⟨U₀, hcU₀, φ, hφ⟩ := hLc (μ P.genericPoint)
  obtain ⟨U, hUaff, hcU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens W)) hcU₀
  haveI : Nonempty U := ⟨⟨_, hcU⟩⟩
  haveI : Nonempty T := ⟨⟨hTne.choose, hTne.choose_spec⟩⟩
  set ψ := rationalFunctionsEquivFunctionField W φ with hψdef
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
  obtain ⟨s, hs, hspan⟩ := finsetSup_sectionIdeal_ideal T hT hφ ⟨U, hUaff⟩ hUU₀
  obtain ⟨sg, hsg, hspang⟩ := sectionIdeal_ideal_eq_span hg hg0 hφ ⟨U, hUaff⟩ hUU₀
  have hmem : sg ∈ (T.sup (sectionIdeal L)).ideal ⟨U, hUaff⟩ :=
    Scheme.IdealSheafData.le_def.mp hle _ (by rw [hspang]; exact Ideal.mem_span_singleton_self _)
  rw [hspan] at hmem
  obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  have hid : g * ψ = ∑ i, W.germToFunctionField U (r i) * (i.1 * ψ) := by
    rw [← hsg, ← hr, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_eq_mul, map_mul, hs i]
  have hr1 : ∀ i, P.divisorialValuation (functionFieldMap μ (W.germToFunctionField U (r i))) ≤ 1 := by
    intro i
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField W hcU]
    have := val_stalk_le_one μ P ((W.presheaf.germ U _ hcU) (r i))
    rwa [MMP.Mori.PrimeDivisor.valuationOver_apply] at this
  obtain ⟨i₀, -, hi₀⟩ := Finset.exists_max_image (Finset.univ : Finset T)
    (fun i => P.divisorialValuation (functionFieldMap μ (i.1 * ψ))) Finset.univ_nonempty
  have hbound : P.divisorialValuation (functionFieldMap μ (g * ψ)) ≤
      P.divisorialValuation (functionFieldMap μ (i₀.1 * ψ)) := by
    rw [hid, map_sum]
    refine Valuation.map_sum_le _ fun i _ => ?_
    rw [map_mul, Valuation.map_mul]
    exact (mul_le_of_le_one_left' (hr1 i)).trans (hi₀ i (Finset.mem_univ _))
  refine ⟨i₀.1, i₀.2, ?_⟩
  have hinj := (functionFieldMap μ).injective
  have h1 : functionFieldMap μ (g * ψ) ≠ 0 := (map_ne_zero_iff _ hinj).mpr (mul_ne_zero hg0 hψ0)
  have h2 : functionFieldMap μ (i₀.1 * ψ) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (mul_ne_zero (hT _ i₀.2).2 hψ0)
  rw [P.divisorialValuation_eq_exp_neg_ord h1, P.divisorialValuation_eq_exp_neg_ord h2,
    WithZero.exp_le_exp, map_mul, map_mul,
    Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr hg0) ((map_ne_zero_iff _ hinj).mpr hψ0),
    Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr (hT _ i₀.2).2)
      ((map_ne_zero_iff _ hinj).mpr hψ0)] at hbound
  omega

private theorem evalFF_eq_rationalFunctionsEquivFunctionField (Z : irreducibleComponents W)
    (u : RationalFunctions W) :
    MMP.Threefold.Mori.Helpers.evalFF Z u = rationalFunctionsEquivFunctionField W u := by
  rw [← MMP.Positivity.componentToFunctionField_apply Z u]
  rfl

/-- **Freeness on the principalizing model.** If `∑_{g ∈ T} 𝒪_W(-(L + div g)) · 𝒪_Y` is an
effective Cartier divisor, then near every point `y` of `Y` one `g' ∈ T` has the least order
`ord_P(μ^*g')` along every prime divisor `P` through `y`. -/
private theorem exists_forall_ord_le {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (μ : Y ⟶ W) [IsDominant μ] {L : Divisor W} (hLc : L.IsCartier)
    (T : Finset W.functionField) (hT : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0) (hTne : T.Nonempty)
    (hcart : Stacks.Divisors.IsEffectiveCartierDivisor ((T.sup (sectionIdeal L)).comap μ))
    (y : Y) :
    ∃ g' ∈ T, ∀ P : MMP.Mori.PrimeDivisor Y, y ∈ P.support → ∀ g ∈ T,
      Y.ord (functionFieldMap μ g') P.genericPoint ≤ Y.ord (functionFieldMap μ g) P.genericPoint := by
  classical
  obtain ⟨U₀, hcU₀, φ, hφ⟩ := hLc (μ y)
  obtain ⟨U, hUaff, hcU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens W)) hcU₀
  haveI : Nonempty U := ⟨⟨_, hcU⟩⟩
  haveI : Nonempty T := ⟨⟨hTne.choose, hTne.choose_spec⟩⟩
  set ψ := rationalFunctionsEquivFunctionField W φ with hψdef
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
  obtain ⟨s, hs, hspan⟩ := finsetSup_sectionIdeal_ideal T hT hφ ⟨U, hUaff⟩ hUU₀
  set α : T → Y.presheaf.stalk y := fun i =>
    (μ.stalkMap y).hom ((W.presheaf.germ U (μ y) hcU).hom (s i)) with hα
  have hstalk : IdealSheafData.stalk ((T.sup (sectionIdeal L)).comap μ) y =
      Ideal.span (Set.range α) := by
    rw [IdealSheafData.stalk_comap, IdealSheafData.stalk_eq_map_germ _ _ ⟨U, hUaff⟩ hcU, hspan,
      Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    rfl
  obtain ⟨U', hU', hyU', t, ht, hIt⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor _ hcart y
  have hstalk' : IdealSheafData.stalk ((T.sup (sectionIdeal L)).comap μ) y =
      Ideal.span {(Y.presheaf.germ U' y hyU').hom t} := by
    rw [IdealSheafData.stalk_eq_map_germ _ y ⟨U', hU'⟩ hyU', hIt, Ideal.map_span,
      Set.image_singleton]
  haveI : Nonempty U' := ⟨⟨y, hyU'⟩⟩
  have ht0 : (Y.presheaf.germ U' y hyU').hom t ≠ 0 := by
    intro h0
    refine ht.ne_zero (germ_injective_of_isIntegral Y y hyU' ?_)
    rw [h0, map_zero]
  obtain ⟨i, hi⟩ := exists_forall_mem_span_singleton α ht0 (hstalk.symm.trans hstalk')
  refine ⟨i.1, i.2, fun P hyP g hg => ?_⟩
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hi ⟨g, hg⟩)
  have hαff : ∀ j : T, algebraMap _ Y.functionField (α j) = functionFieldMap μ (j.1 * ψ) := by
    intro j
    rw [hα, ← MMP.Mori.functionFieldMap_algebraMap_stalk,
      Scheme.algebraMap_germ_eq_germToFunctionField W hcU, hs j]
  have hinj := (functionFieldMap μ).injective
  have hg0 := (hT g hg).2
  have hgψ : functionFieldMap μ (g * ψ) ≠ 0 := (map_ne_zero_iff _ hinj).mpr (mul_ne_zero hg0 hψ0)
  have key := congrArg (algebraMap (Y.presheaf.stalk y) Y.functionField) hr
  rw [map_mul, hαff, hαff] at key
  have hr0 : algebraMap (Y.presheaf.stalk y) Y.functionField r ≠ 0 := by
    intro h0; rw [h0, zero_mul] at key; exact hgψ key.symm
  have hrord := ord_algebraMap_nonneg P hyP r hr0
  have hiψ : functionFieldMap μ (i.1 * ψ) ≠ 0 :=
    (map_ne_zero_iff _ hinj).mpr (mul_ne_zero (hT _ i.2).2 hψ0)
  have h3 := congrArg (fun a => Y.ord a P.genericPoint) key
  simp only at h3
  rw [Scheme.ord_mul hr0 hiψ] at h3
  rw [map_mul, map_mul, Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr (hT _ i.2).2)
    ((map_ne_zero_iff _ hinj).mpr hψ0), Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr hg0)
    ((map_ne_zero_iff _ hinj).mpr hψ0)] at h3
  omega

/-- **The fixed divisor lies in the principalized ideal.** If every `μ^*(g φ)`, `g ∈ T`, has
positive order along `P` (with `φ` a local equation of `L` near the centre of `P`), the generic
point of `P` lies in the support of `∑_{g ∈ T} 𝒪_W(-(L + div g)) · 𝒪_Y`. -/
private theorem genericPoint_mem_support_comap {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ W) [IsDominant μ] {L : Divisor W}
    (T : Finset W.functionField) (hT : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0)
    (P : MMP.Mori.PrimeDivisor Y) {U₀ : W.Opens} {φ : (RationalFunctions W)ˣ}
    (hφ : L.IsLocalEquation U₀ φ) (hcU₀ : μ P.genericPoint ∈ U₀)
    (hpos : ∀ g ∈ T, 0 < Y.ord (functionFieldMap μ (g * rationalFunctionsEquivFunctionField W φ))
      P.genericPoint) :
    P.genericPoint ∈ ((T.sup (sectionIdeal L)).comap μ).support := by
  classical
  obtain ⟨U, hUaff, hcU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens W)) hcU₀
  haveI : Nonempty U := ⟨⟨_, hcU⟩⟩
  obtain ⟨s, hs, hspan⟩ := finsetSup_sectionIdeal_ideal T hT hφ ⟨U, hUaff⟩ hUU₀
  set α : T → Y.presheaf.stalk P.genericPoint := fun i =>
    (μ.stalkMap P.genericPoint).hom ((W.presheaf.germ U (μ P.genericPoint) hcU).hom (s i)) with hα
  have hstalk : IdealSheafData.stalk ((T.sup (sectionIdeal L)).comap μ) P.genericPoint =
      Ideal.span (Set.range α) := by
    rw [IdealSheafData.stalk_comap, IdealSheafData.stalk_eq_map_germ _ _ ⟨U, hUaff⟩ hcU, hspan,
      Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    rfl
  have hyP : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hnu : ∀ j : T, ¬ IsUnit (α j) := by
    intro j hj
    have h0 := ord_algebraMap_eq_zero_of_isUnit P hyP hj
    rw [hα, ← MMP.Mori.functionFieldMap_algebraMap_stalk,
      Scheme.algebraMap_germ_eq_germToFunctionField W hcU, hs j] at h0
    have := hpos j.1 j.2
    omega
  have hle : IdealSheafData.stalk ((T.sup (sectionIdeal L)).comap μ) P.genericPoint ≤
      IsLocalRing.maximalIdeal _ := by
    rw [hstalk, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact (IsLocalRing.mem_maximalIdeal _).mpr (hnu j)
  obtain ⟨U', hU', hyU', -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y)) (show P.genericPoint ∈ (⊤ : Y.Opens) from trivial)
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U', hU'⟩) hyU', Y.mem_zeroLocus_iff]
  intro f hf hyf
  apply (IsLocalRing.mem_maximalIdeal _).mp (hle ?_)
  · exact (Y.mem_basicOpen f _ hyU').mp hyf
  · rw [IdealSheafData.stalk_eq_map_germ _ _ ⟨U', hU'⟩ hyU']
    exact Ideal.mem_map_of_mem _ hf

omit [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W] in
/-- A finite union of prime divisors is of pure codimension one. -/
private theorem isPureCodimOne_of_eq_iUnion' (C : Closeds W)
    (s : Finset (MMP.Mori.PrimeDivisor W)) (hs : (C : Set W) = ⋃ E ∈ s, E.support) :
    IsPureCodimOne C := by
  intro Z hZ
  obtain ⟨E, hE, hZE⟩ := exists_mem_of_subset_iUnion Z (hs ▸ hZ.prop)
  have hEC : ((primeIrr E : IrreducibleCloseds W) : Set W) ⊆ C := by
    rw [coe_primeIrr, hs]; exact Set.subset_biUnion_of_mem (u := fun E => E.support) hE
  have : Z = primeIrr E := le_antisymm hZE (hZ.2 hEC hZE)
  rw [this]
  exact codimension_primeIrr E

/-- **Existence of the adjoint ideal of a linear series.** On a smooth variety, a reduced snc `Θ`
and a nonzero series `V` of `L` whose base locus contains no stratum of `Θ` have a log resolution
of `Θ` and of `V`, with the resulting `𝒥_{Θ,cV}`: principalize the base ideal of `V`, which is
generated by finitely many members, together with a log resolution of `Θ`. -/
private theorem exists_isSeriesAdjointIdealOn {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    (sW : W ⟶ Spec (.of k)) (hW : IsNormalVariety k sW) (hsm : IsSmoothScheme sW)
    {Θ : Divisor W} (hΘ : IsReducedSNC sW Θ) {L : Divisor W} (V : AddSubgroup W.functionField)
    (hVs : (V : Set W.functionField) ⊆ sectionsIn L) {g₀ : W.functionField} (hg₀V : g₀ ∈ V)
    (hg₀ : g₀ ≠ 0) (hVns : ContainsNoStratum Θ (baseLocusIn V L)) {c : ℚ} (hc : 0 ≤ c) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ W) (J : W.Opens → Set W.functionField),
      IsSeriesAdjointIdealOn sW Θ L V c μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sW := hW.1
  haveI : IsNoetherian W := {}
  have hLc : L.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm L
  obtain ⟨T, hg₀T, hT, hTle⟩ := exists_finset_sectionIdeal_le (L := L) (V : Set W.functionField)
    hg₀V hg₀
  have hTs : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0 := fun g hg => ⟨hVs (hT g hg).1, (hT g hg).2⟩
  set I := T.sup (sectionIdeal L) with hI
  have hIgen : genericPoint W ∉ I.support := by
    intro hη
    have hle : sectionIdeal L g₀ ≤ I := Finset.le_sup (f := sectionIdeal L) hg₀T
    have hη' := Scheme.IdealSheafData.support_antitone hle hη
    obtain ⟨U₀, hηU₀, φ, hφ⟩ := hLc (genericPoint W)
    obtain ⟨U, hUaff, hηU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens W)) hηU₀
    haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
    obtain ⟨t, ht, hspan⟩ := sectionIdeal_ideal_eq_span (hVs hg₀V) hg₀ hφ ⟨U, hUaff⟩ hUU₀
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hUaff⟩) hηU] at hη'
    have ht0 : W.germToFunctionField U t ≠ 0 := by
      rw [ht]
      exact mul_ne_zero hg₀ (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
    refine (W.mem_zeroLocus_iff _ _).mp hη' t (by rw [hspan]; exact Ideal.mem_span_singleton_self t)
      ((W.mem_basicOpen t _ hηU).mpr ?_)
    exact isUnit_iff_ne_zero.mpr ht0
  obtain ⟨Y, μ, hlogM, hproj, hcart, hsnc⟩ := exists_isLogResolution_isEffectiveCartierDivisor_comap'
    sW hW (QDivisor.toRDivisor (Divisor.toQDivisor Θ)) I hIgen
  have hres := hlogM.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hW
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sW) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sW)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sW) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sW)
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ L.supp :=
    MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ L
  obtain ⟨Dμ, hDμ⟩ := hLc.exists_isPullback hD
  -- the fixed divisor
  have hne : T.Nonempty := ⟨g₀, hg₀T⟩
  let ordm : W.functionField → MMP.Mori.PrimeDivisor Y → ℤ := fun g P =>
    Y.ord (functionFieldMap μ g) P.genericPoint
  let F : Divisor Y := Finsupp.ofSupportFinite
    (fun P => Dμ.coeff P + T.inf' hne (fun g => ordm g P)) (by
      have hfin : ∀ g ∈ T, {P | ordm g P ≠ 0}.Finite := fun g hg =>
        (Finset.finite_toSet (Finsupp.support (ffDiv (functionFieldMap μ g)
          ((map_ne_zero_iff _ (functionFieldMap μ).injective).mpr (hTs g hg).2)))).subset
          fun P hP => by
            rw [Finset.mem_coe, Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
              MMP.Mori.coeff_principalDivisor_mk0]
            exact hP
      refine (Set.Finite.union (Finset.finite_toSet Dμ.support)
        (Set.Finite.biUnion (Finset.finite_toSet T) hfin)).subset ?_
      intro P hP
      by_contra hnot
      simp only [Set.mem_union, Finset.mem_coe, Finsupp.mem_support_iff, Set.mem_iUnion,
        Set.mem_setOf_eq, not_or, not_exists, not_not] at hnot
      apply hP
      have h2 : T.inf' hne (fun g => ordm g P) = 0 := by
        rw [Finset.inf'_congr hne rfl fun g hg => hnot.2 g hg]
        exact Finset.inf'_const hne 0
      change Dμ P + T.inf' hne (fun g => ordm g P) = 0
      rw [h2, hnot.1, add_zero])
  have hFc : ∀ P, F.coeff P = Dμ.coeff P + T.inf' hne (fun g => ordm g P) := fun P => rfl
  have hFeq : ∀ P, Dμ.coeff P - F.coeff P = -T.inf' hne (fun g => ordm g P) := fun P => by
    rw [hFc]; ring
  have hinj := (functionFieldMap μ).injective
  have hval : ∀ g : W.functionField, g ≠ 0 → ∀ P : MMP.Mori.PrimeDivisor Y,
      P.valuationOver μ g = WithZero.exp (-ordm g P) := fun g hg P => by
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero_iff _ hinj).mpr hg)]
  have hfix : IsFixedDivisorOfPullback μ (V : Set W.functionField) Dμ F := by
    intro P
    refine ⟨fun g hgV => ?_, ?_⟩
    · by_cases hg0 : g = 0
      · simp [hg0]
      obtain ⟨g', hg'T, hle⟩ :=
        exists_ord_le_of_le_sup μ hLc T hTs (hVs hgV) hg0 (hTle g hgV) P hne
      rw [hval g hg0, hFeq, WithZero.exp_le_exp]
      have := Finset.inf'_le (fun g => ordm g P) hg'T
      change -ordm g P ≤ -T.inf' hne (fun g => ordm g P)
      change ordm g' P ≤ ordm g P at hle
      omega
    · obtain ⟨g', hg'T, hmin⟩ := Finset.exists_min_image T (fun g => ordm g P) hne
      refine ⟨g', (hT g' hg'T).1, (hT g' hg'T).2, ?_⟩
      rw [hval g' (hT g' hg'T).2, hFeq]
      congr 2
      exact le_antisymm (Finset.le_inf' hne _ fun g hg => hmin g hg)
        (Finset.inf'_le _ hg'T)
  have hfree : IsFreeModuloFixedDivisor μ (V : Set W.functionField) Dμ F := by
    intro y
    obtain ⟨g', hg'T, hmin⟩ := exists_forall_ord_le μ hLc T hTs hne hcart y
    refine ⟨g', (hT g' hg'T).1, (hT g' hg'T).2, fun P hyP => ?_⟩
    rw [hval g' (hT g' hg'T).2, hFeq]
    congr 2
    exact le_antisymm (Finset.le_inf' hne _ fun g hg => hmin P hyP g hg)
      (Finset.inf'_le _ hg'T)
  have hFle : F.supp ≤ ((T.sup (sectionIdeal L)).comap μ).support := by
    intro x hx
    obtain ⟨P, hP, hxP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
    obtain ⟨U₀, hcU₀, φ, hφ⟩ := hLc (μ P.genericPoint)
    set ψ := rationalFunctionsEquivFunctionField W φ with hψdef
    have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
    have hDP : Dμ.coeff P = Y.ord (functionFieldMap μ ψ) P.genericPoint := by
      rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hDμ hφ P hcU₀
        (MMP.Mori.pointComponent (genericPoint W)), evalFF_eq_rationalFunctionsEquivFunctionField]
    have hgψ : ∀ g ∈ T, Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint =
        ordm g P + Dμ.coeff P := fun g hg => by
      rw [map_mul, Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr (hTs g hg).2)
        ((map_ne_zero_iff _ hinj).mpr hψ0), hDP]
    have hnonneg : ∀ g ∈ T, 0 ≤ Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
      intro g hg
      obtain ⟨U, hUaff, hcU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens W)) hcU₀
      haveI : Nonempty U := ⟨⟨_, hcU⟩⟩
      obtain ⟨sg, hsg, -⟩ := sectionIdeal_ideal_eq_span (hTs g hg).1 (hTs g hg).2 hφ
        ⟨U, hUaff⟩ hUU₀
      have hyP : P.genericPoint ∈ P.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      have hne0 : functionFieldMap μ (g * ψ) ≠ 0 :=
        (map_ne_zero_iff _ hinj).mpr (mul_ne_zero (hTs g hg).2 hψ0)
      rw [← hsg, ← Scheme.algebraMap_germ_eq_germToFunctionField W hcU,
        MMP.Mori.functionFieldMap_algebraMap_stalk] at hne0 ⊢
      exact ord_algebraMap_nonneg P hyP _ hne0
    have hFP : F.coeff P = T.inf' hne (fun g => Y.ord (functionFieldMap μ (g * ψ))
        P.genericPoint) := by
      rw [hFc, Finset.inf'_congr hne rfl hgψ]
      obtain ⟨g', hg'T, hmin⟩ := Finset.exists_min_image T (fun g => ordm g P) hne
      have e1 : T.inf' hne (fun g => ordm g P) = ordm g' P :=
        le_antisymm (Finset.inf'_le _ hg'T) (Finset.le_inf' hne _ hmin)
      have e2 : T.inf' hne (fun g => ordm g P + Dμ.coeff P) = ordm g' P + Dμ.coeff P :=
        le_antisymm (Finset.inf'_le _ hg'T)
          (Finset.le_inf' hne _ fun g hg => by have := hmin g hg; omega)
      rw [e1, e2, add_comm]
    have hpos : ∀ g ∈ T, 0 < Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
      intro g hg
      have h1 : 0 ≤ F.coeff P := by
        rw [hFP]; exact Finset.le_inf' hne _ hnonneg
      have h2 : F.coeff P ≤ Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
        rw [hFP]; exact Finset.inf'_le _ hg
      have h3 : F.coeff P ≠ 0 := hP
      omega
    have hη := genericPoint_mem_support_comap μ T hTs P hφ hcU₀ hpos
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxP
    exact (specializes_iff_mem_closure.mpr hxP).mem_closed
      ((T.sup (sectionIdeal L)).comap μ).support.isClosed hη
  have hΘeq : (QDivisor.toRDivisor (Divisor.toQDivisor Θ)).supp = Θ.supp := by
    rw [QDivisor.supp_toRDivisor, Divisor.supp_toQDivisor]
  have hsncF : IsSNCSubset (μ ≫ sW)
      (exceptionalSet μ ⊔ Θ.supp.preimage μ.continuous ⊔ F.supp) := by
    rw [hΘeq] at hsnc
    have hlogS := hlogM.isSNCSubset
    rw [hΘeq] at hlogS
    refine isSNCSubset_of_le hsnc ?_ (sup_le_sup_left hFle _)
    refine isPureCodimOne_sup ?_ (isPureCodimOne_of_eq_iUnion' _ F.support
      (DivisorWithCoeffs.coe_supp F))
    rcases hlogS with h | ⟨s', hs', -⟩
    · rw [h]; intro Z hZ; exact absurd (Z.isIrreducible.nonempty.mono hZ.prop) (by simp)
    · exact isPureCodimOne_of_eq_iUnion' _ s' hs'.symm
  -- the zero log discrepancy divisor and the adjoint discrepancy divisor
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sW hW.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sW n (Divisor.toRDivisor Θ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hW hsm hn (Divisor.toQDivisor Θ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sW hW.1 hsm hΘ.1 hΘ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sW) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sW) hsmY hlogM.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sW hW hsm hn hΘ.1 (D := 0) (fun _ => le_rfl) hY hμ
        hres.isProper (by simpa using hs.ge) hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨Y, μ, _, hW, hsm, hΘ, hLc, hVs, hVns, hc, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Dμ, F, Γ, E, hDμ, ⟨⟨hlogM, hproj⟩, hfix, hfree, hsncF⟩,
    ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

/-- **A log resolution of a boundary and of a linear series.** On a smooth variety `W`, for an
`ℝ`-divisor `R` and a set `V` of sections of `𝒪_W(L)` containing a nonzero member, there is a
projective log resolution `μ : Y ⟶ W` of `(W, R)` on which `μ^*V = |M| + F` with `M` free, `F`
the fixed divisor, and `Ex(μ) ∪ μ⁻¹(Supp R) ∪ Supp F` an snc divisor. -/
private theorem exists_isLogResolution_isFreeModuloFixedDivisor {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] (sW : W ⟶ Spec (.of k)) (hW : IsNormalVariety k sW)
    (hsm : IsSmoothScheme sW) (R : RDivisor W) {L : Divisor W} (V : Set W.functionField)
    (hVs : V ⊆ sectionsIn L) {g₀ : W.functionField} (hg₀V : g₀ ∈ V) (hg₀ : g₀ ≠ 0) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ W) (_ : IsIntegral Y) (_ : IsLocallyNoetherian Y) (_ : IsNormal Y)
      (_ : IsDominant μ) (hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ L.supp)
      (Dμ F : Divisor Y),
      MMP.Mori.IsLogResolution sW R μ ∧ IsProjectiveMorphism μ ∧ L.IsPullback μ hD Dμ ∧
      IsFixedDivisorOfPullback μ V Dμ F ∧ IsFreeModuloFixedDivisor μ V Dμ F ∧
      IsSNCSubset (μ ≫ sW) (exceptionalSet μ ⊔ R.supp.preimage μ.continuous ⊔ F.supp) := by
  classical
  haveI : MMP.Mori.IsVariety k sW := hW.1
  haveI : IsNoetherian W := {}
  have hLc : L.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm L
  obtain ⟨T, hg₀T, hT, hTle⟩ := exists_finset_sectionIdeal_le (L := L) V
    hg₀V hg₀
  have hTs : ∀ g ∈ T, g ∈ sectionsIn L ∧ g ≠ 0 := fun g hg => ⟨hVs (hT g hg).1, (hT g hg).2⟩
  set I := T.sup (sectionIdeal L) with hI
  have hIgen : genericPoint W ∉ I.support := by
    intro hη
    have hle : sectionIdeal L g₀ ≤ I := Finset.le_sup (f := sectionIdeal L) hg₀T
    have hη' := Scheme.IdealSheafData.support_antitone hle hη
    obtain ⟨U₀, hηU₀, φ, hφ⟩ := hLc (genericPoint W)
    obtain ⟨U, hUaff, hηU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens W)) hηU₀
    haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
    obtain ⟨t, ht, hspan⟩ := sectionIdeal_ideal_eq_span (hVs hg₀V) hg₀ hφ ⟨U, hUaff⟩ hUU₀
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hUaff⟩) hηU] at hη'
    have ht0 : W.germToFunctionField U t ≠ 0 := by
      rw [ht]
      exact mul_ne_zero hg₀ (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
    refine (W.mem_zeroLocus_iff _ _).mp hη' t (by rw [hspan]; exact Ideal.mem_span_singleton_self t)
      ((W.mem_basicOpen t _ hηU).mpr ?_)
    exact isUnit_iff_ne_zero.mpr ht0
  obtain ⟨Y, μ, hlogM, hproj, hcart, hsnc⟩ := exists_isLogResolution_isEffectiveCartierDivisor_comap'
    sW hW R I hIgen
  have hres := hlogM.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hW
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sW) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sW)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sW) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sW)
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ L.supp :=
    MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ L
  obtain ⟨Dμ, hDμ⟩ := hLc.exists_isPullback hD
  -- the fixed divisor
  have hne : T.Nonempty := ⟨g₀, hg₀T⟩
  let ordm : W.functionField → MMP.Mori.PrimeDivisor Y → ℤ := fun g P =>
    Y.ord (functionFieldMap μ g) P.genericPoint
  let F : Divisor Y := Finsupp.ofSupportFinite
    (fun P => Dμ.coeff P + T.inf' hne (fun g => ordm g P)) (by
      have hfin : ∀ g ∈ T, {P | ordm g P ≠ 0}.Finite := fun g hg =>
        (Finset.finite_toSet (Finsupp.support (ffDiv (functionFieldMap μ g)
          ((map_ne_zero_iff _ (functionFieldMap μ).injective).mpr (hTs g hg).2)))).subset
          fun P hP => by
            rw [Finset.mem_coe, Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
              MMP.Mori.coeff_principalDivisor_mk0]
            exact hP
      refine (Set.Finite.union (Finset.finite_toSet Dμ.support)
        (Set.Finite.biUnion (Finset.finite_toSet T) hfin)).subset ?_
      intro P hP
      by_contra hnot
      simp only [Set.mem_union, Finset.mem_coe, Finsupp.mem_support_iff, Set.mem_iUnion,
        Set.mem_setOf_eq, not_or, not_exists, not_not] at hnot
      apply hP
      have h2 : T.inf' hne (fun g => ordm g P) = 0 := by
        rw [Finset.inf'_congr hne rfl fun g hg => hnot.2 g hg]
        exact Finset.inf'_const hne 0
      change Dμ P + T.inf' hne (fun g => ordm g P) = 0
      rw [h2, hnot.1, add_zero])
  have hFc : ∀ P, F.coeff P = Dμ.coeff P + T.inf' hne (fun g => ordm g P) := fun P => rfl
  have hFeq : ∀ P, Dμ.coeff P - F.coeff P = -T.inf' hne (fun g => ordm g P) := fun P => by
    rw [hFc]; ring
  have hinj := (functionFieldMap μ).injective
  have hval : ∀ g : W.functionField, g ≠ 0 → ∀ P : MMP.Mori.PrimeDivisor Y,
      P.valuationOver μ g = WithZero.exp (-ordm g P) := fun g hg P => by
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero_iff _ hinj).mpr hg)]
  have hfix : IsFixedDivisorOfPullback μ V Dμ F := by
    intro P
    refine ⟨fun g hgV => ?_, ?_⟩
    · by_cases hg0 : g = 0
      · simp [hg0]
      obtain ⟨g', hg'T, hle⟩ :=
        exists_ord_le_of_le_sup μ hLc T hTs (hVs hgV) hg0 (hTle g hgV) P hne
      rw [hval g hg0, hFeq, WithZero.exp_le_exp]
      have := Finset.inf'_le (fun g => ordm g P) hg'T
      change -ordm g P ≤ -T.inf' hne (fun g => ordm g P)
      change ordm g' P ≤ ordm g P at hle
      omega
    · obtain ⟨g', hg'T, hmin⟩ := Finset.exists_min_image T (fun g => ordm g P) hne
      refine ⟨g', (hT g' hg'T).1, (hT g' hg'T).2, ?_⟩
      rw [hval g' (hT g' hg'T).2, hFeq]
      congr 2
      exact le_antisymm (Finset.le_inf' hne _ fun g hg => hmin g hg)
        (Finset.inf'_le _ hg'T)
  have hfree : IsFreeModuloFixedDivisor μ V Dμ F := by
    intro y
    obtain ⟨g', hg'T, hmin⟩ := exists_forall_ord_le μ hLc T hTs hne hcart y
    refine ⟨g', (hT g' hg'T).1, (hT g' hg'T).2, fun P hyP => ?_⟩
    rw [hval g' (hT g' hg'T).2, hFeq]
    congr 2
    exact le_antisymm (Finset.le_inf' hne _ fun g hg => hmin P hyP g hg)
      (Finset.inf'_le _ hg'T)
  have hFle : F.supp ≤ ((T.sup (sectionIdeal L)).comap μ).support := by
    intro x hx
    obtain ⟨P, hP, hxP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
    obtain ⟨U₀, hcU₀, φ, hφ⟩ := hLc (μ P.genericPoint)
    set ψ := rationalFunctionsEquivFunctionField W φ with hψdef
    have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField W)).ne_zero
    have hDP : Dμ.coeff P = Y.ord (functionFieldMap μ ψ) P.genericPoint := by
      rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hDμ hφ P hcU₀
        (MMP.Mori.pointComponent (genericPoint W)), evalFF_eq_rationalFunctionsEquivFunctionField]
    have hgψ : ∀ g ∈ T, Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint =
        ordm g P + Dμ.coeff P := fun g hg => by
      rw [map_mul, Scheme.ord_mul ((map_ne_zero_iff _ hinj).mpr (hTs g hg).2)
        ((map_ne_zero_iff _ hinj).mpr hψ0), hDP]
    have hnonneg : ∀ g ∈ T, 0 ≤ Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
      intro g hg
      obtain ⟨U, hUaff, hcU, hUU₀⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens W)) hcU₀
      haveI : Nonempty U := ⟨⟨_, hcU⟩⟩
      obtain ⟨sg, hsg, -⟩ := sectionIdeal_ideal_eq_span (hTs g hg).1 (hTs g hg).2 hφ
        ⟨U, hUaff⟩ hUU₀
      have hyP : P.genericPoint ∈ P.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      have hne0 : functionFieldMap μ (g * ψ) ≠ 0 :=
        (map_ne_zero_iff _ hinj).mpr (mul_ne_zero (hTs g hg).2 hψ0)
      rw [← hsg, ← Scheme.algebraMap_germ_eq_germToFunctionField W hcU,
        MMP.Mori.functionFieldMap_algebraMap_stalk] at hne0 ⊢
      exact ord_algebraMap_nonneg P hyP _ hne0
    have hFP : F.coeff P = T.inf' hne (fun g => Y.ord (functionFieldMap μ (g * ψ))
        P.genericPoint) := by
      rw [hFc, Finset.inf'_congr hne rfl hgψ]
      obtain ⟨g', hg'T, hmin⟩ := Finset.exists_min_image T (fun g => ordm g P) hne
      have e1 : T.inf' hne (fun g => ordm g P) = ordm g' P :=
        le_antisymm (Finset.inf'_le _ hg'T) (Finset.le_inf' hne _ hmin)
      have e2 : T.inf' hne (fun g => ordm g P + Dμ.coeff P) = ordm g' P + Dμ.coeff P :=
        le_antisymm (Finset.inf'_le _ hg'T)
          (Finset.le_inf' hne _ fun g hg => by have := hmin g hg; omega)
      rw [e1, e2, add_comm]
    have hpos : ∀ g ∈ T, 0 < Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
      intro g hg
      have h1 : 0 ≤ F.coeff P := by
        rw [hFP]; exact Finset.le_inf' hne _ hnonneg
      have h2 : F.coeff P ≤ Y.ord (functionFieldMap μ (g * ψ)) P.genericPoint := by
        rw [hFP]; exact Finset.inf'_le _ hg
      have h3 : F.coeff P ≠ 0 := hP
      omega
    have hη := genericPoint_mem_support_comap μ T hTs P hφ hcU₀ hpos
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxP
    exact (specializes_iff_mem_closure.mpr hxP).mem_closed
      ((T.sup (sectionIdeal L)).comap μ).support.isClosed hη
  have hsncF : IsSNCSubset (μ ≫ sW)
      (exceptionalSet μ ⊔ R.supp.preimage μ.continuous ⊔ F.supp) := by
    have hlogS := hlogM.isSNCSubset
    refine isSNCSubset_of_le hsnc ?_ (sup_le_sup_left hFle _)
    refine isPureCodimOne_sup ?_ (isPureCodimOne_of_eq_iUnion' _ F.support
      (DivisorWithCoeffs.coe_supp F))
    rcases hlogS with h | ⟨s', hs', -⟩
    · rw [h]; intro Z hZ; exact absurd (Z.isIrreducible.nonempty.mono hZ.prop) (by simp)
    · exact isPureCodimOne_of_eq_iUnion' _ s' hs'.symm
  exact ⟨Y, μ, inferInstance, inferInstance, inferInstance, inferInstance, hD, Dμ, F, hlogM,
    hproj, hDμ, hfix, hfree, hsncF⟩

end BaseIdeal

section AsymptoticExistence

variable {W : Scheme.{0}} [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] [CompactSpace W]

variable {Z : Scheme.{0}} (f : W ⟶ Z)

/-- Powers of a member of a graded linear series lie in the series. -/
private theorem pow_mem_of_isGradedLinearSeries {D : Divisor W} {V : ℕ → AddSubgroup W.functionField}
    (hV : IsGradedLinearSeries f D V) {m : ℕ} {g : W.functionField} (hg : g ∈ V m) (q : ℕ) :
    g ^ q ∈ V (m * q) := by
  induction q with
  | zero => simpa using hV.2.2.1
  | succ q ih => rw [pow_succ, Nat.mul_succ]; exact hV.2.2.2 _ _ _ _ ih hg

/-- The base locus of `V_{bq}` lies in that of `V_b`. -/
private theorem baseLocusIn_mul_subset {D : Divisor W} {V : ℕ → AddSubgroup W.functionField}
    (hV : IsGradedLinearSeries f D V) (b q : ℕ) :
    baseLocusIn (V (b * q)) (((b * q : ℕ) : ℤ) • D) ⊆ baseLocusIn (V b) ((b : ℤ) • D) := by
  intro x hx
  by_contra hxb
  obtain ⟨g, hgV, hg⟩ := exists_isNonvanishingAt_of_notMem_baseLocusIn (hV.1 b) hxb
  refine notMem_baseLocusIn_of_mem_of_isNonvanishingAt (pow_mem_of_isGradedLinearSeries f hV hgV q) ?_ hx
  refine (hg.pow q).congr_left ?_
  rw [smul_smul]; push_cast; ring_nf

omit [CompactSpace W] in
/-- Sections multiply: `H⁰(𝒪(M₁)) · H⁰(𝒪(M₂)) ⊆ H⁰(𝒪(M₁ + M₂))`. -/
private theorem mul_mem_sectionsIn {M₁ M₂ : Divisor W} {g₁ g₂ : W.functionField}
    (h₁ : g₁ ∈ sectionsIn M₁) (h₂ : g₂ ∈ sectionsIn M₂) : g₁ * g₂ ∈ sectionsIn (M₁ + M₂) :=
  fun P => by
    rw [map_mul, DivisorWithCoeffs.coeff_add, WithZero.exp_add]
    exact mul_le_mul' (h₁ P) (h₂ P)

omit [CompactSpace W] in
private theorem one_mem_sectionsIn_zero_smul (M : Divisor W) :
    (1 : W.functionField) ∈ sectionsIn (((0 : ℕ) : ℤ) • M) := fun P => by
  rw [map_one, DivisorWithCoeffs.coeff_smul]; simp

omit [CompactSpace W] in
/-- Regular functions from the base multiply sections into sections. -/
private theorem baseFunction_mul_mem_sectionsIn (a : Γ(Z, ⊤)) {M : Divisor W}
    {g : W.functionField} (hg : g ∈ sectionsIn M) : baseFunction f a * g ∈ sectionsIn M := by
  intro P
  have h1 : P.divisorialValuation (baseFunction f a) ≤ 1 := by
    refine (P.divisorialValuation_le_one_iff _).mpr
      ⟨W.presheaf.germ ⊤ P.genericPoint (show P.genericPoint ∈ (⊤ : W.Opens) from trivial)
        (f.appTop a), ?_⟩
    rw [Scheme.algebraMap_germ_eq_germToFunctionField]; rfl
  rw [map_mul]
  exact (mul_le_mul' h1 (hg P)).trans (by rw [one_mul])

omit [CompactSpace W] in
/-- The complete graded linear series `V_m = H⁰(X, 𝒪_X(mD))` is a graded linear series. -/
private theorem isGradedLinearSeries_completeSeries (D : Divisor W) :
    IsGradedLinearSeries f D (completeSeries D) := by
  refine ⟨fun m => le_rfl, fun m a g hg => baseFunction_mul_mem_sectionsIn f a hg,
    one_mem_sectionsIn_zero_smul D, fun m n g h hg hh => ?_⟩
  have := mul_mem_sectionsIn hg hh
  rwa [← add_smul, ← Nat.cast_add] at this

/-- A common degree in which a graded linear series has, at each of finitely many points, a
member not vanishing there. -/
private theorem exists_pos_forall_isNonvanishingAt {D : Divisor W}
    {V : ℕ → AddSubgroup W.functionField} (hV : IsGradedLinearSeries f D V) {s : Set W}
    (hs : s.Finite)
    (h : ∀ ξ ∈ s, ∃ m : ℕ, 0 < m ∧ ∃ g ∈ V m, IsNonvanishingAt ((m : ℤ) • D) g ξ) :
    ∃ b : ℕ, 0 < b ∧ ∀ ξ ∈ s, ∃ g ∈ V b, IsNonvanishingAt ((b : ℤ) • D) g ξ := by
  classical
  choose! m hm g hgV hg using h
  refine ⟨∏ ξ ∈ hs.toFinset, m ξ, Finset.prod_pos fun ξ hξ => hm ξ (hs.mem_toFinset.mp hξ),
    fun ξ hξ => ?_⟩
  obtain ⟨q, hq⟩ := Finset.dvd_prod_of_mem m (hs.mem_toFinset.mpr hξ)
  rw [hq]
  refine ⟨g ξ ^ q, pow_mem_of_isGradedLinearSeries f hV (hgV ξ hξ) q,
    ((hg ξ hξ).pow q).congr_left ?_⟩
  rw [smul_smul]; push_cast; ring_nf

/-- **Existence of the asymptotic adjoint ideal.** For a graded linear series `V_•` of an integral
divisor on a smooth projective variety over an affine base, with `V_b ≠ 0` whose base locus
contains no stratum of the reduced snc divisor `Δ`, every `V_p` (`b ∣ p`) has the same property,
so the adjoint ideals `𝒥_{Δ,(c/p)V_p}` exist and the asymptotic adjoint ideal is their union. -/
private theorem exists_isAsymptoticAdjointIdeal {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    (sW : W ⟶ Spec (.of k)) (hf : IsProjectiveMorphism f) [IsAffine Z]
    (hW : IsNormalVariety k sW) (hsm : IsSmoothScheme sW) {Δ : Divisor W}
    (hΔ : IsReducedSNC sW Δ) {D : Divisor W} (hD : D.IsCartier)
    {V : ℕ → AddSubgroup W.functionField} (hV : IsGradedLinearSeries f D V) {b : ℕ} (hb : 0 < b)
    (hVb : V b ≠ ⊥) (hns : ContainsNoStratum Δ (baseLocusIn (V b) ((b : ℤ) • D))) {c : ℚ}
    (hc : 0 < c) : ∃ J, IsAsymptoticAdjointIdeal sW f Δ D V b c J := by
  classical
  obtain ⟨g₀, hg₀V, hg₀⟩ := (AddSubgroup.bot_or_exists_ne_zero (V b)).resolve_left hVb
  have H : ∀ p : ℕ, ∃ J : W.Opens → Set W.functionField, 0 < p → b ∣ p →
      IsSeriesAdjointIdeal sW Δ ((p : ℤ) • D) (V p) (c / p) J := by
    intro p
    by_cases hp : 0 < p ∧ b ∣ p
    · obtain ⟨q, rfl⟩ := hp.2
      have hq0 : (g₀ : W.functionField) ^ q ≠ 0 := pow_ne_zero _ hg₀
      obtain ⟨Y, μ, J, hJ⟩ := exists_isSeriesAdjointIdealOn sW hW hsm hΔ (V (b * q))
        (hV.1 _) (pow_mem_of_isGradedLinearSeries f hV hg₀V q) hq0
        (fun S hS hSB => hns S hS ((hSB.trans (baseLocusIn_mul_subset f hV b q))))
        (c := c / ((b * q : ℕ) : ℚ)) (div_nonneg hc.le (Nat.cast_nonneg _))
      exact ⟨J, fun _ _ => ⟨Y, μ, hJ⟩⟩
    · exact ⟨fun _ _ => False, fun h1 h2 => absurd ⟨h1, h2⟩ hp⟩
  choose Jp hJp using H
  refine ⟨fun U g => (U = ⊥ → g = 0) ∧ ∀ x ∈ U, ∃ W' : W.Opens, x ∈ W' ∧ W' ≤ U ∧
      ∃ p : ℕ, 0 < p ∧ b ∣ p ∧ g ∈ Jp p W', hf, inferInstance, hW, hsm, hΔ, hD, hV, hb, hVb,
    hns, hc, Jp, fun p h1 h2 => hJp p h1 h2, fun U g => Iff.rfl⟩

end AsymptoticExistence

section ImageSeriesGraded

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z)

omit [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- Restriction to `S` is multiplicative. -/
private theorem IsRestrictionAlong.mul {S : MMP.Mori.PrimeDivisor X} {g₁ g₂ : X.functionField}
    {h₁ h₂ : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hr₁ : IsRestrictionAlong S g₁ h₁) (hr₂ : IsRestrictionAlong S g₂ h₂) :
    IsRestrictionAlong S (g₁ * g₂) (h₁ * h₂) := by
  haveI := S.integral
  obtain ⟨a₁, ha₁, hb₁⟩ := hr₁
  obtain ⟨a₂, ha₂, hb₂⟩ := hr₂
  exact ⟨a₁ * a₂, by rw [map_mul, ha₁, ha₂], by rw [map_mul, hb₁, hb₂]⟩

omit [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
private theorem isRestrictionAlong_one (S : MMP.Mori.PrimeDivisor X) :
    haveI := S.integral
    IsRestrictionAlong S 1 1 := by
  haveI := S.integral
  exact ⟨1, map_one _, map_one _⟩

omit [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- The image of a regular function on the base restricts to its image on `S`. -/
private theorem isRestrictionAlong_baseFunction (S : MMP.Mori.PrimeDivisor X) (a : Γ(Z, ⊤)) :
    haveI := S.integral
    IsRestrictionAlong S (baseFunction f a) (baseFunction (S.idealSheaf.subschemeι ≫ f) a) := by
  haveI := S.integral
  refine ⟨X.presheaf.germ ⊤ (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))
    (show _ ∈ (⊤ : X.Opens) from trivial) (f.appTop a), ?_, ?_⟩
  · exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  · have key : f.appTop ≫
        X.presheaf.germ ⊤ (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))
          (show _ ∈ (⊤ : X.Opens) from trivial) ≫
          S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme) =
        (S.idealSheaf.subschemeι ≫ f).appTop ≫
          S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint S.idealSheaf.subscheme)
            (show _ ∈ (⊤ : S.idealSheaf.subscheme.Opens) from trivial) := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.comp_appTop, Category.assoc]
      rfl
    exact congrArg (fun ψ => ψ.hom a) key

omit [CompactSpace X] in
/-- A nonzero restriction comes from a unit at the generic point of `S`. -/
private theorem ne_zero_and_ord_eq_zero_of_isRestrictionAlong (S : MMP.Mori.PrimeDivisor X)
    {g : X.functionField} {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hh : h ≠ 0) :
    g ≠ 0 ∧ X.ord g S.genericPoint = 0 := by
  haveI := S.integral
  obtain ⟨a, ha, hb⟩ := hgh
  have hu : IsUnit a := by
    have : IsUnit (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme) a) := by
      rw [hb]; exact isUnit_iff_ne_zero.mpr hh
    exact isUnit_of_map_unit _ a this
  have hnm : a ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk S.genericPoint) :=
    fun hm => (IsLocalRing.mem_maximalIdeal a).mp hm hu
  have h2 : algebraMap S.localRing X.functionField a = g := ha
  have hv : S.divisorialValuation g = 1 := by
    rw [← h2]
    refine le_antisymm ((S.divisorialValuation_le_one_iff _).mpr ⟨a, rfl⟩) ?_
    exact not_lt.mp fun hlt => hnm ((S.divisorialValuation_algebraMap_lt_one_iff a).mp hlt)
  have hg0 : g ≠ 0 := by rintro rfl; simp at hv
  refine ⟨hg0, ?_⟩
  rw [S.divisorialValuation_eq_exp_neg_ord hg0, ← WithZero.exp_zero] at hv
  have := WithZero.exp_injective hv
  omega

/-- **Restricting a section.** The restriction to `S` of a section of `𝒪_X(M)`, for `S` not a
component of `M`, is a section of `𝒪_S(M|_S)`. -/
private theorem mem_sectionsIn_restrictPrimeDivisor [NoetherianSpace X]
    (hsm : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    {M : Divisor X} (hM : M.coeff S = 0) {g : X.functionField}
    {h : haveI := S.integral; S.idealSheaf.subscheme.functionField} (hg : g ∈ sectionsIn M)
    (hgh : IsRestrictionAlong S g h) :
    haveI := S.integral
    h ∈ sectionsIn (M.restrictPrimeDivisor S) := by
  haveI := S.integral
  by_cases hh0 : h = 0
  · subst hh0; exact (sectionsSubgroup _).zero_mem
  obtain ⟨hg0, hord⟩ := ne_zero_and_ord_eq_zero_of_isRestrictionAlong S hgh hh0
  have hres := restrictPrimeDivisor_add_ffDiv sX hsm S hSsm M hM hgh hg0 hh0
  have hES : (M + ffDiv g hg0).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hM, zero_add, MMP.Mori.coeff_principalDivisor_mk0]; exact hord
  refine mem_sectionsIn_of_coeff_nonneg hh0 fun Q => ?_
  rw [← hres]
  exact coeff_restrictPrimeDivisor_nonneg S (coeff_add_ffDiv_nonneg hg hg0) hES Q

/-- **The image series is a graded linear series** of the restricted divisor. -/
private theorem isGradedLinearSeries_imageSeries [NoetherianSpace X]
    (hsm : IsSmoothScheme sX) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    {M : Divisor X} (hM : M.coeff S = 0) :
    haveI := S.integral
    IsGradedLinearSeries (S.idealSheaf.subschemeι ≫ f) (M.restrictPrimeDivisor S)
      (imageSeries M S) := by
  haveI := S.integral
  refine ⟨fun m h hh => ?_, fun m a h hh => ?_, ?_, fun m n h₁ h₂ hh₁ hh₂ => ?_⟩
  · obtain ⟨g, hg, hgh⟩ := (mem_imageSeries_iff M S m h).1 hh
    have hmS : ((m : ℤ) • M).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_smul, hM, smul_zero]
    have := mem_sectionsIn_restrictPrimeDivisor sX hsm S hSsm hmS hg hgh
    rwa [DivisorWithCoeffs.restrictPrimeDivisor_zsmul _ S hM _] at this
  · obtain ⟨g, hg, hgh⟩ := (mem_imageSeries_iff M S m h).1 hh
    exact (mem_imageSeries_iff M S m _).2 ⟨baseFunction f a * g,
      baseFunction_mul_mem_sectionsIn f a hg, IsRestrictionAlong.mul (isRestrictionAlong_baseFunction f S a) hgh⟩
  · exact (mem_imageSeries_iff M S 0 1).2
      ⟨1, one_mem_sectionsIn_zero_smul M, isRestrictionAlong_one S⟩
  · obtain ⟨g₁, hg₁, hgh₁⟩ := (mem_imageSeries_iff M S m h₁).1 hh₁
    obtain ⟨g₂, hg₂, hgh₂⟩ := (mem_imageSeries_iff M S n h₂).1 hh₂
    refine (mem_imageSeries_iff M S (m + n) _).2 ⟨g₁ * g₂, ?_, IsRestrictionAlong.mul hgh₁ hgh₂⟩
    have := mul_mem_sectionsIn hg₁ hg₂
    rwa [← add_smul, ← Nat.cast_add] at this

end ImageSeriesGraded

