/-! ### Log discrepancies under adding a Cartier divisor, and valuative bounds -/

section Toolkit

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- Adding `c • C` to the boundary, for a Cartier divisor `C` with pull-back `C'` along the model,
lowers a log discrepancy by `c` times the coefficient of `C'` along the divisor. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {C : Divisor X}
    (hC : C.IsCartier) (c : ℝ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + c • Divisor.toRDivisor C) F
        (a - c * (C'.coeff F.E : ℝ)) := by
  classical
  intro C' hCs hC'
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₁, C₁', hC₁, hrel, hpb, ha⟩ := h
  refine ⟨hnv, hprop, ω, hω0, hK, m + 1, Fin.snoc r c, Fin.snoc C₁ C, Fin.snoc C₁' C', ?_, ?_,
    ?_, ?_⟩
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using hC
    · simpa using hC₁ j
  · intro Γ
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, DivisorWithCoeffs.coeff_add, ← hrel Γ,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    ring
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · refine ⟨by simpa using hCs, ?_⟩
      simpa using hC'
    · simpa using hpb j
  · rw [Fin.sum_univ_castSucc, ha]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    ring

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → 0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- Log discrepancies exist on a smooth variety, at the index `n = dim X`. -/
private theorem exists_isLogDiscrepancy [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (F : DivisorOver k sX) (hF : IsProper F.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) F a := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK F
  exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hF⟩

/-- Adding a `ℚ`-divisor `D` with a Cartier multiple `D₀ = mD` lowers a log discrepancy by
`1/m` times the coefficient of the pull-back of `D₀`. -/
private theorem isLogDiscrepancy_add_of_zsmul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {D : QDivisor X} {m : ℕ}
    (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (D₀' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ D₀.supp), D₀.IsPullback F.f hCs D₀' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + QDivisor.toRDivisor D) F
        (a - (D₀'.coeff F.E : ℝ) / m) := by
  intro D₀' hCs hpb
  have h1 := isLogDiscrepancy_add_smul h hD₀c (1 / (m : ℝ)) D₀' hCs hpb
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : B + (1 / (m : ℝ)) • Divisor.toRDivisor D₀ = B + QDivisor.toRDivisor D := by
    congr 1
    refine Finsupp.ext fun Γ => ?_
    have h2 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    have h3 : ((D₀.coeff Γ : ℤ) : ℝ) = m * ((D.coeff Γ : ℚ) : ℝ) := by exact_mod_cast h2
    change DivisorWithCoeffs.coeff ((1 / (m : ℝ)) • Divisor.toRDivisor D₀) Γ =
      DivisorWithCoeffs.coeff (QDivisor.toRDivisor D) Γ
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, QDivisor.coeff_toRDivisor,
      smul_eq_mul, h3]
    field_simp
  rw [e] at h1
  convert h1 using 1
  ring

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{0}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  show IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    rw [if_pos hPJ]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    rw [if_neg hPJ]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every closed set containing no stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : IsClosed T) (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K (Divisor.toQDivisor Δ) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hK F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists, not_and]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  haveI : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxT)

/-- Adding `∑_{P ∈ s} c_P P` to the boundary on a smooth variety lowers a log discrepancy by
`∑_{P ∈ s} c_P e_P`, where `e_P` is the coefficient of the pull-back of `P` along the divisor. -/
private theorem isLogDiscrepancy_add_sum (hsm : IsSmoothScheme sX) {n : ℕ} {B : RDivisor X}
    {F : DivisorOver k sX} {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (c : MMP.Mori.PrimeDivisor X → ℝ)
    (e : MMP.Mori.PrimeDivisor X → ℤ)
    (he : haveI := F.isLocallyNoetherian
      haveI := F.isNormal
      ∀ P ∈ s, ∀ (P' : Divisor F.Y) (hB : ∀ Z : irreducibleComponents F.Y,
          F.f (componentGenericPoint F.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor X)),
        Divisor.IsPullback F.f (Finsupp.single P 1 : Divisor X) hB P' → P'.coeff F.E = e P) :
    MMP.Intersection.IsLogDiscrepancy sX n
      (B + ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X)) F
      (a - ∑ P ∈ s, c P * e P) := by
  classical
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  induction s using Finset.induction_on with
  | empty => simpa using h
  | insert P s hP ih =>
    have hC : Divisor.IsCartier (Finsupp.single P 1 : Divisor X) :=
      MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
      (Finsupp.single P (1 : ℤ) : Divisor X)
    obtain ⟨P', hP'⟩ := hC.exists_isPullback hB
    have h' := isLogDiscrepancy_add_smul (ih fun Q hQ => he Q (Finset.mem_insert_of_mem hQ)) hC
      (c P) P' hB hP'
    rw [he P (Finset.mem_insert_self _ _) P' hB hP'] at h'
    have e1 : B + ∑ Q ∈ insert P s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) =
        B + ∑ Q ∈ s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) +
          c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
      rw [Finset.sum_insert hP]; abel
    have e2 : a - ∑ Q ∈ insert P s, c Q * e Q = a - ∑ Q ∈ s, c Q * e Q - c P * e P := by
      rw [Finset.sum_insert hP]; ring
    rw [e1, e2]
    exact h'

/-- **Zero places see no `D`.** If `a(F, X, Δ) = 0` for the reduced snc `Δ` and `D` contains no
stratum of `Δ`, then `a(F, X, Δ + D) = 0`. -/
private theorem eq_zero_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hns : ContainsNoStratum Δ D.supp) {n : ℕ}
    {F : DivisorOver k sX} {a : ℝ}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0)
    (ha : MMP.Intersection.IsLogDiscrepancy sX n
      (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a) : a = 0 := by
  have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ (DivisorWithCoeffs.supp D).isClosed
    hns h0
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
  obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hz := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hx) D₀' hB hD₀'
  have h1 := isLogDiscrepancy_add_of_zsmul h0 hm hD₀ hD₀c D₀' hB hD₀'
  rw [hz] at h1
  have h2 : (0 : ℝ) - ((0 : ℤ) : ℝ) / m = 0 := by simp
  rw [h2] at h1
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1

end Toolkit

/-! ### The arithmetic of the comparison on a log resolution -/

/-- If `A₀ = t + ∑ a₀ᵢ eᵢ` and `A = t + ∑ αᵢ eᵢ` with `t, eᵢ ≥ 0`, `a₀ᵢ ∈ ℕ`, `αᵢ = 0` whenever
`a₀ᵢ = 0`, and `Gᵢ = ⌈αᵢ⌉ - 1 + [a₀ᵢ = 0]`, then `∑ Gᵢ eᵢ ≤ ⌈A⌉ - 1 + [A₀ = 0]`. -/
private theorem sum_mul_le_ceil {ι : Type*} (s : Finset ι) (a₀ : ι → ℕ) (α : ι → ℝ)
    (e G : ι → ℤ) (t : ℕ) {A₀ A : ℝ} (he : ∀ i ∈ s, 0 ≤ e i)
    (hz : ∀ i ∈ s, a₀ i = 0 → α i = 0)
    (hG : ∀ i ∈ s, G i = ⌈α i⌉ - 1 + if ((a₀ i : ℕ) : ℝ) = 0 then 1 else 0)
    (hA₀ : A₀ = t + ∑ i ∈ s, (a₀ i : ℝ) * e i) (hA : A = t + ∑ i ∈ s, α i * e i) :
    ∑ i ∈ s, G i * e i ≤ ⌈A⌉ - 1 + if A₀ = 0 then 1 else 0 := by
  have hGz : ∀ i ∈ s, a₀ i = 0 → G i = 0 := by
    intro i hi h0
    rw [hG i hi, hz i hi h0]
    simp [h0]
  have hGpos : ∀ i ∈ s, a₀ i ≠ 0 → (G i : ℝ) < α i := by
    intro i hi h0
    rw [hG i hi, if_neg (by exact_mod_cast h0)]
    push_cast
    linarith [Int.ceil_lt_add_one (α i)]
  have hterm : ∀ i ∈ s, 0 ≤ (α i - G i) * e i := by
    intro i hi
    by_cases h0 : a₀ i = 0
    · rw [hz i hi h0, hGz i hi h0]; simp
    · exact mul_nonneg (by linarith [hGpos i hi h0]) (by exact_mod_cast he i hi)
  have hdiff : A - ∑ i ∈ s, (G i : ℝ) * e i = t + ∑ i ∈ s, (α i - G i) * e i := by
    rw [hA]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have ht : (0 : ℝ) ≤ t := Nat.cast_nonneg t
  by_cases hA0 : A₀ = 0
  · rw [if_pos hA0]
    have hnn : ∀ i ∈ s, 0 ≤ (a₀ i : ℝ) * e i := fun i hi =>
      mul_nonneg (Nat.cast_nonneg _) (by exact_mod_cast he i hi)
    have hs := Finset.sum_nonneg hnn
    have hsum0 : ∑ i ∈ s, (a₀ i : ℝ) * e i = 0 := by linarith
    have ht0 : (t : ℝ) = 0 := by linarith
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hsum0
    have hGe : ∀ i ∈ s, (G i : ℝ) * e i = 0 ∧ α i * e i = 0 := by
      intro i hi
      by_cases h0 : a₀ i = 0
      · rw [hGz i hi h0, hz i hi h0]; simp
      · have he0 : (e i : ℝ) = 0 := by
          rcases mul_eq_zero.mp (hzero i hi) with h | h
          · exact absurd (by exact_mod_cast h) h0
          · exact h
        rw [he0]; simp
    have hS : ∑ i ∈ s, (G i : ℝ) * e i = 0 := Finset.sum_eq_zero fun i hi => (hGe i hi).1
    have hA' : A = 0 := by
      rw [hA, ht0, Finset.sum_eq_zero fun i hi => (hGe i hi).2]; simp
    have hS' : ∑ i ∈ s, G i * e i = 0 := by exact_mod_cast hS
    rw [hS', hA']
    simp
  · rw [if_neg hA0]
    have hlt : ((∑ i ∈ s, G i * e i : ℤ) : ℝ) < A := by
      push_cast
      by_contra hle
      have hle := not_lt.mp hle
      have hsnn := Finset.sum_nonneg hterm
      have ht0 : (t : ℝ) = 0 := by linarith
      have hs0 : ∑ i ∈ s, (α i - G i) * e i = 0 := by linarith
      have hz2 := (Finset.sum_eq_zero_iff_of_nonneg hterm).mp hs0
      apply hA0
      rw [hA₀, ht0, zero_add]
      refine Finset.sum_eq_zero fun i hi => ?_
      by_cases h0 : a₀ i = 0
      · simp [h0]
      · rcases mul_eq_zero.mp (hz2 i hi) with h | h
        · exact absurd h (by linarith [hGpos i hi h0])
        · rw [h]; simp
    have : (∑ i ∈ s, G i * e i : ℤ) < ⌈A⌉ := by
      have := hlt.trans_le (Int.le_ceil A)
      exact_mod_cast this
    omega

/-- `⌈a⌉ - 1 + [a₀ = 0] ≤ 0` when `a ≤ a₀ ∈ {0, 1}`. -/
private theorem ceil_sub_one_add_ite_nonpos {a₀ a : ℝ} (h01 : a₀ = 0 ∨ a₀ = 1) (hle : a ≤ a₀) :
    ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) ≤ 0 := by
  rcases h01 with h | h
  · rw [if_pos h]
    have := Int.ceil_le.mpr (show a ≤ ((0 : ℤ) : ℝ) by push_cast; linarith)
    omega
  · rw [if_neg (by rw [h]; norm_num)]
    have := Int.ceil_le.mpr (show a ≤ ((1 : ℤ) : ℝ) by push_cast; linarith)
    omega

/-- The exponent `⌈a⌉ - 1 + [a₀ = 0]` decreases when the integral `a₀ ∈ ℕ` drops by `c₁ ≥ 0` to
`a₀ - c₁ ∈ ℕ` and `a` drops by at least `c₁`. -/
private theorem ceil_add_ite_le_of_le {a₀ a c₁ c₂ : ℝ} {p p' : ℕ} (hp : a₀ = p)
    (hp' : a₀ - 1 * c₁ = p') (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    ⌈a - 1 * c₁ - c₂⌉ - 1 + (if a₀ - 1 * c₁ = 0 then 1 else 0) ≤
      ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) := by
  have hmono : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a⌉ := Int.ceil_mono (by linarith)
  split_ifs with h1 h2 h2
  · omega
  · have hp1 : (1 : ℝ) ≤ p := by
      have hp0 : p ≠ 0 := by
        rintro rfl
        exact h2 (by rw [hp]; simp)
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hp0
    have h3 : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a - 1⌉ := Int.ceil_mono (by linarith)
    rw [Int.ceil_sub_one] at h3
    omega
  · exfalso
    apply h1
    have : (0 : ℝ) ≤ p' := Nat.cast_nonneg _
    linarith
  · omega

/-! ### Divisors over `X` realized over a proper birational model -/

section Model

variable {k : Type} [Field k]

/-- **The centre of a divisorial valuation on a proper model.** Let `π : W ⟶ X` be a proper
dominant morphism of integral schemes and `D` a divisor over `X`. A valuation `ξ` of `k(W)`
restricting to `ord_D` on `k(X)` dominates the local ring of some point of `W`. -/
private theorem exists_dominated_point {X W : Scheme.{0}} [IsIntegral X]
    [IsIntegral W] {sX : X ⟶ Spec (.of k)} (π : W ⟶ X) [IsDominant π] (hπ : IsProper π)
    (D : DivisorOver k sX) (ξ : Valuation W.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ.comap (functionFieldMap π) = D.valuation) :
    ∃ x : W, (∀ a : W.presheaf.stalk x, ξ (algebraMap _ W.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk x),
        ξ (algebraMap _ W.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  have hw : ∀ b : X.presheaf.stalk y,
      ξ (functionFieldMap π (algebraMap _ X.functionField b)) =
        D.valuation (algebraMap _ X.functionField b) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ X.functionField b)) h
    simpa only [Valuation.comap_apply] using this
  let R := ξ.valuationSubring
  let φ : X.presheaf.stalk y →+* R :=
    ((functionFieldMap π).comp (algebraMap (X.presheaf.stalk y) X.functionField)).codRestrict R
      fun b => (ξ.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint X ⤳ y := (genericPoint_spec X).specializes trivial
  have hex : ValuativeCriterion.Existence π := by
    have h : @IsProper _ _ π := hπ
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq π :=
    { R := R
      K := W.functionField
      i₁ := W.fromSpecStalk (genericPoint W)
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ X.fromSpecStalk y
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk π,
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R W.functionField)) ≫ l =
      W.fromSpecStalk (genericPoint W) := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint W ⤳ x := (genericPoint_spec W).specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R W.functionField) =
      W.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (W.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : W.presheaf.stalk x,
      algebraMap _ W.functionField a = ((f.hom a : R) : W.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]; exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

/-- **Divisors over `X` are realized over a proper birational model.** For a proper birational
morphism `π : W ⟶ X` of normal varieties and a divisor `D` over `X`, some divisor `D'` over `W`,
proper over `W`, induces the valuation of `D` on `k(X) ≅ k(W)`, and its centre on `W` maps to
the centre of `D` on `X`. -/
private theorem exists_divisorOver_model {X W : Scheme.{0}} [IsIntegral X] [IsIntegral W]
    {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX) (π : W ⟶ X) (hπ : IsProper π)
    (hbir : IsBirationalMorphism π) (hW : IsNormalVariety k (π ≫ sX)) (D : DivisorOver k sX) :
    haveI : IsDominant π := hbir.isDominant
    ∃ D' : DivisorOver k (π ≫ sX), IsProper D'.f ∧
      D.valuation = D'.valuation.comap (functionFieldMap π) ∧
      π (D'.f D'.E.genericPoint) = D.f D.E.genericPoint := by
  haveI : IsDominant π := hbir.isDominant
  have hbij := hbir.functionFieldMap_bijective
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (π ≫ sX)
  let eπ := functionFieldAlgEquiv sX π hbij
  let ξ := D.valuation.comap (eπ.symm : W.functionField →+* X.functionField)
  have hξ : ξ.comap (functionFieldMap π) = D.valuation := by
    ext t
    change D.valuation (eπ.symm (eπ t)) = D.valuation t
    rw [eπ.symm_apply_apply]
  obtain ⟨x, h1, h2⟩ := exists_dominated_point π hπ D ξ hξ
  haveI : AlgebraicGeometry.IsVariety k (π ≫ sX) := hW.1
  have hdiv : MMP.Flips.IsDivisorOfFunctionField k (π ≫ sX) ξ := by
    haveI := D.isIntegral
    haveI := D.isNormal
    haveI := D.isLocallyNoetherian
    haveI := D.isDominant
    refine ⟨D.Y, D.f ≫ sX, D.isNormalVariety, D.E, ?_⟩
    letI := functionFieldAlgebra (D.f ≫ sX)
    let eD := functionFieldAlgEquiv sX D.f D.isBirationalMorphism.functionFieldMap_bijective
    refine ⟨eπ.symm.trans eD, ?_⟩
    ext t
    rfl
  obtain ⟨D', -, hv, hDx⟩ :=
    MMP.Flips.exists_properDivisorOver_isProjective_of_dominates (π ≫ sX) hdiv x h1 h2
  have hval : D.valuation = D'.toDivisorOver.valuation.comap (functionFieldMap π) := by
    rw [← hξ, ← hv]
  refine ⟨D'.toDivisorOver, D'.isProper, hval, ?_⟩
  -- the centres agree: compare `D` with `D'` regarded as a divisor over `X`
  have hcomp := MMP.Mori.valuation_compDivisorOver π hW hbir D'.toDivisorOver
  have hcen := MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX
    (hcomp.trans hval.symm)
  have e1 := (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).center_eq_closure_genericPoint
  have e2 := D.center_eq_closure_genericPoint
  rw [← hcen, e1] at e2
  have hins : Inseparable ((MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).f
      (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).E.genericPoint)
      (D.f D.E.genericPoint) := inseparable_iff_closure_eq.mpr e2
  exact hins.eq

end Model

/-! ### Push-forwards with values in `𝒪_X` are ideal sheaves -/

section Ideal

variable {X X' : Scheme.{0}} [IsIntegral X] [IsIntegral X'] [IsLocallyNoetherian X']
  [IsNormal X'] (μ : X' ⟶ X) [IsDominant μ]

/-- The valuation `v_P(μ^* ·)` on the stalk of `X` at the centre `μ(η_P)` is at most `1`. -/
private theorem val_stalk_le_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) :
    P.valuationOver μ (algebraMap _ X.functionField a) ≤ 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
    MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff,
    MMP.Mori.functionFieldMap_algebraMap_stalk]
  exact ⟨_, rfl⟩

/-- A non-unit of the stalk of `X` at the centre `μ(η_P)` has `v_P(μ^* ·) < 1`. -/
private theorem val_stalk_lt_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) (ha : ¬ IsUnit a) :
    P.valuationOver μ (algebraMap _ X.functionField a) < 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_algebraMap_stalk,
    MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff]
  exact (IsLocalRing.mem_maximalIdeal _).mpr fun h => ha (isUnit_of_map_unit _ _ h)

/-- In `ℤᵐ⁰`, an element below `1` is at most `exp (-1)`. -/
private theorem le_exp_neg_one_of_lt_one {x : WithZero (Multiplicative ℤ)} (hx : x < 1) :
    x ≤ WithZero.exp (-1) := by
  rcases eq_or_ne x 0 with rfl | h0
  · exact zero_le'
  rw [← WithZero.exp_log h0] at hx ⊢
  rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hx
  rw [WithZero.exp_le_exp]
  omega

/-- The regular functions `a` on `U` with `v_P(μ^* a) ≤ exp (coeff_P G)` at every prime divisor
`P` whose generic point maps into `U`. -/
private def valIdeal (G : Divisor X') (U : X.Opens) : Ideal Γ(X, U) where
  carrier := {a | ∀ (P : MMP.Mori.PrimeDivisor X') (hP : μ P.genericPoint ∈ U),
    P.valuationOver μ (algebraMap _ X.functionField (X.presheaf.germ U _ hP a)) ≤
      WithZero.exp (G.coeff P)}
  add_mem' {a b} ha hb P hP := by
    rw [map_add, map_add]
    exact (Valuation.map_add _ _ _).trans (max_le (ha P hP) (hb P hP))
  zero_mem' P hP := by simp
  smul_mem' c a ha P hP := by
    rw [smul_eq_mul, map_mul, map_mul, Valuation.map_mul]
    exact (mul_le_of_le_one_left' (val_stalk_le_one μ P _)).trans (ha P hP)

/-- Some `m : ℕ` bounds every coefficient of `G` from below by `-m`. -/
private theorem exists_neg_le_coeff (G : Divisor X') : ∃ m : ℕ, ∀ P, -(m : ℤ) ≤ G.coeff P := by
  refine ⟨∑ P ∈ G.support, (G.coeff P).natAbs, fun P => ?_⟩
  by_cases hP : P ∈ G.support
  · have := Finset.single_le_sum (f := fun P => (G.coeff P).natAbs) (fun _ _ => Nat.zero_le _) hP
    omega
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.notMem_support_iff.mp hP]; omega

/-- If `y|_{D(f)} = f ^ n b` with `b` in the ideal on `D(f)`, then `f ^ m y` lies in the ideal on
`U` as soon as `-m` bounds the coefficients of `G` from below. -/
private theorem pow_mul_mem_valIdeal {G : Divisor X'} {U : X.Opens} {f y : Γ(X, U)}
    {b : Γ(X, X.basicOpen f)} {n m : ℕ} (hb : b ∈ valIdeal μ G (X.basicOpen f))
    (hy : y |_ X.basicOpen f = (f |_ X.basicOpen f) ^ n * b) (hm : ∀ P, -(m : ℤ) ≤ G.coeff P) :
    f ^ m * y ∈ valIdeal μ G U := by
  intro P hP
  rw [map_mul, map_mul, Valuation.map_mul, map_pow, map_pow, Valuation.map_pow]
  by_cases hf : μ P.genericPoint ∈ X.basicOpen f
  · refine (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) m)).trans ?_
    have h2 : X.presheaf.germ _ _ hP y = X.presheaf.germ _ _ hP f ^ n *
        X.presheaf.germ _ _ hf b := by
      rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← map_pow, ← map_mul]
      exact congrArg _ hy
    rw [h2, map_mul, Valuation.map_mul, map_pow, Valuation.map_pow]
    exact (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) n)).trans (hb P hf)
  · have hle := le_exp_neg_one_of_lt_one (val_stalk_lt_one μ P (X.presheaf.germ _ _ hP f)
      (by rwa [← X.mem_basicOpen f _ hP]))
    refine (mul_le_of_le_one_right' (val_stalk_le_one μ P _)).trans
      ((pow_le_pow_left₀ zero_le' hle m).trans ?_)
    rw [← WithZero.exp_nsmul, WithZero.exp_le_exp]
    simpa using hm P

/-- The ideal sheaf of `X` whose ideal on an affine open `U` is `valIdeal μ G U`. -/
private def valIdealSheaf (G : Divisor X') : X.IdealSheafData where
  ideal U := valIdeal μ G U
  map_ideal_basicOpen U f := by
    change _ = valIdeal μ G (X.basicOpen f)
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha P hP
      change P.valuationOver μ (algebraMap _ X.functionField
        (X.presheaf.germ _ _ hP ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a))) ≤ _
      rw [TopCat.Presheaf.germ_res_apply]
      exact ha P (X.basicOpen_le f hP)
    · intro b hb
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen X U U.2 f b
      obtain ⟨m, hm⟩ := exists_neg_le_coeff G
      have hin := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (pow_mul_mem_valIdeal μ hb hy hm)
      rw [map_mul, map_pow] at hin
      change _ * (y |_ X.basicOpen f) ∈ _ at hin
      rw [hy, ← mul_assoc] at hin
      have hu := X.toRingedSpace.isUnit_res_basicOpen f
      exact (Ideal.unit_mul_mem_iff_mem _ ((hu.pow m).mul (hu.pow n))).mp hin

/-- **A push-forward with values in `𝒪_X` is an ideal sheaf.** If the sections of
`μ_*𝒪_{X'}(G)` over every non-empty open are regular functions, then on every non-empty affine
open they are the ideal of an ideal sheaf of `X`. -/
private theorem exists_idealSheafData_of_subset_range [IsLocallyNoetherian X] [IsNormal X]
    (G : Divisor X')
    (hsub : ∀ (U : X.Opens) [Nonempty U],
      MMP.Intersection.multiplierIdealSections μ G U ⊆ Set.range (X.germToFunctionField U)) :
    ∃ I : X.IdealSheafData, ∀ (U : X.affineOpens) [Nonempty (U : X.Opens)],
      MMP.Intersection.multiplierIdealSections μ G U =
        X.germToFunctionField (U : X.Opens) '' (I.ideal U : Set Γ(X, U)) := by
  refine ⟨valIdealSheaf μ G, fun U _ => ?_⟩
  have hne : μ ⁻¹ᵁ (U : X.Opens) ≠ ⊥ := by
    obtain ⟨u⟩ := ‹Nonempty (U : X.Opens)›
    obtain ⟨_, hx', x', rfl⟩ :=
      μ.denseRange.inter_open_nonempty _ (U : X.Opens).isOpen ⟨u.1, u.2⟩
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x', hx'⟩
  ext g
  constructor
  · intro hg
    obtain ⟨a, rfl⟩ := hsub U hg
    refine ⟨a, fun P hP => ?_, rfl⟩
    have := hg.2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P
      (V := μ ⁻¹ᵁ (U : X.Opens)) hP)
    rwa [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hP] at this
  · rintro ⟨a, ha, rfl⟩
    refine ⟨fun h => absurd h hne, fun P hP => ?_⟩
    have hη : μ P.genericPoint ∈ (U : X.Opens) :=
      MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hη]
    exact ha P hη

end Ideal

/-! ### The adjoint ideal by orders along all divisors over `X` -/

section Main

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} c_P P = B` when `B` has coefficient `c_P` along `P ∈ s` and vanishes off `s`. -/
private theorem sum_smul_single_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  refine Finsupp.ext fun Q => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul]
  have h1 : ∀ P, (Divisor.toRDivisor (Finsupp.single P (1 : ℤ) : Divisor X)) Q =
      if P = Q then 1 else 0 := by
    intro P
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply]
    split_ifs <;> simp
  simp only [h1, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.sum_ite_eq]
  rw [← DivisorWithCoeffs.coeff_apply B]
  by_cases hQ : Q ∈ s
  · rw [if_pos hQ, hin Q hQ]
  · rw [if_neg hQ, hout Q hQ]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} P + ∑_{P ∈ s} c_P P = B` when `B` has coefficient `1 + c_P` along `P ∈ s` and
vanishes off `s`. -/
private theorem toRDivisor_add_sum_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = 1 + c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) +
      ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  have hT : Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) =
      ∑ P ∈ s, (1 : ℝ) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
    refine (sum_smul_single_eq s (fun _ => 1) _ (fun Q hQ => ?_) (fun Q hQ => ?_)).symm
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_pos hQ]; simp
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_neg hQ]; simp
  rw [hT, ← Finset.sum_add_distrib]
  simp_rw [← add_smul]
  exact sum_smul_single_eq s (fun P => 1 + c P) B hin hout

/-- The sections over `U` of `𝒥_{Δ,D}` described valuatively: the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` whose
centre lies in `U`. -/
private def adjointSet (Δ : Divisor X) (D : QDivisor X) (U : X.Opens) : Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (F : DivisorOver k sX) (a₀ a : ℝ),
    F.f F.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F a₀ →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a →
    F.valuation g ≤ WithZero.exp (⌈a⌉ - 1 + if a₀ = 0 then 1 else 0)}

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An snc closed subset of a smooth scheme is the union of the components of an snc divisor. -/
private theorem exists_finset_of_isSNCSubset [LocallyOfFinitePresentation sX]
    (hsm : IsSmoothScheme sX) {S : Closeds X} (h : IsSNCSubset sX S) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor X), (⋃ E ∈ s, E.support) = (S : Set X) ∧
      DivisorWithCoeffs.IsSNC sX (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
  rcases h with h | h
  · refine ⟨∅, by simp [h], ?_⟩
    simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme (R := ℤ) sX hsm
  · exact h

/-- A prime divisor of a proper birational model which is not exceptional and whose centre lies
off `Supp B` has log discrepancy `1` with respect to `B`. -/
private theorem isLogDiscrepancy_one_of_notMem [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    (B : QDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (hexc : P.genericPoint ∉ (exceptionalSet μ : Set Y))
    (hB : μ P.genericPoint ∉ (DivisorWithCoeffs.supp (QDivisor.toRDivisor B) : Set X)) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K B :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ¬ FP.IsExceptional := fun hexc' =>
    hexc (MMP.Positivity.support_subset_exceptionalSet P hexc' hPmem)
  obtain ⟨Q, hQc, hQd⟩ := MMP.Mori.DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPW FP hne
  have hηQ : μ P.genericPoint = Q.genericPoint := by
    have e1 := FP.center_eq_closure_genericPoint
    rw [hQc, AlgebraicGeometry.PrimeDivisor.support_eq_closure Q] at e1
    exact (inseparable_iff_closure_eq.mpr e1.symm).eq
  have hQmem : Q.genericPoint ∈ Q.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hQ0 : B.coeff Q = 0 := by
    by_contra hne'
    apply hB
    rw [hηQ]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero]) hQmem
  rw [hQ0, neg_zero] at hQd
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hQd hμp
  convert hl using 1
  simp

/-- **Log discrepancy one off the snc divisor of a log resolution.** Let `μ : Y → X` be a proper
birational model and `s` the components of `Exc(μ) ∪ μ⁻¹ Supp(Δ + D)`, for `Δ` reduced and `D`
effective. A prime divisor `P ∉ s` of `Y` has log discrepancy `1` for `(X, Δ)` and `(X, Δ + D)`. -/
private theorem isLogDiscrepancy_one_of_notMem_finset [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : (⋃ E ∈ s, E.support) = ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) : Set Y))
    {P : MMP.Mori.PrimeDivisor Y} (hPs : P ∉ s) :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ 1 ∧
      MMP.Intersection.IsLogDiscrepancy sX n
        (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
    intro hz
    obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
    exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
  rw [hs, Closeds.coe_sup, Set.mem_union, not_or] at hnot
  obtain ⟨hexc, hsupp⟩ := hnot
  have hsuppΔ : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
    intro hmem
    apply hsupp
    obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have : (0 : ℝ) ≤ ((D.coeff Γ' : ℚ) : ℝ) := by exact_mod_cast hD0 Γ'
    rcases hΔ Γ' with h | h
    · rw [h] at hΓ'; simp at hΓ'
    · rw [h]; push_cast; linarith
  have h0 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsuppΔ
  have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsupp
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
  exact ⟨h0, h1⟩

/-- **The adjoint ideal is computed by orders along all divisors over `X`.** The sections of
`μ_*𝒪_Y(E - ⌊μ^*D⌋)` are the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` centred
in the open set. -/
private theorem eq_adjointSet [IsAlgClosed k] [CharZero k] {Δ : Divisor X} {D : QDivisor X}
    {Y : Scheme.{0}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J) : J = adjointSet sX Δ D := by
  classical
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, _, _, _, _, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  set G := E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hGdef
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    obtain ⟨D₀', hD₀'eq, hD₀'pb⟩ := hF m hm D₀ hD₀ hD₀c
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'pb
    have hFP : ((D₀'.coeff P : ℤ) : ℝ) / m = ((F.coeff P : ℚ) : ℝ) := by
      have h1 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        Int.cast_natCast] at h1
      have h' : ((D₀'.coeff P : ℤ) : ℝ) = m * ((F.coeff P : ℚ) : ℝ) := by exact_mod_cast h1
      rw [h']
      field_simp
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    rw [hFP] at hα
    refine ⟨a₀, (a₀ : ℝ) - F.coeff P, ha₀r, hα, ?_, ?_, ?_⟩
    · have hΓP : Γ.coeff P = if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0 := by
        rcases hΓ.1 P with h0 | h1
        · rw [h0]
          split_ifs with ha0
          · exfalso
            have : Γ.coeff P = 1 := (hΓ.2 P).2 ⟨n, by rw [ha0] at ha₀r; exact ha₀r⟩
            omega
          · rfl
        · rw [h1]
          split_ifs with ha0
          · rfl
          · exfalso
            obtain ⟨n'', h''⟩ := (hΓ.2 P).1 h1
            exact ha0 (MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h'')
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊((F.coeff P : ℚ) : ℝ)⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - F.coeff P⌉ := by
        have e : ((F.coeff P : ℚ) : ℝ) = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        QDivisor.coeff_toRDivisor, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hlog.isProper hs hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  funext U
  ext g
  constructor
  · /- `J ⊆ adjointSet`: the comparison along a model of `F` on `Y`. -/
    rintro ⟨hg0, hgP⟩
    refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a₀ a hx ha₀ ha => ?_⟩
    rcases eq_or_ne g 0 with rfl | hgne
    · simp
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha₀
    obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hlog.isProper hμ hY F₀
    set y := F'.f F'.E.genericPoint with hy
    have hyU : y ∈ μ ⁻¹ᵁ U := by
      show μ y ∈ U
      rw [hcen]; exact hx
    have hnY : topologicalKrullDim Y = n :=
      (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
        hn
    obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
    obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
    have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
      ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
    have hP1 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ + D) :=
      ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
    obtain ⟨B₀, hB₀⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
    obtain ⟨B₁, hB₁⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP1 hK μ hY hμ).1.exists
    have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
      (Or.inl hB₀)).2 F' F₀ hval
    have hcr1 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP1 μ hY hμ hK hKY
      (Or.inl hB₁)).2 F' F₀ hval
    obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
    obtain ⟨c₁, hc₁⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP1 hK F₀
    have ha₀c : a₀ = 1 + c₀ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
      hc₀ (by rwa [QDivisor.toRDivisor_toQDivisor])
    have hac : a = 1 + c₁ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
      hc₁ (by rwa [map_add, QDivisor.toRDivisor_toQDivisor])
    have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
      ((hcr0 c₀).2 hc₀) hF'p
    have hY1 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
      ((hcr1 c₁).2 hc₁) hF'p
    -- the reduced snc divisor `T = ∑_{P ∈ s} P` on `Y` and `t = a(F', Y, T) ∈ ℕ`
    have hTred : MMP.Intersection.IsReducedEffective (MMP.Intersection.reducedDivisorOf s) :=
      fun P => by rw [MMP.Intersection.coeff_reducedDivisorOf]; split_ifs <;> simp
    obtain ⟨tr, htr⟩ := exists_isLogDiscrepancy hY hsmY hnY
      (Divisor.toQDivisor (MMP.Intersection.reducedDivisorOf s)) F' hF'p
    rw [QDivisor.toRDivisor_toQDivisor] at htr
    obtain ⟨t, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC (μ ≫ sX) hY.1
      hsmY hTred hsnc htr
    choose a₀P αP ha₀P hαP hGP hzP houtP using hcoef n hn
    have := F'.isLocallyNoetherian
    have := F'.isNormal
    have := F'.isIntegral
    have := F'.isBirationalMorphism.isDominant
    have : CompactSpace F'.Y :=
      (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
    have hcart : ∀ P : MMP.Mori.PrimeDivisor Y,
        Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor Y) := fun P =>
      MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    choose P' hP' using fun P : MMP.Mori.PrimeDivisor Y => (hcart P).exists_isPullback
      (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
        (Finsupp.single P (1 : ℤ) : Divisor Y))
    set e : MMP.Mori.PrimeDivisor Y → ℤ := fun P => (P' P).coeff F'.E with hedef
    have he : ∀ P ∈ s, ∀ (Q' : Divisor F'.Y) (hB : ∀ Z : irreducibleComponents F'.Y,
          F'.f (componentGenericPoint F'.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor Y)),
        Divisor.IsPullback F'.f (Finsupp.single P 1 : Divisor Y) hB Q' → Q'.coeff F'.E = e P := by
      intro P _ Q' hB hQ'
      rw [hQ'.eq (hcart P) (hP' P)]
    have he0 : ∀ P ∈ s, 0 ≤ e P := fun P _ =>
      coeff_isPullback_nonneg (F := F') (hcart P) (fun Γ _ => by
        rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> simp) _ _ (hP' P)
    -- the crepant boundaries in terms of the coefficients
    have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
      intro Q
      have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
        hlog.isProper
      rw [QDivisor.toRDivisor_toQDivisor] at hl
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
      push_cast at this
      linarith
    have hB₁Q : ∀ Q, ((B₁.coeff Q : ℚ) : ℝ) = 1 - αP Q := by
      intro Q
      have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₁ Q)
        hlog.isProper
      rw [map_add, QDivisor.toRDivisor_toQDivisor] at hl
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hαP Q) hl
      push_cast at this
      linarith
    have hb0 := toRDivisor_add_sum_eq s (fun P => -(a₀P P : ℝ)) (QDivisor.toRDivisor B₀)
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp)
    have hb1 := toRDivisor_add_sum_eq s (fun P => -αP P) (QDivisor.toRDivisor B₁)
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q, (houtP Q hQ).2]; simp)
    have hsum0 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(a₀P P : ℝ)) e he
    have hsum1 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -αP P) e he
    rw [hb0] at hsum0
    rw [hb1] at hsum1
    have hA₀ : a₀ = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0 hsum0
      rw [ha₀c, this]
      simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
    have hA : a = t + ∑ P ∈ s, αP P * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY1 hsum1
      rw [hac, this]
      simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
    -- `v_F(g) ≤ exp (∑ G_P e_P)`
    have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
    obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
    have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
      (fun Γ hΓ => by
        rw [DivisorWithCoeffs.coeff_neg, neg_neg]
        exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
    have hl1 := isLogDiscrepancy_add_smul htr hGcart (1 : ℝ) G' hBG hG'
    have hl2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(G.coeff P : ℝ)) e he
    have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
      intro Q hQ
      rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
      simp
    have hbG : (1 : ℝ) • Divisor.toRDivisor (-G) =
        ∑ P ∈ s, (-(G.coeff P : ℝ)) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor Y) := by
      refine (sum_smul_single_eq s _ _ (fun Q _ => ?_) (fun Q hQ => ?_)).symm
      · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg]
        simp
      · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg,
          hG0 Q hQ]
        simp
    rw [hbG] at hl1
    have hGe : (G'.coeff F'.E : ℝ) = -∑ P ∈ s, (G.coeff P : ℝ) * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hl1 hl2
      simp only [one_mul, neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add] at this
      linarith
    have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by exact_mod_cast hGe
    have hval' : F₀.valuation g = F'.valuation (functionFieldMap μ g) := by
      rw [hval]; rfl
    rw [hval']
    refine hR.trans ?_
    rw [hGe', neg_neg, WithZero.exp_le_exp]
    exact sum_mul_le_ceil s a₀P αP e (fun P => G.coeff P) t he0 (fun P _ => hzP P)
      (fun P _ => hGP P) hA₀ hA
  · /- `adjointSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ?_, fun P hP => ?_⟩
    · by_contra hne
      obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
      obtain ⟨_, hx', x', rfl⟩ := μ.denseRange.inter_open_nonempty _ U.isOpen ⟨u, hu⟩
      have hx'' : x' ∈ μ ⁻¹ᵁ U := hx'
      rw [hU] at hx''
      exact hx''
    · have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
      obtain ⟨n, a, hla, -⟩ := hE P
      have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
      obtain ⟨a₀, α, ha₀, hα, hGP, -, -⟩ := hcoef n hn P
      have := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ α hxU ha₀ hα
      rw [hGP]
      exact this

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A variety has finite dimension. -/
private theorem exists_topologicalKrullDim_eq [IsIntegral X] (hX : MMP.Mori.IsVariety k sX) :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  refine ⟨(Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction sX
    (genericPoint X)).toNat, ?_⟩
  rw [← Stacks.Chow.topologicalKrullDim_closure_singleton_eq k sX (genericPoint X)]
  have h : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
  exact (IsHomeomorph.topologicalKrullDim_eq _
    ((Homeomorph.setCongr h).trans (Homeomorph.Set.univ X)).isHomeomorph).symm

/-- The log discrepancy of a prime divisor `Q` of the smooth `X` is `1 - coeff_Q B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (Q : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hX Q) (1 - B.coeff Q) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
    (DivisorOver.ofPrimeDivisor k hX Q)
  have hcQ := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc
  have h := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 X) from inferInstance)
  rw [hcQ] at h
  convert h using 1
  push_cast
  ring

/-- The valuation of a prime divisor of `X`, regarded as a divisor over `X`. -/
private theorem valuation_ofPrimeDivisor (hX : IsNormalVariety k sX)
    (Q : MMP.Mori.PrimeDivisor X) (g : X.functionField) :
    (DivisorOver.ofPrimeDivisor k hX Q).valuation g = Q.divisorialValuation g := by
  change Q.divisorialValuation (functionFieldMap (𝟙 X) g) = _
  rw [MMP.Mori.functionFieldMap_id_apply]

/-- The sections of `𝒪_X(-A)` have `v_F ≤ exp (-coeff_F(A'))` along every divisor centred in the
open set, for the pull-back `A'` of the Cartier divisor `A`. -/
private theorem valuation_le_of_mem_multiplierIdealSections {F : DivisorOver k sX}
    {A : Divisor X} (hA : A.IsCartier) {V : X.Opens} (hx : F.f F.E.genericPoint ∈ V)
    {g : X.functionField} (hg : g ∈ MMP.Intersection.multiplierIdealSections (𝟙 X) (-A) V) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (A' : Divisor F.Y) (hAs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ A.supp), A.IsPullback F.f hAs A' →
      F.valuation g ≤ WithZero.exp (-A'.coeff F.E) := by
  intro A' hAs hA'
  refine valuation_le_exp_of_isPullback hA (fun Γ hΓ => ?_) A' hAs hA'
  have h := hg.2 Γ ⟨_, hΓ, hx⟩
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
    DivisorWithCoeffs.coeff_neg] at h
  exact h

/-- **The resolution choices exist**: a projective log resolution of `Δ + D`, the reduced sum
`Γ` of the zero places of `(X, Δ)` on it, and the divisor `E` with `K_Y + Γ = μ^*(K_X + Δ) + E`. -/
private theorem exists_isReducedAdjointIdealOn [IsAlgClosed k] [CharZero k] (Δ : Divisor X)
    (D : QDivisor X) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hΔ : IsReducedSNC sX Δ) (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ X) (J : X.Opens → Set X.functionField),
      IsReducedAdjointIdealOn sX Δ D μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨Y, μ, h1, h2⟩ := MMP.Mori.exists_isLogResolution_isProjectiveMorphism sX hX
    (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))
  have hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ := ⟨h1, h2⟩
  have hres := h1.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀]
    exact MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ D₀ Z
  have hF := QDivisor.isPullback_pullback (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D) hD
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hres.isProper hs hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨Y, μ, _, hX, hsm, hΔ, hD0, hDns, hlog, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Γ, E, _, ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, hF, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

/-- The adjoint ideal computed on a given projective log resolution of `Δ + D`. -/
private theorem exists_isReducedAdjointIdealOn_of_isLogResolution [IsAlgClosed k] [CharZero k]
    (Δ : Divisor X) (D : QDivisor X) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hΔ : IsReducedSNC sX Δ) (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    {Y : Scheme.{0}} (μ : Y ⟶ X) (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ) :
    ∃ J : X.Opens → Set X.functionField, IsReducedAdjointIdealOn sX Δ D μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have h1 := hlog.toIsLogResolution
  have hres := h1.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀]
    exact MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ D₀ Z
  have hF := QDivisor.isPullback_pullback (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D) hD
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hres.isProper hs hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨_, hX, hsm, hΔ, hD0, hDns, hlog, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Γ, E, _, ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, hF, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

end Main

/-! ### Twisting a push-forward by a Cartier divisor -/

section Twist

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- The preimage of a nonempty open under a dominant morphism is nonempty. -/
private theorem preimage_eq_bot_iff (μ : Y ⟶ X) [IsDominant μ] (U : X.Opens) :
    μ ⁻¹ᵁ U = ⊥ ↔ U = ⊥ := by
  refine ⟨fun h => by_contra fun hU => ?_, fun h => by simp [h]⟩
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).1 hU
  obtain ⟨_, hx', ⟨x', rfl⟩⟩ := μ.denseRange.inter_open_nonempty U U.isOpen ⟨x, hx⟩
  have hmem : x' ∈ μ ⁻¹ᵁ U := hx'
  rw [h] at hmem
  exact hmem

/-- **The projection formula on sections.** If `φ` is a local equation of the Cartier divisor
`M` on `V` and `μ^*M` its pull-back, then over an open `U ⊆ V` a rational function `g` is a
section of `μ_*𝒪_Y(G + μ^*M)` exactly when `φ g` is a section of `μ_*𝒪_Y(G)`. -/
private theorem mem_multiplierIdealSections_add_iff {μ : Y ⟶ X} [IsDominant μ] {M : Divisor X}
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) {V : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : M.IsLocalEquation V φ) (Z : irreducibleComponents X) (G : Divisor Y) {U : X.Opens}
    (hUV : U ≤ V) (g : X.functionField) :
    g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) U ↔
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) * g ∈
        MMP.Intersection.multiplierIdealSections μ G U := by
  set c := MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) with hc
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hval : ∀ P : MMP.Mori.PrimeDivisor Y, (P.support ∩ μ ⁻¹ᵁ U).Nonempty →
      P.valuationOver μ c = WithZero.exp (-Mμ.coeff P) := by
    intro P hP
    have hU : μ P.genericPoint ∈ V :=
      hUV (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP)
    rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hU Z,
      PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr hc0)]
  constructor
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => by rw [h0 hU, mul_zero], fun P hP => ?_⟩
    rw [map_mul, hval P hP]
    have := hg P hP
    rw [DivisorWithCoeffs.coeff_add] at this
    calc WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g ≤
          WithZero.exp (-Mμ.coeff P) * WithZero.exp (G.coeff P + Mμ.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P) := by rw [← WithZero.exp_add]; congr 1; ring
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => (mul_eq_zero.mp (h0 hU)).resolve_left hc0, fun P hP => ?_⟩
    have := hg P hP
    rw [map_mul, hval P hP] at this
    rw [DivisorWithCoeffs.coeff_add]
    calc P.valuationOver μ g = WithZero.exp (Mμ.coeff P) *
          (WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g) := by
          rw [← mul_assoc, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero, one_mul]
      _ ≤ WithZero.exp (Mμ.coeff P) * WithZero.exp (G.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P + Mμ.coeff P) := by rw [← WithZero.exp_add, add_comm]

/-- Sections of `μ_*𝒪_Y(G)` restrict to smaller nonempty opens. -/
private theorem multiplierIdealSections_mono (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) {g : X.functionField}
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ G U) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G W :=
  ⟨fun h => absurd ((preimage_eq_bot_iff μ W).1 h) hW,
    fun P hP => hg.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hWU hy))⟩

/-- Membership in `μ_*𝒪_Y(G)(U)` is local on `U`: it suffices on a neighbourhood `W x ⊆ U` of
every point `x ∈ U`. -/
private theorem mem_multiplierIdealSections_of_local (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U : X.Opens} (W : X → X.Opens) (hW : ∀ x ∈ U, x ∈ W x ∧ W x ≤ U) {g : X.functionField}
    (h0 : U = ⊥ → g = 0)
    (hg : ∀ x ∈ U, g ∈ MMP.Intersection.multiplierIdealSections μ G (W x)) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  refine ⟨fun h => h0 ((preimage_eq_bot_iff μ U).1 h), fun P hP => ?_⟩
  have hx := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
  refine (hg _ hx).2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P ?_)
  exact (hW _ hx).1

/-- **Twisting is determined by the untwisted push-forward.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections, so do `μ_*𝒪_Y(G + μ^*M)` and
`μ'_*𝒪_{Y'}(G' + μ'^*M)`, for a Cartier divisor `M` of `X`. -/
private theorem multiplierIdealSections_add_pullback_congr {Y' : Scheme.{0}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {μ : Y ⟶ X} {μ' : Y' ⟶ X} [IsDominant μ]
    [IsDominant μ'] {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {hM' : ∀ Z : irreducibleComponents Y', μ' (componentGenericPoint Y' Z) ∉ M.supp}
    {Mμ : Divisor Y} {Mμ' : Divisor Y'} (h : M.IsPullback μ hM Mμ)
    (h' : M.IsPullback μ' hM' Mμ') {G : Divisor Y} {G' : Divisor Y'}
    (hG : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ' (G' + Mμ') := by
  choose V hxV φ hφ using hMc
  let Z : irreducibleComponents X := pointComponent (genericPoint X)
  have key : ∀ {Y₁ : Scheme.{0}} [IsIntegral Y₁] [IsLocallyNoetherian Y₁] [IsNormal Y₁]
      (μ₁ : Y₁ ⟶ X) [IsDominant μ₁]
      {hM₁ : ∀ Z : irreducibleComponents Y₁, μ₁ (componentGenericPoint Y₁ Z) ∉ M.supp}
      {M₁ : Divisor Y₁} (h₁ : M.IsPullback μ₁ hM₁ M₁) (G₁ : Divisor Y₁) (U : X.Opens)
      (g : X.functionField),
      g ∈ MMP.Intersection.multiplierIdealSections μ₁ (G₁ + M₁) U ↔
        (U = ⊥ → g = 0) ∧ ∀ x ∈ U,
          MMP.Threefold.Mori.Helpers.evalFF Z (φ x : RationalFunctions X) * g ∈
            MMP.Intersection.multiplierIdealSections μ₁ G₁ (U ⊓ V x) := by
    intro Y₁ _ _ _ μ₁ _ hM₁ M₁ h₁ G₁ U g
    have hne : ∀ x ∈ U, U ⊓ V x ≠ ⊥ := fun x hx hb => by
      have : x ∈ U ⊓ V x := ⟨hx, hxV x⟩
      rw [hb] at this; exact this
    constructor
    · intro hg
      refine ⟨fun hU => hg.1 ((preimage_eq_bot_iff μ₁ U).2 hU), fun x hx => ?_⟩
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).1
        (multiplierIdealSections_mono μ₁ _ inf_le_left (hne x hx) hg)
    · rintro ⟨h0, hg⟩
      refine mem_multiplierIdealSections_of_local μ₁ _ (fun x => U ⊓ V x)
        (fun x hx => ⟨⟨hx, hxV x⟩, inf_le_left⟩) h0 fun x hx => ?_
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).2 (hg x hx)
  funext U
  ext g
  rw [key μ h G U g, key μ' h' G' U g, hG]

end Twist

/-! ### Push-forwards of divisorial sheaves as subsheaves of `K(X)` -/

section PushforwardIso

variable {X : Scheme.{0}} [IsIntegral X]

/-- On an irreducible scheme every irreducible component is the whole space. -/
private theorem eq_univ_of_irreducibleComponents' {Y : Scheme.{0}} [IrreducibleSpace Y]
    (Z : irreducibleComponents Y) : Z.1 = Set.univ :=
  Set.eq_univ_of_univ_subset (Z.2.2 (IrreducibleSpace.isIrreducible_univ Y) (Set.subset_univ _))

/-- The rational function of a section of `𝒦_Y` over `W`, read at a component meeting `W`. -/
private noncomputable def evFF {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Y.functionField :=
  (Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom (φ Z)

private theorem index_eq {Y : Scheme.{0}} [IrreducibleSpace Y] {W : Y.Opens}
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Z = Z' :=
  Subtype.ext (Subtype.ext ((eq_univ_of_irreducibleComponents' _).trans
    (eq_univ_of_irreducibleComponents' _).symm))

private theorem componentGenericPoint_eq_genericPoint' {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : componentGenericPoint Y Z = genericPoint Y := by
  have h1 := isGenericPoint_componentGenericPoint Y Z
  rw [eq_univ_of_irreducibleComponents' Z] at h1
  exact h1.eq (genericPoint_spec Y)

private theorem stalkSpecializes_genericPoint_injective {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) :
    Function.Injective (Y.presheaf.stalkSpecializes
      ((genericPoint_spec Y).specializes trivial :
        genericPoint Y ⤳ componentGenericPoint Y Z)).hom := by
  intro a b h
  have hsp : componentGenericPoint Y Z ⤳ genericPoint Y :=
    (Inseparable.of_eq (componentGenericPoint_eq_genericPoint' Z)).specializes
  have := congrArg (Y.presheaf.stalkSpecializes hsp).hom h
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_comp_apply,
    TopCat.Presheaf.stalkSpecializes_refl] at this
  exact this

/-- The section of `𝒦_Y` over `W` with a given rational function. -/
private noncomputable def ofFF {Y : Scheme.{0}} [IsIntegral Y] (W : Y.Opens)
    (g : Y.functionField) : ToType ((rationalFunctionsPresheaf Y).obj (op W)) :=
  fun Z => (Y.presheaf.stalkSpecializes
    (Inseparable.of_eq (componentGenericPoint_eq_genericPoint' Z.1)).specializes).hom g

private theorem evFF_ofFF {Y : Scheme.{0}} [IsIntegral Y] (W : Y.Opens) (g : Y.functionField)
    (Z) : evFF (ofFF W g) Z = g := by
  rw [evFF, ofFF, TopCat.Presheaf.stalkSpecializes_comp_apply,
    TopCat.Presheaf.stalkSpecializes_refl]
  rfl

private theorem ofFF_evFF {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    ofFF W (evFF φ Z) = φ := by
  funext Z'
  obtain rfl := index_eq Z Z'
  apply stalkSpecializes_genericPoint_injective Z.1
  change evFF (ofFF W (evFF φ Z)) Z = evFF φ Z
  rw [evFF_ofFF]

/-- `OrdGE` in terms of the divisorial valuation of the rational function. -/
private theorem ordGE_iff_divisorialValuation_le {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y) (n : ℤ)
    (s : Y.presheaf.stalk (componentGenericPoint Y E.component)) :
    E.OrdGE n s ↔ E.divisorialValuation
      ((Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s) ≤
        WithZero.exp (-n) := by
  have hv : E.valuation s = (E.divisorialValuation
      ((Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s))⁻¹ := by
    rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
    rfl
  rw [MMP.Mori.PrimeDivisor.OrdGE, hv]
  set x := (Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s
  have h0 : s = 0 ↔ x = 0 :=
    ⟨fun h => by simp [x, h], fun h => (injective_iff_map_eq_zero' _).1
      (stalkSpecializes_genericPoint_injective E.component) s |>.1 h⟩
  rw [h0]
  rcases eq_or_ne x 0 with hx | hx
  · simp [hx]
  · have hvx : E.divisorialValuation x ≠ 0 := (map_ne_zero _).2 hx
    simp only [hx, false_or]
    rw [← WithZero.exp_log hvx, ← WithZero.exp_neg, WithZero.exp_le_exp, WithZero.exp_le_exp]
    omega

/-- A section of `𝒦_Y` over `μ⁻¹U` is a section of `𝒪_Y(G)` exactly when its rational function
lies in `μ_*𝒪_Y(G)(U)`. -/
private theorem mem_divisorialSubmodule_iff_mem_multiplierIdealSections {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ]
    (G : Divisor Y) (U : X.Opens) (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U))))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U})
    (g : X.functionField) (hg : functionFieldMap μ g = evFF σ Z) :
    σ ∈ G.divisorialSubmodule (μ ⁻¹ᵁ U) ↔
      g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  have hne : μ ⁻¹ᵁ U ≠ ⊥ := by
    intro h
    obtain ⟨Z₁, hZ₁⟩ := Z
    rw [h] at hZ₁
    exact hZ₁
  rw [Divisor.mem_divisorialSubmodule]
  constructor
  · intro h
    refine ⟨fun h' => absurd h' hne, fun P hP => ?_⟩
    have := (ordGE_iff_divisorialValuation_le P _ _).1 (h P hP)
    rw [neg_neg] at this
    rw [PrimeDivisor.valuationOver_apply, hg]
    obtain rfl : (⟨P.component, P.componentGenericPoint_mem_of_nonempty hP⟩ :
      {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) = Z := index_eq _ _
    exact this
  · rintro ⟨-, h⟩ P hP
    rw [ordGE_iff_divisorialValuation_le, neg_neg]
    have := h P hP
    rw [PrimeDivisor.valuationOver_apply, hg] at this
    obtain rfl : (⟨P.component, P.componentGenericPoint_mem_of_nonempty hP⟩ :
      {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) = Z := index_eq _ _
    exact this

private theorem germ_stalkCongr_hom_apply' {X : TopCat.{0}} (F : X.Presheaf CommRingCat.{0})
    {U : Opens X} {x y : X} (h : Inseparable x y) (hx : x ∈ U) (hy : y ∈ U) (a : F.obj (op U)) :
    (F.stalkCongr h).hom (F.germ U x hx a) = F.germ U y hy a := by
  simp only [TopCat.Presheaf.stalkCongr_hom]
  exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _

private theorem functionFieldMap_germ' {Y Z : Scheme.{0}} [IsIntegral Y] [IsIntegral Z]
    (g : Z ⟶ Y) [IsDominant g] (U : Y.Opens) (hY : genericPoint Y ∈ U)
    (hZ : genericPoint Z ∈ g ⁻¹ᵁ U) (a : Γ(Y, U)) :
    functionFieldMap g (Y.presheaf.germ U (genericPoint Y) hY a) =
      Z.presheaf.germ (g ⁻¹ᵁ U) (genericPoint Z) hZ (g.app U a) := by
  rw [functionFieldMap, CommRingCat.hom_comp, RingHom.comp_apply]
  rw [← Scheme.Hom.germ_stalkMap_apply g U _ hZ]
  congr 1
  exact germ_stalkCongr_hom_apply' _ _ _ _ _

/-- The index of the unique component of an integral scheme, in an open containing the generic
point. -/
private noncomputable def topIndex (Y : Scheme.{0}) [IsIntegral Y] {W : Y.Opens}
    (h : genericPoint Y ∈ W) : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W} :=
  ⟨⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩, by
    rw [componentGenericPoint_eq_genericPoint']; exact h⟩

private theorem genericPoint_mem_of_index {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    genericPoint Y ∈ W := by
  have := Z.2; rwa [componentGenericPoint_eq_genericPoint'] at this

/-- The rational function of `r • σ`. -/
private theorem evFF_smul {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens} (r : Γ(Y, W))
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF (r • φ) Z = Y.presheaf.germ W (genericPoint Y) (genericPoint_mem_of_index Z) r *
      evFF φ Z := by
  rw [evFF, rationalFunctions_smul_apply, map_mul]
  congr 1
  exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _

private theorem evFF_add {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ ψ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF (φ + ψ) Z = evFF φ Z + evFF ψ Z :=
  map_add _ _ _

private theorem evFF_map {Y : Scheme.{0}} [IsIntegral Y] {W W' : Y.Opensᵒᵖ} (j : W ⟶ W')
    (φ : ToType ((rationalFunctionsPresheaf Y).obj W))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W'.unop}) :
    evFF (W := W'.unop) ((rationalFunctionsPresheaf Y).map j φ) Z =
      evFF (W := W.unop) φ ⟨Z.1, j.unop.le Z.2⟩ := rfl

variable {Y Y' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']

/-- The section of `𝒦_{Y'}` over `μ'⁻¹U` with the same rational function (through
`K(Y) ≅ K(X) ≅ K(Y')`) as a section of `𝒦_Y` over `μ⁻¹U`. -/
private noncomputable def transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (U : X.Opens)
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U)))) :
    ToType ((rationalFunctionsPresheaf Y').obj (op (μ' ⁻¹ᵁ U))) :=
  fun Z' => ofFF (μ' ⁻¹ᵁ U) (functionFieldMap μ' (e.symm (evFF σ (topIndex Y (by
    have h := genericPoint_mem_of_index Z'
    change μ' (genericPoint Y') ∈ U at h
    rw [map_genericPoint_of_isDominant] at h
    change μ (genericPoint Y) ∈ U
    rw [map_genericPoint_of_isDominant]; exact h))))) Z'

private theorem evFF_transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (U : X.Opens)
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U))))
    (Z' : {Z : irreducibleComponents Y' // componentGenericPoint Y' Z ∈ μ' ⁻¹ᵁ U})
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) :
    evFF (transferFF μ μ' e U σ) Z' = functionFieldMap μ' (e.symm (evFF σ Z)) := by
  rw [show transferFF μ μ' e U σ = ofFF (μ' ⁻¹ᵁ U) (functionFieldMap μ' (e.symm (evFF σ Z))) by
    funext Z''
    simp only [transferFF]
    rw [index_eq (topIndex Y _) Z]]
  exact evFF_ofFF _ _ _

private theorem eq_of_evFF_eq {W : Y.Opens} {φ ψ : ToType ((rationalFunctionsPresheaf Y).obj (op W))}
    (h : ∀ Z, evFF φ Z = evFF ψ Z) : φ = ψ := by
  funext Z
  rw [← ofFF_evFF φ Z, ← ofFF_evFF ψ Z, h Z]

private theorem genericPoint_mem_preimage_of_index (μ : Y ⟶ X) [IsDominant μ] {U : X.Opens}
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) :
    genericPoint X ∈ U := by
  have h := genericPoint_mem_of_index Z
  change μ (genericPoint Y) ∈ U at h
  rwa [map_genericPoint_of_isDominant] at h

private theorem genericPoint_mem_preimage (μ : Y ⟶ X) [IsDominant μ] {U : X.Opens}
    (h : genericPoint X ∈ U) : genericPoint Y ∈ μ ⁻¹ᵁ U := by
  change μ (genericPoint Y) ∈ U
  rwa [map_genericPoint_of_isDominant]

private theorem transferFF_mem (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) (U : X.Opens)
    (σ : G.divisorialSubmodule (μ ⁻¹ᵁ U)) :
    transferFF μ μ' e U σ.1 ∈ G'.divisorialSubmodule (μ' ⁻¹ᵁ U) := by
  by_cases hU : genericPoint X ∈ U
  · let Z := topIndex Y (genericPoint_mem_preimage μ hU)
    let Z' := topIndex Y' (genericPoint_mem_preimage μ' hU)
    rw [mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ' G' U _ Z'
      (e.symm (evFF σ.1 Z)) (evFF_transferFF μ μ' e U σ.1 Z' Z).symm]
    refine h U ((mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ G U _ Z
      (e.symm (evFF σ.1 Z)) ?_).1 σ.2)
    rw [← he, RingEquiv.apply_symm_apply]
  · intro E hE
    exact absurd (genericPoint_mem_preimage_of_index μ'
      ⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩) hU

/-- The components over `U` of `pushforwardHomOfLE`. -/
private noncomputable def pushforwardHomOfLEApp (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) (U : X.Opensᵒᵖ) :
    ((Scheme.Modules.pushforward μ).obj G.divisorialSheaf).val.obj U ⟶
      ((Scheme.Modules.pushforward μ').obj G'.divisorialSheaf).val.obj U :=
  ConcreteCategory.ofHom
    { toFun := fun σ => ⟨transferFF μ μ' e U.unop σ.1, transferFF_mem μ μ' e he G G' h U.unop σ⟩
      map_add' := fun a b => Subtype.ext (eq_of_evFF_eq fun Z' => by
        let Z := topIndex Y (genericPoint_mem_preimage μ (genericPoint_mem_preimage_of_index μ' Z'))
        change evFF (transferFF μ μ' e U.unop (a.1 + b.1)) Z' =
          evFF (transferFF μ μ' e U.unop a.1 + transferFF μ μ' e U.unop b.1) Z'
        rw [evFF_add, evFF_transferFF μ μ' e _ _ Z' Z, evFF_transferFF μ μ' e _ _ Z' Z,
          evFF_transferFF μ μ' e _ _ Z' Z, evFF_add, map_add, map_add])
      map_smul' := fun r a => Subtype.ext (eq_of_evFF_eq fun Z' => by
        have hX := genericPoint_mem_preimage_of_index μ' Z'
        let Z := topIndex Y (genericPoint_mem_preimage μ hX)
        change evFF (transferFF μ μ' e U.unop (μ.app U.unop r •
            (show ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U.unop))) from a.1))) Z' =
          evFF (μ'.app U.unop r • transferFF μ μ' e U.unop a.1) Z'
        rw [evFF_smul, evFF_transferFF μ μ' e _ _ Z' Z, evFF_transferFF μ μ' e _ _ Z' Z,
          evFF_smul,
          ← functionFieldMap_germ' μ U.unop hX (genericPoint_mem_preimage μ hX)
            (show Γ(X, U.unop) from r),
          ← functionFieldMap_germ' μ' U.unop hX (genericPoint_mem_preimage μ' hX)
            (show Γ(X, U.unop) from r),
          ← he, map_mul e.symm, RingEquiv.symm_apply_apply, map_mul]) }

/-- The morphism `μ_*𝒪_Y(G) ⟶ μ'_*𝒪_{Y'}(G')` which is the identity on rational functions, when
the sections of the first are among those of the second. -/
private noncomputable def pushforwardHomOfLE (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) :
    (Scheme.Modules.pushforward μ).obj G.divisorialSheaf ⟶
      (Scheme.Modules.pushforward μ').obj G'.divisorialSheaf :=
  ⟨{ app U := pushforwardHomOfLEApp μ μ' e he G G' h U
     naturality := fun {U V} i => by
      ext a
      refine Subtype.ext (eq_of_evFF_eq fun Z' => ?_)
      have hX := genericPoint_mem_preimage_of_index μ' Z'
      change evFF (transferFF μ μ' e V.unop
          ((rationalFunctionsPresheaf Y).map ((Opens.map μ.base).op.map i) a.1)) Z' =
        evFF ((rationalFunctionsPresheaf Y').map ((Opens.map μ'.base).op.map i)
          (transferFF μ μ' e U.unop a.1)) Z'
      rw [evFF_map, evFF_transferFF μ μ' e _ _ Z' (topIndex Y (genericPoint_mem_preimage μ hX)),
        evFF_transferFF μ μ' e _ _ _ (topIndex Y (genericPoint_mem_preimage μ (i.unop.le hX))),
        evFF_map]
      rfl }⟩

private theorem transferFF_transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (he : ∀ g, e g = functionFieldMap μ g)
    (e' : X.functionField ≃+* Y'.functionField) (he' : ∀ g, e' g = functionFieldMap μ' g)
    (U : X.Opens) (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U)))) :
    transferFF μ' μ e' U (transferFF μ μ' e U σ) = σ := by
  refine eq_of_evFF_eq fun Z => ?_
  have hX := genericPoint_mem_preimage_of_index μ Z
  let Z' := topIndex Y' (genericPoint_mem_preimage μ' hX)
  rw [evFF_transferFF μ' μ e' U _ Z Z', evFF_transferFF μ μ' e U σ Z' Z, ← he',
    RingEquiv.symm_apply_apply, ← he, RingEquiv.apply_symm_apply]

/-- **Push-forwards of divisorial sheaves are determined by their sections.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections in `K(X)` over every open, for birational `μ`, `μ'`, then
they are isomorphic `𝒪_X`-modules. -/
private theorem nonempty_iso_pushforward_of_multiplierIdealSections_eq (μ : Y ⟶ X)
    (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ'] (hμ : Function.Bijective (functionFieldMap μ))
    (hμ' : Function.Bijective (functionFieldMap μ')) (G : Divisor Y) (G' : Divisor Y')
    (h : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    Nonempty ((Scheme.Modules.pushforward μ).obj G.divisorialSheaf ≅
      (Scheme.Modules.pushforward μ').obj G'.divisorialSheaf) := by
  let e := RingEquiv.ofBijective (functionFieldMap μ) hμ
  let e' := RingEquiv.ofBijective (functionFieldMap μ') hμ'
  have he : ∀ g, e g = functionFieldMap μ g := fun _ => rfl
  have he' : ∀ g, e' g = functionFieldMap μ' g := fun _ => rfl
  refine ⟨{ hom := pushforwardHomOfLE μ μ' e he G G' (fun U => h ▸ subset_rfl)
            inv := pushforwardHomOfLE μ' μ e' he' G' G (fun U => h ▸ subset_rfl)
            hom_inv_id := ?_
            inv_hom_id := ?_ }⟩
  · refine Scheme.Modules.hom_ext _ _ fun U => ?_
    ext a
    exact Subtype.ext (transferFF_transferFF μ μ' e he e' he' U a.1)
  · refine Scheme.Modules.hom_ext _ _ fun U => ?_
    ext a
    exact Subtype.ext (transferFF_transferFF μ' μ e' he' e he U a.1)

end PushforwardIso

/-! ### The exact sequence on sections -/

section Restriction

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
private theorem toRDivisor_sub_single_add (Δ : Divisor X) (D : QDivisor X)
    (S : MMP.Mori.PrimeDivisor X) :
    Divisor.toRDivisor (Δ - Finsupp.single S 1) +
        QDivisor.toRDivisor (D + Divisor.toQDivisor (Finsupp.single S 1)) =
      Divisor.toRDivisor Δ + QDivisor.toRDivisor D := by
  rw [map_sub, map_add, QDivisor.toRDivisor_toQDivisor]; abel

/-- `𝒥_{Δ-S,D+S} ⊆ 𝒥_{Δ,D}`. -/
private theorem subset_of_sub_single [IsAlgClosed k] [CharZero k] {Δ : Divisor X}
    {D : QDivisor X} {S : MMP.Mori.PrimeDivisor X} {Y Y' : Scheme.{0}} {μ : Y ⟶ X}
    {μ' : Y' ⟶ X} {J J' : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J)
    (h' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J') (U : X.Opens) : J' U ⊆ J U := by
  intro g hg
  rw [eq_adjointSet sX h'] at hg
  rw [eq_adjointSet sX h]
  obtain ⟨hX, hsm, hΔ, hD0, hDns, -⟩ := h
  refine ⟨hg.1, fun n F a₀ a hx ha₀ ha => ?_⟩
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hC : Divisor.IsCartier (Finsupp.single S 1 : Divisor X) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
    (Finsupp.single S 1 : Divisor X)
  obtain ⟨C', hC'⟩ := hC.exists_isPullback hB
  have hc : 0 ≤ C'.coeff F.E := coeff_isPullback_nonneg hC (fun Γ _ => by
    classical
    rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
    split_ifs <;> norm_num) C' hB hC'
  have ha₀' := isLogDiscrepancy_add_smul ha₀ hC (-1) C' hB hC'
  have e1 : Divisor.toRDivisor Δ + (-1 : ℝ) • Divisor.toRDivisor (Finsupp.single S 1) =
      Divisor.toRDivisor (Δ - Finsupp.single S 1) := by
    rw [map_sub, neg_one_smul]; abel
  rw [e1] at ha₀'
  rw [← toRDivisor_sub_single_add Δ D S] at ha
  have hv := hg.2 n F _ _ hx ha₀' ha
  refine hv.trans (WithZero.exp_le_exp.mpr ?_)
  obtain ⟨p, hp⟩ :=
    MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀
  have hcR : (0 : ℝ) ≤ (C'.coeff F.E : ℝ) := by exact_mod_cast hc
  have himp : a₀ - -1 * (C'.coeff F.E : ℝ) = 0 → a₀ = 0 := by
    intro h0
    have : (0 : ℝ) ≤ p := Nat.cast_nonneg p
    linarith
  by_cases h1 : a₀ - -1 * (C'.coeff F.E : ℝ) = 0
  · rw [if_pos h1, if_pos (himp h1)]
  · rw [if_neg h1]
    split_ifs <;> omega

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A rational function of positive order along `S` restricts to zero on `S`. -/
private theorem isRestrictionAlong_zero_of_lt_one [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) {g : X.functionField}
    (hg : S.divisorialValuation g < 1) :
    haveI := S.integral
    IsRestrictionAlong S g 0 := by
  have := S.integral
  obtain ⟨r, rfl⟩ := (S.divisorialValuation_le_one_iff g).1 hg.le
  have hr := (S.divisorialValuation_algebraMap_lt_one_iff r).1 hg
  refine ⟨r, rfl, ?_⟩
  set φ := S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)
  have hl : IsLocalHom φ.hom := Scheme.Hom.instIsLocalHomCarrierStalkCommRingCatPresheafCoeContinuousMapCarrierCarrierHomTopCatBaseRingHomHomStalkMap _ _
  have hnu : ¬ IsUnit (φ.hom r) := fun hu =>
    (IsLocalRing.mem_maximalIdeal _).mp hr (hl.map_nonunit r hu)
  by_contra h
  exact hnu (isUnit_iff_ne_zero.mpr h)

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A rational function restricting to zero on `S` has positive order along `S`. -/
private theorem lt_one_of_isRestrictionAlong_zero [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) {g : X.functionField}
    (hg : haveI := S.integral; IsRestrictionAlong S g 0) : S.divisorialValuation g < 1 := by
  have := S.integral
  obtain ⟨a, rfl, ha⟩ := hg
  set φ := S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)
  have hl : IsLocalHom φ.hom := Scheme.Hom.instIsLocalHomCarrierStalkCommRingCatPresheafCoeContinuousMapCarrierCarrierHomTopCatBaseRingHomHomStalkMap _ _
  have h1 : ¬ IsUnit a := fun hu => by
    have := hu.map φ.hom
    erw [ha] at this
    exact not_isUnit_zero this
  exact (S.divisorialValuation_algebraMap_lt_one_iff (a : S.localRing)).2
    ((IsLocalRing.mem_maximalIdeal _).2 h1)

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- If the closed subscheme `S` meets `U`, its generic point lies in `U`. -/
private theorem genericPoint_mem_of_preimage_ne_bot [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) {U : X.Opens}
    (hU : S.idealSheaf.subschemeι ⁻¹ᵁ U ≠ ⊥) : S.genericPoint ∈ U := by
  obtain ⟨y, hy⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).1 hU
  have hyS : S.idealSheaf.subschemeι y ∈ S.idealSheaf.support := by
    rw [← SetLike.mem_coe, ← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨y, rfl⟩
  exact MMP.Intersection.genericPoint_mem_of_support_inter_nonempty S ⟨_, hyS, hy⟩

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- If a point of the support of `S` lies in `U`, the closed subscheme `S` meets `U`. -/
private theorem preimage_ne_bot_of_mem [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (S : MMP.Mori.PrimeDivisor X) {U : X.Opens} {x : X}
    (hxS : x ∈ S.support) (hxU : x ∈ U) : S.idealSheaf.subschemeι ⁻¹ᵁ U ≠ ⊥ := by
  have hx : x ∈ Set.range S.idealSheaf.subschemeι := by
    rw [Scheme.IdealSheafData.range_subschemeι]; exact hxS
  obtain ⟨y, rfl⟩ := hx
  intro h
  have : y ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U := hxU
  rw [h] at this
  exact this

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A unit of the local ring along a prime divisor has valuation one. -/
private theorem divisorialValuation_algebraMap_eq_one_of_isUnit [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (P : MMP.Mori.PrimeDivisor X) {w : P.localRing}
    (hw : IsUnit w) : P.divisorialValuation (algebraMap P.localRing X.functionField w) = 1 := by
  obtain ⟨u, rfl⟩ := hw
  have h1 : ∀ r : P.localRing, P.divisorialValuation (algebraMap _ X.functionField r) ≤ 1 :=
    fun r => (P.divisorialValuation_le_one_iff _).mpr ⟨r, rfl⟩
  have hprod : P.divisorialValuation (algebraMap _ X.functionField (u : P.localRing)) *
      P.divisorialValuation (algebraMap _ X.functionField (↑u⁻¹ : P.localRing)) = 1 := by
    rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
  refine le_antisymm (h1 _) ?_
  calc (1 : WithZero (Multiplicative ℤ)) = _ := hprod.symm
    _ ≤ _ * 1 := by gcongr; exact h1 _
    _ = _ := mul_one _

/-- **The kernel of restriction.** A section of `𝒥_{Δ,D}` lies in `𝒥_{Δ-S,D+S}` exactly when
it restricts to zero on `S` (or `U` does not meet `S`). -/
private theorem mem_iff_isRestrictionAlong_zero [IsAlgClosed k] [CharZero k] {Δ : Divisor X}
    {D : QDivisor X} {S : MMP.Mori.PrimeDivisor X} (hS : Δ.coeff S = 1) {Y Y' : Scheme.{0}}
    {μ : Y ⟶ X} {μ' : Y' ⟶ X} {J J' : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J)
    (h' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J') (U : X.Opens) (g : X.functionField)
    (hg : g ∈ J U) :
    haveI := S.integral
    g ∈ J' U ↔ (S.idealSheaf.subschemeι ⁻¹ᵁ U = ⊥ ∨ IsRestrictionAlong S g 0) := by
  classical
  have hrange := ((MMP.Fourfold.isReducedAdjointIdealOn_operations sX).2.1 Δ D μ J h).1
  have hJ := hg
  rw [eq_adjointSet sX h] at hg
  rw [eq_adjointSet sX h']
  obtain ⟨hX, hsm, hΔ, hD0, hDns, -⟩ := h
  have hΔ' := h'.2.2.1
  haveI : MMP.Mori.IsVariety k sX := hX.1
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hC : Divisor.IsCartier (Finsupp.single S 1 : Divisor X) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  constructor
  · intro hg'
    by_cases hU : S.idealSheaf.subschemeι ⁻¹ᵁ U = ⊥
    · exact Or.inl hU
    right
    apply isRestrictionAlong_zero_of_lt_one
    have hxU : (DivisorOver.ofPrimeDivisor k hX S).f
        (DivisorOver.ofPrimeDivisor k hX S).E.genericPoint ∈ U :=
      genericPoint_mem_of_preimage_ne_bot S hU
    have h0 := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn
      (Divisor.toQDivisor (Δ - Finsupp.single S 1)) S
    rw [QDivisor.toRDivisor_toQDivisor] at h0
    have h1 := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn
      (Divisor.toQDivisor (Δ - Finsupp.single S 1) +
        (D + Divisor.toQDivisor (Finsupp.single S 1))) S
    rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
    have hv := hg'.2 n _ _ _ hxU h0 h1
    rw [valuation_ofPrimeDivisor] at hv
    have hDS : (0 : ℝ) ≤ ((D.coeff S : ℚ) : ℝ) := by exact_mod_cast hD0 S
    have e0 : (Divisor.toQDivisor (Δ - Finsupp.single S 1)).coeff S = 0 := by
      rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_sub, hS,
        DivisorWithCoeffs.coeff_single_self]; simp
    have e1 : (Divisor.toQDivisor (Δ - Finsupp.single S 1) +
        (D + Divisor.toQDivisor (Finsupp.single S 1))).coeff S = D.coeff S + 1 := by
      rw [DivisorWithCoeffs.coeff_add, e0, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor,
        DivisorWithCoeffs.coeff_single_self]; simp
    rw [e0, e1] at hv
    have hc : ⌈(1 : ℝ) - (((D.coeff S + 1 : ℚ)) : ℝ)⌉ ≤ 0 := by
      apply Int.ceil_le.mpr; push_cast; linarith
    rw [if_neg (by norm_num)] at hv
    refine lt_of_le_of_lt hv ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    omega
  · intro hor
    refine ⟨hg.1, fun n' F a₀' a hx ha₀' ha => ?_⟩
    rw [toRDivisor_sub_single_add Δ D S] at ha
    have := F.isLocallyNoetherian
    have := F.isNormal
    have := F.isIntegral
    have := F.isBirationalMorphism.isDominant
    have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
    have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
      (Finsupp.single S 1 : Divisor X)
    obtain ⟨C', hC'⟩ := hC.exists_isPullback hB
    have ha₀ := isLogDiscrepancy_add_smul ha₀' hC 1 C' hB hC'
    have e1 : Divisor.toRDivisor (Δ - Finsupp.single S 1) +
        (1 : ℝ) • Divisor.toRDivisor (Finsupp.single S 1) = Divisor.toRDivisor Δ := by
      rw [map_sub, one_smul]; abel
    rw [e1] at ha₀
    have hv := hg.2 n' F _ _ hx ha₀ ha
    by_cases hA' : a₀' = 0
    · refine hv.trans (WithZero.exp_le_exp.mpr ?_)
      rw [if_pos hA']
      split_ifs <;> omega
    by_cases hA : a₀' - 1 * (C'.coeff F.E : ℝ) = 0
    swap
    · rwa [if_neg hA, ← if_neg hA' (t := (1 : ℤ)) (e := 0)] at hv
    -- the special case: `F` is a zero place of `(X, Δ)` centred on `S`
    rw [if_neg hA']
    set x := F.f F.E.genericPoint with hxdef
    have hc0 : C'.coeff F.E ≠ 0 := fun h0 => hA' (by rw [h0] at hA; simpa using hA)
    have hxS : x ∈ S.support := by
      by_contra hxS
      exact hc0 (coeff_isPullback_eq_zero hC
        (fun hm => hxS (DivisorWithCoeffs.supp_single_le S 1 hm)) C' hB hC')
    have hgS : S.divisorialValuation g < 1 :=
      lt_one_of_isRestrictionAlong_zero S
        (hor.resolve_left (preimage_ne_bot_of_mem S hxS hx))
    rw [hA] at ha₀
    -- `a = 0`, since `D` does not pass through the centre of `F`
    have hxD : x ∉ D.supp := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ D.isClosed_supp
      hDns ha₀
    obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
    have hsupp : D₀.supp = D.supp :=
      QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
    have hB₀ := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
    obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB₀
    have hd0 := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hxD) D₀' hB₀ hD₀'
    have haD := isLogDiscrepancy_add_of_zsmul ha₀ hm hD₀ hD₀c D₀' hB₀ hD₀'
    rw [hd0] at haD
    have ha0 : a = 0 := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha haD
      simpa using this
    rw [ha0, Int.ceil_zero]
    -- `g` is regular and vanishes at the centre of `F`
    have hUne : Nonempty U := ⟨⟨x, hx⟩⟩
    obtain ⟨r, hr⟩ := hrange U hJ
    set a' : X.presheaf.stalk x := X.presheaf.germ U x hx r with ha'
    have hga : algebraMap (X.presheaf.stalk x) X.functionField a' = g := by
      rw [ha', ← hr, Scheme.algebraMap_germ_eq_germToFunctionField]
    have hnu : ¬ IsUnit a' := by
      intro hu
      have hsp : S.genericPoint ⤳ x := by
        rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact hxS
      have hu' := hu.map (X.presheaf.stalkSpecializes hsp).hom
      have hcomp : ∀ b : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField b =
          algebraMap S.localRing X.functionField ((X.presheaf.stalkSpecializes hsp).hom b) :=
        fun b => by
          change (X.presheaf.stalkSpecializes _).hom b =
            (X.presheaf.stalkSpecializes _).hom ((X.presheaf.stalkSpecializes hsp).hom b)
          rw [← CommRingCat.comp_apply, TopCat.Presheaf.stalkSpecializes_comp]
      have h1 : S.divisorialValuation g = 1 := by
        rw [← hga, hcomp a']
        exact divisorialValuation_algebraMap_eq_one_of_isUnit S hu'
      exact absurd h1 hgS.ne
    have hlt := val_stalk_lt_one F.f F.E a' hnu
    rw [hga] at hlt
    exact le_exp_neg_one_of_lt_one hlt

end Restriction

/-! ### A log resolution which is an isomorphism away from `Supp D` -/

section GoodResolution

open MMP.Resolution

open MMP.Threefold.Mori.OpenRestriction in
/-- The restriction of an snc divisor to an open subscheme is snc. -/
private theorem isSNC_restrictOpen {R : Type*} [Zero R] {X Y : Scheme.{0}} (g : X ⟶ Y)
    [∀ E : MMP.Mori.PrimeDivisor X, LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ g)]
    {D : DivisorWithCoeffs R X} (hD : D.IsSNC g) (U : X.Opens) :
    (D.restrictOpen U).IsSNC (U.ι ≫ g) := by
  refine ⟨fun E₀ hE₀ => ?_, fun x => (sncStalk_restrict_iff U.ι D x).mpr (hD.2 (U.ι x))⟩
  have hsm := hD.1 (OpenWeilRestriction.primeDivisorMap U.ι E₀)
    (Finsupp.mem_support_iff.2 (Finsupp.mem_support_iff.1 hE₀ : D.restrictOpen U E₀ ≠ 0))
  rw [IsSmoothScheme, smoothLocus_eq_smoothLocus] at hsm
  exact (isSmoothScheme_comap_iff U.ι g (OpenWeilRestriction.primeDivisorMap U.ι E₀).idealSheaf
    E₀.idealSheaf (idealSheaf_comap_primeDivisorMap U.ι E₀)).mpr fun z _ => hsm ▸ trivial

/-- On the complement of `Supp D`, the union of the components of `Δ + D` is that of `Δ`. -/
private theorem preimage_sup_support_eq {X : Scheme.{0}} (Δ : Divisor X) (D : QDivisor X)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hΔ : ∀ P, 0 ≤ Δ.coeff P) :
    Scheme.Opens.ι (X := X) D.supp.compl ⁻¹' ((Divisor.toQDivisor Δ + D).support.sup
        fun E => (E.idealSheaf.support : Set X)) =
      Scheme.Opens.ι (X := X) D.supp.compl ⁻¹' (Δ.support.sup fun E => (E.idealSheaf.support : Set X)) := by
  classical
  ext y
  simp only [Set.mem_preimage, Finset.sup_set_eq_biUnion, Set.mem_iUnion, Finsupp.mem_support_iff,
    exists_prop]
  have hy : Scheme.Opens.ι (X := X) D.supp.compl y ∉ D.supp := y.2
  constructor
  · rintro ⟨E, hE, hyE⟩
    refine ⟨E, fun h0 => hE ?_, hyE⟩
    have hDE : D E = 0 := by
      by_contra h
      exact hy (DivisorWithCoeffs.mem_supp_iff.2 ⟨E, h, hyE⟩)
    change ((Δ E : ℤ) : ℚ) + D E = 0
    rw [h0, hDE]; simp
  · rintro ⟨E, hE, hyE⟩
    refine ⟨E, fun h0 => ?_, hyE⟩
    have h1 : ((Δ E : ℤ) : ℚ) + D E = 0 := h0
    have h2 := hD0 E
    have h3 : (0 : ℚ) ≤ ((Δ E : ℤ) : ℚ) := by exact_mod_cast hΔ E
    have : ((Δ E : ℤ) : ℚ) = 0 := by
      change (0 : ℚ) ≤ D E at h2
      linarith
    exact hE (by exact_mod_cast this)

/-- The preimage in an open `U` of the union of the components of `Δ` is the union of the
components of `Δ|_U`. -/
private theorem preimage_sup_support_eq_restrictOpen {R : Type*} [Zero R] {X : Scheme.{0}}
    (Δ : DivisorWithCoeffs R X) (U : X.Opens) :
    U.ι ⁻¹' (Δ.support.sup fun E => (E.idealSheaf.support : Set X)) =
      ⋃ F ∈ (Δ.restrictOpen U).support, (F.support : Set U.toScheme) := by
  classical
  ext y
  simp only [Set.mem_preimage, Finset.sup_set_eq_biUnion, Set.mem_iUnion, Finsupp.mem_support_iff,
    exists_prop]
  constructor
  · rintro ⟨E, hE, hyE⟩
    obtain ⟨F, rfl⟩ := MMP.Threefold.Mori.OpenRestriction.exists_primeDivisorMap_eq_of_mem_support U.ι E y hyE
    exact ⟨F, hE, (MMP.Threefold.Mori.OpenRestriction.mem_support_primeDivisorMap_iff U.ι F y).1 hyE⟩
  · rintro ⟨F, hF, hyF⟩
    exact ⟨_, hF, (MMP.Threefold.Mori.OpenRestriction.mem_support_primeDivisorMap_iff U.ι F y).2 hyF⟩

/-- **A log resolution of `Δ + D` which is an isomorphism over `X ∖ Supp D`**, for `Δ` snc on the
smooth `X`, and projective over `X` when `X` carries an ample invertible sheaf. -/
private theorem exists_isLogResolution_isIso_compl_supp {k : Type} [Field k] [CharZero k]
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ) (D : QDivisor X)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M]
    (hM : Stacks.Ample.IsAmple X M) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ X), MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ ∧
      IsIso (μ ∣_ D.supp.compl) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  set B := Divisor.toQDivisor Δ + D with hB
  obtain ⟨Y, μ, hres, hpure, hsnc, hiso⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX B.support
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hres.isVariety_source
  haveI : LocallyOfFiniteType (μ ≫ sX) := hres.isVariety_source.toLocallyOfFiniteType
  haveI : QuasiCompact (μ ≫ sX) := hres.isVariety_source.toQuasiCompact
  haveI : AlgebraicGeometry.IsNoetherian Y := isNoetherian_of_locallyOfFiniteType (μ ≫ sX)
  haveI : IsProper μ := hres.isProjective.isProper
  refine ⟨Y, μ, ⟨⟨⟨inferInstance, hres.isBirationalMorphism, hres.isSmoothScheme⟩, hpure, ?_⟩,
    isProjectiveMorphism_of_isProjective μ M hM hres.isProjective⟩, ?_⟩
  · refine MMP.Resolution.isSNCSubset_of_isSNCClosedSubset _ ?_
    convert hsnc using 1
    rw [Closeds.coe_sup, QDivisor.supp_toRDivisor]
    congr 1
    change μ ⁻¹' (B.supp : Set X) = _
    simp [DivisorWithCoeffs.supp, Closeds.coe_finset_sup]
  · refine hiso _ ?_ ?_
    · haveI : LocallyOfFinitePresentation sX :=
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
      haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).1 hsm
      haveI : LocallyOfFinitePresentation (Scheme.Opens.ι (X := X) D.supp.compl ≫ sX) :=
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType
          (f := Scheme.Opens.ι (X := X) D.supp.compl ≫ sX)).mpr inferInstance
      exact (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
    · rw [preimage_sup_support_eq Δ D hD0 (fun P => by
        rcases hΔ.1 P with h | h <;> simp [h])]
      haveI : ∀ E : MMP.Mori.PrimeDivisor X,
          LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ sX) := fun E =>
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := E.idealSheaf.subschemeι ≫ sX)).mpr
          inferInstance
      have h1 := isSNC_restrictOpen sX hΔ.2 D.supp.compl
      have h2 := MMP.Fourfold.SNCWeight.PrimeDivisorUnion.isSNCClosedSubset_of_isSNC _ h1
      convert h2 using 1
      exact preimage_sup_support_eq_restrictOpen Δ _

end GoodResolution

/-! ### Relative ampleness of Cartier divisors -/

section AmpleTools

open RingedSpaceModuleAdjunction Stacks.Ample Stacks.RelativeVeryAmple

/-- The ringed-space pull-back of a module along a morphism of schemes is the scheme pull-back. -/
private noncomputable def modulePullbackIso {X Y : Scheme.{0}} (f : X ⟶ Y) (F : Y.Modules) :
    (modulePullback f.toLRSHom.toShHom).obj F ≅ (Scheme.Modules.pullback f).obj F :=
  (Adjunction.leftAdjointUniq (modulePullbackPushforwardAdjunction f.toLRSHom.toShHom)
    (Scheme.Modules.pullbackPushforwardAdjunction f)).app F

/-- For a quasi-compact morphism, `f`-ampleness gives ampleness over every affine open. -/
private theorem stacks_of_isRelativelyAmple {X S : Scheme.{0}} (f : X ⟶ S) [QuasiCompact f]
    (L : X.Modules) [IsInvertibleModule X L] (hL : MMP.Mori.IsRelativelyAmple f L) :
    Stacks.RelativeAmple.IsRelativelyAmple f L :=
  Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple f L inferInstance hL

/-- `𝒪_Y(mA) ≅ 𝒪_Y(A)^{⊗ m}` for a Cartier divisor `A`. -/
private noncomputable def divisorialSheafNsmulIso {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] {A : Divisor V} (hA : A.IsCartier) (m : ℕ) :
    haveI := hA.isInvertibleModule_divisorialSheaf
    (m • A).divisorialSheaf ≅ Stacks.Ample.tensorPowModule V A.divisorialSheaf (m : ℤ) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  induction m with
  | zero =>
    exact eqToIso (by rw [zero_smul]) ≪≫ Divisor.divisorialSheafZeroIso ≪≫
      (Stacks.Ample.tensorPowModuleZeroIso V A.divisorialSheaf).symm
  | succ n ih =>
    exact eqToIso (by rw [succ_nsmul]) ≪≫
      ((hA.nsmul n).divisorialSheafTensorIso hA).symm ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso ih).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso V A.divisorialSheaf).symm ≪≫
      Stacks.Ample.tensorPowModuleAddIso V A.divisorialSheaf (n : ℤ) 1 ≪≫
      eqToIso (by push_cast; rfl)

/-- **[Stacks, Tag 0C4K] for Cartier divisors.** Let `f : X ⟶ Y` and `g : Y ⟶ S` be
quasi-compact, `S` quasi-compact, `L` an `f`-ample Cartier divisor on `X` and `M` a `g`-ample
Cartier divisor on `Y` with pull-back `M' = f^*M`. Then `L + nM'` is `(f ≫ g)`-ample for all
large `n`. -/
private theorem exists_isRelativelyAmple_add_nsmul {X Y S : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace S]
    (f : X ⟶ Y) (g : Y ⟶ S) [QuasiCompact f] [QuasiCompact g]
    {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    {M : Divisor Y} (hM : M.IsCartier) (hMg : M.IsRelativelyAmple g hM)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ M.supp}
    {M' : Divisor X} (hM' : M.IsPullback f hB M') :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      (L + n • M').IsRelativelyAmple (f ≫ g) (hL.add ((hM'.isCartier hM).nsmul n)) := by
  have hM'c := hM'.isCartier hM
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := hM.isInvertibleModule_divisorialSheaf
  haveI := hM'c.isInvertibleModule_divisorialSheaf
  obtain ⟨n₀, hn₀⟩ := Stacks.AmplePullbackDatum.exists_threshold_isRelativelyAmple_comp f g _ _
    (stacks_of_isRelativelyAmple f _ hLf) (stacks_of_isRelativelyAmple g _ hMg)
  refine ⟨n₀, fun n hn => ?_⟩
  haveI := (hL.add (hM'c.nsmul n)).isInvertibleModule_divisorialSheaf
  have eB : (modulePullback f.toLRSHom.toShHom).obj M.divisorialSheaf ≅ M'.divisorialSheaf :=
    modulePullbackIso f _ ≪≫ (hM'.divisorialSheafIso (hBc := hM)).symm
  have e : Stacks.AmplePullbackPart1.tensorPullbackPowModule f L.divisorialSheaf
      M.divisorialSheaf n ≅ (L + n • M').divisorialSheaf :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
        (Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso f _ n ≪≫
          Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso X _ _ eB n ≪≫
          (divisorialSheafNsmulIso hM'c n).symm) ≪≫
      hL.divisorialSheafTensorIso (hM'c.nsmul n)
  exact MMP.Mori.IsRelativelyAmple.of_stacks _ _
    ((Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _ e).mp (hn₀ n hn))

/-- If `φ = (a, b) : W ⟶ X ×_S Y` is affine, `L` is `f`-ample and `N` is `g`-ample, then
`a^* L ⊗ b^* N` is ample relative to `a ≫ f`. -/
private theorem isRelativelyAmple_tensorModules_of_isAffineHom {S X Y W : Scheme.{0}}
    {f : X ⟶ S} {g : Y ⟶ S} {a : W ⟶ X} {b : W ⟶ Y} (h : a ≫ f = b ≫ g)
    [IsAffineHom (Limits.pullback.lift a b h)] (L : X.Modules) (N : Y.Modules)
    [IsInvertibleModule X L] [IsInvertibleModule Y N]
    (hL : Stacks.RelativeAmple.IsRelativelyAmple f L)
    (hN : Stacks.RelativeAmple.IsRelativelyAmple g N) :
    Stacks.RelativeAmple.IsRelativelyAmple (a ≫ f)
      (tensorModules W ((modulePullback a.toLRSHom.toShHom).obj L)
        ((modulePullback b.toLRSHom.toShHom).obj N)) := by
  have h1 := Stacks.AmpleFibreNeighbourhood.isRelativelyAmple_pullbackModule_of_isAffineHom
    (Limits.pullback.lift a b h) (Limits.pullback.fst f g ≫ f) _
    (Stacks.AmpleExternalTensor.isRelativelyAmple_externalTensor f g L N hL hN)
  have e := Stacks.AmpleExternalTensor.pullbackExternalTensorIso f g
    (Limits.pullback.lift a b h) L N
  simp only [Limits.pullback.lift_fst, Limits.pullback.lift_snd] at e
  rw [← Category.assoc, Limits.pullback.lift_fst] at h1
  exact (isRelativelyAmple_congr _ _ _ e).mp h1

/-- For a quasi-compact separated morphism `f`, the sum of two `f`-ample Cartier divisors is
`f`-ample: `𝒪(A + B) ≅ Δ^*(𝒪(A) ⊠ 𝒪(B))` and the diagonal of `f` is affine. -/
private theorem isRelativelyAmple_add {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {A B : Divisor X} (hA : A.IsCartier) (hAf : A.IsRelativelyAmple f hA)
    (hB : B.IsCartier) (hBf : B.IsRelativelyAmple f hB) :
    (A + B).IsRelativelyAmple f (hA.add hB) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  haveI := hB.isInvertibleModule_divisorialSheaf
  haveI := (hA.add hB).isInvertibleModule_divisorialSheaf
  haveI : IsAffineHom (Limits.pullback.lift (𝟙 X) (𝟙 X) (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f)) :=
    show IsAffineHom (Limits.pullback.diagonal f) from inferInstance
  have h := isRelativelyAmple_tensorModules_of_isAffineHom (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f) _ _
    (stacks_of_isRelativelyAmple f _ hAf) (stacks_of_isRelativelyAmple f _ hBf)
  rw [Category.id_comp] at h
  refine MMP.Mori.IsRelativelyAmple.of_stacks _ _ ((isRelativelyAmple_congr _ _ _ ?_).mp h)
  exact tensorModulesMapIso X (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _)
    (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _) ≪≫
    hA.divisorialSheafTensorIso hB

/-- For a quasi-compact separated morphism `f`, every positive multiple of an `f`-ample Cartier
divisor is `f`-ample. -/
private theorem isRelativelyAmple_nsmul {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    (n : ℕ) (hn : 0 < n) : (n • L).IsRelativelyAmple f (hL.nsmul n) := by
  induction n with
  | zero => exact absurd hn (lt_irrefl 0)
  | succ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn'
    · simpa using hLf
    · convert isRelativelyAmple_add _ (ih hn') _ hLf using 2
      rw [succ_nsmul]

/-- Relative ampleness of a Cartier divisor does not depend on the proof that it is Cartier, and
is transported along equalities of divisors. -/
private theorem isRelativelyAmple_of_eq {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} {A B : Divisor X}
    (hAB : A = B) (hA : A.IsCartier) (hB : B.IsCartier) (hAf : A.IsRelativelyAmple f hA) :
    B.IsRelativelyAmple f hB := by
  subst hAB; exact hAf

end AmpleTools

/-! ### Serre's theorem for relatively ample Cartier divisors -/

section SerreTwist

open Stacks.Ample Stacks.RelativeVeryAmple MMP.Flips

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{0}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{0}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{0}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{0, 0, 0} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

/-- The pull-back of `𝒪_Y(nH + F)` along `f : X ⟶ Y` is `f^*𝒪_Y(F) ⊗ (f^*𝒪_Y(H))^{⊗ n}`, for
Cartier divisors `H` and `F`. -/
private theorem nonempty_modulePullback_divisorialSheaf_nsmul_add_iso {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (f : X ⟶ Y) {H F : Divisor Y}
    (hH : H.IsCartier) (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
        (n • H + F).divisorialSheaf ≅
      tensorModules X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          F.divisorialSheaf)
        (tensorPowModule X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          H.divisorialSheaf) (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  set P := RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      P.mapIso (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      pullbackTensorModulesIso f _ _ ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- If `H` is an `g`-ample Cartier divisor and `F` is any Cartier divisor, then `mH + F` is
`g`-ample for `m ≫ 0`, provided the base is quasi-compact. -/
private theorem eventually_isRelativelyAmpleCartier_nsmul_add {Y Z : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [CompactSpace Z] (g : Y ⟶ Z)
    [QuasiCompact g] {H F : Divisor Y} (hH : IsRelativelyAmpleCartier g H) (hF : F.IsCartier) :
    ∀ᶠ m : ℕ in Filter.atTop, IsRelativelyAmpleCartier g (m • H + F) := by
  obtain ⟨hHc, hHa⟩ := hH
  haveI := hHc.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  choose V' hVa hzV _ using fun z : Z =>
    exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun z : Z ↦ ((V' z : Z.Opens) : Set Z))
    (fun z ↦ (V' z).isOpen) (fun z _ ↦ Set.mem_iUnion.2 ⟨z, hzV z⟩)
  have hev : ∀ v ∈ T, ∀ᶠ m : ℕ in Filter.atTop,
      haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
      IsAmple (g ⁻¹ᵁ V' v).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback
          (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom).obj (m • H + F).divisorialSheaf) := by
    intro v _
    let W := (g ⁻¹ᵁ V' v).toScheme
    let P := RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom
    haveI hPF : IsInvertibleModule W (P.obj F.divisorialSheaf) := inferInstance
    haveI hPH : IsInvertibleModule W (P.obj H.divisorialSheaf) := inferInstance
    filter_upwards [eventually_isAmple_tensorModules_tensorPowModule (P.obj H.divisorialSheaf)
      (P.obj F.divisorialSheaf) (hHa _ (hVa v))]
      with m hm
    haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := nonempty_modulePullback_divisorialSheaf_nsmul_add_iso (g ⁻¹ᵁ V' v).ι hHc hF m
    exact (@isAmple_congr _ _ _ inferInstance
      (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
        (isInvertibleModule_tensorPowModule _ _ _)) e).2 hm
  filter_upwards [(Filter.eventually_all_finset T).2 hev] with m hm
  have hc := (hHc.nsmul m).add hF
  haveI := hc.isInvertibleModule_divisorialSheaf
  refine ⟨hc, ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover
    g _ inferInstance).2 fun z => ?_).2⟩
  obtain ⟨v, hvT, hzv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ z))
  exact ⟨V' v, hVa v, hzv, hm v hvT⟩

end SerreTwist

/-! ### Bridges between the notions of relative ampleness -/

section AmpleBridges

open Stacks.Ample

/-- `f`-ampleness of a Cartier divisor gives ampleness over every affine open of the base. -/
private theorem isRelativelyAmpleCartier_of_isRelativelyAmple {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) [QuasiCompact f]
    {L : Divisor X} (hL : L.IsCartier) (h : L.IsRelativelyAmple f hL) :
    MMP.Flips.IsRelativelyAmpleCartier f L := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  exact ⟨hL, (stacks_of_isRelativelyAmple f _ h).2⟩

/-- Ampleness over every affine open of the base gives `f`-ampleness. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) {L : Divisor X}
    (h : MMP.Flips.IsRelativelyAmpleCartier f L) : L.IsRelativelyAmple f h.choose := by
  obtain ⟨hL, hamp⟩ := h
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- An ample Cartier divisor on `X` is ample relative to `g : X ⟶ Z'` for affine `Z'`. -/
private theorem isRelativelyAmple_of_isAmple_of_isAffine {X Z' : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (g : X ⟶ Z') [IsAffine Z']
    {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple g hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro z
  refine ⟨⊤, isAffineOpen_top Z', trivial, ?_⟩
  haveI : IsIso (g ⁻¹ᵁ ⊤).ι := by
    rw [Scheme.Hom.preimage_top]
    exact (Scheme.topIso X).isIso_hom
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffineHom (g ⁻¹ᵁ ⊤).ι
    A.divisorialSheaf hamp

/-- An ample Cartier divisor on `X` is ample relative to the identity of `X`. -/
private theorem isRelativelyAmple_id_of_isAmple {X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple (𝟙 X) hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro x
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  refine ⟨V, hV, hxV, ?_⟩
  haveI : IsAffine ((𝟙 X) ⁻¹ᵁ V).toScheme := by
    rw [Scheme.Hom.id_preimage]; exact hV
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffine ((𝟙 X) ⁻¹ᵁ V).ι
    A.divisorialSheaf hamp

end AmpleBridges

/-! ### Divisors of rational top forms -/

section TopForms

/-- The unit of `K(Y)` (as rational functions) with a given nonzero value in the function field. -/
private noncomputable def unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    (h : Y.functionField) (hh : h ≠ 0) : (RationalFunctions Y)ˣ :=
  (IsUnit.map (Pi.ringHom fun Z : irreducibleComponents Y => (Y.presheaf.stalkSpecializes
    (Inseparable.of_eq (componentGenericPoint_eq_genericPoint' Z)).specializes).hom)
    (isUnit_iff_ne_zero.2 hh)).unit

private theorem evalFF_unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    (h : Y.functionField) (hh : h ≠ 0) (Z : irreducibleComponents Y) :
    MMP.Threefold.Mori.Helpers.evalFF Z (unitOfFunctionField h hh : RationalFunctions Y) = h := by
  change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom h) = h
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_refl]
  rfl

private theorem coeff_principalDivisor_unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (h : Y.functionField) (hh : h ≠ 0)
    (P : MMP.Mori.PrimeDivisor Y) :
    (MMP.Mori.principalDivisor (unitOfFunctionField h hh)).coeff P = Y.ord h P.genericPoint := by
  rw [MMP.Mori.coeff_principalDivisor, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord,
    evalFF_unitOfFunctionField]

/-- **The divisor of a nonzero rational top form is a canonical divisor**, on a normal variety over
a perfect field which has a canonical divisor: it differs from a canonical divisor `div(ω₁)` by
the principal divisor of `τ/ω₁`. -/
private theorem isCanonicalDivisor_divisorOfForm {k : Type} [Field k] [PerfectField k]
    {Y : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [LocallyOfFiniteType sY] (hY : IsNormalVariety k sY) {n : ℕ}
    {K₁ : Divisor Y} (hK₁ : K₁.IsCanonicalDivisor sY n) {τ : RationalPluriForms sY n 1}
    (hτ : τ ≠ 0) : (divisorOfForm τ).IsCanonicalDivisor sY n := by
  obtain ⟨ω₁, hω₁0, hω₁⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hY hK₁
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY)
    hK₁.topologicalKrullDim_eq
  letI := functionFieldAlgebra sY
  obtain ⟨b⟩ := exists_basis_topForms (sX := sY) hK₁.topologicalKrullDim_eq
  set c := (ZTensorPower.basis b 1).repr τ () with hc
  set c₁ := (ZTensorPower.basis b 1).repr ω₁ () with hc₁
  have hc0 : c ≠ 0 := repr_ne_zero_of_ne_zero b hτ
  have hc₁0 : c₁ ≠ 0 := repr_ne_zero_of_ne_zero b hω₁0
  have hq : c / c₁ ≠ 0 := div_ne_zero hc0 hc₁0
  refine hK₁.of_linearlyEquivalent ⟨unitOfFunctionField (c / c₁) hq, ?_⟩
  ext P
  obtain ⟨NP, hNP⟩ := P.exists_ordForm_eq_ord_add_mul hd b
  rw [DivisorWithCoeffs.coeff_sub, coeff_divisorOfForm, ← hω₁ P,
    coeff_principalDivisor_unitOfFunctionField, hNP 1 τ hτ, hNP 1 ω₁ hω₁0, div_eq_mul_inv,
    Scheme.ord_mul hc0 (inv_ne_zero hc₁0), ← zpow_neg_one, MMP.Mori.ord_zpow _ hc₁0]
  ring

end TopForms

/-! ### Cohomology along a morphism with vanishing higher direct images -/

section Leray

attribute [local instance] HasDerivedCategory.standard
attribute [local instance 2000] HomotopyCategory.Plus.instHasPointwiseRightDerivedFunctorQuasiIso

/-- **Leray collapse.** If the higher direct images of `M` along `π : Y ⟶ X` vanish, the
vanishing of the higher cohomology of `M` on `Y` gives that of `π_* M` on `X`. -/
private theorem isZero_rightDerived_pushforward_of_isZero {X Y : Scheme.{0}} (π : Y ⟶ X)
    (M : Y.Modules)
    (hR : ∀ j : ℕ, 0 < j → IsZero (((Scheme.Modules.pushforward π).rightDerived j).obj M))
    (hY : ∀ i : ℕ, 0 < i →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y).rightDerived i).obj M))
    (i : ℕ) (hi : 0 < i) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward π).obj M)) := by
  have hM : (Scheme.Modules.pushforward π).rightAcyclic M :=
    (Stacks.DerivedIndexing.rightAcyclic_iff_forall_nat _ M).2 hR
  have e := Stacks.Cohomology.AffineComparison.restrictScalarsRightDerivedIso π M i ≪≫
    Stacks.Cohomology.AffineComparison.rightDerivedCollapseIso (Scheme.Modules.pushforward π)
      (Stacks.Cohomology.AffineBase.moduleGlobalSections X)
      (Stacks.Cohomology.AffineComparison.rightAcyclic_moduleGlobalSections_pushforward_obj π)
      M hM i
  refine IsZero.of_iso ?_ e.symm
  have h := hY i hi
  rw [ModuleCat.isZero_iff_subsingleton] at h ⊢
  exact h

/-- **Cohomology over an affine base** ([Stacks, Tag 01XK]). For a quasi-compact quasi-separated
`h : Y ⟶ S` with `S` affine and a quasi-coherent `M` whose higher direct images vanish, the higher
cohomology of `M` vanishes. -/
private theorem isZero_rightDerived_of_isZero_pushforward {Y S : Scheme.{0}} (h : Y ⟶ S)
    [IsAffine S] [QuasiCompact h] [QuasiSeparated h] (M : Y.Modules) [M.IsQuasicoherent]
    (i : ℕ) (hR : IsZero (((Scheme.Modules.pushforward h).rightDerived i).obj M)) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y).rightDerived i).obj M) := by
  have e := (Stacks.Cohomology.AffineBase.affineBaseHigherDirectImageIso h i).app
    ⟨M, inferInstance⟩
  have h0 : IsZero ((Stacks.Cohomology.AffineBase.moduleGlobalSections S).obj
      (((Scheme.Modules.pushforward h).rightDerived i).obj M)) :=
    (Stacks.Cohomology.AffineBase.moduleGlobalSections S).map_isZero hR
  have h1 := IsZero.of_iso h0 e
  rw [ModuleCat.isZero_iff_subsingleton] at h1 ⊢
  exact h1

end Leray

/-! ### Charts of a projective space over an affine base -/

section Charts

/-- A pushout of commutative rings is generated by the images of the two maps. -/
private theorem closure_range_union_eq_top_of_isPushout {R A B P : CommRingCat.{0}}
    {f : R ⟶ A} {g : R ⟶ B} {inl : A ⟶ P} {inr : B ⟶ P} (h : IsPushout f g inl inr) :
    Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) = ⊤ := by
  letI := f.hom.toAlgebra
  letI := g.hom.toAlgebra
  have hT := CommRingCat.isPushout_tensorProduct R A B
  let e := hT.isoIsPushout _ _ h
  have h1 : ∀ a, e.hom.hom (a ⊗ₜ[R] (1 : B)) = inl.hom a := by
    intro a
    have := congrArg (fun φ => φ.hom a) (hT.inl_isoIsPushout_hom _ _ h)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have h2 : ∀ b, e.hom.hom ((1 : A) ⊗ₜ[R] b) = inr.hom b := by
    intro b
    have := congrArg (fun φ => φ.hom b) (hT.inr_isoIsPushout_hom _ _ h)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have key : ∀ t : TensorProduct R A B, e.hom.hom t ∈
      Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Subring.zero_mem _
    | tmul a b =>
      have : (a ⊗ₜ[R] b : TensorProduct R A B) = (a ⊗ₜ[R] (1 : B)) * ((1 : A) ⊗ₜ[R] b) := by
        simp
      rw [this, map_mul, h1, h2]
      exact Subring.mul_mem _ (Subring.subset_closure (Or.inl ⟨a, rfl⟩))
        (Subring.subset_closure (Or.inr ⟨b, rfl⟩))
    | add x y hx hy => rw [map_add]; exact Subring.add_mem _ hx hy
  rw [eq_top_iff]
  intro p _
  have : e.hom.hom (e.inv.hom p) = p := by
    change (e.inv ≫ e.hom).hom p = p; simp
  rw [← this]; exact key _

/-- The preimage in `Z × P`, `Z` affine, of an affine open `W ⊆ P` is affine, with functions
generated by those from `Z` and from `W`. -/
private theorem isAffine_and_closure_preimage_snd {Z P : Scheme.{0}} [IsAffine Z] (W : P.Opens)
    (hW : IsAffineOpen W) :
    IsAffine (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W).toScheme ∧
    Subring.closure (Set.range
      ((pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W).ι ≫
        pullback.fst (terminal.from Z) (terminal.from P)).appTop.hom ∪
      Set.range (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W).appTop.hom) = ⊤ := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  have h1 := isPullback_morphismRestrict snd W
  have h2 := IsPullback.of_hasPullback (terminal.from Z) (terminal.from P)
  have h3 := IsPullback.paste_vert h1 h2.flip
  haveI : IsAffine W.toScheme := hW
  exact ⟨IsAffine.of_isPullback h3.flip,
    closure_range_union_eq_top_of_isPushout (isPushout_appTop_of_isPullback h3.flip)⟩

/-- A morphism into `Z × P` is a closed immersion over `snd⁻¹ W` once the functions on the
preimage are generated by those coming from `Z` and from `W`. -/
private theorem isClosedImmersion_morphismRestrict_of_closure {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (j : X ⟶ pullback (terminal.from Z) (terminal.from P))
    [IsAffine (j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme]
    (hgen : Subring.closure (Set.range
      ((j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).ι ≫ j ≫
        pullback.fst _ _).appTop.hom ∪
      Set.range ((j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) ≫
        (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W)).appTop.hom) = ⊤) :
    IsClosedImmersion (j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  haveI : IsAffine (snd ⁻¹ᵁ W).toScheme := (isAffine_and_closure_preimage_snd (Z := Z) W hW).1
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  rw [← RingHom.range_eq_top]
  refine eq_top_iff.2 (le_trans (le_of_eq hgen.symm) ?_)
  rw [Subring.closure_le]
  rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
  · refine ⟨((snd ⁻¹ᵁ W).ι ≫ pullback.fst _ _).appTop.hom a, ?_⟩
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc,
      morphismRestrict_ι, Category.assoc]
  · refine ⟨(snd ∣_ W).appTop.hom b, ?_⟩
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop]

/-- Over `snd⁻¹ W`, a closed immersion into `Z × P` has affine source whose functions are
generated by those from `Z` and from `W`. -/
private theorem isAffine_and_closure_of_isClosedImmersion {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (i : X ⟶ pullback (terminal.from Z) (terminal.from P)) [IsClosedImmersion i] :
    IsAffine (i ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme ∧
    Subring.closure (Set.range
      ((i ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).ι ≫ i ≫
        pullback.fst _ _).appTop.hom ∪
      Set.range ((i ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) ≫
        (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W)).appTop.hom) = ⊤ := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  obtain ⟨hV, hgen⟩ := isAffine_and_closure_preimage_snd (Z := Z) W hW
  haveI := hV
  haveI : IsClosedImmersion (i ∣_ (snd ⁻¹ᵁ W)) := inferInstance
  obtain ⟨haff, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine (i ∣_ (snd ⁻¹ᵁ W))
  refine ⟨haff, ?_⟩
  have h := congrArg (Subring.map (i ∣_ (snd ⁻¹ᵁ W)).appTop.hom) hgen
  rw [RingHom.map_closure, Set.image_union, ← Set.range_comp, ← Set.range_comp,
    ← RingHom.range_eq_map, RingHom.range_eq_top.2 hsurj] at h
  rw [← h]
  congr 3
  funext a
  simp only [Function.comp_apply]
  rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc (i ∣_ (snd ⁻¹ᵁ W)),
    morphismRestrict_ι, Category.assoc]

/-- `isClosedImmersion_morphismRestrict_of_closure`, phrased through `φ = j ≫ snd`. -/
private theorem isClosedImmersion_morphismRestrict_of_closure' {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (j : X ⟶ pullback (terminal.from Z) (terminal.from P)) (φ : X ⟶ P)
    (hφ : j ≫ pullback.snd _ _ = φ) [IsAffine (φ ⁻¹ᵁ W).toScheme]
    (hgen : Subring.closure (Set.range ((φ ⁻¹ᵁ W).ι ≫ j ≫ pullback.fst _ _).appTop.hom ∪
      Set.range (φ ∣_ W).appTop.hom) = ⊤) :
    IsClosedImmersion (j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) := by
  subst hφ
  haveI : IsAffine (j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme :=
    ‹IsAffine ((j ≫ pullback.snd _ _) ⁻¹ᵁ W).toScheme›
  refine isClosedImmersion_morphismRestrict_of_closure W hW j ?_
  rw [← morphismRestrict_comp]
  exact hgen

/-- `isAffine_and_closure_of_isClosedImmersion`, phrased through `φ = i ≫ snd`. -/
private theorem isAffine_and_closure_of_isClosedImmersion' {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (i : X ⟶ pullback (terminal.from Z) (terminal.from P)) [IsClosedImmersion i] (φ : X ⟶ P)
    (hφ : i ≫ pullback.snd _ _ = φ) :
    IsAffine (φ ⁻¹ᵁ W).toScheme ∧
    Subring.closure (Set.range ((φ ⁻¹ᵁ W).ι ≫ i ≫ pullback.fst _ _).appTop.hom ∪
      Set.range (φ ∣_ W).appTop.hom) = ⊤ := by
  subst hφ
  obtain ⟨h1, h2⟩ := isAffine_and_closure_of_isClosedImmersion (Z := Z) W hW i
  refine ⟨h1, ?_⟩
  rw [morphismRestrict_comp]
  exact h2

/-- An element of the subring generated by `f '' univ ∪ B` lies in the subring generated by
`f '' T ∪ B` for a finite `T`. -/
private theorem exists_finset_mem_closure {R A : Type*} [CommRing A] (f : R → A) (B : Set A)
    {c : A} (hc : c ∈ Subring.closure (Set.range f ∪ B)) :
    ∃ T : Finset R, c ∈ Subring.closure (f '' (T : Set R) ∪ B) := by
  classical
  have hdir : Directed (· ≤ ·) (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) :=
    fun T₁ T₂ => ⟨T₁ ∪ T₂,
      Subring.closure_mono (Set.union_subset_union_left _ (Set.image_mono (by simp))),
      Subring.closure_mono (Set.union_subset_union_left _ (Set.image_mono (by simp)))⟩
  have hle : Subring.closure (Set.range f ∪ B) ≤
      ⨆ T : Finset R, Subring.closure (f '' (T : Set R) ∪ B) := by
    rw [Subring.closure_le]
    rintro _ (⟨r, rfl⟩ | hb)
    · exact (le_iSup (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) {r})
        (Subring.subset_closure (Or.inl ⟨r, by simp, rfl⟩))
    · exact (le_iSup (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) ∅)
        (Subring.subset_closure (Or.inr hb))
  exact (Subring.mem_iSup_of_directed hdir).1 (hle hc)

/-- Projective space over the integers is quasi-compact. -/
private theorem compactSpace_projectiveSpaceAtUniverse (n : ℕ) :
    CompactSpace (projectiveSpaceAtUniverse.{0} n) := by
  haveI : IsIso (terminal.from (⊤_ Scheme.{0})) :=
    ⟨⟨𝟙 _, terminal.hom_ext _ _, terminal.hom_ext _ _⟩⟩
  haveI : IsIso (pullback.snd (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := inferInstance
  have hp : IsProper (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := isProper_projectiveSpaceOver n _
  haveI : UniversallyClosed (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := hp.toUniversallyClosed
  haveI : QuasiCompact (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) :=
    AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  haveI : CompactSpace (pullback (C := Scheme.{0}) (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) :=
    QuasiCompact.compactSpace_of_compactSpace (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n)))
  exact (pullback.snd (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))).homeomorph.compactSpace

/-- A quasi-compact scheme is covered by finitely many affine opens. -/
private theorem exists_finset_affineOpens_iSup_eq_top (P : Scheme.{0}) [CompactSpace P] :
    ∃ t : Finset P.affineOpens, ⨆ W ∈ t, (W : P.Opens) = ⊤ := by
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun W : P.affineOpens => (W : Set P))
    (fun W => W.1.isOpen) (fun x _ => by
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
      exact Set.mem_iUnion.2 ⟨⟨V, hV⟩, hxV⟩)
  refine ⟨t, eq_top_iff.2 fun x _ => ?_⟩
  obtain ⟨W, hWt, hxW⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ x))
  exact (le_iSup₂ (f := fun W (_ : W ∈ t) => (W : P.Opens)) W hWt) hxW

end Charts

/-! ### Vanishing for the twisted adjoint ideal -/

section AmpleGap

/-- **Relative Kawamata–Viehweg vanishing, ample-gap form.** For `f : Y ⟶ Z` projective with
`Y` smooth, `B ≥ 0` snc with coefficients `< 1` and `L` Cartier with `L - (K_Y + B)` `f`-ample,
`R^i f_* 𝒪_Y(L) = 0` for `i > 0`. This is the round-up form applied to `M = L - (K_Y + B)`:
`K_Y + ⌈M⌉ = L` and `{M}` is supported on `Supp B`. -/
private theorem isZero_rightDerived_pushforward_divisorialSheaf_of_ampleGap
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {Y Z : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) (sZ : Z ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sY]
    [AlgebraicGeometry.IsVariety k sZ] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] (hY : IsSmoothScheme sY) (f : Y ⟶ Z) (hfZ : f ≫ sZ = sY)
    (hf : IsProjectiveMorphism f) {n : ℕ} {K : Divisor Y} (hK : K.IsCanonicalDivisor sY n)
    {B : QDivisor Y} (hB : B.IsEffective) (hsnc : DivisorWithCoeffs.IsSNC sY B)
    (hB1 : ∀ E : MMP.Mori.PrimeDivisor Y, B.coeff E < 1) {L : Divisor Y} (hL : L.IsCartier)
    (hM : (Divisor.toQDivisor L - (Divisor.toQDivisor K + B)).HasRelativelyAmpleMultiple f)
    (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward f).rightDerived i).obj L.divisorialSheaf) := by
  set B' := Divisor.toQDivisor L - (Divisor.toQDivisor K + B)
  have hcoeff : ∀ E, B'.coeff E = ((L.coeff E - K.coeff E : ℤ) : ℚ) - B.coeff E := fun E => by
    simp only [B', DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor]
    push_cast; ring
  have hround : K + B'.roundUp = L := by
    ext E
    change K.coeff E + B'.roundUp.coeff E = L.coeff E
    have h0 : ⌈((L.coeff E - K.coeff E : ℤ) : ℚ) - B.coeff E⌉ = L.coeff E - K.coeff E := by
      rw [Int.ceil_eq_iff]; constructor <;> push_cast <;> linarith [hB E, hB1 E]
    rw [DivisorWithCoeffs.coeff_roundUp, hcoeff, h0]
    omega
  have hfr : B'.fract.IsSNC sY := by
    refine hsnc.of_support_subset fun E hE => ?_
    rw [Finsupp.mem_support_iff] at hE ⊢
    intro h0
    apply hE
    change B'.fract.coeff E = 0
    rw [DivisorWithCoeffs.coeff_fract, hcoeff]
    have : B.coeff E = 0 := h0
    rw [this, sub_zero, Int.fract_intCast]
  have := MMP.Fourfold.isZero_rightDerived_pushforward_divisorialSheaf_canonical_add_roundUp
    sY sZ hY f hfZ hf hK B' hM hfr i hi
  rwa [hround] at this

end AmpleGap

section Vanishing

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **The canonical identity on the resolution.** With `K_Y + Γ = μ^*(K_X + Δ) + E`, for a Cartier
`M ∼ K_X + Δ + N` there is a canonical divisor `K_Y` of `Y` with `E + μ^*M ∼ K_Y + Γ + μ^*N`. -/
private theorem exists_isCanonicalDivisor_linearlyEquivalent [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Δ : Divisor X} {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsDominant μ] [CompactSpace Y] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    [IsProper μ] (hsmY : IsSmoothScheme (μ ≫ sX)) {Γ E : Divisor Y}
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) (N : Divisor X) (hN : N.IsCartier)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) (M : Divisor X) (hMc : M.IsCartier)
    (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMpb : M.IsPullback μ hMμ Mμ)
    (hNμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ N.supp)
    (Nμ : Divisor Y) (hNpb : N.IsPullback μ hNμ Nμ) :
    ∃ KY : Divisor Y, KY.IsCanonicalDivisor (μ ≫ sX) n ∧
      (E + Mμ).LinearlyEquivalent (KY + Γ + Nμ) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hn := hK.topologicalKrullDim_eq
  have hnY : topologicalKrullDim Y = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans hn
  obtain ⟨K₁, hK₁⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  have hτ0 := MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' μ
    hμ.functionFieldMap_bijective hd hω0
  set KY := divisorOfForm (pullbackRationalPluriForms sX μ ω) with hKYdef
  have hKY : KY.IsCanonicalDivisor (μ ≫ sX) n := isCanonicalDivisor_divisorOfForm hY hK₁ hτ0
  have hC : (K + Δ).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hCs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ (K + Δ)
  obtain ⟨Cμ, hCpb⟩ := hC.exists_isPullback hCs
  -- `E = K_Y + Γ - μ^*(K + Δ)`
  have hEeq : E = KY + Γ - Cμ := by
    ext P
    obtain ⟨n', a, ha, hEP⟩ := hE P
    have ha' : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ)
        ⟨Y, μ, hY, hμ, P⟩ (1 + (KY.coeff P : ℝ) - Cμ.coeff P) := by
      refine ⟨hX, ‹IsProper μ›, ω, hω0, ⟨K, hK, fun Γ => (hωK Γ).symm⟩, 1, fun _ => 1,
        fun _ => K + Δ, fun _ => Cμ, fun _ => hC, fun Γ => ?_, fun _ => ⟨hCs, hCpb⟩, ?_⟩
      · simp [hωK Γ, DivisorWithCoeffs.coeff_add]
      · simp only [Finset.univ_unique, Finset.sum_singleton, one_mul]
        rfl
    have huniq := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha'
    have : (E.coeff P : ℝ) = (KY.coeff P : ℝ) - Cμ.coeff P + Γ.coeff P := by
      rw [hEP, huniq]; ring
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add]
    have h' : E.coeff P = KY.coeff P - Cμ.coeff P + Γ.coeff P := by exact_mod_cast this
    rw [h']; ring
  -- `μ^*M ∼ μ^*(K + Δ) + μ^*N`
  obtain ⟨φ, hφ⟩ := hMK
  have hKΔN : (K + Δ + N).IsCartier := hC.add hN
  have hsum := Divisor.IsPullback.add hC hN
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _) hCpb hNpb
  have hφs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ (principalDivisor φ)
  have hφpb := Divisor.isPullback_principalDivisor (f := μ) φ hφs
  have hMeq : M = (K + Δ + N) + principalDivisor φ := by rw [← hφ]; abel
  have hMpb' := Divisor.IsPullback.add hKΔN (MMP.Fourfold.isCartier_of_isSmoothScheme hsm _)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _) hsum hφpb
  rw [← hMeq] at hMpb'
  have hMμeq : Mμ = Cμ + Nμ + principalDivisor (pullbackRationalFunction μ φ hφs) :=
    Divisor.IsPullback.eq hMc hMpb hMpb'
  refine ⟨KY, hKY, pullbackRationalFunction μ φ hφs, ?_⟩
  rw [hEeq, hMμeq]
  abel

/-- **A projective morphism to an affine scheme factors through an affine variety.** If `X` is a
variety over `k` and `f : X ⟶ Z` is projective with `Z` affine, then `X` is projective over an
affine `k`-variety `Z'`: the coordinate rings of the charts of `X ⊆ ℙⁿ_Z` are generated over `k`
by finitely many functions, and the finitely many coefficients from `Γ(Z, 𝒪_Z)` involved generate
a finitely generated `k`-subalgebra `R ⊆ Γ(X, 𝒪_X)` over which `X ⊆ ℙⁿ_R` is still closed. -/
private theorem exists_isProjectiveMorphism_isAffine_isVariety {k : Type} [Field k]
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] (hX : MMP.Mori.IsVariety k sX)
    {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] :
    ∃ (Z' : Scheme.{0}) (sZ' : Z' ⟶ Spec (.of k)) (g : X ⟶ Z'), MMP.Mori.IsVariety k sZ' ∧
      IsAffine Z' ∧ g ≫ sZ' = sX ∧ IsProjectiveMorphism g := by
  classical
  obtain ⟨n, i, hi, hif⟩ := hf
  haveI := hi
  haveI := compactSpace_projectiveSpaceAtUniverse n
  obtain ⟨t, ht⟩ := exists_finset_affineOpens_iSup_eq_top (projectiveSpaceAtUniverse.{0} n)
  set φ : X ⟶ projectiveSpaceAtUniverse.{0} n := i ≫ pullback.snd _ _ with hφ
  have hloc := fun W : (projectiveSpaceAtUniverse.{0} n).affineOpens =>
    isAffine_and_closure_of_isClosedImmersion' (Z := Z) W.1 W.2 i φ rfl
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  -- the chart rings are finitely generated over `K₀ = Γ(Spec k)`
  have hft : ∀ W : (projectiveSpaceAtUniverse.{0} n).affineOpens,
      ((φ ⁻¹ᵁ W.1).ι ≫ sX).appTop.hom.FiniteType := fun W => by
    haveI := (hloc W).1
    exact (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).1 inferInstance
  choose G hG using fun W => (hft W).out
  have hT := fun (W : (projectiveSpaceAtUniverse.{0} n).affineOpens) (c : Γ((φ ⁻¹ᵁ W.1).toScheme, ⊤)) =>
    exists_finset_mem_closure
      (fun z => ((φ ⁻¹ᵁ W.1).ι ≫ i ≫ pullback.fst _ _).appTop.hom z)
      (Set.range (φ ∣_ W.1).appTop.hom) (c := c) (by rw [(hloc W).2]; trivial)
  choose T hTc using hT
  let S : Finset Γ(Z, ⊤) := t.biUnion fun W => (G W).biUnion (T W)
  letI : Algebra Γ(Spec (.of k), ⊤) Γ(X, ⊤) := sX.appTop.hom.toAlgebra
  let R : Subalgebra Γ(Spec (.of k), ⊤) Γ(X, ⊤) :=
    Algebra.adjoin Γ(Spec (.of k), ⊤) ((i ≫ pullback.fst _ _).appTop.hom '' (S : Set Γ(Z, ⊤)))
  let gR : CommRingCat.of R ⟶ Γ(X, ⊤) := CommRingCat.ofHom R.val.toRingHom
  let g : X ⟶ Spec (CommRingCat.of R) := X.toSpecΓ ≫ Spec.map gR
  let sR : CommRingCat.of k ⟶ CommRingCat.of R := CommRingCat.ofHom
    ((sX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom).codRestrict R
      fun x => R.algebraMap_mem _)
  let sZ' : Spec (CommRingCat.of R) ⟶ Spec (.of k) := Spec.map sR
  have hgapp : ∀ x, g.appTop.hom x = R.val ((Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom x) := by
    intro x
    have h1 : g.appTop = (Spec.map gR).appTop ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom := by
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop]
    rw [h1, Scheme.ΓSpecIso_naturality]
    rfl
  have hgs : g ≫ sZ' = sX := by
    have h2 : sR ≫ gR = (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ sX.appTop := by
      ext x
      rfl
    change X.toSpecΓ ≫ Spec.map gR ≫ Spec.map sR = sX
    rw [← Spec.map_comp, h2, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  let j : X ⟶ pullback (terminal.from (Spec (CommRingCat.of R)))
      (terminal.from (projectiveSpaceAtUniverse.{0} n)) :=
    pullback.lift g φ (terminal.hom_ext _ _)
  have hjs : j ≫ pullback.snd _ _ = φ := pullback.lift_snd _ _ _
  have hjf : j ≫ pullback.fst _ _ = g := pullback.lift_fst _ _ _
  have ht' : ⨆ W : t, (W.1 : (projectiveSpaceAtUniverse.{0} n).Opens) = ⊤ := by
    rw [← ht, iSup_subtype]
  have hj : IsClosedImmersion j := by
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (fun W : t =>
      pullback.snd (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (projectiveSpaceAtUniverse.{0} n)) ⁻¹ᵁ W.1.1) ?_ fun W => ?_
    · rw [← Scheme.Hom.preimage_iSup, ht', Scheme.Hom.preimage_top]
    · haveI := (hloc W.1).1
      refine isClosedImmersion_morphismRestrict_of_closure' W.1.1 W.1.2 j φ hjs ?_
      have hcomp : (φ ⁻¹ᵁ W.1.1).ι ≫ j ≫ pullback.fst _ _ = (φ ⁻¹ᵁ W.1.1).ι ≫ g := by
        rw [hjf]
      rw [hcomp]
      letI : Algebra Γ(Spec (.of k), ⊤) Γ((φ ⁻¹ᵁ W.1.1).toScheme, ⊤) :=
        (((φ ⁻¹ᵁ W.1.1).ι ≫ sX).appTop.hom).toAlgebra
      have hadj := congrArg Subalgebra.toSubring (hG W.1)
      rw [Algebra.adjoin_eq_ring_closure, Algebra.top_toSubring] at hadj
      refine eq_top_iff.2 (le_trans (le_of_eq hadj.symm) (Subring.closure_le.2 ?_))
      rintro c (⟨x, rfl⟩ | hc)
      · refine Subring.subset_closure (Or.inl ⟨sZ'.appTop.hom x, ?_⟩)
        change _ = (((φ ⁻¹ᵁ W.1.1).ι ≫ sX).appTop).hom x
        rw [← hgs]
        simp only [g, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
      · refine (Subring.closure_le.2 ?_) (hTc W.1 c)
        rintro _ (⟨z, hz, rfl⟩ | hb)
        · have hzS : z ∈ S := Finset.mem_biUnion.2 ⟨W.1, W.2, Finset.mem_biUnion.2 ⟨c, hc, hz⟩⟩
          let r : R := ⟨(i ≫ pullback.fst _ _).appTop.hom z,
            Algebra.subset_adjoin ⟨z, hzS, rfl⟩⟩
          refine Subring.subset_closure (Or.inl ⟨(Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r, ?_⟩)
          simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
          rw [hgapp]
          congr 1
          change R.val (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            (Scheme.ΓSpecIso (CommRingCat.of R)).hom).hom r) = _
          rw [Iso.inv_hom_id]
          rfl
        · exact Subring.subset_closure (Or.inr hb)
  refine ⟨Spec (CommRingCat.of R), sZ', g, ?_, inferInstance, hgs, ⟨n, j, hj, hjf⟩⟩
  haveI : IsDomain R := inferInstance
  haveI : IsDomain (CommRingCat.of R) := ‹IsDomain R›
  have hfgR : Algebra.FiniteType Γ(Spec (.of k), ⊤) R := by
    rw [← Subalgebra.fg_iff_finiteType]
    exact ⟨(S.image fun z => (i ≫ pullback.fst _ _).appTop.hom z), by simp [R]⟩
  have hsR : sR.hom.FiniteType := by
    have h1 : (algebraMap Γ(Spec (.of k), ⊤) R).FiniteType := hfgR
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _
        (fun x => ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom x, by
          rw [← CommRingCat.comp_apply, Iso.hom_inv_id]; rfl⟩)
    exact h1.comp h2
  haveI : LocallyOfFiniteType sZ' := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]; exact hsR
  exact {}

/-- A prime divisor whose generic point maps to a point of coheight one is not exceptional for a
morphism. -/
private theorem not_isExceptional_of_coheight_eq_one {X Y : Scheme.{0}} (μ : Y ⟶ X)
    (P : MMP.Mori.PrimeDivisor Y) (h : Order.coheight (μ P.genericPoint) = 1) :
    ¬ MMP.Mori.RationalMap.IsExceptional (X := Y) μ.toRationalMap P := by
  rw [MMP.Mori.RationalMap.isExceptional_iff]
  intro hex
  have hdef : MMP.Mori.RationalMap.DefinedAt (X := Y) μ.toRationalMap P.genericPoint :=
    MMP.Mori.RationalMap.definedAt_iff.mpr ⟨μ.toPartialMap, trivial, rfl⟩
  have h2 := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp (hex hdef) (μ P.genericPoint)
    (MMP.Mori.RationalMap.image_subset_transform μ.toPartialMap rfl _
      ⟨⟨P.genericPoint, trivial⟩, by
        change P.genericPoint ∈ P.support
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl, rfl⟩)
  rw [h] at h2
  exact absurd h2 (by decide)

/-- **The zero places of `(X, Δ)` on a resolution which is an isomorphism away from `Supp D`.**
A prime divisor with `Γ_P = 1` has coefficient zero in `μ₀^*D` and in every divisor supported on
`μ₀`-exceptional prime divisors. -/
private theorem coeff_eq_zero_of_coeff_zeroLogDiscrepancy [IsAlgClosed k] [CharZero k]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hDns : ContainsNoStratum Δ D.supp)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (P : MMP.Mori.PrimeDivisor Y₀)
    (hP : Γ.coeff P = 1) :
    F.coeff P = 0 ∧ ¬ MMP.Mori.RationalMap.IsExceptional (X := Y₀) μ₀.toRationalMap P := by
  obtain ⟨n, h0⟩ := (hΓ.2 P).1 hP
  have hxD : μ₀ P.genericPoint ∉ D.supp :=
    notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ D.isClosed_supp hDns h0
  refine ⟨?_, ?_⟩
  · obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
    obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
    have hsupp : D₀.supp = D.supp :=
      QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hmD.ne') hD₀
    have h1 := coeff_isPullback_eq_zero (F := ⟨Y₀, μ₀, hY, hμ, P⟩) hD₀c
      (by rw [hsupp]; exact hxD) D₀' _ hD₀'
    have h2 := congrArg (fun G : QDivisor Y₀ => G.coeff P) hD₀'eq
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    change D₀'.coeff P = 0 at h1
    rw [h1, Int.cast_zero] at h2
    have hmD0 : (mD : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
    exact (mul_eq_zero.mp h2.symm).resolve_left hmD0
  · apply not_isExceptional_of_coheight_eq_one
    have hb : μ₀ P.genericPoint ∈ biregularLocus μ₀ := le_biregularLocus hiso hxD
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ₀ hb, P.coheight_genericPoint]

/-- **The boundary is snc.** A `ℚ`-divisor on a log resolution `μ₀` of `Δ + D` whose components
are components of `Γ`, of `μ₀^*D` or `μ₀`-exceptional is snc. -/
private theorem isSNC_of_support_subset [IsAlgClosed k] [CharZero k]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (B : QDivisor Y₀)
    (hB : ∀ P, B.coeff P ≠ 0 → Γ.coeff P ≠ 0 ∨ F.coeff P ≠ 0 ∨
      MMP.Mori.RationalMap.IsExceptional (X := Y₀) μ₀.toRationalMap P) :
    DivisorWithCoeffs.IsSNC (μ₀ ≫ sX) B := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ₀ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  have hp₀ : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ₀ ≫ sX) hlog.isSmoothScheme
    hlog.isSNCSubset
  have hmem : ∀ P : MMP.Mori.PrimeDivisor Y₀,
      P.genericPoint ∈ (⋃ E ∈ s, (E.support : Set Y₀)) → P ∈ s := by
    intro P hP
    obtain ⟨E, hEs, hPE⟩ := Set.mem_iUnion₂.mp hP
    have := E.eq_genericPoint_of_mem_support hPE P.coheight_genericPoint
    rwa [← AlgebraicGeometry.PrimeDivisor.genericPoint_injective this] at hEs
  refine hsnc.of_support_subset fun P hPB => ?_
  have hPs : P ∈ s := by
    rcases hB P (Finsupp.mem_support_iff.1 hPB) with hΓP | hFP | hEx
    · by_contra hPs
      have h1 := (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hp₀ hs hPs).1
      have hΓ1 : Γ.coeff P = 1 := (hΓ.1 P).resolve_left hΓP
      obtain ⟨n', h0⟩ := (hΓ.2 P).1 hΓ1
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique h0 h1
      norm_num at this
    · apply hmem
      rw [hs]
      right
      change μ₀ P.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
      rw [QDivisor.supp_toRDivisor]
      by_contra hx
      apply hFP
      obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ :=
        (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
      obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
      have hsupp : D₀.supp = D.supp :=
        QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hmD.ne') hD₀
      have hxD : μ₀ P.genericPoint ∉ D.supp := fun hxD => by
        apply hx
        obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.1 hxD
        refine DivisorWithCoeffs.mem_supp_iff.2 ⟨E, ?_, hxE⟩
        rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
        have h1 : (0 : ℚ) ≤ (Δ.coeff E : ℚ) := by
          rcases hΔ.1 E with h | h <;> rw [h] <;> norm_num
        have h2 : 0 < D.coeff E := lt_of_le_of_ne (hD0 E) (Ne.symm hE)
        exact (add_pos_of_nonneg_of_pos h1 h2).ne'
      have h1 := coeff_isPullback_eq_zero (F := ⟨Y₀, μ₀, hY, hμ, P⟩) hD₀c
        (by rw [hsupp]; exact hxD) D₀' _ hD₀'
      have h2 := congrArg (fun G : QDivisor Y₀ => G.coeff P) hD₀'eq
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        Int.cast_natCast] at h2
      change D₀'.coeff P = 0 at h1
      rw [h1, Int.cast_zero] at h2
      have hmD0 : (mD : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
      exact (mul_eq_zero.mp h2.symm).resolve_left hmD0
    · apply hmem
      rw [hs]
      left
      rw [SetLike.mem_coe, mem_exceptionalSet]
      intro hb
      apply not_isExceptional_of_coheight_eq_one μ₀ P _ hEx
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ₀ hb, P.coheight_genericPoint]
  simp [Finsupp.finset_sum_apply, Finsupp.single_apply, hPs]

/-- `μ^*(m(N - D)) = m(μ^*N - μ^*D)`. -/
private theorem toQDivisor_pullback_eq {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀] [CompactSpace X]
    (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {F : QDivisor Y₀} (hF : D.IsPullback μ₀ hD F) {N : Divisor X} (hN : N.IsCartier)
    {hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp}
    {Nμ : Divisor Y₀} (hNpb : N.IsPullback μ₀ hNμ Nμ) {m : ℕ} {A : Divisor X} (hAc : A.IsCartier)
    (hAeq : Divisor.toQDivisor A = (m : ℤ) • (Divisor.toQDivisor N - D))
    {hAμs : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ A.supp}
    {Aμ : Divisor Y₀} (hAμ : A.IsPullback μ₀ hAμs Aμ) :
    Divisor.toQDivisor Aμ = (m : ℤ) • (Divisor.toQDivisor Nμ - F) := by
  obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
  have hcart : ∀ G : Divisor X, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm
  have hs : ∀ G : Divisor X, ∀ C : irreducibleComponents Y₀,
      μ₀ (componentGenericPoint Y₀ C) ∉ G.supp :=
    fun G => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ G
  -- `mD • A = (m * mD) • N + (-m) • D₀` on `X`
  have hX : (mD : ℤ) • A = ((m * mD : ℕ) : ℤ) • N + (-(m : ℤ)) • D₀ := by
    apply Divisor.toQDivisor_injective
    rw [map_zsmul, hAeq, map_add, map_zsmul, map_zsmul, hD₀, smul_smul]
    push_cast
    module
  have h1 := hAμ.zsmul hAc (mD : ℤ) (hs _)
  have h2 := (hNpb.zsmul hN ((m * mD : ℕ) : ℤ) (hs _)).add (hcart _) ((hcart _).zsmul _) (hs _)
    (hD₀'.zsmul hD₀c (-(m : ℤ)) (hs _))
  rw [← hX] at h2
  have h3 := Divisor.IsPullback.eq (hAc.zsmul _) h1 h2
  have h4 := congrArg Divisor.toQDivisor h3
  rw [map_zsmul, map_add, map_zsmul, map_zsmul, hD₀'eq] at h4
  have hmD0 : ((mD : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
  ext P
  have h5 := congrArg (fun G : QDivisor Y₀ => G.coeff P) h4
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, zsmul_eq_mul,
    smul_eq_mul, DivisorWithCoeffs.coeff_sub] at h5 ⊢
  push_cast at h5 ⊢
  apply mul_left_cancel₀ hmD0
  push_cast
  linear_combination h5

/-- **The boundary of the Kawamata–Viehweg application.** On a log resolution `μ₀` of `Δ + D`
which is an isomorphism away from `Supp D`, with `Γ` the zero places of `(X, Δ)` (the strict
transform of `Δ`), `F = μ₀^*D` and `N - D` `f`-ample, there is an effective snc `ℚ`-divisor `B`
with coefficients `< 1`, namely `(1 - ε)Γ + {F} + δF_exc` for an antiample exceptional `F_exc`,
such that `L - (K_Y + B) = μ₀^*(N - D) + εΓ - δF_exc` is ample over `X` and over every `Z'`
over which `X` is projective with `f`-ample divisors ample over `Z'`, where
`L = K_Y + Γ + μ₀^*N - ⌊F⌋`. -/
private theorem exists_boundary_hasRelativelyAmpleMultiple [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (N : Divisor X)
    (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f)
    (KY : Divisor Y₀)
    (hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp)
    (Nμ : Divisor Y₀) (hNpb : N.IsPullback μ₀ hNμ Nμ) {Z' : Scheme.{0}} (g : X ⟶ Z')
    (hg : IsProjectiveMorphism g) [IsAffine Z'] :
    ∃ B : QDivisor Y₀, B.IsEffective ∧ DivisorWithCoeffs.IsSNC (μ₀ ≫ sX) B ∧
      (∀ E : MMP.Mori.PrimeDivisor Y₀, B.coeff E < 1) ∧
      (Divisor.toQDivisor (KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown
          (QDivisor.toRDivisor F)) - (Divisor.toQDivisor KY + B)).HasRelativelyAmpleMultiple μ₀ ∧
      (Divisor.toQDivisor (KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown
          (QDivisor.toRDivisor F)) - (Divisor.toQDivisor KY + B)).HasRelativelyAmpleMultiple
        (μ₀ ≫ g) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  have hp₀ : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  haveI : UniversallyClosed μ₀ := hp₀.toUniversallyClosed
  haveI : QuasiCompact μ₀ := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hpg : IsProper g := isProper_of_isProjectiveMorphism g hg
  haveI : UniversallyClosed g := hpg.toUniversallyClosed
  haveI : QuasiCompact g := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hpf : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI : UniversallyClosed f := hpf.toUniversallyClosed
  haveI : QuasiCompact f := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hsmY : IsSmoothScheme (μ₀ ≫ sX) := hlog.isSmoothScheme
  have hQF : MMP.Fourfold.IsQFactorial sX := ⟨hX, fun D' => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hsm D'⟩⟩
  obtain ⟨Fexc, e, he, hFexc0, hFexcEx, Dexc, hDexc, hDexceq, hDexcamp⟩ :=
    MMP.Mori.exists_isRelativelyAmple_neg_smul_of_isExceptional sX (μ₀ ≫ sX) hQF hY μ₀ rfl
      hlog.isProjectiveMorphism hμ
  obtain ⟨mN, hmN, A, hAc, hAeq, hAamp⟩ := hND
  haveI := hAc.isInvertibleModule_divisorialSheaf
  have hAX : Stacks.Ample.IsAmple X A.divisorialSheaf :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f _
      (stacks_of_isRelativelyAmple f _ hAamp)
  have hAμs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ A
  obtain ⟨Aμ, hAμ⟩ := hAc.exists_isPullback hAμs
  have hAμeq := toQDivisor_pullback_eq sX μ₀ hsm hD hF hN hNpb hAc hAeq hAμ
  have hΓc : Γ.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY Γ
  obtain ⟨r, hr, hr0⟩ := ((eventually_isRelativelyAmpleCartier_nsmul_add μ₀
    (isRelativelyAmpleCartier_of_isRelativelyAmple μ₀ hDexc.neg hDexcamp) hΓc).and
      (Filter.eventually_gt_atTop 0)).exists
  have hCc : (r • (-Dexc) + Γ).IsCartier := hr.choose
  have hCamp : (r • (-Dexc) + Γ).IsRelativelyAmple μ₀ hCc :=
    isRelativelyAmple_of_isRelativelyAmpleCartier μ₀ hr
  obtain ⟨n₁, hn₁⟩ := exists_isRelativelyAmple_add_nsmul μ₀ (𝟙 X) hCc hCamp hAc
    (isRelativelyAmple_id_of_isAmple hAc hAX) hAμ
  obtain ⟨n₂, hn₂⟩ := exists_isRelativelyAmple_add_nsmul μ₀ g hCc hCamp hAc
    (isRelativelyAmple_of_isAmple_of_isAffine g hAc hAX) hAμ
  -- the fractional part of `F`
  set R := MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hR
  have hRc : ∀ P, (R.coeff P : ℚ) = ⌊F.coeff P⌋ := fun P => by
    rw [hR, MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor,
      Rat.floor_cast]
  set fr := F - Divisor.toQDivisor R with hfr
  have hfrc : ∀ P, fr.coeff P = F.coeff P - ⌊F.coeff P⌋ := fun P => by
    rw [hfr, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, hRc]
  have hfr0 : ∀ P, 0 ≤ fr.coeff P := fun P => by rw [hfrc]; exact Int.fract_nonneg _
  have hfr1 : ∀ P, fr.coeff P < 1 := fun P => by rw [hfrc]; exact Int.fract_lt_one _
  -- the numbers
  set t : ℚ := ∑ P ∈ Fexc.support, Fexc.coeff P / (1 - fr.coeff P) with ht
  have ht0 : ∀ P ∈ Fexc.support, Fexc.coeff P / (1 - fr.coeff P) ≤ t := fun P hP =>
    Finset.single_le_sum (f := fun P => Fexc.coeff P / (1 - fr.coeff P))
      (fun Q _ => div_nonneg (hFexc0 Q) (by linarith [hfr1 Q])) hP
  set q : ℕ := n₁ + n₂ + ⌈t⌉₊ + 1 with hq
  have hq0 : 0 < q := by omega
  have hqt : t < q := by
    have := Nat.le_ceil t
    rw [hq]; push_cast; linarith [Nat.cast_nonneg (α := ℚ) (n₁ + n₂)]
  set n : ℕ := e * r * q with hn
  have hn₁n : n₁ ≤ n := by
    have : 1 ≤ e * r := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero he.ne' hr0.ne')
    nlinarith
  have hn₂n : n₂ ≤ n := by
    have : 1 ≤ e * r := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero he.ne' hr0.ne')
    nlinarith
  set c : ℕ := mN * e * r * q with hc
  have hc0 : 0 < c := by positivity
  set δ : ℚ := 1 / (mN * q) with hδ
  set ε : ℚ := 1 / c with hε
  have hδ0 : 0 ≤ δ := by positivity
  have hε0 : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [hε, div_le_one (by exact_mod_cast hc0)]; exact_mod_cast hc0
  have hδt : δ * t < 1 := by
    rw [hδ, one_div_mul_eq_div, div_lt_one (by positivity)]
    calc t < q := hqt
      _ ≤ mN * q := by
        have : (1 : ℚ) ≤ mN := by exact_mod_cast hmN
        nlinarith [Nat.cast_nonneg (α := ℚ) q]
  set B : QDivisor Y₀ := (1 - ε) • Divisor.toQDivisor Γ + fr + δ • Fexc with hBdef
  have hBc : ∀ P, B.coeff P = (1 - ε) * Γ.coeff P + fr.coeff P + δ * Fexc.coeff P := fun P => by
    simp [hBdef, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul]
  have hΓ01 := hΓ.1
  refine ⟨B, fun P => ?_, ?_, fun P => ?_, ?_, ?_⟩
  · -- effective
    rw [hBc]
    have h1 : (0 : ℚ) ≤ (1 - ε) * Γ.coeff P := by
      rcases hΓ01 P with h | h <;> rw [h] <;> push_cast <;> linarith
    have h2 := hfr0 P
    have h3 : 0 ≤ δ * Fexc.coeff P := mul_nonneg hδ0 (hFexc0 P)
    linarith
  · -- snc
    refine isSNC_of_support_subset sX μ₀ hX hsm hΔ hD0 hlog hY hμ hD hΓ hF B fun P hP => ?_
    by_contra hcon
    push Not at hcon
    obtain ⟨hΓP, hFP, hEP⟩ := hcon
    apply hP
    rw [hBc, hΓP, hfrc, hFP]
    have : Fexc.coeff P = 0 := by
      by_contra h
      exact hEP (hFexcEx P h)
    rw [this]; simp
  · -- coefficients `< 1`
    rw [hBc]
    rcases hΓ01 P with hΓP | hΓP
    · rw [hΓP]
      by_cases hP : Fexc.coeff P = 0
      · rw [hP]; simp only [Int.cast_zero, mul_zero, zero_add, add_zero]; exact hfr1 P
      · have hmem : P ∈ Fexc.support := Finsupp.mem_support_iff.2 hP
        have h1 := ht0 P hmem
        have hpos : 0 < 1 - fr.coeff P := by linarith [hfr1 P]
        have h2 : Fexc.coeff P ≤ t * (1 - fr.coeff P) := by
          rwa [div_le_iff₀ hpos] at h1
        have h3 : δ * Fexc.coeff P ≤ δ * t * (1 - fr.coeff P) := by
          rw [mul_assoc]; exact mul_le_mul_of_nonneg_left h2 hδ0
        have h4 : δ * t * (1 - fr.coeff P) < 1 - fr.coeff P := by
          nlinarith
        simp only [Int.cast_zero, mul_zero, zero_add]
        linarith
    · obtain ⟨hF0, hnex⟩ := coeff_eq_zero_of_coeff_zeroLogDiscrepancy sX μ₀ hX hsm hΔ hDns hY hμ
        hD hΓ hF hiso P hΓP
      have hE0 : Fexc.coeff P = 0 := by
        by_contra h
        exact hnex (hFexcEx P h)
      rw [hΓP, hfrc, hF0, hE0]
      simp only [Int.cast_one, mul_one, Int.floor_zero, Int.cast_zero, sub_zero, mul_zero,
        add_zero]
      linarith
  all_goals
    have hLc : (r • (-Dexc) + Γ + n • Aμ).IsCartier := hCc.add ((hAμ.isCartier hAc).nsmul n)
    have heq : Divisor.toQDivisor (r • (-Dexc) + Γ + n • Aμ) =
        ((c : ℕ) : ℤ) • (Divisor.toQDivisor (KY + Γ + Nμ - R) - (Divisor.toQDivisor KY + B)) := by
      ext P
      have hA' : (Aμ.coeff P : ℚ) = mN * (Nμ.coeff P - F.coeff P) := by
        have := congrArg (fun G : QDivisor Y₀ => G.coeff P) hAμeq
        simpa [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub] using this
      have hD' : (Dexc.coeff P : ℚ) = e * Fexc.coeff P := by
        have := congrArg (fun G : QDivisor Y₀ => G.coeff P) hDexceq
        simpa [DivisorWithCoeffs.coeff_smul] using this
      have hfrP := hfrc P
      have hBP := hBc P
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
        DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_neg, nsmul_eq_mul, zsmul_eq_mul,
        Int.cast_add, Int.cast_sub, Int.cast_mul, Int.cast_neg, Int.cast_natCast, smul_eq_mul]
        at hA' hD' ⊢
      rw [hBP, hfrP, hRc, hA', hD', hε, hδ, hc, hn]
      push_cast
      field_simp
      ring
  · refine ⟨c, hc0, _, hLc, heq, ?_⟩
    have h1 := hn₁ n hn₁n
    rw [Category.comp_id] at h1
    exact h1
  · exact ⟨c, hc0, _, hLc, heq, hn₂ n hn₂n⟩

/-- **Local Kawamata–Viehweg on the resolution.** On a log resolution `μ₀` of `Δ + D` which is an
isomorphism away from `Supp D`, for `N - D` `f`-ample and a canonical divisor `K_Y` of `Y₀`, the
higher cohomology of `μ₀_*𝒪_{Y₀}(K_Y + Γ + μ₀^*N - ⌊μ₀^*D⌋)` vanishes. -/
private theorem isZero_rightDerived_pushforward_canonical_local [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (N : Divisor X)
    (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ}
    {KY : Divisor Y₀} (hKY : KY.IsCanonicalDivisor (μ₀ ≫ sX) n)
    (hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp)
    (Nμ : Divisor Y₀) (hNpb : N.IsPullback μ₀ hNμ Nμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward μ₀).rightDerived i).obj (KY + Γ + Nμ -
        MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).divisorialSheaf) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ₀ ≫ sX) := hY.1
  obtain ⟨Z', sZ', g, hZ', hZ'a, hgs, hgp⟩ :=
    exists_isProjectiveMorphism_isAffine_isVariety sX hX.1 f hf
  haveI := hZ'a
  haveI : MMP.Mori.IsVariety k sZ' := hZ'
  set L' := KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
    with hL'
  have hsmY : IsSmoothScheme (μ₀ ≫ sX) := hlog.isSmoothScheme
  have hL'c : L'.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  obtain ⟨B, hB0, hBsnc, hB1, hloc, hglob⟩ := exists_boundary_hasRelativelyAmpleMultiple sX f hf μ₀
    hX hsm hΔ hD0 hDns hlog hY hμ hD hΓ hF hiso N hN hND KY hNμ Nμ hNpb g hgp
  have hR : ∀ j : ℕ, 0 < j →
      IsZero (((Scheme.Modules.pushforward μ₀).rightDerived j).obj L'.divisorialSheaf) :=
    fun j hj => isZero_rightDerived_pushforward_divisorialSheaf_of_ampleGap
      (μ₀ ≫ sX) sX hsmY μ₀ rfl hlog.isProjectiveMorphism hKY hB0 hBsnc hB1 hL'c hloc j hj
  exact hR i hi

/-- **Kawamata–Viehweg on the resolution.** On a log resolution `μ₀` of `Δ + D` which is an
isomorphism away from `Supp D`, for `N - D` `f`-ample and a canonical divisor `K_Y` of `Y₀`, the
higher cohomology of `μ₀_*𝒪_{Y₀}(K_Y + Γ + μ₀^*N - ⌊μ₀^*D⌋)` vanishes. -/
private theorem isZero_rightDerived_pushforward_canonical [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (N : Divisor X)
    (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ}
    {KY : Divisor Y₀} (hKY : KY.IsCanonicalDivisor (μ₀ ≫ sX) n)
    (hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp)
    (Nμ : Divisor Y₀) (hNpb : N.IsPullback μ₀ hNμ Nμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward μ₀).obj (KY + Γ + Nμ -
        MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).divisorialSheaf)) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ₀ ≫ sX) := hY.1
  obtain ⟨Z', sZ', g, hZ', hZ'a, hgs, hgp⟩ :=
    exists_isProjectiveMorphism_isAffine_isVariety sX hX.1 f hf
  haveI := hZ'a
  haveI : MMP.Mori.IsVariety k sZ' := hZ'
  set L' := KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
    with hL'
  have hsmY : IsSmoothScheme (μ₀ ≫ sX) := hlog.isSmoothScheme
  have hL'c : L'.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  obtain ⟨B, hB0, hBsnc, hB1, hloc, hglob⟩ := exists_boundary_hasRelativelyAmpleMultiple sX f hf μ₀
    hX hsm hΔ hD0 hDns hlog hY hμ hD hΓ hF hiso N hN hND KY hNμ Nμ hNpb g hgp
  have hR : ∀ j : ℕ, 0 < j →
      IsZero (((Scheme.Modules.pushforward μ₀).rightDerived j).obj L'.divisorialSheaf) :=
    fun j hj => isZero_rightDerived_pushforward_divisorialSheaf_of_ampleGap
      (μ₀ ≫ sX) sX hsmY μ₀ rfl hlog.isProjectiveMorphism hKY hB0 hBsnc hB1 hL'c hloc j hj
  have hRg : ∀ j : ℕ, 0 < j →
      IsZero (((Scheme.Modules.pushforward (μ₀ ≫ g)).rightDerived j).obj L'.divisorialSheaf) :=
    fun j hj => isZero_rightDerived_pushforward_divisorialSheaf_of_ampleGap
      (μ₀ ≫ sX) sZ' hsmY (μ₀ ≫ g) (by rw [Category.assoc, hgs])
      (hlog.isProjectiveMorphism.comp hgp) hKY hB0 hBsnc hB1 hL'c hglob j hj
  have hpg : IsProper (μ₀ ≫ g) :=
    isProper_of_isProjectiveMorphism _ (hlog.isProjectiveMorphism.comp hgp)
  haveI : UniversallyClosed (μ₀ ≫ g) := hpg.toUniversallyClosed
  haveI : IsSeparated (μ₀ ≫ g) := hpg.toIsSeparated
  haveI : QuasiCompact (μ₀ ≫ g) := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  haveI : QuasiSeparated (μ₀ ≫ g) := AlgebraicGeometry.IsSeparated.instQuasiSeparated _
  have hY0 : ∀ j : ℕ, 0 < j →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y₀).rightDerived j).obj
        L'.divisorialSheaf) :=
    fun j hj => isZero_rightDerived_of_isZero_pushforward (μ₀ ≫ g) _ j (hRg j hj)
  exact isZero_rightDerived_pushforward_of_isZero μ₀ _ hR hY0 i hi

/-- **Vanishing on a resolution which is an isomorphism away from `Supp D`.** On such a log
resolution `μ₀` the adjoint ideal is `μ₀_*𝒪_{Y₀}(G₀)` for `G₀ = E - ⌊μ₀^*D⌋`, and the higher
cohomology of `μ₀_*𝒪_{Y₀}(G₀ + μ₀^*M)` vanishes for every Cartier `M ∼ K_X + Δ + N` with
`N - D` `f`-ample. -/
private theorem exists_vanishing_of_isIso_compl_supp [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X)
    {J₀ : X.Opens → Set X.functionField} (hJ₀ : IsReducedAdjointIdealOn sX Δ D μ₀ J₀)
    (hiso : IsIso (μ₀ ∣_ D.supp.compl)) :
    ∃ (_ : IsIntegral Y₀) (_ : IsLocallyNoetherian Y₀) (_ : IsNormal Y₀) (_ : IsDominant μ₀)
      (G₀ : Divisor Y₀), J₀ = MMP.Intersection.multiplierIdealSections μ₀ G₀ ∧
      ∀ (N : Divisor X), N.IsCartier →
        (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f →
        ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
        ∀ (M : Divisor X), M.IsCartier → M.LinearlyEquivalent (K + Δ + N) →
        ∀ (hMμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ M.supp)
          (Mμ : Divisor Y₀), M.IsPullback μ₀ hMμ Mμ →
        ∀ i : ℕ, 0 < i →
          IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
            ((Scheme.Modules.pushforward μ₀).obj (G₀ + Mμ).divisorialSheaf)) := by
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, i1, i2, i3, i4, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ :=
    hJ₀
  refine ⟨i1, i2, i3, i4, _, rfl, ?_⟩
  intro N hN hND n K hK M hMc hMK hMμ Mμ hMpb i hi
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  have hNμ := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ N
  obtain ⟨Nμ, hNpb⟩ := hN.exists_isPullback hNμ
  obtain ⟨KY, hKY, hlin⟩ := exists_isCanonicalDivisor_linearlyEquivalent sX μ₀ hX hsm hY hμ
    hlog.isSmoothScheme hE N hN hK M hMc hMK hMμ Mμ hMpb hNμ Nμ hNpb
  set R := MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
  have hlin' : (E - R + Mμ).LinearlyEquivalent (KY + Γ + Nμ - R) := by
    have h := hlin.add (Divisor.LinearlyEquivalent.refl (-R))
    rw [show E - R + Mμ = E + Mμ + -R by abel, show KY + Γ + Nμ - R = KY + Γ + Nμ + -R by abel]
    exact h
  exact IsZero.of_iso (isZero_rightDerived_pushforward_canonical sX f hf μ₀ hX hsm hΔ hD0 hDns hlog
      hY hμ hD hΓ hF hiso N hN hND hKY hNμ Nμ hNpb i hi)
    (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).mapIso
      ((Scheme.Modules.pushforward μ₀).mapIso hlin'.divisorialSheafIso))

/-- **Local vanishing on a resolution which is an isomorphism away from `Supp D`.** On such a log
resolution `μ₀`, with `(Γ, E, F)` the data of `𝒥_{Δ,D}`, the higher direct images of
`𝒪_{Y₀}(E - ⌊F⌋ + μ₀^*M)` vanish for every Cartier `M ∼ K_X + Δ + N` with `N - D` `f`-ample. -/
private theorem isZero_rightDerived_pushforward_of_isIso_compl_supp [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ E : Divisor Y₀} {F : QDivisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ₀ hY hμ Δ Γ E) (hF : D.IsPullback μ₀ hD F)
    (hiso : IsIso (μ₀ ∣_ D.supp.compl))
    (N : Divisor X) (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    (M : Divisor X) (hMc : M.IsCartier) (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ M.supp)
    (Mμ : Divisor Y₀) (hMpb : M.IsPullback μ₀ hMμ Mμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward μ₀).rightDerived i).obj
      (E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) + Mμ).divisorialSheaf) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  have hNμ := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ N
  obtain ⟨Nμ, hNpb⟩ := hN.exists_isPullback hNμ
  obtain ⟨KY, hKY, hlin⟩ := exists_isCanonicalDivisor_linearlyEquivalent sX μ₀ hX hsm hY hμ
    hlog.isSmoothScheme hE N hN hK M hMc hMK hMμ Mμ hMpb hNμ Nμ hNpb
  set R := MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
  have hlin' : (E - R + Mμ).LinearlyEquivalent (KY + Γ + Nμ - R) := by
    have h := hlin.add (Divisor.LinearlyEquivalent.refl (-R))
    rw [show E - R + Mμ = E + Mμ + -R by abel, show KY + Γ + Nμ - R = KY + Γ + Nμ + -R by abel]
    exact h
  exact IsZero.of_iso (isZero_rightDerived_pushforward_canonical_local sX f hf μ₀ hX hsm hΔ hD0
      hDns hlog hY hμ hD hΓ hF hiso N hN hND hKY hNμ Nμ hNpb i hi)
    (((Scheme.Modules.pushforward μ₀).rightDerived i).mapIso hlin'.divisorialSheafIso)

/-- **Vanishing for the twisted adjoint ideal.** For `f : X ⟶ Z` projective with `Z` affine, an
integral Cartier `N` with `N - D` `f`-ample and a Cartier `M ∼ K_X + Δ + N`, the higher
cohomology of `μ_*𝒪_Y(G + μ^*M) = 𝒥_{Δ,D}(K_X + Δ + N)` vanishes. -/
private theorem isZero_rightDerived_twist [IsAlgClosed k] [CharZero k] [CompactSpace X]
    {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] {Δ : Divisor X}
    {D : QDivisor X} {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsDominant μ] {J : X.Opens → Set X.functionField}
    (hJ : IsReducedAdjointIdealOn sX Δ D μ J) (G : Divisor Y)
    (hG : J = MMP.Intersection.multiplierIdealSections μ G) (N : Divisor X) (hN : N.IsCartier)
    (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (M : Divisor X) (hMc : M.IsCartier)
    (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMpb : M.IsPullback μ hMμ Mμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward μ).obj (G + Mμ).divisorialSheaf)) := by
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, -, -, -, -, hY, hμ, -⟩ := id hJ
  -- an ample invertible sheaf on `X`
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hND
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI := hLc.isInvertibleModule_divisorialSheaf
  have hLX : Stacks.Ample.IsAmple X L.divisorialSheaf :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f _
      (stacks_of_isRelativelyAmple f _ hLamp)
  -- the good resolution
  obtain ⟨Y₀, μ₀, hlog₀, hiso⟩ :=
    exists_isLogResolution_isIso_compl_supp sX hX hsm hΔ D hD0 L.divisorialSheaf hLX
  obtain ⟨J₀, hJ₀⟩ :=
    exists_isReducedAdjointIdealOn_of_isLogResolution sX Δ D hX hsm hΔ hD0 hDns μ₀ hlog₀
  have hJJ₀ : J = J₀ :=
    (MMP.Fourfold.isReducedAdjointIdealOn_operations sX).2.2.1 Δ D μ μ₀ J J₀ hJ hJ₀
  obtain ⟨_, _, _, _, G₀, hG₀, hvan⟩ := exists_vanishing_of_isIso_compl_supp sX f hf μ₀ hJ₀ hiso
  haveI : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog₀.isProjectiveMorphism
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  obtain ⟨Mμ₀, hMμ₀⟩ := hMc.exists_isPullback
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ M)
  have hsec : MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ₀ (G₀ + Mμ₀) :=
    multiplierIdealSections_add_pullback_congr hMc hMpb hMμ₀ (hG.symm.trans (hJJ₀.trans hG₀))
  obtain ⟨e⟩ := nonempty_iso_pushforward_of_multiplierIdealSections_eq μ μ₀
    hμ.functionFieldMap_bijective hlog₀.isBirationalMorphism.functionFieldMap_bijective _ _ hsec
  exact IsZero.of_iso (hvan N hN ⟨m, hm, L, hLc, hLeq, hLamp⟩ n K hK M hMc hMK _ Mμ₀ hMμ₀ i hi)
    (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).mapIso e)

end Vanishing

/-! ### The strict transform of a prime divisor -/

section StrictTransform

variable {X Y : Scheme.{0}}

/-- A point of an open `V` over which `μ` is an isomorphism is the image of a point of the same
coheight. -/
private theorem exists_map_eq_coheight_eq (μ : Y ⟶ X) {V : X.Opens} (hV : IsIso (μ ∣_ V))
    {x : X} (hx : x ∈ V) : ∃ y : Y, μ y = x ∧ Order.coheight y = Order.coheight x := by
  let y : (μ ⁻¹ᵁ V).toScheme := (inv (μ ∣_ V)) ⟨x, hx⟩
  have hy : μ y.1 = x := by
    have h1 : (μ ∣_ V) y = ⟨x, hx⟩ := by
      change ((inv (μ ∣_ V)) ≫ (μ ∣_ V)) ⟨x, hx⟩ = _
      rw [IsIso.inv_hom_id]; rfl
    have h2 := congrArg Subtype.val h1
    rwa [morphismRestrict_base_coe] at h2
  refine ⟨y.1, hy, ?_⟩
  have hb : μ y.1 ∈ MMP.Mori.biregularLocus μ := MMP.Mori.le_biregularLocus hV (by rw [hy]; exact hx)
  rw [← MMP.Positivity.coheight_map_of_mem_biregularLocus μ hb, hy]

/-- **The strict transform.** A prime divisor `S` of `X` whose generic point lies in an open
over which `μ` is an isomorphism has a strict transform: a prime divisor `T` of `Y` with
`μ(η_T) = η_S`, with ideal sheaf the vanishing ideal of the closure of `η_T`. -/
private theorem exists_primeDivisor_map_genericPoint_eq (μ : Y ⟶ X) {V : X.Opens}
    (hV : IsIso (μ ∣_ V)) (S : MMP.Mori.PrimeDivisor X) (hS : S.genericPoint ∈ V) :
    ∃ T : MMP.Mori.PrimeDivisor Y, μ T.genericPoint = S.genericPoint ∧
      T.idealSheaf = Scheme.IdealSheafData.vanishingIdeal
        (Closeds.closure ({T.genericPoint} : Set Y)) := by
  obtain ⟨y, hy, hcoh⟩ := exists_map_eq_coheight_eq μ hV hS
  rw [S.coheight_genericPoint] at hcoh
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne y hcoh, ?_, ?_⟩
  · change μ (AlgebraicGeometry.PrimeDivisor.genericPoint _) = _
    rw [AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]; exact hy
  · change _ = Scheme.IdealSheafData.vanishingIdeal
      (Closeds.closure {AlgebraicGeometry.PrimeDivisor.genericPoint _})
    rw [AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]; rfl

/-- `μ` maps the strict transform `T` of `S` into `S`. -/
private theorem le_map_idealSheaf (μ : Y ⟶ X) (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (hTI : T.idealSheaf = Scheme.IdealSheafData.vanishingIdeal
      (Closeds.closure ({T.genericPoint} : Set Y))) :
    S.idealSheaf ≤ T.idealSheaf.map μ := by
  rw [hTI, Scheme.IdealSheafData.map_vanishingIdeal,
    ← Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal, Closeds.closure_le]
  rintro _ ⟨y, hy, rfl⟩
  have hsp : T.genericPoint ⤳ y := specializes_iff_mem_closure.2 hy
  have := hsp.map μ.continuous
  rw [hT] at this
  change μ y ∈ (S.support : Set X)
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact specializes_iff_mem_closure.1 this

/-- The restriction `μ_T : T ⟶ S` of `μ` to a strict transform maps the generic point to the
generic point. -/
private theorem map_genericPoint_strictTransform (μ : Y ⟶ X) (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    haveI := S.integral; haveI := T.integral
    μT (genericPoint T.idealSheaf.subscheme) = genericPoint S.idealSheaf.subscheme := by
  haveI := S.integral; haveI := T.integral
  apply S.idealSheaf.subschemeι.isClosedEmbedding.injective
  change (μT ≫ S.idealSheaf.subschemeι) _ = S.genericPoint
  rw [hμT]
  exact hT

/-- The restriction `μ_T : T ⟶ S` of a proper `μ` to a strict transform is proper and
surjective. -/
private theorem isProper_surjective_strictTransform (μ : Y ⟶ X) [IsProper μ]
    (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    IsProper μT ∧ Surjective μT := by
  haveI := S.integral; haveI := T.integral
  have hp : IsProper μT := by
    have : IsProper (μT ≫ S.idealSheaf.subschemeι) := by rw [hμT]; infer_instance
    exact IsProper.of_comp μT S.idealSheaf.subschemeι
  refine ⟨hp, ?_⟩
  have hd : IsDominant μT := by
    refine ⟨?_⟩
    have hg := map_genericPoint_strictTransform μ S T hT μT hμT
    refine Dense.mono (Set.singleton_subset_iff.2 ⟨_, hg⟩) ?_
    exact dense_iff_closure_eq.2 (genericPoint_spec S.idealSheaf.subscheme)
  exact surjective_of_isDominant_of_isClosed_range μT μT.isClosedMap.isClosed_range

/-- The restriction `μ_T : T ⟶ S` of `μ` to a strict transform is an isomorphism over every open
`V` over which `μ` is. -/
private theorem isIso_morphismRestrict_strictTransform (μ : Y ⟶ X) [IsProper μ] {V : X.Opens}
    (hV : IsIso (μ ∣_ V)) (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    IsIso (μT ∣_ (S.idealSheaf.subschemeι ⁻¹ᵁ V)) := by
  haveI := S.integral; haveI := T.integral
  have hci : IsClosedImmersion ((μT ≫ S.idealSheaf.subschemeι) ∣_ V) := by
    have key : ∀ h : T.idealSheaf.subscheme ⟶ X, h = T.idealSheaf.subschemeι ≫ μ →
        IsClosedImmersion (h ∣_ V) := by
      rintro h rfl
      rw [morphismRestrict_comp]
      haveI := hV
      haveI : IsClosedImmersion (T.idealSheaf.subschemeι ∣_ (μ ⁻¹ᵁ V)) :=
        IsZariskiLocalAtTarget.restrict (P := @IsClosedImmersion) inferInstance _
      exact @IsClosedImmersion.comp _ _ _ _ _ this inferInstance
    exact key _ hμT
  rw [morphismRestrict_comp] at hci
  haveI : IsClosedImmersion (μT ∣_ (S.idealSheaf.subschemeι ⁻¹ᵁ V)) :=
    @IsClosedImmersion.of_comp _ _ _ _ (S.idealSheaf.subschemeι ∣_ V) hci inferInstance
  obtain ⟨_, hs⟩ := isProper_surjective_strictTransform μ S T hT μT hμT
  haveI : Surjective (μT ∣_ (S.idealSheaf.subschemeι ⁻¹ᵁ V)) := inferInstance
  exact isIso_of_isClosedImmersion_of_surjective _

/-- The restriction `μ_T : T ⟶ S` of an H-projective `μ` to a strict transform is H-projective. -/
private theorem isProjectiveMorphism_strictTransform (μ : Y ⟶ X) (hμp : IsProjectiveMorphism μ)
    (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    IsProjectiveMorphism μT := by
  refine IsProjectiveMorphism.of_comp μT S.idealSheaf.subschemeι ?_
  rw [hμT]
  obtain ⟨n, j, hj, rfl⟩ := hμp
  have := hj
  exact ⟨n, T.idealSheaf.subschemeι ≫ j, inferInstance, Category.assoc _ _ _⟩

/-- The restriction `μ_T : T ⟶ S` of a proper `μ` to a strict transform is birational when `μ` is
an isomorphism over an open containing the generic point of `S`. -/
private theorem isBirationalMorphism_strictTransform (μ : Y ⟶ X) [IsProper μ] {V : X.Opens}
    (hV : IsIso (μ ∣_ V)) (S : MMP.Mori.PrimeDivisor X) (hSV : S.genericPoint ∈ V)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    IsBirationalMorphism μT := by
  haveI := S.integral; haveI := T.integral
  haveI := isIso_morphismRestrict_strictTransform μ hV S T hT μT hμT
  set W := S.idealSheaf.subschemeι ⁻¹ᵁ V
  have hW : ((W : S.idealSheaf.subscheme.Opens) : Set S.idealSheaf.subscheme).Nonempty :=
    ⟨genericPoint _, hSV⟩
  obtain ⟨y, hy⟩ := hW
  have hV' : ((μT ⁻¹ᵁ W : T.idealSheaf.subscheme.Opens) : Set _).Nonempty :=
    ⟨((inv (μT ∣_ W)) ⟨y, hy⟩).1, ((inv (μT ∣_ W)) ⟨y, hy⟩).2⟩
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE μT (μT ⁻¹ᵁ W) W hV' ⟨y, hy⟩ le_rfl ?_
  rw [Scheme.Hom.resLE_eq_morphismRestrict]
  infer_instance

end StrictTransform

/-! ### Restriction to a smooth prime divisor as a pull-back -/

section RestrictionPullback

open MMP.Mori MMP.Mori.Divisor Classical

private theorem algebraMap_stalkSpecializes {X : Scheme.{0}} [IsIntegral X] {x x' : X} (h : x' ⤳ x)
    (c : X.presheaf.stalk x) :
    algebraMap _ X.functionField (X.presheaf.stalkSpecializes h c) =
      algebraMap _ X.functionField c := by
  simp only [RingHom.algebraMap_toAlgebra]
  rw [← ConcreteCategory.comp_apply, TopCat.Presheaf.stalkSpecializes_comp]

section Pullback

open MMP.Mori Classical

/-- The generic point of an irreducible component has coheight zero. -/
private theorem coheight_componentGenericPoint {X : Scheme.{0}} (Z : irreducibleComponents X) :
    Order.coheight (componentGenericPoint X Z) = 0 := by
  rw [Order.coheight_eq_zero]
  intro b (hb : b ⤳ _)
  have hZ := (isGenericPoint_componentGenericPoint X Z).def
  refine specializes_iff_closure_subset.mpr ?_
  rw [hZ]
  exact Z.2.2 isIrreducible_singleton.closure (hZ ▸ hb.closure_subset)

/-- In an irreducible space there is only one irreducible component. -/
private theorem irreducibleComponents_eq {X : Scheme.{0}} [IrreducibleSpace X]
    (Z W : irreducibleComponents X) : Z = W :=
  Subtype.ext <| by
    have hZ := Z.2; have hW := W.2
    simp only [irreducibleComponents_eq_singleton, Set.mem_singleton_iff] at hZ hW
    rw [hZ, hW]

/-- On an integral scheme, `v_Γ` of a unit of the function field of the component is the
order of vanishing `AlgebraicGeometry.Scheme.ord` of its image in the function field. -/
private theorem ordUnit_eq_ord {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (Γ : MMP.Mori.PrimeDivisor X)
    (v : (X.presheaf.stalk (componentGenericPoint X Γ.component))ˣ) :
    Γ.ordUnit v = X.ord ((X.presheaf.stalkSpecializes
        (((genericPoint_spec X).specializes trivial :
          genericPoint X ⤳ componentGenericPoint X Γ.component))).hom v) Γ.genericPoint := by
  set g := (X.presheaf.stalkSpecializes
        (((genericPoint_spec X).specializes trivial :
          genericPoint X ⤳ componentGenericPoint X Γ.component))).hom
  have hne : g v ≠ 0 := (v.isUnit.map g).ne_zero
  symm
  rw [Scheme.ord_eq_iff Γ.coheight_genericPoint hne]
  have : Ring.KrullDimLE 1 Γ.localRing := krullDimLE_of_coheight_le Γ.coheight_genericPoint.le
  have h := Γ.valuation_eq_exp_ordUnit v
  rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac] at h
  unfold Scheme.ordHom
  convert h using 1
  rfl

variable {k : Type} [Field k] {Y T : Scheme.{0}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]
  [IsLocallyNoetherian Y] [IsNormal Y] [Smooth sY] (j : T ⟶ Y) [IsClosedImmersion j]
  [IsIntegral T] [IsLocallyNoetherian T] [IsNormal T] [Smooth (j ≫ sY)]

include sY in
/-- **Restricting a quotient of germs.** Let `Q` be a prime divisor of `T` and `a, b ∈ 𝒪_{Y,y}`,
`y = j(η_Q)`, with nonzero restrictions to `𝒪_{T,Q}`. If `D` has coefficient
`v_E(a) - v_E(b)` along every prime divisor `E` of `Y` through `y`, then
`∑_E length(𝒪_{T,Q}/I_E 𝒪_{T,Q}) · D_E = v_Q(a|_T) - v_Q(b|_T)`. -/
private theorem sum_intersectionLength_smul_eq_ord_sub (Q : MMP.Mori.PrimeDivisor T)
    (D : Divisor Y) (a b : Y.presheaf.stalk (j Q.genericPoint))
    (ha : (j.stalkMap Q.genericPoint).hom a ≠ 0) (hb : (j.stalkMap Q.genericPoint).hom b ≠ 0)
    (hD : ∀ E : MMP.Mori.PrimeDivisor Y, j Q.genericPoint ∈ E.support →
      D.coeff E = Y.ord (algebraMap _ Y.functionField a) E.genericPoint -
        Y.ord (algebraMap _ Y.functionField b) E.genericPoint) :
    (D.sum fun E d => E.intersectionLength j Q • d) =
      T.ord (algebraMap _ T.functionField ((j.stalkMap Q.genericPoint).hom a)) Q.genericPoint -
        T.ord (algebraMap _ T.functionField ((j.stalkMap Q.genericPoint).hom b))
          Q.genericPoint := by
  obtain ⟨Sa, -, hfa⟩ := Q.ord_stalkMap_eq_sum_intersectionLength_mul_ord sY j a ha
  obtain ⟨Sb, -, hfb⟩ := Q.ord_stalkMap_eq_sum_intersectionLength_mul_ord sY j b hb
  set S := D.support ∪ Sa ∪ Sb
  rw [hfa S (by intro E hE; simp [S, hE]), hfb S (by intro E hE; simp [S, hE]),
    ← Finset.sum_sub_distrib, Finsupp.sum, Finset.sum_subset (s₂ := S)
      (by intro E hE; simp [S, hE]) (by intro E _ hE; simp [Finsupp.notMem_support_iff.mp hE])]
  refine Finset.sum_congr rfl fun E _ => ?_
  split_ifs with hE
  · rw [nsmul_eq_mul, ← mul_sub, ← hD E hE]; rfl
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem j E hE, zero_smul, sub_zero]

include sY in
/-- **The restriction is the pull-back.** If the coefficient of every prime divisor `Q` of `T`
in `D` is `∑_E β_E · length(𝒪_{T,Q}/I_E 𝒪_{T,Q})`, then `D` is the pull-back `j^* B`. -/
private theorem isPullback_of_coeff_eq (B : Divisor Y)
    (hB : ∀ Z : irreducibleComponents T, j (componentGenericPoint T Z) ∉ B.supp)
    (D : Divisor T)
    (hD : ∀ Q : MMP.Mori.PrimeDivisor T,
      D.coeff Q = B.sum fun E d => E.intersectionLength j Q • d) :
    B.IsPullback j hB D := by
  intro U h hh Q hQ
  set x := componentGenericPoint T Q.component
  have hx : j x ∈ U := Q.map_componentGenericPoint_mem j hQ
  have hspT : x ⤳ Q.genericPoint :=
    (isGenericPoint_componentGenericPoint T Q.component).specializes Q.genericPoint_mem_component
  have hspY : j x ⤳ j Q.genericPoint := j.base.hom.map_specializes hspT
  have hyU : j Q.genericPoint ∈ U := (Q.genericPoint_mem_iff (j ⁻¹ᵁ U)).mpr hQ
  -- the unit `a₀` of `𝒪_{Y, j x}` representing `h`
  set a₀ := (hh.exists_unit_stalk hx (hB Q.component) (mem_pointComponent _)).choose with ha₀
  have ha₀spec := (hh.exists_unit_stalk hx (hB Q.component) (mem_pointComponent _)).choose_spec
  rw [← ha₀] at ha₀spec
  have hc : pullbackComponent j hB hh Q.component hx =
      Units.map (j.stalkMap x).hom.toMonoidHom a₀ := rfl
  -- write `a₀ = r / s` with `r, s ∈ 𝒪_{Y,y}`, `s` outside the prime of `F` at `y`
  let q : PrimeSpectrum (Y.presheaf.stalk (j Q.genericPoint)) :=
    ⟨MMP.Intersection.primeOfSpecializes hspY, inferInstance⟩
  letI : Algebra (Y.presheaf.stalk (j Q.genericPoint)) (Y.presheaf.stalk (j x)) :=
    (Y.presheaf.stalkSpecializes hspY).hom.toAlgebra
  haveI := Stacks.Chow.isLocalization_stalk_of_specializes hspY q
    (MMP.Intersection.fromSpecStalk_primeOfSpecializes hspY)
  obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective q.asIdeal.primeCompl
    (a₀ : Y.presheaf.stalk (j x))
  have hrs' : (a₀ : Y.presheaf.stalk (j x)) * Y.presheaf.stalkSpecializes hspY s =
      Y.presheaf.stalkSpecializes hspY r := by
    rw [← hrs]; exact IsLocalization.mk'_spec _ r s
  have hsu : IsUnit (Y.presheaf.stalkSpecializes hspY (s : Y.presheaf.stalk (j Q.genericPoint))) :=
    IsLocalization.map_units (Y.presheaf.stalk (j x)) s
  have hru : IsUnit (Y.presheaf.stalkSpecializes hspY (r : Y.presheaf.stalk (j Q.genericPoint))) :=
    hrs' ▸ a₀.isUnit.mul hsu
  have key : ∀ t, (j.stalkMap x).hom (Y.presheaf.stalkSpecializes hspY t) =
      T.presheaf.stalkSpecializes hspT ((j.stalkMap Q.genericPoint).hom t) := fun t =>
    j.stalkSpecializes_stalkMap_apply x Q.genericPoint hspT t
  have hne0 : ∀ t, IsUnit (Y.presheaf.stalkSpecializes hspY t) →
      (j.stalkMap Q.genericPoint).hom t ≠ 0 := fun t ht h0 => by
    have := ht.map (j.stalkMap x).hom
    rw [key, h0, map_zero] at this
    exact not_isUnit_zero this
  have hr0 := hne0 r hru
  have hs0 := hne0 s hsu
  -- the function-field identities on `T` and on `Y`
  set gT := (T.presheaf.stalkSpecializes
    (((genericPoint_spec T).specializes trivial : genericPoint T ⤳ x))).hom
  have e1 : algebraMap _ T.functionField ((j.stalkMap Q.genericPoint).hom r) =
      gT ((j.stalkMap x).hom a₀) *
        algebraMap _ T.functionField ((j.stalkMap Q.genericPoint).hom s) := by
    have hal : ∀ t, gT (T.presheaf.stalkSpecializes hspT t) = algebraMap _ T.functionField t :=
      fun t => algebraMap_stalkSpecializes hspT t
    have := congrArg (fun t => gT ((j.stalkMap x).hom t)) hrs'
    simp only [map_mul, key, hal] at this
    exact this.symm
  set gY := algebraMap (Y.presheaf.stalk (j x)) Y.functionField
  have e2 : algebraMap _ Y.functionField r =
      gY a₀ * algebraMap _ Y.functionField (s : Y.presheaf.stalk (j Q.genericPoint)) := by
    have := congrArg gY hrs'
    rw [map_mul] at this
    rw [← algebraMap_stalkSpecializes hspY, ← algebraMap_stalkSpecializes hspY]
    exact this.symm
  have e3 : ∀ W : irreducibleComponents Y,
      MMP.Threefold.Mori.Helpers.evalFF W (h : RationalFunctions Y) = gY a₀ := by
    intro W
    obtain rfl : W = pointComponent (j x) := irreducibleComponents_eq _ _
    change (Y.presheaf.stalkSpecializes _).hom ((h : RationalFunctions Y) _) = _
    rw [← ha₀spec]
    change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom _) = _
    rw [← ConcreteCategory.comp_apply, TopCat.Presheaf.stalkSpecializes_comp]
    rfl
  have hgYa : gY a₀ ≠ 0 := (a₀.isUnit.map gY).ne_zero
  have hsne : (s : Y.presheaf.stalk (j Q.genericPoint)) ≠ 0 := fun h0 =>
    hs0 (by rw [h0, map_zero])
  have hsK : algebraMap _ Y.functionField (s : Y.presheaf.stalk (j Q.genericPoint)) ≠ 0 := by
    rw [map_ne_zero_iff _ (IsFractionRing.injective _ _)]; exact hsne
  have hordE : ∀ E : MMP.Mori.PrimeDivisor Y, j Q.genericPoint ∈ E.support →
      B.coeff E = Y.ord (algebraMap _ Y.functionField r) E.genericPoint -
        Y.ord (algebraMap _ Y.functionField (s : Y.presheaf.stalk (j Q.genericPoint)))
          E.genericPoint := by
    intro E hE
    rw [hh E ⟨_, hE, hyU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, e3, e2,
      Scheme.ord_mul hgYa hsK]
    ring
  have hcK : gT ((j.stalkMap x).hom a₀) ≠ 0 := ((a₀.isUnit.map (j.stalkMap x).hom).map gT).ne_zero
  have hsT : algebraMap _ T.functionField
      ((j.stalkMap Q.genericPoint).hom (s : Y.presheaf.stalk (j Q.genericPoint))) ≠ 0 := by
    rw [map_ne_zero_iff _ (IsFractionRing.injective _ _)]; exact hs0
  rw [hD, hc, ordUnit_eq_ord, sum_intersectionLength_smul_eq_ord_sub sY j Q B r s hr0 hs0 hordE,
    e1, Scheme.ord_mul hcK hsT]
  exact add_sub_cancel_right _ _

end Pullback

private theorem mem_irreducibleComponent' {T : Type*} [TopologicalSpace T] [IrreducibleSpace T]
    (W : irreducibleComponents T) (t : T) : t ∈ W.1 := by
  rw [W.2.eq_of_le (IrreducibleSpace.isIrreducible_univ T) (Set.subset_univ _)]
  trivial

/-- **Pull-back of Cartier divisors along a composite**: `g^*(f^*L) = (g ≫ f)^*L`. -/
private theorem isPullback_comp {X Y Z : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral X] [IsLocallyNoetherian Z] [IsNormal Z]
    {f : Y ⟶ X} {g : Z ⟶ Y} {L : Divisor X} {L' : Divisor Y}
    {L'' : Divisor Z} {hB : ∀ W : irreducibleComponents Y, f (componentGenericPoint Y W) ∉ L.supp}
    {hB' : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉ L'.supp}
    (h : L.IsPullback f hB L') (h' : L'.IsPullback g hB' L'')
    (hB'' : ∀ W : irreducibleComponents Z, (g ≫ f) (componentGenericPoint Z W) ∉ L.supp) :
    L.IsPullback (g ≫ f) hB'' L'' := by
  intro U φ hφ E hE
  have hψ := h.isLocalEquation hφ
  rw [h' (f ⁻¹ᵁ U) _ hψ E hE]
  congr 1
  set z := componentGenericPoint Z E.component
  have hzU : f (g z) ∈ U := E.map_componentGenericPoint_mem (g ≫ f) hE
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hzU (hB'' _) (mem_irreducibleComponent'
    (pointComponent ((g ≫ f) z)) _)
  rw [pullbackComponent_eq hB'' hφ hzU _ a ha]
  set W := pointComponent (g z)
  have hspec : componentGenericPoint Y W ⤳ g z :=
    (isGenericPoint_componentGenericPoint Y W).specializes (mem_pointComponent _)
  have hWU : f (componentGenericPoint Y W) ∈ U :=
    (f.base.hom.map_specializes hspec).mem_open U.isOpen hzU
  have hb : (stalkToRationalFunctions Y (mem_pointComponent (g z))).hom
      (Units.map (f.stalkMap (g z)).hom.toMonoidHom a) =
      ((pullbackLocalEquation f hB hφ : (RationalFunctions Y)ˣ) : RationalFunctions Y) W := by
    have e1 := congrArg Units.val (pullbackLocalEquation_apply f hB hφ W hWU)
    refine Eq.trans ?_ e1.symm
    rw [pullbackComponent_eq hB hφ hWU
      (mem_irreducibleComponent' (pointComponent ((g ≫ f) z)) _)
      (Units.map (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom.toMonoidHom a)
      ?_]
    · change (stalkToRationalFunctions Y _).hom ((f.stalkMap (g z)).hom a.val) =
        (f.stalkMap _).hom ((X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom
          a.val)
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, stalkToRationalFunctions,
        Scheme.Hom.stalkSpecializes_stalkMap]
    · change (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec) ≫
        X.presheaf.stalkSpecializes _).hom a.val = _
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact ha
  rw [pullbackComponent_eq hB' hψ _ (mem_pointComponent (g z)) _ hb]
  ext
  change _ = ((g ≫ f).stalkMap z).hom a.val
  rw [Scheme.Hom.stalkMap_comp]
  rfl

/-- The generic points of the components of a prime divisor `P` lie outside the support of every
divisor of which `P` is not a component. -/
private theorem subschemeι_notMem_supp {Y : Scheme.{0}} (B : Divisor Y) (P : MMP.Mori.PrimeDivisor Y)
    (hBP : B.coeff P = 0) :
    ∀ Z : irreducibleComponents P.idealSheaf.subscheme,
      P.idealSheaf.subschemeι (componentGenericPoint _ Z) ∉ B.supp := by
  intro Z hZ
  change _ ∈ ((B.support.sup fun E => E.idealSheaf.support : Closeds Y) : Set Y) at hZ
  rw [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_eq_iSup] at hZ
  simp only [Set.iSup_eq_iUnion, Set.mem_iUnion, Function.comp_apply] at hZ
  obtain ⟨E, hE, hmem⟩ := hZ
  exact DivisorWithCoeffs.forall_notMem_support_primeDivisor B P hBP E hE _
    (coheight_componentGenericPoint Z) hmem

/-- **Restriction to a smooth prime divisor is the pull-back.** On a smooth scheme `Y` over `k`,
for a prime divisor `P` smooth over `k` and a divisor `B` of which `P` is not a component,
`B|_P = ι^* B`. -/
private theorem isPullback_restrictPrimeDivisor {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [Smooth sY] (P : MMP.Mori.PrimeDivisor Y) [IsLocallyNoetherian P.idealSheaf.subscheme]
    [IsNormal P.idealSheaf.subscheme] [Smooth (P.idealSheaf.subschemeι ≫ sY)] (B : Divisor Y)
    (hBP : B.coeff P = 0) :
    haveI := P.integral
    B.IsPullback P.idealSheaf.subschemeι (subschemeι_notMem_supp B P hBP)
      (B.restrictPrimeDivisor P) := by
  haveI := P.integral
  haveI : IsNoetherian Y := ⟨⟩
  exact isPullback_of_coeff_eq sY _ B _ _ (DivisorWithCoeffs.coeff_restrictPrimeDivisor B P hBP)

/-- **Restriction commutes with pull-back to a strict transform.** Let `μ : Y ⟶ X` be a morphism
of smooth schemes over `k`, `T ⊆ Y` and `S ⊆ X` smooth prime divisors with `μ(η_T) = η_S` and
`μ_T : T ⟶ S` the restriction of `μ`. For a Cartier divisor `C` on `X` of which `S` is not a
component, `(μ^*C)|_T = μ_T^*(C|_S)`. -/
private theorem isPullback_restrictPrimeDivisor_of_isPullback {k : Type} [Field k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [Smooth sX] (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] [Smooth (μ ≫ sX)] (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [Smooth (S.idealSheaf.subschemeι ≫ sX)] [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme] [CompactSpace T.idealSheaf.subscheme]
    [Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX)] (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    {C : Divisor X} (hC : C.IsCartier) (hCS : C.coeff S = 0)
    {hCμ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ C.supp}
    {C' : Divisor Y} (hC' : C.IsPullback μ hCμ C') (hC'T : C'.coeff T = 0)
    (hCSμ : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ (C.restrictPrimeDivisor S).supp) :
    Divisor.IsPullback μT (C.restrictPrimeDivisor S) hCSμ (C'.restrictPrimeDivisor T) := by
  haveI := S.integral; haveI := T.integral
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) :=
    (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  have hCSc : Divisor.IsCartier (C.restrictPrimeDivisor S) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmS _
  obtain ⟨D, hD⟩ := hCSc.exists_isPullback (f := μT) hCSμ
  have h1 := isPullback_restrictPrimeDivisor sX S C hCS
  have h2 := isPullback_restrictPrimeDivisor (μ ≫ sX) T C' hC'T
  -- the generic point of `T` maps to that of `S`, outside `Supp C`
  have hηS : S.genericPoint ∉ C.supp := by
    have := subschemeι_notMem_supp C S hCS
      ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩
    rwa [MMP.Threefold.Mori.CanonUniq.componentGenericPoint_eq] at this
  have hgen : ∀ W : irreducibleComponents T.idealSheaf.subscheme,
      (T.idealSheaf.subschemeι ≫ μ) (componentGenericPoint _ W) ∉ C.supp := by
    intro W
    rw [MMP.Threefold.Mori.CanonUniq.componentGenericPoint_eq]
    change μ T.genericPoint ∉ _
    rw [hT]; exact hηS
  have h3 := isPullback_comp hC' h2 hgen
  have h4 : C.IsPullback (μT ≫ S.idealSheaf.subschemeι) (by rw [hμT]; exact hgen) D :=
    isPullback_comp h1 hD _
  have h5 : ∀ g : T.idealSheaf.subscheme ⟶ X, g = T.idealSheaf.subschemeι ≫ μ →
      ∀ hg, C.IsPullback g hg (C'.restrictPrimeDivisor T) := by
    rintro g rfl hg
    exact h3
  have := IsPullback.eq hC h4 (h5 _ hμT _)
  rw [← this]
  exact hD

end RestrictionPullback

/-! ### Log discrepancies computed by one form -/

section FormDiscrepancy

open MMP.Mori

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- **A log discrepancy computed by one form.** For a nonzero rational top form `ω` whose divisor
is canonical, an integral divisor `B` with `div ω + B` Cartier, and a divisor `D = (Y, f, E)` over
`X` with `f` proper, `a(E, X, B) = 1 + ord_E(f^*ω) - coeff_E(f^*(div ω + B))`. -/
private theorem isLogDiscrepancy_of_isPullback [CompactSpace X] [LocallyOfFiniteType sX]
    (hX : IsNormalVariety k sX) {n : ℕ} {ω : RationalPluriForms sX n 1} (hω : ω ≠ 0)
    (hK : (divisorOfForm ω).IsCanonicalDivisor sX n) (B : Divisor X)
    (hC : (divisorOfForm ω + B).IsCartier) (D : DivisorOver k sX) (hp : IsProper D.f)
    (C' : Divisor D.Y)
    (hC' : haveI := D.isLocallyNoetherian; haveI := D.isNormal;
      ∃ hCμ, (divisorOfForm ω + B).IsPullback D.f hCμ C') :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor B) D
      (1 + D.ordPullback ω - C'.coeff D.E) := by
  refine ⟨hX, hp, ω, hω, ⟨_, hK, fun Γ => coeff_divisorOfForm ω Γ⟩, 1, fun _ => 1,
    fun _ => divisorOfForm ω + B, fun _ => C', fun _ => hC, fun Γ => ?_, fun _ => hC', ?_⟩
  · simp only [Finset.univ_unique, Fin.default_eq_zero, Fin.isValue, one_mul,
      Finset.sum_singleton, DivisorWithCoeffs.coeff_add, coeff_divisorOfForm,
      Divisor.coeff_toRDivisor, Int.cast_add]
  · simp only [Finset.univ_unique, Fin.default_eq_zero, Fin.isValue, one_mul,
      Finset.sum_singleton]

/-- **A form with a simple pole along a prime divisor.** On a normal variety with a canonical
divisor, every prime divisor `S` is a simple pole of a nonzero rational top form whose divisor is
canonical. -/
private theorem exists_ordForm_eq_neg_one [PerfectField k] [CompactSpace X]
    [LocallyOfFiniteType sX]
    (hX : IsNormalVariety k sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) :
    ∃ ω : RationalPluriForms sX n 1, ω ≠ 0 ∧ (divisorOfForm ω).IsCanonicalDivisor sX n ∧
      S.ordForm ω = -1 := by
  obtain ⟨t, ht⟩ := MMP.Flips.exists_primeDivisor_ord_eq S (-1 - K.coeff S)
  set K' := K + principalDivisor t with hK'
  have hlin : K'.LinearlyEquivalent K := ⟨t, by rw [hK']; abel⟩
  have hK'c := hK.of_linearlyEquivalent hlin
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK'c
  have hdiv : divisorOfForm ω = K' := by
    ext Γ
    change (divisorOfForm ω).coeff Γ = K'.coeff Γ
    rw [coeff_divisorOfForm, hω]
  refine ⟨ω, hω0, hdiv ▸ hK'c, ?_⟩
  rw [hω, hK', DivisorWithCoeffs.coeff_add, coeff_principalDivisor, ht]
  ring

/-- **The adjoint discrepancy divisor computed by one form.** With `K_X = div ω` and
`K_μ = μ^*(K_X + Δ)`, the divisor `E` of `K_Y + Γ = μ^*(K_X + Δ) + E` is
`div(μ^*ω) - K_μ + Γ`. -/
private theorem eq_of_isAdjointDiscrepancyDivisor [PerfectField k] [CompactSpace X]
    [LocallyOfFiniteType sX]
    (hX : IsNormalVariety k sX) {n : ℕ} {ω : RationalPluriForms sX n 1} (hω : ω ≠ 0)
    (hK : (divisorOfForm ω).IsCanonicalDivisor sX n) (Δ : Divisor X)
    (hC : (divisorOfForm ω + Δ).IsCartier) {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsDominant μ] [CompactSpace Y]
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hp : IsProper μ)
    {Γ E : Divisor Y} (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) {Kμ : Divisor Y}
    (hKμ : ∃ h, (divisorOfForm ω + Δ).IsPullback μ h Kμ) :
    haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
    E = divisorOfForm (pullbackRationalPluriForms sX μ ω) - Kμ + Γ := by
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  ext P
  obtain ⟨n', a, ha, hEa⟩ := hE P
  have hb := isLogDiscrepancy_of_isPullback sX hX hω hK Δ hC ⟨Y, μ, hY, hμ, P⟩ hp Kμ hKμ
  have hab := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha hb
  change E.coeff P = (divisorOfForm (pullbackRationalPluriForms sX μ ω) - Kμ + Γ).coeff P
  rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, coeff_divisorOfForm]
  have : (E.coeff P : ℝ) = (P.ordForm (pullbackRationalPluriForms sX μ ω) : ℝ) -
      (Kμ.coeff P : ℝ) + (Γ.coeff P : ℝ) := by
    rw [hEa, hab]
    change 1 + ((P.ordForm (pullbackRationalPluriForms sX μ ω) : ℤ) : ℝ) - _ - 1 + _ = _
    ring
  exact_mod_cast this

/-- **The adjoint discrepancy divisor over the isomorphism locus.** If `μ` is an isomorphism near
the generic point of `P`, mapping it to the generic point of `Q`, then `coeff_P E = 0` and
`coeff_P Γ = coeff_Q Δ`: the log discrepancy of `P` is `1 - coeff_Q Δ`, which is `0` exactly when
`Γ_P = 1`. -/
private theorem coeff_eq_of_mem_biregularLocus [PerfectField k] [CompactSpace X]
    [LocallyOfFiniteType sX] (hX : IsNormalVariety k sX) {n : ℕ}
    (hdim : topologicalKrullDim X = (n : WithBot ℕ∞)) {ω : RationalPluriForms sX n 1}
    (hω : ω ≠ 0) (hK : (divisorOfForm ω).IsCanonicalDivisor sX n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) (hC : (divisorOfForm ω + Δ).IsCartier)
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [CompactSpace Y] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) (hp : IsProper μ) {Γ E : Divisor Y}
    (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ) {Kμ : Divisor Y}
    (hKμ : ∃ h, (divisorOfForm ω + Δ).IsPullback μ h Kμ)
    (hEeq : haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
      E = divisorOfForm (pullbackRationalPluriForms sX μ ω) - Kμ + Γ)
    (P : MMP.Mori.PrimeDivisor Y) (hP : μ P.genericPoint ∈ MMP.Mori.biregularLocus μ) :
    ∃ Q : MMP.Mori.PrimeDivisor X, μ P.genericPoint = Q.genericPoint ∧ E.coeff P = 0 ∧
      Γ.coeff P = Δ.coeff Q := by
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hcoh : Order.coheight (μ P.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ hP, P.coheight_genericPoint]
  set Q : MMP.Mori.PrimeDivisor X := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh
  have hQ : μ P.genericPoint = Q.genericPoint :=
    (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hcoh).symm
  haveI : IsIso (μ.stalkMap P.genericPoint) :=
    MMP.Threefold.Resolution.isIso_stalkMap_of_mem_biregularLocus μ hP
  have hd : (letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = n) :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hdim
  have hord : P.ordForm (pullbackRationalPluriForms sX μ ω) = Q.ordForm ω :=
    MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso μ hμ.functionFieldMap_bijective hd
      P Q hQ ω
  obtain ⟨hKμs, hKμ'⟩ := hKμ
  have hKP : Kμ.coeff P = (divisorOfForm ω + Δ).coeff Q :=
    MMP.Positivity.coeff_eq_of_isPullback P Q hQ hC hKμ'
  have hEP : E.coeff P = Γ.coeff P - Δ.coeff Q := by
    rw [hEeq, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub, coeff_divisorOfForm, hord,
      hKP, DivisorWithCoeffs.coeff_add, coeff_divisorOfForm]
    ring
  have hlog := isLogDiscrepancy_of_isPullback sX hX hω hK Δ hC ⟨Y, μ, hY, hμ, P⟩ hp Kμ
    ⟨hKμs, hKμ'⟩
  have ha : (1 + ((⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX).ordPullback ω : ℝ) -
      (Kμ.coeff P : ℝ)) = 1 - (Δ.coeff Q : ℝ) := by
    change 1 + ((P.ordForm (pullbackRationalPluriForms sX μ ω) : ℤ) : ℝ) - _ = _
    rw [hord, hKP, DivisorWithCoeffs.coeff_add, coeff_divisorOfForm]
    push_cast; ring
  rw [ha] at hlog
  have hΓP : Γ.coeff P = Δ.coeff Q := by
    rcases hΔ Q with h0 | h1
    · -- `a(P) = 1`, so `Γ_P = 0`
      rw [h0]
      rcases hΓ.1 P with g0 | g1
      · exact g0
      · obtain ⟨n', hn'⟩ := (hΓ.2 P).1 g1
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hn' hlog
        rw [h0] at this; norm_num at this
    · -- `a(P) = 0`, so `Γ_P = 1`
      rw [h1, (hΓ.2 P).2 ⟨n, by rw [h1] at hlog; simpa using hlog⟩]
  exact ⟨Q, hQ, by rw [hEP, hΓP, sub_self], hΓP⟩

end FormDiscrepancy

section RationalFunctionsAux

variable {X : Scheme.{0}} [IsIntegral X]

private theorem germ_eq_rationalFunctionsEquivFunctionField_symm (U : X.Opens) (s : Γ(X, U))
    (h : genericPoint X ∈ U) (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ U) :
    (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s) Z =
      X.presheaf.germ U (componentGenericPoint X Z) hZ s := by
  haveI : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hd : Dense (U : Set X) := U.isOpen.dense ⟨_, h⟩
  let D : Stacks.Chow.DenseOpen X := ⟨U, hd⟩
  have key : (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s)
      = (Stacks.Chow.rationalFunctionsEquivStalks X).1 (Stacks.Chow.ofSection X D s) := by
    rw [RingEquiv.symm_apply_eq, ← (Stacks.Chow.rationalFunctionsEquivFunctionField X).2 D s h]
    change _ = (Stacks.Chow.rationalFunctionsEquivFunctionField X).1
      ((Stacks.Chow.rationalFunctionsEquivStalks X).1.symm _)
    rw [RingEquiv.symm_apply_apply]
  rw [key]
  exact (Stacks.Chow.rationalFunctionsEquivStalks X).2 D s Z hZ

variable [IsLocallyNoetherian X] [IsNormal X]

end RationalFunctionsAux

/-! ### Restricting sections to a smooth prime divisor -/

section SectionRestriction

open MMP.Mori

/-- **Restricting a section to a smooth prime divisor.** Let `P` be a smooth prime divisor of a
smooth scheme `X` over `k`, `G` a divisor of which `P` is not a component, and `a` a unit of
`𝒪_{X,η_P}` whose image `g ∈ K(X)` satisfies `v_E(g) ≤ exp(coeff_E G)` along every prime divisor
`E` meeting an open `W`. Then `a|_P` satisfies the same bound for `G|_P` along every prime divisor
of `P` meeting `W`: `ord_Q(a|_P) + coeff_Q(G|_P) = ∑_E length_Q(E) (ord_E g + coeff_E G)`. -/
private theorem divisorialValuation_restrict_le {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    [Smooth sX] (P : MMP.Mori.PrimeDivisor X) [IsLocallyNoetherian P.idealSheaf.subscheme]
    [IsNormal P.idealSheaf.subscheme] [Smooth (P.idealSheaf.subschemeι ≫ sX)]
    (G : Divisor X) (hGP : G.coeff P = 0) (W : X.Opens)
    (a : X.presheaf.stalk (haveI := P.integral;
      P.idealSheaf.subschemeι (genericPoint P.idealSheaf.subscheme))) (ha : IsUnit a)
    (hg : ∀ E : MMP.Mori.PrimeDivisor X, (E.support ∩ W).Nonempty →
      E.divisorialValuation (algebraMap _ X.functionField a) ≤ WithZero.exp (G.coeff E))
    (Q : MMP.Mori.PrimeDivisor (haveI := P.integral; P.idealSheaf.subscheme))
    (hQ : (Q.support ∩ (haveI := P.integral; P.idealSheaf.subschemeι ⁻¹ᵁ W)).Nonempty) :
    haveI := P.integral
    Q.divisorialValuation ((P.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a :
      P.idealSheaf.subscheme.functionField) ≤
      WithZero.exp ((G.restrictPrimeDivisor P).coeff Q) := by
  haveI := P.integral
  haveI : IsNoetherian X := ⟨⟩
  classical
  set g := algebraMap _ X.functionField a with hgdef
  have hg0 : g ≠ 0 := (ha.map (algebraMap (X.presheaf.stalk _) X.functionField)).ne_zero
  have hgT : ((P.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a :
      P.idealSheaf.subscheme.functionField) ≠ 0 :=
    (ha.map (P.idealSheaf.subschemeι.stalkMap _).hom).ne_zero
  rw [Q.divisorialValuation_eq_exp_neg_ord hgT, WithZero.exp_le_exp]
  set s := G.support ∪ (principalDivisor (Units.map
    (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg0))).support with hs
  have hss : ∀ E : MMP.Mori.PrimeDivisor X, X.ord g E.genericPoint ≠ 0 → E ∈ s := fun E hE =>
    Finset.mem_union_right _ (by
      rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, MMP.Mori.coeff_principalDivisor_mk0]
      exact hE)
  have hQW : Q.genericPoint ∈ P.idealSheaf.subschemeι ⁻¹ᵁ W := (Q.genericPoint_mem_iff _).mpr hQ
  rw [MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX P.idealSheaf.subschemeι a ha Q s hss,
    DivisorWithCoeffs.coeff_restrictPrimeDivisor G P hGP Q, Finsupp.sum]
  have hR : ∑ E ∈ G.support, E.intersectionLength P.idealSheaf.subschemeι Q • G E =
      ∑ E ∈ s, E.intersectionLength P.idealSheaf.subschemeι Q • G E :=
    Finset.sum_subset Finset.subset_union_left
      (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])
  rw [hR]
  rw [neg_le_iff_add_nonneg, ← Finset.sum_add_distrib]
  refine Finset.sum_nonneg fun E _ => ?_
  by_cases hmem : P.idealSheaf.subschemeι Q.genericPoint ∈ E.support
  · have hEW : (E.support ∩ W).Nonempty := ⟨_, hmem, hQW⟩
    have h1 := hg E hEW
    rw [E.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [nsmul_eq_mul, ← DivisorWithCoeffs.coeff_apply, ← mul_add, ← hgdef]
    exact mul_nonneg (by positivity) (by omega)
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hmem]
    simp

end SectionRestriction

/-! ### Adjunction along a strict transform -/

section Adjunction

open MMP.Mori

/-- A prime divisor of a variety of dimension `n + 1` has dimension `n`. -/
private theorem topologicalKrullDim_primeDivisor_eq {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsIntegral Y] [LocallyOfFiniteType sY] {n : ℕ}
    (hn : topologicalKrullDim Y = ((n + 1 : ℕ) : WithBot ℕ∞)) (P : MMP.Mori.PrimeDivisor Y) :
    topologicalKrullDim P.idealSheaf.subscheme = (n : WithBot ℕ∞) := by
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sY P.genericPoint
  rw [P.coheight_genericPoint, hn] at h
  rw [MMP.Mori.topologicalKrullDim_subscheme_eq]
  change topologicalKrullDim (P.support : Set Y) = _
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  have hne : topologicalKrullDim (closure {P.genericPoint} : Set Y) ≠ ⊥ :=
    (Order.krullDim_ne_bot_iff (α := IrreducibleCloseds (closure {P.genericPoint} : Set Y))).mpr
      ⟨IrreducibleCloseds.closureSingleton ⟨P.genericPoint, subset_closure rfl⟩⟩
  obtain ⟨b, hb⟩ := WithBot.ne_bot_iff_exists.mp hne
  rw [← hb] at h ⊢
  have h' : b + 1 = ((n + 1 : ℕ) : ℕ∞) := by exact_mod_cast h
  have : b = n := by
    rw [Nat.cast_add, Nat.cast_one] at h'
    exact (ENat.add_left_injective_of_ne_top (by simp)) h'
  rw [this]; rfl

/-- Orders of forms are unchanged by transporting along an equality of structure morphisms. -/
private theorem ordForm_cast {k : Type} [Field k] {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] {s s' : Y ⟶ Spec (.of k)} (hs : s = s') {n : ℕ}
    (h : RationalPluriForms s n 1 = RationalPluriForms s' n 1) (x : RationalPluriForms s n 1)
    (Q : MMP.Mori.PrimeDivisor Y) : Q.ordForm (cast h x) = Q.ordForm x := by
  subst hs; rfl

/-- The generic point of a prime divisor `S` lies outside the support of every divisor of which `S`
is not a component. -/
private theorem genericPoint_notMem_supp_of_coeff_eq_zero {Y : Scheme.{0}} (C : Divisor Y)
    (S : MMP.Mori.PrimeDivisor Y) (hCS : C.coeff S = 0) : S.genericPoint ∉ C.supp := by
  haveI := S.integral
  have := subschemeι_notMem_supp C S hCS
    ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩
  rwa [componentGenericPoint_eq_genericPoint'] at this

/-- The generic point of an integral scheme lies outside the support of every divisor. -/
private theorem genericPoint_notMem_supp {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {R : Type*} [Zero R] (C : DivisorWithCoeffs R Y) :
    genericPoint Y ∉ C.supp := by
  intro h
  obtain ⟨E, -, hE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
  exact MMP.Threefold.Mori.CanonUniq.genericPoint_notMem_support E hE

/-- Restriction to a prime divisor `F` of a difference of divisors of which `F` is not a
component. -/
private theorem restrictPrimeDivisor_sub {Y : Scheme.{0}} [IsLocallyNoetherian Y] [CompactSpace Y]
    (D E : Divisor Y) (F : MMP.Mori.PrimeDivisor Y) (hD : D.coeff F = 0) (hE : E.coeff F = 0) :
    (D - E).restrictPrimeDivisor F = D.restrictPrimeDivisor F - E.restrictPrimeDivisor F := by
  have hE' : (-E).coeff F = 0 := by rw [DivisorWithCoeffs.coeff_neg, hE, neg_zero]
  rw [sub_eq_add_neg, MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_add _ _ F hD hE',
    sub_eq_add_neg]
  congr 1
  have := MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_zsmul E F hE (-1)
  rwa [neg_one_zsmul, neg_one_zsmul] at this

/-- **The support of a restriction.** On a smooth variety `Y`, for a smooth prime divisor `F` and
an effective divisor `B` of which `F` is not a component, every point of `F` lying on `Supp B`
lies on `Supp (B|_F)`: a local equation of `B` at such a point is a non-unit, and so is its
restriction, which is a local equation of `B|_F`. -/
private theorem mem_supp_restrictPrimeDivisor {k : Type} [Field k] {Y : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) [IsSmoothVariety k sY] [IsLocallyNoetherian Y] [IsNormal Y]
    (F : MMP.Mori.PrimeDivisor Y) [Smooth (F.idealSheaf.subschemeι ≫ sY)]
    [IsLocallyNoetherian F.idealSheaf.subscheme] [IsNormal F.idealSheaf.subscheme]
    (B : Divisor Y) (hB0 : 0 ≤ B) (hBF : B.coeff F = 0) {x : F.idealSheaf.subscheme}
    (hx : F.idealSheaf.subschemeι x ∈ B.supp) :
    x ∈ DivisorWithCoeffs.supp (B.restrictPrimeDivisor F) := by
  haveI := F.integral
  haveI : IsIntegral Y := (inferInstance : AlgebraicGeometry.IsVariety k sY).toIsIntegral
  set ι := F.idealSheaf.subschemeι with hι
  have hBc : B.IsCartier :=
    MMP.Fourfold.isCartier_of_isSmoothScheme ((MMP.Mori.isSmoothScheme_iff sY).2 inferInstance) B
  obtain ⟨U, hxU, h, hh⟩ := hBc (ι x)
  obtain ⟨-, -, hloc⟩ := MMP.Mori.Divisor.isCartier_restrictPrimeDivisor_of_isSmoothVariety k sY F
    B hBF
  obtain ⟨⟨φ, hφr⟩, hφl⟩ := hloc U h hh
  have hφ := hφl φ hφr
  by_contra hxs
  -- `φ` is a unit at `x`
  let WF : irreducibleComponents F.idealSheaf.subscheme :=
    ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩
  have hxW : x ∈ WF.1 := trivial
  obtain ⟨c, hc⟩ := MMP.Mori.exists_unit_stalk_of_forall_ord_eq_zero hxW φ (fun Q hQ => by
    rw [← hφ Q ⟨x, hQ, hxU⟩]
    by_contra hne
    exact hxs (DivisorWithCoeffs.support_subset_supp hne hQ))
  -- a component `E` of `B` through `ι x`
  obtain ⟨E, hEne, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  have hspec : E.genericPoint ⤳ ι x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact specializes_iff_mem_closure.mpr hxE
  have hyW : ι x ∈ E.component.1 := E.support_subset_component hxE
  -- `h` is regular at `ι x`
  obtain ⟨r, hr⟩ := MMP.Mori.exists_stalk_eq_of_forall_zero_le_ord hyW h (fun E' hE' => by
    rw [← hh E' ⟨_, hE', hxU⟩]; exact hB0 E')
  -- represent `r` by a section on an open `V ⊆ U`
  obtain ⟨V', hm, b, hb⟩ := TopCat.Presheaf.germ_exist Y.presheaf r
  let V := V' ⊓ U
  have hyV : ι x ∈ V := ⟨hm, hxU⟩
  let b' := Y.presheaf.map (homOfLE (inf_le_left : V ≤ V')).op b
  have hb' : r = Y.presheaf.germ V (ι x) hyV b' := by
    rw [← hb]
    exact (Y.presheaf.germ_res_apply (homOfLE (inf_le_left : V ≤ V')) _ _ b).symm
  have hrep : ∀ (W : irreducibleComponents Y) (hW : componentGenericPoint Y W ∈ V),
      (h : RationalFunctions Y) W = Y.presheaf.germ V _ hW b' := by
    intro W hW
    obtain rfl : W = E.component := irreducibleComponents_eq _ _
    rw [← hr, hb']
    exact ConcreteCategory.congr_hom (TopCat.Presheaf.germ_stalkSpecializes Y.presheaf (U := V)
      hyV ((MMP.Mori.isGenericPoint_componentGenericPoint Y _).specializes hyW)) b'
  have hxV : x ∈ ι ⁻¹ᵁ V := hyV
  have hgen : componentGenericPoint _ WF ∈ ι ⁻¹ᵁ V :=
    ((MMP.Mori.isGenericPoint_componentGenericPoint _ WF).specializes hxW).mem_open
      (ι ⁻¹ᵁ V).isOpen hxV
  have hφb := hφr V inf_le_right b' hrep WF hgen
  -- the restriction of `r` is the unit `c`
  have hcr : (ι.stalkMap x).hom r = (c : F.idealSheaf.subscheme.presheaf.stalk x) := by
    apply MMP.Mori.stalkToRationalFunctions_injective hxW
    rw [hc, hφb, hb', Scheme.Hom.germ_stalkMap_apply]
    exact ConcreteCategory.congr_hom (TopCat.Presheaf.germ_stalkSpecializes
      F.idealSheaf.subscheme.presheaf (U := ι ⁻¹ᵁ V) hxV ((MMP.Mori.isGenericPoint_componentGenericPoint _ WF).specializes hxW)) _
  have hru : IsUnit r := by
    have := c.isUnit
    rw [← hcr] at this
    exact (isUnit_map_iff (ι.stalkMap x).hom r).mp this
  -- hence `B` vanishes at `ι x`
  apply hEne
  rw [hh E ⟨_, hxE, hxU⟩]
  exact E.ord_eq_zero_of_isUnit (hru.map (Y.presheaf.stalkSpecializes hspec).hom)
    (by rw [E.toComponent_stalkSpecializes hspec hyW, hr])

/-- Points of `Supp (B|_F)` lie on `Supp B`. -/
private theorem mem_supp_of_mem_supp_restrictPrimeDivisor {Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [CompactSpace Y] {R : Type*} [AddCommMonoid R]
    (B : DivisorWithCoeffs R Y) (F : MMP.Mori.PrimeDivisor Y)
    (hBF : B.coeff F = 0) {x : F.idealSheaf.subscheme}
    (hx : x ∈ DivisorWithCoeffs.supp (B.restrictPrimeDivisor F)) :
    F.idealSheaf.subschemeι x ∈ DivisorWithCoeffs.supp B := by
  haveI : IsNoetherian Y := ⟨⟩
  obtain ⟨Q, hQ, hxQ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor B F hBF] at hQ
  obtain ⟨E, hEB, hE⟩ := Finset.exists_ne_zero_of_sum_ne_zero hQ
  have hlen : E.intersectionLength F.idealSheaf.subschemeι Q ≠ 0 := fun h0 => hE (by
    simp [h0])
  have hEB' : B.coeff E ≠ 0 := fun h0 => hE (by
    change E.intersectionLength _ Q • B E = 0
    rw [← DivisorWithCoeffs.coeff_apply, h0, smul_zero])
  have hηQ : F.idealSheaf.subschemeι Q.genericPoint ∈ E.support := by
    by_contra hn
    exact hlen (MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hn)
  have hsp : Q.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxQ
    exact specializes_iff_mem_closure.mpr hxQ
  have hsp' := hsp.map F.idealSheaf.subschemeι.continuous
  exact DivisorWithCoeffs.support_subset_supp hEB'
    (hsp'.mem_closed E.idealSheaf.support.isClosed hηQ)

/-- The support of a sum of effective divisors is the union of the supports. -/
private theorem mem_supp_add_iff {Y : Scheme.{0}} {A B : QDivisor Y} (hA : ∀ P, 0 ≤ A.coeff P)
    (hB : ∀ P, 0 ≤ B.coeff P) {x : Y} :
    x ∈ DivisorWithCoeffs.supp (A + B) ↔ x ∈ DivisorWithCoeffs.supp A ∨
      x ∈ DivisorWithCoeffs.supp B := by
  simp only [DivisorWithCoeffs.mem_supp_iff, DivisorWithCoeffs.coeff_add]
  constructor
  · rintro ⟨E, hE, hx⟩
    by_cases hAE : A.coeff E = 0
    · rw [hAE, zero_add] at hE; exact Or.inr ⟨E, hE, hx⟩
    · exact Or.inl ⟨E, hAE, hx⟩
  · rintro (⟨E, hE, hx⟩ | ⟨E, hE, hx⟩)
    · refine ⟨E, fun h => hE ?_, hx⟩
      linarith [hA E, hB E]
    · refine ⟨E, fun h => hE ?_, hx⟩
      linarith [hA E, hB E]

/-- **The support of a restricted `ℚ`-divisor.** On a smooth variety `Y` with a smooth prime
divisor `F`, for an effective `ℚ`-divisor `D` of which `F` is not a component,
`Supp (D|_F) = F ∩ Supp D`. -/
private theorem mem_supp_restrictPrimeDivisor_iff_qDivisor {k : Type} [Field k]
    {Y : Scheme.{0}} (sY : Y ⟶ Spec (.of k)) [IsSmoothVariety k sY] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (F : MMP.Mori.PrimeDivisor Y)
    [Smooth (F.idealSheaf.subschemeι ≫ sY)] [IsLocallyNoetherian F.idealSheaf.subscheme]
    [IsNormal F.idealSheaf.subscheme] (D : QDivisor Y) (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDF : D.coeff F = 0) (x : F.idealSheaf.subscheme) :
    x ∈ DivisorWithCoeffs.supp (D.restrictPrimeDivisor F) ↔
      F.idealSheaf.subschemeι x ∈ DivisorWithCoeffs.supp D := by
  classical
  refine ⟨mem_supp_of_mem_supp_restrictPrimeDivisor D F hDF, fun hx => ?_⟩
  haveI : IsNoetherian Y := ⟨⟩
  have hsm : MMP.Mori.IsSmoothScheme sY := (MMP.Mori.isSmoothScheme_iff sY).2 inferInstance
  obtain ⟨m, hm, D₀, hD₀, -⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hmQ : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  have hco : ∀ P, (D₀.coeff P : ℚ) = m * D.coeff P := fun P => by
    have := congrArg (fun G : QDivisor Y => G.coeff P) hD₀
    simpa [Divisor.coeff_toQDivisor] using this
  have hD₀0 : 0 ≤ D₀ := fun P => by
    have := hco P
    have : (0 : ℚ) ≤ D₀.coeff P := by rw [this]; exact mul_nonneg (by positivity) (hD0 P)
    exact_mod_cast this
  have hD₀F : D₀.coeff F = 0 := by
    have := hco F; rw [hDF, mul_zero] at this; exact_mod_cast this
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have h1 := mem_supp_restrictPrimeDivisor sY F D₀ hD₀0 hD₀F (by rw [hsupp]; exact hx)
  obtain ⟨Q, hQ, hxQ⟩ := DivisorWithCoeffs.mem_supp_iff.mp h1
  refine DivisorWithCoeffs.support_subset_supp (E := Q) ?_ hxQ
  intro h0
  apply hQ
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D₀ F hD₀F Q]
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D F hDF Q] at h0
  have : ((D₀.sum fun E d => E.intersectionLength F.idealSheaf.subschemeι Q • d : ℤ) : ℚ) =
      m * (D.sum fun E d => E.intersectionLength F.idealSheaf.subschemeι Q • d) := by
    rw [Finsupp.sum, Finsupp.sum, Finset.mul_sum]
    push_cast
    rw [Finset.sum_subset (s₁ := D₀.support) (s₂ := D₀.support ∪ D.support)
      Finset.subset_union_left (fun E _ hE => by simp [Finsupp.notMem_support_iff.mp hE]),
      Finset.sum_subset (s₁ := D.support) (s₂ := D₀.support ∪ D.support)
      Finset.subset_union_right (fun E _ hE => by simp [Finsupp.notMem_support_iff.mp hE])]
    refine Finset.sum_congr rfl fun E _ => ?_
    have := hco E
    rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply] at this
    rw [nsmul_eq_mul, nsmul_eq_mul]; push_cast; rw [this]; ring
  rw [h0, mul_zero] at this
  exact_mod_cast this

/-- **The support of a pull-back.** For an effective Cartier divisor `B` on `Y` and its
pull-back `B'` along `f : X ⟶ Y` (integral normal schemes), every point of `X` mapping into
`Supp B` lies on `Supp B'`: a local equation of `B` there is a non-unit, and so is its pull-back, a
local equation of `B'`. -/
private theorem mem_supp_of_isPullback {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y)
    {B : Divisor Y} (hBc : B.IsCartier) (hB0 : 0 ≤ B)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ B.supp}
    {B' : Divisor X} (h : B.IsPullback f hB B') {x : X} (hx : f x ∈ B.supp) : x ∈ B'.supp := by
  obtain ⟨U, hxU, ψ, hψ⟩ := hBc (f x)
  have hψ' := h.isLocalEquation hψ
  by_contra hxs
  let WX : irreducibleComponents X := ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩
  have hxW : x ∈ WX.1 := trivial
  obtain ⟨c, hc⟩ := hψ'.exists_unit_stalk (y := x) hxU hxs hxW
  obtain ⟨E, hEne, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  have hspec : E.genericPoint ⤳ f x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact specializes_iff_mem_closure.mpr hxE
  have hyW : f x ∈ E.component.1 := E.support_subset_component hxE
  obtain ⟨r, hr⟩ := MMP.Mori.exists_stalk_eq_of_forall_zero_le_ord hyW ψ (fun E' hE' => by
    rw [← hψ E' ⟨_, hE', hxU⟩]; exact hB0 E')
  -- the pull-back component at the generic point of `X`
  set z := componentGenericPoint X WX
  have hzx : z ⤳ x := (MMP.Mori.isGenericPoint_componentGenericPoint X WX).specializes hxW
  have hfz : f z ⤳ f x := f.base.hom.map_specializes hzx
  have hzU : f z ∈ U := hfz.mem_open U.isOpen hxU
  have hzW : f z ∈ E.component.1 := by rw [eq_univ_of_irreducibleComponents' E.component]; trivial
  obtain ⟨a₀, ha₀⟩ := hψ.exists_unit_stalk hzU (hB WX) hzW
  have ha₀r : (a₀ : Y.presheaf.stalk (f z)) = Y.presheaf.stalkSpecializes hfz r := by
    apply MMP.Mori.stalkToRationalFunctions_injective hzW
    rw [ha₀, ← hr]
    change _ = (Y.presheaf.stalkSpecializes hfz ≫ Y.presheaf.stalkSpecializes _).hom r
    rw [TopCat.Presheaf.stalkSpecializes_comp]
    rfl
  have hpc := MMP.Mori.pullbackComponent_eq hB hψ hzU hzW a₀ ha₀
  have hpl := congrArg Units.val (MMP.Mori.pullbackLocalEquation_apply f hB hψ WX hzU)
  -- the restriction of `r` is the unit `c`
  have hcr : (f.stalkMap x).hom r = (c : X.presheaf.stalk x) := by
    apply MMP.Mori.stalkToRationalFunctions_injective hxW
    rw [hc]
    change _ = ((Units.map (RationalFunctions.component X WX).toMonoidHom
      (MMP.Mori.pullbackLocalEquation f hB hψ) : (X.presheaf.stalk z)ˣ) : X.presheaf.stalk z)
    rw [hpl, hpc]
    change X.presheaf.stalkSpecializes hzx ((f.stalkMap x).hom r) =
      (f.stalkMap z).hom (a₀ : Y.presheaf.stalk (f z))
    rw [ha₀r, Scheme.Hom.stalkSpecializes_stalkMap_apply]
  have hru : IsUnit r := by
    have := c.isUnit
    rw [← hcr] at this
    exact (isUnit_map_iff (f.stalkMap x).hom r).mp this
  apply hEne
  rw [hψ E ⟨_, hxE, hxU⟩]
  exact E.ord_eq_zero_of_isUnit (hru.map (Y.presheaf.stalkSpecializes hspec).hom)
    (by rw [E.toComponent_stalkSpecializes hspec hyW, hr])

/-- The restriction of an effective divisor is effective. -/
private theorem coeff_restrictPrimeDivisor_nonneg' {Y : Scheme.{0}} [NoetherianSpace Y]
    {R : Type*} [AddCommMonoid R] [PartialOrder R] [IsOrderedAddMonoid R]
    (B : DivisorWithCoeffs R Y) (F : MMP.Mori.PrimeDivisor Y) (hBF : B.coeff F = 0)
    (hB0 : ∀ P, 0 ≤ B.coeff P) (Q : MMP.Mori.PrimeDivisor F.idealSheaf.subscheme) :
    0 ≤ (B.restrictPrimeDivisor F).coeff Q := by
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor B F hBF Q]
  refine Finset.sum_nonneg fun E _ => nsmul_nonneg ?_ _
  have := hB0 E
  rwa [DivisorWithCoeffs.coeff_apply] at this

/-- A morphism is injective on the preimage of an open over which it is an isomorphism. -/
private theorem eq_of_map_eq_of_isIso {X Y : Scheme.{0}} (μ : Y ⟶ X) {V : X.Opens}
    (hV : IsIso (μ ∣_ V)) {y₁ y₂ : Y} (h₁ : y₁ ∈ μ ⁻¹ᵁ V) (h₂ : y₂ ∈ μ ⁻¹ᵁ V)
    (h : μ y₁ = μ y₂) : y₁ = y₂ := by
  have hinj : ∀ p : (μ ⁻¹ᵁ V).toScheme, (inv (μ ∣_ V)) ((μ ∣_ V) p) = p := fun p => by
    change ((μ ∣_ V) ≫ inv (μ ∣_ V)) p = p
    rw [IsIso.hom_inv_id]; rfl
  let p₁ : (μ ⁻¹ᵁ V).toScheme := ⟨y₁, h₁⟩
  let p₂ : (μ ⁻¹ᵁ V).toScheme := ⟨y₂, h₂⟩
  have he : (μ ∣_ V) p₁ = (μ ∣_ V) p₂ := by
    apply Subtype.ext
    rw [morphismRestrict_base_coe, morphismRestrict_base_coe]
    exact h
  have := congrArg (inv (μ ∣_ V)) he
  rw [hinj, hinj] at this
  exact congrArg Subtype.val this

/-- **The boundary of the strict transform.** Let `μ : Y ⟶ X` be a log resolution of `Δ + D`
(components `s₀`) which is an isomorphism away from `Supp D`, `S` a component of `Δ` off `Supp D`,
and `T` its strict transform with `μ_T : T ⟶ S`. A point `x` of `T` lies on `Ex(μ_T)` or over
`Supp (Θ + D|_S)`, `Θ = (Δ - S)|_S`, exactly when it lies on another component of `s₀`. -/
private theorem mem_boundary_strictTransform_iff {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsSmoothVariety k sX] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [IsDominant μ] [IsProper μ] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) {Δ : Divisor X} (hΔ : MMP.Intersection.IsReducedEffective Δ)
    {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P) (hV : IsIso (μ ∣_ D.supp.compl))
    {s₀ : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs₀ : (⋃ E ∈ s₀, (E.support : Set Y)) = ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) : Set Y))
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) (hηS : S.genericPoint ∉ D.supp)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [Smooth (S.idealSheaf.subschemeι ≫ sX)]
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    (x : T.idealSheaf.subscheme) :
    haveI := Classical.decEq (MMP.Mori.PrimeDivisor Y)
    (x ∈ exceptionalSet μT ∨ μT x ∈ DivisorWithCoeffs.supp
      (Divisor.toQDivisor ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) +
        D.restrictPrimeDivisor S)) ↔
      ∃ E ∈ s₀.erase T, T.idealSheaf.subschemeι x ∈ E.support := by
  classical
  haveI := S.integral; haveI := T.integral
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k sX).toIsIntegral
  have hsm : MMP.Mori.IsSmoothScheme sX := (MMP.Mori.isSmoothScheme_iff sX).2 inferInstance
  have hμy : μ (T.idealSheaf.subschemeι x) = S.idealSheaf.subschemeι (μT x) := by
    change (T.idealSheaf.subschemeι ≫ μ) x = (μT ≫ S.idealSheaf.subschemeι) x
    rw [hμT]
  -- the integral Cartier multiple of `D`
  obtain ⟨m, hm, D₀, hD₀, -⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hco : ∀ P, (D₀.coeff P : ℚ) = m * D.coeff P := fun P => by
    have := congrArg (fun G : QDivisor X => G.coeff P) hD₀
    simpa [Divisor.coeff_toQDivisor] using this
  have hD₀0 : 0 ≤ D₀ := fun P => by
    have : (0 : ℚ) ≤ D₀.coeff P := by rw [hco P]; exact mul_nonneg (by positivity) (hD0 P)
    exact_mod_cast this
  have hD₀supp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hDS : D.coeff S = 0 := by
    by_contra hne
    exact hηS (DivisorWithCoeffs.support_subset_supp hne (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl))
  have hD₀S : D₀.coeff S = 0 := by
    have := hco S; rw [hDS, mul_zero] at this; exact_mod_cast this
  have hΔS' : (Δ - Finsupp.single S 1 : Divisor X).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_sub, hS, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_eq_same]; norm_num
  have hΔS0 : 0 ≤ (Δ - Finsupp.single S 1 : Divisor X) := fun P => by
    change 0 ≤ (Δ - Finsupp.single S 1 : Divisor X).coeff P
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_apply]
    split_ifs with h
    · subst h; rw [hS]; norm_num
    · rcases hΔ P with h0 | h1 <;> simp [*]
  have hΔ0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor Δ).coeff P := fun P => by
    rw [Divisor.coeff_toQDivisor]; rcases hΔ P with h | h <;> rw [h] <;> norm_num
  -- a point of `T` over the support of an effective divisor `B ≤ Δ + D` lies on another component
  have key : ∀ B : Divisor X, 0 ≤ B → B.coeff S = 0 →
      (∀ z, z ∈ B.supp → z ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D)) →
      μ (T.idealSheaf.subschemeι x) ∈ B.supp →
      ∃ E ∈ s₀.erase T, T.idealSheaf.subschemeι x ∈ E.support := by
    intro B hB0 hBS hBsub hyB
    have hBc : B.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm B
    obtain ⟨B', hB'⟩ := hBc.exists_isPullback
      (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ B)
    have hy := mem_supp_of_isPullback μ hBc hB0 hB' hyB
    obtain ⟨E, hE, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hy
    refine ⟨E, Finset.mem_erase.mpr ⟨fun hET => hE ?_, ?_⟩, hyE⟩
    · rw [hET]
      exact coeff_isPullback_eq_zero (F := ⟨Y, μ, hY, hμ, T⟩) hBc
        (by change μ T.genericPoint ∉ _; rw [hT]
            exact genericPoint_notMem_supp_of_coeff_eq_zero B S hBS) B' _ hB'
    · have hηE : μ E.genericPoint ∈ B.supp := by
        by_contra hn
        exact hE (coeff_isPullback_eq_zero (F := ⟨Y, μ, hY, hμ, E⟩) hBc hn B' _ hB')
      have hmem : E.genericPoint ∈ ⋃ E' ∈ s₀, (E'.support : Set Y) := by
        rw [hs₀]
        refine Or.inr ?_
        change μ E.genericPoint ∈ (DivisorWithCoeffs.supp
          (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
        rw [QDivisor.supp_toRDivisor]
        exact hBsub _ hηE
      obtain ⟨E', hE', hEE'⟩ := Set.mem_iUnion₂.mp hmem
      have hEE := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hEE'
      first | rwa [hEE] | rwa [← hEE]
  have hΔsub : ∀ z, z ∈ (Δ - Finsupp.single S 1 : Divisor X).supp →
      z ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D) := by
    intro z hz
    rw [mem_supp_add_iff hΔ0 hD0, Divisor.supp_toQDivisor]
    left
    obtain ⟨E, hE, hzE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hz
    refine DivisorWithCoeffs.support_subset_supp (E := E) (fun h0 => hE ?_) hzE
    rw [DivisorWithCoeffs.coeff_sub, h0, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_apply]
    split_ifs with h
    · subst h; rw [hS] at h0; exact absurd h0 one_ne_zero
    · simp
  have hD₀sub : ∀ z, z ∈ D₀.supp → z ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D) := by
    intro z hz
    rw [mem_supp_add_iff hΔ0 hD0]
    right; rwa [← hD₀supp]
  have hΘ0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S)).coeff P := fun P => by
    haveI : IsNoetherian X := ⟨⟩
    rw [Divisor.coeff_toQDivisor]
    exact_mod_cast coeff_restrictPrimeDivisor_nonneg' _ S hΔS' (fun P => hΔS0 P) P
  have hDS0 : ∀ P, (0 : ℚ) ≤ (D.restrictPrimeDivisor S).coeff P := fun P => by
    haveI : IsNoetherian X := ⟨⟩
    exact coeff_restrictPrimeDivisor_nonneg' _ S hDS hD0 P
  constructor
  · rintro (hx | hx)
    · -- over `Supp D`
      have hyD : μ (T.idealSheaf.subschemeι x) ∈ D.supp := by
        by_contra h
        apply hx
        refine MMP.Mori.le_biregularLocus
          (isIso_morphismRestrict_strictTransform μ hV S T hT μT hμT) ?_
        change S.idealSheaf.subschemeι (μT x) ∈ D.supp.compl
        rw [← hμy]; exact h
      exact key D₀ hD₀0 hD₀S hD₀sub (by rwa [hD₀supp])
    · rcases (mem_supp_add_iff hΘ0 hDS0).1 hx with h | h
      · rw [Divisor.supp_toQDivisor] at h
        have := mem_supp_of_mem_supp_restrictPrimeDivisor _ S hΔS' h
        exact key _ hΔS0 hΔS' hΔsub (by rw [hμy]; exact this)
      · have := mem_supp_of_mem_supp_restrictPrimeDivisor D S hDS h
        exact key D₀ hD₀0 hD₀S hD₀sub (by rw [hD₀supp, hμy]; exact this)
  · rintro ⟨E, hE, hyE⟩
    obtain ⟨hET, hEs⟩ := Finset.mem_erase.mp hE
    right
    by_cases hyD : μ (T.idealSheaf.subschemeι x) ∈ D.supp
    · refine (mem_supp_add_iff hΘ0 hDS0).2 (Or.inr ?_)
      rw [mem_supp_restrictPrimeDivisor_iff_qDivisor sX S D hD0 hDS, ← hμy]
      exact hyD
    · refine (mem_supp_add_iff hΘ0 hDS0).2 (Or.inl ?_)
      rw [Divisor.supp_toQDivisor]
      refine mem_supp_restrictPrimeDivisor sX S _ hΔS0 hΔS' ?_
      rw [← hμy]
      -- the generic point of `E` maps to the generic point of a component of `Δ - S`
      have hyV : T.idealSheaf.subschemeι x ∈ μ ⁻¹ᵁ D.supp.compl := hyD
      have hηE : E.genericPoint ∈ μ ⁻¹ᵁ D.supp.compl :=
        (E.genericPoint_mem_iff _).mpr ⟨_, hyE, hyV⟩
      have hbir : μ E.genericPoint ∈ MMP.Mori.biregularLocus μ := MMP.Mori.le_biregularLocus hV hηE
      have hmem : E.genericPoint ∈ ⋃ E' ∈ s₀, (E'.support : Set Y) :=
        Set.mem_iUnion₂.mpr ⟨E, hEs, by
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl⟩
      rw [hs₀] at hmem
      rcases hmem with hEx | hEsupp
      · exact absurd hbir hEx
      change μ E.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X) at hEsupp
      rw [QDivisor.supp_toRDivisor] at hEsupp
      have hEsupp' : μ E.genericPoint ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D) :=
        hEsupp
      rw [mem_supp_add_iff hΔ0 hD0, Divisor.supp_toQDivisor] at hEsupp'
      rcases hEsupp' with hEΔ | hED
      swap
      · exact absurd hED hηE
      obtain ⟨Δj, hΔj, hEΔj⟩ := DivisorWithCoeffs.mem_supp_iff.mp hEΔ
      have hcoh : Order.coheight (μ E.genericPoint) = 1 := by
        rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ hbir, E.coheight_genericPoint]
      have heq := MMP.Mori.PrimeDivisor.eq_genericPoint_of_mem_support Δj hEΔj hcoh
      have hjS : Δj ≠ S := by
        rintro rfl
        have hTV : T.genericPoint ∈ μ ⁻¹ᵁ D.supp.compl := by
          change μ T.genericPoint ∈ D.supp.compl; rw [hT]; exact hηS
        have := eq_of_map_eq_of_isIso μ hV hηE hTV (by rw [heq, hT])
        exact hET (AlgebraicGeometry.PrimeDivisor.genericPoint_injective this)
      refine DivisorWithCoeffs.support_subset_supp (E := Δj) ?_ ?_
      · rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
          Finsupp.single_apply, if_neg (Ne.symm hjS), sub_zero]
        exact hΔj
      · have hsp : E.genericPoint ⤳ T.idealSheaf.subschemeι x := by
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyE
          exact specializes_iff_mem_closure.mpr hyE
        have hsp' := hsp.map μ.continuous
        rw [heq] at hsp'
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact specializes_iff_mem_closure.mp hsp'

/-- The support of a reduced sum of prime divisors is their union. -/
private theorem mem_supp_sum_single_iff {Y : Scheme.{0}} (s : Finset (MMP.Mori.PrimeDivisor Y))
    (y : Y) : y ∈ DivisorWithCoeffs.supp (∑ E ∈ s, Finsupp.single E (1 : ℤ)) ↔
      ∃ E ∈ s, y ∈ E.support := by
  classical
  have hco : ∀ P, (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).coeff P =
      if P ∈ s then 1 else 0 := fun P => by
    rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
    simp [Finsupp.single_apply]
  rw [DivisorWithCoeffs.mem_supp_iff]
  constructor
  · rintro ⟨E, hE, hy⟩
    rw [hco] at hE
    split_ifs at hE with h
    · exact ⟨E, h, hy⟩
    · exact absurd rfl hE
  · rintro ⟨E, hE, hy⟩
    exact ⟨E, by rw [hco, if_pos hE]; norm_num, hy⟩

/-- **The strict transform of a component is a log resolution.** Let `μ : Y ⟶ X` be a log
resolution of `Δ + D` which is an isomorphism away from `Supp D`, `S` a component of the reduced
`Δ` off `Supp D` and smooth, and `μ_T : T ⟶ S` the restriction of `μ` to the strict transform.
Then `μ_T` is a log resolution of `(S, Θ + D|_S)`, `Θ = (Δ - S)|_S`: its exceptional set and the
preimage of `Supp (Θ + D|_S)` are `T ∩` the other components, an snc divisor on `T`. -/
private theorem isLogResolution_strictTransform {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsSmoothVariety k sX] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) {Δ : Divisor X} (hΔ : MMP.Intersection.IsReducedEffective Δ)
    {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ)
    (hV : IsIso (μ ∣_ D.supp.compl)) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    (hηS : S.genericPoint ∉ D.supp) [IsLocallyNoetherian S.idealSheaf.subscheme]
    [IsNormal S.idealSheaf.subscheme] [Smooth (S.idealSheaf.subschemeι ≫ sX)]
    (hSv : IsNormalVariety k (S.idealSheaf.subschemeι ≫ sX))
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ) :
    MMP.Fourfold.IsLogResolution (S.idealSheaf.subschemeι ≫ sX)
      (Divisor.toQDivisor ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) +
        D.restrictPrimeDivisor S) μT := by
  classical
  haveI := S.integral; haveI := T.integral
  haveI : IsProper μ := hlog.isProper
  have hsmY : MMP.Mori.IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  haveI : Smooth (μ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : AlgebraicGeometry.IsVariety k (μ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ ≫ sX)).mpr inferInstance
  haveI : IsSmoothVariety k (μ ≫ sX) := (isSmoothVariety_iff k _).2 ⟨hY.1, inferInstance⟩
  obtain ⟨s₀, hs₀, hsnc₀⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  -- `T` is a component of the snc divisor
  have hT₀ : T ∈ s₀ := by
    have hmem : T.genericPoint ∈ ⋃ E ∈ s₀, (E.support : Set Y) := by
      rw [hs₀]
      refine Or.inr ?_
      change μ T.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
      rw [QDivisor.supp_toRDivisor, hT]
      refine DivisorWithCoeffs.support_subset_supp (E := S) ?_ (by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)
      rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, hS]
      have := hD0 S
      intro h; push_cast at h; linarith
    obtain ⟨E, hE, hTE⟩ := Set.mem_iUnion₂.mp hmem
    have hEE := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hTE
    first | rwa [hEE] | rwa [← hEE]
  have hTsm : MMP.Mori.IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ ≫ sX) :=
    hsnc₀.1 T (by
      rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
      simp [Finsupp.single_apply, hT₀])
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hTsm
  haveI : IsLocallyNoetherian T.idealSheaf.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian (T.idealSheaf.subschemeι ≫ μ ≫ sX)
  haveI : IsNormal T.idealSheaf.subscheme :=
    AlgebraicGeometry.isNormal_of_smooth_over_field (T.idealSheaf.subschemeι ≫ μ ≫ sX)
  haveI : CompactSpace T.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace T.idealSheaf.subschemeι
  -- the other components restrict to an snc divisor on `T`
  have hsum : (∑ E ∈ s₀, Finsupp.single E (1 : ℤ)) =
      Finsupp.single T 1 + ∑ E ∈ s₀.erase T, Finsupp.single E (1 : ℤ) :=
    (Finset.add_sum_erase s₀ _ hT₀).symm
  obtain ⟨hRsnc, hR1⟩ := MMP.Mori.DivisorWithCoeffs.isSNC_restrictPrimeDivisor_sum_single
    (μ ≫ sX) T (s₀.erase T) (Finset.notMem_erase T s₀) (hsum ▸ hsnc₀)
  set B : Divisor Y := ∑ E ∈ s₀.erase T, Finsupp.single E (1 : ℤ) with hB
  set R := B.restrictPrimeDivisor T with hR
  have hRsum : (∑ Q ∈ R.support, Finsupp.single Q (1 : ℤ)) = R := by
    ext Q
    rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
    by_cases hQ : Q ∈ R.support
    · rw [Finset.sum_eq_single_of_mem Q hQ (fun Q' _ hQ' => by
        rw [Finsupp.single_apply, if_neg hQ']), Finsupp.single_eq_same]
      exact (hR1 Q hQ).symm
    · rw [Finset.sum_eq_zero (fun Q' hQ' => by
        rw [Finsupp.single_apply]
        exact if_neg (fun h : Q' = Q => hQ (h ▸ hQ'))),
        (Finsupp.notMem_support_iff.mp hQ)]
  have hBT : B.coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_apply, hB, Finsupp.finset_sum_apply]
    exact Finset.sum_eq_zero fun E hE => by
      rw [Finsupp.single_apply, if_neg (Finset.ne_of_mem_erase hE)]
  have hB0 : 0 ≤ B := fun P => by
    rw [hB, Finsupp.finset_sum_apply]
    exact Finset.sum_nonneg fun E _ => by rw [Finsupp.single_apply]; split_ifs <;> norm_num
  have hs : μT ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ ≫ sX := by
    rw [← Category.assoc, hμT, Category.assoc]
  have hproj := isProjectiveMorphism_strictTransform μ hlog.isProjectiveMorphism S T μT hμT
  have hbir := isBirationalMorphism_strictTransform μ hV S (by exact hηS) T hT μT hμT
  have hsmT : MMP.Mori.IsSmoothScheme (μT ≫ S.idealSheaf.subschemeι ≫ sX) := by
    rw [hs]; exact hTsm
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) :=
    (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  have hQF : MMP.Fourfold.IsQFactorial (S.idealSheaf.subschemeι ≫ sX) :=
    ⟨hSv, fun D' => ⟨1, one_pos, by
      rw [Nat.cast_one, one_smul]; exact MMP.Fourfold.isCartier_of_isSmoothScheme hsmS D'⟩⟩
  have hTvar : AlgebraicGeometry.IsVariety k (μT ≫ S.idealSheaf.subschemeι ≫ sX) := by
    rw [hs]
    haveI : IsSeparated (T.idealSheaf.subschemeι ≫ μ ≫ sX) := inferInstance
    exact ⟨⟩
  refine ⟨⟨⟨(isProper_surjective_strictTransform μ S T hT μT hμT).1, hbir, hsmT⟩,
    MMP.Mori.isPureCodimOne_exceptionalSet_of_isQFactorial (S.idealSheaf.subschemeι ≫ sX)
      (μT ≫ S.idealSheaf.subschemeι ≫ sX) hQF hTvar μT rfl hproj hbir, ?_⟩, hproj⟩
  -- the snc condition
  refine Or.inr ⟨R.support, ?_, ?_⟩
  · ext x
    simp only [Set.mem_iUnion, exists_prop]
    change (∃ Q ∈ R.support, x ∈ Q.support) ↔ x ∈ (exceptionalSet μT : Set _) ∨
      μT x ∈ (DivisorWithCoeffs.supp (QDivisor.toRDivisor (Divisor.toQDivisor
        ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) + D.restrictPrimeDivisor S)) : Set _)
    rw [QDivisor.supp_toRDivisor]
    have h1 : (∃ Q ∈ R.support, x ∈ Q.support) ↔ x ∈ DivisorWithCoeffs.supp R := by
      rw [DivisorWithCoeffs.mem_supp_iff]
      exact ⟨fun ⟨Q, hQ, hx⟩ => ⟨Q, Finsupp.mem_support_iff.mp hQ, hx⟩,
        fun ⟨Q, hQ, hx⟩ => ⟨Q, Finsupp.mem_support_iff.mpr hQ, hx⟩⟩
    rw [h1]
    constructor
    · intro hx
      have h2 := mem_supp_of_mem_supp_restrictPrimeDivisor B T hBT hx
      rw [hB, mem_supp_sum_single_iff] at h2
      exact (mem_boundary_strictTransform_iff sX μ hY hμ hΔ hD0 hV hs₀ S hS hηS T hT μT hμT
        x).2 h2
    · intro hx
      have h2 := (mem_boundary_strictTransform_iff sX μ hY hμ hΔ hD0 hV hs₀ S hS hηS T hT μT hμT
        x).1 hx
      rw [← mem_supp_sum_single_iff] at h2
      exact mem_supp_restrictPrimeDivisor (μ ≫ sX) T B hB0 hBT h2
  · rw [hRsum, hs]
    exact hRsnc

/-- The support of a reduced sum of prime divisors over a finite set is that set. -/
private theorem support_sum_single {Y : Scheme.{0}} (s : Finset (MMP.Mori.PrimeDivisor Y)) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ)).support = s := by
  classical
  ext P
  rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
  simp only [Finsupp.single_apply, Finset.sum_ite_eq']
  split_ifs with h <;> simp [h]

/-- The coefficients of the restriction of a reduced sum of prime divisors are sums of local
intersection lengths. -/
private theorem coeff_restrictPrimeDivisor_sum_single {Y : Scheme.{0}} [NoetherianSpace Y]
    (T : MMP.Mori.PrimeDivisor Y) (s : Finset (MMP.Mori.PrimeDivisor Y)) (hT : T ∉ s)
    (Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme) :
    ((∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).restrictPrimeDivisor T).coeff Q =
      ∑ E ∈ s, (E.intersectionLength T.idealSheaf.subschemeι Q : ℤ) := by
  classical
  set B : Divisor Y := ∑ E ∈ s, Finsupp.single E (1 : ℤ) with hB
  have hBT : B.coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_apply, hB, Finsupp.finset_sum_apply]
    exact Finset.sum_eq_zero fun E hE => by
      rw [Finsupp.single_apply]; exact if_neg (fun h : E = T => hT (h ▸ hE))
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor B T hBT Q, Finsupp.sum]
  have hsupp : B.support ⊆ s := fun E hE => by
    by_contra hn
    apply Finsupp.mem_support_iff.mp hE
    rw [hB, Finsupp.finset_sum_apply]
    exact Finset.sum_eq_zero fun E' hE' => by
      rw [Finsupp.single_apply]; exact if_neg (fun h : E' = E => hn (h ▸ hE'))
  rw [Finset.sum_subset hsupp (fun E _ hE => by
    rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
  refine Finset.sum_congr rfl fun E hE => ?_
  rw [hB, Finsupp.finset_sum_apply, Finset.sum_eq_single_of_mem E hE (fun E' _ hE' => by
    rw [Finsupp.single_apply, if_neg hE']), Finsupp.single_eq_same, nsmul_eq_mul, mul_one]

/-- **Transversality of an snc divisor along a component.** If `T + ∑_{E ∈ s} E` is snc on a
smooth variety over an algebraically closed field of characteristic zero, the local intersection
lengths of the `E ∈ s` along any prime divisor of `T` add up to at most one. -/
private theorem sum_intersectionLength_le_one {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {Y : Scheme.{0}} (sY : Y ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sY]
    [Smooth sY] (T : MMP.Mori.PrimeDivisor Y) (s : Finset (MMP.Mori.PrimeDivisor Y))
    (hT : T ∉ s)
    (hsnc : DivisorWithCoeffs.IsSNC sY (Finsupp.single T (1 : ℤ) + ∑ E ∈ s, Finsupp.single E 1))
    (Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme) :
    ∑ E ∈ s, E.intersectionLength T.idealSheaf.subschemeι Q ≤ 1 := by
  classical
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : IsNoetherian Y := ⟨⟩
  obtain ⟨-, h1⟩ := MMP.Mori.DivisorWithCoeffs.isSNC_restrictPrimeDivisor_sum_single sY T s hT hsnc
  set B : Divisor Y := ∑ E ∈ s, Finsupp.single E (1 : ℤ) with hB
  have hBT : B.coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_apply, hB, Finsupp.finset_sum_apply]
    exact Finset.sum_eq_zero fun E hE => by
      rw [Finsupp.single_apply]; exact if_neg (fun h : E = T => hT (h ▸ hE))
  have hco : (B.restrictPrimeDivisor T).coeff Q =
      ∑ E ∈ s, (E.intersectionLength T.idealSheaf.subschemeι Q : ℤ) := by
    rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor B T hBT Q, Finsupp.sum]
    have hsupp : B.support ⊆ s := fun E hE => by
      by_contra hn
      apply Finsupp.mem_support_iff.mp hE
      rw [hB, Finsupp.finset_sum_apply]
      exact Finset.sum_eq_zero fun E' hE' => by
        rw [Finsupp.single_apply]; exact if_neg (fun h : E' = E => hn (h ▸ hE'))
    rw [Finset.sum_subset hsupp (fun E _ hE => by
      rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
    refine Finset.sum_congr rfl fun E hE => ?_
    rw [hB, Finsupp.finset_sum_apply, Finset.sum_eq_single_of_mem E hE (fun E' _ hE' => by
      rw [Finsupp.single_apply, if_neg hE']), Finsupp.single_eq_same, nsmul_eq_mul, mul_one]
  have hle : (B.restrictPrimeDivisor T).coeff Q ≤ 1 := by
    by_cases hQ : Q ∈ (B.restrictPrimeDivisor T).support
    · exact (h1 Q hQ).le
    · rw [DivisorWithCoeffs.coeff_apply, Finsupp.notMem_support_iff.mp hQ]; norm_num
  rw [hco] at hle
  exact_mod_cast hle

/-- **Round-down commutes with restriction along transversal components.** If, along every prime
divisor `Q` of `T`, the local intersection lengths of the components of `F` add up to at most one,
then `⌊F⌋|_T = ⌊F|_T⌋`. -/
private theorem roundDown_restrictPrimeDivisor {Y : Scheme.{0}} [NoetherianSpace Y]
    (F : QDivisor Y) (T : MMP.Mori.PrimeDivisor Y) (hFT : F.coeff T = 0)
    (h1 : ∀ Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme,
      ∑ E ∈ F.support, E.intersectionLength T.idealSheaf.subschemeι Q ≤ 1) :
    (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).restrictPrimeDivisor T =
      MMP.Intersection.WeilRDivisor.roundDown
        (QDivisor.toRDivisor (F.restrictPrimeDivisor T)) := by
  classical
  have hFT' : (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).coeff T = 0 := by
    rw [MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor, hFT]; simp
  ext Q
  change (DivisorWithCoeffs.restrictPrimeDivisor _ T).coeff Q = (MMP.Intersection.WeilRDivisor.roundDown
    (QDivisor.toRDivisor (F.restrictPrimeDivisor T))).coeff Q
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor _ T hFT' Q,
    MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor,
    DivisorWithCoeffs.coeff_restrictPrimeDivisor F T hFT Q, Finsupp.sum, Finsupp.sum]
  -- move the left sum to the support of `F`
  have hsub : (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).support ⊆
      F.support := fun E hE => by
    rw [Finsupp.mem_support_iff] at hE ⊢
    intro h0; apply hE
    change (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).coeff E = 0
    rw [MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor,
      DivisorWithCoeffs.coeff_apply, h0]; simp
  rw [Finset.sum_subset hsub (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
  have hval : ∀ E, (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)) E =
      ⌊((F E : ℚ) : ℝ)⌋ := fun E => by
    change (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).coeff E = _
    rw [MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor]; rfl
  simp only [hval]
  by_cases h : ∃ E ∈ F.support, E.intersectionLength T.idealSheaf.subschemeι Q ≠ 0
  · obtain ⟨E₀, hE₀, hl⟩ := h
    have hsum := h1 Q
    rw [← Finset.add_sum_erase _ _ hE₀] at hsum
    have hl1 : E₀.intersectionLength T.idealSheaf.subschemeι Q = 1 := by omega
    have hrest : ∀ E ∈ F.support.erase E₀, E.intersectionLength T.idealSheaf.subschemeι Q = 0 := by
      intro E hE
      have := Finset.single_le_sum (f := fun E => E.intersectionLength T.idealSheaf.subschemeι Q)
        (fun _ _ => Nat.zero_le _) hE
      omega
    rw [← Finset.add_sum_erase _ _ hE₀, ← Finset.add_sum_erase _ _ hE₀,
      Finset.sum_eq_zero (fun E hE => by rw [hrest E hE, zero_smul]),
      Finset.sum_eq_zero (fun E hE => by rw [hrest E hE, zero_smul]), hl1]
    simp
  · push Not at h
    rw [Finset.sum_eq_zero (fun E hE => by rw [h E hE, zero_smul]),
      Finset.sum_eq_zero (fun E hE => by rw [h E hE, zero_smul])]
    simp

/-- **Restriction commutes with `ℚ`-pull-back to a strict transform.** In the setting of
`isPullback_restrictPrimeDivisor_of_isPullback`, for an effective `ℚ`-divisor `D` with
`D.coeff S = 0` and pull-back `F`, with `F.coeff T = 0`, `F|_T = μ_T^*(D|_S)`. -/
private theorem qIsPullback_restrictPrimeDivisor {k : Type} [Field k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [Smooth sX] (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] [Smooth (μ ≫ sX)] (S : MMP.Mori.PrimeDivisor X)
    (T : MMP.Mori.PrimeDivisor Y)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [Smooth (S.idealSheaf.subschemeι ≫ sX)] [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme] [CompactSpace T.idealSheaf.subscheme]
    [Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX)] (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    {D : QDivisor X} (hDS : D.coeff S = 0)
    {hDμ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp}
    {F : QDivisor Y} (hF : D.IsPullback μ hDμ F) (hFT : F.coeff T = 0)
    (hDSμ : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ (D.restrictPrimeDivisor S).supp) :
    QDivisor.IsPullback μT (D.restrictPrimeDivisor S) hDSμ (F.restrictPrimeDivisor T) := by
  haveI := S.integral; haveI := T.integral
  haveI : IsNoetherian X := ⟨⟩
  haveI : IsNoetherian Y := ⟨⟩
  have hsmX : MMP.Mori.IsSmoothScheme sX := (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  intro m hm C hC hCc
  -- an integral Cartier multiple `D₀ = m' D` and its pull-back
  obtain ⟨m', hm', D₀, hD₀, hD₀c⟩ :=
    (MMP.Fourfold.isQCartier_of_isSmoothScheme hsmX D).exists_pos
  obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF m' hm' D₀ hD₀ hD₀c
  have hm'0 : ((m' : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hm'.ne'
  have hD₀S : D₀.coeff S = 0 := by
    have := congrArg (fun G : QDivisor X => G.coeff S) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, hDS, smul_zero] at this
    exact_mod_cast this
  have hD₀'T : D₀'.coeff T = 0 := by
    have := congrArg (fun G : QDivisor Y => G.coeff T) hD₀'eq
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, hFT, smul_zero] at this
    exact_mod_cast this
  have hD₀Sμ : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ (D₀.restrictPrimeDivisor S).supp := by
    intro Z hZ
    apply hDSμ Z
    have hsupp : (D₀.restrictPrimeDivisor S).supp = (D.restrictPrimeDivisor S).supp := by
      refine QDivisor.supp_eq_of_toQDivisor_eq (m := m') (by exact_mod_cast hm'.ne') ?_
      rw [← Divisor.restrictPrimeDivisor_toQDivisor D₀ S hD₀S, hD₀,
        MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_zsmul D S hDS]
    rwa [← hsupp]
  have hpb₀ := isPullback_restrictPrimeDivisor_of_isPullback sX μ S T hT μT hμT hD₀c hD₀S hD₀'
    hD₀'T hD₀Sμ
  -- `m' C = m (D₀|_S)`
  have hCeq : (m' : ℤ) • C = (m : ℤ) • D₀.restrictPrimeDivisor S := by
    apply Divisor.toQDivisor_injective
    rw [map_zsmul, map_zsmul, hC, ← Divisor.restrictPrimeDivisor_toQDivisor D₀ S hD₀S, hD₀,
      MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_zsmul D S hDS, smul_smul, smul_smul,
      mul_comm]
  have hCμ : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ C.supp := by
    intro Z hZ
    apply hDSμ Z
    rwa [QDivisor.supp_eq_of_toQDivisor_eq (m := m) (by exact_mod_cast hm.ne') hC] at hZ
  obtain ⟨C', hC'⟩ := hCc.exists_isPullback (f := μT) hCμ
  refine ⟨C', ?_, hC'⟩
  -- compare `m' C'` and `m (D₀'|_T)`, both pull-backs of `m' C`
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) :=
    (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  have hD₀Sc : Divisor.IsCartier (D₀.restrictPrimeDivisor S) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmS _
  have hsuppm : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ ((m' : ℤ) • C).supp := by
    intro Z hZ
    apply hCμ Z
    obtain ⟨E, hE, hzE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hZ
    refine DivisorWithCoeffs.support_subset_supp (E := E) (fun h0 => hE ?_) hzE
    rw [DivisorWithCoeffs.coeff_smul, h0, smul_zero]
  have h1 := hC'.zsmul hCc (m' : ℤ) hsuppm
  have h2 := hpb₀.zsmul hD₀Sc (m : ℤ) (by rw [← hCeq]; exact hsuppm)
  have h3 : ((m' : ℤ) • C).IsPullback μT hsuppm ((m : ℤ) • D₀'.restrictPrimeDivisor T) :=
    MMP.Mori.Divisor.IsPullback.of_eq hCeq.symm h2
  have h4 := MMP.Mori.Divisor.IsPullback.eq (hCc.zsmul (m' : ℤ)) h1 h3
  -- conclude: `m' C' = m (D₀'|_T)` and `D₀' = m' F`
  have hD₀'R : Divisor.toQDivisor (D₀'.restrictPrimeDivisor T) =
      (m' : ℤ) • F.restrictPrimeDivisor T := by
    rw [← Divisor.restrictPrimeDivisor_toQDivisor D₀' T hD₀'T, hD₀'eq,
      MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_zsmul F T hFT]
  have h5 := congrArg Divisor.toQDivisor h4
  rw [map_zsmul, map_zsmul, hD₀'R, smul_smul, mul_comm, ← smul_smul] at h5
  ext Q
  have := congrArg (fun G : QDivisor T.idealSheaf.subscheme => G.coeff Q) h5
  simp only [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] at this
  change (Divisor.toQDivisor C').coeff Q = ((m : ℤ) • F.restrictPrimeDivisor T).coeff Q
  rw [DivisorWithCoeffs.coeff_smul, zsmul_eq_mul]
  exact mul_left_cancel₀ hm'0 this

/-- **Adjunction for log discrepancies along a strict transform.** Let `μ : Y ⟶ X` be a proper
birational morphism of smooth varieties which is an isomorphism over an open `V`, `S ⊆ X` a smooth
prime divisor with generic point in `V`, `T ⊆ Y` its strict transform with `μ_T : T ⟶ S`, `ω` a
rational top form on `X` with a simple pole along `S`, `B` a divisor with `coeff_S B = 1`, and
`K_μ = μ^*(div ω + B)`. Then for every prime divisor `Q` of `T`,
`a(Q, S, (B - S)|_S) = 1 + coeff_Q((div μ^*ω + T - K_μ)|_T)`: the residue of `ω` along `S` pulls
back to the residue of `μ^*ω` along `T`, and `div(Res_S ω) + (B - S)|_S = (div ω + B)|_S`. -/
private theorem isLogDiscrepancy_strictTransform {k : Type} [Field k] [PerfectField k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] [Smooth sX] (hX : IsNormalVariety k sX) {n : ℕ}
    (hdim : topologicalKrullDim X = ((n + 1 : ℕ) : WithBot ℕ∞))
    (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    [Smooth (μ ≫ sX)] [IsProper μ] [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) {V : X.Opens}
    (hV : IsIso (μ ∣_ V)) (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme] [Smooth (S.idealSheaf.subschemeι ≫ sX)]
    (hSV : S.genericPoint ∈ V) (hSv : IsNormalVariety k (S.idealSheaf.subschemeι ≫ sX))
    (T : MMP.Mori.PrimeDivisor Y) [IsLocallyNoetherian T.idealSheaf.subscheme]
    [IsNormal T.idealSheaf.subscheme] [CompactSpace T.idealSheaf.subscheme]
    [Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX)] (hT : μ T.genericPoint = S.genericPoint)
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    (hTv : IsNormalVariety k (μT ≫ S.idealSheaf.subschemeι ≫ sX))
    (hμTb : IsBirationalMorphism μT)
    {ω : RationalPluriForms sX (n + 1) 1} (hω0 : ω ≠ 0) (hωS : S.ordForm ω = -1)
    (B : Divisor X) (hBS : B.coeff S = 1) {Kμ : Divisor Y}
    (hKμ : ∃ h, (divisorOfForm ω + B).IsPullback μ h Kμ)
    (Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme) :
    haveI := S.integral
    MMP.Intersection.IsLogDiscrepancy (S.idealSheaf.subschemeι ≫ sX) n
      (Divisor.toRDivisor ((B - Finsupp.single S 1).restrictPrimeDivisor S))
      ⟨T.idealSheaf.subscheme, μT, hTv, hμTb, Q⟩
      (1 + ((((divisorOfForm (pullbackRationalPluriForms sX μ ω) + Finsupp.single T 1 - Kμ :
        Divisor Y).restrictPrimeDivisor T).coeff Q : ℤ) : ℝ)) := by
  haveI := S.integral; haveI := T.integral
  haveI : LocallyOfFiniteType sX := inferInstance
  haveI : LocallyOfFiniteType (μ ≫ sX) := inferInstance
  haveI : LocallyOfFiniteType (S.idealSheaf.subschemeι ≫ sX) := inferInstance
  have hdimX : topologicalKrullDim X = (n : WithBot ℕ∞) + 1 := by rw [hdim]; norm_cast
  -- the residue `ρ` of `ω` along `S`
  obtain ⟨ρ, hρu, hρ0, hρdiv, hρpb⟩ :=
    MMP.Mori.existsUnique_isPoincareResidue_of_ordForm_eq_neg_one sX hdimX
      S.idealSheaf.subschemeι S rfl ω hω0 hωS
  -- the pull-back of `ω` has a simple pole along `T`
  have hbir : MMP.Mori.biregularLocus μ ≥ V := MMP.Mori.le_biregularLocus hV
  have hηT : μ T.genericPoint ∈ MMP.Mori.biregularLocus μ := hbir (hT ▸ hSV)
  haveI hstalk : IsIso (μ.stalkMap T.genericPoint) :=
    MMP.Threefold.Resolution.isIso_stalkMap_of_mem_biregularLocus μ hηT
  haveI : IsDominant μT := by
    haveI := (isProper_surjective_strictTransform μ S T hT μT hμT).2
    infer_instance
  have hd : (letI := functionFieldAlgebra sX; (Algebra.trdeg k X.functionField).toNat = n + 1) :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hdim
  have hτT : T.ordForm (pullbackRationalPluriForms sX μ ω) = -1 := by
    rw [MMP.Positivity.ordForm_pullbackRationalPluriForms_of_isIso μ hμ.functionFieldMap_bijective hd T S hT ω,
      hωS]
  have hτ0 : pullbackRationalPluriForms sX μ ω ≠ 0 :=
    MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' μ hμ.functionFieldMap_bijective hd
      hω0
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  have hdimY : topologicalKrullDim Y = (n : WithBot ℕ∞) + 1 := by
    rw [← MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ, hdimX]
  -- the residue `ρ'` of `μ^*ω` along `T`
  obtain ⟨ρ', hρ'u, -, hρ'div, -⟩ :=
    MMP.Mori.existsUnique_isPoincareResidue_of_ordForm_eq_neg_one (μ ≫ sX) hdimY
      T.idealSheaf.subschemeι T rfl _ hτ0 hτT
  have hres := hρpb μ hμ V hSV T.idealSheaf.subschemeι μT hμT
  have heq := (hρ'u _).1 hres
  -- the order of the pulled-back residue
  have hs : μT ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ ≫ sX := by
    rw [← Category.assoc, hμT, Category.assoc]
  have hord : Q.ordForm (pullbackRationalPluriForms (S.idealSheaf.subschemeι ≫ sX) μT ρ) =
      ((divisorOfForm (pullbackRationalPluriForms sX μ ω) + Finsupp.single T 1 :
        Divisor Y).restrictPrimeDivisor T).coeff Q := by
    have hc := ordForm_cast hs (by rw [hs])
      (pullbackRationalPluriForms (S.idealSheaf.subschemeι ≫ sX) μT ρ) Q
    rw [heq] at hc
    rw [← hc, ← coeff_divisorOfForm, hρ'div]
  -- a canonical divisor of `S`
  have hdimS := topologicalKrullDim_primeDivisor_eq sX hdim S
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) :=
    (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  haveI : MMP.Mori.IsVariety k (S.idealSheaf.subschemeι ≫ sX) := hSv.1
  obtain ⟨KS, hKS⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme _ hsmS hdimS
  have hKρ := isCanonicalDivisor_divisorOfForm hSv hKS hρ0
  -- `div ρ + (B - S)|_S = (div ω + B)|_S`
  have hωS' : (divisorOfForm ω + Finsupp.single S 1 : Divisor X).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, hωS,
      DivisorWithCoeffs.coeff_apply (Finsupp.single S 1), Finsupp.single_eq_same]; norm_num
  have hBS' : (B - Finsupp.single S 1 : Divisor X).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_sub, hBS, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_eq_same]; norm_num
  have hC : divisorOfForm ρ + (B - Finsupp.single S 1).restrictPrimeDivisor S =
      (divisorOfForm ω + B).restrictPrimeDivisor S := by
    rw [hρdiv]
    change (divisorOfForm ω + Finsupp.single S 1 : Divisor X).restrictPrimeDivisor S + _ = _
    rw [← MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hωS' hBS']
    congr 1; abel
  -- `K_μ` has coefficient zero along `T`
  have hCS : (divisorOfForm ω + B).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, hωS, hBS]; norm_num
  have hsmX : MMP.Mori.IsSmoothScheme sX := (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  have hCc : (divisorOfForm ω + B).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmX _
  obtain ⟨hKμs, hKμ'⟩ := hKμ
  have hKμT : Kμ.coeff T = 0 :=
    coeff_isPullback_eq_zero (F := ⟨Y, μ, hY, hμ, T⟩) hCc
      (by change μ T.genericPoint ∉ _; rw [hT]
          exact genericPoint_notMem_supp_of_coeff_eq_zero _ S hCS) Kμ hKμs hKμ'
  -- the pull-back of `(div ω + B)|_S` to `T` is `K_μ|_T`
  have hCSμ : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ (DivisorWithCoeffs.supp
        ((divisorOfForm ω + B).restrictPrimeDivisor S)) := by
    intro Z
    rw [componentGenericPoint_eq_genericPoint',
      map_genericPoint_strictTransform μ S T hT μT hμT]
    exact genericPoint_notMem_supp _
  have hpb := isPullback_restrictPrimeDivisor_of_isPullback sX μ S T hT μT hμT hCc hCS hKμ'
    hKμT hCSμ
  have hp := (isProper_surjective_strictTransform μ S T hT μT hμT).1
  have hsmS' : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) := hsmS
  have key : ∀ (A : Divisor S.idealSheaf.subscheme)
      (_ : A = (divisorOfForm ω + B).restrictPrimeDivisor S)
      (hA : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
        μT (componentGenericPoint _ Z) ∉ DivisorWithCoeffs.supp A),
      Divisor.IsPullback μT A hA (Kμ.restrictPrimeDivisor T) := by
    rintro A rfl hA
    exact hpb
  have hA : ∀ Z : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ Z) ∉ DivisorWithCoeffs.supp
        (divisorOfForm ρ + (B - Finsupp.single S 1).restrictPrimeDivisor S) := by
    rw [hC]; exact hCSμ
  have hlog := isLogDiscrepancy_of_isPullback (S.idealSheaf.subschemeι ≫ sX) hSv hρ0 hKρ
    ((B - Finsupp.single S 1).restrictPrimeDivisor S)
    (MMP.Fourfold.isCartier_of_isSmoothScheme hsmS' _)
    ⟨T.idealSheaf.subscheme, μT, hTv, hμTb, Q⟩ hp (Kμ.restrictPrimeDivisor T)
    ⟨hA, key _ hC hA⟩
  convert hlog using 1
  have hA : (divisorOfForm (pullbackRationalPluriForms sX μ ω) + Finsupp.single T 1 :
      Divisor Y).coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_add, coeff_divisorOfForm, hτT,
      DivisorWithCoeffs.coeff_apply (Finsupp.single T 1), Finsupp.single_eq_same]; norm_num
  rw [restrictPrimeDivisor_sub _ _ T hA hKμT, DivisorWithCoeffs.coeff_sub, ← hord]
  change _ = 1 + ((Q.ordForm (pullbackRationalPluriForms (S.idealSheaf.subschemeι ≫ sX) μT ρ) :
    ℤ) : ℝ) - _
  push_cast
  ring

/-- **The adjoint data on the strict transform.** In the setting of
`isLogResolution_strictTransform`, with `Γ` the zero places of `(X, Δ)` and `E` the adjoint
discrepancy divisor on `Y`, the restrictions `Γ_T = (Γ - T)|_T` and `E_T = E|_T` are the zero
places of `(S, Θ)` and the adjoint discrepancy divisor on `T`: by adjunction
`a(Q, S, Θ) = 1 + coeff_Q(E_T) - coeff_Q(Γ_T)`. -/
private theorem adjointData_strictTransform {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsSmoothVariety k sX] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX) (μ : Y ⟶ X) [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [IsDominant μ]
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ)
    (hV : IsIso (μ ∣_ D.supp.compl)) {Γ E : Divisor Y}
    (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) (hηS : S.genericPoint ∉ D.supp)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [CompactSpace S.idealSheaf.subscheme] [Smooth (S.idealSheaf.subschemeι ≫ sX)]
    (hSv : IsNormalVariety k (S.idealSheaf.subschemeι ≫ sX))
    (hΘ : IsReducedSNC (S.idealSheaf.subschemeι ≫ sX) ((Δ - Finsupp.single S 1).restrictPrimeDivisor S))
    (hDSns : ContainsNoStratum ((Δ - Finsupp.single S 1).restrictPrimeDivisor S)
      (D.restrictPrimeDivisor S).supp)
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint)
    [IsLocallyNoetherian T.idealSheaf.subscheme] [IsNormal T.idealSheaf.subscheme]
    [CompactSpace T.idealSheaf.subscheme] [Smooth (T.idealSheaf.subschemeι ≫ μ ≫ sX)]
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ)
    (hTv : IsNormalVariety k (μT ≫ S.idealSheaf.subschemeι ≫ sX))
    (hμTb : IsBirationalMorphism μT) :
    haveI := S.integral
    E.coeff T = 0 ∧ Γ.coeff T = 1 ∧
      IsZeroLogDiscrepancyDivisor (S.idealSheaf.subschemeι ≫ sX) μT hTv hμTb
        ((Δ - Finsupp.single S 1).restrictPrimeDivisor S)
        ((Γ - Finsupp.single T 1).restrictPrimeDivisor T) ∧
      IsAdjointDiscrepancyDivisor (S.idealSheaf.subschemeι ≫ sX) μT hTv hμTb
        ((Δ - Finsupp.single S 1).restrictPrimeDivisor S)
        ((Γ - Finsupp.single T 1).restrictPrimeDivisor T) (E.restrictPrimeDivisor T) := by
  classical
  haveI := S.integral; haveI := T.integral
  haveI : IsIntegral X := (inferInstance : AlgebraicGeometry.IsVariety k sX).toIsIntegral
  haveI : IsProper μ := hlog.isProper
  haveI : IsNoetherian Y := ⟨⟩
  have hsmX : MMP.Mori.IsSmoothScheme sX := (MMP.Mori.isSmoothScheme_iff sX).2 inferInstance
  have hsmY : MMP.Mori.IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  haveI : Smooth (μ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : AlgebraicGeometry.IsVariety k (μ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ ≫ sX)).mpr inferInstance
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) :=
    (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
  -- the dimension of `X` is `n + 1`
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hd0 : d ≠ 0 := by
    rintro rfl
    have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX S.genericPoint
    rw [S.coheight_genericPoint, hd] at h
    have hne : topologicalKrullDim (closure {S.genericPoint} : Set X) ≠ ⊥ :=
      (Order.krullDim_ne_bot_iff (α := IrreducibleCloseds (closure {S.genericPoint} : Set X))).mpr
        ⟨IrreducibleCloseds.closureSingleton ⟨S.genericPoint, subset_closure rfl⟩⟩
    obtain ⟨b, hb⟩ := WithBot.ne_bot_iff_exists.mp hne
    rw [← hb] at h
    norm_cast at h
    simp at h
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hd0
  -- a form with a simple pole along `S`
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsmX hd
  obtain ⟨ω, hω0, hωK, hωS⟩ := exists_ordForm_eq_neg_one sX hX hK S
  have hC : (divisorOfForm ω + Δ).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmX _
  obtain ⟨Kμ, hKμ⟩ := hC.exists_isPullback
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _)
  have hEeq := eq_of_isAdjointDiscrepancyDivisor sX hX hω0 hωK Δ hC μ hY hμ hlog.isProper hE
    ⟨_, hKμ⟩
  -- `E` and `Γ` along `T`
  have hbirT : μ T.genericPoint ∈ MMP.Mori.biregularLocus μ :=
    MMP.Mori.le_biregularLocus hV (by change μ T.genericPoint ∈ D.supp.compl; rw [hT]; exact hηS)
  obtain ⟨Q₀, hQ₀, hET, hΓT⟩ := coeff_eq_of_mem_biregularLocus sX hX hd hω0 hωK hΔ.1 hC μ hY hμ
    hlog.isProper hΓ ⟨_, hKμ⟩ hEeq T hbirT
  have hQ₀S : Q₀ = S := AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hQ₀.symm.trans hT)
  rw [hQ₀S, hS] at hΓT
  -- the zero places and the support of `E` lie over the isomorphism locus, respectively `Supp D`
  have hΓbir : ∀ P : MMP.Mori.PrimeDivisor Y, Γ.coeff P = 1 →
      μ P.genericPoint ∈ MMP.Mori.biregularLocus μ := by
    intro P hP
    obtain ⟨n', h0⟩ := (hΓ.2 P).1 hP
    exact MMP.Mori.le_biregularLocus hV
      (notMem_of_isLogDiscrepancy_eq_zero hX hsmX hΔ D.isClosed_supp hDns h0)
  have hEbir : ∀ P : MMP.Mori.PrimeDivisor Y, E.coeff P ≠ 0 →
      μ P.genericPoint ∉ MMP.Mori.biregularLocus μ := by
    intro P hP hb
    obtain ⟨-, -, h0, -⟩ := coeff_eq_of_mem_biregularLocus sX hX hd hω0 hωK hΔ.1 hC μ hY hμ
      hlog.isProper hΓ ⟨_, hKμ⟩ hEeq P hb
    exact hP h0
  -- the components of the snc divisor
  obtain ⟨s₀, hs₀, hsnc₀⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hmem₀ : ∀ P : MMP.Mori.PrimeDivisor Y,
      μ P.genericPoint ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D) → P ∈ s₀ := by
    intro P hP
    have hmem : P.genericPoint ∈ ⋃ E ∈ s₀, (E.support : Set Y) := by
      rw [hs₀]
      refine Or.inr ?_
      change μ P.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
      rw [QDivisor.supp_toRDivisor]
      exact hP
    obtain ⟨E', hE', hPE'⟩ := Set.mem_iUnion₂.mp hmem
    have hEE := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'
    first | rwa [hEE] | rwa [← hEE]
  have hΔ0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor Δ).coeff P := fun P => by
    rw [Divisor.coeff_toQDivisor]; rcases hΔ.1 P with h | h <;> rw [h] <;> norm_num
  have hΓs₀ : ∀ P : MMP.Mori.PrimeDivisor Y, Γ.coeff P = 1 → P ∈ s₀ := by
    intro P hP
    obtain ⟨Q, hQ, -, hΓP⟩ := coeff_eq_of_mem_biregularLocus sX hX hd hω0 hωK hΔ.1 hC μ hY hμ
      hlog.isProper hΓ ⟨_, hKμ⟩ hEeq P (hΓbir P hP)
    refine hmem₀ P ((mem_supp_add_iff hΔ0 hD0).2 (Or.inl ?_))
    rw [Divisor.supp_toQDivisor, hQ]
    refine DivisorWithCoeffs.support_subset_supp (E := Q) (by rw [← hΓP, hP]; norm_num) ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hEs₀ : ∀ P : MMP.Mori.PrimeDivisor Y, E.coeff P ≠ 0 → P ∈ s₀ := by
    intro P hP
    refine hmem₀ P ((mem_supp_add_iff hΔ0 hD0).2 (Or.inr ?_))
    by_contra hn
    exact hEbir P hP (MMP.Mori.le_biregularLocus hV hn)
  -- `Γ - T` is the reduced sum of the other zero places
  set sΓ := Γ.support.erase T with hsΓ
  have hΓsum : Γ - Finsupp.single T 1 = ∑ P ∈ sΓ, Finsupp.single P (1 : ℤ) := by
    ext P
    rw [DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
    simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_apply]
    by_cases hPT : P = T
    · subst hPT
      have : (Γ : MMP.Mori.PrimeDivisor Y → ℤ) P = 1 := hΓT
      rw [this, if_pos rfl]
      simp [sΓ]
    · rw [if_neg (Ne.symm hPT), sub_zero]
      rcases hΓ.1 P with h0 | h1
      · have h0' : (Γ : MMP.Mori.PrimeDivisor Y → ℤ) P = 0 := h0
        rw [h0']
        refine (Finset.sum_eq_zero fun P' hP' => ?_).symm
        rw [if_neg]
        rintro rfl
        exact (Finsupp.mem_support_iff.mp (Finset.mem_of_mem_erase hP')) h0'
      · have h1' : (Γ : MMP.Mori.PrimeDivisor Y → ℤ) P = 1 := h1
        rw [h1', Finset.sum_eq_single_of_mem P (Finset.mem_erase.mpr ⟨hPT,
          Finsupp.mem_support_iff.mpr (by rw [h1']; norm_num)⟩) (fun P' _ hP' => if_neg hP'),
          if_pos rfl]
  -- the adjunction on `T`
  have hadj := fun Q => isLogDiscrepancy_strictTransform sX hX hd μ hY hμ hV S hηS hSv T hT μT
    hμT hTv hμTb hω0 hωS Δ hS ⟨_, hKμ⟩ Q
  have hΓT' : (Γ - Finsupp.single T 1 : Divisor Y).coeff T = 0 := by
    rw [DivisorWithCoeffs.coeff_sub, hΓT, DivisorWithCoeffs.coeff_apply (Finsupp.single T 1),
      Finsupp.single_eq_same]; norm_num
  have hid : (divisorOfForm (pullbackRationalPluriForms sX μ ω) + Finsupp.single T 1 - Kμ :
      Divisor Y) = E - (Γ - Finsupp.single T 1) := by rw [hEeq]; abel
  have hval : ∀ Q, (((divisorOfForm (pullbackRationalPluriForms sX μ ω) + Finsupp.single T 1 - Kμ :
      Divisor Y).restrictPrimeDivisor T).coeff Q : ℤ) = (E.restrictPrimeDivisor T).coeff Q -
        ((Γ - Finsupp.single T 1).restrictPrimeDivisor T).coeff Q := fun Q => by
    rw [hid, restrictPrimeDivisor_sub _ _ T hET hΓT', DivisorWithCoeffs.coeff_sub]
  have hΓco : ∀ Q, ((Γ - Finsupp.single T 1).restrictPrimeDivisor T).coeff Q =
      ∑ P ∈ sΓ, (P.intersectionLength T.idealSheaf.subschemeι Q : ℤ) := fun Q => by
    rw [hΓsum, coeff_restrictPrimeDivisor_sum_single T sΓ (Finset.notMem_erase T _) Q]
  have hEco : ∀ Q, (E.restrictPrimeDivisor T).coeff Q =
      ∑ P ∈ E.support, P.intersectionLength T.idealSheaf.subschemeι Q • E P := fun Q => by
    rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor E T hET Q, Finsupp.sum]
  -- transversality of the zero places and the support of `E` along `T`
  have hdisj : Disjoint sΓ E.support := by
    rw [Finset.disjoint_left]
    intro P hP hPE
    have hΓP : Γ.coeff P = 1 := by
      rcases hΓ.1 P with h0 | h1
      · exact absurd h0 (Finsupp.mem_support_iff.mp (Finset.mem_of_mem_erase hP))
      · exact h1
    exact hEbir P (Finsupp.mem_support_iff.mp hPE) (hΓbir P hΓP)
  have hTnot : T ∉ sΓ ∪ E.support := by
    rw [Finset.mem_union, not_or]
    exact ⟨Finset.notMem_erase T _, fun h => Finsupp.mem_support_iff.mp h hET⟩
  have hsnc' : DivisorWithCoeffs.IsSNC (μ ≫ sX)
      (Finsupp.single T (1 : ℤ) + ∑ E' ∈ sΓ ∪ E.support, Finsupp.single E' 1) := by
    refine hsnc₀.of_support_subset ?_
    rw [← Finset.sum_insert (f := fun E' => Finsupp.single E' (1 : ℤ)) hTnot, support_sum_single,
      support_sum_single]
    intro P hP
    rcases Finset.mem_insert.mp hP with rfl | hP
    · exact hΓs₀ _ hΓT
    rcases Finset.mem_union.mp hP with hP | hP
    · rcases hΓ.1 P with h0 | h1
      · exact absurd h0 (Finsupp.mem_support_iff.mp (Finset.mem_of_mem_erase hP))
      · exact hΓs₀ P h1
    · exact hEs₀ P (Finsupp.mem_support_iff.mp hP)
  have hlen := sum_intersectionLength_le_one (μ ≫ sX) T _ hTnot hsnc'
  have hsplit : ∀ Q, ∑ P ∈ sΓ ∪ E.support, P.intersectionLength T.idealSheaf.subschemeι Q =
      (∑ P ∈ sΓ, P.intersectionLength T.idealSheaf.subschemeι Q) +
        ∑ P ∈ E.support, P.intersectionLength T.idealSheaf.subschemeι Q :=
    fun Q => Finset.sum_union hdisj
  -- `E|_T` vanishes along `Q` once no component of `E` meets `η_Q`
  have hE0 : ∀ Q, (∀ P ∈ E.support, P.intersectionLength T.idealSheaf.subschemeι Q = 0) →
      (E.restrictPrimeDivisor T).coeff Q = 0 := fun Q h => by
    rw [hEco]; exact Finset.sum_eq_zero fun P hP => by rw [h P hP, zero_smul]
  have hDS : D.coeff S = 0 := by
    by_contra hne
    exact hηS (DivisorWithCoeffs.support_subset_supp hne (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl))
  refine ⟨hET, hΓT, ⟨fun Q => ?_, fun Q => ⟨fun h1 => ?_, fun ⟨n', h0⟩ => ?_⟩⟩,
    fun Q => ⟨n, _, hadj Q, ?_⟩⟩
  · -- `Γ_T` is reduced
    rw [hΓco]
    have h1 := hlen Q
    rw [hsplit] at h1
    have : ∑ P ∈ sΓ, P.intersectionLength T.idealSheaf.subschemeι Q ≤ 1 := by omega
    push_cast
    interval_cases h : ∑ P ∈ sΓ, P.intersectionLength T.idealSheaf.subschemeι Q
    · left; rw [← Nat.cast_sum, h]; norm_num
    · right; rw [← Nat.cast_sum, h]; norm_num
  · -- a component of `Γ_T` has log discrepancy zero
    have h1' := hlen Q
    rw [hsplit] at h1'
    rw [hΓco] at h1
    have hs1 : ∑ P ∈ sΓ, P.intersectionLength T.idealSheaf.subschemeι Q = 1 := by
      exact_mod_cast h1
    have hEz : (E.restrictPrimeDivisor T).coeff Q = 0 := hE0 Q fun P hP => by
      have := Finset.single_le_sum (f := fun P => P.intersectionLength T.idealSheaf.subschemeι Q)
        (fun _ _ => Nat.zero_le _) hP
      omega
    refine ⟨n, ?_⟩
    convert hadj Q using 1
    rw [hval, hEz, hΓco, ← Nat.cast_sum, hs1]
    norm_num
  · -- a divisor of log discrepancy zero lies over the isomorphism locus
    have hu := MMP.Threefold.Bridges.IsLogDiscrepancy.unique h0 (hadj Q)
    rw [hval] at hu
    have hzS := notMem_of_isLogDiscrepancy_eq_zero hSv hsmS hΘ
      (DivisorWithCoeffs.supp (D.restrictPrimeDivisor S)).isClosed hDSns h0
    change μT Q.genericPoint ∉ (DivisorWithCoeffs.supp (D.restrictPrimeDivisor S) : Set _) at hzS
    have hμy : μ (T.idealSheaf.subschemeι Q.genericPoint) =
        S.idealSheaf.subschemeι (μT Q.genericPoint) := by
      change (T.idealSheaf.subschemeι ≫ μ) _ = (μT ≫ S.idealSheaf.subschemeι) _
      rw [hμT]
    have hyD : μ (T.idealSheaf.subschemeι Q.genericPoint) ∉ D.supp := by
      rw [hμy]
      intro h
      exact hzS ((mem_supp_restrictPrimeDivisor_iff_qDivisor sX S D hD0 hDS _).2 h)
    have hEz : (E.restrictPrimeDivisor T).coeff Q = 0 := hE0 Q fun P hP => by
      by_contra hl
      have hmem : T.idealSheaf.subschemeι Q.genericPoint ∈ P.support := by
        by_contra hn
        exact hl (MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ P hn)
      have hηP : P.genericPoint ∈ μ ⁻¹ᵁ D.supp.compl :=
        (P.genericPoint_mem_iff _).mpr ⟨_, hmem, hyD⟩
      exact hEbir P (Finsupp.mem_support_iff.mp hP) (MMP.Mori.le_biregularLocus hV hηP)
    rw [hEz] at hu
    have : (((Γ - Finsupp.single T 1).restrictPrimeDivisor T).coeff Q : ℝ) = 1 := by
      push_cast at hu ⊢; linarith
    exact_mod_cast this
  · -- the adjoint discrepancy divisor
    rw [hval]; push_cast; ring

end Adjunction

/-! ### The good resolution and the strict transform of `S` -/

section Setup

open MMP.Mori

/-- A projective morphism to an affine scheme has an ample invertible module on its source. -/
private theorem exists_isAmple_of_isProjectiveMorphism_of_isAffine {X Z : Scheme.{0}}
    (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] :
    ∃ (M : X.Modules) (_ : Stacks.Ample.IsInvertibleModule X M), Stacks.Ample.IsAmple X M := by
  obtain ⟨-, M, hMinv, hMamp⟩ :=
    Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective f hf.isHQuasiProjective
  exact ⟨M, hMinv, Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f M hMamp⟩

/-- A component `S` of `Δ` is a stratum of `Δ`, so its generic point lies off a closed subset
containing no stratum. -/
private theorem genericPoint_notMem_of_containsNoStratum {X : Scheme.{0}} {Δ : Divisor X}
    {S : MMP.Mori.PrimeDivisor X} (hS : Δ.coeff S = 1) {Z : Set X} (hZ : IsClosed Z)
    (hns : ContainsNoStratum Δ Z) : S.genericPoint ∉ Z := by
  classical
  intro hη
  apply hns S.support ⟨{S}, by
    intro E hE; rw [Finset.mem_singleton] at hE; subst hE
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, hS]; norm_num, ?_⟩
  · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact hZ.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη)
  · refine ⟨⟨?_, by simp⟩, fun W ⟨hW, hWS⟩ hSW => ?_⟩
    · rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
    · simpa using hWS

/-- The `ℚ`-pull-back of `D` vanishes along prime divisors lying over the complement of
`Supp D`. -/
private theorem coeff_qIsPullback_eq_zero {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hX : IsNormalVariety k sX) (hsm : MMP.Mori.IsSmoothScheme sX) (μ : Y ⟶ X) [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) {D : QDivisor X}
    {hD : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ D.supp}
    {F : QDivisor Y} (hF : D.IsPullback μ hD F) (P : MMP.Mori.PrimeDivisor Y)
    (hP : μ P.genericPoint ∉ D.supp) : F.coeff P = 0 := by
  obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hmD.ne') hD₀
  have h1 := coeff_isPullback_eq_zero (F := ⟨Y, μ, hY, hμ, P⟩) hD₀c
    (by rw [hsupp]; exact hP) D₀' _ hD₀'
  have h2 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
    Int.cast_natCast] at h2
  change D₀'.coeff P = 0 at h1
  rw [h1, Int.cast_zero] at h2
  have hmD0 : (mD : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
  exact (mul_eq_zero.mp h2.symm).resolve_left hmD0

/-- **Removing `S` from the boundary on a resolution which is an isomorphism away from
`Supp D`.** With `(Γ, E, F)` the data of `𝒥_{Δ,D}` and `(Γ', E', F')` those of `𝒥_{Δ-S,D+S}` on
the same resolution `μ`, `E' - ⌊F'⌋ = E - ⌊F⌋ - T` for the strict transform `T` of `S`: off `T`
the zero places are the same and `μ^*S` enters `E'` and `⌊F'⌋` alike. -/
private theorem sub_roundDown_eq_of_sub_single {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDns : ContainsNoStratum Δ D.supp) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    (hΔ' : IsReducedSNC sX (Δ - Finsupp.single S 1))
    (hDns' : ContainsNoStratum (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)).supp)
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] [CompactSpace Y] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) (hp : IsProper μ) (hV : IsIso (μ ∣_ D.supp.compl))
    {hD : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ D.supp}
    {Γ E : Divisor Y} {F : QDivisor Y} (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) (hF : D.IsPullback μ hD F)
    {hD' : ∀ C : irreducibleComponents Y,
      μ (componentGenericPoint Y C) ∉ (D + Divisor.toQDivisor (Finsupp.single S 1)).supp}
    {Γ' E' : Divisor Y} {F' : QDivisor Y}
    (hΓ' : IsZeroLogDiscrepancyDivisor sX μ hY hμ (Δ - Finsupp.single S 1) Γ')
    (hE' : IsAdjointDiscrepancyDivisor sX μ hY hμ (Δ - Finsupp.single S 1) Γ' E')
    (hF' : (D + Divisor.toQDivisor (Finsupp.single S 1)).IsPullback μ hD' F')
    (T : MMP.Mori.PrimeDivisor Y) (hT : μ T.genericPoint = S.genericPoint) :
    E' - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F') =
      E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) -
        Finsupp.single T 1 := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_eq sX hX.1
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hd
  obtain ⟨ω, hω0, hωK, -⟩ := exists_ordForm_eq_neg_one sX hX hK S
  have hcart : ∀ G : Divisor X, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm
  have hs : ∀ G : Divisor X, ∀ C : irreducibleComponents Y,
      μ (componentGenericPoint Y C) ∉ G.supp :=
    fun G => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ G
  obtain ⟨Kμ, hKμ⟩ := (hcart (divisorOfForm ω + Δ)).exists_isPullback (hs _)
  obtain ⟨Kμ', hKμ'⟩ := (hcart (divisorOfForm ω + (Δ - Finsupp.single S 1))).exists_isPullback
    (hs _)
  obtain ⟨Sμ, hSμ⟩ := (hcart (Finsupp.single S 1)).exists_isPullback (hs _)
  have hEeq := eq_of_isAdjointDiscrepancyDivisor sX hX hω0 hωK Δ (hcart _) μ hY hμ hp hE ⟨_, hKμ⟩
  have hEeq' := eq_of_isAdjointDiscrepancyDivisor sX hX hω0 hωK (Δ - Finsupp.single S 1)
    (hcart _) μ hY hμ hp hE' ⟨_, hKμ'⟩
  -- `μ^*(K + Δ) = μ^*(K + Δ - S) + μ^*S`
  have hKK : Kμ = Kμ' + Sμ := by
    have h2 := hKμ'.add (hcart _) (hcart _) (hs _) hSμ
    rw [show divisorOfForm ω + (Δ - Finsupp.single S 1) + Finsupp.single S 1 =
      divisorOfForm ω + Δ by abel] at h2
    exact Divisor.IsPullback.eq (hcart _) hKμ h2
  -- `μ^*(D + S) = μ^*D + μ^*S`
  have hFF : ∀ P, F'.coeff P = F.coeff P + Sμ.coeff P := by
    obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
    obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
    have hD₁ : Divisor.toQDivisor (D₀ + (mD : ℤ) • Finsupp.single S 1) =
        (mD : ℤ) • (D + Divisor.toQDivisor (Finsupp.single S 1)) := by
      rw [map_add, map_zsmul, hD₀, smul_add]
    obtain ⟨D₁', hD₁'eq, hD₁'⟩ := hF' mD hmD _ hD₁ (hcart _)
    have h2 := hD₀'.add hD₀c ((hcart _).zsmul _) (hs _) (hSμ.zsmul (hcart _) (mD : ℤ) (hs _))
    have h3 := Divisor.IsPullback.eq (hcart _) hD₁' h2
    intro P
    have h4 := congrArg (fun G : Divisor Y => (G.coeff P : ℚ)) h3
    have h5 := congrArg (fun G : QDivisor Y => G.coeff P) hD₁'eq
    have h6 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      zsmul_eq_mul, Int.cast_natCast, smul_eq_mul] at h4 h5 h6
    push_cast at h4 h5 h6
    have hmD0 : (mD : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
    apply mul_left_cancel₀ hmD0
    linear_combination h5.symm.trans (h4.trans (by rw [h6]))
  -- the zero places
  have hηS : S.genericPoint ∉ D.supp :=
    genericPoint_notMem_of_containsNoStratum hS D.isClosed_supp hDns
  have hS0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor (Finsupp.single S 1)).coeff P := fun P => by
    rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
    split_ifs <;> norm_num
  have hΓΓ : ∀ P : MMP.Mori.PrimeDivisor Y,
      Γ'.coeff P = Γ.coeff P - DivisorWithCoeffs.coeff (Finsupp.single T 1 : Divisor Y) P := by
    intro P
    by_cases hP : μ P.genericPoint ∈ D.supp
    · have hPT : P ≠ T := by rintro rfl; exact hηS (hT ▸ hP)
      rw [DivisorWithCoeffs.coeff_apply (Finsupp.single T 1), Finsupp.single_eq_of_ne hPT]
      have hΓ0 : Γ.coeff P = 0 := by
        rcases hΓ.1 P with h | h
        · exact h
        · obtain ⟨n', h0⟩ := (hΓ.2 P).1 h
          exact absurd hP (notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ D.isClosed_supp hDns h0)
      have hΓ'0 : Γ'.coeff P = 0 := by
        rcases hΓ'.1 P with h | h
        · exact h
        · obtain ⟨n', h0⟩ := (hΓ'.2 P).1 h
          exact absurd ((mem_supp_add_iff hD0 hS0).2 (Or.inl hP))
            (notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ' (DivisorWithCoeffs.isClosed_supp _)
              hDns' h0)
      rw [hΓ0, hΓ'0, sub_zero]
    · have hb : μ P.genericPoint ∈ MMP.Mori.biregularLocus μ := MMP.Mori.le_biregularLocus hV hP
      obtain ⟨Q, hQ, -, hΓP⟩ := coeff_eq_of_mem_biregularLocus sX hX hd hω0 hωK hΔ.1 (hcart _) μ
        hY hμ hp hΓ ⟨_, hKμ⟩ hEeq P hb
      obtain ⟨Q', hQ', -, hΓ'P⟩ := coeff_eq_of_mem_biregularLocus sX hX hd hω0 hωK hΔ'.1
        (hcart _) μ hY hμ hp hΓ' ⟨_, hKμ'⟩ hEeq' P hb
      obtain rfl : Q = Q' :=
        AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hQ.symm.trans hQ')
      rw [hΓ'P, hΓP, DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
        DivisorWithCoeffs.coeff_apply (Finsupp.single T 1)]
      congr 1
      by_cases hPT : P = T
      · subst hPT
        have hQS : Q = S := AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hQ.symm.trans hT)
        rw [hQS, Finsupp.single_eq_same, Finsupp.single_eq_same]
      · have hQS : Q ≠ S := by
          rintro rfl
          apply hPT
          have hTV : T.genericPoint ∈ μ ⁻¹ᵁ D.supp.compl := by
            change μ T.genericPoint ∈ D.supp.compl; rw [hT]; exact hηS
          exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective
            (eq_of_map_eq_of_isIso μ hV hP hTV (hQ.trans hT.symm))
        rw [Finsupp.single_eq_of_ne hQS, Finsupp.single_eq_of_ne hPT]
  ext P
  have h1 := congrArg (fun G : Divisor Y => G.coeff P) hEeq
  have h2 := congrArg (fun G : Divisor Y => G.coeff P) hEeq'
  have h3 := congrArg (fun G : Divisor Y => G.coeff P) hKK
  simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub] at h1 h2 h3
  change (E' - _).coeff P = (E - _ - _).coeff P
  simp only [DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
    QDivisor.coeff_toRDivisor, hFF P]
  have hfl : ⌊((F.coeff P + (Sμ.coeff P : ℚ) : ℚ) : ℝ)⌋ = ⌊((F.coeff P : ℚ) : ℝ)⌋ + Sμ.coeff P := by
    push_cast
    exact Int.floor_add_intCast _ _
  rw [hfl, h1, h2, h3, hΓΓ P]
  ring

/-- **The strict transform setup.** For `f : X ⟶ Z` projective with `Z` affine, `J = 𝒥_{Δ,D}`
and `JS = 𝒥_{Θ,D|_S}`, there is a log resolution `μ₀ : Y₀ ⟶ X` of `Δ + D` which is an
isomorphism away from `Supp D` and a divisor `G₀ = E - ⌊μ₀^*D⌋` with `J = μ₀_*𝒪(G₀)`, such that
the strict transform `μ_T : T ⟶ S` of `S` satisfies `JS = μ_{T*}𝒪_T(G₀|_T)`. -/
private theorem exists_strictTransform_setup {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y : Scheme.{0}} {μ : Y ⟶ X}
    {J : X.Opens → Set X.functionField} (hJ : IsReducedAdjointIdealOn sX Δ D μ J)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    {YS : Scheme.{0}} {μS : YS ⟶ S.idealSheaf.subscheme}
    {JS : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField}
    (hJS : haveI := S.integral; IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μS JS)
    {Y' : Scheme.{0}} {μ' : Y' ⟶ X} {J' : X.Opens → Set X.functionField}
    (hJ' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J') :
    haveI := S.integral
    ∃ (Y₀ : Scheme.{0}) (μ₀ : Y₀ ⟶ X) (_ : IsIntegral Y₀) (_ : IsLocallyNoetherian Y₀)
      (_ : IsNormal Y₀) (_ : IsDominant μ₀) (_ : CompactSpace Y₀) (T : MMP.Mori.PrimeDivisor Y₀)
      (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme) (_ : IsIntegral T.idealSheaf.subscheme)
      (_ : IsLocallyNoetherian T.idealSheaf.subscheme) (_ : IsNormal T.idealSheaf.subscheme)
      (_ : IsDominant μT) (G₀ : Divisor Y₀),
      μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ₀ ∧
      μ₀ T.genericPoint = S.genericPoint ∧ IsIso (μ₀ ∣_ D.supp.compl) ∧
      S.genericPoint ∉ D.supp ∧ MMP.Mori.IsSmoothScheme (μ₀ ≫ sX) ∧
      MMP.Mori.IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) ∧ IsProper μ₀ ∧
      IsNormalVariety k (μ₀ ≫ sX) ∧ IsBirationalMorphism μ₀ ∧
      J = MMP.Intersection.multiplierIdealSections μ₀ G₀ ∧
      JS = MMP.Intersection.multiplierIdealSections μT (G₀.restrictPrimeDivisor T) ∧
      G₀.coeff T = 0 ∧
      (∃ J₀' : X.Opens → Set X.functionField,
        IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
          (D + Divisor.toQDivisor (Finsupp.single S 1)) μ₀ J₀' ∧
        J₀' = MMP.Intersection.multiplierIdealSections μ₀ (G₀ - Finsupp.single T 1)) ∧
      ∀ (N : Divisor X), N.IsCartier →
        (Divisor.toQDivisor N - (D + Divisor.toQDivisor (Finsupp.single S 1))).HasRelativelyAmpleMultiple f →
        ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
        ∀ (M : Divisor X), M.IsCartier → M.LinearlyEquivalent (K + (Δ - Finsupp.single S 1) + N) →
        ∀ (hMμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ M.supp)
          (Mμ : Divisor Y₀), M.IsPullback μ₀ hMμ Mμ →
        ∀ i : ℕ, 0 < i →
          IsZero (((Scheme.Modules.pushforward μ₀).rightDerived i).obj
            (G₀ - Finsupp.single T 1 + Mμ).divisorialSheaf) := by
  classical
  haveI := S.integral
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, -⟩ := id hJ
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hsm
  haveI : IsSmoothVariety k sX := (isSmoothVariety_iff k sX).2 ⟨hX.1, inferInstance⟩
  -- the good resolution
  obtain ⟨M, hMinv, hMamp⟩ := exists_isAmple_of_isProjectiveMorphism_of_isAffine f hf
  obtain ⟨Y₀, μ₀, hlog₀, hiso⟩ := exists_isLogResolution_isIso_compl_supp sX hX hsm hΔ D hD0 M hMamp
  obtain ⟨J₀, hJ₀⟩ :=
    exists_isReducedAdjointIdealOn_of_isLogResolution sX Δ D hX hsm hΔ hD0 hDns μ₀ hlog₀
  have hJJ₀ : J = J₀ :=
    (MMP.Fourfold.isReducedAdjointIdealOn_operations sX).2.2.1 Δ D μ μ₀ J J₀ hJ hJ₀
  obtain ⟨-, -, -, -, -, -, hI₀, hL₀, hN₀, hD₀, hY₀, hμ₀, hDμ, Γ, E, F, hΓ, hE, hF, hJ₀eq⟩ := hJ₀
  haveI := hI₀; haveI := hL₀; haveI := hN₀; haveI := hD₀
  haveI : IsProper μ₀ := hlog₀.isProper
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  -- the strict transform
  have hηS : S.genericPoint ∉ D.supp :=
    genericPoint_notMem_of_containsNoStratum hS D.isClosed_supp hDns
  obtain ⟨T, hT, hTI⟩ := exists_primeDivisor_map_genericPoint_eq μ₀ hiso S hηS
  haveI := T.integral
  set μT := Scheme.IdealSheafData.subschemeMap T.idealSheaf S.idealSheaf μ₀
    (le_map_idealSheaf μ₀ S T hT hTI) with hμTdef
  have hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ₀ :=
    Scheme.IdealSheafData.subschemeMap_subschemeι _ _ _ _
  -- the data on `S`
  obtain ⟨hSv, hSsm, hΘ, hDS0, hDSns, -⟩ := id hJS
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hSsm
  haveI : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  -- the snc components on `Y₀`, and smoothness of `T`
  have hsmY : MMP.Mori.IsSmoothScheme (μ₀ ≫ sX) := hlog₀.isSmoothScheme
  haveI : Smooth (μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : AlgebraicGeometry.IsVariety k (μ₀ ≫ sX) := hY₀.1
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY₀.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  obtain ⟨s₀, hs₀, hsnc₀⟩ := exists_finset_of_isSNCSubset (μ₀ ≫ sX) hsmY hlog₀.isSNCSubset
  have hΔ0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor Δ).coeff P := fun P => by
    rw [Divisor.coeff_toQDivisor]; rcases hΔ.1 P with h | h <;> rw [h] <;> norm_num
  have hmem₀ : ∀ P : MMP.Mori.PrimeDivisor Y₀,
      μ₀ P.genericPoint ∈ DivisorWithCoeffs.supp (Divisor.toQDivisor Δ + D) → P ∈ s₀ := by
    intro P hP
    have hmem : P.genericPoint ∈ ⋃ E ∈ s₀, (E.support : Set Y₀) := by
      rw [hs₀]
      refine Or.inr ?_
      change μ₀ P.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
      rw [QDivisor.supp_toRDivisor]
      exact hP
    obtain ⟨E', hE', hPE'⟩ := Set.mem_iUnion₂.mp hmem
    have hEE := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'
    first | rwa [hEE] | rwa [← hEE]
  have hT₀ : T ∈ s₀ := by
    refine hmem₀ T ((mem_supp_add_iff hΔ0 hD0).2 (Or.inl ?_))
    rw [Divisor.supp_toQDivisor, hT]
    refine DivisorWithCoeffs.support_subset_supp (E := S) (by rw [hS]; norm_num) ?_
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hTsm : MMP.Mori.IsSmoothScheme (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) :=
    hsnc₀.1 T (by
      rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
      simp [Finsupp.single_apply, hT₀])
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hTsm
  haveI : IsLocallyNoetherian T.idealSheaf.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)
  haveI : IsNormal T.idealSheaf.subscheme :=
    AlgebraicGeometry.isNormal_of_smooth_over_field (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)
  haveI : CompactSpace T.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace T.idealSheaf.subschemeι
  haveI : IsDominant μT := by
    haveI := (isProper_surjective_strictTransform μ₀ S T hT μT hμT).2
    infer_instance
  -- `μ_T` is a log resolution of `(S, Θ + D|_S)`
  have hlogT := isLogResolution_strictTransform sX μ₀ hY₀ hμ₀ hΔ.1 hD0 hlog₀ hiso S hS hηS hSv
    T hT μT hμT
  have hs : μT ≫ S.idealSheaf.subschemeι ≫ sX = T.idealSheaf.subschemeι ≫ μ₀ ≫ sX := by
    rw [← Category.assoc, hμT, Category.assoc]
  have hTv : IsNormalVariety k (μT ≫ S.idealSheaf.subschemeι ≫ sX) := by
    refine ⟨?_, inferInstance⟩
    rw [hs]
    haveI : IsSeparated (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := inferInstance
    exact ⟨⟩
  have hμTb := isBirationalMorphism_strictTransform μ₀ hiso S hηS T hT μT hμT
  -- the adjoint data on `T`
  obtain ⟨hET, hΓT, hZT, hAT⟩ := adjointData_strictTransform sX hX μ₀ hY₀ hμ₀ hΔ hD0 hDns hlog₀
    hiso hΓ hE S hS hηS hSv hΘ hDSns T hT μT hμT hTv hμTb
  have hFT : F.coeff T = 0 :=
    (coeff_eq_zero_of_coeff_zeroLogDiscrepancy sX μ₀ hX hsm hΔ hDns hY₀ hμ₀ hDμ hΓ hF hiso T
      hΓT).1
  have hDS : D.coeff S = 0 := by
    by_contra hne
    exact hηS (DivisorWithCoeffs.support_subset_supp hne (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl))
  have hDT : ∀ C : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ C) ∉ (D.restrictPrimeDivisor S).supp := by
    intro C
    rw [componentGenericPoint_eq_genericPoint', map_genericPoint_strictTransform μ₀ S T hT μT hμT]
    exact genericPoint_notMem_supp (D.restrictPrimeDivisor S)
  have hFTpb := qIsPullback_restrictPrimeDivisor sX μ₀ S T hT μT hμT hDS hF hFT hDT
  have hJT : IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μT
      (MMP.Intersection.multiplierIdealSections μT (E.restrictPrimeDivisor T -
        MMP.Intersection.WeilRDivisor.roundDown
          (QDivisor.toRDivisor (F.restrictPrimeDivisor T)))) :=
    ⟨hSv, hSsm, hΘ, hDS0, hDSns, hlogT, inferInstance, inferInstance, inferInstance, inferInstance,
      hTv, hμTb, hDT, _, _, _, hZT, hAT, hFTpb, rfl⟩
  -- round-down commutes with restriction to `T`
  have hFs₀ : ∀ P ∈ F.support, P ∈ s₀ ∧ P ≠ T := by
    intro P hP
    have hFP : F.coeff P ≠ 0 := Finsupp.mem_support_iff.mp hP
    refine ⟨hmem₀ P ((mem_supp_add_iff hΔ0 hD0).2 (Or.inr ?_)), fun h => hFP (h ▸ hFT)⟩
    by_contra hn
    exact hFP (coeff_qIsPullback_eq_zero sX hX hsm μ₀ hY₀ hμ₀ hF P hn)
  have hTF : T ∉ F.support := fun h => (hFs₀ T h).2 rfl
  have hsncF : DivisorWithCoeffs.IsSNC (μ₀ ≫ sX)
      (Finsupp.single T (1 : ℤ) + ∑ E' ∈ F.support, Finsupp.single E' 1) := by
    refine hsnc₀.of_support_subset ?_
    rw [← Finset.sum_insert (f := fun E' => Finsupp.single E' (1 : ℤ)) hTF, support_sum_single,
      support_sum_single]
    intro P hP
    rcases Finset.mem_insert.mp hP with rfl | hP
    · exact hT₀
    · exact (hFs₀ P hP).1
  haveI : IsNoetherian Y₀ := ⟨⟩
  have hfloor := roundDown_restrictPrimeDivisor F T hFT
    (sum_intersectionLength_le_one (μ₀ ≫ sX) T F.support hTF hsncF)
  have hFT0 : (MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).coeff T = 0 := by
    rw [MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor, hFT]; simp
  -- the data of `𝒥_{Δ-S,D+S}` on `μ₀`
  obtain ⟨-, -, hΔ', hD0', hDns', -⟩ := id hJ'
  have hQeq : Divisor.toQDivisor (Δ - Finsupp.single S 1) +
      (D + Divisor.toQDivisor (Finsupp.single S 1)) = Divisor.toQDivisor Δ + D := by
    rw [map_sub]; abel
  have hlog₀' : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor (Δ - Finsupp.single S 1) +
      (D + Divisor.toQDivisor (Finsupp.single S 1))) μ₀ := by rw [hQeq]; exact hlog₀
  obtain ⟨J₀', hJ₀'⟩ := exists_isReducedAdjointIdealOn_of_isLogResolution sX _ _ hX hsm hΔ' hD0'
    hDns' μ₀ hlog₀'
  obtain ⟨-, -, -, -, -, -, j1, j2, j3, j4, hY₀', hμ₀', hDμ', Γ', E', F', hΓ', hE', hF', hJ₀'eq⟩ :=
    id hJ₀'
  have hS0 : ∀ P, (0 : ℚ) ≤ (Divisor.toQDivisor (Finsupp.single S 1)).coeff P := fun P => by
    rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
    split_ifs <;> norm_num
  have hiso' : IsIso (μ₀ ∣_ (D + Divisor.toQDivisor (Finsupp.single S 1)).supp.compl) := by
    haveI := hiso
    refine MMP.Resolution.Kollar.isIso_morphismRestrict_of_le (W := D.supp.compl) μ₀ ?_
    intro x hx hxD
    exact hx ((mem_supp_add_iff hD0 hS0).2 (Or.inl hxD))
  have hG' := sub_roundDown_eq_of_sub_single sX hX hsm hΔ hD0 hDns S hS hΔ' hDns' μ₀ hY₀ hμ₀
    inferInstance hiso hΓ hE hF hΓ' hE' hF' T hT
  refine ⟨Y₀, μ₀, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, T, μT,
    inferInstance, inferInstance, inferInstance, inferInstance,
    E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F), hμT, hT, hiso, hηS, hsmY,
    hTsm, inferInstance, hY₀, hμ₀, hJJ₀.trans hJ₀eq, ?_, ?_, ⟨J₀', hJ₀', hJ₀'eq.trans (by rw [hG'])⟩,
    fun N hN hND n K hK M hMc hMK hMμ Mμ hMpb i hi => ?_⟩
  rotate_left 2
  · have := isZero_rightDerived_pushforward_of_isIso_compl_supp sX f hf μ₀ hX hsm hΔ' hD0' hDns'
      hlog₀' hY₀ hμ₀ hDμ' hΓ' hE' hF' hiso' N hN hND hK M hMc hMK hMμ Mμ hMpb i hi
    rwa [hG'] at this
  · rw [restrictPrimeDivisor_sub _ _ T hET hFT0, hfloor]
    exact (eq_adjointSet (S.idealSheaf.subschemeι ≫ sX) hJS).trans
      (eq_adjointSet (S.idealSheaf.subschemeι ≫ sX) hJT).symm
  · rw [DivisorWithCoeffs.coeff_sub, hET, hFT0, sub_zero]

/-- **Restriction to `S` maps `𝒥_{Δ,D}` into `𝒥_{Θ,D|_S}`.** On the strict transform setup, a
section `g` of `μ₀_*𝒪(G₀)` over `U` meeting `S` is regular at `η_S`, and its restriction to `S`
pulls back to the restriction of `μ₀^*g` to `T`, a section of `𝒪_T(G₀|_T)`. -/
private theorem exists_mem_isRestrictionAlong_of_mem {k : Type} [Field k] {X Y₀ : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀] [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀]
    [CompactSpace Y₀] [Smooth (μ₀ ≫ sX)] (hμ₀ : IsBirationalMorphism μ₀)
    (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y₀)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    [IsLocallyNoetherian T.idealSheaf.subscheme] [IsNormal T.idealSheaf.subscheme]
    [Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)]
    (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme)
    (hdom : haveI := S.integral; haveI := T.integral; IsDominant μT)
    (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ₀)
    (hT : μ₀ T.genericPoint = S.genericPoint) {V : X.Opens} (hV : IsIso (μ₀ ∣_ V))
    (hSV : S.genericPoint ∈ V) (G₀ : Divisor Y₀) (hG₀T : G₀.coeff T = 0) (U : X.Opens)
    (g : X.functionField) (hg : g ∈ MMP.Intersection.multiplierIdealSections μ₀ G₀ U)
    (hU : (haveI := S.integral; S.idealSheaf.subschemeι ⁻¹ᵁ U) ≠ ⊥) :
    haveI := S.integral; haveI := T.integral
    ∃ h ∈ MMP.Intersection.multiplierIdealSections μT (G₀.restrictPrimeDivisor T)
      (S.idealSheaf.subschemeι ⁻¹ᵁ U), IsRestrictionAlong S g h := by
  haveI := S.integral; haveI := T.integral
  haveI := hdom
  have hηU : S.genericPoint ∈ U := genericPoint_mem_of_preimage_ne_bot S hU
  have hTU : T.genericPoint ∈ μ₀ ⁻¹ᵁ U := by
    change μ₀ T.genericPoint ∈ U; rw [hT]; exact hηU
  -- `g` is regular along `S`
  have hvT := hg.2 T ((T.genericPoint_mem_iff _).mp hTU)
  rw [hG₀T, WithZero.exp_zero, MMP.Mori.PrimeDivisor.valuationOver_apply] at hvT
  have hbir : μ₀ T.genericPoint ∈ MMP.Mori.biregularLocus μ₀ :=
    MMP.Mori.le_biregularLocus hV (by rw [hT]; exact hSV)
  haveI := MMP.Threefold.Resolution.isIso_stalkMap_of_mem_biregularLocus μ₀ hbir
  have hvS : S.divisorialValuation g ≤ 1 := by
    rcases eq_or_ne g 0 with rfl | hg0
    · simp
    have hf0 : functionFieldMap μ₀ g ≠ 0 := (map_ne_zero _).mpr hg0
    rw [T.divisorialValuation_eq_exp_neg_ord hf0,
      MMP.Positivity.ord_functionFieldMap_of_isIso μ₀ T S hT g] at hvT
    rw [S.divisorialValuation_eq_exp_neg_ord hg0]; exact hvT
  obtain ⟨a, rfl⟩ := (S.divisorialValuation_le_one_iff _).1 hvS
  by_cases ha : IsUnit a
  swap
  · refine ⟨0, ⟨fun _ => rfl, fun Q _ => by simp⟩, isRestrictionAlong_zero_of_lt_one S
      ((S.divisorialValuation_algebraMap_lt_one_iff a).2 ((IsLocalRing.mem_maximalIdeal _).2 ha))⟩
  -- a section representing `a`
  obtain ⟨W, hηW, s, rfl⟩ := X.presheaf.germ_exist (x := S.genericPoint) a
  have hgW : genericPoint S.idealSheaf.subscheme ∈ S.idealSheaf.subschemeι ⁻¹ᵁ W := hηW
  have hTW : T.genericPoint ∈ μ₀ ⁻¹ᵁ W := by change μ₀ T.genericPoint ∈ W; rw [hT]; exact hηW
  set a₀ : Y₀.presheaf.stalk T.genericPoint :=
    Y₀.presheaf.germ (μ₀ ⁻¹ᵁ W) T.genericPoint hTW (μ₀.app W s) with ha₀def
  have hunit : ∀ (x : X) (hx : x ∈ W), x = S.genericPoint → IsUnit (X.presheaf.germ W x hx s) := by
    rintro x hx rfl; exact ha
  have ha₀ : IsUnit a₀ := by
    rw [ha₀def, ← Scheme.Hom.germ_stalkMap_apply μ₀ W T.genericPoint hTW s]
    exact (hunit _ _ hT).map _
  refine ⟨S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)
    (X.presheaf.germ W S.genericPoint hηW s), ⟨fun hb => ?_, fun Q hQ => ?_⟩, ⟨_, rfl, rfl⟩⟩
  · exfalso
    have hmem : genericPoint T.idealSheaf.subscheme ∈ μT ⁻¹ᵁ (S.idealSheaf.subschemeι ⁻¹ᵁ U) := by
      change S.idealSheaf.subschemeι (μT (genericPoint _)) ∈ U
      rw [map_genericPoint_strictTransform μ₀ S T hT μT hμT]
      exact hηU
    rw [hb] at hmem; exact hmem
  -- the pull-back of the restriction is the restriction of the pull-back
  have hkey : functionFieldMap μT (S.idealSheaf.subschemeι.stalkMap (genericPoint _)
      (X.presheaf.germ W S.genericPoint hηW s)) =
      (T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a₀ := by
    have h1 := Scheme.Hom.germ_stalkMap_apply S.idealSheaf.subschemeι W
      (genericPoint S.idealSheaf.subscheme) hgW s
    have hZ : genericPoint T.idealSheaf.subscheme ∈ μT ⁻¹ᵁ (S.idealSheaf.subschemeι ⁻¹ᵁ W) := by
      change S.idealSheaf.subschemeι (μT (genericPoint _)) ∈ W
      rw [map_genericPoint_strictTransform μ₀ S T hT μT hμT]
      exact hηW
    change (functionFieldMap μT) ((S.idealSheaf.subschemeι.stalkMap _).hom
      (X.presheaf.germ W (S.idealSheaf.subschemeι (genericPoint _)) hgW s)) = _
    rw [h1, functionFieldMap_germ' μT (S.idealSheaf.subschemeι ⁻¹ᵁ W) hgW hZ, ha₀def]
    have h2 := Scheme.Hom.germ_stalkMap_apply T.idealSheaf.subschemeι (μ₀ ⁻¹ᵁ W)
      (genericPoint T.idealSheaf.subscheme) hTW (μ₀.app W s)
    refine Eq.trans ?_ h2.symm
    have key : ∀ (φ : T.idealSheaf.subscheme ⟶ X) (hφ : φ = T.idealSheaf.subschemeι ≫ μ₀)
        (h₁ : genericPoint T.idealSheaf.subscheme ∈ φ ⁻¹ᵁ W),
        T.idealSheaf.subscheme.presheaf.germ (φ ⁻¹ᵁ W) _ h₁ (φ.app W s) =
          T.idealSheaf.subscheme.presheaf.germ ((T.idealSheaf.subschemeι ≫ μ₀) ⁻¹ᵁ W) _
            (hφ ▸ h₁) ((T.idealSheaf.subschemeι ≫ μ₀).app W s) := by
      rintro φ rfl h₁; rfl
    exact key (μT ≫ S.idealSheaf.subschemeι) hμT hZ
  have hμy : ∀ x, μ₀ (T.idealSheaf.subschemeι x) = S.idealSheaf.subschemeι (μT x) := fun x => by
    change (T.idealSheaf.subschemeι ≫ μ₀) x = (μT ≫ S.idealSheaf.subschemeι) x
    rw [hμT]
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, hkey]
  refine divisorialValuation_restrict_le (μ₀ ≫ sX) T G₀ hG₀T (μ₀ ⁻¹ᵁ U) a₀ ha₀ (fun E hE => ?_) Q ?_
  · have := hg.2 E hE
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply] at this
    convert this using 2
    have hTW' : μ₀ T.genericPoint ∈ W := hTW
    haveI : Nonempty W := ⟨⟨_, hηW⟩⟩
    have e1 := MMP.Mori.functionFieldMap_algebraMap_stalk μ₀ T.genericPoint
      (X.presheaf.germ W (μ₀ T.genericPoint) hTW' s)
    have e2 : algebraMap (X.presheaf.stalk (μ₀ T.genericPoint)) X.functionField
        (X.presheaf.germ W (μ₀ T.genericPoint) hTW' s) =
        algebraMap S.localRing X.functionField (X.presheaf.germ W S.genericPoint hηW s) := by
      rw [Scheme.algebraMap_germ_eq_germToFunctionField,
        Scheme.algebraMap_germ_eq_germToFunctionField]
    rw [e2] at e1
    rw [e1, ha₀def, ← Scheme.Hom.germ_stalkMap_apply μ₀ W T.genericPoint hTW s]
    rfl
  · obtain ⟨x, hxQ, hxU⟩ := hQ
    exact ⟨x, hxQ, by change μ₀ (T.idealSheaf.subschemeι x) ∈ U; rw [hμy x]; exact hxU⟩

/-- **Restriction of twisted global sections.** For a Cartier `M` with `coeff_S M = 0` and its
pull-backs `Mμ` to `Y` and `MS` to `Y_S`, restriction to `S` maps the global sections of
`μ_*𝒪(G + Mμ)` into those of `μ_{S*}𝒪(G_S + MS)`. -/
private theorem exists_isRestrictionAlong_twist {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y : Scheme.{0}} {μ : Y ⟶ X} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsDominant μ]
    {J : X.Opens → Set X.functionField} (hJ : IsReducedAdjointIdealOn sX Δ D μ J)
    {G : Divisor Y} (hG : J = MMP.Intersection.multiplierIdealSections μ G)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    {YS : Scheme.{0}} {μS : YS ⟶ S.idealSheaf.subscheme}
    [IsIntegral YS] [IsLocallyNoetherian YS] [IsNormal YS] [IsDominant μS]
    {JS : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField}
    (hJS : haveI := S.integral; IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μS JS)
    {GS : Divisor YS}
    (hGS : haveI := S.integral; JS = MMP.Intersection.multiplierIdealSections μS GS)
    {Y' : Scheme.{0}} {μ' : Y' ⟶ X} {J' : X.Opens → Set X.functionField}
    (hJ' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J')
    {M : Divisor X} (hMc : M.IsCartier) (hMS0 : M.coeff S = 0)
    {hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp}
    {Mμ : Divisor Y} (hMpb : M.IsPullback μ hMμ Mμ)
    {hMS : ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp}
    {MS : Divisor YS} (hMSpb : M.IsPullback (μS ≫ S.idealSheaf.subschemeι) hMS MS) :
    haveI := S.integral
    ∀ g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤,
      ∃ h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤, IsRestrictionAlong S g h := by
  haveI := S.integral
  intro g hg
  obtain ⟨Y₀, μ₀, _, _, _, _, _, T, μT, _, _, _, hdom, G₀, hμT, hT, hiso, hηS, hsmY, hsmT, -,
    hY₀, hμ₀, hJ₀, hJS₀, hG₀T, -, -⟩ := exists_strictTransform_setup sX f hf hJ S hS hJS hJ'
  obtain ⟨hX, hsm, -⟩ := id hJ
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hsm
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY₀.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  haveI : LocallyOfFinitePresentation (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)).mpr inferInstance
  haveI : Smooth (μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmT
  obtain ⟨hSv, hSsm, -, -, -, hlogS, -⟩ := id hJS
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hSsm
  haveI : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  haveI : CompactSpace T.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace T.idealSheaf.subschemeι
  haveI : IsProper μS := hlogS.isProper
  haveI : CompactSpace YS := QuasiCompact.compactSpace_of_compactSpace μS
  -- the twist on `Y₀`
  obtain ⟨Mμ₀, hMμ₀⟩ := hMc.exists_isPullback (f := μ₀)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ M)
  have hsec : MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ₀ (G₀ + Mμ₀) :=
    multiplierIdealSections_add_pullback_congr hMc hMpb hMμ₀ (hG.symm.trans hJ₀)
  have hMμ₀T : Mμ₀.coeff T = 0 :=
    coeff_isPullback_eq_zero (F := ⟨Y₀, μ₀, hY₀, hμ₀, T⟩) hMc
      (by change μ₀ T.genericPoint ∉ _; rw [hT]
          exact genericPoint_notMem_supp_of_coeff_eq_zero M S hMS0) Mμ₀ _ hMμ₀
  -- the twist on `S`: `M|_S` and its pull-backs
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) := hSsm
  have hMSc : Divisor.IsCartier (M.restrictPrimeDivisor S) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmS _
  have hDTμ : ∀ C : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ C) ∉ (M.restrictPrimeDivisor S).supp := by
    intro C
    rw [componentGenericPoint_eq_genericPoint', map_genericPoint_strictTransform μ₀ S T hT μT hμT]
    exact genericPoint_notMem_supp _
  have hMT := isPullback_restrictPrimeDivisor_of_isPullback sX μ₀ S T hT μT hμT hMc hMS0 hMμ₀
    hMμ₀T hDTμ
  obtain ⟨MS', hMS'⟩ := hMSc.exists_isPullback (f := μS)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μS _)
  have h1 := isPullback_restrictPrimeDivisor sX S M hMS0
  have h2 := isPullback_comp h1 hMS' hMS
  have hMSeq := MMP.Mori.Divisor.IsPullback.eq hMc h2 hMSpb
  rw [hMSeq] at hMS'
  have hsecS : MMP.Intersection.multiplierIdealSections μS (GS + MS) =
      MMP.Intersection.multiplierIdealSections μT
        (G₀.restrictPrimeDivisor T + Mμ₀.restrictPrimeDivisor T) :=
    multiplierIdealSections_add_pullback_congr hMSc hMS' hMT (hGS.symm.trans hJS₀)
  haveI : IsNoetherian Y₀ := ⟨⟩
  have hres : (G₀ + Mμ₀).restrictPrimeDivisor T =
      G₀.restrictPrimeDivisor T + Mμ₀.restrictPrimeDivisor T :=
    MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_add _ _ T hG₀T hMμ₀T
  have hGT : (G₀ + Mμ₀).coeff T = 0 := by rw [DivisorWithCoeffs.coeff_add, hG₀T, hMμ₀T, add_zero]
  rw [hsec] at hg
  rw [hsecS, ← hres]
  have hU : S.idealSheaf.subschemeι ⁻¹ᵁ (⊤ : X.Opens) ≠ ⊥ := by
    rw [Scheme.Hom.preimage_top]
    exact (Opens.ne_bot_iff_nonempty _).2 ⟨genericPoint _, trivial⟩
  obtain ⟨h, hh, hr⟩ := exists_mem_isRestrictionAlong_of_mem sX μ₀ hμ₀ S T μT hdom hμT hT hiso hηS
    (G₀ + Mμ₀) hGT ⊤ g hg hU
  rw [Scheme.Hom.preimage_top] at hh
  exact ⟨h, hh, hr⟩

end Setup

/-! ### The restriction sequence of a smooth prime divisor -/

section RestrictionSequence

open MMP.Mori

variable {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
  (T : MMP.Mori.PrimeDivisor Y) [IsIntegral T.idealSheaf.subscheme]

/-- The restriction to `T` of a rational function is unique when it exists. -/
private theorem isRestrictionAlong_unique {g : Y.functionField}
    {h h' : T.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong T g h) (hh' : IsRestrictionAlong T g h') : h = h' := by
  obtain ⟨a, ha, rfl⟩ := hh
  obtain ⟨a', ha', rfl⟩ := hh'
  have hinj : Function.Injective (algebraMap T.localRing Y.functionField) :=
    IsFractionRing.injective T.localRing Y.functionField
  have : a = a' := hinj (ha.trans ha'.symm)
  rw [this]

/-- A rational function regular along `T` has a restriction to `T`. -/
private theorem exists_isRestrictionAlong_of_le_one {g : Y.functionField}
    (hg : T.divisorialValuation g ≤ 1) :
    ∃ h, IsRestrictionAlong T g h := by
  obtain ⟨r, rfl⟩ := (T.divisorialValuation_le_one_iff g).1 hg
  exact ⟨_, r, rfl, rfl⟩

private theorem le_one_of_isRestrictionAlong {g : Y.functionField}
    {h : T.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong T g h) : T.divisorialValuation g ≤ 1 := by
  obtain ⟨a, rfl, -⟩ := hh
  exact (T.divisorialValuation_le_one_iff _).2 ⟨a, rfl⟩

private theorem IsRestrictionAlong.add' {g₁ g₂ : Y.functionField}
    {h₁ h₂ : T.idealSheaf.subscheme.functionField}
    (hh₁ : IsRestrictionAlong T g₁ h₁) (hh₂ : IsRestrictionAlong T g₂ h₂) :
    IsRestrictionAlong T (g₁ + g₂) (h₁ + h₂) := by
  obtain ⟨a₁, rfl, rfl⟩ := hh₁
  obtain ⟨a₂, rfl, rfl⟩ := hh₂
  exact ⟨a₁ + a₂, map_add _ _ _, map_add _ _ _⟩

private theorem IsRestrictionAlong.mul' {g₁ g₂ : Y.functionField}
    {h₁ h₂ : T.idealSheaf.subscheme.functionField}
    (hh₁ : IsRestrictionAlong T g₁ h₁) (hh₂ : IsRestrictionAlong T g₂ h₂) :
    IsRestrictionAlong T (g₁ * g₂) (h₁ * h₂) := by
  obtain ⟨a₁, rfl, rfl⟩ := hh₁
  obtain ⟨a₂, rfl, rfl⟩ := hh₂
  exact ⟨a₁ * a₂, map_mul _ _ _, map_mul _ _ _⟩

/-- The restriction to `T` of a rational function regular along `T`, and `0` otherwise. -/
private noncomputable def restrictFF (g : Y.functionField) :
    T.idealSheaf.subscheme.functionField :=
  open Classical in
  if h : ∃ h, IsRestrictionAlong T g h then h.choose else 0

private theorem isRestrictionAlong_restrictFF {g : Y.functionField}
    (hg : T.divisorialValuation g ≤ 1) : IsRestrictionAlong T g (restrictFF T g) := by
  have h := exists_isRestrictionAlong_of_le_one T hg
  rw [restrictFF, dif_pos h]
  exact h.choose_spec

private theorem restrictFF_eq {g : Y.functionField}
    {h : T.idealSheaf.subscheme.functionField}
    (hh : IsRestrictionAlong T g h) : restrictFF T g = h :=
  isRestrictionAlong_unique T (isRestrictionAlong_restrictFF T (le_one_of_isRestrictionAlong T hh))
    hh

private theorem restrictFF_add {g₁ g₂ : Y.functionField} (h₁ : T.divisorialValuation g₁ ≤ 1)
    (h₂ : T.divisorialValuation g₂ ≤ 1) :
    restrictFF T (g₁ + g₂) = restrictFF T g₁ + restrictFF T g₂ :=
  restrictFF_eq T (IsRestrictionAlong.add' T (isRestrictionAlong_restrictFF T h₁) (isRestrictionAlong_restrictFF T h₂))

private theorem restrictFF_mul {g₁ g₂ : Y.functionField} (h₁ : T.divisorialValuation g₁ ≤ 1)
    (h₂ : T.divisorialValuation g₂ ≤ 1) :
    restrictFF T (g₁ * g₂) = restrictFF T g₁ * restrictFF T g₂ :=
  restrictFF_eq T (IsRestrictionAlong.mul' T (isRestrictionAlong_restrictFF T h₁) (isRestrictionAlong_restrictFF T h₂))

private theorem restrictFF_eq_zero_iff {g : Y.functionField} (hg : T.divisorialValuation g ≤ 1) :
    restrictFF T g = 0 ↔ T.divisorialValuation g < 1 := by
  constructor
  · intro h0
    have := isRestrictionAlong_restrictFF T hg
    rw [h0] at this
    exact lt_one_of_isRestrictionAlong_zero T this
  · intro h
    exact restrictFF_eq T (isRestrictionAlong_zero_of_lt_one T h)

/-- The generic point of `T` lies in every open meeting it, and then so does that of `Y`. -/
private theorem genericPoint_mem_of_index_preimage {W : Y.Opens}
    (Z' : {Z : irreducibleComponents T.idealSheaf.subscheme //
      componentGenericPoint _ Z ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W}) : genericPoint Y ∈ W := by
  have h : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W :=
    genericPoint_mem_of_index Z'
  exact ((genericPoint_spec Y).specializes
    (Set.mem_univ (T.idealSheaf.subschemeι (genericPoint _)))).mem_open W.isOpen h

private theorem support_inter_nonempty_of_index {W : Y.Opens}
    (Z' : {Z : irreducibleComponents T.idealSheaf.subscheme //
      componentGenericPoint _ Z ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W}) : (T.support ∩ W).Nonempty := by
  refine ⟨T.idealSheaf.subschemeι (genericPoint _), ?_, genericPoint_mem_of_index Z'⟩
  change _ ∈ (T.idealSheaf.support : Set Y)
  rw [← Scheme.IdealSheafData.range_subschemeι]
  exact ⟨_, rfl⟩

/-- The restriction to `T` of a section of `𝒦_Y` over `W`, a section of `𝒦_T` over `T ∩ W`. -/
private noncomputable def restrictSec {W : Y.Opens}
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op W))) :
    ToType ((rationalFunctionsPresheaf T.idealSheaf.subscheme).obj
      (op (T.idealSheaf.subschemeι ⁻¹ᵁ W))) :=
  fun Z' => ofFF _ (restrictFF T (evFF σ (topIndex Y (genericPoint_mem_of_index_preimage T Z')))) Z'

private theorem evFF_restrictSec {W : Y.Opens}
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z' : {Z : irreducibleComponents T.idealSheaf.subscheme //
      componentGenericPoint _ Z ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W})
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF (restrictSec T σ) Z' = restrictFF T (evFF σ Z) := by
  rw [show restrictSec T σ = ofFF _ (restrictFF T (evFF σ Z)) by
    funext Z''
    simp only [restrictSec]
    rw [index_eq (topIndex Y _) Z]]
  exact evFF_ofFF _ _ _

/-- The bound on a section of `𝒪_Y(L)` along a prime divisor meeting `W`. -/
private theorem divisorialValuation_evFF_le {L : Divisor Y} {W : Y.Opens}
    {σ : ToType ((rationalFunctionsPresheaf Y).obj (op W))} (hσ : σ ∈ L.divisorialSubmodule W)
    (E : MMP.Mori.PrimeDivisor Y) (hE : (E.support ∩ W).Nonempty)
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    E.divisorialValuation (evFF σ Z) ≤ WithZero.exp (L.coeff E) := by
  have := (ordGE_iff_divisorialValuation_le E _ _).1 (hσ E hE)
  rw [neg_neg] at this
  obtain rfl : (⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩ :
    {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) = Z := index_eq _ _
  exact this

private theorem mem_divisorialSubmodule_of_divisorialValuation_evFF_le {L : Divisor Y}
    {W : Y.Opens} {σ : ToType ((rationalFunctionsPresheaf Y).obj (op W))}
    (h : ∀ (E : MMP.Mori.PrimeDivisor Y) (hE : (E.support ∩ W).Nonempty),
      E.divisorialValuation (evFF σ ⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩) ≤
        WithZero.exp (L.coeff E)) :
    σ ∈ L.divisorialSubmodule W := fun E hE => by
  rw [ordGE_iff_divisorialValuation_le, neg_neg]
  exact h E hE

/-- A section of `𝒪_Y(L)`, `coeff_T L = 0`, is regular along `T` when `W` meets `T`. -/
private theorem divisorialValuation_evFF_le_one {L : Divisor Y} (hL : L.coeff T = 0)
    {W : Y.Opens} {σ : ToType ((rationalFunctionsPresheaf Y).obj (op W))}
    (hσ : σ ∈ L.divisorialSubmodule W) (hT : (T.support ∩ W).Nonempty)
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    T.divisorialValuation (evFF σ Z) ≤ 1 := by
  have := divisorialValuation_evFF_le hσ T hT Z
  rwa [hL, WithZero.exp_zero] at this

/-- The restriction of a regular function on `W` is the restriction of its section. -/
private theorem isRestrictionAlong_germ {W : Y.Opens} (hW : genericPoint Y ∈ W)
    (hTW : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W) (r : Γ(Y, W)) :
    IsRestrictionAlong T (Y.presheaf.germ W (genericPoint Y) hW r)
      (T.idealSheaf.subscheme.presheaf.germ _ (genericPoint _) hTW
        (T.idealSheaf.subschemeι.app W r)) :=
  ⟨Y.presheaf.germ W _ hTW r, TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _,
    Scheme.Hom.germ_stalkMap_apply _ _ _ _ _⟩

variable {k : Type} [Field k] (sY : Y ⟶ Spec (.of k)) [CompactSpace Y] [Smooth sY]
  [IsLocallyNoetherian T.idealSheaf.subscheme] [IsNormal T.idealSheaf.subscheme]
  [Smooth (T.idealSheaf.subschemeι ≫ sY)]

include sY in
/-- The restriction of a section of `𝒪_Y(L)` is a section of `𝒪_T(L|_T)`. -/
private theorem restrictSec_mem {L : Divisor Y} (hL : L.coeff T = 0) {W : Y.Opens}
    {σ : ToType ((rationalFunctionsPresheaf Y).obj (op W))} (hσ : σ ∈ L.divisorialSubmodule W) :
    restrictSec T σ ∈ Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
      (T.idealSheaf.subschemeι ⁻¹ᵁ W) := by
  refine mem_divisorialSubmodule_of_divisorialValuation_evFF_le fun Q hQ => ?_
  set Z' : {Z : irreducibleComponents T.idealSheaf.subscheme //
      componentGenericPoint _ Z ∈ T.idealSheaf.subschemeι ⁻¹ᵁ W} :=
    ⟨Q.component, Q.componentGenericPoint_mem_of_nonempty hQ⟩
  have hYW := genericPoint_mem_of_index_preimage T Z'
  set Z := topIndex Y hYW
  rw [evFF_restrictSec T σ Z' Z]
  have hTW := support_inter_nonempty_of_index T Z'
  have h1 := divisorialValuation_evFF_le_one T hL hσ hTW Z
  rcases h1.lt_or_eq with hlt | heq
  · rw [(restrictFF_eq_zero_iff T h1).2 hlt, map_zero]
    exact zero_le'
  · obtain ⟨a, ha⟩ := (T.divisorialValuation_le_one_iff _).1 h1
    have hau : IsUnit a := by
      by_contra hna
      have := (T.divisorialValuation_algebraMap_lt_one_iff a).2
        ((IsLocalRing.mem_maximalIdeal _).2 hna)
      rw [ha, heq] at this
      exact lt_irrefl _ this
    have hres : IsRestrictionAlong T (evFF σ Z)
        ((T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a) := ⟨a, ha, rfl⟩
    rw [restrictFF_eq T hres]
    refine divisorialValuation_restrict_le sY T L hL W a hau (fun E hE => ?_) Q hQ
    have := divisorialValuation_evFF_le hσ E hE Z
    rwa [← ha] at this

include sY in
/-- The components of the restriction morphism `𝒪_Y(L) ⟶ ι_*𝒪_T(L|_T)`. -/
private noncomputable def restrictionHomApp {L : Divisor Y} (hL : L.coeff T = 0)
    (U : Y.Opensᵒᵖ) :
    L.divisorialSheaf.val.obj U ⟶
      ((Scheme.Modules.pushforward T.idealSheaf.subschemeι).obj
        (Divisor.divisorialSheaf (L.restrictPrimeDivisor T))).val.obj U :=
  ConcreteCategory.ofHom
    { toFun := fun σ => ⟨restrictSec T (σ : L.divisorialSubmodule U.unop).1,
        restrictSec_mem T sY hL (σ : L.divisorialSubmodule U.unop).2⟩
      map_add' := fun a b => Subtype.ext (eq_of_evFF_eq fun Z' => by
        let Z := topIndex Y (genericPoint_mem_of_index_preimage T Z')
        have hTW := support_inter_nonempty_of_index T Z'
        change evFF (restrictSec T ((a : L.divisorialSubmodule U.unop).1 +
            (b : L.divisorialSubmodule U.unop).1)) Z' =
          evFF (restrictSec T (a : L.divisorialSubmodule U.unop).1 +
            restrictSec T (b : L.divisorialSubmodule U.unop).1) Z'
        rw [evFF_add, evFF_restrictSec T _ Z' Z, evFF_restrictSec T _ Z' Z,
          evFF_restrictSec T _ Z' Z, evFF_add,
          restrictFF_add T (divisorialValuation_evFF_le_one T hL (a : L.divisorialSubmodule
            U.unop).2 hTW Z) (divisorialValuation_evFF_le_one T hL (b : L.divisorialSubmodule
            U.unop).2 hTW Z)])
      map_smul' := fun r a => Subtype.ext (eq_of_evFF_eq fun Z' => by
        have hYW := genericPoint_mem_of_index_preimage T Z'
        let Z := topIndex Y hYW
        have hTW := support_inter_nonempty_of_index T Z'
        change evFF (restrictSec T ((show Γ(Y, U.unop) from r) • (show ToType ((rationalFunctionsPresheaf Y).obj
            (op U.unop)) from (a : L.divisorialSubmodule U.unop).1))) Z' =
          evFF (T.idealSheaf.subschemeι.app U.unop (show Γ(Y, U.unop) from r) •
            restrictSec T (a : L.divisorialSubmodule U.unop).1) Z'
        have hr := isRestrictionAlong_germ T hYW (genericPoint_mem_of_index Z') r
        rw [evFF_smul, evFF_restrictSec T _ Z' Z, evFF_restrictSec T _ Z' Z, evFF_smul,
          restrictFF_mul T (le_one_of_isRestrictionAlong T hr)
            (divisorialValuation_evFF_le_one T hL (a : L.divisorialSubmodule U.unop).2 hTW Z),
          restrictFF_eq T hr]) }

include sY in
/-- **The restriction morphism** `𝒪_Y(L) ⟶ ι_*𝒪_T(L|_T)` for a divisor `L` of which `T` is not
a component: a rational function regular along `T` goes to its restriction. -/
private noncomputable def restrictionHom {L : Divisor Y} (hL : L.coeff T = 0) :
    L.divisorialSheaf ⟶ (Scheme.Modules.pushforward T.idealSheaf.subschemeι).obj
      (Divisor.divisorialSheaf (L.restrictPrimeDivisor T)) :=
  ⟨{ app U := restrictionHomApp T sY hL U
     naturality := fun {U V} i => by
      ext a
      refine Subtype.ext (eq_of_evFF_eq fun Z' => ?_)
      have hYW := genericPoint_mem_of_index_preimage T Z'
      change evFF (restrictSec T ((rationalFunctionsPresheaf Y).map i
          (a : L.divisorialSubmodule U.unop).1)) Z' =
        evFF ((rationalFunctionsPresheaf T.idealSheaf.subscheme).map
          ((Opens.map T.idealSheaf.subschemeι.base).op.map i)
          (restrictSec T (a : L.divisorialSubmodule U.unop).1)) Z'
      rw [evFF_map, evFF_restrictSec T _ Z' (topIndex Y hYW),
        evFF_restrictSec T _ _ (topIndex Y (i.unop.le hYW)), evFF_map]
      rfl }⟩

omit [CompactSpace Y] [Smooth sY] [IsLocallyNoetherian T.idealSheaf.subscheme]
  [IsNormal T.idealSheaf.subscheme] [Smooth (T.idealSheaf.subschemeι ≫ sY)] in
/-- Points of `T` lie on the support of `T`. -/
private theorem subschemeι_mem_support (z : T.idealSheaf.subscheme) :
    T.idealSheaf.subschemeι z ∈ T.support := by
  change _ ∈ (T.idealSheaf.support : Set Y)
  rw [← Scheme.IdealSheafData.range_subschemeι]
  exact ⟨_, rfl⟩

omit [CompactSpace Y] [Smooth sY] [IsLocallyNoetherian T.idealSheaf.subscheme]
  [IsNormal T.idealSheaf.subscheme] [Smooth (T.idealSheaf.subschemeι ≫ sY)] in
/-- A rational function of valuation one along `T` is a unit of the local ring. -/
private theorem exists_isUnit_of_divisorialValuation_eq_one {g : Y.functionField}
    (hg : T.divisorialValuation g = 1) :
    ∃ a : Y.presheaf.stalk (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)),
      IsUnit a ∧ algebraMap _ Y.functionField a = g := by
  obtain ⟨a, ha⟩ := (T.divisorialValuation_le_one_iff _).1 hg.le
  refine ⟨a, ?_, ha⟩
  by_contra hna
  have := (T.divisorialValuation_algebraMap_lt_one_iff a).2
    ((IsLocalRing.mem_maximalIdeal _).2 hna)
  rw [ha, hg] at this
  exact lt_irrefl _ this

include sY in
/-- **Restricting a local equation.** If `a`, a unit at `η_T`, is a local equation of `L` on
`V`, then `a|_T` is one of `L|_T` along every prime divisor of `T` with generic point in `V`. -/
private theorem ord_restrict_eq_coeff {L : Divisor Y} (hL : L.coeff T = 0) (V : Y.Opens)
    (a : Y.presheaf.stalk (T.idealSheaf.subschemeι (genericPoint T.idealSheaf.subscheme)))
    (ha : IsUnit a)
    (hloc : ∀ E : MMP.Mori.PrimeDivisor Y, (E.support ∩ V).Nonempty →
      Y.ord (algebraMap _ Y.functionField a) E.genericPoint = L.coeff E)
    (Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme)
    (hQ : T.idealSheaf.subschemeι Q.genericPoint ∈ V) :
    T.idealSheaf.subscheme.ord ((T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a)
      Q.genericPoint = (L.restrictPrimeDivisor T).coeff Q := by
  haveI : IsNoetherian Y := ⟨⟩
  classical
  set g := algebraMap _ Y.functionField a with hgdef
  have hg0 : g ≠ 0 := (ha.map (algebraMap (Y.presheaf.stalk _) Y.functionField)).ne_zero
  set s := L.support ∪ (principalDivisor (Units.map
    (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom (Units.mk0 g hg0))).support with hs
  have hss : ∀ E : MMP.Mori.PrimeDivisor Y, Y.ord g E.genericPoint ≠ 0 → E ∈ s := fun E hE =>
    Finset.mem_union_right _ (by
      rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, MMP.Mori.coeff_principalDivisor_mk0]
      exact hE)
  rw [MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sY T.idealSheaf.subschemeι a ha Q s hss,
    DivisorWithCoeffs.coeff_restrictPrimeDivisor L T hL Q, Finsupp.sum]
  have hR : ∑ E ∈ L.support, E.intersectionLength T.idealSheaf.subschemeι Q • L E =
      ∑ E ∈ s, E.intersectionLength T.idealSheaf.subschemeι Q • L E :=
    Finset.sum_subset Finset.subset_union_left
      (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])
  rw [hR]
  refine Finset.sum_congr rfl fun E _ => ?_
  by_cases hmem : T.idealSheaf.subschemeι Q.genericPoint ∈ E.support
  · rw [nsmul_eq_mul, ← DivisorWithCoeffs.coeff_apply, ← hgdef, hloc E ⟨_, hmem, hQ⟩]
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hmem]
    simp

omit [CompactSpace Y] [Smooth sY] [IsLocallyNoetherian T.idealSheaf.subscheme]
  [IsNormal T.idealSheaf.subscheme] [Smooth (T.idealSheaf.subschemeι ≫ sY)] in
/-- A regular function on an open meeting `E` has valuation at most one along `E`. -/
private theorem divisorialValuation_germ_le_one (E : MMP.Mori.PrimeDivisor Y) {V : Y.Opens}
    (hE : (E.support ∩ V).Nonempty) (hV : genericPoint Y ∈ V) (b : Γ(Y, V)) :
    E.divisorialValuation (Y.presheaf.germ V (genericPoint Y) hV b) ≤ 1 :=
  (E.divisorialValuation_le_one_iff _).2
    ⟨Y.presheaf.germ V E.genericPoint (E.genericPoint_mem_of_nonempty hE) b, by
      change (Y.presheaf.stalkSpecializes _).hom _ = _
      exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _⟩

include sY in
/-- **Local surjectivity of restriction.** Every section of `ι_*𝒪_T(L|_T)` lifts, near every
point, to a section of `𝒪_Y(L)`, for `L` Cartier. -/
private theorem exists_restrictionHom_lift {L : Divisor Y} (hL : L.coeff T = 0)
    (hLc : L.IsCartier) (U : Y.Opens)
    (t : Γ((Scheme.Modules.pushforward T.idealSheaf.subschemeι).obj
      (Divisor.divisorialSheaf (L.restrictPrimeDivisor T)), U)) (x : Y) (hx : x ∈ U) :
    ∃ (V : Y.Opens) (hV : V ≤ U), x ∈ V ∧ ∃ s : Γ(L.divisorialSheaf, V),
      (restrictionHom T sY hL).app V s =
        ((Scheme.Modules.pushforward T.idealSheaf.subschemeι).obj
          (Divisor.divisorialSheaf (L.restrictPrimeDivisor T))).presheaf.map
            (homOfLE hV).op t := by
  set t' : Divisor.divisorialSubmodule (L.restrictPrimeDivisor T) (T.idealSheaf.subschemeι ⁻¹ᵁ U) := t
  have hcl : IsClosed T.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  by_cases hxT : x ∈ T.support
  swap
  · -- away from `T` the target vanishes
    refine ⟨U ⊓ ⟨T.supportᶜ, hcl.isOpen_compl⟩, inf_le_left, ⟨hx, hxT⟩, 0, ?_⟩
    apply Subtype.ext
    funext Z'
    exfalso
    have h : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ (U ⊓ ⟨T.supportᶜ, hcl.isOpen_compl⟩) :=
      genericPoint_mem_of_index Z'
    exact h.2 (subschemeι_mem_support T _)
  obtain ⟨y, rfl⟩ : x ∈ Set.range T.idealSheaf.subschemeι := by
    rw [Scheme.IdealSheafData.range_subschemeι]; exact hxT
  have hyU : y ∈ T.idealSheaf.subschemeι ⁻¹ᵁ U := hx
  have hηTU : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ U :=
    ((genericPoint_spec _).specializes (Set.mem_univ y)).mem_open (T.idealSheaf.subschemeι ⁻¹ᵁ U).isOpen hyU
  set ZT := topIndex T.idealSheaf.subscheme hηTU
  set τ := evFF t'.1 ZT with hτ
  -- a local equation of `L` near `x`
  obtain ⟨V₁, hxV₁, φ, hφ⟩ := hLc (T.idealSheaf.subschemeι y)
  set f := rationalFunctionsEquivFunctionField Y (φ : RationalFunctions Y) with hf
  have hf0 : f ≠ 0 := ((φ.isUnit).map (rationalFunctionsEquivFunctionField Y)).ne_zero
  have hord : ∀ E : MMP.Mori.PrimeDivisor Y, (E.support ∩ V₁).Nonempty →
      Y.ord f E.genericPoint = L.coeff E := fun E hE => by
    rw [hφ E hE, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  have hvf : ∀ E : MMP.Mori.PrimeDivisor Y, (E.support ∩ V₁).Nonempty →
      E.divisorialValuation f = WithZero.exp (-L.coeff E) := fun E hE => by
    rw [E.divisorialValuation_eq_exp_neg_ord hf0, hord E hE]
  have hvfT : T.divisorialValuation f = 1 := by
    rw [hvf T ⟨_, hxT, hxV₁⟩, hL, neg_zero, WithZero.exp_zero]
  obtain ⟨a, ha, haf⟩ := exists_isUnit_of_divisorialValuation_eq_one T hvfT
  set fT := restrictFF T f with hfT
  have hfTa : fT = (T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a := restrictFF_eq T ⟨a, haf, rfl⟩
  have hfinv : T.divisorialValuation f⁻¹ = 1 := by rw [map_inv₀, hvfT, inv_one]
  have hfmul : fT * restrictFF T f⁻¹ = 1 := by
    rw [hfT, ← restrictFF_mul T hvfT.le hfinv.le, mul_inv_cancel₀ hf0]
    exact restrictFF_eq T ⟨1, map_one _, map_one _⟩
  have hfT0 : fT ≠ 0 := left_ne_zero_of_mul_eq_one hfmul
  have hordT : ∀ Q : MMP.Mori.PrimeDivisor T.idealSheaf.subscheme, T.idealSheaf.subschemeι Q.genericPoint ∈ V₁ →
      Q.divisorialValuation fT = WithZero.exp (-(L.restrictPrimeDivisor T).coeff Q) := by
    intro Q hQ
    rw [Q.divisorialValuation_eq_exp_neg_ord hfT0, hfTa,
      ord_restrict_eq_coeff T sY hL V₁ a ha (fun E hE => by rw [haf]; exact hord E hE) Q hQ]
  -- `τ · fT` is regular at `y`
  obtain ⟨c, hc⟩ : ∃ c : T.idealSheaf.subscheme.presheaf.stalk y,
      algebraMap _ T.idealSheaf.subscheme.functionField c = τ * fT := by
    by_cases h0 : τ * fT = 0
    · exact ⟨0, by rw [map_zero, h0]⟩
    refine MMP.Threefold.Bridges.exists_algebraMap_stalk_eq_of_forall_zero_le_ord y h0
      fun Q hQ => ?_
    have hsp : Q.genericPoint ⤳ y := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hQ
      exact specializes_iff_mem_closure.mpr hQ
    have hQU : Q.genericPoint ∈ T.idealSheaf.subschemeι ⁻¹ᵁ U := hsp.mem_open (T.idealSheaf.subschemeι ⁻¹ᵁ U).isOpen hyU
    have hQV₁ : T.idealSheaf.subschemeι Q.genericPoint ∈ V₁ := (hsp.map T.idealSheaf.subschemeι.continuous).mem_open V₁.isOpen hxV₁
    have h1 := divisorialValuation_evFF_le t'.2 Q ⟨_, (by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl), hQU⟩ ZT
    have h2 : Q.divisorialValuation (τ * fT) ≤ 1 := by
      rw [map_mul, hordT Q hQV₁]
      calc Q.divisorialValuation τ * WithZero.exp (-(L.restrictPrimeDivisor T).coeff Q)
          ≤ WithZero.exp ((L.restrictPrimeDivisor T).coeff Q) *
            WithZero.exp (-(L.restrictPrimeDivisor T).coeff Q) := by gcongr
        _ = 1 := by rw [← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
    rw [Q.divisorialValuation_eq_exp_neg_ord h0, ← WithZero.exp_zero, WithZero.exp_le_exp] at h2
    omega
  -- lift through the closed immersion
  obtain ⟨b, hb⟩ := T.idealSheaf.subschemeι.stalkMap_surjective y c
  obtain ⟨V₂, hxV₂, b₀, hb₀⟩ := Y.presheaf.germ_exist (x := T.idealSheaf.subschemeι y) b
  have hηV₂ : genericPoint Y ∈ V₂ :=
    ((genericPoint_spec Y).specializes (Set.mem_univ (T.idealSheaf.subschemeι y))).mem_open V₂.isOpen hxV₂
  have hηT₂ : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ V₂ :=
    ((genericPoint_spec _).specializes (Set.mem_univ y)).mem_open (T.idealSheaf.subschemeι ⁻¹ᵁ V₂).isOpen hxV₂
  set g := Y.presheaf.germ V₂ (genericPoint Y) hηV₂ b₀ * f⁻¹ with hg
  set V := U ⊓ V₁ ⊓ V₂
  have hVU : V ≤ U := inf_le_left.trans inf_le_left
  have hmem : ofFF V g ∈ L.divisorialSubmodule V := by
    refine mem_divisorialSubmodule_of_divisorialValuation_evFF_le fun E hE => ?_
    rw [evFF_ofFF, hg, map_mul, map_inv₀]
    have hE₁ : (E.support ∩ V₁).Nonempty := hE.mono (Set.inter_subset_inter_right _
      (inf_le_left.trans inf_le_right))
    have hE₂ : (E.support ∩ V₂).Nonempty := hE.mono (Set.inter_subset_inter_right _ inf_le_right)
    rw [hvf E hE₁, ← WithZero.exp_neg, neg_neg]
    calc E.divisorialValuation (Y.presheaf.germ V₂ (genericPoint Y) hηV₂ b₀) *
          WithZero.exp (L.coeff E) ≤ 1 * WithZero.exp (L.coeff E) := by
            gcongr; exact divisorialValuation_germ_le_one E hE₂ hηV₂ b₀
      _ = _ := one_mul _
  refine ⟨V, hVU, ⟨⟨hx, hxV₁⟩, hxV₂⟩, ⟨ofFF V g, hmem⟩, ?_⟩
  refine Subtype.ext (eq_of_evFF_eq fun Z' => ?_)
  have hYV := genericPoint_mem_of_index_preimage T Z'
  change evFF (restrictSec T (ofFF V g)) Z' = _
  change _ = evFF ((rationalFunctionsPresheaf T.idealSheaf.subscheme).map
    ((Opens.map T.idealSheaf.subschemeι.base).op.map (homOfLE hVU).op) t'.1) Z'
  rw [evFF_map, evFF_restrictSec T _ Z' (topIndex Y hYV), evFF_ofFF,
    index_eq ⟨Z'.1, _⟩ ZT, ← hτ]
  -- the restriction of `g`
  have hr := isRestrictionAlong_germ T hηV₂ hηT₂ b₀
  have hrb : T.idealSheaf.subscheme.presheaf.germ _ (genericPoint _) hηT₂ (T.idealSheaf.subschemeι.app V₂ b₀) =
      τ * fT := by
    rw [← hc, ← hb, ← hb₀, Scheme.Hom.germ_stalkMap_apply]
    exact (TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _).symm
  rw [hg, restrictFF_mul T (le_one_of_isRestrictionAlong T hr) hfinv.le, restrictFF_eq T hr, hrb,
    mul_assoc, hfmul, mul_one]

include sY in
/-- The restriction morphism is an epimorphism, for `L` Cartier. -/
private theorem epi_restrictionHom {L : Divisor Y} (hL : L.coeff T = 0) (hLc : L.IsCartier) :
    Epi (restrictionHom T sY hL) :=
  Stacks.FundamentalGroup.epi_of_isLocallySurjective _
    (exists_restrictionHom_lift T sY hL hLc)

/-- `L - T ≤ L`. -/
private theorem sub_single_le (L : Divisor Y) : L - Finsupp.single T 1 ≤ L :=
  sub_le_self _ (Finsupp.single_nonneg.2 zero_le_one)

include sY in
private theorem inclusion_comp_restrictionHom {L : Divisor Y} (hL : L.coeff T = 0) :
    Divisor.divisorialSheafInclusion (sub_single_le T L) ≫ restrictionHom T sY hL = 0 := by
  refine Scheme.Modules.hom_ext _ _ fun U => ?_
  ext σ
  refine Subtype.ext (eq_of_evFF_eq fun Z' => ?_)
  have hYW := genericPoint_mem_of_index_preimage T Z'
  have hTW := support_inter_nonempty_of_index T Z'
  change evFF (restrictSec T (σ : Divisor.divisorialSubmodule _ U).1) Z' = evFF 0 Z'
  rw [evFF_restrictSec T _ Z' (topIndex Y hYW)]
  have h1 := divisorialValuation_evFF_le (σ : Divisor.divisorialSubmodule _ U).2 T hTW
    (topIndex Y hYW)
  rw [DivisorWithCoeffs.coeff_sub, hL, DivisorWithCoeffs.coeff_apply, Finsupp.single_eq_same,
    zero_sub] at h1
  have hlt : T.divisorialValuation (evFF (σ : Divisor.divisorialSubmodule _ U).1
      (topIndex Y hYW)) < 1 :=
    h1.trans_lt (by rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num)
  rw [(restrictFF_eq_zero_iff T hlt.le).2 hlt]
  exact (map_zero _).symm

include sY in
/-- **The restriction sequence** `0 ⟶ 𝒪_Y(L - T) ⟶ 𝒪_Y(L) ⟶ ι_*𝒪_T(L|_T) ⟶ 0`, for `L` Cartier
of which `T` is not a component. -/
private theorem shortExact_restrictionHom {L : Divisor Y} (hL : L.coeff T = 0)
    (hLc : L.IsCartier) :
    (ShortComplex.mk _ _ (inclusion_comp_restrictionHom T sY hL)).ShortExact := by
  haveI := epi_restrictionHom T sY hL hLc
  refine ⟨?_⟩
  refine Stacks.SheafOfModules.ComplexLocality.exact_of_isOpenCover (fun _ : Unit => ⊤)
    (by simp [TopologicalSpace.IsOpenCover]) _ fun _ W _ z hz => ?_
  set z' : L.divisorialSubmodule W := z
  refine ⟨⟨z'.1, mem_divisorialSubmodule_of_divisorialValuation_evFF_le fun E hE => ?_⟩, rfl⟩
  by_cases hET : E = T
  · subst hET
    set Z := (⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩ :
      {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W})
    have hηW : genericPoint E.idealSheaf.subscheme ∈ E.idealSheaf.subschemeι ⁻¹ᵁ W := by
      obtain ⟨p, hpE, hpW⟩ := hE
      obtain ⟨q, rfl⟩ : p ∈ Set.range E.idealSheaf.subschemeι := by
        rw [Scheme.IdealSheafData.range_subschemeι]; exact hpE
      exact ((genericPoint_spec _).specializes (Set.mem_univ q)).mem_open
        (E.idealSheaf.subschemeι ⁻¹ᵁ W).isOpen hpW
    have h0 := congrArg (fun w : Divisor.divisorialSubmodule (L.restrictPrimeDivisor E)
      (E.idealSheaf.subschemeι ⁻¹ᵁ W) => evFF w.1 (topIndex _ hηW)) hz
    change evFF (restrictSec E z'.1) (topIndex _ hηW) = evFF 0 (topIndex _ hηW) at h0
    rw [evFF_restrictSec E _ _ Z, show evFF (0 : ToType ((rationalFunctionsPresheaf
      E.idealSheaf.subscheme).obj (op (E.idealSheaf.subschemeι ⁻¹ᵁ W)))) (topIndex _ hηW) = 0 from
      map_zero _] at h0
    have h1 := divisorialValuation_evFF_le_one E hL z'.2 hE Z
    have hlt := (restrictFF_eq_zero_iff E h1).1 h0
    rw [DivisorWithCoeffs.coeff_sub, hL, DivisorWithCoeffs.coeff_apply, Finsupp.single_eq_same,
      zero_sub]
    obtain ⟨n, hn⟩ : ∃ n : ℤ, E.divisorialValuation (evFF z'.1 Z) = WithZero.exp n ∨
        E.divisorialValuation (evFF z'.1 Z) = 0 := by
      rcases eq_or_ne (E.divisorialValuation (evFF z'.1 Z)) 0 with h | h
      · exact ⟨0, Or.inr h⟩
      · exact ⟨WithZero.log _, Or.inl (WithZero.exp_log h).symm⟩
    rcases hn with hn | hn
    · rw [hn] at hlt ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hlt
      rw [WithZero.exp_le_exp]; omega
    · rw [hn]; exact zero_le'
  · have := divisorialValuation_evFF_le z'.2 E hE
      ⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩
    rwa [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single T 1),
      Finsupp.single_eq_of_ne hET, sub_zero]

end RestrictionSequence

/-! ### Lifting sections from the strict transform -/

section Lifting

open MMP.Mori

attribute [local instance] HasDerivedCategory.standard

variable {k : Type} [Field k] {X Y₀ : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀] [IsLocallyNoetherian Y₀]
  [IsNormal Y₀] [IsDominant μ₀] (S : MMP.Mori.PrimeDivisor X) (T : MMP.Mori.PrimeDivisor Y₀)
  [IsIntegral S.idealSheaf.subscheme] [IsIntegral T.idealSheaf.subscheme]
  (μT : T.idealSheaf.subscheme ⟶ S.idealSheaf.subscheme) [IsDominant μT]
  (hμT : μT ≫ S.idealSheaf.subschemeι = T.idealSheaf.subschemeι ≫ μ₀)
  (hT : μ₀ T.genericPoint = S.genericPoint)

include hμT hT in
/-- **Restriction through the strict transform.** If `μ₀` is an isomorphism near `η_S` and the
pull-back of `g` restricts on `T` to the pull-back of `h`, then `g` restricts to `h` on `S`. -/
private theorem isRestrictionAlong_of_isRestrictionAlong_strictTransform {V : X.Opens}
    (hV : IsIso (μ₀ ∣_ V)) (hSV : S.genericPoint ∈ V) {g : X.functionField}
    {h : S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong T (functionFieldMap μ₀ g) (functionFieldMap μT h)) :
    IsRestrictionAlong S g h := by
  have hvT := le_one_of_isRestrictionAlong T hgh
  have hbir : μ₀ T.genericPoint ∈ MMP.Mori.biregularLocus μ₀ :=
    MMP.Mori.le_biregularLocus hV (by rw [hT]; exact hSV)
  haveI := MMP.Threefold.Resolution.isIso_stalkMap_of_mem_biregularLocus μ₀ hbir
  have hvS : S.divisorialValuation g ≤ 1 := by
    rcases eq_or_ne g 0 with rfl | hg0
    · simp
    have hf0 : functionFieldMap μ₀ g ≠ 0 := (map_ne_zero _).mpr hg0
    rw [T.divisorialValuation_eq_exp_neg_ord hf0,
      MMP.Positivity.ord_functionFieldMap_of_isIso μ₀ T S hT g, ← WithZero.exp_zero,
      WithZero.exp_le_exp] at hvT
    rw [S.divisorialValuation_eq_exp_neg_ord hg0, ← WithZero.exp_zero, WithZero.exp_le_exp]
    exact hvT
  obtain ⟨a, rfl⟩ := (S.divisorialValuation_le_one_iff _).1 hvS
  obtain ⟨W, hηW, s, rfl⟩ := X.presheaf.germ_exist (x := S.genericPoint) a
  have hgW : genericPoint S.idealSheaf.subscheme ∈ S.idealSheaf.subschemeι ⁻¹ᵁ W := hηW
  have hTW : T.genericPoint ∈ μ₀ ⁻¹ᵁ W := by change μ₀ T.genericPoint ∈ W; rw [hT]; exact hηW
  set a₀ : Y₀.presheaf.stalk T.genericPoint :=
    Y₀.presheaf.germ (μ₀ ⁻¹ᵁ W) T.genericPoint hTW (μ₀.app W s) with ha₀def
  have hkey : functionFieldMap μT (S.idealSheaf.subschemeι.stalkMap (genericPoint _)
      (X.presheaf.germ W S.genericPoint hηW s)) =
      (T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a₀ := by
    have h1 := Scheme.Hom.germ_stalkMap_apply S.idealSheaf.subschemeι W
      (genericPoint S.idealSheaf.subscheme) hgW s
    have hZ : genericPoint T.idealSheaf.subscheme ∈ μT ⁻¹ᵁ (S.idealSheaf.subschemeι ⁻¹ᵁ W) := by
      change S.idealSheaf.subschemeι (μT (genericPoint _)) ∈ W
      rw [map_genericPoint_strictTransform μ₀ S T hT μT hμT]
      exact hηW
    change (functionFieldMap μT) ((S.idealSheaf.subschemeι.stalkMap _).hom
      (X.presheaf.germ W (S.idealSheaf.subschemeι (genericPoint _)) hgW s)) = _
    rw [h1, functionFieldMap_germ' μT (S.idealSheaf.subschemeι ⁻¹ᵁ W) hgW hZ, ha₀def]
    have h2 := Scheme.Hom.germ_stalkMap_apply T.idealSheaf.subschemeι (μ₀ ⁻¹ᵁ W)
      (genericPoint T.idealSheaf.subscheme) hTW (μ₀.app W s)
    refine Eq.trans ?_ h2.symm
    have key : ∀ (φ : T.idealSheaf.subscheme ⟶ X) (hφ : φ = T.idealSheaf.subschemeι ≫ μ₀)
        (h₁ : genericPoint T.idealSheaf.subscheme ∈ φ ⁻¹ᵁ W),
        T.idealSheaf.subscheme.presheaf.germ (φ ⁻¹ᵁ W) _ h₁ (φ.app W s) =
          T.idealSheaf.subscheme.presheaf.germ ((T.idealSheaf.subschemeι ≫ μ₀) ⁻¹ᵁ W) _
            (hφ ▸ h₁) ((T.idealSheaf.subschemeι ≫ μ₀).app W s) := by
      rintro φ rfl h₁; rfl
    exact key (μT ≫ S.idealSheaf.subschemeι) hμT hZ
  have hres : IsRestrictionAlong T (functionFieldMap μ₀
      (algebraMap S.localRing X.functionField (X.presheaf.germ W S.genericPoint hηW s)))
      ((T.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a₀) := by
    refine ⟨a₀, ?_, rfl⟩
    have hX : genericPoint X ∈ W :=
      ((genericPoint_spec X).specializes (Set.mem_univ S.genericPoint)).mem_open W.isOpen hηW
    have e1 : algebraMap S.localRing X.functionField (X.presheaf.germ W S.genericPoint hηW s) =
        X.presheaf.germ W (genericPoint X) hX s := by
      change (X.presheaf.stalkSpecializes _).hom _ = _
      exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
    rw [e1, functionFieldMap_germ' μ₀ W hX (genericPoint_mem_preimage μ₀ hX)]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  have huniq := isRestrictionAlong_unique T hgh hres
  rw [← hkey] at huniq
  rw [(functionFieldMap μT).injective huniq]
  exact ⟨_, rfl, rfl⟩

omit [IsDominant μT] in
include hμT in
private theorem preimage_strictTransform_eq (U : X.Opens) :
    μT ⁻¹ᵁ (S.idealSheaf.subschemeι ⁻¹ᵁ U) = T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ U) := by
  ext z
  change S.idealSheaf.subschemeι (μT z) ∈ U ↔ μ₀ (T.idealSheaf.subschemeι z) ∈ U
  have : S.idealSheaf.subschemeι (μT z) = μ₀ (T.idealSheaf.subschemeι z) := by
    change (μT ≫ S.idealSheaf.subschemeι) z = (T.idealSheaf.subschemeι ≫ μ₀) z
    rw [hμT]
  rw [this]

variable [CompactSpace Y₀] [Smooth (μ₀ ≫ sX)]
  [IsLocallyNoetherian T.idealSheaf.subscheme] [IsNormal T.idealSheaf.subscheme]
  [Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)]

include hμT in
/-- The section of `ι_*𝒪_T(L|_T)` over `μ₀⁻¹U` given by the pull-back of a section of
`μ_{T*}𝒪_T(L|_T)` over `S ∩ U`. -/
private theorem ofFF_mem_of_mem {L : Divisor Y₀} (U : X.Opens)
    {h : S.idealSheaf.subscheme.functionField}
    (hh : h ∈ MMP.Intersection.multiplierIdealSections μT (L.restrictPrimeDivisor T)
      (S.idealSheaf.subschemeι ⁻¹ᵁ U)) :
    ofFF (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ U)) (functionFieldMap μT h) ∈
      Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
        (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ U)) := by
  refine mem_divisorialSubmodule_of_divisorialValuation_evFF_le fun Q hQ => ?_
  rw [evFF_ofFF]
  have hQ' : (Q.support ∩ μT ⁻¹ᵁ (S.idealSheaf.subschemeι ⁻¹ᵁ U)).Nonempty := by
    rw [preimage_strictTransform_eq μ₀ S T μT hμT U]; exact hQ
  have := hh.2 Q hQ'
  rwa [MMP.Mori.PrimeDivisor.valuationOver_apply] at this

include sX hμT hT in
/-- A section of `𝒪_{Y₀}(L)` over `μ₀⁻¹V` restricting on `T` to the pull-back of `h` gives a
section of `μ₀_*𝒪_{Y₀}(L)` over `V` restricting to `h` on `S`. -/
private theorem exists_mem_of_restrictSec_eq {L : Divisor Y₀} (hL : L.coeff T = 0)
    {V' : X.Opens} (hV' : IsIso (μ₀ ∣_ V')) (hSV' : S.genericPoint ∈ V') {V : X.Opens}
    (hSV : S.genericPoint ∈ V)
    (hbij : Function.Bijective (functionFieldMap μ₀))
    (σ : L.divisorialSubmodule (μ₀ ⁻¹ᵁ V)) (h : S.idealSheaf.subscheme.functionField)
    (hσ : ∀ Z', evFF (restrictSec T σ.1) Z' = functionFieldMap μT h) :
    ∃ g ∈ MMP.Intersection.multiplierIdealSections μ₀ L V, IsRestrictionAlong S g h := by
  have hTV : T.genericPoint ∈ μ₀ ⁻¹ᵁ V := by change μ₀ T.genericPoint ∈ V; rw [hT]; exact hSV
  have hYV : genericPoint Y₀ ∈ μ₀ ⁻¹ᵁ V :=
    ((genericPoint_spec Y₀).specializes (Set.mem_univ T.genericPoint)).mem_open
      (μ₀ ⁻¹ᵁ V).isOpen hTV
  set Z := topIndex Y₀ hYV
  obtain ⟨g, hg⟩ := hbij.2 (evFF σ.1 Z)
  refine ⟨g, (mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ₀ L V σ.1 Z g hg).1 σ.2,
    ?_⟩
  have hηT : genericPoint T.idealSheaf.subscheme ∈ T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ V) := by
    change T.idealSheaf.subschemeι (genericPoint _) ∈ μ₀ ⁻¹ᵁ V
    exact hTV
  have hTsupp : T.genericPoint ∈ T.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hTmeet : (T.support ∩ μ₀ ⁻¹ᵁ V).Nonempty := ⟨T.genericPoint, hTsupp, hTV⟩
  have h1 := hσ (topIndex _ hηT)
  rw [evFF_restrictSec T _ _ Z, ← hg] at h1
  have hle := divisorialValuation_evFF_le_one T hL σ.2 hTmeet Z
  rw [← hg] at hle
  have hr := isRestrictionAlong_restrictFF T hle
  rw [h1] at hr
  exact isRestrictionAlong_of_isRestrictionAlong_strictTransform μ₀ S T μT hμT hT hV' hSV' hr

include sX hμT hT in
/-- **Global lifting.** If `R¹μ₀_*𝒪(L - T) = 0` and `H¹(X, μ₀_*𝒪(L - T)) = 0`, every global section
of `μ_{T*}𝒪_T(L|_T)` is the restriction of a global section of `μ₀_*𝒪_{Y₀}(L)`. -/
private theorem exists_lift_of_isZero_rightDerived_one {L : Divisor Y₀} (hL : L.coeff T = 0)
    (hLc : L.IsCartier) {V' : X.Opens} (hV' : IsIso (μ₀ ∣_ V')) (hSV' : S.genericPoint ∈ V')
    (hbij : Function.Bijective (functionFieldMap μ₀))
    (h1 : IsZero (((Scheme.Modules.pushforward μ₀).rightDerived 1).obj
      (L - Finsupp.single T 1).divisorialSheaf))
    (h1' : IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
      ((Scheme.Modules.pushforward μ₀).obj (L - Finsupp.single T 1).divisorialSheaf)))
    (h : S.idealSheaf.subscheme.functionField)
    (hh : h ∈ MMP.Intersection.multiplierIdealSections μT (L.restrictPrimeDivisor T)
      (S.idealSheaf.subschemeι ⁻¹ᵁ ⊤)) :
    ∃ g ∈ MMP.Intersection.multiplierIdealSections μ₀ L ⊤, IsRestrictionAlong S g h := by
  have hSES := shortExact_restrictionHom T (μ₀ ≫ sX) hL hLc
  have hSES' := Stacks.Cohomology.SectionsEpi.shortExact_map_of_isZero_rightDerived_one
    (Scheme.Modules.pushforward μ₀) hSES h1
  have hepi := Stacks.Cohomology.SectionsEpi.epi_map_g_of_isZero_rightDerived_one
    (Stacks.Cohomology.AffineBase.moduleGlobalSections X) hSES' h1'
  have hsurj := (ModuleCat.epi_iff_surjective _).1 hepi
  obtain ⟨σ, hσ⟩ := hsurj (show Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
    (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ ⊤)) from
      ⟨ofFF _ (functionFieldMap μT h), ofFF_mem_of_mem μ₀ S T μT hμT ⊤ hh⟩)
  refine exists_mem_of_restrictSec_eq sX μ₀ S T μT hμT hT hL hV' hSV' (V := ⊤) (show S.genericPoint ∈ (⊤ : X.Opens) from trivial) hbij
    (show L.divisorialSubmodule (μ₀ ⁻¹ᵁ ⊤) from σ) h fun Z' => ?_
  have h2 := congrArg (fun w : Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
    (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ ⊤)) => evFF w.1 Z') hσ
  simp only at h2
  rw [evFF_ofFF] at h2
  exact h2

include sX hμT hT in
/-- **Local lifting.** If `R¹μ₀_*𝒪(L - T) = 0`, every section of `μ_{T*}𝒪_T(L|_T)` over `S ∩ U`
is, near every point of `S ∩ U`, the restriction of a section of `μ₀_*𝒪_{Y₀}(L)`. -/
private theorem exists_local_lift_of_isZero_rightDerived_one {L : Divisor Y₀}
    (hL : L.coeff T = 0) (hLc : L.IsCartier) {V' : X.Opens} (hV' : IsIso (μ₀ ∣_ V'))
    (hSV' : S.genericPoint ∈ V') (hbij : Function.Bijective (functionFieldMap μ₀))
    (h1 : IsZero (((Scheme.Modules.pushforward μ₀).rightDerived 1).obj
      (L - Finsupp.single T 1).divisorialSheaf))
    (U : X.Opens) (h : S.idealSheaf.subscheme.functionField)
    (hh : h ∈ MMP.Intersection.multiplierIdealSections μT (L.restrictPrimeDivisor T)
      (S.idealSheaf.subschemeι ⁻¹ᵁ U))
    (x : S.idealSheaf.subscheme) (hx : x ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U) :
    ∃ V : X.Opens, S.idealSheaf.subschemeι x ∈ V ∧ V ≤ U ∧
      ∃ g ∈ MMP.Intersection.multiplierIdealSections μ₀ L V, IsRestrictionAlong S g h := by
  have hSES := shortExact_restrictionHom T (μ₀ ≫ sX) hL hLc
  have hSES' := Stacks.Cohomology.SectionsEpi.shortExact_map_of_isZero_rightDerived_one
    (Scheme.Modules.pushforward μ₀) hSES h1
  haveI hepi : Epi ((Scheme.Modules.pushforward μ₀).map (restrictionHom T (μ₀ ≫ sX) hL)) :=
    hSES'.epi_g
  have hls := AlgebraicGeometry.isLocallySurjective_mapPresheaf_of_epi X
    ((Scheme.Modules.pushforward μ₀).map (restrictionHom T (μ₀ ≫ sX) hL))
  rw [TopCat.Presheaf.isLocallySurjective_iff] at hls
  set t : Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
    (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ U)) :=
      ⟨ofFF _ (functionFieldMap μT h), ofFF_mem_of_mem μ₀ S T μT hμT U hh⟩ with ht
  obtain ⟨V, hVU, ⟨σ, hσ⟩, hxV⟩ := hls U t (S.idealSheaf.subschemeι x) hx
  have hSV : S.genericPoint ∈ V := by
    have hsp : S.genericPoint ⤳ S.idealSheaf.subschemeι x := by
      have hmem := subschemeι_mem_support S x
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hmem
      exact specializes_iff_mem_closure.mpr hmem
    exact hsp.mem_open V.isOpen hxV
  refine ⟨V, hxV, hVU, exists_mem_of_restrictSec_eq sX μ₀ S T μT hμT hT hL hV' hSV' hSV hbij
    (show L.divisorialSubmodule (μ₀ ⁻¹ᵁ V) from σ) h fun Z' => ?_⟩
  have h2 : evFF (restrictSec T (show L.divisorialSubmodule (μ₀ ⁻¹ᵁ V) from σ).1) Z' =
      evFF ((rationalFunctionsPresheaf T.idealSheaf.subscheme).map
        ((Opens.map T.idealSheaf.subschemeι.base).op.map
          ((Opens.map μ₀.base).op.map (homOfLE hVU).op)) t.1) Z' :=
    congrArg (fun w : Divisor.divisorialSubmodule (L.restrictPrimeDivisor T)
      (T.idealSheaf.subschemeι ⁻¹ᵁ (μ₀ ⁻¹ᵁ V)) => evFF w.1 Z') hσ
  rw [h2, evFF_map, ht]
  exact evFF_ofFF _ _ _

end Lifting

/-- **Twisting data exist.** For `f : X ⟶ Z` projective over an affine `Z` and `X` smooth there
are a Cartier `N` with `N - D` `f`-ample, a canonical divisor `K` and a Cartier `M ∼ K + Δ + N`
of which the prime divisor `S` is not a component. -/
private theorem exists_twist_data {k : Type} [Field k] {X Z : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (f : X ⟶ Z)
    (hf : IsProjectiveMorphism f) [IsAffine Z] (Δ : Divisor X) (D : QDivisor X)
    (S : MMP.Mori.PrimeDivisor X) :
    ∃ N : Divisor X, N.IsCartier ∧ (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f ∧
      ∃ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n ∧
        ∃ M : Divisor X, M.IsCartier ∧ M.LinearlyEquivalent (K + Δ + N) ∧ M.coeff S = 0 := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  have hcart : ∀ G : Divisor X, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI : UniversallyClosed f := (inferInstance : IsProper f).toUniversallyClosed
  haveI : QuasiCompact f := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  -- an ample Cartier divisor
  obtain ⟨L, hLinv, hLamp⟩ := exists_isAmple_of_isProjectiveMorphism_of_isAffine f hf
  obtain ⟨I, hI, -, -, m, hm, ⟨e⟩⟩ :=
    MMP.Threefold.Resolution.exists_isEffectiveCartierDivisor_of_isAmple L hLamp isClosed_empty
      (Set.notMem_empty (genericPoint X))
  obtain ⟨H, -, hHc, ⟨eH⟩, -⟩ :=
    MMP.Threefold.Resolution.exists_divisor_of_isEffectiveCartierDivisor I hI
  haveI := hHc.isInvertibleModule_divisorialSheaf
  have hHamp : Stacks.Ample.IsAmple X H.divisorialSheaf :=
    (Stacks.RelativeVeryAmple.isAmple_congr _ _ (e ≪≫ eH.symm)).mp
      (Stacks.AmplePositivePower.isAmple_tensorPowModule_of_isAmple L m hm hLamp)
  have hHf := isRelativelyAmple_of_isAmple_of_isAffine f hHc hHamp
  -- `N = cH` with `c` large
  obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  obtain ⟨m₀, hm₀⟩ := Filter.eventually_atTop.1 (eventually_isRelativelyAmpleCartier_nsmul_add f
    (isRelativelyAmpleCartier_of_isRelativelyAmple f hHc hHf) hD₀c.neg)
  set c := m₀ + 1
  have hA := hm₀ (mD * c) (le_trans (Nat.le_succ m₀) (Nat.le_mul_of_pos_left _ hmD))
  refine ⟨c • H, hHc.nsmul c, ⟨mD, hmD, _, hA.choose, ?_,
    isRelativelyAmple_of_isRelativelyAmpleCartier f hA⟩, ?_⟩
  · ext P
    have h := congrArg (fun G : QDivisor X => G.coeff P) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_neg,
      DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub, nsmul_eq_mul, zsmul_eq_mul,
      smul_eq_mul] at h ⊢
    push_cast at h ⊢
    linear_combination (-1 : ℚ) * h
  -- the canonical divisor and the twist
  obtain ⟨d, hd⟩ := exists_topologicalKrullDim_eq sX hX.1
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hd
  obtain ⟨t, ht⟩ := MMP.Flips.exists_primeDivisor_ord_eq S (-(K + Δ + c • H).coeff S)
  refine ⟨d, K, hK, K + Δ + c • H + principalDivisor t, hcart _, ⟨t, by abel⟩, ?_⟩
  rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor, ht]
  ring

/-- **Local lifting.** Every section of `𝒥_{Θ,D|_S}` over `S ∩ U` is, near every point of
`S ∩ U`, the restriction of a section of `𝒥_{Δ,D}`: on the strict transform setup the
restriction sequence for `𝒪(G₀ + μ₀^*M)`, `M ∼ K_X + Δ + N` with `coeff_S M = 0`, is exact on
the push-forward by the local vanishing of `R¹μ₀_*𝒪(G₀ - T + μ₀^*M)`, and the twist by `M` is
undone by a local equation of `M`. -/
private theorem exists_local_isRestrictionAlong {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y : Scheme.{0}} {μ : Y ⟶ X}
    {J : X.Opens → Set X.functionField} (hJ : IsReducedAdjointIdealOn sX Δ D μ J)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    {YS : Scheme.{0}} {μS : YS ⟶ S.idealSheaf.subscheme}
    {JS : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField}
    (hJS : haveI := S.integral; IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μS JS)
    {Y' : Scheme.{0}} {μ' : Y' ⟶ X} {J' : X.Opens → Set X.functionField}
    (hJ' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J') :
    haveI := S.integral
    ∀ (U : X.Opens), ∀ h ∈ JS (S.idealSheaf.subschemeι ⁻¹ᵁ U),
      ∀ x ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U, ∃ V : X.Opens,
        S.idealSheaf.subschemeι x ∈ V ∧ V ≤ U ∧ ∃ g ∈ J V, IsRestrictionAlong S g h := by
  haveI := S.integral
  intro U h hh x hx
  obtain ⟨Y₀, μ₀, _, _, _, _, _, T, μT, _, _, _, hdom, G₀, hμT, hT, hiso, hηS, hsmY, hsmT, -,
    hY₀, hμ₀, hJ₀, hJS₀, hG₀T, -, hloc⟩ := exists_strictTransform_setup sX f hf hJ S hS hJS hJ'
  obtain ⟨hX, hsm, -⟩ := id hJ
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hsm
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY₀.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  haveI : LocallyOfFinitePresentation (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)).mpr inferInstance
  haveI : Smooth (μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmT
  obtain ⟨hSv, hSsm, -, -, -, hlogS, -⟩ := id hJS
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hSsm
  haveI : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  haveI : CompactSpace T.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace T.idealSheaf.subschemeι
  haveI := hdom
  -- the twisting data
  obtain ⟨N, hN, hND, n, K, hK, M, hMc, hMK, hMS0⟩ := exists_twist_data sX hX hsm f hf Δ D S
  obtain ⟨Mμ₀, hMμ₀⟩ := hMc.exists_isPullback (f := μ₀)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ M)
  have hMμ₀T : Mμ₀.coeff T = 0 :=
    coeff_isPullback_eq_zero (F := ⟨Y₀, μ₀, hY₀, hμ₀, T⟩) hMc
      (by change μ₀ T.genericPoint ∉ _; rw [hT]
          exact genericPoint_notMem_supp_of_coeff_eq_zero M S hMS0) Mμ₀ _ hMμ₀
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) := hSsm
  have hDTμ : ∀ C : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ C) ∉ (M.restrictPrimeDivisor S).supp := by
    intro C
    rw [componentGenericPoint_eq_genericPoint', map_genericPoint_strictTransform μ₀ S T hT μT hμT]
    exact genericPoint_notMem_supp _
  have hMT := isPullback_restrictPrimeDivisor_of_isPullback sX μ₀ S T hT μT hμT hMc hMS0 hMμ₀
    hMμ₀T hDTμ
  haveI : IsNoetherian Y₀ := ⟨⟩
  have hres : (G₀ + Mμ₀).restrictPrimeDivisor T =
      G₀.restrictPrimeDivisor T + Mμ₀.restrictPrimeDivisor T :=
    MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_add _ _ T hG₀T hMμ₀T
  have hGT : (G₀ + Mμ₀).coeff T = 0 := by rw [DivisorWithCoeffs.coeff_add, hG₀T, hMμ₀T, add_zero]
  -- the local vanishing
  set L := G₀ + Mμ₀ with hLdef
  have hLc : L.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  have hLT : L - Finsupp.single T 1 = G₀ - Finsupp.single T 1 + Mμ₀ := by rw [hLdef]; abel
  have hN' : (N + Finsupp.single S 1).IsCartier :=
    hN.add (MMP.Fourfold.isCartier_of_isSmoothScheme hsm _)
  have hND' : (Divisor.toQDivisor (N + Finsupp.single S 1) -
      (D + Divisor.toQDivisor (Finsupp.single S 1))).HasRelativelyAmpleMultiple f := by
    rw [show Divisor.toQDivisor (N + Finsupp.single S 1) -
      (D + Divisor.toQDivisor (Finsupp.single S 1)) = Divisor.toQDivisor N - D by
        rw [map_add]; abel]
    exact hND
  have hMK' : M.LinearlyEquivalent (K + (Δ - Finsupp.single S 1) + (N + Finsupp.single S 1)) := by
    rw [show K + (Δ - Finsupp.single S 1) + (N + Finsupp.single S 1) = K + Δ + N by abel]
    exact hMK
  have h1 : IsZero (((Scheme.Modules.pushforward μ₀).rightDerived 1).obj
      (L - Finsupp.single T 1).divisorialSheaf) := by
    rw [hLT]
    exact hloc _ hN' hND' n K hK M hMc hMK' _ Mμ₀ hMμ₀ 1 one_pos
  have hηS' : S.genericPoint ∈ D.supp.compl := hηS
  -- a local equation of `M` near `x` and its restriction to `S`
  obtain ⟨V₀, hxV₀, φ, hφ⟩ := hMc (S.idealSheaf.subschemeι x)
  let Z₀ : irreducibleComponents X := pointComponent (genericPoint X)
  set c := MMP.Threefold.Mori.Helpers.evalFF Z₀ (φ : RationalFunctions X) with hcdef
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcomp : ∀ E : MMP.Mori.PrimeDivisor X, E.component = Z₀ := fun E =>
    Subtype.ext ((eq_univ_of_irreducibleComponents' _).trans
      (eq_univ_of_irreducibleComponents' _).symm)
  have hordc : ∀ E : MMP.Mori.PrimeDivisor X, (E.support ∩ V₀).Nonempty →
      X.ord c E.genericPoint = M.coeff E := fun E hE => by
    rw [hφ E hE, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hcomp E]
  have hSV₀ : (S.support ∩ V₀).Nonempty := ⟨_, subschemeι_mem_support S x, hxV₀⟩
  have hvc : S.divisorialValuation c = 1 := by
    rw [S.divisorialValuation_eq_exp_neg_ord hc0, hordc S hSV₀, hMS0, neg_zero, WithZero.exp_zero]
  obtain ⟨a, ha, hac⟩ := exists_isUnit_of_divisorialValuation_eq_one S hvc
  set cS := restrictFF S c with hcSdef
  have hcSa : cS = (S.idealSheaf.subschemeι.stalkMap (genericPoint _)).hom a :=
    restrictFF_eq S ⟨a, hac, rfl⟩
  have hcinv : S.divisorialValuation c⁻¹ = 1 := by rw [map_inv₀, hvc, inv_one]
  have hcmul : cS * restrictFF S c⁻¹ = 1 := by
    rw [hcSdef, ← restrictFF_mul S hvc.le hcinv.le, mul_inv_cancel₀ hc0]
    exact restrictFF_eq S ⟨1, map_one _, map_one _⟩
  have hcS0 : cS ≠ 0 := left_ne_zero_of_mul_eq_one hcmul
  have hordcS : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
      S.idealSheaf.subschemeι Q.genericPoint ∈ V₀ →
      S.idealSheaf.subscheme.ord cS Q.genericPoint = (M.restrictPrimeDivisor S).coeff Q := by
    intro Q hQ
    rw [hcSa]
    exact ord_restrict_eq_coeff S sX hMS0 V₀ a ha (fun E hE => by rw [hac]; exact hordc E hE) Q hQ
  set φS := unitOfFunctionField cS hcS0
  have hφS : Divisor.IsLocalEquation (M.restrictPrimeDivisor S)
      (S.idealSheaf.subschemeι ⁻¹ᵁ V₀) φS := by
    intro Q hQ
    rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, evalFF_unitOfFunctionField,
      hordcS Q (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty Q hQ)]
  let ZS : irreducibleComponents S.idealSheaf.subscheme := pointComponent (genericPoint _)
  have hφSc : MMP.Threefold.Mori.Helpers.evalFF ZS (φS : RationalFunctions _) = cS :=
    evalFF_unitOfFunctionField _ _ _
  -- the twisted section on `S`
  set U' := U ⊓ V₀
  have hxU' : x ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U' := ⟨hx, hxV₀⟩
  have hU'ne : S.idealSheaf.subschemeι ⁻¹ᵁ U' ≠ ⊥ := fun hb => by
    have := hxU'; rw [hb] at this; exact this
  rw [hJS₀] at hh
  have hh₁ := multiplierIdealSections_mono μT _
    (show S.idealSheaf.subschemeι ⁻¹ᵁ U' ≤ S.idealSheaf.subschemeι ⁻¹ᵁ U from
      fun _ hz => hz.1) hU'ne hh
  have hh' : cS⁻¹ * h ∈ MMP.Intersection.multiplierIdealSections μT
      (L.restrictPrimeDivisor T) (S.idealSheaf.subschemeι ⁻¹ᵁ U') := by
    rw [hLdef, hres, mem_multiplierIdealSections_add_iff hMT hφS ZS _
      (show S.idealSheaf.subschemeι ⁻¹ᵁ U' ≤ S.idealSheaf.subschemeι ⁻¹ᵁ V₀ from
        fun _ hz => hz.2) _, hφSc, mul_inv_cancel_left₀ hcS0]
    exact hh₁
  obtain ⟨V, hxV, hVU', g', hg', hr'⟩ := exists_local_lift_of_isZero_rightDerived_one sX μ₀ S T μT
    hμT hT hGT hLc hiso hηS' hμ₀.functionFieldMap_bijective h1 U' _ hh' x hxU'
  refine ⟨V, hxV, hVU'.trans inf_le_left, c * g', ?_, ?_⟩
  · rw [hJ₀]
    exact (mem_multiplierIdealSections_add_iff hMμ₀ hφ Z₀ G₀ (hVU'.trans inf_le_right) g').1 hg'
  · have := IsRestrictionAlong.mul' S (isRestrictionAlong_restrictFF S hvc.le) hr'
    rwa [← hcSdef, mul_inv_cancel_left₀ hcS0] at this

/-- **Global lifting of twisted sections.** For `M ∼ K_X + Δ + N` Cartier with `N - D`
`f`-ample and `coeff_S M = 0`, every global section of `μ_{S*}𝒪(G_S + M_S)` is the restriction of
a global section of `μ_*𝒪(G + μ^*M)`. -/
private theorem exists_isRestrictionAlong_twist_lift {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y : Scheme.{0}} {μ : Y ⟶ X} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsDominant μ]
    {J : X.Opens → Set X.functionField} (hJ : IsReducedAdjointIdealOn sX Δ D μ J)
    {G : Divisor Y} (hG : J = MMP.Intersection.multiplierIdealSections μ G)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    {YS : Scheme.{0}} {μS : YS ⟶ S.idealSheaf.subscheme}
    [IsIntegral YS] [IsLocallyNoetherian YS] [IsNormal YS] [IsDominant μS]
    {JS : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField}
    (hJS : haveI := S.integral; IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
      ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μS JS)
    {GS : Divisor YS}
    (hGS : haveI := S.integral; JS = MMP.Intersection.multiplierIdealSections μS GS)
    {Y' : Scheme.{0}} {μ' : Y' ⟶ X} {J' : X.Opens → Set X.functionField}
    (hJ' : IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
      (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J')
    {N : Divisor X} (hN : N.IsCartier)
    (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n)
    {M : Divisor X} (hMc : M.IsCartier) (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMS0 : M.coeff S = 0)
    {hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp}
    {Mμ : Divisor Y} (hMpb : M.IsPullback μ hMμ Mμ)
    {hMS : ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp}
    {MS : Divisor YS} (hMSpb : M.IsPullback (μS ≫ S.idealSheaf.subschemeι) hMS MS) :
    haveI := S.integral
    ∀ h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤,
      ∃ g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤, IsRestrictionAlong S g h := by
  haveI := S.integral
  intro h hh
  obtain ⟨Y₀, μ₀, _, _, _, _, _, T, μT, _, _, _, hdom, G₀, hμT, hT, hiso, hηS, hsmY, hsmT, -,
    hY₀, hμ₀, hJ₀, hJS₀, hG₀T, ⟨J₀', hJ₀', hJ₀'eq⟩, hloc⟩ := exists_strictTransform_setup sX f hf hJ S hS hJS hJ'
  obtain ⟨hX, hsm, -⟩ := id hJ
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).mp hsm
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY₀.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  haveI : LocallyOfFinitePresentation (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)).mpr inferInstance
  haveI : Smooth (μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
  haveI : Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmT
  obtain ⟨hSv, hSsm, -, -, -, hlogS, -⟩ := id hJS
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hSsm
  haveI : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  haveI : CompactSpace T.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace T.idealSheaf.subschemeι
  haveI : IsProper μS := hlogS.isProper
  haveI : CompactSpace YS := QuasiCompact.compactSpace_of_compactSpace μS
  -- the twist on `Y₀`
  obtain ⟨Mμ₀, hMμ₀⟩ := hMc.exists_isPullback (f := μ₀)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ M)
  have hsec : MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ₀ (G₀ + Mμ₀) :=
    multiplierIdealSections_add_pullback_congr hMc hMpb hMμ₀ (hG.symm.trans hJ₀)
  have hMμ₀T : Mμ₀.coeff T = 0 :=
    coeff_isPullback_eq_zero (F := ⟨Y₀, μ₀, hY₀, hμ₀, T⟩) hMc
      (by change μ₀ T.genericPoint ∉ _; rw [hT]
          exact genericPoint_notMem_supp_of_coeff_eq_zero M S hMS0) Mμ₀ _ hMμ₀
  -- the twist on `S`: `M|_S` and its pull-backs
  have hsmS : MMP.Mori.IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) := hSsm
  have hMSc : Divisor.IsCartier (M.restrictPrimeDivisor S) :=
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmS _
  have hDTμ : ∀ C : irreducibleComponents T.idealSheaf.subscheme,
      μT (componentGenericPoint _ C) ∉ (M.restrictPrimeDivisor S).supp := by
    intro C
    rw [componentGenericPoint_eq_genericPoint', map_genericPoint_strictTransform μ₀ S T hT μT hμT]
    exact genericPoint_notMem_supp _
  have hMT := isPullback_restrictPrimeDivisor_of_isPullback sX μ₀ S T hT μT hμT hMc hMS0 hMμ₀
    hMμ₀T hDTμ
  obtain ⟨MS', hMS'⟩ := hMSc.exists_isPullback (f := μS)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μS _)
  have h1 := isPullback_restrictPrimeDivisor sX S M hMS0
  have h2 := isPullback_comp h1 hMS' hMS
  have hMSeq := MMP.Mori.Divisor.IsPullback.eq hMc h2 hMSpb
  rw [hMSeq] at hMS'
  have hsecS : MMP.Intersection.multiplierIdealSections μS (GS + MS) =
      MMP.Intersection.multiplierIdealSections μT
        (G₀.restrictPrimeDivisor T + Mμ₀.restrictPrimeDivisor T) :=
    multiplierIdealSections_add_pullback_congr hMSc hMS' hMT (hGS.symm.trans hJS₀)
  haveI : IsNoetherian Y₀ := ⟨⟩
  have hres : (G₀ + Mμ₀).restrictPrimeDivisor T =
      G₀.restrictPrimeDivisor T + Mμ₀.restrictPrimeDivisor T :=
    MMP.Mori.DivisorWithCoeffs.restrictPrimeDivisor_add _ _ T hG₀T hMμ₀T
  have hGT : (G₀ + Mμ₀).coeff T = 0 := by rw [DivisorWithCoeffs.coeff_add, hG₀T, hMμ₀T, add_zero]
  rw [hsecS, ← hres, ← Scheme.Hom.preimage_top S.idealSheaf.subschemeι] at hh
  rw [hsec]
  -- vanishing for `𝒪(G₀ + μ₀^*M - T)`
  set L := G₀ + Mμ₀ with hLdef
  have hLc : L.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  have hLT : L - Finsupp.single T 1 = G₀ - Finsupp.single T 1 + Mμ₀ := by rw [hLdef]; abel
  have hN' : (N + Finsupp.single S 1).IsCartier :=
    hN.add (MMP.Fourfold.isCartier_of_isSmoothScheme hsm _)
  have hND' : (Divisor.toQDivisor (N + Finsupp.single S 1) -
      (D + Divisor.toQDivisor (Finsupp.single S 1))).HasRelativelyAmpleMultiple f := by
    rw [show Divisor.toQDivisor (N + Finsupp.single S 1) -
      (D + Divisor.toQDivisor (Finsupp.single S 1)) = Divisor.toQDivisor N - D by
        rw [map_add]; abel]
    exact hND
  have hMK' : M.LinearlyEquivalent (K + (Δ - Finsupp.single S 1) + (N + Finsupp.single S 1)) := by
    rw [show K + (Δ - Finsupp.single S 1) + (N + Finsupp.single S 1) = K + Δ + N by abel]
    exact hMK
  have h1 : IsZero (((Scheme.Modules.pushforward μ₀).rightDerived 1).obj
      (L - Finsupp.single T 1).divisorialSheaf) := by
    rw [hLT]
    exact hloc _ hN' hND' n K hK M hMc hMK' _ Mμ₀ hMμ₀ 1 one_pos
  have h1' : IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
      ((Scheme.Modules.pushforward μ₀).obj (L - Finsupp.single T 1).divisorialSheaf)) := by
    rw [hLT]
    exact isZero_rightDerived_twist sX f hf μ₀ hJ₀' (G₀ - Finsupp.single T 1) hJ₀'eq _ hN' hND' hK
      M hMc hMK' _ Mμ₀ hMμ₀ 1 one_pos
  have hηS' : S.genericPoint ∈ D.supp.compl := hηS
  exact exists_lift_of_isZero_rightDerived_one sX μ₀ S T μT hμT hT hGT hLc hiso hηS'
    hμ₀.functionFieldMap_bijective h1 h1' h hh

end Proof_thm_fourfold_adjoint_restriction_vanishing

end

section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori
open Proof_thm_fourfold_adjoint_restriction_vanishing
open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Pointwise Opposite
open MMP.Mori MMP.Fourfold

attribute [local instance] HasDerivedCategory.standard

/-- **Restriction and ample vanishing for reduced-boundary adjoint ideals.** Let `f : X ⟶ Z` be
projective with `Z` affine and `X` a smooth variety over an algebraically closed field `k` of
characteristic zero, `Δ` reduced snc, `D ≥ 0` a `ℚ`-divisor containing no stratum of `Δ`, and
`J = 𝒥_{Δ,D}` computed on a log resolution `μ`, with `J = μ_*𝒪_Y(G)`.
1. If `N` is an integral Cartier divisor with `N - D` `f`-ample, `K` a canonical divisor, and
   `M ∼ K + Δ + N` a Cartier divisor, then `H^i(X, μ_*𝒪_Y(G + μ^*M)) = 0` for `i > 0` (this
   sheaf is `J(K + Δ + N)`).
2. Let `S` be a component of `Δ`, `Θ = (Δ - S)|_S`, and `J' = 𝒥_{Δ-S,D+S}`,
   `JS = 𝒥_{Θ,D|_S}` computed on log resolutions `μ'`, `μS`, with `JS = μS_*𝒪_{Y_S}(G_S)`.
   Then `0 → J' → J → ι_*JS → 0` is exact, the first map being the inclusion and the second the
   restriction of functions to `S`; and for `N`, `K` as in 1 and `M ∼ K + Δ + N` a Cartier
   divisor of which `S` is not a component, restriction maps the global sections of
   `J(M) = μ_*𝒪_Y(G + μ^*M)` onto those of `JS(M|_S) = μS_*𝒪_{Y_S}(G_S + μS^*(M|_S))`. -/
@[mmp "thm_fourfold_adjoint_restriction_vanishing"]
public theorem isReducedAdjointIdealOn_restriction_vanishing {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : X ⟶ Z)
    (hf : IsProjectiveMorphism f) [IsAffine Z] (Δ : Divisor X) (D : QDivisor X)
    {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] (J : X.Opens → Set X.functionField) (hJ : IsReducedAdjointIdealOn sX Δ D μ J)
    (G : Divisor Y) (hG : J = MMP.Intersection.multiplierIdealSections μ G) :
    -- 1. vanishing for the twist by `K_X + Δ + N`
    (∀ (N : Divisor X), N.IsCartier →
      (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f →
      ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
      ∀ (M : Divisor X), M.IsCartier → M.LinearlyEquivalent (K + Δ + N) →
      ∀ (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
        (Mμ : Divisor Y), M.IsPullback μ hMμ Mμ →
      ∀ i : ℕ, 0 < i →
        IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
          ((Scheme.Modules.pushforward μ).obj (G + Mμ).divisorialSheaf))) ∧
    -- 2. restriction to a component `S` of `Δ`
    ∀ (S : MMP.Mori.PrimeDivisor X), Δ.coeff S = 1 →
    ∀ [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
      {Y' : Scheme.{0}} (μ' : Y' ⟶ X) (J' : X.Opens → Set X.functionField),
      IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
        (D + Divisor.toQDivisor (Finsupp.single S 1)) μ' J' →
    haveI := S.integral
    ∀ {YS : Scheme.{0}} (μS : YS ⟶ S.idealSheaf.subscheme) [IsIntegral YS]
      [IsLocallyNoetherian YS] [IsNormal YS] [IsDominant μS]
      (JS : S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField),
      IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
        ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (D.restrictPrimeDivisor S) μS JS →
      ∀ (GS : Divisor YS), JS = MMP.Intersection.multiplierIdealSections μS GS →
      -- 2a. the exact sequence `0 → 𝒥_{Δ-S,D+S} → 𝒥_{Δ,D} → ι_*𝒥_{Θ,D|_S} → 0`
      ((∀ U, J' U ⊆ J U) ∧
        (∀ (U : X.Opens) (g : X.functionField), g ∈ J U →
          S.idealSheaf.subschemeι ⁻¹ᵁ U ≠ ⊥ →
          ∃ h ∈ JS (S.idealSheaf.subschemeι ⁻¹ᵁ U), IsRestrictionAlong S g h) ∧
        (∀ (U : X.Opens) (g : X.functionField), g ∈ J U →
          (g ∈ J' U ↔ (S.idealSheaf.subschemeι ⁻¹ᵁ U = ⊥ ∨ IsRestrictionAlong S g 0))) ∧
        (∀ (U : X.Opens), ∀ h ∈ JS (S.idealSheaf.subschemeι ⁻¹ᵁ U),
          ∀ x ∈ S.idealSheaf.subschemeι ⁻¹ᵁ U, ∃ V : X.Opens,
            S.idealSheaf.subschemeι x ∈ V ∧ V ≤ U ∧ ∃ g ∈ J V, IsRestrictionAlong S g h)) ∧
      -- 2b. surjectivity on `H^0` for the twist by `K_X + Δ + N`
      ∀ (N : Divisor X), N.IsCartier →
        (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f →
        ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
        ∀ (M : Divisor X), M.IsCartier → M.LinearlyEquivalent (K + Δ + N) → M.coeff S = 0 →
        ∀ (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
          (Mμ : Divisor Y), M.IsPullback μ hMμ Mμ →
        ∀ (hMS : ∀ C : irreducibleComponents YS,
            (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp)
          (MS : Divisor YS), M.IsPullback (μS ≫ S.idealSheaf.subschemeι) hMS MS →
          (∀ g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤,
            ∃ h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤,
              IsRestrictionAlong S g h) ∧
          ∀ h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤,
            ∃ g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤,
              IsRestrictionAlong S g h := by
  refine ⟨fun N hN hND n K hK M hMc hMK hMμ Mμ hMpb i hi =>
    isZero_rightDerived_twist sX f hf μ hJ G hG N hN hND hK M hMc hMK hMμ Mμ hMpb i hi, ?_⟩
  intro S hS _ _ Y' μ' J' hJ' YS μS _ _ _ _ JS hJS GS hGS
  refine ⟨⟨?incl, ?restr, ?ker, ?lift⟩, ?twist⟩
  case incl => exact subset_of_sub_single sX hJ hJ'
  case restr =>
    intro U g hg hU
    obtain ⟨Y₀, μ₀, _, _, _, _, _, T, μT, _, _, _, hdom, G₀, hμT, hT, hiso, hηS, hsmY, hsmT, -,
      hY₀, hμ₀, hJ₀, hJS₀, hG₀T, -, -⟩ := exists_strictTransform_setup sX f hf hJ S hS hJS hJ'
    haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY₀.1.toLocallyOfFiniteType
    haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
    haveI : LocallyOfFinitePresentation (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) :=
      (LocallyOfFinitePresentation.iff_locallyOfFiniteType
        (f := T.idealSheaf.subschemeι ≫ μ₀ ≫ sX)).mpr inferInstance
    haveI : Smooth (μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmY
    haveI : Smooth (T.idealSheaf.subschemeι ≫ μ₀ ≫ sX) := (MMP.Mori.isSmoothScheme_iff _).mp hsmT
    rw [hJ₀] at hg
    rw [hJS₀]
    exact exists_mem_isRestrictionAlong_of_mem sX μ₀ hμ₀ S T μT hdom hμT hT hiso hηS G₀ hG₀T U g
      hg hU
  case ker => exact fun U g hg => mem_iff_isRestrictionAlong_zero sX hS hJ hJ' U g hg
  case lift => exact exists_local_isRestrictionAlong sX f hf hJ S hS hJS hJ'
  case twist =>
    intro N hN hND n K hK M hMc hMK hMS0 hMμ Mμ hMpb hMS MS hMSpb
    exact ⟨exists_isRestrictionAlong_twist sX f hf hJ hG S hS hJS hGS hJ' hMc hMS0 hMpb hMSpb,
      exists_isRestrictionAlong_twist_lift sX f hf hJ hG S hS hJS hGS hJ' hN hND hK hMc hMK hMS0
        hMpb hMSpb⟩

end MMP.Fourfold

end

/-! ### `lem_mmp_adjoint_small_multiplicity_unit` -/

section

noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise

namespace Proof_lem_mmp_adjoint_small_multiplicity_unit

open MMP.Mori MMP.Fourfold

/-! ### Log discrepancies under adding a Cartier divisor, and valuative bounds -/

section Toolkit

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- Adding `c • C` to the boundary, for a Cartier divisor `C` with pull-back `C'` along the model,
lowers a log discrepancy by `c` times the coefficient of `C'` along the divisor. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {C : Divisor X}
    (hC : C.IsCartier) (c : ℝ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + c • Divisor.toRDivisor C) F
        (a - c * (C'.coeff F.E : ℝ)) := by
  classical
  intro C' hCs hC'
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₁, C₁', hC₁, hrel, hpb, ha⟩ := h
  refine ⟨hnv, hprop, ω, hω0, hK, m + 1, Fin.snoc r c, Fin.snoc C₁ C, Fin.snoc C₁' C', ?_, ?_,
    ?_, ?_⟩
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using hC
    · simpa using hC₁ j
  · intro Γ
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, DivisorWithCoeffs.coeff_add, ← hrel Γ,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    ring
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · refine ⟨by simpa using hCs, ?_⟩
      simpa using hC'
    · simpa using hpb j
  · rw [Fin.sum_univ_castSucc, ha]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    ring

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → 0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- On a smooth variety every `ℚ`-divisor `B` makes a pair `(X, B)`, with any canonical divisor
of the right dimension. -/
private theorem exists_isPairWith (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {n : ℕ}
    (hn : topologicalKrullDim X = n) (B : QDivisor X) :
    ∃ K : Divisor X, MMP.Mori.IsPairWith sX n K B := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  exact ⟨K, hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩

/-- Log discrepancies exist on a smooth variety, at the index `n = dim X`. -/
private theorem exists_isLogDiscrepancy [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (F : DivisorOver k sX) (hF : IsProper F.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) F a := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hP⟩ := exists_isPairWith hX hsm hn B
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP.isPair hP.2.1 F
  exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hF⟩

/-- Adding a `ℚ`-divisor `D` with a Cartier multiple `D₀ = mD` lowers a log discrepancy by
`1/m` times the coefficient of the pull-back of `D₀`. -/
private theorem isLogDiscrepancy_add_of_zsmul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {D : QDivisor X} {m : ℕ}
    (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (D₀' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ D₀.supp), D₀.IsPullback F.f hCs D₀' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + QDivisor.toRDivisor D) F
        (a - (D₀'.coeff F.E : ℝ) / m) := by
  intro D₀' hCs hpb
  have h1 := isLogDiscrepancy_add_smul h hD₀c (1 / (m : ℝ)) D₀' hCs hpb
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : B + (1 / (m : ℝ)) • Divisor.toRDivisor D₀ = B + QDivisor.toRDivisor D := by
    congr 1
    refine Finsupp.ext fun Γ => ?_
    have h2 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    have h3 : ((D₀.coeff Γ : ℤ) : ℝ) = m * ((D.coeff Γ : ℚ) : ℝ) := by exact_mod_cast h2
    change DivisorWithCoeffs.coeff ((1 / (m : ℝ)) • Divisor.toRDivisor D₀) Γ =
      DivisorWithCoeffs.coeff (QDivisor.toRDivisor D) Γ
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, QDivisor.coeff_toRDivisor,
      smul_eq_mul, h3]
    field_simp
  rw [e] at h1
  convert h1 using 1
  ring

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{0}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  show IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    rw [if_pos hPJ]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    rw [if_neg hPJ]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every closed set containing no stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : IsClosed T) (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hPW⟩ := exists_isPairWith hX hsm hn (Divisor.toQDivisor Δ)
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hPW.2.1 F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists, not_and]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  haveI : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxT)

/-- Adding `∑_{P ∈ s} c_P P` to the boundary on a smooth variety lowers a log discrepancy by
`∑_{P ∈ s} c_P e_P`, where `e_P` is the coefficient of the pull-back of `P` along the divisor. -/
private theorem isLogDiscrepancy_add_sum (hsm : IsSmoothScheme sX) {n : ℕ} {B : RDivisor X}
    {F : DivisorOver k sX} {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (c : MMP.Mori.PrimeDivisor X → ℝ)
    (e : MMP.Mori.PrimeDivisor X → ℤ)
    (he : haveI := F.isLocallyNoetherian
      haveI := F.isNormal
      ∀ P ∈ s, ∀ (P' : Divisor F.Y) (hB : ∀ Z : irreducibleComponents F.Y,
          F.f (componentGenericPoint F.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor X)),
        Divisor.IsPullback F.f (Finsupp.single P 1 : Divisor X) hB P' → P'.coeff F.E = e P) :
    MMP.Intersection.IsLogDiscrepancy sX n
      (B + ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X)) F
      (a - ∑ P ∈ s, c P * e P) := by
  classical
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  induction s using Finset.induction_on with
  | empty => simpa using h
  | insert P s hP ih =>
    have hC : Divisor.IsCartier (Finsupp.single P 1 : Divisor X) :=
      MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
      (Finsupp.single P (1 : ℤ) : Divisor X)
    obtain ⟨P', hP'⟩ := hC.exists_isPullback hB
    have h' := isLogDiscrepancy_add_smul (ih fun Q hQ => he Q (Finset.mem_insert_of_mem hQ)) hC
      (c P) P' hB hP'
    rw [he P (Finset.mem_insert_self _ _) P' hB hP'] at h'
    have e1 : B + ∑ Q ∈ insert P s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) =
        B + ∑ Q ∈ s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) +
          c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
      rw [Finset.sum_insert hP]; abel
    have e2 : a - ∑ Q ∈ insert P s, c Q * e Q = a - ∑ Q ∈ s, c Q * e Q - c P * e P := by
      rw [Finset.sum_insert hP]; ring
    rw [e1, e2]
    exact h'

/-- **Zero places see no `D`.** If `a(F, X, Δ) = 0` for the reduced snc `Δ` and `D` contains no
stratum of `Δ`, then `a(F, X, Δ + D) = 0`. -/
private theorem eq_zero_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hns : ContainsNoStratum Δ D.supp) {n : ℕ}
    {F : DivisorOver k sX} {a : ℝ}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0)
    (ha : MMP.Intersection.IsLogDiscrepancy sX n
      (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a) : a = 0 := by
  have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ (DivisorWithCoeffs.supp D).isClosed
    hns h0
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
  obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hz := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hx) D₀' hB hD₀'
  have h1 := isLogDiscrepancy_add_of_zsmul h0 hm hD₀ hD₀c D₀' hB hD₀'
  rw [hz] at h1
  have h2 : (0 : ℝ) - ((0 : ℤ) : ℝ) / m = 0 := by simp
  rw [h2] at h1
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1

end Toolkit

/-! ### The arithmetic of the comparison on a log resolution -/

/-- If `A₀ = t + ∑ a₀ᵢ eᵢ` and `A = t + ∑ αᵢ eᵢ` with `t, eᵢ ≥ 0`, `a₀ᵢ ∈ ℕ`, `αᵢ = 0` whenever
`a₀ᵢ = 0`, and `Gᵢ = ⌈αᵢ⌉ - 1 + [a₀ᵢ = 0]`, then `∑ Gᵢ eᵢ ≤ ⌈A⌉ - 1 + [A₀ = 0]`. -/
private theorem sum_mul_le_ceil {ι : Type*} (s : Finset ι) (a₀ : ι → ℕ) (α : ι → ℝ)
    (e G : ι → ℤ) (t : ℕ) {A₀ A : ℝ} (he : ∀ i ∈ s, 0 ≤ e i)
    (hz : ∀ i ∈ s, a₀ i = 0 → α i = 0)
    (hG : ∀ i ∈ s, G i = ⌈α i⌉ - 1 + if ((a₀ i : ℕ) : ℝ) = 0 then 1 else 0)
    (hA₀ : A₀ = t + ∑ i ∈ s, (a₀ i : ℝ) * e i) (hA : A = t + ∑ i ∈ s, α i * e i) :
    ∑ i ∈ s, G i * e i ≤ ⌈A⌉ - 1 + if A₀ = 0 then 1 else 0 := by
  have hGz : ∀ i ∈ s, a₀ i = 0 → G i = 0 := by
    intro i hi h0
    rw [hG i hi, hz i hi h0]
    simp [h0]
  have hGpos : ∀ i ∈ s, a₀ i ≠ 0 → (G i : ℝ) < α i := by
    intro i hi h0
    rw [hG i hi, if_neg (by exact_mod_cast h0)]
    push_cast
    linarith [Int.ceil_lt_add_one (α i)]
  have hterm : ∀ i ∈ s, 0 ≤ (α i - G i) * e i := by
    intro i hi
    by_cases h0 : a₀ i = 0
    · rw [hz i hi h0, hGz i hi h0]; simp
    · exact mul_nonneg (by linarith [hGpos i hi h0]) (by exact_mod_cast he i hi)
  have hdiff : A - ∑ i ∈ s, (G i : ℝ) * e i = t + ∑ i ∈ s, (α i - G i) * e i := by
    rw [hA]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have ht : (0 : ℝ) ≤ t := Nat.cast_nonneg t
  by_cases hA0 : A₀ = 0
  · rw [if_pos hA0]
    have hnn : ∀ i ∈ s, 0 ≤ (a₀ i : ℝ) * e i := fun i hi =>
      mul_nonneg (Nat.cast_nonneg _) (by exact_mod_cast he i hi)
    have hs := Finset.sum_nonneg hnn
    have hsum0 : ∑ i ∈ s, (a₀ i : ℝ) * e i = 0 := by linarith
    have ht0 : (t : ℝ) = 0 := by linarith
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hsum0
    have hGe : ∀ i ∈ s, (G i : ℝ) * e i = 0 ∧ α i * e i = 0 := by
      intro i hi
      by_cases h0 : a₀ i = 0
      · rw [hGz i hi h0, hz i hi h0]; simp
      · have he0 : (e i : ℝ) = 0 := by
          rcases mul_eq_zero.mp (hzero i hi) with h | h
          · exact absurd (by exact_mod_cast h) h0
          · exact h
        rw [he0]; simp
    have hS : ∑ i ∈ s, (G i : ℝ) * e i = 0 := Finset.sum_eq_zero fun i hi => (hGe i hi).1
    have hA' : A = 0 := by
      rw [hA, ht0, Finset.sum_eq_zero fun i hi => (hGe i hi).2]; simp
    have hS' : ∑ i ∈ s, G i * e i = 0 := by exact_mod_cast hS
    rw [hS', hA']
    simp
  · rw [if_neg hA0]
    have hlt : ((∑ i ∈ s, G i * e i : ℤ) : ℝ) < A := by
      push_cast
      by_contra hle
      have hle := not_lt.mp hle
      have hsnn := Finset.sum_nonneg hterm
      have ht0 : (t : ℝ) = 0 := by linarith
      have hs0 : ∑ i ∈ s, (α i - G i) * e i = 0 := by linarith
      have hz2 := (Finset.sum_eq_zero_iff_of_nonneg hterm).mp hs0
      apply hA0
      rw [hA₀, ht0, zero_add]
      refine Finset.sum_eq_zero fun i hi => ?_
      by_cases h0 : a₀ i = 0
      · simp [h0]
      · rcases mul_eq_zero.mp (hz2 i hi) with h | h
        · exact absurd h (by linarith [hGpos i hi h0])
        · rw [h]; simp
    have : (∑ i ∈ s, G i * e i : ℤ) < ⌈A⌉ := by
      have := hlt.trans_le (Int.le_ceil A)
      exact_mod_cast this
    omega

/-! ### Divisors over `X` realized over a proper birational model -/

section Model

variable {k : Type} [Field k]

/-- **The centre of a divisorial valuation on a proper model.** Let `π : W ⟶ X` be a proper
dominant morphism of integral schemes and `D` a divisor over `X`. A valuation `ξ` of `k(W)`
restricting to `ord_D` on `k(X)` dominates the local ring of some point of `W`. -/
private theorem exists_dominated_point {X W : Scheme.{0}} [IsIntegral X]
    [IsIntegral W] {sX : X ⟶ Spec (.of k)} (π : W ⟶ X) [IsDominant π] (hπ : IsProper π)
    (D : DivisorOver k sX) (ξ : Valuation W.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ.comap (functionFieldMap π) = D.valuation) :
    ∃ x : W, (∀ a : W.presheaf.stalk x, ξ (algebraMap _ W.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk x),
        ξ (algebraMap _ W.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  have hw : ∀ b : X.presheaf.stalk y,
      ξ (functionFieldMap π (algebraMap _ X.functionField b)) =
        D.valuation (algebraMap _ X.functionField b) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ X.functionField b)) h
    simpa only [Valuation.comap_apply] using this
  let R := ξ.valuationSubring
  let φ : X.presheaf.stalk y →+* R :=
    ((functionFieldMap π).comp (algebraMap (X.presheaf.stalk y) X.functionField)).codRestrict R
      fun b => (ξ.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint X ⤳ y := (genericPoint_spec X).specializes trivial
  have hex : ValuativeCriterion.Existence π := by
    have h : @IsProper _ _ π := hπ
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq π :=
    { R := R
      K := W.functionField
      i₁ := W.fromSpecStalk (genericPoint W)
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ X.fromSpecStalk y
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk π,
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R W.functionField)) ≫ l =
      W.fromSpecStalk (genericPoint W) := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint W ⤳ x := (genericPoint_spec W).specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R W.functionField) =
      W.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (W.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : W.presheaf.stalk x,
      algebraMap _ W.functionField a = ((f.hom a : R) : W.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]; exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

/-- **Divisors over `X` are realized over a proper birational model.** For a proper birational
morphism `π : W ⟶ X` of normal varieties and a divisor `D` over `X`, some divisor `D'` over `W`,
proper over `W`, induces the valuation of `D` on `k(X) ≅ k(W)`, and its centre on `W` maps to
the centre of `D` on `X`. -/
private theorem exists_divisorOver_model {X W : Scheme.{0}} [IsIntegral X] [IsIntegral W]
    {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX) (π : W ⟶ X) (hπ : IsProper π)
    (hbir : IsBirationalMorphism π) (hW : IsNormalVariety k (π ≫ sX)) (D : DivisorOver k sX) :
    haveI : IsDominant π := hbir.isDominant
    ∃ D' : DivisorOver k (π ≫ sX), IsProper D'.f ∧
      D.valuation = D'.valuation.comap (functionFieldMap π) ∧
      π (D'.f D'.E.genericPoint) = D.f D.E.genericPoint := by
  haveI : IsDominant π := hbir.isDominant
  have hbij := hbir.functionFieldMap_bijective
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (π ≫ sX)
  let eπ := functionFieldAlgEquiv sX π hbij
  let ξ := D.valuation.comap (eπ.symm : W.functionField →+* X.functionField)
  have hξ : ξ.comap (functionFieldMap π) = D.valuation := by
    ext t
    change D.valuation (eπ.symm (eπ t)) = D.valuation t
    rw [eπ.symm_apply_apply]
  obtain ⟨x, h1, h2⟩ := exists_dominated_point π hπ D ξ hξ
  haveI : AlgebraicGeometry.IsVariety k (π ≫ sX) := hW.1
  have hdiv : MMP.Flips.IsDivisorOfFunctionField k (π ≫ sX) ξ := by
    haveI := D.isIntegral
    haveI := D.isNormal
    haveI := D.isLocallyNoetherian
    haveI := D.isDominant
    refine ⟨D.Y, D.f ≫ sX, D.isNormalVariety, D.E, ?_⟩
    letI := functionFieldAlgebra (D.f ≫ sX)
    let eD := functionFieldAlgEquiv sX D.f D.isBirationalMorphism.functionFieldMap_bijective
    refine ⟨eπ.symm.trans eD, ?_⟩
    ext t
    rfl
  obtain ⟨D', -, hv, hDx⟩ :=
    MMP.Flips.exists_properDivisorOver_isProjective_of_dominates (π ≫ sX) hdiv x h1 h2
  have hval : D.valuation = D'.toDivisorOver.valuation.comap (functionFieldMap π) := by
    rw [← hξ, ← hv]
  refine ⟨D'.toDivisorOver, D'.isProper, hval, ?_⟩
  -- the centres agree: compare `D` with `D'` regarded as a divisor over `X`
  have hcomp := MMP.Mori.valuation_compDivisorOver π hW hbir D'.toDivisorOver
  have hcen := MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX
    (hcomp.trans hval.symm)
  have e1 := (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).center_eq_closure_genericPoint
  have e2 := D.center_eq_closure_genericPoint
  rw [← hcen, e1] at e2
  have hins : Inseparable ((MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).f
      (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).E.genericPoint)
      (D.f D.E.genericPoint) := inseparable_iff_closure_eq.mpr e2
  exact hins.eq

end Model

/-! ### The adjoint ideal by orders along all divisors over `X` -/

section Main

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} c_P P = B` when `B` has coefficient `c_P` along `P ∈ s` and vanishes off `s`. -/
private theorem sum_smul_single_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  refine Finsupp.ext fun Q => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul]
  have h1 : ∀ P, (Divisor.toRDivisor (Finsupp.single P (1 : ℤ) : Divisor X)) Q =
      if P = Q then 1 else 0 := by
    intro P
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply]
    split_ifs <;> simp
  simp only [h1, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.sum_ite_eq]
  rw [← DivisorWithCoeffs.coeff_apply B]
  by_cases hQ : Q ∈ s
  · rw [if_pos hQ, hin Q hQ]
  · rw [if_neg hQ, hout Q hQ]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} P + ∑_{P ∈ s} c_P P = B` when `B` has coefficient `1 + c_P` along `P ∈ s` and
vanishes off `s`. -/
private theorem toRDivisor_add_sum_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = 1 + c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) +
      ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  have hT : Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) =
      ∑ P ∈ s, (1 : ℝ) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
    refine (sum_smul_single_eq s (fun _ => 1) _ (fun Q hQ => ?_) (fun Q hQ => ?_)).symm
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_pos hQ]; simp
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_neg hQ]; simp
  rw [hT, ← Finset.sum_add_distrib]
  simp_rw [← add_smul]
  exact sum_smul_single_eq s (fun P => 1 + c P) B hin hout

/-- The sections over `U` of `𝒥_{Δ,D}` described valuatively: the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` whose
centre lies in `U`. -/
private def adjointSet (Δ : Divisor X) (D : QDivisor X) (U : X.Opens) : Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (F : DivisorOver k sX) (a₀ a : ℝ),
    F.f F.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F a₀ →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a →
    F.valuation g ≤ WithZero.exp (⌈a⌉ - 1 + if a₀ = 0 then 1 else 0)}

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An snc closed subset of a smooth scheme is the union of the components of an snc divisor. -/
private theorem exists_finset_of_isSNCSubset [LocallyOfFinitePresentation sX]
    (hsm : IsSmoothScheme sX) {S : Closeds X} (h : IsSNCSubset sX S) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor X), (⋃ E ∈ s, E.support) = (S : Set X) ∧
      DivisorWithCoeffs.IsSNC sX (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
  rcases h with h | h
  · refine ⟨∅, by simp [h], ?_⟩
    simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme (R := ℤ) sX hsm
  · exact h

/-- A prime divisor of a proper birational model which is not exceptional and whose centre lies
off `Supp B` has log discrepancy `1` with respect to `B`. -/
private theorem isLogDiscrepancy_one_of_notMem [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    (B : QDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (hexc : P.genericPoint ∉ (exceptionalSet μ : Set Y))
    (hB : μ P.genericPoint ∉ (DivisorWithCoeffs.supp (QDivisor.toRDivisor B) : Set X)) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hPW⟩ := exists_isPairWith hX hsm hn B
  set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ¬ FP.IsExceptional := fun hexc' =>
    hexc (MMP.Positivity.support_subset_exceptionalSet P hexc' hPmem)
  obtain ⟨Q, hQc, hQd⟩ := MMP.Mori.DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPW FP hne
  have hηQ : μ P.genericPoint = Q.genericPoint := by
    have e1 := FP.center_eq_closure_genericPoint
    rw [hQc, AlgebraicGeometry.PrimeDivisor.support_eq_closure Q] at e1
    exact (inseparable_iff_closure_eq.mpr e1.symm).eq
  have hQmem : Q.genericPoint ∈ Q.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hQ0 : B.coeff Q = 0 := by
    by_contra hne'
    apply hB
    rw [hηQ]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero]) hQmem
  rw [hQ0, neg_zero] at hQd
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hQd hμp
  convert hl using 1
  simp

/-- **Log discrepancy one off the snc divisor of a log resolution.** Let `μ : Y → X` be a proper
birational model and `s` the components of `Exc(μ) ∪ μ⁻¹ Supp(Δ + D)`, for `Δ` reduced and `D`
effective. A prime divisor `P ∉ s` of `Y` has log discrepancy `1` for `(X, Δ)` and `(X, Δ + D)`. -/
private theorem isLogDiscrepancy_one_of_notMem_finset [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : (⋃ E ∈ s, E.support) = ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) : Set Y))
    {P : MMP.Mori.PrimeDivisor Y} (hPs : P ∉ s) :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ 1 ∧
      MMP.Intersection.IsLogDiscrepancy sX n
        (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
    intro hz
    obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
    exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
  rw [hs, Closeds.coe_sup, Set.mem_union, not_or] at hnot
  obtain ⟨hexc, hsupp⟩ := hnot
  have hsuppΔ : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
    intro hmem
    apply hsupp
    obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have : (0 : ℝ) ≤ ((D.coeff Γ' : ℚ) : ℝ) := by exact_mod_cast hD0 Γ'
    rcases hΔ Γ' with h | h
    · rw [h] at hΓ'; simp at hΓ'
    · rw [h]; push_cast; linarith
  have h0 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsuppΔ
  have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsupp
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
  exact ⟨h0, h1⟩

/-- **The adjoint ideal is computed by orders along all divisors over `X`.** The sections of
`μ_*𝒪_Y(E - ⌊μ^*D⌋)` are the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` centred
in the open set. -/
private theorem eq_adjointSet [IsAlgClosed k] [CharZero k] {Δ : Divisor X} {D : QDivisor X}
    {Y : Scheme.{0}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J) : J = adjointSet sX Δ D := by
  classical
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, _, _, _, _, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  set G := E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hGdef
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    obtain ⟨D₀', hD₀'eq, hD₀'pb⟩ := hF m hm D₀ hD₀ hD₀c
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'pb
    have hFP : ((D₀'.coeff P : ℤ) : ℝ) / m = ((F.coeff P : ℚ) : ℝ) := by
      have h1 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        Int.cast_natCast] at h1
      have h' : ((D₀'.coeff P : ℤ) : ℝ) = m * ((F.coeff P : ℚ) : ℝ) := by exact_mod_cast h1
      rw [h']
      field_simp
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    rw [hFP] at hα
    refine ⟨a₀, (a₀ : ℝ) - F.coeff P, ha₀r, hα, ?_, ?_, ?_⟩
    · have hΓP : Γ.coeff P = if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0 := by
        rcases hΓ.1 P with h0 | h1
        · rw [h0]
          split_ifs with ha0
          · exfalso
            have : Γ.coeff P = 1 := (hΓ.2 P).2 ⟨n, by rw [ha0] at ha₀r; exact ha₀r⟩
            omega
          · rfl
        · rw [h1]
          split_ifs with ha0
          · rfl
          · exfalso
            obtain ⟨n'', h''⟩ := (hΓ.2 P).1 h1
            exact ha0 (MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h'')
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊((F.coeff P : ℚ) : ℝ)⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - F.coeff P⌉ := by
        have e : ((F.coeff P : ℚ) : ℝ) = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        QDivisor.coeff_toRDivisor, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hlog.isProper hs hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  funext U
  ext g
  constructor
  · /- `J ⊆ adjointSet`: the comparison along a model of `F` on `Y`. -/
    rintro ⟨hg0, hgP⟩
    refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a₀ a hx ha₀ ha => ?_⟩
    rcases eq_or_ne g 0 with rfl | hgne
    · simp
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha₀
    obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hlog.isProper hμ hY F₀
    set y := F'.f F'.E.genericPoint with hy
    have hyU : y ∈ μ ⁻¹ᵁ U := by
      show μ y ∈ U
      rw [hcen]; exact hx
    have hnY : topologicalKrullDim Y = n :=
      (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
        hn
    obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
    obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
    have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
      ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
    have hP1 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ + D) :=
      ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
    obtain ⟨B₀, hB₀⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
    obtain ⟨B₁, hB₁⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP1 hK μ hY hμ).1.exists
    have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
      (Or.inl hB₀)).2 F' F₀ hval
    have hcr1 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP1 μ hY hμ hK hKY
      (Or.inl hB₁)).2 F' F₀ hval
    obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
    obtain ⟨c₁, hc₁⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP1 hK F₀
    have ha₀c : a₀ = 1 + c₀ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
      hc₀ (by rwa [QDivisor.toRDivisor_toQDivisor])
    have hac : a = 1 + c₁ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
      hc₁ (by rwa [map_add, QDivisor.toRDivisor_toQDivisor])
    have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
      ((hcr0 c₀).2 hc₀) hF'p
    have hY1 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
      ((hcr1 c₁).2 hc₁) hF'p
    -- the reduced snc divisor `T = ∑_{P ∈ s} P` on `Y` and `t = a(F', Y, T) ∈ ℕ`
    have hTred : MMP.Intersection.IsReducedEffective (MMP.Intersection.reducedDivisorOf s) :=
      fun P => by rw [MMP.Intersection.coeff_reducedDivisorOf]; split_ifs <;> simp
    obtain ⟨tr, htr⟩ := exists_isLogDiscrepancy hY hsmY hnY
      (Divisor.toQDivisor (MMP.Intersection.reducedDivisorOf s)) F' hF'p
    rw [QDivisor.toRDivisor_toQDivisor] at htr
    obtain ⟨t, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC (μ ≫ sX) hY.1
      hsmY hTred hsnc htr
    choose a₀P αP ha₀P hαP hGP hzP houtP using hcoef n hn
    have := F'.isLocallyNoetherian
    have := F'.isNormal
    have := F'.isIntegral
    have := F'.isBirationalMorphism.isDominant
    have : CompactSpace F'.Y :=
      (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
    have hcart : ∀ P : MMP.Mori.PrimeDivisor Y,
        Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor Y) := fun P =>
      MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    choose P' hP' using fun P : MMP.Mori.PrimeDivisor Y => (hcart P).exists_isPullback
      (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
        (Finsupp.single P (1 : ℤ) : Divisor Y))
    set e : MMP.Mori.PrimeDivisor Y → ℤ := fun P => (P' P).coeff F'.E with hedef
    have he : ∀ P ∈ s, ∀ (Q' : Divisor F'.Y) (hB : ∀ Z : irreducibleComponents F'.Y,
          F'.f (componentGenericPoint F'.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor Y)),
        Divisor.IsPullback F'.f (Finsupp.single P 1 : Divisor Y) hB Q' → Q'.coeff F'.E = e P := by
      intro P _ Q' hB hQ'
      rw [hQ'.eq (hcart P) (hP' P)]
    have he0 : ∀ P ∈ s, 0 ≤ e P := fun P _ =>
      coeff_isPullback_nonneg (F := F') (hcart P) (fun Γ _ => by
        rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> simp) _ _ (hP' P)
    -- the crepant boundaries in terms of the coefficients
    have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
      intro Q
      have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
        hlog.isProper
      rw [QDivisor.toRDivisor_toQDivisor] at hl
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
      push_cast at this
      linarith
    have hB₁Q : ∀ Q, ((B₁.coeff Q : ℚ) : ℝ) = 1 - αP Q := by
      intro Q
      have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₁ Q)
        hlog.isProper
      rw [map_add, QDivisor.toRDivisor_toQDivisor] at hl
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hαP Q) hl
      push_cast at this
      linarith
    have hb0 := toRDivisor_add_sum_eq s (fun P => -(a₀P P : ℝ)) (QDivisor.toRDivisor B₀)
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp)
    have hb1 := toRDivisor_add_sum_eq s (fun P => -αP P) (QDivisor.toRDivisor B₁)
      (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q]; ring)
      (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q, (houtP Q hQ).2]; simp)
    have hsum0 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(a₀P P : ℝ)) e he
    have hsum1 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -αP P) e he
    rw [hb0] at hsum0
    rw [hb1] at hsum1
    have hA₀ : a₀ = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0 hsum0
      rw [ha₀c, this]
      simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
    have hA : a = t + ∑ P ∈ s, αP P * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY1 hsum1
      rw [hac, this]
      simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
    -- `v_F(g) ≤ exp (∑ G_P e_P)`
    have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
    obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
    have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
      (fun Γ hΓ => by
        rw [DivisorWithCoeffs.coeff_neg, neg_neg]
        exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
    have hl1 := isLogDiscrepancy_add_smul htr hGcart (1 : ℝ) G' hBG hG'
    have hl2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(G.coeff P : ℝ)) e he
    have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
      intro Q hQ
      rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
      simp
    have hbG : (1 : ℝ) • Divisor.toRDivisor (-G) =
        ∑ P ∈ s, (-(G.coeff P : ℝ)) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor Y) := by
      refine (sum_smul_single_eq s _ _ (fun Q _ => ?_) (fun Q hQ => ?_)).symm
      · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg]
        simp
      · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg,
          hG0 Q hQ]
        simp
    rw [hbG] at hl1
    have hGe : (G'.coeff F'.E : ℝ) = -∑ P ∈ s, (G.coeff P : ℝ) * e P := by
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hl1 hl2
      simp only [one_mul, neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add] at this
      linarith
    have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by exact_mod_cast hGe
    have hval' : F₀.valuation g = F'.valuation (functionFieldMap μ g) := by
      rw [hval]; rfl
    rw [hval']
    refine hR.trans ?_
    rw [hGe', neg_neg, WithZero.exp_le_exp]
    exact sum_mul_le_ceil s a₀P αP e (fun P => G.coeff P) t he0 (fun P _ => hzP P)
      (fun P _ => hGP P) hA₀ hA
  · /- `adjointSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ?_, fun P hP => ?_⟩
    · by_contra hne
      obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
      obtain ⟨_, hx', x', rfl⟩ := μ.denseRange.inter_open_nonempty _ U.isOpen ⟨u, hu⟩
      have hx'' : x' ∈ μ ⁻¹ᵁ U := hx'
      rw [hU] at hx''
      exact hx''
    · have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
      obtain ⟨n, a, hla, -⟩ := hE P
      have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
      obtain ⟨a₀, α, ha₀, hα, hGP, -, -⟩ := hcoef n hn P
      have := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ α hxU ha₀ hα
      rw [hGP]
      exact this

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A variety has finite dimension. -/
private theorem exists_topologicalKrullDim_eq [IsIntegral X] (hX : MMP.Mori.IsVariety k sX) :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  refine ⟨(Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction sX
    (genericPoint X)).toNat, ?_⟩
  rw [← Stacks.Chow.topologicalKrullDim_closure_singleton_eq k sX (genericPoint X)]
  have h : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
  exact (IsHomeomorph.topologicalKrullDim_eq _
    ((Homeomorph.setCongr h).trans (Homeomorph.Set.univ X)).isHomeomorph).symm

/-- The log discrepancy of a prime divisor `Q` of the smooth `X` is `1 - coeff_Q B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (Q : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hX Q) (1 - B.coeff Q) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hP⟩ := exists_isPairWith hX hsm hn B
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP.isPair hP.2.1
    (DivisorOver.ofPrimeDivisor k hX Q)
  have hcQ := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc
  have h := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 X) from inferInstance)
  rw [hcQ] at h
  convert h using 1
  push_cast
  ring

end Main

/-! ### Multiplicities on open subschemes and near a point -/

section Multiplicity

/-! ### Restriction to open subschemes -/

open IsLocalRing in
private theorem map_le_pow_maximalIdeal_iff {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (e : R →+* S) (he : Function.Bijective e) (I : Ideal R)
    (k : ℕ) : I.map e ≤ maximalIdeal S ^ k ↔ I ≤ maximalIdeal R ^ k := by
  let E := RingEquiv.ofBijective e he
  have hm : (maximalIdeal R).map e = maximalIdeal S := by
    have : ((maximalIdeal R).map e).IsMaximal := Ideal.map_isMaximal_of_equiv E
    exact IsLocalRing.eq_maximalIdeal this
  rw [← hm, ← Ideal.map_pow]
  constructor
  · intro h
    have := Ideal.comap_mono (f := e) h
    rwa [Ideal.comap_map_of_bijective e he, Ideal.comap_map_of_bijective e he] at this
  · exact Ideal.map_mono

/-- The multiplicity of a prime divisor of an open subscheme at a point is that of its closure. -/
private theorem multiplicityAt_primeDivisorMap {V X : Scheme.{0}} (j : V ⟶ X)
    [IsOpenImmersion j] (E' : MMP.Mori.PrimeDivisor V) (v : V) :
    E'.multiplicityAt v =
      MMP.Mori.PrimeDivisor.multiplicityAt (OpenWeilRestriction.primeDivisorMap j E') (j v) := by
  unfold PrimeDivisor.multiplicityAt
  simp only [Scheme.IdealSheafData.stalkIdeal_eq_stalk]
  rw [← MMP.Threefold.Mori.OpenRestriction.idealSheaf_comap_primeDivisorMap j E',
    MMP.Threefold.Mori.OpenRestriction.stalk_comap_eq_map]
  have hiso : IsIso (j.stalkMap v) := (IsOpenImmersion.iff_isIso_stalkMap.mp ‹_›).2 v
  have hbij := ConcreteCategory.bijective_of_isIso (j.stalkMap v)
  refine iSup_congr fun k => iSup_congr_Prop ?_ fun _ => rfl
  exact map_le_pow_maximalIdeal_iff (j.stalkMap v).hom hbij _ k

/-- The multiplicity of the restriction of a `ℚ`-divisor to an open subscheme. -/
private theorem multiplicityAt_restrictOpen {X : Scheme.{0}} (U : X.Opens) (Δ : QDivisor X)
    (y : U) : (Δ.restrictOpen U).multiplicityAt y = Δ.multiplicityAt (U.ι y) := by
  classical
  unfold DivisorWithCoeffs.multiplicityAt
  rw [Finsupp.sum, Finsupp.sum]
  refine Finset.sum_bij_ne_zero (fun W _ _ => OpenWeilRestriction.primeDivisorMap U.ι W)
    (fun W hW _ => ?_) (fun W₁ _ _ W₂ _ _ h => OpenWeilRestriction.primeDivisorMap_injective _ h)
    (fun P hP hne => ?_) (fun W _ _ => ?_)
  · simpa [DivisorWithCoeffs.restrictOpen, Finsupp.mem_support_iff] using hW
  · have hmem : U.ι y ∈ P.support := by
      by_contra h
      rw [PrimeDivisor.multiplicityAt_eq_zero_of_notMem P h] at hne
      simp at hne
    obtain ⟨W, rfl⟩ :=
      MMP.Threefold.Mori.OpenRestriction.exists_primeDivisorMap_eq_of_mem_support U.ι P y hmem
    refine ⟨W, ?_, ?_, rfl⟩
    · simpa [DivisorWithCoeffs.restrictOpen, Finsupp.mem_support_iff] using hP
    · rwa [multiplicityAt_primeDivisorMap U.ι W y, DivisorWithCoeffs.restrictOpen,
        Finsupp.comapDomain_apply]
  · rw [multiplicityAt_primeDivisorMap U.ι W y, DivisorWithCoeffs.restrictOpen,
      Finsupp.comapDomain_apply]

/-- The multiplicity of a prime divisor at a point is the order of its ideal there. -/
private theorem multiplicityAt_eq_multAt {X : Scheme.{0}} (P : MMP.Mori.PrimeDivisor X) (x : X) :
    P.multiplicityAt x = MMP.Resolution.multAt P.idealSheaf x := by
  unfold PrimeDivisor.multiplicityAt MMP.Resolution.multAt MMP.Resolution.idealOrder
  simp only [Scheme.IdealSheafData.stalkIdeal_eq_stalk]

/-- **Multiplicities near a point.** On a scheme smooth over a field of characteristic zero, if
an effective `ℚ`-divisor `Δ` has `mult_x Δ < 1`, then there are an open neighbourhood `U` of `x`
and `μ < 1` with `mult_p Δ ≤ μ` for every `p ∈ U`: the locus where a prime divisor has
multiplicity `≥ m` is closed, and the multiplicities `< 1` take finitely many values. -/
private theorem exists_opens_forall_multiplicityAt_le {k : Type} [Field k] [CharZero k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsLocallyNoetherian X] [IsNormal X] [Smooth sX]
    (hXs : IsSmoothScheme sX) {Δ : QDivisor X} (hΔ : 0 ≤ Δ) {x : X}
    (hx : Δ.multiplicityAt x < 1) :
    ∃ U : X.Opens, x ∈ U ∧ ∃ μ : ℚ, μ < 1 ∧ ∀ p ∈ U, Δ.multiplicityAt p ≤ μ := by
  classical
  set S := Δ.support
  have hpos : ∀ P : S, 0 < Δ P := fun P =>
    lt_of_le_of_ne (hΔ P.1) (Ne.symm (Finsupp.mem_support_iff.1 P.2))
  set N : ℕ := S.sup fun P => ⌈(Δ P)⁻¹⌉₊
  have hN : ∀ P : S, 1 ≤ (N : ℚ) * Δ P := fun P => by
    have h1 : (Δ P.1)⁻¹ ≤ (N : ℚ) :=
      (Nat.le_ceil _).trans (by exact_mod_cast Finset.le_sup (f := fun P => ⌈(Δ P)⁻¹⌉₊) P.2)
    have := hpos P
    calc (1 : ℚ) = (Δ P.1)⁻¹ * Δ P := by field_simp
      _ ≤ N * Δ P := by gcongr
  -- the multiplicity as a sum over the components
  let t : S → X → ℕ := fun P p => (P.1.multiplicityAt p).toNat
  have hmult : ∀ p, Δ.multiplicityAt p = ∑ P : S, (t P p : ℚ) * Δ P := fun p => by
    unfold DivisorWithCoeffs.multiplicityAt
    rw [Finsupp.sum, ← Finset.sum_coe_sort]
    simp only [t, nsmul_eq_mul]
    rfl
  let T := Fintype.piFinset fun _ : S => Finset.range (N + 1)
  let val : (S → ℕ) → ℚ := fun m => ∑ P : S, (m P : ℚ) * Δ P
  -- the closed locus where the multiplicity is `≥ 1`
  let B : Set X := ⋃ m ∈ T.filter (fun m => 1 ≤ val m),
    ⋂ P : S, {p | ((m P : ℕ) : ℕ∞) ≤ P.1.multiplicityAt p}
  have hB : IsClosed B := by
    refine Set.Finite.isClosed_biUnion (Finset.finite_toSet _) fun m _ => ?_
    refine isClosed_iInter fun P => ?_
    simp_rw [multiplicityAt_eq_multAt]
    exact MMP.Resolution.isClosed_setOf_le_multAt sX P.1.idealSheaf _
  have hfin : ∀ (P : S) p, P.1.multiplicityAt p ≠ ⊤ := fun P p =>
    MMP.Threefold.Resolution.multiplicityAt_ne_top P.1
      (MMP.Threefold.Resolution.isEffectiveCartierDivisor_idealSheaf_of_isSmoothScheme hXs P.1) p
  -- at a point off `B` the multiplicity is a value `< 1` of `val` on `T`
  have hoff : ∀ p, p ∉ B → ∃ m ∈ T, val m < 1 ∧ Δ.multiplicityAt p = val m := by
    intro p hp
    let m : S → ℕ := fun P => min (t P p) N
    have hmT : m ∈ T := Fintype.mem_piFinset.2 fun P =>
      Finset.mem_range.2 (Nat.lt_succ_of_le (min_le_right _ _))
    have hm1 : val m < 1 := by
      by_contra h1
      refine hp (Set.mem_biUnion (Finset.mem_filter.2 ⟨hmT, not_lt.1 h1⟩) ?_)
      refine Set.mem_iInter.2 fun P => ?_
      change ((min (t P p) N : ℕ) : ℕ∞) ≤ _
      exact (Nat.cast_le.2 (min_le_left _ _)).trans (ENat.coe_toNat_le_self _)
    have hle : ∀ P : S, t P p ≤ N := by
      intro P
      by_contra hlt
      have hmP : m P = N := min_eq_right (le_of_not_ge hlt)
      have hge : (m P : ℚ) * Δ P ≤ val m :=
        Finset.single_le_sum (f := fun P => (m P : ℚ) * Δ P)
          (fun P _ => mul_nonneg (Nat.cast_nonneg _) (hpos P).le) (Finset.mem_univ P)
      rw [hmP] at hge
      linarith [hN P]
    refine ⟨m, hmT, hm1, ?_⟩
    rw [hmult]
    refine Finset.sum_congr rfl fun P _ => ?_
    simp only [m, min_eq_left (hle P)]
  have hxB : x ∉ B := by
    intro hxB
    obtain ⟨m, hm, hmx⟩ := Set.mem_iUnion₂.1 hxB
    have h1 := (Finset.mem_filter.1 hm).2
    have hle : val m ≤ Δ.multiplicityAt x := by
      rw [hmult]
      refine Finset.sum_le_sum fun P _ => ?_
      have hP := Set.mem_iInter.1 hmx P
      have : m P ≤ t P x := by
        have h := hP
        change ((m P : ℕ) : ℕ∞) ≤ _ at h
        rw [← ENat.coe_toNat (hfin P x)] at h
        exact_mod_cast h
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast this) (hpos P).le
    linarith
  let V := (T.image val).filter (· < 1)
  have hV0 : (0 : ℚ) ∈ V := Finset.mem_filter.2 ⟨Finset.mem_image.2 ⟨fun _ => 0,
    Fintype.mem_piFinset.2 fun _ => Finset.mem_range.2 (Nat.succ_pos _), by simp [val]⟩,
    one_pos⟩
  refine ⟨⟨Bᶜ, hB.isOpen_compl⟩, hxB, V.max' ⟨0, hV0⟩,
    (Finset.mem_filter.1 (V.max'_mem ⟨0, hV0⟩)).2, fun p hp => ?_⟩
  obtain ⟨m, hmT, hm1, hpm⟩ := hoff p hp
  rw [hpm]
  exact V.le_max' _ (Finset.mem_filter.2 ⟨Finset.mem_image_of_mem _ hmT, hm1⟩)

end Multiplicity

/-! ### Orders along prime divisors through a point -/

section StalkOrd

variable {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]

private theorem ordHom_algebraMap_isUnit (y : Y) (hy : Order.coheight y = 1)
    {a : Y.presheaf.stalk y} (ha : IsUnit a) :
    Y.ordHom y hy (algebraMap _ Y.functionField a) = 1 := by
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk y) := krullDimLE_of_coheight_le hy.le
  exact Ring.ordFrac_of_isUnit ha

/-- A unit of the local ring at a codimension-one point has order zero. -/
private theorem ord_algebraMap_of_isUnit (y : Y) (hy : Order.coheight y = 1)
    {a : Y.presheaf.stalk y} (ha : IsUnit a) : Y.ord (algebraMap _ Y.functionField a) y = 0 := by
  rw [Scheme.ord_eq_iff hy ((ha.map _).ne_zero), ordHom_algebraMap_isUnit y hy ha]
  rfl

end StalkOrd

section StalkIdeal

variable {X : Scheme.{0}}

private theorem stalkIdeal_primeDivisor (E : MMP.Mori.PrimeDivisor X) {x : X}
    (hx : E.genericPoint ⤳ x) :
    E.idealSheaf.stalkIdeal x = MMP.Intersection.primeOfSpecializes hx := by
  have hE : E = AlgebraicGeometry.PrimeDivisor.ofCoheightOne E.genericPoint
      (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint E) :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective
      (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _).symm
  have h1 : E.idealSheaf = Stacks.Chow.integralComponentAt E.genericPoint := by
    conv_lhs => rw [hE]
    rfl
  rw [h1, Scheme.IdealSheafData.stalkIdeal_eq_stalk]
  have h2 := Stacks.Chow.idealStalk_vanishingIdeal_closure_fromSpecStalk x
    ⟨MMP.Intersection.primeOfSpecializes hx, inferInstance⟩
  rw [MMP.Intersection.fromSpecStalk_primeOfSpecializes hx] at h2
  exact h2

private theorem ord_algebraMap_eq_toNat_ord [IsIntegral X] [IsLocallyNoetherian X] (x : X)
    (hx : Order.coheight x = 1) {c : X.presheaf.stalk x} (hc : c ≠ 0) :
    X.ord (algebraMap _ X.functionField c) x = ((Ring.ord (X.presheaf.stalk x) c).toNat : ℤ) := by
  have : Ring.KrullDimLE 1 (X.presheaf.stalk x) := krullDimLE_of_coheight_le hx.le
  have hne : algebraMap _ X.functionField c ≠ 0 := by
    rwa [map_ne_zero_iff _ (IsFractionRing.injective _ _)]
  rw [Scheme.ord_eq_iff hx hne]
  change Ring.ordFrac _ _ = _
  rw [Ring.ordFrac_eq_ord _ hc]
  have hnz : c ∈ nonZeroDivisors _ := mem_nonZeroDivisors_of_ne_zero hc
  rw [Ring.ordMonoidWithZeroHom_eq_coe _ hnz (n := (Ring.ord _ c).toNat)
    (ENat.coe_toNat (Ring.ord_ne_top hnz)).symm]

private theorem algebraMap_stalkSpecializes [IsIntegral X] {x x' : X} (h : x' ⤳ x)
    (c : X.presheaf.stalk x) :
    algebraMap _ X.functionField (X.presheaf.stalkSpecializes h c) =
      algebraMap _ X.functionField c := by
  simp only [RingHom.algebraMap_toAlgebra]
  rw [← ConcreteCategory.comp_apply, TopCat.Presheaf.stalkSpecializes_comp]

private theorem genericPoint_specializes_of_mem_support (E : MMP.Mori.PrimeDivisor X) {x : X}
    (hx : x ∈ E.support) : E.genericPoint ⤳ x := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hx
  exact specializes_iff_mem_closure.mpr hx

end StalkIdeal

section PrimeCase

open MMP.Intersection

open MMP.Intersection in
private theorem coheight_fromSpecStalk_span_eq_one {X : Scheme.{0}} [IsIntegral X] {y' : X}
    [IsNoetherianRing (X.presheaf.stalk y')] {p0 : X.presheaf.stalk y'} (hp : Prime p0) :
    Order.coheight (X.fromSpecStalk y'
      ⟨Ideal.span {p0}, (Ideal.span_singleton_prime hp.ne_zero).mpr hp⟩) = 1 := by
  set q : PrimeSpectrum (X.presheaf.stalk y') :=
    ⟨Ideal.span {p0}, (Ideal.span_singleton_prime hp.ne_zero).mpr hp⟩
  have hz : X.fromSpecStalk y' q ⤳ y' := fromSpecStalk_specializes y' q
  have hpz : primeOfSpecializes hz = Ideal.span {p0} :=
    comap_maximalIdeal_stalkSpecializes_fromSpecStalk y' q
  apply le_antisymm (coheight_le_one_of_primeOfSpecializes_eq_span hz hpz)
  rw [Order.one_le_iff_pos, pos_iff_ne_zero]
  intro h0
  have hmax := Order.coheight_eq_zero.mp h0
  have hzη : X.fromSpecStalk y' q = genericPoint X :=
    (Specializes.antisymm (hmax (genericPoint_specializes _)) (genericPoint_specializes _)).eq
  have hbot : primeOfSpecializes hz = ⊥ := by
    rw [eq_bot_iff]
    intro c hc
    rw [Ideal.mem_bot]
    have hc' : X.presheaf.stalkSpecializes hz c ∈ IsLocalRing.maximalIdeal _ := hc
    have hfield : IsField (X.presheaf.stalk (X.fromSpecStalk y' q)) := by
      rw [hzη]; exact Field.toIsField X.functionField
    rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield, Ideal.mem_bot] at hc'
    exact stalkSpecializes_injective hz (hc'.trans (map_zero _).symm)
  rw [hpz, Ideal.span_singleton_eq_bot] at hbot
  exact hp.ne_zero hbot

open MMP.Intersection in
/-- `primeOfSpecializes` depends only on the generizing point, not on the specialization proof. -/
private theorem primeOfSpecializes_congr {X : Scheme.{0}} {a b y' : X} (e : a = b) (h1 : a ⤳ y')
    (h2 : b ⤳ y') : primeOfSpecializes h1 = primeOfSpecializes h2 := by
  subst e; rfl

open MMP.Intersection Classical in
/-- Along a prime divisor `E` through `y'`, a prime `p₀` of `𝒪_{X,y'}` cutting out the
codimension-one point `z` has order one if `η_E = z` and zero otherwise. -/
private theorem ord_prime_eq_ite {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] {y' : X}
    {p0 : X.presheaf.stalk y'} (hp : Prime p0) {z : X} (hz : z ⤳ y')
    (hpz : primeOfSpecializes hz = Ideal.span {p0}) (hz1 : Order.coheight z = 1)
    (E : MMP.Mori.PrimeDivisor X) (hE : y' ∈ E.support) :
    X.ord (algebraMap _ X.functionField p0) E.genericPoint =
      if E.genericPoint = z then 1 else 0 := by
  have hsp := genericPoint_specializes_of_mem_support E hE
  have hspπ : X.presheaf.stalkSpecializes hsp p0 ≠ 0 := by
    intro h0
    exact hp.ne_zero (stalkSpecializes_injective hsp (h0.trans (map_zero _).symm))
  rw [← algebraMap_stalkSpecializes hsp, ord_algebraMap_eq_toNat_ord _
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint E) hspπ]
  split_ifs with hEz
  · have : primeOfSpecializes hsp = Ideal.span {p0} := by
      rw [← hpz]
      exact primeOfSpecializes_congr hEz hsp hz
    rw [ord_stalkSpecializes_eq_one hsp this]
    rfl
  · have hnot : p0 ∉ primeOfSpecializes hsp := by
      intro hmem
      apply hEz
      have hle : primeOfSpecializes hz ≤ primeOfSpecializes hsp := by
        rw [hpz, Ideal.span_le, Set.singleton_subset_iff]
        exact hmem
      exact (MMP.ProgramBaseChange.eq_of_specializes_of_coheight_eq_one (specializes_of_primeOfSpecializes_le hz hsp hle)
        hz1 (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint E)).symm
    rw [ord_stalkSpecializes_of_notMem hsp hnot]
    rfl

private theorem ord_algebraMap_isUnit_at {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    {x x' : X} (h : x' ⤳ x) (hx' : Order.coheight x' = 1) {c : X.presheaf.stalk x}
    (hc : IsUnit c) : X.ord (algebraMap _ X.functionField c) x' = 0 := by
  rw [← algebraMap_stalkSpecializes h]
  exact ord_algebraMap_of_isUnit x' hx' (hc.map _)

end PrimeCase

/-! ### A linear parameter not dividing given initial forms -/

section KeyAlg

open IsLocalRing

/-- A linear form `ℓ` in at least two variables vanishing at a given point. -/
private theorem exists_linear_eval_eq_zero {κ : Type*} [Field κ] {c : ℕ} (hc : 2 ≤ c)
    (a : Fin c → κ) : ∃ b : Fin c → κ, b ≠ 0 ∧ ∑ j, b j * a j = 0 := by
  classical
  let i0 : Fin c := ⟨0, by omega⟩
  let i1 : Fin c := ⟨1, by omega⟩
  have h01 : i0 ≠ i1 := by simp [i0, i1, Fin.ext_iff]
  by_cases ha : a i0 = 0 ∧ a i1 = 0
  · refine ⟨Pi.single i0 1, by simp, ?_⟩
    rw [Finset.sum_eq_single i0 (fun j _ hj => by simp [Pi.single_apply, hj]) (by simp)]
    simp [ha.1]
  · refine ⟨fun j => if j = i0 then a i1 else if j = i1 then -a i0 else 0, ?_, ?_⟩
    · intro h0
      exact ha ⟨by simpa [h01.symm] using congrFun h0 i1, by simpa using congrFun h0 i0⟩
    · rw [Fintype.sum_eq_add i0 i1 h01 (fun j hj => by simp [hj.1, hj.2])]
      simp [h01.symm]
      ring

/-- In a Noetherian local ring, an element of `𝔪ⁿ ∖ 𝔪ⁿ⁺¹` has order `n`. -/
private theorem maximalIdealOrder_eq_of_mem_of_notMem {R : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] {φ : R} {n : ℕ} (h1 : φ ∈ maximalIdeal R ^ n)
    (h2 : φ ∉ maximalIdeal R ^ (n + 1)) : MMP.Flips.maximalIdealOrder R φ = n := by
  have hφ : φ ≠ 0 := by rintro rfl; exact h2 (zero_mem _)
  obtain ⟨h3, h4⟩ := MMP.Flips.maximalIdealOrder_spec hφ
  apply le_antisymm
  · by_contra hlt
    exact h2 (Ideal.pow_le_pow_right (by omega) h3)
  · by_contra hlt
    exact h4 (Ideal.pow_le_pow_right (by omega) h1)

open AssociatedGraded in
/-- **A linear parameter not dividing the initial forms.** Let `(R, 𝔪)` be a regular local ring
of dimension at least two with infinite residue field, and `g_i` finitely many nonzero elements
of orders `r_i`. Then there is `h ∈ 𝔪 ∖ 𝔪²` such that no `g_i - h b` lies in `𝔪^{r_i + 1}`; that
is, the image of `g_i` in the regular local ring `R ⧸ (h)` still has order `r_i`. -/
private theorem exists_notMem_sq_forall_sub_mul_notMem {R : Type*} [CommRing R]
    [IsRegularLocalRing R] [Infinite (R ⧸ maximalIdeal R)]
    (h2 : 2 ≤ (maximalIdeal R).spanFinrank) {ι : Type*} (s : Finset ι) (g : ι → R)
    (hg : ∀ i ∈ s, g i ≠ 0) :
    ∃ h ∈ maximalIdeal R, h ∉ maximalIdeal R ^ 2 ∧ ∀ i ∈ s, ∀ b : R,
      g i - h * b ∉ maximalIdeal R ^ (MMP.Flips.maximalIdealOrder R (g i) + 1) := by
  classical
  have := IsRegularLocalRing.isDomain R
  letI : Field (R ⧸ maximalIdeal R) := Ideal.Quotient.field (maximalIdeal R)
  obtain ⟨t, hcard, hspan⟩ :=
    (IsNoetherian.noetherian (maximalIdeal R)).exists_span_finset_card_eq_spanFinrank
  set xs := t.toList with hxsdef
  have hxs : Ideal.ofList xs = maximalIdeal R := by
    rw [← hspan]; exact congrArg Ideal.span (by ext x; simp [xs])
  have hmin : xs.length = (maximalIdeal R).spanFinrank := by simp [xs, hcard]
  have hx : ∀ i : Fin xs.length, xs[i] ∈ maximalIdeal R := fun i => by
    rw [← hxs]; exact Ideal.subset_span (List.getElem_mem _)
  set Φ := polyGradedHom (maximalIdeal R) (fun i : Fin xs.length => xs[i]) hx with hΦdef
  have hΦ := (IsRegularLocalRing.gradedRing_maximalIdeal_isPolynomialAlgebra xs hxs hmin hx).1
  have hc : 2 ≤ xs.length := hmin ▸ h2
  set r : ι → ℕ := fun i => MMP.Flips.maximalIdealOrder R (g i) with hr
  have hspec : ∀ i ∈ s, g i ∈ maximalIdeal R ^ r i ∧ g i ∉ maximalIdeal R ^ (r i + 1) :=
    fun i hi => MMP.Flips.maximalIdealOrder_spec (hg i hi)
  -- the initial forms, as polynomials
  have hF : ∀ i : s, ∃ P, Φ P = classOfPow (maximalIdeal R) (r i) ⟨g i, (hspec i i.2).1⟩ :=
    fun i => hΦ.2 _
  choose F hFΦ using hF
  have hF0 : ∀ i : s, F i ≠ 0 := by
    intro i h0
    have := hFΦ i
    rw [h0, map_zero, eq_comm, MMP.Flips.associatedGraded_classOfPow_eq_zero_iff] at this
    exact (hspec i i.2).2 this
  -- a point where no initial form vanishes
  obtain ⟨a, ha⟩ : ∃ a : Fin xs.length → R ⧸ maximalIdeal R,
      ∀ i : s, MvPolynomial.eval a (F i) ≠ 0 := by
    by_contra hne
    push Not at hne
    have hprod : ∏ i : s, F i ≠ 0 := Finset.prod_ne_zero_iff.2 fun i _ => hF0 i
    apply hprod
    refine MvPolynomial.funext fun a => ?_
    obtain ⟨i, hi⟩ := hne a
    rw [map_zero, map_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ i) hi
  -- the linear form
  obtain ⟨β, hβ0, hβa⟩ := exists_linear_eval_eq_zero hc a
  choose β' hβ' using fun j => Ideal.Quotient.mk_surjective (I := maximalIdeal R) (β j)
  set ℓ : MvPolynomial (Fin xs.length) (R ⧸ maximalIdeal R) :=
    ∑ j, MvPolynomial.C (β j) * MvPolynomial.X j with hℓ
  set h : R := ∑ j, β' j * xs[j] with hh
  have hxj : ∀ j : Fin xs.length, β' j * xs[j] ∈ maximalIdeal R ^ 1 := fun j => by
    rw [pow_one]; exact Ideal.mul_mem_left _ _ (hx j)
  have hh1 : h ∈ maximalIdeal R ^ 1 := Ideal.sum_mem _ fun j _ => hxj j
  have hΦℓ : Φ ℓ = classOfPow (maximalIdeal R) 1 ⟨h, hh1⟩ := by
    have e : (⟨h, hh1⟩ : ↥(maximalIdeal R ^ 1)) = ∑ j, ⟨β' j * xs[j], hxj j⟩ := by
      ext; simp [hh]
    rw [e, map_sum, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_mul, hΦdef, polyGradedHom, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
      ← hβ' j, quotientRingHom_mk _ _ (by simp), ← classOfPow_mul]
  have hℓ0 : ℓ ≠ 0 := by
    intro h0
    apply hβ0
    funext j
    have := congrArg (fun p => p.coeff (Finsupp.single j 1)) h0
    rw [hℓ, MvPolynomial.coeff_sum] at this
    simp only [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X', AddMonoidAlgebra.coeff_zero,
      Finsupp.coe_zero, Pi.zero_apply] at this
    rw [Finset.sum_eq_single j] at this
    · simpa using this
    · intro j' _ hj'
      have : Finsupp.single j' 1 ≠ Finsupp.single j (1 : ℕ) := fun he =>
        hj' (Finsupp.single_left_injective one_ne_zero he)
      simp [this]
    · simp
  have hℓa : MvPolynomial.eval a ℓ = 0 := by
    rw [hℓ, map_sum]
    simpa using hβa
  have hhm : h ∈ maximalIdeal R := by simpa using hh1
  have hh2 : h ∉ maximalIdeal R ^ 2 := by
    intro hmem
    apply hℓ0
    apply hΦ.1
    rw [map_zero, hΦℓ, MMP.Flips.associatedGraded_classOfPow_eq_zero_iff]
    exact hmem
  refine ⟨h, hhm, hh2, fun i hi b hb => ?_⟩
  obtain ⟨hg1, hg2⟩ := hspec i hi
  change g i - h * b ∈ maximalIdeal R ^ (r i + 1) at hb
  by_cases hb0 : b = 0
  · subst hb0
    exact hg2 (by simpa using hb)
  obtain ⟨hb1, hb2⟩ := MMP.Flips.maximalIdealOrder_spec hb0
  set s' := MMP.Flips.maximalIdealOrder R b
  have hhb1 : h * b ∈ maximalIdeal R ^ (1 + s') := by
    rw [pow_add]; exact Ideal.mul_mem_mul hh1 hb1
  have hhb2 : h * b ∉ maximalIdeal R ^ (1 + s' + 1) :=
    MMP.Flips.mul_notMem_maximalIdeal_pow_add_succ hh1 (by simpa using hh2) hb1 hb2
  rcases lt_trichotomy (1 + s') (r i) with hlt | heq | hgt
  · apply hhb2
    have : h * b = g i - (g i - h * b) := by ring
    rw [this]
    exact Ideal.pow_le_pow_right (by omega) (Ideal.sub_mem _ hg1
      (Ideal.pow_le_pow_right (by omega) hb))
  · -- the initial form of `g i` is divisible by `ℓ`
    obtain ⟨G, hG⟩ := hΦ.2 (classOfPow (maximalIdeal R) s' ⟨b, hb1⟩)
    have hcl : classOfPow (maximalIdeal R) (r i) ⟨g i, hg1⟩ =
        classOfPow (maximalIdeal R) (1 + s') ⟨h * b, hhb1⟩ := by
      have hmem : g i - h * b ∈ maximalIdeal R ^ (r i) :=
        Ideal.pow_le_pow_right (by omega) hb
      have h0 : classOfPow (maximalIdeal R) (r i) ⟨g i - h * b, hmem⟩ = 0 :=
        (MMP.Flips.associatedGraded_classOfPow_eq_zero_iff _ _ _).2 hb
      have hsub : (⟨g i - h * b, hmem⟩ : ↥(maximalIdeal R ^ r i)) =
          ⟨g i, hg1⟩ - ⟨h * b, heq ▸ hhb1⟩ := rfl
      rw [hsub, map_sub, sub_eq_zero] at h0
      rw [h0]
      exact classOfPow_congr _ heq.symm rfl
    have hFi : F ⟨i, hi⟩ = ℓ * G := by
      apply hΦ.1
      rw [hFΦ, map_mul, hΦℓ, hG, ← classOfPow_mul]
      exact hcl
    apply ha ⟨i, hi⟩
    rw [hFi, map_mul, hℓa, zero_mul]
  · apply hg2
    have : g i = (g i - h * b) + h * b := by ring
    rw [this]
    exact Ideal.add_mem _ hb (Ideal.pow_le_pow_right (by omega) hhb1)

end KeyAlg

/-! ### Prime divisors through a point of a smooth scheme -/

section Orders

open MMP.Intersection

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X]

/-- A prime element `p` of the local ring `𝒪_{X,x}` cuts out a prime divisor through `x`, whose
ideal at `x` is `(p)`. -/
private theorem exists_primeDivisor_stalk_eq_span (x : X) {p : X.presheaf.stalk x}
    (hp : Prime p) : ∃ E : MMP.Mori.PrimeDivisor X, x ∈ E.support ∧
      IdealSheafData.stalk E.idealSheaf x = Ideal.span {p} := by
  let q : PrimeSpectrum (X.presheaf.stalk x) :=
    ⟨Ideal.span {p}, (Ideal.span_singleton_prime hp.ne_zero).mpr hp⟩
  set z := X.fromSpecStalk x q
  have hz : z ⤳ x := fromSpecStalk_specializes x q
  have hpz : primeOfSpecializes hz = Ideal.span {p} :=
    comap_maximalIdeal_stalkSpecializes_fromSpecStalk x q
  have hz1 : Order.coheight z = 1 := coheight_fromSpecStalk_span_eq_one hp
  let E := AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hz1
  have hEz : E.genericPoint = z := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hz1
  have hxE : x ∈ E.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    change x ∈ closure {E.genericPoint}
    rw [hEz]
    exact hz.mem_closure
  refine ⟨E, hxE, ?_⟩
  have hsp : E.genericPoint ⤳ x := hEz ▸ hz
  rw [← Scheme.IdealSheafData.stalkIdeal_eq_stalk, stalkIdeal_primeDivisor E hsp, ← hpz]
  exact primeOfSpecializes_congr hEz hsp hz

/-- A prime divisor through `x` is determined by its ideal at `x`. -/
private theorem primeDivisor_eq_of_stalk_eq {x : X} {E E' : MMP.Mori.PrimeDivisor X}
    (hE : x ∈ E.support) (hE' : x ∈ E'.support)
    (h : IdealSheafData.stalk E.idealSheaf x = IdealSheafData.stalk E'.idealSheaf x) :
    E = E' := by
  have hs := genericPoint_specializes_of_mem_support E hE
  have hs' := genericPoint_specializes_of_mem_support E' hE'
  rw [← Scheme.IdealSheafData.stalkIdeal_eq_stalk, ← Scheme.IdealSheafData.stalkIdeal_eq_stalk, stalkIdeal_primeDivisor E hs,
    stalkIdeal_primeDivisor E' hs'] at h
  apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
  have e1 := fromSpecStalk_primeOfSpecializes hs
  have e2 := fromSpecStalk_primeOfSpecializes hs'
  have e : (⟨primeOfSpecializes hs, inferInstance⟩ : PrimeSpectrum (X.presheaf.stalk x)) =
      ⟨primeOfSpecializes hs', inferInstance⟩ := PrimeSpectrum.ext h
  exact e1.symm.trans ((congrArg _ e).trans e2)

variable (sX) in
/-- On a smooth scheme, a generator of the ideal of a prime divisor at a point is prime. -/
private theorem prime_of_stalk_eq_span [LocallyOfFiniteType sX] (hsm : IsSmoothScheme sX)
    {x : X} {P : MMP.Mori.PrimeDivisor X} (hP : x ∈ P.support) {π : X.presheaf.stalk x}
    (hπ : IdealSheafData.stalk P.idealSheaf x = Ideal.span {π}) : Prime π := by
  obtain ⟨π₀, hπ₀, hπ₀P⟩ := MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sX hsm P hP
  have hass : Associated π₀ π := by
    rw [← Ideal.span_singleton_eq_span_singleton, ← hπ₀P, hπ]
  exact hass.prime hπ₀

open Classical in
variable (sX) in
/-- **Orders of a local equation.** If `π` generates the ideal of the prime divisor `P` at `x`,
then along every prime divisor `E` through `x` the order of `π` is `1` if `E = P` and `0`
otherwise. -/
private theorem ord_eq_ite_of_stalk_eq_span [LocallyOfFiniteType sX] (hsm : IsSmoothScheme sX)
    {x : X} {P E : MMP.Mori.PrimeDivisor X} (hP : x ∈ P.support) (hE : x ∈ E.support)
    {π : X.presheaf.stalk x} (hπ : IdealSheafData.stalk P.idealSheaf x = Ideal.span {π}) :
    X.ord (algebraMap _ X.functionField π) E.genericPoint = if E = P then 1 else 0 := by
  have hp := prime_of_stalk_eq_span sX hsm hP hπ
  have hsp := genericPoint_specializes_of_mem_support P hP
  have hpz : primeOfSpecializes hsp = Ideal.span {π} := by
    rw [← stalkIdeal_primeDivisor P hsp, Scheme.IdealSheafData.stalkIdeal_eq_stalk, hπ]
  rw [ord_prime_eq_ite hp hsp hpz (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint P) E hE]
  exact if_congr AlgebraicGeometry.PrimeDivisor.genericPoint_injective.eq_iff rfl rfl

/-- A regular function at `x` has nonnegative order along every prime divisor through `x`. -/
private theorem ord_algebraMap_nonneg {x : X} {E : MMP.Mori.PrimeDivisor X}
    (hE : x ∈ E.support) (r : X.presheaf.stalk x) :
    0 ≤ X.ord (algebraMap _ X.functionField r) E.genericPoint := by
  have hsp := genericPoint_specializes_of_mem_support E hE
  rw [← algebraMap_stalkSpecializes hsp]
  by_cases h0 : X.presheaf.stalkSpecializes hsp r = 0
  · rw [h0, map_zero]; simp
  · rw [ord_algebraMap_eq_toNat_ord _ (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint E) h0]
    exact Int.natCast_nonneg _

/-- The multiplicity `mult_x g` of a nonzero element of a Noetherian local ring is its order. -/
private theorem localMultiplicity_eq_maximalIdealOrder {x : X}
    [IsNoetherianRing (X.presheaf.stalk x)] {g : X.presheaf.stalk x} (hg : g ≠ 0) :
    MMP.Mori.localMultiplicity g = MMP.Flips.maximalIdealOrder _ g := by
  obtain ⟨h1, h2⟩ := MMP.Flips.maximalIdealOrder_spec hg
  refine le_antisymm (iSup₂_le fun m hm => ?_) (MMP.Mori.le_localMultiplicity h1)
  by_contra hlt
  push Not at hlt
  exact h2 (Ideal.pow_le_pow_right (by exact_mod_cast Order.add_one_le_of_lt hlt) hm)

open Classical in
variable (sX) in
/-- **The multiplicity of the divisor of a regular function** (on a smooth scheme). For
`r ∈ 𝒪_{X,x}` nonzero, `∑_E ord_E(r) · mult_x E = ord_x(r)`, the sum over the prime divisors `E`
through `x`. -/
private theorem sum_ord_mul_multiplicityAt [LocallyOfFiniteType sX] (hsm : IsSmoothScheme sX)
    (x : X) {r : X.presheaf.stalk x} (hr : r ≠ 0) (S : Finset (MMP.Mori.PrimeDivisor X))
    (hS : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support →
      X.ord (algebraMap _ X.functionField r) E.genericPoint ≠ 0 → E ∈ S) :
    ∑ E ∈ S, (if x ∈ E.support then X.ord (algebraMap _ X.functionField r) E.genericPoint *
      ((E.multiplicityAt x).toNat : ℤ) else 0) = (MMP.Flips.maximalIdealOrder _ r : ℤ) := by
  classical
  haveI := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
  haveI := IsRegularLocalRing.uniqueFactorizationMonoid (X.presheaf.stalk x)
  haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  revert hr S
  induction r using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ => intro hr; exact absurd rfl hr
  | h₂ u hu =>
    intro _ S _
    rw [Finset.sum_eq_zero fun E _ => ?_]
    · have hu' : u ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ (0 + 1) := by
        rw [zero_add, pow_one]; exact fun h => (IsLocalRing.mem_maximalIdeal _).1 h hu
      rw [maximalIdealOrder_eq_of_mem_of_notMem (by simp) hu']
      rfl
    · split_ifs with hE
      · rw [ord_algebraMap_isUnit_at (genericPoint_specializes_of_mem_support E hE)
          (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint E) hu, zero_mul]
      · rfl
  | h₃ a p ha hp ih =>
    intro hr S hS
    obtain ⟨Ep, hxEp, hEp⟩ := exists_primeDivisor_stalk_eq_span x hp
    have hpa : algebraMap _ X.functionField p ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hp.ne_zero
    have haa : algebraMap _ X.functionField a ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr ha
    have hord : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support →
        X.ord (algebraMap _ X.functionField (p * a)) E.genericPoint =
          (if E = Ep then 1 else 0) + X.ord (algebraMap _ X.functionField a) E.genericPoint := by
      intro E hE
      rw [map_mul, Scheme.ord_mul hpa haa, ord_eq_ite_of_stalk_eq_span sX hsm hxEp hE hEp]
    have hSa : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support →
        X.ord (algebraMap _ X.functionField a) E.genericPoint ≠ 0 → E ∈ S := by
      intro E hE hne
      refine hS E hE ?_
      rw [hord E hE]
      have := ord_algebraMap_nonneg hE a
      split_ifs <;> omega
    have hEpS : Ep ∈ S := by
      refine hS Ep hxEp ?_
      rw [hord Ep hxEp, if_pos rfl]
      have := ord_algebraMap_nonneg hxEp a
      omega
    have hsplit : ∀ E ∈ S, (if x ∈ E.support then
        X.ord (algebraMap _ X.functionField (p * a)) E.genericPoint *
          ((E.multiplicityAt x).toNat : ℤ) else 0) =
        (if E = Ep then ((E.multiplicityAt x).toNat : ℤ) else 0) +
          (if x ∈ E.support then X.ord (algebraMap _ X.functionField a) E.genericPoint *
            ((E.multiplicityAt x).toNat : ℤ) else 0) := by
      intro E _
      by_cases hE : x ∈ E.support
      · rw [if_pos hE, if_pos hE, hord E hE]
        split_ifs <;> ring
      · rw [if_neg hE, if_neg hE]
        split_ifs with hEE
        · exact absurd (hEE ▸ hxEp) hE
        · rfl
    rw [Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, ih ha S hSa,
      Finset.sum_ite_eq' S Ep, if_pos hEpS, MMP.Flips.maximalIdealOrder_mul hp.ne_zero ha]
    have hm : Ep.multiplicityAt x = MMP.Flips.maximalIdealOrder _ p := by
      rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_localMultiplicity Ep
        (by rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk]; exact hEp), localMultiplicity_eq_maximalIdealOrder hp.ne_zero]
    rw [hm, ENat.toNat_coe]
    push_cast
    ring

end Orders

/-! ### Smooth prime divisors are snc -/

section SNCSingle

/-- A regular local ring `A` with a nonzero element `π` of `𝔪` such that `A ⧸ (π)` is regular
has a regular system of parameters whose first member is `π`. -/
private theorem exists_isRegularSystemOfParameters_zero_eq {A : Type*} [CommRing A]
    [IsRegularLocalRing A] {π : A} (hπ : π ∈ IsLocalRing.maximalIdeal A) (hπ0 : π ≠ 0)
    (hreg : IsRegularLocalRing (A ⧸ Ideal.span {π})) :
    ∃ (n : ℕ) (z : Fin (n + 1) → A), MMP.Mori.IsRegularSystemOfParameters z ∧ z 0 = π := by
  classical
  have : IsDomain A := IsRegularLocalRing.isDomain A
  set B := A ⧸ Ideal.span {π}
  set mk : A →+* B := Ideal.Quotient.mk _
  have hsurj : Function.Surjective mk := Ideal.Quotient.mk_surjective
  obtain ⟨n, w, hw⟩ := MMP.Mori.exists_isRegularSystemOfParameters B
  choose w' hw' using fun i => hsurj (w i)
  refine ⟨n, Fin.cons π w', ⟨?_, ?_⟩, rfl⟩
  · have hker : RingHom.ker mk ≤ Ideal.span (Set.range (Fin.cons π w' : Fin (n + 1) → A)) := by
      rw [Ideal.mk_ker]
      exact Ideal.span_mono (Set.singleton_subset_iff.2 ⟨0, rfl⟩)
    have hmap : (Ideal.span (Set.range (Fin.cons π w' : Fin (n + 1) → A))).map mk =
        IsLocalRing.maximalIdeal B := by
      rw [Ideal.map_span, ← hw.1]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cons_zero]
          rw [Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton_self π)]
          exact zero_mem _
        · simp only [Fin.cons_succ, hw']
          exact Ideal.subset_span ⟨j, rfl⟩
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        exact Ideal.subset_span ⟨w' j, ⟨j.succ, by simp⟩, hw' j⟩
    have := Ideal.comap_map_of_surjective' mk hsurj
      (Ideal.span (Set.range (Fin.cons π w' : Fin (n + 1) → A)))
    rw [hmap, sup_eq_left.2 hker] at this
    rw [← this]
    have : IsLocalHom mk := IsLocalHom.of_surjective mk hsurj
    exact IsLocalRing.maximalIdeal_comap mk
  · have hreg0 : π ∈ nonZeroDivisors A := mem_nonZeroDivisors_of_ne_zero hπ0
    rw [← ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      hreg0 hπ, hw.2]
    norm_cast

/-- The local ring of a closed subscheme `V(I)` at a point is `𝒪_{X,x} ⧸ I_x`. -/
private noncomputable def stalkSubschemeEquiv {X : Scheme.{0}} (I : X.IdealSheafData)
    (z : I.subscheme) :
    X.presheaf.stalk (I.subschemeι z) ⧸ IdealSheafData.stalk I (I.subschemeι z) ≃+*
      I.subscheme.presheaf.stalk z :=
  (Ideal.quotEquivOfEq (by rw [Scheme.IdealSheafData.ker_stalkMap_subschemeι,
    Scheme.IdealSheafData.stalkIdeal_eq_stalk])).trans
    (RingHom.quotientKerEquivOfSurjective
      (SurjectiveOnStalks.stalkMap_surjective I.subschemeι z))

/-- A divisor on a smooth scheme over a perfect field whose support consists of at most one prime
divisor, itself smooth, is snc. -/
private theorem isSNC_of_subsingleton_support {k : Type} [Field k] [PerfectField k]
    {Y : Scheme.{0}} (g : Y ⟶ Spec (.of k)) [LocallyOfFiniteType g] (hY : IsSmoothScheme g)
    {R : Type*} [Zero R] (D : DivisorWithCoeffs R Y)
    (hD : ∀ E ∈ D.support, ∀ F ∈ D.support, E = F)
    (hsm : ∀ E ∈ D.support, IsSmoothScheme (E.idealSheaf.subschemeι ≫ g)) :
    DivisorWithCoeffs.IsSNC g D := by
  classical
  refine ⟨hsm, fun y => ?_⟩
  have : Smooth g := MMP.Resolution.Aux.smooth_of_isSmoothScheme' g hY
  have := isRegularLocalRing_stalk_of_smooth_over_field g y
  by_cases h : ∃ E ∈ D.support, y ∈ E.support
  · obtain ⟨E, hE, hyE⟩ := h
    obtain ⟨p, hp, hpE⟩ := MMP.Resolution.Aux.exists_prime_stalk_idealSheaf g hY E hyE
    have hpm : p ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
      (Stacks.Divisors.stalk_le_maximalIdeal_iff_mem_support _ _).2 hyE
        (hpE ▸ Ideal.mem_span_singleton_self p)
    have hq : IsRegularLocalRing (Y.presheaf.stalk y ⧸ Ideal.span {p}) := by
      obtain ⟨z, rfl⟩ : y ∈ Set.range E.idealSheaf.subschemeι := by
        rw [Scheme.IdealSheafData.range_subschemeι]; exact hyE
      have : Smooth (E.idealSheaf.subschemeι ≫ g) :=
        MMP.Resolution.Aux.smooth_of_isSmoothScheme' _ (hsm E hE)
      have := isRegularLocalRing_stalk_of_smooth_over_field (E.idealSheaf.subschemeι ≫ g) z
      exact IsRegularLocalRing.of_ringEquiv ((Ideal.quotEquivOfEq hpE.symm).trans
        (stalkSubschemeEquiv E.idealSheaf z)).symm
    obtain ⟨n, z, hz, hz0⟩ := exists_isRegularSystemOfParameters_zero_eq hpm hp.ne_zero hq
    refine ⟨n + 1, z, fun _ => 0, hz, fun E₁ E₂ _ => Subtype.ext (hD _ E₁.2.1 _ E₂.2.1),
      fun E' => ?_⟩
    rw [hD E'.1 E'.2.1 E hE, hpE, hz0]
  · obtain ⟨n, z, hz⟩ := MMP.Mori.exists_isRegularSystemOfParameters (Y.presheaf.stalk y)
    exact ⟨n, z, fun E => (h ⟨E.1, E.2.1, E.2.2⟩).elim, hz,
      fun E => (h ⟨E.1, E.2.1, E.2.2⟩).elim, fun E => (h ⟨E.1, E.2.1, E.2.2⟩).elim⟩

end SNCSingle

/-! ### Klt loci and the adjoint ideal with zero boundary -/

section Klt

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- `(X, D)` is *klt at the points of `V`*: every divisor over `X` whose centre has its generic
point in `V` has positive log discrepancy with respect to `D`. -/
private def IsKltOn (D : QDivisor X) (V : Set X) : Prop :=
  ∀ (n : ℕ) (F : DivisorOver k sX) (a : ℝ), F.f F.E.genericPoint ∈ V →
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor D) F a → 0 < a

variable {sX}

omit [IsLocallyNoetherian X] [IsNormal X] in
/-- The centre of a divisor over `X` is never the whole of `X`. -/
private theorem map_genericPoint_ne_genericPoint (F : DivisorOver k sX) :
    F.f F.E.genericPoint ≠ genericPoint X := by
  intro hx
  obtain ⟨g, hg⟩ := MMP.Positivity.DivisorOver.exists_valuation_eq_exp_neg_one F
  obtain ⟨a, ha⟩ :=
    MMP.Positivity.DivisorOver.algebraMap_stalk_surjective_of_eq_genericPoint _ hx g⁻¹
  have hle := MMP.Positivity.DivisorOver.valuation_algebraMap_le_one F _ rfl a
  rw [ha, map_inv₀, hg, ← WithZero.exp_neg, neg_neg] at hle
  exact absurd hle (by decide)

omit [IsLocallyNoetherian X] [IsNormal X] in
/-- A closed set not containing the generic point contains no stratum of the zero divisor. -/
private theorem containsNoStratum_zero {T : Set X} (hT : genericPoint X ∉ T) :
    ContainsNoStratum (0 : Divisor X) T := by
  rintro S ⟨J, hJ, hmax⟩ hST
  have hJ0 : J = ∅ := Finset.subset_empty.mp (by simpa using hJ)
  subst hJ0
  have hSu : S = Set.univ :=
    Set.eq_univ_of_univ_subset (hmax.2 ⟨IrreducibleSpace.isIrreducible_univ X, by simp⟩
      (Set.subset_univ _))
  exact hT (hST (hSu ▸ Set.mem_univ _))

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- The zero divisor of a smooth scheme is reduced snc. -/
private theorem isReducedSNC_zero [LocallyOfFinitePresentation sX] (hsm : IsSmoothScheme sX) :
    IsReducedSNC sX (0 : Divisor X) :=
  ⟨fun _ => Or.inl rfl, DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sX hsm⟩

/-- On a smooth variety, no divisor over `X` has log discrepancy zero with respect to the zero
boundary. -/
private theorem isLogDiscrepancy_zero_ne_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {n : ℕ} {F : DivisorOver k sX}
    {a₀ : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor 0) F a₀) :
    a₀ ≠ 0 := by
  rintro rfl
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  refine notMem_of_isLogDiscrepancy_eq_zero hX hsm (isReducedSNC_zero hsm)
    (isClosed_closure (s := {F.f F.E.genericPoint}))
    (containsNoStratum_zero fun hη => map_genericPoint_ne_genericPoint F ?_) h (subset_closure rfl)
  exact ((specializes_iff_mem_closure.mpr hη).antisymm (genericPoint_specializes _)).eq

/-- **Klt points give the unit ideal.** If `(X, D)` is klt at the points of `U`, then the
adjoint ideal `𝒥_{0,D}` agrees with `𝒪_X` on every non-empty open subset of `U`. -/
private theorem eq_range_of_isKltOn [IsAlgClosed k] [CharZero k] {D : QDivisor X}
    {Y : Scheme.{0}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (hJ : IsReducedAdjointIdealOn sX 0 D μ J) {U : X.Opens} (hU : IsKltOn sX D U)
    (V : X.Opens) [Nonempty V] (hVU : V ≤ U) :
    J V = Set.range (X.germToFunctionField V) := by
  refine le_antisymm (((isReducedAdjointIdealOn_operations sX).2.1 0 D μ J hJ).1 V) ?_
  rintro _ ⟨s, rfl⟩
  rw [eq_adjointSet sX hJ]
  refine ⟨fun h => absurd h ?_, fun n F a₀ a hF _ ha => ?_⟩
  · obtain ⟨v⟩ := ‹Nonempty V›
    exact fun h' => by simpa [h'] using v.2
  · have ha' : 0 < a := hU n F a (hVU hF) (by simpa using ha)
    have hc : 1 ≤ ⌈a⌉ := Int.one_le_ceil_iff.mpr ha'
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField X hF]
    refine (MMP.Positivity.DivisorOver.valuation_algebraMap_le_one F _ rfl _).trans ?_
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]
    split_ifs <;> omega

/-- **A local unit in the adjoint ideal gives klt points.** If `𝒥_{0,D}` contains, over `V`, a
rational function which is regular and invertible on `W ⊆ V`, then `(X, D)` is klt at the
points of `W`. -/
private theorem isKltOn_of_isUnit_mem [IsAlgClosed k] [CharZero k] {D : QDivisor X}
    {Y : Scheme.{0}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (hJ : IsReducedAdjointIdealOn sX 0 D μ J) {V W : X.Opens} [Nonempty W] (hWV : W ≤ V)
    {s : Γ(X, W)} (hs : IsUnit s) (hsJ : X.germToFunctionField W s ∈ J V) :
    IsKltOn sX D W := by
  obtain ⟨hX, hsm, -⟩ := id hJ
  intro n F a hF ha
  rw [eq_adjointSet sX hJ] at hsJ
  have hp : IsProper F.f := ha.2.1
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  obtain ⟨a₀, ha₀⟩ := exists_isLogDiscrepancy hX hsm hn 0 F hp
  rw [map_zero] at ha₀
  have ha₀' : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor 0) F a₀ := by
    simpa using ha₀
  have hne := isLogDiscrepancy_zero_ne_zero hX hsm ha₀'
  have h1 := hsJ.2 n F a₀ a (hWV hF) ha₀' (by simpa using ha)
  rw [if_neg hne] at h1
  have hv : F.valuation (X.germToFunctionField W s) = 1 := by
    obtain ⟨t, ht⟩ := hs.exists_right_inv
    have hle := MMP.Positivity.DivisorOver.valuation_algebraMap_le_one F _ rfl
      (X.presheaf.germ W _ hF s)
    have hle' := MMP.Positivity.DivisorOver.valuation_algebraMap_le_one F _ rfl
      (X.presheaf.germ W _ hF t)
    rw [Scheme.algebraMap_germ_eq_germToFunctionField] at hle hle'
    have hm : F.valuation (X.germToFunctionField W s) * F.valuation (X.germToFunctionField W t)
        = 1 := by
      rw [← map_mul, ← map_mul, ht, map_one, map_one]
    refine le_antisymm hle ?_
    calc (1 : WithZero (Multiplicative ℤ)) = _ := hm.symm
      _ ≤ F.valuation (X.germToFunctionField W s) * 1 := mul_le_mul_right hle' _
      _ = _ := mul_one _
  rw [hv, ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  by_contra hle
  push Not at hle
  have : ⌈a⌉ ≤ 0 := Int.ceil_le.mpr (by simpa using hle)
  omega

end Klt

/-! ### Klt points are local -/

section Local

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **Klt points can be checked on an open subscheme.** If `(U, D|_U)` is klt at the points of
`V ⊆ U`, then `(X, D)` is klt at the points of `V`. -/
private theorem isKltOn_image_of_isKltOn_restrict [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) (U : X.Opens) [Nonempty U] {V : Set U}
    (h : IsKltOn (U.ι ≫ sX) (inverseTransformDivisor U.ι D) V) :
    IsKltOn sX D (U.ι '' V) := by
  haveI := Opens.isDominant_ι (U.isOpen.dense (Set.nonempty_coe_sort.mp ‹Nonempty U›))
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  rintro n F a ⟨v, hv, hFv⟩ ha
  have hp : IsProper F.f := ha.2.1
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  obtain ⟨K, hPW⟩ := exists_isPairWith hX hsm hn D
  have hB : MMP.Fourfold.IsPair sX D := ⟨inferInstance, inferInstance, hPW.isPair, hD⟩
  have hcen : F.f F.E.genericPoint ∈ (F.center : Set X) := by
    rw [F.center_eq_closure_genericPoint]; exact subset_closure rfl
  have hU : ((F.center : Set X) ∩ U).Nonempty := ⟨_, hcen, hFv ▸ v.2⟩
  obtain ⟨hY, hf, E', hE', hval, -⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U hU
  set F' : DivisorOver k (U.ι ≫ sX) := ⟨_, F.f ∣_ U, hY, hf, E'⟩ with hF'
  have hξ : MMP.Intersection.IsNormalizedDivisorialValuation k sX F.valuation := ⟨F, hp, rfl⟩
  have hZ : MMP.Intersection.IsCentre k sX F.valuation F.center := ⟨F, hp, rfl, rfl⟩
  obtain ⟨n', F'', -, hv'', hl''⟩ :=
    (MMP.Fourfold.isValuationLogDiscrepancy_restrict_iff sX hB hξ hZ U
      (by rwa [Set.inter_comm]) (ξU := F'.valuation) hval.symm a).2 ⟨n, F, hp, rfl, ha⟩
  refine h n' F'' a ?_ hl''
  have hUv : MMP.Mori.IsVariety k (U.ι ≫ sX) := (MMP.Mori.isNormalVariety_ι hX U).1
  have heq := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hUv hv''
  have hgen : U.ι (F'.f F'.E.genericPoint) = F.f F.E.genericPoint := by
    rw [← hE']
    change _ = F.f (AlgebraicGeometry.PrimeDivisor.genericPoint _)
    rw [OpenWeilRestriction.genericPoint_primeDivisorMap, hF']
    change U.ι ((F.f ∣_ U) E'.genericPoint) = _
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  rw [heq]
  have : F'.f F'.E.genericPoint = v := U.ι.isOpenEmbedding.injective (hgen.trans hFv.symm)
  rwa [this]

end Local

/-! ### Multiplicities of the restriction to a general hypersurface -/

section Restriction

open MMP.Intersection IsLocalRing

/-- Orders are preserved by a surjective map of Noetherian local rings with kernel `(h)`, at
an element `π` none of whose translates `π - h b` drops into the next power of `𝔪`. -/
private theorem maximalIdealOrder_map_of_surjective {R S : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (φ : R →+* S)
    (hφ : Function.Surjective φ) {h : R} (hker : RingHom.ker φ = Ideal.span {h}) {π : R}
    (hπ : π ≠ 0)
    (hgood : ∀ b, π - h * b ∉ maximalIdeal R ^ (MMP.Flips.maximalIdealOrder R π + 1)) :
    MMP.Flips.maximalIdealOrder S (φ π) = MMP.Flips.maximalIdealOrder R π := by
  have hm : (maximalIdeal R).map φ = maximalIdeal S := map_maximalIdeal_of_surjective φ hφ
  obtain ⟨h1, -⟩ := MMP.Flips.maximalIdealOrder_spec hπ
  apply maximalIdealOrder_eq_of_mem_of_notMem
  · rw [← hm, ← Ideal.map_pow]; exact Ideal.mem_map_of_mem φ h1
  · intro hmem
    rw [← hm, ← Ideal.map_pow] at hmem
    obtain ⟨a, ha, hφa⟩ := (Ideal.mem_map_iff_of_surjective φ hφ).1 hmem
    have hk : π - a ∈ RingHom.ker φ := by
      rw [RingHom.mem_ker, map_sub, hφa, sub_self]
    rw [hker, Ideal.mem_span_singleton'] at hk
    obtain ⟨b, hb⟩ := hk
    apply hgood b
    have : π - h * b = a := by rw [mul_comm, hb]; ring
    rw [this]; exact ha

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X]

open Classical in
variable (sX) in
/-- **The restriction of a local equation.** Let `j : T ⟶ X` be a smooth integral closed
subscheme of the smooth scheme `X`, `y ∈ T`, and `π` a generator of the ideal of the prime
divisor `P` at `j y`, with nonzero restriction to `T`. Along every prime divisor `Q` of `T`
through `y`, the order of `π|_T` is the local intersection length of `P` with `T` at `Q`. -/
private theorem ord_stalkMap_eq_intersectionLength [LocallyOfFiniteType sX] [Smooth sX]
    (hsm : IsSmoothScheme sX) {T : Scheme.{0}} (j : T ⟶ X) [IsClosedImmersion j]
    [IsIntegral T] [IsLocallyNoetherian T] [Smooth (j ≫ sX)] (y : T)
    {P : MMP.Mori.PrimeDivisor X} (hP : j y ∈ P.support) {π : X.presheaf.stalk (j y)}
    (hπ : IdealSheafData.stalk P.idealSheaf (j y) = Ideal.span {π})
    (hπ0 : j.stalkMap y π ≠ 0) (Q : MMP.Mori.PrimeDivisor T) (hyQ : y ∈ Q.support) :
    T.ord (algebraMap _ T.functionField (j.stalkMap y π)) Q.genericPoint =
      (P.intersectionLength j Q : ℤ) := by
  have hQy := genericPoint_specializes_of_mem_support Q hyQ
  have hsp : j Q.genericPoint ⤳ j y := hQy.map j.continuous
  set r₀ := X.presheaf.stalkSpecializes hsp π with hr₀
  have hkey : j.stalkMap Q.genericPoint r₀ = T.presheaf.stalkSpecializes hQy (j.stalkMap y π) :=
    Scheme.Hom.stalkSpecializes_stalkMap_apply j Q.genericPoint y hQy π
  have hr0 : j.stalkMap Q.genericPoint r₀ ≠ 0 := by
    rw [hkey]
    intro h0
    exact hπ0 (stalkSpecializes_injective hQy (h0.trans (map_zero _).symm))
  rw [← algebraMap_stalkSpecializes hQy, ← hkey]
  obtain ⟨S0, -, hsum⟩ :=
    MMP.Mori.PrimeDivisor.ord_stalkMap_eq_sum_intersectionLength_mul_ord sX j Q r₀ hr0
  rw [hsum (insert P S0) (Finset.subset_insert _ _)]
  have hterm : ∀ E ∈ insert P S0, (if j Q.genericPoint ∈ E.support then
      (E.intersectionLength j Q : ℤ) *
        X.ord (algebraMap _ X.functionField r₀) E.genericPoint else 0) =
      if E = P then (if j Q.genericPoint ∈ P.support then
        (P.intersectionLength j Q : ℤ) else 0) else 0 := by
    intro E _
    by_cases hE : j Q.genericPoint ∈ E.support
    · have hEy : j y ∈ E.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE ⊢
        exact closure_minimal (Set.singleton_subset_iff.mpr hE) isClosed_closure
          (hsp.mem_closure)
      rw [if_pos hE, hr₀, algebraMap_stalkSpecializes,
        ord_eq_ite_of_stalk_eq_span sX hsm hP hEy hπ]
      split_ifs with hEP hPs <;> simp_all
    · rw [if_neg hE]
      split_ifs with hEP hPs
      · exact absurd (hEP ▸ hPs) hE
      · rfl
      · rfl
  rw [Finset.sum_congr rfl hterm, Finset.sum_ite_eq' _ P, if_pos (Finset.mem_insert_self _ _)]
  split_ifs with hPs
  · rfl
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem j P hPs]; rfl

open Classical in
variable (sX) in
/-- **The multiplicity of the restriction to a general hypersurface.** Let `j : T ⟶ X` be a
smooth integral closed subscheme of the smooth scheme `X`, cut out at `j y` by `h`, and `D ≥ 0`
a `ℚ`-divisor whose restriction to `T` has the intersection-length coefficients. If, for every
component `P` of `D` through `j y`, some local equation `π` of `P` keeps its order modulo `h`,
then `mult_y (D|_T) = mult_{j y} D`. -/
private theorem multiplicityAt_restrict_eq [LocallyOfFiniteType sX] [Smooth sX]
    (hsm : IsSmoothScheme sX) {T : Scheme.{0}} (j : T ⟶ X) [IsClosedImmersion j]
    [IsIntegral T] [IsLocallyNoetherian T] [LocallyOfFiniteType (j ≫ sX)] [Smooth (j ≫ sX)]
    (hsmT : IsSmoothScheme (j ≫ sX)) {D : QDivisor X} (hD : ∀ P, 0 ≤ D.coeff P)
    (hcoeff : ∀ Q, (D.restrict j).coeff Q = D.sum fun E d => E.intersectionLength j Q • d)
    (y : T) {h : X.presheaf.stalk (j y)}
    (hker : RingHom.ker (j.stalkMap y).hom = Ideal.span {h})
    (hgood : ∀ P ∈ D.support, j y ∈ P.support → ∃ π : X.presheaf.stalk (j y),
      IdealSheafData.stalk P.idealSheaf (j y) = Ideal.span {π} ∧
        ∀ b, π - h * b ∉ maximalIdeal _ ^ (MMP.Flips.maximalIdealOrder _ π + 1)) :
    (D.restrict j).multiplicityAt y = D.multiplicityAt (j y) := by
  classical
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX (j y)
  haveI := isRegularLocalRing_stalk_of_smooth_over_field (j ≫ sX) y
  set S := (D.restrict j).support with hS
  have hpos : ∀ P ∈ D.support, 0 < D.coeff P := fun P hP =>
    lt_of_le_of_ne (hD P) (Ne.symm (Finsupp.mem_support_iff.mp hP))
  have key : ∀ P ∈ D.support, ∑ Q ∈ S, (Q.multiplicityAt y).toNat * P.intersectionLength j Q =
      (P.multiplicityAt (j y)).toNat := by
    intro P hPD
    by_cases hP : j y ∈ P.support
    · obtain ⟨π, hπ, hgπ⟩ := hgood P hPD hP
      have hπ0 : π ≠ 0 := by
        rintro rfl
        exact hgπ 0 (by simp)
      have hr0 : j.stalkMap y π ≠ 0 := by
        intro h0
        have hm : π ∈ RingHom.ker (j.stalkMap y).hom := h0
        rw [hker, Ideal.mem_span_singleton'] at hm
        obtain ⟨b, hb⟩ := hm
        exact hgπ b (by rw [← hb, mul_comm, sub_self]; exact zero_mem _)
      have hG := sum_ord_mul_multiplicityAt (j ≫ sX) hsmT y hr0 S (by
        intro Q hyQ hne
        rw [ord_stalkMap_eq_intersectionLength sX hsm j y hP hπ hr0 Q hyQ] at hne
        rw [hS, Finsupp.mem_support_iff]
        change (D.restrict j).coeff Q ≠ 0
        rw [hcoeff Q]
        refine ne_of_gt (lt_of_lt_of_le ?_ (Finset.single_le_sum
          (f := fun E => (E.intersectionLength j Q : ℕ) • D.coeff E)
          (fun E _ => nsmul_nonneg (hD E) _) hPD))
        exact nsmul_pos (hpos P hPD) (by exact_mod_cast hne))
      have hterm : ∀ Q ∈ S, (if y ∈ Q.support then
          T.ord (algebraMap _ T.functionField (j.stalkMap y π)) Q.genericPoint *
            ((Q.multiplicityAt y).toNat : ℤ) else 0) =
          (((Q.multiplicityAt y).toNat * P.intersectionLength j Q : ℕ) : ℤ) := by
        intro Q _
        split_ifs with hyQ
        · rw [ord_stalkMap_eq_intersectionLength sX hsm j y hP hπ hr0 Q hyQ]; push_cast; ring
        · rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_zero_of_notMem Q hyQ]; simp
      rw [Finset.sum_congr rfl hterm, maximalIdealOrder_map_of_surjective _
        (SurjectiveOnStalks.stalkMap_surjective j y) hker hπ0 hgπ] at hG
      rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_localMultiplicity P
        (by rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk]; exact hπ), localMultiplicity_eq_maximalIdealOrder hπ0,
        ENat.toNat_coe]
      exact_mod_cast hG
    · rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_zero_of_notMem P hP]
      refine Finset.sum_eq_zero fun Q _ => ?_
      by_cases hyQ : y ∈ Q.support
      · have hQ : j Q.genericPoint ∉ P.support := by
          intro hm
          apply hP
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hm ⊢
          exact closure_minimal (Set.singleton_subset_iff.mpr hm) isClosed_closure
            ((genericPoint_specializes_of_mem_support Q hyQ).map j.continuous).mem_closure
        rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem j P hQ, mul_zero]
      · rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_zero_of_notMem Q hyQ]; simp
  unfold DivisorWithCoeffs.multiplicityAt
  rw [Finsupp.sum, Finsupp.sum, ← hS]
  calc ∑ Q ∈ S, (Q.multiplicityAt y).toNat • (D.restrict j) Q
      = ∑ Q ∈ S, ∑ P ∈ D.support,
          ((Q.multiplicityAt y).toNat * P.intersectionLength j Q) • D P := by
        refine Finset.sum_congr rfl fun Q _ => ?_
        rw [show (D.restrict j) Q = (D.restrict j).coeff Q from rfl, hcoeff Q, Finsupp.sum,
          Finset.smul_sum]
        refine Finset.sum_congr rfl fun P _ => ?_
        rw [smul_smul]
    _ = ∑ P ∈ D.support, (∑ Q ∈ S,
          (Q.multiplicityAt y).toNat * P.intersectionLength j Q) • D P := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun P _ => ?_
        rw [Finset.sum_smul]
    _ = ∑ P ∈ D.support, (P.multiplicityAt (j y)).toNat • D P :=
        Finset.sum_congr rfl fun P hP => by rw [key P hP]

end Restriction

/-! ### The inductive step along a smooth hypersurface -/

/-- A point whose image under an injective continuous map is closed is itself closed. -/
private theorem isClosed_singleton_of_injective {α β : Type*} [TopologicalSpace α]
    [TopologicalSpace β] {f : α → β} (hf : Continuous f) (hinj : Function.Injective f) {a : α}
    (ha : IsClosed ({f a} : Set β)) : IsClosed ({a} : Set α) := by
  rw [← hinj.preimage_image {a}, Set.image_singleton]
  exact ha.preimage hf

section Step

open MMP.Intersection IsLocalRing

/-- The restriction of the zero divisor is zero. -/
private theorem restrict_zero {R : Type*} [AddCommMonoid R] {X S : Scheme.{0}} (f : S ⟶ X) :
    (0 : DivisorWithCoeffs R X).restrict f = 0 := by
  ext P
  rw [DivisorWithCoeffs.restrict]
  split_ifs with h
  · change (Finsupp.ofSupportFinite _ h) P = 0
    rw [Finsupp.ofSupportFinite_coe]
    simp [DivisorWithCoeffs.restrictCoeff]
  · rfl

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The generic point of a prime divisor `S` lies outside the support of a divisor of which `S` is
not a component. -/
private theorem genericPoint_notMem_supp_of_coeff_eq_zero {R : Type*} [Zero R]
    (C : DivisorWithCoeffs R X) (S : MMP.Mori.PrimeDivisor X) (hCS : C.coeff S = 0) :
    S.genericPoint ∉ C.supp := by
  intro h
  obtain ⟨E, hE, hSE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
  have := E.eq_genericPoint_of_mem_support hSE S.coheight_genericPoint
  have hES : S = E := AlgebraicGeometry.PrimeDivisor.genericPoint_injective this
  exact hE (hES ▸ hCS)

/-- The generic point of `X` lies outside the support of every divisor. -/
private theorem genericPoint_notMem_supp {R : Type*} [Zero R] (C : DivisorWithCoeffs R X) :
    genericPoint X ∉ C.supp := by
  intro h
  obtain ⟨E, -, hE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
  exact MMP.Threefold.Mori.CanonUniq.genericPoint_notMem_support E hE

/-- A set containing neither the generic point of `X` nor that of the prime divisor `H` contains
no stratum of `H`. -/
private theorem containsNoStratum_single (H : MMP.Mori.PrimeDivisor X) {T : Set X}
    (h1 : genericPoint X ∉ T) (h2 : H.genericPoint ∉ T) :
    ContainsNoStratum (Finsupp.single H (1 : ℤ) : Divisor X) T := by
  classical
  rintro S ⟨J, hJ, hmax⟩ hST
  rw [Finsupp.support_single_ne_zero _ one_ne_zero, Finset.subset_singleton_iff] at hJ
  rcases hJ with rfl | rfl
  · have hSu : S = Set.univ :=
      Set.eq_univ_of_univ_subset (hmax.2 ⟨IrreducibleSpace.isIrreducible_univ X, by simp⟩
        (Set.subset_univ _))
    exact h1 (hST (hSu ▸ Set.mem_univ _))
  · have hirr : IsIrreducible (H.support : Set X) := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
    have hsub : (H.support : Set X) ⊆ S :=
      hmax.2 ⟨hirr, by simp⟩ (by simpa using hmax.1.2)
    have hη : H.genericPoint ∈ (H.support : Set X) := by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
    exact h2 (hST (hsub hη))

variable {k : Type} [Field k]

/-- **The inductive step.** Let `X` be a smooth affine variety, `x` a closed point with
`mult_x D < 1`, and `H` a smooth prime divisor of `X` cut out at `x` by `h`, such that every
component of `D` through `x` has a local equation whose order does not increase modulo `h`.
If the closed-point assertion holds in lower dimension, then `(X, D)` is klt near `x`: the
adjoint restriction sequence lifts the unit of `𝒥_{0,D|_H}` (trivial near `x` by induction) to an
element of `𝒥_{H,D} ⊆ 𝒥_{0,D}` which is `1` along `H`, hence a unit at `x`. -/
private theorem exists_isKltOn_of_primeDivisor [IsAlgClosed k] [CharZero k]
    (sX : X ⟶ Spec (.of k)) [IsAffine X] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {D : QDivisor X} (hD : ∀ P, 0 ≤ D.coeff P) {x : X}
    (hx : IsClosed ({x} : Set X)) (hmult : D.multiplicityAt x < 1)
    (H : MMP.Mori.PrimeDivisor X) (hxH : x ∈ H.support) {h : X.presheaf.stalk x}
    (hH : IdealSheafData.stalk H.idealSheaf x = Ideal.span {h})
    (hHsm : IsSmoothScheme (H.idealSheaf.subschemeι ≫ sX))
    (hgood : ∀ P ∈ D.support, x ∈ P.support → ∃ π : X.presheaf.stalk x,
      IdealSheafData.stalk P.idealSheaf x = Ideal.span {π} ∧
        ∀ b, π - h * b ∉ maximalIdeal _ ^ (MMP.Flips.maximalIdealOrder _ π + 1))
    (ih : ∀ {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of k)) [IsIntegral Z] [IsLocallyNoetherian Z]
      [IsNormal Z] [IsAffine Z], IsNormalVariety k sZ → IsSmoothScheme sZ →
      topologicalKrullDim Z + 1 ≤ topologicalKrullDim X → ∀ D' : QDivisor Z,
      (∀ P, 0 ≤ D'.coeff P) → ∀ z : Z, IsClosed ({z} : Set Z) → D'.multiplicityAt z < 1 →
      ∃ V : Z.Opens, z ∈ V ∧ IsKltOn sZ D' V) :
    ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation sX :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
  haveI : Smooth sX := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  haveI : IsNoetherian X := {}
  haveI := H.integral
  haveI : AlgebraicGeometry.IsVariety k (H.idealSheaf.subschemeι ≫ sX) := ⟨⟩
  haveI : LocallyOfFiniteType (H.idealSheaf.subschemeι ≫ sX) := inferInstance
  haveI : LocallyOfFinitePresentation (H.idealSheaf.subschemeι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := H.idealSheaf.subschemeι ≫ sX)).mpr inferInstance
  haveI : IsLocallyNoetherian H.idealSheaf.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian (H.idealSheaf.subschemeι ≫ sX)
  haveI : IsNormal H.idealSheaf.subscheme :=
    isNormal_of_isRegular _ (MMP.Threefold.Resolution.isRegular_of_isSmoothScheme hHsm)
  haveI : Smooth (H.idealSheaf.subschemeι ≫ sX) :=
    MMP.Resolution.Aux.smooth_of_isSmoothScheme' _ hHsm
  haveI : IsAffine H.idealSheaf.subscheme := isAffine_of_isAffineHom H.idealSheaf.subschemeι
  have hHX : IsNormalVariety k (H.idealSheaf.subschemeι ≫ sX) := ⟨inferInstance, inferInstance⟩
  -- `H` is not a component of `D`
  have hDH : D.coeff H = 0 := by
    by_contra hne
    obtain ⟨π, hπ, hgπ⟩ := hgood H (Finsupp.mem_support_iff.2 hne) hxH
    rw [hH, Ideal.span_singleton_eq_span_singleton] at hπ
    obtain ⟨u, hu⟩ := hπ
    exact hgπ u (by rw [← hu, sub_self]; exact zero_mem _)
  -- the point of `H` over `x`
  obtain ⟨y, rfl⟩ : x ∈ Set.range H.idealSheaf.subschemeι := by
    rw [Scheme.IdealSheafData.range_subschemeι]; exact hxH
  have hy : IsClosed ({y} : Set H.idealSheaf.subscheme) :=
    isClosed_singleton_of_injective H.idealSheaf.subschemeι.continuous
      H.idealSheaf.subschemeι.isClosedEmbedding.injective hx
  -- the multiplicity of `D|_H` at `y`
  have hker : RingHom.ker (H.idealSheaf.subschemeι.stalkMap y).hom = Ideal.span {h} := by
    rw [Scheme.IdealSheafData.ker_stalkMap_subschemeι, Scheme.IdealSheafData.stalkIdeal_eq_stalk, hH]
  have hmultH : (D.restrictPrimeDivisor H).multiplicityAt y < 1 := by
    rw [DivisorWithCoeffs.restrictPrimeDivisor, multiplicityAt_restrict_eq sX hsm _ hHsm hD
      (DivisorWithCoeffs.coeff_restrictPrimeDivisor D H hDH) y hker hgood]
    exact hmult
  have hDS : ∀ Q, 0 ≤ (D.restrictPrimeDivisor H).coeff Q := fun Q => by
    rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D H hDH Q]
    exact Finsupp.sum_nonneg fun E _ => nsmul_nonneg (hD E) _
  -- the dimension of `H`
  have hdim : topologicalKrullDim H.idealSheaf.subscheme + 1 ≤ topologicalKrullDim X := by
    have e := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX H.genericPoint
    rw [H.coheight_genericPoint] at e
    have hrange : Set.range H.idealSheaf.subschemeι = closure {H.genericPoint} := by
      rw [Scheme.IdealSheafData.range_subschemeι, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    have e2 : topologicalKrullDim H.idealSheaf.subscheme =
        topologicalKrullDim (closure {H.genericPoint} : Set X) := by
      rw [← hrange]
      exact IsHomeomorph.topologicalKrullDim_eq _
        H.idealSheaf.subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph
    rw [e2, ← e]
    exact le_of_eq rfl
  -- the induction hypothesis on `H`
  obtain ⟨VH, hyVH, hVH⟩ := ih _ hHX hHsm hdim _ hDS y hy hmultH
  have hops := isReducedAdjointIdealOn_operations sX
  have hopsH := isReducedAdjointIdealOn_operations (H.idealSheaf.subschemeι ≫ sX)
  have hΔS : (Finsupp.single H 1 - Finsupp.single H 1 : Divisor X).restrictPrimeDivisor H = 0 := by
    rw [sub_self]; exact restrict_zero _
  obtain ⟨YS, μS, JS, hJS⟩ := hopsH.1
    ((Finsupp.single H 1 - Finsupp.single H 1 : Divisor X).restrictPrimeDivisor H)
    (D.restrictPrimeDivisor H) hHX hHsm (by rw [hΔS]; exact isReducedSNC_zero hHsm) hDS
    (by rw [hΔS]; exact containsNoStratum_zero (genericPoint_notMem_supp _))
  have hJS0 : IsReducedAdjointIdealOn (H.idealSheaf.subschemeι ≫ sX) 0
      (D.restrictPrimeDivisor H) μS JS := hΔS ▸ hJS
  haveI : Nonempty VH := ⟨⟨y, hyVH⟩⟩
  have hJS1 : (1 : H.idealSheaf.subscheme.functionField) ∈ JS VH := by
    rw [eq_range_of_isKltOn hJS0 hVH VH le_rfl]
    exact ⟨1, map_one _⟩
  -- the adjoint ideals on `X`
  have hsncH : IsReducedSNC sX (Finsupp.single H 1 : Divisor X) := by
    refine ⟨fun P => ?_, isSNC_of_subsingleton_support sX hsm _ (fun E hE F hF => ?_)
      (fun E hE => ?_)⟩
    · rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
      split_ifs <;> simp
    · rw [Finsupp.support_single_ne_zero _ one_ne_zero, Finset.mem_singleton] at hE hF
      rw [hE, hF]
    · rw [Finsupp.support_single_ne_zero _ one_ne_zero, Finset.mem_singleton] at hE
      rw [hE]; exact hHsm
  obtain ⟨Y, μ, J, hJ⟩ := hops.1 (Finsupp.single H 1) D hX hsm hsncH hD
    (containsNoStratum_single H (genericPoint_notMem_supp _)
      (genericPoint_notMem_supp_of_coeff_eq_zero _ H hDH))
  have hD' : ∀ P, 0 ≤ (D + Divisor.toQDivisor (Finsupp.single H 1)).coeff P := fun P => by
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have h1 : (0 : ℤ) ≤ DivisorWithCoeffs.coeff (R := ℤ) (Finsupp.single H (1 : ℤ)) P := by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> norm_num
    linarith [hD P, Int.cast_nonneg (R := ℚ) h1]
  obtain ⟨Y', μ', J', hJ'⟩ := hops.1 (Finsupp.single H 1 - Finsupp.single H 1)
    (D + Divisor.toQDivisor (Finsupp.single H 1)) hX hsm
    (by rw [sub_self]; exact isReducedSNC_zero hsm) hD'
    (by rw [sub_self]; exact containsNoStratum_zero (genericPoint_notMem_supp _))
  obtain ⟨Y0, μ0, J0, hJ0⟩ := hops.1 0 D hX hsm (isReducedSNC_zero hsm) hD
    (containsNoStratum_zero (genericPoint_notMem_supp _))
  obtain ⟨-, -, -, -, -, -, hYi, hYn, hYN, hμd, -, -, -, Γ, E, F, -, -, -, hJeq⟩ := id hJ
  obtain ⟨-, -, -, -, -, -, hYSi, hYSn, hYSN, hμSd, -, -, -, ΓS, ES, FS, -, -, -, hJSeq⟩ :=
    id hJS
  have hres := isReducedAdjointIdealOn_restriction_vanishing sX (𝟙 X)
    (isProjectiveMorphism_id X) (Finsupp.single H 1) D μ J hJ _ hJeq
  have hlift := (hres.2 H (by simp [DivisorWithCoeffs.coeff_apply]) μ' J' hJ' μS JS hJS _
    hJSeq).1.2.2.2
  -- the open subset of `X` cutting `VH` out of `H`
  let U : X.Opens := ⟨(H.idealSheaf.subschemeι '' (VH : Set _)ᶜ)ᶜ,
    (H.idealSheaf.subschemeι.isClosedEmbedding.isClosedMap _ VH.isOpen.isClosed_compl).isOpen_compl⟩
  have hU : H.idealSheaf.subschemeι ⁻¹ᵁ U = VH := by
    ext z
    change z ∉ H.idealSheaf.subschemeι ⁻¹' (H.idealSheaf.subschemeι '' (VH : Set _)ᶜ) ↔ z ∈ VH
    rw [Set.preimage_image_eq _ H.idealSheaf.subschemeι.isClosedEmbedding.injective]
    simp
  obtain ⟨V, hxV, hVU, g, hgJ, hgr⟩ :=
    hlift U 1 (by rw [hU]; exact hJS1) y (by rw [hU]; exact hyVH)
  have hg0 : g ∈ J0 V := hops.2.2.2.1 0 (Finsupp.single H 1) D D μ0 μ J0 J hJ0 hJ
    (Finsupp.single_nonneg.2 zero_le_one) (fun _ => le_rfl) V hgJ
  haveI : Nonempty V := ⟨⟨_, hxV⟩⟩
  obtain ⟨s, rfl⟩ := (hops.2.1 0 D μ0 J0 hJ0).1 V hg0
  -- the lift is a unit at `x`
  have hunit : IsUnit (X.presheaf.germ V (H.idealSheaf.subschemeι y) hxV s) := by
    obtain ⟨a, ha1, ha2⟩ := hgr
    have hηy : genericPoint H.idealSheaf.subscheme ⤳ y := genericPoint_specializes y
    have hιη : H.idealSheaf.subschemeι (genericPoint H.idealSheaf.subscheme) ∈ V :=
      (hηy.map H.idealSheaf.subschemeι.continuous).mem_open V.isOpen hxV
    have haeq : a = X.presheaf.germ V _ hιη s := by
      apply stalkSpecializes_injective
        (genericPoint_specializes (H.idealSheaf.subschemeι (genericPoint H.idealSheaf.subscheme)))
      rw [ha1, TopCat.Presheaf.germ_stalkSpecializes_apply]
    rw [haeq] at ha2
    have h3 : H.idealSheaf.subscheme.presheaf.stalkSpecializes hηy
        (H.idealSheaf.subschemeι.stalkMap y (X.presheaf.germ V _ hxV s)) = 1 := by
      rw [← Scheme.Hom.stalkSpecializes_stalkMap_apply, TopCat.Presheaf.germ_stalkSpecializes_apply]
      exact ha2
    have h4 : H.idealSheaf.subschemeι.stalkMap y (X.presheaf.germ V _ hxV s) = 1 :=
      stalkSpecializes_injective hηy (h3.trans (map_one _).symm)
    exact isUnit_of_map_unit (H.idealSheaf.subschemeι.stalkMap y).hom _
      (by rw [h4]; exact isUnit_one)
  have hxW : H.idealSheaf.subschemeι y ∈ X.basicOpen s := (X.mem_basicOpen s _ hxV).2 hunit
  haveI : Nonempty (X.basicOpen s) := ⟨⟨_, hxW⟩⟩
  refine ⟨X.basicOpen s, hxW, isKltOn_of_isUnit_mem hJ0 (X.basicOpen_le s)
    (RingedSpace.isUnit_res_basicOpen X.toRingedSpace s) ?_⟩
  convert hg0 using 1
  exact X.presheaf.germ_res_apply _ _ _ s

end Step

/-! ### Shrinking to a neighbourhood on which the hypersurface is smooth -/

section Shrink

open MMP.Intersection IsLocalRing

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The ideal of a prime divisor of an open subscheme at a point is the image of the ideal of
its closure. -/
private theorem stalk_primeDivisorMap {V : Scheme.{0}} (j : V ⟶ X) [IsOpenImmersion j]
    (E' : MMP.Mori.PrimeDivisor V) (v : V) :
    IdealSheafData.stalk E'.idealSheaf v = Ideal.map (j.stalkMap v).hom
      (IdealSheafData.stalk (OpenWeilRestriction.primeDivisorMap j E').idealSheaf (j v)) := by
  rw [← MMP.Threefold.Mori.OpenRestriction.stalk_comap_eq_map,
    MMP.Threefold.Mori.OpenRestriction.idealSheaf_comap_primeDivisorMap]

/-- A point of an open subscheme lies on a prime divisor exactly when its image lies on the
closure. -/
private theorem mem_support_primeDivisorMap_iff {V : Scheme.{0}} (j : V ⟶ X)
    [IsOpenImmersion j] (E' : MMP.Mori.PrimeDivisor V) (v : V) :
    v ∈ E'.support ↔ j v ∈ (OpenWeilRestriction.primeDivisorMap j E').support := by
  have hiso : IsIso (j.stalkMap v) := (IsOpenImmersion.iff_isIso_stalkMap.mp ‹_›).2 v
  have hbij := ConcreteCategory.bijective_of_isIso (j.stalkMap v)
  change v ∈ E'.idealSheaf.support ↔
    j v ∈ (OpenWeilRestriction.primeDivisorMap j E').idealSheaf.support
  rw [← Stacks.Divisors.stalk_le_maximalIdeal_iff_mem_support,
    ← Stacks.Divisors.stalk_le_maximalIdeal_iff_mem_support, stalk_primeDivisorMap j E' v]
  have := map_le_pow_maximalIdeal_iff (j.stalkMap v).hom hbij
    (IdealSheafData.stalk (OpenWeilRestriction.primeDivisorMap j E').idealSheaf (j v)) 1
  simpa only [pow_one] using this

/-- Orders are invariant under ring isomorphisms of local rings. -/
private theorem maximalIdealOrder_map_of_bijective {R S : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (e : R →+* S)
    (he : Function.Bijective e) {π : R} (hπ : π ≠ 0) :
    MMP.Flips.maximalIdealOrder S (e π) = MMP.Flips.maximalIdealOrder R π := by
  refine maximalIdealOrder_map_of_surjective e he.2 (h := 0) ?_ hπ fun b hb => ?_
  · rw [Ideal.span_singleton_eq_bot.mpr rfl]
    exact (RingHom.injective_iff_ker_eq_bot e).mp he.1
  · exact (MMP.Flips.maximalIdealOrder_spec hπ).2 (by simpa using hb)

variable {k : Type} [Field k]

/-- A prime divisor of an open subscheme whose closure has regular local rings (modulo its
ideal) at all of its points is smooth. -/
private theorem isSmoothScheme_of_primeDivisorMap [PerfectField k] {W : Scheme.{0}}
    (j : W ⟶ X) [IsOpenImmersion j] (sW : W ⟶ Spec (.of k)) (HW : MMP.Mori.PrimeDivisor W)
    [IsIntegral HW.idealSheaf.subscheme]
    [LocallyOfFiniteType (HW.idealSheaf.subschemeι ≫ sW)]
    [LocallyOfFinitePresentation (HW.idealSheaf.subschemeι ≫ sW)]
    (hreg : ∀ w ∈ HW.support, IsRegularLocalRing (X.presheaf.stalk (j w) ⧸
      IdealSheafData.stalk (OpenWeilRestriction.primeDivisorMap j HW).idealSheaf (j w))) :
    IsSmoothScheme (HW.idealSheaf.subschemeι ≫ sW) := by
  refine (MMP.Mori.isSmoothScheme_iff _).mpr
    ((MMP.Flips.ResolutionInputs.smooth_iff_forall_isRegularLocalRing_stalk _).mpr fun z => ?_)
  have hw : HW.idealSheaf.subschemeι z ∈ HW.support := by
    show HW.idealSheaf.subschemeι z ∈ (HW.idealSheaf.support : Set W)
    rw [← Scheme.IdealSheafData.range_subschemeι]; exact ⟨z, rfl⟩
  haveI := hreg _ hw
  have hisow : IsIso (j.stalkMap (HW.idealSheaf.subschemeι z)) :=
    (IsOpenImmersion.iff_isIso_stalkMap (f := j)).mp inferInstance |>.2 _
  have hbijw := ConcreteCategory.bijective_of_isIso (j.stalkMap (HW.idealSheaf.subschemeι z))
  have hIJ : IdealSheafData.stalk HW.idealSheaf (HW.idealSheaf.subschemeι z) =
      (IdealSheafData.stalk (OpenWeilRestriction.primeDivisorMap j HW).idealSheaf
        (j (HW.idealSheaf.subschemeι z))).map (RingEquiv.ofBijective _ hbijw) :=
    stalk_primeDivisorMap j HW _
  exact IsRegularLocalRing.of_ringEquiv ((Ideal.quotientEquiv _ _ _ hIJ).trans
    (stalkSubschemeEquiv HW.idealSheaf z))

/-- Transport of the order condition on local equations along an isomorphism of local rings. -/
private theorem sub_mul_notMem_of_bijective {R S : Type*} [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (e : R →+* S)
    (he : Function.Bijective e) {π h : R} (hπ : π ≠ 0)
    (hgood : ∀ b, π - h * b ∉ maximalIdeal R ^ (MMP.Flips.maximalIdealOrder R π + 1)) :
    ∀ b, e π - e h * b ∉ maximalIdeal S ^ (MMP.Flips.maximalIdealOrder S (e π) + 1) := by
  intro b
  obtain ⟨b₀, rfl⟩ := he.2 b
  rw [maximalIdealOrder_map_of_bijective e he hπ]
  intro hmem
  apply hgood b₀
  rw [← map_mul, ← map_sub] at hmem
  have hle := (map_le_pow_maximalIdeal_iff e he (Ideal.span {π - h * b₀}) _).1 (by
    rw [Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff]
    exact hmem)
  exact hle (Ideal.mem_span_singleton_self _)

/-- **Shrinking to a smooth hypersurface.** Let `X` be a smooth affine variety, `x` a closed point
with `mult_x D < 1` at which `𝒪_{X,x}` has dimension at least two. If the closed-point assertion
holds in lower dimension, then `(X, D)` is klt near `x`. A linear parameter `h` at `x` keeping the
orders of local equations of the components of `D` cuts out a prime divisor `H₀` which is smooth
at `x`; on an affine neighbourhood of `x` avoiding the singular points of `H₀`, the inductive step
applies. -/
private theorem exists_isKltOn_of_two_le [IsAlgClosed k] [CharZero k]
    (sX : X ⟶ Spec (.of k)) [IsAffine X] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {D : QDivisor X} (hD : ∀ P, 0 ≤ D.coeff P) {x : X}
    (hx : IsClosed ({x} : Set X)) (hmult : D.multiplicityAt x < 1)
    (h2 : 2 ≤ (maximalIdeal (X.presheaf.stalk x)).spanFinrank)
    (ih : ∀ {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of k)) [IsIntegral Z] [IsLocallyNoetherian Z]
      [IsNormal Z] [IsAffine Z], IsNormalVariety k sZ → IsSmoothScheme sZ →
      topologicalKrullDim Z + 1 ≤ topologicalKrullDim X → ∀ D' : QDivisor Z,
      (∀ P, 0 ≤ D'.coeff P) → ∀ z : Z, IsClosed ({z} : Set Z) → D'.multiplicityAt z < 1 →
      ∃ V : Z.Opens, z ∈ V ∧ IsKltOn sZ D' V) :
    ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : Smooth sX := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
  haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  -- local equations of the components through `x`
  have hπ : ∀ P : MMP.Mori.PrimeDivisor X, ∃ π : X.presheaf.stalk x,
      x ∈ P.support → Prime π ∧ IdealSheafData.stalk P.idealSheaf x = Ideal.span {π} := by
    intro P
    by_cases hP : x ∈ P.support
    · obtain ⟨π, hπ, hπP⟩ := MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sX hsm P hP
      exact ⟨π, fun _ => ⟨hπ, hπP⟩⟩
    · exact ⟨1, fun h => absurd h hP⟩
  choose π hπ using hπ
  -- a linear parameter keeping their orders
  haveI : Infinite (X.presheaf.stalk x ⧸ maximalIdeal (X.presheaf.stalk x)) := by
    letI := MMP.Mori.stalkAlgebra sX x
    haveI : Infinite k := inferInstance
    exact Infinite.of_injective
      ((Ideal.Quotient.mk (maximalIdeal (X.presheaf.stalk x))).comp
        (algebraMap k (X.presheaf.stalk x))) (RingHom.injective _)
  obtain ⟨h, hhm, hh2, hgood⟩ := exists_notMem_sq_forall_sub_mul_notMem h2
    (D.support.filter fun P => x ∈ P.support) π
    (fun P hP => (hπ P (Finset.mem_filter.1 hP).2).1.ne_zero)
  have hreg : IsRegularLocalRing (X.presheaf.stalk x ⧸ Ideal.span {h}) :=
    Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton hhm hh2
  have hprime : Prime h := by
    have h0 : h ≠ 0 := by rintro rfl; exact hh2 (zero_mem _)
    have : (Ideal.span {h}).IsPrime := by
      haveI := IsRegularLocalRing.isDomain (X.presheaf.stalk x ⧸ Ideal.span {h})
      exact (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
    exact (Ideal.span_singleton_prime h0).mp this
  -- the prime divisor `H₀` cut out by `h`
  obtain ⟨H₀, hxH₀, hH₀⟩ := exists_primeDivisor_stalk_eq_span x hprime
  haveI := H₀.integral
  haveI : AlgebraicGeometry.IsVariety k (H₀.idealSheaf.subschemeι ≫ sX) := ⟨⟩
  haveI : LocallyOfFiniteType (H₀.idealSheaf.subschemeι ≫ sX) := inferInstance
  -- the closed set of the non-regular points of `H₀`
  obtain ⟨R₀, hR₀def⟩ : ∃ R₀ : Set H₀.idealSheaf.subscheme,
      R₀ = {z | IsRegularLocalRing (H₀.idealSheaf.subscheme.presheaf.stalk z)} := ⟨_, rfl⟩
  have hR₀ : IsOpen R₀ := by
    rw [hR₀def, ← smoothAt_locus_eq_regular_locus k (H₀.idealSheaf.subschemeι ≫ sX)]
    exact isOpen_smoothAt_locus _
  obtain ⟨B, hBdef⟩ : ∃ B : Set X, B = H₀.idealSheaf.subschemeι '' R₀ᶜ := ⟨_, rfl⟩
  have hB : IsClosed B := hBdef ▸
    H₀.idealSheaf.subschemeι.isClosedEmbedding.isClosedMap _ hR₀.isClosed_compl
  -- off `B`, the local rings of `H₀` are regular
  have hregAt : ∀ x₀ : X, x₀ ∈ H₀.support → x₀ ∉ B →
      IsRegularLocalRing (X.presheaf.stalk x₀ ⧸ IdealSheafData.stalk H₀.idealSheaf x₀) := by
    intro x₀ hx₀ hx₀B
    obtain ⟨z₀, rfl⟩ : x₀ ∈ Set.range H₀.idealSheaf.subschemeι := by
      rw [Scheme.IdealSheafData.range_subschemeι]; exact hx₀
    have hz₀ : z₀ ∈ R₀ := by
      by_contra hz
      exact hx₀B (hBdef ▸ ⟨z₀, hz, rfl⟩)
    haveI : IsRegularLocalRing (H₀.idealSheaf.subscheme.presheaf.stalk z₀) := by
      rw [hR₀def] at hz₀; exact hz₀
    exact IsRegularLocalRing.of_ringEquiv (stalkSubschemeEquiv H₀.idealSheaf z₀).symm
  have hxB : x ∉ B := by
    rw [hBdef]
    rintro ⟨z, hz, hzx⟩
    apply hz
    rw [hR₀def]
    obtain ⟨z₀, rfl⟩ : x ∈ Set.range H₀.idealSheaf.subschemeι := by
      rw [Scheme.IdealSheafData.range_subschemeι]; exact hxH₀
    obtain rfl := H₀.idealSheaf.subschemeι.isClosedEmbedding.injective hzx
    exact IsRegularLocalRing.of_ringEquiv ((Ideal.quotEquivOfEq hH₀.symm).trans
      (stalkSubschemeEquiv H₀.idealSheaf z))
  -- an affine neighbourhood `W` of `x` avoiding `B`
  obtain ⟨W, hW, hxW, hWB⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := x)
    (U := ⟨Bᶜ, hB.isOpen_compl⟩) hxB
  haveI : IsAffine W := hW
  haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
  obtain ⟨x', rfl⟩ : ∃ x' : W.toScheme, W.ι x' = x := ⟨⟨x, hxW⟩, rfl⟩
  have hiso : IsIso (W.ι.stalkMap x') :=
    (IsOpenImmersion.iff_isIso_stalkMap (f := W.ι)).mp inferInstance |>.2 x'
  have hebij := ConcreteCategory.bijective_of_isIso (W.ι.stalkMap x')
  -- the prime divisor `HW` of `W` with ideal `(e h)` at `x'`
  have hprimeW : Prime ((W.ι.stalkMap x').hom h) :=
    (MulEquiv.prime_iff (RingEquiv.ofBijective _ hebij)).mpr hprime
  obtain ⟨HW, hx'HW, hHW⟩ := exists_primeDivisor_stalk_eq_span (X := W.toScheme) x' hprimeW
  have hmapHW : OpenWeilRestriction.primeDivisorMap W.ι HW = H₀ := by
    refine primeDivisor_eq_of_stalk_eq ((mem_support_primeDivisorMap_iff W.ι HW x').1 hx'HW)
      hxH₀ ?_
    have h1 := stalk_primeDivisorMap W.ι HW x'
    rw [hHW] at h1
    have h2 := congrArg (Ideal.comap (W.ι.stalkMap x').hom) h1
    rw [Ideal.comap_map_of_bijective _ hebij] at h2
    rw [← h2, hH₀]
    have h3 : Ideal.span {(W.ι.stalkMap x').hom h} = (Ideal.span {h}).map (W.ι.stalkMap x').hom := by
      rw [Ideal.map_span, Set.image_singleton]
    rw [h3, Ideal.comap_map_of_bijective _ hebij]
  -- `HW` is smooth
  haveI := HW.integral
  haveI : AlgebraicGeometry.IsVariety k (W.ι ≫ sX) := (MMP.Mori.isNormalVariety_ι hX W).1
  haveI : AlgebraicGeometry.IsVariety k (HW.idealSheaf.subschemeι ≫ W.ι ≫ sX) := ⟨⟩
  haveI : LocallyOfFiniteType (HW.idealSheaf.subschemeι ≫ W.ι ≫ sX) := inferInstance
  haveI : LocallyOfFinitePresentation (HW.idealSheaf.subschemeι ≫ W.ι ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType
      (f := HW.idealSheaf.subschemeι ≫ W.ι ≫ sX)).mpr inferInstance
  have hHWsm : IsSmoothScheme (HW.idealSheaf.subschemeι ≫ W.ι ≫ sX) := by
    refine isSmoothScheme_of_primeDivisorMap W.ι _ HW fun w hw => ?_
    rw [hmapHW]
    refine hregAt _ ?_ fun hm => hWB w.2 hm
    rw [← hmapHW]; exact (mem_support_primeDivisorMap_iff W.ι HW w).1 hw
  -- the divisor on `W`
  have hres := MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen W D
  have hDW : ∀ P, 0 ≤ (inverseTransformDivisor W.ι D).coeff P := fun P => by
    rw [hres, DivisorWithCoeffs.coeff_restrictOpen]; exact hD _
  have hx'c : IsClosed ({x'} : Set W.toScheme) :=
    isClosed_singleton_of_injective W.ι.continuous W.ι.isOpenEmbedding.injective hx
  have hmultW : (inverseTransformDivisor W.ι D).multiplicityAt x' < 1 := by
    rw [hres]
    exact (multiplicityAt_restrictOpen W D x').trans_lt hmult
  obtain ⟨V, hx'V, hV⟩ := exists_isKltOn_of_primeDivisor (W.ι ≫ sX)
    (MMP.Mori.isNormalVariety_ι hX W) (MMP.Threefold.Resolution.isSmoothScheme_ι k hsm W) hDW
    hx'c hmultW HW hx'HW hHW hHWsm (fun PW hPW hx'PW => by
      have hP : OpenWeilRestriction.primeDivisorMap W.ι PW ∈ D.support := by
        rw [hres, Finsupp.mem_support_iff] at hPW
        rw [Finsupp.mem_support_iff]
        intro h0
        apply hPW
        change (D.restrictOpen W).coeff PW = 0
        rw [DivisorWithCoeffs.coeff_restrictOpen]
        exact h0
      have hxP := (mem_support_primeDivisorMap_iff W.ι PW x').1 hx'PW
      obtain ⟨hπp, hπP⟩ := hπ _ hxP
      refine ⟨(W.ι.stalkMap x').hom (π (OpenWeilRestriction.primeDivisorMap W.ι PW)), ?_,
        sub_mul_notMem_of_bijective _ hebij hπp.ne_zero
          (hgood _ (Finset.mem_filter.2 ⟨hP, hxP⟩))⟩
      rw [stalk_primeDivisorMap W.ι PW x', hπP, Ideal.map_span, Set.image_singleton])
    (fun sZ _ _ _ _ hZ hZs hZd => ih sZ hZ hZs (hZd.trans (topologicalKrullDim_subspace_le X W)))
  exact ⟨W.ι ''ᵁ V, ⟨x', hx'V, rfl⟩, isKltOn_image_of_isKltOn_restrict hX hsm hD W hV⟩

end Shrink

/-! ### Points of codimension at most one -/

section Base

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  {k : Type} [Field k]

/-- **The base case.** At a closed point `x` at which `𝒪_{X,x}` has dimension at most one, `X`
itself has dimension at most one; every divisor over `X` is then a prime divisor of `X`, of log
discrepancy `1 - coeff_P D`. So `(X, D)` is klt near `x` whenever `mult_x D < 1`. -/
private theorem exists_isKltOn_of_ringKrullDim_le_one [IsAlgClosed k] [CharZero k]
    (sX : X ⟶ Spec (.of k)) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    {D : QDivisor X} (hD : ∀ P, 0 ≤ D.coeff P) {x : X} (hx : IsClosed ({x} : Set X))
    (hmult : D.multiplicityAt x < 1)
    (h1 : (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).spanFinrank ≤ 1) :
    ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : Smooth sX := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  haveI := isRegularLocalRing_stalk_of_smooth_over_field sX x
  -- `X` has dimension at most one
  have hcx : Order.coheight x ≤ 1 := by
    have e := ringKrullDim_stalk_eq_coheight x
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal] at e
    have : ((Order.coheight x : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞) := by
      rw [← e]; exact_mod_cast h1
    exact_mod_cast this
  have hdimX : topologicalKrullDim X ≤ 1 := by
    have e := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX x
    rw [hx.closure_eq] at e
    have h0 := topologicalKrullDim_zero_of_discreteTopology ({x} : Set X)
    rw [← e]
    calc _ ≤ (0 : WithBot ℕ∞) + ((1 : ℕ∞) : WithBot ℕ∞) :=
          add_le_add h0 (by exact_mod_cast hcx)
      _ = 1 := by simp
  -- the components of `D` with coefficient at least one
  set T : Finset (MMP.Mori.PrimeDivisor X) := D.support.filter fun P => 1 ≤ D.coeff P
  have hC : IsClosed (⋃ P ∈ T, (P.support : Set X)) :=
    Set.Finite.isClosed_biUnion (Finset.finite_toSet T) fun P _ => P.idealSheaf.support.isClosed
  have hxC : x ∉ ⋃ P ∈ T, (P.support : Set X) := by
    simp only [Set.mem_iUnion]
    rintro ⟨P, hPT, hxP⟩
    obtain ⟨hPD, hP1⟩ := Finset.mem_filter.1 hPT
    obtain ⟨π, hπ, hπP⟩ := MMP.Resolution.Aux.exists_prime_stalk_idealSheaf sX hsm P hxP
    have hπm : π ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      (Stacks.Divisors.stalk_le_maximalIdeal_iff_mem_support _ _).2 hxP
        (hπP ▸ Ideal.mem_span_singleton_self π)
    have hord : 1 ≤ MMP.Flips.maximalIdealOrder _ π := by
      by_contra h0
      push Not at h0
      have := (MMP.Flips.maximalIdealOrder_spec hπ.ne_zero).2
      rw [show MMP.Flips.maximalIdealOrder _ π = 0 by omega, zero_add, pow_one] at this
      exact this hπm
    have hmP : 1 ≤ (P.multiplicityAt x).toNat := by
      rw [MMP.Mori.PrimeDivisor.multiplicityAt_eq_localMultiplicity P
        (by rw [Scheme.IdealSheafData.stalkIdeal_eq_stalk]; exact hπP), localMultiplicity_eq_maximalIdealOrder hπ.ne_zero,
        ENat.toNat_coe]
      exact hord
    have hle : (P.multiplicityAt x).toNat • D P ≤ D.multiplicityAt x := by
      unfold DivisorWithCoeffs.multiplicityAt
      rw [Finsupp.sum]
      exact Finset.single_le_sum (f := fun Q => (Q.multiplicityAt x).toNat • D Q)
        (fun Q _ => nsmul_nonneg (hD Q) _) hPD
    have : (1 : ℚ) ≤ (P.multiplicityAt x).toNat • D P := by
      rw [nsmul_eq_mul]
      have h1' : (1 : ℚ) ≤ ((P.multiplicityAt x).toNat : ℚ) := by exact_mod_cast hmP
      have hP1' : (1 : ℚ) ≤ D P := hP1
      nlinarith
    linarith
  refine ⟨⟨(⋃ P ∈ T, (P.support : Set X))ᶜ, hC.isOpen_compl⟩, hxC, ?_⟩
  intro n F a hF ha
  -- the centre of `F` is a point of codimension one
  have hne := map_genericPoint_ne_genericPoint F
  have hc0 : Order.coheight (F.f F.E.genericPoint) ≠ 0 := by
    intro h0
    have hsp : genericPoint X ⤳ F.f F.E.genericPoint :=
      (genericPoint_spec X).specializes trivial
    exact hne (Specializes.antisymm ((Order.coheight_eq_zero.1 h0) hsp) hsp).eq
  have hcle : Order.coheight (F.f F.E.genericPoint) ≤ 1 := by
    have e := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX (F.f F.E.genericPoint)
    obtain ⟨z⟩ : Nonempty (closure {F.f F.E.genericPoint} : Set X) :=
      ⟨⟨_, subset_closure rfl⟩⟩
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds (closure {F.f F.E.genericPoint} : Set X)) :=
      ⟨⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim (closure {F.f F.E.genericPoint} : Set X) :=
      Order.krullDim_nonneg
    have h' := e.le.trans hdimX
    generalize topologicalKrullDim (closure {F.f F.E.genericPoint} : Set X) = d at h0 h'
    induction d using WithBot.recBotCoe with
    | bot => exact absurd h0 (by simp)
    | coe m =>
      have : m + Order.coheight (F.f F.E.genericPoint) ≤ 1 := by exact_mod_cast h'
      exact le_trans le_add_self this
  have hc1 : Order.coheight (F.f F.E.genericPoint) = 1 := by
    generalize Order.coheight (F.f F.E.genericPoint) = c at hc0 hcle ⊢
    induction c using ENat.recTopCoe with
    | top => exact absurd hcle (by simp)
    | coe m =>
      have : m ≤ 1 := by exact_mod_cast hcle
      have : m ≠ 0 := by exact_mod_cast hc0
      exact_mod_cast (by omega : m = 1)
  set P := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hc1
  have hPg : P.genericPoint = F.f F.E.genericPoint :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hc1
  have hval := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq hX F P hPg.symm
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  have haP := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn D P
  have hea := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha haP hval
  -- the coefficient of `P` is less than one
  have hP1 : D.coeff P < 1 := by
    by_contra hge
    push Not at hge
    apply hF
    have hPD : P ∈ D.support := by
      rw [Finsupp.mem_support_iff]
      intro h0
      have : D.coeff P = 0 := h0
      rw [this] at hge
      exact absurd hge (by norm_num)
    simp only [Set.mem_iUnion]
    refine ⟨P, Finset.mem_filter.2 ⟨hPD, hge⟩, ?_⟩
    rw [← hPg, AlgebraicGeometry.PrimeDivisor.support_eq_closure]
    exact subset_closure rfl
  rw [hea]
  have : ((D.coeff P : ℚ) : ℝ) < 1 := by exact_mod_cast hP1
  linarith

end Base

/-! ### The closed-point and generic-point assertions -/

section Assembly

variable {k : Type} [Field k]

/-- **The closed-point assertion on an affine variety, given lower dimensions.** The two cases
`dim 𝒪_{X,x} ≤ 1` and `dim 𝒪_{X,x} ≥ 2`. -/
private theorem exists_isKltOn_of_isAffine_of_ih [IsAlgClosed k] [CharZero k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [IsAffine X]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) {x : X} (hx : IsClosed ({x} : Set X))
    (hmult : D.multiplicityAt x < 1)
    (ih : ∀ {Z : Scheme.{0}} (sZ : Z ⟶ Spec (.of k)) [IsIntegral Z] [IsLocallyNoetherian Z]
      [IsNormal Z] [IsAffine Z], IsNormalVariety k sZ → IsSmoothScheme sZ →
      topologicalKrullDim Z + 1 ≤ topologicalKrullDim X → ∀ D' : QDivisor Z,
      (∀ P, 0 ≤ D'.coeff P) → ∀ z : Z, IsClosed ({z} : Set Z) → D'.multiplicityAt z < 1 →
      ∃ V : Z.Opens, z ∈ V ∧ IsKltOn sZ D' V) :
    ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  by_cases h2 : 2 ≤ (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).spanFinrank
  · exact exists_isKltOn_of_two_le sX hX hsm hD hx hmult h2 ih
  · exact exists_isKltOn_of_ringKrullDim_le_one sX hX hsm hD hx hmult (by omega)

/-- `d + 1 ≤ N + 1` gives `d ≤ N` for dimensions. -/
private theorem le_of_add_one_le_natCast_succ {d : WithBot ℕ∞} {N : ℕ}
    (h : d + 1 ≤ ((N + 1 : ℕ) : WithBot ℕ∞)) : d ≤ N := by
  induction d using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe n =>
    have h' : n + 1 ≤ ((N + 1 : ℕ) : ℕ∞) := by exact_mod_cast h
    induction n using ENat.recTopCoe with
    | top => simp at h'
    | coe m => norm_cast at h' ⊢; omega

/-- A nonempty space does not have dimension `≤ -1`. -/
private theorem not_topologicalKrullDim_add_one_le_zero (Z : Type*) [TopologicalSpace Z]
    [Nonempty Z] : ¬ topologicalKrullDim Z + 1 ≤ ((0 : ℕ) : WithBot ℕ∞) := by
  obtain ⟨z⟩ : Nonempty Z := inferInstance
  haveI : Nonempty (TopologicalSpace.IrreducibleCloseds Z) :=
    ⟨⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
  have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim Z := Order.krullDim_nonneg
  intro h
  generalize topologicalKrullDim Z = d at h0 h
  induction d using WithBot.recBotCoe with
  | bot => simp at h0
  | coe n =>
    have h' : n + 1 ≤ ((0 : ℕ) : ℕ∞) := by exact_mod_cast h
    simp at h'

/-- **The closed-point assertion on an affine variety**, by induction on the dimension. -/
private theorem exists_isKltOn_of_isAffine [IsAlgClosed k] [CharZero k] (N : ℕ) :
    ∀ {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X]
      [IsNormal X] [IsAffine X], IsNormalVariety k sX → IsSmoothScheme sX →
      topologicalKrullDim X ≤ N → ∀ (D : QDivisor X), (∀ P, 0 ≤ D.coeff P) →
      ∀ x : X, IsClosed ({x} : Set X) → D.multiplicityAt x < 1 →
      ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  induction N with
  | zero =>
    intro X sX _ _ _ _ hX hsm hdim D hD x hx hmult
    exact exists_isKltOn_of_isAffine_of_ih sX hX hsm hD hx hmult fun {Z} _ _ _ _ _ _ _ hZ =>
      absurd (hZ.trans hdim) (not_topologicalKrullDim_add_one_le_zero Z)
  | succ N ih =>
    intro X sX _ _ _ _ hX hsm hdim D hD x hx hmult
    exact exists_isKltOn_of_isAffine_of_ih sX hX hsm hD hx hmult fun sZ _ _ _ _ hZ hZs hZd =>
      ih sZ hZ hZs (le_of_add_one_le_natCast_succ (hZd.trans hdim))

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X]
  [IsNormal X]

/-- **The closed-point assertion.** -/
private theorem exists_isKltOn_of_isClosed [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) {x : X} (hx : IsClosed ({x} : Set X))
    (hmult : D.multiplicityAt x < 1) : ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤)
    (by simp)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  haveI : IsAffine U := hU
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  obtain ⟨N, hN⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hdimU : topologicalKrullDim U ≤ N := by
    rw [← hN]
    exact topologicalKrullDim_subspace_le X U
  set x' : U := ⟨x, hxU⟩
  have hx' : IsClosed ({x'} : Set U) :=
    isClosed_singleton_of_injective U.ι.continuous U.ι.isOpenEmbedding.injective hx
  have hres := MMP.Mori.inverseTransformDivisor_ι_eq_restrictOpen U D
  have hD' : ∀ P, 0 ≤ (inverseTransformDivisor U.ι D).coeff P := fun P => by
    rw [hres, DivisorWithCoeffs.coeff_restrictOpen]; exact hD _
  obtain ⟨V, hxV, hV⟩ := exists_isKltOn_of_isAffine N (U.ι ≫ sX) (MMP.Mori.isNormalVariety_ι hX U)
    (MMP.Threefold.Resolution.isSmoothScheme_ι k hsm U) hdimU (inverseTransformDivisor U.ι D) hD' x'
    hx' (by rw [hres, multiplicityAt_restrictOpen]; exact hmult)
  refine ⟨U.ι ''ᵁ V, ⟨x', hxV, rfl⟩, isKltOn_image_of_isKltOn_restrict hX hsm hD U hV⟩

/-- **The generic-point assertion.** If `mult_x D < 1` at a point `x`, then `(X, D)` is klt at
the points of a neighbourhood of `x`. -/
private theorem exists_isKltOn [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ P, 0 ≤ D.coeff P) (x : X) (hmult : D.multiplicityAt x < 1) :
    ∃ V : X.Opens, x ∈ V ∧ IsKltOn sX D V := by
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : Smooth sX := MMP.Resolution.Aux.smooth_of_isSmoothScheme' sX hsm
  obtain ⟨U, hxU, μ, hμ, hU⟩ := exists_opens_forall_multiplicityAt_le hsm hD hmult
  -- a closed point of `X` in `closure {x} ∩ U`
  obtain ⟨p, ⟨hpx, hpU⟩, hp⟩ : ∃ p, (p ∈ closure ({x} : Set X) ∧ p ∈ U) ∧
      IsClosed ({p} : Set X) := by
    haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
    obtain ⟨p, hp, hpc⟩ := nonempty_inter_closedPoints (Z := closure {x} ∩ (U : Set X))
      ⟨x, subset_closure rfl, hxU⟩ (isClosed_closure.isLocallyClosed.inter U.isOpen.isLocallyClosed)
    exact ⟨p, hp, mem_closedPoints_iff.mp hpc⟩
  obtain ⟨V, hpV, hV⟩ := exists_isKltOn_of_isClosed hX hsm hD hp ((hU p hpU).trans_lt hμ)
  exact ⟨V, (specializes_iff_mem_closure.mpr hpx).mem_open V.isOpen hpV, hV⟩

end Assembly

/-! ### The theorem -/

end Proof_lem_mmp_adjoint_small_multiplicity_unit

end

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_mmp_adjoint_small_multiplicity_unit
open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise
open MMP.Mori MMP.Fourfold
open MMP.Fourfold

/-- **Small multiplicity makes the boundary-zero adjoint ideal trivial.** Let `X` be a smooth
variety over an algebraically closed field `k` of characteristic zero and `D` an effective
`ℚ`-divisor, and let `J = 𝒥_{0,D}` be the adjoint ideal with zero boundary, computed on a log
resolution `μ` (`MMP.Fourfold.IsReducedAdjointIdealOn`). If `mult_x D < 1` at a point `x` (for
instance the generic point of an irreducible subvariety `W` with `mult_W D < 1`, or a closed
point), then `J` agrees with `𝒪_X` on an open neighbourhood of `x`; in particular
`(𝒥_{0,D})_x = 𝒪_{X,x}`. -/
@[mmp "lem_mmp_adjoint_small_multiplicity_unit"]
public theorem IsReducedAdjointIdealOn.exists_nhds_eq_range_germToFunctionField_of_multiplicityAt_lt_one
    {k : Type} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] (D : QDivisor X) {Y : Scheme.{0}}
    (μ : Y ⟶ X) (J : X.Opens → Set X.functionField) (hJ : IsReducedAdjointIdealOn sX 0 D μ J)
    (x : X) (hx : D.multiplicityAt x < 1) :
    ∃ U : X.Opens, x ∈ U ∧
      ∀ (V : X.Opens) [Nonempty V], V ≤ U → J V = Set.range (X.germToFunctionField V) := by
  obtain ⟨hX, hsm, -, hD, -⟩ := id hJ
  obtain ⟨U, hxU, hU⟩ := exists_isKltOn hX hsm hD x hx
  exact ⟨U, hxU, fun V _ hVU => eq_range_of_isKltOn hJ hU V hVU⟩

end MMP.Fourfold

end

/-! ### `lem_fourfold_asymptotic_adjoint_extension` -/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

namespace Proof_lem_fourfold_asymptotic_adjoint_extension

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

noncomputable section

/-! ## Toolkit: the valuative description of reduced-boundary adjoint ideals -/

/-! ### Log discrepancies under adding a Cartier divisor, and valuative bounds -/

section Toolkit

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- Adding `c • C` to the boundary, for a Cartier divisor `C` with pull-back `C'` along the model,
lowers a log discrepancy by `c` times the coefficient of `C'` along the divisor. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {C : Divisor X}
    (hC : C.IsCartier) (c : ℝ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + c • Divisor.toRDivisor C) F
        (a - c * (C'.coeff F.E : ℝ)) := by
  classical
  intro C' hCs hC'
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₁, C₁', hC₁, hrel, hpb, ha⟩ := h
  refine ⟨hnv, hprop, ω, hω0, hK, m + 1, Fin.snoc r c, Fin.snoc C₁ C, Fin.snoc C₁' C', ?_, ?_,
    ?_, ?_⟩
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using hC
    · simpa using hC₁ j
  · intro Γ
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, DivisorWithCoeffs.coeff_add, ← hrel Γ,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    ring
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · refine ⟨by simpa using hCs, ?_⟩
      simpa using hC'
    · simpa using hpb j
  · rw [Fin.sum_univ_castSucc, ha]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    ring

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- Log discrepancies exist on a smooth variety, at the index `n = dim X`. -/
private theorem exists_isLogDiscrepancy [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (F : DivisorOver k sX) (hF : IsProper F.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) F a := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK F
  exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hF⟩

/-- Adding a `ℚ`-divisor `D` with a Cartier multiple `D₀ = mD` lowers a log discrepancy by
`1/m` times the coefficient of the pull-back of `D₀`. -/
private theorem isLogDiscrepancy_add_of_zsmul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {D : QDivisor X} {m : ℕ}
    (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (D₀' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ D₀.supp), D₀.IsPullback F.f hCs D₀' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + QDivisor.toRDivisor D) F
        (a - (D₀'.coeff F.E : ℝ) / m) := by
  intro D₀' hCs hpb
  have h1 := isLogDiscrepancy_add_smul h hD₀c (1 / (m : ℝ)) D₀' hCs hpb
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : B + (1 / (m : ℝ)) • Divisor.toRDivisor D₀ = B + QDivisor.toRDivisor D := by
    congr 1
    refine Finsupp.ext fun Γ => ?_
    have h2 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    have h3 : ((D₀.coeff Γ : ℤ) : ℝ) = m * ((D.coeff Γ : ℚ) : ℝ) := by exact_mod_cast h2
    change DivisorWithCoeffs.coeff ((1 / (m : ℝ)) • Divisor.toRDivisor D₀) Γ =
      DivisorWithCoeffs.coeff (QDivisor.toRDivisor D) Γ
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, QDivisor.coeff_toRDivisor,
      smul_eq_mul, h3]
    field_simp
  rw [e] at h1
  convert h1 using 1
  ring

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{u}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  show IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{u}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    rw [if_pos hPJ]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    rw [if_neg hPJ]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every set closed under specialization containing no
stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : ∀ x ∈ T, closure {x} ⊆ T)
    (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K (Divisor.toQDivisor Δ) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hK F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists, not_and]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  haveI : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT x hxT

/-- Adding `∑_{P ∈ s} c_P P` to the boundary on a smooth variety lowers a log discrepancy by
`∑_{P ∈ s} c_P e_P`, where `e_P` is the coefficient of the pull-back of `P` along the divisor. -/
private theorem isLogDiscrepancy_add_sum (hsm : IsSmoothScheme sX) {n : ℕ} {B : RDivisor X}
    {F : DivisorOver k sX} {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (c : MMP.Mori.PrimeDivisor X → ℝ)
    (e : MMP.Mori.PrimeDivisor X → ℤ)
    (he : haveI := F.isLocallyNoetherian
      haveI := F.isNormal
      ∀ P ∈ s, ∀ (P' : Divisor F.Y) (hB : ∀ Z : irreducibleComponents F.Y,
          F.f (componentGenericPoint F.Y Z) ∉
            DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor X)),
        Divisor.IsPullback F.f (Finsupp.single P 1 : Divisor X) hB P' → P'.coeff F.E = e P) :
    MMP.Intersection.IsLogDiscrepancy sX n
      (B + ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X)) F
      (a - ∑ P ∈ s, c P * e P) := by
  classical
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  induction s using Finset.induction_on with
  | empty => simpa using h
  | insert P s hP ih =>
    have hC : Divisor.IsCartier (Finsupp.single P 1 : Divisor X) :=
      MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
    have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f
      (Finsupp.single P (1 : ℤ) : Divisor X)
    obtain ⟨P', hP'⟩ := hC.exists_isPullback hB
    have h' := isLogDiscrepancy_add_smul (ih fun Q hQ => he Q (Finset.mem_insert_of_mem hQ)) hC
      (c P) P' hB hP'
    rw [he P (Finset.mem_insert_self _ _) P' hB hP'] at h'
    have e1 : B + ∑ Q ∈ insert P s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) =
        B + ∑ Q ∈ s, c Q • Divisor.toRDivisor (Finsupp.single Q 1 : Divisor X) +
          c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
      rw [Finset.sum_insert hP]; abel
    have e2 : a - ∑ Q ∈ insert P s, c Q * e Q = a - ∑ Q ∈ s, c Q * e Q - c P * e P := by
      rw [Finset.sum_insert hP]; ring
    rw [e1, e2]
    exact h'

/-- **Zero places see no `D`.** If `a(F, X, Δ) = 0` for the reduced snc `Δ` and `D` contains no
stratum of `Δ`, then `a(F, X, Δ + D) = 0`. -/
private theorem eq_zero_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hns : ContainsNoStratum Δ D.supp) {n : ℕ}
    {F : DivisorOver k sX} {a : ℝ}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0)
    (ha : MMP.Intersection.IsLogDiscrepancy sX n
      (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a) : a = 0 := by
  have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ (fun x hx =>
    (DivisorWithCoeffs.supp D).isClosed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx))
    hns h0
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
  obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hz := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hx) D₀' hB hD₀'
  have h1 := isLogDiscrepancy_add_of_zsmul h0 hm hD₀ hD₀c D₀' hB hD₀'
  rw [hz] at h1
  have h2 : (0 : ℝ) - ((0 : ℤ) : ℝ) / m = 0 := by simp
  rw [h2] at h1
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1

end Toolkit

/-! ### The arithmetic of the comparison on a log resolution -/

/-- If `A₀ = t + ∑ a₀ᵢ eᵢ` and `A = t + ∑ αᵢ eᵢ` with `t, eᵢ ≥ 0`, `a₀ᵢ ∈ ℕ`, `αᵢ = 0` whenever
`a₀ᵢ = 0`, and `Gᵢ = ⌈αᵢ⌉ - 1 + [a₀ᵢ = 0]`, then `∑ Gᵢ eᵢ ≤ ⌈A⌉ - 1 + [A₀ = 0]`. -/
private theorem sum_mul_le_ceil {ι : Type*} (s : Finset ι) (a₀ : ι → ℕ) (α : ι → ℝ)
    (e G : ι → ℤ) (t : ℕ) {A₀ A : ℝ} (he : ∀ i ∈ s, 0 ≤ e i)
    (hz : ∀ i ∈ s, a₀ i = 0 → α i = 0)
    (hG : ∀ i ∈ s, G i = ⌈α i⌉ - 1 + if ((a₀ i : ℕ) : ℝ) = 0 then 1 else 0)
    (hA₀ : A₀ = t + ∑ i ∈ s, (a₀ i : ℝ) * e i) (hA : A = t + ∑ i ∈ s, α i * e i) :
    ∑ i ∈ s, G i * e i ≤ ⌈A⌉ - 1 + if A₀ = 0 then 1 else 0 := by
  have hGz : ∀ i ∈ s, a₀ i = 0 → G i = 0 := by
    intro i hi h0
    rw [hG i hi, hz i hi h0]
    simp [h0]
  have hGpos : ∀ i ∈ s, a₀ i ≠ 0 → (G i : ℝ) < α i := by
    intro i hi h0
    rw [hG i hi, if_neg (by exact_mod_cast h0)]
    push_cast
    linarith [Int.ceil_lt_add_one (α i)]
  have hterm : ∀ i ∈ s, 0 ≤ (α i - G i) * e i := by
    intro i hi
    by_cases h0 : a₀ i = 0
    · rw [hz i hi h0, hGz i hi h0]; simp
    · exact mul_nonneg (by linarith [hGpos i hi h0]) (by exact_mod_cast he i hi)
  have hdiff : A - ∑ i ∈ s, (G i : ℝ) * e i = t + ∑ i ∈ s, (α i - G i) * e i := by
    rw [hA]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have ht : (0 : ℝ) ≤ t := Nat.cast_nonneg t
  by_cases hA0 : A₀ = 0
  · rw [if_pos hA0]
    have hnn : ∀ i ∈ s, 0 ≤ (a₀ i : ℝ) * e i := fun i hi =>
      mul_nonneg (Nat.cast_nonneg _) (by exact_mod_cast he i hi)
    have hs := Finset.sum_nonneg hnn
    have hsum0 : ∑ i ∈ s, (a₀ i : ℝ) * e i = 0 := by linarith
    have ht0 : (t : ℝ) = 0 := by linarith
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp hsum0
    have hGe : ∀ i ∈ s, (G i : ℝ) * e i = 0 ∧ α i * e i = 0 := by
      intro i hi
      by_cases h0 : a₀ i = 0
      · rw [hGz i hi h0, hz i hi h0]; simp
      · have he0 : (e i : ℝ) = 0 := by
          rcases mul_eq_zero.mp (hzero i hi) with h | h
          · exact absurd (by exact_mod_cast h) h0
          · exact h
        rw [he0]; simp
    have hS : ∑ i ∈ s, (G i : ℝ) * e i = 0 := Finset.sum_eq_zero fun i hi => (hGe i hi).1
    have hA' : A = 0 := by
      rw [hA, ht0, Finset.sum_eq_zero fun i hi => (hGe i hi).2]; simp
    have hS' : ∑ i ∈ s, G i * e i = 0 := by exact_mod_cast hS
    rw [hS', hA']
    simp
  · rw [if_neg hA0]
    have hlt : ((∑ i ∈ s, G i * e i : ℤ) : ℝ) < A := by
      push_cast
      by_contra hle
      have hle := not_lt.mp hle
      have hsnn := Finset.sum_nonneg hterm
      have ht0 : (t : ℝ) = 0 := by linarith
      have hs0 : ∑ i ∈ s, (α i - G i) * e i = 0 := by linarith
      have hz2 := (Finset.sum_eq_zero_iff_of_nonneg hterm).mp hs0
      apply hA0
      rw [hA₀, ht0, zero_add]
      refine Finset.sum_eq_zero fun i hi => ?_
      by_cases h0 : a₀ i = 0
      · simp [h0]
      · rcases mul_eq_zero.mp (hz2 i hi) with h | h
        · exact absurd h (by linarith [hGpos i hi h0])
        · rw [h]; simp
    have : (∑ i ∈ s, G i * e i : ℤ) < ⌈A⌉ := by
      have := hlt.trans_le (Int.le_ceil A)
      exact_mod_cast this
    omega

/-- `⌈a⌉ - 1 + [a₀ = 0] ≤ 0` when `a ≤ a₀ ∈ {0, 1}`. -/
private theorem ceil_sub_one_add_ite_nonpos {a₀ a : ℝ} (h01 : a₀ = 0 ∨ a₀ = 1) (hle : a ≤ a₀) :
    ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) ≤ 0 := by
  rcases h01 with h | h
  · rw [if_pos h]
    have := Int.ceil_le.mpr (show a ≤ ((0 : ℤ) : ℝ) by push_cast; linarith)
    omega
  · rw [if_neg (by rw [h]; norm_num)]
    have := Int.ceil_le.mpr (show a ≤ ((1 : ℤ) : ℝ) by push_cast; linarith)
    omega

/-- The exponent `⌈a⌉ - 1 + [a₀ = 0]` decreases when the integral `a₀ ∈ ℕ` drops by `c₁ ≥ 0` to
`a₀ - c₁ ∈ ℕ` and `a` drops by at least `c₁`. -/
private theorem ceil_add_ite_le_of_le {a₀ a c₁ c₂ : ℝ} {p p' : ℕ} (hp : a₀ = p)
    (hp' : a₀ - 1 * c₁ = p') (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    ⌈a - 1 * c₁ - c₂⌉ - 1 + (if a₀ - 1 * c₁ = 0 then 1 else 0) ≤
      ⌈a⌉ - 1 + (if a₀ = 0 then 1 else 0) := by
  have hmono : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a⌉ := Int.ceil_mono (by linarith)
  split_ifs with h1 h2 h2
  · omega
  · have hp1 : (1 : ℝ) ≤ p := by
      have hp0 : p ≠ 0 := by
        rintro rfl
        exact h2 (by rw [hp]; simp)
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hp0
    have h3 : ⌈a - 1 * c₁ - c₂⌉ ≤ ⌈a - 1⌉ := Int.ceil_mono (by linarith)
    rw [Int.ceil_sub_one] at h3
    omega
  · exfalso
    apply h1
    have : (0 : ℝ) ≤ p' := Nat.cast_nonneg _
    linarith
  · omega

/-! ### Divisors over `X` realized over a proper birational model -/

section Model

variable {k : Type u} [Field k]

/-- **The centre of a divisorial valuation on a proper model.** Let `π : W ⟶ X` be a proper
dominant morphism of integral schemes and `D` a divisor over `X`. A valuation `ξ` of `k(W)`
restricting to `ord_D` on `k(X)` dominates the local ring of some point of `W`. -/
private theorem exists_dominated_point {X W : Scheme.{u}} [IsIntegral X]
    [IsIntegral W] {sX : X ⟶ Spec (.of k)} (π : W ⟶ X) [IsDominant π] (hπ : IsProper π)
    (D : DivisorOver k sX) (ξ : Valuation W.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ.comap (functionFieldMap π) = D.valuation) :
    ∃ x : W, (∀ a : W.presheaf.stalk x, ξ (algebraMap _ W.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (W.presheaf.stalk x),
        ξ (algebraMap _ W.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  have hw : ∀ b : X.presheaf.stalk y,
      ξ (functionFieldMap π (algebraMap _ X.functionField b)) =
        D.valuation (algebraMap _ X.functionField b) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ X.functionField b)) h
    simpa only [Valuation.comap_apply] using this
  let R := ξ.valuationSubring
  let φ : X.presheaf.stalk y →+* R :=
    ((functionFieldMap π).comp (algebraMap (X.presheaf.stalk y) X.functionField)).codRestrict R
      fun b => (ξ.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint X ⤳ y := (genericPoint_spec X).specializes trivial
  have hex : ValuativeCriterion.Existence π := by
    have h : @IsProper _ _ π := hπ
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq π :=
    { R := R
      K := W.functionField
      i₁ := W.fromSpecStalk (genericPoint W)
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ X.fromSpecStalk y
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk π,
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R W.functionField)) ≫ l =
      W.fromSpecStalk (genericPoint W) := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint W ⤳ x := (genericPoint_spec W).specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R W.functionField) =
      W.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (W.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : W.presheaf.stalk x,
      algebraMap _ W.functionField a = ((f.hom a : R) : W.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]; exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

/-- **Divisors over `X` are realized over a proper birational model.** For a proper birational
morphism `π : W ⟶ X` of normal varieties and a divisor `D` over `X`, some divisor `D'` over `W`,
proper over `W`, induces the valuation of `D` on `k(X) ≅ k(W)`, and its centre on `W` maps to
the centre of `D` on `X`. -/
private theorem exists_divisorOver_model {X W : Scheme.{u}} [IsIntegral X] [IsIntegral W]
    {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX) (π : W ⟶ X) (hπ : IsProper π)
    (hbir : IsBirationalMorphism π) (hW : IsNormalVariety k (π ≫ sX)) (D : DivisorOver k sX) :
    haveI : IsDominant π := hbir.isDominant
    ∃ D' : DivisorOver k (π ≫ sX), IsProper D'.f ∧
      D.valuation = D'.valuation.comap (functionFieldMap π) ∧
      π (D'.f D'.E.genericPoint) = D.f D.E.genericPoint := by
  haveI : IsDominant π := hbir.isDominant
  have hbij := hbir.functionFieldMap_bijective
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (π ≫ sX)
  let eπ := functionFieldAlgEquiv sX π hbij
  let ξ := D.valuation.comap (eπ.symm : W.functionField →+* X.functionField)
  have hξ : ξ.comap (functionFieldMap π) = D.valuation := by
    ext t
    change D.valuation (eπ.symm (eπ t)) = D.valuation t
    rw [eπ.symm_apply_apply]
  obtain ⟨x, h1, h2⟩ := exists_dominated_point π hπ D ξ hξ
  haveI : AlgebraicGeometry.IsVariety k (π ≫ sX) := hW.1
  have hdiv : MMP.Flips.IsDivisorOfFunctionField k (π ≫ sX) ξ := by
    haveI := D.isIntegral
    haveI := D.isNormal
    haveI := D.isLocallyNoetherian
    haveI := D.isDominant
    refine ⟨D.Y, D.f ≫ sX, D.isNormalVariety, D.E, ?_⟩
    letI := functionFieldAlgebra (D.f ≫ sX)
    let eD := functionFieldAlgEquiv sX D.f D.isBirationalMorphism.functionFieldMap_bijective
    refine ⟨eπ.symm.trans eD, ?_⟩
    ext t
    rfl
  obtain ⟨D', -, hv, hDx⟩ :=
    MMP.Flips.exists_properDivisorOver_isProjective_of_dominates (π ≫ sX) hdiv x h1 h2
  have hval : D.valuation = D'.toDivisorOver.valuation.comap (functionFieldMap π) := by
    rw [← hξ, ← hv]
  refine ⟨D'.toDivisorOver, D'.isProper, hval, ?_⟩
  -- the centres agree: compare `D` with `D'` regarded as a divisor over `X`
  have hcomp := MMP.Mori.valuation_compDivisorOver π hW hbir D'.toDivisorOver
  have hcen := MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX
    (hcomp.trans hval.symm)
  have e1 := (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).center_eq_closure_genericPoint
  have e2 := D.center_eq_closure_genericPoint
  rw [← hcen, e1] at e2
  have hins : Inseparable ((MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).f
      (MMP.Mori.compDivisorOver π hW hbir D'.toDivisorOver).E.genericPoint)
      (D.f D.E.genericPoint) := inseparable_iff_closure_eq.mpr e2
  exact hins.eq

end Model

/-- The preimage of a nonempty open under a dominant morphism is nonempty. -/
private theorem preimage_eq_bot_iff {X Y : Scheme.{u}} (μ : Y ⟶ X) [IsDominant μ] (U : X.Opens) :
    μ ⁻¹ᵁ U = ⊥ ↔ U = ⊥ := by
  refine ⟨fun h => by_contra fun hU => ?_, fun h => by simp [h]⟩
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).1 hU
  obtain ⟨_, hx', ⟨x', rfl⟩⟩ := μ.denseRange.inter_open_nonempty U U.isOpen ⟨x, hx⟩
  have hmem : x' ∈ μ ⁻¹ᵁ U := hx'
  rw [h] at hmem
  exact hmem

/-! ### Push-forwards with values in `𝒪_X` are ideal sheaves -/

section Ideal

variable {X X' : Scheme.{u}} [IsIntegral X] [IsIntegral X'] [IsLocallyNoetherian X']
  [IsNormal X'] (μ : X' ⟶ X) [IsDominant μ]

/-- The valuation `v_P(μ^* ·)` on the stalk of `X` at the centre `μ(η_P)` is at most `1`. -/
private theorem val_stalk_le_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) :
    P.valuationOver μ (algebraMap _ X.functionField a) ≤ 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
    MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff,
    MMP.Mori.functionFieldMap_algebraMap_stalk]
  exact ⟨_, rfl⟩

/-- A non-unit of the stalk of `X` at the centre `μ(η_P)` has `v_P(μ^* ·) < 1`. -/
private theorem val_stalk_lt_one (P : MMP.Mori.PrimeDivisor X')
    (a : X.presheaf.stalk (μ P.genericPoint)) (ha : ¬ IsUnit a) :
    P.valuationOver μ (algebraMap _ X.functionField a) < 1 := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_algebraMap_stalk,
    MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff]
  exact (IsLocalRing.mem_maximalIdeal _).mpr fun h => ha (isUnit_of_map_unit _ _ h)

/-- In `ℤᵐ⁰`, an element below `1` is at most `exp (-1)`. -/
private theorem le_exp_neg_one_of_lt_one {x : WithZero (Multiplicative ℤ)} (hx : x < 1) :
    x ≤ WithZero.exp (-1) := by
  rcases eq_or_ne x 0 with rfl | h0
  · exact zero_le'
  rw [← WithZero.exp_log h0] at hx ⊢
  rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hx
  rw [WithZero.exp_le_exp]
  omega

/-- The regular functions `a` on `U` with `v_P(μ^* a) ≤ exp (coeff_P G)` at every prime divisor
`P` whose generic point maps into `U`. -/
private def valIdeal (G : Divisor X') (U : X.Opens) : Ideal Γ(X, U) where
  carrier := {a | ∀ (P : MMP.Mori.PrimeDivisor X') (hP : μ P.genericPoint ∈ U),
    P.valuationOver μ (algebraMap _ X.functionField (X.presheaf.germ U _ hP a)) ≤
      WithZero.exp (G.coeff P)}
  add_mem' {a b} ha hb P hP := by
    rw [map_add, map_add]
    exact (Valuation.map_add _ _ _).trans (max_le (ha P hP) (hb P hP))
  zero_mem' P hP := by simp
  smul_mem' c a ha P hP := by
    rw [smul_eq_mul, map_mul, map_mul, Valuation.map_mul]
    exact (mul_le_of_le_one_left' (val_stalk_le_one μ P _)).trans (ha P hP)

/-- Some `m : ℕ` bounds every coefficient of `G` from below by `-m`. -/
private theorem exists_neg_le_coeff (G : Divisor X') : ∃ m : ℕ, ∀ P, -(m : ℤ) ≤ G.coeff P := by
  refine ⟨∑ P ∈ G.support, (G.coeff P).natAbs, fun P => ?_⟩
  by_cases hP : P ∈ G.support
  · have := Finset.single_le_sum (f := fun P => (G.coeff P).natAbs) (fun _ _ => Nat.zero_le _) hP
    omega
  · rw [MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.notMem_support_iff.mp hP]; omega

/-- If `y|_{D(f)} = f ^ n b` with `b` in the ideal on `D(f)`, then `f ^ m y` lies in the ideal on
`U` as soon as `-m` bounds the coefficients of `G` from below. -/
private theorem pow_mul_mem_valIdeal {G : Divisor X'} {U : X.Opens} {f y : Γ(X, U)}
    {b : Γ(X, X.basicOpen f)} {n m : ℕ} (hb : b ∈ valIdeal μ G (X.basicOpen f))
    (hy : y |_ X.basicOpen f = (f |_ X.basicOpen f) ^ n * b) (hm : ∀ P, -(m : ℤ) ≤ G.coeff P) :
    f ^ m * y ∈ valIdeal μ G U := by
  intro P hP
  rw [map_mul, map_mul, Valuation.map_mul, map_pow, map_pow, Valuation.map_pow]
  by_cases hf : μ P.genericPoint ∈ X.basicOpen f
  · refine (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) m)).trans ?_
    have h2 : X.presheaf.germ _ _ hP y = X.presheaf.germ _ _ hP f ^ n *
        X.presheaf.germ _ _ hf b := by
      rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le f)) _ hf,
        ← map_pow, ← map_mul]
      exact congrArg _ hy
    rw [h2, map_mul, Valuation.map_mul, map_pow, Valuation.map_pow]
    exact (mul_le_of_le_one_left' (pow_le_one' (val_stalk_le_one μ P _) n)).trans (hb P hf)
  · have hle := le_exp_neg_one_of_lt_one (val_stalk_lt_one μ P (X.presheaf.germ _ _ hP f)
      (by rwa [← X.mem_basicOpen f _ hP]))
    refine (mul_le_of_le_one_right' (val_stalk_le_one μ P _)).trans
      ((pow_le_pow_left₀ zero_le' hle m).trans ?_)
    rw [← WithZero.exp_nsmul, WithZero.exp_le_exp]
    simpa using hm P

/-- The ideal sheaf of `X` whose ideal on an affine open `U` is `valIdeal μ G U`. -/
private def valIdealSheaf (G : Divisor X') : X.IdealSheafData where
  ideal U := valIdeal μ G U
  map_ideal_basicOpen U f := by
    change _ = valIdeal μ G (X.basicOpen f)
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha P hP
      change P.valuationOver μ (algebraMap _ X.functionField
        (X.presheaf.germ _ _ hP ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a))) ≤ _
      rw [TopCat.Presheaf.germ_res_apply]
      exact ha P (X.basicOpen_le f hP)
    · intro b hb
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen X U U.2 f b
      obtain ⟨m, hm⟩ := exists_neg_le_coeff G
      have hin := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom
        (pow_mul_mem_valIdeal μ hb hy hm)
      rw [map_mul, map_pow] at hin
      change _ * (y |_ X.basicOpen f) ∈ _ at hin
      rw [hy, ← mul_assoc] at hin
      have hu := X.toRingedSpace.isUnit_res_basicOpen f
      exact (Ideal.unit_mul_mem_iff_mem _ ((hu.pow m).mul (hu.pow n))).mp hin

/-- **A push-forward with values in `𝒪_X` is an ideal sheaf.** If the sections of
`μ_*𝒪_{X'}(G)` over every non-empty open are regular functions, then on every non-empty affine
open they are the ideal of an ideal sheaf of `X`. -/
private theorem exists_idealSheafData_of_subset_range [IsLocallyNoetherian X] [IsNormal X]
    (G : Divisor X')
    (hsub : ∀ (U : X.Opens) [Nonempty U],
      MMP.Intersection.multiplierIdealSections μ G U ⊆ Set.range (X.germToFunctionField U)) :
    ∃ I : X.IdealSheafData, ∀ (U : X.affineOpens) [Nonempty (U : X.Opens)],
      MMP.Intersection.multiplierIdealSections μ G U =
        X.germToFunctionField (U : X.Opens) '' (I.ideal U : Set Γ(X, U)) := by
  refine ⟨valIdealSheaf μ G, fun U _ => ?_⟩
  have hne : μ ⁻¹ᵁ (U : X.Opens) ≠ ⊥ := by
    obtain ⟨u⟩ := ‹Nonempty (U : X.Opens)›
    obtain ⟨_, hx', x', rfl⟩ :=
      μ.denseRange.inter_open_nonempty _ (U : X.Opens).isOpen ⟨u.1, u.2⟩
    exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨x', hx'⟩
  ext g
  constructor
  · intro hg
    obtain ⟨a, rfl⟩ := hsub U hg
    refine ⟨a, fun P hP => ?_, rfl⟩
    have := hg.2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P
      (V := μ ⁻¹ᵁ (U : X.Opens)) hP)
    rwa [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hP] at this
  · rintro ⟨a, ha, rfl⟩
    refine ⟨fun h => absurd h hne, fun P hP => ?_⟩
    have hη : μ P.genericPoint ∈ (U : X.Opens) :=
      MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hη]
    exact ha P hη

end Ideal

/-! ### The adjoint ideal by orders along all divisors over `X` -/

section Main

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} c_P P = B` when `B` has coefficient `c_P` along `P ∈ s` and vanishes off `s`. -/
private theorem sum_smul_single_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  refine Finsupp.ext fun Q => ?_
  rw [Finsupp.finset_sum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul]
  have h1 : ∀ P, (Divisor.toRDivisor (Finsupp.single P (1 : ℤ) : Divisor X)) Q =
      if P = Q then 1 else 0 := by
    intro P
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply,
      Finsupp.single_apply]
    split_ifs <;> simp
  simp only [h1, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.sum_ite_eq]
  rw [← DivisorWithCoeffs.coeff_apply B]
  by_cases hQ : Q ∈ s
  · rw [if_pos hQ, hin Q hQ]
  · rw [if_neg hQ, hout Q hQ]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- `∑_{P ∈ s} P + ∑_{P ∈ s} c_P P = B` when `B` has coefficient `1 + c_P` along `P ∈ s` and
vanishes off `s`. -/
private theorem toRDivisor_add_sum_eq (s : Finset (MMP.Mori.PrimeDivisor X))
    (c : MMP.Mori.PrimeDivisor X → ℝ) (B : RDivisor X) (hin : ∀ Q ∈ s, B.coeff Q = 1 + c Q)
    (hout : ∀ Q ∉ s, B.coeff Q = 0) :
    Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) +
      ∑ P ∈ s, c P • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) = B := by
  classical
  have hT : Divisor.toRDivisor (MMP.Intersection.reducedDivisorOf s) =
      ∑ P ∈ s, (1 : ℝ) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor X) := by
    refine (sum_smul_single_eq s (fun _ => 1) _ (fun Q hQ => ?_) (fun Q hQ => ?_)).symm
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_pos hQ]; simp
    · rw [Divisor.coeff_toRDivisor, MMP.Intersection.coeff_reducedDivisorOf, if_neg hQ]; simp
  rw [hT, ← Finset.sum_add_distrib]
  simp_rw [← add_smul]
  exact sum_smul_single_eq s (fun P => 1 + c P) B hin hout

/-- The sections over `U` of `𝒥_{Δ,D}` described valuatively: the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` whose
centre lies in `U`. -/
private def adjointSet (Δ : Divisor X) (D : QDivisor X) (U : X.Opens) : Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (F : DivisorOver k sX) (a₀ a : ℝ),
    F.f F.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F a₀ →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a →
    F.valuation g ≤ WithZero.exp (⌈a⌉ - 1 + if a₀ = 0 then 1 else 0)}

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An snc closed subset of a smooth scheme is the union of the components of an snc divisor. -/
private theorem exists_finset_of_isSNCSubset [LocallyOfFinitePresentation sX]
    (hsm : IsSmoothScheme sX) {S : Closeds X} (h : IsSNCSubset sX S) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor X), (⋃ E ∈ s, E.support) = (S : Set X) ∧
      DivisorWithCoeffs.IsSNC sX (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
  rcases h with h | h
  · refine ⟨∅, by simp [h], ?_⟩
    simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme (R := ℤ) sX hsm
  · exact h

/-- A prime divisor of a proper birational model which is not exceptional and whose centre lies
off `Supp B` has log discrepancy `1` with respect to `B`. -/
private theorem isLogDiscrepancy_one_of_notMem [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Y : Scheme.{u}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    (B : QDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (hexc : P.genericPoint ∉ (exceptionalSet μ : Set Y))
    (hB : μ P.genericPoint ∉ (DivisorWithCoeffs.supp (QDivisor.toRDivisor B) : Set X)) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K B :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ¬ FP.IsExceptional := fun hexc' =>
    hexc (MMP.Positivity.support_subset_exceptionalSet P hexc' hPmem)
  obtain ⟨Q, hQc, hQd⟩ := MMP.Mori.DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPW FP hne
  have hηQ : μ P.genericPoint = Q.genericPoint := by
    have e1 := FP.center_eq_closure_genericPoint
    rw [hQc, AlgebraicGeometry.PrimeDivisor.support_eq_closure Q] at e1
    exact (inseparable_iff_closure_eq.mpr e1.symm).eq
  have hQmem : Q.genericPoint ∈ Q.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hQ0 : B.coeff Q = 0 := by
    by_contra hne'
    apply hB
    rw [hηQ]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero]) hQmem
  rw [hQ0, neg_zero] at hQd
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hQd hμp
  convert hl using 1
  simp

/-- **Log discrepancy one off the snc divisor of a log resolution.** Let `μ : Y → X` be a proper
birational model and `s` the components of `Exc(μ) ∪ μ⁻¹ Supp(Δ + D)`, for `Δ` reduced and `D`
effective. A prime divisor `P ∉ s` of `Y` has log discrepancy `1` for `(X, Δ)` and `(X, Δ + D)`. -/
private theorem isLogDiscrepancy_one_of_notMem_finset [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) :
        Set Y) ⊆ ⋃ E ∈ s, E.support)
    {P : MMP.Mori.PrimeDivisor Y} (hPs : P ∉ s) :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ 1 ∧
      MMP.Intersection.IsLogDiscrepancy sX n
        (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
    intro hz
    obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
    exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
  have hnot' := fun h => hnot (hs h)
  rw [Closeds.coe_sup, Set.mem_union] at hnot'
  obtain ⟨hexc, hsupp⟩ := not_or.mp hnot'
  have hsuppΔ : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
    intro hmem
    apply hsupp
    obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have : (0 : ℝ) ≤ ((D.coeff Γ' : ℚ) : ℝ) := by exact_mod_cast hD0 Γ'
    rcases hΔ Γ' with h | h
    · rw [h] at hΓ'; simp at hΓ'
    · rw [h]; push_cast; linarith
  have h0 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsuppΔ
  have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsupp
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
  exact ⟨h0, h1⟩

/-- **Bounds along one model give bounds along all divisors over `X`.** Let `μ : Y ⟶ X` be a
proper birational morphism from a smooth variety and `s` a finite set of prime divisors of `Y`
whose reduced sum is snc and whose union contains `Ex(μ) ∪ μ⁻¹ Supp(Δ + D)`, and let `D₀ = mD`
be integral with pull-back `D₀'`. A rational function with `v_P(g) ≤ exp (⌈a₀ - coeff_P(D₀')/m⌉
- 1 + [a₀ = 0])` along every prime divisor `P` of `Y` centred in `U`, where `a₀ = a(P, X, Δ)`, is
a section of `𝒥_{Δ,D}` over `U`. -/
private theorem multiplierIdealSections_subset_adjointSet [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDns : ContainsNoStratum Δ D.supp)
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hμp : IsProper μ) (hsmY : IsSmoothScheme (μ ≫ sX)) {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) :
        Set Y) ⊆ ⋃ E ∈ s, E.support)
    (hsnc : DivisorWithCoeffs.IsSNC (μ ≫ sX) (∑ E ∈ s, Finsupp.single E (1 : ℤ)))
    {m : ℕ} (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier)
    {hD₀μ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D₀.supp}
    {D₀' : Divisor Y} (hD₀' : D₀.IsPullback μ hD₀μ D₀') (G : Divisor Y)
    (hG : ∀ (n : ℕ) (P : MMP.Mori.PrimeDivisor Y) (a₀ : ℕ),
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ →
      G.coeff P = ⌈(a₀ : ℝ) - (D₀'.coeff P : ℝ) / m⌉ - 1 + if a₀ = 0 then 1 else 0)
    (U : X.Opens) :
    MMP.Intersection.multiplierIdealSections μ G U ⊆ adjointSet sX Δ D U := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hμp
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hμp
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    refine ⟨a₀, (a₀ : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m, ha₀r, hα, ?_, ?_, ?_⟩
    · rw [hG n P a₀ ha₀r]
      congr 1
      by_cases h : a₀ = 0 <;> simp [h]
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hμp hs hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  intro g
  rintro ⟨hg0, hgP⟩
  refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a₀ a hx ha₀ ha => ?_⟩
  rcases eq_or_ne g 0 with rfl | hgne
  · simp
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha₀
  obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hμp hμ hY F₀
  set y := F'.f F'.E.genericPoint with hy
  have hyU : y ∈ μ ⁻¹ᵁ U := by
    show μ y ∈ U
    rw [hcen]; exact hx
  have hnY : topologicalKrullDim Y = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
      hn
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
  have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  have hP1 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ + D) :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨B₀, hB₀⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
  obtain ⟨B₁, hB₁⟩ := (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP1 hK μ hY hμ).1.exists
  have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
    (Or.inl hB₀)).2 F' F₀ hval
  have hcr1 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP1 μ hY hμ hK hKY
    (Or.inl hB₁)).2 F' F₀ hval
  obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
  obtain ⟨c₁, hc₁⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP1 hK F₀
  have ha₀c : a₀ = 1 + c₀ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
    hc₀ (by rwa [QDivisor.toRDivisor_toQDivisor])
  have hac : a = 1 + c₁ := MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy
    hc₁ (by rwa [map_add, QDivisor.toRDivisor_toQDivisor])
  have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
    ((hcr0 c₀).2 hc₀) hF'p
  have hY1 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
    ((hcr1 c₁).2 hc₁) hF'p
  -- the reduced snc divisor `T = ∑_{P ∈ s} P` on `Y` and `t = a(F', Y, T) ∈ ℕ`
  have hTred : MMP.Intersection.IsReducedEffective (MMP.Intersection.reducedDivisorOf s) :=
    fun P => by rw [MMP.Intersection.coeff_reducedDivisorOf]; split_ifs <;> simp
  obtain ⟨tr, htr⟩ := exists_isLogDiscrepancy hY hsmY hnY
    (Divisor.toQDivisor (MMP.Intersection.reducedDivisorOf s)) F' hF'p
  rw [QDivisor.toRDivisor_toQDivisor] at htr
  obtain ⟨t, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC (μ ≫ sX) hY.1
    hsmY hTred hsnc htr
  choose a₀P αP ha₀P hαP hGP hzP houtP using hcoef n hn
  have := F'.isLocallyNoetherian
  have := F'.isNormal
  have := F'.isIntegral
  have := F'.isBirationalMorphism.isDominant
  have : CompactSpace F'.Y :=
    (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hcart : ∀ P : MMP.Mori.PrimeDivisor Y,
      Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor Y) := fun P =>
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  choose P' hP' using fun P : MMP.Mori.PrimeDivisor Y => (hcart P).exists_isPullback
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
      (Finsupp.single P (1 : ℤ) : Divisor Y))
  set e : MMP.Mori.PrimeDivisor Y → ℤ := fun P => (P' P).coeff F'.E with hedef
  have he : ∀ P ∈ s, ∀ (Q' : Divisor F'.Y) (hB : ∀ Z : irreducibleComponents F'.Y,
        F'.f (componentGenericPoint F'.Y Z) ∉
          DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor Y)),
      Divisor.IsPullback F'.f (Finsupp.single P 1 : Divisor Y) hB Q' → Q'.coeff F'.E = e P := by
    intro P _ Q' hB hQ'
    rw [hQ'.eq (hcart P) (hP' P)]
  have he0 : ∀ P ∈ s, 0 ≤ e P := fun P _ =>
    coeff_isPullback_nonneg (F := F') (hcart P) (fun Γ _ => by
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> simp) _ _ (hP' P)
  -- the crepant boundaries in terms of the coefficients
  have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
    intro Q
    have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
      hμp
    rw [QDivisor.toRDivisor_toQDivisor] at hl
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
    push_cast at this
    linarith
  have hB₁Q : ∀ Q, ((B₁.coeff Q : ℚ) : ℝ) = 1 - αP Q := by
    intro Q
    have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₁ Q)
      hμp
    rw [map_add, QDivisor.toRDivisor_toQDivisor] at hl
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hαP Q) hl
    push_cast at this
    linarith
  have hb0 := toRDivisor_add_sum_eq s (fun P => -(a₀P P : ℝ)) (QDivisor.toRDivisor B₀)
    (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
    (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp)
  have hb1 := toRDivisor_add_sum_eq s (fun P => -αP P) (QDivisor.toRDivisor B₁)
    (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q]; ring)
    (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₁Q Q, (houtP Q hQ).2]; simp)
  have hsum0 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(a₀P P : ℝ)) e he
  have hsum1 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -αP P) e he
  rw [hb0] at hsum0
  rw [hb1] at hsum1
  have hA₀ : a₀ = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0 hsum0
    rw [ha₀c, this]
    simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
  have hA : a = t + ∑ P ∈ s, αP P * e P := by
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY1 hsum1
    rw [hac, this]
    simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
  -- `v_F(g) ≤ exp (∑ G_P e_P)`
  have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
  obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
  have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
    (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_neg, neg_neg]
      exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
  have hl1 := isLogDiscrepancy_add_smul htr hGcart (1 : ℝ) G' hBG hG'
  have hl2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(G.coeff P : ℝ)) e he
  have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
    intro Q hQ
    rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
    simp
  have hbG : (1 : ℝ) • Divisor.toRDivisor (-G) =
      ∑ P ∈ s, (-(G.coeff P : ℝ)) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor Y) := by
    refine (sum_smul_single_eq s _ _ (fun Q _ => ?_) (fun Q hQ => ?_)).symm
    · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg]
      simp
    · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_neg,
        hG0 Q hQ]
      simp
  rw [hbG] at hl1
  have hGe : (G'.coeff F'.E : ℝ) = -∑ P ∈ s, (G.coeff P : ℝ) * e P := by
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hl1 hl2
    simp only [one_mul, neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add] at this
    linarith
  have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by exact_mod_cast hGe
  have hval' : F₀.valuation g = F'.valuation (functionFieldMap μ g) := by
    rw [hval]; rfl
  rw [hval']
  refine hR.trans ?_
  rw [hGe', neg_neg, WithZero.exp_le_exp]
  exact sum_mul_le_ceil s a₀P αP e (fun P => G.coeff P) t he0 (fun P _ => hzP P)
    (fun P _ => hGP P) hA₀ hA

/-- The zero log discrepancy divisor has coefficient `[a₀ = 0]` at a prime divisor of log
discrepancy `a₀ ∈ ℕ`. -/
private theorem coeff_eq_ite_of_isZeroLogDiscrepancyDivisor [PerfectField k] {Y : Scheme.{u}}
    {μ : Y ⟶ X}
    {hY : IsNormalVariety k (μ ≫ sX)} {hμ : IsBirationalMorphism μ} {Δ : Divisor X}
    {Γ : Divisor Y} (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    {P : MMP.Mori.PrimeDivisor Y} {n a₀ : ℕ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀) :
    Γ.coeff P = if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0 := by
  rcases hΓ.1 P with h0 | h1
  · rw [h0, if_neg]
    intro ha0
    have : Γ.coeff P = 1 := (hΓ.2 P).2 ⟨n, by rw [ha0] at ha; exact ha⟩
    omega
  · rw [h1, if_pos]
    obtain ⟨n', h'⟩ := (hΓ.2 P).1 h1
    exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h'

/-- **The adjoint ideal is computed by orders along all divisors over `X`.** The sections of
`μ_*𝒪_Y(E - ⌊μ^*D⌋)` are the rational functions `g` with
`v_F(g) ≤ exp (⌈a(F, X, Δ + D)⌉ - 1 + [a(F, X, Δ) = 0])` for every divisor `F` over `X` centred
in the open set. -/
private theorem eq_adjointSet [IsAlgClosed k] [CharZero k] {Δ : Divisor X} {D : QDivisor X}
    {Y : Scheme.{u}} {μ : Y ⟶ X} {J : X.Opens → Set X.functionField}
    (h : IsReducedAdjointIdealOn sX Δ D μ J) : J = adjointSet sX Δ D := by
  classical
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, _, _, _, _, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  set G := E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hGdef
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  obtain ⟨D₀', hD₀'eq, hD₀'pb⟩ := hF m hm D₀ hD₀ hD₀c
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ (a₀ : ℕ) (α : ℝ),
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        MMP.Intersection.IsLogDiscrepancy sX n
          (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ α ∧
        G.coeff P = ⌈α⌉ - 1 + (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → α = 0) ∧ (P ∉ s → a₀ = 1 ∧ α = 1) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hα := isLogDiscrepancy_add_of_zsmul ha₀r hm hD₀ hD₀c D₀' _ hD₀'pb
    have hFP : ((D₀'.coeff P : ℤ) : ℝ) / m = ((F.coeff P : ℚ) : ℝ) := by
      have h1 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
        Int.cast_natCast] at h1
      have h' : ((D₀'.coeff P : ℤ) : ℝ) = m * ((F.coeff P : ℚ) : ℝ) := by exact_mod_cast h1
      rw [h']
      field_simp
    change MMP.Intersection.IsLogDiscrepancy sX n _ FP (_ - ((D₀'.coeff P : ℤ) : ℝ) / m) at hα
    rw [hFP] at hα
    refine ⟨a₀, (a₀ : ℝ) - F.coeff P, ha₀r, hα, ?_, ?_, ?_⟩
    · have hΓP := coeff_eq_ite_of_isZeroLogDiscrepancyDivisor sX hΓ ha₀r
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊((F.coeff P : ℚ) : ℝ)⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - F.coeff P⌉ := by
        have e : ((F.coeff P : ℚ) : ℝ) = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        QDivisor.coeff_toRDivisor, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      exact eq_zero_of_isLogDiscrepancy_eq_zero hX hsm hΔ hDns (by simpa using ha₀r) hα
    · intro hPs
      obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ
        hlog.isProper hs.ge hPs
      exact ⟨by exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h0,
        MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1⟩
  funext U
  ext g
  constructor
  · /- `J ⊆ adjointSet`: the comparison along a model of `F` on `Y`. -/
    refine fun hg => multiplierIdealSections_subset_adjointSet sX hX hsm hΔ hD0 hDns hY hμ
      hlog.isProper hsmY hs.ge hsnc hm hD₀ hD₀c hD₀'pb G (fun n P a₀ ha => ?_) U hg
    obtain ⟨a₀', α, ha₀', hα, hGP, -, -⟩ :=
      hcoef n (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha) P
    have e1 : (a₀ : ℝ) = a₀' := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha₀'
    have e2 : a₀ = a₀' := by exact_mod_cast e1
    subst e2
    have hα' := isLogDiscrepancy_add_of_zsmul ha hm hD₀ hD₀c D₀' _ hD₀'pb
    have e3 : α = (a₀ : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m :=
      MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα hα'
    rw [hGP, e3]
    congr 1
    by_cases h0 : a₀ = 0 <;> simp [h0]
  · /- `adjointSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ((preimage_eq_bot_iff μ U).1 hU), fun P hP => ?_⟩
    have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    obtain ⟨n, a, hla, -⟩ := hE P
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
    obtain ⟨a₀, α, ha₀, hα, hGP, -, -⟩ := hcoef n hn P
    have := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ α hxU ha₀ hα
    rw [hGP]
    exact this

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A variety has finite dimension. -/
private theorem exists_topologicalKrullDim_eq [IsIntegral X] (hX : MMP.Mori.IsVariety k sX) :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  refine ⟨(Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction sX
    (genericPoint X)).toNat, ?_⟩
  rw [← Stacks.Chow.topologicalKrullDim_closure_singleton_eq k sX (genericPoint X)]
  have h : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
  exact (IsHomeomorph.topologicalKrullDim_eq _
    ((Homeomorph.setCongr h).trans (Homeomorph.Set.univ X)).isHomeomorph).symm

/-- The log discrepancy of a prime divisor `Q` of the smooth `X` is `1 - coeff_Q B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (Q : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hX Q) (1 - B.coeff Q) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
    (DivisorOver.ofPrimeDivisor k hX Q)
  have hcQ := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc
  have h := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 X) from inferInstance)
  rw [hcQ] at h
  convert h using 1
  push_cast
  ring

/-- The valuation of a prime divisor of `X`, regarded as a divisor over `X`. -/
private theorem valuation_ofPrimeDivisor (hX : IsNormalVariety k sX)
    (Q : MMP.Mori.PrimeDivisor X) (g : X.functionField) :
    (DivisorOver.ofPrimeDivisor k hX Q).valuation g = Q.divisorialValuation g := by
  change Q.divisorialValuation (functionFieldMap (𝟙 X) g) = _
  rw [MMP.Mori.functionFieldMap_id_apply]

/-- **The resolution choices exist**: a projective log resolution of `Δ + D`, the reduced sum
`Γ` of the zero places of `(X, Δ)` on it, and the divisor `E` with `K_Y + Γ = μ^*(K_X + Δ) + E`. -/
private theorem exists_isReducedAdjointIdealOn [IsAlgClosed k] [CharZero k] (Δ : Divisor X)
    (D : QDivisor X) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hΔ : IsReducedSNC sX Δ) (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp) :
    ∃ (Y : Scheme.{u}) (μ : Y ⟶ X) (J : X.Opens → Set X.functionField),
      IsReducedAdjointIdealOn sX Δ D μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨Y, μ, h1, h2⟩ := MMP.Mori.exists_isLogResolution_isProjectiveMorphism sX hX
    (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))
  have hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ := ⟨h1, h2⟩
  have hres := h1.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀]
    exact MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ D₀ Z
  have hF := QDivisor.isPullback_pullback (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D) hD
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hres.isProper hs.ge hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨Y, μ, _, hX, hsm, hΔ, hD0, hDns, hlog, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Γ, E, _, ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, hF, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

end Main

/-! ### Valuations of regular functions and of local equations -/

section Valuations

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- A rational function with nonnegative order along every prime divisor through the centre of a
divisor `G` over `X` has `v_G ≤ 1`. -/
private theorem valuation_le_one_of_forall_ord_nonneg (G : DivisorOver k sX)
    {u : X.functionField}
    (h : ∀ Γ : MMP.Mori.PrimeDivisor X, G.f G.E.genericPoint ∈ Γ.support →
      0 ≤ X.ord u Γ.genericPoint) : G.valuation u ≤ 1 := by
  rcases eq_or_ne u 0 with rfl | hu
  · simp
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg _ hu h
  rw [← hr]
  exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one G _ rfl r

/-- A nonzero rational function of order zero along every prime divisor through the centre of a
divisor `G` over `X` has `v_G = 1`. -/
private theorem valuation_eq_one_of_forall_ord_eq_zero (G : DivisorOver k sX)
    {u : X.functionField} (hu : u ≠ 0)
    (h : ∀ Γ : MMP.Mori.PrimeDivisor X, G.f G.E.genericPoint ∈ Γ.support →
      X.ord u Γ.genericPoint = 0) : G.valuation u = 1 := by
  apply le_antisymm (valuation_le_one_of_forall_ord_nonneg G fun Γ hΓ => (h Γ hΓ).ge)
  have h2 := valuation_le_one_of_forall_ord_nonneg G (u := u ^ (-1 : ℤ)) fun Γ hΓ => by
    rw [MMP.Mori.ord_zpow _ hu, h Γ hΓ]; simp
  rw [map_zpow₀, zpow_neg_one] at h2
  have hpos : 0 < G.valuation u := by
    rw [zero_lt_iff]; exact (map_ne_zero _).mpr hu
  exact (inv_le_one₀ hpos).mp h2

/-- The order of a local equation `φ` of `D` on `U` along a prime divisor meeting `U` is the
coefficient of `D`. -/
private theorem ord_evalFF_of_isLocalEquation {D : Divisor X} {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (Z : irreducibleComponents X) (Γ : MMP.Mori.PrimeDivisor X) (hΓ : (Γ.support ∩ U).Nonempty) :
    X.ord (MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X))
      Γ.genericPoint = D.coeff Γ := by
  rw [hφ Γ hΓ, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord,
    show Γ.component = Z from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]

private theorem evalFF_ne_zero (Z : irreducibleComponents X)
    (φ : (MMP.Mori.RationalFunctions X)ˣ) :
    MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X) ≠ 0 :=
  (φ.isUnit.map _).ne_zero

/-- A section `g` of `𝒪_X(D)` has `ord_Γ(g) + coeff_Γ(D) ≥ 0`. -/
private theorem ord_add_coeff_nonneg {D : Divisor X} {g : X.functionField}
    (hg : g ∈ sectionsIn D) (hg0 : g ≠ 0) (Γ : MMP.Mori.PrimeDivisor X) :
    0 ≤ X.ord g Γ.genericPoint + D.coeff Γ := by
  have h := hg Γ
  rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h
  omega

/-- A section `g` of `𝒪_X(D)` times a local equation of `D` near the centre of `G` has
`v_G ≤ 1`. -/
private theorem valuation_mul_evalFF_le_one (G : DivisorOver k sX) {D : Divisor X}
    {g : X.functionField} (hg : g ∈ sectionsIn D) {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (hx : G.f G.E.genericPoint ∈ U) (Z : irreducibleComponents X) :
    G.valuation (g * MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)) ≤
      1 := by
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  refine valuation_le_one_of_forall_ord_nonneg G fun Γ hΓ => ?_
  rw [Scheme.ord_mul hg0 (evalFF_ne_zero Z φ),
    ord_evalFF_of_isLocalEquation hφ Z Γ ⟨_, hΓ, hx⟩]
  exact ord_add_coeff_nonneg hg hg0 Γ

/-- An integer `w` with `exp (-w) ≤ v_G(g' φ)` for every local equation `φ` of `D` near the centre
of `G`, where `g'` is a section of `𝒪_X(D)`, is nonnegative. -/
private theorem nonneg_of_forall_exp_neg_le (G : DivisorOver k sX) {D : Divisor X}
    (hDc : D.IsCartier) {g' : X.functionField} (hg' : g' ∈ sectionsIn D) {w : ℤ}
    (hw : ∀ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      D.IsLocalEquation U φ → G.f G.E.genericPoint ∈ U →
      WithZero.exp (-w) ≤ G.valuation (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X))) :
    0 ≤ w := by
  obtain ⟨U, hxU, φ, hφ⟩ := hDc (G.f G.E.genericPoint)
  have h1 := (hw U φ (MMP.Mori.pointComponent (genericPoint X)) hφ hxU).trans
    (valuation_mul_evalFF_le_one G hg' hφ hxU _)
  rw [← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  omega

/-- Along a prime divisor `P` of `Y` centred in `U`, a local equation of `D` on `U` has
`v_P(μ^*φ) = exp (-coeff_P(μ^*D))`. -/
private theorem valuationOver_evalFF_eq {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {μ : Y ⟶ X} [IsDominant μ] {D : Divisor X}
    {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp}
    {Dμ : Divisor Y} (h : D.IsPullback μ hD Dμ) {U : X.Opens}
    {φ : (MMP.Mori.RationalFunctions X)ˣ} (hφ : D.IsLocalEquation U φ)
    (P : MMP.Mori.PrimeDivisor Y) (hP : μ P.genericPoint ∈ U) (Z : irreducibleComponents X) :
    P.valuationOver μ (MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)) =
      WithZero.exp (-Dμ.coeff P) := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
    P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr (evalFF_ne_zero Z φ)),
    MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hP Z]

end Valuations

/-! ### Base loci and fixed divisors -/

section Fixed

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The base locus of a linear series is closed under specialization. -/
private theorem closure_subset_baseLocusIn {V : Set X.functionField} {D : Divisor X} {x : X}
    (hx : x ∈ baseLocusIn V D) : closure {x} ⊆ baseLocusIn V D := by
  intro z hz g hg hg0
  obtain ⟨P, hxP, hlt⟩ := hx g hg hg0
  refine ⟨P, ?_, hlt⟩
  have hcl : IsClosed (P.support : Set X) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  exact hcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxP) hz

variable {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
  [IsDominant μ] {D : Divisor X}
  {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp} {Dμ : Divisor Y}

/-- `v_P(μ^*(g φ)) = v_P(μ^*g) · exp (-coeff_P(μ^*D))` for a local equation `φ` of `D` near the
centre of `P`. -/
private theorem valuationOver_mul_evalFF (h : D.IsPullback μ hD Dμ) (hDc : D.IsCartier)
    (P : MMP.Mori.PrimeDivisor Y) (g : X.functionField) :
    ∃ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ), D.IsLocalEquation U φ ∧
      μ P.genericPoint ∈ U ∧ ∀ Z : irreducibleComponents X,
        P.valuationOver μ (g * MMP.Threefold.Mori.Helpers.evalFF Z
          (φ : MMP.Mori.RationalFunctions X)) =
          P.valuationOver μ g * WithZero.exp (-Dμ.coeff P) := by
  obtain ⟨U, hxU, φ, hφ⟩ := hDc (μ P.genericPoint)
  refine ⟨U, φ, hφ, hxU, fun Z => ?_⟩
  rw [Valuation.map_mul, valuationOver_evalFF_eq h hφ P hxU Z]

/-- The fixed divisor of a series of sections of `𝒪_X(D)` pulled back to `Y` is effective. -/
private theorem coeff_nonneg_of_isFixedDivisorOfPullback (hDc : D.IsCartier)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (h : D.IsPullback μ hD Dμ)
    {F : Divisor Y} (hF : IsFixedDivisorOfPullback μ V Dμ F) (P : MMP.Mori.PrimeDivisor Y)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) :
    0 ≤ F.coeff P := by
  obtain ⟨g, hgV, -, hgeq⟩ := (hF P).2
  obtain ⟨U, φ, hφ, hxU, hval⟩ := valuationOver_mul_evalFF h hDc P g
  set Z : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have h1 := valuation_mul_evalFF_le_one (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX) (hVs hgV) hφ
    hxU Z
  change P.valuationOver μ _ ≤ 1 at h1
  rw [hval Z, hgeq, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  omega

/-- The fixed divisor vanishes along a prime divisor whose centre lies off the base locus. -/
private theorem coeff_nonpos_of_notMem_baseLocusIn (hDc : D.IsCartier)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (h : D.IsPullback μ hD Dμ)
    {F : Divisor Y} (hF : IsFixedDivisorOfPullback μ V Dμ F) (P : MMP.Mori.PrimeDivisor Y)
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hx : μ P.genericPoint ∉ baseLocusIn V D) : F.coeff P ≤ 0 := by
  simp only [baseLocusIn, Set.mem_setOf_eq, not_forall, not_exists, not_and, not_lt] at hx
  obtain ⟨g, hgV, hg0, hge⟩ := hx
  obtain ⟨U, φ, hφ, hxU, hval⟩ := valuationOver_mul_evalFF h hDc P g
  set Z : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have h1 := valuation_eq_one_of_forall_ord_eq_zero (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX)
    (u := g * MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X))
    (mul_ne_zero hg0 (evalFF_ne_zero Z φ)) fun Γ hΓ => by
      rw [Scheme.ord_mul hg0 (evalFF_ne_zero Z φ),
        ord_evalFF_of_isLocalEquation hφ Z Γ ⟨_, hΓ, hxU⟩]
      have h2 := hge Γ hΓ
      rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h2
      have h3 := ord_add_coeff_nonneg (hVs hgV) hg0 Γ
      omega
  change P.valuationOver μ _ = 1 at h1
  have h4 := (hF P).1 g hgV
  rw [hval Z] at h1
  have h5 : P.valuationOver μ g * WithZero.exp (-Dμ.coeff P) ≤
      WithZero.exp (Dμ.coeff P - F.coeff P) * WithZero.exp (-Dμ.coeff P) :=
    mul_le_mul_left h4 _
  rw [h1, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp] at h5
  omega

end Fixed

/-! ### The adjoint ideal of a linear series by orders along all divisors over `X` -/

section SeriesMain

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The valuative condition at a divisor `G` over `X` with `a = a(G, X, Δ)`: some nonzero
`g' ∈ V` and some integer `w` bounding `ord_G(g') + ord_G(D)` from above (through every local
equation of `D` near the centre of `G`) give `v_G(g) ≤ exp (⌈a - c w⌉ - 1 + [a = 0])`. -/
private def SeriesCond (D : Divisor X) (V : Set X.functionField) (c : ℚ) (G : DivisorOver k sX)
    (a : ℝ) (g : X.functionField) : Prop :=
  ∃ g' ∈ V, g' ≠ 0 ∧ ∃ w : ℤ,
    (∀ (U : X.Opens) (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      D.IsLocalEquation U φ → G.f G.E.genericPoint ∈ U →
      WithZero.exp (-w) ≤ G.valuation (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X))) ∧
    G.valuation g ≤ WithZero.exp (⌈a - (c : ℝ) * w⌉ - 1 + if a = 0 then 1 else 0)

/-- The sections over `U` of `𝒥_{Δ,cV}` described valuatively: the rational functions satisfying
`SeriesCond` at every divisor over `X` centred in `U`. -/
private def seriesSet (Δ D : Divisor X) (V : Set X.functionField) (c : ℚ) (U : X.Opens) :
    Set X.functionField :=
  {g | (U = ⊥ → g = 0) ∧ ∀ (n : ℕ) (G : DivisorOver k sX) (a : ℝ),
    G.f G.E.genericPoint ∈ U →
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) G a →
    SeriesCond sX D V c G a g}

/-- **The adjoint ideal of a linear series is computed by orders along all divisors over `X`.**
The sections of `μ_*𝒪_Y(E - ⌊cF⌋)`, for a log resolution `μ` of `Δ` and of the series `V` with
fixed divisor `F`, are the rational functions satisfying the valuative condition
`SeriesCond` at every divisor over `X` centred in the open set. -/
private theorem eq_seriesSet [IsAlgClosed k] [CharZero k] {Δ D : Divisor X}
    {V : AddSubgroup X.functionField} {c : ℚ} {Y : Scheme.{u}} {μ : Y ⟶ X}
    {J : X.Opens → Set X.functionField}
    (h : IsSeriesAdjointIdealOn sX Δ D V c μ J) : J = seriesSet sX Δ D V c := by
  classical
  obtain ⟨hX, hsm, hΔ, hDc, hVs, hVns, hc, _, _, _, _, hY, hμ, hD, Dμ, F, Γ, E, hDμ,
    ⟨hlog, hfix, hfree, hsncF⟩, hΓ, hE, rfl⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : IsProper μ := hlog.isProper
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlog.isSmoothScheme
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hsncF
  set G := E - MMP.Intersection.WeilRDivisor.roundDown ((c : ℝ) • Divisor.toRDivisor F)
    with hGdef
  have hc0 : (0 : ℝ) ≤ c := by exact_mod_cast hc
  set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have hVs' : (V : Set X.functionField) ⊆ sectionsIn D := hVs
  /- The coefficients along the prime divisors of `Y`. -/
  have hcoef : ∀ n : ℕ, topologicalKrullDim X = n → ∀ P : MMP.Mori.PrimeDivisor Y,
      ∃ a₀ : ℕ,
        MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ ∧
        G.coeff P = ⌈(a₀ : ℝ) - c * F.coeff P⌉ - 1 +
          (if ((a₀ : ℕ) : ℝ) = 0 then 1 else 0) ∧
        (a₀ = 0 → F.coeff P = 0) ∧ (P ∉ s → a₀ = 1 ∧ F.coeff P = 0) := by
    intro n hn P
    set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
    have hFPp : IsProper FP.f := hlog.isProper
    obtain ⟨n', a', hla', hEP⟩ := hE P
    obtain ⟨a₀r, ha₀r⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ) FP hFPp
    rw [QDivisor.toRDivisor_toQDivisor] at ha₀r
    have ha' : a' = a₀r := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hla' ha₀r
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha₀r
    have hF0 : 0 ≤ F.coeff P :=
      coeff_nonneg_of_isFixedDivisorOfPullback hDc hVs' hDμ hfix P hY hμ
    refine ⟨a₀, ha₀r, ?_, ?_, ?_⟩
    · have hΓP := coeff_eq_ite_of_isZeroLogDiscrepancyDivisor sX hΓ ha₀r
      have hE' : E.coeff P = (a₀ : ℤ) - 1 + Γ.coeff P := by
        rw [ha'] at hEP
        exact_mod_cast hEP
      have hfl : ⌊(c : ℝ) * F.coeff P⌋ = (a₀ : ℤ) - ⌈(a₀ : ℝ) - c * F.coeff P⌉ := by
        have e : (c : ℝ) * F.coeff P = ((a₀ : ℤ) : ℝ) + -((a₀ : ℝ) - c * F.coeff P) := by
          push_cast; ring
        conv_lhs => rw [e]
        rw [Int.floor_intCast_add, Int.floor_neg]
        ring
      rw [hGdef, DivisorWithCoeffs.coeff_sub, MMP.Intersection.WeilRDivisor.coeff_roundDown,
        DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul, hfl, hE', hΓP]
      split_ifs <;> ring
    · intro h0
      subst h0
      have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ
        (fun x hx => closure_subset_baseLocusIn hx) hVns (F := FP) (by simpa using ha₀r)
      exact le_antisymm (coeff_nonpos_of_notMem_baseLocusIn hDc hVs' hDμ hfix P hY hμ hx) hF0
    · intro hPs
      have hPmem : P.genericPoint ∈ P.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
        intro hz
        obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
        exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
      rw [hs, Closeds.coe_sup, Closeds.coe_sup, Set.mem_union, Set.mem_union, not_or,
        not_or] at hnot
      obtain ⟨⟨hexc, hsuppΔ⟩, hsuppF⟩ := hnot
      have hsuppΔ' : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
          (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
        intro hmem
        apply hsuppΔ
        obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
        refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
        rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
        exact_mod_cast hΓ'
      have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hlog.isProper
        (Divisor.toQDivisor Δ) P hexc hsuppΔ'
      rw [QDivisor.toRDivisor_toQDivisor] at h1
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha₀r h1
      refine ⟨by exact_mod_cast this, ?_⟩
      by_contra hne
      exact hsuppF (DivisorWithCoeffs.support_subset_supp hne hPmem)
  funext U
  ext g
  constructor
  · /- `J ⊆ seriesSet`: the comparison along a model of the divisor on `Y`. -/
    rintro ⟨hg0, hgP⟩
    refine ⟨fun hU => hg0 (by rw [hU]; rfl), fun n F₀ a hx ha => ?_⟩
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
    obtain ⟨F', hF'p, hval, hcen⟩ := exists_divisorOver_model hX.1 μ hlog.isProper hμ hY F₀
    set y := F'.f F'.E.genericPoint with hy
    have hyU : y ∈ μ ⁻¹ᵁ U := by
      show μ y ∈ U
      rw [hcen]; exact hx
    have hnY : topologicalKrullDim Y = n :=
      (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans
        hn
    have hval' : ∀ t, F₀.valuation t = F'.valuation (functionFieldMap μ t) := fun t => by
      rw [hval]; rfl
    obtain ⟨g', hg'V, hg'0, hfr⟩ := hfree y
    have := F'.isLocallyNoetherian
    have := F'.isNormal
    have := F'.isIntegral
    have := F'.isBirationalMorphism.isDominant
    have : CompactSpace F'.Y :=
      (F'.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
    have hFc : F.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
    have hBF := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f F
    obtain ⟨F'', hF''⟩ := hFc.exists_isPullback hBF
    refine ⟨g', hg'V, hg'0, F''.coeff F'.E, ?_, ?_⟩
    · /- `w = ord_{F'}(F)` bounds `ord(g') + ord(D)`, by freeness at the centre. -/
      intro U' φ Z hφ hxU'
      rw [hval']
      set t := functionFieldMap μ (g' * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X)) with htdef
      have ht0 : t ≠ 0 := (map_ne_zero _).mpr (mul_ne_zero hg'0 (evalFF_ne_zero Z φ))
      have hnegc : ((-1 : ℤ) • F).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
      have hBn := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
        ((-1 : ℤ) • F)
      have hpn := hF''.zsmul hFc (-1) hBn
      have hle := valuation_le_exp_of_isPullback (F := F') hnegc (g := t⁻¹) (fun Γ' hΓ' => by
          have hsp : Γ'.genericPoint ⤳ y := by
            rw [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
            exact hΓ'
          have hμΓ : μ Γ'.genericPoint ∈ U' :=
            (hsp.map μ.continuous).mem_open U'.isOpen (by show μ y ∈ U'; rw [hcen]; exact hxU')
          have e1 : Γ'.divisorialValuation t = WithZero.exp (-F.coeff Γ') := by
            rw [htdef, ← MMP.Mori.PrimeDivisor.valuationOver_apply, Valuation.map_mul,
              hfr Γ' hΓ', valuationOver_evalFF_eq hDμ hφ Γ' hμΓ Z, ← WithZero.exp_add]
            congr 1; ring
          rw [map_inv₀, e1, DivisorWithCoeffs.coeff_smul, smul_eq_mul, ← WithZero.exp_neg]
          simp) _ hBn hpn
      rw [map_inv₀, DivisorWithCoeffs.coeff_smul, smul_eq_mul] at hle
      have hpos : 0 < F'.valuation t := by
        rw [zero_lt_iff]; exact (map_ne_zero _).mpr ht0
      have := (inv_le_comm₀ hpos (zero_lt_iff.mpr WithZero.exp_ne_zero)).mp hle
      rw [← WithZero.exp_neg] at this
      simpa using this
    · /- the valuation bound -/
      rcases eq_or_ne g 0 with rfl | hgne
      · simp
      obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
      obtain ⟨KY, hKY⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
      have hP0 : MMP.Mori.IsPair sX (Divisor.toQDivisor Δ) :=
        ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
      obtain ⟨B₀, hB₀⟩ :=
        (MMP.Mori.IsPair.existsUnique_isCrepantBoundary hP0 hK μ hY hμ).1.exists
      have hcr0 := (MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant hP0 μ hY hμ hK hKY
        (Or.inl hB₀)).2 F' F₀ hval
      obtain ⟨c₀, hc₀⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP0 hK F₀
      have ha₀c : a = 1 + c₀ :=
        MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc₀
          (by rwa [QDivisor.toRDivisor_toQDivisor])
      have hY0 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy
        ((hcr0 c₀).2 hc₀) hF'p
      -- the reduced snc divisor `T = ∑_{P ∈ s} P` on `Y` and `t = a(F', Y, T) ∈ ℕ`
      have hTred : MMP.Intersection.IsReducedEffective (MMP.Intersection.reducedDivisorOf s) :=
        fun P => by rw [MMP.Intersection.coeff_reducedDivisorOf]; split_ifs <;> simp
      obtain ⟨tr, htr⟩ := exists_isLogDiscrepancy hY hsmY hnY
        (Divisor.toQDivisor (MMP.Intersection.reducedDivisorOf s)) F' hF'p
      rw [QDivisor.toRDivisor_toQDivisor] at htr
      obtain ⟨t, rfl⟩ := MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC (μ ≫ sX) hY.1
        hsmY hTred hsnc htr
      choose a₀P ha₀P hGP hzP houtP using hcoef n hn
      have hcart : ∀ P : MMP.Mori.PrimeDivisor Y,
          Divisor.IsCartier (Finsupp.single P (1 : ℤ) : Divisor Y) := fun P =>
        MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
      choose P' hP' using fun P : MMP.Mori.PrimeDivisor Y => (hcart P).exists_isPullback
        (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f
          (Finsupp.single P (1 : ℤ) : Divisor Y))
      set e : MMP.Mori.PrimeDivisor Y → ℤ := fun P => (P' P).coeff F'.E with hedef
      have he : ∀ P ∈ s, ∀ (Q' : Divisor F'.Y) (hB : ∀ Z : irreducibleComponents F'.Y,
            F'.f (componentGenericPoint F'.Y Z) ∉
              DivisorWithCoeffs.supp (Finsupp.single P 1 : Divisor Y)),
          Divisor.IsPullback F'.f (Finsupp.single P 1 : Divisor Y) hB Q' →
            Q'.coeff F'.E = e P := by
        intro P _ Q' hB hQ'
        rw [hQ'.eq (hcart P) (hP' P)]
      have he0 : ∀ P ∈ s, 0 ≤ e P := fun P _ =>
        coeff_isPullback_nonneg (F := F') (hcart P) (fun Γ _ => by
          rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> simp) _ _
          (hP' P)
      -- the crepant boundary in terms of the coefficients
      have hB₀Q : ∀ Q, ((B₀.coeff Q : ℚ) : ℝ) = 1 - a₀P Q := by
        intro Q
        have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hB₀ Q)
          hlog.isProper
        rw [QDivisor.toRDivisor_toQDivisor] at hl
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀P Q) hl
        push_cast at this
        linarith
      have hb0 := toRDivisor_add_sum_eq s (fun P => -(a₀P P : ℝ)) (QDivisor.toRDivisor B₀)
        (fun Q _ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q]; ring)
        (fun Q hQ => by rw [QDivisor.coeff_toRDivisor, hB₀Q Q, (houtP Q hQ).1]; simp)
      have hsum0 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(a₀P P : ℝ)) e he
      rw [hb0] at hsum0
      have hA₀ : a = t + ∑ P ∈ s, (a₀P P : ℝ) * e P := by
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hY0 hsum0
        rw [ha₀c, this]
        simp only [neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add]
      -- `ord_{F'}(F) = ∑ F_P e_P`
      have hlF1 := isLogDiscrepancy_add_smul htr hFc (1 : ℝ) F'' hBF hF''
      have hlF2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => (F.coeff P : ℝ)) e he
      have hbF : (1 : ℝ) • Divisor.toRDivisor F =
          ∑ P ∈ s, (F.coeff P : ℝ) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor Y) := by
        refine (sum_smul_single_eq s _ _ (fun Q _ => ?_) (fun Q hQ => ?_)).symm
        · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor]; simp
        · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, (houtP Q hQ).2]; simp
      rw [hbF] at hlF1
      have hFe : (F''.coeff F'.E : ℝ) = ∑ P ∈ s, (F.coeff P : ℝ) * e P := by
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hlF1 hlF2
        linarith
      -- `v_F(g) ≤ exp (∑ G_P e_P)`
      have hGcart : Divisor.IsCartier (-G) := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
      have hBG := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F'.f (-G)
      obtain ⟨G', hG'⟩ := hGcart.exists_isPullback hBG
      have hR := valuation_le_exp_of_isPullback (F := F') hGcart (g := functionFieldMap μ g)
        (fun Γ hΓ => by
          rw [DivisorWithCoeffs.coeff_neg, neg_neg]
          exact hgP Γ ⟨y, hΓ, hyU⟩) G' hBG hG'
      have hl1 := isLogDiscrepancy_add_smul htr hGcart (1 : ℝ) G' hBG hG'
      have hl2 := isLogDiscrepancy_add_sum hsmY htr s (fun P => -(G.coeff P : ℝ)) e he
      have hG0 : ∀ Q ∉ s, G.coeff Q = 0 := by
        intro Q hQ
        rw [hGP Q, (houtP Q hQ).1, (houtP Q hQ).2]
        simp
      have hbG : (1 : ℝ) • Divisor.toRDivisor (-G) =
          ∑ P ∈ s, (-(G.coeff P : ℝ)) • Divisor.toRDivisor (Finsupp.single P 1 : Divisor Y) := by
        refine (sum_smul_single_eq s _ _ (fun Q _ => ?_) (fun Q hQ => ?_)).symm
        · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor,
            DivisorWithCoeffs.coeff_neg]
          simp
        · rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor,
            DivisorWithCoeffs.coeff_neg, hG0 Q hQ]
          simp
      rw [hbG] at hl1
      have hGe : (G'.coeff F'.E : ℝ) = -∑ P ∈ s, (G.coeff P : ℝ) * e P := by
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hl1 hl2
        simp only [one_mul, neg_mul, Finset.sum_neg_distrib, sub_neg_eq_add] at this
        linarith
      have hGe' : G'.coeff F'.E = -∑ P ∈ s, G.coeff P * e P := by exact_mod_cast hGe
      rw [hval']
      refine hR.trans ?_
      rw [hGe', neg_neg, WithZero.exp_le_exp]
      refine sum_mul_le_ceil s a₀P (fun P => (a₀P P : ℝ) - c * F.coeff P) e
        (fun P => G.coeff P) t he0 (fun P _ h0 => by simp [h0, hzP P h0])
        (fun P _ => hGP P) hA₀ ?_
      rw [hFe, hA₀, Finset.mul_sum, add_sub_assoc, ← Finset.sum_sub_distrib]
      congr 1
      refine Finset.sum_congr rfl fun P _ => ?_
      ring
  · /- `seriesSet ⊆ J`: test against the prime divisors of `Y`. -/
    rintro ⟨hg0, hg⟩
    refine ⟨fun hU => hg0 ((preimage_eq_bot_iff μ U).1 hU), fun P hP => ?_⟩
    have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
    obtain ⟨n, a, hla, -⟩ := hE P
    have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hla
    obtain ⟨a₀, ha₀, hGP, -, -⟩ := hcoef n hn P
    obtain ⟨g', hg'V, -, w, hw, hv⟩ := hg n ⟨Y, μ, hY, hμ, P⟩ a₀ hxU ha₀
    obtain ⟨U', φ, hφ, hxU', hvalφ⟩ := valuationOver_mul_evalFF hDμ hDc P g'
    have h1 := hw U' φ Z₀ hφ hxU'
    change _ ≤ P.valuationOver μ _ at h1
    rw [hvalφ Z₀] at h1
    have h2 := (hfix P).1 g' hg'V
    have h3 : WithZero.exp (-w) ≤ WithZero.exp (-F.coeff P) := by
      refine h1.trans ((mul_le_mul_left h2 _).trans_eq ?_)
      rw [← WithZero.exp_add]
      congr 1; ring
    rw [WithZero.exp_le_exp] at h3
    change P.valuationOver μ g ≤ _ at hv
    rw [hGP]
    refine hv.trans (WithZero.exp_le_exp.mpr ?_)
    have hFw : (F.coeff P : ℝ) ≤ w := by exact_mod_cast (show F.coeff P ≤ w by omega)
    have : ⌈(a₀ : ℝ) - c * w⌉ ≤ ⌈(a₀ : ℝ) - c * F.coeff P⌉ :=
      Int.ceil_mono (by nlinarith)
    omega

end SeriesMain

/-! ### Comparing the adjoint ideal of a series with that of a member -/

section SeriesAdjoint

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- `⌈n - x⌉ = n - ⌊x⌋` for an integer `n`. -/
private theorem ceil_natCast_sub (n : ℕ) (x : ℝ) : ⌈(n : ℝ) - x⌉ = n - ⌊x⌋ := by
  rw [sub_eq_add_neg, show ((n : ℝ)) = ((n : ℤ) : ℝ) by simp, Int.ceil_intCast_add, Int.ceil_neg]
  ring

/-- **The adjoint ideal of a series lies in that of a `ℚ`-divisor computed on one model.** Let
`μ : Y ⟶ X` be a proper birational morphism from a smooth variety and `s` a finite set of prime
divisors of `Y` with snc reduced sum whose union contains `Ex(μ) ∪ μ⁻¹ Supp(Δ + D)`, and let
`D₀ = mD` be integral with pull-back `D₀'`. If a divisor `F'` on `Y` bounds the pulled-back
members of the series `V ⊆ H⁰(X, 𝒪_X(L))` from below and `⌊coeff(D₀')/m⌋ ≤ ⌊c · coeff(F')⌋`
along every prime divisor of `Y`, then `𝒥_{Δ,cV} ⊆ 𝒥_{Δ,D}`. -/
private theorem seriesSet_subset_adjointSet [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {L : Divisor X} (hLc : L.IsCartier) {V : Set X.functionField}
    {c : ℚ} (hc : 0 ≤ c) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hDns : ContainsNoStratum Δ D.supp)
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    (hμp : IsProper μ) (hsmY : IsSmoothScheme (μ ≫ sX)) {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) :
        Set Y) ⊆ ⋃ E ∈ s, E.support)
    (hsnc : DivisorWithCoeffs.IsSNC (μ ≫ sX) (∑ E ∈ s, Finsupp.single E (1 : ℤ)))
    {m : ℕ} (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier)
    {hD₀μ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D₀.supp}
    {D₀' : Divisor Y} (hD₀' : D₀.IsPullback μ hD₀μ D₀') (F' : Divisor Y)
    (hfix : ∀ g ∈ V, g ≠ 0 → ∀ (P : MMP.Mori.PrimeDivisor Y) (U : X.Opens)
      (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      L.IsLocalEquation U φ → μ P.genericPoint ∈ U →
      P.valuationOver μ (g * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X)) ≤ WithZero.exp (-F'.coeff P))
    (hfloor : ∀ P, ⌊((D₀'.coeff P : ℤ) : ℝ) / m⌋ ≤ ⌊(c : ℝ) * F'.coeff P⌋) (U : X.Opens) :
    seriesSet sX Δ L V c U ⊆ adjointSet sX Δ D U := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  -- the log discrepancies of the prime divisors of `Y`
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hμp
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  set val : MMP.Mori.PrimeDivisor Y → ℤ := fun P =>
    ⌈(a₀ P : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m⌉ - 1 + if a₀ P = 0 then 1 else 0 with hval
  have hval0 : ∀ P, P ∉ s → val P = 0 := by
    intro P hPs
    obtain ⟨h0, h1⟩ := isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hμp
      hs hPs
    have e0 : (a₀ P : ℝ) = 1 := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) h0
    have hα := isLogDiscrepancy_add_of_zsmul (ha₀ P) hm hD₀ hD₀c D₀' _ hD₀'
    have e1 := MMP.Threefold.Bridges.IsLogDiscrepancy.unique hα h1
    have e2 : a₀ P = 1 := by exact_mod_cast e0
    have e3 : (a₀ P : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m = 1 := e1
    show ⌈(a₀ P : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m⌉ - 1 + (if a₀ P = 0 then 1 else 0) = 0
    rw [e3, e2]
    norm_num
  set G : Divisor Y := Finsupp.onFinset s (fun P => if P ∈ s then val P else 0) (fun P hP => by
    by_contra h; exact hP (if_neg h)) with hGdef
  have hGc : ∀ P, G.coeff P = val P := by
    intro P
    change (if P ∈ s then val P else 0) = val P
    split_ifs with h
    · rfl
    · exact (hval0 P h).symm
  have hG : ∀ (n' : ℕ) (P : MMP.Mori.PrimeDivisor Y) (a : ℕ),
      MMP.Intersection.IsLogDiscrepancy sX n' (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a →
      G.coeff P = ⌈(a : ℝ) - (D₀'.coeff P : ℝ) / m⌉ - 1 + if a = 0 then 1 else 0 := by
    intro n' P a ha
    have e : a = a₀ P := by
      exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha (ha₀ P)
    rw [hGc, e]
  refine fun g hg => multiplierIdealSections_subset_adjointSet sX hX hsm hΔ hD0 hDns hY hμ hμp
    hsmY hs hsnc hm hD₀ hD₀c hD₀' G hG U
    ⟨fun h0 => hg.1 ((preimage_eq_bot_iff μ U).1 h0), fun P hP => ?_⟩
  have hxU := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
  obtain ⟨g', hg'V, hg'0, w, hw, hgw⟩ := hg.2 n ⟨Y, μ, hY, hμ, P⟩ (a₀ P) hxU (ha₀ P)
  obtain ⟨U', hxU', φ, hφ⟩ := hLc (μ P.genericPoint)
  set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  have h1 := (hw U' φ Z₀ hφ hxU').trans (hfix g' hg'V hg'0 P U' φ Z₀ hφ hxU')
  rw [WithZero.exp_le_exp, neg_le_neg_iff] at h1
  have hgw' : P.valuationOver μ g ≤
      WithZero.exp (⌈(a₀ P : ℝ) - (c : ℝ) * w⌉ - 1 + if (a₀ P : ℝ) = 0 then 1 else 0) := hgw
  refine hgw'.trans (WithZero.exp_le_exp.mpr ?_)
  rw [hGc]
  show _ ≤ ⌈(a₀ P : ℝ) - ((D₀'.coeff P : ℤ) : ℝ) / m⌉ - 1 + if a₀ P = 0 then 1 else 0
  have hif : (if (a₀ P : ℝ) = 0 then (1 : ℤ) else 0) = if a₀ P = 0 then 1 else 0 := by
    by_cases h : a₀ P = 0 <;> simp [h]
  rw [hif]
  have h2 : ⌈(a₀ P : ℝ) - (c : ℝ) * w⌉ ≤ ⌈(a₀ P : ℝ) - (c : ℝ) * F'.coeff P⌉ := by
    refine Int.ceil_mono ?_
    have : (c : ℝ) * F'.coeff P ≤ (c : ℝ) * w :=
      mul_le_mul_of_nonneg_left (by exact_mod_cast h1) (by exact_mod_cast hc)
    linarith
  have e1 := ceil_natCast_sub (a₀ P) ((c : ℝ) * F'.coeff P)
  have e2 := ceil_natCast_sub (a₀ P) (((D₀'.coeff P : ℤ) : ℝ) / m)
  have := hfloor P
  omega

end SeriesAdjoint

/-! ### Operations on the valuative description -/

section SeriesOps

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsNormal X] in
/-- `v_z(a b⁻¹) = v_z(a) - v_z(b)`. -/
private theorem ord_mul_inv {a b : X.functionField} (ha : a ≠ 0) (hb : b ≠ 0) (z : X) :
    X.ord (a * b⁻¹) z = X.ord a z - X.ord b z := by
  rw [← zpow_neg_one b, Scheme.ord_mul ha (zpow_ne_zero _ hb), MMP.Mori.ord_zpow _ hb]
  ring

/-- **Passing to a multiple of the series.** If `g ^ m ∈ V'` for every `g ∈ V`, the
valuative description for `(D, V, c)` is contained in the one for `(mD, V', c/m)`. -/
private theorem seriesSet_subset_nsmul {Δ D : Divisor X} {V V' : Set X.functionField} {c : ℚ}
    {m : ℕ} (hm : 0 < m) (hDc : D.IsCartier) (hV : ∀ g ∈ V, g ^ m ∈ V') (U : X.Opens) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ ((m : ℤ) • D) V' (c / m) U := by
  rintro g ⟨hg0, hg⟩
  refine ⟨hg0, fun n G a hx ha => ?_⟩
  obtain ⟨g', hg'V, hg'0, w, hw, hv⟩ := hg n G a hx ha
  refine ⟨g' ^ m, hV _ hg'V, pow_ne_zero _ hg'0, m * w, fun U' φ' Z hφ' hxU' => ?_, ?_⟩
  · obtain ⟨U'', hxU'', φ, hφ⟩ := hDc (G.f G.E.genericPoint)
    have h1 := hw U'' φ Z hφ hxU''
    have hφm := hφ.zsmul (m : ℤ)
    rw [zpow_natCast] at hφm
    set e := MMP.Threefold.Mori.Helpers.evalFF Z (φ : MMP.Mori.RationalFunctions X)
    set e' := MMP.Threefold.Mori.Helpers.evalFF Z (φ' : MMP.Mori.RationalFunctions X)
    have he : e ≠ 0 := evalFF_ne_zero Z φ
    have he' : e' ≠ 0 := evalFF_ne_zero Z φ'
    have hem : MMP.Threefold.Mori.Helpers.evalFF Z ((φ ^ m : (MMP.Mori.RationalFunctions X)ˣ) :
        MMP.Mori.RationalFunctions X) = e ^ m := by
      rw [Units.val_pow_eq_pow_val, map_pow]
    have hu : G.valuation (e' * (e ^ m)⁻¹) = 1 := by
      refine valuation_eq_one_of_forall_ord_eq_zero G (mul_ne_zero he' (inv_ne_zero
        (pow_ne_zero _ he))) fun Γ hΓ => ?_
      rw [ord_mul_inv he' (pow_ne_zero _ he), ord_evalFF_of_isLocalEquation hφ' Z Γ ⟨_, hΓ, hxU'⟩,
        ← hem, ord_evalFF_of_isLocalEquation hφm Z Γ ⟨_, hΓ, hxU''⟩]
      ring
    have e2 : g' ^ m * e' = (g' * e) ^ m * (e' * (e ^ m)⁻¹) := by
      field_simp
      ring
    have e3 : WithZero.exp (-((m : ℤ) * w)) = WithZero.exp (-w) ^ m := by
      rw [← WithZero.exp_nsmul]
      congr 1
      simp
    rw [e2, Valuation.map_mul, hu, mul_one, Valuation.map_pow, e3]
    exact pow_le_pow_left₀ zero_le' h1 m
  · have e1 : ((c / m : ℚ) : ℝ) * (((m : ℤ) * w : ℤ) : ℝ) = (c : ℝ) * w := by
      have : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
      push_cast
      field_simp
    rw [e1]
    exact hv

/-- **The valuative description consists of regular functions.** -/
private theorem seriesSet_subset_range [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ D : Divisor X} (hΔ : IsReducedSNC sX Δ)
    {V : Set X.functionField} (hVs : V ⊆ sectionsIn D) (hDc : D.IsCartier) {c : ℚ}
    (hc : 0 ≤ c) (U : X.Opens) [Nonempty U] :
    seriesSet sX Δ D V c U ⊆ Set.range (X.germToFunctionField U) := by
  intro g hg
  rcases eq_or_ne g 0 with rfl | hg0
  · exact ⟨0, map_zero _⟩
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  refine (MMP.Intersection.exists_germToFunctionField_eq_iff_forall_zero_le_ord U hg0).mpr
    fun Q hQ => ?_
  have hxU : (DivisorOver.ofPrimeDivisor k hX Q).f
      (DivisorOver.ofPrimeDivisor k hX Q).E.genericPoint ∈ U :=
    MMP.Intersection.genericPoint_mem_of_support_inter_nonempty Q hQ
  have h0 := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn (Divisor.toQDivisor Δ) Q
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  obtain ⟨g', hg'V, -, w, hw, hv⟩ := hg.2 n _ _ hxU h0
  have hw0 := nonneg_of_forall_exp_neg_le _ hDc (hVs hg'V) hw
  rw [valuation_ofPrimeDivisor] at hv
  have hle1 : Q.divisorialValuation g ≤ 1 := by
    refine hv.trans ?_
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]
    refine ceil_sub_one_add_ite_nonpos ?_ ?_
    · rw [Divisor.coeff_toQDivisor]
      rcases hΔ.1 Q with h | h <;> rw [h] <;> norm_num
    · have : (0 : ℝ) ≤ (c : ℝ) * w :=
        mul_nonneg (by exact_mod_cast hc) (by exact_mod_cast hw0)
      linarith
  rw [Q.divisorialValuation_eq_exp_neg_ord hg0, ← WithZero.exp_zero, WithZero.exp_le_exp]
    at hle1
  omega

/-- The valuative description restricts to smaller non-empty opens. -/
private theorem seriesSet_mono_open {Δ D : Divisor X} {V : Set X.functionField} {c : ℚ}
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ D V c W :=
  fun _ hg => ⟨fun h => absurd h hW, fun n G a hx => hg.2 n G a (hWU hx)⟩

/-- **The valuative description is local.** A comparison of two valuative descriptions on the
non-empty affine opens inside `U` gives the comparison on `U`. -/
private theorem seriesSet_subset_of_affine {Δ Δ' D D' : Divisor X} {V V' : Set X.functionField}
    {c c' : ℚ} {U : X.Opens}
    (h : ∀ W : X.affineOpens, (W : X.Opens) ≤ U → Nonempty (W : X.Opens) →
      seriesSet sX Δ D V c W ⊆ seriesSet sX Δ' D' V' c' W) :
    seriesSet sX Δ D V c U ⊆ seriesSet sX Δ' D' V' c' U := by
  intro g hg
  refine ⟨hg.1, fun n G a hx ha => ?_⟩
  obtain ⟨W, hW, hxW, hWU⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) hx
  have hW0 : (W : X.Opens) ≠ ⊥ :=
    (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hxW⟩
  exact (h ⟨W, hW⟩ hWU ⟨⟨_, hxW⟩⟩ (seriesSet_mono_open sX hWU hW0 hg)).2 n G a hxW ha

end SeriesOps

/-! ### Stabilization of the asymptotic adjoint ideal -/

section Asymptotic

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {Z : Scheme.{u}} (f : X ⟶ Z)

/-- In a graded linear series, `g ∈ V_p` gives `g ^ m ∈ V_{pm}`. -/
private theorem pow_mem_of_isGradedLinearSeries {D : Divisor X}
    {V : ℕ → AddSubgroup X.functionField} (hV : IsGradedLinearSeries f D V) {p : ℕ}
    {g : X.functionField} (hg : g ∈ V p) (m : ℕ) : g ^ m ∈ V (p * m) := by
  induction m with
  | zero => simpa using hV.2.2.1
  | succ m ih =>
    rw [pow_succ, Nat.mul_succ]
    exact hV.2.2.2 _ _ _ _ ih hg

/-- **The valuative descriptions increase along divisibility.** For a graded linear series `V_•`
of the Cartier divisor `D` and `p ∣ q`, the description of `𝒥_{Δ,(c/p)V_p}` is contained in the
one of `𝒥_{Δ,(c/q)V_q}`. -/
private theorem seriesSet_subset_of_dvd {Δ D : Divisor X} {V : ℕ → AddSubgroup X.functionField}
    (hV : IsGradedLinearSeries f D V) (hDc : D.IsCartier) {c : ℚ} {p q : ℕ}
    (hq : 0 < q) (hpq : p ∣ q) (U : X.Opens) :
    seriesSet sX Δ ((p : ℤ) • D) (V p) (c / p) U ⊆
      seriesSet sX Δ ((q : ℤ) • D) (V q) (c / q) U := by
  obtain ⟨m, rfl⟩ := hpq
  have hm : 0 < m := Nat.pos_of_mul_pos_left hq
  have h := seriesSet_subset_nsmul sX (Δ := Δ) (V := (V p : Set X.functionField))
    (V' := (V (p * m) : Set X.functionField)) (c := c / p) hm (hDc.zsmul p)
    (fun g hg => pow_mem_of_isGradedLinearSeries f hV hg m) U
  have e1 : (m : ℤ) • ((p : ℤ) • D) = (((p * m : ℕ) : ℤ)) • D := by
    rw [smul_smul]; push_cast; ring_nf
  have e2 : c / (p : ℚ) / (m : ℚ) = c / ((p * m : ℕ) : ℚ) := by
    push_cast; rw [div_div]
  rwa [e1, e2] at h

/-- **Stabilization.** For the asymptotic adjoint ideal `𝒥_{Δ,cV_•}`, some `p₀ ∈ bℤ_{>0}` has the
valuative description of `𝒥_{Δ,(c/q)V_q}` independent of `q` for all positive multiples `q` of
`p₀`, and that description is given on non-empty affine opens by an ideal sheaf. -/
private theorem exists_seriesSet_stabilizes [IsAlgClosed k] [CharZero k] {Δ D : Divisor X}
    {V : ℕ → AddSubgroup X.functionField} {b : ℕ} {c : ℚ} {J : X.Opens → Set X.functionField}
    (h : IsAsymptoticAdjointIdeal sX f Δ D V b c J) :
    ∃ p₀ : ℕ, 0 < p₀ ∧ b ∣ p₀ ∧
      (∃ I : X.IdealSheafData, ∀ (U : X.affineOpens) [Nonempty (U : X.Opens)],
        seriesSet sX Δ ((p₀ : ℤ) • D) (V p₀) (c / p₀) U =
          X.germToFunctionField (U : X.Opens) '' (I.ideal U : Set Γ(X, U))) ∧
      ∀ q : ℕ, 0 < q → p₀ ∣ q → ∀ (U : X.Opens), Nonempty U →
        seriesSet sX Δ ((q : ℤ) • D) (V q) (c / q) U =
          seriesSet sX Δ ((p₀ : ℤ) • D) (V p₀) (c / p₀) U := by
  classical
  obtain ⟨-, -, hX, hsm, hΔ, hDc, hgr, hb, -, -, hc, Jp, hJp, -⟩ := h
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  set S : ℕ → X.Opens → Set X.functionField :=
    fun p => seriesSet sX Δ ((p : ℤ) • D) (V p) (c / p) with hSdef
  have hS : ∀ p, 0 < p → b ∣ p → Jp p = S p := fun p hp hbp => by
    obtain ⟨Y, μ, hOn⟩ := hJp p hp hbp
    exact eq_seriesSet sX hOn
  have hrange : ∀ p, 0 < p → ∀ (U : X.Opens) [Nonempty U],
      S p U ⊆ Set.range (X.germToFunctionField U) := fun p hp U _ =>
    seriesSet_subset_range sX hX hsm hΔ (hgr.1 p) (hDc.zsmul p)
      (div_nonneg hc.le (Nat.cast_nonneg _)) U
  have hI : ∀ p, 0 < p → b ∣ p → ∃ I : X.IdealSheafData, ∀ (U : X.affineOpens)
      [Nonempty (U : X.Opens)], S p U = X.germToFunctionField (U : X.Opens) ''
        (I.ideal U : Set Γ(X, U)) := by
    intro p hp hbp
    obtain ⟨Y, μ, hOn⟩ := hJp p hp hbp
    obtain ⟨-, -, -, -, -, -, -, i1, i2, i3, i4, -, -, -, Dμ, F, Γ, E, -, -, -, -, hJeq⟩ := hOn
    obtain ⟨I, hIeq⟩ := exists_idealSheafData_of_subset_range μ _ (fun U _ => by
      rw [← hJeq, hS p hp hbp]; exact hrange p hp U)
    exact ⟨I, fun U _ => by rw [← hS p hp hbp, hJeq]; exact hIeq U⟩
  -- the chain `p_m = b · m!`
  set pm : ℕ → ℕ := fun m => b * m.factorial with hpmdef
  have hpm0 : ∀ m, 0 < pm m := fun m => Nat.mul_pos hb (Nat.factorial_pos m)
  have hbpm : ∀ m, b ∣ pm m := fun m => dvd_mul_right b _
  choose I hIeq using hI
  set Im : ℕ → X.IdealSheafData := fun m => I (pm m) (hpm0 m) (hbpm m) with hImdef
  have hmono : ∀ (U : X.affineOpens), Nonempty (U : X.Opens) → ∀ m,
      (Im m).ideal U ≤ (Im (m + 1)).ideal U := by
    intro U hU m a ha
    have h1 : X.germToFunctionField (U : X.Opens) a ∈ S (pm m) U := by
      rw [hIeq (pm m) (hpm0 m) (hbpm m) U]; exact ⟨a, ha, rfl⟩
    have h2 := seriesSet_subset_of_dvd sX f hgr hDc (hpm0 (m + 1))
      (mul_dvd_mul_left b (Nat.factorial_dvd_factorial (Nat.le_succ m))) U h1
    change _ ∈ S (pm (m + 1)) U at h2
    rw [hIeq (pm (m + 1)) (hpm0 (m + 1)) (hbpm (m + 1)) U] at h2
    obtain ⟨a', ha', he⟩ := h2
    rwa [← Scheme.germToFunctionField_injective X (U : X.Opens) he]
  -- a finite affine cover
  have hcov : ∀ x : X, ∃ U : X.affineOpens, x ∈ (U : X.Opens) := fun x => by
    obtain ⟨W, hW, hxW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
    exact ⟨⟨W, hW⟩, hxW⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun U : X.affineOpens => (U : Set X))
    (fun U => (U : X.Opens).isOpen) (fun x _ => Set.mem_iUnion.mpr (hcov x))
  have hstab : ∀ (U : X.affineOpens) (hU : Nonempty (U : X.Opens)), ∃ n, ∀ m, n ≤ m →
      (Im n).ideal U = (Im m).ideal U := fun U hU =>
    (monotone_stabilizes_iff_noetherian (R := Γ(X, U)) (M := Γ(X, U))).mpr
      (IsLocallyNoetherian.component_noetherian U)
      ⟨fun m => (Im m).ideal U, monotone_nat_of_le_succ (hmono U hU)⟩
  set Ng : X.affineOpens → ℕ := fun U => if hU : Nonempty (U : X.Opens) then
    (hstab U hU).choose else 0 with hNgdef
  set N := t.sup Ng with hNdef
  have hIN : ∀ m, N ≤ m → Im m = Im N := by
    intro m hm
    refine Scheme.IdealSheafData.ext_of_iSup_eq_top (ι := {U : X.affineOpens //
      U ∈ t ∧ Nonempty (U : X.Opens)}) (fun i => i.1) ?_ fun i => ?_
    · refine eq_top_iff.mpr fun x _ => ?_
      obtain ⟨U, hUt, hxU⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hUt, ⟨⟨x, hxU⟩⟩⟩, hxU⟩
    · obtain ⟨U, hUt, hU⟩ := i
      have hle : Ng U ≤ N := Finset.le_sup hUt
      have hNg : Ng U = (hstab U hU).choose := by rw [hNgdef]; exact dif_pos hU
      have h1 := (hstab U hU).choose_spec m (hNg ▸ hle.trans hm)
      have h2 := (hstab U hU).choose_spec N (hNg ▸ hle)
      exact h1.symm.trans h2
  refine ⟨pm N, hpm0 N, hbpm N, ⟨Im N, fun U _ => hIeq (pm N) (hpm0 N) (hbpm N) U⟩,
    fun q hq hNq U hU => ?_⟩
  have hbq : b ∣ q := (hbpm N).trans hNq
  set M := max N q
  have hqM : q ∣ pm M := dvd_mul_of_dvd_right (Nat.dvd_factorial hq (le_max_right N q)) b
  have haff : ∀ W : X.affineOpens, Nonempty (W : X.Opens) → S q W = S (pm N) W := by
    intro W hW
    refine le_antisymm (fun g hg => ?_)
      (seriesSet_subset_of_dvd sX f hgr hDc hq hNq W)
    have h1 := seriesSet_subset_of_dvd sX f hgr hDc (hpm0 M) hqM W hg
    change g ∈ S (pm M) W at h1
    have hIM : I (pm M) (hpm0 M) (hbpm M) = I (pm N) (hpm0 N) (hbpm N) :=
      hIN M (le_max_left N q)
    rw [hIeq (pm M) (hpm0 M) (hbpm M) W, hIM] at h1
    change g ∈ S (pm N) W
    rw [hIeq (pm N) (hpm0 N) (hbpm N) W]
    exact h1
  exact le_antisymm (seriesSet_subset_of_affine sX fun W _ hW => (haff W hW).le)
    (seriesSet_subset_of_affine sX fun W _ hW => (haff W hW).ge)

end Asymptotic

/-! ### Restriction of a principal divisor to a smooth prime divisor -/

section Restriction

variable {k : Type u} [Field k] {X T : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [Smooth sX] (j : T ⟶ X) [IsClosedImmersion j]
  [IsIntegral T] [IsLocallyNoetherian T] [Smooth (j ≫ sX)]

include sX in
/-- **The restriction of a Cartier divisor has the restricted local equation.** Let `S` be a
smooth prime divisor of the smooth `X`, not a component of the Cartier divisor `M`, and `a` a
unit of `𝒪_{X,η_S}` representing a local equation `φ` of `M` on `V`. At every prime divisor `Q`
of `S` with `η_Q ∈ V`, the coefficient of `Q` in `M|_S` is the order of `a|_S`. -/
private theorem coeff_restrictPrimeDivisor_eq_ord (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (a : X.presheaf.stalk (haveI := S.integral;
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))) (ha : IsUnit a)
    (Z : irreducibleComponents X)
    (haφ : algebraMap _ X.functionField a =
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X))
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord ((S.idealSheaf.subschemeι.stalkMap
        (genericPoint S.idealSheaf.subscheme)).hom a) Q.genericPoint := by
  haveI := S.integral
  classical
  have hordE : ∀ E : MMP.Mori.PrimeDivisor X,
      X.ord (algebraMap _ X.functionField a) E.genericPoint = E.ord φ := by
    intro E
    rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, haφ]
    rw [Subsingleton.elim
      (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := X)) Z E.component]
  set s := M.support ∪ (principalDivisor φ).support with hs
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor M S hM Q,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX S.idealSheaf.subschemeι a ha Q s
      (fun E hE => by
        rw [hordE] at hE
        refine Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr ?_)
        rw [← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor]
        exact hE)]
  rw [Finsupp.sum, Finset.sum_subset (Finset.subset_union_left (s₂ := (principalDivisor φ).support))
    (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [hordE, nsmul_eq_mul]
  by_cases hmem : S.idealSheaf.subschemeι Q.genericPoint ∈ E.support
  · rw [← DivisorWithCoeffs.coeff_apply, hφ E ⟨_, hmem, hQ⟩]
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hmem]
    simp

include sX in
/-- `coeff_restrictPrimeDivisor_eq_ord` for a unit at the image of any point `t = η_S` of `S`,
representing the local equation through the component of `X` containing it. -/
private theorem coeff_restrictPrimeDivisor_eq_ord_of_eq (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (t : haveI := S.integral; S.idealSheaf.subscheme)
    (ht : haveI := S.integral; t = genericPoint S.idealSheaf.subscheme)
    (a : (X.presheaf.stalk (haveI := S.integral; S.idealSheaf.subschemeι t))ˣ)
    {W : irreducibleComponents X} (hW : (haveI := S.integral; S.idealSheaf.subschemeι t) ∈ W.1)
    (ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) W)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord (algebraMap (S.idealSheaf.subscheme.presheaf.stalk t)
        S.idealSheaf.subscheme.functionField
        ((S.idealSheaf.subschemeι.stalkMap t).hom a)) Q.genericPoint := by
  haveI := S.integral
  subst ht
  rw [coeff_restrictPrimeDivisor_eq_ord sX S M hM hφ a.val a.isUnit W ?_ Q hQ]
  · congr 1
    change _ = (S.idealSheaf.subscheme.presheaf.stalkSpecializes (specializes_refl _)).hom _
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    rfl
  · change _ = (X.presheaf.stalkSpecializes _).hom ((φ : RationalFunctions X) W)
    rw [← ha]
    change _ = (stalkToRationalFunctions X hW ≫ X.presheaf.stalkSpecializes _).hom a.val
    rw [stalkToRationalFunctions, TopCat.Presheaf.stalkSpecializes_comp]
    rfl

end Restriction

/-! ### Members of linear series and the model of a general member -/

section Construction

variable {k : Type u} [Field k]

/-! ### Rational functions and their divisors -/

section RationalFunctions

variable {X : Scheme.{u}} [IsIntegral X]

private theorem germ_eq_rationalFunctionsEquivFunctionField_symm (U : X.Opens) (s : Γ(X, U))
    (h : genericPoint X ∈ U) (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ U) :
    (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s) Z =
      X.presheaf.germ U (componentGenericPoint X Z) hZ s := by
  haveI : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hd : Dense (U : Set X) := U.isOpen.dense ⟨_, h⟩
  let D : Stacks.Chow.DenseOpen X := ⟨U, hd⟩
  have key : (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s)
      = (Stacks.Chow.rationalFunctionsEquivStalks X).1 (Stacks.Chow.ofSection X D s) := by
    rw [RingEquiv.symm_apply_eq, ← (Stacks.Chow.rationalFunctionsEquivFunctionField X).2 D s h]
    change _ = (Stacks.Chow.rationalFunctionsEquivFunctionField X).1
      ((Stacks.Chow.rationalFunctionsEquivStalks X).1.symm _)
    rw [RingEquiv.symm_apply_apply]
  rw [key]
  exact (Stacks.Chow.rationalFunctionsEquivStalks X).2 D s Z hZ

variable [IsLocallyNoetherian X] [IsNormal X]

end RationalFunctions

/-- An element of the local ring at `y` has nonnegative order along every prime divisor
through `y`. -/
private theorem ord_algebraMap_nonneg {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support) (a : Y.presheaf.stalk y)
    (ha : algebraMap (Y.presheaf.stalk y) Y.functionField a ≠ 0) :
    0 ≤ Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField a) P.genericPoint := by
  have hsp : P.genericPoint ⤳ y := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hP
    exact specializes_iff_mem_closure.mpr hP
  rw [← MMP.Mori.algebraMap_stalkSpecializes hsp] at ha ⊢
  set b := (Y.presheaf.stalkSpecializes hsp).hom a
  have hx := P.coheight_genericPoint
  rw [Scheme.le_ord_iff hx ha]
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk P.genericPoint) := krullDimLE_of_coheight_le hx.le
  have hb0 : b ≠ 0 := by rintro hb; simp [hb] at ha
  change _ ≤ Ring.ordFrac (Y.presheaf.stalk P.genericPoint) _
  rw [Ring.ordFrac_eq_ord _ hb0]
  have hnz : b ∈ nonZeroDivisors (Y.presheaf.stalk P.genericPoint) :=
    mem_nonZeroDivisors_of_ne_zero hb0
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (Ring.ord_ne_top hnz)
  simp only [Ring.ordMonoidWithZeroHom, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk, hnz, if_true,
    ← hn]
  simp only [ENat.recTopCoe_coe, WithZero.one_le_coe]
  exact WithZero.coe_le_coe.mpr (Multiplicative.ofAdd_le.mpr (by exact_mod_cast Nat.zero_le n))

/-- A unit of the local ring at `y` has order zero along every prime divisor through `y`. -/
private theorem ord_algebraMap_eq_zero_of_isUnit {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support)
    {v : Y.presheaf.stalk y} (hv : IsUnit v) :
    Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField v) P.genericPoint = 0 := by
  obtain ⟨w, rfl⟩ := hv
  have h1 : algebraMap (Y.presheaf.stalk y) Y.functionField (w : Y.presheaf.stalk y) ≠ 0 :=
    (w.isUnit.map _).ne_zero
  have h2 : algebraMap (Y.presheaf.stalk y) Y.functionField ((w⁻¹ : (Y.presheaf.stalk y)ˣ) :
      Y.presheaf.stalk y) ≠ 0 := (w⁻¹.isUnit.map _).ne_zero
  have h3 := Scheme.ord_mul (x := P.genericPoint) h1 h2
  rw [← map_mul, Units.mul_inv, map_one, Scheme.ord_one] at h3
  have := ord_algebraMap_nonneg P hP _ h1
  have := ord_algebraMap_nonneg P hP _ h2
  omega

/-- In a local ring, if `∑ aᵢ bᵢ = 1` then some `bᵢ` is a unit. -/
private theorem exists_isUnit_of_sum_mul_eq_one {R : Type*} [CommRing R] [IsLocalRing R]
    {ι : Type*} (s : Finset ι) (a b : ι → R) (h : ∑ i ∈ s, a i * b i = 1) :
    ∃ i ∈ s, IsUnit (b i) := by
  by_contra hne
  push Not at hne
  apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  rw [Ideal.eq_top_iff_one, ← h]
  exact Ideal.sum_mem _ fun i hi =>
    Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hne i hi))

section GlobalGeneration

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **A generating family has a member whose divisor of zeros misses a point where the divisor
is Cartier.** If the global sections `sᵢ` generate `𝒪_X(D)` and `ψ` is a local equation of `D`
near `x`, write `sᵢ = gᵢ ψ⁻¹` near `x`; since the germs of the `sᵢ` span the stalk, some `gᵢ` is a
unit at `x`, and then `(sᵢ)₀ = div(gᵢ)` misses `x`. -/
private theorem exists_notMem_supp_zeroDivisor {D : Divisor X}
    (σ : D.divisorialSheaf.GeneratingSections) [Finite σ.I] {W : X.Opens}
    {ψ : (RationalFunctions X)ˣ} (hψ : D.IsLocalEquation W ψ) {x : X} (hx : x ∈ W) :
    ∃ i, ∃ hi : ((σ.s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0,
      x ∉ (D.zeroDivisor _ hi).supp := by
  classical
  have hspan := (AlgebraicGeometry.generates_iff_stalkwise_generates _ _ σ.s).mp σ.epi x
  have hfin : Finite σ.I := inferInstance
  revert hspan hfin
  obtain ⟨I, s, -⟩ := σ
  intro hspan hfin
  haveI := Fintype.ofFinite I
  dsimp only at hspan ⊢
  set b : Γ(D.divisorialSheaf, W) := hψ.invSection with hb
  have hgen := hψ.isLocalGenerator_invSection
  have hs : ∀ i, ∃ g : Γ(X, W), g • D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b =
      D.divisorialSheaf.presheaf.map (homOfLE le_top).op ((s i).eval (Opposite.op ⊤)) :=
    fun i => (hgen W le_rfl).2 _
  choose g hg using hs
  have hbW : D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b = b := by
    have h1 : (homOfLE (le_refl W)).op = 𝟙 (Opposite.op W) := rfl
    rw [h1, CategoryTheory.Functor.map_id]; rfl
  rw [hbW] at hg
  set G := TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf W x hx
  have hmem : G b ∈
      Submodule.span (TopCat.Presheaf.stalk (C := RingCat.{u}) X.ringCatSheaf.obj x)
        (Set.range fun i => (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
          ((s i).eval (Opposite.op ⊤))) := by
    rw [hspan]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  have hgerm : ∀ i, (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
      ((s i).eval (Opposite.op ⊤)) = G.hom (g i • b) := by
    intro i
    rw [hg i]
    exact (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top) x hx _).symm
  have hsm : ∀ i, G.hom (g i • b) = (TopCat.Presheaf.germ (C := RingCat.{u}) X.ringCatSheaf.obj
      W x hx).hom (g i) • G.hom b := fun i =>
    PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x W hx (g i) b
  simp only [hgerm, hsm, smul_smul, ← Finset.sum_smul] at hc
  set RG := TopCat.Presheaf.germ (C := RingCat.{u}) X.ringCatSheaf.obj W x hx
  set r := ∑ i, c i * RG.hom (g i) with hr
  -- `𝒪_X(D)_x` is torsion free over `𝒪_{X,x}` along the frame `ψ⁻¹`
  have hr1 : r = 1 := by
    have h0 : (1 - r) • G.hom b = 0 := by rw [sub_smul, one_smul, hc, sub_self]
    obtain ⟨V, hVW, hxV, a, ha⟩ := TopCat.Presheaf.exists_le_germ_eq _ (1 - r) hx
    have e1 := PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x V hxV a
      (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b)
    have e2 := TopCat.Presheaf.germ_res_apply D.divisorialSheaf.val.presheaf (homOfLE hVW) x
      hxV b
    rw [ha, e2] at e1
    have e3 : (1 - r) • G.hom b =
        (TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf V x hxV).hom 0 := by
      rw [h0, map_zero]
    obtain ⟨W', hxW', i1, i2, he⟩ := TopCat.Presheaf.germ_eq _ x hxV hxV _ _ (e1.trans e3)
    have hle : W' ≤ W := i1.le.trans hVW
    rw [map_zero] at he
    have he2 := (PresheafOfModules.map_smul D.divisorialSheaf.val i1.op a _).symm.trans he
    have ha0 : X.presheaf.map i1.op a = 0 := by
      refine (hgen W' hle).1 ?_
      change _ • _ = (0 : Γ(X, W')) • _
      rw [zero_smul]
      have hcomp : D.divisorialSheaf.val.map i1.op
          (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b) =
          D.divisorialSheaf.presheaf.map (homOfLE hle).op b := rfl
      rw [hcomp] at he2
      exact he2
    have h5 : (1 : _) - r = 0 := ha.symm.trans
      ((TopCat.Presheaf.germ_res_apply _ i1 x hxW' a).symm.trans
        ((congrArg (TopCat.Presheaf.germ (C := RingCat.{u}) X.ringCatSheaf.obj W' x hxW').hom
          ha0).trans
          (map_zero _)))
    exact (sub_eq_zero.mp h5).symm
  -- some `gᵢ` is a unit at `x`
  obtain ⟨i, -, hu⟩ : ∃ i ∈ Finset.univ, IsUnit ((X.presheaf.germ W x hx).hom (g i)) := by
    have hge : ∀ i, SemilinearStalk.commStalkRingEquiv X.presheaf x (RG.hom (g i)) =
        (X.presheaf.germ W x hx).hom (g i) := fun i =>
      SemilinearStalk.commStalkRingEquiv_germ X.presheaf x W hx (g i)
    set e := SemilinearStalk.commStalkRingEquiv X.presheaf x
    have h1 : ∑ i, e (c i) * (X.presheaf.germ W x hx).hom (g i) = 1 := by
      have h2 : e r = 1 := (congrArg e hr1).trans (map_one e)
      have h3 : e r = ∑ i, e (c i * RG.hom (g i)) := map_sum e _ _
      have h4 : ∀ i, e (c i * RG.hom (g i)) = e (c i) * (X.presheaf.germ W x hx).hom (g i) :=
        fun i => (map_mul e _ _).trans (congrArg _ (hge i))
      simp only [h4] at h3
      exact h3.symm.trans h2
    exact exists_isUnit_of_sum_mul_eq_one Finset.univ _ _ h1
  have hxg : x ∈ X.basicOpen (g i) := (X.mem_basicOpen (g i) x hx).mpr hu
  -- the values of `sᵢ` near `x`
  have hval : ∀ (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ W),
      ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤).1 ⟨Z, trivial⟩ =
        (X.presheaf.germ W _ hZ).hom (g i) *
          ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) Z := by
    intro Z hZ
    have := congrArg (fun m : D.divisorialSubmodule W => m.1 ⟨Z, hZ⟩) (hg i)
    simp only [Submodule.coe_smul, rationalFunctions_smul_apply] at this
    exact this.symm
  have hunit : ∀ y (hy : y ∈ X.basicOpen (g i)),
      IsUnit ((X.presheaf.germ W y (X.basicOpen_le _ hy)).hom (g i)) := fun y hy =>
    (X.mem_basicOpen (g i) y (X.basicOpen_le _ hy)).mp hy
  have hZ₀ : componentGenericPoint X (pointComponent x) ∈ X.basicOpen (g i) :=
    ((isGenericPoint_componentGenericPoint X _).specializes
      (mem_pointComponent x)).mem_open (X.basicOpen _).isOpen hxg
  have hi : ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0 := by
    intro h0
    have h2 := hval (pointComponent x) (X.basicOpen_le _ hZ₀)
    rw [h0] at h2
    have h3 : IsUnit ((X.presheaf.germ W _ (X.basicOpen_le _ hZ₀)).hom (g i) *
        ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) (pointComponent x)) :=
      (hunit _ hZ₀).mul ((Pi.isUnit_iff.mp (ψ⁻¹).isUnit) _)
    rw [← h2] at h3
    exact not_isUnit_zero h3
  refine ⟨i, hi, fun hxs => ?_⟩
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hxs
  apply hE
  have hηE : E.genericPoint ∈ X.basicOpen (g i) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact (specializes_iff_mem_closure.mpr hxE).mem_open (X.basicOpen _).isOpen hxg
  have hηW : E.genericPoint ∈ W := X.basicOpen_le _ hηE
  have hZ : componentGenericPoint X E.component ∈ W :=
    E.specializes_genericPoint.mem_open W.isOpen hηW
  set u := (Divisor.isUnit_sectionToRationalFunctions hi).unit
  have hv := congrArg E.valuation (hval E.component hZ)
  have hgerm : (X.presheaf.germ W _ hZ).hom (g i) =
      E.toComponent.hom ((X.presheaf.germ W _ hηW).hom (g i)) := by
    rw [← TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hηW E.specializes_genericPoint]
    rfl
  rw [map_mul, hgerm, E.valuation_toComponent_of_isUnit (hunit _ hηE), one_mul,
    PrimeDivisor.valuation_component, PrimeDivisor.ord_inv,
    ← hψ E ⟨E.genericPoint, (by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl), hηW⟩] at hv
  have hv' : E.valuation ((u : RationalFunctions X) E.component) =
      WithZero.exp (-D.coeff E) := hv
  rw [PrimeDivisor.valuation_component] at hv'
  have hv'' := WithZero.exp_injective hv'
  have hc : (D.zeroDivisor _ hi).coeff E = (principalDivisor u).coeff E + D.coeff E := rfl
  refine hc.trans ?_
  rw [coeff_principalDivisor]
  omega

/-- `𝒪_X(nL) ≅ 𝒪_X(L)^{⊗ n}` for a Cartier divisor `L` and `n ≥ 1`. -/
private theorem nonempty_divisorialSheaf_nsmul_iso {L : Divisor X} (hL : L.IsCartier) (n : ℕ)
    (hn : 1 ≤ n) :
    haveI := hL.isInvertibleModule_divisorialSheaf
    Nonempty ((n • L).divisorialSheaf ≅
      Stacks.Ample.tensorPowModule X L.divisorialSheaf (n : ℤ)) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  induction n, hn using Nat.le_induction with
  | base =>
    exact ⟨eqToIso (congrArg Divisor.divisorialSheaf (one_nsmul L)) ≪≫
      (Stacks.Ample.tensorPowModuleOneIso X _).symm⟩
  | succ n hn ih =>
    obtain ⟨e⟩ := ih
    refine ⟨eqToIso (congrArg Divisor.divisorialSheaf (succ_nsmul L n)) ≪≫
      ((hL.nsmul n).divisorialSheafTensorIso hL).symm ≪≫ ?_ ≪≫
      Stacks.Ample.tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by push_cast; rfl)⟩
    exact ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso e).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso X _).symm

/-- **Serre generation for `𝒪_X(E + m'H)`** ([Stacks, Tag 01Q3]). For an ample Cartier divisor
`H` on a variety and any divisor `E`, for some `m' > 0` the sheaf `𝒪_X(E + m'H)` is generated by
finitely many global sections: `𝒪_X(E)` is coherent, so `𝒪_X(E) ⊗ 𝒪_X(H)^{⊗ m'}` is globally
generated for `m' ≫ 0`, and multiplication `𝒪_X(E) ⊗ 𝒪_X(m'H) ⟶ 𝒪_X(E + m'H)` is an
isomorphism. -/
private theorem exists_generatingSections {k : Type u} [Field k] {sX : X ⟶ Spec (.of k)}
    (hX : MMP.Mori.IsVariety k sX) {H : Divisor X} (hH : H.IsCartier) (hHa : H.IsAmple hH)
    (E : Divisor X) :
    ∃ m' : ℕ, 0 < m' ∧ ∃ σ : (E + m' • H).divisorialSheaf.GeneratingSections, Finite σ.I := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  have hcoh := MMP.Threefold.isCoherent_divisorialSheaf_and_isIso_divisorialSheafTensorMul sX hX E
  haveI := (hcoh H).1
  have hqc := Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
    E.divisorialSheaf
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hHa).2 E.divisorialSheaf hqc.1 hqc.2
  set n : ℕ := max n₀.toNat 1 with hn
  obtain ⟨σ, hσ⟩ := hn₀ (n : ℤ) (by omega)
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X E.divisorialSheaf
    (Stacks.Ample.tensorPowModule X H.divisorialSheaf (n : ℤ))
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_iso hH n (le_max_right _ _)
  let pI := i ≪≫ Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _) e.symm ≪≫
    @asIso _ _ _ _ (E.divisorialSheafTensorMul (n • H)) ((hcoh (n • H)).2.2 (hH.nsmul n))
  let p := pI.hom
  haveI : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _ p :=
    @IsIso.epi_of_iso _ _ _ _ p inferInstance
  exact ⟨n, by omega, σ.ofEpi p, hσ⟩

end GlobalGeneration

/-- The divisor `div g` of a nonzero rational function `g`. -/
private abbrev ffDiv {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (g : X.functionField) (hg : g ≠ 0) : Divisor X :=
  MMP.Mori.principalDivisor
    (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg))

/-- The image in `K(X)` of a scalar `a ∈ k`. -/
private abbrev scalarFun {X : Scheme.{u}} [IsIntegral X] (sX : X ⟶ Spec (.of k)) (a : k) :
    X.functionField :=
  baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom a)

/-- The divisor of the rational function of a unit of `K(X)` is its principal divisor. -/
private theorem ffDiv_rationalFunctionsEquivFunctionField {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (w : (MMP.Mori.RationalFunctions X)ˣ)
    (hw : rationalFunctionsEquivFunctionField X w ≠ 0) :
    ffDiv (rationalFunctionsEquivFunctionField X w) hw = MMP.Mori.principalDivisor w := by
  have hu : Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
      (Units.mk0 (rationalFunctionsEquivFunctionField X w) hw) = w := by
    ext1
    rw [Units.coe_map, Units.val_mk0]
    exact (rationalFunctionsEquivFunctionField X).symm_apply_apply _
  unfold ffDiv
  rw [hu]

/-- A rational function whose divisor plus `M` is effective is a section of `𝒪_X(M)`. -/
private theorem mem_sectionsIn_of_coeff_nonneg {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {M : Divisor X} {g : X.functionField}
    (hg : g ≠ 0) (h : ∀ P, 0 ≤ (M + ffDiv g hg).coeff P) : g ∈ sectionsIn M := by
  intro P
  have h1 := h P
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
  rw [P.divisorialValuation_eq_exp_neg_ord hg, WithZero.exp_le_exp]
  omega

/-- A coefficient vector outside a proper subspace is detected by a nonzero polynomial: if
`v ∉ p` for a subspace `p ⊆ kⁱ`, some linear form `ℓ` vanishes on `p` with `ℓ(v) ≠ 0`, and
`Q = ∑ ℓ(eᵢ) Xᵢ` is nonzero with `Q(c) ≠ 0 → c ∉ p`. -/
private theorem exists_polynomial_forall_notMem {k : Type u} [Field k] {ι : Type*} [Fintype ι]
    {p : Submodule k (ι → k)} {v : ι → k} (hv : v ∉ p) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 → c ∉ p := by
  classical
  obtain ⟨ℓ, hℓ, hp⟩ := Submodule.exists_le_ker_of_notMem hv
  let Q : MvPolynomial ι k :=
    ∑ i, MvPolynomial.C (ℓ (fun j => if i = j then 1 else 0)) * MvPolynomial.X i
  have heval : ∀ c, MvPolynomial.eval c Q = ℓ c := by
    intro c
    rw [LinearMap.pi_apply_eq_sum_univ ℓ c]
    simp [Q, MvPolynomial.eval_sum, mul_comm]
  refine ⟨Q, fun h => hℓ (by rw [← heval, h, map_zero]), fun c hc hcp => hc ?_⟩
  rw [heval]
  exact hp hcp

/-- **A finite free subfamily.** If the moving part of a pulled-back series is free, finitely
many members of the series already have no common base point on `Y`. -/
private theorem exists_finite_free_family {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] (μ : Y ⟶ X) [IsDominant μ] {V : Set X.functionField} {Dμ F : Divisor Y}
    (hfree : IsFreeModuloFixedDivisor μ V Dμ F) :
    ∃ (n : ℕ) (h : Fin n → X.functionField), (∀ i, h i ∈ V) ∧ ∀ y : Y, ∃ i, h i ≠ 0 ∧
      ∀ P : MMP.Mori.PrimeDivisor Y, y ∈ P.support →
        P.valuationOver μ (h i) = WithZero.exp (Dμ.coeff P - F.coeff P) := by
  classical
  choose G hGV hG0 hGP using hfree
  have hf0 : ∀ y, functionFieldMap μ (G y) ≠ 0 := fun y =>
    (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr (hG0 y)
  have hgood : ∀ y (P : MMP.Mori.PrimeDivisor Y),
      P ∉ (ffDiv _ (hf0 y)).support ∪ Dμ.support ∪ F.support →
      P.valuationOver μ (G y) = WithZero.exp (Dμ.coeff P - F.coeff P) := by
    intro y P hP
    simp only [Finset.mem_union, not_or, Finsupp.notMem_support_iff] at hP
    obtain ⟨⟨h1, h2⟩, h3⟩ := hP
    have h1' : (ffDiv _ (hf0 y)).coeff P = 0 := h1
    rw [MMP.Mori.coeff_principalDivisor_mk0] at h1'
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord (hf0 y),
      h1', DivisorWithCoeffs.coeff_apply, h2, DivisorWithCoeffs.coeff_apply, h3]
    simp
  set bad : Y → Finset (MMP.Mori.PrimeDivisor Y) := fun y =>
    ((ffDiv _ (hf0 y)).support ∪ Dμ.support ∪ F.support).filter fun P =>
      P.valuationOver μ (G y) ≠ WithZero.exp (Dμ.coeff P - F.coeff P) with hbad
  set U : Y → Set Y := fun y => (⋃ P ∈ bad y, (P.support : Set Y))ᶜ with hU
  have hUo : ∀ y, IsOpen (U y) := fun y =>
    (Set.Finite.isClosed_biUnion (Finset.finite_toSet _) fun P _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure).isOpen_compl
  have hyU : ∀ y, y ∈ U y := fun y hy => by
    obtain ⟨P, hP, hyP⟩ := Set.mem_iUnion₂.mp hy
    exact (Finset.mem_filter.mp hP).2 (hGP y P hyP)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover U hUo
    (fun y _ => Set.mem_iUnion.mpr ⟨y, hyU y⟩)
  refine ⟨t.card, fun i => G (t.equivFin.symm i), fun i => hGV _, fun y => ?_⟩
  obtain ⟨y₀, hy₀t, hyU₀⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ y))
  refine ⟨t.equivFin ⟨y₀, hy₀t⟩, by simpa using hG0 y₀, fun P hP => ?_⟩
  simp only [Equiv.symm_apply_apply]
  by_contra hne
  apply hyU₀
  refine Set.mem_iUnion₂.mpr ⟨P, Finset.mem_filter.mpr ⟨?_, hne⟩, hP⟩
  by_contra hPs
  exact hne (hgood y₀ P hPs)

/-! ### Pull-backs, sections and exceptional sets on a model -/

/-- `v_E(φ_{i(E)}) ≥ n` for the factor of a nonzero rational function `f` reads `ord_E f ≥ n`. -/
private theorem ordGE_symm_iff {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (E : MMP.Mori.PrimeDivisor X) (n : ℤ) {f : X.functionField}
    (hf : f ≠ 0) :
    E.OrdGE n ((rationalFunctionsEquivFunctionField X).symm f E.component) ↔
      n ≤ X.ord f E.genericPoint := by
  set u : (RationalFunctions X)ˣ :=
    Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 f hf)
  have hu : (u : RationalFunctions X) = (rationalFunctionsEquivFunctionField X).symm f := rfl
  have hne : (u : RationalFunctions X) E.component ≠ 0 :=
    ((Pi.isUnit_iff.mp u.isUnit) E.component).ne_zero
  have hord : E.ord u = X.ord f E.genericPoint := by
    rw [MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField, hu, RingEquiv.apply_symm_apply]
  rw [← hu]
  unfold MMP.Mori.PrimeDivisor.OrdGE
  rw [E.valuation_component, hord, WithZero.exp_le_exp]
  simp [hne]

/-- The valuation along `F` of a nonzero element of the factor of `K(X)` is the order of the
rational function it represents. -/
private theorem valuation_eq_exp_ord {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (F : MMP.Mori.PrimeDivisor X)
    (c : X.presheaf.stalk (componentGenericPoint X F.component))
    (hc : (MMP.Positivity.componentToFunctionField F.component).hom c ≠ 0) :
    F.valuation c =
      WithZero.exp
        (X.ord ((MMP.Positivity.componentToFunctionField F.component).hom c) F.genericPoint) := by
  set χ := (MMP.Positivity.componentToFunctionField F.component).hom c
  letI := (RationalFunctions.isField_stalk X F.component).toField
  have hcχ : c = (rationalFunctionsEquivFunctionField X).symm χ F.component :=
    RingHom.injective (MMP.Positivity.componentToFunctionField F.component).hom
      (MMP.Positivity.componentToFunctionField_symm_apply _ χ).symm
  set u : (RationalFunctions X)ˣ :=
    Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 χ hc)
  have hu : (u : RationalFunctions X) F.component = c := hcχ.symm
  rw [← hu, F.valuation_component, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  simp [u, χ]

/-- The coefficient along `F` of the pull-back of a Cartier divisor with local equation `ψ` near
`φ(η_F)` is the order of `φ^*ψ` along `F`. -/
private theorem coeff_eq_ord_of_isPullback {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (φ : X ⟶ Y) [IsDominant φ] {B : Divisor Y}
    {hB : ∀ Z : irreducibleComponents X, φ (componentGenericPoint X Z) ∉ B.supp}
    {B' : Divisor X} (h : B.IsPullback φ hB B') {U : Y.Opens} {ψ : (RationalFunctions Y)ˣ}
    (hψ : B.IsLocalEquation U ψ) (F : MMP.Mori.PrimeDivisor X) (hF : φ F.genericPoint ∈ U) :
    B'.coeff F =
      X.ord (functionFieldMap φ (rationalFunctionsEquivFunctionField Y ψ)) F.genericPoint := by
  have hFU : (F.support ∩ φ ⁻¹ᵁ U).Nonempty := (F.genericPoint_mem_iff (φ ⁻¹ᵁ U)).mp hF
  rw [h U ψ hψ F hFU]
  obtain ⟨W, hW⟩ := exists_mem_irreducibleComponents (φ (componentGenericPoint X F.component))
  have hmem := F.map_componentGenericPoint_mem φ hFU
  obtain ⟨a, ha⟩ := hψ.exists_unit_stalk hmem (hB _) hW
  rw [pullbackComponent_eq hB hψ hmem hW a ha]
  set χ := functionFieldMap φ (rationalFunctionsEquivFunctionField Y ψ)
  have hχ : χ ≠ 0 := (map_ne_zero_iff _ (functionFieldMap φ).injective).mpr
    (ψ.isUnit.map (rationalFunctionsEquivFunctionField Y)).ne_zero
  have hcχ : (MMP.Positivity.componentToFunctionField F.component).hom
      ((φ.stalkMap (componentGenericPoint X F.component)).hom a) = χ := by
    change algebraMap (X.presheaf.stalk (componentGenericPoint X F.component)) X.functionField
      ((φ.stalkMap _).hom a) = χ
    rw [← MMP.Mori.functionFieldMap_algebraMap_stalk, ← MMP.Mori.algebraMap_stalkSpecializes
      ((isGenericPoint_componentGenericPoint Y W).specializes hW)]
    change functionFieldMap φ ((Y.presheaf.stalkSpecializes _).hom
      ((stalkToRationalFunctions Y hW).hom a)) = χ
    rw [ha]
    change functionFieldMap φ ((MMP.Positivity.componentToFunctionField W).hom _) = χ
    rw [MMP.Positivity.componentToFunctionField_apply]
  have h1 := F.valuation_eq_exp_ordUnit
    (Units.map (φ.stalkMap (componentGenericPoint X F.component)).hom.toMonoidHom a)
  rw [valuation_eq_exp_ord F _ (hcχ ▸ hχ)] at h1
  rw [← hcχ]
  exact (WithZero.exp_injective h1).symm

/-- The valuation over `μ` of `g` is at most `exp n` exactly when `ord (μ^*g) ≥ -n`. -/
private theorem valuationOver_le_exp_iff {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] (P : MMP.Mori.PrimeDivisor Y)
    {g : X.functionField} (hg : functionFieldMap μ g ≠ 0) (n : ℤ) :
    P.valuationOver μ g ≤ WithZero.exp n ↔ -n ≤ Y.ord (functionFieldMap μ g) P.genericPoint := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord hg,
    WithZero.exp_le_exp]
  omega

/-- The valuation over `μ` of `g` is `exp n` exactly when `ord (μ^*g) = -n`. -/
private theorem valuationOver_eq_exp_iff {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] (P : MMP.Mori.PrimeDivisor Y)
    {g : X.functionField} (hg : functionFieldMap μ g ≠ 0) (n : ℤ) :
    P.valuationOver μ g = WithZero.exp n ↔ Y.ord (functionFieldMap μ g) P.genericPoint = -n := by
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, P.divisorialValuation_eq_exp_neg_ord hg,
    WithZero.exp_inj]
  omega

/-- The coefficient of the divisor of zeros of a section read as the rational function `f`. -/
private theorem coeff_zeroDivisor {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (M : Divisor Y) (σ : M.divisorialSubmodule ⊤) (hσ : σ ≠ 0)
    {f : Y.functionField} (hf : Divisor.sectionToRationalFunctions σ =
      (rationalFunctionsEquivFunctionField Y).symm f) (P : MMP.Mori.PrimeDivisor Y) :
    (M.zeroDivisor σ hσ).coeff P = Y.ord f P.genericPoint + M.coeff P := by
  rw [MMP.Mori.Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
    MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  congr 2
  rw [IsUnit.unit_spec, hf, RingEquiv.apply_symm_apply]

/-- The pull-back of the germ at the generic point of a global function. -/
private theorem functionFieldMap_germ_top {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y]
    (μ : Y ⟶ X) [IsDominant μ] (t : Γ(X, ⊤)) :
    functionFieldMap μ (X.presheaf.germ ⊤ (genericPoint X) trivial t) =
      Y.presheaf.germ ⊤ (genericPoint Y) trivial (μ.appTop t) := by
  have h1 : X.presheaf.germ ⊤ (genericPoint X) trivial t =
      algebraMap (X.presheaf.stalk (μ (genericPoint Y))) X.functionField
        (X.presheaf.germ ⊤ (μ (genericPoint Y)) trivial t) :=
    (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf _ _ t).symm
  have h2 := μ.germ_stalkMap_apply ⊤ (genericPoint Y) trivial t
  rw [h1, MMP.Mori.functionFieldMap_algebraMap_stalk, h2]
  exact TopCat.Presheaf.germ_stalkSpecializes_apply Y.presheaf _ _ _

/-- `μ^*(D + div g) = μ^*D + div(μ^*g)`. -/
private theorem isPullback_add_principalDivisor {X Y : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (μ : Y ⟶ X) [IsDominant μ] {D : Divisor X} (hDc : D.IsCartier)
    {hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp} {Dμ : Divisor Y}
    (hpull : D.IsPullback μ hD Dμ) {g : X.functionField} (hg : g ≠ 0)
    (hg' : functionFieldMap μ g ≠ 0)
    (hB : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉
      (D + MMP.Mori.principalDivisor
        (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
          (Units.mk0 g hg))).supp) :
    (D + MMP.Mori.principalDivisor
      (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
        (Units.mk0 g hg))).IsPullback μ hB
      (Dμ + MMP.Mori.principalDivisor (Units.map
        (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom
          (Units.mk0 (functionFieldMap μ g) hg'))) := by
  set u := Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg)
  have hBp : ∀ Z : irreducibleComponents Y,
      μ (componentGenericPoint Y Z) ∉ (MMP.Mori.principalDivisor u).supp :=
    fun Z => MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ _ Z
  obtain ⟨P', hP'⟩ := (Divisor.isCartier_principalDivisor u).exists_isPullback hBp
  have hP'eq : P' = MMP.Mori.principalDivisor (Units.map
      (rationalFunctionsEquivFunctionField Y).symm.toMonoidHom
        (Units.mk0 (functionFieldMap μ g) hg')) := by
    ext P
    rw [coeff_eq_ord_of_isPullback μ hP' (Divisor.isLocalEquation_principalDivisor u ⊤) P trivial,
      MMP.Mori.coeff_principalDivisor_mk0]
    simp [u]
  rw [← hP'eq]
  exact hpull.add hDc (Divisor.isCartier_principalDivisor u) hB hP'

/-- **Pull-back of Cartier divisors along a composite**: `g^*(f^*L) = (g ≫ f)^*L`. -/
private theorem isPullback_comp {X Y Z : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral X] [IsLocallyNoetherian Z] [IsNormal Z]
    {f : Y ⟶ X} {g : Z ⟶ Y} {L : Divisor X} {L' : Divisor Y}
    {L'' : Divisor Z} {hB : ∀ W : irreducibleComponents Y, f (componentGenericPoint Y W) ∉ L.supp}
    {hB' : ∀ W : irreducibleComponents Z, g (componentGenericPoint Z W) ∉ L'.supp}
    (h : L.IsPullback f hB L') (h' : L'.IsPullback g hB' L'')
    (hB'' : ∀ W : irreducibleComponents Z, (g ≫ f) (componentGenericPoint Z W) ∉ L.supp) :
    L.IsPullback (g ≫ f) hB'' L'' := by
  intro U φ hφ E hE
  have hψ := h.isLocalEquation hφ
  rw [h' (f ⁻¹ᵁ U) _ hψ E hE]
  congr 1
  set z := componentGenericPoint Z E.component
  have hzU : f (g z) ∈ U := E.map_componentGenericPoint_mem (g ≫ f) hE
  obtain ⟨a, ha⟩ := hφ.exists_unit_stalk hzU (hB'' _) (MMP.Fourfold.mem_irreducibleComponent_of_irreducibleSpace
    (pointComponent ((g ≫ f) z)) _)
  rw [pullbackComponent_eq hB'' hφ hzU _ a ha]
  set W := pointComponent (g z)
  have hspec : componentGenericPoint Y W ⤳ g z :=
    (isGenericPoint_componentGenericPoint Y W).specializes (mem_pointComponent _)
  have hWU : f (componentGenericPoint Y W) ∈ U :=
    (f.base.hom.map_specializes hspec).mem_open U.isOpen hzU
  have hb : (stalkToRationalFunctions Y (mem_pointComponent (g z))).hom
      (Units.map (f.stalkMap (g z)).hom.toMonoidHom a) =
      ((pullbackLocalEquation f hB hφ : (RationalFunctions Y)ˣ) : RationalFunctions Y) W := by
    have e1 := congrArg Units.val (pullbackLocalEquation_apply f hB hφ W hWU)
    refine Eq.trans ?_ e1.symm
    rw [pullbackComponent_eq hB hφ hWU
      (MMP.Fourfold.mem_irreducibleComponent_of_irreducibleSpace (pointComponent ((g ≫ f) z)) _)
      (Units.map (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom.toMonoidHom a)
      ?_]
    · change (stalkToRationalFunctions Y _).hom ((f.stalkMap (g z)).hom a.val) =
        (f.stalkMap _).hom ((X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec)).hom
          a.val)
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, stalkToRationalFunctions,
        Scheme.Hom.stalkSpecializes_stalkMap]
    · change (X.presheaf.stalkSpecializes (f.base.hom.map_specializes hspec) ≫
        X.presheaf.stalkSpecializes _).hom a.val = _
      rw [TopCat.Presheaf.stalkSpecializes_comp]
      exact ha
  rw [pullbackComponent_eq hB' hψ _ (mem_pointComponent (g z)) _ hb]
  ext
  change _ = ((g ≫ f).stalkMap z).hom a.val
  rw [Scheme.Hom.stalkMap_comp]
  rfl

/-- A point off the exceptional sets of `h` and of `g` at `h y` is off that of `h ≫ g`. -/
private theorem mem_exceptionalSet_comp {Y X' X : Scheme.{u}} (h : Y ⟶ X') (g : X' ⟶ X)
    [IsSeparated g] [UniversallyClosed g] {y : Y} (hy : y ∈ exceptionalSet (h ≫ g)) :
    y ∈ exceptionalSet h ∨ h y ∈ exceptionalSet g := by
  by_contra hne
  push Not at hne
  obtain ⟨hyh, hyg⟩ := hne
  simp only [MMP.Mori.mem_exceptionalSet, not_not, Scheme.Hom.comp_apply] at hy hyh hyg
  apply hy
  have hcl : IsClosed (g '' (biregularLocus h : Set X')ᶜ) :=
    g.isClosedMap _ (biregularLocus h).isOpen.isClosed_compl
  let W : X.Opens := biregularLocus g ⊓ ⟨_, hcl.isOpen_compl⟩
  have hWg : IsBiregular g W :=
    isBiregular_iff_le_biregularLocus.mpr inf_le_left
  have hWh : IsBiregular h (g ⁻¹ᵁ W) := by
    refine isBiregular_iff_le_biregularLocus.mpr ?_
    intro x hx
    by_contra hxU
    exact hx.2 ⟨x, hxU, rfl⟩
  have hiso : IsBiregular (h ≫ g) W := by
    unfold IsBiregular at *
    rw [morphismRestrict_comp]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ hWh hWg
  refine le_biregularLocus hiso ⟨hyg, ?_⟩
  rintro ⟨x, hx, hxy⟩
  have : IsIso (g ∣_ biregularLocus g) := isBiregular_biregularLocus g
  have hxy' : g x = g (h y) := hxy.trans (Scheme.Hom.comp_apply h g y)
  have hx' : g x ∈ biregularLocus g := hxy' ▸ hyg
  have hinj := (g ∣_ biregularLocus g).isOpenEmbedding.injective
    (a₁ := (⟨x, hx'⟩ : g ⁻¹ᵁ biregularLocus g)) (a₂ := ⟨h y, hyg⟩)
  have : x = h y := congrArg Subtype.val (hinj (Subtype.ext
    ((morphismRestrict_base_coe g _ _).trans (hxy'.trans
      (morphismRestrict_base_coe g (biregularLocus g) ⟨h y, hyg⟩).symm))))
  exact hx (this ▸ hyh)

/-- A combination of sections of `𝒪_X(M)` with scalar coefficients is a section. -/
private theorem sum_mem_sectionsIn {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {M : Divisor X} {ι : Type*} [Fintype ι]
    (g : ι → X.functionField) (hg : ∀ i, g i ∈ sectionsIn M) (c : ι → k) :
    (∑ i, scalarFun sX (c i) * g i) ∈ sectionsIn M := by
  refine (sectionsSubgroup M).sum_mem fun i _ => ?_
  intro P
  rw [map_mul]
  refine (mul_le_of_le_one_left' ?_).trans (hg i P)
  rw [MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
  exact ⟨_, (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ⊤)
    (show P.genericPoint ∈ (⊤ : X.Opens) from trivial) _).trans rfl⟩

/-- A section of `𝒪_X(M)` has effective divisor `M + div g`. -/
private theorem coeff_add_ffDiv_nonneg {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {M : Divisor X} {g : X.functionField} (hg : g ∈ sectionsIn M)
    (hg0 : g ≠ 0) (P : MMP.Mori.PrimeDivisor X) : 0 ≤ (M + ffDiv g hg0).coeff P := by
  have h := hg P
  rw [P.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  omega

open Classical in
/-- The coefficient of a reduced sum of prime divisors. -/
private theorem coeff_sum_single_one {Y : Scheme.{u}} (s : Finset (MMP.Mori.PrimeDivisor Y))
    (P : MMP.Mori.PrimeDivisor Y) :
    (∑ E ∈ s, Finsupp.single E (1 : ℤ) : Divisor Y).coeff P = if P ∈ s then 1 else 0 := by
  classical
  rw [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply]
  simp [Finsupp.single_apply]

/-- **The model of a general member of a series.** Let `μ : Y ⟶ X` be a log resolution of `Δ`
and of a series `V ⊆ H⁰(X, 𝒪_X(L))` with fixed divisor `F`, `B_T` an effective divisor on `X`,
and `h` finitely many members of `V` without common base point on `Y`. For a general
combination `h_c = ∑ cᵢ hᵢ` there are a proper birational `μ' : Y' ⟶ X` from a smooth variety
and an snc set `s` of prime divisors of `Y'` containing `Ex(μ')` and the inverse images of
`Supp Δ`, `Supp (L + div h_c)` and `Supp B_T`, with `μ'^*(L + div h_c) = F' + T` for the
pull-back `F'` of the fixed divisor and a reduced `T ⊆ s` sharing no component with `F'` or
`β = μ'^*B_T`, and `F'` bounds every pulled-back member of `V` from below. -/
private theorem exists_polynomial_model [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ L : Divisor X}
    {V : Set X.functionField} {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {μ : Y ⟶ X} [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ)
    {hLμ : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ L.supp}
    {Dμ F : Divisor Y} (hDμ : L.IsPullback μ hLμ Dμ) (hlog : IsSeriesLogResolution sX μ Δ V Dμ F)
    (hV : V ⊆ sectionsIn L) (BT : Divisor X) (hBT : 0 ≤ BT) {ι : Type*} [Fintype ι]
    (h : ι → X.functionField) (hhV : ∀ i, h i ∈ V)
    (hfree : ∀ y : Y, ∃ i, h i ≠ 0 ∧ ∀ P : MMP.Mori.PrimeDivisor Y, y ∈ P.support →
      P.valuationOver μ (h i) = WithZero.exp (Dμ.coeff P - F.coeff P)) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      ∀ hc : (∑ i, scalarFun sX (c i) * h i) ≠ 0,
      ∃ (Y' : Scheme.{u}) (μ' : Y' ⟶ X) (_ : IsIntegral Y') (_ : IsLocallyNoetherian Y')
        (_ : IsNormal Y') (_ : IsDominant μ') (_ : IsNormalVariety k (μ' ≫ sX))
        (_ : IsBirationalMorphism μ') (_ : IsProper μ') (_ : IsSmoothScheme (μ' ≫ sX))
        (s T : Finset (MMP.Mori.PrimeDivisor Y')) (F' β : Divisor Y'),
        DivisorWithCoeffs.IsSNC (μ' ≫ sX) (∑ E ∈ s, Finsupp.single E (1 : ℤ)) ∧ T ⊆ s ∧
        (∀ y : Y', y ∈ exceptionalSet μ' ∨ μ' y ∈ Δ.supp ∨
            μ' y ∈ (L + ffDiv _ hc).supp ∨ μ' y ∈ BT.supp → y ∈ ⋃ E ∈ s, E.support) ∧
        0 ≤ F' ∧ 0 ≤ β ∧ (∀ P ∈ T, F'.coeff P = 0 ∧ β.coeff P = 0) ∧
        (∃ hB, (L + ffDiv _ hc).IsPullback μ' hB (F' + ∑ E ∈ T, Finsupp.single E 1)) ∧
        (∃ hB, BT.IsPullback μ' hB β) ∧
        ∀ g ∈ V, g ≠ 0 → ∀ (P : MMP.Mori.PrimeDivisor Y') (U : X.Opens)
          (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
          L.IsLocalEquation U φ → μ' P.genericPoint ∈ U →
          P.valuationOver μ' (g * MMP.Threefold.Mori.Helpers.evalFF Z
            (φ : MMP.Mori.RationalFunctions X)) ≤ WithZero.exp (-F'.coeff P) := by
  classical
  obtain ⟨hlogμ, hfix, -, hsnc0⟩ := hlog
  haveI : IsProper μ := hlogμ.isProper
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hsmY : IsSmoothScheme (μ ≫ sX) := hlogμ.isSmoothScheme
  have hcarY : ∀ M : Divisor Y, M.IsCartier := fun M =>
    MMP.Fourfold.isCartier_of_isSmoothScheme hsmY M
  have hLc : L.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm L
  have hBTc : BT.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm BT
  have hF0 : ∀ P, 0 ≤ F.coeff P := fun P =>
    coeff_nonneg_of_isFixedDivisorOfPullback hLc hV hDμ hfix P hY hμ
  -- the snc divisor of the series resolution and the pull-back of `B_T`
  obtain ⟨s₀, hs₀, hs₀snc⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hsnc0
  obtain ⟨Bμ, hBμ⟩ := hBTc.exists_isPullback
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ BT)
  have hBμ0 : ∀ P, 0 ≤ Bμ.coeff P := fun P =>
    MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn hBTc (V := ⊤) (fun Q _ => hBT Q)
      hBμ P ((P.genericPoint_mem_iff _).mp trivial)
  -- a log resolution of `∑_{E ∈ s₀} E + Bμ`
  set R₀ : Divisor Y := ∑ E ∈ s₀, Finsupp.single E (1 : ℤ) + Bμ with hR₀
  obtain ⟨Y', ν, hνlog, -⟩ :=
    MMP.Mori.exists_isLogResolution_isProjectiveMorphism (μ ≫ sX) hY (Divisor.toRDivisor R₀)
  have hνres := hνlog.toIsSmoothResolution
  obtain ⟨hY', -, -⟩ := hνres.isNormalVariety hY
  haveI : IsIntegral Y' := hνres.isIntegral
  haveI : IsNormal Y' := hνres.isNormal
  haveI : LocallyOfFiniteType (ν ≫ μ ≫ sX) := hY'.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y' := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ μ ≫ sX)
  have hν := hνres.isBirationalMorphism
  haveI : IsDominant ν := hν.isDominant
  haveI : IsProper ν := hνres.isProper
  haveI : MMP.Mori.IsVariety k (ν ≫ μ ≫ sX) := hY'.1
  haveI : CompactSpace Y' := QuasiCompact.compactSpace_of_compactSpace (ν ≫ μ ≫ sX)
  have hsmY' : IsSmoothScheme (ν ≫ μ ≫ sX) := hνres.isSmoothScheme
  obtain ⟨s', hs', hs'snc⟩ := exists_finset_of_isSNCSubset (ν ≫ μ ≫ sX) hsmY' hνlog.isSNCSubset
  -- the members of the series as sections of the moving part `M = Dμ - F`
  set M : Divisor Y := Dμ - F with hM
  set eY := rationalFunctionsEquivFunctionField Y
  let φt : ι → ToType ((rationalFunctionsPresheaf Y).obj (Opposite.op ⊤)) := fun i Z =>
    eY.symm (functionFieldMap μ (h i)) Z.1
  have hsec : ∀ i, M.IsDivisorialSection ⊤ (φt i) := by
    intro i E _
    change E.OrdGE (-M.coeff E) (eY.symm (functionFieldMap μ (h i)) E.component)
    by_cases h0 : functionFieldMap μ (h i) = 0
    · rw [h0, map_zero]
      exact MMP.Mori.PrimeDivisor.OrdGE.zero _
    rw [ordGE_symm_iff E _ h0]
    have h1 := (valuationOver_le_exp_iff μ E h0 _).mp ((hfix E).1 (h i) (hhV i))
    rw [hM, DivisorWithCoeffs.coeff_sub]
    omega
  let t : ι → M.divisorialSubmodule ⊤ := fun i => ⟨φt i, hsec i⟩
  have ht_rat : ∀ i, Divisor.sectionToRationalFunctions (t i) =
      eY.symm (functionFieldMap μ (h i)) := fun i => rfl
  have hfreeY : ∀ y : Y, ∃ (i : ι) (hi : t i ≠ 0), y ∉ (M.zeroDivisor (t i) hi).supp := by
    intro y
    obtain ⟨i, hi0, hord⟩ := hfree y
    have hsi : functionFieldMap μ (h i) ≠ 0 :=
      (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr hi0
    have hti : t i ≠ 0 := fun h' => hsi (eY.symm.injective (by
      rw [← ht_rat, h', map_zero]; exact map_zero (rationalFunctionsPresheafTopEquiv Y)))
    refine ⟨i, hti, fun hmem => ?_⟩
    obtain ⟨P, hP0, hyP⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    have h1 := (valuationOver_eq_exp_iff μ P hsi _).mp (hord P hyP)
    rw [coeff_zeroDivisor M (t i) hti (ht_rat i) P, h1, hM, DivisorWithCoeffs.coeff_sub] at hP0
    exact hP0 (by ring)
  -- Bertini on `Y'`
  obtain ⟨Q, hQ0, hQ⟩ :=
    MMP.Mori.exists_polynomial_pullback_zeroDivisor_eq_sum_isSNC hY.1 hνres t hfreeY s' hs'snc
  refine ⟨Q, hQ0, fun c hc hcne => ?_⟩
  set hcf := ∑ i, scalarFun sX (c i) * h i with hcfdef
  set g' := functionFieldMap μ hcf with hg'def
  have hg'0 : g' ≠ 0 := (map_ne_zero_iff _ (functionFieldMap μ).injective).mpr hcne
  set τ := ∑ i, scalarsToGlobalSections k (μ ≫ sX) (c i) • t i with hτdef
  have hscal : ∀ b : k, Y.presheaf.germ ⊤ (genericPoint Y) trivial
      (scalarsToGlobalSections k (μ ≫ sX) b) = functionFieldMap μ (scalarFun sX b) := fun b => by
    rw [scalarFun, baseFunction, functionFieldMap_germ_top]
    congr 1
  have hrat_smul : ∀ (r : Γ(Y, ⊤)) (σ : M.divisorialSubmodule ⊤),
      Divisor.sectionToRationalFunctions (r • σ) =
        eY.symm (Y.presheaf.germ ⊤ (genericPoint Y) trivial r) *
          Divisor.sectionToRationalFunctions σ := fun r σ => by
    funext Z
    rw [Pi.mul_apply, germ_eq_rationalFunctionsEquivFunctionField_symm ⊤ r trivial Z trivial]
    rfl
  have hτrat : Divisor.sectionToRationalFunctions τ = eY.symm g' := by
    change rationalFunctionsPresheafTopEquiv Y τ.1 = _
    rw [hτdef, Submodule.coe_sum, map_sum]
    change ∑ i, Divisor.sectionToRationalFunctions
      (scalarsToGlobalSections k (μ ≫ sX) (c i) • t i) = _
    simp only [hrat_smul, ht_rat, hscal]
    rw [hg'def, hcfdef, map_sum, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [map_mul, map_mul]
  have hτ : τ ≠ 0 := fun h' => hg'0 (eY.symm.injective (by
    rw [← hτrat, h', map_zero]; exact map_zero (rationalFunctionsPresheafTopEquiv Y)))
  set Zd := M.zeroDivisor τ hτ with hZd
  have hBτ := MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant ν Zd
  obtain ⟨H', hH'⟩ := (hcarY Zd).exists_isPullback hBτ
  obtain ⟨T, hT, hTs', hTsnc, -⟩ := hQ c hc hτ hBτ H' hH'
  have hZcoeff : ∀ P, Zd.coeff P = Y.ord g' P.genericPoint + M.coeff P :=
    coeff_zeroDivisor M τ hτ hτrat
  -- the pull-backs to `Y'`
  obtain ⟨F', hF'⟩ := (hcarY F).exists_isPullback
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant ν F)
  obtain ⟨β, hβ⟩ := (hcarY Bμ).exists_isPullback
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant ν Bμ)
  have hpullG : (L + ffDiv hcf hcne).IsPullback μ
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ _) (F + Zd) := by
    have hh := isPullback_add_principalDivisor μ hLc hDμ hcne hg'0
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ _)
    have e : F + Zd = Dμ + ffDiv g' hg'0 := by
      ext P
      rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_add, hZcoeff,
        MMP.Mori.coeff_principalDivisor_mk0, hM, DivisorWithCoeffs.coeff_sub]
      ring
    rw [e]
    exact hh
  have hZT : Zd.IsPullback ν hBτ (∑ E ∈ T, Finsupp.single E 1) := hT ▸ hH'
  have hFZ : (F + Zd).IsPullback ν
      (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant ν _)
      (F' + ∑ E ∈ T, Finsupp.single E 1) :=
    Divisor.IsPullback.add (hcarY F) (hcarY Zd) _ hF' hZT
  have hpb1 := isPullback_comp hpullG hFZ
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant (ν ≫ μ) _)
  have hpb2 := isPullback_comp hBμ hβ
    (MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant (ν ≫ μ) BT)
  -- effectivity
  have hF'0 : ∀ P, 0 ≤ F'.coeff P := fun P =>
    MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (hcarY F) (V := ⊤)
      (fun Q _ => hF0 Q) hF' P ((P.genericPoint_mem_iff _).mp trivial)
  have hβ0 : ∀ P, 0 ≤ β.coeff P := fun P =>
    MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn (hcarY Bμ) (V := ⊤)
      (fun Q _ => hBμ0 Q) hβ P ((P.genericPoint_mem_iff _).mp trivial)
  have hLh0 : ∀ P, 0 ≤ (L + ffDiv hcf hcne).coeff P :=
    coeff_add_ffDiv_nonneg (sum_mem_sectionsIn sX h (fun i => hV (hhV i)) c) hcne
  -- the covering of the relevant loci by `s₀` and `s'`
  have hs₀sub : ∀ z : Y, z ∈ exceptionalSet μ ∨ μ z ∈ Δ.supp ∨ z ∈ F.supp →
      z ∈ ⋃ E ∈ s₀, E.support := by
    intro z hz
    rw [hs₀, Closeds.coe_sup, Closeds.coe_sup]
    rcases hz with hz | hz | hz
    · exact Or.inl (Or.inl hz)
    · exact Or.inl (Or.inr hz)
    · exact Or.inr hz
  have hR₀sub : ∀ z : Y, z ∈ ⋃ E ∈ s₀, E.support ∨ z ∈ Bμ.supp →
      z ∈ (Divisor.toRDivisor R₀).supp := by
    intro z hz
    rcases hz with hz | hz
    · obtain ⟨E, hE, hzE⟩ := Set.mem_iUnion₂.mp hz
      refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hzE⟩
      rw [Divisor.coeff_toRDivisor, hR₀, DivisorWithCoeffs.coeff_add, coeff_sum_single_one,
        if_pos hE]
      have := hBμ0 E
      intro h0
      have h1 : ((1 + Bμ.coeff E : ℤ) : ℝ) = 0 := h0
      have h2 : (1 + Bμ.coeff E : ℤ) = 0 := by exact_mod_cast h1
      omega
    · obtain ⟨E, hE, hzE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hz
      refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, ?_, hzE⟩
      rw [Divisor.coeff_toRDivisor, hR₀, DivisorWithCoeffs.coeff_add, coeff_sum_single_one]
      have := hBμ0 E
      intro h0
      have h2 : ((if E ∈ s₀ then 1 else 0) + Bμ.coeff E : ℤ) = 0 := by exact_mod_cast h0
      split_ifs at h2 <;> omega
  have hcov : ∀ y : Y', y ∈ exceptionalSet ν ∨ ν y ∈ (Divisor.toRDivisor R₀).supp →
      y ∈ ⋃ E ∈ s', E.support := by
    intro y hy
    rw [hs', Closeds.coe_sup]
    rcases hy with hy | hy
    · exact Or.inl hy
    · exact Or.inr hy
  have hmono : ∀ y, y ∈ ⋃ E ∈ s', E.support → y ∈ ⋃ E ∈ T ∪ s', E.support := fun y hy => by
    obtain ⟨E, hE, hyE⟩ := Set.mem_iUnion₂.mp hy
    exact Set.mem_iUnion₂.mpr ⟨E, Finset.mem_union_right _ hE, hyE⟩
  have hunion : ∀ y : Y', y ∈ exceptionalSet (ν ≫ μ) ∨ (ν ≫ μ) y ∈ Δ.supp ∨
      (ν ≫ μ) y ∈ (L + ffDiv hcf hcne).supp ∨ (ν ≫ μ) y ∈ BT.supp →
      y ∈ ⋃ E ∈ T ∪ s', E.support := by
    intro y hy
    rcases hy with hy | hy | hy | hy
    · rcases mem_exceptionalSet_comp ν μ hy with h1 | h1
      · exact hmono y (hcov y (Or.inl h1))
      · exact hmono y (hcov y (Or.inr (hR₀sub _ (Or.inl (hs₀sub _ (Or.inl h1))))))
    · exact hmono y (hcov y (Or.inr (hR₀sub _ (Or.inl (hs₀sub _ (Or.inr (Or.inl hy)))))))
    · have hsupp := MMP.Flips.supp_eq_preimage_supp_of_isPullback
        (hLc.add (Divisor.isCartier_principalDivisor _)) hLh0 hpb1
      have hy' : y ∈ ((F' + ∑ E ∈ T, Finsupp.single E 1).supp : Set Y') := by
        rw [hsupp]; exact hy
      obtain ⟨E, hE, hyE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hy'
      rw [DivisorWithCoeffs.coeff_add, coeff_sum_single_one] at hE
      by_cases hET : E ∈ T
      · exact Set.mem_iUnion₂.mpr ⟨E, Finset.mem_union_left _ hET, hyE⟩
      · rw [if_neg hET, add_zero] at hE
        have h1 : y ∈ (F'.supp : Set Y') := DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, hE, hyE⟩
        have h2 := MMP.Flips.supp_subset_preimage_supp_of_isPullback (hcarY F) hF' h1
        exact hmono y (hcov y (Or.inr (hR₀sub _ (Or.inl (hs₀sub _ (Or.inr (Or.inr h2)))))))
    · have hsupp := MMP.Flips.supp_eq_preimage_supp_of_isPullback hBTc hBT hBμ
      have h2 : ν y ∈ (Bμ.supp : Set Y) := by rw [hsupp]; exact hy
      exact hmono y (hcov y (Or.inr (hR₀sub _ (Or.inr h2))))
  -- the components of `T` are not components of `F'` or `β`
  have hTF : ∀ P ∈ T, F'.coeff P = 0 ∧ β.coeff P = 0 := by
    intro P hP
    have hnot : ∀ D' : Divisor Y', (P.genericPoint ∈ (D'.supp : Set Y') →
        P.genericPoint ∈ ⋃ E ∈ s', E.support) → D'.coeff P = 0 := by
      intro D' hD'
      by_contra hne
      have hPP : P.genericPoint ∈ P.support := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
      obtain ⟨E, hE, hPE⟩ := Set.mem_iUnion₂.mp (hD' (DivisorWithCoeffs.mem_supp_iff.mpr
        ⟨P, hne, hPP⟩))
      have hEP := MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE
      exact Finset.disjoint_left.mp hTs' hP (hEP ▸ hE)
    refine ⟨hnot F' fun h1 => hcov _ (Or.inr (hR₀sub _ (Or.inl (hs₀sub _ (Or.inr (Or.inr
      (MMP.Flips.supp_subset_preimage_supp_of_isPullback (hcarY F) hF' h1))))))),
      hnot β fun h1 => hcov _ (Or.inr (hR₀sub _ (Or.inr
        (MMP.Flips.supp_subset_preimage_supp_of_isPullback (hcarY Bμ) hβ h1))))⟩
  -- `F'` bounds the pulled-back members of the series
  have hfix' : ∀ g ∈ V, g ≠ 0 → ∀ (P : MMP.Mori.PrimeDivisor Y') (U : X.Opens)
      (φ : (MMP.Mori.RationalFunctions X)ˣ) (Z : irreducibleComponents X),
      L.IsLocalEquation U φ → (ν ≫ μ) P.genericPoint ∈ U →
      P.valuationOver (ν ≫ μ) (g * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X)) ≤ WithZero.exp (-F'.coeff P) := by
    intro g hg _ P U φ Z hφ hPU
    have key := valuation_le_exp_of_isPullback
      (F := (⟨Y', ν, hY', hν, P⟩ : DivisorOver k (μ ≫ sX))) (hcarY F)
      (g := functionFieldMap μ (g * MMP.Threefold.Mori.Helpers.evalFF Z
        (φ : MMP.Mori.RationalFunctions X))) (fun Γ hΓ => by
        have hsp : Γ.genericPoint ⤳ ν P.genericPoint := by
          rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hΓ
          exact specializes_iff_mem_closure.mpr hΓ
        have hΓU : μ Γ.genericPoint ∈ U := (hsp.map μ.continuous).mem_open U.isOpen hPU
        change Γ.valuationOver μ (g * _) ≤ _
        rw [Valuation.map_mul, valuationOver_evalFF_eq hDμ hφ Γ hΓU Z]
        calc _ ≤ WithZero.exp (Dμ.coeff Γ - F.coeff Γ) * WithZero.exp (-Dμ.coeff Γ) := by
              gcongr
              exact (hfix Γ).1 g hg
          _ = _ := by rw [← WithZero.exp_add]; congr 1; ring) F' _ hF'
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply,
      ← MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
    exact key
  have hμ' : IsBirationalMorphism (ν ≫ μ) :=
    MMP.Mori.isBirationalMorphism_comp_of_isBirational μ ν
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hμ)
      (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hν)
  refine ⟨Y', ν ≫ μ, inferInstance, inferInstance, inferInstance, inferInstance,
    by rw [Category.assoc]; exact hY', hμ', inferInstance, by rw [Category.assoc]; exact hsmY',
    T ∪ s', T, F', β, by rw [Category.assoc]; exact hTsnc, Finset.subset_union_left, hunion,
    fun P => hF'0 P, fun P => hβ0 P, hTF, ⟨_, hpb1⟩, ⟨_, hpb2⟩, hfix'⟩

/-- **A general member misses a point that one member misses.** If `x` lies off the divisor of
the member `g_j` of `|M|`, then for a general coefficient vector `c` the combination
`∑ cᵢ gᵢ` is nonzero and `x` lies off its divisor. -/
private theorem exists_polynomial_notMem_supp {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {M : Divisor X}
    (hMc : M.IsCartier) {ι : Type*} [Fintype ι] (g : ι → X.functionField)
    (hg : ∀ i, g i ∈ sectionsIn M) (x : X) (j : ι) (hj : g j ≠ 0)
    (hjx : x ∉ (M + ffDiv (g j) hj).supp) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      ∃ hc : (∑ i, scalarFun sX (c i) * g i) ≠ 0, x ∉ (M + ffDiv _ hc).supp := by
  classical
  obtain ⟨U, hxU, φ, hφ⟩ := hMc x
  set Z₀ : irreducibleComponents X := MMP.Mori.pointComponent (genericPoint X)
  set ψf := MMP.Threefold.Mori.Helpers.evalFF Z₀ (φ : MMP.Mori.RationalFunctions X) with hψf
  have hψ0 : ψf ≠ 0 := evalFF_ne_zero Z₀ φ
  have hordψ : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord ψf Γ.genericPoint = M.coeff Γ :=
    fun Γ hΓ => ord_evalFF_of_isLocalEquation hφ Z₀ Γ ⟨x, hΓ, hxU⟩
  have hreg : ∀ i, ∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = g i * ψf := by
    intro i
    rcases eq_or_ne (g i) 0 with h0 | h0
    · exact ⟨0, by rw [map_zero, h0, zero_mul]⟩
    · refine MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x
        (mul_ne_zero h0 hψ0) fun Γ hΓ => ?_
      rw [Scheme.ord_mul h0 hψ0, hordψ Γ hΓ]
      exact ord_add_coeff_nonneg (hg i) h0 Γ
  choose r hr using hreg
  have hj0 : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord (g j * ψf) Γ.genericPoint = 0 := by
    intro Γ hΓ
    rw [Scheme.ord_mul hj hψ0, hordψ Γ hΓ]
    have h1 : (M + ffDiv (g j) hj).coeff Γ = 0 := by
      by_contra hne
      exact hjx (DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ, hne, hΓ⟩)
    rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
    omega
  obtain ⟨r', hr'⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x
    (inv_ne_zero (mul_ne_zero hj hψ0)) fun Γ hΓ => by
      rw [← zpow_neg_one, MMP.Mori.ord_zpow _ (mul_ne_zero hj hψ0), hj0 Γ hΓ]; simp
  have hmul : r j * r' = 1 := IsFractionRing.injective _ X.functionField (by
    rw [map_mul, hr j, hr', map_one, mul_inv_cancel₀ (mul_ne_zero hj hψ0)])
  have hunit : IsUnit (r j) := ⟨⟨r j, r', hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
  let φk : k →+* X.presheaf.stalk x := (X.presheaf.germ ⊤ x trivial).hom.comp
    (sX.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
  have hφk : ∀ a, algebraMap _ X.functionField (φk a) = scalarFun sX a := fun a =>
    (Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (U := ⊤)
      (show x ∈ (⊤ : X.Opens) from trivial) _).trans rfl
  let p : Submodule k (ι → k) :=
    { carrier := {c | ∑ i, φk (c i) * r i ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib] at *
        exact Ideal.add_mem _ ha hb
      zero_mem' := by simp
      smul_mem' := by
        intro a c hc
        simp only [Set.mem_setOf_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc] at *
        rw [← Finset.mul_sum]
        exact Ideal.mul_mem_left _ _ hc }
  have hjp : (Pi.single j 1 : ι → k) ∉ p := by
    intro h
    have h' : ∑ i, φk ((Pi.single j 1 : ι → k) i) * r i ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) := h
    rw [Finset.sum_eq_single j (fun i _ hi => by simp [Pi.single_apply, hi]) (by simp),
      Pi.single_eq_same, map_one, one_mul] at h'
    exact (IsLocalRing.mem_maximalIdeal _).mp h' hunit
  obtain ⟨Q, hQ0, hQ⟩ := exists_polynomial_forall_notMem hjp
  refine ⟨Q, hQ0, fun c hc => ?_⟩
  have hcp := hQ c hc
  have hsu : IsUnit (∑ i, φk (c i) * r i) := by
    by_contra h
    exact hcp ((IsLocalRing.mem_maximalIdeal _).mpr h)
  have hsum : algebraMap _ X.functionField (∑ i, φk (c i) * r i) =
      (∑ i, scalarFun sX (c i) * g i) * ψf := by
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hφk, hr i, mul_assoc]
  have hne : (∑ i, scalarFun sX (c i) * g i) ≠ 0 := by
    intro h0
    have := (hsu.map (algebraMap _ X.functionField)).ne_zero
    rw [hsum, h0, zero_mul] at this
    exact this rfl
  refine ⟨hne, fun hx => ?_⟩
  obtain ⟨Γ, hΓ, hxΓ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  apply hΓ
  have h1 := ord_algebraMap_eq_zero_of_isUnit Γ hxΓ hsu
  rw [hsum, Scheme.ord_mul hne hψ0, hordψ Γ hxΓ] at h1
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  omega

/-- `⌊(p₀K(f + t) + β)/(p₀(pK + 1))⌋ ≤ ⌊f/p⌋` when `f ≥ 0`, `t ∈ {0, 1}` with `f = β = 0` if
`t = 1`, and `β < p₀K`. -/
private theorem floor_div_le_floor_div {p p₀ K : ℕ} (hp : 0 < p) (hp₀ : 0 < p₀) {f t β : ℤ}
    (hf : 0 ≤ f) (hβ : 0 ≤ β) (ht : t = 0 ∨ (t = 1 ∧ f = 0 ∧ β = 0)) (hK : β < p₀ * K) :
    ⌊(((p₀ * K : ℕ) * (f + t) + β : ℤ) : ℝ) / ((p₀ * (p * K + 1) : ℕ) : ℝ)⌋ ≤
      ⌊((1 / (p : ℚ) : ℚ) : ℝ) * f⌋ := by
  have hb : (0 : ℝ) < ((p₀ * (p * K + 1) : ℕ) : ℝ) := by positivity
  set q := ⌊((1 / (p : ℚ) : ℚ) : ℝ) * f⌋ with hqdef
  have hp' : (0 : ℝ) < p := by exact_mod_cast hp
  have hq : f < p * (q + 1) := by
    have h1 := Int.lt_floor_add_one (((1 / (p : ℚ) : ℚ) : ℝ) * f)
    rw [← hqdef] at h1
    push_cast at h1
    rw [div_mul_eq_mul_div, one_mul, div_lt_iff₀ hp'] at h1
    have h2 : (f : ℝ) < (p : ℝ) * ((q : ℝ) + 1) := by linarith
    exact_mod_cast h2
  have hq0 : 0 ≤ q := Int.floor_nonneg.mpr (by positivity)
  have key : ((p₀ * K : ℕ) * (f + t) + β : ℤ) < (q + 1) * ((p₀ * (p * K + 1) : ℕ) : ℤ) := by
    push_cast
    have hp₀' : (1 : ℤ) ≤ p₀ := by exact_mod_cast hp₀
    have hp1 : (1 : ℤ) ≤ p := by exact_mod_cast hp
    have hK0 : (0 : ℤ) ≤ K := by positivity
    rcases ht with rfl | ⟨rfl, rfl, rfl⟩
    · nlinarith
    · nlinarith
  rw [← Int.lt_add_one_iff, Int.floor_lt, div_lt_iff₀ hb]
  exact_mod_cast key

end Construction

/-! ### Strata of a reduced snc divisor -/

section Strata

variable {k : Type u} [Field k]

/-- A divisor has finitely many strata. -/
private theorem finite_setOf_isSNCStratum {X : Scheme.{u}} [NoetherianSpace X]
    (Δ : Divisor X) : {W : Set X | IsSNCStratum Δ W}.Finite := by
  classical
  have hC : ∀ J : Finset (MMP.Mori.PrimeDivisor X),
      IsClosed (⋂ E ∈ J, (E.support : Set X)) := fun J =>
    isClosed_biInter fun E _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  refine (Set.Finite.biUnion (s := (Δ.support.powerset : Set (Finset _)))
    (Finset.finite_toSet _) fun J _ =>
      (MMP.Resolution.Aux.finite_and_cover_componentsOf (hC J)).1).subset ?_
  rintro W ⟨J, hJ, hmax⟩
  exact Set.mem_biUnion (Finset.mem_coe.2 (Finset.mem_powerset.2 hJ)) hmax

/-- A stratum is the closure of a point. -/
private theorem exists_eq_closure_of_isSNCStratum {X : Scheme.{u}} {Δ : Divisor X} {W : Set X}
    (hW : IsSNCStratum Δ W) : ∃ ξ : X, W = closure {ξ} := by
  obtain ⟨J, -, hmax⟩ := hW
  obtain ⟨ξ, -, hξ⟩ := MMP.Resolution.Aux.exists_eq_closure_of_mem_componentsOf
    (isClosed_biInter fun E _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure) hmax
  exact ⟨ξ, hξ⟩

/-- A member of a regular system of parameters outside a subfamily is not in the ideal the
subfamily generates. -/
private theorem notMem_span_image_of_isRegularSystemOfParameters {R : Type*} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] {n : ℕ} {z : Fin n → R}
    (hz : MMP.Mori.IsRegularSystemOfParameters z) {s : Finset (Fin n)} {i : Fin n} (hi : i ∉ s) :
    z i ∉ Ideal.span (z '' (s : Set (Fin n))) := by
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  obtain ⟨hreg, -, hq⟩ := MMP.Flips.ResolutionInputs.isRegularSystemOfParameters_quotient_image hz s
  have hmem : i ∈ Set.range (sᶜ.orderEmbOfFin rfl) := by
    rw [Finset.range_orderEmbOfFin]; exact Finset.mem_coe.2 (Finset.mem_compl.2 hi)
  obtain ⟨j, hj⟩ := hmem
  intro h
  apply MMP.Resolution.ne_zero_of_isRegularSystemOfParameters hq j
  change Ideal.Quotient.mk _ (z (sᶜ.orderEmbOfFin rfl j)) = 0
  rw [hj]
  exact Ideal.Quotient.eq_zero_iff_mem.2 h

/-- **The components through the generic point of a stratum are its index set.** If `closure {ξ}`
is an irreducible component of `⋂_{E ∈ J} E` for components `J` of an snc divisor `Δ`, every
component of `Δ` through `ξ` lies in `J`: otherwise its local equation is a parameter outside
those of `J`, and the prime they generate is a generization of `ξ` on `⋂_{E ∈ J} E`. -/
private theorem mem_of_maximal_closure {X : Scheme.{u}} [IsLocallyNoetherian X]
    {s : X ⟶ Spec (.of k)} {R : Type*} [Zero R] {Δ : DivisorWithCoeffs R X}
    (hΔ : DivisorWithCoeffs.IsSNC s Δ) {J : Finset (MMP.Mori.PrimeDivisor X)}
    (hJ : J ⊆ Δ.support) {ξ : X}
    (hmax : Maximal (fun T : Set X => IsIrreducible T ∧ T ⊆ ⋂ E ∈ J, (E.support : Set X))
      (closure {ξ}))
    {E : MMP.Mori.PrimeDivisor X} (hE : E ∈ Δ.support) (hξE : ξ ∈ E.support) : E ∈ J := by
  classical
  by_contra hEJ
  obtain ⟨n, z, j, hz, hj, hI⟩ := hΔ.2 ξ
  have hξJ : ∀ E' ∈ J, ξ ∈ E'.support := fun E' hE' => by
    have := hmax.prop.2 (subset_closure rfl : ξ ∈ closure {ξ})
    simp only [Set.mem_iInter] at this
    exact this E' hE'
  set J' : Finset (Fin n) := Finset.univ.filter fun i =>
    ∃ (E' : MMP.Mori.PrimeDivisor X) (h : E' ∈ J), j ⟨E', hJ h, hξJ E' h⟩ = i with hJ'
  have hiE : j ⟨E, hE, hξE⟩ ∉ J' := by
    simp only [hJ', Finset.mem_filter, Finset.mem_univ, true_and, not_exists]
    intro E' hE' he
    have := congrArg Subtype.val (hj he)
    exact hEJ (by rw [← show E' = E from this]; exact hE')
  have := isRegularLocalRing_of_isRegularSystemOfParameters hz
  let q := MMP.Resolution.coordPrime hz J'
  have hzq : z (j ⟨E, hE, hξE⟩) ∉ q.asIdeal :=
    notMem_span_image_of_isRegularSystemOfParameters hz hiE
  have hq : q.asIdeal < (IsLocalRing.closedPoint (X.presheaf.stalk ξ)).asIdeal := by
    refine lt_of_le_of_ne (IsLocalRing.le_maximalIdeal q.2.ne_top) fun h => hzq ?_
    rw [h]
    change _ ∈ IsLocalRing.maximalIdeal _
    rw [← hz.1]
    exact Ideal.subset_span ⟨_, rfl⟩
  have hss := MMP.Resolution.closure_fromSpecStalk_ssubset hq
  rw [Scheme.fromSpecStalk_closedPoint] at hss
  have hsub : closure {X.fromSpecStalk ξ q} ⊆ ⋂ E' ∈ J, (E'.support : Set X) := by
    refine closure_minimal (Set.singleton_subset_iff.2 ?_) (isClosed_biInter fun E' _ => by
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure)
    simp only [Set.mem_iInter]
    intro E' hE'
    refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E'.idealSheaf ξ q).2 ?_
    rw [hI ⟨E', hJ hE', hξJ E' hE'⟩]
    refine (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨_, ?_, rfl⟩)
    simp only [hJ', Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq]
    exact ⟨E', hE', rfl⟩
  exact hss.2 (hmax.2 ⟨isIrreducible_singleton.closure, hsub⟩ hss.1)

/-- **A stratum of `Δ - S` does not lie on `S`.** -/
private theorem not_subset_of_isSNCStratum_sub_single {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (sX : X ⟶ Spec (.of k)) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) {W : Set X}
    (hW : IsSNCStratum (Δ - Finsupp.single S 1) W) : ¬ W ⊆ S.support := by
  classical
  obtain ⟨J, hJ, hmax⟩ := hW
  obtain ⟨ξ, rfl⟩ := exists_eq_closure_of_isSNCStratum ⟨J, hJ, hmax⟩
  intro hsub
  have hJΔ : J ⊆ Δ.support := fun E hE => by
    have h := hJ hE
    rw [Finsupp.mem_support_iff] at h ⊢
    intro h0
    apply h
    rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
    split_ifs with hSE
    · subst hSE
      rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
      exact absurd h0 one_ne_zero
    · rfl
  have hSΔ : S ∈ Δ.support := by
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, hS]; exact one_ne_zero
  have hSJ := mem_of_maximal_closure hΔ.2 hJΔ hmax hSΔ (hsub (subset_closure rfl))
  have h := hJ hSJ
  rw [Finsupp.mem_support_iff, Finsupp.sub_apply, Finsupp.single_eq_same,
    ← DivisorWithCoeffs.coeff_apply, hS, sub_self] at h
  exact h rfl

/-- **A stratum of `(Δ - S)|_S` maps onto a stratum of `Δ`.** -/
private theorem exists_isSNCStratum_subset_image {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [NoetherianSpace X] (sX : X ⟶ Spec (.of k))
    {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    {W : Set (haveI := S.integral; S.idealSheaf.subscheme)}
    (hW : haveI := S.integral;
      IsSNCStratum ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) W) :
    haveI := S.integral
    ∃ W' : Set X, IsSNCStratum Δ W' ∧ W' ⊆ S.idealSheaf.subschemeι '' W := by
  haveI := S.integral
  classical
  set ι := S.idealSheaf.subschemeι with hιdef
  have hemb := ι.isClosedEmbedding
  have hrange : ∀ y : X, y ∈ S.support → ∃ t, ι t = y := fun y hy => by
    have : y ∈ Set.range ι := by
      rw [Scheme.IdealSheafData.range_subschemeι]; exact hy
    exact this
  have hιS : ∀ t, ι t ∈ S.support := fun t => by
    have : ι t ∈ Set.range ι := ⟨t, rfl⟩
    rw [Scheme.IdealSheafData.range_subschemeι] at this
    exact this
  have hspec : ∀ a b, ι a ⤳ ι b ↔ a ⤳ b := fun a b => hemb.isInducing.specializes_iff
  have hclS : ∀ E : MMP.Mori.PrimeDivisor X, IsClosed (E.support : Set X) := fun E => by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure
  have hSΔ : S ∈ Δ.support := by
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, hS]; exact one_ne_zero
  have hsubΔ : ∀ E ∈ (Δ - Finsupp.single S 1).support, E ∈ Δ.support ∧ E ≠ S := by
    intro E hE
    refine ⟨?_, fun hES => ?_⟩
    · rw [Finsupp.mem_support_iff] at hE ⊢
      intro h0
      apply hE
      rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
      split_ifs with hSE
      · subst hSE
        rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
        exact absurd h0 one_ne_zero
      · rfl
    · subst hES
      rw [Finsupp.mem_support_iff, Finsupp.sub_apply, Finsupp.single_eq_same,
        ← DivisorWithCoeffs.coeff_apply, hS, sub_self] at hE
      exact hE rfl
  have hΔS : (Δ - Finsupp.single S 1).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_eq_same, hS, sub_self]
  obtain ⟨J', hJ', hmax'⟩ := hW
  obtain ⟨ξ', rfl⟩ := exists_eq_closure_of_isSNCStratum ⟨J', hJ', hmax'⟩
  set x := ι ξ' with hxdef
  have hξ'J : ∀ P ∈ J', ξ' ∈ P.support := fun P hP => by
    have := hmax'.prop.2 (subset_closure rfl : ξ' ∈ closure {ξ'})
    simp only [Set.mem_iInter] at this
    exact this P hP
  -- every member of `J'` lies on a component of `Δ - S`
  have hcomp : ∀ P ∈ J', ∃ E ∈ (Δ - Finsupp.single S 1).support, ι P.genericPoint ∈ E.support := by
    intro P hP
    have hP := hJ' hP
    rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply,
      DivisorWithCoeffs.coeff_restrictPrimeDivisor _ S hΔS P] at hP
    obtain ⟨E, hE, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hP
    refine ⟨E, hE, ?_⟩
    by_contra hnot
    apply hne
    change E.intersectionLength ι P • _ = 0
    rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem ι E hnot, zero_smul]
  set JX := Δ.support.filter fun E => x ∈ E.support with hJXdef
  have hxJX : x ∈ ⋂ E ∈ JX, (E.support : Set X) := by
    simp only [Set.mem_iInter, hJXdef, Finset.mem_filter]
    exact fun E hE => hE.2
  have hclJX : IsClosed (⋂ E ∈ JX, (E.support : Set X)) := isClosed_biInter fun E _ => hclS E
  refine ⟨closure {x}, ⟨JX, Finset.filter_subset _ _, ⟨isIrreducible_singleton.closure,
    closure_minimal (Set.singleton_subset_iff.2 hxJX) hclJX⟩, fun T' hT' hxT' => ?_⟩, ?_⟩
  · obtain ⟨y, hy⟩ := QuasiSober.sober hT'.1.closure isClosed_closure
    have hyx : y ⤳ x := hy.specializes (subset_closure (hxT' (subset_closure rfl)))
    have hyJX : y ∈ ⋂ E ∈ JX, (E.support : Set X) :=
      closure_minimal hT'.2 hclJX hy.mem
    have hyE : ∀ E ∈ JX, y ∈ E.support := by
      simp only [Set.mem_iInter] at hyJX; exact hyJX
    have hSJX : S ∈ JX := Finset.mem_filter.2 ⟨hSΔ, hιS ξ'⟩
    obtain ⟨y', rfl⟩ := hrange y (hyE S hSJX)
    have hy'ξ' : y' ⤳ ξ' := (hspec _ _).1 hyx
    -- the key step: `y'` lies on every member of `J'`
    have hy'P : ∀ P ∈ J', y' ∈ P.support := by
      intro P hP
      obtain ⟨E, hE, hηE⟩ := hcomp P hP
      obtain ⟨hEΔ, hES⟩ := hsubΔ E hE
      have hηξ : P.genericPoint ⤳ ξ' := by
        have := hξ'J P hP
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at this
        exact specializes_iff_mem_closure.mpr this
      have hxE : x ∈ E.support :=
        ((hspec _ _).2 hηξ).mem_closed (hclS E) hηE
      have hEJX : E ∈ JX := Finset.mem_filter.2 ⟨hEΔ, hxE⟩
      obtain ⟨n, z, j, hz, hj, hI⟩ := hΔ.2.2 x
      set iE := j ⟨E, hEΔ, hxE⟩
      set iS := j ⟨S, hSΔ, hιS ξ'⟩
      let q := MMP.Resolution.coordPrime hz {iE, iS}
      have hle : ∀ (p : PrimeSpectrum (X.presheaf.stalk x)),
          X.fromSpecStalk x p ∈ E.support → X.fromSpecStalk x p ∈ S.support →
          q.asIdeal ≤ p.asIdeal := by
        intro p hpE hpS
        have h1 := (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E.idealSheaf x p).1 hpE
        have h2 := (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le S.idealSheaf x p).1 hpS
        rw [hI ⟨E, hEΔ, hxE⟩] at h1
        rw [hI ⟨S, hSΔ, hιS ξ'⟩] at h2
        refine Ideal.span_le.2 ?_
        rintro _ ⟨i, hi, rfl⟩
        simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
          Set.mem_singleton_iff] at hi
        rcases hi with rfl | rfl
        · exact (Ideal.span_singleton_le_iff_mem _).1 h1
        · exact (Ideal.span_singleton_le_iff_mem _).1 h2
      have hqE : X.fromSpecStalk x q ∈ E.support := by
        refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le E.idealSheaf x q).2 ?_
        rw [hI ⟨E, hEΔ, hxE⟩]
        exact (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨iE, by simp, rfl⟩)
      have hqS : X.fromSpecStalk x q ∈ S.support := by
        refine (MMP.Resolution.fromSpecStalk_mem_support_iff_stalk_le S.idealSheaf x q).2 ?_
        rw [hI ⟨S, hSΔ, hιS ξ'⟩]
        exact (Ideal.span_singleton_le_iff_mem _).2 (Ideal.subset_span ⟨iS, by simp, rfl⟩)
      -- the point `q` is the image of the generic point of `P`
      obtain ⟨pw, hpw⟩ := MMP.Resolution.exists_fromSpecStalk_eq_of_specializes
        ((hspec _ _).2 hηξ)
      have hqw : X.fromSpecStalk x q ⤳ ι P.genericPoint := by
        rw [← hpw]
        exact specializes_iff_mem_closure.mpr
          ((MMP.Resolution.fromSpecStalk_mem_closure_iff x q pw).2
            (hle pw (hpw ▸ hηE) (hpw ▸ hιS _)))
      obtain ⟨t, ht⟩ := hrange _ hqS
      have htP : t ⤳ P.genericPoint := (hspec _ _).1 (ht ▸ hqw)
      have htη : t = P.genericPoint := by
        by_contra hne
        have hlt : P.genericPoint < t := lt_of_le_not_ge htP fun h => hne (htP.antisymm h).eq
        have h1 := Order.coheight_add_one_le hlt
        rw [MMP.Mori.PrimeDivisor.coheight_genericPoint] at h1
        have h0 : Order.coheight t = 0 := by
          have : Order.coheight t + 1 ≤ 0 + 1 := by simpa using h1
          exact le_antisymm (by exact_mod_cast (WithTop.add_le_add_iff_right
            (WithTop.one_ne_top)).1 this) bot_le
        have hmaxt : IsMax t := Order.coheight_eq_zero.mp h0
        have htg : t = genericPoint S.idealSheaf.subscheme :=
          ((genericPoint_specializes t).antisymm (hmaxt (genericPoint_specializes t))).eq.symm
        have hSE : S.genericPoint ∈ E.support := by
          have : ι (genericPoint S.idealSheaf.subscheme) = S.genericPoint := rfl
          rw [← this, ← htg, ht]; exact hqE
        exact hES (AlgebraicGeometry.PrimeDivisor.genericPoint_injective
          (E.eq_genericPoint_of_mem_support hSE S.coheight_genericPoint).symm)
      -- `y` specializes from `q`, hence lies over `P`
      obtain ⟨py, hpy⟩ := MMP.Resolution.exists_fromSpecStalk_eq_of_specializes hyx
      have hqy : X.fromSpecStalk x q ⤳ ι y' := by
        rw [← hpy]
        exact specializes_iff_mem_closure.mpr
          ((MMP.Resolution.fromSpecStalk_mem_closure_iff x q py).2
            (hle py (hpy ▸ hyE E hEJX) (hpy ▸ hιS _)))
      rw [← ht, htη, hspec] at hqy
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact specializes_iff_mem_closure.mp hqy
    have hsub' : closure {y'} ⊆ ⋂ P ∈ J', (P.support : Set _) := by
      refine closure_minimal (Set.singleton_subset_iff.2 ?_) (isClosed_biInter fun P _ => by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure)
      simp only [Set.mem_iInter]
      exact hy'P
    have h1 := hmax'.2 ⟨isIrreducible_singleton.closure, hsub'⟩
      (closure_minimal (Set.singleton_subset_iff.2 (specializes_iff_mem_closure.mp hy'ξ'))
        isClosed_closure)
    have hξy : ξ' ⤳ y' := specializes_iff_mem_closure.mpr (h1 (subset_closure rfl))
    have heq : y' = ξ' := (hy'ξ'.antisymm hξy).eq
    rw [heq] at hy
    exact subset_closure.trans hy.def.symm.subset
  · have := hemb.closure_image_eq {ξ'}
    rw [Set.image_singleton] at this
    rw [this]

end Strata

end

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  {Z : Scheme.{u}} (f : X ⟶ Z)

/-- Removing a component from a reduced snc divisor leaves a reduced snc divisor. -/
private theorem isReducedSNC_sub_single {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ)
    (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1) :
    IsReducedSNC sX (Δ - Finsupp.single S 1) := by
  classical
  have hcoeff : ∀ P, (Δ - Finsupp.single S 1).coeff P = if S = P then 0 else Δ.coeff P := by
    intro P
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_apply (Finsupp.single S 1),
      Finsupp.single_apply]
    split_ifs with h
    · subst h; rw [hS, sub_self]
    · rw [sub_zero]
  refine ⟨fun P => ?_, hΔ.2.of_support_subset fun P hP => ?_⟩
  · rw [hcoeff P]; split_ifs
    · exact Or.inl rfl
    · exact hΔ.1 P
  · rw [Finsupp.mem_support_iff] at hP ⊢
    rw [← DivisorWithCoeffs.coeff_apply, hcoeff P] at hP
    split_ifs at hP
    · exact absurd rfl hP
    · rwa [← DivisorWithCoeffs.coeff_apply]

/-- A stratum of `Δ - S` is a stratum of `Δ`. -/
private theorem isSNCStratum_of_sub_single {Δ : Divisor X} (S : MMP.Mori.PrimeDivisor X)
    (hS : Δ.coeff S = 1) {T : Set X} (hT : IsSNCStratum (Δ - Finsupp.single S 1) T) :
    IsSNCStratum Δ T := by
  classical
  obtain ⟨J, hJ, hmax⟩ := hT
  refine ⟨J, fun P hP => ?_, hmax⟩
  have h := hJ hP
  rw [Finsupp.mem_support_iff] at h ⊢
  intro h0
  apply h
  rw [Finsupp.sub_apply, h0, Finsupp.single_apply]
  split_ifs with hSP
  · subst hSP
    rw [← DivisorWithCoeffs.coeff_apply, hS] at h0
    exact absurd h0 one_ne_zero
  · rfl

/-- A set containing no stratum of `Δ` contains no stratum of `Δ - S`. -/
private theorem containsNoStratum_sub_single {Δ : Divisor X} (S : MMP.Mori.PrimeDivisor X)
    (hS : Δ.coeff S = 1) {T : Set X} (hT : ContainsNoStratum Δ T) :
    ContainsNoStratum (Δ - Finsupp.single S 1) T :=
  fun T' hT' => hT T' (isSNCStratum_of_sub_single S hS hT')

/-- A union of two closed sets containing no stratum contains no stratum. -/
private theorem containsNoStratum_union {Δ : Divisor X} {T₁ T₂ : Set X} (h₁ : IsClosed T₁)
    (h₂ : IsClosed T₂) (hT₁ : ContainsNoStratum Δ T₁) (hT₂ : ContainsNoStratum Δ T₂) :
    ContainsNoStratum Δ (T₁ ∪ T₂) := by
  intro T hT hsub
  obtain ⟨J, hJ, hmax⟩ := hT
  have hirr := hmax.prop.1.isPreirreducible
  by_cases hs₁ : T ⊆ T₁
  · exact hT₁ T ⟨J, hJ, hmax⟩ hs₁
  by_cases hs₂ : T ⊆ T₂
  · exact hT₂ T ⟨J, hJ, hmax⟩ hs₂
  obtain ⟨x₁, hx₁, hx₁'⟩ := Set.not_subset.mp hs₁
  obtain ⟨x₂, hx₂, hx₂'⟩ := Set.not_subset.mp hs₂
  obtain ⟨z, hz, hz₁, hz₂⟩ := hirr T₁ᶜ T₂ᶜ h₁.isOpen_compl h₂.isOpen_compl ⟨x₁, hx₁, hx₁'⟩
    ⟨x₂, hx₂, hx₂'⟩
  rcases hsub hz with h | h
  · exact hz₁ h
  · exact hz₂ h

/-! ### Restriction to `S` of sections and of divisors -/

/-- A section of `𝒪_X(M)`, for `S` not a component of `M`, restricts to `S`. -/
private theorem exists_isRestrictionAlong_of_mem_sectionsIn (S : MMP.Mori.PrimeDivisor X)
    {M : Divisor X} (hM : M.coeff S = 0) {g : X.functionField} (hg : g ∈ sectionsIn M) :
    haveI := S.integral
    ∃ h : S.idealSheaf.subscheme.functionField, IsRestrictionAlong S g h := by
  haveI := S.integral
  rcases eq_or_ne g 0 with rfl | hg0
  · exact ⟨0, 0, map_zero _, map_zero _⟩
  have hnn : ∀ Γ : MMP.Mori.PrimeDivisor X,
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ∈ Γ.support →
        0 ≤ X.ord g Γ.genericPoint := by
    intro Γ hΓ
    rw [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hΓ]
    have h := hg S
    rw [S.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp, hM] at h
    omega
  obtain ⟨a, ha⟩ := MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg
    (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) hg0 hnn
  exact ⟨_, a, ha, rfl⟩

/-- The image series in degree `m` consists of the restrictions of sections of `𝒪_X(mD)`. -/
private theorem mem_imageSeries_iff (D : Divisor X) (S : MMP.Mori.PrimeDivisor X) (m : ℕ)
    (h : haveI := S.integral; S.idealSheaf.subscheme.functionField) :
    h ∈ imageSeries D S m ↔ ∃ g ∈ sectionsIn ((m : ℤ) • D), IsRestrictionAlong S g h := by
  haveI := S.integral
  constructor
  · intro hh
    refine AddSubgroup.closure_induction
      (p := fun h _ => ∃ g ∈ sectionsIn ((m : ℤ) • D), IsRestrictionAlong S g h)
      (fun h hh => hh) ⟨0, (sectionsSubgroup _).zero_mem, 0, map_zero _, map_zero _⟩ ?_ ?_ hh
    · rintro h₁ h₂ - - ⟨g₁, hg₁, a₁, ha₁, hb₁⟩ ⟨g₂, hg₂, a₂, ha₂, hb₂⟩
      exact ⟨g₁ + g₂, (sectionsSubgroup _).add_mem hg₁ hg₂, a₁ + a₂,
        by rw [map_add, ha₁, ha₂], by rw [map_add, hb₁, hb₂]⟩
    · rintro h₁ - ⟨g₁, hg₁, a₁, ha₁, hb₁⟩
      exact ⟨-g₁, (sectionsSubgroup _).neg_mem hg₁, -a₁, by rw [map_neg, ha₁],
        by rw [map_neg, hb₁]⟩
  · exact fun hh => AddSubgroup.subset_closure hh

/-- Restriction to `S` respects combinations with scalar coefficients. -/
private theorem isRestrictionAlong_sum (S : MMP.Mori.PrimeDivisor X) {ι : Type*} [Fintype ι]
    (g : ι → X.functionField) (h : ι → (haveI := S.integral; S.idealSheaf.subscheme.functionField))
    (hgh : ∀ i, IsRestrictionAlong S (g i) (h i)) (c : ι → k) :
    haveI := S.integral
    IsRestrictionAlong S (∑ i, scalarFun sX (c i) * g i)
      (∑ i, scalarFun (S.idealSheaf.subschemeι ≫ sX) (c i) * h i) := by
  haveI := S.integral
  classical
  choose a ha hb using hgh
  let φ : k → X.presheaf.stalk (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme)) :=
    fun c => X.presheaf.germ ⊤ _ trivial (sX.appTop ((Scheme.ΓSpecIso (.of k)).inv.hom c))
  refine ⟨∑ i, φ (c i) * a i, ?_, ?_⟩
  · rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, ha i]
    congr 1
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  · rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hb i]
    congr 1
    have key : (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
        (X.presheaf.germ ⊤ (S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))
          (show _ ∈ (⊤ : X.Opens) from trivial) ≫
          S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)) =
        (Scheme.ΓSpecIso (.of k)).inv ≫ (S.idealSheaf.subschemeι ≫ sX).appTop ≫
          S.idealSheaf.subscheme.presheaf.germ ⊤ (genericPoint S.idealSheaf.subscheme)
            (show _ ∈ (⊤ : S.idealSheaf.subscheme.Opens) from trivial) := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.comp_appTop, Category.assoc]
      rfl
    exact congrArg (fun ψ => ψ.hom (c i)) key

/-- A unit at the generic point of `S` has nonzero restriction. -/
private theorem ne_zero_of_isRestrictionAlong (S : MMP.Mori.PrimeDivisor X)
    {g : X.functionField} {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hg0 : g ≠ 0) (hord : X.ord g S.genericPoint = 0) :
    h ≠ 0 := by
  haveI := S.integral
  obtain ⟨a, ha, hb⟩ := hgh
  have hv : S.divisorialValuation g = 1 := by
    rw [S.divisorialValuation_eq_exp_neg_ord hg0, hord, neg_zero, WithZero.exp_zero]
  have hnm : a ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk S.genericPoint) := by
    intro hm
    have h1 := (MMP.Mori.PrimeDivisor.divisorialValuation_algebraMap_lt_one_iff S a).2 hm
    have h2 : algebraMap S.localRing X.functionField a = g := ha
    rw [h2, hv] at h1
    exact lt_irrefl _ h1
  have hu : IsUnit a := IsLocalRing.notMem_maximalIdeal.mp hnm
  rw [← hb]
  exact (hu.map _).ne_zero

/-- The coefficients of a restriction as a sum over any finite set containing the support. -/
private theorem coeff_restrictPrimeDivisor_eq_sum [NoetherianSpace X] {R : Type*} [AddCommMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (hs : D.support ⊆ s)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    (D.restrictPrimeDivisor S).coeff Q =
      ∑ E ∈ s, E.intersectionLength (haveI := S.integral; S.idealSheaf.subschemeι) Q •
        D.coeff E := by
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D S hD Q]
  exact Finsupp.sum_of_support_subset D hs _ (fun E _ => smul_zero _)

/-- **The restriction of a principal divisor is principal**: `(M + div g)|_S = M|_S + div(g|_S)`
for `S` a component of neither. -/
private theorem restrictPrimeDivisor_add_ffDiv [NoetherianSpace X] (hsm : IsSmoothScheme sX)
    (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    (M : Divisor X) (hM : M.coeff S = 0) {g : X.functionField}
    {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hg0 : g ≠ 0) (hh0 : h ≠ 0) :
    haveI := S.integral
    (M + ffDiv g hg0).restrictPrimeDivisor S = M.restrictPrimeDivisor S + ffDiv h hh0 := by
  haveI := S.integral
  classical
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  obtain ⟨a, ha, hb⟩ := hgh
  have hu : IsUnit a := isUnit_of_map_unit
    (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a (by
      rw [hb]; exact isUnit_iff_ne_zero.mpr hh0)
  have ha' : algebraMap _ X.functionField a = g := ha
  have hSmem : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ∈ S.support := by
    change S.genericPoint ∈ S.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hordS : X.ord g S.genericPoint = 0 := by
    rw [← ha']; exact ord_algebraMap_eq_zero_of_isUnit S hSmem hu
  have hgS : (ffDiv g hg0).coeff S = 0 := by rw [MMP.Mori.coeff_principalDivisor_mk0, hordS]
  have hMg : (M + ffDiv g hg0).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hM, hgS, add_zero]
  set s := M.support ∪ (ffDiv g hg0).support with hs
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add,
    coeff_restrictPrimeDivisor_eq_sum S hMg s Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum S hM s Finset.subset_union_left Q,
    MMP.Mori.coeff_principalDivisor_mk0 h hh0 Q, ← hb,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX S.idealSheaf.subschemeι a hu Q s
      (fun E hE => by
      rw [ha'] at hE
      refine Finset.mem_union_right _ (Finsupp.mem_support_iff.2 ?_)
      rw [← DivisorWithCoeffs.coeff_apply, MMP.Mori.coeff_principalDivisor_mk0]
      exact hE), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_add, smul_add, ha', MMP.Mori.coeff_principalDivisor_mk0, nsmul_eq_mul,
    nsmul_eq_mul]

/-- Restriction to `S` is additive on divisors of which `S` is not a component. -/
private theorem restrictPrimeDivisor_add [NoetherianSpace X] (S : MMP.Mori.PrimeDivisor X)
    {M₁ M₂ : Divisor X} (h₁ : M₁.coeff S = 0) (h₂ : M₂.coeff S = 0) :
    (M₁ + M₂).restrictPrimeDivisor S = M₁.restrictPrimeDivisor S + M₂.restrictPrimeDivisor S := by
  classical
  have h₁₂ : (M₁ + M₂).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_add, h₁, h₂, add_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add,
    coeff_restrictPrimeDivisor_eq_sum S h₁₂ (M₁.support ∪ M₂.support) Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum S h₁ (M₁.support ∪ M₂.support)
      Finset.subset_union_left Q,
    coeff_restrictPrimeDivisor_eq_sum S h₂ (M₁.support ∪ M₂.support)
      Finset.subset_union_right Q, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_add, smul_add]

/-- Restriction to `S` commutes with integer multiples. -/
private theorem restrictPrimeDivisor_zsmul [NoetherianSpace X] (S : MMP.Mori.PrimeDivisor X)
    {M : Divisor X} (hM : M.coeff S = 0) (n : ℤ) :
    (n • M).restrictPrimeDivisor S = n • M.restrictPrimeDivisor S := by
  classical
  have hn : (n • M).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_smul, hM, smul_zero]
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_smul,
    coeff_restrictPrimeDivisor_eq_sum S hn M.support Finsupp.support_smul Q,
    coeff_restrictPrimeDivisor_eq_sum S hM M.support subset_rfl Q, Finset.smul_sum]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_smul, smul_comm]

/-- Restriction to `S` commutes with rational multiples of integral divisors. -/
private theorem restrictPrimeDivisor_smul_toQDivisor [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {M : Divisor X} (hM : M.coeff S = 0) (r : ℚ) :
    (r • Divisor.toQDivisor M).restrictPrimeDivisor S =
      r • Divisor.toQDivisor (M.restrictPrimeDivisor S) := by
  classical
  have hr : (r • Divisor.toQDivisor M).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, hM]; simp
  have hsub : (r • Divisor.toQDivisor M).support ⊆ M.support := by
    intro E hE
    rw [Finsupp.mem_support_iff] at hE ⊢
    intro h0
    apply hE
    rw [← DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
      DivisorWithCoeffs.coeff_apply, h0]
    simp
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
    coeff_restrictPrimeDivisor_eq_sum S hr M.support hsub Q,
    coeff_restrictPrimeDivisor_eq_sum S hM M.support subset_rfl Q]
  push_cast
  rw [smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, nsmul_eq_mul, nsmul_eq_mul,
    smul_eq_mul]
  push_cast
  ring

/-- The restriction of an effective divisor is effective. -/
private theorem coeff_restrictPrimeDivisor_nonneg [NoetherianSpace X] {R : Type*}
    [AddCommMonoid R] [PartialOrder R] [IsOrderedAddMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hD : D.coeff S = 0)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    0 ≤ (D.restrictPrimeDivisor S).coeff Q := by
  rw [coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q]
  exact Finset.sum_nonneg fun E _ => nsmul_nonneg (hD0 E) _

/-- The support of a restriction lies over the support. -/
private theorem image_supp_restrictPrimeDivisor_subset [NoetherianSpace X]
    (S : MMP.Mori.PrimeDivisor X) {D : QDivisor X} (hD : D.coeff S = 0) :
    haveI := S.integral
    S.idealSheaf.subschemeι '' ((D.restrictPrimeDivisor S).supp : Set _) ⊆ D.supp := by
  haveI := S.integral
  classical
  rintro _ ⟨x, hx, rfl⟩
  obtain ⟨Q, hQ, hxQ⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  rw [coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q] at hQ
  obtain ⟨E, -, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hQ
  have hEQ : S.idealSheaf.subschemeι Q.genericPoint ∈ E.support := by
    by_contra hnot
    apply hne
    rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hnot, zero_smul]
  refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, fun h0 => hne (by rw [h0, smul_zero]), ?_⟩
  have hsp : Q.genericPoint ⤳ x := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxQ
    exact specializes_iff_mem_closure.mpr hxQ
  exact (hsp.map S.idealSheaf.subschemeι.continuous).mem_closed
    (by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact isClosed_closure) hEQ

/-! ### Ampleness and sections of a relatively very ample divisor -/

/-- A divisor very ample over an affine base is ample. -/
private theorem isAmple_of_hasImmersionTwistOver (hf : IsProjectiveMorphism f) [IsAffine Z]
    {A : Divisor X} (hAc : A.IsCartier)
    (hA : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A.divisorialSheaf) :
    A.IsAmple hAc := by
  haveI := hAc.isInvertibleModule_divisorialSheaf
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  obtain ⟨n, i, hi, hover, ⟨e⟩⟩ := hA
  have h5 : ∃ d : ℕ, 1 ≤ d ∧ Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f
      (Stacks.Ample.tensorPowModule X A.divisorialSheaf (d : ℤ)) :=
    ⟨1, le_rfl, n, i, hi, hover, ⟨Stacks.Ample.tensorPowModuleOneIso X _ ≪≫ e⟩⟩
  exact ((Stacks.AmpleRelativeFiniteType.tfae_six f A.divisorialSheaf).out 5 1).1 h5

/-- Relative ampleness is invariant under linear equivalence. -/
private theorem isRelativelyAmple_add_principalDivisor {L : Divisor X} (hLc : L.IsCartier)
    (hL : L.IsRelativelyAmple f hLc) (u : (MMP.Mori.RationalFunctions X)ˣ) :
    (L + MMP.Mori.principalDivisor u).IsRelativelyAmple f
      (hLc.add (Divisor.isCartier_principalDivisor u)) := by
  haveI := hLc.isInvertibleModule_divisorialSheaf
  haveI := (hLc.add (Divisor.isCartier_principalDivisor u)).isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, hamp⟩ := hL y
  refine ⟨V, hV, hyV, ?_⟩
  have e : (L + MMP.Mori.principalDivisor u).divisorialSheaf ≅ L.divisorialSheaf :=
    Divisor.divisorialSheafMulIso u fun E => by
      rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor]
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((RingedSpaceModuleAdjunction.modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e)).mpr
    hamp

/-- **Serre generation for an ample divisor on a smooth variety**: some multiple `m'A` has, for
every point `x`, a member missing `x`. -/
private theorem exists_sections_notMem_supp (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {A : Divisor X} (hAc : A.IsCartier) (hAa : A.IsAmple hAc) :
    ∃ m' : ℕ, 0 < m' ∧ ∀ x : X, ∃ g : X.functionField, ∃ hg : g ≠ 0,
      g ∈ sectionsIn ((m' : ℤ) • A) ∧ x ∉ ((m' : ℤ) • A + ffDiv g hg).supp := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  obtain ⟨m', hm', σ, hσ⟩ := exists_generatingSections hX.1 hAc hAa 0
  haveI := Fintype.ofFinite σ.I
  have hEq : (0 : Divisor X) + m' • A = (m' : ℤ) • A := by rw [zero_add, natCast_zsmul]
  refine ⟨m', hm', fun x => ?_⟩
  obtain ⟨W, hxW, ψ, hψ⟩ := (MMP.Fourfold.isCartier_of_isSmoothScheme hsm
    ((0 : Divisor X) + m' • A)) x
  obtain ⟨i, hi, hx⟩ := exists_notMem_supp_zeroDivisor σ hψ hxW
  set w := (Divisor.isUnit_sectionToRationalFunctions hi).unit with hwdef
  have hw0 : rationalFunctionsEquivFunctionField X w ≠ 0 :=
    (w.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
  have hZ : ((m' : ℤ) • A + ffDiv _ hw0) = ((0 : Divisor X) + m' • A).zeroDivisor _ hi := by
    rw [ffDiv_rationalFunctionsEquivFunctionField, ← hEq, add_comm]
    rfl
  refine ⟨_, hw0, mem_sectionsIn_of_coeff_nonneg hw0 fun P => ?_, ?_⟩
  · rw [hZ]; exact MMP.Mori.Divisor.zeroDivisor_nonneg _ _ hi P
  · rw [hZ]; exact hx

/-- **The perturbed boundary.** Under the hypotheses of the main theorem there is an effective
`ℚ`-divisor `D_Q = (p₀K · (pD₁ + div g) + B)/(p₀(pK + 1))`, for a general member `g` of `|pD₁|`
and a multiple `p` of `p₀` computing `𝒥_{Θ,‖D‖_S}`, such that `D - D_Q` has an `f`-ample
multiple, neither `D_Q` (for `Δ`) nor `D_Q + S` (for `Δ - S`) nor `D_Q|_S` (for `Θ`) contains a
stratum, and every section of `𝒥_{Θ,‖D‖_S}` satisfies the valuative bounds defining
`𝒥_{Θ,D_Q|_S}`. -/
private theorem exists_boundary (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hf : IsProjectiveMorphism f) (hZ : IsAffine Z)
    (Δ : Divisor X) (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    (D : Divisor X) (A B : Divisor X)
    (hA : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A.divisorialSheaf)
    (hB₀ : 0 ≤ B) (hB : ContainsNoStratum Δ B.supp) (p₀ : ℕ) (hp₀ : 0 < p₀)
    (hDAB : ((p₀ : ℤ) • D).LinearlyEquivalent (A + B)) (b : ℕ)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField)
    (hJ : IsRestrictedAsymptoticAdjointIdeal sX f Δ D S b 1 J) :
    haveI := S.integral
    ∃ (DQ : QDivisor X), (∀ P, 0 ≤ DQ.coeff P) ∧ ContainsNoStratum Δ DQ.supp ∧
      ContainsNoStratum (Δ - Finsupp.single S 1)
        (DQ + Divisor.toQDivisor (Finsupp.single S 1)).supp ∧
      (Divisor.toQDivisor D - DQ).HasRelativelyAmpleMultiple f ∧
      (∀ P, 0 ≤ (DQ.restrictPrimeDivisor S).coeff P) ∧
      ContainsNoStratum ((Δ - Finsupp.single S 1).restrictPrimeDivisor S)
        (DQ.restrictPrimeDivisor S).supp ∧
      ∀ W, J W ⊆ adjointSet (S.idealSheaf.subschemeι ≫ sX)
        ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (DQ.restrictPrimeDivisor S) W := by
  haveI := S.integral
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : NoetherianSpace X := MMP.Resolution.Aux.noetherianSpace_of_finiteType sX
  obtain ⟨_, _, _, φ, hφS, hasym⟩ := hJ
  obtain ⟨-, -, hSv, hSsm, hΘ, hDSc, hgr, hb, -, -, -, Jp, hJp, hJdef⟩ := id hasym
  set T := S.idealSheaf.subscheme with hTdef
  set D₁ : Divisor X := D + MMP.Mori.principalDivisor φ with hD₁
  set Θ := (Δ - Finsupp.single S 1).restrictPrimeDivisor S with hΘdef
  set DS := D₁.restrictPrimeDivisor S with hDSdef
  have hD₁c : D₁.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  haveI : CompactSpace T := S.idealSheaf.subschemeι.isClosedEmbedding.compactSpace
  -- stabilization of the asymptotic ideal
  obtain ⟨p₁, hp₁, hbp₁, -, hstab⟩ := exists_seriesSet_stabilizes (S.idealSheaf.subschemeι ≫ sX)
    (S.idealSheaf.subschemeι ≫ f) hasym
  -- members of a multiple of `A` avoiding a point
  have hAc : A.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm A
  obtain ⟨m', hm', hsecA⟩ := exists_sections_notMem_supp sX hX hsm hAc
    (isAmple_of_hasImmersionTwistOver f hf hAc hA)
  set p := p₁ * (p₀ * m') with hpdef
  have hp : 0 < p := Nat.mul_pos hp₁ (Nat.mul_pos hp₀ hm')
  have hbp : b ∣ p := hbp₁.trans (dvd_mul_right _ _)
  have hmemX : ∀ x : X, x ∉ B.supp → ∃ g : X.functionField, ∃ hg : g ≠ 0,
      g ∈ sectionsIn ((p : ℤ) • D₁) ∧ x ∉ ((p : ℤ) • D₁ + ffDiv g hg).supp := by
    intro x hxB
    obtain ⟨ψ, hψ⟩ := hDAB
    obtain ⟨gA, hgA, hgAs, hxA⟩ := hsecA x
    obtain ⟨uA, huA⟩ : ∃ uA : (MMP.Mori.RationalFunctions X)ˣ,
        uA = Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom
          (Units.mk0 gA hgA) := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : (MMP.Mori.RationalFunctions X)ˣ,
        w = uA ^ (p₁ : ℤ) * (ψ ^ ((p₁ * m' : ℕ) : ℤ) * φ ^ (p : ℤ))⁻¹ := ⟨_, rfl⟩
    have hw0 : rationalFunctionsEquivFunctionField X w ≠ 0 :=
      (w.isUnit.map (rationalFunctionsEquivFunctionField X)).ne_zero
    have hcoef : ∀ E, ((p : ℤ) • D₁ + ffDiv (rationalFunctionsEquivFunctionField X w) hw0).coeff E =
        (p₁ : ℤ) * ((m' : ℤ) • A + ffDiv gA hgA).coeff E + ((p₁ * m' : ℕ) : ℤ) * B.coeff E := by
      intro E
      have e1 := congrArg (fun D' : Divisor X => D'.coeff E) hψ
      simp only [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add,
        DivisorWithCoeffs.coeff_smul, coeff_principalDivisor, smul_eq_mul] at e1
      have e2 : (ffDiv gA hgA).coeff E = E.ord uA := by rw [huA]; exact coeff_principalDivisor _ E
      rw [ffDiv_rationalFunctionsEquivFunctionField w hw0, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, hD₁,
        DivisorWithCoeffs.coeff_add, coeff_principalDivisor, coeff_principalDivisor,
        DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, e2, hw,
        MMP.Mori.PrimeDivisor.ord_mul, MMP.Mori.PrimeDivisor.ord_zpow,
        MMP.Mori.PrimeDivisor.ord_inv, MMP.Mori.PrimeDivisor.ord_mul,
        MMP.Mori.PrimeDivisor.ord_zpow, MMP.Mori.PrimeDivisor.ord_zpow, hpdef]
      simp only [smul_eq_mul]
      push_cast
      linear_combination ((p₁ : ℤ) * m') * e1
    refine ⟨rationalFunctionsEquivFunctionField X w, hw0, fun P => ?_, fun hx => ?_⟩
    · rw [P.divisorialValuation_eq_exp_neg_ord hw0, WithZero.exp_le_exp]
      have h1 := hcoef P
      have h2 := coeff_add_ffDiv_nonneg hgAs hgA P
      have h3 : 0 ≤ B.coeff P := hB₀ P
      rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0] at h1
      have h4 : (0 : ℤ) ≤ (p₁ : ℤ) * ((m' : ℤ) • A + ffDiv gA hgA).coeff P +
          ((p₁ * m' : ℕ) : ℤ) * B.coeff P := by positivity
      omega
