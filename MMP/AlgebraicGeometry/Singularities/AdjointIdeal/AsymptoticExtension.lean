/-- The coefficient of the divisor of a nonzero rational function is its order. -/
private theorem coeff_ffDiv [CompactSpace X] (g : X.functionField) (hg : g ≠ 0)
    (P : MMP.Mori.PrimeDivisor X) : (ffDiv g hg).coeff P = X.ord g P.genericPoint := by
  rw [coeff_principalDivisor, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  simp

end RationalFunctions

