    · exact Or.inr ⟨rfl, (hTF P hP).1, (hTF P hP).2⟩
    · exact Or.inl rfl
  have hSSA : ∀ U, seriesSet (S.idealSheaf.subschemeι ≫ sX) Θ ((p : ℤ) • DS)
      (imageSeries D₁ S p : Set T.functionField) ((1 : ℚ) / p) U ⊆
        adjointSet (S.idealSheaf.subschemeι ≫ sX) Θ (DQ.restrictPrimeDivisor S) U := fun U =>
    seriesSet_subset_adjointSet (S.idealSheaf.subschemeι ≫ sX) hSv hSsm hΘ (hcarT _)
      (by positivity) hDQS0 hDQSns hY' hμ' hμ'p hsm' hs hsnc (Nat.mul_pos hp₀ (Nat.succ_pos _))
      hD₀Q (hcarT D₀) hD₀' F' hfix hfloor U
  refine ⟨DQ, hDQ0, hDQns, hDQns', hamp, hDQS0, hDQSns, fun W g' hg' => ?_⟩
  -- every section of `J` lies in the stabilized series ideal near each point
  refine ⟨fun hW => ((hJdef W g').1 hg').1 hW, fun n F₀ a₀ a hx ha₀ ha => ?_⟩
  obtain ⟨W', hxW', -, q, hq, hbq, hgq⟩ := ((hJdef W g').1 hg').2 _ hx
  obtain ⟨Yq, μq, hOnq⟩ := hJp q hq hbq
  rw [eq_seriesSet _ hOnq] at hgq
  have hne : Nonempty W' := ⟨⟨_, hxW'⟩⟩
  have h1 := seriesSet_subset_of_dvd (S.idealSheaf.subschemeι ≫ sX) (S.idealSheaf.subschemeι ≫ f)
    hgr hDSc (Nat.mul_pos hq hp) (dvd_mul_right q p) W' hgq
  rw [hstab (q * p) (Nat.mul_pos hq hp) ((dvd_mul_right p₁ _).trans (dvd_mul_left p q)) W' hne,
    ← hstab p hp (dvd_mul_right p₁ _) W' hne] at h1
  exact (hSSA W' h1).2 n F₀ a₀ a hxW' ha₀ ha

/-- **The adjoint data.** Under the hypotheses of the main theorem there are an effective
`ℚ`-divisor `D_Q ∼_ℚ D - δA/p₀` built from a general member of a computing series `|pD|`, log
resolutions computing `𝒥_{Δ,D_Q}`, `𝒥_{Δ-S,D_Q+S}` and `𝒥_{Θ,D_Q|_S}`, such that `D - D_Q` is
`f`-ample and `𝒥_{Θ,‖D‖_S} ⊆ 𝒥_{Θ,D_Q|_S}`. -/
private theorem exists_adjointData (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hf : IsProjectiveMorphism f) (hZ : IsAffine Z)
    (Δ : Divisor X) (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    (D : Divisor X) (A B : Divisor X)
    (hA : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A.divisorialSheaf)
    (hB₀ : 0 ≤ B) (hB : ContainsNoStratum Δ B.supp) (p₀ : ℕ) (hp₀ : 0 < p₀)
    (hDAB : ((p₀ : ℤ) • D).LinearlyEquivalent (A + B)) (b : ℕ)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField)
    (hJ : IsRestrictedAsymptoticAdjointIdeal sX f Δ D S b 1 J) :
    haveI := S.integral
    ∃ (DQ : QDivisor X), (Divisor.toQDivisor D - DQ).HasRelativelyAmpleMultiple f ∧
      (∃ (Y : Scheme.{u}) (μ : Y ⟶ X) (JX : X.Opens → Set X.functionField),
        CompactSpace Y ∧ IsReducedAdjointIdealOn sX Δ DQ μ JX) ∧
      (∃ (Y' : Scheme.{u}) (μ' : Y' ⟶ X) (J' : X.Opens → Set X.functionField),
        IsReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
          (DQ + Divisor.toQDivisor (Finsupp.single S 1)) μ' J') ∧
      ∃ (YS : Scheme.{u}) (μS : YS ⟶ S.idealSheaf.subscheme)
        (JS : S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField),
        CompactSpace YS ∧ IsReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
          ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (DQ.restrictPrimeDivisor S) μS JS ∧
        ∀ W, J W ⊆ JS W := by
  haveI := S.integral
  obtain ⟨DQ, hDQ0, hDQns, hDQns', hamp, hDQS0, hDQSns, hsub⟩ :=
    exists_boundary sX f hX hsm hf hZ Δ hΔ S hS D A B hA hB₀ hB p₀ hp₀ hDAB b J hJ
  obtain ⟨j₁, j₂, j₃, φ, -, hasym⟩ := id hJ
  obtain ⟨-, -, hSv, hSsm, hΘ, -⟩ := hasym
  obtain ⟨Y, μ, JX, hJX⟩ := exists_isReducedAdjointIdealOn sX Δ DQ hX hsm hΔ hDQ0 hDQns
  have hS0 : ∀ P, 0 ≤ (DQ + Divisor.toQDivisor (Finsupp.single S 1)).coeff P := fun P => by
    have h2 : (0 : ℤ) ≤ DivisorWithCoeffs.coeff (Finsupp.single S (1 : ℤ) : Divisor X) P := by
      classical
      rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]; split_ifs <;> norm_num
    rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    exact add_nonneg (hDQ0 P) (by exact_mod_cast h2)
  obtain ⟨Y', μ', J', hJ'⟩ := exists_isReducedAdjointIdealOn sX (Δ - Finsupp.single S 1)
    (DQ + Divisor.toQDivisor (Finsupp.single S 1)) hX hsm (isReducedSNC_sub_single sX hΔ S hS)
    hS0 hDQns'
  obtain ⟨YS, μS, JS, hJS⟩ := exists_isReducedAdjointIdealOn (S.idealSheaf.subschemeι ≫ sX)
    ((Δ - Finsupp.single S 1).restrictPrimeDivisor S) (DQ.restrictPrimeDivisor S) hSv hSsm hΘ
    hDQS0 hDQSns
  have hcY : CompactSpace Y := by
    obtain ⟨-, -, -, -, -, -, i₁, i₂, i₃, i₄, hY, -⟩ := hJX
    haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
    exact QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  have hcYS : CompactSpace YS := by
    obtain ⟨-, -, -, -, -, -, i₁, i₂, i₃, i₄, hY, -⟩ := hJS
    haveI : MMP.Mori.IsVariety k (μS ≫ S.idealSheaf.subschemeι ≫ sX) := hY.1
    exact QuasiCompact.compactSpace_of_compactSpace (μS ≫ S.idealSheaf.subschemeι ≫ sX)
  refine ⟨DQ, hamp, ⟨Y, μ, JX, hcY, hJX⟩, ⟨Y', μ', J', hJ'⟩, YS, μS, JS, hcYS, hJS, ?_⟩
  rw [eq_adjointSet _ hJS]
  exact hsub

/-! ### Strict transforms of prime divisors -/

section StrictTransform

variable {X Y : Scheme.{u}}

/-- **The strict transform of a prime divisor.** For a proper birational morphism `μ : Y ⟶ X`
onto a normal scheme, every prime divisor `Q` of `X` has a prime divisor `E` of `Y` over it with
`μ(η_E) = η_Q` and `μ^♯ : 𝒪_{X,Q} ≅ 𝒪_{Y,E}`. -/
private theorem exists_primeDivisor_isIso_stalkMap [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] (μ : Y ⟶ X) [IsProper μ]
    (hμ : IsBirationalMorphism μ) (Q : MMP.Mori.PrimeDivisor X) :
    ∃ E : MMP.Mori.PrimeDivisor Y,
      μ E.genericPoint = Q.genericPoint ∧ IsIso (μ.stalkMap E.genericPoint) := by
  have := Q.isDiscreteValuationRing_localRing
  haveI := hμ.isDominant
  obtain ⟨x, hx, hiso⟩ :=
    MMP.Intersection.exists_isIso_stalkMap_of_valuationRing μ hμ.functionFieldMap_bijective
      Q.genericPoint
  have hco : Order.coheight x = 1 := by
    have h := ringKrullDim_eq_of_ringEquiv (asIso (μ.stalkMap x)).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight, hx,
      Q.coheight_genericPoint] at h
    exact_mod_cast h.symm
  let E : MMP.Mori.PrimeDivisor Y := AlgebraicGeometry.PrimeDivisor.ofCoheightOne x hco
  have hE : E.genericPoint = x := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne x hco
  exact ⟨E, hE ▸ hx, hE ▸ hiso⟩

/-- At a strict transform, `v_E` seen on `k(X)` through `μ` is `v_Q`. -/
private theorem valuationOver_eq_of_isIso [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ]
    (E : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : μ E.genericPoint = Q.genericPoint) [IsIso (μ.stalkMap E.genericPoint)] :
    E.valuationOver μ = Q.divisorialValuation := by
  refine Valuation.ext fun t => ?_
  rw [PrimeDivisor.valuationOver_apply]
  by_cases ht : t = 0
  · rw [ht, map_zero, map_zero, map_zero]
  rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
    PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
    MMP.Positivity.ord_functionFieldMap_of_isIso μ E Q heq t]

/-- At a strict transform `E` of `Q`, the coefficient of `E` in the pull-back of a Cartier
divisor `M` is the coefficient of `Q` in `M`. -/
private theorem coeff_isPullback_eq_of_valuationOver_eq [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X} [IsDominant μ]
    {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) (E : MMP.Mori.PrimeDivisor Y)
    (Q : MMP.Mori.PrimeDivisor X) (heq : μ E.genericPoint = Q.genericPoint)
    (hv : E.valuationOver μ = Q.divisorialValuation) : Mμ.coeff E = M.coeff Q := by
  obtain ⟨U, hU, φ, hφ⟩ := hMc Q.genericPoint
  have hE := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ E (heq ▸ hU) Q.component
  have hQ : M.coeff Q = Q.ord φ := hφ Q ((Q.genericPoint_mem_iff U).mp hU)
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord] at hQ
  set c := MMP.Threefold.Mori.Helpers.evalFF Q.component (φ : RationalFunctions X)
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have h1 := congrArg (fun v : Valuation X.functionField (WithZero (Multiplicative ℤ)) => v c) hv
  simp only [PrimeDivisor.valuationOver_apply] at h1
  rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr hc0),
    PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hc0] at h1
  rw [hE, hQ]
  simpa using h1

/-- At a strict transform `E` of `Q`, the coefficient of `E` in the pull-back of a `ℚ`-Cartier
`ℚ`-divisor `B` is the coefficient of `Q` in `B`. -/
private theorem coeff_isPullback_qDivisor_eq [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (E : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : μ E.genericPoint = Q.genericPoint) [IsIso (μ.stalkMap E.genericPoint)]
    {B : QDivisor X} (hBq : B.IsQCartier)
    {hB : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ B.supp}
    {B' : QDivisor Y} (hB' : B.IsPullback μ hB B') : B' E = B Q := by
  have hm := QDivisor.cartierIndex_pos hBq
  obtain ⟨D₀, hD₀, hD₀c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hBq
  obtain ⟨D', hD', hp⟩ := hB' _ hm D₀ hD₀ hD₀c
  have hc := MMP.Positivity.coeff_eq_of_isPullback E Q heq hD₀c hp
  have h1 := congrArg (fun G : QDivisor Y => G E) hD'
  have h2 := congrArg (fun G : QDivisor X => G Q) hD₀
  simp only [Finsupp.smul_apply, zsmul_eq_mul, Int.cast_natCast] at h1 h2
  refine mul_left_cancel₀ (by exact_mod_cast hm.ne') (h1.symm.trans (Eq.trans ?_ h2))
  exact congrArg (fun z : ℤ => (z : ℚ)) hc

end StrictTransform

/-! ### Twisting push-forwards by a Cartier divisor -/

section Twist

variable {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- **The projection formula on sections.** If `φ` is a local equation of the Cartier divisor
`M` on `V` and `μ^*M` its pull-back, then over an open `U ⊆ V` a rational function `g` is a
section of `μ_*𝒪_Y(G + μ^*M)` exactly when `φ g` is a section of `μ_*𝒪_Y(G)`. -/
private theorem mem_multiplierIdealSections_add_iff {μ : Y ⟶ X} [IsDominant μ] {M : Divisor X}
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) {V : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : M.IsLocalEquation V φ) (Z : irreducibleComponents X) (G : Divisor Y) {U : X.Opens}
    (hUV : U ≤ V) (g : X.functionField) :
    g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) U ↔
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) * g ∈
        MMP.Intersection.multiplierIdealSections μ G U := by
  set c := MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) with hc
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hval : ∀ P : MMP.Mori.PrimeDivisor Y, (P.support ∩ μ ⁻¹ᵁ U).Nonempty →
      P.valuationOver μ c = WithZero.exp (-Mμ.coeff P) := by
    intro P hP
    have hU : μ P.genericPoint ∈ V :=
      hUV (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP)
    rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hU Z,
      PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr hc0)]
  constructor
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => by rw [h0 hU, mul_zero], fun P hP => ?_⟩
    rw [map_mul, hval P hP]
    have := hg P hP
    rw [DivisorWithCoeffs.coeff_add] at this
    calc WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g ≤
          WithZero.exp (-Mμ.coeff P) * WithZero.exp (G.coeff P + Mμ.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P) := by rw [← WithZero.exp_add]; congr 1; ring
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => (mul_eq_zero.mp (h0 hU)).resolve_left hc0, fun P hP => ?_⟩
    have := hg P hP
    rw [map_mul, hval P hP] at this
    rw [DivisorWithCoeffs.coeff_add]
    calc P.valuationOver μ g = WithZero.exp (Mμ.coeff P) *
          (WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g) := by
          rw [← mul_assoc, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero, one_mul]
      _ ≤ WithZero.exp (Mμ.coeff P) * WithZero.exp (G.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P + Mμ.coeff P) := by rw [← WithZero.exp_add, add_comm]

/-- Sections of `μ_*𝒪_Y(G)` restrict to smaller nonempty opens. -/
private theorem multiplierIdealSections_mono (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) {g : X.functionField}
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ G U) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G W :=
  ⟨fun h => absurd ((preimage_eq_bot_iff μ W).1 h) hW,
    fun P hP => hg.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hWU hy))⟩

/-- Membership in `μ_*𝒪_Y(G)(U)` is local on `U`: it suffices on a neighbourhood `W x ⊆ U` of
every point `x ∈ U`. -/
private theorem mem_multiplierIdealSections_of_local (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U : X.Opens} (W : X → X.Opens) (hW : ∀ x ∈ U, x ∈ W x ∧ W x ≤ U) {g : X.functionField}
    (h0 : U = ⊥ → g = 0)
    (hg : ∀ x ∈ U, g ∈ MMP.Intersection.multiplierIdealSections μ G (W x)) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  refine ⟨fun h => h0 ((preimage_eq_bot_iff μ U).1 h), fun P hP => ?_⟩
  have hx := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
  refine (hg _ hx).2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P ?_)
  exact (hW _ hx).1

/-- **Twisting is determined by the untwisted push-forward.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections, so do `μ_*𝒪_Y(G + μ^*M)` and
`μ'_*𝒪_{Y'}(G' + μ'^*M)`, for a Cartier divisor `M` of `X`. -/
private theorem multiplierIdealSections_add_pullback_congr {Y' : Scheme.{u}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {μ : Y ⟶ X} {μ' : Y' ⟶ X} [IsDominant μ]
    [IsDominant μ'] {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {hM' : ∀ Z : irreducibleComponents Y', μ' (componentGenericPoint Y' Z) ∉ M.supp}
    {Mμ : Divisor Y} {Mμ' : Divisor Y'} (h : M.IsPullback μ hM Mμ)
    (h' : M.IsPullback μ' hM' Mμ') {G : Divisor Y} {G' : Divisor Y'}
    (hG : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ' (G' + Mμ') := by
  choose V hxV φ hφ using hMc
  let Z : irreducibleComponents X := pointComponent (genericPoint X)
  have key : ∀ {Y₁ : Scheme.{u}} [IsIntegral Y₁] [IsLocallyNoetherian Y₁] [IsNormal Y₁]
      (μ₁ : Y₁ ⟶ X) [IsDominant μ₁]
      {hM₁ : ∀ Z : irreducibleComponents Y₁, μ₁ (componentGenericPoint Y₁ Z) ∉ M.supp}
      {M₁ : Divisor Y₁} (h₁ : M.IsPullback μ₁ hM₁ M₁) (G₁ : Divisor Y₁) (U : X.Opens)
      (g : X.functionField),
      g ∈ MMP.Intersection.multiplierIdealSections μ₁ (G₁ + M₁) U ↔
        (U = ⊥ → g = 0) ∧ ∀ x ∈ U,
          MMP.Threefold.Mori.Helpers.evalFF Z (φ x : RationalFunctions X) * g ∈
            MMP.Intersection.multiplierIdealSections μ₁ G₁ (U ⊓ V x) := by
    intro Y₁ _ _ _ μ₁ _ hM₁ M₁ h₁ G₁ U g
    have hne : ∀ x ∈ U, U ⊓ V x ≠ ⊥ := fun x hx hb => by
      have : x ∈ U ⊓ V x := ⟨hx, hxV x⟩
      rw [hb] at this; exact this
    constructor
    · intro hg
      refine ⟨fun hU => hg.1 ((preimage_eq_bot_iff μ₁ U).2 hU), fun x hx => ?_⟩
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).1
        (multiplierIdealSections_mono μ₁ _ inf_le_left (hne x hx) hg)
    · rintro ⟨h0, hg⟩
      refine mem_multiplierIdealSections_of_local μ₁ _ (fun x => U ⊓ V x)
        (fun x hx => ⟨⟨hx, hxV x⟩, inf_le_left⟩) h0 fun x hx => ?_
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).2 (hg x hx)
  funext U
  ext g
  rw [key μ h G U g, key μ' h' G' U g, hG]

end Twist

/-! ### Pull-backs along morphisms which are not dominant -/

section PullbackStalk

variable {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- **The coefficient of a pull-back along any morphism.** If `φ` is a local equation of `C` on
`U ∋ f(η_E)`, the coefficient of `E` in `f^*C` is the order along `E` of the image under `f^♯` of
the unit `a` of `𝒪_{X, f(η_Y)}` representing `φ`. -/
private theorem coeff_isPullback_eq_ord_stalkMap {f : Y ⟶ X} {C : Divisor X}
    {hC : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ C.supp}
    {C' : Divisor Y} (h : C.IsPullback f hC C') {U : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : C.IsLocalEquation U φ) (E : MMP.Mori.PrimeDivisor Y)
    (hU : f E.genericPoint ∈ U) {W : irreducibleComponents X}
    (hW : f (componentGenericPoint Y E.component) ∈ W.1)
    (a : (X.presheaf.stalk (f (componentGenericPoint Y E.component)))ˣ)
    (ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) W) :
    C'.coeff E = Y.ord ((Y.presheaf.stalkSpecializes
      ((genericPoint_spec Y).specializes trivial :
        genericPoint Y ⤳ componentGenericPoint Y E.component)).hom
      ((f.stalkMap (componentGenericPoint Y E.component)).hom a)) E.genericPoint := by
  classical
  have hE : (E.support ∩ f ⁻¹ᵁ U).Nonempty := (E.genericPoint_mem_iff (f ⁻¹ᵁ U)).mp hU
  rw [h U φ hφ E hE]
  have hZp := E.map_componentGenericPoint_mem f hE
  rw [pullbackComponent_eq hC hφ hZp hW a ha]
  set u := Units.map (f.stalkMap (componentGenericPoint Y E.component)).hom.toMonoidHom a
    with hu
  let ψ : (RationalFunctions Y)ˣ :=
    (RationalFunctions.unitsEquiv Y).symm (Function.update 1 E.component u)
  have hψZ : (ψ : RationalFunctions Y) E.component = u := by
    simp [ψ, RationalFunctions.unitsEquiv]
  have h1 : E.ordUnit u = E.ord ψ := by
    rw [PrimeDivisor.ord_eq_ordUnit]
    congr 1
    exact (Units.ext hψZ).symm
  rw [h1, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
  congr 1
  change (Y.presheaf.stalkSpecializes _).hom ((ψ : RationalFunctions Y) E.component) = _
  rw [hψZ]
  rfl

end PullbackStalk

/-! ### The adjoint discrepancy divisor at a strict transform -/

section Adjoint

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- **The adjoint discrepancy divisor vanishes at strict transforms.** If `Δ` is reduced and
`E` is the divisor with `K_Y + Γ = μ^*(K_X + Δ) + E`, then `coeff_P E = 0` for a prime divisor
`P` of `Y` inducing the valuation of a prime divisor `Q` of `X`: `a(P, X, Δ) = 1 - coeff_Q Δ`,
and `P` is a zero place exactly when `Q ≤ Δ`. -/
private theorem coeff_eq_zero_of_valuationOver_eq [IsAlgClosed k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ : Divisor X} (hΔ : MMP.Intersection.IsReducedEffective Δ)
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    {Γ E : Divisor Y} (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) (P : MMP.Mori.PrimeDivisor Y)
    (Q : MMP.Mori.PrimeDivisor X) (hv : P.valuationOver μ = Q.divisorialValuation) :
    E.coeff P = 0 := by
  obtain ⟨n, a, ha, hEa⟩ := hE P
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  have hQ := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn (Divisor.toQDivisor Δ) Q
  rw [QDivisor.toRDivisor_toQDivisor] at hQ
  have hval : (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX).valuation =
      (DivisorOver.ofPrimeDivisor k hX Q).valuation := by
    refine hv.trans ?_
    refine Valuation.ext fun g => ?_
    change _ = Q.divisorialValuation (functionFieldMap (𝟙 X) g)
    rw [MMP.Mori.functionFieldMap_id_apply]
  have haQ := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hQ hval
  rw [Divisor.coeff_toQDivisor] at haQ
  rcases hΔ Q with h0 | h1
  · rw [h0] at haQ
    have hΓ0 : Γ.coeff P = 0 := by
      rcases hΓ.1 P with h | h
      · exact h
      · obtain ⟨n', h'⟩ := (hΓ.2 P).mp h
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h'
        norm_num at haQ
        linarith
    rw [hΓ0] at hEa
    norm_num at haQ
    rw [haQ] at hEa
    exact_mod_cast (by simpa using hEa : (E.coeff P : ℝ) = 0)
  · rw [h1] at haQ
    norm_num at haQ
    have hΓ1 : Γ.coeff P = 1 := (hΓ.2 P).mpr ⟨n, haQ ▸ ha⟩
    rw [hΓ1, haQ] at hEa
    exact_mod_cast (by simpa using hEa : (E.coeff P : ℝ) = 0)

end Adjoint

/-- A point of `S` (as a scheme) of coheight zero maps outside the support of a divisor of which
`S` is not a component; in particular the generic points of a scheme dominating `S` do. -/
private theorem comp_ι_componentGenericPoint_notMem_supp (S : MMP.Mori.PrimeDivisor X)
    (M : Divisor X) (hM : M.coeff S = 0) {YS : Scheme.{u}}
    (μS : YS ⟶ (haveI := S.integral; S.idealSheaf.subscheme)) [IsIntegral YS] [IsDominant μS] :
    haveI := S.integral
    ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp := by
  haveI := S.integral
  intro C hmem
  rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply,
    map_genericPoint_of_isDominant] at hmem
  obtain ⟨E, hE, hx⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
  exact DivisorWithCoeffs.forall_notMem_support_primeDivisor M S hM E
    (Finsupp.mem_support_iff.mpr hE) _
    (Order.coheight_eq_zero.mpr fun t _ => genericPoint_specializes t) hx

/-- A valuation bounded by `γ` on a set is bounded by `γ` on its `ℤ`-span. -/
private theorem valuation_le_of_mem_span {K Γ : Type*} [Field K]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation K Γ) {S : Set K} {γ : Γ}
    (hS : ∀ s ∈ S, v s ≤ γ) {g : K} (hg : g ∈ Submodule.span ℤ S) : v g ≤ γ := by
  induction hg using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => simp
  | add x y _ _ hx hy => exact v.map_add_le hx hy
  | smul n x _ hx =>
    induction n using Int.induction_on with
    | zero => simp
    | succ k hk => rw [add_smul, one_smul]; exact v.map_add_le hk hx
    | pred k hk => rw [sub_smul, one_smul]; exact v.map_sub_le hk hx

/-- **Sections of the twisted ideal on `S` pulled back.** A global section of
`J ⊗ 𝒪_S(M|_S)` with `J ⊆ μS_*𝒪(GS)` is a section of `μS_*𝒪_{YS}(GS + MS)`, for `MS` the
pull-back of `M` to `YS`. -/
private theorem mem_multiplierIdealSections_of_forall (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (hsm : IsSmoothScheme sX)
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    (M : Divisor X) (hMc : M.IsCartier) (hM : M.coeff S = 0) {YS : Scheme.{u}}
    (μS : YS ⟶ (haveI := S.integral; S.idealSheaf.subscheme)) [IsIntegral YS]
    [IsLocallyNoetherian YS] [IsNormal YS] [IsDominant μS] (GS : Divisor YS)
    (J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField)
    (hJ : haveI := S.integral; ∀ W, J W ⊆ MMP.Intersection.multiplierIdealSections μS GS W)
    (hMS : haveI := S.integral; ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp)
    (MS : Divisor YS) (hMSp : M.IsPullback (haveI := S.integral; μS ≫ S.idealSheaf.subschemeι)
      hMS MS)
    (h : haveI := S.integral; S.idealSheaf.subscheme.functionField)
    (hh : haveI := S.integral; ∀ x : S.idealSheaf.subscheme, ∃ W : S.idealSheaf.subscheme.Opens,
      x ∈ W ∧ h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections
        (𝟙 S.idealSheaf.subscheme) (M.restrictPrimeDivisor S) W * J W)) :
    haveI := S.integral; h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤ := by
  haveI := S.integral
  haveI : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  haveI : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  refine ⟨fun h0 => absurd ((preimage_eq_bot_iff μS ⊤).1 h0) (by simp), fun P _ => ?_⟩
  set y := μS P.genericPoint with hy
  obtain ⟨W, hyW, hhW⟩ := hh y
  -- the bound on the generators `u * j`
  have hgen : ∀ u ∈ MMP.Intersection.multiplierIdealSections (𝟙 S.idealSheaf.subscheme)
      (M.restrictPrimeDivisor S) W, P.valuationOver μS u ≤ WithZero.exp (MS.coeff P) := by
    intro u hu
    haveI : IsNoetherian X := {}
    obtain ⟨V, hxV, φ, hφ⟩ := hMc (S.idealSheaf.subschemeι y)
    have hc : μS (componentGenericPoint YS P.component) = genericPoint S.idealSheaf.subscheme := by
      rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    have hιη : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) = S.genericPoint :=
      rfl
    have hSV : S.genericPoint ∈ V := by
      rw [← hιη]
      exact ((genericPoint_specializes y).map S.idealSheaf.subschemeι.continuous).mem_open
        V.isOpen hxV
    obtain ⟨a, ha⟩ := exists_unit_stalk_of_forall_ord_eq_zero
      (y := (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS P.component))
      (W := pointComponent _) (mem_pointComponent _) φ (fun E hE => by
        rw [Scheme.Hom.comp_apply, hc, hιη] at hE
        have := E.eq_genericPoint_of_mem_support hE S.coheight_genericPoint
        have hES : S = E := AlgebraicGeometry.PrimeDivisor.genericPoint_injective this
        subst hES
        rw [← hφ S ((S.genericPoint_mem_iff V).mp hSV)]
        exact hM)
    have hB := coeff_isPullback_eq_ord_stalkMap hMSp hφ P
      (by rw [Scheme.Hom.comp_apply]; exact hxV) (mem_pointComponent _) a ha
    let a' : (X.presheaf.stalk (S.idealSheaf.subschemeι
        (μS (componentGenericPoint YS P.component))))ˣ := a
    let ψ : S.idealSheaf.subscheme.functionField :=
      algebraMap (S.idealSheaf.subscheme.presheaf.stalk (μS (componentGenericPoint YS P.component)))
        S.idealSheaf.subscheme.functionField
        ((S.idealSheaf.subschemeι.stalkMap (μS (componentGenericPoint YS P.component))).hom a')
    have hψ0 : ψ ≠ 0 :=
      ((a'.isUnit.map (S.idealSheaf.subschemeι.stalkMap _).hom).map (algebraMap _ _)).ne_zero
    have h1 : (YS.presheaf.stalkSpecializes ((genericPoint_spec YS).specializes trivial :
        genericPoint YS ⤳ componentGenericPoint YS P.component)).hom
        (((μS ≫ S.idealSheaf.subschemeι).stalkMap (componentGenericPoint YS P.component)).hom a) =
        functionFieldMap μS ψ := by
      rw [MMP.Mori.functionFieldMap_algebraMap_stalk μS (componentGenericPoint YS P.component),
        Scheme.Hom.stalkMap_comp]
      rfl
    have hψP : P.valuationOver μS ψ = WithZero.exp (-MS.coeff P) := by
      rw [PrimeDivisor.valuationOver_apply, ← h1,
        PrimeDivisor.divisorialValuation_eq_exp_neg_ord _
          (by rw [h1]; exact (map_ne_zero _).mpr hψ0), hB]
    have hψQ : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
        S.idealSheaf.subschemeι Q.genericPoint ∈ V →
        Q.divisorialValuation ψ = WithZero.exp (-(M.restrictPrimeDivisor S).coeff Q) := by
      intro Q hQ
      rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hψ0,
        coeff_restrictPrimeDivisor_eq_ord_of_eq sX S M hM hφ _ hc a'
          (mem_pointComponent _) ha Q hQ]
    have hreg : u * ψ ∈
        (algebraMap (S.idealSheaf.subscheme.presheaf.stalk y)
          S.idealSheaf.subscheme.functionField).range := by
      refine Scheme.mem_range_algebraMap_stalk_of_forall_coheight_eq_one _ fun z hz hzy => ?_
      let Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme :=
        AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hz
      have hQη : Q.genericPoint = z :=
        AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hz
      have hzW : z ∈ W := hzy.mem_open W.isOpen hyW
      have hzV : S.idealSheaf.subschemeι Q.genericPoint ∈ V := by
        rw [hQη]; exact (hzy.map S.idealSheaf.subschemeι.continuous).mem_open V.isOpen hxV
      have hQ := hu.2 Q (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem Q
        (by rw [hQη]; exact hzW))
      rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply] at hQ
      rw [← hQη, ← MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff, map_mul, hψQ Q hzV]
      calc _ ≤ WithZero.exp ((M.restrictPrimeDivisor S).coeff Q) *
            WithZero.exp (-(M.restrictPrimeDivisor S).coeff Q) := by gcongr
        _ = 1 := by rw [← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
    have hle : P.valuationOver μS (u * ψ) ≤ 1 := by
      obtain ⟨r, hr⟩ := hreg
      rw [PrimeDivisor.valuationOver_apply, ← hr,
        MMP.Mori.functionFieldMap_algebraMap_stalk μS P.genericPoint r]
      exact (P.divisorialValuation_le_one_iff _).mpr ⟨_, rfl⟩
    rw [map_mul, hψP] at hle
    calc P.valuationOver μS u = P.valuationOver μS u * WithZero.exp (-MS.coeff P) *
          WithZero.exp (MS.coeff P) := by
          rw [mul_assoc, ← WithZero.exp_add, neg_add_cancel, WithZero.exp_zero, mul_one]
      _ ≤ 1 * WithZero.exp (MS.coeff P) := by gcongr
      _ = _ := one_mul _
  refine valuation_le_of_mem_span (P.valuationOver μS) ?_ hhW
  rintro _ ⟨u, hu, j, hj, rfl⟩
  have hjP := (hJ W hj).2 P ((P.genericPoint_mem_iff (μS ⁻¹ᵁ W)).mp hyW)
  rw [map_mul, DivisorWithCoeffs.coeff_add, WithZero.exp_add, mul_comm (WithZero.exp _)]
  exact mul_le_mul' (hgen u hu) hjP

/-- **Sections of `𝒥_{Δ,D_Q}(M)` are sections of `𝒪_X(M)`.** For `μ` computing `𝒥_{Δ,D_Q}` as
`μ_*𝒪_Y(E - ⌊μ^*D_Q⌋)`, a global section of `μ_*𝒪_Y(E - ⌊μ^*D_Q⌋ + μ^*M)` is a section of
`𝒪_X(M)`. -/
private theorem mem_sectionsIn_of_mem_multiplierIdealSections (Δ : Divisor X) (DQ : QDivisor X)
    {Y : Scheme.{u}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] (JX : X.Opens → Set X.functionField) (G : Divisor Y)
    (hJX : IsReducedAdjointIdealOn sX Δ DQ μ JX)
    (hG : JX = MMP.Intersection.multiplierIdealSections μ G)
    (M : Divisor X) (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMμp : M.IsPullback μ hMμ Mμ) (g : X.functionField)
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤) :
    g ∈ sectionsIn M := by
  obtain ⟨hXv, hsm, hΔ, hD0, -, hlog, i₁, i₂, i₃, i₄, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, hJe⟩ :=
    hJX
  haveI : IsProper μ := hlog.isProper
  have hMc : M.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm M
  rw [multiplierIdealSections_add_pullback_congr hMc hMμp hMμp (hG.symm.trans hJe)] at hg
  intro Q
  obtain ⟨P, heq, hiso⟩ := exists_primeDivisor_isIso_stalkMap μ hμ Q
  have hv := valuationOver_eq_of_isIso μ P Q heq
  have hP := hg.2 P ((P.genericPoint_mem_iff (μ ⁻¹ᵁ ⊤)).mp trivial)
  have hE0 := coeff_eq_zero_of_valuationOver_eq sX hXv hsm hΔ.1 hY hμ hΓ hE P Q hv
  have hMP := coeff_isPullback_eq_of_valuationOver_eq hMc hMμp P Q heq hv
  have hFP : F P = DQ Q :=
    coeff_isPullback_qDivisor_eq P Q heq (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm DQ) hF
  have hfl : 0 ≤ ⌊(QDivisor.toRDivisor F).coeff P⌋ := by
    rw [QDivisor.coeff_toRDivisor, Int.floor_nonneg]
    have h0 : (0 : ℚ) ≤ F P := hFP ▸ hD0 Q
    exact_mod_cast h0
  rw [hv, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
    MMP.Intersection.WeilRDivisor.coeff_roundDown, hE0, hMP] at hP
  exact hP.trans (WithZero.exp_le_exp.mpr (by omega))

end Proof_lem_fourfold_asymptotic_adjoint_extension

end

section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_fourfold_asymptotic_adjoint_extension
open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

/-- **Extension with an augmented-base-locus margin.** Let `f : X ⟶ Z` be a projective morphism
to an affine scheme from a smooth variety `X` of dimension `n` over an algebraically closed field
`k` of characteristic zero, with canonical divisor `K`. Let `Δ` be a reduced snc divisor, `S` a
component of `Δ`, and `D` a Cartier divisor with `S` not a component of `K + Δ + D`. Suppose that
`p₀ • D ∼ A + B` for some `p₀ > 0`, an effective divisor `A` very ample over `Z`, and an
effective divisor `B` whose support contains no stratum of `Δ`. Let `J = 𝒥_{Θ,‖D‖_S}` be the
asymptotic adjoint ideal of the image series of `D` on `S`, `Θ = (Δ - S)|_S`. Then every global
section `h` of `J ⊗ 𝒪_S((K + Δ + D)|_S)` is the restriction to `S` of a section of
`𝒪_X(K + Δ + D)`. -/
@[mmp "lem_fourfold_asymptotic_adjoint_extension"]
public theorem exists_isRestrictionAlong_of_linearlyEquivalent_add {k : Type} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z)
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hf : IsProjectiveMorphism f)
    (hZ : IsAffine Z) {n : ℕ} (K : Divisor X) (hK : K.IsCanonicalDivisor sX n)
    (Δ : Divisor X) (hΔ : IsReducedSNC sX Δ) (S : MMP.Mori.PrimeDivisor X) (hS : Δ.coeff S = 1)
    (D : Divisor X) (hD : D.IsCartier) (hKΔD : (K + Δ + D).coeff S = 0)
    (A B : Divisor X) (hA₀ : 0 ≤ A)
    (hA : Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f A.divisorialSheaf)
    (hB₀ : 0 ≤ B) (hB : ContainsNoStratum Δ B.supp) (p₀ : ℕ) (hp₀ : 0 < p₀)
    (hDAB : ((p₀ : ℤ) • D).LinearlyEquivalent (A + B)) (b : ℕ)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField)
    (hJ : IsRestrictedAsymptoticAdjointIdeal sX f Δ D S b 1 J)
    (h : haveI := S.integral; S.idealSheaf.subscheme.functionField)
    (hh : haveI := S.integral; ∀ x : S.idealSheaf.subscheme, ∃ W : S.idealSheaf.subscheme.Opens,
      x ∈ W ∧ h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections
        (𝟙 S.idealSheaf.subscheme) ((K + Δ + D).restrictPrimeDivisor S) W * J W)) :
    ∃ g ∈ sectionsIn (K + Δ + D), IsRestrictionAlong S g h := by
  haveI := S.integral
  haveI := hZ
  obtain ⟨DQ, hamp, ⟨Y, μ, JX, hYc, hJX⟩, ⟨Y', μ', J', hJ'⟩, YS, μS, JS, hYSc, hJS, hsub⟩ :=
    exists_adjointData sX f hX hsm hf hZ Δ hΔ S hS D A B hA hB₀ hB p₀ hp₀ hDAB b J hJ
  obtain ⟨-, -, -, -, -, -, iY₁, iY₂, iY₃, iY₄, -, -, -, Γ, E, F, -, -, -, hJXe⟩ := id hJX
  obtain ⟨-, -, -, -, -, -, iS₁, iS₂, iS₃, iS₄, -, -, -, ΓS, ES, FS, -, -, -, hJSe⟩ := id hJS
  set M : Divisor X := K + Δ + D with hMdef
  have hMc : M.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm M
  have hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp :=
    MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ M
  obtain ⟨Mμ, hMμp⟩ := hMc.exists_isPullback (f := μ) hMμ
  have hMS := comp_ι_componentGenericPoint_notMem_supp S M hKΔD μS
  obtain ⟨MS, hMSp⟩ := hMc.exists_isPullback (f := μS ≫ S.idealSheaf.subschemeι) hMS
  have card := (MMP.Fourfold.isReducedAdjointIdealOn_restriction_vanishing sX f hf Δ DQ μ JX
    hJX _ hJXe).2 S hS μ' J' hJ' μS JS hJS _ hJSe
  obtain ⟨-, hsurj⟩ := card.2 D hD hamp n K hK M hMc (Divisor.LinearlyEquivalent.refl M)
    hKΔD hMμ Mμ hMμp hMS MS hMSp
  have hSsm : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX) := by
    obtain ⟨j₁, j₂, j₃, φ₀, -, hasym⟩ := hJ
    exact hasym.2.2.2.1
  have hhS : h ∈ MMP.Intersection.multiplierIdealSections μS
      (ES - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor FS) + MS) ⊤ :=
    mem_multiplierIdealSections_of_forall sX S hsm hSsm M hMc hKΔD μS _ J
      (fun W => hJSe ▸ hsub W) hMS MS hMSp h hh
  obtain ⟨g, hg, hres⟩ := hsurj h hhS
  exact ⟨g, mem_sectionsIn_of_mem_multiplierIdealSections sX Δ DQ μ JX _ hJX hJXe M hMμ Mμ
    hMμp g hg, hres⟩

end MMP.Fourfold

end

/-! ### `lem_fourfold_remove_extension_twist` -/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

namespace Proof_lem_fourfold_remove_extension_twist

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

noncomputable section

/-! ## Toolkit: the valuative description of reduced-boundary adjoint ideals -/

/-! ### Log discrepancies under adding a Cartier divisor, and valuative bounds -/

section Toolkit

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- Adding `c • C` to the boundary, for a Cartier divisor `C` with pull-back `C'` along the model,
lowers a log discrepancy by `c` times the coefficient of `C'` along the divisor. -/
private theorem isLogDiscrepancy_add_smul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {C : Divisor X}
    (hC : C.IsCartier) (c : ℝ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + c • Divisor.toRDivisor C) F
        (a - c * (C'.coeff F.E : ℝ)) := by
  classical
  intro C' hCs hC'
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₁, C₁', hC₁, hrel, hpb, ha⟩ := h
  refine ⟨hnv, hprop, ω, hω0, hK, m + 1, Fin.snoc r c, Fin.snoc C₁ C, Fin.snoc C₁' C', ?_, ?_,
    ?_, ?_⟩
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simpa using hC
    · simpa using hC₁ j
  · intro Γ
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, DivisorWithCoeffs.coeff_add, ← hrel Γ,
      DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, smul_eq_mul]
    ring
  · intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · refine ⟨by simpa using hCs, ?_⟩
      simpa using hC'
    · simpa using hpb j
  · rw [Fin.sum_univ_castSucc, ha]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]
    ring

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support →
      0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- Adding a `ℚ`-divisor `D` with a Cartier multiple `D₀ = mD` lowers a log discrepancy by
`1/m` times the coefficient of the pull-back of `D₀`. -/
private theorem isLogDiscrepancy_add_of_zsmul {n : ℕ} {B : RDivisor X} {F : DivisorOver k sX}
    {a : ℝ} (h : MMP.Intersection.IsLogDiscrepancy sX n B F a) {D : QDivisor X} {m : ℕ}
    (hm : 0 < m) {D₀ : Divisor X} (hD₀ : Divisor.toQDivisor D₀ = (m : ℤ) • D)
    (hD₀c : D₀.IsCartier) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (D₀' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ D₀.supp), D₀.IsPullback F.f hCs D₀' →
      MMP.Intersection.IsLogDiscrepancy sX n (B + QDivisor.toRDivisor D) F
        (a - (D₀'.coeff F.E : ℝ) / m) := by
  intro D₀' hCs hpb
  have h1 := isLogDiscrepancy_add_smul h hD₀c (1 / (m : ℝ)) D₀' hCs hpb
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have e : B + (1 / (m : ℝ)) • Divisor.toRDivisor D₀ = B + QDivisor.toRDivisor D := by
    congr 1
    refine Finsupp.ext fun Γ => ?_
    have h2 := congrArg (fun G : QDivisor X => G.coeff Γ) hD₀
    simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
      Int.cast_natCast] at h2
    have h3 : ((D₀.coeff Γ : ℤ) : ℝ) = m * ((D.coeff Γ : ℚ) : ℝ) := by exact_mod_cast h2
    change DivisorWithCoeffs.coeff ((1 / (m : ℝ)) • Divisor.toRDivisor D₀) Γ =
      DivisorWithCoeffs.coeff (QDivisor.toRDivisor D) Γ
    rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toRDivisor, QDivisor.coeff_toRDivisor,
      smul_eq_mul, h3]
    field_simp
  rw [e] at h1
  convert h1 using 1
  ring

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{u}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  change IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{u}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    simp only [hPJ, ↓reduceIte]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    simp only [hPJ, ↓reduceIte]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every set closed under specialization containing no
stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : ∀ x ∈ T, closure {x} ⊆ T)
    (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  have : MMP.Mori.IsVariety k sX := hX.1
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K (Divisor.toQDivisor Δ) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hK F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  have : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  have : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT x hxT

/-- **Zero places see no `D`.** If `a(F, X, Δ) = 0` for the reduced snc `Δ` and `D` contains no
stratum of `Δ`, then `a(F, X, Δ + D) = 0`. -/
private theorem eq_zero_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {D : QDivisor X} (hns : ContainsNoStratum Δ D.supp) {n : ℕ}
    {F : DivisorOver k sX} {a : ℝ}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0)
    (ha : MMP.Intersection.IsLogDiscrepancy sX n
      (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) F a) : a = 0 := by
  have hx := notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ (fun x hx =>
    (DivisorWithCoeffs.supp D).isClosed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hx))
    hns h0
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isIntegral
  have := F.isBirationalMorphism.isDominant
  have : CompactSpace F.Y := (F.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f D₀
  obtain ⟨D₀', hD₀'⟩ := hD₀c.exists_isPullback hB
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀
  have hz := coeff_isPullback_eq_zero hD₀c (by rw [hsupp]; exact hx) D₀' hB hD₀'
  have h1 := isLogDiscrepancy_add_of_zsmul h0 hm hD₀ hD₀c D₀' hB hD₀'
  rw [hz] at h1
  have h2 : (0 : ℝ) - ((0 : ℤ) : ℝ) / m = 0 := by simp
  rw [h2] at h1
  exact MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h1

end Toolkit

/-- The preimage of a nonempty open under a dominant morphism is nonempty. -/
private theorem preimage_eq_bot_iff {X Y : Scheme.{u}} (μ : Y ⟶ X) [IsDominant μ] (U : X.Opens) :
    μ ⁻¹ᵁ U = ⊥ ↔ U = ⊥ := by
  refine ⟨fun h => by_contra fun hU => ?_, fun h => by simp [h]⟩
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).1 hU
  obtain ⟨_, hx', ⟨x', rfl⟩⟩ := μ.denseRange.inter_open_nonempty U U.isOpen ⟨x, hx⟩
  have hmem : x' ∈ μ ⁻¹ᵁ U := hx'
  rw [h] at hmem
  exact hmem

section OfPrimeDivisor

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- The log discrepancy of a prime divisor `Q` of the smooth `X` is `1 - coeff_Q B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (Q : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor k hX Q) (1 - B.coeff Q) := by
  have : MMP.Mori.IsVariety k sX := hX.1
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK
    (DivisorOver.ofPrimeDivisor k hX Q)
  have hcQ := MMP.Mori.IsDiscrepancy.eq_neg_coeff_of_ofPrimeDivisor hX hc
  have h := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc
    (show IsProper (𝟙 X) from inferInstance)
  rw [hcQ] at h
  convert h using 1
  push_cast
  ring

end OfPrimeDivisor

/-! ### Restriction of a principal divisor to a smooth prime divisor -/

section Restriction

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] [Smooth sX]

include sX in
/-- **The restriction of a Cartier divisor has the restricted local equation.** Let `S` be a
smooth prime divisor of the smooth `X`, not a component of the Cartier divisor `M`, and `a` a
unit of `𝒪_{X,η_S}` representing a local equation `φ` of `M` on `V`. At every prime divisor `Q`
of `S` with `η_Q ∈ V`, the coefficient of `Q` in `M|_S` is the order of `a|_S`. -/
private theorem coeff_restrictPrimeDivisor_eq_ord (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (a : X.presheaf.stalk (haveI := S.integral;
      S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme))) (ha : IsUnit a)
    (Z : irreducibleComponents X)
    (haφ : algebraMap _ X.functionField a =
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X))
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord ((S.idealSheaf.subschemeι.stalkMap
        (genericPoint S.idealSheaf.subscheme)).hom a) Q.genericPoint := by
  have := S.integral
  classical
  have hordE : ∀ E : MMP.Mori.PrimeDivisor X,
      X.ord (algebraMap _ X.functionField a) E.genericPoint = E.ord φ := by
    intro E
    rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, haφ]
    rw [Subsingleton.elim
      (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := X)) Z E.component]
  set s := M.support ∪ (principalDivisor φ).support with hs
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor M S hM Q,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX
      S.idealSheaf.subschemeι a ha Q s
      (fun E hE => by
        rw [hordE] at hE
        refine Finset.mem_union_right _ (Finsupp.mem_support_iff.mpr ?_)
        rw [← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor]
        exact hE)]
  rw [Finsupp.sum, Finset.sum_subset (Finset.subset_union_left (s₂ := (principalDivisor φ).support))
    (fun E _ hE => by rw [Finsupp.notMem_support_iff.mp hE, smul_zero])]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [hordE, nsmul_eq_mul]
  by_cases hmem : S.idealSheaf.subschemeι Q.genericPoint ∈ E.support
  · rw [← DivisorWithCoeffs.coeff_apply, hφ E ⟨_, hmem, hQ⟩]
  · rw [MMP.Mori.PrimeDivisor.intersectionLength_eq_zero_of_notMem _ E hmem]
    simp

include sX in
/-- `coeff_restrictPrimeDivisor_eq_ord` for a unit at the image of any point `t = η_S` of `S`,
representing the local equation through the component of `X` containing it. -/
private theorem coeff_restrictPrimeDivisor_eq_ord_of_eq (S : MMP.Mori.PrimeDivisor X)
    [Smooth ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)]
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [NoetherianSpace X] (M : Divisor X) (hM : M.coeff S = 0) {V : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : M.IsLocalEquation V φ)
    (t : haveI := S.integral; S.idealSheaf.subscheme)
    (ht : haveI := S.integral; t = genericPoint S.idealSheaf.subscheme)
    (a : (X.presheaf.stalk (haveI := S.integral; S.idealSheaf.subschemeι t))ˣ)
    {W : irreducibleComponents X} (hW : (haveI := S.integral; S.idealSheaf.subschemeι t) ∈ W.1)
    (ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) W)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme))
    (hQ : (haveI := S.integral; S.idealSheaf.subschemeι Q.genericPoint) ∈ V) :
    haveI := S.integral
    (M.restrictPrimeDivisor S).coeff Q =
      S.idealSheaf.subscheme.ord (algebraMap (S.idealSheaf.subscheme.presheaf.stalk t)
        S.idealSheaf.subscheme.functionField
        ((S.idealSheaf.subschemeι.stalkMap t).hom a)) Q.genericPoint := by
  have := S.integral
  subst ht
  rw [coeff_restrictPrimeDivisor_eq_ord sX S M hM hφ a.val a.isUnit W ?_ Q hQ]
  · congr 1
    change _ = (S.idealSheaf.subscheme.presheaf.stalkSpecializes (specializes_refl _)).hom _
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    rfl
  · change _ = (X.presheaf.stalkSpecializes _).hom ((φ : RationalFunctions X) W)
    rw [← ha]
    change _ = (stalkToRationalFunctions X hW ≫ X.presheaf.stalkSpecializes _).hom a.val
    rw [stalkToRationalFunctions, TopCat.Presheaf.stalkSpecializes_comp]
    rfl

end Restriction

section Construction

variable {k : Type u} [Field k]

/-! ### Rational functions and their divisors -/

section RationalFunctions

variable {X : Scheme.{u}} [IsIntegral X]

private theorem germ_eq_rationalFunctionsEquivFunctionField_symm (U : X.Opens) (s : Γ(X, U))
    (h : genericPoint X ∈ U) (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ U) :
    (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s) Z =
      X.presheaf.germ U (componentGenericPoint X Z) hZ s := by
  have : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hd : Dense (U : Set X) := U.isOpen.dense ⟨_, h⟩
  let D : Stacks.Chow.DenseOpen X := ⟨U, hd⟩
  have key : (rationalFunctionsEquivFunctionField X).symm (X.presheaf.germ U (genericPoint X) h s)
      = (Stacks.Chow.rationalFunctionsEquivStalks X).1 (Stacks.Chow.ofSection X D s) := by
    rw [RingEquiv.symm_apply_eq, ← (Stacks.Chow.rationalFunctionsEquivFunctionField X).2 D s h]
    change _ = (Stacks.Chow.rationalFunctionsEquivFunctionField X).1
      ((Stacks.Chow.rationalFunctionsEquivStalks X).1.symm _)
    rw [RingEquiv.symm_apply_apply]
  rw [key]
  exact (Stacks.Chow.rationalFunctionsEquivStalks X).2 D s Z hZ

variable [IsLocallyNoetherian X] [IsNormal X]

end RationalFunctions

/-- An element of the local ring at `y` has nonnegative order along every prime divisor
through `y`. -/
private theorem ord_algebraMap_nonneg {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support) (a : Y.presheaf.stalk y)
    (ha : algebraMap (Y.presheaf.stalk y) Y.functionField a ≠ 0) :
    0 ≤ Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField a) P.genericPoint := by
  have hsp : P.genericPoint ⤳ y := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hP
    exact specializes_iff_mem_closure.mpr hP
  rw [← MMP.Mori.algebraMap_stalkSpecializes hsp] at ha ⊢
  set b := (Y.presheaf.stalkSpecializes hsp).hom a
  have hx := P.coheight_genericPoint
  rw [Scheme.le_ord_iff hx ha]
  have : Ring.KrullDimLE 1 (Y.presheaf.stalk P.genericPoint) := krullDimLE_of_coheight_le hx.le
  have hb0 : b ≠ 0 := by rintro hb; simp [hb] at ha
  change _ ≤ Ring.ordFrac (Y.presheaf.stalk P.genericPoint) _
  rw [Ring.ordFrac_eq_ord _ hb0]
  have hnz : b ∈ nonZeroDivisors (Y.presheaf.stalk P.genericPoint) :=
    mem_nonZeroDivisors_of_ne_zero hb0
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp (Ring.ord_ne_top hnz)
  simp only [Ring.ordMonoidWithZeroHom, MonoidWithZeroHom.coe_mk, ZeroHom.coe_mk, hnz, ↓reduceIte,
    ← hn]
  simp only [ENat.recTopCoe_natCast]
  exact WithZero.coe_le_coe.mpr (Multiplicative.ofAdd_le.mpr (by exact_mod_cast Nat.zero_le n))

/-- A unit of the local ring at `y` has order zero along every prime divisor through `y`. -/
private theorem ord_algebraMap_eq_zero_of_isUnit {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] {y : Y} (P : MMP.Mori.PrimeDivisor Y) (hP : y ∈ P.support)
    {v : Y.presheaf.stalk y} (hv : IsUnit v) :
    Y.ord (algebraMap (Y.presheaf.stalk y) Y.functionField v) P.genericPoint = 0 := by
  obtain ⟨w, rfl⟩ := hv
  have h1 : algebraMap (Y.presheaf.stalk y) Y.functionField (w : Y.presheaf.stalk y) ≠ 0 :=
    (w.isUnit.map _).ne_zero
  have h2 : algebraMap (Y.presheaf.stalk y) Y.functionField ((w⁻¹ : (Y.presheaf.stalk y)ˣ) :
      Y.presheaf.stalk y) ≠ 0 := (w⁻¹.isUnit.map _).ne_zero
  have h3 := Scheme.ord_mul (x := P.genericPoint) h1 h2
  rw [← map_mul, Units.mul_inv, map_one, Scheme.ord_one] at h3
  have := ord_algebraMap_nonneg P hP _ h1
  have := ord_algebraMap_nonneg P hP _ h2
  omega

section GlobalGeneration

variable {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

omit [IsIntegral X] in
/-- `𝒪_X(nL) ≅ 𝒪_X(L)^{⊗ n}` for a Cartier divisor `L` and `n ≥ 1`. -/
private theorem nonempty_divisorialSheaf_nsmul_iso {L : Divisor X} (hL : L.IsCartier) (n : ℕ)
    (hn : 1 ≤ n) :
    haveI := hL.isInvertibleModule_divisorialSheaf
    Nonempty ((n • L).divisorialSheaf ≅
      Stacks.Ample.tensorPowModule X L.divisorialSheaf (n : ℤ)) := by
  have := hL.isInvertibleModule_divisorialSheaf
  induction n, hn using Nat.le_induction with
  | base =>
    exact ⟨eqToIso (congrArg Divisor.divisorialSheaf (one_nsmul L)) ≪≫
      (Stacks.Ample.tensorPowModuleOneIso X _).symm⟩
  | succ n hn ih =>
    obtain ⟨e⟩ := ih
    refine ⟨eqToIso (congrArg Divisor.divisorialSheaf (succ_nsmul L n)) ≪≫
      ((hL.nsmul n).divisorialSheafTensorIso hL).symm ≪≫ ?_ ≪≫
      Stacks.Ample.tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by push_cast; rfl)⟩
    exact ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso e).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso X _).symm

end GlobalGeneration

/-- The divisor `div g` of a nonzero rational function `g`. -/
private abbrev ffDiv {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (g : X.functionField) (hg : g ≠ 0) : Divisor X :=
  MMP.Mori.principalDivisor
    (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g hg))

/-- A section of `𝒪_X(M)` has effective divisor `M + div g`. -/
private theorem coeff_add_ffDiv_nonneg {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [CompactSpace X] {M : Divisor X} {g : X.functionField} (hg : g ∈ sectionsIn M)
    (hg0 : g ≠ 0) (P : MMP.Mori.PrimeDivisor X) : 0 ≤ (M + ffDiv g hg0).coeff P := by
  have h := hg P
  rw [P.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h
  rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
  omega

end Construction

end

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}}
  (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  {Z : Scheme.{u}} (f : X ⟶ Z)

/-! ### Restriction to `S` of sections and of divisors -/

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- The coefficients of a restriction as a sum over any finite set containing the support. -/
private theorem coeff_restrictPrimeDivisor_eq_sum [NoetherianSpace X] {R : Type*} [AddCommMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0)
    (s : Finset (MMP.Mori.PrimeDivisor X)) (hs : D.support ⊆ s)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    (D.restrictPrimeDivisor S).coeff Q =
      ∑ E ∈ s, E.intersectionLength (haveI := S.integral; S.idealSheaf.subschemeι) Q •
        D.coeff E := by
  rw [DivisorWithCoeffs.coeff_restrictPrimeDivisor D S hD Q]
  exact Finsupp.sum_of_support_subset D hs _ (fun E _ => smul_zero _)

omit [IsAlgClosed k] [CharZero k] [IsNormal X] [CompactSpace X] in
/-- A function with a nonzero restriction to `S` is a unit at the generic point of `S`. -/
private theorem ne_zero_and_ord_eq_zero_of_isRestrictionAlong (S : MMP.Mori.PrimeDivisor X)
    {g : X.functionField} {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hh0 : h ≠ 0) :
    g ≠ 0 ∧ X.ord g S.genericPoint = 0 := by
  have := S.integral
  obtain ⟨a, ha, hb⟩ := hgh
  have hu : IsUnit a := isUnit_of_map_unit
    (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a (by
      rw [hb]; exact isUnit_iff_ne_zero.mpr hh0)
  have ha' : algebraMap _ X.functionField a = g := ha
  have hSmem : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) ∈ S.support := by
    change S.genericPoint ∈ S.support
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  refine ⟨ha' ▸ (hu.map _).ne_zero, ?_⟩
  rw [← ha']
  exact ord_algebraMap_eq_zero_of_isUnit S hSmem hu

omit [IsAlgClosed k] [CharZero k] in
/-- **The restriction of a principal divisor is principal**: `(M + div g)|_S = M|_S + div(g|_S)`
for `S` a component of neither. -/
private theorem restrictPrimeDivisor_add_ffDiv [NoetherianSpace X] (hsm : IsSmoothScheme sX)
    (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    [CompactSpace (haveI := S.integral; S.idealSheaf.subscheme)]
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    (M : Divisor X) (hM : M.coeff S = 0) {g : X.functionField}
    {h : haveI := S.integral; S.idealSheaf.subscheme.functionField}
    (hgh : IsRestrictionAlong S g h) (hg0 : g ≠ 0) (hh0 : h ≠ 0) :
    haveI := S.integral
    (M + ffDiv g hg0).restrictPrimeDivisor S = M.restrictPrimeDivisor S + ffDiv h hh0 := by
  have := S.integral
  classical
  have : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  have : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  obtain ⟨a, ha, hb⟩ := hgh
  have hu : IsUnit a := isUnit_of_map_unit
    (S.idealSheaf.subschemeι.stalkMap (genericPoint S.idealSheaf.subscheme)).hom a (by
      rw [hb]; exact isUnit_iff_ne_zero.mpr hh0)
  have ha' : algebraMap _ X.functionField a = g := ha
  have hordS := (ne_zero_and_ord_eq_zero_of_isRestrictionAlong S ⟨a, ha, hb⟩ hh0).2
  have hgS : (ffDiv g hg0).coeff S = 0 := by rw [MMP.Mori.coeff_principalDivisor_mk0, hordS]
  have hMg : (M + ffDiv g hg0).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hM, hgS, add_zero]
  set s := M.support ∪ (ffDiv g hg0).support with hs
  refine Finsupp.ext fun Q => ?_
  rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply,
    DivisorWithCoeffs.coeff_add,
    coeff_restrictPrimeDivisor_eq_sum S hMg s Finsupp.support_add Q,
    coeff_restrictPrimeDivisor_eq_sum S hM s Finset.subset_union_left Q,
    MMP.Mori.coeff_principalDivisor_mk0 h hh0 Q, ← hb,
    MMP.Mori.PrimeDivisor.ord_restrict_eq_sum_intersectionLength_mul_ord sX
      S.idealSheaf.subschemeι a hu Q s
      (fun E hE => by
      rw [ha'] at hE
      refine Finset.mem_union_right _ (Finsupp.mem_support_iff.2 ?_)
      rw [← DivisorWithCoeffs.coeff_apply, MMP.Mori.coeff_principalDivisor_mk0]
      exact hE), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun E _ => ?_
  rw [DivisorWithCoeffs.coeff_add, smul_add, ha', MMP.Mori.coeff_principalDivisor_mk0, nsmul_eq_mul,
    nsmul_eq_mul]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- Restriction to `S` commutes with scalar multiplication. -/
private theorem restrictPrimeDivisor_smul [NoetherianSpace X] {A R : Type*} [Semiring A]
    [AddCommGroup R] [Module A R] (S : MMP.Mori.PrimeDivisor X)
    {D : DivisorWithCoeffs R X} (hD : D.coeff S = 0) (r : A) :
    (r • D).restrictPrimeDivisor S = r • D.restrictPrimeDivisor S := by
  classical
  ext Q
  rw [DivisorWithCoeffs.coeff_smul,
    coeff_restrictPrimeDivisor_eq_sum S (by rw [DivisorWithCoeffs.coeff_smul, hD, smul_zero])
      D.support Finsupp.support_smul Q,
    coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q, Finset.smul_sum]
  exact Finset.sum_congr rfl fun E _ => by rw [DivisorWithCoeffs.coeff_smul, smul_comm]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- The restriction of an effective divisor is effective. -/
private theorem coeff_restrictPrimeDivisor_nonneg [NoetherianSpace X] {R : Type*}
    [AddCommMonoid R] [PartialOrder R] [IsOrderedAddMonoid R]
    (S : MMP.Mori.PrimeDivisor X) {D : DivisorWithCoeffs R X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hD : D.coeff S = 0)
    (Q : MMP.Mori.PrimeDivisor (haveI := S.integral; S.idealSheaf.subscheme)) :
    0 ≤ (D.restrictPrimeDivisor S).coeff Q := by
  rw [coeff_restrictPrimeDivisor_eq_sum S hD D.support subset_rfl Q]
  exact Finset.sum_nonneg fun E _ => nsmul_nonneg (hD0 E) _

omit [IsIntegral X] in
/-- Relative ampleness is invariant under linear equivalence. -/
private theorem isRelativelyAmple_add_principalDivisor {L : Divisor X} (hLc : L.IsCartier)
    (hL : L.IsRelativelyAmple f hLc) (u : (MMP.Mori.RationalFunctions X)ˣ) :
    (L + MMP.Mori.principalDivisor u).IsRelativelyAmple f
      (hLc.add (Divisor.isCartier_principalDivisor u)) := by
  have := hLc.isInvertibleModule_divisorialSheaf
  have := (hLc.add (Divisor.isCartier_principalDivisor u)).isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, hamp⟩ := hL y
  refine ⟨V, hV, hyV, ?_⟩
  have e : (L + MMP.Mori.principalDivisor u).divisorialSheaf ≅ L.divisorialSheaf :=
    Divisor.divisorialSheafMulIso u fun E => by
      rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor]
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((RingedSpaceModuleAdjunction.modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e)).mpr
    hamp

/-! ### Strict transforms of prime divisors -/

section StrictTransform

variable {X Y : Scheme.{u}}

/-- **The strict transform of a prime divisor.** For a proper birational morphism `μ : Y ⟶ X`
onto a normal scheme, every prime divisor `Q` of `X` has a prime divisor `E` of `Y` over it with
`μ(η_E) = η_Q` and `μ^♯ : 𝒪_{X,Q} ≅ 𝒪_{Y,E}`. -/
private theorem exists_primeDivisor_isIso_stalkMap [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] (μ : Y ⟶ X) [IsProper μ]
    (hμ : IsBirationalMorphism μ) (Q : MMP.Mori.PrimeDivisor X) :
    ∃ E : MMP.Mori.PrimeDivisor Y,
      μ E.genericPoint = Q.genericPoint ∧ IsIso (μ.stalkMap E.genericPoint) := by
  have := Q.isDiscreteValuationRing_localRing
  have := hμ.isDominant
  obtain ⟨x, hx, hiso⟩ :=
    MMP.Intersection.exists_isIso_stalkMap_of_valuationRing μ hμ.functionFieldMap_bijective
      Q.genericPoint
  have hco : Order.coheight x = 1 := by
    have h := ringKrullDim_eq_of_ringEquiv (asIso (μ.stalkMap x)).commRingCatIsoToRingEquiv
    rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight, hx,
      Q.coheight_genericPoint] at h
    exact_mod_cast h.symm
  let E : MMP.Mori.PrimeDivisor Y := AlgebraicGeometry.PrimeDivisor.ofCoheightOne x hco
  have hE : E.genericPoint = x := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne x hco
  exact ⟨E, hE ▸ hx, hE ▸ hiso⟩

/-- At a strict transform, `v_E` seen on `k(X)` through `μ` is `v_Q`. -/
private theorem valuationOver_eq_of_isIso [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ]
    (E : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : μ E.genericPoint = Q.genericPoint) [IsIso (μ.stalkMap E.genericPoint)] :
    E.valuationOver μ = Q.divisorialValuation := by
  refine Valuation.ext fun t => ?_
  rw [PrimeDivisor.valuationOver_apply]
  by_cases ht : t = 0
  · rw [ht, map_zero, map_zero, map_zero]
  rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr ht),
    PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ht,
    MMP.Positivity.ord_functionFieldMap_of_isIso μ E Q heq t]

/-- At a strict transform `E` of `Q`, the coefficient of `E` in the pull-back of a Cartier
divisor `M` is the coefficient of `Q` in `M`. -/
private theorem coeff_isPullback_eq_of_valuationOver_eq [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X} [IsDominant μ]
    {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) (E : MMP.Mori.PrimeDivisor Y)
    (Q : MMP.Mori.PrimeDivisor X) (heq : μ E.genericPoint = Q.genericPoint)
    (hv : E.valuationOver μ = Q.divisorialValuation) : Mμ.coeff E = M.coeff Q := by
  obtain ⟨U, hU, φ, hφ⟩ := hMc Q.genericPoint
  have hE := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ E (heq ▸ hU) Q.component
  have hQ : M.coeff Q = Q.ord φ := hφ Q ((Q.genericPoint_mem_iff U).mp hU)
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord] at hQ
  set c := MMP.Threefold.Mori.Helpers.evalFF Q.component (φ : RationalFunctions X)
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have h1 := congrArg (fun v : Valuation X.functionField (WithZero (Multiplicative ℤ)) => v c) hv
  simp only [PrimeDivisor.valuationOver_apply] at h1
  rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ ((map_ne_zero _).mpr hc0),
    PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hc0] at h1
  rw [hE, hQ]
  simpa using h1

/-- At a strict transform `E` of `Q`, the coefficient of `E` in the pull-back of a `ℚ`-Cartier
`ℚ`-divisor `B` is the coefficient of `Q` in `B`. -/
private theorem coeff_isPullback_qDivisor_eq [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (E : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : μ E.genericPoint = Q.genericPoint) [IsIso (μ.stalkMap E.genericPoint)]
    {B : QDivisor X} (hBq : B.IsQCartier)
    {hB : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ B.supp}
    {B' : QDivisor Y} (hB' : B.IsPullback μ hB B') : B' E = B Q := by
  have hm := QDivisor.cartierIndex_pos hBq
  obtain ⟨D₀, hD₀, hD₀c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hBq
  obtain ⟨D', hD', hp⟩ := hB' _ hm D₀ hD₀ hD₀c
  have hc := MMP.Positivity.coeff_eq_of_isPullback E Q heq hD₀c hp
  have h1 := congrArg (fun G : QDivisor Y => G E) hD'
  have h2 := congrArg (fun G : QDivisor X => G Q) hD₀
  simp only [Finsupp.smul_apply, zsmul_eq_mul, Int.cast_natCast] at h1 h2
  refine mul_left_cancel₀ (by exact_mod_cast hm.ne') (h1.symm.trans (Eq.trans ?_ h2))
  exact congrArg (fun z : ℤ => (z : ℚ)) hc

end StrictTransform

/-! ### Twisting push-forwards by a Cartier divisor -/

section Twist

variable {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- **The projection formula on sections.** If `φ` is a local equation of the Cartier divisor
`M` on `V` and `μ^*M` its pull-back, then over an open `U ⊆ V` a rational function `g` is a
section of `μ_*𝒪_Y(G + μ^*M)` exactly when `φ g` is a section of `μ_*𝒪_Y(G)`. -/
private theorem mem_multiplierIdealSections_add_iff {μ : Y ⟶ X} [IsDominant μ] {M : Divisor X}
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) {V : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : M.IsLocalEquation V φ) (Z : irreducibleComponents X) (G : Divisor Y) {U : X.Opens}
    (hUV : U ≤ V) (g : X.functionField) :
    g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) U ↔
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) * g ∈
        MMP.Intersection.multiplierIdealSections μ G U := by
  set c := MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) with hc
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hval : ∀ P : MMP.Mori.PrimeDivisor Y, (P.support ∩ μ ⁻¹ᵁ U).Nonempty →
      P.valuationOver μ c = WithZero.exp (-Mμ.coeff P) := by
    intro P hP
    have hU : μ P.genericPoint ∈ V :=
      hUV (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP)
    rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hU Z,
      PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr hc0)]
  constructor
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => by rw [h0 hU, mul_zero], fun P hP => ?_⟩
    rw [map_mul, hval P hP]
    have := hg P hP
    rw [DivisorWithCoeffs.coeff_add] at this
    calc WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g ≤
          WithZero.exp (-Mμ.coeff P) * WithZero.exp (G.coeff P + Mμ.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P) := by rw [← WithZero.exp_add]; congr 1; ring
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => (mul_eq_zero.mp (h0 hU)).resolve_left hc0, fun P hP => ?_⟩
    have := hg P hP
    rw [map_mul, hval P hP] at this
    rw [DivisorWithCoeffs.coeff_add]
    calc P.valuationOver μ g = WithZero.exp (Mμ.coeff P) *
          (WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g) := by
          rw [← mul_assoc, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero, one_mul]
      _ ≤ WithZero.exp (Mμ.coeff P) * WithZero.exp (G.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P + Mμ.coeff P) := by rw [← WithZero.exp_add, add_comm]

omit [IsLocallyNoetherian X] [IsNormal X] in
/-- Sections of `μ_*𝒪_Y(G)` restrict to smaller nonempty opens. -/
private theorem multiplierIdealSections_mono (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) {g : X.functionField}
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ G U) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G W :=
  ⟨fun h => absurd ((preimage_eq_bot_iff μ W).1 h) hW,
    fun P hP => hg.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hWU hy))⟩

omit [IsLocallyNoetherian X] [IsNormal X] in
/-- Membership in `μ_*𝒪_Y(G)(U)` is local on `U`: it suffices on a neighbourhood `W x ⊆ U` of
every point `x ∈ U`. -/
private theorem mem_multiplierIdealSections_of_local (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U : X.Opens} (W : X → X.Opens) (hW : ∀ x ∈ U, x ∈ W x ∧ W x ≤ U) {g : X.functionField}
    (h0 : U = ⊥ → g = 0)
    (hg : ∀ x ∈ U, g ∈ MMP.Intersection.multiplierIdealSections μ G (W x)) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  refine ⟨fun h => h0 ((preimage_eq_bot_iff μ U).1 h), fun P hP => ?_⟩
  have hx := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
  refine (hg _ hx).2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P ?_)
  exact (hW _ hx).1

/-- **Twisting is determined by the untwisted push-forward.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections, so do `μ_*𝒪_Y(G + μ^*M)` and
`μ'_*𝒪_{Y'}(G' + μ'^*M)`, for a Cartier divisor `M` of `X`. -/
private theorem multiplierIdealSections_add_pullback_congr {Y' : Scheme.{u}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {μ : Y ⟶ X} {μ' : Y' ⟶ X} [IsDominant μ]
    [IsDominant μ'] {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {hM' : ∀ Z : irreducibleComponents Y', μ' (componentGenericPoint Y' Z) ∉ M.supp}
    {Mμ : Divisor Y} {Mμ' : Divisor Y'} (h : M.IsPullback μ hM Mμ)
    (h' : M.IsPullback μ' hM' Mμ') {G : Divisor Y} {G' : Divisor Y'}
    (hG : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ' (G' + Mμ') := by
  choose V hxV φ hφ using hMc
  let Z : irreducibleComponents X := pointComponent (genericPoint X)
  have key : ∀ {Y₁ : Scheme.{u}} [IsIntegral Y₁] [IsLocallyNoetherian Y₁] [IsNormal Y₁]
      (μ₁ : Y₁ ⟶ X) [IsDominant μ₁]
      {hM₁ : ∀ Z : irreducibleComponents Y₁, μ₁ (componentGenericPoint Y₁ Z) ∉ M.supp}
      {M₁ : Divisor Y₁} (h₁ : M.IsPullback μ₁ hM₁ M₁) (G₁ : Divisor Y₁) (U : X.Opens)
      (g : X.functionField),
      g ∈ MMP.Intersection.multiplierIdealSections μ₁ (G₁ + M₁) U ↔
        (U = ⊥ → g = 0) ∧ ∀ x ∈ U,
          MMP.Threefold.Mori.Helpers.evalFF Z (φ x : RationalFunctions X) * g ∈
            MMP.Intersection.multiplierIdealSections μ₁ G₁ (U ⊓ V x) := by
    intro Y₁ _ _ _ μ₁ _ hM₁ M₁ h₁ G₁ U g
    have hne : ∀ x ∈ U, U ⊓ V x ≠ ⊥ := fun x hx hb => by
      have : x ∈ U ⊓ V x := ⟨hx, hxV x⟩
      rw [hb] at this; exact this
    constructor
    · intro hg
      refine ⟨fun hU => hg.1 ((preimage_eq_bot_iff μ₁ U).2 hU), fun x hx => ?_⟩
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).1
        (multiplierIdealSections_mono μ₁ _ inf_le_left (hne x hx) hg)
    · rintro ⟨h0, hg⟩
      refine mem_multiplierIdealSections_of_local μ₁ _ (fun x => U ⊓ V x)
        (fun x hx => ⟨⟨hx, hxV x⟩, inf_le_left⟩) h0 fun x hx => ?_
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).2 (hg x hx)
  funext U
  ext g
  rw [key μ h G U g, key μ' h' G' U g, hG]

end Twist

/-! ### Pull-backs along morphisms which are not dominant -/

section PullbackStalk

variable {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

omit [IsIntegral X] in
/-- **The coefficient of a pull-back along any morphism.** If `φ` is a local equation of `C` on
`U ∋ f(η_E)`, the coefficient of `E` in `f^*C` is the order along `E` of the image under `f^♯` of
the unit `a` of `𝒪_{X, f(η_Y)}` representing `φ`. -/
private theorem coeff_isPullback_eq_ord_stalkMap {f : Y ⟶ X} {C : Divisor X}
    {hC : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ C.supp}
    {C' : Divisor Y} (h : C.IsPullback f hC C') {U : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : C.IsLocalEquation U φ) (E : MMP.Mori.PrimeDivisor Y)
    (hU : f E.genericPoint ∈ U) {W : irreducibleComponents X}
    (hW : f (componentGenericPoint Y E.component) ∈ W.1)
    (a : (X.presheaf.stalk (f (componentGenericPoint Y E.component)))ˣ)
    (ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) W) :
    C'.coeff E = Y.ord ((Y.presheaf.stalkSpecializes
      ((genericPoint_spec Y).specializes trivial :
        genericPoint Y ⤳ componentGenericPoint Y E.component)).hom
      ((f.stalkMap (componentGenericPoint Y E.component)).hom a)) E.genericPoint := by
  classical
  have hE : (E.support ∩ f ⁻¹ᵁ U).Nonempty := (E.genericPoint_mem_iff (f ⁻¹ᵁ U)).mp hU
  rw [h U φ hφ E hE]
  have hZp := E.map_componentGenericPoint_mem f hE
  rw [pullbackComponent_eq hC hφ hZp hW a ha]
  set u := Units.map (f.stalkMap (componentGenericPoint Y E.component)).hom.toMonoidHom a
    with hu
  let ψ : (RationalFunctions Y)ˣ :=
    (RationalFunctions.unitsEquiv Y).symm (Function.update 1 E.component u)
  have hψZ : (ψ : RationalFunctions Y) E.component = u := by
    simp [ψ, RationalFunctions.unitsEquiv]
  have h1 : E.ordUnit u = E.ord ψ := by
    rw [PrimeDivisor.ord_eq_ordUnit]
    congr 1
    exact (Units.ext hψZ).symm
  rw [h1, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
  congr 1
  change (Y.presheaf.stalkSpecializes _).hom ((ψ : RationalFunctions Y) E.component) = _
  rw [hψZ]
  rfl

end PullbackStalk

/-! ### The adjoint discrepancy divisor at a strict transform -/

section Adjoint

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- **The adjoint discrepancy divisor vanishes at strict transforms.** If `Δ` is reduced and
`E` is the divisor with `K_Y + Γ = μ^*(K_X + Δ) + E`, then `coeff_P E = 0` for a prime divisor
`P` of `Y` inducing the valuation of a prime divisor `Q` of `X`: `a(P, X, Δ) = 1 - coeff_Q Δ`,
and `P` is a zero place exactly when `Q ≤ Δ`. -/
private theorem coeff_eq_zero_of_valuationOver_eq [IsAlgClosed k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ : Divisor X} (hΔ : MMP.Intersection.IsReducedEffective Δ)
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    [IsDominant μ] (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    {Γ E : Divisor Y} (hΓ : IsZeroLogDiscrepancyDivisor sX μ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) (P : MMP.Mori.PrimeDivisor Y)
    (Q : MMP.Mori.PrimeDivisor X) (hv : P.valuationOver μ = Q.divisorialValuation) :
    E.coeff P = 0 := by
  obtain ⟨n, a, ha, hEa⟩ := hE P
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha
  have hQ := isLogDiscrepancy_ofPrimeDivisor sX hX hsm hn (Divisor.toQDivisor Δ) Q
  rw [QDivisor.toRDivisor_toQDivisor] at hQ
  have hval : (⟨Y, μ, hY, hμ, P⟩ : DivisorOver k sX).valuation =
      (DivisorOver.ofPrimeDivisor k hX Q).valuation := by
    refine hv.trans ?_
    refine Valuation.ext fun g => ?_
    change _ = Q.divisorialValuation (functionFieldMap (𝟙 X) g)
    rw [MMP.Mori.functionFieldMap_id_apply]
  have haQ := MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha hQ hval
  rw [Divisor.coeff_toQDivisor] at haQ
  rcases hΔ Q with h0 | h1
  · rw [h0] at haQ
    have hΓ0 : Γ.coeff P = 0 := by
      rcases hΓ.1 P with h | h
      · exact h
      · obtain ⟨n', h'⟩ := (hΓ.2 P).mp h
        have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha h'
        norm_num at haQ
        linarith
    rw [hΓ0] at hEa
    norm_num at haQ
    rw [haQ] at hEa
    exact_mod_cast (by simpa using hEa : (E.coeff P : ℝ) = 0)
  · rw [h1] at haQ
    norm_num at haQ
    have hΓ1 : Γ.coeff P = 1 := (hΓ.2 P).mpr ⟨n, haQ ▸ ha⟩
    rw [hΓ1, haQ] at hEa
    exact_mod_cast (by simpa using hEa : (E.coeff P : ℝ) = 0)

end Adjoint

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- A point of `S` (as a scheme) of coheight zero maps outside the support of a divisor of which
`S` is not a component; in particular the generic points of a scheme dominating `S` do. -/
private theorem comp_ι_componentGenericPoint_notMem_supp (S : MMP.Mori.PrimeDivisor X)
    (M : Divisor X) (hM : M.coeff S = 0) {YS : Scheme.{u}}
    (μS : YS ⟶ (haveI := S.integral; S.idealSheaf.subscheme)) [IsIntegral YS] [IsDominant μS] :
    haveI := S.integral
    ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp := by
  have := S.integral
  intro C hmem
  rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, Scheme.Hom.comp_apply,
    map_genericPoint_of_isDominant] at hmem
  obtain ⟨E, hE, hx⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
  exact DivisorWithCoeffs.forall_notMem_support_primeDivisor M S hM E
    (Finsupp.mem_support_iff.mpr hE) _
    (Order.coheight_eq_zero.mpr fun t _ => genericPoint_specializes t) hx

/-- A valuation bounded by `γ` on a set is bounded by `γ` on its `ℤ`-span. -/
private theorem valuation_le_of_mem_span {K Γ : Type*} [Field K]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation K Γ) {S : Set K} {γ : Γ}
    (hS : ∀ s ∈ S, v s ≤ γ) {g : K} (hg : g ∈ Submodule.span ℤ S) : v g ≤ γ := by
  induction hg using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => simp
  | add x y _ _ hx hy => exact v.map_add_le hx hy
  | smul n x _ hx =>
    induction n using Int.induction_on with
    | zero => simp
    | succ k hk => rw [add_smul, one_smul]; exact v.map_add_le hk hx
    | pred k hk => rw [sub_smul, one_smul]; exact v.map_sub_le hk hx

omit [IsAlgClosed k] [CharZero k] in
/-- **Sections of the twisted ideal on `S` pulled back.** A global section of
`J ⊗ 𝒪_S(M|_S)` with `J ⊆ μS_*𝒪(GS)` is a section of `μS_*𝒪_{YS}(GS + MS)`, for `MS` the
pull-back of `M` to `YS`. -/
private theorem mem_multiplierIdealSections_of_forall (S : MMP.Mori.PrimeDivisor X)
    [IsLocallyNoetherian (haveI := S.integral; S.idealSheaf.subscheme)]
    [IsNormal (haveI := S.integral; S.idealSheaf.subscheme)]
    (hsm : IsSmoothScheme sX)
    (hSsm : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX))
    (M : Divisor X) (hMc : M.IsCartier) (hM : M.coeff S = 0) {YS : Scheme.{u}}
    (μS : YS ⟶ (haveI := S.integral; S.idealSheaf.subscheme)) [IsIntegral YS]
    [IsLocallyNoetherian YS] [IsNormal YS] [IsDominant μS] (GS : Divisor YS)
    (J : haveI := S.integral;
      S.idealSheaf.subscheme.Opens → Set S.idealSheaf.subscheme.functionField)
    (hJ : haveI := S.integral; ∀ W, J W ⊆ MMP.Intersection.multiplierIdealSections μS GS W)
    (hMS : haveI := S.integral; ∀ C : irreducibleComponents YS,
      (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS C) ∉ M.supp)
    (MS : Divisor YS) (hMSp : M.IsPullback (haveI := S.integral; μS ≫ S.idealSheaf.subschemeι)
      hMS MS)
    (h : haveI := S.integral; S.idealSheaf.subscheme.functionField)
    (hh : haveI := S.integral; ∀ x : S.idealSheaf.subscheme, ∃ W : S.idealSheaf.subscheme.Opens,
      x ∈ W ∧ h ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections
        (𝟙 S.idealSheaf.subscheme) (M.restrictPrimeDivisor S) W * J W)) :
    haveI := S.integral; h ∈ MMP.Intersection.multiplierIdealSections μS (GS + MS) ⊤ := by
  have := S.integral
  have : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  have : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSsm
  refine ⟨fun h0 => absurd ((preimage_eq_bot_iff μS ⊤).1 h0) (by simp), fun P _ => ?_⟩
  set y := μS P.genericPoint with hy
  obtain ⟨W, hyW, hhW⟩ := hh y
  -- the bound on the generators `u * j`
  have hgen : ∀ u ∈ MMP.Intersection.multiplierIdealSections (𝟙 S.idealSheaf.subscheme)
      (M.restrictPrimeDivisor S) W, P.valuationOver μS u ≤ WithZero.exp (MS.coeff P) := by
    intro u hu
    have : IsNoetherian X := {}
    obtain ⟨V, hxV, φ, hφ⟩ := hMc (S.idealSheaf.subschemeι y)
    have hc : μS (componentGenericPoint YS P.component) = genericPoint S.idealSheaf.subscheme := by
      rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    have hιη : S.idealSheaf.subschemeι (genericPoint S.idealSheaf.subscheme) = S.genericPoint :=
      rfl
    have hSV : S.genericPoint ∈ V := by
      rw [← hιη]
      exact ((genericPoint_specializes y).map S.idealSheaf.subschemeι.continuous).mem_open
        V.isOpen hxV
    obtain ⟨a, ha⟩ := exists_unit_stalk_of_forall_ord_eq_zero
      (y := (μS ≫ S.idealSheaf.subschemeι) (componentGenericPoint YS P.component))
      (W := pointComponent _) (mem_pointComponent _) φ (fun E hE => by
        rw [Scheme.Hom.comp_apply, hc, hιη] at hE
        have := E.eq_genericPoint_of_mem_support hE S.coheight_genericPoint
        have hES : S = E := AlgebraicGeometry.PrimeDivisor.genericPoint_injective this
        subst hES
        rw [← hφ S ((S.genericPoint_mem_iff V).mp hSV)]
        exact hM)
    have hB := coeff_isPullback_eq_ord_stalkMap hMSp hφ P
      (by rw [Scheme.Hom.comp_apply]; exact hxV) (mem_pointComponent _) a ha
    let a' : (X.presheaf.stalk (S.idealSheaf.subschemeι
        (μS (componentGenericPoint YS P.component))))ˣ := a
    let ψ : S.idealSheaf.subscheme.functionField :=
      algebraMap (S.idealSheaf.subscheme.presheaf.stalk (μS (componentGenericPoint YS P.component)))
        S.idealSheaf.subscheme.functionField
        ((S.idealSheaf.subschemeι.stalkMap (μS (componentGenericPoint YS P.component))).hom a')
    have hψ0 : ψ ≠ 0 :=
      ((a'.isUnit.map (S.idealSheaf.subschemeι.stalkMap _).hom).map (algebraMap _ _)).ne_zero
    have h1 : (YS.presheaf.stalkSpecializes ((genericPoint_spec YS).specializes trivial :
        genericPoint YS ⤳ componentGenericPoint YS P.component)).hom
        (((μS ≫ S.idealSheaf.subschemeι).stalkMap (componentGenericPoint YS P.component)).hom a) =
        functionFieldMap μS ψ := by
      rw [MMP.Mori.functionFieldMap_algebraMap_stalk μS (componentGenericPoint YS P.component),
        Scheme.Hom.stalkMap_comp]
      rfl
    have hψP : P.valuationOver μS ψ = WithZero.exp (-MS.coeff P) := by
      rw [PrimeDivisor.valuationOver_apply, ← h1,
        PrimeDivisor.divisorialValuation_eq_exp_neg_ord _
          (by rw [h1]; exact (map_ne_zero _).mpr hψ0), hB]
    have hψQ : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
        S.idealSheaf.subschemeι Q.genericPoint ∈ V →
        Q.divisorialValuation ψ = WithZero.exp (-(M.restrictPrimeDivisor S).coeff Q) := by
      intro Q hQ
      rw [PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hψ0,
        coeff_restrictPrimeDivisor_eq_ord_of_eq sX S M hM hφ _ hc a'
          (mem_pointComponent _) ha Q hQ]
    have hreg : u * ψ ∈
        (algebraMap (S.idealSheaf.subscheme.presheaf.stalk y)
          S.idealSheaf.subscheme.functionField).range := by
      refine Scheme.mem_range_algebraMap_stalk_of_forall_coheight_eq_one _ fun z hz hzy => ?_
      let Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme :=
        AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hz
      have hQη : Q.genericPoint = z :=
        AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hz
      have hzW : z ∈ W := hzy.mem_open W.isOpen hyW
      have hzV : S.idealSheaf.subschemeι Q.genericPoint ∈ V := by
        rw [hQη]; exact (hzy.map S.idealSheaf.subschemeι.continuous).mem_open V.isOpen hxV
      have hQ := hu.2 Q (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem Q
        (by rw [hQη]; exact hzW))
      rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply] at hQ
      rw [← hQη, ← MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff, map_mul, hψQ Q hzV]
      calc _ ≤ WithZero.exp ((M.restrictPrimeDivisor S).coeff Q) *
            WithZero.exp (-(M.restrictPrimeDivisor S).coeff Q) := by gcongr
        _ = 1 := by rw [← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
    have hle : P.valuationOver μS (u * ψ) ≤ 1 := by
      obtain ⟨r, hr⟩ := hreg
      rw [PrimeDivisor.valuationOver_apply, ← hr,
        MMP.Mori.functionFieldMap_algebraMap_stalk μS P.genericPoint r]
      exact (P.divisorialValuation_le_one_iff _).mpr ⟨_, rfl⟩
    rw [map_mul, hψP] at hle
    calc P.valuationOver μS u = P.valuationOver μS u * WithZero.exp (-MS.coeff P) *
          WithZero.exp (MS.coeff P) := by
          rw [mul_assoc, ← WithZero.exp_add, neg_add_cancel, WithZero.exp_zero, mul_one]
      _ ≤ 1 * WithZero.exp (MS.coeff P) := by gcongr
      _ = _ := one_mul _
  refine valuation_le_of_mem_span (P.valuationOver μS) ?_ hhW
  rintro _ ⟨u, hu, j, hj, rfl⟩
  have hjP := (hJ W hj).2 P ((P.genericPoint_mem_iff (μS ⁻¹ᵁ W)).mp hyW)
  rw [map_mul, DivisorWithCoeffs.coeff_add, WithZero.exp_add, mul_comm (WithZero.exp _)]
  exact mul_le_mul' (hgen u hu) hjP

omit [CharZero k] [CompactSpace X] in
/-- **Sections of `𝒥_{Δ,D_Q}(M)` are sections of `𝒪_X(M)`.** For `μ` computing `𝒥_{Δ,D_Q}` as
`μ_*𝒪_Y(E - ⌊μ^*D_Q⌋)`, a global section of `μ_*𝒪_Y(E - ⌊μ^*D_Q⌋ + μ^*M)` is a section of
`𝒪_X(M)`. -/
private theorem mem_sectionsIn_of_mem_multiplierIdealSections (Δ : Divisor X) (DQ : QDivisor X)
    {Y : Scheme.{u}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsDominant μ] (JX : X.Opens → Set X.functionField) (G : Divisor Y)
    (hJX : IsReducedAdjointIdealOn sX Δ DQ μ JX)
    (hG : JX = MMP.Intersection.multiplierIdealSections μ G)
    (M : Divisor X) (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMμp : M.IsPullback μ hMμ Mμ) (g : X.functionField)
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤) :
    g ∈ sectionsIn M := by
  obtain ⟨hXv, hsm, hΔ, hD0, -, hlog, i₁, i₂, i₃, i₄, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, hJe⟩ :=
    hJX
  have : IsProper μ := hlog.isProper
  have hMc : M.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm M
  rw [multiplierIdealSections_add_pullback_congr hMc hMμp hMμp (hG.symm.trans hJe)] at hg
  intro Q
  obtain ⟨P, heq, hiso⟩ := exists_primeDivisor_isIso_stalkMap μ hμ Q
  have hv := valuationOver_eq_of_isIso μ P Q heq
  have hP := hg.2 P ((P.genericPoint_mem_iff (μ ⁻¹ᵁ ⊤)).mp trivial)
  have hE0 := coeff_eq_zero_of_valuationOver_eq sX hXv hsm hΔ.1 hY hμ hΓ hE P Q hv
  have hMP := coeff_isPullback_eq_of_valuationOver_eq hMc hMμp P Q heq hv
  have hFP : F P = DQ Q :=
    coeff_isPullback_qDivisor_eq P Q heq (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm DQ) hF
  have hfl : 0 ≤ ⌊(QDivisor.toRDivisor F).coeff P⌋ := by
    rw [QDivisor.coeff_toRDivisor, Int.floor_nonneg]
    have h0 : (0 : ℚ) ≤ F P := hFP ▸ hD0 Q
    exact_mod_cast h0
  rw [hv, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
    MMP.Intersection.WeilRDivisor.coeff_roundDown, hE0, hMP] at hP
  exact hP.trans (WithZero.exp_le_exp.mpr (by omega))

/-! ### The reduced boundary `S`, restriction over `ℚ`, ampleness and local generators -/

section Boundary

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsLocallyNoetherian X]
  [IsIntegral X] [IsNormal X]

omit [IsLocallyNoetherian X] [IsIntegral X] [IsNormal X] in
/-- A smooth prime divisor of a smooth variety is a reduced snc divisor. -/
private theorem isReducedSNC_single [CharZero k] (hsm : IsSmoothScheme sX)
    (S : MMP.Mori.PrimeDivisor X)
    (hSs : IsSmoothScheme ((haveI := S.integral; S.idealSheaf.subschemeι) ≫ sX)) :
    IsReducedSNC sX (Finsupp.single S 1) := by
  classical
  have : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hsm
  refine ⟨fun P => ?_, fun E hE => ?_, fun x => ?_⟩
  · rw [DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
    split_ifs <;> simp
  · rw [Finsupp.support_single _ one_ne_zero, Finset.mem_singleton] at hE
    subst hE
    exact hSs
  have := isRegularLocalRing_stalk_of_smooth_over_field sX x
  by_cases hx : x ∈ S.support
  · obtain ⟨q, -, hq, hq1⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support S hx
    set I := AlgebraicGeometry.IdealSheafData.stalk S.idealSheaf x with hI
    have : I.IsPrime := by rw [hq]; exact q.isPrime
    have hreg : IsRegularLocalRing (X.presheaf.stalk x ⧸ I) :=
      MMP.Flips.ResolutionInputs.isRegularLocalRing_quotient_stalk sX S.idealSheaf hSs hx
    have hdim := MMP.Flips.ResolutionInputs.ringKrullDim_quotient_add_one_of_height_eq_one I
      (by rw [hq]; exact hq1)
    set m := (IsLocalRing.maximalIdeal (X.presheaf.stalk x ⧸ I)).spanFinrank
    have hm : ringKrullDim (X.presheaf.stalk x ⧸ I) = m :=
      (IsRegularLocalRing.spanFinrank_maximalIdeal (R := X.presheaf.stalk x ⧸ I)).symm
    obtain ⟨z₁, z₂, hz, -, hIz⟩ :=
      MMP.Flips.ResolutionInputs.exists_flag_isRegularSystemOfParameters le_rfl hreg hdim hreg
        le_rfl (m := m) (by rw [← hdim, hm]; push_cast; ring_nf) hm
    refine ⟨1 + m, Fin.append z₁ z₂, fun _ => Fin.castAdd m 0, hz, ?_, ?_⟩
    · rintro ⟨E₁, hE₁, -⟩ ⟨E₂, hE₂, -⟩ -
      rw [Finsupp.support_single _ one_ne_zero, Finset.mem_singleton] at hE₁ hE₂
      subst hE₁; subst hE₂; rfl
    · rintro ⟨E, hE, -⟩
      rw [Finsupp.support_single _ one_ne_zero, Finset.mem_singleton] at hE
      subst hE
      rw [Fin.append_left]
      exact hIz
  · obtain ⟨n, z, hz⟩ := MMP.Mori.exists_isRegularSystemOfParameters (X.presheaf.stalk x)
    have hns : ∀ E ∈ (Finsupp.single S (1 : ℤ)).support, x ∉ E.support := by
      intro E hE
      rw [Finsupp.support_single _ one_ne_zero, Finset.mem_singleton] at hE
      subst hE
      exact hx
    exact ⟨n, z, fun E => absurd E.2.2 (hns _ E.2.1), hz, fun E => absurd E.2.2 (hns _ E.2.1),
      fun E => absurd E.2.2 (hns _ E.2.1)⟩

/-- The generic point of an integral scheme lies on no prime divisor. -/
private theorem genericPoint_notMem_supp {Y : Scheme.{u}} [IsIntegral Y] {R : Type*} [Zero R]
    (D : DivisorWithCoeffs R Y) : genericPoint Y ∉ D.supp := by
  intro h
  obtain ⟨E, -, hE⟩ := DivisorWithCoeffs.mem_supp_iff.mp h
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hE
  have h1 : E.genericPoint ⤳ genericPoint Y := specializes_iff_mem_closure.mpr hE
  have h2 : genericPoint Y ⤳ E.genericPoint := genericPoint_specializes _
  have heq : E.genericPoint = genericPoint Y := (h1.antisymm h2).eq
  have h0 : Order.coheight (genericPoint Y) = 0 :=
    Order.coheight_eq_zero.mpr fun t _ => genericPoint_specializes t
  have := E.coheight_genericPoint
  rw [heq, h0] at this
  exact zero_ne_one this

/-- On an integral scheme, the only stratum of the zero divisor is the whole space, so no
support of a divisor contains a stratum of `0`. -/
private theorem containsNoStratum_zero {Y : Scheme.{u}} [IsIntegral Y] {R : Type*} [Zero R]
    (D : DivisorWithCoeffs R Y) : ContainsNoStratum (0 : Divisor Y) D.supp := by
  rintro W ⟨J, hJ, hW⟩ hWD
  have hJ0 : J = ∅ := Finset.subset_empty.mp (by simpa using hJ)
  subst hJ0
  have huniv : (Set.univ : Set Y) ⊆ W :=
    hW.2 ⟨IrreducibleSpace.isIrreducible_univ Y, by simp⟩ (by simp)
  exact genericPoint_notMem_supp D (hWD (huniv trivial))

/-- No support of a divisor of which `S` is not a component contains a stratum of `S`. -/
private theorem containsNoStratum_single {Y : Scheme.{u}} [IsIntegral Y]
    (S : MMP.Mori.PrimeDivisor Y) {R : Type*} [Zero R] (D : DivisorWithCoeffs R Y)
    (hD : D.coeff S = 0) : ContainsNoStratum (Finsupp.single S (1 : ℤ)) D.supp := by
  classical
  rintro W ⟨J, hJ, hW⟩ hWD
  rw [Finsupp.support_single _ one_ne_zero, Finset.subset_singleton_iff] at hJ
  have hSW : (S.support : Set Y) ⊆ W := by
    rcases hJ with rfl | rfl
    · exact fun x _ => (hW.2 ⟨IrreducibleSpace.isIrreducible_univ Y, by simp⟩ (by simp))
        (Set.mem_univ x)
    · refine hW.2 ⟨?_, by simp⟩ (by simpa using hW.1.2)
      rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact isIrreducible_singleton.closure
  have hS : S.genericPoint ∈ (S.support : Set Y) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  obtain ⟨E, hE, hSE⟩ := DivisorWithCoeffs.mem_supp_iff.mp (hWD (hSW hS))
  have hEq := E.eq_genericPoint_of_mem_support hSE S.coheight_genericPoint
  rw [AlgebraicGeometry.PrimeDivisor.genericPoint_injective hEq] at hD
  exact hE hD

/-- The zero divisor of an integral scheme smooth over a field is reduced snc. -/
private theorem isReducedSNC_zero {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k))
    [LocallyOfFinitePresentation sY] (hsm : IsSmoothScheme sY) : IsReducedSNC sY 0 :=
  ⟨fun P => Or.inl (by simp), DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme sY hsm⟩

/-- The order of a power. -/
private theorem ord_pow {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] {y : Y}
    {g : Y.functionField} (hg : g ≠ 0) (n : ℕ) : Y.ord (g ^ n) y = n * Y.ord g y := by
  induction n with
  | zero => simp [Scheme.ord_one]
  | succ n ih =>
    rw [pow_succ, Scheme.ord_mul (pow_ne_zero _ hg) hg, ih]
    push_cast
    ring

/-- Powers of sections are sections of the multiples. -/
private theorem pow_mem_sectionsIn {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] {D : Divisor Y} {g : Y.functionField} (hg : g ∈ sectionsIn D) (n : ℕ) :
    g ^ n ∈ sectionsIn ((n : ℤ) • D) := by
  intro P
  rw [map_pow, DivisorWithCoeffs.coeff_smul, smul_eq_mul, ← nsmul_eq_mul, WithZero.exp_nsmul]
  exact pow_le_pow_left₀ zero_le (hg P) n

/-- The round down of an integral divisor is itself. -/
private theorem roundDown_toQDivisor {Y : Scheme.{u}} (D : Divisor Y) :
    (Divisor.toQDivisor D).roundDown = D := by
  ext E
  rw [DivisorWithCoeffs.coeff_roundDown, Divisor.coeff_toQDivisor, Int.floor_intCast]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- The restriction of the zero divisor is zero. -/
private theorem restrictPrimeDivisor_zero [NoetherianSpace X] {R : Type*} [AddCommGroup R]
    (S : MMP.Mori.PrimeDivisor X) :
    (0 : DivisorWithCoeffs R X).restrictPrimeDivisor S = 0 := by
  classical
  ext Q
  rw [coeff_restrictPrimeDivisor_eq_sum S (by simp) ∅ (by simp) Q]
  simp

open RingedSpaceModuleAdjunction in
omit [IsIntegral X] in
/-- A positive multiple of an `f`-ample Cartier divisor is `f`-ample. -/
private theorem isRelativelyAmple_nsmul [CompactSpace X] {Z : Scheme.{u}}
    {f : X ⟶ Z} {L : Divisor X} (hL : L.IsCartier) (h : L.IsRelativelyAmple f hL) (n : ℕ)
    (hn : 0 < n) : (n • L).IsRelativelyAmple f (hL.nsmul n) := by
  have := hL.isInvertibleModule_divisorialSheaf
  have := (hL.nsmul n).isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, hA⟩ := h y
  refine ⟨V, hV, hyV, ?_⟩
  obtain ⟨e0⟩ := nonempty_divisorialSheaf_nsmul_iso hL n hn
  have := Stacks.Ample.isInvertibleModule_tensorPowModule (f ⁻¹ᵁ V).toScheme
    ((modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).obj L.divisorialSheaf) (n : ℤ)
  let e := (modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e0 ≪≫
    Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso (f ⁻¹ᵁ V).ι _ n
  rw [Stacks.RelativeVeryAmple.isAmple_congr _ _ e]
  exact (Stacks.AmplePositivePower.isAmple_iff_isAmple_tensorPowModule _ n hn).1 hA

omit [IsIntegral X] in
/-- The divisor of a power of a unit. -/
private theorem principalDivisor_zpow [CompactSpace X]
    (u : (MMP.Mori.RationalFunctions X)ˣ) (j : ℤ) :
    MMP.Mori.principalDivisor (u ^ j) = j • MMP.Mori.principalDivisor u := by
  have h1 := MMP.Mori.principalDivisorHom_apply (Additive.ofMul (u ^ j))
  have h2 := MMP.Mori.principalDivisorHom_apply (Additive.ofMul u)
  simp only [toMul_ofMul] at h1 h2
  rw [← h1, ← h2, ofMul_zpow, map_zsmul]

omit [IsIntegral X] in
/-- **Relative ampleness up to a rational multiple of a principal divisor.** If `D` is `f`-ample
and `mD' = mD + j div(u)` for an integer `m > 0`, then `D'` is `f`-ample. -/
private theorem hasRelativelyAmpleMultiple_of_smul_eq [CompactSpace X]
    {Z : Scheme.{u}} {f : X ⟶ Z} {D D' : QDivisor X} (hD : D.HasRelativelyAmpleMultiple f)
    {m : ℕ} (hm : 0 < m) (j : ℤ) (u : (MMP.Mori.RationalFunctions X)ˣ)
    (h : (m : ℤ) • D' = (m : ℤ) • D + j • Divisor.toQDivisor (MMP.Mori.principalDivisor u)) :
    D'.HasRelativelyAmpleMultiple f := by
  obtain ⟨n, hn, L, hL, hLeq, hamp⟩ := hD
  refine ⟨n * m, Nat.mul_pos hn hm, m • L + MMP.Mori.principalDivisor (u ^ ((n : ℤ) * j)),
    (hL.nsmul m).add (Divisor.isCartier_principalDivisor _), ?_,
    isRelativelyAmple_add_principalDivisor f (hL.nsmul m)
      (isRelativelyAmple_nsmul hL hamp m hm) _⟩
  rw [principalDivisor_zpow]
  ext E
  have hE := congrArg (fun G : QDivisor X => G.coeff E) h
  have hLE := congrArg (fun G : QDivisor X => G.coeff E) hLeq
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor,
    zsmul_eq_mul, nsmul_eq_mul, map_add, map_nsmul, map_zsmul] at hE hLE ⊢
  push_cast at hE hLE ⊢
  linear_combination (m : ℚ) * hLE - (n : ℚ) * hE

/-- **A section of `𝒪(M)` near a point is a local generator times a section of `𝒪(-div)`.**
For a Cartier divisor `M` and a nonzero rational function `g`, near every point `g = u j` with
`u` a section of `𝒪(M)` and `j` a section of `𝒪(-(M + div g))`. -/
private theorem exists_mul_eq_of_isCartier {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] {M : Divisor Y} (hM : M.IsCartier) {g : Y.functionField}
    (hg : g ≠ 0) (y : Y) :
    ∃ W : Y.Opens, y ∈ W ∧ ∃ u ∈ MMP.Intersection.multiplierIdealSections (𝟙 Y) M W,
      ∃ j ∈ MMP.Intersection.multiplierIdealSections (𝟙 Y) (-(M + ffDiv g hg)) W, u * j = g := by
  obtain ⟨W, hyW, φ, hφ⟩ := hM y
  set ψ := rationalFunctionsEquivFunctionField Y φ with hψ
  have hψ0 : ψ ≠ 0 := (φ.isUnit.map (rationalFunctionsEquivFunctionField Y)).ne_zero
  have hne : (𝟙 Y) ⁻¹ᵁ W ≠ ⊥ := by
    intro h0
    have : y ∈ (𝟙 Y) ⁻¹ᵁ W := hyW
    rw [h0] at this
    exact this
  have hord : ∀ P : MMP.Mori.PrimeDivisor Y, (P.support ∩ (𝟙 Y) ⁻¹ᵁ W).Nonempty →
      Y.ord ψ P.genericPoint = M.coeff P := by
    intro P hP
    rw [hφ P hP, MMP.Mori.PrimeDivisor.ord_eq_ord_rationalFunctionsEquivFunctionField]
  refine ⟨W, hyW, ψ⁻¹, ⟨fun h0 => absurd h0 hne, fun P hP => ?_⟩, g * ψ,
    ⟨fun h0 => absurd h0 hne, fun P hP => ?_⟩, ?_⟩
  · rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
      map_inv₀, P.divisorialValuation_eq_exp_neg_ord hψ0, hord P hP, ← WithZero.exp_neg, neg_neg]
  · rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply,
      P.divisorialValuation_eq_exp_neg_ord (mul_ne_zero hg hψ0), Scheme.ord_mul hg hψ0, hord P hP,
      DivisorWithCoeffs.coeff_neg, DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
    exact le_of_eq (congrArg WithZero.exp (by ring))
  · rw [inv_mul_eq_iff_eq_mul₀ hψ0, mul_comm]

end Boundary

/-- The model computing a reduced-boundary adjoint ideal is quasi-compact. -/
private theorem compactSpace_of_isReducedAdjointIdealOn {W : Scheme.{u}} (sW : W ⟶ Spec (.of k))
    [IsIntegral W] [IsLocallyNoetherian W] [IsNormal W] {Δ : Divisor W} {D : QDivisor W}
    {Y : Scheme.{u}} {μ : Y ⟶ W} {J : W.Opens → Set W.functionField}
    (hJ : IsReducedAdjointIdealOn sW Δ D μ J) : CompactSpace Y := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, hY, -⟩ := hJ
  have : MMP.Mori.IsVariety k (μ ≫ sW) := hY.1
  exact QuasiCompact.compactSpace_of_compactSpace (μ ≫ sW)

/-- **Klt pairs have trivial adjoint ideal.** If `(Y, Ω)` is klt on a smooth variety, then the
adjoint ideal `𝒥_{0,Ω}` with empty reduced boundary is the unit ideal: every place has positive
log discrepancy, and the places of `(Y, 0)` with log discrepancy zero do not exist. -/
private theorem adjointIdeal_eq_range_of_isKltPair {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k))
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (hsm : IsSmoothScheme sY)
    {Ω : QDivisor Y} (hklt : IsKltPair sY Ω) {W : Scheme.{u}} {μ : W ⟶ Y}
    {J : Y.Opens → Set Y.functionField} (hJ : IsReducedAdjointIdealOn sY 0 Ω μ J) :
    ∀ (U : Y.Opens) [Nonempty U], J U = Set.range (Y.germToFunctionField U) := by
  have : Smooth sY := MMP.Mori.IsSmoothScheme.smooth hsm
  refine ((isReducedAdjointIdealOn_operations sY).2.2.2.2.2.2 _ _ μ J hJ).2 ?_
  intro n F a a₀ ha ha₀
  refine ⟨fun h0 => ?_, fun _ => hklt.2 n F a (by simpa using ha)⟩
  subst h0
  exact eq_zero_of_isLogDiscrepancy_eq_zero hklt.1.isPair.1 hsm (isReducedSNC_zero _ hsm)
    (containsNoStratum_zero _) ha₀ ha

/-- **The coefficient comparison on `S`.** Along a prime divisor of `S`, write `κ`, `φ`, `a`,
`b`, `p` for the coefficients of `(K_X + S)|_S`, `Φ`, `A|_S`, `B|_S`, `P|_S` and `s` for the order
of a section of `𝒪_S(k(K_S + Φ))`, so `0 ≤ s + k(κ + φ)`. With `r = (k - 1)/m` and `m = kl`, the
coefficient of `Λ|_S = r G|_S + B|_S` minus that of `A' = div s + k(K_S + Ω)` is at most that of
`Ω' = Ω + r P|_S`: the difference is `-((s + k(κ + φ))/k + (a + b - φ) + a/k) ≤ 0`. -/
private theorem coeff_restrict_sub_le {c l : ℕ} (hc : 0 < c) (hl : l ≠ 0) {κ s φ a b p : ℚ}
    (hs : 0 ≤ s + c * (κ + φ)) (hφ : φ ≤ a + b) (ha : 0 ≤ a) :
    ((c : ℚ) - 1) / (c * l : ℕ) * (l * (c * (κ + a + b)) + l * a + p + l * s) + b -
      (c * (κ + a + b) + s) ≤ a + b + ((c : ℚ) - 1) / (c * l : ℕ) * p := by
  have hc' : (0 : ℚ) < c := by exact_mod_cast hc
  have hl' : (l : ℚ) ≠ 0 := by exact_mod_cast hl
  have key : ((c : ℚ) - 1) / (c * l : ℕ) * (l * (c * (κ + a + b)) + l * a + p + l * s) + b -
      (c * (κ + a + b) + s) - (a + b + ((c : ℚ) - 1) / (c * l : ℕ) * p) =
      -((s + c * (κ + φ)) / c + (a + b - φ) + a / c) := by
    push_cast
    field_simp
    ring
  have := add_nonneg (add_nonneg (div_nonneg hs hc'.le) (sub_nonneg.2 hφ)) (div_nonneg ha hc'.le)
  linarith

end Proof_lem_fourfold_remove_extension_twist

end

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_fourfold_remove_extension_twist
open CategoryTheory AlgebraicGeometry TopologicalSpace Pointwise MMP.Fourfold MMP.Mori

/-- **Removing an auxiliary ample twist from an extension.** Let `f : X ⟶ Z` be projective with
`Z` affine and `X` a smooth variety over an algebraically closed field of characteristic zero,
with canonical divisor `K_X`, `S` a smooth prime divisor with `K_X` of coefficient `-1` along
`S`, `K_S = (K_X + S)|_S`, and `Δ = S + A + B` with `A, B ≥ 0` not containing `S` and `A`
`f`-ample, `Ω = (A + B)|_S` with `(S, Ω)` klt. Let `k > 0` with `k(K_X + Δ)` integral,
`C = A/k`, and `0 ≤ Φ ≤ Ω` with `k(K_S + Φ)` integral. Let `l > 1`, `m = kl`, and `P` an
effective integral Cartier divisor not containing `S`, with `lA` integral,
`C - ((k - 1)/m)P` `f`-ample and `(S, Ω + ((k - 1)/m)P|_S)` klt, such that every section of
`𝒪_S(m(K_S + Φ))` is the restriction of a section of `𝒪_X(m(K_X + Δ + C) + P)`. Then every
section of `𝒪_S(k(K_S + Φ))` is the restriction of a section of `𝒪_X(k(K_X + Δ))`. -/
@[mmp "lem_fourfold_remove_extension_twist"]
public theorem exists_isRestrictionAlong_of_exists_isRestrictionAlong_twist {k : Type}
    [Field k] [IsAlgClosed k] [CharZero k] {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k))
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (hX : IsNormalVariety k sX) (hXs : IsSmoothScheme sX)
    (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    (n : ℕ) (KX : Divisor X) (hKX : KX.IsCanonicalDivisor sX n)
    (S : MMP.Mori.PrimeDivisor X) (hKXS : KX.coeff S = -1)
    [IsLocallyNoetherian S.idealSheaf.subscheme] [IsNormal S.idealSheaf.subscheme]
    (hSs : IsSmoothScheme (S.idealSheaf.subschemeι ≫ sX))
    (A B : QDivisor X) (hA0 : 0 ≤ A) (hB0 : 0 ≤ B) (hAS : A.coeff S = 0) (hBS : B.coeff S = 0)
    (hA : A.HasRelativelyAmpleMultiple f)
    (hklt : haveI := S.integral;
      IsKltPair (S.idealSheaf.subschemeι ≫ sX) ((A + B).restrictPrimeDivisor S))
    (c : ℕ) (hc : 0 < c)
    (hcΔ : ((c : ℚ) • (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A +
      B)).IsCartierDivisor)
    (Φ : haveI := S.integral; QDivisor S.idealSheaf.subscheme)
    (hΦ0 : haveI := S.integral; 0 ≤ Φ) (hΦΩ : Φ ≤ (A + B).restrictPrimeDivisor S)
    (hcΦ : haveI := S.integral;
      ((c : ℚ) • (Divisor.toQDivisor
        ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + Φ)).IsCartierDivisor)
    (l : ℕ) (hl : 1 < l) (P : Divisor X) (hP : P.IsCartier) (hP0 : 0 ≤ P) (hPS : P.coeff S = 0)
    (hlA : ((l : ℚ) • A).IsCartierDivisor)
    (hamp : ((c : ℚ)⁻¹ • A - (((c : ℚ) - 1) / (c * l : ℕ)) • Divisor.toQDivisor P)
      |>.HasRelativelyAmpleMultiple f)
    (hklt' : haveI := S.integral;
      IsKltPair (S.idealSheaf.subschemeι ≫ sX) ((A + B).restrictPrimeDivisor S +
        (((c : ℚ) - 1) / (c * l : ℕ)) • (Divisor.toQDivisor P).restrictPrimeDivisor S))
    (hext : haveI := S.integral;
      ∀ s ∈ sectionsIn (DivisorWithCoeffs.roundDown (((c * l : ℕ) : ℚ) • (Divisor.toQDivisor
          ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + Φ))),
        ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown (((c * l : ℕ) : ℚ) •
            (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B +
              (c : ℚ)⁻¹ • A)) + P),
          IsRestrictionAlong S g s) :
    haveI := S.integral;
    ∀ s ∈ sectionsIn (DivisorWithCoeffs.roundDown ((c : ℚ) • (Divisor.toQDivisor
        ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + Φ))),
      ∃ g ∈ sectionsIn (DivisorWithCoeffs.roundDown ((c : ℚ) •
          (Divisor.toQDivisor KX + Divisor.toQDivisor (Finsupp.single S 1) + A + B))),
        IsRestrictionAlong S g s := by
  have := S.integral
  classical
  have : IsNoetherian X := {}
  have : Smooth sX := MMP.Mori.IsSmoothScheme.smooth hXs
  have : CompactSpace S.idealSheaf.subscheme :=
    QuasiCompact.compactSpace_of_compactSpace S.idealSheaf.subschemeι
  set T : Divisor X := Finsupp.single S 1 with hTdef
  have hTS : T.coeff S = 1 := Finsupp.single_eq_same
  have hKTS : (KX + T).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hKXS, hTS]; norm_num
  -- integral representatives of the divisors that are Cartier
  obtain ⟨D₁, hD₁, -⟩ := hcΔ
  obtain ⟨D₂, hD₂, -⟩ := hlA
  obtain ⟨D₃, hD₃, -⟩ := hcΦ
  have hD₁E : ∀ E, (D₁.coeff E : ℚ) =
      c * (KX.coeff E + T.coeff E + A.coeff E + B.coeff E) := by
    intro E
    have := congrArg (fun G : QDivisor X => G.coeff E) hD₁
    simpa only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor, smul_eq_mul] using this
  have hD₂E : ∀ E, (D₂.coeff E : ℚ) = l * A.coeff E := by
    intro E
    have := congrArg (fun G : QDivisor X => G.coeff E) hD₂
    simpa only [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, smul_eq_mul] using this
  have hD₃E : ∀ Q, (D₃.coeff Q : ℚ) =
      c * ((((KX + T).restrictPrimeDivisor S).coeff Q : ℚ) + Φ.coeff Q) := by
    intro Q
    have := congrArg (fun G : QDivisor S.idealSheaf.subscheme => G.coeff Q) hD₃
    simpa only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor, smul_eq_mul] using this
  have hD₁S : D₁.coeff S = 0 := by
    have := hD₁E S
    rw [hKXS, hTS, hAS, hBS] at this
    exact_mod_cast (by simpa using this)
  have hD₂S : D₂.coeff S = 0 := by
    have := hD₂E S
    rw [hAS] at this
    exact_mod_cast (by simpa using this)
  -- the round downs are exact
  have hr1 : DivisorWithCoeffs.roundDown ((c : ℚ) • (Divisor.toQDivisor KX +
      Divisor.toQDivisor (Finsupp.single S 1) + A + B)) = D₁ := by
    rw [← hD₁, roundDown_toQDivisor]
  have hr2 : DivisorWithCoeffs.roundDown (((c * l : ℕ) : ℚ) • (Divisor.toQDivisor KX +
      Divisor.toQDivisor (Finsupp.single S 1) + A + B + (c : ℚ)⁻¹ • A)) = (l : ℤ) • D₁ + D₂ := by
    rw [← roundDown_toQDivisor ((l : ℤ) • D₁ + D₂)]
    congr 1
    ext E
    simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, map_add, map_zsmul,
      Divisor.coeff_toQDivisor, smul_eq_mul, zsmul_eq_mul]
    push_cast
    rw [hD₁E, hD₂E]
    field_simp
    ring
  have hr3 : DivisorWithCoeffs.roundDown ((c : ℚ) • (Divisor.toQDivisor
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + Φ)) = D₃ := by
    rw [← hD₃, roundDown_toQDivisor]
  have hr4 : DivisorWithCoeffs.roundDown (((c * l : ℕ) : ℚ) • (Divisor.toQDivisor
      ((KX + Finsupp.single S 1).restrictPrimeDivisor S) + Φ)) = (l : ℤ) • D₃ := by
    rw [← roundDown_toQDivisor ((l : ℤ) • D₃)]
    congr 1
    ext Q
    simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, map_zsmul,
      Divisor.coeff_toQDivisor, smul_eq_mul, zsmul_eq_mul]
    push_cast
    rw [hD₃E]
    ring
  rw [hr1, hr3]
  rw [hr2, hr4] at hext
  intro s hs
  rcases eq_or_ne s 0 with rfl | hs0
  · exact ⟨0, (sectionsSubgroup _).zero_mem, 0, map_zero _, map_zero _⟩
  -- the extension of `s ^ l`
  obtain ⟨g₁, hg₁, hres⟩ := hext (s ^ l) (pow_mem_sectionsIn hs l)
  obtain ⟨hg₁0, hg₁S⟩ := ne_zero_and_ord_eq_zero_of_isRestrictionAlong S hres (pow_ne_zero _ hs0)
  -- the member `G₀ = div g₁ + l D₁ + D₂ + P` and the boundary `Λ = (k - 1)/m G₀ + B`
  set G₀ : Divisor X := (l : ℤ) • D₁ + D₂ + P + ffDiv g₁ hg₁0 with hG₀def
  have hG₀0 : ∀ E, 0 ≤ G₀.coeff E := coeff_add_ffDiv_nonneg hg₁ hg₁0
  have hM₀S : ((l : ℤ) • D₁ + D₂ + P).coeff S = 0 := by
    simp [hD₁S, hD₂S, hPS]
  have hG₀S : G₀.coeff S = 0 := by
    rw [hG₀def, DivisorWithCoeffs.coeff_add, hM₀S, MMP.Mori.coeff_principalDivisor_mk0, hg₁S, add_zero]
  set r : ℚ := ((c : ℚ) - 1) / (c * l : ℕ) with hrdef
  have hr0 : 0 ≤ r := div_nonneg (sub_nonneg.mpr (by exact_mod_cast hc)) (Nat.cast_nonneg _)
  set Λ : QDivisor X := r • Divisor.toQDivisor G₀ + B with hΛdef
  have hΛE : ∀ E, Λ.coeff E = r * G₀.coeff E + B.coeff E := fun E => by
    simp [hΛdef, Divisor.coeff_toQDivisor]
  have hΛ0 : ∀ E, 0 ≤ Λ.coeff E := fun E => by
    rw [hΛE]
    exact add_nonneg (mul_nonneg hr0 (by exact_mod_cast hG₀0 E)) (hB0 E)
  have hΛS : Λ.coeff S = 0 := by rw [hΛE, hG₀S, hBS]; simp
  -- `N = k(K_X + Δ) - K_X - S`, with `N - Λ` relatively ample
  set N : Divisor X := D₁ - KX - T with hNdef
  have hNamp : (Divisor.toQDivisor N - Λ).HasRelativelyAmpleMultiple f := by
    refine hasRelativelyAmpleMultiple_of_smul_eq hamp (m := c * l) (Nat.mul_pos hc (by omega))
      (-((c : ℤ) - 1))
      (Units.map (rationalFunctionsEquivFunctionField X).symm.toMonoidHom (Units.mk0 g₁ hg₁0)) ?_
    ext E
    have h1 := hD₁E E
    have h2 := hD₂E E
    have h3 : (G₀.coeff E : ℚ) = l * D₁.coeff E + D₂.coeff E + P.coeff E +
        X.ord g₁ E.genericPoint := by
      rw [hG₀def]
      simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
        MMP.Mori.coeff_principalDivisor_mk0]
      push_cast
      ring
    simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      MMP.Mori.coeff_principalDivisor_mk0,
      DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, smul_eq_mul, zsmul_eq_mul, hΛE,
      map_sub, hNdef] at h3 ⊢
    rw [hrdef, h3, h2, h1]
    push_cast
    field_simp
    ring
  -- the adjoint ideals `𝒥_{S,Λ}`, `𝒥_{0,Λ+S}`, `𝒥_{0,Λ|_S}` and `𝒥_{0,Ω'}`
  have : Smooth (S.idealSheaf.subschemeι ≫ sX) := MMP.Mori.IsSmoothScheme.smooth hSs
  have hops := isReducedAdjointIdealOn_operations sX
  have hopsS := isReducedAdjointIdealOn_operations (S.idealSheaf.subschemeι ≫ sX)
  have hSv : IsNormalVariety k (S.idealSheaf.subschemeι ≫ sX) := hklt.1.isPair.1
  have hTT : T - T = 0 := sub_self T
  have hΘ : (T - T).restrictPrimeDivisor S = 0 := by rw [hTT, restrictPrimeDivisor_zero]
  have hT0 : ∀ E, 0 ≤ (Divisor.toQDivisor T).coeff E := fun E => by
    rw [Divisor.coeff_toQDivisor, hTdef, DivisorWithCoeffs.coeff_apply, Finsupp.single_apply]
    split_ifs <;> norm_num
  have hPQ0 : ∀ E, 0 ≤ (Divisor.toQDivisor P).coeff E := fun E => by
    rw [Divisor.coeff_toQDivisor]; exact_mod_cast hP0 E
  have hPQS : (Divisor.toQDivisor P).coeff S = 0 := by rw [Divisor.coeff_toQDivisor, hPS]; simp
  have hABS : (A + B).coeff S = 0 := by rw [DivisorWithCoeffs.coeff_add, hAS, hBS, add_zero]
  obtain ⟨Y, μ, J, hJ⟩ := hops.1 T Λ hX hXs (isReducedSNC_single sX hXs S hSs) hΛ0
    (containsNoStratum_single S Λ hΛS)
  obtain ⟨Y', μ', J', hJ'⟩ := hops.1 (T - T) (Λ + Divisor.toQDivisor T) hX hXs
    (by rw [hTT]; exact isReducedSNC_zero sX hXs)
    (fun E => by rw [DivisorWithCoeffs.coeff_add]; exact add_nonneg (hΛ0 E) (hT0 E))
    (by rw [hTT]; exact containsNoStratum_zero _)
  have hΛS0 : ∀ Q, 0 ≤ (Λ.restrictPrimeDivisor S).coeff Q :=
    coeff_restrictPrimeDivisor_nonneg S hΛ0 hΛS
  obtain ⟨YS, μS, JS, hJS⟩ := hopsS.1 ((T - T).restrictPrimeDivisor S) (Λ.restrictPrimeDivisor S)
    hSv hSs (by rw [hΘ]; exact isReducedSNC_zero _ hSs) hΛS0
    (by rw [hΘ]; exact containsNoStratum_zero _)
  set Ω' : QDivisor S.idealSheaf.subscheme := (A + B).restrictPrimeDivisor S +
    r • (Divisor.toQDivisor P).restrictPrimeDivisor S with hΩ'def
  have hΩ'0 : ∀ Q, 0 ≤ Ω'.coeff Q := fun Q => by
    rw [hΩ'def, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact add_nonneg (coeff_restrictPrimeDivisor_nonneg S
      (fun E => by rw [DivisorWithCoeffs.coeff_add]; exact add_nonneg (hA0 E) (hB0 E)) hABS Q)
      (mul_nonneg hr0 (coeff_restrictPrimeDivisor_nonneg S hPQ0 hPQS Q))
  obtain ⟨YΩ, μΩ, JΩ, hJΩ⟩ := hopsS.1 ((T - T).restrictPrimeDivisor S) Ω' hSv hSs
    (by rw [hΘ]; exact isReducedSNC_zero _ hSs) hΩ'0 (by rw [hΘ]; exact containsNoStratum_zero _)
  have hunit := adjointIdeal_eq_range_of_isKltPair _ hSs hklt' (hΘ ▸ hJΩ)
  -- the divisor `A' = div s + k(K_S + Ω)` and the comparison `Λ|_S - A' ≤ Ω'`
  set A' : Divisor S.idealSheaf.subscheme := D₁.restrictPrimeDivisor S + ffDiv s hs0 with hA'def
  have hX1 : (Divisor.toQDivisor KX + Divisor.toQDivisor T).coeff S = 0 := by
    rw [← map_add, Divisor.coeff_toQDivisor, hKTS]; simp
  have hX2 : (Divisor.toQDivisor KX + Divisor.toQDivisor T + A).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hX1, hAS, add_zero]
  have hX3 : (Divisor.toQDivisor KX + Divisor.toQDivisor T + A + B).coeff S = 0 := by
    rw [DivisorWithCoeffs.coeff_add, hX2, hBS, add_zero]
  have hD₁Q : ∀ Q, ((D₁.restrictPrimeDivisor S).coeff Q : ℚ) =
      c * ((((KX + T).restrictPrimeDivisor S).coeff Q : ℚ) +
        (A.restrictPrimeDivisor S).coeff Q + (B.restrictPrimeDivisor S).coeff Q) := by
    intro Q
    have h := congrArg (fun G : QDivisor X => (G.restrictPrimeDivisor S).coeff Q) hD₁
    rw [Divisor.restrictPrimeDivisor_toQDivisor _ S hD₁S, restrictPrimeDivisor_smul S hX3,
      DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hX2 hBS,
      DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hX1 hAS, ← map_add,
      Divisor.restrictPrimeDivisor_toQDivisor _ S hKTS] at h
    simpa only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
      Divisor.coeff_toQDivisor, smul_eq_mul] using h
  have hD₂Q : ∀ Q, ((D₂.restrictPrimeDivisor S).coeff Q : ℚ) =
      l * (A.restrictPrimeDivisor S).coeff Q := by
    intro Q
    have h := congrArg (fun G : QDivisor X => (G.restrictPrimeDivisor S).coeff Q) hD₂
    rw [Divisor.restrictPrimeDivisor_toQDivisor _ S hD₂S, restrictPrimeDivisor_smul S hAS] at h
    simpa only [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, smul_eq_mul] using h
  have hΩQ : ∀ Q, ((A + B).restrictPrimeDivisor S).coeff Q =
      (A.restrictPrimeDivisor S).coeff Q + (B.restrictPrimeDivisor S).coeff Q := fun Q => by
    rw [DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hAS hBS, DivisorWithCoeffs.coeff_add]
  have hG₀Q : ∀ Q, ((G₀.restrictPrimeDivisor S).coeff Q : ℚ) =
      l * (D₁.restrictPrimeDivisor S).coeff Q + (D₂.restrictPrimeDivisor S).coeff Q +
        (P.restrictPrimeDivisor S).coeff Q +
          l * S.idealSheaf.subscheme.ord s Q.genericPoint := by
    intro Q
    have hlD₁ : ((l : ℤ) • D₁).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_smul, hD₁S, smul_zero]
    have hlD₂ : ((l : ℤ) • D₁ + D₂).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_add, hlD₁, hD₂S, add_zero]
    rw [hG₀def, restrictPrimeDivisor_add_ffDiv sX hXs S hSs _ hM₀S hres hg₁0 (pow_ne_zero l hs0),
      DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hlD₂ hPS,
      DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hlD₁ hD₂S,
      restrictPrimeDivisor_smul S hD₁S]
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul,
      MMP.Mori.coeff_principalDivisor_mk0, ord_pow hs0]
    push_cast
    ring
  have hΛQ : ∀ Q, (Λ.restrictPrimeDivisor S).coeff Q =
      r * (G₀.restrictPrimeDivisor S).coeff Q + (B.restrictPrimeDivisor S).coeff Q := by
    intro Q
    have hrG : (r • Divisor.toQDivisor G₀).coeff S = 0 := by
      rw [DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor, hG₀S]; simp
    rw [hΛdef, DivisorWithCoeffs.restrictPrimeDivisor_add _ _ S hrG hBS,
      restrictPrimeDivisor_smul S (by rw [Divisor.coeff_toQDivisor, hG₀S]; simp),
      Divisor.restrictPrimeDivisor_toQDivisor _ S hG₀S]
    simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul,
      Divisor.coeff_toQDivisor, smul_eq_mul]
  have hsQ : ∀ Q : MMP.Mori.PrimeDivisor S.idealSheaf.subscheme,
      0 ≤ (S.idealSheaf.subscheme.ord s Q.genericPoint : ℚ) + D₃.coeff Q := fun Q => by
    have h := hs Q
    rw [Q.divisorialValuation_eq_exp_neg_ord hs0, WithZero.exp_le_exp] at h
    exact_mod_cast (by omega : (0 : ℤ) ≤ S.idealSheaf.subscheme.ord s Q.genericPoint + D₃.coeff Q)
  have hA'Q : ∀ Q, (A'.coeff Q : ℚ) = (D₁.restrictPrimeDivisor S).coeff Q +
      S.idealSheaf.subscheme.ord s Q.genericPoint := fun Q => by
    rw [hA'def, DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor_mk0]
    push_cast; ring
  have hAQ0 : ∀ Q, 0 ≤ (A.restrictPrimeDivisor S).coeff Q :=
    coeff_restrictPrimeDivisor_nonneg S hA0 hAS
  have hA'0 : 0 ≤ A' := fun Q => by
    have h1 := hsQ Q
    have h2 := hD₁Q Q
    have h3 := hD₃E Q
    have h4 : Φ.coeff Q ≤ ((A + B).restrictPrimeDivisor S).coeff Q := hΦΩ Q
    rw [hΩQ] at h4
    have h5 : (0 : ℚ) ≤ A'.coeff Q := by
      rw [hA'Q, h2]
      rw [h3] at h1
      nlinarith
    exact_mod_cast h5
  have hle : ∀ Q, (Λ.restrictPrimeDivisor S).coeff Q - (A'.coeff Q : ℚ) ≤ Ω'.coeff Q := by
    intro Q
    have h1 := hsQ Q
    rw [hD₃E] at h1
    have h := coeff_restrict_sub_le hc (by omega : l ≠ 0) h1 ((hΦΩ Q).trans_eq (hΩQ Q))
      (hAQ0 Q)
      (p := ((P.restrictPrimeDivisor S).coeff Q : ℚ))
    rw [hΛQ, hG₀Q, hA'Q, hD₁Q, hD₂Q, hΩ'def, DivisorWithCoeffs.coeff_add,
      DivisorWithCoeffs.coeff_smul, smul_eq_mul, hΩQ,
      Divisor.restrictPrimeDivisor_toQDivisor _ S hPS,
      Divisor.coeff_toQDivisor, hrdef]
    linarith
  have hsubJ := hopsS.2.2.2.2.2.1 _ A' (Λ.restrictPrimeDivisor S) Ω' μS μΩ JS JΩ
    (MMP.Fourfold.isCartier_of_isSmoothScheme hSs A') hA'0 hle hJS hJΩ hunit
  -- the vanishing theorem with reduced boundary `S`, boundary `Λ` and `N`
  obtain ⟨-, -, -, -, -, -, iY₁, iY₂, iY₃, iY₄, -, -, -, Γ, E, F, -, -, -, hJe⟩ := id hJ
  obtain ⟨-, -, -, -, -, -, iS₁, iS₂, iS₃, iS₄, -, -, -, ΓS, ES, FS, -, -, -, hJSe⟩ := id hJS
  have := compactSpace_of_isReducedAdjointIdealOn sX hJ
  have := compactSpace_of_isReducedAdjointIdealOn _ hJS
  have hMc : D₁.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hXs D₁
  have hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ D₁.supp :=
    MMP.Fourfold.map_componentGenericPoint_notMem_supp_of_isDominant μ D₁
  obtain ⟨Mμ, hMμp⟩ := hMc.exists_isPullback (f := μ) hMμ
  have hMS := comp_ι_componentGenericPoint_notMem_supp S D₁ hD₁S μS
  obtain ⟨MS, hMSp⟩ := hMc.exists_isPullback (f := μS ≫ S.idealSheaf.subschemeι) hMS
  have card := (MMP.Fourfold.isReducedAdjointIdealOn_restriction_vanishing sX f hf T Λ μ J
    hJ _ hJe).2 S hTS μ' J' hJ' μS JS hJS _ hJSe
  have hKTN : D₁.LinearlyEquivalent (KX + T + N) := by
    rw [show KX + T + N = D₁ by rw [hNdef]; abel]
  obtain ⟨-, hsurj⟩ := (card.2 N (MMP.Fourfold.isCartier_of_isSmoothScheme hXs N) hNamp n KX hKX D₁
    hMc hKTN hD₁S hMμ Mμ hMμp hMS MS hMSp)
  have hhS : s ∈ MMP.Intersection.multiplierIdealSections μS
      (ES - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor FS) + MS) ⊤ := by
    refine mem_multiplierIdealSections_of_forall sX S hXs hSs D₁ hMc hD₁S μS _ JS
      (fun W => by rw [hJSe]) hMS MS hMSp s fun x => ?_
    obtain ⟨W, hxW, u, hu, j, hj, huj⟩ := exists_mul_eq_of_isCartier
      (MMP.Fourfold.isCartier_of_isSmoothScheme hSs (D₁.restrictPrimeDivisor S)) hs0 x
    exact ⟨W, hxW, huj ▸ Submodule.subset_span ⟨u, hu, j, hsubJ W hj, rfl⟩⟩
  obtain ⟨g, hg, hres'⟩ := hsurj s hhS
  exact ⟨g, mem_sectionsIn_of_mem_multiplierIdealSections sX T Λ μ J _ hJ hJe D₁ hMμ Mμ hMμp g hg,
    hres'⟩

end MMP.Fourfold

end

/-! ### `lem_fourfold_asymptotic_ideal_generation` -/

section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Pointwise Opposite

namespace Proof_lem_fourfold_asymptotic_ideal_generation

open MMP.Mori MMP.Fourfold

/-! ### Log discrepancies under adding a Cartier divisor, and valuative bounds -/

section Toolkit

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **A valuative bound from orders near the centre.** If `ord_Γ(g) ≥ coeff_Γ(C)` along every
prime divisor `Γ` through the centre of `F`, for a Cartier divisor `C` with pull-back `C'`, then
`v_F(g) ≤ exp (-coeff_F(C'))`. -/
private theorem valuation_le_exp_of_isPullback {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) {g : X.functionField}
    (hg : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      Γ.divisorialValuation g ≤ WithZero.exp (-C.coeff Γ)) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      F.valuation g ≤ WithZero.exp (-C'.coeff F.E) := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  rcases eq_or_ne g 0 with rfl | hg0
  · simp
  set x := F.f F.E.genericPoint with hx
  obtain ⟨U, hxU, φ, hφ⟩ := hC x
  let Z0 : irreducibleComponents X := MMP.Mori.pointComponent x
  set h := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions X) with hhdef
  have hh : h ≠ 0 := (φ.isUnit.map _).ne_zero
  have hcoef := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hC' hφ F.E hxU Z0
  have hordh : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → X.ord h Γ.genericPoint = C.coeff Γ := by
    intro Γ hΓ
    rw [hφ Γ ⟨x, hΓ, hxU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
    rw [show Γ.component = Z0 from
      Subsingleton.elim (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents) _ _]
  have hg' : g * h ^ (-1 : ℤ) ≠ 0 := mul_ne_zero hg0 (zpow_ne_zero _ hh)
  have hord : ∀ Γ : MMP.Mori.PrimeDivisor X, x ∈ Γ.support → 0 ≤ X.ord (g * h ^ (-1 : ℤ)) Γ.genericPoint := by
    intro Γ hΓ
    have h1 := hg Γ hΓ
    rw [Γ.divisorialValuation_eq_exp_neg_ord hg0, WithZero.exp_le_exp] at h1
    rw [Scheme.ord_mul hg0 (zpow_ne_zero _ hh), MMP.Mori.ord_zpow _ hh, hordh Γ hΓ]
    omega
  obtain ⟨r, hr⟩ :=
    MMP.Threefold.Mori.Helpers.exists_algebraMap_stalk_eq_of_forall_ord_nonneg x hg' hord
  have hY0 := MMP.Threefold.Mori.Helpers.ord_functionFieldMap_nonneg F hg' r hr
  have hfg : functionFieldMap F.f g ≠ 0 := (map_ne_zero _).mpr hg0
  have hfh : functionFieldMap F.f h ≠ 0 := (map_ne_zero _).mpr hh
  rw [map_mul, map_zpow₀, Scheme.ord_mul hfg (zpow_ne_zero _ hfh), MMP.Mori.ord_zpow _ hfh]
    at hY0
  change F.E.divisorialValuation (functionFieldMap F.f g) ≤ _
  rw [F.E.divisorialValuation_eq_exp_neg_ord hfg, WithZero.exp_le_exp, hcoef, ← hhdef]
  omega

/-- Log discrepancies exist on a smooth variety, at the index `n = dim X`. -/
private theorem exists_isLogDiscrepancy [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) (B : QDivisor X)
    (F : DivisorOver k sX) (hF : IsProper F.f) :
    ∃ a : ℝ, MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) F a := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hP : MMP.Mori.IsPair sX B :=
    ⟨hX, n, K, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK F
  exact ⟨_, MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hF⟩

/-- The pull-back of a Cartier divisor which is effective near the centre of `F` has a
nonnegative coefficient along `F`. -/
private theorem coeff_isPullback_nonneg {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier)
    (hC0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support → 0 ≤ C.coeff Γ) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      0 ≤ C'.coeff F.E := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h1 := valuation_le_exp_of_isPullback (F := F) (hC.zsmul (-1)) (g := 1) (fun Γ hΓ => by
      rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
        ← WithZero.exp_zero, WithZero.exp_le_exp]
      exact hC0 Γ hΓ) _ _ hn
  rw [map_one, DivisorWithCoeffs.coeff_smul, smul_eq_mul, neg_one_mul, neg_neg,
    ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  exact h1

/-- The pull-back of a Cartier divisor whose support misses the centre of `F` has coefficient
zero along `F`. -/
private theorem coeff_isPullback_eq_zero {F : DivisorOver k sX} {C : Divisor X}
    (hC : C.IsCartier) (hx : F.f F.E.genericPoint ∉ C.supp) :
    haveI := F.isLocallyNoetherian
    haveI := F.isNormal
    ∀ (C' : Divisor F.Y) (hCs : ∀ Z : irreducibleComponents F.Y,
        F.f (componentGenericPoint F.Y Z) ∉ C.supp), C.IsPullback F.f hCs C' →
      C'.coeff F.E = 0 := by
  intro C' hCs hC'
  have := F.isIntegral
  have := F.isLocallyNoetherian
  have := F.isNormal
  have := F.isDominant
  have h0 : ∀ Γ : MMP.Mori.PrimeDivisor X, F.f F.E.genericPoint ∈ Γ.support →
      C.coeff Γ = 0 := fun Γ hΓ => by
    by_contra hne
    exact hx (DivisorWithCoeffs.support_subset_supp hne hΓ)
  have h1 := coeff_isPullback_nonneg hC (fun Γ hΓ => (h0 Γ hΓ).ge) C' hCs hC'
  have hn := hC'.zsmul hC (-1)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp F.f _)
  have h2 := coeff_isPullback_nonneg (F := F) (hC.zsmul (-1)) (fun Γ hΓ => by
      rw [DivisorWithCoeffs.coeff_smul, h0 Γ hΓ]; simp) _ _ hn
  rw [DivisorWithCoeffs.coeff_smul, smul_eq_mul] at h2
  omega

/-- The inclusion of an open subscheme `U` is biregular over `U`. -/
private theorem isBiregular_ι_self {W : Scheme.{0}} (U : W.Opens) : IsBiregular U.ι U := by
  have h1 : U.ι ∣_ U = (U.ι ⁻¹ᵁ U).ι := by
    rw [← cancel_mono U.ι, morphismRestrict_ι]
  show IsIso (U.ι ∣_ U)
  rw [h1, U.ι_preimage_self, isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
  change y ∈ Set.range (⊤ : U.toScheme.Opens).ι
  rw [Scheme.Opens.range_ι]
  trivial

/-- On the open `W° = sncComplement T S`, a reduced effective divisor `T` restricts to the sum of
its components containing `S`. -/
private theorem toRDivisor_restrictOpen_sncComplement {W : Scheme.{0}} [IsIntegral W]
    [IsLocallyNoetherian W] [IsNormal W] {T : Divisor W}
    (hT : MMP.Intersection.IsReducedEffective T) (S : Set W) :
    QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen (sncComplement T S)) =
      Divisor.toRDivisor (inverseTransformDivisor (sncComplement T S).ι
        (MMP.Intersection.reducedDivisorOf (sncIndexSet T S))) := by
  classical
  set U := sncComplement T S
  have hbireg : ∀ y : U.toScheme, U.ι y ∈ biregularLocus U.ι :=
    fun y => le_biregularLocus (isBiregular_ι_self U) y.2
  refine Finsupp.ext fun F => ?_
  set P := OpenWeilRestriction.primeDivisorMap U.ι F with hPdef
  have hinv : inverseTransformPrimeDivisor U.ι P = some F :=
    MMP.Threefold.Resolution.inverseTransformPrimeDivisor_eq_some_of_map_genericPoint
      (OpenWeilRestriction.genericPoint_primeDivisorMap U.ι F).symm (hbireg _)
  have huniq : ∀ P'', inverseTransformPrimeDivisor U.ι P'' = some F → P'' = P := by
    intro P'' hP''
    have h1 := (MMP.Threefold.Resolution.map_genericPoint_of_inverseTransformPrimeDivisor_eq_some
      hP'').1
    apply AlgebraicGeometry.PrimeDivisor.genericPoint_injective
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact h1.symm
  have e1 : (QDivisor.toRDivisor ((Divisor.toQDivisor T).restrictOpen U)) F =
      ((T P : ℤ) : ℝ) := by
    change (((T P : ℤ) : ℚ) : ℝ) = _
    push_cast; rfl
  have e2 : (Divisor.toRDivisor (inverseTransformDivisor U.ι
      (MMP.Intersection.reducedDivisorOf (sncIndexSet T S)))) F =
      (((MMP.Intersection.reducedDivisorOf (sncIndexSet T S)) P : ℤ) : ℝ) := by
    change ((DivisorWithCoeffs.mapPrimeDivisors (inverseTransformPrimeDivisor U.ι) _ F : ℤ) : ℝ) = _
    rw [MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq hinv huniq]
  rw [e1, e2]
  congr 1
  have hc' := MMP.Intersection.coeff_reducedDivisorOf (sncIndexSet T S) P
  rw [DivisorWithCoeffs.coeff_apply] at hc'
  rw [hc']
  have hPU : P.genericPoint ∈ U := by
    rw [hPdef, OpenWeilRestriction.genericPoint_primeDivisorMap]
    exact F.genericPoint.2
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hmem : ∀ E ∈ T.support, ¬ S ⊆ E.support → P.genericPoint ∉ E.support := by
    have : P.genericPoint ∈ (sncComplement T S : Set W) := hPU
    simpa [sncComplement] using this
  by_cases hPT : P ∈ T.support
  · have hPJ : P ∈ sncIndexSet T S := by
      refine Finset.mem_filter.2 ⟨hPT, ?_⟩
      by_contra hZP
      exact hmem P hPT hZP hPmem
    rw [if_pos hPJ]
    have hT1 : T.coeff P = 1 := (hT P).resolve_left (Finsupp.mem_support_iff.1 hPT)
    rw [DivisorWithCoeffs.coeff_apply] at hT1
    exact hT1
  · have hPJ : P ∉ sncIndexSet T S := fun h => hPT (Finset.mem_filter.1 h).1
    rw [if_neg hPJ]
    exact Finsupp.notMem_support_iff.1 hPT

open Classical in
/-- **Zero places of a reduced snc pair have strata as centres.** If `Δ` is a reduced snc
divisor on a smooth variety and `a(F, X, Δ) = 0`, then the centre of `F` is a stratum of `Δ`;
hence its generic point lies outside every closed set containing no stratum of `Δ`. -/
private theorem notMem_of_isLogDiscrepancy_eq_zero [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) {Δ : Divisor X}
    (hΔ : IsReducedSNC sX Δ) {T : Set X} (hT : IsClosed T) (hns : ContainsNoStratum Δ T)
    {n : ℕ} {F : DivisorOver k sX}
    (h0 : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) F 0) :
    F.f F.E.genericPoint ∉ T := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hF : IsProper F.f := h0.2.1
  set x := F.f F.E.genericPoint with hxdef
  have hn := MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq h0
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K (Divisor.toQDivisor Δ) :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPW.isPair hK F
  have h0' : MMP.Intersection.IsLogDiscrepancy sX n
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) F 0 := by
    rwa [QDivisor.toRDivisor_toQDivisor]
  have hc1 : (0 : ℝ) = 1 + c :=
    MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc h0'
  set Z := F.center with hZdef
  have hZx : (Z : Set X) = closure {x} := F.center_eq_closure_genericPoint
  have hxZ : x ∈ (Z : Set X) := by rw [hZx]; exact subset_closure rfl
  have hsuppZ : ∀ E : MMP.Mori.PrimeDivisor X, x ∈ E.support → (Z : Set X) ⊆ E.support := by
    intro E hxE
    rw [hZx, AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E] at hxE
    exact closure_minimal (Set.singleton_subset_iff.mpr hxE) isClosed_closure
  set U := sncComplement Δ (Z : Set X) with hUdef
  have hxU : x ∈ U := by
    change x ∈ (sncComplement Δ (Z : Set X) : Set X)
    simp only [sncComplement]
    simp only [TopologicalSpace.Opens.coe_mk, Set.mem_compl_iff, Set.mem_iUnion,
      Finset.mem_filter, not_exists, not_and]
    intro E hE hxE
    exact hE.2 (hsuppZ E hxE)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  obtain ⟨hYU, hfU, E', -, hvU, hiff⟩ :=
    MMP.Mori.DivisorOver.exists_restrict_isDiscrepancy_iff hPW F U ⟨x, hxZ, hxU⟩
  have hcU := (hiff c).1 hc
  haveI : IsProper F.f := hF
  have hpU : IsProper (F.f ∣_ U) := inferInstance
  have hLU := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hcU hpU
  rw [toRDivisor_restrictOpen_sncComplement hΔ.1, ← hc1] at hLU
  have hcen : MMP.Intersection.IsCentre k sX F.valuation Z := ⟨F, hF, rfl, rfl⟩
  have he : IsReducedSNCDiscrepancy sX Δ F.valuation 0 :=
    ⟨hX.1, hsm, hΔ.1, hΔ.2, Z, hcen, ⟨⟨x, hxU⟩⟩, n, _, hpU, hvU, hLU⟩
  -- the codimension of the centre
  obtain ⟨m₀, z₀, j₀, hz₀, -, -⟩ := hΔ.2.2 x
  have hcx : Order.coheight x = m₀ := by
    have := (ringKrullDim_stalk_eq_coheight x).symm.trans hz₀.2
    exact_mod_cast this
  have hc₀ : codimension Z = m₀ := by
    rw [hZdef, MMP.Positivity.DivisorOver.codimension_center, hcx]
  have hsub := IsReducedSNCDiscrepancy.sub_card_sncIndexSet_le he hcen hc₀
  set J := sncIndexSet Δ (Z : Set X) with hJdef
  have hcJ : m₀ ≤ J.card := by
    have : (m₀ : ℝ) ≤ J.card := by linarith
    exact_mod_cast this
  -- the centre is a stratum
  have hstr : IsSNCStratum Δ (Z : Set X) := by
    refine ⟨J, Finset.filter_subset _ _, ⟨Z.isIrreducible, ?_⟩, ?_⟩
    · intro z hz
      simp only [Set.mem_iInter]
      intro E hE
      exact (Finset.mem_filter.1 hE).2 hz
    · rintro T' ⟨hT'irr, hT'sub⟩ hZT'
      have hWsub : closure T' ⊆ ⋂ E ∈ J, (E.support : Set X) := by
        refine closure_minimal hT'sub (isClosed_biInter fun E _ => ?_)
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E]
        exact isClosed_closure
      obtain ⟨w, hw⟩ := QuasiSober.sober hT'irr.closure isClosed_closure
      have hxw : w ⤳ x := hw.specializes (subset_closure (hZT' hxZ))
      have hwmem : w ∈ closure T' := hw.mem
      obtain ⟨mw, zw, jw, hzw, hjw, -⟩ := hΔ.2.2 w
      have hJw : J.card ≤ mw := by
        let ι : J → Fin mw := fun E => jw ⟨E.1, (Finset.mem_filter.1 E.2).1, by
          have := hWsub hwmem
          simp only [Set.mem_iInter] at this
          exact this E.1 E.2⟩
        have hι : Function.Injective ι := by
          intro E₁ E₂ h
          have h' := congrArg Subtype.val (hjw h)
          exact Subtype.ext (by simpa using h')
        simpa using Fintype.card_le_of_injective ι hι
      have hcw : Order.coheight w = mw := by
        have := (ringKrullDim_stalk_eq_coheight w).symm.trans hzw.2
        exact_mod_cast this
      have hwx : w = x := by
        by_contra hne
        have hlt : x < w := lt_of_le_not_ge hxw (fun h => hne (hxw.antisymm h).eq)
        have h1 := Order.coheight_add_one_le hlt
        rw [hcw, hcx] at h1
        have h2 : mw + 1 ≤ m₀ := by exact_mod_cast h1
        omega
      have hcl : closure T' = (Z : Set X) := by
        rw [← hw.def, hwx, hZx]
      exact (subset_closure).trans hcl.le
  intro hxT
  refine hns _ hstr ?_
  rw [hZx]
  exact hT.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hxT)

end Toolkit

/-- The `ℚ`-pull-back of `D` vanishes along prime divisors lying over the complement of
`Supp D`. -/
private theorem coeff_qIsPullback_eq_zero {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (hX : IsNormalVariety k sX) (hsm : MMP.Mori.IsSmoothScheme sX) (μ : Y ⟶ X) [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (hY : IsNormalVariety k (μ ≫ sX))
    (hμ : IsBirationalMorphism μ) {D : QDivisor X}
    {hD : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ D.supp}
    {F : QDivisor Y} (hF : D.IsPullback μ hD F) (P : MMP.Mori.PrimeDivisor Y)
    (hP : μ P.genericPoint ∉ D.supp) : F.coeff P = 0 := by
  obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
  have hsupp : D₀.supp = D.supp :=
    QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hmD.ne') hD₀
  have h1 := coeff_isPullback_eq_zero (F := ⟨Y, μ, hY, hμ, P⟩) hD₀c
    (by rw [hsupp]; exact hP) D₀' _ hD₀'
  have h2 := congrArg (fun G : QDivisor Y => G.coeff P) hD₀'eq
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul,
    Int.cast_natCast] at h2
  change D₀'.coeff P = 0 at h1
  rw [h1, Int.cast_zero] at h2
  have hmD0 : (mD : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
  exact (mul_eq_zero.mp h2.symm).resolve_left hmD0

/-! ### The adjoint ideal on a given log resolution -/

section Main

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- An snc closed subset of a smooth scheme is the union of the components of an snc divisor. -/
private theorem exists_finset_of_isSNCSubset [LocallyOfFinitePresentation sX]
    (hsm : IsSmoothScheme sX) {S : Closeds X} (h : IsSNCSubset sX S) :
    ∃ s : Finset (MMP.Mori.PrimeDivisor X), (⋃ E ∈ s, E.support) = (S : Set X) ∧
      DivisorWithCoeffs.IsSNC sX (∑ E ∈ s, Finsupp.single E (1 : ℤ)) := by
  rcases h with h | h
  · refine ⟨∅, by simp [h], ?_⟩
    simpa using DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme (R := ℤ) sX hsm
  · exact h

/-- A prime divisor of a proper birational model which is not exceptional and whose centre lies
off `Supp B` has log discrepancy `1` with respect to `B`. -/
private theorem isLogDiscrepancy_one_of_notMem [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    (B : QDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (hexc : P.genericPoint ∉ (exceptionalSet μ : Set Y))
    (hB : μ P.genericPoint ∉ (DivisorWithCoeffs.supp (QDivisor.toRDivisor B) : Set X)) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨K, hK⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme sX hsm hn
  have hPW : MMP.Mori.IsPairWith sX n K B :=
    ⟨hX, hK, MMP.Fourfold.isQCartier_of_isSmoothScheme hsm _⟩
  set FP : DivisorOver k sX := ⟨Y, μ, hY, hμ, P⟩ with hFPdef
  have hPmem : P.genericPoint ∈ P.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hne : ¬ FP.IsExceptional := fun hexc' =>
    hexc (MMP.Positivity.support_subset_exceptionalSet P hexc' hPmem)
  obtain ⟨Q, hQc, hQd⟩ := MMP.Mori.DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPW FP hne
  have hηQ : μ P.genericPoint = Q.genericPoint := by
    have e1 := FP.center_eq_closure_genericPoint
    rw [hQc, AlgebraicGeometry.PrimeDivisor.support_eq_closure Q] at e1
    exact (inseparable_iff_closure_eq.mpr e1.symm).eq
  have hQmem : Q.genericPoint ∈ Q.support := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl
  have hQ0 : B.coeff Q = 0 := by
    by_contra hne'
    apply hB
    rw [hηQ]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero]) hQmem
  rw [hQ0, neg_zero] at hQd
  have hl := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hQd hμp
  convert hl using 1
  simp

/-- **Log discrepancy one off the snc divisor of a log resolution.** Let `μ : Y → X` be a proper
birational model and `s` the components of `Exc(μ) ∪ μ⁻¹ Supp(Δ + D)`, for `Δ` reduced and `D`
effective. A prime divisor `P ∉ s` of `Y` has log discrepancy `1` for `(X, Δ)` and `(X, Δ + D)`. -/
private theorem isLogDiscrepancy_one_of_notMem_finset [PerfectField k] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {n : ℕ} (hn : topologicalKrullDim X = n) {Δ : Divisor X}
    (hΔ : MMP.Intersection.IsReducedEffective Δ) {D : QDivisor X} (hD0 : ∀ P, 0 ≤ D.coeff P)
    {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {μ : Y ⟶ X}
    (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ) (hμp : IsProper μ)
    {s : Finset (MMP.Mori.PrimeDivisor Y)}
    (hs : (⋃ E ∈ s, E.support) = ((exceptionalSet μ ⊔ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D))).preimage μ.continuous : Closeds Y) : Set Y))
    {P : MMP.Mori.PrimeDivisor Y} (hPs : P ∉ s) :
    MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ 1 ∧
      MMP.Intersection.IsLogDiscrepancy sX n
        (Divisor.toRDivisor Δ + QDivisor.toRDivisor D) ⟨Y, μ, hY, hμ, P⟩ 1 := by
  have hnot : P.genericPoint ∉ (⋃ E ∈ s, E.support) := by
    intro hz
    obtain ⟨E', hE's, hPE'⟩ := Set.mem_iUnion₂.mp hz
    exact hPs (by rwa [← MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hPE'])
  rw [hs, Closeds.coe_sup, Set.mem_union, not_or] at hnot
  obtain ⟨hexc, hsupp⟩ := hnot
  have hsuppΔ : μ P.genericPoint ∉ (DivisorWithCoeffs.supp
      (QDivisor.toRDivisor (Divisor.toQDivisor Δ)) : Set X) := by
    intro hmem
    apply hsupp
    obtain ⟨Γ', hΓ', hxΓ'⟩ := DivisorWithCoeffs.mem_supp_iff.mp hmem
    refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨Γ', ?_, hxΓ'⟩
    rw [QDivisor.coeff_toRDivisor, Divisor.coeff_toQDivisor] at hΓ'
    rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
    have : (0 : ℝ) ≤ ((D.coeff Γ' : ℚ) : ℝ) := by exact_mod_cast hD0 Γ'
    rcases hΔ Γ' with h | h
    · rw [h] at hΓ'; simp at hΓ'
    · rw [h]; push_cast; linarith
  have h0 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsuppΔ
  have h1 := isLogDiscrepancy_one_of_notMem sX hX hsm hn hY hμ hμp _ P hexc hsupp
  rw [QDivisor.toRDivisor_toQDivisor] at h0
  rw [map_add, QDivisor.toRDivisor_toQDivisor] at h1
  exact ⟨h0, h1⟩

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- A variety has finite dimension. -/
private theorem exists_topologicalKrullDim_eq [IsIntegral X] (hX : MMP.Mori.IsVariety k sX) :
    ∃ n : ℕ, topologicalKrullDim X = n := by
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  refine ⟨(Stacks.Chow.relativeDimension (Stacks.Chow.fieldChowSituation k).dimensionFunction sX
    (genericPoint X)).toNat, ?_⟩
  rw [← Stacks.Chow.topologicalKrullDim_closure_singleton_eq k sX (genericPoint X)]
  have h : closure ({genericPoint X} : Set X) = Set.univ := (genericPoint_spec X).def
  exact (IsHomeomorph.topologicalKrullDim_eq _
    ((Homeomorph.setCongr h).trans (Homeomorph.Set.univ X)).isHomeomorph).symm

/-- The adjoint ideal computed on a given projective log resolution of `Δ + D`. -/
private theorem exists_isReducedAdjointIdealOn_of_isLogResolution [IsAlgClosed k] [CharZero k]
    (Δ : Divisor X) (D : QDivisor X) (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX)
    (hΔ : IsReducedSNC sX Δ) (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    {Y : Scheme.{0}} (μ : Y ⟶ X) (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ) :
    ∃ J : X.Opens → Set X.functionField, IsReducedAdjointIdealOn sX Δ D μ J := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have h1 := hlog.toIsLogResolution
  have hres := h1.toIsSmoothResolution
  obtain ⟨hY, -, -⟩ := hres.isNormalVariety hX
  haveI : IsIntegral Y := hres.isIntegral
  haveI : IsNormal Y := hres.isNormal
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (μ ≫ sX)
  have hμ := hres.isBirationalMorphism
  haveI : IsDominant μ := hμ.isDominant
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (μ ≫ sX)
  obtain ⟨m, hm, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  have hD : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ D.supp := by
    intro Z
    rw [← QDivisor.supp_eq_of_toQDivisor_eq (by exact_mod_cast hm.ne') hD₀]
    exact MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ D₀ Z
  have hF := QDivisor.isPullback_pullback (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D) hD
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  have hex : ∀ P : MMP.Mori.PrimeDivisor Y, ∃ a₀ : ℕ,
      MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ) ⟨Y, μ, hY, hμ, P⟩ a₀ := by
    intro P
    obtain ⟨a, ha⟩ := exists_isLogDiscrepancy hX hsm hn (Divisor.toQDivisor Δ)
      ⟨Y, μ, hY, hμ, P⟩ hres.isProper
    rw [QDivisor.toRDivisor_toQDivisor] at ha
    obtain ⟨a₀, rfl⟩ :=
      MMP.Intersection.IsLogDiscrepancy.exists_nat_eq_of_isSNC sX hX.1 hsm hΔ.1 hΔ.2 ha
    exact ⟨a₀, ha⟩
  choose a₀ ha₀ using hex
  have hsmY : IsSmoothScheme (μ ≫ sX) := hres.isSmoothScheme
  obtain ⟨s, hs, -⟩ := exists_finset_of_isSNCSubset (μ ≫ sX) hsmY hlog.isSNCSubset
  have hout : ∀ P, P ∉ s → a₀ P = 1 := fun P hPs => by
    exact_mod_cast MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P)
      (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hres.isProper hs hPs).1
  let Γ : Divisor Y := Finsupp.ofSupportFinite (fun P => if a₀ P = 0 then (1 : ℤ) else 0)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hout P hPs]))
  have hΓc : ∀ P, Γ.coeff P = if a₀ P = 0 then 1 else 0 := fun P => rfl
  let E : Divisor Y := Finsupp.ofSupportFinite (fun P => (a₀ P : ℤ) - 1 + Γ.coeff P)
    ((Finset.finite_toSet s).subset fun P hP => by
      by_contra hPs
      exact hP (by simp [hΓc, hout P hPs]))
  have hEc : ∀ P, E.coeff P = (a₀ P : ℤ) - 1 + Γ.coeff P := fun P => rfl
  refine ⟨_, hX, hsm, hΔ, hD0, hDns, hlog, inferInstance, inferInstance, inferInstance,
    inferInstance, hY, hμ, hD, Γ, E, _, ⟨fun P => ?_, fun P => ?_⟩, fun P => ?_, hF, rfl⟩
  · rw [hΓc]; split_ifs <;> simp
  · rw [hΓc]
    constructor
    · intro h
      split_ifs at h with h0
      · exact ⟨n, by rw [← Nat.cast_zero (R := ℝ), ← h0]; exact ha₀ P⟩
      · simp at h
    · rintro ⟨n', hn'⟩
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (ha₀ P) hn'
      have h0 : a₀ P = 0 := by exact_mod_cast this
      simp [h0]
  · refine ⟨n, a₀ P, ha₀ P, ?_⟩
    rw [hEc]
    push_cast
    ring

end Main

/-! ### Twisting a push-forward by a Cartier divisor -/

section Twist

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- The preimage of a nonempty open under a dominant morphism is nonempty. -/
private theorem preimage_eq_bot_iff (μ : Y ⟶ X) [IsDominant μ] (U : X.Opens) :
    μ ⁻¹ᵁ U = ⊥ ↔ U = ⊥ := by
  refine ⟨fun h => by_contra fun hU => ?_, fun h => by simp [h]⟩
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).1 hU
  obtain ⟨_, hx', ⟨x', rfl⟩⟩ := μ.denseRange.inter_open_nonempty U U.isOpen ⟨x, hx⟩
  have hmem : x' ∈ μ ⁻¹ᵁ U := hx'
  rw [h] at hmem
  exact hmem

/-- **The projection formula on sections.** If `φ` is a local equation of the Cartier divisor
`M` on `V` and `μ^*M` its pull-back, then over an open `U ⊆ V` a rational function `g` is a
section of `μ_*𝒪_Y(G + μ^*M)` exactly when `φ g` is a section of `μ_*𝒪_Y(G)`. -/
private theorem mem_multiplierIdealSections_add_iff {μ : Y ⟶ X} [IsDominant μ] {M : Divisor X}
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (h : M.IsPullback μ hM Mμ) {V : X.Opens} {φ : (RationalFunctions X)ˣ}
    (hφ : M.IsLocalEquation V φ) (Z : irreducibleComponents X) (G : Divisor Y) {U : X.Opens}
    (hUV : U ≤ V) (g : X.functionField) :
    g ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) U ↔
      MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) * g ∈
        MMP.Intersection.multiplierIdealSections μ G U := by
  set c := MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) with hc
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hval : ∀ P : MMP.Mori.PrimeDivisor Y, (P.support ∩ μ ⁻¹ᵁ U).Nonempty →
      P.valuationOver μ c = WithZero.exp (-Mμ.coeff P) := by
    intro P hP
    have hU : μ P.genericPoint ∈ V :=
      hUV (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP)
    rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h hφ P hU Z,
      PrimeDivisor.valuationOver_apply,
      P.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr hc0)]
  constructor
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => by rw [h0 hU, mul_zero], fun P hP => ?_⟩
    rw [map_mul, hval P hP]
    have := hg P hP
    rw [DivisorWithCoeffs.coeff_add] at this
    calc WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g ≤
          WithZero.exp (-Mμ.coeff P) * WithZero.exp (G.coeff P + Mμ.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P) := by rw [← WithZero.exp_add]; congr 1; ring
  · rintro ⟨h0, hg⟩
    refine ⟨fun hU => (mul_eq_zero.mp (h0 hU)).resolve_left hc0, fun P hP => ?_⟩
    have := hg P hP
    rw [map_mul, hval P hP] at this
    rw [DivisorWithCoeffs.coeff_add]
    calc P.valuationOver μ g = WithZero.exp (Mμ.coeff P) *
          (WithZero.exp (-Mμ.coeff P) * P.valuationOver μ g) := by
          rw [← mul_assoc, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero, one_mul]
      _ ≤ WithZero.exp (Mμ.coeff P) * WithZero.exp (G.coeff P) := by gcongr
      _ = WithZero.exp (G.coeff P + Mμ.coeff P) := by rw [← WithZero.exp_add, add_comm]

/-- Sections of `μ_*𝒪_Y(G)` restrict to smaller nonempty opens. -/
private theorem multiplierIdealSections_mono (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U W : X.Opens} (hWU : W ≤ U) (hW : W ≠ ⊥) {g : X.functionField}
    (hg : g ∈ MMP.Intersection.multiplierIdealSections μ G U) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G W :=
  ⟨fun h => absurd ((preimage_eq_bot_iff μ W).1 h) hW,
    fun P hP => hg.2 P (hP.mono (Set.inter_subset_inter_right _ fun _ hy => hWU hy))⟩

/-- Membership in `μ_*𝒪_Y(G)(U)` is local on `U`: it suffices on a neighbourhood `W x ⊆ U` of
every point `x ∈ U`. -/
private theorem mem_multiplierIdealSections_of_local (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U : X.Opens} (W : X → X.Opens) (hW : ∀ x ∈ U, x ∈ W x ∧ W x ≤ U) {g : X.functionField}
    (h0 : U = ⊥ → g = 0)
    (hg : ∀ x ∈ U, g ∈ MMP.Intersection.multiplierIdealSections μ G (W x)) :
    g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  refine ⟨fun h => h0 ((preimage_eq_bot_iff μ U).1 h), fun P hP => ?_⟩
  have hx := MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP
  refine (hg _ hx).2 P (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem P ?_)
  exact (hW _ hx).1

/-- **Twisting is determined by the untwisted push-forward.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections, so do `μ_*𝒪_Y(G + μ^*M)` and
`μ'_*𝒪_{Y'}(G' + μ'^*M)`, for a Cartier divisor `M` of `X`. -/
private theorem multiplierIdealSections_add_pullback_congr {Y' : Scheme.{0}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] {μ : Y ⟶ X} {μ' : Y' ⟶ X} [IsDominant μ]
    [IsDominant μ'] {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {hM' : ∀ Z : irreducibleComponents Y', μ' (componentGenericPoint Y' Z) ∉ M.supp}
    {Mμ : Divisor Y} {Mμ' : Divisor Y'} (h : M.IsPullback μ hM Mμ)
    (h' : M.IsPullback μ' hM' Mμ') {G : Divisor Y} {G' : Divisor Y'}
    (hG : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ' (G' + Mμ') := by
  choose V hxV φ hφ using hMc
  let Z : irreducibleComponents X := pointComponent (genericPoint X)
  have key : ∀ {Y₁ : Scheme.{0}} [IsIntegral Y₁] [IsLocallyNoetherian Y₁] [IsNormal Y₁]
      (μ₁ : Y₁ ⟶ X) [IsDominant μ₁]
      {hM₁ : ∀ Z : irreducibleComponents Y₁, μ₁ (componentGenericPoint Y₁ Z) ∉ M.supp}
      {M₁ : Divisor Y₁} (h₁ : M.IsPullback μ₁ hM₁ M₁) (G₁ : Divisor Y₁) (U : X.Opens)
      (g : X.functionField),
      g ∈ MMP.Intersection.multiplierIdealSections μ₁ (G₁ + M₁) U ↔
        (U = ⊥ → g = 0) ∧ ∀ x ∈ U,
          MMP.Threefold.Mori.Helpers.evalFF Z (φ x : RationalFunctions X) * g ∈
            MMP.Intersection.multiplierIdealSections μ₁ G₁ (U ⊓ V x) := by
    intro Y₁ _ _ _ μ₁ _ hM₁ M₁ h₁ G₁ U g
    have hne : ∀ x ∈ U, U ⊓ V x ≠ ⊥ := fun x hx =>
      (Opens.ne_bot_iff_nonempty _).2 ⟨x, hx, hxV x⟩
    constructor
    · intro hg
      refine ⟨fun hU => hg.1 ((preimage_eq_bot_iff μ₁ U).2 hU), fun x hx => ?_⟩
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).1
        (multiplierIdealSections_mono μ₁ _ inf_le_left (hne x hx) hg)
    · rintro ⟨h0, hg⟩
      refine mem_multiplierIdealSections_of_local μ₁ _ (fun x => U ⊓ V x)
        (fun x hx => ⟨⟨hx, hxV x⟩, inf_le_left⟩) h0 fun x hx => ?_
      exact (mem_multiplierIdealSections_add_iff h₁ (hφ x) Z G₁ inf_le_right g).2 (hg x hx)
  funext U
  ext g
  rw [key μ h G U g, key μ' h' G' U g, hG]

end Twist

/-! ### Push-forwards of divisorial sheaves as subsheaves of `K(X)` -/

section PushforwardIso

variable {X : Scheme.{0}} [IsIntegral X]

/-- On an irreducible scheme every irreducible component is the whole space. -/
private theorem eq_univ_of_irreducibleComponents' {Y : Scheme.{0}} [IrreducibleSpace Y]
    (Z : irreducibleComponents Y) : Z.1 = Set.univ :=
  Set.eq_univ_of_univ_subset (Z.2.2 (IrreducibleSpace.isIrreducible_univ Y) (Set.subset_univ _))

/-- The rational function of a section of `𝒦_Y` over `W`, read at a component meeting `W`. -/
private noncomputable def evFF {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Y.functionField :=
  (Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom (φ Z)

private theorem index_eq {Y : Scheme.{0}} [IrreducibleSpace Y] {W : Y.Opens}
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Z = Z' :=
  Subtype.ext (Subtype.ext ((eq_univ_of_irreducibleComponents' _).trans
    (eq_univ_of_irreducibleComponents' _).symm))

private theorem stalkSpecializes_genericPoint_injective {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) :
    Function.Injective (Y.presheaf.stalkSpecializes
      ((genericPoint_spec Y).specializes trivial :
        genericPoint Y ⤳ componentGenericPoint Y Z)).hom := by
  intro a b h
  have hsp : componentGenericPoint Y Z ⤳ genericPoint Y :=
    (Inseparable.of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z)).specializes
  have := congrArg (Y.presheaf.stalkSpecializes hsp).hom h
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_comp_apply,
    TopCat.Presheaf.stalkSpecializes_refl] at this
  exact this

/-- The section of `𝒦_Y` over `W` with a given rational function. -/
private noncomputable def ofFF {Y : Scheme.{0}} [IsIntegral Y] (W : Y.Opens)
    (g : Y.functionField) : ToType ((rationalFunctionsPresheaf Y).obj (op W)) :=
  fun Z => (Y.presheaf.stalkSpecializes
    (Inseparable.of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z.1)).specializes).hom g

private theorem evFF_ofFF {Y : Scheme.{0}} [IsIntegral Y] (W : Y.Opens) (g : Y.functionField)
    (Z) : evFF (ofFF W g) Z = g := by
  rw [evFF, ofFF, TopCat.Presheaf.stalkSpecializes_comp_apply,
    TopCat.Presheaf.stalkSpecializes_refl]
  rfl

private theorem ofFF_evFF {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    ofFF W (evFF φ Z) = φ := by
  funext Z'
  obtain rfl := index_eq Z Z'
  apply stalkSpecializes_genericPoint_injective Z.1
  change evFF (ofFF W (evFF φ Z)) Z = evFF φ Z
  rw [evFF_ofFF]

/-- `OrdGE` in terms of the divisorial valuation of the rational function. -/
private theorem ordGE_iff_divisorialValuation_le {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y) (n : ℤ)
    (s : Y.presheaf.stalk (componentGenericPoint Y E.component)) :
    E.OrdGE n s ↔ E.divisorialValuation
      ((Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s) ≤
        WithZero.exp (-n) := by
  have hv : E.valuation s = (E.divisorialValuation
      ((Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s))⁻¹ := by
    rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
      MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
    rfl
  rw [MMP.Mori.PrimeDivisor.OrdGE, hv]
  set x := (Y.presheaf.stalkSpecializes ((genericPoint_spec Y).specializes trivial)).hom s
  have h0 : s = 0 ↔ x = 0 :=
    ⟨fun h => by simp [x, h], fun h => (injective_iff_map_eq_zero' _).1
      (stalkSpecializes_genericPoint_injective E.component) s |>.1 h⟩
  rw [h0]
  rcases eq_or_ne x 0 with hx | hx
  · simp [hx]
  · have hvx : E.divisorialValuation x ≠ 0 := (map_ne_zero _).2 hx
    simp only [hx, false_or]
    rw [← WithZero.exp_log hvx, ← WithZero.exp_neg, WithZero.exp_le_exp, WithZero.exp_le_exp]
    omega

/-- A section of `𝒦_Y` over `μ⁻¹U` is a section of `𝒪_Y(G)` exactly when its rational function
lies in `μ_*𝒪_Y(G)(U)`. -/
private theorem mem_divisorialSubmodule_iff_mem_multiplierIdealSections {Y : Scheme.{0}}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ]
    (G : Divisor Y) (U : X.Opens) (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U))))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U})
    (g : X.functionField) (hg : functionFieldMap μ g = evFF σ Z) :
    σ ∈ G.divisorialSubmodule (μ ⁻¹ᵁ U) ↔
      g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  have hne : μ ⁻¹ᵁ U ≠ ⊥ := (Opens.ne_bot_iff_nonempty _).2 ⟨_, Z.2⟩
  rw [Divisor.mem_divisorialSubmodule]
  constructor
  · intro h
    refine ⟨fun h' => absurd h' hne, fun P hP => ?_⟩
    have := (ordGE_iff_divisorialValuation_le P _ _).1 (h P hP)
    rw [neg_neg] at this
    rw [PrimeDivisor.valuationOver_apply, hg]
    obtain rfl : (⟨P.component, P.componentGenericPoint_mem_of_nonempty hP⟩ :
      {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) = Z := index_eq _ _
    exact this
  · rintro ⟨-, h⟩ P hP
    rw [ordGE_iff_divisorialValuation_le, neg_neg]
    have := h P hP
    rw [PrimeDivisor.valuationOver_apply, hg] at this
    obtain rfl : (⟨P.component, P.componentGenericPoint_mem_of_nonempty hP⟩ :
      {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) = Z := index_eq _ _
    exact this

private theorem germ_stalkCongr_hom_apply' {X : TopCat.{0}} (F : X.Presheaf CommRingCat.{0})
    {U : Opens X} {x y : X} (h : Inseparable x y) (hx : x ∈ U) (hy : y ∈ U) (a : F.obj (op U)) :
    (F.stalkCongr h).hom (F.germ U x hx a) = F.germ U y hy a := by
  simp only [TopCat.Presheaf.stalkCongr_hom]
  exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _

/-- The index of the unique component of an integral scheme, in an open containing the generic
point. -/
private noncomputable def topIndex (Y : Scheme.{0}) [IsIntegral Y] {W : Y.Opens}
    (h : genericPoint Y ∈ W) : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W} :=
  ⟨⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩, by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]; exact h⟩

private theorem genericPoint_mem_of_index {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    genericPoint Y ∈ W := by
  have := Z.2; rwa [MMP.Fourfold.componentGenericPoint_eq_genericPoint] at this

/-- The rational function of `r • σ`. -/
private theorem evFF_smul {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens} (r : Γ(Y, W))
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF (r • φ) Z = Y.presheaf.germ W (genericPoint Y) (genericPoint_mem_of_index Z) r *
      evFF φ Z := by
  rw [evFF, rationalFunctions_smul_apply, map_mul]
  congr 1
  exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _

private theorem evFF_add {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ ψ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF (φ + ψ) Z = evFF φ Z + evFF ψ Z :=
  map_add _ _ _

private theorem evFF_map {Y : Scheme.{0}} [IsIntegral Y] {W W' : Y.Opensᵒᵖ} (j : W ⟶ W')
    (φ : ToType ((rationalFunctionsPresheaf Y).obj W))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W'.unop}) :
    evFF (W := W'.unop) ((rationalFunctionsPresheaf Y).map j φ) Z =
      evFF (W := W.unop) φ ⟨Z.1, j.unop.le Z.2⟩ := rfl

variable {Y Y' : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
  [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']

/-- The section of `𝒦_{Y'}` over `μ'⁻¹U` with the same rational function (through
`K(Y) ≅ K(X) ≅ K(Y')`) as a section of `𝒦_Y` over `μ⁻¹U`. -/
private noncomputable def transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (U : X.Opens)
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U)))) :
    ToType ((rationalFunctionsPresheaf Y').obj (op (μ' ⁻¹ᵁ U))) :=
  fun Z' => ofFF (μ' ⁻¹ᵁ U) (functionFieldMap μ' (e.symm (evFF σ (topIndex Y (by
    have h := genericPoint_mem_of_index Z'
    change μ' (genericPoint Y') ∈ U at h
    rw [map_genericPoint_of_isDominant] at h
    change μ (genericPoint Y) ∈ U
    rw [map_genericPoint_of_isDominant]; exact h))))) Z'

private theorem evFF_transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (U : X.Opens)
    (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U))))
    (Z' : {Z : irreducibleComponents Y' // componentGenericPoint Y' Z ∈ μ' ⁻¹ᵁ U})
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) :
    evFF (transferFF μ μ' e U σ) Z' = functionFieldMap μ' (e.symm (evFF σ Z)) := by
  rw [show transferFF μ μ' e U σ = ofFF (μ' ⁻¹ᵁ U) (functionFieldMap μ' (e.symm (evFF σ Z))) by
    funext Z''
    simp only [transferFF]
    rw [index_eq (topIndex Y _) Z]]
  exact evFF_ofFF _ _ _

private theorem eq_of_evFF_eq {W : Y.Opens} {φ ψ : ToType ((rationalFunctionsPresheaf Y).obj (op W))}
    (h : ∀ Z, evFF φ Z = evFF ψ Z) : φ = ψ := by
  funext Z
  rw [← ofFF_evFF φ Z, ← ofFF_evFF ψ Z, h Z]

private theorem genericPoint_mem_preimage_of_index (μ : Y ⟶ X) [IsDominant μ] {U : X.Opens}
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ μ ⁻¹ᵁ U}) :
    genericPoint X ∈ U := by
  have h := genericPoint_mem_of_index Z
  change μ (genericPoint Y) ∈ U at h
  rwa [map_genericPoint_of_isDominant] at h

private theorem genericPoint_mem_preimage (μ : Y ⟶ X) [IsDominant μ] {U : X.Opens}
    (h : genericPoint X ∈ U) : genericPoint Y ∈ μ ⁻¹ᵁ U := by
  change μ (genericPoint Y) ∈ U
  rwa [map_genericPoint_of_isDominant]

private theorem transferFF_mem (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) (U : X.Opens)
    (σ : G.divisorialSubmodule (μ ⁻¹ᵁ U)) :
    transferFF μ μ' e U σ.1 ∈ G'.divisorialSubmodule (μ' ⁻¹ᵁ U) := by
  by_cases hU : genericPoint X ∈ U
  · let Z := topIndex Y (genericPoint_mem_preimage μ hU)
    let Z' := topIndex Y' (genericPoint_mem_preimage μ' hU)
    rw [mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ' G' U _ Z'
      (e.symm (evFF σ.1 Z)) (evFF_transferFF μ μ' e U σ.1 Z' Z).symm]
    refine h U ((mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ G U _ Z
      (e.symm (evFF σ.1 Z)) ?_).1 σ.2)
    rw [← he, RingEquiv.apply_symm_apply]
  · intro E hE
    exact absurd (genericPoint_mem_preimage_of_index μ'
      ⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩) hU

/-- The components over `U` of `pushforwardHomOfLE`. -/
private noncomputable def pushforwardHomOfLEApp (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) (U : X.Opensᵒᵖ) :
    ((Scheme.Modules.pushforward μ).obj G.divisorialSheaf).val.obj U ⟶
      ((Scheme.Modules.pushforward μ').obj G'.divisorialSheaf).val.obj U :=
  ConcreteCategory.ofHom
    { toFun := fun σ => ⟨transferFF μ μ' e U.unop σ.1, transferFF_mem μ μ' e he G G' h U.unop σ⟩
      map_add' := fun a b => Subtype.ext (eq_of_evFF_eq fun Z' => by
        let Z := topIndex Y (genericPoint_mem_preimage μ (genericPoint_mem_preimage_of_index μ' Z'))
        change evFF (transferFF μ μ' e U.unop (a.1 + b.1)) Z' =
          evFF (transferFF μ μ' e U.unop a.1 + transferFF μ μ' e U.unop b.1) Z'
        rw [evFF_add, evFF_transferFF μ μ' e _ _ Z' Z, evFF_transferFF μ μ' e _ _ Z' Z,
          evFF_transferFF μ μ' e _ _ Z' Z, evFF_add, map_add, map_add])
      map_smul' := fun r a => Subtype.ext (eq_of_evFF_eq fun Z' => by
        have hX := genericPoint_mem_preimage_of_index μ' Z'
        let Z := topIndex Y (genericPoint_mem_preimage μ hX)
        change evFF (transferFF μ μ' e U.unop (μ.app U.unop r •
            (show ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U.unop))) from a.1))) Z' =
          evFF (μ'.app U.unop r • transferFF μ μ' e U.unop a.1) Z'
        rw [evFF_smul, evFF_transferFF μ μ' e _ _ Z' Z, evFF_transferFF μ μ' e _ _ Z' Z,
          evFF_smul,
          ← MMP.Fourfold.functionFieldMap_germ μ U.unop hX (genericPoint_mem_preimage μ hX)
            (show Γ(X, U.unop) from r),
          ← MMP.Fourfold.functionFieldMap_germ μ' U.unop hX (genericPoint_mem_preimage μ' hX)
            (show Γ(X, U.unop) from r),
          ← he, map_mul e.symm, RingEquiv.symm_apply_apply, map_mul]) }

/-- The morphism `μ_*𝒪_Y(G) ⟶ μ'_*𝒪_{Y'}(G')` which is the identity on rational functions, when
the sections of the first are among those of the second. -/
private noncomputable def pushforwardHomOfLE (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ]
    [IsDominant μ'] (e : X.functionField ≃+* Y.functionField)
    (he : ∀ g, e g = functionFieldMap μ g) (G : Divisor Y) (G' : Divisor Y')
    (h : ∀ U, MMP.Intersection.multiplierIdealSections μ G U ⊆
      MMP.Intersection.multiplierIdealSections μ' G' U) :
    (Scheme.Modules.pushforward μ).obj G.divisorialSheaf ⟶
      (Scheme.Modules.pushforward μ').obj G'.divisorialSheaf :=
  ⟨{ app U := pushforwardHomOfLEApp μ μ' e he G G' h U
     naturality := fun {U V} i => by
      ext a
      refine Subtype.ext (eq_of_evFF_eq fun Z' => ?_)
      have hX := genericPoint_mem_preimage_of_index μ' Z'
      change evFF (transferFF μ μ' e V.unop
          ((rationalFunctionsPresheaf Y).map ((Opens.map μ.base).op.map i) a.1)) Z' =
        evFF ((rationalFunctionsPresheaf Y').map ((Opens.map μ'.base).op.map i)
          (transferFF μ μ' e U.unop a.1)) Z'
      rw [evFF_map, evFF_transferFF μ μ' e _ _ Z' (topIndex Y (genericPoint_mem_preimage μ hX)),
        evFF_transferFF μ μ' e _ _ _ (topIndex Y (genericPoint_mem_preimage μ (i.unop.le hX))),
        evFF_map]
      rfl }⟩

private theorem transferFF_transferFF (μ : Y ⟶ X) (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ']
    (e : X.functionField ≃+* Y.functionField) (he : ∀ g, e g = functionFieldMap μ g)
    (e' : X.functionField ≃+* Y'.functionField) (he' : ∀ g, e' g = functionFieldMap μ' g)
    (U : X.Opens) (σ : ToType ((rationalFunctionsPresheaf Y).obj (op (μ ⁻¹ᵁ U)))) :
    transferFF μ' μ e' U (transferFF μ μ' e U σ) = σ := by
  refine eq_of_evFF_eq fun Z => ?_
  have hX := genericPoint_mem_preimage_of_index μ Z
  let Z' := topIndex Y' (genericPoint_mem_preimage μ' hX)
  rw [evFF_transferFF μ' μ e' U _ Z Z', evFF_transferFF μ μ' e U σ Z' Z, ← he',
    RingEquiv.symm_apply_apply, ← he, RingEquiv.apply_symm_apply]

/-- **Push-forwards of divisorial sheaves are determined by their sections.** If `μ_*𝒪_Y(G)` and
`μ'_*𝒪_{Y'}(G')` have the same sections in `K(X)` over every open, for birational `μ`, `μ'`, then
they are isomorphic `𝒪_X`-modules. -/
private theorem nonempty_iso_pushforward_of_multiplierIdealSections_eq (μ : Y ⟶ X)
    (μ' : Y' ⟶ X) [IsDominant μ] [IsDominant μ'] (hμ : Function.Bijective (functionFieldMap μ))
    (hμ' : Function.Bijective (functionFieldMap μ')) (G : Divisor Y) (G' : Divisor Y')
    (h : MMP.Intersection.multiplierIdealSections μ G =
      MMP.Intersection.multiplierIdealSections μ' G') :
    Nonempty ((Scheme.Modules.pushforward μ).obj G.divisorialSheaf ≅
      (Scheme.Modules.pushforward μ').obj G'.divisorialSheaf) := by
  let e := RingEquiv.ofBijective (functionFieldMap μ) hμ
  let e' := RingEquiv.ofBijective (functionFieldMap μ') hμ'
  have he : ∀ g, e g = functionFieldMap μ g := fun _ => rfl
  have he' : ∀ g, e' g = functionFieldMap μ' g := fun _ => rfl
  refine ⟨{ hom := pushforwardHomOfLE μ μ' e he G G' (fun U => h ▸ subset_rfl)
            inv := pushforwardHomOfLE μ' μ e' he' G' G (fun U => h ▸ subset_rfl)
            hom_inv_id := ?_
            inv_hom_id := ?_ }⟩
  · refine Scheme.Modules.hom_ext _ _ fun U => ?_
    ext a
    exact Subtype.ext (transferFF_transferFF μ μ' e he e' he' U a.1)
  · refine Scheme.Modules.hom_ext _ _ fun U => ?_
    ext a
    exact Subtype.ext (transferFF_transferFF μ' μ e' he' e he U a.1)

end PushforwardIso

/-! ### A log resolution which is an isomorphism away from `Supp D` -/

section GoodResolution

open MMP.Resolution

open MMP.Threefold.Mori.OpenRestriction in
/-- The restriction of an snc divisor to an open subscheme is snc. -/
private theorem isSNC_restrictOpen {R : Type*} [Zero R] {X Y : Scheme.{0}} (g : X ⟶ Y)
    [∀ E : MMP.Mori.PrimeDivisor X, LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ g)]
    {D : DivisorWithCoeffs R X} (hD : D.IsSNC g) (U : X.Opens) :
    (D.restrictOpen U).IsSNC (U.ι ≫ g) := by
  refine ⟨fun E₀ hE₀ => ?_, fun x => (sncStalk_restrict_iff U.ι D x).mpr (hD.2 (U.ι x))⟩
  have hsm := hD.1 (OpenWeilRestriction.primeDivisorMap U.ι E₀)
    (Finsupp.mem_support_iff.2 (Finsupp.mem_support_iff.1 hE₀ : D.restrictOpen U E₀ ≠ 0))
  rw [IsSmoothScheme, smoothLocus_eq_smoothLocus] at hsm
  exact (isSmoothScheme_comap_iff U.ι g (OpenWeilRestriction.primeDivisorMap U.ι E₀).idealSheaf
    E₀.idealSheaf (idealSheaf_comap_primeDivisorMap U.ι E₀)).mpr fun z _ => hsm ▸ trivial

/-- On the complement of `Supp D`, the union of the components of `Δ + D` is that of `Δ`. -/
private theorem preimage_sup_support_eq {X : Scheme.{0}} (Δ : Divisor X) (D : QDivisor X)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hΔ : ∀ P, 0 ≤ Δ.coeff P) :
    Scheme.Opens.ι (X := X) D.supp.compl ⁻¹' ((Divisor.toQDivisor Δ + D).support.sup
        fun E => (E.idealSheaf.support : Set X)) =
      Scheme.Opens.ι (X := X) D.supp.compl ⁻¹' (Δ.support.sup fun E => (E.idealSheaf.support : Set X)) := by
  classical
  ext y
  simp only [Set.mem_preimage, Finset.sup_set_eq_biUnion, Set.mem_iUnion, Finsupp.mem_support_iff,
    exists_prop]
  have hy : Scheme.Opens.ι (X := X) D.supp.compl y ∉ D.supp := y.2
  constructor
  · rintro ⟨E, hE, hyE⟩
    refine ⟨E, fun h0 => hE ?_, hyE⟩
    have hDE : D E = 0 := by
      by_contra h
      exact hy (DivisorWithCoeffs.mem_supp_iff.2 ⟨E, h, hyE⟩)
    change ((Δ E : ℤ) : ℚ) + D E = 0
    rw [h0, hDE]; simp
  · rintro ⟨E, hE, hyE⟩
    refine ⟨E, fun h0 => ?_, hyE⟩
    have h1 : ((Δ E : ℤ) : ℚ) + D E = 0 := h0
    have h2 := hD0 E
    have h3 : (0 : ℚ) ≤ ((Δ E : ℤ) : ℚ) := by exact_mod_cast hΔ E
    have : ((Δ E : ℤ) : ℚ) = 0 := by
      change (0 : ℚ) ≤ D E at h2
      linarith
    exact hE (by exact_mod_cast this)

/-- The preimage in an open `U` of the union of the components of `Δ` is the union of the
components of `Δ|_U`. -/
private theorem preimage_sup_support_eq_restrictOpen {R : Type*} [Zero R] {X : Scheme.{0}}
    (Δ : DivisorWithCoeffs R X) (U : X.Opens) :
    U.ι ⁻¹' (Δ.support.sup fun E => (E.idealSheaf.support : Set X)) =
      ⋃ F ∈ (Δ.restrictOpen U).support, (F.support : Set U.toScheme) := by
  classical
  ext y
  simp only [Set.mem_preimage, Finset.sup_set_eq_biUnion, Set.mem_iUnion, Finsupp.mem_support_iff,
    exists_prop]
  constructor
  · rintro ⟨E, hE, hyE⟩
    obtain ⟨F, rfl⟩ := MMP.Threefold.Mori.OpenRestriction.exists_primeDivisorMap_eq_of_mem_support U.ι E y hyE
    exact ⟨F, hE, (MMP.Threefold.Mori.OpenRestriction.mem_support_primeDivisorMap_iff U.ι F y).1 hyE⟩
  · rintro ⟨F, hF, hyF⟩
    exact ⟨_, hF, (MMP.Threefold.Mori.OpenRestriction.mem_support_primeDivisorMap_iff U.ι F y).2 hyF⟩

/-- **A log resolution of `Δ + D` which is an isomorphism over `X ∖ Supp D`**, for `Δ` snc on the
smooth `X`, and projective over `X` when `X` carries an ample invertible sheaf. -/
private theorem exists_isLogResolution_isIso_compl_supp {k : Type} [Field k] [CharZero k]
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) {Δ : Divisor X} (hΔ : IsReducedSNC sX Δ) (D : QDivisor X)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M]
    (hM : Stacks.Ample.IsAmple X M) :
    ∃ (Y : Scheme.{0}) (μ : Y ⟶ X), MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ ∧
      IsIso (μ ∣_ D.supp.compl) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  set B := Divisor.toQDivisor Δ + D with hB
  obtain ⟨Y, μ, hres, hpure, hsnc, hiso⟩ :=
    MMP.Resolution.exists_isLogResolution_isIso_restrict_of_isSNCClosedSubset sX hX B.support
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hres.isVariety_source
  haveI : LocallyOfFiniteType (μ ≫ sX) := hres.isVariety_source.toLocallyOfFiniteType
  haveI : QuasiCompact (μ ≫ sX) := hres.isVariety_source.toQuasiCompact
  haveI : AlgebraicGeometry.IsNoetherian Y := isNoetherian_of_locallyOfFiniteType (μ ≫ sX)
  haveI : IsProper μ := hres.isProjective.isProper
  refine ⟨Y, μ, ⟨⟨⟨inferInstance, hres.isBirationalMorphism, hres.isSmoothScheme⟩, hpure, ?_⟩,
    isProjectiveMorphism_of_isProjective μ M hM hres.isProjective⟩, ?_⟩
  · refine MMP.Resolution.isSNCSubset_of_isSNCClosedSubset _ ?_
    convert hsnc using 1
    rw [Closeds.coe_sup, QDivisor.supp_toRDivisor]
    congr 1
    change μ ⁻¹' (B.supp : Set X) = _
    simp [DivisorWithCoeffs.supp, Closeds.coe_finset_sup]
  · refine hiso _ ?_ ?_
    · haveI : LocallyOfFinitePresentation sX :=
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := sX)).mpr inferInstance
      haveI : Smooth sX := (MMP.Mori.isSmoothScheme_iff sX).1 hsm
      haveI : LocallyOfFinitePresentation (Scheme.Opens.ι (X := X) D.supp.compl ≫ sX) :=
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType
          (f := Scheme.Opens.ι (X := X) D.supp.compl ≫ sX)).mpr inferInstance
      exact (MMP.Mori.isSmoothScheme_iff _).2 inferInstance
    · rw [preimage_sup_support_eq Δ D hD0 (fun P => by
        rcases hΔ.1 P with h | h <;> simp [h])]
      haveI : ∀ E : MMP.Mori.PrimeDivisor X,
          LocallyOfFinitePresentation (E.idealSheaf.subschemeι ≫ sX) := fun E =>
        (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := E.idealSheaf.subschemeι ≫ sX)).mpr
          inferInstance
      have h1 := isSNC_restrictOpen sX hΔ.2 D.supp.compl
      have h2 := MMP.Fourfold.SNCWeight.PrimeDivisorUnion.isSNCClosedSubset_of_isSNC _ h1
      convert h2 using 1
      exact preimage_sup_support_eq_restrictOpen Δ _

end GoodResolution

/-! ### Relative ampleness of Cartier divisors -/

section AmpleTools

open RingedSpaceModuleAdjunction Stacks.Ample Stacks.RelativeVeryAmple

/-- The ringed-space pull-back of a module along a morphism of schemes is the scheme pull-back. -/
private noncomputable def modulePullbackIso {X Y : Scheme.{0}} (f : X ⟶ Y) (F : Y.Modules) :
    (modulePullback f.toLRSHom.toShHom).obj F ≅ (Scheme.Modules.pullback f).obj F :=
  (Adjunction.leftAdjointUniq (modulePullbackPushforwardAdjunction f.toLRSHom.toShHom)
    (Scheme.Modules.pullbackPushforwardAdjunction f)).app F

/-- For a quasi-compact morphism, `f`-ampleness gives ampleness over every affine open. -/
private theorem stacks_of_isRelativelyAmple {X S : Scheme.{0}} (f : X ⟶ S) [QuasiCompact f]
    (L : X.Modules) [IsInvertibleModule X L] (hL : MMP.Mori.IsRelativelyAmple f L) :
    Stacks.RelativeAmple.IsRelativelyAmple f L :=
  Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_of_forall_exists_isAmple f L inferInstance hL

/-- `𝒪_Y(mA) ≅ 𝒪_Y(A)^{⊗ m}` for a Cartier divisor `A`. -/
private noncomputable def divisorialSheafNsmulIso {V : Scheme.{0}} [IsLocallyNoetherian V]
    [IsNormal V] [CompactSpace V] {A : Divisor V} (hA : A.IsCartier) (m : ℕ) :
    haveI := hA.isInvertibleModule_divisorialSheaf
    (m • A).divisorialSheaf ≅ Stacks.Ample.tensorPowModule V A.divisorialSheaf (m : ℤ) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  induction m with
  | zero =>
    exact eqToIso (by rw [zero_smul]) ≪≫ Divisor.divisorialSheafZeroIso ≪≫
      (Stacks.Ample.tensorPowModuleZeroIso V A.divisorialSheaf).symm
  | succ n ih =>
    exact eqToIso (by rw [succ_nsmul]) ≪≫
      ((hA.nsmul n).divisorialSheafTensorIso hA).symm ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso ih).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso V A.divisorialSheaf).symm ≪≫
      Stacks.Ample.tensorPowModuleAddIso V A.divisorialSheaf (n : ℤ) 1 ≪≫
      eqToIso (by push_cast; rfl)

/-- **[Stacks, Tag 0C4K] for Cartier divisors.** Let `f : X ⟶ Y` and `g : Y ⟶ S` be
quasi-compact, `S` quasi-compact, `L` an `f`-ample Cartier divisor on `X` and `M` a `g`-ample
Cartier divisor on `Y` with pull-back `M' = f^*M`. Then `L + nM'` is `(f ≫ g)`-ample for all
large `n`. -/
private theorem exists_isRelativelyAmple_add_nsmul {X Y S : Scheme.{0}}
    [IsIntegral X] [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace S]
    (f : X ⟶ Y) (g : Y ⟶ S) [QuasiCompact f] [QuasiCompact g]
    {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    {M : Divisor Y} (hM : M.IsCartier) (hMg : M.IsRelativelyAmple g hM)
    {hB : ∀ Z : irreducibleComponents X, f (componentGenericPoint X Z) ∉ M.supp}
    {M' : Divisor X} (hM' : M.IsPullback f hB M') :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      (L + n • M').IsRelativelyAmple (f ≫ g) (hL.add ((hM'.isCartier hM).nsmul n)) := by
  have hM'c := hM'.isCartier hM
  haveI := hL.isInvertibleModule_divisorialSheaf
  haveI := hM.isInvertibleModule_divisorialSheaf
  haveI := hM'c.isInvertibleModule_divisorialSheaf
  obtain ⟨n₀, hn₀⟩ := Stacks.AmplePullbackDatum.exists_threshold_isRelativelyAmple_comp f g _ _
    (stacks_of_isRelativelyAmple f _ hLf) (stacks_of_isRelativelyAmple g _ hMg)
  refine ⟨n₀, fun n hn => ?_⟩
  haveI := (hL.add (hM'c.nsmul n)).isInvertibleModule_divisorialSheaf
  have eB : (modulePullback f.toLRSHom.toShHom).obj M.divisorialSheaf ≅ M'.divisorialSheaf :=
    modulePullbackIso f _ ≪≫ (hM'.divisorialSheafIso (hBc := hM)).symm
  have e : Stacks.AmplePullbackPart1.tensorPullbackPowModule f L.divisorialSheaf
      M.divisorialSheaf n ≅ (L + n • M').divisorialSheaf :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
        (Stacks.RelativeVeryAmple.pullbackTensorPowModuleIso f _ n ≪≫
          Stacks.RelativeVeryAmple.tensorPowModuleIsoOfIso X _ _ eB n ≪≫
          (divisorialSheafNsmulIso hM'c n).symm) ≪≫
      hL.divisorialSheafTensorIso (hM'c.nsmul n)
  exact MMP.Mori.IsRelativelyAmple.of_stacks _ _
    ((Stacks.RelativeVeryAmple.isRelativelyAmple_congr _ _ _ e).mp (hn₀ n hn))

end AmpleTools

/-! ### Serre's theorem for relatively ample Cartier divisors -/

section SerreTwist

open Stacks.Ample Stacks.RelativeVeryAmple MMP.Flips

private theorem exists_affine_nonvanishing_tensor {X : Scheme.{0}} (G P N : X.Modules)
    [IsInvertibleModule X G] [IsInvertibleModule X P] [IsInvertibleModule X N]
    (e : tensorModules X G P ≅ N)
    (t : G.sections) (s : Γ(P, ⊤)) (U : X.Opens)
    (hUs : (U : Set X) = nonvanishingLocus _ s) (hU : IsAffineOpen U) {x : X}
    (hxt : x ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ t)
    (hxU : x ∈ U) :
    ∃ f : Γ(N, ⊤), x ∈ nonvanishingLocus _ f ∧
        IsAffineOpen (Stacks.NonvanishingOpen.nonvanishingOpen X _ f) := by
  set s₀ := Stacks.SheafOfModules.sectionsOfTop _ s
  set v := SheafOfModules.sectionsMap e.hom (tensorSections G _ t s₀)
  have h2 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) G t ↔
      z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := fun z =>
    Set.ext_iff.1 (Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X G t) z
  have h1 : ∀ z : X, z ∈ Stacks.SheafOfModules.nonvanishingLocus (X := X.toRingedSpace) _ s₀ ↔
      z ∈ U := fun z => by
    rw [Stacks.AmpleBridge.nonvanishingLocus_sectionsOfTop, ← hUs]
    rfl
  have hmem : ∀ z : X,
      z ∈ nonvanishingLocus N (v.eval (Opposite.op ⊤)) ↔
      z ∈ U ∧ z ∈ Stacks.NonvanishingOpen.nonvanishingOpen X G (t.eval (Opposite.op ⊤)) := by
    intro z
    rw [← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval]
    exact (nonvanishingLocus_iso e (tensorSections G _ t s₀) z).trans
      ((tensorSections_nonvanishing_iff t s₀ z).trans (and_comm.trans (and_congr (h1 z) (h2 z))))
  refine ⟨v.eval (Opposite.op ⊤), (hmem x).2 ⟨hxU, (h2 x).1 hxt⟩, ?_⟩
  convert Stacks.NonvanishingAffineIntersection.isAffineOpen_inf_nonvanishingOpen
    (M := G) (s := t.eval (Opposite.op ⊤)) hU using 1
  ext z
  exact hmem z

/-- `(M ⊗ L^{⊗ j}) ⊗ L^{⊗ k} ≅ M ⊗ L^{⊗ (j + k)}`. -/
private noncomputable def splitIso {X : Scheme.{0}} (L M : X.Modules) [IsInvertibleModule X L]
    (j k : ℕ) :
    tensorModules X (tensorModules X M (tensorPowModule X L (j : ℤ)))
      (tensorPowModule X L (k : ℤ)) ≅ tensorModules X M (tensorPowModule X L ((j + k : ℕ) : ℤ)) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    tensorModulesMapIso X (Iso.refl _)
      (tensorPowModuleAddIso X _ (j : ℤ) (k : ℤ) ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))

/-- If `L` is ample and `M` is invertible, then `M ⊗ L^{⊗ m}` is ample for `m ≫ 0`. -/
private theorem eventually_isAmple_tensorModules_tensorPowModule {X : Scheme.{0}}
    (L M : X.Modules) [IsInvertibleModule X L] [IsInvertibleModule X M] (hL : IsAmple X L) :
    ∀ᶠ m : ℕ in Filter.atTop, IsAmple X (tensorModules X M (tensorPowModule X L (m : ℤ))) := by
  have : SheafOfModules.IsFiniteType.{0, 0, 0} M :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hL).2 M inferInstance inferInstance
  haveI : CompactSpace X := hL.1
  choose k hk s U hUs hxU hUaff using hL.2
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun x : X ↦ ((U x : X.Opens) : Set X))
    (fun x ↦ (U x).isOpen) (fun x _ ↦ Set.mem_iUnion.2 ⟨x, hxU x⟩)
  refine Filter.eventually_atTop.2 ⟨T.sup k + n₀.toNat, fun m hm => ?_⟩
  refine Stacks.Ample.isAmple_of_forall_exists_affine_nonvanishingLocus _ fun x => ?_
  obtain ⟨y, hyT, hxy⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ x))
  have hsup : k y ≤ T.sup k := Finset.le_sup hyT
  obtain ⟨j, rfl⟩ : ∃ j, m = j + k y := ⟨m - k y, by omega⟩
  obtain ⟨σ, -⟩ := hn₀ j (by omega)
  set G := tensorModules X M (tensorPowModule X L (j : ℤ))
  haveI : SheafOfModules.IsInvertible X.toRingedSpace.presheaf
      (structureSheafRing X.toRingedSpace).property G :=
    Stacks.SheafOfModules.Invertible.tensorProduct_isInvertible X.presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf X) _ _
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X M
    (tensorPowModule X L (j : ℤ))
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ i.hom :=
    @IsIso.epi_of_iso _ _ _ _ i.hom i.isIso_hom
  obtain ⟨a, ha⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing G (σ.ofEpi i.hom) x
  exact exists_affine_nonvanishing_tensor G _ _ (splitIso L M j (k y)) _ (s y) (U y) (hUs y)
    (hUaff y) ha hxy

/-- The pull-back of `𝒪_Y(nH + F)` along `f : X ⟶ Y` is `f^*𝒪_Y(F) ⊗ (f^*𝒪_Y(H))^{⊗ n}`, for
Cartier divisors `H` and `F`. -/
private theorem nonempty_modulePullback_divisorialSheaf_nsmul_add_iso {X Y : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (f : X ⟶ Y) {H F : Divisor Y}
    (hH : H.IsCartier) (hF : F.IsCartier) (n : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
        (n • H + F).divisorialSheaf ≅
      tensorModules X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          F.divisorialSheaf)
        (tensorPowModule X ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj
          H.divisorialSheaf) (n : ℤ))) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  set P := RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom
  induction n with
  | zero =>
    exact ⟨eqToIso (by rw [zero_smul, zero_add]) ≪≫
      (Stacks.TensorSheafSpellingIso.tensorModulesRightUnitor X _).symm ≪≫
      tensorModulesMapIso X (Iso.refl _) (tensorPowModuleZeroIso X _).symm⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨eqToIso (by rw [succ_nsmul, add_right_comm]) ≪≫
      P.mapIso (((hH.nsmul n).add hF).divisorialSheafTensorIso hH).symm ≪≫
      pullbackTensorModulesIso f _ _ ≪≫
      tensorModulesMapIso X e (tensorPowModuleOneIso X _).symm ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      tensorModulesMapIso X (Iso.refl _)
        (tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫ tensorPowModuleCongr X _ (by push_cast; ring))⟩

/-- If `H` is an `g`-ample Cartier divisor and `F` is any Cartier divisor, then `mH + F` is
`g`-ample for `m ≫ 0`, provided the base is quasi-compact. -/
private theorem eventually_isRelativelyAmpleCartier_nsmul_add {Y Z : Scheme.{0}}
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] [CompactSpace Z] (g : Y ⟶ Z)
    [QuasiCompact g] {H F : Divisor Y} (hH : IsRelativelyAmpleCartier g H) (hF : F.IsCartier) :
    ∀ᶠ m : ℕ in Filter.atTop, IsRelativelyAmpleCartier g (m • H + F) := by
  obtain ⟨hHc, hHa⟩ := hH
  haveI := hHc.isInvertibleModule_divisorialSheaf
  haveI := hF.isInvertibleModule_divisorialSheaf
  choose V' hVa hzV _ using fun z : Z =>
    exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover (fun z : Z ↦ ((V' z : Z.Opens) : Set Z))
    (fun z ↦ (V' z).isOpen) (fun z _ ↦ Set.mem_iUnion.2 ⟨z, hzV z⟩)
  have hev : ∀ v ∈ T, ∀ᶠ m : ℕ in Filter.atTop,
      haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
      IsAmple (g ⁻¹ᵁ V' v).toScheme
        ((RingedSpaceModuleAdjunction.modulePullback
          (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom).obj (m • H + F).divisorialSheaf) := by
    intro v _
    let W := (g ⁻¹ᵁ V' v).toScheme
    let P := RingedSpaceModuleAdjunction.modulePullback (g ⁻¹ᵁ V' v).ι.toLRSHom.toShHom
    haveI hPF : IsInvertibleModule W (P.obj F.divisorialSheaf) := inferInstance
    haveI hPH : IsInvertibleModule W (P.obj H.divisorialSheaf) := inferInstance
    filter_upwards [eventually_isAmple_tensorModules_tensorPowModule (P.obj H.divisorialSheaf)
      (P.obj F.divisorialSheaf) (hHa _ (hVa v))]
      with m hm
    haveI := ((hHc.nsmul m).add hF).isInvertibleModule_divisorialSheaf
    obtain ⟨e⟩ := nonempty_modulePullback_divisorialSheaf_nsmul_add_iso (g ⁻¹ᵁ V' v).ι hHc hF m
    exact (@isAmple_congr _ _ _ inferInstance
      (@Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules _ _ _ inferInstance
        (isInvertibleModule_tensorPowModule _ _ _)) e).2 hm
  filter_upwards [(Filter.eventually_all_finset T).2 hev] with m hm
  have hc := (hHc.nsmul m).add hF
  haveI := hc.isInvertibleModule_divisorialSheaf
  refine ⟨hc, ((Stacks.RelativeAmpleLocalOnBase.isRelativelyAmple_iff_exists_affine_isAmple_cover
    g _ inferInstance).2 fun z => ?_).2⟩
  obtain ⟨v, hvT, hzv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ z))
  exact ⟨V' v, hVa v, hzv, hm v hvT⟩

end SerreTwist

/-! ### Bridges between the notions of relative ampleness -/

section AmpleBridges

open Stacks.Ample

/-- `f`-ampleness of a Cartier divisor gives ampleness over every affine open of the base. -/
private theorem isRelativelyAmpleCartier_of_isRelativelyAmple {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) [QuasiCompact f]
    {L : Divisor X} (hL : L.IsCartier) (h : L.IsRelativelyAmple f hL) :
    MMP.Flips.IsRelativelyAmpleCartier f L := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  exact ⟨hL, (stacks_of_isRelativelyAmple f _ h).2⟩

/-- Ampleness over every affine open of the base gives `f`-ampleness. -/
private theorem isRelativelyAmple_of_isRelativelyAmpleCartier {X S : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ S) {L : Divisor X}
    (h : MMP.Flips.IsRelativelyAmpleCartier f L) : L.IsRelativelyAmple f h.choose := by
  obtain ⟨hL, hamp⟩ := h
  intro y
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
  exact ⟨V, hV, hyV, hamp V hV⟩

/-- An ample Cartier divisor on `X` is ample relative to `g : X ⟶ Z'` for affine `Z'`. -/
private theorem isRelativelyAmple_of_isAmple_of_isAffine {X Z' : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] (g : X ⟶ Z') [IsAffine Z']
    {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple g hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro z
  refine ⟨⊤, isAffineOpen_top Z', trivial, ?_⟩
  haveI : IsIso (g ⁻¹ᵁ ⊤).ι := by
    rw [Scheme.Hom.preimage_top]
    exact (Scheme.topIso X).isIso_hom
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffineHom (g ⁻¹ᵁ ⊤).ι
    A.divisorialSheaf hamp

/-- An ample Cartier divisor on `X` is ample relative to the identity of `X`. -/
private theorem isRelativelyAmple_id_of_isAmple {X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {A : Divisor X} (hA : A.IsCartier)
    (hamp : haveI := hA.isInvertibleModule_divisorialSheaf; IsAmple X A.divisorialSheaf) :
    A.IsRelativelyAmple (𝟙 X) hA := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  intro x
  obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  refine ⟨V, hV, hxV, ?_⟩
  haveI : IsAffine ((𝟙 X) ⁻¹ᵁ V).toScheme := by
    rw [Scheme.Hom.id_preimage]; exact hV
  exact Stacks.AmplePullback.isAmple_modulePullback_of_isAffine ((𝟙 X) ⁻¹ᵁ V).ι
    A.divisorialSheaf hamp

end AmpleBridges

/-! ### Divisors of rational top forms -/

section TopForms

/-- The unit of `K(Y)` (as rational functions) with a given nonzero value in the function field. -/
private noncomputable def unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    (h : Y.functionField) (hh : h ≠ 0) : (RationalFunctions Y)ˣ :=
  (IsUnit.map (Pi.ringHom fun Z : irreducibleComponents Y => (Y.presheaf.stalkSpecializes
    (Inseparable.of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z)).specializes).hom)
    (isUnit_iff_ne_zero.2 hh)).unit

private theorem evalFF_unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    (h : Y.functionField) (hh : h ≠ 0) (Z : irreducibleComponents Y) :
    MMP.Threefold.Mori.Helpers.evalFF Z (unitOfFunctionField h hh : RationalFunctions Y) = h := by
  change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.stalkSpecializes _).hom h) = h
  rw [TopCat.Presheaf.stalkSpecializes_comp_apply, TopCat.Presheaf.stalkSpecializes_refl]
  rfl

private theorem coeff_principalDivisor_unitOfFunctionField {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y] (h : Y.functionField) (hh : h ≠ 0)
    (P : MMP.Mori.PrimeDivisor Y) :
    (MMP.Mori.principalDivisor (unitOfFunctionField h hh)).coeff P = Y.ord h P.genericPoint := by
  rw [MMP.Mori.coeff_principalDivisor, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord,
    evalFF_unitOfFunctionField]

/-- **The divisor of a nonzero rational top form is a canonical divisor**, on a normal variety over
a perfect field which has a canonical divisor: it differs from a canonical divisor `div(ω₁)` by
the principal divisor of `τ/ω₁`. -/
private theorem isCanonicalDivisor_divisorOfForm {k : Type} [Field k] [PerfectField k]
    {Y : Scheme.{0}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [CompactSpace Y] [LocallyOfFiniteType sY] (hY : IsNormalVariety k sY) {n : ℕ}
    {K₁ : Divisor Y} (hK₁ : K₁.IsCanonicalDivisor sY n) {τ : RationalPluriForms sY n 1}
    (hτ : τ ≠ 0) : (divisorOfForm τ).IsCanonicalDivisor sY n := by
  obtain ⟨ω₁, hω₁0, hω₁⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hY hK₁
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY)
    hK₁.topologicalKrullDim_eq
  letI := functionFieldAlgebra sY
  obtain ⟨b⟩ := exists_basis_topForms (sX := sY) hK₁.topologicalKrullDim_eq
  set c := (ZTensorPower.basis b 1).repr τ () with hc
  set c₁ := (ZTensorPower.basis b 1).repr ω₁ () with hc₁
  have hc0 : c ≠ 0 := repr_ne_zero_of_ne_zero b hτ
  have hc₁0 : c₁ ≠ 0 := repr_ne_zero_of_ne_zero b hω₁0
  have hq : c / c₁ ≠ 0 := div_ne_zero hc0 hc₁0
  refine hK₁.of_linearlyEquivalent ⟨unitOfFunctionField (c / c₁) hq, ?_⟩
  ext P
  obtain ⟨NP, hNP⟩ := P.exists_ordForm_eq_ord_add_mul hd b
  rw [DivisorWithCoeffs.coeff_sub, coeff_divisorOfForm, ← hω₁ P,
    coeff_principalDivisor_unitOfFunctionField, hNP 1 τ hτ, hNP 1 ω₁ hω₁0, div_eq_mul_inv,
    Scheme.ord_mul hc0 (inv_ne_zero hc₁0), ← zpow_neg_one, MMP.Mori.ord_zpow _ hc₁0]
  ring

end TopForms

/-! ### Cohomology along a morphism with vanishing higher direct images -/

section Leray

attribute [local instance] HasDerivedCategory.standard
attribute [local instance 2000] HomotopyCategory.Plus.instHasPointwiseRightDerivedFunctorQuasiIso

/-- **Leray collapse.** If the higher direct images of `M` along `π : Y ⟶ X` vanish, the
vanishing of the higher cohomology of `M` on `Y` gives that of `π_* M` on `X`. -/
private theorem isZero_rightDerived_pushforward_of_isZero {X Y : Scheme.{0}} (π : Y ⟶ X)
    (M : Y.Modules)
    (hR : ∀ j : ℕ, 0 < j → IsZero (((Scheme.Modules.pushforward π).rightDerived j).obj M))
    (hY : ∀ i : ℕ, 0 < i →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y).rightDerived i).obj M))
    (i : ℕ) (hi : 0 < i) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward π).obj M)) := by
  have hM : (Scheme.Modules.pushforward π).rightAcyclic M :=
    (Stacks.DerivedIndexing.rightAcyclic_iff_forall_nat _ M).2 hR
  have e := Stacks.Cohomology.AffineComparison.restrictScalarsRightDerivedIso π M i ≪≫
    Stacks.Cohomology.AffineComparison.rightDerivedCollapseIso (Scheme.Modules.pushforward π)
      (Stacks.Cohomology.AffineBase.moduleGlobalSections X)
      (Stacks.Cohomology.AffineComparison.rightAcyclic_moduleGlobalSections_pushforward_obj π)
      M hM i
  refine IsZero.of_iso ?_ e.symm
  have h := hY i hi
  rw [ModuleCat.isZero_iff_subsingleton] at h ⊢
  exact h

/-- **Cohomology over an affine base** ([Stacks, Tag 01XK]). For a quasi-compact quasi-separated
`h : Y ⟶ S` with `S` affine and a quasi-coherent `M` whose higher direct images vanish, the higher
cohomology of `M` vanishes. -/
private theorem isZero_rightDerived_of_isZero_pushforward {Y S : Scheme.{0}} (h : Y ⟶ S)
    [IsAffine S] [QuasiCompact h] [QuasiSeparated h] (M : Y.Modules) [M.IsQuasicoherent]
    (i : ℕ) (hR : IsZero (((Scheme.Modules.pushforward h).rightDerived i).obj M)) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y).rightDerived i).obj M) := by
  have e := (Stacks.Cohomology.AffineBase.affineBaseHigherDirectImageIso h i).app
    ⟨M, inferInstance⟩
  have h0 : IsZero ((Stacks.Cohomology.AffineBase.moduleGlobalSections S).obj
      (((Scheme.Modules.pushforward h).rightDerived i).obj M)) :=
    (Stacks.Cohomology.AffineBase.moduleGlobalSections S).map_isZero hR
  have h1 := IsZero.of_iso h0 e
  rw [ModuleCat.isZero_iff_subsingleton] at h1 ⊢
  exact h1

end Leray

/-! ### Charts of a projective space over an affine base -/

section Charts

/-- A pushout of commutative rings is generated by the images of the two maps. -/
private theorem closure_range_union_eq_top_of_isPushout {R A B P : CommRingCat.{0}}
    {f : R ⟶ A} {g : R ⟶ B} {inl : A ⟶ P} {inr : B ⟶ P} (h : IsPushout f g inl inr) :
    Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) = ⊤ := by
  letI := f.hom.toAlgebra
  letI := g.hom.toAlgebra
  have hT := CommRingCat.isPushout_tensorProduct R A B
  let e := hT.isoIsPushout _ _ h
  have h1 : ∀ a, e.hom.hom (a ⊗ₜ[R] (1 : B)) = inl.hom a := by
    intro a
    have := congrArg (fun φ => φ.hom a) (hT.inl_isoIsPushout_hom _ _ h)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have h2 : ∀ b, e.hom.hom ((1 : A) ⊗ₜ[R] b) = inr.hom b := by
    intro b
    have := congrArg (fun φ => φ.hom b) (hT.inr_isoIsPushout_hom _ _ h)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have key : ∀ t : TensorProduct R A B, e.hom.hom t ∈
      Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Subring.zero_mem _
    | tmul a b =>
      have : (a ⊗ₜ[R] b : TensorProduct R A B) = (a ⊗ₜ[R] (1 : B)) * ((1 : A) ⊗ₜ[R] b) := by
        simp
      rw [this, map_mul, h1, h2]
      exact Subring.mul_mem _ (Subring.subset_closure (Or.inl ⟨a, rfl⟩))
        (Subring.subset_closure (Or.inr ⟨b, rfl⟩))
    | add x y hx hy => rw [map_add]; exact Subring.add_mem _ hx hy
  rw [eq_top_iff]
  intro p _
  have : e.hom.hom (e.inv.hom p) = p := by
    change (e.inv ≫ e.hom).hom p = p; simp
  rw [← this]; exact key _

/-- The preimage in `Z × P`, `Z` affine, of an affine open `W ⊆ P` is affine, with functions
generated by those from `Z` and from `W`. -/
private theorem isAffine_and_closure_preimage_snd {Z P : Scheme.{0}} [IsAffine Z] (W : P.Opens)
    (hW : IsAffineOpen W) :
    IsAffine (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W).toScheme ∧
    Subring.closure (Set.range
      ((pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W).ι ≫
        pullback.fst (terminal.from Z) (terminal.from P)).appTop.hom ∪
      Set.range (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W).appTop.hom) = ⊤ := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  have h1 := isPullback_morphismRestrict snd W
  have h2 := IsPullback.of_hasPullback (terminal.from Z) (terminal.from P)
  have h3 := IsPullback.paste_vert h1 h2.flip
  haveI : IsAffine W.toScheme := hW
  exact ⟨IsAffine.of_isPullback h3.flip,
    closure_range_union_eq_top_of_isPushout (isPushout_appTop_of_isPullback h3.flip)⟩

/-- A morphism into `Z × P` is a closed immersion over `snd⁻¹ W` once the functions on the
preimage are generated by those coming from `Z` and from `W`. -/
private theorem isClosedImmersion_morphismRestrict_of_closure {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (j : X ⟶ pullback (terminal.from Z) (terminal.from P))
    [IsAffine (j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme]
    (hgen : Subring.closure (Set.range
      ((j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).ι ≫ j ≫
        pullback.fst _ _).appTop.hom ∪
      Set.range ((j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) ≫
        (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W)).appTop.hom) = ⊤) :
    IsClosedImmersion (j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  haveI : IsAffine (snd ⁻¹ᵁ W).toScheme := (isAffine_and_closure_preimage_snd (Z := Z) W hW).1
  refine IsClosedImmersion.of_surjective_of_isAffine _ ?_
  rw [← RingHom.range_eq_top]
  refine eq_top_iff.2 (le_trans (le_of_eq hgen.symm) ?_)
  rw [Subring.closure_le]
  rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
  · refine ⟨((snd ⁻¹ᵁ W).ι ≫ pullback.fst _ _).appTop.hom a, ?_⟩
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc,
      morphismRestrict_ι, Category.assoc]
  · refine ⟨(snd ∣_ W).appTop.hom b, ?_⟩
    rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop]

/-- Over `snd⁻¹ W`, a closed immersion into `Z × P` has affine source whose functions are
generated by those from `Z` and from `W`. -/
private theorem isAffine_and_closure_of_isClosedImmersion {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (i : X ⟶ pullback (terminal.from Z) (terminal.from P)) [IsClosedImmersion i] :
    IsAffine (i ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme ∧
    Subring.closure (Set.range
      ((i ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).ι ≫ i ≫
        pullback.fst _ _).appTop.hom ∪
      Set.range ((i ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) ≫
        (pullback.snd (terminal.from Z) (terminal.from P) ∣_ W)).appTop.hom) = ⊤ := by
  set snd := pullback.snd (terminal.from Z) (terminal.from P)
  obtain ⟨hV, hgen⟩ := isAffine_and_closure_preimage_snd (Z := Z) W hW
  haveI := hV
  haveI : IsClosedImmersion (i ∣_ (snd ⁻¹ᵁ W)) := inferInstance
  obtain ⟨haff, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine (i ∣_ (snd ⁻¹ᵁ W))
  refine ⟨haff, ?_⟩
  have h := congrArg (Subring.map (i ∣_ (snd ⁻¹ᵁ W)).appTop.hom) hgen
  rw [RingHom.map_closure, Set.image_union, ← Set.range_comp, ← Set.range_comp,
    ← RingHom.range_eq_map, RingHom.range_eq_top.2 hsurj] at h
  rw [← h]
  congr 3
  funext a
  simp only [Function.comp_apply]
  rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, ← Category.assoc (i ∣_ (snd ⁻¹ᵁ W)),
    morphismRestrict_ι, Category.assoc]

/-- `isClosedImmersion_morphismRestrict_of_closure`, phrased through `φ = j ≫ snd`. -/
private theorem isClosedImmersion_morphismRestrict_of_closure' {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (j : X ⟶ pullback (terminal.from Z) (terminal.from P)) (φ : X ⟶ P)
    (hφ : j ≫ pullback.snd _ _ = φ) [IsAffine (φ ⁻¹ᵁ W).toScheme]
    (hgen : Subring.closure (Set.range ((φ ⁻¹ᵁ W).ι ≫ j ≫ pullback.fst _ _).appTop.hom ∪
      Set.range (φ ∣_ W).appTop.hom) = ⊤) :
    IsClosedImmersion (j ∣_ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)) := by
  subst hφ
  haveI : IsAffine (j ⁻¹ᵁ (pullback.snd (terminal.from Z) (terminal.from P) ⁻¹ᵁ W)).toScheme :=
    ‹IsAffine ((j ≫ pullback.snd _ _) ⁻¹ᵁ W).toScheme›
  refine isClosedImmersion_morphismRestrict_of_closure W hW j ?_
  rw [← morphismRestrict_comp]
  exact hgen

/-- `isAffine_and_closure_of_isClosedImmersion`, phrased through `φ = i ≫ snd`. -/
private theorem isAffine_and_closure_of_isClosedImmersion' {X Z P : Scheme.{0}} [IsAffine Z]
    (W : P.Opens) (hW : IsAffineOpen W)
    (i : X ⟶ pullback (terminal.from Z) (terminal.from P)) [IsClosedImmersion i] (φ : X ⟶ P)
    (hφ : i ≫ pullback.snd _ _ = φ) :
    IsAffine (φ ⁻¹ᵁ W).toScheme ∧
    Subring.closure (Set.range ((φ ⁻¹ᵁ W).ι ≫ i ≫ pullback.fst _ _).appTop.hom ∪
      Set.range (φ ∣_ W).appTop.hom) = ⊤ := by
  subst hφ
  obtain ⟨h1, h2⟩ := isAffine_and_closure_of_isClosedImmersion (Z := Z) W hW i
  refine ⟨h1, ?_⟩
  rw [morphismRestrict_comp]
  exact h2

/-- An element of the subring generated by `f '' univ ∪ B` lies in the subring generated by
`f '' T ∪ B` for a finite `T`. -/
private theorem exists_finset_mem_closure {R A : Type*} [CommRing A] (f : R → A) (B : Set A)
    {c : A} (hc : c ∈ Subring.closure (Set.range f ∪ B)) :
    ∃ T : Finset R, c ∈ Subring.closure (f '' (T : Set R) ∪ B) := by
  classical
  have hdir : Directed (· ≤ ·) (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) :=
    fun T₁ T₂ => ⟨T₁ ∪ T₂,
      Subring.closure_mono (Set.union_subset_union_left _ (Set.image_mono (by simp))),
      Subring.closure_mono (Set.union_subset_union_left _ (Set.image_mono (by simp)))⟩
  have hle : Subring.closure (Set.range f ∪ B) ≤
      ⨆ T : Finset R, Subring.closure (f '' (T : Set R) ∪ B) := by
    rw [Subring.closure_le]
    rintro _ (⟨r, rfl⟩ | hb)
    · exact (le_iSup (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) {r})
        (Subring.subset_closure (Or.inl ⟨r, by simp, rfl⟩))
    · exact (le_iSup (fun T : Finset R => Subring.closure (f '' (T : Set R) ∪ B)) ∅)
        (Subring.subset_closure (Or.inr hb))
  exact (Subring.mem_iSup_of_directed hdir).1 (hle hc)

/-- A quasi-compact scheme is covered by finitely many affine opens. -/
private theorem exists_finset_affineOpens_iSup_eq_top (P : Scheme.{0}) [CompactSpace P] :
    ∃ t : Finset P.affineOpens, ⨆ W ∈ t, (W : P.Opens) = ⊤ := by
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun W : P.affineOpens => (W : Set P))
    (fun W => W.1.isOpen) (fun x _ => by
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
      exact Set.mem_iUnion.2 ⟨⟨V, hV⟩, hxV⟩)
  refine ⟨t, eq_top_iff.2 fun x _ => ?_⟩
  obtain ⟨W, hWt, hxW⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ x))
  exact (le_iSup₂ (f := fun W (_ : W ∈ t) => (W : P.Opens)) W hWt) hxW

end Charts

/-! ### Vanishing for the twisted adjoint ideal -/

section Vanishing

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k))
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **The canonical identity on the resolution.** With `K_Y + Γ = μ^*(K_X + Δ) + E`, for a Cartier
`M ∼ K_X + Δ + N` there is a canonical divisor `K_Y` of `Y` with `E + μ^*M ∼ K_Y + Γ + μ^*N`. -/
private theorem exists_isCanonicalDivisor_linearlyEquivalent [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Δ : Divisor X} {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsDominant μ] [CompactSpace Y] (hX : IsNormalVariety k sX)
    (hsm : IsSmoothScheme sX) (hY : IsNormalVariety k (μ ≫ sX)) (hμ : IsBirationalMorphism μ)
    [IsProper μ] (hsmY : IsSmoothScheme (μ ≫ sX)) {Γ E : Divisor Y}
    (hE : IsAdjointDiscrepancyDivisor sX μ hY hμ Δ Γ E) (N : Divisor X) (hN : N.IsCartier)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) (M : Divisor X) (hMc : M.IsCartier)
    (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMpb : M.IsPullback μ hMμ Mμ)
    (hNμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ N.supp)
    (Nμ : Divisor Y) (hNpb : N.IsPullback μ hNμ Nμ) :
    ∃ KY : Divisor Y, KY.IsCanonicalDivisor (μ ≫ sX) n ∧
      (E + Mμ).LinearlyEquivalent (KY + Γ + Nμ) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (μ ≫ sX) := hY.1.toLocallyOfFiniteType
  have hn := hK.topologicalKrullDim_eq
  have hnY : topologicalKrullDim Y = n :=
    (MMP.Intersection.topologicalKrullDim_eq_of_isBirationalMorphism sX (μ ≫ sX) hμ).symm.trans hn
  obtain ⟨K₁, hK₁⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (μ ≫ sX) hsmY hnY
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  have hd := toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sX) hn
  have hτ0 := MMP.Fourfold.SNCWeight.SNCModel.pullbackRationalPluriForms_ne_zero' μ
    hμ.functionFieldMap_bijective hd hω0
  set KY := divisorOfForm (pullbackRationalPluriForms sX μ ω) with hKYdef
  have hKY : KY.IsCanonicalDivisor (μ ≫ sX) n := isCanonicalDivisor_divisorOfForm hY hK₁ hτ0
  have hC : (K + Δ).IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm _
  have hCs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ (K + Δ)
  obtain ⟨Cμ, hCpb⟩ := hC.exists_isPullback hCs
  -- `E = K_Y + Γ - μ^*(K + Δ)`
  have hEeq : E = KY + Γ - Cμ := by
    ext P
    obtain ⟨n', a, ha, hEP⟩ := hE P
    have ha' : MMP.Intersection.IsLogDiscrepancy sX n (Divisor.toRDivisor Δ)
        ⟨Y, μ, hY, hμ, P⟩ (1 + (KY.coeff P : ℝ) - Cμ.coeff P) := by
      refine ⟨hX, ‹IsProper μ›, ω, hω0, ⟨K, hK, fun Γ => (hωK Γ).symm⟩, 1, fun _ => 1,
        fun _ => K + Δ, fun _ => Cμ, fun _ => hC, fun Γ => ?_, fun _ => ⟨hCs, hCpb⟩, ?_⟩
      · simp [hωK Γ, DivisorWithCoeffs.coeff_add]
      · simp only [Finset.univ_unique, Finset.sum_singleton, one_mul]
        rfl
    have huniq := MMP.Threefold.Bridges.IsLogDiscrepancy.unique ha ha'
    have : (E.coeff P : ℝ) = (KY.coeff P : ℝ) - Cμ.coeff P + Γ.coeff P := by
      rw [hEP, huniq]; ring
    rw [DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add]
    have h' : E.coeff P = KY.coeff P - Cμ.coeff P + Γ.coeff P := by exact_mod_cast this
    rw [h']; ring
  -- `μ^*M ∼ μ^*(K + Δ) + μ^*N`
  obtain ⟨φ, hφ⟩ := hMK
  have hKΔN : (K + Δ + N).IsCartier := hC.add hN
  have hsum := Divisor.IsPullback.add hC hN
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _) hCpb hNpb
  have hφs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ (principalDivisor φ)
  have hφpb := Divisor.isPullback_principalDivisor (f := μ) φ hφs
  have hMeq : M = (K + Δ + N) + principalDivisor φ := by rw [← hφ]; abel
  have hMpb' := Divisor.IsPullback.add hKΔN (MMP.Fourfold.isCartier_of_isSmoothScheme hsm _)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _) hsum hφpb
  rw [← hMeq] at hMpb'
  have hMμeq : Mμ = Cμ + Nμ + principalDivisor (pullbackRationalFunction μ φ hφs) :=
    Divisor.IsPullback.eq hMc hMpb hMpb'
  refine ⟨KY, hKY, pullbackRationalFunction μ φ hφs, ?_⟩
  rw [hEeq, hMμeq]
  abel

private theorem compactSpace_projectiveSpaceAtUniverse (n : ℕ) :
    CompactSpace (projectiveSpaceAtUniverse.{0} n) := by
  haveI : IsIso (terminal.from (⊤_ Scheme.{0})) :=
    ⟨⟨𝟙 _, terminal.hom_ext _ _, terminal.hom_ext _ _⟩⟩
  haveI : IsIso (pullback.snd (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := inferInstance
  have hp : IsProper (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := isProper_projectiveSpaceOver n _
  haveI : UniversallyClosed (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) := hp.toUniversallyClosed
  haveI : QuasiCompact (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) :=
    AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  haveI : CompactSpace (pullback (C := Scheme.{0}) (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))) :=
    QuasiCompact.compactSpace_of_compactSpace (pullback.fst (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n)))
  exact (pullback.snd (terminal.from (⊤_ Scheme.{0}))
      (terminal.from (projectiveSpaceAtUniverse.{0} n))).homeomorph.compactSpace

/-- **A closed subscheme of `ℙⁿ` over an affine scheme descends to an affine variety.** If `X` is
a variety over `k` and `i : X ⟶ ℙⁿ_Z` is a closed immersion with `Z` affine, then `X` is a closed
subscheme `j : X ⟶ ℙⁿ_{Z'}` over an affine `k`-variety `Z'`, with the same map to `ℙⁿ_ℤ`: the
coordinate rings of the charts of `X ⊆ ℙⁿ_Z` are generated over `k` by finitely many functions, and
the finitely many coefficients from `Γ(Z, 𝒪_Z)` involved generate a finitely generated
`k`-subalgebra `R ⊆ Γ(X, 𝒪_X)` over which `X ⊆ ℙⁿ_R` is still closed. -/
private theorem exists_isClosedImmersion_isAffine_isVariety {k : Type} [Field k]
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] (hX : MMP.Mori.IsVariety k sX)
    {Z : Scheme.{0}} [IsAffine Z] {n : ℕ} (i : X ⟶ projectiveSpaceOver n Z)
    [IsClosedImmersion i] :
    ∃ (Z' : Scheme.{0}) (sZ' : Z' ⟶ Spec (.of k)) (g : X ⟶ Z')
      (j : X ⟶ projectiveSpaceOver n Z'), MMP.Mori.IsVariety k sZ' ∧
      IsAffine Z' ∧ g ≫ sZ' = sX ∧ IsClosedImmersion j ∧ j ≫ pullback.fst _ _ = g ∧
      j ≫ pullback.snd _ _ = i ≫ pullback.snd _ _ := by
  classical
  haveI := compactSpace_projectiveSpaceAtUniverse n
  obtain ⟨t, ht⟩ := exists_finset_affineOpens_iSup_eq_top (projectiveSpaceAtUniverse.{0} n)
  set φ : X ⟶ projectiveSpaceAtUniverse.{0} n := i ≫ pullback.snd _ _ with hφ
  have hloc := fun W : (projectiveSpaceAtUniverse.{0} n).affineOpens =>
    isAffine_and_closure_of_isClosedImmersion' (Z := Z) W.1 W.2 i φ rfl
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  -- the chart rings are finitely generated over `K₀ = Γ(Spec k)`
  have hft : ∀ W : (projectiveSpaceAtUniverse.{0} n).affineOpens,
      ((φ ⁻¹ᵁ W.1).ι ≫ sX).appTop.hom.FiniteType := fun W => by
    haveI := (hloc W).1
    exact (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).1 inferInstance
  choose G hG using fun W => (hft W).out
  have hT := fun (W : (projectiveSpaceAtUniverse.{0} n).affineOpens) (c : Γ((φ ⁻¹ᵁ W.1).toScheme, ⊤)) =>
    exists_finset_mem_closure
      (fun z => ((φ ⁻¹ᵁ W.1).ι ≫ i ≫ pullback.fst _ _).appTop.hom z)
      (Set.range (φ ∣_ W.1).appTop.hom) (c := c) (by rw [(hloc W).2]; trivial)
  choose T hTc using hT
  let S : Finset Γ(Z, ⊤) := t.biUnion fun W => (G W).biUnion (T W)
  letI : Algebra Γ(Spec (.of k), ⊤) Γ(X, ⊤) := sX.appTop.hom.toAlgebra
  let R : Subalgebra Γ(Spec (.of k), ⊤) Γ(X, ⊤) :=
    Algebra.adjoin Γ(Spec (.of k), ⊤) ((i ≫ pullback.fst _ _).appTop.hom '' (S : Set Γ(Z, ⊤)))
  let gR : CommRingCat.of R ⟶ Γ(X, ⊤) := CommRingCat.ofHom R.val.toRingHom
  let g : X ⟶ Spec (CommRingCat.of R) := X.toSpecΓ ≫ Spec.map gR
  let sR : CommRingCat.of k ⟶ CommRingCat.of R := CommRingCat.ofHom
    ((sX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom).codRestrict R
      fun x => R.algebraMap_mem _)
  let sZ' : Spec (CommRingCat.of R) ⟶ Spec (.of k) := Spec.map sR
  have hgapp : ∀ x, g.appTop.hom x = R.val ((Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom x) := by
    intro x
    have h1 : g.appTop = (Spec.map gR).appTop ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom := by
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop]
    rw [h1, Scheme.ΓSpecIso_naturality]
    rfl
  have hgs : g ≫ sZ' = sX := by
    have h2 : sR ≫ gR = (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ sX.appTop := by
      ext x
      rfl
    change X.toSpecΓ ≫ Spec.map gR ≫ Spec.map sR = sX
    rw [← Spec.map_comp, h2, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  let j : X ⟶ pullback (terminal.from (Spec (CommRingCat.of R)))
      (terminal.from (projectiveSpaceAtUniverse.{0} n)) :=
    pullback.lift g φ (terminal.hom_ext _ _)
  have hjs : j ≫ pullback.snd _ _ = φ := pullback.lift_snd _ _ _
  have hjf : j ≫ pullback.fst _ _ = g := pullback.lift_fst _ _ _
  have ht' : ⨆ W : t, (W.1 : (projectiveSpaceAtUniverse.{0} n).Opens) = ⊤ := by
    rw [← ht, iSup_subtype]
  have hj : IsClosedImmersion j := by
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (fun W : t =>
      pullback.snd (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (projectiveSpaceAtUniverse.{0} n)) ⁻¹ᵁ W.1.1) ?_ fun W => ?_
    · rw [← Scheme.Hom.preimage_iSup, ht', Scheme.Hom.preimage_top]
    · haveI := (hloc W.1).1
      refine isClosedImmersion_morphismRestrict_of_closure' W.1.1 W.1.2 j φ hjs ?_
      have hcomp : (φ ⁻¹ᵁ W.1.1).ι ≫ j ≫ pullback.fst _ _ = (φ ⁻¹ᵁ W.1.1).ι ≫ g := by
        rw [hjf]
      rw [hcomp]
      letI : Algebra Γ(Spec (.of k), ⊤) Γ((φ ⁻¹ᵁ W.1.1).toScheme, ⊤) :=
        (((φ ⁻¹ᵁ W.1.1).ι ≫ sX).appTop.hom).toAlgebra
      have hadj := congrArg Subalgebra.toSubring (hG W.1)
      rw [Algebra.adjoin_eq_ring_closure, Algebra.top_toSubring] at hadj
      refine eq_top_iff.2 (le_trans (le_of_eq hadj.symm) (Subring.closure_le.2 ?_))
      rintro c (⟨x, rfl⟩ | hc)
      · refine Subring.subset_closure (Or.inl ⟨sZ'.appTop.hom x, ?_⟩)
        change _ = (((φ ⁻¹ᵁ W.1.1).ι ≫ sX).appTop).hom x
        rw [← hgs]
        simp only [g, Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
      · refine (Subring.closure_le.2 ?_) (hTc W.1 c)
        rintro _ (⟨z, hz, rfl⟩ | hb)
        · have hzS : z ∈ S := Finset.mem_biUnion.2 ⟨W.1, W.2, Finset.mem_biUnion.2 ⟨c, hc, hz⟩⟩
          let r : R := ⟨(i ≫ pullback.fst _ _).appTop.hom z,
            Algebra.subset_adjoin ⟨z, hzS, rfl⟩⟩
          refine Subring.subset_closure (Or.inl ⟨(Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r, ?_⟩)
          simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
          rw [hgapp]
          congr 1
          change R.val (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            (Scheme.ΓSpecIso (CommRingCat.of R)).hom).hom r) = _
          rw [Iso.inv_hom_id]
          rfl
        · exact Subring.subset_closure (Or.inr hb)
  refine ⟨Spec (CommRingCat.of R), sZ', g, j, ?_, inferInstance, hgs, hj, hjf, hjs⟩
  haveI : IsDomain R := inferInstance
  haveI : IsDomain (CommRingCat.of R) := ‹IsDomain R›
  have hfgR : Algebra.FiniteType Γ(Spec (.of k), ⊤) R := by
    rw [← Subalgebra.fg_iff_finiteType]
    exact ⟨(S.image fun z => (i ≫ pullback.fst _ _).appTop.hom z), by simp [R]⟩
  have hsR : sR.hom.FiniteType := by
    have h1 : (algebraMap Γ(Spec (.of k), ⊤) R).FiniteType := hfgR
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _
        (fun x => ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom x, by
          rw [← CommRingCat.comp_apply, Iso.hom_inv_id]; rfl⟩)
    exact h1.comp h2
  haveI : LocallyOfFiniteType sZ' := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]; exact hsR
  exact {}

/-- **A projective morphism to an affine scheme factors through an affine variety.** -/
private theorem exists_isProjectiveMorphism_isAffine_isVariety {k : Type} [Field k]
    {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] (hX : MMP.Mori.IsVariety k sX)
    {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] :
    ∃ (Z' : Scheme.{0}) (sZ' : Z' ⟶ Spec (.of k)) (g : X ⟶ Z'), MMP.Mori.IsVariety k sZ' ∧
      IsAffine Z' ∧ g ≫ sZ' = sX ∧ IsProjectiveMorphism g := by
  obtain ⟨n, i, hi, -⟩ := hf
  haveI := hi
  obtain ⟨Z', sZ', g, j, h1, h2, h3, h4, h5, -⟩ := exists_isClosedImmersion_isAffine_isVariety sX hX i
  exact ⟨Z', sZ', g, h1, h2, h3, ⟨n, j, h4, h5⟩⟩

/-- A prime divisor whose generic point maps to a point of coheight one is not exceptional for a
morphism. -/
private theorem not_isExceptional_of_coheight_eq_one {X Y : Scheme.{0}} (μ : Y ⟶ X)
    (P : MMP.Mori.PrimeDivisor Y) (h : Order.coheight (μ P.genericPoint) = 1) :
    ¬ MMP.Mori.RationalMap.IsExceptional (X := Y) μ.toRationalMap P := by
  rw [MMP.Mori.RationalMap.isExceptional_iff]
  intro hex
  have hdef : MMP.Mori.RationalMap.DefinedAt (X := Y) μ.toRationalMap P.genericPoint :=
    MMP.Mori.RationalMap.definedAt_iff.mpr ⟨μ.toPartialMap, trivial, rfl⟩
  have h2 := MMP.Flips.le_closedsCodimension_iff_le_coheight.mp (hex hdef) (μ P.genericPoint)
    (MMP.Mori.RationalMap.image_subset_transform μ.toPartialMap rfl _
      ⟨⟨P.genericPoint, trivial⟩, by
        change P.genericPoint ∈ P.support
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl, rfl⟩)
  rw [h] at h2
  exact absurd h2 (by decide)

/-- **The zero places of `(X, Δ)` on a resolution which is an isomorphism away from `Supp D`.**
A prime divisor with `Γ_P = 1` has coefficient zero in `μ₀^*D` and in every divisor supported on
`μ₀`-exceptional prime divisors. -/
private theorem coeff_eq_zero_of_coeff_zeroLogDiscrepancy [IsAlgClosed k] [CharZero k]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hDns : ContainsNoStratum Δ D.supp)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (P : MMP.Mori.PrimeDivisor Y₀)
    (hP : Γ.coeff P = 1) :
    F.coeff P = 0 ∧ ¬ MMP.Mori.RationalMap.IsExceptional (X := Y₀) μ₀.toRationalMap P := by
  obtain ⟨n, h0⟩ := (hΓ.2 P).1 hP
  have hxD : μ₀ P.genericPoint ∉ D.supp :=
    notMem_of_isLogDiscrepancy_eq_zero hX hsm hΔ D.isClosed_supp hDns h0
  refine ⟨?_, ?_⟩
  · exact coeff_qIsPullback_eq_zero sX hX hsm μ₀ hY hμ hF P hxD
  · apply not_isExceptional_of_coheight_eq_one
    have hb : μ₀ P.genericPoint ∈ biregularLocus μ₀ := le_biregularLocus hiso hxD
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ₀ hb, P.coheight_genericPoint]

/-- **The boundary is snc.** A `ℚ`-divisor on a log resolution `μ₀` of `Δ + D` whose components
are components of `Γ`, of `μ₀^*D` or `μ₀`-exceptional is snc. -/
private theorem isSNC_of_support_subset [IsAlgClosed k] [CharZero k]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (B : QDivisor Y₀)
    (hB : ∀ P, B.coeff P ≠ 0 → Γ.coeff P ≠ 0 ∨ F.coeff P ≠ 0 ∨
      MMP.Mori.RationalMap.IsExceptional (X := Y₀) μ₀.toRationalMap P) :
    DivisorWithCoeffs.IsSNC (μ₀ ≫ sX) B := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ₀ ≫ sX) := hY.1
  haveI : LocallyOfFiniteType (μ₀ ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFinitePresentation (μ₀ ≫ sX) :=
    (LocallyOfFinitePresentation.iff_locallyOfFiniteType (f := μ₀ ≫ sX)).mpr inferInstance
  have hp₀ : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  obtain ⟨n, hn⟩ := exists_topologicalKrullDim_eq sX hX.1
  obtain ⟨s, hs, hsnc⟩ := exists_finset_of_isSNCSubset (μ₀ ≫ sX) hlog.isSmoothScheme
    hlog.isSNCSubset
  have hmem : ∀ P : MMP.Mori.PrimeDivisor Y₀,
      P.genericPoint ∈ (⋃ E ∈ s, (E.support : Set Y₀)) → P ∈ s := by
    intro P hP
    obtain ⟨E, hEs, hPE⟩ := Set.mem_iUnion₂.mp hP
    have := E.eq_genericPoint_of_mem_support hPE P.coheight_genericPoint
    rwa [← AlgebraicGeometry.PrimeDivisor.genericPoint_injective this] at hEs
  refine hsnc.of_support_subset fun P hPB => ?_
  have hPs : P ∈ s := by
    rcases hB P (Finsupp.mem_support_iff.1 hPB) with hΓP | hFP | hEx
    · by_contra hPs
      have h1 := (isLogDiscrepancy_one_of_notMem_finset sX hX hsm hn hΔ.1 hD0 hY hμ hp₀ hs hPs).1
      have hΓ1 : Γ.coeff P = 1 := (hΓ.1 P).resolve_left hΓP
      obtain ⟨n', h0⟩ := (hΓ.2 P).1 hΓ1
      have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique h0 h1
      norm_num at this
    · apply hmem
      rw [hs]
      right
      change μ₀ P.genericPoint ∈ (DivisorWithCoeffs.supp
        (QDivisor.toRDivisor (Divisor.toQDivisor Δ + D)) : Set X)
      rw [QDivisor.supp_toRDivisor]
      by_contra hx
      apply hFP
      have hxD : μ₀ P.genericPoint ∉ D.supp := fun hxD => by
        apply hx
        obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.1 hxD
        refine DivisorWithCoeffs.mem_supp_iff.2 ⟨E, ?_, hxE⟩
        rw [DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor]
        have h1 : (0 : ℚ) ≤ (Δ.coeff E : ℚ) := by
          rcases hΔ.1 E with h | h <;> rw [h] <;> norm_num
        have h2 : 0 < D.coeff E := lt_of_le_of_ne (hD0 E) (Ne.symm hE)
        exact (add_pos_of_nonneg_of_pos h1 h2).ne'
      exact coeff_qIsPullback_eq_zero sX hX hsm μ₀ hY hμ hF P hxD
    · apply hmem
      rw [hs]
      left
      rw [SetLike.mem_coe, mem_exceptionalSet]
      intro hb
      apply not_isExceptional_of_coheight_eq_one μ₀ P _ hEx
      rw [MMP.Positivity.coheight_map_of_mem_biregularLocus μ₀ hb, P.coheight_genericPoint]
  simp [Finsupp.finset_sum_apply, Finsupp.single_apply, hPs]

/-- `μ^*(m(N - D)) = m(μ^*N - μ^*D)`. -/
private theorem toQDivisor_pullback_eq {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀] [CompactSpace X]
    (hsm : IsSmoothScheme sX) {D : QDivisor X}
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {F : QDivisor Y₀} (hF : D.IsPullback μ₀ hD F) {N : Divisor X} (hN : N.IsCartier)
    {hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp}
    {Nμ : Divisor Y₀} (hNpb : N.IsPullback μ₀ hNμ Nμ) {m : ℕ} {A : Divisor X} (hAc : A.IsCartier)
    (hAeq : Divisor.toQDivisor A = (m : ℤ) • (Divisor.toQDivisor N - D))
    {hAμs : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ A.supp}
    {Aμ : Divisor Y₀} (hAμ : A.IsPullback μ₀ hAμs Aμ) :
    Divisor.toQDivisor Aμ = (m : ℤ) • (Divisor.toQDivisor Nμ - F) := by
  obtain ⟨mD, hmD, D₀, hD₀, hD₀c⟩ := (MMP.Fourfold.isQCartier_of_isSmoothScheme hsm D).exists_pos
  obtain ⟨D₀', hD₀'eq, hD₀'⟩ := hF mD hmD D₀ hD₀ hD₀c
  have hcart : ∀ G : Divisor X, G.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsm
  have hs : ∀ G : Divisor X, ∀ C : irreducibleComponents Y₀,
      μ₀ (componentGenericPoint Y₀ C) ∉ G.supp :=
    fun G => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ G
  -- `mD • A = (m * mD) • N + (-m) • D₀` on `X`
  have hX : (mD : ℤ) • A = ((m * mD : ℕ) : ℤ) • N + (-(m : ℤ)) • D₀ := by
    apply Divisor.toQDivisor_injective
    rw [map_zsmul, hAeq, map_add, map_zsmul, map_zsmul, hD₀, smul_smul]
    push_cast
    module
  have h1 := hAμ.zsmul hAc (mD : ℤ) (hs _)
  have h2 := (hNpb.zsmul hN ((m * mD : ℕ) : ℤ) (hs _)).add (hcart _) ((hcart _).zsmul _) (hs _)
    (hD₀'.zsmul hD₀c (-(m : ℤ)) (hs _))
  rw [← hX] at h2
  have h3 := Divisor.IsPullback.eq (hAc.zsmul _) h1 h2
  have h4 := congrArg Divisor.toQDivisor h3
  rw [map_zsmul, map_add, map_zsmul, map_zsmul, hD₀'eq] at h4
  have hmD0 : ((mD : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hmD.ne'
  ext P
  have h5 := congrArg (fun G : QDivisor Y₀ => G.coeff P) h4
  simp only [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add, zsmul_eq_mul,
    smul_eq_mul, DivisorWithCoeffs.coeff_sub] at h5 ⊢
  push_cast at h5 ⊢
  apply mul_left_cancel₀ hmD0
  push_cast
  linear_combination h5

/-- **The boundary of the Kawamata–Viehweg application.** On a log resolution `μ₀` of `Δ + D`
which is an isomorphism away from `Supp D`, with `Γ` the zero places of `(X, Δ)` (the strict
transform of `Δ`), `F = μ₀^*D` and `N - D` `f`-ample, there is an effective snc `ℚ`-divisor `B`
with coefficients `< 1`, namely `(1 - ε)Γ + {F} + δF_exc` for an antiample exceptional `F_exc`,
such that `L - (K_Y + B) = μ₀^*(N - D) + εΓ - δF_exc` is ample over `X` and over every `Z'`
over which `X` is projective with `f`-ample divisors ample over `Z'`, where
`L = K_Y + Γ + μ₀^*N - ⌊F⌋`. -/
private theorem exists_boundary_hasRelativelyAmpleMultiple [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (N : Divisor X)
    (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f)
    (KY : Divisor Y₀)
    (hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp)
    (Nμ : Divisor Y₀) (hNpb : N.IsPullback μ₀ hNμ Nμ) {Z' : Scheme.{0}} (g : X ⟶ Z')
    (hg : IsProjectiveMorphism g) [IsAffine Z'] :
    ∃ B : QDivisor Y₀, B.IsEffective ∧ DivisorWithCoeffs.IsSNC (μ₀ ≫ sX) B ∧
      (∀ E : MMP.Mori.PrimeDivisor Y₀, B.coeff E < 1) ∧
      (Divisor.toQDivisor (KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown
          (QDivisor.toRDivisor F)) - (Divisor.toQDivisor KY + B)).HasRelativelyAmpleMultiple μ₀ ∧
      (Divisor.toQDivisor (KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown
          (QDivisor.toRDivisor F)) - (Divisor.toQDivisor KY + B)).HasRelativelyAmpleMultiple
        (μ₀ ≫ g) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  have hp₀ : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  haveI : UniversallyClosed μ₀ := hp₀.toUniversallyClosed
  haveI : QuasiCompact μ₀ := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hpg : IsProper g := isProper_of_isProjectiveMorphism g hg
  haveI : UniversallyClosed g := hpg.toUniversallyClosed
  haveI : QuasiCompact g := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hpf : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI : UniversallyClosed f := hpf.toUniversallyClosed
  haveI : QuasiCompact f := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  have hsmY : IsSmoothScheme (μ₀ ≫ sX) := hlog.isSmoothScheme
  have hQF : MMP.Fourfold.IsQFactorial sX := ⟨hX, fun D' => ⟨1, one_pos, by
    simpa using MMP.Fourfold.isCartier_of_isSmoothScheme hsm D'⟩⟩
  obtain ⟨Fexc, e, he, hFexc0, hFexcEx, Dexc, hDexc, hDexceq, hDexcamp⟩ :=
    MMP.Mori.exists_isRelativelyAmple_neg_smul_of_isExceptional sX (μ₀ ≫ sX) hQF hY μ₀ rfl
      hlog.isProjectiveMorphism hμ
  obtain ⟨mN, hmN, A, hAc, hAeq, hAamp⟩ := hND
  haveI := hAc.isInvertibleModule_divisorialSheaf
  have hAX : Stacks.Ample.IsAmple X A.divisorialSheaf :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f _
      (stacks_of_isRelativelyAmple f _ hAamp)
  have hAμs := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ A
  obtain ⟨Aμ, hAμ⟩ := hAc.exists_isPullback hAμs
  have hAμeq := toQDivisor_pullback_eq sX μ₀ hsm hD hF hN hNpb hAc hAeq hAμ
  have hΓc : Γ.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY Γ
  obtain ⟨r, hr, hr0⟩ := ((eventually_isRelativelyAmpleCartier_nsmul_add μ₀
    (isRelativelyAmpleCartier_of_isRelativelyAmple μ₀ hDexc.neg hDexcamp) hΓc).and
      (Filter.eventually_gt_atTop 0)).exists
  have hCc : (r • (-Dexc) + Γ).IsCartier := hr.choose
  have hCamp : (r • (-Dexc) + Γ).IsRelativelyAmple μ₀ hCc :=
    isRelativelyAmple_of_isRelativelyAmpleCartier μ₀ hr
  obtain ⟨n₁, hn₁⟩ := exists_isRelativelyAmple_add_nsmul μ₀ (𝟙 X) hCc hCamp hAc
    (isRelativelyAmple_id_of_isAmple hAc hAX) hAμ
  obtain ⟨n₂, hn₂⟩ := exists_isRelativelyAmple_add_nsmul μ₀ g hCc hCamp hAc
    (isRelativelyAmple_of_isAmple_of_isAffine g hAc hAX) hAμ
  -- the fractional part of `F`
  set R := MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) with hR
  have hRc : ∀ P, (R.coeff P : ℚ) = ⌊F.coeff P⌋ := fun P => by
    rw [hR, MMP.Intersection.WeilRDivisor.coeff_roundDown, QDivisor.coeff_toRDivisor,
      Rat.floor_cast]
  set fr := F - Divisor.toQDivisor R with hfr
  have hfrc : ∀ P, fr.coeff P = F.coeff P - ⌊F.coeff P⌋ := fun P => by
    rw [hfr, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor, hRc]
  have hfr0 : ∀ P, 0 ≤ fr.coeff P := fun P => by rw [hfrc]; exact Int.fract_nonneg _
  have hfr1 : ∀ P, fr.coeff P < 1 := fun P => by rw [hfrc]; exact Int.fract_lt_one _
  -- the numbers
  set t : ℚ := ∑ P ∈ Fexc.support, Fexc.coeff P / (1 - fr.coeff P) with ht
  have ht0 : ∀ P ∈ Fexc.support, Fexc.coeff P / (1 - fr.coeff P) ≤ t := fun P hP =>
    Finset.single_le_sum (f := fun P => Fexc.coeff P / (1 - fr.coeff P))
      (fun Q _ => div_nonneg (hFexc0 Q) (by linarith [hfr1 Q])) hP
  set q : ℕ := n₁ + n₂ + ⌈t⌉₊ + 1 with hq
  have hq0 : 0 < q := by omega
  have hqt : t < q := by
    have := Nat.le_ceil t
    rw [hq]; push_cast; linarith [Nat.cast_nonneg (α := ℚ) (n₁ + n₂)]
  set n : ℕ := e * r * q with hn
  have hn₁n : n₁ ≤ n := by
    have : 1 ≤ e * r := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero he.ne' hr0.ne')
    nlinarith
  have hn₂n : n₂ ≤ n := by
    have : 1 ≤ e * r := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero he.ne' hr0.ne')
    nlinarith
  set c : ℕ := mN * e * r * q with hc
  have hc0 : 0 < c := by positivity
  set δ : ℚ := 1 / (mN * q) with hδ
  set ε : ℚ := 1 / c with hε
  have hδ0 : 0 ≤ δ := by positivity
  have hε0 : 0 < ε := by positivity
  have hε1 : ε ≤ 1 := by
    rw [hε, div_le_one (by exact_mod_cast hc0)]; exact_mod_cast hc0
  have hδt : δ * t < 1 := by
    rw [hδ, one_div_mul_eq_div, div_lt_one (by positivity)]
    calc t < q := hqt
      _ ≤ mN * q := by
        have : (1 : ℚ) ≤ mN := by exact_mod_cast hmN
        nlinarith [Nat.cast_nonneg (α := ℚ) q]
  set B : QDivisor Y₀ := (1 - ε) • Divisor.toQDivisor Γ + fr + δ • Fexc with hBdef
  have hBc : ∀ P, B.coeff P = (1 - ε) * Γ.coeff P + fr.coeff P + δ * Fexc.coeff P := fun P => by
    simp [hBdef, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul]
  have hΓ01 := hΓ.1
  refine ⟨B, fun P => ?_, ?_, fun P => ?_, ?_, ?_⟩
  · -- effective
    rw [hBc]
    have h1 : (0 : ℚ) ≤ (1 - ε) * Γ.coeff P := by
      rcases hΓ01 P with h | h <;> rw [h] <;> push_cast <;> linarith
    have h2 := hfr0 P
    have h3 : 0 ≤ δ * Fexc.coeff P := mul_nonneg hδ0 (hFexc0 P)
    linarith
  · -- snc
    refine isSNC_of_support_subset sX μ₀ hX hsm hΔ hD0 hlog hY hμ hD hΓ hF B fun P hP => ?_
    by_contra hcon
    push Not at hcon
    obtain ⟨hΓP, hFP, hEP⟩ := hcon
    apply hP
    rw [hBc, hΓP, hfrc, hFP]
    have : Fexc.coeff P = 0 := by
      by_contra h
      exact hEP (hFexcEx P h)
    rw [this]; simp
  · -- coefficients `< 1`
    rw [hBc]
    rcases hΓ01 P with hΓP | hΓP
    · rw [hΓP]
      by_cases hP : Fexc.coeff P = 0
      · rw [hP]; simp only [Int.cast_zero, mul_zero, zero_add, add_zero]; exact hfr1 P
      · have hmem : P ∈ Fexc.support := Finsupp.mem_support_iff.2 hP
        have h1 := ht0 P hmem
        have hpos : 0 < 1 - fr.coeff P := by linarith [hfr1 P]
        have h2 : Fexc.coeff P ≤ t * (1 - fr.coeff P) := by
          rwa [div_le_iff₀ hpos] at h1
        have h3 : δ * Fexc.coeff P ≤ δ * t * (1 - fr.coeff P) := by
          rw [mul_assoc]; exact mul_le_mul_of_nonneg_left h2 hδ0
        have h4 : δ * t * (1 - fr.coeff P) < 1 - fr.coeff P := by
          nlinarith
        simp only [Int.cast_zero, mul_zero, zero_add]
        linarith
    · obtain ⟨hF0, hnex⟩ := coeff_eq_zero_of_coeff_zeroLogDiscrepancy sX μ₀ hX hsm hΔ hDns hY hμ
        hD hΓ hF hiso P hΓP
      have hE0 : Fexc.coeff P = 0 := by
        by_contra h
        exact hnex (hFexcEx P h)
      rw [hΓP, hfrc, hF0, hE0]
      simp only [Int.cast_one, mul_one, Int.floor_zero, Int.cast_zero, sub_zero, mul_zero,
        add_zero]
      linarith
  all_goals
    have hLc : (r • (-Dexc) + Γ + n • Aμ).IsCartier := hCc.add ((hAμ.isCartier hAc).nsmul n)
    have heq : Divisor.toQDivisor (r • (-Dexc) + Γ + n • Aμ) =
        ((c : ℕ) : ℤ) • (Divisor.toQDivisor (KY + Γ + Nμ - R) - (Divisor.toQDivisor KY + B)) := by
      ext P
      have hA' : (Aμ.coeff P : ℚ) = mN * (Nμ.coeff P - F.coeff P) := by
        have := congrArg (fun G : QDivisor Y₀ => G.coeff P) hAμeq
        simpa [DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_sub] using this
      have hD' : (Dexc.coeff P : ℚ) = e * Fexc.coeff P := by
        have := congrArg (fun G : QDivisor Y₀ => G.coeff P) hDexceq
        simpa [DivisorWithCoeffs.coeff_smul] using this
      have hfrP := hfrc P
      have hBP := hBc P
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
        DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_neg, nsmul_eq_mul, zsmul_eq_mul,
        Int.cast_add, Int.cast_sub, Int.cast_mul, Int.cast_neg, Int.cast_natCast, smul_eq_mul]
        at hA' hD' ⊢
      rw [hBP, hfrP, hRc, hA', hD', hε, hδ, hc, hn]
      push_cast
      field_simp
      ring
  · refine ⟨c, hc0, _, hLc, heq, ?_⟩
    have h1 := hn₁ n hn₁n
    rw [Category.comp_id] at h1
    exact h1
  · exact ⟨c, hc0, _, hLc, heq, hn₂ n hn₂n⟩

/-- **Kawamata–Viehweg on the resolution.** On a log resolution `μ₀` of `Δ + D` which is an
isomorphism away from `Supp D`, for `N - D` `f`-ample and a canonical divisor `K_Y` of `Y₀`, the
higher direct images and the higher cohomology of the push-forward of
`𝒪_{Y₀}(K_Y + Γ + μ₀^*N - ⌊μ₀^*D⌋)` vanish. -/
private theorem isZero_rightDerived_canonical [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀] [CompactSpace Y₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ : Divisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ) {F : QDivisor Y₀}
    (hF : D.IsPullback μ₀ hD F) (hiso : IsIso (μ₀ ∣_ D.supp.compl)) (N : Divisor X)
    (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ}
    {KY : Divisor Y₀} (hKY : KY.IsCanonicalDivisor (μ₀ ≫ sX) n)
    (hNμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ N.supp)
    (Nμ : Divisor Y₀) (hNpb : N.IsPullback μ₀ hNμ Nμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward μ₀).rightDerived i).obj (KY + Γ + Nμ -
        MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).divisorialSheaf) ∧
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward μ₀).obj (KY + Γ + Nμ -
        MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)).divisorialSheaf)) := by
  classical
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : MMP.Mori.IsVariety k (μ₀ ≫ sX) := hY.1
  obtain ⟨Z', sZ', g, hZ', hZ'a, hgs, hgp⟩ :=
    exists_isProjectiveMorphism_isAffine_isVariety sX hX.1 f hf
  haveI := hZ'a
  haveI : MMP.Mori.IsVariety k sZ' := hZ'
  set L' := KY + Γ + Nμ - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
    with hL'
  have hsmY : IsSmoothScheme (μ₀ ≫ sX) := hlog.isSmoothScheme
  have hL'c : L'.IsCartier := MMP.Fourfold.isCartier_of_isSmoothScheme hsmY _
  obtain ⟨B, hB0, hBsnc, hB1, hloc, hglob⟩ := exists_boundary_hasRelativelyAmpleMultiple sX f hf μ₀
    hX hsm hΔ hD0 hDns hlog hY hμ hD hΓ hF hiso N hN hND KY hNμ Nμ hNpb g hgp
  have hR : ∀ j : ℕ, 0 < j →
      IsZero (((Scheme.Modules.pushforward μ₀).rightDerived j).obj L'.divisorialSheaf) :=
    fun j hj => MMP.Mori.isZero_rightDerived_pushforward_divisorialSheaf_of_hasRelativelyAmpleMultiple
      (μ₀ ≫ sX) sX hsmY μ₀ rfl hlog.isProjectiveMorphism hKY hB0 hBsnc hB1 hL'c hloc j hj
  have hRg : ∀ j : ℕ, 0 < j →
      IsZero (((Scheme.Modules.pushforward (μ₀ ≫ g)).rightDerived j).obj L'.divisorialSheaf) :=
    fun j hj => MMP.Mori.isZero_rightDerived_pushforward_divisorialSheaf_of_hasRelativelyAmpleMultiple
      (μ₀ ≫ sX) sZ' hsmY (μ₀ ≫ g) (by rw [Category.assoc, hgs])
      (hlog.isProjectiveMorphism.comp hgp) hKY hB0 hBsnc hB1 hL'c hglob j hj
  have hpg : IsProper (μ₀ ≫ g) :=
    isProper_of_isProjectiveMorphism _ (hlog.isProjectiveMorphism.comp hgp)
  haveI : UniversallyClosed (μ₀ ≫ g) := hpg.toUniversallyClosed
  haveI : IsSeparated (μ₀ ≫ g) := hpg.toIsSeparated
  haveI : QuasiCompact (μ₀ ≫ g) := AlgebraicGeometry.instQuasiCompactOfUniversallyClosed _
  haveI : QuasiSeparated (μ₀ ≫ g) := AlgebraicGeometry.IsSeparated.instQuasiSeparated _
  have hY0 : ∀ j : ℕ, 0 < j →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Y₀).rightDerived j).obj
        L'.divisorialSheaf) :=
    fun j hj => isZero_rightDerived_of_isZero_pushforward (μ₀ ≫ g) _ j (hRg j hj)
  exact ⟨hR i hi, isZero_rightDerived_pushforward_of_isZero μ₀ _ hR hY0 i hi⟩

/-- **Vanishing on a resolution which is an isomorphism away from `Supp D`.** On such a log
resolution `μ₀`, with `(Γ, E, F)` the data of `𝒥_{Δ,D}`, the higher direct images of
`𝒪_{Y₀}(E - ⌊F⌋ + μ₀^*M)` and the higher cohomology of their push-forward vanish for every Cartier
`M ∼ K_X + Δ + N` with `N - D` `f`-ample: `E + μ₀^*M ∼ K_Y + Γ + μ₀^*N`. -/
private theorem isZero_rightDerived_of_isIso_compl_supp [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X) [IsIntegral Y₀]
    [IsLocallyNoetherian Y₀] [IsNormal Y₀] [IsDominant μ₀]
    (hX : IsNormalVariety k sX) (hsm : IsSmoothScheme sX) (hΔ : IsReducedSNC sX Δ)
    (hD0 : ∀ P, 0 ≤ D.coeff P) (hDns : ContainsNoStratum Δ D.supp)
    (hlog : MMP.Fourfold.IsLogResolution sX (Divisor.toQDivisor Δ + D) μ₀)
    (hY : IsNormalVariety k (μ₀ ≫ sX)) (hμ : IsBirationalMorphism μ₀)
    (hD : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ D.supp)
    {Γ E : Divisor Y₀} {F : QDivisor Y₀} (hΓ : IsZeroLogDiscrepancyDivisor sX μ₀ hY hμ Δ Γ)
    (hE : IsAdjointDiscrepancyDivisor sX μ₀ hY hμ Δ Γ E) (hF : D.IsPullback μ₀ hD F)
    (hiso : IsIso (μ₀ ∣_ D.supp.compl))
    (N : Divisor X) (hN : N.IsCartier) (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f)
    {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    (M : Divisor X) (hMc : M.IsCartier) (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ M.supp)
    (Mμ : Divisor Y₀) (hMpb : M.IsPullback μ₀ hMμ Mμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Scheme.Modules.pushforward μ₀).rightDerived i).obj
      (E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) + Mμ).divisorialSheaf) ∧
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward μ₀).obj
        (E - MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F) + Mμ).divisorialSheaf)) := by
  haveI : MMP.Mori.IsVariety k sX := hX.1
  haveI : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog.isProjectiveMorphism
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  have hNμ := MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ N
  obtain ⟨Nμ, hNpb⟩ := hN.exists_isPullback hNμ
  obtain ⟨KY, hKY, hlin⟩ := exists_isCanonicalDivisor_linearlyEquivalent sX μ₀ hX hsm hY hμ
    hlog.isSmoothScheme hE N hN hK M hMc hMK hMμ Mμ hMpb hNμ Nμ hNpb
  set R := MMP.Intersection.WeilRDivisor.roundDown (QDivisor.toRDivisor F)
  have hlin' : (E - R + Mμ).LinearlyEquivalent (KY + Γ + Nμ - R) := by
    have h := hlin.add (Divisor.LinearlyEquivalent.refl (-R))
    rw [show E - R + Mμ = E + Mμ + -R by abel, show KY + Γ + Nμ - R = KY + Γ + Nμ + -R by abel]
    exact h
  have e := hlin'.divisorialSheafIso
  obtain ⟨h1, h2⟩ := isZero_rightDerived_canonical sX f hf μ₀ hX hsm hΔ hD0 hDns hlog hY hμ hD hΓ hF
    hiso N hN hND hKY hNμ Nμ hNpb i hi
  exact ⟨h1.of_iso (((Scheme.Modules.pushforward μ₀).rightDerived i).mapIso e),
    h2.of_iso (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).mapIso
      ((Scheme.Modules.pushforward μ₀).mapIso e))⟩

/-- **Vanishing on a resolution which is an isomorphism away from `Supp D`.** On such a log
resolution `μ₀` the adjoint ideal is `μ₀_*𝒪_{Y₀}(G₀)` for `G₀ = E - ⌊μ₀^*D⌋`, and the higher
cohomology of `μ₀_*𝒪_{Y₀}(G₀ + μ₀^*M)` vanishes for every Cartier `M ∼ K_X + Δ + N` with
`N - D` `f`-ample. -/
private theorem exists_vanishing_of_isIso_compl_supp [IsAlgClosed k] [CharZero k]
    [CompactSpace X] {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z]
    {Δ : Divisor X} {D : QDivisor X} {Y₀ : Scheme.{0}} (μ₀ : Y₀ ⟶ X)
    {J₀ : X.Opens → Set X.functionField} (hJ₀ : IsReducedAdjointIdealOn sX Δ D μ₀ J₀)
    (hiso : IsIso (μ₀ ∣_ D.supp.compl)) :
    ∃ (_ : IsIntegral Y₀) (_ : IsLocallyNoetherian Y₀) (_ : IsNormal Y₀) (_ : IsDominant μ₀)
      (G₀ : Divisor Y₀), J₀ = MMP.Intersection.multiplierIdealSections μ₀ G₀ ∧
      ∀ (N : Divisor X), N.IsCartier →
        (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f →
        ∀ (n : ℕ) (K : Divisor X), K.IsCanonicalDivisor sX n →
        ∀ (M : Divisor X), M.IsCartier → M.LinearlyEquivalent (K + Δ + N) →
        ∀ (hMμ : ∀ C : irreducibleComponents Y₀, μ₀ (componentGenericPoint Y₀ C) ∉ M.supp)
          (Mμ : Divisor Y₀), M.IsPullback μ₀ hMμ Mμ →
        ∀ i : ℕ, 0 < i →
          IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
            ((Scheme.Modules.pushforward μ₀).obj (G₀ + Mμ).divisorialSheaf)) := by
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, i1, i2, i3, i4, hY, hμ, hD, Γ, E, F, hΓ, hE, hF, rfl⟩ :=
    hJ₀
  refine ⟨i1, i2, i3, i4, _, rfl, ?_⟩
  intro N hN hND n K hK M hMc hMK hMμ Mμ hMpb i hi
  exact (isZero_rightDerived_of_isIso_compl_supp sX f hf μ₀ hX hsm hΔ hD0 hDns hlog hY hμ hD hΓ
    hE hF hiso N hN hND hK M hMc hMK hMμ Mμ hMpb i hi).2

/-- **Vanishing for the twisted adjoint ideal.** For `f : X ⟶ Z` projective with `Z` affine, an
integral Cartier `N` with `N - D` `f`-ample and a Cartier `M ∼ K_X + Δ + N`, the higher
cohomology of `μ_*𝒪_Y(G + μ^*M) = 𝒥_{Δ,D}(K_X + Δ + N)` vanishes. -/
private theorem isZero_rightDerived_twist [IsAlgClosed k] [CharZero k] [CompactSpace X]
    {Z : Scheme.{0}} (f : X ⟶ Z) (hf : IsProjectiveMorphism f) [IsAffine Z] {Δ : Divisor X}
    {D : QDivisor X} {Y : Scheme.{0}} (μ : Y ⟶ X) [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] [IsDominant μ] {J : X.Opens → Set X.functionField}
    (hJ : IsReducedAdjointIdealOn sX Δ D μ J) (G : Divisor Y)
    (hG : J = MMP.Intersection.multiplierIdealSections μ G) (N : Divisor X) (hN : N.IsCartier)
    (hND : (Divisor.toQDivisor N - D).HasRelativelyAmpleMultiple f) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (M : Divisor X) (hMc : M.IsCartier)
    (hMK : M.LinearlyEquivalent (K + Δ + N))
    (hMμ : ∀ C : irreducibleComponents Y, μ (componentGenericPoint Y C) ∉ M.supp)
    (Mμ : Divisor Y) (hMpb : M.IsPullback μ hMμ Mμ) (i : ℕ) (hi : 0 < i) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
      ((Scheme.Modules.pushforward μ).obj (G + Mμ).divisorialSheaf)) := by
  obtain ⟨hX, hsm, hΔ, hD0, hDns, hlog, -, -, -, -, hY, hμ, -⟩ := id hJ
  -- an ample invertible sheaf on `X`
  obtain ⟨m, hm, L, hLc, hLeq, hLamp⟩ := hND
  haveI : IsProper f := isProper_of_isProjectiveMorphism f hf
  haveI := hLc.isInvertibleModule_divisorialSheaf
  have hLX : Stacks.Ample.IsAmple X L.divisorialSheaf :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f _
      (stacks_of_isRelativelyAmple f _ hLamp)
  -- the good resolution
  obtain ⟨Y₀, μ₀, hlog₀, hiso⟩ :=
    exists_isLogResolution_isIso_compl_supp sX hX hsm hΔ D hD0 L.divisorialSheaf hLX
  obtain ⟨J₀, hJ₀⟩ :=
    exists_isReducedAdjointIdealOn_of_isLogResolution sX Δ D hX hsm hΔ hD0 hDns μ₀ hlog₀
  have hJJ₀ : J = J₀ :=
    (MMP.Fourfold.isReducedAdjointIdealOn_operations sX).2.2.1 Δ D μ μ₀ J J₀ hJ hJ₀
  obtain ⟨_, _, _, _, G₀, hG₀, hvan⟩ := exists_vanishing_of_isIso_compl_supp sX f hf μ₀ hJ₀ hiso
  haveI : IsProper μ₀ := isProper_of_isProjectiveMorphism μ₀ hlog₀.isProjectiveMorphism
  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace μ₀
  obtain ⟨Mμ₀, hMμ₀⟩ := hMc.exists_isPullback
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ₀ M)
  have hsec : MMP.Intersection.multiplierIdealSections μ (G + Mμ) =
      MMP.Intersection.multiplierIdealSections μ₀ (G₀ + Mμ₀) :=
    multiplierIdealSections_add_pullback_congr hMc hMpb hMμ₀ (hG.symm.trans (hJJ₀.trans hG₀))
  obtain ⟨e⟩ := nonempty_iso_pushforward_of_multiplierIdealSections_eq μ μ₀
    hμ.functionFieldMap_bijective hlog₀.isBirationalMorphism.functionFieldMap_bijective _ _ hsec
  exact IsZero.of_iso (hvan N hN ⟨m, hm, L, hLc, hLeq, hLamp⟩ n K hK M hMc hMK _ Mμ₀ hMμ₀ i hi)
    (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).mapIso e)

end Vanishing

/-! ### Relative ampleness of sums, multiples and linearly equivalent divisors -/

section RelAmple

open RingedSpaceModuleAdjunction Stacks.Ample Stacks.RelativeVeryAmple

private theorem isRelativelyAmple_tensorModules_of_isAffineHom {S X Y W : Scheme.{0}}
    {f : X ⟶ S} {g : Y ⟶ S} {a : W ⟶ X} {b : W ⟶ Y} (h : a ≫ f = b ≫ g)
    [IsAffineHom (Limits.pullback.lift a b h)] (L : X.Modules) (N : Y.Modules)
    [IsInvertibleModule X L] [IsInvertibleModule Y N]
    (hL : Stacks.RelativeAmple.IsRelativelyAmple f L)
    (hN : Stacks.RelativeAmple.IsRelativelyAmple g N) :
    Stacks.RelativeAmple.IsRelativelyAmple (a ≫ f)
      (tensorModules W ((modulePullback a.toLRSHom.toShHom).obj L)
        ((modulePullback b.toLRSHom.toShHom).obj N)) := by
  have h1 := Stacks.AmpleFibreNeighbourhood.isRelativelyAmple_pullbackModule_of_isAffineHom
    (Limits.pullback.lift a b h) (Limits.pullback.fst f g ≫ f) _
    (Stacks.AmpleExternalTensor.isRelativelyAmple_externalTensor f g L N hL hN)
  have e := Stacks.AmpleExternalTensor.pullbackExternalTensorIso f g
    (Limits.pullback.lift a b h) L N
  simp only [Limits.pullback.lift_fst, Limits.pullback.lift_snd] at e
  rw [← Category.assoc, Limits.pullback.lift_fst] at h1
  exact (isRelativelyAmple_congr _ _ _ e).mp h1

/-- For a quasi-compact separated morphism `f`, the sum of two `f`-ample Cartier divisors is
`f`-ample: `𝒪(A + B) ≅ Δ^*(𝒪(A) ⊠ 𝒪(B))` and the diagonal of `f` is affine. -/
private theorem isRelativelyAmple_add {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {A B : Divisor X} (hA : A.IsCartier) (hAf : A.IsRelativelyAmple f hA)
    (hB : B.IsCartier) (hBf : B.IsRelativelyAmple f hB) :
    (A + B).IsRelativelyAmple f (hA.add hB) := by
  haveI := hA.isInvertibleModule_divisorialSheaf
  haveI := hB.isInvertibleModule_divisorialSheaf
  haveI := (hA.add hB).isInvertibleModule_divisorialSheaf
  haveI : IsAffineHom (Limits.pullback.lift (𝟙 X) (𝟙 X) (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f)) :=
    show IsAffineHom (Limits.pullback.diagonal f) from inferInstance
  have h := isRelativelyAmple_tensorModules_of_isAffineHom (rfl : 𝟙 X ≫ f = 𝟙 X ≫ f) _ _
    (stacks_of_isRelativelyAmple f _ hAf) (stacks_of_isRelativelyAmple f _ hBf)
  rw [Category.id_comp] at h
  refine MMP.Mori.IsRelativelyAmple.of_stacks _ _ ((isRelativelyAmple_congr _ _ _ ?_).mp h)
  exact tensorModulesMapIso X (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _)
    (modulePullbackIso _ _ ≪≫ (Scheme.Modules.pullbackId X).app _) ≪≫
    hA.divisorialSheafTensorIso hB

/-- For a quasi-compact separated morphism `f`, every positive multiple of an `f`-ample Cartier
divisor is `f`-ample. -/
private theorem isRelativelyAmple_nsmul {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} [QuasiCompact f]
    [IsSeparated f] {L : Divisor X} (hL : L.IsCartier) (hLf : L.IsRelativelyAmple f hL)
    (n : ℕ) (hn : 0 < n) : (n • L).IsRelativelyAmple f (hL.nsmul n) := by
  induction n with
  | zero => exact absurd hn (lt_irrefl 0)
  | succ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn'
    · simpa using hLf
    · convert isRelativelyAmple_add _ (ih hn') _ hLf using 2
      rw [succ_nsmul]

/-- Relative ampleness of a Cartier divisor does not depend on the proof that it is Cartier, and
is transported along equalities of divisors. -/
private theorem isRelativelyAmple_of_eq {S X : Scheme.{0}}
    [CompactSpace X] [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ S} {A B : Divisor X}
    (hAB : A = B) (hA : A.IsCartier) (hB : B.IsCartier) (hAf : A.IsRelativelyAmple f hA) :
    B.IsRelativelyAmple f hB := by
  subst hAB; exact hAf

/-- Relative ampleness is invariant under linear equivalence. -/
private theorem isRelativelyAmple_add_principalDivisor {X Z : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ Z) {L : Divisor X} (hLc : L.IsCartier)
    (hL : L.IsRelativelyAmple f hLc) (u : (MMP.Mori.RationalFunctions X)ˣ) :
    (L + MMP.Mori.principalDivisor u).IsRelativelyAmple f
      (hLc.add (Divisor.isCartier_principalDivisor u)) := by
  haveI := hLc.isInvertibleModule_divisorialSheaf
  haveI := (hLc.add (Divisor.isCartier_principalDivisor u)).isInvertibleModule_divisorialSheaf
  intro y
  obtain ⟨V, hV, hyV, hamp⟩ := hL y
  refine ⟨V, hV, hyV, ?_⟩
  have e : (L + MMP.Mori.principalDivisor u).divisorialSheaf ≅ L.divisorialSheaf :=
    Divisor.divisorialSheafMulIso u fun E => by
      rw [DivisorWithCoeffs.coeff_add, MMP.Mori.coeff_principalDivisor]
  exact (Stacks.RelativeVeryAmple.isAmple_congr _ _
    ((RingedSpaceModuleAdjunction.modulePullback (f ⁻¹ᵁ V).ι.toLRSHom.toShHom).mapIso e)).mpr
    hamp

end RelAmple

/-! ### Scalars and the scalar span of a linear series -/

section Scalars

open MMP.Mori MMP.Fourfold

variable {k : Type} [Field k] {X : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- The rational function of a scalar `a ∈ k`. -/
private noncomputable def constFn (a : k) : X.functionField :=
  baseFunction sX ((Scheme.ΓSpecIso (.of k)).inv.hom a)

private theorem constFn_mul (a b : k) : constFn sX (a * b) = constFn sX a * constFn sX b := by
  simp [constFn, baseFunction]

private theorem constFn_one : constFn sX (1 : k) = 1 := by
  simp [constFn, baseFunction]

omit [IsLocallyNoetherian X] [IsNormal X] in
/-- The germ at the generic point of a section over `U` is regular along every prime divisor
meeting `U`. -/
private theorem divisorialValuation_germ_le_one {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (P : MMP.Mori.PrimeDivisor Y) {U : Y.Opens}
    (hP : P.genericPoint ∈ U) (hU : genericPoint Y ∈ U) (s : Γ(Y, U)) :
    P.divisorialValuation (Y.presheaf.germ U (genericPoint Y) hU s) ≤ 1 := by
  rw [PrimeDivisor.divisorialValuation_le_one_iff]
  refine ⟨Y.presheaf.germ U P.genericPoint hP s, ?_⟩
  change (Y.presheaf.stalkSpecializes _).hom ((Y.presheaf.germ U P.genericPoint hP).hom s) = _
  rw [← CommRingCat.comp_apply, TopCat.Presheaf.germ_stalkSpecializes]

private theorem valuationOver_constFn_le_one {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (μ : Y ⟶ X) [IsDominant μ] (P : MMP.Mori.PrimeDivisor Y)
    (a : k) : P.valuationOver μ (constFn sX a) ≤ 1 := by
  rw [PrimeDivisor.valuationOver_apply, constFn, baseFunction,
    MMP.Fourfold.functionFieldMap_germ μ ⊤ trivial trivial]
  exact divisorialValuation_germ_le_one P (U := μ ⁻¹ᵁ ⊤) trivial trivial _

private theorem divisorialValuation_constFn_le_one (P : MMP.Mori.PrimeDivisor X) (a : k) :
    P.divisorialValuation (constFn sX a) ≤ 1 :=
  divisorialValuation_germ_le_one P (U := ⊤) trivial trivial _

/-- The `k`-span of a set of rational functions, as an additive subgroup. -/
private noncomputable def constSpan (V : AddSubgroup X.functionField) :
    AddSubgroup X.functionField :=
  AddSubgroup.closure {h | ∃ (a : k) (g : X.functionField), g ∈ V ∧ h = constFn sX a * g}

private theorem le_constSpan (V : AddSubgroup X.functionField) : V ≤ constSpan sX V :=
  fun g hg => AddSubgroup.subset_closure ⟨1, g, hg, by rw [constFn_one, one_mul]⟩

/-- A valuation bounded on `V`, and at most one on scalars, is bounded on the `k`-span of `V`. -/
private theorem valuation_le_of_mem_constSpan (v : Valuation X.functionField (WithZero (Multiplicative ℤ)))
    (hv : ∀ a : k, v (constFn sX a) ≤ 1) {V : AddSubgroup X.functionField} {B : WithZero (Multiplicative ℤ)}
    (hV : ∀ g ∈ V, v g ≤ B) : ∀ g ∈ constSpan sX V, v g ≤ B := by
  intro g hg
  induction hg using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, g, hg, rfl⟩ := hx
    rw [map_mul]
    calc v (constFn sX a) * v g ≤ 1 * B := mul_le_mul' (hv a) (hV g hg)
      _ = B := one_mul B
  | zero => simp
  | add x y _ _ hx hy => exact v.map_add_le hx hy
  | neg x _ hx => rwa [Valuation.map_neg]

private theorem constFn_mul_mem_constSpan (V : AddSubgroup X.functionField) (a : k)
    {g : X.functionField} (hg : g ∈ constSpan sX V) : constFn sX a * g ∈ constSpan sX V := by
  induction hg using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨b, g, hg, rfl⟩ := hx
    exact AddSubgroup.subset_closure ⟨a * b, g, hg, by rw [constFn_mul, mul_assoc]⟩
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | neg x _ hx => rw [mul_neg]; exact neg_mem hx

/-- The adjoint ideal of a linear series is that of its `k`-span: the span has the same fixed
divisor, the same free part and a smaller base locus. -/
private theorem isSeriesAdjointIdealOn_constSpan {Δ D : Divisor X}
    {V : AddSubgroup X.functionField} {c : ℚ} {Y : Scheme.{0}} {μ : Y ⟶ X}
    {J : X.Opens → Set X.functionField} (h : IsSeriesAdjointIdealOn sX Δ D V c μ J) :
    IsSeriesAdjointIdealOn sX Δ D (constSpan sX V) c μ J := by
  obtain ⟨hX, hsm, hΔ, hDc, hVs, hVns, hc, i1, i2, i3, i4, hY, hμ, hD, Dμ, F, Γ, E, hDμ,
    ⟨hlog, hfix, hfree, hsncF⟩, hΓ, hE, hJ⟩ := h
  refine ⟨hX, hsm, hΔ, hDc, ?_, ?_, hc, i1, i2, i3, i4, hY, hμ, hD, Dμ, F, Γ, E, hDμ,
    ⟨hlog, ?_, ?_, hsncF⟩, hΓ, hE, hJ⟩
  · intro g hg P
    exact valuation_le_of_mem_constSpan sX P.divisorialValuation
      (divisorialValuation_constFn_le_one sX P) (fun g hg => hVs hg P) g hg
  · exact fun S hS hsub => hVns S hS (hsub.trans fun x hx g hg hg0 =>
      hx g (le_constSpan sX V hg) hg0)
  · intro P
    obtain ⟨h1, g, hg, hg0, heq⟩ := hfix P
    exact ⟨valuation_le_of_mem_constSpan sX (P.valuationOver μ)
      (valuationOver_constFn_le_one sX μ P) h1, g, le_constSpan sX V hg, hg0, heq⟩
  · intro y
    obtain ⟨g, hg, hg0, h⟩ := hfree y
    exact ⟨g, le_constSpan sX V hg, hg0, h⟩

end Scalars

/-- A nonzero polynomial over an infinite field has a point where it does not vanish. -/
private theorem exists_eval_ne_zero {k : Type} [Field k] [Infinite k] {n : ℕ}
    {Q : MvPolynomial (Fin n) k} (hQ : Q ≠ 0) : ∃ a : Fin n → k, MvPolynomial.eval a Q ≠ 0 := by
  by_contra h
  push Not at h
  exact hQ (MvPolynomial.funext fun a => by simp [h a])

/-! ### Sections of a twisted push-forward -/

section Sections

open MMP.Mori MMP.Fourfold

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- A divisor on a normal locally Noetherian scheme is its own pull-back along the identity. -/
private theorem divisor_isPullback_id (D : Divisor X)
    (hD : ∀ C : irreducibleComponents X, (𝟙 X) (componentGenericPoint X C) ∉ D.supp) :
    D.IsPullback (𝟙 X) hD D := by
  intro U φ hφ E hE
  have hηU : componentGenericPoint X E.component ∈ U := E.map_componentGenericPoint_mem (𝟙 X) hE
  have hW : componentGenericPoint X E.component ∈ E.component.1 :=
    (isGenericPoint_componentGenericPoint X E.component).mem
  let a := Units.map (RationalFunctions.component X E.component).toMonoidHom φ
  have ha : (stalkToRationalFunctions X hW).hom a = (φ : RationalFunctions X) E.component := by
    simp [stalkToRationalFunctions, a, RationalFunctions.component]
  rw [pullbackComponent_eq hD hφ hηU hW a ha, hφ E hE, PrimeDivisor.ord_eq_ordUnit]
  congr 1
  ext
  simp [a]
  rfl

/-- **Algebraic Hartogs, pulled back.** A rational function regular along every prime divisor
meeting `U` has valuation at most one along every prime divisor of `Y` meeting `μ⁻¹ U`. -/
private theorem valuationOver_le_one_of_mem (μ : Y ⟶ X) [IsDominant μ] {U : X.Opens}
    {r : X.functionField} (hr : r ∈ MMP.Intersection.multiplierIdealSections (𝟙 X) 0 U)
    (P : MMP.Mori.PrimeDivisor Y) (hP : (P.support ∩ μ ⁻¹ᵁ U).Nonempty) :
    P.valuationOver μ r ≤ 1 := by
  have hyU : μ P.genericPoint ∈ U := (P.genericPoint_mem_iff (μ ⁻¹ᵁ U)).mpr hP
  have hreg : r ∈ (algebraMap (X.presheaf.stalk (μ P.genericPoint)) X.functionField).range := by
    refine Scheme.mem_range_algebraMap_stalk_of_forall_coheight_eq_one _ fun z hz hzy => ?_
    let Q : MMP.Mori.PrimeDivisor X := AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hz
    have hQη : Q.genericPoint = z := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hz
    have hzU : z ∈ U := hzy.mem_open U.isOpen hyU
    have hQ := hr.2 Q (MMP.Intersection.support_inter_nonempty_of_genericPoint_mem Q
      (by rw [hQη]; exact hzU))
    rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply] at hQ
    rw [← hQη, ← MMP.Mori.PrimeDivisor.divisorialValuation_le_one_iff]
    simpa using hQ
  obtain ⟨a, ha⟩ := hreg
  rw [PrimeDivisor.valuationOver_apply, ← ha,
    MMP.Mori.functionFieldMap_algebraMap_stalk μ P.genericPoint a]
  exact (P.divisorialValuation_le_one_iff _).mpr ⟨_, rfl⟩

/-- Regular functions on `U` multiply the sections of `μ_*𝒪_Y(G)` over `U`. -/
private theorem mul_mem_multiplierIdealSections (μ : Y ⟶ X) [IsDominant μ] (G : Divisor Y)
    {U : X.Opens} {r j : X.functionField}
    (hr : r ∈ MMP.Intersection.multiplierIdealSections (𝟙 X) 0 U)
    (hj : j ∈ MMP.Intersection.multiplierIdealSections μ G U) :
    r * j ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  refine ⟨fun h => by rw [hj.1 h, mul_zero], fun P hP => ?_⟩
  rw [map_mul]
  calc P.valuationOver μ r * P.valuationOver μ j ≤ 1 * WithZero.exp (G.coeff P) :=
        mul_le_mul' (valuationOver_le_one_of_mem μ hr P hP) (hj.2 P hP)
    _ = _ := one_mul _

/-- The sections of `μ_*𝒪_Y(G)` over `U` are closed under the `ℤ`-span. -/
private theorem mem_multiplierIdealSections_of_mem_span (μ : Y ⟶ X) [IsDominant μ]
    (G : Divisor Y) {U : X.Opens} {S : Set X.functionField}
    (hS : S ⊆ MMP.Intersection.multiplierIdealSections μ G U) {g : X.functionField}
    (hg : g ∈ Submodule.span ℤ S) : g ∈ MMP.Intersection.multiplierIdealSections μ G U := by
  induction hg using Submodule.span_induction with
  | mem x hx => exact hS hx
  | zero => exact ⟨fun _ => rfl, fun P _ => by simp⟩
  | add x y _ _ hx hy =>
    exact ⟨fun h => by rw [hx.1 h, hy.1 h, add_zero],
      fun P hP => (P.valuationOver μ).map_add_le (hx.2 P hP) (hy.2 P hP)⟩
  | smul n x _ hx =>
    refine ⟨fun h => by rw [hx.1 h, smul_zero], fun P hP => ?_⟩
    induction n using Int.induction_on with
    | zero => simp
    | succ k hk => rw [add_smul, one_smul]; exact (P.valuationOver μ).map_add_le hk (hx.2 P hP)
    | pred k hk => rw [sub_smul, one_smul]; exact (P.valuationOver μ).map_sub_le hk (hx.2 P hP)

/-- **Sections of the twisted ideal.** If the sections of `J` lie in `μ_*𝒪_Y(G)`, the
`ℤ`-span of the products of sections of `𝒪_X(M)` and of `J` over `W`, for a Cartier divisor `M`
with pull-back `Mμ`, lies in `μ_*𝒪_Y(G + Mμ)(W)`. -/
private theorem span_subset_multiplierIdealSections_add (μ : Y ⟶ X) [IsDominant μ]
    (G : Divisor Y) (J : X.Opens → Set X.functionField)
    (hJ : ∀ W, J W ⊆ MMP.Intersection.multiplierIdealSections μ G W) {M : Divisor X}
    (hMc : M.IsCartier) {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (hMpb : M.IsPullback μ hM Mμ) (W : X.Opens) :
    (Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 X) M W * J W) :
      Set X.functionField) ⊆ MMP.Intersection.multiplierIdealSections μ (G + Mμ) W := by
  intro h hh
  refine mem_multiplierIdealSections_of_mem_span μ _ ?_ hh
  rintro _ ⟨u, hu, j, hj, rfl⟩
  choose V hxV φ hφ using hMc
  refine mem_multiplierIdealSections_of_local μ _ (fun x => W ⊓ V x)
    (fun x hx => ⟨⟨hx, hxV x⟩, inf_le_left⟩) (fun hW => by simp [(hJ W hj).1 ((preimage_eq_bot_iff μ W).2 hW)]) fun x hx => ?_
  have hne : W ⊓ V x ≠ ⊥ := (Opens.ne_bot_iff_nonempty _).2 ⟨x, hx, hxV x⟩
  set Z : irreducibleComponents X := MMP.Mori.pointComponent x
  have hid := divisor_isPullback_id M
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp (𝟙 X) M)
  have hu' : u ∈ MMP.Intersection.multiplierIdealSections (𝟙 X) (0 + M) (W ⊓ V x) := by
    rw [zero_add]; exact multiplierIdealSections_mono (𝟙 X) M inf_le_left hne hu
  rw [mem_multiplierIdealSections_add_iff hid (hφ x) Z 0 inf_le_right] at hu'
  rw [mem_multiplierIdealSections_add_iff hMpb (hφ x) Z G inf_le_right, ← mul_assoc]
  exact mul_mem_multiplierIdealSections μ G hu'
    (multiplierIdealSections_mono μ G inf_le_left hne (hJ W hj))

/-- **Global sections of the twisted ideal.** A global section of `μ_*𝒪_Y(G + Mμ)` lies, near
every point, in the span of products of sections of `𝒪_X(M)` and of `J`, if `J` agrees with
`μ_*𝒪_Y(G)` on nonempty opens. -/
private theorem exists_mem_span_of_mem_multiplierIdealSections_add (μ : Y ⟶ X) [IsDominant μ]
    (G : Divisor Y) (J : X.Opens → Set X.functionField)
    (hJ : ∀ (W : X.Opens), W ≠ ⊥ → MMP.Intersection.multiplierIdealSections μ G W ⊆ J W)
    {M : Divisor X} (hMc : M.IsCartier)
    {hM : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ M.supp}
    {Mμ : Divisor Y} (hMpb : M.IsPullback μ hM Mμ) {s : X.functionField}
    (hs : s ∈ MMP.Intersection.multiplierIdealSections μ (G + Mμ) ⊤) (x : X) :
    ∃ W : X.Opens, x ∈ W ∧
      s ∈ Submodule.span ℤ (MMP.Intersection.multiplierIdealSections (𝟙 X) M W * J W) := by
  obtain ⟨V, hxV, φ, hφ⟩ := hMc x
  refine ⟨V, hxV, Submodule.subset_span ?_⟩
  have hne : V ≠ ⊥ := (Opens.ne_bot_iff_nonempty _).2 ⟨x, hxV⟩
  set Z : irreducibleComponents X := MMP.Mori.pointComponent x
  set c := MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X) with hc
  have hc0 : c ≠ 0 := (φ.isUnit.map _).ne_zero
  have hid := divisor_isPullback_id M
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp (𝟙 X) M)
  refine ⟨c⁻¹, ?_, c * s, ?_, by show c⁻¹ * (c * s) = s; rw [← mul_assoc, inv_mul_cancel₀ hc0, one_mul]⟩
  · rw [← zero_add M, mem_multiplierIdealSections_add_iff hid hφ Z 0 le_rfl, ← hc,
      mul_inv_cancel₀ hc0]
    exact ⟨fun h => absurd ((preimage_eq_bot_iff (𝟙 X) V).1 h) hne, fun P _ => by simp⟩
  · refine hJ V hne ?_
    rw [← mem_multiplierIdealSections_add_iff hMpb hφ Z G le_rfl]
    exact multiplierIdealSections_mono μ _ le_top hne hs

end Sections

/-! ### Global generation read on rational functions -/

section Generation

open MMP.Mori MMP.Fourfold

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]

/-- The germ at the generic point of a section over `W` is a section of `𝒪_X` over `W`. -/
private theorem germ_mem_multiplierIdealSections {W : X.Opens} (hW : genericPoint X ∈ W)
    (r : Γ(X, W)) :
    X.presheaf.germ W (genericPoint X) hW r ∈ MMP.Intersection.multiplierIdealSections (𝟙 X) 0 W := by
  refine ⟨fun h => absurd ((preimage_eq_bot_iff (𝟙 X) W).1 h)
    ((Opens.ne_bot_iff_nonempty _).2 ⟨_, hW⟩), fun P hP => ?_⟩
  rw [MMP.Mori.PrimeDivisor.valuationOver_apply, MMP.Mori.functionFieldMap_id_apply]
  exact (divisorialValuation_germ_le_one P (U := W)
    (MMP.Intersection.genericPoint_mem_of_support_inter_nonempty P hP) hW r).trans
    (le_of_eq (by simp))

/-- **Global generation on rational functions.** If `μ_*𝒪_Y(L)` is globally generated, for a
dominant `μ` inducing an isomorphism of function fields, then every section `h` of `μ_*𝒪_Y(L)`
over `W ∋ x` is, on a smaller neighbourhood `W'` of `x`, a sum of products of regular functions
on `W'` and global sections. -/
private theorem exists_mem_span_of_isGloballyGenerated (μ : Y ⟶ X) [IsDominant μ]
    (hμ : Function.Bijective (functionFieldMap μ)) (L : Divisor Y)
    (hgg : MMP.Intersection.IsGloballyGenerated
      ((Scheme.Modules.pushforward μ).obj L.divisorialSheaf))
    {x : X} {W : X.Opens} (hxW : x ∈ W) {h : X.functionField}
    (hh : h ∈ MMP.Intersection.multiplierIdealSections μ L W) :
    ∃ W' : X.Opens, x ∈ W' ∧ W' ≤ W ∧ h ∈ Submodule.span ℤ
      (MMP.Intersection.multiplierIdealSections (𝟙 X) 0 W' *
        MMP.Intersection.multiplierIdealSections μ L ⊤) := by
  classical
  have hXW : genericPoint X ∈ W := by
    haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
    exact MMP.Intersection.genericPoint_mem_opens W
  have hYW := genericPoint_mem_preimage μ hXW
  let t : Γ((Scheme.Modules.pushforward μ).obj L.divisorialSheaf, W) :=
    ⟨ofFF (μ ⁻¹ᵁ W) (functionFieldMap μ h),
      (mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ L W _ (topIndex Y hYW) h
        (evFF_ofFF _ _ _).symm).2 hh⟩
  obtain ⟨W', hW'W, hxW', N, s, r, heq⟩ := hgg x trivial W hxW t
  have hXW' : genericPoint X ∈ W' := by
    haveI : Nonempty W' := ⟨⟨x, hxW'⟩⟩
    exact MMP.Intersection.genericPoint_mem_opens W'
  have hYW' := genericPoint_mem_preimage μ hXW'
  have hYtop : genericPoint Y ∈ μ ⁻¹ᵁ (⊤ : X.Opens) := trivial
  -- the rational functions of the global sections
  let g : Fin N → X.functionField := fun i =>
    (RingEquiv.ofBijective (functionFieldMap μ) hμ).symm (evFF (s i).1 (topIndex Y hYtop))
  have hg : ∀ i, functionFieldMap μ (g i) = evFF (s i).1 (topIndex Y hYtop) := fun i =>
    (RingEquiv.ofBijective (functionFieldMap μ) hμ).apply_symm_apply _
  have hgmem : ∀ i, g i ∈ MMP.Intersection.multiplierIdealSections μ L ⊤ := fun i =>
    (mem_divisorialSubmodule_iff_mem_multiplierIdealSections μ L ⊤ (s i).1 (topIndex Y hYtop)
      (g i) (hg i)).1 (s i).2
  -- read the equality of sections at the generic point
  have key : functionFieldMap μ h = functionFieldMap μ
      (∑ i, X.presheaf.germ W' (genericPoint X) hXW' (r i) * g i) := by
    let ev : Γ((Scheme.Modules.pushforward μ).obj L.divisorialSheaf, W') →+ Y.functionField :=
      AddMonoidHom.mk' (fun σ => evFF (Subtype.val σ) (topIndex Y hYW'))
        fun a b => evFF_add a.1 b.1 _
    have h1 := congrArg ev heq
    rw [map_sum] at h1
    have hl : ev ((((Scheme.Modules.pushforward μ).obj L.divisorialSheaf).presheaf.map
        (homOfLE hW'W).op).hom t) = functionFieldMap μ h := evFF_ofFF _ _ _
    rw [hl] at h1
    rw [h1, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hg i, MMP.Fourfold.functionFieldMap_germ μ W' hXW' hYW']
    change evFF ((μ.app W' (r i)) • _) (topIndex Y hYW') = _
    rw [evFF_smul]
    congr 1
  have hinj := hμ.1 key
  refine ⟨W', hxW', hW'W, ?_⟩
  rw [hinj]
  exact Submodule.sum_mem _ fun i _ => Submodule.subset_span
    ⟨_, germ_mem_multiplierIdealSections hXW' (r i), g i, hgmem i, rfl⟩

end Generation

/-! ### The projection formula for divisorial sheaves -/

section ProjectionFormula

open Stacks.Ample Stacks.RelativeVeryAmple MMP.Mori

variable {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]

/-- **The projection formula for divisorial sheaves.** For a Cartier divisor `H` on `X` with
pull-back `Hμ`, `μ_*𝒪_Y(E) ⊗ 𝒪_X(H)^{⊗ j} ≅ μ_*𝒪_Y(E + j Hμ)`. -/
private theorem nonempty_tensorModules_pushforward_iso (μ : Y ⟶ X) [IsDominant μ]
    {H : Divisor X} (hH : H.IsCartier)
    {hHs : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ H.supp}
    {Hμ : Divisor Y} (hHμ : H.IsPullback μ hHs Hμ) {E : Divisor Y} (hE : E.IsCartier) (j : ℕ) :
    haveI := hH.isInvertibleModule_divisorialSheaf
    Nonempty (tensorModules X ((Scheme.Modules.pushforward μ).obj E.divisorialSheaf)
        (tensorPowModule X H.divisorialSheaf (j : ℤ)) ≅
      (Scheme.Modules.pushforward μ).obj (E + (j : ℤ) • Hμ).divisorialSheaf) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  have hHj : ((j : ℤ) • H).IsCartier := hH.zsmul j
  haveI := hHj.isInvertibleModule_divisorialSheaf
  have hpb := Divisor.IsPullback.zsmul hH hHμ (j : ℤ)
    (MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp μ _)
  have e1 : tensorPowModule X H.divisorialSheaf (j : ℤ) ≅ ((j : ℤ) • H).divisorialSheaf :=
    (divisorialSheafNsmulIso hH j).symm ≪≫ eqToIso (by rw [natCast_zsmul])
  have e2 := asIso ((MMP.SemiampleSections.projectionFormulaNatTrans μ
    ((j : ℤ) • H).divisorialSheaf).app E.divisorialSheaf)
  have e3 : (Scheme.Modules.pullback μ).obj ((j : ℤ) • H).divisorialSheaf ≅
      ((j : ℤ) • Hμ).divisorialSheaf := (hpb.divisorialSheafIso (hBc := hHj)).symm
  have e4 := hE.divisorialSheafTensorIso (hpb.isCartier hHj)
  exact ⟨tensorModulesMapIso X (Iso.refl _) e1 ≪≫ e2 ≪≫ (Scheme.Modules.pushforward μ).mapIso
    (((Stacks.SheafOfModules.Tensor.sheafTensor _).obj E.divisorialSheaf).mapIso e3 ≪≫ e4)⟩

end ProjectionFormula

/-! ### Very ample divisors over an affine base, over a Noetherian ring -/

section VeryAmple

open Stacks.AmpleProjectiveImmersion Stacks.AlgebraicGeometry.ProjTwistTensorPow

/-- **A relatively very ample sheaf comes from `ℙᴺ` over a Noetherian ring.** For a proper
`f : X ⟶ Z` from a variety to an affine scheme, an immersion `X ⟶ ℙᴺ_Z` over `Z` pulling `𝒪(1)`
back to `L` descends to a closed immersion `X ⟶ ℙᴺ_R`, `R` a finitely generated `k`-algebra,
still pulling `𝒪(1)` back to `L`. -/
private theorem exists_isClosedImmersion_isNoetherianRing {k : Type} [Field k]
    {X Z : Scheme.{0}} (sX : X ⟶ Spec (.of k)) [IsIntegral X] (hX : MMP.Mori.IsVariety k sX)
    (f : X ⟶ Z) [IsProper f] [IsAffine Z] (L : X.Modules) (hL : HasImmersionTwistOver f L) :
    ∃ (R : Type) (_ : CommRing R) (_ : IsNoetherianRing R) (N : ℕ)
      (ι : X ⟶ projectiveSpaceOverRing N (.of R)), IsClosedImmersion ι ∧
      Nonempty (L ≅ (Scheme.Modules.pullback ι).obj (twistOver N (Spec (.of R)) 1)) := by
  obtain ⟨N, i, hi, hover, ⟨e⟩⟩ := hL
  have : IsClosedImmersion i :=
    Stacks.AmpleFormalSystemEmbeddedTuple.isClosedImmersion_of_isImmersion_over (f := f) i hi
      hover
  obtain ⟨Z', sZ', g, j, hZ', hZ'a, -, hj, -, hjs⟩ :=
    exists_isClosedImmersion_isAffine_isVariety sX hX i
  haveI := hZ'a
  haveI := hj
  have e' : L ≅ (Scheme.Modules.pullback j).obj (twistOver N Z' 1) :=
    e ≪≫ (Scheme.Modules.pullbackComp i (pullback.snd _ _)).app _ ≪≫ eqToIso (by rw [hjs]) ≪≫
      ((Scheme.Modules.pullbackComp j (pullback.snd _ _)).app _).symm
  obtain ⟨ι', hι', ⟨e''⟩⟩ := MMP.Fourfold.exists_isClosedImmersion_projectiveSpaceOverRing j L e'
  haveI : LocallyOfFiniteType sZ' := hZ'.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Z' := LocallyOfFiniteType.isLocallyNoetherian sZ'
  have : IsNoetherianRing Γ(Z', ⊤) :=
    IsLocallyNoetherian.component_noetherian (⟨⊤, isAffineOpen_top Z'⟩ : Z'.affineOpens)
  exact ⟨Γ(Z', ⊤), inferInstance, this, N, ι', hι', ⟨e''⟩⟩

end VeryAmple

/-- A relatively very ample divisor over an affine base is relatively ample. -/
private theorem isRelativelyAmple_of_hasImmersionTwistOver {X Z : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ Z) [IsAffine Z] [LocallyOfFiniteType f]
    [QuasiCompact f] {H : Divisor X} (hHc : H.IsCartier)
    (hH : haveI := hHc.isInvertibleModule_divisorialSheaf
      Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f H.divisorialSheaf) :
    H.IsRelativelyAmple f hHc := by
  haveI := hHc.isInvertibleModule_divisorialSheaf
  obtain ⟨N, i, hi, hover, ⟨e⟩⟩ := hH
  have h5 : ∃ d : ℕ, 1 ≤ d ∧ Stacks.AmpleProjectiveImmersion.HasImmersionTwistOver f
      (Stacks.Ample.tensorPowModule X H.divisorialSheaf (d : ℤ)) :=
    ⟨1, le_rfl, N, i, hi, hover, ⟨Stacks.Ample.tensorPowModuleOneIso X _ ≪≫ e⟩⟩
  exact MMP.Mori.IsRelativelyAmple.of_stacks _ _
    (((Stacks.AmpleRelativeFiniteType.tfae_six f H.divisorialSheaf).out 5 2).1 h5)

/-- **The twist minus the general member is ample.** For `A` and `H` relatively ample and
`D_p = pD + div u`, the `ℚ`-divisor `D + A + jH - D_p/p` has the relatively ample multiple
`p(A + jH) - div u`. -/
private theorem hasRelativelyAmpleMultiple_add_sub_smul {X Z : Scheme.{0}} [CompactSpace X]
    [IsLocallyNoetherian X] [IsNormal X] (f : X ⟶ Z) [QuasiCompact f] [IsSeparated f]
    (D : Divisor X) {A H : Divisor X} (hAc : A.IsCartier) (hA : A.IsRelativelyAmple f hAc)
    (hHc : H.IsCartier) (hH : H.IsRelativelyAmple f hHc) (j p : ℕ) (hp : 0 < p)
    (u : (MMP.Mori.RationalFunctions X)ˣ) :
    (Divisor.toQDivisor (D + A + (j : ℤ) • H) - ((1 : ℚ) / p) •
      Divisor.toQDivisor ((p : ℤ) • D + MMP.Mori.principalDivisor u)).HasRelativelyAmpleMultiple
      f := by
  have hAj : (A + (j : ℤ) • H).IsRelativelyAmple f (hAc.add (hHc.zsmul j)) := by
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · exact isRelativelyAmple_of_eq (by simp) hAc _ hA
    · exact isRelativelyAmple_of_eq (by rw [natCast_zsmul]) _ _
        (isRelativelyAmple_add hAc hA (hHc.nsmul j) (isRelativelyAmple_nsmul hHc hH j hj))
  have hpA := isRelativelyAmple_nsmul _ hAj p hp
  have hL := isRelativelyAmple_add_principalDivisor f _ hpA u⁻¹
  refine ⟨p, hp, _, _, ?_, hL⟩
  have hp' : (p : ℚ) ≠ 0 := by exact_mod_cast hp.ne'
  ext P
  simp only [map_add, map_sub, map_nsmul, map_zsmul, DivisorWithCoeffs.coeff_add,
    DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
    MMP.Mori.principalDivisor_inv, DivisorWithCoeffs.coeff_neg,
    MMP.Mori.coeff_principalDivisor, smul_eq_mul, Int.cast_add, Int.cast_mul, Int.cast_neg,
    Int.cast_natCast, nsmul_eq_mul]
  simp only [zsmul_eq_mul, Int.cast_natCast]
  field_simp
  ring

/-- In a graded linear series, `g ∈ V_b` gives `gʲ ∈ V_{bj}`. -/
private theorem pow_mem_of_isGradedLinearSeries {X Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Z} {D : Divisor X}
    {V : ℕ → AddSubgroup X.functionField} (hV : MMP.Fourfold.IsGradedLinearSeries f D V) {b : ℕ}
    {g : X.functionField} (hg : g ∈ V b) (j : ℕ) : g ^ j ∈ V (b * j) := by
  induction j with
  | zero => simpa using hV.2.2.1
  | succ j ih => simpa [pow_succ, mul_add] using hV.2.2.2 _ _ _ _ ih hg

/-- A graded linear series which is nonzero in degree `b` is nonzero in every degree divisible
by `b`. -/
private theorem ne_bot_of_isGradedLinearSeries {X Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {f : X ⟶ Z} {D : Divisor X}
    {V : ℕ → AddSubgroup X.functionField} (hV : MMP.Fourfold.IsGradedLinearSeries f D V) {b p : ℕ}
    (hb : V b ≠ ⊥) (hbp : b ∣ p) : V p ≠ ⊥ := by
  obtain ⟨g, hgV, hg0⟩ := (AddSubgroup.bot_or_exists_ne_zero (V b)).resolve_left hb
  obtain ⟨c, rfl⟩ := hbp
  exact fun hbot => pow_ne_zero c hg0 <|
    (AddSubgroup.mem_bot).1 (hbot ▸ pow_mem_of_isGradedLinearSeries hV hgV c)

section MainProof

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

open MMP.Mori MMP.Fourfold

/-- **Castelnuovo–Mumford regularity for a twisted push-forward.** Let `ι : X ⟶ ℙᴺ_R` be a
closed immersion, `R` Noetherian, pulling `𝒪(1)` back to `𝒪_X(H)`, with `dim X ≤ n`, and let
`μ : Y ⟶ X` be proper. If `Hⁱ(X, μ_*𝒪_Y(E + jμ^*H)) = 0` for all `i > 0` and `j ≥ 0`, then
`μ_*𝒪_Y(E + nμ^*H)` is globally generated: by the projection formula its twist by `𝒪_X(mH)` is
`μ_*𝒪_Y(E + (n + m)μ^*H)`, so it is `0`-regular. -/
private theorem isGloballyGenerated_pushforward_add_zsmul_pullback {X Y : Scheme.{0}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [CompactSpace Y]
    (μ : Y ⟶ X) [IsDominant μ] [IsProper μ] {H : Divisor X} (hH : H.IsCartier)
    {hHs : ∀ Z : irreducibleComponents Y, μ (componentGenericPoint Y Z) ∉ H.supp}
    {Hμ : Divisor Y} (hHμ : H.IsPullback μ hHs Hμ) {E : Divisor Y} (hE : E.IsCartier)
    {R : Type} [CommRing R] [IsNoetherianRing R] {N : ℕ}
    (ι : X ⟶ projectiveSpaceOverRing N (.of R)) [IsClosedImmersion ι]
    (eL : H.divisorialSheaf ≅ (Scheme.Modules.pullback ι).obj
      (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver N (Spec (.of R)) 1))
    (n : ℕ) (hdim : topologicalKrullDim X ≤ (n : WithBot ℕ∞))
    (hvan : ∀ j : ℕ, ∀ i : ℕ, 0 < i →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived i).obj
        ((Scheme.Modules.pushforward μ).obj (E + (j : ℤ) • Hμ).divisorialSheaf))) :
    MMP.Intersection.IsGloballyGenerated
      ((Scheme.Modules.pushforward μ).obj (E + (n : ℤ) • Hμ).divisorialSheaf) := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  haveI := (hE.add ((hHμ.isCartier hH).zsmul n)).isInvertibleModule_divisorialSheaf
  haveI : (E + (n : ℤ) • Hμ).divisorialSheaf.IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isInvertible Y _
  haveI : ((Scheme.Modules.pushforward μ).obj (E + (n : ℤ) • Hμ).divisorialSheaf).IsCoherent :=
    ProperCoherenceWitness.isCoherent_pushforward μ _
  refine MMP.Fourfold.isGloballyGenerated_of_regular_of_isClosedImmersion ι H.divisorialSheaf
    eL _ n hdim fun m hm i hi => ?_
  obtain ⟨j, hj⟩ : ∃ j : ℕ, (j : ℤ) = n + m := ⟨(n + m).toNat, Int.toNat_of_nonneg (by omega)⟩
  obtain ⟨en⟩ := nonempty_tensorModules_pushforward_iso μ hH hHμ hE n
  obtain ⟨ej⟩ := nonempty_tensorModules_pushforward_iso μ hH hHμ hE j
  have e : Stacks.RelativeVeryAmple.tensorModules X
      ((Scheme.Modules.pushforward μ).obj (E + (n : ℤ) • Hμ).divisorialSheaf)
      (Stacks.Ample.tensorPowModule X H.divisorialSheaf m) ≅
      (Scheme.Modules.pushforward μ).obj (E + (j : ℤ) • Hμ).divisorialSheaf :=
    Stacks.RelativeVeryAmple.tensorModulesMapIso X en.symm (Iso.refl _) ≪≫
      Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
      Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
        (Stacks.Ample.tensorPowModuleAddIso X _ (n : ℤ) m ≪≫
          Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ hj.symm) ≪≫ ej
  exact IsZero.of_iso ((Stacks.Cohomology.CechAcyclic.isZero_rightDerived_evaluation_iff_isZero_Hgroup
    X.ringCatSheaf ⊤ i _).1 (hvan j i hi)) ((Hfunctor X.ringCatSheaf ⊤ i).mapIso e)

end MainProof

