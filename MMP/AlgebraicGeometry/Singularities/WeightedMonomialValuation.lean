module
public import MMP.AlgebraicGeometry.Singularities.MonomialValuationSnc
public import MMP.AlgebraicGeometry.Resolution.Blowup.VarietyProjective
public import MMP.AlgebraicGeometry.Singularities.DivisorOverValuationIso
public import MMP.AlgebraicGeometry.MMP.Fourfold.CrepantPluriform
public import MMP.AlgebraicGeometry.Resolution.MonomialIdealSNC
public import MMP.AlgebraicGeometry.Resolution.Blowup.SmoothCanonical

/-!
# Weighted monomial valuations: divisoriality and log discrepancy

Let `Y` be a normal variety over a field `k`, `V ⊆ Y` an irreducible closed subset of
codimension two at whose generic point `η_V` the local ring `𝒪_{Y,η_V}` is regular with regular
parameters `(x, t)`, and `j ≥ 1`. The monomial valuation `v = v_{x,t;j}` of weights `(j, 1)` is
the valuation `ord_E` of the last exceptional divisor `E` of the weighted blowup of `(x^j, t)`;
in particular it is a normalized divisorial valuation of `k(Y)` whose centre on `Y` is `V`.
Indeed every `f ∈ I_M` (generated by the monomials `tⁱ xˡ` with `i + j l ≥ M`) is `t^M a` with
`a ∈ 𝒪[x/tʲ]`, and `v(t) = exp (-1)`; so the valuation ring of `v` is a localization of
`𝒪[x/tʲ]`, essentially of finite type over `k`, dominating `𝒪`. Blowing up an ideal that makes
its generators regular on a chart, then normalizing, realizes `v` over `η_V`.

If moreover `(Y, Θ)` is a pair, `Θ = ∑ₕ bₕ Sₕ`, and `fₕ ∈ 𝒪_{Y,η_V}` is a local equation of
`Sₕ` at `η_V`, then `a(v; Y, Θ) = 1 + j - ∑ₕ bₕ v(fₕ)`: a local generator `ω = dx ∧ dt ∧ ⋯` of
the top forms at `η_V` has `ord_E(f^*ω) = j` (in the chart `x = x₁t^j` it becomes
`t^j dx₁ ∧ dt ∧ ⋯`), and the pull-back of `Θ` has coefficient `∑ₕ bₕ v(fₕ)` along `E`.

## Main results

* `MMP.Fourfold.IsWeightedMonomialValuation.isNormalizedDivisorialValuation_and_isCentre`
* `MMP.Fourfold.IsWeightedMonomialValuation.hasLogDiscrepancy`

## Implementation notes

* The valuation `v` is Mathlib's multiplicative `Valuation k(Y) ℤᵐ⁰`, so the integer `v(fₕ)` is
  `-WithZero.log (v fₕ)`; it is `0` when `fₕ` is a unit.
* A local equation of `Sₕ` at `η_V` is a generator of the stalk at `η_V` of the ideal sheaf of
  `Sₕ`; the sum runs over the prime divisors in the support of `Θ`.
* The base is an arbitrary field `k` (of characteristic zero, through `IsPair`, for the log
  discrepancy), which covers the source's `ℂ`.
* "`a(v; Y, Θ) = a`" is `MMP.Fourfold.HasLogDiscrepancy`: `v` is the valuation of a divisor over
  `Y`, realized with a proper birational morphism, whose log discrepancy is `a`.

## References

* [Kollár, *Lectures on resolution of singularities*], 1.10.
-/

section

universe u w

open CategoryTheory AlgebraicGeometry TopologicalSpace
open scoped WithZero
open MMP.Resolution
open MMP.Mori MMP.Flips

namespace MMP.Fourfold

section Algebra

variable {O : Type*} [CommRing O]

private theorem mem_monomialIdeal_zero (x t f : O) (j : ℕ) : f ∈ monomialIdeal t x j 0 := by
  have : monomialIdeal t x j 0 = ⊤ :=
    (Ideal.eq_top_iff_one _).mpr (Ideal.subset_span ⟨0, 0, le_rfl, by simp⟩)
  exact this ▸ Submodule.mem_top

private theorem monomialIdeal_antitone (x t : O) (j : ℕ) {ν μ : ℕ} (h : ν ≤ μ) :
    monomialIdeal t x j μ ≤ monomialIdeal t x j ν :=
  Ideal.span_mono fun _ ⟨i, l, hil, hr⟩ => ⟨i, l, h.trans hil, hr⟩

private theorem le_monomialValuation {x t f : O} {j ν : ℕ} (h : f ∈ monomialIdeal t x j ν) :
    (ν : ℕ∞) ≤ monomialValuation t x j f :=
  le_iSup₂ (f := fun (μ : ℕ) (_ : f ∈ monomialIdeal t x j μ) => (μ : ℕ∞)) ν h

/-- A finite value of the monomial valuation is attained. -/
private theorem mem_monomialIdeal_of_monomialValuation_eq {x t f : O} {j M : ℕ}
    (h : monomialValuation t x j f = M) : f ∈ monomialIdeal t x j M := by
  by_contra hf
  rcases Nat.eq_zero_or_pos M with rfl | hM
  · exact hf (mem_monomialIdeal_zero x t f j)
  have hle : monomialValuation t x j f ≤ ((M - 1 : ℕ) : ℕ∞) := by
    refine iSup₂_le fun ν hν => ?_
    have : ν < M := by
      by_contra hle
      exact hf (monomialIdeal_antitone x t j (not_lt.mp hle) hν)
    exact_mod_cast Nat.le_sub_one_of_lt this
  rw [h] at hle
  norm_cast at hle
  omega

/-- In a Noetherian local ring of dimension two whose maximal ideal is `(x, t)`, the parameter
`t` does not lie in `(t², x)`; in particular `t ∉ I₂`. -/
private theorem notMem_monomialIdeal_two [IsLocalRing O] [IsNoetherianRing O] {x t : O} {j : ℕ}
    (hj : 1 ≤ j) (hspan : Ideal.span {x, t} = IsLocalRing.maximalIdeal O)
    (hdim : ringKrullDim O = 2) : t ∉ monomialIdeal t x j 2 := by
  intro ht
  have hle : monomialIdeal t x j 2 ≤ Ideal.span {t * t, x} := by
    refine Ideal.span_le.mpr ?_
    rintro r ⟨i, l, hil, rfl⟩
    rcases Nat.eq_zero_or_pos l with rfl | hl
    · obtain ⟨n, rfl⟩ : ∃ n, i = n + 2 := ⟨i - 2, by omega⟩
      rw [pow_zero, mul_one, pow_add, pow_two]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · obtain ⟨n, rfl⟩ : ∃ n, l = n + 1 := ⟨l - 1, by omega⟩
      rw [pow_succ]
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp (hle ht)
  have htm : t ∈ IsLocalRing.maximalIdeal O := hspan ▸ Ideal.subset_span (by simp)
  have hu : IsUnit (1 - a * t) := by
    by_contra hnu
    have h1 : (1 - a * t) ∈ IsLocalRing.maximalIdeal O := hnu
    exact (IsLocalRing.maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).mpr (by
      simpa using Ideal.add_mem _ h1 (Ideal.mul_mem_left _ a htm)))
  have htx : t ∈ Ideal.span {x} := by
    obtain ⟨u, hu⟩ := hu
    have h1 : (1 - a * t) * t = b * x := by linear_combination (-1 : O) * hab
    have : t = (↑u⁻¹ * b) * x := by
      calc t = ↑u⁻¹ * (↑u * t) := by rw [← mul_assoc, Units.inv_mul, one_mul]
        _ = _ := by rw [hu, h1, mul_assoc]
    exact this ▸ Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self x)
  have hm : IsLocalRing.maximalIdeal O = Ideal.span {x} := by
    rw [← hspan]
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono (by simp))
    rintro r (rfl | rfl)
    · exact Ideal.mem_span_singleton_self r
    · exact htx
  have h1 := ringKrullDim_le_spanFinrank_maximalIdeal O
  rw [hdim, hm] at h1
  have h2 : (Ideal.span {x} : Ideal O).spanFinrank ≤ 1 := by
    have := Submodule.spanFinrank_span_le_ncard_of_finite (R := O) (Set.finite_singleton x)
    simpa using this
  have h3 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
    h1.trans (by exact_mod_cast h2)
  exact absurd (by exact_mod_cast h3 : (2 : ℕ) ≤ 1) (by norm_num)

variable {K : Type*} [Field K] [Algebra O K]

/-- Every element of `I_M` is `t^M a` with `a ∈ 𝒪[x / tʲ]`. -/
private theorem exists_eq_pow_mul_of_mem_monomialIdeal {x t f : O} {j M : ℕ}
    (ht : algebraMap O K t ≠ 0) (hf : f ∈ monomialIdeal t x j M) :
    ∃ a ∈ Algebra.adjoin O {algebraMap O K x / algebraMap O K t ^ j},
      algebraMap O K f = algebraMap O K t ^ M * a := by
  induction hf using Submodule.span_induction with
  | mem r hr =>
    obtain ⟨i, l, hil, rfl⟩ := hr
    obtain ⟨n, hn⟩ := Nat.exists_eq_add_of_le hil
    have hy : algebraMap O K x / algebraMap O K t ^ j ∈
        Algebra.adjoin O {algebraMap O K x / algebraMap O K t ^ j} :=
      Algebra.self_mem_adjoin_singleton O _
    refine ⟨algebraMap O K t ^ n * (algebraMap O K x / algebraMap O K t ^ j) ^ l,
      Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ t) _)
        (Subalgebra.pow_mem _ hy _), ?_⟩
    have h1 : algebraMap O K t ^ M * algebraMap O K t ^ n =
        algebraMap O K t ^ i * (algebraMap O K t ^ j) ^ l := by
      rw [← pow_add, ← hn, ← pow_mul, pow_add]
    rw [← mul_assoc, h1, mul_assoc, ← mul_pow, mul_div_cancel₀ _ (pow_ne_zero _ ht), map_mul,
      map_pow, map_pow]
  | zero => exact ⟨0, Subalgebra.zero_mem _, by simp⟩
  | add a b _ _ ha hb =>
    obtain ⟨a', ha', ea⟩ := ha
    obtain ⟨b', hb', eb⟩ := hb
    exact ⟨a' + b', Subalgebra.add_mem _ ha' hb', by rw [map_add, ea, eb, mul_add]⟩
  | smul r a _ ha =>
    obtain ⟨a', ha', ea⟩ := ha
    exact ⟨algebraMap O K r * a', Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ r) ha',
      by rw [smul_eq_mul, map_mul, ea]; ring⟩

/-- If `v ≤ 1` on `𝒪` and on `y`, then `v ≤ 1` on `𝒪[y]`. -/
private theorem valuation_aeval_le_one (v : Valuation K ℤᵐ⁰)
    (hle : ∀ a : O, v (algebraMap O K a) ≤ 1) {y : K} (hy : v y ≤ 1) (p : Polynomial O) :
    v (Polynomial.aeval y p) ≤ 1 := by
  induction p using Polynomial.induction_on with
  | C a => simpa using hle a
  | add p q hp hq => rw [map_add]; exact (v.map_add _ _).trans (max_le hp hq)
  | monomial n a _ =>
    rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X, map_mul, map_pow]
    exact mul_le_one' (hle a) (pow_le_one' hy _)

section MonomialValuation

variable {v : Valuation K ℤᵐ⁰} {x t : O} {j : ℕ}

/-- If `v(f) = exp (-v_{x,t;j}(f))` on `𝒪 \ {0}`, then `v ≤ exp (-ν)` on `I_ν`. -/
private theorem valuation_le_exp_of_mem_monomialIdeal
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ)))
    {ν : ℕ} {f : O} (hf : f ∈ monomialIdeal t x j ν) :
    v (algebraMap O K f) ≤ WithZero.exp (-(ν : ℤ)) := by
  by_cases hf0 : f = 0
  · simp [hf0]
  obtain ⟨M, hM, hvM⟩ := hval f hf0
  have h := le_monomialValuation hf
  rw [hM] at h
  norm_cast at h
  rw [hvM, WithZero.exp_le_exp]
  omega

private theorem valuation_le_one_of_monomialValuation
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) (a : O) :
    v (algebraMap O K a) ≤ 1 := by
  simpa using valuation_le_exp_of_mem_monomialIdeal hval (mem_monomialIdeal_zero x t a j)

/-- `v < 1` on `(x, t) ⊆ I₁`. -/
private theorem valuation_lt_one_of_mem_span_pair
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) (hj : 1 ≤ j) {a : O}
    (ha : a ∈ Ideal.span {x, t}) :
    v (algebraMap O K a) < 1 := by
  have hI1 : Ideal.span {x, t} ≤ monomialIdeal t x j 1 := Ideal.span_le.mpr <| by
    rintro r (rfl | rfl)
    · exact Ideal.subset_span ⟨0, 1, by simpa using hj, by simp⟩
    · exact Ideal.subset_span ⟨1, 0, by simp, by simp⟩
  refine (valuation_le_exp_of_mem_monomialIdeal hval (hI1 ha)).trans_lt ?_
  rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
  norm_num

/-- **`v(t) = exp (-1)`.** In a two-dimensional Noetherian local ring with `𝔪 = (x, t)`, the
parameter `t` lies in `I₁` but not in `I₂`. -/
private theorem valuation_eq_exp_neg_one [IsLocalRing O] [IsNoetherianRing O]
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) (hj : 1 ≤ j)
    (hspan : Ideal.span {x, t} = IsLocalRing.maximalIdeal O) (hdim : ringKrullDim O = 2) :
    v (algebraMap O K t) = WithZero.exp (-1) := by
  have ht2 := notMem_monomialIdeal_two hj hspan hdim
  obtain ⟨M, hM, hvM⟩ := hval t fun h => ht2 (h ▸ Submodule.zero_mem _)
  have hM2 : M < 2 := by
    by_contra h
    exact ht2 (monomialIdeal_antitone x t j (not_lt.mp h)
      (mem_monomialIdeal_of_monomialValuation_eq hM))
  have h1 := valuation_le_exp_of_mem_monomialIdeal hval
    (show t ∈ monomialIdeal t x j 1 from Ideal.subset_span ⟨1, 0, by simp, by simp⟩)
  rw [hvM, WithZero.exp_le_exp] at h1
  obtain rfl : M = 1 := by omega
  simpa using hvM

private theorem exp_neg_natCast_eq_pow (n : ℕ) :
    WithZero.exp (-(n : ℤ)) = (WithZero.exp (-1) : ℤᵐ⁰) ^ n := by
  rw [← WithZero.exp_nsmul]; congr 1; simp

/-- **`v(x / tʲ) ≤ 1`.** -/
private theorem valuation_div_pow_le_one (hvt : v (algebraMap O K t) = WithZero.exp (-1))
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) :
    v (algebraMap O K x / algebraMap O K t ^ j) ≤ 1 := by
  have ht : algebraMap O K t ≠ 0 := v.ne_zero_iff.mp (hvt ▸ WithZero.exp_ne_zero)
  have hvx := valuation_le_exp_of_mem_monomialIdeal hval
    (show x ∈ monomialIdeal t x j j from Ideal.subset_span ⟨0, 1, by simp, by simp⟩)
  set y : K := algebraMap O K x / algebraMap O K t ^ j with hy_def
  have h1 : v y * v (algebraMap O K t) ^ j ≤ 1 * v (algebraMap O K t) ^ j := by
    rw [one_mul, ← map_pow, ← map_mul, hy_def, div_mul_cancel₀ _ (pow_ne_zero _ ht), map_pow,
      hvt, ← exp_neg_natCast_eq_pow]
    exact hvx
  exact le_of_mul_le_mul_of_pos_right h1 (by rw [hvt]; exact pow_pos (by simp) _)

/-- **Fractions of value `≤ 1` are quotients over `𝒪[x / tʲ]`.** If `v(a / b) ≤ 1` for nonzero
`a, b ∈ 𝒪`, then `a / b = p(y) / q(y)` with `v(q(y)) = 1`, where `y = x / tʲ`. -/
private theorem exists_aeval_eq_aeval_mul_div (hvt : v (algebraMap O K t) = WithZero.exp (-1))
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) {a b : O} (ha : a ≠ 0) (hb0 : b ≠ 0)
    (hg : v (algebraMap O K a / algebraMap O K b) ≤ 1) :
    ∃ p q : Polynomial O,
      v (Polynomial.aeval (algebraMap O K x / algebraMap O K t ^ j) q) = 1 ∧
      Polynomial.aeval (algebraMap O K x / algebraMap O K t ^ j) p =
        Polynomial.aeval (algebraMap O K x / algebraMap O K t ^ j) q *
          (algebraMap O K a / algebraMap O K b) := by
  have ht : algebraMap O K t ≠ 0 := v.ne_zero_iff.mp (hvt ▸ WithZero.exp_ne_zero)
  set y : K := algebraMap O K x / algebraMap O K t ^ j with hy_def
  obtain ⟨A, hA, hvA⟩ := hval a ha
  obtain ⟨B, hB, hvB⟩ := hval b hb0
  obtain ⟨pa, hpa, ea⟩ := exists_eq_pow_mul_of_mem_monomialIdeal (K := K) ht
    (mem_monomialIdeal_of_monomialValuation_eq hA)
  obtain ⟨pb, hpb, eb⟩ := exists_eq_pow_mul_of_mem_monomialIdeal (K := K) ht
    (mem_monomialIdeal_of_monomialValuation_eq hB)
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hpa hpb
  obtain ⟨p, rfl⟩ := hpa
  obtain ⟨q, rfl⟩ := hpb
  have hvq : v (Polynomial.aeval y q) = 1 := by
    have h := congrArg v eb
    rw [map_mul, map_pow, hvt, ← exp_neg_natCast_eq_pow, hvB] at h
    exact mul_left_cancel₀ WithZero.exp_ne_zero (h.symm.trans (mul_one _).symm)
  have hq0 : Polynomial.aeval y q ≠ 0 := fun h0 => by simp [h0] at hvq
  have hBA : B ≤ A := by
    rw [map_div₀, hvA, hvB, ← WithZero.exp_sub, ← WithZero.exp_zero, WithZero.exp_le_exp] at hg
    omega
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le hBA
  replace ea : algebraMap O K a = algebraMap O K t ^ (B + n) * Polynomial.aeval y p := ea
  replace eb : algebraMap O K b = algebraMap O K t ^ B * Polynomial.aeval y q := eb
  refine ⟨Polynomial.C t ^ n * p, q, hvq, ?_⟩
  simp only [map_mul, map_pow, Polynomial.aeval_C]
  rw [ea, eb, pow_add]
  field_simp

end MonomialValuation

/-- **The valuation ring of `v_{x,t;j}` is essentially of finite type.** If `v(t) = exp (-1)` and
`v(f) = exp (-v_{x,t;j}(f))` for every nonzero `f ∈ 𝒪`, then `{g | v g ≤ 1}` is the image of a
localization of `𝒪[X]` (with `X ↦ x / tʲ`), a `k`-algebra essentially of finite type when `𝒪`
is. -/
private theorem exists_essFiniteType_range {k O K : Type u} [Field k] [CommRing O] [IsDomain O]
    [Field K] [Algebra O K] [IsFractionRing O K] [Algebra k O] [Algebra k K] [IsScalarTower k O K]
    [Algebra.EssFiniteType k O] (v : Valuation K ℤᵐ⁰) {x t : O} {j : ℕ}
    (hvt : v (algebraMap O K t) = WithZero.exp (-1))
    (hval : ∀ f : O, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      v (algebraMap O K f) = WithZero.exp (-(M : ℤ))) :
    ∃ (S : Type u) (_ : CommRing S) (_ : Algebra k S) (_ : Algebra.EssFiniteType k S)
      (φ : S →ₐ[k] K), ∀ g, v g ≤ 1 ↔ g ∈ φ.range := by
  have hle := valuation_le_one_of_monomialValuation hval
  set y : K := algebraMap O K x / algebraMap O K t ^ j
  have hvy : v y ≤ 1 := valuation_div_pow_le_one hvt hval
  let N : Submonoid K :=
    { carrier := {g | v g = 1}
      mul_mem' := fun {a b} (ha : v a = 1) (hb : v b = 1) => by
        change v (a * b) = 1
        rw [map_mul, ha, hb, one_mul]
      one_mem' := v.map_one }
  let ψ : Polynomial O →+* K := (Polynomial.aeval y).toRingHom
  let Mp : Submonoid (Polynomial O) := N.comap ψ
  have hunit : ∀ m : Mp, IsUnit (ψ m) := fun m => isUnit_iff_ne_zero.mpr fun h0 => by
    have h1 : v (ψ m) = 1 := m.2
    simp [h0] at h1
  let S := Localization Mp
  let lift : S →+* K := IsLocalization.lift (M := Mp) (S := S) hunit
  have hlift : ∀ p, lift (algebraMap _ S p) = ψ p := IsLocalization.lift_eq hunit
  haveI : Algebra.EssFiniteType k (Polynomial O) := Algebra.EssFiniteType.comp k O _
  let φ : S →ₐ[k] K :=
    { lift with
      commutes' := fun c => by
        change lift (algebraMap k S c) = _
        rw [IsScalarTower.algebraMap_apply k (Polynomial O) S, hlift,
          IsScalarTower.algebraMap_apply k O (Polynomial O)]
        change Polynomial.aeval y _ = _
        rw [(Polynomial.aeval y).commutes, ← IsScalarTower.algebraMap_apply] }
  refine ⟨S, inferInstance, inferInstance, inferInstance, φ, fun g => ⟨fun hg => ?_, ?_⟩⟩
  · obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := O) g
    by_cases ha : a = 0
    · exact ⟨0, by simp [ha]⟩
    obtain ⟨p, q, hvq, e⟩ :=
      exists_aeval_eq_aeval_mul_div hvt hval ha (nonZeroDivisors.ne_zero hb) hg
    refine ⟨IsLocalization.mk' S p (⟨q, hvq⟩ : Mp), ?_⟩
    change lift _ = _
    rw [IsLocalization.lift_mk'_spec]
    exact e
  · rintro ⟨s, rfl⟩
    obtain ⟨⟨p, q⟩, rfl⟩ := IsLocalization.mk'_surjective Mp s
    have h := (IsLocalization.lift_mk'_spec (S := S) (g := ψ) hunit p
      (lift (IsLocalization.mk' S p q)) q).mp rfl
    have hq : v (ψ q) = 1 := q.2
    have h2 := congrArg v h
    rw [map_mul, hq, one_mul] at h2
    change v (lift _) ≤ 1
    rw [← h2]
    exact valuation_aeval_le_one v hle hvy p

end Algebra

section Realization

/-! ### Realizing the valuation over a dominated point

A valuation `v` of `k(X)` with value group `ℤ` whose valuation ring is essentially of finite type
over `k` and dominates `𝒪_{X,x}` is `ord_F` for a prime divisor `F` on a normal variety projective
and birational over `X` with `F` lying over `x`: blow up an ideal making the generators of the
valuation ring regular on a chart, then normalize. -/

/-- A local ring of an integral scheme `Y` birational to `X` which, inside the function field, is
the valuation ring of a valuation of `k(X)` is a valuation ring. -/
private theorem valuationRing_stalk_of_forall_le_one_iff {X Y : Scheme.{w}}
    [IsIntegral X] [IsIntegral Y] (β : Y ⟶ X) (hβ : IsBirationalMorphism β)
    {Γ : Type*} [LinearOrderedCommGroupWithZero Γ] (v : Valuation X.functionField Γ) (q : Y)
    (hq : haveI : IsDominant β := hβ.isDominant
      ∀ g : X.functionField, v g ≤ 1 ↔
        ∃ a : Y.presheaf.stalk q, algebraMap _ Y.functionField a = functionFieldMap β g) :
    ValuationRing (Y.presheaf.stalk q) := by
  haveI : IsDominant β := hβ.isDominant
  let φ := RingEquiv.ofBijective (functionFieldMap β) hβ.functionFieldMap_bijective
  let w : Valuation Y.functionField Γ := v.comap φ.symm.toRingHom
  have hw : ∀ r, w r ≤ 1 ↔ ∃ a : Y.presheaf.stalk q, algebraMap _ Y.functionField a = r := by
    intro r
    have := hq (φ.symm r)
    rwa [show functionFieldMap β (φ.symm r) = φ (φ.symm r) from rfl,
      RingEquiv.apply_symm_apply] at this
  exact ValuationRing.of_integers w
    ⟨IsFractionRing.injective _ _, fun a => (hw _).2 ⟨a, rfl⟩, fun r hr => (hw r).1 hr⟩

/-- A morphism of integral schemes, locally of finite type and birational in the sense of
`AlgebraicGeometry.IsBirational`, is a birational morphism. -/
private theorem isBirationalMorphism_of_isBirational {X Y : Scheme.{w}} [IsIntegral X]
    [IsIntegral Y] (f : X ⟶ Y) [LocallyOfFiniteType f] (hf : IsBirational f) :
    IsBirationalMorphism f := by
  haveI : Finite (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
  haveI : Finite (irreducibleComponents Y) := by
    rw [irreducibleComponents_eq_singleton]; exact Set.finite_singleton _
  obtain ⟨U, V, hUV, hU, hV, hiso⟩ :=
    exists_dense_opens_isIso_resLE_of_isBirational f hf (Or.inl ⟨inferInstance, inferInstance⟩)
  exact isBirationalMorphism_of_isIso_resLE f U V hU.nonempty hV.nonempty hUV hiso

/-- An ideal of the sections over an affine open extends to an ideal sheaf: the kernel of the
closed subscheme `Spec (Γ(X, U) ⧸ J) ⟶ X`, i.e. the ideal sheaf of its scheme-theoretic closure. -/
private theorem exists_idealSheafData_ideal_eq {X : Scheme.{w}} [QuasiSeparatedSpace X]
    (U : X.affineOpens) (J : Ideal Γ(X, U)) : ∃ ℐ : X.IdealSheafData, ℐ.ideal U = J := by
  have hU : IsAffineOpen (U : X.Opens) := U.2
  let φ := CommRingCat.ofHom (Ideal.Quotient.mk J)
  let π : Spec (.of (Γ(X, U) ⧸ J)) ⟶ X := Spec.map φ ≫ hU.fromSpec
  refine ⟨π.ker, ?_⟩
  rw [Scheme.Hom.ker_apply]
  ext a
  rw [RingHom.mem_ker]
  have hle : (⊤ : (Spec (.of (Γ(X, U) ⧸ J))).Opens) ≤ π ⁻¹ᵁ U := by
    intro y _
    change hU.fromSpec ((Spec.map φ) y) ∈ (U : X.Opens)
    exact hU.range_fromSpec.subset ⟨_, rfl⟩
  have hres : (π.app U).hom a = 0 ↔ (π.appLE U ⊤ hle).hom a = 0 := by
    have heq : (homOfLE hle) = eqToHom (top_le_iff.mp hle).symm := Subsingleton.elim _ _
    rw [Scheme.Hom.appLE, heq, CommRingCat.comp_apply]
    exact (map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
      ((Spec (.of (Γ(X, U) ⧸ J))).presheaf.map (eqToHom (top_le_iff.mp hle).symm).op)).1).symm
  have hcomp : π.appLE U ⊤ hle = (Scheme.ΓSpecIso Γ(X, U)).inv ≫ (Spec.map φ).appTop := by
    rw [Scheme.Hom.comp_appLE, hU.fromSpec_app_self, Category.assoc]
    congr 1
  rw [hres, hcomp, CommRingCat.comp_apply]
  have hnat := congrArg (fun g => g.hom ((Scheme.ΓSpecIso Γ(X, U)).inv.hom a))
    (Scheme.ΓSpecIso_naturality φ)
  simp only [CommRingCat.comp_apply, Iso.inv_hom_id_apply] at hnat
  rw [← map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
    (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, U) ⧸ J))).hom).1]
  erw [hnat]
  rw [CommRingCat.comp_apply]
  erw [Iso.inv_hom_id_apply]
  exact Ideal.Quotient.eq_zero_iff_mem (I := J)

/-- A unit of a ring mapping into the valuation ring of `w` maps to an element of value `1`. -/
private theorem valuation_eq_one_of_isUnit {S L : Type*} [CommRing S] [Field L] {Γ : Type*}
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (φ : S →+* L)
    (hφ : ∀ s, w (φ s) ≤ 1) {t : S} (ht : IsUnit t) : w (φ t) = 1 :=
  letI := φ.toAlgebra; Valuation.Integers.one_of_isUnit' ht hφ

/-- Let `φ : S → L` land in the valuation ring of `w`, with `S` essentially of finite type over
`R`. If a subring `C` contains the images of `R` and of the generators of `S`, every `φ s` is a
fraction `c / t` with `c, t ∈ C` and `w t = 1`. -/
private theorem exists_mul_eq_of_essFiniteType {R S L : Type*} [CommRing R] [CommRing S]
    [Algebra R S] [Algebra.EssFiniteType R S] [Field L] {Γ : Type*}
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (φ : S →+* L)
    (hφ : ∀ s, w (φ s) ≤ 1) (C : Subring L) (hR : ∀ r, φ (algebraMap R S r) ∈ C)
    (hσ : ∀ s ∈ Algebra.EssFiniteType.finset R S, φ s ∈ C) (s : S) :
    ∃ c ∈ C, ∃ t ∈ C, w t = 1 ∧ φ s * t = c := by
  have hcond := (Algebra.essFiniteType_cond_iff R S (Algebra.EssFiniteType.finset R S)).mp
    (Algebra.EssFiniteType.isLocalization R S)
  have hadj : ∀ y ∈ Algebra.adjoin R (Algebra.EssFiniteType.finset R S : Set S), φ y ∈ C := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx => exact hσ x hx
    | algebraMap r => exact hR r
    | add x y _ _ hx hy => rw [map_add]; exact C.add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact C.mul_mem hx hy
  obtain ⟨t, ht, htu, hst⟩ := hcond s
  exact ⟨φ (s * t), hadj _ hst, φ t, hadj _ ht, valuation_eq_one_of_isUnit w φ hφ htu,
    (map_mul φ s t).symm⟩

/-- If every element of `J` has value at most that of `h`, every element of `Jⁿ` has value at
most that of `hⁿ`. -/
private theorem valuation_le_pow_of_mem_pow {A L : Type*} [CommRing A] [Field L] {Γ : Type*}
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (ι : A →+* L)
    (hA : ∀ a, w (ι a) ≤ 1) (J : Ideal A) (h : A) (hJ : ∀ y ∈ J, w (ι y) ≤ w (ι h)) :
    ∀ n : ℕ, ∀ y ∈ J ^ n, w (ι y) ≤ w (ι h) ^ n := by
  intro n
  induction n with
  | zero => exact fun y _ => by simpa using hA y
  | succ n ih =>
    intro y hy
    rw [pow_succ] at hy
    refine Submodule.mul_induction_on hy (fun a ha b hb => ?_) (fun a b ha hb => ?_)
    · rw [map_mul, map_mul, pow_succ]
      exact mul_le_mul' (ih a ha) (hJ b hb)
    · rw [map_add]
      exact (w.map_add _ _).trans (max_le ha hb)

/-- The local rings of a scheme locally of finite type over a field `k` are essentially of
finite type over `k`. -/
private theorem essFiniteType_stalkAlgebra {k : Type w} [Field k] {Y : Scheme.{w}}
    (sY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType sY] (y : Y) :
    letI := stalkAlgebra sY y
    Algebra.EssFiniteType k (Y.presheaf.stalk y) := by
  letI := stalkAlgebra sY y
  have := (sY.base y).isPrime
  have h0 : (algebraMap k (Localization.AtPrime (sY.base y).asIdeal)).EssFiniteType := by
    rw [RingHom.essFiniteType_algebraMap]
    exact Algebra.EssFiniteType.of_isLocalization _ (sY.base y).asIdeal.primeCompl
  have hiso : (Spec.stalkIso (.of k) (sY.base y)).inv.hom.EssFiniteType :=
    (RingHom.FiniteType.of_surjective _
      (asIso (Spec.stalkIso (.of k) (sY.base y)).inv).commRingCatIsoToRingEquiv.surjective
      ).essFiniteType
  have h1 : ((Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).presheaf.germ ⊤ (sY.base y) (by simp)).hom.EssFiniteType := by
    have e := congrArg CommRingCat.Hom.hom
      (Spec.algebraMap_stalkIso_inv (R := .of k) (x := sY.base y))
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at e
    rw [← e]
    exact h0.comp hiso
  have h2 := h1.comp (LocallyOfFiniteType.stalkMap sY y)
  rw [← RingHom.essFiniteType_algebraMap]
  convert h2 using 1
  change ((Scheme.ΓSpecIso (.of k)).inv ≫ sY.appTop ≫ Y.presheaf.germ ⊤ y (by simp)).hom = _
  rw [← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.germ_stalkMap]
  rfl

/-- Sections pulled back along a dominant morphism of integral schemes map to the function field
through `functionFieldMap`. -/
private theorem germToFunctionField_appLE {X Y : Scheme.{w}} [IsIntegral X] [IsIntegral Y]
    (f : Y ⟶ X) [IsDominant f] (U : X.Opens) (V : Y.Opens) [Nonempty U] [Nonempty V]
    (h : V ≤ f ⁻¹ᵁ U) (s : Γ(X, U)) :
    Y.germToFunctionField V (f.appLE U V h s) = functionFieldMap f (X.germToFunctionField U s) := by
  obtain ⟨⟨y, hy⟩⟩ := ‹Nonempty V›
  rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := Y) hy,
    ← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) (h hy),
    MMP.Mori.functionFieldMap_algebraMap_stalk]
  congr 1
  erw [Scheme.Hom.germ_stalkMap_apply]
  rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]

/-- The constants `k ⊆ k(X)` are sections over every nonempty open. -/
private theorem exists_germToFunctionField_eq_algebraMap {k : Type w} [Field k] {X : Scheme.{w}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] (U : X.Opens) [Nonempty U] (c : k) :
    letI := functionFieldAlgebra sX
    ∃ a : Γ(X, U), X.germToFunctionField U a = algebraMap k X.functionField c := by
  letI := functionFieldAlgebra sX
  refine ⟨X.presheaf.map (homOfLE le_top).op (sX.appTop ((Scheme.ΓSpecIso (.of k)).inv c)), ?_⟩
  change X.presheaf.germ U _ _ _ = ((Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫
    X.presheaf.germ ⊤ (genericPoint X) (by simp)) c
  rw [TopCat.Presheaf.germ_res_apply]
  rfl

/-- The prime of the point of an affine open given by a prime `P` of its sections is `P`. -/
private theorem primeIdealOf_fromSpec {X : Scheme.{w}} {W : X.Opens} (hW : IsAffineOpen W)
    (P : PrimeSpectrum Γ(X, W)) (hP : hW.fromSpec P ∈ W) :
    hW.primeIdealOf ⟨hW.fromSpec P, hP⟩ = P := by
  have : (⟨hW.fromSpec P, hP⟩ : W) = hW.isoSpec.inv P := rfl
  rw [this]
  have h := Scheme.Hom.comp_apply hW.isoSpec.inv hW.isoSpec.hom (show Spec Γ(X, W) from P)
  rw [Iso.inv_hom_id] at h
  exact h.symm

/-- If every element of `s` has value at most that of `h` under a map into the valuation ring of
`w`, so does every element of the ideal spanned by `s`. -/
private theorem valuation_le_of_mem_span {A L : Type*} [CommRing A] [Field L] {Γ : Type*}
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (ι : A →+* L)
    (hA : ∀ a, w (ι a) ≤ 1) {s : Set A} {h : A} (hs : ∀ z ∈ s, w (ι z) ≤ w (ι h)) :
    ∀ y ∈ Ideal.span s, w (ι y) ≤ w (ι h) := by
  intro y hy
  induction hy using Submodule.span_induction with
  | mem z hz => exact hs z hz
  | zero => rw [map_zero, map_zero]; exact zero_le'
  | add y z _ _ hy hz => rw [map_add]; exact (w.map_add _ _).trans (max_le hy hz)
  | smul c y _ hy =>
    rw [smul_eq_mul, map_mul, map_mul]
    exact (mul_le_of_le_one_left' (hA c)).trans hy

/-- The elements of value `< 1` under a map into the valuation ring of `w` form a prime ideal. -/
private theorem exists_isPrime_mem_iff_valuation_lt_one {A L : Type*} [CommRing A] [Field L]
    {Γ : Type*} [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (ψ : A →+* L)
    (hψ : ∀ a, w (ψ a) ≤ 1) : ∃ 𝔮 : Ideal A, 𝔮.IsPrime ∧ ∀ t, t ∈ 𝔮 ↔ w (ψ t) < 1 :=
  ⟨(IsLocalRing.maximalIdeal w.valuationSubring).comap (ψ.codRestrict w.valuationSubring hψ),
    Ideal.comap_isPrime _ _, fun _ => Valuation.mem_maximalIdeal_iff _ _⟩

/-- In a localization `R` of `A` at a prime `P`, mapping to `L` compatibly with `ψ`, an element
`z` of `L` with `z · ψ t = ψ c` for some `t ∉ P` is the image of an element of `R`. -/
private theorem exists_algebraMap_eq_of_mul_eq {A R L : Type*} [CommRing A] [CommRing R]
    [Field L] [Algebra A R] [Algebra R L] (ψ : A →+* L)
    (hμ : ∀ t, algebraMap R L (algebraMap A R t) = ψ t) (P : Ideal A) [P.IsPrime]
    [IsLocalization P.primeCompl R] {z : L} (c : A) (t : P.primeCompl) (hψt : ψ t ≠ 0)
    (h : z * ψ t = ψ c) : ∃ a : R, algebraMap R L a = z :=
  ⟨IsLocalization.mk' R c t, mul_right_cancel₀ hψt (by
    rw [h, ← hμ, ← hμ, ← map_mul, IsLocalization.mk'_spec])⟩

/-- If `ψ : A → L` lands in the valuation ring of `w`, `P = {a | w (ψ a) < 1}`, and `φ : S → L`
lands in that ring with the generators of the essentially finite type algebra `S` sent into the
image of `ψ`, then `φ` factors through the localization of `A` at `P`. -/
private theorem exists_algebraMap_eq_of_essFiniteType {A R L R₀ S : Type*} [CommRing A]
    [CommRing R] [Field L] [Algebra A R] [Algebra R L] [CommRing R₀] [CommRing S] [Algebra R₀ S]
    [Algebra.EssFiniteType R₀ S] {Γ : Type*} [LinearOrderedCommGroupWithZero Γ]
    (w : Valuation L Γ) (ψ : A →+* L) (hμ : ∀ t, algebraMap R L (algebraMap A R t) = ψ t)
    (P : Ideal A) [P.IsPrime] [IsLocalization P.primeCompl R] (hP : ∀ t, t ∈ P ↔ w (ψ t) < 1)
    (φ : S →+* L) (hφ : ∀ s, w (φ s) ≤ 1) (hR : ∀ r, φ (algebraMap R₀ S r) ∈ ψ.range)
    (hσ : ∀ s ∈ Algebra.EssFiniteType.finset R₀ S, φ s ∈ ψ.range) (s : S) :
    ∃ a : R, algebraMap R L a = φ s := by
  obtain ⟨_, ⟨c, rfl⟩, _, ⟨t, rfl⟩, ht, hct⟩ :=
    exists_mul_eq_of_essFiniteType w φ hφ ψ.range hR hσ s
  exact exists_algebraMap_eq_of_mul_eq ψ hμ P c ⟨t, fun h => ((hP t).1 h).ne ht⟩
    (fun h => by simp [h] at ht) hct

/-- If `ψ : A → L` lands in the valuation ring of `w` and `P` is the prime `{a | w (ψ a) < 1}`,
then the localization of `A` at `P` also lands in the valuation ring of `w`. -/
private theorem valuation_algebraMap_le_one_of_isLocalization {A R L : Type*} [CommRing A]
    [CommRing R] [Field L] [Algebra A R] [Algebra R L] {Γ : Type*}
    [LinearOrderedCommGroupWithZero Γ] (w : Valuation L Γ) (ψ : A →+* L)
    (hμ : ∀ t, algebraMap R L (algebraMap A R t) = ψ t) (hψ : ∀ a, w (ψ a) ≤ 1) (P : Ideal A)
    [P.IsPrime] [IsLocalization P.primeCompl R] (hP : ∀ t, t ∈ P ↔ w (ψ t) < 1) (a : R) :
    w (algebraMap R L a) ≤ 1 := by
  obtain ⟨⟨c, t⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl a
  have ht1 : w (ψ t) = 1 := le_antisymm (hψ t) (not_lt.mp fun h => t.2 ((hP t).2 h))
  calc w (algebraMap R L (IsLocalization.mk' R c t))
      = w (algebraMap R L (IsLocalization.mk' R c t)) * w (ψ t) := by rw [ht1, mul_one]
    _ = w (ψ c) := by rw [← map_mul, ← hμ, ← hμ, ← map_mul, IsLocalization.mk'_spec]
    _ ≤ 1 := hψ c

/-- **The chart of the blow-up.** There are an affine open `U ∋ x` and a nonzero ideal
`J = (h₀, g₁, …, gₖ)` of `Γ(X, U)` such that, on the blow-up of any ideal sheaf restricting to `J`
on `U`, the point of the chart `Spec Γ(X, U)[J/h₀]` cut out by `𝔪_v` lies over `x` and has the
valuation ring of `v` as local ring. -/
private theorem exists_affineOpen_ideal_blowUp_stalk_eq_integer {k : Type w} [Field k]
    {X : Scheme.{w}} (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sX]
    {v : Valuation X.functionField ℤᵐ⁰}
    (hS : letI := functionFieldAlgebra sX
      ∃ (S : Type w) (_ : CommRing S) (_ : Algebra k S) (_ : Algebra.EssFiniteType k S)
        (φ : S →ₐ[k] X.functionField), ∀ g, v g ≤ 1 ↔ g ∈ φ.range) (x : X)
    (hle : ∀ a : X.presheaf.stalk x, v (algebraMap _ X.functionField a) ≤ 1)
    (hlt : ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x),
      v (algebraMap _ X.functionField a) < 1) :
    ∃ (U : X.affineOpens) (J : Ideal Γ(X, U)), x ∈ (U : X.Opens) ∧ J ≠ ⊥ ∧
      ∀ (ℐ : X.IdealSheafData), ℐ.ideal U = J → ∀ [IsIntegral (blowUp ℐ)]
        [IsDominant (blowUpToBase ℐ)], Function.Surjective (functionFieldMap (blowUpToBase ℐ)) →
        ∃ q : blowUp ℐ, blowUpToBase ℐ q = x ∧
          ∀ g : X.functionField, v g ≤ 1 ↔ ∃ a : (blowUp ℐ).presheaf.stalk q,
            algebraMap _ (blowUp ℐ).functionField a = functionFieldMap (blowUpToBase ℐ) g := by
  haveI : IsIntegral X := ‹AlgebraicGeometry.IsVariety k sX›.toIsIntegral
  letI := functionFieldAlgebra sX
  obtain ⟨S, _, _, _, φ, hφ⟩ := hS
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  haveI := functionField_isFractionRing_of_isAffineOpen X U hU
  let ι : Γ(X, U) →+* X.functionField := (X.germToFunctionField U).hom
  have hι : ∀ a, algebraMap Γ(X, U) X.functionField a = ι a := fun _ => rfl
  have hιinj : Function.Injective ι := X.germToFunctionField_injective U
  have hιle : ∀ a, v (ι a) ≤ 1 := fun a => by
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hxU]; exact hle _
  have hιlt : ∀ a, a ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal ↔ v (ι a) < 1 := by
    intro a
    rw [hU.primeIdealOf_eq_map_closedPoint]
    change X.presheaf.germ U x hxU a ∈ IsLocalRing.maximalIdeal _ ↔ _
    rw [← Scheme.algebraMap_germ_eq_germToFunctionField (X := X) hxU]
    exact ⟨hlt _, fun h => Classical.byContradiction fun hm =>
      h.ne (valuation_eq_one_of_isUnit v _ hle (IsLocalRing.notMem_maximalIdeal.mp hm))⟩
  classical
  set σ := Algebra.EssFiniteType.finset k S
  obtain ⟨⟨h₀, hh₀⟩, hden⟩ :=
    IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors Γ(X, U)) (σ.image φ)
  have hden' : ∀ s ∈ σ, ∃ r : Γ(X, U), ι r = ι h₀ * φ s := fun s hs => by
    obtain ⟨r, hr⟩ := hden (φ s) (Finset.mem_image_of_mem _ hs)
    exact ⟨r, by rw [← hι, hr, Algebra.smul_def, hι]⟩
  choose! g hg using hden'
  have hh₀0 : h₀ ≠ 0 := nonZeroDivisors.ne_zero hh₀
  let J : Ideal Γ(X, U) := Ideal.span (insert h₀ (g '' σ))
  have hJ : ∀ y ∈ J, v (ι y) ≤ v (ι h₀) := valuation_le_of_mem_span v ι hιle fun z hz => by
    rcases hz with rfl | ⟨s, hs, rfl⟩
    · exact le_rfl
    · rw [hg s hs, map_mul]
      exact mul_le_of_le_one_right' ((hφ _).2 ⟨s, rfl⟩)
  refine ⟨⟨U, hU⟩, J, hxU, ?_, ?_⟩
  · rw [ne_eq, Ideal.span_eq_bot]
    push Not
    exact ⟨h₀, Set.mem_insert _ _, hh₀0⟩
  intro ℐ hℐ _ _ hsurj
  let U' : X.affineOpens := ⟨U, hU⟩
  have hmemJ : ∀ y ∈ J, y ∈ ℐ.ideal U' := fun y hy => by rw [hℐ]; exact hy
  let a : ℐ.ideal U' := ⟨h₀, hmemJ _ (Ideal.subset_span (Set.mem_insert _ _))⟩
  let W := blowUpChartOpen ℐ U' a
  have hW : IsAffineOpen W.1 := W.2
  have hWle : W.1 ≤ blowUpToBase ℐ ⁻¹ᵁ U := blowUpChartOpen_le ℐ U' a
  let χ : Γ(X, U) →+* Γ(blowUp ℐ, W.1) := (blowUpChartMap ℐ U' a).hom
  haveI : Nontrivial Γ(blowUp ℐ, W.1) := by
    haveI : Nontrivial (Localization.Away h₀) := by
      have hinj := IsLocalization.injective (Localization.Away h₀)
        (powers_le_nonZeroDivisors_of_noZeroDivisors hh₀0)
      exact ⟨⟨_, _, hinj.ne zero_ne_one⟩⟩
    exact (blowUpChartRingIso ℐ U' a).commRingCatIsoToRingEquiv.toEquiv.nontrivial
  have hmemW : ∀ p : Spec Γ(blowUp ℐ, W.1), hW.fromSpec p ∈ W.1 := fun p =>
    hW.range_fromSpec.subset ⟨p, rfl⟩
  obtain ⟨p₀, hp₀⟩ := Ideal.exists_maximal Γ(blowUp ℐ, W.1)
  haveI : Nonempty W.1 :=
    ⟨⟨hW.fromSpec (show Spec _ from ⟨p₀, hp₀.isPrime⟩), hmemW _⟩⟩
  let ψ : Γ(blowUp ℐ, W.1) →+* (blowUp ℐ).functionField :=
    ((blowUp ℐ).germToFunctionField W.1).hom
  set fβ := functionFieldMap (blowUpToBase ℐ)
  have hψχ : ∀ s, ψ (χ s) = fβ (ι s) := fun s =>
    germToFunctionField_appLE (blowUpToBase ℐ) U W.1 hWle s
  let e := RingEquiv.ofBijective fβ ⟨fβ.injective, hsurj⟩
  let w : Valuation (blowUp ℐ).functionField ℤᵐ⁰ := v.comap e.symm.toRingHom
  have hw : ∀ g, w (fβ g) = v g := fun g => by
    simp only [w, Valuation.comap_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
    exact congrArg v (e.symm_apply_apply g)
  have hιh₀ : ι h₀ ≠ 0 := fun h => hh₀0 (hιinj (h.trans (map_zero ι).symm))
  have hfh₀ : fβ (ι h₀) ≠ 0 := by rwa [map_ne_zero]
  have hTle : ∀ t, w (ψ t) ≤ 1 := by
    intro t
    obtain ⟨n, y, hy, hty⟩ := exists_mem_pow_mul_eq_blowUpChartMap ℐ U' a t
    have hty' : t * χ h₀ ^ n = χ y := hty
    have h1 : ψ t * fβ (ι h₀) ^ n = fβ (ι y) := by
      have := congrArg ψ hty'
      rwa [map_mul, map_pow, hψχ, hψχ] at this
    have h2 : w (ψ t) * v (ι h₀) ^ n = v (ι y) := by
      rw [← hw, ← hw, ← map_pow, ← map_mul, h1]
    have h3 := valuation_le_pow_of_mem_pow v ι hιle J h₀ hJ n y (hℐ ▸ hy)
    have hpos : 0 < v (ι h₀) ^ n := pow_pos (zero_lt_iff.mpr (v.ne_zero_iff.mpr hιh₀)) n
    rw [← h2] at h3
    exact (mul_le_iff_le_one_left hpos).mp h3
  have hR : ∀ r, (fβ.comp φ.toRingHom) (algebraMap k S r) ∈ ψ.range := by
    intro r
    obtain ⟨c, hc⟩ := exists_germToFunctionField_eq_algebraMap sX U r
    refine ⟨χ c, ?_⟩
    rw [hψχ]
    change fβ (ι c) = fβ (φ (algebraMap k S r))
    rw [φ.commutes]
    exact congrArg fβ hc
  have hσ : ∀ s ∈ σ, (fβ.comp φ.toRingHom) s ∈ ψ.range := by
    intro s hs
    have hgs : g s ∈ ℐ.ideal U' :=
      hmemJ _ (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨s, hs, rfl⟩))
    obtain ⟨t, ht⟩ := exists_mul_eq_blowUpChartMap_of_mem_pow ℐ U' a (n := 1) (x := g s)
      (by rwa [pow_one])
    refine ⟨t, ?_⟩
    have ht' : χ (g s) = χ h₀ ^ 1 * t := ht
    have := congrArg ψ ht'
    rw [pow_one, map_mul, hψχ, hψχ, hg s hs, map_mul] at this
    exact (mul_left_cancel₀ hfh₀ this).symm
  obtain ⟨𝔮, h𝔮p, h𝔮⟩ := exists_isPrime_mem_iff_valuation_lt_one w ψ hTle
  let P : PrimeSpectrum Γ(blowUp ℐ, W.1) := ⟨𝔮, h𝔮p⟩
  have hqW : hW.fromSpec P ∈ W.1 := hmemW P
  have hPq := primeIdealOf_fromSpec hW P hqW
  refine ⟨hW.fromSpec P, ?_, ?_⟩
  · have h1 := IsAffineOpen.comap_primeIdealOf_appLE (f := blowUpToBase ℐ) U hU W.1 hW hWle hqW
    have h2 : hU.primeIdealOf ⟨blowUpToBase ℐ (hW.fromSpec P), hWle hqW⟩ =
        hU.primeIdealOf ⟨x, hxU⟩ := by
      rw [← h1, hPq]
      apply PrimeSpectrum.ext
      ext s
      rw [hιlt]
      change χ s ∈ 𝔮 ↔ _
      rw [h𝔮, hψχ, hw]
    have := congrArg hU.fromSpec h2
    rwa [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at this
  · letI : Algebra Γ(blowUp ℐ, W.1) ((blowUp ℐ).presheaf.stalk (hW.fromSpec P)) :=
      TopCat.Presheaf.algebra_section_stalk _ ⟨_, hqW⟩
    haveI : IsLocalization P.asIdeal.primeCompl ((blowUp ℐ).presheaf.stalk (hW.fromSpec P)) :=
      hW.isLocalization_stalk' P hqW
    haveI := functionField_isScalarTower (blowUp ℐ) W.1 ⟨_, hqW⟩
    have hμ : ∀ t, algebraMap _ (blowUp ℐ).functionField (algebraMap Γ(blowUp ℐ, W.1)
        ((blowUp ℐ).presheaf.stalk (hW.fromSpec P)) t) = ψ t := fun t => by
      rw [← IsScalarTower.algebraMap_apply]; rfl
    intro g'
    constructor
    · intro hg
      obtain ⟨s, rfl⟩ := (hφ g').1 hg
      refine exists_algebraMap_eq_of_essFiniteType w ψ hμ P.asIdeal h𝔮 (fβ.comp φ.toRingHom)
        (fun s => ?_) hR hσ s
      change w (fβ (φ s)) ≤ 1
      rw [hw]
      exact (hφ _).2 ⟨s, rfl⟩
    · rintro ⟨y, hy⟩
      rw [← hw, ← hy]
      exact valuation_algebraMap_le_one_of_isLocalization w ψ hμ hTle P.asIdeal h𝔮 y

/-- **The blow-up step.** There is a projective birational `β : X₂ ⟶ X` from a variety and a
point `q ↦ x` of `X₂` whose local ring, inside `k(X)`, is the valuation ring of `v`. -/
private theorem exists_blowUp_stalk_eq_integer {k : Type w} [Field k]
    {X : Scheme.{w}} (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sX]
    {v : Valuation X.functionField ℤᵐ⁰}
    (hS : letI := functionFieldAlgebra sX
      ∃ (S : Type w) (_ : CommRing S) (_ : Algebra k S) (_ : Algebra.EssFiniteType k S)
        (φ : S →ₐ[k] X.functionField), ∀ g, v g ≤ 1 ↔ g ∈ φ.range) (x : X)
    (hle : ∀ a : X.presheaf.stalk x, v (algebraMap _ X.functionField a) ≤ 1)
    (hlt : ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x),
      v (algebraMap _ X.functionField a) < 1) :
    ∃ (X₂ : Scheme.{w}) (β : X₂ ⟶ X) (_ : AlgebraicGeometry.IsVariety k (β ≫ sX))
      (hβ : IsBirationalMorphism β),
      IsProjective β ∧ ∃ q : X₂, β q = x ∧
        haveI : IsDominant β := hβ.isDominant
        ∀ g : X.functionField, v g ≤ 1 ↔
          ∃ a : X₂.presheaf.stalk q, algebraMap _ X₂.functionField a = functionFieldMap β g := by
  obtain ⟨U, J, -, hJ, hchart⟩ := exists_affineOpen_ideal_blowUp_stalk_eq_integer sX hS x hle hlt
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated sX
  obtain ⟨ℐ, hℐ⟩ := exists_idealSheafData_ideal_eq U J
  have hℐ0 : ℐ ≠ ⊥ := by
    rintro rfl
    exact hJ (hℐ.symm.trans rfl)
  obtain ⟨hvar, hproj, hbir⟩ :=
    MMP.Flips.ResolutionInputs.isVariety_blowUp_and_isProjective_and_isBirational sX ℐ hℐ0
  haveI : IsIntegral (blowUp ℐ) := hvar.toIsIntegral
  haveI : IsIntegral X := ‹AlgebraicGeometry.IsVariety k sX›.toIsIntegral
  haveI : IsProper (blowUpToBase ℐ) := hproj.isProper
  have hβ := isBirationalMorphism_of_isBirational (blowUpToBase ℐ) hbir
  haveI : IsDominant (blowUpToBase ℐ) := hβ.isDominant
  obtain ⟨q, hq, hstalk⟩ := hchart ℐ hℐ hβ.functionFieldMap_bijective.2
  exact ⟨blowUp ℐ, blowUpToBase ℐ, hvar, hβ, hproj, q, hq, hstalk⟩

/-- **The normalization step.** The normalization of a variety is a finite, hence projective,
birational morphism from a normal variety, and it is an isomorphism on local rings over a point
whose local ring is a valuation ring. -/
private theorem exists_normalization_isIso_stalkMap {k : Type w} [Field k] {Y : Scheme.{w}}
    (sY : Y ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sY] (q : Y)
    [ValuationRing (Y.presheaf.stalk q)] :
    ∃ (Z : Scheme.{w}) (ν : Z ⟶ Y), IsNormalVariety k (ν ≫ sY) ∧ IsProjective ν ∧
      IsBirationalMorphism ν ∧ ∃ z : Z, ν z = q ∧ IsIso (ν.stalkMap z) := by
  let ν := normalizationOverField k sY
  have hX := finite_irreducibleComponents_of_locallyOfFiniteType k sY
  have hbir : IsBirational ν := Scheme.isBirational_normalization Y hX
  haveI : IsFinite ν := isFinite_normalizationOverField k sY
  haveI hvar : AlgebraicGeometry.IsVariety k (ν ≫ sY) := isVariety_normalizationOverField k sY
  haveI : IsIntegral (normalizationSchemeOverField k sY) := hvar.toIsIntegral
  have hνb : IsBirationalMorphism ν := isBirationalMorphism_of_isBirational ν hbir
  haveI : IsDominant ν := hνb.isDominant
  obtain ⟨z, hz⟩ := (Scheme.surjective_normalization Y hX).surj q
  refine ⟨_, ν, ⟨hvar, Scheme.isNormal_normalizationScheme Y hX⟩,
    Stacks.FiniteMorphismProjective.isProjective_of_isFinite ν, hνb, z, hz, ?_⟩
  subst hz
  exact MMP.Positivity.isIso_stalkMap_of_valuationRing ν hνb.functionFieldMap_bijective z

/-- A dominant morphism which is an open immersion on a dense open is birational. -/
private theorem isBirationalMorphism_of_isOpenImmersion {X Y : Scheme.{w}} (f : X ⟶ Y)
    [IsDominant f] (U : X.Opens) (hU : Dense (U : Set X)) [IsOpenImmersion (U.ι ≫ f)] :
    IsBirationalMorphism f := by
  have hd : Dense ((U.ι ≫ f).opensRange : Set Y) := by
    rw [Scheme.Hom.coe_opensRange, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
      Scheme.Opens.range_ι]
    exact f.denseRange.dense_image f.continuous hU
  let e : X.PartialIso Y :=
    { source := U
      dense_source := hU
      target := (U.ι ≫ f).opensRange
      dense_target := hd
      iso := (U.ι ≫ f).isoOpensRange }
  refine ⟨e, ?_⟩
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff]
  refine ⟨U, hU, le_rfl, le_top, ?_⟩
  simp only [Scheme.PartialMap.restrict, Scheme.PartialIso.toPartialMap_hom,
    Scheme.Hom.toPartialMap_hom, e, Scheme.Hom.isoOpensRange_hom_ι]
  exact (Scheme.homOfLE_ι_assoc _ _ _).trans
    (by rw [Scheme.topIso_hom]; exact (Scheme.homOfLE_ι_assoc _ _ _).symm)

/-- A birational morphism is an open immersion on a dense open. -/
private theorem exists_isOpenImmersion_of_isBirationalMorphism {X Y : Scheme.{w}} {f : X ⟶ Y}
    (hf : IsBirationalMorphism f) :
    ∃ U : X.Opens, Dense (U : Set X) ∧ IsOpenImmersion (U.ι ≫ f) := by
  obtain ⟨e, he⟩ := hf
  rw [Scheme.PartialIso.toRationalMap, Scheme.PartialMap.toRationalMap_eq_iff] at he
  obtain ⟨W, hW, hWe, hWf, h⟩ := he
  simp only [Scheme.PartialMap.restrict_hom] at h
  have he' : IsOpenImmersion e.toPartialMap.hom := by
    change IsOpenImmersion (e.iso.hom ≫ e.target.ι)
    infer_instance
  refine ⟨W, hW, ?_⟩
  have : W.ι ≫ f = X.homOfLE hWf ≫ f.toPartialMap.hom := by
    change W.ι ≫ f = (X.homOfLE (le_top : W ≤ ⊤) ≫ X.topIso.hom) ≫ f
    simp only [Scheme.topIso_hom, Scheme.homOfLE_ι]
  rw [this, ← h]
  infer_instance

/-- A composite of birational morphisms out of an irreducible scheme is birational. -/
private theorem isBirationalMorphism_comp {X Y Z : Scheme.{w}} [IrreducibleSpace X]
    {f : X ⟶ Y} {g : Y ⟶ Z} (hf : IsBirationalMorphism f) (hg : IsBirationalMorphism g) :
    IsBirationalMorphism (f ≫ g) := by
  haveI := hf.isDominant
  haveI := hg.isDominant
  obtain ⟨U₁, hU₁, h₁⟩ := exists_isOpenImmersion_of_isBirationalMorphism hf
  obtain ⟨U₂, hU₂, h₂⟩ := exists_isOpenImmersion_of_isBirationalMorphism hg
  let U : X.Opens := U₁ ⊓ f ⁻¹ᵁ U₂
  have hne : (U : Set X).Nonempty := by
    obtain ⟨x₀⟩ := (IrreducibleSpace.isIrreducible_univ X).nonempty
    haveI : Nonempty Y := ⟨f x₀⟩
    have hd : Dense (f '' U₁) := f.denseRange.dense_image f.continuous hU₁
    obtain ⟨y, hy₂, x, hx₁, rfl⟩ := (hU₂.inter_of_isOpen_left hd U₂.2).nonempty
    exact ⟨x, hx₁, hy₂⟩
  have hU : Dense (U : Set X) := U.2.dense hne
  have hle : U ≤ f ⁻¹ᵁ U₂ := inf_le_right
  have hle₁ : U ≤ U₁ := inf_le_left
  have hres : IsOpenImmersion (f.resLE U₂ U hle) := by
    have : f.resLE U₂ U hle ≫ U₂.ι = X.homOfLE hle₁ ≫ (U₁.ι ≫ f) := by
      rw [Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.homOfLE_ι]
    have : IsOpenImmersion (f.resLE U₂ U hle ≫ U₂.ι) := by rw [this]; infer_instance
    exact IsOpenImmersion.of_comp _ U₂.ι
  haveI : IsOpenImmersion (U.ι ≫ f ≫ g) := by
    rw [← Category.assoc, ← Scheme.Hom.resLE_comp_ι f hle, Category.assoc]
    infer_instance
  exact isBirationalMorphism_of_isOpenImmersion (f ≫ g) U hU

/-- Transport of "the local ring at `ν z` is a given subset of `k(X)`" along a morphism `ν`
which is an isomorphism on local rings at `z`. -/
private theorem forall_iff_exists_stalk_comp {X Y Z : Scheme.{w}} [IsIntegral X] [IsIntegral Y]
    [IsIntegral Z] (ν : Z ⟶ Y) (β : Y ⟶ X) [IsDominant ν] [IsDominant β] [IsDominant (ν ≫ β)]
    (z : Z) [IsIso (ν.stalkMap z)] (S : Set X.functionField)
    (hq : ∀ g : X.functionField, g ∈ S ↔
      ∃ a : Y.presheaf.stalk (ν z), algebraMap _ Y.functionField a = functionFieldMap β g) :
    ∀ g : X.functionField, g ∈ S ↔
      ∃ a : Z.presheaf.stalk z, algebraMap _ Z.functionField a = functionFieldMap (ν ≫ β) g := by
  intro g
  rw [hq g]
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨(ν.stalkMap z).hom a, ?_⟩
    rw [← MMP.Mori.functionFieldMap_algebraMap_stalk, ha,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply]
  · rintro ⟨b, hb⟩
    refine ⟨(inv (ν.stalkMap z)).hom b, (functionFieldMap ν).injective ?_⟩
    rw [MMP.Mori.functionFieldMap_algebraMap_stalk,
      MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply, ← hb]
    congr 1
    exact congrArg (fun φ => φ.hom b) (IsIso.inv_hom_id (ν.stalkMap z))

/-- Two equivalent `ℤᵐ⁰`-valued valuations of a field which both take the value `exp (-1)` are
equal. -/
private theorem eq_of_isEquiv_of_exp_neg_one {K : Type*} [Field K] {w₁ w₂ : Valuation K ℤᵐ⁰}
    (h : w₁.IsEquiv w₂) (h₁ : ∃ a, w₁ a = WithZero.exp (-1))
    (h₂ : ∃ a, w₂ a = WithZero.exp (-1)) : w₁ = w₂ := by
  obtain ⟨ϖ, hϖ⟩ := h₁
  obtain ⟨ϖ', hϖ'⟩ := h₂
  have hpow : ∀ (w : Valuation K ℤᵐ⁰) (c : ℤ), w ϖ = WithZero.exp c → ∀ n : ℤ,
      w (ϖ ^ n) = WithZero.exp (c * n) := by
    intro w c hc n
    rw [map_zpow₀, hc, ← WithZero.exp_zsmul, smul_eq_mul, mul_comm]
  have hw₂ϖ : w₂ ϖ ≠ 0 := by
    rw [ne_eq, ← h.eq_zero, hϖ]; exact WithZero.exp_ne_zero
  set a := WithZero.log (w₂ ϖ)
  have ha : w₂ ϖ = WithZero.exp a := (WithZero.exp_log hw₂ϖ).symm
  have hw₁ϖ' : w₁ ϖ' ≠ 0 := by
    rw [ne_eq, h.eq_zero, hϖ']; exact WithZero.exp_ne_zero
  set b := WithZero.log (w₁ ϖ')
  have hb : w₁ ϖ' = WithZero.exp b := (WithZero.exp_log hw₁ϖ').symm
  have hab : w₂ ϖ' = WithZero.exp (a * -b) := by
    rw [← hpow w₂ a ha]
    exact (Valuation.IsEquiv.eq_iff h).mp (by rw [hb, hpow w₁ (-1) hϖ]; congr 1; ring)
  rw [hϖ', WithZero.exp_inj] at hab
  have ha0 : a < 0 := by
    have : w₂ ϖ < 1 := (Valuation.isEquiv_iff_val_lt_one.mp h).mp
      (by rw [hϖ, ← WithZero.exp_zero, WithZero.exp_lt_exp]; omega)
    rwa [ha, ← WithZero.exp_zero, WithZero.exp_lt_exp] at this
  have ha1 : a = -1 := by
    have : a * b = 1 := by linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one' this with h | h <;> omega
  ext g
  by_cases hg : g = 0
  · simp [hg]
  have hg1 : w₁ g ≠ 0 := by simp [hg]
  set m := WithZero.log (w₁ g)
  have hm : w₁ g = WithZero.exp m := (WithZero.exp_log hg1).symm
  have : w₂ g = w₂ (ϖ ^ (-m)) :=
    (Valuation.IsEquiv.eq_iff h).mp (by rw [hm, hpow w₁ (-1) hϖ]; congr 1; ring)
  rw [this, hpow w₂ a ha, hm, ha1]; congr 1; ring

/-- If the local ring of `Z` at `z` is, inside `k(X)`, the valuation ring of a valuation taking
the value `exp (-1)`, it is not a field. -/
private theorem not_isField_stalk_of_forall_le_one_iff {X Z : Scheme.{w}} [IsIntegral X]
    [IsIntegral Z] (h : Z ⟶ X) [IsDominant h] (v : Valuation X.functionField ℤᵐ⁰) (z : Z)
    (hz : ∀ g : X.functionField, v g ≤ 1 ↔
      ∃ a : Z.presheaf.stalk z, algebraMap _ Z.functionField a = functionFieldMap h g)
    {g₀ : X.functionField} (hg₀ : v g₀ = WithZero.exp (-1)) :
    ¬ IsField (Z.presheaf.stalk z) := by
  intro hF
  obtain ⟨a, ha⟩ := (hz g₀).1 (by rw [hg₀, ← WithZero.exp_zero, WithZero.exp_le_exp]; omega)
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [map_zero, eq_comm, map_eq_zero, ← v.zero_iff, hg₀] at ha
    exact WithZero.exp_ne_zero ha
  obtain ⟨b, hb⟩ := hF.mul_inv_cancel ha0
  have hb' : v g₀⁻¹ ≤ 1 := (hz _).2 ⟨b, by
    rw [map_inv₀, ← ha]
    exact eq_inv_of_mul_eq_one_right (by rw [← map_mul, hb, map_one])⟩
  rw [map_inv₀, hg₀, ← WithZero.exp_neg, neg_neg, ← WithZero.exp_zero, WithZero.exp_le_exp] at hb'
  omega

/-- **The assembly step.** On a normal locally noetherian integral scheme `Z` dominating `X`, a
point `z` whose local ring is, inside `k(X)`, the valuation ring of a divisor `v` of `k(X)`, is
the generic point of a prime divisor `F` with `ord_F = v`. -/
private theorem exists_primeDivisor_valuationOver_eq {X : Scheme.{w}} [IsIntegral X]
    {v : Valuation X.functionField ℤᵐ⁰} {g₀ : X.functionField} (hg₀ : v g₀ = WithZero.exp (-1))
    {Z : Scheme.{w}} [IsIntegral Z] [IsLocallyNoetherian Z] [IsNormal Z] (h : Z ⟶ X)
    (hh : IsBirationalMorphism h) (z : Z)
    (hz : haveI : IsDominant h := hh.isDominant
      ∀ g : X.functionField, v g ≤ 1 ↔
        ∃ a : Z.presheaf.stalk z, algebraMap _ Z.functionField a = functionFieldMap h g) :
    ∃ F : MMP.Mori.PrimeDivisor Z, F.genericPoint = z ∧
      haveI : IsDominant h := hh.isDominant
      F.valuationOver h = v := by
  haveI : IsDominant h := hh.isDominant
  haveI := valuationRing_stalk_of_forall_le_one_iff h hh v z hz
  have hnf := not_isField_stalk_of_forall_le_one_iff h v z hz hg₀
  haveI : IsDiscreteValuationRing (Z.presheaf.stalk z) :=
    ((IsDiscreteValuationRing.TFAE (Z.presheaf.stalk z) hnf).out 1 2).mpr ‹_›
  have hcoh : Order.coheight z = 1 := by
    have h1 := ringKrullDim_stalk_eq_coheight z
    rw [IsDiscreteValuationRing.ringKrullDim_eq_one] at h1
    exact_mod_cast h1.symm
  refine ⟨AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hcoh,
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hcoh, ?_⟩
  set F : MMP.Mori.PrimeDivisor Z := AlgebraicGeometry.PrimeDivisor.ofCoheightOne z hcoh
  have hF : F.genericPoint = z := AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne z hcoh
  have hrange : ∀ r : Z.functionField,
      r ∈ (algebraMap F.localRing Z.functionField).range ↔
        ∃ a : Z.presheaf.stalk z, algebraMap _ Z.functionField a = r := by
    intro r
    change (∃ a : Z.presheaf.stalk F.genericPoint, _) ↔ _
    clear_value F
    subst hF
    rfl
  apply eq_of_isEquiv_of_exp_neg_one
  · refine Valuation.isEquiv_iff_val_le_one.mpr fun {g} => ?_
    rw [PrimeDivisor.valuationOver_apply, PrimeDivisor.divisorialValuation_le_one_iff, hrange,
      hz g]
  · haveI := F.isDiscreteValuationRing_localRing
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible F.localRing
    obtain ⟨g, hg⟩ := hh.functionFieldMap_bijective.2 (algebraMap F.localRing Z.functionField ϖ)
    refine ⟨g, ?_⟩
    rw [PrimeDivisor.valuationOver_apply, hg]
    exact F.divisorialValuation_algebraMap_of_irreducible hϖ
  · exact ⟨g₀, hg₀⟩

/-- A valuation of `k(X)` whose valuation ring is essentially of finite type over `k`, takes
the value `exp (-1)` and dominates `𝒪_{X,x}` is `ord_F` for a divisor `(Z, h, F)` over `X` with
`h` projective and `h(η_F) = x`. -/
private theorem exists_properDivisorOver_isProjective_of_dominates_of_essFiniteType {k : Type w}
    [Field k] {X : Scheme.{w}} (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsVariety k sX]
    {v : Valuation X.functionField ℤᵐ⁰}
    (hS : letI := functionFieldAlgebra sX
      ∃ (S : Type w) (_ : CommRing S) (_ : Algebra k S) (_ : Algebra.EssFiniteType k S)
        (φ : S →ₐ[k] X.functionField), ∀ g, v g ≤ 1 ↔ g ∈ φ.range)
    {g₀ : X.functionField} (hg₀ : v g₀ = WithZero.exp (-1)) (x : X)
    (hle : ∀ a : X.presheaf.stalk x, v (algebraMap _ X.functionField a) ≤ 1)
    (hlt : ∀ a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x),
      v (algebraMap _ X.functionField a) < 1) :
    ∃ D : ProperDivisorOver k sX, IsProjective D.f ∧ D.valuation = v ∧
      D.f D.E.genericPoint = x := by
  obtain ⟨X₂, β, hvar₂, hβ, hprojβ, q, hqx, hq⟩ :=
    exists_blowUp_stalk_eq_integer sX hS x hle hlt
  haveI : IsIntegral X₂ := hvar₂.toIsIntegral
  haveI : IsDominant β := hβ.isDominant
  obtain ⟨Z, ν, hZ, hprojν, hν, z, hzq, hiso⟩ :=
    haveI := valuationRing_stalk_of_forall_le_one_iff β hβ v q hq
    exists_normalization_isIso_stalkMap (β ≫ sX) q
  subst hzq
  haveI : IsIntegral Z := hZ.1.toIsIntegral
  have hh : IsBirationalMorphism (ν ≫ β) := isBirationalMorphism_comp hν hβ
  have hZ' : IsNormalVariety k ((ν ≫ β) ≫ sX) := by rwa [Category.assoc]
  haveI : IsNormal Z := hZ.2
  haveI : IsLocallyNoetherian Z :=
    haveI : LocallyOfFiniteType ((ν ≫ β) ≫ sX) := hZ'.1.toLocallyOfFiniteType
    LocallyOfFiniteType.isLocallyNoetherian ((ν ≫ β) ≫ sX)
  haveI : IsDominant ν := hν.isDominant
  haveI : IsDominant (ν ≫ β) := hh.isDominant
  have hz := forall_iff_exists_stalk_comp ν β z {g | v g ≤ 1} hq
  obtain ⟨F, hFz, hFv⟩ := exists_primeDivisor_valuationOver_eq hg₀ (ν ≫ β) hh z hz
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated sX
  have hproj : IsProjective (ν ≫ β) :=
    IsProjective.comp hprojν hprojβ
  refine ⟨⟨⟨Z, ν ≫ β, hZ', hh, F⟩, hproj.isProper⟩, hproj, hFv, ?_⟩
  change (ν ≫ β) F.genericPoint = x
  rw [hFz, Scheme.Hom.comp_apply, hqx]

end Realization

/-- The monomial valuation `v_{x,t;j}` of weights `(j, 1)` at a regular codimension-two point
`η_V` of a normal variety `Y` is a normalized divisorial valuation of `k(Y)` with centre
`c_Y(v_{x,t;j}) = V`. -/
@[mmp "lem_oai4_c2_monomial_valuation_divisorial"]
public theorem IsWeightedMonomialValuation.isNormalizedDivisorialValuation_and_isCentre
    {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y]
    {V : IrreducibleCloseds Y} {x t : Y.presheaf.stalk V.isIrreducible.genericPoint} {j : ℕ}
    {v : Valuation Y.functionField ℤᵐ⁰}
    (hv : IsWeightedMonomialValuation sY V x t j v) :
    MMP.Intersection.IsNormalizedDivisorialValuation k sY v ∧
      MMP.Intersection.IsCentre k sY v V := by
  obtain ⟨hnv, -, _, hrsp, hj, hval⟩ := hv
  haveI : AlgebraicGeometry.IsVariety k sY := hnv.1
  haveI : LocallyOfFiniteType sY := hnv.1.toLocallyOfFiniteType
  have hspan : Ideal.span {x, t} =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk V.isIrreducible.genericPoint) := by
    have := hrsp.1
    rwa [Matrix.range_cons_cons_empty] at this
  have hdim : ringKrullDim (Y.presheaf.stalk V.isIrreducible.genericPoint) = 2 := by
    exact_mod_cast hrsp.2
  have hle := valuation_le_one_of_monomialValuation hval
  have hvt := valuation_eq_exp_neg_one hval hj hspan hdim
  letI := MMP.Mori.stalkAlgebra sY V.isIrreducible.genericPoint
  letI := MMP.Mori.functionFieldAlgebra sY
  haveI := MMP.Mori.isScalarTower_stalk_functionField sY V.isIrreducible.genericPoint
  haveI := essFiniteType_stalkAlgebra sY V.isIrreducible.genericPoint
  obtain ⟨D, -, hDv, hDx⟩ :=
    exists_properDivisorOver_isProjective_of_dominates_of_essFiniteType sY
      (exists_essFiniteType_range (k := k) v hvt hval) hvt V.isIrreducible.genericPoint hle
      fun a ha => valuation_lt_one_of_mem_span_pair hval hj (hspan ▸ ha)
  refine ⟨⟨D.toDivisorOver, D.isProper, hDv.symm⟩, D.toDivisorOver, D.isProper, hDv.symm, ?_⟩
  refine IrreducibleCloseds.ext ?_
  rw [MMP.Mori.DivisorOver.center_eq_closure_genericPoint]
  change (V : Set Y) = closure {D.f D.E.genericPoint}
  rw [hDx]
  exact (V.isIrreducible.isGenericPoint_genericPoint V.isClosed).symm

/-! ## The log discrepancy of a weighted monomial valuation -/

open IsLocalRing KaehlerDifferential TensorProduct

section WeightedInitialForm

variable {R : Type*} [CommRing R] [IsDomain R] [IsLocalRing R] {x t : R} {j : ℕ}

/-- If `∑_{b ≤ N} u_b x^b t^{j(N-b)} ∈ (x^{N+1})`, with `(t)` prime, `x ∉ (t)` and `x, t ∈ 𝔪`,
then every `u_b` lies in `𝔪`. -/
private theorem mem_maximalIdeal_of_sum_eq_mul (ht0 : t ≠ 0)
    (htp : (Ideal.span {t}).IsPrime) (hxt : x ∉ Ideal.span {t})
    (hxm : x ∈ maximalIdeal R) (htm : t ∈ maximalIdeal R) (hj : 1 ≤ j) :
    ∀ (N : ℕ) (u : ℕ → R) (e : R),
      ∑ b ∈ Finset.range (N + 1), u b * x ^ b * t ^ (j * (N - b)) = x ^ (N + 1) * e →
        ∀ b ≤ N, u b ∈ maximalIdeal R := by
  have htP : Prime t := (Ideal.span_singleton_prime ht0).mp htp
  have hxtd : ∀ m : ℕ, ¬ t ∣ x ^ m := fun m h =>
    hxt (Ideal.mem_span_singleton.mpr (htP.dvd_of_dvd_pow h))
  have htj : t ^ j = t * t ^ (j - 1) := by rw [← pow_succ', Nat.sub_add_cancel hj]
  intro N
  induction N with
  | zero =>
    intro u e h b hb
    obtain rfl : b = 0 := by omega
    simp at h
    rw [h]
    exact Ideal.mul_mem_right _ _ hxm
  | succ N ih =>
    intro u e h b hb
    rw [Finset.sum_range_succ] at h
    simp only [Nat.sub_self, mul_zero, pow_zero, mul_one] at h
    have hS : ∀ c ∈ Finset.range (N + 1),
        u c * x ^ c * t ^ (j * (N + 1 - c)) = t ^ j * (u c * x ^ c * t ^ (j * (N - c))) := by
      intro c hc
      have hc := Finset.mem_range.mp hc
      have : j * (N + 1 - c) = j + j * (N - c) := by
        rw [show N + 1 - c = (N - c) + 1 by omega]; ring
      rw [this, pow_add]; ring
    rw [Finset.sum_congr rfl hS, ← Finset.mul_sum] at h
    set S := ∑ c ∈ Finset.range (N + 1), u c * x ^ c * t ^ (j * (N - c))
    -- reduce modulo `t`
    have hdiv : t ∣ x ^ (N + 1) * (u (N + 1) - x * e) := by
      refine ⟨-(t ^ (j - 1) * S), ?_⟩
      linear_combination h - S * htj
    obtain ⟨g, hg⟩ := (htP.dvd_or_dvd hdiv).resolve_left (hxtd _)
    have h2 : t ^ j * S = -(t * g * x ^ (N + 1)) := by linear_combination h - x ^ (N + 1) * hg
    have hdj : t ^ (j - 1) ∣ g := by
      have h3 : t ^ (j - 1) ∣ x ^ (N + 1) * g := by
        refine ⟨-S, mul_left_cancel₀ ht0 ?_⟩
        linear_combination h2 - S * htj
      exact htP.pow_dvd_of_dvd_mul_left _ (hxtd _) h3
    obtain ⟨g', rfl⟩ := hdj
    have h4 : S = x ^ (N + 1) * (-g') := by
      refine mul_left_cancel₀ (pow_ne_zero j ht0) ?_
      linear_combination h2 + (g' * x ^ (N + 1)) * htj
    rcases Nat.lt_or_ge b (N + 1) with hb' | hb'
    · exact ih u (-g') h4 b (by omega)
    · obtain rfl : b = N + 1 := by omega
      have : u (N + 1) = x * e + t * (t ^ (j - 1) * g') := by linear_combination hg
      rw [this]
      exact add_mem (Ideal.mul_mem_right _ _ hxm) (Ideal.mul_mem_right _ _ htm)

/-- **The weighted initial form.** In a regular local ring of dimension two with regular
parameters `(x, t)`, if `∑_{b ≤ N} c_b x^b t^{j(N-b)}` has weighted order `> jN` for the weights
`(j, 1)` of `(x, t)`, then every `c_b` lies in the maximal ideal. -/
private theorem mem_maximalIdeal_of_sum_mem_monomialIdeal (ht0 : t ≠ 0)
    (htp : (Ideal.span {t}).IsPrime) (hxt : x ∉ Ideal.span {t})
    (hxm : x ∈ maximalIdeal R) (htm : t ∈ maximalIdeal R) (hj : 1 ≤ j)
    (N : ℕ) (c : ℕ → R)
    (hc : ∑ b ∈ Finset.range (N + 1), c b * x ^ b * t ^ (j * (N - b)) ∈
      monomialIdeal t x j (j * N + 1)) :
    ∀ b ≤ N, c b ∈ maximalIdeal R := by
  classical
  let f : Fin (N + 1) → R := fun b => t * x ^ (b : ℕ) * t ^ (j * (N - b))
  have hle : monomialIdeal t x j (j * N + 1) ≤
      Ideal.span (Set.range f) ⊔ Ideal.span {x ^ (N + 1)} := by
    refine Ideal.span_le.mpr ?_
    rintro r ⟨a, b, hab, rfl⟩
    rcases Nat.lt_or_ge N b with hb | hb
    · refine Ideal.mem_sup_right (Ideal.mem_span_singleton.mpr ⟨t ^ a * x ^ (b - (N + 1)), ?_⟩)
      rw [show x ^ b = x ^ (N + 1) * x ^ (b - (N + 1)) by rw [← pow_add]; congr 1; omega]
      ring
    · refine Ideal.mem_sup_left ?_
      have ha : j * (N - b) + 1 ≤ a := by
        have : j * N = j * (N - b) + j * b := by rw [← mul_add]; congr 1; omega
        omega
      have : t ^ a * x ^ b = t ^ (a - (j * (N - b) + 1)) * f ⟨b, by omega⟩ := by
        simp only [f]
        rw [show t ^ a = t ^ (a - (j * (N - b) + 1)) * t * t ^ (j * (N - b)) by
          rw [mul_assoc, ← pow_succ', ← pow_add]; congr 1; omega]
        ring
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩)
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hle hc)
  obtain ⟨d, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hy
  obtain ⟨e, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  let d' : ℕ → R := fun b => if h : b < N + 1 then d ⟨b, h⟩ else 0
  have hsum : ∑ b ∈ Finset.range (N + 1), (c b - d' b * t) * x ^ b * t ^ (j * (N - b)) =
      x ^ (N + 1) * e := by
    have h1 : ∑ i : Fin (N + 1), d i * f i =
        ∑ b ∈ Finset.range (N + 1), d' b * (t * x ^ b * t ^ (j * (N - b))) := by
      rw [← Fin.sum_univ_eq_sum_range (fun b => d' b * (t * x ^ b * t ^ (j * (N - b))))]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [d', dif_pos i.isLt, f]
    have h2 : ∑ b ∈ Finset.range (N + 1), (c b - d' b * t) * x ^ b * t ^ (j * (N - b)) =
        ∑ b ∈ Finset.range (N + 1), c b * x ^ b * t ^ (j * (N - b)) -
          ∑ b ∈ Finset.range (N + 1), d' b * (t * x ^ b * t ^ (j * (N - b))) := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun b _ => by ring
    rw [h2, ← h1, ← hyz]
    ring
  intro b hb
  have := mem_maximalIdeal_of_sum_eq_mul ht0 htp hxt hxm htm hj N _ e hsum b hb
  rw [show c b = (c b - d' b * t) + d' b * t by ring]
  exact add_mem this (Ideal.mul_mem_left _ _ htm)

omit [IsDomain R] [IsLocalRing R] in
/-- `v_{x,t;j}(s) = M` as soon as `s ∈ I_M ∖ I_{M+1}`. -/
private theorem monomialValuation_eq_of_mem_of_notMem {s : R} {M : ℕ}
    (h1 : s ∈ monomialIdeal t x j M) (h2 : s ∉ monomialIdeal t x j (M + 1)) :
    monomialValuation t x j s = M := by
  refine le_antisymm (iSup₂_le fun ν hν => ?_) (le_iSup₂_of_le M h1 le_rfl)
  by_contra hlt
  exact h2 (monomialIdeal_antitone _ _ _ (by exact_mod_cast not_le.mp hlt) hν)

/-- `t ∉ I_2`: the weight of `t` is one. -/
private theorem t_notMem_monomialIdeal_two (htx : t ∉ Ideal.span {x})
    (htm : t ∈ maximalIdeal R) : t ∉ monomialIdeal t x j 2 := by
  intro h
  have hle : monomialIdeal t x j 2 ≤ Ideal.span {x} ⊔ Ideal.span {t ^ 2} := by
    refine Ideal.span_le.mpr ?_
    rintro r ⟨a, b, hab, rfl⟩
    rcases b with _ | b
    · refine Ideal.mem_sup_right (Ideal.mem_span_singleton.mpr ⟨t ^ (a - 2), ?_⟩)
      rw [pow_zero, mul_one, ← pow_add]; congr 1; omega
    · exact Ideal.mem_sup_left (Ideal.mem_span_singleton.mpr ⟨t ^ a * x ^ b, by ring⟩)
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hle h)
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
  obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  have hu : IsUnit (1 - b * t) := by
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hm
    exact (maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr
      (by simpa using add_mem hm (Ideal.mul_mem_left _ b htm)))
  apply htx
  have : t * (1 - b * t) = a * x := by linear_combination -hyz
  obtain ⟨w, hw⟩ := hu.exists_right_inv
  rw [show t = a * x * w by rw [← this, mul_assoc, hw, mul_one]]
  exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self x))

/-- `v_{x,t;j}(t) = 1`. -/
private theorem monomialValuation_t (htx : t ∉ Ideal.span {x}) (htm : t ∈ maximalIdeal R) :
    monomialValuation t x j t = 1 :=
  monomialValuation_eq_of_mem_of_notMem (Ideal.subset_span ⟨1, 0, by simp, by simp⟩)
    (t_notMem_monomialIdeal_two htx htm)

/-- `v_{x,t;j}(x) = j`. -/
private theorem monomialValuation_x (ht0 : t ≠ 0)
    (htp : (Ideal.span {t}).IsPrime) (hxt : x ∉ Ideal.span {t})
    (hxm : x ∈ maximalIdeal R) (htm : t ∈ maximalIdeal R) (hj : 1 ≤ j) :
    monomialValuation t x j x = j := by
  refine monomialValuation_eq_of_mem_of_notMem (Ideal.subset_span ⟨0, 1, by simp, by simp⟩) ?_
  intro h
  have := mem_maximalIdeal_of_sum_mem_monomialIdeal ht0 htp hxt hxm htm hj 1
    (fun b => if b = 1 then 1 else 0) (by simpa using h) 1 le_rfl
  simp at this

end WeightedInitialForm

/-! ### Generators of the top differential forms -/

section TopFormsGenerator

/-- If the differentials `dz₁, …, dzₙ` span `Ω_{B/k}` for a domain `B` whose fraction field `K`
has `dim_K Ω_{K/k} = n`, then `dz₁ ∧ ⋯ ∧ dzₙ` generates `Ω^n_{B/k}` and has nonzero image in
`Ω^n_{K/k}`. -/
private theorem span_ιMulti_D_eq_top {k B K : Type*} [CommRing k] [CommRing B] [IsDomain B]
    [Field K] [Algebra k B] [Algebra k K] [Algebra B K] [IsScalarTower k B K]
    [IsFractionRing B K] {n : ℕ} (z : Fin n → B)
    (hz : Submodule.span B (Set.range fun i => D k B (z i)) = ⊤)
    (hn : Module.finrank K Ω[K⁄k] = n) :
    Submodule.span B {exteriorPower.ιMulti B n (fun i => D k B (z i))} = ⊤ ∧
      MMP.Mori.topFormsMap k B K n (exteriorPower.ιMulti B n (fun i => D k B (z i))) ≠ 0 := by
  let zK : Fin n → Ω[K⁄k] := fun i => KaehlerDifferential.map k k B K (D k B (z i))
  have hspanK : Submodule.span K (Set.range zK) = ⊤ := by
    have hs := KaehlerDifferential.span_range_map_derivation_of_isLocalization k B K
      (nonZeroDivisors B)
    refine eq_top_iff.mpr (hs.symm.le.trans (Submodule.span_le.mpr ?_))
    rintro _ ⟨b, rfl⟩
    have hb : D k B b ∈ Submodule.span B (Set.range fun i => D k B (z i)) := hz ▸ Submodule.mem_top
    have : KaehlerDifferential.map k k B K (D k B b) ∈
        (Submodule.span K (Set.range zK)).restrictScalars B := by
      refine Submodule.span_induction (p := fun w _ => KaehlerDifferential.map k k B K w ∈
        (Submodule.span K (Set.range zK)).restrictScalars B) ?_ ?_ ?_ ?_ hb
      · rintro _ ⟨i, rfl⟩; exact Submodule.subset_span ⟨i, rfl⟩
      · simp
      · intro a b _ _ ha hb; rw [map_add]; exact add_mem ha hb
      · intro r a _ ha; rw [map_smul]; exact Submodule.smul_mem _ r ha
    exact this
  have hliK : LinearIndependent K zK :=
    linearIndependent_of_top_le_span_of_card_eq_finrank hspanK.ge (by simp [hn])
  have hliB : LinearIndependent B fun i => D k B (z i) :=
    LinearIndependent.of_comp ((KaehlerDifferential.map k k B K).restrictScalars B)
      (hliK.restrict_scalars' (R := B))
  let b := Module.Basis.mk hliB hz.ge
  have hb : ⇑b = fun i => D k B (z i) := Module.Basis.coe_mk _ _
  refine ⟨?_, ?_⟩
  · refine eq_top_iff.mpr fun w _ => ?_
    obtain ⟨r, hr⟩ := (MMP.Intersection.bijective_smul_ιMulti_basis b).2 w
    rw [← hr, ← hb]
    exact Submodule.smul_mem _ r (Submodule.mem_span_singleton_self _)
  · rw [MMP.Mori.topFormsMap_ιMulti]
    let bK := Module.Basis.mk hliK hspanK.ge
    have hbK : ⇑bK = zK := Module.Basis.coe_mk _ _
    intro h0
    have := (MMP.Intersection.bijective_smul_ιMulti_basis bK).1
      (a₁ := 1) (a₂ := 0) (by simp only [hbK, one_smul, zero_smul]; exact h0)
    exact one_ne_zero this

/-- **Nakayama with the conormal sequence.** In a local ring `B` with `Ω_{B/k}` finite, if the
`pᵢ` generate the maximal ideal and the differentials of the residues of the `qᵢ` span
`Ω_{κ/k}`, then the `dpᵢ` and `dqᵢ` span `Ω_{B/k}`. -/
private theorem span_D_eq_top_of_residue {k B : Type*} [CommRing k] [CommRing B] [IsLocalRing B]
    [Algebra k B] [Module.Finite B Ω[B⁄k]] {ι₁ ι₂ : Type*} [Fintype ι₂] (p : ι₁ → B)
    (q : ι₂ → B) (hp : Ideal.span (Set.range p) = maximalIdeal B)
    (hq : Submodule.span (ResidueField B)
      (Set.range fun i => D k (ResidueField B) (residue B (q i))) = ⊤) :
    Submodule.span B (Set.range (fun i => D k B (p i)) ∪ Set.range (fun i => D k B (q i))) =
      ⊤ := by
  classical
  set N := Submodule.span B (Set.range (fun i => D k B (p i)) ∪ Set.range (fun i => D k B (q i)))
  let κ := ResidueField B
  rw [← IsLocalRing.map_tensorProduct_mk_eq_top]
  set T := N.map (TensorProduct.mk B κ Ω[B⁄k] 1)
  have hT : ∀ y ∈ N, (1 : κ) ⊗ₜ[B] y ∈ T := fun y hy => ⟨y, hy, rfl⟩
  have hTκ : ∀ (c : κ) (w : κ ⊗[B] Ω[B⁄k]), w ∈ T → c • w ∈ T := by
    intro c w hw
    obtain ⟨a, rfl⟩ := residue_surjective c
    rw [show (residue B a) • w = a • w from algebraMap_smul κ a w]
    exact Submodule.smul_mem _ a hw
  -- `1 ⊗ dm ∈ T` for `m ∈ 𝔪`
  have hm : ∀ m ∈ maximalIdeal B, (1 : κ) ⊗ₜ[B] D k B m ∈ T := by
    intro m hm
    rw [← hp] at hm
    refine Submodule.span_induction (p := fun m _ => (1 : κ) ⊗ₜ[B] D k B m ∈ T) ?_ ?_ ?_ ?_ hm
    · rintro _ ⟨i, rfl⟩; exact hT _ (Submodule.subset_span (Or.inl ⟨i, rfl⟩))
    · simp
    · intro a b _ _ ha hb; rw [map_add, tmul_add]; exact add_mem ha hb
    · intro a b hb ih
      have hb0 : residue B b = 0 := by
        rw [residue_eq_zero_iff, ← hp]; exact hb
      rw [smul_eq_mul, Derivation.leibniz, tmul_add, tmul_smul, tmul_smul]
      refine add_mem (Submodule.smul_mem _ a ih) ?_
      rw [smul_tmul', show b • (1 : κ) = residue B b from by
        rw [Algebra.smul_def, mul_one]; rfl, hb0, zero_tmul]
      exact zero_mem _
  refine eq_top_iff.mpr fun w _ => ?_
  have hw : mapBaseChange k B κ w ∈ Submodule.span κ
      (Set.range fun i => D k κ (residue B (q i))) := hq ▸ Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun κ).mp hw
  set w' : κ ⊗[B] Ω[B⁄k] := ∑ i, c i • ((1 : κ) ⊗ₜ[B] D k B (q i))
  have hw'T : w' ∈ T := Submodule.sum_mem _ fun i _ =>
    hTκ _ _ (hT _ (Submodule.subset_span (Or.inr ⟨i, rfl⟩)))
  have hker : mapBaseChange k B κ (w - w') = 0 := by
    simp only [w', map_sub, map_sum, map_smul, mapBaseChange_tmul, one_smul,
      KaehlerDifferential.map_D, ← hc]
    exact sub_self _
  obtain ⟨c', hc'⟩ := (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange k B κ
    residue_surjective (w - w')).mp hker
  obtain ⟨⟨m, hmk⟩, rfl⟩ := Ideal.toCotangent_surjective _ c'
  rw [kerCotangentToTensor_toCotangent] at hc'
  have hmm : m ∈ maximalIdeal B := (residue_eq_zero_iff m).mp hmk
  have := add_mem (hm m hmm) hw'T
  rwa [show (1 : κ) ⊗ₜ[B] D k B m = w - w' from hc', sub_add_cancel] at this

open scoped IntermediateField.algebraAdjoinAdjoin in
/-- In characteristic zero, the differentials of a transcendence basis span `Ω_{L/k}`: `L` is
separable algebraic over `k(w)`, so `Ω_{L/k(w)} = 0`. -/
private theorem span_D_eq_top_of_isTranscendenceBasis {k L : Type*} [Field k] [CharZero k]
    [Field L] [Algebra k L] {ι : Type*} {w : ι → L} (hw : IsTranscendenceBasis k w) :
    Submodule.span L (Set.range fun i => D k L (w i)) = ⊤ := by
  classical
  set M := Submodule.span L (Set.range fun i => D k L (w i))
  let S := Algebra.adjoin k (Set.range w)
  let F := IntermediateField.adjoin k (Set.range w)
  have : Algebra.IsAlgebraic F L := hw.isAlgebraic_field
  have : CharZero F := charZero_of_injective_algebraMap (algebraMap k F).injective
  have : Algebra.IsSeparable F L := Algebra.IsAlgebraic.isSeparable_of_perfectField
  have : Algebra.FormallyEtale F L := Algebra.FormallyEtale.of_isSeparable F L
  have hS : ∀ s ∈ S, D k L s ∈ M := by
    intro s hs
    refine Algebra.adjoin_induction (p := fun s _ => D k L s ∈ M) ?_ ?_ ?_ ?_ hs
    · rintro _ ⟨i, rfl⟩; exact Submodule.subset_span ⟨i, rfl⟩
    · intro c; simp
    · intro a b _ _ ha hb; rw [map_add]; exact add_mem ha hb
    · intro a b _ _ ha hb
      rw [Derivation.leibniz]
      exact add_mem (Submodule.smul_mem _ _ hb) (Submodule.smul_mem _ _ ha)
  have hF : ∀ ω : Ω[F⁄k], KaehlerDifferential.map k k F L ω ∈ M := by
    intro ω
    have hω : ω ∈ Submodule.span F (Set.range
        (⇑(KaehlerDifferential.map k k S F) ∘ ⇑(D k S))) := by
      rw [KaehlerDifferential.span_range_map_derivation_of_isLocalization k S F
        (nonZeroDivisors S)]
      trivial
    refine Submodule.span_induction
      (p := fun ω _ => KaehlerDifferential.map k k F L ω ∈ M) ?_ ?_ ?_ ?_ hω
    · rintro _ ⟨s, rfl⟩
      simp only [Function.comp_apply, KaehlerDifferential.map_D]
      exact hS _ s.2
    · simp
    · intro a b _ _ ha hb; rw [map_add]; exact add_mem ha hb
    · intro a b _ hb
      rw [map_smul, ← algebraMap_smul L]
      exact Submodule.smul_mem _ _ hb
  rw [eq_top_iff]
  rintro x -
  have hx : x ∈ LinearMap.ker (KaehlerDifferential.map k F L L) := Subsingleton.elim _ _
  rw [← KaehlerDifferential.range_mapBaseChange] at hx
  obtain ⟨y, rfl⟩ := hx
  induction y with
  | tmul a ω =>
    rw [KaehlerDifferential.mapBaseChange_tmul]
    exact Submodule.smul_mem _ a (hF ω)
  | add y y' hy hy' => rw [map_add]; exact add_mem hy hy'

/-- In the chart `x = x₁ t^j`: `d(x₁ t^j) ∧ dt ∧ ⋯ = t^j · dx₁ ∧ dt ∧ ⋯`. -/
private theorem ιMulti_cons_D_mul_pow {k B : Type*} [CommRing k] [CommRing B] [Algebra k B]
    {r : ℕ} (x₁ t : B) (j : ℕ) (y : Fin r → B) :
    exteriorPower.ιMulti B (r + 2)
        (Fin.cons (D k B (x₁ * t ^ j)) (Fin.cons (D k B t) fun i => D k B (y i))) =
      t ^ j • exteriorPower.ιMulti B (r + 2)
        (Fin.cons (D k B x₁) (Fin.cons (D k B t) fun i => D k B (y i))) := by
  set f := (exteriorPower.ιMulti B (r + 2) (M := Ω[B⁄k]))
  set w : Fin (r + 1) → Ω[B⁄k] := Fin.cons (D k B t) fun i => D k B (y i)
  have h0 : f (Fin.cons (D k B t) w) = 0 := by
    refine f.map_eq_zero_of_eq _ (i := 0) (j := 1) ?_ (by simp)
    simp [w]
  have hD : D k B (x₁ * t ^ j) = (x₁ * (j * t ^ (j - 1))) • D k B t + t ^ j • D k B x₁ := by
    rw [Derivation.leibniz, Derivation.leibniz_pow]
    congr 1
    rw [mul_smul, mul_smul, Nat.cast_smul_eq_nsmul]
  rw [hD]
  change f.toMultilinearMap (Fin.cons _ w) = t ^ j • f.toMultilinearMap (Fin.cons _ w)
  rw [MultilinearMap.cons_add, MultilinearMap.cons_smul, MultilinearMap.cons_smul]
  change _ • f (Fin.cons (D k B t) w) + _ = _
  rw [h0, smul_zero, zero_add]

/-- **A generator of the top forms from parameters and a transcendence basis.** Let `B` be a
local domain over a field `k` of characteristic zero, with `Ω_{B/k}` finite and fraction field
`K` with `dim_K Ω_{K/k} = n`. If `n` elements `z` of `B` contain generators `p` of the maximal
ideal and lifts `q` of a transcendence basis of the residue field, `dz₁ ∧ ⋯ ∧ dzₙ` generates
`Ω^n_{B/k}` with nonzero image in `Ω^n_{K/k}`. -/
private theorem span_ιMulti_D_eq_top_of_residue {k B K : Type*} [Field k] [CharZero k]
    [CommRing B] [IsDomain B] [IsLocalRing B] [Field K] [Algebra k B] [Algebra k K]
    [Algebra B K] [IsScalarTower k B K] [IsFractionRing B K] [Module.Finite B Ω[B⁄k]]
    {n : ℕ} (z : Fin n → B) {ι₁ ι₂ : Type*} [Fintype ι₂] (p : ι₁ → B) (q : ι₂ → B)
    (hpz : Set.range p ⊆ Set.range z) (hqz : Set.range q ⊆ Set.range z)
    (hp : Ideal.span (Set.range p) = IsLocalRing.maximalIdeal B)
    (hq : IsTranscendenceBasis k fun i => IsLocalRing.residue B (q i))
    (hn : Module.finrank K Ω[K⁄k] = n) :
    Submodule.span B {exteriorPower.ιMulti B n (fun i => D k B (z i))} = ⊤ ∧
      MMP.Mori.topFormsMap k B K n (exteriorPower.ιMulti B n (fun i => D k B (z i))) ≠ 0 := by
  refine span_ιMulti_D_eq_top z (eq_top_iff.mpr ?_) hn
  rw [← span_D_eq_top_of_residue (k := k) p q hp (span_D_eq_top_of_isTranscendenceBasis hq)]
  refine Submodule.span_mono (Set.union_subset ?_ ?_)
  · rintro _ ⟨i, rfl⟩
    obtain ⟨l, hl⟩ := hpz ⟨i, rfl⟩
    exact ⟨l, by simp [hl]⟩
  · rintro _ ⟨i, rfl⟩
    obtain ⟨l, hl⟩ := hqz ⟨i, rfl⟩
    exact ⟨l, by simp [hl]⟩

end TopFormsGenerator

section Transcendence

open Polynomial

variable {A B : Type*} [CommRing A] [IsDomain A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
  {x t : A} {j : ℕ}

/-- **The residue of `x₁ = x / t^j` is transcendental over `κ(η_V)`.** Let `ψ : A → B` be a local
homomorphism with `ψ x = x₁ t'^j`, `ψ t = t'`, `𝔪_B = (t')`, such that `ψ f ∈ (t'^M)` forces
`f ∈ I_M`. Then no nonzero polynomial over `κ_A` kills the residue of `x₁`. -/
private theorem eq_zero_of_eval₂_residue_eq_zero (ht0 : t ≠ 0)
    (htp : (Ideal.span {t}).IsPrime) (hxt : x ∉ Ideal.span {t})
    (hxm : x ∈ maximalIdeal A) (htm : t ∈ maximalIdeal A) (hj : 1 ≤ j)
    (ψ : A →+* B) [IsLocalHom ψ] {x₁ t' : B} (hψx : ψ x = x₁ * t' ^ j) (hψt : ψ t = t')
    (hmB : maximalIdeal B = Ideal.span {t'})
    (H : ∀ (f : A) (M : ℕ), ψ f ∈ Ideal.span {t' ^ M} → f ∈ monomialIdeal t x j M)
    (P : (ResidueField A)[X])
    (hP : P.eval₂ (ResidueField.map ψ) (residue B x₁) = 0) : P = 0 := by
  classical
  set N := P.natDegree
  choose c hc using fun b => residue_surjective (P.coeff b)
  set g : B := ∑ b ∈ Finset.range (N + 1), ψ (c b) * x₁ ^ b
  have hg : residue B g = 0 := by
    rw [← hP, eval₂_eq_sum_range]
    simp only [g, map_sum, map_mul, map_pow]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [← hc b, ResidueField.map_residue]
  have hgm : g ∈ Ideal.span {t'} := hmB ▸ (residue_eq_zero_iff g).mp hg
  obtain ⟨g', hg'⟩ := Ideal.mem_span_singleton'.mp hgm
  set f : A := ∑ b ∈ Finset.range (N + 1), c b * x ^ b * t ^ (j * (N - b))
  have hf : ψ f = t' ^ (j * N + 1) * g' := by
    have : ψ f = t' ^ (j * N) * g := by
      simp only [f, g, map_sum, map_mul, map_pow, hψx, hψt, Finset.mul_sum]
      refine Finset.sum_congr rfl fun b hb => ?_
      have hb := Finset.mem_range.mp hb
      have : j * N = j * b + j * (N - b) := by rw [← mul_add]; congr 1; omega
      rw [this, pow_add, mul_pow, ← pow_mul, mul_comm j b]
      ring
    rw [this, ← hg', pow_succ]
    ring
  have hfI : f ∈ monomialIdeal t x j (j * N + 1) :=
    H f _ (Ideal.mem_span_singleton.mpr ⟨g', hf⟩)
  have hcm := mem_maximalIdeal_of_sum_mem_monomialIdeal ht0 htp hxt hxm htm hj N c hfI
  ext b
  rw [coeff_zero]
  rcases Nat.lt_or_ge N b with hb | hb
  · exact coeff_eq_zero_of_natDegree_lt hb
  · rw [← hc b]
    exact (residue_eq_zero_iff _).mpr (hcm b hb)

/-- The transcendence of the residue of `x₁` over `κ_A`, from
`eq_zero_of_eval₂_residue_eq_zero`, for `ψ = algebraMap A B`. -/
private theorem transcendental_residue_of_eval₂ [Algebra A B] [IsLocalHom (algebraMap A B)]
    {x₁ : B}
    (h : ∀ P : (ResidueField A)[X],
      P.eval₂ (ResidueField.map (algebraMap A B)) (residue B x₁) = 0 → P = 0) :
    Transcendental (ResidueField A) (residue B x₁) := by
  rw [transcendental_iff]
  intro P hP
  refine h P ?_
  have : ResidueField.map (algebraMap A B) = algebraMap (ResidueField A) (ResidueField B) := by
    ext a
    obtain ⟨a, rfl⟩ := residue_surjective a
    rfl
  rw [this, ← aeval_def, hP]

/-- Adjoining to the image of an algebraically independent family of `κ_A` an element of `κ_B`
transcendental over `κ_A` keeps the family algebraically independent over `k`. -/
private theorem algebraicIndependent_option_residue {k : Type*} [Field k] [Algebra A B]
    [IsLocalHom (algebraMap A B)] [Algebra k A] [Algebra k B] [IsScalarTower k A B] {r : ℕ}
    {y : Fin r → ResidueField A} (hy : AlgebraicIndependent k y) {x₁ : ResidueField B}
    (htr : Transcendental (ResidueField A) x₁) :
    AlgebraicIndependent k
      (fun o : Option (Fin r) =>
        o.elim x₁ fun i => algebraMap (ResidueField A) (ResidueField B) (y i)) := by
  let φ := IsScalarTower.toAlgHom k (ResidueField A) (ResidueField B)
  rw [AlgebraicIndependent.option_iff]
  refine ⟨hy.map' (f := φ) (algebraMap (ResidueField A) (ResidueField B)).injective, ?_⟩
  have hle :
      Algebra.adjoin k (Set.range fun i => algebraMap (ResidueField A) (ResidueField B) (y i))
      ≤ φ.range := Algebra.adjoin_le (by rintro _ ⟨i, rfl⟩; exact ⟨y i, rfl⟩)
  refine Transcendental.of_tower_top_of_subalgebra_le hle ?_
  exact htr.ringHom_of_comp_eq (φ.rangeRestrict : ResidueField A →+* φ.range)
    (RingHom.id (ResidueField B)) φ.rangeRestrict_surjective Function.injective_id rfl

end Transcendence

section Parameters

variable {R : Type*} [CommRing R] [IsRegularLocalRing R] {x t : R}

/-- The facts about a regular system of parameters `(x, t)` used above. -/
private theorem regularParameters_facts (hz : MMP.Mori.IsRegularSystemOfParameters ![x, t]) :
    IsDomain R ∧ x ≠ 0 ∧ t ≠ 0 ∧ (Ideal.span {t}).IsPrime ∧ x ∉ Ideal.span {t} ∧
      t ∉ Ideal.span {x} ∧ x ∈ maximalIdeal R ∧ t ∈ maximalIdeal R := by
  have h0 := ne_zero_of_isRegularSystemOfParameters hz 0
  have h1 := ne_zero_of_isRegularSystemOfParameters hz 1
  have hp := isPrime_span_singleton_of_isRegularSystemOfParameters hz 1
  have hxt := notMem_span_singleton_of_isRegularSystemOfParameters hz
    (m := (1 : Fin 2)) (m' := 0) (by decide)
  have htx := notMem_span_singleton_of_isRegularSystemOfParameters hz
    (m := (0 : Fin 2)) (m' := 1) (by decide)
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h0 h1 hp hxt htx
  exact ⟨IsRegularLocalRing.isDomain R, h0, h1, hp, hxt, htx,
    hz.1 ▸ Ideal.subset_span ⟨0, by simp⟩, hz.1 ▸ Ideal.subset_span ⟨1, by simp⟩⟩

/-- A valuation restricting to `exp (-v_{x,t;j})` on a regular system of parameters `x, t` takes
the values `exp (-1)` at `t` and `exp (-j)` at `x`. -/
private theorem valuation_t_x_eq {K : Type*} [Field K] [Algebra R K] {w : Valuation K ℤᵐ⁰}
    {j : ℕ} (hz : MMP.Mori.IsRegularSystemOfParameters ![x, t]) (hj : 1 ≤ j)
    (hv : ∀ f : R, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      w (algebraMap R K f) = WithZero.exp (-(M : ℤ))) :
    w (algebraMap R K t) = WithZero.exp (-1) ∧ w (algebraMap R K x) = WithZero.exp (-(j : ℤ)) := by
  obtain ⟨hdom, hx0, ht0, htp, hxt, htx, hxm, htm⟩ := regularParameters_facts hz
  obtain ⟨M, hM, hvM⟩ := hv t ht0
  obtain ⟨N, hN, hvN⟩ := hv x hx0
  rw [monomialValuation_t htx htm] at hM
  rw [monomialValuation_x ht0 htp hxt hxm htm hj] at hN
  have hM1 : M = 1 := by exact_mod_cast hM.symm
  have hNj : N = j := by exact_mod_cast hN.symm
  rw [hvM, hvN, hM1, hNj]
  exact ⟨rfl, rfl⟩

end Parameters

/-! ### Stalks of a variety -/

section Stalks

variable {k : Type u} [Field k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k))

/-- **Dimension formula.** On an irreducible scheme of dimension `n` locally of finite type over
`k`, `trdeg_k κ(x) + dim 𝒪_{X,x} = n`. -/
private theorem trdeg_residueField_stalk [IrreducibleSpace X] [LocallyOfFiniteType sX] {n : ℕ}
    (hn : topologicalKrullDim X = n) (x : X) {d : ℕ}
    (hd : ringKrullDim (X.presheaf.stalk x) = d) :
    letI := stalkAlgebra sX x
    Algebra.trdeg k (IsLocalRing.ResidueField (X.presheaf.stalk x)) = ((n - d : ℕ) : Cardinal) ∧
      d ≤ n := by
  let := stalkAlgebra sX x
  have h := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k X sX x
  rw [← topologicalKrullDim_eq_topologicalKrullDimAt_of_irreducible k X sX x, hn, hd] at h
  have h' : (n : WithBot ℕ∞) = (Cardinal.toENat
      (Algebra.trdeg k (IsLocalRing.ResidueField (X.presheaf.stalk x))) : WithBot ℕ∞) + d := h
  generalize hT : Cardinal.toENat
      (Algebra.trdeg k (IsLocalRing.ResidueField (X.presheaf.stalk x))) = T at h'
  induction T using ENat.recTopCoe with
  | top =>
    have : (n : ℕ∞) = ⊤ + d := by exact_mod_cast h'
    simp at this
  | coe e =>
    have he : n = e + d := by exact_mod_cast h'
    refine ⟨?_, by omega⟩
    rw [show n - d = e by omega]
    exact Cardinal.toENat_eq_natCast.mp hT

/-- A transcendence basis of a field of finite transcendence degree `r`, indexed by `Fin r`. -/
private theorem exists_isTranscendenceBasis_fin {k L : Type*} [Field k] [Field L] [Algebra k L]
    {r : ℕ} (hr : Algebra.trdeg k L = r) : ∃ w : Fin r → L, IsTranscendenceBasis k w := by
  have : FaithfulSMul k L :=
    (faithfulSMul_iff_algebraMap_injective k L).mpr (algebraMap k L).injective
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis k L
  have hcard : Cardinal.mk s = r := hs.cardinalMk_eq_trdeg.trans hr
  obtain ⟨e⟩ := Cardinal.mk_eq_nat_iff.mp hcard
  let w : Fin r → L := fun i => (e.symm i : L)
  have hinj : Function.Injective w := Subtype.val_injective.comp e.symm.injective
  have hrange : Set.range w = s := by
    ext a
    exact ⟨by rintro ⟨i, rfl⟩; exact (e.symm i).2, fun ha => ⟨e ⟨a, ha⟩, by simp [w]⟩⟩
  refine ⟨w, (isTranscendenceBasis_subtype_range hinj).mp ?_⟩
  have key : ∀ t : Set L, t = s → IsTranscendenceBasis k ((↑) : t → L) := by
    rintro t rfl; exact hs
  exact key _ hrange

/-- The degree of the rational top forms: `dim_{k(X)} Ω_{k(X)/k} = dim X`, over a perfect field. -/
private theorem finrank_kaehlerDifferential_functionField [PerfectField k] [IsIntegral X]
    [LocallyOfFiniteType sX] {n : ℕ} (hn : topologicalKrullDim X = n) :
    letI := functionFieldAlgebra sX
    Module.finrank X.functionField Ω[X.functionField⁄k] = n := by
  let := functionFieldAlgebra sX
  have := essFiniteType_functionField (sX := sX)
  exact (finrank_kaehlerDifferential_eq_trdeg k X.functionField).trans
    (toNat_trdeg_functionField_of_topologicalKrullDim_eq hn)

/-- **A generator of the top forms at a regular point of codimension two.** If `(x, t)` is a
regular system of parameters of `𝒪_{X,p}` and `dim X = n`, then `n = r + 2` with
`r = trdeg_k κ(p)`, and for lifts `y` of a transcendence basis of `κ(p)` the form
`dx ∧ dt ∧ dy₁ ∧ ⋯ ∧ dy_r` generates `Ω^n_{𝒪_{X,p}/k}`, with nonzero image in `Ω^n_{k(X)/k}`. -/
public theorem exists_stalk_topForms_generator [CharZero k] [IsIntegral X]
    [LocallyOfFiniteType sX] {n : ℕ} (hn : topologicalKrullDim X = n) (p : X)
    [IsRegularLocalRing (X.presheaf.stalk p)] {x t : X.presheaf.stalk p}
    (hz : MMP.Mori.IsRegularSystemOfParameters ![x, t]) :
    letI := stalkAlgebra sX p
    letI := functionFieldAlgebra sX
    haveI := isScalarTower_stalk_functionField sX p
    ∃ (r : ℕ) (y : Fin r → X.presheaf.stalk p), n = r + 2 ∧
      IsTranscendenceBasis k (fun i => IsLocalRing.residue _ (y i)) ∧
      Submodule.span (X.presheaf.stalk p) {(exteriorPower.ιMulti (X.presheaf.stalk p) (r + 2)
        (Fin.cons (D k (X.presheaf.stalk p) x) (Fin.cons (D k (X.presheaf.stalk p) t)
          fun i => D k (X.presheaf.stalk p) (y i))))} = ⊤ ∧
      MMP.Mori.topFormsMap k (X.presheaf.stalk p) X.functionField (r + 2)
        (exteriorPower.ιMulti (X.presheaf.stalk p) (r + 2)
          (Fin.cons (D k (X.presheaf.stalk p) x) (Fin.cons (D k (X.presheaf.stalk p) t)
            fun i => D k (X.presheaf.stalk p) (y i)))) ≠ 0 := by
  let := stalkAlgebra sX p
  let := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX p
  have : Algebra.EssFiniteType k (X.presheaf.stalk p) :=
    essFiniteType_stalkAlgebra sX p
  have hd : ringKrullDim (X.presheaf.stalk p) = (2 : ℕ) := hz.2
  obtain ⟨htr, hle⟩ := trdeg_residueField_stalk sX hn p hd
  obtain ⟨w, hw⟩ := exists_isTranscendenceBasis_fin htr
  choose y hy using fun i => IsLocalRing.residue_surjective (w i)
  have hyw : (fun i => IsLocalRing.residue _ (y i)) = w := funext hy
  have hw' : IsTranscendenceBasis k (fun i => IsLocalRing.residue (X.presheaf.stalk p) (y i)) := by
    rwa [hyw]
  refine ⟨n - 2, y, by omega, hw', ?_⟩
  have hn' : Module.finrank X.functionField Ω[X.functionField⁄k] = n - 2 + 2 := by
    rw [finrank_kaehlerDifferential_functionField sX hn]; omega
  have : Module.Finite (X.presheaf.stalk p) Ω[X.presheaf.stalk p⁄k] := inferInstance
  have hfam : (fun i => D k (X.presheaf.stalk p)
      ((Fin.cons x (Fin.cons t y) : Fin (n - 2 + 2) → X.presheaf.stalk p) i)) =
      Fin.cons (D k (X.presheaf.stalk p) x) (Fin.cons (D k (X.presheaf.stalk p) t)
        fun i => D k (X.presheaf.stalk p) (y i)) := by
    funext i
    refine Fin.cases rfl (fun i => Fin.cases rfl (fun i => rfl) i) i
  have key := span_ιMulti_D_eq_top_of_residue (k := k) (B := X.presheaf.stalk p)
    (K := X.functionField) (Fin.cons x (Fin.cons t y) : Fin (n - 2 + 2) → X.presheaf.stalk p)
    ![x, t] y ?_ ?_ ?_ hw' hn'
  · rwa [hfam] at key
  · rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
  · rintro _ ⟨i, rfl⟩
    exact ⟨i.succ.succ, rfl⟩
  · rw [← hz.1]

/-- An element of `𝒪_{Y,E}` of valuation `exp (-1)` generates the maximal ideal. -/
private theorem maximalIdeal_eq_span_of_divisorialValuation_eq {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y) {b : E.localRing}
    (hb : E.divisorialValuation (algebraMap E.localRing Y.functionField b) = WithZero.exp (-1)) :
    IsLocalRing.maximalIdeal E.localRing = Ideal.span {b} := by
  have := E.isDiscreteValuationRing_localRing
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  have hb0 : b ≠ 0 := by
    rintro rfl
    simp only [map_zero] at hb
    exact WithZero.exp_ne_zero hb.symm
  obtain ⟨m, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
  have hu : E.divisorialValuation (algebraMap E.localRing Y.functionField u) = 1 := by
    refine le_antisymm ((E.divisorialValuation_le_one_iff _).mpr ⟨_, rfl⟩) ?_
    refine not_lt.mp fun h => ?_
    exact (IsLocalRing.notMem_maximalIdeal.mpr u.isUnit)
      ((E.divisorialValuation_algebraMap_lt_one_iff _).mp h)
  rw [map_mul, map_mul, hu, one_mul, map_pow, map_pow,
    E.divisorialValuation_algebraMap_of_irreducible hϖ, ← WithZero.exp_nsmul] at hb
  have hm : m = 1 := by
    have := WithZero.exp_injective hb
    simp at this
    omega
  subst hm
  rw [pow_one, (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ,
    Ideal.span_singleton_mul_left_unit u.isUnit]

/-- The constant `1` has order `0` along every prime divisor. -/
private theorem ord_one_genericPoint {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (Γ : MMP.Mori.PrimeDivisor Y) :
    Y.ord (1 : Y.functionField) Γ.genericPoint = 0 := by
  have := Γ.divisorialValuation_eq_exp_neg_ord (one_ne_zero (α := Y.functionField))
  rw [map_one, ← WithZero.exp_zero] at this
  have := WithZero.exp_injective this
  omega

end Stalks

/-- The coordinate of the basis vector `σ^{⊗m}` along `σ^{⊗m}` is `1`. -/
private theorem formCoeff_basis {k K A : Type*} [CommRing k] [Field K] [Algebra k K] [CommRing A]
    [Algebra k A] [Algebra A K] [IsScalarTower k A K] [IsFractionRing A K] {d : ℕ} {m : ℤ}
    {σ : ⋀[A]^d Ω[A⁄k]} (hσ : Submodule.span A {σ} = ⊤) (h0 : topFormsMap k A K d σ ≠ 0) :
    formCoeff (k := k) A hσ h0 (ZTensorPower.basis (topFormsBasis A hσ h0) m ()) = 1 := by
  simp [formCoeff]

/-! ### The order of the pulled-back generator along a model of `v` -/

section Chart

variable {k : Type u} [Field k]

/-- Let `t'` have valuation `exp (-1)` along `E` and let `φ : A → 𝒪_{Y',E}` pull back the
valuation of `E` to the monomial valuation `v_{x,t;j}`. If `φ f ∈ (t'^M)`, then `f ∈ I_M`. -/
private theorem mem_monomialIdeal_of_mem_span_pow {Y' : Scheme.{u}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] (E : MMP.Mori.PrimeDivisor Y') {A : Type*}
    [CommRing A] {x t : A} {j : ℕ} (φ : A →+* E.localRing) {t' : E.localRing}
    (hWt : E.divisorialValuation (algebraMap E.localRing Y'.functionField t') =
      WithZero.exp (-1))
    (hv : ∀ f : A, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      E.divisorialValuation (algebraMap E.localRing Y'.functionField (φ f)) =
        WithZero.exp (-(M : ℤ)))
    (f : A) (M : ℕ) (hf : φ f ∈ Ideal.span {t' ^ M}) : f ∈ monomialIdeal t x j M := by
  by_cases hf0 : f = 0
  · rw [hf0]
    exact zero_mem _
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hf
  obtain ⟨M', hM', hvM'⟩ := hv f hf0
  have hle : WithZero.exp (-(M' : ℤ)) ≤ WithZero.exp (-(M : ℤ)) := by
    rw [← hvM', ← hc, map_mul, map_mul, map_pow, map_pow, hWt, ← WithZero.exp_nsmul,
      show M • (-1 : ℤ) = -(M : ℤ) by simp]
    calc E.divisorialValuation (algebraMap E.localRing Y'.functionField c) *
          WithZero.exp (-(M : ℤ))
        ≤ 1 * WithZero.exp (-(M : ℤ)) := by
          gcongr
          exact (E.divisorialValuation_le_one_iff _).mpr ⟨c, rfl⟩
      _ = _ := one_mul _
  have hMM : M ≤ M' := by
    have := WithZero.exp_le_exp.mp hle
    omega
  exact monomialIdeal_antitone _ _ _ hMM (mem_monomialIdeal_of_monomialValuation_eq hM')

/-- If `t'` has valuation `exp (-1)` along `E`, then `t'^j` has order `j` along `E`. -/
private theorem ord_algebraMap_pow_of_divisorialValuation_eq {Y' : Scheme.{u}} [IsIntegral Y']
    [IsLocallyNoetherian Y'] [IsNormal Y'] (E : MMP.Mori.PrimeDivisor Y') {t' : E.localRing}
    (hWt : E.divisorialValuation (algebraMap E.localRing Y'.functionField t') =
      WithZero.exp (-1))
    {j : ℕ} (hh : algebraMap E.localRing Y'.functionField (t' ^ j) ≠ 0) :
    Y'.ord (algebraMap E.localRing Y'.functionField (t' ^ j)) E.genericPoint = j := by
  have := E.divisorialValuation_eq_exp_neg_ord hh
  rw [map_pow, map_pow, hWt, ← WithZero.exp_nsmul, show j • (-1 : ℤ) = -(j : ℤ) by simp] at this
  rw [map_pow]
  have := WithZero.exp_injective this
  omega

/-- A divisor over `Y` lives on a model of the same dimension as `Y`. -/
private theorem topologicalKrullDim_divisorOver_eq {Y : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [LocallyOfFiniteType sY] (Dv : DivisorOver k sY) {n : ℕ} (hn : topologicalKrullDim Y = n) :
    topologicalKrullDim Dv.Y = n := by
  have := Dv.isIntegral
  have := Dv.isNormal
  have := Dv.isLocallyNoetherian
  have := Dv.isDominant
  have : LocallyOfFiniteType (Dv.f ≫ sY) := Dv.isNormalVariety.1.toLocallyOfFiniteType
  let := functionFieldAlgebra sY
  let := functionFieldAlgebra (Dv.f ≫ sY)
  let := functionFieldMapAlgebra Dv.f
  have := isScalarTower_functionFieldMap sY Dv.f
  have htrK : Algebra.trdeg k Y.functionField = Algebra.trdeg k Dv.Y.functionField :=
    (AlgEquiv.ofBijective (IsScalarTower.toAlgHom k Y.functionField Dv.Y.functionField)
      Dv.isBirationalMorphism.functionFieldMap_bijective).trdeg_eq
  rw [← toENat_trdeg_functionField (sX := Dv.f ≫ sY), ← htrK,
    toENat_trdeg_functionField (sX := sY), hn]

/-- **The chart computation.** Let `v` be the weighted monomial valuation `v_{x,t;j}` at the
point `p = f(η_E)` of `Y`, realized by the divisor `(Y', f, E)`, and `σ = dx ∧ dt ∧ dy₁ ∧ ⋯ ∧ dy_r`
the generator of the top forms at `p` built from lifts `y` of a transcendence basis of `κ(p)`. In
`𝒪_{Y',E}` the element `x₁ = x / t^j` is a unit-free coordinate and `σ = t^j · dx₁ ∧ dt ∧ dy`,
where `dx₁ ∧ dt ∧ dy` generates the top forms at `η_E`; so `ord_E(f^*σ) = j · v(t) = j`. -/
private theorem ordPullback_basis_eq [CharZero k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] [LocallyOfFiniteType sY] {r : ℕ}
    (hn : topologicalKrullDim Y = (r + 2 : ℕ)) (Dv : DivisorOver k sY) (p : Y)
    (hp : Dv.f Dv.E.genericPoint = p) [IsRegularLocalRing (Y.presheaf.stalk p)]
    {x t : Y.presheaf.stalk p} {j : ℕ} (hj : 1 ≤ j)
    (hz : MMP.Mori.IsRegularSystemOfParameters ![x, t]) (y : Fin r → Y.presheaf.stalk p)
    (hyb : letI := stalkAlgebra sY p
      IsTranscendenceBasis k fun i => IsLocalRing.residue (Y.presheaf.stalk p) (y i))
    (hσA : letI := stalkAlgebra sY p
      Submodule.span (Y.presheaf.stalk p) {(exteriorPower.ιMulti (Y.presheaf.stalk p) (r + 2)
        (Fin.cons (D k (Y.presheaf.stalk p) x) (Fin.cons (D k (Y.presheaf.stalk p) t)
          fun i => D k (Y.presheaf.stalk p) (y i))))} = ⊤)
    (h0A : letI := stalkAlgebra sY p
      letI := functionFieldAlgebra sY
      haveI := isScalarTower_stalk_functionField sY p
      MMP.Mori.topFormsMap k (Y.presheaf.stalk p) Y.functionField (r + 2)
        (exteriorPower.ιMulti (Y.presheaf.stalk p) (r + 2)
          (Fin.cons (D k (Y.presheaf.stalk p) x) (Fin.cons (D k (Y.presheaf.stalk p) t)
            fun i => D k (Y.presheaf.stalk p) (y i)))) ≠ 0)
    (hv : ∀ f : Y.presheaf.stalk p, f ≠ 0 → ∃ M : ℕ, monomialValuation t x j f = M ∧
      Dv.valuation (algebraMap _ Y.functionField f) = WithZero.exp (-(M : ℤ))) :
    letI := stalkAlgebra sY p
    letI := functionFieldAlgebra sY
    haveI := isScalarTower_stalk_functionField sY p
    Dv.ordPullback (d := r + 2) (m := 1)
      (ZTensorPower.basis (topFormsBasis (Y.presheaf.stalk p) hσA h0A) 1 ()) = j := by
  subst hp
  -- notation and instances
  have := Dv.isIntegral
  have := Dv.isNormal
  have := Dv.isLocallyNoetherian
  have := Dv.isDominant
  have : LocallyOfFiniteType (Dv.f ≫ sY) := Dv.isNormalVariety.1.toLocallyOfFiniteType
  let := stalkAlgebra sY (Dv.f Dv.E.genericPoint)
  let := functionFieldAlgebra sY
  have := isScalarTower_stalk_functionField sY (Dv.f Dv.E.genericPoint)
  let := stalkAlgebra (Dv.f ≫ sY) Dv.E.genericPoint
  let := functionFieldAlgebra (Dv.f ≫ sY)
  have := isScalarTower_stalk_functionField (Dv.f ≫ sY) Dv.E.genericPoint
  let := (Dv.f.stalkMap Dv.E.genericPoint).hom.toAlgebra
  have := MMP.Threefold.Resolution.isScalarTower_stalkMap sY Dv.f Dv.E.genericPoint
  have : IsLocalHom (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing) :=
    inferInstanceAs (IsLocalHom (Dv.f.stalkMap Dv.E.genericPoint).hom)
  have := Dv.E.isDiscreteValuationRing_localRing
  set W := Dv.E.divisorialValuation
  -- the valuation of `𝒪_{Y',E}` restricts to `v` on `𝒪_{Y,p}`
  have hWv : ∀ a : Y.presheaf.stalk (Dv.f Dv.E.genericPoint),
      W (algebraMap Dv.E.localRing Dv.Y.functionField
        (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing a)) =
      Dv.valuation (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Y.functionField a) := by
    intro a
    change W (algebraMap Dv.E.localRing Dv.Y.functionField
      ((Dv.f.stalkMap Dv.E.genericPoint).hom a)) = _
    rw [← MMP.Mori.functionFieldMap_algebraMap_stalk]
    rfl
  obtain ⟨-, -, ht0, htp, hxt, htx, hxm, htm⟩ := regularParameters_facts hz
  obtain ⟨hvt, hvx⟩ := valuation_t_x_eq hz hj hv
  have hWt : W (algebraMap Dv.E.localRing Dv.Y.functionField
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing t)) =
      WithZero.exp (-1) := (hWv t).trans hvt
  have hWx : W (algebraMap Dv.E.localRing Dv.Y.functionField
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing x)) =
      WithZero.exp (-(j : ℤ)) := (hWv x).trans hvx
  have htK0 : algebraMap Dv.E.localRing Dv.Y.functionField
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing t) ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hWt
    exact WithZero.exp_ne_zero hWt.symm
  -- the chart coordinate `x₁ = x / t^j`
  obtain ⟨x₁, hx₁⟩ : algebraMap Dv.E.localRing Dv.Y.functionField
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing x) /
      algebraMap Dv.E.localRing Dv.Y.functionField
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing t) ^ j ∈
      (algebraMap Dv.E.localRing Dv.Y.functionField).range := by
    refine (Dv.E.divisorialValuation_le_one_iff _).mp (le_of_eq ?_)
    change W _ = 1
    rw [map_div₀, map_pow, hWx, hWt, ← WithZero.exp_nsmul,
      show j • (-1 : ℤ) = -(j : ℤ) by simp, div_self WithZero.exp_ne_zero]
  obtain ⟨t', ht'⟩ : ∃ t' : Dv.E.localRing,
      t' = algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing t := ⟨_, rfl⟩
  rw [← ht'] at hWt htK0 hx₁
  have hψx : algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing x =
      x₁ * t' ^ j := by
    refine IsFractionRing.injective Dv.E.localRing Dv.Y.functionField ?_
    rw [map_mul, map_pow, hx₁, div_mul_cancel₀ _ (pow_ne_zero _ htK0)]
  have hmB : IsLocalRing.maximalIdeal Dv.E.localRing = Ideal.span {t'} :=
    maximalIdeal_eq_span_of_divisorialValuation_eq Dv.E hWt
  have H := mem_monomialIdeal_of_mem_span_pow Dv.E
    (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing) hWt fun f hf =>
      let ⟨M, hM, hvM⟩ := hv f hf
      ⟨M, hM, (hWv f).trans hvM⟩
  -- the residue field of `𝒪_{Y',E}`
  have htr := transcendental_residue_of_eval₂ (A := Y.presheaf.stalk (Dv.f Dv.E.genericPoint))
    (B := Dv.E.localRing) (eq_zero_of_eval₂_residue_eq_zero ht0 htp hxt hxm htm hj
      (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing) hψx ht'.symm hmB H)
  have hind := algebraicIndependent_option_residue (k := k) hyb.1 htr
  have hfam : (fun o : Option (Fin r) => IsLocalRing.residue Dv.E.localRing
      (o.elim x₁ fun i =>
        algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i))) =
      fun o => o.elim (IsLocalRing.residue Dv.E.localRing x₁) fun i =>
        algebraMap (IsLocalRing.ResidueField (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)))
          (IsLocalRing.ResidueField Dv.E.localRing)
          (IsLocalRing.residue (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) (y i)) := by
    funext o
    cases o with
    | none => rfl
    | some i => exact (IsLocalRing.ResidueField.algebraMap_residue (y i)).symm
  rw [← hfam] at hind
  -- dimensions
  have hnY := topologicalKrullDim_divisorOver_eq Dv hn
  have hdB : ringKrullDim Dv.E.localRing = (1 : ℕ) := by
    rw [IsDiscreteValuationRing.ringKrullDim_eq_one]; rfl
  obtain ⟨htrB, -⟩ := trdeg_residueField_stalk (Dv.f ≫ sY) hnY Dv.E.genericPoint hdB
  have hqb : IsTranscendenceBasis k fun o : Option (Fin r) => IsLocalRing.residue Dv.E.localRing
      (o.elim x₁ fun i =>
        algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i)) := by
    refine hind.isTranscendenceBasis_of_lift_trdeg_le_of_finite ?_
    rw [htrB, Cardinal.mk_option, Cardinal.mk_fin, show r + 2 - 1 = r + 1 by omega]
    simp
  -- the generator of the top forms at `η_E`
  have : Algebra.EssFiniteType k Dv.E.localRing :=
    essFiniteType_stalkAlgebra (Dv.f ≫ sY) Dv.E.genericPoint
  have hnK' := finrank_kaehlerDifferential_functionField (Dv.f ≫ sY) hnY
  have hfamB : (fun i => D k Dv.E.localRing ((Fin.cons x₁ (Fin.cons t' fun i =>
      algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i)) :
        Fin (r + 2) → Dv.E.localRing) i)) =
      Fin.cons (D k Dv.E.localRing x₁) (Fin.cons (D k Dv.E.localRing t') fun i =>
        D k Dv.E.localRing
          (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i))) := by
    funext i
    refine Fin.cases rfl (fun i => Fin.cases rfl (fun i => rfl) i) i
  have keyB := span_ιMulti_D_eq_top_of_residue (k := k) (B := Dv.E.localRing)
    (K := Dv.Y.functionField) (Fin.cons x₁ (Fin.cons t' fun i =>
      algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i)) :
        Fin (r + 2) → Dv.E.localRing) ![t'] _ ?_ ?_ ?_ hqb hnK'
  rotate_left
  · rintro _ ⟨i, rfl⟩
    fin_cases i
    exact ⟨1, rfl⟩
  · rintro _ ⟨o, rfl⟩
    cases o with
    | none => exact ⟨0, rfl⟩
    | some i => exact ⟨i.succ.succ, rfl⟩
  · rw [hmB]
    congr 1
    ext a
    simp
  rw [hfamB] at keyB
  obtain ⟨hσB, h0B⟩ := keyB
  -- `σ = t^j • σ_B` on the chart
  have hrel : MMP.Mori.topFormsMap k (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing
      (r + 2) (exteriorPower.ιMulti (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) (r + 2)
        (Fin.cons (D k (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) x)
          (Fin.cons (D k (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) t)
            fun i => D k (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) (y i)))) =
      t' ^ j • exteriorPower.ιMulti Dv.E.localRing (r + 2)
        (Fin.cons (D k Dv.E.localRing x₁) (Fin.cons (D k Dv.E.localRing t') fun i =>
          D k Dv.E.localRing
            (algebraMap (Y.presheaf.stalk (Dv.f Dv.E.genericPoint)) Dv.E.localRing (y i)))) := by
    rw [MMP.Mori.topFormsMap_ιMulti, ← ιMulti_cons_D_mul_pow]
    congr 1
    funext i
    refine Fin.cases ?_ (fun i => Fin.cases ?_ (fun i => ?_) i) i
    · simp only [Fin.cons_zero, KaehlerDifferential.map_D]
      rw [hψx]
    · simp only [Fin.cons_succ, Fin.cons_zero, KaehlerDifferential.map_D]
      rw [ht']
    · simp only [Fin.cons_succ, KaehlerDifferential.map_D]
  -- the order of the pull-back
  have hh : algebraMap Dv.E.localRing Dv.Y.functionField (t' ^ j) ≠ 0 := by
    simpa using pow_ne_zero j htK0
  have hτ := (ZTensorPower.basis (topFormsBasis (Y.presheaf.stalk (Dv.f Dv.E.genericPoint))
    hσA h0A) 1).ne_zero ()
  have key := MMP.Threefold.Resolution.ordForm_pullbackRationalPluriForms_eq sY Dv.f Dv.E hσA h0A
    hσB h0B (t' ^ j) hrel hh (m := 1)
    (τ := ZTensorPower.basis (topFormsBasis (Y.presheaf.stalk (Dv.f Dv.E.genericPoint))
      hσA h0A) 1 ()) hτ
  have hordt := ord_algebraMap_pow_of_divisorialValuation_eq Dv.E hWt hh
  change Dv.E.ordForm (pullbackRationalPluriForms sY Dv.f _) = _
  rw [key, formCoeff_basis, map_one, ord_one_genericPoint, hordt]
  simp

end Chart

/-- The generic point of a divisor over `Y` with centre `V` maps to the generic point of `V`. -/
private theorem map_genericPoint_eq_of_center_eq {k : Type u} [Field k] {Y : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (D : DivisorOver k sY) {V : IrreducibleCloseds Y} (hDc : V = D.center) :
    D.f D.E.genericPoint = V.isIrreducible.genericPoint := by
  have h1 : IsGenericPoint (D.f D.E.genericPoint) (V : Set Y) := by
    change closure {D.f D.E.genericPoint} = (V : Set Y)
    rw [← DivisorOver.center_eq_closure_genericPoint, hDc]
  exact h1.eq (V.isIrreducible.isGenericPoint_genericPoint V.isClosed)

/-- **The generator `ω` of the top forms at `η_V` and its order along `E`.** With `dim Y = n`,
there is a nonzero rational `n`-form `ω` (namely `dx ∧ dt ∧ dy₁ ∧ ⋯`) generating the top forms
at `η_V`, so of order `0` along every prime divisor through `η_V`, with `ord_E(f^*ω) = j` for the
divisor `(Y', f, E)` over `Y` realizing `v` with centre `V`. -/
private theorem exists_topForm_ordPullback_eq
    {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {Θ : QDivisor Y}
    {V : IrreducibleCloseds Y} {x t : Y.presheaf.stalk V.isIrreducible.genericPoint} {j : ℕ}
    {v : Valuation Y.functionField ℤᵐ⁰}
    (hv : IsWeightedMonomialValuation sY V x t j v) (hΘ : MMP.Fourfold.IsPair sY Θ)
    (D : DivisorOver k sY) (hDv : v = D.valuation) (hDc : V = D.center) :
    ∃ (n : ℕ) (ω : RationalPluriForms sY n 1), ω ≠ 0 ∧ topologicalKrullDim Y = n ∧
      (∀ Γ : MMP.Mori.PrimeDivisor Y, V.isIrreducible.genericPoint ∈ Γ.support →
        Γ.ordForm ω = 0) ∧
      D.ordPullback ω = j := by
  have := hΘ.charZero
  have : LocallyOfFiniteType sY := hv.1.1.toLocallyOfFiniteType
  -- the dimension
  let := functionFieldAlgebra sY
  have := essFiniteType_functionField (sX := sY)
  obtain ⟨n₀, hn₀'⟩ := Cardinal.lt_aleph0.mp (trdeg_lt_aleph0 k Y.functionField)
  have hn₀ : topologicalKrullDim Y = n₀ := by
    rw [← toENat_trdeg_functionField (sX := sY), hn₀']
    simp
  have : IsRegularLocalRing (Y.presheaf.stalk V.isIrreducible.genericPoint) := hv.2.2.1
  obtain ⟨r, y, hnr, hyb, hσA, h0A⟩ :=
    exists_stalk_topForms_generator sY hn₀ V.isIrreducible.genericPoint hv.2.2.2.1
  subst hnr
  let := stalkAlgebra sY V.isIrreducible.genericPoint
  have := isScalarTower_stalk_functionField sY V.isIrreducible.genericPoint
  refine ⟨r + 2, ZTensorPower.basis (topFormsBasis _ hσA h0A) 1 (),
    (ZTensorPower.basis (topFormsBasis _ hσA h0A) 1).ne_zero (), hn₀, ?_, ?_⟩
  · intro Γ hΓ
    refine (MMP.Threefold.Resolution.ordForm_eq_ord_formCoeff sY _ Γ hΓ hσA h0A (d := r + 2)
      (m := 1) _).trans ?_
    rw [formCoeff_basis, ord_one_genericPoint]
  · have hp := map_genericPoint_eq_of_center_eq D hDc
    refine ordPullback_basis_eq hn₀ D V.isIrreducible.genericPoint hp hv.2.2.2.2.1 hv.2.2.2.1 y hyb
      hσA h0A ?_
    intro f hf
    obtain ⟨M, hM, hvM⟩ := hv.2.2.2.2.2 f hf
    exact ⟨M, hM, hDv ▸ hvM⟩

open Classical in
/-- **The order of a local equation of a prime divisor.** If `g` generates the ideal of a prime
divisor `S` in `𝒪_{Y,x}`, then `g ≠ 0` in `k(Y)`, and along a prime divisor `Γ` through `x` the
order of `g` is `1` if `Γ = S` and `0` otherwise. -/
private theorem ord_algebraMap_of_stalk_eq_span {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {x : Y} (S Γ : MMP.Mori.PrimeDivisor Y)
    (hΓ : x ∈ Γ.support) {g : Y.presheaf.stalk x}
    (hg : IdealSheafData.stalk S.idealSheaf x = Ideal.span {g}) :
    algebraMap (Y.presheaf.stalk x) Y.functionField g ≠ 0 ∧
      Y.ord (algebraMap (Y.presheaf.stalk x) Y.functionField g) Γ.genericPoint =
        if Γ = S then 1 else 0 := by
  have hsp := MMP.Resolution.Aux.genericPoint_specializes_of_mem_support Γ hΓ
  have := Γ.isDiscreteValuationRing_localRing
  set a := (Y.presheaf.stalkSpecializes hsp).hom g with ha
  have hga : algebraMap (Y.presheaf.stalk x) Y.functionField g =
      algebraMap Γ.localRing Y.functionField a := (MMP.Mori.algebraMap_stalkSpecializes hsp g).symm
  have hI : IdealSheafData.stalk S.idealSheaf Γ.genericPoint = Ideal.span {a} := by
    rw [MMP.Resolution.Aux.stalk_eq_map_stalkSpecializes _ hsp, hg, Ideal.map_span,
      Set.image_singleton]
  rw [hga]
  by_cases hΓS : Γ = S
  · subst hΓS
    rw [ite_eq_left rfl]
    rw [MMP.Resolution.Aux.stalk_idealSheaf_genericPoint] at hI
    have hirr : Irreducible a := (IsDiscreteValuationRing.irreducible_iff_uniformizer a).mpr hI
    have hne : algebraMap Γ.localRing Y.functionField a ≠ 0 := by
      intro h0
      have := IsFractionRing.injective Γ.localRing Y.functionField (h0.trans (map_zero _).symm)
      exact hirr.ne_zero this
    refine ⟨hne, ?_⟩
    have h1 := Γ.divisorialValuation_algebraMap_of_irreducible hirr
    rw [Γ.divisorialValuation_eq_exp_neg_ord hne] at h1
    have := WithZero.exp_injective h1
    omega
  · rw [ite_eq_right hΓS]
    have hnot : Γ.genericPoint ∉ S.support := by
      intro hmem
      exact hΓS (MMP.Positivity.PrimeDivisor.eq_of_genericPoint_specializes
        (MMP.Resolution.Aux.genericPoint_specializes_of_mem_support S hmem)).symm
    rw [MMP.Intersection.stalk_idealSheaf_eq_top_of_notMem_support S hnot, eq_comm,
      Ideal.span_singleton_eq_top] at hI
    exact ⟨(hI.map _).ne_zero, Γ.ord_algebraMap_of_isUnit hI⟩

/-- A generator of the stalk at `x` of the ideal sheaf of a prime divisor is nonzero in `k(Y)`. -/
private theorem algebraMap_ne_zero_of_stalk_eq_span {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {x : Y} (S : MMP.Mori.PrimeDivisor Y)
    {g : Y.presheaf.stalk x} (hg : IdealSheafData.stalk S.idealSheaf x = Ideal.span {g}) :
    algebraMap (Y.presheaf.stalk x) Y.functionField g ≠ 0 := by
  by_cases hxS : x ∈ S.support
  · exact (ord_algebraMap_of_stalk_eq_span S S hxS hg).1
  · rw [MMP.Intersection.stalk_idealSheaf_eq_top_of_notMem_support S hxS, eq_comm,
      Ideal.span_singleton_eq_top] at hg
    exact (hg.map _).ne_zero

/-- Along a prime divisor `Γ` through `x`, the orders of local equations `f S` at `x` of the
prime divisors `S` in the support of `Θ`, weighted by `-Θ(S)`, sum to `-Θ(Γ)`. -/
private theorem sum_ord_algebraMap_mul_neg_coeff {Y : Scheme.{u}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] {x : Y} (Θ : QDivisor Y)
    (f : MMP.Mori.PrimeDivisor Y → Y.presheaf.stalk x)
    (hf : ∀ S ∈ Θ.support, IdealSheafData.stalk S.idealSheaf x = Ideal.span {f S})
    (Γ : MMP.Mori.PrimeDivisor Y) (hΓ : x ∈ Γ.support) :
    ∑ S : Θ.support, (Y.ord (algebraMap (Y.presheaf.stalk x) Y.functionField (f S.1))
      Γ.genericPoint : ℝ) * -(Θ.coeff S.1 : ℝ) = -(Θ.coeff Γ : ℝ) := by
  classical
  rw [Finset.sum_coe_sort Θ.support (fun S =>
      (Y.ord (algebraMap (Y.presheaf.stalk x) Y.functionField (f S)) Γ.genericPoint : ℝ) *
        -(Θ.coeff S : ℝ)),
    Finset.sum_congr rfl fun S hS => by rw [(ord_algebraMap_of_stalk_eq_span S Γ hΓ (hf S hS)).2]]
  by_cases hΓs : Γ ∈ Θ.support
  · simp [hΓs]
  · have : Θ.coeff Γ = 0 := Finsupp.notMem_support_iff.mp hΓs
    simp [this]

/-- Along a prime divisor `Γ` through `x` on which `ω` has order `0`, for `ω₀` with
`div ω₀ = K₀` and `g` of order `M(Γ) = m (K₀(Γ) + Θ(Γ))` along `Γ`, the orders along `Γ` of
`g`, `ω₀ / b`, `ω / b` and the local equations `f S`, weighted by `1/m`, `-1`, `1` and `-Θ(S)`,
sum to `0`. -/
private theorem sum_ord_mul_eq_zero_of_ordForm_eq_zero {k : Type u} [Field k] [CharZero k]
    {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [LocallyOfFiniteType sY] {Θ : QDivisor Y} {K₀ M : Divisor Y} {m : ℕ} (hm0 : (m : ℝ) ≠ 0)
    (hMΓ : ∀ Γ, (M.coeff Γ : ℝ) = m * (K₀.coeff Γ + Θ.coeff Γ)) {x : Y}
    (f : MMP.Mori.PrimeDivisor Y → Y.presheaf.stalk x)
    (hf : ∀ S ∈ Θ.support, IdealSheafData.stalk S.idealSheaf x = Ideal.span {f S}) {n : ℕ}
    (hd : letI := functionFieldAlgebra sY; (Algebra.trdeg k Y.functionField).toNat = n)
    (β : letI := functionFieldAlgebra sY
      Module.Basis Unit Y.functionField (⋀[Y.functionField]^n Ω[Y.functionField⁄k]))
    {ω ω₀ : RationalPluriForms sY n 1} (hω : ω ≠ 0) (hω₀0 : ω₀ ≠ 0)
    (hω₀ : ∀ Γ : MMP.Mori.PrimeDivisor Y, Γ.ordForm ω₀ = K₀.coeff Γ) (g : Y.functionField)
    (Γ : MMP.Mori.PrimeDivisor Y) (hΓ : x ∈ Γ.support) (hω0 : Γ.ordForm ω = 0)
    (hg : (Y.ord g Γ.genericPoint : ℝ) = M.coeff Γ) :
    letI := functionFieldAlgebra sY
    (Y.ord g Γ.genericPoint : ℝ) * (1 / m) +
      ((Y.ord ((ZTensorPower.basis β 1).repr ω₀ ()) Γ.genericPoint : ℝ) * -1 +
        ((Y.ord ((ZTensorPower.basis β 1).repr ω ()) Γ.genericPoint : ℝ) * 1 +
          ∑ S : Θ.support, (Y.ord (algebraMap (Y.presheaf.stalk x) Y.functionField (f S.1))
            Γ.genericPoint : ℝ) * -(Θ.coeff S.1 : ℝ))) = 0 := by
  letI := functionFieldAlgebra sY
  obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hd β
  have e1 : (Γ.ordForm ω₀ : ℝ) = Y.ord ((ZTensorPower.basis β 1).repr ω₀ ()) Γ.genericPoint + NΓ :=
    by exact_mod_cast (by simpa using hNΓ 1 ω₀ hω₀0)
  have e2 : (Γ.ordForm ω : ℝ) = Y.ord ((ZTensorPower.basis β 1).repr ω ()) Γ.genericPoint + NΓ :=
    by exact_mod_cast (by simpa using hNΓ 1 ω hω)
  have e0 : (Γ.ordForm ω : ℝ) = 0 := by exact_mod_cast hω0
  have e1' : (Γ.ordForm ω₀ : ℝ) = K₀.coeff Γ := by exact_mod_cast hω₀ Γ
  rw [sum_ord_algebraMap_mul_neg_coeff Θ f hf Γ hΓ, hg, hMΓ Γ]
  field_simp
  linear_combination e1 - e2 - e1' + e0

/-- Pulled back along a divisor `D` over `Y`, the orders along `E` of nonzero functions `f S`,
weighted by `-Θ(S)`, sum to `-∑_S Θ(S) (-log v_D(f S))`. -/
private theorem sum_ord_functionFieldMap_mul_neg_coeff {k : Type u} [Field k] {Y : Scheme.{u}}
    {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] {Θ : QDivisor Y} (D : DivisorOver k sY)
    [IsIntegral D.Y] [IsLocallyNoetherian D.Y] [IsNormal D.Y] [IsDominant D.f] {x : Y}
    (f : MMP.Mori.PrimeDivisor Y → Y.presheaf.stalk x)
    (hfS0 : ∀ S ∈ Θ.support, algebraMap (Y.presheaf.stalk x) Y.functionField (f S) ≠ 0) :
    ∑ S : Θ.support, (D.Y.ord (functionFieldMap D.f (algebraMap (Y.presheaf.stalk x)
        Y.functionField (f S.1))) D.E.genericPoint : ℝ) * -(Θ.coeff S.1 : ℝ) =
      -∑ S ∈ Θ.support, (Θ.coeff S : ℝ) *
        ((-WithZero.log (D.valuation (algebraMap _ Y.functionField (f S))) : ℤ) : ℝ) := by
  rw [Finset.sum_coe_sort Θ.support (fun S =>
    (D.Y.ord (functionFieldMap D.f (algebraMap (Y.presheaf.stalk x)
      Y.functionField (f S))) D.E.genericPoint : ℝ) * -(Θ.coeff S : ℝ)),
    ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun S hS => ?_
  change _ = -((Θ.coeff S : ℝ) * ((-WithZero.log (D.E.divisorialValuation
    (functionFieldMap D.f (algebraMap _ Y.functionField (f S)))) : ℤ) : ℝ))
  rw [D.E.divisorialValuation_eq_exp_neg_ord ((map_ne_zero _).mpr (hfS0 S hS)),
    WithZero.log_exp, neg_neg]
  ring

/-- **The assembly.** With `ω` from `exists_topForm_ordPullback_eq`, write `K_Y + Θ = (1/m)·M`
for a canonical divisor `K_Y = div(ω₀)` and a Cartier divisor `M` with local equation `φ` at
`η_V`. Along every prime divisor `Γ` through `η_V`, `ord_Γ(φ)/m - ord_Γ(ω₀/b) + ord_Γ(ω/b) -
∑_S Θ_S ord_Γ(f_S) = 0` (for a basis `b` of the top forms of `k(Y)`), since `ω` has order `0`
there and `f_S` is a local equation of `S`; this relation pulls back to `E`, where
`ord_E(f^*φ) = coeff_E(f^*M)` and `ord_E(f^*f_S) = -log v(f_S)`. -/
private theorem hasLogDiscrepancy_of_ordPullback_eq
    {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {Θ : QDivisor Y}
    {V : IrreducibleCloseds Y} {j : ℕ} {v : Valuation Y.functionField ℤᵐ⁰}
    (hΘ : IsPair sY Θ)
    (f : MMP.Mori.PrimeDivisor Y → Y.presheaf.stalk V.isIrreducible.genericPoint)
    (hf : ∀ S ∈ Θ.support, IdealSheafData.stalk S.idealSheaf V.isIrreducible.genericPoint =
      Ideal.span {f S})
    (D : DivisorOver k sY) (hDp : IsProper D.f) (hDv : v = D.valuation) (hDc : V = D.center)
    {n : ℕ} (ω : RationalPluriForms sY n 1) (hω : ω ≠ 0) (hn : topologicalKrullDim Y = n)
    (hω0 : ∀ Γ : MMP.Mori.PrimeDivisor Y, V.isIrreducible.genericPoint ∈ Γ.support →
      Γ.ordForm ω = 0)
    (hωD : D.ordPullback ω = j) :
    MMP.Intersection.IsLogDiscrepancy sY n (QDivisor.toRDivisor Θ) D
      (1 + j - ∑ S ∈ Θ.support,
        (Θ.coeff S : ℝ) * (-WithZero.log (v (algebraMap _ Y.functionField (f S))) : ℤ)) := by
  classical
  have := hΘ.charZero
  obtain ⟨hX, n₀, K₀, hK₀, hQ⟩ := hΘ.isPair
  obtain ⟨m, hm, M, hM, hMc⟩ := hQ.exists_pos
  have hn₀ : n = n₀ := by
    have := hK₀.topologicalKrullDim_eq
    rw [hn] at this
    exact_mod_cast this
  subst hn₀
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have : CompactSpace D.Y := by
    have := D.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (D.f ≫ sY)
  obtain ⟨ω₀, hω₀0, hω₀⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK₀
  obtain ⟨M', hM'⟩ := MMP.Threefold.Bridges.exists_isPullback_of_isDominant D.f hMc
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hMΓ : ∀ Γ, (M.coeff Γ : ℝ) = m * (K₀.coeff Γ + Θ.coeff Γ) := by
    intro Γ
    have hMΓ : (M.coeff Γ : ℚ) = m * (K₀.coeff Γ + Θ.coeff Γ) := by
      have := congrArg (fun G : QDivisor Y => G.coeff Γ) hM
      simp at this
      linear_combination this
    exact_mod_cast hMΓ
  have hb : MMP.Intersection.IsLogDiscrepancy sY n (QDivisor.toRDivisor Θ) D
      (1 + (D.ordPullback ω₀ : ℝ) - ∑ _i : Fin 1, (1 / (m : ℝ)) * (M'.coeff D.E : ℝ)) := by
    refine ⟨hX, hDp, ω₀, hω₀0, ⟨K₀, hK₀, fun Γ => (hω₀ Γ).symm⟩, 1, fun _ => 1 / (m : ℝ),
      fun _ => M, fun _ => M', fun _ => hMc, fun Γ => ?_, fun _ => ⟨_, hM'⟩, rfl⟩
    rw [QDivisor.coeff_toRDivisor, Fin.sum_univ_one, hMΓ Γ, hω₀ Γ]
    field_simp
  convert hb using 1
  subst hDv
  have hp := map_genericPoint_eq_of_center_eq D hDc
  let := MMP.Mori.functionFieldAlgebra sY
  have : LocallyOfFiniteType sY := hX.1.toLocallyOfFiniteType
  have hd := MMP.Mori.toNat_trdeg_functionField_of_topologicalKrullDim_eq (sX := sY) hn
  obtain ⟨β, N, hN⟩ := D.exists_ordPullback_eq hX hn
  obtain ⟨U, hU, φ, hφ⟩ := hMc V.isIrreducible.genericPoint
  let Z0 := MMP.Mori.pointComponent V.isIrreducible.genericPoint
  set g := MMP.Threefold.Mori.Helpers.evalFF Z0 (φ : MMP.Mori.RationalFunctions Y) with hg_def
  have hg : g ≠ 0 := (φ.isUnit.map _).ne_zero
  set cω := (MMP.Mori.ZTensorPower.basis β 1).repr ω () with hcω
  set cω₀ := (MMP.Mori.ZTensorPower.basis β 1).repr ω₀ () with hcω₀
  have hcω0 : cω ≠ 0 := MMP.Mori.repr_ne_zero_of_ne_zero β hω
  have hcω₀0 : cω₀ ≠ 0 := MMP.Mori.repr_ne_zero_of_ne_zero β hω₀0
  have hfS0 : ∀ S ∈ Θ.support,
      algebraMap (Y.presheaf.stalk V.isIrreducible.genericPoint) Y.functionField (f S) ≠ 0 :=
    fun S hS => algebraMap_ne_zero_of_stalk_eq_span S (hf S hS)
  let G : Option (Option (Option Θ.support)) → Y.functionField := fun o =>
    Option.elim o g fun o => Option.elim o cω₀ fun o => Option.elim o cω fun S =>
      algebraMap (Y.presheaf.stalk V.isIrreducible.genericPoint) Y.functionField (f S.1)
  let w : Option (Option (Option Θ.support)) → ℝ := fun o =>
    Option.elim o (1 / (m : ℝ)) fun o => Option.elim o (-1) fun o => Option.elim o 1 fun S =>
      -(Θ.coeff S.1 : ℝ)
  have hG : ∀ o, G o ≠ 0 := by
    rintro (_ | _ | _ | S)
    exacts [hg, hcω₀0, hcω0, hfS0 S.1 S.2]
  have key := MMP.Threefold.Bridges.sum_ord_functionFieldMap_eq_zero (f := D.f) D.E G hG w
    fun Γ hΓ => by
      rw [hp] at hΓ
      have hZ : Γ.component = Z0 := Subsingleton.elim
        (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := Y)) _ _
      simpa only [Fintype.sum_option, G, w, Option.elim] using
        sum_ord_mul_eq_zero_of_ordForm_eq_zero hm0 hMΓ f hf hd β hω hω₀0 hω₀ g Γ hΓ (hω0 Γ hΓ)
          (by rw [hφ Γ ⟨_, hΓ, hU⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hZ])
  simp only [Fintype.sum_option, G, w, Option.elim] at key
  have hcoeff : (M'.coeff D.E : ℝ) = D.Y.ord (functionFieldMap D.f g) D.E.genericPoint := by
    exact_mod_cast MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hM' hφ D.E (hp ▸ hU) Z0
  have h1 : (D.ordPullback ω₀ : ℝ) =
      D.Y.ord (functionFieldMap D.f cω₀) D.E.genericPoint + N := by
    exact_mod_cast (by simpa using hN 1 ω₀ hω₀0)
  have h2 : (j : ℝ) = D.Y.ord (functionFieldMap D.f cω) D.E.genericPoint + N := by
    have : ((j : ℤ) : ℝ) = D.Y.ord (functionFieldMap D.f cω) D.E.genericPoint + N := by
      rw [← hωD]
      exact_mod_cast (by simpa using hN 1 ω hω)
    exact_mod_cast this
  rw [sum_ord_functionFieldMap_mul_neg_coeff D f hfS0] at key
  rw [Fin.sum_univ_one, hcoeff, h1, h2]
  linear_combination key

/-- **Log discrepancy of a weighted monomial valuation.** Let `(Y, Θ)` be a pair, `v = v_{x,t;j}`
the monomial valuation of weights `(j, 1)` at the regular codimension-two point `η_V`, and for
each prime divisor `S` in the support of `Θ` let `f S` generate the stalk at `η_V` of the ideal
sheaf of `S`. Then `a(v; Y, Θ) = 1 + j - ∑_S Θ(S) v(f S)`. -/
@[mmp "lem_oai4_c2_monomial_valuation_discrepancy"]
public theorem IsWeightedMonomialValuation.hasLogDiscrepancy
    {k : Type u} [Field k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)}
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {Θ : MMP.Mori.QDivisor Y}
    {V : IrreducibleCloseds Y} {x t : Y.presheaf.stalk V.isIrreducible.genericPoint} {j : ℕ}
    {v : Valuation Y.functionField ℤᵐ⁰}
    (hv : IsWeightedMonomialValuation sY V x t j v) (hΘ : IsPair sY Θ)
    (f : MMP.Mori.PrimeDivisor Y → Y.presheaf.stalk V.isIrreducible.genericPoint)
    (hf : ∀ S ∈ Θ.support, IdealSheafData.stalk S.idealSheaf V.isIrreducible.genericPoint =
      Ideal.span {f S}) :
    HasLogDiscrepancy sY Θ v
      (1 + j - ∑ S ∈ Θ.support,
        (Θ.coeff S : ℝ) * (-WithZero.log (v (algebraMap _ Y.functionField (f S))) : ℤ)) := by
  obtain ⟨-, D, hDp, hDv, hDc⟩ :=
    hv.isNormalizedDivisorialValuation_and_isCentre
  obtain ⟨n, ω, hω, hn, hω0, hωD⟩ := exists_topForm_ordPullback_eq hv hΘ D hDv hDc
  exact ⟨n, D, hDv.symm, hasLogDiscrepancy_of_ordPullback_eq hΘ f hf D hDp hDv hDc ω hω hn
    hω0 hωD⟩

end MMP.Fourfold

end
