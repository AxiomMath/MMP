/-- The coefficient of `∑ᵢ yᵢ pᵢ` along `P`. -/
theorem _root_.MMP.Fourfold.coeff_sum_single {ι : Type*} [Fintype ι] {R : Type*} [AddCommMonoid R]
    (p : ι → MMP.Mori.PrimeDivisor X) (y : ι → R) (P : MMP.Mori.PrimeDivisor X) :
    (∑ i, Finsupp.single (p i) (y i) : DivisorWithCoeffs R X).coeff P =
      ∑ i, if p i = P then y i else 0 := by
  simp [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.single_apply]

/-- Casting the coefficients of `∑ᵢ vᵢ pᵢ` from `ℚ` to `ℝ`. -/
theorem _root_.MMP.Fourfold.toRDivisor_sum_single {Y : Scheme.{u}} {ι : Type*} [Fintype ι]
    (p : ι → MMP.Mori.PrimeDivisor Y) (v : ι → ℚ) :
    QDivisor.toRDivisor (∑ i, Finsupp.single (p i) (v i)) =
      ∑ i, Finsupp.single (p i) (v i : ℝ) := by
  classical
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => DivisorWithCoeffs.ext' fun P => ?_
  rw [QDivisor.coeff_toRDivisor, DivisorWithCoeffs.coeff_apply, DivisorWithCoeffs.coeff_apply,
    Finsupp.single_apply, Finsupp.single_apply]
  split_ifs <;> simp

/-- **Adding Cartier divisors to the boundary.** For Cartier divisors `Cᵢ` and a divisor `D` over
`X`, there are numbers `μᵢ` (the orders along `D` of the pull-backs of the `Cᵢ`) such that a log
discrepancy `a` of `D` for `(X, B)` gives the log discrepancy `a - ∑ sᵢ μᵢ` for
`(X, B + ∑ sᵢ Cᵢ)`, for all real `sᵢ`. -/
theorem _root_.MMP.Fourfold.exists_isLogDiscrepancy_add_sum {ι : Type*} [Fintype ι]
    (C : ι → Divisor X) (hC : ∀ i, (C i).IsCartier) (D : DivisorOver k sX) :
    ∃ μ : ι → ℝ, ∀ (n : ℕ) (B B' : RDivisor X) (s : ι → ℝ) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n B D a →
      (∀ Γ, B'.coeff Γ = B.coeff Γ + ∑ i, s i * ((C i).coeff Γ : ℝ)) →
      MMP.Intersection.IsLogDiscrepancy sX n B' D (a - ∑ i, s i * μ i) := by
  classical
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isIntegral
  have := D.isBirationalMorphism.isDominant
  have : CompactSpace D.Y := (D.isNormalVariety.1.toQuasiCompact).compactSpace_of_compactSpace
  have hB := fun i => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp D.f (C i)
  choose C' hC' using fun i => (hC i).exists_isPullback (hB i)
  refine ⟨fun i => ((C' i).coeff D.E : ℝ), fun n B B' s a h hB' => ?_⟩
  obtain ⟨hnv, hprop, ω, hω0, hK, m, r, C₀, C₀', hC₀, hrel, hpb, ha⟩ := h
  let e := Fintype.equivFin ι
  refine ⟨hnv, hprop, ω, hω0, hK, m + Fintype.card ι, Fin.append r (s ∘ e.symm),
    Fin.append C₀ (C ∘ e.symm), Fin.append C₀' (C' ∘ e.symm), ?_, ?_, ?_, ?_⟩
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hC₀ j
    · simpa using hC (e.symm j)
  · intro Γ
    rw [Fin.sum_univ_add, hB', ← add_assoc, hrel Γ]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    congr 1
    exact (e.symm.sum_comp (fun i => s i * ((C i).coeff Γ : ℝ))).symm
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · simpa using hpb j
    · rw [Fin.append_right, Fin.append_right]
      exact ⟨hB _, hC' _⟩
  · rw [ha, Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Function.comp_apply]
    rw [e.symm.sum_comp (fun i => s i * ((C' i).coeff D.E : ℝ))]
    ring

/-- Two affine functions on `ℝ^ι` that agree on `ℚ^ι` agree. -/
private theorem sub_sum_eq_of_forall_rat {ι : Type*} [Fintype ι] {c c' : ℝ} {w w' : ι → ℝ}
    (h : ∀ q : ι → ℚ, c - ∑ i, (q i : ℝ) * w i = c' - ∑ i, (q i : ℝ) * w' i) (y : ι → ℝ) :
    c - ∑ i, y i * w i = c' - ∑ i, y i * w' i := by
  classical
  have h0 : c = c' := by simpa using h 0
  have hw : ∀ j, w j = w' j := fun j => by
    have := h (Pi.single j 1)
    simp only [Pi.single_apply, apply_ite (fun q : ℚ => (q : ℝ)), Rat.cast_one, Rat.cast_zero,
      ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true, h0] at this
    linarith
  simp [h0, hw]

/-- Every neighbourhood `U` of `x ∈ ℝ^ι` contains a set `V` of rational vectors whose convex hull
is a neighbourhood of `x`. -/
theorem _root_.MMP.Fourfold.exists_rat_convexHull_mem_nhds {ι : Type*} [Fintype ι] {x : ι → ℝ}
    {U : Set (ι → ℝ)} (hU : U ∈ 𝓝 x) :
    ∃ V : Set (ι → ℝ), (∀ v ∈ V, v ∈ U ∧ ∃ q : ι → ℚ, v = fun i => (q i : ℝ)) ∧
      convexHull ℝ V ∈ 𝓝 x := by
  classical
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hU
  choose a ha using fun i => exists_rat_btwn (show x i - ε < x i by linarith)
  choose b hb using fun i => exists_rat_btwn (show x i < x i + ε by linarith)
  refine ⟨Set.univ.pi fun i => {(a i : ℝ), (b i : ℝ)}, fun v hv => ⟨hball ?_, ?_⟩, ?_⟩
  · rw [ball_pi _ hε]
    intro i _
    show v i ∈ Metric.ball (x i) ε
    rw [Metric.mem_ball, Real.dist_eq, abs_lt]
    rcases hv i trivial with h | h
    · rw [h]; constructor <;> linarith [ha i, hb i]
    · rw [Set.mem_singleton_iff.mp h]; constructor <;> linarith [ha i, hb i]
  · refine ⟨fun i => if v i = (a i : ℝ) then a i else b i, funext fun i => ?_⟩
    rcases hv i trivial with h | h
    · simp [h]
    · rw [Set.mem_singleton_iff.mp h]
      dsimp only
      split_ifs with h'
      · rw [← h', Set.mem_singleton_iff.mp h]
      · rfl
  · rw [convexHull_pi]
    refine set_pi_mem_nhds Set.finite_univ fun i _ => ?_
    rw [convexHull_pair, segment_eq_Icc (by linarith [ha i, hb i])]
    exact Icc_mem_nhds (ha i).2 (hb i).1

/-- **Klt regions along Cartier directions are convex.** For a boundary `B₀` and Cartier divisors
`Cᵢ`, the vectors `y` for which every log discrepancy of `(X, B₀ + ∑ yᵢ Cᵢ)` along the divisors
with property `Q` exceeds `c` form a convex set. -/
theorem _root_.MMP.Fourfold.convex_setOf_lt_isLogDiscrepancy_add {ι : Type*} [Fintype ι]
    (B₀ : RDivisor X) (C : ι → Divisor X) (hC : ∀ i, (C i).IsCartier) (c : ℝ)
    (Q : DivisorOver k sX → Prop) :
    Convex ℝ {y : ι → ℝ | ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
      MMP.Intersection.IsLogDiscrepancy sX n (B₀ + ∑ i, y i • Divisor.toRDivisor (C i)) D a →
        c < a} := by
  classical
  intro y₁ hy₁ y₂ hy₂ α β hα hβ hαβ n D a hQ ha
  set y := α • y₁ + β • y₂ with hy
  obtain ⟨μ, hμ⟩ := exists_isLogDiscrepancy_add_sum C hC D
  have key : ∀ v : ι → ℝ, MMP.Intersection.IsLogDiscrepancy sX n
      (B₀ + ∑ i, v i • Divisor.toRDivisor (C i)) D (a - ∑ i, (v i - y i) * μ i) := fun v =>
    hμ n _ _ _ a ha fun Γ => by
      simp only [DivisorWithCoeffs.coeff_apply, Finsupp.add_apply, Finsupp.finset_sum_apply,
        Finsupp.smul_apply, smul_eq_mul, add_assoc, ← Finset.sum_add_distrib]
      congr 1
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor,
        DivisorWithCoeffs.coeff_apply]
      ring
  have h1 := hy₁ n D _ hQ (key y₁)
  have h2 := hy₂ n D _ hQ (key y₂)
  have hT : α * ∑ i, (y₁ i - y i) * μ i + β * ∑ i, (y₂ i - y i) * μ i = 0 := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun i _ => ?_
    have : y i = α * y₁ i + β * y₂ i := by simp [hy]
    rw [this]
    linear_combination (-μ i * (α * y₁ i + β * y₂ i)) * hαβ
  rcases hα.eq_or_lt with h | h
  · subst h
    obtain rfl : β = 1 := by linarith
    linarith
  · nlinarith [mul_lt_mul_of_pos_left h1 h, mul_le_mul_of_nonneg_left h2.le hβ]

/-- **The klt region on a fixed support is convex.** On a fixed family `pᵢ` of prime divisors
with Cartier multiples `mᵢ pᵢ`, the coefficient vectors `y` for which every log discrepancy of
`(X, ∑ yᵢ pᵢ)` along the divisors with property `Q` exceeds `c` form a convex set. -/
theorem _root_.MMP.Fourfold.convex_setOf_lt_isLogDiscrepancy {ι : Type*} [Fintype ι]
    (p : ι → MMP.Mori.PrimeDivisor X) (m : ι → ℕ) (hm : ∀ i, 0 < m i)
    (hC : ∀ i, Divisor.IsCartier ((m i : ℤ) • Finsupp.single (p i) (1 : ℤ) : Divisor X)) (c : ℝ)
    (Q : DivisorOver k sX → Prop) :
    Convex ℝ {y : ι → ℝ | ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
      MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D a → c < a} := by
  classical
  let L : (ι → ℝ) →ₗ[ℝ] ι → ℝ := LinearMap.pi fun i => (m i : ℝ)⁻¹ • LinearMap.proj i
  have hL : ∀ y : ι → ℝ, (∑ i, Finsupp.single (p i) (y i) : RDivisor X) =
      0 + ∑ i, L y i • Divisor.toRDivisor
        ((m i : ℤ) • Finsupp.single (p i) (1 : ℤ) : Divisor X) := fun y => by
    refine DivisorWithCoeffs.ext' fun P => ?_
    rw [coeff_sum_single, zero_add]
    simp only [DivisorWithCoeffs.coeff_apply, Finsupp.finset_sum_apply, Finsupp.smul_apply,
      smul_eq_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hm0 : (m i : ℝ) ≠ 0 := by exact_mod_cast (hm i).ne'
    rw [← DivisorWithCoeffs.coeff_apply, Divisor.coeff_toRDivisor]
    simp only [L, DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, Finsupp.single_apply,
      smul_eq_mul, LinearMap.pi_apply, LinearMap.smul_apply, LinearMap.proj_apply]
    split_ifs <;> field_simp <;> push_cast <;> ring
  have e : {y : ι → ℝ | ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
      MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D a → c < a} =
      L ⁻¹' {y | ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
        MMP.Intersection.IsLogDiscrepancy sX n (0 + ∑ i, y i • Divisor.toRDivisor
          ((m i : ℤ) • Finsupp.single (p i) (1 : ℤ) : Divisor X)) D a → c < a} := by
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_preimage, ← hL]
  exact e ▸ (convex_setOf_lt_isLogDiscrepancy_add 0 _ hC c Q).linear_preimage L

/-- On a `ℚ`-factorial variety, `K + ∑ yᵢ pᵢ` is `ℝ`-Cartier. -/
theorem _root_.MMP.Fourfold.isRCartier_add_sum_single (hQ : IsQFactorial sX) (K : Divisor X)
    {ι : Type*} [Fintype ι] (p : ι → MMP.Mori.PrimeDivisor X) (y : ι → ℝ) :
    RDivisor.IsRCartier (Finsupp.mapRange (Int.cast : ℤ → ℝ) Int.cast_zero K +
      ∑ i, Finsupp.single (p i) (y i)) := by
  classical
  obtain ⟨mK, hmK, hKc⟩ := hQ.2 K
  choose m hm hmc using fun i => hQ.2 (Finsupp.single (p i) (1 : ℤ))
  let e := Fintype.equivFin ι
  refine ⟨1 + Fintype.card ι, Fin.append ![1 / (mK : ℝ)] (fun j => y (e.symm j) / m (e.symm j)),
    Fin.append ![(mK : ℤ) • K]
      (fun j => ((m (e.symm j) : ℤ) • Finsupp.single (p (e.symm j)) (1 : ℤ) : Divisor X)),
    ?_, ?_⟩
  · intro j
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j
    · rw [Fin.fin_one_eq_zero j]
      simpa using hKc
    · simpa using hmc (e.symm j)
  · intro Γ
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, Fin.sum_univ_one, Matrix.cons_val_zero]
    rw [e.symm.sum_comp (fun i => y i / m i *
      (DivisorWithCoeffs.coeff (R := ℤ) ((m i : ℤ) • Finsupp.single (p i) (1 : ℤ)) Γ : ℝ))]
    rw [DivisorWithCoeffs.coeff_add, coeff_sum_single]
    have hmK0 : (mK : ℝ) ≠ 0 := by exact_mod_cast hmK.ne'
    congr 1
    · simp only [DivisorWithCoeffs.coeff_apply, Finsupp.mapRange_apply, Finsupp.smul_apply,
        smul_eq_mul]
      push_cast
      field_simp
    · refine Finset.sum_congr rfl fun i _ => ?_
      have hm0 : (m i : ℝ) ≠ 0 := by exact_mod_cast (hm i).ne'
      simp only [DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, Finsupp.single_apply,
        smul_eq_mul]
      split_ifs <;> field_simp <;> push_cast <;> ring

end Analysis

section Exceptional

open TopologicalSpace

/-- A divisor over a normal variety is exceptional if and only if its center has codimension at
least two. -/
private theorem isExceptional_iff_two_le_coheight {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}
    (hX : IsNormalVariety k sX) (D : DivisorOver k sX) :
    D.IsExceptional ↔ 2 ≤ Order.coheight (D.f D.E.genericPoint) := by
  have := D.isLocallyNoetherian
  have := D.isNormal
  have : IsSeparated sX := hX.1.toIsSeparated
  have : IsSeparated (X ↘ ⊤_ Scheme) := by
    rw [show (X ↘ ⊤_ Scheme) = sX ≫ (Spec (.of k) ↘ ⊤_ Scheme) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  unfold DivisorOver.IsExceptional
  rw [MMP.Positivity.isExceptional_toRationalMap_iff]
  have hcl : Closeds.closure (D.f '' (D.E.idealSheaf.support : Set D.Y)) =
      ⟨(D.center : Set X), D.center.isClosed⟩ := Closeds.ext rfl
  rw [hcl, closedsCodimension_coe, MMP.Positivity.DivisorOver.codimension_center]

/-- A variety of dimension `n` with an exceptional divisor over it has `n ≥ 2`. -/
private theorem two_le_of_isExceptional {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}
    (hX : IsNormalVariety k sX) {n : ℕ} (hn : topologicalKrullDim X = n)
    {D : DivisorOver k sX} (hD : D.IsExceptional) : 2 ≤ n := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have h := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX
    (D.f D.E.genericPoint)
  rw [hn] at h
  have h0 : 0 ≤ topologicalKrullDim (closure {D.f D.E.genericPoint} : Set X) :=
    Order.krullDim_nonneg_iff.mpr ⟨⟨closure {⟨_, subset_closure rfl⟩},
      isIrreducible_singleton.closure, isClosed_closure⟩⟩
  have : ((Order.coheight (D.f D.E.genericPoint) : ℕ∞) : WithBot ℕ∞) ≤ n :=
    h ▸ le_add_of_nonneg_left h0
  exact_mod_cast ((isExceptional_iff_two_le_coheight hX D).mp hD).trans
    (WithBot.coe_le_coe.mp this)

end Exceptional

section Resolution

/-- The components of an snc subset form a finite set of prime divisors with snc reduced sum. -/
private theorem exists_finset_isSNC {k : Type u} [Field k] {Y : Scheme.{u}}
    [IsLocallyNoetherian Y] {sY : Y ⟶ Spec (.of k)} [LocallyOfFinitePresentation sY]
    (hsm : IsSmoothScheme sY) {T : TopologicalSpace.Closeds Y} (hT : IsSNCSubset sY T) :
    ∃ S : Finset (MMP.Mori.PrimeDivisor Y),
      DivisorWithCoeffs.IsSNC sY (∑ E ∈ S, Finsupp.single E (1 : ℤ)) ∧
      ∀ F : MMP.Mori.PrimeDivisor Y, F.genericPoint ∈ (T : Set Y) → F ∈ S := by
  rcases hT with h0 | ⟨s, hs, hsnc⟩
  · refine ⟨∅, ?_, fun F hF => ?_⟩
    · rw [Finset.sum_empty]
      exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme _ hsm
    · rw [h0] at hF
      exact absurd hF (by simp)
  · refine ⟨s, hsnc, fun F hF => ?_⟩
    rw [← hs] at hF
    obtain ⟨E, hE, hgen⟩ := Set.mem_iUnion₂.mp hF
    rwa [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hgen] at hE

/-- A prime divisor of a proper birational model that is not exceptional maps generically onto a
prime divisor `P` of `X`, and its coefficient in the crepant boundary is `coeff_P Δ`. -/
private theorem exists_coeff_eq_of_not_isExceptional {k : Type u} [Field k] [PerfectField k]
    {X Y : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of k)} {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (hP : IsPairWith sX n K Δ) {f : Y ⟶ X} (hY : IsNormalVariety k (f ≫ sX))
    (hf : IsBirationalMorphism f) {ΔY : QDivisor Y}
    (hΔY : IsCrepantBoundary sX n K Δ f hY hf ΔY) {G : MMP.Mori.PrimeDivisor Y}
    (hG : ¬ (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX).IsExceptional) :
    ∃ P : MMP.Mori.PrimeDivisor X, ΔY.coeff G = Δ.coeff P ∧
      f G.genericPoint = P.genericPoint := by
  obtain ⟨P, hc, hd⟩ := DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hP _ hG
  have hη : f G.genericPoint = P.genericPoint := by
    refine (inseparable_iff_closure_eq.2 ?_).eq
    rw [← DivisorOver.center_eq_closure_genericPoint (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX), hc,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact ⟨P, neg_injective ((hΔY G).eq hd), hη⟩

/-- A function positive on the members of a finite set satisfying `p` has a uniform positive
lower bound there. -/
private theorem exists_pos_forall_le {α : Type*} (s : Finset α) (p : α → Prop) (g : α → ℚ)
    (h : ∀ x ∈ s, p x → 0 < g x) : ∃ ε : ℚ, 0 < ε ∧ ∀ x ∈ s, p x → ε ≤ g x := by
  classical
  refine ⟨(insert 1 ((s.filter p).image g)).min' (Finset.insert_nonempty _ _), ?_,
    fun x hx hpx => Finset.min'_le _ _ (by simpa using Or.inr ⟨x, ⟨hx, hpx⟩, rfl⟩)⟩
  simpa [Finset.lt_min'_iff] using fun _ x hx hpx hgx => hgx ▸ h x hx hpx

/-- **Exceptional over `Y` is exceptional over `X`** (Kollár–Mori, proof of 2.32): for `f`
proper birational, a divisor exceptional over `Y` is exceptional over `X` through `f`. -/
private theorem isExceptional_compDivisorOver {k : Type u} [Field k] {X : Scheme.{u}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {Y : Scheme.{u}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {f : Y ⟶ X}
    [IsProper f] (hX : IsNormalVariety k sX) (hY : IsNormalVariety k (f ≫ sX))
    (hf : IsBirationalMorphism f) (E : DivisorOver k (f ≫ sX)) (hE : E.IsExceptional) :
    (compDivisorOver f hY hf E).IsExceptional := by
  rw [isExceptional_iff_two_le_coheight hY] at hE
  rw [isExceptional_iff_two_le_coheight hX]
  change 2 ≤ Order.coheight (f (E.f E.E.genericPoint))
  by_cases hx : f (E.f E.E.genericPoint) ∈ MMP.Mori.biregularLocus f
  · rwa [MMP.Positivity.coheight_map_of_mem_biregularLocus f hx]
  · exact MMP.Flips.le_closedsCodimension_iff_le_coheight.mp
      (MMP.Mori.two_le_closedsCodimension_compl_biregularLocus (hY := hX.1) (hX := hY.1) sX f
        hf) _ hx

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
  [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- **The data of a log resolution of `∑ pᵢ`.** There are finitely many affine functions
`ℓ_s(y) = c_s - ∑ᵢ yᵢ w_{s,i}` (the log discrepancies of the components `s` of the snc divisor of
a log resolution, some of them exceptional, with a meeting relation), such that each `ℓ_s(y)` is a
log discrepancy of `(X, ∑ yᵢ pᵢ)`, each sum `ℓ_s + ℓ_t` over a meeting pair is the log
discrepancy of an exceptional divisor, `ℓ_s(y) = 1 - coeff_P(∑ yᵢ pᵢ)` for a non-exceptional `s`
with image `P`, and for rational `y` the klt, terminal and plt conditions follow from
inequalities on these functions: klt from `ℓ_s > 0` and coefficients `< 1`; terminal from
`ℓ_s > 0`, `ℓ_s > 1` for exceptional `s` and `ℓ_s + ℓ_t > 1` for meeting pairs; and positivity
of the log discrepancies of exceptional divisors (plt) from `ℓ_s ≥ 0`, `ℓ_s > 0` for exceptional
`s` and `ℓ_s + ℓ_t > 0` for meeting pairs. -/
theorem _root_.MMP.Fourfold.exists_resolution_data [IsAlgClosed k] [CharZero k]
    (hQ : IsQFactorial sX) {ι : Type*} [Fintype ι] (p : ι → MMP.Mori.PrimeDivisor X) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) :
    ∃ (σ : Type u) (S : Finset σ) (c : σ → ℝ) (w : σ → ι → ℝ) (exc : σ → Prop)
      (meet : σ → σ → Prop),
      (∀ s ∈ S, ∀ y : ι → ℝ, ∃ D : DivisorOver k sX, (exc s → D.IsExceptional) ∧
        MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D
          (c s - ∑ i, y i * w s i)) ∧
      (∀ s ∈ S, ∀ t ∈ S, meet s t → ∃ D : DivisorOver k sX, D.IsExceptional ∧ ∀ y : ι → ℝ,
        MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D
          ((c s - ∑ i, y i * w s i) + (c t - ∑ i, y i * w t i))) ∧
      (∀ s ∈ S, ¬ exc s → ∃ P : MMP.Mori.PrimeDivisor X, ∀ y : ι → ℝ,
        c s - ∑ i, y i * w s i = 1 - (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff P) ∧
      (∀ q : ι → ℚ, (∀ s ∈ S, 0 < c s - ∑ i, (q i : ℝ) * w s i) →
        (∀ j, (∑ i, Finsupp.single (p i) ((q i : ℝ)) : RDivisor X).coeff (p j) < 1) →
        ∀ (n' : ℕ) (D : DivisorOver k sX) (a : ℝ),
          MMP.Intersection.IsLogDiscrepancy sX n' (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
            0 < a) ∧
      (∀ q : ι → ℚ, (∀ s ∈ S, 0 < c s - ∑ i, (q i : ℝ) * w s i) →
        (∀ s ∈ S, exc s → 1 < c s - ∑ i, (q i : ℝ) * w s i) →
        (∀ s ∈ S, ∀ t ∈ S, meet s t →
          1 < (c s - ∑ i, (q i : ℝ) * w s i) + (c t - ∑ i, (q i : ℝ) * w t i)) →
        ∀ (n' : ℕ) (D : DivisorOver k sX) (a : ℝ), D.IsExceptional →
          MMP.Intersection.IsLogDiscrepancy sX n' (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
            1 < a) ∧
      (∀ q : ι → ℚ, (∀ s ∈ S, 0 ≤ c s - ∑ i, (q i : ℝ) * w s i) →
        (∀ s ∈ S, exc s → 0 < c s - ∑ i, (q i : ℝ) * w s i) →
        (∀ s ∈ S, ∀ t ∈ S, meet s t →
          0 < (c s - ∑ i, (q i : ℝ) * w s i) + (c t - ∑ i, (q i : ℝ) * w t i)) →
        ∀ (n' : ℕ) (D : DivisorOver k sX) (a : ℝ), D.IsExceptional →
          MMP.Intersection.IsLogDiscrepancy sX n' (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
            0 < a) := by
  classical
  have hX : IsNormalVariety k sX := hQ.1
  have : MMP.Mori.IsVariety k sX := hX.1
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : QuasiCompact sX := hX.1.toQuasiCompact
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hn : topologicalKrullDim X = n := hK.topologicalKrullDim_eq
  -- Cartier multiples of the `pᵢ`
  choose m hm hmC using fun i => hQ.2 (Finsupp.single (p i) (1 : ℤ))
  set C : ι → Divisor X := fun i => (m i : ℤ) • Finsupp.single (p i) (1 : ℤ) with hCdef
  have hCcoeff : ∀ i Γ, ((C i).coeff Γ : ℝ) = (m i : ℝ) * if p i = Γ then 1 else 0 := by
    intro i Γ
    simp only [hCdef, DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply, Finsupp.single_apply,
      smul_eq_mul]
    split_ifs <;> simp
  have hcoeffrel : ∀ (q : ι → ℚ) (y : ι → ℝ) Γ,
      (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff Γ =
        (∑ i, Finsupp.single (p i) ((q i : ℝ)) : RDivisor X).coeff Γ +
          ∑ i, ((y i - q i) / m i) * ((C i).coeff Γ : ℝ) := by
    intro q y Γ
    rw [coeff_sum_single, coeff_sum_single, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hCcoeff]
    have hm0 : (m i : ℝ) ≠ 0 := by exact_mod_cast (hm i).ne'
    split_ifs <;> field_simp <;> ring
  -- the rational boundaries `B_q`
  set BQ : (ι → ℚ) → QDivisor X := fun q => ∑ i, Finsupp.single (p i) (q i)
  have hBQc : ∀ q P, (BQ q).coeff P = ∑ i, if p i = P then q i else 0 :=
    fun q P => coeff_sum_single p q P
  have hBQ : ∀ q : ι → ℚ,
      QDivisor.toRDivisor (BQ q) = ∑ i, Finsupp.single (p i) ((q i : ℝ)) :=
    toRDivisor_sum_single p
  have hpair : ∀ q, IsPairWith sX n K (BQ q) := fun q =>
    ⟨hX, hK, isQCartier_of_isQFactorial sX hQ _⟩
  -- a log resolution of `∑ pᵢ`
  obtain ⟨Y, f, hf⟩ := exists_isLogResolution sX hX (∑ i, Finsupp.single (p i) (1 : ℝ))
  obtain ⟨hY, hdimY, -⟩ := hf.toIsSmoothResolution.isNormalVariety hX
  have : IsIntegral Y := hY.1.toIsIntegral
  have : LocallyOfFiniteType (f ≫ sX) := hY.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (f ≫ sX)
  have : IsNormal Y := hY.2
  have : IsProper f := hf.isProper
  have : MMP.Mori.IsVariety k (f ≫ sX) := hY.1
  have : IsDominant f := hf.isBirationalMorphism.isDominant
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (f ≫ sX)
  set hfb := hf.isBirationalMorphism
  let DG : MMP.Mori.PrimeDivisor Y → DivisorOver k sX := fun G => ⟨Y, f, hY, hfb, G⟩
  have hnY : topologicalKrullDim Y = n := hdimY.trans hn
  obtain ⟨KY, hKY⟩ := exists_isCanonicalDivisor_of_isSmoothScheme (f ≫ sX) hf.isSmoothScheme hnY
  obtain ⟨S, hsncS, hmemS⟩ := exists_finset_isSNC hf.isSmoothScheme hf.isSNCSubset
  have hexcS : ∀ G, (DG G).IsExceptional → G ∈ S := fun G hG =>
    hmemS G (Or.inl (MMP.Positivity.support_subset_exceptionalSet G hG
      (MMP.Flips.primeDivisor_genericPoint_mem_support G)))
  -- the crepant boundaries `Θ_q` of `(X, B_q)` on `Y`
  have hex : ∀ q, ∃ Θ : QDivisor Y, IsCrepantBoundary sX n K (BQ q) f hY hfb Θ := fun q => by
    obtain ⟨⟨Θ, hΘ, -⟩, -⟩ :=
      MMP.Mori.IsPair.existsUnique_isCrepantBoundary (hpair q).isPair hK f hY hfb
    exact ⟨Θ, hΘ⟩
  choose Θ hΘ using hex
  have hlogG : ∀ q G, MMP.Intersection.IsLogDiscrepancy sX n
      (∑ i, Finsupp.single (p i) ((q i : ℝ))) (DG G) (1 - ((Θ q).coeff G : ℝ)) := fun q G => by
    have := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy (hΘ q G)
      (inferInstance : IsProper f)
    rw [hBQ q] at this
    convert this using 1
    push_cast
    ring
  -- log discrepancies are affine in the coefficients
  have hlin : ∀ D : DivisorOver k sX, ∃ w : ι → ℝ, ∀ a₀ : ℝ,
      MMP.Intersection.IsLogDiscrepancy sX n
        (∑ i, Finsupp.single (p i) ((((0 : ι → ℚ) i : ℚ)) : ℝ)) D a₀ →
      ∀ y : ι → ℝ, MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D
        (a₀ - ∑ i, y i * w i) := by
    intro D
    obtain ⟨μ, hμ⟩ := exists_isLogDiscrepancy_add_sum C hmC D
    refine ⟨fun i => μ i / m i, fun a₀ h₀ y => ?_⟩
    have := hμ n _ _ (fun i => (y i - (((0 : ι → ℚ) i : ℚ) : ℝ)) / m i) a₀ h₀ (hcoeffrel 0 y)
    convert this using 2
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.zero_apply, Rat.cast_zero, sub_zero]
    ring
  choose wG hwG using fun G => hlin (DG G)
  set cG : MMP.Mori.PrimeDivisor Y → ℝ := fun G => 1 - ((Θ 0).coeff G : ℝ)
  have ha : ∀ G (y : ι → ℝ), MMP.Intersection.IsLogDiscrepancy sX n
      (∑ i, Finsupp.single (p i) (y i)) (DG G) (cG G - ∑ i, y i * wG G i) :=
    fun G y => hwG G _ (hlogG 0 G) y
  have hkey : ∀ q G, ((Θ q).coeff G : ℝ) = 1 - (cG G - ∑ i, (q i : ℝ) * wG G i) := fun q G => by
    have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hlogG q G) (ha G _)
    linarith
  have hsupp : ∀ q, (Θ q).support ⊆ S := by
    intro q G hG
    rw [Finsupp.mem_support_iff] at hG
    by_cases hGe : (DG G).IsExceptional
    · exact hexcS G hGe
    obtain ⟨P, hθP, hη⟩ := exists_coeff_eq_of_not_isExceptional (hpair q) hY hfb (hΘ q) hGe
    have hP0 : (BQ q).coeff P ≠ 0 := hθP ▸ hG
    obtain ⟨i, hi⟩ : ∃ i, p i = P := by
      by_contra h
      push Not at h
      exact hP0 ((hBQc q P).trans (Finset.sum_eq_zero fun i _ => if_neg (h i)))
    refine hmemS G (Or.inr ?_)
    change f G.genericPoint ∈ (∑ i, Finsupp.single (p i) (1 : ℝ) : RDivisor X).supp
    rw [hη]
    refine DivisorWithCoeffs.support_subset_supp ?_
      (MMP.Flips.primeDivisor_genericPoint_mem_support P)
    rw [coeff_sum_single]
    exact (Finset.sum_pos' (fun j _ => by split_ifs <;> norm_num)
      ⟨i, Finset.mem_univ _, by simp [hi]⟩).ne'
  -- the discrepancy of `(X, B_q)`, bounded below on the resolution
  have hdisc : ∀ (q : ι → ℚ) (b : ℚ), (∀ G ∈ S, (Θ q).coeff G ≤ 1) →
      (∀ G ∈ S, b ≤ 1 - (Θ q).coeff G) →
      (∀ E ∈ S, ∀ F ∈ S, E ≠ F → (E.support ∩ F.support).Nonempty →
        b ≤ 1 - (Θ q).coeff E - (Θ q).coeff F) → b ≤ 1 →
      (∀ G, (DG G).IsExceptional → b ≤ -(Θ q).coeff G) → 2 ≤ n →
      (((b : ℚ) : ℝ) : EReal) ≤ discrep sX n K (BQ q) := by
    intro q b h0 h1 h2 h3 h4 hn2
    rw [IsCrepantBoundary.discrep_eq_min (hpair q).isPair hK hKY (hΘ q),
      discrep_eq_of_isSNC (f ≫ sX) hY hf.isSmoothScheme hn2 hKY S (hsupp q) hsncS h0]
    refine le_min (le_inf (le_inf ?_ ?_) ?_) ?_
    · exact le_iInf₂ fun E hE => le_iInf₂ fun F hF => le_iInf₂ fun hEF hm =>
        EReal.coe_le_coe_iff.mpr (by exact_mod_cast h2 E hE F hF hEF hm)
    · exact le_iInf₂ fun G hG => EReal.coe_le_coe_iff.mpr (by exact_mod_cast h1 G hG)
    · exact_mod_cast EReal.coe_le_coe_iff.mpr (by exact_mod_cast h3 : ((b : ℚ) : ℝ) ≤ 1)
    · refine le_sInf ?_
      rintro _ ⟨G, a, hGe, hGa, rfl⟩
      have := (hΘ q G).eq hGa
      refine EReal.coe_le_coe_iff.mpr ?_
      rw [← this]
      exact_mod_cast h4 G hGe
  -- the discrepancy of a divisor over `X` is `a - 1` for a log discrepancy `a`
  have hstart : ∀ (q : ι → ℚ) (n' : ℕ) (D : DivisorOver k sX) (a : ℝ),
      MMP.Intersection.IsLogDiscrepancy sX n' (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
      ∃ c : ℚ, IsDiscrepancy sX n K (BQ q) D c ∧ a = 1 + c := by
    intro q n' D a hDa
    have hn' : n' = n := by
      exact_mod_cast
        (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq hDa).symm.trans hn
    subst hn'
    rw [← hBQ q] at hDa
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK D
    exact ⟨c, hc, ((MMP.Threefold.Bridges.isLogDiscrepancy_iff_of_isDiscrepancy hc a).mp hDa).2⟩
  have hθ1 : ∀ (q : ι → ℚ), (∀ G ∈ S, 0 < cG G - ∑ i, (q i : ℝ) * wG G i) →
      ∀ G ∈ S, (Θ q).coeff G < 1 := fun q hq G hG => by
    exact_mod_cast (by linarith [hkey q G, hq G hG] : ((Θ q).coeff G : ℝ) < 1)
  refine ⟨MMP.Mori.PrimeDivisor Y, S, cG, wG, fun G => (DG G).IsExceptional,
    fun G H => G ≠ H ∧ (G.support ∩ H.support).Nonempty,
    fun G _ y => ⟨DG G, id, ha G y⟩, ?_, ?_, ?_, ?_, ?_⟩
  · -- the blow-ups of the strata `E ∩ F`
    rintro E hE F hF ⟨hEF, hmeet⟩
    obtain ⟨DY, hDYe, hDYv⟩ := exists_isExceptional_isDiscrepancy_eq_one_sub_sub hY
      hf.isSmoothScheme hnY hsncS hE hF hEF hmeet
    set D₁ := compDivisorOver f hY hfb DY
    have hD₁e : D₁.IsExceptional := isExceptional_compDivisorOver hX hY hfb DY hDYe
    obtain ⟨D₂, hv⟩ := MMP.Threefold.Bridges.exists_properDivisorOver_valuation_eq hX D₁
    have hcen := MMP.Threefold.Mori.ModelIndependence.center_eq_of_valuation_eq hX hv
    have hD₂e : D₂.toDivisorOver.IsExceptional := by
      rw [isExceptional_iff_two_le_coheight hX] at hD₁e ⊢
      rwa [hcen]
    have hval : ∀ q : ι → ℚ, MMP.Intersection.IsLogDiscrepancy sX n
        (∑ i, Finsupp.single (p i) ((q i : ℝ))) D₂.toDivisorOver
          (2 - ((Θ q).coeff E : ℝ) - ((Θ q).coeff F : ℝ)) := by
      intro q
      obtain ⟨c₁, hc₁⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK D₁
      obtain ⟨c₂, hc₂⟩ :=
        MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK D₂.toDivisorOver
      have h₁₂ : c₂ = c₁ := MMP.Threefold.Mori.isDiscrepancy_eq_of_valuation_eq (hpair q) hv hc₂ hc₁
      have hY₁ := ((MMP.Mori.IsPair.isDiscrepancy_iff_of_crepant (hpair q).isPair f hY hfb hK hKY
        (Or.inl (hΘ q))).2 DY D₁ (valuation_compDivisorOver f hY hfb DY) c₁).mpr hc₁
      have hc₁v := hDYv KY (Θ q) (hsupp q) c₁ hY₁
      have := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc₂ D₂.isProper
      rw [hBQ q, h₁₂, hc₁v] at this
      convert this using 1
      push_cast
      ring
    obtain ⟨w, hw⟩ := hlin D₂.toDivisorOver
    refine ⟨D₂.toDivisorOver, hD₂e, fun y => ?_⟩
    have heq := sub_sum_eq_of_forall_rat (c := 2 - ((Θ 0).coeff E : ℝ) - ((Θ 0).coeff F : ℝ))
      (w := w) (c' := cG E + cG F) (w' := fun i => wG E i + wG F i) (fun q => ?_) y
    · convert hw _ (hval 0) y using 1
      rw [heq]
      simp only [mul_add, Finset.sum_add_distrib]
      ring
    · have := MMP.Threefold.Bridges.IsLogDiscrepancy.unique (hw _ (hval 0) fun i => (q i : ℝ))
        (hval q)
      rw [this, hkey q E, hkey q F]
      simp only [mul_add, Finset.sum_add_distrib]
      ring
  · -- non-exceptional components
    intro G _ hGe
    obtain ⟨P, -, hη⟩ := exists_coeff_eq_of_not_isExceptional (hpair 0) hY hfb (hΘ 0) hGe
    refine ⟨P, fun y => ?_⟩
    rw [coeff_sum_single]
    have e : ∑ i, (if p i = P then y i else 0) = ∑ i, y i * (if p i = P then 1 else 0) :=
      Finset.sum_congr rfl fun i _ => by split_ifs <;> simp
    rw [e]
    refine sub_sum_eq_of_forall_rat (fun q => ?_) y
    obtain ⟨P', hθ, hη'⟩ := exists_coeff_eq_of_not_isExceptional (hpair q) hY hfb (hΘ q) hGe
    obtain rfl : P' = P :=
      AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hη'.symm.trans hη)
    have h := hkey q G
    rw [hθ, hBQc] at h
    have e' : ∑ i, (q i : ℝ) * (if p i = P' then 1 else 0) =
        (((∑ i, if p i = P' then q i else 0 : ℚ)) : ℝ) := by
      rw [Rat.cast_sum]
      exact Finset.sum_congr rfl fun i _ => by split_ifs <;> simp
    linarith
  · -- klt for rational coefficients
    intro q hq hcoef n' D a hDa
    obtain ⟨c, hc, rfl⟩ := hstart q n' D a hDa
    suffices h : -1 < c by
      have : (-1 : ℝ) < c := by exact_mod_cast h
      linarith
    have hθ := hθ1 q hq
    by_cases hD : D.IsExceptional
    · have hn2 := two_le_of_isExceptional hX hn hD
      obtain ⟨ε, hε, hεle⟩ := exists_pos_forall_le S (fun _ => True)
        (fun G => 1 - (Θ q).coeff G) fun G hG _ => by linarith [hθ G hG]
      have hε' : 0 < min ε 1 := lt_min hε one_pos
      have hm1 : min ε 1 ≤ ε := min_le_left _ _
      have hm2 : min ε 1 ≤ 1 := min_le_right _ _
      have hdl := hdisc q (-1 + min ε 1) (fun G hG => (hθ G hG).le)
        (fun G hG => by linarith [hεle G hG trivial])
        (fun E hE F hF _ _ => by linarith [hεle E hE trivial, hεle F hF trivial])
        (by linarith) (fun G hGe => by linarith [hεle G (hexcS G hGe) trivial]) hn2
      have : -1 + min ε 1 ≤ c := by
        exact_mod_cast EReal.coe_le_coe_iff.mp (hdl.trans (discrep_le hD hc))
      linarith
    · obtain ⟨P, hPv⟩ :=
        MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX D hD
      obtain ⟨c', hc'⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy (hpair q).isPair hK
        (DivisorOver.ofPrimeDivisor k hX P)
      rw [MMP.Threefold.Mori.isDiscrepancy_eq_of_valuation_eq (hpair q) hPv hc hc',
        hc'.eq_neg_coeff_of_ofPrimeDivisor hX]
      have : (BQ q).coeff P < 1 := by
        by_cases hP : ∃ j, p j = P
        · obtain ⟨j, rfl⟩ := hP
          have h := hcoef j
          rw [← hBQ q, QDivisor.coeff_toRDivisor] at h
          exact_mod_cast h
        · rw [hBQc, Finset.sum_eq_zero fun i _ => if_neg fun h => hP ⟨i, h⟩]
          norm_num
      linarith
  · -- terminal for rational coefficients
    intro q hq hq1 hq2 n' D a hD hDa
    obtain ⟨c, hc, rfl⟩ := hstart q n' D a hDa
    suffices h : 0 < c by
      have : (0 : ℝ) < c := by exact_mod_cast h
      linarith
    have hθ := hθ1 q hq
    have hθe : ∀ G ∈ S, (DG G).IsExceptional → (Θ q).coeff G < 0 := fun G hG hGe => by
      exact_mod_cast (by linarith [hkey q G, hq1 G hG hGe] : ((Θ q).coeff G : ℝ) < 0)
    have hθp : ∀ E ∈ S, ∀ F ∈ S, (E ≠ F ∧ (E.support ∩ F.support).Nonempty) →
        (Θ q).coeff E + (Θ q).coeff F < 1 := fun E hE F hF hEF => by
      exact_mod_cast (by linarith [hkey q E, hkey q F, hq2 E hE F hF hEF] :
        ((Θ q).coeff E : ℝ) + ((Θ q).coeff F : ℝ) < 1)
    have hn2 := two_le_of_isExceptional hX hn hD
    obtain ⟨ε₁, hε₁, hle₁⟩ := exists_pos_forall_le S (fun _ => True)
      (fun G => 1 - (Θ q).coeff G) fun G hG _ => by linarith [hθ G hG]
    obtain ⟨ε₂, hε₂, hle₂⟩ := exists_pos_forall_le S (fun G => (DG G).IsExceptional)
      (fun G => -(Θ q).coeff G) fun G hG hGe => by linarith [hθe G hG hGe]
    obtain ⟨ε₃, hε₃, hle₃⟩ := exists_pos_forall_le (S ×ˢ S)
      (fun x => x.1 ≠ x.2 ∧ (x.1.support ∩ x.2.support).Nonempty)
      (fun x => 1 - (Θ q).coeff x.1 - (Θ q).coeff x.2) fun x hx hxp => by
        obtain ⟨hx1, hx2⟩ := Finset.mem_product.mp hx
        linarith [hθp x.1 hx1 x.2 hx2 hxp]
    set ε := min (min ε₁ ε₂) (min ε₃ 1)
    have hε : 0 < ε := lt_min (lt_min hε₁ hε₂) (lt_min hε₃ one_pos)
    have h1 : ε ≤ ε₁ := (min_le_left _ _).trans (min_le_left _ _)
    have h2 : ε ≤ ε₂ := (min_le_left _ _).trans (min_le_right _ _)
    have h3 : ε ≤ ε₃ := (min_le_right _ _).trans (min_le_left _ _)
    have h4 : ε ≤ 1 := (min_le_right _ _).trans (min_le_right _ _)
    have hdl := hdisc q ε (fun G hG => (hθ G hG).le)
      (fun G hG => by linarith [hle₁ G hG trivial])
      (fun E hE F hF hEF hm => by
        linarith [hle₃ (E, F) (Finset.mem_product.mpr ⟨hE, hF⟩) ⟨hEF, hm⟩])
      h4 (fun G hGe => by linarith [hle₂ G (hexcS G hGe) hGe]) hn2
    have : ε ≤ c := by exact_mod_cast EReal.coe_le_coe_iff.mp (hdl.trans (discrep_le hD hc))
    linarith
  · -- plt for rational coefficients
    intro q hq0 hq1 hq2 n' D a hD hDa
    obtain ⟨c, hc, rfl⟩ := hstart q n' D a hDa
    suffices h : -1 < c by
      have : (-1 : ℝ) < c := by exact_mod_cast h
      linarith
    have hθ : ∀ G ∈ S, (Θ q).coeff G ≤ 1 := fun G hG => by
      exact_mod_cast (by linarith [hkey q G, hq0 G hG] : ((Θ q).coeff G : ℝ) ≤ 1)
    have hθe : ∀ G ∈ S, (DG G).IsExceptional → (Θ q).coeff G < 1 := fun G hG hGe => by
      exact_mod_cast (by linarith [hkey q G, hq1 G hG hGe] : ((Θ q).coeff G : ℝ) < 1)
    have hθp : ∀ E ∈ S, ∀ F ∈ S, (E ≠ F ∧ (E.support ∩ F.support).Nonempty) →
        (Θ q).coeff E + (Θ q).coeff F < 2 := fun E hE F hF hEF => by
      exact_mod_cast (by linarith [hkey q E, hkey q F, hq2 E hE F hF hEF] :
        ((Θ q).coeff E : ℝ) + ((Θ q).coeff F : ℝ) < 2)
    have hn2 := two_le_of_isExceptional hX hn hD
    obtain ⟨ε₁, hε₁, hle₁⟩ := exists_pos_forall_le S (fun G => (DG G).IsExceptional)
      (fun G => 1 - (Θ q).coeff G) fun G hG hGe => by linarith [hθe G hG hGe]
    obtain ⟨ε₂, hε₂, hle₂⟩ := exists_pos_forall_le (S ×ˢ S)
      (fun x => x.1 ≠ x.2 ∧ (x.1.support ∩ x.2.support).Nonempty)
      (fun x => 2 - (Θ q).coeff x.1 - (Θ q).coeff x.2) fun x hx hxp => by
        obtain ⟨hx1, hx2⟩ := Finset.mem_product.mp hx
        linarith [hθp x.1 hx1 x.2 hx2 hxp]
    set ε := min ε₁ (min ε₂ 1)
    have hε : 0 < ε := lt_min hε₁ (lt_min hε₂ one_pos)
    have h1 : ε ≤ ε₁ := min_le_left _ _
    have h2 : ε ≤ ε₂ := (min_le_right _ _).trans (min_le_left _ _)
    have h3 : ε ≤ 1 := (min_le_right _ _).trans (min_le_right _ _)
    have hdl := hdisc q (-1 + ε) hθ (fun G hG => by linarith [hθ G hG])
      (fun E hE F hF hEF hm => by
        linarith [hle₂ (E, F) (Finset.mem_product.mpr ⟨hE, hF⟩) ⟨hEF, hm⟩])
      (by linarith) (fun G hGe => by linarith [hle₁ G (hexcS G hGe) hGe]) hn2
    have : -1 + ε ≤ c := by
      exact_mod_cast EReal.coe_le_coe_iff.mp (hdl.trans (discrep_le hD hc))
    linarith

end Resolution

end Proof_lem_fourfold_real_klt_terminal_open

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_fourfold_real_klt_terminal_open

/-- **Klt and terminal real boundaries on a fixed support are relatively open.** Let `X` be a
normal `ℚ`-factorial quasi-projective variety over an algebraically closed field `k` of
characteristic zero and `p : ι → PrimeDivisor X` a finite family of prime divisors. If `x ∈ ℝ^ι`
and `(X, ∑ᵢ xᵢ pᵢ)` is klt (`MMP.Fourfold.IsRealKltPair`), then `(X, ∑ᵢ yᵢ pᵢ)` is klt for every
nonnegative `y` near `x`; likewise for real terminal pairs (`MMP.Fourfold.IsRealTerminalPair`). -/
@[mmp "lem_fourfold_real_klt_terminal_open"]
public theorem eventually_isRealKltPair_and_isRealTerminalPair {k : Type u} [Field k]
    [IsAlgClosed k] [CharZero k] {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (hX : AlgebraicGeometry.IsQuasiProjectiveVariety k sX)
    (hQ : IsQFactorial sX) {ι : Type*} [Fintype ι] (p : ι → MMP.Mori.PrimeDivisor X)
    (x : ι → ℝ) :
    (IsRealKltPair sX (∑ i, Finsupp.single (p i) (x i)) →
        ∀ᶠ y in 𝓝[Set.Ici 0] x, IsRealKltPair sX (∑ i, Finsupp.single (p i) (y i))) ∧
      (IsRealTerminalPair sX (∑ i, Finsupp.single (p i) (x i)) →
        ∀ᶠ y in 𝓝[Set.Ici 0] x, IsRealTerminalPair sX (∑ i, Finsupp.single (p i) (y i))) := by
  classical
  choose m hm hmc using fun i => hQ.2 (Finsupp.single (p i) (1 : ℤ))
  -- coefficients `< 1` persist near `x`
  have hcoeff_ev : (∀ P, (∑ i, Finsupp.single (p i) (x i) : RDivisor X).coeff P < 1) →
      ∀ᶠ y in 𝓝 x, ∀ P, (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff P < 1 := by
    intro h
    have hcont : ∀ P, Continuous fun y : ι → ℝ =>
        (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff P := fun P => by
      simp_rw [coeff_sum_single]
      refine continuous_finset_sum _ fun i _ => ?_
      split_ifs
      exacts [continuous_apply i, continuous_const]
    have : ∀ᶠ y in 𝓝 x, ∀ j, (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff (p j) < 1 :=
      eventually_all.2 fun j => ((hcont (p j)).tendsto x).eventually (gt_mem_nhds (h (p j)))
    filter_upwards [this] with y hy P
    by_cases hP : ∃ j, p j = P
    · obtain ⟨j, rfl⟩ := hP
      exact hy j
    · rw [coeff_sum_single, Finset.sum_eq_zero fun i _ => if_neg fun h => hP ⟨i, h⟩]
      norm_num
  -- a property of rational vectors near `x` holds for all vectors near `x`
  have hgood : ∀ (c : ℝ) (Q : DivisorOver k sX → Prop) (U : Set (ι → ℝ)), U ∈ 𝓝 x →
      (∀ q : ι → ℚ, (fun i => (q i : ℝ)) ∈ U → ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
        MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) ((q i : ℝ))) D a →
          c < a) →
      ∀ᶠ y in 𝓝 x, ∀ (n : ℕ) (D : DivisorOver k sX) (a : ℝ), Q D →
        MMP.Intersection.IsLogDiscrepancy sX n (∑ i, Finsupp.single (p i) (y i)) D a → c < a := by
    intro c Q U hU hq
    obtain ⟨V, hV, hVx⟩ := exists_rat_convexHull_mem_nhds hU
    refine Filter.mem_of_superset hVx
      (convexHull_min ?_ (convex_setOf_lt_isLogDiscrepancy p m hm hmc c Q))
    intro v hv
    obtain ⟨hvU, q, rfl⟩ := hV v hv
    exact hq q hvU
  have hev : ∀ {σ : Type u} (c : σ → ℝ) (w : σ → ι → ℝ) (s : σ) (b : ℝ),
      b < c s - ∑ i, x i * w s i → ∀ᶠ y in 𝓝 x, b < c s - ∑ i, y i * w s i :=
    fun c w s b h => ((by fun_prop : Continuous fun y : ι → ℝ => c s - ∑ i, y i * w s i).tendsto
      x).eventually (lt_mem_nhds h)
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · obtain ⟨hnv, hcoef, ⟨n, K, hK, -⟩, hpos⟩ := hx
    obtain ⟨σ, S, c, w, exc, meet, ha, -, -, hklt, -, -⟩ := exists_resolution_data hQ p hK
    have hU : ∀ᶠ y in 𝓝 x, (∀ s ∈ S, 0 < c s - ∑ i, y i * w s i) ∧
        ∀ P, (∑ i, Finsupp.single (p i) (y i) : RDivisor X).coeff P < 1 := by
      refine ((eventually_all_finset S).2 fun s hs => hev c w s 0 ?_).and (hcoeff_ev hcoef)
      obtain ⟨D, -, hD⟩ := ha s hs x
      exact hpos n D _ hD
    have hpos' := hgood 0 (fun _ => True) _ hU
      fun q hq n' D a _ hD => hklt q hq.1 (fun j => hq.2 (p j)) n' D a hD
    filter_upwards [nhdsWithin_le_nhds hpos', nhdsWithin_le_nhds (hcoeff_ev hcoef)] with y hy hyc
    exact ⟨hnv, hyc, ⟨n, K, hK, isRCartier_add_sum_single hQ K p y⟩,
      fun n' D a hD => hy n' D a trivial hD⟩
  · obtain ⟨⟨hnv, hcoef, ⟨n, K, hK, -⟩, -⟩, hterm⟩ := hx
    obtain ⟨σ, S, c, w, exc, meet, ha, hb, hc, -, hter, -⟩ := exists_resolution_data hQ p hK
    have hcoef1 : ∀ P, (∑ i, Finsupp.single (p i) (x i) : RDivisor X).coeff P < 1 := fun P => by
      by_cases h0 : (∑ i, Finsupp.single (p i) (x i) : RDivisor X).coeff P = 0
      · simp [h0]
      · exact (hcoef P h0).2
    have hx1 : ∀ s ∈ S, exc s → 1 < c s - ∑ i, x i * w s i := fun s hs he => by
      obtain ⟨D, hDe, hD⟩ := ha s hs x
      exact hterm n D _ (hDe he) hD
    have hx0 : ∀ s ∈ S, 0 < c s - ∑ i, x i * w s i := fun s hs => by
      by_cases he : exc s
      · linarith [hx1 s hs he]
      · obtain ⟨P, hP⟩ := hc s hs he
        rw [hP x]
        linarith [hcoef1 P]
    have hx2 : ∀ s ∈ S, ∀ t ∈ S, meet s t →
        1 < (c s - ∑ i, x i * w s i) + (c t - ∑ i, x i * w t i) := fun s hs t ht hst => by
      obtain ⟨D, hDe, hD⟩ := hb s hs t ht hst
      exact hterm n D _ hDe (hD x)
    have hU : ∀ᶠ y in 𝓝 x, (∀ s ∈ S, 0 < c s - ∑ i, y i * w s i) ∧
        (∀ s ∈ S, exc s → 1 < c s - ∑ i, y i * w s i) ∧
        (∀ s ∈ S, ∀ t ∈ S, meet s t →
          1 < (c s - ∑ i, y i * w s i) + (c t - ∑ i, y i * w t i)) := by
      refine ((eventually_all_finset S).2 fun s hs => hev c w s 0 (hx0 s hs)).and
        (((eventually_all_finset S).2 fun s hs => ?_).and
          ((eventually_all_finset S).2 fun s hs => (eventually_all_finset S).2 fun t ht => ?_))
      · by_cases he : exc s
        · filter_upwards [hev c w s 1 (hx1 s hs he)] with y hy _ using hy
        · exact Eventually.of_forall fun y h => absurd h he
      · by_cases hst : meet s t
        · have hcont : Continuous fun y : ι → ℝ =>
              (c s - ∑ i, y i * w s i) + (c t - ∑ i, y i * w t i) := by fun_prop
          filter_upwards [(hcont.tendsto x).eventually (lt_mem_nhds (hx2 s hs t ht hst))]
            with y hy _ using hy
        · exact Eventually.of_forall fun y h => absurd h hst
    have h1 := hgood 1 DivisorOver.IsExceptional _ hU
      fun q hq n' D a hD hDa => hter q hq.1 hq.2.1 hq.2.2 n' D a hD hDa
    filter_upwards [nhdsWithin_le_nhds h1, nhdsWithin_le_nhds (hcoeff_ev hcoef1),
      self_mem_nhdsWithin] with y hy hyc hy0
    refine ⟨⟨hnv, fun P hP => ⟨lt_of_le_of_ne ?_ (Ne.symm hP), hyc P⟩,
      ⟨n, K, hK, isRCartier_add_sum_single hQ K p y⟩,
      fun n' D a hD hDa => (hy n' D a hD hDa).le⟩, fun n' D a hD hDa => hy n' D a hD hDa⟩
    rw [coeff_sum_single]
    refine Finset.sum_nonneg fun i _ => ?_
    split_ifs
    exacts [(Set.mem_Ici.mp hy0) i, le_rfl]

end MMP.Fourfold

namespace Proof_lem_fourfold_real_klt_rational_polytope

open Set MMP.Fourfold MMP.Mori

variable {r : ℕ}

/-- The intersection of two rational polyhedra is a rational polyhedron. -/
private theorem IsRationalPolyhedron.inter {N N' : Set (Fin r → ℝ)} (hN : IsRationalPolyhedron N)
    (hN' : IsRationalPolyhedron N') : IsRationalPolyhedron (N ∩ N') := by
  classical
  obtain ⟨E, I, rfl⟩ := hN
  obtain ⟨E', I', rfl⟩ := hN'
  refine ⟨E ∪ E', I ∪ I', ?_⟩
  ext x
  simp only [mem_inter_iff, mem_setOf_eq, Finset.mem_union]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    exact ⟨fun f hf => hf.elim (h1 f) (h3 f), fun f hf => hf.elim (h2 f) (h4 f)⟩
  · rintro ⟨h1, h2⟩
    exact ⟨⟨fun f hf => h1 f (.inl hf), fun f hf => h2 f (.inl hf)⟩,
      fun f hf => h1 f (.inr hf), fun f hf => h2 f (.inr hf)⟩

private theorem ratAffineForm_single (i : Fin r) (c q : ℚ) (x : Fin r → ℝ) :
    ratAffineForm (Pi.single i c, q) x = c * x i + q := by
  classical
  simp only [ratAffineForm]
  rw [Finset.sum_eq_single i (fun j _ hj => by simp [Pi.single_eq_of_ne hj]) (by simp)]
  simp

/-- A set `{x | ∀ i, lᵢ ≤ xᵢ ≤ uᵢ}` with rational bounds is a rational polyhedron. -/
private theorem isRationalPolyhedron_box (l u : Fin r → ℚ) :
    IsRationalPolyhedron {x : Fin r → ℝ | ∀ i, (l i : ℝ) ≤ x i ∧ x i ≤ u i} := by
  classical
  refine ⟨∅, Finset.univ.image (fun i => (Pi.single i 1, -l i)) ∪
    Finset.univ.image (fun i => (Pi.single i (-1), u i)), ?_⟩
  ext x
  simp only [mem_setOf_eq, Finset.notMem_empty, IsEmpty.forall_iff, implies_true, true_and,
    Finset.mem_union, Finset.mem_image, Finset.mem_univ]
  constructor
  · rintro h f (⟨i, rfl⟩ | ⟨i, rfl⟩) <;> rw [ratAffineForm_single] <;> push_cast <;>
      linarith [(h i).1, (h i).2]
  · intro h i
    have h1 := h _ (.inl ⟨i, rfl⟩)
    have h2 := h _ (.inr ⟨i, rfl⟩)
    rw [ratAffineForm_single] at h1 h2
    push_cast at h1 h2
    constructor <;> linarith

/-- The coordinatewise lower bound `{x | ∀ i, gᵢ ≤ xᵢ}` with rational `g` is a rational
polyhedron. -/
private theorem isRationalPolyhedron_lowerBound (g : Fin r → ℚ) :
    IsRationalPolyhedron {x : Fin r → ℝ | ∀ i, (g i : ℝ) ≤ x i} := by
  classical
  refine ⟨∅, Finset.univ.image (fun i => (Pi.single i 1, -g i)), ?_⟩
  ext x
  simp only [mem_setOf_eq, Finset.notMem_empty, IsEmpty.forall_iff, implies_true, true_and,
    Finset.mem_image, Finset.mem_univ]
  constructor
  · rintro h f ⟨i, rfl⟩
    rw [ratAffineForm_single]
    push_cast
    linarith [h i]
  · intro h i
    have h1 := h _ ⟨i, rfl⟩
    rw [ratAffineForm_single] at h1
    push_cast at h1
    linarith

/-- A rational parallelotope is the convex hull of finitely many rational points (its corners). -/
private theorem IsRationalParallelotope.exists_finset {Q : Set (Fin r → ℝ)}
    (hQ : IsRationalParallelotope Q) :
    ∃ V : Finset (Fin r → ℚ),
      Q = convexHull ℝ ((fun v i => (v i : ℝ)) '' (V : Set (Fin r → ℚ))) := by
  classical
  obtain ⟨d, p, e, a, b, -, hab, rfl⟩ := hQ
  let φ : (Fin d → ℝ) →ᵃ[ℝ] (Fin r → ℝ) :=
    (Fintype.linearCombination ℝ (fun i j => (e i j : ℝ))).toAffineMap +
      AffineMap.const ℝ _ (fun j => (p j : ℝ))
  have hφ : ∀ s j, φ s j = (p j : ℝ) + ∑ i, s i * (e i j : ℝ) := fun s j => by
    simp [φ, Fintype.linearCombination_apply, add_comm]
  let corner : (Fin d → Bool) → Fin r → ℚ := fun c j =>
    p j + ∑ i, (if c i then b i else a i) * e i j
  let C : Set (Fin d → ℝ) := univ.pi fun i => {(a i : ℝ), (b i : ℝ)}
  refine ⟨Finset.univ.image corner, ?_⟩
  have hbox : (univ.pi fun i => Icc (a i : ℝ) (b i)) = convexHull ℝ C := by
    rw [convexHull_pi]
    refine pi_congr rfl fun i _ => ?_
    rw [convexHull_pair, segment_eq_Icc (by exact_mod_cast (hab i).le)]
  have hV : (fun v i => (v i : ℝ)) '' ((Finset.univ.image corner : Finset _) : Set (Fin r → ℚ)) =
      φ '' C := by
    ext x
    simp only [Finset.coe_image, Finset.coe_univ, image_univ, mem_image, mem_range]
    constructor
    · rintro ⟨_, ⟨c, rfl⟩, rfl⟩
      refine ⟨fun i => ((if c i then b i else a i : ℚ) : ℝ), fun i _ => ?_, ?_⟩
      · by_cases h : c i <;> simp [h]
      · funext j
        rw [hφ]
        simp only [corner]
        push_cast
        exact congrArg _ (Finset.sum_congr rfl fun i _ => by by_cases h : c i <;> simp [h])
    · rintro ⟨s, hs, rfl⟩
      have hs' : ∀ i, s i = ((if decide (s i = b i) then b i else a i : ℚ) : ℝ) := fun i => by
        rcases hs i (mem_univ i) with h | h <;> by_cases h' : s i = b i <;> simp_all
      refine ⟨corner fun i => decide (s i = b i), ⟨_, rfl⟩, ?_⟩
      funext j
      rw [hφ]
      simp only [corner]
      push_cast
      exact congrArg _ (Finset.sum_congr rfl fun i _ => by rw [← hs' i])
  rw [hV, ← AffineMap.image_convexHull, ← hbox]
  ext x
  constructor
  · rintro ⟨s, hs, rfl⟩
    exact ⟨s, Set.mem_univ_pi.2 hs, funext fun j => hφ s j⟩
  · rintro ⟨s, hs, rfl⟩
    exact ⟨s, Set.mem_univ_pi.1 hs, funext fun j => hφ s j⟩

/-- **Rational polytopes along the smallest rational affine hull.** If `N` is a rational
polyhedron containing `δ` and `S` is a neighbourhood of `δ`, there is a finite set `V` of rational
points whose convex hull lies in `N ∩ S`, has affine span the smallest rational affine subspace
through `δ`, and contains `δ` in its relative interior. -/
private theorem exists_finset_convexHull {N S : Set (Fin r → ℝ)} (hN : IsRationalPolyhedron N)
    {δ : Fin r → ℝ} (hδ : δ ∈ N) (hS : S ∈ 𝓝 δ) :
    ∃ V : Finset (Fin r → ℚ),
      affineSpan ℝ (convexHull ℝ
          ((fun (v : Fin r → ℚ) (i : Fin r) => (v i : ℝ)) '' (V : Set (Fin r → ℚ)))) =
          rationalAffineHull δ ∧
        δ ∈ intrinsicInterior ℝ (convexHull ℝ
          ((fun (v : Fin r → ℚ) (i : Fin r) => (v i : ℝ)) '' (V : Set (Fin r → ℚ)))) ∧
        convexHull ℝ ((fun (v : Fin r → ℚ) (i : Fin r) => (v i : ℝ)) '' (V : Set (Fin r → ℚ))) ⊆
          N ∩ S := by
  obtain ⟨ρ, hρ, hball⟩ := Metric.mem_nhds_iff.1 hS
  choose l hl1 hl2 using fun i => exists_rat_btwn (show δ i - ρ < δ i by linarith)
  choose u hu1 hu2 using fun i => exists_rat_btwn (show δ i < δ i + ρ by linarith)
  have hN' := IsRationalPolyhedron.inter hN (isRationalPolyhedron_box l u)
  have hδ' : δ ∈ N ∩ {x : Fin r → ℝ | ∀ i, (l i : ℝ) ≤ x i ∧ x i ≤ u i} :=
    ⟨hδ, fun i => ⟨(hl2 i).le, (hu1 i).le⟩⟩
  obtain ⟨-, Q, hQ, hQN, hδQ, hQW⟩ := rational_hull_neighborhood hN' hδ'
  obtain ⟨V, rfl⟩ := IsRationalParallelotope.exists_finset hQ
  refine ⟨V, hQW, hδQ, fun x hx => ⟨(hQN hx).1.1, hball ?_⟩⟩
  have hxb := (hQN hx).1.2
  rw [Metric.mem_ball]
  refine (dist_pi_lt_iff hρ).2 fun i => ?_
  rw [Real.dist_eq, abs_lt]
  constructor <;> linarith [(hxb i).1, (hxb i).2, hl1 i, hu2 i]

/-- On a `ℚ`-factorial variety over an algebraically closed field of characteristic zero, an
effective `ℚ`-divisor that is klt as a real boundary is klt. -/
theorem _root_.MMP.Fourfold.isKltPair_of_isRealKltPair {k : Type u} [Field k] [IsAlgClosed k]
    [CharZero k] {Y : Scheme.{u}} {sY : Y ⟶ Spec (.of k)} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y]
    (hQ : IsQFactorial sY) {B : QDivisor Y} (hB : ∀ P, 0 ≤ B.coeff P)
    (h : IsRealKltPair sY (QDivisor.toRDivisor B)) : IsKltPair sY B := by
  obtain ⟨hn, -, ⟨n, K, hK, -⟩, hd⟩ := h
  exact ⟨⟨inferInstance, inferInstance, ⟨hn, n, K, hK, isQCartier_of_isQFactorial sY hQ _⟩, hB⟩,
    hd⟩

/-- A divisor supported on the injective family `p` is the sum of its coefficients along `p`. -/
theorem _root_.MMP.Fourfold.eq_sum_single_coeff {R : Type*} [AddCommMonoid R] {Y : Scheme.{u}}
    {ι : Type*} [Fintype ι] {p : ι → MMP.Mori.PrimeDivisor Y} (hp : Function.Injective p)
    {D : DivisorWithCoeffs R Y} (hD : ∀ P, D.coeff P ≠ 0 → P ∈ Set.range p) :
    D = ∑ i, Finsupp.single (p i) (D.coeff (p i)) := by
  classical
  conv_lhs => rw [← Finsupp.sum_single D]
  rw [Finsupp.sum_of_support_subset D (s := Finset.univ.image p) (g := Finsupp.single)
    (fun P hP => by simpa using hD P (by simpa [DivisorWithCoeffs.coeff_apply] using hP))
    (fun _ _ => Finsupp.single_zero _), Finset.sum_image fun i _ j _ h => hp h]
  rfl

end Proof_lem_fourfold_real_klt_rational_polytope

namespace MMP.Fourfold

open MMP.Mori
open Proof_lem_fourfold_real_klt_rational_polytope

/-- **A rational klt polytope through a real klt boundary.** Let `Y` be a normal `ℚ`-factorial
projective variety over an algebraically closed field of characteristic zero, `Δ` an effective
`ℝ`-divisor with `(Y, Δ)` klt, and `G ≤ Δ` an effective `ℚ`-divisor. Let
`p : Fin r → PrimeDivisor Y` be injective with the supports of `G` and `Δ` in its range, and let
`δ = (Δ.coeff (p i))ᵢ`. There is a finite set `V ⊆ ℚ^r` whose convex hull `P` has affine span
`rationalAffineHull δ` and contains `δ` in its relative interior, such that every point of `P`
is at least `G` coordinatewise and `(Y, ∑ᵢ vᵢ pᵢ)` is klt for every `v ∈ V`. -/
@[mmp "lem_fourfold_real_klt_rational_polytope"]
public theorem exists_rationalPolytope_isKltPair_of_isRealKltPair {k : Type u} [Field k]
    [IsAlgClosed k] [CharZero k] {Y : Scheme.{u}} (sY : Y ⟶ Spec (.of k)) [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (hY : MMP.Mori.IsProjectiveVariety k sY)
    (hQ : IsQFactorial sY) (Δ : RDivisor Y) (hΔ0 : 0 ≤ Δ) (hΔ : IsRealKltPair sY Δ)
    (G : QDivisor Y) (hG0 : 0 ≤ G) (hGΔ : QDivisor.toRDivisor G ≤ Δ)
    {r : ℕ} (p : Fin r → MMP.Mori.PrimeDivisor Y) (hp : Function.Injective p)
    (hΔp : ∀ P, Δ.coeff P ≠ 0 → P ∈ Set.range p) (hGp : ∀ P, G.coeff P ≠ 0 → P ∈ Set.range p) :
    ∃ V : Finset (Fin r → ℚ),
      affineSpan ℝ (convexHull ℝ ((fun v i => (v i : ℝ)) '' (V : Set (Fin r → ℚ)))) =
          rationalAffineHull (fun i => Δ.coeff (p i)) ∧
        (fun i => Δ.coeff (p i)) ∈
          intrinsicInterior ℝ (convexHull ℝ ((fun v i => (v i : ℝ)) '' (V : Set (Fin r → ℚ)))) ∧
        (∀ x ∈ convexHull ℝ ((fun v i => (v i : ℝ)) '' (V : Set (Fin r → ℚ))),
          ∀ i, ((G.coeff (p i) : ℚ) : ℝ) ≤ x i) ∧
        ∀ v ∈ V, IsKltPair sY (∑ i, Finsupp.single (p i) (v i)) := by
  set δ : Fin r → ℝ := fun i => Δ.coeff (p i)
  have hev := (eventually_isRealKltPair_and_isRealTerminalPair sY hY.isQuasiProjectiveVariety hQ
    p δ).1 (eq_sum_single_coeff hp hΔp ▸ hΔ)
  rw [eventually_nhdsWithin_iff] at hev
  obtain ⟨V, h1, h2, h3⟩ := exists_finset_convexHull (isRationalPolyhedron_lowerBound _)
    (fun i => hGΔ (p i)) hev
  refine ⟨V, h1, h2, fun x hx => (h3 hx).1, fun v hv => ?_⟩
  obtain ⟨hvG, hvK⟩ := h3 (subset_convexHull ℝ _ ⟨v, hv, rfl⟩)
  have hnn : (fun i => (v i : ℝ)) ∈ Set.Ici 0 := fun i =>
    (Rat.cast_nonneg.2 (hG0 (p i))).trans (hvG i)
  refine isKltPair_of_isRealKltPair hQ (fun P => ?_) (toRDivisor_sum_single p v ▸ hvK hnn)
  exact (Finset.sum_nonneg fun i _ => Finsupp.single_nonneg.2 (Rat.cast_nonneg.1 (hnn i)) :
    (0 : QDivisor Y) ≤ _) P

end MMP.Fourfold
