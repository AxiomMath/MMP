namespace MMP.Flips.CyclicModelInvariants

/-- An invariant series with nonzero constant term has an invariant inverse, so the invariant
ring is local. -/
private theorem isLocalRing_cyclicInvariants (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    IsLocalRing (cyclicInvariants K m q) := by
  have key : ∀ a : cyclicInvariants K m q,
      MvPowerSeries.constantCoeff (a : MvPowerSeries (Fin 2) K) ≠ 0 → IsUnit a := by
    intro a ha
    have hinv : (a : MvPowerSeries (Fin 2) K)⁻¹ ∈ cyclicInvariants K m q := by
      intro ζ
      have h1 : (a : MvPowerSeries (Fin 2) K) * (a : MvPowerSeries (Fin 2) K)⁻¹ = 1 :=
        MvPowerSeries.mul_inv_cancel _ ha
      have h2 := congrArg (MvPowerSeries.rescale (cyclicWeights K m q ζ)) h1
      rw [map_mul, map_one, (mem_cyclicInvariants_iff K m q _).mp a.2 ζ] at h2
      change MvPowerSeries.rescale (cyclicWeights K m q ζ) _ = _
      calc _ = MvPowerSeries.rescale (cyclicWeights K m q ζ) (a : MvPowerSeries (Fin 2) K)⁻¹ *
            ((a : MvPowerSeries (Fin 2) K) * (a : MvPowerSeries (Fin 2) K)⁻¹) := by rw [h1, mul_one]
        _ = (a : MvPowerSeries (Fin 2) K)⁻¹ := by rw [← mul_assoc, mul_comm _ (a : MvPowerSeries
            (Fin 2) K), h2, one_mul]
    exact IsUnit.of_mul_eq_one (b := ⟨_, hinv⟩) (Subtype.ext (MvPowerSeries.mul_inv_cancel _ ha))
  refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun a => ?_
  by_cases ha : MvPowerSeries.constantCoeff (a : MvPowerSeries (Fin 2) K) = 0
  · exact Or.inr (key _ (by simp [ha]))
  · exact Or.inl (key a ha)

section RingTheory

/-- The averaging projection: keep the monomials of weight divisible by `m`. -/
private noncomputable def cyclicAverage (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (f : MvPowerSeries (Fin 2) K) : MvPowerSeries (Fin 2) K :=
  fun n => if (m : ℤ) ∣ (n 0 : ℤ) + q * n 1 then coeff n f else 0

private theorem coeff_cyclicAverage (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (f : MvPowerSeries (Fin 2) K) (n : Fin 2 →₀ ℕ) :
    coeff n (cyclicAverage K m q f) =
      if (m : ℤ) ∣ (n 0 : ℤ) + q * n 1 then coeff n f else 0 := rfl

private theorem cyclicAverage_add (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (f g : MvPowerSeries (Fin 2) K) :
    cyclicAverage K m q (f + g) = cyclicAverage K m q f + cyclicAverage K m q g := by
  ext n
  simp only [coeff_cyclicAverage, map_add]
  split_ifs <;> simp

private theorem weight_add (q : ℤ) (a b : Fin 2 →₀ ℕ) :
    ((a + b) 0 : ℤ) + q * (a + b) 1 = ((a 0 : ℤ) + q * a 1) + ((b 0 : ℤ) + q * b 1) := by
  push_cast [Finsupp.add_apply]
  ring

/-- Multiplication by a series supported in weights divisible by `m` commutes with averaging. -/
private theorem cyclicAverage_mul (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (r f : MvPowerSeries (Fin 2) K)
    (hr : ∀ n : Fin 2 →₀ ℕ, coeff n r ≠ 0 → (m : ℤ) ∣ (n 0 : ℤ) + q * n 1) :
    cyclicAverage K m q (r * f) = r * cyclicAverage K m q f := by
  ext n
  rw [coeff_cyclicAverage, coeff_mul, coeff_mul]
  split_ifs with hn
  · refine Finset.sum_congr rfl fun p hp => ?_
    have hp : p.1 + p.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    rw [coeff_cyclicAverage]
    by_cases ha : coeff p.1 r = 0
    · simp [ha]
    have h1 := hr _ ha
    have h2 : (m : ℤ) ∣ (p.2 0 : ℤ) + q * p.2 1 := by
      rw [← hp, weight_add] at hn
      exact (Int.dvd_add_right h1).mp hn
    simp [h2]
  · symm
    refine Finset.sum_eq_zero fun p hp => ?_
    have hp : p.1 + p.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    rw [coeff_cyclicAverage]
    by_cases ha : coeff p.1 r = 0
    · simp [ha]
    have h1 := hr _ ha
    have h2 : ¬ (m : ℤ) ∣ (p.2 0 : ℤ) + q * p.2 1 := by
      intro h2
      apply hn
      rw [← hp, weight_add]
      exact dvd_add h1 h2
    simp [h2]

private theorem prod_cyclicWeights_pow (K : Type w) [Field K] (m : ℕ) (q : ℤ) (ζ : rootsOfUnity m K)
    (n : Fin 2 →₀ ℕ) :
    (n.prod fun s k => cyclicWeights K m q ζ s ^ k) =
      (((ζ : Kˣ) ^ ((n 0 : ℤ) + q * n 1) : Kˣ) : K) := by
  rw [Finsupp.prod_fintype _ _ (by simp)]
  simp [Fin.prod_univ_two, cyclicWeights, zpow_add, zpow_mul, zpow_natCast]

/-- The order `m` of the group is nonzero. -/
private theorem neZero_of_isCyclicQuotientSetting {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) : NeZero m :=
  ⟨by have := h.one_le; omega⟩

/-- `μ_m` has a generator. -/
private theorem exists_isPrimitiveRoot_rootsOfUnity {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) : ∃ ζ : rootsOfUnity m K, IsPrimitiveRoot (ζ : Kˣ) m := by
  have := h.isAlgClosed
  have := h.charZero
  have := neZero_of_isCyclicQuotientSetting h
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K m
  exact ⟨rootsOfUnity.mkOfPowEq ζ hζ.pow_eq_one, by
    rw [← IsPrimitiveRoot.coe_units_iff]; simpa using hζ⟩

private theorem mem_cyclicInvariants_iff_coeff {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) (f : MvPowerSeries (Fin 2) K) :
    f ∈ cyclicInvariants K m q ↔
      ∀ n : Fin 2 →₀ ℕ, coeff n f ≠ 0 → (m : ℤ) ∣ (n 0 : ℤ) + q * n 1 := by
  rw [mem_cyclicInvariants_iff]
  constructor
  · intro hf n hn
    obtain ⟨ζ', hζ'⟩ := exists_isPrimitiveRoot_rootsOfUnity h
    have h1 := congrArg (coeff n) (hf ζ')
    rw [coeff_rescale, prod_cyclicWeights_pow] at h1
    have h2 : (((ζ' : Kˣ) ^ ((n 0 : ℤ) + q * n 1) : Kˣ) : K) = 1 :=
      mul_right_cancel₀ hn (h1.trans (one_mul _).symm)
    exact (hζ'.zpow_eq_one_iff_dvd _).mp (Units.val_eq_one.mp h2)
  · intro hf ζ
    ext n
    rw [coeff_rescale, prod_cyclicWeights_pow]
    by_cases hn : coeff n f = 0
    · simp [hn]
    obtain ⟨k, hk⟩ := hf n hn
    have : ((ζ : Kˣ) ^ ((n 0 : ℤ) + q * n 1)) = 1 := by
      rw [hk, zpow_mul, zpow_natCast]
      simp [(mem_rootsOfUnity _ _).mp ζ.2]
    simp [this]

private theorem cyclicAverage_mem {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) (f : MvPowerSeries (Fin 2) K) :
    cyclicAverage K m q f ∈ cyclicInvariants K m q := by
  rw [mem_cyclicInvariants_iff_coeff h]
  intro n hn
  rw [coeff_cyclicAverage] at hn
  by_contra hc
  exact hn (if_neg hc)

private theorem cyclicAverage_eq_self {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) {f : MvPowerSeries (Fin 2) K}
    (hf : f ∈ cyclicInvariants K m q) : cyclicAverage K m q f = f := by
  rw [mem_cyclicInvariants_iff_coeff h] at hf
  ext n
  rw [coeff_cyclicAverage]
  split_ifs with hn
  · rfl
  · by_contra hc
    exact hn (hf n (Ne.symm hc))

private theorem comap_map_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) (I : Ideal (cyclicInvariants K m q)) :
    (I.map (cyclicInvariants K m q).subtype).comap (cyclicInvariants K m q).subtype = I := by
  refine le_antisymm (fun x hx => ?_) Ideal.le_comap_map
  have key : ∀ y ∈ I.map (cyclicInvariants K m q).subtype, ∀ a : MvPowerSeries (Fin 2) K,
      ∃ i ∈ I, (i : MvPowerSeries (Fin 2) K) = cyclicAverage K m q (a * y) := by
    intro y hy
    rw [Ideal.map, Ideal.span] at hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      intro a
      refine ⟨j * ⟨_, cyclicAverage_mem h a⟩, I.mul_mem_right _ hj, ?_⟩
      rw [mul_comm a, cyclicAverage_mul]
      · rfl
      · exact (mem_cyclicInvariants_iff_coeff h _).mp j.2
    | zero =>
      intro a
      refine ⟨0, I.zero_mem, ?_⟩
      ext n; simp [coeff_cyclicAverage]
    | add y z _ _ hy hz =>
      intro a
      obtain ⟨i, hi, hi'⟩ := hy a
      obtain ⟨j, hj, hj'⟩ := hz a
      exact ⟨i + j, I.add_mem hi hj, by rw [mul_add, cyclicAverage_add, ← hi', ← hj']; rfl⟩
    | smul b y _ hy =>
      intro a
      obtain ⟨i, hi, hi'⟩ := hy (a * b)
      exact ⟨i, hi, by rw [hi', smul_eq_mul, mul_assoc]⟩
  obtain ⟨i, hi, hi'⟩ := key _ hx 1
  rw [one_mul, Subring.subtype_apply, cyclicAverage_eq_self h x.2] at hi'
  exact (Subtype.ext hi' : i = x) ▸ hi

private theorem isNoetherianRing_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) : IsNoetherianRing (cyclicInvariants K m q) := by
  have hmono : StrictMono fun I : Ideal (cyclicInvariants K m q) =>
      I.map (cyclicInvariants K m q).subtype := by
    refine Monotone.strictMono_of_injective (fun I J hIJ => Ideal.map_mono hIJ) fun I J hIJ => ?_
    rw [← comap_map_cyclicInvariants h I, ← comap_map_cyclicInvariants h J]
    exact congrArg _ hIJ
  rw [isNoetherianRing_iff, isNoetherian_iff']
  exact hmono.wellFoundedGT

/-- The exponent `(i, j)` as a monomial. -/
private noncomputable abbrev expo (p : ℕ × ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 p.1 + Finsupp.single 1 p.2

/-- The component of `f` in the monomials `x^a y^b` with `a ≡ p.1`, `b ≡ p.2 (mod m)`, divided by
`x^{p.1} y^{p.2}`: a series in `x^m, y^m`. -/
private noncomputable def cyclicComponent (K : Type w) [Field K] (m : ℕ) (p : ℕ × ℕ)
    (f : MvPowerSeries (Fin 2) K) : MvPowerSeries (Fin 2) K :=
  fun e => if m ∣ e 0 ∧ m ∣ e 1 then coeff (e + expo p) f else 0

private theorem cyclicComponent_mem {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) (p : ℕ × ℕ) (f : MvPowerSeries (Fin 2) K) :
    cyclicComponent K m p f ∈ cyclicInvariants K m q := by
  rw [mem_cyclicInvariants_iff_coeff h]
  intro n hn
  change (if m ∣ n 0 ∧ m ∣ n 1 then _ else _) ≠ 0 at hn
  split_ifs at hn with hd
  · exact dvd_add (Int.natCast_dvd_natCast.mpr hd.1)
      (dvd_mul_of_dvd_right (Int.natCast_dvd_natCast.mpr hd.2) _)
  · exact absurd rfl hn

private theorem sum_monomial_mul_cyclicComponent {K : Type w} [Field K] {m : ℕ} (hm : 0 < m)
    (f : MvPowerSeries (Fin 2) K) :
    ∑ p ∈ Finset.range m ×ˢ Finset.range m, monomial (expo p) 1 * cyclicComponent K m p f = f := by
  ext n
  rw [map_sum]
  simp only [coeff_monomial_mul, one_mul]
  rw [Finset.sum_eq_single (n 0 % m, n 1 % m)]
  · have hle : expo (n 0 % m, n 1 % m) ≤ n := by
      rw [Finsupp.le_def]; intro i; fin_cases i <;> simp [Nat.mod_le]
    rw [if_pos hle]
    change (if m ∣ (n - expo _) 0 ∧ m ∣ (n - expo _) 1 then _ else _) = _
    rw [if_pos, tsub_add_cancel_of_le hle]
    simp [Nat.dvd_sub_mod]
  · intro p hp hne
    rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
    split_ifs with hle
    · change (if m ∣ (n - expo _) 0 ∧ m ∣ (n - expo _) 1 then _ else _) = _
      rw [if_neg]
      rintro ⟨h0, h1⟩
      apply hne
      rw [Finsupp.le_def] at hle
      have hle0 := hle 0; have hle1 := hle 1
      simp at h0 h1 hle0 hle1
      have e0 := ((Nat.modEq_iff_dvd' hle0).mpr h0)
      have e1 := ((Nat.modEq_iff_dvd' hle1).mpr h1)
      unfold Nat.ModEq at e0 e1
      rw [Nat.mod_eq_of_lt hp.1] at e0
      rw [Nat.mod_eq_of_lt hp.2] at e1
      exact Prod.ext e0 e1
    · rfl
  · intro hn
    exact absurd (by simp [Nat.mod_lt _ hm]) hn

private theorem module_finite_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) :
    Module.Finite (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K) := by
  classical
  have hm : 0 < m := h.one_le
  refine ⟨⟨(Finset.range m ×ˢ Finset.range m).image fun p => monomial (expo p) (1 : K), ?_⟩⟩
  refine eq_top_iff.mpr fun f _ => ?_
  rw [← sum_monomial_mul_cyclicComponent hm f]
  refine Submodule.sum_mem _ fun p hp => ?_
  have := Submodule.smul_mem (Submodule.span (cyclicInvariants K m q)
    (((Finset.range m ×ˢ Finset.range m).image fun p => monomial (expo p) (1 : K)) :
      Set (MvPowerSeries (Fin 2) K)))
    (⟨_, cyclicComponent_mem h p f⟩ : cyclicInvariants K m q)
    (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hp)))
  rwa [Subring.smul_def, smul_eq_mul, mul_comm] at this

private theorem ringKrullDim_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) : ringKrullDim (cyclicInvariants K m q) = 2 := by
  haveI := module_finite_cyclicInvariants h
  rw [Algebra.IsIntegral.ringKrullDim_eq (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K),
    MvPowerSeries.ringKrullDim_eq]
  rfl

private theorem isIntegrallyClosed_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ} :
    letI : IsDomain (cyclicInvariants K m q) := NoZeroDivisors.to_isDomain _
    IsIntegrallyClosed (cyclicInvariants K m q) := by
  letI : IsDomain (cyclicInvariants K m q) := NoZeroDivisors.to_isDomain _
  haveI := MvPowerSeries.isRegularLocalRing K 2
  haveI : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  haveI : UniqueFactorizationMonoid (MvPowerSeries (Fin 2) K) :=
    IsRegularLocalRing.uniqueFactorizationMonoid _
  let FA := FractionRing (MvPowerSeries (Fin 2) K)
  let g : (cyclicInvariants K m q) →+* FA := (algebraMap (MvPowerSeries (Fin 2) K) FA).comp
      (cyclicInvariants K m q).subtype
  have hg : Function.Injective g :=
    (IsFractionRing.injective (MvPowerSeries (Fin 2) K) FA).comp Subtype.val_injective
  let φ : FractionRing (cyclicInvariants K m q) →ₐ[(cyclicInvariants K m q)] FA :=
    { IsFractionRing.lift hg with
      commutes' := fun r => IsFractionRing.lift_algebraMap hg r }
  rw [isIntegrallyClosed_iff (FractionRing (cyclicInvariants K m q))]
  intro x hx
  obtain ⟨⟨a, b⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors (cyclicInvariants K m q)) x
  have hφ : φ (IsLocalization.mk' (FractionRing (cyclicInvariants K m q)) a b) = g a / g b :=
    IsFractionRing.lift_mk' hg a b
  have hint : IsIntegral (MvPowerSeries (Fin 2) K) (φ (IsLocalization.mk' (FractionRing
      (cyclicInvariants K m q)) a b)) :=
    (hx.map φ).tower_top
  obtain ⟨c, hc⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  have hb0 : g b ≠ 0 := fun h0 => nonZeroDivisors.coe_ne_zero b (hg (h0.trans (map_zero g).symm))
  have hcb : c * (b : (MvPowerSeries (Fin 2) K)) = a := by
    apply IsFractionRing.injective (MvPowerSeries (Fin 2) K) FA
    rw [map_mul, hc, hφ]
    exact div_mul_cancel₀ _ hb0
  have hbA : ((b : (cyclicInvariants K m q)) : (MvPowerSeries (Fin 2) K)) ≠ 0 := fun h0 =>
      nonZeroDivisors.coe_ne_zero b (Subtype.ext h0)
  have hcR : c ∈ (cyclicInvariants K m q) := by
    refine (mem_cyclicInvariants_iff K m q c).mpr fun ζ => ?_
    have e := congrArg (MvPowerSeries.rescale (cyclicWeights K m q ζ)) hcb
    rw [map_mul, (mem_cyclicInvariants_iff K m q _).mp (b : (cyclicInvariants K m q)).2 ζ,
      (mem_cyclicInvariants_iff K m q _).mp a.2 ζ, ← hcb] at e
    exact mul_right_cancel₀ hbA e
  refine ⟨⟨c, hcR⟩, φ.toRingHom.injective ?_⟩
  change φ (algebraMap (cyclicInvariants K m q) (FractionRing (cyclicInvariants K m q)) ⟨c, hcR⟩)
      = _
  rw [φ.commutes]
  change _ = φ (IsLocalization.mk' _ a b)
  rw [← hc, IsScalarTower.algebraMap_apply (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K) FA]
  rfl

end RingTheory

/-- `x^m` and `y^m` are invariant. -/
private theorem X_pow_mem_cyclicInvariants {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) (i : Fin 2) :
    MvPowerSeries.X i ^ m ∈ cyclicInvariants K m q := by
  classical
  rw [mem_cyclicInvariants_iff_coeff h]
  intro n hn
  rw [MvPowerSeries.coeff_X_pow] at hn
  split_ifs at hn with he
  · subst he
    fin_cases i <;> simp
  · exact absurd rfl hn

section Eigenspaces

/-- The weight-`i` component of `f`: the monomials `x^a y^b` with `a + q b ≡ i (mod m)`. -/
private noncomputable def cyclicWeightComponent (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (i : ZMod m) (f : MvPowerSeries (Fin 2) K) : MvPowerSeries (Fin 2) K :=
  fun n => if (((n 0 : ℤ) + q * n 1 : ℤ) : ZMod m) = i then coeff n f else 0

private theorem coeff_cyclicWeightComponent (K : Type w) [Field K] (m : ℕ) (q : ℤ)
    (i : ZMod m) (f : MvPowerSeries (Fin 2) K) (n : Fin 2 →₀ ℕ) :
    coeff n (cyclicWeightComponent K m q i f) =
      if (((n 0 : ℤ) + q * n 1 : ℤ) : ZMod m) = i then coeff n f else 0 := rfl

private theorem sum_cyclicWeightComponent (K : Type w) [Field K] (m : ℕ) [NeZero m] (q : ℤ)
    (f : MvPowerSeries (Fin 2) K) :
    ∑ i : ZMod m, cyclicWeightComponent K m q i f = f := by
  ext n
  rw [map_sum]
  simp only [coeff_cyclicWeightComponent]
  rw [Finset.sum_ite_eq]
  simp

/-- The weight-`i` component is an eigenvector of character `ζ ↦ ζ^i`. -/
private theorem rescale_cyclicWeightComponent (K : Type w) [Field K] (m : ℕ) [NeZero m] (q : ℤ)
    (ζ : rootsOfUnity m K) (i : ZMod m) (f : MvPowerSeries (Fin 2) K) :
    rescale (cyclicWeights K m q ζ) (cyclicWeightComponent K m q i f) =
      C (((ζ : Kˣ) : K) ^ i.val) * cyclicWeightComponent K m q i f := by
  ext n
  rw [coeff_rescale, prod_cyclicWeights_pow, coeff_C_mul, coeff_cyclicWeightComponent]
  split_ifs with hw
  · have hd : (m : ℤ) ∣ ((n 0 : ℤ) + q * n 1) - (i.val : ℤ) := by
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast at hw ⊢
      rw [hw, ZMod.natCast_zmod_val, sub_self]
    obtain ⟨k, hk⟩ := hd
    have e : (ζ : Kˣ) ^ ((n 0 : ℤ) + q * n 1) = (ζ : Kˣ) ^ i.val := by
      rw [show ((n 0 : ℤ) + q * n 1) = (i.val : ℤ) + m * k by linarith, zpow_add, zpow_mul,
        zpow_natCast, zpow_natCast, (mem_rootsOfUnity _ _).mp ζ.2, one_zpow, mul_one]
    rw [e, Units.val_pow_eq_pow_val]
  · simp

end Eigenspaces

/-- **Orthogonality of the characters of `μ_m`.** -/
private theorem sum_rootsOfUnity_zpow {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) [Fintype (rootsOfUnity m K)] (k : ℤ) :
    ∑ ζ : rootsOfUnity m K, (((ζ : Kˣ) ^ k : Kˣ) : K) = if (m : ℤ) ∣ k then (m : K) else 0 := by
  classical
  haveI := h.isAlgClosed
  haveI := h.charZero
  haveI := neZero_of_isCyclicQuotientSetting h
  split_ifs with hk
  · obtain ⟨j, rfl⟩ := hk
    have : ∀ ζ : rootsOfUnity m K, (((ζ : Kˣ) ^ ((m : ℤ) * j) : Kˣ) : K) = 1 := by
      intro ζ
      rw [zpow_mul, zpow_natCast, (mem_rootsOfUnity _ _).mp ζ.2]; simp
    rw [Finset.sum_congr rfl fun ζ _ => this ζ, Finset.sum_const, Finset.card_univ,
      ← Nat.card_eq_fintype_card, HasEnoughRootsOfUnity.natCard_rootsOfUnity]
    simp
  · let f : rootsOfUnity m K →* K :=
      (Units.coeHom K).comp ((zpowGroupHom k).comp (rootsOfUnity m K).subtype)
    refine sum_hom_units_eq_zero f fun hf => hk ?_
    obtain ⟨ζ', hζ'⟩ := exists_isPrimitiveRoot_rootsOfUnity h
    have e := DFunLike.congr_fun hf ζ'
    refine (hζ'.zpow_eq_one_iff_dvd k).mp (Units.val_eq_one.mp ?_)
    simpa [f] using e

/-- The weight of `x` is the root of unity itself. -/
private theorem rescale_X_zero_pow (K : Type w) [Field K] (m : ℕ) (q : ℤ) (ζ : rootsOfUnity m K)
    (j : ℕ) : MvPowerSeries.rescale (cyclicWeights K m q ζ) (MvPowerSeries.X 0 ^ j) =
      MvPowerSeries.C (((ζ : Kˣ) : K) ^ j) * MvPowerSeries.X 0 ^ j := by
  classical
  ext n
  rw [MvPowerSeries.coeff_rescale, prod_cyclicWeights_pow, MvPowerSeries.coeff_C_mul,
    MvPowerSeries.coeff_X_pow]
  split_ifs with hn
  · subst hn; simp
  · simp

/-- The coordinates are nonzero. -/
private theorem X_ne_zero (K : Type w) [Field K] (i : Fin 2) :
    (MvPowerSeries.X i : MvPowerSeries (Fin 2) K) ≠ 0 :=
  nonZeroDivisors.ne_zero MvPowerSeries.X_mem_nonzeroDivisors

/-- `y^{q'}`, with `q q' ≡ 1 (mod m)`, has the character `ζ ↦ ζ` of `x`. -/
private theorem exists_rescale_X_one_pow {K : Type w} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) :
    ∃ q' : ℕ, ∀ ζ : rootsOfUnity m K,
      MvPowerSeries.rescale (cyclicWeights K m q ζ) (MvPowerSeries.X 1 ^ q') =
        MvPowerSeries.C ((ζ : Kˣ) : K) * MvPowerSeries.X 1 ^ q' := by
  have hm : (m : ℤ) ≠ 0 := by have := h.one_le; omega
  set a := Int.gcdA q m
  have hg : (1 : ℤ) = q * a + m * Int.gcdB q m := by
    rw [← Int.gcd_eq_gcd_ab, h.gcd_eq_one, Nat.cast_one]
  set q' := (a % m).toNat
  have hq' : (q' : ℤ) = a - m * (a / m) := by
    rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hm), Int.emod_def]
  have hd : q * q' = 1 + m * (-(Int.gcdB q m + q * (a / m))) := by
    linear_combination q * hq' - hg
  refine ⟨q', fun ζ => ?_⟩
  classical
  have e : (ζ : Kˣ) ^ (q * q') = ζ := by
    rw [hd, zpow_add, zpow_one, zpow_mul, zpow_natCast, (mem_rootsOfUnity _ _).mp ζ.2,
      one_zpow, mul_one]
  ext n
  rw [MvPowerSeries.coeff_rescale, prod_cyclicWeights_pow, MvPowerSeries.coeff_C_mul,
    MvPowerSeries.coeff_X_pow]
  split_ifs with hn
  · subst hn
    simp [e]
  · simp

section CharacterClasses

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

/-- `f` is a semi-invariant of weight `w`: `ζ · f = ζ^w f`. -/
private def SemiInv (K : Type w) [Field K] (m : ℕ) (q : ℤ) (w : ℤ) (f : MvPowerSeries (Fin 2) K) :
    Prop :=
  ∀ ζ : rootsOfUnity m K, MvPowerSeries.rescale (cyclicWeights K m q ζ) f =
    MvPowerSeries.C ((((ζ : Kˣ) ^ w : Kˣ)) : K) * f

private theorem SemiInv.mul {w₁ w₂ : ℤ} {f g : MvPowerSeries (Fin 2) K} (hf : SemiInv K m q w₁ f)
    (hg : SemiInv K m q w₂ g) : SemiInv K m q (w₁ + w₂) (f * g) := fun ζ => by
  rw [map_mul, hf, hg, zpow_add, Units.val_mul, map_mul]; ring

private theorem SemiInv.pow {w : ℤ} {f : MvPowerSeries (Fin 2) K} (hf : SemiInv K m q w f) (n : ℕ) :
    SemiInv K m q (n * w) (f ^ n) := by
  induction n with
  | zero => intro ζ; simp
  | succ n ih =>
    have := ih.mul hf
    rw [pow_succ]; convert this using 1; push_cast; ring

private theorem semiInv_of_mem {f : MvPowerSeries (Fin 2) K} (hf : f ∈ cyclicInvariants K m q) :
    SemiInv K m q 0 f := fun ζ => by
  rw [(mem_cyclicInvariants_iff K m q f).mp hf ζ]; simp

private theorem SemiInv.congr {w w' : ℤ} (hw : (m : ℤ) ∣ w - w') {f : MvPowerSeries (Fin 2) K}
    (hf : SemiInv K m q w f) : SemiInv K m q w' f := fun ζ => by
  obtain ⟨k, hk⟩ := hw
  rw [hf, show w = w' + m * k by linarith, zpow_add, zpow_mul, zpow_natCast,
    (mem_rootsOfUnity _ _).mp ζ.2, one_zpow, mul_one]

private theorem SemiInv.mem {w : ℤ} (hw : (m : ℤ) ∣ w) {f : MvPowerSeries (Fin 2) K}
    (hf : SemiInv K m q w f) : f ∈ cyclicInvariants K m q := by
  refine (mem_cyclicInvariants_iff K m q f).mpr fun ζ => ?_
  rw [(hf.congr (w' := 0) (by simpa using hw)) ζ]; simp

private theorem SemiInv.cancel {w w₁ : ℤ} {f g : MvPowerSeries (Fin 2) K}
    (hfg : SemiInv K m q w (f * g)) (hf : SemiInv K m q w₁ f) (hf0 : f ≠ 0) :
    SemiInv K m q (w - w₁) g := fun ζ => by
  have h1 := hfg ζ
  rw [map_mul, hf] at h1
  apply mul_left_cancel₀ hf0
  have e : (((ζ : Kˣ) ^ w : Kˣ) : K) = (((ζ : Kˣ) ^ w₁ : Kˣ) : K) * (((ζ : Kˣ) ^ (w - w₁) : Kˣ) :
      K) := by
    rw [← Units.val_mul, ← zpow_add, add_sub_cancel]
  have hC : (MvPowerSeries.C ((((ζ : Kˣ) ^ w₁ : Kˣ)) : K) : MvPowerSeries (Fin 2) K) ≠ 0 := by
    rw [Ne, map_eq_zero_iff _ MvPowerSeries.C_injective]; exact Units.ne_zero _
  apply mul_left_cancel₀ hC
  calc MvPowerSeries.C ((((ζ : Kˣ) ^ w₁ : Kˣ)) : K) *
        (f * MvPowerSeries.rescale (cyclicWeights K m q ζ) g)
      = MvPowerSeries.C ((((ζ : Kˣ) ^ w : Kˣ)) : K) * (f * g) := by rw [← h1]; ring
    _ = _ := by rw [e, map_mul]; ring

private theorem semiInv_X_zero_pow (n : ℕ) : SemiInv K m q n (MvPowerSeries.X 0 ^ n) := fun ζ => by
  rw [rescale_X_zero_pow]; simp

private theorem semiInv_cyclicWeightComponent [NeZero m] (i : ZMod m) (f : MvPowerSeries (Fin 2)
    K) :
    SemiInv K m q ((i.val : ℕ) : ℤ) (cyclicWeightComponent K m q i f) := fun ζ => by
  rw [rescale_cyclicWeightComponent, zpow_natCast, Units.val_pow_eq_pow_val]

/-- A semi-invariant unit has trivial weight. -/
private theorem SemiInv.dvd_of_isUnit (h : IsCyclicQuotientSetting K m q) {w : ℤ}
    {u : MvPowerSeries (Fin 2) K} (hu : SemiInv K m q w u) (hunit : IsUnit u) : (m : ℤ) ∣ w := by
  obtain ⟨ζ', hζ'⟩ := exists_isPrimitiveRoot_rootsOfUnity h
  have h1 := congrArg (MvPowerSeries.coeff 0) (hu ζ')
  rw [MvPowerSeries.coeff_rescale, MvPowerSeries.coeff_C_mul] at h1
  have h0 : MvPowerSeries.coeff 0 u ≠ 0 := by
    rw [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
    exact (MvPowerSeries.isUnit_iff_constantCoeff.mp hunit).ne_zero
  simp only [Finsupp.prod_zero_index, one_mul] at h1
  have h2 : (((ζ' : Kˣ) ^ w : Kˣ) : K) = 1 := mul_right_cancel₀ h0 (h1.symm.trans (one_mul _).symm)
  exact (hζ'.zpow_eq_one_iff_dvd _).mp (Units.val_eq_one.mp h2)

/-- `ζ ↦ rescale ζ` is an action. -/
private theorem rescale_rescale_cyclic (ζ ξ : rootsOfUnity m K) (f : MvPowerSeries (Fin 2) K) :
    MvPowerSeries.rescale (cyclicWeights K m q ζ) (MvPowerSeries.rescale (cyclicWeights K m q ξ)
        f) =
      MvPowerSeries.rescale (cyclicWeights K m q (ζ * ξ)) f := by
  rw [MvPowerSeries.rescale_rescale, map_mul, mul_comm]

private theorem rescale_cyclic_one (f : MvPowerSeries (Fin 2) K) :
    MvPowerSeries.rescale (cyclicWeights K m q 1) f = f := by
  rw [map_one, MvPowerSeries.rescale_one, RingHom.id_apply]

private theorem rescale_cyclic_injective (ζ : rootsOfUnity m K) :
    Function.Injective (MvPowerSeries.rescale (cyclicWeights K m q ζ)) := fun f g hfg => by
  have := congrArg (MvPowerSeries.rescale (cyclicWeights K m q ζ⁻¹)) hfg
  rwa [rescale_rescale_cyclic, rescale_rescale_cyclic, inv_mul_cancel, rescale_cyclic_one,
    rescale_cyclic_one] at this

/-- The weight-`i` component is the twisted average `m⁻¹ ∑_ζ ζ^{-i} ζ · f`. -/
private theorem cyclicWeightComponent_eq_average (h : IsCyclicQuotientSetting K m q)
    [Fintype (rootsOfUnity m K)] [NeZero m] (i : ZMod m) (f : MvPowerSeries (Fin 2) K) :
    cyclicWeightComponent K m q i f = MvPowerSeries.C (m : K)⁻¹ *
      ∑ ζ : rootsOfUnity m K, MvPowerSeries.C ((((ζ : Kˣ) ^ (-((i.val : ℕ) : ℤ)) : Kˣ)) : K) *
        MvPowerSeries.rescale (cyclicWeights K m q ζ) f := by
  have := h.charZero
  have hm : (m : K) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne m)
  ext n
  rw [coeff_cyclicWeightComponent, MvPowerSeries.coeff_C_mul, map_sum]
  simp only [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_rescale, prod_cyclicWeights_pow]
  have hs : ∀ ζ : rootsOfUnity m K, (((ζ : Kˣ) ^ (-((i.val : ℕ) : ℤ)) : Kˣ) : K) *
      ((((ζ : Kˣ) ^ ((n 0 : ℤ) + q * n 1) : Kˣ) : K) * MvPowerSeries.coeff n f) =
      (((ζ : Kˣ) ^ ((n 0 : ℤ) + q * n 1 - ((i.val : ℕ) : ℤ)) : Kˣ) : K) *
        MvPowerSeries.coeff n f := fun ζ => by
    rw [← mul_assoc, ← Units.val_mul, ← zpow_add]; ring_nf
  simp only [hs, ← Finset.sum_mul, sum_rootsOfUnity_zpow h]
  have hiff : (((n 0 : ℤ) + q * n 1 : ℤ) : ZMod m) = i ↔
      (m : ℤ) ∣ (n 0 : ℤ) + q * n 1 - ((i.val : ℕ) : ℤ) := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_sub, sub_eq_zero]
    simp
  split_ifs with hw hd hd
  · rw [← mul_assoc, inv_mul_cancel₀ hm, one_mul]
  · exact absurd (hiff.mp hw) hd
  · exact absurd (hiff.mpr hd) hw
  · rw [zero_mul, mul_zero]

/-- **A semi-invariant generator.** If the principal ideal `(g)` is stable under `μ_m`, one of
the weight components of `g` generates it. -/
private theorem exists_cyclicWeightComponent_eq_mul_unit (h : IsCyclicQuotientSetting K m q)
    [NeZero m] {g : MvPowerSeries (Fin 2) K}
    (hg : ∀ ζ : rootsOfUnity m K, g ∣ MvPowerSeries.rescale (cyclicWeights K m q ζ) g)
    (hg0 : g ≠ 0) :
    ∃ (i : ZMod m) (v : MvPowerSeries (Fin 2) K), IsUnit v ∧
      cyclicWeightComponent K m q i g = g * v := by
  classical
  have := Fintype.ofFinite (rootsOfUnity m K)
  have hdvd : ∀ i : ZMod m, g ∣ cyclicWeightComponent K m q i g := fun i => by
    rw [cyclicWeightComponent_eq_average h]
    exact Dvd.dvd.mul_left (Finset.dvd_sum fun ζ _ => Dvd.dvd.mul_left (hg ζ) _) _
  choose c hc using hdvd
  have hsum : g * ∑ i : ZMod m, c i = g * 1 := by
    rw [Finset.mul_sum, mul_one]
    conv_rhs => rw [← sum_cyclicWeightComponent K m q g]
    exact Finset.sum_congr rfl fun i _ => (hc i).symm
  have h1 := mul_left_cancel₀ hg0 hsum
  by_contra hno
  push Not at hno
  have hmem : ∀ i : ZMod m, c i ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K) :=
    fun i => (IsLocalRing.mem_maximalIdeal _).mpr fun hu => hno i (c i) hu (hc i)
  have : (1 : MvPowerSeries (Fin 2) K) ∈ IsLocalRing.maximalIdeal _ :=
    h1 ▸ Ideal.sum_mem _ fun i _ => hmem i
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr this)

/-- **Uniformizer.** For `s ≠ 0` of weight `a` and `u` of weight `1`, `t = s u^{m - k}` with
`k ≡ a (mod m)` is invariant, and every invariant multiple `r` of `s` satisfies
`r u^m = t w` with `w` invariant. -/
private theorem uniformizer (h : IsCyclicQuotientSetting K m q) {a : ℤ}
    {s u : MvPowerSeries (Fin 2) K}
    (hs : SemiInv K m q a s) (hs0 : s ≠ 0) (hu : SemiInv K m q 1 u) :
    s * u ^ (m - (a % m).toNat) ∈ cyclicInvariants K m q ∧
      ∀ r : cyclicInvariants K m q, s ∣ (r : MvPowerSeries (Fin 2) K) →
        ∃ w : cyclicInvariants K m q, (r : MvPowerSeries (Fin 2) K) * u ^ m =
          s * u ^ (m - (a % m).toNat) * w := by
  have hm : (m : ℤ) ≠ 0 := by have := h.one_le; omega
  have hk0 : 0 ≤ a % m := Int.emod_nonneg _ hm
  have hkm : a % m < m := Int.emod_lt_of_pos _ (by have := h.one_le; omega)
  have hk : (((a % m).toNat : ℕ) : ℤ) = a % m := Int.toNat_of_nonneg hk0
  have hle : (a % m).toNat ≤ m := by omega
  refine ⟨?_, fun r ⟨b, hb⟩ => ?_⟩
  · refine (hs.mul (hu.pow _)).mem ?_
    rw [Nat.cast_sub hle, hk, mul_one]
    exact ⟨1 + a / m, by rw [Int.emod_def]; ring⟩
  · have hb' : SemiInv K m q (0 - a) b := (hb ▸ semiInv_of_mem r.2).cancel hs hs0
    have hw : b * u ^ (a % m).toNat ∈ cyclicInvariants K m q := by
      refine (hb'.mul (hu.pow _)).mem ?_
      rw [hk, mul_one]
      exact ⟨-(a / m), by rw [Int.emod_def]; ring⟩
    refine ⟨⟨_, hw⟩, ?_⟩
    change _ = _ * (b * u ^ (a % m).toNat)
    rw [hb]
    calc s * b * u ^ m = s * b * u ^ (m - (a % m).toNat + (a % m).toNat) := by
          rw [Nat.sub_add_cancel hle]
      _ = _ := by ring

private theorem prime_X_zero : Prime (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) := by
  let _ : IsDomain (MvPowerSeries (Fin 1) K) := NoZeroDivisors.to_isDomain _
  let e := MvPowerSeries.finSuccEquiv K 1
  apply (MulEquiv.prime_iff e.toMulEquiv).mp
  change Prime (MvPowerSeries.finSuccEquiv K 1 (MvPowerSeries.X 0))
  rw [MvPowerSeries.finSuccEquiv_X_zero]
  exact PowerSeries.X_prime

private theorem X_zero_not_dvd_X_one_pow (n : ℕ) :
    ¬ (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ∣ MvPowerSeries.X 1 ^ n := by
  classical
  rw [MvPowerSeries.X_dvd_iff]
  intro hd
  have := hd (Finsupp.single 1 n) (by simp)
  simp [MvPowerSeries.coeff_X_pow] at this

/-- In a Noetherian local domain of dimension two, a nonzero non-maximal prime has height
one. -/
private theorem height_eq_one_of_dim_two {S : Type*} [CommRing S] [IsDomain S] [IsLocalRing S]
    [IsNoetherianRing S] (hd : ringKrullDim S = 2) (P : Ideal S) [P.IsPrime] (h0 : P ≠ ⊥)
    (h1 : ¬ P.IsMaximal) : P.height = 1 := by
  have hlt : P < IsLocalRing.maximalIdeal S :=
    lt_of_le_of_ne (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›))
      (fun e => h1 (e ▸ IsLocalRing.maximalIdeal.isMaximal S))
  have h2 := Ideal.height_strict_mono_of_isPrime hlt
  have hm : (IsLocalRing.maximalIdeal S).height = 2 := by
    have := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := S)
    rw [hd] at this; exact WithBot.coe_injective (this.trans rfl)
  rw [hm] at h2
  have hne : P.height ≠ 0 := fun e => h0 (Ideal.height_eq_zero_iff_eq_bot.mp e)
  have hfin : P.height ≠ ⊤ := ne_top_of_lt h2
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hfin
  rw [← hn] at h2 hne ⊢
  have : n < 2 := by exact_mod_cast h2
  have : n ≠ 0 := by rintro rfl; exact hne rfl
  obtain rfl : n = 1 := by omega
  rfl

/-- The ideal `(x) ∩ R` of invariants divisible by `x`. -/
private noncomputable def xIdeal (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    Ideal (cyclicInvariants K m q) :=
  (Ideal.span {MvPowerSeries.X 0}).comap (cyclicInvariants K m q).subtype

private theorem mem_xIdeal {r : cyclicInvariants K m q} :
    r ∈ xIdeal K m q ↔ MvPowerSeries.X 0 ∣ (r : MvPowerSeries (Fin 2) K) := by
  rw [xIdeal, Ideal.mem_comap, Ideal.mem_span_singleton]; rfl

private theorem xIdeal_isPrime : (xIdeal K m q).IsPrime :=
  have : (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K)}).IsPrime :=
    (Ideal.span_singleton_prime prime_X_zero.ne_zero).mpr prime_X_zero
  Ideal.comap_isPrime _ _

attribute [local instance] xIdeal_isPrime

/-- **Radical criterion.** If `s ≠ 0` is semi-invariant and `s^m` lies in a prime `P'` of `R`,
then every invariant multiple of `s` lies in `P'`. -/
private theorem mem_of_dvd_of_pow_mem {a : ℤ}
    {s : MvPowerSeries (Fin 2) K} (hs : SemiInv K m q a s) (hs0 : s ≠ 0)
    (P' : Ideal (cyclicInvariants K m q)) [P'.IsPrime]
    (hsm : ∀ hmem : s ^ m ∈ cyclicInvariants K m q, (⟨_, hmem⟩ : cyclicInvariants K m q) ∈ P')
    (r : cyclicInvariants K m q) (hr : s ∣ (r : MvPowerSeries (Fin 2) K)) : r ∈ P' := by
  obtain ⟨b, hb⟩ := hr
  have hb' : SemiInv K m q (0 - a) b := (hb ▸ semiInv_of_mem r.2).cancel hs hs0
  have hsmem : s ^ m ∈ cyclicInvariants K m q := (hs.pow m).mem ⟨a, by ring⟩
  have hbmem : b ^ m ∈ cyclicInvariants K m q := (hb'.pow m).mem ⟨0 - a, by ring⟩
  have e : r ^ m = (⟨_, hsmem⟩ : cyclicInvariants K m q) * ⟨_, hbmem⟩ := by
    ext1; simp only [SubmonoidClass.coe_pow, Subring.coe_mul]; rw [hb, mul_pow]
  exact (‹P'.IsPrime›).mem_of_pow_mem m (e ▸ P'.mul_mem_right _ (hsm hsmem))

private theorem not_isMaximal_of_height_eq_one (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1) : ¬ P.IsMaximal := by
  have := isLocalRing_cyclicInvariants K m q
  intro hmax
  have e : P = IsLocalRing.maximalIdeal _ := IsLocalRing.eq_maximalIdeal hmax
  have h2 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := cyclicInvariants K m q)
  rw [← e, hP, ringKrullDim_cyclicInvariants h] at h2
  exact absurd h2 (by decide)

/-- The lcm of the twists of a nonzero series `π` by the cyclic action is nonzero, divides each
of its own twists, and divides an invariant exactly when `π` does. -/
private theorem exists_stable_lcm_rescale [NormalizedGCDMonoid (MvPowerSeries (Fin 2) K)]
    [Fintype (rootsOfUnity m K)] {π : MvPowerSeries (Fin 2) K} (hπ0 : π ≠ 0) :
    ∃ g : MvPowerSeries (Fin 2) K, g ≠ 0 ∧
      (∀ ξ : rootsOfUnity m K, g ∣ MvPowerSeries.rescale (cyclicWeights K m q ξ) g) ∧
      ∀ r : cyclicInvariants K m q,
        g ∣ (r : MvPowerSeries (Fin 2) K) ↔ π ∣ (r : MvPowerSeries (Fin 2) K) := by
  set g := (Finset.univ : Finset (rootsOfUnity m K)).lcm
    (fun ζ => MvPowerSeries.rescale (cyclicWeights K m q ζ) π) with hgdef
  refine ⟨g, ?_, fun ξ => ?_, fun r => ?_⟩
  · rw [hgdef, Ne, Finset.lcm_eq_zero_iff]
    rintro ⟨ζ, -, hζ⟩
    exact hπ0 (rescale_cyclic_injective ζ (hζ.trans (map_zero _).symm))
  · rw [hgdef, Finset.lcm_dvd_iff]
    intro ζ _
    have h1 : MvPowerSeries.rescale (cyclicWeights K m q (ξ⁻¹ * ζ)) π ∣ g :=
      Finset.dvd_lcm (Finset.mem_univ _)
    have h2 := map_dvd (MvPowerSeries.rescale (cyclicWeights K m q ξ)) h1
    rwa [rescale_rescale_cyclic, mul_inv_cancel_left] at h2
  · rw [Finset.lcm_dvd_iff]
    constructor
    · intro hd
      simpa [rescale_cyclic_one] using hd 1 (Finset.mem_univ _)
    · intro hd ζ _
      have := map_dvd (MvPowerSeries.rescale (cyclicWeights K m q ζ)) hd
      rwa [(mem_cyclicInvariants_iff K m q _).mp r.2 ζ] at this

/-- **A semi-invariant generator of a height-one prime.** Every height-one prime `P` of
`R = K[[x, y]]^{μ_m}` is the set of invariants divisible by a single semi-invariant `s ≠ 0`. -/
private theorem exists_semiInv_generator (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1) :
    ∃ (a : ℤ) (s : MvPowerSeries (Fin 2) K), SemiInv K m q a s ∧ s ≠ 0 ∧
      ∀ r : cyclicInvariants K m q, s ∣ (r : MvPowerSeries (Fin 2) K) ↔ r ∈ P := by
  classical
  have := neZero_of_isCyclicQuotientSetting h
  have := Fintype.ofFinite (rootsOfUnity m K)
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  have : UniqueFactorizationMonoid (MvPowerSeries (Fin 2) K) :=
    IsRegularLocalRing.uniqueFactorizationMonoid _
  have := module_finite_cyclicInvariants h
  have hdimA : ringKrullDim (MvPowerSeries (Fin 2) K) = 2 := by
    rw [MvPowerSeries.ringKrullDim_eq]; rfl
  let _ : NormalizationMonoid (MvPowerSeries (Fin 2) K) :=
    UniqueFactorizationMonoid.strongNormalizationMonoid.toNormalizationMonoid
  let _ := UniqueFactorizationMonoid.toNormalizedGCDMonoid (MvPowerSeries (Fin 2) K)
  have hP0 : P ≠ ⊥ := Ideal.ne_bot_of_height_eq_one hP
  have hPmax := not_isMaximal_of_height_eq_one h P hP
  obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P
    (⊥ : Ideal (MvPowerSeries (Fin 2) K)) (by simp)
  have hQ0 : Q ≠ ⊥ := by
    rintro rfl
    apply hP0
    rw [← hQP]
    exact Ideal.comap_bot_of_injective _ Subtype.val_injective
  have hQmax : ¬ Q.IsMaximal := fun hm =>
    hPmax (hQP ▸ Ideal.isMaximal_under_of_isIntegral_of_isMaximal Q)
  have hQh := height_eq_one_of_dim_two hdimA Q hQ0 hQmax
  obtain ⟨π, hπ⟩ := (UniqueFactorizationMonoid.isPrincipal_of_height_eq_one hQh).principal
  have hmemQ : ∀ f, f ∈ Q ↔ π ∣ f := fun f => by
    rw [hπ, Submodule.mem_span_singleton]
    constructor
    · rintro ⟨c, rfl⟩; exact Dvd.intro_left _ (smul_eq_mul c π).symm
    · rintro ⟨c, rfl⟩; exact ⟨c, by rw [smul_eq_mul, mul_comm]⟩
  have hmemP : ∀ r : cyclicInvariants K m q, r ∈ P ↔ π ∣ (r : MvPowerSeries (Fin 2) K) :=
    fun r => by rw [← hQP, Ideal.mem_comap, hmemQ]; rfl
  have hπ0 : π ≠ 0 := by
    rintro rfl
    apply hQ0
    rw [hπ]; simp
  obtain ⟨g, hg0, hgst, hgr⟩ := exists_stable_lcm_rescale (m := m) (q := q) hπ0
  obtain ⟨i, v, hv, hiv⟩ := exists_cyclicWeightComponent_eq_mul_unit h hgst hg0
  refine ⟨_, _, semiInv_cyclicWeightComponent i g, ?_, fun r => ?_⟩
  · rw [hiv]; exact mul_ne_zero hg0 hv.ne_zero
  · rw [hiv, hv.mul_right_dvd, hmemP]
    exact hgr r

/-- **Local parameter.** For a height-one prime `P` cut out by divisibility by a semi-invariant
`s` of weight `a`, and a semi-invariant `u` of weight `1` with `u^m ∉ P`, the invariant
`t = s u^{m-k}` lies in `P` and generates `P R_P`, and `t^m = s^m (u^m)^{m-k}`. -/
private theorem exists_localParameter (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] {a : ℤ} {s u : MvPowerSeries (Fin 2) K}
    (hs : SemiInv K m q a s) (hs0 : s ≠ 0)
    (hsP : ∀ r : cyclicInvariants K m q, s ∣ (r : MvPowerSeries (Fin 2) K) ↔ r ∈ P)
    (hu : SemiInv K m q 1 u)
    (huP : (⟨u ^ m, (hu.pow m).mem ⟨1, by ring⟩⟩ : cyclicInvariants K m q) ∉ P) :
    ∃ t : cyclicInvariants K m q, (t : MvPowerSeries (Fin 2) K) = s * u ^ (m - (a % m).toNat) ∧
      t ∈ P ∧ (∀ r ∈ P, ∃ w d : cyclicInvariants K m q, d ∉ P ∧ r * d = t * w) ∧
      (∀ hsm : s ^ m ∈ cyclicInvariants K m q,
        t ^ m = ⟨_, hsm⟩ * ⟨u ^ m, (hu.pow m).mem ⟨1, by ring⟩⟩ ^ (m - (a % m).toNat)) := by
  obtain ⟨ht, hgen⟩ := uniformizer h hs hs0 hu
  refine ⟨⟨_, ht⟩, rfl, (hsP _).mp (Dvd.intro _ rfl), fun r hr => ?_, fun hsm => ?_⟩
  · obtain ⟨w, hw⟩ := hgen r ((hsP r).mpr hr)
    exact ⟨w, _, huP, Subtype.ext (by simpa using hw)⟩
  · ext1
    simp only [SubmonoidClass.coe_pow, Subring.coe_mul]
    rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm m]

section Geometry

section Affine

variable {R : CommRingCat.{w}}

variable [IsDomain R]

private theorem algebraMap_stalk_functionField (x : Spec R) (r : R) :
    letI : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
    algebraMap ((Spec R).presheaf.stalk x) (Spec R).functionField
      (algebraMap R _ r) = algebraMap R (Spec R).functionField r := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  exact StructureSheaf.toStalk_stalkSpecializes_apply
    ((genericPoint_spec (Spec R)).specializes (Set.mem_univ x)) r

private theorem ord_algebraMap_eq_zero [IsNoetherianRing R] (x : Spec R) {r : R}
    (hr : r ∉ (x : PrimeSpectrum R).asIdeal) :
    Scheme.ord (algebraMap R (Spec R).functionField r) x = 0 := by
  by_cases hx : coheight x = 1
  · let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
    have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) (x : PrimeSpectrum R).asIdeal :=
      StructureSheaf.IsLocalization.to_stalk R x
    have hr0 : r ≠ 0 := fun h => hr (h ▸ Ideal.zero_mem _)
    have hne : algebraMap R (Spec R).functionField r ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective R _)).mpr hr0
    rw [Scheme.ord_eq_iff hx hne, ← algebraMap_stalk_functionField]
    have : Ring.KrullDimLE 1 ((Spec R).presheaf.stalk x) := krullDimLE_of_coheight_le hx.le
    exact Ring.ordFrac_of_isUnit (IsLocalization.map_units _
      (⟨r, hr⟩ : (x : PrimeSpectrum R).asIdeal.primeCompl))
  · exact Scheme.ord_eq_zero_of_coheight_neq_one hx _

private theorem ord_algebraMap_eq_one [IsNoetherianRing R] [IsNormal (Spec R)] (x : Spec R)
    (hx : coheight x = 1) {t : R} (ht : t ∈ (x : PrimeSpectrum R).asIdeal)
    (hgen : ∀ r ∈ (x : PrimeSpectrum R).asIdeal, ∃ w d : R,
      d ∉ (x : PrimeSpectrum R).asIdeal ∧ r * d = t * w) :
    Scheme.ord (algebraMap R (Spec R).functionField t) x = 1 := by
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) (x : PrimeSpectrum R).asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  have := Stacks.AlgebraicGeometry.UnitsNormalProper.isDiscreteValuationRing_stalk hx
  rw [← algebraMap_stalk_functionField]
  have key := ord_algebraMap_eq_of_span_eq_maximalIdeal_pow x hx
    (algebraMap R ((Spec R).presheaf.stalk x) t) 1 ?_
  · exact_mod_cast key
  rw [pow_one, ← IsLocalization.AtPrime.map_eq_maximalIdeal (x : PrimeSpectrum R).asIdeal]
  apply le_antisymm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ ht
  · rw [Ideal.map_le_iff_le_comap]
    intro r hr
    obtain ⟨w, d, hd, hrd⟩ := hgen r hr
    rw [Ideal.mem_comap, Ideal.mem_span_singleton]
    have hu := IsLocalization.map_units ((Spec R).presheaf.stalk x)
      (⟨d, hd⟩ : (x : PrimeSpectrum R).asIdeal.primeCompl)
    refine ⟨algebraMap R _ w * hu.unit⁻¹, ?_⟩
    rw [← mul_assoc, ← map_mul, ← hrd, map_mul, mul_assoc]
    change _ = _ * (hu.unit * hu.unit⁻¹ : (_ : Type w)ˣ).val
    simp

private theorem exists_eq_germ_top (s : Γ(Spec R, ⊤)) :
    ∃ r : R, (Spec R).presheaf.germ ⊤ (genericPoint _) trivial s =
      algebraMap R (Spec R).functionField r := by
  obtain ⟨r, rfl⟩ : ∃ r, (Scheme.ΓSpecIso R).inv r = s :=
    ⟨(Scheme.ΓSpecIso R).hom s, by simp⟩
  refine ⟨r, ?_⟩
  rw [Scheme.ΓSpecIso_inv]
  exact StructureSheaf.algebraMap_germ_apply _ _ _ _

end Affine

section Divisors

variable {X : Scheme.{w}} [IsIntegral X] [IsLocallyNoetherian X]

private theorem ord_pow {f : X.functionField} (hf : f ≠ 0) (n : ℕ) (x : X) :
    Scheme.ord (f ^ n) x = n * Scheme.ord f x := by
  simpa using MMP.Mori.ord_zpow x hf n

private theorem ord_div {f g : X.functionField} (hf : f ≠ 0) (hg : g ≠ 0) (x : X) :
    Scheme.ord (f / g) x = Scheme.ord f x - Scheme.ord g x := by
  rw [div_eq_mul_inv, Scheme.ord_mul hf (inv_ne_zero hg), ← zpow_neg_one, MMP.Mori.ord_zpow _ hg]
  ring

end Divisors

end Geometry

section Assembly

/-- `R` as a commutative ring, kept opaque so that instances on `Spec R` are found. -/
private noncomputable def ringCat (K : Type w) [Field K] (m : ℕ) (q : ℤ) : CommRingCat.{w} :=
  CommRingCat.of (cyclicInvariants K m q)

private instance isDomain_cyclicInvariants (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    IsDomain (cyclicInvariants K m q) :=
  NoZeroDivisors.to_isDomain _

private instance isDomain_ringCat (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    IsDomain (ringCat K m q) :=
  isDomain_cyclicInvariants K m q

/-- The point of `Spec R` at a prime of `R`. -/
private def ptOf (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] : Spec (ringCat K m q) :=
  (⟨P, inferInstance⟩ : PrimeSpectrum (cyclicInvariants K m q))

/-- The prime of `R` at a point of `Spec R`. -/
private def idealOf (y : Spec (ringCat K m q)) : Ideal (cyclicInvariants K m q) :=
  (y : PrimeSpectrum (ringCat K m q)).asIdeal

private theorem idealOf_isPrime (y : Spec (ringCat K m q)) : (idealOf y).IsPrime :=
  (y : PrimeSpectrum (ringCat K m q)).isPrime

attribute [local instance] idealOf_isPrime

private theorem ptOf_idealOf (y : Spec (ringCat K m q)) : ptOf (idealOf y) = y := rfl

private theorem ptOf_congr {P P' : Ideal (cyclicInvariants K m q)} [P.IsPrime] [P'.IsPrime]
    (e : P = P') : ptOf P = ptOf P' := by subst e; rfl

/-- `x^m` as an invariant. -/
private noncomputable def xm (h : IsCyclicQuotientSetting K m q) : cyclicInvariants K m q :=
  ⟨_, X_pow_mem_cyclicInvariants h 0⟩

private theorem semiInv_X_zero : SemiInv K m q 1 (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) := by
  simpa using semiInv_X_zero_pow (K := K) (m := m) (q := q) 1

private theorem xm_ne_zero (h : IsCyclicQuotientSetting K m q) : xm h ≠ 0 := fun e => by
  have := congrArg Subtype.val e
  exact pow_ne_zero m (X_ne_zero K 0) this

private theorem height_xIdeal (h : IsCyclicQuotientSetting K m q)
    [IsDomain (cyclicInvariants K m q)] [IsNoetherianRing (cyclicInvariants K m q)] :
    (xIdeal K m q).height = 1 := by
  have := isLocalRing_cyclicInvariants K m q
  refine height_eq_one_of_dim_two (ringKrullDim_cyclicInvariants h) _ ?_ ?_
  · intro e
    have : xm h ∈ xIdeal K m q := mem_xIdeal.mpr (dvd_pow_self _ (by have := h.one_le; omega))
    rw [e, Ideal.mem_bot] at this
    exact xm_ne_zero h this
  · intro hmax
    set ym : cyclicInvariants K m q := ⟨_, X_pow_mem_cyclicInvariants h 1⟩
    have hym : ym ∈ IsLocalRing.maximalIdeal _ := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map (cyclicInvariants K m q).subtype
      have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu'
      have hm1 : m ≠ 0 := by have := h.one_le; omega
      simp [ym, hm1] at this
    rw [← IsLocalRing.eq_maximalIdeal hmax, mem_xIdeal] at hym
    exact X_zero_not_dvd_X_one_pow m hym

private theorem eq_xIdeal_of_xm_mem (h : IsCyclicQuotientSetting K m q)
    [IsDomain (cyclicInvariants K m q)] [IsNoetherianRing (cyclicInvariants K m q)]
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1) (hx : xm h ∈ P) :
    P = xIdeal K m q := by
  have hle : xIdeal K m q ≤ P := fun r hr =>
    mem_of_dvd_of_pow_mem semiInv_X_zero (X_ne_zero K 0) P (fun _ => hx) r (mem_xIdeal.mp hr)
  exact (Ideal.eq_of_le_of_height_le _ hle (hP.trans (height_xIdeal h).symm).le).symm

variable [IsNoetherianRing (cyclicInvariants K m q)]

private theorem isNoetherianRing_ringCat : IsNoetherianRing (ringCat K m q) :=
  ‹IsNoetherianRing (cyclicInvariants K m q)›

attribute [local instance] isNoetherianRing_ringCat

private theorem isNormal_spec (h : IsCyclicQuotientSetting K m q) :
    IsNormal (Spec (ringCat K m q)) := by
  have : IsIntegrallyClosed (cyclicInvariants K m q) := isIntegrallyClosed_cyclicInvariants
  exact isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed _)

private theorem height_idealOf {y : Spec (ringCat K m q)} (hy : coheight y = 1) :
    (idealOf y).height = 1 :=
  (AlgebraicGeometry.idealHeight_eq_coheight _ y).trans hy

private theorem coheight_ptOf {P : Ideal (cyclicInvariants K m q)} [P.IsPrime] (hP : P.height = 1) :
    coheight (ptOf P) = 1 :=
  (AlgebraicGeometry.idealHeight_eq_coheight _ (ptOf P)).symm.trans hP

/-- The function field of `Spec R` as a field of fractions of `R`. -/
private noncomputable def toFF (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    cyclicInvariants K m q →+* (Spec (ringCat K m q)).functionField :=
  algebraMap (ringCat K m q) (Spec (ringCat K m q)).functionField

private theorem toFF_injective : Function.Injective (toFF K m q) :=
  IsFractionRing.injective (ringCat K m q) (Spec (ringCat K m q)).functionField

private theorem toFF_ne_zero {r : cyclicInvariants K m q} (hr : r ≠ 0) : toFF K m q r ≠ 0 :=
  (map_ne_zero_iff _ toFF_injective).mpr hr

private theorem ord_toFF_eq_zero (P : Ideal (cyclicInvariants K m q)) [P.IsPrime]
    {r : cyclicInvariants K m q} (hr : r ∉ P) :
    Scheme.ord (toFF K m q r) (ptOf P) = 0 :=
  ord_algebraMap_eq_zero (R := ringCat K m q) (ptOf P) hr

private theorem ord_toFF_eq_one (h : IsCyclicQuotientSetting K m q) (P : Ideal (cyclicInvariants K
    m q))
    [P.IsPrime] (hP : P.height = 1) {t : cyclicInvariants K m q} (ht : t ∈ P)
    (hgen : ∀ r ∈ P, ∃ w d : cyclicInvariants K m q, d ∉ P ∧ r * d = t * w) :
    Scheme.ord (toFF K m q t) (ptOf P) = 1 :=
  have := isNormal_spec h
  ord_algebraMap_eq_one (R := ringCat K m q) (ptOf P) (coheight_ptOf hP) ht hgen

/-- **The order of a boundary equation.** If `t` is a local parameter at the height-one prime `P`
and `t^m = s u^k` with `u ∉ P`, then `s` has order `m` at `P`. -/
private theorem ord_eq_of_pow_eq_mul (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1)
    {t s u : cyclicInvariants K m q} (htP : t ∈ P)
    (hgen : ∀ r ∈ P, ∃ w d : cyclicInvariants K m q, d ∉ P ∧ r * d = t * w) (huP : u ∉ P)
    (hs0 : s ≠ 0) {k : ℕ} (hpow : t ^ m = s * u ^ k) :
    Scheme.ord (toFF K m q s) (ptOf P) = m := by
  have hu0 : u ≠ 0 := fun e => huP (e ▸ P.zero_mem)
  have ht0 : t ≠ 0 := by
    rintro rfl
    rw [zero_pow (by have := h.one_le; omega)] at hpow
    exact mul_ne_zero hs0 (pow_ne_zero _ hu0) hpow.symm
  have key := congrArg (fun r => Scheme.ord (toFF K m q r) (ptOf P)) hpow
  simp only [map_mul, map_pow] at key
  rw [ord_pow (toFF_ne_zero ht0), Scheme.ord_mul (toFF_ne_zero hs0)
    (pow_ne_zero _ (toFF_ne_zero hu0)), ord_pow (toFF_ne_zero hu0),
    ord_toFF_eq_one h P hP htP hgen, ord_toFF_eq_zero P huP] at key
  linarith

/-- `C = (x = 0)` has a local parameter `t` with `t^m = x^m u^k` for an invariant `u ∉ C`. -/
private theorem exists_localParameter_xIdeal (h : IsCyclicQuotientSetting K m q) :
    ∃ t ∈ xIdeal K m q, (∀ r ∈ xIdeal K m q, ∃ w d : cyclicInvariants K m q,
      d ∉ xIdeal K m q ∧ r * d = t * w) ∧
      ∃ u ∉ xIdeal K m q, ∃ k : ℕ, t ^ m = xm h * u ^ k := by
  obtain ⟨q', hq'⟩ := exists_rescale_X_one_pow h
  have hu : SemiInv K m q 1 (MvPowerSeries.X 1 ^ q' : MvPowerSeries (Fin 2) K) := fun ζ => by
    rw [hq' ζ]; simp
  have huP : (⟨(MvPowerSeries.X 1 ^ q') ^ m, (hu.pow m).mem ⟨1, by ring⟩⟩ :
      cyclicInvariants K m q) ∉ xIdeal K m q := by
    rw [mem_xIdeal]; simp only; rw [← pow_mul]; exact X_zero_not_dvd_X_one_pow _
  obtain ⟨t, -, htP, hgen, hpow⟩ := exists_localParameter h (xIdeal K m q) semiInv_X_zero
    (X_ne_zero K 0) (fun r => mem_xIdeal.symm) hu huP
  exact ⟨t, htP, hgen, _, huP, _, hpow (X_pow_mem_cyclicInvariants h 0)⟩

/-- `ord_C(x^m) = m`. -/
private theorem ord_xm_ptOf_xIdeal (h : IsCyclicQuotientSetting K m q) :
    Scheme.ord (toFF K m q (xm h)) (ptOf (xIdeal K m q)) = m := by
  obtain ⟨t, htP, hgen, u, huP, k, hpow⟩ := exists_localParameter_xIdeal h
  exact ord_eq_of_pow_eq_mul h _ (height_xIdeal h) htP hgen huP (xm_ne_zero h) hpow

/-- Away from `C`, `x^m` has order zero. -/
private theorem ord_xm_eq_zero (h : IsCyclicQuotientSetting K m q) (P : Ideal (cyclicInvariants K
    m q))
    [P.IsPrime] (hP : P.height = 1) (hPx : P ≠ xIdeal K m q) :
    Scheme.ord (toFF K m q (xm h)) (ptOf P) = 0 := by
  exact ord_toFF_eq_zero P fun hx => hPx (eq_xIdeal_of_xm_mem h P hP hx)

/-- **A local equation away from `C`.** For a height-one prime `P ≠ (x) ∩ R` there is an
invariant of order one at `P` and of order zero at every other height-one prime but `(x) ∩ R`. -/
private theorem exists_local_equation (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1)
    (hPx : P ≠ xIdeal K m q) :
    ∃ t : cyclicInvariants K m q, t ≠ 0 ∧ Scheme.ord (toFF K m q t) (ptOf P) = 1 ∧
      ∀ (P' : Ideal (cyclicInvariants K m q)) [P'.IsPrime], P'.height = 1 → P' ≠ P →
        P' ≠ xIdeal K m q → Scheme.ord (toFF K m q t) (ptOf P') = 0 := by
  obtain ⟨a, s, hs, hs0, hsP⟩ := exists_semiInv_generator h P hP
  have huP : (⟨MvPowerSeries.X 0 ^ m, (semiInv_X_zero.pow m).mem ⟨1, by ring⟩⟩ :
      cyclicInvariants K m q) ∉ P := fun hx => hPx (eq_xIdeal_of_xm_mem h P hP hx)
  obtain ⟨t, htv, htP, hgen, -⟩ := exists_localParameter h P hs hs0 hsP semiInv_X_zero huP
  have ht0 : t ≠ 0 := fun e => by
    have := congrArg Subtype.val e
    rw [htv] at this
    exact mul_ne_zero hs0 (pow_ne_zero _ (X_ne_zero K 0)) this
  refine ⟨t, ht0, ord_toFF_eq_one h P hP htP hgen, fun P' _ hP' hne hnx => ?_⟩
  refine ord_toFF_eq_zero P' fun htP' => ?_
  have hsm : s ^ m ∈ cyclicInvariants K m q := (hs.pow m).mem ⟨a, by ring⟩
  have hm0 : m ≠ 0 := by have := h.one_le; omega
  have e : t ^ m = (⟨_, hsm⟩ : cyclicInvariants K m q) *
      ⟨MvPowerSeries.X 0 ^ m, (semiInv_X_zero.pow m).mem ⟨1, by ring⟩⟩ ^ (m - (a % m).toNat) := by
    ext1; simp only [SubmonoidClass.coe_pow, Subring.coe_mul, htv]
    rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm m]
  have htm : t ^ m ∈ P' := P'.pow_mem_of_mem htP' m (Nat.pos_of_ne_zero hm0)
  rw [e] at htm
  rcases (‹P'.IsPrime›).mem_or_mem htm with hs' | hx'
  · exact hne (Ideal.eq_of_le_of_height_le _ (fun r hr =>
      mem_of_dvd_of_pow_mem hs hs0 P' (fun _ => hs') r ((hsP r).mpr hr))
      (hP'.trans hP.symm).le).symm
  · exact hnx (eq_xIdeal_of_xm_mem h P' hP' ((‹P'.IsPrime›).mem_of_pow_mem _ hx'))

end Assembly

section ClassGroup

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat

variable [IsNoetherianRing (cyclicInvariants K m q)]

private theorem coheight_ptOf_xIdeal (h : IsCyclicQuotientSetting K m q) :
    coheight (ptOf (xIdeal K m q)) = 1 :=
  coheight_ptOf (height_xIdeal h)

private theorem toFF_div_surjective (z : (Spec (ringCat K m q)).functionField) :
    ∃ a b : cyclicInvariants K m q, b ≠ 0 ∧ toFF K m q a / toFF K m q b = z := by
  obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (ringCat K m q) z
  exact ⟨a, b, nonZeroDivisors.ne_zero hb, hab⟩

private theorem exists_toFF_eq_germ_top (s : Γ(Spec (ringCat K m q), ⊤)) :
    ∃ r : cyclicInvariants K m q,
      (Spec (ringCat K m q)).presheaf.germ ⊤ (genericPoint _) trivial s = toFF K m q r := by
  obtain ⟨r, hr⟩ := exists_eq_germ_top (R := ringCat K m q) s
  exact ⟨r, hr⟩

/-- The prime divisor `C = (x = 0)` of `Spec R`. -/
private noncomputable def primeC (h : IsCyclicQuotientSetting K m q) :
    PrimeDivisor (Spec (ringCat K m q)) :=
  PrimeDivisor.ofCoheightOne (ptOf (xIdeal K m q)) (coheight_ptOf_xIdeal h)

private theorem genericPoint_primeC (h : IsCyclicQuotientSetting K m q) :
    (primeC h).genericPoint = ptOf (xIdeal K m q) :=
  PrimeDivisor.genericPoint_ofCoheightOne _ _

private theorem ne_xIdeal_of_ne (h : IsCyclicQuotientSetting K m q)
    {W : PrimeDivisor (Spec (ringCat K m q))}
    (hW : W ≠ primeC h) : idealOf W.genericPoint ≠ xIdeal K m q := fun e =>
  hW (PrimeDivisor.genericPoint_injective (by
    rw [genericPoint_primeC, ← ptOf_idealOf W.genericPoint]; exact ptOf_congr e))

end ClassGroup

section Generation

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat

variable [IsNoetherianRing (cyclicInvariants K m q)]

/-- The closure of the generic point of `(X i = 0) ∩ R` is the image of `(X i = 0)`. -/
private theorem closure_ptOf_eq_cyclicQuotientImage (h : IsCyclicQuotientSetting K m q)
    (i : Fin 2) (hX : Prime (MvPowerSeries.X i : MvPowerSeries (Fin 2) K))
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime]
    (hPdef : P = (Ideal.span {MvPowerSeries.X i}).comap (cyclicInvariants K m q).subtype) :
    (TopologicalSpace.Closeds.closure {ptOf P} : TopologicalSpace.Closeds (Spec (ringCat K m q))) =
      cyclicQuotientImage h (MvPowerSeries.X i) := by
  have hP0 : (Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin 2) K)}).IsPrime :=
    (Ideal.span_singleton_prime hX.ne_zero).mpr hX
  apply TopologicalSpace.Closeds.ext
  change closure ({ptOf P} : Set (Spec (ringCat K m q))) =
    closure ((cyclicQuotientMap h).base '' (PrimeSpectrum.zeroLocus {MvPowerSeries.X i} :
      Set (PrimeSpectrum (MvPowerSeries (Fin 2) K))))
  have hsub : (cyclicQuotientMap h).base '' (PrimeSpectrum.zeroLocus {MvPowerSeries.X i} :
      Set (PrimeSpectrum (MvPowerSeries (Fin 2) K))) ⊆
        closure ({ptOf P} : Set (Spec (ringCat K m q))) := by
    rintro _ ⟨Q, hQ, rfl⟩
    change PrimeSpectrum.comap (cyclicInvariants K m q).subtype Q ∈
      closure ({(⟨P, inferInstance⟩ : PrimeSpectrum (cyclicInvariants K m q))} : Set _)
    rw [← PrimeSpectrum.le_iff_mem_closure]
    intro r hr
    have hr' : r ∈ P := hr
    rw [hPdef, Ideal.mem_comap, Ideal.mem_span_singleton] at hr'
    obtain ⟨b, hb⟩ := hr'
    change (cyclicInvariants K m q).subtype r ∈ Q.asIdeal
    rw [hb]; exact Q.asIdeal.mul_mem_right _ (hQ (Set.mem_singleton _))
  have hpt : ptOf P ∈ (cyclicQuotientMap h).base ''
      (PrimeSpectrum.zeroLocus {MvPowerSeries.X i} :
        Set (PrimeSpectrum (MvPowerSeries (Fin 2) K))) := by
    refine ⟨⟨_, hP0⟩, fun _ hx => ?_, ?_⟩
    · rw [Set.mem_singleton_iff.mp hx]; exact Ideal.subset_span rfl
    · exact PrimeSpectrum.ext hPdef.symm
  exact le_antisymm (closure_mono (Set.singleton_subset_iff.mpr hpt))
    (closure_minimal hsub isClosed_closure)

end Generation

/-! ### The second boundary curve `(y = 0)` -/

section SecondBoundary

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat

private theorem prime_X_one : Prime (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) := by
  let e := MvPowerSeries.renameEquiv K (Equiv.swap (0 : Fin 2) 1)
  have he : e (MvPowerSeries.X 0) = MvPowerSeries.X 1 := by
    simp [e, MvPowerSeries.renameEquiv, MvPowerSeries.rename_X]
  rw [← he]
  exact (MulEquiv.prime_iff e.toMulEquiv).mpr prime_X_zero

private theorem X_one_not_dvd_X_zero_pow (n : ℕ) :
    ¬ (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣ MvPowerSeries.X 0 ^ n := by
  classical
  rw [MvPowerSeries.X_dvd_iff]
  intro hd
  have := hd (Finsupp.single 0 n) (by simp)
  simp [MvPowerSeries.coeff_X_pow] at this

private theorem semiInv_X_one : SemiInv K m q q (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) :=
    fun ζ => by
  classical
  ext n
  rw [MvPowerSeries.coeff_rescale, prod_cyclicWeights_pow, MvPowerSeries.coeff_C_mul,
    MvPowerSeries.coeff_X]
  split_ifs with hn
  · subst hn; simp
  · simp

/-- The ideal `(y) ∩ R` of invariants divisible by `y`. -/
private noncomputable def yIdeal (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    Ideal (cyclicInvariants K m q) :=
  (Ideal.span {MvPowerSeries.X 1}).comap (cyclicInvariants K m q).subtype

private theorem mem_yIdeal {r : cyclicInvariants K m q} :
    r ∈ yIdeal K m q ↔ MvPowerSeries.X 1 ∣ (r : MvPowerSeries (Fin 2) K) := by
  rw [yIdeal, Ideal.mem_comap, Ideal.mem_span_singleton]; rfl

private theorem yIdeal_isPrime : (yIdeal K m q).IsPrime :=
  have : (Ideal.span {(MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}).IsPrime :=
    (Ideal.span_singleton_prime prime_X_one.ne_zero).mpr prime_X_one
  Ideal.comap_isPrime _ _

attribute [local instance] yIdeal_isPrime

/-- `y^m` as an invariant. -/
private noncomputable def ym (h : IsCyclicQuotientSetting K m q) : cyclicInvariants K m q :=
  ⟨_, X_pow_mem_cyclicInvariants h 1⟩

private theorem ym_ne_zero (h : IsCyclicQuotientSetting K m q) : ym h ≠ 0 := fun e =>
  pow_ne_zero m (X_ne_zero K 1) (congrArg Subtype.val e)

private theorem height_yIdeal (h : IsCyclicQuotientSetting K m q)
    [IsDomain (cyclicInvariants K m q)] [IsNoetherianRing (cyclicInvariants K m q)] :
    (yIdeal K m q).height = 1 := by
  have := isLocalRing_cyclicInvariants K m q
  refine height_eq_one_of_dim_two (ringKrullDim_cyclicInvariants h) _ ?_ ?_
  · intro e
    have : ym h ∈ yIdeal K m q := mem_yIdeal.mpr (dvd_pow_self _ (by have := h.one_le; omega))
    rw [e, Ideal.mem_bot] at this
    exact ym_ne_zero h this
  · intro hmax
    have hxm : xm h ∈ IsLocalRing.maximalIdeal _ := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map (cyclicInvariants K m q).subtype
      have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu'
      have hm1 : m ≠ 0 := by have := h.one_le; omega
      simp [xm, hm1] at this
    rw [← IsLocalRing.eq_maximalIdeal hmax, mem_yIdeal] at hxm
    exact X_one_not_dvd_X_zero_pow m hxm

private theorem eq_yIdeal_of_ym_mem (h : IsCyclicQuotientSetting K m q)
    [IsDomain (cyclicInvariants K m q)] [IsNoetherianRing (cyclicInvariants K m q)]
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1) (hy : ym h ∈ P) :
    P = yIdeal K m q := by
  have hle : yIdeal K m q ≤ P := fun r hr =>
    mem_of_dvd_of_pow_mem semiInv_X_one (X_ne_zero K 1) P (fun _ => hy) r (mem_yIdeal.mp hr)
  exact (Ideal.eq_of_le_of_height_le _ hle (hP.trans (height_yIdeal h).symm).le).symm

private theorem xIdeal_ne_yIdeal (h : IsCyclicQuotientSetting K m q) :
    xIdeal K m q ≠ yIdeal K m q := fun e => by
  have : xm h ∈ yIdeal K m q := e ▸ mem_xIdeal.mpr (dvd_pow_self _ (by have := h.one_le; omega))
  exact X_one_not_dvd_X_zero_pow m (mem_yIdeal.mp this)

variable [IsNoetherianRing (cyclicInvariants K m q)]

private theorem coheight_ptOf_yIdeal (h : IsCyclicQuotientSetting K m q) :
    coheight (ptOf (yIdeal K m q)) = 1 :=
  coheight_ptOf (height_yIdeal h)

/-- The prime divisor `(y = 0)` of `Spec R`. -/
private noncomputable def primeC' (h : IsCyclicQuotientSetting K m q) :
    PrimeDivisor (Spec (ringCat K m q)) :=
  PrimeDivisor.ofCoheightOne (ptOf (yIdeal K m q)) (coheight_ptOf_yIdeal h)

private theorem genericPoint_primeC' (h : IsCyclicQuotientSetting K m q) :
    (primeC' h).genericPoint = ptOf (yIdeal K m q) :=
  PrimeDivisor.genericPoint_ofCoheightOne _ _

private theorem primeC_ne_primeC' (h : IsCyclicQuotientSetting K m q) : primeC h ≠ primeC' h :=
    fun e => by
  have := congrArg PrimeDivisor.genericPoint e
  rw [genericPoint_primeC, genericPoint_primeC'] at this
  exact xIdeal_ne_yIdeal h (congrArg idealOf this)

/-- The image of `(xy = 0)` is the union of the images of `(x = 0)` and `(y = 0)`. -/
private theorem coe_cyclicQuotientImage_mul (h : IsCyclicQuotientSetting K m q) :
    (cyclicQuotientImage h (MvPowerSeries.X 0 * MvPowerSeries.X 1) :
        Set (cyclicQuotientModel K m q h)) =
      (cyclicQuotientImage h (MvPowerSeries.X 0) : Set (cyclicQuotientModel K m q h)) ∪
        (cyclicQuotientImage h (MvPowerSeries.X 1) : Set (cyclicQuotientModel K m q h)) := by
  have hZ : (PrimeSpectrum.zeroLocus {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
      Set (PrimeSpectrum (MvPowerSeries (Fin 2) K))) =
      PrimeSpectrum.zeroLocus {MvPowerSeries.X 0} ∪
        PrimeSpectrum.zeroLocus {MvPowerSeries.X 1} := by
    ext P
    simp only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, Set.mem_union,
      SetLike.mem_coe]
    exact ⟨P.isPrime.mem_or_mem,
      fun hP => hP.elim (P.asIdeal.mul_mem_right _) (P.asIdeal.mul_mem_left _)⟩
  change closure ((cyclicQuotientMap h).base '' (PrimeSpectrum.zeroLocus
      {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Set (PrimeSpectrum (MvPowerSeries (Fin 2) K)))) =
    closure ((cyclicQuotientMap h).base '' (PrimeSpectrum.zeroLocus {MvPowerSeries.X 0} :
      Set (PrimeSpectrum (MvPowerSeries (Fin 2) K)))) ∪
    closure ((cyclicQuotientMap h).base '' (PrimeSpectrum.zeroLocus {MvPowerSeries.X 1} :
      Set (PrimeSpectrum (MvPowerSeries (Fin 2) K))))
  rw [hZ]
  exact (congrArg closure (Set.image_union _ _ _)).trans closure_union

/-- A prime divisor whose generic point lies on the closure of a height-one point is that point's
prime divisor. -/
private theorem eq_of_genericPoint_mem_closure (P : Ideal (cyclicInvariants K m q)) [P.IsPrime]
    (hP : P.height = 1) (W : PrimeDivisor (Spec (ringCat K m q)))
    (hW : W.genericPoint ∈ closure ({ptOf P} : Set (Spec (ringCat K m q)))) :
    W.genericPoint = ptOf P := by
  have hle : P ≤ idealOf W.genericPoint :=
    (PrimeSpectrum.le_iff_mem_closure (R := cyclicInvariants K m q) _ _).mpr hW
  have := Ideal.eq_of_le_of_height_le _ hle
    ((height_idealOf W.coheight_genericPoint).trans hP.symm).le
  rw [← ptOf_idealOf W.genericPoint]
  exact (ptOf_congr this).symm

/-- The prime divisors on the closure of a height-one point `ptOf P` are the one of `P`. -/
private theorem genericPoint_mem_closure_ptOf_iff (P : Ideal (cyclicInvariants K m q)) [P.IsPrime]
    (hP : P.height = 1) {D : PrimeDivisor (Spec (ringCat K m q))} (hD : D.genericPoint = ptOf P)
    (W : PrimeDivisor (Spec (ringCat K m q))) :
    W.genericPoint ∈ closure ({ptOf P} : Set (Spec (ringCat K m q))) ↔ W = D :=
  ⟨fun hW => PrimeDivisor.genericPoint_injective
    ((eq_of_genericPoint_mem_closure P hP W hW).trans hD.symm),
    by rintro rfl; rw [hD]; exact subset_closure rfl⟩

private theorem genericPoint_mem_image_X_zero_iff (h : IsCyclicQuotientSetting K m q)
    (W : PrimeDivisor (Spec (ringCat K m q))) :
    W.genericPoint ∈
        (cyclicQuotientImage h (MvPowerSeries.X 0) : Set (cyclicQuotientModel K m q h)) ↔
      W = primeC h := by
  rw [← closure_ptOf_eq_cyclicQuotientImage h 0 prime_X_zero (xIdeal K m q) rfl]
  exact genericPoint_mem_closure_ptOf_iff _ (height_xIdeal h) (genericPoint_primeC h) W

private theorem genericPoint_mem_image_X_one_iff (h : IsCyclicQuotientSetting K m q)
    (W : PrimeDivisor (Spec (ringCat K m q))) :
    W.genericPoint ∈
        (cyclicQuotientImage h (MvPowerSeries.X 1) : Set (cyclicQuotientModel K m q h)) ↔
      W = primeC' h := by
  rw [← closure_ptOf_eq_cyclicQuotientImage h 1 prime_X_one (yIdeal K m q) rfl]
  exact genericPoint_mem_closure_ptOf_iff _ (height_yIdeal h) (genericPoint_primeC' h) W

end SecondBoundary

end CharacterClasses

/-! ### Rational functions of an integral scheme -/

section MoriBridge

variable {X : Scheme.{w}} [IsIntegral X]

/-- The function field of an integral scheme, as the ring of rational functions. -/
private noncomputable def toRat : X.functionField →+* MMP.Mori.RationalFunctions X :=
  RingHom.pi fun Z => (X.presheaf.stalkSpecializes
    (specializes_of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z))).hom

private theorem evalFF_toRat (Z : irreducibleComponents X) (z : X.functionField) :
    MMP.Threefold.Mori.Helpers.evalFF Z (toRat z) = z := by
  change (X.presheaf.stalkSpecializes _).hom ((X.presheaf.stalkSpecializes _).hom z) = z
  rw [← CommRingCat.comp_apply, TopCat.Presheaf.stalkSpecializes_comp,
    TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- A nonzero element of the function field as a unit of the ring of rational functions. -/
private noncomputable def ratUnit (z : X.functionField) (hz : z ≠ 0) :
    (MMP.Mori.RationalFunctions X)ˣ :=
  Units.map (toRat (X := X)).toMonoidHom (Units.mk0 z hz)

private theorem coe_ratUnit (z : X.functionField) (hz : z ≠ 0) :
    (ratUnit z hz : MMP.Mori.RationalFunctions X) = toRat z := rfl

variable [IsLocallyNoetherian X] [IsNormal X]

private theorem ord_ratUnit (z : X.functionField) (hz : z ≠ 0) (P : PrimeDivisor X) :
    MMP.Mori.PrimeDivisor.ord P (ratUnit z hz) = Scheme.ord z P.genericPoint := by
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, coe_ratUnit, evalFF_toRat]

/-- The single irreducible component of an integral scheme. -/
private def univComponent (X : Scheme.{w}) [IsIntegral X] : irreducibleComponents X :=
  ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩

private theorem exists_ord_eq (φ : (MMP.Mori.RationalFunctions X)ˣ) :
    ∃ (z : X.functionField) (_ : z ≠ 0),
      ∀ P : PrimeDivisor X, MMP.Mori.PrimeDivisor.ord P φ = Scheme.ord z P.genericPoint := by
  have hsub : ∀ Z : irreducibleComponents X, Z = univComponent X := fun Z => by
    apply Subtype.ext
    have h' := Z.2
    simp only [irreducibleComponents_eq_singleton, Set.mem_singleton_iff] at h'
    exact h'
  refine ⟨MMP.Threefold.Mori.Helpers.evalFF (univComponent X) (φ : _),
    (φ.isUnit.map (MMP.Threefold.Mori.Helpers.evalFF (univComponent X))).ne_zero, fun P => ?_⟩
  rw [MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hsub (MMP.Mori.PrimeDivisor.component P)]

end MoriBridge

/-! ### The class group in terms of `MMP.Mori.Divisor` -/

section MoriClassGroup

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat xIdeal_isPrime yIdeal_isPrime

variable [IsNoetherianRing (cyclicInvariants K m q)]

private theorem LinearlyEquivalent.zsmul {X : Scheme.{w}} [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] {D₁ D₂ : MMP.Mori.Divisor X} (hD : D₁.LinearlyEquivalent D₂) (n : ℤ) :
    (n • D₁).LinearlyEquivalent (n • D₂) := by
  obtain ⟨φ, hφ⟩ := hD
  refine ⟨φ ^ n, ?_⟩
  have := map_zsmul (MMP.Mori.principalDivisorHom (X := X)) n (Additive.ofMul φ)
  rw [MMP.Mori.principalDivisorHom_apply, MMP.Mori.principalDivisorHom_apply] at this
  rw [← smul_sub, hφ]
  exact this.symm

omit [IsNoetherianRing (cyclicInvariants K m q)] in
/-- If `a'^m = b^m (s^m)^k w` for invariants with `b ≠ 0` and `w` a unit, where `s = X i` has
weight `a`, then `m ∣ k a`. -/
private theorem dvd_mul_of_pow_eq_mul_unit (h : IsCyclicQuotientSetting K m q) (i : Fin 2)
    {a : ℤ} (hs : SemiInv K m q a (MvPowerSeries.X i : MvPowerSeries (Fin 2) K))
    (sm : cyclicInvariants K m q) (hsm : (sm : MvPowerSeries (Fin 2) K) = MvPowerSeries.X i ^ m)
    (k : ℕ) {a' b w : cyclicInvariants K m q} (hb0 : b ≠ 0)
    (hwu : IsUnit (w : MvPowerSeries (Fin 2) K)) (heq : a' ^ m = b ^ m * sm ^ k * w) :
    (m : ℤ) ∣ k * a := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  have : UniqueFactorizationMonoid (MvPowerSeries (Fin 2) K) :=
    IsRegularLocalRing.uniqueFactorizationMonoid _
  have hm0 : m ≠ 0 := by have := h.one_le; omega
  have heqA : (a' : MvPowerSeries (Fin 2) K) ^ m =
      ((b : MvPowerSeries (Fin 2) K) * MvPowerSeries.X i ^ k) ^ m *
        (w : MvPowerSeries (Fin 2) K) := by
    have := congrArg Subtype.val heq
    simp only [SubmonoidClass.coe_pow, Subring.coe_mul] at this
    rw [this, hsm, mul_pow, ← pow_mul, ← pow_mul, mul_comm k m]
  set c := (b : MvPowerSeries (Fin 2) K) * MvPowerSeries.X i ^ k
  have hc0 : c ≠ 0 := mul_ne_zero (fun e => hb0 (Subtype.ext e)) (pow_ne_zero _ (X_ne_zero K i))
  have h1 : c ∣ (a' : MvPowerSeries (Fin 2) K) :=
    (IsIntegrallyClosed.pow_dvd_pow_iff hm0).mp ⟨_, heqA⟩
  have h2 : (a' : MvPowerSeries (Fin 2) K) ∣ c := by
    refine (IsIntegrallyClosed.pow_dvd_pow_iff hm0).mp ⟨((hwu.unit⁻¹ : _) : MvPowerSeries _ _), ?_⟩
    rw [heqA, mul_assoc, IsUnit.mul_val_inv, mul_one]
  obtain ⟨v, hv⟩ := associated_of_dvd_dvd h1 h2
  have hcw : SemiInv K m q (k * a) c := by
    simpa using (semiInv_of_mem b.2).mul (hs.pow k)
  have hvw : SemiInv K m q (0 - k * a) (v : MvPowerSeries (Fin 2) K) :=
    (hv ▸ semiInv_of_mem a'.2).cancel hcw hc0
  have := hvw.dvd_of_isUnit h v.isUnit
  rwa [zero_sub, dvd_neg] at this

open scoped Classical in
/-- **The order of vanishing along the two boundary curves forces divisibility.** If `s^m`, for
the coordinate `s = X i` of weight `a`, has divisor `m [x₀]`, then a rational function with
divisor `k [x₀]` has `m ∣ k a`. -/
private theorem dvd_mul_of_ord_eq (h : IsCyclicQuotientSetting K m q) (i : Fin 2) {a : ℤ}
    (hs : SemiInv K m q a (MvPowerSeries.X i : MvPowerSeries (Fin 2) K))
    (sm : cyclicInvariants K m q) (hsm : (sm : MvPowerSeries (Fin 2) K) = MvPowerSeries.X i ^ m)
    (hsm0 : sm ≠ 0) (x₀ : Spec (ringCat K m q))
    (hordsm : ∀ y : Spec (ringCat K m q), coheight y = 1 →
      Scheme.ord (toFF K m q sm) y = if y = x₀ then (m : ℤ) else 0)
    (k : ℕ) (z : (Spec (ringCat K m q)).functionField) (hz : z ≠ 0)
    (hordz : ∀ y : Spec (ringCat K m q), coheight y = 1 →
      Scheme.ord z y = if y = x₀ then (k : ℤ) else 0) : (m : ℤ) ∣ k * a := by
  classical
  have := isNormal_spec h
  set xF := toFF K m q sm
  have hxF : xF ≠ 0 := toFF_ne_zero hsm0
  set W := z ^ m / xF ^ k with hW
  have hW0 : W ≠ 0 := div_ne_zero (pow_ne_zero _ hz) (pow_ne_zero _ hxF)
  have hordW : ∀ y : Spec (ringCat K m q), coheight y = 1 → Scheme.ord W y = 0 := by
    intro y hy
    rw [hW, ord_div (pow_ne_zero _ hz) (pow_ne_zero _ hxF), ord_pow hz, ord_pow hxF, hordz y hy,
      hordsm y hy]
    split_ifs <;> ring
  obtain ⟨s, hs'⟩ :=
    Stacks.AlgebraicGeometry.UnitsNormalProper.exists_globalUnit_of_forall_ord_eq_zero
      (Units.mk0 W hW0) hordW
  obtain ⟨w, hw⟩ := exists_toFF_eq_germ_top (s : Γ(Spec (ringCat K m q), ⊤))
  obtain ⟨w', hw'⟩ := exists_toFF_eq_germ_top (↑s⁻¹ : Γ(Spec (ringCat K m q), ⊤))
  have hww' : w * w' = 1 := by
    apply toFF_injective
    rw [map_mul, ← hw, ← hw', ← map_mul, Units.mul_inv, map_one, map_one]
  have hwW : toFF K m q w = W := by
    rw [← hw, hs']; rfl
  obtain ⟨a', b, hb0, hab'⟩ := toFF_div_surjective z
  have heq : a' ^ m = b ^ m * sm ^ k * w := by
    apply toFF_injective
    rw [map_mul, map_mul, map_pow, map_pow, map_pow, hwW, hW, ← hab']
    have hb' := toFF_ne_zero (K := K) (m := m) (q := q) hb0
    have hb'' := pow_ne_zero m hb'
    have hx'' := pow_ne_zero k hxF
    rw [div_pow]
    change _ = _ * xF ^ k * _
    field_simp
  exact dvd_mul_of_pow_eq_mul_unit h i hs sm hsm k hb0
    (IsUnit.of_mul_eq_one (b := (w' : MvPowerSeries (Fin 2) K))
      (by rw [← Subring.coe_mul, hww']; rfl)) heq

/-- `C' = (y = 0)` has a local parameter `t` with `t^m = y^m u^k` for an invariant `u ∉ C'`. -/
private theorem exists_localParameter_yIdeal (h : IsCyclicQuotientSetting K m q) :
    ∃ t ∈ yIdeal K m q, (∀ r ∈ yIdeal K m q, ∃ w d : cyclicInvariants K m q,
      d ∉ yIdeal K m q ∧ r * d = t * w) ∧
      ∃ u ∉ yIdeal K m q, ∃ k : ℕ, t ^ m = ym h * u ^ k := by
  have huP : (⟨MvPowerSeries.X 0 ^ m, (semiInv_X_zero.pow m).mem ⟨1, by ring⟩⟩ :
      cyclicInvariants K m q) ∉ yIdeal K m q := by
    rw [mem_yIdeal]; exact X_one_not_dvd_X_zero_pow _
  obtain ⟨t, -, htP, hgen, hpow⟩ := exists_localParameter h (yIdeal K m q) semiInv_X_one
    (X_ne_zero K 1) (fun r => mem_yIdeal.symm) semiInv_X_zero huP
  exact ⟨t, htP, hgen, _, huP, _, hpow (X_pow_mem_cyclicInvariants h 1)⟩

/-- `ord_{C'}(y^m) = m`. -/
private theorem ord_ym_ptOf_yIdeal (h : IsCyclicQuotientSetting K m q) :
    Scheme.ord (toFF K m q (ym h)) (ptOf (yIdeal K m q)) = m := by
  obtain ⟨t, htP, hgen, u, huP, k, hpow⟩ := exists_localParameter_yIdeal h
  exact ord_eq_of_pow_eq_mul h _ (height_yIdeal h) htP hgen huP (ym_ne_zero h) hpow

/-- Away from `C'`, `y^m` has order zero. -/
private theorem ord_ym_eq_zero (h : IsCyclicQuotientSetting K m q) (P : Ideal (cyclicInvariants K
    m q)) [P.IsPrime] (hP : P.height = 1) (hPy : P ≠ yIdeal K m q) :
    Scheme.ord (toFF K m q (ym h)) (ptOf P) = 0 := by
  exact ord_toFF_eq_zero P fun hy => hPy (eq_yIdeal_of_ym_mem h P hP hy)

/-- The divisor `1 · C` of `(x = 0)`. -/
private noncomputable def divC (h : IsCyclicQuotientSetting K m q) :
    MMP.Mori.Divisor (Spec (ringCat K m q)) :=
  Finsupp.single (primeC h) 1

/-- The divisor `1 · C'` of `(y = 0)`. -/
private noncomputable def divC' (h : IsCyclicQuotientSetting K m q) :
    MMP.Mori.Divisor (Spec (ringCat K m q)) :=
  Finsupp.single (primeC' h) 1

variable [IsNormal (Spec (ringCat K m q))]

/-- An invariant of order `m` along `D` and of order zero along every other prime divisor has
divisor `m D`. -/
private theorem principalDivisor_ratUnit_eq {r : cyclicInvariants K m q} (hr : r ≠ 0)
    (D : PrimeDivisor (Spec (ringCat K m q))) (hD : Scheme.ord (toFF K m q r) D.genericPoint = m)
    (h0 : ∀ V : PrimeDivisor (Spec (ringCat K m q)), V ≠ D →
      Scheme.ord (toFF K m q r) V.genericPoint = 0) :
    MMP.Mori.principalDivisor (ratUnit (toFF K m q r) (toFF_ne_zero hr)) =
      (m : ℤ) • Finsupp.single D 1 := by
  classical
  ext V
  change MMP.Mori.PrimeDivisor.ord V _ = _
  rw [ord_ratUnit, MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.smul_apply,
    Finsupp.single_apply]
  split_ifs with hV
  · subst hV; rw [hD]; simp
  · rw [smul_zero, h0 V (Ne.symm hV)]

private theorem principalDivisor_xm (h : IsCyclicQuotientSetting K m q) :
    MMP.Mori.principalDivisor (ratUnit (toFF K m q (xm h)) (toFF_ne_zero (xm_ne_zero h))) =
      (m : ℤ) • divC h :=
  principalDivisor_ratUnit_eq (xm_ne_zero h) _
    (by rw [genericPoint_primeC, ord_xm_ptOf_xIdeal]) fun V hV => by
    rw [← ptOf_idealOf (AlgebraicGeometry.PrimeDivisor.genericPoint V)]
    exact ord_xm_eq_zero h _ (height_idealOf V.coheight_genericPoint) (ne_xIdeal_of_ne h hV)

private theorem ne_yIdeal_of_ne (h : IsCyclicQuotientSetting K m q)
    {W : PrimeDivisor (Spec (ringCat K m q))}
    (hW : W ≠ primeC' h) : idealOf W.genericPoint ≠ yIdeal K m q := fun e =>
  hW (PrimeDivisor.genericPoint_injective (by
    rw [genericPoint_primeC', ← ptOf_idealOf W.genericPoint]; exact ptOf_congr e))

private theorem principalDivisor_ym (h : IsCyclicQuotientSetting K m q) :
    MMP.Mori.principalDivisor (ratUnit (toFF K m q (ym h)) (toFF_ne_zero (ym_ne_zero h))) =
      (m : ℤ) • divC' h :=
  principalDivisor_ratUnit_eq (ym_ne_zero h) _
    (by rw [genericPoint_primeC', ord_ym_ptOf_yIdeal]) fun V hV => by
    rw [← ptOf_idealOf (AlgebraicGeometry.PrimeDivisor.genericPoint V)]
    exact ord_ym_eq_zero h _ (height_idealOf V.coheight_genericPoint) (ne_yIdeal_of_ne h hV)

/-- **Every prime divisor is linearly equivalent to a multiple of `C`.** -/
private theorem exists_single_linearlyEquivalent (h : IsCyclicQuotientSetting K m q)
    (W : PrimeDivisor (Spec (ringCat K m q))) :
    ∃ c : ℤ, MMP.Mori.Divisor.LinearlyEquivalent (Finsupp.single W (1 : ℤ)) (c • divC h) := by
  classical
  by_cases hWC : W = primeC h
  · subst hWC; exact ⟨1, by rw [one_smul]; rfl⟩
  have hP := height_idealOf W.coheight_genericPoint
  have hPx := ne_xIdeal_of_ne h hWC
  obtain ⟨t, ht0, ht1, ht⟩ := exists_local_equation h (idealOf W.genericPoint) hP hPx
  have htF := toFF_ne_zero (K := K) (m := m) (q := q) ht0
  have hxF := toFF_ne_zero (K := K) (m := m) (q := q) (xm_ne_zero h)
  set f := toFF K m q t / toFF K m q (xm h)
  have hf : f ≠ 0 := div_ne_zero htF hxF
  set c := Scheme.ord f (primeC h).genericPoint
  refine ⟨-c, ratUnit f hf, ?_⟩
  ext V
  change _ = MMP.Mori.PrimeDivisor.ord V _
  rw [ord_ratUnit, MMP.Mori.DivisorWithCoeffs.coeff_apply, Finsupp.sub_apply, Finsupp.smul_apply,
    divC,
    Finsupp.single_apply, Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero]
  by_cases hVC : V = primeC h
  · subst hVC; rw [if_neg hWC, if_pos rfl]; simp [c]
  rw [if_neg (Ne.symm hVC), sub_zero, ord_div htF hxF,
    ← ptOf_idealOf (AlgebraicGeometry.PrimeDivisor.genericPoint V),
    ord_xm_eq_zero h _ (height_idealOf V.coheight_genericPoint) (ne_xIdeal_of_ne h hVC)]
  by_cases hVW : V = W
  · subst hVW; rw [if_pos rfl, ht1]; simp
  · rw [if_neg (Ne.symm hVW)]
    have hne : idealOf V.genericPoint ≠ idealOf W.genericPoint := fun e =>
      hVW (PrimeDivisor.genericPoint_injective (by
        rw [← ptOf_idealOf (AlgebraicGeometry.PrimeDivisor.genericPoint V),
          ← ptOf_idealOf W.genericPoint]; exact ptOf_congr e))
    rw [ht _ (height_idealOf V.coheight_genericPoint) hne (ne_xIdeal_of_ne h hVC)]; simp

/-- **`[C]` generates the class group.** -/
private theorem exists_linearlyEquivalent_zsmul_divC (h : IsCyclicQuotientSetting K m q)
    (D : MMP.Mori.Divisor (Spec (ringCat K m q))) : ∃ n : ℤ, D.LinearlyEquivalent (n • divC h) := by
  induction D using Finsupp.induction_linear with
  | zero => exact ⟨0, by rw [zero_smul]⟩
  | add D₁ D₂ h₁ h₂ =>
    obtain ⟨n₁, hn₁⟩ := h₁
    obtain ⟨n₂, hn₂⟩ := h₂
    exact ⟨n₁ + n₂, by rw [add_smul]; exact hn₁.add hn₂⟩
  | single W a =>
    obtain ⟨c, hc⟩ := exists_single_linearlyEquivalent h W
    refine ⟨a * c, ?_⟩
    have := LinearlyEquivalent.zsmul hc a
    rwa [Finsupp.smul_single, smul_eq_mul, mul_one, smul_smul] at this

open scoped Classical in
/-- A rational function with divisor `k [P]` has order `k` at the generic point of `P` and order
zero at every other height-one point. -/
private theorem ord_eq_ite_of_principalDivisor_eq {P : PrimeDivisor (Spec (ringCat K m q))} {k : ℤ}
    {φ : (MMP.Mori.RationalFunctions (Spec (ringCat K m q)))ˣ}
    (hφ : k • Finsupp.single P (1 : ℤ) = MMP.Mori.principalDivisor φ)
    {z : (Spec (ringCat K m q)).functionField}
    (hzφ : ∀ Q : PrimeDivisor (Spec (ringCat K m q)),
      MMP.Mori.PrimeDivisor.ord Q φ = Scheme.ord z Q.genericPoint)
    (y : Spec (ringCat K m q)) (hy : coheight y = 1) :
    Scheme.ord z y = if y = P.genericPoint then k else 0 := by
  have e := congrArg (fun D : MMP.Mori.Divisor _ => D (PrimeDivisor.ofCoheightOne y hy)) hφ
  simp only [Finsupp.smul_apply, Finsupp.single_apply] at e
  change _ = MMP.Mori.PrimeDivisor.ord _ φ at e
  rw [hzφ, PrimeDivisor.genericPoint_ofCoheightOne] at e
  rw [← e]
  by_cases hy' : y = P.genericPoint
  · rw [if_pos hy', if_pos (PrimeDivisor.genericPoint_injective (by
      rw [PrimeDivisor.genericPoint_ofCoheightOne, hy']))]; simp
  · rw [if_neg hy', if_neg (fun e' => hy' (by
      rw [e', PrimeDivisor.genericPoint_ofCoheightOne]))]; simp

/-- **`n [P] ∼ 0` exactly when `m ∣ n`**, for the boundary curve `P` of a coordinate `X i` whose
weight `a` is prime to `m`, given `div(X_i^m) = m [P]`. -/
private theorem zsmul_single_linearlyEquivalent_zero_iff (h : IsCyclicQuotientSetting K m q)
    (i : Fin 2) {a : ℤ} (ha : IsCoprime (m : ℤ) a)
    (hs : SemiInv K m q a (MvPowerSeries.X i : MvPowerSeries (Fin 2) K))
    (sm : cyclicInvariants K m q) (hsm : (sm : MvPowerSeries (Fin 2) K) = MvPowerSeries.X i ^ m)
    (hsm0 : sm ≠ 0) (P : PrimeDivisor (Spec (ringCat K m q)))
    (hdiv : MMP.Mori.principalDivisor (ratUnit (toFF K m q sm) (toFF_ne_zero hsm0)) =
      (m : ℤ) • Finsupp.single P (1 : ℤ)) (n : ℤ) :
    MMP.Mori.Divisor.LinearlyEquivalent (n • Finsupp.single P (1 : ℤ)) 0 ↔ (m : ℤ) ∣ n := by
  have hpos : ∀ k : ℕ,
      MMP.Mori.Divisor.LinearlyEquivalent ((k : ℤ) • Finsupp.single P (1 : ℤ)) 0 →
      (m : ℤ) ∣ k := by
    rintro k ⟨φ, hφ⟩
    obtain ⟨z, hz, hzφ⟩ := exists_ord_eq φ
    rw [sub_zero] at hφ
    exact ha.dvd_of_dvd_mul_right (dvd_mul_of_ord_eq h i hs sm hsm hsm0 P.genericPoint
      (ord_eq_ite_of_principalDivisor_eq hdiv.symm (ord_ratUnit _ _)) k z hz
      (ord_eq_ite_of_principalDivisor_eq hφ hzφ))
  constructor
  · intro hn
    rcases Int.natAbs_eq n with e | e
    · rw [e]; exact hpos _ (e ▸ hn)
    · have e' : (n.natAbs : ℤ) = -n := by omega
      rw [e, dvd_neg]
      refine hpos _ ?_
      have := hn.neg
      rw [neg_zero, ← neg_smul] at this
      rwa [e']
  · rintro ⟨k, rfl⟩
    refine ⟨ratUnit (toFF K m q sm) (toFF_ne_zero hsm0) ^ k, ?_⟩
    have := map_zsmul (MMP.Mori.principalDivisorHom (X := Spec (ringCat K m q))) k
      (Additive.ofMul (ratUnit (toFF K m q sm) (toFF_ne_zero hsm0)))
    rw [MMP.Mori.principalDivisorHom_apply, MMP.Mori.principalDivisorHom_apply] at this
    rw [sub_zero, mul_comm, mul_smul, ← hdiv]
    exact this.symm

/-- **`n [C] ∼ 0` exactly when `m ∣ n`.** -/
private theorem zsmul_divC_linearlyEquivalent_zero_iff (h : IsCyclicQuotientSetting K m q)
    (n : ℤ) : (n • divC h).LinearlyEquivalent 0 ↔ (m : ℤ) ∣ n :=
  zsmul_single_linearlyEquivalent_zero_iff h 0 isCoprime_one_right semiInv_X_zero (xm h) rfl
    (xm_ne_zero h) _ (principalDivisor_xm h) n

/-- **`n [C'] ∼ 0` exactly when `m ∣ n`.** -/
private theorem zsmul_divC'_linearlyEquivalent_zero_iff (h : IsCyclicQuotientSetting K m q)
    (n : ℤ) : (n • divC' h).LinearlyEquivalent 0 ↔ (m : ℤ) ∣ n :=
  zsmul_single_linearlyEquivalent_zero_iff h 1
    (by rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_comm]; exact h.gcd_eq_one) semiInv_X_one (ym h)
    rfl (ym_ne_zero h) _ (principalDivisor_ym h) n

/-- **On the local scheme `T`, a Cartier divisor is principal.** A local equation at the closed
point is one on all of `T`, since every open set containing the closed point is `T`. -/
private theorem isCartier_iff_linearlyEquivalent_zero
    (D : MMP.Mori.Divisor (Spec (ringCat K m q))) :
    D.IsCartier ↔ D.LinearlyEquivalent 0 := by
  have := isLocalRing_cyclicInvariants K m q
  constructor
  · intro hD
    obtain ⟨U, hU, φ, hφ⟩ := hD (IsLocalRing.closedPoint (cyclicInvariants K m q))
    have hall : ∀ y : Spec (ringCat K m q), y ∈ U := fun y => by
      have hsp : y ⤳ IsLocalRing.closedPoint (cyclicInvariants K m q) :=
        (PrimeSpectrum.le_iff_specializes (R := cyclicInvariants K m q) _ _).mp
          (IsLocalRing.le_maximalIdeal (y : PrimeSpectrum (cyclicInvariants K m q)).isPrime.ne_top)
      exact hsp.mem_open U.isOpen hU
    refine ⟨φ, ?_⟩
    ext E
    rw [sub_zero]
    exact hφ E ⟨E.genericPoint, by
      rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl, hall _⟩
  · intro hD
    exact MMP.Mori.Divisor.IsCartier.of_linearlyEquivalent hD MMP.Mori.Divisor.isCartier_zero

/-- The rational function `y^m` is the germ of the invariant `y^m`. -/
private theorem coe_ratUnit_ym (h : IsCyclicQuotientSetting K m q) :
    (ratUnit (toFF K m q (ym h)) (toFF_ne_zero (ym_ne_zero h)) :
        MMP.Mori.RationalFunctions (Spec (ringCat K m q))) =
      fun Z => (Spec (ringCat K m q)).presheaf.germ ⊤ (MMP.Mori.componentGenericPoint _ Z) trivial
        ((Scheme.ΓSpecIso (ringCat K m q)).inv (ym h)) := by
  funext Z
  rw [coe_ratUnit]
  change (Spec (ringCat K m q)).presheaf.stalkSpecializes _ (toFF K m q (ym h)) = _
  have e : toFF K m q (ym h) = (Spec (ringCat K m q)).presheaf.germ ⊤ (genericPoint _) trivial
      ((Scheme.ΓSpecIso (ringCat K m q)).inv (ym h)) := by
    rw [Scheme.ΓSpecIso_inv]
    exact (StructureSheaf.algebraMap_germ_apply _ _ _ _).symm
  rw [e, ← CommRingCat.comp_apply]
  erw [TopCat.Presheaf.germ_stalkSpecializes]

end MoriClassGroup

/-! ### Regularity -/

section Regularity

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

/-- An invariant which is a unit of `K[[x, y]]` is a unit of `R`. -/
private theorem isUnit_of_isUnit_coe {a : cyclicInvariants K m q}
    (ha : IsUnit (a : MvPowerSeries (Fin 2) K)) : IsUnit a := by
  obtain ⟨b, hb⟩ := isUnit_iff_exists.mp ha
  have hbR : b ∈ cyclicInvariants K m q := by
    refine (mem_cyclicInvariants_iff K m q b).mpr fun ζ => ?_
    have e := congrArg (MvPowerSeries.rescale (cyclicWeights K m q ζ)) hb.1
    rw [map_mul, map_one, (mem_cyclicInvariants_iff K m q _).mp a.2 ζ] at e
    calc MvPowerSeries.rescale (cyclicWeights K m q ζ) b
        = (b * (a : MvPowerSeries (Fin 2) K)) *
            MvPowerSeries.rescale (cyclicWeights K m q ζ) b := by
          rw [hb.2, one_mul]
      _ = b := by rw [mul_assoc, e, mul_one]
  exact isUnit_iff_exists.mpr ⟨⟨b, hbR⟩, Subtype.ext hb.1, Subtype.ext hb.2⟩

/-- `x^m` is irreducible in `R`. -/
private theorem irreducible_xm (h : IsCyclicQuotientSetting K m q) : Irreducible (xm h) := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  have hm0 : m ≠ 0 := by have := h.one_le; omega
  refine ⟨fun hu => ?_, fun a b hab => ?_⟩
  · have hu' := hu.map (cyclicInvariants K m q).subtype
    have := MvPowerSeries.isUnit_iff_constantCoeff.mp hu'
    simp [xm, hm0] at this
  · have habA : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ^ m =
        (a : MvPowerSeries (Fin 2) K) * b := congrArg Subtype.val hab
    obtain ⟨j, hjm, hj⟩ := (dvd_prime_pow prime_X_zero m).mp (Dvd.intro _ habA.symm)
    obtain ⟨u, hu⟩ := hj.symm
    have hjs : SemiInv K m q (0 - j) (u : MvPowerSeries (Fin 2) K) :=
      (hu ▸ semiInv_of_mem a.2).cancel (semiInv_X_zero_pow j) (pow_ne_zero _ (X_ne_zero K 0))
    have hdj : (m : ℤ) ∣ j := by
      have := hjs.dvd_of_isUnit h u.isUnit
      rwa [zero_sub, dvd_neg] at this
    obtain ⟨c, hc⟩ := hdj
    have hc01 : c = 0 ∨ c = 1 := by
      have : (j : ℤ) ≤ m := by exact_mod_cast hjm
      have hj0 : (0 : ℤ) ≤ j := by positivity
      rw [hc] at this hj0
      have hm' : (0 : ℤ) < m := by exact_mod_cast Nat.pos_of_ne_zero hm0
      rcases lt_trichotomy c 0 with hc' | hc' | hc'
      · nlinarith
      · exact .inl hc'
      · right
        nlinarith
    rcases hc01 with rfl | rfl
    · left
      obtain rfl : j = 0 := by omega
      refine isUnit_of_isUnit_coe ?_
      rw [← hu, pow_zero, one_mul]; exact u.isUnit
    · right
      have hj0 : j = m := by omega
      rw [hj0] at hu
      refine isUnit_of_isUnit_coe ?_
      have e : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ^ m * 1 =
          (MvPowerSeries.X 0 ^ m * (u : MvPowerSeries (Fin 2) K)) *
            (b : MvPowerSeries (Fin 2) K) := by
        rw [mul_one, hu]; exact habA
      rw [mul_assoc] at e
      have e' := mul_left_cancel₀ (pow_ne_zero _ (X_ne_zero K 0)) e
      exact IsUnit.of_mul_eq_one (b := (u : MvPowerSeries (Fin 2) K))
        (by rw [mul_comm]; exact e'.symm)

/-- For `m ≠ 1`, `x^m` is not prime in `R`: it divides `(x^i y)^m = (x^m)^i y^m` but not `x^i y`,
where `0 < i < m` and `i + q ≡ 0 (mod m)`. -/
private theorem not_prime_xm (h : IsCyclicQuotientSetting K m q) (hm1 : m ≠ 1) :
    ¬ Prime (xm h) := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  intro hprime
  have hm2 : 2 ≤ m := by have := h.one_le; omega
  have hm0 : (m : ℤ) ≠ 0 := by omega
  set i := ((-q) % m).toNat with hi
  have hi0 : 0 ≤ (-q) % m := Int.emod_nonneg _ hm0
  have him : (-q) % m < m := Int.emod_lt_of_pos _ (by omega)
  have hii : (i : ℤ) = (-q) % m := Int.toNat_of_nonneg hi0
  have hipos : 0 < i := by
    by_contra hz
    have : (-q) % m = 0 := by omega
    have hdvd : (m : ℤ) ∣ q := by
      have := Int.emod_emod_of_dvd (-q) (dvd_refl (m : ℤ))
      rw [← dvd_neg]; exact Int.dvd_of_emod_eq_zero (by omega)
    have hcop : IsCoprime q (m : ℤ) := Int.isCoprime_iff_gcd_eq_one.mpr h.gcd_eq_one
    have hu := hcop.isUnit_of_dvd' hdvd (dvd_refl _)
    rcases Int.isUnit_iff.mp hu with e | e <;> omega
  have hilt : i < m := by omega
  have hc : SemiInv K m q (i + q)
      ((MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ^ i * MvPowerSeries.X 1) :=
    (semiInv_X_zero_pow i).mul semiInv_X_one
  have hcR := hc.mem ⟨-((-q) / m), by rw [hii, Int.emod_def]; ring⟩
  set c : cyclicInvariants K m q := ⟨_, hcR⟩
  have hcm : c ^ m = xm h ^ i * ym h := by
    ext1
    simp only [SubmonoidClass.coe_pow, Subring.coe_mul, c, xm, ym]
    rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm i m]
  have hdvd : xm h ∣ c ^ m := by
    rw [hcm]; exact Dvd.dvd.mul_right (dvd_pow_self _ (by omega)) _
  obtain ⟨d, hd⟩ := hprime.dvd_of_dvd_pow hdvd
  have hdA : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ^ i * MvPowerSeries.X 1 =
      MvPowerSeries.X 0 ^ i * (MvPowerSeries.X 0 ^ (m - i) * (d : MvPowerSeries (Fin 2) K)) := by
    have := congrArg Subtype.val hd
    simp only [Subring.coe_mul, c, xm] at this
    rw [this, ← mul_assoc, ← pow_add, Nat.add_sub_cancel' hilt.le]
  have := mul_left_cancel₀ (pow_ne_zero _ (X_ne_zero K 0)) hdA
  apply X_zero_not_dvd_X_one_pow (K := K) 1
  rw [pow_one, this]
  exact Dvd.dvd.mul_right (dvd_pow_self _ (by omega)) _

/-- **`T` is regular exactly when `m = 1`.** For `m = 1` the group is trivial and `R` is
`K[[x, y]]`. For `m > 1` the irreducible element `x^m` of `R` is not prime, since it divides
`(x^i y)^m = (x^m)^i y^m` but not `x^i y`, where `0 < i < m` and `i + q ≡ 0 (mod m)`; so `R` is
not factorial, while a regular local ring is. -/
private theorem isRegularLocalRing_iff (h : IsCyclicQuotientSetting K m q) :
    IsRegularLocalRing (cyclicInvariants K m q) ↔ m = 1 := by
  have := MvPowerSeries.isRegularLocalRing K 2
  constructor
  · intro hreg
    by_contra hm1
    have := IsRegularLocalRing.uniqueFactorizationMonoid (cyclicInvariants K m q)
    exact not_prime_xm h hm1
      (UniqueFactorizationMonoid.irreducible_iff_prime.mp (irreducible_xm h))
  · rintro rfl
    have htop : cyclicInvariants K 1 q = ⊤ := by
      refine eq_top_iff.mpr fun f _ => (mem_cyclicInvariants_iff K 1 q f).mpr fun ζ => ?_
      have hζ : ζ = 1 := Subsingleton.elim _ _
      rw [hζ, map_one, MvPowerSeries.rescale_one, RingHom.id_apply]
    exact IsRegularLocalRing.of_ringEquiv
      ((RingEquiv.subringCongr htop).trans Subring.topEquiv).symm

end Regularity

/-! ### `K[[x, y]]` over `K[[x^m, y^m]]` -/

section Contraction

variable {K : Type w} [Field K] {m : ℕ}

/-- The contraction of `f` at the residue `p`: the series `∑_d a_{m d + p} X^d`, so that
`f = ∑_{p} (∑_d a_{m d + p} X^{m d}) X^p` over the residues `0 ≤ p < m`. -/
private noncomputable def cont (K : Type w) [Field K] (m : ℕ) (p : ℕ × ℕ)
    (f : MvPowerSeries (Fin 2) K) : MvPowerSeries (Fin 2) K :=
  fun d => coeff (m • d + expo p) f

private theorem coeff_cont (p : ℕ × ℕ) (f : MvPowerSeries (Fin 2) K) (d : Fin 2 →₀ ℕ) :
    coeff d (cont K m p f) = coeff (m • d + expo p) f := rfl

private theorem cont_add (p : ℕ × ℕ) (f g : MvPowerSeries (Fin 2) K) :
    cont K m p (f + g) = cont K m p f + cont K m p g := by
  ext d; simp [coeff_cont]

private theorem cont_zero (p : ℕ × ℕ) : cont K m p (0 : MvPowerSeries (Fin 2) K) = 0 := by
  ext d; simp [coeff_cont]

private theorem cont_sum {ι : Type*} (s : Finset ι) (p : ℕ × ℕ)
    (f : ι → MvPowerSeries (Fin 2) K) :
    cont K m p (∑ i ∈ s, f i) = ∑ i ∈ s, cont K m p (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [cont_zero]
  | insert a s has ih => rw [Finset.sum_insert has, Finset.sum_insert has, cont_add, ih]

/-- An exponent all of whose entries are divisible by `m` is `m` times an exponent. -/
private theorem exists_eq_smul_of_dvd {e : Fin 2 →₀ ℕ} (he : ∀ i, m ∣ e i) :
    ∃ u : Fin 2 →₀ ℕ, e = m • u := by
  refine ⟨Finsupp.equivFunOnFinite.symm fun i => e i / m, ?_⟩
  ext i
  simp [Nat.mul_div_cancel' (he i)]

private theorem expand_injective (hm : m ≠ 0) :
    Function.Injective (MvPowerSeries.expand m hm : MvPowerSeries (Fin 2) K → _) := by
  intro a b hab
  ext u
  rw [← MvPowerSeries.coeff_expand_smul m hm a u, ← MvPowerSeries.coeff_expand_smul m hm b u, hab]

/-- The expanded contraction is the component of `f` on the residue `p`, divided by `X^p`. -/
private theorem expand_cont (hm : m ≠ 0) (p : ℕ × ℕ) (f : MvPowerSeries (Fin 2) K) :
    MvPowerSeries.expand m hm (cont K m p f) = cyclicComponent K m p f := by
  ext e
  change _ = if m ∣ e 0 ∧ m ∣ e 1 then coeff (e + expo p) f else 0
  split_ifs with he
  · obtain ⟨u, rfl⟩ := exists_eq_smul_of_dvd (m := m) (fun i => by
      fin_cases i
      · exact he.1
      · exact he.2)
    rw [MvPowerSeries.coeff_expand_smul, coeff_cont]
  · rw [not_and_or] at he
    rcases he with he | he
    · exact MvPowerSeries.coeff_expand_of_not_dvd m hm _ he
    · exact MvPowerSeries.coeff_expand_of_not_dvd m hm _ he

private theorem add_mod_of_dvd {a b : ℕ} (h : m ∣ a) : (a + b) % m = b % m := by
  rw [Nat.add_mod, Nat.dvd_iff_mod_eq_zero.mp h, zero_add, Nat.mod_mod]

/-- The part of `f` on the exponents congruent to `p` modulo `m`. -/
private noncomputable def residuePart (K : Type w) [Field K] (m : ℕ) (p : ℕ × ℕ)
    (f : MvPowerSeries (Fin 2) K) : MvPowerSeries (Fin 2) K :=
  fun n => if n 0 % m = p.1 ∧ n 1 % m = p.2 then coeff n f else 0

/-- Multiplication by a series in `x^m, y^m` commutes with taking residue parts. -/
private theorem residuePart_mul (p : ℕ × ℕ) (r f : MvPowerSeries (Fin 2) K)
    (hr : ∀ n : Fin 2 →₀ ℕ, coeff n r ≠ 0 → m ∣ n 0 ∧ m ∣ n 1) :
    residuePart K m p (r * f) = r * residuePart K m p f := by
  ext n
  change (if n 0 % m = p.1 ∧ n 1 % m = p.2 then coeff n (r * f) else 0) = _
  rw [coeff_mul, coeff_mul]
  split_ifs with hn
  · refine Finset.sum_congr rfl fun x hx => ?_
    have hx : x.1 + x.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    change _ = _ * (if x.2 0 % m = p.1 ∧ x.2 1 % m = p.2 then coeff x.2 f else 0)
    by_cases ha : coeff x.1 r = 0
    · simp [ha]
    obtain ⟨h0, h1⟩ := hr _ ha
    have e0 : n 0 = x.1 0 + x.2 0 := by rw [← hx]; rfl
    have e1 : n 1 = x.1 1 + x.2 1 := by rw [← hx]; rfl
    have : x.2 0 % m = p.1 ∧ x.2 1 % m = p.2 := by
      rw [← hn.1, ← hn.2, e0, e1, add_mod_of_dvd h0, add_mod_of_dvd h1]
      exact ⟨rfl, rfl⟩
    rw [if_pos this]
  · symm
    refine Finset.sum_eq_zero fun x hx => ?_
    have hx : x.1 + x.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
    change _ * (if x.2 0 % m = p.1 ∧ x.2 1 % m = p.2 then coeff x.2 f else 0) = 0
    by_cases ha : coeff x.1 r = 0
    · simp [ha]
    obtain ⟨h0, h1⟩ := hr _ ha
    have e0 : n 0 = x.1 0 + x.2 0 := by rw [← hx]; rfl
    have e1 : n 1 = x.1 1 + x.2 1 := by rw [← hx]; rfl
    rw [if_neg]
    · simp
    rintro ⟨h2, h3⟩
    apply hn
    rw [e0, e1, add_mod_of_dvd h0, add_mod_of_dvd h1]
    exact ⟨h2, h3⟩

private theorem expo_apply_zero (p : ℕ × ℕ) : expo p 0 = p.1 := by simp [expo]

private theorem expo_apply_one (p : ℕ × ℕ) : expo p 1 = p.2 := by simp [expo]

private theorem expo_le_iff (p : ℕ × ℕ) (n : Fin 2 →₀ ℕ) : expo p ≤ n ↔ p.1 ≤ n 0 ∧ p.2 ≤ n 1 := by
  rw [Finsupp.le_def]
  constructor
  · intro h; exact ⟨expo_apply_zero p ▸ h 0, expo_apply_one p ▸ h 1⟩
  · rintro ⟨h0, h1⟩ i
    fin_cases i
    · simpa [expo_apply_zero] using h0
    · simpa [expo_apply_one] using h1

/-- `X^p` times the `p`-th cyclic component is the residue part, for `p` a residue. -/
private theorem monomial_mul_cyclicComponent {p : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m)
    (f : MvPowerSeries (Fin 2) K) :
    monomial (expo p) 1 * cyclicComponent K m p f = residuePart K m p f := by
  ext n
  rw [coeff_monomial_mul, one_mul]
  change _ = if n 0 % m = p.1 ∧ n 1 % m = p.2 then coeff n f else 0
  change (if expo p ≤ n then (if m ∣ (n - expo p) 0 ∧ m ∣ (n - expo p) 1 then
    coeff (n - expo p + expo p) f else 0) else 0) = _
  simp only [Finsupp.tsub_apply, expo_apply_zero, expo_apply_one, expo_le_iff]
  by_cases hn : n 0 % m = p.1 ∧ n 1 % m = p.2
  · have hle0 : p.1 ≤ n 0 := hn.1 ▸ Nat.mod_le _ _
    have hle1 : p.2 ≤ n 1 := hn.2 ▸ Nat.mod_le _ _
    rw [if_pos ⟨hle0, hle1⟩, if_pos, if_pos hn, tsub_add_cancel_of_le ((expo_le_iff p n).mpr
      ⟨hle0, hle1⟩)]
    rw [← hn.1, ← hn.2]
    exact ⟨Nat.dvd_sub_mod _, Nat.dvd_sub_mod _⟩
  · rw [if_neg hn]
    split_ifs with hle hd
    · exfalso
      apply hn
      have e0 := (Nat.modEq_iff_dvd' hle.1).mpr hd.1
      have e1 := (Nat.modEq_iff_dvd' hle.2).mpr hd.2
      unfold Nat.ModEq at e0 e1
      rw [Nat.mod_eq_of_lt hp1] at e0
      rw [Nat.mod_eq_of_lt hp2] at e1
      exact ⟨e0.symm, e1.symm⟩
    · rfl
    · rfl

private theorem dvd_of_coeff_expand_ne_zero (hm : m ≠ 0) (a : MvPowerSeries (Fin 2) K)
    (n : Fin 2 →₀ ℕ) (hn : coeff n (MvPowerSeries.expand m hm a) ≠ 0) : m ∣ n 0 ∧ m ∣ n 1 := by
  by_contra hc
  rcases not_and_or.mp hc with hc | hc <;>
    exact hn (MvPowerSeries.coeff_expand_of_not_dvd m hm _ hc)

private theorem monomial_expo_ne_zero (p : ℕ × ℕ) :
    (monomial (expo p) (1 : K) : MvPowerSeries (Fin 2) K) ≠ 0 := by
  intro h
  have := congrArg (coeff (expo p)) h
  simp at this

/-- **Contraction is linear over `K[[x^m, y^m]]`.** -/
private theorem cont_expand_mul (hm : m ≠ 0) {p : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m)
    (a f : MvPowerSeries (Fin 2) K) :
    cont K m p (MvPowerSeries.expand m hm a * f) = a * cont K m p f := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  apply expand_injective hm
  rw [map_mul, expand_cont, expand_cont]
  apply mul_left_cancel₀ (monomial_expo_ne_zero (K := K) p)
  rw [monomial_mul_cyclicComponent hp1 hp2, residuePart_mul _ _ _
      (dvd_of_coeff_expand_ne_zero hm a), ← monomial_mul_cyclicComponent hp1 hp2]
  ring

private theorem residuePart_monomial (p : ℕ × ℕ) (e : Fin 2 →₀ ℕ) :
    residuePart K m p (monomial e (1 : K)) =
      if e 0 % m = p.1 ∧ e 1 % m = p.2 then monomial e 1 else 0 := by
  classical
  ext n
  change (if n 0 % m = p.1 ∧ n 1 % m = p.2 then coeff n (monomial e (1 : K)) else 0) = _
  rw [coeff_monomial]
  by_cases hne : n = e
  · subst hne
    by_cases hc : n 0 % m = p.1 ∧ n 1 % m = p.2 <;> simp [hc, coeff_monomial]
  · rw [if_neg hne]
    by_cases hc : e 0 % m = p.1 ∧ e 1 % m = p.2 <;> simp [hc, coeff_monomial, hne]

/-- **The contractions of the basis monomials.** -/
private theorem cont_monomial (hm : m ≠ 0) {p p' : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m)
    (hp1' : p'.1 < m) (hp2' : p'.2 < m) :
    cont K m p (monomial (expo p') 1) = if p = p' then 1 else 0 := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  apply expand_injective hm
  rw [expand_cont]
  apply mul_left_cancel₀ (monomial_expo_ne_zero (K := K) p)
  rw [monomial_mul_cyclicComponent hp1 hp2, residuePart_monomial, expo_apply_zero,
    expo_apply_one, Nat.mod_eq_of_lt hp1', Nat.mod_eq_of_lt hp2']
  by_cases hpp : p = p'
  · subst hpp
    rw [if_pos ⟨rfl, rfl⟩, if_pos rfl]
    simp
  · rw [if_neg (fun e => hpp (Prod.ext e.1.symm e.2.symm)), if_neg hpp]
    simp

/-- **The decomposition `f = ∑_p (∑_d a_{m d + p} X^{m d}) X^p`.** -/
private theorem sum_expand_cont_mul (hm : m ≠ 0) (f : MvPowerSeries (Fin 2) K) :
    ∑ p ∈ Finset.range m ×ˢ Finset.range m,
      MvPowerSeries.expand m hm (cont K m p f) * monomial (expo p) 1 = f := by
  conv_rhs => rw [← sum_monomial_mul_cyclicComponent (Nat.pos_of_ne_zero hm) f]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [expand_cont, mul_comm]

/-- A series all of whose exponents `n` have `n₀ + q n₁ ≡ w (mod m)`. -/
private def HasWeight (m : ℕ) (q w : ℤ) (f : MvPowerSeries (Fin 2) K) : Prop :=
  ∀ n : Fin 2 →₀ ℕ, coeff n f ≠ 0 → (m : ℤ) ∣ (n 0 : ℤ) + q * n 1 - w

/-- The contractions of a series of weight `w` vanish off the residues of weight `w`. -/
private theorem cont_eq_zero_of_hasWeight {q w : ℤ} {f : MvPowerSeries (Fin 2) K}
    (hf : HasWeight m q w f) {p : ℕ × ℕ} (hp : ¬ (m : ℤ) ∣ (p.1 : ℤ) + q * p.2 - w) :
    cont K m p f = 0 := by
  ext d
  rw [coeff_cont, map_zero]
  by_contra hne
  apply hp
  have := hf _ hne
  have h0 : (m • d + expo p) 0 = m * d 0 + p.1 := by
    rw [Finsupp.add_apply, Finsupp.smul_apply, expo_apply_zero, smul_eq_mul]
  have h1 : (m • d + expo p) 1 = m * d 1 + p.2 := by
    rw [Finsupp.add_apply, Finsupp.smul_apply, expo_apply_one, smul_eq_mul]
  rw [h0, h1] at this
  push_cast at this
  have e : (p.1 : ℤ) + q * p.2 - w =
      ((m : ℤ) * d 0 + p.1 + q * ((m : ℤ) * d 1 + p.2) - w) - m * (d 0 + q * d 1) := by ring
  rw [e]
  exact dvd_sub this (dvd_mul_right _ _)

end Contraction

/-! ### `R` and the invariant forms over `K[[x^m, y^m]]` -/

section DualBasis

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

private theorem ne_zero_of_setting (h : IsCyclicQuotientSetting K m q) : m ≠ 0 :=
  (neZero_of_isCyclicQuotientSetting h).out

private theorem expand_mem (h : IsCyclicQuotientSetting K m q) (a : MvPowerSeries (Fin 2) K) :
    MvPowerSeries.expand m (ne_zero_of_setting h) a ∈ cyclicInvariants K m q := by
  rw [mem_cyclicInvariants_iff_coeff h]
  intro n hn
  obtain ⟨h0, h1⟩ := dvd_of_coeff_expand_ne_zero _ a n hn
  exact dvd_add (Int.natCast_dvd_natCast.mpr h0)
    (dvd_mul_of_dvd_right (Int.natCast_dvd_natCast.mpr h1) _)

/-- `K[[u, v]] → R`, `u ↦ x^m`, `v ↦ y^m`. -/
private noncomputable def expandR (h : IsCyclicQuotientSetting K m q) :
    MvPowerSeries (Fin 2) K →+* cyclicInvariants K m q :=
  (MvPowerSeries.expand m (ne_zero_of_setting h)).toRingHom.codRestrict _ (expand_mem h)

open scoped Classical in
/-- The residues `0 ≤ p < m` of weight `0`. -/
private noncomputable def resid0 (m : ℕ) (q : ℤ) : Finset (ℕ × ℕ) :=
  (Finset.range m ×ˢ Finset.range m).filter fun p => (m : ℤ) ∣ (p.1 : ℤ) + q * p.2

private theorem mem_resid0 {p : ℕ × ℕ} :
    p ∈ resid0 m q ↔ (p.1 < m ∧ p.2 < m) ∧ (m : ℤ) ∣ (p.1 : ℤ) + q * p.2 := by
  classical
  simp [resid0, Finset.mem_filter, Finset.mem_product, Finset.mem_range]

private theorem monomial_mem (h : IsCyclicQuotientSetting K m q) {p : ℕ × ℕ}
    (hp : (m : ℤ) ∣ (p.1 : ℤ) + q * p.2) :
    (monomial (expo p) (1 : K) : MvPowerSeries (Fin 2) K) ∈ cyclicInvariants K m q := by
  classical
  rw [mem_cyclicInvariants_iff_coeff h]
  intro n hn
  rw [coeff_monomial] at hn
  split_ifs at hn with he
  · subst he; rwa [expo_apply_zero, expo_apply_one]
  · exact absurd rfl hn

private theorem hasWeight_of_mem (h : IsCyclicQuotientSetting K m q) {r : MvPowerSeries (Fin 2) K}
    (hr : r ∈ cyclicInvariants K m q) : HasWeight m q 0 r := fun n hn => by
  rw [sub_zero]; exact (mem_cyclicInvariants_iff_coeff h r).mp hr n hn

private theorem sum_resid0 (h : IsCyclicQuotientSetting K m q) {r : MvPowerSeries (Fin 2) K}
    (hr : r ∈ cyclicInvariants K m q) :
    ∑ p ∈ resid0 m q, MvPowerSeries.expand m (ne_zero_of_setting h) (cont K m p r) *
      monomial (expo p) 1 = r := by
  classical
  conv_rhs => rw [← sum_expand_cont_mul (ne_zero_of_setting h) r]
  rw [resid0, Finset.sum_filter]
  refine Finset.sum_congr rfl fun p _ => ?_
  split_ifs with hp
  · rfl
  · rw [cont_eq_zero_of_hasWeight (hasWeight_of_mem h hr) (by rwa [sub_zero]), map_zero,
      zero_mul]

/-- `R` as a module over `K[[u, v]]` through `u ↦ x^m`, `v ↦ y^m`. -/
private noncomputable abbrev moduleR (h : IsCyclicQuotientSetting K m q) :
    ModuleCat (MvPowerSeries (Fin 2) K) :=
  (ModuleCat.restrictScalars (expandR h)).obj
    (ModuleCat.of (cyclicInvariants K m q) (cyclicInvariants K m q))

/-- An element of `moduleR h` as a power series. -/
private def valModuleR {h : IsCyclicQuotientSetting K m q} (r : moduleR h) :
    MvPowerSeries (Fin 2) K :=
  ((show cyclicInvariants K m q from r) : MvPowerSeries (Fin 2) K)

private theorem valModuleR_mem {h : IsCyclicQuotientSetting K m q} (r : moduleR h) :
    valModuleR r ∈ cyclicInvariants K m q := (show cyclicInvariants K m q from r).2

private theorem valModuleR_add {h : IsCyclicQuotientSetting K m q} (r s : moduleR h) :
    valModuleR (r + s) = valModuleR r + valModuleR s := rfl

private theorem valModuleR_injective {h : IsCyclicQuotientSetting K m q} :
    Function.Injective (valModuleR (h := h)) := fun r s e =>
  (Subtype.ext e : (show cyclicInvariants K m q from r) = show cyclicInvariants K m q from s)

private theorem valModuleR_smul (h : IsCyclicQuotientSetting K m q) (a : MvPowerSeries (Fin 2) K)
    (r : moduleR h) :
    valModuleR (a • r) = MvPowerSeries.expand m (ne_zero_of_setting h) a * valModuleR r := rfl

/-- The basis monomial `x^{p₁} y^{p₂}` of `R`, `p` a residue of weight `0`. -/
private noncomputable def xR (h : IsCyclicQuotientSetting K m q) (p : resid0 m q) : moduleR h :=
  (⟨monomial (expo p.1) 1, monomial_mem h (mem_resid0.mp p.2).2⟩ : cyclicInvariants K m q)

/-- **`R` is free over `K[[u, v]]` on the monomials of weight zero.** -/
private noncomputable def equivModuleR (h : IsCyclicQuotientSetting K m q) :
    moduleR h ≃ₗ[MvPowerSeries (Fin 2) K] (resid0 m q → MvPowerSeries (Fin 2) K) where
  toFun r p := cont K m p.1 (valModuleR r)
  map_add' r s := by
    funext p
    exact cont_add _ _ _
  map_smul' a r := by
    funext p
    have hp := (mem_resid0.mp p.2).1
    change cont K m p.1 (valModuleR (a • r)) = a * cont K m p.1 (valModuleR r)
    rw [valModuleR_smul, cont_expand_mul _ hp.1 hp.2]
  invFun c := (⟨∑ p : resid0 m q, MvPowerSeries.expand m (ne_zero_of_setting h) (c p) *
      monomial (expo p.1) 1, Subring.sum_mem _ fun p _ =>
        Subring.mul_mem _ (expand_mem h _) (monomial_mem h (mem_resid0.mp p.2).2)⟩ :
      cyclicInvariants K m q)
  left_inv r := by
    apply valModuleR_injective
    change ∑ p : resid0 m q, _ = valModuleR r
    rw [Finset.sum_coe_sort (resid0 m q) (fun p => MvPowerSeries.expand m (ne_zero_of_setting h)
      (cont K m p (valModuleR r)) * monomial (expo p) 1)]
    exact sum_resid0 h (valModuleR_mem r)
  right_inv c := by
    classical
    funext p
    have hp := (mem_resid0.mp p.2).1
    change cont K m p.1 (∑ p' : resid0 m q, _) = c p
    rw [cont_sum, Finset.sum_eq_single p]
    · rw [cont_expand_mul _ hp.1 hp.2, cont_monomial (ne_zero_of_setting h) hp.1 hp.2 hp.1 hp.2,
        if_pos rfl, mul_one]
    · intro p' _ hne
      have hp' := (mem_resid0.mp p'.2).1
      rw [cont_expand_mul _ hp.1 hp.2, cont_monomial (ne_zero_of_setting h) hp.1 hp.2 hp'.1 hp'.2,
        if_neg (fun e => hne (Subtype.ext e.symm)), mul_zero]
    · exact fun hp => absurd (Finset.mem_univ _) hp

private theorem projective_moduleR (h : IsCyclicQuotientSetting K m q) :
    Module.Projective (MvPowerSeries (Fin 2) K) (moduleR h) :=
  Module.Projective.of_equiv' (equivModuleR h).symm

private theorem finite_moduleR (h : IsCyclicQuotientSetting K m q) :
    Module.Finite (MvPowerSeries (Fin 2) K) (moduleR h) :=
  Module.Finite.equiv (equivModuleR h).symm

/-- `valModuleR` as an additive map. -/
private def valModuleRHom (h : IsCyclicQuotientSetting K m q) :
    moduleR h →+ MvPowerSeries (Fin 2) K where
  toFun := valModuleR
  map_zero' := rfl
  map_add' := valModuleR_add

private theorem valModuleR_sum (h : IsCyclicQuotientSetting K m q) {ι : Type*} (s : Finset ι)
    (f : ι → moduleR h) : valModuleR (∑ i ∈ s, f i) = ∑ i ∈ s, valModuleR (f i) :=
  map_sum (valModuleRHom h) f s

private theorem valModuleR_xR (h : IsCyclicQuotientSetting K m q) (p : resid0 m q) :
    valModuleR (xR h p) = monomial (expo p.1) 1 := rfl

/-- Every element of `R` is the combination of the basis monomials with its contractions. -/
private theorem eq_sum_smul_xR (h : IsCyclicQuotientSetting K m q) (r : moduleR h) :
    r = ∑ p : resid0 m q, cont K m p.1 (valModuleR r) • xR h p := by
  apply valModuleR_injective
  rw [valModuleR_sum]
  simp only [valModuleR_smul, valModuleR_xR]
  rw [Finset.sum_coe_sort (resid0 m q) (fun p => MvPowerSeries.expand m (ne_zero_of_setting h)
      (cont K m p (valModuleR r)) * monomial (expo p) 1)]
  exact (sum_resid0 h (valModuleR_mem r)).symm

/-- A `K[[u, v]]`-linear form on `R` is determined by its values on the basis monomials. -/
private theorem linearMap_apply_eq_sum (h : IsCyclicQuotientSetting K m q)
    (φ : moduleR h →ₗ[MvPowerSeries (Fin 2) K] MvPowerSeries (Fin 2) K) (r : moduleR h) :
    φ r = ∑ p : resid0 m q, cont K m p.1 (valModuleR r) * φ (xR h p) := by
  conv_lhs => rw [eq_sum_smul_xR h r]
  rw [map_sum]
  simp only [map_smul, smul_eq_mul]

end DualBasis

/-! ### The invariant two-forms -/

section Forms

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

/-- The `R`-module of `f ∈ K[[x, y]]` with `f dx ∧ dy` invariant: `ζ^{1+q} f(ζx, ζ^q y) = f`. -/
private def omegaSub (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    Submodule (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K) where
  carrier := {f | ∀ ζ : rootsOfUnity m K, (((ζ : Kˣ) ^ (1 + q) : Kˣ) : K) •
    MvPowerSeries.rescale (cyclicWeights K m q ζ) f = f}
  add_mem' {f g} hf hg ζ := by
    simp only [Set.mem_setOf_eq] at hf hg ⊢
    rw [map_add, smul_add, hf ζ, hg ζ]
  zero_mem' ζ := by simp
  smul_mem' r f hf ζ := by
    simp only [Set.mem_setOf_eq] at hf ⊢
    rw [Subring.smul_def, smul_eq_mul, map_mul, (mem_cyclicInvariants_iff K m q _).mp r.2 ζ,
      ← mul_smul_comm, hf ζ]

private theorem mem_omegaSub_iff (f : MvPowerSeries (Fin 2) K) :
    f ∈ omegaSub K m q ↔ ∀ ζ : rootsOfUnity m K, (((ζ : Kˣ) ^ (1 + q) : Kˣ) : K) •
      MvPowerSeries.rescale (cyclicWeights K m q ζ) f = f := Iff.rfl

private theorem mem_omegaSub_iff_hasWeight (h : IsCyclicQuotientSetting K m q)
    (f : MvPowerSeries (Fin 2) K) : f ∈ omegaSub K m q ↔ HasWeight m q (-(1 + q)) f := by
  rw [mem_omegaSub_iff]
  constructor
  · intro hf n hn
    obtain ⟨ζ', hζ'⟩ := exists_isPrimitiveRoot_rootsOfUnity h
    have h1 := congrArg (coeff n) (hf ζ')
    rw [MvPowerSeries.coeff_smul, coeff_rescale, prod_cyclicWeights_pow,
      ← mul_assoc, ← Units.val_mul, ← zpow_add] at h1
    have h2 : (((ζ' : Kˣ) ^ ((1 + q) + ((n 0 : ℤ) + q * n 1)) : Kˣ) : K) = 1 :=
      mul_right_cancel₀ hn (h1.trans (one_mul _).symm)
    have := (hζ'.zpow_eq_one_iff_dvd _).mp (Units.val_eq_one.mp h2)
    rw [sub_neg_eq_add]
    convert this using 1; ring
  · intro hf ζ
    ext n
    rw [MvPowerSeries.coeff_smul, coeff_rescale, prod_cyclicWeights_pow,
      ← mul_assoc, ← Units.val_mul, ← zpow_add]
    by_cases hn : coeff n f = 0
    · simp [hn]
    obtain ⟨k, hk⟩ := hf n hn
    have : ((ζ : Kˣ) ^ ((1 + q) + ((n 0 : ℤ) + q * n 1))) = 1 := by
      rw [show (1 + q) + ((n 0 : ℤ) + q * n 1) = (n 0 : ℤ) + q * n 1 - -(1 + q) by ring, hk,
        zpow_mul, zpow_natCast]
      simp [(mem_rootsOfUnity _ _).mp ζ.2]
    simp [this]

private theorem HasWeight.add {w : ℤ} {f g : MvPowerSeries (Fin 2) K} (hf : HasWeight m q w f)
    (hg : HasWeight m q w g) : HasWeight m q w (f + g) := fun n hn => by
  rw [map_add] at hn
  by_cases h0 : coeff n f = 0
  · rw [h0, zero_add] at hn; exact hg n hn
  · exact hf n h0

private theorem HasWeight.zero (w : ℤ) : HasWeight m q w (0 : MvPowerSeries (Fin 2) K) :=
  fun n hn => absurd (map_zero _) hn

private theorem HasWeight.sum {w : ℤ} {ι : Type*} (s : Finset ι) {f : ι → MvPowerSeries (Fin 2) K}
    (hf : ∀ i ∈ s, HasWeight m q w (f i)) : HasWeight m q w (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using HasWeight.zero w
  | insert a s has ih =>
    rw [Finset.sum_insert has]
    exact (hf a (Finset.mem_insert_self a s)).add
      (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))

private theorem HasWeight.mul {w₁ w₂ : ℤ} {f g : MvPowerSeries (Fin 2) K} (hf : HasWeight m q w₁ f)
    (hg : HasWeight m q w₂ g) : HasWeight m q (w₁ + w₂) (f * g) := fun n hn => by
  rw [coeff_mul] at hn
  obtain ⟨x, hx, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hn
  have hx : x.1 + x.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
  have h1 := hf _ (left_ne_zero_of_mul hne)
  have h2 := hg _ (right_ne_zero_of_mul hne)
  have e : (n 0 : ℤ) + q * n 1 - (w₁ + w₂) =
      ((x.1 0 : ℤ) + q * x.1 1 - w₁) + ((x.2 0 : ℤ) + q * x.2 1 - w₂) := by
    rw [← hx]; simp only [Finsupp.coe_add, Pi.add_apply]; push_cast; ring
  rw [e]; exact dvd_add h1 h2

private theorem hasWeight_monomial (p : ℕ × ℕ) :
    HasWeight m q ((p.1 : ℤ) + q * p.2) (monomial (expo p) (1 : K)) := fun n hn => by
  classical
  rw [coeff_monomial] at hn
  split_ifs at hn with he
  · subst he; rw [expo_apply_zero, expo_apply_one, sub_self]; exact dvd_zero _
  · exact absurd rfl hn

private theorem HasWeight.congr {w w' : ℤ} (hw : (m : ℤ) ∣ w - w') {f : MvPowerSeries (Fin 2) K}
    (hf : HasWeight m q w f) : HasWeight m q w' f := fun n hn => by
  have := dvd_add (hf n hn) hw
  rwa [sub_add_sub_cancel] at this

end Forms

/-! ### The residue pairing -/

section Pairing

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

/-- The corner residue `(m - 1, m - 1)`. -/
private abbrev corner (m : ℕ) : ℕ × ℕ := (m - 1, m - 1)

/-- The dual residue `(m - 1 - p₁, m - 1 - p₂)`. -/
private abbrev dualRes (m : ℕ) (p : ℕ × ℕ) : ℕ × ℕ := (m - 1 - p.1, m - 1 - p.2)

private theorem cont_corner_mul_monomial {p : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m)
    (g : MvPowerSeries (Fin 2) K) :
    cont K m (corner m) (g * monomial (expo p) 1) = cont K m (dualRes m p) g := by
  ext d
  have hle : expo p ≤ m • d + expo (corner m) := by
    rw [expo_le_iff]
    simp [expo, Finsupp.single_apply]
    omega
  have he : m • d + expo (corner m) - expo p = m • d + expo (dualRes m p) := by
    ext i
    fin_cases i <;> simp [expo, Finsupp.single_apply] <;> omega
  rw [coeff_cont, coeff_cont, coeff_mul_monomial, mul_one, if_pos hle, he]

/-- The residue pairing `⟨g, r⟩ = res(g r dx ∧ dy)`: the coefficient series of
`x^{m-1} y^{m-1}` in `g r` over `K[[x^m, y^m]]`. -/
private noncomputable def pairing (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    moduleR h →ₗ[MvPowerSeries (Fin 2) K] MvPowerSeries (Fin 2) K where
  toFun r := cont K m (corner m) ((g : MvPowerSeries (Fin 2) K) * valModuleR r)
  map_add' r s := by rw [valModuleR_add, mul_add, cont_add]
  map_smul' a r := by
    have := ne_zero_of_setting h
    rw [valModuleR_smul, mul_left_comm, cont_expand_mul _ (by simp; omega) (by simp; omega)]
    rfl

private theorem pairing_apply (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q)
    (r : moduleR h) :
    pairing h g r = cont K m (corner m) ((g : MvPowerSeries (Fin 2) K) * valModuleR r) := rfl

private theorem pairing_xR (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q)
    (p : resid0 m q) : pairing h g (xR h p) = cont K m (dualRes m p.1) g := by
  have hp := (mem_resid0.mp p.2).1
  rw [pairing_apply, valModuleR_xR, cont_corner_mul_monomial hp.1 hp.2]

private theorem dualRes_dualRes {p : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m) :
    dualRes m (dualRes m p) = p := by
  ext <;> simp <;> omega

private theorem weight_dualRes (p : ℕ × ℕ) (hp1 : p.1 < m) (hp2 : p.2 < m) :
    (((dualRes m p).1 : ℕ) : ℤ) + q * ((dualRes m p).2 : ℕ) =
      (m : ℤ) * (1 + q) - (1 + q) - ((p.1 : ℤ) + q * p.2) := by
  simp only [dualRes]
  rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega), Nat.cast_sub (by omega),
    Nat.cast_sub (by omega)]
  push_cast; ring

/-- The residue pairing as an `R`-linear map from the invariant forms to
`Hom_{K[[u,v]]}(R, K[[u,v]])`. -/
private noncomputable def pairingHom (h : IsCyclicQuotientSetting K m q) :
    omegaSub K m q →ₗ[cyclicInvariants K m q]
      (ModuleCat.coextendScalars (expandR h)).obj
        (ModuleCat.of (MvPowerSeries (Fin 2) K) (MvPowerSeries (Fin 2) K)) where
  toFun g := pairing h g
  map_add' g g' := by
    apply LinearMap.ext; intro r
    change cont K m (corner m)
        (((g + g' : omegaSub K m q) : MvPowerSeries (Fin 2) K) * valModuleR r) =
      cont K m (corner m) ((g : MvPowerSeries (Fin 2) K) * valModuleR r) +
        cont K m (corner m) ((g' : MvPowerSeries (Fin 2) K) * valModuleR r)
    rw [Submodule.coe_add, add_mul, cont_add]
  map_smul' r g := by
    apply LinearMap.ext; intro s
    show cont K m (corner m) (((r • g : omegaSub K m q) : MvPowerSeries (Fin 2) K) * valModuleR s) =
      cont K m (corner m) ((g : MvPowerSeries (Fin 2) K) *
        (valModuleR s * (r : MvPowerSeries (Fin 2) K)))
    rw [Submodule.coe_smul, Subring.smul_def, smul_eq_mul]
    congr 1
    ring

private theorem mem_resid0_dualRes {p : ℕ × ℕ} (hp1 : p.1 < m) (hp2 : p.2 < m)
    (hw : (m : ℤ) ∣ (p.1 : ℤ) + q * p.2 - -(1 + q)) : dualRes m p ∈ resid0 m q := by
  rw [mem_resid0]
  refine ⟨⟨by simp; omega, by simp; omega⟩, ?_⟩
  rw [weight_dualRes p hp1 hp2]
  have : (m : ℤ) * (1 + q) - (1 + q) - ((p.1 : ℤ) + q * p.2) =
      m * (1 + q) - ((p.1 : ℤ) + q * p.2 - -(1 + q)) := by ring
  rw [this]; exact dvd_sub (dvd_mul_right _ _) hw

private theorem pairingHom_injective (h : IsCyclicQuotientSetting K m q) :
    Function.Injective (pairingHom h) := by
  rw [injective_iff_map_eq_zero]
  intro g hg
  have hg' : pairing h g = 0 := hg
  have hcont : ∀ p : resid0 m q, cont K m (dualRes m p.1) (g : MvPowerSeries (Fin 2) K) = 0 :=
    fun p => by rw [← pairing_xR h g p, hg']; rfl
  have hgw := (mem_omegaSub_iff_hasWeight h _).mp g.2
  have hall : ∀ p ∈ Finset.range m ×ˢ Finset.range m,
      cont K m p (g : MvPowerSeries (Fin 2) K) = 0 := by
    intro p hp
    rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
    by_cases hw : (m : ℤ) ∣ (p.1 : ℤ) + q * p.2 - -(1 + q)
    · have := hcont ⟨_, mem_resid0_dualRes hp.1 hp.2 hw⟩
      rwa [dualRes_dualRes hp.1 hp.2] at this
    · exact cont_eq_zero_of_hasWeight hgw hw
  apply Subtype.ext
  rw [← sum_expand_cont_mul (ne_zero_of_setting h) (g : MvPowerSeries (Fin 2) K),
    Submodule.coe_zero]
  exact Finset.sum_eq_zero fun p hp => by rw [hall p hp, map_zero, zero_mul]

private theorem pairingHom_surjective (h : IsCyclicQuotientSetting K m q) :
    Function.Surjective (pairingHom h) := by
  classical
  intro φ
  let φ' : moduleR h →ₗ[MvPowerSeries (Fin 2) K] MvPowerSeries (Fin 2) K := φ
  set g : MvPowerSeries (Fin 2) K := ∑ p : resid0 m q,
    MvPowerSeries.expand m (ne_zero_of_setting h) (φ' (xR h p)) *
      monomial (expo (dualRes m p.1)) 1 with hgdef
  have hg : g ∈ omegaSub K m q := by
    rw [mem_omegaSub_iff_hasWeight h]
    refine HasWeight.sum _ fun p _ => ?_
    have hp := mem_resid0.mp p.2
    refine ((hasWeight_of_mem h (expand_mem h _)).mul
      (hasWeight_monomial (dualRes m p.1))).congr ?_
    rw [zero_add, weight_dualRes _ hp.1.1 hp.1.2]
    obtain ⟨k, hk⟩ := hp.2
    exact ⟨1 + q - k, by rw [hk]; ring⟩
  refine ⟨⟨g, hg⟩, ?_⟩
  show pairing h ⟨g, hg⟩ = φ'
  apply LinearMap.ext
  intro r
  rw [linearMap_apply_eq_sum h (pairing h ⟨g, hg⟩), linearMap_apply_eq_sum h φ']
  refine Finset.sum_congr rfl fun p _ => ?_
  congr 1
  have hp := (mem_resid0.mp p.2).1
  have hpd1 : (dualRes m p.1).1 < m := by simp; omega
  have hpd2 : (dualRes m p.1).2 < m := by simp; omega
  rw [pairing_xR]
  change cont K m (dualRes m p.1) g = _
  rw [hgdef, cont_sum, Finset.sum_eq_single p]
  · rw [cont_expand_mul _ hpd1 hpd2, cont_monomial (ne_zero_of_setting h) hpd1 hpd2 hpd1 hpd2,
      if_pos rfl, mul_one]
  · intro p' _ hne
    have hp' := (mem_resid0.mp p'.2).1
    have hpd1' : (dualRes m p'.1).1 < m := by simp; omega
    have hpd2' : (dualRes m p'.1).2 < m := by simp; omega
    rw [cont_expand_mul _ hpd1 hpd2, cont_monomial (ne_zero_of_setting h) hpd1 hpd2 hpd1' hpd2',
      if_neg, mul_zero]
    intro e
    apply hne
    apply Subtype.ext
    rw [← dualRes_dualRes hp'.1 hp'.2, ← e, dualRes_dualRes hp.1 hp.2]
  · exact fun hp => absurd (Finset.mem_univ _) hp

/-- **The invariant forms are `Hom_{K[[u, v]]}(R, K[[u, v]])`**, by the residue pairing. -/
private noncomputable def omegaEquiv (h : IsCyclicQuotientSetting K m q) :
    omegaSub K m q ≃ₗ[cyclicInvariants K m q]
      (ModuleCat.coextendScalars (expandR h)).obj
        (ModuleCat.of (MvPowerSeries (Fin 2) K) (MvPowerSeries (Fin 2) K)) :=
  LinearEquiv.ofBijective (pairingHom h) ⟨pairingHom_injective h, pairingHom_surjective h⟩

end Pairing

/-! ### Derived coextension of scalars along a projective algebra -/

section DerivedDual

open CategoryTheory CategoryTheory.Limits

attribute [local instance 10000] HasDerivedCategory.standard

variable {R B : Type w} [CommRing R] [CommRing B]

/-- **Coextension of scalars along a projective algebra preserves epimorphisms.**  A surjection
`M → M'` of `R`-modules induces a surjection `Hom_R(B, M) → Hom_R(B, M')` exactly because `B` is
projective: a functional on `B` with values in `M'` lifts through the surjection. -/
private theorem preservesEpimorphisms_coextendScalars_of_projective (f : R →+* B)
    (hproj : Module.Projective R
      ((ModuleCat.restrictScalars.{w} f).obj (ModuleCat.of B B))) :
    (ModuleCat.coextendScalars.{w, w, w} f).PreservesEpimorphisms := by
  constructor
  intro M M' g hg
  have hgs : Function.Surjective g.hom := (ModuleCat.epi_iff_surjective g).mp hg
  rw [ModuleCat.epi_iff_surjective]
  intro k
  obtain ⟨φ, hφ⟩ := Module.projective_lifting_property g.hom
    (ModuleCat.CoextendScalars.equiv f M' k) hgs
  refine ⟨(ModuleCat.CoextendScalars.equiv f M).symm φ, ?_⟩
  apply ModuleCat.CoextendScalars.ext
  refine LinearMap.ext fun b => ?_
  exact DFunLike.congr_fun hφ b

/-- **Coextension of scalars along a projective algebra is exact.**  It preserves finite limits
being a right adjoint, and preserves epimorphisms by
`preservesEpimorphisms_coextendScalars_of_projective`. -/
private theorem preservesFiniteColimits_coextendScalars_of_projective (f : R →+* B)
    (hproj : Module.Projective R
      ((ModuleCat.restrictScalars.{w} f).obj (ModuleCat.of B B))) :
    PreservesFiniteColimits (ModuleCat.coextendScalars.{w, w, w} f) := by
  haveI : (ModuleCat.coextendScalars.{w, w, w} f).PreservesEpimorphisms :=
    preservesEpimorphisms_coextendScalars_of_projective f hproj
  haveI : (ModuleCat.coextendScalars.{w, w, w} f).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  exact Functor.preservesFiniteColimits_of_preservesHomology _

/-- **`RHom_R(B, -)` needs no derived correction along a projective algebra.**  Coextension of
scalars along `f : R →+* B` is exact when `B` is a projective `R`-module, so the functor it
induces termwise on derived categories is already a total right derived functor of it, and
therefore agrees with `Dualizing.derivedHom f`.

Both functors are total right derived functors of
`(ModuleCat.coextendScalars f).mapHomotopyCategory _ ⋙ DerivedCategory.Qh` along the
quasi-isomorphisms, so they are canonically isomorphic by
`CategoryTheory.Functor.rightDerivedUnique`. -/
private noncomputable def coextendScalarsMapDerivedCategoryIsoDerivedHom_of_projective (f : R →+* B)
    (hproj : Module.Projective R
      ((ModuleCat.restrictScalars.{w} f).obj (ModuleCat.of B B))) :
    letI := preservesFiniteColimits_coextendScalars_of_projective f hproj
    (ModuleCat.coextendScalars.{w, w, w} f).mapDerivedCategory ≅
      Dualizing.derivedHom.{w, w, w} f := by
  letI := preservesFiniteColimits_coextendScalars_of_projective f hproj
  let F := ModuleCat.coextendScalars.{w, w, w} f
  let W := HomotopyCategory.quasiIso (ModuleCat.{w} R) (ComplexShape.up ℤ)
  have hptw : (F.mapHomotopyCategory (ComplexShape.up ℤ) ⋙
      DerivedCategory.Qh).HasPointwiseRightDerivedFunctor W :=
    Dualizing.coextendScalars_hasPointwiseRightDerivedFunctor.{w, w, w} f
  have hF : F.mapDerivedCategory.IsRightDerivedFunctor F.mapDerivedCategoryFactorsh.inv W :=
    Functor.isRightDerivedFunctor_of_inverts W F.mapDerivedCategory F.mapDerivedCategoryFactorsh
  have hdef : Dualizing.derivedHom.{w, w, w} f =
      (F.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh).totalRightDerived
        DerivedCategory.Qh W := rfl
  rw [hdef]
  exact Functor.rightDerivedUnique F.mapDerivedCategory
    ((F.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh).totalRightDerived
      DerivedCategory.Qh W)
    F.mapDerivedCategoryFactorsh.inv
    ((F.mapHomotopyCategory (ComplexShape.up ℤ) ⋙ DerivedCategory.Qh).totalRightDerivedUnit
      DerivedCategory.Qh W) W

/-- **`RHom_R(B, M)` is `Hom_R(B, M)` in degree zero, along a projective algebra.**  For
`f : R →+* B` making `B` a projective `R`-module and an `R`-module `M`, the value of derived
coextension of scalars at `M` placed in degree zero is `Hom_R(B, M)` placed in degree zero. -/
private noncomputable def derivedHomObjSingleIso (f : R →+* B)
    (hproj : Module.Projective R
      ((ModuleCat.restrictScalars.{w} f).obj (ModuleCat.of B B)))
    (M : ModuleCat.{w} R) :
    (Dualizing.derivedHom.{w, w, w} f).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{w} R) 0).obj M) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{w} B) 0).obj
        ((ModuleCat.coextendScalars.{w, w, w} f).obj M) := by
  letI := preservesFiniteColimits_coextendScalars_of_projective f hproj
  exact ((coextendScalarsMapDerivedCategoryIsoDerivedHom_of_projective f hproj).app _).symm ≪≫
    ((ModuleCat.coextendScalars.{w, w, w} f).mapDerivedCategorySingleFunctor 0).app M

end DerivedDual

/-! ### The global sections of `𝒪_T(-C^{(2)})` -/

section Sections

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat xIdeal_isPrime yIdeal_isPrime

variable [IsNoetherianRing (cyclicInvariants K m q)]
  [IsNormal (Spec (ringCat K m q))]

/-- The germ of a global function at the generic point of a component is its rational function. -/
private theorem germ_top_eq_toRat (r : cyclicInvariants K m q)
    (Z : irreducibleComponents (Spec (ringCat K m q))) :
    (Spec (ringCat K m q)).presheaf.germ ⊤ (MMP.Mori.componentGenericPoint _ Z) trivial
      ((Scheme.ΓSpecIso (ringCat K m q)).inv r) = toRat (toFF K m q r) Z := by
  change _ = (Spec (ringCat K m q)).presheaf.stalkSpecializes _ (toFF K m q r)
  have e : toFF K m q r = (Spec (ringCat K m q)).presheaf.germ ⊤ (genericPoint _) trivial
      ((Scheme.ΓSpecIso (ringCat K m q)).inv r) := by
    rw [Scheme.ΓSpecIso_inv]
    exact (StructureSheaf.algebraMap_germ_apply _ _ _ _).symm
  rw [e, ← CommRingCat.comp_apply]
  erw [TopCat.Presheaf.germ_stalkSpecializes]

/-- The order condition of a divisorial section at a germ of a regular function. -/
private theorem ordGE_germ_iff (E : PrimeDivisor (Spec (ringCat K m q)))
    {r : cyclicInvariants K m q} (hr : r ≠ 0) (n : ℤ) :
    MMP.Mori.PrimeDivisor.OrdGE E n ((Spec (ringCat K m q)).presheaf.germ ⊤
        (MMP.Mori.componentGenericPoint _ (MMP.Mori.PrimeDivisor.component E)) trivial
        ((Scheme.ΓSpecIso (ringCat K m q)).inv r)) ↔
      n ≤ Scheme.ord (toFF K m q r) E.genericPoint := by
  have hz := toFF_ne_zero (K := K) (m := m) (q := q) hr
  rw [germ_top_eq_toRat, ← coe_ratUnit (toFF K m q r) hz]
  unfold MMP.Mori.PrimeDivisor.OrdGE
  rw [MMP.Mori.PrimeDivisor.valuation_component, ord_ratUnit, WithZero.exp_le_exp]
  constructor
  · rintro (h0 | h)
    · exact absurd h0 ((Pi.isUnit_iff.mp (ratUnit (toFF K m q r) hz).isUnit) _).ne_zero
    · exact h
  · exact Or.inr

/-- Regular functions have nonnegative order along every prime divisor. -/
private theorem ord_toFF_nonneg {r : cyclicInvariants K m q} (hr : r ≠ 0)
    (E : PrimeDivisor (Spec (ringCat K m q))) : 0 ≤ Scheme.ord (toFF K m q r) E.genericPoint := by
  rw [← ordGE_germ_iff E hr]
  have h1 : MMP.Mori.PrimeDivisor.OrdGE E 0 1 := Or.inr (by rw [map_one, WithZero.exp_zero])
  have := h1.toComponent_mul ((Spec (ringCat K m q)).presheaf.germ ⊤ E.genericPoint trivial
    ((Scheme.ΓSpecIso (ringCat K m q)).inv r))
  rw [mul_one] at this
  convert this using 1
  change _ = (Spec (ringCat K m q)).presheaf.stalkSpecializes _ _
  rw [← CommRingCat.comp_apply]
  erw [TopCat.Presheaf.germ_stalkSpecializes]

/-- At a height-one prime with a local parameter, an invariant has positive order exactly when it
lies in the prime. -/
private theorem one_le_ord_iff_mem (h : IsCyclicQuotientSetting K m q)
    (P : Ideal (cyclicInvariants K m q)) [P.IsPrime] (hP : P.height = 1)
    {t : cyclicInvariants K m q} (htP : t ∈ P)
    (hgen : ∀ r ∈ P, ∃ w d : cyclicInvariants K m q, d ∉ P ∧ r * d = t * w)
    {r : cyclicInvariants K m q} (hr : r ≠ 0) :
    1 ≤ Scheme.ord (toFF K m q r) (ptOf P) ↔ r ∈ P := by
  refine ⟨fun h1 => by_contra fun hn => by rw [ord_toFF_eq_zero _ hn] at h1; omega, fun hrP => ?_⟩
  have h1 := ord_toFF_eq_one h P hP htP hgen
  obtain ⟨w, d, hd, hrd⟩ := hgen r hrP
  have hd0 : d ≠ 0 := fun e => hd (e ▸ Ideal.zero_mem _)
  have ht0 : t ≠ 0 := by
    rintro rfl
    rw [map_zero, Scheme.ord_zero] at h1
    exact absurd h1 (by norm_num)
  have hw0 : w ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hrd
    exact mul_ne_zero hr hd0 hrd
  have key := congrArg (fun r => Scheme.ord (toFF K m q r) (ptOf P)) hrd
  simp only [map_mul] at key
  rw [Scheme.ord_mul (toFF_ne_zero hr) (toFF_ne_zero hd0),
    Scheme.ord_mul (toFF_ne_zero ht0) (toFF_ne_zero hw0), ord_toFF_eq_zero _ hd, h1] at key
  have := ord_toFF_nonneg hw0 (PrimeDivisor.ofCoheightOne (ptOf P) (coheight_ptOf hP))
  rw [PrimeDivisor.genericPoint_ofCoheightOne] at this
  omega

private theorem one_le_ord_xIdeal_iff (h : IsCyclicQuotientSetting K m q)
    {r : cyclicInvariants K m q} (hr : r ≠ 0) :
    1 ≤ Scheme.ord (toFF K m q r) (ptOf (xIdeal K m q)) ↔ r ∈ xIdeal K m q := by
  obtain ⟨t, htP, hgen, -⟩ := exists_localParameter_xIdeal h
  exact one_le_ord_iff_mem h _ (height_xIdeal h) htP hgen hr

private theorem one_le_ord_yIdeal_iff (h : IsCyclicQuotientSetting K m q)
    {r : cyclicInvariants K m q} (hr : r ≠ 0) :
    1 ≤ Scheme.ord (toFF K m q r) (ptOf (yIdeal K m q)) ↔ r ∈ yIdeal K m q := by
  obtain ⟨t, htP, hgen, -⟩ := exists_localParameter_yIdeal h
  exact one_le_ord_iff_mem h _ (height_yIdeal h) htP hgen hr

private theorem X_mul_X_dvd_iff (f : MvPowerSeries (Fin 2) K) :
    (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣ f ↔
      MvPowerSeries.X 0 ∣ f ∧ MvPowerSeries.X 1 ∣ f := by
  constructor
  · rintro ⟨c, rfl⟩
    exact ⟨⟨MvPowerSeries.X 1 * c, by ring⟩, ⟨MvPowerSeries.X 0 * c, by ring⟩⟩
  · rintro ⟨⟨a, rfl⟩, h1⟩
    rcases (prime_X_one (K := K)).dvd_or_dvd h1 with h | ⟨b, rfl⟩
    · exact absurd (by simpa using h) (X_one_not_dvd_X_zero_pow (K := K) 1)
    · exact ⟨b, by ring⟩

/-- `g dx ∧ dy` is invariant exactly when `x y g` is. -/
private theorem mem_omegaSub_iff_mul_mem (h : IsCyclicQuotientSetting K m q)
    (g : MvPowerSeries (Fin 2) K) :
    g ∈ omegaSub K m q ↔
      MvPowerSeries.X 0 * MvPowerSeries.X 1 * g ∈ cyclicInvariants K m q := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  have hxy : SemiInv K m q (1 + q) (MvPowerSeries.X 0 * MvPowerSeries.X 1 :
      MvPowerSeries (Fin 2) K) := semiInv_X_zero.mul semiInv_X_one
  have hxy0 : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ≠ 0 :=
    mul_ne_zero (X_ne_zero K 0) (X_ne_zero K 1)
  rw [mem_omegaSub_iff, mem_cyclicInvariants_iff]
  refine forall_congr' fun ζ => ?_
  rw [map_mul, hxy ζ, MvPowerSeries.smul_eq_C_mul]
  constructor
  · intro e
    calc _ = MvPowerSeries.X 0 * MvPowerSeries.X 1 *
          (MvPowerSeries.C ((((ζ : Kˣ) ^ (1 + q)) : Kˣ) : K) *
            MvPowerSeries.rescale (cyclicWeights K m q ζ) g) := by ring
      _ = _ := by rw [e]
  · intro e
    apply mul_left_cancel₀ hxy0
    calc _ = MvPowerSeries.C ((((ζ : Kˣ) ^ (1 + q)) : Kˣ) : K) *
          (MvPowerSeries.X 0 * MvPowerSeries.X 1) *
            MvPowerSeries.rescale (cyclicWeights K m q ζ) g := by ring
      _ = _ := e

end Sections

section SectionsEquiv

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat xIdeal_isPrime yIdeal_isPrime

variable [IsNoetherianRing (cyclicInvariants K m q)]
  [IsNormal (Spec (ringCat K m q))]

/-- The ring isomorphism `R ≅ Γ(T, 𝒪_T)`. -/
private noncomputable def gammaEquiv (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    cyclicInvariants K m q ≃+* Γ(Spec (ringCat K m q), ⊤) :=
  (Scheme.ΓSpecIso (ringCat K m q)).symm.commRingCatIsoToRingEquiv

/-- The invariant `x y g` of an invariant form `g dx ∧ dy`. -/
private noncomputable def xyMul (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    cyclicInvariants K m q :=
  ⟨(MvPowerSeries.X 0 * MvPowerSeries.X 1 * (g : MvPowerSeries (Fin 2) K) :
    MvPowerSeries (Fin 2) K), (mem_omegaSub_iff_mul_mem h g).mp g.2⟩

private theorem coe_xyMul (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    (xyMul h g : MvPowerSeries (Fin 2) K) =
      MvPowerSeries.X 0 * MvPowerSeries.X 1 * (g : MvPowerSeries (Fin 2) K) := rfl

private theorem xyMul_mem_xIdeal (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    xyMul h g ∈ xIdeal K m q :=
  mem_xIdeal.mpr ⟨MvPowerSeries.X 1 * (g : MvPowerSeries (Fin 2) K), by rw [coe_xyMul]; ring⟩

private theorem xyMul_mem_yIdeal (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    xyMul h g ∈ yIdeal K m q :=
  mem_yIdeal.mpr ⟨MvPowerSeries.X 0 * (g : MvPowerSeries (Fin 2) K), by rw [coe_xyMul]; ring⟩

open scoped Classical in
private theorem neg_coeff_C2 (h : IsCyclicQuotientSetting K m q)
    (E : PrimeDivisor (Spec (ringCat K m q))) :
    -(MMP.Mori.DivisorWithCoeffs.coeff (-(divC h + divC' h)) E) =
      (if primeC h = E then 1 else 0) + (if primeC' h = E then 1 else 0) := by
  rw [MMP.Mori.DivisorWithCoeffs.coeff_neg, neg_neg, MMP.Mori.DivisorWithCoeffs.coeff_add,
    MMP.Mori.DivisorWithCoeffs.coeff_apply, MMP.Mori.DivisorWithCoeffs.coeff_apply, divC, divC',
    Finsupp.single_apply, Finsupp.single_apply]

/-- A regular function vanishing on both boundary curves is a section of `𝒪_T(-C^{(2)})`. -/
private theorem isDivisorialSection_of_mem (h : IsCyclicQuotientSetting K m q)
    {r : cyclicInvariants K m q} (hx : r ∈ xIdeal K m q) (hy : r ∈ yIdeal K m q) :
    (-(divC h + divC' h)).IsDivisorialSection ⊤
      ((MMP.Mori.toRationalFunctionsPresheaf (Spec (ringCat K m q))).app (Opposite.op ⊤)
        ((Scheme.ΓSpecIso (ringCat K m q)).inv r)) := by
  classical
  intro E hE
  rw [neg_coeff_C2]
  by_cases hr : r = 0
  · subst hr
    change MMP.Mori.PrimeDivisor.OrdGE E _ ((Spec (ringCat K m q)).presheaf.germ ⊤ _ _
      ((Scheme.ΓSpecIso (ringCat K m q)).inv 0))
    rw [map_zero, map_zero]
    exact MMP.Mori.PrimeDivisor.OrdGE.zero _
  change MMP.Mori.PrimeDivisor.OrdGE E _ ((Spec (ringCat K m q)).presheaf.germ ⊤ _ trivial
    ((Scheme.ΓSpecIso (ringCat K m q)).inv r))
  rw [ordGE_germ_iff E hr]
  by_cases h1 : primeC h = E
  · subst h1
    rw [if_pos rfl, if_neg (primeC_ne_primeC' h).symm, add_zero, genericPoint_primeC]
    exact (one_le_ord_xIdeal_iff h hr).mpr hx
  · by_cases h2 : primeC' h = E
    · subst h2
      rw [if_neg h1, if_pos rfl, zero_add, genericPoint_primeC']
      exact (one_le_ord_yIdeal_iff h hr).mpr hy
    · rw [if_neg h1, if_neg h2, add_zero]
      exact ord_toFF_nonneg hr E

/-- Regular functions on `T` as rational functions. -/
private noncomputable def gerR (K : Type w) [Field K] (m : ℕ) (q : ℤ) :
    cyclicInvariants K m q →+*
      ToType ((MMP.Mori.rationalFunctionsPresheaf (Spec (ringCat K m q))).obj (Opposite.op ⊤)) :=
  ((MMP.Mori.toRationalFunctionsPresheaf (Spec (ringCat K m q))).app (Opposite.op ⊤)).hom.comp
    (Scheme.ΓSpecIso (ringCat K m q)).inv.hom

private theorem gerR_apply (r : cyclicInvariants K m q) :
    gerR K m q r = (MMP.Mori.toRationalFunctionsPresheaf (Spec (ringCat K m q))).app (Opposite.op ⊤)
      ((Scheme.ΓSpecIso (ringCat K m q)).inv r) := rfl

private theorem gerR_injective : Function.Injective (gerR K m q) := by
  intro a b hab
  have h2 := MMP.Mori.toRationalFunctionsPresheaf_app_injective (X := Spec (ringCat K m q)) ⊤ hab
  exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (ringCat K m q)).inv).1 h2

/-- The section `x y g` of `𝒪_T(-C^{(2)})` of an invariant form `g dx ∧ dy`. -/
private noncomputable def sectionOf (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    Γ((-(divC h + divC' h)).divisorialSheaf, ⊤) :=
  (⟨gerR K m q (xyMul h g),
    isDivisorialSection_of_mem h (xyMul_mem_xIdeal h g) (xyMul_mem_yIdeal h g)⟩ :
      (-(divC h + divC' h)).divisorialSubmodule ⊤)

private theorem coe_sectionOf (h : IsCyclicQuotientSetting K m q) (g : omegaSub K m q) :
    (sectionOf h g).1 = gerR K m q (xyMul h g) := rfl

private theorem xyMul_add (h : IsCyclicQuotientSetting K m q) (g g' : omegaSub K m q) :
    xyMul h (g + g') = xyMul h g + xyMul h g' :=
  Subtype.ext (by simp only [coe_xyMul, Submodule.coe_add, Subring.coe_add]; ring)

private theorem xyMul_smul (h : IsCyclicQuotientSetting K m q) (r : cyclicInvariants K m q)
    (g : omegaSub K m q) : xyMul h (r • g) = r * xyMul h g :=
  Subtype.ext (by
    simp only [coe_xyMul, Submodule.coe_smul, Subring.coe_mul, Subring.smul_def, smul_eq_mul]
    ring)

/-- `g ↦ x y g` as an additive map into the sections of `𝒪_T(-C^{(2)})`. -/
private noncomputable def sectionHom (h : IsCyclicQuotientSetting K m q) :
    omegaSub K m q →+ Γ((-(divC h + divC' h)).divisorialSheaf, ⊤) where
  toFun := sectionOf h
  map_zero' := by
    apply Subtype.ext
    rw [coe_sectionOf]
    have : xyMul h 0 = 0 := Subtype.ext (by simp [coe_xyMul])
    rw [this, map_zero]
    rfl
  map_add' g g' := by
    apply Subtype.ext
    rw [coe_sectionOf, xyMul_add, map_add]
    rfl

private theorem sectionHom_smul (h : IsCyclicQuotientSetting K m q) (r : cyclicInvariants K m q)
    (g : omegaSub K m q) :
    sectionHom h (r • g) = gammaEquiv K m q r • sectionHom h g := by
  apply Subtype.ext
  change gerR K m q (xyMul h (r • g)) = gammaEquiv K m q r • gerR K m q (xyMul h g)
  rw [xyMul_smul, map_mul]
  rfl

private theorem sectionHom_injective (h : IsCyclicQuotientSetting K m q) :
    Function.Injective (sectionHom h) := by
  have := MvPowerSeries.isRegularLocalRing K 2
  have : IsDomain (MvPowerSeries (Fin 2) K) := IsRegularLocalRing.isDomain _
  rw [injective_iff_map_eq_zero]
  intro g hg
  have h1 : gerR K m q (xyMul h g) = gerR K m q 0 := by
    rw [map_zero]; exact congrArg Subtype.val hg
  have h4 := congrArg Subtype.val (gerR_injective h1)
  rw [coe_xyMul] at h4
  exact Subtype.ext
    ((mul_eq_zero.mp h4).resolve_left (mul_ne_zero (X_ne_zero K 0) (X_ne_zero K 1)))

private theorem divC_add_divC'_nonneg (h : IsCyclicQuotientSetting K m q) :
    0 ≤ divC h + divC' h :=
  add_nonneg (Finsupp.single_nonneg.mpr zero_le_one) (Finsupp.single_nonneg.mpr zero_le_one)

private theorem sectionHom_surjective (h : IsCyclicQuotientSetting K m q) :
    Function.Surjective (sectionHom h) := by
  classical
  intro φ
  have hφ : (-(divC h + divC' h)).IsDivisorialSection ⊤ φ.1 := φ.2
  have h0 : (0 : MMP.Mori.Divisor (Spec (ringCat K m q))).IsDivisorialSection ⊤ φ.1 :=
    hφ.mono (neg_nonpos.mpr (divC_add_divC'_nonneg h))
  obtain ⟨s, hs⟩ := MMP.Mori.Divisor.IsDivisorialSection.exists_eq h0
  set r : cyclicInvariants K m q := (Scheme.ΓSpecIso (ringCat K m q)).hom s with hrdef
  have hsr : s = (Scheme.ΓSpecIso (ringCat K m q)).inv r := by simp [hrdef]
  by_cases hr : r = 0
  · refine ⟨0, ?_⟩
    rw [map_zero]
    apply Subtype.ext
    rw [← hs, hsr, hr]
    change _ = gerR K m q 0
    rw [map_zero]
    rfl
  have hmem : ∀ E : PrimeDivisor (Spec (ringCat K m q)),
      MMP.Mori.PrimeDivisor.OrdGE E (-(MMP.Mori.DivisorWithCoeffs.coeff (-(divC h + divC' h)) E))
        ((Spec (ringCat K m q)).presheaf.germ ⊤
          (MMP.Mori.componentGenericPoint _ (MMP.Mori.PrimeDivisor.component E)) trivial
          ((Scheme.ΓSpecIso (ringCat K m q)).inv r)) := by
    intro E
    have := hφ E ⟨E.genericPoint, by
      rw [PrimeDivisor.support_eq_closure]; exact subset_closure rfl, trivial⟩
    rwa [← hs, hsr] at this
  have hx : r ∈ xIdeal K m q := by
    have := hmem (primeC h)
    rw [neg_coeff_C2, if_pos rfl, if_neg (primeC_ne_primeC' h).symm, add_zero,
      ordGE_germ_iff _ hr, genericPoint_primeC] at this
    exact (one_le_ord_xIdeal_iff h hr).mp this
  have hy : r ∈ yIdeal K m q := by
    have := hmem (primeC' h)
    rw [neg_coeff_C2, if_neg (primeC_ne_primeC' h), if_pos rfl, zero_add,
      ordGE_germ_iff _ hr, genericPoint_primeC'] at this
    exact (one_le_ord_yIdeal_iff h hr).mp this
  obtain ⟨g₀, hg₀⟩ := (X_mul_X_dvd_iff (r : MvPowerSeries (Fin 2) K)).mpr
    ⟨mem_xIdeal.mp hx, mem_yIdeal.mp hy⟩
  have hg₀ω : g₀ ∈ omegaSub K m q := (mem_omegaSub_iff_mul_mem h g₀).mpr (hg₀ ▸ r.2)
  refine ⟨⟨g₀, hg₀ω⟩, ?_⟩
  have hxy : xyMul h ⟨g₀, hg₀ω⟩ = r := Subtype.ext (by rw [coe_xyMul]; exact hg₀.symm)
  apply Subtype.ext
  change gerR K m q (xyMul h ⟨g₀, hg₀ω⟩) = φ.1
  rw [hxy, gerR_apply, ← hsr, hs]

end SectionsEquiv

/-! ### The canonical module -/

section Canonical

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat

/-- **The invariant two-forms are a dualizing module of `R`.** -/
private theorem isDualizingRingModule_omegaSub (h : IsCyclicQuotientSetting K m q)
    [IsNoetherianRing (cyclicInvariants K m q)] :
    Stacks.Duality.IsDualizingRingModule (cyclicInvariants K m q) (omegaSub K m q) := by
  have := MvPowerSeries.isRegularLocalRing K 2
  refine ⟨?_, 0, ?_⟩
  · haveI := module_finite_cyclicInvariants h
    haveI : IsNoetherian (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K) :=
      isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.IsNoetherian.finite _ _
  · have hreg : IsRegularRing (MvPowerSeries (Fin 2) K) :=
      ((IsLocalRing.isRegularRing_tfae (R := MvPowerSeries (Fin 2) K)).out 1 3).mp this
    have hdim : ringKrullDim (MvPowerSeries (Fin 2) K) = (2 : ℕ) := by
      rw [MvPowerSeries.ringKrullDim_eq]
    have hP : Dualizing.IsDualizingComplex
        ((DerivedCategory.singleFunctor (ModuleCat.{w} (MvPowerSeries (Fin 2) K)) 0).obj
          (ModuleCat.of (MvPowerSeries (Fin 2) K) (MvPowerSeries (Fin 2) K))) :=
      (Dualizing.isDualizingComplex_single_self_iff _).2
        ⟨2, Dualizing.hasInjectiveDimensionLE_of_isRegularRing _ 2 hdim⟩
    have hD := Dualizing.isDualizingComplex_derivedHom_of_finite (expandR h) (finite_moduleR h) _ hP
    exact (Dualizing.isDualizingComplex_iff_of_iso
      (derivedHomObjSingleIso (expandR h) (projective_moduleR h) _ ≪≫
        (DerivedCategory.singleFunctor (ModuleCat.{w} (cyclicInvariants K m q)) 0).mapIso
          (omegaEquiv h).toModuleIso.symm)).mp hD

private theorem exists_isDualizingRingModule (h : IsCyclicQuotientSetting K m q)
    [IsNoetherianRing (cyclicInvariants K m q)] :
    ∃ ω : Submodule (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K),
      (∀ f, f ∈ ω ↔ ∀ ζ : rootsOfUnity m K,
        (((ζ : Kˣ) ^ (1 + q) : Kˣ) : K) • MvPowerSeries.rescale (cyclicWeights K m q ζ) f = f) ∧
      Stacks.Duality.IsDualizingRingModule (cyclicInvariants K m q) ω :=
  ⟨omegaSub K m q, mem_omegaSub_iff, isDualizingRingModule_omegaSub h⟩

variable [IsNoetherianRing (cyclicInvariants K m q)]
  [IsNormal (Spec (ringCat K m q))]

private theorem isNoetherianRing_gamma : IsNoetherianRing Γ(Spec (ringCat K m q), ⊤) :=
  isNoetherianRing_of_ringEquiv _ (gammaEquiv K m q)

attribute [local instance] isNoetherianRing_gamma

/-- **The sections of `𝒪_T(-C^{(2)})` are a dualizing module of `Γ(T, 𝒪_T)`.** -/
private theorem isDualizingRingModule_sections (h : IsCyclicQuotientSetting K m q) :
    Stacks.Duality.IsDualizingRingModule Γ(Spec (ringCat K m q), ⊤)
      Γ((-(divC h + divC' h)).divisorialSheaf, ⊤) :=
  Stacks.Duality.isDualizingRingModule_of_ringEquiv (gammaEquiv K m q) (omegaSub K m q) _
    (AddEquiv.ofBijective (sectionHom h) ⟨sectionHom_injective h, sectionHom_surjective h⟩)
    (fun r g => sectionHom_smul h r g) (isDualizingRingModule_omegaSub h)

/-- A quasi-coherent module restricted to an affine open is the sheaf of its sections. -/
private noncomputable def restrictIsoTilde {X : Scheme.{w}} (F : X.Modules) [F.IsQuasicoherent]
    (U : X.Opens) (hU : IsAffineOpen U) :
    (Scheme.Modules.restrictFunctor U.ι).obj F ≅
      (Scheme.Modules.restrictFunctor hU.isoSpec.hom).obj
        ((tilde.functor Γ(X, U)).obj (ModuleCat.of Γ(X, U) Γ(F, U))) :=
  (Scheme.Modules.restrictFunctorCongr hU.isoSpec_hom_fromSpec).symm.app F ≪≫
    (Scheme.Modules.restrictFunctorComp hU.isoSpec.hom hU.fromSpec).app F ≪≫
    (Scheme.Modules.restrictFunctor hU.isoSpec.hom).mapIso
      (Stacks.Modules.tildeIsoRestrictFromSpec F hU).symm

attribute [local instance 10000] HasDerivedCategory.standard

private theorem isTildeModelOnAnyModel_single {X : Scheme.{w}} [IsLocallyNoetherian X]
    (F : X.Modules) [F.IsQuasicoherent] (U : X.Opens) (hU : IsAffineOpen U) (n : ℤ) :
    Stacks.Duality.IsTildeModelOnAnyModel ((DerivedCategory.singleFunctor X.Modules n).obj F) U hU
      ((DerivedCategory.singleFunctor (ModuleCat.{w} Γ(X, U)) n).obj
        (ModuleCat.of Γ(X, U) Γ(F, U))) :=
  ⟨((Scheme.Modules.restrictFunctor U.ι).mapDerivedCategorySingleFunctor n).app _ ≪≫
    (DerivedCategory.singleFunctor U.toScheme.Modules n).mapIso (restrictIsoTilde F U hU) ≪≫
    (((tilde.functor Γ(X, U) ⋙
      Scheme.Modules.restrictFunctor hU.isoSpec.hom).mapDerivedCategorySingleFunctor n).app
        _).symm⟩

/-- **`𝒪_T(-C^{(2)})` is a dualizing module of `T`.** -/
private theorem isDualizingModule_divisorialSheaf_neg (h : IsCyclicQuotientSetting K m q) :
    Stacks.Duality.IsDualizingModule (-(divC h + divC' h)).divisorialSheaf := by
  obtain ⟨hfin, n, hn⟩ := isDualizingRingModule_sections h
  have hTop := isAffineOpen_top (Spec (ringCat K m q))
  refine ⟨?_, n, ?_⟩
  · have hft : ((-(divC h + divC' h)).divisorialSheaf).IsFiniteType :=
      Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteType_of_cover_isFiniteTildeOn _
        (fun _ : PUnit.{w + 1} => ⊤) (by rw [TopologicalSpace.IsOpenCover, iSup_const])
        (fun _ => hTop) fun _ =>
          Stacks.AlgebraicGeometry.CoherentTFAE.isFiniteTildeOn_of_finite_specModule _ ⊤ hTop
            (Module.Finite.equiv
              (Stacks.AlgebraicGeometry.CoherentFinite.specSectionsEquiv _ hTop).symm)
    exact Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isQuasicoherent_isFiniteType _
  · exact Stacks.Duality.isDualizingComplex_of_isTildeModelOn_top hn
      (isTildeModelOnAnyModel_single _ ⊤ hTop n)

/-- **Dualizing modules over a local ring are unique.** Shifting both to normalized dualizing
complexes makes them isomorphic; comparing the single nonvanishing cohomology modules identifies
the two modules. -/
private theorem nonempty_linearEquiv_of_isDualizingRingModule {A : Type w} [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] {M N : Type w} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (hM : Stacks.Duality.IsDualizingRingModule A M)
    (hN : Stacks.Duality.IsDualizingRingModule A N) : Nonempty (M ≃ₗ[A] N) := by
  haveI : Nontrivial M :=
    Stacks.Duality.IsDualizingRingModule.nontrivial (M := ModuleCat.of A M) hM
  obtain ⟨-, n, hn⟩ := hM
  obtain ⟨-, k, hk⟩ := hN
  obtain ⟨m₁, hm₁⟩ := Dualizing.exists_isNormalizedDualizingComplex_shift.{w, w} _ hn
  obtain ⟨m₂, hm₂⟩ := Dualizing.exists_isNormalizedDualizingComplex_shift.{w, w} _ hk
  obtain ⟨e⟩ := Dualizing.IsNormalizedDualizingComplex.nonempty_iso hm₁ hm₂
  have e' : (DerivedCategory.singleFunctor (ModuleCat.{w} A) (n + m₁)).obj (ModuleCat.of A M) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{w} A) (k + m₂)).obj (ModuleCat.of A N) :=
    (((DerivedCategory.singleFunctors (ModuleCat.{w} A)).shiftIso (-m₁) (n + m₁) n
        (by ring)).app _).symm ≪≫ e ≪≫
      ((DerivedCategory.singleFunctors (ModuleCat.{w} A)).shiftIso (-m₂) (k + m₂) k
        (by ring)).app _
  generalize n + m₁ = a at e'
  generalize k + m₂ = b at e'
  obtain ⟨hvan, ⟨eH⟩⟩ := (Dualizing.exists_iso_single_iff_homology _ _ b).mp ⟨e'⟩
  let eM := (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{w} A) a).app
    (ModuleCat.of A M)
  by_cases hab : a = b
  · subst hab
    exact ⟨(eM.symm ≪≫ eH).toLinearEquiv⟩
  · exfalso
    have hz : CategoryTheory.Limits.IsZero (ModuleCat.of A M) := (hvan a hab).of_iso eM.symm
    exact not_subsingleton M (ModuleCat.isZero_iff_subsingleton.mp hz)

/-- On an affine scheme with local ring of global sections, a global function not vanishing at a
closed point is a unit. -/
private theorem isUnit_of_mem_primeCompl_of_isClosed {X : Scheme.{w}} [IsAffine X]
    [IsLocallyNoetherian X] [IsNoetherianRing Γ(X, ⊤)] [IsLocalRing Γ(X, ⊤)] {x : X}
    (hx : IsClosed ({x} : Set X))
    (y : ((isAffineOpen_top X).primeIdealOf ⟨x, trivial⟩).asIdeal.primeCompl) :
    IsUnit (y : Γ(X, ⊤)) := by
  obtain ⟨y, hy⟩ := y
  change IsUnit y
  have hy' : y ∉ ((isAffineOpen_top X).primeIdealOf ⟨(𝟙 X : X ⟶ X) x, trivial⟩).asIdeal := hy
  rw [Stacks.Duality.primeIdealOf_eq_maximalIdeal_of_isClosed (𝟙 X) hx] at hy'
  exact (IsLocalRing.mem_maximalIdeal _).not.mp hy' |> not_not.mp

/-- On an affine scheme with local ring of global sections, the germ at a closed point is an
isomorphism. -/
private theorem bijective_germ_of_isClosed {X : Scheme.{w}} [IsAffine X] [IsLocallyNoetherian X]
    [IsNoetherianRing Γ(X, ⊤)] [IsLocalRing Γ(X, ⊤)] {x : X} (hx : IsClosed ({x} : Set X)) :
    Function.Bijective (X.presheaf.germ ⊤ x trivial).hom := by
  letI := (X.presheaf.germ ⊤ x trivial).hom.toAlgebra
  have hT := isAffineOpen_top X
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x) (hT.primeIdealOf ⟨x, trivial⟩).asIdeal :=
    hT.isLocalization_stalk ⟨x, trivial⟩
  have hunit := isUnit_of_mem_primeCompl_of_isClosed hx
  let e := IsLocalization.atUnits Γ(X, ⊤) (hT.primeIdealOf ⟨x, trivial⟩).asIdeal.primeCompl
    (S := X.presheaf.stalk x) (fun y hy => hunit ⟨y, hy⟩)
  have heq : ⇑e = (X.presheaf.germ ⊤ x trivial).hom := funext e.commutes
  exact heq ▸ e.bijective

/-- On an affine scheme with local ring of global sections, the germ of a quasi-coherent module at
a closed point is an isomorphism. -/
private theorem bijective_germₗ_of_isClosed {X : Scheme.{w}} [IsAffine X] [IsLocallyNoetherian X]
    [IsNoetherianRing Γ(X, ⊤)] [IsLocalRing Γ(X, ⊤)] {x : X} (hx : IsClosed ({x} : Set X))
    (F : X.Modules)
    [F.IsQuasicoherent] :
    letI := Stacks.ModuleStalkSpecialization.sectionsStalkModule F (U := ⊤) (x := x) trivial
    Function.Bijective (Stacks.ModuleStalkSpecialization.germₗ F (U := ⊤) (x := x) trivial) := by
  letI := Stacks.ModuleStalkSpecialization.sectionsStalkModule F (U := ⊤) (x := x) trivial
  have hT := isAffineOpen_top X
  have hloc := Stacks.ModuleStalkSpecialization.isLocalizedModule_germₗ F hT (x := x) trivial
  have hunit := isUnit_of_mem_primeCompl_of_isClosed hx
  constructor
  · intro a b hab
    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq
      (S := (hT.primeIdealOf ⟨x, trivial⟩).asIdeal.primeCompl) hab
    obtain ⟨u, hu⟩ := hunit c
    simpa only [Submonoid.smul_def, ← hu, smul_smul, Units.inv_mul, one_smul] using
      congrArg (fun z => (↑u⁻¹ : Γ(X, ⊤)) • z) hc
  · intro z
    obtain ⟨⟨a, c⟩, hc⟩ := IsLocalizedModule.surj (hT.primeIdealOf ⟨x, trivial⟩).asIdeal.primeCompl
      (Stacks.ModuleStalkSpecialization.germₗ F (U := ⊤) (x := x) trivial) z
    obtain ⟨u, hu⟩ := hunit c
    refine ⟨(↑u⁻¹ : Γ(X, ⊤)) • a, ?_⟩
    rw [map_smul, ← hc]
    simp only [Submonoid.smul_def, ← hu, smul_smul, Units.inv_mul, one_smul]

/-- **A dualizing stalk at the closed point gives dualizing global sections.** -/
private theorem isDualizingRingModule_sections_of_stalk {X : Scheme.{w}} [IsAffine X]
    [IsLocallyNoetherian X] [IsNoetherianRing Γ(X, ⊤)] [IsLocalRing Γ(X, ⊤)] {x : X}
    (hx : IsClosed ({x} : Set X)) (F : X.Modules) [F.IsQuasicoherent]
    (hF : letI := Stacks.ModuleStalkSpecialization.stalkModule F x
      Stacks.Duality.IsDualizingRingModule (X.presheaf.stalk x) (F.presheaf.stalk x)) :
    Stacks.Duality.IsDualizingRingModule Γ(X, ⊤) Γ(F, ⊤) := by
  letI := Stacks.ModuleStalkSpecialization.stalkModule F x
  letI := Stacks.ModuleStalkSpecialization.sectionsStalkModule F (U := ⊤) (x := x) trivial
  have hR := bijective_germ_of_isClosed hx
  have hM := bijective_germₗ_of_isClosed hx F
  let ρ : Γ(X, ⊤) ≃+* X.presheaf.stalk x := RingEquiv.ofBijective _ hR
  let γ : Γ(F, ⊤) ≃+ F.presheaf.stalk x :=
    AddEquiv.ofBijective (Stacks.ModuleStalkSpecialization.germₗ F (U := ⊤) (x := x)
      trivial).toAddMonoidHom hM
  refine Stacks.Duality.isDualizingRingModule_of_ringEquiv ρ.symm _ _ γ.symm (fun c t => ?_) hF
  obtain ⟨a, rfl⟩ := ρ.surjective c
  obtain ⟨s, rfl⟩ := γ.surjective t
  have hsmul : ρ a • γ s = γ (a • s) :=
    (Stacks.ModuleStalkSpecialization.germ_smul F (U := ⊤) (x := x) trivial a s).symm
  rw [hsmul, AddEquiv.symm_apply_apply, RingEquiv.symm_apply_apply, AddEquiv.symm_apply_apply]

/-- Restriction along an isomorphism of schemes reflects isomorphisms of modules. -/
private theorem nonempty_iso_of_restrict_iso_of_isIso {X Y : Scheme.{w}} (f : Y ⟶ X) [IsIso f]
    {F G : X.Modules} (e : F.restrict f ≅ G.restrict f) : Nonempty (F ≅ G) := by
  let j := inv f
  have hj : j ≫ f = 𝟙 X := IsIso.inv_hom_id f
  have eM : ∀ M : X.Modules, M ≅ (M.restrict f).restrict j := fun M =>
    (Scheme.Modules.restrictFunctorId.app M).symm ≪≫
      (Scheme.Modules.restrictFunctorCongr hj.symm).app M ≪≫
      (Scheme.Modules.restrictFunctorComp j f).app M
  exact ⟨eM F ≪≫ (Scheme.Modules.restrictFunctor j).mapIso e ≪≫ (eM G).symm⟩

/-- **Quasi-coherent modules on an affine scheme with isomorphic sections are isomorphic.** -/
private theorem nonempty_iso_of_linearEquiv_sections {X : Scheme.{w}} [IsAffine X]
    (F G : X.Modules) [F.IsQuasicoherent] [G.IsQuasicoherent] (e : Γ(F, ⊤) ≃ₗ[Γ(X, ⊤)] Γ(G, ⊤)) :
    Nonempty (F ≅ G) := by
  have hT := isAffineOpen_top X
  haveI : IsIso hT.fromSpec := by rw [IsAffineOpen.fromSpec_top]; infer_instance
  exact nonempty_iso_of_restrict_iso_of_isIso hT.fromSpec
    ((Stacks.Modules.tildeIsoRestrictFromSpec F hT).symm ≪≫
      (tilde.functor Γ(X, ⊤)).mapIso e.toModuleIso ≪≫ Stacks.Modules.tildeIsoRestrictFromSpec G hT)

/-- **Every canonical divisor of `T` is linearly equivalent to `-C^{(2)}`.** -/
private theorem linearlyEquivalent_of_isDualizingModule (h : IsCyclicQuotientSetting K m q)
    (KT : MMP.Mori.Divisor (Spec (ringCat K m q)))
    (hKT : Stacks.Duality.IsDualizingModule KT.divisorialSheaf) :
    KT.LinearlyEquivalent (-(divC h + divC' h)) := by
  have := isLocalRing_cyclicInvariants K m q
  haveI : IsLocalRing Γ(Spec (ringCat K m q), ⊤) := (gammaEquiv K m q).isLocalRing
  have hx : IsClosed ({(IsLocalRing.closedPoint (cyclicInvariants K m q) :
      Spec (ringCat K m q))} : Set (Spec (ringCat K m q))) :=
    IsLocalRing.isClosed_singleton_closedPoint _
  have h1 := isDualizingRingModule_sections_of_stalk hx KT.divisorialSheaf
    (hKT.isDualizingRingModule_stalk _)
  obtain ⟨e⟩ := nonempty_linearEquiv_of_isDualizingRingModule h1 (isDualizingRingModule_sections h)
  obtain ⟨E⟩ := nonempty_iso_of_linearEquiv_sections _ _ e
  exact MMP.Flips.linearlyEquivalent_of_divisorialSheaf_iso E

end Canonical

/-! ### Assembly -/

section Assembly'

variable {K : Type w} [Field K] {m : ℕ} {q : ℤ}

attribute [local instance] idealOf_isPrime isNoetherianRing_ringCat

variable [IsNoetherianRing (cyclicInvariants K m q)]
  [IsNormal (Spec (ringCat K m q))]

open scoped Classical in
private theorem coeff_divC (h : IsCyclicQuotientSetting K m q)
    (P : PrimeDivisor (Spec (ringCat K m q))) :
    divC h P = if P.genericPoint ∈
      (cyclicQuotientImage h (MvPowerSeries.X 0) : Set (cyclicQuotientModel K m q h)) then 1
      else 0 := by
  rw [divC, Finsupp.single_apply]
  by_cases hP : P = primeC h
  · rw [if_pos hP.symm, if_pos ((genericPoint_mem_image_X_zero_iff h P).mpr hP)]
  · rw [if_neg (Ne.symm hP), if_neg (fun e => hP ((genericPoint_mem_image_X_zero_iff h P).mp e))]

open scoped Classical in
private theorem coeff_divC_add_divC' (h : IsCyclicQuotientSetting K m q)
    (P : PrimeDivisor (Spec (ringCat K m q))) :
    (divC h + divC' h) P = if P.genericPoint ∈
      (cyclicQuotientImage h (MvPowerSeries.X 0 * MvPowerSeries.X 1) :
        Set (cyclicQuotientModel K m q h)) then 1 else 0 := by
  rw [Finsupp.add_apply, divC, divC', Finsupp.single_apply, Finsupp.single_apply]
  have hmem : P.genericPoint ∈ (cyclicQuotientImage h (MvPowerSeries.X 0 * MvPowerSeries.X 1) :
      Set (cyclicQuotientModel K m q h)) ↔ P = primeC h ∨ P = primeC' h :=
    (Set.ext_iff.mp (coe_cyclicQuotientImage_mul h) P.genericPoint).trans
      (or_congr (genericPoint_mem_image_X_zero_iff h P) (genericPoint_mem_image_X_one_iff h P))
  have hne := primeC_ne_primeC' h
  by_cases h1 : P = primeC h
  · subst h1
    rw [if_pos rfl, if_neg (Ne.symm hne), if_pos (hmem.mpr (Or.inl rfl))]
    norm_num
  · by_cases h2 : P = primeC' h
    · subst h2
      rw [if_neg (Ne.symm h1), if_pos rfl, if_pos (hmem.mpr (Or.inr rfl))]
      norm_num
    · rw [if_neg (Ne.symm h1), if_neg (Ne.symm h2),
        if_neg (fun e => (hmem.mp e).elim h1 h2)]
      norm_num

private theorem isCartier_nsmul_divC_iff (h : IsCyclicQuotientSetting K m q) (n : ℕ) :
    (n • divC h).IsCartier ↔ m ∣ n := by
  rw [isCartier_iff_linearlyEquivalent_zero, ← natCast_zsmul,
    zsmul_divC_linearlyEquivalent_zero_iff h, Int.natCast_dvd_natCast]

private theorem principalDivisor_ym_eq (h : IsCyclicQuotientSetting K m q) :
    MMP.Mori.principalDivisor (ratUnit (toFF K m q (ym h)) (toFF_ne_zero (ym_ne_zero h))) =
      (m : ℤ) • (divC h + divC' h - divC h) := by
  rw [principalDivisor_ym h, add_sub_cancel_left]

private theorem isCartier_of_isDualizingModule (h : IsCyclicQuotientSetting K m q)
    (KT : MMP.Mori.Divisor (Spec (ringCat K m q)))
    (hKT : Stacks.Duality.IsDualizingModule KT.divisorialSheaf) :
    (KT + (divC h + divC' h)).IsCartier ∧
      ∀ n : ℕ, (n • (KT + divC h)).IsCartier ↔ m ∣ n := by
  have hK := linearlyEquivalent_of_isDualizingModule h KT hKT
  refine ⟨(isCartier_iff_linearlyEquivalent_zero _).mpr ?_, fun n => ?_⟩
  · have := hK.add (MMP.Mori.Divisor.LinearlyEquivalent.refl (divC h + divC' h))
    rwa [neg_add_cancel] at this
  · rw [isCartier_iff_linearlyEquivalent_zero, ← natCast_zsmul]
    have e : (KT + divC h).LinearlyEquivalent ((-1 : ℤ) • divC' h) := by
      have := hK.add (MMP.Mori.Divisor.LinearlyEquivalent.refl (divC h))
      rwa [show -(divC h + divC' h) + divC h = (-1 : ℤ) • divC' h by rw [neg_one_smul]; abel]
        at this
    have e' := LinearlyEquivalent.zsmul e n
    rw [smul_smul] at e'
    constructor
    · intro hn
      have := (zsmul_divC'_linearlyEquivalent_zero_iff h _).mp (e'.symm.trans hn)
      rw [mul_neg_one, dvd_neg] at this
      exact_mod_cast this
    · intro hn
      refine e'.trans ((zsmul_divC'_linearlyEquivalent_zero_iff h _).mpr ?_)
      rw [mul_neg_one, dvd_neg]
      exact_mod_cast hn

end Assembly'

end MMP.Flips.CyclicModelInvariants

