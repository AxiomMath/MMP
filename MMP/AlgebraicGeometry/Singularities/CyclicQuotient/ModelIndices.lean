@[expose] public section

universe u

open AlgebraicGeometry MMP.Mori

namespace MMP.Flips

open Classical in
/-- **The canonical and boundary indices of the cyclic quotient model** (FA 16.6). For
`T = T_{m,q}`: `T` is normal; `Cl(T) ≅ ℤ/m`, generated by `[C^{(1)}]`; `T` is regular iff `m = 1`;
the module of invariant forms `f dx ∧ dy` is dualizing; `-C^{(2)}` is a canonical divisor, so
`ω_T(C^{(2)})` is generated by `dx ∧ dy/(xy)`; `div(y^m) = m(C^{(2)} - C^{(1)})`, so
`ω_T(C^{(1)})^{[m]}` is generated by `(dx ∧ dy/x)^{⊗m}`; for every canonical divisor `K_T`,
`K_T + C^{(2)}` is Cartier and `K_T + C^{(1)}`, like `C^{(1)}`, has Cartier index exactly `m`. -/
@[mmp "lem_mmp_formal_cyclic_quotient_model_invariants"]
public theorem cyclicQuotientModel_invariants {K : Type u} [Field K] {m : ℕ} {q : ℤ}
    (h : IsCyclicQuotientSetting K m q) :
    ∃ (hN : IsNormal (cyclicQuotientModel K m q h))
      (hR : IsNoetherianRing (cyclicInvariants K m q)),
      haveI := hN
      haveI : IsLocallyNoetherian (cyclicQuotientModel K m q h) := isLocallyNoetherian_Spec.mpr hR
      (IsRegularLocalRing (cyclicInvariants K m q) ↔ m = 1) ∧
      (∃ ω : Submodule (cyclicInvariants K m q) (MvPowerSeries (Fin 2) K),
        (∀ f, f ∈ ω ↔ ∀ ζ : rootsOfUnity m K,
          (((ζ : Kˣ) ^ (1 + q) : Kˣ) : K) •
            MvPowerSeries.rescale (cyclicWeights K m q ζ) f = f) ∧
        Stacks.Duality.IsDualizingRingModule (cyclicInvariants K m q) ω) ∧
      ∃ C₁ C₂ : Divisor (cyclicQuotientModel K m q h),
        (∀ P : Mori.PrimeDivisor (cyclicQuotientModel K m q h), C₁ P =
          if P.genericPoint ∈
              (cyclicQuotientImage h (MvPowerSeries.X 0) : Set (cyclicQuotientModel K m q h)) then 1
          else 0) ∧
        (∀ P : Mori.PrimeDivisor (cyclicQuotientModel K m q h), C₂ P =
          if P.genericPoint ∈
              (cyclicQuotientImage h (MvPowerSeries.X 0 * MvPowerSeries.X 1) :
                Set (cyclicQuotientModel K m q h)) then 1
          else 0) ∧
        (∀ D : Divisor (cyclicQuotientModel K m q h), ∃ n : ℤ, D.LinearlyEquivalent (n • C₁)) ∧
        (∀ n : ℤ, (n • C₁).LinearlyEquivalent 0 ↔ (m : ℤ) ∣ n) ∧
        (∀ n : ℕ, (n • C₁).IsCartier ↔ m ∣ n) ∧
        Stacks.Duality.IsDualizingModule (-C₂).divisorialSheaf ∧
        (∃ s : cyclicInvariants K m q, (s : MvPowerSeries (Fin 2) K) = MvPowerSeries.X 1 ^ m ∧
          ∃ φ : (RationalFunctions (cyclicQuotientModel K m q h))ˣ,
            (φ : RationalFunctions (cyclicQuotientModel K m q h)) =
                (fun Z => (cyclicQuotientModel K m q h).presheaf.germ ⊤
                  (componentGenericPoint _ Z) trivial
                  ((Scheme.ΓSpecIso (CommRingCat.of (cyclicInvariants K m q))).inv s)) ∧
            principalDivisor φ = (m : ℤ) • (C₂ - C₁)) ∧
        ∀ KT : Divisor (cyclicQuotientModel K m q h),
          Stacks.Duality.IsDualizingModule KT.divisorialSheaf →
            (KT + C₂).IsCartier ∧ ∀ n : ℕ, (n • (KT + C₁)).IsCartier ↔ m ∣ n := by
  classical
  open CyclicModelInvariants in
  haveI hR : IsNoetherianRing (cyclicInvariants K m q) := isNoetherianRing_cyclicInvariants h
  haveI hN : IsNormal (Spec (ringCat K m q)) := isNormal_spec h
  haveI : IsNoetherianRing (ringCat K m q) := hR
  exact ⟨hN, hR, isRegularLocalRing_iff h, exists_isDualizingRingModule h, divC h,
    divC h + divC' h, coeff_divC h, coeff_divC_add_divC' h, exists_linearlyEquivalent_zsmul_divC h,
    zsmul_divC_linearlyEquivalent_zero_iff h, isCartier_nsmul_divC_iff h,
    isDualizingModule_divisorialSheaf_neg h, ⟨ym h, rfl, ratUnit _ _, coe_ratUnit_ym h,
      principalDivisor_ym_eq h⟩, isCartier_of_isDualizingModule h⟩

end MMP.Flips
