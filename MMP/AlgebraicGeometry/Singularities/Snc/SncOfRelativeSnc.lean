module

public import MMP.AlgebraicGeometry.Singularities.Snc.RelativeSncOfSnc
public import MMP.AlgebraicGeometry.Singularities.LogCanonicalOneResolution
public import MMP.AlgebraicGeometry.Resolution.MonomialIdealSNC

/-!
# Relative simple normal crossing divisors are simple normal crossing divisors

Let `f : X ⟶ Spec k` be smooth of relative dimension `n` over a perfect field `k`
and `D` a relative simple normal crossing divisor (`MMP.Mori.Divisor.IsRelativeSNC`). Then `D` is
simple normal crossing in the sense of regular systems of parameters
(`MMP.Mori.DivisorWithCoeffs.IsSNC`).

Let `x ∈ X` and let `W ∋ x` be a chart: coordinates `t₁, …, t_n` on `W` with `dt₁, …, dt_n` a
basis of `Ω_{W/k}`, the components `D_{j(i)}` through `x` cut out by `tᵢ`, `i ≤ r`, and
`Supp D ∩ W` by `t₁ ⋯ t_r`. A component `E` of `D` through `x` has its generic point in
`Supp D ∩ W`, so on a coordinate hyperplane `tᵢ = 0`, and being of codimension one it is
`D_{j(i)}`. The derivations of `Γ(W)` dual to the basis `dtᵢ` show that the classes of the
`tᵢ`, `i ≤ r`, are linearly independent in the cotangent space of the regular local ring
`𝒪_{X,x}`, so they extend to a regular system of parameters, and the ideal of `D_{j(i)}` at `x`
is generated by `tᵢ`. The components are smooth because at each of their points they are cut out
by a member of a regular system of parameters.

## Main results

* `MMP.FourfoldProofs.FractionalLogComplexProof.isSNC_of_isRelativeSNC`: the statement above.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite

namespace MMP.FourfoldProofs.FractionalLogComplexProof

open _root_.Topology MMP.Mori

variable {k : Type} [Field k] {n : ℕ} {X : Scheme.{0}} (f : X ⟶ Spec (.of k))
  [SmoothOfRelativeDimension n f]

/-- **The regular parameters of a relative snc divisor.** At every point `x`, the components of a
relative snc divisor `D` through `x` are cut out in `𝒪_{X,x}` by distinct members of a regular
system of parameters. -/
theorem exists_isRegularSystemOfParameters_of_isRelativeSNC (D : Divisor X)
    (hD : D.IsRelativeSNC n f) (x : X) :
    ∃ (d : ℕ) (z : Fin d → X.presheaf.stalk x)
      (j : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} → Fin d),
      IsRegularSystemOfParameters z ∧ Function.Injective j ∧
        ∀ E, IdealSheafData.stalk E.1.idealSheaf x = Ideal.span {z (j E)} := by
  classical
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  obtain ⟨W, V, e, t, hxW, ⟨b, hb⟩, r, hr, j, hj, hjD, hsupp⟩ := hD.2 x
  -- every component through `x` is one of the `D_{j(i)}`
  have hcomp : ∀ E : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support},
      ∃ i : Fin r, j i = E.1 := by
    intro E
    have hgen : E.1.genericPoint ∈ (W : Set X) :=
      (specializes_iff_mem_closure.2 (by
        rw [← AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact E.2.2)).mem_open
        W.1.isOpen hxW
    have hsuppE : E.1.genericPoint ∈ (D.suppIdeal.support : Set X) := by
      rw [MMP.Mori.DivisorWithCoeffs.suppIdeal, Scheme.IdealSheafData.coe_support_vanishingIdeal,
        coe_supp_eq_biUnion]
      exact Set.mem_biUnion E.2.1
        (by rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl)
    have h1 := (Scheme.IdealSheafData.coe_support_inter D.suppIdeal W).subset ⟨hsuppE, hgen⟩
    rw [hsupp, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton] at h1
    obtain ⟨i, hi⟩ : ∃ i, E.1.genericPoint ∉ X.basicOpen (t (Fin.castLE hr i)) := by
      by_contra! h
      exact h1.1 ((mem_basicOpen_prod Finset.univ _ hgen).2 fun i _ => h i)
    have h2 : E.1.genericPoint ∈ (j i).support := by
      have := (Scheme.IdealSheafData.coe_support_inter (j i).idealSheaf W).symm.subset
        ⟨by rw [(hjD i).2.2, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton]; exact hi, hgen⟩
      exact this.1
    refine ⟨i, AlgebraicGeometry.PrimeDivisor.genericPoint_injective ?_⟩
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure] at h2
    exact (MMP.Mori.Divisor.LogSpreadingProof.eq_of_specializes_of_coheight_eq_one h2
      (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint _)
      (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint _))
  choose ι hι using hcomp
  have : Fintype {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} :=
    @Fintype.ofFinite _ (Finite.of_injective (fun E => (⟨E.1, E.2.1⟩ : D.support))
      (fun a b h => Subtype.ext (by simpa using congrArg Subtype.val h)))
  have hιinj : Function.Injective ι := fun E E' h => Subtype.ext ((hι E).symm.trans
    ((congrArg j h).trans (hι E')))
  -- the coordinates of the components through `x`, at `x`
  let : Algebra Γ(Spec (.of k), V) Γ(X, W) := (f.appLE V W e).hom.toAlgebra
  let : Algebra Γ(X, W) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxW⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (W.2.primeIdealOf ⟨x, hxW⟩).asIdeal :=
    W.2.isLocalization_stalk ⟨x, hxW⟩
  set P := (W.2.primeIdealOf ⟨x, hxW⟩).asIdeal
  set s : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} → Γ(X, W) :=
    fun E => t (Fin.castLE hr (ι E))
  have hsP : ∀ E, s E ∈ P := by
    intro E
    have hx : x ∉ X.basicOpen (s E) := by
      have := (Scheme.IdealSheafData.coe_support_inter (j (ι E)).idealSheaf W).subset
        ⟨by rw [hι E]; exact E.2.2, hxW⟩
      rw [(hjD _).2.2, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton] at this
      exact this.1
    rw [← IsLocalization.AtPrime.under_maximalIdeal (X.presheaf.stalk x) P, Ideal.under,
      Ideal.mem_comap,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact fun hu => hx ((Scheme.mem_basicOpen X (s E) x hxW).2 hu)
  let δ : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} →
      Derivation Γ(Spec (.of k), V) Γ(X, W) Γ(X, W) :=
    fun E => (b.coord (Fin.castLE hr (ι E))).compDer (KaehlerDifferential.D _ _)
  have hδ : ∀ E E', δ E (s E') = if E = E' then 1 else 0 := by
    intro E E'
    have h1 : δ E (s E') = b.repr (b (Fin.castLE hr (ι E'))) (Fin.castLE hr (ι E)) := by
      change b.coord _ (KaehlerDifferential.D _ _ (t _)) = _
      rw [← hb, Module.Basis.coord_apply]
    rw [h1, Module.Basis.repr_self, Finsupp.single_apply]
    by_cases hEE : E = E'
    · subst hEE; simp
    · have hne : Fin.castLE hr (ι E') ≠ Fin.castLE hr (ι E) := fun h =>
        hEE (hιinj (Fin.castLE_injective hr h).symm)
      simp [hEE, hne]
  obtain ⟨hmem, hli⟩ := MMP.Flips.linearIndependent_toCotangent_of_derivation (B :=
    X.presheaf.stalk x) P s hsP δ hδ
  have : IsRegularLocalRing (X.presheaf.stalk x) :=
    isRegularLocalRing_stalk_of_smooth_over_field f x
  obtain ⟨d, w, c, hw, hc, hwc⟩ :=
    MMP.Flips.exists_isRegularSystemOfParameters_extend _ hmem hli
  refine ⟨d, w, c, hw, hc, fun E => ?_⟩
  rw [hwc E, IdealSheafData.stalk_eq_map_germ E.1.idealSheaf x W hxW, ← hι E, (hjD _).2.2,
    Ideal.map_span, Set.image_singleton]
  rfl

/-- **Relative simple normal crossing divisors are simple normal crossing divisors.** Let
`f : X ⟶ Spec k` be smooth of relative dimension `n` over a perfect field. A relative
snc divisor for `f` (`MMP.Mori.Divisor.IsRelativeSNC`) is snc
(`MMP.Mori.DivisorWithCoeffs.IsSNC`). -/
theorem isSNC_of_isRelativeSNC [PerfectField k] (D : Divisor X) (hD : D.IsRelativeSNC n f) :
    D.IsSNC f := by
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  refine ⟨fun E hE => ?_, exists_isRegularSystemOfParameters_of_isRelativeSNC f D hD⟩
  refine MMP.Resolution.isSmoothScheme_subscheme_of_forall_stalk_eq_span f
    ((isSmoothScheme_iff f).2 inferInstance) E.idealSheaf fun x hx => ?_
  obtain ⟨d, z, j, hz, -, hI⟩ := exists_isRegularSystemOfParameters_of_isRelativeSNC f D hD x
  exact ⟨d, z, j ⟨E, hE, hx⟩, hz, hI ⟨E, hE, hx⟩⟩

end MMP.FourfoldProofs.FractionalLogComplexProof
