module

public import MMP.AlgebraicGeometry.DeRham.Logarithmic.SncPairFiniteModel
public import MMP.AlgebraicGeometry.Morphisms.Smooth.SmoothFlagParameters
public import MMP.AlgebraicGeometry.DeRham.SNCCharts
public import MMP.AlgebraicGeometry.DeRham.FormsSectionsAlgebra

/-!
# Simple normal crossing divisors are relative simple normal crossing divisors

Let `f : X ⟶ Spec k` be smooth of relative dimension `n` over a field `k` of characteristic zero,
and let `D` be a reduced effective divisor on `X` which is simple normal crossing in the sense of
regular systems of parameters (`MMP.Mori.DivisorWithCoeffs.IsSNC`). Then `D` is a relative
simple normal crossing divisor (`MMP.Mori.Divisor.IsRelativeSNC`).

At a closed point `p`, the snc condition gives a regular system of parameters `z₁, …, z_n` of
`𝒪_{X,p}` with the components of `D` through `p` cut out by some of the `zᵢ`. In characteristic
zero the residue field of `p` is finite separable over `k`, so the `zᵢ` are local coordinates on a
neighbourhood of `p`: their differentials are a basis of `Ω_{X/k}` there. Shrinking the
neighbourhood to an affine open `W ∋ p` on which each component through `p` is cut out by its
coordinate and which misses the other components gives a weak chart of `Supp D` around `p`. Every
point of `X` specializes to a closed point (`X` is Jacobson), so lies in such a chart, and charts
for relative snc divisors are produced from weak charts by
`MMP.Mori.Divisor.LogSpreadingProof.exists_snc_chart`.

## Main results

* `MMP.FourfoldProofs.FractionalLogComplexProof.exists_weakChart_of_isSNC`: a weak chart of `Supp D`
  around a closed point.
* `MMP.FourfoldProofs.FractionalLogComplexProof.isRelativeSNC_of_isSNC`: the statement above.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite

namespace MMP.FourfoldProofs.FractionalLogComplexProof

open _root_.Topology MMP.Mori MMP.Mori.Divisor.LogSpreadingProof

/-- A point lies in the basic open of a finite product exactly when it lies in the basic open of
each factor. -/
theorem mem_basicOpen_prod {X : Scheme.{0}} {U : X.Opens} {ι : Type*} (s : Finset ι)
    (t : ι → Γ(X, U)) {y : X} (hy : y ∈ U) :
    y ∈ X.basicOpen (∏ i ∈ s, t i) ↔ ∀ i ∈ s, y ∈ X.basicOpen (t i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa [Scheme.basicOpen_of_isUnit _ isUnit_one] using hy
  | insert a s ha ih => simp [Finset.prod_insert ha, Scheme.basicOpen_mul, ih]

/-- A point of `U` lies in the zero locus of a finite product exactly when some factor
vanishes there. -/
theorem mem_zeroLocus_prod_iff {X : Scheme.{0}} {U : X.Opens} {ι : Type*} [Fintype ι]
    (t : ι → Γ(X, U)) {y : X} (hy : y ∈ U) :
    y ∈ X.zeroLocus {∏ i, t i} ↔ ∃ i, y ∉ X.basicOpen (t i) := by
  rw [Scheme.zeroLocus_singleton]
  simp [mem_basicOpen_prod Finset.univ t hy]

/-- Finitely many open neighbourhoods of a point contain a common affine open neighbourhood. -/
theorem exists_isAffineOpen_le_of_finite {X : Scheme.{0}} {ι : Type*} [Finite ι] (p : X)
    (U : ι → X.Opens) (hU : ∀ i, p ∈ U i) :
    ∃ W : X.Opens, IsAffineOpen W ∧ p ∈ W ∧ ∀ i, W ≤ U i := by
  classical
  have := Fintype.ofFinite ι
  have hp : p ∈ Finset.univ.inf U :=
    Finset.inf_induction (p := fun V : X.Opens => p ∈ V) trivial
      (fun a ha b hb => ⟨ha, hb⟩) (fun i _ => hU i)
  obtain ⟨W, hW, hpW, hWU⟩ := exists_isAffineOpen_mem_and_subset hp
  exact ⟨W, hW, hpW, fun i => (show W ≤ Finset.univ.inf U from hWU).trans
    (Finset.inf_le (Finset.mem_univ i))⟩

/-- The support of a divisor is the union of the supports of its prime components. -/
theorem coe_supp_eq_biUnion {X : Scheme.{0}} (D : Divisor X) :
    (D.supp : Set X) = ⋃ E ∈ D.support, (AlgebraicGeometry.PrimeDivisor.support E) := by
  rw [MMP.Mori.DivisorWithCoeffs.supp, TopologicalSpace.Closeds.coe_finset_sup,
    Finset.sup_set_eq_biUnion]
  rfl

/-- The prime components of a divisor satisfying a predicate form a finite type. -/
theorem finite_support_subtype {X : Scheme.{0}} (D : Divisor X)
    (P : MMP.Mori.PrimeDivisor X → Prop) :
    Finite {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ P E} :=
  Finite.of_injective (fun E => (⟨E.1, E.2.1⟩ : D.support))
    (fun a b h => Subtype.ext (by simpa using congrArg Subtype.val h))

/-- An ideal sheaf whose stalk at `x` is generated by the germ of one section `s` over `V` is,
on every affine open inside some neighbourhood `U ≤ V` of `x`, generated by the restriction
of `s`. -/
theorem exists_ideal_eq_span_singleton_of_stalk_eq {X : Scheme.{0}} [IsLocallyNoetherian X]
    (T : X.IdealSheafData) {V : X.Opens} {x : X} (hx : x ∈ V) (s : Γ(X, V))
    (hs : IdealSheafData.stalk T x = Ideal.span {(X.presheaf.germ V x hx).hom s}) :
    ∃ (U : X.Opens) (hUV : U ≤ V), x ∈ U ∧ ∀ (W : X.affineOpens) (h : W.1 ≤ U),
      T.ideal W = Ideal.span {MMP.Resolution.restrictSection W (h.trans hUV) s} := by
  obtain ⟨U, hUV, hxU, hU⟩ := MMP.Flips.ResolutionInputs.exists_ideal_eq_span_of_stalk_eq
    T hx (fun _ : Unit => s) (by rw [hs, Set.range_const])
  exact ⟨U, hUV, hxU, fun W h => by rw [hU W h, Set.range_const]⟩

/-- If each component `E` of `D` through `p` meets `W` in the zero locus of `t (eC E)`, and the
other components miss `W`, then `Supp D ∩ W` is the zero locus of the product of these `t`. -/
theorem coe_supp_inter_eq_zeroLocus_prod {X : Scheme.{0}} (D : Divisor X) (p : X)
    {W : X.Opens} {r m : ℕ} (hr : r ≤ m) (t : Fin m → Γ(X, W))
    (eC : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support} ≃ Fin r)
    (hEW : ∀ E, E.1.support ∩ (W : Set X) =
      (X.basicOpen (t (Fin.castLE hr (eC E))) : Set X)ᶜ ∩ W)
    (hWO : ∀ E ∈ D.support, p ∉ E.support → ∀ y ∈ W, y ∉ E.support) :
    (D.supp : Set X) ∩ W = X.zeroLocus {∏ i : Fin r, t (Fin.castLE hr i)} ∩ W := by
  ext y
  rw [coe_supp_eq_biUnion]
  simp only [Set.mem_inter_iff, Set.mem_iUnion, exists_prop, and_congr_left_iff]
  intro hyW
  rw [mem_zeroLocus_prod_iff _ hyW]
  constructor
  · rintro ⟨E, hE, hyE⟩
    by_cases hpE : p ∈ E.support
    · exact ⟨eC ⟨E, hE, hpE⟩, ((hEW ⟨E, hE, hpE⟩).subset ⟨hyE, hyW⟩).1⟩
    · exact absurd hyE (hWO E hE hpE y hyW)
  · rintro ⟨i, hi⟩
    exact ⟨(eC.symm i).1, (eC.symm i).2.1,
      ((hEW (eC.symm i)).symm.subset ⟨by rwa [Equiv.apply_symm_apply], hyW⟩).1⟩

variable {k : Type} [Field k] {n : ℕ} {X : Scheme.{0}} (f : X ⟶ Spec (.of k))
  [SmoothOfRelativeDimension n f]

/-- On a scheme smooth of relative dimension `n` over a field, a basis of the Kähler
differentials over a non-empty affine open has `n` elements. -/
theorem eq_of_basis_kaehlerDifferential {m : ℕ} {W : X.Opens} (hW : IsAffineOpen W) {p : X}
    (hp : p ∈ W)
    (b : letI := MMP.Mori.sectionAlgebra f W; Module.Basis (Fin m) Γ(X, W) Ω[Γ(X, W)⁄k]) :
    m = n := by
  let := MMP.Mori.sectionAlgebra f W
  let : Algebra Γ(X, W) (X.residueField p) :=
    (X.presheaf.germ W p hp ≫ X.residue p).hom.toAlgebra
  obtain ⟨-, h⟩ := MMP.DeRham.finite_finrank_tensor_kaehlerDifferential_of_locally
    (MMP.DeRham.locally_isStandardSmoothOfRelativeDimension_sectionAlgebra (m := n) f hW)
    (X.residueField p)
  rwa [Module.finrank_eq_card_basis (b.baseChange (X.residueField p)), Fintype.card_fin] at h

variable [CharZero k]

/-- **A weak chart of an snc divisor around a closed point.** Let `f : X ⟶ Spec k` be smooth of
relative dimension `n` over a field of characteristic zero and `D` an snc divisor on `X`. Every
closed point `p` lies in an affine open `W` with coordinates `t₁, …, t_n` (their differentials a
basis of `Ω_{X/k}` on `W`) such that `Supp D ∩ W` is the zero locus of `t₁ ⋯ t_r`, the `tᵢ`,
`i ≤ r`, cutting out the components of `D` through `p`. -/
theorem exists_weakChart_of_isSNC (D : Divisor X) (hD : D.IsSNC f) (p : X)
    (hp : IsClosed ({p} : Set X)) :
    ∃ c : WeakChart f n (D.supp : Set X), p ∈ (c.W : X.Opens) := by
  classical
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨m, z, j, hz, hj, hI⟩ := hD.2 p
  obtain ⟨V, hpV, x, hxz, hx⟩ :=
    MMP.Flips.ResolutionInputs.exists_isLocalCoordinatesAt_of_isRegularSystemOfParameters f p hp
      z hz
  -- each component through `p` is cut out by its coordinate near `p`
  choose U hUV hpU hU using
    fun E : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support} =>
      exists_ideal_eq_span_singleton_of_stalk_eq E.1.idealSheaf hpV (x (j E))
        (by rw [hI E, hxz])
  have := finite_support_subtype D (p ∈ ·.support)
  have := finite_support_subtype D (p ∉ ·.support)
  -- an affine neighbourhood of `p` inside all of these and missing the other components
  let O : (Unit ⊕ {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support}) ⊕
      {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∉ E.support} → X.Opens := fun
    | .inl (.inl _) => V
    | .inl (.inr E) => U E
    | .inr E => ⟨(E.1.support)ᶜ, E.1.idealSheaf.support.isClosed.isOpen_compl⟩
  obtain ⟨W, hW, hpW, hWO⟩ := exists_isAffineOpen_le_of_finite p O fun
    | .inl (.inl _) => hpV | .inl (.inr E) => hpU E | .inr E => E.2.2
  have hWV : W ≤ V := hWO (.inl (.inl ()))
  set Wa : X.affineOpens := ⟨W, hW⟩
  obtain ⟨b, hb⟩ := hx.1 Wa hWV
  obtain rfl : m = n := eq_of_basis_kaehlerDifferential f hW hpW b
  -- order the coordinates so that those of the components through `p` come first
  set r := Nat.card {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support}
  let eC := Finite.equivFin {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support}
  let g : Fin r → Fin m := fun i => j (eC.symm i)
  have hg : Function.Injective g := hj.comp eC.symm.injective
  have hr : r ≤ m := by simpa using Fintype.card_le_of_injective g hg
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair _ g (Fin.castLE_injective hr) hg
  let t' : Fin m → Γ(X, W) := fun i => MMP.Resolution.restrictSection Wa hWV (x i)
  let t : Fin m → Γ(X, W) := fun i => t' (σ i)
  have hcomp : ∀ i : Fin r, t (Fin.castLE hr i) = t' (j (eC.symm i)) := (congrArg t' <| hσ ·)
  have hEW : ∀ E : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ p ∈ E.support},
      E.1.support ∩ (W : Set X) = (X.basicOpen (t (Fin.castLE hr (eC E))) : Set X)ᶜ ∩ W := by
    intro E
    rw [hcomp, Equiv.symm_apply_apply, show E.1.support = (E.1.idealSheaf.support : Set X) from rfl,
      Scheme.IdealSheafData.coe_support_inter E.1.idealSheaf Wa, hU E Wa (hWO (.inl (.inr E))),
      Scheme.zeroLocus_span, Scheme.zeroLocus_singleton]
  refine ⟨{ W := Wa, t := t, r := r, hr := hr, basis := ?_, zero := ?_ }, hpW⟩
  · let := MMP.Mori.sectionAlgebra f W
    refine ⟨(b.reindex σ.symm).map (MMP.DeRham.kaehlerSpecEquiv f W).symm, fun i => ?_⟩
    erw [Module.Basis.map_apply, LinearEquiv.symm_apply_eq, Module.Basis.reindex_apply,
      Equiv.symm_symm, hb]
    exact (MMP.DeRham.kaehlerBaseEquiv_d _ _ _ _).symm
  · exact coe_supp_inter_eq_zeroLocus_prod D p hr t eC hEW
      fun E hE hpE _ hy => hWO (.inr ⟨E, hE, hpE⟩) hy

/-- **Simple normal crossing divisors are relative simple normal crossing divisors.** Let
`f : X ⟶ Spec k` be smooth of relative dimension `n` over a field of characteristic zero. A
divisor `D` on `X` that is snc (`MMP.Mori.DivisorWithCoeffs.IsSNC`) with all nonzero coefficients
`1` is a relative snc divisor for `f`. -/
theorem isRelativeSNC_of_isSNC (D : Divisor X) (hD : D.IsSNC f)
    (h1 : ∀ E ∈ D.support, D E = 1) : D.IsRelativeSNC n f := by
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace f
  unfold MMP.Mori.Divisor.IsRelativeSNC
  refine ⟨h1, fun y => ?_⟩
  obtain ⟨p, hpy, hp⟩ := nonempty_inter_closedPoints (Z := closure {y})
    ⟨y, subset_closure rfl⟩ isClosed_closure.isLocallyClosed
  obtain ⟨c, hpc⟩ := exists_weakChart_of_isSNC (n := n) f D hD p hp
  exact exists_snc_chart f D (exists_mem_support_genericPoint_eq D) c y
    ((specializes_iff_mem_closure.2 hpy).mem_open c.W.1.isOpen hpc)

end MMP.FourfoldProofs.FractionalLogComplexProof
