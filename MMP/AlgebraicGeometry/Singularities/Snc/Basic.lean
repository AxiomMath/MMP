module

public import MMP.AlgebraicGeometry.Divisor.Cartier
public import MMP.AlgebraicGeometry.Divisor.Coefficients
public import MMP.AlgebraicGeometry.Divisor.Cycles
public import MMP.AlgebraicGeometry.Divisor.LineBundle
public import MMP.AlgebraicGeometry.Divisor.DivisorialValuation
public import MMP.AlgebraicGeometry.Divisor.OrderPullback
public import MMP.AlgebraicGeometry.Divisor.CartierLineBundle
public import MMP.AlgebraicGeometry.Divisor.PullbackExistence
public import MMP.AlgebraicGeometry.Modules.AssociatedPoints
public import MMP.AlgebraicGeometry.Divisor.SNC

/-!
# Simple normal crossing divisors and supports (Lazarsfeld §4.1, §9.1)

Let `X` be a non-singular variety of dimension `n` over a field `k` and `D = ∑ᵢ Dᵢ` a reduced
effective divisor, the `Dᵢ` distinct prime divisors. Lazarsfeld (Def. 4.1.1) calls `D` a *simple
normal crossing* (SNC) divisor if every `Dᵢ` is non-singular and for every (closed) point `x`
there are a regular system of parameters `z₁, …, zₙ` of `𝒪_{X,x}` and `0 ≤ k ≤ n` such that the
ideal of `D` in `𝒪_{X,x}` is generated by `z₁ ⋯ z_k`. A divisor `E = ∑ aᵢ Dᵢ` (all `aᵢ ≠ 0`)
has *SNC support* when the reduced divisor `∑ Dᵢ` is SNC, and several divisors `G₁, …, G_s` have
*jointly SNC support* when `[G₁ ∪ ⋯ ∪ G_s]_red`, the sum of the prime divisors occurring in
some `G_j`, is SNC.

## Main definitions

* `MMP.Intersection.reducedDivisorOf`: `∑_{P ∈ S} P` for a finite set `S` of prime divisors.
* `MMP.Intersection.IsReducedEffective`: all coefficients are `0` or `1`.
* `MMP.Intersection.IsSNCDivisor`: Lazarsfeld's SNC divisors.
* `MMP.Intersection.reducedDivisor`, `MMP.Intersection.HasSNCSupport`: SNC support.
* `MMP.Intersection.reducedUnion`, `MMP.Intersection.HasJointSNCSupport`:
  `[G₁ ∪ ⋯ ∪ G_s]_red` and jointly SNC support.

## Implementation notes

Divisors are Weil divisors `MMP.Mori.DivisorWithCoeffs R X`, finitely supported functions on
the prime divisors (`MMP.Mori.PrimeDivisor`); on a non-singular variety these are the Cartier
divisors. The variety `X` comes with a morphism `f : X ⟶ Y` (for Lazarsfeld `Y = Spec ℂ`), and
"non-singular" for a component `Dᵢ` is smoothness over `Y` of the integral closed subscheme
`Dᵢ`, as in `MMP.Mori.DivisorWithCoeffs.IsSNC`. The standing hypothesis that `X` is a
non-singular variety is not part of the definition (a generalization).

The "points" of a scheme in Lazarsfeld are its closed points, so the local condition is asked at
the closed points `x`. A regular system of parameters of `𝒪_{X,x}` is
`MMP.Mori.IsRegularSystemOfParameters`: `dim 𝒪_{X,x}` elements generating the maximal ideal; at a
closed point of an `n`-dimensional variety `dim 𝒪_{X,x} = n`. The ideal of the reduced effective
divisor `D` in `𝒪_{X,x}` is the stalk of the ideal sheaf of its support with the reduced structure,
`MMP.Mori.DivisorWithCoeffs.suppIdeal`; for a reduced divisor on a non-singular variety this is the
ideal sheaf `𝒪_X(-D)`.
-/

@[expose] public noncomputable section

universe u

open CategoryTheory TopologicalSpace AlgebraicGeometry

namespace MMP.Intersection

open MMP.Mori (Divisor RDivisor DivisorWithCoeffs)

variable {X Y : Scheme.{u}}

/-- The reduced divisor `∑_{P ∈ S} P` on a finite set `S` of prime divisors. -/
def reducedDivisorOf (S : Finset (MMP.Mori.PrimeDivisor X)) : Divisor X :=
  ∑ P ∈ S, Finsupp.single P 1

open Classical in
/-- The coefficient of `P` in `∑_{Q ∈ S} Q` is `1` if `P ∈ S` and `0` otherwise. -/
theorem coeff_reducedDivisorOf (S : Finset (MMP.Mori.PrimeDivisor X))
    (P : MMP.Mori.PrimeDivisor X) :
    (reducedDivisorOf S).coeff P = if P ∈ S then 1 else 0 := by
  simp [reducedDivisorOf, DivisorWithCoeffs.coeff_apply, Finsupp.finsetSum_apply,
    Finsupp.single_apply, eq_comm]

/-- A divisor is *reduced effective* if every coefficient is `0` or `1`: it is `∑ᵢ Dᵢ` for
distinct prime divisors `Dᵢ`. -/
@[mmp "def_p04_snc_divisor"]
def IsReducedEffective (D : Divisor X) : Prop := ∀ P, D.coeff P = 0 ∨ D.coeff P = 1

/-- **Simple normal crossing divisors** (Lazarsfeld Def. 4.1.1). A reduced effective divisor
`D = ∑ᵢ Dᵢ` on `X` (over `Y` by `f`) is *SNC* if every component `Dᵢ` is smooth over `Y` and for
every closed point `x ∈ X` there are a regular system of parameters `z₁, …, zₙ` of `𝒪_{X,x}` and
an integer `0 ≤ k ≤ n` such that the ideal of `D` in `𝒪_{X,x}` is generated by `z₁ ⋯ z_k`. -/
@[mmp "def_p04_snc_divisor"]
def IsSNCDivisor (f : X ⟶ Y) (D : Divisor X) : Prop :=
  IsReducedEffective D ∧
    (∀ E ∈ D.support, MMP.Mori.IsSmoothScheme (E.idealSheaf.subschemeι ≫ f)) ∧
    ∀ x : X, IsClosed ({x} : Set X) →
      ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x) (k : ℕ) (hk : k ≤ n),
        MMP.Mori.IsRegularSystemOfParameters z ∧
          IdealSheafData.stalk (DivisorWithCoeffs.suppIdeal D) x =
            Ideal.span {∏ i : Fin k, z (Fin.castLE hk i)}

open Classical in
/-- The reduced divisor `∑ᵢ Dᵢ` of `E = ∑ aᵢ Dᵢ`, the `Dᵢ` the prime divisors with `aᵢ ≠ 0`. -/
@[mmp "def_p04_snc_support"]
def reducedDivisor {R : Type*} [Zero R] (E : DivisorWithCoeffs R X) : Divisor X :=
  reducedDivisorOf E.support

/-- **SNC support** (Lazarsfeld Def. 4.1.1). A divisor `E = ∑ aᵢ Dᵢ` (integral, `ℚ`- or
`ℝ`-coefficients; the `Dᵢ` distinct and all `aᵢ ≠ 0`) has *simple normal crossing support* if the
reduced divisor `∑ᵢ Dᵢ` is an SNC divisor. -/
@[mmp "def_p04_snc_support"]
def HasSNCSupport {R : Type*} [Zero R] (f : X ⟶ Y) (E : DivisorWithCoeffs R X) : Prop :=
  IsSNCDivisor f (reducedDivisor E)

open Classical in
/-- **The reduced divisor on a union of supports.** For Weil `ℝ`-divisors `G₁, …, G_s`,
`[G₁ ∪ ⋯ ∪ G_s]_red = ∑_P P`, the sum over the prime divisors `P` with `ord_P(G_j) ≠ 0` for some
`j`. -/
@[mmp "def_p09a_reduced_union"]
def reducedUnion {s : ℕ} (G : Fin s → RDivisor X) : Divisor X :=
  reducedDivisorOf (Finset.univ.biUnion fun j => (G j).support)

/-- The coefficient of `P` in `[G₁ ∪ ⋯ ∪ G_s]_red` is `1` if `ord_P(G_j) ≠ 0` for some `j`, and
`0` otherwise. -/
@[mmp "def_p09a_reduced_union"]
theorem coeff_reducedUnion {s : ℕ} (G : Fin s → RDivisor X) (P : MMP.Mori.PrimeDivisor X) :
    (reducedUnion G).coeff P = if ∃ j, (G j).coeff P ≠ 0 then 1 else 0 := by
  classical
  rw [reducedUnion, coeff_reducedDivisorOf]
  congr 1
  simp [DivisorWithCoeffs.coeff_apply]

/-- **Jointly SNC support** (Lazarsfeld Def. 9.1.7, 9.1.10, "`G₁ + ⋯ + G_s` has SNC support"):
`[G₁ ∪ ⋯ ∪ G_s]_red` is an SNC divisor. -/
@[mmp "def_p09a_snc_support_union"]
def HasJointSNCSupport {s : ℕ} (f : X ⟶ Y) (G : Fin s → RDivisor X) : Prop :=
  IsSNCDivisor f (reducedUnion G)

end MMP.Intersection
