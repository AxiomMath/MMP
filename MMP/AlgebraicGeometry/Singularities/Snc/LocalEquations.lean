module

public import MMP.AlgebraicGeometry.Singularities.Snc.Basic
public import StacksFrontier.RingTheory.RegularLocalRing.RegularParameterFactorization
public import StacksFrontier.AlgebraicGeometry.Divisors.ReducedSubschemeStalkInf
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.Stalkwise
public import StacksFrontier.AlgebraicGeometry.Chow.FibreCycles.StalkPrimes
public import StacksFrontier.AlgebraicGeometry.Chow.PointClosureHeightOneCorrespondence
public import StacksFrontier.AlgebraicGeometry.Properties.ReducedClosedSubscheme

/-!
# Local equations and sub-divisors of SNC divisors; rounding of `ℝ`-divisors (Lazarsfeld §9.1)

Let `D = ∑ᵢ Dᵢ` be a simple normal crossing divisor on `X`, the `Dᵢ` distinct prime divisors, and
`x ∈ X` a closed point. By definition the ideal of `D` in `𝒪_{X,x}` is generated by a product
`z₁ ⋯ z_k` of members of a regular system of parameters. For a component `Dᵢ` through `x`, the
ideal of `Dᵢ` in `𝒪_{X,x}` is the prime of height one corresponding to the generic point of `Dᵢ`;
it contains `z₁ ⋯ z_k`, hence some `z_j`, which is a prime element of the regular local ring
`𝒪_{X,x}`, so it is generated by `z_j`. Distinct components have distinct ideals, so this gives
an injective assignment of members of the regular system of parameters to the components of `D`
through `x`, each a local equation of its component. Consequently every reduced divisor whose
components are among those of `D` is again SNC: in a domain, the ideals generated by pairwise
non-associated prime elements intersect in the ideal generated by their product.

For a Weil `ℝ`-divisor `D` the fractional part `{D} = D - ⌊D⌋` has coefficients in `[0, 1)` and
support inside that of `D`, and `⌊D + A⌋ = ⌊D⌋ + A` for an integral divisor `A`.

## Main results

* `MMP.Intersection.IsSNCDivisor.exists_isRegularSystemOfParameters`: local equations of the
  components of an SNC divisor at a closed point are members of one regular system of parameters.
* `MMP.Intersection.IsSNCDivisor.of_support_subset`,
  `MMP.Intersection.IsSNCDivisor.reducedDivisorOf`: sub-divisors of SNC divisors are SNC.
* `MMP.Intersection.WeilRDivisor.fract_coeff_mem_Ico_and_supp_le`: coefficients and support of the
  fractional part.
* `MMP.Intersection.WeilRDivisor.roundDown_add_toRDivisor`,
  `MMP.Intersection.WeilRDivisor.toRDivisor_roundDown_add_of_isIntegral`: `⌊D + A⌋ = ⌊D⌋ + A`.

## Implementation notes

The source's standing hypothesis that `X` is a non-singular variety is replaced by `X` locally
Noetherian, which is what the argument uses: it makes the local rings Noetherian, so that a
regular system of parameters makes `𝒪_{X,x}` a regular local ring, and it lets the ideal of a
finite union of components be computed stalkwise. As in `MMP.Intersection.IsSNCDivisor`, the
points are the closed points. A local equation of a component `E` at `x` is a generator of the
ideal of `E` in `𝒪_{X,x}`, the stalk of its ideal sheaf. The rounding statements need no
hypothesis on `X`.

## References

* R. Lazarsfeld, *Positivity in algebraic geometry*, I, Def. 4.1.1, and II, §9.1
-/

@[expose] public noncomputable section

universe u

open CategoryTheory TopologicalSpace AlgebraicGeometry

namespace MMP.Intersection

open MMP.Mori (Divisor RDivisor DivisorWithCoeffs)

variable {X Y : Scheme.{u}}

/-! ### Regular systems of parameters -/

/-- Every member of a regular system of parameters of a Noetherian local ring is a prime
element. -/
theorem prime_of_isRegularSystemOfParameters {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {n : ℕ} {z : Fin n → A} (hz : MMP.Mori.IsRegularSystemOfParameters z)
    (i : Fin n) : Prime (z i) := by
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  have hgen : Ideal.ofList (List.ofFn z) = IsLocalRing.maximalIdeal A := by
    rw [← hz.1]
    exact congrArg Ideal.span (Set.ext fun a => by simp [List.mem_ofFn])
  have hlen : (List.ofFn z).length = (IsLocalRing.maximalIdeal A).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hz.2] at h
    rw [List.length_ofFn]
    exact_mod_cast h.symm
  exact IsRegularLocalRing.prime_of_mem_of_ofList_eq_maximalIdeal hgen hlen
    (List.mem_ofFn.mpr ⟨i, rfl⟩)

/-! ### Stalks of the ideal sheaves of prime divisors -/

/-- A prime divisor is cut out by the vanishing ideal of its support. -/
theorem vanishingIdeal_support_idealSheaf (E : MMP.Mori.PrimeDivisor X) :
    Scheme.IdealSheafData.vanishingIdeal E.idealSheaf.support = E.idealSheaf := by
  have := E.integral
  exact (Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ rfl).symm

/-- At a point `x` of a prime divisor `E`, the ideal of `E` in `𝒪_{X,x}` is the prime ideal
corresponding to the generic point of `E`; it has height one. -/
theorem exists_stalk_idealSheaf_eq_of_mem_support (E : MMP.Mori.PrimeDivisor X) {x : X}
    (hx : x ∈ E.support) :
    ∃ q : PrimeSpectrum (X.presheaf.stalk x), X.fromSpecStalk x q = E.genericPoint ∧
      IdealSheafData.stalk E.idealSheaf x = q.asIdeal ∧ q.asIdeal.height = 1 := by
  have hsp : E.genericPoint ⤳ x := by
    rwa [specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  obtain ⟨q, hq⟩ := Stacks.Chow.exists_fromSpecStalk_eq hsp
  refine ⟨q, hq, ?_, ?_⟩
  · have hcl : (E.idealSheaf.support : Closeds X) =
        Closeds.closure ({X.fromSpecStalk x q} : Set X) := Closeds.ext <| by
      rw [Closeds.coe_closure, hq]
      exact AlgebraicGeometry.PrimeDivisor.support_eq_closure E
    rw [← MMP.Intersection.vanishingIdeal_support_idealSheaf E, hcl]
    exact Stacks.Chow.idealStalk_vanishingIdeal_closure_fromSpecStalk x q
  · rw [← Stacks.Chow.coheight_fromSpecStalk_eq_height, hq]
    exact MMP.Mori.PrimeDivisor.coheight_genericPoint E

/-- Away from a prime divisor `E`, the ideal of `E` in `𝒪_{X,x}` is the unit ideal. -/
theorem stalk_idealSheaf_eq_top_of_notMem_support (E : MMP.Mori.PrimeDivisor X) {x : X}
    (hx : x ∉ E.support) : IdealSheafData.stalk E.idealSheaf x = ⊤ :=
  (Stacks.Divisors.stalk_eq_top_iff_notMem_support E.idealSheaf x).mpr hx

/-- The ideal sheaf of the reduced support of a divisor is the intersection of the ideal sheaves
of its components. -/
theorem suppIdeal_eq_finsetInf {R : Type*} [Zero R] (D : DivisorWithCoeffs R X) :
    DivisorWithCoeffs.suppIdeal D = D.support.inf fun E => E.idealSheaf := by
  classical
  rw [DivisorWithCoeffs.suppIdeal, DivisorWithCoeffs.supp]
  induction D.support using Finset.induction_on with
  | empty => simp
  | insert E s hE ih =>
    rw [Finset.sup_insert, Finset.inf_insert, Scheme.IdealSheafData.vanishingIdeal_sup, ih,
      MMP.Intersection.vanishingIdeal_support_idealSheaf E]

/-- On a locally Noetherian scheme the ideal induced in a local ring by a finite intersection of
ideal sheaves is the intersection of the induced ideals. -/
theorem stalk_finsetInf [IsLocallyNoetherian X] {ι : Type*} (s : Finset ι)
    (I : ι → X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (s.inf I) x = s.inf fun i => IdealSheafData.stalk (I i) x := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.inf_empty, Finset.inf_empty]
    refine (Stacks.Divisors.stalk_eq_top_iff_notMem_support (⊤ : X.IdealSheafData) x).mpr ?_
    rw [Scheme.IdealSheafData.support_top]
    exact fun h => (h : x ∈ (∅ : Set X))
  | insert i s hi ih =>
    rw [Finset.inf_insert, Finset.inf_insert, ← ih]
    have h := IdealSheafData.stalk_iInf_fin ![I i, s.inf I] x
    have h2 : ∀ {α : Type _} [CompleteLattice α] (g : Fin 2 → α), (⨅ j, g j) = g 0 ⊓ g 1 :=
      fun g => le_antisymm (le_inf (iInf_le _ 0) (iInf_le _ 1))
        (le_iInf fun j => by fin_cases j <;> simp)
    rw [h2] at h
    simpa using h.trans (h2 fun j => IdealSheafData.stalk (![I i, s.inf I] j) x)

open Classical in
/-- On a locally Noetherian scheme, the ideal of the reduced support of a divisor in `𝒪_{X,x}`
is the intersection of the ideals of its components through `x`. -/
theorem stalk_suppIdeal [IsLocallyNoetherian X] {R : Type*} [Zero R]
    (D : DivisorWithCoeffs R X) (x : X) :
    IdealSheafData.stalk (DivisorWithCoeffs.suppIdeal D) x =
      (D.support.filter fun E => x ∈ E.support).inf
        fun E => IdealSheafData.stalk E.idealSheaf x := by
  rw [suppIdeal_eq_finsetInf, stalk_finsetInf]
  refine le_antisymm (Finset.le_inf fun E hE => Finset.inf_le (Finset.mem_filter.mp hE).1)
    (Finset.le_inf fun E hE => ?_)
  by_cases hx : x ∈ E.support
  · exact Finset.inf_le (Finset.mem_filter.mpr ⟨hE, hx⟩)
  · rw [stalk_idealSheaf_eq_top_of_notMem_support E hx]
    exact le_top

/-- At a point `x`, distinct prime divisors through `x` have distinct ideals in `𝒪_{X,x}`. -/
theorem eq_of_stalk_idealSheaf_eq {E E' : MMP.Mori.PrimeDivisor X} {x : X}
    (hE : x ∈ E.support) (hE' : x ∈ E'.support)
    (h : IdealSheafData.stalk E.idealSheaf x = IdealSheafData.stalk E'.idealSheaf x) :
    E = E' := by
  obtain ⟨q, hq, hqE, -⟩ := exists_stalk_idealSheaf_eq_of_mem_support E hE
  obtain ⟨q', hq', hqE', -⟩ := exists_stalk_idealSheaf_eq_of_mem_support E' hE'
  obtain rfl : q = q' := PrimeSpectrum.ext (hqE.symm.trans (h.trans hqE'))
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective (hq.symm.trans hq')

/-! ### Products of non-associated primes -/

/-- In a domain, the ideals generated by pairwise non-associated prime elements `p i`, `i ∈ s`,
intersect in the ideal generated by their product. -/
theorem finsetInf_span_singleton_eq_span_prod {R : Type*} [CommRing R] [IsDomain R]
    {ι : Type*} (s : Finset ι) (p : ι → R) (hp : ∀ i ∈ s, Prime (p i))
    (hinj : ∀ i ∈ s, ∀ j ∈ s, Associated (p i) (p j) → i = j) :
    (s.inf fun i => Ideal.span {p i}) = Ideal.span {∏ i ∈ s, p i} := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    have hp' : ∀ i ∈ s, Prime (p i) := fun i hi => hp i (Finset.mem_insert_of_mem hi)
    rw [Finset.inf_insert, ih hp' fun i hi j hj => hinj i (Finset.mem_insert_of_mem hi) j
      (Finset.mem_insert_of_mem hj), Finset.prod_insert ha]
    have hpa := hp a (Finset.mem_insert_self a s)
    have hndvd : ¬ p a ∣ ∏ i ∈ s, p i := by
      intro hdvd
      obtain ⟨i, hi, hai⟩ := (Prime.dvd_finsetProd_iff hpa _).mp hdvd
      have := hinj a (Finset.mem_insert_self a s) i (Finset.mem_insert_of_mem hi)
        (hpa.associated_of_dvd (hp' i hi) hai)
      exact ha (this ▸ hi)
    apply le_antisymm
    · intro c hc
      obtain ⟨hc₁, hc₂⟩ := Submodule.mem_inf.mp hc
      rw [Ideal.mem_span_singleton] at hc₁ hc₂ ⊢
      obtain ⟨d, rfl⟩ := hc₂
      obtain ⟨e, rfl⟩ := (hpa.dvd_or_dvd hc₁).resolve_left hndvd
      exact ⟨e, by ring⟩
    · rw [le_inf_iff, Ideal.span_singleton_le_span_singleton,
        Ideal.span_singleton_le_span_singleton]
      exact ⟨dvd_mul_right _ _, dvd_mul_left _ _⟩

/-! ### Local equations of SNC divisors -/

/-- **Local equations of SNC divisors.** Let `D = ∑ᵢ Dᵢ` be an SNC divisor on a locally
Noetherian scheme `X` and `x ∈ X` a closed point. Then there are a regular system of parameters
`w₁, …, wₙ` of `𝒪_{X,x}` and an injective map `σ` from the components of `D` through `x` to
`{1, …, n}` such that `w_{σ(i)}` is a local equation of `Dᵢ` at `x`, i.e. generates the ideal of
`Dᵢ` in `𝒪_{X,x}`. -/
@[mmp "lem_p09a_snc_local_equations"]
theorem IsSNCDivisor.exists_isRegularSystemOfParameters [IsLocallyNoetherian X] {f : X ⟶ Y}
    {D : Divisor X} (hD : IsSNCDivisor f D) (x : X) (hx : IsClosed ({x} : Set X)) :
    ∃ (n : ℕ) (w : Fin n → X.presheaf.stalk x)
      (σ : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support} → Fin n),
      MMP.Mori.IsRegularSystemOfParameters w ∧ Function.Injective σ ∧
        ∀ E, IdealSheafData.stalk E.1.idealSheaf x = Ideal.span {w (σ E)} := by
  classical
  obtain ⟨n, z, k, hk, hz, hI⟩ := hD.2.2 x hx
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hz
  have := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  have key : ∀ E : {E : MMP.Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support},
      ∃ i : Fin k, IdealSheafData.stalk E.1.idealSheaf x =
        Ideal.span {z (Fin.castLE hk i)} := by
    rintro ⟨E, hED, hxE⟩
    obtain ⟨q, -, hqE, hq1⟩ := exists_stalk_idealSheaf_eq_of_mem_support E hxE
    have hprod : (∏ i : Fin k, z (Fin.castLE hk i)) ∈ q.asIdeal := by
      rw [← hqE]
      have hle : IdealSheafData.stalk (DivisorWithCoeffs.suppIdeal D) x ≤
          IdealSheafData.stalk E.idealSheaf x := by
        rw [stalk_suppIdeal]
        exact Finset.inf_le (Finset.mem_filter.mpr ⟨hED, hxE⟩)
      exact hle (hI ▸ Ideal.mem_span_singleton_self _)
    obtain ⟨i, -, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := q.isPrime)).mp hprod
    exact ⟨i, hqE.trans (Ideal.eq_span_singleton_of_height_eq_one hq1 hi
      (prime_of_isRegularSystemOfParameters hz _))⟩
  choose i hi using key
  refine ⟨n, z, fun E => Fin.castLE hk (i E), hz, fun E E' hEE' => Subtype.ext ?_, hi⟩
  refine eq_of_stalk_idealSheaf_eq E.2.2 E'.2.2 ?_
  rw [hi E, hi E']
  exact congrArg (fun j => Ideal.span {z j}) hEE'

/-! ### Sub-divisors of SNC divisors -/

/-- **Sub-divisors of SNC divisors.** On a locally Noetherian scheme, a reduced effective
divisor whose components are among those of an SNC divisor is an SNC divisor. -/
@[mmp "lem_p09a_snc_subdivisor"]
theorem IsSNCDivisor.of_support_subset [IsLocallyNoetherian X] {f : X ⟶ Y} {D D' : Divisor X}
    (hD : IsSNCDivisor f D) (hD' : IsReducedEffective D') (h : D'.support ⊆ D.support) :
    IsSNCDivisor f D' := by
  classical
  refine ⟨hD', fun E hE => hD.2.1 E (h hE), fun x hx => ?_⟩
  obtain ⟨n, w, σ, hw, hσ, hloc⟩ := hD.exists_isRegularSystemOfParameters x hx
  have := MMP.Mori.isRegularLocalRing_of_isRegularSystemOfParameters hw
  have := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
  set T := D'.support.filter fun E => x ∈ E.support with hT
  have hTD : ∀ E ∈ T, E ∈ D.support ∧ x ∈ E.support := fun E hE =>
    ⟨h (Finset.mem_filter.mp hE).1, (Finset.mem_filter.mp hE).2⟩
  -- the indices of the components of `D'` through `x`
  let σ' : T → Fin n := fun E => σ ⟨E.1, hTD E.1 E.2⟩
  have hσ' : Function.Injective σ' := fun E E' hEE' => by
    have h' := congrArg Subtype.val (hσ hEE')
    exact Subtype.ext h'
  let g : Fin T.card → Fin n := σ' ∘ T.equivFin.symm
  have hg : Function.Injective g := hσ'.comp T.equivFin.symm.injective
  have hk : T.card ≤ n := by simpa using Fintype.card_le_of_injective g hg
  -- a permutation of `{1, …, n}` putting these indices first
  let e : {j : Fin n // j ∈ Set.range (Fin.castLE hk)} ≃ {j : Fin n // j ∈ Set.range g} :=
    (Equiv.ofInjective _ (Fin.castLE_injective hk)).symm.trans (Equiv.ofInjective g hg)
  let π : Equiv.Perm (Fin n) := e.extendSubtype
  have hπ : ∀ i, π (Fin.castLE hk i) = g i := by
    intro i
    rw [Equiv.extendSubtype_apply_of_mem e _ ⟨i, rfl⟩]
    simp [e]
  refine ⟨n, w ∘ π, T.card, hk, ⟨?_, hw.2⟩, ?_⟩
  · rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ]
    exact hw.1
  · rw [stalk_suppIdeal, ← hT]
    let p : MMP.Mori.PrimeDivisor X → X.presheaf.stalk x := fun E =>
      if hE : E ∈ T then w (σ' ⟨E, hE⟩) else 1
    have hpT : ∀ E (hE : E ∈ T), p E = w (σ' ⟨E, hE⟩) := fun E hE => by simp [p, hE]
    have hspan : ∀ E ∈ T, IdealSheafData.stalk E.idealSheaf x = Ideal.span {p E} :=
      fun E hE => hpT E hE ▸ hloc ⟨E, hTD E hE⟩
    rw [Finset.inf_congr rfl hspan, finsetInf_span_singleton_eq_span_prod]
    · refine congrArg (fun r => Ideal.span {r}) ?_
      rw [← Finset.prod_coe_sort T]
      refine (Fintype.prod_equiv T.equivFin.symm (fun i => (w ∘ π) (Fin.castLE hk i))
        (fun E : T => p E) fun i => ?_).symm
      rw [Function.comp_apply, hπ i, hpT _ (T.equivFin.symm i).2]
      rfl
    · intro E hE
      rw [hpT E hE]
      exact prime_of_isRegularSystemOfParameters hw _
    · intro E hE E' hE' hass
      refine eq_of_stalk_idealSheaf_eq (hTD E hE).2 (hTD E' hE').2 ?_
      rw [hspan E hE, hspan E' hE']
      exact Ideal.span_singleton_eq_span_singleton.mpr hass

/-- The reduced divisor `∑_{P ∈ S} P` is reduced effective. -/
theorem isReducedEffective_reducedDivisorOf (S : Finset (MMP.Mori.PrimeDivisor X)) :
    IsReducedEffective (reducedDivisorOf S) := by
  classical
  intro P
  rw [coeff_reducedDivisorOf]
  split_ifs <;> simp

/-- The components of `∑_{P ∈ S} P` are the members of `S`. -/
theorem support_reducedDivisorOf (S : Finset (MMP.Mori.PrimeDivisor X)) :
    (reducedDivisorOf S).support = S := by
  classical
  ext P
  rw [Finsupp.mem_support_iff, ← DivisorWithCoeffs.coeff_apply, coeff_reducedDivisorOf]
  split_ifs with h <;> simp [h]

/-- **Sub-divisors of SNC divisors**, in the source's form: if `D` is an SNC divisor on a locally
Noetherian scheme and `J` is a set of components of `D`, then `∑_{P ∈ J} P` is an SNC divisor. -/
@[mmp "lem_p09a_snc_subdivisor"]
theorem IsSNCDivisor.reducedDivisorOf [IsLocallyNoetherian X] {f : X ⟶ Y} {D : Divisor X}
    (hD : IsSNCDivisor f D) {J : Finset (MMP.Mori.PrimeDivisor X)} (hJ : J ⊆ D.support) :
    IsSNCDivisor f (MMP.Intersection.reducedDivisorOf J) :=
  hD.of_support_subset (isReducedEffective_reducedDivisorOf J)
    ((support_reducedDivisorOf J).symm ▸ hJ)

/-! ### Rounding -/

namespace WeilRDivisor

/-- The coefficient of `{D}` at a prime divisor `P` is the fractional part of the coefficient of
`D` at `P`. -/
@[simp]
theorem coeff_fract (D : RDivisor X) (P : MMP.Mori.PrimeDivisor X) :
    (fract D).coeff P = Int.fract (D.coeff P) := by
  rw [fract, DivisorWithCoeffs.coeff_sub, MMP.Mori.Divisor.coeff_toRDivisor, coeff_roundDown]
  rfl

/-- The support of the fractional part `{D}` is contained in the support of `D`. -/
theorem supp_fract_le (D : RDivisor X) : (fract D).supp ≤ D.supp := by
  intro x hx
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hx
  refine DivisorWithCoeffs.mem_supp_iff.mpr ⟨E, fun h => hE ?_, hxE⟩
  simp [h]

/-- **Coefficients of the fractional part** (Lazarsfeld Def. 9.1.2): `0 ≤ ord_P({D}) < 1` for
every prime divisor `P`, and `Supp {D} ⊆ Supp D`. -/
@[mmp "lem_p09a_fractional_part_coefficients"]
theorem fract_coeff_mem_Ico_and_supp_le (D : RDivisor X) :
    (∀ P, 0 ≤ (fract D).coeff P ∧ (fract D).coeff P < 1) ∧ (fract D).supp ≤ D.supp :=
  ⟨fun P => by
    rw [coeff_fract]
    exact ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩,
    supp_fract_le D⟩

/-- **Rounding and integral divisors**: `⌊D + A⌋ = ⌊D⌋ + A` for an integral divisor `A`. -/
@[mmp "lem_p09a_round_down_add_integral"]
theorem roundDown_add_toRDivisor (D : RDivisor X) (A : Divisor X) :
    roundDown (D + MMP.Mori.Divisor.toRDivisor A) = roundDown D + A := by
  ext P
  simp [DivisorWithCoeffs.coeff_add, MMP.Mori.Divisor.coeff_toRDivisor]

/-- `⌊D + A⌋ = ⌊D⌋ + A` for a Weil `ℝ`-divisor `A` that is integral. -/
@[mmp "lem_p09a_round_down_add_integral"]
theorem toRDivisor_roundDown_add_of_isIntegral (D : RDivisor X) {A : RDivisor X}
    (hA : IsIntegral A) :
    MMP.Mori.Divisor.toRDivisor (roundDown (D + A)) =
      MMP.Mori.Divisor.toRDivisor (roundDown D) + A := by
  obtain ⟨A', rfl⟩ := (isIntegral_iff_mem_range A).mp hA
  rw [roundDown_add_toRDivisor, map_add]

end WeilRDivisor

end MMP.Intersection
