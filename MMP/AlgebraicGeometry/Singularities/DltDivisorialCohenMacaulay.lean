/-! ### Bertini on a smooth variety, in Weil-divisor form -/

section Bertini

private theorem support_sum_single {Y : Scheme.{0}} (S : Finset (PrimeDivisor Y)) :
    (∑ F ∈ S, Finsupp.single F (1 : ℤ)).support = S := by
  classical
  ext F; simp [Finsupp.finsetSum_apply, Finsupp.single_apply]

private theorem genericPoint_mem_support {Y : Scheme.{0}} (F : PrimeDivisor Y) :
    F.genericPoint ∈ F.support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]; exact subset_closure rfl

/-- A general linear combination of finitely many sections, one of them nonzero, is nonzero:
the coefficient vectors `c` with `∑ cᵢ sᵢ = 0` form a proper subspace of `kⁱ`, contained in the
kernel of a linear form `ℓ` with `ℓ(e_j) ≠ 0`. -/
private theorem exists_polynomial_sum_smul_ne_zero {k : Type} [Field k] {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {H : Divisor X} {ι : Type*} [Fintype ι] (s : ι → H.divisorialSubmodule ⊤) (j : ι)
    (hj : s j ≠ 0) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      (∑ i, scalarsToGlobalSections k sX (c i) • s i) ≠ 0 := by
  classical
  let p : Submodule k (ι → k) :=
    { carrier := {c | ∑ i, scalarsToGlobalSections k sX (c i) • s i = 0}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq, Pi.add_apply, map_add, add_smul,
          Finset.sum_add_distrib] at *
        rw [ha, hb, add_zero]
      zero_mem' := by simp
      smul_mem' := by
        intro a c hc
        simp only [Set.mem_setOf_eq, Pi.smul_apply, smul_eq_mul, map_mul, mul_smul] at *
        rw [← Finset.smul_sum, hc, smul_zero] }
  have hjp : (Pi.single j 1 : ι → k) ∉ p := by
    intro h
    apply hj
    have : ∑ i, scalarsToGlobalSections k sX ((Pi.single j 1 : ι → k) i) • s i = 0 := h
    rwa [Finset.sum_eq_single j (fun i _ hi => by simp [Pi.single_apply, hi]) (by simp),
      Pi.single_eq_same, map_one, one_smul] at this
  obtain ⟨ℓ, hℓ, hp⟩ := Submodule.exists_le_ker_of_notMem hjp
  let Q : MvPolynomial ι k :=
    ∑ i, MvPolynomial.C (ℓ (fun j => if i = j then 1 else 0)) * MvPolynomial.X i
  have heval : ∀ c, MvPolynomial.eval c Q = ℓ c := by
    intro c
    rw [LinearMap.pi_apply_eq_sum_univ ℓ c]
    simp [Q, MvPolynomial.eval_sum, mul_comm]
  refine ⟨Q, fun h => hℓ (by rw [← heval, h, map_zero]), fun c hc h0 => hc ?_⟩
  rw [heval]
  exact hp (show c ∈ p from h0)

/-- The invertibility of `L` in the spelling the zero scheme takes. -/
local instance isInvertible_of_isInvertibleModule {Y : Scheme.{0}} (L : Y.Modules)
    [h : Stacks.Ample.IsInvertibleModule Y L] :
    SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property L := h

end Bertini

/-! ### Global generation on the smooth open -/

/-- In a local ring, if `∑ aᵢ bᵢ = 1` then some `bᵢ` is a unit. -/
private theorem exists_isUnit_of_sum_mul_eq_one {R : Type*} [CommRing R] [IsLocalRing R]
    {ι : Type*} (s : Finset ι) (a b : ι → R) (h : ∑ i ∈ s, a i * b i = 1) :
    ∃ i ∈ s, IsUnit (b i) := by
  by_contra hne
  push Not at hne
  apply (IsLocalRing.maximalIdeal.isMaximal R).ne_top
  rw [Ideal.eq_top_iff_one, ← h]
  exact Ideal.sum_mem _ fun i hi =>
    Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hne i hi))

section GlobalGeneration

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- **A generating family has a member whose divisor of zeros misses a point where the divisor
is Cartier.** If the global sections `sᵢ` generate `𝒪_X(D)` and `ψ` is a local equation of `D`
near `x`, write `sᵢ = gᵢ ψ⁻¹` near `x`; since the germs of the `sᵢ` span the stalk, some `gᵢ` is a
unit at `x`, and then `(sᵢ)₀ = div(gᵢ)` misses `x`. -/
private theorem exists_notMem_supp_zeroDivisor {D : Divisor X}
    (σ : D.divisorialSheaf.GeneratingSections) [Finite σ.I] {W : X.Opens}
    {ψ : (RationalFunctions X)ˣ} (hψ : D.IsLocalEquation W ψ) {x : X} (hx : x ∈ W) :
    ∃ i, ∃ hi : ((σ.s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0,
      x ∉ (D.zeroDivisor _ hi).supp := by
  classical
  have hspan := (AlgebraicGeometry.generates_iff_stalkwise_generates _ _ σ.s).mp σ.epi x
  have hfin : Finite σ.I := inferInstance
  revert hspan hfin
  obtain ⟨I, s, -⟩ := σ
  intro hspan hfin
  haveI := Fintype.ofFinite I
  dsimp only at hspan ⊢
  set b : Γ(D.divisorialSheaf, W) := hψ.invSection with hb
  have hgen := hψ.isLocalGenerator_invSection
  have hs : ∀ i, ∃ g : Γ(X, W), g • D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b =
      D.divisorialSheaf.presheaf.map (homOfLE le_top).op ((s i).eval (Opposite.op ⊤)) :=
    fun i => (hgen W le_rfl).2 _
  choose g hg using hs
  have hbW : D.divisorialSheaf.presheaf.map (homOfLE (le_refl W)).op b = b := by
    have h1 : (homOfLE (le_refl W)).op = 𝟙 (Opposite.op W) := rfl
    rw [h1, CategoryTheory.Functor.map_id]; rfl
  rw [hbW] at hg
  set G := TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf W x hx
  have hmem : G b ∈
      Submodule.span (TopCat.Presheaf.stalk (C := RingCat.{0}) X.ringCatSheaf.obj x)
        (Set.range fun i => (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
          ((s i).eval (Opposite.op ⊤))) := by
    rw [hspan]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  have hgerm : ∀ i, (TopCat.Presheaf.Γgerm D.divisorialSheaf.val.presheaf x).hom
      ((s i).eval (Opposite.op ⊤)) = G.hom (g i • b) := by
    intro i
    rw [hg i]
    exact (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top) x hx _).symm
  have hsm : ∀ i, G.hom (g i • b) = (TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj
      W x hx).hom (g i) • G.hom b := fun i =>
    PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x W hx (g i) b
  simp only [hgerm, hsm, smul_smul, ← Finset.sum_smul] at hc
  set RG := TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj W x hx
  set r := ∑ i, c i * RG.hom (g i) with hr
  -- `𝒪_X(D)_x` is torsion free over `𝒪_{X,x}` along the frame `ψ⁻¹`
  have hr1 : r = 1 := by
    have h0 : (1 - r) • G.hom b = 0 := by rw [sub_smul, one_smul, hc, sub_self]
    obtain ⟨V, hVW, hxV, a, ha⟩ := TopCat.Presheaf.exists_le_germ_eq _ (1 - r) hx
    have e1 := PresheafOfModules.germ_ringCat_smul D.divisorialSheaf.val x V hxV a
      (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b)
    have e2 := TopCat.Presheaf.germ_res_apply D.divisorialSheaf.val.presheaf (homOfLE hVW) x
      hxV b
    rw [ha, e2] at e1
    have e3 : (1 - r) • G.hom b =
        (TopCat.Presheaf.germ D.divisorialSheaf.val.presheaf V x hxV).hom 0 := by
      rw [h0, map_zero]
    obtain ⟨W', hxW', i1, i2, he⟩ := TopCat.Presheaf.germ_eq _ x hxV hxV _ _ (e1.trans e3)
    have hle : W' ≤ W := i1.le.trans hVW
    rw [map_zero] at he
    have he2 := (PresheafOfModules.map_smul D.divisorialSheaf.val i1.op a _).symm.trans he
    have ha0 : X.presheaf.map i1.op a = 0 := by
      refine (hgen W' hle).1 ?_
      change _ • _ = (0 : Γ(X, W')) • _
      rw [zero_smul]
      have hcomp : D.divisorialSheaf.val.map i1.op
          (D.divisorialSheaf.val.presheaf.map (homOfLE hVW).op b) =
          D.divisorialSheaf.presheaf.map (homOfLE hle).op b := rfl
      rw [hcomp] at he2
      exact he2
    have h5 : (1 : _) - r = 0 := ha.symm.trans
      ((TopCat.Presheaf.germ_res_apply _ i1 x hxW' a).symm.trans
        ((congrArg (TopCat.Presheaf.germ (C := RingCat.{0}) X.ringCatSheaf.obj W' x hxW').hom ha0).trans
          (map_zero _)))
    exact (sub_eq_zero.mp h5).symm
  -- some `gᵢ` is a unit at `x`
  obtain ⟨i, -, hu⟩ : ∃ i ∈ Finset.univ, IsUnit ((X.presheaf.germ W x hx).hom (g i)) := by
    have hge : ∀ i, SemilinearStalk.commStalkRingEquiv X.presheaf x (RG.hom (g i)) =
        (X.presheaf.germ W x hx).hom (g i) := fun i =>
      SemilinearStalk.commStalkRingEquiv_germ X.presheaf x W hx (g i)
    set e := SemilinearStalk.commStalkRingEquiv X.presheaf x
    have h1 : ∑ i, e (c i) * (X.presheaf.germ W x hx).hom (g i) = 1 := by
      have h2 : e r = 1 := (congrArg e hr1).trans (map_one e)
      have h3 : e r = ∑ i, e (c i * RG.hom (g i)) := map_sum e _ _
      have h4 : ∀ i, e (c i * RG.hom (g i)) = e (c i) * (X.presheaf.germ W x hx).hom (g i) :=
        fun i => (map_mul e _ _).trans (congrArg _ (hge i))
      simp only [h4] at h3
      exact h3.symm.trans h2
    exact exists_isUnit_of_sum_mul_eq_one Finset.univ _ _ h1
  have hxg : x ∈ X.basicOpen (g i) := (X.mem_basicOpen (g i) x hx).mpr hu
  -- the values of `sᵢ` near `x`
  have hval : ∀ (Z : irreducibleComponents X) (hZ : componentGenericPoint X Z ∈ W),
      ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤).1 ⟨Z, trivial⟩ =
        (X.presheaf.germ W _ hZ).hom (g i) *
          ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) Z := by
    intro Z hZ
    have := congrArg (fun m : D.divisorialSubmodule W => m.1 ⟨Z, hZ⟩) (hg i)
    simp only [Submodule.coe_smul, rationalFunctions_smul_apply] at this
    exact this.symm
  have hunit : ∀ y (hy : y ∈ X.basicOpen (g i)),
      IsUnit ((X.presheaf.germ W y (X.basicOpen_le _ hy)).hom (g i)) := fun y hy =>
    (X.mem_basicOpen (g i) y (X.basicOpen_le _ hy)).mp hy
  have hZ₀ : componentGenericPoint X (pointComponent x) ∈ X.basicOpen (g i) :=
    ((isGenericPoint_componentGenericPoint X _).specializes
      (mem_pointComponent x)).mem_open (X.basicOpen _).isOpen hxg
  have hi : ((s i).eval (Opposite.op ⊤) : D.divisorialSubmodule ⊤) ≠ 0 := by
    intro h0
    have h2 := hval (pointComponent x) (X.basicOpen_le _ hZ₀)
    rw [h0] at h2
    have h3 : IsUnit ((X.presheaf.germ W _ (X.basicOpen_le _ hZ₀)).hom (g i) *
        ((ψ⁻¹ : (RationalFunctions X)ˣ) : RationalFunctions X) (pointComponent x)) :=
      (hunit _ hZ₀).mul ((Pi.isUnit_iff.mp (ψ⁻¹).isUnit) _)
    rw [← h2] at h3
    exact not_isUnit_zero h3
  refine ⟨i, hi, fun hxs => ?_⟩
  obtain ⟨E, hE, hxE⟩ := DivisorWithCoeffs.mem_supp_iff.mp hxs
  apply hE
  have hηE : E.genericPoint ∈ X.basicOpen (g i) := by
    rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hxE
    exact (specializes_iff_mem_closure.mpr hxE).mem_open (X.basicOpen _).isOpen hxg
  have hηW : E.genericPoint ∈ W := X.basicOpen_le _ hηE
  have hZ : componentGenericPoint X E.component ∈ W :=
    E.specializes_genericPoint.mem_open W.isOpen hηW
  set u := (Divisor.isUnit_sectionToRationalFunctions hi).unit
  have hv := congrArg E.valuation (hval E.component hZ)
  have hgerm : (X.presheaf.germ W _ hZ).hom (g i) =
      E.toComponent.hom ((X.presheaf.germ W _ hηW).hom (g i)) := by
    rw [← TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hηW E.specializes_genericPoint]
    rfl
  rw [map_mul, hgerm, E.valuation_toComponent_of_isUnit (hunit _ hηE), one_mul,
    PrimeDivisor.valuation_component, PrimeDivisor.ord_inv,
    ← hψ E ⟨E.genericPoint, genericPoint_mem_support E, hηW⟩] at hv
  have hv' : E.valuation ((u : RationalFunctions X) E.component) =
      WithZero.exp (-D.coeff E) := hv
  rw [PrimeDivisor.valuation_component] at hv'
  have hv'' := WithZero.exp_injective hv'
  have hc : (D.zeroDivisor _ hi).coeff E = (principalDivisor u).coeff E + D.coeff E := rfl
  refine hc.trans ?_
  rw [coeff_principalDivisor]
  omega

/-- `𝒪_X(nL) ≅ 𝒪_X(L)^{⊗ n}` for a Cartier divisor `L` and `n ≥ 1`. -/
private theorem nonempty_divisorialSheaf_nsmul_iso {L : Divisor X} (hL : L.IsCartier) (n : ℕ)
    (hn : 1 ≤ n) :
    haveI := hL.isInvertibleModule_divisorialSheaf
    Nonempty ((n • L).divisorialSheaf ≅
      Stacks.Ample.tensorPowModule X L.divisorialSheaf (n : ℤ)) := by
  haveI := hL.isInvertibleModule_divisorialSheaf
  induction n, hn using Nat.le_induction with
  | base =>
    exact ⟨eqToIso (congrArg Divisor.divisorialSheaf (one_nsmul L)) ≪≫
      (Stacks.Ample.tensorPowModuleOneIso X _).symm⟩
  | succ n hn ih =>
    obtain ⟨e⟩ := ih
    refine ⟨eqToIso (congrArg Divisor.divisorialSheaf (succ_nsmul L n)) ≪≫
      ((hL.nsmul n).divisorialSheafTensorIso hL).symm ≪≫ ?_ ≪≫
      Stacks.Ample.tensorPowModuleAddIso X _ (n : ℤ) 1 ≪≫
      Stacks.RelativeVeryAmple.tensorPowModuleCongr X _ (by push_cast; rfl)⟩
    exact ((Stacks.SheafOfModules.Tensor.sheafTensor _).mapIso e).app _ ≪≫
      ((Stacks.SheafOfModules.Tensor.sheafTensor _).obj _).mapIso
        (Stacks.Ample.tensorPowModuleOneIso X _).symm

/-- **Serre generation for all large multiples** ([Stacks, Tag 01Q3]): for an ample Cartier
divisor `H` and any divisor `E`, `𝒪_X(E + nH)` is generated by finitely many global sections for
all large `n`. -/
private theorem exists_forall_generatingSections {k : Type} [Field k] {sX : X ⟶ Spec (.of k)}
    (hX : MMP.Mori.IsVariety k sX) {H : Divisor X} (hH : H.IsCartier) (hHa : H.IsAmple hH)
    (E : Divisor X) :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → 1 ≤ n →
      ∃ σ : (E + n • H).divisorialSheaf.GeneratingSections, Finite σ.I := by
  haveI := hH.isInvertibleModule_divisorialSheaf
  have hcoh := MMP.Threefold.isCoherent_divisorialSheaf_and_isIso_divisorialSheafTensorMul sX hX E
  haveI := (hcoh H).1
  have hqc := Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
    E.divisorialSheaf
  obtain ⟨n₀, hn₀⟩ :=
    (Stacks.AmpleLocalGeneration.quasiSeparatedSpace_and_isEventuallyGloballyGenerated_of_isAmple
      _ hHa).2 E.divisorialSheaf hqc.1 hqc.2
  refine ⟨n₀.toNat, fun n hn h1 => ?_⟩
  obtain ⟨σ, hσ⟩ := hn₀ (n : ℤ) (by omega)
  letI := Stacks.SheafInternalHom.schemeMonoidalCategory X
  let i := Stacks.TensorSheafSpellingIso.monoidalTensorIso X E.divisorialSheaf
    (Stacks.Ample.tensorPowModule X H.divisorialSheaf (n : ℤ))
  obtain ⟨e⟩ := nonempty_divisorialSheaf_nsmul_iso hH n h1
  let pI := i ≪≫ Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _) e.symm ≪≫
    @asIso _ _ _ _ (E.divisorialSheafTensorMul (n • H)) ((hcoh (n • H)).2.2 (hH.nsmul n))
  let p := pI.hom
  haveI : @Epi (SheafOfModules.{0} X.ringCatSheaf) _ _ _ p :=
    @IsIso.epi_of_iso _ _ _ _ p inferInstance
  exact ⟨σ.ofEpi p, hσ⟩

/-- **A finite generating family is free where `L` has local equations**: finitely many
generating sections of `𝒪_X(L)`, indexed by `Fin (N + 1)`, have at every point near which `L`
has a local equation a member whose divisor of zeros misses that point. -/
private theorem exists_free_of_generatingSections {L : Divisor X}
    (σ : L.divisorialSheaf.GeneratingSections) [Finite σ.I] :
    ∃ (N : ℕ) (t : Fin (N + 1) → L.divisorialSubmodule ⊤), ∀ x : X,
      (∃ W : X.Opens, x ∈ W ∧ ∃ φ : (RationalFunctions X)ˣ, L.IsLocalEquation W φ) →
      ∃ i, ∃ hi : t i ≠ 0, x ∉ (L.zeroDivisor (t i) hi).supp := by
  haveI := Fintype.ofFinite σ.I
  by_cases hI : Nonempty σ.I
  · obtain ⟨N, hN⟩ : ∃ N, Fintype.card σ.I = N + 1 :=
      Nat.exists_eq_succ_of_ne_zero Fintype.card_ne_zero
    let e : σ.I ≃ Fin (N + 1) := Fintype.equivFinOfCardEq hN
    refine ⟨N, fun j => (σ.s (e.symm j)).eval (Opposite.op ⊤), fun x ⟨W, hxW, φ, hφ⟩ => ?_⟩
    obtain ⟨i, hi⟩ := exists_notMem_supp_zeroDivisor σ hφ hxW
    have key : ∀ j, j = i → ∃ hj : ((σ.s j).eval (Opposite.op ⊤) :
        L.divisorialSubmodule ⊤) ≠ 0, x ∉ (L.zeroDivisor _ hj).supp := by
      rintro j rfl
      exact hi
    exact ⟨e i, key _ (e.symm_apply_apply i)⟩
  · refine ⟨0, fun _ => 0, fun x ⟨W, hxW, φ, hφ⟩ => ?_⟩
    obtain ⟨i, -⟩ := exists_notMem_supp_zeroDivisor σ hφ hxW
    exact absurd ⟨i⟩ hI

omit [IsIntegral X] [CompactSpace X] in
/-- A divisor whose restriction to an open `V` is Cartier has a local equation near every point
of `V`: a local equation of `D|_V` on `W ⊆ V` is one of `D` on `W`, since the prime divisors of
`X` meeting `W` are the closures of those of `V` meeting `W`, with the same local rings. -/
private theorem exists_isLocalEquation_of_isCartier_restrictOpen [IsIntegral X] {D : Divisor X}
    {V : X.Opens} (h : Divisor.IsCartier (D.restrictOpen V)) {x : X} (hx : x ∈ V) :
    ∃ W : X.Opens, x ∈ W ∧ ∃ φ : (RationalFunctions X)ˣ, D.IsLocalEquation W φ := by
  have : Nonempty V := ⟨⟨x, hx⟩⟩
  have : IsDominant V.ι := Opens.isDominant_ι (V.isOpen.dense ⟨x, hx⟩)
  obtain ⟨W, hxW, φ', hφ'⟩ := h ⟨x, hx⟩
  obtain ⟨g', hg', hφg'⟩ := MMP.Positivity.exists_ord_eq_of_units φ'
  obtain ⟨g, rfl⟩ := (functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤
    ⟨⟨x, hx⟩, trivial⟩).2 g'
  obtain ⟨φ, hφ⟩ := MMP.Positivity.exists_units_of_ne_zero (g := g)
    (fun h0 => hg' (by rw [h0, map_zero]))
  refine ⟨V.ι ''ᵁ W, ⟨⟨x, hx⟩, hxW, rfl⟩, φ, fun E hE => ?_⟩
  have hEW : E.genericPoint ∈ V.ι ''ᵁ W := (E.genericPoint_mem_iff _).2 hE
  obtain ⟨y, hyW, hy⟩ := hEW
  obtain ⟨E₀, rfl⟩ := (OpenWeilRestriction.mem_range_primeDivisorMap_iff V.ι E).2 ⟨y, hy⟩
  have hgp : V.ι E₀.genericPoint = V.ι y :=
    (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm.trans hy.symm
  have hE₀ : (E₀.support ∩ (W : Set V)).Nonempty := by
    rw [← PrimeDivisor.genericPoint_mem_iff]
    have : E₀.genericPoint = y := V.ι.isOpenEmbedding.injective hgp
    change E₀.genericPoint ∈ W
    rw [this]
    exact hyW
  have h1 := hφ' E₀ hE₀
  rw [DivisorWithCoeffs.coeff_restrictOpen] at h1
  rw [h1, hφg', hφ, MMP.Positivity.ord_functionFieldMap_of_isIso V.ι E₀ _
    (OpenWeilRestriction.genericPoint_primeDivisorMap _ _).symm]

omit [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] in
/-- The smooth locus of a scheme locally of finite type over a field is smooth. -/
private theorem isSmoothScheme_smoothLocus_ι {k : Type} [Field k]
    (s : X ⟶ Spec (.of k)) [LocallyOfFiniteType s] : IsSmoothScheme ((smoothLocus s).ι ≫ s) := by
  rw [isSmoothScheme_iff, ← Scheme.Hom.smoothLocus_eq_top_iff,
    ← Scheme.Hom.preimage_smoothLocus_eq, smoothLocus_eq_smoothLocus, Scheme.Opens.ι_preimage_self]

omit [CompactSpace X] in
/-- Every divisor has a local equation near a smooth point. -/
private theorem exists_isLocalEquation_of_mem_smoothLocus {k : Type} [Field k]
    {s : X ⟶ Spec (.of k)} [LocallyOfFiniteType s] (D : Divisor X) {x : X}
    (hx : x ∈ smoothLocus s) :
    ∃ W : X.Opens, x ∈ W ∧ ∃ φ : (RationalFunctions X)ˣ, D.IsLocalEquation W φ :=
  exists_isLocalEquation_of_isCartier_restrictOpen
    (MMP.Fourfold.isCartier_of_isSmoothScheme (isSmoothScheme_smoothLocus_ι s) _) hx

end GlobalGeneration

/-! ### Restricting sections to an open subscheme -/

section RestrictOpen

open Opposite

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

/-- A nonempty open subscheme of an irreducible scheme is dense. -/
private theorem isDominant_opens_ι {Y : Scheme.{0}} [IrreducibleSpace Y] (V : Y.Opens)
    [Nonempty V] : IsDominant V.ι :=
  Opens.isDominant_ι (V.isOpen.dense ⟨_, (Classical.arbitrary V).2⟩)

/-- A nonempty open subscheme of an integral scheme has the same function field. -/
private theorem functionFieldMap_opens_ι_bijective {Y : Scheme.{0}} [IsIntegral Y] (V : Y.Opens)
    [Nonempty V] [IsDominant V.ι] : Function.Bijective (functionFieldMap V.ι) :=
  functionFieldMap_bijective_of_isOpenImmersion V.ι ⊤ ⟨Classical.arbitrary V, trivial⟩

/-- The divisorial valuation of a prime divisor `E'` of an open subscheme `V ⊆ Y` is that of its
closure `E` in `Y`, through the identification `k(Y) ≅ k(V)`. -/
private theorem divisorialValuation_primeDivisorMap {Y V : Scheme.{0}} [IsIntegral Y]
    [IsIntegral V] [IsLocallyNoetherian Y] [IsLocallyNoetherian V] [IsNormal Y] [IsNormal V]
    (j : V ⟶ Y) [IsOpenImmersion j] [IsDominant j] (E' : MMP.Mori.PrimeDivisor V) :
    MMP.Mori.PrimeDivisor.divisorialValuation (OpenWeilRestriction.primeDivisorMap j E') =
      E'.divisorialValuation.comap (functionFieldMap j) := by
  ext g
  rcases eq_or_ne g 0 with rfl | hg
  · simp
  have hg' : functionFieldMap j g ≠ 0 := (map_ne_zero _).2 hg
  rw [Valuation.comap_apply, MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_exp_neg_ord _ hg',
    MMP.Positivity.ord_functionFieldMap_of_isIso j E' _
      (OpenWeilRestriction.genericPoint_primeDivisorMap j E').symm]

section DivisorialRestrict

/-- On an irreducible scheme every irreducible component is the whole space. -/
private theorem eq_univ_of_irreducibleComponents {Y : Scheme.{0}} [IrreducibleSpace Y]
    (Z : irreducibleComponents Y) : Z.1 = Set.univ :=
  Set.eq_univ_of_univ_subset
    (Z.2.2 (IrreducibleSpace.isIrreducible_univ Y) (Set.subset_univ _))

private theorem index_eq {Y : Scheme.{0}} [IrreducibleSpace Y] {W : Y.Opens}
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Z = Z' :=
  Subtype.ext (Subtype.ext ((eq_univ_of_irreducibleComponents _).trans
    (eq_univ_of_irreducibleComponents _).symm))

private theorem genericPoint_specializes {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : genericPoint Y ⤳ componentGenericPoint Y Z :=
  (genericPoint_spec Y).specializes trivial

private theorem specializes_genericPoint {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) : componentGenericPoint Y Z ⤳ genericPoint Y :=
  (Inseparable.of_eq (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z)).specializes

private theorem stalkSpecializes_stalkSpecializes_apply {Y : Scheme.{0}} {x y z : Y}
    (h : x ⤳ y) (h' : y ⤳ z) (h'' : x ⤳ z) (s : Y.presheaf.stalk z) :
    (Y.presheaf.stalkSpecializes h).hom ((Y.presheaf.stalkSpecializes h').hom s) =
      (Y.presheaf.stalkSpecializes h'').hom s :=
  TopCat.Presheaf.stalkSpecializes_comp_apply _ h h' s

private theorem stalkSpecializes_self_apply {Y : Scheme.{0}} {x : Y} (h : x ⤳ x)
    (s : Y.presheaf.stalk x) : (Y.presheaf.stalkSpecializes h).hom s = s := by
  rw [TopCat.Presheaf.stalkSpecializes_refl]
  rfl

/-- The value in the function field of a section of `𝒦_Y` over an open set, read at the generic
point of an irreducible component meeting it. -/
private noncomputable def evFF {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) : Y.functionField :=
  (Y.presheaf.stalkSpecializes (genericPoint_specializes Z.1)).hom (φ Z)

private theorem evFF_eq {Y : Scheme.{0}} [IsIntegral Y] {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (Z Z' : {Z : irreducibleComponents Y // componentGenericPoint Y Z ∈ W}) :
    evFF φ Z = evFF φ Z' := by
  obtain rfl := index_eq Z Z'
  rfl

private theorem stalkSpecializes_injective {Y : Scheme.{0}} [IsIntegral Y]
    (Z : irreducibleComponents Y) :
    Function.Injective (Y.presheaf.stalkSpecializes (genericPoint_specializes Z)).hom := by
  intro a b h
  have := congrArg (Y.presheaf.stalkSpecializes (specializes_genericPoint Z)).hom h
  rwa [stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl,
    stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply,
    stalkSpecializes_self_apply] at this

/-- `v_E` on the factor `𝒪_{Y,η}` of `𝒦_Y` is the inverse of the divisorial valuation of the
corresponding rational function. -/
private theorem valuation_eq_inv_divisorialValuation {Y : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y)
    (s : Y.presheaf.stalk (componentGenericPoint Y E.component)) :
    E.valuation s = (E.divisorialValuation
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes E.component)).hom s))⁻¹ := by
  rw [MMP.Threefold.Mori.Helpers.valuation_eq_ordFrac,
    MMP.Mori.PrimeDivisor.divisorialValuation_eq_inv_ordHom, inv_inv]
  rfl

private theorem ordGE_iff {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    (E : MMP.Mori.PrimeDivisor Y) (n : ℤ)
    (s : Y.presheaf.stalk (componentGenericPoint Y E.component)) :
    E.OrdGE n s ↔
      ((Y.presheaf.stalkSpecializes (genericPoint_specializes E.component)).hom s = 0 ∨
        WithZero.exp n ≤ (E.divisorialValuation
          ((Y.presheaf.stalkSpecializes (genericPoint_specializes E.component)).hom s))⁻¹) := by
  rw [MMP.Mori.PrimeDivisor.OrdGE, valuation_eq_inv_divisorialValuation,
    (injective_iff_map_eq_zero' _).1 (stalkSpecializes_injective E.component)]

private theorem ordGE_iff_evFF {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (E : MMP.Mori.PrimeDivisor Y) (n : ℤ) {W : Y.Opens}
    (φ : ToType ((rationalFunctionsPresheaf Y).obj (op W)))
    (h : componentGenericPoint Y E.component ∈ W) :
    E.OrdGE n (φ ⟨E.component, h⟩) ↔
      (evFF φ ⟨E.component, h⟩ = 0 ∨
        WithZero.exp n ≤ (E.divisorialValuation (evFF φ ⟨E.component, h⟩))⁻¹) :=
  ordGE_iff E n _

variable (U : X.Opens) [Nonempty U] [IsDominant U.ι]

private theorem genericPoint_mem_of_index {V : U.toScheme.Opens}
    (Z : {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V}) :
    genericPoint U.toScheme ∈ V := by
  have := Z.2
  rwa [MMP.Fourfold.componentGenericPoint_eq_genericPoint] at this

private theorem genericPoint_mem_of_indexX {V : U.toScheme.Opens}
    (Z : {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V}) :
    genericPoint U.toScheme ∈ V := by
  have h := Z.2
  rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint] at h
  obtain ⟨x, hx, hxe⟩ := h
  have hsp : genericPoint U.toScheme ⤳ x := (genericPoint_spec U.toScheme).specializes trivial
  exact hsp.mem_open V.isOpen hx

/-- The irreducible component `X` of the integral scheme `X`. -/
private def topComponent (Y : Scheme.{0}) [IrreducibleSpace Y] : irreducibleComponents Y :=
  ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩

private def indexX {V : U.toScheme.Opens} (h : genericPoint U.toScheme ∈ V) :
    {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V} :=
  ⟨topComponent X, by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, ← map_genericPoint_of_isDominant U.ι]
    exact ⟨_, h, rfl⟩⟩

private def indexU {V : U.toScheme.Opens} (h : genericPoint U.toScheme ∈ V) :
    {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V} :=
  ⟨topComponent U.toScheme, by rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]; exact h⟩

/-- The restriction `𝒦_X(U ∩ -) → 𝒦_U` of rational functions to an open subscheme, through the
identification `k(X) ≅ k(U)`. -/
private noncomputable def restrictRF (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    ToType ((rationalFunctionsPresheaf U.toScheme).obj (op V)) :=
  fun Z => (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (functionFieldMap U.ι (evFF ψ (indexX U (genericPoint_mem_of_index U Z))))

private theorem evFF_restrictRF (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V))))
    (Z : {Z : irreducibleComponents U.toScheme // componentGenericPoint U.toScheme Z ∈ V})
    (Z' : {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U.ι ''ᵁ V}) :
    evFF (restrictRF U V ψ) Z = functionFieldMap U.ι (evFF ψ Z') := by
  rw [evFF, restrictRF, stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl,
    stalkSpecializes_self_apply, evFF_eq ψ _ Z']

private theorem restrictRF_injective (V : U.toScheme.Opens) :
    Function.Injective (restrictRF U V) := by
  intro ψ₁ ψ₂ h
  funext Z'
  have hV := genericPoint_mem_of_indexX U Z'
  have h1 := congrArg (fun φ => evFF φ (indexU U hV)) h
  simp only [evFF_restrictRF U V _ _ Z'] at h1
  exact stalkSpecializes_injective Z'.1 ((functionFieldMap U.ι).injective h1)

private theorem restrictRF_surjective (V : U.toScheme.Opens) :
    Function.Surjective (restrictRF U V) := by
  intro φ
  let e := RingEquiv.ofBijective (functionFieldMap U.ι) (functionFieldMap_opens_ι_bijective U)
  refine ⟨fun Z' => (X.presheaf.stalkSpecializes (specializes_genericPoint Z'.1)).hom
    (e.symm (evFF φ (indexU U (genericPoint_mem_of_indexX U Z')))), ?_⟩
  funext Z
  change (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (functionFieldMap U.ι ((X.presheaf.stalkSpecializes (genericPoint_specializes _)).hom
      ((X.presheaf.stalkSpecializes (specializes_genericPoint _)).hom (e.symm _)))) = _
  rw [stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply]
  change (U.toScheme.presheaf.stalkSpecializes (specializes_genericPoint Z.1)).hom
    (e (e.symm _)) = _
  rw [RingEquiv.apply_symm_apply, evFF_eq φ _ Z, evFF,
    stalkSpecializes_stalkSpecializes_apply _ _ specializes_rfl, stalkSpecializes_self_apply]

/-- Orders along a prime divisor `E'` of `U` and along its closure in `X` agree on restricted
rational functions. -/
private theorem ordGE_restrictRF_iff (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) (n : ℤ)
    (E' : MMP.Mori.PrimeDivisor U.toScheme) (hE' : (E'.support ∩ V).Nonempty)
    (hP : ((OpenWeilRestriction.primeDivisorMap U.ι E').support ∩ U.ι ''ᵁ V).Nonempty) :
    E'.OrdGE n (restrictRF U V ψ ⟨E'.component, E'.componentGenericPoint_mem_of_nonempty hE'⟩) ↔
      MMP.Mori.PrimeDivisor.OrdGE (OpenWeilRestriction.primeDivisorMap U.ι E') n
        (ψ ⟨_, MMP.Mori.PrimeDivisor.componentGenericPoint_mem_of_nonempty
          (OpenWeilRestriction.primeDivisorMap U.ι E') hP⟩) := by
  rw [ordGE_iff_evFF, ordGE_iff_evFF]
  rw [evFF_restrictRF U V ψ _ ⟨_, MMP.Mori.PrimeDivisor.componentGenericPoint_mem_of_nonempty
      (OpenWeilRestriction.primeDivisorMap U.ι E') hP⟩,
    divisorialValuation_primeDivisorMap, map_eq_zero_iff _ (functionFieldMap U.ι).injective]
  rfl

/-- A section of `𝒦_X` over `U ∩ -` is a section of `𝒪_X(D)` exactly when its restriction is a
section of `𝒪_U(D|_U)`: the prime divisors of `U` meeting `V` are the restrictions of those of
`X` meeting `V`, with the same valuations and coefficients. -/
private theorem isDivisorialSection_restrictRF_iff (D : Divisor X) (V : U.toScheme.Opens)
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    Divisor.IsDivisorialSection (D.restrictOpen U) V (restrictRF U V ψ) ↔
      D.IsDivisorialSection (U.ι ''ᵁ V) ψ := by
  have key : ∀ (E' : MMP.Mori.PrimeDivisor U.toScheme) (hE' : (E'.support ∩ V).Nonempty)
      (hP : ((OpenWeilRestriction.primeDivisorMap U.ι E').support ∩ U.ι ''ᵁ V).Nonempty),
      E'.OrdGE (-(D.restrictOpen U).coeff E')
          (restrictRF U V ψ ⟨E'.component, E'.componentGenericPoint_mem_of_nonempty hE'⟩) ↔
        MMP.Mori.PrimeDivisor.OrdGE (OpenWeilRestriction.primeDivisorMap U.ι E')
          (-D.coeff (OpenWeilRestriction.primeDivisorMap U.ι E'))
          (ψ ⟨_, MMP.Mori.PrimeDivisor.componentGenericPoint_mem_of_nonempty
            (OpenWeilRestriction.primeDivisorMap U.ι E') hP⟩) := by
    intro E' hE' hP
    rw [DivisorWithCoeffs.coeff_restrictOpen]
    exact ordGE_restrictRF_iff U V ψ _ E' hE' hP
  have hmem : ∀ E' : MMP.Mori.PrimeDivisor U.toScheme, (E'.support ∩ V).Nonempty ↔
      ((OpenWeilRestriction.primeDivisorMap U.ι E').support ∩ U.ι ''ᵁ V).Nonempty := by
    intro E'
    rw [← MMP.Mori.PrimeDivisor.genericPoint_mem_iff, ← MMP.Mori.PrimeDivisor.genericPoint_mem_iff,
      show MMP.Mori.PrimeDivisor.genericPoint (OpenWeilRestriction.primeDivisorMap U.ι E') =
        U.ι E'.genericPoint from OpenWeilRestriction.genericPoint_primeDivisorMap _ _]
    refine ⟨fun h => ⟨_, h, rfl⟩, ?_⟩
    rintro ⟨x, hx, hxe⟩
    rwa [U.ι.isOpenEmbedding.injective hxe] at hx
  constructor
  · intro h P hP
    have hPU : P.genericPoint ∈ Set.range U.ι.base := by
      rw [Scheme.Opens.range_ι]
      obtain ⟨x, -, hx⟩ := (MMP.Mori.PrimeDivisor.genericPoint_mem_iff P _).2 hP
      rw [← hx]
      exact x.2
    obtain ⟨E', rfl⟩ := (OpenWeilRestriction.mem_range_primeDivisorMap_iff _ P).2 hPU
    exact (key E' ((hmem E').2 hP) hP).1 (h E' ((hmem E').2 hP))
  · intro h E' hE'
    exact (key E' hE' ((hmem E').1 hE')).2 (h _ ((hmem E').1 hE'))

private theorem functionFieldMap_germ_appIso_inv (V : U.toScheme.Opens) (r : Γ(U.toScheme, V))
    (h₁ : genericPoint X ∈ U.ι ''ᵁ V) (h₂ : genericPoint U.toScheme ∈ V) :
    functionFieldMap U.ι (X.presheaf.germ (U.ι ''ᵁ V) (genericPoint X) h₁
      ((U.ι.appIso V).inv r)) = U.toScheme.presheaf.germ V (genericPoint U.toScheme) h₂ r := by
  have h₃ : U.ι (genericPoint U.toScheme) ∈ U.ι ''ᵁ V := ⟨_, h₂, rfl⟩
  rw [functionFieldMap, CommRingCat.comp_apply, TopCat.Presheaf.stalkCongr_hom]
  erw [TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf h₁ _]
  erw [Scheme.Hom.germ_stalkMap_apply, ← CommRingCat.comp_apply (U.ι.appIso V).inv,
    Scheme.Hom.appIso_inv_app, TopCat.Presheaf.germ_res_apply]

private theorem restrictRF_smul (V : U.toScheme.Opens) (r : Γ(U.toScheme, V))
    (ψ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    restrictRF U V ((U.ι.appIso V).inv r • ψ) = r • restrictRF U V ψ := by
  funext Z
  rw [rationalFunctions_smul_apply]
  simp only [restrictRF, evFF, rationalFunctions_smul_apply, map_mul]
  congr 1
  rw [TopCat.Presheaf.germ_stalkSpecializes_apply, functionFieldMap_germ_appIso_inv U V r _
    (genericPoint_mem_of_index U Z), TopCat.Presheaf.germ_stalkSpecializes_apply]

private theorem restrictRF_zero (V : U.toScheme.Opens) : restrictRF U V 0 = 0 := by
  funext Z
  simp only [restrictRF, evFF]
  erw [Pi.zero_apply, map_zero, map_zero, map_zero]
  rfl

private theorem restrictRF_add (V : U.toScheme.Opens)
    (ψ₁ ψ₂ : ToType ((rationalFunctionsPresheaf X).obj (op (U.ι ''ᵁ V)))) :
    restrictRF U V (ψ₁ + ψ₂) = restrictRF U V ψ₁ + restrictRF U V ψ₂ := by
  funext Z
  simp only [restrictRF, evFF]
  erw [Pi.add_apply, map_add, map_add, map_add]
  rfl

end DivisorialRestrict

end RestrictOpen

end Helpers

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation

end

/-! ### Bertini for a general member of a free system on a resolution -/

section

open CategoryTheory TopologicalSpace
open AlgebraicGeometry hiding PrimeDivisor

namespace MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.Bertini5d

open MMP.Mori

open MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation
  (support_sum_single genericPoint_mem_support exists_polynomial_sum_smul_ne_zero)

open Classical in
/-- The coefficient of the reduced divisor `∑_{E ∈ S} E` at `F` is `1` or `0`. -/
private theorem coeff_sum_single {Y : Scheme.{0}} (S : Finset (PrimeDivisor Y))
    (F : PrimeDivisor Y) :
    DivisorWithCoeffs.coeff (∑ E ∈ S, Finsupp.single E (1 : ℤ) : Divisor Y) F =
      if F ∈ S then 1 else 0 := by
  classical
  change (∑ E ∈ S, Finsupp.single E (1 : ℤ)) F = _
  rw [Finsupp.finset_sum_apply]
  simp [Finsupp.single_apply]

/-- A divisor `H` admitting finitely many sections of `𝒪_X(H)` without common zero is Cartier:
off `Supp (sᵢ)₀ = Supp (div uᵢ + H)` the divisor `H` has the local equation `uᵢ⁻¹`. -/
private theorem isCartier_of_forall_exists_notMem_supp {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {H : Divisor X} {ι : Type*}
    (s : ι → H.divisorialSubmodule ⊤)
    (hs : ∀ x : X, ∃ (i : ι) (hi : s i ≠ 0), x ∉ (H.zeroDivisor (s i) hi).supp) :
    H.IsCartier := by
  intro x
  obtain ⟨i, hi, hx⟩ := hs x
  refine ⟨(H.zeroDivisor (s i) hi).supp.compl, hx, ?_⟩
  set u := (Divisor.isUnit_sectionToRationalFunctions hi).unit
  refine ⟨u⁻¹, fun E ⟨y, hyE, hyU⟩ => ?_⟩
  have h0 : (H.zeroDivisor (s i) hi).coeff E = 0 := by
    by_contra hne
    exact hyU (DivisorWithCoeffs.support_subset_supp hne hyE)
  rw [Divisor.zeroDivisor_eq, DivisorWithCoeffs.coeff_add, coeff_principalDivisor] at h0
  rw [PrimeDivisor.ord_inv]
  exact eq_neg_of_add_eq_zero_right h0

/-! ### The zero scheme of a section of a divisorial sheaf -/

attribute [local instance] MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation.isInvertible_of_isInvertibleModule

section ZeroScheme

/-- In a discrete valuation ring, a nonzero nonunit generating a radical ideal is a
uniformizer. -/
private theorem irreducible_of_isRadical_span {R : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] {x : R} (hx0 : x ≠ 0) (hxu : ¬ IsUnit x)
    (hrad : (Ideal.span {x}).IsRadical) : Irreducible x := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0 hϖ
  have hn : n ≠ 0 := by
    rintro rfl
    exact hxu (by simp)
  have hmem : ϖ ^ n ∈ Ideal.span {(u : R) * ϖ ^ n} :=
    Ideal.mem_span_singleton.mpr ⟨(u⁻¹ : Rˣ), by
      rw [mul_comm (u : R), mul_assoc, Units.mul_inv, mul_one]⟩
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hrad ⟨n, hmem⟩)
  have hdvd : ϖ ^ n ∣ ϖ ^ 1 := ⟨(u : R) * c, by rw [pow_one]; nth_rewrite 1 [hc]; ring⟩
  have hle := (pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit).mp hdvd
  obtain rfl : n = 1 := by omega
  rw [pow_one, irreducible_isUnit_mul u.isUnit]
  exact hϖ

end ZeroScheme

/-! ### Pulling back rational functions and sections along a dominant morphism -/

section PullbackSections

private theorem bijective_stalkSpecializes_of_eq {X : Scheme.{0}} {x y : X} (h : x ⤳ y)
    (hxy : y = x) : Function.Bijective (X.presheaf.stalkSpecializes h).hom := by
  subst hxy
  rw [TopCat.Presheaf.stalkSpecializes_refl]
  exact Function.bijective_id

private theorem map_componentGenericPoint_eq {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : Y ⟶ X) [IsDominant f] (Z : irreducibleComponents Y) :
    componentGenericPoint X (pointComponent (f (componentGenericPoint Y Z))) =
      f (componentGenericPoint Y Z) := by
  rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint,
    MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]

/-- `𝒪_{X,f(η_Z)} ≅ 𝒪_{X,η}`: `f` maps the generic point of `Y` to that of `X`. -/
private noncomputable def stalkEquiv {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : Y ⟶ X) [IsDominant f] (Z : irreducibleComponents Y) :
    X.presheaf.stalk (f (componentGenericPoint Y Z)) ≃+*
      X.presheaf.stalk (componentGenericPoint X (pointComponent (f (componentGenericPoint Y Z)))) :=
  RingEquiv.ofBijective (stalkToRationalFunctions X (mem_pointComponent _)).hom
    (bijective_stalkSpecializes_of_eq _ (map_componentGenericPoint_eq f Z).symm)

/-- The pull-back `f^* : K(X) → K(Y)` of rational functions along a dominant morphism of
integral schemes. -/
private noncomputable def pullbackRat {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : Y ⟶ X) [IsDominant f] : RationalFunctions X →+* RationalFunctions Y :=
  Pi.ringHom fun Z => (f.stalkMap (componentGenericPoint Y Z)).hom.comp
    ((stalkEquiv f Z).symm.toRingHom.comp
      (RationalFunctions.component X (pointComponent (f (componentGenericPoint Y Z)))))

/-- On units, `f^*` is `MMP.Mori.pullbackRationalFunction`. -/
private theorem coe_pullbackRationalFunction {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (f : Y ⟶ X) [IsDominant f]
    (u : (RationalFunctions X)ˣ)
    (hu : ∀ Z : irreducibleComponents Y,
      f (componentGenericPoint Y Z) ∉ (principalDivisor u).supp) :
    ((pullbackRationalFunction f u hu : (RationalFunctions Y)ˣ) : RationalFunctions Y) =
      pullbackRat f u := by
  funext Z
  have key := pullbackComponent_eq hu (Divisor.isLocalEquation_principalDivisor u ⊤)
    (Z := Z) trivial (mem_pointComponent _)
    (Units.map (stalkEquiv f Z).symm.toMonoidHom
      ((RationalFunctions.unitsEquiv X u) (pointComponent (f (componentGenericPoint Y Z)))))
    ((stalkEquiv f Z).apply_symm_apply _)
  change ((pullbackComponent f hu (Divisor.isLocalEquation_principalDivisor u ⊤) Z trivial :
    (Y.presheaf.stalk (componentGenericPoint Y Z))ˣ) :
      Y.presheaf.stalk (componentGenericPoint Y Z)) = _
  rw [key]
  rfl

/-- `f^*` maps the germ of a global function to the germ of its pull-back. -/
private theorem pullbackRat_germ {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y]
    (f : Y ⟶ X) [IsDominant f] (r : Γ(X, ⊤)) :
    pullbackRat f (fun Z => (X.presheaf.germ ⊤ (componentGenericPoint X Z) trivial).hom r) =
      fun Z => (Y.presheaf.germ ⊤ (componentGenericPoint Y Z) trivial).hom (f.appTop r) := by
  funext Z
  have h1 : (stalkEquiv f Z).symm
      ((X.presheaf.germ ⊤ (componentGenericPoint X (pointComponent _)) trivial).hom r) =
      (X.presheaf.germ ⊤ (f (componentGenericPoint Y Z)) trivial).hom r := by
    rw [RingEquiv.symm_apply_eq]
    exact (TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _).symm
  change (f.stalkMap (componentGenericPoint Y Z)).hom ((stalkEquiv f Z).symm
      ((X.presheaf.germ ⊤ (componentGenericPoint X (pointComponent _)) trivial).hom r)) = _
  rw [h1]
  exact Scheme.Hom.germ_stalkMap_apply f ⊤ _ trivial r

/-- `f^*` of a section of `𝒪_X(H)` is a section of `𝒪_Y(f^*H)`: for `s ≠ 0`,
`div(f^*s) + f^*H = f^*(s)₀ ≥ 0`. -/
private theorem isDivisorialSection_pullbackRat {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {H : Divisor X} (hHc : H.IsCartier)
    {hBH : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ H.supp}
    {D' : Divisor Y} (hD' : H.IsPullback f hBH D') (s : H.divisorialSubmodule ⊤) :
    D'.IsDivisorialSection ⊤ ((rationalFunctionsPresheafTopEquiv Y).symm
      (pullbackRat f (Divisor.sectionToRationalFunctions s))) := by
  intro E hE
  by_cases hs : s = 0
  · subst hs
    have h0 : Divisor.sectionToRationalFunctions (0 : H.divisorialSubmodule ⊤) = 0 :=
      map_zero (rationalFunctionsPresheafTopEquiv X)
    rw [h0, map_zero, map_zero]
    exact Or.inl rfl
  · set u := (Divisor.isUnit_sectionToRationalFunctions hs).unit
    have hu : ∀ Z : irreducibleComponents Y,
        f (componentGenericPoint Y Z) ∉ (principalDivisor u).supp :=
      fun Z => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z
    have hBs : ∀ Z : irreducibleComponents Y,
        f (componentGenericPoint Y Z) ∉ (H.zeroDivisor s hs).supp :=
      fun Z => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z
    have hpb : (H.zeroDivisor s hs).IsPullback f hBs
        (principalDivisor (pullbackRationalFunction f u hu) + D') :=
      Divisor.IsPullback.add (Divisor.isCartier_principalDivisor u) hHc hBs
        (Divisor.isPullback_principalDivisor u hu) hD'
    have hnn := MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn
      ((Divisor.isCartier_principalDivisor u).add hHc) (V := ⊤)
      (fun P _ => Divisor.zeroDivisor_nonneg H s hs P) hpb E
      ⟨E.genericPoint, genericPoint_mem_support E, trivial⟩
    rw [DivisorWithCoeffs.coeff_add, coeff_principalDivisor] at hnn
    have hv := coe_pullbackRationalFunction f u hu
    have hval : ((rationalFunctionsPresheafTopEquiv Y).symm
        (pullbackRat f (Divisor.sectionToRationalFunctions s)))
          ⟨E.component, E.componentGenericPoint_mem_of_nonempty hE⟩ =
        ((pullbackRationalFunction f u hu : (RationalFunctions Y)ˣ) : RationalFunctions Y)
          E.component := by
      rw [hv]
      rfl
    rw [hval]
    refine Or.inr ?_
    rw [PrimeDivisor.valuation_component]
    exact WithZero.exp_le_exp.mpr (by omega)

/-- The pull-back `s ↦ f^*s : H⁰(X, 𝒪_X(H)) → H⁰(Y, 𝒪_Y(f^*H))`. -/
private noncomputable def pullSec {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {H : Divisor X} (hHc : H.IsCartier)
    {hBH : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ H.supp}
    {D' : Divisor Y} (hD' : H.IsPullback f hBH D') :
    H.divisorialSubmodule ⊤ →+ D'.divisorialSubmodule ⊤ where
  toFun s := ⟨_, isDivisorialSection_pullbackRat f hHc hD' s⟩
  map_zero' := Subtype.ext (by
    change (rationalFunctionsPresheafTopEquiv Y).symm
      (pullbackRat f (rationalFunctionsPresheafTopEquiv X 0)) = 0
    rw [map_zero, map_zero, map_zero])
  map_add' a b := Subtype.ext (by
    change (rationalFunctionsPresheafTopEquiv Y).symm
      (pullbackRat f (rationalFunctionsPresheafTopEquiv X (a.1 + b.1))) = _
    rw [map_add, map_add, map_add]
    rfl)

private theorem sectionToRationalFunctions_pullSec {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {H : Divisor X} (hHc : H.IsCartier)
    {hBH : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ H.supp}
    {D' : Divisor Y} (hD' : H.IsPullback f hBH D') (s : H.divisorialSubmodule ⊤) :
    Divisor.sectionToRationalFunctions (pullSec f hHc hD' s) =
      pullbackRat f (Divisor.sectionToRationalFunctions s) :=
  (rationalFunctionsPresheafTopEquiv Y).apply_symm_apply _

private theorem pullSec_smul {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {H : Divisor X} (hHc : H.IsCartier)
    {hBH : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ H.supp}
    {D' : Divisor Y} (hD' : H.IsPullback f hBH D') (r : Γ(X, ⊤)) (s : H.divisorialSubmodule ⊤) :
    pullSec f hHc hD' (r • s) = f.appTop r • pullSec f hHc hD' s := by
  apply Divisor.sectionToRationalFunctions_injective
  rw [sectionToRationalFunctions_pullSec]
  have h1 : ∀ {Z : Scheme.{0}} [IsLocallyNoetherian Z] [IsNormal Z] {M : Divisor Z}
      (r : Γ(Z, ⊤)) (σ : M.divisorialSubmodule ⊤),
      Divisor.sectionToRationalFunctions (r • σ) =
        (fun W => (Z.presheaf.germ ⊤ (componentGenericPoint Z W) trivial).hom r) *
          Divisor.sectionToRationalFunctions σ := fun _ _ => rfl
  rw [h1, h1, map_mul, pullbackRat_germ, sectionToRationalFunctions_pullSec]

/-- `f^*(s)₀ = (f^*s)₀` for `s ≠ 0`, and `f^*s ≠ 0`. -/
private theorem isPullback_zeroDivisor_pullSec {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] [IsLocallyNoetherian Y]
    [IsNormal Y] [CompactSpace Y] (f : Y ⟶ X) [IsDominant f] {H : Divisor X} (hHc : H.IsCartier)
    {hBH : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉ H.supp}
    {D' : Divisor Y} (hD' : H.IsPullback f hBH D') (s : H.divisorialSubmodule ⊤) (hs : s ≠ 0)
    (hBs : ∀ Z : irreducibleComponents Y,
      f (componentGenericPoint Y Z) ∉ (H.zeroDivisor s hs).supp) :
    ∃ h : pullSec f hHc hD' s ≠ 0,
      (H.zeroDivisor s hs).IsPullback f hBs (D'.zeroDivisor (pullSec f hHc hD' s) h) := by
  set u := (Divisor.isUnit_sectionToRationalFunctions hs).unit
  have hu : ∀ Z : irreducibleComponents Y,
      f (componentGenericPoint Y Z) ∉ (principalDivisor u).supp :=
    fun Z => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z
  have hv := coe_pullbackRationalFunction f u hu
  have hval : Divisor.sectionToRationalFunctions (pullSec f hHc hD' s) =
      ((pullbackRationalFunction f u hu : (RationalFunctions Y)ˣ) : RationalFunctions Y) := by
    rw [sectionToRationalFunctions_pullSec, hv]
    rfl
  have h : pullSec f hHc hD' s ≠ 0 := by
    intro h0
    obtain ⟨y⟩ : Nonempty Y := inferInstance
    have hu' := (Pi.isUnit_iff.mp (pullbackRationalFunction f u hu).isUnit) (pointComponent y)
    rw [← hval, h0] at hu'
    have h00 : Divisor.sectionToRationalFunctions (0 : D'.divisorialSubmodule ⊤) = 0 :=
      map_zero (rationalFunctionsPresheafTopEquiv Y)
    rw [h00] at hu'
    exact not_isUnit_zero hu'
  refine ⟨h, ?_⟩
  have heq : (Divisor.isUnit_sectionToRationalFunctions h).unit =
      pullbackRationalFunction f u hu := Units.ext hval
  rw [Divisor.zeroDivisor_eq D', heq]
  exact Divisor.IsPullback.add (Divisor.isCartier_principalDivisor u) hHc hBs
    (Divisor.isPullback_principalDivisor u hu) hD'

end PullbackSections

/-! ### Bertini on `Y`, in Weil-divisor form -/

section WeilBertini

open Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections (globalSectionsModule)

attribute [local instance] globalSectionsModule

end WeilBertini

/-- **Bertini on a smooth resolution, for any snc boundary.** Let `s : ι → H⁰(X, 𝒪_X(H))` be
finitely many sections without common zero on a normal variety `X`, `f : Y ⟶ X` a resolution,
and `∑_{F ∈ S} F` a reduced snc divisor on `Y`. For a general coefficient vector `c` the member
`σ = ∑ cᵢ sᵢ` is nonzero and, with `H' = f^*(σ)₀`, the divisor `H' + ∑_{F ∈ S} F` is reduced
and snc. -/
private theorem exists_polynomial_isSNC_pullback_zeroDivisor_add_finset {k : Type} [Field k]
    {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsAlgClosed k] [CharZero k]
    (hX : IsNormalVariety k sX) {f : Y ⟶ X} (hf : IsSmoothResolution sX f)
    {H : Divisor X} {ι : Type*} [Fintype ι] (s : ι → H.divisorialSubmodule ⊤)
    (hs : ∀ x : X, ∃ (i : ι) (hi : s i ≠ 0), x ∉ (H.zeroDivisor (s i) hi).supp)
    (S : Finset (PrimeDivisor Y))
    (hS : DivisorWithCoeffs.IsSNC (f ≫ sX) (∑ F ∈ S, Finsupp.single F (1 : ℤ))) :
    ∃ Q : MvPolynomial ι k, Q ≠ 0 ∧ ∀ c : ι → k, MvPolynomial.eval c Q ≠ 0 →
      ∃ hσ : (∑ i, scalarsToGlobalSections k sX (c i) • s i) ≠ 0,
        ∃ (hB : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉
            (H.zeroDivisor (∑ i, scalarsToGlobalSections k sX (c i) • s i) hσ).supp)
          (H' : Divisor Y),
          (H.zeroDivisor (∑ i, scalarsToGlobalSections k sX (c i) • s i) hσ).IsPullback f hB H' ∧
          (∀ F : PrimeDivisor Y,
            (H' + ∑ F ∈ S, Finsupp.single F (1 : ℤ)).coeff F = 0 ∨
            (H' + ∑ F ∈ S, Finsupp.single F (1 : ℤ)).coeff F = 1) ∧
          DivisorWithCoeffs.IsSNC (f ≫ sX) (H' + ∑ F ∈ S, Finsupp.single F (1 : ℤ)) := by
  classical
  haveI : IsIntegral Y := hf.isIntegral
  haveI : IsDominant f := hf.isBirationalMorphism.isDominant
  haveI : CompactSpace Y := by
    have := hf.isProper
    exact QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨j, hj, -⟩ := hs (Nonempty.some inferInstance)
  obtain ⟨Q₁, hQ₁, hσ⟩ := exists_polynomial_sum_smul_ne_zero sX s j hj
  obtain ⟨Q₂, hQ₂, hT⟩ := exists_polynomial_pullback_zeroDivisor_eq_sum_isSNC hX.1 hf s hs S hS
  have hHc : H.IsCartier := isCartier_of_forall_exists_notMem_supp s hs
  refine ⟨Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, fun c hc => ?_⟩
  rw [map_mul] at hc
  have hc₁ := left_ne_zero_of_mul hc
  have hc₂ := right_ne_zero_of_mul hc
  have hσc := hσ c hc₁
  have hBc : ∀ Z : irreducibleComponents Y, f (componentGenericPoint Y Z) ∉
      (H.zeroDivisor (∑ i, scalarsToGlobalSections k sX (c i) • s i) hσc).supp :=
    fun Z => MMP.Flips.map_componentGenericPoint_notMem_supp_of_isDominant f _ Z
  have hZc : (H.zeroDivisor (∑ i, scalarsToGlobalSections k sX (c i) • s i) hσc).IsCartier := by
    rw [Divisor.zeroDivisor_eq]
    exact (Divisor.isCartier_principalDivisor _).add hHc
  obtain ⟨H', hH'⟩ := hZc.exists_isPullback hBc
  obtain ⟨T, rfl, hTS, hsnc, -⟩ := hT c hc₂ hσc hBc H' hH'
  have hsum : (∑ E ∈ T, Finsupp.single E (1 : ℤ)) + ∑ E ∈ S, Finsupp.single E (1 : ℤ) =
      ∑ E ∈ T ∪ S, Finsupp.single E (1 : ℤ) := (Finset.sum_union hTS).symm
  refine ⟨hσc, hBc, _, hH', fun F => ?_, hsum ▸ hsnc⟩
  rw [hsum, coeff_sum_single]
  split_ifs <;> simp

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.Bertini5d

end

namespace MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.KltTest5d

open CategoryTheory AlgebraicGeometry MMP.Mori

/-- The components of an snc subset form a finite set of prime divisors with snc reduced sum. -/
private theorem exists_finset_isSNC {k : Type} [Field k] {Y : Scheme.{0}}
    [IsLocallyNoetherian Y] {sY : Y ⟶ Spec (.of k)} [LocallyOfFinitePresentation sY]
    (hsm : IsSmoothScheme sY) {T : TopologicalSpace.Closeds Y} (hT : IsSNCSubset sY T) :
    ∃ S : Finset (MMP.Mori.PrimeDivisor Y),
      DivisorWithCoeffs.IsSNC sY (∑ E ∈ S, Finsupp.single E (1 : ℤ)) ∧
      ∀ F : MMP.Mori.PrimeDivisor Y, F.genericPoint ∈ (T : Set Y) → F ∈ S := by
  rcases hT with h0 | ⟨s, hs, hsnc⟩
  · refine ⟨∅, ?_, fun F hF => ?_⟩
    · rw [Finset.sum_empty]
      exact DivisorWithCoeffs.isSNC_zero_of_isSmoothScheme _ hsm
    · rw [h0] at hF
      exact absurd hF (by simp)
  · refine ⟨s, hsnc, fun F hF => ?_⟩
    rw [← hs] at hF
    obtain ⟨E, hE, hgen⟩ := Set.mem_iUnion₂.mp hF
    rwa [MMP.Threefold.Resolution.eq_of_genericPoint_mem_support hgen] at hE

/-- A prime divisor of a proper birational model that is not exceptional maps generically onto a
prime divisor `P` of `X`, and its coefficient in the crepant boundary is `coeff_P Δ`. -/
private theorem exists_coeff_eq_of_not_isExceptional {k : Type} [Field k] [PerfectField k]
    {X Y : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {sX : X ⟶ Spec (.of k)} {n : ℕ} {K : Divisor X} {Δ : QDivisor X}
    (hP : IsPairWith sX n K Δ) {f : Y ⟶ X} (hY : IsNormalVariety k (f ≫ sX))
    (hf : IsBirationalMorphism f) {ΔY : QDivisor Y}
    (hΔY : IsCrepantBoundary sX n K Δ f hY hf ΔY) {G : MMP.Mori.PrimeDivisor Y}
    (hG : ¬ (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX).IsExceptional) :
    ∃ P : MMP.Mori.PrimeDivisor X, ΔY.coeff G = Δ.coeff P ∧
      f G.genericPoint = P.genericPoint := by
  obtain ⟨P, hc, hd⟩ := DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hP _ hG
  have hη : f G.genericPoint = P.genericPoint := by
    refine (inseparable_iff_closure_eq.2 ?_).eq
    rw [← DivisorOver.center_eq_closure_genericPoint (⟨Y, f, hY, hf, G⟩ : DivisorOver k sX), hc,
      AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  exact ⟨P, neg_injective ((hΔY G).eq hd), hη⟩

private theorem exists_pos_forall_le {α : Type*} (s : Finset α) (p : α → Prop) (g : α → ℚ)
    (h : ∀ x ∈ s, p x → 0 < g x) : ∃ ε : ℚ, 0 < ε ∧ ∀ x ∈ s, p x → ε ≤ g x := by
  classical
  refine ⟨(insert 1 ((s.filter p).image g)).min' (Finset.insert_nonempty _ _), ?_,
    fun x hx hpx => Finset.min'_le _ _ (by simpa using Or.inr ⟨x, ⟨hx, hpx⟩, rfl⟩)⟩
  simpa [Finset.lt_min'_iff] using fun _ x hx hpx hgx => hgx ▸ h x hx hpx

/-- **Klt from one log resolution.** Let `(X, Δ)` be a pair with every coefficient `< 1`, and
`g : Y ⟶ X` a log resolution of an `ℝ`-divisor `R` whose support contains that of `Δ`. If every
prime divisor of `Y` has discrepancy `> -1`, then `(X, Δ)` is klt. -/
private theorem isKltPair_of_isSNC_finset {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {n : ℕ} {K : Divisor X} {Δ : QDivisor X} (hP : IsPairWith sX n K Δ)
    (hΔ : ∀ P : MMP.Mori.PrimeDivisor X, Δ.coeff P < 1) {Y : Scheme.{0}} {g : Y ⟶ X}
    (hg : MMP.Mori.IsSmoothResolution sX g) (S : Finset (MMP.Mori.PrimeDivisor Y))
    (hsncS : DivisorWithCoeffs.IsSNC (g ≫ sX) (∑ E ∈ S, Finsupp.single E (1 : ℤ)))
    (hexcS : ∀ (hY : IsNormalVariety k (g ≫ sX)) (G : MMP.Mori.PrimeDivisor Y),
      (⟨Y, g, hY, hg.isBirationalMorphism, G⟩ : DivisorOver k sX).IsExceptional → G ∈ S)
    (hsuppS : ∀ (G : MMP.Mori.PrimeDivisor Y) (P : MMP.Mori.PrimeDivisor X),
      g G.genericPoint = P.genericPoint → Δ.coeff P ≠ 0 → G ∈ S)
    (h : ∀ (hY : IsNormalVariety k (g ≫ sX)) (G : MMP.Mori.PrimeDivisor Y) (a : ℚ),
      IsDiscrepancy sX n K Δ ⟨Y, g, hY, hg.isBirationalMorphism, G⟩ a → -1 < a) :
    MMP.Mori.IsKltPair sX n K Δ := by
  classical
  have hX : IsNormalVariety k sX := hP.1
  obtain ⟨hY, hdimY, -⟩ := hg.isNormalVariety hX
  have : IsIntegral Y := hY.1.toIsIntegral
  have : LocallyOfFiniteType (g ≫ sX) := hY.1.toLocallyOfFiniteType
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
  have : IsNormal Y := hY.2
  have : IsProper g := hg.isProper
  have : MMP.Mori.IsVariety k sX := hX.1
  have : MMP.Mori.IsVariety k (g ≫ sX) := hY.1
  have : IsDominant g := hg.isBirationalMorphism.isDominant
  have : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (g ≫ sX)
  set hgb := hg.isBirationalMorphism
  let DG : MMP.Mori.PrimeDivisor Y → DivisorOver k sX := fun G => ⟨Y, g, hY, hgb, G⟩
  obtain ⟨KY, hKY⟩ := exists_isCanonicalDivisor_of_isSmoothScheme (g ≫ sX) hg.isSmoothScheme
    (hdimY.trans hP.2.1.topologicalKrullDim_eq)
  obtain ⟨⟨Θ, hΘ, -⟩, -⟩ := IsPair.existsUnique_isCrepantBoundary hP.isPair hP.2.1 g hY hgb
  have hθ : ∀ G, Θ.coeff G < 1 := fun G => by
    have := h hY G _ (hΘ G)
    linarith
  have hexcS' : ∀ G : MMP.Mori.PrimeDivisor Y, (DG G).IsExceptional → G ∈ S := hexcS hY
  have hsuppS' : ∀ G, Θ.coeff G ≠ 0 → G ∈ S := by
    intro G hG0
    by_cases hG : (DG G).IsExceptional
    · exact hexcS' G hG
    obtain ⟨P, hc, hη⟩ := exists_coeff_eq_of_not_isExceptional hP hY hgb hΘ hG
    exact hsuppS G P hη (hc ▸ hG0)
  have hsuppΘ : Θ.support ⊆ (∑ E ∈ S, Finsupp.single E (1 : ℤ)).support := by
    intro G hG
    have hGS := hsuppS' G (Finsupp.mem_support_iff.mp hG)
    rw [Finsupp.mem_support_iff, Finsupp.finset_sum_apply]
    simp [Finsupp.single_apply, hGS]
  have hYklt := isKltPair_of_isSNC (g ≫ sX) hY hg.isSmoothScheme hKY
    (hsncS.of_support_subset hsuppΘ) hθ
  -- a uniform bound on the exceptional discrepancies
  obtain ⟨δ, hδ, hδS⟩ := exists_pos_forall_le S (fun _ => True) (fun G => 1 - Θ.coeff G)
    (fun G _ _ => by linarith [hθ G])
  refine ⟨hP, ?_, roundDown_nonpos_iff.mpr hΔ⟩
  rw [IsCrepantBoundary.discrep_eq_min hP.isPair hP.2.1 hKY hΘ]
  refine lt_min hYklt.2.1 (lt_of_lt_of_le (b := (((-1 + δ : ℚ) : ℝ) : EReal)) ?_ ?_)
  · have hδ' : (0 : ℝ) < δ := by exact_mod_cast hδ
    have : ((-1 : ℝ) : EReal) < (((-1 + δ : ℚ) : ℝ) : EReal) :=
      EReal.coe_lt_coe_iff.mpr (by push_cast; linarith)
    simpa using this
  · refine le_sInf ?_
    rintro _ ⟨E, a, hE, ha, rfl⟩
    have haE : a = -Θ.coeff E := ha.eq (hΘ E)
    have := hδS E (hexcS' E hE) trivial
    exact EReal.coe_le_coe_iff.mpr (by exact_mod_cast (show (-1 + δ : ℚ) ≤ a by rw [haE]; linarith))

/-- On an integral scheme, a generization of the generic point of a prime divisor is that point or
the generic point. -/
private theorem eq_or_eq_genericPoint_of_specializes {X : Scheme.{0}} [IsIntegral X]
    (P : MMP.Mori.PrimeDivisor X) {x : X} (h : x ⤳ P.genericPoint) :
    x = P.genericPoint ∨ x = genericPoint X := by
  by_cases hx : x = P.genericPoint
  · exact Or.inl hx
  right
  have hle : P.genericPoint ≤ x := h
  have hnot : ¬ x ≤ P.genericPoint := fun h' =>
    hx (Specializes.antisymm (h' : P.genericPoint ⤳ x) h).eq.symm
  have hlt : P.genericPoint < x := lt_of_le_not_ge hle hnot
  have h1 := P.coheight_genericPoint
  have h0 : Order.coheight x = 0 := by
    have key := Order.coheight_add_one_le hlt
    rw [h1] at key
    revert key
    generalize Order.coheight x = c
    intro key
    induction c using ENat.recTopCoe with
    | top => simp at key
    | coe n =>
      have hn : n + 1 ≤ 1 := by exact_mod_cast key
      have : n = 0 := by omega
      simp [this]
  have hmax : IsMax x := Order.coheight_eq_zero.mp h0
  exact (Specializes.antisymm (hmax (genericPoint_specializes x))
    (genericPoint_specializes x)).eq

/-- A birational morphism does not map the generic point of a prime divisor to the generic point:
the stalk map there would identify the field `K(X)` with a discrete valuation ring. -/
private theorem map_genericPoint_ne_genericPoint {X Y : Scheme.{0}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] {g : Y ⟶ X} (hg : IsBirationalMorphism g)
    (E : MMP.Mori.PrimeDivisor Y) : g E.genericPoint ≠ genericPoint X := by
  intro h
  haveI := hg.isDominant
  have hfield : IsField (X.presheaf.stalk (g E.genericPoint)) := by
    rw [h]; exact (Field.toIsField X.functionField)
  letI := hfield.toField
  haveI : ValuationRing (X.presheaf.stalk (g E.genericPoint)) := inferInstance
  haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing g hg.functionFieldMap_bijective
    E.genericPoint
  have e := (asIso (g.stalkMap E.genericPoint)).commRingCatIsoToRingEquiv
  have hE := E.isDiscreteValuationRing_localRing
  exact IsDiscreteValuationRing.not_isField _ (e.symm.toMulEquiv.isField hfield)

/-- Over the generic point of every prime divisor of `X` lies the generic point of a prime divisor
of a log resolution: a point of the fibre either lies in the exceptional set, which is a union of
prime divisors, or `g` is an isomorphism over the image. -/
private theorem exists_primeDivisor_map_genericPoint_eq {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    {R : RDivisor X} {g : Y ⟶ X} (hg : MMP.Mori.IsLogResolution sX R g)
    (hY : IsNormalVariety k (g ≫ sX)) (P : MMP.Mori.PrimeDivisor X) :
    ∃ F : MMP.Mori.PrimeDivisor Y, g F.genericPoint = P.genericPoint := by
  haveI : IsIntegral Y := hY.1.toIsIntegral
  haveI : LocallyOfFiniteType (g ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
  haveI : IsNormal Y := hY.2
  haveI : IsProper g := hg.isProper
  haveI : IsDominant g := hg.isBirationalMorphism.isDominant
  obtain ⟨y, hy⟩ := g.surjective P.genericPoint
  by_cases hyE : y ∈ (MMP.Mori.exceptionalSet g : Set Y)
  · rcases hg.isSNCSubset with h0 | ⟨s, hs, -⟩
    · exfalso
      have : y ∈ ((MMP.Mori.exceptionalSet g ⊔ R.supp.preimage g.continuous :
          TopologicalSpace.Closeds Y) : Set Y) := Or.inl hyE
      rw [h0] at this
      exact this
    · have hy' : y ∈ ⋃ E ∈ s, (E.support : Set Y) := by rw [hs]; exact Or.inl hyE
      obtain ⟨E, -, hyE'⟩ := Set.mem_iUnion₂.mp hy'
      have hsp : E.genericPoint ⤳ y := by
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure] at hyE'
        exact specializes_iff_mem_closure.mpr hyE'
      have hsp' : g E.genericPoint ⤳ P.genericPoint := hy ▸ hsp.map g.continuous
      rcases eq_or_eq_genericPoint_of_specializes P hsp' with h | h
      · exact ⟨E, h⟩
      · exact absurd h (map_genericPoint_ne_genericPoint hg.isBirationalMorphism E)
  · have hV : P.genericPoint ∈ biregularLocus g := by
      rw [← hy]
      exact not_not.mp hyE
    obtain ⟨F, -, hF⟩ := MMP.Flips.exists_inverseTransformPrimeDivisor_eq_some P hV
    exact ⟨F, hF⟩

open MMP.Mori.DivisorialCyclicCover in
private theorem exists_generalMember_of_isLogResolution {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (sX : X ⟶ Spec (.of k)) (hXv : AlgebraicGeometry.IsVariety k sX)
    {n : ℕ} {K : Divisor X} {B₀ : QDivisor X} (hklt : MMP.Mori.IsKltPair sX n K B₀) (hB₀ : 0 ≤ B₀)
    {Y : Scheme.{0}} {g : Y ⟶ X} (hg : MMP.Mori.IsLogResolution sX (QDivisor.toRDivisor B₀) g)
    {m : ℕ} [NeZero m] (M : Divisor X) (hmM : (m • M).IsCartier) {N : ℕ}
    (s : Fin (N + 1) → (m • M).divisorialSubmodule ⊤)
    (hfree : ∀ x : X, ∃ i, ∃ hi : s i ≠ 0, x ∉ ((m • M).zeroDivisor (s i) hi).supp)
    (hnz : ∀ (σ : (m • M).divisorialSubmodule ⊤) (hσ : σ ≠ 0), (m • M).zeroDivisor σ hσ ≠ 0)
    (hdim : 1 ≤ topologicalKrullDim X) :
    ∃ (φ : (RationalFunctions X)ˣ) (hφ : 0 ≤ principalDivisor φ + m • M),
      (∀ E, (principalDivisor φ + m • M).coeff E ≤ 1) ∧
      MMP.Mori.IsKltPair sX n K
        (B₀ + ((1 : ℚ) - 1 / m) • Divisor.toQDivisor (principalDivisor φ + m • M)) ∧
      IsNormalVariety k (toBase m M hφ ≫ sX) := by
  classical
  have hX : IsNormalVariety k sX := hklt.1.1
  obtain ⟨hY, -, -⟩ := hg.toIsSmoothResolution.isNormalVariety hX
  haveI : IsIntegral Y := hY.1.toIsIntegral
  haveI : LocallyOfFiniteType (g ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (g ≫ sX)
  haveI : IsNormal Y := hY.2
  haveI : IsDominant g := hg.isBirationalMorphism.isDominant
  obtain ⟨s₀, hsnc₀, hmem₀⟩ := exists_finset_isSNC hg.isSmoothScheme hg.isSNCSubset
  obtain ⟨Q₁, hQ₁, hBer⟩ :=
    MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.Bertini5d.exists_polynomial_isSNC_pullback_zeroDivisor_add_finset hX
      hg.toIsSmoothResolution s hfree s₀ hsnc₀
  obtain ⟨j, hj, -⟩ := hfree (Nonempty.some inferInstance)
  obtain ⟨Q₀, hQ₀, hσ0⟩ := MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation.exists_polynomial_sum_smul_ne_zero sX s j hj
  have hne : ∃ U : (MMP.Threefold.Bridges.coefficientSpace k N).Opens,
      Dense (U : Set (MMP.Threefold.Bridges.coefficientSpace k N)) ∧
      ∀ c : Fin (N + 1) → k, MMP.Threefold.Bridges.coefficientPoint c ∈ U →
        ∃ hc : ∑ i, scalarsToGlobalSections k sX (c i) • s i ≠ 0,
          (m • M).zeroDivisor _ hc ≠ 0 := by
    refine ⟨PrimeSpectrum.basicOpen Q₀, (PrimeSpectrum.basicOpen Q₀).isOpen.dense ?_,
      fun c hc => ?_⟩
    · refine (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp fun h => hQ₀ ?_
      exact ((PrimeSpectrum.basicOpen_eq_bot_iff Q₀).mp h).eq_zero
    have hev : MvPolynomial.eval c Q₀ ≠ 0 := fun h0 => hc (RingHom.mem_ker.mpr h0)
    exact ⟨hσ0 c hev, hnz _ _⟩
  obtain ⟨U₃, hU₃, hcov⟩ := exists_dense_open_isNormalVariety_cover k sX hXv hdim m M hmM s hfree hne
  obtain ⟨f, hf0, hfU⟩ : ∃ f : MvPolynomial (Fin (N + 1)) k, f ≠ 0 ∧ ∀ c : Fin (N + 1) → k,
      MvPolynomial.eval c f ≠ 0 → MMP.Threefold.Bridges.coefficientPoint c ∈ U₃ := by
    obtain ⟨p, hp⟩ := hU₃.nonempty
    obtain ⟨_, ⟨f, rfl⟩, hpf, hfU⟩ :=
      (PrimeSpectrum.isTopologicalBasis_basic_opens (R := MvPolynomial (Fin (N + 1)) k)).exists_subset_of_mem_open
        hp U₃.isOpen
    refine ⟨f, fun h0 => ?_, fun c hc => hfU fun hf => hc (RingHom.mem_ker.mp hf)⟩
    rw [h0] at hpf
    exact hpf (zero_mem _)
  obtain ⟨c, hc⟩ : ∃ c : Fin (N + 1) → k, MvPolynomial.eval c (Q₀ * Q₁ * f) ≠ 0 := by
    by_contra h
    push Not at h
    exact mul_ne_zero (mul_ne_zero hQ₀ hQ₁) hf0 (MvPolynomial.funext fun c => by simpa using h c)
  rw [map_mul, map_mul] at hc
  have hc1 := right_ne_zero_of_mul (left_ne_zero_of_mul hc)
  have hcf := right_ne_zero_of_mul hc
  obtain ⟨hσ, hBc, H', hH', h01, hsncH⟩ := hBer c hc1
  obtain ⟨-, hnorm⟩ := hcov c (hfU c hcf)
  obtain ⟨hφ, hYn⟩ := hnorm (Divisor.isUnit_sectionToRationalFunctions hσ).unit
    (IsUnit.unit_spec _)
  set φ := (Divisor.isUnit_sectionToRationalFunctions hσ).unit with hφdef
  set G : Divisor X := principalDivisor φ + m • M with hGdef
  have hGz : (m • M).zeroDivisor _ hσ = G := rfl
  have hG0 : 0 ≤ G := hGz ▸ Divisor.zeroDivisor_nonneg _ _ hσ
  have hGc : G.IsCartier := (Divisor.isCartier_principalDivisor φ).add hmM
  replace hH' : Divisor.IsPullback g G hBc H' := hH'
  have hH'0 : ∀ F, 0 ≤ H'.coeff F := fun F =>
    MMP.Fourfold.coeff_nonneg_of_isPullback_of_isEffectiveOn hGc (V := ⊤) (fun P _ => hG0 P) hH' F
      (by
        refine ⟨F.genericPoint, ?_, trivial⟩
        rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
        exact subset_closure rfl)
  -- coefficient of the reduced boundary
  have hsum : ∀ F : MMP.Mori.PrimeDivisor Y,
      (∑ E ∈ s₀, Finsupp.single E (1 : ℤ) : Divisor Y).coeff F = if F ∈ s₀ then 1 else 0 := by
    intro F
    change (∑ E ∈ s₀, Finsupp.single E (1 : ℤ)) F = _
    rw [Finsupp.finsetSum_apply]
    simp [Finsupp.single_apply]
  have hcoeffF : ∀ F, (H' + ∑ E ∈ s₀, Finsupp.single E (1 : ℤ)).coeff F =
      H'.coeff F + if F ∈ s₀ then 1 else 0 := fun F => by
    rw [DivisorWithCoeffs.coeff_add, hsum]
  have hH'S : ∀ F ∈ s₀, H'.coeff F = 0 := fun F hF => by
    have := h01 F
    rw [hcoeffF, if_pos hF] at this
    have := hH'0 F
    omega
  have hH'le : ∀ F, H'.coeff F ≤ 1 := fun F => by
    have := h01 F
    rw [hcoeffF] at this
    split_ifs at this <;> omega
  -- the coefficient of `G` along a prime divisor is read off on `Y`
  have hbij := hg.isBirationalMorphism.functionFieldMap_bijective
  have hGH : ∀ (F : MMP.Mori.PrimeDivisor Y) (P : MMP.Mori.PrimeDivisor X),
      g F.genericPoint = P.genericPoint → H'.coeff F = G.coeff P := fun F P hFP => by
    have := P.isDiscreteValuationRing_localRing
    haveI : ValuationRing (X.presheaf.stalk (g F.genericPoint)) := by rw [hFP]; infer_instance
    haveI := MMP.Positivity.isIso_stalkMap_of_valuationRing g hbij F.genericPoint
    exact MMP.Positivity.coeff_eq_of_isPullback F P hFP hGc hH'
  have hG1 : ∀ P, G.coeff P ≤ 1 := fun P => by
    obtain ⟨F, hF⟩ := exists_primeDivisor_map_genericPoint_eq hg hY P
    rw [← hGH F P hF]
    exact hH'le F
  refine ⟨φ, hφ, hG1, ?_, hYn⟩
  -- the klt pair `(X, B₀ + cG)`, `c = 1 - 1/m`
  have hm1 : (1 : ℚ) ≤ m := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne m)
  set c : ℚ := 1 - 1 / m with hcdef
  have hc0 : 0 ≤ c := by
    rw [hcdef, sub_nonneg]; exact div_le_one_of_le₀ hm1 (by linarith)
  have hc1 : c < 1 := by
    rw [hcdef]; have : 0 < 1 / (m : ℚ) := by positivity
    linarith
  have hGq : (Divisor.toQDivisor G).IsQCartier := QDivisor.isQCartier_toQDivisor hGc
  have hPΔ : IsPairWith sX n K (B₀ + c • Divisor.toQDivisor G) := ⟨hklt.1.1, hklt.1.2.1, by
    rw [← add_assoc]; exact hklt.1.2.2.add (MMP.Flips.QDivisor.IsQCartier.qsmul hGq c)⟩
  have hΔc : ∀ P, (B₀ + c • Divisor.toQDivisor G).coeff P = B₀.coeff P + c * G.coeff P := by
    intro P
    rw [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, Divisor.coeff_toQDivisor,
      smul_eq_mul]
  have hB₀1 : ∀ P, B₀.coeff P < 1 := roundDown_nonpos_iff.mp hklt.2.2
  have hS₀ : ∀ (F : MMP.Mori.PrimeDivisor Y) (P : MMP.Mori.PrimeDivisor X),
      g F.genericPoint = P.genericPoint → B₀.coeff P ≠ 0 → F ∈ s₀ := by
    intro F P hFP hP
    apply hmem₀ F
    refine Or.inr ?_
    change g F.genericPoint ∈ (QDivisor.toRDivisor B₀).supp
    rw [hFP]
    exact DivisorWithCoeffs.support_subset_supp
      (by rwa [QDivisor.coeff_toRDivisor, Rat.cast_ne_zero])
      (MMP.Flips.primeDivisor_genericPoint_mem_support P)
  have hΔ1 : ∀ P, (B₀ + c • Divisor.toQDivisor G).coeff P < 1 := by
    intro P
    obtain ⟨F, hF⟩ := exists_primeDivisor_map_genericPoint_eq hg hY P
    rw [hΔc]
    by_cases hB : B₀.coeff P = 0
    · rw [hB, zero_add]
      have h1 : (G.coeff P : ℚ) ≤ 1 := by exact_mod_cast hG1 P
      have h2 : (0 : ℚ) ≤ G.coeff P := by exact_mod_cast hG0 P
      nlinarith
    · have hGP : G.coeff P = 0 := by rw [← hGH F P hF]; exact hH'S F (hS₀ F P hF hB)
      rw [hGP]; simpa using hB₀1 P
  set S := (H' + ∑ E ∈ s₀, Finsupp.single E (1 : ℤ)).support with hSdef
  have hmemS : ∀ F, F ∈ S ↔ (H' + ∑ E ∈ s₀, Finsupp.single E (1 : ℤ)).coeff F ≠ 0 :=
    fun F => Finsupp.mem_support_iff
  refine isKltPair_of_isSNC_finset hPΔ hΔ1 hg.toIsSmoothResolution S ?_ ?_ ?_ ?_
  · refine hsncH.of_support_subset fun F hF => ?_
    rw [Finsupp.mem_support_iff, Finsupp.finsetSum_apply] at hF
    by_contra hFS
    apply hF
    refine Finset.sum_eq_zero fun E hE => ?_
    rw [Finsupp.single_apply, if_neg]
    rintro rfl
    exact hFS hE
  · intro hY' F hF
    have hFs : F ∈ s₀ := hmem₀ F (Or.inl (MMP.Positivity.support_subset_exceptionalSet F hF
      (MMP.Flips.primeDivisor_genericPoint_mem_support F)))
    rw [hmemS, hcoeffF, if_pos hFs]
    have := hH'0 F
    omega
  · intro F P hFP hΔP
    rw [hmemS, hcoeffF]
    rw [hΔc] at hΔP
    by_cases hB : B₀.coeff P = 0
    · have hGP : G.coeff P ≠ 0 := by
        intro h; apply hΔP; rw [hB, h]; simp
      have h1 := hGH F P hFP
      have h0 := hH'0 F
      have : H'.coeff F ≠ 0 := by rw [h1]; exact hGP
      split_ifs <;> omega
    · rw [if_pos (hS₀ F P hFP hB)]
      have := hH'0 F
      omega
  · intro hY' F a ha
    by_cases hexc : (⟨Y, g, hY', hg.toIsSmoothResolution.isBirationalMorphism, F⟩ :
        DivisorOver k sX).IsExceptional
    · have hFs : F ∈ s₀ := hmem₀ F (Or.inl (MMP.Positivity.support_subset_exceptionalSet F hexc
        (MMP.Flips.primeDivisor_genericPoint_mem_support F)))
      obtain ⟨-, hB', hshift⟩ := MMP.Mori.IsPairWith.isDiscrepancy_add_smul_iff hklt.1 hGq
        ⟨Y, g, hY', hg.toIsSmoothResolution.isBirationalMorphism, F⟩
      have hpbQ := MMP.Mori.QDivisor.isPullback_toQDivisor hGc hB' hH'
      have key := ((hshift _ hpbQ).2 c a).mp (by
        have h0 : (Divisor.toQDivisor H').coeff F = 0 := by
          rw [Divisor.coeff_toQDivisor, hH'S F hFs]; rfl
        change IsDiscrepancy sX n K (B₀ + c • Divisor.toQDivisor G) _ (a - c * (Divisor.toQDivisor H').coeff F)
        rw [h0, mul_zero, sub_zero]
        exact ha)
      have h1 := lt_of_lt_of_le hklt.2.1 (discrep_le hexc key)
      have h2 : ((-1 : ℝ) : EReal) < ((a : ℝ) : EReal) := by
        rw [EReal.coe_neg, EReal.coe_one]; exact h1
      have h3 : (-1 : ℝ) < a := EReal.coe_lt_coe_iff.mp h2
      exact_mod_cast h3
    · obtain ⟨P, -, hd⟩ := DivisorOver.exists_center_eq_isDiscrepancy_neg_coeff hPΔ _ hexc
      rw [ha.eq hd]
      linarith [hΔ1 P]

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.KltTest5d

namespace MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback

open CategoryTheory MMP.Mori
open AlgebraicGeometry hiding PrimeDivisor IsVariety

/-! ### Discrete valuation rings -/

section Algebra

open IsLocalRing KaehlerDifferential TensorProduct

/-- A field map `ι : K₁ → K₂` carrying the image of `A₁` into that of `A₂` restricts to a ring
map `A₁ → A₂`, for `A₂ ⊆ K₂` (a fraction ring). -/
private theorem exists_ringHom_of_range {K₁ K₂ A₁ A₂ : Type*} [Field K₁] [Field K₂] [CommRing A₁]
    [CommRing A₂] [Algebra A₁ K₁] [Algebra A₂ K₂] [IsFractionRing A₂ K₂] (ι : K₁ →+* K₂)
    (h : ∀ a₁ : A₁, ∃ a₂ : A₂, algebraMap A₂ K₂ a₂ = ι (algebraMap A₁ K₁ a₁)) :
    ∃ φ : A₁ →+* A₂, ∀ a, algebraMap A₂ K₂ (φ a) = ι (algebraMap A₁ K₁ a) := by
  choose φ hφ using h
  have inj : Function.Injective (algebraMap A₂ K₂) := IsFractionRing.injective A₂ K₂
  exact ⟨{ toFun := φ
           map_one' := inj (by rw [hφ]; simp)
           map_mul' := fun a b => inj (by rw [hφ]; simp [hφ])
           map_zero' := inj (by rw [hφ]; simp)
           map_add' := fun a b => inj (by rw [hφ]; simp [hφ]) }, hφ⟩

open Polynomial in
/-- **The residue extension of an algebraic extension of valuation rings is algebraic.** Let
`A → B` be a local homomorphism from a discrete valuation ring `A` to a local domain `B`, with
fraction fields `K` of `A` and `L ⊇ B`, compatibly with an algebraic extension `K → L`. Then
`κ(B)` is algebraic over `κ(A)`: an algebraic equation of `b ∈ B` over `A`, divided by its
content, has a unit coefficient, and reduces to a nonzero equation of `b̄` over `κ(A)`. -/
private theorem isAlgebraic_residueField_of_isAlgebraic {A B K L : Type*} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [CommRing B] [IsDomain B] [IsLocalRing B] [Algebra A B]
    [IsLocalHom (algebraMap A B)] [Field K] [Field L] [Algebra A K] [IsFractionRing A K]
    [Algebra B L] [Algebra K L] [Algebra.IsAlgebraic K L]
    (hBL : Function.Injective (algebraMap B L))
    (hcomp : ∀ a, algebraMap B L (algebraMap A B a) = algebraMap K L (algebraMap A K a)) :
    Algebra.IsAlgebraic (ResidueField A) (ResidueField B) := by
  classical
  letI : Algebra A L := ((algebraMap K L).comp (algebraMap A K)).toAlgebra
  haveI : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower A B L := IsScalarTower.of_algebraMap_eq fun a => (hcomp a).symm
  letI := UniqueFactorizationMonoid.normalizationMonoid (α := A)
  letI := UniqueFactorizationMonoid.toNormalizedGCDMonoid A
  have hAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  have hAB : Function.Injective (algebraMap A B) := by
    intro x y hxy
    apply hAL
    rw [IsScalarTower.algebraMap_apply A B L, hxy, ← IsScalarTower.algebraMap_apply]
  refine ⟨fun y => ?_⟩
  obtain ⟨b, rfl⟩ := residue_surjective y
  obtain ⟨p, hp0, hpb⟩ : IsAlgebraic A (algebraMap B L b) :=
    (IsFractionRing.isAlgebraic_iff A K L).mpr (Algebra.IsAlgebraic.isAlgebraic _)
  have hp : aeval b p = 0 := hBL (by rw [map_zero, ← aeval_algebraMap_apply]; exact hpb)
  set q := p.primPart
  have hq : aeval b q = 0 := by
    have h1 := hp
    rw [p.eq_C_content_mul_primPart, map_mul, aeval_C] at h1
    refine (mul_eq_zero.mp h1).resolve_left ?_
    rw [map_eq_zero_iff _ hAB]
    exact (content_eq_zero_iff).not.mpr hp0
  have hqprim := p.isPrimitive_primPart
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible A
  have hex : ∃ j, q.coeff j ∉ maximalIdeal A := by
    by_contra hcon
    push Not at hcon
    have hdvd : C ϖ ∣ q := by
      rw [C_dvd_iff_dvd_coeff]
      intro j
      have := hcon j
      rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ,
        Ideal.mem_span_singleton] at this
      exact this
    exact hϖ.not_isUnit (hqprim ϖ hdvd)
  obtain ⟨j, hj⟩ := hex
  refine ⟨q.map (residue A), fun h0 => hj ?_, ?_⟩
  · have := congrArg (fun r => r.coeff j) h0
    simp only [coeff_map, coeff_zero] at this
    exact (residue_eq_zero_iff _).mp this
  · have key : ∀ x : A, algebraMap (ResidueField A) (ResidueField B) (residue A x) =
        residue B (algebraMap A B x) := fun x => rfl
    rw [aeval_def, eval₂_map]
    have : (algebraMap (ResidueField A) (ResidueField B)).comp (residue A) =
        (residue B).comp (algebraMap A B) := RingHom.ext key
    rw [this, ← hom_eval₂, ← aeval_def, hq, map_zero]

/-- If `f` is onto modulo `x₀` (its kernel lies in `R ∙ x₀`) and the `f (y i)` span, then `x₀` and
the `y i` span. -/
private theorem span_cons_eq_top_of_ker_le {R V Q : Type*} [CommRing R] [AddCommGroup V]
    [Module R V] [AddCommGroup Q] [Module R Q] (f : V →ₗ[R] Q) (x₀ : V)
    (hker : LinearMap.ker f ≤ R ∙ x₀)
    {r : ℕ} (y : Fin r → V) (hy : Submodule.span R (Set.range (f ∘ y)) = ⊤) :
    Submodule.span R (Set.range (Fin.cons x₀ y : Fin (r + 1) → V)) = ⊤ := by
  refine eq_top_iff.mpr fun v _ => ?_
  have hv : f v ∈ (Submodule.span R (Set.range y)).map f := by
    rw [Submodule.map_span, ← Set.range_comp, hy]; trivial
  obtain ⟨w, hw, hfw⟩ := hv
  have hsub : Submodule.span R (Set.range y) ≤
      Submodule.span R (Set.range (Fin.cons x₀ y : Fin (r + 1) → V)) :=
    Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨i.succ, by simp⟩)
  have h0 : R ∙ x₀ ≤ Submodule.span R (Set.range (Fin.cons x₀ y : Fin (r + 1) → V)) :=
    Submodule.span_mono (by rintro _ rfl; exact ⟨0, by simp⟩)
  have : v - w ∈ LinearMap.ker f := by simp [hfw]
  have := h0 (hker this)
  simpa using Submodule.add_mem _ this (hsub hw)

/-- The wedge of a spanning family of `n` vectors generates the `n`-th exterior power. -/
private theorem span_singleton_ιMulti_eq_top {R M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] {n : ℕ} (v : Fin n → M) (hv : Submodule.span R (Set.range v) = ⊤) :
    Submodule.span R {exteriorPower.ιMulti R n v} = ⊤ := by
  refine eq_top_iff.mpr ((exteriorPower.ιMulti_span_of_span R n M hv).symm.le.trans ?_)
  rw [Submodule.span_le]
  rintro _ ⟨a, ha, rfl⟩
  have : ∀ i, ∃ j, v j = a i := fun i => ha (Set.mem_range_self i)
  choose g hg using this
  have ha' : a = v ∘ g := funext fun i => (hg i).symm
  subst ha'
  by_cases hinj : Function.Injective g
  · let σ := Equiv.ofBijective g (Finite.injective_iff_bijective.mp hinj)
    have : v ∘ g = v ∘ σ := rfl
    rw [this, AlternatingMap.map_perm]
    exact Submodule.smul_of_tower_mem _ _ (Submodule.mem_span_singleton_self _)
  · simp only [Function.Injective, not_forall] at hinj
    obtain ⟨i, j, hij, hne⟩ := hinj
    rw [AlternatingMap.map_eq_zero_of_eq _ _ (show (v ∘ g) i = (v ∘ g) j by simp [hij]) hne]
    exact Submodule.zero_mem _

/-- Changing the first vector by an element of the span of the others, and scaling it, scales the
wedge. -/
private theorem ιMulti_cons_eq_smul {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    {r : ℕ} (y : Fin r → M) {x x' : M} (c : R) (hx : x - c • x' ∈ Submodule.span R (Set.range y)) :
    exteriorPower.ιMulti R (r + 1) (Fin.cons x y) =
      c • exteriorPower.ιMulti R (r + 1) (Fin.cons x' y) := by
  let L : M →ₗ[R] ⋀[R]^(r + 1) M :=
    (exteriorPower.ιMulti R (r + 1)).toMultilinearMap.toLinearMap (Fin.cons 0 y) 0
  have hL : ∀ z, L z = exteriorPower.ιMulti R (r + 1) (Fin.cons z y) := fun z => by
    simp [L, MultilinearMap.toLinearMap_apply, Fin.update_cons_zero]
  have hker : Submodule.span R (Set.range y) ≤ LinearMap.ker L := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, hL]
    exact AlternatingMap.map_eq_zero_of_eq _ _ (i := 0) (j := i.succ) (by simp)
      (Fin.succ_ne_zero i).symm
  have := hker hx
  rw [LinearMap.mem_ker, map_sub, map_smul, sub_eq_zero] at this
  rw [← hL, ← hL, this]

/-- For a local ring with principal maximal ideal `(π)`, the kernel of
`κ ⊗ Ω_{R/k} → Ω_{κ/k}` is spanned by `1 ⊗ dπ`. -/
private theorem ker_mapBaseChange_le {k R : Type*} [CommRing k] [CommRing R] [IsLocalRing R]
    [Algebra k R] {π : R} (hπ : maximalIdeal R = Ideal.span {π}) :
    LinearMap.ker (mapBaseChange k R (ResidueField R)) ≤
      (ResidueField R) ∙ ((1 : ResidueField R) ⊗ₜ[R] D k R π) := by
  intro y hy
  obtain ⟨z, rfl⟩ := (exact_kerCotangentToTensor_mapBaseChange k R _ (residue_surjective) y).mp hy
  obtain ⟨⟨x, hx⟩, rfl⟩ := Ideal.toCotangent_surjective _ z
  have hx' : x ∈ maximalIdeal R := by
    rw [← ker_residue]; exact hx
  rw [hπ] at hx'
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx'
  rw [kerCotangentToTensor_toCotangent, Derivation.leibniz, tmul_add, tmul_smul, tmul_smul,
    ← algebraMap_smul (ResidueField R) π, ← algebraMap_smul (ResidueField R) a]
  have : algebraMap R (ResidueField R) π = 0 := by
    rw [← RingHom.mem_ker, IsLocalRing.ResidueField.algebraMap_eq, ker_residue, hπ]
    exact Ideal.mem_span_singleton_self π
  rw [this, zero_smul, add_zero]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- If `R` and its residue field are formally smooth over `k`, then `1 ⊗ dπ ≠ 0` in
`κ ⊗ Ω_{R/k}` for `π ∈ 𝔪 \ 𝔪²`. -/
private theorem tmul_D_ne_zero {k R : Type*} [CommRing k] [CommRing R] [IsLocalRing R]
    [Algebra k R] [Algebra.FormallySmooth k R] [Algebra.FormallySmooth k (ResidueField R)]
    {π : R} (hπ : π ∈ maximalIdeal R) (hπ2 : π ∉ maximalIdeal R ^ 2) :
    ((1 : ResidueField R) ⊗ₜ[R] D k R π) ≠ 0 := by
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := k) (P := R)
    (A := ResidueField R) residue_surjective).mp inferInstance
  intro h0
  have hmem : π ∈ RingHom.ker (algebraMap R (ResidueField R)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq, ker_residue]; exact hπ
  have h1 : kerCotangentToTensor k R (ResidueField R)
      ((RingHom.ker (algebraMap R (ResidueField R))).toCotangent ⟨π, hmem⟩) = 0 := by
    rw [kerCotangentToTensor_toCotangent]; exact h0
  have h2 := congrArg l h1
  rw [← LinearMap.comp_apply, hl, LinearMap.id_apply, map_zero, Ideal.toCotangent_eq_zero] at h2
  apply hπ2
  have : RingHom.ker (algebraMap R (ResidueField R)) = maximalIdeal R := by
    rw [IsLocalRing.ResidueField.algebraMap_eq, ker_residue]
  rw [← this]; exact h2

/-- Nakayama for a free module of rank `r`: `r` vectors spanning `κ ⊗ M` span `M`. -/
private theorem span_eq_top_of_span_tmul {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] [Module.Free R M] {r : ℕ} (hr : Module.finrank R M = r)
    (v : Fin r → M)
    (hv : Submodule.span (ResidueField R) (Set.range fun i => (1 : ResidueField R) ⊗ₜ[R] v i) = ⊤) :
    Submodule.span R (Set.range v) = ⊤ := by
  have hfr : Module.finrank (ResidueField R) (ResidueField R ⊗[R] M) = r := by
    rw [Module.finrank_baseChange, hr]
  let b := basisOfTopLeSpanOfCardEqFinrank _ hv.ge (by simp [hfr])
  exact span_eq_top_of_tmul_eq_basis v b (fun i => by simp [b])

/-- **The tame computation.** For a local extension `A → B` of discrete valuation rings over a
field `k` of characteristic zero, with `Ω_{A/k}` and `Ω_{B/k}` free of rank `n` and separable
residue extension, if `t ↦ a s^e` for uniformizers `t`, `s` and a unit `a`, then some generators
of the top forms satisfy `h^* σ_A = w s^{e-1} σ_B` for a unit `w`. -/
private theorem exists_topFormsMap_eq_unit_mul_pow_smul {k A B : Type*} [Field k] [CharZero k]
    [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Algebra k A] [Algebra k B] [Algebra A B] [IsScalarTower k A B] [IsLocalHom (algebraMap A B)]
    [Algebra.FormallySmooth k A] [Algebra.FormallySmooth k (ResidueField A)]
    [Algebra.IsSeparable (ResidueField A) (ResidueField B)]
    [Module.Free A Ω[A⁄k]] [Module.Finite A Ω[A⁄k]] [Module.Free B Ω[B⁄k]] [Module.Finite B Ω[B⁄k]]
    {n : ℕ} (hA : Module.finrank A Ω[A⁄k] = n) (hB : Module.finrank B Ω[B⁄k] = n)
    {t : A} (ht : Irreducible t) {s : B} (hs : Irreducible s) {a : Bˣ} {e : ℕ}
    (he : algebraMap A B t = a * s ^ e) :
    ∃ σA : ⋀[A]^n Ω[A⁄k], Submodule.span A {σA} = ⊤ ∧
      ∃ σB : ⋀[B]^n Ω[B⁄k], Submodule.span B {σB} = ⊤ ∧
        ∃ w : Bˣ, topFormsMap k A B n σA = ((w : B) * s ^ (e - 1)) • σB := by
  classical
  have htm : t ∈ maximalIdeal A := (mem_maximalIdeal t).mpr ht.not_isUnit
  have hmA : maximalIdeal A = Ideal.span {t} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer t).mp ht
  have hmB : maximalIdeal B = Ideal.span {s} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer s).mp hs
  have ht2 : t ∉ maximalIdeal A ^ 2 := by
    rw [hmA, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    rintro ⟨c, hc⟩
    have : t * (1 - t * c) = 0 := by linear_combination hc
    rcases mul_eq_zero.mp this with h | h
    · exact ht.ne_zero h
    · exact ht.not_isUnit (isUnit_iff_exists_inv.mpr ⟨c, by linear_combination -h⟩)
  have hx₀ := tmul_D_ne_zero (k := k) htm ht2
  have hV : Module.finrank (ResidueField A) (ResidueField A ⊗[A] Ω[A⁄k]) = n := by
    rw [Module.finrank_baseChange, hA]
  obtain ⟨r, rfl⟩ : ∃ r, n = r + 1 := Nat.exists_eq_succ_of_ne_zero fun h0 => by
    rw [h0, Module.finrank_zero_iff] at hV
    exact hx₀ (Subsingleton.elim _ _)
  let fA := mapBaseChange k A (ResidueField A)
  have hfA : Function.Surjective fA := mapBaseChange_surjective k A _ residue_surjective
  have hfx₀ : fA ((1 : ResidueField A) ⊗ₜ[A] D k A t) = 0 := by
    simp [fA, mapBaseChange_tmul, (residue_eq_zero_iff t).mpr htm]
  have hkerA : LinearMap.ker fA = ResidueField A ∙ ((1 : ResidueField A) ⊗ₜ[A] D k A t) :=
    le_antisymm (ker_mapBaseChange_le hmA)
      ((Submodule.span_singleton_le_iff_mem _ _).mpr hfx₀)
  have hQ : Module.finrank (ResidueField A) Ω[ResidueField A⁄k] = r := by
    have h := LinearMap.finrank_range_add_finrank_ker fA
    rw [LinearMap.range_eq_top.mpr hfA, finrank_top, hkerA, finrank_span_singleton hx₀, hV] at h
    omega
  have : Module.Finite (ResidueField A) Ω[ResidueField A⁄k] := Module.Finite.of_surjective fA hfA
  have hspanQ : Submodule.span (ResidueField A)
      (Set.range fun x : A => D k (ResidueField A) (algebraMap A (ResidueField A) x)) = ⊤ := by
    refine eq_top_iff.mpr ((span_range_derivation k (ResidueField A)).symm.le.trans
      (Submodule.span_mono ?_))
    rintro _ ⟨y, rfl⟩
    obtain ⟨x, rfl⟩ := residue_surjective y
    exact ⟨x, rfl⟩
  obtain ⟨b, hbs, hbspan, hbli⟩ := exists_linearIndependent (ResidueField A)
    (Set.range fun x : A => D k (ResidueField A) (algebraMap A (ResidueField A) x))
  let bb := Module.Basis.mk hbli (by rw [Subtype.range_coe, hbspan, hspanQ])
  have : Finite b := Module.Finite.finite_basis bb
  have : Fintype b := Fintype.ofFinite b
  let eqv : Fin r ≃ b :=
    (Fintype.equivFinOfCardEq (by rw [← Module.finrank_eq_card_basis bb, hQ])).symm
  have hu : ∀ i, ∃ x : A, D k (ResidueField A) (algebraMap A (ResidueField A) x) = (eqv i).1 :=
    fun i => hbs (eqv i).2
  choose u hu using hu
  let bQ : Module.Basis (Fin r) (ResidueField A) Ω[ResidueField A⁄k] := bb.reindex eqv.symm
  have hbQ : ∀ i, bQ i = D k (ResidueField A) (algebraMap A (ResidueField A) (u i)) := fun i => by
    simp only [bQ, bb, Module.Basis.reindex_apply, Module.Basis.mk_apply, Equiv.symm_symm]
    exact (hu i).symm
  have hu' : Submodule.span (ResidueField A)
      (Set.range (fA ∘ fun i => (1 : ResidueField A) ⊗ₜ[A] D k A (u i))) = ⊤ := by
    rw [← bQ.span_eq]; congr 1; ext x
    simp [fA, mapBaseChange_tmul, hbQ]
  have hVspan := span_cons_eq_top_of_ker_le fA _ hkerA.le _ hu'
  set vA : Fin (r + 1) → Ω[A⁄k] := Fin.cons (D k A t) fun i => D k A (u i) with hvA_def
  have hvA : Submodule.span A (Set.range vA) = ⊤ := by
    refine span_eq_top_of_span_tmul hA vA ?_
    have : (fun i => (1 : ResidueField A) ⊗ₜ[A] vA i) =
        Fin.cons ((1 : ResidueField A) ⊗ₜ[A] D k A t) fun i => 1 ⊗ₜ[A] D k A (u i) := by
      funext i; cases i using Fin.cases <;> simp [vA]
    rw [this]; exact hVspan
  -- the side of `B`
  have : Algebra.FormallyEtale (ResidueField A) (ResidueField B) :=
    Algebra.FormallyEtale.of_isSeparable _ _
  let fB := mapBaseChange k B (ResidueField B)
  let bQ' := (KaehlerDifferential.isBaseChange_of_formallyEtale k (ResidueField A)
    (ResidueField B)).basis bQ
  have hu'B : Submodule.span (ResidueField B)
      (Set.range (fB ∘ fun i => (1 : ResidueField B) ⊗ₜ[B] D k B (algebraMap A B (u i)))) = ⊤ := by
    rw [← bQ'.span_eq]; congr 1; ext x
    simp [fB, bQ', mapBaseChange_tmul, hbQ, IsBaseChange.basis_apply]
  have hWspan := span_cons_eq_top_of_ker_le fB _ (ker_mapBaseChange_le (k := k) hmB) _ hu'B
  set vB : Fin (r + 1) → Ω[B⁄k] := Fin.cons (D k B s) fun i => D k B (algebraMap A B (u i))
    with hvB_def
  have hvB : Submodule.span B (Set.range vB) = ⊤ := by
    refine span_eq_top_of_span_tmul hB vB ?_
    have : (fun i => (1 : ResidueField B) ⊗ₜ[B] vB i) =
        Fin.cons ((1 : ResidueField B) ⊗ₜ[B] D k B s)
          fun i => 1 ⊗ₜ[B] D k B (algebraMap A B (u i)) := by
      funext i; cases i using Fin.cases <;> simp [vB]
    rw [this]; exact hWspan
  refine ⟨_, span_singleton_ιMulti_eq_top vA hvA, _, span_singleton_ιMulti_eq_top vB hvB, ?_⟩
  rw [topFormsMap_ιMulti]
  have hcomp : (fun i => KaehlerDifferential.map k k A B (vA i)) =
      Fin.cons (D k B (algebraMap A B t)) fun i => D k B (algebraMap A B (u i)) := by
    funext i; cases i using Fin.cases <;> simp [vA]
  rw [hcomp]
  obtain ⟨e, rfl⟩ : ∃ e', e = e' + 1 := Nat.exists_eq_succ_of_ne_zero fun h0 => by
    rw [h0, pow_zero, mul_one] at he
    exact ht.not_isUnit ((isUnit_map_iff (algebraMap A B) t).mp (he ▸ a.isUnit))
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp
    (hvB ▸ Submodule.mem_top : D k B (a : B) ∈ Submodule.span B (Set.range vB))
  have hsm : s * c 0 ∈ maximalIdeal B :=
    Ideal.mul_mem_right _ _ ((mem_maximalIdeal s).mpr hs.not_isUnit)
  have hek : IsUnit ((e + 1 : ℕ) : B) := by
    have : ((e + 1 : ℕ) : B) = algebraMap k B ((e + 1 : ℕ) : k) := by simp
    rw [this]
    exact (isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero e))).map _
  have hw : IsUnit ((a : B) * ((e + 1 : ℕ) : B) + s * c 0) := by
    by_contra h
    have := (maximalIdeal B).sub_mem ((mem_maximalIdeal _).mpr h) hsm
    rw [add_sub_cancel_right, mem_maximalIdeal] at this
    exact this (a.isUnit.mul hek)
  refine ⟨hw.unit, ?_⟩
  rw [IsUnit.unit_spec, Nat.add_sub_cancel]
  apply ιMulti_cons_eq_smul
  rw [he, Derivation.leibniz, Derivation.leibniz_pow, ← hc, Fin.sum_univ_succ]
  have hv0 : vB 0 = D k B s := rfl
  have hvs : ∀ i, vB i.succ = D k B (algebraMap A B (u i)) := fun i => rfl
  simp only [hv0, hvs, Nat.add_sub_cancel]
  have : (a : B) • ((e + 1) • s ^ e • D k B s) +
      s ^ (e + 1) • (c 0 • D k B s + ∑ i : Fin r, c i.succ • D k B (algebraMap A B (u i))) -
      ((↑a * ((e + 1 : ℕ) : B) + s * c 0) * s ^ e) • D k B s =
      s ^ (e + 1) • ∑ i : Fin r, c i.succ • D k B (algebraMap A B (u i)) := by
    rw [← Nat.cast_smul_eq_nsmul B]
    module
  rw [this]
  exact Submodule.smul_mem _ _ (Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))

end Algebra

/-- Pulling a form back along `A → K → K'` agrees with pulling it back along `A → B → K'` when
the two composites `A → K'` agree. -/
private theorem topFormsMap_topFormsMap_eq {k A B K K' : Type*} [CommRing k] [CommRing A]
    [CommRing B] [Field K] [Field K'] [Algebra k A] [Algebra k B] [Algebra k K] [Algebra k K']
    [Algebra A B] [Algebra A K] [Algebra B K'] [Algebra K K'] [IsScalarTower k A B]
    [IsScalarTower k A K] [IsScalarTower k B K'] [IsScalarTower k K K']
    (hφ : ∀ x : A, algebraMap B K' (algebraMap A B x) = algebraMap K K' (algebraMap A K x))
    {n : ℕ} (σ : ⋀[A]^n Ω[A⁄k]) :
    topFormsMap k K K' n (topFormsMap k A K n σ) =
      topFormsMap k B K' n (topFormsMap k A B n σ) := by
  have hΩ : ∀ y : Ω[A⁄k], KaehlerDifferential.map k k K K' (KaehlerDifferential.map k k A K y) =
      KaehlerDifferential.map k k B K' (KaehlerDifferential.map k k A B y) := by
    intro y
    have hy : y ∈ Submodule.span A (Set.range (KaehlerDifferential.D k A)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hy using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      simp [hφ]
    | zero => simp
    | add x y _ _ hx hy => simp only [map_add, hx, hy]
    | smul a x _ hx =>
      have e1 : KaehlerDifferential.map k k A K (a • x) =
          algebraMap A K a • KaehlerDifferential.map k k A K x := by
        rw [map_smul, algebraMap_smul]
      have e2 : KaehlerDifferential.map k k A B (a • x) =
          algebraMap A B a • KaehlerDifferential.map k k A B x := by
        rw [map_smul, algebraMap_smul]
      rw [e1, e2, map_smul, map_smul, hx, ← algebraMap_smul K' (algebraMap A K a),
        ← algebraMap_smul K' (algebraMap A B a), hφ]
  have hs : σ ∈ Submodule.span A (Set.range (exteriorPower.ιMulti A n)) := by
    rw [exteriorPower.ιMulti_span]; trivial
  induction hs using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨v, rfl⟩ := hx
    simp only [topFormsMap_ιMulti, hΩ]
  | zero => simp
  | add x y _ _ hx hy => simp only [map_add, hx, hy]
  | smul a x _ hx =>
    have e1 : topFormsMap k A K n (a • x) = algebraMap A K a • topFormsMap k A K n x := by
      rw [map_smul, algebraMap_smul]
    have e2 : topFormsMap k A B n (a • x) = algebraMap A B a • topFormsMap k A B n x := by
      rw [map_smul, algebraMap_smul]
    rw [e1, e2, map_smul, map_smul, hx, ← algebraMap_smul K' (algebraMap A K a),
      ← algebraMap_smul K' (algebraMap A B a), hφ]

/-- The order along a prime divisor of `u ϖ^n`, for a unit `u` and a uniformizer `ϖ`, is `n`. -/
private theorem ord_algebraMap_unit_mul_pow {Y : Scheme.{0}} [IsIntegral Y] [IsLocallyNoetherian Y]
    [IsNormal Y] (E : PrimeDivisor Y) {ϖ : E.localRing} (hϖ : Irreducible ϖ)
    (w : E.localRingˣ) (n : ℕ) :
    Y.ord (algebraMap E.localRing Y.functionField (w * ϖ ^ n)) E.genericPoint = n := by
  have := E.isDiscreteValuationRing_localRing
  have hϖ0 : algebraMap E.localRing Y.functionField ϖ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hϖ.ne_zero
  have h1 : Y.ord (algebraMap E.localRing Y.functionField ϖ) E.genericPoint = 1 := by
    have := E.divisorialValuation_algebraMap_of_irreducible hϖ
    rw [E.divisorialValuation_eq_exp_neg_ord hϖ0] at this
    have := WithZero.exp_injective this
    omega
  have hw0 : algebraMap E.localRing Y.functionField w ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr w.ne_zero
  rw [map_mul, map_pow, Scheme.ord_mul hw0 (pow_ne_zero _ hϖ0),
    E.ord_algebraMap_of_isUnit w.isUnit, ← zpow_natCast, ord_zpow _ hϖ0, h1]
  ring

/-- If one valuation is the `e`-th power of another along a ring map, then `e ≠ 0`: at `0` the
relation reads `0 = 0 ^ e`. -/
private theorem ne_zero_of_valuation_eq_pow {K K' Γ : Type*} [Field K] [Field K']
    [LinearOrderedCommGroupWithZero Γ] {v : Valuation K Γ} {v' : Valuation K' Γ} {ι : K →+* K'}
    {e : ℕ} (he : ∀ g, v' (ι g) = v g ^ e) : e ≠ 0 := by
  rintro rfl
  simpa using he 0

/-- If `v_{E'}(x') = v_E(x) ^ e` for nonzero rational functions `x`, `x'`, then
`ord_{E'}(x') = e · ord_E(x)`. -/
private theorem ord_eq_mul_of_divisorialValuation_eq_pow {Y Y' : Scheme.{0}} [IsIntegral Y]
    [IsLocallyNoetherian Y] [IsNormal Y] [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y']
    (E : PrimeDivisor Y) (E' : PrimeDivisor Y') {x : Y.functionField} {x' : Y'.functionField}
    {e : ℕ} (h : E'.divisorialValuation x' = E.divisorialValuation x ^ e) (hx : x ≠ 0)
    (hx' : x' ≠ 0) : Y'.ord x' E'.genericPoint = e * Y.ord x E.genericPoint := by
  rw [E'.divisorialValuation_eq_exp_neg_ord hx', E.divisorialValuation_eq_exp_neg_ord hx,
    ← WithZero.exp_nsmul, WithZero.exp_inj, smul_neg, nsmul_eq_mul] at h
  linear_combination -h

section CanonicalDivisorExistence

open Opposite TopologicalSpace
open MMP.Fourfold (componentGenericPoint_eq_genericPoint)

open MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation (isDominant_opens_ι functionFieldMap_opens_ι_bijective
  restrictRF restrictRF_injective restrictRF_surjective isDivisorialSection_restrictRF_iff
  restrictRF_smul restrictRF_zero restrictRF_add)

variable {k : Type} [Field k] {X : Scheme.{0}} {sX : X ⟶ Spec (.of k)} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X]

/-- A nonempty open subscheme of a variety has the dimension of the variety: both are the
transcendence degree of the common function field. -/
private theorem topologicalKrullDim_opens_eq (hX : IsNormalVariety k sX) (U : X.Opens)
    [Nonempty U] [IsDominant U.ι] : topologicalKrullDim U = topologicalKrullDim X := by
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have hbij := functionFieldMap_opens_ι_bijective U
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (U.ι ≫ sX)
  rw [← toENat_trdeg_functionField (sX := U.ι ≫ sX),
    ← trdeg_functionField_eq_of_bijective sX U.ι hbij, toENat_trdeg_functionField (sX := sX)]

/-! ### The divisorial sheaf on an open subscheme -/

section DivisorialRestrict

variable (U : X.Opens) [Nonempty U] [IsDominant U.ι]

/-- The restriction `𝒪_X(D)|_U ⟶ 𝒪_U(D|_U)` of divisorial sections to an open subscheme. -/
private noncomputable def divisorialSheafRestrictHom (D : Divisor X) :
    D.divisorialSheaf.restrict U.ι ⟶ Divisor.divisorialSheaf (D.restrictOpen U) :=
  ⟨PresheafOfModules.homMk
    { app V := AddCommGrpCat.ofHom
        { toFun ψ := (⟨restrictRF U V.unop (ψ : D.divisorialSubmodule (U.ι ''ᵁ V.unop)).1,
            (isDivisorialSection_restrictRF_iff U D V.unop _).2
              (ψ : D.divisorialSubmodule (U.ι ''ᵁ V.unop)).2⟩ :
              Divisor.divisorialSubmodule (D.restrictOpen U) V.unop)
          map_zero' := Subtype.ext (restrictRF_zero U V.unop)
          map_add' ψ₁ ψ₂ := Subtype.ext (restrictRF_add U V.unop _ _) }
      naturality V V' i := by ext ψ; rfl }
    fun V r ψ => Subtype.ext (restrictRF_smul U V.unop r _)⟩

private theorem isIso_divisorialSheafRestrictHom (D : Divisor X) :
    IsIso (divisorialSheafRestrictHom U D) := by
  rw [Scheme.Modules.Hom.isIso_iff_isIso_app]
  intro V
  rw [ConcreteCategory.isIso_iff_bijective]
  refine ⟨fun (ψ₁ ψ₂ : D.divisorialSubmodule (U.ι ''ᵁ V)) h => ?_, fun φ => ?_⟩
  · have h' : restrictRF U V ψ₁.1 = restrictRF U V ψ₂.1 := congrArg Subtype.val h
    exact Subtype.ext (restrictRF_injective U V h')
  · obtain ⟨ψ, hψ⟩ :=
      restrictRF_surjective U V (φ : Divisor.divisorialSubmodule (D.restrictOpen U) V).1
    refine ⟨(⟨ψ, (isDivisorialSection_restrictRF_iff U D V ψ).1
      (hψ ▸ (φ : Divisor.divisorialSubmodule (D.restrictOpen U) V).2)⟩ :
        D.divisorialSubmodule (U.ι ''ᵁ V)), Subtype.ext hψ⟩

end DivisorialRestrict

/-- The divisorial sheaf of the restriction `D|_U` of a divisor to an open subscheme is the
restriction `𝒪_X(D)|_U` of its divisorial sheaf. -/
private theorem nonempty_divisorialSheaf_restrictOpen_iso (D : Divisor X) (U : X.Opens)
    [Nonempty U] [IsDominant U.ι] :
    Nonempty (Divisor.divisorialSheaf (D.restrictOpen U) ≅ D.divisorialSheaf.restrict U.ι) :=
  ⟨(@asIso _ _ _ _ _ (isIso_divisorialSheafRestrictHom U D)).symm⟩

/-- Relative differential forms restrict along an open immersion: for `ψ : Z ⟶ Y` an open
immersion and `p' = ψ ≫ p`, `(Ω^n_{Y/S})|_Z ≅ Ω^n_{Z/S}`. -/
private theorem nonempty_restrict_relativeDifferentialForms_iso {Y Z S : Scheme.{0}}
    (ψ : Z ⟶ Y) [IsOpenImmersion ψ] (p : Y ⟶ S) (p' : Z ⟶ S) (h : ψ ≫ p = p') (n : ℤ) :
    Nonempty ((Scheme.Hom.relativeDifferentialForms p n).restrict ψ ≅
      Scheme.Hom.relativeDifferentialForms p' n) := by
  have hc : ψ ≫ p = p' ≫ 𝟙 S := by rw [h, Category.comp_id]
  have := Scheme.Hom.isIso_relativeDifferentialFormsMap_of_etale ψ p p' (𝟙 S) hc n
  exact ⟨(Scheme.Modules.restrictFunctorIsoPullback ψ).app _ ≪≫
    asIso (Scheme.Hom.relativeDifferentialFormsMap ψ p p' (𝟙 S) hc n)⟩

/-- **A normal variety over a perfect field has a canonical divisor.** On the smooth locus
`T = S_sm`, which contains the generic point, the canonical sheaf is `𝒪_T(K_T)` for a divisor
`K_T` of `T`; its closure `K_S` in `S` restricts to `K_T` on `T`, so
`𝒪_S(K_S)|_T ≅ 𝒪_T(K_T) ≅ ω_T`. -/
private theorem exists_isCanonicalDivisor {K : Type} [Field K] [PerfectField K]
    {S : Scheme.{0}} (sS : S ⟶ Spec (.of K)) [IsIntegral S] [IsLocallyNoetherian S] [IsNormal S]
    [CompactSpace S] (hS : IsNormalVariety K sS) {n : ℕ} (hn : topologicalKrullDim S = n) :
    ∃ KS : MMP.Mori.Divisor S, KS.IsCanonicalDivisor sS n := by
  haveI : LocallyOfFiniteType sS := hS.1.toLocallyOfFiniteType
  set T := MMP.Mori.smoothLocus sS with hT
  have hTeq : T = sS.smoothLocus := MMP.Mori.smoothLocus_eq_smoothLocus sS
  haveI : Nonempty T := ⟨⟨genericPoint S, hTeq ▸ sS.genericPoint_mem_smoothLocus_of_perfectField⟩⟩
  haveI : IsDominant T.ι := isDominant_opens_ι T
  have hTv : IsNormalVariety K (T.ι ≫ sS) := isNormalVariety_ι hS T
  haveI : MMP.Mori.IsVariety K (T.ι ≫ sS) := hTv.1
  haveI : IsIntegral T := inferInstance
  haveI : QuasiCompact (T.ι ≫ sS) := hTv.1.toQuasiCompact
  haveI : CompactSpace T := QuasiCompact.compactSpace_of_compactSpace (T.ι ≫ sS)
  have hsm : MMP.Mori.IsSmoothScheme (T.ι ≫ sS) := by
    rw [MMP.Mori.isSmoothScheme_iff, ← Scheme.Hom.smoothLocus_eq_top_iff,
      ← Scheme.Hom.preimage_smoothLocus_eq, ← hTeq, Scheme.Opens.ι_preimage_self]
  have hdimT : topologicalKrullDim T = n :=
    (topologicalKrullDim_opens_eq hS T).trans hn
  obtain ⟨KT, hKT⟩ := MMP.Mori.exists_isCanonicalDivisor_of_isSmoothScheme (T.ι ≫ sS) hsm hdimT
  classical
  let KS : MMP.Mori.Divisor S := Finsupp.mapDomain (OpenWeilRestriction.primeDivisorMap T.ι) KT
  have hKS : KS.restrictOpen T = KT := by
    ext W
    rw [MMP.Mori.DivisorWithCoeffs.coeff_restrictOpen]
    exact Finsupp.mapDomain_apply_of_injective (OpenWeilRestriction.primeDivisorMap_injective T.ι) KT W
  obtain ⟨e₀⟩ := nonempty_divisorialSheaf_restrictOpen_iso KS T
  set T' := MMP.Mori.smoothLocus (T.ι ≫ sS)
  obtain ⟨e₁⟩ := nonempty_restrict_relativeDifferentialForms_iso T'.ι
    (T.ι ≫ sS) (T'.ι ≫ T.ι ≫ sS) rfl n
  obtain ⟨e₂⟩ := MMP.Flips.nonempty_iso_of_restrict_iso (M := KT.divisorialSheaf)
    (N := Scheme.Hom.relativeDifferentialForms (T.ι ≫ sS) n) hsm (hKT.iso ≪≫ e₁.symm)
  refine ⟨KS, hn, ⟨e₀.symm ≪≫ ?_ ≪≫ e₂⟩⟩
  rw [hKS]

end CanonicalDivisorExistence

/-! ### Function fields and forms -/

section Forms

/-- A finite dominant morphism of integral schemes induces a finite extension of function
fields. -/
private theorem finite_functionField {X Y : Scheme.{0}} [IsIntegral X] [IsIntegral Y] (h : Y ⟶ X)
    [IsFinite h] [IsDominant h] :
    letI := functionFieldMapAlgebra h
    Module.Finite X.functionField Y.functionField := by
  have := MMP.moduleFinite_functionField_of_isFinite h
  convert this using 3
  exact congrArg RingHom.toAlgebra (dominantFunctionFieldMap_eq_functionFieldMap h).symm

/-- The pull-back of a nonzero form along a pull-back generator is nonzero. -/
private theorem pullbackForms_ne_zero {k K K' : Type*} [CommRing k] [Field K] [Field K']
    [Algebra k K] [Algebra k K'] [Algebra K K'] [IsScalarTower k K K'] {d : ℕ}
    {ω : ⋀[K]^d Ω[K⁄k]} (hω : IsPullbackGenerator K' ω) {m : ℤ} {τ : PluriForms k K d m}
    (hτ : τ ≠ 0) : pullbackForms (K' := K') m τ ≠ 0 := by
  intro h0
  have h1 := repr_pullbackFormsAlong hω m τ
  rw [← pullbackForms_eq hω m τ, h0] at h1
  simp only [map_zero, Finsupp.zero_apply] at h1
  exact repr_ne_zero_of_ne_zero _ hτ ((map_eq_zero_iff _ (algebraMap K K').injective).mp h1.symm)

/-- The pull-back `ι^*τ` of rational `m`-canonical forms along a `k`-embedding
`ι : k(Y) → k(Y')` of function fields. -/
private noncomputable def pullbackAlong {k : Type} [Field k] {Y Y' : Scheme.{0}}
    (sY : Y ⟶ Spec (.of k)) (sY' : Y' ⟶ Spec (.of k)) [IsIntegral Y] [IsIntegral Y']
    (ι : Y.functionField →+* Y'.functionField)
    (hι : letI := functionFieldAlgebra sY; letI := functionFieldAlgebra sY'
      ∀ c : k, algebraMap k Y'.functionField c = ι (algebraMap k Y.functionField c))
    {d : ℕ} {m : ℤ} (τ : RationalPluriForms sY d m) : RationalPluriForms sY' d m :=
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra sY'
  letI := ι.toAlgebra
  haveI : IsScalarTower k Y.functionField Y'.functionField := IsScalarTower.of_algebraMap_eq hι
  pullbackForms (K := Y.functionField) (K' := Y'.functionField) m τ

/-- **The tame canonical-order formula along an extension of discrete valuations.** Let `Y`,
`Y'` be normal varieties of dimension `n` over a field `k` of characteristic zero, `ι` a
`k`-embedding `k(Y) → k(Y')` of their function fields, and `E`, `E'` prime divisors with
`v_{E'} ∘ ι = v_E ^ e`. Then every nonzero rational `m`-canonical form `τ` of `Y` satisfies
`ord_{E'}(ι^* τ) = e · ord_E(τ) + m (e - 1)`. -/
private theorem ordForm_pullbackForms_eq {k : Type} [Field k] [CharZero k]
    {Y Y' : Scheme.{0}} (sY : Y ⟶ Spec (.of k)) (sY' : Y' ⟶ Spec (.of k))
    [IsIntegral Y] [IsIntegral Y'] [IsLocallyNoetherian Y] [IsLocallyNoetherian Y']
    [IsNormal Y] [IsNormal Y'] (hY : IsNormalVariety k sY) (hY' : IsNormalVariety k sY')
    {n : ℕ} (hd : letI := functionFieldAlgebra sY; (Algebra.trdeg k Y.functionField).toNat = n)
    (hd' : letI := functionFieldAlgebra sY'; (Algebra.trdeg k Y'.functionField).toNat = n)
    (htr : letI := functionFieldAlgebra sY; letI := functionFieldAlgebra sY'
      Algebra.trdeg k Y.functionField = Algebra.trdeg k Y'.functionField)
    (ι : Y.functionField →+* Y'.functionField)
    (hι : letI := functionFieldAlgebra sY; letI := functionFieldAlgebra sY'
      ∀ c : k, algebraMap k Y'.functionField c = ι (algebraMap k Y.functionField c))
    (E : PrimeDivisor Y) (E' : PrimeDivisor Y') {e : ℕ}
    (he : ∀ g, E'.divisorialValuation (ι g) = E.divisorialValuation g ^ e)
    {m : ℤ} {τ : RationalPluriForms sY n m} (hτ : τ ≠ 0) :
    E'.ordForm (pullbackAlong sY sY' ι hι τ) = e * E.ordForm τ + m * (e - 1) := by
  classical
  letI := functionFieldAlgebra sY
  letI := functionFieldAlgebra sY'
  letI := ι.toAlgebra
  haveI : IsScalarTower k Y.functionField Y'.functionField := IsScalarTower.of_algebraMap_eq hι
  haveI : LocallyOfFiniteType sY := hY.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType sY' := hY'.1.toLocallyOfFiniteType
  haveI := essFiniteType_functionField (sX := sY)
  haveI : Algebra.IsAlgebraic Y.functionField Y'.functionField := isAlgebraic_of_trdeg_eq k htr
  letI := stalkAlgebra sY E.genericPoint
  letI := stalkAlgebra sY' E'.genericPoint
  haveI := isScalarTower_stalk_functionField sY E.genericPoint
  haveI := isScalarTower_stalk_functionField sY' E'.genericPoint
  haveI := E.isDiscreteValuationRing_localRing
  haveI := E'.isDiscreteValuationRing_localRing
  obtain ⟨_, _⟩ := E.formallySmooth_localRing (sX := sY)
  obtain ⟨_, _⟩ := E.free_kaehlerDifferential_localRing (sX := sY)
  obtain ⟨_, _⟩ := E'.free_kaehlerDifferential_localRing (sX := sY')
  have hrkA := (E.finrank_kaehlerDifferential_localRing (sX := sY)).trans hd
  have hrkB := (E'.finrank_kaehlerDifferential_localRing (sX := sY')).trans hd'
  have he0 : e ≠ 0 := ne_zero_of_valuation_eq_pow he
  have hord : ∀ g : Y.functionField, g ≠ 0 →
      Y'.ord (algebraMap Y.functionField Y'.functionField g) E'.genericPoint =
        e * Y.ord g E.genericPoint := fun g hg =>
    ord_eq_mul_of_divisorialValuation_eq_pow E E' (he g) hg ((map_ne_zero _).mpr hg)
  -- the local extension `𝒪_{Y,E} → 𝒪_{Y',E'}`
  obtain ⟨φ, hφ⟩ := exists_ringHom_of_range (A₁ := E.localRing) (A₂ := E'.localRing)
    (algebraMap Y.functionField Y'.functionField) fun a => by
      have h1 : E.divisorialValuation (algebraMap E.localRing Y.functionField a) ≤ 1 :=
        (E.divisorialValuation_le_one_iff _).mpr ⟨a, rfl⟩
      have h2 : E'.divisorialValuation (algebraMap Y.functionField Y'.functionField
          (algebraMap E.localRing Y.functionField a)) ≤ 1 := by
        change E'.divisorialValuation (ι _) ≤ 1
        rw [he]
        exact (pow_le_one_iff he0).mpr h1
      obtain ⟨b, hb⟩ := (E'.divisorialValuation_le_one_iff _).mp h2
      exact ⟨b, hb⟩
  letI : Algebra E.localRing E'.localRing := φ.toAlgebra
  have hφ' : ∀ x : E.localRing, algebraMap E'.localRing Y'.functionField
      (algebraMap E.localRing E'.localRing x) =
        algebraMap Y.functionField Y'.functionField (algebraMap E.localRing Y.functionField x) :=
    hφ
  haveI : IsScalarTower k E.localRing E'.localRing := by
    refine IsScalarTower.of_algebraMap_eq fun c =>
      IsFractionRing.injective E'.localRing Y'.functionField ?_
    rw [hφ', ← IsScalarTower.algebraMap_apply k E.localRing Y.functionField,
      ← IsScalarTower.algebraMap_apply k Y.functionField Y'.functionField,
      ← IsScalarTower.algebraMap_apply k E'.localRing Y'.functionField]
  haveI : IsLocalHom (algebraMap E.localRing E'.localRing) := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have h1 : E.divisorialValuation (algebraMap E.localRing Y.functionField a) < 1 :=
      (E.divisorialValuation_algebraMap_lt_one_iff a).mpr
        ((IsLocalRing.mem_maximalIdeal a).mpr hna)
    have h2 : E'.divisorialValuation (algebraMap E'.localRing Y'.functionField
        (algebraMap E.localRing E'.localRing a)) < 1 := by
      rw [hφ']
      change E'.divisorialValuation (ι _) < 1
      rw [he]
      exact (pow_lt_one_iff he0).mpr h1
    exact (IsLocalRing.mem_maximalIdeal _).mp
      ((E'.divisorialValuation_algebraMap_lt_one_iff _).mp h2) ha
  haveI : Algebra.FormallySmooth k (IsLocalRing.ResidueField E.localRing) := by
    haveI : Algebra.EssFiniteType k (IsLocalRing.ResidueField E.localRing) :=
      Algebra.EssFiniteType.comp k E.localRing _
    exact Algebra.FormallySmooth.of_perfectField
  haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField E.localRing)
      (IsLocalRing.ResidueField E'.localRing) :=
    isAlgebraic_residueField_of_isAlgebraic (K := Y.functionField) (L := Y'.functionField)
      (IsFractionRing.injective _ _) hφ'
  haveI : CharZero (IsLocalRing.ResidueField E.localRing) :=
    charZero_of_injective_algebraMap (algebraMap k _).injective
  haveI : Algebra.IsSeparable (IsLocalRing.ResidueField E.localRing)
      (IsLocalRing.ResidueField E'.localRing) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  -- uniformizers and the ramification index
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  obtain ⟨s, hs⟩ := IsDiscreteValuationRing.exists_irreducible E'.localRing
  have hϖ1 : Y.ord (algebraMap E.localRing Y.functionField ϖ) E.genericPoint = 1 := by
    simpa using ord_algebraMap_unit_mul_pow E hϖ 1 1
  have hϖ0 : algebraMap E.localRing Y.functionField ϖ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr hϖ.ne_zero
  have hφϖ : algebraMap E.localRing E'.localRing ϖ ≠ 0 := by
    intro h0
    have := hφ' ϖ
    rw [h0, map_zero, eq_comm, map_eq_zero_iff _ (RingHom.injective _)] at this
    exact hϖ0 this
  obtain ⟨e₀, a, ha⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hφϖ hs
  have he₀ : e₀ = e := by
    have h1 := hord _ hϖ0
    rw [← hφ', ha, ord_algebraMap_unit_mul_pow E' hs, hϖ1, mul_one] at h1
    exact_mod_cast h1
  -- the top forms
  obtain ⟨σA, hσA, σB, hσB, w, hw⟩ :=
    exists_topFormsMap_eq_unit_mul_pow_smul (k := k) hrkA hrkB hϖ hs ha
  have h0A := E.topFormsMap_ne_zero (sX := sY) hd hσA
  have h0B := E'.topFormsMap_ne_zero (sX := sY') hd' hσB
  rw [E.ordForm_eq τ hσA h0A, E'.ordForm_eq _ hσB h0B]
  set c : Y'.functionField := algebraMap E'.localRing Y'.functionField (w * s ^ (e₀ - 1))
    with hc_def
  have hc : c ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr
      (mul_ne_zero w.ne_zero (pow_ne_zero _ hs.ne_zero))
  have hcomp : topFormsMap k Y.functionField Y'.functionField n
      (topFormsMap k E.localRing Y.functionField n σA) =
      c • topFormsMap k E'.localRing Y'.functionField n σB := by
    rw [topFormsMap_topFormsMap_eq hφ', hw, map_smul, algebraMap_smul]
  have hωA : IsPullbackGenerator Y'.functionField
      (topFormsMap k E.localRing Y.functionField n σA) :=
    ⟨span_singleton_topFormsMap (nonZeroDivisors _) hσA, by
      rw [hcomp, Submodule.span_singleton_smul_eq (IsUnit.mk0 c hc),
        span_singleton_topFormsMap (nonZeroDivisors _) hσB], by
      rw [hcomp]; exact smul_ne_zero hc h0B⟩
  have hpb : pullbackAlong sY sY' ι hι τ = pullbackFormsAlong hωA m τ := pullbackForms_eq hωA m τ
  rw [hpb]
  have hb : basisOfSpanSingleton hωA.2.1 hωA.2.2 () =
      c • topFormsBasis E'.localRing hσB h0B () := by
    simp [hcomp]
  have key := ZTensorPower.basis_repr_of_eq_smul hb m (pullbackFormsAlong hωA m τ)
  have hr := repr_pullbackFormsAlong hωA m τ
  have hfB : formCoeff E'.localRing hσB h0B (pullbackFormsAlong hωA m τ) =
      c ^ m * algebraMap Y.functionField Y'.functionField
        (formCoeff E.localRing hσA h0A τ) := by
    have h1 : formCoeff E'.localRing hσB h0B (pullbackFormsAlong hωA m τ) =
        c ^ m * (ZTensorPower.basis (basisOfSpanSingleton hωA.2.1 hωA.2.2) m).repr
          (pullbackFormsAlong hωA m τ) () := by
      unfold formCoeff
      rw [key, ← mul_assoc, mul_inv_cancel₀ (zpow_ne_zero m hc), one_mul]
    rw [h1, hr]
    rfl
  have hf : formCoeff E.localRing hσA h0A τ ≠ 0 := fun h0 =>
    hτ ((formCoeff_eq_zero_iff hσA h0A _).mp h0)
  rw [hfB, Scheme.ord_mul (zpow_ne_zero _ hc) ((map_ne_zero _).mpr hf), MMP.Mori.ord_zpow _ hc,
    hord _ hf, hc_def, ord_algebraMap_unit_mul_pow E' hs, he₀,
    Nat.cast_sub (Nat.one_le_iff_ne_zero.mpr he0)]
  push_cast
  ring

end Forms

/-! ### Centres and pull-backs of Cartier divisors -/

section Centre

/-- **The centre upstairs lies over the centre downstairs.** If `D'` is a divisor over `Y` and
`D` one over a variety `X`, with `v_{D'} ∘ h^* = v_D ^ e` for `e ≠ 0`, then `h` maps the centre
of `D'` on `Y` to the centre of `D` on `X`: the local ring of `X` at `h(c_Y(v_{D'}))` is dominated
by `v_D`, and centres are unique on a separated scheme. -/
private theorem map_center_eq_of_valuation_eq_pow {k : Type} [Field k] {X Y : Scheme.{0}}
    {sX : X ⟶ Spec (.of k)} (h : Y ⟶ X) [IsIntegral X] [IsIntegral Y] [IsDominant h]
    (hX : MMP.Mori.IsVariety k sX) {D : DivisorOver k sX} {D' : DivisorOver k (h ≫ sX)}
    {e : ℕ} (he0 : e ≠ 0)
    (he : ∀ g, D'.valuation (functionFieldMap h g) = D.valuation g ^ e) :
    h (D'.f D'.E.genericPoint) = D.f D.E.genericPoint := by
  haveI := hX.toIsSeparated
  refine (MMP.Positivity.DivisorOver.eq_of_dominates sX D.valuation (x := D.f D.E.genericPoint)
    (x' := h (D'.f D'.E.genericPoint))
    (MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D _ rfl)
    (MMP.Positivity.DivisorOver.valuation_algebraMap_lt_one D _ rfl) (fun a => ?_)
    (fun a ha => ?_)).symm
  · have h1 := MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D' _ rfl
      ((h.stalkMap (D'.f D'.E.genericPoint)).hom a)
    rw [← functionFieldMap_algebraMap_stalk, he] at h1
    exact (pow_le_one_iff he0).mp h1
  · have hmem : (h.stalkMap (D'.f D'.E.genericPoint)).hom a ∈ IsLocalRing.maximalIdeal _ :=
      (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
        (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit _ _ hu)
    have h1 := MMP.Positivity.DivisorOver.valuation_algebraMap_lt_one D' _ rfl _ hmem
    rw [← functionFieldMap_algebraMap_stalk, he] at h1
    exact (pow_lt_one_iff he0).mp h1

/-- **The coefficient of an iterated pull-back.** Let `C` be a Cartier divisor on `X`, `C₁` its
pull-back along `h : Y ⟶ X` and `C₂` the pull-back of `C₁` along `f : Y' ⟶ Y`. If `φ` is a local
equation of `C` on an open `U` containing `h(f(η_E))`, then `coeff_E(C₂) = v_E(f^* h^* φ)`: a
local equation of `C₁` near `f(η_E)` and `h^* φ` have the same order along every prime divisor
through `f(η_E)`, so by algebraic Hartogs their pull-backs have the same order along `E`. -/
private theorem coeff_isPullback_isPullback_eq {X Y Y' : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y'] [IsNormal Y'] {h : Y ⟶ X} [IsDominant h]
    {f : Y' ⟶ Y} [IsDominant f] {C : Divisor X} (hCc : C.IsCartier)
    {hB : ∀ Z : irreducibleComponents Y, h (componentGenericPoint Y Z) ∉ C.supp}
    {C₁ : Divisor Y} (h₁ : C.IsPullback h hB C₁)
    {hB₁ : ∀ Z : irreducibleComponents Y', f (componentGenericPoint Y' Z) ∉ C₁.supp}
    {C₂ : Divisor Y'} (h₂ : C₁.IsPullback f hB₁ C₂) {U : X.Opens}
    {φ : (RationalFunctions X)ˣ} (hφ : C.IsLocalEquation U φ) (E : PrimeDivisor Y')
    (hU : h (f E.genericPoint) ∈ U) (Z : irreducibleComponents X) :
    C₂.coeff E = Y'.ord (functionFieldMap f (functionFieldMap h
      (MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X)))) E.genericPoint := by
  classical
  obtain ⟨W, hW, ψ, hψ⟩ := (h₁.isCartier hCc) (f E.genericPoint)
  let Z₁ := pointComponent (f E.genericPoint)
  rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h₂ hψ E hW Z₁]
  set g₁ := MMP.Threefold.Mori.Helpers.evalFF Z₁ (ψ : RationalFunctions Y) with hg₁_def
  set g := functionFieldMap h (MMP.Threefold.Mori.Helpers.evalFF Z (φ : RationalFunctions X))
    with hg_def
  have hg₁ : g₁ ≠ 0 := (ψ.isUnit.map _).ne_zero
  have hg : g ≠ 0 := (map_ne_zero _).mpr (φ.isUnit.map _).ne_zero
  have key := MMP.Threefold.Bridges.sum_ord_functionFieldMap_eq_zero (f := f) E ![g₁, g]
    (by intro j; fin_cases j; exacts [hg₁, hg]) ![1, -1] fun Γ hΓ => by
      have hZ : Γ.component = Z₁ := Subsingleton.elim
        (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := Y)) _ _
      have e1 : Y.ord g₁ Γ.genericPoint = C₁.coeff Γ := by
        rw [hψ Γ ⟨_, hΓ, hW⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hZ]
      have hΓU : h Γ.genericPoint ∈ U :=
        (Γ.genericPoint_mem_iff (h ⁻¹ᵁ U)).mpr ⟨f E.genericPoint, hΓ, hU⟩
      have e2 : Y.ord g Γ.genericPoint = C₁.coeff Γ :=
        (MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF h₁ hφ Γ hΓU Z).symm
      simp [Fin.sum_univ_two, e1, e2]
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    mul_one, mul_neg] at key
  have : ((Y'.ord (functionFieldMap f g₁) E.genericPoint : ℤ) : ℝ) =
      (Y'.ord (functionFieldMap f g) E.genericPoint : ℝ) := by linarith
  exact_mod_cast this

end Centre

/-! ### Finite pull-back of divisors over `X` -/

section FinitePullback

/-- A finite dominant morphism of integral `k`-schemes preserves the transcendence degree of the
function field, since `k(Y)` is finite over `k(X)`. -/
private theorem trdeg_functionField_eq_of_isFinite {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (h : Y ⟶ X) [IsIntegral X] [IsIntegral Y] [IsFinite h]
    [IsDominant h] :
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra (h ≫ sX)
    Algebra.trdeg k X.functionField = Algebra.trdeg k Y.functionField := by
  letI := functionFieldAlgebra sX
  letI := functionFieldAlgebra (h ≫ sX)
  letI := functionFieldMapAlgebra h
  haveI := isScalarTower_functionFieldMap sX h
  haveI := finite_functionField h
  haveI : Algebra.IsAlgebraic X.functionField Y.functionField := Algebra.IsAlgebraic.of_finite _ _
  have h1 := trdeg_add_eq k X.functionField (A := Y.functionField)
  rwa [(trdeg_eq_zero_iff (R := X.functionField) (A := Y.functionField)).mpr inferInstance,
    add_zero] at h1

/-- A finite dominant morphism of integral schemes of finite type over a field preserves the
dimension. -/
private theorem topologicalKrullDim_eq_of_isFinite {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (h : Y ⟶ X) [IsIntegral X] [IsIntegral Y] [IsFinite h]
    [IsDominant h] [LocallyOfFiniteType sX] [LocallyOfFiniteType (h ≫ sX)] :
    topologicalKrullDim Y = topologicalKrullDim X := by
  rw [← toENat_trdeg_functionField (sX := h ≫ sX), ← trdeg_functionField_eq_of_isFinite sX h,
    toENat_trdeg_functionField (sX := sX)]

/-- **The tame formula for divisors over a finite cover.** Let `h : Y ⟶ X` be a finite dominant
morphism of normal varieties of dimension `n` over a field of characteristic zero, `D` a divisor
over `X` and `D'` a divisor over `Y` with `v_{D'} ∘ h^* = v_D ^ e`. Then every nonzero rational
top form `ω` of `X` satisfies `ord_{D'}(h^* ω) = e · ord_D(ω) + (e - 1)`: the two composites
`k(X) → k(D'.Y)`, through `k(Y)` and through `k(D.Y)`, pull `ω` back to the same form, and
`ordForm_pullbackForms_eq` computes the second. -/
private theorem ordPullback_pullbackRationalPluriForms_eq {k : Type} [Field k] [CharZero k]
    {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of k)} {h : Y ⟶ X} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsFinite h] [IsDominant h] (hX : IsNormalVariety k sX) (hY : IsNormalVariety k (h ≫ sX))
    {n : ℕ} (hn : topologicalKrullDim X = n) {D : DivisorOver k sX}
    {D' : DivisorOver k (h ≫ sX)} {e : ℕ}
    (he : ∀ g, D'.valuation (functionFieldMap h g) = D.valuation g ^ e)
    {ω : RationalPluriForms sX n 1} (hω : ω ≠ 0) :
    D'.ordPullback (pullbackRationalPluriForms sX h ω) = e * D.ordPullback ω + (e - 1) := by
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have := D'.isIntegral
  have := D'.isLocallyNoetherian
  have := D'.isNormal
  have := D'.isDominant
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (h ≫ sX) := hY.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (D.f ≫ sX) := D.isNormalVariety.1.toLocallyOfFiniteType
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (h ≫ sX)
  let := functionFieldMapAlgebra h
  have := isScalarTower_functionFieldMap sX h
  have htrXY := trdeg_functionField_eq_of_isFinite sX h
  have hdimY : topologicalKrullDim Y = n := (topologicalKrullDim_eq_of_isFinite sX h).trans hn
  have hdX : (Algebra.trdeg k X.functionField).toNat = n :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hn
  have hdY : (Algebra.trdeg k Y.functionField).toNat = n :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hdimY
  obtain ⟨ωg, hωg⟩ := exists_isPullbackGenerator_of_topologicalKrullDim_eq sX h hn hdimY
  have he0 : e ≠ 0 := ne_zero_of_valuation_eq_pow he
  let := functionFieldAlgebra (D.f ≫ sX)
  let := functionFieldAlgebra (D'.f ≫ h ≫ sX)
  let := functionFieldMapAlgebra D.f
  let := functionFieldMapAlgebra D'.f
  have := isScalarTower_functionFieldMap sX D.f
  have := isScalarTower_functionFieldMap (h ≫ sX) D'.f
  have hb1 := D.isBirationalMorphism.functionFieldMap_bijective
  have hb2 := D'.isBirationalMorphism.functionFieldMap_bijective
  let eD := RingEquiv.ofBijective (functionFieldMap D.f) hb1
  let ι : D.Y.functionField →+* D'.Y.functionField :=
    (functionFieldMap D'.f).comp ((functionFieldMap h).comp eD.symm.toRingHom)
  have hι1 : ∀ g, ι (functionFieldMap D.f g) = functionFieldMap D'.f (functionFieldMap h g) :=
    fun g => by
      simp only [ι, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      congr 2
      exact eD.symm_apply_apply g
  have hkY' : ∀ c : k, algebraMap k D'.Y.functionField c =
      functionFieldMap D'.f (functionFieldMap h (algebraMap k X.functionField c)) := fun c =>
    (IsScalarTower.algebraMap_apply k Y.functionField D'.Y.functionField c).trans
      (congrArg (functionFieldMap D'.f)
        (IsScalarTower.algebraMap_apply k X.functionField Y.functionField c))
  have hι0 : ∀ c : k, algebraMap k D'.Y.functionField c =
      ι (algebraMap k D.Y.functionField c) := fun c => by
    rw [hkY', show algebraMap k D.Y.functionField c =
        functionFieldMap D.f (algebraMap k X.functionField c) from
      IsScalarTower.algebraMap_apply k X.functionField D.Y.functionField c, hι1]
  have htr' : Algebra.trdeg k D.Y.functionField = Algebra.trdeg k D'.Y.functionField := by
    rw [← trdeg_functionField_eq_of_bijective sX D.f hb1, htrXY,
      trdeg_functionField_eq_of_bijective (h ≫ sX) D'.f hb2]
  have hdX' : (Algebra.trdeg k D.Y.functionField).toNat = n := by
    rw [← trdeg_functionField_eq_of_bijective sX D.f hb1]; exact hdX
  have hdY' : (Algebra.trdeg k D'.Y.functionField).toNat = n := by
    rw [← htr']; exact hdX'
  have hval : ∀ g, D'.E.divisorialValuation (ι g) = D.E.divisorialValuation g ^ e := by
    intro g
    obtain ⟨g₀, rfl⟩ := hb1.2 g
    rw [hι1]
    exact he g₀
  -- the two factorizations of `k(X) → k(D'.Y)`
  letI := ι.toAlgebra
  haveI : IsScalarTower k D.Y.functionField D'.Y.functionField :=
    IsScalarTower.of_algebraMap_eq hι0
  letI : Algebra X.functionField D'.Y.functionField :=
    ((functionFieldMap D'.f).comp (functionFieldMap h)).toAlgebra
  haveI : IsScalarTower X.functionField Y.functionField D'.Y.functionField :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower X.functionField D.Y.functionField D'.Y.functionField :=
    IsScalarTower.of_algebraMap_eq fun g => (hι1 g).symm
  haveI : IsScalarTower k X.functionField D'.Y.functionField :=
    IsScalarTower.of_algebraMap_eq hkY'
  have := essFiniteType_functionField (sX := D.f ≫ sX)
  obtain ⟨ω₂, hω₂⟩ := exists_isPullbackGenerator_of_bijective (h ≫ sX) D'.f hb2 hdY
  obtain ⟨ω₃, hω₃⟩ := exists_isPullbackGenerator_of_bijective sX D.f hb1 hdX
  obtain ⟨ω₄, hω₄⟩ := exists_isPullbackGenerator (k := k) (K := D.Y.functionField)
    (K' := D'.Y.functionField) htr' hdX'
  have hg1 : IsPullbackGenerator D'.Y.functionField
      (topFormsMap k X.functionField Y.functionField n ωg) :=
    MMP.Threefold.Mori.Helpers.IsPullbackGenerator.of_span hω₂ hωg.2.1 hωg.2.2
  have hg2 : IsPullbackGenerator D.Y.functionField ωg :=
    MMP.Threefold.Mori.Helpers.IsPullbackGenerator.of_span hω₃ hωg.1 hωg.ne_zero
  have hg3 : IsPullbackGenerator D'.Y.functionField
      (topFormsMap k X.functionField D.Y.functionField n ωg) :=
    MMP.Threefold.Mori.Helpers.IsPullbackGenerator.of_span hω₄ hg2.2.1 hg2.2.2
  have c1 := MMP.Threefold.Mori.Helpers.pullbackForms_comp (K := X.functionField)
    (K' := Y.functionField) (K'' := D'.Y.functionField) (m := 1) hωg hg1 ω
  have c2 := MMP.Threefold.Mori.Helpers.pullbackForms_comp (K := X.functionField)
    (K' := D.Y.functionField) (K'' := D'.Y.functionField) (m := 1) hg2 hg3 ω
  have hforms : pullbackRationalPluriForms (h ≫ sX) D'.f (pullbackRationalPluriForms sX h ω) =
      pullbackAlong (D.f ≫ sX) (D'.f ≫ h ≫ sX) ι hι0 (pullbackRationalPluriForms sX D.f ω) :=
    c1.trans c2.symm
  have hτ : pullbackRationalPluriForms sX D.f ω ≠ 0 := pullbackForms_ne_zero hg2 hω
  have key := ordForm_pullbackForms_eq (D.f ≫ sX) (D'.f ≫ h ≫ sX) D.isNormalVariety
    D'.isNormalVariety hdX' hdY' htr' ι hι0 D.E D'.E hval hτ
  have hP : D'.ordPullback (pullbackRationalPluriForms sX h ω) =
      D'.E.ordForm (pullbackAlong (D.f ≫ sX) (D'.f ≫ h ≫ sX) ι hι0
        (pullbackRationalPluriForms sX D.f ω)) :=
    congrArg D'.E.ordForm hforms
  rw [hP, key, one_mul]
  rfl

/-- The coefficients of an integral divisor `M` with `M = m (K + B)` as `ℚ`-divisors. -/
private theorem coeff_eq_of_toQDivisor_eq_smul {X : Scheme.{0}} {M K : Divisor X}
    {B : QDivisor X} {m : ℕ} (hM : Divisor.toQDivisor M = (m : ℤ) • (Divisor.toQDivisor K + B))
    (Γ : PrimeDivisor X) : (M.coeff Γ : ℝ) = m * ((K.coeff Γ : ℝ) + (B.coeff Γ : ℝ)) := by
  have h1 := congrArg (fun G : QDivisor X => G.coeff Γ) hM
  simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, DivisorWithCoeffs.coeff_add,
    zsmul_eq_mul, Int.cast_natCast] at h1
  exact_mod_cast h1

/-- Pulling a scalar out of a weighted sum. -/
private theorem sum_mul_mul_eq_mul_sum {ι : Type*} [Fintype ι] (x r : ι → ℝ) (c : ℝ) :
    ∑ i, x i * (c * r i) = c * ∑ i, r i * x i := by
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

end FinitePullback

/-- **Finite log pull-back multiplies divisorial log discrepancies** (Kollár–Mori 5.20). -/
private theorem isLogDiscrepancy_mul_of_isFinite : ∀ {k : Type} [Field k] [CharZero k]
    {X Y : Scheme.{0}} (sX : X ⟶ Spec (.of k)) (h : Y ⟶ X)
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y]
    [IsFinite h] [Surjective h]
    (hY : MMP.Mori.IsNormalVariety k (h ≫ sX)) {n : ℕ}
    {ω : MMP.Mori.RationalPluriForms sX n 1} (hω : ω ≠ 0)
    {KX : Divisor X} (hKX : ∀ Γ, KX.coeff Γ = Γ.ordForm ω)
    {KY : Divisor Y}
    (hKY : ∀ Γ, KY.coeff Γ = Γ.ordForm (MMP.Mori.pullbackRationalPluriForms sX h ω))
    {BX : QDivisor X} {BY : QDivisor Y}
    (hq : (Divisor.toQDivisor KX + BX).IsQCartier)
    (hpull : ∃ hB, (Divisor.toQDivisor KX + BX).IsPullback h hB (Divisor.toQDivisor KY + BY))
    {D : DivisorOver k sX}
    {D' : DivisorOver k (h ≫ sX)} (hD' : IsProper D'.f)
    {e : ℕ} (he : ∀ g : X.functionField, D'.valuation (functionFieldMap h g) = D.valuation g ^ e)
    {a : ℝ} (ha : MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor BX) D a),
    MMP.Intersection.IsLogDiscrepancy (h ≫ sX) n (QDivisor.toRDivisor BY) D' (e * a) := by
  intro k _ _ X Y sX h _ _ _ _ _ _ _ _ hY n ω hω KX hKX KY hKY BX BY hq hpull D D' hD' e he a ha
  classical
  obtain ⟨hX, -, ω₀, hω₀, ⟨K₀, hK₀, -⟩, m, r, C, C', hCc, hsum, hpb, rfl⟩ := ha
  have := D.isIntegral
  have := D.isLocallyNoetherian
  have := D.isNormal
  have := D.isDominant
  have := D'.isIntegral
  have := D'.isLocallyNoetherian
  have := D'.isNormal
  have := D'.isDominant
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  have : LocallyOfFiniteType (h ≫ sX) := hY.1.toLocallyOfFiniteType
  have : CompactSpace Y := by
    have := hY.1
    exact QuasiCompact.compactSpace_of_compactSpace (h ≫ sX)
  have : CompactSpace D'.Y := by
    have := D'.isNormalVariety.1
    exact QuasiCompact.compactSpace_of_compactSpace (D'.f ≫ h ≫ sX)
  have hn : topologicalKrullDim X = n := hK₀.topologicalKrullDim_eq
  have hdimY : topologicalKrullDim Y = n := (topologicalKrullDim_eq_of_isFinite sX h).trans hn
  let := functionFieldAlgebra sX
  let := functionFieldAlgebra (h ≫ sX)
  let := functionFieldMapAlgebra h
  have := isScalarTower_functionFieldMap sX h
  have hdX : (Algebra.trdeg k X.functionField).toNat = n :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hn
  have hdY : (Algebra.trdeg k Y.functionField).toNat = n :=
    toNat_trdeg_functionField_of_topologicalKrullDim_eq hdimY
  -- the pull-back of forms along `h`
  obtain ⟨ωg, hωg⟩ := exists_isPullbackGenerator_of_topologicalKrullDim_eq sX h hn hdimY
  set b := basisOfSpanSingleton hωg.1 hωg.ne_zero
  set b' := basisOfSpanSingleton hωg.2.1 hωg.2.2
  have hrepr : ∀ τ : RationalPluriForms sX n 1,
      (ZTensorPower.basis b' 1).repr (pullbackRationalPluriForms sX h τ) () =
        functionFieldMap h ((ZTensorPower.basis b 1).repr τ ()) := fun τ => by
    rw [show pullbackRationalPluriForms sX h τ = pullbackFormsAlong hωg 1 τ from
      pullbackForms_eq hωg 1 τ]
    exact repr_pullbackFormsAlong hωg 1 τ
  have hω₀' : pullbackRationalPluriForms sX h ω₀ ≠ 0 := pullbackForms_ne_zero hωg hω₀
  have hω' : pullbackRationalPluriForms sX h ω ≠ 0 := pullbackForms_ne_zero hωg hω
  -- the canonical divisor of `Y`
  obtain ⟨KY₀, hKY₀⟩ := exists_isCanonicalDivisor (h ≫ sX) hY hdimY
  have hKcan : (divisorOfForm (pullbackRationalPluriForms sX h ω₀)).IsCanonicalDivisor (h ≫ sX) n :=
    hKY₀.of_linearlyEquivalent (by
      simpa using MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hY hKY₀ hω₀')
  -- the pull-backs of the Cartier divisors `Cᵢ` to `Y` and to `D'.Y`
  have hB₁ : ∀ i, ∀ Z : irreducibleComponents Y, h (componentGenericPoint Y Z) ∉ (C i).supp :=
    fun i => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp h (C i)
  let C₁ : Fin m → Divisor Y := fun i => (C i).pullback (hCc i) (hB₁ i)
  have hC₁pb : ∀ i, (C i).IsPullback h (hB₁ i) (C₁ i) := fun i =>
    Divisor.isPullback_pullback (hCc i) (hB₁ i)
  have hC₁c : ∀ i, (C₁ i).IsCartier := fun i => (hC₁pb i).isCartier (hCc i)
  have hB₂ : ∀ i, ∀ Z : irreducibleComponents D'.Y,
      D'.f (componentGenericPoint D'.Y Z) ∉ (C₁ i).supp :=
    fun i => MMP.Threefold.Bridges.map_componentGenericPoint_notMem_supp D'.f (C₁ i)
  let C₂ : Fin m → Divisor D'.Y := fun i => (C₁ i).pullback (hC₁c i) (hB₂ i)
  have hC₂pb : ∀ i, (C₁ i).IsPullback D'.f (hB₂ i) (C₂ i) := fun i =>
    Divisor.isPullback_pullback (hC₁c i) (hB₂ i)
  -- the Cartier multiple of `K_X + B_X` and its pull-back
  obtain ⟨m₀, hm₀, M, hM, hMc⟩ := hq.exists_pos
  obtain ⟨hB, hP⟩ := hpull
  obtain ⟨M', hM', hMpb⟩ := hP m₀ hm₀ M hM hMc
  have hm₀' : (m₀ : ℝ) ≠ 0 := by exact_mod_cast hm₀.ne'
  refine ⟨hY, hD', pullbackRationalPluriForms sX h ω₀, hω₀',
    ⟨_, hKcan, fun Γ => coeff_divisorOfForm _ Γ⟩, m, r, C₁, C₂, hC₁c, fun Γ' => ?_,
    fun i => ⟨_, hC₂pb i⟩, ?_⟩
  · -- `K_Y + B_Y` in terms of the pulled-back Cartier divisors, along `Γ'`
    rw [QDivisor.coeff_toRDivisor]
    choose V hV φ hφ using fun i => hCc i (h Γ'.genericPoint)
    obtain ⟨U₀, hU₀, μ, hμ⟩ := hMc (h Γ'.genericPoint)
    let Z0 := pointComponent (h Γ'.genericPoint)
    let g : Fin m → X.functionField := fun i =>
      MMP.Threefold.Mori.Helpers.evalFF Z0 ((φ i : RationalFunctions X))
    let gμ : X.functionField := MMP.Threefold.Mori.Helpers.evalFF Z0 ((μ : RationalFunctions X))
    set cω₀ := (ZTensorPower.basis b 1).repr ω₀ () with hcω₀
    set cω := (ZTensorPower.basis b 1).repr ω () with hcω
    have hg : ∀ i, g i ≠ 0 := fun i => ((φ i).isUnit.map _).ne_zero
    have hgμ : gμ ≠ 0 := (μ.isUnit.map _).ne_zero
    have hcω₀0 : cω₀ ≠ 0 := repr_ne_zero_of_ne_zero b hω₀
    have hcω0 : cω ≠ 0 := repr_ne_zero_of_ne_zero b hω
    let G : Option (Option (Option (Fin m))) → X.functionField := fun j =>
      Option.elim j gμ fun j => Option.elim j cω₀ fun j => Option.elim j cω g
    let w : Option (Option (Option (Fin m))) → ℝ := fun j =>
      Option.elim j 1 fun j => Option.elim j (m₀ : ℝ) fun j =>
        Option.elim j (-(m₀ : ℝ)) fun i => -(m₀ : ℝ) * r i
    have hG : ∀ j, G j ≠ 0 := by
      rintro (_ | _ | _ | i)
      exacts [hgμ, hcω₀0, hcω0, hg i]
    have key := MMP.Threefold.Bridges.sum_ord_functionFieldMap_eq_zero (f := h) Γ' G hG w
      fun Γ hΓ => by
        obtain ⟨NΓ, hNΓ⟩ := Γ.exists_ordForm_eq_ord_add_mul hdX b
        have hZ : Γ.component = Z0 := Subsingleton.elim
          (h := MMP.Threefold.Mori.Helpers.subsingleton_irreducibleComponents (X := X)) _ _
        have eg : ∀ i, X.ord (g i) Γ.genericPoint = (C i).coeff Γ := fun i => by
          rw [hφ i Γ ⟨_, hΓ, hV i⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hZ]
        have eμ : X.ord gμ Γ.genericPoint = M.coeff Γ := by
          rw [hμ Γ ⟨_, hΓ, hU₀⟩, MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord, hZ]
        have e1 : (Γ.ordForm ω₀ : ℝ) = X.ord cω₀ Γ.genericPoint + NΓ := by
          exact_mod_cast (by simpa using hNΓ 1 ω₀ hω₀)
        have e2 : (Γ.ordForm ω : ℝ) = X.ord cω Γ.genericPoint + NΓ := by
          exact_mod_cast (by simpa using hNΓ 1 ω hω)
        have e3 := hsum Γ
        rw [QDivisor.coeff_toRDivisor] at e3
        have e4 := coeff_eq_of_toQDivisor_eq_smul hM Γ
        have e5 : (KX.coeff Γ : ℝ) = Γ.ordForm ω := by exact_mod_cast hKX Γ
        simp only [Fintype.sum_option, G, w, Option.elim]
        simp_rw [eg, eμ]
        rw [sum_mul_mul_eq_mul_sum]
        linear_combination e4 - (m₀ : ℝ) * e1 + (m₀ : ℝ) * e2 + (m₀ : ℝ) * e3 + (m₀ : ℝ) * e5
    simp only [Fintype.sum_option, G, w, Option.elim] at key
    obtain ⟨N', hN'⟩ := Γ'.exists_ordForm_eq_ord_add_mul hdY b'
    have f1 : (Γ'.ordForm (pullbackRationalPluriForms sX h ω₀) : ℝ) =
        Y.ord (functionFieldMap h cω₀) Γ'.genericPoint + N' := by
      have := hN' 1 _ hω₀'
      rw [hrepr] at this
      exact_mod_cast (by simpa using this)
    have f2 : (KY.coeff Γ' : ℝ) = Y.ord (functionFieldMap h cω) Γ'.genericPoint + N' := by
      have := hN' 1 _ hω'
      rw [hrepr] at this
      rw [hKY Γ']
      exact_mod_cast (by simpa using this)
    have f3 := coeff_eq_of_toQDivisor_eq_smul hM' Γ'
    have f4 : (M'.coeff Γ' : ℝ) = Y.ord (functionFieldMap h gμ) Γ'.genericPoint := by
      exact_mod_cast MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hMpb hμ Γ' hU₀ Z0
    have f5 : ∀ i, ((C₁ i).coeff Γ' : ℝ) = Y.ord (functionFieldMap h (g i)) Γ'.genericPoint :=
      fun i => by
        exact_mod_cast MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF (hC₁pb i) (hφ i) Γ'
          (hV i) Z0
    simp_rw [f5]
    rw [sum_mul_mul_eq_mul_sum] at key
    apply mul_left_cancel₀ hm₀'
    linear_combination key + (m₀ : ℝ) * f1 - (m₀ : ℝ) * f2 - f3 + f4
  · -- the value of the log discrepancy
    have he0 : e ≠ 0 := ne_zero_of_valuation_eq_pow he
    have hcen := map_center_eq_of_valuation_eq_pow h hX.1 he0 he
    have hordc : ∀ g : X.functionField, g ≠ 0 →
        D'.Y.ord (functionFieldMap D'.f (functionFieldMap h g)) D'.E.genericPoint =
          e * D.Y.ord (functionFieldMap D.f g) D.E.genericPoint := fun g hg =>
      ord_eq_mul_of_divisorialValuation_eq_pow D.E D'.E (he g) ((map_ne_zero _).mpr hg)
        ((map_ne_zero _).mpr ((map_ne_zero _).mpr hg))
    choose Vx hVx φx hφx using fun i => hCc i (D.f D.E.genericPoint)
    let Zx := pointComponent (D.f D.E.genericPoint)
    have hcoef : ∀ i, ((C₂ i).coeff D'.E : ℝ) = e * ((C' i).coeff D.E : ℝ) := by
      intro i
      obtain ⟨_, hCp⟩ := hpb i
      have hgx : MMP.Threefold.Mori.Helpers.evalFF Zx ((φx i : RationalFunctions X)) ≠ 0 :=
        ((φx i).isUnit.map _).ne_zero
      rw [MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hCp (hφx i) D.E (hVx i) Zx,
        coeff_isPullback_isPullback_eq (hCc i) (hC₁pb i) (hC₂pb i) (hφx i) D'.E
          (by rw [hcen]; exact hVx i) Zx, hordc _ hgx]
      push_cast
      ring
    have htame : (D'.ordPullback (pullbackRationalPluriForms sX h ω₀) : ℝ) =
        e * (D.ordPullback ω₀ : ℝ) + (e - 1) := by
      exact_mod_cast ordPullback_pullbackRationalPluriForms_eq hX hY hn he hω₀
    simp_rw [htame, hcoef, mul_left_comm (r _), ← Finset.mul_sum]
    ring

section Codim

/-- **A finite dominant morphism of varieties maps codimension-one points to codimension-one
points**: the closures of `y` and `h y` have the same dimension, `κ(y)` being finite over
`κ(h y)`, and `Y`, `X` have the same dimension. -/
private theorem coheight_map_eq_of_isFinite {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) (h : Y ⟶ X) [IsIntegral X] [IsIntegral Y] [IsFinite h]
    [IsDominant h] [LocallyOfFiniteType sX] [LocallyOfFiniteType (h ≫ sX)] [CompactSpace Y]
    (y : Y) : Order.coheight (h y) = Order.coheight y := by
  have hY' := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight (h ≫ sX) y
  have hX' := MMP.Flips.topologicalKrullDim_closure_singleton_add_coheight sX (h y)
  have htr := MMP.Flips.trdeg_residueField_add (h ≫ sX) sX h rfl y
  letI := (h.residueFieldMap y).hom.toAlgebra
  have hfin := MMP.moduleFinite_residueField h y
  haveI : Algebra.IsAlgebraic (X.residueField (h y)) (Y.residueField y) :=
    Algebra.IsAlgebraic.of_finite _ _
  rw [show Algebra.trdeg (X.residueField (h y)) (Y.residueField y) = 0 from
    trdeg_eq_zero_iff.mpr inferInstance, add_zero] at htr
  have hcl : topologicalKrullDim (closure {y} : Set Y) =
      topologicalKrullDim (closure {h y} : Set X) := by
    rw [topologicalKrullDim_closure_singleton_eq_trdeg k Y (h ≫ sX),
      topologicalKrullDim_closure_singleton_eq_trdeg k X sX, ← htr]
  have hdim := topologicalKrullDim_eq_of_isFinite sX h
  have hne : topologicalKrullDim Y ≠ ⊤ := topologicalKrullDim_ne_top_of_locallyOfFiniteType k (h ≫ sX)
  rw [← hdim, ← hY', ← hcl] at hX'
  rw [← hY'] at hne
  rw [topologicalKrullDim_closure_singleton_eq_trdeg k Y (h ≫ sX)] at hX' hne
  generalize Cardinal.toENat _ = a at hX' hne
  induction a using ENat.recTopCoe with
  | top => exact absurd (by rw [← WithBot.coe_add, top_add]; rfl) hne
  | coe a =>
    rw [← WithBot.coe_add, ← WithBot.coe_add, WithBot.coe_inj] at hX'
    exact WithTop.add_left_cancel (ENat.coe_ne_top a) hX'

end Codim

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback

namespace MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.KltCover5d

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Mori.DivisorialCyclicCover Polynomial Opposite

section Algebra

open IsLocalRing

/-- A polynomial whose coefficients all lie in `span {t}` is `t` times a polynomial. -/
private theorem exists_eq_C_mul_of_coeff_mem {R : Type*} [CommRing R] {t : R} (P : R[X])
    (h : ∀ i, P.coeff i ∈ Ideal.span {t}) : ∃ Q : R[X], P = C t * Q := by
  have : P ∈ (Ideal.span {t}).map (C : R →+* R[X]) := Ideal.mem_map_C_iff.mpr h
  rw [Ideal.map_span, Set.image_singleton] at this
  obtain ⟨Q, hQ⟩ := Ideal.mem_span_singleton'.mp this
  exact ⟨Q, by rw [← hQ, mul_comm]⟩

/-- **Unramified reduction for a unit root.** Let `f : R → S` be a local homomorphism from a
local ring with principal maximal ideal `(t)` to a discrete valuation ring, and `θ ∈ S` with
`θᵐ = f(u)` for a unit `u`, `m` invertible in `R`. Then every nonzero element `P(θ)` of
`f(R)[θ]` is `f(t)ᵏ` times a unit. -/
private theorem exists_eq_pow_mul_isUnit_of_pow_eq_unit {R S : Type*} [CommRing R] [IsLocalRing R]
    [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] (f : R →+* S) [IsLocalHom f]
    {t : R} (ht : maximalIdeal R = Ideal.span {t}) {m : ℕ} (hm : IsUnit (m : R))
    {θ : S} {u : R} (hu : IsUnit u) (hθ : θ ^ m = f u) :
    ∀ P : R[X], P.eval₂ f θ ≠ 0 → ∃ (k : ℕ) (y : S), IsUnit y ∧ P.eval₂ f θ = f t ^ k * y := by
  classical
  have htm : t ∈ maximalIdeal R := ht ▸ Ideal.mem_span_singleton_self t
  have hft : f t ∈ maximalIdeal S := (map_mem_nonunits_iff f t).mpr htm
  set F : R[X] := Polynomial.X ^ m - C u with hF
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact not_isUnit_zero (M₀ := R) (by simpa using hm)
  have hFm : F.Monic := monic_X_pow_sub_C u hm0
  have hFθ : F.eval₂ f θ = 0 := by simp [hF, hθ]
  -- the reduction of `F` is squarefree
  have hsq : Squarefree (F.map (residue R)) := by
    have hsep : (F.map (residue R)).Separable := by
      rw [hF, Polynomial.map_sub, Polynomial.map_pow, map_X, map_C]
      refine separable_X_pow_sub_C _ ?_ ?_
      · have := (hm.map (residue R)).ne_zero
        simpa using this
      · exact (hu.map (residue R)).ne_zero
    exact hsep.squarefree
  let ψ : (ResidueField R)[X] →+* ResidueField S :=
    eval₂RingHom (ResidueField.map f) (residue S θ)
  have hψ : ∀ Q : R[X], ψ (Q.map (residue R)) = residue S (Q.eval₂ f θ) := by
    intro Q
    change eval₂ _ _ (Q.map _) = _
    rw [eval₂_map, Polynomial.hom_eval₂, ResidueField.map_comp_residue]
  have key : ∀ N : ℕ, ∀ P : R[X], IsDiscreteValuationRing.addVal S (P.eval₂ f θ) = N →
      ∃ (k : ℕ) (y : S), IsUnit y ∧ P.eval₂ f θ = f t ^ k * y := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ih =>
    intro P hN
    by_cases hz : IsUnit (P.eval₂ f θ)
    · exact ⟨0, _, hz, by rw [pow_zero, one_mul]⟩
    have hz0 : P.eval₂ f θ ≠ 0 := fun h0 => by
      rw [h0, IsDiscreteValuationRing.addVal_zero] at hN
      exact ENat.top_ne_coe N hN
    have hPI : P.map (residue R) ∈ RingHom.ker ψ := by
      rw [RingHom.mem_ker, hψ, residue_eq_zero_iff]
      exact hz
    have hFI : F.map (residue R) ∈ RingHom.ker ψ := by
      rw [RingHom.mem_ker, hψ, hFθ, map_zero]
    set g := Submodule.IsPrincipal.generator (RingHom.ker ψ)
    obtain ⟨h, hgh⟩ := (Submodule.IsPrincipal.mem_iff_generator_dvd _).mp hFI
    have hh : ψ h ≠ 0 := by
      intro hh0
      obtain ⟨h', hh'⟩ := (Submodule.IsPrincipal.mem_iff_generator_dvd _).mp
        (RingHom.mem_ker.mpr hh0)
      have hgg : g * g ∣ F.map (residue R) := ⟨h', by rw [hgh, hh', mul_assoc]⟩
      have hgu : IsUnit g := hsq g hgg
      have h1 : (1 : (ResidueField R)[X]) ∈ RingHom.ker ψ :=
        (Submodule.IsPrincipal.mem_iff_generator_dvd _).mpr (hgu.dvd)
      rw [RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    obtain ⟨H, hH⟩ := Polynomial.map_surjective (residue R) residue_surjective h
    have hdvd : F.map (residue R) ∣ (P * H).map (residue R) := by
      obtain ⟨c, hc⟩ := (Submodule.IsPrincipal.mem_iff_generator_dvd _).mp hPI
      exact ⟨c, by rw [Polynomial.map_mul, hH, hc, hgh]; ring⟩
    set Rm := (P * H) %ₘ F
    have hRm : Rm.map (residue R) = 0 := by
      rw [map_modByMonic _ hFm]
      exact (modByMonic_eq_zero_iff_dvd (hFm.map _)).mpr hdvd
    obtain ⟨Rm', hRm'⟩ := exists_eq_C_mul_of_coeff_mem Rm fun i => by
      rw [← ht, ← residue_eq_zero_iff]
      have := congrArg (fun q => q.coeff i) hRm
      simpa only [Polynomial.coeff_map, Polynomial.coeff_zero] using this
    have hHu : IsUnit (H.eval₂ f θ) := by
      rw [← residue_ne_zero_iff_isUnit, ← hψ, hH]
      exact hh
    have heq : P.eval₂ f θ * H.eval₂ f θ = f t * Rm'.eval₂ f θ := by
      have h1 := modByMonic_add_div (P * H) F
      have h2 := congrArg (fun q => q.eval₂ f θ) h1
      simp only [eval₂_add, eval₂_mul, hFθ, zero_mul, add_zero] at h2
      rw [← h2, show P * H %ₘ F = Rm from rfl, hRm', eval₂_mul, eval₂_C]
    have hR0 : Rm'.eval₂ f θ ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at heq
      exact (mul_ne_zero hz0 hHu.ne_zero) heq
    have hval := congrArg (IsDiscreteValuationRing.addVal S) heq
    rw [IsDiscreteValuationRing.addVal_mul, IsDiscreteValuationRing.addVal_mul,
      IsDiscreteValuationRing.addVal_eq_zero_iff.mpr hHu, add_zero, hN] at hval
    have hft1 : 1 ≤ IsDiscreteValuationRing.addVal S (f t) := by
      rw [ENat.one_le_iff_ne_zero, Ne, IsDiscreteValuationRing.addVal_eq_zero_iff]
      exact (mem_maximalIdeal _).mp hft
    obtain ⟨N', hN'⟩ : ∃ N' : ℕ, IsDiscreteValuationRing.addVal S (Rm'.eval₂ f θ) = N' := by
      refine ENat.ne_top_iff_exists.mp ?_ |>.imp fun a ha => ha.symm
      rwa [Ne, IsDiscreteValuationRing.addVal_eq_top_iff]
    have hlt : N' < N := by
      rw [hN'] at hval
      have : (N' : ℕ∞) + 1 ≤ N := by
        rw [hval, add_comm]; gcongr
      exact_mod_cast (ENat.add_one_le_iff (ENat.coe_ne_top _)).mp this
    obtain ⟨k, y, hy, hky⟩ := ih N' hlt Rm' hN'
    refine ⟨k + 1, y * hHu.unit⁻¹, hy.mul (Units.isUnit _), ?_⟩
    apply (hHu.mul_left_inj).mp
    rw [heq, hky]
    simp only [mul_assoc, IsUnit.val_inv_mul, mul_one]
    ring
  intro P hP
  obtain ⟨N, hN⟩ : ∃ N : ℕ, IsDiscreteValuationRing.addVal S (P.eval₂ f θ) = N := by
    refine ENat.ne_top_iff_exists.mp ?_ |>.imp fun a ha => ha.symm
    rwa [Ne, IsDiscreteValuationRing.addVal_eq_top_iff]
  exact key N P hN

/-- **No element of valuation one.** Let `f : R → S` be a local homomorphism to a discrete
valuation ring, `θ ∈ S` of valuation at least two, and suppose every non-unit of `R` maps to an
element of valuation at least two. Then no element `P(θ)` of `f(R)[θ]` has valuation one. -/
private theorem addVal_eval₂_ne_one {R S : Type*} [CommRing R] [CommRing S] [IsDomain S]
    [IsDiscreteValuationRing S] (f : R →+* S) {θ : S}
    (hθ : 2 ≤ IsDiscreteValuationRing.addVal S θ)
    (hf : ∀ c, ¬ IsUnit c → 2 ≤ IsDiscreteValuationRing.addVal S (f c)) (P : R[X]) :
    IsDiscreteValuationRing.addVal S (P.eval₂ f θ) ≠ 1 := by
  have hP : P.eval₂ f θ = θ * P.divX.eval₂ f θ + f (P.coeff 0) := by
    conv_lhs => rw [← X_mul_divX_add P]
    rw [eval₂_add, eval₂_mul, eval₂_X, eval₂_C]
  have h1 : 2 ≤ IsDiscreteValuationRing.addVal S (θ * P.divX.eval₂ f θ) := by
    rw [IsDiscreteValuationRing.addVal_mul]
    exact le_add_right hθ
  rw [hP]
  by_cases hc : IsUnit (P.coeff 0)
  · have hu : IsUnit (θ * P.divX.eval₂ f θ + f (P.coeff 0)) := by
      have hθm : θ * P.divX.eval₂ f θ ∈ IsLocalRing.maximalIdeal S := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← IsDiscreteValuationRing.addVal_eq_zero_iff]
        intro h0
        rw [h0] at h1
        exact absurd h1 (by decide)
      by_contra hn
      have := (IsLocalRing.maximalIdeal S).sub_mem
        ((IsLocalRing.mem_maximalIdeal _).mpr hn) hθm
      rw [add_sub_cancel_left] at this
      exact (IsLocalRing.mem_maximalIdeal _).mp this (hc.map f)
    rw [IsDiscreteValuationRing.addVal_eq_zero_iff.mpr hu]
    decide
  · intro h
    have := le_trans (le_min h1 (hf _ hc)) (IsDiscreteValuationRing.addVal_add)
    rw [h] at this
    exact absurd this (by decide)

/-- **Ramification of `θᵐ = u`.** Let `f : R → S` be a local homomorphism of discrete valuation
rings, `ϖ` a uniformizer of `R`, `m` invertible in `R`, and `θ ∈ S` with `θᵐ = f(u)`, such that
some `P(θ)` is a uniformizer of `S`. If `u` is a unit, `f(ϖ)` is a uniformizer of `S`; if `u` is
a uniformizer of `R`, the valuation of `f(ϖ)` is at most `m`. -/
private theorem addVal_map_uniformizer_of_pow_eq {R S : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing S] [IsDomain S] [IsDiscreteValuationRing S]
    (f : R →+* S) [IsLocalHom f] {ϖ : R} (hϖ : Irreducible ϖ) {m : ℕ} (hm : IsUnit (m : R))
    {θ : S} {u : R} (hθ : θ ^ m = f u)
    (hgen : ∃ P : R[X], IsDiscreteValuationRing.addVal S (P.eval₂ f θ) = 1) :
    (IsUnit u → IsDiscreteValuationRing.addVal S (f ϖ) = 1) ∧
      (Irreducible u → IsDiscreteValuationRing.addVal S (f ϖ) ≤ m) := by
  obtain ⟨P, hP⟩ := hgen
  have hmax : maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hP0 : P.eval₂ f θ ≠ 0 := fun h0 => by
    rw [h0, IsDiscreteValuationRing.addVal_zero] at hP
    exact absurd hP (by decide)
  -- valuations of images
  have hval : ∀ c : R, c ≠ 0 → ∃ n : ℕ, IsDiscreteValuationRing.addVal S (f c) =
      n • IsDiscreteValuationRing.addVal S (f ϖ) ∧ (¬ IsUnit c → 1 ≤ n) := by
    intro c hc
    obtain ⟨n, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc hϖ
    refine ⟨n, ?_, fun hn => ?_⟩
    · rw [map_mul, map_pow, IsDiscreteValuationRing.addVal_mul,
        IsDiscreteValuationRing.addVal_eq_zero_iff.mpr ((w.isUnit).map f), zero_add,
        IsDiscreteValuationRing.addVal_pow]
    · rcases Nat.eq_zero_or_pos n with rfl | hn'
      · exact absurd (by simp) hn
      · exact hn'
  have hfϖ : 1 ≤ IsDiscreteValuationRing.addVal S (f ϖ) := by
    rw [ENat.one_le_iff_ne_zero, Ne, IsDiscreteValuationRing.addVal_eq_zero_iff]
    exact fun h => hϖ.not_isUnit (isUnit_of_map_unit f ϖ h)
  refine ⟨fun hu => ?_, fun hu => ?_⟩
  · obtain ⟨k, y, hy, hky⟩ := exists_eq_pow_mul_isUnit_of_pow_eq_unit f hmax hm hu hθ P hP0
    rw [hky, IsDiscreteValuationRing.addVal_mul, IsDiscreteValuationRing.addVal_eq_zero_iff.mpr hy,
      add_zero, IsDiscreteValuationRing.addVal_pow] at hP
    rcases k with _ | k
    · simp at hP
    · have : (k + 1) • IsDiscreteValuationRing.addVal S (f ϖ) ≥
          IsDiscreteValuationRing.addVal S (f ϖ) := by
        rw [succ_nsmul]; exact le_add_self
      refine le_antisymm (hP ▸ this) hfϖ
  · by_contra hlt
    push Not at hlt
    set e := IsDiscreteValuationRing.addVal S (f ϖ)
    -- `u` is a uniformizer
    have hfu : IsDiscreteValuationRing.addVal S (f u) = e := by
      obtain ⟨w, hw⟩ := IsDiscreteValuationRing.associated_of_irreducible R hu hϖ
      change _ = IsDiscreteValuationRing.addVal S (f ϖ)
      rw [← hw, map_mul, IsDiscreteValuationRing.addVal_mul,
        IsDiscreteValuationRing.addVal_eq_zero_iff.mpr ((w.isUnit).map f), add_zero]
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact not_isUnit_zero (M₀ := R) (by simpa using hm)
    have he2 : 2 ≤ e := by
      have h1 : (m : ℕ∞) + 1 ≤ e := Order.add_one_le_of_lt hlt
      have h2 : (1 : ℕ∞) ≤ m := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hm0
      calc (2 : ℕ∞) = 1 + 1 := by norm_num
        _ ≤ m + 1 := by gcongr
        _ ≤ e := h1
    have hθ2 : 2 ≤ IsDiscreteValuationRing.addVal S θ := by
      have h1 : m • IsDiscreteValuationRing.addVal S θ = e := by
        rw [← IsDiscreteValuationRing.addVal_pow, hθ, hfu]
      by_contra h2
      push Not at h2
      have : IsDiscreteValuationRing.addVal S θ ≤ 1 := Order.le_of_lt_add_one h2
      have : m • IsDiscreteValuationRing.addVal S θ ≤ m := by
        calc m • IsDiscreteValuationRing.addVal S θ ≤ m • (1 : ℕ∞) := nsmul_le_nsmul_right this m
          _ = m := by simp
      rw [h1] at this
      exact absurd hlt (not_lt.mpr this)
    refine addVal_eval₂_ne_one f hθ2 (fun c hc => ?_) P hP
    rcases eq_or_ne c 0 with rfl | hc0
    · simp
    obtain ⟨n, hn, hn1⟩ := hval c hc0
    rw [hn]
    calc (2 : ℕ∞) ≤ e := he2
      _ = 1 • e := (one_nsmul e).symm
      _ ≤ n • e := nsmul_le_nsmul_left zero_le (hn1 hc)

end Algebra

section Root

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
  (hφ : 0 ≤ principalDivisor φ + m • M)

/-- Over an affine open `U` on which `M` has a local equation `g`, the sections of the cyclic
cover over `U` are generated over `Γ(X, U)` by one element `θ` with `θᵐ = v`, `v` the regular
function `gᵐφ`. -/
private theorem exists_root_cover {U : X.Opens} (hU : IsAffineOpen U) {g : (RationalFunctions X)ˣ}
    (hg : M.IsLocalEquation U g) :
    ∃ (v : Γ(X, U)) (θ : Γ(cover m M hφ, toBase m M hφ ⁻¹ᵁ U)),
      ((toRationalFunctionsPresheaf X).app (op U)).hom v = phiOn (g ^ m * φ) U ∧
      (principalDivisor φ + m • M).IsLocalEquation U (g ^ m * φ) ∧
      θ ^ m = (toBase m M hφ).app U v ∧
      ∀ b, ∃ P : Γ(X, U)[X], b = P.eval₂ ((toBase m M hφ).app U).hom θ := by
  obtain ⟨v, hv, hloc, eAR, -⟩ := exists_algEquiv_adjoinRoot_of_isLocalEquation m M hφ hg
  letI := ((localSubalgebra m M hφ).algebraMap U).toAlgebra
  let Ψ₀ := ((Stacks.RelativeSpec.universalAlgebraMap (situation m M hφ)).right.app (op U))
  let Ψ : (localSubalgebra m M hφ).carrier U →+* Γ(cover m M hφ, toBase m M hφ ⁻¹ᵁ U) := Ψ₀.hom
  have hΨ : ∀ r : Γ(X, U), Ψ (algebraMap Γ(X, U) ((localSubalgebra m M hφ).carrier U) r) =
      ((toBase m M hφ).app U).hom r := fun r => by
    rw [Stacks.RelativeSpec.toBase_app]
    rfl
  have hiso : IsIso Ψ₀ :=
    Stacks.RelativeSpec.isIso_universalAlgebraMap_app (situation m M hφ) ⟨U, hU⟩
  have hsurj : Function.Surjective Ψ := (ConcreteCategory.bijective_of_isIso Ψ₀).2
  have hroot : (AdjoinRoot.root (Polynomial.X ^ m - C v)) ^ m = AdjoinRoot.of _ v := by
    have h0 := AdjoinRoot.eval₂_root (Polynomial.X ^ m - C v)
    rw [eval₂_sub, eval₂_X_pow, eval₂_C, sub_eq_zero] at h0
    exact h0
  refine ⟨v, Ψ (eAR (AdjoinRoot.root _)), hv, hloc, ?_, fun b => ?_⟩
  · rw [← map_pow, ← map_pow, hroot, ← hΨ]
    congr 1
    exact AlgEquiv.commutes eAR v
  · obtain ⟨c, rfl⟩ := hsurj b
    obtain ⟨a, rfl⟩ := eAR.surjective c
    obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective a
    refine ⟨P, ?_⟩
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, Polynomial.aeval_def,
      Polynomial.hom_eval₂]
    congr 1
    ext r
    exact hΨ r

end Root

section Stalk

/-- The germ at `y` of `P(θ)` is `P(germ θ)`, with coefficients read in `𝒪_{X, p(y)}`. -/
private theorem germ_eval₂_app {X Y : Scheme.{0}} (p : Y ⟶ X) {U : X.Opens} (θ : Γ(Y, p ⁻¹ᵁ U))
    (P : Γ(X, U)[X]) {y : Y} (hy : y ∈ p ⁻¹ᵁ U) :
    (Y.presheaf.germ _ y hy).hom (P.eval₂ (p.app U).hom θ) =
      (P.map (X.presheaf.germ U (p y) hy).hom).eval₂ (p.stalkMap y).hom
        ((Y.presheaf.germ _ y hy).hom θ) := by
  rw [Polynomial.hom_eval₂, Polynomial.eval₂_map]
  congr 1
  ext r
  exact (Scheme.Hom.germ_stalkMap_apply p U y hy r).symm

-- The `overlappingInstances` linter times out synthesizing `IsDomain` on a stalk here.
set_option linter.overlappingInstances false in
/-- If the sections of `Y` over the affine open `p⁻¹U` are generated over `Γ(X, U)` by `θ`, then
at a point `y` of `p⁻¹U` with `𝒪_{Y,y}` a discrete valuation ring some polynomial in the germ of
`θ` is a uniformizer: `𝒪_{Y,y}` is a localization of `Γ(Y, p⁻¹U)`. -/
private theorem exists_addVal_eval₂_eq_one {X Y : Scheme.{0}} (p : Y ⟶ X) {U : X.Opens}
    (hV : IsAffineOpen (p ⁻¹ᵁ U)) {θ : Γ(Y, p ⁻¹ᵁ U)}
    (hgen : ∀ b, ∃ P : Γ(X, U)[X], b = P.eval₂ (p.app U).hom θ) {y : Y} (hy : y ∈ p ⁻¹ᵁ U)
    [IsDomain (Y.presheaf.stalk y)] [IsDiscreteValuationRing (Y.presheaf.stalk y)] :
    ∃ P : (X.presheaf.stalk (p y))[X], IsDiscreteValuationRing.addVal _
      (P.eval₂ (p.stalkMap y).hom ((Y.presheaf.germ _ y hy).hom θ)) = 1 := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible (Y.presheaf.stalk y)
  let := Y.presheaf.algebra_section_stalk ⟨y, hy⟩
  have := hV.isLocalization_stalk ⟨y, hy⟩
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.mk'_surjective
    (hV.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl π
  have hspec := IsLocalization.mk'_spec (Y.presheaf.stalk y) a b
  rw [show IsLocalization.mk' (Y.presheaf.stalk y) a b = π from hab] at hspec
  have hbu := IsLocalization.map_units (Y.presheaf.stalk y) b
  obtain ⟨P, hP⟩ := hgen a
  refine ⟨P.map (X.presheaf.germ U (p y) hy).hom, ?_⟩
  rw [← germ_eval₂_app, ← hP]
  change IsDiscreteValuationRing.addVal _ (algebraMap Γ(Y, p ⁻¹ᵁ U) (Y.presheaf.stalk y) a) = 1
  rw [← hspec, IsDiscreteValuationRing.addVal_mul,
    IsDiscreteValuationRing.addVal_eq_zero_iff.mpr hbu, add_zero,
    IsDiscreteValuationRing.addVal_uniformizer hπ]

/-- On a discrete valuation ring stalk at a codimension-one point, the order of vanishing of an
element is its additive valuation. -/
private theorem ord_algebraMap_eq_addVal {Z : Scheme.{0}} [IsIntegral Z] [IsLocallyNoetherian Z] {z : Z}
    (hz : Order.coheight z = 1) [IsDiscreteValuationRing (Z.presheaf.stalk z)]
    {s : Z.presheaf.stalk z} (hs : s ≠ 0) :
    ∃ n : ℕ, IsDiscreteValuationRing.addVal _ s = n ∧
      Z.ord (algebraMap _ Z.functionField s) z = n := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Z.presheaf.stalk z)
  obtain ⟨n, w, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
  refine ⟨n, ?_, ?_⟩
  · rw [IsDiscreteValuationRing.addVal_mul, IsDiscreteValuationRing.addVal_eq_zero_of_unit,
      zero_add, IsDiscreteValuationRing.addVal_pow, IsDiscreteValuationRing.addVal_uniformizer hϖ]
    simp
  · have hne : algebraMap _ Z.functionField ((w : Z.presheaf.stalk z) * ϖ ^ n) ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hs)
    rw [Scheme.ord_eq_iff hz hne]
    have : Ring.KrullDimLE 1 (Z.presheaf.stalk z) := krullDimLE_of_coheight_le hz.le
    unfold Scheme.ordHom
    rw [map_mul, map_pow, map_mul, map_pow, Ring.ordFrac_of_isUnit w.isUnit,
      Ring.ordFrac_irreducible hϖ, one_mul, ← WithZero.exp_nsmul]
    simp
    rfl

/-- If `ψ` is a local equation of `D` on `U` and `v ∈ Γ(X, U)` is `ψ` read as a regular function,
the order of `v` along every prime divisor meeting `U` is its coefficient in `D`. -/
private theorem ord_germToFunctionField_eq_coeff {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {D : Divisor X} {U : X.Opens} [Nonempty U] {ψ : (RationalFunctions X)ˣ}
    (hψ : D.IsLocalEquation U ψ) {v : Γ(X, U)}
    (hv : ((toRationalFunctionsPresheaf X).app (op U)).hom v = phiOn ψ U)
    (E : MMP.Mori.PrimeDivisor X) (hE : E.genericPoint ∈ U) :
    X.ord ((X.germToFunctionField U).hom v) E.genericPoint = D.coeff E := by
  rw [hψ E ((E.genericPoint_mem_iff U).mp hE), MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord]
  congr 1
  have hZU : componentGenericPoint X E.component ∈ U := E.specializes_genericPoint.mem_open U.isOpen hE
  have h1 : (ψ : RationalFunctions X) E.component = X.presheaf.germ U _ hZU v := by
    have := congrFun hv ⟨E.component, hZU⟩
    exact this.symm
  symm
  change (X.presheaf.stalkSpecializes _).hom ((ψ : RationalFunctions X) E.component) = _
  rw [h1, TopCat.Presheaf.germ_stalkSpecializes_apply]

/-- A rational function regular along `E` pulls back to one regular along `E'`. -/
private theorem ord_functionFieldMap_nonneg {Y Y' : Scheme.{0}} (h : Y' ⟶ Y) [IsIntegral Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y] [IsLocallyNoetherian Y'] [IsNormal Y] [IsNormal Y']
    [IsDominant h] (E : MMP.Mori.PrimeDivisor Y) (E' : MMP.Mori.PrimeDivisor Y')
    (hEE' : h E'.genericPoint = E.genericPoint) {g : Y.functionField} (hg : g ≠ 0)
    (h0 : 0 ≤ Y.ord g E.genericPoint) : 0 ≤ Y'.ord (functionFieldMap h g) E'.genericPoint := by
  have hne : functionFieldMap h g ≠ 0 := (_root_.map_ne_zero _).mpr hg
  have h1 : E.divisorialValuation g ≤ 1 := by
    rw [E.divisorialValuation_eq_exp_neg_ord hg, ← WithZero.exp_zero, WithZero.exp_le_exp]
    omega
  obtain ⟨r, hr⟩ := (E.divisorialValuation_le_one_iff g).mp h1
  have hsp : h E'.genericPoint ⤳ E.genericPoint := hEE' ▸ specializes_rfl
  have h2 : E'.divisorialValuation (functionFieldMap h g) ≤ 1 := by
    rw [E'.divisorialValuation_le_one_iff]
    refine ⟨(h.stalkMap E'.genericPoint).hom ((Y.presheaf.stalkSpecializes hsp).hom r), ?_⟩
    rw [← functionFieldMap_algebraMap_stalk, MMP.Mori.algebraMap_stalkSpecializes, ← hr]
  rw [E'.divisorialValuation_eq_exp_neg_ord hne, ← WithZero.exp_zero, WithZero.exp_le_exp] at h2
  omega

/-- The order of an inverse: `v_z(g⁻¹) = -v_z(g)`. -/
private theorem ord_inv {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] (z : X)
    {g : X.functionField} (hg : g ≠ 0) : X.ord g⁻¹ z = -X.ord g z := by
  simpa using MMP.Mori.ord_zpow z hg (-1)

/-- A rational function that is a unit along `E` pulls back to a unit along `E'`. -/
private theorem ord_functionFieldMap_eq_zero {Y Y' : Scheme.{0}} (h : Y' ⟶ Y) [IsIntegral Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y] [IsLocallyNoetherian Y'] [IsNormal Y] [IsNormal Y']
    [IsDominant h] (E : MMP.Mori.PrimeDivisor Y) (E' : MMP.Mori.PrimeDivisor Y')
    (hEE' : h E'.genericPoint = E.genericPoint) {g : Y.functionField} (hg : g ≠ 0)
    (h0 : Y.ord g E.genericPoint = 0) : Y'.ord (functionFieldMap h g) E'.genericPoint = 0 := by
  have h1 := ord_functionFieldMap_nonneg h E E' hEE' hg h0.ge
  have h2 := ord_functionFieldMap_nonneg h E E' hEE' (inv_ne_zero hg)
    (by rw [ord_inv _ hg, h0, neg_zero])
  rw [map_inv₀, ord_inv _ ((_root_.map_ne_zero _).mpr hg)] at h2
  omega

/-- The order along `E'` of the pull-back of a rational function is `e` times its order along
`E`, where `e` is the order of the pull-back of a uniformizer. -/
private theorem ord_functionFieldMap_eq_mul {Y Y' : Scheme.{0}} (h : Y' ⟶ Y) [IsIntegral Y]
    [IsIntegral Y'] [IsLocallyNoetherian Y] [IsLocallyNoetherian Y'] [IsNormal Y] [IsNormal Y']
    [IsDominant h] (E : MMP.Mori.PrimeDivisor Y) (E' : MMP.Mori.PrimeDivisor Y')
    (hEE' : h E'.genericPoint = E.genericPoint)
    {t : Y.functionField} (ht : Y.ord t E.genericPoint = 1) {f : Y.functionField} (hf : f ≠ 0) :
    Y'.ord (functionFieldMap h f) E'.genericPoint =
      Y'.ord (functionFieldMap h t) E'.genericPoint * Y.ord f E.genericPoint := by
  have htne : t ≠ 0 := by
    rintro rfl
    simp at ht
  set q := Y.ord f E.genericPoint
  set g := f * t ^ (-q) with hgdef
  have hgne : g ≠ 0 := mul_ne_zero hf (zpow_ne_zero _ htne)
  have hg' := ord_functionFieldMap_eq_zero h E E' hEE' hgne (by
    rw [hgdef, Scheme.ord_mul hf (zpow_ne_zero _ htne), MMP.Mori.ord_zpow _ htne, ht]
    ring)
  have hhg : functionFieldMap h g ≠ 0 := (_root_.map_ne_zero _).mpr hgne
  have hf' : f = g * t ^ q := by
    rw [hgdef, mul_assoc, ← zpow_add₀ htne, neg_add_cancel, zpow_zero, mul_one]
  have hhtne : functionFieldMap h t ≠ 0 := (_root_.map_ne_zero _).mpr htne
  rw [hf', map_mul, map_zpow₀, Scheme.ord_mul hhg (zpow_ne_zero _ hhtne), MMP.Mori.ord_zpow _ hhtne, hg']
  ring

end Stalk

section Ramification

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
  (hφ : 0 ≤ principalDivisor φ + m • M)

/-- **Ramification of the cyclic cover along a prime divisor.** Let `E'` be a prime divisor of
the cover over a prime divisor `E` of `X`, `t` a uniformizer along `E`, and `e` the order of
`p^* t` along `E'`. If `E` is not a component of `G = div φ + mM`, then `e = 1`; if `E` is a
reduced component of `G`, then `e ≤ m`. -/
private theorem ord_functionFieldMap_toBase [IsIntegral (cover m M hφ)]
    [IsLocallyNoetherian (cover m M hφ)] [IsNormal (cover m M hφ)] [IsFinite (toBase m M hφ)]
    [IsDominant (toBase m M hφ)] (hm : ∀ x : X, IsUnit (m : X.presheaf.stalk x))
    (E' : MMP.Mori.PrimeDivisor (cover m M hφ)) (E : MMP.Mori.PrimeDivisor X)
    (hEE' : toBase m M hφ E'.genericPoint = E.genericPoint)
    {U : X.Opens} (hU : IsAffineOpen U) (hEU : E.genericPoint ∈ U) {g : (RationalFunctions X)ˣ}
    (hg : M.IsLocalEquation U g) {t : X.functionField} (ht : X.ord t E.genericPoint = 1) :
    ((principalDivisor φ + m • M).coeff E = 0 →
      (cover m M hφ).ord (functionFieldMap (toBase m M hφ) t) E'.genericPoint = 1) ∧
    ((principalDivisor φ + m • M).coeff E = 1 →
      (cover m M hφ).ord (functionFieldMap (toBase m M hφ) t) E'.genericPoint ≤ m) := by
  set p := toBase m M hφ
  set y := E'.genericPoint
  haveI : Nonempty U := ⟨⟨_, hEU⟩⟩
  obtain ⟨v, θs, hv, hloc, hθm, hgen⟩ := exists_root_cover m M hφ hU hg
  have hy : y ∈ p ⁻¹ᵁ U := by
    change p y ∈ U
    rw [hEE']
    exact hEU
  have hV : IsAffineOpen (p ⁻¹ᵁ U) := hU.preimage p
  haveI : IsDiscreteValuationRing ((cover m M hφ).presheaf.stalk y) :=
    E'.isDiscreteValuationRing_localRing
  have hcoh : Order.coheight (p y) = 1 := by
    rw [hEE']
    exact E.coheight_genericPoint
  haveI : IsDiscreteValuationRing (X.presheaf.stalk (p y)) := by
    rw [hEE']
    exact E.isDiscreteValuationRing_localRing
  set f := (p.stalkMap y).hom
  set θ := ((cover m M hφ).presheaf.germ _ y hy).hom θs
  set u := (X.presheaf.germ U (p y) hy).hom v
  have hθ : θ ^ m = f u := by
    rw [← map_pow, hθm]
    exact (Scheme.Hom.germ_stalkMap_apply p U y hy v).symm
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (X.presheaf.stalk (p y))
  obtain ⟨hA, hB⟩ := addVal_map_uniformizer_of_pow_eq f hϖ (hm (p y)) hθ
    (exists_addVal_eval₂_eq_one p hV hgen hy)
  -- the ramification index is the valuation of `f ϖ`
  have hϖK : algebraMap (X.presheaf.stalk (p y)) X.functionField ϖ ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero)
  have hfϖ0 : f ϖ ≠ 0 := by
    intro h0
    have := MMP.Mori.functionFieldMap_algebraMap_stalk p y ϖ
    rw [show (p.stalkMap y).hom ϖ = 0 from h0, map_zero] at this
    exact hϖK ((_root_.map_eq_zero _).mp this)
  obtain ⟨n, hn, hnord⟩ := ord_algebraMap_eq_addVal E'.coheight_genericPoint hfϖ0
  have ht' : X.ord (algebraMap (X.presheaf.stalk (p y)) X.functionField ϖ) E.genericPoint = 1 := by
    obtain ⟨n', hn', hn'ord⟩ := ord_algebraMap_eq_addVal hcoh hϖ.ne_zero
    rw [IsDiscreteValuationRing.addVal_uniformizer hϖ] at hn'
    have : n' = 1 := by exact_mod_cast hn'.symm
    rw [← hEE', hn'ord, this, Nat.cast_one]
  have he : (cover m M hφ).ord (functionFieldMap p t) y = n := by
    have h1 := ord_functionFieldMap_eq_mul p E E' hEE' ht hϖK
    rw [ht', mul_one, MMP.Mori.functionFieldMap_algebraMap_stalk] at h1
    rw [← h1]
    exact hnord
  -- the valuation of `u` is the coefficient of `G`
  have hv0 : v ≠ 0 := by
    intro h0
    have hZU : componentGenericPoint X E.component ∈ U :=
      E.specializes_genericPoint.mem_open U.isOpen hEU
    have h1 := congrFun hv ⟨E.component, hZU⟩
    rw [h0, map_zero] at h1
    have h2 : ((g ^ m * φ : (RationalFunctions X)ˣ) : RationalFunctions X) E.component ≠ 0 :=
      (((g ^ m * φ).isUnit).map (RationalFunctions.component X E.component)).ne_zero
    exact h2 h1.symm
  have hu0 : u ≠ 0 := by
    intro h0
    have := Scheme.algebraMap_germ_eq_germToFunctionField X hy v
    rw [show (X.presheaf.germ U (p y) hy).hom v = 0 from h0, map_zero] at this
    exact hv0 (X.germToFunctionField_injective U (this.symm.trans (map_zero _).symm))
  obtain ⟨k, hk, hkord⟩ := ord_algebraMap_eq_addVal hcoh hu0
  have hkG : (k : ℤ) = (principalDivisor φ + m • M).coeff E := by
    rw [Scheme.algebraMap_germ_eq_germToFunctionField X hy v, hEE'] at hkord
    rw [← hkord]
    exact ord_germToFunctionField_eq_coeff hloc hv E hEU
  refine ⟨fun h0 => ?_, fun h1 => ?_⟩
  · have hk0 : k = 0 := by
      rw [h0] at hkG
      exact_mod_cast hkG
    have hunit : IsUnit u := by
      rw [← IsDiscreteValuationRing.addVal_eq_zero_iff, hk, hk0, Nat.cast_zero]
    have := hA hunit
    rw [hn] at this
    rw [he]
    exact_mod_cast this
  · have hk1 : k = 1 := by
      rw [h1] at hkG
      exact_mod_cast hkG
    have hirr : Irreducible u := by
      obtain ⟨n'', w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hu0 hϖ
      have : n'' = 1 := by
        have h2 := hk
        rw [hw, IsDiscreteValuationRing.addVal_mul, IsDiscreteValuationRing.addVal_eq_zero_of_unit,
          zero_add, IsDiscreteValuationRing.addVal_pow,
          IsDiscreteValuationRing.addVal_uniformizer hϖ, hk1] at h2
        simpa using h2
      rw [hw, this, pow_one]
      exact (associated_unit_mul_left ϖ w w.isUnit).symm.irreducible hϖ
    have := hB hirr
    rw [hn] at this
    rw [he]
    exact_mod_cast this

end Ramification

section Surjective

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
  (hφ : 0 ≤ principalDivisor φ + m • M)

/-- The coefficients of a regular function `r` in the basis `1, t, …, tᵐ⁻¹`: `r` itself in degree
`0`, and `0` in every other degree. -/
private theorem coeff_structureMap (U : X.Opens) (r : Γ(X, U)) (n : ℕ) :
    coeff m φ U n (((structureMap m φ).app (op U)).hom r) =
      if n = 0 then (toRationalFunctionsPresheaf X).app (op U) r else 0 := by
  have h1 : ((structureMap m φ).app (op U)).hom r =
      ((structureMap m φ).app (op U)).hom r * reduce m φ U (Polynomial.monomial 0 1) := by
    rw [Polynomial.monomial_zero_one, map_one, mul_one]
  rw [h1, coeff_structureMap_mul, coeff_reduce_monomial]
  rcases eq_or_ne n 0 with rfl | hn
  · rw [if_pos (Nat.zero_mod m), if_pos rfl, Nat.zero_div, pow_zero, mul_one]
    funext Z
    rw [rationalFunctions_smul_apply, toRationalFunctionsPresheaf_app_apply]
    exact mul_one _
  · rw [if_neg (by rw [Nat.zero_mod]; exact hn.symm), if_neg hn, smul_zero]

/-- The universal map `𝒜(U) → Γ(p⁻¹U, 𝒪_{X'})` is injective (it is an isomorphism). -/
private theorem injective_universalAlgebraMap_app (U : X.Opens) :
    Function.Injective
      ((Stacks.RelativeSpec.universalAlgebraMap (situation m M hφ)).right.app (op U)).hom := by
  haveI := (situation m M hφ).isQuasicoherent
  let e := Stacks.AffineAlgebraEquivalence.pushforwardAlgebraIso (situation m M hφ).algebra
  refine Function.LeftInverse.injective (g := (e.hom.right.hom.app (op U)).hom) fun x => ?_
  exact congrArg (fun f => ((f.right.hom).app (op U)).hom x) e.inv_hom_id

/-- `p^♯` is injective on every open. -/
private theorem injective_toBase_app (U : X.Opens) :
    Function.Injective ((toBase m M hφ).app U).hom := by
  intro r r' hr
  rw [Stacks.RelativeSpec.toBase_app] at hr
  have h0 := injective_universalAlgebraMap_app m M hφ U hr
  have h1 : coeff m φ U 0 ((localSubalgebra m M hφ).algebraMap U r).1 =
      coeff m φ U 0 ((localSubalgebra m M hφ).algebraMap U r').1 :=
    congrArg (fun a => coeff m φ U 0 (Subtype.val a)) h0
  rw [LocalSubalgebra.coe_algebraMap, LocalSubalgebra.coe_algebraMap, coeff_structureMap,
    coeff_structureMap, if_pos rfl, if_pos rfl] at h1
  exact toRationalFunctionsPresheaf_app_injective U h1

/-- The cyclic cover is surjective: `p` is closed and its image contains the generic point,
since `p^♯` is injective. -/
private theorem surjective_toBase [IsFinite (toBase m M hφ)] : Surjective (toBase m M hφ) := by
  have hclosed : IsClosed (Set.range (toBase m M hφ)) :=
    (toBase m M hφ).isClosedMap.isClosed_range
  have hη : genericPoint X ∈ Set.range (toBase m M hφ) := by
    by_contra hη
    let V : X.Opens := ⟨(Set.range (toBase m M hφ))ᶜ, hclosed.isOpen_compl⟩
    have : Nonempty V := ⟨⟨_, hη⟩⟩
    have hV : (toBase m M hφ) ⁻¹ᵁ V = ⊥ := by
      ext x
      exact ⟨fun hx => absurd ⟨x, rfl⟩ hx, fun hx => (show False from hx).elim⟩
    have : Subsingleton Γ(cover m M hφ, (toBase m M hφ) ⁻¹ᵁ V) := by
      rw [hV]
      infer_instance
    exact one_ne_zero (injective_toBase_app m M hφ V (Subsingleton.elim _ _))
  refine ⟨fun x => ?_⟩
  have hx : x ∈ closure {genericPoint X} := by
    rw [(genericPoint_spec X).def]
    trivial
  exact hclosed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη) hx

end Surjective

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.KltCover5d

open CategoryTheory AlgebraicGeometry MMP.Mori MMP.Mori.DivisorialCyclicCover

namespace MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof

open Opposite

/-- Cohen–Macaulayness of a module over a local ring is invariant under linear equivalence. -/
private theorem isCMModule_of_linearEquiv {R : Type*} [CommRing R] [IsLocalRing R]
    {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N)
    (h : IsCMModule R M) : IsCMModule R N := by
  rcases h with h | ⟨xs, ⟨hm, hreg⟩, hlen⟩
  · exact Or.inl e.symm.toEquiv.subsingleton
  · refine Or.inr ⟨xs, ⟨hm, (e.isWeaklyRegular_congr xs).mp hreg⟩, ?_⟩
    rw [hlen, Module.supportDim, Module.supportDim, e.support_eq]

/-- A morphism of sheaves of modules that is bijective on sections over every open inside `U`
is bijective on the stalks at the points of `U`. -/
private theorem bijective_stalkLinearMap_of_bijective_app {X : Scheme.{0}} {F G : X.Modules}
    (f : F ⟶ G) {U : X.Opens} (hU : ∀ V ≤ U, Function.Bijective (f.app V))
    {x : X} (hx : x ∈ U) : Function.Bijective (stalkLinearMap F G f x) := by
  have hnat : ∀ {V W : X.Opens} (i : V ⟶ W) (s : Γ(F, W)),
      f.app V (F.presheaf.map i.op s) = G.presheaf.map i.op (f.app W s) := fun i s =>
    ConcreteCategory.congr_hom (f.mapPresheaf.naturality i.op) s
  have hgerm : ∀ {V : X.Opens} (hxV : x ∈ V) (s : Γ(F, V)),
      stalkLinearMap F G f x (F.presheaf.germ V x hxV s) = G.presheaf.germ V x hxV (f.app V s) :=
    fun hxV s => stalkLinearMap_germ F G f _ x hxV s
  constructor
  · intro a b hab
    obtain ⟨W, hxW, s, rfl⟩ := F.presheaf.exists_germ_eq a
    obtain ⟨W', hxW', s', rfl⟩ := F.presheaf.exists_germ_eq b
    rw [hgerm, hgerm] at hab
    obtain ⟨V, hxV, i, i', h⟩ := TopCat.Presheaf.germ_eq _ x hxW hxW' _ _ hab
    let V' : X.Opens := V ⊓ U
    have hxV' : x ∈ V' := ⟨hxV, hx⟩
    let j : V' ⟶ V := homOfLE inf_le_left
    have h' : f.app V' (F.presheaf.map (j ≫ i).op s) =
        f.app V' (F.presheaf.map (j ≫ i').op s') := by
      rw [hnat, hnat, op_comp, Functor.map_comp, op_comp, Functor.map_comp]
      change G.presheaf.map j.op (G.presheaf.map i.op _) =
        G.presheaf.map j.op (G.presheaf.map i'.op _)
      rw [h]
    have h'' := (hU V' inf_le_right).1 h'
    rw [← F.presheaf.germ_res_apply (j ≫ i) x hxV' s,
      ← F.presheaf.germ_res_apply (j ≫ i') x hxV' s', h'']
  · intro b
    obtain ⟨W, hxW, t, rfl⟩ := G.presheaf.exists_germ_eq b
    let V : X.Opens := W ⊓ U
    have hxV : x ∈ V := ⟨hxW, hx⟩
    obtain ⟨s, hs⟩ := (hU V inf_le_right).2 (G.presheaf.map (homOfLE inf_le_left : V ⟶ W).op t)
    refine ⟨F.presheaf.germ V x hxV s, ?_⟩
    rw [hgerm, hs, G.presheaf.germ_res_apply]

/-- **Twisting by a Cartier divisor preserves Cohen–Macaulayness**: near every point, a local
equation `ψ` of `A` identifies `𝒪_X(D + A)` with `𝒪_X(D)`. -/
private theorem isCMSheaf_divisorialSheaf_add_of_isCartier {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] {D A : Divisor X} (hA : A.IsCartier)
    (h : IsCMSheaf D.divisorialSheaf) : IsCMSheaf (D + A).divisorialSheaf := by
  intro x
  obtain ⟨U, hxU, ψ, hψ⟩ := hA x
  set D' : Divisor X := D + A - principalDivisor ψ with hD'
  have hcoeff : ∀ E : MMP.Mori.PrimeDivisor X, (E.support ∩ U).Nonempty → (D ⊓ D').coeff E = D.coeff E ∧
      (D ⊓ D').coeff E = D'.coeff E := by
    intro E hE
    have : D'.coeff E = D.coeff E := by
      rw [hD', DivisorWithCoeffs.coeff_sub, DivisorWithCoeffs.coeff_add, coeff_principalDivisor,
        hψ E hE]
      ring
    change D E ⊓ D' E = D E ∧ D E ⊓ D' E = D' E
    rw [← DivisorWithCoeffs.coeff_apply, ← DivisorWithCoeffs.coeff_apply, this, inf_idem]
    exact ⟨rfl, rfl⟩
  have hb : ∀ {D₁ : Divisor X} (hle : D ⊓ D' ≤ D₁),
      (∀ E : MMP.Mori.PrimeDivisor X, (E.support ∩ U).Nonempty → (D ⊓ D').coeff E = D₁.coeff E) →
      Function.Bijective (stalkLinearMap _ _ (Divisor.divisorialSheafInclusion hle) x) := by
    intro D₁ hle hc
    refine bijective_stalkLinearMap_of_bijective_app _ (fun V hV => ?_) hxU
    have := Divisor.isIso_divisorialSheafInclusion_app hle (U := V) fun E hE =>
      hc E (hE.mono (Set.inter_subset_inter_right _ hV))
    exact ConcreteCategory.bijective_of_isIso _
  let e₁ := LinearEquiv.ofBijective _ (hb inf_le_left fun E hE => (hcoeff E hE).1)
  let e₂ := LinearEquiv.ofBijective _ (hb inf_le_right fun E hE => (hcoeff E hE).2)
  let iso := Divisor.divisorialSheafMulIso (D := D + A) (D' := D') ψ fun E => by
    rw [hD', DivisorWithCoeffs.coeff_sub, coeff_principalDivisor]; ring
  let e₃ := stalkLinearEquiv _ _ iso.inv x
  exact isCMModule_of_linearEquiv ((e₁.symm.trans e₂).trans e₃) (h x)

/-- A retract of a module inherits every weakly regular sequence. -/
private theorem isWeaklyRegular_of_retract {R : Type*} [CommRing R] :
    ∀ (rs : List R) {M N : Type*} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
      (i : N →ₗ[R] M) (r : M →ₗ[R] N), r ∘ₗ i = LinearMap.id →
      RingTheory.Sequence.IsWeaklyRegular M rs → RingTheory.Sequence.IsWeaklyRegular N rs
  | [], _, _, _, _, _, _, _, _, _, _ => RingTheory.Sequence.IsWeaklyRegular.nil R _
  | x :: rs, M, N, _, _, _, _, i, r, h, hM => by
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff] at hM ⊢
    have hi : Function.Injective i := fun a b hab => by
      have h1 := congrArg (fun f => f a) h
      have h2 := congrArg (fun f => f b) h
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq] at h1 h2
      rw [← h1, ← h2, hab]
    refine ⟨fun a b hab => hi (hM.1 ?_), ?_⟩
    · change x • i a = x • i b
      rw [← map_smul, ← map_smul]
      exact congrArg i hab
    · refine isWeaklyRegular_of_retract rs (QuotSMulTop.map x i) (QuotSMulTop.map x r) ?_ hM.2
      rw [← QuotSMulTop.map_comp, h, QuotSMulTop.map_id]

/-- A retract `N` of a Cohen–Macaulay module `M` over a local ring is Cohen–Macaulay, provided
`dim M ≤ dim N`. -/
private theorem isCMModule_of_retract {R : Type*} [CommRing R] [IsLocalRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (i : N →ₗ[R] M) (r : M →ₗ[R] N) (h : r ∘ₗ i = LinearMap.id)
    (hdim : Module.supportDim R M ≤ Module.supportDim R N) (hM : IsCMModule R M) :
    IsCMModule R N := by
  have hi : Function.Injective i := fun a b hab => by
    have h1 := congrArg (fun f => f a) h
    have h2 := congrArg (fun f => f b) h
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq] at h1 h2
    rw [← h1, ← h2, hab]
  rcases hM with hM | ⟨xs, ⟨hm, hreg⟩, hlen⟩
  · exact Or.inl hi.subsingleton
  · refine Or.inr ⟨xs, ⟨hm, isWeaklyRegular_of_retract xs i r h hreg⟩, ?_⟩
    rw [hlen]
    refine le_antisymm hdim ?_
    exact Module.supportDim_le_of_injective i hi

/-- **Divisorial stalks are torsion-free**: on an integral scheme, a nonzero element of the
local ring kills no nonzero germ of `𝒪_X(D)`, since sections of `𝒪_X(D)` are rational
functions. -/
private theorem eq_zero_of_smul_eq_zero_stalk {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (D : Divisor X) {x : X} {r : X.presheaf.stalk x}
    {n : D.divisorialSheaf.presheaf.stalk x} (h : r • n = 0) (hr : r ≠ 0) : n = 0 := by
  obtain ⟨V, hxV, s, rfl⟩ := D.divisorialSheaf.presheaf.exists_germ_eq n
  obtain ⟨W, hxW, t, rfl⟩ := X.presheaf.exists_germ_eq r
  let U : X.Opens := V ⊓ W
  have hxU : x ∈ U := ⟨hxV, hxW⟩
  let iV : U ⟶ V := homOfLE inf_le_left
  let iW : U ⟶ W := homOfLE inf_le_right
  set t' : Γ(X, U) := X.presheaf.map iW.op t
  set s' : Γ(D.divisorialSheaf, U) := D.divisorialSheaf.presheaf.map iV.op s
  have hs : D.divisorialSheaf.presheaf.germ V x hxV s = D.divisorialSheaf.presheaf.germ U x hxU s' :=
    (D.divisorialSheaf.presheaf.germ_res_apply iV x hxU s).symm
  have ht : X.presheaf.germ W x hxW t = X.presheaf.germ U x hxU t' :=
    (X.presheaf.germ_res_apply iW x hxU t).symm
  rw [hs, ht] at h
  rw [hs]
  rw [ht] at hr
  have hsm := PresheafOfModules.germ_smul (M := D.divisorialSheaf.val) x U hxU t' s'
  change D.divisorialSheaf.presheaf.germ U x hxU (t' • s') = _ at hsm
  have h2 : D.divisorialSheaf.presheaf.germ U x hxU (t' • s') =
      D.divisorialSheaf.presheaf.germ U x hxU 0 := (hsm.trans h).trans (map_zero _).symm
  obtain ⟨U', hxU', i, i', hU'⟩ := TopCat.Presheaf.germ_eq _ x hxU hxU _ _ h2
  rw [map_zero] at hU'
  -- the generic point lies in `U'`
  have hsub : Subsingleton (irreducibleComponents X) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  have Z₀ : irreducibleComponents X := ⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩
  have hη : componentGenericPoint X Z₀ ∈ U' := by
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]
    exact ((genericPoint_spec X).mem_open_set_iff U'.isOpen).mpr ⟨x, trivial, hxU'⟩
  have hval := congrArg (fun a : D.divisorialSubmodule U' => a.1 ⟨Z₀, hη⟩) hU'
  change X.presheaf.germ U _ (i.le hη) t' * s'.1 ⟨Z₀, i.le hη⟩ = 0 at hval
  haveI : IsDomain (X.presheaf.stalk (componentGenericPoint X Z₀)) :=
    (RationalFunctions.isField_stalk (X := X) Z₀).isDomain
  rcases mul_eq_zero.mp (hval : (_ : X.presheaf.stalk (componentGenericPoint X Z₀)) * _ = 0)
    with h0 | h0
  · exfalso
    apply hr
    have ht0 : t' = 0 := germ_injective_of_isIntegral X _ (i.le hη) (h0.trans (map_zero _).symm)
    rw [ht0, map_zero]
  · have hs0 : s' = 0 := by
      apply Subtype.ext
      funext Z
      obtain rfl : Z.1 = Z₀ := Subsingleton.elim _ _
      exact h0
    rw [hs0, map_zero]

section Coherence

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]

private theorem primeDivisor_genericPoint_ne (E : MMP.Mori.PrimeDivisor X) :
    E.genericPoint ≠ genericPoint X := by
  intro h
  have := E.coheight_genericPoint
  rw [h] at this
  have h0 : Order.coheight (genericPoint X) = 0 := by
    rw [Order.coheight_eq_zero]
    intro b _
    exact ((genericPoint_spec X).specializes (Set.mem_univ b)).ge
  simp [h0] at this

private theorem exists_section_vanishing {U : X.Opens} (hU : IsAffineOpen U)
    (hηU : genericPoint X ∈ U) (E : MMP.Mori.PrimeDivisor X) :
    ∃ a : Γ(X, U), genericPoint X ∈ X.basicOpen a ∧
      (E.genericPoint ∈ U → E.genericPoint ∉ X.basicOpen a) := by
  by_cases hE : E.genericPoint ∈ U
  · let V : X.Opens := U ⊓ ⟨(closure {E.genericPoint})ᶜ, isClosed_closure.isOpen_compl⟩
    have hηV : genericPoint X ∈ V := by
      refine ⟨hηU, fun hc => primeDivisor_genericPoint_ne E ?_⟩
      exact (specializes_iff_mem_closure.mpr hc).antisymm
        ((genericPoint_spec X).specializes (Set.mem_univ _)) |>.eq
    obtain ⟨f, hfV, hηf⟩ := hU.exists_basicOpen_le ⟨_, hηV⟩ hηU
    exact ⟨f, hηf, fun _ hEf => (hfV hEf).2 (subset_closure rfl)⟩
  · exact ⟨1, by rwa [Scheme.basicOpen_one], fun h => absurd h hE⟩

/-- A regular function on an affine open `U ∋ η` that is invertible at the generic point and
vanishes at the generic point of each of finitely many prime divisors meeting `U`. -/
private theorem exists_section_vanishing_finset {U : X.Opens} (hU : IsAffineOpen U)
    (hηU : genericPoint X ∈ U) (S : Finset (MMP.Mori.PrimeDivisor X)) :
    ∃ a : Γ(X, U), genericPoint X ∈ X.basicOpen a ∧
      ∀ E ∈ S, E.genericPoint ∈ U → E.genericPoint ∉ X.basicOpen a := by
  classical
  choose g hgη hgE using exists_section_vanishing hU hηU
  refine ⟨∏ E ∈ S, g E, ?_, fun E hE hEU hEa => ?_⟩
  · induction S using Finset.induction_on with
    | empty => rwa [Finset.prod_empty, Scheme.basicOpen_one]
    | insert E s hE ih => rw [Finset.prod_insert hE, Scheme.basicOpen_mul]; exact ⟨hgη E, ih⟩
  · rw [← Finset.mul_prod_erase _ _ hE, Scheme.basicOpen_mul] at hEa
    exact hgE E hEU hEa.1

/-- **Divisorial sheaves are coherent**: on an integral locally Noetherian normal scheme, the
sections of `𝒪_X(D)` over an affine open `U` form a finite `Γ(X, U)`-module. -/
private theorem finite_divisorialSubmodule [CompactSpace X] (D : Divisor X) {U : X.Opens}
    (hU : IsAffineOpen U) : Module.Finite Γ(X, U) (D.divisorialSubmodule U) := by
  classical
  have := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  by_cases hηU : genericPoint X ∈ U
  swap
  · have : IsEmpty {Z : irreducibleComponents X // componentGenericPoint X Z ∈ U} :=
      ⟨fun Z => hηU (MMP.Fourfold.componentGenericPoint_eq_genericPoint Z.1 ▸ Z.2)⟩
    have : Subsingleton (D.divisorialSubmodule U) :=
      ⟨fun φ ψ => Subtype.ext (funext fun Z => isEmptyElim Z)⟩
    exact Module.Finite.of_finite
  obtain ⟨a, hηa, hEa⟩ := exists_section_vanishing_finset hU hηU D.support
  let N : ℕ := D.support.sup fun E => (D.coeff E).toNat
  -- multiplication by `a ^ N` maps `𝒪_X(D)(U)` into `𝒪_X(0)(U)`
  have hmem : ∀ φ : D.divisorialSubmodule U,
      (0 : Divisor X).IsDivisorialSection U (a ^ N • φ.1) := by
    intro φ E hEU
    have hηE := E.componentGenericPoint_mem_of_nonempty hEU
    have hEgU := E.genericPoint_mem_of_nonempty hEU
    have hgerm : X.presheaf.germ U _ hηE a = E.toComponent.hom (X.presheaf.germ U _ hEgU a) :=
      (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hEgU
        E.specializes_genericPoint a).symm
    have h0 : (0 : Divisor X).coeff E = 0 := rfl
    rw [rationalFunctions_smul_apply, map_pow, hgerm, h0, neg_zero]
    by_cases hc : 0 < D.coeff E
    · have hE : E ∈ D.support := Finsupp.mem_support_iff.mpr hc.ne'
      have hmax : X.presheaf.germ U _ hEgU a ∈
          IsLocalRing.maximalIdeal (X.presheaf.stalk E.genericPoint) := fun hunit =>
        hEa E hE hEgU ((Scheme.mem_basicOpen X a _ hEgU).mpr hunit)
      refine (((E.ordGE_one_toComponent hmax).pow N).mul (φ.2 E hEU)).mono ?_
      have hN : (D.coeff E).toNat ≤ N :=
        Finset.le_sup (f := fun E => (D.coeff E).toNat) hE
      have := Int.toNat_of_nonneg hc.le
      omega
    · rw [← map_pow]
      exact ((φ.2 E hEU).toComponent_mul _).mono (by omega)
  let L : D.divisorialSubmodule U →ₗ[Γ(X, U)] (0 : Divisor X).divisorialSubmodule U :=
    { toFun := fun φ => ⟨a ^ N • φ.1, hmem φ⟩
      map_add' := fun φ ψ => Subtype.ext (smul_add _ _ _)
      map_smul' := fun r φ => Subtype.ext (smul_comm _ _ _) }
  have hL : Function.Injective L := by
    intro φ ψ h
    refine Subtype.ext (funext fun Z => ?_)
    have h1 := congrFun (congrArg Subtype.val h) Z
    change (a ^ N • φ.1) Z = (a ^ N • ψ.1) Z at h1
    rw [rationalFunctions_smul_apply, rationalFunctions_smul_apply] at h1
    have hu : IsUnit (X.presheaf.germ U _ Z.2 (a ^ N)) := by
      rw [map_pow]
      exact ((Scheme.mem_basicOpen X a _ Z.2).mp
        (by rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]; exact hηa)).pow N
    exact hu.mul_left_cancel h1
  -- `𝒪_X(0)(U)` is a quotient of `Γ(X, U)`
  let one : (0 : Divisor X).divisorialSubmodule U :=
    ⟨1, Divisor.IsDivisorialSection.one le_rfl U⟩
  have hsurj : Function.Surjective (LinearMap.toSpanSingleton Γ(X, U) _ one) := by
    intro φ
    obtain ⟨s, hs⟩ := Divisor.IsDivisorialSection.exists_eq φ.2
    refine ⟨s, Subtype.ext (funext fun Z => ?_)⟩
    change X.presheaf.germ U _ Z.2 s * 1 = φ.1 Z
    rw [mul_one, ← hs]
    rfl
  have := isNoetherian_of_surjective _ (LinearMap.range_eq_top.mpr hsurj)
  have := isNoetherian_of_injective L hL
  infer_instance

end Coherence

variable {X : Scheme.{0}} [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
  (hφ : 0 ≤ principalDivisor φ + m • M) (i : Fin m)

/-- The inclusion of the `i`-th summand `𝒪_X(-iM)(U) ⟶ 𝒜(U)`. -/
private noncomputable def ιSec (U : X.Opens) :
    letI := (localSubalgebra m M hφ).moduleSections U
    Γ(((i : ℕ) • -M).divisorialSheaf, U) →ₗ[Γ(X, U)] (localSubalgebra m M hφ).carrier U :=
  letI := (localSubalgebra m M hφ).moduleSections U
  (coeffLinearEquiv m M hφ U).symm.toLinearMap ∘ₗ
    LinearMap.single Γ(X, U) (fun j : Fin m => Γ(((j : ℕ) • -M).divisorialSheaf, U)) i

/-- The projection `𝒜(U) ⟶ 𝒪_X(-iM)(U)` onto the `i`-th summand. -/
private noncomputable def πSec (U : X.Opens) :
    letI := (localSubalgebra m M hφ).moduleSections U
    (localSubalgebra m M hφ).carrier U →ₗ[Γ(X, U)] Γ(((i : ℕ) • -M).divisorialSheaf, U) :=
  letI := (localSubalgebra m M hφ).moduleSections U
  LinearMap.proj i ∘ₗ (coeffLinearEquiv m M hφ U).toLinearMap

private theorem coeffEquiv_restrict {U V : X.Opens} (f : V ⟶ U) (x : (localSubalgebra m M hφ).carrier U)
    (j : Fin m) :
    coeffEquiv m M hφ V ((localSubalgebra m M hφ).restrict f x) j =
      ((j : ℕ) • -M).divisorialSheaf.presheaf.map f.op (coeffEquiv m M hφ U x j) := rfl

private theorem coeffEquiv_ιSec (U : X.Opens) (a : Γ(((i : ℕ) • -M).divisorialSheaf, U)) :
    coeffEquiv m M hφ U (ιSec m M hφ i U a) =
      Pi.single (M := fun j : Fin m => Γ(((j : ℕ) • -M).divisorialSheaf, U)) i a :=
  letI := (localSubalgebra m M hφ).moduleSections U
  (coeffLinearEquiv m M hφ U).apply_symm_apply _

private theorem ιSec_restrict {U V : X.Opens} (f : V ⟶ U) (a : Γ(((i : ℕ) • -M).divisorialSheaf, U)) :
    ιSec m M hφ i V (((i : ℕ) • -M).divisorialSheaf.presheaf.map f.op a) =
      (localSubalgebra m M hφ).restrict f (ιSec m M hφ i U a) := by
  apply (coeffEquiv m M hφ V).injective
  funext j
  rw [coeffEquiv_restrict]
  rw [coeffEquiv_ιSec, coeffEquiv_ιSec]
  by_cases hj : j = i
  · subst hj; simp
  · simp [Pi.single_eq_of_ne hj]

private theorem πSec_restrict {U V : X.Opens} (f : V ⟶ U) (x : (localSubalgebra m M hφ).carrier U) :
    πSec m M hφ i V ((localSubalgebra m M hφ).restrict f x) =
      ((i : ℕ) • -M).divisorialSheaf.presheaf.map f.op (πSec m M hφ i U x) :=
  coeffEquiv_restrict m M hφ f x i

private theorem πSec_ιSec (U : X.Opens) (a) : πSec m M hφ i U (ιSec m M hφ i U a) = a := by
  simp [πSec, ιSec]

/-- The inclusion `𝒪_X(-iM) ⟶ 𝒜` of the `i`-th summand of the cyclic cover algebra. -/
private noncomputable def summandι :
    ((i : ℕ) • -M).divisorialSheaf ⟶ (algebraSheaf m M hφ).underlyingModule :=
  ⟨PresheafOfModules.homMk
    { app U := (AddCommGrpCat.ofHom (ιSec m M hφ i U.unop).toAddMonoidHom : _ ⟶ _)
      naturality U V f := by
        ext a
        exact ιSec_restrict m M hφ i f.unop a }
    fun U r a => by
      letI := (localSubalgebra m M hφ).moduleSections U.unop
      exact (ιSec m M hφ i U.unop).map_smul r a⟩

/-- The projection `𝒜 ⟶ 𝒪_X(-iM)` onto the `i`-th summand of the cyclic cover algebra. -/
private noncomputable def summandπ :
    (algebraSheaf m M hφ).underlyingModule ⟶ ((i : ℕ) • -M).divisorialSheaf :=
  ⟨PresheafOfModules.homMk
    { app U := (AddCommGrpCat.ofHom (πSec m M hφ i U.unop).toAddMonoidHom : _ ⟶ _)
      naturality U V f := by
        ext a
        exact πSec_restrict m M hφ i f.unop a }
    fun U r a => by
      letI := (localSubalgebra m M hφ).moduleSections U.unop
      exact (πSec m M hφ i U.unop).map_smul r a⟩

private theorem summandι_summandπ : summandι m M hφ i ≫ summandπ m M hφ i = 𝟙 _ := by
  ext U a
  exact πSec_ιSec m M hφ i U a

/-- On an integral scheme, every module over a local ring `𝒪_{X,x}` has dimension at most that of
a nonzero divisorial stalk: such a stalk contains a copy of `𝒪_{X,x}`. -/
private theorem supportDim_le_supportDim_stalk {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] (D : Divisor X) (x : X) [Nontrivial (D.divisorialSheaf.presheaf.stalk x)]
    (P : Type*) [AddCommGroup P] [Module (X.presheaf.stalk x) P] :
    Module.supportDim (X.presheaf.stalk x) P ≤
      Module.supportDim (X.presheaf.stalk x) (D.divisorialSheaf.presheaf.stalk x) := by
  obtain ⟨n, hn⟩ := exists_ne (0 : D.divisorialSheaf.presheaf.stalk x)
  have hinj : Function.Injective (LinearMap.toSpanSingleton (X.presheaf.stalk x) _ n) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro r hr
    by_contra h
    exact hn (eq_zero_of_smul_eq_zero_stalk D hr h)
  calc Module.supportDim (X.presheaf.stalk x) P ≤ ringKrullDim (X.presheaf.stalk x) :=
        Module.supportDim_le_ringKrullDim _ _
    _ = Module.supportDim (X.presheaf.stalk x) (X.presheaf.stalk x) :=
        (Module.supportDim_self_eq_ringKrullDim (X.presheaf.stalk x)).symm
    _ ≤ _ := Module.supportDim_le_of_injective _ hinj

/-- **A summand of a Cohen–Macaulay cyclic cover algebra is Cohen–Macaulay**: `𝒪_X(-iM)` is a
direct summand of `𝒜`, with full support. -/
private theorem isCMSheaf_summand {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    [CompactSpace X] (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
    (hφ : 0 ≤ principalDivisor φ + m • M) (i : Fin m)
    (h : IsCMSheaf (algebraSheaf m M hφ).underlyingModule) :
    IsCMSheaf ((i : ℕ) • -M).divisorialSheaf := by
  intro x
  rcases subsingleton_or_nontrivial (((i : ℕ) • -M).divisorialSheaf.presheaf.stalk x) with hs | hs
  · exact Or.inl hs
  have hP : IsCMModule (X.presheaf.stalk x) ((algebraSheaf m M hφ).underlyingModule.presheaf.stalk x) :=
    h x
  have hd := supportDim_le_supportDim_stalk ((i : ℕ) • -M) x
    ((algebraSheaf m M hφ).underlyingModule.presheaf.stalk x)
  have hc : (stalkLinearMap _ _ (summandπ m M hφ i) x) ∘ₗ (stalkLinearMap _ _ (summandι m M hφ i) x) =
      LinearMap.id := by
    refine LinearMap.ext fun z => ?_
    have e1 := Scheme.Modules.stalkLinearMap_comp (summandι m M hφ i) (summandπ m M hφ i) x z
    rw [summandι_summandπ, Scheme.Modules.stalkLinearMap_id] at e1
    exact e1.symm
  exact isCMModule_of_retract _ _ hc hd hP

section Finite

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
  (m : ℕ) [NeZero m] (D : Divisor X) {φ : (RationalFunctions X)ˣ}
  (hφ : 0 ≤ principalDivisor φ + m • D)

/-- `𝒜(U)` is a finite `Γ(X, U)`-module, for `U` affine. -/
private theorem finite_algebraMap_carrier {U : X.Opens} (hU : IsAffineOpen U) :
    ((localSubalgebra m D hφ).algebraMap U).Finite := by
  letI := (localSubalgebra m D hφ).moduleSections U
  have : ∀ i : Fin m, Module.Finite Γ(X, U) Γ((((i : ℕ) • -D)).divisorialSheaf, U) :=
    fun i => finite_divisorialSubmodule _ hU
  exact Module.Finite.equiv (coeffLinearEquiv m D hφ U).symm

private theorem isAffineHom_toBase : IsAffineHom (toBase m D hφ) := by
  haveI := (situation m D hφ).isQuasicoherent
  exact Stacks.AffineAlgebraEquivalence.isAffineHom_relativeSpecToBase (situation m D hφ).algebra

/-- The cyclic cover is finite: `𝒜` is a finite direct sum of coherent divisorial sheaves. -/
private theorem isFinite_toBase : IsFinite (toBase m D hφ) := by
  haveI := (situation m D hφ).isQuasicoherent
  haveI := isAffineHom_toBase m D hφ
  refine ⟨fun U hU => ?_⟩
  have hI : (((Stacks.RelativeSpec.universalAlgebraMap (situation m D hφ)).right.app
      (op U)).hom).Finite := by
    have := Stacks.RelativeSpec.isIso_universalAlgebraMap_app (situation m D hφ) ⟨U, hU⟩
    exact RingHom.Finite.of_surjective _
      (ConcreteCategory.bijective_of_isIso
        ((Stacks.RelativeSpec.universalAlgebraMap (situation m D hφ)).right.app (op U))).2
  rw [Stacks.RelativeSpec.toBase_app]
  exact hI.comp (finite_algebraMap_carrier m D hφ hU)

end Finite

/-- In an irreducible space, every irreducible component of the subspace `univ` has the
dimension of the space. -/
private theorem topologicalKrullDim_of_mem_irreducibleComponents_univ {T : Type*}
    [TopologicalSpace T] [IrreducibleSpace T] (S : Set T) (hS : S = Set.univ) (Z : Set S)
    (hZ : Z ∈ irreducibleComponents S) : topologicalKrullDim Z = topologicalKrullDim T := by
  subst hS
  haveI : IrreducibleSpace (Set.univ : Set T) :=
    ((Homeomorph.Set.univ T).irreducibleSpace_iff).2 inferInstance
  rw [irreducibleComponents_eq_singleton, Set.mem_singleton_iff] at hZ
  subst hZ
  rw [IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ _).isHomeomorph,
    IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ T).isHomeomorph]

/-- The support of `𝒪_X` is all of `X`. -/
private theorem setOf_nontrivial_stalk_unit (X : Scheme.{0}) :
    {x : X | Nontrivial (TopCat.Presheaf.stalk (C := Ab.{0})
      (SheafOfModules.unit X.ringCatSheaf).val.presheaf x)} = Set.univ :=
  Set.eq_univ_of_forall fun x =>
    (Stacks.Ample.unitStalkEquiv X x).toEquiv.nontrivial

/-- **The summands of a Cohen–Macaulay cyclic cover are Cohen–Macaulay**: if the cover
`Y = Spec_X 𝒜` is Cohen–Macaulay, so is `p_* 𝒪_Y = 𝒜`, and hence its summand `𝒪_X(-iM)`. -/
private theorem isCMSheaf_of_isCMScheme_cover {k : Type} [Field k] {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X] (sX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType sX] (m : ℕ) [NeZero m] (M : Divisor X) {φ : (RationalFunctions X)ˣ}
    (hφ : 0 ≤ principalDivisor φ + m • M) (i : Fin m) [IrreducibleSpace (cover m M hφ)] {r : ℕ}
    (hdim : topologicalKrullDim (cover m M hφ) = r) (hY : IsCMScheme (cover m M hφ)) :
    IsCMSheaf ((i : ℕ) • -M).divisorialSheaf := by
  haveI := isFinite_toBase m M hφ
  haveI : LocallyOfFiniteType (toBase m M hφ ≫ sX) := inferInstance
  haveI : IsLocallyNoetherian (cover m M hφ) :=
    LocallyOfFiniteType.isLocallyNoetherian (toBase m M hφ ≫ sX)
  haveI := Stacks.AlgebraicGeometry.CoherentOfFiniteType.isCoherent_unit (X := cover m M hφ)
  have hpush := (isCMSheaf_pushforward_iff (toBase m M hφ ≫ sX) sX (toBase m M hφ)
    (SheafOfModules.unit (cover m M hφ).ringCatSheaf) r (fun Z hZ => by
      rw [topologicalKrullDim_of_mem_irreducibleComponents_univ _
        (setOf_nontrivial_stalk_unit _) Z hZ, hdim])).mp hY
  haveI := (situation m M hφ).isQuasicoherent
  let e := Stacks.RelativeSpec.AlgebraSheaf.underlyingModuleIso
    (Stacks.AffineAlgebraEquivalence.pushforwardAlgebraIso (situation m M hφ).algebra)
  exact isCMSheaf_summand m M hφ i fun x =>
    isCMModule_of_linearEquiv (stalkLinearEquiv _ _ e.hom x) (hpush x)

/-- A variety finite over a projective variety is projective. -/
private theorem isProjectiveVariety_comp_of_isFinite {k : Type} [Field k] {X Y : Scheme.{0}}
    (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsProjectiveVariety k sX] (p : Y ⟶ X)
    [IsFinite p] (hY : AlgebraicGeometry.IsVariety k (p ≫ sX)) :
    AlgebraicGeometry.IsProjectiveVariety k (p ≫ sX) := by
  have hXp : IsProjectiveMorphism sX :=
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).isProjective
  obtain ⟨-, L, hLinv, hLamp⟩ :=
    Stacks.HProjective.isQuasiProjective_of_isHQuasiProjective sX hXp.isHQuasiProjective
  have hL : Stacks.Ample.IsAmple X L :=
    Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine sX L hLamp
  exact (AlgebraicGeometry.isProjectiveVariety_iff k _).2
    ⟨hY, (isProjectiveMorphism_of_isFinite p L hL).comp hXp⟩

section FreeSystem

open MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation

variable {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]

/-- On a proper integral scheme over an algebraically closed field, every global function is a
constant: `Γ(X, 𝒪_X)` is a field finite over `k`. -/
private theorem scalarsToGlobalSections_bijective {k : Type} [Field k] [IsAlgClosed k]
    {X : Scheme.{0}} [IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX] :
    Function.Bijective (scalarsToGlobalSections k sX) := by
  have hf : sX.appTop.hom.Finite := finite_appTop_of_universallyClosed (f := sX)
  haveI := (isField_of_universallyClosed (f := sX)).isDomain
  refine IsAlgClosed.ringHom_bijective_of_isIntegral _ ?_
  have hiso : (Scheme.ΓSpecIso (.of k)).inv.hom.Finite :=
    RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2
  exact (hf.comp hiso).to_isIntegral

/-- **An effective principal divisor on a proper normal variety is zero**: if `div ψ ≥ 0` then
`ψ` is a global regular function, hence a nonzero constant. -/
private theorem principalDivisor_eq_zero_of_nonneg {k : Type} [Field k] [IsAlgClosed k]
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (sX : X ⟶ Spec (.of k)) [IsProper sX] (ψ : (RationalFunctions X)ˣ) (h : 0 ≤ principalDivisor ψ) :
    principalDivisor ψ = 0 := by
  have hsec : (0 : Divisor X).IsDivisorialSection ⊤
      (fun Z => (ψ : RationalFunctions X) Z.1) := by
    intro E hE
    refine Or.inr ?_
    change WithZero.exp (-(0 : Divisor X).coeff E) ≤
      E.valuation ((ψ : RationalFunctions X) E.component)
    rw [E.valuation_component, WithZero.exp_le_exp]
    have := h E
    simp only [Finsupp.coe_zero, Pi.zero_apply] at this
    rw [← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor] at this
    simpa using this
  obtain ⟨r, hr⟩ := hsec.exists_eq
  obtain ⟨c, rfl⟩ := (scalarsToGlobalSections_bijective sX).2 r
  have hc : c ≠ 0 := by
    rintro rfl
    obtain ⟨Z⟩ : Nonempty (irreducibleComponents X) :=
      ⟨⟨Set.univ, by rw [irreducibleComponents_eq_singleton]; rfl⟩⟩
    have := congrFun hr ⟨Z, by
      rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint]; trivial⟩
    rw [map_zero, map_zero] at this
    exact (ψ.isUnit.map (RationalFunctions.component (X := X) Z)).ne_zero this.symm
  refine Finsupp.ext fun E => ?_
  have hu : IsUnit (X.presheaf.germ ⊤ E.genericPoint trivial (scalarsToGlobalSections k sX c)) :=
    ((IsUnit.mk0 c hc).map _).map _
  rw [Finsupp.coe_zero, Pi.zero_apply, ← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor]
  refine E.ord_eq_zero_of_isUnit hu ?_
  have := congrFun hr ⟨E.component, trivial⟩
  rw [toRationalFunctionsPresheaf_app_apply] at this
  rw [← this]
  exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf _ _ _

/-- `div(ψ^q) = q div ψ`. -/
private theorem principalDivisor_pow (ψ : (RationalFunctions X)ˣ) (q : ℕ) :
    principalDivisor (ψ ^ q) = q • principalDivisor ψ := by
  refine Finsupp.ext fun E => ?_
  rw [← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor, PrimeDivisor.ord_pow,
    Finsupp.smul_apply, ← DivisorWithCoeffs.coeff_apply, coeff_principalDivisor]

/-- **A positive multiple of an ample divisor is not principal** on a proper normal variety
carrying a prime divisor: a section of `𝒪_X(-P + qjH)` would give an effective principal divisor
`≥ P`. -/
private theorem nsmul_ne_principalDivisor {k : Type} [Field k] [IsAlgClosed k]
    {sX : X ⟶ Spec (.of k)} [IsProper sX] (hX : MMP.Mori.IsVariety k sX) {H : Divisor X}
    (hH : H.IsCartier) (hHa : H.IsAmple hH) (P : MMP.Mori.PrimeDivisor X) {j : ℕ} (hj : 0 < j)
    (ψ : (RationalFunctions X)ˣ) : j • H ≠ principalDivisor ψ := by
  classical
  intro hjH
  haveI : LocallyOfFiniteType sX := hX.toLocallyOfFiniteType
  obtain ⟨n₀, hn₀⟩ := exists_forall_generatingSections hX hH hHa (-Finsupp.single P 1)
  obtain ⟨σ, hσ⟩ := hn₀ (j * (n₀ + 1)) (by nlinarith) (by nlinarith)
  have hsm : genericPoint X ∈ smoothLocus sX := by
    rw [MMP.Mori.smoothLocus_eq_smoothLocus]
    exact sX.genericPoint_mem_smoothLocus_of_perfectField
  obtain ⟨W, hxW, φ, hφ⟩ := exists_isLocalEquation_of_mem_smoothLocus
    (-Finsupp.single P 1 + (j * (n₀ + 1)) • H) hsm
  obtain ⟨i, hi, -⟩ := exists_notMem_supp_zeroDivisor σ hφ hxW
  set u := (Divisor.isUnit_sectionToRationalFunctions hi).unit
  have hz : 0 ≤ principalDivisor u + (-Finsupp.single P 1 + (j * (n₀ + 1)) • H) :=
    Divisor.zeroDivisor_nonneg _ _ hi
  have hjq : (j * (n₀ + 1)) • H = principalDivisor (ψ ^ (n₀ + 1)) := by
    rw [principalDivisor_pow, ← hjH, ← mul_nsmul', mul_comm]
  rw [hjq] at hz
  have hge : 0 ≤ principalDivisor (u * ψ ^ (n₀ + 1)) := by
    rw [MMP.Mori.principalDivisor_mul]
    intro E
    have := hz E
    have hs : (0 : ℤ) ≤ (Finsupp.single P (1 : ℤ)) E := by
      rw [Finsupp.single_apply]; split_ifs <;> norm_num
    simp only [Finsupp.coe_add, Finsupp.coe_neg, Pi.add_apply, Pi.neg_apply,
      Finsupp.coe_zero, Pi.zero_apply] at this ⊢
    linarith
  have h0 := principalDivisor_eq_zero_of_nonneg sX _ hge
  rw [MMP.Mori.principalDivisor_mul] at h0
  have h0P := congrArg (fun D : Divisor X => D P) h0
  have hP := hz P
  simp only [Finsupp.coe_add, Finsupp.coe_neg, Pi.add_apply, Pi.neg_apply,
    Finsupp.coe_zero, Pi.zero_apply, Finsupp.single_eq_same] at hP h0P
  linarith

/-- **A free linear system with nonempty members**: for `D` not Cartier with `mD` Cartier there
are a Cartier divisor `A` and finitely many global sections of `𝒪_X(m(A - D))` without common
zero, such that every nonzero section of `𝒪_X(m(A - D))` has a nonzero divisor of zeros. -/
private theorem exists_isCartier_free {k : Type} [Field k] [IsAlgClosed k]
    (sX : X ⟶ Spec (.of k)) [AlgebraicGeometry.IsProjectiveVariety k sX] {D : Divisor X}
    {m : ℕ} [NeZero m] (hmD : (m • D).IsCartier) (hD : ¬ D.IsCartier) :
    ∃ (A : Divisor X) (_ : A.IsCartier) (N : ℕ)
      (s : Fin (N + 1) → (m • (A - D)).divisorialSubmodule ⊤),
      (∀ x : X, ∃ i, ∃ hi : s i ≠ 0, x ∉ ((m • (A - D)).zeroDivisor (s i) hi).supp) ∧
      ∀ (σ : (m • (A - D)).divisorialSubmodule ⊤) (hσ : σ ≠ 0),
        (m • (A - D)).zeroDivisor σ hσ ≠ 0 := by
  have hXv : AlgebraicGeometry.IsVariety k sX :=
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).toIsVariety
  haveI : IsProper sX := isProper_of_isProjectiveMorphism _
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).isProjective
  obtain ⟨H, hH, -, hHa⟩ := MMP.Mori.exists_isCartier_isEffective_isAmple sX
  have hD0 : D ≠ 0 := fun h => hD (h ▸ Divisor.isCartier_zero)
  obtain ⟨P, -⟩ := Finsupp.ne_iff.mp hD0
  obtain ⟨n₀, hn₀⟩ := exists_forall_generatingSections hXv hH hHa (-(m • D))
  have hm : 0 < m := Nat.pos_of_ne_zero (NeZero.ne m)
  have hL : ∀ n : ℕ, -(m • D) + (m * n) • H = m • (n • H - D) := fun n => by
    rw [nsmul_sub, smul_smul]
    abel
  have key : ∀ n : ℕ, n₀ ≤ m * n → 1 ≤ m * n →
      (¬ ∃ ψ, m • (n • H - D) = principalDivisor ψ) →
      ∃ (A : Divisor X) (_ : A.IsCartier) (N : ℕ)
        (s : Fin (N + 1) → (m • (A - D)).divisorialSubmodule ⊤),
        (∀ x : X, ∃ i, ∃ hi : s i ≠ 0, x ∉ ((m • (A - D)).zeroDivisor (s i) hi).supp) ∧
        ∀ (σ : (m • (A - D)).divisorialSubmodule ⊤) (hσ : σ ≠ 0),
          (m • (A - D)).zeroDivisor σ hσ ≠ 0 := by
    intro n h1 h2 hnp
    obtain ⟨σ, hσ⟩ : ∃ σ : (m • (n • H - D)).divisorialSheaf.GeneratingSections, Finite σ.I :=
      hL n ▸ hn₀ (m * n) h1 h2
    have hLc : (m • (n • H - D)).IsCartier := by
      rw [nsmul_sub]
      exact ((hH.nsmul n).nsmul m).sub hmD
    obtain ⟨N, t, ht⟩ := exists_free_of_generatingSections σ
    refine ⟨n • H, hH.nsmul n, N, t, fun x => ht x (hLc x), fun τ hτ h0 => hnp
      ⟨(Divisor.isUnit_sectionToRationalFunctions hτ).unit⁻¹, ?_⟩⟩
    rw [Divisor.zeroDivisor_eq] at h0
    rw [MMP.Mori.principalDivisor_inv]
    exact eq_neg_of_add_eq_zero_right h0
  by_cases h1 : ∃ ψ, m • ((n₀ + 1) • H - D) = principalDivisor ψ
  · by_cases h2 : ∃ ψ, m • ((n₀ + 2) • H - D) = principalDivisor ψ
    · exfalso
      obtain ⟨ψ₁, hψ₁⟩ := h1
      obtain ⟨ψ₂, hψ₂⟩ := h2
      refine nsmul_ne_principalDivisor hXv hH hHa P hm (ψ₂ * ψ₁⁻¹) ?_
      rw [MMP.Mori.principalDivisor_mul, MMP.Mori.principalDivisor_inv, ← hψ₁, ← hψ₂]
      rw [nsmul_sub, nsmul_sub, ← mul_nsmul', ← mul_nsmul']
      simp only [show n₀ + 2 = (n₀ + 1) + 1 by ring, mul_add, mul_one, add_nsmul]
      abel
    · exact key (n₀ + 2) (by nlinarith) (by nlinarith) h2
  · exact key (n₀ + 1) (by nlinarith) (by nlinarith) h1

end FreeSystem

section

variable {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of k)) [MMP.Mori.IsProjectiveVariety k sX]

/-- **Projective dlt perturbation** (Kollár–Mori 2.43): a projective dlt pair `(X, B)` admits an
effective `ℚ`-divisor `B₀` with `(X, B₀)` klt. -/
private theorem exists_isKltPair_of_isDltPair [CompactSpace X] {n : ℕ} {K : Divisor X} {B : QDivisor X}
    (hdlt : IsDltPair sX n K B) : ∃ B₀ : QDivisor X, IsKltPair sX n K B₀ ∧ 0 ≤ B₀ := by
  obtain ⟨H, hH, -, hHa⟩ := MMP.Mori.exists_isCartier_isEffective_isAmple sX
  have hqp : AlgebraicGeometry.IsQuasiProjective sX := isQuasiProjective_of_isProjective
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).isProjective.isProjective
  have hBe : B.IsEffective := fun P => (hdlt.2.1 P).1
  obtain ⟨m, m', hm, hm', D, hD, -, ε₀, hε₀, hklt⟩ :=
    hdlt.exists_forall_isKltPair_sub_smul_add_smul hqp hH hHa hBe
      (by rw [sub_self]; exact DivisorWithCoeffs.isEffective_zero) rfl
  set ε : ℚ := min (ε₀ / 2) (1 / 2) with hε
  have hε0 : 0 < ε := lt_min (by linarith) (by norm_num)
  have hε1 : ε ≤ 1 / 2 := min_le_right _ _
  refine ⟨B - ε • B + ε • D, hklt ε hε0 (lt_of_le_of_lt (min_le_left _ _) (by linarith)), ?_⟩
  rw [← DivisorWithCoeffs.isEffective_iff_nonneg]
  intro P
  have h1 := hBe P
  have h2 := hD P
  simp only [DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_sub,
    DivisorWithCoeffs.coeff_smul, smul_eq_mul]
  nlinarith

/-- **A general member of a free linear system** (Kollár–Mori 5.17, 5.19): a general
`G = div φ + mM` of a free system of `𝒪_X(mM)` with nonempty members is reduced, keeps
`(X, B₀ + (1 - 1/m)G)` klt and gives a cyclic cover which is a normal variety. -/
private theorem exists_generalMember [CompactSpace X] {n : ℕ} {K : Divisor X}
    {B₀ : QDivisor X} (hklt : IsKltPair sX n K B₀) (hB₀ : 0 ≤ B₀) {m : ℕ} [NeZero m]
    (M : Divisor X) (hmM : (m • M).IsCartier) {N : ℕ}
    (s : Fin (N + 1) → (m • M).divisorialSubmodule ⊤)
    (hfree : ∀ x : X, ∃ i, ∃ hi : s i ≠ 0, x ∉ ((m • M).zeroDivisor (s i) hi).supp)
    (hnz : ∀ (σ : (m • M).divisorialSubmodule ⊤) (hσ : σ ≠ 0), (m • M).zeroDivisor σ hσ ≠ 0)
    (hdim : 1 ≤ topologicalKrullDim X) :
    ∃ (φ : (RationalFunctions X)ˣ) (hφ : 0 ≤ principalDivisor φ + m • M),
      (∀ E, (principalDivisor φ + m • M).coeff E ≤ 1) ∧
      IsKltPair sX n K
        (B₀ + ((1 : ℚ) - 1 / m) • Divisor.toQDivisor (principalDivisor φ + m • M)) ∧
      IsNormalVariety k (toBase m M hφ ≫ sX) := by
  have hXv : AlgebraicGeometry.IsVariety k sX :=
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).toIsVariety
  obtain ⟨Y, g, hg⟩ := MMP.Mori.exists_isLogResolution sX hklt.1.1 (QDivisor.toRDivisor B₀)
  exact KltTest5d.exists_generalMember_of_isLogResolution sX hXv hklt hB₀ hg M hmM s hfree hnz hdim

/-- On an integral normal scheme every prime divisor `E` has a uniformizer: a rational function
`t` with `ord_E t = 1`. -/
private theorem exists_ord_genericPoint_eq_one {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] (E : MMP.Mori.PrimeDivisor X) :
    ∃ t : X.functionField, X.ord t E.genericPoint = 1 := by
  have := E.isDiscreteValuationRing_localRing
  have h1 := E.coheight_genericPoint
  have : Ring.KrullDimLE 1 E.localRing := krullDimLE_of_coheight_le h1.le
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible E.localRing
  have hne : algebraMap E.localRing X.functionField ϖ ≠ 0 :=
    (IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero))
  refine ⟨algebraMap E.localRing X.functionField ϖ, ?_⟩
  rw [Scheme.ord_eq_iff h1 hne]
  exact Ring.ordFrac_irreducible hϖ

include sX in
/-- `m` is invertible in every stalk of a scheme over a field of characteristic zero. -/
private theorem isUnit_natCast_stalk (m : ℕ) [NeZero m] (x : X) :
    IsUnit (m : X.presheaf.stalk x) := by
  let ψ : k →+* X.presheaf.stalk x :=
    ((X.presheaf.germ ⊤ x trivial).hom.comp sX.appTop.hom).comp (Scheme.ΓSpecIso (.of k)).inv.hom
  have : (m : X.presheaf.stalk x) = ψ (m : k) := by simp
  rw [this]
  exact (IsUnit.mk0 (m : k) (Nat.cast_ne_zero.mpr (NeZero.ne m))).map ψ

/-- **The cyclic cover of a klt branch is klt** (Kollár–Mori 5.20): if `G = div φ + mM` is
reduced and `(X, B₀ + (1 - 1/m)G)` is klt, the normal cyclic cover `p : Y ⟶ X` carries an
effective boundary `Δ_Y` with `K_Y + Δ_Y = p^*(K_X + B₀ + (1 - 1/m)G)` and `(Y, Δ_Y)` klt. -/
private theorem exists_isKltPair_cover [CompactSpace X] {n : ℕ} {K : Divisor X}
    {B₀ : QDivisor X} (hB₀ : 0 ≤ B₀) {m : ℕ} [NeZero m] (M : Divisor X)
    (hmM : (m • M).IsCartier) {φ : (RationalFunctions X)ˣ}
    (hφ : 0 ≤ principalDivisor φ + m • M) (h1 : ∀ E, (principalDivisor φ + m • M).coeff E ≤ 1)
    (hklt : IsKltPair sX n K
      (B₀ + ((1 : ℚ) - 1 / m) • Divisor.toQDivisor (principalDivisor φ + m • M)))
    (hY : IsNormalVariety k (toBase m M hφ ≫ sX)) [IsIntegral (cover m M hφ)]
    [IsLocallyNoetherian (cover m M hφ)] [IsNormal (cover m M hφ)] :
    ∃ (KY : Divisor (cover m M hφ)) (ΔY : QDivisor (cover m M hφ)),
      IsKltPair (toBase m M hφ ≫ sX) n KY ΔY ∧ 0 ≤ ΔY := by
  classical
  set p := toBase m M hφ with hp
  set G := principalDivisor φ + m • M with hG
  set BX : QDivisor X := B₀ + ((1 : ℚ) - 1 / m) • Divisor.toQDivisor G with hBX
  haveI hfin : IsFinite p := MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.isFinite_toBase m M hφ
  haveI : Surjective p := KltCover5d.surjective_toBase m M hφ
  haveI : IsDominant p := inferInstance
  obtain ⟨⟨hXv, hK, hQ⟩, hdisc, hfl⟩ := hklt
  haveI : LocallyOfFiniteType sX := hXv.1.toLocallyOfFiniteType
  haveI : LocallyOfFiniteType (p ≫ sX) := hY.1.toLocallyOfFiniteType
  haveI : CompactSpace (cover m M hφ) := by
    have := hY.1
    exact QuasiCompact.compactSpace_of_compactSpace (p ≫ sX)
  have hdimX : topologicalKrullDim X = n := hK.topologicalKrullDim_eq
  have hdimY : topologicalKrullDim (cover m M hφ) = n :=
    (MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback.topologicalKrullDim_eq_of_isFinite sX p).trans
      hdimX
  obtain ⟨ω, hω0, hωK⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hXv hK
  set ωY := pullbackRationalPluriForms sX p ω with hωY
  have hωY0 : ωY ≠ 0 := by
    letI := functionFieldAlgebra sX
    letI := functionFieldAlgebra (p ≫ sX)
    letI := functionFieldMapAlgebra p
    haveI := isScalarTower_functionFieldMap sX p
    obtain ⟨ωg, hωg⟩ := exists_isPullbackGenerator_of_topologicalKrullDim_eq sX p hdimX hdimY
    exact MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback.pullbackForms_ne_zero hωg hω0
  set KY := divisorOfForm ωY with hKYdef
  have hKY : KY.IsCanonicalDivisor (p ≫ sX) n := by
    obtain ⟨KS, hKS⟩ :=
      MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback.exists_isCanonicalDivisor (p ≫ sX) hY hdimY
    have h := MMP.Positivity.linearlyEquivalent_divisorOfForm_zsmul hY hKS (m := 1) hωY0
    rw [one_smul] at h
    exact hKS.of_linearlyEquivalent h
  have hsupp : ∀ Z : irreducibleComponents (cover m M hφ),
      p (componentGenericPoint (cover m M hφ) Z) ∉ (Divisor.toQDivisor K + BX).supp := by
    intro Z
    rw [MMP.Fourfold.componentGenericPoint_eq_genericPoint, map_genericPoint_of_isDominant]
    exact MMP.Fourfold.genericPoint_notMem_supp _
  set Pull := (Divisor.toQDivisor K + BX).pullback hQ hsupp with hPulldef
  have hPull := QDivisor.isPullback_pullback hQ hsupp
  set ΔY : QDivisor (cover m M hφ) := Pull - Divisor.toQDivisor KY with hΔYdef
  have hpullY : (Divisor.toQDivisor K + BX).IsPullback p hsupp (Divisor.toQDivisor KY + ΔY) := by
    rw [hΔYdef, add_sub_cancel]
    exact hPull
  have hPullQ : Pull.IsQCartier := hPull.isQCartier hQ
  have hm1 : (0 : ℚ) ≤ 1 - 1 / m := by
    have : (1 : ℚ) ≤ m := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne m)
    rw [sub_nonneg]
    exact div_le_one_of_le₀ this (by positivity)
  have hBX0 : 0 ≤ BX := fun P => by
    have h1 : (0 : ℚ) ≤ B₀.coeff P := hB₀ P
    have h2 : (0 : ℤ) ≤ G.coeff P := hφ P
    have h3 : (0 : ℚ) ≤ (Divisor.toQDivisor G).coeff P := by
      rw [Divisor.coeff_toQDivisor]
      exact_mod_cast h2
    simp only [hBX, DivisorWithCoeffs.coeff_add, DivisorWithCoeffs.coeff_smul, smul_eq_mul]
    exact add_nonneg h1 (mul_nonneg hm1 h3)
  have hΔ : 0 ≤ ΔY := by
    intro E'
    set y := E'.genericPoint with hy
    have hcoh : Order.coheight (p y) = 1 := by
      rw [MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback.coheight_map_eq_of_isFinite sX p y]
      exact E'.coheight_genericPoint
    set E : MMP.Mori.PrimeDivisor X := AlgebraicGeometry.PrimeDivisor.ofCoheightOne (p y) hcoh
    have hEE' : p y = E.genericPoint :=
      (AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _).symm
    obtain ⟨t, ht⟩ := exists_ord_genericPoint_eq_one E
    have ht0 : t ≠ 0 := by
      rintro rfl
      simp at ht
    set e := (cover m M hφ).ord (functionFieldMap p t) y with he
    have he0 : 0 ≤ e :=
      KltCover5d.ord_functionFieldMap_nonneg p E E' hEE' ht0 (by rw [ht]; exact zero_le_one)
    -- the coefficient of the pull-back
    have hPullE : Pull.coeff E' = e * (Divisor.toQDivisor K + BX).coeff E := by
      obtain ⟨D₀, hD₀, hD₀c⟩ := QDivisor.isCartierDivisor_cartierIndex_smul hQ
      have hm₀ := QDivisor.cartierIndex_pos hQ
      obtain ⟨D', hD', hD'p⟩ := hPull _ hm₀ D₀ hD₀ hD₀c
      obtain ⟨V, hV, ψ, hψ⟩ := hD₀c (p y)
      have h1 := MMP.Threefold.Bridges.coeff_isPullback_eq_ord_evalFF hD'p hψ E' hV E.component
      have hne : MMP.Threefold.Mori.Helpers.evalFF E.component (ψ : RationalFunctions X) ≠ 0 :=
        (ψ.isUnit.map _).ne_zero
      rw [KltCover5d.ord_functionFieldMap_eq_mul p E E' hEE' ht hne] at h1
      have h2 : X.ord (MMP.Threefold.Mori.Helpers.evalFF E.component (ψ : RationalFunctions X))
          E.genericPoint = D₀.coeff E := by
        rw [← MMP.Threefold.Mori.Helpers.ord_eq_scheme_ord,
          hψ E ((E.genericPoint_mem_iff V).mp (hEE' ▸ hV))]
      rw [h2] at h1
      have h3 := congrArg (fun F => F.coeff E') hD'
      have h4 := congrArg (fun F => F.coeff E) hD₀
      simp only [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, zsmul_eq_mul] at h3 h4
      have hm₀q : ((QDivisor.cartierIndex _ hQ : ℕ) : ℚ) ≠ 0 := by exact_mod_cast hm₀.ne'
      apply mul_left_cancel₀ hm₀q
      push_cast at h3 h4
      rw [← h3, h1]
      push_cast
      rw [h4]
      ring
    -- the coefficient of `K_Y`, by the tame formula
    have hKYE : ((KY.coeff E' : ℤ) : ℚ) = e * K.coeff E + (e - 1) := by
      have h := MMP.Mori.ordForm_pullbackRationalPluriForms_of_finite sX p hXv hY hdimX hdimY E E'
        hEE' ht (m := 1) hω0
      rw [coeff_divisorOfForm, h, hωK E]
      push_cast
      ring
    -- the ramification of `p` along `E'`
    obtain ⟨W, hW, g, hg⟩ :=
      MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.DltPerturbation.exists_isLocalEquation_of_mem_smoothLocus (s := sX) M
        (MMP.Positivity.PrimeDivisor.genericPoint_mem_smoothLocus hXv E)
    obtain ⟨_, ⟨U, hU, rfl⟩, hEU, hUW⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open hW W.isOpen
    obtain ⟨hA, hB⟩ := KltCover5d.ord_functionFieldMap_toBase m M hφ
      (isUnit_natCast_stalk sX m) E' E hEE' hU hEU (hg.mono hUW) ht
    have hΔE : ΔY.coeff E' = Pull.coeff E' - (KY.coeff E' : ℚ) := by
      rw [hΔYdef, DivisorWithCoeffs.coeff_sub, Divisor.coeff_toQDivisor]
    have hBXE : BX.coeff E = B₀.coeff E + (1 - 1 / m) * (G.coeff E : ℚ) := by
      simp [hBX]
    have hB₀E : (0 : ℚ) ≤ B₀.coeff E := hB₀ E
    have hG0 : 0 ≤ G.coeff E := hφ E
    have hG1 : G.coeff E ≤ 1 := h1 E
    change (0 : ℚ) ≤ ΔY.coeff E'
    rw [hΔE, hPullE, hKYE, DivisorWithCoeffs.coeff_add, Divisor.coeff_toQDivisor, hBXE]
    rcases (show G.coeff E = 0 ∨ G.coeff E = 1 by omega) with hG | hG
    · have he1 : e = 1 := hA hG
      rw [he1, hG]
      push_cast
      linarith
    · have hem : e ≤ m := hB hG
      rw [hG]
      have hm0 : (0 : ℚ) < m := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne m)
      have hem' : (e : ℚ) ≤ m := by exact_mod_cast hem
      have he0' : (0 : ℚ) ≤ e := by exact_mod_cast he0
      have : (e : ℚ) * B₀.coeff E + 1 - e / m ≥ 0 := by
        have h2 : (e : ℚ) / m ≤ 1 := (div_le_one hm0).mpr hem'
        nlinarith [mul_nonneg he0' hB₀E]
      push_cast
      field_simp
      field_simp at this
      linarith
  have hpairY : MMP.Mori.IsPair (p ≫ sX) ΔY :=
    ⟨hY, n, KY, hKY, by rw [hΔYdef, add_sub_cancel]; exact hPullQ⟩
  have hFpairY : MMP.Fourfold.IsPair (p ≫ sX) ΔY := ⟨inferInstance, inferInstance, hpairY, hΔ⟩
  have hpairX : MMP.Mori.IsPair sX BX := ⟨hXv, n, K, hK, hQ⟩
  have hFpairX : MMP.Fourfold.IsPair sX BX := ⟨inferInstance, inferInstance, hpairX, hBX0⟩
  have hFX : MMP.Fourfold.IsKltPair sX BX :=
    (MMP.Fourfold.isKltPair_iff_mori_isKltPair sX hK hFpairX).mpr ⟨⟨hXv, hK, hQ⟩, hdisc, hfl⟩
  have hFY : MMP.Fourfold.IsKltPair (p ≫ sX) ΔY := by
    refine ⟨hFpairY, fun n' D' a' ha' => ?_⟩
    have hn' : n' = n := by
      have := (MMP.Threefold.Bridges.IsLogDiscrepancy.topologicalKrullDim_eq ha').symm.trans hdimY
      exact_mod_cast this
    rw [hn'] at ha'
    have hD'p : IsProper D'.f := ha'.2.1
    obtain ⟨v, ⟨D, hDp, rfl⟩, e, he0, he⟩ :=
      MMP.Fourfold.exists_isNormalizedDivisorialValuation_comap_eq_pow k sX p hXv.1 hY.1
        D'.valuation ⟨D', hD'p, rfl⟩
    obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hpairX hK D
    have ha := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc hDp
    have hpos : 0 < 1 + (c : ℝ) := hFX.2 n D _ ha
    have hY' :=
      MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.FiniteLogPullback.isLogDiscrepancy_mul_of_isFinite sX p hY hω0
      (fun Γ => (hωK Γ).symm) (KY := KY) (fun Γ => rfl) hQ ⟨hsupp, hpullY⟩ hD'p he ha
    rw [MMP.Threefold.Bridges.IsLogDiscrepancy.eq_of_valuation_eq ha' hY' rfl]
    have : (0 : ℝ) < e := by exact_mod_cast he0
    positivity
  exact ⟨KY, ΔY, (MMP.Fourfold.isKltPair_iff_mori_isKltPair (p ≫ sX) hKY hFpairY).mp hFY, hΔ⟩

/-- **The general cyclic cover**: on a projective klt pair `(X, B₀)` with `B₀ ≥ 0`, for `m ≥ 2`
with `mD` Cartier and `D` not Cartier, there are a Cartier divisor `A` and `φ ∈ K(X)^×` with
`G = div φ + m(A - D) ≥ 0` whose cyclic cover `p : Y ⟶ X` is a normal variety carrying an
effective klt boundary. -/
private theorem exists_cover_isKltPair [CompactSpace X] {n : ℕ} {K : Divisor X} {B₀ : QDivisor X}
    (hklt : IsKltPair sX n K B₀) (hB₀ : 0 ≤ B₀) {D : Divisor X} {m : ℕ} [NeZero m]
    (hmD : (m • D).IsCartier) (hD : ¬ D.IsCartier) :
    ∃ (A : Divisor X) (_ : A.IsCartier) (φ : (RationalFunctions X)ˣ)
      (hφ : 0 ≤ principalDivisor φ + m • (A - D)),
      IsNormalVariety k (toBase m (A - D) hφ ≫ sX) ∧
      ∀ [IsIntegral (cover m (A - D) hφ)] [IsLocallyNoetherian (cover m (A - D) hφ)]
        [IsNormal (cover m (A - D) hφ)],
        ∃ (KY : Divisor (cover m (A - D) hφ)) (ΔY : QDivisor (cover m (A - D) hφ)),
          IsKltPair (toBase m (A - D) hφ ≫ sX) n KY ΔY ∧ 0 ≤ ΔY := by
  obtain ⟨A, hA, N, s, hfree, hnz⟩ := exists_isCartier_free sX (m := m) hmD hD
  have hmM : (m • (A - D)).IsCartier := by
    rw [nsmul_sub]
    exact (hA.nsmul m).sub hmD
  have hdim : 1 ≤ topologicalKrullDim X := by
    have hD0 : D ≠ 0 := fun h => hD (h ▸ Divisor.isCartier_zero)
    obtain ⟨P, -⟩ := Finsupp.ne_iff.mp hD0
    exact one_le_topologicalKrullDim_of_specializes_of_ne
      ((genericPoint_spec X).specializes (Set.mem_univ P.genericPoint))
      (primeDivisor_genericPoint_ne P).symm
  obtain ⟨φ, hφ, h1, hkltG, hYn⟩ := exists_generalMember sX hklt hB₀ (A - D) hmM s hfree hnz hdim
  exact ⟨A, hA, φ, hφ, hYn, exists_isKltPair_cover sX hB₀ (A - D) hmM hφ h1 hkltG hYn⟩

/-- **The cyclic cover step**: on a projective klt pair `(X, B₀)` with `B₀ ≥ 0`, a divisor `D`
with `mD` Cartier, `m > 0`, has a Cartier divisor `A` with `𝒪_X(D - A)` Cohen–Macaulay. -/
private theorem exists_isCartier_isCMSheaf_sub [CompactSpace X] {n : ℕ} {K : Divisor X}
    {B₀ : QDivisor X} (hklt : IsKltPair sX n K B₀) (hB₀ : 0 ≤ B₀) {D : Divisor X} {m : ℕ}
    (hm : 0 < m) (hmD : (m • D).IsCartier) :
    ∃ A : Divisor X, A.IsCartier ∧ IsCMSheaf (D - A).divisorialSheaf := by
  have hXv : AlgebraicGeometry.IsVariety k sX :=
    (inferInstance : AlgebraicGeometry.IsProjectiveVariety k sX).toIsVariety
  haveI : LocallyOfFiniteType sX := hXv.toLocallyOfFiniteType
  -- replace `m` by `2m ≥ 2`, so that the cover has a summand of degree one
  haveI : NeZero (2 * m) := ⟨by omega⟩
  have hmD' : ((2 * m) • D).IsCartier := by
    rw [mul_nsmul']
    exact hmD.nsmul 2
  by_cases hDc : D.IsCartier
  · refine ⟨D, hDc, ?_⟩
    have hCM := isCMScheme_of_isKltPair sX hklt hB₀
    rw [sub_self]
    intro x
    exact isCMModule_of_linearEquiv
      (stalkLinearEquiv _ _ (Divisor.divisorialSheafZeroIso (X := X)).inv x) (hCM x)
  obtain ⟨A, hA, φ, hφ, hYn, hY⟩ := exists_cover_isKltPair sX hklt hB₀ hmD' hDc
  refine ⟨A, hA, ?_⟩
  haveI : IsIntegral (cover (2 * m) (A - D) hφ) := hYn.1.toIsIntegral
  haveI : LocallyOfFiniteType (toBase (2 * m) (A - D) hφ ≫ sX) := hYn.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian (cover (2 * m) (A - D) hφ) :=
    LocallyOfFiniteType.isLocallyNoetherian (toBase (2 * m) (A - D) hφ ≫ sX)
  haveI : IsNormal (cover (2 * m) (A - D) hφ) := hYn.2
  obtain ⟨KY, ΔY, hkltY, hΔY⟩ := hY
  haveI := isFinite_toBase (2 * m) (A - D) hφ
  haveI : MMP.Mori.IsProjectiveVariety k (toBase (2 * m) (A - D) hφ ≫ sX) :=
    isProjectiveVariety_comp_of_isFinite sX _ hYn.1
  have hCM := isCMScheme_of_isKltPair (toBase (2 * m) (A - D) hφ ≫ sX) hkltY hΔY
  have h := isCMSheaf_of_isCMScheme_cover sX (2 * m) (A - D) hφ ⟨1, by omega⟩
    hkltY.1.2.1.topologicalKrullDim_eq hCM
  have he : ((⟨1, by omega⟩ : Fin (2 * m)) : ℕ) • -(A - D) = D - A := by
    rw [Fin.val_mk, one_nsmul, neg_sub]
  rwa [he] at h

end

end MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof

