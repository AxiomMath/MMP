section

public section

open CategoryTheory AlgebraicGeometry

namespace MMP.Mori

/-- Let `(X, B)` be a dlt pair, with `B` a `ℚ`-divisor and `K` a canonical divisor, on a variety
`X` projective over an algebraically closed field `k` of characteristic zero, and let `D` be a
divisor on `X` that is `ℚ`-Cartier. Then the divisorial sheaf `𝒪_X(D)` is Cohen–Macaulay. -/
@[mmp "lem_fourfold_projective_dlt_divisorial_cm"]
public theorem isCMSheaf_divisorialSheaf_of_isDltPair {k : Type} [Field k] [IsAlgClosed k]
    [CharZero k] {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X]
    (sX : X ⟶ Spec (.of k)) [IsProjectiveVariety k sX] {n : ℕ} {K : Divisor X} {B : QDivisor X}
    (hdlt : IsDltPair sX n K B) {D : Divisor X} (hD : (Divisor.toQDivisor D).IsQCartier) :
    IsCMSheaf D.divisorialSheaf := by
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  obtain ⟨B₀, hklt, hB₀⟩ :=
    MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.exists_isKltPair_of_isDltPair sX hdlt
  obtain ⟨m, hm, hmD⟩ := hD.exists_pos
  have hmD' : (m • D).IsCartier := by
    rw [← QDivisor.isCartierDivisor_toQDivisor]
    simpa [map_nsmul, natCast_zsmul] using hmD
  obtain ⟨A, hA, hCM⟩ :=
    MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.exists_isCartier_isCMSheaf_sub sX hklt
      hB₀ hm hmD'
  simpa using
    MMP.FourfoldProofs.FourfoldProjectiveDltDivisorialCmProof.isCMSheaf_divisorialSheaf_add_of_isCartier
      hA hCM

end MMP.Mori

end

