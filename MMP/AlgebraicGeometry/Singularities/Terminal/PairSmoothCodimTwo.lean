/-!
# Terminal pairs have terminal underlying varieties, smooth in codimension two

Let `(X, B)` be a terminal pair over an algebraically closed field of characteristic zero whose
boundary `B` is a `ℚ`-Cartier `ℚ`-divisor, and suppose `K_X` is `ℚ`-Cartier. The boundary of a
pair is effective, so pulling back `B` to any exceptional divisor `E` over `X` gives
`a(E; X, 0) = a(E; X, B) + ord_E B ≥ a(E; X, B) > 1`, and `X` itself is terminal; a terminal
variety is smooth in codimension two (Kollár–Mori, Corollary 5.18), that is, its singular locus
has codimension at least three.

## Main results

* `MMP.Fourfold.IsKltTerminalPair.isTerminalVariety_and_three_le_closedsCodimension_singularLocus`:
  `X` is terminal and `codim_X Sing X ≥ 3`.

## Implementation notes

The effectivity of `B` is part of `MMP.Fourfold.IsPair`, and hence of
`MMP.Fourfold.IsKltTerminalPair`, so it is not a separate hypothesis. It is needed: for a
surface `X` with an `A₁` point and `D` an effective Cartier divisor through it, all discrepancies
of `(X, -D)` exceed those of `X`, while `X` is singular in codimension two.

## References

* [J. Kollár, S. Mori, *Birational geometry of algebraic varieties*][KollarMori], Corollary 5.18
-/

open CategoryTheory AlgebraicGeometry TopologicalSpace

universe u

namespace MMP.Fourfold.TerminalSmoothCodimTwo

open MMP.Mori

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}} [IsIntegral X]
  [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)}

/-- Adding an effective `ℚ`-Cartier boundary lowers log discrepancies: a log discrepancy `a` of a
divisor `D` over `(X, 0)` bounds above a log discrepancy of `D` over `(X, B)`. -/
private theorem exists_isLogDiscrepancy_le {B : QDivisor X} (hBe : B.IsEffective)
    (hB : B.IsQCartier) (hP : MMP.Mori.IsPair sX 0) {n : ℕ} {D : DivisorOver k sX} {a : ℝ}
    (ha : MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor 0) D a) :
    ∃ a' : ℝ, a' ≤ a ∧
      MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B) D a' := by
  obtain ⟨-, hf, -, -, ⟨K, hK, -⟩, -⟩ := id ha
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hP hK D
  obtain ⟨c', hle, hc'⟩ := MMP.Threefold.Mori.Helpers.exists_isDiscrepancy_add_le hBe hB hc
  rw [zero_add] at hc'
  refine ⟨1 + (c' : ℝ), ?_,
    MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc' hf⟩
  rw [MMP.Threefold.Bridges.eq_one_add_of_isDiscrepancy_of_isLogDiscrepancy hc ha]
  gcongr

/-- The underlying variety of a terminal pair with effective `ℚ`-Cartier boundary, and `K_X`
`ℚ`-Cartier, is terminal. -/
private theorem isTerminalVariety_of_isKltTerminalPair {B : QDivisor X}
    (h : IsKltTerminalPair sX B) (hB : B.IsQCartier) {n : ℕ} {K : Divisor X}
    (hK : K.IsCanonicalDivisor sX n) (hKQ : (Divisor.toQDivisor K).IsQCartier) :
    IsTerminalVariety sX := by
  have hBe : B.IsEffective := h.1.1.nonneg
  have hP : MMP.Mori.IsPair sX 0 := ⟨h.1.1.isPair.1, n, K, hK, by rwa [add_zero]⟩
  refine ⟨⟨⟨h.1.1.isAlgClosed, h.1.1.charZero, hP, fun _ => le_rfl⟩,
    fun m D a ha => ?_⟩, fun m E a hE ha => ?_⟩
  · obtain ⟨a', hle, ha'⟩ := exists_isLogDiscrepancy_le hBe hB hP ha
    exact (h.1.2 m D a' ha').trans_le hle
  · obtain ⟨a', hle, ha'⟩ := exists_isLogDiscrepancy_le hBe hB hP ha
    exact (h.2 m E a' hE ha').trans_le hle

/-! ### Exceptional divisors on proper models -/

omit [IsAlgClosed k] [CharZero k] in
/-- A divisor `(Y, f, E)` over a normal variety `X` is exceptional exactly when its center has
codimension at least two. -/
private theorem isExceptional_iff_two_le_codimension_center (hX : IsNormalVariety k sX)
    (D : DivisorOver k sX) : D.IsExceptional ↔ 2 ≤ codimension D.center := by
  haveI := D.isLocallyNoetherian
  haveI := D.isNormal
  haveI : IsSeparated sX := hX.1.toIsSeparated
  have hsep : IsSeparated (X ↘ ⊤_ Scheme) := by
    have : (X ↘ ⊤_ Scheme) = sX ≫ Limits.terminal.from (Spec (.of k)) := Subsingleton.elim _ _
    rw [this]
    infer_instance
  unfold DivisorOver.IsExceptional
  rw [MMP.Positivity.isExceptional_toRationalMap_iff]
  have hc : Closeds.closure (D.f '' (D.E.idealSheaf.support : Set D.Y)) =
      ⟨(D.center : Set X), D.center.isClosed⟩ := by
    refine Closeds.ext ?_
    rw [Closeds.coe_closure]
    exact D.coe_center.symm
  rw [hc]
  change 2 ≤ closedsCodimension (T := X) ⟨(D.center : Set X), D.center.isClosed⟩ ↔ _
  rw [closedsCodimension_coe]

omit [IsAlgClosed k] [CharZero k] in
/-- The normalization of `P` in a normal integral locally Noetherian scheme `Y`, along a
quasi-compact open immersion `j : Y ⟶ P` with `P` locally of finite type over a field, is normal
and finite over `P`, and `Y` is open in it. -/
private theorem isOpenImmersion_toNormalization_and_isNormal_and_isFinite {Y P : Scheme.{u}}
    {sP : P ⟶ Spec (.of k)} [LocallyOfFiniteType sP] (j : Y ⟶ P) [IsOpenImmersion j]
    [QuasiCompact j] [QuasiSeparated j] [IsNormal Y] [IsLocallyNoetherian Y] :
    IsOpenImmersion (Scheme.Hom.toNormalization j) ∧
      IsNormal (Scheme.Hom.normalization j) ∧ IsFinite (Scheme.Hom.fromNormalization j) := by
  refine ⟨?_, AlgebraicGeometry.isNormal_normalization j fun V hV => ?_,
    isFinite_fromNormalization_of_locallyOfFiniteType j
    (isNagataScheme_of_locallyOfFiniteType_over_field k sP)⟩
  · have : IsOpenImmersion ((Limits.pullback.snd j j).toNormalization ≫ j.normalizationPullback j ≫
        Limits.pullback.fst _ _) := inferInstance
    rw [Scheme.Hom.toNormalization_normalizationPullback_fst j j] at this
    exact (MorphismProperty.cancel_left_of_respectsIso @IsOpenImmersion
      (Limits.pullback.fst j j) _).mp this
  · have : IsNoetherian V :=
      { toIsLocallyNoetherian := inferInstance
        toCompactSpace := isCompact_iff_compactSpace.mp hV }
    exact NoetherianSpace.finite_irreducibleComponents

/-- If `t ≫ g` is birational and `t` is an open immersion of integral schemes, `g` is
birational. -/
private theorem isBirationalMorphism_of_isOpenImmersion_comp {Y P Z : Scheme.{u}} [IsIntegral Y]
    [IsIntegral P] [IsIntegral Z] (t : Y ⟶ P) [IsOpenImmersion t] (g : P ⟶ Z)
    (h : IsBirationalMorphism (t ≫ g)) : IsBirationalMorphism g := by
  obtain ⟨W, ⟨w, hw⟩, hWo⟩ := h.exists_isOpenImmersion
  let U : P.Opens := t ''ᵁ W
  let V : Z.Opens := (W.ι ≫ t ≫ g).opensRange
  have hUV : U ≤ g ⁻¹ᵁ V := by
    rintro _ ⟨w, hw, rfl⟩
    exact ⟨⟨w, hw⟩, rfl⟩
  have hc : g.resLE V U hUV ≫ V.ι = (t.isoImage W).inv ≫ W.ι ≫ t ≫ g := by
    rw [Scheme.Hom.resLE_comp_ι, ← Scheme.Hom.isoImage_inv_ι_assoc]
  have : IsOpenImmersion (g.resLE V U hUV ≫ V.ι) := by
    rw [hc]
    infer_instance
  have : IsOpenImmersion (g.resLE V U hUV) := IsOpenImmersion.of_comp _ V.ι
  refine MMP.Flips.isBirationalMorphism_of_isIso_resLE g U V ⟨t w, w, hw, rfl⟩ ⟨_, ⟨w, hw⟩, rfl⟩
    hUV ?_
  rw [isIso_iff_isOpenImmersion_and_surjective]
  refine ⟨inferInstance, ⟨fun ⟨z, hz⟩ => ?_⟩⟩
  obtain ⟨w, rfl⟩ := hz
  refine ⟨(t.isoImage W).hom w, ?_⟩
  apply V.ι.isOpenEmbedding.injective
  rw [← Scheme.Hom.comp_apply, hc, ← Scheme.Hom.comp_apply, Iso.hom_inv_id_assoc]
  rfl

omit [IsAlgClosed k] [CharZero k] in
/-- **KM 2.22 for `g = 𝟙`.** Every divisor `(Y, f, E)` over a normal variety `X` has the
valuation of a divisor over `X` with `f` proper. -/
private theorem exists_properDivisorOver_valuation_eq (hX : IsNormalVariety k sX)
    (D : DivisorOver k sX) :
    ∃ E : MMP.Flips.ProperDivisorOver k sX, E.valuation = D.valuation := by
  have := D.isIntegral
  have := D.isNormal
  have := D.isLocallyNoetherian
  have hYv := D.isNormalVariety.1
  have hXv := hX.1
  have : IsSeparated sX := hXv.toIsSeparated
  have : IsSeparated (D.f ≫ sX) := hYv.toIsSeparated
  have : LocallyOfFiniteType (D.f ≫ sX) := hYv.toLocallyOfFiniteType
  have : QuasiCompact (D.f ≫ sX) := hYv.toQuasiCompact
  have : IsSeparated D.f := IsSeparated.of_comp D.f sX
  have : LocallyOfFiniteType D.f := locallyOfFiniteType_of_comp D.f sX
  have : QuasiCompact D.f := QuasiCompact.of_comp D.f sX
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated sX
  obtain ⟨c, hjq⟩ := hasCompactification_of_compactSpace_quasiSeparatedSpace D.f
  obtain ⟨P, j, p, hj, hjq, hp, hjp⟩ : ∃ (P : Scheme.{u}) (j : D.Y ⟶ P) (p : P ⟶ X),
      IsOpenImmersion j ∧ QuasiCompact j ∧ IsProper p ∧ j ≫ p = D.f :=
    ⟨c.space, c.immersion, c.toBase, inferInstance, hjq, inferInstance, Over.w c.obj.hom⟩
  have : IsSeparated j := by
    have : IsSeparated (j ≫ p) := by
      rw [hjp]
      infer_instance
    exact IsSeparated.of_comp j p
  have : LocallyOfFiniteType (p ≫ sX) := inferInstance
  have : QuasiSeparated j := IsSeparated.instQuasiSeparated j
  obtain ⟨ht, hnorm, hfin⟩ :=
    isOpenImmersion_toNormalization_and_isNormal_and_isFinite (sP := p ≫ sX) j
  set t := j.toNormalization
  let g := j.fromNormalization ≫ p
  have htg : t ≫ g = D.f := by
    simp only [g, t, Scheme.Hom.toNormalization_fromNormalization_assoc, hjp]
  have hgv : IsNormalVariety k (g ≫ sX) :=
    ⟨(isVariety_iff k _).2 ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩, hnorm⟩
  have hgb : IsBirationalMorphism g :=
    isBirationalMorphism_of_isOpenImmersion_comp t g (htg ▸ D.isBirationalMorphism)
  let D' : DivisorOver k sX :=
    ⟨_, g, hgv, hgb, OpenWeilRestriction.primeDivisorMap t D.E⟩
  refine ⟨⟨D', inferInstance⟩, (MMP.Positivity.DivisorOver.valuation_eq_of_iso D D' ⊤
    t.opensRange trivial ⟨D.E.genericPoint, ?_⟩ (D.Y.topIso ≪≫ t.isoOpensRange) ?_ ?_).symm⟩
  · exact (OpenWeilRestriction.genericPoint_primeDivisorMap t D.E).symm
  · simp [D', htg]
  · apply Subtype.ext
    change (D.Y.topIso.hom ≫ t.isoOpensRange.hom ≫ t.opensRange.ι) ⟨D.E.genericPoint, trivial⟩ = _
    rw [Scheme.Hom.isoOpensRange_hom_ι]
    exact (OpenWeilRestriction.genericPoint_primeDivisorMap t D.E).symm

/-- On a terminal variety every exceptional divisor over `X` has positive Kollár–Mori
discrepancy. -/
private theorem isDiscrepancy_pos_of_isTerminalVariety (h : IsTerminalVariety sX) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) (hKQ : (Divisor.toQDivisor K).IsQCartier)
    {D : DivisorOver k sX} (hD : D.IsExceptional) {a : ℚ}
    (ha : IsDiscrepancy sX n K 0 D a) : 0 < a := by
  have hX : IsNormalVariety k sX := h.1.1.isPair.1
  have hPw : IsPairWith sX n K 0 := ⟨hX, hK, by rwa [add_zero]⟩
  obtain ⟨E, hE⟩ := exists_properDivisorOver_valuation_eq hX D
  have hEx : E.toDivisorOver.IsExceptional := by
    rw [isExceptional_iff_two_le_codimension_center hX] at hD ⊢
    rwa [MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX.1 hE]
  obtain ⟨c, hc⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hPw.isPair hK E.toDivisorOver
  obtain rfl := MMP.Threefold.Mori.isDiscrepancy_eq_of_valuation_eq hPw hE hc ha
  have := h.2 n E.toDivisorOver _ hEx
    (MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy hc E.isProper)
  exact_mod_cast (by linarith : (0 : ℝ) < c)

/-! ### Regular points are smooth -/

omit [IsAlgClosed k] [CharZero k] [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] in
/-- On a scheme locally of finite type over a perfect field, a point with regular local ring is
a smooth point. -/
private theorem mem_smoothLocus_of_isRegularLocalRing [PerfectField k] [LocallyOfFiniteType sX]
    (x : X) (hreg : IsRegularLocalRing (X.presheaf.stalk x)) : x ∈ smoothLocus sX := by
  have : LocallyOfFinitePresentation sX :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance
  let := stalkAlgebra sX x
  have hfs : Algebra.FormallySmooth k (X.presheaf.stalk x) := by
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    have hU' : IsAffineOpen U := hU
    let y : U := ⟨x, hxU⟩
    let := sectionAlgebra sX U
    have := finiteType_sectionAlgebra sX hU'
    let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf y
    have := isScalarTower_section_stalk sX U y
    have := hU'.isLocalization_stalk y
    set q := (hU'.primeIdealOf y).asIdeal
    have := Algebra.isSeparableExtension_of_perfectField k q.ResidueField
    have hs : Algebra.IsSmoothAt k q :=
      (Algebra.isSmoothAt_iff_isRegularLocalRing q (X.presheaf.stalk x)).mpr hreg
    exact Algebra.FormallySmooth.of_equiv
      ((IsLocalization.algEquiv q.primeCompl (Localization.AtPrime q)
        (X.presheaf.stalk x)).restrictScalars k)
  rw [smoothLocus_eq_smoothLocus, Scheme.Hom.mem_smoothLocus]
  let f : CommRingCat.of k ⟶ (Spec (.of k)).presheaf.stalk (sX x) :=
    (Scheme.ΓSpecIso (.of k)).inv ≫ (Spec (.of k)).presheaf.germ ⊤ _ (Opens.mem_top _)
  have hiso : IsIso f := by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact ⟨RingHom.injective _, MMP.Positivity.surjective_algebraMap_stalk_Spec _⟩
  have hcomp : f ≫ sX.stalkMap x =
      (Scheme.ΓSpecIso (.of k)).inv ≫ sX.appTop ≫ X.presheaf.germ ⊤ x (Opens.mem_top _) := by
    have hg := Scheme.Hom.germ_stalkMap sX ⊤ x (Opens.mem_top _)
    erw [Category.assoc, hg]
    rfl
  rwa [← RingHom.FormallySmooth.respectsIso.cancel_left_isIso f, ← CommRingCat.hom_comp, hcomp]

/-! ### Smoothness in codimension two -/

/-- **Kollár–Mori, Corollary 5.18.** A terminal variety is smooth in codimension two: its singular
locus has codimension at least three. -/
private theorem three_le_closedsCodimension_singularLocus_of_isTerminalVariety
    (h : IsTerminalVariety sX) {n : ℕ} {K : Divisor X} (hK : K.IsCanonicalDivisor sX n)
    (hKQ : (Divisor.toQDivisor K).IsQCartier) :
    3 ≤ closedsCodimension (singularLocus sX) := by
  have hX : IsNormalVariety k sX := h.1.1.isPair.1
  have : LocallyOfFiniteType sX := hX.1.toLocallyOfFiniteType
  rw [MMP.Flips.le_closedsCodimension_iff_le_coheight]
  intro x hx
  by_contra hlt
  apply (mem_singularLocus_iff (f := sX)).mp hx
  have h3 : Order.coheight x < 3 := not_le.mp hlt
  rcases (show Order.coheight x = 0 ∨ Order.coheight x = 1 ∨ Order.coheight x = 2 by
    obtain ⟨c, hc⟩ := ENat.ne_top_iff_exists.mp (h3.trans (by decide)).ne
    rw [← hc] at h3 ⊢
    have : c < 3 := by exact_mod_cast h3
    interval_cases c <;> simp) with h0 | h1 | h2
  · have hxg : x = genericPoint X := by
      rw [Order.coheight_eq_zero] at h0
      exact (Specializes.antisymm (h0 (genericPoint_specializes x)) (genericPoint_specializes x)).eq
    subst hxg
    exact mem_smoothLocus_of_isRegularLocalRing _
      (inferInstanceAs (IsRegularLocalRing X.functionField))
  · have := MMP.Positivity.PrimeDivisor.genericPoint_mem_smoothLocus hX
      (AlgebraicGeometry.PrimeDivisor.ofCoheightOne x h1)
    rwa [MMP.Mori.PrimeDivisor.genericPoint,
      AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne] at this
  · let W := IrreducibleCloseds.closureSingleton x
    have hW : codimension W = 2 := by rw [MMP.Flips.codimension_closureSingleton, h2]
    have hreg := MMP.Mori.isRegularLocalRing_stalk_genericPoint_of_isDiscrepancy_pos hX hK
      le_rfl (by rwa [add_zero]) hW
      fun D hD _ a ha => isDiscrepancy_pos_of_isTerminalVariety h hK hKQ hD ha
    have hgx : W.isIrreducible.genericPoint = x :=
      W.isIrreducible.isGenericPoint_genericPoint_closure.eq
        (W.isClosed.closure_eq.symm ▸ isGenericPoint_closure)
    rw [hgx] at hreg
    exact mem_smoothLocus_of_isRegularLocalRing x hreg

end MMP.Fourfold.TerminalSmoothCodimTwo

namespace MMP.Fourfold

open MMP.Mori

/-- If `(X, B)` is a terminal pair over an algebraically closed field of characteristic zero with
`B` `ℚ`-Cartier and `K_X` `ℚ`-Cartier, then `X` is a terminal variety and its singular locus has
codimension at least three. -/
@[mmp "lem_fourfold_terminal_smooth_codim_two"]
public theorem IsKltTerminalPair.isTerminalVariety_and_three_le_closedsCodimension_singularLocus
    {k : Type u} [Field k] [IsAlgClosed k] [CharZero k] {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of k)} {B : QDivisor X}
    (h : IsKltTerminalPair sX B) (hB : B.IsQCartier) {n : ℕ}
    {K : Divisor X} (hK : K.IsCanonicalDivisor sX n) (hKQ : (Divisor.toQDivisor K).IsQCartier) :
    IsTerminalVariety sX ∧ 3 ≤ closedsCodimension (singularLocus sX) :=
  have hT := TerminalSmoothCodimTwo.isTerminalVariety_of_isKltTerminalPair h hB hK hKQ
  ⟨hT, TerminalSmoothCodimTwo.three_le_closedsCodimension_singularLocus_of_isTerminalVariety
    hT hK hKQ⟩

end MMP.Fourfold
