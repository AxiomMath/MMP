/-!
# Completions of the double cover over a double normal crossing point

Let `ν : X^ν → X` be the normalization of a semismooth scheme and `x` a double normal crossing
point, `𝒪̂_{X,x} ≅ k[[x₀, …, xₙ]]/(x₀x₁)`. The completed local ring `L` of `X^ν` at a point over
`x` receives `𝒪̂_{X,x}` integrally and birationally; then the map `k[[x]]/(x₀x₁) → L` is
surjective, with kernel `(x₀)` or `(x₁)`, and the preimage of a suitable prime of `L` is
`(x₀, x₁)`. This file proves that algebraic computation, together with the general fact that
in a commutative square of local rings whose vertical sides are surjective, bijectivity of the
completed bottom map follows from surjectivity of the completed top map and a comparison of
the kernels.

## Main results

* `MMP.Flips.adicCompletionMap_surjective_of_surjective`,
  `MMP.Flips.ker_adicCompletionMap_of_surjective`: the completion of a surjective map of
  Noetherian local rings is surjective, with kernel generated by the kernel.
* `MMP.Flips.bijective_adicCompletionMap_of_comm_sq`: bijectivity of the completion of the
  bottom map of a commutative square with surjective vertical maps.
* `MMP.Flips.surjective_and_comap_of_dnc`: the factor map out of the double normal crossing
  model is surjective, and pulls a prime back to `(x₀, x₁)`.
* `MMP.Flips.flat_of_flat_stalkMap_of_isClosed`,
  `MMP.Flips.finrank_eq_of_finrank_eq_of_isClosed`: on Jacobson schemes, flatness of a morphism
  and the value of the rank of a finite flat morphism are read at closed points.
* `MMP.Flips.isRegularLocalRing_iff_and_ringKrullDim_eq_of_forall_le_comap_iff`: a reduced
  quotient `A` of a Noetherian local G-ring `R`, whose non-reduced locus upstairs is cut out by a
  prime `Q₀` of `R̂`, is regular exactly when `R̂ ⧸ Q₀` is, with the same dimension.
* `MMP.Flips.ker_stalkMap_le_iff_mem_range`: the primes of `𝒪_{X,i z}` containing the kernel of
  the stalk map of a closed immersion `i` are the points of its image.
* `MMP.Flips.exists_ringEquiv_powerSeries_of_pinch`: a factor of the normalization of the pinch
  model `k[[x]] ⧸ (x₀² - x₁x₂²)` is `k[[x₂, …]]⟦u⟧`, with `x₀ ↦ u x₂`, `x₁ ↦ u²`.
* `MMP.Flips.isRegularLocalRing_and_ringKrullDim_quotient_map_of_dnc`,
  `MMP.Flips.isRegularLocalRing_and_ringKrullDim_quotient_map_of_pinch`: the double locus of a
  factor of the normalization of either model is regular of dimension `n - 1`.
* `MMP.Flips.exists_completion_factor_normalization`: the completed local ring of the
  normalization is a factor of the normalization of the completed local ring.

## References

* [J. Kollár et al., *Flips and abundance for algebraic threefolds*][KollarFlips], 12.2.1
-/

@[expose] public noncomputable section

namespace MMP.Flips

open IsLocalRing

/-! ### Completions of surjective maps -/

section Completion

variable {R A : Type*} [CommRing R] [CommRing A] [IsLocalRing R] [IsLocalRing A]

/-- The completion of a surjective map `π : R → A` of Noetherian local rings is surjective, with
kernel generated by `ker π`: it factors through the completion of `R ⧸ ker π`. -/
private theorem adicCompletionMap_surjective_and_ker [IsNoetherianRing R] (π : R →+* A)
    (hπ : Function.Surjective π) :
    Function.Surjective (adicCompletionMap π (maximalIdeal R) (maximalIdeal A)
      (map_maximalIdeal_of_surjective π hπ).le) ∧
    RingHom.ker (adicCompletionMap π (maximalIdeal R) (maximalIdeal A)
      (map_maximalIdeal_of_surjective π hπ).le) =
      (RingHom.ker π).map (algebraMap R (AdicCompletion (maximalIdeal R) R)) := by
  set e := RingHom.quotientKerEquivOfSurjective hπ
  have : Nontrivial (R ⧸ RingHom.ker π) := e.toEquiv.nontrivial
  have : IsLocalRing (R ⧸ RingHom.ker π) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have he := map_maximalIdeal_of_surjective e.toRingHom e.surjective
  set ê := adicCompletionMap e.toRingHom (maximalIdeal (R ⧸ RingHom.ker π)) (maximalIdeal A) he.le
  have hê : Function.Bijective ê := bijective_adicCompletionMap_of_bijective _ e.bijective _ _ he
  have heq : adicCompletionMap π (maximalIdeal R) (maximalIdeal A)
      (map_maximalIdeal_of_surjective π hπ).le = ê.comp
        (adicCompletionMapQuotient (RingHom.ker π)) := by
    refine (eq_adicCompletionMap_of_apply_algebraMap π (maximalIdeal R) (maximalIdeal A) _
      (maximalIdeal R).fg_of_isNoetherianRing _ fun r => ?_).symm
    have hq : adicCompletionMapQuotient (RingHom.ker π)
        (algebraMap R (AdicCompletion (maximalIdeal R) R) r) =
        algebraMap (R ⧸ RingHom.ker π) _ (Ideal.Quotient.mk _ r) :=
      AdicCompletion.ext fun n => rfl
    rw [RingHom.comp_apply, hq]
    exact RingHom.congr_fun (adicCompletionMap_comp_algebraMap e.toRingHom
      (maximalIdeal (R ⧸ RingHom.ker π)) (maximalIdeal A) he.le) (Ideal.Quotient.mk _ r)
  rw [heq]
  refine ⟨hê.2.comp (adicCompletionMapQuotient_surjective _), ?_⟩
  rw [← ker_adicCompletionMapQuotient]
  exact RingHom.ker_comp_of_injective _ hê.1

/-- **The completion of a surjective map of Noetherian local rings is surjective.** -/
theorem adicCompletionMap_surjective_of_surjective [IsNoetherianRing R] (π : R →+* A)
    (hπ : Function.Surjective π) :
    Function.Surjective (adicCompletionMap π (maximalIdeal R) (maximalIdeal A)
      (map_maximalIdeal_of_surjective π hπ).le) :=
  (adicCompletionMap_surjective_and_ker π hπ).1

/-- **The kernel of the completion of a surjective map of Noetherian local rings** is generated
by the kernel of the map. -/
theorem ker_adicCompletionMap_of_surjective [IsNoetherianRing R] (π : R →+* A)
    (hπ : Function.Surjective π) :
    RingHom.ker (adicCompletionMap π (maximalIdeal R) (maximalIdeal A)
      (map_maximalIdeal_of_surjective π hπ).le) =
      (RingHom.ker π).map (algebraMap R (AdicCompletion (maximalIdeal R) R)) :=
  (adicCompletionMap_surjective_and_ker π hπ).2

end Completion

/-! ### Commutative squares -/

section Square

variable {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B]
  [IsLocalRing R] [IsLocalRing S] [IsLocalRing A] [IsLocalRing B]
  [IsNoetherianRing R] [IsNoetherianRing S]

/-- **Bijectivity of a completed map from a square.** Let `f ∘ πA = πB ∘ g` be a commutative
square of local homomorphisms of local rings, with `πA : R → A` and `πB : S → B` surjective and
`R`, `S` Noetherian. If the completion `ĝ` of `g` is surjective, and `ĝ r` lies in the ideal
generated by `ker πB` only when `r` lies in the ideal generated by `ker πA`, then the
completion of `f` is bijective. -/
theorem bijective_adicCompletionMap_of_comm_sq (πA : R →+* A) (hπA : Function.Surjective πA)
    (πB : S →+* B) (hπB : Function.Surjective πB) (g : R →+* S) [IsLocalHom g]
    (f : A →+* B) [IsLocalHom f] (hsq : f.comp πA = πB.comp g)
    (hg : Function.Surjective (adicCompletionMap g (maximalIdeal R) (maximalIdeal S)
      (map_maximalIdeal_le g)))
    (hker : ∀ r, adicCompletionMap g (maximalIdeal R) (maximalIdeal S) (map_maximalIdeal_le g) r ∈
        (RingHom.ker πB).map (algebraMap S (AdicCompletion (maximalIdeal S) S)) →
      r ∈ (RingHom.ker πA).map (algebraMap R (AdicCompletion (maximalIdeal R) R))) :
    Function.Bijective (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
      (map_maximalIdeal_le f)) := by
  have hA := map_maximalIdeal_of_surjective πA hπA
  have hB := map_maximalIdeal_of_surjective πB hπB
  have h1 : (maximalIdeal R).map (f.comp πA) ≤ maximalIdeal B := by
    rw [← Ideal.map_map, hA]; exact map_maximalIdeal_le f
  have h2 : (maximalIdeal R).map (πB.comp g) ≤ maximalIdeal B := by
    rw [← Ideal.map_map]; exact (Ideal.map_mono (map_maximalIdeal_le g)).trans hB.le
  have hcomp : (adicCompletionMap f (maximalIdeal A) (maximalIdeal B)
      (map_maximalIdeal_le f)).comp (adicCompletionMap πA _ _ hA.le) =
      (adicCompletionMap πB _ _ hB.le).comp
        (adicCompletionMap g (maximalIdeal R) (maximalIdeal S) (map_maximalIdeal_le g)) := by
    rw [adicCompletionMap_comp_adicCompletionMap _ _ _ _ _ _ _ h1,
      adicCompletionMap_comp_adicCompletionMap _ _ _ _ _ _ _ h2]
    exact adicCompletionMap_congr _ _ _ _ hsq
  have hsA := adicCompletionMap_surjective_of_surjective πA hπA
  have hsB := adicCompletionMap_surjective_of_surjective πB hπB
  refine ⟨?_, fun b => ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨r, rfl⟩ := hsA a
    have h0 : adicCompletionMap πB _ _ hB.le
        (adicCompletionMap g (maximalIdeal R) (maximalIdeal S) (map_maximalIdeal_le g) r) = 0 := by
      rw [← RingHom.comp_apply, ← hcomp, RingHom.comp_apply, ha]
    rw [← RingHom.mem_ker, ker_adicCompletionMap_of_surjective πB hπB] at h0
    have h3 := hker r h0
    rw [← ker_adicCompletionMap_of_surjective πA hπA] at h3
    exact h3
  · obtain ⟨s, rfl⟩ := hsB b
    obtain ⟨r, rfl⟩ := hg s
    exact ⟨_, RingHom.congr_fun hcomp r⟩

end Square

/-! ### The double normal crossing model -/

open PowerSeries Normalization

section DNC

variable {k : Type*} [Field k] {n : ℕ}

private theorem restrictZero_X_succ (i : Fin n) :
    restrictZero k n (MvPowerSeries.X i.succ) = MvPowerSeries.X i := by
  simp [restrictZero, MvPowerSeries.finSuccEquiv_X_succ]

private theorem inclZero_X (i : Fin n) :
    inclZero k n (MvPowerSeries.X i) = MvPowerSeries.X i.succ := by
  simp only [inclZero, RingHom.comp_apply]
  rw [← MvPowerSeries.finSuccEquiv_X_succ]
  exact (MvPowerSeries.finSuccEquiv k n).symm_apply_apply _

/-- The ideal `(x₀x₁)` of `k[[x₀, …, xₙ]]`. -/
private abbrev dncIdeal (k : Type*) [Field k] (n : ℕ) : Ideal (MvPowerSeries (Fin (n + 1)) k) :=
  Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (n + 1)) k)}

private theorem mk_mem_nonZeroDivisors_of_not_dvd {f : MvPowerSeries (Fin (n + 1)) k}
    (h0 : ¬ MvPowerSeries.X 0 ∣ f) (h1 : ¬ MvPowerSeries.X 1 ∣ f) :
    Ideal.Quotient.mk (dncIdeal k n) f ∈ nonZeroDivisors _ := by
  have : IsRegularLocalRing (MvPowerSeries (Fin (n + 1)) k) :=
    MvPowerSeries.isRegularLocalRing k (n + 1)
  have : IsDomain (MvPowerSeries (Fin (n + 1)) k) := IsRegularLocalRing.isDomain _
  have : UniqueFactorizationMonoid (MvPowerSeries (Fin (n + 1)) k) :=
    IsRegularLocalRing.uniqueFactorizationMonoid _
  have hrel : IsRelPrime (MvPowerSeries.X 0 * MvPowerSeries.X 1) f :=
    ((prime_X 0).irreducible.isRelPrime_iff_not_dvd.mpr h0).mul_left
      ((prime_X 1).irreducible.isRelPrime_iff_not_dvd.mpr h1)
  have key : ∀ g, Ideal.Quotient.mk (dncIdeal k n) (f * g) = 0 →
      Ideal.Quotient.mk (dncIdeal k n) g = 0 := by
    intro g hg
    rw [Ideal.Quotient.eq_zero_iff_dvd] at hg ⊢
    exact hrel.dvd_of_dvd_mul_left hg
  refine mem_nonZeroDivisors_iff.mpr ⟨fun x hx => ?_, fun x hx => ?_⟩
  · obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact key g (by rwa [map_mul])
  · obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact key g (by rwa [map_mul, mul_comm])

/-- **The dnc model, branch `x₀ = 0`.** -/
private theorem surjective_and_comap_of_dnc_of_zero {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ dncIdeal k (m + 1)) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0)
    (h0 : ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0) :
    (Function.Surjective ψ ∧ ∃ Q : Ideal L, Q.IsPrime ∧
      Q.comap ψ = (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk _)) ∧
      ∀ f, ψ (Ideal.Quotient.mk _ f) = 0 ↔ MvPowerSeries.X 0 ∣ f := by
  set B := MvPowerSeries (Fin (m + 1)) k
  have : IsRegularLocalRing B := MvPowerSeries.isRegularLocalRing k (m + 1)
  have : IsDomain B := IsRegularLocalRing.isDomain B
  have : UniqueFactorizationMonoid B := IsRegularLocalRing.uniqueFactorizationMonoid _
  set Ψ := ψ.comp (Ideal.Quotient.mk (dncIdeal k (m + 1)))
  set θ : B →+* L := Ψ.comp (inclZero k (m + 1))
  have hΨ : ∀ f, Ψ f = θ (restrictZero k (m + 1) f) := fun f => by
    obtain ⟨q, hq⟩ := sub_inclZero_restrictZero_mem f
    have := congrArg Ψ hq
    rw [map_sub, map_mul] at this
    have hX : Ψ (MvPowerSeries.X 0) = 0 := h0
    rw [hX, zero_mul, sub_eq_zero] at this
    exact this
  set F : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ dncIdeal k (m + 1)) →+* B :=
    Ideal.Quotient.lift (dncIdeal k (m + 1)) (restrictZero k (m + 1)) fun a ha => by
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, map_mul, restrictZero_X_zero, zero_mul, mul_zero]
  have hθF : ∀ r, θ (F r) = ψ r := fun r => by
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    exact (hΨ f).symm
  have hθinj : Function.Injective θ := by
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    set d := inclZero k (m + 1) b
    have hd0 : ¬ MvPowerSeries.X 0 ∣ d := by
      rwa [X_zero_dvd_iff, restrictZero_inclZero]
    have hzd : ∀ i : ℕ, 0 < i → MvPowerSeries.X 1 ∣ d + MvPowerSeries.X 0 ^ i := by
      intro i hi
      by_contra h1
      refine hnz _ (mk_mem_nonZeroDivisors_of_not_dvd (f := d + MvPowerSeries.X 0 ^ i) ?_ h1) ?_
      · intro h
        exact hd0 ((dvd_add_left (dvd_pow_self _ hi.ne')).mp h)
      · change Ψ _ = 0
        rw [map_add, map_pow, show Ψ (MvPowerSeries.X 0) = 0 from h0, zero_pow hi.ne', add_zero]
        exact hb
    have h12 := dvd_sub (hzd 1 one_pos) (hzd 2 two_pos)
    rw [add_sub_add_left_eq_sub] at h12
    by_cases h10 : (1 : Fin (m + 1 + 1)) = 0
    · have := hzd 1 one_pos
      rw [h10, pow_one] at this
      exact hd0 ((dvd_add_left (dvd_refl _)).mp this)
    · rw [MvPowerSeries.X_dvd_iff] at h12
      have := h12 (Finsupp.single 0 1) (by simp)
      simp [MvPowerSeries.coeff_X_pow, MvPowerSeries.coeff_X, Finsupp.single_eq_single_iff] at this
  let : Algebra B L := θ.toAlgebra
  have : FaithfulSMul B L := (faithfulSMul_iff_algebraMap_injective _ _).2 hθinj
  have : Algebra.IsIntegral B L := ⟨fun l => by
    obtain ⟨p, hp, hpl⟩ := hint l
    refine ⟨p.map F, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have : (algebraMap B L).comp F = ψ := RingHom.ext hθF
    rw [this]
    exact hpl⟩
  have hL : ∀ l : L, ∃ r s : B, s ≠ 0 ∧ algebraMap B L s * l = algebraMap B L r := fun l => by
    obtain ⟨r, s, hs, h⟩ := hbir l
    refine ⟨F r, F s, fun h0' => hnz s hs ?_, ?_⟩
    · rw [← hθF, h0', map_zero]
    · change θ (F s) * l = θ (F r)
      rwa [hθF, hθF]
  obtain ⟨σ⟩ := nonempty_algEquiv_of_isIntegrallyClosed_of_birational B L B hL
    (fun c => ⟨c, 1, one_ne_zero, by simp⟩)
  have hσ : ∀ r, σ (ψ r) = F r := fun r => by
    rw [← hθF]
    exact σ.commutes (F r)
  have hker : ∀ f, ψ (Ideal.Quotient.mk _ f) = 0 ↔ MvPowerSeries.X 0 ∣ f := fun f => by
    change Ψ f = 0 ↔ _
    rw [hΨ f, X_zero_dvd_iff, ← map_zero θ, hθinj.eq_iff]
  refine ⟨?_, hker⟩
  refine ⟨fun l => ⟨Ideal.Quotient.mk _ (inclZero k (m + 1) (σ l)), σ.injective ?_⟩, ?_⟩
  · rw [hσ]
    exact restrictZero_inclZero _
  have hXp : (Ideal.span {(MvPowerSeries.X 0 : B)}).IsPrime :=
    (Ideal.span_singleton_prime prime_X_zero.ne_zero).mpr prime_X_zero
  refine ⟨(Ideal.span {(MvPowerSeries.X 0 : B)}).comap σ, Ideal.IsPrime.comap _, ?_⟩
  ext r
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
  rw [Ideal.mem_comap, Ideal.mem_comap, hσ]
  change restrictZero k (m + 1) f ∈ _ ↔ _
  constructor
  · intro h
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h
    obtain ⟨q, hq⟩ := sub_inclZero_restrictZero_mem f
    have hf : f = MvPowerSeries.X 0 * q + inclZero k (m + 1) a * MvPowerSeries.X 1 := by
      rw [show (MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k) =
        inclZero k (m + 1) (MvPowerSeries.X 0) from (inclZero_X 0).symm, ← map_mul, ha]
      linear_combination hq
    rw [hf]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_span_pair.mpr ⟨q, inclZero k (m + 1) a, by ring⟩)
  · intro h
    have hle : (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk (dncIdeal k (m + 1))) ≤
        (Ideal.span {(MvPowerSeries.X 0 : B)}).comap F := by
      rw [Ideal.map_le_iff_le_comap, Ideal.comap_comap, Ideal.span_le]
      rintro _ (rfl | rfl)
      · rw [SetLike.mem_coe, Ideal.mem_comap]
        change restrictZero k (m + 1) (MvPowerSeries.X 0) ∈ Ideal.span {(MvPowerSeries.X 0 : B)}
        rw [restrictZero_X_zero]
        exact zero_mem _
      · rw [SetLike.mem_coe, Ideal.mem_comap]
        change restrictZero k (m + 1) (MvPowerSeries.X (0 : Fin (m + 1)).succ) ∈
          Ideal.span {(MvPowerSeries.X 0 : B)}
        rw [restrictZero_X_succ]
        exact Ideal.mem_span_singleton_self _
    exact hle h

private theorem map_mem_nonZeroDivisors_of_equiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) {s : R} (hs : s ∈ nonZeroDivisors R) : e s ∈ nonZeroDivisors S := by
  rw [← MulEquivClass.map_nonZeroDivisors e]
  exact Submonoid.mem_map_of_mem _ hs

/-- The automorphism of `k[[x]]/(x₀x₁)` exchanging `x₀` and `x₁`. -/
private def dncSwap (k : Type*) [Field k] (n : ℕ) :
    (MvPowerSeries (Fin (n + 1)) k ⧸ dncIdeal k n) ≃ₐ[k]
      (MvPowerSeries (Fin (n + 1)) k ⧸ dncIdeal k n) :=
  Ideal.quotientEquivAlg _ _ (MvPowerSeries.renameEquiv k (Equiv.swap 0 1)) (by
    rw [Ideal.map_span, Set.image_singleton, map_mul]
    simp [MvPowerSeries.renameEquiv, MvPowerSeries.rename_X, mul_comm])

private theorem dncSwap_mk_X_zero :
    dncSwap k n (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) =
      Ideal.Quotient.mk _ (MvPowerSeries.X 1) := by
  simp [dncSwap, MvPowerSeries.renameEquiv, MvPowerSeries.rename_X]

private theorem dncSwap_mk_X_one :
    dncSwap k n (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) =
      Ideal.Quotient.mk _ (MvPowerSeries.X 0) := by
  simp [dncSwap, MvPowerSeries.renameEquiv, MvPowerSeries.rename_X]

/-- The ideal `(x₀, x₁)` of `k[[x]]/(x₀x₁)` is stable under an endomorphism exchanging the
classes of `x₀` and `x₁`. -/
private theorem span_le_comap_of_swap {m : ℕ}
    (τ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ dncIdeal k (m + 1)) →+*
      (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ dncIdeal k (m + 1)))
    (h0 : τ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = Ideal.Quotient.mk _ (MvPowerSeries.X 1))
    (h1 : τ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = Ideal.Quotient.mk _ (MvPowerSeries.X 0)) :
    (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk (dncIdeal k (m + 1))) ≤
      ((Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk (dncIdeal k (m + 1)))).comap τ := by
  rw [Ideal.map_span, Set.image_pair, Ideal.span_le]
  rintro _ (rfl | rfl)
  · rw [SetLike.mem_coe, Ideal.mem_comap, h0]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  · rw [SetLike.mem_coe, Ideal.mem_comap, h1]
    exact Ideal.subset_span (Set.mem_insert _ _)

/-- **The completed local ring of the normalization over a double normal crossing point.** Let
`L` be a local normal domain receiving `ψ : k[[x₀, …, x_{m+1}]]/(x₀x₁) → L`, integral and
birational, with no non-zero-divisor in its kernel. Then `ψ` is surjective (its kernel is `(x₀)`
or `(x₁)`), and some prime of `L` pulls back to `(x₀, x₁)`. -/
theorem surjective_and_comap_of_dnc {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0) :
    Function.Surjective ψ ∧ ∃ Q : Ideal L, Q.IsPrime ∧
      Q.comap ψ = (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk _) := by
  have h01 : ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) *
      ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0 := by
    rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _),
      map_zero]
  rcases mul_eq_zero.mp h01 with h0 | h1
  · exact (surjective_and_comap_of_dnc_of_zero ψ hint hbir hnz h0).1
  set τ := dncSwap k (m + 1)
  set ψ' := ψ.comp τ.toRingEquiv.toRingHom
  have hψ' : ∀ r, ψ' (τ.symm r) = ψ r := fun r => by simp [ψ']
  obtain ⟨⟨hsurj, Q, hQ, hQc⟩, -⟩ := surjective_and_comap_of_dnc_of_zero ψ'
    (fun l => by
      obtain ⟨p, hp, hpl⟩ := hint l
      refine ⟨p.map τ.symm.toRingEquiv.toRingHom, hp.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have : ψ'.comp τ.symm.toRingEquiv.toRingHom = ψ := RingHom.ext hψ'
      rwa [this])
    (fun l => by
      obtain ⟨r, s, hs, h⟩ := hbir l
      exact ⟨τ.symm r, τ.symm s, map_mem_nonZeroDivisors_of_equiv τ.symm.toRingEquiv hs,
        by rw [hψ', hψ']; exact h⟩)
    (fun s hs => by
      simpa [ψ'] using hnz (τ s) (map_mem_nonZeroDivisors_of_equiv τ.toRingEquiv hs))
    (by
      change ψ (τ _) = 0
      rw [show τ = dncSwap k (m + 1) from rfl, dncSwap_mk_X_zero, h1])
  refine ⟨fun l => ?_, Q, hQ, ?_⟩
  · obtain ⟨r, rfl⟩ := hsurj l
    exact ⟨τ r, by simp [ψ']⟩
  have hτ0 : τ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) =
      Ideal.Quotient.mk _ (MvPowerSeries.X 1) :=
    τ.symm_apply_eq.mpr dncSwap_mk_X_one.symm
  have hτ1 : τ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) =
      Ideal.Quotient.mk _ (MvPowerSeries.X 0) :=
    τ.symm_apply_eq.mpr dncSwap_mk_X_zero.symm
  have hle := span_le_comap_of_swap (m := m) τ.toRingEquiv.toRingHom dncSwap_mk_X_zero
    dncSwap_mk_X_one
  have hle' := span_le_comap_of_swap (m := m) τ.symm.toRingEquiv.toRingHom hτ0 hτ1
  ext r
  rw [Ideal.mem_comap, ← hψ' r, ← Ideal.mem_comap (f := ψ'), hQc]
  exact ⟨fun h => by simpa using hle h, fun h => hle' h⟩

/-- **The kernel of a factor of the normalization of the double normal crossing model.** If `ψ`
kills `x₀`, its kernel is exactly `(x₀)`. -/
theorem eq_zero_iff_dvd_of_dnc {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0)
    (h0 : ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0) (f : MvPowerSeries (Fin (m + 1 + 1)) k) :
    ψ (Ideal.Quotient.mk _ f) = 0 ↔ MvPowerSeries.X 0 ∣ f :=
  (surjective_and_comap_of_dnc_of_zero ψ hint hbir hnz h0).2 f

/-- The double normal crossing model has an automorphism sending `x₀` to `x₁`. -/
theorem exists_ringEquiv_swap_dnc (m : ℕ) :
    ∃ τ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) ≃+*
      (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}),
      τ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = Ideal.Quotient.mk _ (MvPowerSeries.X 1) :=
  ⟨(dncSwap k (m + 1)).toRingEquiv, dncSwap_mk_X_zero⟩

end DNC

/-! ### Reading flatness and rank at closed points -/

section ClosedPoints

open AlgebraicGeometry CategoryTheory

universe u

/-- The stalk maps of `Spec 𝒪_{X,x} ⟶ X` are bijective. -/
private theorem fromSpecStalk_stalkMap_bijective (X : Scheme.{u}) (x : X)
    (p : Spec (X.presheaf.stalk x)) :
    Function.Bijective ((X.fromSpecStalk x).stalkMap p).hom := by
  have := flat_fromSpecStalk X x
  let f : X.presheaf.stalk ((X.fromSpecStalk x) p) →+*
      (Spec (X.presheaf.stalk x)).presheaf.stalk p :=
    ((X.fromSpecStalk x).stalkMap p).hom
  have hf : f.Flat := Flat.stalkMap _ _
  have hinj : Function.Injective f := by
    let _ := f.toAlgebra
    have : Module.Flat (X.presheaf.stalk ((X.fromSpecStalk x) p))
        ((Spec (X.presheaf.stalk x)).presheaf.stalk p) := hf
    have : IsLocalHom (algebraMap (X.presheaf.stalk ((X.fromSpecStalk x) p))
        ((Spec (X.presheaf.stalk x)).presheaf.stalk p)) := by
      change IsLocalHom ((X.fromSpecStalk x).stalkMap p).hom
      infer_instance
    have : Module.FaithfullyFlat (X.presheaf.stalk ((X.fromSpecStalk x) p))
        ((Spec (X.presheaf.stalk x)).presheaf.stalk p) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact (show f.FaithfullyFlat from this).injective
  exact ⟨hinj, (X.fromSpecStalk x).stalkMap_surjective p⟩

/-- **Flatness of stalk maps generizes.** If the stalk map of `f` at `y` is flat, so is the stalk
map at every generization `x` of `y`. -/
theorem flat_stalkMap_of_specializes {X Y : Scheme.{u}} (f : X ⟶ Y) {x y : X} (hxy : x ⤳ y)
    (hy : (f.stalkMap y).hom.Flat) : (f.stalkMap x).hom.Flat := by
  have : Flat (Spec.map (f.stalkMap y)) := Flat.SpecMap_iff.mpr hy
  have := flat_fromSpecStalk Y (f y)
  have := flat_fromSpecStalk X y
  have hcomp : Flat (X.fromSpecStalk y ≫ f) := by
    rw [← Scheme.SpecMap_stalkMap_fromSpecStalk]
    infer_instance
  obtain ⟨p, hp⟩ := (show x ∈ Set.range (X.fromSpecStalk y) by
    rw [Scheme.range_fromSpecStalk]
    exact hxy)
  have hstalk := @Flat.stalkMap _ _ (X.fromSpecStalk y ≫ f) hcomp p
  rw [Scheme.Hom.stalkMap_comp] at hstalk
  have := (RingHom.Flat.comp_iff_of_bijective_left
    (fromSpecStalk_stalkMap_bijective X y p)).mp hstalk
  change (f.stalkMap ((X.fromSpecStalk y) p)).hom.Flat at this
  rwa [hp] at this

/-- In a Jacobson space every point specializes to a closed point. -/
theorem exists_specializes_isClosed_singleton {X : Type*} [TopologicalSpace X]
    [JacobsonSpace X] (x : X) : ∃ y, x ⤳ y ∧ IsClosed ({y} : Set X) := by
  obtain ⟨y, hy, hyc⟩ := nonempty_inter_closedPoints (Z := closure {x}) ⟨x, subset_closure rfl⟩
    isClosed_closure.isLocallyClosed
  exact ⟨y, specializes_iff_mem_closure.mpr hy, hyc⟩

/-- **Flatness is read at closed points of a Jacobson scheme.** -/
theorem flat_of_flat_stalkMap_of_isClosed {X Y : Scheme.{u}} (f : X ⟶ Y) [JacobsonSpace X]
    (h : ∀ x : X, IsClosed ({x} : Set X) → (f.stalkMap x).hom.Flat) : Flat f :=
  Flat.of_stalkMap f fun x => by
    obtain ⟨y, hxy, hy⟩ := exists_specializes_isClosed_singleton x
    exact flat_stalkMap_of_specializes f hxy (h y hy)

/-- **The rank of a finite flat morphism is read at closed points of a Jacobson target.** -/
theorem finrank_eq_of_finrank_eq_of_isClosed {X Y : Scheme.{u}} (f : X ⟶ Y) [Flat f]
    [IsFinite f] [LocallyOfFinitePresentation f] [JacobsonSpace Y] (d : ℕ)
    (h : ∀ y : Y, IsClosed ({y} : Set Y) → f.finrank y = d) : f.finrank = fun _ => d := by
  funext y
  obtain ⟨z, hyz, hz⟩ := exists_specializes_isClosed_singleton y
  obtain ⟨U, hU, hzU, hc⟩ :=
    (IsLocallyConstant.iff_exists_open _).mp (Scheme.Hom.isLocallyConstant_finrank f) z
  rw [hc y (hyz.mem_open hU hzU), h z hz]

end ClosedPoints

/-! ### The completion of a quotient cutting out a closed locus -/

section QuotientCompletion

universe u

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- **The extended ideal of a reduced quotient.** Let `R` be a Noetherian local G-ring and `I` an
ideal with `R ⧸ I` reduced. If a prime `Q₀` of the completion `R̂` lies in exactly those primes
of `R̂` whose contraction contains `I`, then `I` extends to `Q₀`: the extension is radical, the
completion of `R ⧸ I` being reduced. -/
theorem map_eq_of_forall_le_comap_iff (hR : IsGRing R) (I : Ideal R) [IsLocalRing (R ⧸ I)]
    [IsReduced (R ⧸ I)] (Q₀ : Ideal (AdicCompletion (maximalIdeal R) R)) [Q₀.IsPrime]
    (hV : ∀ Q : Ideal (AdicCompletion (maximalIdeal R) R), Q.IsPrime →
      (I ≤ Q.comap (algebraMap R (AdicCompletion (maximalIdeal R) R)) ↔ Q₀ ≤ Q)) :
    I.map (algebraMap R (AdicCompletion (maximalIdeal R) R)) = Q₀ := by
  set J := I.map (algebraMap R (AdicCompletion (maximalIdeal R) R))
  have hGI : IsGRing (R ⧸ I) := isGRing_of_essFiniteType hR
  have : IsReduced (AdicCompletion (maximalIdeal (R ⧸ I)) (R ⧸ I)) :=
    isReduced_of_isRegularRingHom _ (isRegularRingHom_algebraMap_adicCompletion hGI _)
  have hrad : J.IsRadical := by
    have := (RingHom.ker_isRadical_iff_reduced_of_surjective
      (adicCompletionMapQuotient_surjective I)).mpr inferInstance
    rwa [ker_adicCompletionMapQuotient] at this
  rw [← hrad.radical, Ideal.radical_eq_sInf,
    ← (Ideal.IsPrime.isRadical (inferInstance : Q₀.IsPrime)).radical,
    Ideal.radical_eq_sInf]
  congr 1
  ext Q
  refine ⟨fun ⟨h1, h2⟩ => ⟨(hV Q h2).mp (Ideal.map_le_iff_le_comap.mp h1), h2⟩,
    fun ⟨h1, h2⟩ => ⟨Ideal.map_le_iff_le_comap.mpr ((hV Q h2).mpr h1), h2⟩⟩

/-- **Regularity and dimension of a reduced quotient, read on the completion.** Let `π : R ↠ A`
be a surjection from a Noetherian local G-ring onto a reduced local ring, and `Q₀` a prime of
`R̂` lying in exactly those primes whose contraction contains `ker π`. Then `Â ≅ R̂ ⧸ Q₀`, so `A`
is regular exactly when `R̂ ⧸ Q₀` is, and both have the same dimension. -/
theorem isRegularLocalRing_iff_and_ringKrullDim_eq_of_forall_le_comap_iff {A : Type u}
    [CommRing A] [IsLocalRing A] [IsReduced A] (hR : IsGRing R) (π : R →+* A)
    (hπ : Function.Surjective π) (Q₀ : Ideal (AdicCompletion (maximalIdeal R) R)) [Q₀.IsPrime]
    (hV : ∀ Q : Ideal (AdicCompletion (maximalIdeal R) R), Q.IsPrime →
      (RingHom.ker π ≤ Q.comap (algebraMap R (AdicCompletion (maximalIdeal R) R)) ↔ Q₀ ≤ Q)) :
    (IsRegularLocalRing A ↔ IsRegularLocalRing (AdicCompletion (maximalIdeal R) R ⧸ Q₀)) ∧
      ringKrullDim A = ringKrullDim (AdicCompletion (maximalIdeal R) R ⧸ Q₀) := by
  set e := RingHom.quotientKerEquivOfSurjective hπ
  have : Nontrivial (R ⧸ RingHom.ker π) := e.toEquiv.nontrivial
  have : IsLocalRing (R ⧸ RingHom.ker π) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have : IsReduced (R ⧸ RingHom.ker π) := isReduced_of_injective e.toRingHom e.injective
  have : IsNoetherianRing A := isNoetherianRing_of_surjective R A π hπ
  have hmap := map_eq_of_forall_le_comap_iff hR (RingHom.ker π) Q₀ hV
  have hker := ker_adicCompletionMap_of_surjective π hπ
  rw [hmap] at hker
  let ê : (AdicCompletion (maximalIdeal R) R ⧸ Q₀) ≃+* AdicCompletion (maximalIdeal A) A :=
    (Ideal.quotEquivOfEq hker.symm).trans
      (RingHom.quotientKerEquivOfSurjective (adicCompletionMap_surjective_of_surjective π hπ))
  refine ⟨?_, ?_⟩
  · rw [isRegularLocalRing_iff_adicCompletion_maximalIdeal]
    exact ⟨fun _ => IsRegularLocalRing.of_ringEquiv ê.symm,
      fun _ => IsRegularLocalRing.of_ringEquiv ê⟩
  · rw [← IsLocalRing.ringKrullDim_adicCompletion_maximalIdeal (A := A),
      ringKrullDim_eq_of_ringEquiv ê]

end QuotientCompletion

/-! ### Primes of a local ring of a scheme -/

section StalkPrimes

open AlgebraicGeometry CategoryTheory

universe u

/-- The local ring at the generization of `w` given by a prime `p` of `𝒪_{X,w}` is regular
exactly when the localization of `𝒪_{X,w}` at `p` is. -/
theorem isRegularLocalRing_stalk_fromSpecStalk_iff {X : Scheme.{u}} (w : X)
    (p : Ideal (X.presheaf.stalk w)) [p.IsPrime] :
    IsRegularLocalRing (X.presheaf.stalk
        (X.fromSpecStalk w (⟨p, inferInstance⟩ : PrimeSpectrum _))) ↔
      IsRegularLocalRing (Localization.AtPrime p) := by
  have hFinj : Function.Injective (X.fromSpecStalk w) :=
    (X.fromSpecStalk w).isEmbedding.injective
  have hyx : X.fromSpecStalk w (⟨p, inferInstance⟩ : PrimeSpectrum _) ⤳ w := by
    have : X.fromSpecStalk w (⟨p, inferInstance⟩ : PrimeSpectrum _) ∈
        Set.range (X.fromSpecStalk w) := ⟨_, rfl⟩
    rwa [Scheme.range_fromSpecStalk] at this
  generalize hy : X.fromSpecStalk w (⟨p, inferInstance⟩ : PrimeSpectrum _) = y at hyx
  let : Algebra (X.presheaf.stalk w) (X.presheaf.stalk y) :=
    (X.presheaf.stalkSpecializes hyx).hom.toAlgebra
  have hloc := Stacks.StalkSpecialization.isLocalization_atPrime_stalkSpecializes hyx
  have hp' : (maximalIdeal (X.presheaf.stalk y)).under (X.presheaf.stalk w) = p := by
    have h1 := Scheme.SpecMap_stalkSpecializes_fromSpecStalk hyx
    have h2 := congrArg (fun g => g (closedPoint (X.presheaf.stalk y))) h1
    simp only [Scheme.fromSpecStalk_closedPoint] at h2
    have := hFinj (h2.trans hy.symm)
    exact congrArg PrimeSpectrum.asIdeal this
  have := Stacks.StalkSpecialization.isLocalization_atPrime_of_eq hp' hloc
  let f := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p) (X.presheaf.stalk y)
  exact ⟨fun _ => IsRegularLocalRing.of_ringEquiv f.symm.toRingEquiv,
    fun _ => IsRegularLocalRing.of_ringEquiv f.toRingEquiv⟩

/-- **The kernel of the stalk map of a closed immersion.** For a closed immersion `i : Z ⟶ X`, a
prime `p` of `𝒪_{X,i z}` contains the kernel of `𝒪_{X,i z} → 𝒪_{Z,z}` exactly when the point of
`X` it defines lies on `Z`. -/
theorem ker_stalkMap_le_iff_mem_range {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (z : Z) (p : Ideal (X.presheaf.stalk (i z))) [p.IsPrime] :
    RingHom.ker (i.stalkMap z).hom ≤ p ↔
      X.fromSpecStalk (i z) (⟨p, inferInstance⟩ : PrimeSpectrum _) ∈ Set.range i := by
  have hφ : Function.Surjective (i.stalkMap z).hom := i.stalkMap_surjective z
  have hFinj : Function.Injective (X.fromSpecStalk (i z)) :=
    (X.fromSpecStalk (i z)).isEmbedding.injective
  have hyx : X.fromSpecStalk (i z) (⟨p, inferInstance⟩ : PrimeSpectrum _) ⤳ i z := by
    have : X.fromSpecStalk (i z) (⟨p, inferInstance⟩ : PrimeSpectrum _) ∈
        Set.range (X.fromSpecStalk (i z)) := ⟨_, rfl⟩
    rwa [Scheme.range_fromSpecStalk] at this
  generalize hy : X.fromSpecStalk (i z) (⟨p, inferInstance⟩ : PrimeSpectrum _) = y at hyx
  have hsq := Scheme.SpecMap_stalkMap_fromSpecStalk (f := i) (x := z)
  constructor
  · intro hIp
    have : (⟨p, inferInstance⟩ : PrimeSpectrum _) ∈
        Set.range (PrimeSpectrum.comap (i.stalkMap z).hom) := by
      rw [_root_.range_comap_of_surjective _ _ hφ]
      exact hIp
    obtain ⟨P', hP'⟩ := this
    refine ⟨Z.fromSpecStalk z P', ?_⟩
    rw [← hy, ← hP']
    exact (congrArg (fun g => g P') hsq).symm
  · rintro ⟨w, hw⟩
    have hwz : w ⤳ z := i.isEmbedding.isInducing.specializes_iff.mp (hw ▸ hyx)
    obtain ⟨P', rfl⟩ : w ∈ Set.range (Z.fromSpecStalk z) := by
      rwa [Scheme.range_fromSpecStalk]
    have h2 := congrArg (fun g => g P') hsq
    have heq := hFinj ((h2.trans hw).trans hy.symm)
    have hp : p = (P' : PrimeSpectrum _).asIdeal.comap (i.stalkMap z).hom :=
      (congrArg PrimeSpectrum.asIdeal heq).symm
    rw [hp]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker.mp hr]
    exact zero_mem _

end StalkPrimes

/-! ### The pinch model -/

section PinchModel

variable (k : Type*) [Field k] (m : ℕ)

private theorem pinchMap_algebraMap (c : k) :
    pinchMap (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)
      (@algebraMap k (PinchRing (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)) _
        CommSemiring.toSemiring _ c) =
      PowerSeries.C (MvPowerSeries.C c) := by
  rw [← Ideal.Quotient.mk_algebraMap, Polynomial.algebraMap_apply, pinchMap_mk_C,
    PowerSeries.algebraMap_apply, expand_C]
  rfl

end PinchModel

end MMP.Flips

/-! ### Regular loci of the hypersurface models -/

universe u

namespace MMP.Flips.SingLoc

open IsLocalRing MvPowerSeries

/-! ### Power series rings -/

variable (k : Type u) [Field k] (m : ℕ)

private instance isRegularLocalRing_mvPowerSeries :
    IsRegularLocalRing (MvPowerSeries (Fin m) k) :=
  MvPowerSeries.isRegularLocalRing k m

private instance isRegularRing_mvPowerSeries : IsRegularRing (MvPowerSeries (Fin m) k) :=
  ((IsLocalRing.isRegularRing_tfae (R := MvPowerSeries (Fin m) k)).out 1 3).mp
    (isRegularLocalRing_mvPowerSeries k m)

private instance isDomain_mvPowerSeries : IsDomain (MvPowerSeries (Fin m) k) :=
  IsRegularLocalRing.isDomain _

variable {k m}

private theorem mem_maximalIdeal_mvPowerSeries_iff {f : MvPowerSeries (Fin m) k} :
    f ∈ maximalIdeal (MvPowerSeries (Fin m) k) ↔ constantCoeff f = 0 := by
  rw [mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
    isUnit_iff_ne_zero,
    not_not]

/-- Elements of `𝔪²` have vanishing linear part, read through a partial derivative. -/
private theorem constantCoeff_pderiv_eq_zero_of_mem_sq (l : Fin m) {f : MvPowerSeries (Fin m) k}
    (hf : f ∈ maximalIdeal (MvPowerSeries (Fin m) k) ^ 2) :
    constantCoeff (pderiv l f) = 0 := by
  rw [pow_two] at hf
  refine Submodule.mul_induction_on hf (fun a ha b hb => ?_) (fun x y hx hy => ?_)
  · rw [mem_maximalIdeal_mvPowerSeries_iff] at ha hb
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, ha, hb]
    ring
  · rw [map_add, map_add, hx, hy, add_zero]

private theorem X_ne_zero' (i : Fin m) : (X i : MvPowerSeries (Fin m) k) ≠ 0 := by
  intro h
  simpa using congrArg (pderiv i) h

private theorem X_mem_maximalIdeal (i : Fin m) :
    (X i : MvPowerSeries (Fin m) k) ∈ maximalIdeal (MvPowerSeries (Fin m) k) :=
  mem_maximalIdeal_mvPowerSeries_iff.mpr (constantCoeff_X i)

private theorem X_notMem_sq (i : Fin m) :
    (X i : MvPowerSeries (Fin m) k) ∉ maximalIdeal (MvPowerSeries (Fin m) k) ^ 2 := by
  intro h
  have := constantCoeff_pderiv_eq_zero_of_mem_sq i h
  simp at this

/-- Cutting `k[[x]]` by one variable gives a regular local ring of one dimension less. -/
private theorem isRegularLocalRing_quotient_X (i : Fin m) :
    IsRegularLocalRing (MvPowerSeries (Fin m) k ⧸ Ideal.span {(X i : MvPowerSeries (Fin m) k)}) :=
  Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton
    (X_mem_maximalIdeal i) (X_notMem_sq i)

private theorem ringKrullDim_quotient_X (i : Fin m) :
    ringKrullDim (MvPowerSeries (Fin m) k ⧸ Ideal.span {(X i : MvPowerSeries (Fin m) k)}) + 1 =
      m := by
  rw [ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero (X_ne_zero' i)) (X_mem_maximalIdeal i),
    MvPowerSeries.ringKrullDim_eq]

private theorem mk_X_notMem_sq {i j : Fin m} (hij : i ≠ j) :
    letI := isRegularLocalRing_quotient_X (k := k) i
    Ideal.Quotient.mk (Ideal.span {X i}) (X j : MvPowerSeries (Fin m) k) ∉
      maximalIdeal (MvPowerSeries (Fin m) k ⧸ Ideal.span {X i}) ^ 2 := by
  have := isRegularLocalRing_quotient_X (k := k) i
  intro h
  rw [← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective,
    ← Ideal.map_pow, ← Ideal.mem_comap,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, Submodule.mem_sup] at h
  obtain ⟨a, ha, b, hb, hab⟩ := h
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hb
  have h1 := constantCoeff_pderiv_eq_zero_of_mem_sq j ha
  have h2 : constantCoeff (pderiv j (X j : MvPowerSeries (Fin m) k)) = 1 := by simp
  rw [← hab, map_add, Derivation.leibniz, pderiv_X_of_ne hij, smul_zero, zero_add, smul_eq_mul,
    map_add, h1, map_mul, constantCoeff_X, zero_mul, add_zero] at h2
  exact zero_ne_one h2

private theorem mk_X_mem_maximalIdeal (i j : Fin m) :
    letI := isRegularLocalRing_quotient_X (k := k) i
    Ideal.Quotient.mk (Ideal.span {X i}) (X j : MvPowerSeries (Fin m) k) ∈
      maximalIdeal (MvPowerSeries (Fin m) k ⧸ Ideal.span {X i}) := by
  have := isRegularLocalRing_quotient_X (k := k) i
  rw [← IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective]
  exact Ideal.mem_map_of_mem _ (X_mem_maximalIdeal j)

/-- `k[[x]] ⧸ (xᵢ, xⱼ)` is a regular local ring of dimension `m - 2`. -/
private theorem isRegularLocalRing_quotient_X_X {i j : Fin m} (hij : i ≠ j) :
    IsRegularLocalRing (MvPowerSeries (Fin m) k ⧸
        Ideal.span {(X i : MvPowerSeries (Fin m) k), X j}) ∧
      ringKrullDim (MvPowerSeries (Fin m) k ⧸
        Ideal.span {(X i : MvPowerSeries (Fin m) k), X j}) + 2 = m := by
  have := isRegularLocalRing_quotient_X (k := k) i
  have hsup : Ideal.span {X i} ⊔ Ideal.span {X j} =
      Ideal.span {(X i : MvPowerSeries (Fin m) k), X j} := by
    rw [← Ideal.span_union, Set.singleton_union]
  let e := (DoubleQuot.quotQuotEquivQuotSup (Ideal.span {(X i : MvPowerSeries (Fin m) k)})
    (Ideal.span {X j})).trans (Ideal.quotEquivOfEq hsup)
  have hmap : (Ideal.span {(X j : MvPowerSeries (Fin m) k)}).map
      (Ideal.Quotient.mk (Ideal.span {X i})) =
      Ideal.span {Ideal.Quotient.mk (Ideal.span {X i}) (X j)} := by
    rw [Ideal.map_span, Set.image_singleton]
  have hreg := Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton
    (mk_X_mem_maximalIdeal (k := k) i j) (mk_X_notMem_sq hij)
  rw [← hmap] at hreg
  refine ⟨IsRegularLocalRing.of_ringEquiv e, ?_⟩
  have hne : Ideal.Quotient.mk (Ideal.span {X i}) (X j : MvPowerSeries (Fin m) k) ≠ 0 :=
    fun h0 => mk_X_notMem_sq (k := k) hij (h0 ▸ zero_mem _)
  have : IsDomain (MvPowerSeries (Fin m) k ⧸ Ideal.span {(X i : MvPowerSeries (Fin m) k)}) :=
    IsRegularLocalRing.isDomain _
  have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero hne) (mk_X_mem_maximalIdeal (k := k) i j)
  rw [← hmap, ringKrullDim_eq_of_ringEquiv e] at hdim
  rw [← ringKrullDim_quotient_X (k := k) i, ← hdim, add_assoc]
  rfl

/-- The quotient of the model by the ideal of the double locus. -/
private def quotientDoubleLocusEquiv {h : MvPowerSeries (Fin m) k} {i j : Fin m}
    (hh : h ∈ Ideal.span {(X i : MvPowerSeries (Fin m) k), X j}) :
    (MvPowerSeries (Fin m) k ⧸ Ideal.span {h}) ⧸
        (Ideal.span {(X i : MvPowerSeries (Fin m) k), X j}).map
          (Ideal.Quotient.mk (Ideal.span {h})) ≃+*
      MvPowerSeries (Fin m) k ⧸ Ideal.span {(X i : MvPowerSeries (Fin m) k), X j} :=
  (DoubleQuot.quotQuotEquivQuotSup _ _).trans (Ideal.quotEquivOfEq
    (sup_eq_right.mpr ((Ideal.span_singleton_le_iff_mem _).mpr hh)))

private theorem map_span_pair_le_iff {h : MvPowerSeries (Fin m) k} {i j : Fin m}
    (q : Ideal (MvPowerSeries (Fin m) k ⧸ Ideal.span {h})) :
    (Ideal.span {(X i : MvPowerSeries (Fin m) k), X j}).map
        (Ideal.Quotient.mk (Ideal.span {h})) ≤ q ↔
      (Ideal.Quotient.mk _ (X i) ∈ q ∧ Ideal.Quotient.mk _ (X j) ∈ q) := by
  rw [Ideal.map_span, Ideal.span_le, Set.image_pair, Set.insert_subset_iff,
    Set.singleton_subset_iff]
  rfl

end MMP.Flips.SingLoc

/-! ### The double loci of the models and of their normalizations -/

namespace MMP.Flips

open IsLocalRing Normalization SingLoc SingLoc.Pub

variable {k : Type u} [Field k]

private theorem withBot_add_one_eq_natCast {d : WithBot ℕ∞} {m : ℕ}
    (h : d + 1 = ((m + 1 : ℕ) : WithBot ℕ∞)) : d = m := by
  induction d using WithBot.recBotCoe with
  | bot => exact absurd h (by rw [WithBot.bot_add]; exact WithBot.bot_ne_coe)
  | coe e =>
    have h' : e + 1 = ((m + 1 : ℕ) : ℕ∞) := by exact_mod_cast h
    induction e using ENat.recTopCoe with
    | top => exact absurd h' (by rw [top_add]; exact ENat.top_ne_natCast _)
    | coe a =>
      have : a + 1 = m + 1 := by exact_mod_cast h'
      exact_mod_cast (by omega : a = m)

private theorem withBot_add_two_eq_natCast {d : WithBot ℕ∞} {m : ℕ}
    (h : d + 2 = ((m + 1 + 1 : ℕ) : WithBot ℕ∞)) : d = m := by
  refine withBot_add_one_eq_natCast (withBot_add_one_eq_natCast ?_)
  rw [add_assoc, ← h]
  norm_num

/-- **The non-regular locus of the double normal crossing model** `k[[x]] ⧸ (x₀x₁)` is
`V(x₀, x₁)`. -/
theorem isRegularLocalRing_localization_dnc_iff_not_le {m : ℕ}
    (q : Ideal (MvPowerSeries (Fin (m + 1 + 1)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}))
    [q.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime q) ↔
      ¬ (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
        MvPowerSeries.X 1}).map (Ideal.Quotient.mk _) ≤ q := by
  rw [map_span_pair_le_iff]
  exact isRegularLocalRing_localization_dnc_iff q

/-- **The non-regular locus of the pinch point model** `k[[x]] ⧸ (x₀² - x₁x₂²)` is
`V(x₀, x₂)`. -/
theorem isRegularLocalRing_localization_pinch_iff_not_le {m : ℕ}
    (q : Ideal (MvPowerSeries (Fin (m + 3)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
        MvPowerSeries (Fin (m + 3)) k)}))
    [q.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime q) ↔
      ¬ (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 3)) k),
        MvPowerSeries.X 2}).map (Ideal.Quotient.mk _) ≤ q := by
  rw [map_span_pair_le_iff]
  exact isRegularLocalRing_localization_pinch_iff q

/-- The double locus `V(xᵢ, xⱼ)` of a hypersurface model `k[[x₁, …, x_m]] ⧸ (h)` with
`h ∈ (xᵢ, xⱼ)` is a regular local ring of dimension `m - 2`. -/
theorem isRegularLocalRing_and_ringKrullDim_quotient_map_span_pair {m : ℕ}
    {h : MvPowerSeries (Fin m) k} {i j : Fin m} (hij : i ≠ j)
    (hh : h ∈ Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin m) k), MvPowerSeries.X j}) :
    IsRegularLocalRing ((MvPowerSeries (Fin m) k ⧸ Ideal.span {h}) ⧸
        (Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin m) k), MvPowerSeries.X j}).map
          (Ideal.Quotient.mk _)) ∧
      ringKrullDim ((MvPowerSeries (Fin m) k ⧸ Ideal.span {h}) ⧸
        (Ideal.span {(MvPowerSeries.X i : MvPowerSeries (Fin m) k), MvPowerSeries.X j}).map
          (Ideal.Quotient.mk _)) + 2 = m := by
  obtain ⟨h1, h2⟩ := isRegularLocalRing_quotient_X_X (k := k) hij
  let e := quotientDoubleLocusEquiv hh
  exact ⟨IsRegularLocalRing.of_ringEquiv e.symm, by rw [ringKrullDim_eq_of_ringEquiv e]; exact h2⟩

/-- The double locus `V(x₀, x₁)` of the double normal crossing model `k[[x₀, …, x_{m+1}]] ⧸ (x₀x₁)`
is a regular local ring of dimension `m`. -/
theorem isRegularLocalRing_and_ringKrullDim_quotient_dnc {m : ℕ} :
    IsRegularLocalRing ((MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) ⧸
        (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
          MvPowerSeries.X 1}).map (Ideal.Quotient.mk _)) ∧
      ringKrullDim ((MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) ⧸
        (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1 + 1)) k),
          MvPowerSeries.X 1}).map (Ideal.Quotient.mk _)) = m := by
  have h01 : (0 : Fin (m + 1 + 1)) ≠ 1 := Fin.ne_of_val_ne (by simp)
  obtain ⟨h1, h2⟩ := isRegularLocalRing_and_ringKrullDim_quotient_map_span_pair (k := k) h01
    (h := MvPowerSeries.X 0 * MvPowerSeries.X 1)
    (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _)))
  exact ⟨h1, withBot_add_two_eq_natCast h2⟩

/-- The double locus `V(x₀, x₂)` of the pinch point model `k[[x₀, …, x_{m+2}]] ⧸ (x₀² - x₁x₂²)` is
a regular local ring of dimension `m + 1`. -/
theorem isRegularLocalRing_and_ringKrullDim_quotient_pinch {m : ℕ} :
    IsRegularLocalRing ((MvPowerSeries (Fin (m + 3)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
          MvPowerSeries (Fin (m + 3)) k)}) ⧸
        (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 3)) k),
          MvPowerSeries.X 2}).map (Ideal.Quotient.mk _)) ∧
      ringKrullDim ((MvPowerSeries (Fin (m + 3)) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
          MvPowerSeries (Fin (m + 3)) k)}) ⧸
        (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 3)) k),
          MvPowerSeries.X 2}).map (Ideal.Quotient.mk _)) = (m + 1 : ℕ) := by
  have h02 : (0 : Fin (m + 3)) ≠ 2 := Fin.ne_of_val_ne (by rw [Fin.val_zero, Fin.val_two]; omega)
  have hh : (MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
      MvPowerSeries (Fin (m + 3)) k) ∈ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 2} :=
    Ideal.mem_span_pair.mpr ⟨MvPowerSeries.X 0, -(MvPowerSeries.X 1 * MvPowerSeries.X 2),
      by ring⟩
  obtain ⟨h1, h2⟩ := isRegularLocalRing_and_ringKrullDim_quotient_map_span_pair (k := k) h02 hh
  exact ⟨h1, withBot_add_two_eq_natCast (m := m + 1) (h2.trans
    (congrArg (fun t : ℕ => (t : WithBot ℕ∞)) (by omega : m + 3 = m + 1 + 1 + 1)))⟩

/-- A quotient `A ⧸ I` is the quotient of `B` by the image of `I` along a surjection `ψ : A ↠ B`
whose kernel lies in `I`. -/
theorem nonempty_ringEquiv_quotient_map_of_surjective {A B : Type*} [CommRing A] [CommRing B]
    (ψ : A →+* B) (hψ : Function.Surjective ψ) (I : Ideal A) (hI : RingHom.ker ψ ≤ I) :
    Nonempty ((A ⧸ I) ≃+* (B ⧸ I.map ψ)) := by
  have hs : Function.Surjective ((Ideal.Quotient.mk (I.map ψ)).comp ψ) :=
    Ideal.Quotient.mk_surjective.comp hψ
  have hk : RingHom.ker ((Ideal.Quotient.mk (I.map ψ)).comp ψ) = I := by
    rw [← RingHom.comap_ker, Ideal.mk_ker, Ideal.comap_map_of_surjective' ψ hψ,
      sup_eq_left.mpr hI]
  exact ⟨(Ideal.quotEquivOfEq hk.symm).trans (RingHom.quotientKerEquivOfSurjective hs)⟩

/-- **The double locus of the normalization of a double normal crossing model.** Let `L` be a
local normal domain receiving `ψ : k[[x₀, …, x_{m+1}]] ⧸ (x₀x₁) → L`, integral and birational,
with no non-zero-divisor in its kernel. Then `L ⧸ (ψ x₀, ψ x₁)` is a regular local ring of
dimension `m`. -/
theorem isRegularLocalRing_and_ringKrullDim_quotient_map_of_dnc {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0) :
    IsRegularLocalRing (L ⧸ ((Ideal.span {(MvPowerSeries.X 0 :
        MvPowerSeries (Fin (m + 1 + 1)) k), MvPowerSeries.X 1}).map (Ideal.Quotient.mk _)).map ψ) ∧
      ringKrullDim (L ⧸ ((Ideal.span {(MvPowerSeries.X 0 :
        MvPowerSeries (Fin (m + 1 + 1)) k), MvPowerSeries.X 1}).map
          (Ideal.Quotient.mk _)).map ψ) = m := by
  obtain ⟨hsurj, Q, hQ, hQc⟩ := surjective_and_comap_of_dnc ψ hint hbir hnz
  have hker : RingHom.ker ψ ≤ (Ideal.span {(MvPowerSeries.X 0 :
      MvPowerSeries (Fin (m + 1 + 1)) k), MvPowerSeries.X 1}).map (Ideal.Quotient.mk _) := by
    rw [← hQc]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker.mp hr]
    exact zero_mem _
  obtain ⟨e⟩ := nonempty_ringEquiv_quotient_map_of_surjective ψ hsurj _ hker
  have h01 : (0 : Fin (m + 1 + 1)) ≠ 1 := Fin.ne_of_val_ne (by simp)
  obtain ⟨h1, h2⟩ := isRegularLocalRing_and_ringKrullDim_quotient_map_span_pair (k := k) h01
    (h := MvPowerSeries.X 0 * MvPowerSeries.X 1)
    (Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _)))
  refine ⟨IsRegularLocalRing.of_ringEquiv e, ?_⟩
  rw [← ringKrullDim_eq_of_ringEquiv e]
  exact withBot_add_two_eq_natCast h2

open PowerSeries in
private theorem pinchModelEquiv_mk_of_eq {m : ℕ} (f : MvPowerSeries (Fin (m + 3)) k)
    (p : Polynomial (MvPowerSeries (Fin (m + 1)) k)⟦X⟧)
    (hf : pinchTowerEquiv k m f = (p : (MvPowerSeries (Fin (m + 1)) k)⟦X⟧⟦X⟧)) :
    pinchModelEquiv k m (Ideal.Quotient.mk _ f) = Ideal.Quotient.mk _ p := by
  simp only [pinchModelEquiv, AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply,
    AlgEquiv.coe_ringEquiv]
  erw [Ideal.quotientEquivAlg_mk]
  rw [hf]
  exact pinchWeierstrassEquiv_mk k m _

/-- The pinch point model `k[[x₀, …, x_{m+2}]] ⧸ (x₀² - x₁x₂²)` is a domain. -/
theorem isDomain_quotient_pinch (m : ℕ) :
    IsDomain (MvPowerSeries (Fin (m + 3)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
        MvPowerSeries (Fin (m + 3)) k)}) := by
  have hb : (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k) ≠ 0 := X_ne_zero' 0
  have : IsDomain (PinchRing (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)) :=
    (pinchMap_injective _ hb).isDomain
  exact (pinchModelEquiv k m).toRingEquiv.toMulEquiv.isDomain

open PowerSeries in
/-- **The normalization of the pinch point model.** Let `L` be a local normal domain receiving
`ψ : k[[x₀, …, x_{m+2}]] ⧸ (x₀² - x₁x₂²) → L`, integral and birational, with no non-zero-divisor
in its kernel. Then `L ≅ B⟦u⟧`, `B = k[[x₂, …, x_{m+2}]]`, with `x₀ ↦ u x₂`, `x₁ ↦ u²` and
`xⱼ ↦ xⱼ` for `j ≥ 2`. -/
theorem exists_ringEquiv_powerSeries_of_pinch {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 3)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
        MvPowerSeries (Fin (m + 3)) k)}) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0) :
    ∃ σ : L ≃+* (MvPowerSeries (Fin (m + 1)) k)⟦X⟧,
      σ (ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 0))) =
        PowerSeries.X * PowerSeries.C (MvPowerSeries.X 0) ∧
      σ (ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 1))) = PowerSeries.X ^ 2 ∧
      (∀ j : Fin (m + 1), σ (ψ (Ideal.Quotient.mk _ (MvPowerSeries.X j.succ.succ))) =
        PowerSeries.C (MvPowerSeries.X j)) ∧
      ∀ c : k, σ (ψ (algebraMap k _ c)) = PowerSeries.C (MvPowerSeries.C c) := by
  set B := MvPowerSeries (Fin (m + 1)) k
  set b : B := MvPowerSeries.X 0
  have hb : b ≠ 0 := X_ne_zero' 0
  set ι := pinchModelEquiv k m
  have : IsDomain (PinchRing b) := (pinchMap_injective b hb).isDomain
  have := isDomain_quotient_pinch (k := k) m
  set ψ' : PinchRing b →+* L := ψ.comp ι.symm.toRingEquiv.toRingHom
  have hψ' : ∀ r, ψ' (ι r) = ψ r := fun r => by simp [ψ']
  have hψ'inj : Function.Injective ψ' := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    by_contra hr0
    refine hnz (ι.symm r) ?_ hr
    exact mem_nonZeroDivisors_of_ne_zero (by simpa using hr0)
  let : Algebra (PinchRing b) L := ψ'.toAlgebra
  have hal : ∀ r, algebraMap (PinchRing b) L r = ψ' r := fun r => by
    rw [RingHom.algebraMap_toAlgebra]
  have : FaithfulSMul (PinchRing b) L := (faithfulSMul_iff_algebraMap_injective _ _).2 hψ'inj
  have : Algebra.IsIntegral (PinchRing b) L := ⟨fun l => by
    obtain ⟨p, hp, hpl⟩ := hint l
    refine ⟨p.map ι.toRingEquiv.toRingHom, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    convert hpl using 2
    all_goals try rfl
    ext r
    exact (hal _).trans (hψ' r)⟩
  have hL : ∀ l : L, ∃ r s : PinchRing b, s ≠ 0 ∧
      algebraMap (PinchRing b) L s * l = algebraMap (PinchRing b) L r := fun l => by
    obtain ⟨r, s, hs, h⟩ := hbir l
    refine ⟨ι r, ι s, by simpa using nonZeroDivisors.ne_zero hs, ?_⟩
    rw [hal, hal, hψ', hψ']
    exact h
  let : Algebra (PinchRing b) B⟦X⟧ := (pinchMap b).toAlgebra
  have : FaithfulSMul (PinchRing b) B⟦X⟧ :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 (pinchMap_injective b hb)
  have : Algebra.IsIntegral (PinchRing b) B⟦X⟧ := ⟨fun f => pinchMap_isIntegralElem b f⟩
  have : IsRegularLocalRing B⟦X⟧ := PowerSeries.isRegularLocalRing B
  have : IsDomain B⟦X⟧ := IsRegularLocalRing.isDomain _
  have : UniqueFactorizationMonoid B⟦X⟧ := IsRegularLocalRing.uniqueFactorizationMonoid _
  obtain ⟨σ⟩ := nonempty_algEquiv_of_isIntegrallyClosed_of_birational (PinchRing b) L B⟦X⟧ hL
    (fun f => by
      obtain ⟨r, s, hs, h⟩ := pinchMap_birational hb f
      exact ⟨r, s, fun h0 => hs (by rw [h0, map_zero]), h⟩)
  have hσ : ∀ a, σ (ψ a) = pinchMap b (ι a) := fun a => by
    rw [← hψ', ← hal, AlgEquiv.commutes]
    rfl
  refine ⟨σ.toRingEquiv, ?_, ?_, fun j => ?_, fun c => ?_⟩
  · change σ _ = _
    rw [hσ, pinchModelEquiv_mk_of_eq _ Polynomial.X (by
      simp only [pinchTowerEquiv, AlgEquiv.trans_apply, MvPowerSeries.finSuccEquiv_X_zero]
      simp [powerSeriesMapAlgEquiv, mapAlgHom_apply]), pinchMap_mk_X]
  · change σ _ = _
    have e1 : MvPowerSeries.finSuccEquiv k (m + 2) (MvPowerSeries.X 1) =
        PowerSeries.C (MvPowerSeries.X 0) := MvPowerSeries.finSuccEquiv_X_succ (j := 0)
    rw [hσ, pinchModelEquiv_mk_of_eq _ (Polynomial.C PowerSeries.X) (by
      simp only [pinchTowerEquiv, AlgEquiv.trans_apply, e1]
      simp [powerSeriesMapAlgEquiv, mapAlgHom_apply, MvPowerSeries.finSuccEquiv_X_zero]),
      pinchMap_mk_C, expand_X]
  · change σ _ = _
    rw [hσ, pinchModelEquiv_mk_of_eq _ (Polynomial.C (PowerSeries.C (MvPowerSeries.X j))) (by
      simp only [pinchTowerEquiv, AlgEquiv.trans_apply, MvPowerSeries.finSuccEquiv_X_succ]
      simp [powerSeriesMapAlgEquiv, mapAlgHom_apply, MvPowerSeries.finSuccEquiv_X_succ]),
      pinchMap_mk_C, expand_C]
  · change σ _ = _
    rw [hσ, AlgEquiv.commutes]
    exact pinchMap_algebraMap k m c

open PowerSeries in
/-- **The double locus of the normalization of a pinch point model.** Let `L` be a local normal
domain receiving `ψ : k[[x₀, …, x_{m+2}]] ⧸ (x₀² - x₁x₂²) → L`, integral and birational, with no
non-zero-divisor in its kernel. Then `L ⧸ (ψ x₀, ψ x₂)` is a regular local ring of dimension
`m + 1`: it is `k[[u, x₃, …, x_{m+2}]]`. -/
theorem isRegularLocalRing_and_ringKrullDim_quotient_map_of_pinch {m : ℕ} {L : Type*}
    [CommRing L] [IsLocalRing L] [IsDomain L] [IsIntegrallyClosed L]
    (ψ : (MvPowerSeries (Fin (m + 3)) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 ^ 2 - MvPowerSeries.X 1 * MvPowerSeries.X 2 ^ 2 :
        MvPowerSeries (Fin (m + 3)) k)}) →+* L)
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors _, ψ s ≠ 0) :
    IsRegularLocalRing (L ⧸ ((Ideal.span {(MvPowerSeries.X 0 :
        MvPowerSeries (Fin (m + 3)) k), MvPowerSeries.X 2}).map (Ideal.Quotient.mk _)).map ψ) ∧
      ringKrullDim (L ⧸ ((Ideal.span {(MvPowerSeries.X 0 :
        MvPowerSeries (Fin (m + 3)) k), MvPowerSeries.X 2}).map
          (Ideal.Quotient.mk _)).map ψ) = (m + 1 : ℕ) := by
  obtain ⟨σ, h0, -, h2, -⟩ := exists_ringEquiv_powerSeries_of_pinch ψ hint hbir hnz
  set J := ((Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 3)) k),
    MvPowerSeries.X 2}).map (Ideal.Quotient.mk _)).map ψ
  have hJ : Ideal.span {PowerSeries.C (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)} =
      J.map σ := by
    have h2' := h2 0
    simp only [Fin.succ_zero_eq_one, Fin.succ_one_eq_two] at h2'
    simp only [J, Ideal.map_span, Set.image_pair]
    rw [h0, h2']
    refine le_antisymm (Ideal.span_mono (by simp)) ?_
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · exact Ideal.mem_span_singleton_self _
  let e₁ : (L ⧸ J) ≃+* ((MvPowerSeries (Fin (m + 1)) k)⟦X⟧ ⧸
      Ideal.span {PowerSeries.C (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)}) :=
    Ideal.quotientEquiv J _ σ hJ
  have e1 : MvPowerSeries.finSuccEquiv k (m + 1) (MvPowerSeries.X 1) =
      PowerSeries.C (MvPowerSeries.X 0) := MvPowerSeries.finSuccEquiv_X_succ (j := 0)
  let e₂ : (MvPowerSeries (Fin (m + 1 + 1)) k ⧸
      Ideal.span {(MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 1 + 1)) k)}) ≃+*
      ((MvPowerSeries (Fin (m + 1)) k)⟦X⟧ ⧸
        Ideal.span {PowerSeries.C (MvPowerSeries.X 0 : MvPowerSeries (Fin (m + 1)) k)}) :=
    Ideal.quotientEquiv _ _ (MvPowerSeries.finSuccEquiv k (m + 1)).toRingEquiv (by
      rw [Ideal.map_span, Set.image_singleton]
      exact congrArg (fun a => Ideal.span {a}) e1.symm)
  let e := e₁.trans e₂.symm
  have hreg := SingLoc.isRegularLocalRing_quotient_X (k := k) (m := m + 1 + 1) 1
  have hdim := SingLoc.ringKrullDim_quotient_X (k := k) (m := m + 1 + 1) 1
  refine ⟨IsRegularLocalRing.of_ringEquiv e.symm, ?_⟩
  rw [ringKrullDim_eq_of_ringEquiv e]
  exact withBot_add_one_eq_natCast hdim

end MMP.Flips

/-! ### The completed local rings of the normalization -/

namespace MMP.Flips

open CategoryTheory AlgebraicGeometry IsLocalRing

/-- **A factor of the normalization of `Ac`.** Let `N` be an `Ac`-algebra (through `j`) embedded
in the total ring of fractions of `Ac` as the integral closure of `Ac`, and `N ≅ ∏ᵢ Lᵢ`. Then the
map `Ac → L_{i₀}` to a nonzero factor is integral and birational, and no non-zero-divisor of `Ac`
lies in its kernel. -/
theorem factor_props_of_normalization {Ac N : Type*} [CommRing Ac] [CommRing N] {I : Type*}
    {L : I → Type*} [∀ i, CommRing (L i)] (j : Ac →+* N) (e : N ≃+* ∀ i, L i)
    (g : N →+* FractionRing Ac) (hg : Function.Injective g)
    (hrange : g.range = (integralClosure Ac (FractionRing Ac)).toSubring)
    (hgj : ∀ y, g (j y) = algebraMap Ac (FractionRing Ac) y) (i₀ : I) [Nontrivial (L i₀)] :
    let ψ : Ac →+* L i₀ := (Pi.evalRingHom L i₀).comp (e.toRingHom.comp j)
    (∀ l, ψ.IsIntegralElem l) ∧
      (∀ l, ∃ r s, s ∈ nonZeroDivisors Ac ∧ ψ s * l = ψ r) ∧
      (∀ s ∈ nonZeroDivisors Ac, ψ s ≠ 0) := by
  intro ψ
  classical
  have hψ : ∀ y, ψ y = e (j y) i₀ := fun _ => rfl
  have hgj' : g.comp j = algebraMap Ac (FractionRing Ac) := RingHom.ext hgj
  -- an element of `N` with prescribed component
  have hpre : ∀ l : L i₀, e (e.symm (Pi.single i₀ l)) i₀ = l := fun l => by simp
  refine ⟨fun l => ?_, fun l => ?_, fun s hs h0 => ?_⟩
  · set m := e.symm (Pi.single i₀ l)
    have hm : g m ∈ integralClosure Ac (FractionRing Ac) := by
      have : g m ∈ g.range := ⟨m, rfl⟩
      rw [hrange] at this; exact this
    obtain ⟨p, hp, hpe⟩ := hm
    refine ⟨p, hp, ?_⟩
    have h1 : g (Polynomial.eval₂ j m p) = 0 := by
      rw [Polynomial.hom_eval₂, hgj']; exact hpe
    have h2 : Polynomial.eval₂ j m p = 0 := hg (by rw [h1, map_zero])
    have h3 := Polynomial.hom_eval₂ p j ((Pi.evalRingHom L i₀).comp e.toRingHom) m
    rw [h2, map_zero] at h3
    rw [← hpre l]
    exact h3.symm
  · set m := e.symm (Pi.single i₀ l)
    obtain ⟨x, hab⟩ := IsLocalization.mk'_surjective (nonZeroDivisors Ac) (g m)
    set a := x.1
    set b := x.2
    refine ⟨a, b, b.2, ?_⟩
    have : g (j b * m) = g (j a) := by
      rw [map_mul, hgj, hgj, ← hab, mul_comm]
      exact IsLocalization.mk'_spec (FractionRing Ac) a b
    have := congrArg (fun z => e z i₀) (hg this)
    simp only [map_mul, Pi.mul_apply] at this
    rw [hψ, hψ, ← this, hpre]
  · set m := e.symm (Pi.single i₀ 1)
    have hzero : m * j s = 0 := by
      apply e.injective
      ext i
      rw [map_mul, Pi.mul_apply, map_zero, Pi.zero_apply]
      by_cases hi : i = i₀
      · subst hi
        rw [← hψ, h0, mul_zero]
      · simp [m, hi]
    have hgm : g m = 0 := by
      have := congrArg g hzero
      rw [map_mul, hgj, map_zero] at this
      exact ((IsLocalization.map_units (FractionRing Ac) ⟨s, hs⟩).mul_left_eq_zero).mp this
    have hm0 : m = 0 := hg (by rw [hgm, map_zero])
    have : e m i₀ = 1 := hpre 1
    rw [hm0, map_zero, Pi.zero_apply] at this
    exact zero_ne_one this

/-- If `ψ` is integral, birational and sends no non-zero-divisor to zero, so is `ψ ∘ e.symm`. -/
theorem props_comp_symm_of_ringEquiv {R R' L : Type*} [CommRing R] [CommRing R'] [CommRing L]
    (ψ : R →+* L) (e : R ≃+* R')
    (hint : ∀ l, ψ.IsIntegralElem l)
    (hbir : ∀ l, ∃ r s, s ∈ nonZeroDivisors R ∧ ψ s * l = ψ r)
    (hnz : ∀ s ∈ nonZeroDivisors R, ψ s ≠ 0) :
    (∀ l, (ψ.comp e.symm.toRingHom).IsIntegralElem l) ∧
      (∀ l, ∃ r s, s ∈ nonZeroDivisors R' ∧
        ψ.comp e.symm.toRingHom s * l = ψ.comp e.symm.toRingHom r) ∧
      (∀ s ∈ nonZeroDivisors R', ψ.comp e.symm.toRingHom s ≠ 0) := by
  refine ⟨fun l => ?_, fun l => ?_, fun s hs => ?_⟩
  · obtain ⟨p, hp, hpl⟩ := hint l
    refine ⟨p.map e.toRingHom, hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    convert hpl using 2
    ext r; simp
  · obtain ⟨r, s, hs, h⟩ := hbir l
    exact ⟨e r, e s, map_mem_nonZeroDivisors_of_equiv e hs, by simpa using h⟩
  · simpa using hnz _ (map_mem_nonZeroDivisors_of_equiv e.symm hs)

variable {k : Type u} [Field k] {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}

/-- The stalk map of the normalization at `y` is the composite of the structure map of the
pushforward stalk with the canonical map to the stalk at `y`. -/
private theorem canonical_comp_algebraMap_eq_stalkMap
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (y : Scheme.normalizationScheme X hX) (a : X.presheaf.stalk (Scheme.normalization X hX y)) :
    letI := Scheme.normalizationPushforwardStalkAlgebra X hX (Scheme.normalization X hX y)
    (TopCat.Presheaf.stalkSpecializes ((Scheme.normalization X hX).base _*
        (Scheme.normalizationScheme X hX).presheaf)
        (specializes_of_eq (rfl : (Scheme.normalization X hX).base y = _)) ≫
      TopCat.Presheaf.stalkPushforward _ (Scheme.normalization X hX).base
        (Scheme.normalizationScheme X hX).presheaf y).hom
      (algebraMap _ (Scheme.normalizationPushforwardStalk X hX _) a) =
      (Scheme.normalization X hX).stalkMap y a := by
  simp only [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
  rfl

variable (sX) in
/-- **The completed local ring of the normalization as a factor.** At a point `y` of `X^ν` over
`x`, the completion `𝒪̂_{X^ν,y}` is a local normal domain receiving `𝒪̂_{X,x}` integrally and
birationally, with no non-zero-divisor in the kernel, compatibly with the stalk map. -/
theorem exists_completion_factor_normalization [IsReduced X] [LocallyOfFiniteType sX]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (y : Scheme.normalizationScheme X hX) :
    IsNormalDomain (AdicCompletion
      (IsLocalRing.maximalIdeal ((X.normalizationScheme hX).presheaf.stalk y))
      ((X.normalizationScheme hX).presheaf.stalk y)) ∧
    ∃ ψ₀ : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (X.normalization hX y)))
        (X.presheaf.stalk (X.normalization hX y)) →+*
      AdicCompletion (IsLocalRing.maximalIdeal ((X.normalizationScheme hX).presheaf.stalk y))
        ((X.normalizationScheme hX).presheaf.stalk y),
      (∀ l, ψ₀.IsIntegralElem l) ∧
      (∀ l, ∃ r s, s ∈ nonZeroDivisors _ ∧ ψ₀ s * l = ψ₀ r) ∧
      (∀ s ∈ nonZeroDivisors _, ψ₀ s ≠ 0) ∧
      ∀ a : X.presheaf.stalk (X.normalization hX y),
        ψ₀ (algebraMap _ _ a) = algebraMap ((X.normalizationScheme hX).presheaf.stalk y) _
          ((X.normalization hX).stalkMap y a) := by
  obtain ⟨-, ⟨e₁, he₁⟩, g, hg, hrange, hgy⟩ :=
    MMP.Resolution.isReduced_adicCompletion_stalk_and_normalization_completion X sX hX
      (X.normalization hX y)
  let : Algebra (X.presheaf.stalk (X.normalization hX y))
      (Scheme.normalizationPushforwardStalk X hX (X.normalization hX y)) :=
    Scheme.normalizationPushforwardStalkAlgebra X hX (X.normalization hX y)
  have : LocallyOfFiniteType (X.normalization hX ≫ sX) := by
    have : IsFinite (X.normalization hX) := Scheme.isFinite_normalization
      (isNagataScheme_of_locallyOfFiniteType_over_field k sX) hX
    infer_instance
  have hexc : IsExcellent ((X.normalizationScheme hX).presheaf.stalk y) :=
    AlgebraicGeometry.isExcellent_stalk_of_locallyOfFiniteType_of_isExcellent k
      ((isExcellent_of_standard_classes_and_finiteType.{u, u}).1 k) (X.normalization hX ≫ sX) y
  have : IsNoetherianRing ((X.normalizationScheme hX).presheaf.stalk y) := hexc.1.1
  have hNormal : IsNormal (X.normalizationScheme hX) := Scheme.isNormal_normalizationScheme X hX
  have hn : IsNormalRing ((X.normalizationScheme hX).presheaf.stalk y) := by
    let : IsDomain ((X.normalizationScheme hX).presheaf.stalk y) := hNormal.stalk_isDomain y
    let : IsIntegrallyClosed ((X.normalizationScheme hX).presheaf.stalk y) := hNormal.stalk_normal y
    exact IsNormalRing.of_isIntegrallyClosed _
  refine ⟨AlgebraicGeometry.isNormalDomain_adicCompletion_of_isExcellent _ hexc hn, ?_⟩
  have : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal
      ((X.normalizationScheme hX).presheaf.stalk y))
      ((X.normalizationScheme hX).presheaf.stalk y)) :=
    AdicCompletion.isLocalRing_of_fg (IsNoetherian.noetherian _)
  obtain ⟨hint, hbir, hnz⟩ := factor_props_of_normalization
    (L := fun x' : (X.normalization hX).base ⁻¹' {X.normalization hX y} =>
      AdicCompletion (IsLocalRing.maximalIdeal ((X.normalizationScheme hX).presheaf.stalk x'))
        ((X.normalizationScheme hX).presheaf.stalk x'))
    Algebra.TensorProduct.includeRight.toRingHom e₁ g hg hrange hgy
    (⟨y, rfl⟩ : (X.normalization hX).base ⁻¹' {X.normalization hX y})
  generalize hψ₀ : (Pi.evalRingHom (fun x' : (X.normalization hX).base ⁻¹' {X.normalization hX y} =>
      AdicCompletion (IsLocalRing.maximalIdeal ((X.normalizationScheme hX).presheaf.stalk x'))
        ((X.normalizationScheme hX).presheaf.stalk x')) ⟨y, rfl⟩).comp
      (e₁.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom) = ψ₀ at hint hbir hnz
  refine ⟨ψ₀, hint, hbir, hnz, fun a => ?_⟩
  rw [← hψ₀]
  simp only [RingHom.comp_apply, Pi.evalRingHom_apply, AlgHom.toRingHom_eq_coe,
    RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply]
  rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
    ← Algebra.algebraMap_eq_smul_one]
  erw [he₁]
  rw [canonical_comp_algebraMap_eq_stalkMap]

end MMP.Flips
