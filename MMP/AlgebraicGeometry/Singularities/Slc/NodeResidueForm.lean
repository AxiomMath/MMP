/-!
# Even powers of the residue form on the node are normalized

Let `C = (xy = 0) = Spec k[x, y]/(xy)` be the affine node over a field `k`, with normalization
`n : C̄ = C₁ ⊔ C₂ ⟶ C`, where `C₁` is the branch `y = 0` and `C₂` the branch `x = 0`. The
dualizing sheaf `ω_C` is generated by the residue form `σ = dx/x = -dy/y`: on the branch `y = 0`
it is `dx/x`, on the branch `x = 0` it is `-dy/y`. For `m > 0` the section
`σ^m ∈ Γ(C, 𝒪_C(mK_C))` is the family `n^*(σ^m)|_{Cᵢ}` of rational `m`-canonical forms: `(dx/x)^m`
on the branch `y = 0` and `(-1)^m (dy/y)^m` on the branch `x = 0`. When `m` is even, `σ^m` is
normalized (FA 12.2.9): on both branches it is `(dz/z)^m` for the local parameter `z = x`,
resp. `z = y`, at the point over the node, and the branches are not proper.

## Main definitions

* `MMP.Flips.nodalCurve`: the affine node `C = Spec k[x, y]/(xy)` over `k`.
* `MMP.Flips.NormalizationComponents.nodalSigmaPow`: `n^*(σ^m)|_{Cᵢ}` on each component `Cᵢ` of
  the normalization of the node.

## Main results

* `MMP.Flips.NormalizationComponents.isNormalizedSlcSection_nodalSigmaPow`: for `m > 0` even,
  `σ^m` is a normalized section of `𝒪_C(mK_C)` (FA 12.2.9).

## Implementation notes

The branch on which a component `Cᵢ` lies is read off from the pull-back of the coordinate `x`
to the function field of `Cᵢ`: it is nonzero on the branch `y = 0` and zero on the branch
`x = 0`. The section `σ^m` is accordingly `(dx/x)^m` on the components where `x` does not vanish
identically and `(-1)^m (dy/y)^m` on the others; this is the restriction of `σ^m` for every
normalization datum `N` of `C`.

## References

* [J. Kollár et al., *Flips and abundance for algebraic threefolds*][KollarFlips], 12.2.9
-/

@[expose] public noncomputable section

universe u

open CategoryTheory AlgebraicGeometry TopologicalSpace Limits

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Flips

open MMP.Mori

variable (k : Type u) [Field k]

/-- The coordinate ring `k[x, y]/(xy)` of the affine node, `x = X 0`, `y = X 1`. -/
abbrev NodalCurveRing : Type u :=
  MvPolynomial (Fin 2) k ⧸
    Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)}

/-- The affine node `C = (xy = 0) = Spec k[x, y]/(xy)`. -/
abbrev nodalCurve : Scheme.{u} := Spec (.of (NodalCurveRing k))

/-- The structure morphism `C ⟶ Spec k` of the affine node. -/
abbrev nodalCurveStructure : nodalCurve k ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (NodalCurveRing k)))

/-- The coordinate functions `x = X 0` and `y = X 1` on the affine node, as global sections. -/
def nodalCurveCoord (j : Fin 2) : Γ(nodalCurve k, ⊤) :=
  (Scheme.ΓSpecIso (.of (NodalCurveRing k))).inv
    (Ideal.Quotient.mk _ (MvPolynomial.X j))

/-- **`S₂` for a ring of dimension at most one.** If `ringKrullDim R ≤ 1` and every
non-minimal prime of `R` contains a nonzerodivisor, then `Spec R` satisfies `S₂`. -/
theorem satisfiesS2_spec_of_ringKrullDim_le_one (R : CommRingCat) (hR : ringKrullDim R ≤ 1)
    (h : ∀ p : Ideal R, p.IsPrime → p ∉ minimalPrimes R → ∃ f ∈ p, f ∈ nonZeroDivisors R) :
    SatisfiesS2 (Spec R) := by
  intro x
  let _ : Algebra R ((Spec R).presheaf.stalk x) := StructureSheaf.stalkAlgebra R x
  have : IsLocalization.AtPrime ((Spec R).presheaf.stalk x) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk R x
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height x.asIdeal]
  by_cases hmin : x.asIdeal ∈ minimalPrimes R
  · refine ⟨[], by simp, RingTheory.Sequence.IsRegular.nil _ _, ?_⟩
    rw [Ideal.height_eq_zero_iff.mpr hmin]
    simp
  · obtain ⟨f, hfp, hf⟩ := h x.asIdeal inferInstance hmin
    have hm : algebraMap R ((Spec R).presheaf.stalk x) f ∈
        IsLocalRing.maximalIdeal ((Spec R).presheaf.stalk x) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff _ x.asIdeal f).mpr hfp
    have hnz : algebraMap R ((Spec R).presheaf.stalk x) f ∈
        nonZeroDivisors ((Spec R).presheaf.stalk x) :=
      IsLocalization.map_nonZeroDivisors_le x.asIdeal.primeCompl _ ⟨f, hf, rfl⟩
    have hall : ∀ a ∈ [algebraMap R ((Spec R).presheaf.stalk x) f],
        a ∈ IsLocalRing.maximalIdeal ((Spec R).presheaf.stalk x) :=
      List.forall_mem_singleton.mpr hm
    refine ⟨[algebraMap R _ f], hall, ?_, ?_⟩
    · refine RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal _ hall ?_
      rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff]
      refine isSMulRegular_iff_right_eq_zero_of_smul.mpr fun m hm' => ?_
      rw [smul_eq_mul] at hm'
      exact (mem_nonZeroDivisors_iff_left.mp hnz) m hm'
    · refine min_le_of_right_le (le_trans ?_ (hR.trans (by simp)))
      exact Ideal.height_le_ringKrullDim_of_ne_top Ideal.IsPrime.ne_top'

/-- The affine node is separated and of finite type over `k`. -/
theorem isFiniteTypeSeparated_nodalCurve : IsFiniteTypeSeparated (nodalCurveStructure k) := by
  refine ⟨inferInstance, ?_, inferInstance⟩
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- `k[x, y]/(xy)` is reduced: `(xy)` is a radical ideal, `x` and `y` being non-associated
primes. -/
instance isReduced_nodalCurveRing : _root_.IsReduced (NodalCurveRing k) := by
  rw [← Ideal.isRadical_iff_quotient_reduced]
  rintro f ⟨n, hn⟩
  rw [Ideal.mem_span_singleton] at hn ⊢
  have h0 : Prime (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) := MvPolynomial.X_prime
  have h1 : Prime (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) := MvPolynomial.X_prime
  obtain ⟨g, rfl⟩ := h0.dvd_of_dvd_pow (dvd_trans (dvd_mul_right _ _) hn)
  have hq : MvPolynomial.X 1 ∣ MvPolynomial.X 0 * g :=
    h1.dvd_of_dvd_pow (dvd_trans (dvd_mul_left _ _) hn)
  rcases h1.dvd_or_dvd hq with ⟨c, hc⟩ | h
  · have := congrArg (MvPolynomial.eval (fun i : Fin 2 => if i = 0 then (1 : k) else 0)) hc
    simp at this
  · exact mul_dvd_mul_left _ h

/-- The affine node is a reduced scheme. -/
theorem isReduced_nodalCurve : IsReduced (nodalCurve k) :=
  (affine_isReduced_iff _).mpr (isReduced_nodalCurveRing k)

/-- `k[x, y]/(x_j)` has dimension one. -/
theorem ringKrullDim_quotient_span_X (j : Fin 2) :
    ringKrullDim (MvPolynomial (Fin 2) k ⧸
      Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}) = 1 := by
  apply le_antisymm
  · have h := ringKrullDim_quotient_succ_le_of_nonZeroDivisor
      (R := MvPolynomial (Fin 2) k) (r := MvPolynomial.X j)
      (mem_nonZeroDivisors_of_ne_zero (MvPolynomial.X_ne_zero j))
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add] at h
    generalize ringKrullDim (MvPolynomial (Fin 2) k ⧸
      Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}) = d at h ⊢
    exact ENat.WithBot.add_le_add_one_right_iff.mp (by rwa [one_add_one_eq_two])
  · rw [ringKrullDim_quotient, Order.one_le_krullDim_iff]
    have hm : (RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k))).IsPrime := RingHom.ker_isPrime _
    have hj : (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}).IsPrime :=
      (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero j)).mpr MvPolynomial.X_prime
    have hle : Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)} ≤
        RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)) := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      simp
    have hlt : Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)} <
        RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)) := by
      refine lt_of_le_of_ne hle fun h => ?_
      have hmem : (MvPolynomial.X (1 - j) : MvPolynomial (Fin 2) k) ∈
          RingHom.ker (MvPolynomial.eval (0 : Fin 2 → k)) := by simp
      rw [← h, Ideal.mem_span_singleton] at hmem
      obtain ⟨c, hc⟩ := hmem
      have := congrArg (MvPolynomial.eval (fun i : Fin 2 => if i = j then (0 : k) else 1)) hc
      fin_cases j <;> simp at this
    exact ⟨⟨⟨_, hj⟩, (PrimeSpectrum.mem_zeroLocus _ _).mpr le_rfl⟩,
      ⟨⟨_, hm⟩, (PrimeSpectrum.mem_zeroLocus _ _).mpr hle⟩, hlt⟩

/-- The branch `x_j = 0` of the node, the prime ideal `(x_j)` of `k[x, y]/(xy)`. -/
abbrev nodalBranchIdeal (j : Fin 2) : Ideal (NodalCurveRing k) :=
  (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}).map (Ideal.Quotient.mk _)

/-- The branch ideals `(x)` and `(y)` of `k[x, y]/(xy)` are prime. -/
theorem isPrime_nodalBranchIdeal (j : Fin 2) : (nodalBranchIdeal k j).IsPrime := by
  have : (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}).IsPrime :=
    (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero j)).mpr MvPolynomial.X_prime
  refine Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective ?_
  rw [Ideal.mk_ker, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
    Ideal.mem_span_singleton]
  fin_cases j
  · exact dvd_mul_right _ _
  · exact dvd_mul_left _ _

/-- The minimal primes of `k[x, y]/(xy)` are `(x)` and `(y)`. -/
theorem exists_eq_map_span_X_of_mem_minimalPrimes {p : Ideal (NodalCurveRing k)}
    (hp : p ∈ minimalPrimes (NodalCurveRing k)) :
    ∃ j : Fin 2, p = (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}).map
      (Ideal.Quotient.mk _) := by
  have hpp : p.IsPrime := hp.1.1
  have hP : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈
      p.comap (Ideal.Quotient.mk _) := by
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)]
    exact p.zero_mem
  have hj : ∃ j : Fin 2, (MvPolynomial.X j : MvPolynomial (Fin 2) k) ∈
      p.comap (Ideal.Quotient.mk _) := by
    rcases (Ideal.comap_isPrime (Ideal.Quotient.mk _) p).mem_or_mem hP with h | h
    exacts [⟨0, h⟩, ⟨1, h⟩]
  obtain ⟨j, hj⟩ := hj
  have hqp : (Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)}).map
      (Ideal.Quotient.mk _) ≤ p := by
    rwa [Ideal.map_le_iff_le_comap, Ideal.span_le, Set.singleton_subset_iff]
  exact ⟨j, le_antisymm (hp.2 ⟨isPrime_nodalBranchIdeal k j, bot_le⟩ hqp) hqp⟩

/-- Every irreducible component of the node (a branch `x = 0` or `y = 0`) has dimension one. -/
theorem topologicalKrullDim_of_mem_irreducibleComponents_nodalCurve
    {Z : Set (nodalCurve k)} (hZ : Z ∈ irreducibleComponents (nodalCurve k)) :
    topologicalKrullDim Z = 1 := by
  change Z ∈ irreducibleComponents (PrimeSpectrum (NodalCurveRing k)) at hZ
  rw [← PrimeSpectrum.zeroLocus_minimalPrimes] at hZ
  obtain ⟨p, hp, rfl⟩ := hZ
  obtain ⟨j, rfl⟩ := exists_eq_map_span_X_of_mem_minimalPrimes k hp
  have hle : Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)} ≤
      Ideal.span {(MvPolynomial.X j : MvPolynomial (Fin 2) k)} := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_span_singleton]
    fin_cases j
    · exact dvd_mul_right _ _
    · exact dvd_mul_left _ _
  change topologicalKrullDim (PrimeSpectrum.zeroLocus (_ : Set (NodalCurveRing k))) = 1
  rw [topologicalKrullDim_zeroLocus,
    ringKrullDim_eq_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hle),
    ringKrullDim_quotient_span_X]

/-- The affine node is a curve: reduced, separated, of finite type and of pure dimension one. -/
theorem isNFold_nodalCurve : IsNFold (nodalCurveStructure k) 1 :=
  ⟨isFiniteTypeSeparated_nodalCurve k, isReduced_nodalCurve k,
    fun _ hZ => by exact_mod_cast topologicalKrullDim_of_mem_irreducibleComponents_nodalCurve k hZ⟩

/-! ### The affine line and the branches of the node -/

/-- The structure morphism `𝔸¹_k = Spec k[t] ⟶ Spec k` of the affine line. -/
abbrev lineStructure : Spec (.of (Polynomial k)) ⟶ Spec (.of k) :=
  Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))

/-- The affine line `𝔸¹_k` is smooth over `k`. -/
instance smooth_lineStructure : Smooth (lineStructure k) := by
  rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
  exact RingHom.smooth_algebraMap.mpr (Algebra.Smooth.mk)

/-- A smooth morphism has smooth locus everything. -/
theorem isSmoothScheme_of_smooth {X Y : Scheme.{u}} (f : X ⟶ Y) [Smooth f] :
    IsSmoothScheme f :=
  (MMP.Mori.isSmoothScheme_iff f).2 inferInstance

/-- The affine line has dimension one. -/
theorem topologicalKrullDim_line : topologicalKrullDim (Spec (.of (Polynomial k))) = 1 := by
  change topologicalKrullDim (PrimeSpectrum (Polynomial k)) = 1
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
    Polynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field]
  rfl

/-- The affine line is not proper over `k`: a proper affine morphism is finite, and `k[t]` is not a
finite `k`-module. -/
theorem not_isProper_lineStructure : ¬ IsProper (lineStructure k) := by
  intro h
  have : IsFinite (lineStructure k) :=
    IsFinite.iff_isProper_and_isAffineHom.mpr ⟨h, inferInstance⟩
  rw [IsFinite.SpecMap_iff] at this
  exact Polynomial.not_finite (RingHom.finite_algebraMap.mp this)

/-- The parametrization `k[x, y]/(xy) → k[t]` of the branch of the node along which the
coordinate `x_j` does not vanish: `x_j ↦ t`, the other coordinate `↦ 0`. -/
def nodalBranchMap (j : Fin 2) : NodalCurveRing k →+* Polynomial k :=
  Ideal.Quotient.lift _
    (MvPolynomial.eval₂Hom Polynomial.C fun l => if l = j then Polynomial.X else 0) <| by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
    fin_cases j <;> simp

/-- The parametrization `nodalBranchMap k j` is a `k`-algebra map. -/
theorem nodalBranchMap_comp_algebraMap (j : Fin 2) :
    (nodalBranchMap k j).comp (algebraMap k (NodalCurveRing k)) = algebraMap k (Polynomial k) := by
  ext a
  simp [nodalBranchMap]

/-- The parametrization of a branch, as a morphism `𝔸¹ ⟶ C`. -/
abbrev nodalBranch (j : Fin 2) : Spec (.of (Polynomial k)) ⟶ nodalCurve k :=
  Spec.map (CommRingCat.ofHom (nodalBranchMap k j))

/-- The parametrization of a branch of the node is a morphism over `Spec k`. -/
theorem nodalBranch_comp_structure (j : Fin 2) :
    nodalBranch k j ≫ nodalCurveStructure k = lineStructure k := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, nodalBranchMap_comp_algebraMap]

/-- The section `k[t] → k[x, y]/(xy)`, `t ↦ x_j`, of `nodalBranchMap`. -/
def nodalBranchSection (j : Fin 2) : Polynomial k →+* NodalCurveRing k :=
  Polynomial.eval₂RingHom (algebraMap k (NodalCurveRing k)) (Ideal.Quotient.mk _ (MvPolynomial.X j))

/-- The ideal generated by the coordinates other than `x_j`. -/
abbrev nodalOffBranchIdeal (j : Fin 2) : Ideal (NodalCurveRing k) :=
  Ideal.span ((fun l => Ideal.Quotient.mk _ (MvPolynomial.X l)) '' {l | l ≠ j})

/-- `nodalBranchSection k j` is a section of `nodalBranchMap k j`. -/
theorem nodalBranchMap_nodalBranchSection (j : Fin 2) (a : Polynomial k) :
    nodalBranchMap k j (nodalBranchSection k j a) = a := by
  induction a using Polynomial.induction_on' with
  | add p q hp hq => rw [RingHom.map_add, RingHom.map_add, hp, hq]
  | monomial n c =>
    simp [nodalBranchSection, nodalBranchMap,
      Polynomial.C_mul_X_pow_eq_monomial]

/-- Every `r ∈ k[x, y]/(xy)` is congruent to `nodalBranchSection k j (nodalBranchMap k j r)`
modulo the coordinates other than `x_j`. -/
theorem sub_nodalBranchSection_mem (j : Fin 2) (r : NodalCurveRing k) :
    r - nodalBranchSection k j (nodalBranchMap k j r) ∈ nodalOffBranchIdeal k j := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
  induction p using MvPolynomial.induction_on with
  | C a =>
    simp [nodalBranchSection, nodalBranchMap]
  | add p q hp hq =>
    have := Ideal.add_mem _ hp hq
    rw [RingHom.map_add, RingHom.map_add, RingHom.map_add, add_sub_add_comm]
    exact this
  | mul_X p n hp =>
    by_cases hn : n = j
    · subst hn
      have := Ideal.mul_mem_right (Ideal.Quotient.mk _ (MvPolynomial.X n)) _ hp
      simpa [nodalBranchMap, nodalBranchSection, sub_mul] using this
    · have hmem : Ideal.Quotient.mk _ (MvPolynomial.X n) ∈ nodalOffBranchIdeal k j :=
        Ideal.subset_span ⟨n, hn, rfl⟩
      have := Ideal.mul_mem_left _ (Ideal.Quotient.mk _ p) hmem
      simpa [nodalBranchMap, nodalBranchSection, hn] using this

/-- In `k[x, y]/(xy)` the product of two distinct coordinates vanishes. -/
theorem mk_X_mul_mk_X_eq_zero_of_ne {j l : Fin 2} (h : l ≠ j) :
    (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k) *
      Ideal.Quotient.mk _ (MvPolynomial.X l) = 0 := by
  rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
  fin_cases j <;> fin_cases l
  · exact absurd rfl h
  · exact Ideal.mem_span_singleton_self _
  · rw [mul_comm]
    exact Ideal.mem_span_singleton_self _
  · exact absurd rfl h

/-- The coordinates other than `x_j` vanish in the localization of `k[x, y]/(xy)` at `x_j`. -/
theorem algebraMap_away_eq_zero_of_mem (j : Fin 2) {r : NodalCurveRing k}
    (hr : r ∈ nodalOffBranchIdeal k j) :
    algebraMap (NodalCurveRing k)
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) r = 0 := by
  have hu := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away
    (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k))
    (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)
  refine Submodule.span_induction ?_ (by simp) (fun a b _ _ ha hb => by rw [RingHom.map_add, ha, hb, add_zero])
    (fun a b _ hb => by simp [hb]) hr
  rintro _ ⟨l, hl, rfl⟩
  apply hu.mul_left_cancel
  rw [← map_mul, mk_X_mul_mk_X_eq_zero_of_ne k hl, map_zero, mul_zero]

/-- Via `t ↦ x_j`, the localization of `k[x, y]/(xy)` at `x_j` is the localization `k[t, t⁻¹]` of
`k[t]` at `t`. -/
theorem isLocalization_away (j : Fin 2) (x : NodalCurveRing k)
    (hxj : x = Ideal.Quotient.mk _ (MvPolynomial.X j))
    [Algebra (Polynomial k) (Localization.Away x)]
    (h : algebraMap (Polynomial k) (Localization.Away x) =
      (algebraMap _ _).comp (nodalBranchSection k j)) :
    IsLocalization.Away (Polynomial.X : Polynomial k) (Localization.Away x) := by
  subst hxj
  have hσX : nodalBranchSection k j Polynomial.X = Ideal.Quotient.mk _ (MvPolynomial.X j) := by
    simp [nodalBranchSection]
  have hsec : ∀ r : NodalCurveRing k,
      algebraMap (NodalCurveRing k) (Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k))
        (nodalBranchSection k j (nodalBranchMap k j r)) =
      algebraMap _ (Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) r := by
    intro r
    rw [← sub_eq_zero, ← RingHom.map_sub, ← neg_sub, RingHom.map_neg,
      algebraMap_away_eq_zero_of_mem k j (sub_nodalBranchSection_mem k j r), neg_zero]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, n, rfl⟩
    rw [h]
    change IsUnit (algebraMap _ (Localization.Away
      (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k))
      (nodalBranchSection k j (Polynomial.X ^ n)))
    rw [map_pow, hσX, map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit
      (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)).pow n
  · intro z
    obtain ⟨⟨r, _, n, rfl⟩, hz⟩ :=
      IsLocalization.surj (Submonoid.powers
        (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) z
    refine ⟨⟨nodalBranchMap k j r, ⟨Polynomial.X ^ n, n, rfl⟩⟩, ?_⟩
    rw [h]
    change z * algebraMap _ _ (nodalBranchSection k j (Polynomial.X ^ n)) =
      algebraMap _ _ (nodalBranchSection k j (nodalBranchMap k j r))
    rwa [hsec, map_pow, hσX]
  · intro a b hab
    rw [h] at hab
    change algebraMap _ (Localization.Away
      (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k))
        (nodalBranchSection k j a) =
      algebraMap _ _ (nodalBranchSection k j b) at hab
    obtain ⟨⟨_, n, rfl⟩, hc⟩ := (IsLocalization.eq_iff_exists
      (Submonoid.powers (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) _).mp hab
    refine ⟨⟨Polynomial.X ^ n, n, rfl⟩, ?_⟩
    have := congrArg (nodalBranchMap k j) hc
    simp only [map_mul, map_pow, nodalBranchMap_nodalBranchSection] at this
    have hx : nodalBranchMap k j (Ideal.Quotient.mk _ (MvPolynomial.X j)) = Polynomial.X := by
      simp [nodalBranchMap]
    rwa [hx] at this

/-- The localization of `k[x, y]/(xy)` at the coordinate `x_j` is smooth over `k`. -/
theorem smooth_away (j : Fin 2) :
    Algebra.Smooth k
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) := by
  let : Algebra (Polynomial k)
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) :=
    ((algebraMap _ _).comp (nodalBranchSection k j)).toAlgebra
  have := isLocalization_away k j _ rfl rfl
  have : Algebra.Smooth (Polynomial k)
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) :=
    Algebra.Smooth.of_isLocalization_Away (Polynomial.X : Polynomial k)
  have : IsScalarTower k (Polynomial k)
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) := by
    refine IsScalarTower.of_algebraMap_eq fun a => ?_
    change _ = algebraMap (NodalCurveRing k) _ (nodalBranchSection k j (Polynomial.C a))
    rw [IsScalarTower.algebraMap_apply k (NodalCurveRing k)]
    simp [nodalBranchSection]
  have : Algebra.Smooth k (Polynomial k) := Algebra.Smooth.mk
  exact Algebra.Smooth.comp k (Polynomial k) _

/-- The node is smooth over `k` on the basic open `D(x_j)`, which is `Spec k[t, t⁻¹]`. -/
theorem smooth_basicOpen_ι (j : Fin 2) :
    Smooth (Scheme.Opens.ι (X := nodalCurve k)
      (PrimeSpectrum.basicOpen (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)) ≫
      nodalCurveStructure k) := by
  have e := basicOpenIsoSpecAway_hom_SpecMap (R := .of (NodalCurveRing k))
    (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)
  have : Smooth (Spec.map (CommRingCat.ofHom (algebraMap k
      (Localization.Away (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k))))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.mpr (smooth_away k j)
  have h : Smooth ((basicOpenIsoSpecAway (R := .of (NodalCurveRing k))
      (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k)).hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap k _))) := inferInstance
  rwa [IsScalarTower.algebraMap_eq k (NodalCurveRing k), CommRingCat.ofHom_comp, Spec.map_comp,
    ← Category.assoc, e] at h

/-- The basic open `D(x_j)` of the node lies in its smooth locus. -/
theorem basicOpen_le_smoothLocus (j : Fin 2) :
    PrimeSpectrum.basicOpen (Ideal.Quotient.mk _ (MvPolynomial.X j) : NodalCurveRing k) ≤
      smoothLocus (nodalCurveStructure k) :=
  le_sSup (smooth_basicOpen_ι k j)

/-- Evaluation at the origin, `k[x, y]/(xy) → k`, `x, y ↦ 0`. -/
def nodalEval : NodalCurveRing k →+* k :=
  Ideal.Quotient.lift _ (MvPolynomial.eval 0) <| by
    intro a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp ha
    simp

/-- The origin `x = y = 0` of the node. -/
def nodalOrigin : nodalCurve k := ⟨RingHom.ker (nodalEval k), RingHom.ker_isPrime _⟩

/-- The coordinate `x_j` vanishes at the origin of the node. -/
theorem mk_X_mem_nodalOrigin (j : Fin 2) :
    Ideal.Quotient.mk _ (MvPolynomial.X j) ∈ (nodalOrigin k).asIdeal := by
  simp [nodalOrigin, nodalEval]

/-- Every `r ∈ k[x, y]/(xy)` is congruent to its value `nodalEval k r` at the origin modulo the
ideal `(x, y)`. -/
theorem sub_nodalEval_mem (r : NodalCurveRing k) :
    r - algebraMap k (NodalCurveRing k) (nodalEval k r) ∈
      Ideal.span (Set.range fun l : Fin 2 => (Ideal.Quotient.mk _ (MvPolynomial.X l) :
        NodalCurveRing k)) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective r
  induction p using MvPolynomial.induction_on with
  | C a => simp [nodalEval]
  | add p q hp hq =>
    have := Ideal.add_mem _ hp hq
    simpa [map_add, add_sub_add_comm] using this
  | mul_X p n hp =>
    have hmem : (Ideal.Quotient.mk _ (MvPolynomial.X n) : NodalCurveRing k) ∈
        Ideal.span (Set.range fun l : Fin 2 => (Ideal.Quotient.mk _ (MvPolynomial.X l) :
          NodalCurveRing k)) := Ideal.subset_span ⟨n, rfl⟩
    have := Ideal.mul_mem_left _ (Ideal.Quotient.mk _ p) hmem
    simpa [nodalEval] using this

/-- A point of the node at which both coordinates vanish is the origin. -/
theorem eq_nodalOrigin_of_mem {x : nodalCurve k}
    (h : ∀ l : Fin 2, (Ideal.Quotient.mk _ (MvPolynomial.X l) : NodalCurveRing k) ∈ x.asIdeal) :
    x = nodalOrigin k := by
  have hle : RingHom.ker (nodalEval k) ≤ x.asIdeal := by
    intro r hr
    have := sub_nodalEval_mem k r
    rw [RingHom.mem_ker.mp hr, map_zero, sub_zero] at this
    exact (Ideal.span_le.mpr (by rintro _ ⟨l, rfl⟩; exact h l)) this
  have hmax : (RingHom.ker (nodalEval k)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ fun a =>
      ⟨algebraMap k _ a, by simp [nodalEval]⟩
  exact PrimeSpectrum.ext (hmax.eq_of_le x.isPrime.ne_top hle).symm

/-- The ideal `(xy)` is the ideal of the Stacks nodal equation `xy - 0`. -/
theorem span_nodalEquation_zero :
    Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) k)} =
      Ideal.span {Stacks.nodalEquation k 0} := by
  simp [Stacks.nodalEquation]

/-- `k[x, y]/(xy)` is the nodal chart `k[x, y]/(xy - 0)` of the Stacks project. -/
def nodalChartEquiv : NodalCurveRing k ≃+* Stacks.nodalChartRing k 0 :=
  Ideal.quotEquivOfEq (span_nodalEquation_zero k)

/-- The prime ideal of the origin of the node is `(x, y)`. -/
theorem nodalOrigin_eq_span :
    (nodalOrigin k).asIdeal = Ideal.span (Set.range fun l : Fin 2 =>
      (Ideal.Quotient.mk _ (MvPolynomial.X l) : NodalCurveRing k)) := by
  apply le_antisymm
  · intro r hr
    have := sub_nodalEval_mem k r
    rwa [RingHom.mem_ker.mp hr, map_zero, sub_zero] at this
  · rw [Ideal.span_le]
    rintro _ ⟨l, rfl⟩
    exact mk_X_mem_nodalOrigin k l

/-- Under `nodalChartEquiv`, the ideal of the origin of the node is the ideal of the origin of the
Stacks nodal chart. -/
theorem map_nodalOrigin_nodalChartEquiv :
    (nodalOrigin k).asIdeal.map (nodalChartEquiv k : NodalCurveRing k →+* _) =
      Stacks.NodalChart.chartOrigin (IsLocalRing.maximalIdeal k) 0 := by
  rw [Stacks.NodalChart.chartOrigin_eq, nodalOrigin_eq_span, Ideal.map_span,
    IsLocalRing.maximalIdeal_eq_bot, Ideal.map_bot, bot_sup_eq, ← Set.range_comp]
  congr 1

/-- The ideal of the origin of the node is prime. -/
instance isPrime_nodalOrigin : (nodalOrigin k).asIdeal.IsPrime := RingHom.ker_isPrime _

/-- Under `nodalChartEquiv`, the complement of the origin of the node is the complement of the
origin of the Stacks nodal chart. -/
theorem map_primeCompl_nodalOrigin :
    haveI := (Stacks.NodalChart.chartOrigin_isMaximal
      (zero_mem (IsLocalRing.maximalIdeal k))).isPrime
    (nodalOrigin k).asIdeal.primeCompl.map (nodalChartEquiv k).toMonoidHom =
      (Stacks.NodalChart.chartOrigin (IsLocalRing.maximalIdeal k) 0).primeCompl := by
  ext y
  simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
  rw [← map_nodalOrigin_nodalChartEquiv k]
  constructor
  · rintro ⟨z, hz, rfl⟩ hmem
    apply hz
    rw [Ideal.map_comap_of_equiv] at hmem
    simpa using hmem
  · intro hy
    refine ⟨(nodalChartEquiv k).symm y, fun hmem => hy ?_, by simp⟩
    rw [Ideal.map_comap_of_equiv]
    simpa using hmem

/-- `nodalChartEquiv` is compatible with the `k`-algebra structures. -/
theorem nodalChartEquiv_algebraMap (a : k) :
    nodalChartEquiv k (algebraMap k (NodalCurveRing k) a) =
      algebraMap k (Stacks.nodalChartRing k 0) a := by
  rw [Stacks.algebraMap_nodalChartRing_eq]
  rfl

/-- The origin of the node is a closed point. -/
theorem isClosed_nodalOrigin : IsClosed ({nodalOrigin k} : Set (nodalCurve k)) := by
  refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal
    (nodalOrigin k : PrimeSpectrum (NodalCurveRing k))).mpr ?_
  exact RingHom.ker_isMaximal_of_surjective _ fun a =>
    ⟨algebraMap k _ a, by simp [nodalEval]⟩

/-- The structure map `k → 𝒪_{C,x}` of the node is `k → k[x, y]/(xy)` followed by the canonical
map to the stalk. -/
theorem stalkStructureMap_eq_toStalk (x : nodalCurve k) (a : k) :
    MMP.Flips.stalkStructureMap (nodalCurveStructure k) x a =
      (StructureSheaf.toStalk (NodalCurveRing k) x).hom (algebraMap k (NodalCurveRing k) a) := by
  have hB : StructureSheaf.toStalk (NodalCurveRing k) x =
      (Scheme.ΓSpecIso (CommRingCat.of (NodalCurveRing k))).inv ≫
        (Spec (CommRingCat.of (NodalCurveRing k))).presheaf.germ ⊤ x trivial := by
    delta StructureSheaf.toStalk
    rfl
  have hnat : (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
      (nodalCurveStructure k).appTop =
      CommRingCat.ofHom (algebraMap k (NodalCurveRing k)) ≫
        (Scheme.ΓSpecIso (CommRingCat.of (NodalCurveRing k))).inv := by
    rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality (CommRingCat.ofHom _)
  rw [hB]
  unfold MMP.Flips.stalkStructureMap
  rw [← Category.assoc, hnat]
  rfl

/-- **The completed local ring of the node at the origin** is `k[[x₀, x₁]]/(x₀x₁)`: the origin
is a double normal crossing point. -/
theorem isDoubleNormalCrossingPoint_nodalOrigin :
    IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 (nodalOrigin k) := by
  refine ⟨isNFold_nodalCurve k, isClosed_nodalOrigin k, ?_⟩
  let := (MMP.Flips.stalkStructureMap (nodalCurveStructure k) (nodalOrigin k)).toAlgebra
  have hh : (0 : k) ∈ IsLocalRing.maximalIdeal k := zero_mem _
  let := Stacks.NodalChart.chartOrigin_isMaximal (I := IsLocalRing.maximalIdeal k) hh
  obtain ⟨Θ, hΘ⟩ := Stacks.NodalChart.exists_ringEquiv_stalk_localizationAtPrime
    (NodalCurveRing k) (nodalOrigin k) (nodalOrigin k).asIdeal rfl
  let eL := IsLocalization.ringEquivOfRingEquiv
    (Localization.AtPrime (nodalOrigin k).asIdeal)
    (Localization.AtPrime (Stacks.NodalChart.chartOrigin (IsLocalRing.maximalIdeal k) 0))
    (nodalChartEquiv k) (map_primeCompl_nodalOrigin k)
  obtain ⟨cS, hcS⟩ := Stacks.AdicCompletionFibreUniverse.exists_adicCompletion_ringEquiv_of_map_eq Θ
    (IsLocalRing.maximalIdeal ((nodalCurve k).presheaf.stalk (nodalOrigin k)))
    (IsLocalRing.maximalIdeal (Localization.AtPrime (nodalOrigin k).asIdeal))
    (IsLocalRing.map_ringEquiv_maximalIdeal Θ)
  obtain ⟨cL, hcL⟩ :=
    Stacks.AdicCompletionFibreUniverse.exists_adicCompletion_ringEquiv_of_map_eq eL
    (IsLocalRing.maximalIdeal (Localization.AtPrime (nodalOrigin k).asIdeal))
    (IsLocalRing.maximalIdeal
      (Localization.AtPrime (Stacks.NodalChart.chartOrigin (IsLocalRing.maximalIdeal k) 0)))
    (IsLocalRing.map_ringEquiv_maximalIdeal eL)
  obtain ⟨E₁, hE₁⟩ :=
    Stacks.NodalChart.exists_ringEquiv_adicCompletion_localization_chartOrigin_of_isAdicComplete
      k 0 hh
  let q : (MvPowerSeries (Fin 2) k ⧸ Ideal.span
      {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (0 : k)}) ≃+*
      (MvPowerSeries (Fin 2) k ⧸ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}) :=
    Ideal.quotEquivOfEq (by simp)
  refine ⟨AlgEquiv.ofRingEquiv (f := cS.trans (cL.trans (E₁.trans q))) fun a => ?_⟩
  have h1 : algebraMap k (AdicCompletion (IsLocalRing.maximalIdeal ((nodalCurve k).presheaf.stalk
      (nodalOrigin k))) ((nodalCurve k).presheaf.stalk (nodalOrigin k))) a =
      algebraMap ((nodalCurve k).presheaf.stalk (nodalOrigin k)) _
        ((StructureSheaf.toStalk (NodalCurveRing k) (nodalOrigin k)).hom
          (algebraMap k (NodalCurveRing k) a)) := by
    rw [IsScalarTower.algebraMap_apply k ((nodalCurve k).presheaf.stalk (nodalOrigin k)),
      RingHom.algebraMap_toAlgebra, stalkStructureMap_eq_toStalk]
  simp only [RingEquiv.trans_apply]
  rw [h1]
  erw [hcS]
  rw [hΘ]
  erw [hcL]
  simp only [eL, IsLocalization.ringEquivOfRingEquiv_eq,
    nodalChartEquiv_algebraMap]
  rw [hE₁]
  rfl

/-- The node is smooth away from the origin: a point outside the smooth locus is the origin. -/
theorem eq_nodalOrigin_of_notMem_smoothLocus (x : nodalCurve k)
    (hs : x ∉ smoothLocus (nodalCurveStructure k)) :
    x = nodalOrigin k := by
  refine eq_nodalOrigin_of_mem k fun l => ?_
  by_contra h
  exact hs (basicOpen_le_smoothLocus k l h)

/-- `k[[x₀, x₁]]/(x₀x₁)` is not a domain. -/
theorem not_isDomain_quotient_X_mul_X :
    ¬ IsDomain (MvPowerSeries (Fin 2) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}) := by
  intro h
  have hprod : (Ideal.Quotient.mk _ (MvPowerSeries.X 0) *
      Ideal.Quotient.mk _ (MvPowerSeries.X 1) : MvPowerSeries (Fin 2) k ⧸ Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)}) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  have hne : ∀ i j : Fin 2, i ≠ j → (Ideal.Quotient.mk (Ideal.span
      {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k)})
      (MvPowerSeries.X i)) ≠ 0 := by
    intro i j hij h0
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h0
    obtain ⟨c, hc⟩ := h0
    have hXj : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) k) =
        MvPowerSeries.X i * MvPowerSeries.X j := by
      fin_cases i <;> fin_cases j <;> first | exact absurd rfl hij | rfl | exact mul_comm _ _
    rw [hXj, mul_assoc] at hc
    have h1 : (1 : MvPowerSeries (Fin 2) k) = MvPowerSeries.X j * c := by
      have hX : (MvPowerSeries.X i : MvPowerSeries (Fin 2) k) ≠ 0 := fun h => by
        have := congrArg (MvPowerSeries.coeff (Finsupp.single i 1)) h
        simp [MvPowerSeries.coeff_X] at this
      exact mul_left_cancel₀ hX ((mul_one _).trans hc)
    have := congrArg MvPowerSeries.constantCoeff h1
    simp at this
  rcases mul_eq_zero.mp hprod with h0 | h1
  · exact hne 0 1 (by decide) h0
  · exact hne 1 0 (by decide) h1

/-- The origin is the only double normal crossing point of the node: at any other closed point the
local ring is regular, so its completion is a domain, while `k[[x₀, x₁]]/(x₀x₁)` is not. -/
theorem eq_nodalOrigin_of_isDoubleNormalCrossingPoint {x : nodalCurve k}
    (hx : IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 x) : x = nodalOrigin k := by
  by_contra hne
  have hl : ∃ l : Fin 2,
      (Ideal.Quotient.mk _ (MvPolynomial.X l) : NodalCurveRing k) ∉ x.asIdeal := by
    by_contra h
    push Not at h
    exact hne (eq_nodalOrigin_of_mem k h)
  obtain ⟨l, hl⟩ := hl
  let U : (nodalCurve k).Opens :=
    PrimeSpectrum.basicOpen (Ideal.Quotient.mk _ (MvPolynomial.X l) : NodalCurveRing k)
  have hxU : x ∈ U := hl
  have := smooth_basicOpen_ι k l
  have hreg : IsRegularLocalRing (U.toScheme.presheaf.stalk ⟨x, hxU⟩) :=
    isRegularLocalRing_stalk_of_smooth_over_field (U.ι ≫ nodalCurveStructure k) ⟨x, hxU⟩
  have hreg' : IsRegularLocalRing ((nodalCurve k).presheaf.stalk x) :=
    IsRegularLocalRing.of_ringEquiv
      (U.stalkIso ⟨x, hxU⟩).commRingCatIsoToRingEquiv
  have hcomp : IsRegularLocalRing (AdicCompletion
      (IsLocalRing.maximalIdeal ((nodalCurve k).presheaf.stalk x))
      ((nodalCurve k).presheaf.stalk x)) :=
    isRegularLocalRing_iff_adicCompletion_maximalIdeal.mp hreg'
  have hdom := IsRegularLocalRing.isDomain (AdicCompletion
    (IsLocalRing.maximalIdeal ((nodalCurve k).presheaf.stalk x)) ((nodalCurve k).presheaf.stalk x))
  obtain ⟨-, -, ⟨e⟩⟩ := hx
  let := (stalkStructureMap (nodalCurveStructure k) x).toAlgebra
  refine not_isDomain_quotient_X_mul_X k ?_
  exact e.symm.toRingEquiv.toMulEquiv.isDomain _

/-- Every singular closed point of the affine node is a double normal crossing point: the node is
smooth away from the origin, and the completed local ring at the origin is `k[[x, y]]/(xy)`. -/
theorem isDoubleNormalCrossingPoint_of_notMem_smoothLocus (x : nodalCurve k)
    (_hx : IsClosed ({x} : Set (nodalCurve k))) (hs : x ∉ smoothLocus (nodalCurveStructure k)) :
    IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 x := by
  rw [eq_nodalOrigin_of_notMem_smoothLocus k x hs]
  exact isDoubleNormalCrossingPoint_nodalOrigin k

/-- An element of `k[x, y]/(xy)` outside both branch ideals `(x)` and `(y)` is a nonzerodivisor:
`(x) ∩ (y) = (x)(y) = 0` in the reduced ring `k[x, y]/(xy)`. -/
theorem mem_nonZeroDivisors_of_notMem_nodalBranchIdeal {f : NodalCurveRing k}
    (h0 : f ∉ nodalBranchIdeal k 0) (h1 : f ∉ nodalBranchIdeal k 1) :
    f ∈ nonZeroDivisors (NodalCurveRing k) := by
  rw [mem_nonZeroDivisors_iff_right]
  intro g hg
  have hfg : f * g = 0 := (mul_comm f g).trans hg
  have hg0 := ((isPrime_nodalBranchIdeal k 0).mem_or_mem
    (hfg.symm ▸ Ideal.zero_mem _)).resolve_left h0
  have hg1 := ((isPrime_nodalBranchIdeal k 1).mem_or_mem
    (hfg.symm ▸ Ideal.zero_mem _)).resolve_left h1
  have hsq : g * g ∈ (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k)} *
      Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) k)}).map (Ideal.Quotient.mk _) := by
    rw [Ideal.map_mul]
    exact Ideal.mul_mem_mul hg0 hg1
  have hb : (Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k)} *
      Ideal.span {(MvPolynomial.X 1 : MvPolynomial (Fin 2) k)}).map
      (Ideal.Quotient.mk (Ideal.span {(MvPolynomial.X 0 * MvPolynomial.X 1 :
        MvPolynomial (Fin 2) k)})) = ⊥ := by
    rw [Ideal.span_singleton_mul_span_singleton]
    exact Ideal.map_quotient_self _
  rw [hb, Ideal.mem_bot, ← pow_two] at hsq
  exact pow_eq_zero_iff two_ne_zero |>.mp hsq

/-- `k[x, y]/(xy)` has dimension at most one: `xy` is a nonzerodivisor of `k[x, y]`. -/
theorem ringKrullDim_nodalCurveRing_le_one : ringKrullDim (NodalCurveRing k) ≤ 1 := by
  have h := ringKrullDim_quotient_succ_le_of_nonZeroDivisor
    (R := MvPolynomial (Fin 2) k) (r := MvPolynomial.X 0 * MvPolynomial.X 1)
    (mem_nonZeroDivisors_of_ne_zero
      (mul_ne_zero (MvPolynomial.X_ne_zero _) (MvPolynomial.X_ne_zero _)))
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
    ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add] at h
  change ringKrullDim (NodalCurveRing k) + 1 ≤ 2 at h
  generalize ringKrullDim (NodalCurveRing k) = d at h ⊢
  exact ENat.WithBot.add_le_add_one_right_iff.mp (by rwa [one_add_one_eq_two])

/-- Every non-minimal prime of `k[x, y]/(xy)` contains a nonzerodivisor: by prime avoidance it is
contained in neither branch ideal. -/
theorem exists_mem_nonZeroDivisors_of_notMem_minimalPrimes {p : Ideal (NodalCurveRing k)}
    (hp : p.IsPrime) (hmin : p ∉ minimalPrimes (NodalCurveRing k)) :
    ∃ f ∈ p, f ∈ nonZeroDivisors (NodalCurveRing k) := by
  by_contra hcon
  simp only [not_exists, not_and] at hcon
  have hsub : (p : Set (NodalCurveRing k)) ⊆ nodalBranchIdeal k 0 ∪ nodalBranchIdeal k 1 := by
    intro f hf
    by_contra h
    simp only [Set.mem_union, SetLike.mem_coe, not_or] at h
    exact hcon f hf (mem_nonZeroDivisors_of_notMem_nodalBranchIdeal k h.1 h.2)
  obtain ⟨q, hq, hqp⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ p)
  obtain ⟨j, rfl⟩ := exists_eq_map_span_X_of_mem_minimalPrimes k hq
  have hX : ∀ i j : Fin 2, i ≠ j →
      Ideal.Quotient.mk _ (MvPolynomial.X i) ∉ nodalBranchIdeal k j := by
    intro i j hij hmem
    rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at hmem
    obtain ⟨g, hg, hge⟩ := hmem
    rw [Ideal.Quotient.eq, Ideal.mem_span_singleton] at hge
    rw [Ideal.mem_span_singleton] at hg
    obtain ⟨c, hc⟩ := hge
    obtain ⟨d, rfl⟩ := hg
    have := congrArg (MvPolynomial.eval (fun l : Fin 2 => if l = j then (0 : k) else 1)) hc
    fin_cases i <;> fin_cases j <;> simp at this hij
  rcases Ideal.subset_union.mp hsub with h | h <;>
  · rcases (by omega : ∀ l : Fin 2, l = 0 ∨ l = 1) j with rfl | rfl
    all_goals first
      | exact hmin (le_antisymm h hqp ▸ hq)
      | exact hX _ _ (by decide)
          (h (hqp (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self _))))

/-- The affine node satisfies Serre's condition `S₂`. -/
theorem satisfiesS2_nodalCurve : SatisfiesS2 (nodalCurve k) :=
  satisfiesS2_spec_of_ringKrullDim_le_one _ (ringKrullDim_nodalCurveRing_le_one k)
    fun _ hp hmin => exists_mem_nonZeroDivisors_of_notMem_minimalPrimes k hp hmin

/-- **The node is an slc curve** (with `Δ = 0`). -/
theorem isSlcCurve_nodalCurve : IsSlcCurve (nodalCurveStructure k) 0 :=
  ⟨isNFold_nodalCurve k, isDoubleNormalCrossingPoint_of_notMem_smoothLocus k,
    isFiniteTypeSeparated_nodalCurve k, isReduced_nodalCurve k, satisfiesS2_nodalCurve k,
    fun _ => by simp⟩

/-- The origin `t = 0` of the affine line. -/
def lineOrigin : Spec (.of (Polynomial k)) :=
  ⟨Ideal.span {Polynomial.X}, (PrincipalIdealRing.isMaximal_of_irreducible
    Polynomial.irreducible_X).isPrime⟩

/-- A point of the affine line at which `t` vanishes is the origin. -/
theorem eq_lineOrigin_of_X_mem {p : Spec (.of (Polynomial k))}
    (hX : (Polynomial.X : Polynomial k) ∈ p.asIdeal) : p = lineOrigin k :=
  PrimeSpectrum.ext ((PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X).eq_of_le
    p.isPrime.ne_top (by rwa [Ideal.span_le, Set.singleton_subset_iff])).symm

/-- The only point of a branch over the origin of the node is the origin of the line. -/
theorem eq_lineOrigin_of_nodalBranch_eq (j : Fin 2) {p : Spec (.of (Polynomial k))}
    (hp : (nodalBranch k j).base p = nodalOrigin k) : p = lineOrigin k := by
  have hX : (Polynomial.X : Polynomial k) ∈ p.asIdeal := by
    have h := mk_X_mem_nodalOrigin k j
    rw [← hp] at h
    change nodalBranchMap k j (Ideal.Quotient.mk _ (MvPolynomial.X j)) ∈ p.asIdeal at h
    simpa [nodalBranchMap] using h
  exact eq_lineOrigin_of_X_mem k hX

/-- In a quasi-sober space, a point without proper generalizations is a generic point. -/
theorem mem_genericPoints_of_forall_specializes_eq {α : Type*} [TopologicalSpace α]
    [QuasiSober α] {x : α} (h : ∀ y, y ⤳ x → y = x) : x ∈ genericPoints α := by
  obtain ⟨Z, hZ, hxZ⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
    (isIrreducible_singleton (x := x)).closure
  obtain ⟨z, hz⟩ := QuasiSober.sober hZ.1 (isClosed_of_mem_irreducibleComponents Z hZ)
  have hzx : z ⤳ x := hz.specializes (hxZ (subset_closure rfl))
  rw [h z hzx] at hz
  change closure {x} ∈ irreducibleComponents α
  rwa [hz.def]

/-- A generic point of the affine line is the zero ideal. -/
theorem asIdeal_eq_bot_of_mem_genericPoints_line {η : Spec (.of (Polynomial k))}
    (hη : η ∈ genericPoints (Spec (.of (Polynomial k)))) : η.asIdeal = ⊥ := by
  have huniv : closure ({η} : Set (Spec (.of (Polynomial k)))) = Set.univ :=
    Set.eq_univ_of_univ_subset (hη.2 (IrreducibleSpace.isIrreducible_univ _) (Set.subset_univ _))
  let b : PrimeSpectrum (Polynomial k) := ⟨⊥, Ideal.isPrime_bot⟩
  have hb : η ⤳ b := specializes_iff_mem_closure.mpr (huniv ▸ trivial)
  exact le_bot_iff.mp ((PrimeSpectrum.le_iff_specializes η b).mpr hb)

/-- A branch `𝔸¹ ⟶ C` of the node carries the generic point of the line to a generic point
of the node. -/
theorem nodalBranch_mem_genericPoints (j : Fin 2) {η : Spec (.of (Polynomial k))}
    (hη : η ∈ genericPoints (Spec (.of (Polynomial k)))) :
    (nodalBranch k j) η ∈ genericPoints (nodalCurve k) := by
  have hη0 := asIdeal_eq_bot_of_mem_genericPoints_line k hη
  refine mem_genericPoints_of_forall_specializes_eq fun y hy => ?_
  have hle : y.asIdeal ≤ ((nodalBranch k j) η).asIdeal :=
    (PrimeSpectrum.le_iff_specializes y _).mpr hy
  refine PrimeSpectrum.ext (le_antisymm hle ?_)
  intro r hr
  have hr0 : nodalBranchMap k j r = 0 := by
    change nodalBranchMap k j r ∈ η.asIdeal at hr
    rwa [hη0, Ideal.mem_bot] at hr
  have hoff := sub_nodalBranchSection_mem k j r
  rw [hr0, map_zero, sub_zero] at hoff
  refine (Ideal.span_le.mpr ?_) hoff
  rintro _ ⟨l, hl, rfl⟩
  have hprod := mk_X_mul_mk_X_eq_zero_of_ne k hl
  rcases y.isPrime.mem_or_mem (hprod ▸ y.asIdeal.zero_mem) with h | h
  · exfalso
    have h' := hle h
    change nodalBranchMap k j _ ∈ η.asIdeal at h'
    rw [hη0, Ideal.mem_bot] at h'
    simp [nodalBranchMap] at h'
  · exact h

/-- A branch `𝔸¹ ⟶ C` of the node is a closed immersion, hence a monomorphism. -/
instance mono_nodalBranch (j : Fin 2) : Mono (nodalBranch k j) := by
  have : IsClosedImmersion (nodalBranch k j) := IsClosedImmersion.spec_of_surjective _
    fun p => ⟨nodalBranchSection k j p, nodalBranchMap_nodalBranchSection k j p⟩
  infer_instance

/-- The coordinate `t` of the affine line, as a global section. -/
abbrev lineCoord : Γ(Spec (.of (Polynomial k)), ⊤) :=
  (Scheme.ΓSpecIso (.of (Polynomial k))).inv Polynomial.X

/-- The germ of `t` at a point `q` of the line is the image of `t` in the localization at `q`. -/
theorem germ_lineCoord_eq_algebraMap (q : Spec (.of (Polynomial k))) :
    letI : Algebra (Polynomial k) ((Spec (.of (Polynomial k))).presheaf.stalk q) :=
      StructureSheaf.stalkAlgebra (CommRingCat.of (Polynomial k)) q
    (Spec (.of (Polynomial k))).presheaf.germ ⊤ q trivial (lineCoord k) =
      algebraMap (Polynomial k) _ Polynomial.X := by
  have hB : StructureSheaf.toStalk (Polynomial k) q =
      (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv ≫
        (Spec (CommRingCat.of (Polynomial k))).presheaf.germ ⊤ q trivial := by
    delta StructureSheaf.toStalk
    rfl
  change _ = (StructureSheaf.toStalk (Polynomial k) q).hom Polynomial.X
  rw [hB]
  rfl

/-- At a point `q` of the line lying on `t = 0`, the germ of `t` generates the maximal ideal. -/
theorem span_germ_lineCoord_eq_maximalIdeal (q : Spec (.of (Polynomial k)))
    (hq : (Polynomial.X : Polynomial k) ∈ q.asIdeal) :
    Ideal.span {(Spec (.of (Polynomial k))).presheaf.germ ⊤ q trivial (lineCoord k)} =
      IsLocalRing.maximalIdeal _ := by
  let _ : Algebra (Polynomial k) ((Spec (.of (Polynomial k))).presheaf.stalk q) :=
    StructureSheaf.stalkAlgebra (CommRingCat.of (Polynomial k)) q
  have := q.isPrime
  have : IsLocalization.AtPrime ((Spec (.of (Polynomial k))).presheaf.stalk q) q.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk (CommRingCat.of (Polynomial k)) q
  have hq' : q.asIdeal = Ideal.span {Polynomial.X} :=
    congrArg PrimeSpectrum.asIdeal (eq_lineOrigin_of_X_mem k hq)
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal, hq', Ideal.map_span,
    Set.image_singleton, germ_lineCoord_eq_algebraMap]

/-- Away from `t = 0`, the germ of `t` is a unit. -/
theorem isUnit_germ_lineCoord (q : Spec (.of (Polynomial k)))
    (hq : (Polynomial.X : Polynomial k) ∉ q.asIdeal) :
    IsUnit ((Spec (.of (Polynomial k))).presheaf.germ ⊤ q trivial (lineCoord k)) := by
  let _ : Algebra (Polynomial k) ((Spec (.of (Polynomial k))).presheaf.stalk q) :=
    StructureSheaf.stalkAlgebra (CommRingCat.of (Polynomial k)) q
  have := q.isPrime
  have : IsLocalization.AtPrime ((Spec (.of (Polynomial k))).presheaf.stalk q) q.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk (CommRingCat.of (Polynomial k)) q
  rw [germ_lineCoord_eq_algebraMap]
  exact IsLocalization.map_units _ (⟨Polynomial.X, hq⟩ : q.asIdeal.primeCompl)

variable {k}

/-- `ord(f⁻¹ ^ m) = -m ord(f)` for a nonzero rational function `f`. -/
theorem ord_inv_pow {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    {f : X.functionField} (hf : f ≠ 0) (x : X) (m : ℕ) :
    X.ord (f⁻¹ ^ m) x = -(m * X.ord f x) := by
  have h0 : X.ord (1 : X.functionField) x = 0 := by
    simpa using Scheme.ord_of_isUnit (U := ⊤) (f := (1 : Γ(X, ⊤))) isUnit_one (x := x) trivial
  have h1 : X.ord f⁻¹ x = -X.ord f x := by
    have := Scheme.ord_mul (x := x) hf (inv_ne_zero hf)
    rw [mul_inv_cancel₀ hf, h0] at this
    omega
  induction m with
  | zero => simp [h0]
  | succ n ih =>
    rw [pow_succ, Scheme.ord_mul (pow_ne_zero _ (inv_ne_zero hf)) (inv_ne_zero hf), ih, h1]
    push_cast
    ring

/-- The degree-one exterior power `ιMulti R 1 (fun _ => ω)` of a nonzero vector is nonzero. -/
theorem ιMulti_one_ne_zero {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {ω : M}
    (hω : ω ≠ 0) : exteriorPower.ιMulti R 1 (fun _ => ω) ≠ 0 := by
  rw [← exteriorPower.oneEquiv_symm_apply]; simpa using hω

/-- If `ω` spans `M`, then `ιMulti R 1 (fun _ => ω)` spans `⋀^1 M`. -/
theorem span_ιMulti_one_eq_top {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] {ω : M}
    (hω : Submodule.span R {ω} = ⊤) :
    Submodule.span R {exteriorPower.ιMulti R 1 (fun _ => ω)} = ⊤ := by
  rw [← exteriorPower.oneEquiv_symm_apply, ← Set.image_singleton,
    ← LinearEquiv.coe_coe, ← Submodule.map_span, hω, Submodule.map_top, LinearEquiv.range]

/-- If `R ≅ k[t]` compatibly with `k` and `S` is a localization of `R`, then `dt` generates
`Ω¹_{S/k}`. -/
theorem span_kaehlerD_eq_top_of_isLocalization {R S : Type*} [CommRing R] [CommRing S]
    [Algebra k R] [Algebra k S] [Algebra R S] [IsScalarTower k R S] (M : Submonoid R)
    [IsLocalization M S] (θ : Polynomial k ≃+* R)
    (hθ : ∀ c : k, θ (Polynomial.C c) = algebraMap k R c) :
    Submodule.span S {KaehlerDifferential.D k S (algebraMap R S (θ Polynomial.X))} = ⊤ := by
  have haeval : ∀ p, Polynomial.aeval (θ Polynomial.X) p = θ p := by
    intro p
    have : (Polynomial.aeval (θ Polynomial.X) : Polynomial k →ₐ[k] R).toRingHom = θ.toRingHom :=
      Polynomial.ringHom_ext (fun c => by simp [hθ]) (by simp)
    exact congrArg (fun f : Polynomial k →+* R => f p) this
  rw [eq_top_iff, ← KaehlerDifferential.span_range_map_derivation_of_isLocalization k R S M,
    Submodule.span_le]
  rintro _ ⟨r, rfl⟩
  obtain ⟨p, rfl⟩ := θ.surjective r
  simp only [Function.comp_apply]
  rw [← haeval p, Derivation.map_aeval, LinearMap.map_smul_of_tower, KaehlerDifferential.map_D]
  exact Submodule.smul_of_tower_mem _ _ (Submodule.subset_span rfl)

/-- If `R ≅ k[t]` compatibly with `k` and `K` is the fraction field of `R`, then `dt ≠ 0` in
`Ω¹_{K/k}`. -/
theorem kaehlerD_algebraMap_ne_zero {R K : Type*} [CommRing R] [Nontrivial R] [Field K]
    [Algebra R K] [IsFractionRing R K] [Algebra k R] [Algebra k K] [IsScalarTower k R K]
    (θ : Polynomial k ≃+* R) (hθ : ∀ c : k, θ (Polynomial.C c) = algebraMap k R c) :
    KaehlerDifferential.D k K (algebraMap R K (θ Polynomial.X)) ≠ 0 := by
  intro h0
  let _ : Algebra R (Polynomial k) := θ.symm.toRingHom.toAlgebra
  have : IsScalarTower k R (Polynomial k) := IsScalarTower.of_algebraMap_eq fun c => by
    change Polynomial.C c = θ.symm (algebraMap k _ c)
    rw [← hθ, θ.symm_apply_apply]
  let δ : Derivation k R (Polynomial k) := (Polynomial.derivative' (R := k)).compAlgebraMap R
  have hδ : δ (θ Polynomial.X) = 1 := by
    change Polynomial.derivative (θ.symm (θ Polynomial.X)) = 1
    simp
  have hmap : KaehlerDifferential.map k k R K (KaehlerDifferential.D k _ (θ Polynomial.X)) =
      KaehlerDifferential.map k k R K 0 := by
    rw [KaehlerDifferential.map_D, map_zero, h0]
  have := KaehlerDifferential.isLocalizedModule_map k R K (nonZeroDivisors R)
  obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := nonZeroDivisors R) hmap
  have hc' := congrArg δ.liftKaehlerDifferential hc
  rw [smul_zero, map_zero, Submonoid.smul_def, LinearMap.map_smul,
    Derivation.liftKaehlerDifferential_comp_D, hδ, Algebra.smul_def, mul_one] at hc'
  exact nonZeroDivisors.coe_ne_zero c (θ.symm.injective (by rwa [map_zero]))

/-- **The order of `(dz/z)^m` for a coordinate `z`.** Let `X` be an affine integral scheme over
`k` whose ring of global functions is `k[t]` (through `θ`, compatibly with `k`), and `z` the
image of `t` in `k(X)`, then `ord_P((dz/z)^m) = -m · ord_P(z)` for every prime divisor `P`. -/
theorem ordForm_dlogPow_germToFunctionField {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsAffine X] (θ : Polynomial k ≃+* Γ(X, ⊤))
    (hθ : ∀ c : k, θ (Polynomial.C c) =
      (letI := sectionAlgebra sX ⊤; algebraMap k Γ(X, ⊤) c))
    (P : Mori.PrimeDivisor X) (m : ℕ) :
    P.ordForm (dlogPow sX (X.germToFunctionField ⊤ (θ Polynomial.X)) m) =
      -(m * X.ord (X.germToFunctionField ⊤ (θ Polynomial.X)) P.genericPoint) := by
  let _ := sectionAlgebra sX ⊤
  let _ := stalkAlgebra sX P.genericPoint
  let _ := functionFieldAlgebra sX
  have := isScalarTower_stalk_functionField sX P.genericPoint
  let _ : Algebra Γ(X, ⊤) P.localRing :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (U := ⊤) ⟨P.genericPoint, trivial⟩
  have := isScalarTower_section_stalk sX ⊤ ⟨P.genericPoint, trivial⟩
  have := isScalarTower_section_functionField sX ⊤
  have hloc : IsLocalization.AtPrime P.localRing
      ((isAffineOpen_top X).primeIdealOf ⟨P.genericPoint, trivial⟩).asIdeal :=
    (isAffineOpen_top X).isLocalization_stalk ⟨P.genericPoint, trivial⟩
  have hfr : IsFractionRing Γ(X, ⊤) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X ⊤ (isAffineOpen_top X)
  set s := θ Polynomial.X with hs
  set a : P.localRing := X.presheaf.germ ⊤ P.genericPoint trivial s with ha
  set z := X.germToFunctionField ⊤ s with hz
  have haz : algebraMap P.localRing X.functionField a = z :=
    Scheme.algebraMap_germ_eq_germToFunctionField X
      (show P.genericPoint ∈ (⊤ : X.Opens) from trivial) s
  have hspanΩ : Submodule.span P.localRing {KaehlerDifferential.D k P.localRing a} = ⊤ :=
    span_kaehlerD_eq_top_of_isLocalization
      ((isAffineOpen_top X).primeIdealOf ⟨P.genericPoint, trivial⟩).asIdeal.primeCompl θ hθ
  let σ : ⋀[P.localRing]^1 Ω[P.localRing⁄k] :=
    exteriorPower.ιMulti _ 1 (fun _ => KaehlerDifferential.D k P.localRing a)
  have hσ : Submodule.span P.localRing {σ} = ⊤ := span_ιMulti_one_eq_top hspanΩ
  have hDz : KaehlerDifferential.D k X.functionField z ≠ 0 := kaehlerD_algebraMap_ne_zero θ hθ
  have hb : topFormsMap k P.localRing X.functionField 1 σ =
      exteriorPower.ιMulti _ 1 (fun _ => KaehlerDifferential.D k X.functionField z) := by
    simp only [σ, topFormsMap_ιMulti, KaehlerDifferential.map_D, haz]
  have h0 : topFormsMap k P.localRing X.functionField 1 σ ≠ 0 := by
    rw [hb]
    exact ιMulti_one_ne_zero hDz
  rw [P.ordForm_eq _ hσ h0]
  have hbo := ZTensorPower.basis_ofNat (topFormsBasis P.localRing hσ h0) m
  rw [topFormsBasis_apply, hb] at hbo
  have hτ : dlogPow sX z m =
      (z⁻¹) ^ m • ZTensorPower.basis (topFormsBasis P.localRing hσ h0) m () := by
    unfold dlogPow
    erw [hbo]
    exact tprod_const_smul _ _
  rw [hτ, formCoeff_smul]
  simp only [formCoeff, Module.Basis.repr_self, Finsupp.single_eq_same, mul_one]
  have hz0 : z ≠ 0 := fun h => hDz (by rw [h, map_zero])
  exact ord_inv_pow hz0 _ m

/-- A morphism from an irreducible scheme to a coproduct `∐ X` that meets the summand `X i`
lands in it. -/
theorem range_subset_range_sigmaι_of_irreducibleSpace {ι : Type u} (X : ι → Scheme.{u}) (i : ι)
    {Y : Scheme.{u}} [IrreducibleSpace Y] (g : Y ⟶ ∐ X) {y : Y} {x : X i}
    (hx : g y = Sigma.ι X i x) : Set.range g ⊆ Set.range (Sigma.ι X i) := by
  rintro _ ⟨a, rfl⟩
  obtain ⟨⟨i', z⟩, hz⟩ := (sigmaMk X).surjective (g a)
  rw [sigmaMk_mk] at hz
  by_cases hi : i' = i
  · subst hi
    exact ⟨z, hz⟩
  · have hU : IsOpen (g ⁻¹' Set.range (Sigma.ι X i)) :=
      (Sigma.ι X i).isOpenEmbedding.isOpen_range.preimage g.continuous
    have hV : IsOpen (g ⁻¹' Set.range (Sigma.ι X i')) :=
      (Sigma.ι X i').isOpenEmbedding.isOpen_range.preimage g.continuous
    obtain ⟨b, -, ⟨u, hu⟩, ⟨v, hv⟩⟩ := (IrreducibleSpace.isIrreducible_univ Y).2 _ _ hU hV
      ⟨y, trivial, ⟨x, hx.symm⟩⟩ ⟨a, trivial, ⟨z, hz⟩⟩
    exact absurd (congrArg Sigma.fst ((sigmaι_eq_iff X i i' u v).mp (hu.trans hv.symm))).symm hi

/-- A ring map out of `k[x, y]/(xy)` killing `x_l` factors through the branch `x_l = 0`, as the
evaluation `k[x_j] → R` at the image of the other coordinate `x_j`. -/
theorem comp_nodalBranchMap_eval₂RingHom {R : Type*} [CommRing R] (φ : NodalCurveRing k →+* R)
    {j l : Fin 2} (hjl : l ≠ j) (hl : φ (Ideal.Quotient.mk _ (MvPolynomial.X l)) = 0) :
    (Polynomial.eval₂RingHom (φ.comp (algebraMap k (NodalCurveRing k)))
      (φ (Ideal.Quotient.mk _ (MvPolynomial.X j)))).comp (nodalBranchMap k j) = φ := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro a
    simp [nodalBranchMap]
  · intro m
    by_cases hm : m = j
    · subst hm
      simp [nodalBranchMap]
    · have hml : m = l := by
        fin_cases m <;> fin_cases j <;> fin_cases l <;> simp_all
      subst hml
      simp [nodalBranchMap, hm, hl]

namespace NormalizationComponents

variable {hC : ∀ U : (nodalCurve k).Opens, IsCompact (U : Set (nodalCurve k)) →
    (irreducibleComponents U).Finite}
  (N : NormalizationComponents (nodalCurveStructure k) hC)

/-- The pull-back `nᵢ^* x_j ∈ k(Cᵢ)` of the coordinate `x_j` of the node to the function field
of the component `Cᵢ` of its normalization. -/
def nodalCoordPullback (i : N.ι) (j : Fin 2) : (N.X i).functionField :=
  (N.X i).germToFunctionField ⊤ ((N.n i).appTop (nodalCurveCoord k j))

open scoped Classical in
/-- **The section `σ^m`** on the node `C = (xy = 0)`, for `σ = dx/x = -dy/y` the residue form
generating `ω_C`: the family `n^*(σ^m)|_{Cᵢ}`, which is `(dx/x)^m` on a component on which `x`
does not vanish identically (the branch `y = 0`), and `(-dy/y)^m = (-1)^m (dy/y)^m` on the
others (the branch `x = 0`). -/
def nodalSigmaPow (m : ℕ) (i : N.ι) : RationalPluriForms (N.n i ≫ nodalCurveStructure k) 1 m :=
  if N.nodalCoordPullback i 0 ≠ 0 then dlogPow _ (N.nodalCoordPullback i 0) m
  else ((-1 : ℤ) ^ m) • dlogPow _ (N.nodalCoordPullback i 1) m

open scoped Classical in
/-- The local coordinate of the branch on which the component `Cᵢ` lies: the pull-back of `x`
if it does not vanish identically on `Cᵢ` (the branch `y = 0`), and the pull-back of `y`
otherwise (the branch `x = 0`). -/
def nodalBranchCoord (i : N.ι) : (N.X i).functionField :=
  if N.nodalCoordPullback i 0 ≠ 0 then N.nodalCoordPullback i 0 else N.nodalCoordPullback i 1

/-- **The components of the normalization of the node are the two branches** `𝔸¹ ⟶ C`, up to
isomorphism over `C`. -/
theorem exists_iso_nodalBranch (i : N.ι) :
    ∃ (j : Fin 2) (e : N.X i ≅ Spec (.of (Polynomial k))), N.n i = e.hom ≫ nodalBranch k j := by
  classical
  obtain ⟨φ₀, hφ₀⟩ := N.exists_iso
  let φ : ∐ N.X ≅ (nodalCurve k).normalizationScheme hC := φ₀
  have hφ : φ.hom ≫ (nodalCurve k).normalization hC = Sigma.desc N.n := hφ₀
  let φi : NodalCurveRing k →+* Γ(N.X i, ⊤) :=
    ((Scheme.ΓSpecIso (.of (NodalCurveRing k))).inv ≫ (N.n i).appTop).hom
  obtain ⟨l, hl⟩ : ∃ l : Fin 2, φi (Ideal.Quotient.mk _ (MvPolynomial.X l)) = 0 := by
    have h := congrArg φi (mk_X_mul_mk_X_eq_zero_of_ne k (j := 0) (l := 1) (by decide))
    rw [map_mul, map_zero] at h
    rcases mul_eq_zero.mp h with h | h
    exacts [⟨0, h⟩, ⟨1, h⟩]
  obtain ⟨j, hjl⟩ : ∃ j : Fin 2, l ≠ j := ⟨l + 1, by fin_cases l <;> decide⟩
  let ψ : Polynomial k →+* Γ(N.X i, ⊤) := Polynomial.eval₂RingHom
    (φi.comp (algebraMap k (NodalCurveRing k))) (φi (Ideal.Quotient.mk _ (MvPolynomial.X j)))
  have hψ : ψ.comp (nodalBranchMap k j) = φi := comp_nodalBranchMap_eval₂RingHom φi hjl hl
  let h : N.X i ⟶ Spec (.of (Polynomial k)) :=
    (N.X i).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)
  have hh : h ≫ nodalBranch k j = N.n i := by
    conv_rhs => rw [eq_toSpecΓ_comp_Spec_map (N.n i)]
    simp only [h, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ]
    rfl
  have hι : Sigma.ι N.X i ≫ φ.hom ≫ (nodalCurve k).normalization hC = N.n i := by
    rw [hφ, Sigma.ι_desc]
  have hgenX : ∀ η : genericPoints (N.X i), (N.n i) η.1 ∈ genericPoints (nodalCurve k) := by
    intro η
    have h1 := mem_genericPoints_of_generalizingMap
      (Sigma.ι N.X i ≫ φ.hom).isOpenEmbedding.generalizingMap η.2
    rw [← hι, Scheme.Hom.comp_apply]
    exact Scheme.normalization_mem_genericPoints _ hC h1
  have : IsNormal (Spec (.of (Polynomial k))) := isNormal_spec_of_isIntegrallyClosed _
  obtain ⟨g, hg, -⟩ := Scheme.existsUnique_lift_normalization hC (nodalBranch k j)
    (fun η => nodalBranch_mem_genericPoints k j η.2)
  obtain ⟨_, -, huniq⟩ := Scheme.existsUnique_lift_normalization hC (N.n i) hgenX
  have hhg : h ≫ g = Sigma.ι N.X i ≫ φ.hom := by
    rw [huniq (h ≫ g) (by beta_reduce; rw [Category.assoc, hg, hh]),
      huniq (Sigma.ι N.X i ≫ φ.hom) (by beta_reduce; rwa [Category.assoc])]
  let g₀ := g ≫ φ.inv
  have hhg₀ : h ≫ g₀ = Sigma.ι N.X i := by
    simp only [g₀]
    rw [← Category.assoc, hhg, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  obtain ⟨x⟩ : Nonempty (N.X i) := inferInstance
  have hrange := range_subset_range_sigmaι_of_irreducibleSpace N.X i g₀ (y := h x) (x := x)
    (by rw [← Scheme.Hom.comp_apply, hhg₀])
  let g' := IsOpenImmersion.lift (Sigma.ι N.X i) g₀ hrange
  have hg' : g' ≫ Sigma.ι N.X i = g₀ := IsOpenImmersion.lift_fac _ _ _
  refine ⟨j, ⟨h, g', ?_, ?_⟩, hh.symm⟩
  · rw [← cancel_mono (Sigma.ι N.X i), Category.assoc, hg', hhg₀, Category.id_comp]
  · rw [← cancel_mono (nodalBranch k j), Category.assoc, hh, Category.id_comp, ← hι,
      reassoc_of% hg']
    simp only [g₀, Category.assoc, Iso.inv_hom_id_assoc]
    exact hg

/-- The component `Cᵢ` is a smooth non-proper curve. -/
theorem isSmoothScheme_dim_not_isProper (i : N.ι) :
    IsSmoothScheme (N.n i ≫ nodalCurveStructure k) ∧ topologicalKrullDim (N.X i) = 1 ∧
      ¬ IsProper (N.n i ≫ nodalCurveStructure k) := by
  obtain ⟨j, e, he⟩ := N.exists_iso_nodalBranch i
  have hc : N.n i ≫ nodalCurveStructure k = e.hom ≫ lineStructure k := by
    rw [he, Category.assoc, nodalBranch_comp_structure]
  rw [hc]
  refine ⟨isSmoothScheme_of_smooth _, ?_, fun hp => not_isProper_lineStructure k ?_⟩
  · rw [← topologicalKrullDim_line k]
    exact (Scheme.homeoOfIso e).isHomeomorph.topologicalKrullDim_eq
  · have : IsProper (e.inv ≫ e.hom ≫ lineStructure k) := inferInstance
    simpa using this

/-- Only finitely many points of `Cᵢ` lie over the node. -/
theorem finite_setOf_isDoubleNormalCrossingPoint (i : N.ι) :
    {P : Mori.PrimeDivisor (N.X i) |
      IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1
        ((N.n i).base P.genericPoint)}.Finite := by
  obtain ⟨j, e, he⟩ := N.exists_iso_nodalBranch i
  refine (Set.Finite.preimage (f := fun P : Mori.PrimeDivisor (N.X i) => P.genericPoint)
    AlgebraicGeometry.PrimeDivisor.genericPoint_injective.injOn
    (Set.finite_singleton (e.inv.base (lineOrigin k)))).subset fun P hP => ?_
  have h0 := eq_nodalOrigin_of_isDoubleNormalCrossingPoint k hP
  rw [he, Scheme.Hom.comp_apply] at h0
  have h1 := eq_lineOrigin_of_nodalBranch_eq k j h0
  change P.genericPoint = e.inv.base (lineOrigin k)
  rw [← h1, ← Scheme.Hom.comp_apply, e.hom_inv_id]
  rfl

/-- The pull-back of a coordinate `x_l` along `nᵢ = e ≫ (branch j)`. -/
theorem nodalCoordPullback_eq_of_eq {i : N.ι} {j : Fin 2} {e : N.X i ≅ Spec (.of (Polynomial k))}
    (he : N.n i = e.hom ≫ nodalBranch k j) (l : Fin 2) :
    N.nodalCoordPullback i l = (N.X i).germToFunctionField ⊤ (e.hom.appTop
      ((Scheme.ΓSpecIso (.of (Polynomial k))).inv
        (nodalBranchMap k j (Ideal.Quotient.mk _ (MvPolynomial.X l))))) := by
  have h := congrArg (fun φ => φ.hom (Ideal.Quotient.mk _ (MvPolynomial.X l) : NodalCurveRing k))
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (nodalBranchMap k j)))
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
  unfold nodalCoordPullback nodalCurveCoord
  rw [he, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, ← h]

/-- The ring isomorphism `k[t] ≅ Γ(Cᵢ, 𝒪)` induced by `e : Cᵢ ≅ 𝔸¹`. -/
def lineRingEquiv {i : N.ι} (e : N.X i ≅ Spec (.of (Polynomial k))) :
    Polynomial k ≃+* Γ(N.X i, ⊤) :=
  (Scheme.ΓSpecIso (.of (Polynomial k))).symm.commRingCatIsoToRingEquiv.trans
    (Scheme.Γ.mapIso e.op).commRingCatIsoToRingEquiv

/-- `lineRingEquiv e p` is the pull-back of `p ∈ k[t]` along `e : Cᵢ ≅ 𝔸¹`. -/
theorem lineRingEquiv_apply {i : N.ι} (e : N.X i ≅ Spec (.of (Polynomial k))) (p : Polynomial k) :
    N.lineRingEquiv e p = e.hom.appTop ((Scheme.ΓSpecIso (.of (Polynomial k))).inv p) := rfl

/-- The pull-back of the coordinate `t` along `e : Cᵢ ≅ 𝔸¹` is nonzero. -/
theorem appTop_lineCoord_ne_zero {i : N.ι} (e : N.X i ≅ Spec (.of (Polynomial k))) :
    e.hom.appTop (lineCoord k) ≠ 0 := by
  intro h
  have : N.lineRingEquiv e Polynomial.X = N.lineRingEquiv e 0 := by
    rwa [lineRingEquiv_apply, map_zero]
  exact Polynomial.X_ne_zero ((N.lineRingEquiv e).injective this)

/-- The branch coordinate on `Cᵢ` is the pull-back of `t` along `e : Cᵢ ≅ 𝔸¹`. -/
theorem nodalBranchCoord_eq_of_eq {i : N.ι} {j : Fin 2} {e : N.X i ≅ Spec (.of (Polynomial k))}
    (he : N.n i = e.hom ≫ nodalBranch k j) :
    N.nodalBranchCoord i = (N.X i).germToFunctionField ⊤ (e.hom.appTop (lineCoord k)) := by
  classical
  have hne : (N.X i).germToFunctionField ⊤ (e.hom.appTop (lineCoord k)) ≠ 0 := fun h =>
    N.appTop_lineCoord_ne_zero e
      (Scheme.germToFunctionField_injective _ ⊤ (h.trans (map_zero _).symm))
  have hl : ∀ l, N.nodalCoordPullback i l = if l = j then
      (N.X i).germToFunctionField ⊤ (e.hom.appTop (lineCoord k)) else 0 := by
    intro l
    rw [N.nodalCoordPullback_eq_of_eq he l]
    by_cases hlj : l = j
    · subst hlj
      simp [nodalBranchMap, lineCoord]
    · simp [nodalBranchMap, hlj]
  unfold nodalBranchCoord
  rw [hl 0, hl 1]
  fin_cases j <;> simp [hne]

/-- A point of `Cᵢ` lies over the node iff `e` carries it to the origin of the line. -/
theorem isDoubleNormalCrossingPoint_iff_of_eq {i : N.ι} {j : Fin 2}
    {e : N.X i ≅ Spec (.of (Polynomial k))} (he : N.n i = e.hom ≫ nodalBranch k j) (x : N.X i) :
    IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 ((N.n i) x) ↔
      e.hom x = lineOrigin k := by
  constructor
  · intro hx
    have h0 := eq_nodalOrigin_of_isDoubleNormalCrossingPoint k hx
    rw [he, Scheme.Hom.comp_apply] at h0
    exact eq_lineOrigin_of_nodalBranch_eq k j h0
  · intro hx
    rw [he, Scheme.Hom.comp_apply, hx]
    convert isDoubleNormalCrossingPoint_nodalOrigin k
    refine eq_nodalOrigin_of_mem k fun l => ?_
    change nodalBranchMap k j (Ideal.Quotient.mk _ (MvPolynomial.X l)) ∈
      Ideal.span {(Polynomial.X : Polynomial k)}
    by_cases hlj : l = j
    · subst hlj
      simp [nodalBranchMap, Ideal.mem_span_singleton_self]
    · simp [nodalBranchMap, hlj]

/-- The germ of `e^* t` at `x` is the image of the germ of `t` at `e(x)`. -/
theorem germ_appTop_lineCoord {i : N.ι} (e : N.X i ≅ Spec (.of (Polynomial k))) (x : N.X i) :
    (N.X i).presheaf.germ ⊤ x trivial (e.hom.appTop (lineCoord k)) =
      e.hom.stalkMap x
        ((Spec (.of (Polynomial k))).presheaf.germ ⊤ (e.hom x) trivial (lineCoord k)) :=
  (Scheme.Hom.germ_stalkMap_apply e.hom ⊤ x trivial (lineCoord k)).symm

open scoped Classical in
/-- The order of `e^* t` along a prime divisor `P` of `Cᵢ`: `1` over the node, `0` elsewhere. -/
theorem ord_germToFunctionField_appTop_lineCoord {i : N.ι} {j : Fin 2}
    {e : N.X i ≅ Spec (.of (Polynomial k))} (he : N.n i = e.hom ≫ nodalBranch k j)
    (P : Mori.PrimeDivisor (N.X i)) :
    (N.X i).ord ((N.X i).germToFunctionField ⊤ (e.hom.appTop (lineCoord k))) P.genericPoint =
      if IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 ((N.n i) P.genericPoint)
      then 1 else 0 := by
  have hs := N.appTop_lineCoord_ne_zero e
  have := IsOpenImmersion.instIsIsoCommRingCatStalkMap e.hom P.genericPoint
  let ρ := (asIso (e.hom.stalkMap P.genericPoint)).commRingCatIsoToRingEquiv
  have hρ : ∀ g, ρ g = e.hom.stalkMap P.genericPoint g := fun _ => rfl
  have := P.isDiscreteValuationRing_localRing
  split_ifs with hP
  · have h1 := (N.isDoubleNormalCrossingPoint_iff_of_eq he _).mp hP
    have h := Stacks.Chow.ord_eq_ringOrd_germ P.coheight_genericPoint (V := ⊤) trivial _ hs
      (n := 1) ?_
    · exact_mod_cast h
    have hirr : Irreducible ((N.X i).presheaf.germ ⊤ P.genericPoint trivial
        (e.hom.appTop (lineCoord k))) := by
      refine (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr ?_
      rw [← IsLocalRing.map_ringEquiv_maximalIdeal ρ, ← span_germ_lineCoord_eq_maximalIdeal k _
        (by rw [h1]; exact Ideal.mem_span_singleton_self _), Ideal.map_span, Set.image_singleton,
        hρ, germ_appTop_lineCoord]
    exact_mod_cast Ring.ord_of_irreducible hirr
  · have h1 : (Polynomial.X : Polynomial k) ∉ (e.hom P.genericPoint).asIdeal := by
      intro hX
      exact hP ((N.isDoubleNormalCrossingPoint_iff_of_eq he _).mpr (eq_lineOrigin_of_X_mem k hX))
    have hu : IsUnit ((N.X i).presheaf.germ ⊤ P.genericPoint trivial
        (e.hom.appTop (lineCoord k))) := by
      rw [germ_appTop_lineCoord]
      exact (isUnit_germ_lineCoord k _ h1).map _
    have h := Stacks.Chow.ord_eq_ringOrd_germ P.coheight_genericPoint (V := ⊤) trivial _ hs
      (n := 0) (by exact_mod_cast Ring.ord_of_isUnit hu)
    exact_mod_cast h

/-- The branch coordinate is a local parameter at the points of `Cᵢ` over the node. -/
theorem ord_nodalBranchCoord (i : N.ι) (P : Mori.PrimeDivisor (N.X i))
    (hP : IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 ((N.n i).base P.genericPoint)) :
    (N.X i).ord (N.nodalBranchCoord i) P.genericPoint = 1 := by
  obtain ⟨j, e, he⟩ := N.exists_iso_nodalBranch i
  rw [N.nodalBranchCoord_eq_of_eq he, N.ord_germToFunctionField_appTop_lineCoord he, if_pos hP]

open scoped Classical in
/-- `(dz/z)^m`, `z` the branch coordinate, has a pole of order `m` at the points of `Cᵢ` over the
node and no zero or pole elsewhere. -/
theorem ordForm_dlogPow_nodalBranchCoord (i : N.ι) (m : ℕ) (P : Mori.PrimeDivisor (N.X i)) :
    P.ordForm (dlogPow (N.n i ≫ nodalCurveStructure k) (N.nodalBranchCoord i) m) =
      if IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 ((N.n i).base P.genericPoint)
      then -(m : ℤ) else 0 := by
  obtain ⟨j, e, he⟩ := N.exists_iso_nodalBranch i
  have hθ : ∀ c : k, N.lineRingEquiv e (Polynomial.C c) =
      (letI := sectionAlgebra (N.n i ≫ nodalCurveStructure k) ⊤;
        algebraMap k Γ(N.X i, ⊤) c) := by
    intro c
    have hs : N.n i ≫ nodalCurveStructure k = e.hom ≫ lineStructure k := by
      rw [he, Category.assoc, nodalBranch_comp_structure]
    have h := congrArg (fun φ => φ.hom c)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap k (Polynomial k))))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    change _ = ((Scheme.ΓSpecIso (.of k)).inv ≫
      (N.n i ≫ nodalCurveStructure k).appLE ⊤ ⊤ _).hom c
    have hle : ∀ hh, (N.n i ≫ nodalCurveStructure k).appLE ⊤ ⊤ hh =
        (N.n i ≫ nodalCurveStructure k).appTop := fun _ => Scheme.Hom.appLE_eq_app _
    rw [hle, hs, Scheme.Hom.comp_appTop, lineRingEquiv_apply]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    erw [← h]
    rfl
  have : IsAffine (N.X i) := IsAffine.of_isIso e.hom
  have h := ordForm_dlogPow_germToFunctionField (N.lineRingEquiv e) hθ P m
  rw [N.nodalBranchCoord_eq_of_eq he]
  change P.ordForm
    (dlogPow _ ((N.X i).germToFunctionField ⊤ (N.lineRingEquiv e Polynomial.X)) m) = _
  rw [h]
  change -((m : ℤ) * (N.X i).ord ((N.X i).germToFunctionField ⊤ (e.hom.appTop (lineCoord k)))
    P.genericPoint) = _
  rw [N.ord_germToFunctionField_appTop_lineCoord he]
  split_ifs <;> simp

/-- For `m` even, `σ^m` is `(dz/z)^m` on every component, `z` the branch coordinate. -/
theorem nodalSigmaPow_eq_dlogPow {m : ℕ} (hm : Even m) (i : N.ι) :
    N.nodalSigmaPow m i = dlogPow _ (N.nodalBranchCoord i) m := by
  unfold nodalSigmaPow nodalBranchCoord
  split_ifs
  · rfl
  · rw [hm.neg_one_pow, one_smul]

open scoped Classical in
/-- The boundary coefficient on a component of the normalization of the node, for `Δ = 0`. -/
theorem componentBoundaryCoeff_zero (i : N.ι) (P : Mori.PrimeDivisor (N.X i)) :
    N.componentBoundaryCoeff 0 i P =
      if IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1 ((N.n i).base P.genericPoint)
      then 1 else 0 := by
  unfold componentBoundaryCoeff
  split_ifs <;> simp

/-- **Even powers of `σ` are normalized** (FA Def. 12.2.9). On the node `C = (xy = 0)`, for
`m > 0` even, `σ^m ∈ Γ(C, 𝒪(mK_C))` is a normalized section (with `Δ = 0`), for any
normalization datum `ε` for elliptic curves. -/
@[mmp "lem_fa12a_nodal_curve_normalized_powers"]
theorem isNormalizedSlcSection_nodalSigmaPow (ε : EllipticNormalizationDatum k) {m : ℕ}
    (hm : Even m) (hm0 : 0 < m) :
    N.IsNormalizedSlcSection ε 0 m (N.nodalSigmaPow m) := by
  classical
  have hs := N.nodalSigmaPow_eq_dlogPow hm
  have hB := N.componentBoundaryCoeff_zero
  have hSlc := isSlcCurve_nodalCurve k
  refine ⟨hSlc, hm0, fun Γ => by simp, ⟨fun i P _ => ?_, fun i j P P' hPP' hQ _ => ?_⟩, fun i => ?_⟩
  · rw [hs, N.ordForm_dlogPow_nodalBranchCoord, hB]
    split_ifs <;> simp
  · refine ⟨1, ⟨N.nodalBranchCoord i, N.ord_nodalBranchCoord i P hQ, Or.inl ?_⟩,
      ⟨N.nodalBranchCoord j, N.ord_nodalBranchCoord j P' (hPP' ▸ hQ), Or.inl ?_⟩⟩
    · rw [hs, map_one, one_smul, sub_self]
    · rw [hs, hm.neg_one_pow, one_mul, map_one, one_smul, sub_self]
  · obtain ⟨hsm, hdim, hnp⟩ := N.isSmoothScheme_dim_not_isProper i
    have hfin := N.finite_setOf_isDoubleNormalCrossingPoint i
    let Δi : QDivisor (N.X i) := Finsupp.ofSupportFinite (N.componentBoundaryCoeff 0 i)
      (hfin.subset fun P hP => by
        by_contra h
        exact hP (by rw [hB]; exact ite_eq_right_iff.mpr fun h' => absurd h' h))
    let Gi : Divisor (N.X i) := Finsupp.ofSupportFinite
      (fun P => if IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1
        ((N.n i).base P.genericPoint) then (m : ℤ) else 0)
      (hfin.subset fun P hP => by
        by_contra h
        exact hP (ite_eq_right_iff.mpr fun h' => absurd h' h))
    have hΔ : ∀ P, Δi.coeff P = N.componentBoundaryCoeff 0 i P := fun P => rfl
    have hG : ∀ P, Gi.coeff P = if IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1
        ((N.n i).base P.genericPoint) then (m : ℤ) else 0 := fun P => rfl
    refine ⟨Δi, Gi, ⟨hSlc, hΔ⟩, ?_⟩
    exact
      { isNormalVariety := N.isNormalVariety i
        isSmoothScheme := hsm
        dim_eq := hdim
        isEffective := fun P => by rw [hΔ, hB]; split_ifs <;> norm_num
        pos := hm0
        toQDivisor_eq := by
          ext P
          rw [Divisor.coeff_toQDivisor, DivisorWithCoeffs.coeff_smul, hG, hΔ, hB]
          split_ifs <;> simp
        mem := by
          rw [mem_pluricanonicalSections_of_ne_bot (by simp)]
          intro P _ _
          rw [hs, N.ordForm_dlogPow_nodalBranchCoord, hG]
          split_ifs <;> simp
        elliptic := fun hp => (hnp hp).elim
        vanishes := fun _ P hP => by
          have hQ : IsDoubleNormalCrossingPoint (nodalCurveStructure k) 1
              ((N.n i).base P.genericPoint) := by
            by_contra h
            rw [hΔ, hB] at hP
            simp only [h, ite_false] at hP
            norm_num at hP
          exact ⟨N.nodalBranchCoord i, N.ord_nodalBranchCoord i P hQ,
            Or.inl (by rw [hs, sub_self])⟩ }

end NormalizationComponents

