/-- **Gluing on two branches.** If `a/s` has square and cube in `R/(pq)` for primes `p`, `q`,
then `s ∣ a` modulo `pq`: the branch values agree modulo `(p, q)`. -/
private theorem exists_dvd_sub_mul_of_sq_cube {R : Type*} [CommRing R] {p q : R}
    (hpp : Prime p) (hqp : Prime q)
    (hpq : ∀ f, p ∣ f → q ∣ f → p * q ∣ f)
    (hp : ∀ a s c : R, ¬ p ∣ s → p ∣ a ^ 2 - c * s ^ 2 → ∃ d, p ∣ a - d * s)
    (hq : ∀ a s c : R, ¬ q ∣ s → q ∣ a ^ 2 - c * s ^ 2 → ∃ d, q ∣ a - d * s)
    (hred : ∀ f : R, f ^ 2 ∈ Ideal.span {p, q} → f ∈ Ideal.span {p, q})
    {a s c₂ c₃ : R} (hs₀ : ¬ p ∣ s) (hs₁ : ¬ q ∣ s)
    (h₂ : p * q ∣ a ^ 2 - c₂ * s ^ 2) (h₃ : p * q ∣ a ^ 3 - c₃ * s ^ 3) :
    ∃ c, p * q ∣ a - c * s := by
  have branch : ∀ {r : R}, Prime r → ¬ r ∣ s → r ∣ a ^ 2 - c₂ * s ^ 2 →
      r ∣ a ^ 3 - c₃ * s ^ 3 → ∀ d, r ∣ a - d * s → r ∣ c₂ - d ^ 2 ∧ r ∣ c₃ - d ^ 3 := by
    intro r hr hrs h2 h3 d hd
    obtain ⟨e, he⟩ := hd
    have ha : a = d * s + r * e := by
      rw [← he]
      ring
    constructor
    · have : r ∣ (c₂ - d ^ 2) * s ^ 2 := by
        have : (c₂ - d ^ 2) * s ^ 2 = -(a ^ 2 - c₂ * s ^ 2) + r * (e * (2 * d * s + r * e)) := by
          rw [ha]
          ring
        rw [this]
        exact dvd_add (dvd_neg.mpr h2) (dvd_mul_right _ _)
      exact (hr.dvd_or_dvd this).resolve_right fun h => hrs (hr.dvd_of_dvd_pow h)
    · have : r ∣ (c₃ - d ^ 3) * s ^ 3 := by
        have : (c₃ - d ^ 3) * s ^ 3 = -(a ^ 3 - c₃ * s ^ 3) +
            r * (e * (3 * d ^ 2 * s ^ 2 + 3 * d * s * r * e + r ^ 2 * e ^ 2)) := by
          rw [ha]
          ring
        rw [this]
        exact dvd_add (dvd_neg.mpr h3) (dvd_mul_right _ _)
      exact (hr.dvd_or_dvd this).resolve_right fun h => hrs (hr.dvd_of_dvd_pow h)
  obtain ⟨d₀, hd₀⟩ := hp a s c₂ hs₀ (dvd_trans (dvd_mul_right p q) h₂)
  obtain ⟨d₁, hd₁⟩ := hq a s c₂ hs₁ (dvd_trans (dvd_mul_left q p) h₂)
  obtain ⟨h20, h30⟩ := branch hpp hs₀ (dvd_trans (dvd_mul_right p q) h₂)
    (dvd_trans (dvd_mul_right p q) h₃) d₀ hd₀
  obtain ⟨h21, h31⟩ := branch hqp hs₁ (dvd_trans (dvd_mul_left q p) h₂)
    (dvd_trans (dvd_mul_left q p) h₃) d₁ hd₁
  set I := Ideal.span {p, q}
  have hpI : ∀ x, p ∣ x → x ∈ I := by
    rintro x ⟨z, rfl⟩
    exact Ideal.mem_span_pair.mpr ⟨z, 0, by ring⟩
  have hqI : ∀ x, q ∣ x → x ∈ I := by
    rintro x ⟨z, rfl⟩
    exact Ideal.mem_span_pair.mpr ⟨0, z, by ring⟩
  have hcube : (d₀ - d₁) ^ 3 ∈ I := by
    rw [show (d₀ - d₁) ^ 3 = 4 * ((c₃ - d₁ ^ 3) - (c₃ - d₀ ^ 3)) -
        3 * (d₀ + d₁) * ((c₂ - d₁ ^ 2) - (c₂ - d₀ ^ 2)) by ring]
    exact I.sub_mem (I.mul_mem_left _ (I.sub_mem (hqI _ h31) (hpI _ h30)))
      (I.mul_mem_left _ (I.sub_mem (hqI _ h21) (hpI _ h20)))
  have hsq : (d₀ - d₁) ^ 2 ∈ I := hred _ (by
    rw [show ((d₀ - d₁) ^ 2) ^ 2 = (d₀ - d₁) * (d₀ - d₁) ^ 3 by ring]
    exact I.mul_mem_left _ hcube)
  obtain ⟨x, y, hxy⟩ := Ideal.mem_span_pair.mp (hred _ hsq)
  refine ⟨d₀ - x * p, hpq _ ?_ ?_⟩
  · obtain ⟨e, he⟩ := hd₀
    exact ⟨e + x * s, by rw [mul_add, ← he]; ring⟩
  · obtain ⟨e, he⟩ := hd₁
    have : d₀ - x * p = d₁ + y * q := by linear_combination -hxy
    rw [this]
    exact ⟨e - y * s, by rw [mul_sub, ← he]; ring⟩

private theorem exists_algebraMap_eq_of_sq_cube {R : Type*} [CommRing R] {p q : R}
    (hpp : Prime p) (hqp : Prime q)
    (hpq : ∀ f, p ∣ f → q ∣ f → p * q ∣ f) (hnp : ¬ p * q ∣ p) (hnq : ¬ p * q ∣ q)
    (hp : ∀ a s c : R, ¬ p ∣ s → p ∣ a ^ 2 - c * s ^ 2 → ∃ d, p ∣ a - d * s)
    (hq : ∀ a s c : R, ¬ q ∣ s → q ∣ a ^ 2 - c * s ^ 2 → ∃ d, q ∣ a - d * s)
    (hred : ∀ f : R, f ^ 2 ∈ Ideal.span {p, q} → f ∈ Ideal.span {p, q})
    (β : FractionRing (R ⧸ Ideal.span {p * q})) (c₂ c₃ : R ⧸ Ideal.span {p * q})
    (h₂ : β ^ 2 = algebraMap (R ⧸ Ideal.span {p * q}) _ c₂)
    (h₃ : β ^ 3 = algebraMap (R ⧸ Ideal.span {p * q}) _ c₃) :
    ∃ c, β = algebraMap (R ⧸ Ideal.span {p * q}) _ c := by
  let C := R ⧸ Ideal.span {p * q}
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors C) β
  simp only at h₂ h₃
  have hinj := IsFractionRing.injective C (FractionRing C)
  have key : ∀ (m : ℕ) (c : C), IsLocalization.mk' (FractionRing C) a s ^ m = algebraMap _ _ c →
      a ^ m = c * (s : C) ^ m := by
    intro m c h
    rw [← IsLocalization.mk'_pow, IsLocalization.mk'_eq_iff_eq_mul] at h
    apply hinj
    rw [h, map_mul, map_pow]
    simp
  have e₂ := key 2 _ h₂
  have e₃ := key 3 _ h₃
  obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨s', hs'⟩ := Ideal.Quotient.mk_surjective (s : C)
  obtain ⟨c₂', rfl⟩ := Ideal.Quotient.mk_surjective c₂
  obtain ⟨c₃', rfl⟩ := Ideal.Quotient.mk_surjective c₃
  have hmk : ∀ x y : R, Ideal.Quotient.mk (Ideal.span {p * q}) x =
      Ideal.Quotient.mk (Ideal.span {p * q}) y ↔ p * q ∣ x - y := by
    intro x y
    rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]
  rw [← hs', ← map_pow, ← map_pow, ← map_mul, hmk] at e₂ e₃
  have hnzd : ∀ r t : R, r * t = p * q → ¬ p * q ∣ t → ¬ r ∣ s' := by
    rintro r t hrt hnt ⟨u, rfl⟩
    have h0 : Ideal.Quotient.mk (Ideal.span {p * q}) t = 0 := by
      have hz : (s : C) * Ideal.Quotient.mk (Ideal.span {p * q}) t = 0 := by
        rw [← hs', ← map_mul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
        exact ⟨u, by rw [← hrt]; ring⟩
      exact (mem_nonZeroDivisors_iff.mp s.2).2 _ (by rwa [mul_comm])
    exact hnt (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h0))
  obtain ⟨c, hc⟩ := exists_dvd_sub_mul_of_sq_cube hpp hqp hpq hp hq hred
    (hnzd p q rfl hnq) (hnzd q p (mul_comm q p) hnp) e₂ e₃
  refine ⟨Ideal.Quotient.mk _ c, ?_⟩
  rw [IsLocalization.mk'_eq_iff_eq_mul, ← map_mul]
  congr 1
  rwa [← hs', ← map_mul, hmk]

section DNC

variable {k : Type*} [Field k] {m : ℕ}

private theorem finSuccEquiv_X_one :
    MvPowerSeries.finSuccEquiv k (m + 1) (MvPowerSeries.X 1) = PowerSeries.C (MvPowerSeries.X 0) :=
  MvPowerSeries.finSuccEquiv_X_succ (R := k) (n := m + 1) (0 : Fin (m + 1))

private theorem restrictZero_X_one :
    restrictZero k (m + 1) (MvPowerSeries.X 1) = MvPowerSeries.X 0 := by
  simp [restrictZero, finSuccEquiv_X_one]

private theorem inclZero_X_zero : inclZero k (m + 1) (MvPowerSeries.X 0) = MvPowerSeries.X 1 := by
  simp only [inclZero, RingHom.coe_comp, Function.comp_apply]
  rw [← finSuccEquiv_X_one]
  simp

/-- The swap of the first two variables. -/
private noncomputable def swap01 (k : Type*) [Field k] (m : ℕ) :
    MvPowerSeries (Fin (m + 2)) k ≃+* MvPowerSeries (Fin (m + 2)) k :=
  (MvPowerSeries.renameEquiv k (Equiv.swap (0 : Fin (m + 2)) 1)).toRingEquiv

private theorem swap01_X_zero : swap01 k m (MvPowerSeries.X 0) = MvPowerSeries.X 1 := by
  simp [swap01, MvPowerSeries.renameEquiv, MvPowerSeries.rename_X]

private theorem swap01_X_one : swap01 k m (MvPowerSeries.X 1) = MvPowerSeries.X 0 := by
  simp [swap01, MvPowerSeries.renameEquiv, MvPowerSeries.rename_X]

private theorem not_X_one_dvd_X_zero :
    ¬ (MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k) ∣ MvPowerSeries.X 0 := by
  intro h
  have h' := (map_dvd_iff (swap01 k m)).mpr h
  rw [swap01_X_zero, swap01_X_one, X_zero_dvd_iff, restrictZero_X_one] at h'
  exact (prime_X (0 : Fin (m + 1)) (k := k)).ne_zero h'

private theorem X_zero_mul_X_one_dvd {f : MvPowerSeries (Fin (m + 2)) k}
    (h0 : MvPowerSeries.X 0 ∣ f) (h1 : MvPowerSeries.X 1 ∣ f) :
    MvPowerSeries.X 0 * MvPowerSeries.X 1 ∣ f := by
  obtain ⟨g, rfl⟩ := h0
  exact mul_dvd_mul_left _
    (((prime_X 1).dvd_or_dvd h1).resolve_left not_X_one_dvd_X_zero)

private theorem not_X_mul_X_dvd_X (i j : Fin (m + 2)) :
    ¬ (MvPowerSeries.X i * MvPowerSeries.X j : MvPowerSeries (Fin (m + 2)) k) ∣
      MvPowerSeries.X i := by
  have : IsRegularLocalRing (MvPowerSeries (Fin (m + 2)) k) := MvPowerSeries.isRegularLocalRing k _
  have : IsDomain (MvPowerSeries (Fin (m + 2)) k) := IsRegularLocalRing.isDomain _
  rintro ⟨r, hr⟩
  apply (prime_X (k := k) j).not_dvd_one
  refine ⟨r, ?_⟩
  have : MvPowerSeries.X i * (1 - MvPowerSeries.X j * r) = (0 : MvPowerSeries (Fin (m + 2)) k) := by
    linear_combination hr
  rcases mul_eq_zero.mp this with h | h
  · exact absurd h (prime_X i).ne_zero
  · linear_combination h

private theorem exists_dvd_sub_mul_of_X_zero_dvd (a s c : MvPowerSeries (Fin (m + 2)) k)
    (h : MvPowerSeries.X 0 ∣ a ^ 2 - c * s ^ 2) :
    ∃ d, MvPowerSeries.X 0 ∣ a - d * s := by
  have : IsRegularLocalRing (MvPowerSeries (Fin (m + 1)) k) := MvPowerSeries.isRegularLocalRing k _
  have : IsDomain (MvPowerSeries (Fin (m + 1)) k) := IsRegularLocalRing.isDomain _
  have : UniqueFactorizationMonoid (MvPowerSeries (Fin (m + 1)) k) :=
    IsRegularLocalRing.uniqueFactorizationMonoid _
  rw [X_zero_dvd_iff, map_sub, map_mul, map_pow, map_pow, sub_eq_zero] at h
  have hdvd : (restrictZero k (m + 1) s) ^ 2 ∣ (restrictZero k (m + 1) a) ^ 2 :=
    ⟨restrictZero k (m + 1) c, by rw [h]; ring⟩
  obtain ⟨d', hd'⟩ := (IsIntegrallyClosed.pow_dvd_pow_iff two_ne_zero).mp hdvd
  refine ⟨inclZero k (m + 1) d', ?_⟩
  rw [X_zero_dvd_iff, map_sub, map_mul, restrictZero_inclZero, hd']
  ring

private theorem exists_dvd_sub_mul_of_X_one_dvd (a s c : MvPowerSeries (Fin (m + 2)) k)
    (h : MvPowerSeries.X 1 ∣ a ^ 2 - c * s ^ 2) :
    ∃ d, MvPowerSeries.X 1 ∣ a - d * s := by
  set σ := swap01 k m
  have hX : ∀ y, MvPowerSeries.X 1 ∣ y ↔ MvPowerSeries.X 0 ∣ σ.symm y := fun y => by
    conv_rhs => rw [← map_dvd_iff σ, RingEquiv.apply_symm_apply, swap01_X_zero]
  rw [hX, map_sub, map_mul, map_pow, map_pow] at h
  obtain ⟨d, hd⟩ := exists_dvd_sub_mul_of_X_zero_dvd _ _ _ h
  refine ⟨σ d, ?_⟩
  rwa [hX, map_sub, map_mul, RingEquiv.symm_apply_apply]

private theorem mem_span_X_zero_X_one_iff (f : MvPowerSeries (Fin (m + 2)) k) :
    f ∈ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ↔
      MvPowerSeries.X 0 ∣ restrictZero k (m + 1) f := by
  constructor
  · intro hf
    obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hf
    rw [map_add, map_mul, map_mul, restrictZero_X_zero, restrictZero_X_one]
    exact ⟨restrictZero k (m + 1) b, by ring⟩
  · rintro ⟨h, hh⟩
    obtain ⟨r, hr⟩ := sub_inclZero_restrictZero_mem f
    rw [hh, map_mul, inclZero_X_zero] at hr
    exact Ideal.mem_span_pair.mpr ⟨r, inclZero k (m + 1) h, by linear_combination -hr⟩

private theorem mem_span_X_zero_X_one_of_sq_mem (f : MvPowerSeries (Fin (m + 2)) k)
    (hf : f ^ 2 ∈ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}) :
    f ∈ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} := by
  rw [mem_span_X_zero_X_one_iff] at hf ⊢
  rw [map_pow] at hf
  exact (prime_X 0).dvd_of_dvd_pow hf

/-- **The double crossing `k[[x₀, …, x_{m+1}]]/(x₀x₁)` is seminormal.** -/
private theorem exists_algebraMap_eq_of_sq_cube_dnc
    (β : FractionRing (MvPowerSeries (Fin (m + 2)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k)}))
    (c₂ c₃ : MvPowerSeries (Fin (m + 2)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k)})
    (h₂ : β ^ 2 = algebraMap (MvPowerSeries (Fin (m + 2)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k)}) _ c₂)
    (h₃ : β ^ 3 = algebraMap (MvPowerSeries (Fin (m + 2)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k)}) _ c₃) :
    ∃ c, β = algebraMap (MvPowerSeries (Fin (m + 2)) k ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin (m + 2)) k)}) _ c :=
  exists_algebraMap_eq_of_sq_cube (prime_X 0) (prime_X 1)
    (fun _ h0 h1 => X_zero_mul_X_one_dvd h0 h1)
    (not_X_mul_X_dvd_X 0 1)
    (by rw [mul_comm]; exact not_X_mul_X_dvd_X 1 0)
    (fun a s c _ => exists_dvd_sub_mul_of_X_zero_dvd a s c)
    (fun a s c _ => exists_dvd_sub_mul_of_X_one_dvd a s c)
    mem_span_X_zero_X_one_of_sq_mem β c₂ c₃ h₂ h₃

end DNC

private theorem mem_range_of_tmul_one_eq {A A' B : Type*} [CommRing A] [CommRing A'] [CommRing B]
    [Algebra A A'] [Algebra A B] [Module.FaithfullyFlat A B] (b : A') (c : B)
    (h : b ⊗ₜ[A] (1 : B) = (1 : A') ⊗ₜ[A] c) : ∃ a : A, algebraMap A A' a = b := by
  set N := LinearMap.range (Algebra.linearMap A A')
  have h1 : (N.mkQ.rTensor B) (b ⊗ₜ[A] (1 : B)) = 0 := by
    rw [h, LinearMap.rTensor_tmul]
    have : N.mkQ 1 = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨1, by simp⟩
    rw [this, TensorProduct.zero_tmul]
  rw [LinearMap.rTensor_tmul] at h1
  have h2 : (1 : B) ⊗ₜ[A] N.mkQ b = 0 := by
    simpa using congrArg (TensorProduct.comm A (A' ⧸ N) B) h1
  rw [Module.FaithfullyFlat.one_tmul_eq_zero_iff, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at h2
  exact h2

/-- Seminormality in the total ring of fractions is invariant under ring isomorphisms. -/
private theorem exists_algebraMap_eq_of_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S)
    (hS : ∀ (β : FractionRing S) (c₂ c₃ : S), β ^ 2 = algebraMap S _ c₂ →
      β ^ 3 = algebraMap S _ c₃ → ∃ c, β = algebraMap S _ c)
    (β : FractionRing R) (c₂ c₃ : R) (h₂ : β ^ 2 = algebraMap R _ c₂)
    (h₃ : β ^ 3 = algebraMap R _ c₃) : ∃ c, β = algebraMap R _ c := by
  let E : FractionRing R ≃+* FractionRing S :=
    IsLocalization.ringEquivOfRingEquiv (FractionRing R) (FractionRing S) e
      (MulEquivClass.map_nonZeroDivisors e)
  have hE : ∀ x : R, E (algebraMap R _ x) = algebraMap S _ (e x) := fun x =>
    IsLocalization.ringEquivOfRingEquiv_eq _ x
  obtain ⟨c, hc⟩ := hS (E β) (e c₂) (e c₃) (by rw [← map_pow, h₂, hE])
    (by rw [← map_pow, h₃, hE])
  refine ⟨e.symm c, E.injective ?_⟩
  rw [hE, RingEquiv.apply_symm_apply, hc]

/-- **Seminormality descends from the completion.** -/
private theorem exists_algebraMap_eq_of_completion {k : Type u} [Field k] (X : Scheme.{u})
    [IsReduced X]
    (π : X ⟶ Spec (.of k)) [LocallyOfFiniteType π]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite) (x : X)
    (hS : ∀ (β : FractionRing (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
        (X.presheaf.stalk x))) (c₂ c₃ : AdicCompletion (maximalIdeal (X.presheaf.stalk x))
        (X.presheaf.stalk x)),
      β ^ 2 = algebraMap (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
        (X.presheaf.stalk x)) _ c₂ →
      β ^ 3 = algebraMap (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
        (X.presheaf.stalk x)) _ c₃ →
      ∃ c, β = algebraMap (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
        (X.presheaf.stalk x)) _ c) :
    letI := Scheme.normalizationPushforwardStalkAlgebra X hX x
    ∀ (b : Scheme.normalizationPushforwardStalk X hX x) (a₂ a₃ : X.presheaf.stalk x),
      b ^ 2 = algebraMap (X.presheaf.stalk x) _ a₂ → b ^ 3 = algebraMap (X.presheaf.stalk x) _ a₃ →
        ∃ a, algebraMap (X.presheaf.stalk x) _ a = b := by
  obtain ⟨-, -, g, hg, -, hgy⟩ :=
    MMP.Resolution.isReduced_adicCompletion_stalk_and_normalization_completion X π hX x
  intro b a₂ a₃ h₂ h₃
  let _ : Algebra (X.presheaf.stalk x) (Scheme.normalizationPushforwardStalk X hX x) :=
    Scheme.normalizationPushforwardStalkAlgebra X hX x
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian π
  have : Module.Flat (X.presheaf.stalk x) (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
      (X.presheaf.stalk x)) := AdicCompletion.flat_of_isNoetherian _
  have : Module.FaithfullyFlat (X.presheaf.stalk x)
      (AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x)) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hcube : ∀ (j : ℕ) (a : X.presheaf.stalk x), b ^ j = algebraMap _ _ a →
      g (b ⊗ₜ (1 : AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))) ^ j =
        algebraMap (AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x)) _
          (algebraMap _ _ a) := by
    intro j a h
    rw [← map_pow, Algebra.TensorProduct.tmul_pow, one_pow, h, ← hgy,
      Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one]
  obtain ⟨c, hc⟩ := hS _ _ _ (hcube 2 a₂ h₂) (hcube 3 a₃ h₃)
  rw [← hgy] at hc
  exact mem_range_of_tmul_one_eq b c (hg hc)

/-- Seminormality at `p`, with denominators outside `p`. -/
private def SeminormalAt {A : Type*} (B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    (p : Ideal A) : Prop :=
  ∀ (b : B) (t₂ t₃ : A), t₂ ∉ p → t₃ ∉ p →
    (∃ a₂, algebraMap A B a₂ = algebraMap A B t₂ * b ^ 2) →
    (∃ a₃, algebraMap A B a₃ = algebraMap A B t₃ * b ^ 3) →
    ∃ s ∉ p, ∃ a, algebraMap A B a = algebraMap A B s * b

private theorem SeminormalAt.mono {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {p q : Ideal A} [p.IsPrime] [q.IsPrime] (h : SeminormalAt B q) (hpq : p ≤ q) :
    SeminormalAt B p := by
  intro b t₂ t₃ ht₂ ht₃ ⟨a₂, ha₂⟩ ⟨a₃, ha₃⟩
  have h1 : (1 : A) ∉ q := (Ideal.ne_top_iff_one q).mp Ideal.IsPrime.ne_top'
  obtain ⟨s, hs, a, ha⟩ := h (algebraMap A B (t₂ * t₃) * b) 1 1 h1 h1
    ⟨t₂ * t₃ ^ 2 * a₂, by
      rw [map_one, one_mul, map_mul, map_mul, map_pow, ha₂]; simp only [map_mul]; ring⟩
    ⟨t₂ ^ 3 * t₃ ^ 2 * a₃, by
      rw [map_one, one_mul, map_mul, map_mul, map_pow, map_pow, ha₃]; simp only [map_mul]; ring⟩
  refine ⟨s * (t₂ * t₃), fun hm => ?_, a, by rw [ha]; simp only [map_mul]; ring⟩
  rcases Ideal.IsPrime.mem_or_mem inferInstance hm with h' | h'
  · exact hs (hpq h')
  · rcases Ideal.IsPrime.mem_or_mem inferInstance h' with h'' | h''
    · exact ht₂ h''
    · exact ht₃ h''

/-- Seminormality of `R → S`: an element of `S` whose square and cube come from `R` comes from
`R`. -/
private def IsSeminormalHom (R S : Type*) [CommRing R] [CommRing S] [Algebra R S] : Prop :=
  ∀ (β : S) (α₂ α₃ : R), β ^ 2 = algebraMap R S α₂ → β ^ 3 = algebraMap R S α₃ →
    ∃ α, algebraMap R S α = β

section Localization

variable {A B R S : Type*} [CommRing A] [CommRing B] [CommRing R] [CommRing S] [Algebra A B]
  [Algebra A R] [Algebra R S] [Algebra B S] (p : Ideal A) [p.IsPrime] [IsLocalization.AtPrime R p]
  [IsLocalization (Algebra.algebraMapSubmonoid B p.primeCompl) S]

private theorem seminormalAt_of_isSeminormalHom
    (hcomm : ∀ a : A, algebraMap R S (algebraMap A R a) = algebraMap B S (algebraMap A B a))
    (h : IsSeminormalHom R S) : SeminormalAt B p := by
  intro b t₂ t₃ ht₂ ht₃ ⟨a₂, ha₂⟩ ⟨a₃, ha₃⟩
  have hu : ∀ t ∉ p, IsUnit (algebraMap A R t) := fun t ht =>
    IsLocalization.map_units R (⟨t, ht⟩ : p.primeCompl)
  have key : ∀ (j : ℕ) (t : p.primeCompl) (a : A),
      algebraMap A B a = algebraMap A B t * b ^ j →
      (algebraMap B S b) ^ j = algebraMap R S (IsLocalization.mk' R a t) := by
    intro j t a hta
    have hu' : IsUnit (algebraMap R S (algebraMap A R t)) := (hu t t.2).map _
    apply hu'.mul_left_cancel
    rw [← map_mul, IsLocalization.mk'_spec', hcomm, hcomm, ← map_pow, ← map_mul, hta]
  obtain ⟨α, hα⟩ := h _ _ _ (key 2 ⟨t₂, ht₂⟩ a₂ ha₂) (key 3 ⟨t₃, ht₃⟩ a₃ ha₃)
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl α
  have h1 : algebraMap B S (algebraMap A B a) = algebraMap B S (algebraMap A B s * b) := by
    rw [map_mul, ← hcomm, ← hcomm, ← hα, ← map_mul, IsLocalization.mk'_spec']
  obtain ⟨⟨_, s', hs', rfl⟩, hc⟩ := IsLocalization.exists_of_eq
    (M := Algebra.algebraMapSubmonoid B p.primeCompl) h1
  refine ⟨s' * s, p.primeCompl.mul_mem hs' s.2, s' * a, ?_⟩
  simp only at hc
  rw [map_mul, map_mul, hc]
  ring

private theorem isSeminormalHom_of_seminormalAt
    (hcomm : ∀ a : A, algebraMap R S (algebraMap A R a) = algebraMap B S (algebraMap A B a))
    (h : SeminormalAt B p) : IsSeminormalHom R S := by
  intro β α₂ α₃ h₂ h₃
  obtain ⟨⟨b, _, t, ht, rfl⟩, rfl⟩ := IsLocalization.mk'_surjective
    (Algebra.algebraMapSubmonoid B p.primeCompl) β
  have key : ∀ (j : ℕ) (α : R), IsLocalization.mk' S b
      (⟨algebraMap A B t, t, ht, rfl⟩ : Algebra.algebraMapSubmonoid B p.primeCompl) ^ j =
        algebraMap R S α → ∃ t' ∉ p, ∃ a', algebraMap A B a' = algebraMap A B t' * b ^ j := by
    intro j α hj
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl α
    rw [← IsLocalization.mk'_pow, IsLocalization.mk'_eq_iff_eq_mul] at hj
    have h1 : algebraMap B S (algebraMap A B s * b ^ j) =
        algebraMap B S (algebraMap A B (a * t ^ j)) := by
      have hs : algebraMap R S (algebraMap A R s) * algebraMap R S (IsLocalization.mk' R a s) =
          algebraMap R S (algebraMap A R a) := by
        rw [← map_mul, IsLocalization.mk'_spec']
      rw [map_mul, hj, ← hcomm, map_mul, map_mul, ← hcomm, ← hs]
      simp only [SubmonoidClass.coe_pow, map_pow, hcomm]
      ring
    obtain ⟨⟨_, u, hu, rfl⟩, hc⟩ := IsLocalization.exists_of_eq
      (M := Algebra.algebraMapSubmonoid B p.primeCompl) h1
    refine ⟨u * s, p.primeCompl.mul_mem hu s.2, u * (a * t ^ j), ?_⟩
    simp only at hc
    rw [map_mul, ← hc, map_mul]
    ring
  obtain ⟨t₂, ht₂, a₂, ha₂⟩ := key 2 α₂ h₂
  obtain ⟨t₃, ht₃, a₃, ha₃⟩ := key 3 α₃ h₃
  obtain ⟨s, hs, a, ha⟩ := h b t₂ t₃ ht₂ ht₃ ⟨a₂, ha₂⟩ ⟨a₃, ha₃⟩
  set st : p.primeCompl := ⟨s * t, p.primeCompl.mul_mem (show s ∈ p.primeCompl from hs) ht⟩
  refine ⟨IsLocalization.mk' R a st, ?_⟩
  rw [IsLocalization.eq_mk'_iff_mul_eq]
  have hu : IsUnit (algebraMap R S (algebraMap A R s)) :=
    (IsLocalization.map_units R (⟨s, hs⟩ : p.primeCompl)).map _
  apply hu.mul_left_cancel
  have h1 : algebraMap R S (algebraMap A R (st : A)) * algebraMap R S (IsLocalization.mk' R a st) =
      algebraMap B S (algebraMap A B a) := by
    rw [← map_mul, IsLocalization.mk'_spec', hcomm]
  simp only [st, map_mul, hcomm] at h1 ⊢
  rw [ha, map_mul] at h1
  linear_combination h1

end Localization

section Conductor

variable {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]

/-- **Common multipliers in a finite algebra.** If every `c ∈ B` is carried into `A` by
`s_c x` for some `s_c` in a submonoid `M` of `A`, then a single `s ∈ M` (the product of the
`s_c` over generators of `B`) carries every `c` into `A` by `s x`. -/
private theorem exists_mem_forall_exists_algebraMap_eq [Module.Finite A B] (M : Submonoid A)
    (x : B) (h : ∀ c : B, ∃ s ∈ M, ∃ a : A, algebraMap A B a = algebraMap A B s * (x * c)) :
    ∃ s ∈ M, ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B s * x * c := by
  classical
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := A) (M := B)
  choose! sf hsf af haf using h
  let N := (LinearMap.range (Algebra.linearMap A B)).comap
    (LinearMap.mulLeft A (algebraMap A B (∏ i ∈ S, sf i) * x))
  have hSN : (S : Set B) ⊆ N := fun i hi => ⟨(∏ j ∈ S.erase i, sf j) * af i, by
    simp only [Algebra.linearMap_apply, LinearMap.mulLeft_apply]
    rw [map_mul, haf i, ← mul_assoc, ← map_mul, Finset.prod_erase_mul _ _ hi, mul_assoc]⟩
  refine ⟨∏ i ∈ S, sf i, M.prod_mem fun i _ => hsf i, fun c => ?_⟩
  obtain ⟨a, ha⟩ := (top_le_iff.1 (hS ▸ Submodule.span_le.2 hSN) ▸ Submodule.mem_top : c ∈ N)
  exact ⟨a, ha⟩

/-- A seminormal ring has radical conductor: if `z²` is in the conductor `θB`, so is `s z` for
some `s ∉ p`. -/
private theorem exists_smul_mem_conductor_of_sq [Module.Finite A B] {p : Ideal A} [p.IsPrime]
    (hSN : SeminormalAt B p) (θ : A)
    (hθ₁ : ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B θ * c)
    (hθ₂ : ∀ x : B, (∀ c : B, ∃ a : A, algebraMap A B a = x * c) →
      ∃ β : B, x = algebraMap A B θ * β)
    (z β : B) (hz : z ^ 2 = algebraMap A B θ * β) :
    ∃ s ∉ p, ∃ β' : B, algebraMap A B s * z = algebraMap A B θ * β' := by
  have h1 : (1 : A) ∉ p := (Ideal.ne_top_iff_one p).mp Ideal.IsPrime.ne_top'
  have hc : ∀ c : B, ∃ s ∉ p, ∃ a : A, algebraMap A B a = algebraMap A B s * (z * c) := by
    intro c
    obtain ⟨a₂, ha₂⟩ := hθ₁ (β * c ^ 2)
    obtain ⟨a₃, ha₃⟩ := hθ₁ (β * z * c ^ 3)
    refine hSN (z * c) 1 1 h1 h1 ⟨a₂, ?_⟩ ⟨a₃, ?_⟩
    · rw [ha₂, map_one, one_mul, mul_pow, hz]
      ring
    · rw [ha₃, map_one, one_mul, mul_pow, show z ^ 3 = z ^ 2 * z by ring, hz]
      ring
  obtain ⟨s, hs, hcond⟩ := exists_mem_forall_exists_algebraMap_eq p.primeCompl z hc
  exact ⟨s, hs, hθ₂ _ hcond⟩

/-- In a discrete valuation ring a nonzero non-unit `x` with `x ∣ w² → x ∣ w` is a
uniformizer. -/
private theorem irreducible_of_dvd_sq {R : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R]
    {x : R} (hx0 : x ≠ 0) (hxu : ¬ IsUnit x) (h : ∀ w : R, x ∣ w ^ 2 → x ∣ w) :
    Irreducible x := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, hn⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx0 hϖ
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hxu (hn.isUnit_iff.mpr (by simp))
  have hn1 : n = 1 := by
    by_contra hne
    have hle : n ≤ 2 * (n - 1) := by omega
    have h1 : x ∣ (ϖ ^ (n - 1)) ^ 2 := by
      rw [← pow_mul, mul_comm]
      exact hn.dvd.trans (pow_dvd_pow ϖ hle)
    have h2 := hn.symm.dvd.trans (h _ h1)
    rw [pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit] at h2
    omega
  subst hn1
  exact (pow_one ϖ ▸ hn).symm.irreducible hϖ

/-- **The conductor of a seminormal ring is a uniformizer at the points over `p`.** Let `B` be a
finite `A`-algebra, seminormal at the prime `p`, with conductor `θB`, `θ ∈ A`, containing a
non-zero-divisor of `B`. At a prime `q` of `B` over `p` containing `θ` whose localization `R` is a
discrete valuation ring, `θ` is a uniformizer of `R`. -/
private theorem irreducible_algebraMap_of_seminormalAt [Module.Finite A B] {p : Ideal A} [p.IsPrime]
    (hSN : SeminormalAt B p) (θ : A)
    (hθ₁ : ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B θ * c)
    (hθ₂ : ∀ x : B, (∀ c : B, ∃ a : A, algebraMap A B a = x * c) →
      ∃ β : B, x = algebraMap A B θ * β)
    (hbir : ∃ r : A, algebraMap A B r ∈ nonZeroDivisors B ∧
      ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B r * c)
    (q : Ideal B) [q.IsPrime] (hqp : q.comap (algebraMap A B) = p) (hθq : algebraMap A B θ ∈ q)
    (R : Type*) [CommRing R] [Algebra B R] [IsLocalization.AtPrime R q] [IsDomain R]
    [IsDiscreteValuationRing R] :
    Irreducible (algebraMap B R (algebraMap A B θ)) := by
  have hnq : ∀ s : A, s ∉ p → algebraMap A B s ∉ q := fun s hs h => hs (hqp ▸ h)
  refine irreducible_of_dvd_sq ?_ ?_ ?_
  · intro h0
    obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl R _).mp h0
    obtain ⟨r, hr, hrc⟩ := hbir
    obtain ⟨β, hβ⟩ := hθ₂ _ hrc
    have : (u : B) * algebraMap A B r = 0 := by rw [hβ, ← mul_assoc, hu, zero_mul]
    have hu0 : (u : B) = 0 := (mem_nonZeroDivisors_iff.mp hr).2 _ this
    exact u.2 (hu0 ▸ q.zero_mem)
  · rw [IsLocalization.AtPrime.isUnit_to_map_iff R q]
    exact not_not.mpr hθq
  · intro w ⟨v, hv⟩
    obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl w
    obtain ⟨⟨c, t'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl v
    simp only at hv
    rw [← IsLocalization.mk'_pow, ← IsLocalization.mk'_one (M := q.primeCompl) R,
      ← IsLocalization.mk'_mul, IsLocalization.mk'_eq_iff_eq] at hv
    obtain ⟨u, hu⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) hv
    simp only [one_mul, SubmonoidClass.coe_pow] at hu
    set z := (u : B) * t' * b
    have hz : z ^ 2 = algebraMap A B θ * ((u : B) ^ 2 * t' * c * t ^ 2) := by
      have : z ^ 2 = (u : B) * t' * ((u : B) * (t' * b ^ 2)) := by ring
      rw [this, hu]
      ring
    obtain ⟨s, hs, β', hβ'⟩ := exists_smul_mem_conductor_of_sq hSN θ hθ₁ hθ₂ z _ hz
    have hd : algebraMap A B s * (u : B) * t' * t ∈ q.primeCompl :=
      q.primeCompl.mul_mem (q.primeCompl.mul_mem (q.primeCompl.mul_mem (hnq s hs) u.2) t'.2) t.2
    refine ⟨IsLocalization.mk' R β' ⟨_, hd⟩, ?_⟩
    rw [← IsLocalization.mk'_one (M := q.primeCompl) R, ← IsLocalization.mk'_mul,
      IsLocalization.mk'_eq_iff_eq]
    simp only [one_mul]
    rw [← hβ']
    congr 1
    simp only [z]
    ring

end Conductor

/-- If the conductor `θB` is not inside `p`, the localizations of `A` at `p` and of `B` at a
prime `q` over `p` agree. -/
private theorem bijective_of_notMem_conductor {A B RA RB : Type*} [CommRing A] [CommRing B]
    [CommRing RA]
    [CommRing RB] [Algebra A B] [Algebra A RA] [Algebra B RB] {p : Ideal A} [p.IsPrime]
    [IsLocalization.AtPrime RA p] (q : Ideal B) [q.IsPrime] [IsLocalization.AtPrime RB q]
    (hqp : q.comap (algebraMap A B) = p) (hinj : Function.Injective (algebraMap A B))
    (θ : A) (hθp : θ ∉ p) (hθ₁ : ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B θ * c)
    (φ : RA →+* RB) (hφ : ∀ a : A, φ (algebraMap A RA a) = algebraMap B RB (algebraMap A B a)) :
    Function.Bijective φ := by
  have hθq : algebraMap A B θ ∉ q := fun h => hθp (hqp ▸ h)
  have hout : ∀ (c : B) (a : A), c ∉ q → algebraMap A B a = algebraMap A B θ * c → a ∉ p := by
    intro c a hc ha hap
    have : algebraMap A B a ∈ q := by rwa [← Ideal.mem_comap, hqp]
    rw [ha] at this
    exact (Ideal.IsPrime.mem_or_mem inferInstance this).elim hθq hc
  have huA : ∀ a : A, a ∉ p → IsUnit (algebraMap A RA a) := fun a ha =>
    IsLocalization.map_units RA (⟨a, ha⟩ : p.primeCompl)
  have huB : ∀ c : B, c ∉ q → IsUnit (algebraMap B RB c) := fun c hc =>
    IsLocalization.map_units RB (⟨c, hc⟩ : q.primeCompl)
  refine ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z
    have h1 : algebraMap B RB (algebraMap A B a) = 0 := by
      rw [← hφ, ← IsLocalization.mk'_spec' RA a s, map_mul, hz, mul_zero]
    obtain ⟨u, hu⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl RB _).mp h1
    obtain ⟨au, hau⟩ := hθ₁ u
    have hau' := hout u au u.2 hau
    have h2 : au * a = 0 := hinj (by rw [map_mul, hau, mul_assoc, hu, mul_zero, map_zero])
    have h3 : algebraMap A RA a = 0 := by
      have := congrArg (algebraMap A RA) h2
      rw [map_mul, map_zero] at this
      exact (huA au hau').mul_right_eq_zero.mp this
    rw [IsLocalization.mk'_eq_zero_iff]
    exact (IsLocalization.map_eq_zero_iff p.primeCompl RA a).mp h3
  · intro w
    obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl w
    obtain ⟨ab, hab⟩ := hθ₁ b
    obtain ⟨at', hat⟩ := hθ₁ t
    have hat' := hout t at' t.2 hat
    set T : p.primeCompl := ⟨at', hat'⟩
    refine ⟨IsLocalization.mk' RA ab T, ?_⟩
    rw [IsLocalization.eq_mk'_iff_mul_eq]
    apply (huB _ hθq).mul_left_cancel
    have h1 : φ (algebraMap A RA (T : A)) * φ (IsLocalization.mk' RA ab T) =
        φ (algebraMap A RA ab) := by
      rw [← map_mul, IsLocalization.mk'_spec']
    rw [hφ, hφ, hat, hab, map_mul, map_mul] at h1
    linear_combination h1

section Geometry

/-- **A double normal crossing point is seminormal.** -/
private theorem isSeminormalHom_stalk_of_isDoubleNormalCrossingPoint {k : Type u} [Field k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX] [IsReduced X]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite) {n : ℕ}
    {x : X} (hx : IsDoubleNormalCrossingPoint sX (n + 1) x) :
    letI := Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX x
    IsSeminormalHom (X.presheaf.stalk x)
      (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX x) := by
  let := (stalkStructureMap sX x).toAlgebra
  obtain ⟨e⟩ := hx.2.2
  exact exists_algebraMap_eq_of_completion X sX hX x
    (exists_algebraMap_eq_of_ringEquiv e.toRingEquiv exists_algebraMap_eq_of_sq_cube_dnc)

/-- **Seminormality of a stalk is seminormality of an affine chart at the prime.** -/
private theorem isSeminormalHom_stalk_iff_seminormalAt {X : Scheme.{u}}
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    {U : X.Opens} (hU : IsAffineOpen U) {z : X} (hz : z ∈ U) :
    letI := Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX z
    letI := ((normalization X hX).app U).hom.toAlgebra
    IsSeminormalHom (X.presheaf.stalk z)
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX z) ↔
      SeminormalAt Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)
        (hU.primeIdealOf ⟨z, hz⟩).asIdeal := by
  let := Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX z
  let _ : Algebra Γ(X, U) Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) :=
    ((normalization X hX).app U).hom.toAlgebra
  let _ : Algebra Γ(X, U) (X.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨z, hz⟩
  have : IsLocalization.AtPrime (X.presheaf.stalk z) (hU.primeIdealOf ⟨z, hz⟩).asIdeal :=
    hU.isLocalization_stalk ⟨z, hz⟩
  let _ : Algebra Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)
      (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX z) :=
    (((normalization X hX).base _* (normalizationScheme X hX).presheaf).germ U z hz).hom.toAlgebra
  have : IsLocalization (Algebra.algebraMapSubmonoid
      Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)
        (hU.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl)
      (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX z) :=
    Stacks.NormalizationStalkAmbient.isLocalization_normalizationPushforwardStalk X hX hU hz
  have hcomm : ∀ a : Γ(X, U),
      algebraMap (X.presheaf.stalk z)
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX z)
        (algebraMap Γ(X, U) (X.presheaf.stalk z) a) =
      algebraMap Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX z)
        (algebraMap Γ(X, U) Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) a) :=
    fun a => TopCat.Presheaf.stalkFunctor_map_germ_apply U z hz (normalization X hX).c a
  exact ⟨seminormalAt_of_isSeminormalHom _ hcomm, isSeminormalHom_of_seminormalAt _ hcomm⟩

/-- A generization inside an affine open has a smaller prime ideal. -/
private theorem primeIdealOf_le_of_specializes {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    {z w : X} (hz : z ∈ U) (hw : w ∈ U) (h : z ⤳ w) :
    (hU.primeIdealOf ⟨z, hz⟩).asIdeal ≤ (hU.primeIdealOf ⟨w, hw⟩).asIdeal := by
  have h' : hU.fromSpec (hU.primeIdealOf ⟨z, hz⟩) ⤳ hU.fromSpec (hU.primeIdealOf ⟨w, hw⟩) := by
    rwa [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf]
  exact (PrimeSpectrum.le_iff_specializes _ _).mpr
    ((hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp h')

/-- **Seminormality at a codimension-one point of an `n`-fold nc in codimension one.** A
non-regular point `P` of codimension one specializes to a closed point `x` outside the
exceptional set, which is a double normal crossing point (it is not smooth, as `P` is not
regular); `𝒪_{X,x}` is seminormal, hence so is its localization `𝒪_{X,P}`. -/
private theorem isSeminormalHom_stalk_of_isNcInCodimOne {k : Type u} [Field k]
    {X : Scheme.{u}} {sX : X ⟶ Spec (.of k)} [LocallyOfFiniteType sX] [IsReduced X]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite) {n : ℕ}
    (hn : 1 ≤ n) (hnc : IsNcInCodimOne sX n) {P : X} (hP : Order.coheight P = 1)
    (hPsing : ¬ IsRegularLocalRing (X.presheaf.stalk P)) :
    letI := Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX P
    IsSeminormalHom (X.presheaf.stalk P)
      (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX P) := by
  obtain ⟨-, Z, hZ, hpts⟩ := hnc
  have hPZ : P ∉ (Z : Set X) := by
    intro h
    have := (le_closedsCodimension_iff_le_coheight.mp hZ) P h
    rw [hP] at this
    exact absurd this (by decide)
  have : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace sX
  have hlc : IsLocallyClosed (closure {P} ∩ (Z : Set X)ᶜ) :=
    isClosed_closure.isLocallyClosed.inter Z.isClosed.isOpen_compl.isLocallyClosed
  obtain ⟨x, ⟨hxP, hxZ⟩, hxc⟩ := nonempty_inter_closedPoints
    (Z := closure {P} ∩ (Z : Set X)ᶜ) ⟨P, subset_closure rfl, hPZ⟩ hlc
  have hPx : P ⤳ x := specializes_iff_mem_closure.mpr hxP
  rcases hpts x hxc hxZ with hsm | hdnc
  · exfalso
    apply hPsing
    obtain ⟨U, hxU, hU⟩ := mem_smoothLocus_iff.mp hsm
    have hPU : P ∈ U := hPx.mem_open U.isOpen hxU
    have : Smooth (U.ι ≫ sX) := hU
    have := isRegularLocalRing_stalk_of_smooth_over_field (U.ι ≫ sX) ⟨P, hPU⟩
    exact IsRegularLocalRing.of_ringEquiv (U.stalkIso ⟨P, hPU⟩).commRingCatIsoToRingEquiv
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (Set.mem_univ x) isOpen_univ
  have hPU : P ∈ U := hPx.mem_open U.isOpen hxU
  let _ : Algebra Γ(X, U) Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) :=
    ((normalization X hX).app U).hom.toAlgebra
  have hx := (isSeminormalHom_stalk_iff_seminormalAt hX hU hxU).mp
    (isSeminormalHom_stalk_of_isDoubleNormalCrossingPoint hX hdnc)
  exact (isSeminormalHom_stalk_iff_seminormalAt hX hU hPU).mpr
    (hx.mono (primeIdealOf_le_of_specializes hU hPU hxU hPx))

end Geometry

section Trace

/-- **A free rank-one restriction gives a local generator.** If `M|_W ≅ 𝒪_W`, the section of `M`
over `W` corresponding to `1` generates `M` on `W`. -/
private theorem exists_isLocalGenerator_of_restrict_iso_free {Y : Scheme.{u}} (M : Y.Modules)
    (W : Y.Opens) (e : M.restrict W.ι ≅ SheafOfModules.free.{u} (ULift.{u} (Fin 1))) :
    ∃ g : Γ(M, W), IsLocalGenerator M g := by
  let φ : M.restrict W.ι ≅ SheafOfModules.unit (W : Scheme.{u}).ringCatSheaf :=
    e ≪≫ Limits.coproductUniqueIso (fun _ : ULift.{u} (Fin 1) =>
      SheafOfModules.unit (W : Scheme.{u}).ringCatSheaf)
  let ψ := φ.inv
  have hψ : ∀ V : (W : Scheme.{u}).Opens, Function.Bijective (ψ.app V) := by
    intro V
    refine ⟨fun a b h => ?_, fun m => ⟨φ.hom.app V m, ?_⟩⟩
    · have := congrArg (φ.hom.app V) h
      have e1 := congrArg (fun χ => Scheme.Modules.Hom.app χ V a) φ.inv_hom_id
      have e2 := congrArg (fun χ => Scheme.Modules.Hom.app χ V b) φ.inv_hom_id
      simp only at e1 e2
      exact e1.symm.trans (this.trans e2)
    · exact congrArg (fun χ => Scheme.Modules.Hom.app χ V m) φ.hom_inv_id
  let n : Γ(M.restrict W.ι, ⊤) := ψ.app ⊤ (Stacks.Duality.FiniteTrace.unitOne ⊤)
  have hgen : IsLocalGenerator M (V := W.ι ''ᵁ ⊤) n := by
    intro V' hV'
    obtain ⟨V, rfl⟩ : ∃ V : (W : Scheme.{u}).Opens, W.ι ''ᵁ V = V' :=
      ⟨W.ι ⁻¹ᵁ V', by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
        exact inf_eq_right.2 (hV'.trans (by simp))⟩
    have hres : M.presheaf.map (homOfLE hV').op n =
        ψ.app V (Stacks.Duality.FiniteTrace.unitOne V) := by
      have := modulesHom_app_map ψ (le_top : V ≤ ⊤) (Stacks.Duality.FiniteTrace.unitOne ⊤)
      refine Eq.trans ?_ (this.symm.trans ?_)
      · rfl
      · congr 1
        change (W : Scheme.{u}).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (1 : Γ(W, ⊤)) = 1
        exact map_one _
    have key : ∀ r : Γ(Y, W.ι ''ᵁ V), r • M.presheaf.map (homOfLE hV').op n =
        ψ.app V ((W.ι.appIso V).hom r) := by
      intro r
      rw [hres]
      refine Eq.trans ?_ (Stacks.Duality.FiniteTrace.app_eq_smul_app_one ψ V _).symm
      exact congrArg (fun s : Γ(Y, W.ι ''ᵁ V) =>
        s • @id Γ(M, W.ι ''ᵁ V) (ψ.app V (Stacks.Duality.FiniteTrace.unitOne V)))
        (Iso.hom_inv_id_apply (W.ι.appIso V) r).symm
    refine ⟨fun a b hab => ?_, fun m => ?_⟩
    · have h1 := (hψ V).1 ((key a).symm.trans (hab.trans (key b)))
      have h2 := congrArg (W.ι.appIso V).inv h1
      rwa [Iso.hom_inv_id_apply, Iso.hom_inv_id_apply] at h2
    · obtain ⟨t, rfl⟩ := (hψ V).2 m
      refine ⟨(W.ι.appIso V).inv t, ?_⟩
      refine (key _).trans ?_
      exact congrArg (ψ.app V) (Iso.inv_hom_id_apply (W.ι.appIso V) t)
  have hle : W ≤ W.ι ''ᵁ ⊤ := by simp
  exact ⟨_, hgen.restrict hle⟩

/-- **Generating is local.** A section that generates `M` on a neighbourhood of every point of
`O` generates `M` on `O`. -/
private theorem isLocalGenerator_of_forall_mem {Y : Scheme.{u}} (M : Y.Modules) {O : Y.Opens}
    (m : Γ(M, O))
    (h : ∀ x ∈ O, ∃ (V : Y.Opens) (hV : V ≤ O), x ∈ V ∧
      IsLocalGenerator M (M.presheaf.map (homOfLE hV).op m)) :
    IsLocalGenerator M m := by
  classical
  intro V' hV'
  choose Vx hVx hxV hgen using fun x : V' => h x.1 (hV' x.2)
  have hbij : ∀ (x : V') (W : Y.Opens) (hW : W ≤ Vx x),
      Function.Bijective fun r : Γ(Y, W) => r • M.presheaf.map (homOfLE (hW.trans (hVx x))).op m :=
    fun x W hW => by simpa only [modules_map_map] using hgen x W hW
  let L : V' → Y.Opens := fun x => V' ⊓ Vx x
  have hLV : ∀ x, L x ≤ V' := fun _ => inf_le_left
  have hLO : ∀ x, L x ≤ Vx x := fun _ => inf_le_right
  have hcov : V' ≤ iSup L := fun y hy => Opens.mem_iSup.2 ⟨⟨y, hy⟩, hy, hxV _⟩
  have hres : ∀ (W W' : Y.Opens) (hW : W ≤ W') (hW' : W' ≤ O) (r : Γ(Y, W')),
      M.presheaf.map (homOfLE hW).op (r • M.presheaf.map (homOfLE hW').op m) =
        Y.presheaf.map (homOfLE hW).op r • M.presheaf.map (homOfLE (hW.trans hW')).op m := by
    intro W W' hW hW' r
    rw [Scheme.Modules.map_smul, modules_map_map]
  refine ⟨fun a b hab => ?_, fun s => ?_⟩
  · refine TopCat.Sheaf.eq_of_locally_eq' Y.sheaf L V' (fun x => homOfLE (hLV x)) hcov a b
      (fun x => (hbij x (L x) (hLO x)).1 ?_)
    have := congrArg (M.presheaf.map (homOfLE (hLV x)).op) hab
    simp only at this
    rwa [hres _ _ _ hV', hres _ _ _ hV'] at this
  · -- local coefficients
    choose c hc using fun x : V' =>
      (hbij x (L x) (hLO x)).2 (M.presheaf.map (homOfLE (hLV x)).op s)
    have hcompat : TopCat.Presheaf.IsCompatible Y.sheaf.1 L c := by
      intro x y
      apply (hbij x (L x ⊓ L y) (inf_le_left.trans (hLO x))).1
      simp only
      have hx := congrArg (M.presheaf.map (homOfLE (inf_le_left : L x ⊓ L y ≤ L x)).op) (hc x)
      have hy := congrArg (M.presheaf.map (homOfLE (inf_le_right : L x ⊓ L y ≤ L y)).op) (hc y)
      simp only at hx hy
      rw [hres _ _ _ ((hLO x).trans (hVx x)), modules_map_map] at hx
      rw [hres _ _ _ ((hLO y).trans (hVx y)), modules_map_map] at hy
      exact (hx.trans hy.symm).trans rfl
    obtain ⟨r, hr, -⟩ := TopCat.Sheaf.existsUnique_gluing' Y.sheaf L V'
      (fun x => homOfLE (hLV x)) hcov c hcompat
    let r' : Γ(Y, V') := r
    refine ⟨r', ?_⟩
    refine TopCat.Sheaf.eq_of_locally_eq' ((SheafOfModules.toSheaf _).obj M) L V'
      (fun x => homOfLE (hLV x)) hcov _ _ (fun x => ?_)
    change M.presheaf.map (homOfLE (hLV x)).op (r' • M.presheaf.map (homOfLE hV').op m) =
      M.presheaf.map (homOfLE (hLV x)).op s
    rw [hres _ _ _ hV', ← hc x]
    congr 1
    exact hr x

/-- **The normalization is birational over affine opens.** Every section of `𝒪_{X^ν}` over
`ν⁻¹U`, `U` affine, is a fraction of sections of `𝒪_X` over `U` with a non-zero-divisor
denominator. -/
private theorem exists_mul_eq_app_of_isAffineOpen {X : Scheme.{u}} [IsReduced X]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    {U : X.Opens} (hU : IsAffineOpen U)
    (c : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)) :
    ∃ r : Γ(X, U), (normalization X hX).app U r ∈
        nonZeroDivisors Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) ∧
      ∃ r' : Γ(X, U), (normalization X hX).app U r * c = (normalization X hX).app U r' := by
  let _ : Algebra Γ(X, U) Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) :=
    ((normalization X hX).app U).hom.toAlgebra
  obtain ⟨e⟩ : Nonempty (Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) ≃ₐ[Γ(X, U)]
      integralClosure Γ(X, U) (FractionRing Γ(X, U))) :=
    ⟨AlgebraicGeometry.normalizationSectionsAlgEquivIntegralClosureFractionRing hX U hU⟩
  obtain ⟨⟨r', r⟩, hrr⟩ := IsLocalization.surj (nonZeroDivisors Γ(X, U))
    (e c : FractionRing Γ(X, U))
  simp only at hrr
  have hal : ∀ a : Γ(X, U), (normalization X hX).app U a =
      algebraMap Γ(X, U) Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U) a := fun _ => rfl
  have hunit : IsUnit (algebraMap Γ(X, U) (FractionRing Γ(X, U)) r) :=
    IsLocalization.map_units _ r
  have hco : ∀ a : Γ(X, U), ((e (algebraMap Γ(X, U) _ a) : integralClosure _ _) :
      FractionRing Γ(X, U)) = algebraMap Γ(X, U) (FractionRing Γ(X, U)) a := by
    intro a
    rw [AlgEquiv.commutes]
    rfl
  refine ⟨r, ?_, r', ?_⟩
  · rw [hal, mem_nonZeroDivisors_iff_right]
    intro z hz
    apply e.injective
    apply Subtype.ext
    have := congrArg (fun w => ((e w : integralClosure _ _) : FractionRing Γ(X, U))) hz
    simp only [map_mul, Subalgebra.coe_mul, map_zero, Subalgebra.coe_zero, hco] at this
    rw [map_zero, Subalgebra.coe_zero]
    exact (hunit.mul_left_eq_zero).1 this
  · rw [hal, hal]
    apply e.injective
    apply Subtype.ext
    simp only [map_mul, Subalgebra.coe_mul, hco]
    rw [mul_comm, hrr]

/-- The comorphism of the normalization is injective on sections. -/
private theorem app_injective_normalization {X : Scheme.{u}} [IsReduced X]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (U : X.Opens) : Function.Injective ((normalization X hX).app U) := by
  have := Stacks.AlgebraicGeometry.Normalization.mono_toRingCatSheafHom_normalization X hX
  have := ((TopCat.Sheaf.forget RingCat.{u} X).map_mono
    (Scheme.Hom.toRingCatSheafHom (normalization X hX)))
  have := (NatTrans.mono_iff_mono_app _).1 this (op U)
  exact ((ConcreteCategory.mono_iff_injective_of_preservesPullback _).1 this :)

/-- A morphism out of a pushforward is linear over the comorphism: `Scheme.Modules.Hom.app_smul`
with the action on `Γ(f_*M, U) = Γ(M, f⁻¹U)` spelled through `f.app U`, the form that appears in
goals about sections of `M` (where `app_smul` itself does not rewrite). -/
private theorem pushforward_hom_app_smul {X Y : Scheme.{u}} (f : Y ⟶ X) {M : Y.Modules}
    {N : X.Modules} (φ : (Scheme.Modules.pushforward f).obj M ⟶ N) (U : X.Opens) (r : Γ(X, U))
    (x : Γ(M, f ⁻¹ᵁ U)) : φ.app U (f.app U r • x) = r • φ.app U x :=
  Scheme.Modules.Hom.app_smul φ r x

/-- **The trace on a generator is multiplication by `θ`.** If `τ(g) = θ · s` on an affine `U`,
then `τ(c · g) = a · s` with `ν^♯ a = ν^♯θ · c`, for every section `c` of `𝒪_{X^ν}` over
`ν⁻¹U`. -/
private theorem exists_trace_smul_eq_mul {X : Scheme.{u}} [IsReduced X] (ωX : X.Modules)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    {U : X.Opens} (hU : IsAffineOpen U) (sU : Γ(ωX, U)) (hsU : IsLocalGenerator ωX sU)
    (g : Γ(ων, normalization X hX ⁻¹ᵁ U)) (θ : Γ(X, U)) (hθ : τ.app U g = θ • sU)
    (c : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)) :
    ∃ a : Γ(X, U), (normalization X hX).app U a = (normalization X hX).app U θ * c ∧
      τ.app U (c • g) = a • sU := by
  have hbij := hsU U le_rfl
  simp only [modules_map_id] at hbij
  obtain ⟨a, ha⟩ := hbij.2 (τ.app U (c • g))
  replace ha : a • sU = τ.app U (c • g) := ha
  refine ⟨a, ?_, ha.symm⟩
  obtain ⟨r, hr, r', hrr'⟩ := exists_mul_eq_app_of_isAffineOpen hX hU c
  have h1 : (r * a) • sU = (r' * θ) • sU := by
    rw [mul_smul, ha, ← pushforward_hom_app_smul, smul_smul, hrr', pushforward_hom_app_smul, hθ,
      mul_smul]
  have h2 := congrArg (fun z => (normalization X hX).app U z) (hbij.1 h1)
  simp only at h2
  rw [map_mul, map_mul, ← hrr'] at h2
  exact (mul_cancel_left_mem_nonZeroDivisors hr).1 (h2.trans (by ring))

/-- Restriction commutes with the comorphism of a morphism of schemes. -/
private theorem app_res {X Y : Scheme.{u}} (f : Y ⟶ X) {U V : X.Opens} (h : V ≤ U)
    (a : Γ(X, U)) :
    Y.presheaf.map (homOfLE (f.preimage_mono h)).op (f.app U a) =
      f.app V (X.presheaf.map (homOfLE h).op a) :=
  (congrArg (fun φ => φ.hom a) (f.naturality (homOfLE h).op)).symm

/-- A morphism out of a pushforward commutes with restriction: `modulesHom_app_map` with the
restriction of `f_*M` spelled as the restriction of `M` along `f⁻¹V ≤ f⁻¹U`, the form that
appears in goals about sections of `M`. -/
private theorem pushforward_hom_app_res {X Y : Scheme.{u}} (f : Y ⟶ X) {M : Y.Modules}
    {N : X.Modules} (φ : (Scheme.Modules.pushforward f).obj M ⟶ N) {U V : X.Opens} (h : V ≤ U)
    (x : Γ(M, f ⁻¹ᵁ U)) :
    φ.app V (M.presheaf.map (homOfLE (f.preimage_mono h)).op x) =
      N.presheaf.map (homOfLE h).op (φ.app U x) :=
  modulesHom_app_map φ h x

/-- **The trace kills `c · (θ t - g)` on a basic open inside `U ∩ W'`.** -/
private theorem trace_smul_res_eq {X : Scheme.{u}} [IsReduced X] (ωX : X.Modules)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    {W : X.Opens} (s : Γ(ωX, W)) {W' : X.Opens} (hW' : W' ≤ W)
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W')) (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s)
    {U : X.Opens} (hUW : U ≤ W) (hU : IsAffineOpen U)
    (hsU : IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hUW).op s))
    (g : Γ(ων, normalization X hX ⁻¹ᵁ U)) (θ : Γ(X, U))
    (hθ : τ.app U g = θ • ωX.presheaf.map (homOfLE hUW).op s)
    {B : X.Opens} (hBU : B ≤ U) (hBW : B ≤ W')
    (c : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)) :
    τ.app B ((normalizationScheme X hX).presheaf.map
        (homOfLE ((normalization X hX).preimage_mono hBU)).op ((normalization X hX).app U θ * c) •
        ων.presheaf.map (homOfLE ((normalization X hX).preimage_mono hBW)).op t) =
      τ.app B (ων.presheaf.map (homOfLE ((normalization X hX).preimage_mono hBU)).op (c • g)) := by
  obtain ⟨a, ha, hag⟩ := exists_trace_smul_eq_mul ωX hX ων τ hU _ hsU g θ hθ c
  rw [← ha, app_res, pushforward_hom_app_smul, pushforward_hom_app_res, ht,
    pushforward_hom_app_res, hag, Scheme.Modules.map_smul, modules_map_map,
    modules_map_map]
  all_goals assumption

/-- **The pulled-back section is `g/θ` near the generic points.** -/
private theorem exists_smul_eq_generator {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) (n : ℕ) [IsReduced X]
    (ωX : X.Modules) (hωX : IsDualizingSheaf sX n ωX)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hT : ∀ V : X.Opens, IsAffineOpen V →
      ∀ l : Γ((Scheme.Modules.pushforward (normalization X hX)).obj
          (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf), V)
          →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! w : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ b : Γ(normalizationScheme X hX,
          normalization X hX ⁻¹ᵁ V), τ.app V (b • w) = l b)
    (P : X) {W : X.Opens} (s : Γ(ωX, W))
    {W' : X.Opens} (hW' : W' ≤ W)
    (hW'gen : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ⤳ P → η ∈ W')
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W')) (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s)
    {U : X.Opens} (hPU : P ∈ U) (hUW : U ≤ W) (hU : IsAffineOpen U)
    (hsU : IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hUW).op s))
    (g : Γ(ων, normalization X hX ⁻¹ᵁ U)) (θ : Γ(X, U))
    (hθ : τ.app U g = θ • ωX.presheaf.map (homOfLE hUW).op s)
    (y : (normalizationScheme X hX)) (hy : (normalization X hX) y = P) :
    ∃ (V' : (normalizationScheme X hX).Opens) (hV' : V' ≤ normalization X hX ⁻¹ᵁ U)
      (hW : V' ≤ normalization X hX ⁻¹ᵁ W'),
      (∀ η : normalizationScheme X hX,
        closure {η} ∈ irreducibleComponents (normalizationScheme X hX) → η ⤳ y → η ∈ V') ∧
      (normalizationScheme X hX).presheaf.map (homOfLE hV').op ((normalization X hX).app U θ) •
          ων.presheaf.map (homOfLE hW).op t =
        ων.presheaf.map (homOfLE hV').op g := by
  classical
  obtain ⟨-, hLX⟩ := isNoetherian_and_locallyOfFiniteType_of_isDualizingSheaf hωX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field k sX) hX
  have hUν : IsAffineOpen (normalization X hX ⁻¹ᵁ U) := hU.preimage (normalization X hX)
  refine ⟨normalization X hX ⁻¹ᵁ (U ⊓ W'), (normalization X hX).preimage_mono inf_le_left,
      (normalization X hX).preimage_mono inf_le_right,
    ?_, ?_⟩
  · intro η hη hηy
    have h1 : (normalization X hX) η ⤳ P := hy ▸ hηy.map (normalization X hX).continuous
    exact ⟨h1.mem_open U.isOpen hPU,
      hW'gen _ (AlgebraicGeometry.Scheme.normalization_mem_genericPoints X hX hη) h1⟩
  -- the identity on each basic open `B ⊆ U ∩ W'`
  have key : ∀ (h : Γ(X, U)) (hBD : X.basicOpen h ≤ U ⊓ W'),
      (normalizationScheme X hX).presheaf.map
          (homOfLE ((normalization X hX).preimage_mono (hBD.trans inf_le_left))).op
          ((normalization X hX).app U θ) •
        ων.presheaf.map
          (homOfLE ((normalization X hX).preimage_mono (hBD.trans inf_le_right))).op t =
      ων.presheaf.map
        (homOfLE ((normalization X hX).preimage_mono (hBD.trans inf_le_left))).op g := by
    intro h hBD
    set B := X.basicOpen h
    have hBU : B ≤ U := hBD.trans inf_le_left
    have hBW : B ≤ W' := hBD.trans inf_le_right
    set L := (normalizationScheme X hX).presheaf.map (homOfLE ((normalization X hX).preimage_mono
        hBU)).op ((normalization X hX).app U θ) •
        ων.presheaf.map (homOfLE ((normalization X hX).preimage_mono hBW)).op t
    set R := ων.presheaf.map (homOfLE ((normalization X hX).preimage_mono hBU)).op g
    have hτLR : ∀ b' : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ B), τ.app B (b' • L) =
        τ.app B (b' • R) := by
      intro b'
      have hpre : normalization X hX ⁻¹ᵁ B =
          (normalizationScheme X hX).basicOpen ((normalization X hX).app U h) :=
        Scheme.preimage_basicOpen _ h
      obtain ⟨m, y, hy'⟩ := exists_eq_pow_mul_of_isAffineOpen (normalizationScheme X hX)
        (normalization X hX ⁻¹ᵁ U) hUν ((normalization X hX).app U h)
        ((normalizationScheme X hX).presheaf.map (homOfLE hpre.ge).op b')
      have hy'' := congrArg ((normalizationScheme X hX).presheaf.map (homOfLE hpre.le).op) hy'
      simp only [TopCat.Presheaf.restrictOpen, TopCat.Presheaf.restrict, map_mul, map_pow,
        presheaf_map_map, presheaf_map_id] at hy''
      rw [app_res (normalization X hX) hBU] at hy''
      have hu : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le h)).op h ^ m) :=
        (X.toRingedSpace.isUnit_res_basicOpen h).pow m
      rw [← hu.smul_left_cancel, ← pushforward_hom_app_smul, ← pushforward_hom_app_smul,
        smul_smul, smul_smul, map_pow, ← hy'']
      simp only [R, smul_smul, ← map_mul]
      rw [← hy'', ← Scheme.Modules.map_smul, mul_comm]
      exact trace_smul_res_eq ωX hX ων τ s hW' t ht hUW hU hsU g θ hθ hBU hBW y
    refine sub_eq_zero.1 ((hT B (hU.basicOpen h) 0).unique (fun b => ?_) (fun b => ?_))
    · rw [smul_sub]
      erw [map_sub, hτLR, sub_self]
      rfl
    · erw [smul_zero, map_zero]
      rfl
  choose hf hfle hfmem using
    fun z : (normalization X hX ⁻¹ᵁ (U ⊓ W') : Set (normalizationScheme X hX)) =>
      hU.exists_basicOpen_le (V := U ⊓ W') ⟨(normalization X hX) z.1, z.2⟩ z.2.1
  refine TopCat.Sheaf.eq_of_locally_eq' ((SheafOfModules.toSheaf _).obj ων)
    (fun z => normalization X hX ⁻¹ᵁ X.basicOpen (hf z)) _
    (fun z => homOfLE ((normalization X hX).preimage_mono (hfle z)))
    (fun z hz => Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hfmem ⟨z, hz⟩⟩) _ _ fun z => ?_
  have := key (hf z) (hfle z)
  change ων.presheaf.map _ (_ • _) = ων.presheaf.map _ _
  rwa [Scheme.Modules.map_smul, modules_map_map, modules_map_map, presheaf_map_map]

/-- **The conductor is generated by `θ`.** By finite duality on the affine `U`, a section `x`
of `𝒪_{X^ν}` over `ν⁻¹U` with `x · Γ(ν⁻¹U, 𝒪_{X^ν}) ⊆ Γ(U, 𝒪_X)` is a multiple of `ν^♯θ`. -/
private theorem exists_eq_mul_of_forall_exists_app_eq {X : Scheme.{u}} [IsReduced X]
    (ωX : X.Modules)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hT : ∀ V : X.Opens, IsAffineOpen V →
      ∀ l : Γ((Scheme.Modules.pushforward (normalization X hX)).obj
          (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf), V)
          →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! w : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ b : Γ(normalizationScheme X hX,
          normalization X hX ⁻¹ᵁ V), τ.app V (b • w) = l b)
    {U : X.Opens} (hU : IsAffineOpen U)
    (sU : Γ(ωX, U)) (hsU : IsLocalGenerator ωX sU)
    (g : Γ(ων, normalization X hX ⁻¹ᵁ U)) (hg : IsLocalGenerator ων g) (θ : Γ(X, U))
    (hθ : τ.app U g = θ • sU) (x : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U))
    (hx : ∀ c : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U), ∃ a : Γ(X, U),
        (normalization X hX).app U a = x * c) :
    ∃ β : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U),
      x = (normalization X hX).app U θ * β := by
  have hinj := app_injective_normalization hX U
  have hbij := hsU U le_rfl
  simp only [modules_map_id] at hbij
  choose f hf using hx
  have hadd : ∀ c d : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U),
      f (c + d) = f c + f d := by
    intro c d
    apply hinj
    rw [map_add, hf, hf, hf, mul_add]
  have hsmul : ∀ (r : Γ(X, U)) (c : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)),
      f ((normalization X hX).app U r * c) = r * f c := by
    intro r c
    apply hinj
    rw [map_mul, hf, hf]
    ring
  let l : Γ((Scheme.Modules.pushforward (normalization X hX)).obj
      (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf), U) →ₗ[Γ(X, U)] Γ(ωX, U) :=
    { toFun := fun c => f c • sU
      map_add' := fun c d => by
        rw [← add_smul]
        exact congrArg (· • sU) (hadd c d)
      map_smul' := fun r c => by
        rw [RingHom.id_apply, smul_smul]
        exact congrArg (· • sU) (hsmul r c) }
  obtain ⟨w, hw, -⟩ := hT U hU l
  obtain ⟨β, hβ⟩ := (hg _ le_rfl).2 w
  simp only [modules_map_id] at hβ
  replace hβ : β • g = w := hβ
  have h1 := hw 1
  rw [one_smul, ← hβ] at h1
  obtain ⟨a, ha, hag⟩ := exists_trace_smul_eq_mul ωX hX ων τ hU sU hsU g θ hθ β
  rw [hag] at h1
  have h2 : a = f 1 := hbij.1 h1
  refine ⟨β, ?_⟩
  rw [← ha, h2, hf, mul_one]

/-- **A unit multiple of a local generator is a local generator** on the locus where the
multiplier is a unit. -/
private theorem isLocalGenerator_smul_of_basicOpen {Y : Scheme.{u}} {M : Y.Modules}
    {W : Y.Opens} {g : Γ(M, W)} (hg : IsLocalGenerator M g) (c : Γ(Y, W)) :
    IsLocalGenerator M (M.presheaf.map (homOfLE (Y.basicOpen_le c)).op (c • g)) := by
  intro V' hV'
  have hle : V' ≤ W := hV'.trans (Y.basicOpen_le c)
  have hu : IsUnit (Y.presheaf.map (homOfLE hle).op c) := by
    have h1 := (Y.toRingedSpace.isUnit_res_basicOpen c).map (Y.presheaf.map (homOfLE hV').op).hom
    have h2 : Y.presheaf.map (homOfLE hV').op (Y.presheaf.map (homOfLE (Y.basicOpen_le c)).op c) =
        Y.presheaf.map (homOfLE hle).op c := presheaf_map_map _ _ c
    exact h2 ▸ h1
  have hfun : ∀ r : Γ(Y, V'), r • M.presheaf.map (homOfLE hV').op
      (M.presheaf.map (homOfLE (Y.basicOpen_le c)).op (c • g)) =
        (r * Y.presheaf.map (homOfLE hle).op c) • M.presheaf.map (homOfLE hle).op g := by
    intro r
    rw [modules_map_map, Scheme.Modules.map_smul, mul_smul]
  have hb := hg V' hle
  refine ⟨fun a b hab => ?_, fun m => ?_⟩
  · have h' := (hfun a).symm.trans (hab.trans (hfun b))
    exact hu.mul_left_injective (hb.1 h')
  · obtain ⟨r, hr⟩ := hb.2 m
    refine ⟨r * ↑hu.unit⁻¹, ?_⟩
    refine (hfun _).trans ?_
    rw [mul_assoc, show (↑hu.unit⁻¹ : Γ(Y, V')) * Y.presheaf.map (homOfLE hle).op c = 1 from
      hu.val_inv_mul, mul_one]
    exact hr

/-- **Generating near a point from a unit coefficient.** If `g` generates `M` on `D(h) ⊆ V` and
`m|_{D(h)} = c · g` with `c` a unit at `y ∈ D(h)`, then `m` generates `M` near `y`. -/
private theorem exists_le_isLocalGenerator_of_eq_smul {Y : Scheme.{u}} {M : Y.Modules}
    {V : Y.Opens} (m : Γ(M, V)) (h : Γ(Y, V)) {g : Γ(M, Y.basicOpen h)}
    (hg : IsLocalGenerator M g) (c : Γ(Y, Y.basicOpen h))
    (hm : M.presheaf.map (homOfLE (Y.basicOpen_le h)).op m = c • g) (y : Y)
    (hy : y ∈ Y.basicOpen h) (hc : IsUnit (Y.presheaf.germ _ y hy c)) :
    ∃ (W : Y.Opens) (hW : W ≤ V), y ∈ W ∧
      IsLocalGenerator M (M.presheaf.map (homOfLE hW).op m) := by
  refine ⟨Y.basicOpen c, (Y.basicOpen_le c).trans (Y.basicOpen_le h),
    (Y.mem_basicOpen c y hy).2 hc, ?_⟩
  have := isLocalGenerator_smul_of_basicOpen hg c
  rwa [← hm, modules_map_map] at this

/-- A section of a quasi-coherent module over a standard open `D(r)` of an affine open `W`
becomes, after multiplication by a power of `r`, the restriction of a section over `W`. -/
private theorem exists_map_eq_pow_smul_of_isAffineOpen {Y : Scheme.{u}} (M : Y.Modules)
    [M.IsQuasicoherent] {W : Y.Opens} (hW : IsAffineOpen W) (r : Γ(Y, W))
    (u : Γ(M, Y.basicOpen r)) :
    ∃ (x : Γ(M, W)) (k : ℕ), M.presheaf.map (homOfLE (Y.basicOpen_le r)).op x =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le r)).op r) ^ k • u := by
  let := Stacks.AlgebraicGeometry.QuasicoherentBaseChange.moduleOfLE M (Y.basicOpen_le r)
  have := Stacks.AlgebraicGeometry.QuasicoherentBaseChange.isLocalizedModule_restrictₗ
    M hW r rfl (Y.basicOpen_le r)
  obtain ⟨⟨x, ⟨_, k, rfl⟩⟩, hx⟩ := IsLocalizedModule.surj (Submonoid.powers r)
    (Stacks.AlgebraicGeometry.QuasicoherentBaseChange.restrictₗ M (Y.basicOpen_le r)) u
  refine ⟨x, k, ?_⟩
  rw [← map_pow]
  exact hx.symm

end Trace

section Pole

/-- The local ring of the normalization at a point of codimension one is a discrete valuation
ring. -/
private theorem isDVR_stalk_normalization {X : Scheme.{u}}
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    [IsLocallyNoetherian (normalizationScheme X hX)] (y : normalizationScheme X hX)
    (hy : Order.coheight y = 1) :
    ∃ _ : IsDomain ((normalizationScheme X hX).presheaf.stalk y),
      IsDiscreteValuationRing ((normalizationScheme X hX).presheaf.stalk y) := by
  have hN : IsNormal (normalizationScheme X hX) := Scheme.isNormal_normalizationScheme X hX
  have hd : IsDomain ((normalizationScheme X hX).presheaf.stalk y) := hN.stalk_isDomain y
  refine ⟨hd, ?_⟩
  have hdim : ringKrullDim ((normalizationScheme X hX).presheaf.stalk y) = 1 := by
    rw [ringKrullDim_stalk_eq_coheight, hy]; rfl
  have hnf : ¬ IsField ((normalizationScheme X hX).presheaf.stalk y) := by
    intro h
    have h0 := ringKrullDim_eq_zero_of_isField h
    rw [hdim] at h0
    exact absurd h0 (by decide)
  have : IsIntegrallyClosed ((normalizationScheme X hX).presheaf.stalk y) := hN.stalk_normal y
  have : Ring.KrullDimLE 1 ((normalizationScheme X hX).presheaf.stalk y) :=
    Ring.krullDimLE_iff.mpr (by rw [hdim]; rfl)
  have key := (IsDiscreteValuationRing.TFAE ((normalizationScheme X hX).presheaf.stalk y) hnf).out
      4 1
  refine key.mp ⟨inferInstance, maximalIdeal _,
      ⟨isField_iff_maximalIdeal_eq.not.mp hnf, inferInstance⟩, ?_⟩
  exact fun P hP => IsLocalRing.eq_maximalIdeal (Ideal.IsPrime.isMaximal_of_ne_bot hP.2 hP.1)

/-- **`θ` vanishes to order one at each point over `P`.** The conductor of the seminormal
`𝒪_{X,P}` is generated by `θ`, and is the maximal ideal at every point over `P`. -/
private theorem germ_app_mem_nonZeroDivisors_and_ord_eq_one {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [IsReduced X]
    (ωX : X.Modules)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hT : ∀ V : X.Opens, IsAffineOpen V →
      ∀ l : Γ((Scheme.Modules.pushforward (normalization X hX)).obj
          (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf), V)
          →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! w : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ b : Γ(normalizationScheme X hX,
          normalization X hX ⁻¹ᵁ V), τ.app V (b • w) = l b)
    (y : normalizationScheme X hX) (hy1 : Order.coheight y = 1)
    (hPsing : ¬ IsRegularLocalRing (X.presheaf.stalk (normalization X hX y)))
    (hSN : @IsSeminormalHom (X.presheaf.stalk (normalization X hX y))
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX
          (normalization X hX y)) _ _
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX
          (normalization X hX y)))
    {U : X.Opens} (hU : IsAffineOpen U) (hyU : y ∈ normalization X hX ⁻¹ᵁ U)
    (sU : Γ(ωX, U)) (hsU : IsLocalGenerator ωX sU)
    (g : Γ(ων, normalization X hX ⁻¹ᵁ U)) (hg : IsLocalGenerator ων g) (θ : Γ(X, U))
    (hθ : τ.app U g = θ • sU) :
    (normalizationScheme X hX).presheaf.germ (normalization X hX ⁻¹ᵁ U) y hyU
        ((normalization X hX).app U θ) ∈
        nonZeroDivisors ((normalizationScheme X hX).presheaf.stalk y) ∧
      Ring.ord ((normalizationScheme X hX).presheaf.stalk y)
        ((normalizationScheme X hX).presheaf.germ (normalization X hX ⁻¹ᵁ U) y hyU
          ((normalization X hX).app U θ)) = ((1 : ℕ) : ℕ∞) := by
  classical
  have : IsFinite (normalization X hX) := Scheme.isFinite_normalization
    (isNagataScheme_of_locallyOfFiniteType_over_field k sX) hX
  have : IsLocallyNoetherian (normalizationScheme X hX) :=
    LocallyOfFiniteType.isLocallyNoetherian (normalization X hX ≫ sX)
  have hUν : IsAffineOpen (normalization X hX ⁻¹ᵁ U) := hU.preimage (normalization X hX)
  have hPU : normalization X hX y ∈ U := hyU
  let A := Γ(X, U)
  let B := Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ U)
  let _ : Algebra A B := ((normalization X hX).app U).hom.toAlgebra
  have : Module.Finite A B := IsFinite.finite_app (normalization X hX) U hU
  set p := (hU.primeIdealOf ⟨_, hPU⟩).asIdeal
  set q := (hUν.primeIdealOf ⟨y, hyU⟩).asIdeal
  have hqp : q.comap (algebraMap A B) = p := by
    have := congrArg PrimeSpectrum.asIdeal
      (IsAffineOpen.comap_primeIdealOf_appLE U hU (normalization X hX ⁻¹ᵁ U) hUν le_rfl hyU)
    rwa [Scheme.Hom.appLE_eq_app, PrimeSpectrum.comap_asIdeal] at this
  -- the conductor is `θ B`
  have hθ₁ : ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B θ * c := fun c =>
    (exists_trace_smul_eq_mul ωX hX ων τ hU sU hsU g θ hθ c).imp fun _ h => h.1
  have hθ₂ := exists_eq_mul_of_forall_exists_app_eq ωX hX ων τ hT hU sU hsU g hg θ hθ
  have hbir : ∃ r : A, algebraMap A B r ∈ nonZeroDivisors B ∧
      ∀ c : B, ∃ a : A, algebraMap A B a = algebraMap A B r * c := by
    obtain ⟨r, hr, h⟩ := exists_mem_forall_exists_algebraMap_eq
      ((nonZeroDivisors B).comap (algebraMap A B)) (1 : B) fun c => by
        obtain ⟨r, hr, r', hr'⟩ := exists_mul_eq_app_of_isAffineOpen hX hU c
        exact ⟨r, hr, r', by rw [one_mul]; exact hr'.symm⟩
    exact ⟨r, hr, by simpa only [mul_one] using h⟩
  have hSNc : SeminormalAt B p := (isSeminormalHom_stalk_iff_seminormalAt hX hU hPU).mp hSN
  -- the stalk at `y`
  let _ : Algebra B ((normalizationScheme X hX).presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk (normalizationScheme X hX).presheaf ⟨y, hyU⟩
  have : IsLocalization.AtPrime ((normalizationScheme X hX).presheaf.stalk y) q :=
    hUν.isLocalization_stalk ⟨y, hyU⟩
  obtain ⟨hdom, hdvr⟩ := isDVR_stalk_normalization hX y hy1
  -- `θ ∈ p`, as `𝒪_{X,P}` is not normal
  have hθp : θ ∈ p := by
    by_contra hθp
    let _ : Algebra A (X.presheaf.stalk (normalization X hX y)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨_, hPU⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk (normalization X hX y)) p :=
      hU.isLocalization_stalk ⟨_, hPU⟩
    have hbij := bijective_of_notMem_conductor (RA := X.presheaf.stalk (normalization X hX y))
      (RB := (normalizationScheme X hX).presheaf.stalk y) q hqp
      (app_injective_normalization hX U) θ hθp hθ₁ ((normalization X hX).stalkMap y).hom
      (fun a => Scheme.Hom.germ_stalkMap_apply (normalization X hX) U y hyU a)
    exact hPsing (IsRegularLocalRing.of_ringEquiv (RingEquiv.ofBijective _ hbij).symm)
  have hθq : algebraMap A B θ ∈ q := by rwa [← Ideal.mem_comap, hqp]
  have hirr := irreducible_algebraMap_of_seminormalAt hSNc θ hθ₁ hθ₂ hbir q hqp hθq
    ((normalizationScheme X hX).presheaf.stalk y)
  have heq : algebraMap B ((normalizationScheme X hX).presheaf.stalk y) (algebraMap A B θ) =
      (normalizationScheme X hX).presheaf.germ (normalization X hX ⁻¹ᵁ U) y hyU
        ((normalization X hX).app U θ) := rfl
  rw [heq] at hirr
  refine ⟨mem_nonZeroDivisors_of_ne_zero hirr.ne_zero, ?_⟩
  rw [Ring.ord_of_irreducible hirr]
  rfl

/-- **`ω_{X^ν}` is free on the full preimage of a small affine neighbourhood of `P`.** The fibre
`ν⁻¹(P)` is finite and `ω_{X^ν}` is invertible at each of its points; local generators at the
points are combined on an affine chart by separating elements. -/
private theorem exists_affineOpen_isLocalGenerator_preimage {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [IsReduced X] (n : ℕ)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (hων : IsDualizingSheaf (normalization X hX ≫ sX) n ων) (P : X)
    (hfib : ∀ y, normalization X hX y = P → Order.coheight y = 1)
    (U₀ : X.Opens) (hPU₀ : P ∈ U₀) :
    ∃ U : X.Opens, U ≤ U₀ ∧ P ∈ U ∧ IsAffineOpen U ∧
      ∃ g : Γ(ων, normalization X hX ⁻¹ᵁ U), IsLocalGenerator ων g := by
  classical
  have : IsFinite (normalization X hX) := Scheme.isFinite_normalization
    (isNagataScheme_of_locallyOfFiniteType_over_field k sX) hX
  obtain ⟨hNν, -⟩ := isNoetherian_and_locallyOfFiniteType_of_isDualizingSheaf hων
  have : IsLocallyNoetherian (normalizationScheme X hX) := hNν.toIsLocallyNoetherian
  have : IsReduced (normalizationScheme X hX) :=
    AlgebraicGeometry.Scheme.isReduced_normalizationScheme X hX
  have : ων.IsQuasicoherent :=
    @isQuasicoherent_of_isCoherent _ _ _ ων
      (AlgebraicGeometry.CoherentAbelian.isCoherent_of_stacksIsCoherent
        (IsDualizingSheaf.isCoherent_exists_injective hων).1)
  -- the finitely many points over `P`
  have hfin : ((normalization X hX).base ⁻¹' {P}).Finite :=
    (normalization X hX).finite_preimage_singleton P
  set S := hfin.toFinset
  have hS : ∀ y, y ∈ S ↔ normalization X hX y = P := fun _ =>
    hfin.mem_toFinset.trans Set.mem_singleton_iff
  -- an affine chart
  obtain ⟨_, ⟨U₁, hU₁, rfl⟩, hPU₁, hU₁U₀⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hPU₀ U₀.isOpen
  replace hU₁U₀ : U₁ ≤ U₀ := hU₁U₀
  have hUν : IsAffineOpen (normalization X hX ⁻¹ᵁ U₁) := hU₁.preimage (normalization X hX)
  set V := normalization X hX ⁻¹ᵁ U₁
  have hyV : ∀ y : normalizationScheme X hX, normalization X hX y = P → y ∈ V := fun y hy => by
    change normalization X hX y ∈ U₁
    rwa [hy]
  let A := Γ(X, U₁)
  let B := Γ(normalizationScheme X hX, V)
  let _ : Algebra A B := ((normalization X hX).app U₁).hom.toAlgebra
  have : Module.Finite A B := IsFinite.finite_app (normalization X hX) U₁ hU₁
  let q : normalizationScheme X hX → Ideal B := fun z =>
    if hz : z ∈ V then (hUν.primeIdealOf ⟨z, hz⟩).asIdeal else ⊤
  have hq : ∀ z (hz : z ∈ V), q z = (hUν.primeIdealOf ⟨z, hz⟩).asIdeal :=
    fun _ hz => dite_eq_left hz
  have hqprime : ∀ z ∈ V, (q z).IsPrime := fun z hz => by rw [hq z hz]; infer_instance
  have hqp : ∀ (y : normalizationScheme X hX) (hy : normalization X hX y = P),
      (q y).comap (algebraMap A B) = (hU₁.primeIdealOf ⟨P, hPU₁⟩).asIdeal := by
    intro y hy
    rw [hq y (hyV y hy)]
    have := congrArg PrimeSpectrum.asIdeal
      (IsAffineOpen.comap_primeIdealOf_appLE U₁ hU₁ V hUν le_rfl (hyV y hy))
    rw [Scheme.Hom.appLE_eq_app, PrimeSpectrum.comap_asIdeal] at this
    refine this.trans ?_
    congr 2
    exact Subtype.ext hy
  -- the stalks over `P` are regular
  have hreg : ∀ y : normalizationScheme X hX, normalization X hX y = P →
      IsRegularLocalRing ((normalizationScheme X hX).presheaf.stalk y) := by
    intro y hy
    obtain ⟨hdom, hdvr⟩ := isDVR_stalk_normalization hX y (hfib y hy)
    infer_instance
  -- a generator on a standard open around each point, and its extension to `V`
  have hdata : ∀ y : normalizationScheme X hX, normalization X hX y = P →
      ∃ (h : B) (hy : y ∈ (normalizationScheme X hX).basicOpen h)
      (g' : Γ(ων, (normalizationScheme X hX).basicOpen h)) (_ : IsLocalGenerator ων g')
      (m' : Γ(ων, V)) (k : ℕ),
      ων.presheaf.map (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op m' =
        ((normalizationScheme X hX).presheaf.map
          (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op h) ^ k • g' := by
    intro y hy
    obtain ⟨W, hyW, ⟨e⟩⟩ := hων.exists_restrict_iso_free_of_isRegularLocalRing y (hreg y hy)
    obtain ⟨g, hg⟩ := exists_isLocalGenerator_of_restrict_iso_free ων W e
    obtain ⟨h, hhW, hyh⟩ := hUν.exists_basicOpen_le (V := W) ⟨y, hyW⟩ (hyV y hy)
    have hg' := hg.restrict hhW
    obtain ⟨m', k, hm'⟩ := exists_map_eq_pow_smul_of_isAffineOpen ων hUν h
      (ων.presheaf.map (homOfLE hhW).op g)
    exact ⟨h, hyh, _, hg', m', k, hm'⟩
  -- the local step: `a · m_y + ∑ bᵢ · mᵢ` generates near `y` when `a ∉ q_y ∋ bᵢ`
  have hloc : ∀ (y : normalizationScheme X hX) (hy : normalization X hX y = P) (h : B)
      (hyh : y ∈ (normalizationScheme X hX).basicOpen h)
      (g' : Γ(ων, (normalizationScheme X hX).basicOpen h)) (_ : IsLocalGenerator ων g')
      (my : Γ(ων, V)) (k : ℕ)
      (_ : ων.presheaf.map (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op my =
        ((normalizationScheme X hX).presheaf.map
          (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op h) ^ k • g')
      (a : B) (T : Finset (normalizationScheme X hX)) (b : normalizationScheme X hX → B)
      (mo : normalizationScheme X hX → Γ(ων, V)) (_ : a ∉ q y) (_ : ∀ z ∈ T, b z ∈ q y),
      ∃ (W : (normalizationScheme X hX).Opens) (hW : W ≤ V), y ∈ W ∧
        IsLocalGenerator ων (ων.presheaf.map (homOfLE hW).op (a • my + ∑ z ∈ T, b z • mo z)) := by
    intro y hy h hyh g' hg' my k hmy a T b mo ha hb
    set res := (normalizationScheme X hX).presheaf.map
      (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op
    choose d hd using fun z => (hg' _ le_rfl).2
      (ων.presheaf.map (homOfLE ((normalizationScheme X hX).basicOpen_le h)).op (mo z))
    simp only [modules_map_id] at hd
    refine exists_le_isLocalGenerator_of_eq_smul (a • my + ∑ z ∈ T, b z • mo z) h hg'
      (res a * res h ^ k + ∑ z ∈ T, res (b z) * d z) ?_ y hyh ?_
    · change ων.presheaf.map _ (a • my + ∑ z ∈ T, b z • mo z) = _
      rw [map_add, map_sum, Scheme.Modules.map_smul, hmy, add_smul, mul_smul, Finset.sum_smul]
      congr 1
      refine Finset.sum_congr rfl fun z _ => ?_
      rw [Scheme.Modules.map_smul, mul_smul]
      congr 1
      exact (hd z).symm
    · rw [hq y (hyV y hy)] at ha hb
      let _ : Algebra B ((normalizationScheme X hX).presheaf.stalk y) :=
        TopCat.Presheaf.algebra_section_stalk (normalizationScheme X hX).presheaf ⟨y, hyV y hy⟩
      have : IsLocalization.AtPrime ((normalizationScheme X hX).presheaf.stalk y)
          (hUν.primeIdealOf ⟨y, hyV y hy⟩).asIdeal := hUν.isLocalization_stalk ⟨y, hyV y hy⟩
      have hgerm : ∀ x : B, (normalizationScheme X hX).presheaf.germ _ y hyh (res x) =
          algebraMap B ((normalizationScheme X hX).presheaf.stalk y) x := fun x =>
        TopCat.Presheaf.germ_res_apply _ _ _ _ _
      have hua : IsUnit (algebraMap B ((normalizationScheme X hX).presheaf.stalk y) a) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff _ _ a).2 ha
      have huh : IsUnit (algebraMap B ((normalizationScheme X hX).presheaf.stalk y) h) := by
        rw [← hgerm]
        have := ((normalizationScheme X hX).mem_basicOpen h y (hyV y hy)).1 hyh
        rw [TopCat.Presheaf.germ_res_apply]
        exact this
      have hmb : ∀ z ∈ T, algebraMap B ((normalizationScheme X hX).presheaf.stalk y) (b z) ∈
          IsLocalRing.maximalIdeal ((normalizationScheme X hX).presheaf.stalk y) := fun z hz =>
        (IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ (b z)).2 (hb z hz)
      rw [map_add, map_mul, map_pow, hgerm, hgerm, map_sum]
      by_contra hnu
      have h1 := (IsLocalRing.mem_maximalIdeal _).2 hnu
      have h2 : ∑ z ∈ T, (normalizationScheme X hX).presheaf.germ _ y hyh (res (b z) * d z) ∈
          IsLocalRing.maximalIdeal ((normalizationScheme X hX).presheaf.stalk y) :=
        Ideal.sum_mem _ fun z hz => by
          rw [map_mul, hgerm]; exact Ideal.mul_mem_right _ _ (hmb z hz)
      have h3 := Ideal.sub_mem _ h1 h2
      rw [add_sub_cancel_right] at h3
      exact (IsLocalRing.mem_maximalIdeal _).1 h3 (hua.mul (huh.pow k))
  -- separating elements
  have hqne : ∀ (y z : normalizationScheme X hX), normalization X hX y = P →
      normalization X hX z = P → y ≠ z → q y ≠ q z := by
    intro y z hy hz hyz h
    apply hyz
    rw [hq y (hyV y hy), hq z (hyV z hz)] at h
    have e1 := hUν.fromSpec_primeIdealOf ⟨y, hyV y hy⟩
    have e2 := hUν.fromSpec_primeIdealOf ⟨z, hyV z hz⟩
    have : hUν.primeIdealOf ⟨y, hyV y hy⟩ = hUν.primeIdealOf ⟨z, hyV z hz⟩ :=
      PrimeSpectrum.ext h
    exact e1.symm.trans ((congrArg hUν.fromSpec this).trans e2)
  have hsep : ∀ (y z : normalizationScheme X hX), normalization X hX y = P →
      normalization X hX z = P → y ≠ z → ∃ e ∈ q z, e ∉ q y := by
    intro y z hy hz hyz
    have := hqprime y (hyV y hy)
    have := hqprime z (hyV z hz)
    by_contra! hle
    obtain ⟨w, hwy, hwz⟩ : ∃ w ∈ q y, w ∉ q z := by
      by_contra! h'; exact hqne y z hy hz hyz (le_antisymm h' hle)
    have := Ideal.under_lt_under_of_integral_mem_sdiff (R := A) hle ⟨hwy, hwz⟩
      (Algebra.IsIntegral.isIntegral w)
    rw [Ideal.under_def, Ideal.under_def, hqp z hz, hqp y hy] at this
    exact lt_irrefl _ this
  have : Nonempty B := ⟨0⟩
  choose! sepf hsepq hsepn using hsep
  let e : normalizationScheme X hX → B := fun y => ∏ z ∈ S.erase y, sepf y z
  have he₁ : ∀ y, normalization X hX y = P → e y ∉ q y := by
    intro y hy
    have := hqprime y (hyV y hy)
    exact Submonoid.prod_mem (q y).primeCompl fun z hz =>
      hsepn y z hy ((hS z).mp (Finset.mem_of_mem_erase hz)) (Finset.ne_of_mem_erase hz).symm
  have he₂ : ∀ y z, normalization X hX y = P → normalization X hX z = P → y ≠ z → e z ∈ q y := by
    intro y z hy hz hyz
    have hyS : y ∈ S.erase z := Finset.mem_erase.mpr ⟨hyz, (hS y).mpr hy⟩
    change ∏ w ∈ S.erase z, sepf z w ∈ q y
    rw [← Finset.mul_prod_erase (S.erase z) (sepf z) hyS]
    exact Ideal.mul_mem_right _ _ (hsepq z y hz hy hyz.symm)
  choose hh hyh g' hg' m' kk hm' using hdata
  let mm : normalizationScheme X hX → Γ(ων, V) := fun z =>
    if hz : normalization X hX z = P then m' z hz else 0
  have hmm : ∀ z (hz : normalization X hX z = P), mm z = m' z hz := fun z hz => dite_eq_left hz
  set m : Γ(ων, V) := ∑ z ∈ S, e z • mm z
  have hgen : ∀ y, normalization X hX y = P → ∃ (W : (normalizationScheme X hX).Opens)
      (hW : W ≤ V), y ∈ W ∧ IsLocalGenerator ων (ων.presheaf.map (homOfLE hW).op m) := by
    intro y hy
    have hyS : y ∈ S := (hS y).mpr hy
    have hm : m = e y • m' y hy + ∑ z ∈ S.erase y, e z • mm z := by
      rw [← hmm y hy]; exact (Finset.add_sum_erase _ _ hyS).symm
    rw [hm]
    exact hloc y hy (hh y hy) (hyh y hy) (g' y hy) (hg' y hy) (m' y hy) (kk y hy) (hm' y hy) (e y)
      (S.erase y) e mm (he₁ y hy) fun z hz => he₂ y z hy ((hS z).mp (Finset.mem_of_mem_erase hz))
        (Finset.ne_of_mem_erase hz).symm
  choose Wf hWf hyWf hgWf using hgen
  -- `m` generates on `O = ⋃ W_y`
  set O : (normalizationScheme X hX).Opens :=
    ⨆ z : {z : normalizationScheme X hX // normalization X hX z = P}, Wf z.1 z.2
  have hWO : ∀ z (hz : normalization X hX z = P), Wf z hz ≤ O := fun z hz =>
    le_iSup (fun w : {z : normalizationScheme X hX // normalization X hX z = P} => Wf w.1 w.2)
      ⟨z, hz⟩
  have hOV : O ≤ V := iSup_le fun z => hWf z.1 z.2
  have hgO : IsLocalGenerator ων (ων.presheaf.map (homOfLE hOV).op m) := by
    refine isLocalGenerator_of_forall_mem ων _ fun x hx => ?_
    obtain ⟨z, hxz⟩ := Opens.mem_iSup.mp hx
    refine ⟨Wf z.1 z.2, hWO z.1 z.2, hxz, ?_⟩
    rw [modules_map_map]
    exact hgWf z.1 z.2
  -- shrink `U₁` so that `ν⁻¹U ⊆ O`
  have hZ : IsClosed ((normalization X hX).base '' (O : Set (normalizationScheme X hX))ᶜ) :=
    (normalization X hX).isClosedMap _ O.isOpen.isClosed_compl
  have hPZ : P ∉ (normalization X hX).base '' (O : Set (normalizationScheme X hX))ᶜ := by
    rintro ⟨y, hyO, hyP⟩
    exact hyO (hWO y hyP (hyWf y hyP))
  let U' : X.Opens := U₁ ⊓ ⟨_, hZ.isOpen_compl⟩
  obtain ⟨f, hfU', hPf⟩ := hU₁.exists_basicOpen_le (V := U') ⟨P, hPU₁, hPZ⟩ hPU₁
  have hfO : normalization X hX ⁻¹ᵁ X.basicOpen f ≤ O := by
    intro y hy
    by_contra hyO
    exact (hfU' hy).2 ⟨y, hyO, rfl⟩
  refine ⟨X.basicOpen f, (X.basicOpen_le f).trans hU₁U₀, hPf, hU₁.basicOpen f, _,
    hgO.restrict hfO⟩

/-- **The pulled-back canonical generator has order `-1` at each point over a seminormal
non-regular codimension-one point `P`.** -/
private theorem isOrderOfSectionAt_neg_one_of_isSeminormalHom {k : Type u} [Field k]
    {X : Scheme.{u}} (sX : X ⟶ Spec (.of k)) [LocallyOfFiniteType sX] [IsReduced X] (n : ℕ)
    (ωX : X.Modules) (hωX : IsDualizingSheaf sX n ωX)
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (ων : (normalizationScheme X hX).Modules)
    (hων : IsDualizingSheaf (normalization X hX ≫ sX) n ων)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hτ : ∀ V : X.affineOpens,
      letI := ((normalization X hX).app V).hom.toAlgebra
      ∀ φ : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! f : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ a, φ a = τ.app V (a • f))
    (P : X) (hPsing : ¬ IsRegularLocalRing (X.presheaf.stalk P))
    (hSN : @IsSeminormalHom (X.presheaf.stalk P)
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalk X hX P) _ _
        (Stacks.NormalizationStalkAmbient.normalizationPushforwardStalkAlgebra X hX P))
    (hfib : ∀ y, normalization X hX y = P → Order.coheight y = 1)
    {W : X.Opens} (s : Γ(ωX, W))
    (hs : ∃ (V : X.Opens) (_ : P ∈ V) (hVW : V ≤ W),
      IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hVW).op s))
    {W' : X.Opens} (hW' : W' ≤ W)
    (hW'gen : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ⤳ P → η ∈ W')
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W'))
    (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s) :
    ∀ y : normalizationScheme X hX, normalization X hX y = P →
      IsOrderOfSectionAt ων t y (-1) := by
  intro y hy
  have hT : ∀ V : X.Opens, IsAffineOpen V →
      ∀ l : Γ((Scheme.Modules.pushforward (normalization X hX)).obj
          (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf), V)
          →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! w : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ b : Γ(normalizationScheme X hX,
          normalization X hX ⁻¹ᵁ V), τ.app V (b • w) = l b := by
    intro V hV l
    obtain ⟨f, hf, huniq⟩ := hτ ⟨V, hV⟩ l
    exact ⟨f, fun b => (hf b).symm, fun w hw => huniq w fun b => (hw b).symm⟩
  obtain ⟨V₀, hPV₀, hV₀W, hsV₀⟩ := hs
  obtain ⟨U, hUV₀, hPU, hU, g, hg⟩ := exists_affineOpen_isLocalGenerator_preimage sX n hX ων
    hων P hfib V₀ hPV₀
  have hUW : U ≤ W := hUV₀.trans hV₀W
  have hsU : IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hUW).op s) := by
    simpa only [modules_map_map] using hsV₀.restrict hUV₀
  obtain ⟨θ, hθ⟩ := (hsU U le_rfl).2 (τ.app U g)
  simp only [modules_map_id] at hθ
  have hyU : y ∈ normalization X hX ⁻¹ᵁ U := by
    change normalization X hX y ∈ U
    rwa [hy]
  obtain ⟨V', hV', hVW, hgen, heq⟩ := exists_smul_eq_generator sX n ωX hωX hX ων τ hT
    P s hW' hW'gen t ht hPU hUW hU hsU g θ hθ.symm y hy
  subst hy
  obtain ⟨hθnzd, hθord⟩ := germ_app_mem_nonZeroDivisors_and_ord_eq_one sX ωX hX ων
    τ hT y (hfib y rfl) hPsing hSN hU hyU _ hsU g hg θ hθ.symm
  refine ⟨normalization X hX ⁻¹ᵁ U, hyU, g, 1, (normalization X hX).app U θ, V', hV', hVW, hg,
    hgen, ?_, hθnzd, ?_, 0, 1, ?_, hθord, by norm_num⟩
  · rw [map_one]; exact one_mem _
  · rwa [map_one, one_smul]
  · rw [map_one, Ring.ord_one]; rfl

end Pole

private theorem exists_isPullback_normalization
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ) (L : X.CartierDivisor)
    (hLs : ∀ η : X, IsGenericOrCodimOneSingular η → η ∉ cartierSupport L) :
    ∃ L' : (normalizationScheme X hX).CartierDivisor, IsPullback (normalization X hX) L L' := by
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : IsLocallyNoetherian (normalizationScheme X hX) :=
    LocallyOfFiniteType.isLocallyNoetherian (normalization X hX)
  have hred : IsReduced (normalizationScheme X hX) := Scheme.isReduced_normalizationScheme X hX
  refine exists_isPullback fun η hη => hLs _ (Or.inl ?_)
  have hη' : η ∈ genericPoints (normalizationScheme X hX) := by
    rw [← @weaklyAssociatedPointsOfScheme_eq_genericPoints _ hred]
    simpa only [Stacks.Divisors.schemeWeaklyAssociatedPoints,
      ← AlgebraicGeometry.associatedPoints_eq_weaklyAssociatedPoints _
        (SheafOfModules.unit (normalizationScheme X hX).ringCatSheaf)] using hη
  exact Scheme.normalization_mem_genericPoints X hX hη'

/-- Every prime divisor of the normalization has a discrete valuation ring as local ring. -/
private theorem isDVR_localRing_normalization
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    (Γ' : MMP.Mori.PrimeDivisor (normalizationScheme X hX)) :
    ∃ _ : IsDomain Γ'.localRing, IsDiscreteValuationRing Γ'.localRing := by
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsLocallyNoetherian (normalizationScheme X hX) :=
    LocallyOfFiniteType.isLocallyNoetherian (normalization X hX)
  exact isDVR_stalk_normalization hX Γ'.genericPoint
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ')

/-- Over a regular point `P` there is an open neighbourhood on which the normalization is an
isomorphism: the regular locus is open and normal. -/
private theorem exists_isIso_normalization_restrict_of_isRegularLocalRing
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] [IsReduced X]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    {P : X} (hP : IsRegularLocalRing (X.presheaf.stalk P)) :
    ∃ U : X.Opens, P ∈ U ∧ IsIso (normalization X hX ∣_ U) := by
  let U : X.Opens := ⟨regularLocus X, MMP.Flips.isOpen_regularLocus_of_locallyOfFiniteType sX⟩
  have hN : IsNormal U.toScheme := by
    rw [isNormal_iff_stalk_normal]
    intro x
    have h0 : IsRegularLocalRing (X.presheaf.stalk (U.ι x)) := x.2
    have hreg : IsRegularLocalRing (U.toScheme.presheaf.stalk x) :=
      IsRegularLocalRing.of_ringEquiv (R := X.presheaf.stalk (U.ι x))
        (U.stalkIso x).commRingCatIsoToRingEquiv.symm
    have hd : IsDomain (U.toScheme.presheaf.stalk x) := IsRegularLocalRing.isDomain _
    have hu := IsRegularLocalRing.uniqueFactorizationMonoid (U.toScheme.presheaf.stalk x)
    exact ⟨hd, UniqueFactorizationMonoid.instIsIntegrallyClosed⟩
  exact ⟨U, hP, Scheme.isIso_normalization_restrict_of_isNormal X hX U hN⟩

section DimensionTheory

/-- A finite morphism preserves heights in the specialization order: it maps strict
specializations to strict specializations, and specializations of the image lift, as the
morphism is closed. -/
private theorem height_apply_eq_of_isFinite {X Y : Scheme.{0}} (g : X ⟶ Y) [IsFinite g]
    (x : X) : height (g x) = height x := by
  have hmono : StrictMono g := fun a b hab => by
    have hba : b ⤳ a := Scheme.le_iff_specializes.mp hab.le
    refine lt_of_le_not_ge (Scheme.le_iff_specializes.mpr (hba.map g.continuous)) fun h => ?_
    have heq : g b = g a := ((hba.map g.continuous).antisymm (Scheme.le_iff_specializes.mp h)).eq
    exact hab.ne (MMP.Fourfold.eq_of_specializes_of_isFinite g hba heq).symm
  refine (height_eq_of_strictMono g hmono (fun a b hb => ?_) x).symm
  obtain ⟨a', ha', rfl⟩ := g.isClosedMap.specializingMap (Scheme.le_iff_specializes.mp hb.le)
  refine ⟨a', lt_of_le_not_ge (Scheme.le_iff_specializes.mpr ha') fun h => hb.ne ?_, rfl⟩
  rw [(Specializes.antisymm ha' (Scheme.le_iff_specializes.mp h)).eq]

/-- A finite morphism preserves the dimension of the closure of a point. -/
private theorem topologicalKrullDim_closure_image_singleton_eq {X Y : Scheme.{0}} (g : X ⟶ Y)
    [IsFinite g] (x : X) :
    topologicalKrullDim (closure {g x} : Set Y) = topologicalKrullDim (closure {x} : Set X) := by
  rw [topologicalKrullDim_closure_singleton_eq_height,
    topologicalKrullDim_closure_singleton_eq_height, height_apply_eq_of_isFinite]

private theorem exists_le_height_eq_of_pure {X : Scheme.{0}} (n : ℕ)
    (hr : ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n) (z : X) :
    ∃ η : X, z ≤ η ∧ height η = n := by
  have hZ : irreducibleComponent z ∈ irreducibleComponents X :=
    irreducibleComponent_mem_irreducibleComponents z
  obtain ⟨η, hη⟩ := QuasiSober.sober hZ.1 (isClosed_of_mem_irreducibleComponents _ hZ)
  refine ⟨η, ?_, ?_⟩
  · rw [Scheme.le_iff_specializes]
    exact hη.specializes mem_irreducibleComponent
  · have h1 := topologicalKrullDim_closure_singleton_eq_height η
    have h2 := hr _ hZ
    rw [hη.def] at h1
    rw [h1] at h2
    exact_mod_cast h2

private theorem coheight_add_height_eq_of_pure {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] (n : ℕ)
    (hr : ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n) (x : X) :
    coheight x + height x = n := by
  let _ : X.Over (Spec (.of ℂ)) := ⟨sX⟩
  have : LocallyOfFiniteType (X ↘ Spec (.of ℂ)) := inferInstanceAs (LocallyOfFiniteType sX)
  obtain ⟨η, hxη, hη⟩ := exists_le_height_eq_of_pure n hr x
  obtain ⟨hsum, -⟩ := MMP.height_eq_height_add_coheight_Iic ℂ hxη
  have hxr : height x ≤ n := hη ▸ (le_self_add.trans_eq hsum.symm)
  lift height x to ℕ using (hxr.trans_lt (ENat.natCast_lt_top n)).ne with m hm
  refine le_antisymm ?_ ?_
  · suffices h : coheight x ≤ ((n - m : ℕ) : ℕ∞) by
      have hmr : m ≤ n := by exact_mod_cast hxr
      calc coheight x + m ≤ ((n - m : ℕ) : ℕ∞) + m := by gcongr
        _ = n := by norm_cast; omega
    refine coheight_le fun p hp => ?_
    obtain ⟨ζ, hζ, hζr⟩ := exists_le_height_eq_of_pure n hr p.last
    have h1 := MMP.length_le_coheight_Iic p hζ
    have hxζ : x ≤ ζ := hp ▸ (p.monotone (Fin.zero_le _)).trans hζ
    have hpt : (⟨p.head, (p.monotone (Fin.zero_le _)).trans hζ⟩ : Set.Iic ζ) = ⟨x, hxζ⟩ :=
      Subtype.ext hp
    rw [hpt] at h1
    obtain ⟨hsum', -⟩ := MMP.height_eq_height_add_coheight_Iic ℂ hxζ
    rw [hζr, ← hm] at hsum'
    have h2 : (p.length : ℕ∞) + m ≤ n := by
      rw [hsum', add_comm]; gcongr
    have h3 : p.length + m ≤ n := by exact_mod_cast h2
    change ((p.length : ℕ) : ℕ∞) ≤ _
    exact_mod_cast (by omega : p.length ≤ n - m)
  · have h1 : coheight (⟨x, hxη⟩ : Set.Iic η) ≤ coheight x :=
      coheight_le_coheight_apply_of_strictMono (Subtype.val : Set.Iic η → X) (fun _ _ h => h) _
    rw [← hη, hsum, add_comm]
    gcongr

end DimensionTheory

/-- The normalization of a scheme of pure dimension `n` has pure dimension `n`: its irreducible
components are the closures of its generic points, which map to generic points, and the finite
morphism `ν` preserves the dimension of the closure of a point. -/
private theorem topologicalKrullDim_irreducibleComponent_normalization
    {X : Scheme.{0}} {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    [IsFinite (normalization X hX)] (n : ℕ)
    (hd : ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = n) :
    ∀ Z ∈ irreducibleComponents (normalizationScheme X hX), topologicalKrullDim Z = n := by
  intro Z hZ
  obtain ⟨η, hη⟩ := QuasiSober.sober hZ.1 (isClosed_of_mem_irreducibleComponents _ hZ)
  have hgen : η ∈ genericPoints (normalizationScheme X hX) := by
    change closure ({η} : Set (normalizationScheme X hX)) ∈
      irreducibleComponents (normalizationScheme X hX)
    rw [hη.def]
    exact hZ
  rw [← hη.def, ← topologicalKrullDim_closure_image_singleton_eq (normalization X hX)]
  exact hd _ (Scheme.normalization_mem_genericPoints X hX hgen)

/-- The normalization preserves codimension. -/
private theorem coheight_normalization_eq
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ) (y : normalizationScheme X hX) :
    Order.coheight (normalization X hX y) = Order.coheight y := by
  classical
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have hpure := hΘ.1.2.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : LocallyOfFiniteType (normalization X hX ≫ sX) := inferInstance
  set ν := normalization X hX
  have hprY := topologicalKrullDim_irreducibleComponent_normalization n hpure
  have h1 := coheight_add_height_eq_of_pure (ν ≫ sX) n hprY y
  have h2 := coheight_add_height_eq_of_pure sX n hpure (ν y)
  rw [height_apply_eq_of_isFinite ν y] at h2
  have hfin : Order.height y ≠ ⊤ := by
    refine ne_top_of_le_ne_top (ENat.natCast_ne_top n) ?_
    rw [← h1]
    exact le_add_self
  exact (WithTop.add_right_inj hfin).mp (h2.trans h1.symm)

/-- The double locus of a scheme locally of finite type over a field is singular. -/
private theorem doubleIntersectionLocus_subset_compl_regularLocus {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sX] :
    (doubleIntersectionLocus X : Set X) ⊆ (regularLocus X)ᶜ :=
  closure_minimal (fun _ hη h => hη.2 h)
    (MMP.Flips.isOpen_regularLocus_of_locallyOfFiniteType sX).isClosed_compl

/-- The closure of the preimage of `closure Z \ D` lies over `closure Z`. -/
private theorem closure_preimageSet_diff_subset {X Y : Scheme.{0}} (ν : Y ⟶ X) (Z D : Set X) :
    closure (preimageSet ν (closure Z \ D)) ⊆ ν.base ⁻¹' closure Z :=
  closure_minimal (fun _ hz => hz.1) (isClosed_closure.preimage ν.continuous)

/-- A prime divisor of `X^ν` off the conductor lies over a point of codimension one of `X` with
regular local ring (the point is outside the double locus; the normalization preserves
codimensions of finite-type equidimensional schemes). -/
private theorem coheight_and_regular_of_not_isConductorComponent
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    (Γ' : WeilDivisorPrime (normalizationScheme X hX))
    (hconc : ¬ IsConductorComponent (normalization X hX) Γ'.1.genericPoint) :
    Order.coheight (normalization X hX Γ'.1.genericPoint) = 1 ∧
      IsRegularLocalRing (X.presheaf.stalk (normalization X hX Γ'.1.genericPoint)) := by
  classical
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have hred : IsReduced X := hΘ.1.2.1
  have hpure := hΘ.1.2.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : LocallyOfFiniteType (normalization X hX ≫ sX) := inferInstance
  set ν := normalization X hX
  set y := Γ'.1.genericPoint
  have hy1 : Order.coheight y = 1 := AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ'.1
  have hP1 : Order.coheight (ν y) = 1 := (coheight_normalization_eq hΘ y).trans hy1
  have hgenY : ∀ z : normalizationScheme X hX,
      closure {z} ∈ irreducibleComponents (normalizationScheme X hX) →
        closure {ν z} ∈ irreducibleComponents X := fun z hz =>
    Scheme.normalization_mem_genericPoints X hX hz
  have hPD : ν y ∉ (doubleIntersectionLocus X : Set X) := by
    intro hmem
    apply hconc
    have hS : IsClosed (preimageSet ν (doubleIntersectionLocus X : Set X)) :=
      (doubleIntersectionLocus X).isClosed.preimage ν.continuous
    refine ⟨⟨closure_minimal (Set.singleton_subset_iff.mpr hmem) hS,
      isIrreducible_singleton.closure⟩, ?_⟩
    intro T hT hle
    obtain ⟨z, hz⟩ := QuasiSober.sober hT.2.closure isClosed_closure
    have hyT : y ∈ closure T := subset_closure (hle (subset_closure rfl))
    have hzy : z ⤳ y := specializes_iff_mem_closure.mpr (hz.def ▸ hyT)
    by_cases hzy' : z = y
    · intro w hw
      have h1 : w ∈ closure T := subset_closure hw
      rw [← hz.def, hzy'] at h1
      exact h1
    · exfalso
      have hlt : y < z := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr hzy)
        (fun h => hzy' (hzy.antisymm (Scheme.le_iff_specializes.mp h)).eq)
      let _ : (normalizationScheme X hX).Over (Spec (.of ℂ)) := ⟨ν ≫ sX⟩
      have : LocallyOfFiniteType ((normalizationScheme X hX) ↘ Spec (.of ℂ)) :=
        inferInstanceAs (LocallyOfFiniteType (ν ≫ sX))
      have hzfin : Order.coheight z < ⊤ :=
        MMP.coheight_lt_top_of_locallyOfFiniteType ℂ z
      have hlt2 := Order.coheight_strictAnti hlt hzfin
      rw [hy1] at hlt2
      have hz0 : Order.coheight z = 0 := Order.lt_one_iff.mp hlt2
      have hzmax : IsMax z := Order.coheight_eq_zero.mp hz0
      have hzc : closure {z} ∈ irreducibleComponents (normalizationScheme X hX) :=
        (AlgebraicGeometry.isMax_iff_closure_mem_irreducibleComponents z).mp hzmax
      have hzS : z ∈ preimageSet ν (doubleIntersectionLocus X : Set X) :=
        closure_minimal hT.1 hS (hz.def ▸ (subset_closure rfl : z ∈ closure {z}))
      have hreg : ν z ∈ regularLocus X := by
        have hfield := isField_stalk_of_closure_mem_irreducibleComponents X (ν z) (hgenY z hzc)
        exact MMP.Flips.isRegularLocalRing_of_isField hfield
      exact doubleIntersectionLocus_subset_compl_regularLocus sX hzS hreg
  refine ⟨hP1, ?_⟩
  by_contra hnr
  exact hPD (subset_closure ⟨hP1, hnr⟩)

private theorem ord_ringEquiv {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B) (a : A) :
    Ring.ord B (e a) = Ring.ord A a := by
  let _ : Algebra A B := e.toRingHom.toAlgebra
  have hsurj : Function.Surjective (algebraMap A B) := e.surjective
  let ea : A ≃ₐ[A] B := AlgEquiv.ofRingEquiv (f := e) (fun r => rfl)
  have hI : Ideal.map ea (Ideal.span {a}) = Ideal.span {e a} := by
    rw [Ideal.map_span]
    simp only [Set.image_singleton]
    rfl
  let q : (A ⧸ Ideal.span {a}) ≃ₐ[A] (B ⧸ Ideal.span {e a}) :=
    Ideal.quotientEquivAlg (Ideal.span {a}) (Ideal.span {e a}) ea hI.symm
  unfold Ring.ord
  have h1 : Module.length A (A ⧸ Ideal.span {a}) = Module.length A (B ⧸ Ideal.span {e a}) :=
    q.toLinearEquiv.length_eq
  rw [h1]
  exact (Module.length_eq_of_surjective (S := A) (R := B) (M := B ⧸ Ideal.span {e a}) hsurj).symm

/-- The order of a Cartier divisor at a point (`IsOrderAlong` with the point as a variable). -/
private def OrdAt {X : Scheme.{0}} (D : X.CartierDivisor) (x : X) (N : ℤ) : Prop :=
  ∃ a b : X.presheaf.stalk x,
    a ∈ nonZeroDivisors _ ∧ b ∈ nonZeroDivisors _ ∧
    (∃ g, IsLocalEquationAt D x g ∧ IsFraction g a b) ∧
    ∃ la lb : ℕ,
      Module.length (X.presheaf.stalk x) (X.presheaf.stalk x ⧸ Ideal.span {a}) = la ∧
      Module.length (X.presheaf.stalk x) (X.presheaf.stalk x ⧸ Ideal.span {b}) = lb ∧
      N = la - lb

private theorem ordAt_zero_of_isLocalEquationAt_one {Y : Scheme.{0}} {D : Y.CartierDivisor}
    {y : Y} (h : IsLocalEquationAt D y 1) : OrdAt D y 0 := by
  refine ⟨1, 1, one_mem _, one_mem _, ⟨1, h, ⟨by rw [map_one]; exact isUnit_one, by simp⟩⟩,
    0, 0, ?_, ?_, by simp⟩
  · simp [Ring.ord]
  · simp [Ring.ord]

private theorem ordAt_pullback_of_isIso {X Y : Scheme.{0}} {f : Y ⟶ X} {D : X.CartierDivisor}
    {D' : Y.CartierDivisor} [IsLocallyNoetherian Y] (h : IsPullback f D D') {y : Y}
    [IsIso (f.stalkMap y)] {N : ℤ}
    (hN : OrdAt D (f y) N) : OrdAt D' y N := by
  obtain ⟨a, b, ha, hb, ⟨g, hg, hab⟩, la, lb, hla, hlb, rfl⟩ := hN
  let e : X.presheaf.stalk (f y) ≃+* Y.presheaf.stalk y :=
    (asIso (f.stalkMap y)).commRingCatIsoToRingEquiv
  have hnzd : ∀ c ∈ nonZeroDivisors (X.presheaf.stalk (f y)),
      (f.stalkMap y).hom c ∈ nonZeroDivisors (Y.presheaf.stalk y) := fun c hc =>
    (MulEquivClass.map_nonZeroDivisors e).le ⟨c, hc, rfl⟩
  have ha' := hnzd a ha
  have hb' := hnzd b hb
  have hu : IsUnit (stalkToTotalQuotient y ((f.stalkMap y).hom b)) :=
    isUnit_stalkToTotalQuotient_of_mem_nonZeroDivisors hb'
  have hfr : IsFraction (((hu.unit⁻¹ : (Y.totalQuotientSheaf.presheaf.stalk y)ˣ) :
      Y.totalQuotientSheaf.presheaf.stalk y) * stalkToTotalQuotient y ((f.stalkMap y).hom a))
      ((f.stalkMap y).hom a) ((f.stalkMap y).hom b) := by
    refine ⟨hu, ?_⟩
    rw [← mul_assoc, hu.mul_val_inv, one_mul]
  have hg' := h.isLocalEquationAt hg hab hfr
  refine ⟨_, _, ha', hb', ⟨_, hg', hfr⟩, la, lb, ?_, ?_, rfl⟩
  · exact (ord_ringEquiv e a).trans (ord_eq_of_length_eq hla)
  · exact (ord_ringEquiv e b).trans (ord_eq_of_length_eq hlb)

private theorem isIso_stalkMap_of_isIso_morphismRestrict {X Y : Scheme.{0}} (f : Y ⟶ X)
    (U : X.Opens) [IsIso (f ∣_ U)] (y : Y) (hy : f y ∈ U) : IsIso (f.stalkMap y) :=
  (Arrow.isIso_iff_isIso_of_isIso (morphismRestrictStalkMap f U ⟨y, hy⟩).hom).mp
    ((IsOpenImmersion.iff_isIso_stalkMap.mp inferInstance).2 _)

/-- Over a point `y` at which `f` induces an isomorphism of local rings and whose image has
codimension one, the image is the generic point of a prime divisor of `X` whose local ring is a
discrete valuation ring whenever that of the prime divisor through `y` is. -/
private theorem exists_prime_over_of_isIso {X Y : Scheme.{0}} (f : Y ⟶ X) (y : Y)
    [IsIso (f.stalkMap y)] (Γ' : MMP.Mori.PrimeDivisor Y) (hy : Γ'.genericPoint = y)
    (hcoh : Order.coheight (f y) = 1)
    (hΓ' : ∃ _ : IsDomain Γ'.localRing, IsDiscreteValuationRing Γ'.localRing) :
    ∃ ΓP : MMP.Mori.PrimeDivisor X, ΓP.genericPoint = f y ∧
      ∃ _ : IsDomain ΓP.localRing, IsDiscreteValuationRing ΓP.localRing := by
  let ΓP : MMP.Mori.PrimeDivisor X := AlgebraicGeometry.PrimeDivisor.ofCoheightOne (f y) hcoh
  have hgp : ΓP.genericPoint = f y :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _
  refine ⟨ΓP, hgp, ?_⟩
  obtain ⟨hd, hdvr⟩ := hΓ'
  subst hy
  let e : (X.presheaf.stalk (f Γ'.genericPoint)) ≃+* Γ'.localRing :=
    (asIso (f.stalkMap Γ'.genericPoint)).commRingCatIsoToRingEquiv
  let e2 : ΓP.localRing ≃+* X.presheaf.stalk (f Γ'.genericPoint) :=
    (X.presheaf.stalkCongr (.of_eq hgp)).commRingCatIsoToRingEquiv
  let e3 : ΓP.localRing ≃+* Γ'.localRing := e2.trans e
  have hd2 : IsDomain ΓP.localRing := Function.Injective.isDomain e3.toRingHom e3.injective
  refine ⟨hd2, ?_⟩
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing
    (A := Γ'.localRing) (B := ΓP.localRing) e3.symm

private theorem isOrderAlong_pullback_prime {X Y : Scheme.{0}} [IsLocallyNoetherian Y]
    {f : Y ⟶ X} {D : X.CartierDivisor} {D' : Y.CartierDivisor} (h : IsPullback f D D') (y : Y)
    [IsIso (f.stalkMap y)] (Γ' : MMP.Mori.PrimeDivisor Y) (hy : Γ'.genericPoint = y)
    (ΓP : MMP.Mori.PrimeDivisor X) (hΓP : ΓP.genericPoint = f y) {N : ℤ}
    (hN : IsOrderAlong D (primeDivisorSubvariety ΓP) N) :
    IsOrderAlong D' (primeDivisorSubvariety Γ') N := by
  have h1 : OrdAt D ΓP.genericPoint N := hN
  rw [hΓP] at h1
  change OrdAt D' Γ'.genericPoint N
  subst hy
  exact ordAt_pullback_of_isIso h h1

/-- A section of a reduced scheme over an affine open vanishing at the germ of every generic point
specializing to `P` has zero germ at `P`. -/
private theorem germ_eq_zero_of_forall_generic {X : Scheme.{0}} [IsReduced X] {V : X.Opens}
    (hV : IsAffineOpen V) {P : X} (hP : P ∈ V) (c : Γ(X, V))
    (h : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ⤳ P →
      ∃ hη : η ∈ V, X.presheaf.germ V η hη c = 0) :
    X.presheaf.germ V P hP c = 0 := by
  classical
  let _ : Algebra Γ(X, V) (X.presheaf.stalk P) := X.presheaf.algebra_section_stalk ⟨P, hP⟩
  have hloc := hV.isLocalization_stalk ⟨P, hP⟩
  have hred : IsReduced (X.presheaf.stalk P) := inferInstance
  have hc : (algebraMap Γ(X, V) (X.presheaf.stalk P)) c ∈ nilradical (X.presheaf.stalk P) := by
    rw [nilradical, Ideal.radical_eq_sInf]
    refine Submodule.mem_sInf.mpr fun Q hQ => ?_
    obtain ⟨hQle, hQp⟩ := hQ
    let Q' : Ideal Γ(X, V) := Ideal.comap (algebraMap Γ(X, V) (X.presheaf.stalk P)) Q
    have hQ'p : Q'.IsPrime := Ideal.comap_isPrime _ _
    have hQ'le : Q' ≤ (hV.primeIdealOf ⟨P, hP⟩).asIdeal := by
      intro a ha
      by_contra hna
      have hu : IsUnit (algebraMap Γ(X, V) (X.presheaf.stalk P) a) :=
        IsLocalization.map_units (M := (hV.primeIdealOf ⟨P, hP⟩).asIdeal.primeCompl)
            (X.presheaf.stalk P) ⟨a, hna⟩
      exact hQp.ne_top (Ideal.eq_top_of_isUnit_mem Q ha hu)
    obtain ⟨q0, hq0min, hq0le⟩ := Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ Q')
    have hq0p : q0.IsPrime := hq0min.1.1
    let y : PrimeSpectrum Γ(X, V) := ⟨q0, hq0p⟩
    let η : X := hV.fromSpec y
    have hηV : η ∈ V := by
      have : η ∈ Set.range hV.fromSpec := ⟨y, rfl⟩
      rwa [hV.range_fromSpec] at this
    have hP' : hV.fromSpec (hV.primeIdealOf ⟨P, hP⟩) = P := hV.fromSpec_primeIdealOf ⟨P, hP⟩
    have hηP : η ⤳ P := by
      rw [← hP']
      exact (PrimeSpectrum.le_iff_specializes _ _ |>.mp (hq0le.trans hQ'le)).map
          hV.fromSpec.continuous
    have hgen : closure {η} ∈ irreducibleComponents X := by
      rw [← AlgebraicGeometry.isMax_iff_closure_mem_irreducibleComponents]
      intro z hz
      have hz' : z ⤳ η := Scheme.le_iff_specializes.mp hz
      have hzV : z ∈ V := hz'.mem_open V.isOpen hηV
      obtain ⟨w, rfl⟩ : z ∈ Set.range hV.fromSpec := by rwa [hV.range_fromSpec]
      have hwy : w ⤳ y := (hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp hz'
      have hle : w.asIdeal ≤ q0 := (PrimeSpectrum.le_iff_specializes w y).mpr hwy
      have heq : w.asIdeal = q0 := (show Minimal (fun q : Ideal Γ(X, V) => q.IsPrime ∧ ⊥ ≤ q) q0
          from hq0min).eq_of_le ⟨w.isPrime, bot_le⟩ hle
      have hyw : y ≤ w := by
        change q0 ≤ w.asIdeal
        exact heq.ge
      exact Scheme.le_iff_specializes.mpr ((PrimeSpectrum.le_iff_specializes y w).mp hyw |>.map
        hV.fromSpec.continuous)
    obtain ⟨hηV', hzero⟩ := h η hgen hηP
    let _ : Algebra Γ(X, V) (X.presheaf.stalk η) := X.presheaf.algebra_section_stalk ⟨η, hηV⟩
    have hloc' : IsLocalization.AtPrime (X.presheaf.stalk η) q0 := hV.isLocalization_stalk' y hηV
    have hcq0 : c ∈ q0 := by
      have h0 : algebraMap Γ(X, V) (X.presheaf.stalk η) c = 0 := hzero
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff q0.primeCompl (X.presheaf.stalk η) c).mp h0
      by_contra hcn
      exact m.2 ((hq0p.mem_or_mem (show (m : Γ(X, V)) * c ∈ q0 by rw [hm]; exact
          q0.zero_mem)).resolve_right hcn)
    exact Ideal.mem_comap.mp (hq0le hcq0)
  exact hred.eq_zero _ (mem_nilradical.mp hc)

private theorem app_bijective_of_isIso_restrict {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens)
    [IsIso (f ∣_ U)] (V : X.Opens) (hV : V ≤ U) : Function.Bijective (f.app V) := by
  obtain ⟨V', rfl⟩ : ∃ V' : U.toScheme.Opens, U.ι ''ᵁ V' = V :=
    ⟨U.ι ⁻¹ᵁ V, by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.2 hV⟩
  have h1 := morphismRestrict_app f U V'
  have h2 : IsIso ((f ∣_ U).app V') := inferInstance
  have h4 : IsIso (Y.presheaf.map (eqToHom (image_morphismRestrict_preimage f U V')).op) :=
    inferInstance
  have h5 : IsIso (f.app (U.ι ''ᵁ V') ≫
      Y.presheaf.map (eqToHom (image_morphismRestrict_preimage f U V')).op) := h1 ▸ h2
  have h3 : IsIso (f.app (U.ι ''ᵁ V')) := IsIso.of_isIso_comp_right _
    (Y.presheaf.map (eqToHom (image_morphismRestrict_preimage f U V')).op)
  exact (ConcreteCategory.bijective_of_isIso (f.app (U.ι ''ᵁ V')))

private theorem isOpenEmbedding_of_isIso_restrict {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens)
    [IsIso (f ∣_ U)] : Topology.IsOpenEmbedding (fun z : f ⁻¹ᵁ U => f z.1) := by
  have h := U.ι.isOpenEmbedding.comp (f ∣_ U).isOpenEmbedding
  have hc : ((fun z : f ⁻¹ᵁ U => f z.1)) = U.ι ∘ (f ∣_ U) := by
    funext z
    exact (congrArg (fun φ => φ z) (morphismRestrict_ι f U)).symm
  rwa [hc]

private theorem eq_of_isIso_restrict {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens)
    [IsIso (f ∣_ U)] {z z' : Y} (hz : f z ∈ U) (hz' : f z' ∈ U) (h : f z = f z') : z = z' := by
  have := (isOpenEmbedding_of_isIso_restrict f U).injective
    (a₁ := (⟨z, hz⟩ : f ⁻¹ᵁ U)) (a₂ := ⟨z', hz'⟩) h
  exact congrArg Subtype.val this

private theorem specializes_of_isIso_restrict {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens)
    [IsIso (f ∣_ U)] {z y : Y} (hz : f z ∈ U) (hy : f y ∈ U) (h : f z ⤳ f y) : z ⤳ y := by
  have := ((isOpenEmbedding_of_isIso_restrict f U).isInducing.specializes_iff
    (x := (⟨z, hz⟩ : f ⁻¹ᵁ U)) (y := ⟨y, hy⟩)).mp h
  exact (Topology.IsInducing.subtypeVal (t := ((f ⁻¹ᵁ U : Y.Opens) : Set Y))).specializes_iff.mpr
      this

private theorem closure_mem_irreducibleComponents_of_isIso_restrict {X Y : Scheme.{0}} (f : Y ⟶ X)
    (U : X.Opens) [IsIso (f ∣_ U)] {z : Y} (hz : f z ∈ U)
    (h : closure {f z} ∈ irreducibleComponents X) : closure {z} ∈ irreducibleComponents Y := by
  rw [← AlgebraicGeometry.isMax_iff_closure_mem_irreducibleComponents] at h ⊢
  intro w hw
  have hw' : w ⤳ z := Scheme.le_iff_specializes.mp hw
  have h1 : f w ⤳ f z := hw'.map f.continuous
  have hwU : f w ∈ U := h1.mem_open U.isOpen hz
  have h2 : f z ⤳ f w := Scheme.le_iff_specializes.mp (h (Scheme.le_iff_specializes.mpr h1))
  exact Scheme.le_iff_specializes.mpr (specializes_of_isIso_restrict f U hz hwU h2)

private theorem tau_app_surjective {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens) [IsIso (f ∣_ U)]
    {ωX : X.Modules} {ωY : Y.Modules} (τ : (Scheme.Modules.pushforward f).obj ωY ⟶ ωX)
    (hτ : ∀ V : X.affineOpens,
      letI := (f.app V).hom.toAlgebra
      ∀ φ : Γ(Y, f ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! F : Γ(ωY, f ⁻¹ᵁ V), ∀ a, φ a = τ.app V (a • F))
    {V : X.Opens} (hV : IsAffineOpen V) (hVU : V ≤ U) : Function.Surjective (τ.app V) := by
  intro x
  have hb := app_bijective_of_isIso_restrict f U V hVU
  let e : Γ(X, V) ≃+* Γ(Y, f ⁻¹ᵁ V) := RingEquiv.ofBijective (f.app V).hom hb
  let := (f.app V).hom.toAlgebra
  let φ : Γ(Y, f ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V) :=
    { toFun := fun a => (e.symm a) • x
      map_add' := fun a b => by simp [add_smul]
      map_smul' := fun r a => by
        have : r • a = e r * a := rfl
        simp only [this, map_mul, RingEquiv.symm_apply_apply, mul_smul, RingHom.id_apply] }
  obtain ⟨F, hF, -⟩ := hτ ⟨V, hV⟩ φ
  refine ⟨F, ?_⟩
  have := hF 1
  simp only [one_smul] at this
  have h1 : φ 1 = x := by
    change (e.symm 1) • x = x
    simp
  rw [h1] at this
  exact this.symm

private theorem exists_isUnit_tau_generator {X Y : Scheme.{0}} (f : Y ⟶ X) (U : X.Opens)
    [IsIso (f ∣_ U)]
    {ωX : X.Modules} {ωY : Y.Modules} (τ : (Scheme.Modules.pushforward f).obj ωY ⟶ ωX)
    {V1 V0 : X.Opens} (hV1U : V1 ≤ U) (hV10 : V1 ≤ V0) {V : Y.Opens} (hV1V : f ⁻¹ᵁ V1 ≤ V)
    (hτs : Function.Surjective (τ.app V1))
    {g0 : Γ(ωX, V0)} (hg0 : IsLocalGenerator ωX g0) {g : Γ(ωY, V)} (hg : IsLocalGenerator ωY g) :
    ∃ u : Γ(X, V1), IsUnit u ∧
      τ.app V1 (ωY.presheaf.map (homOfLE hV1V).op g) =
        u • ωX.presheaf.map (homOfLE hV10).op g0 := by
  have hb := app_bijective_of_isIso_restrict f U V1 hV1U
  have h0 := hg0 V1 hV10
  obtain ⟨u, hu⟩ := h0.2 (τ.app V1 (ωY.presheaf.map (homOfLE hV1V).op g))
  refine ⟨u, ?_, hu.symm⟩
  obtain ⟨h, hh⟩ := hτs (ωX.presheaf.map (homOfLE hV10).op g0)
  obtain ⟨c, hc⟩ := (hg (f ⁻¹ᵁ V1) hV1V).2 h
  obtain ⟨cX, hcX⟩ := hb.2 c
  have hc' : f.app V1 cX • ωY.presheaf.map (homOfLE hV1V).op g = h := by
    rwa [hcX]
  have key : (cX * u) • ωX.presheaf.map (homOfLE hV10).op g0 =
      (1 : Γ(X, V1)) • ωX.presheaf.map (homOfLE hV10).op g0 := by
    rw [mul_smul, one_smul]
    simp only at hu
    rw [hu, ← pushforward_hom_app_smul, hc', hh]
  exact IsUnit.of_mul_eq_one cX (by rw [mul_comm]; exact h0.1 key)

private theorem isOrderOfSectionAt_eq_of_isIso {X Y : Scheme.{0}} (f : Y ⟶ X) [IsFinite f]
    [IsReduced X]
    (U : X.Opens) [IsIso (f ∣_ U)]
    {ωX : X.Modules} {ωY : Y.Modules} (τ : (Scheme.Modules.pushforward f).obj ωY ⟶ ωX)
    (hτs : ∀ V : X.Opens, IsAffineOpen V → V ≤ U → Function.Surjective (τ.app V))
    {W W' : X.Opens} (hW' : W' ≤ W) (s : Γ(ωX, W)) (t : Γ(ωY, f ⁻¹ᵁ W'))
    (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s) {y : Y}
    (hgenX : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ⤳ f y → η ∈ W')
    (hy : f y ∈ U) {n m : ℤ}
    (hY : IsOrderOfSectionAt ωY t y n) (hX : IsOrderOfSectionAt ωX s (f y) m) : n = m := by
  classical
  obtain ⟨V0, hξ0, g0, a0, b0, V0', hV0'0, hV0'W, hg0, hgen0, ha0, hb0, heq0, la0, lb0, hla0,
    hlb0, rfl⟩ := hX
  obtain ⟨V, hyV, g, a, b, V', hV'V, hV'W, hg, hgen, ha, hb, heq, la, lb, hla, hlb, rfl⟩ := hY
  have hclosed : IsClosedMap f := f.isClosedMap
  let Cop : Y.Opens → X.Opens := fun A =>
    ⟨(f '' (A : Set Y)ᶜ)ᶜ, (hclosed _ A.isOpen.isClosed_compl).isOpen_compl⟩
  have hCop : ∀ (A : Y.Opens) (z : Y), f z ∈ Cop A → z ∈ A := by
    intro A z hz
    by_contra hzA
    exact hz ⟨z, hzA, rfl⟩
  have hξC : ∀ A : Y.Opens, y ∈ A → f y ∈ Cop A := by
    intro A hA
    rintro ⟨z, hz, hzy⟩
    exact hz (eq_of_isIso_restrict f U (hzy ▸ hy) hy hzy ▸ hA)
  obtain ⟨_, ⟨V1, hV1, rfl⟩, hξV1, hV1le'⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
    (show f y ∈ ((V0 ⊓ U ⊓ Cop V : X.Opens) : Set X) from ⟨⟨hξ0, hy⟩, hξC V hyV⟩)
    (V0 ⊓ U ⊓ Cop V : X.Opens).isOpen
  have hV1le : V1 ≤ V0 ⊓ U ⊓ Cop V := hV1le'
  have hV1V0 : V1 ≤ V0 := fun x hx => (hV1le hx).1.1
  have hV1U : V1 ≤ U := fun x hx => (hV1le hx).1.2
  have hpre : f ⁻¹ᵁ V1 ≤ V := fun z hz => hCop V z (hV1le hz).2
  obtain ⟨u, hu, hτg⟩ := exists_isUnit_tau_generator f U τ hV1U hV1V0 hpre (hτs V1 hV1 hV1U) hg0 hg
  have hb1 := app_bijective_of_isIso_restrict f U V1 hV1U
  obtain ⟨aX, haX⟩ := hb1.2 (Y.presheaf.map (homOfLE hpre).op a)
  obtain ⟨bX, hbX⟩ := hb1.2 (Y.presheaf.map (homOfLE hpre).op b)
  let Vx : X.Opens := V1 ⊓ V0' ⊓ W' ⊓ Cop V'
  have hVx1 : Vx ≤ V1 := fun x hx => hx.1.1.1
  have hVx0' : Vx ≤ V0' := fun x hx => hx.1.1.2
  have hVxW' : Vx ≤ W' := fun x hx => hx.1.2
  have hpre' : f ⁻¹ᵁ Vx ≤ V' := fun z hz => hCop V' z hz.2
  have hVxW : Vx ≤ W := hVxW'.trans hW'
  have hVx0 : Vx ≤ V0 := hVx1.trans hV1V0
  let sx : Γ(ωX, Vx) := ωX.presheaf.map (homOfLE hVxW).op s
  let g0x : Γ(ωX, Vx) := ωX.presheaf.map (homOfLE hVx0).op g0
  have E2 : X.presheaf.map (homOfLE hVx0).op b0 • sx =
      X.presheaf.map (homOfLE hVx0).op a0 • g0x := by
    simpa only [Scheme.Modules.map_smul, modules_map_map, presheaf_map_map] using
      congrArg (ωX.presheaf.map (homOfLE hVx0').op) heq0
  have E1 : X.presheaf.map (homOfLE hVx1).op bX • sx =
      (X.presheaf.map (homOfLE hVx1).op aX * X.presheaf.map (homOfLE hVx1).op u) • g0x := by
    have h1 := congrArg (ωY.presheaf.map (homOfLE hpre').op) heq
    simp only [Scheme.Modules.map_smul, modules_map_map, presheaf_map_map] at h1
    have hb2 : Y.presheaf.map (homOfLE (hpre'.trans hV'V)).op b =
        f.app Vx (X.presheaf.map (homOfLE hVx1).op bX) := by
      rw [← app_res f hVx1 bX, hbX, presheaf_map_map]
    have ha2 : Y.presheaf.map (homOfLE (hpre'.trans hV'V)).op a =
        f.app Vx (X.presheaf.map (homOfLE hVx1).op aX) := by
      rw [← app_res f hVx1 aX, haX, presheaf_map_map]
    rw [hb2, ha2] at h1
    have h2 := congrArg (τ.app Vx) h1
    rw [pushforward_hom_app_smul, pushforward_hom_app_smul] at h2
    have h3 : τ.app Vx (ωY.presheaf.map (homOfLE (hpre'.trans hV'W)).op t) = sx := by
      have := pushforward_hom_app_res f τ hVxW' t
      rw [this, ht, modules_map_map]
    have h4 : τ.app Vx (ωY.presheaf.map (homOfLE (hpre'.trans hV'V)).op g) =
        X.presheaf.map (homOfLE hVx1).op u • g0x := by
      have e1 : ωY.presheaf.map (homOfLE (hpre'.trans hV'V)).op g =
          ωY.presheaf.map (homOfLE (f.preimage_mono hVx1)).op
            (ωY.presheaf.map (homOfLE hpre).op g) := by
        rw [modules_map_map]
      rw [e1, pushforward_hom_app_res f τ hVx1, hτg, Scheme.Modules.map_smul, modules_map_map]
    rw [h3, h4] at h2
    rw [h2, mul_smul]
  have key : X.presheaf.map (homOfLE hVx0).op b0 *
        (X.presheaf.map (homOfLE hVx1).op aX * X.presheaf.map (homOfLE hVx1).op u) =
      X.presheaf.map (homOfLE hVx1).op bX * X.presheaf.map (homOfLE hVx0).op a0 := by
    apply (hg0 Vx hVx0).1
    change _ • g0x = _ • g0x
    calc (X.presheaf.map (homOfLE hVx0).op b0 *
          (X.presheaf.map (homOfLE hVx1).op aX * X.presheaf.map (homOfLE hVx1).op u)) • g0x
        = X.presheaf.map (homOfLE hVx0).op b0 •
          ((X.presheaf.map (homOfLE hVx1).op aX * X.presheaf.map (homOfLE hVx1).op u) • g0x) := by
          rw [mul_smul]
      _ = X.presheaf.map (homOfLE hVx0).op b0 • (X.presheaf.map (homOfLE hVx1).op bX • sx) := by
          rw [E1]
      _ = X.presheaf.map (homOfLE hVx1).op bX • (X.presheaf.map (homOfLE hVx0).op b0 • sx) := by
          rw [smul_comm]
      _ = X.presheaf.map (homOfLE hVx1).op bX • (X.presheaf.map (homOfLE hVx0).op a0 • g0x) := by
          rw [E2]
      _ = (X.presheaf.map (homOfLE hVx1).op bX * X.presheaf.map (homOfLE hVx0).op a0) • g0x := by
          rw [mul_smul]
  let b01 : Γ(X, V1) := X.presheaf.map (homOfLE hV1V0).op b0
  let a01 : Γ(X, V1) := X.presheaf.map (homOfLE hV1V0).op a0
  let c1 : Γ(X, V1) := b01 * (aX * u) - bX * a01
  have hc1 : X.presheaf.map (homOfLE hVx1).op c1 = 0 := by
    simp only [c1, b01, a01, map_sub, map_mul, presheaf_map_map]
    rw [key, sub_self]
  have hzero : X.presheaf.germ V1 (f y) hξV1 c1 = 0 := by
    refine germ_eq_zero_of_forall_generic hV1 hξV1 c1 fun η hη hηξ => ?_
    have hηV1 : η ∈ V1 := hηξ.mem_open V1.isOpen hξV1
    have hηC : η ∈ Cop V' := by
      rintro ⟨z, hz, hzη⟩
      have hzU : f z ∈ U := hzη ▸ hV1U hηV1
      have hzy : z ⤳ y := specializes_of_isIso_restrict f U hzU hy (hzη ▸ hηξ)
      have hzg : closure {z} ∈ irreducibleComponents Y :=
        closure_mem_irreducibleComponents_of_isIso_restrict f U hzU (hzη ▸ hη)
      exact hz (hgen z hzg hzy)
    have hηVx : η ∈ Vx := ⟨⟨⟨hηV1, hgen0 η hη hηξ⟩, hgenX η hη hηξ⟩, hηC⟩
    refine ⟨hηV1, ?_⟩
    have := X.presheaf.germ_res_apply (homOfLE hVx1) η hηVx c1
    rw [← this, hc1, map_zero]
  have : IsIso (f.stalkMap y) := isIso_stalkMap_of_isIso_morphismRestrict f U y hy
  let e : X.presheaf.stalk (f y) ≃+* Y.presheaf.stalk y :=
    (asIso (f.stalkMap y)).commRingCatIsoToRingEquiv
  have he : ∀ r, e r = (f.stalkMap y).hom r := fun r => rfl
  have hgerm : ∀ (r : Γ(X, V1)) (r' : Γ(Y, V)),
      f.app V1 r = Y.presheaf.map (homOfLE hpre).op r' →
      e (X.presheaf.germ V1 (f y) hξV1 r) = Y.presheaf.germ V y hyV r' := by
    intro r r' hr
    rw [he]
    have h1 := Scheme.Hom.germ_stalkMap_apply f V1 y hξV1 r
    have h2 := Y.presheaf.germ_res_apply (homOfLE hpre) y (show y ∈ f ⁻¹ᵁ V1 from hξV1) r'
    rw [← h2, ← hr]
    exact h1
  set gaX := X.presheaf.germ V1 (f y) hξV1 aX
  set gbX := X.presheaf.germ V1 (f y) hξV1 bX
  set gu := X.presheaf.germ V1 (f y) hξV1 u
  set gb0 := X.presheaf.germ V1 (f y) hξV1 b01
  set ga0 := X.presheaf.germ V1 (f y) hξV1 a01
  have hrel : gb0 * (gaX * gu) = gbX * ga0 := by
    simpa only [c1, map_sub, map_mul, sub_eq_zero] using hzero
  have hgb0' : gb0 = X.presheaf.germ V0 (f y) hξ0 b0 := X.presheaf.germ_res_apply (homOfLE hV1V0) _
      hξV1 b0
  have hga0' : ga0 = X.presheaf.germ V0 (f y) hξ0 a0 := X.presheaf.germ_res_apply (homOfLE hV1V0) _
      hξV1 a0
  have hoaX : Ring.ord _ gaX = la := by
    rwa [← ord_ringEquiv e gaX, hgerm aX a haX]
  have hobX : Ring.ord _ gbX = lb := by
    rwa [← ord_ringEquiv e gbX, hgerm bX b hbX]
  have hnaX : gaX ∈ nonZeroDivisors _ := by
    have h := (MulEquivClass.map_nonZeroDivisors e.symm).le
      ⟨e gaX, by rw [hgerm aX a haX]; exact ha, rfl⟩
    simpa only [MonoidHom.coe_coe, RingEquiv.symm_apply_apply] using h
  have hu' : IsUnit gu := hu.map (X.presheaf.germ V1 (f y) hξV1).hom
  have hL : Ring.ord _ (gb0 * (gaX * gu)) = (lb0 : ℕ∞) + la := by
    rw [← mul_assoc, Ring.ord_mul_of_isUnit_right hu', Ring.ord_mul _ hnaX, hgb0', hlb0, hoaX]
  have hR : Ring.ord _ (gbX * ga0) = (lb : ℕ∞) + la0 := by
    rw [Ring.ord_mul _ (by rwa [hga0']), hobX, hga0', hla0]
  rw [hrel, hR] at hL
  have hL' : lb + la0 = lb0 + la := by exact_mod_cast hL
  omega

private theorem isOrderOfSectionAt_unique {Y : Scheme.{0}} [IsReduced Y] {ω : Y.Modules}
    {W : Y.Opens} (t : Γ(ω, W)) {y : Y} {n m : ℤ} (h1 : IsOrderOfSectionAt ω t y n)
    (h2 : IsOrderOfSectionAt ω t y m) : n = m := by
  let τ0 : (Scheme.Modules.pushforward (𝟙 Y)).obj ω ⟶ ω :=
    (Scheme.Modules.pushforwardId Y).hom.app ω
  have hτ0 : ∀ (V : Y.Opens) (x : Γ(ω, V)), τ0.app V x = x := fun V x => rfl
  refine isOrderOfSectionAt_eq_of_isIso (𝟙 Y) ⊤ τ0
    (fun V _ _ x => ⟨x, hτ0 V x⟩) (le_refl W) t t
    ((hτ0 W t).trans (modules_map_id ω t).symm) ?_ (trivial : (𝟙 Y) y ∈ (⊤ : Y.Opens)) h1 h2
  intro η _ hη
  obtain ⟨V, hξ, g, a, b, V', hV'V, hW, -, hgen, -⟩ := h1
  exact hW (hgen η ‹_› hη)

private theorem eq_of_specializes_of_coheight_eq_one {T : Scheme.{0}} {x y : T} (h : x ⤳ y)
    (hx : Order.coheight x = 1) (hy : Order.coheight y = 1) : x = y := by
  by_contra hne
  have hlt : y < x := lt_of_le_not_ge (h : y ≤ x) (fun h' => hne (h.antisymm h').eq)
  have := Order.coheight_strictAnti hlt (by rw [hx]; exact ENat.one_lt_top)
  rw [hx, hy] at this
  exact lt_irrefl _ this

/-- The boundary `Θ` of the normalization along a prime divisor off the conductor is the
coefficient of `Δ` along its image. -/
private theorem theta_eq_delta_of_not_isConductorComponent
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    (Γ' : WeilDivisorPrime (normalizationScheme X hX))
    (hconc : ¬ IsConductorComponent (normalization X hX) Γ'.1.genericPoint)
    (ΓP : WeilDivisorPrime X) (hgp : ΓP.1.genericPoint = normalization X hX Γ'.1.genericPoint)
    (hreg : IsRegularLocalRing (X.presheaf.stalk (normalization X hX Γ'.1.genericPoint))) :
    Θ Γ' = Δ ΓP := by
  classical
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have hcoh : ∀ Γ : WeilDivisorPrime X, Order.coheight Γ.1.genericPoint = 1 := fun Γ =>
    AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ.1
  set ν := normalization X hX
  set y := Γ'.1.genericPoint
  have hPD : ν y ∉ (doubleIntersectionLocus X : Set X) := fun hmem =>
    doubleIntersectionLocus_subset_compl_regularLocus sX hmem hreg
  have key : ∀ Γ : WeilDivisorPrime X,
      IsComponentGenericPoint (closure (preimageSet ν
        (closure {Γ.1.genericPoint} \ (doubleIntersectionLocus X : Set X)))) y ↔ Γ = ΓP := by
    intro Γ
    have hsub := closure_preimageSet_diff_subset ν {Γ.1.genericPoint}
      (doubleIntersectionLocus X : Set X)
    constructor
    · intro h
      have h2 : Γ.1.genericPoint ⤳ ν y :=
        specializes_iff_mem_closure.mpr (hsub (h.1.1 (subset_closure rfl)))
      have h3 := eq_of_specializes_of_coheight_eq_one h2 (hcoh Γ) (by rw [← hgp]; exact hcoh ΓP)
      exact Subtype.ext (AlgebraicGeometry.PrimeDivisor.genericPoint_injective (h3.trans hgp.symm))
    · rintro rfl
      have hyS : y ∈ preimageSet ν
          (closure {Γ.1.genericPoint} \ (doubleIntersectionLocus X : Set X)) :=
        ⟨by rw [← hgp]; exact subset_closure rfl, hPD⟩
      refine ⟨⟨closure_mono (Set.singleton_subset_iff.mpr hyS), isIrreducible_singleton.closure⟩,
          ?_⟩
      intro T hT hle
      obtain ⟨z, hz⟩ := QuasiSober.sober (hT.2.closure) isClosed_closure
      have hzy : z ⤳ y := specializes_iff_mem_closure.mpr <| by
        rw [hz.def]
        exact subset_closure (hle (subset_closure rfl))
      have hzT : z ∈ closure T := by rw [← hz.def]; exact subset_closure rfl
      have hzS : z ∈ closure (preimageSet ν
          (closure {Γ.1.genericPoint} \ (doubleIntersectionLocus X : Set X))) :=
        closure_minimal hT.1 isClosed_closure hzT
      have h1 : Γ.1.genericPoint ⤳ ν z := specializes_iff_mem_closure.mpr (hsub hzS)
      have h2 : ν z ⤳ ν y := hzy.map ν.continuous
      rw [← hgp] at h2
      have h3 : ν z = Γ.1.genericPoint := h2.antisymm h1 |>.eq
      have h4 : z = y := MMP.Fourfold.eq_of_specializes_of_isFinite ν hzy (by rw [h3, hgp])
      intro w hw
      have : w ∈ closure T := subset_closure hw
      rwa [← hz.def, h4] at this
  obtain ⟨_, _, _, hΘ4⟩ := hΘ
  rw [hΘ4 Γ', ite_eq_right hconc, add_zero, Finset.sum_eq_single ΓP]
  · rw [ite_eq_left ((key ΓP).mpr rfl)]
  · intro Γ _ hne
    rw [ite_eq_right (fun h => hne ((key Γ).mp h))]
  · intro hnot
    rw [ite_eq_left ((key ΓP).mpr rfl), Finsupp.notMem_support_iff.mp hnot]

/-- Along a conductor component the boundary `Θ` has coefficient one: the image of the
component lies in the double locus, so no component of `Δ` off the double locus contributes. -/
private theorem theta_eq_one_of_isConductorComponent
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    (Γ' : WeilDivisorPrime (normalizationScheme X hX))
    (hconc : IsConductorComponent (normalization X hX) Γ'.1.genericPoint) :
    Θ Γ' = 1 := by
  classical
  set ν := normalization X hX
  set y := Γ'.1.genericPoint
  have hP1 : Order.coheight (normalization X hX y) = 1 := (coheight_normalization_eq hΘ y).trans
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ'.1)
  have hPD : ν y ∈ (doubleIntersectionLocus X : Set X) := hconc.1.1 (subset_closure rfl)
  rw [hΘ.2.2.2 Γ', ite_eq_left hconc, Finset.sum_eq_zero, zero_add]
  intro Γ _
  rw [ite_eq_right]
  intro h
  have hyS := h.1.1 (subset_closure rfl)
  have h3 := eq_of_specializes_of_coheight_eq_one
    (specializes_iff_mem_closure.mpr (closure_preimageSet_diff_subset ν _ _ hyS))
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ.1) hP1
  have hemp : preimageSet ν
      (closure {Γ.1.genericPoint} \ (doubleIntersectionLocus X : Set X)) = ∅ := by
    rw [h3, Set.eq_empty_iff_forall_notMem]
    exact fun z hz => hz.2 (closure_minimal (Set.singleton_subset_iff.mpr hPD)
      (doubleIntersectionLocus X).isClosed hz.1)
  rw [hemp, closure_empty] at hyS
  exact hyS

/-- **Conductor components.** Along a component `Γ'` of the conductor, `t` has a simple pole
and `Θ` has coefficient one, while `L'` is trivial at `Γ'`; so both sides vanish. -/
private theorem exists_order_pullback_normalization_conductor
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    {ωX : X.Modules} (hωX : IsDualizingSheaf sX n ωX)
    {ων : (normalizationScheme X hX).Modules}
    (hων : IsDualizingSheaf (normalization X hX ≫ sX) n ων)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hτ : ∀ V : X.affineOpens,
      letI := ((normalization X hX).app V).hom.toAlgebra
      ∀ φ : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! f : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ a, φ a = τ.app V (a • f))
    {W W' : X.Opens} (s : Γ(ωX, W)) (hW' : W' ≤ W)
    (hs : ∀ η : X, IsGenericOrCodimOneSingular η →
      ∃ (V : X.Opens) (_ : η ∈ V) (hVW : V ≤ W),
        IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hVW).op s))
    (hW'gen : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ∈ W')
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W'))
    (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s)
    (Kν : MMP.Flips.WeilDivisor (normalizationScheme X hX))
    (hKν : ∀ Γ : WeilDivisorPrime (normalizationScheme X hX),
      IsOrderOfSectionAt ων t Γ.1.genericPoint (Kν Γ))
    (m : ℤ) {L : X.CartierDivisor}
    (hLs : ∀ η : X, IsGenericOrCodimOneSingular η → η ∉ cartierSupport L)
    {L' : (normalizationScheme X hX).CartierDivisor} (hL' : IsPullback (normalization X hX) L L')
    (Γ' : WeilDivisorPrime (normalizationScheme X hX))
    (hconc : IsConductorComponent (normalization X hX) Γ'.1.genericPoint) :
    ∃ N : ℤ, IsOrderAlong L' (primeDivisorSubvariety Γ'.1) N ∧
      (N : ℚ) = ((m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero Kν + Θ)) Γ' := by
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : IsReduced X := hΘ.1.2.1
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : IsLocallyNoetherian (normalizationScheme X hX) :=
    LocallyOfFiniteType.isLocallyNoetherian (normalization X hX)
  have : IsReduced (normalizationScheme X hX) := Scheme.isReduced_normalizationScheme X hX
  set y := Γ'.1.genericPoint
  have hP1 : Order.coheight (normalization X hX y) = 1 := (coheight_normalization_eq hΘ y).trans
    (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Γ'.1)
  have hPsing : ¬ IsRegularLocalRing (X.presheaf.stalk (normalization X hX y)) :=
    doubleIntersectionLocus_subset_compl_regularLocus sX (hconc.1.1 (subset_closure rfl))
  -- `𝒪_{X,P}` is seminormal and every point over `P` has codimension one
  have hn : 1 ≤ n := by
    have h := coheight_add_height_eq_of_pure sX n hΘ.1.2.2 (normalization X hX y)
    rw [hP1] at h
    exact_mod_cast (h ▸ le_self_add : (1 : ℕ∞) ≤ n)
  have hSN := isSeminormalHom_stalk_of_isNcInCodimOne hX hn hΘ.2.2.1 hP1 hPsing
  have hfib : ∀ y', normalization X hX y' = normalization X hX y → Order.coheight y' = 1 :=
    fun y' hy' => by rw [← coheight_normalization_eq hΘ y', hy', hP1]
  have hK : Kν Γ' = -1 := isOrderOfSectionAt_unique t (hKν Γ')
    (isOrderOfSectionAt_neg_one_of_isSeminormalHom sX n ωX hωX hX ων hων τ hτ _ hPsing hSN hfib
      s (hs _ (Or.inr ⟨hP1, hPsing⟩)) hW' (fun η hη _ => hW'gen η hη) t ht y rfl)
  -- the pullback is trivial at `Γ'`
  have hfrac : ∀ {Z : Scheme.{0}} (z : Z),
      IsFraction (1 : Z.totalQuotientSheaf.presheaf.stalk z) (1 : Z.presheaf.stalk z) 1 :=
    fun z => ⟨by rw [map_one]; exact isUnit_one, by simp⟩
  have hL1 : IsLocalEquationAt L' y 1 := by
    refine hL'.isLocalEquationAt (isLocalEquationAt_one_of_notMem_cartierSupport
      (hLs _ (Or.inr ⟨hP1, hPsing⟩))) (hfrac _) ?_
    simpa only [map_one] using hfrac y
  refine ⟨0, ordAt_zero_of_isLocalEquationAt_one hL1, ?_⟩
  simp [hK, theta_eq_one_of_isConductorComponent hΘ Γ' hconc]

/-- **Off the conductor.** Along a prime divisor `Γ'` off the conductor, `ν` is an isomorphism
near `Γ'` and `τ` is an isomorphism there, so the order of `L'` along `Γ'` is the order of `L`
along the image, and the coefficients of `Kν` and `Θ` are those of `K` and `Δ`. -/
private theorem exists_order_pullback_normalization_offConductor
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    {ωX : X.Modules} {ων : (normalizationScheme X hX).Modules}
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hτ : ∀ V : X.affineOpens,
      letI := ((normalization X hX).app V).hom.toAlgebra
      ∀ φ : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! f : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ a, φ a = τ.app V (a • f))
    {W W' : X.Opens} (s : Γ(ωX, W)) (hW' : W' ≤ W)
    (K : MMP.Flips.WeilDivisor X)
    (hK : ∀ Γ : WeilDivisorPrime X, IsOrderOfSectionAt ωX s Γ.1.genericPoint (K Γ))
    (hW'gen : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ∈ W')
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W'))
    (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s)
    (Kν : MMP.Flips.WeilDivisor (normalizationScheme X hX))
    (hKν : ∀ Γ : WeilDivisorPrime (normalizationScheme X hX),
      IsOrderOfSectionAt ων t Γ.1.genericPoint (Kν Γ))
    (m : ℤ) {L : X.CartierDivisor} {w : MMP.Flips.WeilDivisor X}
    (hL : IsWeilDivisorOfCartier L (Finsupp.mapDomain Subtype.val w))
    (hw : Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero w =
      (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero K + Δ))
    {L' : (normalizationScheme X hX).CartierDivisor} (hL' : IsPullback (normalization X hX) L L')
    (Γ' : WeilDivisorPrime (normalizationScheme X hX))
    (hconc : ¬ IsConductorComponent (normalization X hX) Γ'.1.genericPoint) :
    ∃ N : ℤ, IsOrderAlong L' (primeDivisorSubvariety Γ'.1) N ∧
      (N : ℚ) = ((m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero Kν + Θ)) Γ' := by
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : IsReduced X := hΘ.1.2.1
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : IsFinite (normalization X hX) :=
    Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
  have : IsLocallyNoetherian (normalizationScheme X hX) :=
    LocallyOfFiniteType.isLocallyNoetherian (normalization X hX)
  obtain ⟨hcoh, hreg⟩ := coheight_and_regular_of_not_isConductorComponent hΘ Γ' hconc
  obtain ⟨U, hU, hiso⟩ :=
    exists_isIso_normalization_restrict_of_isRegularLocalRing (sX := sX) hX hreg
  have := isIso_stalkMap_of_isIso_morphismRestrict (normalization X hX) U Γ'.1.genericPoint hU
  obtain ⟨ΓP, hgp, hΓPdvr⟩ := exists_prime_over_of_isIso (normalization X hX) Γ'.1.genericPoint
    Γ'.1 rfl hcoh Γ'.2
  let ΓW : WeilDivisorPrime X := ⟨ΓP, hΓPdvr⟩
  have hLΓ := hL ΓP
  rw [show MMP.Mori.DivisorWithCoeffs.coeff (Finsupp.mapDomain Subtype.val w) ΓP = w ΓW from
    Finsupp.mapDomain_apply_of_injective Subtype.val_injective w ΓW] at hLΓ
  refine ⟨w ΓW, isOrderAlong_pullback_prime hL' Γ'.1.genericPoint Γ'.1 rfl ΓP hgp hLΓ, ?_⟩
  -- the canonical coefficients agree, as `τ` is an isomorphism over `U`
  have hKP := hK ΓW
  rw [show ΓW.1.genericPoint = _ from hgp] at hKP
  have hKΓ : Kν Γ' = K ΓW := isOrderOfSectionAt_eq_of_isIso (normalization X hX) U τ
    (fun V hV hVU => tau_app_surjective (normalization X hX) U τ hτ hV hVU)
    hW' s t ht (fun η hη _ => hW'gen η hη) hU (hKν Γ') hKP
  have h1 := congrArg (fun v => v ΓW) hw
  simp only [Finsupp.mapRange_apply, Finsupp.smul_apply, Finsupp.add_apply, smul_eq_mul] at h1 ⊢
  rw [h1, hKΓ, theta_eq_delta_of_not_isConductorComponent hΘ Γ' hconc ΓW hgp hreg]

private theorem isWeilDivisorOfCartier_of_isPullback_normalization
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ)
    {ωX : X.Modules} (hωX : IsDualizingSheaf sX n ωX)
    {ων : (normalizationScheme X hX).Modules}
    (hων : IsDualizingSheaf (normalization X hX ≫ sX) n ων)
    (τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX)
    (hτ : ∀ V : X.affineOpens,
      letI := ((normalization X hX).app V).hom.toAlgebra
      ∀ φ : Γ(normalizationScheme X hX, normalization X hX ⁻¹ᵁ V) →ₗ[Γ(X, V)] Γ(ωX, V),
        ∃! f : Γ(ων, normalization X hX ⁻¹ᵁ V), ∀ a, φ a = τ.app V (a • f))
    {W W' : X.Opens} (s : Γ(ωX, W)) (hW' : W' ≤ W)
    (hs : ∀ η : X, IsGenericOrCodimOneSingular η →
      ∃ (V : X.Opens) (_ : η ∈ V) (hVW : V ≤ W),
        IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hVW).op s))
    (K : MMP.Flips.WeilDivisor X)
    (hK : ∀ Γ : WeilDivisorPrime X, IsOrderOfSectionAt ωX s Γ.1.genericPoint (K Γ))
    (hW'gen : ∀ η : X, closure {η} ∈ irreducibleComponents X → η ∈ W')
    (t : Γ(ων, normalization X hX ⁻¹ᵁ W'))
    (ht : τ.app W' t = ωX.presheaf.map (homOfLE hW').op s)
    (Kν : MMP.Flips.WeilDivisor (normalizationScheme X hX))
    (hKν : ∀ Γ : WeilDivisorPrime (normalizationScheme X hX),
      IsOrderOfSectionAt ων t Γ.1.genericPoint (Kν Γ))
    (m : ℤ) (L : X.CartierDivisor) (w : MMP.Flips.WeilDivisor X)
    (hL : IsWeilDivisorOfCartier L (Finsupp.mapDomain Subtype.val w))
    (hLs : ∀ η : X, IsGenericOrCodimOneSingular η → η ∉ cartierSupport L)
    (hw : Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero w =
      (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero K + Δ))
    (L' : (normalizationScheme X hX).CartierDivisor) (hL' : IsPullback (normalization X hX) L L') :
    ∃ w' : MMP.Flips.WeilDivisor (normalizationScheme X hX),
      IsWeilDivisorOfCartier L' (Finsupp.mapDomain Subtype.val w') ∧
      Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero w' =
        (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero Kν + Θ) := by
  classical
  set target := (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero Kν + Θ)
  have hex : ∀ Γ', ∃ N : ℤ, IsOrderAlong L' (primeDivisorSubvariety Γ'.1) N ∧
      (N : ℚ) = target Γ' := fun Γ' => by
    by_cases hc : IsConductorComponent (normalization X hX) Γ'.1.genericPoint
    · exact exists_order_pullback_normalization_conductor hΘ hωX hων τ hτ s hW' hs hW'gen t ht
        Kν hKν m hLs hL' Γ' hc
    · exact exists_order_pullback_normalization_offConductor hΘ τ hτ s hW' K hK hW'gen t ht
        Kν hKν m hL hw hL' Γ' hc
  choose f hf1 hf2 using hex
  have hsupp : ∀ Γ', f Γ' ≠ 0 → Γ' ∈ target.support := by
    intro Γ' h
    rw [Finsupp.mem_support_iff, ← hf2 Γ']
    exact_mod_cast h
  refine ⟨Finsupp.onFinset target.support f hsupp, ?_, ?_⟩
  · intro P
    have hP := isDVR_localRing_normalization hΘ P
    have := Finsupp.mapDomain_apply_of_injective (Subtype.val_injective (p := fun Γ : MMP.Mori.PrimeDivisor
      (normalizationScheme X hX) => ∃ _ : IsDomain Γ.localRing, IsDiscreteValuationRing
          Γ.localRing))
      (Finsupp.onFinset target.support f hsupp) (⟨P, hP⟩ : WeilDivisorPrime _)
    change IsOrderAlong L' (primeDivisorSubvariety P)
      ((Finsupp.mapDomain Subtype.val (Finsupp.onFinset target.support f hsupp)) P)
    rw [this]
    exact hf1 ⟨P, hP⟩
  · ext Γ'
    rw [Finsupp.mapRange_apply, Finsupp.onFinset_apply]
    exact hf2 Γ'

section Duality

private lemma nonempty_restrict_dualizingModuleOverField_iso {k : Type u} [Field k]
    {X : Scheme.{u}} {π : X ⟶ Spec (.of k)}
    {Xbar : Scheme.{u}} (j : X ⟶ Xbar) [IsOpenImmersion j] (πbar : Xbar ⟶ Spec (.of k))
    [IsProper πbar] (hjp : j ≫ πbar = π) [IsNoetherian X] [LocallyOfFiniteType π] (d : ℕ) :
    Nonempty ((Scheme.Modules.restrictFunctor j).obj
        (Stacks.Duality.dualizingModuleOverField πbar d) ≅
      (DerivedCategory.homologyFunctor X.Modules (-(d : ℤ))).obj
        (normalizedDualizingComplexOverField π).complex.obj.obj) := by
  subst hjp
  have : IsSeparated (j ≫ πbar) := inferInstance
  have : QuasiCompact (j ≫ πbar) := inferInstance
  let hps := Stacks.Duality.isShriekable_of_field (j ≫ πbar)
  let c : CompactificationOf (Over.mk (j ≫ πbar)) :=
    ⟨StructuredArrow.mk (Y := Over.mk πbar) (Over.homMk j rfl),
      ⟨(inferInstance : IsOpenImmersion j), (inferInstance : IsProper πbar)⟩⟩
  let e1 := Stacks.Duality.NormalizedOnOpens.isoUpperShriekPlusNagata
    (hp := isFiniteTypeOverNoetherian_of_field (j ≫ πbar))
    (Stacks.Duality.isDualizingComplex_derivedStructureSheafPlus_of_field k) hps
    (Stacks.Duality.normalizedDualizingComplex (isFiniteTypeOverNoetherian_of_field (j ≫ πbar)) _
      (Stacks.Duality.isDualizingComplex_derivedStructureSheafPlus_of_field k)) c
  let e1' := (ObjectProperty.ι _).mapIso ((ObjectProperty.ι _).mapIso e1)
  let e2 : (Stacks.Duality.quasiCoherentDerivedPullback' j).obj
      (Stacks.Duality.dualizingComplexOverField πbar) ≅ _ :=
    ((Stacks.Duality.restrictedDerivedRestrictIsoQuasiCoherentDerivedPullback j).app _).symm
  let e3 := (ObjectProperty.ι _).mapIso e2
  have e4 := (Scheme.Modules.restrictFunctor j).mapDerivedCategoryHomologyIso (-(d : ℤ))
  exact ⟨((e4.app (Stacks.Duality.dualizingComplexOverField πbar).obj).symm ≪≫
    (DerivedCategory.homologyFunctor X.Modules (-(d : ℤ))).mapIso (e3.symm ≪≫ e1'.symm))⟩

/-- `H⁰(ω_X^•[-d])` is a dualizing sheaf of a separated scheme of finite type and pure
dimension `d` over `k`. -/
private theorem isDualizingSheaf_homologyFunctor_zero_shift {k : Type u} [Field k]
    {X : Scheme.{u}} (π : X ⟶ Spec (.of k))
    [IsNoetherian X] [LocallyOfFiniteType π] [IsSeparated π] [QuasiCompact π] (d : ℕ)
    (hd : ∀ Z ∈ irreducibleComponents X, topologicalKrullDim Z = d) :
    IsDualizingSheaf π d ((DerivedCategory.homologyFunctor X.Modules 0).obj
      ((normalizedDualizingComplexOverField π).complex.obj⟦(-(d : ℤ))⟧).obj) := by
  obtain ⟨c, -⟩ := hasCompactification_of_compactSpace_quasiSeparatedSpace π
  let j : X ⟶ c.space := c.immersion
  haveI : IsOpenImmersion j := c.2.1
  haveI := c.2.2
  have hjp : j ≫ c.obj.right.hom = π := Over.w c.obj.hom
  obtain ⟨e'⟩ := nonempty_restrict_dualizingModuleOverField_iso j _ hjp d
  let K := (normalizedDualizingComplexOverField π).complex.obj
  refine ⟨hd, c.space, j, inferInstance, _, c.2.2, hjp, ⟨?_⟩⟩
  exact (DerivedCategory.homologyFunctor X.Modules 0).mapIso
      (((ObjectProperty.ι _).commShiftIso (-(d : ℤ))).app K) ≪≫
    ((DerivedCategory.homologyFunctor X.Modules 0).shiftIso (-(d : ℤ)) 0 (-(d : ℤ))
      (by simp)).app K.obj ≪≫ e'.symm

/-- A complex with no cohomology below `-n` lies in degrees `≥ 0` after the shift by `-n`. -/
private theorem isGE_zero_shift {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    (K : DerivedCategory C) (n : ℤ)
    (h : ∀ i < -n, Limits.IsZero ((DerivedCategory.homologyFunctor C i).obj K)) :
    (K⟦-n⟧).IsGE 0 := by
  rw [DerivedCategory.isGE_iff]
  intro i hi
  exact (h (-n + i) (by omega)).of_iso 
    (((DerivedCategory.homologyFunctor C 0).shiftIso (-n) i (-n + i) rfl).app K)

open Stacks.Duality Stacks.Duality.FiniteTrace Stacks.Duality.OpenImmersion in
/-- **Affine-local duality for the trace of a finite morphism.** For `g : Y ⟶ X` finite (proper
and affine) between Noetherian schemes, `E ∈ D^{≥0}` bounded below with `a(E) ∈ D^{≥0}`, and `U`
affine, every `Γ(X, U)`-linear map `Γ(Y, g⁻¹U) → Γ(U, H⁰E)` is `b ↦ t_E(b · m)` for exactly one
section `m` of `H⁰(a(E))` over `g⁻¹U`. This is `Stacks.Duality.FiniteTrace.exists_trace_smul_eq`
and `Stacks.Duality.FiniteTrace.eq_of_trace_smul_eq`, there proved at `E = 𝒪_X`, with the same
proof at an arbitrary `E`. -/
private theorem existsUnique_trace_smul_eq {X Y : Scheme.{u}} (g : Y ⟶ X) [IsProper g]
    [AlgebraicGeometry.IsNoetherian X] [AlgebraicGeometry.IsNoetherian Y] [IsAffineHom g]
    [QuasiCompact g] [QuasiSeparated g] [QuasiSeparatedSpace X] [QuasiSeparatedSpace Y]
    (E : quasiCoherentDerivedCategory X) [E.obj.IsGE 0] [((FiniteTrace.twisted g).obj E).obj.IsGE 0]
    (hE : DerivedCategoryB.IsBoundedBelow E.obj) (U : X.Opens) (hU : IsAffineOpen U)
    (l : Γ((Scheme.Modules.pushforward g).obj (SheafOfModules.unit Y.ringCatSheaf), U) →ₗ[Γ(X, U)]
      Γ((DerivedCategory.homologyFunctor X.Modules 0).obj E.obj, U)) :
    ∃! m : Γ(zeroTwisted g E, g ⁻¹ᵁ U),
      ∀ b : Γ(Y, g ⁻¹ᵁ U), (trace (g := g) E).app U (b • m) = l b := by
  haveI : IsLocallyNoetherian X := ‹AlgebraicGeometry.IsNoetherian X›.toIsLocallyNoetherian
  haveI : IsLocallyNoetherian Y := ‹AlgebraicGeometry.IsNoetherian Y›.toIsLocallyNoetherian
  haveI : IsLocallyNoetherian U := isLocallyNoetherian_of_isOpenImmersion U.ι
  haveI : QuasiSeparatedSpace U := IsLocallyNoetherian.quasiSeparatedSpace
  haveI : IsLocallyNoetherian (g ⁻¹ᵁ U) := isLocallyNoetherian_of_isOpenImmersion (g ⁻¹ᵁ U).ι
  haveI : QuasiSeparatedSpace (g ⁻¹ᵁ U) := IsLocallyNoetherian.quasiSeparatedSpace
  haveI : QuasiSeparated U.ι := (quasiSeparated_iff_quasiSeparatedSpace _).2 ‹_›
  haveI : QuasiSeparated (g ⁻¹ᵁ U).ι := (quasiSeparated_iff_quasiSeparatedSpace _).2 ‹_›
  let E' := (pushU U).obj ((restrictU U).obj E)
  let η : E ⟶ E' := (adjU U).unit.app E
  haveI hR : ((restrictU U).obj E).obj.IsGE 0 :=
    @isGE_derivedRestrict_obj _ _ _ _ _ 0 ‹E.obj.IsGE 0›
  haveI hE' : E'.obj.IsGE 0 := @isGE_derivedPushforward_obj' _ _ _ _ 0 hR
  haveI hRM : IsIso ((restrictionMap g U).app E) :=
    isIso_twistedInverseImageRestrictionMap_app_of_isProper _ _ _ _ (isPullback_restrict g U) E hE
  haveI hTR : ((FiniteTrace.twisted (g ∣_ U)).obj ((restrictU U).obj E)).obj.IsGE 0 := by
    have : DerivedCategory.TStructure.t.IsGE ((ObjectProperty.ι _).obj ((restrictV g U).obj
        ((FiniteTrace.twisted g).obj E))) 0 :=
      @isGE_derivedRestrict_obj _ _ _ _ _ 0 ‹_›
    exact @Triangulated.TStructure.isGE_of_iso _ _ _ _ _ _ _ DerivedCategory.TStructure.t _ _
      ((ObjectProperty.ι _).mapIso (asIso ((restrictionMap g U).app E))) 0 this
  haveI hTE' : ((FiniteTrace.twisted g).obj E').obj.IsGE 0 := by
    have : DerivedCategory.TStructure.t.IsGE ((ObjectProperty.ι _).obj
        ((FiniteTrace.twisted (g ∣_ U) ⋙ quasiCoherentDerivedPushforward (g ⁻¹ᵁ U).ι
          (isQuasicoherent_homology_derivedPushforward_of_qcqs _)).obj
            ((restrictU U).obj E))) 0 :=
      @isGE_derivedPushforward_obj' _ _ _ _ 0 hTR
    exact @Triangulated.TStructure.isGE_of_iso _ _ _ _ _ _ _ DerivedCategory.TStructure.t _ _
      ((ObjectProperty.ι _).mapIso (asIso ((baseChangeMap g U).app ((restrictU U).obj E)))) 0 this
  -- `(j')^* H⁰(a(η))` is invertible
  have hRV : IsIso ((restrictV g U).map ((FiniteTrace.twisted g).map η)) :=
    (isIso_twistedInverseImageRestrictionMap_app_iff (g ⁻¹ᵁ U).ι (g ∣_ U) g U.ι
      (isQuasicoherent_homology_derivedPushforward_of_qcqs _)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs _)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs _)
      (isQuasicoherent_homology_derivedPushforward_of_qcqs _) (isPullback_restrict g U) _).1
      (isIso_twistedInverseImageRestrictionMap_app_of_isProper (g ⁻¹ᵁ U).ι (g ∣_ U) g U.ι
        (isPullback_restrict g U) E hE)
  let hη := (DerivedCategory.homologyFunctor Y.Modules 0).map ((FiniteTrace.twisted g).map η).hom
  let κ := (DerivedCategory.homologyFunctor X.Modules 0).map η.hom
  have hbij_hη : Function.Bijective (hη.app (g ⁻¹ᵁ U)) := by
    have h₁ : IsIso ((derivedRestrict (g ⁻¹ᵁ U).ι).map ((FiniteTrace.twisted g).map η).hom) :=
      inferInstanceAs (IsIso ((ObjectProperty.ι _).map
        ((restrictV g U).map ((FiniteTrace.twisted g).map η))))
    have h₂ : IsIso ((DerivedCategory.homologyFunctor _ 0).map
        ((derivedRestrict (g ⁻¹ᵁ U).ι).map ((FiniteTrace.twisted g).map η).hom)) := inferInstance
    have : IsIso ((Scheme.Modules.restrictFunctor (g ⁻¹ᵁ U).ι).map hη) :=
      (NatIso.isIso_map_iff
        ((Scheme.Modules.restrictFunctor (g ⁻¹ᵁ U).ι).mapDerivedCategoryHomologyIso 0) _).1 h₂
    exact bijective_app_of_isIso_restrict _ _
  have hbij_κ : Function.Bijective (κ.app U) := by
    have h₁ : η.hom = (derivedRestrictPushforwardAdjunction U.ι).unit.app E.obj :=
      map_liftDerivedRestrictPushforwardAdjunction_unit_app U.ι _ _ _ _ _
    have h₂ : IsIso ((DerivedCategory.homologyFunctor _ 0).map
        ((derivedRestrict U.ι).map η.hom)) := by
      rw [h₁]
      have := isIso_derivedRestrict_map_unit_app U.ι E.obj
      infer_instance
    have : IsIso ((Scheme.Modules.restrictFunctor U.ι).map κ) :=
      (NatIso.isIso_map_iff
        ((Scheme.Modules.restrictFunctor U.ι).mapDerivedCategoryHomologyIso 0) _).1 h₂
    exact bijective_app_of_isIso_restrict _ _
  have hunitE : IsIso ((Scheme.Modules.restrictAdjunction U.ι).unit.app
      ((DerivedCategory.homologyFunctor X.Modules 0).obj E'.obj)) :=
    isIso_restrictAdjunction_unit_of_iso U (homologyPushforwardIso U ((restrictU U).obj E).obj)
  have hunitP : IsIso ((Scheme.Modules.restrictAdjunction (g ⁻¹ᵁ U).ι).unit.app
      (zeroTwisted g E')) :=
    isIso_restrictAdjunction_unit_of_iso (g ⁻¹ᵁ U)
      ((DerivedCategory.homologyFunctor Y.Modules 0).mapIso ((ObjectProperty.ι _).mapIso (asIso
        ((baseChangeMap g U).app ((restrictU U).obj E)))).symm ≪≫
        homologyPushforwardIso (g ⁻¹ᵁ U)
          ((FiniteTrace.twisted (g ∣_ U)).obj ((restrictU U).obj E)).obj)
  have hnat := trace_naturality (g := g) E E' η
  have hV : IsAffineOpen (g ⁻¹ᵁ U) := hU.preimage g
  have key : ∀ (b : Γ(Y, g ⁻¹ᵁ U)) (n : Γ(zeroTwisted g E, g ⁻¹ᵁ U)),
      (trace (g := g) E').app U (b • hη.app (g ⁻¹ᵁ U) n) =
        κ.app U ((trace (g := g) E).app U (b • n)) := by
    intro b n
    have e₁ := congrArg (fun χ => χ.app U (b • n)) hnat
    simp only [Scheme.Modules.Hom.comp_app] at e₁
    change (trace (g := g) E').app U (hη.app (g ⁻¹ᵁ U) (b • n)) = κ.app U _ at e₁
    rw [Scheme.Modules.Hom.app_smul] at e₁
    exact e₁
  have : (zeroTwisted g E').IsQuasicoherent := ((FiniteTrace.twisted g).obj E').2 0
  have : ((DerivedCategory.homologyFunctor X.Modules 0).obj E'.obj).IsQuasicoherent := E'.2 0
  refine existsUnique_of_exists_of_unique ?_ ?_
  · obtain ⟨φ, hφ⟩ := Stacks.AlgebraicGeometry.exists_hom_app_affineOpen_of_isIso_unit U hU
      hunitE ((appLinear κ U).comp l)
    obtain ⟨ψ, hψ⟩ := (bijective_dualityMap (g := g) E' (SheafOfModules.unit Y.ringCatSheaf)).2 φ
    obtain ⟨m, hm⟩ := hbij_hη.2 (ψ.app (g ⁻¹ᵁ U) (unitOne _))
    refine ⟨m, fun b => hbij_κ.1 ?_⟩
    calc κ.app U ((trace (g := g) E).app U (b • m))
        = (trace (g := g) E').app U (b • hη.app (g ⁻¹ᵁ U) m) := (key b m).symm
      _ = (trace (g := g) E').app U (b • ψ.app (g ⁻¹ᵁ U) (unitOne _)) :=
          congrArg (fun z : Γ(zeroTwisted g E', g ⁻¹ᵁ U) => (trace (g := g) E').app U (b • z)) hm
      _ = (trace (g := g) E').app U (ψ.app (g ⁻¹ᵁ U) b) :=
          congrArg ((trace (g := g) E').app U) (app_eq_smul_app_one ψ _ b).symm
      _ = (dualityMap (g := g) E' ψ).app U b := (dualityMap_app_eq g U E' ψ b).symm
      _ = φ.app U b := by rw [hψ]
      _ = κ.app U (l b) :=
          (hφ b).trans ((LinearMap.comp_apply _ _ _).trans (appLinear_apply κ U _))
  · intro m m₀ hm hm₀
    obtain ⟨φ₁, hφ₁⟩ := Stacks.AlgebraicGeometry.exists_hom_app_affineOpen_of_isIso_unit
      (g ⁻¹ᵁ U) hV hunitP (N := SheafOfModules.unit Y.ringCatSheaf)
      (LinearMap.toSpanSingleton Γ(Y, g ⁻¹ᵁ U) _ (hη.app (g ⁻¹ᵁ U) m))
    obtain ⟨φ₂, hφ₂⟩ := Stacks.AlgebraicGeometry.exists_hom_app_affineOpen_of_isIso_unit
      (g ⁻¹ᵁ U) hV hunitP (N := SheafOfModules.unit Y.ringCatSheaf)
      (LinearMap.toSpanSingleton Γ(Y, g ⁻¹ᵁ U) _ (hη.app (g ⁻¹ᵁ U) m₀))
    have hdφ : dualityMap (g := g) E' φ₁ = dualityMap (g := g) E' φ₂ := by
      refine Stacks.AlgebraicGeometry.hom_ext_of_app_affineOpen_of_isIso_unit U hU hunitE
        fun b => ?_
      refine (dualityMap_app_eq g U E' φ₁ b).trans
        (Eq.trans ?_ (dualityMap_app_eq g U E' φ₂ b).symm)
      refine (congrArg _ (hφ₁ b)).trans (Eq.trans ?_ (congrArg _ (hφ₂ b)).symm)
      exact (key b m).trans ((congrArg (κ.app U) ((hm b).trans (hm₀ b).symm)).trans
        (key b m₀).symm)
    have hφ : φ₁ = φ₂ :=
      (bijective_dualityMap (g := g) E' (SheafOfModules.unit Y.ringCatSheaf)).1 hdφ
    have h₃ := (hφ₁ (unitOne _)).symm.trans
      ((congrArg (fun φ => φ.app (g ⁻¹ᵁ U) (unitOne _)) hφ).trans (hφ₂ (unitOne _)))
    have h₄ : hη.app (g ⁻¹ᵁ U) m = hη.app (g ⁻¹ᵁ U) m₀ := by
      have e₁ := LinearMap.toSpanSingleton_apply_one Γ(Y, g ⁻¹ᵁ U) _ (hη.app (g ⁻¹ᵁ U) m)
      have e₂ := LinearMap.toSpanSingleton_apply_one Γ(Y, g ⁻¹ᵁ U) _ (hη.app (g ⁻¹ᵁ U) m₀)
      exact e₁.symm.trans (h₃.trans e₂)
    exact hbij_hη.1 h₄

end Duality

/-- **The conductor formula** (FA 12.2.2). Let `X` be an `S₂` complex `n`-fold with at worst
double normal crossings in codimension one, `ν : X^ν ⟶ X` its normalization, `Δ` a `ℚ`-Weil
divisor on `X` and `Θ = ν⁻¹_*Δ + D^ν` (`MMP.Flips.IsBoundaryOfNormalization`). Let
`ω_X = H^{-n}(ω_X^•)`, `ω_{X^ν} = H^{-n}(ω_{X^ν}^•)` for the dualizing complexes normalized
relative to `ℂ`, and `Tr_ν : ν_*ω_{X^ν} ⟶ ω_X` the trace of `ν`. Let `s ∈ ω_X(W)` generate `ω_X`
at the generic points and the codimension-one singular points of `X`, and `K_X = div(s)`. If `L`
is a Cartier divisor on `X` with Weil divisor `m(K_X + Δ)` and with a unit local equation at the
generic points and the codimension-one singular points of `X` (so that `L` is the divisor of `s^m`
there), then the trace is defined, and for every `t ∈ ω_{X^ν}(ν⁻¹W')` with `Tr_ν(t) = s|_{W'}`,
`W' ⊆ W` an open containing the generic points, and `K_{X^ν} = div(t)`: `L` has a pull-back along
`ν`, and every pull-back `ν^*L` has Weil divisor `m(K_{X^ν} + Θ)`. -/
@[mmp "lem_mmp_surface_normalization_conductor_formula"]
public theorem IsBoundaryOfNormalization.isWeilDivisorOfCartier_pullback
    {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite}
    {Δ : QWeilDivisor X} {Θ : QWeilDivisor (normalizationScheme X hX)}
    (hΘ : IsBoundaryOfNormalization sX n hX Δ Θ) :
    haveI : LocallyOfFiniteType sX := hΘ.1.1.2.1
    haveI : QuasiCompact sX := hΘ.1.1.2.2
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
    haveI : IsNoetherian X := {}
    haveI : IsFinite (normalization X hX) :=
      Scheme.isFinite_normalization (isNagataScheme_of_locallyOfFiniteType_over_field ℂ sX) hX
    haveI : IsLocallyNoetherian (normalizationScheme X hX) :=
      LocallyOfFiniteType.isLocallyNoetherian (normalization X hX ≫ sX)
    haveI : CompactSpace (normalizationScheme X hX) :=
      QuasiCompact.compactSpace_of_compactSpace (normalization X hX ≫ sX)
    haveI : IsNoetherian (normalizationScheme X hX) := {}
    haveI : QuasiSeparatedSpace X := IsLocallyNoetherian.quasiSeparatedSpace
    haveI : QuasiSeparatedSpace (normalizationScheme X hX) :=
      IsLocallyNoetherian.quasiSeparatedSpace
    letI := (Stacks.Duality.FiniteTrace.twistedAdj (normalization X hX)).rightAdjointCommShift ℤ
    -- the dualizing complexes `ω_X^•`, `ω_{X^ν}^•` normalized relative to `ℂ`, shifted by `-n`
    let E := (normalizedDualizingComplexOverField sX).complex.obj⟦(-(n : ℤ))⟧
    let Eν :=
      (normalizedDualizingComplexOverField (normalization X hX ≫ sX)).complex.obj⟦(-(n : ℤ))⟧
    -- `a(ω_X^•[-n]) ≅ ω_{X^ν}^•[-n]` ([Stacks, Tag 0AUD])
    let e : (Stacks.Duality.FiniteTrace.twisted (normalization X hX)).obj E ≅ Eν :=
      ((Stacks.Duality.FiniteTrace.twisted (normalization X hX)).commShiftIso (-(n : ℤ))).app _ ≪≫
        (shiftFunctor _ (-(n : ℤ))).mapIso
          (Stacks.Duality.NormalizedOnOpens.twistedInverseImageObjIsoNagata rfl
            (Stacks.Duality.isDualizingComplex_derivedStructureSheafPlus_of_field ℂ)
            (normalizedDualizingComplexOverField (normalization X hX ≫ sX))
            (normalizedDualizingComplexOverField sX))
    -- the dualizing sheaves `ω_X = H^{-n}(ω_X^•)` and `ω_{X^ν} = H^{-n}(ω_{X^ν}^•)`
    let ωX := (DerivedCategory.homologyFunctor X.Modules 0).obj E.obj
    let ων := (DerivedCategory.homologyFunctor (normalizationScheme X hX).Modules 0).obj Eν.obj
    ∀ {W W' : X.Opens} (s : Γ(ωX, W)) (hW' : W' ≤ W),
    (∀ η : X, IsGenericOrCodimOneSingular η →
      ∃ (V : X.Opens) (_ : η ∈ V) (hVW : V ≤ W),
        IsLocalGenerator ωX (ωX.presheaf.map (homOfLE hVW).op s)) →
    ∀ (K : WeilDivisor X),
    (∀ Γ : WeilDivisorPrime X, IsOrderOfSectionAt ωX s Γ.1.genericPoint (K Γ)) →
    (∀ η : X, closure {η} ∈ irreducibleComponents X → η ∈ W') →
    ∀ (m : ℤ) (L : X.CartierDivisor) (w : WeilDivisor X),
    IsWeilDivisorOfCartier L (Finsupp.mapDomain Subtype.val w) →
    (∀ η : X, IsGenericOrCodimOneSingular η → η ∉ cartierSupport L) →
    Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero w =
      (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero K + Δ) →
    ∃ _ : ((Stacks.Duality.FiniteTrace.twisted (normalization X hX)).obj E).obj.IsGE 0,
      -- the trace `Tr_ν : ν_*ω_{X^ν} ⟶ ω_X`
      let τ : (Scheme.Modules.pushforward (normalization X hX)).obj ων ⟶ ωX :=
        (Scheme.Modules.pushforward (normalization X hX)).map
            ((DerivedCategory.homologyFunctor _ 0).map e.inv.hom) ≫
          Stacks.Duality.FiniteTrace.trace E
      ∀ (t : Γ(ων, normalization X hX ⁻¹ᵁ W')),
      τ.app W' t = ωX.presheaf.map (homOfLE hW').op s →
      ∀ (Kν : WeilDivisor (normalizationScheme X hX)),
      (∀ Γ : WeilDivisorPrime (normalizationScheme X hX),
        IsOrderOfSectionAt ων t Γ.1.genericPoint (Kν Γ)) →
      (∃ L' : (normalizationScheme X hX).CartierDivisor, IsPullback (normalization X hX) L L') ∧
        ∀ L' : (normalizationScheme X hX).CartierDivisor, IsPullback (normalization X hX) L L' →
          ∃ w' : WeilDivisor (normalizationScheme X hX),
            IsWeilDivisorOfCartier L' (Finsupp.mapDomain Subtype.val w') ∧
            Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero w' =
              (m : ℚ) • (Finsupp.mapRange (Int.cast : ℤ → ℚ) Int.cast_zero Kν + Θ) := by
  have : IsSeparated sX := hΘ.1.1.1
  have : LocallyOfFiniteType sX := hΘ.1.1.2.1
  have : QuasiCompact sX := hΘ.1.1.2.2
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
