module

public import MMP.AlgebraicGeometry.Divisor.SectionZeroDivisorReduced
public import MMP.AlgebraicGeometry.Singularities.Snc.RelativeSncOfSnc
public import MMP.AlgebraicGeometry.Singularities.Snc.LocalEquations
public import MMP.AlgebraicGeometry.Resolution.SNCPullback
public import MMP.AlgebraicGeometry.Morphisms.Smooth.SmoothFlagParameters
public import MMP.AlgebraicGeometry.Morphisms.Smooth.RegularParameters
public import StacksFrontier.AlgebraicGeometry.Properties.NormalConnectedIntegral

/-!
# The divisor of zeros of a section with smooth zero scheme is simple normal crossing

Let `f : X ⟶ Spec K` be a smooth integral scheme over a perfect field, `L` an invertible
`𝒪_X`-module, `s` a nonzero global section of `L^{⊗ m}` whose zero scheme `Z(s)` is smooth over
`K`, and `D` the divisor of zeros of `s`. Then `D` is a simple normal crossing divisor.

At a point `x ∈ Z(s)`, the ideal of `Z(s)` in `𝒪_{X,x}` is generated by one nonzero element `g`
(`Z(s)` is an effective Cartier divisor) and `𝒪_{X,x} / (g)` is regular (`Z(s)` is smooth) of
dimension `dim 𝒪_{X,x} - 1`, so `g` is part of a regular system of parameters. In particular
`(g)` is a prime of height one, and it is the ideal of every prime divisor `E ⊆ Z(s)` through
`x`: that ideal is a height-one prime containing `(g)`. So exactly one component of `D` passes
through `x`, its ideal is generated by a parameter, and every component of `D` is smooth.

Over `ℂ`, with `f` smooth of relative dimension `d`, the divisor `D` is then a relative simple
normal crossing divisor, since its nonzero coefficients are `1`.

## Main results

* `MMP.LcBpf.IsSectionDivisor.isSNC_of_smooth`: `D` is snc.
* `MMP.LcBpf.isRelativeSNC_of_smooth_zeroScheme`: over `ℂ`, `D` is relative snc.
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry MMP.Mori
open Stacks.EnriquesSeveriZariski Stacks.Ample

universe u

namespace MMP.LcBpf

section SNC

variable {X : Scheme.{u}} [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X] [CompactSpace X]

/-- **The divisor of zeros of a section with smooth zero scheme is snc.** -/
theorem IsSectionDivisor.isSNC_of_smooth {K : Type u} [Field K] [PerfectField K]
    (f : X ⟶ Spec (.of K)) [Smooth f] {L : X.Modules} [IsInvertibleModule X L]
    {m : ℕ} {s : Γ(tensorPowModule X L (m : ℤ), ⊤)} (hs : s ≠ 0) {D : Divisor X}
    (hD : IsSectionDivisor L s D)
    (hsm : Smooth ((@AlgebraicGeometry.zeroScheme X _
      (isInvertibleModule_tensorPowModule X L (m : ℤ)) s).subschemeι ≫ f)) :
    D.IsSNC f := by
  have : SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (tensorPowModule X L (m : ℤ)) := isInvertibleModule_tensorPowModule X L _
  set Z : X.IdealSheafData := AlgebraicGeometry.zeroScheme X _ s with hZdef
  have hZ : IsSmoothScheme (Z.subschemeι ≫ f) := (isSmoothScheme_iff _).2 hsm
  have hcart : Stacks.Divisors.IsEffectiveCartierDivisor Z :=
    isEffectiveCartierDivisor_zeroScheme_of_ne_zero _ s hs
  have hsupp := hD.coe_supp_eq_support_zeroScheme
  have hEZ : ∀ E ∈ D.support, E.support ⊆ (Z.support : Set X) := fun E hE => by
    rw [← hsupp]
    exact DivisorWithCoeffs.support_subset_supp (Finsupp.mem_support_iff.mp hE)
  -- at a point of `Z(s)`, its local equation is a parameter cutting out every component
  have key : ∀ x ∈ (Z.support : Set X), ∃ (n : ℕ) (z : Fin n → X.presheaf.stalk x) (i : Fin n),
      IsRegularSystemOfParameters z ∧ ∀ E ∈ D.support, x ∈ E.support →
        IdealSheafData.stalk E.idealSheaf x = Ideal.span {z i} := by
    intro x hx
    have := isRegularLocalRing_stalk_of_smooth_over_field f x
    have := IsRegularLocalRing.isDomain (X.presheaf.stalk x)
    obtain ⟨V, hxV, a, ha, hVa⟩ := Stacks.CartierAffineLocal.exists_affineOpen_isRegular Z hcart x
    set g := (X.presheaf.germ V.1 x hxV).hom a
    have hZx : IdealSheafData.stalk Z x = Ideal.span {g} := by
      rw [IdealSheafData.stalk_eq_map_germ _ x V hxV, hVa, Ideal.map_span, Set.image_singleton]
    have hg0 : g ≠ 0 := by
      have : Nonempty V.1 := ⟨⟨x, hxV⟩⟩
      have : IsDomain Γ(X, V.1) := IsIntegral.component_integral V.1
      intro h0
      refine ha.ne_zero ?_
      exact (germ_injective_of_isIntegral X x hxV) (h0.trans (map_zero _).symm)
    have hgm : g ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      have hne : IdealSheafData.stalk Z x ≠ ⊤ := fun htop =>
        ((AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_notMem_support _ _).mp htop) hx
      exact IsLocalRing.le_maximalIdeal hne (hZx ▸ Ideal.mem_span_singleton_self _)
    have hreg := MMP.Flips.ResolutionInputs.isRegularLocalRing_quotient_stalk f Z hZ hx
    rw [hZx] at hreg
    have hdim := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hg0) hgm
    obtain ⟨M, t, ht⟩ := (MMP.Flips.ResolutionInputs.isRegularLocalRing_quotient_and_add_eq_iff
      (fun _ : Fin 1 => g)).mp ⟨by rwa [Set.range_const], by
        rw [Set.range_const]; exact_mod_cast hdim⟩
    set z := Fin.append (fun _ : Fin 1 => g) t
    have hzi : z (Fin.castAdd M 0) = g := by simp [z]
    refine ⟨_, z, Fin.castAdd M 0, ht, fun E hE hxE => ?_⟩
    rw [hzi]
    have hprime := MMP.Intersection.prime_of_isRegularSystemOfParameters ht (Fin.castAdd M 0)
    rw [hzi] at hprime
    obtain ⟨q, -, hqE, hq1⟩ := MMP.Intersection.exists_stalk_idealSheaf_eq_of_mem_support E hxE
    have hle : IdealSheafData.stalk Z x ≤ IdealSheafData.stalk E.idealSheaf x := by
      refine MMP.Resolution.stalk_le_stalk_of_le ?_ x
      rw [← MMP.Intersection.vanishingIdeal_support_idealSheaf E,
        ← Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal]
      exact hEZ E hE
    rw [hZx, hqE] at hle
    rw [hqE]
    have : (Ideal.span {g}).IsPrime := (Ideal.span_singleton_prime hprime.ne_zero).mpr hprime
    refine (eq_of_le_of_not_lt hle fun hlt => hprime.ne_zero ?_).symm
    have h1 := Ideal.height_add_one_le_of_lt_of_isPrime hlt
    rw [hq1] at h1
    rw [← Ideal.span_singleton_eq_bot, ← Ideal.height_eq_zero_iff_eq_bot]
    exact nonpos_iff_eq_zero.mp
      ((ENat.add_le_add_iff_right ENat.one_ne_top).mp (by simpa using h1))
  refine ⟨fun E hE => ?_, fun x => ?_⟩
  · refine MMP.Resolution.isSmoothScheme_subscheme_of_stalk_eq_span_parameter f _ fun y hy => ?_
    obtain ⟨n, z, i, hz, hI⟩ := key y (hEZ E hE hy)
    exact ⟨n, z, i, hz, hI E hE hy⟩
  · by_cases hx : x ∈ (Z.support : Set X)
    · obtain ⟨n, z, i, hz, hI⟩ := key x hx
      refine ⟨n, z, fun _ => i, hz, fun E E' _ => ?_, fun E => hI E.1 E.2.1 E.2.2⟩
      exact Subtype.ext (MMP.Intersection.eq_of_stalk_idealSheaf_eq E.2.2 E'.2.2
        ((hI E.1 E.2.1 E.2.2).trans (hI E'.1 E'.2.1 E'.2.2).symm))
    · have := isRegularLocalRing_stalk_of_smooth_over_field f x
      obtain ⟨n, z, hz⟩ := exists_isRegularSystemOfParameters (X.presheaf.stalk x)
      have hE : ∀ E : {E : Mori.PrimeDivisor X // E ∈ D.support ∧ x ∈ E.support}, False :=
        fun E => hx (hEZ E.1 E.2.1 E.2.2)
      exact ⟨n, z, fun E => (hE E).elim, hz, fun E => (hE E).elim, fun E => (hE E).elim⟩

end SNC

/-- **The divisor of zeros of a section with smooth zero scheme on a smooth projective variety is
relative snc.** Let `f : X ⟶ Spec ℂ` be a smooth projective variety, smooth of relative
dimension `d`, `L` an invertible module and `s ≠ 0` a global section of `L^{⊗ m}` whose zero
scheme is smooth over `ℂ`. Then the divisor of zeros `D` of `s` is a relative snc divisor. -/
theorem isRelativeSNC_of_smooth_zeroScheme {X : Scheme.{0}} (f : X ⟶ Spec (.of ℂ))
    [MMP.Mori.IsProjectiveVariety ℂ f] (_ : IsSmoothScheme f) (L : X.Modules)
    [IsInvertibleModule X L] {m : ℕ} (s : Γ(tensorPowModule X L (m : ℤ), ⊤)) (hs : s ≠ 0)
    (hsm : Smooth ((@AlgebraicGeometry.zeroScheme X (tensorPowModule X L (m : ℤ))
      (isInvertibleModule_tensorPowModule X L m) s).subschemeι ≫ f))
    [IsLocallyNoetherian X] [IsNormal X] (D : Divisor X) (hD : IsSectionDivisor L s D)
    (d : ℕ) [SmoothOfRelativeDimension d f] :
    D.IsRelativeSNC d f := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : Smooth f := SmoothOfRelativeDimension.smooth d f
  exact MMP.FourfoldProofs.FractionalLogComplexProof.isRelativeSNC_of_isSNC f D
    (hD.isSNC_of_smooth f hs hsm) (hD.coeff_eq_one_of_smooth f hsm)

end MMP.LcBpf
