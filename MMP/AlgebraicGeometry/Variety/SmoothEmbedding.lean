/-- **A morphism of quasi-coherent algebras surjective over an affine open cover induces a closed
immersion of relative spectra.** -/
theorem isClosedImmersion_relativeSpecMapOfAlgebraHom_of_surjective {S : Scheme.{u}}
    (A B : AlgebraSheaf S) [A.IsQuasicoherent] [B.IsQuasicoherent] (φ : A ⟶ B) {ι : Type u}
    (U : ι → S.affineOpens) (hU : ⨆ i, (U i : S.Opens) = ⊤)
    (hφ : ∀ i, Function.Surjective (φ.right.hom.app (op (U i : S.Opens)))) :
    IsClosedImmersion (relativeSpecMapOfAlgebraHom A B φ).left := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (fun i => relativeSpecToBase A ⁻¹ᵁ (U i : S.Opens))
    ((relativeSpecToBase A).iSup_preimage_eq_top hU) fun i => ?_
  refine Stacks.FiniteFactorization.isClosedImmersion_morphismRestrict _ _
    (isAffineOpen_preimage_relativeSpecToBase _ (U i)) ?_ ?_
  · rw [Stacks.RelativeSpecClosedImmersion.preimage_relativeSpecMapOfAlgebraHom]
    exact isAffineOpen_preimage_relativeSpecToBase _ (U i)
  · have key : Function.Surjective
        ((pushforwardAlgebraMap (relativeSpecMapOfAlgebraHom A B φ)).right.hom.app
          (op (U i : S.Opens))) := by
      rw [pushforwardAlgebraMap_relativeSpecMapOfAlgebraHom]
      exact Stacks.FiniteFactorization.surjective_comp
        (Stacks.RelativeSpecClosedImmersion.surjective_app_of_algebraIso
          (pushforwardAlgebraIso _) _)
        (Stacks.FiniteFactorization.surjective_comp (hφ i)
          (Stacks.RelativeSpecClosedImmersion.surjective_app_of_algebraIso
            (pushforwardAlgebraIso _).symm _))
    rw [pushforwardAlgebraMap_app _ _ (preimage_le_preimage_preimage _ _)] at key
    exact Stacks.RelativeSpecClosedImmersion.surjective_app_of_surjective_appLE _
      (Stacks.RelativeSpecClosedImmersion.preimage_relativeSpecMapOfAlgebraHom _ _ φ _) _ key

/-- **The lift `Sym(ℰ) ⟶ 𝒜` of `ℰ ↠ ℱ ⟶ 𝒜` is surjective over an affine open where `𝒜` is generated
by sections in the image of `ℱ`.** -/
theorem surjective_algebraLift_app_of_adjoin_eq_top {S : Scheme.{u}} (𝒜 : S.QuasicoherentAlgebra)
    {E F : S.Modules} [E.IsQuasicoherent] [F.IsQuasicoherent] (q : E ⟶ F) [Epi q]
    (χ : F ⟶ 𝒜.underlyingModule) (U : S.affineOpens)
    (s : Finset (𝒜.right.obj.obj (op (U : S.Opens))))
    (hs : letI := (𝒜.hom.hom.app (op (U : S.Opens))).hom.toAlgebra;
      Algebra.adjoin (S.sheaf.obj.obj (op (U : S.Opens)))
        (↑s : Set (𝒜.right.obj.obj (op (U : S.Opens)))) = ⊤)
    (hgen : ∀ a ∈ s, ∃ y : Γ(F, U), χ.app U y = a) :
    Function.Surjective
      ((Stacks.SymAlgSheaf.algebraLift 𝒜 E (q ≫ χ)).right.hom.app (op (U : S.Opens))) := by
  intro b
  let := (𝒜.hom.hom.app (op (U : S.Opens))).hom.toAlgebra
  let lift := Stacks.SymAlgSheaf.algebraLift 𝒜 E (q ≫ χ)
  have hstr : ∀ r : S.sheaf.obj.obj (op (U : S.Opens)),
      algebraMap (S.sheaf.obj.obj (op (U : S.Opens))) _ r ∈
      (lift.right.hom.app (op (U : S.Opens))).hom.range := fun r =>
    ⟨((Scheme.Modules.symmetricAlgebraSheaf S E).hom.hom.app (op (U : S.Opens))) r,
      congrArg (fun φ' => (φ'.hom.app (op (U : S.Opens))).hom r) (Under.w lift)⟩
  let T : Subalgebra (S.sheaf.obj.obj (op (U : S.Opens))) (𝒜.right.obj.obj (op (U : S.Opens))) :=
    { (lift.right.hom.app (op (U : S.Opens))).hom.range with algebraMap_mem' := hstr }
  have hle : Algebra.adjoin (S.sheaf.obj.obj (op (U : S.Opens)))
      (↑s : Set (𝒜.right.obj.obj (op (U : S.Opens)))) ≤ T := by
    refine Algebra.adjoin_le fun a ha => ?_
    obtain ⟨y, hy⟩ := hgen a ha
    obtain ⟨e, rfl⟩ := Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen S q U U.2 y
    exact ⟨(Scheme.Modules.symmetricAlgebra S E).ungradedIncl 1
      ((Scheme.Modules.symmetricAlgebraGen S E).val.app (op (U : S.Opens)) e),
      (Stacks.SymAlgSheaf.algebraLift_ungradedIncl_gen 𝒜 E (q ≫ χ) (op (U : S.Opens)) e).trans hy⟩
  apply hle
  rw [hs]
  trivial

/-- **In a cocone over a directed system of modules, a section in the image of a stage is in the
image of every later stage.** -/
theorem exists_app_eq_app_of_le {S : Scheme.{u}} {I : Type u} [Preorder I] {D : I ⥤ S.Modules}
    {M : S.Modules} (φ : D ⟶ (Functor.const I).obj M) {i i' : I} (h : i ≤ i') (W : S.Opens)
    (y : Γ(D.obj i, W)) : ∃ y' : Γ(D.obj i', W), (φ.app i').app W y' = (φ.app i).app W y := by
  refine ⟨(D.map (homOfLE h)).app W y, ?_⟩
  have hn : D.map (homOfLE h) ≫ φ.app i' = φ.app i :=
    (φ.naturality (homOfLE h)).trans (Category.comp_id _)
  rw [← hn]
  rfl

/-- **The local generators of `g_* 𝒪_X` over a finite affine open cover come from one stage of a
directed system exhausting its sections.** -/
theorem exists_finite_affineCover_adjoin_eq_top_of_le {S X : Scheme.{u}} [CompactSpace S]
    (g : X ⟶ S) [IsAffineHom g] [LocallyOfFiniteType g] {I : Type u} [PartialOrder I]
    [Nonempty I] [IsDirected I (· ≤ ·)] {D : I ⥤ S.Modules}
    (φ : D ⟶ (Functor.const I).obj
      (Scheme.QuasicoherentAlgebra.underlyingModule (pushforwardAlgebra g)))
    (hsurj : ∀ W : S.Opens, IsCompact (W : Set S) →
      ∀ s : Γ(Scheme.QuasicoherentAlgebra.underlyingModule (pushforwardAlgebra g), W),
        ∃ i, ∃ y : Γ(D.obj i, W), (φ.app i).app W y = s) :
    ∃ (t : Finset S.affineOpens) (i₀ : I), ⨆ U : t, ((U : S.affineOpens) : S.Opens) = ⊤ ∧
      ∀ U ∈ t, ∃ s : Finset ((pushforwardAlgebra g).right.obj.obj (op (U : S.Opens))),
        (letI := ((pushforwardAlgebra g).hom.hom.app (op (U : S.Opens))).hom.toAlgebra;
          Algebra.adjoin (S.sheaf.obj.obj (op (U : S.Opens)))
            (↑s : Set ((pushforwardAlgebra g).right.obj.obj (op (U : S.Opens)))) = ⊤) ∧
        ∀ a ∈ s, ∃ y : Γ(D.obj i₀, U), (φ.app i₀).app U y = a := by
  classical
  have step : ∀ U : S.affineOpens, ∃ s : Finset ((pushforwardAlgebra g).right.obj.obj
      (op (U : S.Opens))),
      (letI := ((pushforwardAlgebra g).hom.hom.app (op (U : S.Opens))).hom.toAlgebra;
        Algebra.adjoin (S.sheaf.obj.obj (op (U : S.Opens)))
          (↑s : Set ((pushforwardAlgebra g).right.obj.obj (op (U : S.Opens)))) = ⊤) ∧
      ∃ i, ∀ a ∈ s, ∃ y : Γ(D.obj i, U), (φ.app i).app U y = a := by
    intro U
    have hft := Stacks.AlgebraicGeometry.FiniteTypeDominating.isFiniteType_pushforwardAlgebra
      g U U.2
    let := ((pushforwardAlgebra g).hom.hom.app (op (U : S.Opens))).hom.toAlgebra
    obtain ⟨s, hs⟩ := hft.out
    refine ⟨s, hs, ?_⟩
    choose i y hy using fun a : s => hsurj U U.2.isCompact a.1
    obtain ⟨i₀, hi₀⟩ := Finset.exists_le (s.attach.image i)
    refine ⟨i₀, fun a ha => ?_⟩
    obtain ⟨y', hy'⟩ := exists_app_eq_app_of_le φ
      (hi₀ _ (Finset.mem_image_of_mem i (Finset.mem_attach s ⟨a, ha⟩))) U (y ⟨a, ha⟩)
    exact ⟨y', hy'.trans (hy ⟨a, ha⟩)⟩
  choose gens hgens iU hiU using step
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun U : S.affineOpens => ((U : S.Opens) : Set S)) (fun U => (U : S.Opens).isOpen)
    (fun x _ => by
      obtain ⟨U, hU⟩ : ∃ U : S.affineOpens, x ∈ (U : S.Opens) := by
        rw [← Opens.mem_iSup, iSup_affineOpens_eq_top]
        trivial
      exact Set.mem_iUnion.2 ⟨U, hU⟩)
  obtain ⟨i₀, hi₀⟩ := Finset.exists_le (t.image iU)
  refine ⟨t, i₀, eq_top_iff.2 fun x _ => ?_, fun U hU => ⟨gens U, hgens U, fun a ha => ?_⟩⟩
  · obtain ⟨U, hU, hx⟩ := Set.mem_iUnion₂.1 (ht (Set.mem_univ x))
    exact Opens.mem_iSup.2 ⟨⟨U, hU⟩, hx⟩
  · obtain ⟨y, hy⟩ := hiU U a ha
    obtain ⟨y', hy'⟩ := exists_app_eq_app_of_le φ (hi₀ _ (Finset.mem_image_of_mem iU hU)) U y
    exact ⟨y', hy'.trans hy⟩

/-- **A scheme affine and locally of finite type over a quasi-compact quasi-separated scheme with
the resolution property is a closed subscheme of a vector bundle over it.** For `g : X ⟶ S` there
are a finite locally free `𝒪_S`-module `ℰ` and a closed immersion `j : X ⟶ 𝐕(ℰ)` over `S`. -/
theorem exists_isClosedImmersion_vectorBundle {S X : Scheme.{u}} [CompactSpace S]
    [QuasiSeparatedSpace S] [HasResolutionProperty S] (g : X ⟶ S) [IsAffineHom g]
    [LocallyOfFiniteType g] :
    ∃ (E : S.Modules) (_ : SheafOfModules.IsFiniteLocallyFree (R := S.ringCatSheaf) E)
      (_ : E.IsQuasicoherent) (j : X ⟶ Scheme.Modules.vectorBundle S E),
      IsClosedImmersion j ∧ j ≫ Scheme.Modules.vectorBundleToBase S E = g := by
  have : (Scheme.QuasicoherentAlgebra.underlyingModule (pushforwardAlgebra g)).IsQuasicoherent :=
    isQuasicoherent_pushforwardAlgebra g
  obtain ⟨I, _, _, _, D, φ, hfp, -, hsurj, -⟩ :=
    Stacks.AlgebraicGeometry.ModuleLimits.exists_directed_system_sections S
      (Scheme.QuasicoherentAlgebra.underlyingModule (pushforwardAlgebra g))
  obtain ⟨t, i₀, hcov, hgen⟩ := exists_finite_affineCover_adjoin_eq_top_of_le g φ hsurj
  have := hfp i₀
  have : (D.obj i₀).IsQuasicoherent := _root_.isQuasicoherent_of_isFinitePresentation _
  have : (D.obj i₀).IsFiniteType :=
    Scheme.Modules.isFiniteType_of_isFinitePresentation _ (hfp i₀)
  obtain ⟨E, hE, q, hq⟩ := HasResolutionProperty.exists_finiteLocallyFree_quotient (D.obj i₀)
  have hEqc : E.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
  let lift := Stacks.SymAlgSheaf.algebraLift (pushforwardAlgebra g) E (q ≫ φ.app i₀)
  let ρ := relativeSpecMapOfAlgebraHom (Scheme.Modules.symmetricAlgebraSheaf S E)
    (pushforwardAlgebra g) lift
  have hci : IsClosedImmersion ρ.left :=
    isClosedImmersion_relativeSpecMapOfAlgebraHom_of_surjective _ _ lift (fun U : t => U.1) hcov
      fun U => by
        obtain ⟨s, hs, hsφ⟩ := hgen U.1 U.2
        exact surjective_algebraLift_app_of_adjoin_eq_top _ q _ U.1 s hs hsφ
  let e := relativeSpecPushforwardAlgebraIso g
  have : IsClosedImmersion (e.hom.left ≫ ρ.left) := inferInstance
  refine ⟨E, hE, hEqc, e.hom.left ≫ ρ.left, this, ?_⟩
  have h1 := Over.w ρ
  have h2 := Over.w e.hom
  simp only [Over.mk_hom] at h1 h2
  exact (Category.assoc _ _ _).trans ((congrArg (e.hom.left ≫ ·) h1).trans h2)

/-- **The vector bundle of a finite locally free module on a smooth variety is a smooth
variety.** The projection `𝐕(ℰ) ⟶ M` is an affine-space bundle, of the rank of `ℰ`, which is
constant on the connected scheme `M`. -/
theorem isSmoothVariety_vectorBundleToBase_comp {k : Type u} [Field k] {M : Scheme.{u}}
    (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (E : M.Modules)
    [SheafOfModules.IsFiniteLocallyFree (R := M.ringCatSheaf) E] [E.IsQuasicoherent] :
    IsSmoothVariety k (Scheme.Modules.vectorBundleToBase M E ≫ s) := by
  obtain ⟨x⟩ : Nonempty M := inferInstance
  have : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E
      (Scheme.Modules.fiberRank E x) :=
    Scheme.Modules.isFiniteLocallyFreeOfRank_of_forall_fiberRank_eq E _
      fun y => (Scheme.Modules.isLocallyConstant_fiberRank E).apply_eq_of_preconnectedSpace y x
  have hb := Stacks.Chow.isAffineSpaceBundle_vectorBundleToBase E (Scheme.Modules.fiberRank E x)
  have := Stacks.Chow.smoothOfRelativeDimension_of_isAffineSpaceBundle _ _ hb
  have : Smooth (Scheme.Modules.vectorBundleToBase M E) :=
    SmoothOfRelativeDimension.smooth (Scheme.Modules.fiberRank E x) _
  have := Stacks.Chow.locallyOfFiniteType_vectorBundleToBase E (Scheme.Modules.fiberRank E x)
  have := Stacks.Chow.isIntegral_of_isAffineSpaceBundle _ _ hb
  have hA := Scheme.Modules.isAffineHom_vectorBundleToBase M E
  have : IsSeparated (Scheme.Modules.vectorBundleToBase M E) := IsSeparated.of_isAffineHom _
  have : IsSeparated s := (inferInstance : IsVariety k s).toIsSeparated
  have : QuasiCompact (Scheme.Modules.vectorBundleToBase M E) := inferInstance
  have : QuasiCompact s := (inferInstance : IsVariety k s).toQuasiCompact
  refine (isSmoothVariety_iff k _).2 ⟨?_, inferInstance⟩
  exact
    { toIsIntegral := inferInstance
      toIsSeparated := inferInstance
      toLocallyOfFiniteType := inferInstance
      toQuasiCompact := inferInstance }

/-- **A smooth variety over a field has the resolution property.** -/
theorem hasResolutionProperty_of_isSmoothVariety {k : Type u} [Field k] {M : Scheme.{u}}
    (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] : HasResolutionProperty M := by
  have : IsNoetherian (Spec (CommRingCat.of k)) :=
    isNoetherian_Spec.mpr (inferInstanceAs (IsNoetherianRing k))
  have : IsLocallyNoetherian M := LocallyOfFiniteType.isLocallyNoetherian s
  have : CompactSpace M := QuasiCompact.compactSpace_of_compactSpace s
  have : IsNoetherian M := { }
  have : QuasiSeparatedSpace M := quasiSeparatedSpace_of_quasiSeparated s
  have : IsSeparated (terminal.from M) := by
    rw [← terminal.comp_from s]
    infer_instance
  exact hasResolutionProperty_of_isRegular_of_isNoetherian M (isRegular_of_smooth_over_field s)

/-- **Fulton, B.8.3.** Let `M` be a smooth variety over `k`, `i : Y ⟶ M` a closed immersion and
`f : X ⟶ Y` an affine morphism locally of finite type. Then there is a closed immersion of `X`
into a smooth variety `N` over `k`, compatible with the structure morphisms. -/
theorem exists_isClosedImmersion_isSmoothVariety {k : Type u} [Field k] {M Y X : Scheme.{u}}
    (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (i : Y ⟶ M) [IsClosedImmersion i]
    (f : X ⟶ Y) [IsAffineHom f] [LocallyOfFiniteType f] :
    ∃ (N : Scheme.{u}) (t : N ⟶ Spec (.of k)) (j : X ⟶ N),
      IsSmoothVariety k t ∧ IsClosedImmersion j ∧ j ≫ t = f ≫ i ≫ s := by
  have : CompactSpace M := QuasiCompact.compactSpace_of_compactSpace s
  have : QuasiSeparatedSpace M := quasiSeparatedSpace_of_quasiSeparated s
  have := hasResolutionProperty_of_isSmoothVariety s
  obtain ⟨E, hE, hEqc, j, hj, hjc⟩ := exists_isClosedImmersion_vectorBundle (f ≫ i)
  exact ⟨_, _, j, isSmoothVariety_vectorBundleToBase_comp s E, hj, by
    rw [← Category.assoc, hjc, Category.assoc]⟩

/-- **Fulton, B.8.3, for a finite morphism.** A scheme finite over a closed subscheme of a smooth
variety is a closed subscheme of a smooth variety. -/
theorem exists_isClosedImmersion_isSmoothVariety_of_isFinite {k : Type u} [Field k]
    {M Y X : Scheme.{u}} (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (i : Y ⟶ M)
    [IsClosedImmersion i] (f : X ⟶ Y) [IsFinite f] :
    ∃ (N : Scheme.{u}) (t : N ⟶ Spec (.of k)) (j : X ⟶ N),
      IsSmoothVariety k t ∧ IsClosedImmersion j ∧ j ≫ t = f ≫ i ≫ s :=
  exists_isClosedImmersion_isSmoothVariety s i f

/-! ### Projective morphisms -/

/-- **Projective space over `ℤ` is geometrically irreducible.** Its base change to a field `K`
is `ℙⁿ_K`, which is integral. -/
theorem geometricallyIrreducible_terminalFrom_projectiveSpaceAtUniverse (n : ℕ) :
    GeometricallyIrreducible (terminal.from (projectiveSpaceAtUniverse.{u} n)) := by
  refine ⟨fun K _ y Z fst snd h => ?_⟩
  obtain rfl : y = terminal.from _ := terminal.hom_ext _ _
  exact h.flip.isoPullback.hom.homeomorph.irreducibleSpace_iff.mpr inferInstance

open Stacks.AlgebraicGeometry.RelativeProj Stacks.SymGraded in
/-- **The projective bundle of a finite locally free module of constant positive rank is
geometrically irreducible over its base.** Geometric irreducibility is local on the base, and over
an open trivialising the module the projection is that of `ℙⁿ`, a base change of
`ℙⁿ_ℤ ⟶ Spec ℤ`. -/
theorem geometricallyIrreducible_relativeProj_toBase {S : Scheme.{u}} (E : S.Modules)
    (hqc : IsQuasicoherentPieces E) (n : ℕ)
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (n + 1)] :
    GeometricallyIrreducible (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase := by
  rw [geometricallyIrreducible_iff]
  refine IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict fun x => ?_
  obtain ⟨U, hxU, Φ, hΦ⟩ := Stacks.ProjectiveBundle.exists_iso_morphismRestrict_free E hqc n x
  refine ⟨U, hxU, ?_⟩
  rw [(Iso.eq_inv_comp Φ).mpr hΦ,
    MorphismProperty.cancel_left_of_respectsIso (geometrically (IrreducibleSpace ·)) Φ.inv]
  have h₁ : GeometricallyIrreducible (pullback.fst (terminal.from U.toScheme)
      (terminal.from (projectiveSpaceAtUniverse.{u} n))) := by
    have := geometricallyIrreducible_terminalFrom_projectiveSpaceAtUniverse.{u} n
    infer_instance
  have h₂ := (geometricallyIrreducible_iff _).1 h₁
  rwa [← MorphismProperty.cancel_left_of_respectsIso (geometrically (IrreducibleSpace ·))
    (projectiveBundleIsoProjectiveSpace (X := U.toScheme) n).hom,
    projectiveBundleIsoProjectiveSpace_hom_comp_fst] at h₂

open Stacks.AlgebraicGeometry.RelativeProj Stacks.SymGraded in
/-- **The projective bundle of a finite locally free module of constant positive rank on a smooth
variety is a smooth variety.** The projection `𝐏(ℰ) ⟶ M` is smooth and proper, and geometrically
irreducible and open, so `𝐏(ℰ)` is irreducible, and a connected scheme smooth over a field is
integral. -/
theorem isSmoothVariety_schemeProjectiveBundle_toBase_comp {k : Type u} [Field k]
    {M : Scheme.{u}} (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (E : M.Modules) (n : ℕ)
    [SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (n + 1)] (hqc : IsQuasicoherentPieces E) :
    IsSmoothVariety k ((schemeProjectiveBundle E hqc).toBase ≫ s) := by
  have := SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree E (n + 1)
  have : E.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
  have : Smooth (schemeProjectiveBundle E hqc).toBase :=
    Stacks.ProjectiveBundle.smooth_toBase E hqc n
  have : IsProper (schemeProjectiveBundle E hqc).toBase :=
    Stacks.ProjectiveBundleSplitting.isProper_schemeProjectiveBundleToBase E hqc
  have : GeometricallyIrreducible (schemeProjectiveBundle E hqc).toBase :=
    geometricallyIrreducible_relativeProj_toBase E hqc n
  have hv : IsVariety k s := inferInstance
  have : IrreducibleSpace (schemeProjectiveBundle E hqc).scheme :=
    GeometricallyIrreducible.irreducibleSpace _ (schemeProjectiveBundle E hqc).toBase.isOpenMap
  have : Smooth ((schemeProjectiveBundle E hqc).toBase ≫ s) := inferInstance
  have : IsIntegral (schemeProjectiveBundle E hqc).scheme :=
    Stacks.Chow.isIntegral_of_connectedSpace_of_smooth ((schemeProjectiveBundle E hqc).toBase ≫ s)
  have : IsSeparated s := hv.toIsSeparated
  have : QuasiCompact s := hv.toQuasiCompact
  refine (isSmoothVariety_iff k _).2 ⟨?_, inferInstance⟩
  exact
    { toIsIntegral := inferInstance
      toIsSeparated := inferInstance
      toLocallyOfFiniteType := inferInstance
      toQuasiCompact := inferInstance }

open Stacks.SymGraded in
/-- **A finite locally free module on a connected scheme is a quotient of one of constant positive
rank.** `ℰ ⊕ 𝒪_X` surjects onto `ℰ`, and its rank is one more than the constant rank of `ℰ`. -/
theorem exists_isFiniteLocallyFreeOfRank_succ_epi {X : Scheme.{u}} [ConnectedSpace X]
    (E : X.Modules) [SheafOfModules.IsFiniteLocallyFree.{u, u, u} E] :
    ∃ (F : X.Modules) (n : ℕ) (_ : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F (n + 1))
      (p : F ⟶ E), Epi p := by
  obtain ⟨x⟩ : Nonempty X := inferInstance
  have hE : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E
      (Scheme.Modules.fiberRank E x) :=
    Scheme.Modules.isFiniteLocallyFreeOfRank_of_forall_fiberRank_eq E _
      fun y => (Scheme.Modules.isLocallyConstant_fiberRank E).apply_eq_of_preconnectedSpace y x
  let O : X.Modules := _root_.SheafOfModules.unit X.ringCatSheaf
  have hF := Stacks.Chow.GenuineChern.isFiniteLocallyFreeOfRank_of_shortExact _
    (ShortComplex.Splitting.ofHasBinaryBiproduct E O).shortExact _ 1 hE
    (SheafOfModules.isFiniteLocallyFreeOfRank_unit X)
  exact ⟨E ⊞ O, _, hF, biprod.fst, IsSplitEpi.epi _⟩

open Stacks.SymGraded Stacks.AlgebraicGeometry.ProjBundleSurjection in
/-- **Fulton, B.8.3, for a projective morphism.** Let `M` be a smooth variety over `k`,
`i : Y ⟶ M` a closed immersion and `f : X ⟶ Y` projective in the sense of [Stacks, Tag 01W8]
(a closed subscheme of the projective bundle `𝐏(ℰ)` of a quasi-coherent `𝒪_Y`-module of finite
type). Then there is a closed immersion of `X` into a smooth variety `N` over `k`, compatible with
the structure morphisms.

The composite `f ≫ i` is projective (a closed immersion is finite, hence projective, and
projective morphisms compose over the quasi-compact quasi-separated `M`), so `X` is a closed
subscheme of `𝐏(𝒢)` for a quasi-coherent `𝒪_M`-module `𝒢` of finite type. By the resolution
property of `M`, `𝒢` is a quotient of a finite locally free `ℰ`, which may be taken of constant
positive rank, so `𝐏(𝒢)` is a closed subscheme of `𝐏(ℰ)`, a smooth variety. -/
theorem exists_isClosedImmersion_isSmoothVariety_of_isProjective {k : Type u} [Field k]
    {M Y X : Scheme.{u}} (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (i : Y ⟶ M)
    [IsClosedImmersion i] (f : X ⟶ Y) (hf : IsProjective f) :
    ∃ (N : Scheme.{u}) (t : N ⟶ Spec (.of k)) (j : X ⟶ N),
      IsSmoothVariety k t ∧ IsClosedImmersion j ∧ j ≫ t = f ≫ i ≫ s := by
  have : CompactSpace M := QuasiCompact.compactSpace_of_compactSpace s
  have : QuasiSeparatedSpace M := quasiSeparatedSpace_of_quasiSeparated s
  have := hasResolutionProperty_of_isSmoothVariety s
  obtain ⟨G, hGqc, hGft, hGp, a, ha, hac⟩ :=
    hf.comp (Stacks.FiniteMorphismProjective.isProjective_of_isFinite i)
  obtain ⟨E₀, hE₀, q₀, hq₀⟩ := HasResolutionProperty.exists_finiteLocallyFree_quotient G
  obtain ⟨E, n, hE, p, hp⟩ := exists_isFiniteLocallyFreeOfRank_succ_epi E₀
  have := SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree E (n + 1)
  have : E.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.isQuasicoherent_of_isFiniteLocallyFree E
  have hψ := Stacks.Chow.GenuineChern.surjectiveOnAffineSections_schemeSheafGradedAlgebraHom
    (p ≫ q₀) (isQuasicoherentPieces_of_isQuasicoherent E)
    (isQuasicoherentPieces_of_isQuasicoherent G)
  have hb := isClosedImmersion_bundleMap hψ
  refine ⟨_, (schemeProjectiveBundle E (isQuasicoherentPieces_of_isQuasicoherent E)).toBase ≫ s,
    a ≫ bundleMap hψ, isSmoothVariety_schemeProjectiveBundle_toBase_comp s E n _, inferInstance,
    ?_⟩
  have hbc := bundleMap_comp_toBase hψ
  simp only [schemeProjectiveBundleToBase] at hbc
  rw [Category.assoc, ← Category.assoc (bundleMap hψ), hbc, ← Category.assoc, hac,
    Category.assoc]

/-- **Fulton, B.8.3, for a blowup.** The blowup `Bl_I(Y)` of a closed subscheme `Y` of a smooth
variety `M` in a quasi-coherent ideal sheaf `I` is a closed subscheme of a smooth variety,
compatibly with the structure morphisms: the blowup is projective over `Y` ([Stacks, Tag 02NS]),
`I` being of finite type because `Y` is Noetherian. -/
theorem exists_isClosedImmersion_isSmoothVariety_blowUp {k : Type u} [Field k]
    {M Y : Scheme.{u}} (s : M ⟶ Spec (.of k)) [IsSmoothVariety k s] (i : Y ⟶ M)
    [IsClosedImmersion i] (I : Y.IdealSheafData) :
    ∃ (N : Scheme.{u}) (t : N ⟶ Spec (.of k)) (j : blowUp I ⟶ N),
      IsSmoothVariety k t ∧ IsClosedImmersion j ∧ j ≫ t = blowUpToBase I ≫ i ≫ s := by
  have : IsNoetherian (Spec (CommRingCat.of k)) :=
    isNoetherian_Spec.mpr (inferInstanceAs (IsNoetherianRing k))
  have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (i ≫ s)
  have hI : I.IsFiniteType := fun U =>
    haveI := IsLocallyNoetherian.component_noetherian U
    IsNoetherian.noetherian (I.ideal U)
  exact exists_isClosedImmersion_isSmoothVariety_of_isProjective s i _
    (Stacks.Blowup.isProjective_blowUpToBase I hI)

end MMP
