/-- The depth of a nonzero finite module over a Noetherian local ring is at most the dimension
of its support. -/
private lemma localDepth_le_supportDim {R : Type*} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (N : Type*) [AddCommGroup N] [Module R N] [Module.Finite R N]
    [Nontrivial N] : (localDepth R N : WithBot ℕ∞) ≤ Module.supportDim R N := by
  have : localDepth R N = Module.depthSup R (maximalIdeal R) N := by
    rw [localDepth, Module.depthSup_eq_iSup]
    congr! 3 with xs
    exact and_congr_right fun h => (isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal h).symm
  rw [this]
  exact depth_le_supportDim

/-- Let `A` be a Noetherian local ring, `B` a finite `A`-algebra and `M` a finite `B`-module such
that every nonzero localization `M_𝔓` at a maximal ideal has the dimension of `M` over `A`. Then
`M` is Cohen–Macaulay over `A` if and only if every `M_𝔓` is Cohen–Macaulay over `B_𝔓`. -/
private theorem isCMModule_iff_forall_localization
    (A : Type*) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (B : Type*) [CommRing B] [Algebra A B] [Module.Finite A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M]
    (Bₚ : MaximalSpectrum B → Type*) [∀ P, CommRing (Bₚ P)] [∀ P, Algebra B (Bₚ P)]
    [∀ P, IsLocalization.AtPrime (Bₚ P) P.asIdeal] [∀ P, IsLocalRing (Bₚ P)]
    (Mₚ : MaximalSpectrum B → Type*) [∀ P, AddCommGroup (Mₚ P)] [∀ P, Module B (Mₚ P)]
    [∀ P, Module (Bₚ P) (Mₚ P)] [∀ P, IsScalarTower B (Bₚ P) (Mₚ P)]
    (f : ∀ P, M →ₗ[B] Mₚ P) [∀ P, IsLocalizedModule P.asIdeal.primeCompl (f P)]
    (hdim : ∀ P, Nontrivial (Mₚ P) →
      Module.supportDim (Bₚ P) (Mₚ P) = Module.supportDim A M) :
    IsCMModule A M ↔ ∀ P, IsCMModule (Bₚ P) (Mₚ P) := by
  haveI : IsNoetherianRing B := IsNoetherianRing.of_finite A B
  haveI : Module.Finite A M := Module.Finite.trans B M
  haveI hN : ∀ P, IsNoetherianRing (Bₚ P) := fun P =>
    IsLocalization.isNoetherianRing P.asIdeal.primeCompl (Bₚ P) ‹_›
  haveI hF : ∀ P, Module.Finite (Bₚ P) (Mₚ P) := fun P =>
    Module.Finite.of_isLocalizedModule P.asIdeal.primeCompl (f P)
  rcases subsingleton_or_nontrivial M with hM | hM
  · refine iff_of_true (isCMModule_of_subsingleton) fun P => ?_
    haveI : Subsingleton (Mₚ P) := by
      refine ⟨fun a b => ?_⟩
      obtain ⟨⟨m, s⟩, rfl⟩ := IsLocalizedModule.mk'_surjective P.asIdeal.primeCompl (f P) a
      obtain ⟨⟨m', s'⟩, rfl⟩ := IsLocalizedModule.mk'_surjective P.asIdeal.primeCompl (f P) b
      simp only [Function.uncurry_apply_pair, Subsingleton.elim m 0, IsLocalizedModule.mk'_zero,
        Subsingleton.elim m' 0]
    exact isCMModule_of_subsingleton
  have hdep := localDepth_eq_iInf_localDepth_localization A B M Bₚ Mₚ f
  obtain ⟨e, he⟩ := exists_supportDim_eq_natCast A M
  have hiff : ∀ P, Nontrivial (Mₚ P) → (IsCMModule (Bₚ P) (Mₚ P) ↔ localDepth (Bₚ P) (Mₚ P) = e) :=
    fun P _ => by
      rw [(isCMModule_iff_localDepth_eq_supportDim_and_isCohenMacaulayModule _ _).1, hdim P ‹_›,
        he]
      exact WithBot.coe_inj.trans (by norm_cast)
  have hle : ∀ P, Nontrivial (Mₚ P) → localDepth (Bₚ P) (Mₚ P) ≤ e := fun P _ => by
    have := localDepth_le_supportDim (R := Bₚ P) (Mₚ P)
    rw [hdim P ‹_›, he] at this
    exact_mod_cast this
  rw [(isCMModule_iff_localDepth_eq_supportDim_and_isCohenMacaulayModule _ _).1, he,
    WithBot.coe_inj.trans (by norm_cast : localDepth A M = ((e : ℕ∞)) ↔ _), hdep]
  refine ⟨fun h P => ?_, fun h => ?_⟩
  · rcases subsingleton_or_nontrivial (Mₚ P) with hP | hP
    · exact isCMModule_of_subsingleton
    refine (hiff P hP).2 (le_antisymm (hle P hP) ?_)
    rw [← h]
    exact iInf₂_le P hP
  · refine le_antisymm ?_ (le_iInf₂ fun P hP => ((hiff P hP).1 (h P)).ge)
    have := localDepth_le_supportDim (R := A) M
    rw [he, hdep] at this
    exact_mod_cast this

section support

variable {B : Type*} [CommRing B] {M : Type*} [AddCommGroup M] [Module B M]
    (𝔭 : Ideal B) [𝔭.IsPrime] (Bₚ : Type*) [CommRing Bₚ] [Algebra B Bₚ]
    [IsLocalization.AtPrime Bₚ 𝔭]
    {Mₚ : Type*} [AddCommGroup Mₚ] [Module B Mₚ] [Module Bₚ Mₚ] [IsScalarTower B Bₚ Mₚ]
    (f : M →ₗ[B] Mₚ) [IsLocalizedModule 𝔭.primeCompl f]

include 𝔭 f in
private theorem comap_mem_support_of_mem_support {q : PrimeSpectrum Bₚ}
    (hq : q ∈ Module.support Bₚ Mₚ) :
    PrimeSpectrum.comap (algebraMap B Bₚ) q ∈ Module.support B M := by
  obtain ⟨m', hm'⟩ := Module.mem_support_iff_exists_annihilator.mp hq
  obtain ⟨⟨m, s⟩, hs⟩ := IsLocalizedModule.surj 𝔭.primeCompl f m'
  rw [Submonoid.smul_def] at hs
  refine Module.mem_support_iff_exists_annihilator.mpr ⟨m, fun b hb => ?_⟩
  rw [Submodule.mem_annihilator_span_singleton] at hb
  have h1 : (s : B) • (b • m') = (s : B) • 0 := by
    rw [smul_comm, hs, ← map_smul, hb, map_zero, smul_zero]
  have h2 : b • m' = 0 :=
    ((Module.End.isUnit_iff _).mp (IsLocalizedModule.map_units f s)).1 h1
  have h3 : algebraMap B Bₚ b • m' = 0 := by rwa [algebraMap_smul]
  exact hm' ((Submodule.mem_annihilator_span_singleton _ _).mpr h3)

include f in
private theorem map_mem_support_of_mem_support {q : PrimeSpectrum B} (hq𝔭 : q.asIdeal ≤ 𝔭)
    (hq : q ∈ Module.support B M) :
    haveI := IsLocalization.isPrime_of_isPrime_disjoint 𝔭.primeCompl Bₚ q.asIdeal q.2
      (Set.disjoint_left.mpr fun _ ha hb => ha (hq𝔭 hb))
    (⟨Ideal.map (algebraMap B Bₚ) q.asIdeal, inferInstance⟩ : PrimeSpectrum Bₚ) ∈
      Module.support Bₚ Mₚ := by
  obtain ⟨m, hm⟩ := Module.mem_support_iff_exists_annihilator.mp hq
  refine Module.mem_support_iff_exists_annihilator.mpr ⟨f m, fun x hx => ?_⟩
  rw [Submodule.mem_annihilator_span_singleton] at hx
  obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl x
  change IsLocalization.mk' Bₚ b t • f m = 0 at hx
  change IsLocalization.mk' Bₚ b t ∈ Ideal.map (algebraMap B Bₚ) q.asIdeal
  have hb : f (b • m) = 0 := by
    rw [map_smul, ← algebraMap_smul Bₚ b (f m), ← IsLocalization.mk'_spec Bₚ b t, mul_comm,
      mul_smul, hx, smul_zero]
  obtain ⟨u, hu⟩ := IsLocalizedModule.exists_of_eq (S := 𝔭.primeCompl) (f := f)
    (hb.trans (map_zero f).symm)
  rw [smul_zero, Submonoid.smul_def, smul_smul] at hu
  have hub : u.1 * b ∈ q.asIdeal := hm ((Submodule.mem_annihilator_span_singleton _ _).mpr hu)
  have hbq : b ∈ q.asIdeal :=
    (q.2.mem_or_mem hub).resolve_left fun h => u.2 (hq𝔭 h)
  rw [IsLocalization.mk'_eq_mul_mk'_one]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hbq)

end support

private theorem supportDim_eq_iSup_localization
    (B : Type*) [CommRing B] (M : Type*) [AddCommGroup M] [Module B M]
    (Bₚ : MaximalSpectrum B → Type*) [∀ P, CommRing (Bₚ P)] [∀ P, Algebra B (Bₚ P)]
    [∀ P, IsLocalization.AtPrime (Bₚ P) P.asIdeal]
    (Mₚ : MaximalSpectrum B → Type*) [∀ P, AddCommGroup (Mₚ P)] [∀ P, Module B (Mₚ P)]
    [∀ P, Module (Bₚ P) (Mₚ P)] [∀ P, IsScalarTower B (Bₚ P) (Mₚ P)]
    (f : ∀ P, M →ₗ[B] Mₚ P) [∀ P, IsLocalizedModule P.asIdeal.primeCompl (f P)] :
    Module.supportDim B M = ⨆ P, Module.supportDim (Bₚ P) (Mₚ P) := by
  refine le_antisymm ?_ (iSup_le fun P => ?_)
  · rw [Module.supportDim, Order.krullDim]
    refine iSup_le fun p => ?_
    obtain ⟨P, hPmax, hP⟩ := Ideal.exists_le_maximal _ (p.last).1.2.ne_top
    let P' : MaximalSpectrum B := ⟨P, hPmax⟩
    have hle : ∀ i, (p i).1.asIdeal ≤ P'.asIdeal := fun i =>
      le_trans (p.monotone (Fin.le_last i)) hP
    have hprime : ∀ i, (Ideal.map (algebraMap B (Bₚ P')) (p i).1.asIdeal).IsPrime := fun i =>
      IsLocalization.isPrime_of_isPrime_disjoint P'.asIdeal.primeCompl (Bₚ P') _ (p i).1.2
        (Set.disjoint_left.mpr fun _ ha hb => ha (hle i hb))
    have hcomap : ∀ i, (Ideal.map (algebraMap B (Bₚ P')) (p i).1.asIdeal).comap
        (algebraMap B (Bₚ P')) = (p i).1.asIdeal := fun i =>
      IsLocalization.under_map_of_isPrime_disjoint P'.asIdeal.primeCompl (Bₚ P') (p i).1.2
        (Set.disjoint_left.mpr fun _ ha hb => ha (hle i hb))
    let q : LTSeries (Module.support (Bₚ P') (Mₚ P')) :=
      { length := p.length
        toFun := fun i => ⟨⟨_, hprime i⟩,
          map_mem_support_of_mem_support P'.asIdeal (Bₚ P') (f P') (hle i) (p i).2⟩
        step := fun i => by
          have hlt : (p (Fin.castSucc i)).1.asIdeal < (p i.succ).1.asIdeal := p.step i
          change Ideal.map _ _ < Ideal.map _ _
          refine lt_of_le_of_ne (Ideal.map_mono hlt.le) fun h => hlt.ne ?_
          rw [← hcomap (Fin.castSucc i), ← hcomap i.succ, h] }
    exact le_iSup_of_le P' (Order.LTSeries.length_le_krullDim q)
  · refine Order.krullDim_le_of_strictMono
      (fun q => ⟨PrimeSpectrum.comap (algebraMap B (Bₚ P)) q.1,
        comap_mem_support_of_mem_support P.asIdeal (Bₚ P) (f P) q.2⟩) fun q₁ q₂ h => ?_
    have h' : q₁.1.asIdeal < q₂.1.asIdeal := h
    change Ideal.comap _ _ < Ideal.comap _ _
    refine lt_of_le_of_ne (Ideal.comap_mono h'.le) fun he => h'.ne ?_
    rw [← IsLocalization.map_under P.asIdeal.primeCompl (Bₚ P) q₁.1.asIdeal,
      ← IsLocalization.map_under P.asIdeal.primeCompl (Bₚ P) q₂.1.asIdeal]
    exact congrArg _ he

private theorem isCMModule_congr {A : Type*} [CommRing A] [IsLocalRing A] {M M' : Type*}
    [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M'] (e : M ≃ₗ[A] M') :
    IsCMModule A M ↔ IsCMModule A M' := by
  unfold IsCMModule IsRegularSequence
  rw [Module.supportDim_eq_of_equiv e, e.toEquiv.subsingleton_congr]
  simp_rw [e.isWeaklyRegular_congr]

section construction

variable {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
    {S : Type*} [CommRing S] [Algebra R S]

/-- The image of `p.primeCompl` in `S`, the submonoid at which `S` is localized. -/
local notation "T" => Algebra.algebraMapSubmonoid S p.primeCompl

private theorem disjoint_algebraMapSubmonoid {Q : Ideal S} (hQ : Q.comap (algebraMap R S) = p) :
    Disjoint (T : Set S) (Q : Set S) := by
  refine Set.disjoint_left.mpr ?_
  rintro _ ⟨s, hs, rfl⟩ hQs
  exact hs (hQ ▸ Ideal.mem_comap.mpr hQs)

/-- The maximal ideals of `S_p` are the primes of `S` over `p`, for `S_p` finite over `R_p`. -/
private noncomputable def maximalSpectrumEquiv
    (A : Type*) [CommRing A] [Algebra R A] [IsLocalization.AtPrime A p]
    [Algebra A (Localization T)] [IsScalarTower R A (Localization T)]
    [Module.Finite A (Localization T)] :
    MaximalSpectrum (Localization T) ≃
      {Q : PrimeSpectrum S // Q.asIdeal.comap (algebraMap R S) = p} := by
  haveI : IsLocalRing A := IsLocalization.AtPrime.isLocalRing A p
  haveI : Algebra.IsIntegral A (Localization T) := Algebra.IsIntegral.of_finite _ _
  have hRB : algebraMap R (Localization T) =
      (algebraMap S (Localization T)).comp (algebraMap R S) :=
    IsScalarTower.algebraMap_eq R S _
  have hRB' : algebraMap R (Localization T) =
      (algebraMap A (Localization T)).comp (algebraMap R A) :=
    IsScalarTower.algebraMap_eq R A _
  -- a prime of `A` over `p` is the maximal ideal
  have hA : ∀ J : Ideal A, J.comap (algebraMap R A) = p → J = maximalIdeal A := fun J hJ => by
    rw [← IsLocalization.map_under p.primeCompl A J,
      ← IsLocalization.map_under p.primeCompl A (maximalIdeal A)]
    exact congrArg _ (hJ.trans (IsLocalization.AtPrime.under_maximalIdeal A p).symm)
  refine
    { toFun := fun P => ⟨⟨P.asIdeal.comap (algebraMap S _), Ideal.comap_isPrime _ _⟩, ?_⟩
      invFun := fun Q => ⟨Q.1.asIdeal.map (algebraMap S _), ?_⟩
      left_inv := fun P => ?_
      right_inv := fun Q => ?_ }
  · change Ideal.comap _ (Ideal.comap _ _) = p
    have h1 : P.asIdeal.comap (algebraMap A _) = maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under A P.asIdeal)
    rw [Ideal.comap_comap, ← hRB, hRB', ← Ideal.comap_comap, h1]
    exact IsLocalization.AtPrime.under_maximalIdeal A p
  · haveI := IsLocalization.isPrime_of_isPrime_disjoint T (Localization T) Q.1.asIdeal Q.1.2
      (disjoint_algebraMapSubmonoid p Q.2)
    refine Ideal.isMaximal_of_isIntegral_of_isMaximal_under (R := A) _ ?_
    have hJ : ((Q.1.asIdeal.map (algebraMap S (Localization T))).comap
        (algebraMap A _)).comap (algebraMap R A) = p := by
      rw [Ideal.comap_comap, ← hRB', hRB, ← Ideal.comap_comap]
      exact (congrArg (Ideal.comap (algebraMap R S))
        (IsLocalization.under_map_of_isPrime_disjoint T _ Q.1.2
          (disjoint_algebraMapSubmonoid p Q.2))).trans Q.2
    rw [Ideal.under_def, hA _ hJ]
    exact IsLocalRing.maximalIdeal.isMaximal A
  · exact MaximalSpectrum.ext (IsLocalization.map_under T _ P.asIdeal)
  · exact Subtype.ext (PrimeSpectrum.ext
      (IsLocalization.under_map_of_isPrime_disjoint T _ Q.1.2
        (disjoint_algebraMapSubmonoid p Q.2)))

end construction

private theorem isCMModule_iff_forall_localization_of_supportDim_eq
    (A : Type*) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (B : Type*) [CommRing B] [Algebra A B] [Module.Finite A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    [Module.Finite B M]
    (Bₚ : MaximalSpectrum B → Type*) [∀ P, CommRing (Bₚ P)] [∀ P, Algebra B (Bₚ P)]
    [∀ P, IsLocalization.AtPrime (Bₚ P) P.asIdeal] [∀ P, IsLocalRing (Bₚ P)]
    (Mₚ : MaximalSpectrum B → Type*) [∀ P, AddCommGroup (Mₚ P)] [∀ P, Module B (Mₚ P)]
    [∀ P, Module (Bₚ P) (Mₚ P)] [∀ P, IsScalarTower B (Bₚ P) (Mₚ P)]
    (f : ∀ P, M →ₗ[B] Mₚ P) [∀ P, IsLocalizedModule P.asIdeal.primeCompl (f P)]
    (hdim : ∀ P Q, Nontrivial (Mₚ P) → Nontrivial (Mₚ Q) →
      Module.supportDim (Bₚ P) (Mₚ P) = Module.supportDim (Bₚ Q) (Mₚ Q)) :
    IsCMModule A M ↔ ∀ P, IsCMModule (Bₚ P) (Mₚ P) := by
  haveI : Module.Finite A M := Module.Finite.trans B M
  haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  refine isCMModule_iff_forall_localization A B M Bₚ Mₚ f fun P hP => ?_
  rw [AlgebraicGeometry.supportDim_eq_of_isIntegral A B M,
    supportDim_eq_iSup_localization B M Bₚ Mₚ f]
  refine le_antisymm (le_iSup (fun Q => Module.supportDim (Bₚ Q) (Mₚ Q)) P) (iSup_le fun Q => ?_)
  rcases subsingleton_or_nontrivial (Mₚ Q) with hQ | hQ
  · rw [Module.supportDim_eq_bot_of_subsingleton]; exact bot_le
  · exact (hdim Q P hQ hP).le

section construction'

local notation "T" p:max S:max => Algebra.algebraMapSubmonoid S (Ideal.primeCompl p)

private theorem isCMModule_iff_of_finite_algebra
    {R : Type*} [CommRing R] (p : Ideal R) [p.IsPrime]
    {S : Type*} [CommRing S] [Algebra R S] [Module.Finite R S]
    (A : Type*) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [Algebra R A]
    [IsLocalization.AtPrime A p]
    (M : Type*) [AddCommGroup M] [Module R M] [Module A M] [IsScalarTower R A M]
    (N : Type*) [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    [Module.Finite S N] (g : N →ₗ[R] M) (hg : IsLocalizedModule p.primeCompl g)
    {ι : Type*} (e : ι ≃ {Q : PrimeSpectrum S // Q.asIdeal.comap (algebraMap R S) = p})
    (O : ι → Type*) [∀ i, CommRing (O i)] [∀ i, Algebra S (O i)]
    [∀ i, IsLocalization.AtPrime (O i) (e i).1.asIdeal] [∀ i, IsLocalRing (O i)]
    (F : ι → Type*) [∀ i, AddCommGroup (F i)] [∀ i, Module S (F i)] [∀ i, Module (O i) (F i)]
    [∀ i, IsScalarTower S (O i) (F i)]
    (h : ∀ i, N →ₗ[S] F i) (hh : ∀ i, IsLocalizedModule (e i).1.asIdeal.primeCompl (h i))
    (hdim : ∀ i j, Nontrivial (F i) → Nontrivial (F j) →
      Module.supportDim (O i) (F i) = Module.supportDim (O j) (F j)) :
    IsCMModule A M ↔ ∀ i, IsCMModule (O i) (F i) := by
  haveI := hg
  haveI := hh
  have hunits : ∀ y : p.primeCompl, IsUnit (algebraMap R (Localization (T p S)) y) := fun y => by
    rw [IsScalarTower.algebraMap_apply R S (Localization (T p S))]
    exact IsLocalization.map_units (Localization (T p S)) (⟨algebraMap R S y, y, y.2, rfl⟩ : T p S)
  letI : Algebra A (Localization (T p S)) :=
    (IsLocalization.lift (M := p.primeCompl) (S := A) hunits).toAlgebra
  haveI : IsScalarTower R A (Localization (T p S)) := IsScalarTower.of_algebraMap_eq fun r =>
    (IsLocalization.lift_eq (M := p.primeCompl) (S := A) hunits r).symm
  haveI : IsLocalizedModule p.primeCompl
      (IsScalarTower.toAlgHom R S (Localization (T p S))).toLinearMap :=
    isLocalizedModule_iff_isLocalization.mpr inferInstance
  haveI : Module.Finite A (Localization (T p S)) := Module.Finite.of_isLocalizedModule
    p.primeCompl (Rₚ := A) (IsScalarTower.toAlgHom R S (Localization (T p S))).toLinearMap
  letI : Module A (LocalizedModule (T p S) N) :=
    Module.compHom _ (algebraMap A (Localization (T p S)))
  haveI : IsScalarTower A (Localization (T p S)) (LocalizedModule (T p S) N) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  haveI : IsScalarTower R A (LocalizedModule (T p S) N) :=
    IsScalarTower.of_algebraMap_smul fun r m => by
      change algebraMap A (Localization (T p S)) (algebraMap R A r) • m = r • m
      rw [← IsScalarTower.algebraMap_apply, algebraMap_smul]
  haveI : Module.Finite (Localization (T p S)) (LocalizedModule (T p S) N) :=
    Module.Finite.of_isLocalizedModule (T p S) (LocalizedModule.mkLinearMap (T p S) N)
  haveI : IsLocalizedModule p.primeCompl
      ((LocalizedModule.mkLinearMap (T p S) N).restrictScalars R) :=
    isLocalizedModule_restrictScalars_of_algebraMapSubmonoid p.primeCompl _
  let eM : M ≃ₗ[A] LocalizedModule (T p S) N :=
    LinearEquiv.extendScalarsOfIsLocalization p.primeCompl A
      (IsLocalizedModule.linearEquiv p.primeCompl g
        ((LocalizedModule.mkLinearMap (T p S) N).restrictScalars R))
  rw [isCMModule_congr eM]
  -- the localizations at the maximal ideals
  have hdisj : ∀ i, Disjoint ((T p S : Submonoid S) : Set S) ((e i).1.asIdeal : Set S) :=
    fun i => disjoint_algebraMapSubmonoid p (e i).2
  have hle : ∀ i, T p S ≤ (e i).1.asIdeal.primeCompl := fun i t ht htQ =>
    Set.disjoint_left.mp (hdisj i) ht htQ
  letI : ∀ i, Algebra (Localization (T p S)) (O i) := fun i =>
    (IsLocalization.lift (M := T p S) (S := Localization (T p S)) (g := algebraMap S (O i))
      fun t => IsLocalization.map_units (O i) (⟨t.1, hle i t.2⟩ :
        (e i).1.asIdeal.primeCompl)).toAlgebra
  haveI : ∀ i, IsScalarTower S (Localization (T p S)) (O i) := fun i =>
    IsScalarTower.of_algebraMap_eq fun s => (IsLocalization.lift_eq _ s).symm
  letI : ∀ i, Module (Localization (T p S)) (F i) := fun i =>
    Module.compHom _ (algebraMap (Localization (T p S)) (O i))
  haveI : ∀ i, IsScalarTower (Localization (T p S)) (O i) (F i) := fun i =>
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  haveI : ∀ i, IsScalarTower S (Localization (T p S)) (F i) := fun i =>
    IsScalarTower.of_algebraMap_smul fun s m => by
      change algebraMap (Localization (T p S)) (O i) (algebraMap S _ s) • m = s • m
      rw [← IsScalarTower.algebraMap_apply, algebraMap_smul]
  haveI : ∀ i, (Ideal.map (algebraMap S (Localization (T p S))) (e i).1.asIdeal).IsPrime :=
    fun i => IsLocalization.isPrime_of_isPrime_disjoint _ _ _ (e i).1.2 (hdisj i)
  have hlocO : ∀ i, IsLocalization.AtPrime (O i)
      (Ideal.map (algebraMap S (Localization (T p S))) (e i).1.asIdeal) := fun i => by
    have h1 : IsLocalizedModule (T p S) (Algebra.linearMap S (Localization (T p S))) :=
      (isLocalizedModule_iff_isLocalization' _ _).mpr inferInstance
    have h2 : IsLocalizedModule (e i).1.asIdeal.primeCompl
        ((Algebra.linearMap (Localization (T p S)) (O i)).restrictScalars S ∘ₗ
          Algebra.linearMap S (Localization (T p S))) := by
      have : (Algebra.linearMap (Localization (T p S)) (O i)).restrictScalars S ∘ₗ
          Algebra.linearMap S (Localization (T p S)) = Algebra.linearMap S (O i) :=
        LinearMap.ext fun s =>
          (IsScalarTower.algebraMap_apply S (Localization (T p S)) (O i) s).symm
      rw [this]
      exact (isLocalizedModule_iff_isLocalization' _ _).mpr inferInstance
    exact (isLocalizedModule_iff_isLocalization' _ _).mp
      (Stacks.ModuleStalkSpecialization.isLocalizedModule_atPrime_map_of_submonoid_le
        (hle i) (Localization (T p S)) (Algebra.linearMap S (Localization (T p S)))
        (Algebra.linearMap (Localization (T p S)) (O i)))
  have hu : ∀ i (t : T p S), IsUnit (algebraMap S (Module.End S (F i)) t) :=
    fun i t => IsLocalizedModule.map_units (h i) ⟨t.1, hle i t.2⟩
  let φ : ∀ i, LocalizedModule (T p S) N →ₗ[Localization (T p S)] F i := fun i =>
    LinearMap.extendScalarsOfIsLocalization (T p S) (Localization (T p S))
      (IsLocalizedModule.lift (T p S) (LocalizedModule.mkLinearMap (T p S) N) (h i) (hu i))
  have hφ : ∀ i, (φ i).restrictScalars S ∘ₗ LocalizedModule.mkLinearMap (T p S) N = h i :=
    fun i => IsLocalizedModule.lift_comp _ _ _ (hu i)
  have hlocF : ∀ i, IsLocalizedModule.AtPrime
      (Ideal.map (algebraMap S (Localization (T p S))) (e i).1.asIdeal) (φ i) := fun i => by
    haveI : IsLocalizedModule (e i).1.asIdeal.primeCompl
        ((φ i).restrictScalars S ∘ₗ LocalizedModule.mkLinearMap (T p S) N) := by
      rw [hφ i]
      infer_instance
    exact Stacks.ModuleStalkSpecialization.isLocalizedModule_atPrime_map_of_submonoid_le
      (hle i) (Localization (T p S)) (LocalizedModule.mkLinearMap (T p S) N) (φ i)
  -- index the maximal ideals by `ι`
  let σ := maximalSpectrumEquiv p (S := S) A
  let j : MaximalSpectrum (Localization (T p S)) ≃ ι := σ.trans e.symm
  have hj : ∀ P : MaximalSpectrum (Localization (T p S)),
      P.asIdeal = Ideal.map (algebraMap S _) (e (j P)).1.asIdeal := fun P => by
    have h1 : e (j P) = σ P := e.apply_symm_apply _
    rw [h1]
    exact (IsLocalization.map_under (T p S) _ P.asIdeal).symm
  haveI : ∀ P : MaximalSpectrum (Localization (T p S)),
      IsLocalization.AtPrime (O (j P)) P.asIdeal := fun P =>
    Stacks.StalkSpecialization.isLocalization_atPrime_of_eq (hj P).symm (hlocO (j P))
  haveI : ∀ P : MaximalSpectrum (Localization (T p S)),
      IsLocalizedModule P.asIdeal.primeCompl (φ (j P)) := fun P =>
    Stacks.ModuleStalkSpecialization.isLocalizedModule_atPrime_of_eq (hj P).symm (hlocF (j P))
  rw [isCMModule_iff_forall_localization_of_supportDim_eq A (Localization (T p S)) _
    (fun P => O (j P)) (fun P => F (j P)) (fun P => φ (j P)) fun P Q hP hQ => hdim _ _ hP hQ]
  exact j.forall_congr_right (q := fun i => IsCMModule (O i) (F i))

end construction'

/-- The points of the fibre of `f` over `y ∈ V`, `V` affine, are the primes of `Γ(X, f⁻¹V)` over
the prime of `y`. -/
private noncomputable def fibreEquiv {X Y : Scheme.{u}} (f : X ⟶ Y) [IsAffineHom f] {V : Y.Opens}
    (hV : IsAffineOpen V) {y : Y} (hy : y ∈ V) :
    letI : Algebra Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
    {x : X // f x = y} ≃ {Q : PrimeSpectrum Γ(X, f ⁻¹ᵁ V) //
      Q.asIdeal.comap (algebraMap Γ(Y, V) Γ(X, f ⁻¹ᵁ V)) = (hV.primeIdealOf ⟨y, hy⟩).asIdeal} :=
  letI : Algebra Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  have hU : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
  have hmem : ∀ x : {x : X // f x = y}, x.1 ∈ f ⁻¹ᵁ V := fun x => by
    change f x.1 ∈ V; rw [x.2]; exact hy
  Equiv.ofBijective
    (fun x => ⟨hU.primeIdealOf ⟨x.1, hmem x⟩, by
      obtain ⟨x, rfl⟩ := x
      exact congrArg PrimeSpectrum.asIdeal (comap_primeIdealOf_app f hV hU (hmem ⟨x, rfl⟩))⟩)
    ⟨fun x x' h => Subtype.ext (by
        have := congrArg (fun Q => hU.fromSpec Q.1) h
        simpa only [IsAffineOpen.fromSpec_primeIdealOf] using this),
      fun Q => by
        have hQ : hU.fromSpec Q.1 ∈ f ⁻¹ᵁ V := hU.fromSpec_mem Q.1
        have hpt : hU.primeIdealOf ⟨_, hQ⟩ = Q.1 :=
          hU.fromSpec.isOpenEmbedding.injective (hU.fromSpec_primeIdealOf ⟨_, hQ⟩)
        refine ⟨⟨hU.fromSpec Q.1, ?_⟩, Subtype.ext hpt⟩
        have h1 := comap_primeIdealOf_app f hV hU hQ
        rw [hpt] at h1
        have h2 : hV.primeIdealOf ⟨f (hU.fromSpec Q.1), hQ⟩ = hV.primeIdealOf ⟨y, hy⟩ := by
          rw [← h1]; exact PrimeSpectrum.ext Q.2
        have := congrArg hV.fromSpec h2
        simpa only [IsAffineOpen.fromSpec_primeIdealOf] using this⟩

private theorem isCMModule_stalk_pushforward_iff_of_supportDim {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsFinite f] [IsLocallyNoetherian Y] (F : X.Modules) [SheafOfModules.IsCoherent F] (y : Y)
    (hdim : ∀ x x' : {x : X // f x = y},
      Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x.1) →
      Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x'.1) →
      Module.supportDim (X.presheaf.stalk x.1)
          (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x.1) =
        Module.supportDim (X.presheaf.stalk x'.1)
          (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x'.1)) :
    IsCMModule (Y.presheaf.stalk y)
        (TopCat.Presheaf.stalk (C := Ab.{u})
          ((Scheme.Modules.pushforward f).obj F).val.presheaf y) ↔
      ∀ x : {x : X // f x = y},
        IsCMModule (X.presheaf.stalk x.1)
          (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x.1) := by
  haveI : F.IsQuasicoherent := isQuasicoherent_of_isCoherent F
  haveI : F.IsFiniteType := SheafOfModules.IsCoherent.isFiniteType
  obtain ⟨_, ⟨V, hV, rfl⟩, hyV, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
  have hU : IsAffineOpen (f ⁻¹ᵁ V) := hV.preimage f
  have hmem : ∀ x : {x : X // f x = y}, x.1 ∈ f ⁻¹ᵁ V := fun x => by
    change f x.1 ∈ V; rw [x.2]; exact hyV
  letI : Algebra Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  haveI : Module.Finite Γ(Y, V) Γ(X, f ⁻¹ᵁ V) := IsFinite.finite_app f V hV
  letI : Algebra Γ(Y, V) (Y.presheaf.stalk y) := (Y.presheaf.germ V y hyV).hom.toAlgebra
  haveI : IsLocalization.AtPrime (Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hyV⟩).asIdeal :=
    hV.isLocalization_stalk ⟨y, hyV⟩
  haveI : ((Scheme.Modules.pushforward f).obj F).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffinePushforward.pushforward_isQuasicoherent_of_isAffineHom f F
  letI := stalkModule ((Scheme.Modules.pushforward f).obj F) y
  letI := sectionsStalkModule ((Scheme.Modules.pushforward f).obj F) hyV
  haveI := isScalarTower_sectionsStalk ((Scheme.Modules.pushforward f).obj F) hyV
  letI : Module Γ(X, f ⁻¹ᵁ V) Γ((Scheme.Modules.pushforward f).obj F, V) :=
    (inferInstance : Module Γ(X, f ⁻¹ᵁ V) Γ(F, f ⁻¹ᵁ V))
  haveI : IsScalarTower Γ(Y, V) Γ(X, f ⁻¹ᵁ V) Γ((Scheme.Modules.pushforward f).obj F, V) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  haveI : Module.Finite Γ(X, f ⁻¹ᵁ V) Γ((Scheme.Modules.pushforward f).obj F, V) :=
    moduleFinite_sections_on_affine F _ hU
  letI : ∀ x : {x : X // f x = y}, Algebra Γ(X, f ⁻¹ᵁ V) (X.presheaf.stalk x.1) := fun x =>
    (X.presheaf.germ _ x.1 (hmem x)).hom.toAlgebra
  haveI : ∀ x : {x : X // f x = y}, IsLocalization.AtPrime (X.presheaf.stalk x.1)
      (fibreEquiv f hV hyV x).1.asIdeal := fun x => hU.isLocalization_stalk ⟨x.1, hmem x⟩
  letI : ∀ x : {x : X // f x = y}, Module (X.presheaf.stalk x.1) (F.presheaf.stalk x.1) :=
    fun x => stalkModule F x.1
  letI : ∀ x : {x : X // f x = y}, Module Γ(X, f ⁻¹ᵁ V) (F.presheaf.stalk x.1) :=
    fun x => sectionsStalkModule F (hmem x)
  haveI : ∀ x : {x : X // f x = y},
      IsScalarTower Γ(X, f ⁻¹ᵁ V) (X.presheaf.stalk x.1) (F.presheaf.stalk x.1) :=
    fun x => isScalarTower_sectionsStalk F (hmem x)
  exact isCMModule_iff_of_finite_algebra (hV.primeIdealOf ⟨y, hyV⟩).asIdeal
    (S := Γ(X, f ⁻¹ᵁ V)) (Y.presheaf.stalk y) _ Γ((Scheme.Modules.pushforward f).obj F, V)
    (germₗ ((Scheme.Modules.pushforward f).obj F) hyV)
    (isLocalizedModule_germₗ ((Scheme.Modules.pushforward f).obj F) hV hyV) (fibreEquiv f hV hyV)
    (fun x => X.presheaf.stalk x.1) (fun x => F.presheaf.stalk x.1)
    (fun x => germₗ F (hmem x)) (fun x => isLocalizedModule_germₗ F hU (hmem x)) hdim

section dim

variable {X : Scheme.{u}}

private theorem fromSpec_le_fromSpec_iff {U : X.Opens} (hU : IsAffineOpen U)
    {a b : PrimeSpectrum Γ(X, U)} : hU.fromSpec a ≤ hU.fromSpec b ↔ b ≤ a := by
  haveI := hU.isOpenImmersion_fromSpec
  rw [Scheme.le_iff_specializes, PrimeSpectrum.le_iff_specializes]
  exact hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff

private theorem fromSpec_lt_fromSpec_iff {U : X.Opens} (hU : IsAffineOpen U)
    {a b : PrimeSpectrum Γ(X, U)} : hU.fromSpec a < hU.fromSpec b ↔ b < a := by
  rw [lt_iff_le_not_ge, lt_iff_le_not_ge, fromSpec_le_fromSpec_iff hU,
    fromSpec_le_fromSpec_iff hU]

/-- On an affine open `U`, the stalk of a quasi-coherent module at the point of a prime `q` is
nonzero exactly when `q` lies in the support of the sections over `U`. -/
private theorem nontrivial_stalk_fromSpec_iff (F : X.Modules) [F.IsQuasicoherent] {U : X.Opens}
    (hU : IsAffineOpen U) (q : PrimeSpectrum Γ(X, U)) :
    Nontrivial (F.presheaf.stalk (hU.fromSpec q)) ↔ q ∈ Module.support Γ(X, U) Γ(F, U) := by
  letI := sectionsStalkModule F (hU.fromSpec_mem q)
  have hloc := isLocalizedModule_germₗ F hU (hU.fromSpec_mem q)
  rw [primeIdealOf_fromSpec hU q] at hloc
  rw [Module.mem_support_iff]
  exact ((IsLocalizedModule.iso _ (germₗ F (hU.fromSpec_mem q))).toEquiv.nontrivial_congr).symm

/-- The dimension of the stalk `F_x` of a quasi-coherent module is the coheight of `x` in the
support of `F`, ordered by generization. -/
private theorem supportDim_stalk_eq_coheight (F : X.Modules) [F.IsQuasicoherent] (x : X)
    (hx : x ∈ {z : X | Nontrivial (F.presheaf.stalk z)}) :
    letI := stalkModule F x
    Module.supportDim (X.presheaf.stalk x) (F.presheaf.stalk x) =
      Order.coheight (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}) := by
  letI := stalkModule F x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  set Q := hU.primeIdealOf ⟨x, hxU⟩ with hQ
  letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x) Q.asIdeal := hU.isLocalization_stalk _
  letI := sectionsStalkModule F hxU
  haveI := isScalarTower_sectionsStalk F hxU
  haveI : IsLocalizedModule Q.asIdeal.primeCompl (germₗ F hxU) := isLocalizedModule_germₗ F hU hxU
  have hxQ : hU.fromSpec Q = x := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
  have hcomapQ : ∀ P : PrimeSpectrum (X.presheaf.stalk x),
      PrimeSpectrum.comap (algebraMap Γ(X, U) (X.presheaf.stalk x)) P ≤ Q := fun P => by
    change Ideal.comap _ P.asIdeal ≤ Q.asIdeal
    calc Ideal.comap _ P.asIdeal ≤ Ideal.comap _ (maximalIdeal (X.presheaf.stalk x)) :=
          Ideal.comap_mono (le_maximalIdeal P.2.ne_top)
      _ = Q.asIdeal := IsLocalization.AtPrime.under_maximalIdeal _ Q.asIdeal
  have hgen : ∀ w : Set.Ici (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}),
      w.1.1 ∈ U := fun w =>
    (Scheme.le_iff_specializes.mp (show x ≤ w.1.1 from w.2)).mem_open U.2 hxU
  have hleQ : ∀ w : Set.Ici (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}),
      hU.primeIdealOf ⟨w.1.1, hgen w⟩ ≤ Q := fun w => by
    rw [← fromSpec_le_fromSpec_iff hU]
    simp only [Q, hU.fromSpec_primeIdealOf]
    exact w.2
  have hprime : ∀ w : Set.Ici (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}),
      (Ideal.map (algebraMap Γ(X, U) (X.presheaf.stalk x))
        (hU.primeIdealOf ⟨w.1.1, hgen w⟩).asIdeal).IsPrime := fun w =>
    IsLocalization.isPrime_of_isPrime_disjoint Q.asIdeal.primeCompl _ _
      (hU.primeIdealOf ⟨w.1.1, hgen w⟩).2
      (Set.disjoint_left.mpr fun _ ha hb => ha (hleQ w hb))
  have hunder : ∀ w : Set.Ici (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}),
      (Ideal.map (algebraMap Γ(X, U) (X.presheaf.stalk x))
        (hU.primeIdealOf ⟨w.1.1, hgen w⟩).asIdeal).comap (algebraMap Γ(X, U) _) =
        (hU.primeIdealOf ⟨w.1.1, hgen w⟩).asIdeal := fun w =>
    IsLocalization.under_map_of_isPrime_disjoint Q.asIdeal.primeCompl _
      (hU.primeIdealOf ⟨w.1.1, hgen w⟩).2
      (Set.disjoint_left.mpr fun _ ha hb => ha (hleQ w hb))
  let ψ : (Set.Ici (⟨x, hx⟩ : {z : X | Nontrivial (F.presheaf.stalk z)}))ᵒᵈ →
      Module.support (X.presheaf.stalk x) (F.presheaf.stalk x) := fun w =>
    ⟨⟨_, hprime (OrderDual.ofDual w)⟩, by
      have h1 : hU.primeIdealOf ⟨(OrderDual.ofDual w).1.1, hgen _⟩ ∈
          Module.support Γ(X, U) Γ(F, U) := by
        rw [← nontrivial_stalk_fromSpec_iff F hU, hU.fromSpec_primeIdealOf]
        exact (OrderDual.ofDual w).1.2
      exact map_mem_support_of_mem_support Q.asIdeal _ (germₗ F hxU) (hleQ _) h1⟩
  rw [Order.coheight_eq_krullDim_Ici, ← Order.krullDim_orderDual, Module.supportDim]
  refine le_antisymm (Order.krullDim_le_of_strictMono
    (fun P => OrderDual.toDual ⟨⟨hU.fromSpec (PrimeSpectrum.comap _ P.1),
      (nontrivial_stalk_fromSpec_iff F hU _).mpr
        (comap_mem_support_of_mem_support Q.asIdeal _ (germₗ F hxU) P.2)⟩, by
      change x ≤ hU.fromSpec _
      exact hxQ.symm.le.trans ((fromSpec_le_fromSpec_iff hU).mpr (hcomapQ P.1))⟩) fun P₁ P₂ h => ?_)
    (Order.krullDim_le_of_strictMono ψ fun w₁ w₂ h => ?_)
  · change hU.fromSpec _ < hU.fromSpec _
    rw [fromSpec_lt_fromSpec_iff hU]
    have h' : P₁.1.asIdeal < P₂.1.asIdeal := h
    change Ideal.comap _ _ < Ideal.comap _ _
    refine lt_of_le_of_ne (Ideal.comap_mono h'.le) fun he => h'.ne ?_
    rw [← IsLocalization.map_under Q.asIdeal.primeCompl (X.presheaf.stalk x) P₁.1.asIdeal,
      ← IsLocalization.map_under Q.asIdeal.primeCompl (X.presheaf.stalk x) P₂.1.asIdeal]
    exact congrArg _ he
  · have h' : (OrderDual.ofDual w₂).1.1 < (OrderDual.ofDual w₁).1.1 := h
    rw [← hU.fromSpec_primeIdealOf ⟨_, hgen (OrderDual.ofDual w₂)⟩,
      ← hU.fromSpec_primeIdealOf ⟨_, hgen (OrderDual.ofDual w₁)⟩,
      fromSpec_lt_fromSpec_iff hU] at h'
    have h'' : (hU.primeIdealOf ⟨_, hgen (OrderDual.ofDual w₁)⟩).asIdeal <
        (hU.primeIdealOf ⟨_, hgen (OrderDual.ofDual w₂)⟩).asIdeal := h'
    change Ideal.map _ _ < Ideal.map _ _
    refine lt_of_le_of_ne (Ideal.map_mono h''.le) fun he => h''.ne ?_
    rw [← hunder (OrderDual.ofDual w₁), ← hunder (OrderDual.ofDual w₂)]
    exact congrArg _ he

/-- The support of a quasi-coherent module of finite type is closed. -/
private theorem isClosed_setOf_nontrivial_stalk (F : X.Modules) [F.IsQuasicoherent]
    [F.IsFiniteType] :
    IsClosed {z : X | Nontrivial (F.presheaf.stalk z)} := by
  rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
  intro x hx
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  haveI : Module.Finite Γ(X, U) Γ(F, U) := moduleFinite_sections_on_affine F U hU
  have hQ : hU.primeIdealOf ⟨x, hxU⟩ ∉ Module.support Γ(X, U) Γ(F, U) := by
    rwa [← nontrivial_stalk_fromSpec_iff F hU, hU.fromSpec_primeIdealOf]
  rw [Module.mem_support_iff_of_finite] at hQ
  obtain ⟨a, ha, haQ⟩ := Set.not_subset.mp hQ
  have key : ∀ q : PrimeSpectrum Γ(X, U), hU.fromSpec q ∈ X.basicOpen a ↔ a ∉ q.asIdeal :=
    fun q => by
      change q ∈ (TopologicalSpace.Opens.map hU.fromSpec.base).obj (X.basicOpen a) ↔ _
      rw [hU.fromSpec_preimage_basicOpen]
      exact PrimeSpectrum.mem_basicOpen _ _
  refine ⟨X.basicOpen a, fun z hz hzS => ?_, (X.basicOpen a).2, ?_⟩
  · have hzU : z ∈ U := X.basicOpen_le a hz
    have hq : hU.primeIdealOf ⟨z, hzU⟩ ∈ Module.support Γ(X, U) Γ(F, U) := by
      rwa [← nontrivial_stalk_fromSpec_iff F hU, hU.fromSpec_primeIdealOf]
    rw [Module.mem_support_iff_of_finite] at hq
    have hz' := (key (hU.primeIdealOf ⟨z, hzU⟩)).mp (by rwa [hU.fromSpec_primeIdealOf])
    exact hz' (hq ha)
  · have h := (key (hU.primeIdealOf ⟨x, hxU⟩)).mpr haQ
    rwa [hU.fromSpec_primeIdealOf] at h

end dim

variable {X Y : Scheme.{u}}

/-- A finite morphism is strictly monotone for the generization order: it preserves
specializations, and two distinct points of a fibre are never specializations of each other. -/
private theorem strictMono_of_isFinite (f : X ⟶ Y) [IsFinite f] : StrictMono f := by
  intro a b hab
  have hle : ∀ {a b : X}, a ≤ b → f a ≤ f b := fun h => by
    rw [Scheme.le_iff_specializes] at h ⊢
    exact h.map f.continuous
  refine lt_of_le_not_ge (hle hab.le) fun hba => hab.not_ge ?_
  have he : f a = f b :=
    ((Scheme.le_iff_specializes.mp (hle hab.le)).antisymm
      (Scheme.le_iff_specializes.mp hba)).eq.symm
  haveI : DiscreteTopology (f ⁻¹' {f a}) := (f.isDiscrete_preimage_singleton (f a)).to_subtype
  have hspec : (⟨b, he.symm⟩ : f ⁻¹' {f a}) ⤳ ⟨a, rfl⟩ :=
    (subtype_specializes_iff _ _).mpr (Scheme.le_iff_specializes.mp hab.le)
  have hmem := hspec.mem_open (isOpen_discrete {(⟨a, rfl⟩ : f ⁻¹' {f a})}) rfl
  exact (congrArg Subtype.val hmem).le

/-- A finite morphism preserves the height of points (the dimension of their closures). -/
private theorem height_apply_of_isFinite (f : X ⟶ Y) [IsFinite f] (x : X) :
    height (f x) = height x := by
  refine le_antisymm ?_ (height_le_height_apply_of_strictMono f (strictMono_of_isFinite f) x)
  refine ENat.forall_natCast_le_iff_le.mp fun n => ?_
  induction n generalizing x with
  | zero =>
    intro
    simp
  | succ n ih =>
    intro hn
    obtain ⟨p, hp, hlen⟩ := exists_series_of_le_height (f x) hn
    have hne : p.length ≠ 0 := by omega
    have hlt : p.eraseLast.last < f x := hp ▸ p.eraseLast_last_rel_last hne
    have hy : p.eraseLast.last ∈ f '' closure {x} := by
      rw [← f.isClosedMap.closure_image_eq_of_continuous f.continuous, Set.image_singleton,
        ← specializes_iff_mem_closure, ← Scheme.le_iff_specializes]
      exact hlt.le
    obtain ⟨x', hx', hfx'⟩ := hy
    have hx'x : x' < x := by
      refine lt_of_le_not_ge (Scheme.le_iff_specializes.mpr (specializes_iff_mem_closure.mpr hx'))
        fun h => hlt.not_ge ?_
      rw [← hfx']
      rw [Scheme.le_iff_specializes] at h ⊢
      exact h.map f.continuous
    have h1 : (n : ℕ∞) ≤ height (f x') := by
      rw [hfx']
      have := length_le_height (p := p.eraseLast) le_rfl
      rwa [RelSeries.eraseLast_length, hlen, Nat.add_sub_cancel] at this
    have h2 := ih x' h1
    calc ((n + 1 : ℕ) : ℕ∞) = n + 1 := by norm_cast
      _ ≤ height x' + 1 := by gcongr
      _ ≤ height x := height_add_one_le hx'x

/-- Let `S` be a closed subset of a scheme locally of finite type over a field all of whose
irreducible components have dimension `r`. Every point of `S` lies below a generic point of
height `r` whose closure lies in `S`. -/
private theorem exists_le_height_eq_of_isClosed (K : Type u) [Field K] [X.Over (Spec (.of K))]
    [LocallyOfFiniteType (X ↘ Spec (.of K))] {S : Set X} (hS : IsClosed S) (r : ℕ)
    (hr : ∀ Z ∈ irreducibleComponents S, topologicalKrullDim Z = r) {z : X} (hz : z ∈ S) :
    ∃ η : X, z ≤ η ∧ height η = r ∧ Set.Iic η ⊆ S := by
  set Z := irreducibleComponent (⟨z, hz⟩ : S)
  have hZ : Z ∈ irreducibleComponents S := irreducibleComponent_mem_irreducibleComponents _
  have hirr : IsIrreducible (Subtype.val '' Z) :=
    hZ.1.image _ continuous_subtype_val.continuousOn
  have hcl : IsClosed (Subtype.val '' Z) :=
    hS.isClosedEmbedding_subtypeVal.isClosedMap _ (isClosed_of_mem_irreducibleComponents _ hZ)
  set η := hirr.genericPoint
  have hη : closure {η} = Subtype.val '' Z := by
    rw [(hirr.isGenericPoint_genericPoint_closure).def, hcl.closure_eq]
  have hsub : Subtype.val '' Z ⊆ S := by rintro _ ⟨w, -, rfl⟩; exact w.2
  refine ⟨η, ?_, ?_, ?_⟩
  · rw [Scheme.le_iff_specializes, specializes_iff_mem_closure, hη]
    exact ⟨_, mem_irreducibleComponent, rfl⟩
  · have h1 := AlgebraicGeometry.topologicalKrullDim_closure_singleton_eq_height η
    rw [hη,
      ← (Topology.IsEmbedding.subtypeVal.homeomorphImage Z).isHomeomorph.topologicalKrullDim_eq,
      hr Z hZ] at h1
    exact_mod_cast h1.symm
  · intro w hw
    apply hsub
    rw [← hη, ← specializes_iff_mem_closure, ← Scheme.le_iff_specializes]
    exact hw

/-- On a scheme locally of finite type over a field, in a closed subset `S` all of whose
irreducible components have dimension `r`, the coheight of a point of `S` (in `S`) and its
height add up to `r`. -/
private theorem coheight_add_height_eq (K : Type u) [Field K] [X.Over (Spec (.of K))]
    [LocallyOfFiniteType (X ↘ Spec (.of K))] {S : Set X} (hS : IsClosed S) (r : ℕ)
    (hr : ∀ Z ∈ irreducibleComponents S, topologicalKrullDim Z = r) {x : X} (hx : x ∈ S) :
    coheight (⟨x, hx⟩ : S) + height x = r := by
  obtain ⟨η, hxη, hη, hηS⟩ := exists_le_height_eq_of_isClosed K hS r hr hx
  obtain ⟨hsum, -⟩ := MMP.height_eq_height_add_coheight_Iic K hxη
  have hxr : height x ≤ r := hη ▸ (le_self_add.trans_eq hsum.symm)
  lift height x to ℕ using (hxr.trans_lt (ENat.natCast_lt_top r)).ne with m hm
  refine le_antisymm ?_ ?_
  · suffices h : coheight (⟨x, hx⟩ : S) ≤ ((r - m : ℕ) : ℕ∞) by
      have hmr : m ≤ r := by exact_mod_cast hxr
      calc coheight (⟨x, hx⟩ : S) + m ≤ ((r - m : ℕ) : ℕ∞) + m := by gcongr
        _ = r := by norm_cast; omega
    refine coheight_le fun p hp => ?_
    obtain ⟨ζ, hζ, hζr, -⟩ := exists_le_height_eq_of_isClosed K hS r hr p.last.2
    let q : LTSeries X := p.map Subtype.val fun _ _ h => h
    have hq : q.head = x := congrArg Subtype.val hp
    have hqζ : q.last ≤ ζ := hζ
    have h1 := MMP.length_le_coheight_Iic q hqζ
    have hxζ : x ≤ ζ := hq ▸ (q.monotone (Fin.zero_le _)).trans hqζ
    have hpt : (⟨q.head, (q.monotone (Fin.zero_le _)).trans hqζ⟩ : Set.Iic ζ) = ⟨x, hxζ⟩ :=
      Subtype.ext hq
    rw [hpt] at h1
    obtain ⟨hsum', -⟩ := MMP.height_eq_height_add_coheight_Iic K hxζ
    rw [hζr, ← hm] at hsum'
    have h2 : (q.length : ℕ∞) + m ≤ r := by
      rw [hsum', add_comm]; gcongr
    have h3 : q.length + m ≤ r := by exact_mod_cast h2
    change ((q.length : ℕ) : ℕ∞) ≤ _
    exact_mod_cast (by omega : q.length ≤ r - m)
  · have h1 : coheight (⟨x, hxη⟩ : Set.Iic η) ≤ coheight (⟨x, hx⟩ : S) :=
      coheight_le_coheight_apply_of_strictMono (fun w : Set.Iic η => (⟨w.1, hηS w.2⟩ : S))
        (fun _ _ h => h) ⟨x, hxη⟩
    rw [← hη, hsum, add_comm]
    gcongr

/-- On a fibre of a finite morphism, the nonzero stalks of a coherent sheaf with pure
`r`-dimensional support all have the same dimension: `dim F_x = r - dim closure{x}`, and
`dim closure{x} = dim closure{f x}`. -/
private theorem supportDim_stalk_eq_of_apply_eq {k : Type u} [Field k] (pX : X ⟶ Spec (.of k))
    [LocallyOfFiniteType pX] (f : X ⟶ Y) [IsFinite f] (F : X.Modules)
    [SheafOfModules.IsCoherent F] (r : ℕ)
    (hF : ∀ Z ∈ irreducibleComponents
        {x : X | Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x)},
      topologicalKrullDim Z = r)
    {x x' : X} (hxx' : f x = f x')
    (hx : Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x))
    (hx' : Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x')) :
    Module.supportDim (X.presheaf.stalk x) (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x) =
      Module.supportDim (X.presheaf.stalk x')
        (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x') := by
  letI : X.Over (Spec (.of k)) := ⟨pX⟩
  haveI : LocallyOfFiniteType (X ↘ Spec (.of k)) := ‹LocallyOfFiniteType pX›
  haveI : F.IsQuasicoherent := isQuasicoherent_of_isCoherent F
  haveI : F.IsFiniteType := SheafOfModules.IsCoherent.isFiniteType
  have e₁ := coheight_add_height_eq k (isClosed_setOf_nontrivial_stalk F) r hF hx
  have e₂ := coheight_add_height_eq k (isClosed_setOf_nontrivial_stalk F) r hF hx'
  rw [← height_apply_of_isFinite f x', ← hxx', height_apply_of_isFinite f x] at e₂
  have hfin : height x ≠ ⊤ := ((le_add_self.trans_eq e₁).trans_lt (ENat.natCast_lt_top r)).ne
  exact (supportDim_stalk_eq_coheight F x hx).trans <| .trans
    (congrArg _ (WithTop.add_right_cancel hfin (e₁.trans e₂.symm)))
    (supportDim_stalk_eq_coheight F x' hx').symm

/-- **Kollár–Mori, Proposition 5.4 (Cohen–Macaulay part, pointwise).** Let `f : X ⟶ Y` be a finite
morphism of schemes locally of finite type over a field `k` and `F` a coherent sheaf on `X` whose
support is pure `r`-dimensional. Then for `y : Y` the stalk `(f_* F)_y` is a Cohen–Macaulay
`𝒪_{Y,y}`-module if and only if `F_x` is a Cohen–Macaulay `𝒪_{X,x}`-module for every `x` with
`f x = y`. -/
@[mmp "lem_km5a_cm_finite_pushforward_pointwise"]
public theorem isCMModule_stalk_pushforward_iff {k : Type u} [Field k] {X Y : Scheme.{u}}
    (pX : X ⟶ Spec (.of k)) (pY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType pX]
    [LocallyOfFiniteType pY] (f : X ⟶ Y) [IsFinite f] (F : X.Modules)
    [SheafOfModules.IsCoherent F] (r : ℕ)
    (hF : ∀ Z ∈ irreducibleComponents
        {x : X | Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x)},
      topologicalKrullDim Z = r)
    (y : Y) :
    IsCMModule (Y.presheaf.stalk y)
        (TopCat.Presheaf.stalk (C := Ab.{u})
          ((Scheme.Modules.pushforward f).obj F).val.presheaf y) ↔
      ∀ x : X, f x = y →
        IsCMModule (X.presheaf.stalk x) (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x) := by
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian pY
  rw [isCMModule_stalk_pushforward_iff_of_supportDim f F y fun x x' hx hx' =>
    supportDim_stalk_eq_of_apply_eq pX f F r hF (x.2.trans x'.2.symm) hx hx']
  exact ⟨fun h x hx => h ⟨x, hx⟩, fun h x => h x.1 x.2⟩

/-- **Kollár–Mori, Proposition 5.4 (Cohen–Macaulay part).** Let `f : X ⟶ Y` be a finite morphism
of schemes locally of finite type over a field `k` and `F` a coherent sheaf on `X` whose support
is pure `r`-dimensional. Then `F` is Cohen–Macaulay if and only if `f_* F` is. -/
@[mmp "prop_km5a_cm_finite_pushforward"]
public theorem isCMSheaf_pushforward_iff {k : Type u} [Field k] {X Y : Scheme.{u}}
    (pX : X ⟶ Spec (.of k)) (pY : Y ⟶ Spec (.of k)) [LocallyOfFiniteType pX]
    [LocallyOfFiniteType pY] (f : X ⟶ Y) [IsFinite f] (F : X.Modules)
    [SheafOfModules.IsCoherent F] (r : ℕ)
    (hF : ∀ Z ∈ irreducibleComponents
        {x : X | Nontrivial (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x)},
      topologicalKrullDim Z = r) :
    IsCMSheaf F ↔ IsCMSheaf ((Scheme.Modules.pushforward f).obj F) := by
  refine ⟨fun h y => (isCMModule_stalk_pushforward_iff pX pY f F r hF y).2 fun x _ => h x,
    fun h x => (isCMModule_stalk_pushforward_iff pX pY f F r hF (f x)).1 (h (f x)) x rfl⟩

end MMP.Mori

end
