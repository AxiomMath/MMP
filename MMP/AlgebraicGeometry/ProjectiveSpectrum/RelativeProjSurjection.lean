/-!
# A surjection of graded algebras induces a closed immersion of relative `Proj`s

Let `φ : A ⟶ B` be a homomorphism of graded `𝒪_X`-algebras which is surjective in every degree,
both satisfying the axioms of a relative `Proj` situation (`Stacks.RelativeProj.Situation`:
commutative, nonnegatively graded, quasi-coherent pieces). Over an affine open `W` of `X`, `φ` is
a surjection `A(W) ⟶ B(W)` of graded rings of sections (a surjection of quasi-coherent modules is
surjective on sections over an affine open), so it induces a closed immersion
`Proj B(W) ⟶ Proj A(W)`. These chart maps are compatible with the restrictions, hence glue to a
morphism `Proj B ⟶ Proj A` over `X` (`MMP.ProjectiveConeSurjection.inducedMap`). The chart of
`Proj B` over `W` is the inverse image of the chart of `Proj A` over `W`, so the glued morphism is
a closed immersion (`MMP.ProjectiveConeSurjection.isClosedImmersion_inducedMap`). For `A`
generated in degree one, the comparison `(Proj ψ)^* 𝒪(n) ⟶ 𝒪(n)` of twisting sheaves of the charts
is an isomorphism (`MMP.ProjectiveConeSurjection.isIso_twistMap_of_surjective`, Stacks 01N1 (3)).

This is the bundle-free part of Fulton's Appendix B.5.5, on Stacks' relative `Proj` only.

## References

* [W. Fulton, *Intersection Theory*, Appendix B.5.5][fulton1998]
* [Stacks Project, Tag 01N1](https://stacks.math.columbia.edu/tag/01N1)
* [Stacks Project, Tag 01NQ](https://stacks.math.columbia.edu/tag/01NQ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace MMP

namespace ProjectiveConeSurjection

section TwistMap

open HomogeneousIdeal

variable {A B σ τ : Type u} [CommRing A] [CommRing B] [SetLike σ A] [AddSubgroupClass σ A]
  [SetLike τ B] [AddSubgroupClass τ B] {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ]

/-- **Stacks 01N1 (3).** For a map `ψ : 𝒜 ⟶ ℬ` of graded rings, surjective in all large degrees,
with `𝒜` generated by `𝒜 1` over `𝒜 0`, the comparison `(Proj ψ)^* 𝒪(n) ⟶ 𝒪(n)` of twisting
sheaves is an isomorphism in every degree. -/
theorem isIso_twistMap_of_surjective (ψ : 𝒜 →+*ᵍ ℬ) (hψ : ℬ₊ ≤ 𝒜₊.map ψ)
    (hev : ∀ᶠ d : ℕ in Filter.atTop, Function.Surjective (GradedRingHom.gradedAddHom ψ d))
    (hgen : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) (n : ℤ) :
    IsIso (Stacks.ProjTwistComparison.twistMap ψ hψ n) := by
  have hdom := Stacks.AlgebraicGeometry.RelativeProjChain.mapDomain_eq_top_of_eventually_surjective
    𝒜 ℬ ψ hev
  haveI htw : IsIso (Stacks.AlgebraicGeometry.ProjTwistCompare.twistMap 𝒜 ℬ ψ n) := by
    have := Stacks.AlgebraicGeometry.ProjTwistMono.isIso_projMapData_twistMap 𝒜 ℬ ψ hev hgen n
    rwa [Stacks.AlgebraicGeometry.ProjTwistCompare.projMapData_twistMap] at this
  have hg := Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.baseChange_comp_mapHom 𝒜 ℬ ψ hψ hdom
  have hpi := Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.baseChange_comp_ι 𝒜 ℬ ψ hdom
  have h1 := Stacks.AlgebraicGeometry.ProjTwistCocycle.transpose_sixFold _ _ _ _ hg hpi
    (ProjectiveSpectrum.Proj.twistingSheaf 𝒜 n) (ProjectiveSpectrum.Proj.twistingSheaf ℬ n)
    (Stacks.AlgebraicGeometry.ProjTwistCompare.twistMap 𝒜 ℬ ψ n)
  have h2 := Stacks.AlgebraicGeometry.ProjThetaCompare.twistTranspose_eq_pushforwardTwistMap
    𝒜 ℬ ψ hψ n _ hg hpi rfl
  have h3 := Stacks.ProjTwistComparison.homEquiv_twistMap ψ hψ n
  have h4 : (Scheme.Modules.pushforwardCongr (rfl : Proj.map ψ hψ = Proj.map ψ hψ)).hom.app
      (ProjectiveSpectrum.Proj.twistingSheaf ℬ n) = 𝟙 _ := rfl
  rw [h2, h4] at h1
  have h5 := h1.trans ((Category.comp_id _).trans
    (h3.symm.trans (Adjunction.homEquiv_unit _ _ _ _)))
  rw [← Stacks.AlgebraicGeometry.ProjTwistCocycle.hom_ext_of_transpose
    (Scheme.Modules.pullbackPushforwardAdjunction (Proj.map ψ hψ)) h5]
  exact IsIso.comp_isIso' (((Scheme.Modules.pullbackCongr hg).app _).isIso_inv)
    (IsIso.comp_isIso' (((Scheme.Modules.pullbackComp _ _).app _).isIso_inv)
    (IsIso.comp_isIso' (Functor.map_isIso _ _)
    (IsIso.comp_isIso' (((Scheme.Modules.pullbackComp _ _).app _).isIso_hom)
    (IsIso.comp_isIso' (((Scheme.Modules.pullbackCongr hpi).app _).isIso_hom)
      (((Scheme.Modules.pullbackId _).app _).isIso_hom)))))

end TwistMap

section SectionRing

open Opposite DirectSum CategoryTheory.Limits Stacks.RelativeProj Stacks.RelativeProj.Situation

variable {X : Scheme.{u}}

/-- The axioms of a relative `Proj` situation for a graded `𝒪_X`-algebra `B`: commutative,
concentrated in nonnegative degrees, with quasi-coherent homogeneous pieces. -/
class SituationAxioms (B : SheafOfModules.GradedAlgebra X.ringCatSheaf) : Prop where
  /-- The multiplication of `B` is commutative. -/
  mul_comm (i j : ℤ) (U : (TopologicalSpace.Opens X)ᵒᵖ) (a : (B.piece i).val.obj U)
      (b : (B.piece j).val.obj U) :
    HEq ((B.mul i j).app U a b) ((B.mul j i).app U b a)
  /-- The homogeneous pieces of `B` in negative degrees vanish. -/
  negative_isZero (n : ℤ) (hn : n < 0) : IsZero (B.piece n)
  /-- Each homogeneous piece of `B` is quasi-coherent. -/
  isQuasicoherent (n : ℤ) : (B.piece n).IsQuasicoherent

/-- The relative `Proj` situation over `X` with graded algebra `B`, with its base `X` visible to
instance search: a reducible anonymous constructor. -/
abbrev sitOf (B : SheafOfModules.GradedAlgebra X.ringCatSheaf) [hB : SituationAxioms B] :
    Stacks.RelativeProj.Situation.{u} :=
  ⟨X, B, hB.mul_comm, hB.negative_isZero, hB.isQuasicoherent⟩

/-- The graded algebra of a relative `Proj` situation satisfies the axioms. -/
instance situationAxioms (s : Stacks.RelativeProj.Situation.{u}) : SituationAxioms s.algebra :=
  ⟨s.mul_comm, s.negative_isZero, s.isQuasicoherent⟩

variable {A B : SheafOfModules.GradedAlgebra X.ringCatSheaf} [hA : SituationAxioms A]
  [hB : SituationAxioms B] (φ : SheafOfModules.GradedAlgebra.UnitalHom A B)

/-- The degree-`n` component of `φ` on the sections over an open `U`. -/
def pieceHom (n : ℕ) (U : X.Opens) :
    (sitOf A).sectionPieces U n →+ (sitOf B).sectionPieces U n :=
  ((φ.app (n : ℤ)).val.app (op U)).hom.toAddMonoidHom

/-- `pieceHom φ n U` evaluates as the component of `φ` in degree `n` on sections over `U`. -/
theorem pieceHom_apply (n : ℕ) (U : X.Opens) (a : (sitOf A).sectionPieces U n) :
    pieceHom φ n U a = (φ.app (n : ℤ)).val.app (op U) a := rfl

/-- `pieceHom` is multiplicative: it carries the product of sections of degrees `n` and `m` to
the product of their images. -/
theorem pieceHom_mul (n m : ℕ) (U : X.Opens) (a : (sitOf A).sectionPieces U n)
    (b : (sitOf A).sectionPieces U m) :
    pieceHom φ (n + m) U ((A.mul (n : ℤ) (m : ℤ)).app (op U) a b) =
      (B.mul (n : ℤ) (m : ℤ)).app (op U) (pieceHom φ n U a) (pieceHom φ m U b) :=
  φ.map_mul (n : ℤ) (m : ℤ) (op U) a b

/-- In degree `0`, `pieceHom` sends the unit section of `A` to the unit section of `B`. -/
theorem pieceHom_one (U : X.Opens) :
    pieceHom φ 0 U (A.one.eval (op U)) = B.one.eval (op U) :=
  φ.map_one (op U)

/-- `φ` on the graded rings of sections over `U`. -/
def sectionRingHom (U : X.Opens) :
    (sitOf A).sectionRing U →+* (sitOf B).sectionRing U :=
  DirectSum.toSemiring (fun n => (DirectSum.of ((sitOf B).sectionPieces U) n).comp (pieceHom φ n U))
    (by
      rw [AddMonoidHom.comp_apply, DirectSum.one_def]
      refine congrArg (DirectSum.of ((sitOf B).sectionPieces U) 0) ?_
      rw [gone_eq_algebra_one (sitOf A) U, gone_eq_algebra_one (sitOf B) U]
      exact pieceHom_one φ U)
    (fun {n m} a b => by
      rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply,
        DirectSum.of_mul_of]
      refine congrArg (DirectSum.of ((sitOf B).sectionPieces U) (n + m)) ?_
      rw [gmul_eq_algebra_mul (sitOf A) U n m a b, gmul_eq_algebra_mul (sitOf B) U n m _ _]
      exact pieceHom_mul φ n m U a b)

/-- `sectionRingHom φ U` sends a homogeneous section `a` of degree `n` to `pieceHom φ n U a`, in
degree `n`. -/
@[simp] theorem sectionRingHom_of (U : X.Opens) (n : ℕ) (a : (sitOf A).sectionPieces U n) :
    sectionRingHom φ U (DirectSum.of ((sitOf A).sectionPieces U) n a) =
      DirectSum.of ((sitOf B).sectionPieces U) n (pieceHom φ n U a) :=
  DirectSum.toSemiring_of _ _ _ n a

/-- `φ` on the graded rings of sections over `U`, as a homomorphism of graded rings. -/
def gradedSectionHom (U : X.Opens) :
    (sitOf A).sectionRingGrading U →+*ᵍ (sitOf B).sectionRingGrading U where
  toRingHom := sectionRingHom φ U
  map_mem := by
    rintro n x ⟨a, rfl⟩
    exact ⟨_, (sectionRingHom_of φ U n a).symm⟩

/-- `gradedSectionHom φ U` sends a homogeneous section `a` of degree `n` to `pieceHom φ n U a`,
in degree `n`. -/
theorem gradedSectionHom_of (U : X.Opens) (n : ℕ) (a : (sitOf A).sectionPieces U n) :
    gradedSectionHom φ U (DirectSum.of ((sitOf A).sectionPieces U) n a) =
      DirectSum.of ((sitOf B).sectionPieces U) n (pieceHom φ n U a) :=
  sectionRingHom_of φ U n a

/-- `φ` commutes with the restriction of sections. -/
theorem gradedSectionRestriction_comp_gradedSectionHom {U V : X.Opens} (h : U ≤ V) :
    (gradedSectionRestriction (sitOf B) U V h).comp (gradedSectionHom φ V) =
      (gradedSectionHom φ U).comp (gradedSectionRestriction (sitOf A) U V h) := by
  refine GradedRingHom.ext fun x => ?_
  induction x using DirectSum.induction_on with
  | zero => simp only [map_zero]
  | of n a =>
    rw [GradedRingHom.comp_apply, GradedRingHom.comp_apply]
    refine ((congrArg (gradedSectionRestriction (sitOf B) U V h)
      (gradedSectionHom_of φ V n a)).trans
      (gradedSectionRestriction_of (sitOf B) U V h n (pieceHom φ n V a))).trans ?_
    refine Eq.trans ?_
      (congrArg (gradedSectionHom φ U) (gradedSectionRestriction_of (sitOf A) U V h n a)).symm
    refine Eq.trans ?_ (gradedSectionHom_of φ U n _).symm
    refine congrArg (DirectSum.of ((sitOf B).sectionPieces U) n) ?_
    exact (PresheafOfModules.naturality_apply (φ.app (n : ℤ)).val (homOfLE h).op a).symm
  | add x y hx hy => simp only [map_add, hx, hy]

variable (hφ : ∀ n : ℤ, Epi (φ.app n))

include hφ

/-- Over an affine open, `φ` is surjective on the graded rings of sections: a surjection of
quasi-coherent modules is surjective on sections over an affine open. -/
theorem surjective_gradedSectionHom {U : X.Opens} (hU : IsAffineOpen U) :
    Function.Surjective (gradedSectionHom φ U) := by
  intro y
  induction y using DirectSum.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | of n b =>
    obtain ⟨a, ha⟩ := @Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen X _ _
      (φ.app (n : ℤ)) (hA.isQuasicoherent _) (hB.isQuasicoherent _) (hφ (n : ℤ)) U hU b
    exact ⟨DirectSum.of _ n a, (gradedSectionHom_of φ U n a).trans (congrArg _ ha)⟩
  | add x y hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, map_add _ _ _⟩

/-- Over an affine open, the irrelevant ideal of the sections of `B` is contained in the image
under `φ` of the irrelevant ideal of the sections of `A`. -/
theorem irrelevant_le_map_gradedSectionHom {U : X.Opens} (hU : IsAffineOpen U) :
    HomogeneousIdeal.irrelevant ((sitOf B).sectionRingGrading U) ≤
      (HomogeneousIdeal.irrelevant ((sitOf A).sectionRingGrading U)).map (gradedSectionHom φ U) :=
  Proj.irrelevant_le_map_of_surjective _ (surjective_gradedSectionHom φ hφ hU)

omit hφ in
/-- `φ` is compatible with the structure maps `𝒪_X(U) → A(U)₀` and `𝒪_X(U) → B(U)₀`. -/
theorem sectionRingZeroMap_comp_gradedSectionHom (U : X.Opens) :
    sectionRingZeroMap (sitOf A) U ≫ CommRingCat.ofHom (gradedSectionHom φ U).gradedZeroRingHom =
      sectionRingZeroMap (sitOf B) U := by
  ext r : 2
  refine Subtype.ext ?_
  have h0 : GradedRing.projZeroRingHom' ((sitOf A).sectionRingGrading U)
      ((sitOf A).sectionRingBaseMap U r) =
      ⟨(sitOf A).sectionRingBaseMap U r, sectionRingBaseMap_mem_zero (sitOf A) U r⟩ :=
    GradedRing.projZeroRingHom'_apply_coe _ ⟨_, sectionRingBaseMap_mem_zero (sitOf A) U r⟩
  have h0' : GradedRing.projZeroRingHom' ((sitOf B).sectionRingGrading U)
      ((sitOf B).sectionRingBaseMap U r) =
      ⟨(sitOf B).sectionRingBaseMap U r, sectionRingBaseMap_mem_zero (sitOf B) U r⟩ :=
    GradedRing.projZeroRingHom'_apply_coe _ ⟨_, sectionRingBaseMap_mem_zero (sitOf B) U r⟩
  change ((gradedSectionHom φ U).gradedZeroRingHom
      ((GradedRing.projZeroRingHom' ((sitOf A).sectionRingGrading U))
        ((sitOf A).sectionRingBaseMap U r)) : (sitOf B).sectionRing U) =
    ((GradedRing.projZeroRingHom' ((sitOf B).sectionRingGrading U))
      ((sitOf B).sectionRingBaseMap U r) : (sitOf B).sectionRing U)
  rw [h0, h0']
  change gradedSectionHom φ U ((sectionRingStructure (sitOf A)).baseMap U r) =
    (sectionRingStructure (sitOf B)).baseMap U r
  rw [(sectionRingStructure (sitOf A)).baseMap_apply U r,
    (sectionRingStructure (sitOf B)).baseMap_apply U r, gradedSectionHom_of]
  refine congrArg (DirectSum.of ((sitOf B).sectionPieces U) 0) ?_
  exact (((φ.app (0 : ℤ)).val.app (op U)).hom.map_smul r _).trans
    (congrArg (fun z => (show X.ringCatSheaf.obj.obj (op U) from r) • z) (pieceHom_one φ U))

end SectionRing

section Morphism

open Opposite Stacks.RelativeProj Stacks.RelativeProj.Situation CategoryTheory.Limits

variable {X : Scheme.{u}} {A B : SheafOfModules.GradedAlgebra X.ringCatSheaf}
  [hA : SituationAxioms A] [hB : SituationAxioms B]
  (φ : SheafOfModules.GradedAlgebra.UnitalHom A B) (hφ : ∀ n : ℤ, Epi (φ.app n))

/-- The morphism of charts `Proj B(W) ⟶ Proj A(W)` over an affine open `W` of `X` induced
by `φ`. -/
def chartMap (W : X.affineOpens) :
    AlgebraicGeometry.Proj ((sitOf B).sectionRingGrading W.1) ⟶
      AlgebraicGeometry.Proj ((sitOf A).sectionRingGrading W.1) :=
  Proj.map (gradedSectionHom φ W.1) (irrelevant_le_map_gradedSectionHom φ hφ W.2)

/-- The chart maps followed by the charts are compatible with the chart transitions. -/
theorem projMap_comp_chartMap_comp {W₁ W₂ : X.affineOpens} (h : W₁ ≤ W₂) :
    Proj.map (gradedSectionRestriction (sitOf B) W₁.1 W₂.1 h)
        (irrelevant_le_map_gradedSectionRestriction (sitOf B) W₁.1 W₂.1 h W₁.2 W₂.2) ≫
      chartMap φ hφ W₂ ≫ relativeProjChart (sitOf A) W₂ =
    chartMap φ hφ W₁ ≫ relativeProjChart (sitOf A) W₁ := by
  rw [← Category.assoc, chartMap, chartMap,
    Stacks.ProjModuleComparison.projMapComp (gradedSectionHom φ W₂.1) _ _ _
      ((gradedSectionHom φ W₁.1).comp (gradedSectionRestriction (sitOf A) W₁.1 W₂.1 h))
      (HomogeneousIdeal.irrelevant_le_map_comp
        (irrelevant_le_map_gradedSectionRestriction (sitOf A) W₁.1 W₂.1 h W₁.2 W₂.2)
        (irrelevant_le_map_gradedSectionHom φ hφ W₁.2))
      (gradedSectionRestriction_comp_gradedSectionHom φ h).symm,
    ← Stacks.ProjModuleComparison.projMapComp (gradedSectionRestriction (sitOf A) W₁.1 W₂.1 h)
      (irrelevant_le_map_gradedSectionRestriction (sitOf A) W₁.1 W₂.1 h W₁.2 W₂.2)
      (gradedSectionHom φ W₁.1) (irrelevant_le_map_gradedSectionHom φ hφ W₁.2) _ _ rfl,
    Category.assoc, projMap_comp_relativeProjChart (t := sitOf A) h]

/-- The morphism `Proj B ⟶ Proj A` of relative `Proj`s over `X` induced by `φ`, glued from the
chart maps. -/
def inducedMap : relativeProj (sitOf B) ⟶ relativeProj (sitOf A) :=
  colimit.desc (chartData (sitOf B)).gluingData.functor
    { pt := relativeProj (sitOf A)
      ι :=
        { app := fun W => chartMap φ hφ W ≫ relativeProjChart (sitOf A) W
          naturality := fun W₁ W₂ f =>
            (projMap_comp_chartMap_comp φ hφ (leOfHom f)).trans (Category.comp_id _).symm } }

/-- On the chart over an affine open `W` of `X`, the induced morphism is the chart map. -/
@[reassoc]
theorem relativeProjChart_comp_inducedMap (W : X.affineOpens) :
    relativeProjChart (sitOf B) W ≫ inducedMap φ hφ =
      chartMap φ hφ W ≫ relativeProjChart (sitOf A) W :=
  colimit.ι_desc _ _

/-- The chart maps lie over the affine opens of the base. -/
theorem chartMap_comp_projInclusionToOpen (W : X.affineOpens) :
    chartMap φ hφ W ≫ projInclusionToOpen (sitOf A) W.1 W.2 =
      projInclusionToOpen (sitOf B) W.1 W.2 := by
  simp only [chartMap, projInclusionToOpen]
  rw [Proj.map_toSpecZero_assoc, ← Spec.map_comp_assoc, sectionRingZeroMap_comp_gradedSectionHom]

/-- The induced morphism lies over `X`. -/
@[reassoc]
theorem inducedMap_comp_relativeProjToBase :
    inducedMap φ hφ ≫ relativeProjToBase (sitOf A) = relativeProjToBase (sitOf B) := by
  have key : ∀ W : X.affineOpens, relativeProjChart (sitOf B) W ≫ inducedMap φ hφ ≫
      relativeProjToBase (sitOf A) = relativeProjChart (sitOf B) W ≫ relativeProjToBase (sitOf B) :=
    fun W => by
      rw [relativeProjChart_comp_inducedMap_assoc, (relativeProjChart_isPullback (sitOf A) W).w,
        ← Category.assoc, chartMap_comp_projInclusionToOpen,
        (relativeProjChart_isPullback (sitOf B) W).w]
  exact colimit.hom_ext key

/-- The chart of `Proj B` over an affine open `W` of `X` is the inverse image of the chart of
`Proj A` over `W`. -/
theorem isPullback_relativeProjChart (W : X.affineOpens) :
    IsPullback (relativeProjChart (sitOf B) W) (chartMap φ hφ W) (inducedMap φ hφ)
      (relativeProjChart (sitOf A) W) := by
  refine IsPullback.of_bot ?_ (relativeProjChart_comp_inducedMap φ hφ W)
    (relativeProjChart_isPullback (sitOf A) W)
  rw [chartMap_comp_projInclusionToOpen, inducedMap_comp_relativeProjToBase]
  exact relativeProjChart_isPullback (sitOf B) W

/-- **The induced morphism is a closed immersion**: over the chart of an affine open `W` of `X` it
is `Proj` of the surjection `A(W) ⟶ B(W)`. -/
theorem isClosedImmersion_inducedMap : IsClosedImmersion (inducedMap φ hφ) := by
  refine IsZariskiLocalAtTarget.of_iSup_eq_top
    (fun W : X.affineOpens => (relativeProjChart (sitOf A) W).opensRange)
    (iSup_opensRange_relativeProjChart (sitOf A)) fun W => ?_
  have h₂ := isPullback_relativeProjChart φ hφ W
  have h₁ : IsPullback (pullback.fst (inducedMap φ hφ) (relativeProjChart (sitOf A) W))
      (pullback.snd (inducedMap φ hφ) (relativeProjChart (sitOf A) W)) (inducedMap φ hφ)
      (relativeProjChart (sitOf A) W) := IsPullback.of_hasPullback _ _
  have e₁ : Arrow.mk (chartMap φ hφ W) ≅
      Arrow.mk (pullback.snd (inducedMap φ hφ) (relativeProjChart (sitOf A) W)) :=
    Arrow.isoMk (h₂.isoIsPullback _ _ h₁) (Iso.refl _)
  have e₂ := morphismRestrictOpensRange (inducedMap φ hφ) (relativeProjChart (sitOf A) W)
  exact (MorphismProperty.arrow_mk_iso_iff (P := @IsClosedImmersion)
    (e₁.trans e₂.symm)).mp (Proj.isClosedImmersion_map_of_surjective' _
      (surjective_gradedSectionHom φ hφ W.2))

end Morphism

end ProjectiveConeSurjection

