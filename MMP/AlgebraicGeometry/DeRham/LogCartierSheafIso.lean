module

public import MMP.AlgebraicGeometry.DeRham.LogCartierRelation
public import MMP.AlgebraicGeometry.DeRham.LogFormsCriterion
public import MMP.AlgebraicGeometry.DeRham.SNCCharts

/-!
# The sheaf-level logarithmic Cartier isomorphism

Let `k` be a perfect field of characteristic `p`, `V` a smooth proper `k`-scheme of dimension
`n < p`, `S = ⋃ⱼ V(Jⱼ)` a simple normal crossing divisor with complement `U`, and `K^•` the
sheaves of logarithmic forms `Ω^•_{V/k}(log S)` with the differential of `F_*K^•`
(`MMP.DeRham.FrobeniusSplittingData`). A morphism `c : K^q ⟶ ℋ^q(F_*K^•)` which sends every
logarithmic form `s` to the class of any section `z` representing `C⁻¹ s` on the affine opens of
`U` (`MMP.DeRham.FrobeniusSplittingData.cartierRep`) is an isomorphism: this is the inverse
Cartier isomorphism `C⁻¹ : Ω^q_{V}(log S) ≅ ℋ^q(F_*Ω^•_{V}(log S))`.

By the local criterion `MMP.DeRham.FrobeniusSplittingData.isLocalCohomologyRep_cartierRep` it
remains to show that representatives exist locally, and that every cycle is locally a
representative. Near every point there is an affine chart `W` on which the `Jⱼ` are principal,
generated by `tⱼ`, with `W ∩ U = D(∏ⱼ tⱼ)` and with the differentials of the `tⱼ` independent at
every prime (`MMP.DeRham.exists_affineOpen_snc_chart_le`). On such a chart the logarithmic forms
over `W` are exactly the forms on `W ∩ U` with logarithmic poles along the `tⱼ` (Deligne's
criterion, `MMP.DeRham.forall_exists_extension_iff_mem_logForms`), and the logarithmic inverse
Cartier theorem for `Γ(V, W) → Γ(V, W ∩ U)` provides logarithmic representatives of `C⁻¹` of
logarithmic forms, and a logarithmic preimage under `C⁻¹` of every closed logarithmic form.
Representatives on `W ∩ U` restrict to representatives on every affine open of `W ∩ U`.

## Main results

* `MMP.DeRham.FrobeniusSplittingData.exists_cartierRep`: local existence of representatives.
* `MMP.DeRham.FrobeniusSplittingData.exists_cartierRep_of_cycle`: every cycle of `F_*K^•` is
  locally a representative.
* `MMP.DeRham.FrobeniusSplittingData.isIso_of_cartierRep`: **the inverse Cartier
  isomorphism**: a morphism `K^q ⟶ ℋ^q` compatible with representatives is an isomorphism.

## References

* [P. Deligne, L. Illusie, *Relèvements modulo p² et décomposition du complexe de de Rham*,
  Invent. Math. 89 (1987)][DeligneIllusie1987], §4.2.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry Stacks.Frobenius
open TensorProduct

universe u v

namespace MMP.DeRham

/-! ### The logarithmic inverse Cartier theorem on a chart -/

section Algebra

open KaehlerDifferential

variable (p : ℕ) [Fact p.Prime] {k B L : Type u} [Field k] [CharP k p] [PerfectRing k p]
  [CommRing B] [CommRing L] [Algebra k B] [Algebra k L] [Algebra B L] [IsScalarTower k B L]
  [Algebra.Smooth k B] {ι : Type*} [Fintype ι] (t : ι → B) [IsLocalization.Away (∏ j, t j) L]

/-- **The local hypothesis of the gluing theorem on a chart**: if the differentials of the
`tⱼ` are independent at every prime of the smooth `k`-algebra `B`, then every maximal ideal of
`B` avoids some `f` for which the logarithmic inverse Cartier theorem holds on `L[1/f]` up to
powers of `f`, where `L = B[1/∏ⱼ tⱼ]`. -/
theorem forall_isMaximal_exists_isLocalLogCartier
    (hS : ∀ 𝔭 : PrimeSpectrum B,
      LinearIndependent 𝔭.asIdeal.ResidueField
        (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
          ((1 : 𝔭.asIdeal.ResidueField) ⊗ₜ[B] D k B (t j) :
            𝔭.asIdeal.ResidueField ⊗[B] Ω[B⁄k]))) :
    ∀ 𝔪 : Ideal B, 𝔪.IsMaximal → ∃ f ∉ 𝔪,
      ∀ [CharP (Localization.Away (algebraMap B L f)) p],
        IsLocalLogCartier p k (Localization.Away (algebraMap B L f)) t f := by
  intro 𝔪 h𝔪
  have := h𝔪.isPrime
  obtain ⟨f₀, hf₀, n, s, ε, hs, het⟩ := exists_etale_mvPolynomial_fin (k := k) t hS ⟨𝔪, h𝔪.isPrime⟩
  exact exists_isLocalLogCartier_of_etale p (L := L) t 𝔪 hf₀ s ε hs het

omit [Fact p.Prime] [CharP k p] [PerfectRing k p] [IsScalarTower k B L] [Algebra.Smooth k B] in
/-- The `tⱼ` are units of `L = B[1/∏ⱼ tⱼ]`. -/
theorem isUnit_algebraMap_of_isLocalization_away (j : ι) : IsUnit (algebraMap B L (t j)) :=
  isUnit_of_dvd_unit (map_dvd _ (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)))
    (IsLocalization.Away.algebraMap_isUnit (∏ j, t j))

end Algebra

/-! ### Representatives on charts -/

namespace FrobeniusSplittingData

variable {p : ℕ} [Fact p.Prime] {k : Type u} [Field k] [CharP k p] [PerfectField k] {n : ℕ}
  {V : Scheme.{u}} {f : V ⟶ Spec (.of k)} [IsProper f] [SmoothOfRelativeDimension n f]
  {ι : Type v} [Fintype ι] [HasDerivedCategory.{u} V.Modules]
  (D : FrobeniusSplittingData p k n f ι)

include D in
/-- A nonzero ring of sections of `V` has characteristic `p`. -/
theorem charP_sections_of_nontrivial (O : V.Opens) [Nontrivial Γ(V, O)] : CharP Γ(V, O) p :=
  (CharP.charP_iff_prime_eq_zero Fact.out).2 (cast_eq_zero_of_isInCharacteristic D.hV _)

/-- **Representatives on `W ∩ U` are representatives**: if `W ∩ U` is affine and, when its ring
of functions has characteristic `p`, the form `z` represents `C⁻¹ s` on `W ∩ U`, then `z`
represents `C⁻¹ s` on every affine open of `W ∩ U`. -/
theorem cartierRep_of_isInvCartierRep (q : ℕ) {W : V.Opens} (hA : IsAffineOpen (W ⊓ D.U))
    {s z : Γ(D.K q, W)}
    (h : letI := MMP.Mori.sectionAlgebra f (W ⊓ D.U)
      ∀ [CharP Γ(V, W ⊓ D.U) p],
        IsInvCartierRep p q (formsAlgEquiv f q ⟨W ⊓ D.U, hA⟩ (D.e q W s))
          (formsAlgEquiv f q ⟨W ⊓ D.U, hA⟩ (D.e q W z))) :
    D.cartierRep q W s z := by
  intro W'' hW'' _
  let := MMP.Mori.sectionAlgebra f (W ⊓ D.U)
  let := MMP.Mori.sectionAlgebra f W''
  let : Algebra Γ(V, W ⊓ D.U) Γ(V, W'') := (V.presheaf.map (homOfLE hW'').op).hom.toAlgebra
  have := MMP.Flips.ResolutionInputs.isScalarTower_section_res f hW''
  have : Nontrivial Γ(V, W'') := CharP.nontrivial_of_char_ne_one (Fact.out : p.Prime).one_lt.ne'
  have : Nontrivial Γ(V, W ⊓ D.U) := (algebraMap Γ(V, W ⊓ D.U) Γ(V, W'')).domain_nontrivial
  have : CharP Γ(V, W ⊓ D.U) p := D.charP_sections_of_nontrivial _
  have h1 := formsAlgEquiv_restrict f q (W := ⟨W ⊓ D.U, hA⟩) (W' := W'') hW'' (D.e q W s)
  have h2 := formsAlgEquiv_restrict f q (W := ⟨W ⊓ D.U, hA⟩) (W' := W'') hW'' (D.e q W z)
  simp only at h1 h2 ⊢
  rw [h1, h2]
  exact h.map

/-- **Deligne's criterion for the sheaves `K q`**: on a chart, a form on `W ∩ U` is the
restriction of a logarithmic form over `W` exactly when, read as an algebraic form of
`Γ(V, W ∩ U)`, it has logarithmic poles along the `tⱼ`. -/
theorem mem_range_e_iff_mem_logForms (q : ℕ) (W : V.affineOpens) (t : ι → Γ(V, W))
    (hJ : ∀ j, (D.J j).ideal W = Ideal.span {t j})
    (hWU : (W : V.Opens) ⊓ D.U = V.basicOpen (∏ j, t j))
    (hS : letI := MMP.Mori.sectionAlgebra f W
      ∀ 𝔭 : PrimeSpectrum Γ(V, W),
        LinearIndependent 𝔭.asIdeal.ResidueField
          (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
            ((1 : 𝔭.asIdeal.ResidueField) ⊗ₜ[Γ(V, W)] KaehlerDifferential.D k Γ(V, W) (t j) :
              𝔭.asIdeal.ResidueField ⊗[Γ(V, W)] Ω[Γ(V, W)⁄k])))
    (ω : Γ(f.relativeDifferentialForms (q : ℤ), (W : V.Opens) ⊓ D.U)) :
    ω ∈ Set.range (D.e q W) ↔
      letI := MMP.Mori.sectionAlgebra f W
      letI := MMP.Mori.sectionAlgebra f ((W : V.Opens) ⊓ D.U)
      letI : Algebra Γ(V, W) Γ(V, (W : V.Opens) ⊓ D.U) :=
        (V.presheaf.map (homOfLE (inf_le_left : (W : V.Opens) ⊓ D.U ≤ W)).op).hom.toAlgebra
      ((formsAlgEquiv f q ⟨(W : V.Opens) ⊓ D.U, isAffineOpen_of_eq_basicOpen _ hWU⟩ ω :
          ⋀[Γ(V, (W : V.Opens) ⊓ D.U)]^q (Ω[Γ(V, (W : V.Opens) ⊓ D.U)⁄k])) :
        ExteriorAlgebra Γ(V, (W : V.Opens) ⊓ D.U) (Ω[Γ(V, (W : V.Opens) ⊓ D.U)⁄k])) ∈
        logForms k Γ(V, (W : V.Opens) ⊓ D.U) t q := by
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  exact (D.he_range q W ω).trans
    (forall_exists_extension_iff_mem_logForms f W D.J t hJ D.U hWU hS q ω)

/-- The algebraic form of a cycle of `F_*K^•` is closed. -/
theorem deRhamDifferential_formsAlgEquiv_e_eq_zero (q : ℕ) {W : V.Opens}
    (hA : IsAffineOpen (W ⊓ D.U)) {z : Γ(D.K q, W)} (hz : (D.d q).app W z = 0) :
    letI := MMP.Mori.sectionAlgebra f (W ⊓ D.U)
    KaehlerDifferential.deRhamDifferential (A := k) q
      (formsAlgEquiv f q ⟨W ⊓ D.U, hA⟩ (D.e q W z)) = 0 := by
  let := MMP.Mori.sectionAlgebra f (W ⊓ D.U)
  rw [← formsAlgEquiv_d]
  refine (formsAlgEquiv f (q + 1) ⟨W ⊓ D.U, hA⟩).map_eq_zero_iff.2 ?_
  exact (D.he_d q W z).symm.trans ((congrArg (D.e (q + 1) W) hz).trans (map_zero _))

/-- **Local existence of representatives**: every logarithmic form `s` over `W` has, near every
point of `W`, a section `z` representing `C⁻¹ s`. -/
theorem exists_cartierRep (q : ℕ) (W : V.Opens) (s : Γ(D.K q, W)) {x : V} (hx : x ∈ W) :
    ∃ (W' : V.Opens) (h : W' ≤ W), x ∈ W' ∧
      ∃ z, D.cartierRep q W' ((D.K q).presheaf.map (homOfLE h).op s) z := by
  obtain ⟨W₁, t, hle, hxW₁, hJ₁, -, hWU, hS⟩ :=
    exists_affineOpen_snc_chart_le f D.J D.hJ D.U D.hU hx
  refine ⟨W₁, hle, hxW₁, ?_⟩
  set s₁ := (D.K q).presheaf.map (homOfLE hle).op s
  have hA : IsAffineOpen ((W₁ : V.Opens) ⊓ D.U) := isAffineOpen_of_eq_basicOpen _ hWU
  rcases subsingleton_or_nontrivial Γ(V, (W₁ : V.Opens) ⊓ D.U) with hL | hL
  · refine ⟨0, D.cartierRep_of_isInvCartierRep q hA fun {hc} ↦ ?_⟩
    exact absurd hL (not_subsingleton_iff_nontrivial.2
      (CharP.nontrivial_of_char_ne_one (Fact.out : p.Prime).one_lt.ne'))
  have : CharP Γ(V, (W₁ : V.Opens) ⊓ D.U) p := D.charP_sections_of_nontrivial _
  let := MMP.Mori.sectionAlgebra f W₁
  let := MMP.Mori.sectionAlgebra f ((W₁ : V.Opens) ⊓ D.U)
  let : Algebra Γ(V, W₁) Γ(V, (W₁ : V.Opens) ⊓ D.U) :=
    (V.presheaf.map (homOfLE (inf_le_left : (W₁ : V.Opens) ⊓ D.U ≤ W₁)).op).hom.toAlgebra
  have := MMP.Flips.ResolutionInputs.isScalarTower_section_res f
    (inf_le_left : (W₁ : V.Opens) ⊓ D.U ≤ W₁)
  have : IsLocalization.Away (∏ j, t j) Γ(V, (W₁ : V.Opens) ⊓ D.U) :=
    isLocalization_away_of_eq_basicOpen _ hWU inf_le_left
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  have : Algebra.Smooth k Γ(V, W₁) := MMP.Flips.ResolutionInputs.smooth_sectionAlgebra f W₁.2
  have hy := (D.mem_range_e_iff_mem_logForms q W₁ t hJ₁ hWU hS (D.e q W₁ s₁)).1 ⟨s₁, rfl⟩
  obtain ⟨x', hx', hrep⟩ := exists_isInvCartierRep_of_mem_logForms p
    (isUnit_algebraMap_of_isLocalization_away t)
    (forall_isMaximal_exists_isLocalLogCartier p t hS) _ hy
  obtain ⟨z, hz⟩ := (D.mem_range_e_iff_mem_logForms q W₁ t hJ₁ hWU hS
    ((formsAlgEquiv f q ⟨_, hA⟩).symm x')).2
    (by rw [LinearEquiv.apply_symm_apply]; exact hx')
  refine ⟨z, D.cartierRep_of_isInvCartierRep q hA fun {hc} ↦ ?_⟩
  rw [hz, LinearEquiv.apply_symm_apply]
  convert hrep using 1

/-- **Cycles are locally representatives**: every cycle `z` of `F_*K^•` over `W` is, near
every point of `W`, a representative of `C⁻¹ s` for a logarithmic form `s`. -/
theorem exists_cartierRep_of_cycle (q : ℕ) (W : V.Opens)
    (z : ToType ((D.complex.X q).val.obj (op W)))
    (hz : (D.complex.d q (q + 1)).val.app (op W) z = 0) {x : V} (hx : x ∈ W) :
    ∃ (W' : V.Opens) (h : W' ≤ W), x ∈ W' ∧ ∃ (s : Γ(D.K q, W'))
      (y : ToType ((D.complex.X ((ComplexShape.up ℕ).prev q)).val.obj (op W')))
      (z' : ToType ((D.complex.X q).val.obj (op W'))), D.cartierRep q W' s z' ∧
      (D.complex.X q).val.map (homOfLE h).op z = z' + (D.complex.d _ q).val.app (op W') y := by
  obtain ⟨W₁, t, hle, hxW₁, hJ₁, -, hWU, hS⟩ :=
    exists_affineOpen_snc_chart_le f D.J D.hJ D.U D.hU hx
  refine ⟨W₁, hle, hxW₁, ?_⟩
  set z₁ : Γ(D.K q, W₁) := (D.complex.X q).val.map (homOfLE hle).op z
  suffices ∃ s, D.cartierRep q W₁ s z₁ by
    obtain ⟨s, hs⟩ := this
    exact ⟨s, 0, z₁, hs, (add_zero z₁).symm.trans (congrArg (z₁ + ·) (map_zero _).symm)⟩
  have hA : IsAffineOpen ((W₁ : V.Opens) ⊓ D.U) := isAffineOpen_of_eq_basicOpen _ hWU
  rcases subsingleton_or_nontrivial Γ(V, (W₁ : V.Opens) ⊓ D.U) with hL | hL
  · refine ⟨0, D.cartierRep_of_isInvCartierRep q hA fun {hc} ↦ ?_⟩
    exact absurd hL (not_subsingleton_iff_nontrivial.2
      (CharP.nontrivial_of_char_ne_one (Fact.out : p.Prime).one_lt.ne'))
  have : CharP Γ(V, (W₁ : V.Opens) ⊓ D.U) p := D.charP_sections_of_nontrivial _
  -- `z₁` is a cycle
  have hdz : (D.d q).app W₁ z₁ = 0 := by
    have hd : D.complex.d q (q + 1) = D.d q := CochainComplex.of_d
      (fun q ↦ (Scheme.Modules.pushforward (absoluteFrobenius V p D.hV)).obj (D.K q)) D.d q
    have hnat : (D.complex.d q (q + 1)).val.app (op (W₁ : V.Opens)) z₁ =
        (D.complex.X (q + 1)).val.map (homOfLE hle).op
          ((D.complex.d q (q + 1)).val.app (op W) z) :=
      PresheafOfModules.naturality_apply (D.complex.d q (q + 1)).val (homOfLE hle).op z
    rw [hz, map_zero, hd] at hnat
    exact hnat
  let := MMP.Mori.sectionAlgebra f W₁
  let := MMP.Mori.sectionAlgebra f ((W₁ : V.Opens) ⊓ D.U)
  let : Algebra Γ(V, W₁) Γ(V, (W₁ : V.Opens) ⊓ D.U) :=
    (V.presheaf.map (homOfLE (inf_le_left : (W₁ : V.Opens) ⊓ D.U ≤ W₁)).op).hom.toAlgebra
  have := MMP.Flips.ResolutionInputs.isScalarTower_section_res f
    (inf_le_left : (W₁ : V.Opens) ⊓ D.U ≤ W₁)
  have : IsLocalization.Away (∏ j, t j) Γ(V, (W₁ : V.Opens) ⊓ D.U) :=
    isLocalization_away_of_eq_basicOpen _ hWU inf_le_left
  have : Smooth f := SmoothOfRelativeDimension.smooth n f
  have : Algebra.Smooth k Γ(V, W₁) := MMP.Flips.ResolutionInputs.smooth_sectionAlgebra f W₁.2
  have hlog := (D.mem_range_e_iff_mem_logForms q W₁ t hJ₁ hWU hS (D.e q W₁ z₁)).1 ⟨z₁, rfl⟩
  obtain ⟨ν, hν, hrep⟩ := exists_isInvCartierRep_of_closed p
    (isUnit_algebraMap_of_isLocalization_away t)
    (forall_isMaximal_exists_isLocalLogCartier p t hS) _ hlog
    (by convert D.deRhamDifferential_formsAlgEquiv_e_eq_zero q hA hdz using 3)
  obtain ⟨s, hs⟩ := (D.mem_range_e_iff_mem_logForms q W₁ t hJ₁ hWU hS
    ((formsAlgEquiv f q ⟨_, hA⟩).symm ν)).2
    (by rw [LinearEquiv.apply_symm_apply]; exact hν)
  refine ⟨s, D.cartierRep_of_isInvCartierRep q hA fun {hc} ↦ ?_⟩
  rw [hs, LinearEquiv.apply_symm_apply]
  convert hrep using 1

/-- **The logarithmic inverse Cartier isomorphism** `C⁻¹ : K^q ≅ ℋ^q(F_*K^•)`. A morphism `c`
from the sheaf `K q` of logarithmic `q`-forms to the `q`-th cohomology sheaf of the extension of
`F_*K^•` to a `ℤ`-indexed complex is an isomorphism as soon as, read in the cohomology of
`F_*K^•`, it sends every logarithmic form `s` to the class of any cycle representing `C⁻¹ s` on
the affine opens of `U`. -/
theorem isIso_of_cartierRep (q : ℕ)
    (c : D.K q ⟶ (D.complex.extend ComplexShape.embeddingUpNat).homology (q : ℤ))
    (class_eq : ∀ {W : V.Opens} {s : Γ(D.K q, W)}
      {z : ToType ((D.complex.cycles q).val.obj (op W))},
      D.cartierRep q W s ((D.complex.iCycles q).val.app (op W) z) →
        (c ≫ (D.complex.extendHomologyIso ComplexShape.embeddingUpNat (j := q) (j' := (q : ℤ))
          rfl).hom).val.app (op W) s = (D.complex.homologyπ q).val.app (op W) z) :
    IsIso c :=
  D.isIso_of_isLocalCohomologyRep_extend q c
    (D.isLocalCohomologyRep_cartierRep q _ class_eq (D.exists_cartierRep q)
      (D.exists_cartierRep_of_cycle q))

end FrobeniusSplittingData

end MMP.DeRham

end
