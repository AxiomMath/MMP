/-!
# Charts for a family of smooth divisors with smooth intersections

Let `V` be a scheme smooth of relative dimension `n` over a field `k`, and let `J j`, `j ∈ ι`
(finite), be ideal sheaves on `V` such that for every `T ⊆ ι` the intersection
`V_T = ⋂_{j ∈ T} V(J j)` is smooth of relative dimension `n - #T` over `k`, and empty when
`#T > n`. Let `U = V ∖ ⋃ⱼ V(J j)`. Every point `x ∈ V` has an affine open neighbourhood `W` with
sections `tⱼ ∈ Γ(V, W)` such that `J j` is generated by `tⱼ` on `W` (with `tⱼ` a unit when
`x ∉ V(J j)`), `W ∩ U = D(∏ⱼ tⱼ)`, and at every prime `𝔭` of `B = Γ(V, W)` the differentials
`1 ⊗ d tⱼ` of the `tⱼ ∈ 𝔭` are linearly independent in `κ(𝔭) ⊗_B Ω_{B/k}`.

Both statements come from the conormal sequence. For a surjection `B → S = B/I` of `k`-algebras
and a prime `𝔭 ⊇ I` the sequence `κ(𝔭) ⊗ I → κ(𝔭) ⊗ Ω_{B/k} → κ(𝔭) ⊗ Ω_{S/k} → 0` is exact,
so when `B` and `S` are smooth of relative dimensions `n` and `m` the classes `1 ⊗ d a`,
`a ∈ I`, span a space of dimension `n - m`. If `I` is generated by `n - m` elements their
differentials are therefore independent. If `m = n - 1`, formal smoothness of `S` splits the
conormal sequence, so `κ(𝔭) ⊗ I` is a line, and Nakayama's lemma makes `I` principal near `𝔭`.

## Main results

* `MMP.DeRham.finite_finrank_tensor_kaehlerDifferential_of_locally`: the fibres `L ⊗ Ω_{S/A}`
  of a locally standard smooth algebra of relative dimension `n` are `n`-dimensional.
* `MMP.DeRham.finrank_span_tmul_D_ker`: the conormal sequence on a fibre.
* `MMP.DeRham.linearIndependent_tmul_D_of_ker_eq_span`,
  `MMP.DeRham.linearIndependent_tmul_D_of_ideal_eq_span`: independence of the differentials of
  generators of a smooth complete intersection.
* `MMP.DeRham.exists_mul_mem_span_singleton_of_ker`,
  `MMP.DeRham.exists_mul_mem_span_singleton_of_smooth_subscheme`: a smooth hypersurface in a
  smooth scheme is locally principal.
* `MMP.DeRham.locally_isStandardSmoothOfRelativeDimension_sectionAlgebra`: the sections of a
  scheme smooth of relative dimension `m` over `k` on an affine open are locally standard smooth
  of relative dimension `m`.
* `MMP.DeRham.exists_affineOpen_snc_chart`: the charts.
* `MMP.DeRham.exists_affineOpen_snc_chart_le`: the charts, inside any open neighbourhood of
  the point.

## Implementation notes

The sections of `V` over an affine open are a `k`-algebra through `MMP.Mori.sectionAlgebra`. The
closed subscheme `V_T` enters only through its sections `Γ(V_T, V_T ∩ W)`, a quotient of
`Γ(V, W)` by `(⨆_{j ∈ T} J j)(W)` (`Scheme.IdealSheafData.ker_subschemeι_app`), so no
presentation of `V_T ∩ W` as a spectrum is needed. The independence condition is stated in the
form taken by `Proof_lem_mmp_lc_bpf_log_cartier.solution`.

## References

* [P. Deligne, L. Illusie, *Relèvements modulo p² et décomposition du complexe de de Rham*,
  Invent. Math. 89 (1987)][DeligneIllusie1987], §4.2.
-/

@[expose] public section

open TensorProduct KaehlerDifferential

universe u

namespace MMP.DeRham

/-! ### Fibres of the differentials of a locally standard smooth algebra -/

/-- **The fibres of `Ω[S⁄A]` of a locally standard smooth algebra of relative dimension `n` are
`n`-dimensional**, at any field `L` over `S`. -/
theorem finite_finrank_tensor_kaehlerDifferential_of_locally {A S : Type u} [CommRing A]
    [CommRing S] [Algebra A S] {n : ℕ}
    (h : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (algebraMap A S))
    (L : Type*) [Field L] [Algebra S L] :
    Module.Finite L (L ⊗[S] Ω[S⁄A]) ∧ Module.finrank L (L ⊗[S] Ω[S⁄A]) = n := by
  obtain ⟨s, hs, hloc⟩ := h
  obtain ⟨t, hts, htq⟩ : ∃ t ∈ s, algebraMap S L t ≠ 0 := by
    by_contra! H
    have h1 : (1 : S) ∈ RingHom.ker (algebraMap S L) := by
      have := Ideal.span_le.2 (fun x hx ↦ (RingHom.mem_ker.2 (H x hx) :
        x ∈ RingHom.ker (algebraMap S L)))
      rw [hs] at this
      exact this Submodule.mem_top
    simp at h1
  have hst := hloc t hts
  rw [← IsScalarTower.algebraMap_eq, RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    at hst
  have hu : IsUnit (algebraMap S L t) := htq.isUnit
  have : Nontrivial (Localization.Away t) := (IsLocalization.Away.lift t hu).domain_nontrivial
  have := hst
  have : Algebra.IsStandardSmooth A (Localization.Away t) := hst.isStandardSmooth
  have hrank : Module.finrank (Localization.Away t) Ω[Localization.Away t⁄A] = n := by
    rw [Module.finrank, Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n,
      Cardinal.toNat_natCast]
  let : Algebra (Localization.Away t) L := (IsLocalization.Away.lift t hu).toAlgebra
  have : IsScalarTower S (Localization.Away t) L :=
    IsScalarTower.of_algebraMap_eq fun x => (IsLocalization.Away.lift_eq t hu x).symm
  let e : L ⊗[S] Ω[S⁄A] ≃ₗ[L] L ⊗[Localization.Away t] Ω[Localization.Away t⁄A] :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange S (Localization.Away t) L
      L Ω[S⁄A]).symm ≪≫ₗ
      (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A S
        (Localization.Away t)).baseChange _ _ _ _
  exact ⟨Module.Finite.equiv e.symm, by rw [e.finrank_eq, Module.finrank_baseChange, hrank]⟩

/-! ### The conormal sequence on a fibre -/

section Conormal

variable {k B S : Type u} [CommRing k] [CommRing B] [CommRing S] [Algebra k B] [Algebra k S]
  [Algebra B S] [IsScalarTower k B S]

/-- The residue field at a prime containing the kernel of a surjection `B → S`, as an
`S`-algebra. -/
@[instance_reducible]
private noncomputable def residueFieldAlgebraOfKerLe (hsurj : Function.Surjective (algebraMap B S))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) :
    Algebra S 𝔭.ResidueField :=
  ((algebraMap B S).liftOfSurjective hsurj ⟨algebraMap B 𝔭.ResidueField, by
    rw [Ideal.ker_algebraMap_residueField]
    exact h𝔭⟩).toAlgebra

private theorem isScalarTower_residueFieldAlgebraOfKerLe
    (hsurj : Function.Surjective (algebraMap B S))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) :
    letI := residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
    IsScalarTower B S 𝔭.ResidueField := by
  let := residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
  exact IsScalarTower.of_algebraMap_eq fun x ↦
    ((algebraMap B S).liftOfSurjective_comp_apply hsurj ⟨algebraMap B 𝔭.ResidueField, by
      rw [Ideal.ker_algebraMap_residueField]
      exact h𝔭⟩ x).symm

/-- **The conormal sequence on the fibre at `𝔭`.** For a surjection `B → S` of `k`-algebras with
kernel `I`, locally standard smooth over `k` of relative dimensions `n` and `m`, and a prime
`𝔭 ⊇ I` with residue field `κ`, the classes `1 ⊗ d a` of the elements `a ∈ I` span a subspace of
`κ ⊗ Ω[B⁄k]` of dimension `n - m`. -/
theorem finrank_span_tmul_D_ker (hsurj : Function.Surjective (algebraMap B S))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) {n m : ℕ}
    (hB : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (algebraMap k B))
    (hS : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension m) (algebraMap k S)) :
    Module.finrank 𝔭.ResidueField (Submodule.span 𝔭.ResidueField
      {ω | ∃ a ∈ RingHom.ker (algebraMap B S),
        (1 : 𝔭.ResidueField) ⊗ₜ[B] D k B a = ω}) = n - m := by
  set K := 𝔭.ResidueField
  let := residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
  have := isScalarTower_residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
  obtain ⟨hfinB, hrB⟩ := finite_finrank_tensor_kaehlerDifferential_of_locally hB K
  obtain ⟨-, hrS⟩ := finite_finrank_tensor_kaehlerDifferential_of_locally hS K
  set g := KaehlerDifferential.mapBaseChange k B S
  have hg : Function.Surjective g := KaehlerDifferential.mapBaseChange_surjective k B S hsurj
  let e := AlgebraTensorModule.cancelBaseChange B S K K Ω[B⁄k]
  let ψ : K ⊗[B] Ω[B⁄k] →ₗ[K] K ⊗[S] Ω[S⁄k] := (g.baseChange K) ∘ₗ e.symm.toLinearMap
  have hψ : Function.Surjective ψ := by
    refine (?_ : Function.Surjective (g.baseChange K)).comp e.symm.surjective
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective K hg
  set N := Submodule.span K {ω | ∃ a ∈ RingHom.ker (algebraMap B S),
    (1 : K) ⊗ₜ[B] D k B a = ω}
  have hN : N = LinearMap.ker ψ := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨a, ha, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, ψ, LinearMap.coe_comp, Function.comp_apply,
        LinearEquiv.coe_coe, e, AlgebraTensorModule.cancelBaseChange_symm_tmul,
        LinearMap.baseChange_tmul, g, KaehlerDifferential.mapBaseChange_tmul, one_smul,
        KaehlerDifferential.map_D, RingHom.mem_ker.1 ha, map_zero, tmul_zero]
    · intro y hy
      have hex := lTensor_exact K (LinearMap.exact_subtype_ker_map g) hg
      have hz : (g.lTensor K) (e.symm y) = 0 := by
        rw [← LinearMap.baseChange_eq_ltensor]
        exact hy
      obtain ⟨w, hw⟩ := (hex (e.symm y)).1 hz
      have hy' : y = e (((LinearMap.ker g).subtype.lTensor K) w) := by
        rw [hw, LinearEquiv.apply_symm_apply]
      rw [hy']
      clear hy' hw
      induction w using TensorProduct.induction_on with
      | zero => simp
      | add w₁ w₂ h₁ h₂ =>
        rw [map_add, map_add]
        exact N.add_mem h₁ h₂
      | tmul x z =>
        have hz' : (z : S ⊗[B] Ω[B⁄k]) ∈
            LinearMap.range (KaehlerDifferential.kerCotangentToTensor k B S) := by
          rw [KaehlerDifferential.range_kerCotangentToTensor k B S hsurj]
          exact z.2
        obtain ⟨c, hc⟩ := hz'
        obtain ⟨a, rfl⟩ := Ideal.toCotangent_surjective _ c
        rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hc
        simp only [LinearMap.lTensor_tmul, Submodule.coe_subtype, ← hc, e,
          AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
        have : x ⊗ₜ[B] D k B (a : B) = x • ((1 : K) ⊗ₜ[B] D k B (a : B)) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this]
        exact N.smul_mem x (Submodule.subset_span ⟨a, a.2, rfl⟩)
  have := LinearMap.finrank_range_add_finrank_ker ψ
  rw [LinearMap.range_eq_top.2 hψ, finrank_top, hrS, hrB, ← hN] at this
  change Module.finrank K N = n - m
  omega

omit [Algebra k S] [IsScalarTower k B S] in
/-- The classes `1 ⊗ d a`, `a ∈ I`, span the same subspace as the classes of generators of `I`,
since `1 ⊗ d (b a) = b (1 ⊗ d a) + a (1 ⊗ d b)` and `a` vanishes in `κ`. -/
private theorem span_tmul_D_ker_eq_span_range {σ : Type*} (v : σ → B)
    (hker : RingHom.ker (algebraMap B S) = Ideal.span (Set.range v))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) :
    Submodule.span 𝔭.ResidueField {ω | ∃ a ∈ RingHom.ker (algebraMap B S),
        (1 : 𝔭.ResidueField) ⊗ₜ[B] D k B a = ω} =
      Submodule.span 𝔭.ResidueField
        (Set.range fun i ↦ (1 : 𝔭.ResidueField) ⊗ₜ[B] D k B (v i)) := by
  set K := 𝔭.ResidueField
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨a, ha, rfl⟩
    have ha' := ha
    rw [hker] at ha'
    induction ha' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact Submodule.subset_span ⟨i, rfl⟩
    | zero => simp
    | add x y hx hy ihx ihy =>
      rw [map_add, tmul_add]
      exact Submodule.add_mem _ (ihx (hker ▸ hx)) (ihy (hker ▸ hy))
    | smul b x hx ihx =>
      have hx' : x ∈ 𝔭 := h𝔭 (hker ▸ hx)
      rw [smul_eq_mul, Derivation.leibniz, tmul_add, ← smul_tmul, ← smul_tmul,
        ← algebraMap_smul K x, Ideal.algebraMap_residueField_eq_zero.2 hx', zero_smul,
        zero_tmul, add_zero, ← smul_tmul', ← algebraMap_smul K b]
      exact Submodule.smul_mem _ _ (ihx (hker ▸ hx))
  · rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact Submodule.subset_span ⟨v i, hker ▸ Ideal.subset_span ⟨i, rfl⟩, rfl⟩

/-- **Independence of the differentials of generators of a smooth complete intersection.** For a
surjection `B → S` of `k`-algebras, locally standard smooth of relative dimensions `n` and
`n - c`, whose kernel is generated by `c ≤ n` elements `vᵢ`, the classes `1 ⊗ d vᵢ` are linearly
independent in `κ(𝔭) ⊗ Ω[B⁄k]` at every prime `𝔭` containing the kernel. -/
theorem linearIndependent_tmul_D_of_ker_eq_span {σ : Type*} [Fintype σ] (v : σ → B)
    (hsurj : Function.Surjective (algebraMap B S))
    (hker : RingHom.ker (algebraMap B S) = Ideal.span (Set.range v))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) {n : ℕ}
    (hc : Fintype.card σ ≤ n)
    (hB : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (algebraMap k B))
    (hS : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension (n - Fintype.card σ))
      (algebraMap k S)) :
    LinearIndependent 𝔭.ResidueField
      (fun i ↦ (1 : 𝔭.ResidueField) ⊗ₜ[B] D k B (v i)) := by
  have h := finrank_span_tmul_D_ker hsurj 𝔭 h𝔭 hB hS
  rw [span_tmul_D_ker_eq_span_range v hker 𝔭 h𝔭] at h
  rw [linearIndependent_iff_card_eq_finrank_span, Set.finrank, h]
  omega

/-- At a prime `𝔭 ⊇ I`, the map `κ(𝔭) ⊗ I → κ(𝔭) ⊗ I/I²` is injective. -/
theorem injective_baseChange_toCotangent (I : Ideal B) (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : I ≤ 𝔭) :
    Function.Injective (I.toCotangent.baseChange 𝔭.ResidueField) := by
  set K := 𝔭.ResidueField
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro y hy
  have hex := lTensor_exact K (LinearMap.exact_subtype_mkQ (I • (⊤ : Submodule B I)))
    (Submodule.mkQ_surjective _)
  have hy' : ((I • (⊤ : Submodule B I)).mkQ.lTensor K) y = 0 := by
    rw [← LinearMap.baseChange_eq_ltensor]
    exact hy
  obtain ⟨w, rfl⟩ := (hex y).1 hy'
  clear hy hy'
  induction w using TensorProduct.induction_on with
  | zero => simp
  | add w₁ w₂ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
  | tmul x z =>
    rw [LinearMap.lTensor_tmul, Submodule.coe_subtype]
    have key : ∀ m ∈ (I • (⊤ : Submodule B I)), x ⊗ₜ[B] m = 0 := by
      intro m hm
      refine Submodule.smul_induction_on hm (fun a ha m _ ↦ ?_) (fun m₁ m₂ h₁ h₂ ↦ ?_)
      · rw [← smul_tmul, ← algebraMap_smul K a x,
          Ideal.algebraMap_residueField_eq_zero.2 (h𝔭 ha), zero_smul, zero_tmul]
      · rw [tmul_add, h₁, h₂, add_zero]
    exact key z.1 z.2

/-- **Nakayama's lemma for a line.** If `I` is finitely generated, `t ∈ I`, and `κ(𝔭) ⊗ I` is
spanned by `1 ⊗ t`, then `s I ⊆ (t)` for some `s ∉ 𝔭`. -/
theorem exists_mul_mem_span_singleton_of_forall_smul_tmul {I : Ideal B} (hfg : I.FG)
    (𝔭 : Ideal B) [𝔭.IsPrime] {t : B} (ht : t ∈ I)
    (hspan : ∀ y : 𝔭.ResidueField ⊗[B] I,
      ∃ c : 𝔭.ResidueField, c • ((1 : 𝔭.ResidueField) ⊗ₜ[B] (⟨t, ht⟩ : I)) = y) :
    ∃ s ∉ 𝔭, ∀ a ∈ I, s * a ∈ Ideal.span {t} := by
  set K := 𝔭.ResidueField
  set t' : I := ⟨t, ht⟩
  have : Module.Finite B I := Module.Finite.iff_fg.2 hfg
  set P : Submodule B I := Submodule.span B {t'}
  have : Subsingleton (K ⊗[B] (I ⧸ P)) := by
    refine subsingleton_of_forall_eq 0 fun z ↦ ?_
    obtain ⟨y, rfl⟩ : ∃ y, P.mkQ.baseChange K y = z := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective K (Submodule.mkQ_surjective P) z
    obtain ⟨c, rfl⟩ := hspan y
    rw [map_smul, LinearMap.baseChange_tmul, Submodule.mkQ_apply,
      (Submodule.Quotient.mk_eq_zero P).2 (Submodule.subset_span rfl), tmul_zero, smul_zero]
  have hns : (⟨𝔭, inferInstance⟩ : PrimeSpectrum B) ∉ Module.support B (I ⧸ P) := by
    rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct]
    exact not_nontrivial _
  rw [Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hns
  obtain ⟨s, hsann, hs𝔭⟩ := hns
  refine ⟨s, hs𝔭, fun a ha ↦ ?_⟩
  have h0 := Module.mem_annihilator.1 hsann (Submodule.Quotient.mk ⟨a, ha⟩)
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
    Submodule.mem_span_singleton] at h0
  obtain ⟨c, hc⟩ := h0
  exact Ideal.mem_span_singleton'.2 ⟨c, congrArg Subtype.val hc⟩

/-- **The conormal map on a fibre of a formally smooth quotient is injective.** For a surjection
`B → S` of `k`-algebras with kernel `I` and `B`, `S` formally smooth, and a prime `𝔭 ⊇ I`, a
`κ(𝔭)`-linear map `κ(𝔭) ⊗ I → κ(𝔭) ⊗ Ω[B⁄k]` sending `x ⊗ a` to `x (1 ⊗ d a)` is injective. -/
theorem injective_of_tmul_eq_smul_tmul_D_of_formallySmooth [Algebra.FormallySmooth k B]
    [Algebra.FormallySmooth k S]
    (hsurj : Function.Surjective (algebraMap B S))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭)
    (δ' : 𝔭.ResidueField ⊗[B] RingHom.ker (algebraMap B S) →ₗ[𝔭.ResidueField]
      𝔭.ResidueField ⊗[B] Ω[B⁄k])
    (hδ' : ∀ (x : 𝔭.ResidueField) (a : RingHom.ker (algebraMap B S)),
      δ' (x ⊗ₜ a) = x • ((1 : 𝔭.ResidueField) ⊗ₜ[B] D k B (a : B))) :
    Function.Injective δ' := by
  set K := 𝔭.ResidueField
  obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := k) hsurj).1 inferInstance
  have hrδ : ∀ y, (l ∘ₗ TensorProduct.mk B S Ω[B⁄k] 1).baseChange K (δ' y) =
      (RingHom.ker (algebraMap B S)).toCotangent.baseChange K y := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add y₁ y₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add]
    | tmul x a =>
      have hla : l ((1 : S) ⊗ₜ[B] D k B (a : B)) =
          (RingHom.ker (algebraMap B S)).toCotangent a := by
        rw [← KaehlerDifferential.kerCotangentToTensor_toCotangent, ← LinearMap.comp_apply, hl,
          LinearMap.id_apply]
      rw [hδ', map_smul]
      simp only [LinearMap.baseChange_tmul, LinearMap.coe_comp, Function.comp_apply,
        TensorProduct.mk_apply, hla, smul_tmul', smul_eq_mul, mul_one]
  exact fun y₁ y₂ h ↦ injective_baseChange_toCotangent _ 𝔭 h𝔭 (by rw [← hrδ, ← hrδ, h])
/-- **A smooth hypersurface in a smooth algebra is locally principal.** For a surjection `B → S`
of formally smooth `k`-algebras, locally standard smooth of relative dimensions `n ≥ 1` and
`n - 1`, with finitely generated kernel `I`, and a prime `𝔭 ⊇ I`, there are `t ∈ I` and `s ∉ 𝔭`
with `s I ⊆ (t)`.

The conormal map `κ(𝔭) ⊗ I → κ(𝔭) ⊗ Ω[B⁄k]` is injective (the conormal sequence of `B → S` is
split, `S` being formally smooth) with one-dimensional image, so `κ(𝔭) ⊗ I` is spanned by one
`1 ⊗ t`; then Nakayama's lemma spreads this out to a neighbourhood of `𝔭`. -/
theorem exists_mul_mem_span_singleton_of_ker (hsurj : Function.Surjective (algebraMap B S))
    (𝔭 : Ideal B) [𝔭.IsPrime] (h𝔭 : RingHom.ker (algebraMap B S) ≤ 𝔭) {n : ℕ} (hn : 1 ≤ n)
    (hB : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n) (algebraMap k B))
    (hS : RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension (n - 1))
      (algebraMap k S))
    [Algebra.FormallySmooth k B] [Algebra.FormallySmooth k S]
    (hfg : (RingHom.ker (algebraMap B S)).FG) :
    ∃ t ∈ RingHom.ker (algebraMap B S), ∃ s ∉ 𝔭,
      ∀ a ∈ RingHom.ker (algebraMap B S), s * a ∈ Ideal.span {t} := by
  set K := 𝔭.ResidueField
  set I := RingHom.ker (algebraMap B S)
  let := residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
  have := isScalarTower_residueFieldAlgebraOfKerLe hsurj 𝔭 h𝔭
  have hN1 := finrank_span_tmul_D_ker hsurj 𝔭 h𝔭 hB hS
  rw [show n - (n - 1) = 1 by omega] at hN1
  set N := Submodule.span K {ω | ∃ a ∈ I, (1 : K) ⊗ₜ[B] D k B a = ω}
  let δ : I →ₗ[B] K ⊗[B] Ω[B⁄k] :=
    ((IsScalarTower.toAlgHom B S K).toLinearMap.rTensor Ω[B⁄k]) ∘ₗ
      KaehlerDifferential.kerToTensor k B S
  have hδ : ∀ a : I, δ a = (1 : K) ⊗ₜ[B] D k B (a : B) := fun a ↦ by
    change (IsScalarTower.toAlgHom B S K).toLinearMap.rTensor Ω[B⁄k]
      ((1 : S) ⊗ₜ[B] D k B (a : B)) = _
    rw [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, map_one]
  let δ' : K ⊗[B] I →ₗ[K] K ⊗[B] Ω[B⁄k] := δ.liftBaseChange K
  have hδ' : ∀ (x : K) (a : I), δ' (x ⊗ₜ a) = x • ((1 : K) ⊗ₜ[B] D k B (a : B)) := fun x a ↦ by
    simp only [δ', LinearMap.liftBaseChange_tmul, hδ]
  have hδinj : Function.Injective δ' :=
    injective_of_tmul_eq_smul_tmul_D_of_formallySmooth hsurj 𝔭 h𝔭 δ' hδ'
  have hδN : ∀ y, δ' y ∈ N := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | add y₁ y₂ h₁ h₂ =>
      rw [map_add]
      exact N.add_mem h₁ h₂
    | tmul x a =>
      rw [hδ']
      exact N.smul_mem x (Submodule.subset_span ⟨a, a.2, rfl⟩)
  obtain ⟨t, ht, htne⟩ : ∃ t ∈ I, (1 : K) ⊗ₜ[B] D k B t ≠ 0 := by
    by_contra! H
    have : N = ⊥ := by
      rw [Submodule.span_eq_bot]
      rintro _ ⟨a, ha, rfl⟩
      exact H a ha
    rw [this, finrank_bot] at hN1
    exact zero_ne_one hN1
  set t' : I := ⟨t, ht⟩
  have hspan : ∀ y : K ⊗[B] I, ∃ c : K, c • ((1 : K) ⊗ₜ[B] t') = y := by
    intro y
    have hv : (⟨δ' (1 ⊗ₜ t'), hδN _⟩ : N) ≠ 0 := by
      rw [ne_eq, Submodule.mk_eq_zero, hδ', one_smul]
      exact htne
    obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' _ hv).1 hN1 ⟨δ' y, hδN y⟩
    refine ⟨c, hδinj ?_⟩
    rw [map_smul]
    exact congrArg Subtype.val hc
  obtain ⟨s, hs𝔭, h⟩ := exists_mul_mem_span_singleton_of_forall_smul_tmul hfg 𝔭 ht hspan
  exact ⟨t, ht, s, hs𝔭, h⟩

end Conormal

/-! ### Sections of a smooth `k`-scheme and of its smooth closed subschemes -/

section Scheme

open CategoryTheory AlgebraicGeometry Opposite

variable {k : Type u} [Field k]

/-- **The sections of a scheme smooth of relative dimension `m` over `k` on an affine open are
locally standard smooth of relative dimension `m` over `k`.** -/
theorem locally_isStandardSmoothOfRelativeDimension_sectionAlgebra {X : Scheme.{u}}
    (g : X ⟶ Spec (.of k)) {m : ℕ} [SmoothOfRelativeDimension m g]
    {W : X.Opens} (hW : IsAffineOpen W) :
    letI := MMP.Mori.sectionAlgebra g W
    RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension m) (algebraMap k Γ(X, W)) := by
  let := MMP.Mori.sectionAlgebra g W
  have h := HasRingHomProperty.appLE (@SmoothOfRelativeDimension m) g ‹_›
    ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ (by simp)
  exact (RingHom.locally_respectsIso
    RingHom.isStandardSmoothOfRelativeDimension_respectsIso).right _
    (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv h

private theorem isScalarTower_subscheme {X : Scheme.{u}} (g : X ⟶ Spec (.of k))
    (𝒥 : X.IdealSheafData) (W : X.Opens) :
    letI := MMP.Mori.sectionAlgebra g W
    letI := MMP.Mori.sectionAlgebra (𝒥.subschemeι ≫ g) (𝒥.subschemeι ⁻¹ᵁ W)
    letI := (𝒥.subschemeι.app W).hom.toAlgebra
    IsScalarTower k Γ(X, W) Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W) := by
  let := MMP.Mori.sectionAlgebra g W
  let := MMP.Mori.sectionAlgebra (𝒥.subschemeι ≫ g) (𝒥.subschemeι ⁻¹ᵁ W)
  let := (𝒥.subschemeι.app W).hom.toAlgebra
  refine IsScalarTower.of_algebraMap_eq' ?_
  have h := Scheme.Hom.appLE_comp_appLE 𝒥.subschemeι g ⊤ W (𝒥.subschemeι ⁻¹ᵁ W) (by simp)
    le_rfl
  change ((Scheme.ΓSpecIso _).inv ≫ _).hom =
    (𝒥.subschemeι.app W).hom.comp ((Scheme.ΓSpecIso _).inv ≫ g.appLE ⊤ W _).hom
  rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.hom_comp, Category.assoc, h]

/-- **Independence of the differentials of local equations of a smooth complete intersection.**
Let `X` be smooth of relative dimension `n` over `k`, and let `𝒥` be an ideal sheaf whose
subscheme is smooth of relative dimension `n - c` over `k` and which is generated on an affine
open `W` by `c ≤ n` sections `vᵢ`. Then at every prime `𝔭 ⊇ 𝒥(W)` of `Γ(X, W)` the classes
`1 ⊗ d vᵢ` are linearly independent in `κ(𝔭) ⊗ Ω[Γ(X, W)⁄k]`. -/
theorem linearIndependent_tmul_D_of_ideal_eq_span {X : Scheme.{u}} (g : X ⟶ Spec (.of k))
    {n : ℕ} [SmoothOfRelativeDimension n g] (𝒥 : X.IdealSheafData) (W : X.affineOpens)
    {σ : Type*} [Fintype σ] (v : σ → Γ(X, W)) (hv : 𝒥.ideal W = Ideal.span (Set.range v))
    (hc : Fintype.card σ ≤ n)
    (h𝒥 : SmoothOfRelativeDimension (n - Fintype.card σ) (𝒥.subschemeι ≫ g))
    (𝔭 : Ideal Γ(X, W)) [𝔭.IsPrime] (h𝔭 : 𝒥.ideal W ≤ 𝔭) :
    letI := MMP.Mori.sectionAlgebra g W
    LinearIndependent 𝔭.ResidueField
      (fun i ↦ (1 : 𝔭.ResidueField) ⊗ₜ[Γ(X, W)] D k Γ(X, W) (v i)) := by
  let := MMP.Mori.sectionAlgebra g W
  let := MMP.Mori.sectionAlgebra (𝒥.subschemeι ≫ g) (𝒥.subschemeι ⁻¹ᵁ W)
  let := (𝒥.subschemeι.app W).hom.toAlgebra
  have := isScalarTower_subscheme g 𝒥 W
  have hker : RingHom.ker (algebraMap Γ(X, W) Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W)) =
      𝒥.ideal W :=
    𝒥.ker_subschemeι_app W
  exact linearIndependent_tmul_D_of_ker_eq_span (S := Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W)) v
    (𝒥.subschemeι_app_surjective W) (hker.trans hv) 𝔭 (hker.trans_le h𝔭) hc
    (locally_isStandardSmoothOfRelativeDimension_sectionAlgebra g W.2)
    (locally_isStandardSmoothOfRelativeDimension_sectionAlgebra (𝒥.subschemeι ≫ g)
      (W.2.preimage _))

/-- **A smooth divisor of a smooth `k`-scheme is locally principal.** Let `X` be smooth of
relative dimension `n ≥ 1` over `k` and `𝒥` an ideal sheaf whose subscheme is smooth of relative
dimension `n - 1` over `k`. For a point `x` of the support of `𝒥` in an affine open `W` there
are `t ∈ 𝒥(W)` and `s ∈ Γ(X, W)` with `x ∈ D(s)` and `s 𝒥(W) ⊆ (t)`. -/
theorem exists_mul_mem_span_singleton_of_smooth_subscheme {X : Scheme.{u}}
    (g : X ⟶ Spec (.of k)) {n : ℕ} (hn : 1 ≤ n) [SmoothOfRelativeDimension n g]
    (𝒥 : X.IdealSheafData) (h𝒥 : SmoothOfRelativeDimension (n - 1) (𝒥.subschemeι ≫ g))
    (W : X.affineOpens) {x : X} (hxW : x ∈ (W : X.Opens)) (hx : x ∈ 𝒥.support) :
    ∃ t ∈ 𝒥.ideal W, ∃ s : Γ(X, W), x ∈ X.basicOpen s ∧
      ∀ a ∈ 𝒥.ideal W, s * a ∈ Ideal.span {t} := by
  let := MMP.Mori.sectionAlgebra g W
  let := MMP.Mori.sectionAlgebra (𝒥.subschemeι ≫ g) (𝒥.subschemeι ⁻¹ᵁ W)
  let := (𝒥.subschemeι.app W).hom.toAlgebra
  have := isScalarTower_subscheme g 𝒥 W
  have : Smooth g := SmoothOfRelativeDimension.smooth n g
  have : Smooth (𝒥.subschemeι ≫ g) := SmoothOfRelativeDimension.smooth (n - 1) _
  have : Algebra.Smooth k Γ(X, W) := MMP.Flips.ResolutionInputs.smooth_sectionAlgebra g W.2
  have : Algebra.Smooth k Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W) :=
    MMP.Flips.ResolutionInputs.smooth_sectionAlgebra (𝒥.subschemeι ≫ g) (W.2.preimage _)
  have : IsNoetherianRing Γ(X, W) := Algebra.FiniteType.isNoetherianRing k _
  have hker : RingHom.ker (algebraMap Γ(X, W) Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W)) =
      𝒥.ideal W :=
    𝒥.ker_subschemeι_app W
  set 𝔭 := (W.2.primeIdealOf ⟨x, hxW⟩).asIdeal
  have hmem : ∀ f : Γ(X, W), x ∈ X.basicOpen f ↔ f ∉ 𝔭 := fun f ↦ by
    rw [← PrimeSpectrum.mem_basicOpen f (W.2.primeIdealOf ⟨x, hxW⟩),
      ← W.2.fromSpec_preimage_basicOpen f]
    change _ ↔ W.2.fromSpec.base (W.2.primeIdealOf ⟨x, hxW⟩) ∈ X.basicOpen f
    rw [show W.2.fromSpec.base (W.2.primeIdealOf ⟨x, hxW⟩) = x from
      W.2.fromSpec_primeIdealOf ⟨x, hxW⟩]
  have h𝔭 : 𝒥.ideal W ≤ 𝔭 := by
    intro f hf
    have := (Scheme.IdealSheafData.mem_support_iff_of_mem hxW).1 hx
    rw [Scheme.mem_zeroLocus_iff] at this
    by_contra hf𝔭
    exact this f hf ((hmem f).2 hf𝔭)
  obtain ⟨t, ht, s, hs, h⟩ := exists_mul_mem_span_singleton_of_ker
    (S := Γ(𝒥.subscheme, 𝒥.subschemeι ⁻¹ᵁ W)) (𝒥.subschemeι_app_surjective W) 𝔭
    (hker.trans_le h𝔭) hn
    (locally_isStandardSmoothOfRelativeDimension_sectionAlgebra g W.2)
    (locally_isStandardSmoothOfRelativeDimension_sectionAlgebra (𝒥.subschemeι ≫ g)
      (W.2.preimage _)) (IsNoetherian.noetherian _)
  rw [hker] at ht h
  exact ⟨t, ht, s, (hmem s).2 hs, h⟩

private theorem mem_basicOpen_prod {X : Scheme.{u}} {U : X.Opens} {ι : Type*} (s : Finset ι)
    (f : ι → Γ(X, U)) (y : X) :
    y ∈ X.basicOpen (∏ j ∈ s, f j) ↔ y ∈ U ∧ ∀ j ∈ s, y ∈ X.basicOpen (f j) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.prod_empty, Scheme.basicOpen_one, Finset.notMem_empty, IsEmpty.forall_iff,
      implies_true, and_true]
  | insert j s hj ih =>
    rw [Finset.prod_insert hj, Scheme.basicOpen_mul, TopologicalSpace.Opens.mem_inf, ih]
    simp only [Finset.mem_insert, forall_eq_or_imp]
    exact ⟨fun ⟨h₁, h₂, h₃⟩ ↦ ⟨h₂, h₁, h₃⟩, fun ⟨h₁, h₂, h₃⟩ ↦ ⟨h₂, h₁, h₃⟩⟩

/-- **A smooth divisor has a local equation near every point.** Let `V` be smooth of relative
dimension `n` over `k` and `𝒥` an ideal sheaf whose subscheme is smooth of relative dimension
`n - 1` over `k`, and empty if `n = 0`. For `x` in an affine open `W` there are `t ∈ 𝒥(W)` and
`s ∈ Γ(V, W)` with `x ∈ D(s)` and `s 𝒥(W) ⊆ (t)`, and `t = s` when `x ∉ V(𝒥)`. -/
theorem exists_local_equation_of_smooth_subscheme {V : Scheme.{u}} (f : V ⟶ Spec (.of k))
    {n : ℕ} [SmoothOfRelativeDimension n f] (𝒥 : V.IdealSheafData)
    (h𝒥 : SmoothOfRelativeDimension (n - 1) (𝒥.subschemeι ≫ f))
    (h𝒥e : n < 1 → IsEmpty 𝒥.subscheme) (W : V.affineOpens) {x : V}
    (hxW : x ∈ (W : V.Opens)) :
    ∃ t ∈ 𝒥.ideal W, ∃ s : Γ(V, W), x ∈ V.basicOpen s ∧
      (∀ a ∈ 𝒥.ideal W, s * a ∈ Ideal.span {t}) ∧ (x ∉ 𝒥.support → t = s) := by
  by_cases hx : x ∈ 𝒥.support
  · have hn : 1 ≤ n := by
      by_contra hn
      have := h𝒥e (by omega)
      rw [← SetLike.mem_coe, ← 𝒥.range_subschemeι] at hx
      obtain ⟨z, -⟩ := hx
      exact isEmptyElim z
    obtain ⟨t₀, ht₀, s₀, hs₀, h⟩ :=
      exists_mul_mem_span_singleton_of_smooth_subscheme f hn 𝒥 h𝒥 W hxW hx
    exact ⟨t₀, ht₀, s₀, hs₀, h, fun h' ↦ absurd hx h'⟩
  · have : ¬ x ∈ V.zeroLocus (U := W) (𝒥.ideal W : Set Γ(V, W)) :=
      fun h ↦ hx ((Scheme.IdealSheafData.mem_support_iff_of_mem (U := W) hxW).2 h)
    rw [Scheme.mem_zeroLocus_iff] at this
    push Not at this
    obtain ⟨a, ha, hxa⟩ := this
    exact ⟨a, ha, a, hxa, fun b _ ↦ Ideal.mul_mem_right b _ (Ideal.mem_span_singleton_self a),
      fun _ ↦ rfl⟩

/-- **The complement of a family of principal divisors on an affine open.** If each `J j` is
generated on the affine open `W` by `tⱼ`, then `W ∖ ⋃ⱼ V(J j)` is the basic open `D(∏ⱼ tⱼ)`. -/
theorem inf_compl_support_eq_basicOpen_prod {V : Scheme.{u}} {ι : Type*} [Fintype ι]
    (J : ι → V.IdealSheafData) (W : V.affineOpens) (t : ι → Γ(V, W))
    (hideal : ∀ j, (J j).ideal W = Ideal.span {t j}) :
    (W : V.Opens) ⊓ ((⨅ j, J j).support).compl = V.basicOpen (∏ j, t j) := by
  refine SetLike.ext fun y ↦ ?_
  rw [TopologicalSpace.Opens.mem_inf, mem_basicOpen_prod]
  constructor
  · rintro ⟨hyW, hyU⟩
    refine ⟨hyW, fun j _ ↦ ?_⟩
    have hyU' : y ∉ (⨅ j, J j).support := hyU
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := W) hyW, Scheme.mem_zeroLocus_iff,
      Scheme.IdealSheafData.ideal_iInf, iInf_apply] at hyU'
    push Not at hyU'
    obtain ⟨a, ha, hya⟩ := hyU'
    have ha' : a ∈ (J j).ideal W := (Submodule.mem_iInf _).1 (SetLike.mem_coe.1 ha) j
    rw [hideal j, Ideal.mem_span_singleton'] at ha'
    obtain ⟨c, rfl⟩ := ha'
    rw [Scheme.basicOpen_mul] at hya
    exact hya.2
  · rintro ⟨hyW, hy⟩
    refine ⟨hyW, ?_⟩
    change y ∉ (⨅ j, J j).support
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := W) hyW, Scheme.mem_zeroLocus_iff,
      Scheme.IdealSheafData.ideal_iInf, iInf_apply]
    push Not
    refine ⟨∏ j, t j, ?_, (mem_basicOpen_prod _ _ y).2 ⟨hyW, hy⟩⟩
    rw [SetLike.mem_coe, Submodule.mem_iInf]
    intro i
    rw [hideal i, Ideal.mem_span_singleton]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ i)

/-- **Independence of the differentials of local equations of a simple normal crossing family.**
In the setting of `MMP.DeRham.exists_affineOpen_snc_chart`, if each `J j` is generated on the
affine open `W` by `tⱼ`, then at every prime `𝔭` of `Γ(V, W)` the classes `1 ⊗ d tⱼ` of the
`tⱼ ∈ 𝔭` are linearly independent in `κ(𝔭) ⊗ Ω[Γ(V, W)⁄k]`. -/
theorem linearIndependent_tmul_D_of_snc {V : Scheme.{u}} (f : V ⟶ Spec (.of k)) {n : ℕ}
    [SmoothOfRelativeDimension n f] {ι : Type*} [Finite ι] (J : ι → V.IdealSheafData)
    (hJ : ∀ T : Finset ι,
      SmoothOfRelativeDimension (n - T.card) ((⨆ j ∈ T, J j).subschemeι ≫ f) ∧
      (n < T.card → IsEmpty (⨆ j ∈ T, J j).subscheme))
    (W : V.affineOpens) (t : ι → Γ(V, W)) (hideal : ∀ j, (J j).ideal W = Ideal.span {t j}) :
    letI := MMP.Mori.sectionAlgebra f W
    ∀ 𝔭 : PrimeSpectrum Γ(V, W),
      LinearIndependent 𝔭.asIdeal.ResidueField
        (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
          ((1 : 𝔭.asIdeal.ResidueField) ⊗ₜ[Γ(V, W)] D k Γ(V, W) (t j) :
            𝔭.asIdeal.ResidueField ⊗[Γ(V, W)] Ω[Γ(V, W)⁄k])) := by
  classical
  have := Fintype.ofFinite ι
  intro 𝔭
  set T : Finset ι := Finset.univ.filter fun j ↦ t j ∈ 𝔭.asIdeal
  set 𝒥 : V.IdealSheafData := ⨆ j ∈ T, J j
  have hcard : Fintype.card {j : ι // t j ∈ 𝔭.asIdeal} = T.card := Fintype.card_subtype _
  have hv : 𝒥.ideal W = Ideal.span (Set.range fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦ t j) := by
    have h𝒥 : 𝒥.ideal W = ⨆ j ∈ T, (J j).ideal W := by
      simp only [𝒥, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
      refine iSup_congr fun i ↦ ?_
      by_cases hi : i ∈ T
      · simp only [hi, iSup_pos]
      · simp only [hi, not_false_eq_true, iSup_neg, Scheme.IdealSheafData.ideal_bot,
          Pi.bot_apply]
    rw [h𝒥]
    apply le_antisymm
    · refine iSup₂_le fun j hj ↦ ?_
      rw [hideal j]
      exact Ideal.span_mono (Set.singleton_subset_iff.2
        ⟨⟨j, (Finset.mem_filter.1 hj).2⟩, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ ⟨⟨j, hj⟩, rfl⟩
      have hjT : j ∈ T := Finset.mem_filter.2 ⟨Finset.mem_univ j, hj⟩
      have : t j ∈ (J j).ideal W := by
        rw [hideal j]
        exact Ideal.mem_span_singleton_self _
      exact (le_iSup₂ (f := fun j (_ : j ∈ T) ↦ (J j).ideal W) j hjT) this
  have h𝔭 : 𝒥.ideal W ≤ 𝔭.asIdeal := by
    rw [hv, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact j.2
  have hc : Fintype.card {j : ι // t j ∈ 𝔭.asIdeal} ≤ n := by
    by_contra hlt
    have := (hJ T).2 (by omega)
    have h1 : (1 : Γ(V, W)) ∈ 𝒥.ideal W := by
      rw [← 𝒥.ker_subschemeι_app W, RingHom.mem_ker]
      exact Subsingleton.elim _ _
    exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 (h𝔭 h1))
  have h𝒥s := (hJ T).1
  rw [← hcard] at h𝒥s
  exact linearIndependent_tmul_D_of_ideal_eq_span f 𝒥 W (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
    t j) hv hc h𝒥s 𝔭.asIdeal h𝔭

/-- **Charts for a simple normal crossing family inside a given open**: the charts of
`MMP.DeRham.exists_affineOpen_snc_chart` can be taken inside any open neighbourhood `O` of the
point. -/
theorem exists_affineOpen_snc_chart_le {V : Scheme.{u}} (f : V ⟶ Spec (.of k)) {n : ℕ}
    [SmoothOfRelativeDimension n f] {ι : Type*} [Fintype ι] (J : ι → V.IdealSheafData)
    (hJ : ∀ T : Finset ι,
      SmoothOfRelativeDimension (n - T.card) ((⨆ j ∈ T, J j).subschemeι ≫ f) ∧
      (n < T.card → IsEmpty (⨆ j ∈ T, J j).subscheme))
    (U : V.Opens) (hU : U = ((⨅ j, J j).support).compl) {O : V.Opens} {x : V} (hxO : x ∈ O) :
    ∃ (W : V.affineOpens) (t : ι → Γ(V, W)), (W : V.Opens) ≤ O ∧ x ∈ (W : V.Opens) ∧
      (∀ j, (J j).ideal W = Ideal.span {t j}) ∧
      (∀ j, x ∉ (J j).support → IsUnit (t j)) ∧
      (W : V.Opens) ⊓ U = V.basicOpen (∏ j, t j) ∧
      letI := MMP.Mori.sectionAlgebra f W
      ∀ 𝔭 : PrimeSpectrum Γ(V, W),
        LinearIndependent 𝔭.asIdeal.ResidueField
          (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
            ((1 : 𝔭.asIdeal.ResidueField) ⊗ₜ[Γ(V, W)] D k Γ(V, W) (t j) :
              𝔭.asIdeal.ResidueField ⊗[Γ(V, W)] Ω[Γ(V, W)⁄k])) := by
  classical
  subst hU
  obtain ⟨-, ⟨W₀, hW₀, rfl⟩, hxW₀, hW₀O⟩ :=
    V.isBasis_affineOpens.exists_subset_of_mem_open hxO O.isOpen
  set W₀' : V.affineOpens := ⟨W₀, hW₀⟩
  choose t₀ ht₀ s₀ hxs₀ hs₀ hunit₀ using fun j ↦ by
    have hJj := hJ {j}
    rw [Finset.iSup_singleton, Finset.card_singleton] at hJj
    exact exists_local_equation_of_smooth_subscheme f (J j) hJj.1 hJj.2 W₀' hxW₀
  set s : Γ(V, W₀) := ∏ j, s₀ j
  set W : V.affineOpens := V.affineBasicOpen (U := W₀') s
  have hle : W ≤ W₀' := Scheme.affineBasicOpen_le V (V := W₀') s
  set res : Γ(V, W₀) →+* Γ(V, W) := (V.presheaf.map (homOfLE hle).op).hom
  have hxW : x ∈ (W : V.Opens) := by
    change x ∈ V.basicOpen s
    rw [mem_basicOpen_prod]
    exact ⟨hxW₀, fun j _ ↦ hxs₀ j⟩
  have hus : IsUnit (res s) := V.toRingedSpace.isUnit_res_basicOpen s
  have hu : ∀ j, IsUnit (res (s₀ j)) := fun j ↦
    isUnit_of_dvd_unit (map_dvd res (Finset.dvd_prod_of_mem _ (Finset.mem_univ j))) hus
  set t : ι → Γ(V, W) := fun j ↦ res (t₀ j)
  have hideal : ∀ j, (J j).ideal W = Ideal.span {t j} := by
    intro j
    rw [← (J j).map_ideal hle]
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap]
      have h1 : res (s₀ j * a) ∈ (Ideal.span {t₀ j}).map res := Ideal.mem_map_of_mem _ (hs₀ j a ha)
      rw [Ideal.map_span, Set.image_singleton, map_mul] at h1
      exact (Ideal.unit_mul_mem_iff_mem _ (hu j)).1 h1
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.mem_map_of_mem _ (ht₀ j)
  refine ⟨W, t, fun y hy ↦ hW₀O ((show (W : V.Opens) ≤ W₀ from hle) hy), hxW, hideal,
    fun j hj ↦ ?_, inf_compl_support_eq_basicOpen_prod J W t hideal,
    linearIndependent_tmul_D_of_snc f J hJ W t hideal⟩
  change IsUnit (res (t₀ j))
  rw [hunit₀ j hj]
  exact hu j

/-- **Charts for a simple normal crossing family of smooth divisors.** Let `V` be smooth of
relative dimension `n` over a field `k`, and let `J j` (`j ∈ ι`, finite) be ideal sheaves such
that for every `T ⊆ ι` the intersection `⋂_{j ∈ T} V(J j)` (the subscheme of `⨆_{j ∈ T} J j`)
is smooth of relative dimension `n - #T` over `k`, and empty when `#T > n`. Let `U` be the
complement of `⋃ⱼ V(J j)`. Then every point `x` has an affine open neighbourhood `W` with
sections `tⱼ ∈ Γ(V, W)` such that

* `J j` is generated on `W` by `tⱼ`, and `tⱼ` is a unit when `x ∉ V(J j)`;
* `W ∩ U` is the basic open `D(∏ⱼ tⱼ)`;
* at every prime `𝔭` of `Γ(V, W)` the differentials `1 ⊗ d tⱼ` of the `tⱼ ∈ 𝔭` are linearly
  independent in `κ(𝔭) ⊗ Ω[Γ(V, W)⁄k]`. -/
theorem exists_affineOpen_snc_chart {V : Scheme.{u}} (f : V ⟶ Spec (.of k)) {n : ℕ}
    [SmoothOfRelativeDimension n f] {ι : Type*} [Fintype ι] (J : ι → V.IdealSheafData)
    (hJ : ∀ T : Finset ι,
      SmoothOfRelativeDimension (n - T.card) ((⨆ j ∈ T, J j).subschemeι ≫ f) ∧
      (n < T.card → IsEmpty (⨆ j ∈ T, J j).subscheme))
    (U : V.Opens) (hU : U = ((⨅ j, J j).support).compl) (x : V) :
    ∃ (W : V.affineOpens) (t : ι → Γ(V, W)), x ∈ (W : V.Opens) ∧
      (∀ j, (J j).ideal W = Ideal.span {t j}) ∧
      (∀ j, x ∉ (J j).support → IsUnit (t j)) ∧
      (W : V.Opens) ⊓ U = V.basicOpen (∏ j, t j) ∧
      letI := MMP.Mori.sectionAlgebra f W
      ∀ 𝔭 : PrimeSpectrum Γ(V, W),
        LinearIndependent 𝔭.asIdeal.ResidueField
          (fun j : {j : ι // t j ∈ 𝔭.asIdeal} ↦
            ((1 : 𝔭.asIdeal.ResidueField) ⊗ₜ[Γ(V, W)] D k Γ(V, W) (t j) :
              𝔭.asIdeal.ResidueField ⊗[Γ(V, W)] Ω[Γ(V, W)⁄k])) := by
  obtain ⟨W, t, -, h⟩ := exists_affineOpen_snc_chart_le f J hJ U hU (O := ⊤) (x := x) trivial
  exact ⟨W, t, h⟩

end Scheme

