/-!
# Foundations: regular embeddings, projective embeddings, and small threefold steps

This file collects foundational results used by the MMP development.

* The conormal sheaf `𝓘/𝓘²` of a regular embedding of codimension `d` is locally free of
  rank `d`: on a chart where the ideal is generated by a regular sequence `f₁, …, f_d`, the
  classes of the `fⱼ` form a basis of `I/I²` over `A/I`.
* If `W = V(ℐ) ⊊ V` is a regular embedding, the exceptional divisor `E` of `Bl_W V` is
  isomorphic over `W` to `ℙ(ℐ/ℐ²)`, with `𝒪(1)` corresponding to `𝒪_{V'}(-E)|_E`. Both are the
  fibre product `Bl_W V ×_V W`, the second by relative-`Proj` base change along the degreewise
  isomorphism `i^*(⨁ₙ ℐⁿ) ≅ Sym(ℐ/ℐ²)` of a quasi-regular immersion [Stacks, Tag 0FUT].
* An ample Cartier divisor `L` on a scheme proper over a field `k` has a very ample multiple
  `mL`, giving a closed embedding `X ↪ ℙᴺ_k`; in particular `X` is projective over `k`.
* On a quasi-projective variety every invertible sheaf is `L₁ ⊗ L₂⁻¹` with `L₁`, `L₂` very
  ample relative to the structure morphism (Stacks Tag 01VM).
* Every point of a scheme smooth over a field has an affine neighbourhood `k`-isomorphic to
  `Spec (k[z, y] / (F₁, …, F_c))` with `det (∂Fᵢ/∂yⱼ)` a unit.
* In a threefold step diagram `(X⁻, B⁻) → Z ← (X⁺, B⁺)` no divisor is extracted: every prime
  divisor `P` of `X⁺` has the same valuation as a prime divisor `P⁻` of `X⁻`, with equal
  boundary coefficients and log discrepancies. When `f⁻` is small as well, exceptionality of
  normalized divisorial valuations is preserved and the strict transform is a bijection of
  prime divisors.
* On a crepant junction of a stabilized tail, every prime divisor `P` of `Y_i` gives a
  valuation of `k(X_{i+1})` with log discrepancy `1 - coeff_P Θ'`.

## Main results

* `MMP.Intersection.Scheme.Hom.IsRegularEmbedding.isLocallyFreeOfRank_conormalSheaf`
* `MMP.Intersection.Scheme.exists_exceptionalDivisor_iso_projectiveBundle_of_isLCIEmbedding`
* `MMP.Resolution.Bridges.exists_closedImmersion_projSpace_of_isAmpleDivisor`
* `MMP.Foundation.exists_isRelativelyVeryAmple_iso_tensor_inv`
* `MMP.Foundations.exists_affine_nbhd_iso_spec_standardSmooth`
* `MMP.Fourfold.IsThreefoldStepDiagram.exists_primeDivisor_valuationOver_eq`
* `MMP.Fourfold.IsThreefoldStepDiagram.isExceptionalValuation_iff_of_isSmallMorphism`
* `MMP.Fourfold.StabilizedTail.IsDecreasedBoundary.isValuationLogDiscrepancy_one_sub_coeff`

## Implementation notes

* The centre of a blow-up is a quasi-coherent ideal sheaf `ℐ : V.IdealSheafData`, as in
  `AlgebraicGeometry.blowUp`; `ℙ(ℐ/ℐ²)` is `MMP.Intersection.Scheme.Modules.projectiveBundle`
  of `Stacks.Conormal.conormalSheafDegreeOne ℐ.subschemeι`.
* Very ampleness on a quasi-projective variety is the immersion version
  `Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple`, since such a variety need not be proper.
  Its proof follows [Stacks, Tag 0FVC] over the affine base `Spec k`: a very ample module
  tensored with a globally generated one is very ample, by a chart computation replacing the
  Segre embedding.
* Valuations on the two sides of a step diagram are compared through their restrictions to
  `k(Z)` along `AlgebraicGeometry.functionFieldMap`.

## References

* [Fulton, *Intersection theory*, B.7.1][Fulton1998]
* R. Lazarsfeld, *Positivity in Algebraic Geometry I*, Springer, 2004.
* [Stacks Project, Tags 063N, 0FUT, 01VM, 0FVC, 01VU, 04L1, 00TA, 054L]
-/

@[expose] public section

universe u

/-! ### The conormal sheaf of a regular embedding -/

section

open AlgebraicGeometry CategoryTheory RingTheory.Sequence RingedSpaceModuleAdjunction

namespace MMP.Intersection.Scheme

private theorem ofList_ofFn {R : Type*} [CommRing R] {n : ℕ} (g : Fin n → R) :
    Ideal.ofList (List.ofFn g) = Ideal.span (Set.range g) := by
  simp [Ideal.ofList]
  rfl

/-- Every relation among the terms of a weakly regular sequence has its coefficients in the
ideal the sequence generates. -/
private theorem coeff_mem_span_of_sum_mul_eq_zero {R : Type*} [CommRing R] :
    ∀ {n : ℕ} (f : Fin n → R), IsWeaklyRegular R (List.ofFn f) →
      ∀ a : Fin n → R, ∑ k, a k * f k = 0 → ∀ k, a k ∈ Ideal.span (Set.range f)
  | 0, _, _, _, _, k => k.elim0
  | n+1, f, hf, a, ha, k => by
    rw [List.ofFn_succ', List.concat_eq_append, isWeaklyRegular_append_iff,
      isWeaklyRegular_cons_iff] at hf
    obtain ⟨hf1, hf2, -⟩ := hf
    set J := Ideal.span (Set.range fun i : Fin n => f i.castSucc)
    have hJ' : Ideal.ofList (List.ofFn fun i : Fin n => f i.castSucc) •
        (⊤ : Submodule R R) = J := by
      rw [ofList_ofFn, Ideal.smul_eq_mul, Ideal.mul_top]
    have hreg : ∀ b : R, b * f (Fin.last n) ∈ J → b ∈ J := by
      intro b hb
      have := @hf2 (Submodule.Quotient.mk b) 0 (by
        show f (Fin.last n) • Submodule.Quotient.mk b = f (Fin.last n) • 0
        rw [smul_zero, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, hJ',
          smul_eq_mul, mul_comm]
        exact hb)
      rwa [Submodule.Quotient.mk_eq_zero, hJ'] at this
    rw [Fin.sum_univ_castSucc] at ha
    have hlast : a (Fin.last n) ∈ J := hreg _ (by
      have : a (Fin.last n) * f (Fin.last n) = -∑ i : Fin n, a i.castSucc * f i.castSucc := by
        linear_combination ha
      rw [this]
      exact neg_mem (Ideal.sum_mem _ fun i _ =>
        Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)))
    obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hlast
    have hJI : J ≤ Ideal.span (Set.range f) := Ideal.span_mono (Set.range_comp_subset_range _ _)
    have hrel : ∑ i : Fin n, (a i.castSucc + b i * f (Fin.last n)) * f i.castSucc = 0 := by
      rw [← ha, ← hb]
      simp only [add_mul, Finset.sum_add_distrib, Finset.sum_mul, smul_eq_mul]
      congr 1
      exact Finset.sum_congr rfl fun i _ => by ring
    have IH := coeff_mem_span_of_sum_mul_eq_zero (fun i => f i.castSucc) hf1 _ hrel
    refine Fin.lastCases ?_ (fun i => ?_) k
    · exact hJI hlast
    · rw [← add_sub_cancel_right (a i.castSucc) (b i * f (Fin.last n))]
      exact sub_mem (hJI (IH i)) (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩))

/-- If `∑ aⱼ fⱼ ∈ I²` for a weakly regular sequence `f` generating `I`, every `aⱼ` lies in `I`. -/
private theorem coeff_mem_span_of_sum_mul_mem_sq {R : Type*} [CommRing R] {n : ℕ}
    (f : Fin n → R) (hf : IsWeaklyRegular R (List.ofFn f))
    (a : Fin n → R) (ha : ∑ k, a k * f k ∈ Ideal.span (Set.range f) ^ 2) (k : Fin n) :
    a k ∈ Ideal.span (Set.range f) := by
  have ha' : ∑ k, a k * f k ∈ Ideal.span (Set.range f) • Submodule.span R (Set.range f) := by
    rwa [pow_two] at ha
  rw [Submodule.mem_ideal_smul_span_iff_exists_sum] at ha'
  obtain ⟨c, hc, hsum⟩ := ha'
  rw [Finsupp.sum_fintype _ _ (by simp)] at hsum
  have h0 : ∑ k, (a k - c k) * f k = 0 := by
    simp only [sub_mul, Finset.sum_sub_distrib, ← hsum, smul_eq_mul, sub_self]
  rw [← sub_add_cancel (a k) (c k)]
  exact add_mem (coeff_mem_span_of_sum_mul_eq_zero f hf _ h0 k) (hc k)

/-- **The conormal module of a regular ideal is free on the generators.** Let `φ : A → B` be
surjective with kernel `I`, generated by a weakly regular sequence `f₁, …, f_r`. A `B`-module
`M` identified with `I/I²` compatibly with the scalar actions through `φ` is free of rank `r`. -/
private theorem nonempty_basis_of_isWeaklyRegular {A B M : Type*} [CommRing A] [CommRing B]
    [AddCommGroup M] [Module B M] (φ : A →+* B) (hφ : Function.Surjective φ) {r : ℕ}
    (f : Fin r → A) (hf : IsWeaklyRegular A (List.ofFn f)) {I : Ideal A}
    (hI : Ideal.span (Set.range f) = I) (hker : RingHom.ker φ = I)
    (ψ : M ≃+ I.Cotangent) (hψ : ∀ (a : A) (m : M), ψ (φ a • m) = a • ψ m) :
    Nonempty (Module.Basis (Fin r) B M) := by
  classical
  have hfI : ∀ k, f k ∈ I := fun k => hI ▸ Ideal.subset_span (Set.mem_range_self k)
  let v : Fin r → M := fun k => ψ.symm (I.toCotangent ⟨f k, hfI k⟩)
  have hsum : ∀ a : Fin r → A, ψ (∑ k, φ (a k) • v k) = I.toCotangent ⟨∑ k, a k * f k,
      Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (hfI k)⟩ := by
    intro a
    rw [map_sum]
    simp only [hψ, v, AddEquiv.apply_symm_apply, ← map_smul, ← map_sum]
    congr 1
    apply Subtype.ext
    simp
  refine ⟨Module.Basis.mk (v := v) ?_ ?_⟩
  · rw [Fintype.linearIndependent_iff]
    intro c hc k
    choose a ha using fun k => hφ (c k)
    have h0 : ψ (∑ k, φ (a k) • v k) = 0 := by
      simp only [ha, hc, map_zero]
    rw [hsum, Ideal.toCotangent_eq_zero] at h0
    rw [← ha k, ← RingHom.mem_ker, hker, ← hI]
    exact coeff_mem_span_of_sum_mul_mem_sq f hf a (hI ▸ h0) k
  · intro m _
    obtain ⟨x, hx⟩ := I.toCotangent_surjective (ψ m)
    obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp (hI ▸ x.2 :
      (x : A) ∈ Ideal.span (Set.range f))
    have hm : m = ∑ k, φ (a k) • v k := by
      apply ψ.injective
      rw [hsum, ← hx]
      congr 1
      apply Subtype.ext
      simp only [← ha, smul_eq_mul]
    rw [hm]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)

/-- The two presentations of the ideal sheaf of the closed factor of an immersion, as an ideal
subsheaf of the structure sheaf and as the categorical kernel, give isomorphic conormal
sheaves. -/
private noncomputable def conormalSheafIso {Z X : Scheme.{u}} (i : Z ⟶ X) [IsImmersion i] :
    Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf i ≅
      Stacks.Conormal.conormalSheaf i :=
  (modulePullback i.liftCoborder.toLRSHom.toShHom).mapIso
    (SheafOfModules.Submodule.kerIsoKernel
      (SheafOfModules.unitToPushforwardObjUnit
        (structureSheafHom i.liftCoborder.toLRSHom.toShHom)))

/-- On an affine chart of `X` inside the coborder of an immersion `i` where the kernel of
`Γ(X, V) → Γ(Z, i⁻¹V)` is generated by a weakly regular sequence of length `r`, the sections of
the conormal sheaf over the affine open `i⁻¹V` are free of rank `r`. -/
private theorem isFiniteLocallyFreeOfRank_sections_conormalSheaf {Z X : Scheme.{u}}
    (i : Z ⟶ X) [IsImmersion i] {V : X.Opens} (hV : IsAffineOpen V)
    (hVc : V ≤ i.coborderRange) {r : ℕ} (f : Fin r → Γ(X, V))
    (hf : IsWeaklyRegular Γ(X, V) (List.ofFn f))
    (hker : RingHom.ker (i.app V).hom = Ideal.span (Set.range f))
    (C : Z.Modules) (hC : C = Stacks.Conormal.conormalSheaf i) :
    ∃ hU : IsAffineOpen (i ⁻¹ᵁ V), Module.IsFiniteLocallyFreeOfRank Γ(Z, i ⁻¹ᵁ V)
      Γ(C, i ⁻¹ᵁ V) r := by
  obtain ⟨I, e, he⟩ := Stacks.Immersion.exists_affineModel_of_le_coborderRange i V hV hVc
  have hI : RingHom.ker (i.app V).hom = I := by
    have hk := Stacks.Conormal.ker_appLE_eq_of_affineModel i V hV I e he
    rwa [Scheme.Hom.appLE_eq_app] at hk
  have hsurj : Function.Surjective (i.app V).hom := by
    have hs := Stacks.Conormal.surjective_appLE_of_affineModel i V hV I e he
    rwa [Scheme.Hom.appLE_eq_app] at hs
  have hU : IsAffineOpen (i ⁻¹ᵁ V) := Stacks.Conormal.isAffineOpen_preimage_of_affineModel i V I e
  obtain ⟨c⟩ : Nonempty ((ModuleCat.restrictScalars (i.app V).hom).obj
      (ModuleCat.of Γ(Z, i ⁻¹ᵁ V) Γ(C, i ⁻¹ᵁ V)) ≅ ModuleCat.of Γ(X, V) I.Cotangent) := by
    subst hC
    exact ⟨Stacks.Conormal.CotangentAppIso.conormalAffineSectionsIsoCotangent i V hV I e he⟩
  let ψ : Γ(C, i ⁻¹ᵁ V) ≃+ I.Cotangent :=
    { toFun := c.hom
      invFun := c.inv
      left_inv := c.hom_inv_id_apply
      right_inv := c.inv_hom_id_apply
      map_add' := c.hom.hom.map_add }
  obtain ⟨b⟩ := nonempty_basis_of_isWeaklyRegular (i.app V).hom hsurj f hf
    (hker.symm.trans hI) hI ψ (fun a m => c.hom.hom.map_smul a m)
  exact ⟨hU, Module.isFiniteLocallyFreeOfRank_of_basis b⟩

/-- **The conormal sheaf of a regular embedding is locally free.** If `i : X ⟶ Y` is a regular
embedding of codimension `d` (`Hom.IsRegularEmbedding`), its conormal sheaf `𝓘/𝓘²` is a locally
free `𝒪_X`-module of rank `d`. -/
@[mmp "lem_mmp_foundation_regular_conormal_free"]
public theorem Hom.IsRegularEmbedding.isLocallyFreeOfRank_conormalSheaf {X Y : Scheme.{u}}
    {i : X ⟶ Y} [IsClosedImmersion i] {d : ℕ} (h : Hom.IsRegularEmbedding i d) :
    Modules.IsLocallyFreeOfRank
      (Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf i) d := by
  obtain ⟨C, hCdef⟩ : ∃ C : X.Modules, C = Stacks.Conormal.conormalSheaf i := ⟨_, rfl⟩
  have hC : Scheme.Modules.IsFiniteLocallyFreeOfRank C d := by
    haveI : C.IsQuasicoherent := hCdef ▸ Stacks.Conormal.conormalSheaf_isQuasicoherent i
    refine Stacks.Modules.isFiniteLocallyFreeOfRank_of_module_affineOpens C d fun z => ?_
    obtain ⟨V, hzV, f, hlen, hreg, hker⟩ := h z
    subst hlen
    have hk : RingHom.ker (i.app V).hom = Ideal.span (Set.range f.get) := by
      rw [← i.ker_apply V, hker, ← ofList_ofFn, List.ofFn_get]
    obtain ⟨hU, hmod⟩ := isFiniteLocallyFreeOfRank_sections_conormalSheaf i V.2
      (fun x _ => by
        change x ∈ coborder (Set.range i.base)
        rw [IsClosed.coborder_eq i.isClosedEmbedding.isClosed_range]
        trivial) f.get (by rw [List.ofFn_get]; exact hreg.toIsWeaklyRegular) hk C hCdef
    exact ⟨⟨i ⁻¹ᵁ V, hU⟩, hzV, hmod⟩
  intro x
  obtain ⟨U, hxU, e⟩ := Stacks.Modules.isFiniteLocallyFreeOfRank_of_iso
    (hCdef ▸ (conormalSheafIso i).symm :
      C ≅ Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf i) d hC x
  exact ⟨U, hxU, e⟩

end MMP.Intersection.Scheme

end

/-! ### The exceptional divisor of a blow-up along a regular embedding -/

section

open CategoryTheory AlgebraicGeometry Stacks.RelativeProj

namespace MMP.Intersection.Scheme

variable {V : Scheme.{u}} (I : V.IdealSheafData)

/-- A regular embedding in Lazarsfeld's sense (locally cut out by a weakly regular sequence) is
a quasi-regular immersion. -/
private theorem isQuasiRegularImmersion_of_isLCIEmbedding {c : ℕ}
    (hreg : MMP.Intersection.Scheme.Hom.IsLCIEmbedding I.subschemeι c) :
    Stacks.AlgebraicGeometry.RegularIdealSheaf.IsQuasiRegularImmersion I.subschemeι := by
  refine Stacks.AlgebraicGeometry.isQuasiRegularImmersion_of_isRegularImmersion _
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim.isRegularImmersion
      (c := c) _ ?_)
  rw [Stacks.AlgebraicGeometry.RegularIdealSheaf.isRegularClosedImmersionOfCodim_iff_kerGeneratedBy]
  intro y hy
  rw [I.subschemeι.isClosedEmbedding.isClosed_range.closure_eq] at hy
  obtain ⟨x, rfl⟩ := hy
  obtain ⟨U, hxU, f, hlen, hreg, hker⟩ := hreg x
  refine ⟨U, hxU, f.length, f.get, ?_, hlen, ?_⟩
  · rw [← I.subschemeι.ker_apply, hker, Ideal.ofList]
    congr 1
    ext a
    exact List.mem_iff_get
  · rwa [List.ofFn_get]

section Comparison

variable (hq : Stacks.AlgebraicGeometry.RegularIdealSheaf.IsQuasiRegularImmersion I.subschemeι)

private noncomputable def symHom :
    SheafOfModules.GradedAlgebra.UnitalHom
      (Stacks.Conormal.gradedPullback I.subschemeι (Stacks.Blowup.reesSituation I).algebra)
      (symmetricSituationOfQuasicoherent I.subscheme
        (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι)).algebra :=
  haveI : ∀ n : ℤ, IsIso ((Stacks.Conormal.conormalSymmetricHom I.subschemeι).app n) := fun n =>
    Stacks.Conormal.isIso_conormalSymmetricHom_app I.subschemeι hq n
  (Stacks.Conormal.ConormalAlgebraData.unitalHom
      (Stacks.Conormal.reesPullbackConormalAlgebra I.subschemeι I
        (Scheme.IdealSheafData.ker_subschemeι I))
      (Stacks.Conormal.conormalAlgebra I.subschemeι)).comp
    (Stacks.Conormal.conormalSymmetricHom I.subschemeι).inverse

private theorem isIso_symHom_app (n : ℤ) : IsIso ((symHom I hq).app n) := by
  haveI : ∀ m : ℤ, IsIso ((Stacks.Conormal.conormalSymmetricHom I.subschemeι).app m) := fun m =>
    Stacks.Conormal.isIso_conormalSymmetricHom_app I.subschemeι hq m
  haveI := Stacks.Conormal.ConormalAlgebraData.isIso_unitalHom_app
    (Stacks.Conormal.reesPullbackConormalAlgebra I.subschemeι I
      (Scheme.IdealSheafData.ker_subschemeι I))
    (Stacks.Conormal.conormalAlgebra I.subschemeι) n
  haveI : IsIso ((Stacks.Conormal.conormalSymmetricHom I.subschemeι).inverse.app n) := by
    rw [SheafOfModules.GradedAlgebra.UnitalHom.inverse_app]
    infer_instance
  exact SheafOfModules.GradedAlgebra.UnitalHom.isIso_comp_app
    (Stacks.Conormal.ConormalAlgebraData.unitalHom
      (Stacks.Conormal.reesPullbackConormalAlgebra I.subschemeι I
        (Scheme.IdealSheafData.ker_subschemeι I))
      (Stacks.Conormal.conormalAlgebra I.subschemeι))
    (Stacks.Conormal.conormalSymmetricHom I.subschemeι).inverse n

private noncomputable def toReesProj :
    projectiveBundle I.subscheme (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) ⟶
      Situation.relativeProj (Stacks.Blowup.reesSituation I) :=
  Situation.relativeProjBaseChange (s := Stacks.Blowup.reesSituation I)
    (s' := symmetricSituationOfQuasicoherent I.subscheme
      (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι))
    I.subschemeι (symHom I hq) (fun m => isIso_symHom_app I hq (m : ℤ))

private noncomputable def toBlowUp :
    projectiveBundle I.subscheme (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) ⟶
      blowUp I :=
  toReesProj I hq ≫ (Stacks.Blowup.reesSituationBlowUpIso I).hom

private theorem isPullback_bundle :
    CategoryTheory.IsPullback (toBlowUp I hq)
      (projectiveBundleToBase I.subscheme (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι))
      (blowUpToBase I) I.subschemeι :=
  (Situation.isPullback_relativeProjBaseChange (s := Stacks.Blowup.reesSituation I)
    (s' := symmetricSituationOfQuasicoherent I.subscheme
      (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι))
    I.subschemeι (symHom I hq) (fun m => isIso_symHom_app I hq (m : ℤ))).of_iso
    (Iso.refl _) (Stacks.Blowup.reesSituationBlowUpIso I) (Iso.refl _)
    (Iso.refl V) (by simp [toBlowUp, toReesProj]) (Category.comp_id _)
    ((Category.comp_id _).trans
      (Stacks.Blowup.reesSituationBlowUpIso_hom_blowUpToBase I).symm)
    ((Category.comp_id _).trans (Category.id_comp _).symm)

/-- `E ≅ 𝐏(ℐ/ℐ²)` in the relative-`Proj` situation presentation of the bundle. -/
private noncomputable def isoBundle :
    exceptionalDivisor I ≅
      projectiveBundle I.subscheme (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) :=
  (Stacks.AlgebraicGeometry.isPullback_exceptionalDivisor_toCentre I).isoIsPullback _ _
    (isPullback_bundle I hq)

private theorem isoBundle_hom_toBase :
    (isoBundle I hq).hom ≫
        projectiveBundleToBase I.subscheme
          (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) =
      Scheme.IdealSheafData.subschemeMap (exceptionalIdeal I) I (blowUpToBase I)
        (I.le_map_comap (blowUpToBase I)) :=
  (Stacks.AlgebraicGeometry.isPullback_exceptionalDivisor_toCentre I).isoIsPullback_hom_snd _ _
    (isPullback_bundle I hq)

private theorem isoBundle_hom_toBlowUp :
    (isoBundle I hq).hom ≫ toBlowUp I hq = (exceptionalIdeal I).subschemeι :=
  (Stacks.AlgebraicGeometry.isPullback_exceptionalDivisor_toCentre I).isoIsPullback_hom_fst _ _
    (isPullback_bundle I hq)

private noncomputable def twistIso :
    (Scheme.Modules.pullback (isoBundle I hq).hom).obj
        (Situation.twistSheaf (symmetricSituationOfQuasicoherent I.subscheme
          (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι)) 1)
      ≅ (Scheme.Modules.pullback (exceptionalIdeal I).subschemeι).obj
          (exceptionalIdealModule I) :=
  (Scheme.Modules.pullback (isoBundle I hq).hom).mapIso
      ((Situation.twistSheafPullbackIso (s := Stacks.Blowup.reesSituation I)
        (s' := symmetricSituationOfQuasicoherent I.subscheme
          (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι))
        I.subschemeι (symHom I hq) (fun m => isIso_symHom_app I hq (m : ℤ)) 1).symm
    ≪≫ (Scheme.Modules.pullback (toReesProj I hq)).mapIso
        (Stacks.Blowup.reesSituationBlowUpTwistIso I 1).symm
    ≪≫ (Scheme.Modules.pullbackComp (toReesProj I hq)
        (Stacks.Blowup.reesSituationBlowUpIso I).hom).app (blowUpTwist I 1))
    ≪≫ (Scheme.Modules.pullbackComp (isoBundle I hq).hom (toBlowUp I hq)).app (blowUpTwist I 1)
    ≪≫ (Scheme.Modules.pullbackCongr (isoBundle_hom_toBlowUp I hq)).app (blowUpTwist I 1)
    ≪≫ (Scheme.Modules.pullback (exceptionalIdeal I).subschemeι).mapIso
        (AlgebraicGeometry.twistOneIsoExceptionalIdealModule I)

end Comparison

/-- The two constructions of `𝐏(F) = Proj_X(Sym F)` (the relative-`Proj` situation and the
chart-glued one) agree over `X`, compatibly with `𝒪(1)`. -/
private theorem exists_projectiveBundle_iso {X : Scheme.{u}} (F : X.Modules)
    [F.IsQuasicoherent] :
    ∃ φ : projectiveBundle X F ≅ MMP.Intersection.Scheme.Modules.projectiveBundle F,
      φ.hom ≫ MMP.Intersection.Scheme.Modules.projectiveBundleToBase F =
        projectiveBundleToBase X F ∧
      Nonempty ((Scheme.Modules.pullback φ.hom).obj
          (MMP.Intersection.Scheme.Modules.serreTwist F 1) ≅
        Situation.twistSheaf (symmetricSituationOfQuasicoherent X F) 1) := by
  refine ⟨(Stacks.RelativeProj.bundlePresentationIso F).symm, ?_, ⟨?_⟩⟩
  · rw [Iso.symm_hom, Iso.inv_comp_eq]
    exact (Stacks.RelativeProj.bundlePresentationIso_hom_comp_toBase F).symm
  · exact Stacks.RelativeProj.presentationTwistIsoTwistSheaf F 1

/-- **Exceptional divisor of a blow-up along a regular embedding**:
if `W = V(ℐ) ⊊ V` is a regular embedding of codimension `c ≥ 1`, then the exceptional divisor
`E` of `Bl_W V ⟶ V` is isomorphic over `W` to the projective bundle `ℙ(ℐ/ℐ²)`, and under this
isomorphism `𝒪_{ℙ(ℐ/ℐ²)}(1)` pulls back to the restriction `𝒪_{V'}(-E)|_E`. -/
@[mmp "lem_mmp_foundation_laz_regular_blowup_exceptional_bundle"]
public theorem exists_exceptionalDivisor_iso_projectiveBundle_of_isLCIEmbedding {V : Scheme.{u}}
    (I : V.IdealSheafData) (hW : I ≠ ⊥) {c : ℕ} (hc : 1 ≤ c)
    (hreg : Hom.IsLCIEmbedding I.subschemeι c) :
    ∃ e : exceptionalDivisor I ≅
        Modules.projectiveBundle (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι),
      e.hom ≫ Modules.projectiveBundleToBase
          (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) =
        Scheme.IdealSheafData.subschemeMap (exceptionalIdeal I) I (blowUpToBase I)
          (I.le_map_comap (blowUpToBase I)) ∧
      Nonempty ((Scheme.Modules.pullback e.hom).obj
          (Modules.serreTwist (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι) 1) ≅
        (Scheme.Modules.pullback (exceptionalIdeal I).subschemeι).obj
          (exceptionalIdealModule I)) := by
  have hq := isQuasiRegularImmersion_of_isLCIEmbedding I hreg
  obtain ⟨φ, hφ, ⟨τ⟩⟩ := exists_projectiveBundle_iso
    (Stacks.Conormal.conormalSheafDegreeOne I.subschemeι)
  refine ⟨isoBundle I hq ≪≫ φ, ?_, ⟨?_⟩⟩
  · rw [Iso.trans_hom, Category.assoc, hφ, isoBundle_hom_toBase]
  · exact (Scheme.Modules.pullbackComp (isoBundle I hq).hom φ.hom).symm.app _
      ≪≫ (Scheme.Modules.pullback (isoBundle I hq).hom).mapIso τ ≪≫ twistIso I hq

end MMP.Intersection.Scheme

end

/-! ### Projective embeddings from ample divisors -/

section

open CategoryTheory AlgebraicGeometry

namespace MMP.Resolution.Bridges

/-- **An ample divisor on a proper scheme gives a projective embedding.** Let `X` be proper over
a field `k` and `L` an ample Cartier divisor. Then for some `m > 0` and `N` there is a closed
immersion `ι : X ⟶ ℙᴺ_k` over `k` with `ι^* 𝒪(1) ≅ 𝒪_X(mL)`; in particular `X` is projective
over `k`. -/
@[mmp "lem_mmp_foundation_proper_ample_projective_embedding"]
public theorem exists_closedImmersion_projSpace_of_isAmpleDivisor (k : Type u) [Field k]
    {X : Scheme.{u}} [X.Over (Spec (.of k))] [IsProper (X ↘ Spec (.of k))]
    (L : X.CartierDivisor) (hL : MMP.Intersection.IsAmpleDivisor k L) :
    (∃ m : ℕ, 0 < m ∧ ∃ (N : ℕ)
        (ι : X ⟶ MMP.Intersection.ProjSpace k (ULift.{u} (Fin (N + 1)))),
      IsClosedImmersion ι ∧
        ι ≫ MMP.Intersection.ProjSpace.toSpec k _ = X ↘ Spec (.of k) ∧
        Nonempty ((Scheme.Modules.pullback ι).obj (MMP.Intersection.ProjSpace.twistOne k _) ≅
          MMP.CartierDivisor.sheaf (m • L))) ∧
      IsProjectiveMorphism (X ↘ Spec (.of k)) := by
  obtain ⟨m, ⟨N, ι, hι, hover, ⟨e⟩⟩, hpos⟩ :=
    ((MMP.Resolution.Bridges.eventually_isVeryAmpleDivisor_nsmul k L hL).and
      (Filter.eventually_gt_atTop 0)).exists
  refine ⟨⟨m, hpos, N, ι, hι, hover, ⟨e.symm⟩⟩,
    isProjectiveMorphism_of_isImmersion_projectiveSpaceOver
      (ι ≫ (MMP.Intersection.ProjSpace.isoProjectiveSpaceOver k N).hom) ?_⟩
  exact (Category.assoc _ _ _).trans <|
    (ι ≫= MMP.Intersection.ProjSpace.isoProjectiveSpaceOver_hom_fst k N).trans hover

end MMP.Resolution.Bridges

end

/-! ### Invertible sheaves as differences of very ample ones -/

section

open CategoryTheory MonoidalCategory AlgebraicGeometry Stacks.Ample

namespace MMP.Foundation

section FixedTwist

open CategoryTheory.Limits TopologicalSpace
open RingedSpaceModuleAdjunction
open Stacks.ProjectiveFromSections Stacks.AmpleProjectiveImmersion
open Stacks.SectionProduct Stacks.TensorSectionNonvanishing Stacks.SectionsToProjectiveSpace
open Stacks.ProductFamilyTwist Stacks.ProductFamilyRatio

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
attribute [local instance] Stacks.TensorSectionNonvanishing.isInvertibleModule_tensorObj

variable {X : Scheme.{u}}

private noncomputable def prodTensorFamily {F G H : X.Modules} (e : (F ⊗ G : X.Modules) ≅ H)
    {n m : ℕ}
    (s : Fin (n + 1) → Γ(F, ⊤)) (t : Fin (m + 1) → Γ(G, ⊤)) :
    Fin (n * m + n + m + 1) → Γ(H, ⊤) :=
  (fun p => e.hom.app ⊤ (prodFamily s t p)) ∘ segreIndexEquiv n m

private theorem generatesStalks_prodTensorFamily {F G H : X.Modules} [IsInvertibleModule X F]
    [IsInvertibleModule X G] [IsInvertibleModule X H] (e : (F ⊗ G : X.Modules) ≅ H) {n m : ℕ}
    {s : Fin (n + 1) → Γ(F, ⊤)} {t : Fin (m + 1) → Γ(G, ⊤)} (hs : GeneratesStalks s)
    (ht : GeneratesStalks t) : GeneratesStalks (prodTensorFamily e s t) :=
  generatesStalks_comp_equiv (segreIndexEquiv n m)
    (generatesStalks_congr e (generatesStalks_prodFamily hs ht))

private theorem prodTensorFamily_segreIdx {F G H : X.Modules} (e : (F ⊗ G : X.Modules) ≅ H)
    {n m : ℕ}
    (s : Fin (n + 1) → Γ(F, ⊤)) (t : Fin (m + 1) → Γ(G, ⊤)) (α : Fin (n + 1))
    (β : Fin (m + 1)) :
    prodTensorFamily e s t (segreIdx n m α β) = e.hom.app ⊤ (prodFamily s t (α, β)) :=
  congrArg (fun p => e.hom.app ⊤ (prodFamily s t p)) (segreIndexEquiv_segreIdx n m α β)

private theorem nvCover_prodTensorFamily_segreIdx {F G H : X.Modules} [IsInvertibleModule X H]
    (e : (F ⊗ G : X.Modules) ≅ H) {n m : ℕ} (s : Fin (n + 1) → Γ(F, ⊤))
    (t : Fin (m + 1) → Γ(G, ⊤)) (α : Fin (n + 1)) (β : Fin (m + 1)) :
    nvCover (prodTensorFamily e s t) (segreIdx n m α β) =
      nvCover (fun p => e.hom.app ⊤ (prodFamily s t p)) (α, β) :=
  congrArg (nvOpen H) (prodTensorFamily_segreIdx e s t α β)

private theorem nvCover_prodTensorFamily_le_left {F G H : X.Modules} [IsInvertibleModule X F]
    [IsInvertibleModule X G] [IsInvertibleModule X H] (e : (F ⊗ G : X.Modules) ≅ H) {n m : ℕ}
    (s : Fin (n + 1) → Γ(F, ⊤)) (t : Fin (m + 1) → Γ(G, ⊤)) (α : Fin (n + 1))
    (β : Fin (m + 1)) :
    nvCover (prodTensorFamily e s t) (segreIdx n m α β) ≤ nvCover s α :=
  (nvCover_prodTensorFamily_segreIdx e s t α β).le.trans
    ((nvCover_congr_le e (prodFamily s t) (α, β)).trans (nvCover_prodFamily_le_left s t (α, β)))

private theorem ratio_prodTensorFamily {F G H : X.Modules} [IsInvertibleModule X F]
    [IsInvertibleModule X G] [IsInvertibleModule X H] (e : (F ⊗ G : X.Modules) ≅ H) {n m : ℕ}
    (s : Fin (n + 1) → Γ(F, ⊤)) (t : Fin (m + 1) → Γ(G, ⊤)) (α : Fin (n + 1)) (β : Fin (m + 1))
    (α' : Fin (n + 1)) :
    ratio (prodTensorFamily e s t) (segreIdx n m α β) (segreIdx n m α' β) =
      resO (nvCover_prodTensorFamily_le_left e s t α β) (ratio s α α') := by
  have hle : nvCover (prodTensorFamily e s t) (segreIdx n m α β) ≤
      nvCover (fun p => e.hom.app ⊤ (prodFamily s t p)) (α, β) :=
    (nvCover_prodTensorFamily_segreIdx e s t α β).le
  have hQ := resO_ratio_smul (fun p => e.hom.app ⊤ (prodFamily s t p)) hle (α', β)
  rw [ratio_congr, ratio_prodFamily, Stacks.ChartImmersionFinish.resO_resO,
    Stacks.ChartImmersionFinish.resO_resO] at hQ
  refine (eq_div (prodTensorFamily e s t (segreIdx n m α β)) le_rfl ?_).symm
  refine Eq.trans ?_ (Eq.trans hQ ?_)
  · exact congrArg (fun z => resO (nvCover_prodTensorFamily_le_left e s t α β) (ratio s α α') • z)
      (congrArg (fun z => resT (nvCover (prodTensorFamily e s t) (segreIdx n m α β)) z)
        (prodTensorFamily_segreIdx e s t α β))
  · exact (congrArg (fun z => resT (nvCover (prodTensorFamily e s t) (segreIdx n m α β)) z)
      (prodTensorFamily_segreIdx e s t α' β)).symm

private def FamilyImmersion {S : Scheme.{u}} (f : X ⟶ S) (M : X.Modules)
    [IsInvertibleModule X M] : Prop :=
  ∃ (n : ℕ) (s : Fin (n + 1) → Γ(M, ⊤)), GeneratesStalks s ∧
    ∀ p : X ⟶ projectiveSpaceOver n S,
      p ≫ pullback.fst (terminal.from S)
          (terminal.from (projectiveSpaceAtUniverse.{u} n)) = f →
        (∀ i, (nvCover s i).ι ≫ p ≫ projectiveSpaceOver.toIntegralAtUniverse n S =
          toProjectiveSpaceAtUniverse (chartRatio s i) (span_range_chartRatio s i)) →
        IsImmersion p

private theorem hasImmersionTwistOver_of_familyImmersion {S : Scheme.{u}} (f : X ⟶ S)
    (M : X.Modules) [IsInvertibleModule X M] (h : FamilyImmersion f M) :
    HasImmersionTwistOver f M := by
  obtain ⟨n, s, hs, himm⟩ := h
  obtain ⟨p, hpf, hchart⟩ :=
    Stacks.ProjGlobalSectionsAppTop.exists_hom_projectiveSpaceOver_of_generatesStalks s hs f
  exact ⟨n, p, himm p hpf hchart, hpf,
    Stacks.AmpleImmersionReduction.twistPullback f _ n s hs p hpf hchart⟩

private theorem familyImmersion_tensor {S : Scheme.{u}} (f : X ⟶ S) {F G H : X.Modules}
    [IsInvertibleModule X F] [IsInvertibleModule X G] [IsInvertibleModule X H]
    (e : (F ⊗ G : X.Modules) ≅ H) (hF : FamilyImmersion f F) {m : ℕ}
    {t : Fin (m + 1) → Γ(G, ⊤)} (ht : GeneratesStalks t) : FamilyImmersion f H := by
  obtain ⟨n, s, hs, himm⟩ := hF
  have hgen : GeneratesStalks (prodTensorFamily e s t) :=
    generatesStalks_prodTensorFamily e hs ht
  refine ⟨n * m + n + m, prodTensorFamily e s t, hgen, fun q hqf hqchart => ?_⟩
  obtain ⟨j, hjf, hjchart⟩ :=
    Stacks.ProjGlobalSectionsAppTop.exists_hom_projectiveSpaceOver_of_generatesStalks s hs f
  have hjimm : IsImmersion j := himm j hjf hjchart
  refine Stacks.ChartImmersionFinish.isImmersion_of_isImmersion_standardChart_subcover
    (prodTensorFamily e s t) hgen q hqchart
    (fun p : Fin (n + 1) × Fin (m + 1) => segreIdx n m p.1 p.2) ?_ ?_
  · intro x
    obtain ⟨k, hk⟩ := exists_mem_nvCover_of_generatesStalks _ hgen x
    exact ⟨segreIndexEquiv n m k, by simpa only [segreIdx_segreIndexEquiv] using hk⟩
  · rintro ⟨α, β⟩
    have hpre := Stacks.AmpleImmersionReduction.preimage_standardChart
      (prodTensorFamily e s t) hgen q hqchart (segreIdx n m α β)
    refine ⟨q.resLE (projectiveSpaceOver.standardChart (n * m + n + m) S (segreIdx n m α β))
      (nvCover (prodTensorFamily e s t) (segreIdx n m α β)) hpre.ge, ?_,
      Scheme.Hom.resLE_comp_ι _ _⟩
    have hcomp := resLE_comp_chartProj (prodTensorFamily e s t) s q hqf j hjf α β
      (hqchart (segreIdx n m α β)) (hjchart α) (nvCover_prodTensorFamily_le_left e s t α β)
      (ratio_prodTensorFamily e s t α β) hpre.ge
    have : IsImmersion ((nvCover (prodTensorFamily e s t) (segreIdx n m α β)).ι ≫ j) :=
      inferInstance
    rw [← hcomp] at this
    exact IsImmersion.of_comp _ (chartProj.{u} n m S α β)

private noncomputable def twistRearrangeIso (N L : X.Modules) [IsInvertibleModule X L] {a b c : ℤ}
    (h : a + b = c) :
    (tensorPowModule X L a ⊗ (N ⊗ tensorPowModule X L b) : X.Modules) ≅
      (N ⊗ tensorPowModule X L c : X.Modules) :=
  (α_ (tensorPowModule X L a) N (tensorPowModule X L b)).symm ≪≫
    (β_ (tensorPowModule X L a) N ⊗ᵢ Iso.refl (tensorPowModule X L b)) ≪≫
    α_ N (tensorPowModule X L a) (tensorPowModule X L b) ≪≫
    (Iso.refl N ⊗ᵢ Stacks.AmpleEventualGeneration.tensorPowAdd h)

private theorem exists_eventually_familyImmersion_tensorPowModule {S : Scheme.{u}} (f : X ⟶ S)
    (L : X.Modules) [IsInvertibleModule X L] (hL : IsAmple X L) (hft : LocallyOfFiniteType f) :
    ∃ c₀ : ℤ, 1 ≤ c₀ ∧ ∀ c : ℤ, c₀ ≤ c → FamilyImmersion f (tensorPowModule X L c) := by
  obtain ⟨N₁, hN₁, hfam⟩ := exists_familyImmersionTwist_of_chartImmersion f L
    (Stacks.ChartImmersionFinish.chartImmersion f L) hL hft
  obtain ⟨b₀, hb₀⟩ := Stacks.StalkwiseGeneration.eventuallyGeneratesStalksPowers_of_isAmple L hL
  refine ⟨max 1 (N₁ + b₀), le_max_left _ _, fun c hc => ?_⟩
  obtain ⟨m, t, ht⟩ := hb₀ (c - N₁) (by omega)
  rw [show c = N₁ + (c - N₁) by ring]
  exact familyImmersionTwist_add f L (productFamilyImmersion f L) hfam ht

private theorem eventually_familyImmersion_tensor {S : Scheme.{u}} (f : X ⟶ S) (N L : X.Modules)
    [IsInvertibleModule X N] [IsInvertibleModule X L] (hL : IsAmple X L)
    (hft : LocallyOfFiniteType f) :
    ∃ d₀ : ℕ, 1 ≤ d₀ ∧ ∀ d : ℕ, d₀ ≤ d →
      FamilyImmersion f (N ⊗ tensorPowModule X L (d : ℤ)) := by
  obtain ⟨c₀, hc₀, hc⟩ := exists_eventually_familyImmersion_tensorPowModule f L hL hft
  obtain ⟨n₀, hn₀⟩ := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple L hL N
    (Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule N)
    (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule N)
  obtain ⟨σ, hσ⟩ := hn₀ (max 0 n₀) (le_max_right _ _)
  obtain ⟨m, t, ht⟩ := Stacks.StalkwiseGeneration.exists_generatesStalks_of_isFinGen
    (⟨σ, hσ⟩ : Stacks.AmpleEventualGeneration.IsFinGen
      (N ⊗ tensorPowModule X L (max 0 n₀)))
  refine ⟨(c₀ + max 0 n₀).toNat, by omega, fun d hd => ?_⟩
  exact familyImmersion_tensor f (twistRearrangeIso N L (sub_add_cancel (d : ℤ) (max 0 n₀)))
    (hc _ (by omega)) ht

/-- Over the spectrum of a field, for `f` locally of finite type and `L₀` ample relative to `f`,
some power `L₀^{⊗ d}` and the twist `L ⊗ L₀^{⊗ d}` are both very ample relative to `f`. -/
private theorem exists_isRelativelyVeryAmple_twist (k : Type u) [Field k]
    (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] (L L₀ : X.Modules) [IsInvertibleModule X L]
    [IsInvertibleModule X L₀] (hamp : Stacks.RelativeAmple.IsRelativelyAmple f L₀) :
    ∃ d : ℕ, Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f (L ⊗ tensorPowModule X L₀ (d : ℤ)) ∧
      Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f (tensorPowModule X L₀ (d : ℤ)) := by
  have hA : IsAmple X L₀ := Stacks.HProjective.isAmple_of_isRelativelyAmple_of_isAffine f L₀ hamp
  have hb := fun m => Stacks.SymGraded.hasFreeBundleTwistOne (Spec (.of k)) m
  obtain ⟨d₁, -, h₁⟩ := eventually_familyImmersion_tensor f L L₀ hA inferInstance
  obtain ⟨c₀, -, h₂⟩ := exists_eventually_familyImmersion_tensorPowModule f L₀ hA inferInstance
  refine ⟨max d₁ c₀.toNat, ?_, ?_⟩
  · exact Stacks.AmpleRelativeFiniteType.isRelativelyVeryAmple_of_hasImmersionTwistOver hb f _
      (hasImmersionTwistOver_of_familyImmersion f _ (h₁ _ (le_max_left _ _)))
  · exact Stacks.AmpleRelativeFiniteType.isRelativelyVeryAmple_of_hasImmersionTwistOver hb f _
      (hasImmersionTwistOver_of_familyImmersion f _ (h₂ _ (by omega)))

end FixedTwist

/-- **Every invertible sheaf on a quasi-projective variety is a difference of two very ample
ones.** If `f : X ⟶ Spec k` is a quasi-projective variety and `L` is an invertible
`𝒪_X`-module, there are invertible `𝒪_X`-modules `L₁`, `L₂`, both very ample relative to `f`
(`Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple`), with `L ≅ L₁ ⊗ L₂^{⊗ -1}`. -/
@[mmp "lem_mmp_foundation_quasiprojective_very_ample_difference"]
public theorem exists_isRelativelyVeryAmple_iso_tensor_inv (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsQuasiProjectiveVariety k f]
    (L : X.Modules) [IsInvertibleModule X L] :
    ∃ (L₁ L₂ : X.Modules) (_ : IsInvertibleModule X L₁) (_ : IsInvertibleModule X L₂),
      Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f L₁ ∧
        Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f L₂ ∧
        Nonempty (L ≅ L₁ ⊗ tensorPowModule X L₂ (-1)) := by
  obtain ⟨⟨_, -⟩, L₀, hL₀, hamp⟩ := ‹IsQuasiProjectiveVariety k f›.isQuasiProjective
  obtain ⟨d, h₁, h₂⟩ := exists_isRelativelyVeryAmple_twist k f L L₀ hamp
  set M := tensorPowModule X L₀ (d : ℤ)
  have cmp := AlgebraicGeometry.SheafOfModules.tensorIso X.presheaf X.ringCatSheaf.2 L M
  have : IsInvertibleModule X (L ⊗ M) :=
    have := Stacks.TensorSectionNonvanishing.isInvertibleModule_tensorObj L M
    Stacks.AlgebraicGeometry.ProjAmpleTwist.isInvertibleModule_of_iso cmp
  refine ⟨L ⊗ M, M, this, inferInstance, ?_, h₂, ⟨?_⟩⟩
  · obtain ⟨E, hE, i, h1, h2, ⟨e⟩⟩ := h₁
    exact ⟨E, hE, i, h1, h2, ⟨cmp.symm ≪≫ e⟩⟩
  have e : (M ⊗ tensorPowModule X M (-1) : X.Modules) ≅ 𝟙_ _ :=
    whiskerRightIso (tensorPowModuleOneIso X M).symm _ ≪≫
      tensorPowModuleAddIso X M 1 (-1) ≪≫ tensorPowModuleZeroIso X M
  exact (ρ_ L).symm ≪≫ whiskerLeftIso L e.symm ≪≫ (α_ L M _).symm

end MMP.Foundation

end

/-! ### Standard smooth neighbourhoods -/

section

open AlgebraicGeometry CategoryTheory MvPolynomial

namespace MMP.Foundations

/-- A standard smooth `k`-algebra is a quotient `k[z, y] / (F₁, …, F_c)` with `c` relations
whose Jacobian determinant along the variables `y` is a unit of the quotient. -/
private theorem exists_quotient_algEquiv_of_isStandardSmooth (k A : Type*) [CommRing k] [CommRing A]
    [Algebra k A] [Algebra.IsStandardSmooth k A] :
    ∃ (d c : ℕ) (F : Fin c → MvPolynomial (Fin d ⊕ Fin c) k)
      (_ : (MvPolynomial (Fin d ⊕ Fin c) k ⧸ Ideal.span (Set.range F)) ≃ₐ[k] A),
      IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Sum.inr j) (F i)).det) := by
  classical
  obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := ‹Algebra.IsStandardSmooth k A›.out
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite σ
  let eσ := Fintype.equivFin σ
  let T := {i : ι // i ∉ Set.range P.map}
  let G : Fin (Fintype.card T) ⊕ Fin (Fintype.card σ) ≃ ι :=
    (Equiv.sumCongr (Fintype.equivFin T).symm
        (eσ.symm.trans (Equiv.ofInjective P.map P.map_inj))).trans
      ((Equiv.sumComm _ _).trans (Equiv.sumCompl (fun i => i ∈ Set.range P.map)))
  have hG : ∀ j, G.symm (P.map (eσ.symm j)) = Sum.inr j := by
    intro j
    rw [Equiv.symm_apply_eq]
    simp [G]
    rfl
  let R : MvPolynomial ι k ≃ₐ[k] MvPolynomial _ k := renameEquiv k G.symm
  let F : Fin (Fintype.card σ) → MvPolynomial _ k := fun i => R (P.relation (eσ.symm i))
  have hJ : Ideal.span (Set.range F) = (Ideal.span (Set.range P.relation)).map (R : _ →+* _) := by
    rw [Ideal.map_span, ← Set.range_comp]
    congr 1
    ext x
    simp only [Set.mem_range, Function.comp_apply, F]
    exact ⟨fun ⟨_, h⟩ => ⟨_, h⟩, fun ⟨i, h⟩ => ⟨eσ i, by simpa using h⟩⟩
  let e : (MvPolynomial _ k ⧸ Ideal.span (Set.range F)) ≃ₐ[k] A :=
    ((Ideal.quotientEquivAlg _ _ R hJ).symm.trans
      (Ideal.quotientEquivAlgOfEq k P.span_range_relation_eq_ker)).trans
      (P.quotientEquiv.restrictScalars k)
  have he : ∀ x, e (Ideal.Quotient.mk _ (R x)) = algebraMap P.Ring A x := by
    intro x
    have h1 : (Ideal.quotientEquivAlg _ _ R hJ).symm (Ideal.Quotient.mk _ (R x)) =
        Ideal.Quotient.mk _ x := by
      rw [AlgEquiv.symm_apply_eq, Ideal.quotientEquivAlg_mk]
    simp only [e, AlgEquiv.trans_apply, h1, Ideal.quotientEquivAlgOfEq_mk,
      AlgEquiv.restrictScalars_apply]
    exact P.quotientEquiv_mk x
  refine ⟨_, _, F, e, ?_⟩
  rw [← isUnit_map_iff e]
  have hM : (Matrix.of fun i j : Fin (Fintype.card σ) => pderiv (Sum.inr j) (F i)) =
      (R : MvPolynomial ι k →+* _).mapMatrix
        (P.jacobiMatrix.transpose.submatrix eσ.symm eσ.symm) := by
    refine Matrix.ext fun i j => ?_
    simp only [Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.submatrix_apply,
      Matrix.transpose_apply, P.jacobiMatrix_apply, F, ← hG j, R, renameEquiv_apply]
    exact pderiv_rename G.symm.injective _ _
  rw [hM, ← RingHom.map_det, Matrix.det_submatrix_equiv_self, Matrix.det_transpose]
  convert P.jacobian_isUnit using 1
  rw [P.jacobian_eq_jacobiMatrix_det]
  exact he _

/-- Every point of a scheme smooth over a field `k` has an affine open neighbourhood
`k`-isomorphic to `Spec (k[z, y] / (F₁, …, F_c))` with `c` relations in the variables
`y₁, …, y_c` and `d` further variables `z`, whose Jacobian determinant
`det (∂Fᵢ/∂yⱼ)` is a unit in the coordinate ring. -/
@[mmp "lem_mmp_foundation_smooth_standard_neighbourhood"]
public theorem exists_affine_nbhd_iso_spec_standardSmooth (k : Type u) [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [Smooth f] (p : X) :
    ∃ (U : X.affineOpens) (_ : p ∈ (U : X.Opens)) (d c : ℕ)
      (F : Fin c → MvPolynomial (Fin d ⊕ Fin c) k)
      (e : (U : X.Opens).toScheme ≅
        Spec (.of (MvPolynomial (Fin d ⊕ Fin c) k ⧸ Ideal.span (Set.range F)))),
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap k
          (MvPolynomial (Fin d ⊕ Fin c) k ⧸ Ideal.span (Set.range F)))) =
        (U : X.Opens).ι ≫ f ∧
      IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range F))
        (Matrix.of fun i j : Fin c => MvPolynomial.pderiv (Sum.inr j) (F i)).det) := by
  obtain ⟨U, hU, V, hV, hpV, hle, hss⟩ := Smooth.exists_isStandardSmooth f p
  obtain rfl : U = ⊤ :=
    eq_top_iff.2 fun x _ => Subsingleton.elim (f p) x ▸ hle hpV
  let _ : Algebra k Γ(X, V) :=
    ((f.appLE ⊤ V hle).hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom).toAlgebra
  have : Algebra.IsStandardSmooth k Γ(X, V) := RingHom.isStandardSmooth_respectsIso.2 _
    (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv hss
  obtain ⟨d, c, F, e, hunit⟩ := exists_quotient_algEquiv_of_isStandardSmooth k Γ(X, V)
  refine ⟨⟨V, hV⟩, hpV, d, c, F,
    hV.isoSpec ≪≫ Scheme.Spec.mapIso e.toRingEquiv.toCommRingCatIso.op, ?_, hunit⟩
  have h1 : (CommRingCat.ofHom (algebraMap k _) ≫ e.toRingEquiv.toCommRingCatIso.hom) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ V hle := by
    ext x
    exact e.commutes x
  have h2 := IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hV hle
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h2
  simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, Scheme.Spec_map, Quiver.Hom.unop_op,
    Category.assoc]
  rw [← Spec.map_comp, h1, Spec.map_comp, h2,
    ← IsAffineOpen.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc]

end MMP.Foundations

end

/-! ### Threefold step diagrams extract no divisor -/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

open MMP.Mori

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

variable {Xm Xp Z : Scheme.{0}} [IsIntegral Xm] [CompactSpace Xm] [IsLocallyNoetherian Xm]
  [IsNormal Xm] [IsIntegral Xp] [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]

/-- The image under a closed map of the support of a prime divisor `E` is the support of the
prime divisor whose generic point is the image of `η_E`. -/
private theorem image_support_eq {X Y : Scheme.{u}} (f : X ⟶ Y) (hf : IsClosedMap f)
    (E : MMP.Mori.PrimeDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (h : f E.genericPoint = P.genericPoint) : f '' (E.support : Set X) = P.support := by
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure E,
    AlgebraicGeometry.PrimeDivisor.support_eq_closure P,
    ← hf.closure_image_eq_of_continuous f.continuous, Set.image_singleton, h]

/-- A proper birational morphism onto a normal integral scheme is an isomorphism over every
point of coheight one: its fibre there is a single point. -/
private theorem mem_biregularLocus_of_coheight_eq_one {X Y : Scheme.{u}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian Y] [IsNormal Y] (f : X ⟶ Y) [IsProper f]
    (hf : IsBirationalMorphism f) {y : Y} (hy : Order.coheight y = 1) :
    y ∈ biregularLocus f := by
  have : IsDominant f := hf.isDominant
  have hbij := hf.functionFieldMap_bijective
  have := Stacks.AlgebraicGeometry.UnitsNormalProper.isDiscreteValuationRing_stalk hy
  have hsub : (f ⁻¹' {y}).Subsingleton := by
    intro a ha b hb
    have ha' : f a = y := ha
    have hb' : f b = y := hb
    have : ValuationRing (Y.presheaf.stalk (f a)) := by rw [ha']; infer_instance
    have : ValuationRing (Y.presheaf.stalk (f b)) := by rw [hb']; infer_instance
    have := MMP.Positivity.isIso_stalkMap_of_valuationRing f hbij a
    have := MMP.Positivity.isIso_stalkMap_of_valuationRing f hbij b
    exact MMP.Positivity.eq_of_isIso_stalkMap f hbij (hb'.trans ha'.symm)
  obtain ⟨hU, hiso⟩ := (MMP.Resolution.Bridges.isOpen_finiteFibreLocus_and_isIso f
    (MMP.Resolution.Bridges.isBirational_of_isBirationalMorphism hf)).1 inferInstance
  exact le_biregularLocus (V := ⟨_, hU⟩) hiso hsub.finite

/-- If `f(η_E) = η_P` and `f^♯ : 𝒪_{Y,P} ⟶ 𝒪_{X,E}` is an isomorphism, then `ord_E = ord_P` as
valuations of `k(Y)`. -/
private theorem valuationOver_eq_divisorialValuation {X Y : Scheme.{u}} [IsIntegral X]
    [IsIntegral Y] [IsLocallyNoetherian X] [IsNormal X] [IsLocallyNoetherian Y] [IsNormal Y]
    (f : X ⟶ Y) [IsDominant f] (E : MMP.Mori.PrimeDivisor X) (P : MMP.Mori.PrimeDivisor Y)
    (heq : f E.genericPoint = P.genericPoint) [IsIso (f.stalkMap E.genericPoint)] :
    E.valuationOver f = P.divisorialValuation := by
  ext g
  by_cases hg : g = 0
  · simp [hg]
  have hg' : functionFieldMap f g ≠ 0 := (map_ne_zero _).mpr hg
  rw [PrimeDivisor.valuationOver_apply, E.divisorialValuation_eq_exp_neg_ord hg',
    P.divisorialValuation_eq_exp_neg_ord hg,
    MMP.Positivity.ord_functionFieldMap_of_isIso f E P heq g]

/-- If `f⁻¹_* Q' = P`, then `f(η_P) ∈ Q'`. -/
private theorem map_genericPoint_mem_of_inverseTransformPrimeDivisor_eq_some {X Y : Scheme.{u}}
    {f : X ⟶ Y} {P : MMP.Mori.PrimeDivisor X} {Q' : MMP.Mori.PrimeDivisor Y}
    (h : inverseTransformPrimeDivisor f Q' = some P) :
    f P.genericPoint ∈ (Q'.support : Set Y) := by
  have hs := support_inverseTransformPrimeDivisor h
  have hP : P.genericPoint ∈ (P.support : Set X) :=
    MMP.Flips.primeDivisor_genericPoint_mem_support P
  rw [hs] at hP
  have hcl : IsClosed (f ⁻¹' (Q'.support : Set Y)) :=
    (Q'.idealSheaf.support.isClosed).preimage f.continuous
  exact closure_minimal (fun z hz => hz.1) hcl hP

/-- Only `Q` has inverse transform `P`, when `f(η_P) = η_Q`. -/
private theorem eq_of_inverseTransformPrimeDivisor_eq_some {X Y : Scheme.{u}} {f : X ⟶ Y}
    (P : MMP.Mori.PrimeDivisor X) (Q Q' : MMP.Mori.PrimeDivisor Y)
    (he : f P.genericPoint = Q.genericPoint) (h : inverseTransformPrimeDivisor f Q' = some P) :
    Q' = Q := by
  have hQ' : Q.genericPoint ∈ (Q'.support : Set Y) :=
    he ▸ map_genericPoint_mem_of_inverseTransformPrimeDivisor_eq_some h
  have := Q'.eq_genericPoint_of_mem_support hQ' Q.coheight_genericPoint
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective this.symm

/-- **The inverse transform over the biregular locus.** If `f(η_P) = η_Q` lies in the biregular
locus of `f`, then `f⁻¹_* Q = P`. -/
private theorem inverseTransformPrimeDivisor_eq_some_of_mem_biregularLocus {X Y : Scheme.{u}}
    {f : X ⟶ Y} (P : MMP.Mori.PrimeDivisor X) (Q : MMP.Mori.PrimeDivisor Y)
    (he : f P.genericPoint = Q.genericPoint) (hQ : Q.genericPoint ∈ biregularLocus f) :
    inverseTransformPrimeDivisor f Q = some P := by
  rw [inverseTransformPrimeDivisor_eq_some_iff]
  refine ⟨⟨Q.genericPoint, MMP.Flips.primeDivisor_genericPoint_mem_support Q, hQ⟩, ?_⟩
  have := P.integral
  rw [inverseTransformIdeal]
  refine Scheme.IdealSheafData.eq_vanishingIdeal_of_isReduced_subscheme _ _ ?_
  ext1
  change (P.support : Set X) = closure (f ⁻¹' ((Q.support : Set Y) ∩ biregularLocus f))
  set V := biregularLocus f
  haveI : IsIso (f ∣_ V) := isBiregular_biregularLocus f
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure]
  refine le_antisymm (closure_mono ?_) (closure_minimal ?_ isClosed_closure)
  · rintro _ rfl
    exact ⟨he ▸ MMP.Flips.primeDivisor_genericPoint_mem_support Q, he ▸ hQ⟩
  · rintro x ⟨hxQ, hxV⟩
    have hPV : f P.genericPoint ∈ V := he ▸ hQ
    let x' : (f ⁻¹ᵁ V).toScheme := ⟨x, hxV⟩
    let p' : (f ⁻¹ᵁ V).toScheme := ⟨P.genericPoint, hPV⟩
    have hι : ∀ z : (f ⁻¹ᵁ V).toScheme, V.ι ((f ∣_ V) z) = f z.1 := fun z => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
      rfl
    have h1 : V.ι ((f ∣_ V) p') ⤳ V.ι ((f ∣_ V) x') := by
      rw [hι, hι]
      change f P.genericPoint ⤳ f x
      rw [he, specializes_iff_mem_closure, ← AlgebraicGeometry.PrimeDivisor.support_eq_closure]
      exact hxQ
    rw [V.ι.isOpenEmbedding.isInducing.specializes_iff,
      (f ∣_ V).isOpenEmbedding.isInducing.specializes_iff] at h1
    have h2 := h1.map (f ⁻¹ᵁ V).ι.continuous
    rwa [← specializes_iff_mem_closure]

/-- The inverse transform under `g` of the prime divisor `Q`, when `g` is an isomorphism over
`η_Q = g(η_P)`, is `P`, and it is the only prime divisor so transformed to `P`: the coefficient
of `P` in `g⁻¹_* D` is the coefficient of `Q` in `D`. -/
private theorem inverseTransformDivisor_apply_eq {X Y : Scheme.{u}} {R : Type*}
    [AddCommMonoid R] (g : Y ⟶ X) (P : MMP.Mori.PrimeDivisor Y) (Q : MMP.Mori.PrimeDivisor X)
    (heq : g P.genericPoint = Q.genericPoint) (hQ : Q.genericPoint ∈ biregularLocus g)
    (D : DivisorWithCoeffs R X) : inverseTransformDivisor g D P = D Q :=
  MMP.Positivity.mapPrimeDivisors_apply_of_forall_eq
    (inverseTransformPrimeDivisor_eq_some_of_mem_biregularLocus P Q heq hQ)
    (fun E' hE' => eq_of_inverseTransformPrimeDivisor_eq_some P Q E' heq hE') D

/-- The log discrepancy of a prime divisor `P` of a normal variety `X`, regarded as a divisor
over `X` on the identity model, with respect to a pair `(X, B)` is `1 - coeff_P B`. -/
private theorem isLogDiscrepancy_ofPrimeDivisor {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [IsIntegral X] [IsLocallyNoetherian X] [IsNormal X] [CompactSpace X]
    (hX : IsNormalVariety ℂ sX) {n : ℕ} {K : MMP.Mori.Divisor X}
    (hK : K.IsCanonicalDivisor sX n) {B : MMP.Mori.QDivisor X}
    (hKB : (MMP.Mori.Divisor.toQDivisor K + B).IsQCartier) (P : MMP.Mori.PrimeDivisor X) :
    MMP.Intersection.IsLogDiscrepancy sX n (QDivisor.toRDivisor B)
      (DivisorOver.ofPrimeDivisor ℂ hX P) (1 - (B.coeff P : ℝ)) := by
  obtain ⟨ω, hω0, hω⟩ := MMP.Positivity.IsCanonicalDivisor.exists_ordForm_eq hX hK
  obtain ⟨m, hm, M, hM, hMc⟩ := hKB.exists_pos
  have hn := hK.topologicalKrullDim_eq
  obtain ⟨M', hM'⟩ := MMP.Threefold.Bridges.exists_isPullback_of_isDominant (𝟙 X) hMc
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  have hMΓ : ∀ Γ, (M.coeff Γ : ℝ) = m * (K.coeff Γ + B.coeff Γ) := by
    intro Γ
    have := congrArg (fun G : QDivisor X => G.coeff Γ) hM
    have h' : (M.coeff Γ : ℚ) = m * (K.coeff Γ + B.coeff Γ) := by
      simp at this
      linear_combination this
    exact_mod_cast h'
  have hM'P : M'.coeff P = M.coeff P :=
    MMP.Positivity.coeff_eq_of_isPullback (f := 𝟙 X) P P rfl hMc hM'
  have hord : (DivisorOver.ofPrimeDivisor ℂ hX P).ordPullback ω = P.ordForm ω :=
    DivisorOver.ordPullback_ofPrimeDivisor hX hn P ω
  refine ⟨hX, (inferInstance : IsProper (𝟙 X)), ω, hω0, ⟨K, hK, fun Γ => (hω Γ).symm⟩, 1,
    fun _ => 1 / (m : ℝ), fun _ => M, fun _ => M', fun _ => hMc, fun Γ => ?_,
    fun _ => ⟨_, hM'⟩, ?_⟩
  · rw [QDivisor.coeff_toRDivisor, Fin.sum_univ_one, hMΓ, hω Γ]
    field_simp
  · rw [Fin.sum_univ_one, hord]
    change 1 - (B.coeff P : ℝ) = 1 + (P.ordForm ω : ℝ) - 1 / (m : ℝ) * (M'.coeff P : ℝ)
    rw [hM'P, hMΓ, hω P]
    field_simp
    ring

/-- **Threefold steps extract no divisor.** In a threefold step diagram
`(X⁻, B⁻) → Z ← (X⁺, B⁺)`, for every prime divisor `P` of `X⁺` there are prime divisors `P⁻` of
`X⁻` and `Q` of `Z` with `ord_{P⁻} = ord_P` as valuations of `k(Z)`, `f⁻(P⁻) = f⁺(P) = Q`, both
`f^±` isomorphisms over the generic point of `Q`, `coeff_P B⁺ = coeff_{P⁻} B⁻`, and
`a(ord_P; X⁺, B⁺) = a(ord_{P⁻}; X⁻, B⁻)`. -/
@[mmp "lem_mmp_indexc_step_extracts_no_divisor"]
public theorem IsThreefoldStepDiagram.exists_primeDivisor_valuationOver_eq
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}
    (h : IsThreefoldStepDiagram sXm sZ sXp K B fm fp) (P : MMP.Mori.PrimeDivisor Xp) :
    haveI : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
    haveI := h.isBirationalMorphism_minus.isDominant
    haveI := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
    ∃ (Pm : MMP.Mori.PrimeDivisor Xm) (Q : MMP.Mori.PrimeDivisor Z),
      Pm.valuationOver fm = P.valuationOver fp ∧
      fm '' (Pm.support : Set Xm) = Q.support ∧ fp '' (P.support : Set Xp) = Q.support ∧
      Q.genericPoint ∈ commonBiregularLocus fm fp ∧
      (flipTransform fm fp B).coeff P = B.coeff Pm ∧
      ∃ a : ℝ,
        MMP.Intersection.IsLogDiscrepancy sXp 3 (QDivisor.toRDivisor (flipTransform fm fp B))
          (DivisorOver.ofPrimeDivisor ℂ h.isNormalVariety_plus P) a ∧
        MMP.Intersection.IsLogDiscrepancy sXm 3 (QDivisor.toRDivisor B)
          (DivisorOver.ofPrimeDivisor ℂ h.isNormalVariety_minus Pm) a := by
  haveI : IsIntegral Z := h.isNormalVariety_target.1.toIsIntegral
  haveI := h.isBirationalMorphism_minus.isDominant
  haveI := h.isSmallMorphism_plus.isBirationalMorphism.isDominant
  haveI : IsNormal Z := h.isNormalVariety_target.2
  haveI : LocallyOfFiniteType sZ := h.isNormalVariety_target.1.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
  haveI : IsProper fm := isProper_of_isProjectiveMorphism fm h.isProjectiveMorphism_minus
  haveI : IsProper fp := h.isSmallMorphism_plus.isProper
  have hbm := h.isBirationalMorphism_minus
  have hbp := h.isSmallMorphism_plus.isBirationalMorphism
  have hηP : fp P.genericPoint ∈ biregularLocus fp := by
    by_contra hn
    have := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet
      h.isSmallMorphism_plus.two_le_codimension (mem_exceptionalSet.mpr hn)
    rw [AlgebraicGeometry.PrimeDivisor.coheight_genericPoint] at this
    exact absurd this (by decide)
  have hcoh : Order.coheight (fp P.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus fp hηP,
      AlgebraicGeometry.PrimeDivisor.coheight_genericPoint]
  set Q := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hcoh
  have hQ : Q.genericPoint = fp P.genericPoint :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ _
  obtain ⟨Pm, hPm, hisoPm, htr⟩ :=
    MMP.Positivity.exists_isIso_stalkMap_forall_transformDivisor_apply
      h.isNormalVariety_target (f := fm) (by rw [h.comp_eq_minus]; exact h.isNormalVariety_minus)
      hbm Q
  have hisoP : IsIso (fp.stalkMap P.genericPoint) := by
    have := Stacks.AlgebraicGeometry.UnitsNormalProper.isDiscreteValuationRing_stalk hcoh
    exact MMP.Positivity.isIso_stalkMap_of_valuationRing fp hbp.functionFieldMap_bijective _
  have hQV : Q.genericPoint ∈ commonBiregularLocus fm fp :=
    ⟨mem_biregularLocus_of_coheight_eq_one fm hbm
        (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Q),
      mem_biregularLocus_of_coheight_eq_one fp hbp
        (AlgebraicGeometry.PrimeDivisor.coheight_genericPoint Q)⟩
  have hcoeff : (flipTransform fm fp B).coeff P = B.coeff Pm := by
    change inverseTransformDivisor fp (RationalMap.transformDivisor (X := Xm) fm.toRationalMap B)
      P = B Pm
    rw [inverseTransformDivisor_apply_eq fp P Q hQ.symm hQV.2, htr]
  obtain ⟨mm, hKm⟩ := h.isCanonicalDivisor
  obtain ⟨mp, hKp⟩ := h.isCanonicalDivisor_plus
  have hmm : mm = 3 := by exact_mod_cast hKm.topologicalKrullDim_eq.symm.trans h.dim_minus
  have hmp : mp = 3 := by exact_mod_cast hKp.topologicalKrullDim_eq.symm.trans h.dim_plus
  subst hmm hmp
  refine ⟨Pm, Q, ?_, image_support_eq fm fm.isClosedMap Pm Q hPm,
    image_support_eq fp fp.isClosedMap P Q hQ.symm, hQV, hcoeff, 1 - (B.coeff Pm : ℝ), ?_, ?_⟩
  · rw [valuationOver_eq_divisorialValuation fm Pm Q hPm,
      valuationOver_eq_divisorialValuation fp P Q hQ.symm]
  · rw [← hcoeff]
    exact isLogDiscrepancy_ofPrimeDivisor h.isNormalVariety_plus hKp h.isQCartier_plus P
  · exact isLogDiscrepancy_ofPrimeDivisor h.isNormalVariety_minus hKm h.isQCartier_minus Pm

end MMP.Fourfold

end

/-! ### Small threefold steps preserve exceptionality -/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

open MMP.Mori

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold

/-- A normalized divisorial valuation realized by a proper divisor `D` over a variety is
exceptional iff the centre of `D` has codimension at least two. -/
private theorem isExceptionalValuation_valuation_iff {k : Type} [Field k] {X : Scheme.{0}}
    [IsIntegral X] {sX : X ⟶ Spec (.of k)} (hX : MMP.Mori.IsVariety k sX)
    (D : DivisorOver k sX) (hD : IsProper D.f) :
    MMP.Intersection.IsExceptionalValuation k sX D.valuation ↔ 2 ≤ codimension D.center := by
  refine ⟨fun ⟨D₁, _, h, hc⟩ => ?_, fun h => ⟨D, hD, rfl, h⟩⟩
  rwa [MMP.Positivity.DivisorOver.center_eq_of_valuation_eq hX h]

/-- A valuation `ξ'` of `ℂ(X')` restricting on `ℂ(Z)` to the valuation of a divisor `D` over a
model `X ⟶ Z` is a divisor of the function field `ℂ(X')`: it is `ord_E` on the normal variety
`D.Y`, transported along `ℂ(X') ≅ ℂ(Z) ≅ ℂ(D.Y)`. -/
private theorem isDivisorOfFunctionField_of_comap_eq
    {X X' Z : Scheme.{0}} [IsIntegral X] [IsIntegral X'] [IsIntegral Z]
    {sZ : Z ⟶ Spec (.of ℂ)} (g : X ⟶ Z) (g' : X' ⟶ Z) [IsDominant g] [IsDominant g']
    (hg : IsBirationalMorphism g) (hg' : IsBirationalMorphism g')
    (D : DivisorOver ℂ (g ≫ sZ)) (ξ' : Valuation X'.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ'.comap (functionFieldMap g') = D.valuation.comap (functionFieldMap g)) :
    MMP.Flips.IsDivisorOfFunctionField ℂ (g' ≫ sZ) ξ' := by
  haveI := D.isIntegral
  haveI := D.isNormal
  haveI := D.isLocallyNoetherian
  haveI := D.isDominant
  have hY : IsNormalVariety ℂ ((D.f ≫ g) ≫ sZ) := by
    simpa only [Category.assoc] using D.isNormalVariety
  have hbij : Function.Bijective (functionFieldMap (D.f ≫ g)) := by
    have : ⇑(functionFieldMap (D.f ≫ g)) = functionFieldMap D.f ∘ functionFieldMap g := by
      funext t
      exact (MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply D.f g t).symm
    rw [this]
    exact D.isBirationalMorphism.functionFieldMap_bijective.comp hg.functionFieldMap_bijective
  refine ⟨D.Y, (D.f ≫ g) ≫ sZ, hY, D.E, ?_⟩
  letI := MMP.Mori.functionFieldAlgebra sZ
  letI := MMP.Mori.functionFieldAlgebra (g' ≫ sZ)
  letI := MMP.Mori.functionFieldAlgebra ((D.f ≫ g) ≫ sZ)
  let eP := MMP.Mori.functionFieldAlgEquiv sZ g' hg'.functionFieldMap_bijective
  let eY := MMP.Mori.functionFieldAlgEquiv sZ (D.f ≫ g) hbij
  refine ⟨eP.symm.trans eY, ?_⟩
  ext t
  obtain ⟨s, rfl⟩ := hg'.functionFieldMap_bijective.2 t
  have hs := congrArg (fun v => v s) h
  simp only [Valuation.comap_apply] at hs
  have h1 : eP.symm (functionFieldMap g' s) = s := eP.symm_apply_apply s
  change ξ' (functionFieldMap g' s) = D.E.divisorialValuation (eY (eP.symm (functionFieldMap g' s)))
  rw [h1, hs]
  change D.E.divisorialValuation (functionFieldMap D.f (functionFieldMap g s)) = _
  rw [MMP.Positivity.DivisorOver.functionFieldMap_functionFieldMap_apply D.f g s]
  rfl

/-- **The centre on a proper model.** Let `g : X ⟶ Z` and `g' : X' ⟶ Z` be dominant morphisms of
integral schemes with `g'` proper, and `D` a divisor over `X`. A valuation `ξ'` of `k(X')`
restricting on `k(Z)` to `ord_D` dominates the local ring of some point of `X'`: the valuation
ring of `ξ'` dominates `𝒪_{Z, g(c_X(D))}`, and the valuative criterion for `g'` lifts
`Spec 𝒪_{ξ'} ⟶ Z` to `X'`. -/
private theorem exists_dominated_point_of_comap_eq {k : Type} [Field k]
    {X X' Z : Scheme.{0}} [IsIntegral X] [IsIntegral X'] [IsIntegral Z] {sX : X ⟶ Spec (.of k)}
    (g : X ⟶ Z) (g' : X' ⟶ Z) [IsDominant g] [IsDominant g'] [IsProper g']
    (D : DivisorOver k sX) (ξ' : Valuation X'.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ'.comap (functionFieldMap g') = D.valuation.comap (functionFieldMap g)) :
    ∃ x : X', (∀ a : X'.presheaf.stalk x, ξ' (algebraMap _ X'.functionField a) ≤ 1) ∧
      ∀ a ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk x),
        ξ' (algebraMap _ X'.functionField a) < 1 := by
  set y := D.f D.E.genericPoint
  set z := g y
  have hw : ∀ b : Z.presheaf.stalk z,
      ξ' (functionFieldMap g' (algebraMap _ Z.functionField b)) =
        D.valuation (algebraMap _ X.functionField ((g.stalkMap y).hom b)) := by
    intro b
    have := congrArg (fun v => v (algebraMap _ Z.functionField b)) h
    simp only [Valuation.comap_apply] at this
    rw [this, functionFieldMap_algebraMap_stalk g y b]
  let R := ξ'.valuationSubring
  let φ : Z.presheaf.stalk z →+* R :=
    ((functionFieldMap g').comp (algebraMap (Z.presheaf.stalk z) Z.functionField)).codRestrict R
      fun b => (ξ'.mem_valuationSubring_iff _).2 (by
        rw [RingHom.comp_apply, hw]
        exact MMP.Positivity.DivisorOver.valuation_algebraMap_le_one D y rfl _)
  have hgen : genericPoint Z ⤳ z := (genericPoint_spec Z).specializes trivial
  have hex : ValuativeCriterion.Existence g' := by
    have h : IsProper g' := inferInstance
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1.existence
  let S : ValuativeCommSq g' :=
    { R := R
      K := X'.functionField
      i₁ := X'.fromSpecStalk (genericPoint X')
      i₂ := Spec.map (CommRingCat.ofHom φ) ≫ Z.fromSpecStalk z
      commSq := ⟨by
        rw [← functionFieldMap_fromSpecStalk g',
          ← Scheme.SpecMap_stalkSpecializes_fromSpecStalk hgen, ← Category.assoc,
          ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
        rfl⟩ }
  obtain ⟨⟨l, hl₁, -⟩⟩ := (hex S).exists_lift
  have hl₁' : Spec.map (CommRingCat.ofHom (algebraMap R X'.functionField)) ≫ l =
      X'.fromSpecStalk (genericPoint X') := hl₁
  set x := l (IsLocalRing.closedPoint R)
  have hx : genericPoint X' ⤳ x := (genericPoint_spec X').specializes trivial
  let f := Scheme.stalkClosedPointTo l
  have hf : f ≫ CommRingCat.ofHom (algebraMap R X'.functionField) =
      X'.presheaf.stalkSpecializes hx := by
    apply Spec.map_injective
    apply (cancel_mono (X'.fromSpecStalk x)).mp
    rw [Spec.map_comp, Category.assoc, Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl₁',
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
  have hfa : ∀ a : X'.presheaf.stalk x,
      algebraMap _ X'.functionField a = ((f.hom a : R) : X'.functionField) := fun a =>
    (congrArg (fun q => q.hom a) hf).symm
  refine ⟨x, fun a => ?_, fun a ha => ?_⟩
  · rw [hfa]
    exact (f.hom a).2
  · rw [hfa]
    exact Valuation.Integer.not_isUnit_iff_valuation_lt_one.mp
      (fun hu => (IsLocalRing.mem_maximalIdeal _).1 ha (isUnit_of_map_unit f.hom a hu))

/-- Over a proper birational model `X' ⟶ Z` of a normal variety, a valuation `ξ'` of `ℂ(X')`
restricting on `ℂ(Z)` to the valuation of a divisor over another model `X ⟶ Z` is realized by a
proper divisor over `X'`. -/
private theorem exists_properDivisorOver_valuation_eq_of_comap_eq
    {X X' Z : Scheme.{0}} [IsIntegral X] [IsIntegral X'] [IsIntegral Z]
    {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)}
    (hX' : IsNormalVariety ℂ sX') (g : X ⟶ Z) (g' : X' ⟶ Z) [IsDominant g] [IsDominant g']
    (hg : IsBirationalMorphism g) (hg' : IsBirationalMorphism g') [IsProper g']
    (hc : g ≫ sZ = sX) (hc' : g' ≫ sZ = sX') (D : DivisorOver ℂ sX)
    (ξ' : Valuation X'.functionField (WithZero (Multiplicative ℤ)))
    (h : ξ'.comap (functionFieldMap g') = D.valuation.comap (functionFieldMap g)) :
    ∃ D' : DivisorOver ℂ sX', IsProper D'.f ∧ D'.valuation = ξ' := by
  obtain ⟨x, h1, h2⟩ := exists_dominated_point_of_comap_eq g g' D ξ' h
  haveI : AlgebraicGeometry.IsVariety ℂ sX' := hX'.1
  have hξ : MMP.Flips.IsDivisorOfFunctionField ℂ sX' ξ' := by
    subst hc hc'
    exact isDivisorOfFunctionField_of_comap_eq g g' hg hg' D ξ' h
  obtain ⟨D', -, hv, -⟩ :=
    MMP.Flips.exists_properDivisorOver_isProjective_of_dominates sX' hξ x h1 h2
  exact ⟨D'.toDivisorOver, D'.isProper, hv⟩

/-- Valuations agreeing after restriction along a bijective ring map agree. -/
private theorem valuation_eq_of_comap_eq {K L Γ₀ : Type*} [Ring K] [Ring L]
    [LinearOrderedCommMonoidWithZero Γ₀] {σ : K →+* L}
    (hσ : Function.Bijective σ) {v w : Valuation L Γ₀}
    (h : v.comap σ = w.comap σ) : v = w :=
  Valuation.ext fun t => by
    obtain ⟨s, rfl⟩ := hσ.2 t
    exact congrArg (fun u => u s) h

/-- The divisor `(X, 𝟙, P)` over `X` has valuation `ord_P`. -/
private theorem valuation_ofPrimeDivisor {X : Scheme.{0}} [IsIntegral X] [IsLocallyNoetherian X]
    [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    (P : MMP.Mori.PrimeDivisor X) :
    (DivisorOver.ofPrimeDivisor ℂ hX P).valuation = P.divisorialValuation := by
  ext g
  change P.divisorialValuation (functionFieldMap (𝟙 X) g) = _
  rw [MMP.Mori.functionFieldMap_id_apply]

/-- Prime divisors of a normal variety with the same valuation are equal. -/
private theorem eq_of_divisorialValuation_eq {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} (hX : IsNormalVariety ℂ sX)
    {P P' : MMP.Mori.PrimeDivisor X} (h : P.divisorialValuation = P'.divisorialValuation) :
    P = P' := by
  have := MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX.1
    (D := DivisorOver.ofPrimeDivisor ℂ hX P) (D' := DivisorOver.ofPrimeDivisor ℂ hX P')
    (by rw [valuation_ofPrimeDivisor, valuation_ofPrimeDivisor, h])
  exact AlgebraicGeometry.PrimeDivisor.genericPoint_injective this

variable {Xm Xp Z : Scheme.{0}} [IsIntegral Xm] [CompactSpace Xm] [IsLocallyNoetherian Xm]
  [IsNormal Xm] [IsIntegral Xp] [CompactSpace Xp] [IsLocallyNoetherian Xp] [IsNormal Xp]

/-- **Strict transform along a small step.** When `f⁻` is small, every prime divisor `P` of `X⁻`
has a strict transform `P⁺` on `X⁺` with `ord_{P⁺} = ord_P` on `ℂ(Z)`: `f⁻` is an isomorphism at
`η_P`, so `f⁻(η_P)` is the generic point of a prime divisor `Q` of `Z`, over which the small `f⁺`
is an isomorphism; `P⁺` is the prime divisor over `η_Q`, and both valuations are `ord_Q`. -/
private theorem exists_flipTransformPrimeDivisor_eq_some
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}
    (hD : IsThreefoldStepDiagram sXm sZ sXp K B fm fp) (hsmall : IsSmallMorphism sXm sZ fm) :
    haveI := hD.isNormalVariety_target.1.toIsIntegral
    haveI := hD.isBirationalMorphism_minus.isDominant
    haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
    ∀ P : MMP.Mori.PrimeDivisor Xm, ∃ P' : MMP.Mori.PrimeDivisor Xp,
      flipTransformPrimeDivisor fm fp P = some P' ∧ P'.valuationOver fp = P.valuationOver fm := by
  haveI := hD.isNormalVariety_target.1.toIsIntegral
  haveI := hD.isBirationalMorphism_minus.isDominant
  haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
  intro P
  haveI : IsNormal Z := hD.isNormalVariety_target.2
  haveI : IsLocallyNoetherian Z :=
    haveI := hD.isNormalVariety_target.1.toLocallyOfFiniteType
    LocallyOfFiniteType.isLocallyNoetherian sZ
  haveI := hD.isNormalVariety_target.1
  haveI : IsSeparated (Z ↘ Limits.terminal Scheme) := by
    rw [show (Z ↘ Limits.terminal Scheme) = sZ ≫ (Spec (.of ℂ) ↘ Limits.terminal Scheme) from
      Limits.terminal.hom_ext _ _]
    infer_instance
  haveI := hD.isSmallMorphism_plus.isProper
  have hPm : fm P.genericPoint ∈ biregularLocus fm := by
    by_contra hn
    have hex : P.genericPoint ∈ exceptionalSet fm := hn
    have := MMP.Positivity.two_le_coheight_of_mem_exceptionalSet hsmall.two_le_codimension hex
    rw [P.coheight_genericPoint] at this
    exact absurd this (by decide)
  have hz : Order.coheight (fm P.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus fm hPm, P.coheight_genericPoint]
  let Q := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hz
  have hQ : Q.genericPoint = fm P.genericPoint :=
    AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne _ hz
  have hQp : Q.genericPoint ∈ biregularLocus fp :=
    MMP.Positivity.mem_biregularLocus_of_coheight_le_one fp
      hD.isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective
      hD.isSmallMorphism_plus.two_le_codimension (by rw [hQ, hz])
  have hsurj : Function.Surjective fp := by
    refine Set.range_eq_univ.1 ?_
    rw [← fp.isClosedMap.isClosed_range.closure_eq, fp.denseRange.closure_eq]
  obtain ⟨x, hx⟩ := hsurj Q.genericPoint
  have hxc : Order.coheight x = 1 := by
    rw [← MMP.Positivity.coheight_map_of_mem_biregularLocus fp (hx ▸ hQp), hx, hQ, hz]
  let P' := AlgebraicGeometry.PrimeDivisor.ofCoheightOne _ hxc
  have hP' : fp P'.genericPoint = Q.genericPoint := by
    rw [AlgebraicGeometry.PrimeDivisor.genericPoint_ofCoheightOne]
    exact hx
  refine ⟨P', ?_, ?_⟩
  · unfold flipTransformPrimeDivisor
    rw [(MMP.Positivity.transformPrimeDivisor_toRationalMap_eq_some_iff fm P Q).2 hQ.symm,
      Option.bind_some]
    exact inverseTransformPrimeDivisor_eq_some_of_mem_biregularLocus P' Q hP' hQp
  · let Dm : DivisorOver ℂ sZ := ⟨Xm, fm, hsmall.comp_eq ▸ hsmall.isNormalVariety_source,
      hsmall.isBirationalMorphism, P⟩
    let Dp : DivisorOver ℂ sZ := ⟨Xp, fp,
      hD.isSmallMorphism_plus.comp_eq ▸ hD.isSmallMorphism_plus.isNormalVariety_source,
      hD.isSmallMorphism_plus.isBirationalMorphism, P'⟩
    have h1 := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq
      hD.isNormalVariety_target Dm Q hQ.symm
    have h2 := MMP.Positivity.DivisorOver.valuation_eq_of_map_genericPoint_eq
      hD.isNormalVariety_target Dp Q hP'
    exact h2.trans h1.symm

/-- The bijection of prime divisors: the strict transform `P ↦ P⁺`, with inverse the map
`P ↦ P⁻` of `MMP.Fourfold.IsThreefoldStepDiagram.exists_primeDivisor_valuationOver_eq`. -/
private theorem exists_equiv_primeDivisor
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}
    (hD : IsThreefoldStepDiagram sXm sZ sXp K B fm fp) (hsmall : IsSmallMorphism sXm sZ fm) :
    haveI := hD.isNormalVariety_target.1.toIsIntegral
    haveI := hD.isBirationalMorphism_minus.isDominant
    haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
    ∃ e : MMP.Mori.PrimeDivisor Xm ≃ MMP.Mori.PrimeDivisor Xp, ∀ P : MMP.Mori.PrimeDivisor Xm,
      flipTransformPrimeDivisor fm fp P = some (e P) ∧
      (e P).divisorialValuation.comap (functionFieldMap fp) =
        P.divisorialValuation.comap (functionFieldMap fm) ∧
      (flipTransform fm fp B).coeff (e P) = B.coeff P := by
  haveI := hD.isNormalVariety_target.1.toIsIntegral
  haveI := hD.isBirationalMorphism_minus.isDominant
  haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
  choose ψ hψt hψv using exists_flipTransformPrimeDivisor_eq_some hD hsmall
  have injm : ∀ P₁ P₂ : MMP.Mori.PrimeDivisor Xm,
      P₁.valuationOver fm = P₂.valuationOver fm → P₁ = P₂ := fun _ _ h =>
    eq_of_divisorialValuation_eq hD.isNormalVariety_minus
      (valuation_eq_of_comap_eq hD.isBirationalMorphism_minus.functionFieldMap_bijective h)
  have injp : ∀ P₁ P₂ : MMP.Mori.PrimeDivisor Xp,
      P₁.valuationOver fp = P₂.valuationOver fp → P₁ = P₂ := fun _ _ h =>
    eq_of_divisorialValuation_eq hD.isNormalVariety_plus
      (valuation_eq_of_comap_eq
        hD.isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective h)
  have hinj : Function.Injective ψ := fun P₁ P₂ h =>
    injm _ _ (by rw [← hψv, ← hψv, h])
  have hsurj : Function.Surjective ψ := fun P' => by
    obtain ⟨Pm, -, hv, -⟩ := hD.exists_primeDivisor_valuationOver_eq P'
    exact ⟨Pm, injp _ _ (by rw [hψv, hv])⟩
  refine ⟨Equiv.ofBijective ψ ⟨hinj, hsurj⟩, fun P => ⟨hψt P, hψv P, ?_⟩⟩
  obtain ⟨Pm, -, hv, -, -, -, hc, -⟩ := hD.exists_primeDivisor_valuationOver_eq (ψ P)
  have hPm : Pm = P := injm _ _ (by rw [hv, hψv])
  change (flipTransform fm fp B).coeff (ψ P) = _
  rw [hc, hPm]

/-- Proper divisors over `X` and `X'` whose valuations agree on `ℂ(Z)` have centres of
codimension `≥ 2` simultaneously, given a bijection of prime divisors matching their
valuations on `ℂ(Z)`: by `MMP.Positivity.DivisorOver.two_le_codimension_center_iff` both
conditions say the valuation is the valuation of no prime divisor. -/
private theorem two_le_codimension_center_iff_of_comap_eq {X X' Z : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] [IsIntegral X'] [IsLocallyNoetherian X'] [IsNormal X']
    [IsIntegral Z] {sX : X ⟶ Spec (.of ℂ)} {sX' : X' ⟶ Spec (.of ℂ)}
    (hX : IsNormalVariety ℂ sX) (hX' : IsNormalVariety ℂ sX') (g : X ⟶ Z) (g' : X' ⟶ Z)
    [IsDominant g] [IsDominant g'] (hg : Function.Bijective (functionFieldMap g))
    (hg' : Function.Bijective (functionFieldMap g'))
    (e : MMP.Mori.PrimeDivisor X ≃ MMP.Mori.PrimeDivisor X')
    (he : ∀ P, (e P).divisorialValuation.comap (functionFieldMap g') =
      P.divisorialValuation.comap (functionFieldMap g))
    (D : DivisorOver ℂ sX) (D' : DivisorOver ℂ sX')
    (h : D'.valuation.comap (functionFieldMap g') = D.valuation.comap (functionFieldMap g)) :
    2 ≤ codimension D.center ↔ 2 ≤ codimension D'.center := by
  rw [MMP.Positivity.DivisorOver.two_le_codimension_center_iff hX,
    MMP.Positivity.DivisorOver.two_le_codimension_center_iff hX']
  simp only [valuation_ofPrimeDivisor]
  constructor
  · intro H P' hP'
    refine H (e.symm P') (valuation_eq_of_comap_eq hg ?_)
    rw [← h, hP', ← he, e.apply_symm_apply]
  · intro H P hP
    refine H (e P) (valuation_eq_of_comap_eq hg' ?_)
    rw [h, hP, he]

/-- In a threefold step diagram `X⁻ → Z ← X⁺` with `f⁻` small, a normalized divisorial valuation
`ξ` of `ℂ(X⁻)` is exceptional over `X⁻` iff the corresponding valuation `ξ⁺` of `ℂ(X⁺)` is
exceptional over `X⁺`; and the strict transform is an equivalence `e` between prime divisors of
`X⁻` and of `X⁺`, under which `ord_P` corresponds to `ord_{e P}` and
`coeff_{e P} B⁺ = coeff_P B⁻`. -/
@[mmp "lem_mmp_indexc_small_same_exceptional"]
public theorem IsThreefoldStepDiagram.isExceptionalValuation_iff_of_isSmallMorphism
    {sXm : Xm ⟶ Spec (.of ℂ)} {sZ : Z ⟶ Spec (.of ℂ)} {sXp : Xp ⟶ Spec (.of ℂ)}
    {K : Divisor Xm} {B : QDivisor Xm} {fm : Xm ⟶ Z} {fp : Xp ⟶ Z}
    (hD : IsThreefoldStepDiagram sXm sZ sXp K B fm fp) (hsmall : IsSmallMorphism sXm sZ fm) :
    haveI := hD.isNormalVariety_target.1.toIsIntegral
    haveI := hD.isBirationalMorphism_minus.isDominant
    haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
    (∀ (ξ : Valuation Xm.functionField (WithZero (Multiplicative ℤ)))
        (ξp : Valuation Xp.functionField (WithZero (Multiplicative ℤ))),
        MMP.Intersection.IsNormalizedDivisorialValuation ℂ sXm ξ →
        ξp.comap (functionFieldMap fp) = ξ.comap (functionFieldMap fm) →
        (MMP.Intersection.IsExceptionalValuation ℂ sXm ξ ↔
          MMP.Intersection.IsExceptionalValuation ℂ sXp ξp)) ∧
    ∃ e : MMP.Mori.PrimeDivisor Xm ≃ MMP.Mori.PrimeDivisor Xp, ∀ P : MMP.Mori.PrimeDivisor Xm,
      flipTransformPrimeDivisor fm fp P = some (e P) ∧
      (e P).divisorialValuation.comap (functionFieldMap fp) =
        P.divisorialValuation.comap (functionFieldMap fm) ∧
      (flipTransform fm fp B).coeff (e P) = B.coeff P := by
  haveI := hD.isNormalVariety_target.1.toIsIntegral
  haveI := hD.isBirationalMorphism_minus.isDominant
  haveI := hD.isSmallMorphism_plus.isBirationalMorphism.isDominant
  obtain ⟨e, he⟩ := exists_equiv_primeDivisor hD hsmall
  refine ⟨fun ξ ξp hξ hcomp => ?_, e, he⟩
  obtain ⟨D, hDp, rfl⟩ := hξ
  haveI := hD.isSmallMorphism_plus.isProper
  obtain ⟨D', hD'p, rfl⟩ := exists_properDivisorOver_valuation_eq_of_comap_eq
    hD.isNormalVariety_plus fm fp hD.isBirationalMorphism_minus
    hD.isSmallMorphism_plus.isBirationalMorphism hD.comp_eq_minus hD.comp_eq_plus D ξp hcomp
  rw [isExceptionalValuation_valuation_iff hD.isNormalVariety_minus.1 D hDp,
    isExceptionalValuation_valuation_iff hD.isNormalVariety_plus.1 D' hD'p]
  exact two_le_codimension_center_iff_of_comap_eq hD.isNormalVariety_minus
    hD.isNormalVariety_plus fm fp hD.isBirationalMorphism_minus.functionFieldMap_bijective
    hD.isSmallMorphism_plus.isBirationalMorphism.functionFieldMap_bijective e
    (fun P => (he P).2.1) D D' hcomp

end MMP.Fourfold

end

/-! ### The next downstairs pair traced on a crepant junction -/

section

open CategoryTheory AlgebraicGeometry TopologicalSpace

open MMP.Mori

attribute [-instance] AlgebraicGeometry.IsVariety.toIsIntegral

namespace MMP.Fourfold.StabilizedTail

variable {T : StabilizedTail} {i : ℕ}

/-- If `f⁻¹_* Q = P`, then `f(η_P) = η_Q`: the generic point of `P` lies over the biregular
locus, where `f` preserves coheights. -/
private theorem map_genericPoint_eq_of_inverseTransformPrimeDivisor_eq_some {X Y : Scheme.{u}}
    {f : X ⟶ Y} {P : MMP.Mori.PrimeDivisor X} {Q : MMP.Mori.PrimeDivisor Y}
    (h : inverseTransformPrimeDivisor f Q = some P) : f P.genericPoint = Q.genericPoint := by
  have hs := support_inverseTransformPrimeDivisor h
  have hS : (f ⁻¹' ((Q.support : Set Y) ∩ biregularLocus f)).Nonempty := by
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    have hP : P.genericPoint ∈ (P.support : Set X) :=
      MMP.Flips.primeDivisor_genericPoint_mem_support P
    rw [hs] at hP
    change P.genericPoint ∈ closure (f ⁻¹' ((Q.support : Set Y) ∩ biregularLocus f)) at hP
    rw [hne, closure_empty] at hP
    exact hP
  obtain ⟨z, hzQ, hzV⟩ := hS
  have hzP : z ∈ (P.support : Set X) := by
    rw [hs]
    exact preimage_subset_inverseTransform f _ ⟨hzQ, hzV⟩
  rw [AlgebraicGeometry.PrimeDivisor.support_eq_closure, ← specializes_iff_mem_closure] at hzP
  have hηV : P.genericPoint ∈ (f ⁻¹ᵁ biregularLocus f : Set X) :=
    hzP.mem_open (f ⁻¹ᵁ biregularLocus f).isOpen hzV
  have hcoh : Order.coheight (f P.genericPoint) = 1 := by
    rw [MMP.Positivity.coheight_map_of_mem_biregularLocus f hηV, P.coheight_genericPoint]
  exact Q.eq_genericPoint_of_mem_support
    (map_genericPoint_mem_of_inverseTransformPrimeDivisor_eq_some h) hcoh

/-- The log discrepancy of `ord_Q` for a prime divisor `Q` of `X`, computed on the identity model:
`a(ord_Q; X, B) = 1 - coeff_Q B`. -/
private theorem isValuationLogDiscrepancy_divisorialValuation {X : Scheme.{0}} [IsIntegral X]
    [IsLocallyNoetherian X] [IsNormal X] {sX : X ⟶ Spec (.of ℂ)} {B : QDivisor X}
    (hB : MMP.Mori.IsPair sX B) (Q : MMP.Mori.PrimeDivisor X) :
    IsValuationLogDiscrepancy sX B Q.divisorialValuation (1 - (B.coeff Q : ℝ)) := by
  obtain ⟨hX, n, K, hK, -⟩ := id hB
  obtain ⟨a, ha⟩ := MMP.Positivity.IsPair.exists_isDiscrepancy hB hK
    (DivisorOver.ofPrimeDivisor ℂ hX Q)
  have h1 := ha.eq_neg_coeff_of_ofPrimeDivisor hX
  have hp : IsProper (DivisorOver.ofPrimeDivisor ℂ hX Q).f := (inferInstance : IsProper (𝟙 X))
  refine ⟨n, DivisorOver.ofPrimeDivisor ℂ hX Q, hp, valuation_ofPrimeDivisor hX Q, ?_⟩
  · have h2 := MMP.Threefold.Bridges.isLogDiscrepancy_one_add_of_isDiscrepancy ha hp
    rw [h1] at h2
    convert h2 using 1
    push_cast
    ring

/-- The coefficient of `E_t` in `∑_s c_s E_s`, for an injective family `E` of prime divisors,
is `c_t`. -/
private theorem sum_single_apply_self {Y : Scheme.{u}} {ι : Type*} [Fintype ι]
    {E : ι → MMP.Mori.PrimeDivisor Y} (hE : Function.Injective E) (c : ι → ℚ) (t : ι) :
    (∑ s, Finsupp.single (E s) (c s) : QDivisor Y) (E t) = c t := by
  classical
  rw [Finsupp.finset_sum_apply, Finset.sum_eq_single t]
  · simp
  · intro b _ hb
    rw [Finsupp.single_apply, if_neg (fun h => hb (hE h))]
  · simp

/-- The coefficient in `∑_s c_s E_s` of a prime divisor off the range of `E` is `0`. -/
private theorem sum_single_apply_of_notMem_range {Y : Scheme.{u}} {ι : Type*} [Fintype ι]
    {E : ι → MMP.Mori.PrimeDivisor Y} (c : ι → ℚ) {P : MMP.Mori.PrimeDivisor Y}
    (hP : P ∉ Set.range E) : (∑ s, Finsupp.single (E s) (c s) : QDivisor Y) P = 0 := by
  classical
  rw [Finsupp.finset_sum_apply]
  refine Finset.sum_eq_zero fun t _ => ?_
  rw [Finsupp.single_apply, if_neg (fun h' => hP ⟨t, h'⟩)]

/-- The coefficient of `P` in the linear extension of a partial map `φ` on prime divisors
vanishes when no prime divisor is sent to `P`. -/
private theorem mapPrimeDivisors_apply_eq_zero {X Y : Scheme.{u}} {R : Type*} [AddCommMonoid R]
    {φ : MMP.Mori.PrimeDivisor X → Option (MMP.Mori.PrimeDivisor Y)}
    {P : MMP.Mori.PrimeDivisor Y} (D : DivisorWithCoeffs R X) (h : ∀ E, φ E ≠ some P) :
    DivisorWithCoeffs.mapPrimeDivisors φ D P = 0 := by
  classical
  rw [DivisorWithCoeffs.mapPrimeDivisors, Finsupp.liftAddHom_apply, Finsupp.sum_apply]
  refine Finset.sum_eq_zero fun E _ => ?_
  rcases hφ : φ E with _ | Q
  · simp [hφ]
  · have hQ : Q ≠ P := fun hQ => h E (hφ.trans (congrArg some hQ))
    simp [hφ, Finsupp.single_apply, hQ]

/-- No prime divisor of `X_i` has strict transform the exceptional divisor `E_s` of a crepant
junction: its centre would be the generic point of a prime divisor, while `s` is an exceptional
valuation, whose centre has codimension at least two. -/
private theorem inverseTransformDivisor_apply_E_eq_zero
    {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (J : CrepantJunction (T.sX i) (T.B i) I) (s : I) :
    inverseTransformDivisor J.p (T.B i) (J.E s) = 0 := by
  refine mapPrimeDivisors_apply_eq_zero _ fun Q' hQ' => ?_
  obtain ⟨D', -, hsD', h2⟩ := (J.subset_lowDiscrepancySet (Finset.mem_coe.mpr s.2)).1
  let DE : DivisorOver ℂ (T.sX i) :=
    ⟨J.Y, J.p, J.isQFactorial.1, J.isBirationalMorphism, J.E s⟩
  have hv : DE.valuation = D'.valuation := (J.valuation_eq s).trans hsD'
  rw [MMP.Positivity.DivisorOver.codimension_center,
    ← MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq J.isKltPair.1.isPair.1.1 hv]
    at h2
  change 2 ≤ Order.coheight (J.p (J.E s).genericPoint) at h2
  rw [map_genericPoint_eq_of_inverseTransformPrimeDivisor_eq_some hQ', Q'.coheight_genericPoint]
    at h2
  exact absurd h2 (by decide)

/-- For a crepant junction `J = (p_i, Θ_i)` of `(X_i, B_i)` extracting `I(X_i, B_i)` and its
decreased boundary `Θ'`, every prime divisor `P` of `Y_i` gives a valuation `s'` of `k(X_{i+1})`
corresponding to `ord_P` with `a(s'; X_{i+1}, B_{i+1}) = 1 - coeff_P Θ'`; if `P` is not
`p_i`-exceptional, `s' = ord_Q` for a prime divisor `Q` of `X_{i+1}`. -/
@[mmp "lem_mmp_indexc_bridge_trace"]
public theorem IsDecreasedBoundary.isValuationLogDiscrepancy_one_sub_coeff
    {I : Finset (Valuation (T.X i).functionField (WithZero (Multiplicative ℤ)))}
    (hI : (I : Set _) = lowDiscrepancySet (T.sX i) (T.B i))
    {J : CrepantJunction (T.sX i) (T.B i) I} {Θ' : QDivisor J.Y}
    (hΘ' : IsDecreasedBoundary J Θ') (P : MMP.Mori.PrimeDivisor J.Y) :
    haveI := J.isBirationalMorphism.isDominant
    ∃ s' : Valuation (T.X (i + 1)).functionField (WithZero (Multiplicative ℤ)),
      T.IsTransportedValuation i (P.valuationOver J.p) s' ∧
      IsValuationLogDiscrepancy (T.sX (i + 1)) (T.B (i + 1)) s' (1 - (Θ'.coeff P : ℝ)) ∧
      (¬ RationalMap.IsExceptional (X := J.Y) J.p.toRationalMap P →
        ∃ Q : MMP.Mori.PrimeDivisor (T.X (i + 1)), Q.divisorialValuation = s') := by
  have hdom := J.isBirationalMorphism.isDominant
  have hprop : IsProper J.p := isProper_of_isProjectiveMorphism J.p J.isProjectiveMorphism
  have hX : IsNormalVariety ℂ (T.sX i) := J.isKltPair.1.isPair.1
  obtain ⟨a, ha, hΘ⟩ := hΘ'
  have hcoeff : Θ'.coeff P = inverseTransformDivisor J.p (T.B i) P +
      (∑ s : I, Finsupp.single (J.E s) (1 - a s) : QDivisor J.Y) P := by
    rw [hΘ]
    rfl
  by_cases hP : RationalMap.IsExceptional (X := J.Y) J.p.toRationalMap P
  · obtain ⟨s, rfl⟩ := (J.isExceptional_iff P).mp hP
    obtain ⟨s', hs', hlog⟩ := ha s
    refine ⟨s', ?_, ?_, fun h => absurd hP h⟩
    · rwa [show (J.E s).valuationOver J.p = s from J.valuation_eq s]
    · rw [hcoeff, inverseTransformDivisor_apply_E_eq_zero,
        sum_single_apply_self J.injective (fun s => 1 - a s) s]
      convert hlog using 1
      push_cast
      ring
  · let DP : DivisorOver ℂ (T.sX i) := ⟨J.Y, J.p, J.isQFactorial.1, J.isBirationalMorphism, P⟩
    have hPe : ¬ DP.IsExceptional := hP
    obtain ⟨P', hv⟩ :=
      MMP.Threefold.Mori.exists_primeDivisor_valuation_eq_of_not_isExceptional hX DP hPe
    have hη : J.p P.genericPoint = P'.genericPoint :=
      MMP.Positivity.DivisorOver.map_genericPoint_eq_of_valuation_eq hX.1 hv
    have hv' : P.valuationOver J.p = P'.divisorialValuation :=
      hv.trans (valuation_ofPrimeDivisor hX P')
    have hreg := mem_biregularLocus_of_coheight_eq_one J.p J.isBirationalMorphism
      P'.coheight_genericPoint
    have hinv : inverseTransformDivisor J.p (T.B i) P = T.B i P' :=
      inverseTransformDivisor_apply_eq J.p P P' hη hreg _
    have hnot : P ∉ Set.range J.E := fun h => hP ((J.isExceptional_iff P).mpr h)
    obtain ⟨-, e, he⟩ :=
      MMP.Fourfold.IsThreefoldStepDiagram.isExceptionalValuation_iff_of_isSmallMorphism
        (T.isThreefoldStepDiagram i) (T.isSmallMorphism i)
    obtain ⟨-, hcomap, hBc⟩ := he P'
    refine ⟨(e P').divisorialValuation, ?_, ?_, fun _ => ⟨e P', rfl⟩⟩
    · unfold StabilizedTail.IsTransportedValuation
      rwa [hv']
    · have hc : Θ'.coeff P = (T.B (i + 1)).coeff (e P') := by
        rw [hcoeff, hinv, sum_single_apply_of_notMem_range _ hnot, add_zero, T.B_eq i]
        exact hBc.symm
      rw [hc]
      exact isValuationLogDiscrepancy_divisorialValuation (T.isKltPair (i + 1)).1.isPair (e P')

end MMP.Fourfold.StabilizedTail

end

