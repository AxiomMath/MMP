/-!
# Cones, blow-ups and regular embeddings (Fulton B.5–B.7; Lazarsfeld)

This file defines cones, projective cones, blow-ups and regular embeddings of schemes, as used in
intersection theory.

## Implementation notes

A graded sheaf of `𝒪_X`-algebras `S^• = ⨁_{i ≥ 0} S^i` is the Stacks project's
`Stacks.RelativeProj.Situation`: a sheaf of graded `𝒪_X`-algebras (`SheafOfModules.GradedAlgebra`,
Stacks 0FQW) which is commutative, vanishes in negative degrees and has quasi-coherent pieces.
For it,

* the *cone* `C = Spec(S^•)` is the relative spectrum (Stacks 01LX) of the ungraded algebra sheaf
  `⨁ S^i` (`Stacks.RelativeSpec.gradedAlgebraSheaf`);
* the *projective cone* `ℙ(C) = Proj(S^•)` is its relative `Proj` (Stacks 01NQ), with the
  twisting sheaf `𝒪(1)`;
* Fulton's conditions on `S^•` (`𝒪_X ≅ S^0`, `S^1` coherent, `S^•` locally generated by `S^1`)
  are the predicate `MMP.Intersection.Scheme.IsConeAlgebra`.

Line bundles are recorded by their sheaves of sections, as in
`MMP.Foundations.Intersection.Bundles`: `𝒪(n) = 𝒪(1)^{⊗n}` is
`MMP.Intersection.Scheme.Modules.tensorZPow`.

The blow-up `Bl_I X = Proj(⨁ Iⁿ)` is the Stacks project's `AlgebraicGeometry.blowUp`, which is
*by definition* the projective cone of the Rees algebra `AlgebraicGeometry.reesSituation I`
(`MMP.Intersection.Scheme.blowUp_eq_projectiveCone`); its `𝒪(1)` is
`AlgebraicGeometry.blowUpTwist I 1`, and its exceptional divisor is the inverse image `π⁻¹(Z)`
(`AlgebraicGeometry.exceptionalDivisor`).

Closed subschemes are Mathlib's `Scheme.IdealSheafData`; the inverse image scheme `f⁻¹(Z)` is
`IdealSheafData.comap`, identified with the fibre product by `IdealSheafData.comapIso`, and on
affine opens its ideal is generated by the image of the ideal of `Z`
(`Stacks.IdealSheaf.ideal_comap_appLE`).

## Main definitions

All declarations of this file are in the namespace `MMP.Intersection.Scheme`; dot notation on a
scheme, an ideal sheaf or a morphism does not reach them (write
`Scheme.Hom.IsRegularEmbedding i d`).

* `MMP.Intersection.Scheme.IsConeAlgebra`, `MMP.Intersection.Scheme.cone`,
  `MMP.Intersection.Scheme.coneToBase`, `MMP.Intersection.Scheme.IsCone`.
* `MMP.Intersection.Scheme.projectiveCone`, `MMP.Intersection.Scheme.projectiveConeToBase`,
  `MMP.Intersection.Scheme.projectiveConeTwistOne`, `MMP.Intersection.Scheme.projectiveConeTwist`.
* `MMP.Intersection.Scheme.blowUpPoint`, `MMP.Intersection.Scheme.IdealSheafData.complement`.
* `MMP.Intersection.Scheme.Hom.IsRegularEmbedding`, `MMP.Intersection.Scheme.Hom.IsLCIEmbedding`,
  `MMP.Intersection.Scheme.Hom.normalSheaf`.
-/

@[expose] public noncomputable section

universe u

open CategoryTheory Limits TopologicalSpace Opposite AlgebraicGeometry

namespace MMP.Intersection.Scheme

open Stacks.RelativeProj

/-! ### Cones -/

/-- *Fulton's conditions on a graded `𝒪_X`-algebra* `S^• = ⨁_{i ≥ 0} S^i` (Fulton B.5.1): the
canonical map `𝒪_X → S^0`, `r ↦ r · 1`, is an isomorphism (it is bijective on the sections over
every open), `S^1` is a coherent `𝒪_X`-module, and `S^•` is locally generated as an
`𝒪_X`-algebra by `S^1`: every point has an affine open neighbourhood over which every section
of degree `1 + n` is a sum of products of sections of degree `1` and `n`. -/
@[mmp "def_b_cone"]
structure IsConeAlgebra (s : Situation.{u}) : Prop where
  /-- The map `𝒪_X(U) → S^0(U)`, `r ↦ r · 1`, is bijective for every open `U`. -/
  bijective_smul_one : ∀ U : s.base.Opens,
    Function.Bijective (fun r : s.base.ringCatSheaf.obj.obj (op U) ↦
      r • s.algebra.one.eval (op U))
  /-- The degree-one piece `S^1` is a coherent `𝒪_X`-module. -/
  isCoherent_one : Stacks.SheafOfModules.IsCoherent (s.algebra.piece 1)
  /-- Every point has an affine open neighbourhood over which `S^•` is generated in degree one. -/
  locally_generatedInDegreeOne : ∀ x : s.base, ∃ U : s.base.Opens, x ∈ U ∧ IsAffineOpen U ∧
    s.algebra.IsGeneratedInDegreeOne (op U)

/-- The ungraded `𝒪_X`-algebra `⨁ S^i` of a graded algebra is quasi-coherent. -/
instance isQuasicoherent_gradedAlgebraSheaf (s : Situation.{u}) :
    Stacks.RelativeSpec.AlgebraSheaf.IsQuasicoherent
      (Stacks.RelativeSpec.gradedAlgebraSheaf s.base s.algebra s.mul_comm) :=
  Stacks.RelativeSpec.isQuasicoherent_gradedAlgebraSheaf_of_piece s.base s.algebra s.mul_comm
    s.isQuasicoherent

/-- The *cone* `C = Spec(S^•)` of a graded `𝒪_X`-algebra `S^•` (Fulton B.5.1): the relative
spectrum of the quasi-coherent `𝒪_X`-algebra `⨁ S^i`. Fulton's conditions on `S^•` are
`IsConeAlgebra`; the construction makes sense without them. -/
@[mmp "def_b_cone"]
def cone (s : Situation.{u}) : Scheme.{u} :=
  Stacks.AffineAlgebraEquivalence.relativeSpec
    (Stacks.RelativeSpec.gradedAlgebraSheaf s.base s.algebra s.mul_comm)

/-- The projection `π : C ⟶ X` of a cone. -/
@[mmp "def_b_cone"]
def coneToBase (s : Situation.{u}) : cone s ⟶ s.base :=
  Stacks.AffineAlgebraEquivalence.relativeSpecToBase
    (Stacks.RelativeSpec.gradedAlgebraSheaf s.base s.algebra s.mul_comm)

/-- `p : C ⟶ X` is a *cone over `X`* (Fulton B.5.1): it is isomorphic over `X` to the
projection `Spec(S^•) ⟶ X` of the cone of a graded `𝒪_X`-algebra satisfying Fulton's
conditions. -/
@[mmp "def_b_cone"]
def IsCone {X C : Scheme.{u}} (p : C ⟶ X) : Prop :=
  ∃ (s : Situation.{u}) (e : s.base ≅ X), IsConeAlgebra s ∧
    Nonempty (Over.mk p ≅ Over.mk (coneToBase s ≫ e.hom))

/-! ### Projective cones -/

/-- The *projective cone* `ℙ(C) = Proj(S^•)` of the cone `C = Spec(S^•)` (Fulton B.5.1): the
relative `Proj` of `S^•`. -/
abbrev projectiveCone (s : Situation.{u}) : Scheme.{u} :=
  s.relativeProj

/-- The projection `p : ℙ(C) ⟶ X` of a projective cone. -/
abbrev projectiveConeToBase (s : Situation.{u}) : projectiveCone s ⟶ s.base :=
  s.relativeProjToBase

/-- The canonical sheaf `𝒪_{Proj S^•}(1)` on `ℙ(C) = Proj(S^•)` (Fulton B.5.1), glued from the
twisting sheaves `S(1)^∼` of the charts `Proj Γ(U, S^•)`. It is the sheaf of sections of the line
bundle `𝒪_C(1)`. -/
@[mmp "def_b_tautological_line_bundle_cone"]
abbrev projectiveConeTwistOne (s : Situation.{u}) : (projectiveCone s).Modules :=
  Situation.twistSheaf s 1

/-- `𝒪_C(n) = 𝒪_C(1)^{⊗n}` for `n : ℤ` (Fulton B.5.1), as a sheaf of sections. -/
@[mmp "def_b_tautological_line_bundle_cone"]
abbrev projectiveConeTwist (s : Situation.{u}) (n : ℤ) : (projectiveCone s).Modules :=
  Modules.tensorZPow (projectiveConeTwistOne s) n

/-! ### Blow-ups -/

/-- The blow-up `Bl_I X = Proj(⨁_{n ≥ 0} Iⁿ)` is the projective cone of the Rees algebra of `I`,
by definition. -/
@[mmp "def_b_blowup", mmp "def_pab_blowup_along_ideal"]
theorem blowUp_eq_projectiveCone {X : Scheme.{u}} (I : X.IdealSheafData) :
    blowUp I = projectiveCone (reesSituation I) :=
  rfl

/-- The twisting sheaf `𝒪(1)` of the blow-up `Bl_I X` is the sheaf `𝒪(1)` of the projective
cone of the Rees algebra of `I`, by definition. -/
@[mmp "def_b_blowup"]
theorem blowUpTwist_one_eq {X : Scheme.{u}} (I : X.IdealSheafData) :
    blowUpTwist I 1 = projectiveConeTwistOne (reesSituation I) :=
  rfl

/-- The blow-up `Bl_x X = Bl_{𝔪_x} X` of `X` at a closed point `x` (Lazarsfeld Def. 5.4.1): the
blow-up along the ideal sheaf of the reduced point `x`. -/
@[mmp "def_pab_blowup_along_ideal"]
abbrev blowUpPoint {X : Scheme.{u}} (x : X) (hx : IsClosed ({x} : Set X)) : Scheme.{u} :=
  blowUp (Scheme.IdealSheafData.vanishingIdeal ⟨{x}, hx⟩)

/-! ### Complements of closed subschemes -/

/-- `X − Y` (Fulton B.1.1): the open subscheme of `X` whose underlying set is the complement of
the support of the closed subscheme `Y` with ideal sheaf `I`. -/
@[mmp "not_b_complement_of_subscheme"]
abbrev IdealSheafData.complement {X : Scheme.{u}} (I : X.IdealSheafData) : X.Opens :=
  I.support.compl

/-! ### Regular embeddings and normal sheaves -/

/-- A closed immersion `i : Z ⟶ X` is a *regular embedding of codimension `d`* (Fulton B.7.1):
every point of `Z` has an affine open neighbourhood `V` in `X` such that the ideal of `Z ∩ V` in
`A(V)` is generated by a regular sequence of length `d`. -/
@[mmp "def_b_regular_embedding"]
def Hom.IsRegularEmbedding {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (d : ℕ) :
    Prop :=
  ∀ z : Z, ∃ V : X.affineOpens, i z ∈ (V : X.Opens) ∧
    ∃ f : List Γ(X, V), f.length = d ∧ RingTheory.Sequence.IsRegular Γ(X, V) f ∧
      i.ker.ideal V = Ideal.ofList f

/-- A closed embedding `i : W ⟶ V` is a *regular embedding of codimension `e`* in Lazarsfeld's
sense (Prop. 8.1.6(ii)): every point of `W` has an affine open neighbourhood `U ⊆ V` in which the
ideal of `W ∩ U` is generated by `e` elements `f₁, …, f_e` of `𝒪_V(U)`, each a non-zero-divisor
on `𝒪_V(U)/(f₁, …, f_{i-1})`. -/
@[mmp "def_pab_regular_embedding"]
def Hom.IsLCIEmbedding {W V : Scheme.{u}} (i : W ⟶ V) [IsClosedImmersion i] (e : ℕ) : Prop :=
  ∀ w : W, ∃ U : V.affineOpens, i w ∈ (U : V.Opens) ∧
    ∃ f : List Γ(V, U), f.length = e ∧ RingTheory.Sequence.IsWeaklyRegular Γ(V, U) f ∧
      i.ker.ideal U = Ideal.ofList f

/-- The *normal sheaf* `N_{W/V} = 𝓗om_{𝒪_W}(ℐ/ℐ², 𝒪_W)` of a closed subscheme `i : W ⟶ V`
(Lazarsfeld §6.3.A): the dual of the conormal sheaf `ℐ/ℐ² = i^*ℐ`
(`Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf`). When `i` is a regular embedding
it is the *normal bundle*. -/
@[mmp "def_pab_normal_bundle"]
def Hom.normalSheaf {W V : Scheme.{u}} (i : W ⟶ V) [IsClosedImmersion i] : W.Modules :=
  Stacks.AlgebraicGeometry.ReflexiveModules.dualSheaf
    (Stacks.AlgebraicGeometry.RegularIdealSheaf.conormalSheaf i)

end MMP.Intersection.Scheme
