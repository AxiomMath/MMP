module

public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.AlgebraicChart
public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.ClassicalTopologyAffine
public import StacksFrontier.RingTheory.NodalChart.Regularity
public import MMP.RingTheory.RegularLocalRing.SpanMaximalIdeal
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# Differentials of regular functions in algebraic charts

Let `X` be a scheme over `𝕜 = ℝ` or `ℂ`, `V ⊆ X` an affine open with ring `A = Γ(X, V)`, and `e`
an algebraic chart of `X(𝕜)` with values in `𝕜ⁿ` (`MMP.UnderlyingSpace.IsAlgebraicChart`) whose
source contains a point `p ∈ V(𝕜)`. Reading a regular function `a ∈ A` through `e` and
differentiating at `e(p)` gives a `𝕜`-linear form `d_p a` on `𝕜ⁿ`, and `a ↦ d_p a` is a derivation
at `p`: `d_p (a b) = a(p) d_p b + b(p) d_p a`, vanishing on constants.

The coordinates of `e` are, near `p`, linear in finitely many regular functions, so the forms
`d_p a` span the dual of `𝕜ⁿ`. If the maximal ideal of the local ring `𝒪_{X,p}` is generated by
`n` germs, those generators may be taken in `A`, and their differentials, which span the dual
since `d_p a = d_p (a - a(p))`, are then a basis of it. Writing an element `a` of the maximal
ideal in terms of the generators, `w a = ∑ cᵢ bᵢ` with `w(p) ≠ 0`, gives
`w(p) d_p a = ∑ cᵢ(p) d_p bᵢ`; so if `d_p a = 0` all `cᵢ(p)` vanish and the germ of `a` lies in
`𝔪²`. This identifies `𝔪/𝔪²` with the dual of `𝕜ⁿ` at a regular point of dimension `n`.

## Main definitions

* `MMP.UnderlyingSpace.constSection`: the section of `𝒪_X` over `V` with constant value `c ∈ 𝕜`.
* `MMP.UnderlyingSpace.chartDeriv`: the differential `d_p a` of a regular function `a` at `p`,
  read in a chart `e`.

## Main results

* `MMP.UnderlyingSpace.chartDeriv_mul`: the Leibniz rule.
* `MMP.UnderlyingSpace.span_chartDeriv_eq_top`: the differentials of the sections over an
  affine open span the dual of the model space.
* `MMP.UnderlyingSpace.germ_mem_maximalIdeal_sq_of_chartDeriv_eq_zero`: if the maximal ideal of
  `𝒪_{X,p}` is generated by `n` elements and `e` takes values in `𝕜ⁿ`, a regular function
  vanishing at `p` with zero differential has germ in `𝔪²`.
* `MMP.UnderlyingSpace.chartDeriv_ne_zero_of_isRegularLocalRing_quotient`: at a regular point of
  dimension `n`, a local equation `a` with `𝒪_{X,p}/(a)` regular has non-zero differential.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Topology IsLocalRing
open scoped ContDiff

universe u

namespace MMP

section Localization

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
  [IsLocalization M S]

/-- If `f i = zᵢ.1 / zᵢ.2` in a localization `S` of `R`, the numerators `zᵢ.1` generate the same
ideal of `S` as the `f i`. -/
lemma span_range_algebraMap_eq_of_mk'_eq {ι : Type*} (z : ι → R × M) (f : ι → S)
    (hz : ∀ i, IsLocalization.mk' S (z i).1 (z i).2 = f i) :
    Ideal.span (Set.range fun i ↦ algebraMap R S (z i).1) = Ideal.span (Set.range f) := by
  apply le_antisymm
  · refine Ideal.span_le.2 (Set.range_subset_iff.2 fun i ↦ ?_)
    have : algebraMap R S (z i).1 = f i * algebraMap R S (z i).2 := by
      rw [← hz i, IsLocalization.mk'_spec]
    rw [SetLike.mem_coe, this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · refine Ideal.span_le.2 (Set.range_subset_iff.2 fun i ↦ ?_)
    rw [SetLike.mem_coe, ← hz i, IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- If the image of `c` in a localization `S` of `R` lies in the ideal generated by the images of
`b i`, then `m c = ∑ dᵢ bᵢ` in `R` for some `m ∈ M`. -/
lemma exists_mul_eq_sum_of_algebraMap_mem_span {ι : Type*} [Fintype ι] (b : ι → R) {c : R}
    (hc : algebraMap R S c ∈ Ideal.span (Set.range fun i ↦ algebraMap R S (b i))) :
    ∃ m ∈ M, ∃ d : ι → R, m * c = ∑ i, d i * b i := by
  have hcm : algebraMap R S c ∈ Ideal.map (algebraMap R S) (Ideal.span (Set.range b)) := by
    rwa [Ideal.map_span, ← Set.range_comp]
  obtain ⟨⟨⟨j, hj⟩, ⟨s, hs⟩⟩, hjs⟩ := (IsLocalization.mem_map_algebraMap_iff M S).1 hcm
  simp only at hjs
  rw [← map_mul] at hjs
  obtain ⟨⟨w, hw⟩, hwc⟩ := (IsLocalization.eq_iff_exists M S).1 hjs
  obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.1 hj
  refine ⟨w * s, M.mul_mem hw hs, fun i ↦ w * d i, ?_⟩
  simp only at hwc
  calc w * s * c = w * (c * s) := by ring
    _ = w * j := hwc
    _ = ∑ i, w * d i * b i := by rw [← hd, Finset.mul_sum]; simp only [mul_assoc]

end Localization

namespace UnderlyingSpace

section Eval

variable {K : Type u} [Field K] [TopologicalSpace K] {X : Scheme.{u}} [X.Over (Spec (.of K))]
  {V : X.Opens} {p : UnderlyingSpace K X}

/-- Evaluation at a point `p ∈ V(K)` is multiplicative: `(a b)(p) = a(p) b(p)`. -/
lemma evalExt_mul (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a b : Γ(X, V)) :
    evalExt V (a * b) p = evalExt V a p * evalExt V b p := by
  simp only [evalExt_of_le _ hp, ← evalRingHom_apply, map_mul]

/-- Evaluation at a point `p ∈ V(K)` is additive: `(a + b)(p) = a(p) + b(p)`. -/
lemma evalExt_add (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a b : Γ(X, V)) :
    evalExt V (a + b) p = evalExt V a p + evalExt V b p := by
  simp only [evalExt_of_le _ hp, ← evalRingHom_apply, map_add]

/-- Evaluation at a point `p ∈ V(K)` commutes with subtraction: `(a - b)(p) = a(p) - b(p)`. -/
lemma evalExt_sub (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a b : Γ(X, V)) :
    evalExt V (a - b) p = evalExt V a p - evalExt V b p := by
  simp only [evalExt_of_le _ hp, ← evalRingHom_apply, map_sub]

/-- Evaluation at a point `p ∈ V(K)` commutes with powers: `(aᵏ)(p) = a(p)ᵏ`. -/
lemma evalExt_pow (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a : Γ(X, V)) (k : ℕ) :
    evalExt V (a ^ k) p = evalExt V a p ^ k := by
  simp only [evalExt_of_le _ hp, ← evalRingHom_apply, map_pow]

/-- Evaluation at a point `p ∈ V(K)` commutes with finite sums. -/
lemma evalExt_sum (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) {ι : Type*} (s : Finset ι) (a : ι → Γ(X, V)) :
    evalExt V (∑ i ∈ s, a i) p = ∑ i ∈ s, evalExt V (a i) p := by
  simp only [evalExt_of_le _ hp, ← evalRingHom_apply, map_sum]

variable (V) in
/-- The section of `𝒪_X` over `V` with constant value `c`. -/
def constSection (c : K) : Γ(X, V) :=
  X.presheaf.map (homOfLE le_top).op (structureRingHom K X c)

/-- The constant section with value `c` takes the value `c` at every point `p ∈ V(K)`. -/
lemma evalExt_constSection (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (c : K) :
    evalExt V (constSection V c) p = c := by
  rw [evalExt_of_le _ hp, constSection, eval_restrict]
  exact evalTop_structureRingHom p c

/-- A point `p ∈ V(K)` lies in `D(a)` iff `a(p) ≠ 0`. -/
lemma mem_basicOpen_iff_evalExt_ne_zero (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a : Γ(X, V)) :
    p.toHom (IsLocalRing.closedPoint K) ∈ X.basicOpen a ↔ evalExt V a p ≠ 0 := by
  rw [← top_le_preimage_iff, evalExt_of_le _ hp, top_le_preimage_basicOpen_iff]

/-- The germ of `a ∈ Γ(X, V)` at a point `p ∈ V(K)` lies in the maximal ideal of the local ring
iff `a(p) = 0`. -/
lemma germ_mem_maximalIdeal_iff (hp : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a : Γ(X, V)) :
    X.presheaf.germ V _ ((top_le_preimage_iff p V).1 hp) a ∈
        maximalIdeal (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint K))) ↔
      evalExt V a p = 0 := by
  rw [mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen,
    mem_basicOpen_iff_evalExt_ne_zero hp, not_not]

end Eval

section Deriv

variable {𝕜 : Type u} [RCLike 𝕜] {X : Scheme.{u}} [X.Over (Spec (.of 𝕜))]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- The differential at `p` of a regular function `a ∈ Γ(X, V)`, read in the chart `e`: the
derivative of `k ↦ a(e⁻¹ k)` at `e(p)`. -/
def chartDeriv (e : OpenPartialHomeomorph (UnderlyingSpace 𝕜 X) E) (V : X.Opens)
    (p : UnderlyingSpace 𝕜 X) (a : Γ(X, V)) : E →L[𝕜] 𝕜 :=
  fderiv 𝕜 (fun k ↦ evalExt V a (e.symm k)) (e p)

variable {e : OpenPartialHomeomorph (UnderlyingSpace 𝕜 X) E} {V : X.Opens}
  {p : UnderlyingSpace 𝕜 X}

omit [NormedSpace 𝕜 E] in
/-- If `p ∈ V(𝕜)` lies in the source of `e`, then every point `k` near `e(p)` lies in the target of
`e` and `e⁻¹ k` lies in `V(𝕜)`. -/
lemma eventually_mem_target_and_le (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) :
    ∀ᶠ k in 𝓝 (e p), k ∈ e.target ∧ ⊤ ≤ (e.symm k).toHom ⁻¹ᵁ V := by
  have ho : IsOpen (e.target ∩ e.symm ⁻¹' {q : UnderlyingSpace 𝕜 X | ⊤ ≤ q.toHom ⁻¹ᵁ V}) :=
    e.isOpen_inter_preimage_symm (isOpen_setOf_le_preimage V)
  exact ho.mem_nhds ⟨e.map_source hp, by simpa [e.left_inv hp] using hpV⟩

/-- For an algebraic chart `e` around `p ∈ V(𝕜)`, the function `k ↦ a(e⁻¹ k)` is differentiable at
`e(p)`. -/
lemma differentiableAt_evalExt (he : IsAlgebraicChart e) (hp : p ∈ e.source)
    (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) (a : Γ(X, V)) :
    DifferentiableAt 𝕜 (fun k ↦ evalExt V a (e.symm k)) (e p) :=
  ((he.contDiffOn_evalExt V a).contDiffAt
    (eventually_mem_target_and_le hp hpV)).differentiableAt (by simp)

/-- **Leibniz rule**: `d_p (a b) = a(p) d_p b + b(p) d_p a`. -/
lemma chartDeriv_mul (he : IsAlgebraicChart e) (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    (a b : Γ(X, V)) :
    chartDeriv e V p (a * b) =
      evalExt V a p • chartDeriv e V p b + evalExt V b p • chartDeriv e V p a := by
  have heq : (fun k ↦ evalExt V (a * b) (e.symm k)) =ᶠ[𝓝 (e p)]
      fun k ↦ evalExt V a (e.symm k) * evalExt V b (e.symm k) := by
    filter_upwards [eventually_mem_target_and_le hp hpV] with k hk
    exact evalExt_mul hk.2 a b
  rw [chartDeriv, heq.fderiv_eq, fderiv_fun_mul (differentiableAt_evalExt he hp hpV a)
    (differentiableAt_evalExt he hp hpV b), e.left_inv hp]
  rfl

/-- The differential is additive: `d_p (a + b) = d_p a + d_p b`. -/
lemma chartDeriv_add (he : IsAlgebraicChart e) (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    (a b : Γ(X, V)) :
    chartDeriv e V p (a + b) = chartDeriv e V p a + chartDeriv e V p b := by
  have heq : (fun k ↦ evalExt V (a + b) (e.symm k)) =ᶠ[𝓝 (e p)]
      fun k ↦ evalExt V a (e.symm k) + evalExt V b (e.symm k) := by
    filter_upwards [eventually_mem_target_and_le hp hpV] with k hk
    exact evalExt_add hk.2 a b
  rw [chartDeriv, heq.fderiv_eq, fderiv_fun_add (differentiableAt_evalExt he hp hpV a)
    (differentiableAt_evalExt he hp hpV b)]
  rfl

/-- The differential commutes with subtraction: `d_p (a - b) = d_p a - d_p b`. -/
lemma chartDeriv_sub (he : IsAlgebraicChart e) (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    (a b : Γ(X, V)) :
    chartDeriv e V p (a - b) = chartDeriv e V p a - chartDeriv e V p b := by
  have heq : (fun k ↦ evalExt V (a - b) (e.symm k)) =ᶠ[𝓝 (e p)]
      fun k ↦ evalExt V a (e.symm k) - evalExt V b (e.symm k) := by
    filter_upwards [eventually_mem_target_and_le hp hpV] with k hk
    exact evalExt_sub hk.2 a b
  rw [chartDeriv, heq.fderiv_eq, fderiv_fun_sub (differentiableAt_evalExt he hp hpV a)
    (differentiableAt_evalExt he hp hpV b)]
  rfl

/-- The differential of a constant section is zero. -/
lemma chartDeriv_constSection (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) (c : 𝕜) :
    chartDeriv e V p (constSection V c) = 0 := by
  have heq : (fun k ↦ evalExt V (constSection V c) (e.symm k)) =ᶠ[𝓝 (e p)] fun _ ↦ c := by
    filter_upwards [eventually_mem_target_and_le hp hpV] with k hk
    exact evalExt_constSection hk.2 c
  rw [chartDeriv, heq.fderiv_eq, fderiv_const_apply]

/-- The differential commutes with finite sums. -/
lemma chartDeriv_sum (he : IsAlgebraicChart e) (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    {ι : Type*} (s : Finset ι) (a : ι → Γ(X, V)) :
    chartDeriv e V p (∑ i ∈ s, a i) = ∑ i ∈ s, chartDeriv e V p (a i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    have := chartDeriv_constSection (e := e) hp hpV 0
    rwa [constSection, map_zero, map_zero] at this
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi, chartDeriv_add he hp hpV, ih]

/-- If the differentials of all sections over the affine open `V` lie in a subspace `W`, so do
the differentials of sections over any other open `V'` containing `p`. -/
lemma chartDeriv_mem_of_forall_mem (he : IsAlgebraicChart e) (hp : p ∈ e.source)
    (hV : IsAffineOpen V) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) {W : Submodule 𝕜 (E →L[𝕜] 𝕜)}
    (hW : ∀ c : Γ(X, V), chartDeriv e V p c ∈ W) {V' : X.Opens} (hpV' : ⊤ ≤ p.toHom ⁻¹ᵁ V')
    (a' : Γ(X, V')) : chartDeriv e V' p a' ∈ W := by
  have hxV := (top_le_preimage_iff p V).1 hpV
  have hxV' := (top_le_preimage_iff p V').1 hpV'
  obtain ⟨t, htle, hxt⟩ := hV.exists_basicOpen_le (V := V ⊓ V') ⟨_, ⟨hxV, hxV'⟩⟩ hxV
  have := hV.isLocalization_basicOpen t
  obtain ⟨⟨b, ⟨_, k, rfl⟩⟩, hb⟩ := IsLocalization.mk'_surjective (Submonoid.powers t)
    (X.presheaf.map (homOfLE (htle.trans inf_le_right)).op a')
  have hspec := IsLocalization.mk'_spec Γ(X, X.basicOpen t) b
    (⟨t ^ k, k, rfl⟩ : Submonoid.powers t)
  have hb' : IsLocalization.mk' Γ(X, X.basicOpen t) b (⟨t ^ k, k, rfl⟩ : Submonoid.powers t) =
      X.presheaf.map (homOfLE (htle.trans inf_le_right)).op a' := hb
  rw [hb'] at hspec
  have hval : ∀ q : UnderlyingSpace 𝕜 X, ⊤ ≤ q.toHom ⁻¹ᵁ X.basicOpen t →
      evalExt V' a' q * evalExt V (t ^ k) q = evalExt V b q := by
    intro q hq
    have h1 := congrArg (evalRingHom q hq) hspec
    have hqV : ⊤ ≤ q.toHom ⁻¹ᵁ V := hq.trans (Scheme.Hom.preimage_mono _ (X.basicOpen_le t))
    have hqV' : ⊤ ≤ q.toHom ⁻¹ᵁ V' :=
      hq.trans (Scheme.Hom.preimage_mono _ (htle.trans inf_le_right))
    simp only [map_mul, evalRingHom_apply] at h1
    rwa [evalExt_of_le _ hqV', evalExt_of_le _ hqV, evalExt_of_le _ hqV,
      ← eval_restrict (htle.trans inf_le_right) q hq, ← eval_restrict (X.basicOpen_le t) q hq,
      ← eval_restrict (X.basicOpen_le t) q hq]
  have hpt : ⊤ ≤ p.toHom ⁻¹ᵁ X.basicOpen t := (top_le_preimage_iff p _).2 hxt
  have heq : (fun k' ↦ evalExt V' a' (e.symm k') * evalExt V (t ^ k) (e.symm k')) =ᶠ[𝓝 (e p)]
      fun k' ↦ evalExt V b (e.symm k') := by
    filter_upwards [eventually_mem_target_and_le hp hpt] with k' hk'
    exact hval _ hk'.2
  have hd := heq.fderiv_eq (𝕜 := 𝕜)
  rw [fderiv_fun_mul (differentiableAt_evalExt he hp hpV' a')
    (differentiableAt_evalExt he hp hpV _), e.left_inv hp] at hd
  change evalExt V' a' p • chartDeriv e V p (t ^ k) + evalExt V (t ^ k) p • chartDeriv e V' p a' =
    chartDeriv e V p b at hd
  have htp : evalExt V (t ^ k) p ≠ 0 := by
    rw [evalExt_pow hpV]
    exact pow_ne_zero _ ((mem_basicOpen_iff_evalExt_ne_zero hpV t).1 hxt)
  have : chartDeriv e V' p a' = (evalExt V (t ^ k) p)⁻¹ •
      (chartDeriv e V p b - evalExt V' a' p • chartDeriv e V p (t ^ k)) := by
    rw [← hd, add_sub_cancel_left, smul_smul, inv_mul_cancel₀ htp, one_smul]
  rw [this]
  exact W.smul_mem _ (W.sub_mem (hW b) (W.smul_mem _ (hW _)))

/-- **The differentials of regular functions span the cotangent space of the chart.** For an
algebraic chart `e` around `p` and an affine open `V ∋ p`, the differentials at `p` of the
sections of `𝒪_X` over `V` span the dual of the model space. -/
theorem span_chartDeriv_eq_top [FiniteDimensional 𝕜 E] (he : IsAlgebraicChart e)
    (hp : p ∈ e.source) (hV : IsAffineOpen V) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) :
    Submodule.span 𝕜 (Set.range (chartDeriv e V p)) = ⊤ := by
  classical
  set W := Submodule.span 𝕜 (Set.range (chartDeriv e V p))
  refine eq_top_iff.2 fun φ _ ↦ ?_
  obtain ⟨V', ι, _, a', L, hV', hL⟩ := he.exists_eq_evalExt p hp
  have hmem : ∀ i, chartDeriv e V' p (a' i) ∈ W := fun i ↦
    chartDeriv_mem_of_forall_mem he hp hV hpV
      (fun c ↦ Submodule.subset_span (Set.mem_range_self (f := chartDeriv e V p) c)) hV' (a' i)
  set F : E → ι → 𝕜 := fun k i ↦ evalExt V' (a' i) (e.symm k)
  have hF : DifferentiableAt 𝕜 F (e p) :=
    differentiableAt_pi.2 fun i ↦ differentiableAt_evalExt he hp hV' (a' i)
  have hid : (fun k ↦ k) =ᶠ[𝓝 (e p)] fun k ↦ L (F k) := by
    filter_upwards [eventually_mem_target_and_le hp hV'] with k hk
    rw [← hL _ (e.map_target hk.1) hk.2, e.right_inv hk.1]
  have hd := hid.fderiv_eq (𝕜 := 𝕜)
  have hFd : fderiv 𝕜 F (e p) = ContinuousLinearMap.pi fun i ↦ chartDeriv e V' p (a' i) :=
    fderiv_pi fun i ↦ differentiableAt_evalExt he hp hV' (a' i)
  rw [fderiv_fun_id, fderiv_fun_comp _ L.differentiableAt hF, L.fderiv, hFd] at hd
  have hkey : φ.comp (L.comp (ContinuousLinearMap.pi fun i ↦ chartDeriv e V' p (a' i))) =
      ∑ i, φ (L (Pi.single i 1)) • chartDeriv e V' p (a' i) := by
    ext v
    simp only [ContinuousLinearMap.coe_comp, Function.comp_apply, ContinuousLinearMap.coe_pi',
      FunLike.coe_sum, Finset.sum_apply, FunLike.coe_smul,
      Pi.smul_apply, smul_eq_mul]
    conv_lhs => rw [pi_eq_sum_univ (fun i ↦ chartDeriv e V' p (a' i) v)]
    simp only [map_sum, map_smul, smul_eq_mul]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [mul_comm]
    congr 3
    funext j
    simp [Pi.single_apply, eq_comm]
  rw [← ContinuousLinearMap.comp_id φ, hd, hkey]
  exact W.sum_mem fun i _ ↦ W.smul_mem _ (hmem i)

/-- If `w c = ∑ dᵢ bᵢ` where `c` and all `bᵢ` vanish at `p`, then
`w(p) d_p c = ∑ dᵢ(p) d_p bᵢ`. -/
lemma evalExt_smul_chartDeriv_eq_sum (he : IsAlgebraicChart e) (hp : p ∈ e.source)
    (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) {ι : Type*} [Fintype ι] (b d : ι → Γ(X, V))
    (hb0 : ∀ i, evalExt V (b i) p = 0) {c w : Γ(X, V)} (hc : evalExt V c p = 0)
    (hwc : w * c = ∑ i, d i * b i) :
    evalExt V w p • chartDeriv e V p c = ∑ i, evalExt V (d i) p • chartDeriv e V p (b i) := by
  have h1 := chartDeriv_mul he hp hpV w c
  rw [hc, zero_smul, add_zero, hwc, chartDeriv_sum he hp hpV] at h1
  rw [← h1]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [chartDeriv_mul he hp hpV, hb0, zero_smul, add_zero]

/-- If the sections `bᵢ` vanish at `p` and every section `c` vanishing at `p` satisfies
`w c = ∑ dᵢ bᵢ` for some `w` with `w(p) ≠ 0`, then the differentials `d_p bᵢ` span the
differentials of all sections over `V`. -/
lemma chartDeriv_mem_span_of_forall_exists_mul_eq_sum (he : IsAlgebraicChart e)
    (hp : p ∈ e.source) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V) {ι : Type*} [Fintype ι] (b : ι → Γ(X, V))
    (hb0 : ∀ i, evalExt V (b i) p = 0)
    (hexp : ∀ c : Γ(X, V), evalExt V c p = 0 →
      ∃ (w : Γ(X, V)) (d : ι → Γ(X, V)), evalExt V w p ≠ 0 ∧ w * c = ∑ i, d i * b i)
    (c : Γ(X, V)) :
    chartDeriv e V p c ∈ Submodule.span 𝕜 (Set.range fun i ↦ chartDeriv e V p (b i)) := by
  set W := Submodule.span 𝕜 (Set.range fun i ↦ chartDeriv e V p (b i))
  have hDM : ∀ c : Γ(X, V), evalExt V c p = 0 → chartDeriv e V p c ∈ W := by
    intro c hc
    obtain ⟨w, d, hw, hwc⟩ := hexp c hc
    have : chartDeriv e V p c =
        (evalExt V w p)⁻¹ • ∑ i, evalExt V (d i) p • chartDeriv e V p (b i) := by
      rw [← evalExt_smul_chartDeriv_eq_sum he hp hpV b d hb0 hc hwc, smul_smul,
        inv_mul_cancel₀ hw, one_smul]
    rw [this]
    exact W.smul_mem _ (W.sum_mem fun i _ ↦ W.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩))
  have := hDM (c - constSection V (evalExt V c p))
    (by rw [evalExt_sub hpV, evalExt_constSection hpV, sub_self])
  rwa [chartDeriv_sub he hp hpV, chartDeriv_constSection hp hpV, sub_zero] at this

/-- **A function with zero differential at a regular point vanishes to second order.** Let `V`
be an affine open containing `p ∈ X(𝕜)`, `e` an algebraic chart around `p` with values in a space
of dimension `n`, and suppose the maximal ideal of `𝒪_{X,p}` is generated by `n` elements. If
`a ∈ Γ(X, V)` vanishes at `p` and its differential at `p` in the chart is zero, then the germ of
`a` at `p` lies in `𝔪²`. -/
theorem germ_mem_maximalIdeal_sq_of_chartDeriv_eq_zero [FiniteDimensional 𝕜 E] {n : ℕ}
    (hn : Module.finrank 𝕜 E = n) (he : IsAlgebraicChart e) (hp : p ∈ e.source)
    (hV : IsAffineOpen V) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    (f : Fin n → X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜)))
    (hf : Ideal.span (Set.range f) = maximalIdeal _) (a : Γ(X, V)) (ha : evalExt V a p = 0)
    (hda : chartDeriv e V p a = 0) :
    X.presheaf.germ V _ ((top_le_preimage_iff p V).1 hpV) a ∈ maximalIdeal _ ^ 2 := by
  classical
  have hxV := (top_le_preimage_iff p V).1 hpV
  let y : V := ⟨_, hxV⟩
  let : Algebra Γ(X, V) (X.presheaf.stalk (y : X)) := (X.presheaf.germ V _ hxV).hom.toAlgebra
  set P := (hV.primeIdealOf y).asIdeal
  have hloc : IsLocalization.AtPrime (X.presheaf.stalk (y : X)) P := hV.isLocalization_stalk y
  have hmemP : ∀ c, c ∈ P ↔ evalExt V c p = 0 := fun c ↦ by
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk (y : X)) P c]
    exact germ_mem_maximalIdeal_iff hpV c
  choose z hz using fun i ↦ IsLocalization.mk'_surjective P.primeCompl (f i)
  set b : Fin n → Γ(X, V) := fun i ↦ (z i).1
  have hspan : Ideal.span (Set.range fun i ↦ algebraMap Γ(X, V) (X.presheaf.stalk (y : X)) (b i)) =
      maximalIdeal _ := by
    rw [← hf]
    exact span_range_algebraMap_eq_of_mk'_eq P.primeCompl z f hz
  have hb0 : ∀ i, evalExt V (b i) p = 0 := fun i ↦ by
    rw [← germ_mem_maximalIdeal_iff hpV, ← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hexp : ∀ c : Γ(X, V), evalExt V c p = 0 →
      ∃ (w : Γ(X, V)) (d : Fin n → Γ(X, V)), evalExt V w p ≠ 0 ∧ w * c = ∑ i, d i * b i := by
    intro c hc
    obtain ⟨w, hw, d, hwc⟩ := exists_mul_eq_sum_of_algebraMap_mem_span
      (S := X.presheaf.stalk (y : X)) P.primeCompl b
      (hspan ▸ (germ_mem_maximalIdeal_iff hpV c).2 hc)
    exact ⟨w, d, fun h ↦ hw ((hmemP w).2 h), hwc⟩
  have htop : Submodule.span 𝕜 (Set.range fun i ↦ chartDeriv e V p (b i)) = ⊤ := by
    rw [eq_top_iff, ← span_chartDeriv_eq_top he hp hV hpV]
    exact Submodule.span_le.2 (Set.range_subset_iff.2
      (chartDeriv_mem_span_of_forall_exists_mul_eq_sum he hp hpV b hb0 hexp))
  have hli : LinearIndependent 𝕜 fun i ↦ chartDeriv e V p (b i) := by
    refine linearIndependent_of_top_le_span_of_card_eq_finrank htop.ge ?_
    rw [Fintype.card_fin, ← LinearMap.toContinuousLinearMap.finrank_eq,
      Module.finrank_linearMap_self, hn]
  obtain ⟨w, d, hw, hwa⟩ := hexp a ha
  have h1 := evalExt_smul_chartDeriv_eq_sum he hp hpV b d hb0 ha hwa
  rw [hda, smul_zero] at h1
  have hd0 : ∀ i, evalExt V (d i) p = 0 := Fintype.linearIndependent_iff.1 hli _ h1.symm
  have hmul :
      X.presheaf.germ V (y : X) hxV (w * a) ∈ maximalIdeal (X.presheaf.stalk (y : X)) ^ 2 := by
    rw [hwa, map_sum, pow_two]
    refine Ideal.sum_mem _ fun i _ ↦ ?_
    rw [map_mul]
    exact Ideal.mul_mem_mul ((germ_mem_maximalIdeal_iff hpV _).2 (hd0 i))
      ((germ_mem_maximalIdeal_iff hpV _).2 (hb0 i))
  rw [map_mul] at hmul
  exact (Ideal.unit_mul_mem_iff_mem _ (IsLocalRing.notMem_maximalIdeal.1
    ((germ_mem_maximalIdeal_iff hpV w).not.2 hw))).1 hmul

/-- **A local equation of a regular hypersurface has nonzero differential.** Let `p` be a point
of `X(𝕜)` at which `𝒪_{X,p}` is a regular local ring of dimension `n`, `e` an algebraic chart
around `p` with values in a space of dimension `n`, and `a ∈ Γ(X, V)` a section over an affine
open `V ∋ p` vanishing at `p` whose germ is a nonzerodivisor with `𝒪_{X,p}/(a)` regular. Then the
differential of `a` at `p` in the chart is nonzero. -/
theorem chartDeriv_ne_zero_of_isRegularLocalRing_quotient [FiniteDimensional 𝕜 E] {n : ℕ}
    (hn : Module.finrank 𝕜 E = n) (he : IsAlgebraicChart e) (hp : p ∈ e.source)
    (hV : IsAffineOpen V) (hpV : ⊤ ≤ p.toHom ⁻¹ᵁ V)
    [IsRegularLocalRing (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜)))]
    (hdim : ringKrullDim (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜))) = n)
    (a : Γ(X, V)) (ha : evalExt V a p = 0)
    (hnzd : X.presheaf.germ V _ ((top_le_preimage_iff p V).1 hpV) a ∈ nonZeroDivisors _)
    (hreg : IsRegularLocalRing (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜)) ⧸
      Ideal.span {X.presheaf.germ V _ ((top_le_preimage_iff p V).1 hpV) a})) :
    chartDeriv e V p a ≠ 0 := by
  intro hda
  have : IsNoetherianRing (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜))) :=
    IsRegularLocalRing.toIsNoetherian
  obtain ⟨k, f, hk, hf⟩ := (MMP.isRegularLocalRing_iff_exists_span_eq_maximalIdeal
    (X.presheaf.stalk (p.toHom (IsLocalRing.closedPoint 𝕜)))).1 inferInstance
  obtain rfl : k = n := by exact_mod_cast hk.trans hdim
  exact Stacks.not_isRegularLocalRing_quotient_span_singleton_of_mem_sq hnzd
    (germ_mem_maximalIdeal_sq_of_chartDeriv_eq_zero hn he hp hV hpV f hf a ha hda) hreg

end Deriv

