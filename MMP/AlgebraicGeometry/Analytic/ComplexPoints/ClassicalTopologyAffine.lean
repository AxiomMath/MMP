module

public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.ClassicalTopologyCharts
public import Mathlib.Topology.Algebra.Ring.Basic

/-!
# Points of affine schemes and closed embeddings into `Kⁿ`

Let `X` be an affine scheme over a field `K`. A `K`-point of `X` is the same as a ring
homomorphism `φ : Γ(X, X) → K` restricting to the identity on `K`: the point is
`Spec K → Spec Γ(X, X) ≅ X`, and the value of a global section `a` at it is `φ(a)`.

If the global sections are generated over `K` by a family `(y_i)`, evaluation at the `y_i` is a
closed embedding `X(K) → K^ι` when `K` is a Hausdorff topological field: it is an embedding since
the values of all global sections are polynomials in the values of the `y_i`, which are
continuous functions of them; and its image is closed since a limit of points is again a ring
homomorphism (the polynomial identities pass to the closure), hence a point.

## Main definitions

* `MMP.UnderlyingSpace.structureRingHom`: the structure map `K → Γ(X, X)`.
* `MMP.UnderlyingSpace.ofRingHom`: the `K`-point attached to a ring homomorphism
  `Γ(X, X) → K` over `K`.

## Main results

* `MMP.UnderlyingSpace.evalTop_ofRingHom`: the value of `a` at that point is
  `φ(a)`.
* `MMP.UnderlyingSpace.isClosedEmbedding_evalFamily`: if the global sections are
  generated by `y` over `K`, evaluation at `y` is a closed embedding `X(K) → K^ι`.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Topology

universe u

namespace MMP

namespace UnderlyingSpace

variable {K : Type u} [Field K] {X : Scheme.{u}} [X.Over (Spec (.of K))]

/-- For a morphism `f : Y ⟶ Z`, `f.appLE ⊤ ⊤ h` is the map `f.appTop` on global sections. -/
lemma appLE_top_top {Y Z : Scheme.{u}} (f : Y ⟶ Z) (h : ⊤ ≤ f ⁻¹ᵁ ⊤) :
    f.appLE ⊤ ⊤ h = f.appTop := by
  rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
  rfl

/-- On global sections, the inverse of `X.isoSpec : X ≅ Spec Γ(X, ⊤)` is the inverse of
`Scheme.ΓSpecIso Γ(X, ⊤)`. -/
lemma isoSpec_inv_appTop [IsAffine X] :
    X.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(X, ⊤)).inv := by
  rw [← cancel_epi (Scheme.ΓSpecIso Γ(X, ⊤)).hom, Iso.hom_inv_id, ← Scheme.toSpecΓ_appTop,
    ← Scheme.isoSpec_hom, ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop]

/-- The value of a global section `a` at a `K`-point `p` is the image of `a` under the map
`p.toHom.appTop : Γ(X, ⊤) → Γ(Spec K, ⊤)`, composed with `Γ(Spec K, ⊤) ≅ K`. -/
lemma evalTop_eq (p : UnderlyingSpace K X) (a : Γ(X, ⊤)) :
    evalTop p a = (Scheme.ΓSpecIso (.of K)).hom (p.toHom.appTop a) := by
  simp only [evalTop, UnderlyingSpace.eval]
  rw [appLE_top_top]

variable (K X) in
/-- The structure map `K → Γ(X, X)` of a scheme over `K`. -/
def structureRingHom : K →+* Γ(X, ⊤) :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ (X ↘ Spec (.of K)).appTop).hom

/-- A global section coming from `K` takes its constant value at every point. -/
lemma evalTop_structureRingHom (p : UnderlyingSpace K X) (c : K) :
    evalTop p (structureRingHom K X c) = c := by
  rw [evalTop_eq, structureRingHom, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
    Category.assoc, ← Category.assoc (Scheme.Hom.appTop _) (Scheme.Hom.appTop _),
    ← Scheme.Hom.comp_appTop, p.toHom_comp_over, Scheme.Hom.id_appTop, Category.id_comp,
    Iso.inv_hom_id, CommRingCat.id_apply]

/-- The `K`-point of an affine scheme `X` attached to a ring homomorphism `Γ(X, X) → K` which is
the identity on `K`. -/
def ofRingHom [IsAffine X] (φ : Γ(X, ⊤) →+* K) (hφ : ∀ c, φ (structureRingHom K X c) = c) :
    UnderlyingSpace K X :=
  ⟨Spec.map (CommRingCat.ofHom φ) ≫ X.isoSpec.inv, by
    have hφ' : (X ↘ Spec (.of K)).appTop ≫ CommRingCat.ofHom φ =
        (Scheme.ΓSpecIso (.of K)).hom := by
      rw [← cancel_epi (Scheme.ΓSpecIso (.of K)).inv, Iso.inv_hom_id]
      ext c
      exact hφ c
    rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp, hφ',
      ← Scheme.isoSpec_Spec_hom, Iso.hom_inv_id]⟩

/-- The value of a global section `a` at the point `ofRingHom φ hφ` is `φ a`. -/
lemma evalTop_ofRingHom [IsAffine X] (φ : Γ(X, ⊤) →+* K)
    (hφ : ∀ c, φ (structureRingHom K X c) = c) (a : Γ(X, ⊤)) :
    evalTop (ofRingHom φ hφ) a = φ a := by
  rw [evalTop_eq]
  change (Scheme.ΓSpecIso (.of K)).hom
    ((Spec.map (CommRingCat.ofHom φ) ≫ X.isoSpec.inv).appTop a) = _
  rw [Scheme.Hom.comp_appTop, isoSpec_inv_appTop, ← CommRingCat.comp_apply, Category.assoc, Scheme.ΓSpecIso_naturality]
  erw [Iso.inv_hom_id_assoc]
  rfl

/-- Evaluation of a family of global sections, `X(K) → K^ι`. -/
def evalFamily {ι : Type*} (y : ι → Γ(X, ⊤)) (p : UnderlyingSpace K X) : ι → K :=
  fun i ↦ evalTop p (y i)

variable [TopologicalSpace K] [IsTopologicalRing K]

/-- If `Γ(X, X)` is generated by `y` over `K`, the value of every global section is a continuous
function of the values of the `y_i`. -/
lemma exists_continuous_evalTop_eq {ι : Type*} (y : ι → Γ(X, ⊤))
    (hy : Subring.closure (Set.range (structureRingHom K X) ∪ Set.range y) = ⊤) (a : Γ(X, ⊤)) :
    ∃ G : (ι → K) → K, Continuous G ∧ ∀ p, evalTop p a = G (evalFamily y p) := by
  let T : Subring Γ(X, ⊤) :=
    { carrier := {a | ∃ G : (ι → K) → K, Continuous G ∧ ∀ p, evalTop p a = G (evalFamily y p)}
      mul_mem' := by
        rintro a b ⟨F, hF, hF'⟩ ⟨G, hG, hG'⟩
        exact ⟨F * G, hF.mul hG, fun p ↦ by
          rw [Pi.mul_apply, ← hF', ← hG', evalTop, evalTop, evalTop, ← evalRingHom_apply,
            map_mul, evalRingHom_apply, evalRingHom_apply]⟩
      one_mem' := ⟨1, continuous_const, fun p ↦ by
        rw [evalTop, ← evalRingHom_apply, map_one, Pi.one_apply]⟩
      add_mem' := by
        rintro a b ⟨F, hF, hF'⟩ ⟨G, hG, hG'⟩
        exact ⟨F + G, hF.add hG, fun p ↦ by
          rw [Pi.add_apply, ← hF', ← hG', evalTop, evalTop, evalTop, ← evalRingHom_apply,
            map_add, evalRingHom_apply, evalRingHom_apply]⟩
      zero_mem' := ⟨0, continuous_const, fun p ↦ by
        rw [evalTop, ← evalRingHom_apply, map_zero, Pi.zero_apply]⟩
      neg_mem' := by
        rintro a ⟨F, hF, hF'⟩
        exact ⟨-F, hF.neg, fun p ↦ by
          rw [Pi.neg_apply, ← hF', evalTop, evalTop, ← evalRingHom_apply, map_neg,
            evalRingHom_apply]⟩ }
  have hle : Subring.closure (Set.range (structureRingHom K X) ∪ Set.range y) ≤ T := by
    rw [Subring.closure_le]
    rintro _ (⟨c, rfl⟩ | ⟨i, rfl⟩)
    · exact ⟨fun _ ↦ c, continuous_const, fun p ↦ evalTop_structureRingHom p c⟩
    · exact ⟨fun v ↦ v i, continuous_apply i, fun p ↦ rfl⟩
  rw [hy] at hle
  exact hle (Subring.mem_top a)

variable [ContinuousInv₀ K] [T1Space K]

/-- If `Γ(X, X)` is generated by `y` over `K`, evaluation at `y` is an embedding `X(K) → K^ι`. -/
lemma isInducing_evalFamily [IsAffine X] {ι : Type*} (y : ι → Γ(X, ⊤))
    (hy : Subring.closure (Set.range (structureRingHom K X) ∪ Set.range y) = ⊤) :
    IsInducing (evalFamily (K := K) y) := by
  choose G hG hG' using exists_continuous_evalTop_eq (K := K) y hy
  have hcomp : evalTop = (fun v a ↦ G a v) ∘ evalFamily (K := K) y := by
    funext p a
    exact hG' a p
  refine IsInducing.of_comp (continuous_pi fun i ↦ ?_) (continuous_pi fun a ↦ hG a) ?_
  · exact (continuous_apply (y i)).comp (isInducing_evalTop (K := K) (X := X)).continuous
  · rw [← hcomp]
    exact isInducing_evalTop

/-- If `Γ(X, X)` is generated by `y` over `K` and `K` is Hausdorff, evaluation at `y` is a
closed embedding `X(K) → K^ι`. -/
theorem isClosedEmbedding_evalFamily [T2Space K] [IsAffine X] {ι : Type*}
    (y : ι → Γ(X, ⊤))
    (hy : Subring.closure (Set.range (structureRingHom K X) ∪ Set.range y) = ⊤) :
    IsClosedEmbedding (evalFamily (K := K) y) := by
  refine ⟨⟨isInducing_evalFamily y hy, ?_⟩, ?_⟩
  · intro p q h
    have hpq : ∀ a, evalTop p a = evalTop q a := fun a ↦ by
      obtain ⟨G, -, hG'⟩ := exists_continuous_evalTop_eq (K := K) y hy a
      rw [hG', hG', h]
    refine UnderlyingSpace.ext (ext_of_isAffine ?_)
    ext a
    have := hpq a
    rw [evalTop_eq, evalTop_eq] at this
    exact (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.injective this
  refine isClosed_of_closure_subset fun v hv ↦ ?_
  choose G hG hG' using exists_continuous_evalTop_eq (K := K) y hy
  have hext : ∀ {F₁ F₂ : (ι → K) → K}, Continuous F₁ → Continuous F₂ →
      (∀ p, F₁ (evalFamily y p) = F₂ (evalFamily y p)) → F₁ v = F₂ v := by
    intro F₁ F₂ h₁ h₂ h
    have : Set.EqOn F₁ F₂ (Set.range (evalFamily (K := K) y)) := by
      rintro _ ⟨p, rfl⟩
      exact h p
    exact this.closure h₁ h₂ hv
  let φ : Γ(X, ⊤) →+* K :=
    { toFun := fun a ↦ G a v
      map_one' := hext (hG 1) continuous_const fun p ↦ by
        rw [← hG', evalTop, ← evalRingHom_apply, map_one]
      map_mul' := fun a b ↦ hext (hG (a * b)) ((hG a).mul (hG b)) fun p ↦ by
        rw [← hG', Pi.mul_apply, ← hG', ← hG', evalTop, evalTop, evalTop, ← evalRingHom_apply,
          map_mul, evalRingHom_apply, evalRingHom_apply]
      map_zero' := hext (hG 0) continuous_const fun p ↦ by
        rw [← hG', evalTop, ← evalRingHom_apply, map_zero]
      map_add' := fun a b ↦ hext (hG (a + b)) ((hG a).add (hG b)) fun p ↦ by
        rw [← hG', Pi.add_apply, ← hG', ← hG', evalTop, evalTop, evalTop, ← evalRingHom_apply,
          map_add, evalRingHom_apply, evalRingHom_apply] }
  have hφ : ∀ c, φ (structureRingHom K X c) = c := fun c ↦
    hext (hG _) continuous_const fun p ↦ by rw [← hG', evalTop_structureRingHom]
  refine ⟨ofRingHom φ hφ, funext fun i ↦ ?_⟩
  change evalTop (ofRingHom φ hφ) (y i) = v i
  rw [evalTop_ofRingHom]
  exact hext (hG (y i)) (continuous_apply i) fun p ↦ (hG' (y i) p).symm

end UnderlyingSpace

end MMP
