variable {T : TopCat.{0}} {R : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}

/-- Multiplication by a global section `r` on the abelian sheaf underlying a sheaf of modules. -/
noncomputable def smulTop (M : SheafOfModules.{0} R) (r : R.obj.obj (op ⊤)) :
    (SheafOfModules.toSheaf R).obj M ⟶ (SheafOfModules.toSheaf R).obj M where
  hom :=
    { app U := AddCommGrpCat.ofHom
        (show M.val.obj U →+ M.val.obj U from
          DistribSMul.toAddMonoidHom _ (R.obj.map (homOfLE (le_top : U.unop ≤ ⊤)).op r))
      naturality U V g := by
        refine AddCommGrpCat.ext fun (x : M.val.obj U) ↦ ?_
        change R.obj.map (homOfLE (le_top : V.unop ≤ ⊤)).op r • M.val.map g x =
          M.val.map g (R.obj.map (homOfLE (le_top : U.unop ≤ ⊤)).op r • x)
        rw [M.val.map_smul]
        congr 1
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
        rfl }

/-- Multiplication by a global section `r` commutes with the abelian-sheaf map underlying a
morphism of sheaves of modules. -/
lemma smulTop_naturality {M N : SheafOfModules.{0} R} (θ : M ⟶ N) (r : R.obj.obj (op ⊤)) :
    (SheafOfModules.toSheaf R).map θ ≫ smulTop N r =
      smulTop M r ≫ (SheafOfModules.toSheaf R).map θ := by
  ext U x
  exact ((θ.val.app U).hom.map_smul (R.obj.map (homOfLE (le_top : U.unop ≤ ⊤)).op r)
    (x : M.val.obj U)).symm

end

/-- Analytification turns multiplication by a global function `a` into multiplication by its
image in `𝒪_{X^an}`. -/
lemma analytifyModuleι_comp_smulTop {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) (F : X.Modules)
    (a : Γ(X, ⊤)) :
    analytifyModuleι sX F ≫
        smulTop ((analytifyModule sX).obj F) ((ringCatSheafHom sX).hom.app (op ⊤) a) =
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).map
          ((SheafOfModules.toSheaf X.ringCatSheaf).map (Stacks.Perfect.FractionClass.smulHom a F)) ≫
        analytifyModuleι sX F := by
  let adj := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sX)
  apply (adj.homEquiv _ _).injective
  have hL := adj.homEquiv_naturality_right (analytifyModuleι sX F)
    (smulTop ((analytifyModule sX).obj F) ((ringCatSheafHom sX).hom.app (op ⊤) a))
  have hR := adj.homEquiv_naturality_left
    ((SheafOfModules.toSheaf X.ringCatSheaf).map (Stacks.Perfect.FractionClass.smulHom a F))
    (analytifyModuleι sX F)
  refine hL.trans (Eq.trans ?_ hR.symm)
  have h1 : adj.homEquiv _ _ (analytifyModuleι sX F) =
      (SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F) :=
    Equiv.apply_symm_apply _ _
  rw [h1]
  refine Sheaf.hom_ext (NatTrans.ext (funext fun U => AddCommGrpCat.ext fun s => ?_))
  change (smulTop ((analytifyModule sX).obj F) ((ringCatSheafHom sX).hom.app (op ⊤) a)).hom.app _
      ((analytifyModuleUnit sX F).val.app U s) =
    (analytifyModuleUnit sX F).val.app U
      (((SheafOfModules.toSheaf X.ringCatSheaf).map
        (Stacks.Perfect.FractionClass.smulHom a F)).hom.app U s)
  let M := (analytifyModule sX).obj F
  let t : M.val.obj (op ((Opens.map (toSchemeHom sX)).obj U.unop)) :=
    (analytifyModuleUnit sX F).val.app U s
  have key : (ringCatSheafHom sX).hom.app U (Stacks.Perfect.FractionClass.resTop a U) =
      (MMP.Analytic.ringCatSheaf sX).obj.map
        (homOfLE (le_top : (Opens.map (toSchemeHom sX)).obj U.unop ≤ ⊤)).op
        ((ringCatSheafHom sX).hom.app (op ⊤) a) := by
    have h2 := (ringCatSheafHom sX).hom.naturality (homOfLE (le_top : U.unop ≤ ⊤)).op
    calc (ringCatSheafHom sX).hom.app U (Stacks.Perfect.FractionClass.resTop a U)
        = (X.ringCatSheaf.obj.map (homOfLE (le_top : U.unop ≤ ⊤)).op ≫
            (ringCatSheafHom sX).hom.app (op U.unop)) a := rfl
      _ = ((ringCatSheafHom sX).hom.app (op ⊤) ≫
            (((Opens.map (toSchemeHom sX)).sheafPushforwardContinuous RingCat
              (Opens.grothendieckTopology X) (Opens.grothendieckTopology (space sX))).obj
                (MMP.Analytic.ringCatSheaf sX)).obj.map (homOfLE (le_top : U.unop ≤ ⊤)).op) a := by
          rw [h2]
      _ = _ := rfl
  change (MMP.Analytic.ringCatSheaf sX).obj.map
        (homOfLE (le_top : (Opens.map (toSchemeHom sX)).obj U.unop ≤ ⊤)).op
        ((ringCatSheafHom sX).hom.app (op ⊤) a) • t =
    (analytifyModuleUnit sX F).val.app U
      (Stacks.Perfect.FractionClass.resTop a U • (show F.val.obj U from s))
  rw [← key]
  exact ((analytifyModuleUnit sX F).val.app U).hom.map_smul _ _ |>.symm

/-- First `Ext`-cohomology from the constant sheaf `ℤ` is Godement cohomology, naturally in the
sheaf: both are the first right derived functor of global sections. -/
noncomputable def extIso (T : TopCat.{0}) :
    MMP.Analytic.sheafCohomology T (1 : ℕ) ≅
      Abelian.extFunctorObj
        ((constantSheaf (Opens.grothendieckTopology T) AddCommGrpCat.{0}).obj
          (AddCommGrpCat.of (ULift.{0} ℤ))) 1 :=
  MMP.Analytic.sheafCohomologyIso T 1 ≪≫
    (CategoryTheory.Functor.rightDerivedIsoOfNatIso
      (Stacks.Thickenings.sectionsCoyonedaIso T).symm 1) ≪≫
    ModuleSheafCohomology.rightDerivedCoyonedaSuccIso _ 0

/-- `extIso` intertwines `Sheaf.H.map g 1` with the map on Godement cohomology. -/
lemma extIso_inv_naturality (T : TopCat.{0}) {F G : TopCat.Sheaf AddCommGrpCat.{0} T}
    (g : F ⟶ G) (x : Sheaf.H F 1) :
    ((extIso T).inv.app G) (Sheaf.H.map g 1 x) =
      (MMP.Analytic.sheafCohomology T (1 : ℕ)).map g ((extIso T).inv.app F x) := by
  have h := ConcreteCategory.congr_hom ((extIso T).inv.naturality g) x
  exact h

/-- **GAGA for the cohomology of the structure sheaf, with its `ℂ`-structure.** For a projective
`X` over `ℂ` and every `q`, the Godement cohomology `H^q(X^an, 𝒪)` is additively isomorphic to the
`ℂ`-vector space `H^q(X, 𝒪_X)`, and the isomorphism carries `H^q` of multiplication by the
constant `c` to scalar multiplication by `c`. The isomorphism is `𝒪_X^an ≅ 𝒪` followed by the
inverse of the GAGA comparison map. -/
theorem exists_addEquiv_sheafCohomology_analytification {C : Scheme.{0}}
    (f : C ⟶ Spec (.of ℂ)) (hproj : IsProjective f) (q : ℕ) :
    ∃ E : (MMP.Analytic.sheafCohomology (space f) (q : ℤ)).obj
        ((SheafOfModules.toSheaf (MMP.Analytic.ringCatSheaf f)).obj
          (SheafOfModules.unit (MMP.Analytic.ringCatSheaf f))) ≃+
        cohomologyOverField ℂ f (SheafOfModules.unit C.ringCatSheaf) q,
      ∀ a x, E ((MMP.Analytic.sheafCohomology (space f) (q : ℤ)).map
        (smulTop (SheafOfModules.unit (MMP.Analytic.ringCatSheaf f))
          ((ringCatSheafHom f).hom.app (op ⊤) (ComplexPoints.baseRingHom f ⊤ a))) x) =
        a • E x := by
  haveI := hproj.isProper
  let F : C.Modules := SheafOfModules.unit C.ringCatSheaf
  let R := MMP.Analytic.ringCatSheaf f
  let c : ℂ → R.obj.obj (op ⊤) := fun a =>
    (ringCatSheafHom f).hom.app (op ⊤) (ComplexPoints.baseRingHom f ⊤ a)
  let θ := analytifyUnitIso f
  let Fan := (analytifyModule f).obj F
  let G := MMP.Analytic.sheafCohomology (space f) (q : ℤ)
  let Gc := MMP.Analytic.sheafCohomology C.toTopCat (q : ℤ)
  let toS := SheafOfModules.toSheaf R
  let a' : ℂ → Γ(C, ⊤) := fun a => ComplexPoints.baseRingHom f ⊤ a
  have hc : ∀ a, toS.map θ.inv ≫ smulTop Fan (c a) =
      smulTop (SheafOfModules.unit R) (c a) ≫ toS.map θ.inv := fun a =>
    smulTop_naturality θ.inv (c a)
  have hψ : ∀ a, analytifyModuleι f F ≫ smulTop Fan (c a) =
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom f)).map
        ((SheafOfModules.toSheaf C.ringCatSheaf).map
          (Stacks.Perfect.FractionClass.smulHom (a' a) F)) ≫ analytifyModuleι f F :=
    fun a => analytifyModuleι_comp_smulTop f F (a' a)
  have hnat : ∀ a, comparisonMap f F (q : ℤ) ≫ G.map (smulTop Fan (c a)) =
      Gc.map ((SheafOfModules.toSheaf C.ringCatSheaf).map
          (Stacks.Perfect.FractionClass.smulHom (a' a) F)) ≫
        comparisonMap f F (q : ℤ) := fun a =>
    (analytification_stalks f).2.2.2.2.2.2.2.2.1 F F _ _ (hψ a) _
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian f
  haveI hiso : IsIso (comparisonMap f F (q : ℤ)) :=
    isIso_comparisonMap_of_isProjective f hproj F
      (AlgebraicGeometry.CoherentAbelian.stacksIsCoherent_of_isCoherent
        (Stacks.AlgebraicGeometry.CoherentKernel.structureSheaf_isCoherent C)) _
  obtain ⟨e, he⟩ := MMP.Analytic.exists_addEquiv_sheafCohomology_cohomologyOverField
    (k := ℂ) f F q
  let E2 : G.obj (toS.obj (SheafOfModules.unit R)) ≃+ G.obj (toS.obj Fan) :=
    (G.mapIso (toS.mapIso θ.symm)).addCommGroupIsoToAddEquiv
  let E3 : G.obj (toS.obj Fan) ≃+ Gc.obj ((SheafOfModules.toSheaf _).obj F) :=
    (asIso (comparisonMap f F (q : ℤ))).symm.addCommGroupIsoToAddEquiv
  refine ⟨(E2.trans E3).trans e, fun a x => ?_⟩
  have s2 : ∀ y, E2 (G.map (smulTop (SheafOfModules.unit R) (c a)) y) =
      G.map (smulTop Fan (c a)) (E2 y) := by
    intro y
    change G.map (toS.map θ.inv) (G.map _ y) = G.map _ (G.map (toS.map θ.inv) y)
    have h : G.map (toS.map θ.inv) ≫ G.map (smulTop Fan (c a)) =
        G.map (smulTop (SheafOfModules.unit R) (c a)) ≫ G.map (toS.map θ.inv) :=
      (G.map_comp _ _).symm.trans ((congrArg G.map (hc a)).trans (G.map_comp _ _))
    exact (ConcreteCategory.congr_hom h y).symm
  have s3 : ∀ z, E3 (G.map (smulTop Fan (c a)) z) =
      Gc.map ((SheafOfModules.toSheaf C.ringCatSheaf).map
        (Stacks.Perfect.FractionClass.smulHom (a' a) F)) (E3 z) := by
    intro z
    change inv (comparisonMap f F (q : ℤ)) (G.map _ z) =
      Gc.map _ (inv (comparisonMap f F (q : ℤ)) z)
    have h : G.map (smulTop Fan (c a)) ≫ inv (comparisonMap f F (q : ℤ)) =
        inv (comparisonMap f F (q : ℤ)) ≫
          Gc.map ((SheafOfModules.toSheaf C.ringCatSheaf).map
            (Stacks.Perfect.FractionClass.smulHom (a' a) F)) := by
      rw [IsIso.eq_inv_comp, ← Category.assoc, hnat a, Category.assoc, IsIso.hom_inv_id,
        Category.comp_id]
    exact ConcreteCategory.congr_hom h z
  change e (E3 (E2 (G.map _ x))) = a • e (E3 (E2 x))
  rw [s2, s3]
  have ha : a' a = ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ f.appLE ⊤ ⊤ (by simp)).hom a :=
    rfl
  rw [ha]
  exact he a _

/-- Degree-zero Godement cohomology is the functor of global sections. -/
noncomputable def sheafCohomologyZeroIso (T : TopCat.{0}) :
    MMP.Analytic.sheafCohomology T ((0 : ℕ) : ℤ) ≅ MMP.Analytic.globalSections T :=
  haveI := MMP.Analytic.globalSections_additive T
  haveI : Limits.PreservesFiniteLimits (MMP.Analytic.globalSections T) :=
    inferInstanceAs (Limits.PreservesFiniteLimits (sheafToPresheaf (Opens.grothendieckTopology T)
      AddCommGrpCat.{0} ⋙ (evaluation (Opens T)ᵒᵖ AddCommGrpCat.{0}).obj (op ⊤)))
  MMP.Analytic.sheafCohomologyIso T 0 ≪≫
    (MMP.Analytic.globalSections T).rightDerivedZeroIsoSelf

/-- The inverse of `sheafCohomologyZeroIso` is natural: it commutes with the maps induced by a
morphism of abelian sheaves on global sections and on degree-zero cohomology. -/
lemma sheafCohomologyZeroIso_inv_naturality (T : TopCat.{0})
    {F G : TopCat.Sheaf AddCommGrpCat.{0} T} (g : F ⟶ G)
    (x : (MMP.Analytic.globalSections T).obj F) :
    ((sheafCohomologyZeroIso T).inv.app G) ((MMP.Analytic.globalSections T).map g x) =
      (MMP.Analytic.sheafCohomology T ((0 : ℕ) : ℤ)).map g
        ((sheafCohomologyZeroIso T).inv.app F x) :=
  ConcreteCategory.congr_hom ((sheafCohomologyZeroIso T).inv.naturality g) x

/-- The value at the base point of an element of the local ring of a chart at a `ℂ`-point:
the value of a representing holomorphic germ, which is well defined because the relations of
the chart vanish at the point. -/
noncomputable def stalkEval {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} (c : Chart sX)
    (y : chart (sX := sX) c.U) : c.StalkRing (c.coords y) →+* ℂ :=
  Ideal.Quotient.lift _ (Filter.Germ.valueRingHom.comp (holGerms (c.coords y)).subtype) <| by
    intro a ha
    have hle : c.ideal.map (polyGermHom (c.coords y)) ≤
        RingHom.ker (Filter.Germ.valueRingHom.comp (holGerms (c.coords y)).subtype) := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply]
      change Filter.Germ.value ((polyGermHom (c.coords y) r).1 : Germ (𝓝 (c.coords y)) ℂ) = 0
      rw [coe_polyGermHom, Filter.Germ.value_ofFun, ← c.evalHom_pres]
      rw [show c.pres r = 0 from hr, map_zero]
    exact hle ha

/-- `stalkEval` of the class of a holomorphic germ is the value of that germ at the base point. -/
lemma stalkEval_mk {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} (c : Chart sX)
    (y : chart (sX := sX) c.U) (g : holGerms (c.coords y)) :
    stalkEval c y (Chart.StalkRing.mk c _ g) =
      Filter.Germ.value (g.1 : Germ (𝓝 (c.coords y)) ℂ) :=
  rfl

/-- The constant section `a` of `𝒪_{X^an}` has value `a` at every point. -/
lemma stalkEval_const {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} (a : ℂ)
    (x : (⊤ : Opens (space sX))) (c : {c : Chart sX // x.1 ∈ chart c.U}) :
    stalkEval c.1 ⟨x.1, c.2⟩
      ((show (structureSheaf sX).obj.obj (op ⊤) from
        (ringCatSheafHom sX).hom.app (op ⊤) (ComplexPoints.baseRingHom sX ⊤ a)).1 x c) = a := by
  change stalkEval c.1 ⟨x.1, c.2⟩ (c.1.stalkHom ⟨x.1, c.2⟩
    (X.presheaf.germ ⊤ x.1.toScheme trivial (ComplexPoints.baseRingHom sX ⊤ a))) = a
  rw [← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : c.1.U ≤ ⊤))
    x.1.toScheme (mem_chart_iff.1 c.2), ComplexPoints.baseRingHom_res, Chart.stalkHom_germ]
  have hC : ComplexPoints.baseRingHom sX c.1.U a = c.1.pres (MvPolynomial.C a) := by
    simp [Chart.pres]
  rw [hC, Chart.toStalkRing_pres, stalkEval_mk, coe_polyGermHom, Filter.Germ.value_ofFun,
    MvPolynomial.eval_C]

/-- The locally constant section of `𝒪_{X^an}` equal to `1` on a clopen set `S` and `0` off
it. -/
noncomputable def indicatorSection {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (S : Set (space sX)) (hS : IsClopen S) : (structureSheaf sX).obj.obj (op ⊤) := by
  classical
  refine ⟨fun x _ => if x.1 ∈ S then 1 else 0, ?_, ?_⟩
  · intro c x hx
    by_cases hxS : x.1 ∈ S
    · refine ⟨{y | y.1 ∈ S}, isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ ⟨S, hS.isOpen⟩, hxS,
        fun _ => 1, fun y hy => ⟨trivial, 1, rfl, ?_⟩⟩
      simp only [show y.1 ∈ S from hy, if_true, map_one]
    · refine ⟨{y | y.1 ∈ Sᶜ},
        isOpen_chart_inter ⟨c.U, c.isAffineOpen⟩ ⟨Sᶜ, hS.isClosed.isOpen_compl⟩, hxS,
        fun _ => 0, fun y hy => ⟨trivial, 0, rfl, ?_⟩⟩
      simp only [show y.1 ∉ S from hy, if_false, map_zero]
  · intro c d m x hx
    by_cases hxS : x.1 ∈ S
    · simp only [hxS, if_true]
      exact map_one _
    · simp only [hxS, if_false]
      exact map_zero _

/-- The value of `indicatorSection S hS` at a point is `1` if the point lies in `S` and `0`
otherwise. -/
lemma stalkEval_indicatorSection {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (S : Set (space sX)) (hS : IsClopen S) (x : (⊤ : Opens (space sX)))
    (c : {c : Chart sX // x.1 ∈ chart c.U}) [Decidable (x.1 ∈ S)] :
    stalkEval c.1 ⟨x.1, c.2⟩ ((indicatorSection S hS).1 x c) = if x.1 ∈ S then 1 else 0 := by
  classical
  unfold indicatorSection
  by_cases hxS : x.1 ∈ S
  · simp only [hxS, if_true]
    exact map_one _
  · simp only [hxS, if_false]
    exact map_zero _

/-- The analytification of a projective integral scheme over `ℂ` with a `ℂ`-point is
connected. -/
theorem connectedSpace_space_of_isProjective {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of ℂ)) (hproj : IsProjective sX) [IsIntegral X] (x₀ : ComplexPoints sX) :
    ConnectedSpace (space sX) := by
  classical
  haveI := hproj.isProper
  have hchart : ∀ x : space sX, ∃ c : Chart sX, x ∈ chart c.U := by
    intro x
    obtain ⟨U, hU, hxU, -⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
      (show x.toScheme ∈ (⊤ : X.Opens) from trivial)
    obtain ⟨c, rfl⟩ := Chart.exists_eq (sX := sX) hU
    exact ⟨c, mem_chart_iff.2 hxU⟩
  let R := MMP.Analytic.ringCatSheaf sX
  let Γan := (structureSheaf sX).obj.obj (op ⊤)
  let const : ℂ → Γan := fun a =>
    (ringCatSheafHom sX).hom.app (op ⊤) (ComplexPoints.baseRingHom sX ⊤ a)
  obtain ⟨E, hE⟩ := exists_addEquiv_sheafCohomology_analytification sX hproj 0
  let F := (SheafOfModules.toSheaf R).obj (SheafOfModules.unit R)
  let Z := (sheafCohomologyZeroIso (space sX)).app F
  let E0 : Γan ≃+ cohomologyOverField ℂ sX (SheafOfModules.unit X.ringCatSheaf) 0 :=
    Z.symm.addCommGroupIsoToAddEquiv.trans E
  have hE0 : ∀ a s, E0 (const a * s) = a • E0 s := by
    intro a s
    let s' : ((MMP.Analytic.globalSections (space sX)).obj F : Type) := s
    let r : R.obj.obj (op ⊤) := const a
    have h1 : (MMP.Analytic.globalSections (space sX)).map
        (smulTop (SheafOfModules.unit R) r) s' = const a * s :=
      rfl
    change E (Z.inv (const a * s)) = a • E (Z.inv s')
    rw [← h1]
    exact (congrArg E (sheafCohomologyZeroIso_inv_naturality (space sX)
      (smulTop (SheafOfModules.unit R) r) s')).trans (hE a _)
  have hfin : Module.finrank ℂ
      (cohomologyOverField ℂ sX (SheafOfModules.unit X.ringCatSheaf) 0) = 1 := by
    rw [finrank_cohomologyOverField_zero_unit_eq_finrank_globalSections]
    exact finrank_globalSections_eq_one ℂ sX
  let ev : (x : space sX) → (c : Chart sX) → x ∈ chart c.U → Γan → ℂ :=
    fun x c hc s => stalkEval c ⟨x, hc⟩ (s.1 ⟨x, trivial⟩ ⟨c, hc⟩)
  have hev_const : ∀ x c hc a, ev x c hc (const a) = a := fun x c hc a =>
    stalkEval_const a ⟨x, trivial⟩ ⟨c, hc⟩
  obtain ⟨c₀, hc₀⟩ := hchart x₀
  have h10 : E0 1 ≠ 0 := by
    intro h
    have h1 : (1 : Γan) = 0 := E0.injective (h.trans E0.map_zero.symm)
    have h2 : const 1 = const 0 := by
      rw [← mul_one (const 1), ← mul_one (const 0), h1, mul_zero, mul_zero]
    have h3 := congrArg (ev x₀ c₀ hc₀) h2
    rw [hev_const, hev_const] at h3
    exact one_ne_zero h3
  haveI : Nonempty (space sX) := ⟨x₀⟩
  rw [connectedSpace_iff_clopen]
  refine ⟨inferInstance, fun S hS => ?_⟩
  by_contra hne
  push Not at hne
  obtain ⟨x1, hx1⟩ := hne.1
  obtain ⟨x2, hx2⟩ : ∃ x, x ∉ S := by
    by_contra h
    push Not at h
    exact hne.2 (Set.eq_univ_of_forall h)
  obtain ⟨c1, hc1⟩ := hchart x1
  obtain ⟨c2, hc2⟩ := hchart x2
  obtain ⟨a, ha⟩ := (finrank_eq_one_iff_of_nonzero' (E0 1) h10).1 hfin
    (E0 (indicatorSection S hS))
  have heq : indicatorSection S hS = const a :=
    E0.injective (by rw [← ha, ← hE0, mul_one])
  have hev_ind : ∀ x c hc, ev x c hc (indicatorSection S hS) = if x ∈ S then 1 else 0 :=
    fun x c hc => stalkEval_indicatorSection S hS ⟨x, trivial⟩ ⟨c, hc⟩
  have e1 := congrArg (ev x1 c1 hc1) heq
  have e2 := congrArg (ev x2 c2 hc2) heq
  rw [hev_const, hev_ind, if_pos hx1] at e1
  rw [hev_const, hev_ind, if_neg hx2] at e2
  exact one_ne_zero (e1.trans e2.symm)

/-- `H¹(C^an, 𝒪)` of the abelian sheaf underlying the unit module, with `c ∈ ℂ` acting through
multiplication by the constant `c`, is additively isomorphic, compatibly with the scalars, to
`H¹(C, 𝒪_C)`. -/
theorem exists_addEquiv_H1_unit {C : Scheme.{0}} (f : C ⟶ Spec (.of ℂ))
    (hproj : IsProjective f) :
    ∃ E : Sheaf.H ((SheafOfModules.toSheaf (MMP.Analytic.ringCatSheaf f)).obj
        (SheafOfModules.unit (MMP.Analytic.ringCatSheaf f))) 1 ≃+
        cohomologyOverField ℂ f (SheafOfModules.unit C.ringCatSheaf) 1,
      ∀ a x, E (Sheaf.H.map (smulTop (SheafOfModules.unit (MMP.Analytic.ringCatSheaf f))
        ((ringCatSheafHom f).hom.app (op ⊤) (ComplexPoints.baseRingHom f ⊤ a))) 1 x) =
        a • E x := by
  obtain ⟨E', hE'⟩ := exists_addEquiv_sheafCohomology_analytification f hproj 1
  exact ⟨(((extIso (space f)).app _).symm.addCommGroupIsoToAddEquiv).trans E', fun a x =>
    (congrArg E' (extIso_inv_naturality (space f) _ x)).trans (hE' a _)⟩

/-- **`H¹(C^an, 𝒪)` is, compatibly with scalars, the algebraic `H¹(C, 𝒪_C)`.** For a projective
`C` over `ℂ`, the `Ext`-cohomology `H¹(C^an, 𝒪)`, with `c ∈ ℂ` acting through multiplication
`m c` by the constant `c`, is additively isomorphic, compatibly with the scalars, to the
finite-dimensional `ℂ`-vector space `H¹(C, 𝒪_C)`. -/
theorem exists_addEquiv_H1 {C : Scheme.{0}} (f : C ⟶ Spec (.of ℂ))
    (hproj : IsProjective f)
    (m : ℂ → ((sheafCompose (Opens.grothendieckTopology (space f))
      (forget₂ RingCat AddCommGrpCat)).obj (MMP.Analytic.ringCatSheaf f) ⟶
      (sheafCompose (Opens.grothendieckTopology (space f))
      (forget₂ RingCat AddCommGrpCat)).obj (MMP.Analytic.ringCatSheaf f)))
    (hm : ∀ (a : ℂ) (W : Opens (space f)) (s : (structureSheaf f).obj.obj (op W)),
        (show (structureSheaf f).obj.obj (op W) from (m a).hom.app (op W) s) =
          (show (structureSheaf f).obj.obj (op W) from
            (structureSheaf f).obj.map (homOfLE (le_top : W ≤ ⊤)).op
              (show (structureSheaf f).obj.obj (op ⊤) from
                (ringCatSheafHom f).hom.app (op ⊤) (ComplexPoints.baseRingHom f ⊤ a))) * s) :
    ∃ E : Sheaf.H ((sheafCompose (Opens.grothendieckTopology (space f))
        (forget₂ RingCat AddCommGrpCat)).obj (MMP.Analytic.ringCatSheaf f)) 1 ≃+
        cohomologyOverField ℂ f (SheafOfModules.unit C.ringCatSheaf) 1,
      ∀ a x, E (Sheaf.H.map (m a) 1 x) = a • E x := by
  obtain ⟨E, hE⟩ := exists_addEquiv_H1_unit f hproj
  refine ⟨E, fun a x => ?_⟩
  have hma : m a = smulTop (SheafOfModules.unit (MMP.Analytic.ringCatSheaf f))
      ((ringCatSheafHom f).hom.app (op ⊤) (ComplexPoints.baseRingHom f ⊤ a)) :=
    Sheaf.hom_ext (NatTrans.ext (funext fun W => AddCommGrpCat.ext fun s => hm a W.unop s))
  rw [hma]
  exact hE a x

/-- **A uniformisation of a compact group by `ℂⁿ` has a full lattice as kernel.** Let `Y` be
compact, `cls : Y → G` an injection into a group, and `Φ : ℂⁿ → Y` an open map, injective on a
neighbourhood of `0`, such that `cls ∘ Φ` is a surjective homomorphism with kernel `Λ`. Then `Λ`
is discrete, and it spans `ℂⁿ` over `ℝ`. -/
theorem lattice_of_uniformisation {n : ℕ} (Λ : Submodule ℤ (Fin n → ℂ)) {Y : Type*}
    [TopologicalSpace Y] [CompactSpace Y] {G : Type*} [Group G] (cls : Y → G)
    (hcls : Function.Injective cls) (Φ : (Fin n → ℂ) → Y) (hopen : IsOpenMap Φ)
    (hhom : ∀ v v', cls (Φ (v + v')) = cls (Φ v) * cls (Φ v'))
    (hker : ∀ v, cls (Φ v) = 1 ↔ v ∈ Λ) (hsurj : Function.Surjective (cls ∘ Φ))
    (U : Set (Fin n → ℂ)) (hU : IsOpen U) (h0 : (0 : Fin n → ℂ) ∈ U) (hinj : Set.InjOn Φ U) :
    ∃ _ : DiscreteTopology Λ, IsZLattice ℝ Λ := by
  have key : ∀ v w, Φ v = Φ w ↔ v - w ∈ Λ := by
    intro v w
    rw [← hker, ← hcls.eq_iff]
    have := hhom w (v - w)
    rw [add_sub_cancel] at this
    rw [this]
    exact mul_eq_left
  have hΦs : Function.Surjective Φ := by
    intro y
    obtain ⟨v, hv⟩ := hsurj (cls y)
    exact ⟨v, hcls hv⟩
  have hdisc : DiscreteTopology Λ := by
    refine discreteTopology_of_isOpen_singleton_zero ?_
    have : ((Subtype.val : Λ → Fin n → ℂ) ⁻¹' U) = {0} := by
      ext ⟨v, hv⟩
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hvU
        have h := (key v 0).2 (by simpa using hv)
        exact Subtype.ext (hinj hvU h0 h)
      · intro h
        obtain rfl : v = 0 := congrArg Subtype.val h
        exact h0
    rw [← this]
    exact hU.preimage continuous_subtype_val
  refine ⟨hdisc, ⟨?_⟩⟩
  by_contra hne
  obtain ⟨g, hg0, hle⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hne)
  let B : Set (Fin n → ℂ) := Metric.ball 0 1
  have hcov : (Set.univ : Set Y) ⊆ ⋃ v : Fin n → ℂ, Φ '' ((v + ·) '' B) := by
    intro y _
    obtain ⟨v, rfl⟩ := hΦs y
    exact Set.mem_iUnion.2 ⟨v, ⟨v, ⟨0, Metric.mem_ball_self one_pos, add_zero v⟩, rfl⟩⟩
  obtain ⟨T, hT⟩ := isCompact_univ.elim_finite_subcover _
    (fun v => hopen _ ((isOpenMap_add_left v) _ Metric.isOpen_ball)) hcov
  let gc := LinearMap.toContinuousLinearMap g
  obtain ⟨M, hM⟩ : ∃ M : ℝ, ∀ w, |g w| ≤ M := by
    refine ⟨∑ v ∈ T, |g v| + ‖gc‖, fun w => ?_⟩
    obtain ⟨v, hvT, hv⟩ := Set.mem_iUnion₂.1 (hT (Set.mem_univ (Φ w)))
    obtain ⟨_, ⟨b, hb, rfl⟩, hbw⟩ := hv
    have hl : w - (v + b) ∈ Λ := (key w (v + b)).1 hbw.symm
    have hgl : g (w - (v + b)) = 0 := hle (Submodule.subset_span hl)
    have hw : g w = g v + g b := by
      rw [map_sub, sub_eq_zero] at hgl
      rw [hgl, map_add]
    have hb' : |g b| ≤ ‖gc‖ := by
      have hb1 : ‖b‖ < 1 := by simpa [B] using hb
      calc |g b| = ‖gc b‖ := rfl
        _ ≤ ‖gc‖ * ‖b‖ := gc.le_opNorm b
        _ ≤ ‖gc‖ * 1 := by gcongr
        _ = ‖gc‖ := mul_one _
    have hv' : |g v| ≤ ∑ v ∈ T, |g v| :=
      Finset.single_le_sum (f := fun v => |g v|) (fun _ _ => abs_nonneg _) hvT
    rw [hw]
    exact (abs_add_le _ _).trans (add_le_add hv' hb')
  obtain ⟨w0, hw0⟩ : ∃ w0, g w0 ≠ 0 := by
    by_contra h
    exact hg0 (LinearMap.ext fun x => not_not.1 fun hx => h ⟨x, hx⟩)
  have := hM (((M + 1) / g w0) • w0)
  rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hw0] at this
  have := (le_abs_self _).trans this
  linarith

/-- **Extending a local exponential to a uniformisation.** Let `Y` be a connected space with an
injection `cls` onto a group `G`, a translation `τ t` of `Y` by each point `t` covering left
multiplication by `cls t`, and an injective homomorphism `ι : G → P` to an additive group. Let
`Φ₀` be defined near `0 ∈ ℂⁿ`, continuous and open there, with `ι (cls (Φ₀ v)) = E v` for a
homomorphism `E : ℂⁿ → P`. Then there is `Φ : ℂⁿ → Y` with `ι (cls (Φ v)) = E v`
for every `v`; it agrees with `Φ₀` near `0`,
is near every `v` a translate of `Φ₀ (· - v)` (so continuous, open and holomorphic for any notion
of holomorphy local in the source and stable under translations), is a homomorphism with kernel
`ker E`, and is surjective. -/
theorem exists_uniformisation_of_localExp {n : ℕ} {Y : Type*} [TopologicalSpace Y]
    [ConnectedSpace Y] {G : Type*} [Group G] {P : Type*} [AddCommGroup P]
    (cls : Y → G) (hcls : Function.Bijective cls) (ι : G →* Multiplicative P)
    (hι : Function.Injective ι) (E : (Fin n → ℂ) →+ P)
    (Hol : ((Fin n → ℂ) → Y) → (Fin n → ℂ) → Prop)
    (hHol_congr : ∀ F F' v, F =ᶠ[𝓝 v] F' → Hol F v → Hol F' v)
    (hHol_sub : ∀ F v w, Hol F (v - w) → Hol (fun x => F (x - w)) v)
    (τ : Y → Y → Y) (hτ : ∀ t y, cls (τ t y) = cls t * cls y) (hτc : ∀ t, Continuous (τ t))
    (hτo : ∀ t, IsOpenMap (τ t)) (hτh : ∀ t F v, Hol F v → Hol (τ t ∘ F) v)
    (Φ0 : (Fin n → ℂ) → Y) (U : Set (Fin n → ℂ)) (hU : IsOpen U) (h0 : 0 ∈ U)
    (hΦ0 : ∀ v ∈ U, ι (cls (Φ0 v)) = Multiplicative.ofAdd (E v))
    (hc : ContinuousOn Φ0 U) (ho : ∀ O ⊆ U, IsOpen O → IsOpen (Φ0 '' O))
    (hh : ∀ v ∈ U, Hol Φ0 v) :
    ∃ Φ : (Fin n → ℂ) → Y, Continuous Φ ∧ (∀ v, Hol Φ v) ∧ Set.EqOn Φ Φ0 U ∧ IsOpenMap Φ ∧
      (∀ v v', cls (Φ (v + v')) = cls (Φ v) * cls (Φ v')) ∧
      (∀ v, cls (Φ v) = 1 ↔ E v = 0) ∧ Function.Surjective (cls ∘ Φ) := by
  have hadd : ∀ w₁ w₂, (∃ y, ι (cls y) = Multiplicative.ofAdd (E w₁)) →
      (∃ y, ι (cls y) = Multiplicative.ofAdd (E w₂)) →
      ∃ y, ι (cls y) = Multiplicative.ofAdd (E (w₁ + w₂)) := by
    rintro w₁ w₂ ⟨y₁, h₁⟩ ⟨y₂, h₂⟩
    exact ⟨τ y₁ y₂, by rw [hτ, map_mul, h₁, h₂, map_add, ofAdd_add]⟩
  have hsmul : ∀ N : ℕ, ∀ u ∈ U, ∃ y, ι (cls y) = Multiplicative.ofAdd (E ((N + 1) • u)) := by
    intro N u hu
    induction N with
    | zero => exact ⟨Φ0 u, by simpa using hΦ0 u hu⟩
    | succ N ih =>
      have := hadd _ _ ih ⟨Φ0 u, hΦ0 u hu⟩
      rwa [← succ_nsmul] at this
  have key : ∀ w, ∃ y, ι (cls y) = Multiplicative.ofAdd (E w) := by
    intro w
    have ht : Tendsto (fun N : ℕ => ((N : ℂ) + 1)⁻¹ • w) atTop (𝓝 0) := by
      have h1 : Tendsto (fun N : ℕ => ((N : ℂ) + 1)⁻¹) atTop (𝓝 0) := by
        simpa [one_div] using tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℂ)
      simpa using h1.smul_const w
    obtain ⟨N, hN⟩ := (ht.eventually (hU.mem_nhds h0)).exists
    obtain ⟨y, hy⟩ := hsmul N _ hN
    refine ⟨y, ?_⟩
    rw [hy]
    congr 2
    rw [← Nat.cast_smul_eq_nsmul ℂ, smul_smul]
    push_cast
    rw [mul_inv_cancel₀ (Nat.cast_add_one_ne_zero N), one_smul]
  choose Φ hΦ using key
  have uniq : ∀ y w, ι (cls y) = Multiplicative.ofAdd (E w) → y = Φ w := fun y w h =>
    hcls.1 (hι (h.trans (hΦ w).symm))
  have hloc : ∀ v x, x - v ∈ U → Φ x = τ (Φ v) (Φ0 (x - v)) := by
    intro v x hx
    refine (uniq _ _ ?_).symm
    rw [hτ, map_mul, hΦ, hΦ0 _ hx, ← ofAdd_add, ← map_add, add_sub_cancel]
  have hev : ∀ v, ∀ᶠ x in 𝓝 v, x - v ∈ U := fun v =>
    (continuous_id.sub continuous_const).continuousAt.preimage_mem_nhds
      (by simpa using hU.mem_nhds h0)
  have hevΦ : ∀ v, (fun x => τ (Φ v) (Φ0 (x - v))) =ᶠ[𝓝 v] Φ := fun v =>
    (hev v).mono fun x hx => (hloc v x hx).symm
  have heq : Set.EqOn Φ Φ0 U := fun x hx => (uniq _ _ (hΦ0 x hx)).symm
  have hopen : IsOpenMap Φ := by
    intro O hO
    rw [isOpen_iff_forall_mem_open]
    rintro _ ⟨v, hv, rfl⟩
    let O' := U ∩ (fun u => u + v) ⁻¹' O
    have hO' : IsOpen O' := hU.inter (hO.preimage (continuous_id.add continuous_const))
    refine ⟨τ (Φ v) '' (Φ0 '' O'), ?_, hτo _ _ (ho O' Set.inter_subset_left hO'), ?_⟩
    · rintro _ ⟨_, ⟨u, hu, rfl⟩, rfl⟩
      refine ⟨u + v, hu.2, ?_⟩
      rw [hloc v (u + v) (by simpa using hu.1), add_sub_cancel_right]
    · refine ⟨Φ0 0, ⟨0, ⟨h0, by simpa using hv⟩, rfl⟩, ?_⟩
      have := hloc v v (by simpa using h0)
      rw [sub_self] at this
      exact this.symm
  refine ⟨Φ, ?_, ?_, heq, hopen, ?_, ?_, ?_⟩
  · refine continuous_iff_continuousAt.2 fun v => ContinuousAt.congr ?_ (hevΦ v)
    refine (hτc _).continuousAt.comp ?_
    refine ContinuousAt.comp (f := fun x => x - v) ?_
      (continuous_id.sub continuous_const).continuousAt
    simpa using hc.continuousAt (hU.mem_nhds h0)
  · intro v
    refine hHol_congr _ _ v (hevΦ v) ?_
    exact hτh (Φ v) (fun x => Φ0 (x - v)) v (hHol_sub Φ0 v v (by simpa using hh 0 h0))
  · intro v v'
    apply hι
    rw [map_mul, hΦ, hΦ, hΦ, map_add, ofAdd_add]
  · intro v
    rw [← hι.eq_iff, hΦ, map_one, ofAdd_eq_one]
  · have hsurj : Function.Surjective Φ := by
      have hop : IsOpen (Set.range Φ) := hopen.isOpen_range
      have hcl : IsClosed (Set.range Φ) := by
        rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
        intro y hy
        refine ⟨τ y '' Set.range Φ, ?_, hτo y _ hop, ?_⟩
        · rintro _ ⟨_, ⟨v, rfl⟩, hyv⟩ ⟨w, hw⟩
          apply hy
          refine ⟨w - v, (uniq _ _ ?_).symm⟩
          have h := congrArg (fun z => ι (cls z)) (hw.trans hyv.symm)
          simp only [hτ, map_mul, hΦ] at h
          rw [map_sub, ofAdd_sub, h, mul_div_cancel_right]
        · refine ⟨Φ 0, ⟨0, rfl⟩, hcls.1 ?_⟩
          rw [hτ]
          rw [show cls (Φ 0) = 1 from hι (by rw [hΦ, map_zero, ofAdd_zero, map_one]), mul_one]
      exact Set.eq_univ_iff_forall.mp (IsClopen.eq_univ ⟨hcl, hop⟩ ⟨Φ 0, 0, rfl⟩)
    exact hcls.2.comp hsurj

/-- A map `F : ℂᵐ → X(ℂ)` is *holomorphic at `v`* when in every affine chart of `X` containing
`F v` the coordinates of `F` agree near `v` with those of a map complex differentiable at `v`. -/
def ChartHolomorphicAt {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {m : ℕ}
    (F : (Fin m → ℂ) → space sX) (v : Fin m → ℂ) : Prop :=
  ∀ (c : Chart sX) (_ : F v ∈ ComplexPoints.chart c.U),
    ∃ G : (Fin m → ℂ) → (Fin c.n → ℂ), DifferentiableAt ℂ G v ∧
      ∀ᶠ v' in 𝓝 v, ∃ h' : F v' ∈ ComplexPoints.chart c.U, c.coords ⟨F v', h'⟩ = G v'

/-- Holomorphy in charts at `v` depends only on the germ of the map at `v`. -/
lemma ChartHolomorphicAt.congr {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {m : ℕ}
    {F F' : (Fin m → ℂ) → space sX} {v : Fin m → ℂ} (h : F =ᶠ[𝓝 v] F')
    (hF : ChartHolomorphicAt F v) : ChartHolomorphicAt F' v := by
  intro c hv
  obtain ⟨G, hG, hev⟩ := hF c (h.eq_of_nhds ▸ hv)
  refine ⟨G, hG, (hev.and h).mono fun v' ⟨⟨h', e⟩, he⟩ => ⟨he ▸ h', ?_⟩⟩
  rw [← e]
  congr 2
  exact he.symm

/-- If `F` is holomorphic in charts at `v - w`, then `x ↦ F (x - w)` is holomorphic in charts
at `v`. -/
lemma ChartHolomorphicAt.comp_sub {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {m : ℕ}
    {F : (Fin m → ℂ) → space sX} {v w : Fin m → ℂ} (hF : ChartHolomorphicAt F (v - w)) :
    ChartHolomorphicAt (fun x => F (x - w)) v := by
  intro c hv
  obtain ⟨G, hG, hev⟩ := hF c hv
  refine ⟨fun x => G (x - w), hG.comp v ((differentiableAt_id).sub_const w), ?_⟩
  have ht : Tendsto (fun x : Fin m → ℂ => x - w) (𝓝 v) (𝓝 (v - w)) :=
    (continuous_id.sub continuous_const).tendsto v
  exact ht.eventually hev

/-- Evaluating a section at the image of a point under a realized morphism is evaluating its
pullback at the point. -/
lemma evalHom_realize {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} (g : X ⟶ Y) (hg : g ≫ sY = sX) (U : Y.Opens) (s : Γ(Y, U))
    (y : ComplexPoints sX) (h1 : realize g hg y ∈ chart U) (h2 : y ∈ chart (g ⁻¹ᵁ U)) :
    evalHom U ⟨realize g hg y, h1⟩ s = evalHom (g ⁻¹ᵁ U) ⟨y, h2⟩ (g.app U s) := by
  simp only [evalHom, RingHom.coe_comp, Function.comp_apply]
  congr 1

/-- **Realized morphisms are rational in charts.** Let `g : X ⟶ Y` be a morphism over `ℂ`, `d`
a chart of `X` at `x` and `c` a chart of `Y` at `g(x)`. There are a polynomial `Q` in the
coordinates of `d`, not vanishing at `x`, and a map `R`, complex differentiable off the zeros of
`Q`, such that at every point `y` of `d` with `Q(y) ≠ 0` the point `g(y)` lies in `c` with
coordinates `R` of those of `y`. -/
theorem exists_rational_coords_realize {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] (g : X ⟶ Y) (hg : g ≫ sY = sX)
    (d : Chart sX) (c : Chart sY) (x : ComplexPoints sX) (hx : x ∈ chart d.U)
    (hgx : realize g hg x ∈ chart c.U) :
    ∃ (R : (Fin d.n → ℂ) → (Fin c.n → ℂ)) (Q : MvPolynomial (Fin d.n) ℂ),
      MvPolynomial.eval (d.coords ⟨x, hx⟩) Q ≠ 0 ∧
      (∀ z, MvPolynomial.eval z Q ≠ 0 → DifferentiableAt ℂ R z) ∧
      ∀ (y : ComplexPoints sX) (hy : y ∈ chart d.U),
        MvPolynomial.eval (d.coords ⟨y, hy⟩) Q ≠ 0 →
        ∃ h' : realize g hg y ∈ chart c.U,
          c.coords ⟨realize g hg y, h'⟩ = R (d.coords ⟨y, hy⟩) := by
  have hxd : x.toScheme ∈ d.U := mem_chart_iff.1 hx
  have hxV : x.toScheme ∈ g ⁻¹ᵁ c.U := mem_chart_iff.1 hgx
  obtain ⟨f, e, he, hle, hxf⟩ := Chart.exists_basicOpen d.isAffineOpen x hxd hxV
  have hed : e.U ≤ d.U := he ▸ X.basicOpen_le f
  have heV : e.U ≤ g ⁻¹ᵁ c.U := he ▸ hle
  obtain ⟨-, ⟨K, a, ha⟩, -⟩ := (ChartHom.ofLE d e hed).exists_localization_data he
  obtain ⟨Fp, hFp⟩ : ∃ q, d.pres q = f := d.surjective f
  choose A hA using fun j => (d.surjective (a j) : ∃ q, d.pres q = a j)
  choose r hr using fun i => (e.surjective
    (X.presheaf.map (homOfLE heV).op (g.app c.U (c.gen i))) : ∃ q, e.pres q = _)
  let D : (Fin d.n → ℂ) → (Fin e.n → ℂ) := fun z j =>
    MvPolynomial.eval z (A j) / MvPolynomial.eval z Fp ^ K
  have hevf : ∀ (y : ComplexPoints sX) (hy : y ∈ chart d.U),
      evalHom d.U ⟨y, hy⟩ f = MvPolynomial.eval (d.coords ⟨y, hy⟩) Fp := by
    intro y hy
    rw [← hFp]
    exact d.evalHom_pres _ _
  refine ⟨fun z i => MvPolynomial.eval (D z) (r i), Fp, ?_, ?_, ?_⟩
  · rw [← hevf]
    exact (toScheme_mem_basicOpen_iff ⟨x, hx⟩ f).1 hxf
  · intro z hz
    refine differentiableAt_pi.2 fun i => ?_
    have hD : DifferentiableAt ℂ D z := by
      refine differentiableAt_pi.2 fun j => ?_
      have h1 : DifferentiableAt ℂ (fun z => MvPolynomial.eval z (A j)) z :=
        differentiable_eval_mvPolynomial (A j) z
      have h2 : DifferentiableAt ℂ (fun z => MvPolynomial.eval z Fp ^ K) z :=
        (differentiable_eval_mvPolynomial Fp z).pow K
      simp only [D, div_eq_mul_inv]
      exact h1.fun_mul (h2.fun_inv (pow_ne_zero K hz))
    exact (differentiable_eval_mvPolynomial (r i) (D z)).comp z hD
  · intro y hy hQ
    have hyf : y.toScheme ∈ X.basicOpen f :=
      (toScheme_mem_basicOpen_iff ⟨y, hy⟩ f).2 (by rw [hevf]; exact hQ)
    have hye : y ∈ chart e.U := mem_chart_iff.2 (he ▸ hyf)
    have hyV : y.toScheme ∈ g ⁻¹ᵁ c.U := heV (mem_chart_iff.1 hye)
    refine ⟨mem_chart_iff.2 hyV, funext fun i => ?_⟩
    have hcoords : e.coords ⟨y, hye⟩ = D (d.coords ⟨y, hy⟩) := by
      funext j
      have h := congrArg (evalHom e.U ⟨y, hye⟩) (ha j)
      have e1 : evalHom e.U ⟨y, hye⟩ (X.presheaf.map (homOfLE hed).op (a j)) =
          MvPolynomial.eval (d.coords ⟨y, hy⟩) (A j) := by
        rw [← evalHom_res hed ⟨y, hye⟩, ← hA j]
        exact d.evalHom_pres _ _
      have e2 : evalHom e.U ⟨y, hye⟩ (X.presheaf.map (homOfLE hed).op f) =
          MvPolynomial.eval (d.coords ⟨y, hy⟩) Fp := by
        rw [← evalHom_res hed ⟨y, hye⟩, ← hFp]
        exact d.evalHom_pres _ _
      rw [map_mul, map_pow, e1, e2] at h
      exact eq_div_of_mul_eq (pow_ne_zero _ hQ) (by rw [mul_comm]; exact h.symm)
    change evalHom c.U _ (c.gen i) = _
    rw [evalHom_realize g hg c.U _ y _ (mem_chart_iff.2 hyV)]
    refine (evalHom_res heV ⟨y, hye⟩ _).trans ?_
    rw [← hr i]
    refine (e.evalHom_pres ⟨y, hye⟩ (r i)).trans ?_
    rw [hcoords]

/-- Composing with a realized morphism preserves holomorphy in charts. -/
lemma ChartHolomorphicAt.realize {X Y : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    {sY : Y ⟶ Spec (.of ℂ)} [LocallyOfFiniteType sX] (g : X ⟶ Y) (hg : g ≫ sY = sX) {m : ℕ}
    {F : (Fin m → ℂ) → space sX} {v : Fin m → ℂ} (hF : ChartHolomorphicAt F v) :
    ChartHolomorphicAt (sX := sY) (ComplexPoints.realize g hg ∘ F) v := by
  intro c hv
  obtain ⟨U, hU, hxU, -⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show (F v).toScheme ∈ (⊤ : X.Opens) from trivial)
  obtain ⟨d, rfl⟩ := Chart.exists_eq (sX := sX) hU
  have hx : F v ∈ chart d.U := mem_chart_iff.2 hxU
  obtain ⟨G, hG, hev⟩ := hF d hx
  obtain ⟨R, Q, hQ, hRd, hR⟩ := exists_rational_coords_realize g hg d c (F v) hx hv
  obtain ⟨h0, e0⟩ := hev.self_of_nhds
  have hQG : MvPolynomial.eval (G v) Q ≠ 0 := by rw [← e0]; exact hQ
  have hne : ∀ᶠ v' in 𝓝 v, MvPolynomial.eval (G v') Q ≠ 0 :=
    ((differentiable_eval_mvPolynomial Q).continuous.continuousAt.comp
      hG.continuousAt).eventually_ne hQG
  refine ⟨R ∘ G, (hRd (G v) hQG).comp v hG, ?_⟩
  filter_upwards [hev, hne] with v' ⟨h', e⟩ hq
  obtain ⟨h'', e'⟩ := hR (F v') h' (by rw [e]; exact hq)
  exact ⟨h'', e'.trans (by rw [e]; rfl)⟩

/-- **Regular functions are holomorphic in polynomial charts.** A regular function `f` on a
Zariski open `U'` is, near a point `y` of a chart `d`, a function of the coordinates of `d`
complex differentiable at those of `y`. -/
lemma exists_differentiableAt_eval_eq {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] (d : Chart sX) (U' : X.Opens) (f : Γ(X, U'))
    (y : ComplexPoints sX) (hy : y ∈ chart d.U) (hyU : y ∈ chart U') :
    ∃ G : (Fin d.n → ℂ) → ℂ, DifferentiableAt ℂ G (d.coords ⟨y, hy⟩) ∧
      ∀ᶠ y' in 𝓝 y, ∀ (hy' : y' ∈ chart d.U) (hyU' : y' ∈ chart U'),
        eval U' f ⟨y', hyU'⟩ = G (d.coords ⟨y', hy'⟩) := by
  obtain ⟨W, hW, hyW, hWU⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show y.toScheme ∈ U' from mem_chart_iff.1 hyU)
  obtain ⟨e, rfl⟩ := Chart.exists_eq (sX := sX) hW
  have hyW' : y ∈ chart e.U := mem_chart_iff.2 hyW
  obtain ⟨R, Q, hQ, hRd, hR⟩ := exists_rational_coords_realize (𝟙 X) (Category.id_comp sX) d e y
    hy ((congrFun ComplexPoints.realize_id y).symm ▸ hyW')
  obtain ⟨q, hq⟩ := e.surjective (X.presheaf.map (homOfLE hWU).op f)
  refine ⟨fun w => MvPolynomial.eval (R w) q,
    (differentiable_eval_mvPolynomial q (R _)).comp _ (hRd _ hQ), ?_⟩
  have hyB : y ∈ chart (X.basicOpen (d.pres Q)) := by
    refine mem_chart_iff.2 ((toScheme_mem_basicOpen_iff ⟨y, hy⟩ _).2 ?_)
    rw [d.evalHom_pres]; exact hQ
  filter_upwards [(isOpen_chart sX _).mem_nhds hyB, (isOpen_chart sX _).mem_nhds hyW'] with
    y' h1 h2 hy' hyU'
  have hQ' : MvPolynomial.eval (d.coords ⟨y', hy'⟩) Q ≠ 0 := by
    rw [← d.evalHom_pres]; exact (toScheme_mem_basicOpen_iff ⟨y', hy'⟩ _).1 (mem_chart_iff.1 h1)
  obtain ⟨h', e'⟩ := hR y' hy' hQ'
  have key : ∀ (z : ComplexPoints sX) (hz : z = y') (hz' : z ∈ chart e.U),
      e.coords ⟨z, hz'⟩ = e.coords ⟨y', h2⟩ := by
    rintro _ rfl _; rfl
  calc eval U' f ⟨y', hyU'⟩ = evalHom U' ⟨y', hyU'⟩ f := rfl
    _ = evalHom e.U ⟨y', h2⟩ (X.presheaf.map (homOfLE hWU).op f) := evalHom_res hWU ⟨y', h2⟩ f
    _ = MvPolynomial.eval (e.coords ⟨y', h2⟩) q := by rw [← hq]; exact e.evalHom_pres _ q
    _ = _ := by rw [← key _ (congrFun ComplexPoints.realize_id y') h', e']

/-- **An injective `C¹` self-map of a finite-dimensional space has an invertible derivative
somewhere.** An injective `C¹` self-map of an open set of a finite-dimensional space has a
bijective derivative at some point of the set. -/
theorem exists_bijective_fderiv_of_injOn {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [FiniteDimensional ℂ E] {f : E → E} {O : Set E} (hO : IsOpen O)
    (hne : O.Nonempty) (hf : ContDiffOn ℂ 1 f O) (hinj : Set.InjOn f O) :
    ∃ p ∈ O, Function.Bijective (fderiv ℂ f p) := by
  classical
  let rk : E → ℕ := fun p => Module.finrank ℂ (LinearMap.range (fderiv ℂ f p : E →ₗ[ℂ] E))
  have hbdd : BddAbove (rk '' O) :=
    ⟨Module.finrank ℂ E, by rintro _ ⟨q, -, rfl⟩; exact Submodule.finrank_le _⟩
  obtain ⟨p, hp, hpm⟩ := Nat.sSup_mem (hne.image rk) hbdd
  have hmax : ∀ q ∈ O, rk q ≤ rk p := fun q hq => hpm ▸ le_csSup hbdd ⟨q, hq, rfl⟩
  refine ⟨p, hp, ?_⟩
  set D := fderiv ℂ f p
  by_cases hfull : rk p = Module.finrank ℂ E
  · have hsurj : Function.Surjective D :=
      LinearMap.range_eq_top.1 (Submodule.eq_top_of_finrank_eq hfull)
    exact ⟨(LinearMap.injective_iff_surjective (f := (D : E →ₗ[ℂ] E))).2 hsurj, hsurj⟩
  exfalso
  have hlt : rk p < Module.finrank ℂ E := lt_of_le_of_ne (Submodule.finrank_le _) hfull
  set K := LinearMap.range (D : E →ₗ[ℂ] E)
  obtain ⟨K', hKK'⟩ := Submodule.exists_isCompl K
  let π : E →L[ℂ] K := LinearMap.toContinuousLinearMap (K.projectionOnto K' hKK')
  have hπK : ∀ x : K, π x = x := fun x => Submodule.projectionOnto_apply_left hKK' x
  set N := LinearMap.ker (D : E →ₗ[ℂ] E) with hN
  obtain ⟨N', hNN'⟩ := Submodule.exists_isCompl N
  let P : E →L[ℂ] N := LinearMap.toContinuousLinearMap (N.projectionOnto N' hNN')
  have hPN : ∀ x : N, P x = x := fun x => Submodule.projectionOnto_apply_left hNN' x
  let g : E → K := fun x => π (f x)
  let Φ : E → K × N := fun x => (g x, P x)
  let Φ' : E → (E →L[ℂ] K × N) := fun q => (π.comp (fderiv ℂ f q)).prod P
  let Inv : Set (E →L[ℂ] K × N) :=
    Set.range (ContinuousLinearEquiv.toContinuousLinearMap : (E ≃L[ℂ] K × N) → E →L[ℂ] K × N)
  have hdiff : ∀ q ∈ O, HasFDerivAt f (fderiv ℂ f q) q := fun q hq =>
    ((hf.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds hq)).hasFDerivAt
  have hΦd : ∀ q ∈ O, HasFDerivAt Φ (Φ' q) q := fun q hq =>
    (π.hasFDerivAt.comp q (hdiff q hq)).prodMk P.hasFDerivAt
  have hinjp : Function.Injective (Φ' p) := by
    intro v w hvw'
    have hvw : Φ' p (v - w) = 0 := by rw [map_sub, hvw', sub_self]
    rw [← sub_eq_zero]
    set u := v - w
    have h1 : π (D u) = 0 := congrArg Prod.fst hvw
    have h2 : P u = 0 := congrArg Prod.snd hvw
    have hDu : D u = 0 := by
      have := hπK ⟨D u, LinearMap.mem_range_self _ u⟩
      rw [h1] at this
      exact (congrArg Subtype.val this).symm
    have := hPN ⟨u, hDu⟩
    rw [h2] at this
    exact (congrArg Subtype.val this).symm
  have hdimKN : Module.finrank ℂ E = Module.finrank ℂ (K × N) := by
    rw [Module.finrank_prod]
    exact (LinearMap.finrank_range_add_finrank_ker (D : E →ₗ[ℂ] E)).symm
  have hbijp : Function.Bijective (Φ' p) :=
    ⟨hinjp, (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdimKN
      (f := (Φ' p : E →ₗ[ℂ] K × N))).1 hinjp⟩
  let A : E ≃L[ℂ] K × N :=
    (LinearEquiv.ofBijective (Φ' p : E →ₗ[ℂ] K × N) hbijp).toContinuousLinearEquiv
  have hA : (A : E →L[ℂ] K × N) = Φ' p := ContinuousLinearMap.ext fun v => rfl
  have hΦC : ContDiffAt ℂ 1 Φ p :=
    (π.contDiff.contDiffAt.comp p (hf.contDiffAt (hO.mem_nhds hp))).prodMk P.contDiff.contDiffAt
  have hstrict : HasStrictFDerivAt Φ (A : E →L[ℂ] K × N) p := by
    rw [hA, ← (hΦd p hp).fderiv]
    exact hΦC.hasStrictFDerivAt one_ne_zero
  let H := hstrict.toOpenPartialHomeomorph Φ
  have hHΦ : ∀ x, H x = Φ x := fun x => rfl
  have hpH : p ∈ H.source := hstrict.mem_toOpenPartialHomeomorph_source
  have hΦ'cont : ContinuousAt Φ' p := by
    have hc : ContinuousAt (fderiv ℂ f) p :=
      (hf.continuousOn_fderiv_of_isOpen hO le_rfl).continuousAt (hO.mem_nhds hp)
    have hΦ'eq : Φ' = fun q => ContinuousLinearMap.prodₗᵢ ℂ
        ((ContinuousLinearMap.compL ℂ E E K π) (fderiv ℂ f q), P) := rfl
    rw [hΦ'eq]
    exact (ContinuousLinearMap.prodₗᵢ ℂ).continuous.continuousAt.comp
      (((ContinuousLinearMap.compL ℂ E E K π).continuous.continuousAt.comp hc).prodMk
        continuousAt_const)
  have hgood : ∀ᶠ q in 𝓝 p, q ∈ O ∧ q ∈ H.source ∧ Φ' q ∈ Inv := by
    filter_upwards [hO.mem_nhds hp, H.open_source.mem_nhds hpH,
      hΦ'cont.preimage_mem_nhds (ContinuousLinearEquiv.isOpen.mem_nhds ⟨A, hA⟩)] with q h1 h2 h3
    exact ⟨h1, h2, h3⟩
  have hker : ∀ q ∈ O, Φ' q ∈ Inv →
      ∀ v, π (fderiv ℂ f q v) = 0 → fderiv ℂ f q v = 0 := by
    intro q hq ⟨B, hB⟩ v hv
    have hsurjg : Function.Surjective (π.comp (fderiv ℂ f q)) := by
      intro k
      obtain ⟨u, hu⟩ := B.surjective (k, 0)
      exact ⟨u, congrArg Prod.fst (show (Φ' q) u = (k, 0) by rw [← hB]; exact hu)⟩
    let gq : E →ₗ[ℂ] K := (π.comp (fderiv ℂ f q) : E →L[ℂ] K)
    let fq : E →ₗ[ℂ] E := (fderiv ℂ f q : E →L[ℂ] E)
    have hrg : Module.finrank ℂ (LinearMap.range gq) = Module.finrank ℂ K := by
      rw [LinearMap.range_eq_top.2 hsurjg, finrank_top]
    have hle : LinearMap.ker fq ≤ LinearMap.ker gq := fun x hx => by
      simp only [LinearMap.mem_ker] at hx ⊢
      change π (fq x) = 0
      rw [hx, map_zero]
    have hrf : Module.finrank ℂ (LinearMap.range fq) = Module.finrank ℂ K := by
      refine le_antisymm (hmax q hq) ?_
      rw [← hrg]
      have : LinearMap.range gq = (LinearMap.range fq).map (π : E →ₗ[ℂ] K) := by
        rw [show gq = (π : E →ₗ[ℂ] K).comp fq from rfl, LinearMap.range_comp]
      rw [this]
      exact Submodule.finrank_map_le _ _
    have heq : LinearMap.ker fq = LinearMap.ker gq := by
      refine Submodule.eq_of_le_of_finrank_eq hle ?_
      have e1 := LinearMap.finrank_range_add_finrank_ker fq
      have e2 := LinearMap.finrank_range_add_finrank_ker gq
      omega
    have : v ∈ LinearMap.ker gq := hv
    rw [← heq] at this
    exact this
  obtain ⟨k₀, hk₀⟩ : ∃ k₀ : N, k₀ ≠ 0 := by
    have : 0 < Module.finrank ℂ N := by
      have e := LinearMap.finrank_range_add_finrank_ker (D : E →ₗ[ℂ] E)
      have e2 : Module.finrank ℂ (LinearMap.range (D : E →ₗ[ℂ] E)) = rk p := rfl
      rw [hN]
      omega
    exact Module.finrank_pos_iff_exists_ne_zero.1 this
  let ℓ : N → K × N := fun k => (g p, P p + k)
  have hℓc : Continuous ℓ := continuous_const.prodMk (continuous_const.add continuous_id)
  let h : N → E := fun k => H.symm (ℓ k)
  have hℓ0 : ℓ 0 = Φ p := by simp [ℓ, Φ]
  have htgt : ∀ᶠ k in 𝓝 (0 : N), ℓ k ∈ H.target :=
    hℓc.continuousAt.preimage_mem_nhds
      (by rw [hℓ0]; exact H.open_target.mem_nhds (H.map_source hpH))
  have hh0 : h 0 = p := by
    change H.symm (ℓ 0) = p
    rw [hℓ0, ← hHΦ]
    exact H.left_inv hpH
  have hhc : ContinuousAt h 0 :=
    (H.continuousAt_symm (by rw [hℓ0]; exact H.map_source hpH)).comp hℓc.continuousAt
  have hev : ∀ᶠ k in 𝓝 (0 : N), ℓ k ∈ H.target ∧ (h k ∈ O ∧ h k ∈ H.source ∧
      Φ' (h k) ∈ Inv) :=
    htgt.and ((show Tendsto h (𝓝 0) (𝓝 p) from hh0 ▸ hhc).eventually hgood)
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff_ball.1 hev
  have hgh : ∀ k ∈ Metric.ball (0 : N) ε, g (h k) = g p := by
    intro k hk
    have h1 : Φ (h k) = ℓ k := H.right_inv (hball k hk).1
    have h2 : (Φ (h k)).1 = (ℓ k).1 := congrArg Prod.fst h1
    exact h2
  have hhd : ∀ k ∈ Metric.ball (0 : N) ε, ∃ h' : N →L[ℂ] E, HasFDerivAt h h' k ∧
      ∀ v, π (fderiv ℂ f (h k) (h' v)) = 0 := by
    intro k hk
    obtain ⟨htk, hO', hsrc, B, hB⟩ := hball k hk
    have hB0 : (B : E →L[ℂ] K × N) = Φ' (h k) := hB
    have hB' : HasFDerivAt Φ (B : E →L[ℂ] K × N) (H.symm (ℓ k)) := by
      rw [hB0]; exact hΦd _ hO'
    have hsymm : HasFDerivAt H.symm (B.symm : K × N →L[ℂ] E) (ℓ k) :=
      HasFDerivAt.of_local_left_inverse (H.continuousAt_symm htk) hB'
        (Filter.eventually_of_mem (H.open_target.mem_nhds htk) fun y hy => H.right_inv hy)
    have hℓd : HasFDerivAt ℓ ((0 : N →L[ℂ] K).prod (ContinuousLinearMap.id ℂ N)) k :=
      (hasFDerivAt_const _ _).prodMk ((hasFDerivAt_id k).const_add _)
    refine ⟨_, hsymm.comp k hℓd, fun v => ?_⟩
    have hconst : (fun k' => g (h k')) =ᶠ[𝓝 k] fun _ => g p :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hk) hgh
    have hgd : HasFDerivAt (fun k' => g (h k'))
        ((π.comp (fderiv ℂ f (h k))).comp ((B.symm : K × N →L[ℂ] E).comp
          ((0 : N →L[ℂ] K).prod (ContinuousLinearMap.id ℂ N)))) k :=
      (π.hasFDerivAt.comp _ (hdiff _ hO')).comp k (hsymm.comp k hℓd)
    have h0 := (hgd.congr_of_eventuallyEq hconst.symm).unique (hasFDerivAt_const (g p) k)
    exact congrArg (fun T => T v) h0
  have hfh : ∀ k ∈ Metric.ball (0 : N) ε, f (h k) = f (h 0) := by
    intro k hk
    have hdo : DifferentiableOn ℂ (fun k' => f (h k')) (Metric.ball (0 : N) ε) := by
      intro k' hk'
      obtain ⟨h', hh', -⟩ := hhd k' hk'
      exact ((hdiff _ (hball k' hk').2.1).comp k' hh').differentiableAt.differentiableWithinAt
    refine IsOpen.is_const_of_fderiv_eq_zero Metric.isOpen_ball (convex_ball _ _).isPreconnected
      hdo ?_ hk (Metric.mem_ball_self hε)
    intro k' hk'
    obtain ⟨h', hh', hv⟩ := hhd k' hk'
    have hO' := (hball k' hk').2
    rw [show (fun k' => f (h k')) = f ∘ h from rfl, ((hdiff _ hO'.1).comp k' hh').fderiv,
      Pi.zero_apply]
    ext1 v
    exact hker _ hO'.1 hO'.2.2 _ (hv v)
  obtain ⟨t, ht0, htε⟩ : ∃ t : ℝ, t ≠ 0 ∧ (t : ℂ) • k₀ ∈ Metric.ball (0 : N) ε := by
    have : 0 < ‖k₀‖ := norm_pos_iff.2 hk₀
    refine ⟨ε / (2 * ‖k₀‖), by positivity, ?_⟩
    rw [Metric.mem_ball, dist_zero_right, norm_smul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (by positivity)]
    field_simp
    linarith
  have hne' : h ((t : ℂ) • k₀) ≠ h 0 := by
    intro heq
    have h1 := H.right_inv (hball _ htε).1
    have h2 := H.right_inv (hball _ (Metric.mem_ball_self hε)).1
    change H (h _) = ℓ _ at h1 h2
    rw [heq, h2] at h1
    have := congrArg Prod.snd h1
    simp only [ℓ, add_zero, left_eq_add] at this
    exact smul_ne_zero (by exact_mod_cast ht0) hk₀ this
  exact hne' (hinj (hball _ htε).2.1 (hball _ (Metric.mem_ball_self hε)).2.1 (hfh _ htε))

/-- **The inverse function theorem in an étale chart.** Let `c` be an étale coordinate chart of
`X^an` and `L` a map, `C¹` on an open `O ⊆ ℂⁿ`, whose derivative at the coordinates of `y₀ ∈ W`
is invertible. Then `L ∘ c` is, near `y₀`, a biholomorphism onto an open `U ⊆ ℂⁿ`: its inverse
`Φ₀` is continuous, open and holomorphic in every polynomial chart, and `L ∘ c` itself is
holomorphic in every polynomial chart on the image `V` of `Φ₀`. -/
theorem exists_localInverse_of_fderiv {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    [LocallyOfFiniteType sX] [SmoothOfRelativeDimension n sX] (c : EtaleCoordinateChart sX n)
    (L : (Fin n → ℂ) → (Fin n → ℂ)) (O : Set (Fin n → ℂ)) (hO : IsOpen O)
    (hLd : ContDiffOn ℂ 1 L O) (y₀ : ComplexPoints sX) (hy₀ : y₀ ∈ c.W)
    (hp : c.toOpenPartialHomeomorph y₀ ∈ O) (D : (Fin n → ℂ) ≃L[ℂ] (Fin n → ℂ))
    (hD : fderiv ℂ L (c.toOpenPartialHomeomorph y₀) = D) :
    ∃ (Φ0 : (Fin n → ℂ) → space sX) (U : Set (Fin n → ℂ)), IsOpen U ∧
      L (c.toOpenPartialHomeomorph y₀) ∈ U ∧
      (∀ v ∈ U, Φ0 v ∈ c.W ∧ c.toOpenPartialHomeomorph (Φ0 v) ∈ O ∧
        L (c.toOpenPartialHomeomorph (Φ0 v)) = v) ∧
      ContinuousOn Φ0 U ∧ (∀ O' ⊆ U, IsOpen O' → IsOpen (Φ0 '' O')) ∧
      (∀ v ∈ U, ChartHolomorphicAt Φ0 v) ∧
      ∃ V : Opens (space sX), Set.BijOn Φ0 U V ∧
        Set.LeftInvOn (fun y => L (c.toOpenPartialHomeomorph y)) Φ0 U ∧
        ∀ (y : space sX) (_ : y ∈ V) (c' : Chart sX) (hy : y ∈ ComplexPoints.chart c'.U),
          ∃ G : (Fin c'.n → ℂ) → (Fin n → ℂ), DifferentiableAt ℂ G (c'.coords ⟨y, hy⟩) ∧
            ∀ᶠ y' in 𝓝 y, ∀ hy' : y' ∈ ComplexPoints.chart c'.U, y' ∈ V →
              L (c.toOpenPartialHomeomorph y') = G (c'.coords ⟨y', hy'⟩) := by
  set φ := c.toOpenPartialHomeomorph
  set p := φ y₀
  have hφp : p ∈ φ.target := φ.map_source (by simpa [φ] using hy₀)
  let Wset := (O ∩ fderiv ℂ L ⁻¹' Set.range ContinuousLinearEquiv.toContinuousLinearMap) ∩
    φ.target
  have hWo : IsOpen Wset :=
    ((hLd.continuousOn_fderiv_of_isOpen hO le_rfl).isOpen_inter_preimage hO
      ContinuousLinearEquiv.isOpen).inter φ.open_target
  have hpW : p ∈ Wset := ⟨⟨hp, D, hD.symm⟩, hφp⟩
  have hstrict : HasStrictFDerivAt L (D : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) p := by
    rw [← hD]; exact (hLd.contDiffAt (hO.mem_nhds hp)).hasStrictFDerivAt one_ne_zero
  let H := (hstrict.toOpenPartialHomeomorph L).restrOpen Wset hWo
  have hHL : ∀ w, H w = L w := fun w => rfl
  have hsrc : ∀ w ∈ H.source, w ∈ Wset := fun w hw => hw.2
  have hpH : p ∈ H.source := ⟨hstrict.mem_toOpenPartialHomeomorph_source, hpW⟩
  let Φ0 : (Fin n → ℂ) → space sX := fun v => φ.symm (H.symm v)
  have hΦW : ∀ v ∈ H.target, Φ0 v ∈ c.W := fun v hv =>
    c.toOpenPartialHomeomorph_symm_mem (hsrc _ (H.map_target hv)).2
  have hφΦ : ∀ v ∈ H.target, φ (Φ0 v) = H.symm v := fun v hv =>
    φ.right_inv (hsrc _ (H.map_target hv)).2
  have hΦL : ∀ v ∈ H.target, L (φ (Φ0 v)) = v := fun v hv => by
    rw [hφΦ v hv, ← hHL]; exact H.right_inv hv
  have hcont : ContinuousOn Φ0 H.target :=
    φ.continuousOn_symm.comp H.continuousOn_symm fun v hv => (hsrc _ (H.map_target hv)).2
  have hderiv : ∀ v ∈ H.target, DifferentiableAt ℂ H.symm v := by
    intro v hv
    obtain ⟨⟨hwO, Dw, hDw⟩, -⟩ := hsrc _ (H.map_target hv)
    have hL : HasFDerivAt L (Dw : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) (H.symm v) := by
      rw [hDw]
      exact ((hLd.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds hwO)).hasFDerivAt
    exact (HasFDerivAt.of_local_left_inverse (H.continuousAt_symm hv) hL
      (Filter.eventually_of_mem (H.open_target.mem_nhds hv) fun y hy =>
        H.right_inv hy)).differentiableAt
  let V : Opens (space sX) :=
    ⟨Φ0 '' H.target, by
      rw [← Set.image_image]
      exact φ.symm.isOpen_image_of_subset_source
        (H.symm.isOpen_image_of_subset_source H.open_target (by simp))
        (by rintro _ ⟨v, hv, rfl⟩; exact (hsrc _ (H.map_target hv)).2)⟩
  have hleft : Set.LeftInvOn (fun y => L (φ y)) Φ0 H.target := fun v hv => hΦL v hv
  refine ⟨Φ0, H.target, H.open_target, H.map_source hpH,
    fun v hv => ⟨hΦW v hv, by rw [hφΦ v hv]; exact (hsrc _ (H.map_target hv)).1.1, hΦL v hv⟩,
    hcont, ?_, ?_, V, ⟨fun v hv => ⟨v, hv, rfl⟩, hleft.injOn, fun _ hy => hy⟩, hleft, ?_⟩
  · intro O' hO'U hO'
    rw [← Set.image_image]
    exact φ.symm.isOpen_image_of_subset_source
      (H.symm.isOpen_image_of_subset_source hO' (by simpa using hO'U))
      (by rintro _ ⟨v, hv, rfl⟩; exact (hsrc _ (H.map_target (hO'U hv))).2)
  · intro v hv c' hv'
    choose G hG hGe using fun i => c.exists_analyticOnNhd c'.U (c'.gen i)
    refine ⟨fun v' i => G i (H.symm v'), differentiableAt_pi.2 fun i =>
      ((hG i _ ⟨(hsrc _ (H.map_target hv)).2, hv'⟩).differentiableAt).comp v (hderiv v hv), ?_⟩
    filter_upwards [H.open_target.mem_nhds hv,
      (hcont.continuousAt (H.open_target.mem_nhds hv)).preimage_mem_nhds
        ((isOpen_chart sX c'.U).mem_nhds hv')] with v' hv'U hv'c
    refine ⟨hv'c, funext fun i => ?_⟩
    change eval c'.U (c'.gen i) _ = _
    rw [hGe i _ (hΦW v' hv'U) hv'c, hφΦ v' hv'U]
  · rintro y ⟨v, hv, rfl⟩ c' hy
    have hyW := hΦW v hv
    choose G hGd hGe using fun i =>
      exists_differentiableAt_eval_eq c' c.U (c.z i) (Φ0 v) hy (c.subset hyW)
    have hval : (fun i => G i (c'.coords ⟨Φ0 v, hy⟩)) = φ (Φ0 v) := funext fun i =>
      ((hGe i).self_of_nhds hy (c.subset hyW)).symm.trans
        (c.toOpenPartialHomeomorph_apply hyW i).symm
    have hwO : φ (Φ0 v) ∈ O := by rw [hφΦ v hv]; exact (hsrc _ (H.map_target hv)).1.1
    have hLdiff : DifferentiableAt ℂ L (fun i => G i (c'.coords ⟨Φ0 v, hy⟩)) := by
      rw [hval]; exact (hLd.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds hwO)
    refine ⟨fun w => L (fun i => G i w), hLdiff.comp _ (differentiableAt_pi.2 hGd), ?_⟩
    filter_upwards [Filter.eventually_all.2 hGe, c.isOpen.mem_nhds hyW] with y' hall hyW' hy' _
    change L (φ y') = L (fun i => G i _)
    congr 1
    funext i
    rw [c.toOpenPartialHomeomorph_apply hyW' i]
    exact hall i hy' (c.subset hyW')

/-- **Local exponential coordinates from a local logarithm.** Let `cls` be a bijection of `X(ℂ)`
onto a group, `ι` an injective homomorphism to `P`, and `τ t` translations covering left
multiplication, continuous, open, holomorphic and rational in charts. Let `L` be `C¹` on an open
`Ω` of the coordinate space of an étale chart `c`, with `ι (cls y) = E (L (c y))` wherever
`c y ∈ Ω`. Then there is a local inverse `Φ₀` of `E` near `0`, continuous, open and holomorphic
in charts, biholomorphic onto an open set. -/
theorem exists_localExp_of_localLog {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    [LocallyOfFiniteType sX] [SmoothOfRelativeDimension n sX]
    {G : Type*} [Group G] {P : Type*} [AddCommGroup P]
    (cls : space sX → G) (hcls : Function.Bijective cls) (ι : G →* Multiplicative P)
    (hι : Function.Injective ι) (E : (Fin n → ℂ) →+ P)
    (τ : space sX → space sX → space sX) (hτ : ∀ t y, cls (τ t y) = cls t * cls y)
    (hτc : ∀ t, Continuous (τ t)) (hτo : ∀ t, IsOpenMap (τ t))
    (hτh : ∀ t (F : (Fin n → ℂ) → space sX) v,
      ChartHolomorphicAt F v → ChartHolomorphicAt (τ t ∘ F) v)
    (hτr : ∀ t (d c : Chart sX) (x : space sX) (hx : x ∈ chart d.U) (_ : τ t x ∈ chart c.U),
      ∃ (R : (Fin d.n → ℂ) → (Fin c.n → ℂ)) (Q : MvPolynomial (Fin d.n) ℂ),
        MvPolynomial.eval (d.coords ⟨x, hx⟩) Q ≠ 0 ∧
        (∀ z, MvPolynomial.eval z Q ≠ 0 → DifferentiableAt ℂ R z) ∧
        ∀ (y : space sX) (hy : y ∈ chart d.U), MvPolynomial.eval (d.coords ⟨y, hy⟩) Q ≠ 0 →
          ∃ h' : τ t y ∈ chart c.U, c.coords ⟨τ t y, h'⟩ = R (d.coords ⟨y, hy⟩))
    (c : EtaleCoordinateChart sX n) (L : (Fin n → ℂ) → (Fin n → ℂ)) (Ω : Set (Fin n → ℂ))
    (hΩ : IsOpen Ω) (hLd : ContDiffOn ℂ 1 L Ω)
    (hne : ∃ y ∈ c.W, c.toOpenPartialHomeomorph y ∈ Ω)
    (hlog : ∀ y ∈ c.W, c.toOpenPartialHomeomorph y ∈ Ω →
      ι (cls y) = Multiplicative.ofAdd (E (L (c.toOpenPartialHomeomorph y)))) :
    ∃ (Φ0 : (Fin n → ℂ) → space sX) (U : Set (Fin n → ℂ)), IsOpen U ∧ 0 ∈ U ∧
      (∀ v ∈ U, ι (cls (Φ0 v)) = Multiplicative.ofAdd (E v)) ∧
      ContinuousOn Φ0 U ∧ (∀ O' ⊆ U, IsOpen O' → IsOpen (Φ0 '' O')) ∧
      (∀ v ∈ U, ChartHolomorphicAt Φ0 v) ∧
      ∃ V : Opens (space sX), Set.BijOn Φ0 U V ∧
        ∃ Ψ : space sX → (Fin n → ℂ), Set.LeftInvOn Ψ Φ0 U ∧
          ∀ (y : space sX) (_ : y ∈ V) (c' : Chart sX) (hy : y ∈ ComplexPoints.chart c'.U),
            ∃ G : (Fin c'.n → ℂ) → (Fin n → ℂ), DifferentiableAt ℂ G (c'.coords ⟨y, hy⟩) ∧
              ∀ᶠ y' in 𝓝 y, ∀ hy' : y' ∈ ComplexPoints.chart c'.U, y' ∈ V →
                Ψ y' = G (c'.coords ⟨y', hy'⟩) := by
  classical
  set φ := c.toOpenPartialHomeomorph
  have hsrc : φ.source = c.W := c.source_toOpenPartialHomeomorph
  let O := Ω ∩ φ.target
  have hOo : IsOpen O := hΩ.inter φ.open_target
  obtain ⟨y1, hy1, hy1Ω⟩ := hne
  have hOne : O.Nonempty := ⟨φ y1, hy1Ω, φ.map_source (hsrc ▸ hy1)⟩
  have hlog' : ∀ p ∈ O, ι (cls (φ.symm p)) = Multiplicative.ofAdd (E (L p)) := by
    intro p hp
    have hs : φ.symm p ∈ c.W := hsrc ▸ φ.map_target hp.2
    have e1 := hlog _ hs (by rw [φ.right_inv hp.2]; exact hp.1)
    rwa [φ.right_inv hp.2] at e1
  have hinjO : Set.InjOn L O := by
    intro p hp p' hp' hpp
    have : φ.symm p = φ.symm p' := hcls.1 (hι (by rw [hlog' p hp, hlog' p' hp', hpp]))
    rw [← φ.right_inv hp.2, ← φ.right_inv hp'.2, this]
  obtain ⟨p₀, hp₀, hbij⟩ :=
    exists_bijective_fderiv_of_injOn hOo hOne (hLd.mono Set.inter_subset_left) hinjO
  let D : (Fin n → ℂ) ≃L[ℂ] (Fin n → ℂ) :=
    (LinearEquiv.ofBijective (fderiv ℂ L p₀ : (Fin n → ℂ) →ₗ[ℂ] (Fin n → ℂ))
      hbij).toContinuousLinearEquiv
  set y₀ := φ.symm p₀
  have hy₀ : y₀ ∈ c.W := hsrc ▸ φ.map_target hp₀.2
  have hφy₀ : φ y₀ = p₀ := φ.right_inv hp₀.2
  have hD : fderiv ℂ L (φ y₀) = D := by
    rw [hφy₀]; exact ContinuousLinearMap.ext fun v => rfl
  obtain ⟨Φ0, U, hU, hU0, hΦ0', hc, ho, hh, V, hbijV, hinv, hΨ⟩ :=
    exists_localInverse_of_fderiv c L Ω hΩ hLd y₀ hy₀ (hφy₀ ▸ hp₀.1) D hD
  set v₀ := L p₀ with hv₀
  have hcy₀ : ι (cls y₀) = Multiplicative.ofAdd (E v₀) := hlog' p₀ hp₀
  obtain ⟨s, hs⟩ := hcls.2 (cls y₀)⁻¹
  have hτinv : ∀ z, τ y₀ (τ s z) = z := fun z =>
    hcls.1 (by rw [hτ, hτ, hs, mul_inv_cancel_left])
  have hτinj : Function.Injective (τ s) := fun a b hab =>
    hcls.1 (by simpa [hτ] using congrArg cls hab)
  let sh : (Fin n → ℂ) → (Fin n → ℂ) := fun v => v + v₀
  have hshc : Continuous sh := continuous_id.add continuous_const
  let Φ1 : (Fin n → ℂ) → space sX := fun v => τ s (Φ0 (sh v))
  let U1 : Set (Fin n → ℂ) := sh ⁻¹' U
  have hmaps : Set.MapsTo sh U1 U := fun v hv => hv
  let V1 : Opens (space sX) := ⟨τ s '' V, hτo s _ V.2⟩
  let Ψ1 : space sX → (Fin n → ℂ) := fun y => L (φ (τ y₀ y)) - v₀
  refine ⟨Φ1, U1, hU.preimage hshc, ?_, ?_, ?_, ?_, ?_, V1, ?_, Ψ1, ?_, ?_⟩
  · change 0 + v₀ ∈ U
    rw [zero_add, hv₀, ← hφy₀]; exact hU0
  · intro v hv
    obtain ⟨h1, h2, h3⟩ := hΦ0' _ hv
    change ι (cls (τ s (Φ0 (v + v₀)))) = _
    rw [hτ, map_mul, hlog _ h1 h2, h3, hs, map_inv, hcy₀, map_add, ofAdd_add, mul_comm,
      mul_assoc, mul_inv_cancel, mul_one]
  · exact (hτc s).comp_continuousOn (hc.comp hshc.continuousOn hmaps)
  · intro O' hO'U hO'
    have : Φ1 '' O' = τ s '' (Φ0 '' (sh '' O')) := by
      rw [Set.image_image, Set.image_image]
    rw [this]
    exact hτo s _ (ho _ (by rintro _ ⟨v, hv, rfl⟩; exact hO'U hv)
      ((isOpenMap_add_right v₀) _ hO'))
  · intro v hv
    have h1 : ChartHolomorphicAt Φ0 (v - -v₀) := by
      rw [sub_neg_eq_add]; exact hh _ hv
    have h2 := h1.comp_sub (w := -v₀)
    simp only [sub_neg_eq_add] at h2
    exact hτh s _ v h2
  · refine ⟨fun v hv => ⟨Φ0 (sh v), hbijV.mapsTo hv, rfl⟩, ?_, ?_⟩
    · intro v hv w hw hvw
      exact add_right_cancel (hbijV.injOn hv hw (hτinj hvw))
    · rintro _ ⟨z, hz, rfl⟩
      obtain ⟨u, hu, rfl⟩ := hbijV.surjOn hz
      refine ⟨u - v₀, by change u - v₀ + v₀ ∈ U; rwa [sub_add_cancel], ?_⟩
      change τ s (Φ0 (u - v₀ + v₀)) = _
      rw [sub_add_cancel]
  · intro v hv
    change L (φ (τ y₀ (τ s (Φ0 (v + v₀))))) - v₀ = v
    rw [hτinv]
    have := hinv hv
    change L (φ (Φ0 (v + v₀))) = v + v₀ at this
    rw [this, add_sub_cancel_right]
  · rintro y ⟨z, hzV, rfl⟩ c'' hy
    have hzτ : τ y₀ (τ s z) = z := hτinv z
    obtain ⟨W', hW', hzW', -⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
      (show z.toScheme ∈ (⊤ : X.Opens) from trivial)
    obtain ⟨c', rfl⟩ := Chart.exists_eq (sX := sX) hW'
    have hz' : z ∈ chart c'.U := mem_chart_iff.2 hzW'
    obtain ⟨G, hGd, hGev⟩ := hΨ z hzV c' hz'
    obtain ⟨R, Q, hQ, hRd, hR⟩ := hτr y₀ c'' c' (τ s z) hy (by rw [hzτ]; exact hz')
    obtain ⟨h0', e0'⟩ := hR _ hy hQ
    have hRz : R (c''.coords ⟨τ s z, hy⟩) = c'.coords ⟨z, hz'⟩ := by
      rw [← e0']
      congr 2
    refine ⟨fun w => G (R w) - v₀, ?_, ?_⟩
    · refine DifferentiableAt.sub_const ?_ _
      refine DifferentiableAt.comp _ ?_ (hRd _ hQ)
      rw [hRz]; exact hGd
    · have hB : {y' : space sX | ∃ h : y' ∈ chart c''.U,
          MvPolynomial.eval (c''.coords ⟨y', h⟩) Q ≠ 0} ∈ 𝓝 (τ s z) := by
        have hyB : τ s z ∈ chart (X.basicOpen (c''.pres Q)) := by
          refine mem_chart_iff.2 ((toScheme_mem_basicOpen_iff ⟨τ s z, hy⟩ _).2 ?_)
          rw [c''.evalHom_pres]; exact hQ
        filter_upwards [(isOpen_chart sX _).mem_nhds hyB,
          (isOpen_chart sX _).mem_nhds hy] with y' h1 h2
        refine ⟨h2, ?_⟩
        rw [← c''.evalHom_pres]
        exact (toScheme_mem_basicOpen_iff ⟨y', h2⟩ _).1 (mem_chart_iff.1 h1)
      have hT : ∀ᶠ y' in 𝓝 (τ s z), ∀ hy'' : τ y₀ y' ∈ chart c'.U, τ y₀ y' ∈ V →
          L (φ (τ y₀ y')) = G (c'.coords ⟨τ y₀ y', hy''⟩) := by
        have ht : Tendsto (τ y₀) (𝓝 (τ s z)) (𝓝 z) := by
          have := (hτc y₀).continuousAt (x := τ s z)
          rwa [ContinuousAt, hzτ] at this
        exact ht.eventually hGev
      filter_upwards [hB, hT] with y' ⟨hy1, hQ'⟩ hT' hy' hyV
      obtain ⟨h'', e''⟩ := hR y' hy' hQ'
      obtain ⟨w', hw'V, rfl⟩ := hyV
      have hw : τ y₀ (τ s w') ∈ V := by rw [hτinv]; exact hw'V
      change L (φ (τ y₀ (τ s w'))) - v₀ = G (R (c''.coords ⟨τ s w', hy'⟩)) - v₀
      rw [hT' h'' hw, ← e'']

section PicardModels

/-! The library has three models of the Picard group of a ringed site: the skeleton model
`Stacks.SheafOfModules.PicardGroup`, its shrunk version `Stacks.SheafOfModules.Picard.PicardGroup`,
and the group of units `Stacks.SheafPicardGroup.PicardGroup` of the monoid of isomorphism classes
of all modules. All three are isomorphism classes of invertible modules, and the class maps
below compare them. -/

universe u v w

variable {𝒞 : Type u} [Category.{v} 𝒞] {J : GrothendieckTopology 𝒞}
  (O : 𝒞ᵒᵖ ⥤ CommRingCat.{w})
  (hO : Presheaf.IsSheaf J (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf O))
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasWeakSheafify J AddCommGrpCat.{w}]

/-- Isomorphic invertible sheaves of modules have the same class in
`Stacks.SheafPicardGroup.PicardGroup`. -/
theorem sheafPicard_classOf_congr (L N : SheafOfModules.{w}
    (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (h1 : AlgebraicGeometry.SheafOfModules.IsInvertible O hO L)
    (h2 : AlgebraicGeometry.SheafOfModules.IsInvertible O hO N) (e : L ≅ N) :
    @Stacks.SheafPicardGroup.classOf _ _ J O hO _ _ L h1 =
      @Stacks.SheafPicardGroup.classOf _ _ J O hO _ _ N h2 := by
  haveI := h1; haveI := h2
  exact (Stacks.SheafPicardGroup.classOf_eq_classOf_iff O hO L N).2 ⟨e⟩

/-- The class in `Stacks.SheafPicardGroup.PicardGroup` of an element of the skeleton model. -/
noncomputable def toSheafPicard (x : Stacks.SheafOfModules.PicardGroup O hO) :
    Additive (Stacks.SheafPicardGroup.PicardGroup O hO) :=
  Additive.ofMul (@Stacks.SheafPicardGroup.classOf _ _ J O hO _ _
    ((fromSkeleton _).obj ((Stacks.SheafOfModules.picardClassEquiv O hO).symm x)).obj
    ((Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO _).1
      ((fromSkeleton _).obj ((Stacks.SheafOfModules.picardClassEquiv O hO).symm x)).property))

/-- `toSheafPicard` sends the class of an invertible sheaf of modules `L` in the skeleton
model to the class of `L` in `Stacks.SheafPicardGroup.PicardGroup`. -/
theorem toSheafPicard_picardClass (L : SheafOfModules.{w}
    (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (hL : Stacks.SheafOfModules.IsInvertible O hO L) :
    toSheafPicard O hO (Stacks.SheafOfModules.picardClass O hO L hL) =
      Additive.ofMul (@Stacks.SheafPicardGroup.classOf _ _ J O hO _ _ L
        ((Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL)) := by
  let A : Stacks.SheafOfModules.InvertibleModules O hO := ⟨L, hL⟩
  have e : Nonempty ((fromSkeleton _).obj (toSkeleton A) ≅ A) :=
    toSkeleton_eq_toSkeleton_iff.1 (toSkeleton_fromSkeleton_obj _)
  unfold toSheafPicard
  congr 1
  exact sheafPicard_classOf_congr O hO _ _ _ _ ((ObjectProperty.ι _).mapIso e.some)

/-- `toSheafPicard` is additive. -/
theorem toSheafPicard_add (x y : Stacks.SheafOfModules.PicardGroup O hO) :
    toSheafPicard O hO (x + y) = toSheafPicard O hO x + toSheafPicard O hO y := by
  obtain ⟨L, hL, rfl⟩ := Stacks.SheafOfModules.exists_picardClass_eq O hO x
  obtain ⟨N, hN, rfl⟩ := Stacks.SheafOfModules.exists_picardClass_eq O hO y
  haveI := hL; haveI := hN
  have hLN := Stacks.SheafOfModules.isInvertible_tensorSheaf O hO L N
  rw [Stacks.SheafOfModules.picardClass_tensorSheaf O hO L N hL hN hLN,
    toSheafPicard_picardClass O hO L hL, toSheafPicard_picardClass O hO N hN]
  refine (toSheafPicard_picardClass O hO _ hLN).trans ?_
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO N).1 hN
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO _).1 hLN
  rw [← ofMul_mul]
  congr 1
  exact Stacks.SheafPicardGroup.classOf_tensorSheaf O hO L N

/-- The skeleton model of the Picard group maps to the group-of-units model. -/
noncomputable def toSheafPicardHom :
    Stacks.SheafOfModules.PicardGroup O hO →+ Additive (Stacks.SheafPicardGroup.PicardGroup O hO) :=
  AddMonoidHom.mk' (toSheafPicard O hO) (toSheafPicard_add O hO)

/-- The comparison `toSheafPicardHom` of the skeleton and group-of-units models of the Picard
group is injective. -/
theorem toSheafPicardHom_injective : Function.Injective (toSheafPicardHom O hO) := by
  intro x y h
  obtain ⟨L, hL, rfl⟩ := Stacks.SheafOfModules.exists_picardClass_eq O hO x
  obtain ⟨N, hN, rfl⟩ := Stacks.SheafOfModules.exists_picardClass_eq O hO y
  change toSheafPicard O hO _ = toSheafPicard O hO _ at h
  rw [toSheafPicard_picardClass, toSheafPicard_picardClass] at h
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO N).1 hN
  exact (Stacks.SheafOfModules.picardClass_eq_iff O hO L N hL hN).2
    ((Stacks.SheafPicardGroup.classOf_eq_classOf_iff O hO L N).1 (Additive.ofMul.injective h))

variable [∀ V : 𝒞, (J.over V).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- The class in `Stacks.SheafPicardGroup.PicardGroup` of an element of the shrunk model. -/
noncomputable def picardToSheafPicard (x : Stacks.SheafOfModules.Picard.PicardGroup O hO) :
    Additive (Stacks.SheafPicardGroup.PicardGroup O hO) :=
  Additive.ofMul (@Stacks.SheafPicardGroup.classOf _ _ J O hO _ _
    (Stacks.SheafOfModules.Picard.exists_classOf_eq O hO x).choose
    ((Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO _).1
      (Stacks.SheafOfModules.Picard.exists_classOf_eq O hO x).choose_spec.choose))

/-- `picardToSheafPicard` sends the class of an invertible sheaf of modules `L` in the shrunk
model to the class of `L` in `Stacks.SheafPicardGroup.PicardGroup`. -/
theorem picardToSheafPicard_classOf (L : SheafOfModules.{w}
    (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (hL : Stacks.SheafOfModules.IsInvertible O hO L) :
    picardToSheafPicard O hO (Stacks.SheafOfModules.Picard.classOf O hO L hL) =
      Additive.ofMul (@Stacks.SheafPicardGroup.classOf _ _ J O hO _ _ L
        ((Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL)) := by
  have h := (Stacks.SheafOfModules.Picard.exists_classOf_eq O hO
    (Stacks.SheafOfModules.Picard.classOf O hO L hL)).choose_spec.choose_spec
  have e := (Stacks.SheafOfModules.Picard.classOf_eq_classOf_iff O hO _ _ _ _).1 h
  unfold picardToSheafPicard
  congr 1
  exact sheafPicard_classOf_congr O hO _ _ _ _ e.some

/-- `picardToSheafPicard` is additive. -/
theorem picardToSheafPicard_add (x y : Stacks.SheafOfModules.Picard.PicardGroup O hO) :
    picardToSheafPicard O hO (x + y) = picardToSheafPicard O hO x + picardToSheafPicard O hO y := by
  obtain ⟨L, hL, rfl⟩ := Stacks.SheafOfModules.Picard.exists_classOf_eq O hO x
  obtain ⟨N, hN, rfl⟩ := Stacks.SheafOfModules.Picard.exists_classOf_eq O hO y
  haveI := hL; haveI := hN
  have hLN := Stacks.SheafOfModules.isInvertible_tensorSheaf O hO L N
  rw [Stacks.SheafOfModules.Picard.classOf_tensor O hO L N hL hN hLN,
    picardToSheafPicard_classOf O hO L hL, picardToSheafPicard_classOf O hO N hN]
  refine (picardToSheafPicard_classOf O hO _ hLN).trans ?_
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO N).1 hN
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO _).1 hLN
  rw [← ofMul_mul]
  congr 1
  exact Stacks.SheafPicardGroup.classOf_tensorSheaf O hO L N

/-- The shrunk model of the Picard group maps to the group-of-units model. -/
noncomputable def picardToSheafPicardHom :
    Stacks.SheafOfModules.Picard.PicardGroup O hO →+
      Additive (Stacks.SheafPicardGroup.PicardGroup O hO) :=
  AddMonoidHom.mk' (picardToSheafPicard O hO) (picardToSheafPicard_add O hO)

/-- The comparison `picardToSheafPicardHom` of the shrunk and group-of-units models of the
Picard group is injective. -/
theorem picardToSheafPicardHom_injective :
    Function.Injective (picardToSheafPicardHom O hO) := by
  intro x y h
  obtain ⟨L, hL, rfl⟩ := Stacks.SheafOfModules.Picard.exists_classOf_eq O hO x
  obtain ⟨N, hN, rfl⟩ := Stacks.SheafOfModules.Picard.exists_classOf_eq O hO y
  change picardToSheafPicard O hO _ = picardToSheafPicard O hO _ at h
  rw [picardToSheafPicard_classOf, picardToSheafPicard_classOf] at h
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO L).1 hL
  haveI := (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry O hO N).1 hN
  exact (Stacks.SheafOfModules.Picard.classOf_eq_classOf_iff O hO L N hL hN).2
    ((Stacks.SheafPicardGroup.classOf_eq_classOf_iff O hO L N).1 (Additive.ofMul.injective h))

end PicardModels

/-- The comparison of the shrunk and the group-of-units models of the Picard group of a ringed
space. -/
noncomputable def ringedPicardToSheafPicardHom (X : RingedSpace.{0, 0})
    {hO : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf X.sheaf.obj)} :
    Stacks.SheafOfModules.Picard.PicardGroup X.sheaf.obj hO →+
      Additive (Stacks.SheafPicardGroup.PicardGroup X.sheaf.obj hO) :=
  picardToSheafPicardHom X.sheaf.obj hO

/-- The comparison `ringedPicardToSheafPicardHom` of the Picard group models of a ringed
space is injective. -/
theorem ringedPicardToSheafPicardHom_injective (X : RingedSpace.{0, 0})
    {hO : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf X.sheaf.obj)} :
    Function.Injective (ringedPicardToSheafPicardHom X (hO := hO)) :=
  picardToSheafPicardHom_injective X.sheaf.obj hO

end MMP.JacobianLogarithm

