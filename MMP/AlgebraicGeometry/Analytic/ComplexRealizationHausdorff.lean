module
public import MMP.AlgebraicGeometry.Analytic.BorelMoore
public import MMP.AlgebraicGeometry.Analytic.ComplexRealizationCharts

/-!
# Topology of complex realizations, and the polynomial local ring at the origin

Let `X` be a scheme of finite type over `ℂ`, and `X^an` its complex realization: the set of
`ℂ`-points of `X` with the topology glued from the affine charts.

* `X^an` is locally compact. Over an affine chart `Spec A` with `A = ℂ[z_1, …, z_N]/I`, the
  chart's `ℂ`-points are the closed zero set of `I` in `ℂ^N`, which is locally compact, and the
  charts form an open cover of `X^an`. No Hausdorff hypothesis is needed.
* If `X ⟶ Spec ℂ` is separated, `X^an` is Hausdorff. The diagonal `X ⟶ X ×_ℂ X` is a closed
  immersion, so its realization is a closed embedding; the realization of `X ×_ℂ X` is all of
  `X^an × X^an`, since `(Spec ℂ)^an` is a point. The composite sends `x` to `(x, x)`, so the
  diagonal of `X^an` is closed.

Separately, let `k` be a field and `σ` a finite type. The localization of `k[X_i : i ∈ σ]` at
`p = (X_i : i ∈ σ)` is a regular local ring of Krull dimension `#σ` whose maximal ideal is
generated by the images of the variables, which therefore form a regular system of parameters.
Regularity is inherited from the polynomial ring. The dimension is the height of `p`: Krull's
height theorem bounds it above by the number of generators, and the chain of primes
`span (X '' s)`, for growing finite sets `s`, bounds it below. Each of these ideals is prime, as
the kernel of the substitution sending `X i` to `0` for `i ∈ s` and fixing the other variables.

## Main results

* `MMP.Analytic.ComplexPoints.t2Space_of_locallyOfFiniteType`: the realization of a separated
  scheme of finite type over `ℂ` is a `T2Space`.
* `MMP.Analytic.ComplexPoints.locallyCompactSpace`: the complex realization of a scheme of finite
  type over `ℂ` is a locally compact space.
* `MMP.MvPolynomial.isRegularLocalRing_of_isLocalization_atPrime_span_X`: the localization at the
  origin is regular local of dimension `Nat.card σ`, with maximal ideal generated by the images of
  the variables.
* `MMP.MvPolynomial.isPrime_span_X_image`, `MMP.MvPolynomial.isPrime_span_range_X`: the ideals
  `(X i : i ∈ s)`, and in particular the ideal of the origin, are prime.

## Implementation notes

For local compactness, `X^an` is identified with the underlying space `X(ℂ)` with the classical
topology (`MMP.Analytic.ComplexPoints.homeomorphUnderlyingSpace`), every point of which lies in
the image of an open embedding of a closed zero set in `ℂⁿ`.

In the regularity statement the localization is any `R` with `IsLocalization.AtPrime R p`, rather
than the concrete `Localization.AtPrime p`, and the prime `p` is given together with the equation
`p = Ideal.span (Set.range X)`, so that the primality instance required by
`IsLocalization.AtPrime` is supplied by the caller. The variables are indexed by an arbitrary
finite type `σ` rather than `Fin n`. The local ring structure on `R` used to name its maximal
ideal is `IsLocalization.AtPrime.isLocalRing`.

## References

* [Serre, *Géométrie algébrique et géométrie analytique*]
* [Kollár–Mori, *Birational geometry of algebraic varieties*]
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Topology Limits

namespace MMP.Analytic.ComplexPoints

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- `(Spec ℂ)^an` is a point: its only `ℂ`-point is the identity. -/
private lemma subsingleton_complexPoints_spec :
    Subsingleton (ComplexPoints (𝟙 (Spec (.of ℂ)))) :=
  ⟨fun a b => ComplexPoints.ext <| by
    simpa using a.hom_comp_structure.trans b.hom_comp_structure.symm⟩

/-- Over the point `Spec ℂ`, the realization of `X ×_ℂ X` is all of `X^an × X^an`: the map
realizing the two projections is a closed embedding. -/
private lemma isClosedEmbedding_realize_pullback_self [LocallyOfFiniteType sX] [QuasiCompact sX] :
    IsClosedEmbedding (fun z : ComplexPoints (pullback.fst sX sX ≫ sX) =>
      (realize (pullback.fst sX sX) rfl z, realize (sY := sX) (pullback.snd sX sX)
        pullback.condition.symm z)) := by
  have := subsingleton_complexPoints_spec
  obtain ⟨hemb, hrange⟩ :=
    isEmbedding_realize_pullback (sS := 𝟙 _) sX sX (Category.comp_id _) (Category.comp_id _)
  refine ⟨hemb, ?_⟩
  rw [hrange, Set.eq_univ_of_forall fun _ => Subsingleton.elim _ _]
  exact isClosed_univ

/-- The complex realization of a separated scheme of finite type over `ℂ` is Hausdorff. -/
@[mmp "lem_mmp_realization_hausdorff"]
public theorem t2Space_of_locallyOfFiniteType [LocallyOfFiniteType sX] [QuasiCompact sX]
    [IsSeparated sX] : T2Space (ComplexPoints sX) := by
  rw [t2_iff_isClosed_diagonal]
  convert (isClosedEmbedding_realize_pullback_self.comp <| isClosedEmbedding_realize (sX := sX)
    (sY := pullback.fst sX sX ≫ sX) (pullback.diagonal sX) (by simp)).isClosed_range using 1
  ext ⟨x, y⟩
  simp only [Set.mem_diagonal_iff, Set.mem_range, Function.comp_apply, Prod.mk.injEq]
  constructor
  · rintro rfl
    exact ⟨x, by ext; simp, by ext; simp⟩
  · rintro ⟨z, rfl, rfl⟩
    ext; simp

/-- `X(ℂ)` is locally compact, chart by chart: compact neighbourhoods in a closed zero set of
`ℂⁿ` are carried by the open chart embedding to compact neighbourhoods in `X(ℂ)`. -/
private theorem locallyCompactSpace_underlyingSpace (X : Scheme.{0}) [X.Over (Spec (.of ℂ))]
    [LocallyOfFiniteType (X ↘ Spec (.of ℂ))] :
    LocallyCompactSpace (MMP.UnderlyingSpace ℂ X) where
  local_compact_nhds p N hN := by
    obtain ⟨n, m, f, e, he, y, rfl⟩ :=
      MMP.UnderlyingSpace.exists_isOpenEmbedding_zeroLocus X p
    have := (MMP.UnderlyingSpace.isClosed_zeroLocus f).locallyCompactSpace
    obtain ⟨s, hs, hsN, hsc⟩ :=
      local_compact_nhds (he.continuous.continuousAt.preimage_mem_nhds hN)
    exact ⟨e '' s, he.map_nhds_eq y ▸ Filter.image_mem_map hs,
      Set.image_subset_iff.mpr hsN, hsc.image he.continuous⟩

/-- The complex realization `X^an` of a scheme `X` of finite type over `ℂ` is locally compact. -/
@[mmp "lem_mmp_realization_locally_compact"]
public instance locallyCompactSpace [LocallyOfFiniteType sX] [QuasiCompact sX] :
    LocallyCompactSpace (ComplexPoints sX) := by
  let : X.Over (Spec (.of ℂ)) := ⟨sX⟩
  have : LocallyOfFiniteType (X ↘ Spec (.of ℂ)) := ‹LocallyOfFiniteType sX›
  have := locallyCompactSpace_underlyingSpace X
  exact (homeomorphUnderlyingSpace (X := X)).isOpenEmbedding.locallyCompactSpace

end MMP.Analytic.ComplexPoints

end

public section

namespace MMP.MvPolynomial

open IsLocalRing _root_.MvPolynomial

variable {k σ : Type*} [Field k]

/-- The substitution killing the variables indexed by `s` and fixing the others. -/
private noncomputable def killVars (s : Set σ) [DecidablePred (· ∈ s)] :
    MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i => if i ∈ s then 0 else X i

private lemma ker_killVars (s : Set σ) [DecidablePred (· ∈ s)] :
    RingHom.ker (killVars (k := k) s) = Ideal.span (X '' s) := by
  refine le_antisymm (fun f hf => ?_) (Ideal.span_le.mpr ?_)
  · -- modulo `span (X '' s)`, `killVars s` is the identity
    have hcomp : (Ideal.Quotient.mkₐ k (Ideal.span (X '' s))).comp (killVars s) =
        Ideal.Quotient.mkₐ k (Ideal.span (X '' s)) := by
      refine algHom_ext fun i => ?_
      by_cases hi : i ∈ s
      · simpa [killVars, hi] using (Ideal.Quotient.eq_zero_iff_mem.mpr
          (Ideal.subset_span ⟨i, hi, rfl⟩ : (X i : MvPolynomial σ k) ∈ Ideal.span (X '' s))).symm
      · simp [killVars, hi]
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← Ideal.Quotient.mkₐ_eq_mk k, ← hcomp]
    simp [RingHom.mem_ker.mp hf]
  · rintro _ ⟨i, hi, rfl⟩
    simp [killVars, hi]

/-- For any set `s` of variables, the ideal `(X i : i ∈ s)` of `k[X_i : i ∈ σ]` is prime: it is
the kernel of the substitution sending `X i` to `0` for `i ∈ s` and fixing the other variables. -/
theorem isPrime_span_X_image (s : Set σ) :
    (Ideal.span (X '' s : Set (MvPolynomial σ k))).IsPrime := by
  classical
  rw [← ker_killVars s]
  exact RingHom.ker_isPrime _

/-- The ideal `(X i : i ∈ σ)` of the origin in `k[X_i : i ∈ σ]` is prime. -/
theorem isPrime_span_range_X : (Ideal.span (Set.range X : Set (MvPolynomial σ k))).IsPrime := by
  simpa [Set.image_univ] using isPrime_span_X_image (k := k) (Set.univ : Set σ)

private lemma card_le_height_span_X_image (s : Finset σ) :
    (s.card : ℕ∞) ≤ (Ideal.span (X '' (s : Set σ) : Set (MvPolynomial σ k))).height := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    have := isPrime_span_X_image (k := k) ((insert i s : Finset σ) : Set σ)
    have hlt : Ideal.span (X '' (s : Set σ) : Set (MvPolynomial σ k)) <
        Ideal.span (X '' ((insert i s : Finset σ) : Set σ)) :=
      lt_of_le_of_ne (Ideal.span_mono (Set.image_mono (by simp))) fun h =>
        (by simpa [mem_ideal_span_X_image, support_X, Finsupp.single_apply] using hi :
            (X i : MvPolynomial σ k) ∉ Ideal.span (X '' (s : Set σ)))
          (h ▸ (Ideal.subset_span ⟨i, by simp, rfl⟩ :
            (X i : MvPolynomial σ k) ∈ Ideal.span (X '' ((insert i s : Finset σ) : Set σ))))
    have := isPrime_span_X_image (k := k) (s : Set σ)
    rw [Finset.card_insert_of_notMem hi, Nat.cast_add, Nat.cast_one]
    exact (add_le_add_left ih 1).trans (Ideal.height_add_one_le_of_lt_of_isPrime hlt)

/-- In `k[X_i : i ∈ σ]` with `σ` finite, the ideal of the origin has height `Nat.card σ`. -/
private lemma height_span_range_X [Finite σ] :
    (Ideal.span (Set.range X : Set (MvPolynomial σ k))).height = Nat.card σ := by
  have := Fintype.ofFinite σ
  have := isPrime_span_range_X (k := k) (σ := σ)
  refine le_antisymm ((Ideal.height_le_spanFinrank _ Ideal.IsPrime.ne_top').trans ?_) ?_
  · exact_mod_cast (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans
      (Set.ncard_range_of_injective (X_injective (R := k))).le
  · simpa [Nat.card_eq_fintype_card] using
      card_le_height_span_X_image (k := k) (Finset.univ : Finset σ)

/-- The localization of `MvPolynomial σ k` (`σ` finite, `k` a field) at the ideal
generated by the variables is a regular local ring of Krull dimension `Nat.card σ`,
whose maximal ideal is generated by the images of the variables `X i`. -/
@[mmp "lem_mmp_resolution_polynomial_origin_regular"]
public theorem isRegularLocalRing_of_isLocalization_atPrime_span_X
    (k σ : Type*) [Field k] [Finite σ]
    (p : Ideal (MvPolynomial σ k)) [p.IsPrime]
    (hp : p = Ideal.span (Set.range MvPolynomial.X))
    (R : Type*) [CommRing R] [Algebra (MvPolynomial σ k) R]
    [IsLocalization.AtPrime R p] :
    haveI : IsLocalRing R := IsLocalization.AtPrime.isLocalRing R p
    IsRegularLocalRing R ∧ ringKrullDim R = Nat.card σ ∧
      maximalIdeal R =
        Ideal.span (Set.range fun i => algebraMap (MvPolynomial σ k) R (MvPolynomial.X i)) := by
  letI : IsLocalRing R := IsLocalization.AtPrime.isLocalRing R p
  refine ⟨IsRegularLocalRing.of_ringEquiv
      (IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p) R).toRingEquiv, ?_, ?_⟩
  · rw [IsLocalization.AtPrime.ringKrullDim_eq_height p R, hp, height_span_range_X]
    rfl
  · rw [← IsLocalization.map_comap p.primeCompl R (maximalIdeal R),
      IsLocalization.AtPrime.comap_maximalIdeal R p, hp, Ideal.map_span, ← Set.range_comp]
    rfl

end MMP.MvPolynomial

end
