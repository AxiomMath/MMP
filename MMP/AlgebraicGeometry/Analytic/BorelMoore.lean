module

public import MMP.AlgebraicGeometry.Analytic.ComplexRealization
public import Mathlib.AlgebraicTopology.SingularHomology.Basic
public import MMP.AlgebraicGeometry.Analytic.ComplexPoints.ClassicalTopologyCharts
public import MMP.AlgebraicGeometry.Chow.CycleClass

/-!
# Borel–Moore homology, fundamental classes and cycle ranks of complex varieties

For a scheme `X` over `ℂ`, let `X^an` be its complex realization
(`MMP.Analytic.ComplexPoints`). The rational singular homology `H_k(X, ℚ)` is the singular
homology of `X^an`, and the Borel–Moore homology `H^BM_k(X, ℚ)` (homology with closed supports)
is the homology of the complex of locally finite singular chains of `X^an`.

An irreducible closed subvariety `A ⊆ X` of dimension `r` has a fundamental class
`[A] ∈ H^BM_{2r}(X, ℚ)`: the push-forward along the proper inclusion `A^an → X^an` of the unique
class of `H^BM_{2r}(A, ℚ)` restricting to the fundamental class of the complex manifold
`A_reg^an`, oriented by its complex structure. The ℚ-span of these classes is the cycle span
`Cyc_r(X)`, its dimension the cycle rank `ρ_r(X)`, and for a normal projective threefold `S` the
divisor cycle rank is `ρ_*(S) = ρ_2(S)`.

## Main definitions

* `MMP.Analytic.singularHomology`: `H_k(X, ℚ)`, singular homology of `X^an`.
* `MMP.Analytic.borelMooreHomology`: `H^BM_k(X, ℚ)`, Borel–Moore homology of `X^an`.
* `MMP.Analytic.ComplexPoints.homeomorphUnderlyingSpace`: `X^an` is homeomorphic to the
  underlying space `X(ℂ)` with the classical topology of Fulton, §19.1.
* `MMP.Analytic.fundamentalClass`: the fundamental class `[A] ∈ H^BM_{2r}(X, ℚ)`.
* `MMP.Analytic.cycleSpan`: `Cyc_r(X) ⊆ H^BM_{2r}(X, ℚ)`.
* `MMP.Analytic.cycleRank`: `ρ_r(X) = dim_ℚ Cyc_r(X)`.
* `MMP.Analytic.divisorCycleRank`: `ρ_*(S) = ρ_2(S)`.

## Main results

* `MMP.Analytic.isCycleClassOf_iff_eq_pointCycleClass`: the cycle class
  `MMP.Chow.pointCycleClass` of `A = closure {x}` is the only cycle class of `A → X`.
* `MMP.Analytic.fundamentalClass_mem_cycleSpan`: `[A] ∈ Cyc_r(X)`.

## Implementation notes

* Borel–Moore homology is defined by locally finite singular chains
  (`MMP.borelMooreHomology`) rather than as the relative homology of the
  one-point compactification `(X^an ∪ {∞}, ∞)`; for the locally compact, Hausdorff, locally
  contractible spaces `X^an` the two agree, and the locally finite form carries the proper
  push-forward and the fundamental classes used here. The comparison with `H_k(X, ℚ)` for
  projective `X` is not part of the definition and is not stated here.
* `X^an` and Fulton's underlying space `X(ℂ)` are the same set of `ℂ`-points; their topologies
  are defined differently (final for affine charts, resp. generated by values of sections on
  open subsets) and are shown to agree. The fundamental class is constructed on `X(ℂ)` and
  transported along this homeomorphism.
* Irreducible closed subvarieties `A ⊆ X` are given by their generic points: `A = closure {x}`
  with its reduced structure (`Stacks.Chow.integralComponentAt x`), and `dim A = r` is
  `Stacks.Chow.relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec ℂ) x = r`
  (Stacks 02QO). The fundamental class needs `X` to be a complex scheme in Fulton's sense
  (`MMP.IsComplexScheme`: algebraic over `ℂ`, with a closed embedding into a
  nonsingular variety), which holds for quasi-projective, in particular projective, `X`.
* The fundamental class is the transport of `MMP.Chow.pointCycleClass ℚ x hx`, the push-forward
  of `Classical.choose` of the existence statement of
  `MMP.existsUnique_isVarietyFundamentalClass`; the class chosen is unique, so the
  definition depends on no choice.
* `ρ_r(X)` is `Module.finrank`; the Borel–Moore homology of a complex algebraic variety is finite
  dimensional, so this is the dimension of `Cyc_r(X)`.
* The divisor cycle rank is defined for every complex scheme, and is the source's `ρ_*(S)` when
  `S` is a normal projective threefold; it is not identified with a Picard number.

## References

* [W. Fulton, *Intersection Theory*][fulton1998], §19.1.
* [A. Borel, J. C. Moore, *Homology theory for locally compact spaces*][borelmoore1960].
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Topology MMP.UnderlyingSpace
open Stacks.Chow (fieldChowSituation relativeDimension integralComponentAt)
open MMP (UnderlyingSpace IsComplexScheme existsUnique_isVarietyFundamentalClass IsCycleClassOf)

namespace MMP.Analytic

/-! ### Singular and Borel–Moore homology of the complex realization -/

section Homology

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

/-- The rational singular homology `H_k(X, ℚ)` of a scheme `X` over `ℂ`: the singular homology
of its complex realization `X^an`, with coefficients in `ℚ`. -/
@[mmp "def_oai4_bg_borel_moore_homology"]
def singularHomology (k : ℕ) : ModuleCat.{0} ℚ :=
  ((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} ℚ) k).obj (ModuleCat.of ℚ ℚ)).obj
    (TopCat.of (ComplexPoints sX))

/-- The rational Borel–Moore homology `H^BM_k(X, ℚ)` of a scheme `X` over `ℂ`: the homology
with closed supports of its complex realization `X^an`, i.e. the homology of the complex of
locally finite singular chains with coefficients in `ℚ`. -/
@[mmp "def_oai4_bg_borel_moore_homology"]
def borelMooreHomology (k : ℕ) : ModuleCat.{0} ℚ :=
  MMP.borelMooreHomology ℚ (ModuleCat.of ℚ ℚ) (TopCat.of (ComplexPoints sX)) k

end Homology

/-! ### The complex realization is Fulton's underlying space -/

namespace ComplexPoints

variable {X : Scheme.{0}} [X.Over (Spec (.of ℂ))]

/-- The `ℂ`-points of `X` in the complex realization are Fulton's underlying space `X(ℂ)`:
both are the sections of the structure morphism. -/
def toUnderlyingSpace : ComplexPoints (X ↘ Spec (.of ℂ)) ≃ UnderlyingSpace ℂ X :=
  Equiv.refl _

/-- A `ℂ`-point in the chart of `U` maps the closed point of `Spec ℂ` into `U`. -/
lemma top_le_preimage_of_mem_chart {U : X.Opens} (x : chart (sX := X ↘ Spec (.of ℂ)) U) :
    ⊤ ≤ (toUnderlyingSpace x.1).toHom ⁻¹ᵁ U :=
  x.2.ge

/-- The value of a section `f` over `U` at a `ℂ`-point of the chart of `U` is its value at the
corresponding point of `X(ℂ)`. -/
lemma eval_eq {U : X.Opens} (f : Γ(X, U)) (x : chart (sX := X ↘ Spec (.of ℂ)) U) :
    eval U f x = MMP.UnderlyingSpace.eval (toUnderlyingSpace x.1)
      (top_le_preimage_of_mem_chart x) f :=
  rfl

/-- The identification `X^an → X(ℂ)` is continuous. -/
theorem continuous_toUnderlyingSpace : Continuous (toUnderlyingSpace (X := X)) := by
  refine continuous_generateFrom_iff.mpr ?_
  rintro _ ⟨V, g, W, hW, rfl⟩
  rw [ComplexPoints.isOpen_iff]
  intro U
  let := chartTopology (sX := X ↘ Spec (.of ℂ)) (U : X.Opens)
  refine isOpen_iff_forall_mem_open.mpr ?_
  rintro x ⟨hxV, hxW⟩
  have hxU : (toUnderlyingSpace x.1).toHom (IsLocalRing.closedPoint ℂ) ∈ (U : X.Opens) :=
    (top_le_preimage_iff _ _).mp (top_le_preimage_of_mem_chart x)
  have hxV' : (toUnderlyingSpace x.1).toHom (IsLocalRing.closedPoint ℂ) ∈ V :=
    (top_le_preimage_iff _ _).mp hxV
  obtain ⟨f, hfV, hxf⟩ := U.2.exists_basicOpen_le ⟨_, hxV'⟩ hxU
  have := U.2.isLocalization_basicOpen f
  obtain ⟨⟨a, _, k, rfl⟩, hak⟩ := IsLocalization.mk'_surjective (Submonoid.powers f)
    (X.presheaf.map (homOfLE hfV).op g)
  have hak' : IsLocalization.mk' (M := Submonoid.powers f) Γ(X, X.basicOpen f) a
      ⟨f ^ k, k, rfl⟩ = X.presheaf.map (homOfLE hfV).op g := hak
  have hval : ∀ y : chart (sX := X ↘ Spec (.of ℂ)) (U : X.Opens),
      (hyD : ⊤ ≤ (toUnderlyingSpace y.1).toHom ⁻¹ᵁ X.basicOpen f) → (hyV : _) →
      MMP.UnderlyingSpace.eval (U := V) (toUnderlyingSpace y.1) hyV g =
        eval (U : X.Opens) a y / eval (U : X.Opens) f y ^ k := by
    intro y hyD hyV
    rw [eval_eq, eval_eq, ← eval_restrict hfV _ hyD, ← hak']
    exact eval_mk'_of_isAffineOpen U.2 f a k _ hyD
  refine ⟨{y | eval (U : X.Opens) f y ≠ 0} ∩
      (fun y ↦ eval (U : X.Opens) a y / eval (U : X.Opens) f y ^ k) ⁻¹' W, ?_, ?_, ?_⟩
  · rintro y ⟨hyf, hyW⟩
    have hyD : ⊤ ≤ (toUnderlyingSpace y.1).toHom ⁻¹ᵁ X.basicOpen f :=
      (top_le_preimage_basicOpen_iff _ (top_le_preimage_of_mem_chart y) f).mpr hyf
    have hyV : ⊤ ≤ (toUnderlyingSpace y.1).toHom ⁻¹ᵁ V :=
      hyD.trans (Scheme.Hom.preimage_mono _ hfV)
    exact ⟨hyV, by rwa [hval y hyD hyV]⟩
  · refine ContinuousOn.isOpen_inter_preimage ?_
      (isOpen_compl_singleton.preimage (continuous_eval _ f)) hW
    exact (continuous_eval _ a).continuousOn.div ((continuous_eval _ f).pow k).continuousOn
      fun y hy ↦ pow_ne_zero _ hy
  · have hxD : ⊤ ≤ (toUnderlyingSpace x.1).toHom ⁻¹ᵁ X.basicOpen f :=
      (top_le_preimage_iff _ _).mpr hxf
    refine ⟨(top_le_preimage_basicOpen_iff _ (top_le_preimage_of_mem_chart x) f).mp hxD, ?_⟩
    change eval (U : X.Opens) a x / eval (U : X.Opens) f x ^ k ∈ W
    rwa [← hval x hxD hxV]

/-- The identification `X(ℂ) → X^an` is continuous. -/
theorem continuous_toUnderlyingSpace_symm : Continuous (toUnderlyingSpace (X := X)).symm := by
  refine continuous_def.mpr fun s hs ↦ ?_
  rw [ComplexPoints.isOpen_iff] at hs
  refine isOpen_iff_forall_mem_open.mpr fun p hp ↦ ?_
  obtain ⟨U, hU, hpU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (U := ⊤) (x := p.toHom (IsLocalRing.closedPoint ℂ)) (TopologicalSpace.Opens.mem_top _)
  let t : Set (UnderlyingSpace ℂ X) := {q | ⊤ ≤ q.toHom ⁻¹ᵁ U}
  let φ : t → chart (sX := X ↘ Spec (.of ℂ)) U :=
    fun q ↦ ⟨toUnderlyingSpace.symm q.1, le_antisymm le_top q.2⟩
  let := chartTopology (sX := X ↘ Spec (.of ℂ)) U
  have hφ : Continuous φ :=
    continuous_iInf_rng.mpr fun f ↦ continuous_induced_rng.mpr
      (MMP.UnderlyingSpace.continuous_eval U f)
  refine ⟨Subtype.val '' (φ ⁻¹' (Subtype.val ⁻¹' s)), ?_,
    (isOpen_setOf_le_preimage U).isOpenMap_subtype_val _ ((hs ⟨U, hU⟩).preimage hφ), ?_⟩
  · rintro _ ⟨q, hq, rfl⟩
    exact hq
  · exact ⟨⟨p, (top_le_preimage_iff _ _).mpr hpU⟩, hp, rfl⟩

/-- The complex realization `X^an` is homeomorphic to Fulton's underlying space `X(ℂ)` with its
classical topology, by the identity of `ℂ`-points. -/
def homeomorphUnderlyingSpace : ComplexPoints (X ↘ Spec (.of ℂ)) ≃ₜ UnderlyingSpace ℂ X where
  toEquiv := toUnderlyingSpace
  continuous_toFun := continuous_toUnderlyingSpace
  continuous_invFun := continuous_toUnderlyingSpace_symm

/-- The homeomorphism `X^an ≃ₜ X(ℂ)` sends a `ℂ`-point to the same morphism `Spec ℂ → X`. -/
@[simp]
lemma homeomorphUnderlyingSpace_apply (x : ComplexPoints (X ↘ Spec (.of ℂ))) :
    (homeomorphUnderlyingSpace x).toHom = x.hom :=
  rfl

/-- The inverse homeomorphism `X(ℂ) ≃ₜ X^an` sends a point to the same morphism `Spec ℂ → X`. -/
@[simp]
lemma hom_homeomorphUnderlyingSpace_symm_apply (p : UnderlyingSpace ℂ X) :
    (homeomorphUnderlyingSpace.symm p).hom = p.toHom :=
  rfl

end ComplexPoints

/-! ### Fundamental classes -/

section FundamentalClass

variable {X : Scheme.{0}} [X.Over (Spec (.of ℂ))] [IsComplexScheme X] {r : ℕ}

/-- The cycle class of `closure {x}` is the only cycle class of the inclusion
`closure {x} → X`: a class `α ∈ H^BM_{2r}(X(ℂ), R)` is a cycle class of it iff
`α = MMP.Chow.pointCycleClass R x hx`. -/
theorem isCycleClassOf_iff_eq_pointCycleClass (R : Type) [CommRing R] (x : X)
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = r)
    (α : MMP.borelMooreHomology R (ModuleCat.of R R)
      (TopCat.of (UnderlyingSpace ℂ X)) (2 * r : ℕ)) :
    IsCycleClassOf R (integralComponentAt x).subschemeι
        (MMP.Chow.natCast_eq_dimension_integralComponentAt x hx) α ↔
      α = MMP.Chow.pointCycleClass R x hx := by
  refine ⟨fun h ↦ IsCycleClassOf.eq ?_ h (MMP.Chow.isCycleClassOf_pointCycleClass R x hx), ?_⟩
  · intro c c' hc hc'
    obtain ⟨μ, -, hμ, -⟩ := existsUnique_isVarietyFundamentalClass R
      (MMP.Chow.natCast_eq_dimension_integralComponentAt x hx)
    rw [hμ c hc, hμ c' hc']
  · rintro rfl
    exact MMP.Chow.isCycleClassOf_pointCycleClass R x hx

/-- The fundamental class `[A] ∈ H^BM_{2r}(X, ℚ)` of an irreducible closed subvariety `A ⊆ X`
of dimension `r`, given by its generic point `x` (a point of delta-dimension `r`, so
`A = closure {x}`): Fulton's cycle class `cl_X(A)` (`MMP.Chow.pointCycleClass`), the
push-forward along `A^an → X^an` of the unique class restricting to the fundamental class of the
complex manifold `A_reg^an`, transported to the complex realization `X^an`. -/
@[mmp "def_oai4_bg_borel_moore_homology"]
def fundamentalClass (x : X)
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = r) :
    borelMooreHomology (X ↘ Spec (.of ℂ)) (2 * r) :=
  MMP.borelMooreHomology.pushforward ℚ (ModuleCat.of ℚ ℚ)
    (TopCat.ofHom ⟨_, ComplexPoints.homeomorphUnderlyingSpace.symm.continuous⟩)
    ComplexPoints.homeomorphUnderlyingSpace.symm.isProperMap (2 * r : ℕ)
    (MMP.Chow.pointCycleClass ℚ x hx)

/-- The fundamental class `[A]` is the push-forward of `MMP.Chow.pointCycleClass ℚ x hx` along the
homeomorphism `X(ℂ) ≃ₜ X^an`. -/
lemma fundamentalClass_eq (x : X)
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = r) :
    fundamentalClass x hx = MMP.borelMooreHomology.pushforward ℚ (ModuleCat.of ℚ ℚ)
      (TopCat.ofHom ⟨_, ComplexPoints.homeomorphUnderlyingSpace.symm.continuous⟩)
      ComplexPoints.homeomorphUnderlyingSpace.symm.isProperMap (2 * r : ℕ)
      (MMP.Chow.pointCycleClass ℚ x hx) :=
  rfl

end FundamentalClass

/-! ### Cycle spans and cycle ranks -/

section Cycles

variable (X : Scheme.{0}) [X.Over (Spec (.of ℂ))] [MMP.IsComplexScheme X]

/-- The cycle span `Cyc_r(X) ⊆ H^BM_{2r}(X, ℚ)`: the ℚ-linear span of the fundamental classes
`[A]` of the irreducible closed subvarieties `A ⊆ X` of dimension `r`, i.e. of the classes
`fundamentalClass x hx` of the points `x` of delta-dimension `r`. -/
@[mmp "def_oai4_cycle_span"]
def cycleSpan (r : ℕ) : Submodule ℚ (borelMooreHomology (X ↘ Spec (.of ℂ)) (2 * r)) :=
  Submodule.span ℚ (Set.range fun x : {x : X // relativeDimension
    (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = r} ↦
      fundamentalClass x.1 x.2)

variable {X} in
/-- The fundamental class of an irreducible closed subvariety of dimension `r` lies in
`Cyc_r(X)`. -/
lemma fundamentalClass_mem_cycleSpan {r : ℕ} (x : X)
    (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction (X ↘ Spec (.of ℂ)) x = r) :
    fundamentalClass x hx ∈ cycleSpan X r :=
  Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩

variable {X} in
/-- `Cyc_r(X)` is contained in a submodule `N` iff `N` contains the fundamental class of every
irreducible closed subvariety of dimension `r`. -/
lemma cycleSpan_le_iff {r : ℕ} (N : Submodule ℚ (borelMooreHomology (X ↘ Spec (.of ℂ)) (2 * r))) :
    cycleSpan X r ≤ N ↔ ∀ (x : X) (hx : relativeDimension (fieldChowSituation ℂ).dimensionFunction
      (X ↘ Spec (.of ℂ)) x = r), fundamentalClass x hx ∈ N := by
  rw [cycleSpan, Submodule.span_le, Set.range_subset_iff, Subtype.forall]
  rfl

/-- The cycle rank `ρ_r(X) = dim_ℚ Cyc_r(X)`. -/
@[mmp "def_oai4_cycle_rank"]
def cycleRank (r : ℕ) : ℕ :=
  Module.finrank ℚ (cycleSpan X r)

/-- The divisor cycle rank `ρ_*(S) = ρ_2(S)` of a normal projective threefold `S`: the rank of
the span of the classes of its prime divisors in `H^BM_4(S, ℚ)`. It is defined for every complex
scheme. -/
@[mmp "def_oai4_divisor_cycle_rank"]
abbrev divisorCycleRank : ℕ :=
  cycleRank X 2

end Cycles

end MMP.Analytic
