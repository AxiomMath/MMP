module
public import MMP.AlgebraicTopology.NerveTheorem
public import MMP.AlgebraicGeometry.Analytic.SchemeManifold
import MMP.AlgebraicGeometry.MMP.Abundance.SlcCurveNormalizedSections
import MMP.AlgebraicGeometry.ProjectiveSpace.NoetherNormalization
import StacksFrontier.AlgebraicGeometry.ProjectiveSpaceChartRatio.Basic
import MMP.AlgebraicGeometry.Analytic.ComplexPoints.ProjectiveSpace
import StacksFrontier.AlgebraicGeometry.Variety.Curve.SmoothRelativeDimension
/-!
# A finite good cover of a complex algebraic curve

Let `T` be a smooth connected complex algebraic curve. Its analytic realization `T^an` has a
finite open cover `(U i)` all of whose nonempty finite intersections are homeomorphic to `ℝ²`.
The realization `|N|` of the nerve of such a cover is connected and homotopy equivalent to
`T^an`. Moreover the cover computes the fundamental group of `T^an` combinatorially: every loop
at a point of `U i₀` can be cut into finitely many pieces, each contained in one member of the
cover, along a closed edge path of the nerve starting at `i₀`; and an edge path traced by a
null-homotopic loop reduces to the trivial path by triangle relations of the nerve.

The cover is pulled back from the plane. Let `T̄` be the smooth projective completion of `T`,
`P = T̄ ∖ T`, and `f : T̄ → ℙ¹` a finite surjective morphism. On the Riemann surface `T̄^an`, the
function `f` is, near every point `a`, of the form `f(a) + φ^e` in a holomorphic coordinate `φ`
centred at `a`. Let `B ⊆ ℂ` be the finite set of branch values, of the values at `P`, and `0`.
Downstairs we take the small disks `D_b` around the points of `B`, four convex sectors in each
punctured disk, finitely many small round disks covering the rest of a large disk, four sectors
around `∞` and the disk `|z| > R` around `∞`. Every nonempty intersection containing a set that
avoids `B` is convex in `z` or in `1 / z`, hence homeomorphic to `ℝ²`. Over a convex set avoiding
`B`, `f` is a trivial finite covering; over `D_b` (and around `∞`) the preimage is a disjoint
union of coordinate disks. The sheets over the sets avoiding `B` and the coordinate disks around
the points of `T` form the cover.

## Main definitions

* `MMP.Fourfold.BranchedCoverData`: a branched covering of `ℙ¹` read in the two affine charts,
  with a power normal form `F = F a + φ ^ e` (`MMP.Fourfold.IsPowNormalForm`) at every point.
* `MMP.Fourfold.BranchedCoverData.ofFiniteToProjectiveLine`: the branched covering datum of a
  finite morphism `π : Y → ℙ¹` from a smooth curve, whose coordinates are the pulled-back affine
  coordinates `MMP.Fourfold.coordFun`.

## Main results

* `MMP.Fourfold.exists_finite_goodCover_analyticSpace`
* `MMP.Fourfold.BranchedCoverData.exists_sheets`: over a contractible open set avoiding the
  critical values, the covering splits into sheets mapped homeomorphically onto it.
* `MMP.Fourfold.exists_completion`: a smooth curve is a cofinite open part of a smooth proper
  curve with a finite surjective morphism to `ℙ¹`.
* `MMP.Fourfold.exists_pow_normalForm`, `MMP.Fourfold.isPowNormalForm_of_analyticAt`: the local
  normal form of a nonconstant holomorphic function.

## Implementation notes

An edge path of the nerve is recorded as the list of its vertices `[i₀, …, iₙ]`; consecutive
vertices are adjacent in the nerve because the corresponding pieces of the loop share an
endpoint. The edge-path relations are generated by `[a, b, c] ↦ [a, c]` whenever
`U a ∩ U b ∩ U c` is nonempty (the triangle relations, including the degenerate triangles that
cancel backtracking) and by `[a, a] ↦ [a]` (degenerate edges). A loop is cut along a
monotone subdivision `0 = t₀ ≤ t₁ ≤ ⋯ ≤ tₙ = 1` of the unit interval, the piece on
`[t_k, t_{k+1}]` lying in `U i_{k+1}`; this decomposes the loop itself, and so in particular
a loop homotopic to it.

The source triangulates the sphere with the branch values among the vertices, lifts the
triangulation, and takes the open vertex stars of a barycentric subdivision. Here the cover is
assembled directly from convex pieces of the two affine charts of `ℙ¹`, which needs no
triangulation. The edge-path statements hold for every finite open cover: a null-homotopy is cut
along a fine grid (Lebesgue), and two labelled subdivisions of a path with the same end labels
give words related by the triangle moves.

A complex algebraic curve is a separated scheme of finite type over `ℂ`, smooth of relative
dimension one; `T^an` is `MMP.Analytic.ComplexPoints.analyticSpace`, and the realization of
the nerve is `MMP.Topology.nerveSet`.

## References

* [A. Hatcher, *Algebraic Topology*, §2.1 and Corollary 4G.3][hatcher2002]
-/

open Set AlgebraicGeometry MMP.Analytic.ComplexPoints MMP.Topology

namespace MMP.Fourfold

/-! ### Edge paths of the nerve of an open cover -/

section EdgePath

open unitInterval

variable {X ι : Type*} [TopologicalSpace X] (U : ι → Set X)

/-- The elementary moves of the edge-path relation of the nerve of `U`. -/
private def triRel : List ι → List ι → Prop := fun w w' ↦ ∃ (l₁ l₂ : List ι) (a b c : ι),
  ((U a ∩ U b ∩ U c).Nonempty ∧ w = l₁ ++ [a, b, c] ++ l₂ ∧ w' = l₁ ++ [a, c] ++ l₂) ∨
    (w = l₁ ++ [a, a] ++ l₂ ∧ w' = l₁ ++ [a] ++ l₂)

variable {U}

private theorem triRel_cons {w w' : List ι} (a : ι) (h : triRel U w w') :
    triRel U (a :: w) (a :: w') := by
  obtain ⟨l₁, l₂, x, y, z, h⟩ := h
  refine ⟨a :: l₁, l₂, x, y, z, ?_⟩
  rcases h with ⟨h, rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact Or.inl ⟨h, rfl, rfl⟩
  · exact Or.inr ⟨rfl, rfl⟩

private theorem eqvGen_cons {w w' : List ι} (a : ι) (h : Relation.EqvGen (triRel U) w w') :
    Relation.EqvGen (triRel U) (a :: w) (a :: w') := by
  induction h with
  | rel _ _ h => exact .rel _ _ (triRel_cons a h)
  | refl => exact .refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans _ _ _ ih₂

private theorem eqvGen_triangle {a b c : ι} (h : (U a ∩ U b ∩ U c).Nonempty) (l : List ι) :
    Relation.EqvGen (triRel U) (a :: b :: c :: l) (a :: c :: l) :=
  .rel _ _ ⟨[], l, a, b, c, Or.inl ⟨h, rfl, rfl⟩⟩

private theorem eqvGen_dup (a : ι) (l : List ι) :
    Relation.EqvGen (triRel U) (a :: a :: l) (a :: l) :=
  .rel _ _ ⟨[], l, a, a, a, Or.inr ⟨rfl, rfl⟩⟩

/-- A word all of whose letters contain a common point reduces to its first and last letter. -/
private theorem eqvGen_of_forall_mem {p : X} (a b : ι) (l : List ι)
    (h : ∀ c ∈ a :: b :: l, p ∈ U c) :
    Relation.EqvGen (triRel U) (a :: b :: l) [a, (b :: l).getLast (List.cons_ne_nil _ _)] := by
  induction l generalizing b with
  | nil => exact .refl _
  | cons c l ih =>
    have h1 : (U a ∩ U b ∩ U c).Nonempty :=
      ⟨p, ⟨h a (by simp), h b (by simp)⟩, h c (by simp)⟩
    refine (eqvGen_triangle h1 l).trans _ _ _ ?_
    simpa using ih c (fun d hd ↦ h d (by simp at hd ⊢; tauto))

/-- The last label of a labelled subdivision. -/
private def lastL : ι → List (I × ι) → ι
  | a, [] => a
  | _, (_, a) :: l => lastL a l

/-- A labelled subdivision of `γ` on `[s, 1]`: `s = t₀ ≤ t₁ ≤ ⋯ ≤ tₙ = 1` with labels
`a₀, a₁, …, aₙ`, `γ s ∈ U a₀` and `γ [t_{k-1}, t_k] ⊆ U a_k`. -/
private def Valid (U : ι → Set X) (γ : I → X) : I → ι → List (I × ι) → Prop
  | s, a₀, [] => s = 1 ∧ γ s ∈ U a₀
  | s, a₀, (t, a) :: l => γ s ∈ U a₀ ∧ s ≤ t ∧ γ '' Icc s t ⊆ U a ∧ Valid U γ t a l

private theorem Valid.mem {γ : I → X} {s : I} {a : ι} {l : List (I × ι)} (h : Valid U γ s a l) :
    γ s ∈ U a := by
  cases l with
  | nil => exact h.2
  | cons p l => exact h.1

private theorem Valid.mem_of_one {γ : I → X} {a : ι} {l : List (I × ι)} (h : Valid U γ 1 a l) :
    ∀ c ∈ a :: l.map Prod.snd, γ 1 ∈ U c := by
  induction l generalizing a with
  | nil => simpa using h.2
  | cons p l ih =>
    obtain ⟨t, b⟩ := p
    obtain ⟨h0, h1, h2, h3⟩ := h
    obtain rfl : t = 1 := le_antisymm (le_one t) h1
    intro c hc
    simp only [List.map_cons, List.mem_cons] at hc
    rcases hc with rfl | hc
    · exact h0
    · exact ih h3 c (by simpa using hc)

private theorem lastL_eq_getLast (a : ι) (l : List (I × ι)) :
    lastL a l = (a :: l.map Prod.snd).getLast (List.cons_ne_nil _ _) := by
  induction l generalizing a with
  | nil => rfl
  | cons p l ih =>
    obtain ⟨t, b⟩ := p
    simp only [lastL, List.map_cons]
    rw [ih, List.getLast_cons (List.cons_ne_nil _ _)]

private theorem eqvGen_of_valid_one {γ : I → X} {a : ι} {l : List (I × ι)} (h : Valid U γ 1 a l)
    (hlast : lastL a l = a) :
    Relation.EqvGen (triRel U) (a :: l.map Prod.snd) [a] := by
  cases l with
  | nil => exact .refl _
  | cons p l =>
    obtain ⟨t, b⟩ := p
    have := eqvGen_of_forall_mem (p := γ 1) a b (l.map Prod.snd) (by simpa using h.mem_of_one)
    rw [lastL_eq_getLast] at hlast
    simp only [List.map_cons] at hlast
    rw [List.getLast_cons (List.cons_ne_nil _ _)] at hlast
    rw [hlast] at this
    exact this.trans _ _ _ (eqvGen_dup a [])

/-- **Independence of the labelled subdivision.** Two labelled subdivisions of `γ` on `[s, 1]`
with the same first and last labels give equivalent words. -/
private theorem eqvGen_of_valid (γ : I → X) :
    ∀ (n : ℕ) (s : I) (a : ι) (l l' : List (I × ι)), l.length + l'.length = n →
      Valid U γ s a l → Valid U γ s a l' → lastL a l = lastL a l' →
      Relation.EqvGen (triRel U) (a :: l.map Prod.snd) (a :: l'.map Prod.snd) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  have step : ∀ (s : I) (a : ι) (t₁ : I) (a₁ : ι) (l₁ : List (I × ι)) (t₁' : I) (a₁' : ι)
      (l₁' : List (I × ι)), (l₁.length + 1) + (l₁'.length + 1) = n → t₁ ≤ t₁' →
      Valid U γ s a ((t₁, a₁) :: l₁) → Valid U γ s a ((t₁', a₁') :: l₁') →
      lastL a ((t₁, a₁) :: l₁) = lastL a ((t₁', a₁') :: l₁') →
      Relation.EqvGen (triRel U) (a :: ((t₁, a₁) :: l₁).map Prod.snd)
        (a :: ((t₁', a₁') :: l₁').map Prod.snd) := by
    intro s a t₁ a₁ l₁ t₁' a₁' l₁' hn hle hv hv' hlast
    obtain ⟨hs, hst, himg, hv₁⟩ := hv
    obtain ⟨-, hst', himg', hv₁'⟩ := hv'
    have h3 : Valid U γ t₁ a₁ ((t₁', a₁') :: l₁') :=
      ⟨hv₁.mem, hle, (image_mono (Icc_subset_Icc_left hst)).trans himg', hv₁'⟩
    have hih := ih (l₁.length + (l₁'.length + 1)) (by omega) t₁ a₁ l₁ ((t₁', a₁') :: l₁')
      (by simp) hv₁ h3 (by simpa [lastL] using hlast)
    have htri : (U a ∩ U a₁ ∩ U a₁').Nonempty :=
      ⟨γ s, ⟨hs, himg ⟨s, ⟨le_rfl, hst⟩, rfl⟩⟩, himg' ⟨s, ⟨le_rfl, hst'⟩, rfl⟩⟩
    simp only [List.map_cons] at hih ⊢
    exact (eqvGen_cons a hih).trans _ _ _ (eqvGen_triangle htri _)
  intro s a l l' hn hv hv' hlast
  cases l with
  | nil =>
    obtain ⟨rfl, -⟩ := hv
    exact (eqvGen_of_valid_one hv' hlast.symm).symm
  | cons p l₁ =>
    cases l' with
    | nil =>
      obtain ⟨rfl, -⟩ := hv'
      exact eqvGen_of_valid_one hv hlast
    | cons p' l₁' =>
      obtain ⟨t₁, a₁⟩ := p
      obtain ⟨t₁', a₁'⟩ := p'
      rcases le_total t₁ t₁' with h | h
      · exact step s a t₁ a₁ l₁ t₁' a₁' l₁' (by simpa using hn) h hv hv' hlast
      · exact (step s a t₁' a₁' l₁' t₁ a₁ l₁ (by simp at hn ⊢; omega) h hv' hv hlast.symm).symm

private theorem valid_ofFn (γ : I → X) : ∀ (n : ℕ) (t : Fin (n + 1) → I) (i : Fin (n + 1) → ι),
    Monotone t → t (Fin.last n) = 1 → γ (t 0) ∈ U (i 0) →
    (∀ k : Fin n, γ '' Icc (t k.castSucc) (t k.succ) ⊆ U (i k.succ)) →
    Valid U γ (t 0) (i 0) (List.ofFn fun k : Fin n ↦ (t k.succ, i k.succ)) ∧
      lastL (i 0) (List.ofFn fun k : Fin n ↦ (t k.succ, i k.succ)) = i (Fin.last n) := by
  intro n
  induction n with
  | zero =>
    intro t i _ h1 h0 _
    exact ⟨⟨h1, h0⟩, rfl⟩
  | succ n ih =>
    intro t i ht h1 h0 hp
    have hp0 := hp 0
    simp only [Fin.castSucc_zero, Fin.succ_zero_eq_one] at hp0
    have hm : γ (t 1) ∈ U (i 1) := hp0 ⟨t 1, ⟨ht (Fin.zero_le _), le_rfl⟩, rfl⟩
    obtain ⟨hv, hl⟩ := ih (t ∘ Fin.succ) (i ∘ Fin.succ) (ht.comp Fin.strictMono_succ.monotone)
      (by simpa using h1) (by simpa using hm)
      fun k ↦ by simpa only [Function.comp_apply, Fin.succ_castSucc] using hp k.succ
    rw [List.ofFn_succ]
    refine ⟨⟨h0, ht (Fin.zero_le _), by simpa using hp0, by simpa using hv⟩, ?_⟩
    simpa [lastL] using hl

private theorem ofFn_eq_cons_map {n : ℕ} (t : Fin (n + 1) → I) (i : Fin (n + 1) → ι) :
    List.ofFn i = i 0 :: (List.ofFn fun k : Fin n ↦ (t k.succ, i k.succ)).map Prod.snd := by
  rw [List.ofFn_succ, List.map_ofFn]
  rfl

/-- The labelled subdivision of a row of a grid: `k` more pieces from `g p`, the `m`-th piece
labelled `c m`, followed by the degenerate piece `[1, 1]` labelled `i₀`. -/
private def rowL (g : ℕ → I) (c : ℕ → ι) (i₀ : ι) : ℕ → ℕ → List (I × ι)
  | _, 0 => [(1, i₀)]
  | p, k + 1 => (g (p + 1), c p) :: rowL g c i₀ (p + 1) k

private theorem lastL_rowL (g : ℕ → I) (c : ℕ → ι) (i₀ a : ι) (p k : ℕ) :
    lastL a (rowL g c i₀ p k) = i₀ := by
  induction k generalizing p a with
  | zero => rfl
  | succ k ih => exact ih _ _

private theorem valid_rowL {g : ℕ → I} (hg : Monotone g) {c : ℕ → ι} {i₀ : ι} {ρ : I → X}
    (hrow : ∀ p, ρ '' Icc (g p) (g (p + 1)) ⊆ U (c p)) (hend : ρ 1 ∈ U i₀) :
    ∀ (k p : ℕ) (a : ι), (∀ m ≥ p + k, g m = 1) → ρ (g p) ∈ U a →
      Valid U ρ (g p) a (rowL g c i₀ p k) := by
  intro k
  induction k with
  | zero =>
    intro p a hN ha
    have hp : g p = 1 := hN p (by omega)
    refine ⟨ha, le_one _, ?_, rfl, hend⟩
    rw [hp, Icc_self, image_singleton, singleton_subset_iff]
    exact hend
  | succ k ih =>
    intro p a hN ha
    refine ⟨ha, hg (Nat.le_succ p), hrow p, ih (p + 1) (c p) (fun m hm ↦ hN m (by omega)) ?_⟩
    exact hrow p ⟨g (p + 1), ⟨hg (Nat.le_succ p), le_rfl⟩, rfl⟩

/-- **Null-homotopic loops trace null-homotopic edge paths.** For an open cover `U` of `X`, if a
null-homotopic loop at `x` is cut along a labelled subdivision, the word of labels is equivalent
to the one-letter word under the triangle relations of the nerve. -/
private theorem eqvGen_ofFn_of_homotopic (hUo : ∀ i, IsOpen (U i)) (hUc : ⋃ i, U i = univ) {x : X}
    (γ : Path x x) (n : ℕ) (t : Fin (n + 1) → I) (i : Fin (n + 1) → ι) (ht : Monotone t)
    (h0 : t 0 = 0) (h1 : t (Fin.last n) = 1) (hx : x ∈ U (i 0)) (hlast : i (Fin.last n) = i 0)
    (hp : ∀ k : Fin n, γ '' Icc (t k.castSucc) (t k.succ) ⊆ U (i k.succ))
    (hγ : γ.Homotopic (Path.refl x)) :
    Relation.EqvGen (triRel U) (List.ofFn i) [i 0] := by
  obtain ⟨H⟩ := hγ
  set i₀ := i 0
  obtain ⟨g, hg0, hg, ⟨N, hN⟩, hsq⟩ := exists_monotone_Icc_subset_open_cover_unitInterval_prod_self
    (c := fun j ↦ (H : I × I → X) ⁻¹' U j) (fun j ↦ (hUo j).preimage H.continuous)
    (fun p _ ↦ by simpa using (hUc ▸ mem_univ _ : H p ∈ ⋃ j, U j))
  choose c hc using hsq
  let w : ℕ → List ι := fun q ↦ i₀ :: (rowL g (c q) i₀ 0 N).map Prod.snd
  have hvalid : ∀ q (τ : I), τ ∈ Icc (g q) (g (q + 1)) →
      Valid U (fun s ↦ H (τ, s)) 0 i₀ (rowL g (c q) i₀ 0 N) := by
    intro q τ hτ
    have := valid_rowL (U := U) hg (c := c q) (i₀ := i₀) (ρ := fun s ↦ H (τ, s))
      (fun p ↦ by
        rintro _ ⟨s, hs, rfl⟩
        exact hc q p ⟨hτ, hs⟩)
      (by simpa [H.target] using hx) N 0 i₀ (fun m hm ↦ hN m (by omega))
      (by simpa [hg0, H.source] using hx)
    rwa [hg0] at this
  have hw : ∀ q, Relation.EqvGen (triRel U) (List.ofFn i) (w q) := by
    intro q
    induction q with
    | zero =>
      rw [ofFn_eq_cons_map t i]
      obtain ⟨hv, hl⟩ := valid_ofFn (U := U) (fun s ↦ H (0, s)) n t i ht h1
        (by simpa [h0, H.source] using hx) (fun k ↦ by simpa using hp k)
      rw [h0] at hv
      refine eqvGen_of_valid _ _ 0 i₀ _ _ rfl hv
        (hvalid 0 0 ⟨hg0.le, unitInterval.nonneg _⟩) ?_
      rw [hl, hlast, lastL_rowL]
    | succ q ih =>
      refine ih.trans _ _ _ (eqvGen_of_valid _ _ 0 i₀ _ _ rfl
        (hvalid q (g (q + 1)) ⟨hg (Nat.le_succ q), le_rfl⟩)
        (hvalid (q + 1) (g (q + 1)) ⟨le_rfl, hg (Nat.le_succ _)⟩) (by rw [lastL_rowL, lastL_rowL]))
  have hend : Relation.EqvGen (triRel U) (w N) [i₀] := by
    have hv := hvalid N (g N) ⟨le_rfl, hg (Nat.le_succ N)⟩
    have hv' : Valid U (fun s ↦ H (g N, s)) 0 i₀ [(1, i₀)] := by
      refine ⟨by simpa [H.source] using hx, zero_le_one, ?_, rfl, by simpa [H.target] using hx⟩
      rintro _ ⟨s, -, rfl⟩
      simpa [hN N le_rfl] using hx
    have := eqvGen_of_valid _ _ 0 i₀ _ _ rfl hv hv' (by rw [lastL_rowL]; rfl)
    exact this.trans _ _ _ (eqvGen_dup i₀ [])
  exact (hw N).trans _ _ _ hend

/-- **Cutting a loop along an open cover.** Every loop at a point `x ∈ U i₀` is cut by a
subdivision of `[0, 1]` into pieces each contained in one member of the open cover `U`, along a
closed word starting and ending with `i₀`. -/
private theorem exists_subdivision (hUo : ∀ i, IsOpen (U i)) (hUc : ⋃ i, U i = univ) (i₀ : ι)
    {x : X}
    (hx : x ∈ U i₀) (γ : Path x x) :
    ∃ (n : ℕ) (t : Fin (n + 1) → I) (i : Fin (n + 1) → ι),
      Monotone t ∧ t 0 = 0 ∧ t (Fin.last n) = 1 ∧ i 0 = i₀ ∧ i (Fin.last n) = i₀ ∧
      ∀ k : Fin n, γ '' Icc (t k.castSucc) (t k.succ) ⊆ U (i k.succ) := by
  classical
  obtain ⟨g, hg0, hg, ⟨N, hN⟩, hsub⟩ := exists_monotone_Icc_subset_open_cover_unitInterval
    (c := fun j ↦ (γ : I → X) ⁻¹' U j) (fun j ↦ (hUo j).preimage γ.continuous)
    (fun p _ ↦ by
      have : γ p ∈ ⋃ j, U j := hUc ▸ mem_univ _
      simpa using this)
  choose lab hlab using hsub
  refine ⟨N + 1, fun k ↦ g k, fun k ↦ if (k : ℕ) = 0 ∨ (k : ℕ) = N + 1 then i₀ else lab (k - 1),
    fun a b hab ↦ hg hab, by simpa using hg0, hN (N + 1) (by omega), by simp, by simp, ?_⟩
  intro k
  rintro _ ⟨s, hs, rfl⟩
  have hk := k.isLt
  simp only [Fin.coe_castSucc, Fin.val_succ] at hs ⊢
  by_cases hkN : (k : ℕ) = N
  · have h1 : g (k + 1) = 1 := hN _ (by omega)
    have h2 : g k = 1 := hN _ (by omega)
    have hs1 : s = 1 := le_antisymm (h1 ▸ hs.2) (h2 ▸ hs.1)
    simpa only [hkN, or_true, if_true, hs1, γ.target] using hx
  · have : ¬ ((k : ℕ) + 1 = 0 ∨ (k : ℕ) + 1 = N + 1) := by omega
    rw [if_neg this, Nat.add_sub_cancel]
    exact hlab k hs

end EdgePath

/-! ### The nerve of a good cover -/

section Nerve

variable {X ι : Type*} [TopologicalSpace X]

/-- A space homotopy equivalent to a connected space is connected. -/
private theorem connectedSpace_of_homotopyEquiv {Y : Type*} [TopologicalSpace Y] [ConnectedSpace X]
    (h : ContinuousMap.HomotopyEquiv X Y) : ConnectedSpace Y := by
  obtain ⟨x₀⟩ := (inferInstance : Nonempty X)
  rw [connectedSpace_iff_univ]
  refine ⟨⟨h.toFun x₀, trivial⟩, isPreconnected_of_forall (h.toFun x₀) fun y _ ↦ ?_⟩
  obtain ⟨H⟩ := h.right_inv
  refine ⟨range h.toFun ∪ range (fun τ : unitInterval ↦ H (τ, y)), subset_univ _, Or.inl ⟨x₀, rfl⟩,
    Or.inr ⟨1, by simp⟩, ?_⟩
  refine (isPreconnected_range h.toFun.continuous).union (h.toFun (h.invFun y)) ⟨h.invFun y, rfl⟩
    ⟨0, by simp⟩ (isPreconnected_range (by fun_prop))

/-- **The nerve theorem for a finite good cover by planes.** -/
private theorem nonempty_homotopyEquiv_nerveSet_of_goodCover [NormalSpace X]
    [ParacompactSpace X] [Nonempty X] [Fintype ι] (U : ι → Set X) (hUo : ∀ i, IsOpen (U i))
    (hUc : ⋃ i, U i = univ)
    (hgood : ∀ I : Finset ι, I.Nonempty → (coverInter U I).Nonempty →
      Nonempty (coverInter U I ≃ₜ EuclideanSpace ℝ (Fin 2))) :
    Nonempty (ContinuousMap.HomotopyEquiv X (nerveSet U)) := by
  obtain ⟨φ, hφ⟩ := PartitionOfUnity.exists_isSubordinate isClosed_univ U hUo (by rw [hUc])
  refine nonempty_homotopyEquiv_nerveSet U (fun I hI hne ↦ ?_)
    (fun i ↦ φ i) (fun i x ↦ φ.nonneg i x)
    (fun x ↦ by rw [← finsum_eq_sum_of_fintype]; exact φ.sum_eq_one (mem_univ x)) hφ
  obtain ⟨e⟩ := hgood I hI hne
  exact e.contractibleSpace

end Nerve

/-! ### Pulling back a good cover of the plane along a branched covering -/

section PlaneCover

open Metric ComplexConjugate _root_.Topology

/-- A map that is continuous and injective on an open set `S`, and open on the open subsets of
`S`, restricts to a homeomorphism from `S ∩ F⁻¹ W` onto `W`, for `W ⊆ F '' S`. -/
private theorem nonempty_homeomorph_inter_preimage {Z Y : Type*}
    [TopologicalSpace Z] [TopologicalSpace Y]
    {F : Z → Y} {S : Set Z} (hS : IsOpen S) (hc : ContinuousOn F S) (hinj : InjOn F S)
    (hopen : ∀ V ⊆ S, IsOpen V → IsOpen (F '' V)) {W : Set Y} (hW : W ⊆ F '' S) :
    Nonempty (↥(S ∩ F ⁻¹' W) ≃ₜ W) := by
  let f : ↥(S ∩ F ⁻¹' W) → W := fun x ↦ ⟨F x, x.2.2⟩
  have hf : Function.Bijective f := by
    refine ⟨fun x y h ↦ Subtype.ext (hinj x.2.1 y.2.1 (congrArg Subtype.val h)), fun w ↦ ?_⟩
    obtain ⟨x, hx, hxw⟩ := hW w.2
    exact ⟨⟨x, hx, by simp [hxw]⟩, Subtype.ext hxw⟩
  have hcont : Continuous f :=
    ((hc.mono inter_subset_left).comp_continuous continuous_subtype_val fun x ↦ x.2).subtype_mk _
  have hop : IsOpenMap f := by
    intro V hV
    obtain ⟨O, hO, rfl⟩ := isOpen_induced_iff.mp hV
    have : f '' (Subtype.val ⁻¹' O) = Subtype.val ⁻¹' (F '' (O ∩ S)) := by
      ext ⟨w, hw⟩
      simp only [mem_image, mem_preimage, Subtype.exists, mem_inter_iff, f, Subtype.mk.injEq]
      constructor
      · rintro ⟨x, ⟨hxS, -⟩, hxO, rfl⟩
        exact ⟨x, ⟨hxO, hxS⟩, rfl⟩
      · rintro ⟨x, ⟨hxO, hxS⟩, rfl⟩
        exact ⟨x, ⟨hxS, hw⟩, hxO, rfl⟩
    rw [this]
    exact (hopen _ inter_subset_right (hO.inter hS)).preimage continuous_subtype_val
  exact ⟨(Equiv.ofBijective f hf).toHomeomorphOfContinuousOpen hcont hop⟩

/-- **Pulling back a good cover.** Let `F : Z → ℂ` be continuous on an open `X₀`, and `(S k)` a
finite family of open subsets of `Z` lying over members `A (d k)` of a family of subsets of `ℂ`.
A `plain` member is covered by sheets: `S k ⊆ X₀` is mapped homeomorphically onto `A (d k)`; a
member that is not plain is covered by pairwise disjoint planes `S k` with `S k ∩ X₀` over
`A (d k)`. Each `S k ∩ X₀` is relatively closed in `X₀ ∩ F⁻¹ (A (d k))`. If every nonempty
intersection of members containing a plain one is connected and a plane, then so is every
nonempty intersection of the `S k`. -/
private theorem nonempty_homeomorph_iInter_of_pullback {Z : Type*} [TopologicalSpace Z]
    {J K : Type*}
    (A : J → Set ℂ) (plain : J → Prop) (F : Z → ℂ) (X₀ : Set Z) (hF : ContinuousOn F X₀)
    (d : K → J) (S : K → Set Z) (hSo : ∀ k, IsOpen (S k))
    (hplain : ∀ k, plain (d k) → S k ⊆ X₀ ∧ InjOn F (S k) ∧ F '' S k = A (d k) ∧
      ∀ V ⊆ S k, IsOpen V → IsOpen (F '' V))
    (hdisk : ∀ k, ¬ plain (d k) → Nonempty (S k ≃ₜ EuclideanSpace ℝ (Fin 2)) ∧
      S k ∩ X₀ ⊆ F ⁻¹' A (d k))
    (hdisj : ∀ k k', k ≠ k' → ¬ plain (d k) → ¬ plain (d k') → Disjoint (S k) (S k'))
    (hrest : ∀ k, IsOpen ((X₀ ∩ F ⁻¹' A (d k)) \ S k))
    (hdown : ∀ I : Finset K, (∃ k ∈ I, plain (d k)) → (⋂ k ∈ I, A (d k)).Nonempty →
      IsPreconnected (⋂ k ∈ I, A (d k)) ∧
        Nonempty (↥(⋂ k ∈ I, A (d k)) ≃ₜ EuclideanSpace ℝ (Fin 2)))
    (I : Finset K) (hI : I.Nonempty) (hne : (⋂ k ∈ I, S k).Nonempty) :
    Nonempty (↥(⋂ k ∈ I, S k) ≃ₜ EuclideanSpace ℝ (Fin 2)) := by
  obtain ⟨x, hx⟩ := hne
  rw [mem_iInter₂] at hx
  by_cases hp : ∃ k ∈ I, plain (d k)
  · obtain ⟨k₀, hk₀, hpk₀⟩ := hp
    obtain ⟨hS₀X, hinj, himg, hopen⟩ := hplain k₀ hpk₀
    set W := ⋂ k ∈ I, A (d k) with hWdef
    have hWsub : W ⊆ F '' S k₀ := himg ▸ biInter_subset_of_mem hk₀
    have hmemW : ∀ y ∈ ⋂ k ∈ I, S k, F y ∈ W := by
      intro y hy
      rw [mem_iInter₂] at hy ⊢
      intro k hk
      by_cases hpk : plain (d k)
      · rw [← (hplain k hpk).2.2.1]
        exact ⟨y, hy k hk, rfl⟩
      · exact (hdisk k hpk).2 ⟨hy k hk, hS₀X (hy k₀ hk₀)⟩
    have hWne : W.Nonempty := ⟨F x, hmemW x (mem_iInter₂.mpr hx)⟩
    obtain ⟨hWc, ⟨eW⟩⟩ := hdown I ⟨k₀, hk₀, hpk₀⟩ hWne
    obtain ⟨e⟩ := nonempty_homeomorph_inter_preimage (hSo k₀) (hF.mono hS₀X) hinj hopen hWsub
    have hCc : IsPreconnected (S k₀ ∩ F ⁻¹' W) := by
      haveI : PreconnectedSpace W := isPreconnected_iff_preconnectedSpace.mp hWc
      have h := isPreconnected_range (continuous_subtype_val.comp e.symm.continuous)
      rwa [range_comp, e.symm.range_coe, image_univ, Subtype.range_coe] at h
    have heq : (⋂ k ∈ I, S k) = S k₀ ∩ F ⁻¹' W := by
      refine Subset.antisymm (fun y hy ↦ ⟨mem_iInter₂.mp hy k₀ hk₀, hmemW y hy⟩) ?_
      intro y hy
      rw [mem_iInter₂]
      intro k hk
      have hsub : S k₀ ∩ F ⁻¹' W ⊆ S k ∪ ((X₀ ∩ F ⁻¹' A (d k)) \ S k) := by
        intro z hz
        by_cases hzk : z ∈ S k
        · exact Or.inl hzk
        · exact Or.inr ⟨⟨hS₀X hz.1, mem_iInter₂.mp hz.2 k hk⟩, hzk⟩
      have hxC : x ∈ S k₀ ∩ F ⁻¹' W := ⟨hx k₀ hk₀, hmemW x (mem_iInter₂.mpr hx)⟩
      exact hCc.subset_left_of_subset_union (hSo k) (hrest k) disjoint_sdiff_right hsub
        ⟨x, hxC, hx k hk⟩ hy
    rw [heq]
    exact ⟨e.trans eW⟩
  · simp only [not_exists, not_and] at hp
    obtain ⟨k, hk⟩ := hI
    have hall : ∀ k' ∈ I, k' = k := by
      intro k' hk'
      by_contra hne
      exact (hdisj k' k hne (hp k' hk') (hp k hk)).ne_of_mem (hx k' hk') (hx k hk) rfl
    have heq : (⋂ k' ∈ I, S k') = S k := by
      ext y
      simp only [mem_iInter₂]
      exact ⟨fun h ↦ h k hk, fun h k' hk' ↦ hall k' hk' ▸ h⟩
    obtain ⟨e⟩ := (hdisk k (hp k hk)).1
    rw [heq]
    exact ⟨e⟩

/-- A nonempty bounded open convex subset of `ℂ` is homeomorphic to `ℝ²`. -/
private theorem nonempty_homeomorph_of_convex {s : Set ℂ} (hc : Convex ℝ s) (ho : IsOpen s)
    (hb : Bornology.IsBounded s) (hne : s.Nonempty) :
    Nonempty (s ≃ₜ EuclideanSpace ℝ (Fin 2)) := by
  obtain ⟨e, he, -, -⟩ := exists_homeomorph_image_eq hc (by rwa [ho.interior_eq])
    (NormedSpace.isVonNBounded_of_isBounded ℝ hb) (convex_ball (0 : ℂ) 1)
    (by rw [isOpen_ball.interior_eq]; exact ⟨0, mem_ball_self one_pos⟩)
    (NormedSpace.isVonNBounded_of_isBounded ℝ isBounded_ball)
  rw [ho.interior_eq, isOpen_ball.interior_eq] at he
  exact ⟨((e.image s).trans (Homeomorph.setCongr he)).trans
    (Homeomorph.unitBall.symm.trans Complex.orthonormalBasisOneI.repr.toHomeomorph)⟩

/-- The set of `z ≠ 0` with `z⁻¹ ∈ C`. -/
private def invSet (C : Set ℂ) : Set ℂ := {z | z ≠ 0 ∧ z⁻¹ ∈ C}

private theorem invSet_iInter {κ : Type*} {I : Finset κ} (hI : I.Nonempty) (C : κ → Set ℂ) :
    (⋂ k ∈ I, invSet (C k)) = invSet (⋂ k ∈ I, C k) := by
  ext z
  obtain ⟨k₀, hk₀⟩ := hI
  simp only [mem_iInter₂, invSet, mem_setOf_eq]
  exact ⟨fun h ↦ ⟨(h k₀ hk₀).1, fun k hk ↦ (h k hk).2⟩, fun h k hk ↦ ⟨h.1, h.2 k hk⟩⟩

/-- Inversion identifies `invSet C` with `C` when `0 ∉ C`. -/
private noncomputable def invSetHomeomorph {C : Set ℂ} (h0 : (0 : ℂ) ∉ C) : invSet C ≃ₜ C where
  toFun z := ⟨z.1⁻¹, z.2.2⟩
  invFun u := ⟨u.1⁻¹, inv_ne_zero (fun h ↦ h0 (h ▸ u.2)), by simpa using u.2⟩
  left_inv z := Subtype.ext (inv_inv _)
  right_inv u := Subtype.ext (inv_inv _)
  continuous_toFun := (continuous_subtype_val.inv₀ fun z ↦ z.2.1).subtype_mk _
  continuous_invFun := (continuous_subtype_val.inv₀ fun u ↦ fun h ↦ h0 (h ▸ u.2)).subtype_mk _

private theorem norm_inv_sub_lt_iff {c z : ℂ} {δ : ℝ} (hδ : 0 ≤ δ)
    (hD : 0 < Complex.normSq c - δ ^ 2)
    (hz : z ≠ 0) :
    ‖z⁻¹ - conj c / ((Complex.normSq c - δ ^ 2 : ℝ) : ℂ)‖ < δ / (Complex.normSq c - δ ^ 2) ↔
      ‖z - c‖ < δ := by
  set D : ℝ := Complex.normSq c - δ ^ 2 with hDdef
  have hDc : ((D : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hD.ne'
  have hzn : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have hw : z⁻¹ - conj c / (D : ℂ) = ((D : ℂ) - conj c * z) / ((D : ℂ) * z) := by
    field_simp
  have hkey : ‖(D : ℂ) - conj c * z‖ ^ 2 - δ ^ 2 * ‖z‖ ^ 2 = D * (‖z - c‖ ^ 2 - δ ^ 2) := by
    simp only [Complex.sq_norm, Complex.normSq_apply, hDdef, Complex.sub_re, Complex.sub_im,
      Complex.mul_re, Complex.mul_im, Complex.conj_re, Complex.conj_im, Complex.ofReal_re,
      Complex.ofReal_im]
    ring
  rw [hw, norm_div, norm_mul, Complex.norm_real, Real.norm_of_nonneg hD.le,
    div_lt_div_iff₀ (by positivity) hD]
  have hn1 := norm_nonneg ((D : ℂ) - conj c * z)
  have hn2 := norm_nonneg (z - c)
  constructor
  · intro h
    have h' : ‖(D : ℂ) - conj c * z‖ < δ * ‖z‖ := by nlinarith
    have hsq : ‖(D : ℂ) - conj c * z‖ ^ 2 < (δ * ‖z‖) ^ 2 :=
      pow_lt_pow_left₀ h' hn1 two_ne_zero
    have : ‖z - c‖ ^ 2 < δ ^ 2 := by nlinarith
    exact lt_of_pow_lt_pow_left₀ 2 hδ this
  · intro h
    have hsq : ‖z - c‖ ^ 2 < δ ^ 2 := pow_lt_pow_left₀ h hn2 two_ne_zero
    have : ‖(D : ℂ) - conj c * z‖ ^ 2 < (δ * ‖z‖) ^ 2 := by nlinarith
    have := lt_of_pow_lt_pow_left₀ 2 (by positivity) this
    nlinarith

/-- **Inversion of a disk not containing `0`.** -/
private theorem exists_ball_eq_invSet {c : ℂ} {δ : ℝ} (hδ : 0 ≤ δ) (hc : δ < ‖c‖) :
    ∃ C : Set ℂ, ball c δ = invSet C ∧ Convex ℝ C ∧ IsOpen C ∧ Bornology.IsBounded C ∧
      (0 : ℂ) ∉ C := by
  set D : ℝ := Complex.normSq c - δ ^ 2 with hD
  have hcn : δ ^ 2 < Complex.normSq c := by
    rw [← Complex.sq_norm]; exact pow_lt_pow_left₀ hc hδ two_ne_zero
  have hDpos : 0 < D := by linarith
  refine ⟨ball (conj c / D) (δ / D), ?_, convex_ball _ _, isOpen_ball, isBounded_ball, ?_⟩
  · ext z
    simp only [invSet, mem_setOf_eq, mem_ball, dist_eq_norm]
    constructor
    · intro h
      have hz : z ≠ 0 := by
        rintro rfl
        rw [zero_sub, norm_neg] at h
        linarith
      exact ⟨hz, (norm_inv_sub_lt_iff hδ hDpos hz).mpr h⟩
    · rintro ⟨hz0, h⟩
      exact (norm_inv_sub_lt_iff hδ hDpos hz0).mp h
  · simp only [mem_ball, dist_eq_norm, zero_sub, norm_neg, norm_div, Complex.norm_conj,
      Complex.norm_real, Real.norm_of_nonneg hDpos.le, not_lt]
    exact div_le_div_of_nonneg_right hc.le hDpos.le

/-- The four directions `1, i, -1, -i`. -/
private def dir : Fin 4 → ℂ := ![1, Complex.I, -1, -Complex.I]

/-- The open sector of half-angle `π / 3` around the direction `dir m`. -/
private def cone (m : Fin 4) : Set ℂ := {w | ‖w‖ / 2 < (conj (dir m) * w).re}

private theorem convex_cone (m : Fin 4) : Convex ℝ (cone m) := by
  refine convex_iff_forall_pos.mpr fun x hx y hy a b ha hb hab ↦ ?_
  simp only [cone, mem_setOf_eq] at hx hy ⊢
  have h1 : ‖a • x + b • y‖ ≤ a * ‖x‖ + b * ‖y‖ := by
    refine (norm_add_le _ _).trans ?_
    rw [norm_smul, norm_smul, Real.norm_of_nonneg ha.le, Real.norm_of_nonneg hb.le]
  have h2 : (conj (dir m) * (a • x + b • y)).re = a * (conj (dir m) * x).re +
      b * (conj (dir m) * y).re := by
    simp only [Complex.real_smul, mul_add, Complex.add_re]
    rw [mul_left_comm, mul_left_comm _ (b : ℂ), Complex.re_ofReal_mul, Complex.re_ofReal_mul]
  rw [h2]
  nlinarith

private theorem isOpen_cone (m : Fin 4) : IsOpen (cone m) :=
  isOpen_lt (by fun_prop) (by fun_prop)

private theorem zero_notMem_cone (m : Fin 4) : (0 : ℂ) ∉ cone m := by
  simp [cone]

private theorem exists_mem_cone {w : ℂ} (hw : w ≠ 0) : ∃ m, w ∈ cone m := by
  have hn : ‖w‖ ^ 2 = w.re ^ 2 + w.im ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]; ring
  have hpos : 0 < ‖w‖ := norm_pos_iff.mpr hw
  rcases le_total |w.im| |w.re| with h | h
  · have hre : w.re ≠ 0 := by
      intro h0
      rw [h0, abs_zero] at h
      exact hw (Complex.ext h0 (abs_nonpos_iff.mp h))
    have hlt : ‖w‖ < 2 * |w.re| := by
      have : ‖w‖ ^ 2 < (2 * |w.re|) ^ 2 := by
        rw [hn, mul_pow, sq_abs]
        have := sq_abs w.im
        have := sq_le_sq' (neg_le_of_abs_le h) (le_of_abs_le h)
        have : 0 < w.re ^ 2 := by positivity
        nlinarith [sq_abs w.re]
      exact lt_of_pow_lt_pow_left₀ 2 (by positivity) this
    rcases lt_or_gt_of_ne hre with hneg | hpos'
    · refine ⟨2, ?_⟩
      simp only [cone, dir, mem_setOf_eq]
      simp [abs_of_neg hneg] at hlt ⊢
      linarith
    · refine ⟨0, ?_⟩
      simp only [cone, dir, mem_setOf_eq]
      simp [abs_of_pos hpos'] at hlt ⊢
      linarith
  · have him : w.im ≠ 0 := by
      intro h0
      rw [h0, abs_zero] at h
      exact hw (Complex.ext (abs_nonpos_iff.mp h) h0)
    have hlt : ‖w‖ < 2 * |w.im| := by
      have : ‖w‖ ^ 2 < (2 * |w.im|) ^ 2 := by
        rw [hn, mul_pow, sq_abs]
        have := sq_le_sq' (neg_le_of_abs_le h) (le_of_abs_le h)
        have : 0 < w.im ^ 2 := by positivity
        nlinarith [sq_abs w.im]
      exact lt_of_pow_lt_pow_left₀ 2 (by positivity) this
    rcases lt_or_gt_of_ne him with hneg | hpos'
    · refine ⟨3, ?_⟩
      simp only [cone, dir, mem_setOf_eq]
      simp [abs_of_neg hneg] at hlt ⊢
      linarith
    · refine ⟨1, ?_⟩
      simp only [cone, dir, mem_setOf_eq]
      simp [abs_of_pos hpos'] at hlt ⊢
      linarith

private theorem inv_image_invSet {C : Set ℂ} (h0 : (0 : ℂ) ∉ C) :
    (fun z : ℂ ↦ z⁻¹) '' invSet C = C := by
  ext u
  constructor
  · rintro ⟨z, ⟨-, hz⟩, rfl⟩
    exact hz
  · intro hu
    have hu0 : u ≠ 0 := fun h ↦ h0 (h ▸ hu)
    exact ⟨u⁻¹, ⟨inv_ne_zero hu0, by simpa using hu⟩, inv_inv u⟩

/-- A set of the form `invSet C`, `C` a nonempty bounded open convex set avoiding `0`, is
connected and homeomorphic to `ℝ²`. -/
private theorem invSet_good {C : Set ℂ} (hc : Convex ℝ C) (ho : IsOpen C)
    (hb : Bornology.IsBounded C)
    (h0 : (0 : ℂ) ∉ C) (hne : (invSet C).Nonempty) :
    IsPreconnected (invSet C) ∧ Nonempty (invSet C ≃ₜ EuclideanSpace ℝ (Fin 2)) := by
  let e := invSetHomeomorph h0
  have hCne : C.Nonempty := by
    obtain ⟨z, hz⟩ := hne
    exact ⟨_, hz.2⟩
  obtain ⟨e'⟩ := nonempty_homeomorph_of_convex hc ho hb hCne
  refine ⟨?_, ⟨e.trans e'⟩⟩
  haveI : PreconnectedSpace C := isPreconnected_iff_preconnectedSpace.mp hc.isPreconnected
  have h := isPreconnected_range (continuous_subtype_val.comp e.symm.continuous)
  rwa [range_comp, e.symm.range_coe, image_univ, Subtype.range_coe] at h

section Downstairs

variable (B : Finset ℂ) (r R : ℝ) (t : Set ℂ)

/-- The pieces of the downstairs cover: a disk around each point of `B`, four sectors in each
punctured disk, the disks centred at `t`, four sectors around `∞`, and the disk around `∞`. -/
private abbrev Piece : Type := B ⊕ (B × Fin 4) ⊕ t ⊕ Fin 4 ⊕ Unit

/-- The sector of the punctured disk around `b`. -/
private def bsec (b : ℂ) (m : Fin 4) : Set ℂ := {z | z - b ∈ cone m ∧ ‖z - b‖ < r}

/-- The pieces as subsets of `ℂ`. -/
private def piece : Piece B t → Set ℂ
  | Sum.inl b => ball (b : ℂ) r
  | Sum.inr (Sum.inl (b, m)) => bsec r b m
  | Sum.inr (Sum.inr (Sum.inl c)) => ball (c : ℂ) (r / 2)
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl m))) => invSet (cone m ∩ ball 0 R⁻¹)
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))) => {z | R < ‖z‖}

/-- The pieces avoiding `B`. -/
private def IsPlain : Piece B t → Prop
  | Sum.inl _ => False
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))) => False
  | _ => True

/-- The pieces near the points of `B`. -/
private def IsInner : Piece B t → Prop
  | Sum.inl _ => True
  | Sum.inr (Sum.inl _) => True
  | _ => False

/-- The pieces near `∞`. -/
private def IsOuter : Piece B t → Prop
  | Sum.inr (Sum.inr (Sum.inr _)) => True
  | _ => False

/-- The convex set whose inversion is a piece away from `B`. -/
private def invPiece : Piece B t → Set ℂ
  | Sum.inr (Sum.inr (Sum.inl c)) => (fun z : ℂ ↦ z⁻¹) '' ball (c : ℂ) (r / 2)
  | Sum.inr (Sum.inr (Sum.inr (Sum.inl m))) => cone m ∩ ball 0 R⁻¹
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))) => ball 0 R⁻¹
  | _ => ∅

variable {B r R t}
variable (h0B : (0 : ℂ) ∈ B) (hr : 0 < r)
  (hsep : ∀ b ∈ B, ∀ b' ∈ B, b ≠ b' → 2 * r ≤ ‖b - b'‖) (hR : ∀ b ∈ B, ‖b‖ + r < R)
  (ht : ∀ c ∈ t, ∀ b ∈ B, r ≤ ‖c - b‖)
  (hcov : ∀ z : ℂ, ‖z‖ ≤ R → (∀ b ∈ B, r ≤ ‖z - b‖) → ∃ c ∈ t, ‖z - c‖ < r / 2)

/-- A point within `r` of `b` lies in the disk of radius `R` around `0` once `‖b‖ + r < R`. -/
private theorem norm_lt_of_norm_sub_lt {z b : ℂ} (hz : ‖z - b‖ < r) (hb : ‖b‖ + r < R) :
    ‖z‖ < R := by
  linarith [norm_le_insert' z b]

include h0B hr hR in
private theorem R_pos : 0 < R := by
  have := hR 0 h0B
  simp at this
  linarith

omit h0B hr hR in
private theorem isOpen_piece (j : Piece B t) : IsOpen (piece B r R t j) := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact isOpen_ball
  · change IsOpen ({z : ℂ | z - b ∈ cone m} ∩ {z : ℂ | ‖z - (b : ℂ)‖ < r})
    exact ((isOpen_cone m).preimage (continuous_id.sub continuous_const)).inter
      (isOpen_lt (continuous_id.sub continuous_const).norm continuous_const)
  · exact isOpen_ball
  · exact continuousOn_inv₀.isOpen_inter_preimage isOpen_ne ((isOpen_cone m).inter isOpen_ball)
  · exact isOpen_lt continuous_const continuous_norm

include hR in
private theorem piece_subset_of_isInner {j : Piece B t} (hj : IsInner B t j) :
    piece B r R t j ⊆ ball 0 R := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · intro z hz
    rw [mem_ball_zero_iff]
    exact norm_lt_of_norm_sub_lt (mem_ball_iff_norm.mp hz) (hR b b.2)
  · intro z hz
    rw [mem_ball_zero_iff]
    exact norm_lt_of_norm_sub_lt (r := r) hz.2 (hR b b.2)
  all_goals exact absurd hj (by simp [IsInner])

include h0B hr hR in
private theorem piece_subset_of_isOuter {j : Piece B t} (hj : IsOuter B t j) :
    piece B r R t j ⊆ {z | R < ‖z‖} := by
  have hR0 := R_pos h0B hr hR
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact absurd hj (by simp [IsOuter])
  · exact absurd hj (by simp [IsOuter])
  · exact absurd hj (by simp [IsOuter])
  · rintro z ⟨hz0, -, hz⟩
    rw [mem_ball, dist_zero_right, norm_inv] at hz
    exact (inv_lt_inv₀ (norm_pos_iff.mpr hz0) hR0).mp hz
  · exact fun z hz ↦ hz

include h0B hr hR ht in
private theorem isInner_or_eq_invSet (j : Piece B t) : IsInner B t j ∨
    (piece B r R t j = invSet (invPiece B r R t j) ∧ Convex ℝ (invPiece B r R t j) ∧
      IsOpen (invPiece B r R t j) ∧ Bornology.IsBounded (invPiece B r R t j) ∧
      (IsPlain B t j → (0 : ℂ) ∉ invPiece B r R t j)) := by
  have hR0 := R_pos h0B hr hR
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact Or.inl trivial
  · exact Or.inl trivial
  · right
    have hc : r / 2 < ‖(c : ℂ)‖ := by
      have := ht c c.2 0 h0B
      rw [sub_zero] at this
      linarith
    obtain ⟨C, hC, hCc, hCo, hCb, hC0⟩ := exists_ball_eq_invSet (half_pos hr).le hc
    have himg : (fun z : ℂ ↦ z⁻¹) '' ball (c : ℂ) (r / 2) = C := by
      rw [hC, inv_image_invSet hC0]
    simp only [piece, invPiece, himg]
    exact ⟨hC, hCc, hCo, hCb, fun _ ↦ hC0⟩
  · right
    exact ⟨rfl, (convex_cone m).inter (convex_ball _ _), (isOpen_cone m).inter isOpen_ball,
      isBounded_ball.subset inter_subset_right, fun _ h ↦ zero_notMem_cone m h.1⟩
  · right
    refine ⟨?_, convex_ball _ _, isOpen_ball, isBounded_ball, fun h ↦ absurd h (by simp [IsPlain])⟩
    ext z
    simp only [piece, invPiece, invSet, mem_setOf_eq, mem_ball, dist_zero_right, norm_inv]
    constructor
    · intro h
      have hz : z ≠ 0 := by rintro rfl; simp at h; linarith
      exact ⟨hz, (inv_lt_inv₀ (norm_pos_iff.mpr hz) hR0).mpr h⟩
    · rintro ⟨hz, h⟩
      exact (inv_lt_inv₀ (norm_pos_iff.mpr hz) hR0).mp h

private theorem isOuter_or_convex (j : Piece B t) : IsOuter B t j ∨
    (Convex ℝ (piece B r R t j) ∧ Bornology.IsBounded (piece B r R t j)) := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact Or.inr ⟨convex_ball _ _, isBounded_ball⟩
  · right
    refine ⟨?_, isBounded_ball.subset (fun z hz ↦ by
      rw [mem_ball, dist_eq_norm]; exact hz.2)⟩
    have : bsec r b m = (fun z ↦ -(b : ℂ) + z) ⁻¹' (cone m ∩ ball 0 r) := by
      ext z
      simp [bsec, neg_add_eq_sub]
    simp only [piece, this]
    exact ((convex_cone m).inter (convex_ball _ _)).translate_preimage_right _
  · exact Or.inr ⟨convex_ball _ _, isBounded_ball⟩
  · exact Or.inl trivial
  · exact Or.inl trivial

include h0B hr hR ht in
/-- **The downstairs cover is good.** Every nonempty intersection of pieces containing a piece
away from `B` is connected and homeomorphic to `ℝ²`. -/
private theorem piece_iInter_good (I : Finset (Piece B t)) (hp : ∃ j ∈ I, IsPlain B t j)
    (hne : (⋂ j ∈ I, piece B r R t j).Nonempty) :
    IsPreconnected (⋂ j ∈ I, piece B r R t j) ∧
      Nonempty (↥(⋂ j ∈ I, piece B r R t j) ≃ₜ EuclideanSpace ℝ (Fin 2)) := by
  obtain ⟨j₀, hj₀, hpj₀⟩ := hp
  have hI : I.Nonempty := ⟨j₀, hj₀⟩
  obtain ⟨z, hz⟩ := hne
  rw [mem_iInter₂] at hz
  by_cases hout : ∃ j ∈ I, IsOuter B t j
  · obtain ⟨j₁, hj₁, ho₁⟩ := hout
    have hnin : ∀ j ∈ I, ¬ IsInner B t j := by
      intro j hj hin
      have h1 := piece_subset_of_isInner hR hin (hz j hj)
      have h2 := piece_subset_of_isOuter h0B hr hR ho₁ (hz j₁ hj₁)
      rw [mem_ball, dist_zero_right] at h1
      exact absurd h2 (not_lt.mpr h1.le)
    have hu : ∀ j ∈ I, piece B r R t j = invSet (invPiece B r R t j) ∧
        Convex ℝ (invPiece B r R t j) ∧ IsOpen (invPiece B r R t j) ∧
        Bornology.IsBounded (invPiece B r R t j) ∧
        (IsPlain B t j → (0 : ℂ) ∉ invPiece B r R t j) := fun j hj ↦
      (isInner_or_eq_invSet h0B hr hR ht j).resolve_left (hnin j hj)
    have heq : (⋂ j ∈ I, piece B r R t j) = invSet (⋂ j ∈ I, invPiece B r R t j) := by
      rw [← invSet_iInter hI]
      exact iInter₂_congr fun j hj ↦ (hu j hj).1
    rw [heq]
    refine invSet_good (convex_iInter₂ fun j hj ↦ (hu j hj).2.1)
      (isOpen_biInter_finset fun j hj ↦ (hu j hj).2.2.1)
      ((hu j₀ hj₀).2.2.2.1.subset (biInter_subset_of_mem hj₀))
      (fun h ↦ (hu j₀ hj₀).2.2.2.2 hpj₀ (mem_iInter₂.mp h j₀ hj₀)) ?_
    rw [← heq]
    exact ⟨z, mem_iInter₂.mpr hz⟩
  · simp only [not_exists, not_and] at hout
    have hc : ∀ j ∈ I, Convex ℝ (piece B r R t j) ∧ Bornology.IsBounded (piece B r R t j) :=
      fun j hj ↦ (isOuter_or_convex j).resolve_left (hout j hj)
    have hcv := convex_iInter₂ fun j hj ↦ (hc j hj).1
    exact ⟨hcv.isPreconnected, nonempty_homeomorph_of_convex hcv
      (isOpen_biInter_finset fun j _ ↦ isOpen_piece j)
      ((hc j₀ hj₀).2.subset (biInter_subset_of_mem hj₀)) ⟨z, mem_iInter₂.mpr hz⟩⟩

private theorem norm_dir (m : Fin 4) : ‖dir m‖ = 1 := by
  fin_cases m <;> simp [dir]

private theorem smul_dir_mem_cone (m : Fin 4) {a : ℝ} (ha : 0 < a) : (a : ℂ) * dir m ∈ cone m := by
  simp only [cone, mem_setOf_eq, norm_mul, Complex.norm_real, Real.norm_of_nonneg ha.le,
    norm_dir, mul_one]
  have : conj (dir m) * ((a : ℂ) * dir m) = (a : ℂ) * (Complex.normSq (dir m) : ℂ) := by
    rw [Complex.normSq_eq_conj_mul_self]; ring
  rw [this, ← Complex.ofReal_mul, Complex.ofReal_re, Complex.normSq_eq_norm_sq, norm_dir]
  linarith

include h0B hr hR hsep ht in
/-- The pieces away from `B` avoid `B` and are contractible. -/
private theorem plain_piece (j : Piece B t) (hj : IsPlain B t j) :
    Disjoint (piece B r R t j) (B : Set ℂ) ∧ ContractibleSpace (piece B r R t j) := by
  have hR0 := R_pos h0B hr hR
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact absurd hj (by simp [IsPlain])
  · refine ⟨Set.disjoint_left.mpr fun z hz hzB ↦ ?_, ?_⟩
    · change z ∈ bsec r b m at hz
      by_cases hzb : z = b
      · subst hzb
        exact zero_notMem_cone m (by simpa using hz.1)
      · have := hsep z hzB b b.2 hzb
        linarith [hz.2]
    · have hc := (isOuter_or_convex (B := B) (r := r) (R := R) (t := t)
        (Sum.inr (Sum.inl (b, m)))).resolve_left
        (by simp [IsOuter])
      refine hc.1.contractibleSpace ⟨b + ((r / 2 : ℝ) : ℂ) * dir m, ?_⟩
      change _ ∈ bsec r b m
      simp only [bsec, mem_setOf_eq, add_sub_cancel_left]
      refine ⟨smul_dir_mem_cone m (half_pos hr), ?_⟩
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (half_pos hr).le, norm_dir]
      linarith
  · refine ⟨Set.disjoint_left.mpr fun z hz hzB ↦ ?_, ?_⟩
    · change z ∈ ball (c : ℂ) (r / 2) at hz
      have := ht c c.2 z hzB
      rw [mem_ball, dist_eq_norm, ← norm_neg, neg_sub] at hz
      linarith
    · exact (convex_ball _ _).contractibleSpace ⟨c, mem_ball_self (half_pos hr)⟩
  · refine ⟨Set.disjoint_left.mpr fun z hz hzB ↦ ?_, ?_⟩
    · have h1 := piece_subset_of_isOuter h0B hr hR (j := Sum.inr (Sum.inr (Sum.inr (Sum.inl m))))
        (by simp [IsOuter]) hz
      have h2 := hR z hzB
      simp only [mem_setOf_eq] at h1
      linarith
    · have h0 : (0 : ℂ) ∉ cone m ∩ ball 0 R⁻¹ := fun h ↦ zero_notMem_cone m h.1
      haveI : ContractibleSpace ↥(cone m ∩ ball 0 R⁻¹) := by
        refine ((convex_cone m).inter (convex_ball _ _)).contractibleSpace
          ⟨((R⁻¹ / 2 : ℝ) : ℂ) * dir m, smul_dir_mem_cone m (by positivity), ?_⟩
        rw [mem_ball, dist_zero_right, norm_mul, Complex.norm_real, norm_dir, mul_one,
          Real.norm_of_nonneg (by positivity)]
        have : 0 < R⁻¹ := inv_pos.mpr hR0
        linarith
      exact (invSetHomeomorph h0).contractibleSpace
  · exact absurd hj (by simp [IsPlain])

include h0B hr hR hcov in
/-- Every point off `B` lies in a piece away from `B`. -/
private theorem exists_plain_mem {z : ℂ} (hz : z ∉ (B : Set ℂ)) :
    ∃ j, IsPlain B t j ∧ z ∈ piece B r R t j := by
  have hR0 := R_pos h0B hr hR
  by_cases hzR : R < ‖z‖
  · have hz0 : z ≠ 0 := by rintro rfl; simp at hzR; linarith
    obtain ⟨m, hm⟩ := exists_mem_cone (inv_ne_zero hz0)
    refine ⟨Sum.inr (Sum.inr (Sum.inr (Sum.inl m))), trivial, hz0, hm, ?_⟩
    rw [mem_ball, dist_zero_right, norm_inv]
    exact (inv_lt_inv₀ (norm_pos_iff.mpr hz0) hR0).mpr hzR
  · by_cases hb : ∃ b ∈ B, ‖z - b‖ < r
    · obtain ⟨b, hbB, hzb⟩ := hb
      have hne : z - b ≠ 0 := sub_ne_zero.mpr fun h ↦ hz (h ▸ hbB)
      obtain ⟨m, hm⟩ := exists_mem_cone hne
      exact ⟨Sum.inr (Sum.inl (⟨b, hbB⟩, m)), trivial, hm, hzb⟩
    · push Not at hb hzR
      obtain ⟨c, hc, hzc⟩ := hcov z hzR hb
      refine ⟨Sum.inr (Sum.inr (Sum.inl ⟨c, hc⟩)), trivial, ?_⟩
      change z ∈ ball c (r / 2)
      rwa [mem_ball, dist_eq_norm]

end Downstairs

section Branched

variable {Z : Type*} [TopologicalSpace Z]

/-- `F` agrees near `x` with a chart whose domain lies in `S`. -/
@[expose] public def IsLocalChart (F : Z → ℂ) (S : Set Z) (x : Z) : Prop :=
  ∃ ψ : OpenPartialHomeomorph Z ℂ, x ∈ ψ.source ∧ ψ.source ⊆ S ∧ EqOn F ψ ψ.source

/-- `F` has the normal form `F = F a + φ ^ e` near `a`, in a chart `φ` centred at `a` with
domain in `S`. -/
@[expose] public def IsPowNormalForm (F : Z → ℂ) (S : Set Z) (a : Z) : Prop :=
  ∃ (e : ℕ) (φ : OpenPartialHomeomorph Z ℂ), 0 < e ∧ a ∈ φ.source ∧ φ.source ⊆ S ∧ φ a = 0 ∧
    ∀ x ∈ φ.source, F x = F a + φ x ^ e

private theorem exists_chart_comp {φ : OpenPartialHomeomorph Z ℂ} {g : ℂ → ℂ} {x : Z}
    (hx : x ∈ φ.source) {d : ℂ} (hd : d ≠ 0) (hg : HasStrictDerivAt g d (φ x)) :
    ∃ ψ : OpenPartialHomeomorph Z ℂ, x ∈ ψ.source ∧ ψ.source ⊆ φ.source ∧
      ∀ y ∈ ψ.source, ψ y = g (φ y) := by
  set G := (hg.hasStrictFDerivAt_equiv hd).toOpenPartialHomeomorph g
  refine ⟨φ.trans G, ?_, ?_, fun y _ ↦ ?_⟩
  · rw [OpenPartialHomeomorph.trans_source]
    exact ⟨hx, (hg.hasStrictFDerivAt_equiv hd).mem_toOpenPartialHomeomorph_source⟩
  · rw [OpenPartialHomeomorph.trans_source]; exact inter_subset_left
  · simp [G, HasStrictFDerivAt.toOpenPartialHomeomorph_coe]

/-- Away from its centre, a normal form `F a + φ ^ e` is a local chart. -/
private theorem isLocalChart_of_nf {F : Z → ℂ} {S : Set Z} {a : Z} {e : ℕ}
    {φ : OpenPartialHomeomorph Z ℂ} (he : 0 < e) (ha : a ∈ φ.source) (hφa : φ a = 0)
    (hF : ∀ x ∈ φ.source, F x = F a + φ x ^ e) (hS : φ.source ⊆ S) {x : Z}
    (hx : x ∈ φ.source) (hxa : x ≠ a) : IsLocalChart F S x := by
  have hφx : φ x ≠ 0 := fun h ↦ hxa (φ.injOn hx ha (h.trans hφa.symm))
  have hd : HasStrictDerivAt (fun w : ℂ ↦ F a + w ^ e) ((e : ℂ) * φ x ^ (e - 1)) (φ x) :=
    (hasStrictDerivAt_pow e (φ x)).const_add (F a)
  obtain ⟨ψ, hxψ, hψ, hψeq⟩ := exists_chart_comp hx
    (mul_ne_zero (by exact_mod_cast he.ne') (pow_ne_zero _ hφx)) hd
  exact ⟨ψ, hxψ, hψ.trans hS, fun y hy ↦ by rw [hψeq y hy, hF y (hψ hy)]⟩

/-- Near a zero of `F'` of normal form `φ ^ e`, the reciprocal `F = 1 / F'` is a local chart
away from the zero. -/
private theorem isLocalChart_of_nf_inv {F F' : Z → ℂ} {S : Set Z} (hS : IsOpen S) {q : Z} {e : ℕ}
    {φ : OpenPartialHomeomorph Z ℂ} (he : 0 < e) (hq : q ∈ φ.source) (hφq : φ q = 0)
    (hF' : ∀ x ∈ φ.source, F' x = F' q + φ x ^ e) (hq0 : F' q = 0)
    (hrel : ∀ x ∈ φ.source, x ∈ S → F x * F' x = 1) {x : Z} (hx : x ∈ φ.source) (hxq : x ≠ q)
    (hxS : x ∈ S) : IsLocalChart F S x := by
  have hφx : φ x ≠ 0 := fun h ↦ hxq (φ.injOn hx hq (h.trans hφq.symm))
  have hd := (hasStrictDerivAt_inv (pow_ne_zero e hφx)).comp (φ x) (hasStrictDerivAt_pow e (φ x))
  obtain ⟨ψ, hxψ, hψ, hψeq⟩ := exists_chart_comp hx
    (mul_ne_zero (neg_ne_zero.mpr (inv_ne_zero (pow_ne_zero _ (pow_ne_zero _ hφx))))
      (mul_ne_zero (by exact_mod_cast he.ne') (pow_ne_zero _ hφx))) hd
  refine ⟨ψ.restrOpen S hS, ⟨hxψ, hxS⟩, fun y hy ↦ hy.2, fun y hy ↦ ?_⟩
  have hy' : y ∈ ψ.source := hy.1
  change F y = ψ y
  rw [hψeq y hy', Function.comp_apply]
  have h1 := hrel y (hψ hy') hy.2
  rw [hF' y (hψ hy'), hq0, zero_add] at h1
  exact eq_inv_of_mul_eq_one_left h1

/-- A set all of whose points are isolated among it, in the sense that every point of a compact
space has a neighbourhood meeting it in at most that point, is finite. -/
private theorem finite_of_forall_nhds [CompactSpace Z] {K : Set Z}
    (h : ∀ z, ∃ N ∈ 𝓝 z, K ∩ N ⊆ {z}) : K.Finite := by
  choose N hN hK using h
  obtain ⟨t, -, ht⟩ := isCompact_univ.elim_nhds_subcover N (fun z _ ↦ hN z)
  refine t.finite_toSet.subset fun x hx ↦ ?_
  obtain ⟨z, hz, hxz⟩ := mem_iUnion₂.mp (ht (mem_univ x))
  have := hK z ⟨hx, hxz⟩
  rw [mem_singleton_iff] at this
  exact this ▸ hz

private theorem exists_pos_le_of_finite {α : Type*} {s : Set α} (hs : s.Finite) (f : α → ℝ)
    (hf : ∀ a ∈ s, 0 < f a) : ∃ ε > 0, ∀ a ∈ s, ε ≤ f a := by
  induction s, hs using Set.Finite.induction_on with
  | empty => exact ⟨1, one_pos, fun a ha ↦ absurd ha (notMem_empty a)⟩
  | @insert a s _ _ ih =>
    obtain ⟨ε, hε, hεs⟩ := ih fun b hb ↦ hf b (mem_insert_of_mem a hb)
    refine ⟨min ε (f a), lt_min hε (hf a (mem_insert a s)), fun b hb ↦ ?_⟩
    rcases mem_insert_iff.mp hb with rfl | hb
    · exact min_le_right _ _
    · exact (min_le_left _ _).trans (hεs b hb)

/-- The data of a branched covering of the Riemann sphere, read in the two affine charts: `F`
on the open `S` and `F' = 1 / F` on the open `S'`. -/
public structure BranchedCoverData (Z : Type*) [TopologicalSpace Z] where
  /-- The preimage of the affine chart `ℂ` of `ℙ¹`. -/
  S : Set Z
  /-- The preimage of the affine chart `ℙ¹ ∖ {0}`. -/
  S' : Set Z
  /-- The covering map read in the coordinate `z` on `S`. -/
  F : Z → ℂ
  /-- The covering map read in the coordinate `1 / z` on `S'`. -/
  F' : Z → ℂ
  /-- `S` is open. -/
  isOpen : IsOpen S
  /-- `S'` is open. -/
  isOpen' : IsOpen S'
  /-- `S` and `S'` cover the space. -/
  union : S ∪ S' = univ
  /-- `F` is continuous on `S`. -/
  cont : ContinuousOn F S
  /-- `F'` is continuous on `S'`. -/
  cont' : ContinuousOn F' S'
  /-- On the overlap the two coordinates are reciprocal. -/
  mul : ∀ x ∈ S, x ∈ S' → F x * F' x = 1
  /-- Off `S'` the map lies over `0`. -/
  zero : ∀ x ∈ S, x ∉ S' → F x = 0
  /-- Off `S` the map lies over `∞`. -/
  zero' : ∀ x ∈ S', x ∉ S → F' x = 0
  /-- `F` has a power normal form at every point of `S`. -/
  nf : ∀ a ∈ S, IsPowNormalForm F S a
  /-- `F'` has a power normal form at every point of `S'`. -/
  nf' : ∀ a ∈ S', IsPowNormalForm F' S' a

namespace BranchedCoverData

/-- The same data, with the two charts exchanged. -/
private def swap (D : BranchedCoverData Z) : BranchedCoverData Z where
  S := D.S'
  S' := D.S
  F := D.F'
  F' := D.F
  isOpen := D.isOpen'
  isOpen' := D.isOpen
  union := by rw [union_comm]; exact D.union
  cont := D.cont'
  cont' := D.cont
  mul x hx hx' := by rw [mul_comm]; exact D.mul x hx' hx
  zero := D.zero'
  zero' := D.zero
  nf := D.nf'
  nf' := D.nf

variable (D : BranchedCoverData Z)

/-- The critical points of `F`: those where `F` is not a local chart. -/
@[expose] public def criticalSet : Set Z := {x | x ∈ D.S ∧ ¬ IsLocalChart D.F D.S x}

/-- Membership in `criticalSet`. -/
@[simp] public theorem mem_criticalSet {x : Z} :
    x ∈ D.criticalSet ↔ x ∈ D.S ∧ ¬ IsLocalChart D.F D.S x := Iff.rfl

/-- A branched cover of a compact space has finitely many critical points. -/
public theorem finite_criticalSet [CompactSpace Z] : D.criticalSet.Finite := by
  refine finite_of_forall_nhds fun z ↦ ?_
  by_cases hz : z ∈ D.S
  · obtain ⟨e, φ, he, hzφ, hφS, hφz, hF⟩ := D.nf z hz
    refine ⟨φ.source, φ.open_source.mem_nhds hzφ, fun x ⟨hxc, hxφ⟩ ↦ ?_⟩
    by_contra hxz
    exact hxc.2 (isLocalChart_of_nf he hzφ hφz hF hφS hxφ hxz)
  · have hz' : z ∈ D.S' := by
      have := D.union ▸ mem_univ z
      exact this.resolve_left hz
    obtain ⟨e, φ, he, hzφ, hφS, hφz, hF⟩ := D.nf' z hz'
    refine ⟨φ.source, φ.open_source.mem_nhds hzφ, fun x ⟨hxc, hxφ⟩ ↦ ?_⟩
    have hxz : x ≠ z := fun h ↦ hz (h ▸ hxc.1)
    exact absurd (isLocalChart_of_nf_inv D.isOpen he hzφ hφz hF (D.zero' z hz' hz)
      (fun y hy hyS ↦ D.mul y hyS (hφS hy)) hxφ hxz hxc.1) hxc.2

private theorem isClosed_inter_preimage {K : Set ℂ} (hK : IsCompact K) :
    IsClosed (D.S ∩ D.F ⁻¹' K) := by
  obtain ⟨ρ, hρ⟩ := hK.isBounded.subset_closedBall 0
  set ρ' := max ρ 0
  refine isOpen_compl_iff.mp (isOpen_iff_mem_nhds.mpr fun x hx ↦ ?_)
  by_cases hxS : x ∈ D.S
  · have hxK : D.F x ∉ K := fun h ↦ hx ⟨hxS, h⟩
    refine Filter.mem_of_superset ((D.cont.isOpen_inter_preimage D.isOpen
      hK.isClosed.isOpen_compl).mem_nhds ⟨hxS, hxK⟩) fun y hy hy' ↦ hy.2 hy'.2
  · have hx' : x ∈ D.S' := (D.union ▸ mem_univ x).resolve_left hxS
    have hV := D.cont'.isOpen_inter_preimage D.isOpen' (isOpen_ball (x := (0 : ℂ))
      (ε := (ρ' + 1)⁻¹))
    have hx0 : x ∈ D.S' ∩ D.F' ⁻¹' ball 0 (ρ' + 1)⁻¹ := by
      refine ⟨hx', ?_⟩
      rw [mem_preimage, D.zero' x hx' hxS]
      exact mem_ball_self (by positivity)
    refine Filter.mem_of_superset (hV.mem_nhds hx0) fun y hy hy' ↦ ?_
    have h1 := D.mul y hy'.1 hy.1
    have h2 : ‖D.F y‖ ≤ ρ' := by
      have := hρ hy'.2
      rw [mem_closedBall, dist_zero_right] at this
      exact this.trans (le_max_left _ _)
    have h3 : ‖D.F' y‖ < (ρ' + 1)⁻¹ := by
      have := hy.2
      rwa [mem_preimage, mem_ball, dist_zero_right] at this
    have h4 : ‖D.F y‖ * ‖D.F' y‖ = 1 := by rw [← norm_mul, h1, norm_one]
    have h5 : 0 ≤ ρ' := le_max_right _ _
    have h6 : ‖D.F y‖ * ‖D.F' y‖ ≤ ρ' * (ρ' + 1)⁻¹ :=
      mul_le_mul h2 h3.le (norm_nonneg _) h5
    have h7 : ρ' * (ρ' + 1)⁻¹ < 1 := by
      rw [← div_eq_mul_inv, div_lt_one (by positivity)]; linarith
    linarith

/-- Every fibre of `F` over a point of `ℂ` meets `S` in a finite set. -/
public theorem finite_fibre [CompactSpace Z] (b : ℂ) : (D.S ∩ D.F ⁻¹' {b}).Finite := by
  refine finite_of_forall_nhds fun z ↦ ?_
  by_cases hz : z ∈ D.S ∩ D.F ⁻¹' {b}
  · obtain ⟨e, φ, he, hzφ, hφS, hφz, hF⟩ := D.nf z hz.1
    refine ⟨φ.source, φ.open_source.mem_nhds hzφ, fun x ⟨hx, hxφ⟩ ↦ ?_⟩
    have h1 := hF x hxφ
    rw [show D.F x = b from hx.2, show D.F z = b from hz.2, left_eq_add] at h1
    have : φ x = φ z := by rw [hφz]; exact pow_eq_zero_iff he.ne' |>.mp h1
    exact φ.injOn hxφ hzφ this
  · exact ⟨_, (D.isClosed_inter_preimage isCompact_singleton).isOpen_compl.mem_nhds hz,
      fun x hx ↦ absurd hx.1 hx.2⟩

private theorem exists_radius [CompactSpace Z] (b : ℂ) {O : Set Z} (hO : IsOpen O)
    (hsub : D.S ∩ D.F ⁻¹' {b} ⊆ O) : ∃ r > 0, D.S ∩ D.F ⁻¹' ball b r ⊆ O := by
  by_contra h
  push Not at h
  let t : ℕ → Set Z := fun n ↦ (D.S ∩ D.F ⁻¹' closedBall b (1 / (n + 1))) ∩ Oᶜ
  have hcl : ∀ n, IsClosed (t n) := fun n ↦
    (D.isClosed_inter_preimage (isCompact_closedBall _ _)).inter hO.isClosed_compl
  have ht : (⋂ n, t n).Nonempty := by
    refine IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed t
      (fun n x hx ↦ ⟨⟨hx.1.1, closedBall_subset_closedBall (by
        gcongr; linarith) hx.1.2⟩, hx.2⟩) (fun n ↦ ?_) (hcl 0).isCompact hcl
    obtain ⟨x, hx, hxO⟩ := not_subset.mp (h (1 / (n + 1)) (by positivity))
    exact ⟨x, ⟨hx.1, ball_subset_closedBall hx.2⟩, hxO⟩
  obtain ⟨x, hx⟩ := ht
  rw [mem_iInter] at hx
  have hxb : D.F x = b := by
    by_contra hne
    have hd : 0 < dist (D.F x) b := dist_pos.mpr hne
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hd
    have := (hx n).1.2
    rw [mem_preimage, mem_closedBall] at this
    linarith
  exact (hx 0).2 (hsub ⟨(hx 0).1.1, hxb⟩)

/-- **Disks over a value.** For small `r`, the part of `F⁻¹ (ball b r)` in `S` is the disjoint
union of planes `Dk a`, one around each point `a` of the fibre over `b`. -/
private theorem disk [CompactSpace Z] [T2Space Z] (b : ℂ) : ∃ r₀ > 0, ∀ r, 0 < r → r ≤ r₀ →
    ∃ Dk : Z → Set Z,
      (∀ a ∈ D.S ∩ D.F ⁻¹' {b}, IsOpen (Dk a) ∧ a ∈ Dk a ∧ Dk a ⊆ D.S ∩ D.F ⁻¹' ball b r ∧
        Nonempty (Dk a ≃ₜ EuclideanSpace ℝ (Fin 2))) ∧
      (D.S ∩ D.F ⁻¹' {b}).PairwiseDisjoint Dk ∧
      D.S ∩ D.F ⁻¹' ball b r ⊆ ⋃ a ∈ D.S ∩ D.F ⁻¹' {b}, Dk a := by
  classical
  set Φ := D.S ∩ D.F ⁻¹' {b} with hΦdef
  have hΦ := D.finite_fibre b
  obtain ⟨U, hU, hUd⟩ := hΦ.t2_separation
  have hnf : ∀ a : Φ, ∃ (e : ℕ) (φ : OpenPartialHomeomorph Z ℂ), 0 < e ∧ a.1 ∈ φ.source ∧
      φ.source ⊆ D.S ∩ U a ∧ φ a = 0 ∧ (∀ x ∈ φ.source, D.F x = b + φ x ^ e) ∧
      ∃ ρ > 0, ball 0 ρ ⊆ φ.target := by
    intro a
    obtain ⟨e, φ, he, haφ, hφS, hφa, hF⟩ := D.nf a a.2.1
    let φ' := φ.restrOpen (U a) (hU a).2
    have ha' : a.1 ∈ φ'.source := ⟨haφ, (hU a).1⟩
    obtain ⟨ρ, hρ, hρt⟩ := Metric.isOpen_iff.mp φ'.open_target (φ' a) (φ'.map_source ha')
    refine ⟨e, φ', he, ha', fun x hx ↦ ⟨hφS hx.1, hx.2⟩, hφa, fun x hx ↦ ?_, ρ, hρ, ?_⟩
    · rw [show φ' x = φ x from rfl, ← show D.F a = b from a.2.2]
      exact hF x hx.1
    · rwa [show φ' a = φ a from rfl, hφa] at hρt
  choose e φ he haφ hφS hφa hF ρ hρ hρt using hnf
  set O := ⋃ a : Φ, (φ a).source
  have hO : IsOpen O := isOpen_iUnion fun a ↦ (φ a).open_source
  obtain ⟨r₁, hr₁, hr₁O⟩ := D.exists_radius b hO fun x hx ↦ mem_iUnion.mpr ⟨⟨x, hx⟩, haφ _⟩
  haveI : Finite Φ := hΦ.to_subtype
  obtain ⟨ε, hε, hεle⟩ := exists_pos_le_of_finite (Set.toFinite (univ : Set Φ))
    (fun a ↦ ρ a ^ e a) fun a _ ↦ pow_pos (hρ a) _
  refine ⟨min r₁ ε, lt_min hr₁ hε, fun r hr hrr ↦ ?_⟩
  let Dk : Z → Set Z := fun x ↦ if h : x ∈ Φ then (φ ⟨x, h⟩).source ∩ D.F ⁻¹' ball b r else ∅
  have hDk : ∀ a : Φ, Dk a = (φ a).source ∩ D.F ⁻¹' ball b r := fun a ↦ by
    simp only [Dk, dif_pos a.2]
  refine ⟨Dk, fun a ha ↦ ?_, fun a ha a' ha' hne ↦ ?_, fun x hx ↦ ?_⟩
  · rw [hDk ⟨a, ha⟩]
    set a' : Φ := ⟨a, ha⟩
    refine ⟨(D.cont.mono fun x hx ↦ (hφS a' hx).1).isOpen_inter_preimage (φ a').open_source
      isOpen_ball, ⟨haφ a', ?_⟩, fun x hx ↦ ⟨(hφS a' hx.1).1, hx.2⟩, ?_⟩
    · rw [mem_preimage, show D.F a = b from ha.2]; exact mem_ball_self hr
    · set s : ℝ := r ^ ((e a' : ℝ)⁻¹)
      have hs0 : 0 ≤ s := Real.rpow_nonneg hr.le _
      have hse : s ^ e a' = r := Real.rpow_inv_natCast_pow hr.le (he a').ne'
      have hsρ : s ≤ ρ a' := by
        refine (pow_le_pow_iff_left₀ hs0 (hρ a').le (he a').ne').mp ?_
        rw [hse]
        exact hrr.trans ((min_le_right _ _).trans (hεle a' (mem_univ _)))
      have heq : (φ a').source ∩ D.F ⁻¹' ball b r = (φ a').source ∩ φ a' ⁻¹' ball 0 s := by
        ext x
        simp only [mem_inter_iff, mem_preimage, mem_ball, dist_eq_norm, sub_zero]
        refine ⟨fun ⟨hx, h⟩ ↦ ⟨hx, ?_⟩, fun ⟨hx, h⟩ ↦ ⟨hx, ?_⟩⟩
        · rw [hF a' x hx, add_sub_cancel_left, norm_pow, ← hse] at h
          exact (pow_lt_pow_iff_left₀ (norm_nonneg _) hs0 (he a').ne').mp h
        · rw [hF a' x hx, add_sub_cancel_left, norm_pow, ← hse]
          exact pow_lt_pow_left₀ h (norm_nonneg _) (he a').ne'
      rw [heq]
      obtain ⟨h1⟩ := nonempty_homeomorph_inter_preimage (φ a').open_source (φ a').continuousOn
        (φ a').injOn (fun V hV hVo ↦ (φ a').isOpen_image_of_subset_source hVo hV)
        (W := ball 0 s) (by
          rw [(φ a').image_source_eq_target]
          exact (ball_subset_ball hsρ).trans (hρt a'))
      obtain ⟨h2⟩ := nonempty_homeomorph_of_convex (convex_ball (0 : ℂ) s) isOpen_ball
        isBounded_ball ⟨0, mem_ball_self (Real.rpow_pos_of_pos hr _)⟩
      exact ⟨h1.trans h2⟩
  · refine Disjoint.mono ?_ ?_ (hUd ha ha' hne)
    · rw [hDk ⟨a, ha⟩]; exact fun x hx ↦ (hφS ⟨a, ha⟩ hx.1).2
    · rw [hDk ⟨a', ha'⟩]; exact fun x hx ↦ (hφS ⟨a', ha'⟩ hx.1).2
  · have hxO := hr₁O ⟨hx.1, ball_subset_ball (hrr.trans (min_le_left _ _)) hx.2⟩
    obtain ⟨a, ha⟩ := mem_iUnion.mp hxO
    refine mem_iUnion₂.mpr ⟨a, a.2, ?_⟩
    rw [hDk a]
    exact ⟨ha, hx.2⟩

/-- The restriction of `F` to `S`. -/
@[expose] public def proj : D.S → ℂ := D.S.restrict D.F

/-- `proj` is `F` on `S`. -/
@[simp] public theorem proj_apply (x : D.S) : D.proj x = D.F x := rfl

/-- The restriction `proj` is continuous. -/
public theorem continuous_proj : Continuous D.proj := D.cont.restrict

/-- On a compact space, `proj` is a proper map. -/
public theorem isProperMap_proj [CompactSpace Z] : IsProperMap D.proj := by
  refine isProperMap_iff_isCompact_preimage.mpr ⟨D.continuous_proj, fun K hK ↦ ?_⟩
  rw [Subtype.isCompact_iff]
  have : Subtype.val '' (D.proj ⁻¹' K) = D.S ∩ D.F ⁻¹' K := by
    ext x
    exact ⟨fun ⟨y, hy, hyx⟩ ↦ hyx ▸ ⟨y.2, hy⟩, fun ⟨hx, hxK⟩ ↦ ⟨⟨x, hx⟩, hxK, rfl⟩⟩
  rw [this]
  exact (D.isClosed_inter_preimage hK).isCompact

/-- Off any set containing the critical values, `proj` is a covering map. -/
public theorem isCoveringMapOn_proj [CompactSpace Z] [T2Space Z] {B : Set ℂ}
    (hB : D.F '' D.criticalSet ⊆ B) : IsCoveringMapOn D.proj Bᶜ := by
  refine D.isProperMap_proj.isClosedMap.isCoveringMapOn_of_isLocalHomeomorphOn
    (fun z _ ↦ ((D.finite_fibre z).preimage Subtype.val_injective.injOn).subset
      fun x hx ↦ ⟨x.2, hx⟩) ?_
  refine IsLocalHomeomorphOn.mk _ _ fun x hx ↦ ?_
  obtain ⟨ψ, hxψ, hψS, hψ⟩ : IsLocalChart D.F D.S x :=
    Classical.byContradiction fun h ↦ hx (hB ⟨x, ⟨x.2, h⟩, rfl⟩)
  haveI : Nonempty (⟨D.S, D.isOpen⟩ : TopologicalSpace.Opens Z) := ⟨x⟩
  refine ⟨ψ.subtypeRestr (s := ⟨D.S, D.isOpen⟩) inferInstance, ?_, fun y hy ↦ ?_⟩
  · rw [OpenPartialHomeomorph.subtypeRestr_source]
    exact hxψ
  · rw [OpenPartialHomeomorph.subtypeRestr_source] at hy
    rw [OpenPartialHomeomorph.subtypeRestr_coe]
    exact hψ hy

/-- **Sheets over a contractible open set off the branch values.** -/
public theorem exists_sheets [CompactSpace Z] [T2Space Z] {B : Set ℂ}
    (hB : D.F '' D.criticalSet ⊆ B) {A : Set ℂ}
    (hAo : IsOpen A) (hAB : Disjoint A B) [ContractibleSpace A] (v₀ : A) :
    ∃ Sh : Z → Set Z,
      (∀ y ∈ D.S ∩ D.F ⁻¹' {v₀.1}, IsOpen (Sh y) ∧ Sh y ⊆ D.S ∧ InjOn D.F (Sh y) ∧
        D.F '' Sh y = A ∧ (∀ V ⊆ Sh y, IsOpen V → IsOpen (D.F '' V)) ∧ y ∈ Sh y) ∧
      (D.S ∩ D.F ⁻¹' {v₀.1}).PairwiseDisjoint Sh ∧
      D.S ∩ D.F ⁻¹' A ⊆ ⋃ y ∈ D.S ∩ D.F ⁻¹' {v₀.1}, Sh y := by
  classical
  have cov := D.isCoveringMapOn_proj hB
  haveI : LocallyPathConnectedSpace A := hAo.locallyPathConnectedSpace
  let f : C(A, ℂ) := ⟨Subtype.val, continuous_subtype_val⟩
  have hf : ∀ a, f a ∈ Bᶜ := fun a ↦ Set.disjoint_left.mp hAB a.2
  have hlift : ∀ (a : A) (e : D.S), D.proj e = a →
      ∃! L : C(A, D.S), L a = e ∧ D.proj ∘ L = f :=
    fun a e he ↦ cov.existsUnique_continuousMap_lifts f he hf
  have hFL : ∀ (L : C(A, D.S)), D.proj ∘ L = f → ∀ a, D.F (L a) = a :=
    fun L hL a ↦ congrFun hL a
  have huniq : ∀ (L L' : C(A, D.S)), D.proj ∘ L = f → D.proj ∘ L' = f → ∀ a, L a = L' a →
      L = L' :=
    fun L L' hL hL' a ha ↦ (hlift a (L a) (hFL L hL a)).unique ⟨rfl, hL⟩ ⟨ha.symm, hL'⟩
  have hL : ∀ y : ↥(D.S ∩ D.F ⁻¹' {v₀.1}), ∃ L : C(A, D.S), L v₀ = ⟨y, y.2.1⟩ ∧ D.proj ∘ L = f :=
    fun y ↦ (hlift v₀ ⟨y, y.2.1⟩ y.2.2).exists
  choose L hLv hLf using hL
  let Sh : Z → Set Z := fun y ↦
    if h : y ∈ D.S ∩ D.F ⁻¹' {v₀.1} then Subtype.val '' range (L ⟨y, h⟩) else ∅
  have hSh : ∀ y : ↥(D.S ∩ D.F ⁻¹' {v₀.1}), Sh y = Subtype.val '' range (L y) := fun y ↦ by
    simp only [Sh, dif_pos y.2]
  have hmem : ∀ (y : ↥(D.S ∩ D.F ⁻¹' {v₀.1})) (z : Z), z ∈ Sh y ↔ ∃ a, (L y a : Z) = z :=
    fun y z ↦ by simp only [hSh y, mem_image, mem_range, exists_exists_eq_and]
  refine ⟨Sh, fun y hy ↦ ?_, fun y hy y' hy' hne ↦ ?_, fun x hx ↦ ?_⟩
  · set y' : ↥(D.S ∩ D.F ⁻¹' {v₀.1}) := ⟨y, hy⟩
    have hF : ∀ a, D.F (L y' a) = a := hFL _ (hLf y')
    have himg : D.F '' Sh y = A := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        obtain ⟨a, rfl⟩ := (hmem y' w).mp hw
        rw [hF a]
        exact a.2
      · intro hz
        exact ⟨_, (hmem y' _).mpr ⟨⟨z, hz⟩, rfl⟩, hF ⟨z, hz⟩⟩
    have hcontL : Continuous fun a ↦ (L y' a : Z) := continuous_subtype_val.comp (L y').continuous
    refine ⟨?_, fun z hz ↦ ?_, fun z hz w hw hzw ↦ ?_, himg, fun V hV hVo ↦ ?_, ?_⟩
    · refine isOpen_iff_mem_nhds.mpr fun z hz ↦ ?_
      obtain ⟨a, rfl⟩ := (hmem y' z).mp hz
      obtain ⟨ψ, hzψ, hψS, hψ⟩ : IsLocalChart D.F D.S (L y' a) := Classical.byContradiction
        fun h ↦ Set.disjoint_left.mp hAB a.2 (hB ⟨_, ⟨(L y' a).2, h⟩, hF a⟩)
      set W : Set A := (fun a ↦ (L y' a : Z)) ⁻¹' ψ.source
      have hWo : IsOpen W := ψ.open_source.preimage hcontL
      have hW'o : IsOpen (Subtype.val '' W) := hAo.isOpenMap_subtype_val _ hWo
      have hN : IsOpen (ψ.source ∩ D.F ⁻¹' (Subtype.val '' W)) :=
        (D.cont.mono hψS).isOpen_inter_preimage ψ.open_source hW'o
      refine Filter.mem_of_superset (hN.mem_nhds ⟨hzψ, a, hzψ, by rw [hF a]⟩) ?_
      rintro x ⟨hxψ, a', ha'W, hxa'⟩
      refine (hmem y' x).mpr ⟨a', ψ.injOn ha'W hxψ ?_⟩
      rw [← hψ ha'W, ← hψ hxψ, hF a', hxa']
    · obtain ⟨a, rfl⟩ := (hmem y' z).mp hz
      exact (L y' a).2
    · obtain ⟨a, rfl⟩ := (hmem y' z).mp hz
      obtain ⟨a', rfl⟩ := (hmem y' w).mp hw
      rw [hF a, hF a'] at hzw
      rw [Subtype.ext hzw]
    · have : D.F '' V = Subtype.val '' ((fun a ↦ (L y' a : Z)) ⁻¹' V) := by
        ext u
        constructor
        · rintro ⟨w, hw, rfl⟩
          obtain ⟨a, rfl⟩ := (hmem y' w).mp (hV hw)
          exact ⟨a, hw, (hF a).symm⟩
        · rintro ⟨a, ha, rfl⟩
          exact ⟨_, ha, hF a⟩
      rw [this]
      exact hAo.isOpenMap_subtype_val _ (hVo.preimage hcontL)
    · exact (hmem y' y).mpr ⟨v₀, by rw [hLv y']⟩
  · refine Set.disjoint_left.mpr fun z hz hz' ↦ hne ?_
    obtain ⟨a, rfl⟩ := (hmem ⟨y, hy⟩ z).mp hz
    obtain ⟨a', ha'⟩ := (hmem ⟨y', hy'⟩ _).mp hz'
    obtain rfl : a' = a :=
      Subtype.ext (by rw [← hFL _ (hLf ⟨y, hy⟩) a, ← hFL _ (hLf ⟨y', hy'⟩) a', ha'])
    have h1 := hLv ⟨y, hy⟩
    rw [huniq _ _ (hLf ⟨y, hy⟩) (hLf ⟨y', hy'⟩) a' (Subtype.ext ha'.symm), hLv] at h1
    exact congrArg Subtype.val h1.symm
  · obtain ⟨M, hM, hMf⟩ := (hlift ⟨D.F x, hx.2⟩ ⟨x, hx.1⟩ rfl).exists
    have hy : (M v₀ : Z) ∈ D.S ∩ D.F ⁻¹' {v₀.1} := ⟨(M v₀).2, hFL M hMf v₀⟩
    refine mem_iUnion₂.mpr ⟨M v₀, hy, (hmem ⟨_, hy⟩ x).mpr ⟨⟨D.F x, hx.2⟩, ?_⟩⟩
    rw [huniq _ _ (hLf ⟨_, hy⟩) hMf v₀ (by rw [hLv]), hM]

/-- Removing one member of a disjoint open family covering an open set leaves an open set. -/
private theorem isOpen_diff_of_pairwiseDisjoint {O : Set Z} (hO : IsOpen O) {s : Set Z}
    {Dk : Z → Set Z} (hDo : ∀ a ∈ s, IsOpen (Dk a)) (hdisj : s.PairwiseDisjoint Dk)
    (hcov : O ⊆ ⋃ a ∈ s, Dk a) {a : Z} (ha : a ∈ s) : IsOpen (O \ Dk a) := by
  have : O \ Dk a = O ∩ ⋃ a' ∈ s \ {a}, Dk a' := by
    ext x
    simp only [mem_diff, mem_inter_iff, mem_iUnion, mem_singleton_iff, exists_prop]
    constructor
    · rintro ⟨hx, hxa⟩
      obtain ⟨a', ha', hxa'⟩ := mem_iUnion₂.mp (hcov hx)
      exact ⟨hx, a', ⟨ha', fun h ↦ hxa (h ▸ hxa')⟩, hxa'⟩
    · rintro ⟨hx, a', ⟨ha', hne⟩, hxa'⟩
      exact ⟨hx, fun hxa ↦ (hdisj ha' ha hne).ne_of_mem hxa' hxa rfl⟩
  rw [this]
  exact hO.inter (isOpen_biUnion fun a' ha' ↦ hDo a' ha'.1)

section Assembly

variable {B : Finset ℂ} {t : Set ℂ}

/-- Which points label the members of the cover over a piece. -/
private def upValid (D : BranchedCoverData Z) (P : Set Z) (v : Piece B t → ℂ) :
    Piece B t → Z → Prop
  | Sum.inl b, y => y ∈ D.S ∧ D.F y = b ∧ y ∉ P
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))), y => y ∈ D.S' ∧ D.F' y = 0 ∧ y ∉ P
  | j, y => y ∈ D.S ∧ D.F y = v j

/-- The member of the cover over a piece with a given label. -/
private def upSet (Dk : ℂ → Z → Set Z) (E : Z → Set Z) (Sh : Piece B t → Z → Set Z) :
    Piece B t → Z → Set Z
  | Sum.inl b, y => Dk b y
  | Sum.inr (Sum.inr (Sum.inr (Sum.inr _))), y => E y
  | j, y => Sh j y

private theorem upValid_plain {D : BranchedCoverData Z} {P : Set Z} {v : Piece B t → ℂ}
    {j : Piece B t}
    (hj : IsPlain B t j) (y : Z) : upValid D P v j y ↔ y ∈ D.S ∧ D.F y = v j := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact absurd hj (by simp [IsPlain])
  · rfl
  · rfl
  · rfl
  · exact absurd hj (by simp [IsPlain])

private theorem upSet_plain {Dk : ℂ → Z → Set Z} {E : Z → Set Z} {Sh : Piece B t → Z → Set Z}
    {j : Piece B t} (hj : IsPlain B t j) (y : Z) : upSet Dk E Sh j y = Sh j y := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact absurd hj (by simp [IsPlain])
  · rfl
  · rfl
  · rfl
  · exact absurd hj (by simp [IsPlain])

private theorem isPlain_or (j : Piece B t) :
    IsPlain B t j ∨ (∃ b, j = Sum.inl b) ∨ j = Sum.inr (Sum.inr (Sum.inr (Sum.inr ()))) := by
  rcases j with b | ⟨b, m⟩ | c | m | u
  · exact Or.inr (Or.inl ⟨b, rfl⟩)
  · exact Or.inl trivial
  · exact Or.inl trivial
  · exact Or.inl trivial
  · exact Or.inr (Or.inr rfl)

end Assembly

/-- Near `∞` the map is large: a point of `S ∩ S'` with `‖F' z‖ < R⁻¹` has `R < ‖F z‖`. -/
public theorem lt_norm_of_norm_lt_inv {R : ℝ} (hR : 0 < R) {z : Z} (hz : z ∈ D.S)
    (hz' : z ∈ D.S') (hlt : ‖D.F' z‖ < R⁻¹) : R < ‖D.F z‖ := by
  have h1 := D.mul z hz hz'
  have h2 : D.F' z ≠ 0 := right_ne_zero_of_mul_eq_one h1
  have h3 : ‖D.F z‖ = ‖D.F' z‖⁻¹ := by
    rw [← norm_inv, eq_inv_of_mul_eq_one_left h1]
  rw [h3]
  exact (lt_inv_comm₀ hR (norm_pos_iff.mpr h2)).mpr hlt

/-- A point of `S` with `R < ‖F z‖` lies in `S'` with `‖F' z‖ < R⁻¹`. -/
public theorem mem_S'_and_norm_lt_inv {R : ℝ} (hR : 0 < R) {z : Z} (hz : z ∈ D.S)
    (hlt : R < ‖D.F z‖) : z ∈ D.S' ∧ ‖D.F' z‖ < R⁻¹ := by
  have hz1 : D.F z ≠ 0 := fun h0 ↦ by
    rw [h0, norm_zero] at hlt
    linarith
  have hz' : z ∈ D.S' := by_contra fun h' ↦ hz1 (D.zero z hz h')
  refine ⟨hz', ?_⟩
  have h2 : ‖D.F' z‖ = ‖D.F z‖⁻¹ := by
    rw [← norm_inv, eq_inv_of_mul_eq_one_right (D.mul z hz hz')]
  rw [h2]
  exact inv_strictAnti₀ hR hlt

/-- **A finite good cover of a punctured branched covering of the sphere.** -/
private theorem exists_goodCover {Z : Type} [TopologicalSpace Z] [CompactSpace Z] [T2Space Z]
    (D : BranchedCoverData Z) {P : Set Z} (hP : P.Finite) :
    ∃ (ι : Type) (_ : Fintype ι) (U : ι → Set Z), (∀ i, IsOpen (U i)) ∧ (∀ i, U i ⊆ Pᶜ) ∧
      (Pᶜ ⊆ ⋃ i, U i) ∧ ∀ I : Finset ι, I.Nonempty → (⋂ i ∈ I, U i).Nonempty →
        Nonempty (↥(⋂ i ∈ I, U i) ≃ₜ EuclideanSpace ℝ (Fin 2)) := by
  classical
  set Bset : Set ℂ := insert 0 (D.F '' (D.criticalSet ∪ (P ∩ D.S))) with hBset
  have hBfin : Bset.Finite :=
    ((D.finite_criticalSet.union (hP.subset inter_subset_left)).image _).insert 0
  set B := hBfin.toFinset with hBdef
  have hBcoe : (B : Set ℂ) = Bset := hBfin.coe_toFinset
  have hmemB : ∀ b, b ∈ B ↔ b ∈ Bset := fun b ↦ hBfin.mem_toFinset
  have h0B : (0 : ℂ) ∈ B := (hmemB 0).mpr (mem_insert _ _)
  have hcrit : D.F '' D.criticalSet ⊆ (B : Set ℂ) := fun z hz ↦ by
    rw [hBcoe]; exact mem_insert_of_mem _ (image_mono subset_union_left hz)
  have hPB : ∀ x ∈ P, x ∈ D.S → D.F x ∈ Bset := fun x hx hxS ↦
    mem_insert_of_mem _ ⟨x, Or.inr ⟨hx, hxS⟩, rfl⟩
  choose r0 hr0 hdisk using D.disk
  obtain ⟨rI, hrI, hdiskI⟩ := D.swap.disk 0
  obtain ⟨εs, hεs, hεsle⟩ := exists_pos_le_of_finite
    (s := {p : ℂ × ℂ | p ∈ Bset ×ˢ Bset ∧ p.1 ≠ p.2})
    ((hBfin.prod hBfin).subset fun p hp ↦ hp.1) (fun p ↦ ‖p.1 - p.2‖)
    (fun p hp ↦ norm_pos_iff.mpr (sub_ne_zero.mpr hp.2))
  obtain ⟨εr, hεr, hεrle⟩ := exists_pos_le_of_finite hBfin r0 (fun b _ ↦ hr0 b)
  set r := min (min (εs / 2) εr) 1 with hrdef
  have hr : 0 < r := lt_min (lt_min (half_pos hεs) hεr) one_pos
  have hsep : ∀ b ∈ B, ∀ b' ∈ B, b ≠ b' → 2 * r ≤ ‖b - b'‖ := by
    intro b hb b' hb' hne
    have := hεsle (b, b') ⟨⟨(hmemB b).mp hb, (hmemB b').mp hb'⟩, hne⟩
    have h2 : r ≤ εs / 2 := (min_le_left _ _).trans (min_le_left _ _)
    simp only at this
    linarith
  have hrr0 : ∀ b ∈ Bset, r ≤ r0 b := fun b hb ↦
    ((min_le_left _ _).trans (min_le_right _ _)).trans (hεrle b hb)
  obtain ⟨M, hM⟩ := (hBfin.image norm).bddAbove
  have hM' : ∀ b ∈ Bset, ‖b‖ ≤ M := fun b hb ↦ hM ⟨b, hb, rfl⟩
  set R := max (M + r + 1) rI⁻¹ with hRdef
  have hR : ∀ b ∈ B, ‖b‖ + r < R := fun b hb ↦ by
    have := hM' b ((hmemB b).mp hb)
    have : M + r + 1 ≤ R := le_max_left _ _
    linarith
  have hRpos : 0 < R := lt_of_lt_of_le (inv_pos.mpr hrI) (le_max_right _ _)
  have hRinv : R⁻¹ ≤ rI := inv_le_of_inv_le₀ hrI (le_max_right _ _)
  set K := closedBall (0 : ℂ) R ∩ {z | ∀ b ∈ B, r ≤ ‖z - b‖}
  have hKc : IsCompact K := by
    refine (isCompact_closedBall _ _).inter_right ?_
    have : {z : ℂ | ∀ b ∈ B, r ≤ ‖z - b‖} = ⋂ b ∈ B, {z | r ≤ ‖z - b‖} := by ext; simp
    rw [this]
    exact isClosed_biInter fun b _ ↦ isClosed_le continuous_const (by fun_prop)
  obtain ⟨t, htK, htfin, htcov⟩ := hKc.finite_cover_balls (half_pos hr)
  haveI : Finite t := htfin.to_subtype
  have ht : ∀ c ∈ t, ∀ b ∈ B, r ≤ ‖c - b‖ := fun c hc ↦ (htK hc).2
  have hcov : ∀ z : ℂ, ‖z‖ ≤ R → (∀ b ∈ B, r ≤ ‖z - b‖) → ∃ c ∈ t, ‖z - c‖ < r / 2 := by
    intro z hz hzb
    obtain ⟨c, hc, hzc⟩ := mem_iUnion₂.mp (htcov ⟨by rwa [mem_closedBall, dist_zero_right], hzb⟩)
    exact ⟨c, hc, by rwa [mem_ball, dist_eq_norm] at hzc⟩
  have hDk : ∀ b : ℂ, ∃ Dk : Z → Set Z, b ∈ Bset →
      (∀ a ∈ D.S ∩ D.F ⁻¹' {b}, IsOpen (Dk a) ∧ a ∈ Dk a ∧ Dk a ⊆ D.S ∩ D.F ⁻¹' ball b r ∧
        Nonempty (Dk a ≃ₜ EuclideanSpace ℝ (Fin 2))) ∧
      (D.S ∩ D.F ⁻¹' {b}).PairwiseDisjoint Dk ∧
      D.S ∩ D.F ⁻¹' ball b r ⊆ ⋃ a ∈ D.S ∩ D.F ⁻¹' {b}, Dk a := fun b ↦ by
    by_cases hb : b ∈ Bset
    · obtain ⟨Dk, h⟩ := hdisk b r hr (hrr0 b hb)
      exact ⟨Dk, fun _ ↦ h⟩
    · exact ⟨fun _ ↦ ∅, fun h ↦ absurd h hb⟩
  choose Dk hDk using hDk
  obtain ⟨E, hE1, hE2, hE3⟩ := hdiskI R⁻¹ (inv_pos.mpr hRpos) hRinv
  have hSh : ∀ j : Piece B t, ∃ (v : ℂ) (Sh : Z → Set Z), IsPlain B t j →
      v ∈ piece B r R t j ∧
      (∀ y ∈ D.S ∩ D.F ⁻¹' {v}, IsOpen (Sh y) ∧ Sh y ⊆ D.S ∧ InjOn D.F (Sh y) ∧
        D.F '' Sh y = piece B r R t j ∧ (∀ V ⊆ Sh y, IsOpen V → IsOpen (D.F '' V)) ∧
        y ∈ Sh y) ∧
      (D.S ∩ D.F ⁻¹' {v}).PairwiseDisjoint Sh ∧
      D.S ∩ D.F ⁻¹' piece B r R t j ⊆ ⋃ y ∈ D.S ∩ D.F ⁻¹' {v}, Sh y := by
    intro j
    by_cases hj : IsPlain B t j
    · obtain ⟨hdisj, hcontr⟩ := plain_piece h0B hr hsep hR ht j hj
      obtain ⟨v₀⟩ := (inferInstance : Nonempty (piece B r R t j))
      obtain ⟨Sh, h1, h2, h3⟩ := D.exists_sheets hcrit (isOpen_piece j) hdisj v₀
      exact ⟨v₀, Sh, fun _ ↦ ⟨v₀.2, h1, h2, h3⟩⟩
    · exact ⟨0, fun _ ↦ ∅, fun h ↦ absurd h hj⟩
  choose v Sh hSh using hSh
  set Kset : Set (Piece B t × Z) := {p | upValid D P v p.1 p.2} with hKset
  have hKfin : Kset.Finite := by
    have hY : ((⋃ j, D.S ∩ D.F ⁻¹' {v j}) ∪ (⋃ b ∈ Bset, D.S ∩ D.F ⁻¹' {b}) ∪
        (D.S' ∩ D.F' ⁻¹' {0})).Finite :=
      ((finite_iUnion fun j ↦ D.finite_fibre _).union
        (hBfin.biUnion fun b _ ↦ D.finite_fibre b)).union (D.swap.finite_fibre 0)
    refine ((Set.finite_univ (α := Piece B t)).prod hY).subset ?_
    rintro ⟨j, y⟩ hp
    simp only [hKset, mem_setOf_eq] at hp
    refine ⟨mem_univ _, ?_⟩
    rcases isPlain_or j with hj | ⟨b, rfl⟩ | rfl
    · have := (upValid_plain hj y).mp hp
      exact Or.inl (Or.inl (mem_iUnion.mpr ⟨j, this.1, this.2⟩))
    · obtain ⟨h1, h2, -⟩ := hp
      exact Or.inl (Or.inr (mem_iUnion₂.mpr ⟨b, (hmemB b).mp b.2, h1, h2⟩))
    · obtain ⟨h1, h2, -⟩ := hp
      exact Or.inr ⟨h1, h2⟩
  haveI : Fintype Kset := hKfin.fintype
  have hbig : ∀ z ∈ D.S, z ∈ D.S' → ‖D.F' z‖ < R⁻¹ → R < ‖D.F z‖ :=
    fun _ ↦ D.lt_norm_of_norm_lt_inv hRpos
  have hballI : ∀ z, z ∈ D.swap.S ∩ D.swap.F ⁻¹' ball 0 R⁻¹ → ‖D.F' z‖ < R⁻¹ :=
    fun z hz ↦ mem_ball_zero_iff.mp hz.2
  have hfibB : ∀ (b : B) (y : Z), upValid D P v (Sum.inl b) y →
      y ∈ D.S ∩ D.F ⁻¹' {(b : ℂ)} := fun b y hp ↦ ⟨hp.1, hp.2.1⟩
  have hDkb : ∀ b : B, _ := fun b ↦ hDk b ((hmemB b).mp b.2)
  have hfibI : ∀ y : Z, upValid D P v (Sum.inr (Sum.inr (Sum.inr (Sum.inr ())))) y →
      y ∈ D.S' ∩ D.F' ⁻¹' {0} := fun y hp ↦ ⟨hp.1, hp.2.1⟩
  have hSo : ∀ k : Kset, IsOpen (upSet Dk E Sh k.1.1 k.1.2) := by
    rintro ⟨⟨j, y⟩, hp⟩
    simp only [hKset, mem_setOf_eq] at hp
    show IsOpen (upSet Dk E Sh j y)
    rcases isPlain_or j with hj | ⟨b, rfl⟩ | rfl
    · rw [upSet_plain hj]
      exact ((hSh j hj).2.1 y ((upValid_plain hj y).mp hp)).1
    · exact ((hDkb b).1 y (hfibB b y hp)).1
    · exact (hE1 y (hfibI y hp)).1
  have hsubP : ∀ k : Kset, upSet Dk E Sh k.1.1 k.1.2 ⊆ Pᶜ := by
    rintro ⟨⟨j, y⟩, hp⟩ z hz hzP
    simp only [hKset, mem_setOf_eq] at hp
    change z ∈ upSet Dk E Sh j y at hz
    rcases isPlain_or j with hj | ⟨b, rfl⟩ | rfl
    · rw [upSet_plain hj] at hz
      obtain ⟨-, h1, -, -⟩ := hSh j hj
      obtain ⟨-, hS, -, himg, -, -⟩ := h1 y ((upValid_plain hj y).mp hp)
      have hzA : D.F z ∈ piece B r R t j := himg ▸ mem_image_of_mem _ hz
      have := (plain_piece h0B hr hsep hR ht j hj).1
      exact Set.disjoint_left.mp this hzA (hBcoe ▸ hPB z hzP (hS hz))
    · obtain ⟨hDo, hDdisj, -⟩ := hDkb b
      obtain ⟨-, -, hsub, -⟩ := hDo y (hfibB b y hp)
      have hzS := (hsub hz).1
      have hzb : D.F z = b := by
        by_contra hne
        have := hsep _ ((hmemB _).mpr (hPB z hzP hzS)) b b.2 hne
        have h2 := (hsub hz).2
        rw [mem_preimage, mem_ball, dist_eq_norm] at h2
        linarith
      have hzf : z ∈ D.S ∩ D.F ⁻¹' {(b : ℂ)} := ⟨hzS, hzb⟩
      by_cases hzy : z = y
      · exact hp.2.2 (hzy ▸ hzP)
      · exact (hDdisj hzf (hfibB b y hp) hzy).ne_of_mem ((hDo z hzf).2.1) hz rfl
    · obtain ⟨-, -, hsub, -⟩ := hE1 y (hfibI y hp)
      by_cases hzS : z ∈ D.S
      · have h1 := hbig z hzS (hsub hz).1 (hballI z (hsub hz))
        have h2 := hM' _ (hPB z hzP hzS)
        have : M + r + 1 ≤ R := le_max_left _ _
        linarith
      · have hzf : z ∈ D.S' ∩ D.F' ⁻¹' {0} := ⟨(hsub hz).1, D.zero' z (hsub hz).1 hzS⟩
        by_cases hzy : z = y
        · exact hp.2.2 (hzy ▸ hzP)
        · exact (hE2 hzf (hfibI y hp) hzy).ne_of_mem ((hE1 z hzf).2.1) hz rfl
  have hcover : Pᶜ ⊆ ⋃ k : Kset, upSet Dk E Sh k.1.1 k.1.2 := by
    intro x hx
    rw [mem_compl_iff] at hx
    by_cases hxS : x ∈ D.S
    · by_cases hFB : D.F x ∈ Bset
      · refine mem_iUnion.mpr ⟨⟨(Sum.inl ⟨D.F x, (hmemB _).mpr hFB⟩, x), ⟨hxS, rfl, hx⟩⟩, ?_⟩
        exact ((hDk (D.F x) hFB).1 x ⟨hxS, rfl⟩).2.1
      · obtain ⟨j, hj, hxj⟩ := exists_plain_mem h0B hr hR hcov (z := D.F x) (by rwa [hBcoe])
        obtain ⟨-, -, -, hc⟩ := hSh j hj
        obtain ⟨y, hy, hxy⟩ := mem_iUnion₂.mp (hc ⟨hxS, hxj⟩)
        refine mem_iUnion.mpr ⟨⟨(j, y), (upValid_plain hj y).mpr hy⟩, ?_⟩
        show x ∈ upSet Dk E Sh j y
        rw [upSet_plain hj]
        exact hxy
    · have hx' : x ∈ D.S' := (D.union ▸ mem_univ x).resolve_left hxS
      have h0 := D.zero' x hx' hxS
      refine mem_iUnion.mpr ⟨⟨(Sum.inr (Sum.inr (Sum.inr (Sum.inr ()))), x), ⟨hx', h0, hx⟩⟩, ?_⟩
      exact (hE1 x ⟨hx', h0⟩).2.1
  refine ⟨Kset, inferInstance, fun k ↦ upSet Dk E Sh k.1.1 k.1.2, hSo, hsubP, hcover,
    fun I hI hne ↦ ?_⟩
  have hX₀ : IsOpen (D.S \ P) := D.isOpen.sdiff hP.isClosed
  refine nonempty_homeomorph_iInter_of_pullback (piece B r R t) (IsPlain B t) D.F (D.S \ P)
    (D.cont.mono diff_subset) (fun k : Kset ↦ k.1.1) (fun k ↦ upSet Dk E Sh k.1.1 k.1.2) hSo
    ?_ ?_ ?_ ?_ ?_ I hI hne
  · rintro ⟨⟨j, y⟩, hp⟩ hj
    simp only [hKset, mem_setOf_eq] at hp
    change IsPlain B t j at hj
    obtain ⟨-, h1, -, -⟩ := hSh j hj
    obtain ⟨-, hS, hinj, himg, hop, -⟩ := h1 y ((upValid_plain hj y).mp hp)
    show upSet Dk E Sh j y ⊆ D.S \ P ∧ InjOn D.F (upSet Dk E Sh j y) ∧
      D.F '' upSet Dk E Sh j y = piece B r R t j ∧ _
    rw [upSet_plain hj]
    refine ⟨fun z hz ↦ ⟨hS hz, ?_⟩, hinj, himg, hop⟩
    refine hsubP ⟨(j, y), hp⟩ ?_
    change z ∈ upSet Dk E Sh j y
    rwa [upSet_plain hj]
  · rintro ⟨⟨j, y⟩, hp⟩ hj
    simp only [hKset, mem_setOf_eq] at hp
    change ¬ IsPlain B t j at hj
    show Nonempty (upSet Dk E Sh j y ≃ₜ _) ∧ upSet Dk E Sh j y ∩ (D.S \ P) ⊆ D.F ⁻¹' piece B r R t j
    rcases isPlain_or j with hj' | ⟨b, rfl⟩ | rfl
    · exact absurd hj' hj
    · obtain ⟨-, -, hsub, he⟩ := (hDkb b).1 y (hfibB b y hp)
      exact ⟨he, fun z hz ↦ (hsub hz.1).2⟩
    · obtain ⟨-, -, hsub, he⟩ := hE1 y (hfibI y hp)
      refine ⟨he, fun z hz ↦ ?_⟩
      exact hbig z hz.2.1 (hsub hz.1).1 (hballI z (hsub hz.1))
  · rintro ⟨⟨j, y⟩, hp⟩ ⟨⟨j', y'⟩, hp'⟩ hne hj hj'
    simp only [hKset, mem_setOf_eq] at hp hp'
    change ¬ IsPlain B t j at hj
    change ¬ IsPlain B t j' at hj'
    show Disjoint (upSet Dk E Sh j y) (upSet Dk E Sh j' y')
    have hne' : (j, y) ≠ (j', y') := fun h ↦ hne (Subtype.ext h)
    have hBI : ∀ (b : B) y y', upValid D P v (Sum.inl b) y →
        upValid D P v (Sum.inr (Sum.inr (Sum.inr (Sum.inr ())))) y' →
        Disjoint (Dk b y) (E y') := by
      intro b y y' hp hp'
      refine Set.disjoint_left.mpr fun z hz hz' ↦ ?_
      have h1 := ((hDkb b).1 y (hfibB b y hp)).2.2.1 hz
      have h2 := (hE1 y' (hfibI y' hp')).2.2.1 hz'
      exact lt_asymm (hbig z h1.1 h2.1 (hballI z h2))
        (norm_lt_of_norm_sub_lt (mem_ball_iff_norm.mp h1.2) (hR b b.2))
    rcases isPlain_or j with h | ⟨b, rfl⟩ | rfl
    · exact absurd h hj
    · rcases isPlain_or j' with h' | ⟨b', rfl⟩ | rfl
      · exact absurd h' hj'
      · obtain ⟨hDo, hDdisj, -⟩ := hDkb b
        obtain ⟨hDo', -, -⟩ := hDkb b'
        by_cases hbb : b = b'
        · subst hbb
          have hyy : y ≠ y' := fun h ↦ hne' (by rw [h])
          exact hDdisj (hfibB b y hp) (hfibB b y' hp') hyy
        · refine Set.disjoint_left.mpr fun z hz hz' ↦ ?_
          have h1 : dist (D.F z) b < r := ((hDo y (hfibB b y hp)).2.2.1 hz).2
          have h2 : dist (D.F z) b' < r := ((hDo' y' (hfibB b' y' hp')).2.2.1 hz').2
          linarith [dist_triangle_left (b : ℂ) b' (D.F z), dist_eq_norm (b : ℂ) b',
            hsep b b.2 b' b'.2 (fun h ↦ hbb (Subtype.ext h))]
      · exact hBI b y y' hp hp'
    · rcases isPlain_or j' with h' | ⟨b', rfl⟩ | rfl
      · exact absurd h' hj'
      · exact (hBI b' y' y hp' hp).symm
      · have hyy : y ≠ y' := fun h ↦ hne' (by rw [h])
        exact hE2 (hfibI y hp) (hfibI y' hp') hyy
  · rintro ⟨⟨j, y⟩, hp⟩
    simp only [hKset, mem_setOf_eq] at hp
    show IsOpen ((D.S \ P ∩ D.F ⁻¹' piece B r R t j) \ upSet Dk E Sh j y)
    have hO : IsOpen (D.S \ P ∩ D.F ⁻¹' piece B r R t j) :=
      (D.cont.mono diff_subset).isOpen_inter_preimage hX₀ (isOpen_piece j)
    rcases isPlain_or j with hj | ⟨b, rfl⟩ | rfl
    · rw [upSet_plain hj]
      obtain ⟨-, h1, h2, h3⟩ := hSh j hj
      exact isOpen_diff_of_pairwiseDisjoint hO (fun y hy ↦ (h1 y hy).1) h2
        (fun z hz ↦ h3 ⟨hz.1.1, hz.2⟩) ((upValid_plain hj y).mp hp)
    · obtain ⟨hDo, hDdisj, hDc⟩ := hDkb b
      exact isOpen_diff_of_pairwiseDisjoint hO (fun y hy ↦ (hDo y hy).1) hDdisj
        (fun z hz ↦ hDc ⟨hz.1.1, hz.2⟩) (hfibB b y hp)
    · refine isOpen_diff_of_pairwiseDisjoint hO (fun y hy ↦ (hE1 y hy).1) hE2
        (fun z hz ↦ hE3 ?_) (hfibI y hp)
      obtain ⟨hz', h⟩ := D.mem_S'_and_norm_lt_inv hRpos hz.1.1 hz.2
      exact ⟨hz', mem_ball_zero_iff.mpr h⟩
  · intro I hp hne
    have heq : (⋂ k ∈ I, piece B r R t k.1.1) = ⋂ j ∈ I.image (fun k : Kset ↦ k.1.1),
        piece B r R t j := by
      rw [Finset.set_biInter_finset_image]
    rw [heq] at hne ⊢
    obtain ⟨k, hk, hpk⟩ := hp
    exact piece_iInter_good h0B hr hR ht _ ⟨k.1.1, Finset.mem_image_of_mem _ hk, hpk⟩ hne

end BranchedCoverData

end Branched

end PlaneCover

/-! ### The branched covering of the projective line -/

section BranchedP1

open CategoryTheory _root_.Topology Filter
open Stacks.AlgebraicGeometry.ProjPolyChart (polyGrading projToSpecCoeff)

attribute [local instance] MvPolynomial.gradedAlgebra

variable {Z : Type*} [TopologicalSpace Z]

/-- **Completing a smooth curve over `ℙ¹`.** A smooth connected separated complex curve `T` of
finite type is a cofinite open subscheme of a smooth proper connected curve `Y`, which admits a
finite surjective morphism `π : Y → ℙ¹` over `ℂ`. -/
public theorem exists_completion {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ))
    [SmoothOfRelativeDimension 1 sT] [QuasiCompact sT] [IsSeparated sT] [ConnectedSpace T] :
    ∃ (Y : Scheme.{0}) (g : Y ⟶ Spec (.of ℂ)) (ι : T ⟶ Y)
      (π : Y ⟶ AlgebraicGeometry.Proj (polyGrading ℂ 1)),
      IsOpenImmersion ι ∧ ι ≫ g = sT ∧ SmoothOfRelativeDimension 1 g ∧ IsProper g ∧
        ConnectedSpace Y ∧ (Set.range ι)ᶜ.Finite ∧ IsFinite π ∧ Function.Surjective π ∧
        π ≫ projToSpecCoeff ℂ 1 = g := by
  obtain ⟨Y, g, ι, hι, hcomp, hsm, hproj, hconn, hfin⟩ :=
    MMP.Curves.exists_isOpenImmersion_isProjective_of_smoothOfRelativeDimension_one ℂ sT
  haveI : Smooth g := SmoothOfRelativeDimension.smooth 1 g
  haveI : IsIntegral Y := Stacks.Chow.isIntegral_of_connectedSpace_of_smooth g
  haveI : IsProper g := IsProjective.isProper hproj
  obtain ⟨N, i, hi, hover⟩ := isProjectiveMorphism_of_isProjective_of_isAffine g hproj
  haveI := hi
  set j : Y ⟶ AlgebraicGeometry.Proj (polyGrading ℂ N) :=
    i ≫ (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison ℂ N).iso.hom
  have hjo : j ≫ projToSpecCoeff ℂ N = g := by
    rw [Category.assoc,
      Stacks.ProjectiveSpaceChartRatio.polynomialComparison_iso_hom_comp_projToSpecCoeff, ← hover]
    rfl
  have hdim : topologicalKrullDim Y = (1 : ℕ) := by
    exact_mod_cast topologicalKrullDim_eq_of_smoothOfRelativeDimension g 1
  obtain ⟨π, hπf, hπs, hπ⟩ := MMP.ProjectiveSpace.exists_isFinite_surjective j hdim
  rw [hjo] at hπ
  exact ⟨Y, g, ι, π, hι, hcomp, hsm, inferInstance, hconn, hfin, hπf, hπs.surj, hπ⟩

/-- **Local normal form of a holomorphic function.** A function analytic at `z₀` and not
locally constant there is `G z₀ + ψ ^ n` near `z₀`, for some `n ≥ 1` and a local coordinate `ψ`
centred at `z₀`; the coordinate `ψ` is itself analytic at `z₀`, with nonzero derivative. -/
public theorem exists_pow_normalForm {G : ℂ → ℂ} {z₀ : ℂ} (hG : AnalyticAt ℂ G z₀)
    (hnc : ¬ ∀ᶠ z in 𝓝 z₀, G z = G z₀) :
    ∃ (n : ℕ) (ψ : ℂ → ℂ) (d : ℂ), 0 < n ∧ d ≠ 0 ∧ AnalyticAt ℂ ψ z₀ ∧
      HasStrictDerivAt ψ d z₀ ∧ ψ z₀ = 0 ∧ ∀ᶠ z in 𝓝 z₀, G z = G z₀ + ψ z ^ n := by
  have hH : AnalyticAt ℂ (fun z ↦ G z - G z₀) z₀ := hG.sub analyticAt_const
  have hH0 : ¬ ∀ᶠ z in 𝓝 z₀, G z - G z₀ = 0 := by
    simpa [sub_eq_zero] using hnc
  obtain ⟨n, g, hg, hg0, hgeq⟩ := (hH.exists_eventuallyEq_pow_smul_nonzero_iff).mpr hH0
  have hn : 0 < n := by
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · have := hgeq.self_of_nhds
      simp at this
      exact absurd this.symm hg0
    · exact hn
  obtain ⟨c₀, hc₀⟩ := IsAlgClosed.exists_pow_nat_eq (g z₀) hn
  have hc₀0 : c₀ ≠ 0 := by
    rintro rfl; rw [zero_pow hn.ne'] at hc₀; exact hg0 hc₀.symm
  set k : ℂ → ℂ := fun z ↦ c₀ * Complex.exp (Complex.log (g z / g z₀) / n)
  have hslit : g z₀ / g z₀ ∈ Complex.slitPlane := by
    rw [div_self hg0]; exact Complex.one_mem_slitPlane
  have h1 : AnalyticAt ℂ (fun z ↦ g z / g z₀) z₀ := hg.div_const
  have h2 : AnalyticAt ℂ (fun z ↦ Complex.log (g z / g z₀)) z₀
    := (analyticAt_clog hslit).comp_of_eq h1 rfl
  have h3 : AnalyticAt ℂ (fun z ↦ Complex.log (g z / g z₀) / n) z₀ := h2.div_const
  have hk : AnalyticAt ℂ k z₀ := analyticAt_const.mul h3.cexp
  have hkz₀ : k z₀ = c₀ := by simp [k, div_self hg0]
  have hkn : ∀ᶠ z in 𝓝 z₀, k z ^ n = g z := by
    filter_upwards [hg.continuousAt.eventually_ne hg0] with z hz
    simp only [k, mul_pow, ← Complex.exp_nat_mul, hc₀]
    rw [mul_div_cancel₀ _ (by exact_mod_cast hn.ne'), Complex.exp_log (div_ne_zero hz hg0),
      mul_div_cancel₀ _ hg0]
  set ψ : ℂ → ℂ := fun z ↦ (z - z₀) * k z
  have hψ : AnalyticAt ℂ ψ z₀ := (analyticAt_id.sub analyticAt_const).mul hk
  have hψd : HasStrictDerivAt ψ (k z₀) z₀ := by
    have h1 : HasStrictDerivAt (fun z ↦ z - z₀) 1 z₀ := (hasStrictDerivAt_id z₀).sub_const z₀
    have h2 := hk.hasStrictDerivAt
    have := h1.mul h2
    convert this using 1
    all_goals first | rfl | simp
  refine ⟨n, ψ, k z₀, hn, hkz₀ ▸ hc₀0, hψ, hψd, by simp [ψ], ?_⟩
  filter_upwards [hgeq, hkn] with z hz hkz
  simp only [smul_eq_mul] at hz
  simp only [ψ, mul_pow, hkz]
  rw [← hz]
  ring

/-- **Normal form on a space from a holomorphic expression in a chart.** -/
public theorem isPowNormalForm_of_analyticAt {F : Z → ℂ} {S : Set Z} {a : Z}
    (c : OpenPartialHomeomorph Z ℂ) (ha : a ∈ c.source) (hcS : c.source ⊆ S) {G : ℂ → ℂ}
    (hG : AnalyticAt ℂ G (c a))
    (hFG : ∀ᶠ x in 𝓝 a, F x = G (c x)) (hnc : ¬ ∀ᶠ z in 𝓝 (c a), G z = G (c a)) :
    IsPowNormalForm F S a := by
  obtain ⟨n, ψ, d, hn, hd, -, hψd, hψ0, hGψ⟩ := exists_pow_normalForm hG hnc
  set Ψ := (hψd.hasStrictFDerivAt_equiv hd).toOpenPartialHomeomorph ψ
  have hΨ : ⇑Ψ = ψ := HasStrictFDerivAt.toOpenPartialHomeomorph_coe _
  have hz₀Ψ : c a ∈ Ψ.source := (hψd.hasStrictFDerivAt_equiv hd).mem_toOpenPartialHomeomorph_source
  obtain ⟨U₁, hU₁F, hU₁o, haU₁⟩ := eventually_nhds_iff.mp hFG
  obtain ⟨V, hVG, hVo, hz₀V⟩ := eventually_nhds_iff.mp hGψ
  set W := U₁ ∩ (c.source ∩ c ⁻¹' V)
  have hWo : IsOpen W := hU₁o.inter (c.isOpen_inter_preimage hVo)
  have haW : a ∈ W := ⟨haU₁, ha, hz₀V⟩
  set φ := (c.trans Ψ).restrOpen W hWo
  have hφsrc : ∀ x ∈ φ.source, x ∈ c.source ∧ x ∈ W := fun x hx ↦ ⟨hx.1.1, hx.2⟩
  have hφapp : ∀ x, φ x = ψ (c x) := fun x ↦ by
    change Ψ (c x) = ψ (c x); rw [hΨ]
  refine ⟨n, φ, hn, ⟨⟨ha, hz₀Ψ⟩, haW⟩, fun x hx ↦ hcS (hφsrc x hx).1, by rw [hφapp, hψ0], ?_⟩
  intro x hx
  obtain ⟨-, hxW⟩ := hφsrc x hx
  rw [hU₁F x hxW.1, hU₁F a haU₁, hVG (c x) hxW.2.2, hφapp]

section Rep

open MMP.Analytic MMP.Analytic.ComplexPoints

variable {B : Scheme.{0}} {sB : B ⟶ Spec (.of ℂ)}

open scoped Classical in
/-- The value of a section on the `ℂ`-points of its open, extended by zero. -/
@[expose] public noncomputable def evalFun (U : B.Opens) (f : Γ(B, U)) (x : ComplexPoints sB) : ℂ :=
  if h : x ∈ chart U then eval U f ⟨x, h⟩ else 0

/-- On the chart of `U`, `evalFun U f` is the value of `f`. -/
public theorem evalFun_of_mem {U : B.Opens} {f : Γ(B, U)} {x : ComplexPoints sB}
    (h : x ∈ chart U) :
    evalFun U f x = eval U f ⟨x, h⟩ := by
  classical
  rw [evalFun]; exact dif_pos h

variable [SmoothOfRelativeDimension 1 sB]

/-- The value of a section is holomorphic: near a point of its chart it is a holomorphic
function of the chart coordinate. -/
public theorem exists_analyticAt_evalFun (U : B.Opens) (f : Γ(B, U)) {a : ComplexPoints sB}
    (ha : a ∈ chart U) : ∃ G : ℂ → ℂ, AnalyticAt ℂ G (chartAt ℂ a a) ∧
      ∀ᶠ y in 𝓝 a, evalFun U f y = G (chartAt ℂ a y) := by
  set c := curveChart a
  obtain ⟨G', hG', hrep⟩ := c.exists_analyticOnNhd U f
  have haW : a ∈ c.W := mem_curveChart_W a
  have hasrc : a ∈ c.toOpenPartialHomeomorph.source := by
    rw [c.source_toOpenPartialHomeomorph]; exact haW
  have hcoord : ∀ y (hy : y ∈ c.W), c.toOpenPartialHomeomorph y = fun _ ↦ chartAt ℂ a y := by
    intro y hy
    funext i
    rw [Subsingleton.elim i 0, c.toOpenPartialHomeomorph_apply hy, chartAt_complex_apply a hy]
  refine ⟨fun w ↦ G' (fun _ ↦ w), ?_, ?_⟩
  · have hmem : c.toOpenPartialHomeomorph a ∈ c.toOpenPartialHomeomorph.target ∩
        c.toOpenPartialHomeomorph.symm ⁻¹' chart U := by
      refine ⟨c.toOpenPartialHomeomorph.map_source hasrc, ?_⟩
      rw [mem_preimage, c.toOpenPartialHomeomorph.left_inv hasrc]
      exact ha
    rw [hcoord a haW] at hmem
    exact (hG' _ hmem).comp_of_eq (AnalyticAt.pi fun _ ↦ analyticAt_id) rfl
  · filter_upwards [(c.isOpen.inter (isOpen_chart sB U)).mem_nhds ⟨haW, ha⟩] with y hy
    rw [evalFun_of_mem hy.2, hrep y hy.1 hy.2, hcoord y hy.1]

/-- The value of a section is continuous on its chart. -/
public theorem continuousOn_evalFun (U : B.Opens) (f : Γ(B, U)) :
    ContinuousOn (evalFun (sB := sB) U f) (chart U) := fun a ha ↦ by
  obtain ⟨G, hG, hrep⟩ := exists_analyticAt_evalFun U f ha
  have : ContinuousAt (fun y ↦ G (chartAt ℂ a y)) a :=
    hG.continuousAt.comp ((chartAt ℂ a).continuousAt (mem_chart_source ℂ a))
  exact (this.congr (hrep.mono fun y hy ↦ hy.symm)).continuousWithinAt

end Rep

section Fibre

open MMP.Analytic MMP.Analytic.ComplexPoints MMP.UnderlyingSpace

private theorem injective_closedPoint {Y : Scheme.{0}} (g : Y ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType g] :
    Function.Injective fun y : ComplexPoints g ↦ y.hom (IsLocalRing.closedPoint ℂ) := by
  letI : Y.Over (Spec (.of ℂ)) := ⟨g⟩
  haveI : LocallyOfFiniteType (Y ↘ Spec (.of ℂ)) := ‹LocallyOfFiniteType g›
  intro y y' h
  have := (equivClosedPoints Y).injective (a₁ := toUnderlyingSpace y) (a₂ := toUnderlyingSpace y')
    (Subtype.ext h)
  exact toUnderlyingSpace.injective this

private theorem finite_fibre_realize {Y W : Scheme.{0}} {g : Y ⟶ Spec (.of ℂ)}
    {sW : W ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType g] (π : Y ⟶ W) [IsFinite π] (hπ : π ≫ sW = g) (q : ComplexPoints sW) :
    {y : ComplexPoints g | realize π hπ y = q}.Finite := by
  refine ((π.finite_preimage_singleton (q.hom (IsLocalRing.closedPoint ℂ))).preimage
    (injective_closedPoint g).injOn).subset fun y hy ↦ ?_
  simp only [mem_setOf_eq] at hy
  simp only [mem_preimage, mem_singleton_iff]
  rw [← hy]
  rfl

end Fibre

section Construct

open MMP.Analytic MMP.Analytic.ComplexPoints MMP MMP.UnderlyingSpace MMP.Topology

/-- The projective line `Proj ℂ[x₀, x₁]` lies over `ℂ` through `projToSpecCoeff ℂ 1`. -/
public noncomputable local instance instOverProjectiveLine :
    (AlgebraicGeometry.Proj (polyGrading ℂ 1)).Over (Spec (.of ℂ)) :=
  ⟨projToSpecCoeff ℂ 1⟩

variable {Y : Scheme.{0}} (g : Y ⟶ Spec (.of ℂ))
  (π : Y ⟶ AlgebraicGeometry.Proj (polyGrading ℂ 1))
  (hπ : π ≫ projToSpecCoeff ℂ 1 = g)

/-- The point of `ℙ¹(ℂ)` below a point of `Y(ℂ)`. -/
@[expose] public noncomputable def toProjectiveLinePoint (y : ComplexPoints g) :
    UnderlyingSpace ℂ (AlgebraicGeometry.Proj (polyGrading ℂ 1)) :=
  toUnderlyingSpace (realize π hπ y)

/-- A point of `Y(ℂ)` lies over the `i`-th standard chart of `ℙ¹` exactly when its image in
`ℙ¹(ℂ)` does. -/
public theorem mem_chart_iff_top_le (i : Fin 2) (y : ComplexPoints g) :
    y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i) ↔
      ⊤ ≤ (toProjectiveLinePoint g π hπ y).toHom ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i := by
  rw [mem_chart_preimage_iff π hπ, top_le_iff]
  rfl

/-- The affine coordinate `x_k / x_i` of `ℙ¹`, pulled back to `Y(ℂ)`. -/
@[expose] public noncomputable def coordFun (i k : Fin 2) : ComplexPoints g → ℂ :=
  evalFun (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i) (π.app _ (projectiveSpaceStdCoord ℂ 1 i k))

include hπ in
/-- On the `i`-th chart, `coordFun g π i k` is the coordinate `x_k / x_i` of the image point. -/
public theorem coordFun_eq (i k : Fin 2) {y : ComplexPoints g}
    (hy : y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i)) :
    coordFun g π i k y = UnderlyingSpace.eval (toProjectiveLinePoint g π hπ y)
      ((mem_chart_iff_top_le g π hπ i y).mp hy) (projectiveSpaceStdCoord ℂ 1 i k) := by
  rw [coordFun, evalFun_of_mem hy]
  simp only [ComplexPoints.eval, UnderlyingSpace.eval]
  congr 1

include hπ in
/-- Every point of `Y(ℂ)` lies over one of the two standard charts of `ℙ¹`. -/
public theorem mem_chart_or_mem_chart (y : ComplexPoints g) :
    y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 0) ∨
      y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 1) := by
  obtain ⟨i, hi⟩ := exists_top_le_preimage_projectiveSpaceStdChart (toProjectiveLinePoint g π hπ y)
  fin_cases i
  · exact Or.inl ((mem_chart_iff_top_le g π hπ 0 y).mpr hi)
  · exact Or.inr ((mem_chart_iff_top_le g π hπ 1 y).mpr hi)

include hπ in
/-- On the overlap of two charts the coordinates `x_k / x_i` and `x_i / x_k` are reciprocal. -/
public theorem coordFun_mul_coordFun_eq_one {i k : Fin 2} {y : ComplexPoints g}
    (hi : y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i))
    (hk : y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 k)) :
    coordFun g π i k y * coordFun g π k i y = 1 := by
  rw [coordFun_eq g π hπ i k hi, coordFun_eq g π hπ k i hk,
    ← eval_projectiveSpaceStdCoord_mul, eval_projectiveSpaceStdCoord_self]

include hπ in
/-- Off the `k`-th chart, the coordinate `x_k / x_i` vanishes. -/
public theorem coordFun_eq_zero {i k : Fin 2} {y : ComplexPoints g}
    (hi : y ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i))
    (hk : y ∉ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 k)) : coordFun g π i k y = 0 := by
  by_contra h
  rw [coordFun_eq g π hπ i k hi] at h
  exact hk ((mem_chart_iff_top_le g π hπ k y).mpr
    (top_le_preimage_of_eval_projectiveSpaceStdCoord_ne_zero _ h))

variable [SmoothOfRelativeDimension 1 g] [IsFinite π]

include hπ in
/-- For `i ≠ k`, the coordinate `x_k / x_i` has a power normal form at every point of the
`i`-th chart. -/
public theorem isPowNormalForm_coordFun {i k : Fin 2} (hik : i ≠ k) {a : ComplexPoints g}
    (ha : a ∈ chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i)) :
    IsPowNormalForm (coordFun g π i k) (chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i)) a := by
  have : Smooth g := SmoothOfRelativeDimension.smooth 1 g
  set S := chart (sX := g) (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i)
  have hSo : IsOpen S := isOpen_chart g _
  obtain ⟨G, hG, hrep⟩ := exists_analyticAt_evalFun (sB := g) (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 i)
    (π.app _ (projectiveSpaceStdCoord ℂ 1 i k)) ha
  refine isPowNormalForm_of_analyticAt ((chartAt ℂ a).restrOpen S hSo) ⟨mem_chart_source ℂ a, ha⟩
    (fun x hx ↦ hx.2) hG hrep ?_
  intro h
  have h' : ∀ᶠ z in 𝓝 (chartAt ℂ a a), G z = G (chartAt ℂ a a) := h
  have hc := ((chartAt ℂ a).continuousAt (mem_chart_source ℂ a)).eventually h'
  have h1 : ∀ᶠ y in 𝓝 a, y ∈ S ∧ coordFun g π i k y = coordFun g π i k a := by
    filter_upwards [hc, hrep, hSo.mem_nhds ha] with y h1 h2 h3
    refine ⟨h3, ?_⟩
    change evalFun _ _ y = evalFun _ _ a
    rw [h2, h1, ← hrep.self_of_nhds]
  have hsub : {y | y ∈ S ∧ coordFun g π i k y = coordFun g π i k a} ⊆
      {y | realize π hπ y = realize π hπ a} := by
    rintro y ⟨hy, hya⟩
    refine eq_of_eval_projectiveSpaceStdCoord_eq rfl
      ((mem_chart_iff_top_le g π hπ i y).mp hy)
      ((mem_chart_iff_top_le g π hπ i a).mp ha) (fun j ↦ ?_)
    rcases (show j = i ∨ j = k by fin_cases i <;> fin_cases k <;> fin_cases j <;> simp_all) with
      rfl | rfl
    · exact (eval_projectiveSpaceStdCoord_self ((mem_chart_iff_top_le g π hπ j y).mp hy)).trans
        (eval_projectiveSpaceStdCoord_self ((mem_chart_iff_top_le g π hπ j a).mp ha)).symm
    · exact (coordFun_eq g π hπ i j hy).symm.trans (hya.trans (coordFun_eq g π hπ i j ha))
  exact infinite_of_mem_nhds _ ((chartAt ℂ a).image_mem_nhds (mem_chart_source ℂ a) h1)
    (((finite_fibre_realize π hπ _).subset hsub).image _)

/-- **The branched covering datum of a finite morphism `π : Y → ℙ¹`** from a smooth curve: the
coordinate `z = x₁ / x₀` on the preimage of the chart `x₀ ≠ 0` and `1 / z = x₀ / x₁` on the
preimage of the chart `x₁ ≠ 0`. -/
@[expose] public noncomputable def BranchedCoverData.ofFiniteToProjectiveLine :
    BranchedCoverData (ComplexPoints g) where
  S := chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 0)
  S' := chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 1)
  F := coordFun g π 0 1
  F' := coordFun g π 1 0
  isOpen := isOpen_chart g _
  isOpen' := isOpen_chart g _
  union := eq_univ_of_forall fun y ↦ mem_chart_or_mem_chart g π hπ y
  cont := continuousOn_evalFun _ _
  cont' := continuousOn_evalFun _ _
  mul _ hx hx' := coordFun_mul_coordFun_eq_one g π hπ hx hx'
  zero _ hx hx' := coordFun_eq_zero g π hπ hx hx'
  zero' _ hx hx' := coordFun_eq_zero g π hπ hx hx'
  nf _ ha := isPowNormalForm_coordFun g π hπ (by decide) ha
  nf' _ ha := isPowNormalForm_coordFun g π hπ (by decide) ha

@[simp] public theorem BranchedCoverData.ofFiniteToProjectiveLine_S :
    (BranchedCoverData.ofFiniteToProjectiveLine g π hπ).S =
      chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 0) := rfl

@[simp] public theorem BranchedCoverData.ofFiniteToProjectiveLine_S' :
    (BranchedCoverData.ofFiniteToProjectiveLine g π hπ).S' =
      chart (π ⁻¹ᵁ projectiveSpaceStdChart ℂ 1 1) := rfl

@[simp] public theorem BranchedCoverData.ofFiniteToProjectiveLine_F :
    (BranchedCoverData.ofFiniteToProjectiveLine g π hπ).F = coordFun g π 0 1 := rfl

@[simp] public theorem BranchedCoverData.ofFiniteToProjectiveLine_F' :
    (BranchedCoverData.ofFiniteToProjectiveLine g π hπ).F' = coordFun g π 1 0 := rfl

omit [SmoothOfRelativeDimension 1 g] [IsFinite π] in
private theorem compactSpace_complexPoints [IsProper g] :
    CompactSpace (ComplexPoints g) := by
  letI : Y.Over (Spec (.of ℂ)) := ⟨g⟩
  letI : (Spec (.of ℂ)).Over (Spec (.of ℂ)) := ⟨𝟙 _⟩
  haveI : g.IsOver (Spec (.of ℂ)) := ⟨Category.comp_id g⟩
  haveI : LocallyOfFiniteType ((Spec (.of ℂ)) ↘ Spec (.of ℂ)) :=
    inferInstanceAs (LocallyOfFiniteType (𝟙 _))
  have hp := isProperMap_map (K := ℂ) g
  haveI : Subsingleton (UnderlyingSpace ℂ (Spec (.of ℂ))) := ⟨fun p q ↦ UnderlyingSpace.ext (by
    have h1 := p.toHom_comp_over
    have h2 := q.toHom_comp_over
    change p.toHom ≫ 𝟙 _ = 𝟙 _ at h1
    change q.toHom ≫ 𝟙 _ = 𝟙 _ at h2
    rw [Category.comp_id] at h1 h2
    rw [h1, h2])⟩
  haveI : CompactSpace (UnderlyingSpace ℂ Y) :=
    ⟨by simpa using hp.isCompact_preimage (isCompact_univ (X := UnderlyingSpace ℂ (Spec (.of ℂ))))⟩
  exact (homeomorphUnderlyingSpace (X := Y)).symm.compactSpace

end Construct

end BranchedP1

/-! ### The good cover -/

section GoodCover

/-- **The complex realization of an integral scheme of finite type over `ℂ` is connected.** Its
regular points form a connected subset of `X(ℂ)`, dense for the classical topology. -/
private theorem connectedSpace_analyticSpace {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [IsIntegral X] [LocallyOfFiniteType sX] [QuasiCompact sX] :
    ConnectedSpace (analyticSpace sX) := by
  letI : X.Over (Spec (.of ℂ)) := ⟨sX⟩
  haveI : LocallyOfFiniteType (X ↘ Spec (.of ℂ)) := ‹LocallyOfFiniteType sX›
  haveI : QuasiCompact (X ↘ Spec (.of ℂ)) := ‹QuasiCompact sX›
  have hconn : IsConnected (MMP.UnderlyingSpace.regularPart ℂ X) := by
    simpa using MMP.UnderlyingSpace.isConnected_regularPart_diff (X := X)
      isClosed_empty (Set.empty_ne_univ (α := X))
  have huniv : IsConnected (Set.univ : Set (MMP.UnderlyingSpace ℂ X)) := by
    rw [← MMP.UnderlyingSpace.dense_regularPart.closure_eq]
    exact hconn.closure
  haveI : ConnectedSpace (MMP.UnderlyingSpace ℂ X) :=
    connectedSpace_iff_univ.mpr huniv
  exact (homeomorphUnderlyingSpace (X := X)).symm.surjective.connectedSpace
    (homeomorphUnderlyingSpace (X := X)).symm.continuous

open MMP.Analytic MMP.UnderlyingSpace in
/-- **A finite good cover of `T^an`.** The cover of the punctured compact Riemann surface
`T̄^an ∖ P`, `P = T̄ ∖ T`, pulled back along the open embedding `T^an → T̄^an`. -/
private theorem exists_goodCover_analyticSpace {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ))
    [SmoothOfRelativeDimension 1 sT] [QuasiCompact sT] [IsSeparated sT] [ConnectedSpace T] :
    ∃ (ι : Type) (_ : Fintype ι) (U : ι → Set (analyticSpace sT)),
      (∀ i, IsOpen (U i)) ∧ (⋃ i, U i = Set.univ) ∧
      (∀ I : Finset ι, I.Nonempty → (coverInter U I).Nonempty →
        Nonempty (coverInter U I ≃ₜ EuclideanSpace ℝ (Fin 2))) := by
  obtain ⟨Y, g, ι, π, hι, hcomp, hsm, hprop, -, hfin, hπf, -, hπ⟩ := exists_completion sT
  haveI := hsm
  haveI := hprop
  haveI := hπf
  haveI : Smooth g := SmoothOfRelativeDimension.smooth 1 g
  haveI : CompactSpace (ComplexPoints g) := compactSpace_complexPoints g
  letI : T.Over (Spec (.of ℂ)) := ⟨sT⟩
  letI : Y.Over (Spec (.of ℂ)) := ⟨g⟩
  haveI : ι.IsOver (Spec (.of ℂ)) := ⟨hcomp⟩
  set e := realize ι hcomp with he_def
  have hfun : e = (homeomorphUnderlyingSpace (X := Y)).symm ∘ mapFun (K := ℂ) ι ∘
      homeomorphUnderlyingSpace (X := T) := rfl
  have he : Topology.IsOpenEmbedding e := by
    rw [hfun]
    exact (homeomorphUnderlyingSpace (X := Y)).symm.isOpenEmbedding.comp
      ((isOpenEmbedding_map_of_isOpenImmersion ι).comp
        (homeomorphUnderlyingSpace (X := T)).isOpenEmbedding)
  have hmem : ∀ y : ComplexPoints g, y.hom (IsLocalRing.closedPoint ℂ) ∈ Set.range ι →
      y ∈ Set.range e := by
    intro y hy
    have h1 : toUnderlyingSpace y ∈ Set.range (mapFun (K := ℂ) ι) := by
      rw [range_mapFun_of_isOpenImmersion]
      exact (top_le_preimage_iff _ _).mpr hy
    obtain ⟨x, hx⟩ := h1
    exact ⟨x, Subtype.ext (congrArg Subtype.val hx)⟩
  set P : Set (ComplexPoints g) := (Set.range e)ᶜ
  have hPfin : P.Finite :=
    (hfin.preimage (injective_closedPoint g).injOn).subset fun y hy h ↦ hy (hmem y h)
  obtain ⟨ι', hfin', U, hUo, hUP, hUcov, hgood⟩ :=
    (BranchedCoverData.ofFiniteToProjectiveLine g π hπ).exists_goodCover hPfin
  refine ⟨ι', hfin', fun i ↦ e ⁻¹' U i, fun i ↦ (hUo i).preimage he.continuous, ?_,
    fun I hI hne ↦ ?_⟩
  · refine eq_univ_of_forall fun x ↦ ?_
    obtain ⟨i, hi⟩ := mem_iUnion.mp (hUcov (show e x ∈ Pᶜ from not_not.mpr ⟨x, rfl⟩))
    exact mem_iUnion.mpr ⟨i, hi⟩
  · have heq : coverInter (fun i ↦ e ⁻¹' U i) I = univ ∩ e ⁻¹' (⋂ i ∈ I, U i) := by
      ext x
      simp [mem_coverInter]
    rw [heq] at hne ⊢
    have hW : (⋂ i ∈ I, U i) ⊆ e '' univ := by
      obtain ⟨i₀, hi₀⟩ := hI
      intro z hz
      have := hUP i₀ (mem_iInter₂.mp hz i₀ hi₀)
      rw [image_univ]
      simpa [P] using this
    obtain ⟨h1⟩ := nonempty_homeomorph_inter_preimage isOpen_univ he.continuous.continuousOn
      he.injective.injOn (fun V _ hV ↦ he.isOpenMap V hV) hW
    have hne' : (⋂ i ∈ I, U i).Nonempty := by
      obtain ⟨x, hx⟩ := hne
      exact ⟨e x, hx.2⟩
    obtain ⟨h2⟩ := hgood I hI hne'
    exact ⟨h1.trans h2⟩

end GoodCover

@[expose] public section

/-- **A finite good cover of a complex algebraic curve.** Let `T` be a smooth connected
separated complex curve of finite type. Then `T^an` has a finite open cover `U` such that
* every nonempty intersection `coverInter U I` (`I` nonempty) is homeomorphic to `ℝ²`;
* `T^an` is homotopy equivalent to the realization `nerveSet U` of the nerve, which is
  connected;
* every loop `γ` at a point of `U i₀` is cut by a subdivision `0 = t₀ ≤ ⋯ ≤ tₙ = 1` into
  pieces `γ [t_k, t_{k+1}] ⊆ U i_{k+1}` along a closed edge path `i₀, …, iₙ = i₀`;
* if a loop traces the edge path `i₀, …, iₙ` in this way and is null-homotopic, then the word
  `[i₀, …, iₙ]` is equivalent to `[i₀]` under the triangle relations of the nerve. -/
@[mmp "lem_mmp_curve_finite_good_cover"]
public theorem exists_finite_goodCover_analyticSpace
    {T : Scheme.{0}} (sT : T ⟶ Spec (.of ℂ)) [SmoothOfRelativeDimension 1 sT]
    [QuasiCompact sT] [IsSeparated sT] [ConnectedSpace T] :
    ∃ (ι : Type) (_ : Fintype ι) (U : ι → Set (analyticSpace sT)),
      (∀ i, IsOpen (U i)) ∧ (⋃ i, U i = Set.univ) ∧
      (∀ I : Finset ι, I.Nonempty → (coverInter U I).Nonempty →
        Nonempty (coverInter U I ≃ₜ EuclideanSpace ℝ (Fin 2))) ∧
      Nonempty (ContinuousMap.HomotopyEquiv (analyticSpace sT) (nerveSet U)) ∧
      IsConnected (nerveSet U) ∧
      (∀ (i₀ : ι) (x : analyticSpace sT), x ∈ U i₀ → ∀ γ : Path x x,
        ∃ (n : ℕ) (t : Fin (n + 1) → unitInterval) (i : Fin (n + 1) → ι),
          Monotone t ∧ t 0 = 0 ∧ t (Fin.last n) = 1 ∧ i 0 = i₀ ∧ i (Fin.last n) = i₀ ∧
          ∀ k : Fin n, γ '' Set.Icc (t k.castSucc) (t k.succ) ⊆ U (i k.succ)) ∧
      (∀ (x : analyticSpace sT) (γ : Path x x) (n : ℕ) (t : Fin (n + 1) → unitInterval)
          (i : Fin (n + 1) → ι),
        Monotone t → t 0 = 0 → t (Fin.last n) = 1 → x ∈ U (i 0) → i (Fin.last n) = i 0 →
        (∀ k : Fin n, γ '' Set.Icc (t k.castSucc) (t k.succ) ⊆ U (i k.succ)) →
        γ.Homotopic (Path.refl x) →
        Relation.EqvGen
          (fun w w' : List ι ↦ ∃ (l₁ l₂ : List ι) (a b c : ι),
            ((U a ∩ U b ∩ U c).Nonempty ∧
              w = l₁ ++ [a, b, c] ++ l₂ ∧ w' = l₁ ++ [a, c] ++ l₂) ∨
            (w = l₁ ++ [a, a] ++ l₂ ∧ w' = l₁ ++ [a] ++ l₂))
          (List.ofFn i) [i 0]) := by
  obtain ⟨ι, hι, U, hUo, hUc, hgood⟩ := exists_goodCover_analyticSpace sT
  have : Smooth sT := SmoothOfRelativeDimension.smooth 1 sT
  haveI : IsIntegral T := Stacks.Chow.isIntegral_of_connectedSpace_of_smooth sT
  haveI : ConnectedSpace (analyticSpace sT) := connectedSpace_analyticSpace sT
  haveI := MMP.Analytic.ComplexPoints.secondCountableTopology (sX := sT) 1
  haveI : LocallyCompactSpace (MMP.Analytic.ComplexPoints sT) :=
    ChartedSpace.locallyCompactSpace ℂ _
  obtain ⟨h⟩ := nonempty_homotopyEquiv_nerveSet_of_goodCover U hUo hUc hgood
  refine ⟨ι, hι, U, hUo, hUc, hgood, ⟨h⟩, ?_, fun i₀ x hx γ ↦ exists_subdivision hUo hUc i₀ hx γ,
    fun x γ n t i ht h0 h1 hx hlast hp hγ ↦
      eqvGen_ofFn_of_homotopic hUo hUc γ n t i ht h0 h1 hx hlast hp hγ⟩
  haveI := connectedSpace_of_homotopyEquiv h
  exact isConnected_iff_connectedSpace.mpr inferInstance

end

end MMP.Fourfold
