/-- **(1), (3), (4)**: every closed point `x` of `X` satisfies
`HasAnalyticLogCoordinatesAt sX n E x`. -/
public theorem hasAnalyticLogCoordinatesAt [IsSeparated sX] [QuasiCompact sX]
    (E : Mori.Divisor X) (hE : E.IsSNC sX) (x : X) (hx : IsClosed {x}) :
    HasAnalyticLogCoordinatesAt sX n E x := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  refine (exists_adapted (n := n) E hE x hx).elim fun W h => h.elim fun hW h => h.elim fun hxW h =>
    h.elim fun k h => h.elim fun hk h => h.elim fun z h => ?_
  have hb := h.2.2.1
  have het := h.2.2.2.1
  have hinj := h.2.2.2.2
  refine ⟨W, hW, hxW, k, hk, z, ⟨h.1, h.2.1, hb⟩, fun y hy => ?_⟩
  refine (exists_translated_chart (sX := sX) (n := n) W z het y hy).elim fun φ h => h.elim
    fun hφmax h => h.elim fun hφ h => h.elim fun hyφ hφapp => ?_
  have hΨ := holomorphicFormsMap_spec sX hW z hb hφmax hφ hyφ hφapp
  refine ⟨φ, hφmax, hφ, hyφ, hφapp, hΨ.1, fun p => ⟨?_, ?_⟩⟩
  · have hWC := hΨ.2
    unfold LogFormsAnalytify
    intro f L ε c e Dc
    letI : Algebra Γ(X, W) L := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
    have he : ∀ q (I : Set.powersetCard (Fin n) q) v, e q I v = logFrame k c I v :=
      fun q I v => wedge_smul _ _
    have hunit : ∀ j : Fin n, (j : ℕ) < k → IsUnit (algebraMap Γ(X, W) L (z j)) := by
      intro j hj
      have hf : IsUnit (algebraMap Γ(X, W) L f) := X.toRingedSpace.isUnit_res_basicOpen f
      refine isUnit_of_dvd_unit (map_dvd _ ?_) hf
      have : j = Fin.castLE hk ⟨j, hj⟩ := Fin.ext rfl
      rw [this]
      exact Finset.dvd_prod_of_mem _ (Finset.mem_univ _)
    have hS : ∀ O : Opens (EuclideanSpace ℂ (Fin n)), IsOpen (φ.target ∩ (O : Set _)) :=
      fun O => φ.open_target.inter O.2
    refine ⟨?_, fun O g hg hzero => ?_, ?_, fun O g hg => ?_, fun O g hg => ?_⟩
    · exact exists_logForms_basis hW hxW hk z hb hinj p
    · simp only [he] at hzero
      exact eq_zero_of_sum_smul_logFrame_eq_zero (hS O) (fun I => (hg I).continuousOn) hzero
    · intro O h I y'
      have hy'f : y'.1 ∈ chart (X.basicOpen f) := mem_chart_iff.2 (h y'.2)
      let σ : Fin n → L := fun j =>
        if (j : ℕ) < k then Ring.inverse (algebraMap Γ(X, W) L (z j)) else 1
      have hι : exteriorPower.ιMulti_family L p ε I = (∏ a, σ (enum I a)) •
          exteriorPower.ιMulti L p
            (fun a => KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z (enum I a)))) := by
        rw [exteriorPower.ιMulti_family, ← AlternatingMap.map_smul_univ]
        congr 1
        funext a
        simp only [ε, σ, Function.comp_apply]
        split_ifs
        · rfl
        · exact (one_smul _ _).symm
      rw [hι, hWC p (X.basicOpen f) (hW.basicOpen f) O h _ _ y', he, logFrame]
      have hd : ∀ m, fderiv ℂ (regVal (X.basicOpen f) (algebraMap Γ(X, W) L (z (enum I m))) ∘
          φ.symm) (φ y'.1) = EuclideanSpace.proj (enum I m) := fun m =>
        fderiv_regVal_res_coord (X.basicOpen_le f) z c hφ hφapp y'.2.1 hy'f (enum I m)
      simp only [hd]
      congr 1
      rw [map_prod]
      refine Finset.prod_congr rfl fun a _ => ?_
      simp only [σ, logScale]
      split_ifs with hj
      · have h1 := Ring.inverse_mul_cancel _ (hunit _ hj)
        have h2 := congrArg (evalHom (X.basicOpen f) ⟨y'.1, hy'f⟩) h1
        rw [map_mul, map_one] at h2
        rw [eq_inv_of_mul_eq_one_left h2]
        congr 1
        have h3 := hφapp y'.1 y'.2.1 (enum I a)
        have h4 := evalHom_res (X.basicOpen_le f) ⟨y'.1, hy'f⟩ (z (enum I a))
        change _ = (φ y'.1) (enum I a) + c (enum I a)
        rw [h3]
        simp only [c, sub_add_cancel]
        exact h4.symm
      · exact map_one _
    · simp only [he]
      exact exists_extDeriv_sum_smul_logFrame (hS O) hg
    · simp only [he]
      exact exists_prod_smul_sum_smul_logFrame hk hg
  · exact analytify_logTwisted hW hk z hb hinj y φ hφmax hφ hyφ hφapp _ _ rfl _ _
      (holomorphicFormsMap sX φ) hΨ.1.1 hΨ.1.2.1 hΨ.1.2.2.2.1 hΨ.2 _ rfl _ rfl _ rfl _ rfl _ rfl p

