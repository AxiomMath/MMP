section Statement

/-- **Analytification of differential forms and logarithmic forms.** Let `X` be a smooth complex
variety of dimension `n` and `E` a reduced snc divisor. (2) `X^an`, with its étale-coordinate
charts, is a complex manifold whose charts are algebraic coordinates and whose sheaf of
holomorphic functions is `𝒪_{X^an}` through `structureSheafIsoHolomorphic`
(`IsAlgebraicComplexManifold`). (1) Every closed point `x` has an affine neighbourhood `W` with
coordinates `z` adapted to `E` (`IsAdaptedCoordinates`) such that near every point `y` of `W^an`
the functions `z - z(y)` form a chart `φ` (`IsTranslatedChart`). (3) On such a chart,
`holomorphicFormsMap` identifies `(Ω^p_X)^an` with the holomorphic `p`-forms
(`IsHolomorphicFormsMap`). (4) It identifies the logarithmic forms with the holomorphic
logarithmic forms (`LogFormsAnalytify`), and `Ω^p(log E)(-E)` and `Ω^p / Ω^p(log E)(-E)` with their
holomorphic counterparts (`TwistedLogFormsAnalytify`), in every degree
(`HasAnalyticLogCoordinatesAt`). -/
@[mmp "lem_mmp_gaga_smooth_differentials"]
public theorem analytification_smooth_differentials {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    (hX : Mori.IsVariety ℂ sX) (hsm : Mori.IsSmoothScheme sX) {n : ℕ}
    (hdim : topologicalKrullDim X = n) (E : Mori.Divisor X)
    (hEred : Intersection.IsReducedEffective E) (hE : E.IsSNC sX) :
    letI := smoothOfRelativeDimension_of_isSmoothScheme sX hX hsm hdim
    IsAlgebraicComplexManifold sX n ∧
      ∀ x : X, IsClosed {x} → HasAnalyticLogCoordinatesAt sX n E x := by
  haveI : IsVariety ℂ sX := hX
  haveI := smoothOfRelativeDimension_of_isSmoothScheme sX hX hsm hdim
  exact ⟨isAlgebraicComplexManifold sX, hasAnalyticLogCoordinatesAt sX E hE⟩

set_option maxRecDepth 8000 in
/-- **Analytification of differential forms and logarithmic forms**, for a separated
quasi-compact scheme `X` smooth of relative dimension `n` over `ℂ`, not necessarily integral or
connected: the conclusions (1)–(4) of `MMP.Analytic.analytification_smooth_differentials`. -/
public theorem analytification_smooth_differentials_of_smoothOfRelativeDimension {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of ℂ)) {n : ℕ} [SmoothOfRelativeDimension n sX] [IsSeparated sX]
    [QuasiCompact sX] (E : Mori.Divisor X) (hE : E.IsSNC sX) :
    ∃ cs : ChartedSpace (EuclideanSpace ℂ (Fin n)) (ComplexPoints sX),
      letI := cs
      -- (2) `X^an` is a complex manifold
      IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX) ∧
      T2Space (ComplexPoints sX) ∧ SecondCountableTopology (ComplexPoints sX) ∧
      (∀ φ ∈ atlas (EuclideanSpace ℂ (Fin n)) (ComplexPoints sX),
        ∃ (W : X.Opens) (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hW : φ.source ⊆ chart W),
          ∀ y (hy : y ∈ φ.source) (i : Fin n), φ y i = evalHom W ⟨y, hW hy⟩ (z i) - c i) ∧
      ∃ Θ : structureSheaf sX ≅ 𝒪[n, ComplexPoints sX],
        (∀ (V : X.Opens) (g : Γ(X, V)) (y : (Opens.map (toSchemeHom sX)).obj V),
          Θ.hom.hom.app (op _) ((analytificationHom sX).hom.c.app (op V) g) y =
            evalHom V ⟨y.1, mem_chart_iff.2 y.2⟩ g) ∧
      -- (1) algebraic coordinates adapted to `E`
      ∀ x : X, IsClosed {x} → ∃ (W : X.Opens) (hW : IsAffineOpen W) (hxW : x ∈ W) (k : ℕ)
        (hk : k ≤ n) (z : Fin n → Γ(X, W)),
        Mori.IsRegularSystemOfParameters (fun i => X.presheaf.germ W x hxW (z i)) ∧
        (∀ w ∈ W, (∃ D ∈ E.support, w ∈ D.support) ↔
          w ∉ X.basicOpen (∏ i : Fin k, z (Fin.castLE hk i))) ∧
        (letI := Mori.sectionAlgebra sX W
          ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
            ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i)) ∧
        ∀ y ∈ chart (sX := sX) W,
        ∃ φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX),
        ∃ (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source),
          (∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
            φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i)) ∧
          let U : Opens (EuclideanSpace ℂ (Fin n)) → Opens (space sX) := fun O =>
            ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩
          let Ωan : ℕ → SheafOfModules.{0} (ringCatSheaf sX) := fun p =>
            (analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))
          let an : ∀ (p : ℕ) (V : X.Opens) (O : Opens (EuclideanSpace ℂ (Fin n))),
              U O ≤ (Opens.map (toSchemeHom sX)).obj V →
              Γ(sX.relativeDifferentialForms (p : ℤ), V) → (Ωan p).val.obj (op (U O)) :=
            fun p V O h s => (Ωan p).val.presheaf.map (homOfLE h).op
              ((analytifyModuleUnit sX (sX.relativeDifferentialForms (p : ℤ))).val.app (op V) s)
          -- (3) analytic differential forms are holomorphic forms
          ∃ Ψ : ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
              (Ωan p).val.obj (op (U O)) →+
                (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
            (∀ p O, Function.Injective (Ψ p O)) ∧
            (∀ p O (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
              η ∈ Set.range (Ψ p O) ↔
                ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
                  DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : U O, ξ (φ y') = η y') ∧
            (∀ p O₁ O₂ (h : U O₁ ≤ U O₂) (s : (Ωan p).val.obj (op (U O₂))) (y' : U O₁),
              Ψ p O₁ ((Ωan p).val.presheaf.map (homOfLE h).op s) y' = Ψ p O₂ s ⟨y'.1, h y'.2⟩) ∧
            (∀ p O (a : (ringCatSheaf sX).obj.obj (op (U O))) (s : (Ωan p).val.obj (op (U O)))
              (y' : U O), Ψ p O (a • s) y' = Θ.hom.hom.app (op (U O)) a y' • Ψ p O s y') ∧
            (∀ (V : X.Opens) (hV : IsAffineOpen V) O (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V)
              (g : Γ(X, V)) (y' : U O),
              letI := Mori.sectionAlgebra sX V
              Ψ 0 O (an 0 V O h ((DeRham.formsAlgEquiv sX 0 ⟨V, hV⟩).symm
                  ((exteriorPower.zeroEquiv Γ(X, V) Ω[Γ(X, V)⁄ℂ]).symm g))) y' =
                ContinuousAlternatingMap.constOfIsEmpty ℂ (EuclideanSpace ℂ (Fin n)) (Fin 0)
                  (evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ g)) ∧
            (∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
              (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
              letI := Mori.sectionAlgebra sX V
              ∀ (η : ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ])
                (ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
                DifferentiableOn ℂ ξ (φ.target ∩ O) →
                (∀ y' : U O, ξ (φ y') =
                  Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η)) y') →
                ∀ y' : U O, Ψ (p + 1) O (an (p + 1) V O h
                    ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm
                      (KaehlerDifferential.deRhamDifferential (A := ℂ) p η))) y' =
                  extDeriv ξ (φ y')) ∧
            -- (4) logarithmic forms
            let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
            let L := Γ(X, X.basicOpen f)
            letI : Algebra Γ(X, W) L :=
              (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
            letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
            let ε : Fin n → Ω[L⁄ℂ] := fun j =>
              if (j : ℕ) < k then
                Ring.inverse (algebraMap Γ(X, W) L (z j)) •
                  KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
              else KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
            let c : Fin n → ℂ := fun j => evalHom W ⟨y, hφ hy⟩ (z j)
            let e : ∀ p, Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) →
                EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ := fun p I v =>
              ContinuousMultilinearMap.alternatization
                ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
                  fun a =>
                    let j := Set.powersetCard.ofFinEmbEquiv.symm I a
                    (if (j : ℕ) < k then (v j + c j)⁻¹ else 1) • EuclideanSpace.proj j)
            let Dc : Set (EuclideanSpace ℂ (Fin n)) :=
              {v | ∀ j : Fin n, (j : ℕ) < k → v j + c j ≠ 0}
            ∀ p : ℕ,
              (∃ b : Module.Basis (Set.powersetCard (Fin n) p) Γ(X, W)
                  (DeRham.logForms ℂ L (fun i : Fin k => z (Fin.castLE hk i)) p),
                ∀ I, (b I : ExteriorAlgebra L Ω[L⁄ℂ]) =
                  ExteriorAlgebra.ιMulti_family L p ε I) ∧
              (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
                (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
                (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
                (∀ v ∈ φ.target ∩ O ∩ Dc, ∑ I, g I v • e p I v = 0) →
                ∀ I, ∀ v ∈ φ.target ∩ O, g I v = 0) ∧
              (∀ O (h : U O ≤ (Opens.map (toSchemeHom sX)).obj (X.basicOpen f))
                (I : Set.powersetCard (Fin n) p) (y' : U O),
                Ψ p O (an p (X.basicOpen f) O h ((DeRham.formsAlgEquiv sX p
                    ⟨X.basicOpen f, hW.basicOpen f⟩).symm
                      (exteriorPower.ιMulti_family L p ε I))) y' =
                  e p I (φ y')) ∧
              (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
                (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
                (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
                ∃ g' : Set.powersetCard (Fin n) (p + 1) → EuclideanSpace ℂ (Fin n) → ℂ,
                  (∀ J, DifferentiableOn ℂ (g' J) (φ.target ∩ O)) ∧
                  ∀ v ∈ φ.target ∩ O ∩ Dc,
                    extDeriv (fun v' => ∑ I, g I v' • e p I v') v = ∑ J, g' J v • e (p + 1) J v) ∧
              (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
                (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
                (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
                ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
                  DifferentiableOn ℂ ξ (φ.target ∩ O) ∧
                  ∀ v ∈ φ.target ∩ O ∩ Dc,
                    ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
                      ∑ I, g I v • e p I v) ∧
              -- `Ω^p(log E)(-E)` and `Ω^p / Ω^p(log E)(-E)` analytify isomorphically
              (letI := Mori.sectionAlgebra sX W
               let τ : Set.powersetCard (Fin n) p → ⋀[Γ(X, W)]^p Ω[Γ(X, W)⁄ℂ] := fun I =>
                 (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
                   exteriorPower.ιMulti Γ(X, W) p fun a =>
                     KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))
               let S : ∀ O : Opens (EuclideanSpace ℂ (Fin n)),
                   U O ≤ (Opens.map (toSchemeHom sX)).obj W →
                   Submodule ((ringCatSheaf sX).obj.obj (op (U O))) ((Ωan p).val.obj (op (U O))) :=
                 fun O h => Submodule.span _ (Set.range fun I =>
                   an p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I)))
               let HolSub : ∀ O : Opens (EuclideanSpace ℂ (Fin n)),
                   (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) → Prop := fun O η =>
                 ∃ g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ,
                   (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) ∧
                   ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
                     DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ (∀ y' : U O, ξ (φ y') = η y') ∧
                     ∀ v ∈ φ.target ∩ O ∩ Dc,
                       ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
                         ∑ I, g I v • e p I v
               LinearIndependent Γ(X, W) τ ∧
               (∀ I, DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩
                   ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map
                     (homOfLE (X.basicOpen_le f)).op
                     ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I))) =
                 algebraMap Γ(X, W) L f • exteriorPower.ιMulti_family L p ε I) ∧
               (∀ O h (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
                 η ∈ Ψ p O '' (S O h : Set ((Ωan p).val.obj (op (U O)))) ↔ HolSub O η) ∧
               (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
                 (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
                 (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
                 (∀ v ∈ φ.target ∩ O ∩ Dc,
                   (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
                     ∑ I, g I v • e p I v = 0) →
                 ∀ I, ∀ v ∈ φ.target ∩ O, g I v = 0) ∧
               ∀ O h,
                 (∀ s₁ s₂ : (Ωan p).val.obj (op (U O)),
                   (Submodule.Quotient.mk s₁ : _ ⧸ S O h) = Submodule.Quotient.mk s₂ ↔
                     HolSub O (Ψ p O s₁ - Ψ p O s₂)) ∧
                 ∀ η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
                   (∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
                     DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : U O, ξ (φ y') = η y') →
                  ∃ s, HolSub O (η - Ψ p O s)) := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  have hM := isAlgebraicComplexManifold sX (n := n)
  refine ⟨analytificationChartedSpace sX n, hM.1, hM.2.1, hM.2.2.1, hM.2.2.2.1,
    structureSheafIsoHolomorphic sX n, hM.2.2.2.2, fun x hx => ?_⟩
  refine (hasAnalyticLogCoordinatesAt sX (n := n) E hE x hx).elim fun W h => h.elim fun hW h =>
    h.elim fun hxW h => h.elim fun k h => h.elim fun hk h => h.elim fun z h => ?_
  refine ⟨W, hW, hxW, k, hk, z, h.1.1, h.1.2.1, h.1.2.2, fun y hy => ?_⟩
  refine (h.2 y hy).elim fun φ h => h.elim fun hφmax h => h.elim fun hφ h =>
    h.elim fun hyφ h => ?_
  have hΨ := h.2.1
  refine ⟨φ, hφmax, hφ, hyφ, h.1, ?_⟩
  intro U Ωan an
  refine ⟨holomorphicFormsMap sX φ, hΨ.1, hΨ.2.1, hΨ.2.2.1, hΨ.2.2.2.1, hΨ.2.2.2.2.1,
    hΨ.2.2.2.2.2, ?_⟩
  intro f L ε c e Dc p
  have hL := h.2.2 p
