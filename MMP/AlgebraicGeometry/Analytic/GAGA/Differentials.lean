section Setup

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

/-- A smooth complex variety of dimension `n` is smooth of relative dimension `n`. -/
public theorem smoothOfRelativeDimension_of_isSmoothScheme (hX : Mori.IsVariety ℂ sX)
    (hsm : Mori.IsSmoothScheme sX) {n : ℕ} (hdim : topologicalKrullDim X = n) :
    SmoothOfRelativeDimension n sX := by
  haveI : IsVariety ℂ sX := hX
  haveI : Smooth sX := hsm.smooth
  exact MMP.Intersection.smoothOfRelativeDimension_of_isVariety sX n hdim

end Setup

section Atlas

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n sX]

/-- The charts of the étale coordinate atlas are given by regular functions. -/
private theorem atlas_eq_eval :
    ∀ φ ∈ atlas (EuclideanSpace ℂ (Fin n)) (ComplexPoints sX),
      ∃ (W : X.Opens) (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hW : φ.source ⊆ chart W),
        ∀ y (hy : y ∈ φ.source) (i : Fin n), φ y i = evalHom W ⟨y, hW hy⟩ (z i) - c i := by
  rintro _ ⟨c, rfl⟩
  refine ⟨c.U, c.z, 0, fun y hy => c.subset (by rwa [c.source_toChart] at hy), fun y hy i => ?_⟩
  rw [c.source_toChart] at hy
  rw [Pi.zero_apply, sub_zero, evalHom_apply, EtaleCoordinateChart.toChart_apply]
  exact c.toOpenPartialHomeomorph_apply hy i

end Atlas

section Analytic

/-- **Osgood's lemma** on a finite-dimensional space: a complex differentiable function on an
open set is analytic there. -/
private theorem analyticOnNhd_of_differentiableOn_of_finiteDimensional {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E] {S : Set E} (hS : IsOpen S)
    {G : E → ℂ} (hG : DifferentiableOn ℂ G S) : AnalyticOnNhd ℂ G S := by
  let e : E ≃L[ℂ] EuclideanSpace ℂ (Fin (Module.finrank ℂ E)) :=
    (LinearEquiv.ofFinrankEq _ _ (by simp)).toContinuousLinearEquiv
  have h1 : DifferentiableOn ℂ (G ∘ e.symm) (e.symm ⁻¹' S) :=
    hG.comp e.symm.differentiableOn (fun _ h => h)
  have h2 := MMP.Analytic.analyticOnNhd_of_differentiableOn (hS.preimage e.symm.continuous) h1
  intro y hy
  have h3 : AnalyticAt ℂ ((G ∘ e.symm) ∘ e) y :=
    (h2 (e y) (by simpa using hy)).comp (e.analyticAt y)
  simpa [Function.comp_def] using h3

/-- A function complex differentiable near a point of a finite-dimensional space is analytic,
hence smooth, there. -/
private theorem contDiffAt_of_eventually_differentiableAt {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] [FiniteDimensional ℂ E] {G : E → ℂ} {a : E}
    (hG : ∀ᶠ w in 𝓝 a, DifferentiableAt ℂ G w) {N : WithTop ℕ∞} : ContDiffAt ℂ N G a := by
  obtain ⟨T, hT, hTo, haT⟩ := eventually_nhds_iff.1 hG
  exact (analyticOnNhd_of_differentiableOn_of_finiteDimensional hTo
    (fun w hw => (hT w hw).differentiableWithinAt) a haT).contDiffAt

end Analytic

section RegularFunctions

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n sX]

open scoped Classical in
/-- The values of a regular function on `U`, extended by `0` off `U(ℂ)`. -/
private noncomputable def regVal (U : X.Opens) (f : Γ(X, U)) (y : ComplexPoints sX) : ℂ :=
  if h : y ∈ chart U then eval U f ⟨y, h⟩ else 0

private lemma regVal_of_mem {U : X.Opens} (f : Γ(X, U)) {y : ComplexPoints sX}
    (h : y ∈ chart U) : regVal U f y = eval U f ⟨y, h⟩ := by
  classical
  simp only [regVal, dif_pos h]

/-- The preferred chart at a point of `X^an` is an étale coordinate chart. -/
private lemma exists_chartAt_eq (x : ComplexPoints sX) :
    ∃ c : EtaleCoordinateChart sX n, x ∈ c.W ∧
      chartAt (EuclideanSpace ℂ (Fin n)) x = c.toChart (EuclideanSpace.equiv (Fin n) ℂ).symm :=
  ⟨_, (EtaleCoordinateChart.exists_mem_W (n := n) x).choose_spec, rfl⟩

/-- **Regular functions are holomorphic on `X^an`.** -/
private theorem contMDiffAt_regVal (U : X.Opens) (f : Γ(X, U)) {x : ComplexPoints sX}
    (hx : x ∈ chart U) :
    ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (regVal U f) x := by
  obtain ⟨c, hxc, hch⟩ := exists_chartAt_eq (n := n) x
  set L := (EuclideanSpace.equiv (Fin n) ℂ).symm
  obtain ⟨G, hGa, hG⟩ := c.exists_analyticOnNhd U f
  set e := c.toOpenPartialHomeomorph
  have hxs : x ∈ e.source := by rwa [c.source_toOpenPartialHomeomorph]
  set S := e.target ∩ e.symm ⁻¹' chart U
  have hSo : IsOpen S := e.isOpen_inter_preimage_symm (isOpen_chart sX U)
  have hxS : e x ∈ S := ⟨e.map_source hxs, by rwa [Set.mem_preimage, e.left_inv hxs]⟩
  have hloc : ∀ v ∈ S, regVal U f (e.symm v) = G v := by
    intro v hv
    have hW := c.toOpenPartialHomeomorph_symm_mem hv.1
    rw [regVal_of_mem f hv.2, hG _ hW hv.2, c.toOpenPartialHomeomorph_apply_symm hv.1]
  have hloc' : regVal U f =ᶠ[𝓝 x] G ∘ e := by
    have hN : c.W ∩ chart U ∈ 𝓝 x := (c.isOpen.inter (isOpen_chart sX U)).mem_nhds ⟨hxc, hx⟩
    filter_upwards [hN] with y hy
    have hys : y ∈ e.source := by rw [c.source_toOpenPartialHomeomorph]; exact hy.1
    rw [Function.comp_apply, ← hloc _ ⟨e.map_source hys, by
      rw [Set.mem_preimage, e.left_inv hys]; exact hy.2⟩, e.left_inv hys]
  rw [contMDiffAt_iff_of_mem_source (mem_chart_source _ x) (mem_chart_source _ _)]
  refine ⟨?_, ?_⟩
  · refine ContinuousAt.congr ?_ hloc'.symm
    exact (hGa _ hxS).continuousAt.comp (e.continuousAt hxs)
  · simp only [extChartAt, OpenPartialHomeomorph.extend, modelWithCornersSelf_partialEquiv,
      PartialEquiv.trans_refl, OpenPartialHomeomorph.toFun_eq_coe,
      OpenPartialHomeomorph.coe_toPartialEquiv_symm, modelWithCornersSelf_coe, Set.range_id,
      chartAt_self_eq, OpenPartialHomeomorph.refl_partialEquiv, PartialEquiv.refl_coe,
      Function.id_comp]
    rw [hch]
    refine ContDiffAt.contDiffWithinAt ?_
    have hLx : L.symm (c.toChart L x) = e x := L.symm_apply_apply _
    have hA : AnalyticAt ℂ (G ∘ L.symm) (c.toChart L x) := by
      refine AnalyticAt.comp ?_ (L.symm.analyticAt _)
      rw [hLx]
      exact hGa _ hxS
    refine hA.contDiffAt.congr_of_eventuallyEq ?_
    have hN : L.symm ⁻¹' S ∈ 𝓝 (c.toChart L x) := by
      refine (hSo.preimage L.symm.continuous).mem_nhds ?_
      rw [Set.mem_preimage, hLx]
      exact hxS
    filter_upwards [hN] with w hw
    simp only [Function.comp_apply, EtaleCoordinateChart.toChart,
      OpenPartialHomeomorph.transHomeomorph_symm_apply]
    exact hloc _ hw

end RegularFunctions

section Values

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- The value at `p` of a holomorphic germ. -/
private noncomputable def germValue {m : ℕ} (p : Fin m → ℂ) : holGerms p →+* ℂ :=
  Filter.Germ.valueRingHom.comp (holGerms p).subtype

private lemma germValue_eq {m : ℕ} {p : Fin m → ℂ} (g : holGerms p) {h : (Fin m → ℂ) → ℂ}
    (hg : (g : Germ (𝓝 p) ℂ) = h) : germValue p g = h p := by
  simp only [germValue, RingHom.comp_apply, Subring.coe_subtype, hg]
  rfl

/-- The value at a point of an element of the local ring of a chart: the value of any
holomorphic germ representing it, which is well defined since the relations of the chart vanish
at the coordinates of the point. -/
private noncomputable def stalkValue (c : Chart sX) (y : chart (sX := sX) c.U) :
    c.StalkRing (c.coords y) →+* ℂ :=
  Ideal.Quotient.lift (c.ideal.map (polyGermHom (c.coords y))) (germValue (c.coords y))
    fun g hg => by
      have hle : c.ideal.map (polyGermHom (c.coords y)) ≤
          RingHom.ker (germValue (c.coords y)) := by
        rw [Ideal.map_le_iff_le_comap]
        intro q hq
        rw [Ideal.mem_comap, RingHom.mem_ker, germValue_eq _ (coe_polyGermHom _ q),
          ← c.evalHom_pres, (RingHom.mem_ker).1 hq, map_zero]
      exact hle hg

private lemma stalkValue_mk (c : Chart sX) (y : chart (sX := sX) c.U)
    (g : holGerms (c.coords y)) :
    stalkValue c y (Chart.StalkRing.mk c _ g) = germValue _ g :=
  Ideal.Quotient.lift_mk _ _ _

private lemma stalkValue_transition {c d : Chart sX} (m : ChartHom c d)
    (y : chart (sX := sX) d.U) (t : c.StalkRing (c.coords (m.incl y))) :
    stalkValue d y (m.transition y t) = stalkValue c (m.incl y) t := by
  obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective t
  change stalkValue d y (m.transition y (Chart.StalkRing.mk c _ g)) =
    stalkValue c _ (Chart.StalkRing.mk c _ g)
  rw [m.transition_mk, stalkValue_mk, stalkValue_mk]
  obtain ⟨f, hf, -⟩ := g.2
  rw [germValue_eq _ (h := f ∘ m.polyMap) (by rw [coe_holPullback, ← hf]; rfl),
    germValue_eq g hf.symm, Function.comp_apply, ← m.coords_incl]

private lemma stalkValue_toStalkRing (c : Chart sX) (y : chart (sX := sX) c.U)
    (a : Γ(X, c.U)) : stalkValue c y (c.toStalkRing (c.coords y) a) = evalHom c.U y a := by
  obtain ⟨q, rfl⟩ := c.surjective a
  change stalkValue c y (c.toStalkRing _ (c.pres q)) = _
  rw [Chart.toStalkRing_pres, stalkValue_mk, germValue_eq _ (coe_polyGermHom _ q)]
  exact (c.evalHom_pres y q).symm

/-- A germ in the ideal generated by the relations of a chart has value `0` at a common zero of
the relations. -/
private lemma germValue_eq_zero_of_mem (c : Chart sX) {q : Fin c.n → ℂ}
    (hq : ∀ r ∈ c.ideal, MvPolynomial.eval q r = 0) {g : holGerms q}
    (hg : g ∈ c.ideal.map (polyGermHom q)) : germValue q g = 0 := by
  have hle : c.ideal.map (polyGermHom q) ≤ RingHom.ker (germValue q) := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, RingHom.mem_ker, germValue_eq _ (coe_polyGermHom _ r)]
    exact hq r hr
  exact hle hg

/-- Every point of `X^an` lies in a chart. -/
public lemma exists_chart_mem [LocallyOfFiniteType sX] (x : ComplexPoints sX) :
    ∃ c : Chart sX, x ∈ chart c.U := by
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x.toScheme) (U := ⊤) trivial
  obtain ⟨c, rfl⟩ := Chart.exists_eq (sX := sX) hU
  exact ⟨c, mem_chart_iff.2 hxU⟩

/-- The value at a point of a section of `𝒪_{X^an}`, read in some chart. -/
private noncomputable def sectionValue [LocallyOfFiniteType sX] {W : Opens (space sX)}
    (s : sections sX W) (x : W) : ℂ :=
  stalkValue (exists_chart_mem x.1).choose ⟨x.1, (exists_chart_mem x.1).choose_spec⟩
    (s.1 x ⟨_, (exists_chart_mem x.1).choose_spec⟩)

/-- The value of a section does not depend on the chart it is read in. -/
private lemma sectionValue_eq [LocallyOfFiniteType sX] {W : Opens (space sX)}
    (s : sections sX W) (x : W) (c : Chart sX) (hx : x.1 ∈ chart c.U) :
    sectionValue s x = stalkValue c ⟨x.1, hx⟩ (s.1 x ⟨c, hx⟩) := by
  have hx' := (exists_chart_mem x.1).choose_spec
  obtain ⟨f, e, he, heU, hxe⟩ := Chart.exists_refinement c (exists_chart_mem x.1).choose x.1
    (mem_chart_iff.1 hx) (mem_chart_iff.1 hx')
  have hec : e.U ≤ c.U := he ▸ X.basicOpen_le f
  have hxe' : x.1 ∈ chart e.U := mem_chart_iff.2 hxe
  have hcomp := (s.2 : IsLocallyHolomorphic s.1 ∧ IsCompatible s.1).2
  have h1 := hcomp c e (ChartHom.ofLE c e hec) x hxe'
  have h2 := hcomp _ e (ChartHom.ofLE _ e heU) x hxe'
  have v1 := stalkValue_transition (ChartHom.ofLE c e hec) ⟨x.1, hxe'⟩
    (s.1 x ⟨c, chart_mono hec hxe'⟩)
  have v2 := stalkValue_transition (ChartHom.ofLE _ e heU) ⟨x.1, hxe'⟩
    (s.1 x ⟨_, chart_mono heU hxe'⟩)
  rw [h1] at v1
  rw [h2] at v2
  exact v2.symm.trans v1

/-- The value of `α_X^#(g)` at `y` is `g(y)`. -/
private lemma sectionValue_sharpHom [LocallyOfFiniteType sX] (V : X.Opens) (g : Γ(X, V))
    (y : (Opens.map (toSchemeHom sX)).obj V) :
    sectionValue (sharpHom V g) y = evalHom V ⟨y.1, mem_chart_iff.2 y.2⟩ g := by
  obtain ⟨c0, hc0⟩ := exists_chart_mem y.1
  obtain ⟨f, e, he, heV, hye⟩ :=
    Chart.exists_basicOpen c0.isAffineOpen y.1 (mem_chart_iff.1 hc0) y.2
  have hye' : y.1 ∈ chart e.U := mem_chart_iff.2 (he ▸ hye)
  have heV' : e.U ≤ V := he ▸ heV
  rw [sectionValue_eq _ y e hye', sharpHom_apply,
    ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE heV') _ (mem_chart_iff.1 hye') g,
    Chart.stalkHom_germ, stalkValue_toStalkRing, ← evalHom_res]

end Values

section EvalMorphism

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [LocallyOfFiniteType sX]
  [SmoothOfRelativeDimension n sX]

/-- The coordinates of a chart, as functions on `X^an` (extended by `0`). -/
private noncomputable def chartCoords (c : Chart sX) (y : ComplexPoints sX) : Fin c.n → ℂ :=
  fun i => regVal c.U (c.gen i) y

private lemma chartCoords_eq (c : Chart sX) {y : ComplexPoints sX} (hy : y ∈ chart c.U) :
    chartCoords c y = c.coords ⟨y, hy⟩ := by
  funext i
  rw [chartCoords, regVal_of_mem _ hy]
  rfl

private lemma contMDiffAt_chartCoords (c : Chart sX) {y : ComplexPoints sX}
    (hy : y ∈ chart c.U) :
    ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ, Fin c.n → ℂ) ∞ (chartCoords c) y :=
  contMDiffAt_pi_space.2 fun i => contMDiffAt_regVal c.U (c.gen i) hy

/-- A holomorphic function of the coordinates of a chart is holomorphic on `X^an`. -/
private lemma contMDiffAt_comp_chartCoords (c : Chart sX) {y : ComplexPoints sX}
    (hy : y ∈ chart c.U) {h : (Fin c.n → ℂ) → ℂ}
    (hh : ∀ᶠ w in 𝓝 (c.coords ⟨y, hy⟩), DifferentiableAt ℂ h w) :
    ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (h ∘ chartCoords c) y := by
  have hd : ContDiffAt ℂ ∞ h (chartCoords c y) := by
    rw [chartCoords_eq c hy]
    exact contDiffAt_of_eventually_differentiableAt hh
  exact hd.comp_contMDiffAt (contMDiffAt_chartCoords c hy)

/-- A function whose germ is a holomorphic germ is complex differentiable near the point. -/
private lemma eventually_differentiableAt_of_coe_eq {m : ℕ} {p : Fin m → ℂ} (g : holGerms p)
    {h : (Fin m → ℂ) → ℂ} (hg : (g : Germ (𝓝 p) ℂ) = h) :
    ∀ᶠ w in 𝓝 p, DifferentiableAt ℂ h w := by
  obtain ⟨f, hf, hfd⟩ := g.2
  have heq : f =ᶠ[𝓝 p] h := Germ.coe_eq.1 (hf.trans hg)
  obtain ⟨T, hT, hTo, hxT⟩ := eventually_nhds_iff.1 (hfd.and heq)
  filter_upwards [hTo.mem_nhds hxT] with w hw
  refine ((hT w hw).1).congr_of_eventuallyEq ?_
  filter_upwards [hTo.mem_nhds hw] with w' hw'
  exact (hT w' hw').2.symm

/-- Near every point, the value of a section is a holomorphic function `h` of the coordinates of
any chart, and the component of the section at the point is the class of the germ of `h`. -/
private lemma exists_eventually_sectionValue {W : Opens (space sX)} (s : sections sX W) (x : W)
    (c : Chart sX) (hx : x.1 ∈ chart c.U) :
    ∃ (h : (Fin c.n → ℂ) → ℂ) (g : holGerms (c.coords ⟨x.1, hx⟩)),
      (g : Germ (𝓝 (c.coords ⟨x.1, hx⟩)) ℂ) = (h : Germ (𝓝 (c.coords ⟨x.1, hx⟩)) ℂ) ∧
      s.1 x ⟨c, hx⟩ = Chart.StalkRing.mk c _ g ∧
      (∀ᶠ w in 𝓝 (c.coords ⟨x.1, hx⟩), DifferentiableAt ℂ h w) ∧
      ∀ᶠ y in 𝓝 x.1, ∀ (hyW : y ∈ W) (hyc : y ∈ chart c.U),
        sectionValue s ⟨y, hyW⟩ = h (c.coords ⟨y, hyc⟩) := by
  obtain ⟨O, hO, hxO, h, hh⟩ := (s.2 : IsLocallyHolomorphic s.1 ∧ IsCompatible s.1).1 c x hx
  obtain ⟨hxW', gx, hgx, hsx⟩ := hh ⟨x.1, hx⟩ hxO
  refine ⟨h, gx, hgx, hsx, eventually_differentiableAt_of_coe_eq gx hgx, ?_⟩
  have hOo : IsOpen (Subtype.val '' O) := c.isOpen_image_val hO
  filter_upwards [hOo.mem_nhds ⟨_, hxO, rfl⟩] with y hy hyW hyc
  obtain ⟨y₀, hy₀, rfl⟩ := hy
  obtain ⟨hyW', g, hg, hsg⟩ := hh y₀ hy₀
  rw [sectionValue_eq s ⟨y₀.1, hyW⟩ c hyc]
  have := congrArg (stalkValue c y₀) hsg
  rwa [stalkValue_mk, germValue_eq g hg] at this

/-- The value function of a section is holomorphic. -/
private lemma contMDiff_sectionValue {W : Opens (space sX)} (s : sections sX W) :
    ContMDiff 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (fun y : W => sectionValue s y) := by
  intro x
  obtain ⟨c, hc⟩ := exists_chart_mem x.1
  obtain ⟨h, -, -, -, hhd, hev⟩ := exists_eventually_sectionValue s x c hc
  have hF := (contMDiffAt_comp_chartCoords (n := n) c hc hhd).comp x
    (contMDiff_subtype_val (I := 𝓘(ℂ, EuclideanSpace ℂ (Fin n))) (n := ∞) (U := W) x)
  refine hF.congr_of_eventuallyEq ?_
  have hc' : ∀ᶠ y in 𝓝 x.1, y ∈ chart c.U := (isOpen_chart sX c.U).mem_nhds hc
  filter_upwards [continuous_subtype_val.continuousAt.eventually (hev.and hc')] with y hy
  rw [Function.comp_apply, Function.comp_apply, chartCoords_eq c hy.2]
  exact hy.1 y.2 hy.2

/-- The value map on sections of `𝒪_{X^an}`. -/
private noncomputable def evRingHom (W : Opens (space sX)) :
    sections sX W →+* C^∞⟮𝓘(ℂ, EuclideanSpace ℂ (Fin n)), W; 𝓘(ℂ), ℂ⟯ where
  toFun s := ⟨fun y => sectionValue s y, contMDiff_sectionValue s⟩
  map_one' := by ext y; simp [sectionValue]
  map_mul' a b := by
    ext y
    change sectionValue (a * b) y = sectionValue a y * sectionValue b y
    simp [sectionValue]
  map_zero' := by ext y; simp [sectionValue]
  map_add' a b := by
    ext y
    change sectionValue (a + b) y = sectionValue a y + sectionValue b y
    simp [sectionValue]

/-- The morphism `𝒪_{X^an} ⟶ 𝒪[n, X^an]` sending a section to its function of values. -/
private noncomputable def evHom : structureSheaf sX ⟶ 𝒪[n, ComplexPoints sX] :=
  ⟨{ app := fun W => CommRingCat.ofHom (evRingHom W.unop)
     naturality := fun W W' i => by
       ext s : 2
       rfl }⟩

end EvalMorphism

section SubmersiveChart

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

/-- The structure homomorphism of a chart is that of the `ℂ`-algebra of sections. -/
private lemma baseRingHom_eq_algebraMap (U : X.Opens) :
    baseRingHom sX U = (letI := Mori.sectionAlgebra sX U; algebraMap ℂ Γ(X, U)) := by
  letI := Mori.sectionAlgebra sX U
  ext a
  change (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    ((sX.appTop).hom ((Scheme.ΓSpecIso (.of ℂ)).inv.hom a)) =
      ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sX.appLE ⊤ U (by simp)).hom a
  rw [CommRingCat.comp_apply]
  rfl

variable [LocallyOfFiniteType sX] [Smooth sX]

/-- **Submersive charts.** Every point of `X^an` lies in a chart whose ideal of relations is
generated by finitely many polynomials defining a holomorphic submersion `ℂᴺ → ℂ^σ`. -/
private theorem exists_submersive_chart (x : ComplexPoints sX) :
    ∃ (c : Chart sX) (_ : x ∈ chart c.U) (σ : Type) (_ : Fintype σ) (_ : DecidableEq σ)
      (R : σ → MvPolynomial (Fin c.n) ℂ), c.ideal = Ideal.span (Set.range R) ∧
      MMP.SmoothLevelSet.IsSubmersionOn (𝕜 := ℂ) ⊤ Set.univ
        (fun w j => MvPolynomial.eval w (R j)) := by
  classical
  obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := x.toScheme) (U := ⊤) trivial
  letI := Mori.sectionAlgebra sX U₀
  have : Algebra.Smooth ℂ Γ(X, U₀) := MMP.Flips.ResolutionInputs.smooth_sectionAlgebra sX hU₀
  set P₀ := (hU₀.primeIdealOf ⟨x.toScheme, hxU₀⟩).asIdeal
  obtain ⟨f, hf, hstd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth ℂ P₀
  obtain ⟨ι, σ, _, _, ⟨P⟩⟩ := hstd.out
  letI := Fintype.ofFinite ι
  letI := Fintype.ofFinite σ
  let eι : Fin (Fintype.card ι) ≃ ι := (Fintype.equivFin ι).symm
  let P' := P.reindex eι (Equiv.refl σ)
  have hU : IsAffineOpen (X.basicOpen f) := hU₀.basicOpen f
  letI : Algebra Γ(X, U₀) Γ(X, X.basicOpen f) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  haveI : IsLocalization.Away f Γ(X, X.basicOpen f) := hU₀.isLocalization_basicOpen f
  let ψL : Localization.Away f ≃ₐ[Γ(X, U₀)] Γ(X, X.basicOpen f) :=
    IsLocalization.algEquiv (Submonoid.powers f) _ _
  let gen : Fin (Fintype.card ι) → Γ(X, X.basicOpen f) := fun i => ψL (P'.val i)
  have hpres : MvPolynomial.eval₂Hom (baseRingHom sX (X.basicOpen f)) gen =
      ψL.toRingEquiv.toRingHom.comp (MvPolynomial.aeval P'.val).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom, MvPolynomial.aeval_C, baseRingHom_eq_algebraMap,
        IsScalarTower.algebraMap_apply ℂ Γ(X, U₀) (Localization.Away f)]
      change _ = ψL (algebraMap Γ(X, U₀) (Localization.Away f) (algebraMap ℂ Γ(X, U₀) a))
      rw [AlgEquiv.commutes]
      exact (MMP.Flips.ResolutionInputs.sectionAlgebra_map_res sX (X.basicOpen_le f) a).symm
    · intro i
      simp [gen]
  have hsurj : Function.Surjective
      (MvPolynomial.eval₂Hom (baseRingHom sX (X.basicOpen f)) gen) := by
    rw [hpres]
    exact ψL.surjective.comp P'.aeval_val_surjective
  let c : Chart sX := ⟨X.basicOpen f, hU, Fintype.card ι, gen, hsurj⟩
  have hxc : x ∈ chart c.U := by
    refine mem_chart_iff.2 ?_
    let _ : Algebra Γ(X, U₀) (X.presheaf.stalk x.toScheme) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x.toScheme, hxU₀⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk x.toScheme) P₀ :=
      hU₀.isLocalization_stalk ⟨x.toScheme, hxU₀⟩
    change x.toScheme ∈ X.basicOpen f
    rw [Scheme.mem_basicOpen X f x.toScheme hxU₀]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x.toScheme) P₀ f).mpr hf
  refine ⟨c, hxc, σ, inferInstance, inferInstance, P'.relation, ?_,
    MMP.SubmersivePresentationLevelSet.isSubmersionOn_relMap P' le_top⟩
  change RingHom.ker c.pres = _
  have hcp : c.pres = ψL.toRingEquiv.toRingHom.comp (MvPolynomial.aeval P'.val).toRingHom :=
    hpres
  ext q
  rw [RingHom.mem_ker, hcp, P'.span_range_relation_eq_ker,
    Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker]
  change ψL (MvPolynomial.aeval P'.val q) = 0 ↔ MvPolynomial.aeval P'.val q = 0
  exact map_eq_zero_iff ψL ψL.injective

end SubmersiveChart

section Retraction

open MMP.SmoothLevelSet

/-- **A holomorphic retraction onto the zero set of a submersion.** Let `R` be polynomials on
`ℂᴺ` defining a holomorphic submersion and `p` a common zero. Near `p` there is a holomorphic map
`ρ` with `ρ p = p`, with values in the zero set and the identity on it, such that `h - h ∘ ρ`
lies in the ideal generated by the germs of the `R_j` for every `h` holomorphic near `p`
(inverse function theorem and Hadamard division). -/
private theorem exists_retraction {N : ℕ} {σ : Type} [Fintype σ] [DecidableEq σ]
    (R : σ → MvPolynomial (Fin N) ℂ)
    (hsub : IsSubmersionOn (𝕜 := ℂ) ⊤ Set.univ
      (fun w j => MvPolynomial.eval w (R j)))
    {p : Fin N → ℂ} (hp : ∀ j, MvPolynomial.eval p (R j) = 0) :
    ∃ ρ : (Fin N → ℂ) → (Fin N → ℂ), ρ p = p ∧ (∀ᶠ w in 𝓝 p, DifferentiableAt ℂ ρ w) ∧
      (∀ᶠ w in 𝓝 p, ∀ j, MvPolynomial.eval (ρ w) (R j) = 0) ∧
      (∀ᶠ w in 𝓝 p, (∀ j, MvPolynomial.eval w (R j) = 0) → ρ w = w) ∧
      ∀ h : (Fin N → ℂ) → ℂ, (∀ᶠ w in 𝓝 p, DifferentiableAt ℂ h w) →
        ∃ g ∈ Ideal.span (Set.range fun j => polyGermHom p (R j)),
          (g : Germ (𝓝 p) ℂ) = ((fun w => h w - h (ρ w) : (Fin N → ℂ) → ℂ) : Germ (𝓝 p) ℂ) := by
  classical
  set F : (Fin N → ℂ) → (σ → ℂ) := fun w j => MvPolynomial.eval w (R j) with hFdef
  have hpz : p ∈ levelSet Set.univ F := ⟨trivial, funext hp⟩
  set ψ := localDiffeo hsub hpz
  have hps : p ∈ ψ.source := mem_localDiffeo_source hsub hpz
  have hψapp : ∀ w, ψ w = (F w, proj ℂ F p w) := fun w =>
    localDiffeo_apply hsub hpz w
  have hψd : ∀ w, DifferentiableAt ℂ ψ w := fun w => by
    have h1 := (contDiffAt_prodFun hsub (z := p) (Set.mem_univ w)).differentiableAt
      (by simp)
    have h2 : (ψ : (Fin N → ℂ) → _) = prodFun ℂ F p := funext fun w =>
      localDiffeo_apply hsub hpz w
    rwa [h2]
  let ζ : (Fin N → ℂ) → (σ → ℂ) × ker ℂ F p := fun w => (0, (ψ w).2)
  have hζd : ∀ w, DifferentiableAt ℂ ζ w := fun w =>
    (differentiableAt_const _).prodMk (hψd w).snd
  have hFp : F p = 0 := funext hp
  have hζp : ζ p = ψ p := by
    simp only [ζ]
    rw [hψapp, hFp]
  let ρ : (Fin N → ℂ) → (Fin N → ℂ) := fun w => ψ.symm (ζ w)
  have hρp : ρ p = p := by
    simp only [ρ]
    rw [hζp, ψ.left_inv hps]
  have hζt : ∀ᶠ w in 𝓝 p, ζ w ∈ ψ.target := by
    have : ζ p ∈ ψ.target := hζp ▸ ψ.map_source hps
    exact (hζd p).continuousAt.preimage_mem_nhds (ψ.open_target.mem_nhds this)
  refine ⟨ρ, hρp, ?_, ?_, ?_, ?_⟩
  · filter_upwards [hζt] with w hw
    exact ((contDiffAt_localDiffeo_symm hsub hpz hw).differentiableAt
      (by simp)).comp w (hζd w)
  · filter_upwards [hζt] with w hw j
    exact congrFun (localDiffeo_symm_mem_levelSet hsub hpz hw).2 j
  · filter_upwards [ψ.open_source.mem_nhds hps] with w hw hzero
    have : ψ w = ζ w := by
      simp only [ζ]
      rw [hψapp w, show F w = 0 from funext hzero]
    simp only [ρ]
    rw [← this, ψ.left_inv hw]
  · intro h hh
    let K := ker ℂ F p
    let bK := Module.finBasis ℂ K
    let Lin : ((σ → ℂ) × K) ≃L[ℂ] (σ ⊕ Fin (Module.finrank ℂ K) → ℂ) :=
      ((LinearEquiv.prodCongr (LinearEquiv.refl ℂ (σ → ℂ)) bK.equivFun).trans
        (LinearEquiv.sumArrowLequivProdArrow σ (Fin (Module.finrank ℂ K)) ℂ ℂ).symm
        ).toContinuousLinearEquiv
    have hLinl : ∀ (a : σ → ℂ) (k : K) j, Lin (a, k) (Sum.inl j) = a j := fun a k j => by
      simp [Lin]
    have hLinr : ∀ (a : σ → ℂ) (k : K) m, Lin (a, k) (Sum.inr m) = bK.equivFun k m :=
      fun a k m => by simp [Lin]
    let h' : (σ ⊕ Fin (Module.finrank ℂ K) → ℂ) → ℂ := fun y => h (ψ.symm (Lin.symm y))
    set b := Lin (ψ p)
    have hpt : ψ p ∈ ψ.target := ψ.map_source hps
    have hh' : ∀ᶠ y in 𝓝 b, DifferentiableAt ℂ h' y := by
      have hc : ContinuousAt (fun y => ψ.symm (Lin.symm y)) b := by
        refine ContinuousAt.comp (f := Lin.symm) ?_ Lin.symm.continuous.continuousAt
        rw [show Lin.symm b = ψ p from Lin.symm_apply_apply _]
        exact ψ.continuousAt_symm hpt
      have hc' : Tendsto (fun y => ψ.symm (Lin.symm y)) (𝓝 b) (𝓝 p) := by
        have := hc.tendsto
        rwa [show ψ.symm (Lin.symm b) = p by
          rw [show Lin.symm b = ψ p from Lin.symm_apply_apply _, ψ.left_inv hps]] at this
      have ht : ∀ᶠ y in 𝓝 b, Lin.symm y ∈ ψ.target := by
        refine Lin.symm.continuous.continuousAt.preimage_mem_nhds ?_
        rw [show Lin.symm b = ψ p from Lin.symm_apply_apply _]
        exact ψ.open_target.mem_nhds hpt
      filter_upwards [ht, hc'.eventually hh] with y hy1 hy2
      exact hy2.comp y (((contDiffAt_localDiffeo_symm hsub hpz hy1).differentiableAt
        (by simp)).comp y Lin.symm.differentiableAt)
    let Fm : (Fin N → ℂ) → (σ ⊕ Fin (Module.finrank ℂ K) → ℂ) := fun w => Lin (ψ w)
    let Gm : (Fin N → ℂ) → (σ ⊕ Fin (Module.finrank ℂ K) → ℂ) := fun w => Lin (ζ w)
    have hFmd : ∀ᶠ w in 𝓝 p, DifferentiableAt ℂ Fm w :=
      Eventually.of_forall fun w => Lin.differentiableAt.comp w (hψd w)
    have hGmd : ∀ᶠ w in 𝓝 p, DifferentiableAt ℂ Gm w :=
      Eventually.of_forall fun w => Lin.differentiableAt.comp w (hζd w)
    have hGmp : Gm p = b := by simp only [Gm, b, hζp]
    set I : Ideal (holGerms p) := Ideal.span (Set.range fun j => polyGermHom p (R j))
    have hI : ∀ i, ∃ g ∈ I, (g : Germ (𝓝 p) ℂ) = ↑(fun w => Fm w i - Gm w i) := by
      intro i
      rcases i with j | m
      · refine ⟨polyGermHom p (R j), Ideal.subset_span ⟨j, rfl⟩, ?_⟩
        rw [coe_polyGermHom]
        refine Germ.coe_eq.2 (Eventually.of_forall fun w => ?_)
        simp only [Fm, Gm, ζ]
        rw [hψapp w, hLinl, hLinl]
        simp [F]
      · refine ⟨0, I.zero_mem, ?_⟩
        refine (Germ.coe_eq.2 (Eventually.of_forall fun w => ?_)).symm
        simp only [Fm, Gm, ζ]
        rw [hψapp w, hLinr, hLinr]
        simp
    obtain ⟨g, hgI, hg⟩ :=
      (exists_sub_eq_sum_sub_mul_and_comp_sub_comp_mem (E := Fin N → ℂ) hh').2 p Fm Gm
        hFmd hGmd rfl hGmp I hI
    refine ⟨g, hgI, hg.trans (Germ.coe_eq.2 ?_)⟩
    filter_upwards [ψ.open_source.mem_nhds hps] with w hw
    simp only [h', Fm, Gm, ρ, ContinuousLinearEquiv.symm_apply_apply, ψ.left_inv hw]

end Retraction

section StalkIso

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [LocallyOfFiniteType sX]
  [SmoothOfRelativeDimension n sX]

/-- **A good chart at every point.** Every point `x` of `X^an` lies in a chart in which a
holomorphic function of the coordinates vanishing on `X^an` near `x` lies in the ideal of the
relations, and in which every holomorphic function on `X^an` near `x` is a holomorphic function of
the coordinates. -/
private theorem exists_goodChart (x : ComplexPoints sX) :
    ∃ (c : Chart sX) (hx : x ∈ chart c.U),
      (∀ h : (Fin c.n → ℂ) → ℂ, (∀ᶠ w in 𝓝 (c.coords ⟨x, hx⟩), DifferentiableAt ℂ h w) →
        (∀ᶠ y in 𝓝 x, ∀ hy : y ∈ chart c.U, h (c.coords ⟨y, hy⟩) = 0) →
        ∃ g ∈ c.ideal.map (polyGermHom (c.coords ⟨x, hx⟩)),
          (g : Germ (𝓝 (c.coords ⟨x, hx⟩)) ℂ) = (h : Germ (𝓝 (c.coords ⟨x, hx⟩)) ℂ)) ∧
      (∀ F : ComplexPoints sX → ℂ,
        ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ F x →
        ∃ h : (Fin c.n → ℂ) → ℂ, (∀ᶠ w in 𝓝 (c.coords ⟨x, hx⟩), DifferentiableAt ℂ h w) ∧
          ∀ᶠ y in 𝓝 x, ∀ hy : y ∈ chart c.U, h (c.coords ⟨y, hy⟩) = F y) := by
  classical
  have : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  obtain ⟨c, hx, σ, _, _, R, hideal, hsub⟩ := exists_submersive_chart (sX := sX) x
  set p := c.coords ⟨x, hx⟩ with hpdef
  have hRmem : ∀ j, R j ∈ c.ideal := fun j => hideal ▸ Ideal.subset_span ⟨j, rfl⟩
  have hcoordsZ : ∀ (y : chart (sX := sX) c.U) j, MvPolynomial.eval (c.coords y) (R j) = 0 :=
    fun y j => by rw [← c.evalHom_pres, (RingHom.mem_ker).1 (hRmem j), map_zero]
  have hrange := (c.isOpen_chart_and_isEmbedding_coords).2.2.2
  have hZ : ∀ w : Fin c.n → ℂ, (∀ j, MvPolynomial.eval w (R j) = 0) →
      w ∈ Set.range c.coords := fun w hw => by
    rw [hrange, MvPolynomial.mem_zeroLocus_iff]
    intro q hq
    change MvPolynomial.eval w q = 0
    rw [hideal] at hq
    induction hq using Submodule.span_induction with
    | mem r hr =>
      obtain ⟨j, rfl⟩ := hr
      exact hw j
    | zero => simp
    | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
    | smul a b _ hb => rw [smul_eq_mul, map_mul, hb, mul_zero]
  -- neighbourhoods of `x` are traced by neighbourhoods of `p` on the zero set
  have hloc : ∀ {P : (Fin c.n → ℂ) → Prop},
      (∀ᶠ y in 𝓝 x, ∀ hy : y ∈ chart c.U, P (c.coords ⟨y, hy⟩)) →
        ∀ᶠ u in 𝓝 p, u ∈ Set.range c.coords → P u := by
    intro P hP
    obtain ⟨O, hOsub, hOo, hxO⟩ := mem_nhds_iff.1 hP
    have hO' : IsOpen ((Subtype.val : chart (sX := sX) c.U → _) ⁻¹' O) :=
      hOo.preimage continuous_subtype_val
    obtain ⟨B, hBo, hB⟩ :=
      (c.isOpen_chart_and_isEmbedding_coords).2.2.1.isInducing.isOpen_iff.1 hO'
    have hpB : p ∈ B := by
      have : (⟨x, hx⟩ : chart (sX := sX) c.U) ∈ c.coords ⁻¹' B := by rwa [hB]
      exact this
    filter_upwards [hBo.mem_nhds hpB] with u hu hz
    obtain ⟨y, rfl⟩ := hz
    have hyO : y ∈ (Subtype.val : chart (sX := sX) c.U → _) ⁻¹' O := by rwa [← hB]
    exact hOsub hyO y.2
  obtain ⟨ρ, hρp, hρd, hρZ, hρfix, hρH⟩ := exists_retraction R hsub (hcoordsZ ⟨x, hx⟩)
  have hρtend : Tendsto ρ (𝓝 p) (𝓝 p) := by
    have := hρd.self_of_nhds.continuousAt.tendsto
    rwa [hρp] at this
  have hspan : Ideal.span (Set.range fun j => polyGermHom p (R j)) ≤
      c.ideal.map (polyGermHom p) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact Ideal.mem_map_of_mem _ (hRmem j)
  have hcont : Tendsto (chartCoords c) (𝓝 x) (𝓝 p) := by
    rw [hpdef, ← chartCoords_eq c hx]
    exact (contMDiffAt_chartCoords (n := n) c hx).continuousAt
  have hc : ∀ᶠ y in 𝓝 x, y ∈ chart c.U := (isOpen_chart sX c.U).mem_nhds hx
  refine ⟨c, hx, fun h hhd hvan => ?_, fun F₀ hF => ?_⟩
  · obtain ⟨g, hgI, hg⟩ := hρH h hhd
    have hvan' := hloc (P := fun u => h u = 0) hvan
    have h0 : ∀ᶠ w in 𝓝 p, h (ρ w) = 0 := by
      filter_upwards [hρtend.eventually hvan', hρZ] with w h1 h2
      exact h1 (hZ _ h2)
    refine ⟨g, hspan hgI, hg.trans (Germ.coe_eq.2 ?_)⟩
    filter_upwards [h0] with w hw
    simp [hw]
  · obtain ⟨c', hxc', hch⟩ := exists_chartAt_eq (n := n) x
    set L := (EuclideanSpace.equiv (Fin n) ℂ).symm
    have hxU' : x ∈ (Opens.map (toSchemeHom sX)).obj c'.U := mem_chart_iff.1 (c'.subset hxc')
    have hH := fun i => exists_eventually_sectionValue (sharpHom c'.U (c'.z i)) ⟨x, hxU'⟩ c hx
    choose H gH hgH hsgH hHd hHev using hH
    have hHev' : ∀ i, ∀ᶠ y in 𝓝 x, ∀ (hy' : y ∈ chart c'.U) (hyc : y ∈ chart c.U),
        eval c'.U (c'.z i) ⟨y, hy'⟩ = H i (c.coords ⟨y, hyc⟩) := fun i => by
      filter_upwards [hHev i] with y hy hy' hyc
      have := hy (mem_chart_iff.1 hy') hyc
      rwa [sectionValue_sharpHom, evalHom_apply] at this
    let Hvec : (Fin c.n → ℂ) → EuclideanSpace ℂ (Fin n) := fun w => L (fun i => H i w)
    let G₀ : EuclideanSpace ℂ (Fin n) → ℂ := F₀ ∘ (c'.toChart L).symm
    have hG₀ : ContDiffAt ℂ ∞ G₀ (c'.toChart L x) := by
      have h1 := (contMDiffAt_iff_of_mem_source (mem_chart_source _ x)
        (mem_chart_source _ (F₀ x))).1 hF
      simp only [extChartAt, OpenPartialHomeomorph.extend, modelWithCornersSelf_partialEquiv,
        PartialEquiv.trans_refl, OpenPartialHomeomorph.toFun_eq_coe,
        OpenPartialHomeomorph.coe_toPartialEquiv_symm, modelWithCornersSelf_coe, Set.range_id,
        chartAt_self_eq, OpenPartialHomeomorph.refl_partialEquiv, PartialEquiv.refl_coe,
        Function.id_comp] at h1
      rw [hch] at h1
      exact contDiffWithinAt_univ.1 h1.2
    have hHvp : Hvec p = c'.toChart L x := by
      simp only [Hvec, EtaleCoordinateChart.toChart_apply]
      congr 1
      funext i
      rw [← (hHev' i).self_of_nhds (c'.subset hxc') hx]
      exact (c'.toOpenPartialHomeomorph_apply hxc' i).symm
    have hG₀d : ∀ᶠ v in 𝓝 (Hvec p), DifferentiableAt ℂ G₀ v := by
      rw [hHvp]
      filter_upwards [(hG₀.of_le (by simp : (1 : WithTop ℕ∞) ≤ ∞)).eventually (by simp)] with v hv
      exact hv.differentiableAt one_ne_zero
    have hHvd : ∀ᶠ w in 𝓝 p, DifferentiableAt ℂ Hvec w := by
      filter_upwards [Filter.eventually_all.2 hHd] with w hw
      exact L.differentiableAt.comp w (differentiableAt_pi.2 hw)
    have hHvt : Tendsto (fun w => Hvec (ρ w)) (𝓝 p) (𝓝 (Hvec p)) :=
      (hHvd.self_of_nhds).continuousAt.tendsto.comp hρtend
    refine ⟨fun w => G₀ (Hvec (ρ w)), ?_, ?_⟩
    · filter_upwards [hρd, hρtend.eventually hHvd, hHvt.eventually hG₀d] with w h1 h2 h3
      exact DifferentiableAt.comp (g := G₀) w h3 (h2.comp w h1)
    · have hW : ∀ᶠ y in 𝓝 x, y ∈ c'.W := c'.isOpen.mem_nhds hxc'
      filter_upwards [hW, hc, Filter.eventually_all.2 hHev', hcont.eventually hρfix]
        with y hyW hyc hyH hyfix
      intro hy
      rw [chartCoords_eq c hyc] at hyfix
      have hfix := hyfix (hcoordsZ ⟨y, hy⟩)
      simp only [G₀, Function.comp_apply]
      rw [hfix]
      have : Hvec (c.coords ⟨y, hy⟩) = c'.toChart L y := by
        simp only [Hvec, EtaleCoordinateChart.toChart_apply]
        congr 1
        funext i
        rw [← hyH i (c'.subset hyW) hy]
        exact (c'.toOpenPartialHomeomorph_apply hyW i).symm
      rw [this, OpenPartialHomeomorph.left_inv]
      rwa [c'.source_toChart]

/-- The value map is injective on stalks. -/
private theorem injective_stalk_evHom (x : ComplexPoints sX) :
    Function.Injective ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      (evHom (sX := sX) (n := n)).hom) := by
  refine (injective_iff_map_eq_zero
    ((TopCat.Presheaf.stalkFunctor CommRingCat x).map (evHom (sX := sX) (n := n)).hom).hom).2
    fun γ hγ => ?_
  obtain ⟨W, hxW, s, rfl⟩ := TopCat.Presheaf.germ_exist _ γ
  rw [TopCat.Presheaf.stalkFunctor_map_germ_apply] at hγ
  obtain ⟨V, hxV, iV, iW', hV⟩ := TopCat.Presheaf.germ_eq (𝒪[n, ComplexPoints sX]).obj x hxW hxW
    ((evHom (sX := sX) (n := n)).hom.app (op W) s) 0 (by rwa [map_zero])
  have hzero : ∀ (y : ComplexPoints sX) (hyV : y ∈ V), sectionValue s ⟨y, iV.le hyV⟩ = 0 := by
    intro y hyV
    have h1 := congrArg (fun f : C^∞⟮𝓘(ℂ, EuclideanSpace ℂ (Fin n)), V; 𝓘(ℂ), ℂ⟯ =>
      f ⟨y, hyV⟩) hV
    simp only [map_zero] at h1
    exact h1
  obtain ⟨c, hx, hS1, -⟩ := exists_goodChart (n := n) x
  obtain ⟨h, gx, hgx, hsx, hhd, hev⟩ := exists_eventually_sectionValue s ⟨x, hxW⟩ c hx
  have hvan : ∀ᶠ y in 𝓝 x, ∀ hy : y ∈ chart c.U, h (c.coords ⟨y, hy⟩) = 0 := by
    filter_upwards [hev, V.isOpen.mem_nhds hxV] with y hy hyV hyc
    rw [← hy (iV.le hyV) hyc]
    exact hzero y hyV
  obtain ⟨g, hg, hgh⟩ := hS1 h hhd hvan
  have hgg : g = gx := Subtype.ext (hgh.trans hgx.symm)
  have h0 : s.1 ⟨x, hxW⟩ ⟨c, hx⟩ = 0 := by
    rw [hsx, ← hgg]
    exact Chart.StalkRing.mk_eq_zero_of_mem c hg
  obtain ⟨W', hxW', hW', hW'0⟩ := Chart.exists_eq_zero_of_apply_eq_zero s c ⟨x, hxW⟩ hx h0
  have hres : (structureSheaf sX).obj.map (homOfLE hW').op s = 0 :=
    Subtype.ext (funext fun z => funext fun d => hW'0 z d)
  rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE hW') x hxW', hres, map_zero]
  rfl

/-- The value map is surjective on stalks. -/
private theorem surjective_stalk_evHom (x : ComplexPoints sX) :
    Function.Surjective ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      (evHom (sX := sX) (n := n)).hom) := by
  classical
  intro γ'
  obtain ⟨V, hxV, F, rfl⟩ := TopCat.Presheaf.germ_exist _ γ'
  let F' : ComplexPoints sX → ℂ := fun y => if h : y ∈ V then F ⟨y, h⟩ else 0
  have hF'V : ∀ (y : ComplexPoints sX) (hy : y ∈ V), F' y = F ⟨y, hy⟩ := fun y hy => dif_pos hy
  have hF' : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ F' x := by
    have hF : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (fun y : V => F' y) ⟨x, hxV⟩ := by
      have : (fun y : V => F' y) = F := funext fun y => hF'V y.1 y.2
      rw [this]
      exact F.2 ⟨x, hxV⟩
    exact (contMDiffAt_subtype_iff (x := (⟨x, hxV⟩ : V))).1 hF
  obtain ⟨c, hx, -, hS2⟩ := exists_goodChart (n := n) x
  obtain ⟨h, hhd, hhF⟩ := hS2 F' hF'
  let t : c.StalkRing (c.coords ⟨x, hx⟩) := Chart.StalkRing.mk c _ ⟨_, coe_mem_holGerms hhd⟩
  obtain ⟨γ, hγ⟩ := c.surjective_stalkToStalkRing x hx t
  obtain ⟨W, hxW, s, rfl⟩ := TopCat.Presheaf.germ_exist _ γ
  replace hγ := (Chart.stalkToStalkRing_germ c x hx W hxW s).symm.trans hγ
  obtain ⟨h', g', hg', hsx, -, hev⟩ := exists_eventually_sectionValue s ⟨x, hxW⟩ c hx
  have hdiff : g' - ⟨_, coe_mem_holGerms hhd⟩ ∈ c.ideal.map (polyGermHom (c.coords ⟨x, hx⟩)) :=
    Ideal.Quotient.eq.1 (hsx.symm.trans hγ)
  have hcoe : ((g' - ⟨_, coe_mem_holGerms hhd⟩ : holGerms _) : Germ (𝓝 _) ℂ) =
      ((h' - h : (Fin c.n → ℂ) → ℂ) : Germ (𝓝 (c.coords ⟨x, hx⟩)) ℂ) := by
    rw [AddSubgroupClass.coe_sub, hg']
    rfl
  have hloc := eventually_exists_mem_map_polyGermHom c.ideal hdiff hcoe
  have hcont : Tendsto (chartCoords c) (𝓝 x) (𝓝 (c.coords ⟨x, hx⟩)) := by
    rw [← chartCoords_eq c hx]
    exact (contMDiffAt_chartCoords (n := n) c hx).continuousAt
  have hc : ∀ᶠ y in 𝓝 x, y ∈ chart c.U := (isOpen_chart sX c.U).mem_nhds hx
  have hagree : ∀ᶠ y in 𝓝 x, ∀ (hyW : y ∈ W) (hyV : y ∈ V),
      sectionValue s ⟨y, hyW⟩ = F ⟨y, hyV⟩ := by
    filter_upwards [hev, hhF, hc, hcont.eventually hloc] with y h1 h2 h3 h4 hyW hyV
    rw [h1 hyW h3, ← hF'V y hyV, ← h2 h3]
    obtain ⟨g'', hg''I, hg''⟩ := h4
    have h0 := germValue_eq_zero_of_mem c (fun r hr => by
      rw [chartCoords_eq c h3, ← c.evalHom_pres, (RingHom.mem_ker).1 hr, map_zero]) hg''I
    rw [germValue_eq g'' hg'', chartCoords_eq c h3] at h0
    exact sub_eq_zero.1 h0
  obtain ⟨T, hT, hTo, hxT⟩ := eventually_nhds_iff.1 hagree
  refine ⟨(structureSheaf sX).presheaf.germ W x hxW s, ?_⟩
  rw [TopCat.Presheaf.stalkFunctor_map_germ_apply]
  refine TopCat.Presheaf.germ_ext _ (W ⊓ V ⊓ ⟨T, hTo⟩) ⟨⟨hxW, hxV⟩, hxT⟩
    (homOfLE fun y hy => hy.1.1) (homOfLE fun y hy => hy.1.2) ?_
  exact ContMDiffMap.ext fun y => hT y.1 y.2.2 y.2.1.1 y.2.1.2

/-- **`𝒪_{X^an}` is the sheaf of holomorphic functions**, through the value map. -/
private theorem exists_theta :
    ∃ Θ : structureSheaf sX ≅ 𝒪[n, ComplexPoints sX],
      (∀ (V : X.Opens) (g : Γ(X, V)) (y : (Opens.map (toSchemeHom sX)).obj V),
        Θ.hom.hom.app (op _) ((analytificationHom sX).hom.c.app (op V) g) y =
          evalHom V ⟨y.1, mem_chart_iff.2 y.2⟩ g) ∧
      ∀ (W : Opens (space sX)) (a : sections sX W) (y : W),
        Θ.hom.hom.app (op W) a y = sectionValue a y := by
  haveI : ∀ x : space sX, IsIso ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      (evHom (sX := sX) (n := n)).hom) := fun x =>
    (ConcreteCategory.isIso_iff_bijective _).2 ⟨injective_stalk_evHom x, surjective_stalk_evHom x⟩
  haveI : IsIso (evHom (sX := sX) (n := n)) := TopCat.Presheaf.isIso_of_stalkFunctor_map_iso _
  exact ⟨asIso evHom, fun V g y => sectionValue_sharpHom V g y, fun _ _ _ => rfl⟩

end StalkIso

section Wedge

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- The wedge product `ℓ₁ ∧ ⋯ ∧ ℓ_p` of continuous linear forms, the alternatization of their
product. -/
private noncomputable abbrev wedge {p : ℕ} (ℓ : Fin p → E →L[ℂ] ℂ) : E [⋀^Fin p]→L[ℂ] ℂ :=
  ContinuousMultilinearMap.alternatization
    ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap ℓ)

/-- The value of a wedge product is a determinant. -/
private lemma wedge_apply {p : ℕ} (ℓ : Fin p → E →L[ℂ] ℂ) (v : Fin p → E) :
    wedge ℓ v = (Matrix.of fun i j => ℓ j (v i)).det := by
  rw [ContinuousMultilinearMap.alternatization_apply_apply, Matrix.det_apply]
  refine Finset.sum_congr rfl fun σ _ => ?_
  simp [ContinuousMultilinearMap.compContinuousLinearMap_apply,
    ContinuousMultilinearMap.mkPiAlgebra_apply]

private lemma wedge_smul {p : ℕ} (s : Fin p → ℂ) (ℓ : Fin p → E →L[ℂ] ℂ) :
    wedge (fun a => s a • ℓ a) = (∏ a, s a) • wedge ℓ := by
  ext v
  rw [ContinuousAlternatingMap.smul_apply, wedge_apply, wedge_apply, smul_eq_mul,
    ← Matrix.det_mul_row]
  congr 1

/-- **Laplace expansion** of a wedge product along its first factor. -/
private lemma alternatizeUncurryFin_smulRight_wedge {p : ℕ} (L : E →L[ℂ] ℂ)
    (ℓ : Fin p → E →L[ℂ] ℂ) :
    ContinuousAlternatingMap.alternatizeUncurryFin (L.smulRight (wedge ℓ)) =
      wedge (Fin.cons L ℓ) := by
  ext v
  rw [ContinuousAlternatingMap.alternatizeUncurryFin_apply, wedge_apply, ← Matrix.det_transpose,
    Matrix.det_succ_row_zero]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [ContinuousLinearMap.smulRight_apply, ContinuousAlternatingMap.smul_apply, wedge_apply,
    ← Matrix.det_transpose (Matrix.submatrix _ _ _)]
  simp only [Matrix.transpose_apply, Matrix.of_apply, Fin.cons_zero, Matrix.submatrix_apply,
    Fin.cons_succ, Fin.removeNth, smul_eq_mul]
  simp only [zsmul_eq_mul, Int.cast_pow, Int.cast_neg, Int.cast_one]
  ring_nf
  rfl

variable {n : ℕ}

/-- The enumeration of a `p`-element subset of `Fin n` in increasing order. -/
private noncomputable abbrev enum {p : ℕ} (I : Set.powersetCard (Fin n) p) : Fin p ↪o Fin n :=
  Set.powersetCard.ofFinEmbEquiv.symm I

/-- The constant form `dv_I = dv_{i₁} ∧ ⋯ ∧ dv_{i_p}` on `ℂⁿ`. -/
private noncomputable abbrev formA {p : ℕ} (I : Set.powersetCard (Fin n) p) :
    EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ :=
  wedge (fun a => EuclideanSpace.proj (enum I a))

/-- The basis tuple `(e_{i₁}, …, e_{i_p})` of a subset. -/
private noncomputable abbrev basisVec {p : ℕ} (I : Set.powersetCard (Fin n) p) :
    Fin p → EuclideanSpace ℂ (Fin n) :=
  fun b => EuclideanSpace.single (enum I b) 1

private lemma mem_iff_exists_enum {p : ℕ} (I : Set.powersetCard (Fin n) p) (x : Fin n) :
    x ∈ (I : Finset (Fin n)) ↔ ∃ a, enum I a = x := by
  have := Finset.range_orderEmbOfFin (I : Finset (Fin n)) I.2
  rw [enum, Set.powersetCard.ofFinEmbEquiv_symm_apply, ← Finset.mem_coe, ← this]
  simp

/-- The forms `dv_I` are dual to the basis tuples. -/
private lemma formA_basisVec {p : ℕ} (I J : Set.powersetCard (Fin n) p) :
    formA I (basisVec J) = if I = J then 1 else 0 := by
  classical
  rw [wedge_apply]
  have hentry : ∀ i j, EuclideanSpace.proj (enum I j)
      (EuclideanSpace.single (enum J i) (1 : ℂ)) = if enum I j = enum J i then 1 else 0 :=
    fun i j => by simp [PiLp.single_apply]
  simp only [hentry]
  split_ifs with hIJ
  · subst hIJ
    have : (Matrix.of fun i j => if enum I j = enum I i then (1 : ℂ) else 0) = 1 := by
      ext i j
      simp only [Matrix.of_apply, Matrix.one_apply, (enum I).injective.eq_iff, eq_comm]
    rw [this, Matrix.det_one]
  · have hne : (I : Finset (Fin n)) ≠ J := fun h => hIJ (Subtype.ext h)
    obtain ⟨x, hxJ, hxI⟩ : ∃ x ∈ (J : Finset (Fin n)), x ∉ (I : Finset (Fin n)) := by
      by_contra h
      push Not at h
      exact hne (Finset.eq_of_subset_of_card_le h (by rw [I.2, J.2])).symm
    obtain ⟨i, rfl⟩ := (mem_iff_exists_enum J x).1 hxJ
    refine Matrix.det_eq_zero_of_row_eq_zero i fun j => ?_
    simp only [Matrix.of_apply]
    rw [if_neg]
    intro h
    exact hxI ((mem_iff_exists_enum I _).2 ⟨j, h⟩)

/-- An injective tuple in `Fin n` is a reordering of the increasing enumeration of its image. -/
private lemma exists_perm_eq_enum {p : ℕ} (v : Fin p → Fin n) (hv : Function.Injective v) :
    ∃ (I : Set.powersetCard (Fin n) p) (τ : Equiv.Perm (Fin p)), v = enum I ∘ τ := by
  classical
  let s : Finset (Fin n) := Finset.univ.image v
  have hs : s.card = p := by rw [Finset.card_image_of_injective _ hv]; simp
  let I : Set.powersetCard (Fin n) p := ⟨s, hs⟩
  have hmem : ∀ a, v a ∈ (I : Finset (Fin n)) := fun a =>
    Finset.mem_image_of_mem v (Finset.mem_univ a)
  have hex : ∀ a, ∃ b, enum I b = v a := fun a => (mem_iff_exists_enum I (v a)).1 (hmem a)
  choose τf hτf using hex
  have hτinj : Function.Injective τf := fun a b h => hv (by rw [← hτf a, ← hτf b, h])
  exact ⟨I, Equiv.ofBijective τf hτinj.bijective_of_finite, funext fun a => (hτf a).symm⟩

/-- Alternating forms on `ℂⁿ` agreeing on the basis tuples are equal. -/
private lemma ext_of_basisVec {p : ℕ} {α β : EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ}
    (h : ∀ I, α (basisVec I) = β (basisVec I)) : α = β := by
  classical
  apply ContinuousAlternatingMap.toAlternatingMap_injective
  refine Module.Basis.ext_alternating (EuclideanSpace.basisFun (Fin n) ℂ).toBasis fun v hv => ?_
  obtain ⟨I, τ, rfl⟩ := exists_perm_eq_enum v hv
  have : (fun i => (EuclideanSpace.basisFun (Fin n) ℂ).toBasis ((enum I ∘ τ) i)) =
      basisVec I ∘ τ := by
    funext i
    simp [basisVec]
  rw [this, AlternatingMap.map_perm, AlternatingMap.map_perm]
  congr 1
  exact h I

/-- Every alternating form on `ℂⁿ` is a combination of the forms `dv_I`. -/
private lemma eq_sum_formA {p : ℕ} (α : EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) :
    α = ∑ I, α (basisVec I) • formA I := by
  classical
  refine ext_of_basisVec fun J => ?_
  simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
    formA_basisVec, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]

/-- The forms `dv_I` are linearly independent. -/
private lemma eq_zero_of_sum_formA_eq_zero {p : ℕ} (c : Set.powersetCard (Fin n) p → ℂ)
    (h : ∑ I, c I • formA I = 0) (J : Set.powersetCard (Fin n) p) : c J = 0 := by
  classical
  have := congrArg (fun α => α (basisVec J)) h
  simpa [ContinuousAlternatingMap.sum_apply, formA_basisVec, Finset.sum_ite_eq'] using this

end Wedge

section FormsStalk

open KaehlerDifferential

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

/-- The algebraic forms `dz_I = dz_{i₁} ∧ ⋯ ∧ dz_{i_p}` on an affine open. -/
private noncomputable def dzForm {W : X.Opens} (hW : IsAffineOpen W) {n : ℕ}
    (z : Fin n → Γ(X, W)) (p : ℕ) (I : Set.powersetCard (Fin n) p) :
    Γ(sX.relativeDifferentialForms (p : ℤ), W) :=
  letI := Mori.sectionAlgebra sX W
  (DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm
    (exteriorPower.ιMulti_family Γ(X, W) p (fun i => D ℂ Γ(X, W) (z i)) I)

/-- The restriction of `dz_I` to a smaller affine open is `dz_I`. -/
private lemma formsAlgEquiv_res_dzForm {W V : X.Opens} (hW : IsAffineOpen W)
    (hV : IsAffineOpen V) (h : V ≤ W) {n : ℕ} (z : Fin n → Γ(X, W)) (p : ℕ)
    (I : Set.powersetCard (Fin n) p) :
    letI := Mori.sectionAlgebra sX V
    DeRham.formsAlgEquiv sX p ⟨V, hV⟩
        ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE h).op
          (dzForm sX hW z p I)) =
      exteriorPower.ιMulti_family Γ(X, V) p
        (fun i => D ℂ Γ(X, V) ((X.presheaf.map (homOfLE h).op).hom (z i))) I := by
  letI := Mori.sectionAlgebra sX W
  letI := Mori.sectionAlgebra sX V
  letI : Algebra Γ(X, W) Γ(X, V) := (X.presheaf.map (homOfLE h).op).hom.toAlgebra
  haveI := MMP.Flips.ResolutionInputs.isScalarTower_section_res sX h
  have := DeRham.formsAlgEquiv_restrict sX p (W := ⟨W, hW⟩) (W' := ⟨V, hV⟩) h (dzForm sX hW z p I)
  rw [this, dzForm, LinearEquiv.apply_symm_apply, exteriorPower.ιMulti_family,
    exteriorPower.ιMulti_family, mapExteriorPower_ιMulti]
  congr 1
  funext a
  simp only [Function.comp_apply, map_D]
  rfl

/-- On every affine open inside `W`, the `dz_I` are a basis of the algebraic `p`-forms. -/
private lemma exists_basis_forms_res {W V : X.Opens} (hW : IsAffineOpen W) (hV : IsAffineOpen V)
    (h : V ≤ W) {n : ℕ} (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ], ∀ i, b i = D ℂ Γ(X, W) (z i))
    (p : ℕ) :
    letI := Mori.sectionAlgebra sX V
    ∃ B : Module.Basis (Set.powersetCard (Fin n) p) Γ(X, V) (⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ]),
      ∀ I, B I = exteriorPower.ιMulti_family Γ(X, V) p
        (fun i => D ℂ Γ(X, V) ((X.presheaf.map (homOfLE h).op).hom (z i))) I := by
  letI := Mori.sectionAlgebra sX V
  obtain ⟨b, hb⟩ := hb
  obtain ⟨b', hb'⟩ := MMP.Flips.ResolutionInputs.exists_basis_res sX hW hV h z b hb
  refine ⟨b'.exteriorPower p, fun I => ?_⟩
  rw [exteriorPower.basis_apply]
  congr 1
  funext i
  exact hb' i

set_option maxRecDepth 4000 in
/-- **The germs of the `dz_I` are a basis of the stalks of `Ω^p`.** -/
private theorem exists_stalk_basis_dzForm {W : X.Opens} (hW : IsAffineOpen W) {n : ℕ}
    (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ], ∀ i, b i = D ℂ Γ(X, W) (z i))
    (p : ℕ) (w : X) (hw : w ∈ W) :
    let F' : PresheafOfModules (X.presheaf ⋙ forget₂ CommRingCat RingCat) :=
      (sX.relativeDifferentialForms (p : ℤ)).val
    letI : Module (X.presheaf.stalk w)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf w) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' w
    ∃ β : Module.Basis (Set.powersetCard (Fin n) p) (X.presheaf.stalk w)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf w),
      ∀ I, β I = TopCat.Presheaf.germ F'.presheaf W w hw (dzForm sX hW z p I) := by
  intro F'
  letI : Module (X.presheaf.stalk w)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf w) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' w
  classical
  -- restriction of the `dz_I` to an affine neighbourhood inside `W`, and the basis there
  have hrestr : ∀ (V : X.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W),
      letI := Mori.sectionAlgebra sX V
      ∃ B : Module.Basis (Set.powersetCard (Fin n) p) Γ(X, V) (⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ]),
        ∀ I, B I = DeRham.formsAlgEquiv sX p ⟨V, hV⟩
          ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
            (dzForm sX hW z p I)) := fun V hV hVW => by
    obtain ⟨B, hB⟩ := exists_basis_forms_res sX hW hV hVW z hb p
    exact ⟨B, fun I => (hB I).trans (formsAlgEquiv_res_dzForm sX hW hV hVW z p I).symm⟩
  -- every form on such an open is a combination of the `dz_I`, uniquely
  have hspan : ∀ (V : X.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W)
      (t : Γ(sX.relativeDifferentialForms (p : ℤ), V)), ∃ c : Set.powersetCard (Fin n) p → Γ(X, V),
        t = ∑ I, c I • (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
          (dzForm sX hW z p I) := fun V hV hVW t => by
    letI := Mori.sectionAlgebra sX V
    obtain ⟨B, hB⟩ := hrestr V hV hVW
    refine ⟨fun I => B.repr (DeRham.formsAlgEquiv sX p ⟨V, hV⟩ t) I,
      (DeRham.formsAlgEquiv sX p ⟨V, hV⟩).injective ?_⟩
    rw [map_sum]
    simp only [map_smul, ← hB]
    exact (B.sum_repr _).symm
  have hindep : ∀ (V : X.Opens) (hV : IsAffineOpen V) (hVW : V ≤ W)
      (c : Set.powersetCard (Fin n) p → Γ(X, V)),
      ∑ I, c I • (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
          (dzForm sX hW z p I) = 0 → ∀ I, c I = 0 := fun V hV hVW c hc => by
    letI := Mori.sectionAlgebra sX V
    obtain ⟨B, hB⟩ := hrestr V hV hVW
    have h1 : DeRham.formsAlgEquiv sX p ⟨V, hV⟩ (∑ I, c I •
        (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
          (dzForm sX hW z p I)) = ∑ I, c I • B I := by
      rw [map_sum]
      simp only [map_smul, ← hB]
    have h2 := congrArg (DeRham.formsAlgEquiv sX p ⟨V, hV⟩) hc
    have h0 : DeRham.formsAlgEquiv sX p ⟨V, hV⟩ 0 = 0 := LinearEquiv.map_zero _
    exact Fintype.linearIndependent_iff.1 B.linearIndependent c (h1.symm.trans (h2.trans h0))
  -- germs of restrictions
  have hgermres : ∀ (V : X.Opens) (hwV : w ∈ V) (hVW : V ≤ W) I,
      TopCat.Presheaf.germ F'.presheaf V w hwV
          ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
            (dzForm sX hW z p I)) =
        TopCat.Presheaf.germ F'.presheaf W w hw (dzForm sX hW z p I) := fun V hwV hVW I =>
    TopCat.Presheaf.germ_res_apply F'.presheaf (homOfLE hVW) w hwV _
  let v : Set.powersetCard (Fin n) p → ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0})
      (X := X.toTopCat) F'.presheaf w) :=
    fun I => TopCat.Presheaf.germ F'.presheaf W w hw (dzForm sX hW z p I)
  have hgermsum : ∀ (V : X.Opens) (hwV : w ∈ V) (hVW : V ≤ W)
      (c : Set.powersetCard (Fin n) p → Γ(X, V)),
      TopCat.Presheaf.germ F'.presheaf V w hwV (∑ J, c J •
          (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
            (dzForm sX hW z p J)) = ∑ J, X.presheaf.germ V w hwV (c J) • v J := by
    intro V hwV hVW c
    erw [map_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    erw [PresheafOfModules.germ_smul]
    rw [hgermres]
  have hressum : ∀ (V V' : X.Opens) (hV'V : V' ≤ V) (hVW : V ≤ W)
      (c : Set.powersetCard (Fin n) p → Γ(X, V)),
      F'.presheaf.map (homOfLE hV'V).op (∑ J, c J •
          (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
            (dzForm sX hW z p J)) =
        ∑ J, (X.presheaf.map (homOfLE hV'V).op).hom (c J) •
          (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE (hV'V.trans hVW)).op
            (dzForm sX hW z p J) := by
    intro V V' hV'V hVW c
    erw [map_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    erw [PresheafOfModules.presheaf_map_apply_coe F' (homOfLE hV'V).op, PresheafOfModules.map_smul,
      ← PresheafOfModules.presheaf_map_apply_coe F' (homOfLE hV'V).op]
    congr 1
    change (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hV'V).op
      ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
        (dzForm sX hW z p J)) = _
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hli : LinearIndependent (X.presheaf.stalk w) v := by
    refine Fintype.linearIndependent_iff.2 fun g hg I => ?_
    have hex := fun J => TopCat.Presheaf.germ_exist X.presheaf (g J)
    choose Vg hwVg r hr using hex
    have hev : ∀ᶠ q in 𝓝 w, q ∈ W ∧ ∀ J, q ∈ Vg J := by
      have h1 : ∀ᶠ q in 𝓝 w, q ∈ W := W.isOpen.mem_nhds hw
      have h2 : ∀ᶠ q in 𝓝 w, ∀ J, q ∈ Vg J :=
        Filter.eventually_all.2 fun J => (Vg J).isOpen.mem_nhds (hwVg J)
      exact h1.and h2
    obtain ⟨O, hOsub, hOo, hwO⟩ := mem_nhds_iff.1 hev
    obtain ⟨V, hV, hwV, hVO⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := ⟨O, hOo⟩) hwO
    have hVW : V ≤ W := fun q hq => (hOsub (hVO hq)).1
    have hVg : ∀ J, V ≤ Vg J := fun J q hq => (hOsub (hVO hq)).2 J
    let r' : Set.powersetCard (Fin n) p → Γ(X, V) := fun J =>
      (X.presheaf.map (homOfLE (hVg J)).op).hom (r J)
    have hr' : ∀ J, X.presheaf.germ V w hwV (r' J) = g J := fun J => by
      rw [← hr J]
      exact X.presheaf.germ_res_apply (homOfLE (hVg J)) w hwV (r J)
    have hsum0 : TopCat.Presheaf.germ F'.presheaf V w hwV (∑ J, r' J •
        (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
          (dzForm sX hW z p J)) = 0 := by
      rw [hgermsum]
      simp only [hr']
      exact hg
    obtain ⟨V₁, hwV₁, i₁, i₂, h₁⟩ := TopCat.Presheaf.germ_eq F'.presheaf w hwV hwV _ 0
      (hsum0.trans (map_zero _).symm)
    obtain ⟨V₂, hV₂, hwV₂, hV₂V₁'⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := V₁) hwV₁
    have hV₂V₁ : V₂ ≤ V₁ := hV₂V₁'
    have hV₂V : V₂ ≤ V := hV₂V₁.trans i₁.le
    have hzero := hindep V₂ hV₂ (hV₂V.trans hVW)
      (fun J => (X.presheaf.map (homOfLE hV₂V).op).hom (r' J)) (by
        rw [← hressum V V₂ hV₂V hVW]
        have h₃ := congrArg (F'.presheaf.map (homOfLE hV₂V₁).op) h₁
        rw [map_zero, map_zero, ← ConcreteCategory.comp_apply, ← Functor.map_comp] at h₃
        exact h₃)
    rw [← hr' I, ← X.presheaf.germ_res_apply (homOfLE hV₂V) w hwV₂ (r' I), hzero I, map_zero]
  have hsp : ⊤ ≤ Submodule.span (X.presheaf.stalk w) (Set.range v) := by
    rintro γ -
    obtain ⟨V₀, hwV₀, t, rfl⟩ := TopCat.Presheaf.germ_exist F'.presheaf γ
    obtain ⟨V, hV, hwV, hVle⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := V₀ ⊓ W)
      ⟨hwV₀, hw⟩
    have hVW : V ≤ W := hVle.trans inf_le_right
    have hVV₀ : V ≤ V₀ := hVle.trans inf_le_left
    obtain ⟨c, hc⟩ := hspan V hV hVW (F'.presheaf.map (homOfLE hVV₀).op t)
    rw [← TopCat.Presheaf.germ_res_apply F'.presheaf (homOfLE hVV₀) w hwV t]
    erw [hc, hgermsum]
    refine Submodule.sum_mem _ fun I _ => ?_
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨I, rfl⟩)
  exact ⟨Module.Basis.mk hli hsp, fun I => Module.Basis.mk_apply _ _ _⟩

/-- **The analytic stalks of `(Ω^p)^an` are free on the `dz_I ⊗ 1`**, with coordinates of
`t ⊗ 1` the images of the coordinates of the germ of `t`. -/
private theorem exists_an_stalk_basis [LocallyOfFiniteType sX] [QuasiCompact sX] {W : X.Opens}
    (hW : IsAffineOpen W) {n : ℕ} (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ], ∀ i, b i = D ℂ Γ(X, W) (z i))
    (p : ℕ) (y : ComplexPoints sX) (hy : y ∈ chart (sX := sX) W) :
    let F := sX.relativeDifferentialForms (p : ℤ)
    let MF : PresheafOfModules ((structureSheaf sX).obj ⋙ forget₂ CommRingCat RingCat) :=
      ((analytifyModule sX).obj F).val
    let F' : PresheafOfModules (X.presheaf ⋙ forget₂ CommRingCat RingCat) := F.val
    letI : Module ((analytification sX).presheaf.stalk y)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier MF y
    letI : Module (X.presheaf.stalk y.toScheme)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
          y.toScheme) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' _
    ∃ βan : Module.Basis (Set.powersetCard (Fin n) p) ((analytification sX).presheaf.stalk y)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y),
      (∀ I, βan I = TopCat.Presheaf.germ MF.presheaf ((Opens.map (toSchemeHom sX)).obj W) y
        (mem_chart_iff.1 hy) ((analytifyModuleUnit sX F).val.app (op W) (dzForm sX hW z p I))) ∧
      ∀ (V : X.Opens) (hyV : y.toScheme ∈ V) (t : F.val.obj (op V))
        (c : Set.powersetCard (Fin n) p → X.presheaf.stalk y.toScheme),
        TopCat.Presheaf.germ F'.presheaf V y.toScheme hyV t =
          ∑ I, c I • TopCat.Presheaf.germ F'.presheaf W y.toScheme (mem_chart_iff.1 hy)
            (dzForm sX hW z p I) →
        ∀ I, βan.repr (TopCat.Presheaf.germ MF.presheaf ((Opens.map (toSchemeHom sX)).obj V) y
          hyV ((analytifyModuleUnit sX F).val.app (op V) t)) I =
            ((analytificationHom sX).hom.stalkMap y).hom (c I) := by
  intro F MF F'
  letI : Module ((analytification sX).presheaf.stalk y)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX) MF.presheaf y) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier MF y
  letI : Module (X.presheaf.stalk y.toScheme)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf
        y.toScheme) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' _
  obtain ⟨β, hβ⟩ := exists_stalk_basis_dzForm sX hW z hb p y.toScheme (mem_chart_iff.1 hy)
  obtain ⟨e, he⟩ := (analytification_stalks sX).2.2.1 F y
  letI : Algebra (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y) :=
    ((analytificationHom sX).hom.stalkMap y).hom.toAlgebra
  let tb := Algebra.TensorProduct.basis ((analytification sX).presheaf.stalk y) β
  refine ⟨tb.map e.symm, fun I => ?_, fun V hyV t c ht I => ?_⟩
  · rw [Module.Basis.map_apply, Algebra.TensorProduct.basis_apply, hβ, LinearEquiv.symm_apply_eq]
    exact (he W (mem_chart_iff.1 hy) _).symm
  · rw [Module.Basis.map_repr, LinearEquiv.trans_apply, LinearEquiv.symm_symm, he V hyV t,
      Algebra.TensorProduct.basis_repr_tmul, one_smul, Finsupp.mapRange_apply]
    have : β.repr (TopCat.Presheaf.germ F'.presheaf V y.toScheme hyV t) = c := by
      rw [ht]
      have h2 : ∑ I, c I • TopCat.Presheaf.germ F'.presheaf W y.toScheme (mem_chart_iff.1 hy)
          (dzForm sX hW z p I) = ∑ I, c I • β I := Finset.sum_congr rfl fun I _ => by rw [hβ]
      rw [h2]
      exact β.repr_sum_self c
    rw [this]
    rfl

/-- The germ of an algebraic `p`-form on an affine open `V ⊆ W` is the combination of the germs of
the `dz_I` with the germs of its coordinates in the basis `dz_I` of `⋀^p Ω[Γ(X, V)⁄ℂ]`. -/
private lemma germ_eq_sum_repr {W V : X.Opens} (hW : IsAffineOpen W) (hV : IsAffineOpen V)
    (hVW : V ≤ W) {n : ℕ} (z : Fin n → Γ(X, W)) (p : ℕ)
    (b : letI := Mori.sectionAlgebra sX V; Module.Basis (Fin n) Γ(X, V) Ω[Γ(X, V)⁄ℂ])
    (hb : letI := Mori.sectionAlgebra sX V;
      ∀ i, b i = D ℂ Γ(X, V) ((X.presheaf.map (homOfLE hVW).op).hom (z i)))
    (t : Γ(sX.relativeDifferentialForms (p : ℤ), V)) (w : X) (hw : w ∈ V) :
    let F' : PresheafOfModules (X.presheaf ⋙ forget₂ CommRingCat RingCat) :=
      (sX.relativeDifferentialForms (p : ℤ)).val
    letI : Module (X.presheaf.stalk w)
        ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf w) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' w
    letI := Mori.sectionAlgebra sX V
    TopCat.Presheaf.germ F'.presheaf V w hw t =
      ∑ I, X.presheaf.germ V w hw
          ((b.exteriorPower p).repr (DeRham.formsAlgEquiv sX p ⟨V, hV⟩ t) I) •
        TopCat.Presheaf.germ F'.presheaf W w (hVW hw) (dzForm sX hW z p I) := by
  intro F'
  letI : Module (X.presheaf.stalk w)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat) F'.presheaf w) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier F' w
  letI := Mori.sectionAlgebra sX V
  set C := (b.exteriorPower p).repr (DeRham.formsAlgEquiv sX p ⟨V, hV⟩ t)
  have hbI : ∀ I, b.exteriorPower p I = exteriorPower.ιMulti_family Γ(X, V) p
      (fun i => D ℂ Γ(X, V) ((X.presheaf.map (homOfLE hVW).op).hom (z i))) I := fun I => by
    rw [exteriorPower.basis_apply]
    congr 1
    funext i
    exact hb i
  have ht : t = ∑ I, C I • (sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hVW).op
      (dzForm sX hW z p I) := by
    apply (DeRham.formsAlgEquiv sX p ⟨V, hV⟩).injective
    rw [map_sum]
    simp only [map_smul]
    simp only [formsAlgEquiv_res_dzForm sX hW hV hVW z p, ← hbI]
    exact (Module.Basis.sum_repr _ _).symm
  conv_lhs => rw [ht]
  erw [map_sum]
  refine Finset.sum_congr rfl fun J _ => ?_
  erw [PresheafOfModules.germ_smul]
  congr 1
  exact TopCat.Presheaf.germ_res_apply F'.presheaf (homOfLE hVW) w hw _

/-- The restriction of `a db₁ ∧ ⋯ ∧ db_p` to a smaller affine open is `a db₁ ∧ ⋯ ∧ db_p`. -/
private lemma formsAlgEquiv_res_smul_ιMulti {V V' : X.Opens} (hV : IsAffineOpen V)
    (hV' : IsAffineOpen V') (h : V' ≤ V) (p : ℕ) (a : Γ(X, V)) (b : Fin p → Γ(X, V)) :
    letI := Mori.sectionAlgebra sX V
    letI := Mori.sectionAlgebra sX V'
    DeRham.formsAlgEquiv sX p ⟨V', hV'⟩
        ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE h).op
          ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
            (a • exteriorPower.ιMulti Γ(X, V) p (fun m => D ℂ Γ(X, V) (b m))))) =
      (X.presheaf.map (homOfLE h).op).hom a • exteriorPower.ιMulti Γ(X, V') p
        (fun m => D ℂ Γ(X, V') ((X.presheaf.map (homOfLE h).op).hom (b m))) := by
  letI := Mori.sectionAlgebra sX V
  letI := Mori.sectionAlgebra sX V'
  letI : Algebra Γ(X, V) Γ(X, V') := (X.presheaf.map (homOfLE h).op).hom.toAlgebra
  haveI := MMP.Flips.ResolutionInputs.isScalarTower_section_res sX h
  have := DeRham.formsAlgEquiv_restrict sX p (W := ⟨V, hV⟩) (W' := ⟨V', hV'⟩) h
    ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
      (a • exteriorPower.ιMulti Γ(X, V) p (fun m => D ℂ Γ(X, V) (b m))))
  rw [this, LinearEquiv.apply_symm_apply, LinearMap.map_smul, mapExteriorPower_ιMulti,
    ← algebraMap_smul Γ(X, V')]
  congr 1
  congr 1
  funext m
  exact map_D _ _ _ _ _

set_option maxRecDepth 4000 in
/-- Restriction to a smaller affine open commutes with the de Rham differential. -/
private lemma formsAlgEquiv_res_deRham {V V' : X.Opens} (hV : IsAffineOpen V)
    (hV' : IsAffineOpen V') (h : V' ≤ V) (p : ℕ)
    (η : letI := Mori.sectionAlgebra sX V; ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ]) :
    letI := Mori.sectionAlgebra sX V
    letI := Mori.sectionAlgebra sX V'
    DeRham.formsAlgEquiv sX (p + 1) ⟨V', hV'⟩
        ((sX.relativeDifferentialForms ((p + 1 : ℕ) : ℤ)).presheaf.map (homOfLE h).op
          ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm (deRhamDifferential (A := ℂ) p η))) =
      deRhamDifferential (A := ℂ) p (DeRham.formsAlgEquiv sX p ⟨V', hV'⟩
        ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE h).op
          ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η))) := by
  letI := Mori.sectionAlgebra sX V
  letI := Mori.sectionAlgebra sX V'
  letI : Algebra Γ(X, V) Γ(X, V') := (X.presheaf.map (homOfLE h).op).hom.toAlgebra
  haveI := MMP.Flips.ResolutionInputs.isScalarTower_section_res sX h
  have h1 := DeRham.formsAlgEquiv_restrict sX (p + 1) (W := ⟨V, hV⟩) (W' := ⟨V', hV'⟩) h
    ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm (deRhamDifferential (A := ℂ) p η))
  have h2 := DeRham.formsAlgEquiv_restrict sX p (W := ⟨V, hV⟩) (W' := ⟨V', hV'⟩) h
    ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η)
  rw [LinearEquiv.apply_symm_apply] at h1 h2
  rw [h1]
  rw [h2]
  exact mapExteriorPower_deRhamDifferential _ _ _ _ _

end FormsStalk

section PointDerivation

open KaehlerDifferential

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n sX]

private lemma regVal_add (U : X.Opens) (f g : Γ(X, U)) :
    regVal (sX := sX) U (f + g) = regVal U f + regVal U g := by
  funext y
  by_cases h : y ∈ chart U
  · simp only [Pi.add_apply, regVal_of_mem _ h, ← evalHom_apply, map_add]
  · simp [regVal, dif_neg h]

private lemma regVal_mul (U : X.Opens) (f g : Γ(X, U)) :
    regVal (sX := sX) U (f * g) = regVal U f * regVal U g := by
  funext y
  by_cases h : y ∈ chart U
  · simp only [Pi.mul_apply, regVal_of_mem _ h, ← evalHom_apply, map_mul]
  · simp [regVal, dif_neg h]

private lemma evalHom_algebraMap (U : X.Opens) (y : chart (sX := sX) U) (c : ℂ) :
    evalHom U y (letI := Mori.sectionAlgebra sX U; algebraMap ℂ Γ(X, U) c) = c := by
  rw [← baseRingHom_eq_algebraMap, evalHom_baseRingHom]

private lemma regVal_smul (U : X.Opens) (c : ℂ) (f : Γ(X, U)) :
    regVal (sX := sX) U (letI := Mori.sectionAlgebra sX U; c • f) = c • regVal U f := by
  letI := Mori.sectionAlgebra sX U
  funext y
  by_cases h : y ∈ chart U
  · simp only [Pi.smul_apply, regVal_of_mem _ h, ← evalHom_apply, Algebra.smul_def, map_mul,
      evalHom_algebraMap, smul_eq_mul, Algebra.algebraMap_self, RingHom.id_apply]
  · simp [regVal, dif_neg h]

/-- Holomorphic functions on `X^an` read in a chart of the maximal atlas are holomorphic. -/
private lemma contDiffAt_comp_symm
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    {g : ComplexPoints sX → ℂ} {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ φ.target)
    (hg : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ g (φ.symm v)) :
    ContDiffAt ℂ ∞ (g ∘ φ.symm) v := by
  have h1 : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞
      φ.symm v :=
    (contMDiffOn_symm_of_mem_maximalAtlas hφmax).contMDiffAt (φ.open_target.mem_nhds hv)
  exact contMDiffAt_iff_contDiffAt.1 (hg.comp v h1)

private lemma differentiableAt_regVal_comp_symm
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    {V : X.Opens} (f : Γ(X, V)) {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ φ.target)
    (hvV : φ.symm v ∈ chart V) :
    DifferentiableAt ℂ (regVal V f ∘ φ.symm) v :=
  (contDiffAt_comp_symm hφmax hv (contMDiffAt_regVal V f hvV)).differentiableAt
    (by simp)

/-- **Algebraic and analytic partial derivatives agree.** If the differentials of `z` are a basis
`b` of `Ω[Γ(X, V)⁄ℂ]` and the `z_i` are the coordinates of a chart `φ` to first order at `y`, then
the `k`-th partial derivative at `φ y` of a regular function `f` read in `φ` is the value at `y` of
the `k`-th coordinate of `df` in `b`. -/
private theorem fderiv_regVal_comp_symm_single
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    {V : X.Opens} {y : ComplexPoints sX} (hy : y ∈ φ.source) (hyV : y ∈ chart V)
    (b : letI := Mori.sectionAlgebra sX V; Module.Basis (Fin n) Γ(X, V) Ω[Γ(X, V)⁄ℂ])
    (z : Fin n → Γ(X, V))
    (hbz : letI := Mori.sectionAlgebra sX V; ∀ i, b i = D ℂ Γ(X, V) (z i))
    (hz : ∀ i k, fderiv ℂ (regVal V (z i) ∘ φ.symm) (φ y) (EuclideanSpace.single k 1) =
      if i = k then 1 else 0)
    (f : Γ(X, V)) (k : Fin n) :
    letI := Mori.sectionAlgebra sX V
    fderiv ℂ (regVal V f ∘ φ.symm) (φ y) (EuclideanSpace.single k 1) =
      evalHom V ⟨y, hyV⟩ (b.repr (D ℂ Γ(X, V) f) k) := by
  letI := Mori.sectionAlgebra sX V
  classical
  let ev := evalHom V ⟨y, hyV⟩
  letI : Module Γ(X, V) ℂ := Module.compHom ℂ ev
  have hsmul : ∀ (a : Γ(X, V)) (x : ℂ), a • x = ev a * x := fun _ _ => rfl
  haveI : IsScalarTower ℂ Γ(X, V) ℂ := ⟨fun c a x => by
    rw [hsmul, hsmul, smul_eq_mul]
    simp only [ev, Algebra.smul_def, map_mul, evalHom_algebraMap, mul_assoc]⟩
  have hφy : φ y ∈ φ.target := φ.map_source hy
  have hd : ∀ g : Γ(X, V), DifferentiableAt ℂ (regVal V g ∘ φ.symm) (φ y) := fun g =>
    differentiableAt_regVal_comp_symm hφmax g hφy (by rwa [φ.left_inv hy])
  have hval : ∀ g : Γ(X, V), (regVal V g ∘ φ.symm) (φ y) = ev g := fun g => by
    rw [Function.comp_apply, φ.left_inv hy, regVal_of_mem g hyV]
    rfl
  let δ : Derivation ℂ Γ(X, V) ℂ := Derivation.mk'
    { toFun := fun g => fderiv ℂ (regVal V g ∘ φ.symm) (φ y) (EuclideanSpace.single k 1)
      map_add' := fun g h => by
        rw [regVal_add, Pi.add_comp, fderiv_add (hd g) (hd h)]
        rfl
      map_smul' := fun c g => by
        simp only [RingHom.id_apply]
        rw [regVal_smul]
        change fderiv ℂ (c • (regVal V g ∘ φ.symm)) (φ y) _ = _
        rw [fderiv_const_smul (hd g)]
        rfl }
    (fun g h => by
      simp only [LinearMap.coe_mk, AddHom.coe_mk]
      rw [regVal_mul, Pi.mul_comp, fderiv_mul (hd g) (hd h), hsmul, hsmul]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
        hval])
  have hδ : ∀ g, δ g = fderiv ℂ (regVal V g ∘ φ.symm) (φ y) (EuclideanSpace.single k 1) :=
    fun _ => rfl
  let lam := δ.liftKaehlerDifferential
  have hlam : ∀ g, lam (D ℂ Γ(X, V) g) = δ g := fun g =>
    Derivation.liftKaehlerDifferential_comp_D δ g
  have hb : ∀ i, lam (b i) = if i = k then 1 else 0 := fun i => by
    rw [hbz, hlam, hδ, hz]
  rw [← hδ, ← hlam]
  conv_lhs => rw [← b.sum_repr (D ℂ Γ(X, V) f)]
  rw [map_sum]
  simp only [map_smul, hb, hsmul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]
  rfl

/-- **The values of the coordinates of an algebraic wedge `db₁ ∧ ⋯ ∧ db_p`.** In the setting of
`fderiv_regVal_comp_symm_single`, the coordinates of `db₁ ∧ ⋯ ∧ db_p` in the basis `dz_I`, read at
`y`, are those of the wedge `d(b₁ ∘ φ⁻¹) ∧ ⋯ ∧ d(b_p ∘ φ⁻¹)` at `φ y` in the basis `dv_I`. -/
private theorem sum_evalHom_repr_ιMulti_smul_formA
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    {V : X.Opens} {y : ComplexPoints sX} (hy : y ∈ φ.source) (hyV : y ∈ chart V)
    (b : letI := Mori.sectionAlgebra sX V; Module.Basis (Fin n) Γ(X, V) Ω[Γ(X, V)⁄ℂ])
    (z : Fin n → Γ(X, V))
    (hbz : letI := Mori.sectionAlgebra sX V; ∀ i, b i = D ℂ Γ(X, V) (z i))
    (hz : ∀ i k, fderiv ℂ (regVal V (z i) ∘ φ.symm) (φ y) (EuclideanSpace.single k 1) =
      if i = k then 1 else 0)
    {p : ℕ} (v : Fin p → Γ(X, V)) :
    letI := Mori.sectionAlgebra sX V
    ∑ I, evalHom V ⟨y, hyV⟩ ((b.exteriorPower p).repr
        (exteriorPower.ιMulti Γ(X, V) p (fun m => D ℂ Γ(X, V) (v m))) I) • formA I =
      wedge (fun m => fderiv ℂ (regVal V (v m) ∘ φ.symm) (φ y)) := by
  letI := Mori.sectionAlgebra sX V
  rw [eq_sum_formA (wedge _)]
  refine Finset.sum_congr rfl fun I _ => ?_
  congr 1
  rw [exteriorPower.basis_repr_apply, exteriorPower.ιMultiDual_apply_ιMulti, RingHom.map_det,
    wedge_apply, ← Matrix.det_transpose]
  congr 1
  ext i j
  simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, Matrix.transpose_apply,
    Module.Basis.coord_apply]
  rw [fderiv_regVal_comp_symm_single hφmax hy hyV b z hbz hz]

/-- Regular functions on `V` agreeing with a regular function on `W ⊇ V` read the same in a
chart, near a point of `V(ℂ)`. -/
private lemma regVal_res_eventuallyEq
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    {V W : X.Opens} (h : V ≤ W) (f : Γ(X, W)) {y : ComplexPoints sX} (hy : y ∈ φ.source)
    (hyV : y ∈ chart V) :
    regVal V (X.presheaf.map (homOfLE h).op f) ∘ φ.symm =ᶠ[𝓝 (φ y)] regVal W f ∘ φ.symm := by
  have hS : φ.target ∩ φ.symm ⁻¹' chart V ∈ 𝓝 (φ y) :=
    (φ.isOpen_inter_preimage_symm (isOpen_chart sX V)).mem_nhds
      ⟨φ.map_source hy, by rwa [Set.mem_preimage, φ.left_inv hy]⟩
  filter_upwards [hS] with v hv
  simp only [Function.comp_apply, regVal_of_mem _ hv.2, regVal_of_mem _ (chart_mono h hv.2),
    ← evalHom_apply, evalHom_res h ⟨_, hv.2⟩]

/-- In a chart `φ = z - c`, the coordinate `z_i` restricted to `V ⊆ W` reads as the `i`-th
coordinate function, to first order. -/
private lemma fderiv_regVal_res_coord
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    {W V : X.Opens} (h : V ≤ W) (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hφ : φ.source ⊆ chart W)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - c i)
    {y : ComplexPoints sX} (hy : y ∈ φ.source) (hyV : y ∈ chart V) (i : Fin n) :
    fderiv ℂ (regVal V (X.presheaf.map (homOfLE h).op (z i)) ∘ φ.symm) (φ y) =
      EuclideanSpace.proj i := by
  have h1 : regVal W (z i) ∘ φ.symm =ᶠ[𝓝 (φ y)] fun v => EuclideanSpace.proj i v + c i := by
    filter_upwards [φ.open_target.mem_nhds (φ.map_source hy)] with v hv
    have := hφapp _ (φ.map_target hv) i
    rw [φ.right_inv hv] at this
    simp only [Function.comp_apply, regVal_of_mem _ (hφ (φ.map_target hv)), ← evalHom_apply]
    change _ = v i + c i
    rw [this, sub_add_cancel]
  have h2 : HasFDerivAt (fun v => EuclideanSpace.proj i v + c i)
      (EuclideanSpace.proj i : EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) (φ y) :=
    (EuclideanSpace.proj (𝕜 := ℂ) i).hasFDerivAt.add_const (c i)
  exact (h2.congr_of_eventuallyEq ((regVal_res_eventuallyEq φ h _ hy hyV).trans h1)).fderiv

private lemma proj_single (i k : Fin n) :
    (EuclideanSpace.proj i : EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) (EuclideanSpace.single k 1) =
      if i = k then 1 else 0 := by
  simp [PiLp.single_apply]

/-- The exterior derivative of `∑ g_I dv_I` is `∑ dg_I ∧ dv_I`. -/
private lemma extDeriv_sum_smul_formA {p : ℕ}
    (G : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ) {x : EuclideanSpace ℂ (Fin n)}
    (hG : ∀ I, DifferentiableAt ℂ (G I) x) :
    extDeriv (fun v => ∑ I, G I v • formA I) x =
      ∑ I, wedge (Fin.cons (fderiv ℂ (G I) x) fun a => EuclideanSpace.proj (enum I a)) := by
  rw [extDeriv, fderiv_fun_sum fun I _ => (hG I).smul_const (formA I)]
  simp only [fun I => fderiv_smul_const (hG I) (formA I)]
  rw [← ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply, map_sum]
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [ContinuousAlternatingMap.alternatizeUncurryFinCLM_apply,
    alternatizeUncurryFin_smulRight_wedge]

/-- **The coordinates of a de Rham differential.** In the setting of
`fderiv_regVal_comp_symm_single`, the coordinates of `dω` read at `y` are those of
`∑ d(ω_I ∘ φ⁻¹) ∧ dv_I` at `φ y`. -/
private theorem sum_evalHom_repr_deRham_smul_formA
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    {V : X.Opens} {y : ComplexPoints sX} (hy : y ∈ φ.source) (hyV : y ∈ chart V)
    (b : letI := Mori.sectionAlgebra sX V; Module.Basis (Fin n) Γ(X, V) Ω[Γ(X, V)⁄ℂ])
    (z : Fin n → Γ(X, V))
    (hbz : letI := Mori.sectionAlgebra sX V; ∀ i, b i = D ℂ Γ(X, V) (z i))
    (hz : ∀ i, fderiv ℂ (regVal V (z i) ∘ φ.symm) (φ y) = EuclideanSpace.proj i)
    {p : ℕ} (θ : letI := Mori.sectionAlgebra sX V; ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ]) :
    letI := Mori.sectionAlgebra sX V
    ∑ J, evalHom V ⟨y, hyV⟩ ((b.exteriorPower (p + 1)).repr
        (deRhamDifferential (A := ℂ) p θ) J) • formA J =
      ∑ I, wedge (Fin.cons (fderiv ℂ (regVal V ((b.exteriorPower p).repr θ I) ∘ φ.symm) (φ y))
        fun a => EuclideanSpace.proj (enum I a)) := by
  letI := Mori.sectionAlgebra sX V
  have hz' : ∀ i k, fderiv ℂ (regVal V (z i) ∘ φ.symm) (φ y) (EuclideanSpace.single k 1) =
      if i = k then 1 else 0 := fun i k => by rw [hz, proj_single]
  have hBI : ∀ I, b.exteriorPower p I =
      exteriorPower.ιMulti Γ(X, V) p (fun m => D ℂ Γ(X, V) (z (enum I m))) := fun I => by
    rw [exteriorPower.basis_apply, exteriorPower.ιMulti_family]
    congr 1
    funext m
    exact hbz _
  have hd : ∀ (c : Γ(X, V)) (w : Fin p → Γ(X, V)),
      deRhamDifferential (A := ℂ) p
          (c • exteriorPower.ιMulti Γ(X, V) p (fun m => D ℂ Γ(X, V) (w m)))
        = exteriorPower.ιMulti Γ(X, V) (p + 1)
          (fun m => D ℂ Γ(X, V) ((Fin.cons c w : Fin (p + 1) → Γ(X, V)) m)) := fun c w => by
    have := deRhamDifferential_smul_ιMulti_D (A := ℂ) p (Fin.cons c w : Fin (p + 1) → Γ(X, V))
    simpa only [Fin.cons_zero, Fin.cons_succ] using this
  conv_lhs => rw [← (b.exteriorPower p).sum_repr θ]
  simp only [hBI, map_sum, hd, Finsupp.coe_finset_sum, Finset.sum_apply, Finset.sum_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [sum_evalHom_repr_ιMulti_smul_formA hφmax hy hyV b z hbz hz']
  congr 1
  funext m
  refine Fin.cases ?_ (fun a => ?_) m
  · simp only [Fin.cons_zero]
  · simp only [Fin.cons_succ, hz]

end PointDerivation

section Forms

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [LocallyOfFiniteType sX]
  [QuasiCompact sX] [SmoothOfRelativeDimension n sX]

/-- **The local reading of `Ψ` commutes with `d`.** A family `A` of maps from the algebraic forms
on `V` to forms on `U O`, read at each point in the frames of a smaller affine open with
coordinates `z`, sends `dη` to the exterior derivative of any `ξ` with `ξ ∘ φ = A η` near `φ y'`.
-/
private theorem extDeriv_of_local_repr {W : X.Opens} (z : Fin n → Γ(X, W))
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (c : Fin n → ℂ)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - c i)
    (hloc : ∀ (V : X.Opens) (x : X) (hx : x ∈ V) (hxW : x ∈ W),
      ∃ (V'' : X.Opens) (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
        (_ : x ∈ V''), letI := Mori.sectionAlgebra sX V''
        ∃ b' : Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ],
          ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
            ((X.presheaf.map (homOfLE hV''W).op).hom (z i)))
    {V : X.Opens} (hV : IsAffineOpen V) (O : Opens (EuclideanSpace ℂ (Fin n)))
    (h : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)) ≤
      (Opens.map (toSchemeHom sX)).obj V)
    (A : ∀ q : ℕ, Γ(sX.relativeDifferentialForms (q : ℤ), V) →
      (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)) →
        EuclideanSpace ℂ (Fin n) [⋀^Fin q]→L[ℂ] ℂ)
    (hA : ∀ (q : ℕ) (t : Γ(sX.relativeDifferentialForms (q : ℤ), V))
      (y' : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)))
      (V'' : X.Opens) (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
      (hy'' : y'.1.toScheme ∈ V'')
      (b' : letI := Mori.sectionAlgebra sX V''; Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ])
      (hb' : letI := Mori.sectionAlgebra sX V''; ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
        ((X.presheaf.map (homOfLE hV''W).op).hom (z i))),
      letI := Mori.sectionAlgebra sX V''
      A q t y' = ∑ I, evalHom V'' ⟨y'.1, mem_chart_iff.2 hy''⟩
        ((b'.exteriorPower q).repr (DeRham.formsAlgEquiv sX q ⟨V'', hV''⟩
          ((sX.relativeDifferentialForms (q : ℤ)).presheaf.map (homOfLE hV''V).op t)) I) •
          formA I)
    (p : ℕ) :
    letI := Mori.sectionAlgebra sX V
    ∀ (η : ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ])
      (ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
      DifferentiableOn ℂ ξ (φ.target ∩ O) →
      (∀ y' : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)),
        ξ (φ y') = A p ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η) y') →
      ∀ y' : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)),
        A (p + 1) ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm
          (KaehlerDifferential.deRhamDifferential (A := ℂ) p η)) y' = extDeriv ξ (φ y') := by
  letI := Mori.sectionAlgebra sX V
  intro η ξ _ hξ y'
  obtain ⟨V'', hV'', hV''V, hV''W, hy'', b', hb'⟩ :=
    hloc V y'.1.toScheme (h y'.2) (mem_chart_iff.1 (hφ y'.2.1))
  letI := Mori.sectionAlgebra sX V''
  have hy''c : y'.1 ∈ chart V'' := mem_chart_iff.2 hy''
  obtain ⟨η'', hη''⟩ : ∃ η'', η'' = DeRham.formsAlgEquiv sX p ⟨V'', hV''⟩
    ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hV''V).op
      ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η)) := ⟨_, rfl⟩
  have hzc : ∀ (y₁ : ComplexPoints sX), y₁ ∈ φ.source → y₁ ∈ chart V'' → ∀ i,
      fderiv ℂ (regVal V'' ((X.presheaf.map (homOfLE hV''W).op).hom (z i)) ∘ φ.symm) (φ y₁) =
        EuclideanSpace.proj i := fun y₁ h₁ h₂ i =>
    fderiv_regVal_res_coord hV''W z _ hφ hφapp h₁ h₂ i
  rw [hA (p + 1) _ y' V'' hV'' hV''V hV''W hy'' b' hb',
    formsAlgEquiv_res_deRham sX hV hV'' hV''V p η, ← hη'',
    sum_evalHom_repr_deRham_smul_formA hφmax y'.2.1 hy''c b' _ hb' (hzc y'.1 y'.2.1 hy''c)]
  let G : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ := fun I =>
    regVal V'' ((b'.exteriorPower p).repr η'' I) ∘ φ.symm
  have hS : φ.target ∩ φ.symm ⁻¹' chart V'' ∩ (O : Set (EuclideanSpace ℂ (Fin n))) ∈
      𝓝 (φ y'.1) :=
    ((φ.isOpen_inter_preimage_symm (isOpen_chart sX V'')).inter O.2).mem_nhds
      ⟨⟨φ.map_source y'.2.1, by rwa [Set.mem_preimage, φ.left_inv y'.2.1]⟩, y'.2.2⟩
  have hξG : ξ =ᶠ[𝓝 (φ y'.1)] fun v => ∑ I, G I v • formA I := by
    filter_upwards [hS] with v hv
    have hv' : φ.symm v ∈ φ.source ∩ φ ⁻¹' O := ⟨φ.map_target hv.1.1, by
      rw [Set.mem_preimage, φ.right_inv hv.1.1]; exact hv.2⟩
    have e1 := hξ ⟨φ.symm v, hv'⟩
    simp only [φ.right_inv hv.1.1] at e1
    rw [e1, hA p _ ⟨φ.symm v, hv'⟩ V'' hV'' hV''V hV''W (mem_chart_iff.1 hv.1.2) b' hb',
      ← hη'']
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [G, Function.comp_apply, regVal_of_mem _ hv.1.2, ← evalHom_apply]
  rw [hξG.extDeriv_eq, extDeriv_sum_smul_formA G fun I =>
    differentiableAt_regVal_comp_symm hφmax _ (φ.map_source y'.2.1)
      (by rwa [φ.left_inv y'.2.1])]

/-- **The local reading of `Ψ` on wedges of differentials.** For `A` as in
`extDeriv_of_local_repr`, `A (a db₁ ∧ ⋯ ∧ db_p)` at `y'` is
`a(y') d(b₁ ∘ φ⁻¹) ∧ ⋯ ∧ d(b_p ∘ φ⁻¹)`. -/
private theorem apply_smul_ιMulti_of_local_repr {W : X.Opens} (z : Fin n → Γ(X, W))
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (c : Fin n → ℂ)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - c i)
    (hloc : ∀ (V : X.Opens) (x : X) (hx : x ∈ V) (hxW : x ∈ W),
      ∃ (V'' : X.Opens) (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
        (_ : x ∈ V''), letI := Mori.sectionAlgebra sX V''
        ∃ b' : Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ],
          ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
            ((X.presheaf.map (homOfLE hV''W).op).hom (z i)))
    {V : X.Opens} (hV : IsAffineOpen V) (O : Opens (EuclideanSpace ℂ (Fin n)))
    (h : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)) ≤
      (Opens.map (toSchemeHom sX)).obj V)
    (A : ∀ q : ℕ, Γ(sX.relativeDifferentialForms (q : ℤ), V) →
      (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)) →
        EuclideanSpace ℂ (Fin n) [⋀^Fin q]→L[ℂ] ℂ)
    (hA : ∀ (q : ℕ) (t : Γ(sX.relativeDifferentialForms (q : ℤ), V))
      (y' : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX)))
      (V'' : X.Opens) (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
      (hy'' : y'.1.toScheme ∈ V'')
      (b' : letI := Mori.sectionAlgebra sX V''; Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ])
      (hb' : letI := Mori.sectionAlgebra sX V''; ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
        ((X.presheaf.map (homOfLE hV''W).op).hom (z i))),
      letI := Mori.sectionAlgebra sX V''
      A q t y' = ∑ I, evalHom V'' ⟨y'.1, mem_chart_iff.2 hy''⟩
        ((b'.exteriorPower q).repr (DeRham.formsAlgEquiv sX q ⟨V'', hV''⟩
          ((sX.relativeDifferentialForms (q : ℤ)).presheaf.map (homOfLE hV''V).op t)) I) •
          formA I)
    (p : ℕ) :
    letI := Mori.sectionAlgebra sX V
    ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V))
      (y' : (⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩ : Opens (space sX))),
      A p ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
          (a • exteriorPower.ιMulti Γ(X, V) p
            (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m)))) y' =
        evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
          wedge (fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y')) := by
  letI := Mori.sectionAlgebra sX V
  intro a b y'
  have hz'' : ∀ (V'' : X.Opens) (hV''W : V'' ≤ W) (y' : ComplexPoints sX) (hy' : y' ∈ φ.source)
      (hy'' : y' ∈ chart V'') (i k : Fin n),
      fderiv ℂ (regVal V'' ((X.presheaf.map (homOfLE hV''W).op).hom (z i)) ∘ φ.symm) (φ y')
        (EuclideanSpace.single k 1) = if i = k then 1 else 0 := by
    intro V'' hV''W y' hy' hy'' i k
    rw [fderiv_regVal_res_coord hV''W z _ hφ hφapp hy' hy'' i, proj_single]
  obtain ⟨V'', hV'', hV''V, hV''W, hy'', b', hb'⟩ :=
    hloc V y'.1.toScheme (h y'.2) (mem_chart_iff.1 (hφ y'.2.1))
  letI := Mori.sectionAlgebra sX V''
  have hres := formsAlgEquiv_res_smul_ιMulti sX hV hV'' hV''V p a b
  have hy''c : y'.1 ∈ chart V'' := mem_chart_iff.2 hy''
  rw [hA p _ y' V'' hV'' hV''V hV''W hy'' b' hb', hres]
  simp only [map_smul, Finsupp.smul_apply, smul_eq_mul, map_mul, mul_smul, ← Finset.smul_sum]
  rw [sum_evalHom_repr_ιMulti_smul_formA hφmax y'.2.1 hy''c b' _ hb'
    (hz'' V'' hV''W y'.1 y'.2.1 hy''c)]
  congr 1
  · exact (evalHom_res hV''V ⟨y'.1, hy''c⟩ a).symm
  · congr 1
    funext m
    exact (regVal_res_eventuallyEq φ hV''V (b m) y'.2.1 hy''c).fderiv_eq

/-- **Analytic forms are holomorphic forms.** In a chart `φ = z - z(y)` of `X^an` given by
coordinates `z` whose differentials are a basis of `Ω[Γ(X, W)⁄ℂ]`, the sections of `(Ω^p)^an` are
the holomorphic `p`-forms, compatibly with restriction, the module structures, the values of
functions and the exterior derivative; and a wedge `a db₁ ∧ ⋯ ∧ db_p` of algebraic differentials
goes to `a(y') d(b₁ ∘ φ⁻¹) ∧ ⋯ ∧ d(b_p ∘ φ⁻¹)`. -/
private theorem exists_Psi {W : X.Opens} (hW : IsAffineOpen W) (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
        ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))
    (y : ComplexPoints sX)
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i))
    (Θ : structureSheaf sX ≅ 𝒪[n, ComplexPoints sX])
    (hΘ : ∀ (W : Opens (space sX)) (a : sections sX W) (y : W),
      Θ.hom.hom.app (op W) a y = sectionValue a y) :
    let U : Opens (EuclideanSpace ℂ (Fin n)) → Opens (space sX) := fun O =>
      ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩
    let Ωan : ℕ → SheafOfModules.{0} (ringCatSheaf sX) := fun p =>
      (analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))
    let an : ∀ (p : ℕ) (V : X.Opens) (O : Opens (EuclideanSpace ℂ (Fin n))),
        U O ≤ (Opens.map (toSchemeHom sX)).obj V →
        Γ(sX.relativeDifferentialForms (p : ℤ), V) → (Ωan p).val.obj (op (U O)) :=
      fun p V O h s => (Ωan p).val.presheaf.map (homOfLE h).op
        ((analytifyModuleUnit sX (sX.relativeDifferentialForms (p : ℤ))).val.app (op V) s)
    -- (3) analytic differential forms are holomorphic forms
    ∃ Ψ : ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
        (Ωan p).val.obj (op (U O)) →+
          (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
      (∀ p O, Function.Injective (Ψ p O)) ∧
      (∀ p O (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
        η ∈ Set.range (Ψ p O) ↔
          ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
            DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : U O, ξ (φ y') = η y') ∧
      (∀ p O₁ O₂ (h : U O₁ ≤ U O₂) (s : (Ωan p).val.obj (op (U O₂))) (y' : U O₁),
        Ψ p O₁ ((Ωan p).val.presheaf.map (homOfLE h).op s) y' = Ψ p O₂ s ⟨y'.1, h y'.2⟩) ∧
      (∀ p O (a : (ringCatSheaf sX).obj.obj (op (U O))) (s : (Ωan p).val.obj (op (U O)))
        (y' : U O), Ψ p O (a • s) y' = Θ.hom.hom.app (op (U O)) a y' • Ψ p O s y') ∧
      (∀ (V : X.Opens) (hV : IsAffineOpen V) O (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V)
        (g : Γ(X, V)) (y' : U O),
        letI := Mori.sectionAlgebra sX V
        Ψ 0 O (an 0 V O h ((DeRham.formsAlgEquiv sX 0 ⟨V, hV⟩).symm
            ((exteriorPower.zeroEquiv Γ(X, V) Ω[Γ(X, V)⁄ℂ]).symm g))) y' =
          ContinuousAlternatingMap.constOfIsEmpty ℂ (EuclideanSpace ℂ (Fin n)) (Fin 0)
            (evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ g)) ∧
      (∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
        (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
        letI := Mori.sectionAlgebra sX V
        ∀ (η : ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ])
          (ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
          DifferentiableOn ℂ ξ (φ.target ∩ O) →
          (∀ y' : U O, ξ (φ y') =
            Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η)) y') →
          ∀ y' : U O, Ψ (p + 1) O (an (p + 1) V O h
              ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm
                (KaehlerDifferential.deRhamDifferential (A := ℂ) p η))) y' =
            extDeriv ξ (φ y')) ∧
      -- the values on wedges of differentials
      (∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
        (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
        letI := Mori.sectionAlgebra sX V
        ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V)) (y' : U O),
          Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
              (a • exteriorPower.ιMulti Γ(X, V) p
                (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m))))) y' =
            evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
              ContinuousMultilinearMap.alternatization
                ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
                  fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y'))) := by
  intro U Ωan an
  classical
  have hUW : ∀ O, U O ≤ (Opens.map (toSchemeHom sX)).obj W := fun O y' hy' =>
    mem_chart_iff.1 (hφ hy'.1)
  letI instMF : ∀ (p : ℕ) (y : space sX), Module ((analytification sX).presheaf.stalk y)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := space sX)
        ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf y) :=
    fun p y => PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val y
  letI instF : ∀ (p : ℕ) (w : X), Module (X.presheaf.stalk w)
      ↥(TopCat.Presheaf.stalk (C := AddCommGrpCat.{0}) (X := X.toTopCat)
        (sX.relativeDifferentialForms (p : ℤ)).val.presheaf w) :=
    fun p w => PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (sX.relativeDifferentialForms (p : ℤ)).val w
  have hβ := fun (p : ℕ) (y : ComplexPoints sX) (hy : y ∈ chart (sX := sX) W) =>
    exists_an_stalk_basis sX hW z hb p y hy
  choose βan hβI hβrepr using hβ
  let val : ∀ y : space sX, (analytification sX).presheaf.stalk y →+* ℂ := fun y =>
    (smoothSheafCommRing.eval 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) (ComplexPoints sX) ℂ y).comp
      ((TopCat.Presheaf.stalkFunctor CommRingCat y).map Θ.hom.hom).hom
  let Ψ : ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
      (Ωan p).val.obj (op (U O)) →+ (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) :=
    fun p O =>
      { toFun := fun s y' => ∑ I, val y'.1
          ((@Module.Basis.repr _ _ _ _ _ (instMF p y'.1) (βan p y'.1 (hφ y'.2.1)))
          (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
            ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
            (U O) y'.1 y'.2 s) I) • formA I
        map_zero' := by
          funext y'
          erw [map_zero, map_zero]
          simp
        map_add' := fun s t => by
          funext y'
          erw [map_add, map_add]
          simp [add_smul, Finset.sum_add_distrib] }
  have hΨ : ∀ p O s (y' : U O), Ψ p O s y' = ∑ I, val y'.1
      ((@Module.Basis.repr _ _ _ _ _ (instMF p y'.1) (βan p y'.1 (hφ y'.2.1)))
        (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
          ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
          (U O) y'.1 y'.2 s) I) • formA I := fun _ _ _ _ => rfl
  have hval_germ : ∀ (O' : Opens (space sX)) (a : (ringCatSheaf sX).obj.obj (op O'))
      (y' : space sX) (hy' : y' ∈ O'),
      val y' (TopCat.Presheaf.germ (analytification sX).presheaf O' y' hy' a) =
        Θ.hom.hom.app (op O') a ⟨y', hy'⟩ := by
    intro O' a y' hy'
    change smoothSheafCommRing.eval 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) (ComplexPoints sX) ℂ y'
      ((TopCat.Presheaf.stalkFunctor CommRingCat y').map Θ.hom.hom
        (TopCat.Presheaf.germ (analytification sX).presheaf O' y' hy' a)) = _
    erw [TopCat.Presheaf.stalkFunctor_map_germ_apply, smoothSheafCommRing.eval_germ]
  have hval_stalkMap : ∀ (V : X.Opens) (g : Γ(X, V)) (y' : ComplexPoints sX)
      (hy' : y'.toScheme ∈ V),
      val y' ((analytificationHom sX).hom.stalkMap y' (X.presheaf.germ V y'.toScheme hy' g)) =
        evalHom V ⟨y', mem_chart_iff.2 hy'⟩ g := by
    intro V g y' hy'
    erw [PresheafedSpace.stalkMap_germ_apply, hval_germ, hΘ]
    exact sectionValue_sharpHom V g ⟨y', hy'⟩
  have hloc : ∀ (V : X.Opens) (x : X) (hx : x ∈ V) (hxW : x ∈ W),
      ∃ (V'' : X.Opens) (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
        (_ : x ∈ V''), letI := Mori.sectionAlgebra sX V''
        ∃ b' : Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ],
          ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
            ((X.presheaf.map (homOfLE hV''W).op).hom (z i)) := by
    intro V x hx hxW
    obtain ⟨V'', hV'', hxV'', hle⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := V ⊓ W)
      ⟨hx, hxW⟩
    have hV''W : V'' ≤ W := hle.trans inf_le_right
    obtain ⟨b, hb⟩ := hb
    obtain ⟨b', hb'⟩ := MMP.Flips.ResolutionInputs.exists_basis_res sX hW hV'' hV''W z b hb
    exact ⟨V'', hV'', hle.trans inf_le_left, hV''W, hxV'', b', hb'⟩
  have hP : ∀ (p : ℕ) (V : X.Opens) O (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V)
      (t : Γ(sX.relativeDifferentialForms (p : ℤ), V)) (y' : U O) (V'' : X.Opens)
      (hV'' : IsAffineOpen V'') (hV''V : V'' ≤ V) (hV''W : V'' ≤ W)
      (hy'' : y'.1.toScheme ∈ V'')
      (b' : letI := Mori.sectionAlgebra sX V''; Module.Basis (Fin n) Γ(X, V'') Ω[Γ(X, V'')⁄ℂ])
      (hb' : letI := Mori.sectionAlgebra sX V''; ∀ i, b' i = KaehlerDifferential.D ℂ Γ(X, V'')
        ((X.presheaf.map (homOfLE hV''W).op).hom (z i))),
      letI := Mori.sectionAlgebra sX V''
      Ψ p O (an p V O h t) y' = ∑ I, evalHom V'' ⟨y'.1, mem_chart_iff.2 hy''⟩
        ((b'.exteriorPower p).repr (DeRham.formsAlgEquiv sX p ⟨V'', hV''⟩
          ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hV''V).op t)) I) •
          formA I := by
    intro p V O h t y' V'' hV'' hV''V hV''W hy'' b' hb'
    letI := Mori.sectionAlgebra sX V''
    rw [hΨ]
    refine Finset.sum_congr rfl fun I _ => ?_
    congr 1
    have hg : TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
        ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
        (U O) y'.1 y'.2 (an p V O h t) =
        TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
        ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
        ((Opens.map (toSchemeHom sX)).obj V) y'.1 (h y'.2)
        ((analytifyModuleUnit sX (sX.relativeDifferentialForms (p : ℤ))).val.app (op V) t) :=
      TopCat.Presheaf.germ_res_apply _ (homOfLE h) _ _ _
    rw [hg]
    have hgerm := germ_eq_sum_repr sX hW hV'' hV''W z p b' hb'
      ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE hV''V).op t) y'.1.toScheme hy''
    have hgermV := TopCat.Presheaf.germ_res_apply
      (sX.relativeDifferentialForms (p : ℤ)).val.presheaf (homOfLE hV''V) y'.1.toScheme hy'' t
    exact (congrArg (val y'.1)
      (hβrepr p y'.1 (hφ y'.2.1) V (h y'.2) t _ (hgermV.symm.trans hgerm) I)).trans
      (hval_stalkMap V'' _ y'.1 hy'')
  have hWC : ∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
      (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
      letI := Mori.sectionAlgebra sX V
      ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V)) (y' : U O),
        Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
            (a • exteriorPower.ιMulti Γ(X, V) p
              (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m))))) y' =
          evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
            wedge (fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y')) := fun p V hV O h =>
    apply_smul_ιMulti_of_local_repr z hφmax hφ _ hφapp hloc hV O h
      (fun q t y' => Ψ q O (an q V O h t) y') (fun q t y' => hP q V O h t y') p
  have hlocal : ∀ p O (s : (Ωan p).val.obj (op (U O))) (y₀ : U O),
      ∃ (N : Opens (space sX)) (hN : N ≤ U O) (_ : y₀.1 ∈ N)
        (f : Set.powersetCard (Fin n) p → (ringCatSheaf sX).obj.obj (op N)),
        ∀ (y'' : space sX) (hy'' : y'' ∈ N) I,
          (@Module.Basis.repr _ _ _ _ _ (instMF p y'') (βan p y'' (hφ (hN hy'').1)))
            (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
              ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
              (U O) y'' (hN hy'') s) I =
          TopCat.Presheaf.germ (analytification sX).presheaf N y'' hy'' (f I) := by
    intro p O s y₀
    let M := ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val
    let c := (@Module.Basis.repr _ _ _ _ _ (instMF p y₀.1) (βan p y₀.1 (hφ y₀.2.1)))
      (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf (U O) y₀.1 y₀.2 s)
    have hex := fun I => TopCat.Presheaf.germ_exist (analytification sX).presheaf (c I)
    choose NI hNI fI hfI using hex
    have h1 : ∀ᶠ q in 𝓝 y₀.1, q ∈ U O := (U O).isOpen.mem_nhds y₀.2
    have h2 : ∀ᶠ q in 𝓝 y₀.1, q ∈ (Opens.map (toSchemeHom sX)).obj W :=
      (Opens.isOpen _).mem_nhds (hUW O y₀.2)
    have h3 : ∀ᶠ q in 𝓝 y₀.1, ∀ I, q ∈ NI I :=
      Filter.eventually_all.2 fun I => (NI I).isOpen.mem_nhds (hNI I)
    have hev : ∀ᶠ q in 𝓝 y₀.1, (q ∈ U O ∧ q ∈ (Opens.map (toSchemeHom sX)).obj W) ∧
        ∀ I, q ∈ NI I := (h1.and h2).and h3
    obtain ⟨T, hTsub, hTo, hx₀T⟩ := mem_nhds_iff.1 hev
    let N1 : Opens (space sX) := ⟨T, hTo⟩
    have hN1U : N1 ≤ U O := fun q hq => (hTsub hq).1.1
    have hN1W : N1 ≤ (Opens.map (toSchemeHom sX)).obj W := fun q hq => (hTsub hq).1.2
    have hN1I : ∀ I, N1 ≤ NI I := fun I q hq => (hTsub hq).2 I
    let f' : Set.powersetCard (Fin n) p → (ringCatSheaf sX).obj.obj (op N1) := fun I =>
      (analytification sX).presheaf.map (homOfLE (hN1I I)).op (fI I)
    let m : Set.powersetCard (Fin n) p → M.obj (op N1) := fun I => M.map (homOfLE hN1W).op
      ((analytifyModuleUnit sX (sX.relativeDifferentialForms (p : ℤ))).val.app (op W)
        (dzForm sX hW z p I))
    let σ : M.obj (op N1) := ∑ I, f' I • m I
    have hσ : ∀ (y'' : space sX) (hy'' : y'' ∈ N1) I,
        (@Module.Basis.repr _ _ _ _ _ (instMF p y'') (βan p y'' (hφ (hN1U hy'').1)))
          (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf N1 y''
            hy'' σ) I =
        TopCat.Presheaf.germ (analytification sX).presheaf N1 y'' hy'' (f' I) := by
      intro y'' hy'' I
      have e1 := map_sum (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
        M.presheaf N1 y'' hy'').hom (fun J => f' J • m J) Finset.univ
      have e3 : ∀ J, TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
          M.presheaf N1 y'' hy'' (m J) = βan p y'' (hφ (hN1U hy'').1) J := fun J =>
        (TopCat.Presheaf.germ_res_apply M.presheaf (homOfLE hN1W) y'' hy'' _).trans
          (hβI p y'' _ J).symm
      have e2 := Finset.sum_congr rfl fun J (_ : J ∈ Finset.univ) =>
        (PresheafOfModules.germ_smul M y'' N1 hy'' (f' J) (m J)).trans (congrArg _ (e3 J))
      erw [e1, e2]
      exact congrFun (@Module.Basis.repr_sum_self _ _ _ _ _ (instMF p y'') _
        (βan p y'' (hφ (hN1U hy'').1))
        (fun J => TopCat.Presheaf.germ (analytification sX).presheaf N1 y'' hy'' (f' J))) I
    have hσ0 : TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf N1 y₀.1
        hx₀T σ =
        TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf (U O) y₀.1
          y₀.2 s := by
      refine (@Module.Basis.repr _ _ _ _ _ (instMF p y₀.1) (βan p y₀.1 (hφ y₀.2.1))).injective
        (Finsupp.ext fun I => ?_)
      rw [hσ y₀.1 hx₀T I, ← hfI I]
      exact TopCat.Presheaf.germ_res_apply _ (homOfLE (hN1I I)) _ _ _
    obtain ⟨N2, hx₀N2, i1, i2, h12⟩ :=
      TopCat.Presheaf.germ_eq M.presheaf y₀.1 hx₀T y₀.2 σ s hσ0
    refine ⟨N2, i2.le, hx₀N2, fun I => (analytification sX).presheaf.map i1.op (f' I),
      fun y'' hy'' I => ?_⟩
    have e : TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf (U O) y''
        (i2.le hy'') s =
        TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX) M.presheaf N1 y''
          (i1.le hy'') σ := by
      rw [← TopCat.Presheaf.germ_res_apply M.presheaf i2 y'' hy'' s, ← h12,
        TopCat.Presheaf.germ_res_apply M.presheaf i1 y'' hy'' σ]
    have := hσ y'' (i1.le hy'') I
    rw [← e] at this
    refine this.trans ?_
    exact (TopCat.Presheaf.germ_res_apply (analytification sX).presheaf i1 y'' hy'' (f' I)).symm
  have hlocalΨ : ∀ p O (s : (Ωan p).val.obj (op (U O))) (y₀ : U O),
      ∃ (N : Opens (space sX)) (hN : N ≤ U O) (_ : y₀.1 ∈ N)
        (f : Set.powersetCard (Fin n) p → (ringCatSheaf sX).obj.obj (op N)),
        (∀ (y'' : space sX) (hy'' : y'' ∈ N) I,
          (@Module.Basis.repr _ _ _ _ _ (instMF p y'') (βan p y'' (hφ (hN hy'').1)))
            (TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
              ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
              (U O) y'' (hN hy'') s) I =
          TopCat.Presheaf.germ (analytification sX).presheaf N y'' hy'' (f I)) ∧
        ∀ (y'' : space sX) (hy'' : y'' ∈ N), Ψ p O s ⟨y'', hN hy''⟩ =
          ∑ I, Θ.hom.hom.app (op N) (f I) ⟨y'', hy''⟩ • formA I := by
    intro p O s y₀
    obtain ⟨N, hN, h0, f, hf⟩ := hlocal p O s y₀
    refine ⟨N, hN, h0, f, hf, fun y'' hy'' => ?_⟩
    rw [hΨ]
    refine Finset.sum_congr rfl fun I _ => ?_
    congr 1
    exact (congrArg (val y'') (hf y'' hy'' I)).trans (hval_germ N (f I) y'' hy'')
  have hΘinj : ∀ (N : Opens (space sX)) (a : (ringCatSheaf sX).obj.obj (op N)),
      (∀ y'' : N, Θ.hom.hom.app (op N) a y'' = 0) → a = 0 := by
    intro N a ha
    have h1 : Θ.hom.hom.app (op N) a = 0 := ContMDiffMap.ext fun y'' => (ha y'').trans rfl
    have h' : Θ.hom.hom ≫ Θ.inv.hom = 𝟙 _ := congrArg (fun φ => φ.hom) Θ.hom_inv_id
    have h2 : Θ.inv.hom.app (op N) (Θ.hom.hom.app (op N) a) = a :=
      congrArg (fun (g : (structureSheaf sX).obj ⟶ (structureSheaf sX).obj) => g.app (op N) a) h'
    rw [← h2, h1]
    exact map_zero _
  have hlin : ∀ p O (a : (ringCatSheaf sX).obj.obj (op (U O))) (s : (Ωan p).val.obj (op (U O)))
      (y' : U O), Ψ p O (a • s) y' = Θ.hom.hom.app (op (U O)) a y' • Ψ p O s y' := by
    intro p O a s y'
    refine (hΨ p O (a • s) y').trans ?_
    rw [hΨ p O s y', Finset.smul_sum]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [← mul_smul]
    congr 1
    erw [PresheafOfModules.germ_smul, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul,
      map_mul, hval_germ]
    rfl
  have hdz : ∀ p O (I : Set.powersetCard (Fin n) p) (y' : U O),
      Ψ p O (an p W O (hUW O) (dzForm sX hW z p I)) y' = formA I := by
    intro p O I y'
    rw [hΨ]
    have hg : TopCat.Presheaf.germ (C := AddCommGrpCat.{0}) (X := space sX)
        ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
        (U O) y'.1 y'.2 (an p W O (hUW O) (dzForm sX hW z p I)) =
        βan p y'.1 (hφ y'.2.1) I :=
      (TopCat.Presheaf.germ_res_apply _ (homOfLE (hUW O)) _ _ _).trans (hβI p y'.1 _ I).symm
    have hr := congrArg (@Module.Basis.repr _ _ _ _ _ (instMF p y'.1) (βan p y'.1 (hφ y'.2.1))) hg
    erw [hr, Module.Basis.repr_self]
    simp only [Finsupp.single_apply, apply_ite (val y'.1), map_one, map_zero, ite_smul, one_smul,
      zero_smul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  have hΘinv : ∀ (N : Opens (space sX)) (b : (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n))
      𝓘(ℂ) (ComplexPoints sX) ℂ).presheaf.obj (op N)),
      Θ.hom.hom.app (op N) (Θ.inv.hom.app (op N) b) = b := by
    intro N b
    have h' : Θ.inv.hom ≫ Θ.hom.hom = 𝟙 _ := congrArg (fun φ => φ.hom) Θ.inv_hom_id
    exact congrArg (fun (g : (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ)
      (ComplexPoints sX) ℂ).obj ⟶ (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ)
      (ComplexPoints sX) ℂ).obj) => g.app (op N) b) h'
  refine ⟨Ψ, ?_, ?_, ?_, ?_, ?_, ?_, fun p V hV O h => hWC p V hV O h⟩
  · intro p O
    refine (injective_iff_map_eq_zero (Ψ p O)).2 fun s hs => ?_
    let F : TopCat.Sheaf AddCommGrpCat.{0} (space sX) := ⟨(Ωan p).val.presheaf, (Ωan p).isSheaf⟩
    refine TopCat.Presheaf.section_ext F (U O) s 0 fun x hx => ?_
    obtain ⟨N, hN, hxN, f, hf, hfΨ⟩ := hlocalΨ p O s ⟨x, hx⟩
    have hf0 : ∀ I, f I = 0 := fun I => hΘinj N (f I) fun y'' => by
      have h := hfΨ y''.1 y''.2
      rw [hs] at h
      exact eq_zero_of_sum_formA_eq_zero _ h.symm I
    rw [map_zero]
    refine (@Module.Basis.repr _ _ _ _ _ (instMF p x) (βan p x (hφ (hN hxN).1))).injective
      (Finsupp.ext fun I => ?_)
    rw [map_zero, Finsupp.zero_apply]
    refine (hf x hxN I).trans ?_
    rw [hf0]
    exact map_zero _
  · intro p O η
    constructor
    · rintro ⟨s, rfl⟩
      classical
      let ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ := fun v =>
        if h : φ.symm v ∈ U O then Ψ p O s ⟨φ.symm v, h⟩ else 0
      have hξ : ∀ y' : U O, ξ (φ y') = Ψ p O s y' := fun y' => by
        have e : φ.symm (φ y'.1) = y'.1 := φ.left_inv y'.2.1
        have hm : φ.symm (φ y'.1) ∈ U O := by rw [e]; exact y'.2
        simp only [ξ, dif_pos hm]
        rw [show (⟨φ.symm (φ y'.1), hm⟩ : U O) = y' from Subtype.ext e]
      refine ⟨ξ, fun v hv => ?_, hξ⟩
      have hv' : φ.symm v ∈ U O := ⟨φ.map_target hv.1, by
        rw [Set.mem_preimage, φ.right_inv hv.1]; exact hv.2⟩
      obtain ⟨N, hN, hy₀N, f, -, hfΨ⟩ := hlocalΨ p O s ⟨φ.symm v, hv'⟩
      let g : Set.powersetCard (Fin n) p → ComplexPoints sX → ℂ := fun I y'' =>
        if h : y'' ∈ N then Θ.hom.hom.app (op N) (f I) ⟨y'', h⟩ else 0
      have hg : ∀ I, ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (g I) (φ.symm v) := by
        intro I
        have h1 := smoothSheaf.contMDiff_section (Θ.hom.hom.app (op N) (f I)) ⟨φ.symm v, hy₀N⟩
        have h2 : (fun y'' : N => g I y'') = Θ.hom.hom.app (op N) (f I) := by
          funext y''
          simp only [g, dif_pos y''.2]
        rw [← h2] at h1
        exact contMDiffAt_subtype_iff.1 h1
      have hS : φ.target ∩ φ.symm ⁻¹' N ∈ 𝓝 v :=
        (φ.isOpen_inter_preimage_symm N.2).mem_nhds ⟨hv.1, hy₀N⟩
      have hO : (O : Set (EuclideanSpace ℂ (Fin n))) ∈ 𝓝 v := O.2.mem_nhds hv.2
      have heq : ξ =ᶠ[𝓝 v] fun w => ∑ I, (g I ∘ φ.symm) w • formA I := by
        filter_upwards [hS, hO] with w hw hwO
        have hw' : φ.symm w ∈ U O := ⟨φ.map_target hw.1, by
          rwa [Set.mem_preimage, φ.right_inv hw.1]⟩
        simp only [ξ, dif_pos hw']
        rw [hfΨ (φ.symm w) hw.2]
        refine Finset.sum_congr rfl fun I _ => ?_
        simp only [g, Function.comp_apply]
        rw [dif_pos (show φ.symm w ∈ N from hw.2)]
      have hd : DifferentiableAt ℂ (fun w => ∑ I, (g I ∘ φ.symm) w • formA I) v :=
        DifferentiableAt.fun_sum fun I _ =>
          ((contDiffAt_comp_symm hφmax hv.1 (hg I)).differentiableAt (by simp)).smul_const _
      exact (hd.congr_of_eventuallyEq heq).differentiableWithinAt
    · rintro ⟨ξ, hξd, hξ⟩
      have hSo : IsOpen (φ.target ∩ (O : Set (EuclideanSpace ℂ (Fin n)))) :=
        φ.open_target.inter O.2
      let gI : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ := fun I v =>
        ξ v (basisVec I)
      have hgd : ∀ I, DifferentiableOn ℂ (gI I) (φ.target ∩ O) := fun I =>
        hξd.continuousAlternatingMap_apply_const (basisVec I)
      have hsm : ∀ I, ContMDiff 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞
          (fun y' : U O => gI I (φ y'.1)) := by
        intro I y'
        refine (contMDiffAt_subtype_iff (f := fun y => gI I (φ y))).2 ?_
        have hmem : φ y'.1 ∈ φ.target ∩ (O : Set (EuclideanSpace ℂ (Fin n))) :=
          ⟨φ.map_source y'.2.1, y'.2.2⟩
        have h1 : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (gI I) (φ y'.1) :=
          ((analyticOnNhd_of_differentiableOn_of_finiteDimensional hSo (hgd I)) _
            hmem).contDiffAt.contMDiffAt
        have h2 : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞
            φ y'.1 :=
          (contMDiffOn_of_mem_maximalAtlas hφmax).contMDiffAt
            (φ.open_source.mem_nhds y'.2.1)
        exact h1.comp y'.1 h2
      let a : Set.powersetCard (Fin n) p → (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n))
          𝓘(ℂ) (ComplexPoints sX) ℂ).presheaf.obj (op (U O)) := fun I =>
        ⟨fun y' => gI I (φ y'.1), hsm I⟩
      refine ⟨∑ I, Θ.inv.hom.app (op (U O)) (a I) • an p W O (hUW O) (dzForm sX hW z p I), ?_⟩
      funext y'
      rw [map_sum, Finset.sum_apply, ← hξ y', eq_sum_formA (ξ (φ y'))]
      refine Finset.sum_congr rfl fun I _ => ?_
      erw [hlin, hΘinv, hdz]
  · intro p O₁ O₂ h s y'
    refine (hΨ p O₁ ((Ωan p).val.presheaf.map (homOfLE h).op s) y').trans
      (Eq.trans (Finset.sum_congr rfl fun I _ => ?_) (hΨ p O₂ s ⟨y'.1, h y'.2⟩).symm)
    have e := TopCat.Presheaf.germ_res_apply
      ((analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))).val.presheaf
      (homOfLE h) y'.1 y'.2 s
    erw [e]
  · exact hlin
  · intro V hV O h g y'
    letI := Mori.sectionAlgebra sX V
    have h0 : (exteriorPower.zeroEquiv Γ(X, V) Ω[Γ(X, V)⁄ℂ]).symm g =
        g • exteriorPower.ιMulti Γ(X, V) 0
          (fun m : Fin 0 => KaehlerDifferential.D ℂ Γ(X, V) (Fin.elim0 m)) := by
      rw [LinearEquiv.symm_apply_eq, map_smul, exteriorPower.zeroEquiv_ιMulti, smul_eq_mul,
        mul_one]
    rw [h0, hWC 0 V hV O h g Fin.elim0 y']
    ext v
    simp [wedge_apply]
  · intro p V hV O h
    exact extDeriv_of_local_repr z hφmax hφ _ hφapp hloc hV O h
      (fun q t y' => Ψ q O (an q V O h t) y') (fun q t y' => hP q V O h t y') p

end Forms

section EtaleCoordinates

open KaehlerDifferential

/-- **Coordinates whose differentials are a basis are étale.** If `A` is smooth over `ℂ` and the
`dzᵢ` are a basis of `Ω[A⁄ℂ]`, then `ℂ[X₁, …, Xₙ] → A`, `Xᵢ ↦ zᵢ`, is étale. -/
private theorem etale_aeval_of_isBasis_D {A : Type} [CommRing A] [Algebra ℂ A]
    [Algebra.Smooth ℂ A] {n : ℕ} (z : Fin n → A) (b : Module.Basis (Fin n) A Ω[A⁄ℂ])
    (hb : ∀ i, b i = D ℂ A (z i)) : (MvPolynomial.aeval (R := ℂ) z).toRingHom.Etale := by
  classical
  letI := (MvPolynomial.aeval (R := ℂ) z).toRingHom.toAlgebra
  have hT : IsScalarTower ℂ (MvPolynomial (Fin n) ℂ) A :=
    IsScalarTower.of_algebraMap_eq fun r ↦ by
      change _ = MvPolynomial.aeval z (MvPolynomial.C r)
      simp
  have hX : ∀ i, algebraMap (MvPolynomial (Fin n) ℂ) A (MvPolynomial.X i) = z i := fun i ↦ by
    change MvPolynomial.aeval z (MvPolynomial.X i) = z i
    simp
  let e := Algebra.TensorProduct.basis A (mvPolynomialBasis ℂ (Fin n))
  have hbij : Function.Bijective (Finsupp.linearCombination A (fun i ↦ D ℂ A (z i))) := by
    have : (fun i ↦ D ℂ A (z i)) = ⇑b := funext fun i => (hb i).symm
    rw [this, ← Module.Basis.coe_repr_symm]
    exact b.repr.symm.bijective
  have heq : mapBaseChange ℂ (MvPolynomial (Fin n) ℂ) A =
      (Finsupp.linearCombination A (fun i ↦ D ℂ A (z i))) ∘ₗ e.repr.toLinearMap := by
    apply e.ext
    intro i
    simp [e, Algebra.TensorProduct.basis_apply, mvPolynomialBasis_apply, hX]
  have hF : Function.Bijective (mapBaseChange ℂ (MvPolynomial (Fin n) ℂ) A) := by
    rw [heq]
    exact hbij.comp e.repr.bijective
  have hfe : Algebra.FormallyEtale (MvPolynomial (Fin n) ℂ) A := by
    refine (Algebra.formallyEtale_iff _ A).mpr ⟨?_, ?_⟩
    · refine subsingleton_of_forall_eq 0 fun x ↦ ?_
      obtain ⟨u, rfl⟩ := KaehlerDifferential.map_surjective ℂ (MvPolynomial (Fin n) ℂ) A x
      obtain ⟨w, rfl⟩ := hF.2 u
      exact (KaehlerDifferential.exact_mapBaseChange_map ℂ (MvPolynomial (Fin n) ℂ)
        A).apply_apply_eq_zero w
    · refine subsingleton_of_forall_eq 0 fun z ↦ ?_
      have : Subsingleton (Algebra.H1Cotangent ℂ A) :=
        Algebra.FormallySmooth.subsingleton_h1Cotangent
      obtain ⟨w, hw⟩ := (Algebra.H1Cotangent.exact_map_δ ℂ (MvPolynomial (Fin n) ℂ) A z).mp
        (hF.1 (by rw [(Algebra.H1Cotangent.exact_δ_mapBaseChange ℂ (MvPolynomial (Fin n) ℂ)
          A _).mpr ⟨z, rfl⟩, map_zero]))
      rw [← hw, Subsingleton.elim w 0, map_zero]
  have : Algebra.FinitePresentation (MvPolynomial (Fin n) ℂ) A :=
    Algebra.FinitePresentation.of_restrict_scalars_finitePresentation ℂ _ A
  have : Algebra.Etale (MvPolynomial (Fin n) ℂ) A := ⟨inferInstance, inferInstance⟩
  exact RingHom.etale_algebraMap.mpr this

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

/-- The étale coordinates of an étale ring map over `ℂ`, in the form of
`AffineSpace.homOfVector`. -/
private theorem etale_homOfVector_of_ringHom {U : X.Opens} (hU : IsAffineOpen U) {n : ℕ}
    (z : Fin n → Γ(X, U))
    (φ : MvPolynomial (ULift.{0} (Fin n)) Γ(Spec (.of ℂ), ⊤) →+* Γ(X, U))
    (hC : φ.comp MvPolynomial.C = (sX.appLE ⊤ U le_top).hom)
    (hX : ∀ i, φ (MvPolynomial.X i) = z i.down) (hφ : φ.Etale) :
    Etale (AffineSpace.homOfVector (U.ι ≫ sX)
      (fun i : ULift.{0} (Fin n) ↦ U.topIso.inv (z i.down))) := by
  have key := MMP.Flips.ResolutionInputs.etale_homOfVector_of_etale (S := Spec (.of ℂ)) sX U hU
    (fun i ↦ z i.down) φ hC hX hφ
  exact key

/-- On an affine open, sections whose differentials are a basis of `Ω[Γ(X, U)⁄ℂ]` are étale
coordinates. -/
private theorem etale_homOfVector_of_isBasis_D [Smooth sX] {U : X.Opens} (hU : IsAffineOpen U)
    {n : ℕ} (z : Fin n → Γ(X, U))
    (hb : letI := Mori.sectionAlgebra sX U
      ∃ b : Module.Basis (Fin n) Γ(X, U) Ω[Γ(X, U)⁄ℂ], ∀ i, b i = D ℂ Γ(X, U) (z i)) :
    Etale (AffineSpace.homOfVector (U.ι ≫ sX)
      (fun i : ULift.{0} (Fin n) ↦ U.topIso.inv (z i.down))) := by
  letI := Mori.sectionAlgebra sX U
  have : Algebra.Smooth ℂ Γ(X, U) := MMP.Flips.ResolutionInputs.smooth_sectionAlgebra sX hU
  obtain ⟨b, hb⟩ := hb
  have hE := etale_aeval_of_isBasis_D z b hb
  let σ : Γ(Spec (.of ℂ), ⊤) ≃+* ℂ := (Scheme.ΓSpecIso (.of ℂ)).commRingCatIsoToRingEquiv
  let ψ : MvPolynomial (ULift.{0} (Fin n)) Γ(Spec (.of ℂ), ⊤) ≃+* MvPolynomial (Fin n) ℂ :=
    (MvPolynomial.mapEquiv (ULift.{0} (Fin n)) σ).trans
      (MvPolynomial.renameEquiv ℂ Equiv.ulift).toRingEquiv
  let φ : MvPolynomial (ULift.{0} (Fin n)) Γ(Spec (.of ℂ), ⊤) →+* Γ(X, U) :=
    (MvPolynomial.aeval (R := ℂ) z).toRingHom.comp ψ.toRingHom
  have hφ : φ.Etale :=
    RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective ψ.bijective) hE
  have hψX : ∀ i, ψ (MvPolynomial.X i) = MvPolynomial.X i.down := fun i => by
    change MvPolynomial.rename Equiv.ulift (MvPolynomial.map σ.toRingHom (MvPolynomial.X i)) = _
    rw [MvPolynomial.map_X, MvPolynomial.rename_X]
    rfl
  have hψC : ∀ r, ψ (MvPolynomial.C r) = MvPolynomial.C (σ r) := fun r => by
    change MvPolynomial.rename Equiv.ulift (MvPolynomial.map σ.toRingHom (MvPolynomial.C r)) = _
    rw [MvPolynomial.map_C, MvPolynomial.rename_C]
    rfl
  have hX : ∀ i, φ (MvPolynomial.X i) = z i.down := fun i => by
    change MvPolynomial.aeval z (ψ (MvPolynomial.X i)) = _
    rw [hψX, MvPolynomial.aeval_X]
  have hC : φ.comp MvPolynomial.C = (sX.appLE ⊤ U le_top).hom := by
    refine RingHom.ext fun r ↦ ?_
    change MvPolynomial.aeval z (ψ (MvPolynomial.C r)) = _
    rw [hψC, MvPolynomial.aeval_C]
    change ((Scheme.ΓSpecIso (.of ℂ)).inv ≫ sX.appLE ⊤ U _).hom
      ((Scheme.ΓSpecIso (.of ℂ)).hom r) = _
    rw [CommRingCat.comp_apply, Iso.hom_inv_id_apply]
  exact etale_homOfVector_of_ringHom sX hU z φ hC hX hφ

end EtaleCoordinates

/-- A point lies in the basic open of a product iff it lies in the basic open of every factor. -/
private lemma mem_basicOpen_prod {X : Scheme.{0}} {U : X.Opens} {ι : Type*} (s : Finset ι)
    (f : ι → Γ(X, U)) {w : X} (hw : w ∈ U) :
    w ∈ X.basicOpen (∏ i ∈ s, f i) ↔ ∀ i ∈ s, w ∈ X.basicOpen (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa only [Finset.prod_empty, Scheme.basicOpen_one, Finset.notMem_empty,
      IsEmpty.forall_iff, implies_true, iff_true] using hw
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Scheme.basicOpen_mul]
    simp only [Finset.mem_insert, forall_eq_or_imp]
    exact ⟨fun h => ⟨h.1, ih.1 h.2⟩, fun h => ⟨h.1, ih.2 h.2⟩⟩

open MMP in
/-- The local ring at a closed point of a separated quasi-compact scheme smooth of relative
dimension `n` over `ℂ` has dimension `n`. -/
private theorem ringKrullDim_stalk_eq_of_isClosed {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    {n : ℕ} [SmoothOfRelativeDimension n sX] [IsSeparated sX] [QuasiCompact sX] (x : X)
    (hx : IsClosed ({x} : Set X)) : ringKrullDim (X.presheaf.stalk x) = n := by
  have : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  haveI : IsClosedImmersion (X.fromSpecResidueField x) :=
    isClosed_singleton_iff_isClosedImmersion.mp hx
  haveI : IsClosedImmersion (X.fromSpecResidueField x ≫ sX) := by
    rw [← SpecMap_residueFieldIsoBase_inv sX x hx]; infer_instance
  have h := MMP.ringKrullDim_stalk_eq_add_of_smoothOfRelativeDimension (n := n)
    (X.fromSpecResidueField x) sX (IsLocalRing.closedPoint (X.residueField x))
  have h0 : ∀ y : Spec (.of ℂ), ringKrullDim ((Spec (.of ℂ)).presheaf.stalk y) = 0 := by
    intro y
    haveI : y.asIdeal.IsPrime := y.isPrime
    rw [ringKrullDim_eq_of_ringEquiv (Spec.stalkIso (.of ℂ) y).commRingCatIsoToRingEquiv,
      IsLocalization.AtPrime.ringKrullDim_eq_height y.asIdeal, Ideal.eq_bot_of_prime y.asIdeal]
    simp
  rw [h0, zero_add] at h
  exact (congrArg (fun y => ringKrullDim (X.presheaf.stalk y))
    (X.fromSpecResidueField_apply x _)).symm.trans h

open KaehlerDifferential MMP.Flips.ResolutionInputs in
/-- At a closed point of a scheme smooth over `ℂ`, the differentials of a regular system of
parameters are a basis of `Ω[𝒪_{X,x}⁄ℂ]`: the linear-combination map is bijective. -/
private theorem bijective_linearCombination_D_of_isClosed {X : Scheme.{0}}
    (sX : X ⟶ Spec (.of ℂ)) [Smooth sX] (x : X) (hx : IsClosed ({x} : Set X)) {m : ℕ}
    {z : Fin m → X.presheaf.stalk x} (hz : Mori.IsRegularSystemOfParameters z) :
    letI := Mori.stalkAlgebra sX x
    Function.Bijective (Finsupp.linearCombination (X.presheaf.stalk x)
      (fun i => D ℂ (X.presheaf.stalk x) (z i))) := by
  letI := Mori.stalkAlgebra sX x
  obtain ⟨_, _, _⟩ := stalk_facts sX x
  have := finite_residueField_of_isClosed sX x hx
  have : Algebra.FormallyUnramified ℂ (IsLocalRing.ResidueField (X.presheaf.stalk x)) :=
    Algebra.FormallyUnramified.of_isSeparable _ _
  have : Module.Projective (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄ℂ] :=
    ((Algebra.formallySmooth_iff _ _).mp ‹_›).1
  have : Module.Flat (X.presheaf.stalk x) Ω[X.presheaf.stalk x⁄ℂ] := .of_projective
  obtain ⟨hz0, hli, -⟩ := cotangent_basis_of_regular z hz.1 hz.2
  apply Module.IsLocalRing.linearCombination_bijective_of_flat
  refine ⟨linearIndependent_tmul_D ℂ z hz0 hli, ?_⟩
  rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination]
  exact top_le_iff.mp (span_tmul_D ℂ z hz.1)

/-- The sections of a scheme smooth over `ℂ` over a non-empty open inside a connected component
form a domain: that component is integral. -/
private theorem isDomain_of_subset_connectedComponent {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [Smooth sX] {x : X} {W : X.Opens} (hxW : x ∈ W) (hWC : (W : Set X) ⊆ connectedComponent x) :
    IsDomain Γ(X, W) := by
  have hopen := Stacks.Chow.isOpen_connectedComponent_of_smooth sX x
  have := Stacks.Chow.isIntegral_connectedComponent_of_smooth sX x hopen
  let C : X.Opens := ⟨_, hopen⟩
  haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
  haveI : IsIntegral W := isIntegral_of_isOpenImmersion
    (IsOpenImmersion.lift C.ι W.ι (by rwa [Scheme.Opens.range_ι, Scheme.Opens.range_ι]))
  haveI : Nonempty (⊤ : (W : Scheme).Opens) := ⟨⟨⟨x, hxW⟩, trivial⟩⟩
  exact W.topIso.commRingCatIsoToRingEquiv.toMulEquiv.isDomain_iff.1 inferInstance

section Adapted

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n sX]

/-- **Coordinates adapted to an snc divisor.** Around a closed point `x` there are an affine open
`W` and étale coordinates `z` on `W` forming a regular system of parameters at `x`, whose first `k`
cut out the support of `E` on `W`, and whose differentials are a basis of `Ω[Γ(X, W)⁄ℂ]`. -/
private theorem exists_adapted [IsSeparated sX] [QuasiCompact sX] (E : Mori.Divisor X)
    (hE : E.IsSNC sX) (x : X) (hx : IsClosed {x}) :
    ∃ (W : X.Opens) (hW : IsAffineOpen W) (hxW : x ∈ W) (k : ℕ) (hk : k ≤ n)
      (z : Fin n → Γ(X, W)),
      Mori.IsRegularSystemOfParameters (fun i => X.presheaf.germ W x hxW (z i)) ∧
      (∀ w ∈ W, (∃ D ∈ E.support, w ∈ D.support) ↔
        w ∉ X.basicOpen (∏ i : Fin k, z (Fin.castLE hk i))) ∧
      (letI := Mori.sectionAlgebra sX W
        ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
          ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i)) ∧
      Etale (AffineSpace.homOfVector (W.ι ≫ sX)
        (fun i : ULift.{0} (Fin n) ↦ W.topIso.inv (z i.down))) ∧
      Function.Injective (X.presheaf.map
        (homOfLE (X.basicOpen_le (∏ i : Fin k, z (Fin.castLE hk i)))).op).hom := by
  classical
  have : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian sX
  obtain ⟨m, t, j, ht, hj, hI⟩ := hE.2 x
  have hmn : m = n := by
    have h := ht.2.symm.trans (ringKrullDim_stalk_eq_of_isClosed (n := n) sX x hx)
    exact_mod_cast h
  subst hmn
  -- the components through `x`, listed first
  let S := {D : Mori.PrimeDivisor X // D ∈ E.support ∧ x ∈ D.support}
  haveI : Finite S := Finite.of_injective j hj
  letI : Fintype S := Fintype.ofFinite S
  have hk : Fintype.card S ≤ m := by simpa using Fintype.card_le_of_injective j hj
  set k := Fintype.card S with hkdef
  let eS : S ≃ Fin k := Fintype.equivFin S
  let jk : Fin k → Fin m := fun i => j (eS.symm i)
  have hjk : Function.Injective jk := hj.comp eS.symm.injective
  let e₁ : {i : Fin m // (i : ℕ) < k} ≃ Fin k :=
    { toFun := fun i => ⟨i.1, i.2⟩
      invFun := fun i => ⟨Fin.castLE hk i, i.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let e₀ : {i : Fin m // (i : ℕ) < k} ≃ {i : Fin m // i ∈ Set.range jk} :=
    e₁.trans (Equiv.ofInjective jk hjk)
  let σ : Equiv.Perm (Fin m) := e₀.extendSubtype
  have hσ : ∀ i : Fin k, σ (Fin.castLE hk i) = jk i := fun i => by
    rw [Equiv.extendSubtype_apply_of_mem e₀ _ (show ((Fin.castLE hk i : Fin m) : ℕ) < k from i.2)]
    rfl
  let z0 : Fin m → X.presheaf.stalk x := fun i => t (σ i)
  have hrange : Set.range z0 = Set.range t := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩; exact ⟨σ i, rfl⟩
    · rintro ⟨i, rfl⟩; exact ⟨σ.symm i, by simp [z0]⟩
  have hz0 : Mori.IsRegularSystemOfParameters z0 := ⟨by rw [hrange]; exact ht.1, ht.2⟩
  have hI' : ∀ i : Fin k, IdealSheafData.stalk (eS.symm i).1.idealSheaf x =
      Ideal.span {z0 (Fin.castLE hk i)} := fun i => by
    rw [hI (eS.symm i)]
    simp only [z0, hσ, jk]
  -- differentials
  letI := Mori.stalkAlgebra sX x
  have hbij := bijective_linearCombination_D_of_isClosed sX x hx hz0
  have hz0ne : ∀ i, z0 i ≠ 0 := fun i h0 =>
    (MMP.Flips.ResolutionInputs.basisOfBijective _ hbij).ne_zero i (by
      rw [MMP.Flips.ResolutionInputs.basisOfBijective_apply, h0, map_zero])
  obtain ⟨V, hV, hxV, yv, hyv, hbasis⟩ :=
    MMP.Flips.ResolutionInputs.exists_affineOpen_basis_of_bijective sX x z0 hbij
  -- the components through `x` are cut out by the coordinates
  have hsupp := fun i : Fin k => exists_mem_support_iff_notMem_basicOpen
    (eS.symm i).1.idealSheaf x (z0 (Fin.castLE hk i)) (hI' i)
  choose Vs hxVs τs hτs hss using hsupp
  have hgerm := fun i : Fin k => TopCat.Presheaf.germ_eq X.presheaf x (hxVs i) hxV (τs i)
    (yv (Fin.castLE hk i)) ((hτs i).trans (hyv _).symm)
  choose Ws hxWs iWs iWV hWs using hgerm
  -- a neighbourhood avoiding the other components
  have hev : ∀ᶠ q in 𝓝 x, q ∈ V ∧ (∀ i, q ∈ Ws i) ∧
      ∀ D ∈ E.support, x ∉ D.support → q ∉ D.support := by
    have h1 : ∀ᶠ q in 𝓝 x, q ∈ V := V.isOpen.mem_nhds hxV
    have h2 : ∀ᶠ q in 𝓝 x, ∀ i, q ∈ Ws i :=
      Filter.eventually_all.2 fun i => (Ws i).isOpen.mem_nhds (hxWs i)
    refine h1.and (h2.and ?_)
    refine (Filter.eventually_all_finset E.support).2 fun D _ => ?_
    by_cases hD : x ∈ D.support
    · exact Filter.Eventually.of_forall fun q h => (h hD).elim
    · filter_upwards [D.idealSheaf.support.isClosed.isOpen_compl.mem_nhds hD] with q hq _
      exact hq
  obtain ⟨O, hOsub, hOo, hxO⟩ := mem_nhds_iff.1 hev
  -- inside the connected component of `x`, which is integral
  have hC := Stacks.Chow.isOpen_connectedComponent_of_smooth sX x
  obtain ⟨W, hW, hxW, hWO⟩ := exists_isAffineOpen_mem_and_subset (x := x)
    (U := ⟨O, hOo⟩ ⊓ ⟨_, hC⟩) ⟨hxO, mem_connectedComponent⟩
  have hWV : W ≤ V := fun q hq => (hOsub (hWO hq).1).1
  have hWWs : ∀ i, W ≤ Ws i := fun i q hq => (hOsub (hWO hq).1).2.1 i
  let z : Fin m → Γ(X, W) := fun i => (X.presheaf.map (homOfLE hWV).op).hom (yv i)
  have hzgerm : ∀ i, X.presheaf.germ W x hxW (z i) = z0 i := fun i => by
    rw [← hyv i]
    exact X.presheaf.germ_res_apply (homOfLE hWV) x hxW (yv i)
  have hzτ : ∀ i : Fin k, z (Fin.castLE hk i) =
      X.presheaf.map (homOfLE ((hWWs i).trans (iWs i).le)).op (τs i) := fun i => by
    have h1 := congrArg (X.presheaf.map (homOfLE (hWWs i)).op).hom (hWs i)
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Functor.map_comp,
      ← Functor.map_comp] at h1
    exact h1.symm
  refine ⟨W, hW, hxW, k, hk, z, ?_, ?_, hbasis W hW hWV,
    etale_homOfVector_of_isBasis_D sX hW z (hbasis W hW hWV), ?_⟩
  · have : (fun i => X.presheaf.germ W x hxW (z i)) = z0 := funext hzgerm
    rwa [this]
  · intro w hw
    have hwO := hOsub (hWO hw).1
    rw [mem_basicOpen_prod Finset.univ _ hw]
    simp only [Finset.mem_univ, true_implies, not_forall]
    constructor
    · rintro ⟨D, hD, hwD⟩
      have hxD : x ∈ D.support := by
        by_contra hxD
        exact hwO.2.2 D hD hxD hwD
      refine ⟨eS ⟨D, hD, hxD⟩, ?_⟩
      rw [hzτ, Scheme.basicOpen_res]
      rintro ⟨-, hwb⟩
      have := (hss (eS ⟨D, hD, hxD⟩) w ((iWs _).le (hwO.2.1 _))).1
      rw [Equiv.symm_apply_apply] at this
      exact this hwD hwb
    · rintro ⟨i, hi⟩
      refine ⟨(eS.symm i).1, (eS.symm i).2.1, ?_⟩
      rw [hzτ, Scheme.basicOpen_res] at hi
      exact (hss i w ((iWs i).le (hwO.2.1 i))).2 fun hb => hi ⟨hw, hb⟩
  · have hdom := isDomain_of_subset_connectedComponent sX hxW fun q hq => (hWO hq).2
    letI := hdom.toNontrivial
    letI := IsDomain.to_noZeroDivisors Γ(X, W)
    have hf : (∏ i : Fin k, z (Fin.castLE hk i)) ≠ 0 := Finset.prod_ne_zero_iff.2
      fun i _ h0 => hz0ne (Fin.castLE hk i) (by rw [← hzgerm, h0, map_zero])
    have := hW.isLocalization_basicOpen (∏ i : Fin k, z (Fin.castLE hk i))
    exact IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hf)

/-- Composing a chart of the maximal atlas with an element of the structure groupoid gives a
chart of the maximal atlas. -/
private lemma trans_mem_maximalAtlas {H M : Type*} [TopologicalSpace H] [TopologicalSpace M]
    [ChartedSpace H M] (G : StructureGroupoid H) {e : OpenPartialHomeomorph M H}
    (he : e ∈ G.maximalAtlas M) {g : OpenPartialHomeomorph H H} (hg : g ∈ G) :
    e.trans g ∈ G.maximalAtlas M := by
  rw [mem_maximalAtlas_iff] at he ⊢
  intro e' he'
  obtain ⟨h1, h2⟩ := he e' he'
  refine ⟨?_, ?_⟩
  · rw [OpenPartialHomeomorph.trans_symm_eq_symm_trans_symm, OpenPartialHomeomorph.trans_assoc]
    exact G.trans (G.symm hg) h1
  · rw [← OpenPartialHomeomorph.trans_assoc]
    exact G.trans h2 hg

/-- Translations are holomorphic diffeomorphisms of the model space. -/
private lemma subRight_mem_contDiffGroupoid {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (a : E) : (Homeomorph.subRight a).toOpenPartialHomeomorph ∈ contDiffGroupoid ∞ 𝓘(ℂ, E) := by
  rw [contDiffGroupoid, mem_groupoid_of_pregroupoid]
  simp only [contDiffPregroupoid, modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm,
    Function.comp_id, Function.id_comp, Set.range_id, Set.preimage_id_eq, Set.inter_univ]
  constructor
  · exact (contDiff_id.sub contDiff_const).contDiffOn
  · exact (contDiff_id.add contDiff_const).contDiffOn

/-- **Translated étale charts.** For étale coordinates `z` on `W` and a point `y` of `W(ℂ)`, the
map `z - z(y)` is, near `y`, a chart of the maximal atlas of `X^an`. -/
private theorem exists_translated_chart (W : X.Opens) (z : Fin n → Γ(X, W))
    (het : Etale (AffineSpace.homOfVector (W.ι ≫ sX)
      (fun i : ULift.{0} (Fin n) ↦ W.topIso.inv (z i.down))))
    (y : ComplexPoints sX) (hy : y ∈ chart (sX := sX) W) :
    ∃ φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX),
      ∃ (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source),
        (∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
          φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i)) := by
  obtain ⟨W', hW', hW'o, hyW', hemb⟩ :=
    (etaleCoordinate_atlas_of_smooth sX (n := n)).2.1 W z het y hy
  let c : EtaleCoordinateChart sX n := ⟨W, z, het, W', hW', hW'o, ⟨y, hyW'⟩, hemb⟩
  set L := (EuclideanSpace.equiv (Fin n) ℂ).symm
  have hψ := toChart_mem_maximalAtlas sX n c ∞
  set ψ := c.toChart L
  set a := ψ y
  have hsrc : (ψ.trans (Homeomorph.subRight a).toOpenPartialHomeomorph).source = W' := by
    rw [OpenPartialHomeomorph.trans_source, c.source_toChart]
    simp
    rfl
  refine ⟨ψ.trans (Homeomorph.subRight a).toOpenPartialHomeomorph,
    trans_mem_maximalAtlas _ hψ (subRight_mem_contDiffGroupoid a),
    fun y' hy' => hW' (hsrc ▸ hy'), hsrc ▸ hyW', fun y' hy' i => ?_⟩
  have happ : ∀ y'' (hy'' : y'' ∈ W'), ψ y'' i = evalHom W ⟨y'', hW' hy''⟩ (z i) := by
    intro y'' hy''
    rw [evalHom_apply, EtaleCoordinateChart.toChart_apply]
    exact c.toOpenPartialHomeomorph_apply hy'' i
  rw [hsrc] at hy'
  simp only [OpenPartialHomeomorph.coe_trans, Homeomorph.toOpenPartialHomeomorph_apply,
    Function.comp_apply, Homeomorph.subRight_apply, PiLp.sub_apply]
  rw [happ y' hy', happ y hyW']

end Adapted

section LogFrame

variable {n : ℕ}

private lemma differentiableAt_finset_prod {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] {ι : Type*} (s : Finset ι) {F : ι → E → ℂ} {x : E}
    (h : ∀ i ∈ s, DifferentiableAt ℂ (F i) x) :
    DifferentiableAt ℂ (fun v => ∏ i ∈ s, F i v) x := by
  classical exact (HasFDerivAt.finset_prod fun i hi => (h i hi).hasFDerivAt).differentiableAt

private lemma differentiable_finset_prod {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {ι : Type*} (s : Finset ι) {F : ι → E → ℂ} (h : ∀ i, Differentiable ℂ (F i)) :
    Differentiable ℂ (fun v => ∏ i ∈ s, F i v) := fun x =>
  differentiableAt_finset_prod s fun i _ => h i x

private lemma prod_mul_prod_enum_inv {p : ℕ} (m : Fin n → ℂ) (hm : ∀ i, m i ≠ 0)
    (I : Set.powersetCard (Fin n) p) :
    (∏ i, m i) * ∏ a, (m (enum I a))⁻¹ = ∏ i ∈ (I : Finset (Fin n))ᶜ, m i := by
  have h1 : ∏ a, (m (enum I a))⁻¹ = ∏ i ∈ (I : Finset (Fin n)), (m i)⁻¹ :=
    MMP.DeRham.prod_enum I (fun i => (m i)⁻¹)
  have h2 : ∏ i ∈ (I : Finset (Fin n)), m i ≠ 0 := Finset.prod_ne_zero_iff.2 fun i _ => hm i
  rw [h1, Finset.prod_inv_distrib, ← Finset.prod_mul_prod_compl (I : Finset (Fin n)) m,
    mul_comm, ← mul_assoc, inv_mul_cancel₀ h2, one_mul]

private lemma prod_castLE {M : Type*} [CommMonoid M] {k : ℕ} (hk : k ≤ n) (F : Fin n → M) :
    ∏ j : Fin k, F (Fin.castLE hk j) = ∏ i : Fin n, if (i : ℕ) < k then F i else 1 := by
  classical
  rw [← Finset.prod_filter]
  have : Finset.univ.filter (fun i : Fin n => (i : ℕ) < k) =
      Finset.univ.map (Fin.castLEEmb hk) := by
    ext i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_map]
    constructor
    · intro hi
      exact ⟨⟨i, hi⟩, Fin.ext rfl⟩
    · rintro ⟨j, rfl⟩
      exact j.2
  rw [this, Finset.prod_map]
  rfl

/-- The points of `ℂⁿ` where `v j + c j ≠ 0` for all `j < k` are dense: every neighbourhood of
a point meets them. -/
private lemma exists_mem_forall_add_ne (k : ℕ) (c : Fin n → ℂ) {v : EuclideanSpace ℂ (Fin n)}
    {S : Set (EuclideanSpace ℂ (Fin n))} (hS : S ∈ 𝓝 v) :
    ∃ w ∈ S, ∀ j : Fin n, (j : ℕ) < k → w j + c j ≠ 0 := by
  let u : EuclideanSpace ℂ (Fin n) := WithLp.toLp 2 (fun _ => 1)
  have hcoord : ∀ (t : ℂ) (j : Fin n), (v + t • u) j = v j + t := fun t j => by
    simp [u]
  have hT : Tendsto (fun t : ℂ => v + t • u) (𝓝[≠] 0) (𝓝 v) := by
    have : Tendsto (fun t : ℂ => v + t • u) (𝓝 0) (𝓝 (v + (0 : ℂ) • u)) :=
      (continuous_const.add (continuous_id.smul continuous_const)).tendsto 0
    rw [zero_smul, add_zero] at this
    exact this.mono_left nhdsWithin_le_nhds
  have hev : ∀ᶠ t in 𝓝[≠] (0 : ℂ), ∀ j : Fin n, (j : ℕ) < k → (v + t • u) j + c j ≠ 0 := by
    refine Filter.eventually_all.2 fun j => ?_
    have hj : ∀ t : ℂ, (v + t • u) j + c j = (v j + c j) + t := fun t => by
      rw [hcoord]
      ring
    by_cases ha : v j + c j = 0
    · filter_upwards [self_mem_nhdsWithin] with t ht _
      rw [hj, ha, zero_add]
      exact ht
    · have hc : ContinuousAt (fun t : ℂ => v j + c j + t) 0 :=
        (continuous_const.add continuous_id).continuousAt
      have h0 := hc.eventually_ne (by simpa using ha)
      filter_upwards [h0.filter_mono nhdsWithin_le_nhds] with t ht _
      rw [hj]
      exact ht
  obtain ⟨t, ht1, ht2⟩ := ((hT.eventually hS).and hev).exists
  exact ⟨_, ht1, ht2⟩

/-- The wedge product `L ∧ ℓ₁ ∧ ⋯ ∧ ℓ_p`, as a continuous linear map in its first factor `L`. -/
private noncomputable def wedgeConsL {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {p : ℕ} (ℓ : Fin p → E →L[ℂ] ℂ) : (E →L[ℂ] ℂ) →L[ℂ] E [⋀^Fin (p + 1)]→L[ℂ] ℂ :=
  (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℂ E ℂ).comp
    ((ContinuousLinearMap.smulRightL ℂ E _).flip (wedge ℓ))

private lemma wedgeConsL_apply {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {p : ℕ} (ℓ : Fin p → E →L[ℂ] ℂ) (L : E →L[ℂ] ℂ) :
    wedgeConsL ℓ L = wedge (Fin.cons L ℓ) := by
  rw [← alternatizeUncurryFin_smulRight_wedge]
  rfl

/-- A linear form on `ℂⁿ` is the combination of the coordinate forms with its values on the
standard basis as coefficients. -/
private lemma eq_sum_proj (L : EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) :
    L = ∑ i, L (EuclideanSpace.single i 1) • EuclideanSpace.proj i := by
  refine ContinuousLinearMap.ext fun w => ?_
  conv_lhs => rw [← (EuclideanSpace.basisFun (Fin n) ℂ).toBasis.sum_repr w]
  simp [map_sum, mul_comm]

/-- `dv_j ∧ dv_I = 0` for `j ∈ I`. -/
private lemma wedge_cons_proj_enum {p : ℕ} (I : Set.powersetCard (Fin n) p) (a : Fin p) :
    wedge (Fin.cons (EuclideanSpace.proj (enum I a)) fun b => EuclideanSpace.proj (enum I b) :
      Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) = 0 := by
  ext w
  rw [wedge_apply]
  exact Matrix.det_zero_of_column_eq (i := 0) (j := a.succ) (Fin.succ_ne_zero a).symm
    fun r => by simp

/-- If `dv_i ∧ dv_I` does not vanish on the basis tuple of `J`, then `i ∉ I` and `J = {i} ∪ I`. -/
private lemma eq_insert_of_wedge_cons_ne_zero {p : ℕ} (i : Fin n) (I : Set.powersetCard (Fin n) p)
    (J : Set.powersetCard (Fin n) (p + 1))
    (h : wedge (Fin.cons (EuclideanSpace.proj i) fun b => EuclideanSpace.proj (enum I b) :
      Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) (basisVec J) ≠ 0) :
    i ∉ (I : Finset (Fin n)) ∧ (J : Finset (Fin n)) = insert i (I : Finset (Fin n)) := by
  classical
  have hiI : i ∉ (I : Finset (Fin n)) := by
    intro hi
    obtain ⟨a, rfl⟩ := (mem_iff_exists_enum I i).1 hi
    rw [wedge_cons_proj_enum] at h
    exact h rfl
  refine ⟨hiI, ?_⟩
  rw [wedge_apply] at h
  have hsub : insert i (I : Finset (Fin n)) ⊆ J := by
    intro x hx
    by_contra hxJ
    rw [Finset.mem_insert] at hx
    rcases hx with rfl | hx
    · refine h (Matrix.det_eq_zero_of_column_eq_zero 0 fun r => ?_)
      simp only [Matrix.of_apply, Fin.cons_zero, proj_single]
      rw [if_neg]
      rintro rfl
      exact hxJ ((mem_iff_exists_enum J _).2 ⟨r, rfl⟩)
    · obtain ⟨a, rfl⟩ := (mem_iff_exists_enum I x).1 hx
      refine h (Matrix.det_eq_zero_of_column_eq_zero a.succ fun r => ?_)
      simp only [Matrix.of_apply, Fin.cons_succ, proj_single]
      rw [if_neg]
      intro he
      exact hxJ ((mem_iff_exists_enum J _).2 ⟨r, he.symm⟩)
  refine (Finset.eq_of_subset_of_card_le hsub ?_).symm
  rw [Finset.card_insert_of_notMem hiI, I.2, J.2]

/-- The derivative of a function invariant under translation along `d` vanishes on `d`. -/
private lemma fderiv_apply_eq_zero_of_forall_add_smul {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] {G : E → ℂ} {w d : E} (hG : DifferentiableAt ℂ G w)
    (h : ∀ t : ℂ, G (w + t • d) = G w) : fderiv ℂ G w d = 0 := by
  have h1 : HasDerivAt (fun t : ℂ => w + t • d) d 0 := by
    simpa using ((hasDerivAt_id (0 : ℂ)).smul_const d).const_add w
  have h2 := hG.hasFDerivAt.comp_hasDerivAt_of_eq (x := (0 : ℂ)) h1 (by simp)
  have h3 : G ∘ (fun t : ℂ => w + t • d) = fun _ => G w := funext h
  rw [h3] at h2
  exact h2.unique (hasDerivAt_const _ _)

end LogFrame

section LogFrameAnalysis

variable {n : ℕ} (k : ℕ) (c : Fin n → ℂ)

/-- The local equation `v_j + c_j` of the `j`-th boundary component, and `1` for `j ≥ k`. -/
private noncomputable def logEqn (v : EuclideanSpace ℂ (Fin n)) (j : Fin n) : ℂ :=
  if (j : ℕ) < k then v j + c j else 1

/-- The scaling factor `(v_j + c_j)⁻¹` of the `j`-th logarithmic form `dv_j / (v_j + c_j)`, and
`1` for `j ≥ k`. -/
private noncomputable def logScale (v : EuclideanSpace ℂ (Fin n)) (j : Fin n) : ℂ :=
  if (j : ℕ) < k then (v j + c j)⁻¹ else 1

/-- The complement of the boundary: the points where no local equation vanishes. -/
private abbrev logLocus : Set (EuclideanSpace ℂ (Fin n)) :=
  {v | ∀ j : Fin n, (j : ℕ) < k → v j + c j ≠ 0}

/-- The logarithmic frame `dv_I / ∏_{j ∈ I, j < k} (v_j + c_j)` at `v`. -/
private noncomputable abbrev logFrame {p : ℕ} (I : Set.powersetCard (Fin n) p)
    (v : EuclideanSpace ℂ (Fin n)) : EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ :=
  (∏ a, logScale k c v (enum I a)) • formA I

variable {k c}

private lemma logEqn_ne_zero {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ logLocus k c) (j : Fin n) :
    logEqn k c v j ≠ 0 := by
  unfold logEqn
  split_ifs with h
  · exact hv j h
  · exact one_ne_zero

private lemma logScale_eq_inv (v : EuclideanSpace ℂ (Fin n)) (j : Fin n) :
    logScale k c v j = (logEqn k c v j)⁻¹ := by
  unfold logScale logEqn
  split_ifs <;> simp

private lemma differentiable_logEqn (j : Fin n) : Differentiable ℂ (fun v => logEqn k c v j) := by
  unfold logEqn
  split_ifs
  · exact (EuclideanSpace.proj (𝕜 := ℂ) j).differentiable.add_const _
  · exact differentiable_const _

private lemma differentiableAt_logScale {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ logLocus k c)
    (j : Fin n) : DifferentiableAt ℂ (fun w => logScale k c w j) v := by
  simp only [logScale_eq_inv]
  exact (differentiable_logEqn j v).inv (logEqn_ne_zero hv j)

private lemma prod_logScale_ne_zero {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ logLocus k c)
    {p : ℕ} (I : Set.powersetCard (Fin n) p) : ∏ a, logScale k c v (enum I a) ≠ 0 :=
  Finset.prod_ne_zero_iff.2 fun a _ => by
    rw [logScale_eq_inv]
    exact inv_ne_zero (logEqn_ne_zero hv _)

/-- **The logarithmic frame is independent.** On an open set, continuous coefficients of a
combination of the `logFrame I` vanishing off the boundary vanish, since the complement of the
boundary is dense. -/
private theorem eq_zero_of_sum_smul_logFrame_eq_zero {p : ℕ} {S : Set (EuclideanSpace ℂ (Fin n))}
    (hS : IsOpen S) {g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ}
    (hg : ∀ I, ContinuousOn (g I) S)
    (h0 : ∀ v ∈ S ∩ logLocus k c, ∑ I, g I v • logFrame k c I v = 0)
    (I : Set.powersetCard (Fin n) p) : ∀ v ∈ S, g I v = 0 := by
  intro v hv
  by_contra hne
  obtain ⟨w, ⟨hw1, hw2⟩, hw3⟩ := exists_mem_forall_add_ne k c
    (Filter.inter_mem (((hg I).continuousAt (hS.mem_nhds hv)).eventually_ne hne) (hS.mem_nhds hv))
  have h := h0 w ⟨hw2, hw3⟩
  simp only [logFrame, smul_smul] at h
  exact hw1 ((mul_eq_zero.1 (eq_zero_of_sum_formA_eq_zero _ h I)).resolve_right
    (prod_logScale_ne_zero hw3 I))

/-- `d(g · logFrame I) = ∑ᵢ (logScale I) ∂ᵢg dvᵢ ∧ dv_I`: the scaling factor of `logFrame I` only
depends on the coordinates in `I`, so its derivative wedges to zero against `dv_I`. -/
private lemma wedge_cons_fderiv_mul_prod_logScale {p : ℕ} (I : Set.powersetCard (Fin n) p)
    {G : EuclideanSpace ℂ (Fin n) → ℂ} {v : EuclideanSpace ℂ (Fin n)}
    (hG : DifferentiableAt ℂ G v) (hv : v ∈ logLocus k c) :
    wedge (Fin.cons (fderiv ℂ (fun w => G w * ∏ a, logScale k c w (enum I a)) v)
        fun a => EuclideanSpace.proj (enum I a) :
          Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) =
      ∑ i, ((∏ a, logScale k c v (enum I a)) * fderiv ℂ G v (EuclideanSpace.single i 1)) •
        wedge (Fin.cons (EuclideanSpace.proj i) fun a => EuclideanSpace.proj (enum I a) :
          Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) := by
  set P := fun w => ∏ a, logScale k c w (enum I a)
  have hP : DifferentiableAt ℂ P v :=
    differentiableAt_finset_prod Finset.univ fun a _ => differentiableAt_logScale hv _
  have h0 : ∑ i, fderiv ℂ P v (EuclideanSpace.single i 1) •
      (wedge (Fin.cons (EuclideanSpace.proj i) fun a => EuclideanSpace.proj (enum I a) :
        Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ)) = 0 := by
    refine Finset.sum_eq_zero fun i _ => ?_
    by_cases hi : i ∈ (I : Finset (Fin n))
    · obtain ⟨a, rfl⟩ := (mem_iff_exists_enum I i).1 hi
      rw [wedge_cons_proj_enum, smul_zero]
    · rw [fderiv_apply_eq_zero_of_forall_add_smul hP fun t => ?_, zero_smul]
      refine Finset.prod_congr rfl fun a _ => ?_
      have hne : enum I a ≠ i := fun h => hi ((mem_iff_exists_enum I i).2 ⟨a, h⟩)
      simp [logScale, PiLp.single_apply, hne]
  have h1 : fderiv ℂ (fun w => G w * P w) v = G v • fderiv ℂ P v + P v • fderiv ℂ G v :=
    fderiv_mul hG hP
  conv_lhs => rw [h1, ← wedgeConsL_apply, map_add, map_smul, map_smul,
    eq_sum_proj (fderiv ℂ P v), eq_sum_proj (fderiv ℂ G v)]
  simp only [map_sum, map_smul, wedgeConsL_apply]
  rw [h0, smul_zero, zero_add, Finset.smul_sum]
  simp only [smul_smul]
  rfl

/-- **The logarithmic frame is stable under `d`.** On an open set, the exterior derivative of a
holomorphic combination of the `logFrame I` is, off the boundary, a holomorphic combination of the
`logFrame J`: `d(dv_j / (v_j + c_j)) = 0` and
`(v_i + c_i) · logFrame (I ∪ {i}) = dv_i ∧ logFrame I`. -/
private theorem exists_extDeriv_sum_smul_logFrame {p : ℕ} {S : Set (EuclideanSpace ℂ (Fin n))}
    (hS : IsOpen S) {g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ}
    (hg : ∀ I, DifferentiableOn ℂ (g I) S) :
    ∃ g' : Set.powersetCard (Fin n) (p + 1) → EuclideanSpace ℂ (Fin n) → ℂ,
      (∀ J, DifferentiableOn ℂ (g' J) S) ∧ ∀ v ∈ S ∩ logLocus k c,
        extDeriv (fun v' => ∑ I, g I v' • logFrame k c I v') v =
          ∑ J, g' J v • logFrame k c J v := by
  let D : Set.powersetCard (Fin n) p → Fin n → EuclideanSpace ℂ (Fin n) → ℂ := fun I i v =>
    fderiv ℂ (g I) v (EuclideanSpace.single i 1)
  let σ : Fin n → Set.powersetCard (Fin n) p → Set.powersetCard (Fin n) (p + 1) → ℂ :=
    fun i I J => wedge (Fin.cons (EuclideanSpace.proj i) fun b => EuclideanSpace.proj (enum I b) :
      Fin (p + 1) → EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) (basisVec J)
  refine ⟨fun J v => ∑ I, ∑ i, logEqn k c v i * D I i v * σ i I J, fun J => ?_,
    fun v ⟨hvS, hvD⟩ => ?_⟩
  · refine DifferentiableOn.fun_sum fun I _ => DifferentiableOn.fun_sum fun i _ => ?_
    refine (((differentiable_logEqn i).differentiableOn).mul ?_).mul_const _
    exact (analyticOnNhd_of_differentiableOn_of_finiteDimensional hS
      (hg I)).fderiv.differentiableOn.clm_apply (differentiableOn_const _)
  have hgd : ∀ I, DifferentiableAt ℂ (g I) v := fun I => (hg I).differentiableAt (hS.mem_nhds hvS)
  have hF : (fun v' => ∑ I, g I v' • logFrame k c I v') =
      fun v' => ∑ I, (g I v' * ∏ a, logScale k c v' (enum I a)) • formA I := by
    funext v'
    simp only [logFrame, smul_smul]
  rw [hF, extDeriv_sum_smul_formA (fun I v' => g I v' * ∏ a, logScale k c v' (enum I a))
    fun I => (hgd I).mul (differentiableAt_finset_prod Finset.univ fun a _ =>
      differentiableAt_logScale hvD _)]
  simp only [wedge_cons_fderiv_mul_prod_logScale _ (hgd _) hvD, logFrame]
  refine ext_of_basisVec fun J0 => ?_
  simp only [ContinuousAlternatingMap.sum_apply, ContinuousAlternatingMap.smul_apply,
    formA_basisVec, smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true, Finset.sum_mul]
  refine Finset.sum_congr rfl fun I _ => Finset.sum_congr rfl fun i _ => ?_
  change (∏ a, logScale k c v (enum I a)) * D I i v * σ i I J0 =
    logEqn k c v i * D I i v * σ i I J0 * ∏ a, logScale k c v (enum J0 a)
  by_cases hσ : σ i I J0 = 0
  · rw [hσ, mul_zero, mul_zero, zero_mul]
  obtain ⟨hiI, hJ⟩ := eq_insert_of_wedge_cons_ne_zero i I J0 hσ
  rw [MMP.DeRham.prod_enum J0 (fun j => logScale k c v j),
    MMP.DeRham.prod_enum I (fun j => logScale k c v j), hJ, Finset.prod_insert hiI,
    logScale_eq_inv]
  field_simp [logEqn_ne_zero hvD i]

/-- **Clearing the boundary.** Multiplying a holomorphic combination of the `logFrame I` by the
equation `∏_{j < k} (v_j + c_j)` of the boundary gives, off the boundary, a holomorphic form. -/
private theorem exists_prod_smul_sum_smul_logFrame (hk : k ≤ n) {p : ℕ}
    {S : Set (EuclideanSpace ℂ (Fin n))}
    {g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ}
    (hg : ∀ I, DifferentiableOn ℂ (g I) S) :
    ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
      DifferentiableOn ℂ ξ S ∧ ∀ v ∈ S ∩ logLocus k c,
        ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
          ∑ I, g I v • logFrame k c I v := by
  refine ⟨fun v => ∑ I, g I v • (∏ i ∈ (I : Finset (Fin n))ᶜ, logEqn k c v i) • formA I,
    DifferentiableOn.fun_sum fun I _ => (hg I).smul (DifferentiableOn.smul_const
      (differentiable_finset_prod _ differentiable_logEqn).differentiableOn _), fun v hv => ?_⟩
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [prod_castLE hk (fun i => v i + c i), ← prod_mul_prod_enum_inv _ (logEqn_ne_zero hv.2) I]
  simp only [logFrame, smul_smul, logScale_eq_inv]
  congr 1
  simp only [logEqn]
  ring

end LogFrameAnalysis

section LogTwistAnalysis

variable {n : ℕ} {k : ℕ} {c : Fin n → ℂ}

/-- Off the boundary, `∏_{j < k} (v_j + c_j) · ∑ g_I logFrame I` is the combination of the forms
`∏_{j ∉ I} logEqn_j · dv_I`, which are holomorphic across the boundary. -/
private lemma prod_smul_sum_smul_logFrame_eq (hk : k ≤ n) {p : ℕ}
    (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ)
    {v : EuclideanSpace ℂ (Fin n)} (hv : v ∈ logLocus k c) :
    (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) • ∑ I, g I v • logFrame k c I v =
      ∑ I, g I v • (∏ i ∈ (I : Finset (Fin n))ᶜ, logEqn k c v i) • formA I := by
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun I _ => ?_
  rw [prod_castLE hk (fun i => v i + c i), ← prod_mul_prod_enum_inv _ (logEqn_ne_zero hv) I]
  simp only [logFrame, smul_smul, logScale_eq_inv]
  congr 1
  simp only [logEqn]
  ring

private lemma differentiableOn_sum_smul_prod_logEqn {p : ℕ} {S : Set (EuclideanSpace ℂ (Fin n))}
    {g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ}
    (hg : ∀ I, DifferentiableOn ℂ (g I) S) :
    DifferentiableOn ℂ
      (fun v => ∑ I, g I v • (∏ i ∈ (I : Finset (Fin n))ᶜ, logEqn k c v i) • formA I) S :=
  DifferentiableOn.fun_sum fun I _ => (hg I).smul (DifferentiableOn.smul_const
    (differentiable_finset_prod _ differentiable_logEqn).differentiableOn _)

/-- Continuous maps on an open set agreeing off the boundary agree, the complement of the boundary
being dense. -/
private lemma eqOn_of_eqOn_logLocus {F : Type*} [NormedAddCommGroup F]
    {S : Set (EuclideanSpace ℂ (Fin n))} (hS : IsOpen S) {G H : EuclideanSpace ℂ (Fin n) → F}
    (hG : ContinuousOn G S) (hH : ContinuousOn H S) (h : ∀ v ∈ S ∩ logLocus k c, G v = H v) :
    ∀ v ∈ S, G v = H v := by
  intro v hv
  by_contra hne
  obtain ⟨w, ⟨hw1, hw2⟩, hw3⟩ := exists_mem_forall_add_ne k c
    (Filter.inter_mem (((hG.sub hH).continuousAt (hS.mem_nhds hv)).eventually_ne
      (sub_ne_zero.2 hne)) (hS.mem_nhds hv))
  exact hw1 (sub_eq_zero.2 (h w ⟨hw2, hw3⟩))

end LogTwistAnalysis

section LogTwistAlgebra

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) {n : ℕ}

/-- The forms `(∏_{j ∉ I, j < k} z_j) dz_I` spanning `Ω^p(log E)(-E)` on `W` are free. -/
private theorem linearIndependent_logTwist {W : X.Opens} {k : ℕ} (hk : k ≤ n)
    (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
        ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))
    (hinj : Function.Injective (X.presheaf.map
        (homOfLE (X.basicOpen_le (∏ i : Fin k, z (Fin.castLE hk i)))).op).hom)
    (p : ℕ) :
    letI := Mori.sectionAlgebra sX W
    LinearIndependent Γ(X, W) fun I : Set.powersetCard (Fin n) p =>
      (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
        exteriorPower.ιMulti Γ(X, W) p fun a =>
          KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a)) := by
  letI := Mori.sectionAlgebra sX W
  let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
  let L := Γ(X, X.basicOpen f)
  letI : Algebra Γ(X, W) L := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  let coeff : Set.powersetCard (Fin n) p → Γ(X, W) := fun I =>
    ∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1
  obtain ⟨bW, hbW⟩ := hb
  have hB : ∀ I : Set.powersetCard (Fin n) p,
      (exteriorPower.ιMulti Γ(X, W) p fun a =>
        KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))) =
        bW.exteriorPower p I := by
    intro I
    rw [exteriorPower.basis_apply, exteriorPower.ιMulti_family]
    congr 1
    funext a
    exact (hbW _).symm
  rw [linearIndependent_iff']
  intro s a hs I hI
  simp only [hB, smul_smul] at hs
  have h3 := (linearIndependent_iff'.1 (bW.exteriorPower p).linearIndependent) s _ hs I hI
  have hdvd : coeff I ∣ f := by
    rw [show f = ∏ j : Fin n, if (j : ℕ) < k then z j else 1 from prod_castLE hk z]
    exact Finset.prod_dvd_prod_of_subset _ _ _ (Finset.subset_univ _)
  have hu : IsUnit (algebraMap Γ(X, W) L (coeff I)) :=
    isUnit_of_dvd_unit (map_dvd _ hdvd) (X.toRingedSpace.isUnit_res_basicOpen f)
  have h4 := congrArg (algebraMap Γ(X, W) L) h3
  rw [map_mul, map_zero] at h4
  refine hinj ?_
  rw [map_zero]
  exact hu.mul_left_eq_zero.1 h4

/-- Off `E`, the form `(∏_{j ∉ I, j < k} z_j) dz_I` is `z₁ ⋯ z_k · ε_I`. -/
private theorem formsAlgEquiv_res_logTwist {W : X.Opens} (hW : IsAffineOpen W) {k : ℕ}
    (hk : k ≤ n) (z : Fin n → Γ(X, W)) (p : ℕ) (I : Set.powersetCard (Fin n) p) :
    let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
    let L := Γ(X, X.basicOpen f)
    letI : Algebra Γ(X, W) L :=
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
    let ε : Fin n → Ω[L⁄ℂ] := fun j =>
      if (j : ℕ) < k then
        Ring.inverse (algebraMap Γ(X, W) L (z j)) •
          KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
      else KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
    letI := Mori.sectionAlgebra sX W
    DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩
        ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map (homOfLE (X.basicOpen_le f)).op
          ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm
            ((∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
              exteriorPower.ιMulti Γ(X, W) p fun a =>
                KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))))) =
      algebraMap Γ(X, W) L f • exteriorPower.ιMulti_family L p ε I := by
  intro f L ε
  letI : Algebra Γ(X, W) L := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
  letI := Mori.sectionAlgebra sX W
  have hunit : ∀ j : Fin n, (j : ℕ) < k → IsUnit (algebraMap Γ(X, W) L (z j)) := by
    intro j hj
    have hf : IsUnit (algebraMap Γ(X, W) L f) := X.toRingedSpace.isUnit_res_basicOpen f
    refine isUnit_of_dvd_unit (map_dvd _ ?_) hf
    have : j = Fin.castLE hk ⟨j, hj⟩ := Fin.ext rfl
    rw [this]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ _)
  let σ : Fin n → L := fun j =>
    if (j : ℕ) < k then Ring.inverse (algebraMap Γ(X, W) L (z j)) else 1
  have hι : exteriorPower.ιMulti_family L p ε I = (∏ a, σ (enum I a)) •
      exteriorPower.ιMulti L p
        (fun a => KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z (enum I a)))) := by
    rw [exteriorPower.ιMulti_family, ← AlternatingMap.map_smul_univ]
    congr 1
    funext a
    simp only [ε, σ, Function.comp_apply]
    split_ifs
    · rfl
    · exact (one_smul _ _).symm
  have hm : ∀ j : Fin n,
      algebraMap Γ(X, W) L (if (j : ℕ) < k then z j else 1) * σ j = 1 := by
    intro j
    simp only [σ]
    split_ifs with hj
    · exact Ring.mul_inverse_cancel _ (hunit j hj)
    · rw [map_one, one_mul]
  have h1 : ∏ a, σ (enum I a) = ∏ j ∈ (I : Finset (Fin n)), σ j := MMP.DeRham.prod_enum I σ
  have hf_eq : f = ∏ j : Fin n, if (j : ℕ) < k then z j else 1 := prod_castLE hk z
  have hcoef : algebraMap Γ(X, W) L (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) =
      algebraMap Γ(X, W) L f * ∏ a, σ (enum I a) := by
    rw [h1, hf_eq, map_prod, map_prod,
      ← Finset.prod_mul_prod_compl (I : Finset (Fin n)), mul_comm (∏ i ∈ (I : Finset (Fin n)), _),
      mul_assoc, ← Finset.prod_mul_distrib, Finset.prod_congr rfl (fun j _ => hm j),
      Finset.prod_const_one, mul_one]
  rw [formsAlgEquiv_res_smul_ιMulti sX hW (hW.basicOpen f) (X.basicOpen_le f) p _
    (fun a => z (enum I a)), hι, smul_smul, ← hcoef]
  rfl

end LogTwistAlgebra

section LogTwist

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ} [SmoothOfRelativeDimension n sX]

omit [SmoothOfRelativeDimension n sX] in
/-- In a chart `φ = z - c`, the coordinate `z_i` reads as the `i`-th coordinate function, to first
order. -/
private lemma fderiv_regVal_coord
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    {W : X.Opens} (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hφ : φ.source ⊆ chart W)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - c i)
    {y : ComplexPoints sX} (hy : y ∈ φ.source) (i : Fin n) :
    fderiv ℂ (regVal W (z i) ∘ φ.symm) (φ y) = EuclideanSpace.proj i := by
  have h1 : regVal W (z i) ∘ φ.symm =ᶠ[𝓝 (φ y)] fun v => EuclideanSpace.proj i v + c i := by
    filter_upwards [φ.open_target.mem_nhds (φ.map_source hy)] with v hv
    have := hφapp _ (φ.map_target hv) i
    rw [φ.right_inv hv] at this
    simp only [Function.comp_apply, regVal_of_mem _ (hφ (φ.map_target hv)), ← evalHom_apply]
    change _ = v i + c i
    rw [this, sub_add_cancel]
  have h2 : HasFDerivAt (fun v => EuclideanSpace.proj i v + c i)
      (EuclideanSpace.proj i : EuclideanSpace ℂ (Fin n) →L[ℂ] ℂ) (φ y) :=
    (EuclideanSpace.proj (𝕜 := ℂ) i).hasFDerivAt.add_const (c i)
  exact (h2.congr_of_eventuallyEq h1).fderiv

/-- The value of a wedge product of chart coordinates, scaled by a regular function. -/
private lemma evalHom_smul_wedge_fderiv_coord
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    {W : X.Opens} {k : ℕ} (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hφ : φ.source ⊆ chart W)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - c i)
    {p : ℕ} (I : Set.powersetCard (Fin n) p) {y' : ComplexPoints sX} (hy' : y' ∈ φ.source)
    (hy'W : y' ∈ chart W) :
    evalHom W ⟨y', hy'W⟩ (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
        wedge (fun m => fderiv ℂ (regVal W (z (enum I m)) ∘ φ.symm) (φ y')) =
      (∏ i ∈ (I : Finset (Fin n))ᶜ, logEqn k c (φ y') i) • formA I := by
  simp only [fderiv_regVal_coord z c hφ hφapp hy']
  congr 1
  rw [map_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  simp only [logEqn]
  split_ifs with hi
  · rw [hφapp y' hy' i, sub_add_cancel]
  · exact map_one _

set_option maxRecDepth 8000 in
/-- **Analytification of `Ω^p(log E)(-E)`.** The comparison map `Ψ` carries the `𝒪`-span of the
analytifications of the forms `(∏_{j ∉ I, j < k} z_j) dz_I` bijectively onto the holomorphic
combinations of the forms `(∏_{j < k} (v_j + c_j)) e_I`. -/
private theorem mem_image_span_logTwist_iff {W : X.Opens} (hW : IsAffineOpen W) {k : ℕ}
    (hk : k ≤ n) (z : Fin n → Γ(X, W)) (y : ComplexPoints sX)
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i))
    (Θ : structureSheaf sX ≅ 𝒪[n, ComplexPoints sX])
    (U : Opens (EuclideanSpace ℂ (Fin n)) → Opens (space sX))
    (hU : U = fun O => ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩)
    (Ωan : ℕ → SheafOfModules.{0} (ringCatSheaf sX))
    (an : ∀ (p : ℕ) (V : X.Opens) (O : Opens (EuclideanSpace ℂ (Fin n))),
        U O ≤ (Opens.map (toSchemeHom sX)).obj V →
        Γ(sX.relativeDifferentialForms (p : ℤ), V) → (Ωan p).val.obj (op (U O)))
    (Ψ : ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
        (Ωan p).val.obj (op (U O)) →+
          (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ))
    (hlin : ∀ p O (a : (ringCatSheaf sX).obj.obj (op (U O))) (s : (Ωan p).val.obj (op (U O)))
        (y' : U O), Ψ p O (a • s) y' = Θ.hom.hom.app (op (U O)) a y' • Ψ p O s y')
    (hWC : ∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
        (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
        letI := Mori.sectionAlgebra sX V
        ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V)) (y' : U O),
          Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
              (a • exteriorPower.ιMulti Γ(X, V) p
                (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m))))) y' =
            evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
              ContinuousMultilinearMap.alternatization
                ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
                  fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y')))
    (c : Fin n → ℂ) (hc : c = fun j => evalHom W ⟨y, hφ hy⟩ (z j))
    (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))) (h : U O ≤ (Opens.map (toSchemeHom sX)).obj W)
    (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) :
    letI := Mori.sectionAlgebra sX W
    η ∈ Ψ p O '' (Submodule.span ((ringCatSheaf sX).obj.obj (op (U O)))
        (Set.range fun I : Set.powersetCard (Fin n) p =>
          an p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm
            ((∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
              exteriorPower.ιMulti Γ(X, W) p fun a =>
                KaehlerDifferential.D ℂ Γ(X, W)
                  (z (Set.powersetCard.ofFinEmbEquiv.symm I a))))) :
          Set ((Ωan p).val.obj (op (U O)))) ↔
      ∃ g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ,
        (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) ∧
        ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
          DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ (∀ y' : U O, ξ (φ y') = η y') ∧
          ∀ v ∈ φ.target ∩ O ∩ logLocus k c,
            ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
              ∑ I, g I v • logFrame k c I v := by
  subst hU hc
  letI := Mori.sectionAlgebra sX W
  classical
  have hgen : ∀ (I : Set.powersetCard (Fin n) p) (y' : _),
      Ψ p O (an p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm
        ((∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
          exteriorPower.ιMulti Γ(X, W) p fun a =>
            KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))))) y' =
        (∏ i ∈ (I : Finset (Fin n))ᶜ,
          logEqn k (fun j => evalHom W ⟨y, hφ hy⟩ (z j)) (φ y') i) • formA I := by
    intro I y'
    rw [hWC p W hW O h _ (fun a => z (enum I a)) y']
    exact evalHom_smul_wedge_fderiv_coord z _ hφ hφapp I y'.2.1 _
  have hΘinv : ∀ (N : Opens (space sX)) (b : (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n))
      𝓘(ℂ) (ComplexPoints sX) ℂ).presheaf.obj (op N)),
      Θ.hom.hom.app (op N) (Θ.inv.hom.app (op N) b) = b := by
    intro N b
    have h' : Θ.inv.hom ≫ Θ.hom.hom = 𝟙 _ := congrArg (fun φ => φ.hom) Θ.inv_hom_id
    exact congrArg (fun (g : (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ)
      (ComplexPoints sX) ℂ).obj ⟶ (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ)
      (ComplexPoints sX) ℂ).obj) => g.app (op N) b) h'
  have hSo : IsOpen (φ.target ∩ (O : Set (EuclideanSpace ℂ (Fin n)))) :=
    φ.open_target.inter O.2
  let UO : Opens (space sX) := ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩
  constructor
  · rintro ⟨s, hs, rfl⟩
    obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hs
    let G : Set.powersetCard (Fin n) p → ComplexPoints sX → ℂ := fun I y'' =>
      if h' : y'' ∈ UO then Θ.hom.hom.app (op UO) (a I) ⟨y'', h'⟩ else 0
    let g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ := fun I => G I ∘ φ.symm
    have hgd : ∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O) := by
      intro I v hv
      have hv' : φ.symm v ∈ UO := ⟨φ.map_target hv.1, by
        rw [Set.mem_preimage, φ.right_inv hv.1]; exact hv.2⟩
      have h1 := smoothSheaf.contMDiff_section (Θ.hom.hom.app (op UO) (a I)) ⟨φ.symm v, hv'⟩
      have h2 : (fun y'' : UO => G I y'') = Θ.hom.hom.app (op UO) (a I) := by
        funext y''
        simp only [G, dif_pos y''.2]
      rw [← h2] at h1
      exact ((contDiffAt_comp_symm hφmax hv.1 (contMDiffAt_subtype_iff.1 h1)).differentiableAt
        (by simp)).differentiableWithinAt
    have hgφ : ∀ I (y' : UO), g I (φ y') = Θ.hom.hom.app (op UO) (a I) y' := by
      intro I y'
      have e' : φ.symm (φ y'.1) = y'.1 := φ.left_inv y'.2.1
      have hm : φ.symm (φ y'.1) ∈ UO := by rw [e']; exact y'.2
      simp only [g, G, Function.comp_apply, dif_pos hm]
      rw [show (⟨φ.symm (φ y'.1), hm⟩ : UO) = y' from Subtype.ext e']
    refine ⟨g, hgd, _, differentiableOn_sum_smul_prod_logEqn hgd,
      fun y' => ?_, fun v hv => (prod_smul_sum_smul_logFrame_eq hk g hv.2).symm⟩
    rw [map_sum, Finset.sum_apply]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [hlin, hgen, hgφ]
  · rintro ⟨g, hg, ξ, hξd, hξ, hξD⟩
    have hsm : ∀ I, ContMDiff 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞
        (fun y' : UO => g I (φ y'.1)) := by
      intro I y'
      refine (contMDiffAt_subtype_iff (f := fun y => g I (φ y))).2 ?_
      have hmem : φ y'.1 ∈ φ.target ∩ (O : Set (EuclideanSpace ℂ (Fin n))) :=
        ⟨φ.map_source y'.2.1, y'.2.2⟩
      have h1 : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ) ∞ (g I) (φ y'.1) :=
        ((analyticOnNhd_of_differentiableOn_of_finiteDimensional hSo (hg I)) _
          hmem).contDiffAt.contMDiffAt
      have h2 : ContMDiffAt 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞
          φ y'.1 :=
        (contMDiffOn_of_mem_maximalAtlas hφmax).contMDiffAt
          (φ.open_source.mem_nhds y'.2.1)
      exact h1.comp y'.1 h2
    let a : Set.powersetCard (Fin n) p → (smoothSheafCommRing 𝓘(ℂ, EuclideanSpace ℂ (Fin n))
        𝓘(ℂ) (ComplexPoints sX) ℂ).presheaf.obj (op UO) := fun I =>
      ⟨fun y' => g I (φ y'.1), hsm I⟩
    refine ⟨∑ I, Θ.inv.hom.app (op UO) (a I) •
        an p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm
          ((∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
            exteriorPower.ιMulti Γ(X, W) p fun a =>
              KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a)))),
      Submodule.sum_mem _ fun I _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨I, rfl⟩),
      ?_⟩
    funext y'
    have hy'S : φ y' ∈ φ.target ∩ (O : Set (EuclideanSpace ℂ (Fin n))) :=
      ⟨φ.map_source y'.2.1, y'.2.2⟩
    rw [← hξ y', eqOn_of_eqOn_logLocus hSo hξd.continuousOn
      (differentiableOn_sum_smul_prod_logEqn hg).continuousOn
      (fun v hv => (hξD v hv).trans (prod_smul_sum_smul_logFrame_eq hk g hv.2)) _ hy'S]
    rw [map_sum, Finset.sum_apply]
    refine Finset.sum_congr rfl fun I _ => ?_
    erw [hlin, hΘinv, hgen]

set_option maxRecDepth 8000 in
/-- **Analytification of `Ω^p(log E)(-E)` and of `Ω^p / Ω^p(log E)(-E)`.** On `W`, the forms
`ω_I = (∏_{j ∉ I, j < k} z_j) dz_I` are free over `Γ(X, W)` and restrict to `z₁ ⋯ z_k · ε_I` off
`E`; the comparison map `Ψ` carries the `𝒪`-span of their analytifications bijectively onto the
holomorphic combinations of the `(∏_{j < k} (v_j + c_j)) e_I`, which are free; and the induced
map on the quotients by these submodules is a bijection. -/
private theorem analytify_logTwisted {W : X.Opens} (hW : IsAffineOpen W) {k : ℕ} (hk : k ≤ n)
    (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
        ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))
    (hinj : Function.Injective (X.presheaf.map
        (homOfLE (X.basicOpen_le (∏ i : Fin k, z (Fin.castLE hk i)))).op).hom)
    (y : ComplexPoints sX)
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source)
    (hφapp : ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
      φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i))
    (Θ : structureSheaf sX ≅ 𝒪[n, ComplexPoints sX])
    (U : Opens (EuclideanSpace ℂ (Fin n)) → Opens (space sX))
    (hU : U = fun O => ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩)
    (Ωan : ℕ → SheafOfModules.{0} (ringCatSheaf sX))
    (an : ∀ (p : ℕ) (V : X.Opens) (O : Opens (EuclideanSpace ℂ (Fin n))),
        U O ≤ (Opens.map (toSchemeHom sX)).obj V →
        Γ(sX.relativeDifferentialForms (p : ℤ), V) → (Ωan p).val.obj (op (U O)))
    (Ψ : ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
        (Ωan p).val.obj (op (U O)) →+
          (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ))
    (hΨinj : ∀ p O, Function.Injective (Ψ p O))
    (hΨrange : ∀ p O (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
        η ∈ Set.range (Ψ p O) ↔
          ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
            DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : U O, ξ (φ y') = η y')
    (hlin : ∀ p O (a : (ringCatSheaf sX).obj.obj (op (U O))) (s : (Ωan p).val.obj (op (U O)))
        (y' : U O), Ψ p O (a • s) y' = Θ.hom.hom.app (op (U O)) a y' • Ψ p O s y')
    (hWC : ∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
        (h : U O ≤ (Opens.map (toSchemeHom sX)).obj V),
        letI := Mori.sectionAlgebra sX V
        ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V)) (y' : U O),
          Ψ p O (an p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
              (a • exteriorPower.ιMulti Γ(X, V) p
                (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m))))) y' =
            evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
              ContinuousMultilinearMap.alternatization
                ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
                  fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y')))
    (f : Γ(X, W)) (hf : f = ∏ i : Fin k, z (Fin.castLE hk i))
    (ε : letI : Algebra ℂ Γ(X, X.basicOpen f) := Mori.sectionAlgebra sX (X.basicOpen f)
      Fin n → Ω[Γ(X, X.basicOpen f)⁄ℂ])
    (hε : letI : Algebra Γ(X, W) Γ(X, X.basicOpen f) :=
        (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
      letI : Algebra ℂ Γ(X, X.basicOpen f) := Mori.sectionAlgebra sX (X.basicOpen f)
      ε = fun j : Fin n =>
        if (j : ℕ) < k then
          Ring.inverse (algebraMap Γ(X, W) Γ(X, X.basicOpen f) (z j)) •
            KaehlerDifferential.D ℂ Γ(X, X.basicOpen f)
              (algebraMap Γ(X, W) Γ(X, X.basicOpen f) (z j))
        else KaehlerDifferential.D ℂ Γ(X, X.basicOpen f)
          (algebraMap Γ(X, W) Γ(X, X.basicOpen f) (z j)))
    (c : Fin n → ℂ) (hc : c = fun j => evalHom W ⟨y, hφ hy⟩ (z j))
    (e : ∀ p, Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) →
      EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ)
    (he : e = fun (p : ℕ) (I : Set.powersetCard (Fin n) p) (v : EuclideanSpace ℂ (Fin n)) =>
      ContinuousMultilinearMap.alternatization
        ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
          fun a =>
            let j := Set.powersetCard.ofFinEmbEquiv.symm I a
            (if (j : ℕ) < k then (v j + c j)⁻¹ else 1) • EuclideanSpace.proj j))
    (Dc : Set (EuclideanSpace ℂ (Fin n)))
    (hDc : Dc = {v | ∀ j : Fin n, (j : ℕ) < k → v j + c j ≠ 0}) (p : ℕ) :
    letI : Algebra Γ(X, W) Γ(X, X.basicOpen f) :=
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    letI : Algebra ℂ Γ(X, X.basicOpen f) := Mori.sectionAlgebra sX (X.basicOpen f)
    letI := Mori.sectionAlgebra sX W
    let τ : Set.powersetCard (Fin n) p → ⋀[Γ(X, W)]^p Ω[Γ(X, W)⁄ℂ] := fun I =>
      (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
        exteriorPower.ιMulti Γ(X, W) p fun a =>
          KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))
    let S : ∀ O : Opens (EuclideanSpace ℂ (Fin n)),
        U O ≤ (Opens.map (toSchemeHom sX)).obj W →
        Submodule ((ringCatSheaf sX).obj.obj (op (U O))) ((Ωan p).val.obj (op (U O))) :=
      fun O h => Submodule.span _ (Set.range fun I =>
        an p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I)))
    let HolSub : ∀ O : Opens (EuclideanSpace ℂ (Fin n)),
        (U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) → Prop := fun O η =>
      ∃ g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ,
        (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) ∧
        ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
          DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ (∀ y' : U O, ξ (φ y') = η y') ∧
          ∀ v ∈ φ.target ∩ O ∩ Dc,
            ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
              ∑ I, g I v • e p I v
    LinearIndependent Γ(X, W) τ ∧
    (∀ I, DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩
        ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map
          (homOfLE (X.basicOpen_le f)).op
          ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I))) =
      algebraMap Γ(X, W) Γ(X, X.basicOpen f) f •
        exteriorPower.ιMulti_family Γ(X, X.basicOpen f) p ε I) ∧
    (∀ O h (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
      η ∈ Ψ p O '' (S O h : Set ((Ωan p).val.obj (op (U O)))) ↔ HolSub O η) ∧
    (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
      (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
      (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
      (∀ v ∈ φ.target ∩ O ∩ Dc,
        (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
          ∑ I, g I v • e p I v = 0) →
      ∀ I, ∀ v ∈ φ.target ∩ O, g I v = 0) ∧
    ∀ O h,
      (∀ s₁ s₂ : (Ωan p).val.obj (op (U O)),
        (Submodule.Quotient.mk s₁ : _ ⧸ S O h) = Submodule.Quotient.mk s₂ ↔
          HolSub O (Ψ p O s₁ - Ψ p O s₂)) ∧
      ∀ η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
        (∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
          DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : U O, ξ (φ y') = η y') →
        ∃ s, HolSub O (η - Ψ p O s) := by
  intro τ S HolSub
  have he' : ∀ I v, e p I v = logFrame k c I v := fun I v => by
    rw [he]
    exact wedge_smul _ _
  subst hDc
  have han : ∀ O h (η : U O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
      η ∈ Ψ p O '' (S O h : Set ((Ωan p).val.obj (op (U O)))) ↔ HolSub O η := by
    intro O h η
    refine (mem_image_span_logTwist_iff hW hk z y φ hφmax hφ hy hφapp Θ U hU Ωan an Ψ hlin hWC
      c hc p O h η).trans ?_
    simp only [HolSub, he']
    try rfl
  have hres : ∀ I, DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩
      ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map
        (homOfLE (X.basicOpen_le f)).op
        ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I))) =
      algebraMap Γ(X, W) Γ(X, X.basicOpen f) f •
        exteriorPower.ιMulti_family Γ(X, X.basicOpen f) p ε I := by
    subst hε hf
    exact formsAlgEquiv_res_logTwist sX hW hk z p
  refine ⟨linearIndependent_logTwist sX hk z hb hinj p, hres, han, fun O g hg h0 => ?_,
    fun O h => ⟨fun s₁ s₂ => ?_, fun η hη => ?_⟩⟩
  · -- the holomorphic module is free
    intro I v hv
    refine eq_zero_of_sum_smul_logFrame_eq_zero (k := k) (c := c) (φ.open_target.inter O.2)
      (fun I => (hg I).continuousOn) (fun w hw => ?_) I v hv
    have h1 := h0 w hw
    simp only [he'] at h1
    exact (smul_eq_zero.1 h1).resolve_left
      (Finset.prod_ne_zero_iff.2 fun j _ => hw.2 _ j.2)
  · -- the induced map on quotients is well defined and injective
    rw [Submodule.Quotient.eq, ← map_sub, ← han O h]
    exact ((hΨinj p O).mem_set_image).symm
  · -- and surjective
    obtain ⟨s, rfl⟩ := (hΨrange p O η).2 hη
    exact ⟨s, (han O h _).1 ⟨0, Submodule.zero_mem _, by rw [map_zero, sub_self]⟩⟩

end LogTwist

section Main

/-- The logarithmic forms on `W` are free over `Γ(X, W)` on the products `ε_I`. -/
private theorem exists_logForms_basis {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)} {n : ℕ}
    {W : X.Opens} (hW : IsAffineOpen W) {x : X} (hxW : x ∈ W) {k : ℕ} (hk : k ≤ n)
    (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
        ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))
    (hinj : Function.Injective (X.presheaf.map
        (homOfLE (X.basicOpen_le (∏ i : Fin k, z (Fin.castLE hk i)))).op).hom)
    (p : ℕ) :
    let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
    let L := Γ(X, X.basicOpen f)
    letI : Algebra Γ(X, W) L :=
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
    letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
    let ε : Fin n → Ω[L⁄ℂ] := fun j =>
      if (j : ℕ) < k then
        Ring.inverse (algebraMap Γ(X, W) L (z j)) •
          KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
      else KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
    ∃ b : Module.Basis (Set.powersetCard (Fin n) p) Γ(X, W)
        (DeRham.logForms ℂ L (fun i : Fin k => z (Fin.castLE hk i)) p),
      ∀ I, (b I : ExteriorAlgebra L Ω[L⁄ℂ]) = ExteriorAlgebra.ιMulti_family L p ε I := by
  intro f L ε
  letI : Algebra Γ(X, W) L := (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
  have hunit : ∀ j : Fin n, (j : ℕ) < k → IsUnit (algebraMap Γ(X, W) L (z j)) := by
    intro j hj
    have hf : IsUnit (algebraMap Γ(X, W) L f) := X.toRingedSpace.isUnit_res_basicOpen f
    refine isUnit_of_dvd_unit (map_dvd _ ?_) hf
    have : j = Fin.castLE hk ⟨j, hj⟩ := Fin.ext rfl
    rw [this]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ _)

  letI := Mori.sectionAlgebra sX W
  haveI : IsScalarTower ℂ Γ(X, W) L :=
    MMP.Flips.ResolutionInputs.isScalarTower_section_res sX (X.basicOpen_le f)
  obtain ⟨bW, hbW⟩ := hb
  obtain ⟨bL, hbL⟩ := MMP.Flips.ResolutionInputs.exists_basis_res sX hW (hW.basicOpen f)
    (X.basicOpen_le f) z bW hbW
  let P : Finset (Fin n) := Finset.univ.filter fun j => (j : ℕ) < k
  have hP : ∀ j ∈ P, IsUnit (algebraMap Γ(X, W) L (z j)) := fun j hj =>
    hunit j (by simpa [P] using hj)
  have hb' : ∀ j, bL j = KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j)) := hbL
  let u : Fin k → Γ(X, W) := fun i => z (Fin.castLE hk i)
  have hu₁ : ∀ i, ∃ j ∈ P, z j = u i := fun i => ⟨Fin.castLE hk i, by simp [P], rfl⟩
  have hu₂ : ∀ j ∈ P, ∃ i, u i = z j := fun j hj =>
    ⟨⟨j, by simpa [P] using hj⟩, congrArg z (Fin.ext rfl)⟩
  have hcoord : ∀ (b : Γ(X, W)) j, bL.repr (KaehlerDifferential.D ℂ L
      (algebraMap Γ(X, W) L b)) j ∈ Set.range (algebraMap Γ(X, W) L) := by
    intro b j
    refine ⟨bW.repr (KaehlerDifferential.D ℂ Γ(X, W) b) j, ?_⟩
    have h1 : KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L b) =
        ∑ i, algebraMap Γ(X, W) L (bW.repr (KaehlerDifferential.D ℂ Γ(X, W) b) i) • bL i := by
      conv_lhs => rw [← KaehlerDifferential.map_D ℂ ℂ Γ(X, W) L,
        ← bW.sum_repr (KaehlerDifferential.D ℂ Γ(X, W) b)]
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul, hbW, KaehlerDifferential.map_D, hb', algebraMap_smul]
    rw [h1, Module.Basis.repr_sum_self]
  haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
  haveI : Nontrivial L := hinj.nontrivial
  let LB := DeRham.logBasis bL hP
  have hmem : ∀ I : Set.powersetCard (Fin n) p,
      ((LB.exteriorPower p I : ⋀[L]^p Ω[L⁄ℂ]) : ExteriorAlgebra L Ω[L⁄ℂ]) ∈
        DeRham.logForms ℂ L u p := fun I =>
    DeRham.coe_logBasis_exteriorPower_mem_logForms hP hb' hu₂ I
  let v : Set.powersetCard (Fin n) p → DeRham.logForms ℂ L u p := fun I => ⟨_, hmem I⟩
  have hli : LinearIndependent Γ(X, W) v := by
    rw [linearIndependent_iff']
    intro s g hg i hi
    have h2 : ∑ i ∈ s, algebraMap Γ(X, W) L (g i) • LB.exteriorPower p i = 0 := Subtype.ext <| by
      simpa [v, Submodule.coe_sum, Submodule.coe_smul, algebraMap_smul] using
        congrArg Subtype.val hg
    have := (linearIndependent_iff'.1 (LB.exteriorPower p).linearIndependent) s _ h2 i hi
    exact hinj (this.trans (map_zero _).symm)
  have hsp : ⊤ ≤ Submodule.span Γ(X, W) (Set.range v) := by
    rintro ⟨y, hy⟩ -
    have hle : DeRham.logForms ℂ L u p ≤ (⋀[L]^p Ω[L⁄ℂ]).restrictScalars Γ(X, W) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨w, -, rfl⟩
      rw [← exteriorPower.ιMulti_apply_coe]
      exact (exteriorPower.ιMulti L p w).2
    obtain ⟨c', hc'⟩ := DeRham.exists_eq_sum_logBasis hP hb' hu₁ hcoord ⟨y, hle hy⟩ hy
    have hyv : (⟨y, hy⟩ : DeRham.logForms ℂ L u p) = ∑ s, c' s • v s := Subtype.ext <| by
      simpa [v, Submodule.coe_sum, Submodule.coe_smul, algebraMap_smul] using
        congrArg Subtype.val hc'
    rw [hyv]
    exact Submodule.sum_mem _ fun s _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨s, rfl⟩)
  refine ⟨Module.Basis.mk hli hsp, fun I => ?_⟩
  rw [Module.Basis.mk_apply]
  change ((LB.exteriorPower p I : ⋀[L]^p Ω[L⁄ℂ]) : ExteriorAlgebra L Ω[L⁄ℂ]) = _
  rw [exteriorPower.basis_apply, exteriorPower.ιMulti_family, exteriorPower.ιMulti_apply_coe,
    ExteriorAlgebra.ιMulti_family]
  congr 1
  funext a
  simp only [Function.comp_apply, LB]
  rw [DeRham.logBasis_apply, hb', DeRham.logScale]
  simp only [ε, P, Finset.mem_filter, Finset.mem_univ, true_and]
  split_ifs
  · rfl
  · exact one_smul _ _

end Main

section StatementPieces

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ)) {n : ℕ}

/-- The open `φ⁻¹(O)` of `X^an` (inside the source of the chart `φ`), for an open `O ⊆ ℂⁿ`. -/
public def chartPreimage (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (O : Opens (EuclideanSpace ℂ (Fin n))) : Opens (space sX) :=
  ⟨φ.source ∩ φ ⁻¹' O, φ.isOpen_inter_preimage O.2⟩

@[simp] public theorem mem_chartPreimage
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    {O : Opens (EuclideanSpace ℂ (Fin n))} {y : ComplexPoints sX} :
    y ∈ chartPreimage sX φ O ↔ y ∈ φ.source ∧ φ y ∈ O := Iff.rfl

/-- The analytification `(Ω^p_X)^an` of the sheaf of algebraic `p`-forms of `X` over `ℂ`. -/
public noncomputable def analytifiedForms (p : ℕ) : SheafOfModules.{0} (ringCatSheaf sX) :=
  (analytifyModule sX).obj (sX.relativeDifferentialForms (p : ℤ))

/-- The analytification of an algebraic `p`-form `s` on `V`, restricted to `φ⁻¹(O) ⊆ V^an`. -/
public noncomputable def analytifyForm
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (p : ℕ) (V : X.Opens) (O : Opens (EuclideanSpace ℂ (Fin n)))
    (h : chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj V)
    (s : Γ(sX.relativeDifferentialForms (p : ℤ), V)) :
    (analytifiedForms sX p).val.obj (op (chartPreimage sX φ O)) :=
  (analytifiedForms sX p).val.presheaf.map (homOfLE h).op
    ((analytifyModuleUnit sX (sX.relativeDifferentialForms (p : ℤ))).val.app (op V) s)

/-- The type of a comparison map on the chart `φ`: for every degree `p` and open `O ⊆ ℂⁿ`, an
additive map from the sections of `(Ω^p_X)^an` over `φ⁻¹(O)` to families of alternating
`p`-forms on `ℂⁿ` at the points of `φ⁻¹(O)`. -/
public abbrev ChartFormsMap
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))) : Type :=
  ∀ (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n))),
    (analytifiedForms sX p).val.obj (op (chartPreimage sX φ O)) →+
      (chartPreimage sX φ O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ)

/-- The holomorphic logarithmic products `e_I(v) = ⋀_{j ∈ I} ℓ_j(v)` on `ℂⁿ`, where `ℓ_j` is the
`j`-th coordinate functional, scaled by `(v_j + c_j)⁻¹` for `j < k`: the analytic counterparts,
in the translated coordinates `v = z - c`, of the products of the `dz_j / z_j` (`j < k`) and the
`dz_j` (`j ≥ k`). -/
public noncomputable def holomorphicLogFrame (k : ℕ) (c : Fin n → ℂ) (p : ℕ)
    (I : Set.powersetCard (Fin n) p) (v : EuclideanSpace ℂ (Fin n)) :
    EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ :=
  ContinuousMultilinearMap.alternatization
    ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
      fun a =>
        let j := Set.powersetCard.ofFinEmbEquiv.symm I a
        (if (j : ℕ) < k then (v j + c j)⁻¹ else 1) • EuclideanSpace.proj j)

/-- The complement `{v | v_j + c_j ≠ 0 for j < k}` of the divisor `E` in translated coordinates. -/
public def logLocusComplement (k : ℕ) (c : Fin n → ℂ) : Set (EuclideanSpace ℂ (Fin n)) :=
  {v | ∀ j : Fin n, (j : ℕ) < k → v j + c j ≠ 0}

@[simp] public theorem mem_logLocusComplement {k : ℕ} {c : Fin n → ℂ}
    {v : EuclideanSpace ℂ (Fin n)} :
    v ∈ logLocusComplement k c ↔ ∀ j : Fin n, (j : ℕ) < k → v j + c j ≠ 0 := Iff.rfl

/-- **Coordinates adapted to `E` at `x`** (part (1)): `z` is a regular system of parameters at `x`,
`E ∩ W = {z₁ ⋯ z_k = 0}`, and `dz₁, …, dzₙ` is a basis of `Ω[Γ(X, W)⁄ℂ]`. -/
public def IsAdaptedCoordinates (E : Mori.Divisor X) {x : X} {W : X.Opens} (hxW : x ∈ W)
    {k : ℕ} (hk : k ≤ n) (z : Fin n → Γ(X, W)) : Prop :=
  Mori.IsRegularSystemOfParameters (fun i => X.presheaf.germ W x hxW (z i)) ∧
  (∀ w ∈ W, (∃ D ∈ E.support, w ∈ D.support) ↔
    w ∉ X.basicOpen (∏ i : Fin k, z (Fin.castLE hk i))) ∧
  (letI := Mori.sectionAlgebra sX W
    ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
      ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))

/-- **The chart `φ` is `z - z(y)`**: on its source (inside `W^an`), `φ = z - z(y)`. -/
public def IsTranslatedChart {W : X.Opens} (z : Fin n → Γ(X, W)) {y : ComplexPoints sX}
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source) : Prop :=
  ∀ y' (hy' : y' ∈ φ.source) (i : Fin n),
    φ y' i = evalHom W ⟨y', hφ hy'⟩ (z i) - evalHom W ⟨y, hφ hy⟩ (z i)

/-- A family `η` of `p`-forms on `φ⁻¹(O)` is a holomorphic combination of the
`(∏_{j < k} (v_j + c_j)) e_I`, read on `φ(φ⁻¹ O) ∖ E` and extended holomorphically: the
holomorphic sections of `Ω^p(log E)(-E)` on the chart. -/
public def IsHolomorphicTwistedLogForm
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))) {k : ℕ}
    (hk : k ≤ n) (c : Fin n → ℂ) (p : ℕ) (O : Opens (EuclideanSpace ℂ (Fin n)))
    (η : chartPreimage sX φ O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ) : Prop :=
  ∃ g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ,
    (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) ∧
    ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
      DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ (∀ y' : chartPreimage sX φ O, ξ (φ y') = η y') ∧
      ∀ v ∈ φ.target ∩ O ∩ logLocusComplement k c,
        ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
          ∑ I, g I v • holomorphicLogFrame k c p I v

variable [SmoothOfRelativeDimension n sX]

variable (n) in
/-- **The complex manifold structure of `X^an`**: the charted space whose charts are the étale
coordinate charts `z - c` of `X` (`instChartedSpaceEuclideanSpace`), modelled on `ℂⁿ`. -/
@[no_expose, instance_reducible] public noncomputable def analytificationChartedSpace :
    ChartedSpace (EuclideanSpace ℂ (Fin n)) (ComplexPoints sX) :=
  instChartedSpaceEuclideanSpace

attribute [local instance] analytificationChartedSpace

variable (n) in
/-- **`𝒪_{X^an}` is the sheaf of holomorphic functions.** The isomorphism `Θ` from the structure
sheaf of `X^an` to the sheaf of holomorphic functions of the manifold structure
`analytificationChartedSpace`, chosen among those sending the analytification of a regular
function `g` to the function `y ↦ g(y)` and every section to its function of values. -/
@[no_expose] public noncomputable def structureSheafIsoHolomorphic :
    structureSheaf sX ≅ 𝒪[n, ComplexPoints sX] :=
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  Classical.choose (exists_theta (sX := sX) (n := n))

variable (n) in
/-- `Θ` sends the analytification of a regular function `g` on `V` to `y ↦ g(y)`. -/
public def StructureSheafIsoEval : Prop :=
  ∀ (V : X.Opens) (g : Γ(X, V)) (y : (Opens.map (toSchemeHom sX)).obj V),
    (structureSheafIsoHolomorphic sX n).hom.hom.app (op _)
        ((analytificationHom sX).hom.c.app (op V) g) y =
      evalHom V ⟨y.1, mem_chart_iff.2 y.2⟩ g

variable (n) in
/-- The charts of the atlas of `X^an` are given by regular functions: each is `z - c` on its
source, for regular functions `z` on an open `W` and constants `c`. -/
public def AtlasChartsAreRegular : Prop :=
  ∀ φ ∈ atlas (EuclideanSpace ℂ (Fin n)) (ComplexPoints sX),
    ∃ (W : X.Opens) (z : Fin n → Γ(X, W)) (c : Fin n → ℂ) (hW : φ.source ⊆ chart W),
      ∀ y (hy : y ∈ φ.source) (i : Fin n), φ y i = evalHom W ⟨y, hW hy⟩ (z i) - c i

variable (n) in
/-- **(2) `X^an` is a complex manifold with algebraic charts**: smooth, Hausdorff, second
countable, with charts given by regular functions, and with `𝒪_{X^an}` its sheaf of holomorphic
functions through `Θ`. -/
public def IsAlgebraicComplexManifold : Prop :=
  IsManifold 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX) ∧
    T2Space (ComplexPoints sX) ∧ SecondCountableTopology (ComplexPoints sX) ∧
    AtlasChartsAreRegular sX n ∧ StructureSheafIsoEval sX n

/-- **(3) `Ψ` identifies analytic forms with holomorphic forms on the chart `φ`**: it is injective
with image the holomorphic forms, compatible with restriction, `𝒪`-linear through `Θ`, sends a
degree-zero form `g` to `y ↦ g(y)`, and commutes with `d` (read as `extDeriv`). -/
public def IsHolomorphicFormsMap
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (Ψ : ChartFormsMap sX φ) : Prop :=
  (∀ p O, Function.Injective (Ψ p O)) ∧
  (∀ p O (η : chartPreimage sX φ O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
    η ∈ Set.range (Ψ p O) ↔
      ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
        DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : chartPreimage sX φ O, ξ (φ y') = η y') ∧
  (∀ p O₁ O₂ (h : chartPreimage sX φ O₁ ≤ chartPreimage sX φ O₂)
    (s : (analytifiedForms sX p).val.obj (op (chartPreimage sX φ O₂)))
    (y' : chartPreimage sX φ O₁),
    Ψ p O₁ ((analytifiedForms sX p).val.presheaf.map (homOfLE h).op s) y' =
      Ψ p O₂ s ⟨y'.1, h y'.2⟩) ∧
  (∀ p O (a : (ringCatSheaf sX).obj.obj (op (chartPreimage sX φ O)))
    (s : (analytifiedForms sX p).val.obj (op (chartPreimage sX φ O)))
    (y' : chartPreimage sX φ O),
    Ψ p O (a • s) y' =
      (structureSheafIsoHolomorphic sX n).hom.hom.app (op (chartPreimage sX φ O)) a y' •
        Ψ p O s y') ∧
  (∀ (V : X.Opens) (hV : IsAffineOpen V) O
    (h : chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj V)
    (g : Γ(X, V)) (y' : chartPreimage sX φ O),
    letI := Mori.sectionAlgebra sX V
    Ψ 0 O (analytifyForm sX φ 0 V O h ((DeRham.formsAlgEquiv sX 0 ⟨V, hV⟩).symm
        ((exteriorPower.zeroEquiv Γ(X, V) Ω[Γ(X, V)⁄ℂ]).symm g))) y' =
      ContinuousAlternatingMap.constOfIsEmpty ℂ (EuclideanSpace ℂ (Fin n)) (Fin 0)
        (evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ g)) ∧
  (∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
    (h : chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj V),
    letI := Mori.sectionAlgebra sX V
    ∀ (η : ⋀[Γ(X, V)]^p Ω[Γ(X, V)⁄ℂ])
      (ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
      DifferentiableOn ℂ ξ (φ.target ∩ O) →
      (∀ y' : chartPreimage sX φ O, ξ (φ y') =
        Ψ p O (analytifyForm sX φ p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm η)) y') →
      ∀ y' : chartPreimage sX φ O, Ψ (p + 1) O (analytifyForm sX φ (p + 1) V O h
          ((DeRham.formsAlgEquiv sX (p + 1) ⟨V, hV⟩).symm
            (KaehlerDifferential.deRhamDifferential (A := ℂ) p η))) y' =
        extDeriv ξ (φ y'))

/-- `Ψ` sends `a db₁ ∧ ⋯ ∧ db_p` to `a(y') d(b₁ ∘ φ⁻¹) ∧ ⋯ ∧ d(b_p ∘ φ⁻¹)`: a further pin used to
choose `holomorphicFormsMap` (it is a consequence of the pins of `IsHolomorphicFormsMap`). -/
private def FormsMapWedgeValues
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n)))
    (Ψ : ChartFormsMap sX φ) : Prop :=
  ∀ (p : ℕ) (V : X.Opens) (hV : IsAffineOpen V) O
    (h : chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj V),
    letI := Mori.sectionAlgebra sX V
    ∀ (a : Γ(X, V)) (b : Fin p → Γ(X, V)) (y' : chartPreimage sX φ O),
      Ψ p O (analytifyForm sX φ p V O h ((DeRham.formsAlgEquiv sX p ⟨V, hV⟩).symm
          (a • exteriorPower.ιMulti Γ(X, V) p
            (fun m => KaehlerDifferential.D ℂ Γ(X, V) (b m))))) y' =
        evalHom V ⟨y'.1, mem_chart_iff.2 (h y'.2)⟩ a •
          ContinuousMultilinearMap.alternatization
            ((ContinuousMultilinearMap.mkPiAlgebra ℂ (Fin p) ℂ).compContinuousLinearMap
              fun m => fderiv ℂ (regVal V (b m) ∘ φ.symm) (φ y'))

open scoped Classical in
/-- **The forms map `Ψ` on the chart `φ`**: `(Ω^p_X)^an → holomorphic p-forms` over every
`φ⁻¹(O)`, chosen among the maps satisfying `IsHolomorphicFormsMap` and sending
`a db₁ ∧ ⋯ ∧ db_p` to `a(y') d(b₁ ∘ φ⁻¹) ∧ ⋯ ∧ d(b_p ∘ φ⁻¹)` (and `0` if there is none; for a
chart `z - z(y)` given by coordinates `z` with `dz` a basis there is one, see
`hasAnalyticLogCoordinatesAt`). -/
@[no_expose] public noncomputable def holomorphicFormsMap
    (φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))) :
    ChartFormsMap sX φ :=
  if h : ∃ Ψ, IsHolomorphicFormsMap sX φ Ψ ∧ FormsMapWedgeValues sX φ Ψ then Classical.choose h
  else fun _ _ => 0

/-- **(4) Logarithmic forms on the chart `z - z(y)`**, in degree `p`: the log forms on `W` are free
on the products `ε_I` of the `dzᵢ/zᵢ` (`i < k`) and `dz_j`; the holomorphic products `e_I` are
free over holomorphic functions; `Ψ` sends `ε_I` to `e_I`; holomorphic combinations of the `e_I`
are stable under `extDeriv`; and `z₁ ⋯ z_k` times such a combination is holomorphic. -/
public def LogFormsAnalytify {W : X.Opens} (hW : IsAffineOpen W) {k : ℕ} (hk : k ≤ n)
    (z : Fin n → Γ(X, W)) {y : ComplexPoints sX}
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source) (p : ℕ) : Prop :=
  let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
  let L := Γ(X, X.basicOpen f)
  letI : Algebra Γ(X, W) L :=
    (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
  let ε : Fin n → Ω[L⁄ℂ] := fun j =>
    if (j : ℕ) < k then
      Ring.inverse (algebraMap Γ(X, W) L (z j)) •
        KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
    else KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
  let c : Fin n → ℂ := fun j => evalHom W ⟨y, hφ hy⟩ (z j)
  let e := holomorphicLogFrame k c
  let Dc := logLocusComplement k c
  (∃ b : Module.Basis (Set.powersetCard (Fin n) p) Γ(X, W)
      (DeRham.logForms ℂ L (fun i : Fin k => z (Fin.castLE hk i)) p),
    ∀ I, (b I : ExteriorAlgebra L Ω[L⁄ℂ]) = ExteriorAlgebra.ιMulti_family L p ε I) ∧
  (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
    (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
    (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
    (∀ v ∈ φ.target ∩ O ∩ Dc, ∑ I, g I v • e p I v = 0) →
    ∀ I, ∀ v ∈ φ.target ∩ O, g I v = 0) ∧
  (∀ O (h : chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj (X.basicOpen f))
    (I : Set.powersetCard (Fin n) p) (y' : chartPreimage sX φ O),
    holomorphicFormsMap sX φ p O (analytifyForm sX φ p (X.basicOpen f) O h
      ((DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩).symm
          (exteriorPower.ιMulti_family L p ε I))) y' =
      e p I (φ y')) ∧
  (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
    (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
    (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
    ∃ g' : Set.powersetCard (Fin n) (p + 1) → EuclideanSpace ℂ (Fin n) → ℂ,
      (∀ J, DifferentiableOn ℂ (g' J) (φ.target ∩ O)) ∧
      ∀ v ∈ φ.target ∩ O ∩ Dc,
        extDeriv (fun v' => ∑ I, g I v' • e p I v') v = ∑ J, g' J v • e (p + 1) J v) ∧
  (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
    (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
    (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
    ∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
      DifferentiableOn ℂ ξ (φ.target ∩ O) ∧
      ∀ v ∈ φ.target ∩ O ∩ Dc,
        ξ v = (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
          ∑ I, g I v • e p I v)

/-- **(4) `Ω^p(log E)(-E)` and `Ω^p / Ω^p(log E)(-E)` analytify isomorphically**, on the chart
`z - z(y)` in degree `p`: the forms `ω_I = (∏_{j ∉ I, j < k} z_j) dz_I` on `W` are linearly
independent and restrict off `E` to `z₁ ⋯ z_k · ε_I`; `Ψ` maps the `𝒪`-span `S` of their
analytifications onto the holomorphic sections of `Ω^p(log E)(-E)`
(`IsHolomorphicTwistedLogForm`), whose generators are free; and `Ψ` induces a bijection between
the quotients by `S` and by those holomorphic sections. -/
public def TwistedLogFormsAnalytify {W : X.Opens} (hW : IsAffineOpen W) {k : ℕ} (hk : k ≤ n)
    (z : Fin n → Γ(X, W)) {y : ComplexPoints sX}
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source) (p : ℕ) : Prop :=
  let f : Γ(X, W) := ∏ i : Fin k, z (Fin.castLE hk i)
  let L := Γ(X, X.basicOpen f)
  letI : Algebra Γ(X, W) L :=
    (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom.toAlgebra
  letI : Algebra ℂ L := Mori.sectionAlgebra sX (X.basicOpen f)
  let ε : Fin n → Ω[L⁄ℂ] := fun j =>
    if (j : ℕ) < k then
      Ring.inverse (algebraMap Γ(X, W) L (z j)) •
        KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
    else KaehlerDifferential.D ℂ L (algebraMap Γ(X, W) L (z j))
  let c : Fin n → ℂ := fun j => evalHom W ⟨y, hφ hy⟩ (z j)
  let e := holomorphicLogFrame k c
  let Dc := logLocusComplement k c
  letI := Mori.sectionAlgebra sX W
  let τ : Set.powersetCard (Fin n) p → ⋀[Γ(X, W)]^p Ω[Γ(X, W)⁄ℂ] := fun I =>
    (∏ j ∈ (I : Finset (Fin n))ᶜ, if (j : ℕ) < k then z j else 1) •
      exteriorPower.ιMulti Γ(X, W) p fun a =>
        KaehlerDifferential.D ℂ Γ(X, W) (z (Set.powersetCard.ofFinEmbEquiv.symm I a))
  let S : ∀ O : Opens (EuclideanSpace ℂ (Fin n)),
      chartPreimage sX φ O ≤ (Opens.map (toSchemeHom sX)).obj W →
      Submodule ((ringCatSheaf sX).obj.obj (op (chartPreimage sX φ O)))
        ((analytifiedForms sX p).val.obj (op (chartPreimage sX φ O))) :=
    fun O h => Submodule.span _ (Set.range fun I =>
      analytifyForm sX φ p W O h ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I)))
  let HolSub := IsHolomorphicTwistedLogForm sX φ hk c p
  LinearIndependent Γ(X, W) τ ∧
  (∀ I, DeRham.formsAlgEquiv sX p ⟨X.basicOpen f, hW.basicOpen f⟩
      ((sX.relativeDifferentialForms (p : ℤ)).presheaf.map
        (homOfLE (X.basicOpen_le f)).op
        ((DeRham.formsAlgEquiv sX p ⟨W, hW⟩).symm (τ I))) =
    algebraMap Γ(X, W) L f • exteriorPower.ιMulti_family L p ε I) ∧
  (∀ O h (η : chartPreimage sX φ O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ),
    η ∈ holomorphicFormsMap sX φ p O ''
        (S O h : Set ((analytifiedForms sX p).val.obj (op (chartPreimage sX φ O)))) ↔
      HolSub O η) ∧
  (∀ (O : Opens (EuclideanSpace ℂ (Fin n)))
    (g : Set.powersetCard (Fin n) p → EuclideanSpace ℂ (Fin n) → ℂ),
    (∀ I, DifferentiableOn ℂ (g I) (φ.target ∩ O)) →
    (∀ v ∈ φ.target ∩ O ∩ Dc,
      (∏ j : Fin k, (v (Fin.castLE hk j) + c (Fin.castLE hk j))) •
        ∑ I, g I v • e p I v = 0) →
    ∀ I, ∀ v ∈ φ.target ∩ O, g I v = 0) ∧
  ∀ O h,
    (∀ s₁ s₂ : (analytifiedForms sX p).val.obj (op (chartPreimage sX φ O)),
      (Submodule.Quotient.mk s₁ : _ ⧸ S O h) = Submodule.Quotient.mk s₂ ↔
        HolSub O (holomorphicFormsMap sX φ p O s₁ - holomorphicFormsMap sX φ p O s₂)) ∧
    ∀ η : chartPreimage sX φ O → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
      (∃ ξ : EuclideanSpace ℂ (Fin n) → EuclideanSpace ℂ (Fin n) [⋀^Fin p]→L[ℂ] ℂ,
        DifferentiableOn ℂ ξ (φ.target ∩ O) ∧ ∀ y' : chartPreimage sX φ O, ξ (φ y') = η y') →
      ∃ s, HolSub O (η - holomorphicFormsMap sX φ p O s)

variable (n) in
/-- **(1), (3), (4) at a closed point `x`**: an affine `W ∋ x` with coordinates `z` adapted to `E`
(`IsAdaptedCoordinates`) such that at every point `y` of `W^an` the map `z - z(y)` is a chart `φ`
of the maximal atlas (`IsTranslatedChart`), on which `holomorphicFormsMap` identifies analytic and
holomorphic forms (`IsHolomorphicFormsMap`) and the logarithmic, twisted and quotient forms
(`LogFormsAnalytify`, `TwistedLogFormsAnalytify`) in every degree. -/
public def HasAnalyticLogCoordinatesAt (E : Mori.Divisor X) (x : X) : Prop :=
  ∃ (W : X.Opens) (hW : IsAffineOpen W) (hxW : x ∈ W) (k : ℕ) (hk : k ≤ n)
    (z : Fin n → Γ(X, W)),
    IsAdaptedCoordinates sX E hxW hk z ∧
    ∀ y ∈ chart (sX := sX) W,
      ∃ φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX),
      ∃ (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source),
        IsTranslatedChart sX z hφ hy ∧ IsHolomorphicFormsMap sX φ (holomorphicFormsMap sX φ) ∧
        ∀ p, LogFormsAnalytify sX hW hk z hφ hy p ∧ TwistedLogFormsAnalytify sX hW hk z hφ hy p

/-- The defining properties of `structureSheafIsoHolomorphic`. -/
private theorem structureSheafIsoHolomorphic_spec [LocallyOfFiniteType sX] :
    StructureSheafIsoEval sX n ∧
      ∀ (W : Opens (space sX)) (a : sections sX W) (y : W),
        (structureSheafIsoHolomorphic sX n).hom.hom.app (op W) a y = sectionValue a y := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  exact Classical.choose_spec (exists_theta (sX := sX) (n := n))

/-- **(2)** `X^an`, with the étale-coordinate charts, is a complex manifold with algebraic charts
and sheaf of holomorphic functions `𝒪_{X^an}` through `structureSheafIsoHolomorphic`. -/
public theorem isAlgebraicComplexManifold [IsSeparated sX] [QuasiCompact sX] :
    IsAlgebraicComplexManifold sX n := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  exact ⟨instIsManifoldEuclideanSpace, inferInstance, secondCountableTopology n, atlas_eq_eval,
    (structureSheafIsoHolomorphic_spec sX (n := n)).1⟩

set_option maxRecDepth 8000 in
/-- **(3)** On a chart `z - z(y)` given by coordinates `z` whose differentials are a basis,
`holomorphicFormsMap` satisfies its defining properties. -/
private theorem holomorphicFormsMap_spec [IsSeparated sX] [QuasiCompact sX] {W : X.Opens}
    (hW : IsAffineOpen W)
    (z : Fin n → Γ(X, W))
    (hb : letI := Mori.sectionAlgebra sX W
      ∃ b : Module.Basis (Fin n) Γ(X, W) Ω[Γ(X, W)⁄ℂ],
        ∀ i, b i = KaehlerDifferential.D ℂ Γ(X, W) (z i))
    {y : ComplexPoints sX}
    {φ : OpenPartialHomeomorph (ComplexPoints sX) (EuclideanSpace ℂ (Fin n))}
    (hφmax : φ ∈ IsManifold.maximalAtlas 𝓘(ℂ, EuclideanSpace ℂ (Fin n)) ∞ (ComplexPoints sX))
    (hφ : φ.source ⊆ chart W) (hy : y ∈ φ.source) (hφapp : IsTranslatedChart sX z hφ hy) :
    IsHolomorphicFormsMap sX φ (holomorphicFormsMap sX φ) ∧
      FormsMapWedgeValues sX φ (holomorphicFormsMap sX φ) := by
  haveI : Smooth sX := SmoothOfRelativeDimension.smooth n sX
  have h : ∃ Ψ, IsHolomorphicFormsMap sX φ Ψ ∧ FormsMapWedgeValues sX φ Ψ :=
    (exists_Psi (sX := sX) (n := n) hW z hb y φ hφmax hφ hy hφapp _
      (structureSheafIsoHolomorphic_spec sX (n := n)).2).elim fun Ψ hΨ =>
      ⟨Ψ, ⟨hΨ.1, hΨ.2.1, hΨ.2.2.1, hΨ.2.2.2.1, hΨ.2.2.2.2.1, hΨ.2.2.2.2.2.1⟩,
        hΨ.2.2.2.2.2.2⟩
  rw [holomorphicFormsMap, dif_pos h]
  exact Classical.choose_spec h

