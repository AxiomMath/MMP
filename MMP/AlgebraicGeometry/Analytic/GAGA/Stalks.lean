namespace MMP.Analytic

namespace ComplexPoints

/-- The image in `X` of a `ℂ`-point is a closed point. -/
public theorem isClosed_singleton_toScheme {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (x : ComplexPoints sX) : IsClosed ({x.toScheme} : Set X) := by
  have : IsClosedImmersion x.hom := isClosedImmersion_of_comp_eq_id sX x.hom x.2
  convert x.hom.isClosedEmbedding.isClosed_range using 1
  ext y
  constructor
  · rintro rfl; exact ⟨default, rfl⟩
  · rintro ⟨q, rfl⟩; rw [Subsingleton.elim q default]; rfl

/-- At a closed point `p` of a scheme locally of finite type over `ℂ`, the composite
`Spec κ(p) → X → Spec ℂ` is an isomorphism, i.e. `κ(p) = ℂ`. -/
public theorem isIso_fromSpecResidueField_comp {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))
    [LocallyOfFiniteType sX] (p : X) (hp : IsClosed ({p} : Set X)) :
    IsIso (X.fromSpecResidueField p ≫ sX) := by
  have := isClosed_singleton_iff_isClosedImmersion.mp hp
  have hfin : IsFinite (X.fromSpecResidueField p ≫ sX) :=
    isFinite_iff_locallyOfFiniteType_of_jacobsonSpace.mpr inferInstance
  rw [← Spec.map_preimage (X.fromSpecResidueField p ≫ sX)] at hfin ⊢
  rw [IsFinite.SpecMap_iff] at hfin
  have : IsIso (Spec.preimage (X.fromSpecResidueField p ≫ sX)) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr
      (IsAlgClosed.ringHom_bijective_of_isIntegral _ hfin.to_isIntegral)
  infer_instance

/-- A `ℂ`-point lying over `p` is the inverse of `Spec κ(p) ≅ Spec ℂ` followed by
`Spec κ(p) → X`. -/
public theorem hom_eq_inv_comp_fromSpecResidueField {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    (x : ComplexPoints sX) (p : X) (hxp : x.toScheme = p)
    [IsIso (X.fromSpecResidueField p ≫ sX)] :
    x.hom = inv (X.fromSpecResidueField p ≫ sX) ≫ X.fromSpecResidueField p := by
  have h := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField ℂ X x.hom
  have hc : x.hom (IsLocalRing.closedPoint ℂ) = p := by
    rw [← hxp]; exact congrArg x.hom (Subsingleton.elim _ _)
  revert h
  generalize Scheme.descResidueField (Scheme.stalkClosedPointTo x.hom) = d
  generalize x.hom (IsLocalRing.closedPoint ℂ) = q at hc d ⊢
  subst hc
  intro h
  have h2 := x.hom_comp_structure
  rw [← h, Category.assoc] at h2
  have hd : Spec.map d = inv (X.fromSpecResidueField q ≫ sX) := by
    rw [← Category.comp_id (Spec.map d), ← IsIso.hom_inv_id (X.fromSpecResidueField q ≫ sX),
      ← Category.assoc, h2, Category.id_comp]
  rw [← h, hd]

/-- A `ℂ`-point is determined by its image in `X`. -/
public theorem toScheme_injective {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] : Function.Injective (toScheme (sX := sX)) := by
  intro x y hxy
  have := isIso_fromSpecResidueField_comp sX _ (isClosed_singleton_toScheme x)
  ext1
  rw [hom_eq_inv_comp_fromSpecResidueField x _ rfl,
    hom_eq_inv_comp_fromSpecResidueField y _ hxy.symm]

/-- The images of the `ℂ`-points are exactly the closed points of `X`. -/
public theorem range_toScheme {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}
    [LocallyOfFiniteType sX] :
    Set.range (toScheme (sX := sX)) = {x : X | IsClosed {x}} := by
  ext p
  refine ⟨?_, fun hp => ?_⟩
  · rintro ⟨x, rfl⟩
    exact isClosed_singleton_toScheme x
  · have := isIso_fromSpecResidueField_comp sX p hp
    refine ⟨⟨inv (X.fromSpecResidueField p ≫ sX) ≫ X.fromSpecResidueField p, by simp⟩, ?_⟩
    simp only [toScheme, hom, Scheme.Hom.comp_apply,
      Scheme.fromSpecResidueField_apply]

end ComplexPoints

/-- The pullback on sheaf cohomology is natural in the sheaf. -/
@[reassoc]
private theorem sheafCohomology_map_comp_sheafCohomologyPullback {T T' : TopCat.{0}}
    (f : T' ⟶ T) {F G : TopCat.Sheaf AddCommGrpCat.{0} T} (φ : F ⟶ G) (n : ℤ) :
    (sheafCohomology T n).map φ ≫ sheafCohomologyPullback f G n =
      sheafCohomologyPullback f F n ≫
        (sheafCohomology T' n).map ((TopCat.Sheaf.pullback AddCommGrpCat.{0} f).map φ) := by
  simp only [sheafCohomology, sheafCohomologyPullback, Functor.comp_map]
  rw [hypercohomology_map_comp_hypercohomologyPullback_assoc, Category.assoc,
    ← Functor.map_comp, ← Functor.map_comp]
  congr 2
  exact (HomologicalComplex.singleMapHomologicalComplex
    (TopCat.Sheaf.pullback AddCommGrpCat.{0} f) (ComplexShape.up ℤ) 0).hom.naturality φ

section LocalHom

variable {X : Scheme.{0}} {sX : X ⟶ Spec (.of ℂ)}

open MMP.Analytic.ComplexPoints

/-- Every `ℂ`-point lies in a chart: an affine open neighbourhood with a finite presentation of
its ring of sections, which exists since `X` is locally of finite type over `ℂ`. -/
private theorem exists_chart (sX : X ⟶ Spec (.of ℂ)) [LocallyOfFiniteType sX]
    (y : ComplexPoints sX) : ∃ c : Chart sX, y ∈ ComplexPoints.chart (sX := sX) c.U := by
  obtain ⟨U, hU, hyU, -⟩ := (Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
    (show y.toScheme ∈ (⊤ : X.Opens) from trivial)
  obtain ⟨c, rfl⟩ := Chart.exists_eq (sX := sX) hU
  exact ⟨c, ComplexPoints.mem_chart_iff.2 hyU⟩

/-- Evaluation at the point `y` on the local ring of a chart: the value of a holomorphic germ,
which kills the relations of the chart. -/
private noncomputable def stalkRingValue (c : Chart sX) (y : chart (sX := sX) c.U) :
    c.StalkRing (c.coords y) →+* ℂ :=
  Ideal.Quotient.lift _ (Filter.Germ.valueRingHom.comp (holGerms (c.coords y)).subtype) (by
    intro g hg
    have : c.ideal.map (polyGermHom (c.coords y)) ≤
        RingHom.ker (Filter.Germ.valueRingHom.comp (holGerms (c.coords y)).subtype) := by
      rw [Ideal.map_le_iff_le_comap]
      intro q hq
      simp only [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply]
      change MvPolynomial.eval (c.coords y) q = 0
      rw [← c.evalHom_pres, (RingHom.mem_ker).1 hq, map_zero]
    exact this hg)

private lemma stalkRingValue_toStalkRing (c : Chart sX) (y : chart (sX := sX) c.U)
    (a : Γ(X, c.U)) : stalkRingValue c y (c.toStalkRing (c.coords y) a) = evalHom c.U y a := by
  obtain ⟨q, rfl⟩ := c.surjective a
  change stalkRingValue c y (c.toStalkRing _ (c.pres q)) = _
  rw [c.toStalkRing_pres, show (MvPolynomial.eval₂Hom (baseRingHom sX c.U) c.gen) q = c.pres q
    from rfl, c.evalHom_pres]
  rfl

private lemma evalHom_eq_zero_of_mem {U : X.Opens} (hU : IsAffineOpen U) (y : chart (sX := sX) U)
    (a : Γ(X, U)) (ha : a ∈ (hU.primeIdealOf ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal) :
    evalHom U y a = 0 := by
  have e := IsAffineOpen.comap_primeIdealOf_appLE (x := (default : Spec (.of ℂ))) U hU ⊤
    (isAffineOpen_top _) y.2.ge trivial
  change a ∈ (hU.primeIdealOf ⟨y.1.hom default, _⟩).asIdeal at ha
  rw [← e] at ha
  set P := ((isAffineOpen_top (Spec (.of ℂ))).primeIdealOf ⟨default, trivial⟩).asIdeal
  have hQ : P.comap (Scheme.ΓSpecIso (.of ℂ)).inv.hom = ⊥ := Ideal.eq_bot_of_prime _
  change (Scheme.ΓSpecIso (.of ℂ)).hom (y.1.hom.appLE U ⊤ y.2.ge a) = 0
  have hm : (Scheme.ΓSpecIso (.of ℂ)).hom (y.1.hom.appLE U ⊤ y.2.ge a) ∈
      P.comap (Scheme.ΓSpecIso (.of ℂ)).inv.hom := by
    rwa [Ideal.mem_comap, Iso.hom_inv_id_apply]
  rwa [hQ] at hm

private lemma isUnit_of_stalkRingValue_ne_zero (c : Chart sX) (y : chart (sX := sX) c.U)
    (γ : X.presheaf.stalk y.1.toScheme) (hγ : stalkRingValue c y (c.stalkHom y γ) ≠ 0) :
    IsUnit γ := by
  let _ := TopCat.Presheaf.algebra_section_stalk X.presheaf (U := c.U)
    ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  have := c.isAffineOpen.isLocalization_stalk ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩
  obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective
    (c.isAffineOpen.primeIdealOf ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal.primeCompl γ
  have hspec := IsLocalization.mk'_spec (X.presheaf.stalk y.1.toScheme) a t
  have h1 := congrArg (fun z => stalkRingValue c y (c.stalkHom y z)) hspec
  simp only [map_mul] at h1
  change _ * stalkRingValue c y
      (c.stalkHom y (X.presheaf.germ c.U y.1.toScheme _ (t : Γ(X, c.U)))) =
    stalkRingValue c y (c.stalkHom y (X.presheaf.germ c.U y.1.toScheme _ a)) at h1
  rw [c.stalkHom_germ, c.stalkHom_germ, stalkRingValue_toStalkRing,
    stalkRingValue_toStalkRing] at h1
  have ht := evalHom_ne_zero_of_notMem c.isAffineOpen y t t.2
  have ha : evalHom c.U y a ≠ 0 := fun h => mul_ne_zero hγ ht (h1.trans h)
  have haU : IsUnit (algebraMap Γ(X, c.U) (X.presheaf.stalk y.1.toScheme) a) :=
    IsLocalization.map_units (X.presheaf.stalk y.1.toScheme)
      (⟨a, fun h => ha (evalHom_eq_zero_of_mem c.isAffineOpen y a h)⟩ :
        (c.isAffineOpen.primeIdealOf ⟨y.1.toScheme, mem_chart_iff.1 y.2⟩).asIdeal.primeCompl)
  rw [← hspec] at haU
  exact isUnit_of_mul_isUnit_left haU

/-- Evaluation of a section of `𝒪_{X^an}` at a point `y`, in the local ring of a chart `c`. -/
private noncomputable def sectionValue (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ ComplexPoints.chart (sX := sX) c.U) (W : Opens (space sX)) (hyW : y ∈ W) :
    sections sX W →+* ℂ :=
  (stalkRingValue c ⟨y, hy⟩).comp <|
    (Pi.evalRingHom (fun c' : {c : Chart sX // y ∈ ComplexPoints.chart (sX := sX) c.U} =>
      c'.1.StalkRing (c'.1.coords ⟨y, c'.2⟩)) ⟨c, hy⟩).comp <|
    (Pi.evalRingHom (fun x : W => Fibre x.1) ⟨y, hyW⟩).comp (sections sX W).subtype

/-- Evaluation at `y` on the stalk of `𝒪_{X^an}`. -/
private noncomputable def analyticValue (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ ComplexPoints.chart (sX := sX) c.U) :
    (analytification sX).presheaf.stalk y ⟶ CommRingCat.of ℂ :=
  Limits.colimit.desc _
    { pt := CommRingCat.of ℂ
      ι :=
        { app := fun W => CommRingCat.ofHom (sectionValue c y hy W.unop.1 W.unop.2)
          naturality := fun W W' i => by
            ext s
            rfl } }

private lemma analyticValue_germ (c : Chart sX) (y : ComplexPoints sX)
    (hy : y ∈ ComplexPoints.chart (sX := sX) c.U) (W : Opens (space sX)) (hyW : y ∈ W)
    (s : sections sX W) :
    analyticValue c y hy ((analytification sX).presheaf.germ W y hyW s) =
      sectionValue c y hy W hyW s := by
  change (TopCat.Presheaf.germ _ W y hyW ≫ analyticValue c y hy) s = _
  simp only [TopCat.Presheaf.germ, analyticValue]
  erw [Limits.colimit.ι_desc]
  rfl

/-- The stalk map of `α_X` at `y` on a germ of a section is the germ of its image under `α_X^#`. -/
private theorem stalkMap_germ_apply (y : ComplexPoints sX) (V : X.Opens) (hV : y.toScheme ∈ V)
    (f : Γ(X, V)) :
    ((analytificationHom sX).hom.stalkMap y).hom (X.presheaf.germ V y.toScheme hV f) =
      (analytification sX).presheaf.germ ((Opens.map (toSchemeHom sX)).obj V) y hV
        (sharpHom V f) :=
  congrArg (fun φ => φ.hom f) (PresheafedSpace.stalkMap_germ (analytificationHom sX).hom V y hV)

/-- The stalk map `𝒪_{X,y} → 𝒪_{X^an,y}` is local: evaluation at `y` on both stalks is
compatible with it, and an algebraic germ with nonzero value is a unit. -/
private theorem isLocalHom_stalkMap [LocallyOfFiniteType sX] (y : ComplexPoints sX) :
    IsLocalHom ((analytificationHom sX).hom.stalkMap y).hom := by
  obtain ⟨c, hc⟩ := exists_chart sX y
  refine ⟨fun γ hγ => ?_⟩
  apply isUnit_of_stalkRingValue_ne_zero c ⟨y, hc⟩ γ
  have hv := (hγ.map (analyticValue c y hc).hom).ne_zero
  obtain ⟨V, hyV, f, rfl⟩ := X.presheaf.exists_germ_eq γ
  have key : (analyticValue c y hc).hom (((analytificationHom sX).hom.stalkMap y).hom
      (X.presheaf.germ V _ hyV f)) =
      stalkRingValue c ⟨y, hc⟩ (c.stalkHom ⟨y, hc⟩ (X.presheaf.germ V _ hyV f)) := by
    erw [stalkMap_germ_apply y V hyV f, analyticValue_germ]
    rfl
  exact key ▸ hv

/-- The stalk map of `α_X` at `y` on germs: `α_X^#` followed by the germ at `y`. -/
private theorem stalkMap_germ_ringCatSheafHom (y : ComplexPoints sX) (V : X.Opens)
    (hx : toSchemeHom sX y ∈ V) (r : X.sheaf.obj.obj (op V)) :
    ((analytificationHom sX).hom.stalkMap y).hom
        (TopCat.Presheaf.germ (C := CommRingCat.{0}) X.sheaf.obj V (toSchemeHom sX y) hx r) =
      TopCat.Presheaf.germ (C := CommRingCat.{0}) (structureSheaf sX).obj
        ((Opens.map (toSchemeHom sX)).obj V) y hx ((ringCatSheafHom sX).hom.app (op V) r) :=
  congrArg (fun φ => φ.hom r)
    (PresheafedSpace.stalkMap_germ (analytificationHom sX).hom V y hx)

/-- The stalk map `𝒪_{X,y} → 𝒪_{X^an,y}` is faithfully flat: it is flat and local. -/
private theorem faithfullyFlat_stalkMap [LocallyOfFiniteType sX] (y : ComplexPoints sX) :
    ((analytificationHom sX).hom.stalkMap y).hom.FaithfullyFlat := by
  let ψ : X.presheaf.stalk y.toScheme →+* (analytification sX).presheaf.stalk y :=
    ((analytificationHom sX).hom.stalkMap y).hom
  let _ := ψ.toAlgebra
  have : Module.Flat (X.presheaf.stalk y.toScheme) ((analytification sX).presheaf.stalk y) :=
    flat_stalkMap_analytificationHom y
  have : IsLocalHom (algebraMap (X.presheaf.stalk y.toScheme)
      ((analytification sX).presheaf.stalk y)) := isLocalHom_stalkMap y
  exact (RingHom.faithfullyFlat_algebraMap_iff (R := X.presheaf.stalk y.toScheme)
    (S := (analytification sX).presheaf.stalk y)).2 Module.FaithfullyFlat.of_flat_of_isLocalHom

/-- Analytification `F ↦ F^an` is left exact: on stalks it is base change of the stalk along
the flat ring map `𝒪_{X,y} → 𝒪_{X^an,y}`. -/
private theorem preservesFiniteLimits_analytifyModule [LocallyOfFiniteType sX] :
    Limits.PreservesFiniteLimits (analytifyModule sX) := by
  refine MMP.ModuleSkyscraper.preservesFiniteLimits_of_forall_comp_sheafStalkFunctor
    (structureSheaf sX) (analytifyModule sX) fun y => ?_
  have h1 := MMP.ModuleSkyscraper.preservesFiniteLimits_sheafStalkFunctor X.sheaf
    (toSchemeHom sX y)
  have h2 : Limits.PreservesFiniteLimits (ModuleCat.extendScalars.{0, 0, 0}
      ((analytificationHom sX).hom.stalkMap y).hom) :=
    ModuleCat.preservesFiniteLimits_extendScalars_of_flat (flat_stalkMap_analytificationHom y)
  have h3 : Limits.PreservesFiniteLimits
      (MMP.ModuleSkyscraper.sheafStalkFunctor X.sheaf (toSchemeHom sX y) ⋙
        ModuleCat.extendScalars.{0, 0, 0} ((analytificationHom sX).hom.stalkMap y).hom) :=
    @Limits.comp_preservesFiniteLimits _ _ _ _ _ _ _ _ h1 h2
  exact @Limits.preservesFiniteLimits_of_natIso _ _ _ _ _ _ (MMP.ModuleSkyscraper.stalkIso
    (toSchemeHom sX) (ringCatSheafHom sX) y _ (stalkMap_germ_ringCatSheafHom y)
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX))) h3

end LocalHom

section Delta

open Limits

variable {T : TopCat.{0}}

private noncomputable abbrev tot (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T)) :
    ShortComplex (CochainComplex AddCommGrpCat.{0} ℤ) :=
      ShortComplex.mk
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.f)))
        ((HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
          (c₁₂ := ComplexShape.up ℤ)).map (((godementSections T).mapHomologicalComplex _).map
            ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map S.g)))
        (by
          rw [← Functor.map_comp, ← Functor.map_comp, ← Functor.map_comp, S.zero,
            Functor.map_zero, Functor.map_zero]
          ext n : 1
          exact HomologicalComplex₂.total.hom_ext _ fun _ _ _ => by
            simp <;> exact Limits.comp_zero.trans Limits.comp_zero.symm)

private theorem single_map_shortExact (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T))
    (hS : S.ShortExact) (i : ℤ) :
    ((S.map (HomologicalComplex.single _ (ComplexShape.up ℤ) 0)).map
      (HomologicalComplex.eval _ _ i)).ShortExact := by
  by_cases hi : i = 0
  · subst hi
    exact ShortComplex.shortExact_of_iso
      (S.mapNatIso (HomologicalComplex.singleCompEvalIsoSelf _ (ComplexShape.up ℤ) 0)).symm hS
  · have h : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} T,
        IsZero (((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A).X i) :=
      fun A => HomologicalComplex.isZero_single_obj_X _ _ _ _ hi
    exact { exact := ShortComplex.exact_of_isZero_X₂ _ (h _)
            mono_f := (h S.X₁).mono _
            epi_g := (h S.X₃).epi _ }

private theorem tot_shortExact (S : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} T))
    (hS : S.ShortExact) : (tot S).ShortExact := by
  obtain ⟨-, -, ⟨-, hles, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} T
  have ge : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} T,
      CochainComplex.IsStrictlyGE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  have le : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} T,
      CochainComplex.IsStrictlyLE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  exact (hles (S.map (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))
    (single_map_shortExact S hS) ⟨0, 0, ge S.X₁, le S.X₁, ge S.X₂, le S.X₂, ge S.X₃, le S.X₃⟩).1

section X

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

private theorem analytifyModuleι_naturality {F G : X.Modules} (a : F ⟶ G) :
    analytifyModuleι sX F ≫ (SheafOfModules.toSheaf _).map ((analytifyModule sX).map a) =
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).map
        ((SheafOfModules.toSheaf _).map a) ≫ analytifyModuleι sX G := by
  let adj := TopCat.Sheaf.pullbackPushforwardAdjunction AddCommGrpCat.{0} (toSchemeHom sX)
  have h1 := adj.homEquiv_naturality_right_symm
    ((SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F))
    ((SheafOfModules.toSheaf _).map ((analytifyModule sX).map a))
  have h2 := adj.homEquiv_naturality_left_symm
    (Y := (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj G))
    ((SheafOfModules.toSheaf X.ringCatSheaf).map a)
    ((SheafOfModules.toSheaf _).map (analytifyModuleUnit sX G))
  have key : (SheafOfModules.toSheaf _).map (analytifyModuleUnit sX F) ≫
      (TopCat.Sheaf.pushforward AddCommGrpCat.{0} (toSchemeHom sX)).map
        ((SheafOfModules.toSheaf _).map ((analytifyModule sX).map a)) =
      (SheafOfModules.toSheaf X.ringCatSheaf).map a ≫
        (SheafOfModules.toSheaf _).map (analytifyModuleUnit sX G) := by
    have := congrArg (SheafOfModules.toSheaf X.ringCatSheaf).map
      ((SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).unit.naturality a)
    simp only [Functor.map_comp] at this
    exact this.symm
  exact h1.symm.trans ((congrArg _ key).trans h2)

/-- `ι_F` on the one-term complexes. -/
private noncomputable def singleι (F : X.Modules) :
    (complexPullback (toSchemeHom sX)).obj ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      ((SheafOfModules.toSheaf _).obj F)) ⟶
    (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
      ((SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F)) :=
  (HomologicalComplex.singleMapHomologicalComplex
    (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)) (ComplexShape.up ℤ) 0).hom.app _ ≫
    (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map (analytifyModuleι sX F)

private theorem singleι_naturality {F G : X.Modules} (a : F ⟶ G) :
    (complexPullback (toSchemeHom sX)).map ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
      ((SheafOfModules.toSheaf _).map a)) ≫ singleι sX G =
    singleι sX F ≫ (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
      ((SheafOfModules.toSheaf _).map ((analytifyModule sX).map a)) := by
  let e := HomologicalComplex.singleMapHomologicalComplex
    (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)) (ComplexShape.up ℤ) 0
  have hn : (complexPullback (toSchemeHom sX)).map
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((SheafOfModules.toSheaf _).map a)) ≫ e.hom.app _ =
      e.hom.app _ ≫ (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
        ((TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).map
          ((SheafOfModules.toSheaf _).map a)) :=
    e.hom.naturality ((SheafOfModules.toSheaf X.ringCatSheaf).map a)
  rw [singleι, singleι, ← Category.assoc, hn, Category.assoc, Category.assoc]
  exact congrArg (_ ≫ ·) ((Functor.map_comp _ _ _).symm.trans
    ((congrArg (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
      (analytifyModuleι_naturality sX a).symm).trans (Functor.map_comp _ _ _)))

private theorem comparisonMap_eq (F : X.Modules) (q : ℤ) :
    MMP.Analytic.comparisonMap sX F q = hypercohomologyPullback (toSchemeHom sX) _ q ≫
      HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX F))
        (ComplexShape.up ℤ)) q := by
  unfold MMP.Analytic.comparisonMap sheafCohomologyPullback singleι
  refine (Category.assoc _ _ _).trans ?_
  congr 1
  exact ((hypercohomology (space sX) q).map_comp _ _).symm

/-- The comparison maps are natural in pairs of maps compatible with `ι`. -/
private theorem comparisonMap_comp_map {F G : X.Modules}
    (φ : (SheafOfModules.toSheaf _).obj F ⟶ (SheafOfModules.toSheaf _).obj G)
    (ψ : (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj F) ⟶
      (SheafOfModules.toSheaf _).obj ((analytifyModule sX).obj G))
    (hψ : analytifyModuleι sX F ≫ ψ =
      (TopCat.Sheaf.pullback AddCommGrpCat.{0} (toSchemeHom sX)).map φ ≫ analytifyModuleι sX G)
    (q : ℤ) :
    comparisonMap sX F q ≫ (sheafCohomology (space sX) q).map ψ =
      (sheafCohomology _ q).map φ ≫ comparisonMap sX G q := by
  simp only [MMP.Analytic.comparisonMap, Category.assoc]
  exact (congrArg (sheafCohomologyPullback (toSchemeHom sX) _ q ≫ ·)
    ((Functor.map_comp _ _ _).symm.trans (((sheafCohomology (space sX) q).congr_map hψ).trans
      (Functor.map_comp _ _ _)))).trans
    (sheafCohomology_map_comp_sheafCohomologyPullback_assoc (toSchemeHom sX) φ q _).symm

end X

section Flasque

attribute [local instance] HasDerivedCategory.standard
attribute [local instance 2000] HomotopyCategory.Plus.instHasPointwiseRightDerivedFunctorQuasiIso
attribute [local instance] globalSections_additive

/-- A flasque abelian sheaf has vanishing higher cohomology. -/
private theorem isZero_rightDerived_globalSections_of_isFlasque (S : TopCat.{0})
    (G : TopCat.Sheaf AddCommGrpCat.{0} S) (hG : G.IsFlasque)
    (n : ℕ) (hn : 0 < n) : IsZero (((globalSections S).rightDerived n).obj G) := by
  have : PreservesFiniteLimits (globalSections S) :=
    inferInstanceAs (PreservesFiniteLimits (sheafToPresheaf (Opens.grothendieckTopology S)
      AddCommGrpCat.{0} ⋙ (evaluation (TopologicalSpace.Opens S)ᵒᵖ AddCommGrpCat.{0}).obj
        (Opposite.op ⊤)))
  obtain ⟨⟨-, -, hinj, -, -, -⟩, -⟩ := sheafCohomology_toolkit.{0, 0, 0, 0, 0} S
  have hle := Functor.le_rightAcyclic (globalSections S)
    (fun H : TopCat.Sheaf AddCommGrpCat.{0} S => H.IsFlasque)
    (fun H => by
      obtain ⟨p⟩ := EnoughInjectives.presentation H
      let _ := p.injective
      exact ⟨p.J, hinj p.J inferInstance, p.f, p.mono⟩)
    (fun X hX h₁ h₂ => by
      let _ : X.X₁.IsFlasque := h₁
      let _ : X.X₂.IsFlasque := h₂
      refine ⟨TopCat.Sheaf.IsFlasque.of_shortExact_of_isFlasque₁₂ hX, ?_⟩
      have hMap := (Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono
        (globalSections S)).mp inferInstance X hX
      have : Mono (X.map (globalSections S)).f := hMap.2
      have : Epi (X.map (globalSections S)).g :=
        TopCat.Sheaf.IsFlasque.epi_of_shortExact (U := ⊤) hX
      exact ⟨hMap.1⟩)
  exact (rightAcyclic_iff_isZero_rightDerived (globalSections S) G).1 (hle G hG) n hn

end Flasque

section X2

open TopologicalSpace in
/-- The underlying short complex of abelian sheaves. -/
private noncomputable abbrev toAb {T : TopCat.{0}}
    {R : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}
    (S : ShortComplex (SheafOfModules.{0} R)) :
    ShortComplex (Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{0}) :=
  S.map (SheafOfModules.toSheaf R)

open TopologicalSpace in
private theorem toAb_shortExact {T : TopCat.{0}}
    {R : Sheaf (Opens.grothendieckTopology T) RingCat.{0}}
    {S : ShortComplex (SheafOfModules.{0} R)} (hS : S.ShortExact) : (toAb S).ShortExact :=
  hS.map_of_exact _

variable {X : Scheme.{0}} (sX : X ⟶ Spec (.of ℂ))

private theorem total_singleι_naturality {F G : X.Modules} (a : F ⟶ G) :
    HomologicalComplex₂.total.map (((godementSections (space sX)).mapHomologicalComplex _).map
        ((complexPullback (toSchemeHom sX)).map ((HomologicalComplex.single _
          (ComplexShape.up ℤ) 0).map ((SheafOfModules.toSheaf _).map a)))) (ComplexShape.up ℤ) ≫
      HomologicalComplex₂.total.map (((godementSections (space sX)).mapHomologicalComplex _).map
        (singleι sX G)) (ComplexShape.up ℤ) =
    HomologicalComplex₂.total.map (((godementSections (space sX)).mapHomologicalComplex _).map
        (singleι sX F)) (ComplexShape.up ℤ) ≫
      HomologicalComplex₂.total.map (((godementSections (space sX)).mapHomologicalComplex _).map
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((SheafOfModules.toSheaf _).map ((analytifyModule sX).map a)))) (ComplexShape.up ℤ) := by
  have h := congrArg (fun φ => HomologicalComplex₂.total.map
    (((godementSections (space sX)).mapHomologicalComplex (ComplexShape.up ℤ)).map φ)
      (ComplexShape.up ℤ)) (singleι_naturality sX a)
  simpa only [Functor.map_comp, HomologicalComplex₂.total.map_comp] using h

/-- Naturality of the connecting maps, for a morphism of short complexes given by components. -/
private theorem δ_naturality_of_comm {C : Type*} [Category C] [Abelian C]
    {S₁ S₂ : ShortComplex (CochainComplex C ℤ)} (h₁ : S₁.ShortExact) (h₂ : S₂.ShortExact)
    (τ₁ : S₁.X₁ ⟶ S₂.X₁) (τ₂ : S₁.X₂ ⟶ S₂.X₂) (τ₃ : S₁.X₃ ⟶ S₂.X₃)
    (comm₁₂ : τ₁ ≫ S₂.f = S₁.f ≫ τ₂) (comm₂₃ : τ₂ ≫ S₂.g = S₁.g ≫ τ₃) (q : ℤ) :
    h₁.δ q (q + 1) rfl ≫ HomologicalComplex.homologyMap τ₁ (q + 1) =
      HomologicalComplex.homologyMap τ₃ q ≫ h₂.δ q (q + 1) rfl :=
  HomologicalComplex.HomologySequence.δ_naturality (hS₁ := h₁) (hS₂ := h₂)
    (φ := { τ₁ := τ₁, τ₂ := τ₂, τ₃ := τ₃, comm₁₂ := comm₁₂, comm₂₃ := comm₂₃ }) q (q + 1) rfl

/-- The short complex of total complexes of Godement sections of the pullback along `f`. -/
private noncomputable abbrev totPullback {T T' : TopCat.{0}} (f : T' ⟶ T)
    (K : ShortComplex (CochainComplex (TopCat.Sheaf AddCommGrpCat.{0} T) ℤ)) :
    ShortComplex (CochainComplex AddCommGrpCat.{0} ℤ) :=
  K.map (complexPullback f ⋙ (godementSections T').mapHomologicalComplex (ComplexShape.up ℤ) ⋙
    HomologicalComplex₂.totalFunctor AddCommGrpCat.{0} (ComplexShape.up ℤ) (ComplexShape.up ℤ)
      (c₁₂ := ComplexShape.up ℤ))

private theorem totPullback_f_comp_singleι [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules) :
    HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₁))
        (ComplexShape.up ℤ) ≫ (tot (toAb (S.map (analytifyModule sX)))).f =
      (totPullback (toSchemeHom sX) (ShortComplex.map
        (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).f ≫
      HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₂))
        (ComplexShape.up ℤ) :=
  (total_singleι_naturality sX S.f).symm

private theorem totPullback_g_comp_singleι [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules) :
    HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₂))
        (ComplexShape.up ℤ) ≫ (tot (toAb (S.map (analytifyModule sX)))).g =
      (totPullback (toSchemeHom sX) (ShortComplex.map
        (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).g ≫
      HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₃))
        (ComplexShape.up ℤ) :=
  (total_singleι_naturality sX S.g).symm

private theorem totPullback_δ_comp_singleι [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules)
    (hK' : (totPullback (toSchemeHom sX) (ShortComplex.map
      (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).ShortExact)
    (h₂ : (tot (toAb (S.map (analytifyModule sX)))).ShortExact) (q : ℤ) :
    hK'.δ q (q + 1) rfl ≫ HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₁))
        (ComplexShape.up ℤ)) (q + 1) =
      HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
        (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₃))
        (ComplexShape.up ℤ)) q ≫ h₂.δ q (q + 1) rfl :=
  δ_naturality_of_comm hK' h₂ _ _ _ (totPullback_f_comp_singleι sX S)
    (totPullback_g_comp_singleι sX S) q

private theorem δ_comp_comparisonMap_eq (S : ShortComplex X.Modules)
    (h₁ : (tot (toAb S)).ShortExact) (q : ℤ) :
    h₁.δ q (q + 1) rfl ≫ comparisonMap sX S.X₁ (q + 1) =
      (h₁.δ q (q + 1) rfl ≫ hypercohomologyPullback (toSchemeHom sX)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₁)) (q + 1)) ≫
        HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
          (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₁))
          (ComplexShape.up ℤ)) (q + 1) := by
  rw [comparisonMap_eq]
  exact (Category.assoc _ _ _).symm

private theorem comparisonMap_δ_left [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules) (h₁ : (tot (toAb S)).ShortExact)
    (hK' : (totPullback (toSchemeHom sX)
      (ShortComplex.map (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).ShortExact) (q : ℤ)
    (hc : h₁.δ q (q + 1) rfl ≫ hypercohomologyPullback (toSchemeHom sX)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₁)) (q + 1) =
      hypercohomologyPullback (toSchemeHom sX)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₃)) q ≫ hK'.δ q (q + 1) rfl) :
    h₁.δ q (q + 1) rfl ≫ comparisonMap sX S.X₁ (q + 1) =
      hypercohomologyPullback (toSchemeHom sX)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₃)) q ≫ hK'.δ q (q + 1) rfl ≫
        HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
          (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₁))
          (ComplexShape.up ℤ)) (q + 1) :=
  (δ_comp_comparisonMap_eq sX S h₁ q).trans ((hc =≫ _).trans (Category.assoc _ _ _))

private theorem comparisonMap_δ_right [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules)
    (hK' : (totPullback (toSchemeHom sX)
      (ShortComplex.map (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).ShortExact)
    (h₂ : (tot (toAb (S.map (analytifyModule sX)))).ShortExact) (q : ℤ) :
    hypercohomologyPullback (toSchemeHom sX)
        ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
          ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₃)) q ≫ hK'.δ q (q + 1) rfl ≫
        HomologicalComplex.homologyMap (HomologicalComplex₂.total.map
          (((godementSections (space sX)).mapHomologicalComplex _).map (singleι sX S.X₁))
          (ComplexShape.up ℤ)) (q + 1) =
      comparisonMap sX S.X₃ q ≫ h₂.δ q (q + 1) rfl := by
  rw [comparisonMap_eq]
  exact (congrArg (_ ≫ ·) (totPullback_δ_comp_singleι sX S hK' h₂ q)).trans
    (Category.assoc _ _ _).symm

private theorem exists_shortExact_δ_comp_hypercohomologyPullback
    [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules) (hS : S.ShortExact) :
    ∃ (h₁ : (tot (toAb S)).ShortExact)
      (hK' : (totPullback (toSchemeHom sX)
        (ShortComplex.map (C := TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) (toAb S)
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))).ShortExact),
      ∀ q : ℤ, h₁.δ q (q + 1) rfl ≫ hypercohomologyPullback (toSchemeHom sX)
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
            ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₁)) (q + 1) =
        hypercohomologyPullback (toSchemeHom sX)
          ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj
            ((SheafOfModules.toSheaf X.ringCatSheaf).obj S.X₃)) q ≫ hK'.δ q (q + 1) rfl := by
  let S₀ : ShortComplex (TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat) := toAb S
  have ge : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat,
      CochainComplex.IsStrictlyGE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  have le : ∀ A : TopCat.Sheaf AddCommGrpCat.{0} X.toTopCat,
      CochainComplex.IsStrictlyLE ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj A) 0 :=
    fun _ => inferInstance
  have H := (sheafCohomology_toolkit.{0, 0, 0, 0, 0} X.toTopCat).2.2.1.2.1
    (S₀.map (HomologicalComplex.single _ (ComplexShape.up ℤ) 0))
    (single_map_shortExact S₀ (toAb_shortExact hS))
    ⟨0, 0, ge S₀.X₁, le S₀.X₁, ge S₀.X₂, le S₀.X₂, ge S₀.X₃, le S₀.X₃⟩
  exact ⟨H.fst, (H.snd (toSchemeHom sX)).fst, (H.snd (toSchemeHom sX)).snd⟩

private theorem comparisonMap_δ
    [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (S : ShortComplex X.Modules) (hS : S.ShortExact) :
    ∃ (h₁ : (tot (toAb S)).ShortExact)
      (h₂ : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
      ∀ q : ℤ, h₁.δ q (q + 1) rfl ≫ comparisonMap sX S.X₁ (q + 1) =
        comparisonMap sX S.X₃ q ≫ h₂.δ q (q + 1) rfl := by
  have : (analytifyModule sX).IsLeftAdjoint :=
    (SheafOfModules.pullbackPushforwardAdjunction.{0} (ringCatSheafHom sX)).isLeftAdjoint
  obtain ⟨h₁, hK', hc⟩ := exists_shortExact_δ_comp_hypercohomologyPullback sX S hS
  have h₂ := tot_shortExact _ (toAb_shortExact (hS.map_of_exact (analytifyModule sX)))
  exact ⟨h₁, h₂, fun q => (comparisonMap_δ_left sX S h₁ hK' q (hc q)).trans
    (comparisonMap_δ_right sX S hK' h₂ q)⟩

private theorem comparisonMap_unique [Limits.PreservesFiniteLimits (analytifyModule sX)]
    (η : ∀ q : ℕ, SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafCohomology _ q ⟶
      analytifyModule sX ⋙ SheafOfModules.toSheaf _ ⋙ sheafCohomology (space sX) q)
    (hη : ∀ (S : ShortComplex X.Modules), S.ShortExact → ∀ (q : ℕ)
      (hS : (tot (toAb S)).ShortExact)
      (hS' : (tot (toAb (S.map (analytifyModule sX)))).ShortExact),
      hS.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp) ≫ (η (q + 1)).app S.X₁ =
        (η q).app S.X₃ ≫ hS'.δ (q : ℤ) ((q + 1 : ℕ) : ℤ) (by simp))
    (h0 : ∀ F : X.Modules, (η 0).app F = comparisonMap sX F 0) (q : ℕ) (F : X.Modules) :
    (η q).app F = comparisonMap sX F q := by
  induction q generalizing F with
  | zero => exact h0 F
  | succ q ih =>
    obtain ⟨⟨-, hEI, -, hfl, -, -⟩, -, ⟨⟨E, -⟩, -, -⟩, -⟩ :=
      sheafCohomology_toolkit.{0, 0, 0, 0, 0} X.toTopCat
    have := hEI X
    let Sx : ShortComplex X.Modules :=
      ShortComplex.mk (Injective.ι F) (cokernel.π _) (cokernel.condition _)
    have hSx : Sx.ShortExact := { exact := ShortComplex.exact_cokernel _ }
    obtain ⟨h₁, h₂, hc⟩ := comparisonMap_δ sX Sx hSx
    have hz : IsZero ((sheafCohomology X.toTopCat ((q + 1 : ℕ) : ℤ)).obj
        ((SheafOfModules.toSheaf X.ringCatSheaf).obj (Injective.under F))) :=
      (isZero_rightDerived_globalSections_of_isFlasque _ _
        (hfl X _ (Injective.injective_under F)) (q + 1) (Nat.succ_pos q)).of_iso
        ((E X.toTopCat (q + 1)).app _)
    have : Epi (h₁.δ (q : ℤ) ((q : ℤ) + 1) rfl) :=
      (h₁.homology_exact₁ _ _ rfl).epi_f (hz.eq_of_tgt _ _)
    refine (cancel_epi (h₁.δ (q : ℤ) ((q : ℤ) + 1) rfl)).1 ?_
    have h := hη Sx hSx q h₁ h₂
    rw [ih] at h
    exact h.trans (hc q).symm

end X2

